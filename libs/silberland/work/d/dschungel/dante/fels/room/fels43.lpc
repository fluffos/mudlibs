#include "files.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
nosave int schuh, schlange;

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Auf dem Huegel" );
  SetProp( P_INT_LONG, BS(
  "Du stehst nun auf dem kleinen Huegel, doch was musst Du hier erblicken... "
  "Irgendjemand hat hier saemtliche Baeume und Straeucher niedergebrannt, "
  "und die Natur bietet hier wirklich einen traurigen Anblick. Auch siehst "
  "Du hier Unmengen von Schrott und Muell herumliegen, den irgendwelche "
  "ingnoranten Abenteurer hier weggeworfen haben. Eine Schande..."));
  
  AddDetail(({"baum","baeume"}),
  "Ein zum Spass gelegter Brand hat hier grausam gewuetet.");
  AddDetail(("brand"),
  "Hier waechst ueberhaupt nichts mehr...");
  AddDetail(({"strauch","straeucher"}),
  "Ein einziger alter Strauch ist hier zu sehen und auf dem leigen alte "
  "verbeulte Eisentruemmer.");
  AddDetail(({"eisen","eisentruemmer"}),
  "Man kann kaum noch erkennen, das es sich um eine Ofen gehandelt hat...");
  AddDetail(("ofen"),
  "Der Ofen hatte einmal eine kleine Tuere durch die man Holz hienin werfen konnte.");
  AddDetail(({"tuere"}),
  "Die Tuere kann man vieleicht noch oeffne, obwohl sie sehr verrostet aussieht.");
  AddDetail(("anblick"),
  "Der Huegel ist in einem erbaermlichen Zustand. Man muesste wirklich gegen "
  "solche Umweltsuender etwas unternehmen.");
  AddDetail(("huegel"),
  "Der Huegel ist ein einziges Chaos. Ueberall Schrott und Muell... ");
  AddDetail(("muell"),
  "Ein alter Kanister, abgebrannte Fackeln, loechrige Stiefel...");
  AddDetail(("chaos"),
  "Wild verstreut liegt hier der Muell");
  AddDetail(("schande"),
  "Das Feyaria sowas zulaesst im Dschungel...");
  AddDetail(("stiefel"),
  "Die Stiefel haben keine Sohlen mehr.");
  AddDetail(("sohle"),
  "Dort wo fruher die Sohlen waren, liegt nun eine tote Ratte.");
  AddDetail(("ratte"),
  "Die Ratte scheint diesen Ort nicht ueberlebt zu haben.");
  AddDetail(({"fackel","fackeln"}),
  "Irgendein Umweltsuender hat sie hier weggeworfen.");
  AddDetail(({"suender","umweltsuender"}),
  "Der Gouverneur von Tijara bestraft Umweltsuender hart.");
  AddDetail(("kanister"),
  "Aus dem Kanister tropft Oel und verseucht den Boden und das Wasser!");
  AddDetail(("oel"),
  "Das Oel verseucht den gesamten Dschungel.");
  AddDetail(("boden"),
  "Der Boden ist bei all dem Schrott kaum mehr zu erkennen.");
  AddDetail(("himmel"),
  "Auch der Himmel scheint hier schmutzig zu sein.");
  AddDetail(("wasser"),
  "Das Wasser wird vom oel aus einem kanister verseucht.");
  AddDetail(("schrott"),
  "Alte Ruestungen, verrostete Waffen, verrottetes Gewand.....");
  AddDetail(({"ruestung","ruestungen"}),
  "Loechrig und zerschlagen liegen sie in der einst so stolzen "
  "Naturpracht.");
  AddDetail(("gewand"),
  "Alte, zerbeulte Hosen, ein dreckiges Hemd, stinkende, gelbe Socken... ");
  AddDetail(({"waffe","waffen"}),
  "Du siehst eine verrostete alte Axt, ein zerbeultes Schild, einen voellig "
  "zertruemmerten Panzer...");
  AddDetail(("pflanzen"),
  "Pflanzen gibts es auf dem Huegel so gut wie keine mehr.");
  AddDetail(({"pracht","naturpracht"}),
  "Vom einst bluehenden Dschungel ist hier nichts mehr uebrig geblieben.");
  AddDetail(("hemd"),
  "Das Hemd scheint schon sehr lange hier zu liegen.");
  AddDetail(({"socke","socken"}),
  "Die Socken haben Loecher und aus einem der Socken schaut ein kleiner Wurm heraus.");
  AddDetail(("wurm"),
  "Sogar den Wurm ekeelt dieser Ort an.");
  AddDetail(("ort"),
  "Der Huegel ist wirklich eine Schande fuer den gesamten Dschungel...");
  AddDetail(("dschungel"),
  "An diesem Ort ist vom Dschungel kaum noch etwas zu erkennen.");
  AddDetail(({"hose","hosen"}),
  "Die Hosen sind in einem erbaermlichen Zustand...");
  AddDetail(("zustand"),
  "Der gesamte Huegel ist ein einziger Schrottplatz.");
  AddDetail(({"platz","schrottplatz"}),
  "Ueberall nur allter Muell...");
  AddDetail(("panzer"),
  "Der ehemalige Besitzer des Panzers muss wohl ziemlich klein gewesen sein, "
  "denn nicht einmal Du wuerdest da hinein passen.");
  AddDetail(("besitzer"),
  "Ein sehr kleiner Zwerg...");
  AddDetail(("schild"),
  "Das Schild weist viele Dellen und Schrammen auf...");
  AddDetail(({"delle","dellen"}),
  "Die Dellen stammen sicherlich von vielen, wilden Kaempfen...");
  AddDetail(({"kaempfe","kampf"}),
  "Dazu bist Du ja zu feig!");
  AddDetail(({"schramme","schrammen"}),
  "Die Schrammen sind teilweise sehr tief. An einer faellt Dir ein Loch auf.");
  
  AddSpecialDetail(({"loch"}), "d_schlange");
  
  
  
  
  AddDetail(("gouverneur"),
  "Er wohnt in Tijara.");  
  AddDetail(({"stadt","tijara"}),
  "Tijara ist die groesste Stadt des Gouvernements Dschungel.");
  AddDetail(("gouvernements"),
  "Der Gouverneur der Stadt Tijara leitet das Gouvernement Dschungel.");
  
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25, ENV_TERRAIN:TT_JUNGLE]) );
  
  AddDetail( ({"felsblock","block"}),
    "Der Felsblock ist eher ein kleiner Tafelberg, der sich mitten im \n"
    "Dschungel erhebt.\n");
  AddDetail(({"plateau","hochplateau"}),
  "Du stehst mitten am kleinen Hochplateau.\n");
  AddDetail(({"sonne","licht"}),
  "Die Sonne strahlt hier unbarmherzig herab, wird jedoch durch den leichten\n"
  "Wind ertraeglicher gemacht.\n");
  AddDetail(("wind"),                                                            
  "Hier stinkt es..\n");
  
  AddSound( DEFAULT_SOUND,
    "Hier ist kein Laut zu hoeren, alles tot...");
    
  AddSmell( DEFAULT_SMELL,
    "Hier stinkt es gewaltig.");
 
 
 
  AddRoomMessage(({ 
    "Die Luft stinkt hier gewaltig.\n",
    "Eine kleine Made kriecht ueber Deine Schuhe.\n",
    "Dir wird vom Gestank ganz uebel.\n",
    "Dieser Ort ist ein ekliger Anblick.\n",
    "Eine Fliege laest sich auf einem alten Stiefel nieder.\n",
    "Hier stinkt es schlimm.\n",
    "Aus einem Kanister tropft Oel auf den Boden.\n",
    "Das Wasser am Boden riecht vermodert.\n",
    
    }),45);
   
   schuh = 1;  
    
  AddCmd(({"oeffne","oeffnen"}), "open");  
  
  AddCmd(({"mach","mache"}), "clean");
    
  AddItem(NPC"dnatg", REFRESH_DESTRUCT);
  AddExit( "unten", "./fels42");
}

string d_schlange()
{
  object ob;
  if(schlange)
  {
    write ( 
      "Du beugst Dich nach unten und betrachtest das Loch genauer und ploetzlich...\n");
    ob = clone_object("/d/dschungel/dante/weg/npc/skobra.lpc");
    ob->move(environment(TP),M_TPORT);
    schlange--;
    return "";
  }
  else
    return BS(
      "Du beugst Dich nach unten und betrachtest das Loch genauer. Sicher "
      "wohnt hier eine Schlange.");
}

reset()
{
schuh = 1;
schlange=1;
::reset();
}

open (string str)
{
notify_fail("Was willst Du hier oeffnen ?\n");
if ( str != "tuere")
return 0;

if (!schuh)
{
write ( " \n"
"Du versuchst die Ofentuere zu oeffnen, aber sie scheint verklemmt zu sein.\n");
say(""+TPN+" versucht vergeblich eine alte, verrostete Ofentuere zu oeffnen.\n");
return 1;
}
if ( str == "tuere")
write( " \n"
"Du oeffnest erstaunlich leicht die Ofentuere und findest dahinter einen "
"einen alten Schuh...\n");
say(""+TPN+" oeffnet eine alte, verrostete Ofentuere.\n");
CLONE(OBJ"schuh", TP);
schuh--;
return 1;
}

 
 clean( str )
 {
 notify_fail("Was willst Du hier machen ?\n");
 if (( !present("zettel", TP))&&( !present("dschungelgeist"))&&(str =="huegel sauber"))
 {
 write(" \n"
 "Du versuchst den Huegel aufzuraeumen und gibst Dir auch grosse Muehe dabei, aber wie von Geisterhand erscheint "
 "immer wieder neuer Muell, sodass Du bald aufgibst. Irgendetwas scheinst Du falsch zu machen...\n");
 say(""+TPN+" versucht vergeblich den Huegel aufzuraeumen.\n");
 return 1;
 }
 
 if (( present("zettel", TP))&&( !present("dschungelgeist"))&&(str =="huegel sauber"))
 {
 write(" \n"
 "Du versuchst den Huegel aufzuraeumen und gibst Dir auch grosse Muehe dabei, aber wie von Geisterhand erscheint "
 "immer wieder neuer Muell, sodass Du bald aufgibst. Irgendetwas scheinst Du falsch zu machen...\n");
 say(""+TPN+" versucht vergeblich den Huegel aufzuraeumen.\n");
 return 1;
 }
  if (( !present("zettel", TP))&&( present("dschungelgeist"))&&(str =="huegel sauber"))
 {
 write(" \n"
 "Du versuchst den Huegel aufzuraeumen und gibst Dir auch grosse Muehe dabei, aber wie von Geisterhand erscheint "
 "immer wieder neuer Muell, sodass Du bald aufgibst. Irgendetwas scheinst Du falsch zu machen...\n");
 say(""+TPN+" versucht vergeblich den Huegel aufzuraeumen.\n");
 return 1;
 }
  if (( present("zettel", TP))&&( present("dschungelgeist"))&&(str =="huegel sauber"))
 {
 write(" \n"
 "Du versuchst den Huegel aufzuraeumen, doch alleine bist Du machtlos "
 "gegen die Umweltsuenden der Bewohner des Silberlandes.\n"
 "Der Dschungelgeist aber erkennt Deinen gute Willen, laechelt Dich an und "
 "schenkt Dir zum Dank einen kleinen Gegenstand.\n");
 CLONE(OBJ"ding5", TP);
//is ok so
 
 return 1;
 }
 return 0;
 }
 
 
