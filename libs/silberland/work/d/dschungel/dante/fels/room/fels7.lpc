#include "../def.h"

inherit "std/room";

#include <moving.h>
#include <properties.h>
#include <language.h>


//  object *x; for
// (i=sizeof((x=TP->QueryProp(P_ARMOURS))-1; i>=0; i--)
// if (x[i]->id("Deine_id_die_Du_ueberpruefen_willst"))
// return 1;

nosave int ding;


create()
{
  ::create();

  SetProp( P_INT_SHORT, "Mitten im Dickicht" );
  SetProp( P_INT_LONG, BS(
  "Du nimmst all Deinen Mut zusammen und stehst mitten in einem Spinnennest. "
  "Ausser einigen Knochen und Skeletten kannst du hier nur dichtesten Urwald "
  " erkennen. Raus kommst Du hier gleich wie Du rein gekomen bist..."));

AddDetail("himmel",
"Der Himmel ist kaum zu erkennen, zu dicht ist der Dschungel hier.");
AddDetail("mut",
"Naja, feig bist Du hier und RL!");
AddDetail("rl",
"Kenne ich nicht, Du?");
AddDetail("moment",
"Augeblick...");
AddDetail("augenblick",
"Eigentlich wollte ich hier ein SpecialDetail einbauen, das Dich blind macht, "
"aber es ist Weichnachten und ich bin fromm!!!*lach*");

AddDetail("raus",
"Suedosten!");
AddDetail("rein",
"Nordwesten!");
  AddDetail( "boden",
    "Am Boden liegen viele Knochen. Ein ekliger Anblick.");
    AddDetail("anblick",
    "Einfach grausig diese vielen Knochen.");
  AddDetail( ({"spinnennest"}),
    "Du stehst mitten drinnen.");
    AddDetail("nest",
    "Genauer gesagt ein grosses Spinnennest.");
    AddDetail("suedosten",
    "Hier gehts raus.");
    AddDetail("appetit",
    "Auf Dich haben die Spinnen Appetit.");
   AddDetail("spinne",
   "Im Moment scheint keine hier zu sein. Dein Glueck.");
   AddDetail("glueck",
   "Das kann sich hier schnell aendern.");
   AddDetail("spinnen",
   "Die Spinnen scheinen nicht hier zu sein.");
   AddDetail("narren",
   "Du!");
   AddDetail("narr",
   "Dante teilt Dir mit: Hau hier lieber ab!"); 
  AddDetail(("knochen"),
  "Die Spinnen scheinen grossen Appetit zu haben...\n");
  AddDetail(({"skelett","skelette"}),
  "Andere Narren waren wohl auch so dumm wie Du.\n");
  AddDetail(("urwald"),
  "Bei naeherer Betrachtung erkennst Du eine Luecke im Dschungel.");
  AddDetail(("dschungel"),
  "Hast Du nichts besseres zu tun als hier alles zu untersuchen?");
  AddDetail(("luecke"),
  "Die Luecke fuehrt nach Suedosten.\n");
  AddDetail("betrachtung",
  "Als Du so herumschaust, faellt Dir am Boden eine kleine Grube auf.");
  AddDetail("grube",
  "Die Grube scheint nicht allzu tief zu sein.");
  
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_JUNGLE]) );

  
  AddSound( DEFAULT_SOUND,
    "Du hoerst das Krabbeln vieler Spinnen.\n");
    
  AddSmell( DEFAULT_SMELL,
    "Hier riecht es nach Tod und Verwesung.\n");

  SetProp(P_HIDE_EXITS, ({"suedosten"}) );
  AddCmd(({"greif","greife"}),"get");
  AddItem("/d/dschungel/dante/hoehle/npc/dspinne2" , REFRESH_DESTRUCT);
  
  ding = 1;
  AddExit("norden", "./nest");
  AddExit( "suedosten", "./fels6");
}

 
   void reset()
     {
         ::reset();
               ding=1;
       }



       
get (string str)
{
  object rue;
  object ob1;
  object ob2;
  notify_fail("Wo willst Du hier hineingreifen?\n");
  if (!str) return 0;
  
   

if(str=="in grube" || str=="grube")

  {
  
   rue=present("sglove", TP);
   
  if(present("hands", TP))
     {
           
     write("Du hast doch schon eine Hand fast verloren, also lass "
      "es lieber sein.\n");
      return 1;
     }  


   
   if ( ((rue)&& (rue->QueryProp(P_WORN)==TP)) && (ding) )
   
   {
    write("Du greifst in die Grube hoerst ein lautes Zischen, aber sonst "
    "passiert Dir nichts. Du findest einen Gegenstand, den Du sofort einsteckst.\n");
    say(""+TPN+" freut sich sehr.\n");
    ob2=clone_object("/d/dschungel/dante/fels/obj/einobj.lpc");
    ob2->move(TP, M_NOCHECK);
    ding--;
    return 1;
  }
  
   if ( ((rue) &&( rue->QueryProp(P_WORN)==TP)) && (!ding) )
  
  {
    write("Du greifst in die Grube, es passiert Dir nichts, aber finden tust "
      "Du auch nichts.\n");
    say(""+TPN+" steckt seine Hand in die Grube.\n");
    return 1;
  }
 else

     {    
  write("Du greifst in die Grube, doch ploetzlich schiesst eine gewaltige "
  "Schlange aus dem Loch und zerfetzt Deine Hand.\n");
  TP->do_damage(15);
  TP->AddPoison(3);
  say(""+TPN+" greift in eine Grube und zieht erschreckt seine Hand zurueck.\n");
   ob1=clone_object("/d/dschungel/dante/fels/obj/hand1.lpc");
   ob1->move(TP, M_NOCHECK);
   return 1;
       }
       
   
  
  return 0;    
 }

return 0;
}    
    
      