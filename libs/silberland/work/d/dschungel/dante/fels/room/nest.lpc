#include "../def.h"

inherit "std/room";

#include <moving.h>
#include <properties.h>
#include <language.h>





create()
{
  ::create();

  SetProp( P_INT_SHORT, "Mitten im Dickicht" );
  SetProp( P_INT_LONG, BS(
  "Du nimmst all Deinen Mut zusammen und stehst mitten in einem Spinnennest. "
  "Ausser einigen Knochen und Skeletten kannst du hier nur dichtesten Urwald "
  " erkennen. Raus kommst Du hier gleich wie Du rein gekomen bist..."));

AddDetail("himmel",
"Der Himmel ist kaum zu erkennen, zu dicht ist der Dschungel hier.");
AddDetail("mut",
"Naja, feig bist Du hier und RL!");
AddDetail("rl",
"Kenne ich nicht, Du?");
AddDetail("moment",
"Augeblick...");
AddDetail("augenblick",
"Eigentlich wollte ich hier ein SpecialDetail einbauen, das Dich blind macht, "
"aber es ist Weichnachten und ich bin fromm!!!*lach*");

AddDetail("raus",
"Suedosten!");
AddDetail("rein",
"Nordwesten!");
  AddDetail( "boden",
    "Am Boden liegen viele Knochen. Ein ekliger Anblick.");
    AddDetail("anblick",
    "Einfach grausig diese vielen Knochen.");
  AddDetail( ({"spinnennest"}),
    "Du stehst mitten drinnen.");
    AddDetail("nest",
    "Genauer gesagt ein grosses Spinnennest.");
    AddDetail("suedosten",
    "Hier gehts raus.");
    AddDetail("appetit",
    "Auf Dich haben die Spinnen Appetit.");
   AddDetail("spinne",
   "Im Moment scheint keine hier zu sein. Dein Glueck.");
   AddDetail("glueck",
   "Das kann sich hier schnell aendern.");
   AddDetail("spinnen",
   "Die Spinnen scheinen nicht hier zu sein.");
   AddDetail("narren",
   "Du!");
   AddDetail("narr",
   "Dante teilt Dir mit: Hau hier lieber ab!"); 
  AddDetail(("knochen"),
  "Die Spinnen scheinen grossen Appetit zu haben...\n");
  AddDetail(({"skelett","skelette"}),
  "Andere Narren waren wohl auch so dumm wie Du.\n");
  AddDetail(("urwald"),
  "Bei naeherer Betrachtung erkennst Du eine Luecke im Dschungel.");
  AddDetail(("dschungel"),
  "Hast Du nichts besseres zu tun als hier alles zu untersuchen?");
  AddDetail(("luecke"),
  "Die Luecke fuehrt nach Suedosten, aber von hier ist sie noch nicht zu "
  "erreichen. Du musst nach Sueden gehen.");
  AddDetail("sueden",
  "Im Sueden ist eine Luecke.");
  AddDetail("betrachtung",
  "Hmmm, was koennte man den hier betrachten...");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_JUNGLE]) );

  
  AddSound( DEFAULT_SOUND,
    "Du hoerst das Krabbeln vieler Spinnen.\n");
    
  AddSmell( DEFAULT_SMELL,
    "Hier riecht es nach Tod und Verwesung.\n");

  AddItem(NPC"dspinne" , REFRESH_DESTRUCT);
  
  
  AddExit( "sueden", "./fels7");
}
