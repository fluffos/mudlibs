// a, felsen 2  by dante 97

#include "files.h"

inherit "std/room";

#include <moving.h>
#include <properties.h>
#include <language.h>
create()
{
  ::create();

  SetProp( P_INT_SHORT, "Schlangengrube der Kannibalen" );
  SetProp( P_INT_LONG, BS(
  "Mitten im dichtesten Dschungel gelangst Du an einen grausigen Ort. "
  "Hier feiern die Kannibalen ihre blutigen Rituale, bei denen sie "
  "wehrlose Gefangene, auf die sie keinen Appettit mehr haben, ihrem "
  "maechtigstem Gott widmen. Vor Dir oeffnet sich eine breite, kuenstlich "
   "angelegte Grube, aus der lautes Zischen und Klappern und ab und zu auch "
  "ein Todesschrei dringen..."));
  AddDetail(("ort"),
  "Dieser Ort wird von den Kannibalen fuer ihre grausam Opferungen verwendet.");
  AddDetail(("opferung"),
  "Sie werfen dabei Gefangene in diese Schlangengrube.");
  AddDetail(("himmel"),
  "Der Himmel ist durch das dichte Pflanzendach kaum zu sehen.");
  AddDetail(({"dach","pflanzendach"}),
  "Die Pflanzen versperren jegliche Sicht...");
  AddDetail(("boden"),
  "Der Boden ist voller Spuren...");
  AddDetail(({"spur","spuren"}),
  "Die Spuren fuehren direkt in die Grube!");
  AddDetail(({"gefangene","gefangener"}),
  "Unvorsichtige Abenteurer verlieren so oft zuerst ihr Fleisch und dann ihr Leben...");
  AddDetail(("leben"),
  "Auch Deines ist hier in Gefahr...");
  AddDetail(("gefahr"),
  "Die Gefahr lauert hier ueberall!");
  AddDetail(({"rituale","ritual"}),
  "Mehrmals im Jahr werfen sie ihre Gefangenen den Schlangen, Vipern, Nattern "
  "und Ottern zum Frasse vor.");
  AddDetail(("frasse"),
  "Grausam und brutal zerfetzen die Schlangen ihre Opfer.");
  AddDetail(({"schlange","schlangen","vipern","viper","natter","nattern"}),
  "Spring in die Grube und Du lernst sie alle kennen.");
  AddDetail(({"otter","ottern"}),
  "Magst Du Otternasen ?");
  AddDetail(({"otternasen","otternase"}),
  "Kennst Du Monthy-Phytons-Flying-Circus...");
  AddDetail(({"aequinoktien","aequinoktie"}),
  "Darunter versteht man hier die Tag-Nachtgleiche....");
  AddDetail(("appettit"),
  "Die Kannibalen haben eigentlich fast immer Hunger...");
  AddDetail(("hunger"),
  "Auch Du wuerdest ihnen schmecken...");
  AddDetail(({"todesschrei"}),
  "AHHHHHHHHHHHHHH!!!!!!!!!!");
  AddDetail(("schrei"),
  "Du beisst Dir in die Lippen, um einen Angstschrei zu unterdruecken.\n");
  AddDetail(({"lippe","lippen"}),
  "Deine Lippen sind zerbissen umd blutig...");
  AddDetail(("gott"),
  "Der maechtigste Gott der Kannibalen ist der Gott der Schlangen, auch "
  "der ohne Namen, der Grausame, der Unaussprechliche genannt.");
  AddDetail(("schlangengott"),
  "Der Gott der Schlangen verlangt von den Kannibalen immer zu den "
  "Aequinoktien grausame, blutige Opfer.");
  AddDetail(("opfer"),
  "Unbewaffnet werden sie in die Schlangengrube geworfen, um dort unten "
  "einen qualvollen, aber sicheren Tod zu finden.");
  
  AddDetail(("zischen"),
  "Du glaubst dieses Geraeusch zu kennen...");
  AddDetail(("klappern"),
  "Klingt nicht eine Klapperschlange so aehnlich...");
  AddDetail(("grube"),
  "Die Kannibalen haben hier ihre Schlangengrube angelegt...");
  AddDetail(("kannibalen"),
  "Die Kannibalen werfen, wenn sie satt sind manchmal wehrlose Opfer "
  "in diese Grube. Pass bloss auf, dass sie Dich hier nicht finden...");
  AddDetail(("schlangengrube"),
  "Wehrlose Opfer werden hier dem Schlangengott geopfert...");
  
  
  AddDetail(("umgebung"),
  "Da die Straeucher, Baeume und Farne hier so dicht wachsen, kannst Du nur "
  "wenige Meter in den Dschungel sehen.");
  AddDetail(({"wuchs","pflanzewuchs"}),
  "Die Pflanzen wachsen hier besonders ueppig und gedeihen praechtig.");
  AddDetail(("pflanzen"),
  "Du erkennst Baeume, Farne, Straeucher,...");
  AddDetail(({"farn","farne"}),
  "Die Farne hier erreichen fast die Hoehe eines ausgewachsenen Elfen.");
  AddDetail(("hoehe"),
  "Du befindest Dich auf 100 Meter ueber Meereshoehe.");
  AddDetail(({"strauch","straeucher"}),
  "Die Staraeucher kitzeln Dich ein wenig an der Nase.");
  AddDetail(("nase"),
  "Dir haengt ein wenig Rotz aus der Nase. Solttest Dich besser schneuzen!");
  AddDetail("rotz",
  "IIHH, bist Du eklig!");
  AddDetail(("meereshoehe"),
  "Tijara liegt auf Meereshoehe, und der Tafelberg auf dem Du stehst ist folglich etwas hoeher.");
  AddDetail(({"elf","elfen","elfe"}),
  "Die Elfen haben leider noch keine eigene Stadt hier, aber Azrael arbeitet "
  "fleissig dran...");
  AddDetail(("azrael"),
  "Ein Magiers des Silberland...");
  AddDetail(("silberland"),
  "Silberland, hmm, kenne ich nicht.");
  AddDetail(({"baum","baeume"}),
  "Hier wachsen vor allem Naobabs, die fuer ihre spitzen Stacheln bekannt sind. "
  "An diesem Ort scheinen sie aber erkrankt zu sein, denn sie verlieren ihre Blaetter.");
  AddDetail(({"naobab","naobabs"}),
  "Der Naobab ist eine Gummibaumart, die nur suedlich der Stadt Tijara vorkommt. "
  "Hinter einem der Baeume faellt Dir ein vermoderter Baumstamm auf.");
  AddDetail(({"baumstamm","stamm"}),
  "Der Baumstamm ist umgefallen und vermodert langsam. Eine kleine Unke sitzt auf ihm...");
  AddDetail(("unke"),
  "Die Unke quakt und springt dann weg.");
  AddDetail(({"blatt","blaetter"}),
  "Dier Blaetter fallen alle zu Boden und bilden mit der Zeit grosse Laubhaufen.");
  AddDetail(({"gummibaum","gummibaumart","art"}),
  "Aus ihnen stellen fleissige Bauern Kaugummi her.");
  AddDetail(({"bauer","bauern"}),
  "Sie bewitschaften grosse Naobabplantagen.");
  AddDetail(({"plantagen","naobabplantagen","plantage"}),
  "Hier wachsen die Naobabs allerdings wild.");
  AddDetail(("kaugummi"),
  "Einen Kaugummi haettest Du im Moment sehr gerne...");
  AddDetail(({"stadt","tijara"}),
  "Tijara ist die groesste Stadt des Gouvernements Dschungel.");
  AddDetail(("gouvernements"),
  "Der Gouverneur der Stadt Tijara leitet das Gouvernement Dschungel.");
  AddDetail(({"stachel","stacheln"}),
  "Pass bloss auf, dass Du ihnen nicht zu nahe kommst!");
  AddDetail(("dickicht"),
  "Wild wuchern die Pflanzen hier...\n"); 
   
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25, ENV_TERRAIN:TT_JUNGLE]) );
  
  AddDetail(({"haufen","laubhaufen"}),
  "Die Laubhaufen schauen sehr langweilig aus.");
  AddDetail( ({"felsblock","block"}),
    "Der Felsblock ist eher ein kleiner Tafelberg, der sich mitten im \n"
    "Dschungel erhebt.\n");
  AddDetail(({"plateau","hochplateau"}),
  "Du stehst mitten am kleinen Hochplateau, einer Insel des ewigen Gruens.\n");
  AddDetail(({"sonne","licht"}),
  "Die Sonne strahlt hier unbarmherzig herab, wird jedoch durch den leichten\n"
  "Wind ertraeglicher gemacht.\n");
  AddDetail(("wind"),                                                            
  "Hier weht eine leichte Brise, die Dich angenehm kuehlt.\n");
  AddDetail(("dschungel"),
  "Du siehst den Dschungel vor lauter Pflanzen nicht.\n");
  AddDetail(("vegetation"),
  "Die Vegetation ist hier ueppig und dicht.\n");
  AddDetail(({"blatt","blaetter"}),
  "Die Blaetter rauschen in der leichten Brise.\n");
  
  AddSound( DEFAULT_SOUND,
    "Du hoerst die wuetenden Schlangen in der Grube zischen...");
    
  AddSmell( DEFAULT_SMELL,
    "Hier riecht es stark nach Verwesung.");
 
  AddRoomMessage(({ 
    "Irgendwie bekommst Du ein unangenehmes Gefuehl.\n",
    "Du hoerst verzweifelte Hilferufe aus der Grube.\n",
    "Eine Springkobra versucht aus der Grube zu entkommen.\n",
    "Aus der Grube kommt ein Todeschrei...\n",
    "Du wagst es kaum in die Grube zu blicken.\n",
    "Ein wildes Tier bruellt im Dschungel.\n",
    "Der Wind blaest durcht die Blaetter.\n",
    "Du weichst ein Stueck von der grube zurueck.\n",
    "Aus der Grube kommt lautes Zischen.\n",
    "Du schauderst vor dem grausigen Anblick...\n",
    }),50);
  
  
  AddItem(({NPC"dkkind", NPC"dkfrau", NPC"dkanni"}), REFRESH_DESTRUCT);
  AddItem(({NPC"dkkind", NPC"dkfrau", NPC"dkanni",NPC"dkanni"}), REFRESH_DESTRUCT);
  AddItem(({NPC"dkfrau", NPC"dkanni",NPC"dkanni"}), REFRESH_DESTRUCT);
  
  AddCmd(({"kletter","spring","klettere", "springe","steig"}), "klettern");
   
  AddExit( "sueden", "./fels38");
  AddExit( "westen", "./fels36");
}

int klettern(string str)
{
notify_fail ("Wohin willst du springen ?\n");
if ( !str) 
return 0;

if ( member ( ({"in grube","in schlangengrube"}), str) !=-1 )
{
write
( " \n"
"Du nimmst allen Mut zusammen den Du hast und springst in die Schlangengrube.\n");
TP->move("/d/dschungel/dante/fels/room/grube", M_GO,
"mit Todesverachtung im Gesicht in die Schlangengrube.", "springt",
"kommt laut bruellend von oben hrein gesprungen.");
return 1;
}
return 0;
}
