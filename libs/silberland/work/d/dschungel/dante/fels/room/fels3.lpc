// a, felsen 2  by dante 97

#include "files.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Auf dem gewaltigen Felsblock" );
  SetProp( P_INT_LONG, BS(
  "Du befindest Dich in der Mitte des Felsplateaus. Im Osten und Sueden \n"
  "erhebt sich eine hohe Felswand. Der Dschungel um Dich herum blueht und \n"
  "gedeiht wie im Paradies. Das Plateau streckt sich von hier nach Westen\n"
  "und Norden aus.\n"));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25, ENV_TERRAIN:TT_JUNGLE]) );
  
  AddDetail( ({"boden"}),
    "Der Boden ist felsig.");
  AddDetail(("norden"),
  "Du versuchst in den Dschungel einzudringen, gibst aber bald wieder auf.\n");
  AddDetail(("paradies"),
  "Hier mag es zwar so aussehn, aber...\n");
  AddDetail(("westen"),
  "In diese Richtung kann man sich einen Weg bahnen...\n");
  AddDetail( ({"felsblock","block"}),
    "Der Felsblock ist eher ein kleiner Tafelberg, der sich mitten im \n"
    "Dschungel erhebt.\n");
  AddDetail(({"osten","sueden"}),
  "Die Felswaende ringsum Dich scheinen nicht zu bezwingen.\n");
  AddDetail(({"fels","wand","felswand", "spitze"}),
  "Die Felswand fuehrt weiter nach oben auf die Spitze des Felsens. Wie man\n"
  "da wohl hinauf gelangen kann?\n");
  AddDetail(({"plateau","hochplateau", "felsplateau", "insel"}),
  "Du stehst am Rande eines kleinen Hochplateaus, einer Insel inmitten des\n"
  "ewigen Gruens...\n");
  AddDetail(({"sonne","licht"}),
  "Die Sonne strahlt hier unbarmherzig herab, wird jedich durch den leichten\n"
  "Wind ertraeglicher gemacht.\n");
  AddDetail(("wind"),                                                            
  "Hier weht eine leichte Brise, die Dich angenehm kuehlt.\n");
  AddDetail(("dschungel"),
  "Die Vegetation scheint doch etwas anders als am Boden zu sein...\n");
  AddDetail(("vegetation"),
  "Die Vegetation ist hier ueppig und dicht.\n");
  AddDetail(({"blatt","blaetter"}),
  "Die Blaetter rauschen in der leichten Brise.\n");
  
  AddSound( DEFAULT_SOUND,
    "Irgendwo hier fliesst Wasser...");
    
  AddSmell( DEFAULT_SMELL,
    "Du glaubst irgendwelche Fruechte zu riechen.");


  AddItem( ({NPC_WEG"dschlange1", NPC_WEG "gmamba", NPC_WEG "dratte", 
             NPC_WEG "dkoli"}), REFRESH_DESTRUCT);
  
  AddExit( "westen", "./fels5");
  AddExit( "osten", "./fels1");
}
