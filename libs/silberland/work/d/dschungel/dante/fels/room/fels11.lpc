// hinter dem steintor am plateau

#include "files.h"

inherit "std/room";
#include <moving.h>
#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Hinter dem Felstor" );
  SetProp( P_INT_LONG, BS(
   "Der Weg macht einen scharfen Knick und fuehrt Dich in einen enge, kleine\n"
   "Schlucht. Wozu das Steintor fragst Du dich, hier scheint ja nix, zu sein.\n"
   "Die steilen Waende sind hier voller Pflanzen, die sich den Fels nach oben \n"
   " winden.\n"));
   AddDetail(("weg"),
   "Der Weg fuehrt vom Steintor weiter in die kleine Schlucht hinein.\n");
   AddDetail(("knick"),
   "Der Weg biegt hier scharf nach Westen um.\n");
   AddDetail(({"felswand","felswaende","wand","waende"}),
   "Die Waende sind steil und wild bewachsen. Ob man sie erklimmen kann?\n");
   
   AddDetail(("schlucht"),
   "Diese kleine Schlucht ist eher eine Spalte zwischen zwei steil nach oben \n"
   "ragenden Felswaenden.\n");
   AddDetail(({"tor","steintor"}),
   "Das Tor fuehrt wieder nach draussen auf das Hochplateau\n");
   AddDetail(({"plateau","hochplateau"}),
   "Von hier aus kann man kaum was vom Plateau erkennen, obwohl Du ja noch \n"
   "immer auf ihm bist.\n");
   AddDetail(("fels"),
   "Du bist hier eigentlich von Fels umzingelt.\n");
  AddDetail(({"spalte","spalt"}),
  "Wenn Du senkrecht nach oben schaust, glaubst Du, dass der Spalt nach oben\n"
  " hin immer enger wird. Tja, wahrscheinlich ne optische Taeuschung? Man \n"
  "erkennt auch einen strahlendblauen Himmel, die Sonne steht am Zenit und \n"
  " an und zu ziehen ein paar Voegel vorbei.\n"); 
  AddDetail(("himmel"),
  "Am blauen Himmel kann man keine einzige Wolke sehn.\n");
  AddDetail(({"vogel","voegel"}),
  "Ganze Schwaerme exotischer Voegel ziehn ueber Deinen Kopf hinweg.\n");
  AddDetail(("sonne"),
  "Hoch am Himmel steht die Sonne und brennt unbarmherzig herunter.\n");
  AddDetail(("zenit"),
  "Hmm, was koennte das wohl sein?\n");
  AddDetail(({"wolken","wolke"}),
   "Ueber den Wolken muss die Freiheit wohl grenzenlos sein...\n");
   AddDetail(({"pflanze","pflanzen"}),
   "Die Waende sind voller exotischer Pflanzen. Lianen haengen von oben \n"
   "herab, Kletterfeu windet sich nach oben, am Boden stehn kleine Buesche,\n"
   "ein tropischer Gummibaum waechst fast bis nach oben...\n");
  AddDetail(({"liane","lianen"}),
  "Die Lianen haengen ueber den oberen Rand bis ganz nach unten. Ob man an\n"
  "ihnen hochklettern kann?\n");
  AddDetail(({"boden", "buesche","busch"}),
  "Ein kleiner mickriger Busch. Er hat hier wohl zu wenig Sonne...\n");
  AddDetail(({"efeu","kletterefeu"}),
  "Das Efeu schlaengelt sich vom Boden nach oben.\n");
  AddDetail(("gummibaum"),
  "Aus so einem Baum kann man Kautschuk gewinnen.\n");
  AddDetail(("kautschuk"),
  "Als Du Dir gerade ueberlegst, was Kautschuk wohl ist, siehst Du auf \n"
  "auf ein Seil von oben herab haengen, das Du wohl uebersehen hast.\n");
  
  AddDetail(("seil"),
  "An diesem Seil kann man sich sicher hochhangeln...\n"); 
  SetProp( P_LIGHT, 1 );
  
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_JUNGLE]) );

 AddDetail(("dschungel"),
 "Vom Dschungel ist hier wenig zu sehn...\n");

  AddSound( DEFAULT_SOUND,
    "Von weiter oben glaubst Du Stimmen zu hoeren.");
    
  AddSmell( DEFAULT_SMELL,
    "Hier riecht es nach Rauch und Feuer.");

  
  AddExit( "nordosten", "./fels10");
  AddExit( "westen", "./fels12");

 AddCmd( ({"hangel","hantel","hangle","hantle"}), "hangel");

 
 AddItem(NPC"dkanni" , REFRESH_DESTRUCT);
}
int hangel(string str)
{
 notify_fail("Wohin willst Du ?\n");
 if( !str ) return 0;
 if( member( ({"mit seil nach oben", "auf seil hoch", "auf seil nach oben",
            "an seil hoch", "an seil nach oben" ,"mit seil hoch"}),str) !=-1 )
               
  {
   write("Du hangelst Dich am Seil hoeher.\n");
   TP->move("/d/dschungel/dante/fels/room/fels13", M_GO, "nach oben.","klettert",              
             "kommt von unten herauf geklettert.");
             return 1;
             }
             return 0;
             }   
             
