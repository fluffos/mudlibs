// eine suesse biene dante sl 97feb

inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <mnpc.h>
#include "files.h"

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Biene");
  SetProp(P_LONG, BS(
    "Eine kleine Biene, die emsig von Bluete zu Bluete schwirrt."));
  SetProp(P_NAME, "Biene");
  SetProp(P_GENDER, FEMALE);
  AddId(({"biene", "maya"}));

  create_default_npc(2);
  SetProp(P_HANDS, ({" mit ihrem spitzen Bienenstachel ",30 ,
      ({DT_PIERCE,DT_POISON}) }));
  SetProp(P_RACE, "Insekt");
  SetProp(P_SIZE, 10);
  SetProp(P_ALIGN, 100);
  SetProp(P_MAX_HANDS, 6);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_RESISTANCE, ({ DT_BLUDGEON })); 
  SetProp(P_NOMAGIC,0);

  SetProp(P_MSGIN, "schwirrt herein");
  SetProp(P_MSGOUT, "schwirrt");
  SetProp(P_MMSGIN, "schwirrt herein");
  SetProp(P_MMSGOUT, "verschwindet im Bienenstock");
  SetProp(P_MNPC_AREA, ("/d/dschungel/dante/weg/room"));
  SetProp(P_MNPC_WAIT, ({10, 5, 5}));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "planta1");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES+MOV_BACKWARDS);

  SetProp(P_DIE_MSG,  " wird nie mehr Blueten bestaeuben koennen.\n");
  SetProp(P_NOCORPSE, 0 );

  AddInfo(DEFAULT_INFO, "schwirrt nur um Dich herum.\n");
  AddInfo("Dante", "Dante hat mich erschaffen.","sagt: ");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Aber die Biene ist doch viel zu klein.\n" }) );


  SetChats(3, ({
  "SUMMM....SUMMM....SUMMM....\n",
  "Die Biene laesst sich auf Deiner Nase nieder.\n",
  "Die Biene summt...\n",
  "Die Biene schwirrt zur naechsten Bluete weiter.\n",
  "Die Biene sitzt auf einer Bluete.\n",
  "Die Biene schwirrt um Deinen Kopf herum.\n"}) );
  
  SetAttackChats(10, ({
  "Die Biene summt aufgeregt.\n",
  "SSSUMMM....SSSUMMM....SSSUMMM....\n",
  "Die Biene schwirrt aufgeregt herum.\n",
  "Die Biene versucht Dir in Deine Nase zu stechen.\n"}) );

  SUID;
  CLONEME(WEAPON "dbstachel" );
  command("zuecke stachel");
}

