//fahrendes objekt eigentlich mnpc..
//kann man betreten -->kneipe



inherit "std/mnpc";
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "files.h"
#include <mnpc.h>    

int feet;


create()
{
 
  if (!is_clone(TO)) return;
  ::create();
  
  set_living_name("schneckenhaus");
 // enable_commands();
    
  SetProp(P_SHORT, "Ein Schneckenhaus auf tausend Beinen");
  SetProp(P_LONG, BS(
   "Was Du hier vor Dir siehst erstaunt Dich doch ein wenig. Du siehst ein "
   "sehr grosses Schneckenhaus, das von einem Tausendfuessler getragen wird. "
   "Der Tausendfuessler ist einige Meter lang und schaut schon etwas erschoepft "
   "aus. Im Schneckenhaus ist aber keine Schnecke mehr, sondern eine kleine "
   "Kneipe. Mit < betritt schneckenhaus, haus, kneipe > kannst Du ins Innere."));
  
  
  AddDetail(({"haus","schneckenhaus"}),
  "Das Schneckenhaus ruht auf dem Ruecken des Tausendfuesslers.");
  AddDetail("kneipe",
  "Die Kneipe ist im Schneckenhaus. Betritt sie doch einfach!");
   AddDetail("ruecken",
   "Der Ruecken des Tausenfuesslers muss einiges aushalten!");
   AddDetail(({"fuesse","beine","fuss","bein"}),
   "Hmm, es sollten tausend sein...");
   AddDetail(({"inneres","innere"}),
   "Betritt das Schneckenhaus!");
   AddDetail(({"tausendfuessler","fuessler","tausend"}),
   "Der Tausendfuessler oder auch 1000 Fuessler wie manche sagen, "
   "hat tausend Fuesse. Dieser hat noch dazu ein Schneckenhaus am Ruecken!");
     
  SetProp(P_NAME, "Schneckenhaus auf tausend Beinen");
  SetProp(P_GENDER, NEUTER);
  AddId(({"kneipe","haus", "schneckenhaus","tausendfuessler","schneckenkneipe"}));
  SetProp(P_INFO,
  "Der Tausenfuessler wandert mit dem Schneckenhaus "
  "im Dschungel herum.\n");
  SetProp(P_MATERIAL, ([MAT_ANIMAL:50, MAT_CHITIN:30, MAT_HORN:10]));  
  create_default_npc(30);
   SetProp(P_NOATTACK, "hat es auch ohne Deine Belaestigungen "
  "schwer genug! Lass Ihn in Ruhe, Du Quaelgeist!\n");
  set_living_name("schneckenhaus");  
  SetProp(P_HANDS, ({" mit seinen winzigen Zaehnchen", 30, DT_POISON}));
  SetProp(P_RACE, "Schneckenhaus mit tausend Beinen");
  SetProp(P_SIZE, 100000);
  SetProp(P_ALIGN, 0);

  SetProp(P_MSGIN, "trippelt mit tausend Beinen herein");
  SetProp(P_MSGOUT, "trippelt mit tausend Beinen");
  SetProp(P_MMSGIN, "krabbelt mit tausend Beinen herein");
  SetProp(P_MMSGOUT, "krabbelt schnell davon");
  SetProp(P_MNPC_AREA, ("/d/dschungel/dante/weg/room/"));
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_INDOORS );
  SetProp(P_MNPC_WAIT, ({10, 100 ,50}));
  SetProp(P_MNPC_DEFAULTROOM,  "/d/dschungel/dante/weg/room/weg14");
  SetProp(P_DIE_MSG,  " stirbt sicher nie durch einen Spieler.\n");
  SetProp(P_DEFAULT_INFO, "sagt: Bitte betreten Sie das Schneckenhaus.\n");
  
    

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Tausenfuessler sagt: Nein, danke!\n" }) );

  SetProp(P_AGGRESSIVE,0);
  SetProp(P_MAX_HANDS, 0);
AddInfo(({"fuesse","fuss","beine","bein"}),
"Zaehl sie doch einfach ab!","sagt: ");
 AddInfo("tausendfuessler",
 "Das bin ich!", "sagt: ");
 AddInfo("kneipe",
 "Die ist im Schneckenhaus.", "sagt: ");
 AddInfo(({"essen", "trinken","getraenke","speisen"}),
 "Betritt einfach das Schneckenhaus.", "sagt: ");
 AddInfo("haus",
 "Das Schneckenhaus, hmm...", "sagt: ");
 AddInfo("schneckenhaus",
 "Das ist auf meinem Ruecken!", "sagt: ");
 AddInfo("ruecken", 
 "jammert nur laut...");
 AddInfo("schnecke", 
 "Verrate es nicht weiter, aber die hat Dante gefressen!", "sagt: ");
  

  AddCmd(({"zaehle","zaehl"}),"count");
  //hier will ich das man fps bekommt wenn man zaehlt
  
 AddCmd(({"betritt", "betrete"}), "into");

}

  into(string str)
  {
  notify_fail("Was willst Du betreten?\n");
  if (!str) return 0;
 
  if(member(({"haus","schneckenhaus","kneipe"}),str)!=-1)
       { 
   write("Du steigst auf den Ruecken des Tausendfuesslers, der Tausendfuessler "
   "bruellt auf und eilig verschwindest Du im Schneckenhaus.\n");
   TP->move("/d/dschungel/dante/weg/room/fak2.lpc", M_GO,
   "das Schneckenhaus","betritt","kommt ins Schneckenhaus herein");
   return 1;
       }
   }
       
     



 count(string str)
    {
    feet=random(200)+900;
     
     if (feet==1000) { feet++;}
        
   notify_fail("Was willst Du hier abzaehlen?\n");
   if (!str) return 0;
      if (member(({"beine ab","fuesse ab","beine","fuesse"}),str)!=-1)
          {
          write("Du zaehlst die Fuesse des Tausenfuesslers ab und kommst "
          "schliesslich nach muehevoller Zaehlung auf "+feet+" Fuesse! Sowas "
          "aber auch! Das ist ja Betrug!!! Der hat ja gar nicht 1000 Fuesse!!!\n");
          return 1;
          }
     return 0;
     }
          
