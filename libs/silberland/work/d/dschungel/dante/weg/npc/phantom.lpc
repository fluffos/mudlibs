//dante sl 96-2001
//phantom angepasst gems vermindert

inherit "std/mnpc";

#include "files.h"
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <mnpc.h>
#include <moving.h>
#include <new_skills.h>

string *orte;

create()
{
  
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Das gruene Dschungelphantom");
  SetProp(P_LONG, BS(
     "Das Dschungelphantom ist eigentlich nicht zu beschreiben. Es rast von einer "
     "Stelle des Dschungels zur anderen und sammelt ueberall Edelssteine und "
     "Perlen auf."));
     SetProp(P_NAME_ADJ, "gruen");
                                                                        
  SetProp(P_NAME, "Dschungelphantom");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"dschungelphantom", "phantom"}) );
  create_default_npc(27);
  SetProp(P_HANDS, ({" mit einem Phantomangriff", 180, DT_MAGIC}));
  SetProp(P_SIZE, 100+random(100));
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_ALIGN, 0);
  SetProp(P_RACE, "Geist");
  SetProp(P_MAX_HANDS, 2);
  AddInfo(DEFAULT_INFO, "Das Dschungelphantom phantasiert.\n");
  SetProp(P_REJECT, ({ REJECT_KEEP, 
     "Das Dschungelphantom sammelt alles ein...\n"}));
  SetProp(P_DIE_MSG, " verschwindet zu Phantomas.\n");
  SetProp(P_INFO, ("Das Dschungelphantom haelt sich nur an bestimmten Stellen auf."));
  
  call_out("st1", 10+random(10));
  
  SetProp(P_NOCORPSE, 1);
  SetProp(P_WIMPY, 100);
  SetProp(P_NOMAGIC, 10);
  SetProp(P_SPELLRATE, 70);
  
  
  SetProp(P_MSGIN, "materialisiert sich vor Dir");
  SetProp(P_MSGOUT, "schwebt scheinbar");
  SetProp(P_MMSGIN, "materialisiert sich vor Dir");
  SetProp(P_MMSGOUT, "dematerialisiert sich");
  SetProp(P_MNPC_AREA, "/d/dschungel/dante/");
  SetProp(P_MNPC_DEFAULTROOM, ROOM "tuempel1");
  SetProp(P_MNPC_FLAGS, MOV_MOVES + MOV_OUTDOORS + MOV_INDOORS);
  SetProp(P_MNPC_WAIT, ({30,30,15}) );
  
  
  AddSpell(5, 400, 
   "Das Dschungelphantom huellt Dich in einen Phantomnebel.\n",
    "Das Dschungelphantom huellt @WEN in einen Phantomnebel.\n",
    DT_ACID, ([SP_SHOW_DAMAGE:1]));                                                               
  AddSpell(5, 400, 
    "Das Dschungelphantom rast um Dich herum.\n",
    "Das Dschungelphantom rast um @WEN herum.\n",
     DT_AIR, ([SP_SHOW_DAMAGE:1]));
  AddSpell(5, 400,
    "Das Dschungelphantom strahlt phantomare Energie auf Dich.\n",
    "Das Dschungelphantom strahlt phantomare Energie auf @WEN.\n",
     DT_MAGIC, ([SP_SHOW_DAMAGE:1]));
  AddSpell(1, 600,
    "Das Dschungelphantom dringt in Dich ein.\n",
    "Das Dschungelphantom dringt in @WEN ein.\n",
     DT_TERROR, ([SP_SHOW_DAMAGE:1]));
  AddSpell(1,1,
    "Das Dschungelphantom stiehlt Deine Edelsteine.\n",
    "Das Dschungelphantom stiehlt @WESSEN Edelsteine.\n",
    DT_MAGIC,"stehlen");
 
 SetChats(4, ({
    "Das Dschungelphantom schwebt nach oben.\n",
    "Das Dschungelphantom schwebt nach unten.\n",
    "Das Dschungelphantom schimmert durchsichtig.\n",
    "Das Dschungelphantom scheint sich aufzuloesen.\n",
    "Das Dschungelphantom scheint keine Gestalt zu haben.\n"}) );
 
  SUID;
 switch(random(3))  {
 case 0:
 "obj/pearlmaster"->DistributePearl(2, 2,1, 1);
  break;
case 1:
  "obj/gemmaster"->DistributeGem(2, 2,1, 1);
break;
case 2:
break;
    default:
  
}

/*
"/d/dschungel/trintrasil/sdschungel/strand1",
"/d/dschungel/trintrasil/sdschungel/bruecke1",
*/
orte= ({
"/d/dschungel/dante/weg/room/vorsprung",
"/d/dschungel/dante/weg/room/planta3",
"/d/dschungel/dante/weg/room/weg12",
"/d/dschungel/dante/weg/room/tuempel1"});
}

void st1()
{
  string ort;
  ort=orte[random(sizeof(orte))];
   move(ort, M_TPORT);
   call_out("st2", 20+random(10));
}

void stehlen(object enemy, int dam, mixed dam_type)
{
  object ob;
  while( ob=deep_present("edelstein", enemy))
  {
    if(!random(3)) 
      ob->move(TO, M_GIVE|M_SILENT );
  }
}

void init()
{
  ::init();
  call_out("edelsteine",0);
}

void edelsteine()
{
  if(present("edelstein",MENV))
    command("nimm edelstein");
}

