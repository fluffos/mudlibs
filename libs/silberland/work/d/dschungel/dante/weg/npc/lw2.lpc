//objekt wurm um reinzustecken in frucht usw
//kann man auch aussetzen dann lebt er weiter

#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Ein Lichtwurm (in Totenstarre)");
  SetProp(P_LONG, BS( 
    "Das ist ein kleiner gefangener Lichtwurm. Zumindest war er "
    "einmal gefangen und ist nun in einer Art Totenstarre. Du kannst ihn "
    "weder angreifen noch kann er Dir etwas anthaben! Wenn Du ihn aussetzt "
    "erwacht er wieder zum Leben! Zu lange solltest Du den Wurm in diesem "
    "Zustand nicht belassen ohne ihn zu verwenden..."));
    
    SetProp(P_INFO, "Diesen Lichtwurm kann man in bestimmte Fruechte stopfen.\n"
    "Dort erzeugt er angeblich Licht.\n");
    
  SetProp(P_NAME, "Lichtwurm");
  SetProp(P_GENDER, MALE);
  AddId(({"lw2", "lw", "wurm", "lichtwurm"}));
  SetProp(P_MATERIAL, ({ MAT_ANIMAL}) );
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 100);
  SetProp(P_NOBUY, 1);
  
  AddCmd(({"setze", "setz"}), "reanimate");
  
}

 reanimate(string str)
     {
     notify_fail("Was oder wen willst Du aussetzen?\n");
     if (!str) return 0;
     
     if (member(({"wurm aus", "lichtwurm aus"}),str)!=-1)
         {
         write("Du setzt den kleinen Lichtwurm wieder aus. Sofort "
         "beginnt er sich zu bewegen und erwacht wieder.\n");
         call_out("worm", 0);
         return 1;
         }
     return 0;
     }
     
     void worm()
     {
     object wu;
     wu=clone_object("/d/dschungel/dante/weg/npc/lw.lpc");
     wu->move(environment(TP), M_TPORT + M_SILENT);
     TO->remove(1);
     }
     
         
  void reset()
     {
     ::reset();
     write("Der Lichtwurm verfault.\n");
     TO->remove(1);
     }
     
     

