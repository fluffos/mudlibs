void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  object ob;
  command("nimm alles aus leiche");
  write_file("/d/dschungel/dante/weg/log/wkillt",
      ctime()+":  Waechter hat "+CAP(getuid(player))+" umgebracht.\n");
  ob=deep_present("MUT", player);

  if(ob) {
    ob->remove();
  }
  kampf=0;
  sp="";
}


die(arg)  {
  heal_self(5000);
  return 0; 
}



Defend(int dam, string dam_type,mixed spell, object enemy)  {

  object ob, ges;
  object ru;
  string wer;
  int x;
  wer=CAP(getuid(TP));


  ob=deep_present("D_WK", enemy);

  if(!ob)  
  {  	
    tell_object(enemy,
        "Der Waechter sagt: Nana, so geht das sicher nicht!\n"
        "Dann grinst er Dich ueberlegen an!\n");
    enemy->StopHuntingMode();
    TO->StopHuntingMode();

  }

  if(ob)  {
    ob->runden_zaehler();

    x = ::Defend(dam, dam_type, spell, enemy) ;

    ges=deep_present("D_GESCHAFFT", enemy);
    if(ges)
    {

      kampf_aus();

      tell_object(enemy,
          "Der Waechter teilt Dir mit: Gratuliere! Du hast es geschafft!\n");		
      domainshout(BS(
            ""+CAP(getuid(enemy))+" besteht die Mutprobe!!!"));

      stopzeit=time();
      zeit=stopzeit-startzeit;


      write_file("/d/dschungel/dante/weg/log/probeja",
          ctime()+": "+CAP(getuid(PL))+" schafft die Mutprobe. Zeit: "+zeit+"\n");

      ges->remove();

      if(!deep_present("D_RS", enemy))  {
        tell_object(enemy,
            "Der Waechter wirft Dir einen Rucksack zu!!!\n");
        ru=clone_object("/d/dschungel/dante/weg/obj/as");
        ru->set_name(wer);
        ru->move(TP, M_NOCHECK);
      }

      wer="";
      stopzeit=0;
      startzeit=0;
      zeit=0;
      while(remove_call_out("kampf_aus")!=-1) ;
      return ;

    }
    return x;
  }		
}


int stop_sack()  {
  object ob;
  ob=deep_present("D_WK", TP);

  if(!ob)  {
    write(BSA(
          "NEIN! Du bist ja nicht dabei, die Mutprobe zu versuchen!",
          "Der Waechter sagt: ")); return 1; 
  }

  if(ob)  {

    kampf=0;

    write(BSA(
          "OK! Stop! Du bist leider zu schwach! Uebe lieber noch weiter!",
          "Der Waechter grinst: "));		
    ob->remove();

    TP->StopHuntingMode();
    TO->StopHuntingMode();
    sp="";
    while(remove_call_out("kampf_aus")!=-1) ;

    write_file("/d/dschungel/dante/weg/log/aufgabe",
        ctime()+": "+CAP(getuid(PL))+" gab feig auf!\n");

    return 1; 
  }
  return 0; 
}


int start_sack()  {
  object ob;

  if( (CAP(getuid(TP))==""+sp+"") && (sp!="") )  {
    write(BSA(
          "Aber "+TPN+", Du kaempfst doch schon, Du Wappler!",
          "Der Waechter sagt: ")); return 1; 
  }

  if(kampf==1)  {
    write(BSA(
          "Sorry, aber ich kaempfe gerade mit "+sp+"! Geduld!",
          "Der Waechter sagt: "));
    return 1; 
  }

  /*
     if(deep_present("D_RS", TP))  {
     write(BSA(
     "Nein! Du hast ja eh schon einen Rucksack, Du Sack!", 
     "Der Waechter grinst: "));
     return 1; }
   */

  if(deep_present("D_WK", TP))  {
    write(BSA(
          "Du bist doch schon mitten in der Mutprobe, Du Wicht!!!",
          "Der Waechter lacht: "));		
    return 1; 
  }

  if(!deep_present("D_WK", TP))  {

    startzeit=time();
    sp=CAP(getuid(TP));

    kampf=1;

    while(remove_call_out("kampf_aus")!=-1) ;
    call_out("kampf_aus", 131);

    write(BSA(
          "ACHTUNG!!! ES GEHT LOS!!!",
          "Der Waechter bruellt: "));

    domainshout(
        ""+CAP(getuid(PL))+" beginnt die Mutprobe beim Dschungelwaechter!!!\n");

    ob=clone_object("/d/dschungel/dante/weg/obj/mutprobe");
    ob->move(TP, M_NOCHECK);
    Kill(TP);
    return 1; 
  }
  return 0; 
}

kampf_aus()  {
  TP->StopHuntingMode();
  TO->StopHuntingMode();
  sp="";
  kampf=0;
}



//mutprobe ende

int end_quest(string str)
{
  object ob1, ob2, ob3;

  ob1=present("ESSEN", TP);
  ob2=present("PFANNEFERTIG", TP);
  if(!ob2)
  {
    write(BSA(
          "Tja, das glaube ich nicht! Du bist nicht fertig mit der Quest! "
          "Ich habe noch Hunger, los beeil Dich!", "Der Waechter sagt: "));
    return 1;
  }
  if(!ob1)       
  {
    write(BSA(
          "Nein, das kann nicht sein! Schwindler!", 
          "Der Waechter lacht: "));
    return 1;
  }
  else
  {
    if(deep_present("SAB", TP))
    {  write(BSA(
          "Nein, Du bekommst sicher keinen zweiten Sabberlatz von mir!"
          "Trotzdem danke fuer das Omelett!\n",
          "Der Waechter sagt: "));
    write("Daraufhin nimmt er Dir die Pfanne weg und verspeist alles mit "
        "einem Bissen!\n");
    ob1->remove();
    ob2->remove();
    return 1;
    }   
    if(!deep_present("SAB", TP))
    {
      write(BSA("Endlich, ich sterbe vor Hunger! Danke sehr! Dafuer "
            "werde ich Dir in Zukunft, wenn Du hungrig bist auch helfen!", 
            "Der Waechter sagt: "));
      write("\nDaraufhin reisst er Dir die Pfanne aus der Hand und "
          "verschlingt den Inhalt mit einem Happen! Dann wirft er die "
          "Pfanne weg und schaut wieder hungrig drein!\n");
      switch (TP->GiveQuest(QUESTNAME)) {
        case 1:  write_file("/log/quests/waechter", 
                     dtime(time())+": "+CAP(getuid(TP))+" loest die Quest.\n");
                 break;
        default: write_file("/log/quests/waechter",
                     dtime(time())+": Fehler bei "+CAP(getuid(TP))+"!\n");
      }
      write(BSA(
            "Du wartest sicher auf eine Questbelohung. Gut, sollst Du haben!",
            "Der Waechter sagt freundlich: "));
      write("Daraufhin gibt er Dir einen Sabberlatz und grinst!\n");
      ob3=clone_object("d/dschungel/dante/weg/armour/latz");
      ob3->SetProp(P_SHORT, CAP_TPN+"`s Sabberlatz");
      ob3->move(TP, M_NOCHECK);
      ob1->remove();
      ob2->remove();
      return 1;
    }
    return 0;
  }  
  return 0;
}

