hallo()
{
  if(environment(TP)!=environment(TO))
    return;


  //du kleiner komplexhaufen (diejenige fuer die dies ist, weiss schon dass sie
  //gemeint ist.)

  if ( (getuid(this_player())!="dante")&&
      (TP->QueryProp(P_INVIS)!=0))
  { 
    domainshout(BSA(
          ""+TP->name(RAW)+" ist gerade unsichtbar bei mir vorbeigekommen!!! Will "
          "sich wohl vor den Spielern verstecken?!",
          "Der Waechter des Dschungels ruft: "));
    return; 
  }

  if(deep_present("D_WK", TP))  {
    write(BSA(
          "NA! Noch nicht genug, Du Wicht!",
          "Der Waechter bruellt: "));
    Kill(TP);  return ; 
  }

  if (getuid(this_player())=="dante")
  {

    say(
        "Der Waechter verbeugt sich tief, laechelt und sagt danach: \n"
        "Keine Vorkommnisse, oh Dante! Alles in Ordnung!\n");
    return;
  }

  else if (getuid(this_player())=="immomentkeinerweilkeinerbloedwar")
  {

    write(
        "Der Waechter des Dschungels lacht Dich aus und sagt hoehnisch spottend:\n"
        ""+TPN+", tja Pech gehabt! Du darfst auf Anordnung von Dante den Dschungel nicht mehr betreten!\n"
        "Darauf hin tritt er Dir ins Gesicht und Du fliegst wieder zurueck!\n");

    say("Der Waechter des Dschungels lacht "+TPN+" aus!!!\n"
        "Danach tritt er "+TPN+" wieder zurueck nach Tijara!\n");

    TP->move("d/dschungel/feyaria/tijara/room/tor_d7.lpc", M_GO ,
        "sich unter Heulen und Jammern wieder nach Tijara zurueck", "schleicht",
        "wird vom Waechter des Dschungel hier hergetreten");
  }

  else if (getuid(this_player())=="moppy")
  {
    say(
        "Der Waechter knuddelt Moppy.\n\n");

    say(BS("Der Waechter des Dschungels sieht Moppy und freut sich die "
          "lieblichste Hobbitbraut aller Welten hier begruessen zu duerfen!"));
    say(
        "\nDer Waechter denkt . o O 'Dante ist ein Schleimer'!\n");


    write(BSA(
          "Hallo Moppy, Ente habe ich leider keine, aber die ist sowieso "
          "nicht gut fuer Deinen Stuhlgang und Dante und ich sind immer besorgt darum! "
          "Ich habe aber einen kahlkoepfigen PC-Trottel fuer Dich hier...",
          "Der Waechter sagt: "));

    return;
  }

  else if (getuid(this_player())=="tessa")
  {
    say(BS("Der Waechter des Dschungels bemerkt Tessa, die Schlampe, "
          "und nimmt dann seufzend und kopfschuettelnd einen tiefen Schluck aus "
          "einer Dschungelrumflasche."));
    write(BSA(
          "Hallo alte Schlampe, spielst Du wieder die coole unabhaengige und trauerst "
          "in Wahrheit noch immer dem dicken, kleinen Unterhosennoergler nach? Oder denkste "
          "nun eher an Dels angesifftes Pyjama oder an creativen Zehennaegelsex?",
          "Der Waechter sagt: "));
    return;
  }

  else if (getuid(this_player())=="sisqui")
  {
    say(BS("Der Waechter des Dschungels sieht Sisqui, schuettelt den "
          "Kopf und nimmt dann einen grossen Schluck aus einer Wodkaflasche."));
    write("Der Waechter sieht Dich und schuettelt nur den Kopf.\n"
        "Dann nimmt er einen tiefen Schluck aus einer Flasche Wodka.\n");
    return;
  }

  else if (getuid(this_player())=="verdegard")
  {
    domainshout
      ("Der Waechter des Dschungels ruft: Versteckt Euren Wein!\n"
       "Der Waechter des Dschungels ruft: Verdegard kommt!!!\n");

    write(BSA(
          "BOAH! Verdegard! Hast Du etwa die ganze Flasche Wein ausgetrunken?! "
          "Das sind ja zustaende wie in Russland!",
          "Der Waechter des Dschungels sagt: "));               
    return;
  }

  else if (getuid(this_player())=="fenris")
  {
    domainshout("Der Waechter des Dschungels bruellt extrem laut:\n"
        "Fenris, du altes Seicherl. Geh lieber in den Anfaengerpark!\n");

    write("Der Waechter sagt zu Dir: Ist ja nur ein Spass, Seicherl.\n");
    return;
  }

  else if (getuid(this_player())=="subsonic")
  {
    write(BSA(
          "He! Subsonic! Dein Musikgeschmack ist fuern Arsch! Wir hier lieben "
          "alle Musicals und Sissi! Und noch was! Huete Dich vor dem U4! Da drinnen "
          "verbloedet man nur! Und penn nicht nochmal am Tresen ein!",
          "Der Waechter sagt: "));
    say("Der Waechter dubbt um Subsonic herum. Spinnt er?!\n", ({TP}));;
    return;
  }

  else if (getuid(this_player())=="lamyra")
  {
    write(BSA(
          "He! Ich bin kein Knabe! Das das mal klar ist. Ich nenn Dich ja auch nicht "
          "Maederl, obwohl...", "sagt grinsend: "));
    say(BSA(
          "Hallo Lamyra-Maederl. Putzig bist Du schon...", "sagt frech: "));
    return;
  }

  else if (getuid(this_player())=="trintrasil")
  {
    say("Der Waechter grinst dreckig wie ein Zug aus Wien und sagt:\n"
        "Hi, Trintrasil, als Chemiestudent solltest Du doch eher bei der \n"
        "chemischen Reinigung arbeiten. Und noch was, Mopeds sind keine "
        "idealen Schlafplaetze!\n");
    return;

  }

  else if (getuid(this_player())=="skunk")
  {
    say(
        "Der Waechter laechelt Skunk dumm an und sagt: Hi, Skunk! Alte Beutelratte!\n"
        "Wie gehts dem Beutelland? Wollen wir Sturm gegen Barcelona oae. gehen?\n");
    return;
  }

  else if (getuid(this_player())=="dings")
  {
    say("Der Waechter grinst genauso so dumm wie Dings und sagt dann:\n"
        "Hi Dings! Heute wieder Unfug treiben im Dschungel? Tja, da wird "
        "sich Dein Chef Amnenion aber nicht freuen. Ach, uebrigens, was ist das "
        "komische Dings da auf Deiner Nase, ein Pickel? Ih, eklig. Das kommt "
        "sicher vom saufen...\n");
    return; 
  }

  else if (getuid(this_player())=="verdandi")
  {
    say("Der Waechter zuckt zusammen und sagt dann schuechtern:\n"
        "Hi, Verdandi, bitte spalte mich nicht, ich mag das gar nicht gerne.\n"
        "Dann schaut er hoehnisch und richtet ihr schoene Gruesse vom Ykath aus.\n");
    return;
  }

  else if (getuid(this_player())=="chiara")
  {
    say("Der Waechter schaut freundlich und sagt zu Chiara:\n"
        "Hi, Chiara, sei froh, dass Du nicht Amnion oder Chorion heisst.\n"
        "Und noch was, alkoholfreies Bier hat seine Vorteile.\n");
    return;
  }

  else if (getuid(this_player())=="amnenion")
  {
    say("Der Waechter salutiert und sagt dann zackig zu Friedl:\n"
        "Du, Amnenion, ich verrate Dir ein ein Geheimniss. Das Passwort von Dante "
        "ist doch nicht DuBloedeSau, sondern eher DantesHumoristdoof...\n");
    return;
  }

  else if (getuid(this_player())=="eve")
  {
    say("Der Waechter schaut Eve an und sagt dann grinsend:\n"
        "Clautschi, Hallo! Bist Du einer Meinung mit mir, wenn ich behaupte, "
        "dass Brezel ein Spinner ist?\n");
    return;
  } 

  else if (getuid(this_player())=="ovid")
  {
    say("Der Waechter grinst boese und sagt dann zu Ovid:\n"
        "Wappler, was testest denn wieder...\n");
    return;
  }

  else if (getuid(this_player())=="angrox")
  {
    write(BSA(
          "Tag Angrox! Verlauf Dich ja nicht im Dschungel! Aber als RM "
          "wirst Du Dich schon auskennen.",
          "Der Waechter des Dschungels sagt: "));
    say("Der Waechter des Dschungels grinst Angrox frech an!\n");
    return;
  }

  else if (getuid(this_player())=="muaddib")
  {
    write(BSA(
          "Tag lieber Muaddib! 7207842 Quests warten auf Dich! "
          "Also lass die wolkigen Gedanken und ran an die Arbeit!",
          "Der Waechter des Dschungels sagt: "));
    say("Der Waechter des Dschungels grinst Muaddib frech an!\n");
    /*
       shout(BSA(
       "Los Muaddib! Testen! Lass die wolkigen Gefuehle!",
       "Der Waechter des Dschungels bruellt: "));
     */
    return;
  }

  else if (getuid(this_player())=="vader")
  {
    say("Der Waechter grinst boese und sagt dann zu Vader:\n"
        "Hi, Vader, bitte leg Brezel noch mal um!\n");
    return;
  }
  else
  {
    write("Der Waechter des Dschungels nickt freundlich und sagt:\n"
        "Freut mich, dass Du wieder einmal vorbeischaust, "+TPN+"!\n");
    return;

  }
}

void heart_beat() {
  object *all;
  int i;
  string names;
  ::heart_beat();
  waiting_check();
  TO->SetProp(P_HB,1);
  hb_time=time();
  cnt++;
  if(cnt==30) {
    names=ctime()[11..18]+": ";
    all=users();
    for(i=sizeof(all)-1;i>=0;i--) {
      if(!is_clone(all[i])) {
        names+=getuid(all[i])+" ";
      }
    }
    cnt=0;
  }
}



void waiting_check() {
  object dante, kolmey;
  string zeit;


  object *pl;
  int i;
  dante=find_player("dante");
  kolmey=find_player("kolmey");
  zeit=dtime(time());

  pl=users();

  if(objectp(dante) && !waiting_for["dante"]) {
    if(!dante->QueryProp(P_INVIS)) {
      if(zeit[5..11]=="26. Feb" && !helpvar) {

        shout("Der Dschungelwaechter ruft: DANTE!!!\n");
        shout(BSA("Alles Boese moege mit Euch sein, oh Herr der "
              "Zombies! Gratuliere zu eurem Wiegenfeste!",
              "Der Dschungelwaechter ruft: "));

        shout("Die Zombies bruellen: Meister, wir toeten fuer Dich!\n");

        helpvar=1;    
      }
      else 
      {

        if(!sizeof(pl)) { return; }

        for(i=0;i<sizeof(pl);i++)  {

          if(!IS_WIZARD(pl[i]) && pl[i]->QP(P_IGNORE) )  {	
            if( member_array("dschungelwaechter+alle", pl[i]->QP(P_IGNORE))==-1 &&
                member_array("dschungelwaechter.alle", pl[i]->QP(P_IGNORE))==-1 &&
                member_array("dschungelwaechter+dante", pl[i]->QP(P_IGNORE))==-1 &&
                member_array("dschungelwaechter.dante", pl[i]->QP(P_IGNORE))==-1) {
                  tell_object(pl[i],
                      "Die Untoten bruellen schaurig: Willkommen Meister Dante!\n"); 
                } } } 
      }
      waiting_for["dante"]=1;
    }
  }


  if(objectp(kolmey) && !waiting_for["kolmey"]) {
    if(!kolmey->QueryProp(P_INVIS)) {

      if(!sizeof(pl)) { return; }
      for(i=0;i<sizeof(pl);i++)  {

        if(!IS_WIZARD(pl[i]) && pl[i]->QP(P_IGNORE) )  {	
          if(member_array("dschungelwaechter+alle", pl[i]->QP(P_IGNORE))==-1 &&
             member_array("dschungelwaechter.alle", pl[i]->QP(P_IGNORE))==-1 &&
             member_array("dschungelwaechter.kolmey", pl[i]->QP(P_IGNORE))==-1 &&
             member_array("dschungelwaechter+kolmey", pl[i]->QP(P_IGNORE))==-1) {
                tell_object(pl[i],
                    "Die Waldelfen jubeln: Kolmey ist wieder da!\n");
              } } } 

      waiting_for["kolmey"]=1;
    }
  }

  if((!objectp(dante)||dante->QueryProp(P_INVIS)) && 
      waiting_for["dante"]) 
  {
    if(!sizeof(pl)) { return; }

    for(i=0;i<sizeof(pl);i++)  {

      if(!IS_WIZARD(pl[i]) && pl[i]->QP(P_IGNORE) )  {	
            if( member_array("dschungelwaechter+alle", pl[i]->QP(P_IGNORE))==-1 &&
                member_array("dschungelwaechter.alle", pl[i]->QP(P_IGNORE))==-1 &&
                member_array("dschungelwaechter+dante", pl[i]->QP(P_IGNORE))==-1 &&
                member_array("dschungelwaechter.dante", pl[i]->QP(P_IGNORE))==-1) {
            tell_object(pl[i],
                "Die Kraft des Boesen schwindet leicht. Dante ist verschwunden!\n"); 
          } } } 
    waiting_for["dante"]=0;
  }

  if((!objectp(kolmey)||kolmey->QueryProp(P_INVIS)) && 
      waiting_for["kolmey"]) 
  {
    if(!sizeof(pl)) { return; }

    for(i=0;i<sizeof(pl);i++)  {

      if(!IS_WIZARD(pl[i]) && pl[i]->QP(P_IGNORE) )  {	
        if(member_array("dschungelwaechter+alle", pl[i]->QP(P_IGNORE))==-1 &&
            member_array("dschungelwaechter.alle", pl[i]->QP(P_IGNORE))==-1 &&
            member_array("dschungelwaechter.kolmey", pl[i]->QP(P_IGNORE))==-1 &&
            member_array("dschungelwaechter+kolmey", pl[i]->QP(P_IGNORE))==-1) {
          tell_object(pl[i],
              "Die Waldelfen schluchzen: Auf Wiedersehen, Kolmey!\n"); 
        } 
      }  
    }
    waiting_for["kolmey"]=0;
  }
  return;
}
