// 97 dante@SilberLand
//waechter am anfang des dschungels
//laesst gewisse spieler nicht vorbei; selbst schuld:)))
//quest npc:
//hat infos fuer reporter-quest
//infos fuer fippsiquest 99 dante
//wer x runden gegen ihn in einer bestimmten zeit uebersteht bekommt 
//den rucksack
//neu dante 99 08 19!!!


/*
   Der Waechter ist hungrig und will ein einfaches Essen haben
   Man braucht ne Pfanne, Eier, Kaese von ner Maus, Schinken, ne Feuerstelle und Salz
   usw...

   hat nun mehr infos juni 99 dante!!!!!!!
   fuer quests usw!!!!!!!

*/







inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "/players/dante/myowndefine.h"
#include <wizlevels.h>
#include <npcmaster.h>

#define QUESTNAME "Der hungrige Dschungelwaechter"
#define PRIVATE "/d/dschungel/dante/private_obj/"
void waiting_check();
nosave int hb_time;
nosave int cnt=0;
nosave int helpvar=0; 


nosave mapping waiting_for=([ "kolmey":0,  "dante":0]);
int startzeit, stopzeit;
int zeit;
string sp;

int runden=30;
int kampf=0;

void init()
{
  ::init();
  if(interactive(TP)) call_out("hallo",0);
} 

void check_tisch()  {
  object neuertisch, kapelle, da, am;

  call_other("d/ebene/Midas/room/kapelle", "???");
  kapelle=find_object("d/ebene/Midas/room/kapelle");



  if(kapelle && !present("klappschreibtisch", kapelle)) {

    neuertisch=clone_object("/players/dante/btisch");
    neuertisch->move("/d/ebene/Midas/room/kapelle", M_NOCHECK);

    if(da=find_player("dante"))  {
      tell_object(da,
          "Tisch wurde aus dem Waechter erzeugt!\n"); }

    if(am=find_player("amnenion"))  {
      tell_object(am,
          "Tisch wurde aus dem Waechter erzeugt!\n"); }                     

  }
}     


reset()  {
  ::reset();
  call_other("/d/dschungel/dante/fisch/room/sand2", "???");
  call_other("/d/dschungel/dante/tante/tantenraum", "???");

  call_other("/d/dschungel/trintrasil/sdschungel/room/turm", "???");
  call_other("/d/dschungel/trintrasil/sdschungel/room/sdschungel2", "???");
  call_other("/d/dschungel/trintrasil/sdschungel/room/bruecke2", "???");
  call_other("/d/dschungel/trintrasil/sdschungel/room/busch-h", "???");

  //check_tisch();
} 

void create()
{


  if (!is_clone(TO)) return;
  ::create();
  SetProp(P_SHORT, "Der Waechter des Dschungels");
  SetProp(P_LONG, 
      "Dieser gigantische Waechter sorgt fuer Ruhe und Ordnung in Dantes "
      "Reich.\nNaja, eigentlich kann er viel mehr.\n"
      "1.  Bei ihm beginnt die 'Der hungrige Dschungelwaechter'- Quest. Logo?!\n"
      "2.  Er weiss sehr viel ueber die 'Fippsi' - Quest.\n"
      "3.  Er weiss i. A. ueberhaupt Einiges ueber den Dschungel.\n"
      "4.  Er kann Dir eine Impfung gegen Malaria geben!!!\n"
      "5.  Er kann Dich in Minis Kneipe befoerdern !\n"
      "6.  Er weiss viel ueber die Reporter und Pu Litza!\n"
      "7.  Er kann Spieler persoenlich begruessen! Wenn Du einen persoenlichen\n"
      "    Gruss haben willst, so wende Dich an Dante.\n"
      "8.  Frag den Waechter nach Mutprobe!!!\n"
      "9.  Persoenliche Gegenstaende kann man sich ab sofort bei Guido abholen.\n"
      "    Haettest Du gerne einen persoenlichen Gegenstand so frage den\n"
      "    Waechter nach Buero!!!\n"
      "10. Sollte der Waechter einmal Dein ganzes Inventar irgendwie erhalten\n"
      "    haben, so frag ihn nach Inventar!\n");


  call_other("/d/dschungel/dante/fisch/room/sand2", "???");
  call_other("/d/dschungel/dante/tante/tantenraum", "???");
  //check_tisch();


  set_heart_beat(1);
  if(find_player("dante")) waiting_for["dante"]=1;
  if(find_player("kolmey")) waiting_for["kolmey"]=1;



  AI("guido",
      "Der wohnt in Tijara, im Osten! Geh ruhig hin!",
      "sagt: ");

  AI("buero",
      "Das Buero fuer persoenliche Gegenstaende ist im Osten von Tijara, im neuen Teil! "
      "Geh dorthin und stelle einen Antrag!",
      "sagt: ");

  SetProp(P_NAME, "Waechter");
  SetProp(P_GENDER, MALE);
  AddId(({ "waechter"}));

  create_default_npc(99);
  SetProp(P_XP, 0);
  SetProp(P_NO_SCORE, 1); // gibt keine Erstkiller
  SetProp(P_HANDS, ({" mit der Kraft des Dschungels",1000,DT_BLUDGEON}));
  SetProp(P_RACE, "Dantinischer Elitesolitaerwaechter");
  SetProp(P_SIZE, 5000);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,20);

  SetProp(P_MSGIN, "marschiert herein");
  SetProp(P_MSGOUT, "marschiert");
  SetProp(P_MMSGIN, "marschiert herein");
  SetProp(P_MMSGOUT, "marschiert weit weg");

  SetProp(P_DIE_MSG,  " bricht in Plichterfuellung nieder.\n");
  SetProp(P_NOCORPSE, 0 );

  SP(P_KILL_NAME, "Der Dschungelwaechter");

  seteuid(getuid(TO));

  SetProp(P_MSG_FLAGS, ([P_KILL_MSG:0, P_MURDER_MSG:0 ]));
  SetProp(P_NOCORPSE, 1 );
  SetProp(P_KILL_MSG, "Ich bin unbezwingbar! Dante hat mich so erschaffen!");




  AI(({"mut","mutprobe","probe"}),
      "Solltest Du wahrlich mutig und stark sein, so besteht die "
      "Moeglichkeit eines Kampfes mit mir! Wenn Du "+runden+" Runden in einer "
      "bestimmten Zeit gegen mich durchhaeltst ohne zu sterben oder ohne "
      "aufzugeben, bekommst Du als Belohnung Dantes Rucksack! Du "
      "musst einfach <mutprobe> tippen! Aber ueberleg Dir das besser "
      "noch einmal, denn ich werde keine Gnade walten lassen!!! "
      "Achja, merk Dir das gut. Wenn Du aufgeben willst, tippe "
      "einfach <aufgabe>! Aber Achtung! Ich schlage sehr hart zu"
      " und Du kannst dabei sterben!",
      "sagt: ");

  AI("aufgabe",
      "Tippe einfach <aufgabe>, wenn Du meinst, die Mutprobe ist noch "
      "zu brutal fuer Dich!", "sagt: ");

  AI(({"rucksack","sack"}),
      "Der Rucksack ist wahrlich genial! Nur wenige haben ihn!", "sagt: ");



  AddInfo(({"raetsel","loesung"}),
      "AH! Ja, das Raetsel mit der magischen Barriere beim Skelettdrachen. "
      "Die Barriere ist zusammengebrochen, das weiss ich!", "sagt: ");




  AddInfo("malaria",
      "Willst Du eine Impfung kaufen?", "fragt: ");
  AddInfo("impfung",
      "Wenn Du geimpft werden willst, so tippe <impfung>. Es kostet aber "
      "etwas Geld.", "sagt: ");
  AddInfo( ({"geld", "kaufen"}),
      "Die Impfung kostet "+100*TP->QueryProp(P_LEVEL)+".", "antwortet: ");
  AddInfo("hunger",
      "Ich muss immer hier stehen, da wird man schon hungrig. Essen haett ich gerne.",
      "sagt seufzend: ");
  AddInfo("essen",
      "Hmm am liebsten haette ich ein Omelett aus der Pfanne...",
      "sagt: ");
  AI("statue",
      "Diese Statue soll einem Gnom gehoeren...", "sagt: ");
  AI("gnom",
      "Der Gnom lebt in einer Hoehle bei Tireks.", "sagt: ");


  //infos fuer fippsi

  AddInfo(({"maus","dschungelmaus"}),
      "Ach, Du meinst sicher Fippsi! Achtung! Es gibt aber eine zweite Maus, die hat "
      "aber mit Fippsi nichts zu tun. Eher mit meinem Omelette und Kaese. "
      "Diese Maus, die den Kaese hat, ist angeblich auf den Plantagen"
      " im Westen zu finden!" , "sagt: ");



  AddInfo("fippsi",
      "Fippsi ist eine kleine nette Dschungelmaus, die aber glaubt ein "
      "Drache zu sein. Sie leidet unter starken Wahnvorstellungen, behaupte ich, "
      "sie aber will mich nur fressen. Identifizier sie unbedingt!!!", "grinst: ");
  AddInfo(({"wahnvorstellungen","wahnvorstellung","wahn"}),
      "Fippsi koennte geheilt werden, aber sie ist so uneinsichtig. Irgendwo, "
      "ganz in ihrer Naehe waechst ein Kraut, das ihr helfen kann. Zumindest "
      "wuerde es sie einsichtiger machen und dann koennte man ihr vielleicht "
      "beweisen, dass sie kein Drache ist.", "sagt: ");
  AddInfo(({"kraut","daemonenkraut"}),
      "Das Daemonenkraut koennte Fippsi heilen. Sie isst es sogar sehr gerne, denn "
      "sie glaubt in ihrem Wahn, das es gebratene Daemonen seien. Suchs, und frag "
      "Fippsi einfach danach!", "sagt: ");
  AddInfo("drache",
      "Fippsi glaubt, ein Drache zu sein. So ein Unsinn. Frag sie mal nach ihren "
      "Wahnvorstellungen!?!", "sagt: ");



  // omelettinfos!!!!!!!!!!!



  AddInfo(({"omelette", "omelett"}),
      "Tja, man benoetig dazu eine Pfanne, Eier, Kaese, Schinken, Salz, Pfeffer und Brot. "
      "Und irgendwo braten muss man es auch koennen. Wenn Du alles hast, "
      "kommst Du wieder und tippst einfach <mahlzeit>. Wenn Du meinen "
      "Hunger stillen willst, dann tippe <hunger>.", "sagt: ");



  AddInfo("pfeffer", 
      "Hmm, der waechst auf Stauden...", "sagt: ");
  AddDetail(({"staude","stauden"}),
      "Hmm, Du musst noch einiges Richtung Sueden gehen, dann kommst "
      "Du an eine Stelle, wo der Pfad steil nach unten abfaellt und wo "
      "der Wasserfall schon sehr laut ist. Dort such einmal...", "sagt: ");
  AddInfo("wasserfall",
      "Weit im Sueden!", "sagt: ");
  AddInfo("pfad",
      "Der beginnt hier!", "sagt: ");



  AddInfo("pfanne",
      "Tja, die hab ich irgendwo im Dschungel verloren, am ehesten "
      "auf den Plantagen oder in ihrer Naehe. Ich glaube dort, "
      "wo der Pfad zwischen den Plantagen durchlaeuft..." , "sagt: ");



  AddInfo("kaese",
      "Kaese, hmm, wer isst gerne Kaese...", "sagt: ");
  //Infos dafuer bei maus dabei!!!




  AI("brot",
      "Hmm, weiss ich nicht mehr, aber ich denke da gibts nen Brotfruchtbaum...", "sagt: ");

  AI(({"brotfruchtbaum","brotbaum"}),
      "Hmm, wo wachsen hier fast alle Fruechte!? Auf den Plantagen!!! "
      "Und die Brotfrucht waechst im Osten!", "sagt: ");
  AI(({"frucht","fruechte"}),
      "Die wachsen fast alle auf den Plantagen!", "sagt: ");
  AI(({"plantagen", "plantage"}),
      "Naja, die sind direkt im Sueden!", "sagt: ");




  AddInfo("schinken",
      "Hmm, ein Schwein schlachten...", "sagt: ");
  AddInfo("schwein",
      "Angeblich laeuft hier irgendwo eines rum! Eine Tropensau!", "sagt: ");
  AI(({"sau","tropensau"}),
      "Die Tropensau will ich essen! Schlachte sie und hol Dir den "
      "Schinken! Sie laeuft irgendwo am Pfad herum!!!", "sagt: ");


  AddInfo("salz",
      "Der Bettler weiss mehr darueber!!! Frag ihn danach!!!", "sagt: ");
  AI("bettler",
      "Der hat etwas, was Dir wichtig sein koennte! Frag ihn danach!!!", "sagt: ");




  AI("kochen",
      "Tja, irgendwo ist auch ne alte Feuerstelle. ", "sagt: ");
  AddInfo("feuerstelle",
      "Hmm, nicht weit von hier, aber Du wirst Holz und was zum anzuenden brauchen.",
      "sagt: ");
  AI("holz",
      "Tja, das gibts da wo Baeume sind, denke ich??!?", "sagt: ");
  AI("latz",
      "Du meinst den legendaeren Sabberlatz!", "grinst: ");
  AI("sabberlatz",
      "Hmm, der kann Dir gute Dienste leisten! Solltest Du diese Quest schon " 
      "gemacht haben, aber Deinen Sabberlatz verloren, so kannst Du ihn wiedererlangen, "
      "indem Du einfach in diesen Kaefig da steigst! Aber Achtung, in dem Kaefig, "
      "haust ein boeser Sabbergnom!",
      "sagt grinsend: ");
  AI(({"sabbergnom","gnom"}),
      "Den Sabbergnom hab ich in den Kaefig gesperrt. Er hat einen Sabberlatz. "
      "Leg den Gnom um, und Du hast einen neuen Sabberlatz.", "sagt: ");
  AI("kaefig",
      "In dem Kaefig wohnt ein Sabbergnom. Naja, der wohnt nicht freiwillig da, "
      "ich hab ihn im Auftrag Dantes dort eingesperrt.", "sagt: ");
  AI("sabbern",
      "Eklig, Du Schwein!", "sagt lachend: ");
  AI(({"baeume","baum"}),
      "Die sind in der Wueste!", "lacht: ");

  AI("kochen",
      "Nein, das Omelett sollst Du braten!", "sagt streng: ");
  AI("braten",
      "Das Omelett soll gebraten werden, nicht gekocht. Feuer ist dazu notwendig!",
      "sagt: ");
  AI("feuer",
      "Naja, irgendwo auf den westlichen Plantagen ist ne Feuerstelle."
      " Dort gibts auch Brennholz!", "sagt: ");
  AI("brennholz",
      "Das brauchst Du fuer das Omelett bzw. fuers Feuer!!"
      "Ahja, der Feuerstein, hmm...", "sagt: ");
  AI("feuerstein",
      "Den Feuerstein findest Du an dem Ort wo der grosse Felsklotz steht und "
      "es nach unten in diese verdammten Hoehlen geht!!! Also im Sueden irgendwo!",
      "sagt: ");

  AI(({"spiegel","spiegel der wahrheit"}),
      "Tja, den Spiegel der Wahrheit gibt es wirklich. Er ist irgendwo in der "
      "Naehe von Fippsi. Aber Fippsi wird, ohne dass Du ihm das Daemonenkraut "
      "gegeben hast, kaum wollen, dass Du ihm die Wahrheit zeigst!", "sagt: ");
  AI("wahrheit",
      "Hmm, ja ich kenn sie, ich kenne alle, sag sie Dir aber nicht!", "lacht: ");

  AddInfo("lamyra",
      "Die nennt mich respektlos Knabe!", "sagt erbost: ");
  AddInfo("knabe",
      "Nein! Nein! Bin ich nicht!", "sagt: ");

  AddInfo(DEFAULT_INFO,({
        "sagt: Ich bewache den Dschungel!\n",
        "sagt: Frag Dante!\n",
        "lacht zynisch!\n",
        "sagt: Na! Wie waers mit einer Mutprobe!\n",
        "sagt: Bring mir ein Omelett!\n",
        "sagt: Hier herrscht Ruhe und Ordnung!\n"}));

  AI(({"ei","eier"}),
      "Hmm, da gibt es einen Vogel, dessen Eier ich will!", "sagt: ");
  AI("vogel",
      "flattert aufgeregt mit den Fluegeln! STOP!!!\n"
      "Der Waechter flattert nicht sondern zuckt nur mit den Schultern!\n"
      "Der Waechter sagt: Du musst einen Paradiesvogel suchen!\n");
  AI("paradiesvogel",
      "Der Paradiesvogel lebt auf einem Baum sehr weit im Suedosten von hier!!!",
      "sagt: ");

  //infos fuer pu
  AI(({"pu","litza","pu litza"}),
      "Pu Litza ist der Chef der Dschungelpost.", "sagt: ");
  AI(({"post","dschungelpost"}),
      "Die Dschungelpost ist die hiesige Zeitung. Ist zwar noch nie "
      "erschienen, aber angeblich suchen sie immer wieder neue "
      "Reporter. Die alten kommen ihnen irgendwie abhanden...", "sagt: ");
  AI("reporter",
      "Die Zentrale der Dschungelpostreporter ist irgendwo in den Baeumen.",
      "sagt: ");
  AI("zentrale",
      "Hmm ich weiss nicht genau, wo sie liegt, aber irgendwo hoch oben...",
      "sagt: ");
  AI(({"elefant","weisser elefant"}),
      "Der beruehmte weisse Elefant! Den gibts doch gar nicht, oder...",
      "lacht: ");
  AI(({"razzi", "baba", "razzi baba", "baba razzi"}),
      "Der rasende Reporter Razzi. Hmm, der treibt sich immer irgendwo "
      "herum, kann ueberall sein. Frag ihn einfach danach!", "sagt: ");
  AI("trompentenpilz",
      "Die wachsen da, wo alle anderen Pilze wachsen!", "sagt: ");
  AI(({"pilz","pilze"}),
      "Na na,nur nicht uebermuetig werden!", "lacht: ");
  AI("zeitung",
      "Du meinst die Dschungelpost...", "sagt: ");

  AddInfo("dante", "Dante hat mich erschaffen.","sagt: ");

  AddInfo(({"kneipe","haus","mini","schneckenhaus","tausendfuessler"}),
      "Wenn Du dorthin willst dann tipp < tausendfuessler > und ich bringe "
      "Dich sofort dorthin! Der Tausendfuessler wandert naemlich im ganzen "
      "Dschungel herum.", "sagt: ");
  AI(({"fee", "farbfeen","farbfee"}),
      "Die Farbfeen lieben Bonbons, sind aber schlau und schnell.", "sagt: ");

  AI(({"tireks"}),
      "Tireks ist ein boeses Monster, das irgendwo bei den Steingiganten "
      "haust. Er ist eingesperrt und unsichtbar, kann aber erweckt werden. "
      "Es gibt neuerdings einige Dinge die man im Kampf gegen ihn verwenden kann!!! "
      "Schau Dir mal das Tor sehr genau an, das zu Tireks fuehrt!!!",
      "sagt: ");

  AI("tor",
      "Anschauen, nicht bloed fragen!", "lacht: ");
  AI("dinge",
      "Es gibt da eine Stange, eine Axt, einen Haken, ein Amulett und "
      "eine Figur!", "sagt: ");
  AI(({"figur","axt","amulett","stange","haken"}),
      "Hmm, sie sind alle irgendwo in den Hoehlen versteckt. Such sie! "
      "Aber sei vorsichtig!", "sagt: ");
  AI(({"steingigant","steingiganten"}),
      "Die Steingiganten sind gutmuetige, aber sehr starke Kreaturen, die "
      "weiter suedlich in einer Hoehle leben!", "sagt: ");
  AI("hoehle",
      "Ach, es gibt hier soviele...", "grinst: ");

  set_living_name("dschungelwaechter");

  AddCmd("impfung", "imp");

  AddCmd(({"tausendfuessler"}), "letsgo");
  AddCmd("hunger", "start_q");
  AddCmd("mahlzeit", "end_quest");
  AddCmd("mutprobe", "start_sack");
  AddCmd("aufgabe","stop_sack");


  //ACD("herdamit", "get_private_obj");

  AI("inventar", 
      "Du kannst alles haben, was ich habe, aber nur wenn Du mir eine Brezel bringst! "
      "Ich esse die so gerne, aber der verdammte Jojogeist will mir keine geben! "
      "Wenn Du eine hast komm her und gib sie mir!", 
      "sagt: ");

  AI(({"jojogeist","geist"}),
      "Der hat Brezel!", "sagt: ");
  AI("brezel",
      "Bring mir eine und Du kannst alles haben, was ich habe!",
      "sagt: ");

}


void give_notify(object ob)  {

  int i;
  object *inv;

  if(ob->id("brezel"))  {

    ob->remove();
    inv=all_inventory(TO);
    if(!sizeof(inv))   {

      write(BSA(
            "AH!!! Danke "+TPN+"! Das freut mich aber! HMMMMM! Lecker! "
            "Leider habe ich nichts fuer Dich!",
            "Der Waechter sagt freundlich: "));
      write(BS(
            "Dann isst der Waechter die Brezel sofort laut schmatzend auf!"));
      return ;
    }

    if(sizeof(inv))  {

      write(BSA(
            "AH!!! Danke "+TPN+"! Das freut mich aber! HMMMMM! Lecker! "
            "Du kannst alles haben, was ich habe!",
            "Der Waechter sagt freundlich: "));

      write(BS(
            "Dann isst der Waechter die Brezel sofort laut schmatzend auf!"));
      write("\n");

      for( i=0;i<sizeof(inv); i++)
      { 
        //     if (inv[i]->id("brezel"))  { inv[i]->remove();  }

        tell_room( environment( this_object()),
            "Der Waechter wirft "+inv[i]->name(WEN)+" weg!\n");
        inv[i]->move(environment(TP), M_NOCHECK+M_TPORT); }

        return ;        
    }
  }

  write(BSA(
        "Naja! Brezel hab ich lieber als "+ob->name(WEN)+"!",
        "Der Waechter grummelt: "));

  ::give_notify(ob);
}

