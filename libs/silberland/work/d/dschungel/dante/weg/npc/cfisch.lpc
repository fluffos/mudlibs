// knuddelfisch

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein bunter Clownfisch");
  SetProp(P_LONG, BS(
    "Der Clownfisch schillert in bunten Farben und laechelt Dich schelmisch an. "
    "Er ist ein freundlicher Geselle und immer zu Spaessen bereit."));
  SetProp(P_NAME, "Clownfisch");
  SetProp(P_GENDER, MALE);
  AddId(({"fisch", "clownfisch"}));

  create_default_npc(10);
  SetProp(P_HANDS, ({" mit seinen bunten Flossen", 100+random(10),({DT_WATER,DT_BLUDGEON} )}));
  SetProp(P_RACE, "fisch");
  SetProp(P_SIZE, 80);
  SetProp(P_ALIGN, 200);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 10);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_RESISTANCE, ({ DT_WATER })); 
  SetProp(P_VULNERABILITY, ({ DT_FIRE }));
  SetProp(P_NOMAGIC, 5);

  SetProp(P_MSGIN, "schwimmt grinsend herein");
  SetProp(P_MSGOUT, "schwimmt grinsend");
  SetProp(P_MMSGIN, "schwimmt grinsend herein");
  SetProp(P_MMSGOUT, "schwimmt weit weg");

  SetProp(P_DIE_MSG,  " wird niemehr seine Spaesse treiben.\n");
  SetProp(P_NOCORPSE, 0 );

  AddInfo(DEFAULT_INFO, "zeigt Dir die lange Nase.\n");
  AddInfo("dante", "Dante ist ja selbst ein Clown.","sagt: ");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Clownfisch sagt: Akrobat schoen!\n" }) );

  SetProp(P_SPELLRATE,50);
  
  AddSpell(5,200,
    "Der Clownfisch greift Dich mit einem Scherz an.\n",
    "Der Clownfisch greift @WEN mit einem Scherz an.\n",
     DT_MAGIC,([SP_SHOW_DAMAGE:1]));
 AddSpell(5,200,
    "Der Clownfisch macht einen schlechten Witz ueber Dich.\n",
    "Der Clownfisch macht einen schlechten Witz ueber Dich.\n",
     DT_TERROR,([SP_SHOW_DAMAGE:1]));
      AddSpell(1,600,
    "Der Clownfisch versucht Dich in ein Kaninchen zu verwandeln.\n",
    "Der Clownfisch versucht @WEN in ein Kaninchen zu verwandeln.\n",
     DT_MAGIC,([SP_SHOW_DAMAGE:1]));
      AddSpell(1,600,
    "Der Clownfisch spritzt Dir Scherztinte ins Gesicht.\n",
    "Der Clownfisch spritzt @WEM Scherztinte ins Gesicht\n",
     DT_ACID,([SP_SHOW_DAMAGE:1]));
  SetChats(3, ({
  "Der Clownfisch lacht ueber Dich.\n",
  "Der Clownfisch grinst.\n",
  "Der Clownfisch sagt: Akrobat schoen!\n",
  "Der Clownfisch macht ein misslungenes Kunststueck.\n",
  "Der Clownfisch ruft: Applaus!!!\n",
  "Der Clownfisch schwimmt um Dich herum.\n",
  "Der Clownfisch schwimmt nach unten.\n",
  "Der Clownfisch kitzelt Dich.\n",
  "Der Clownfisch macht einen Wassersalto.\n",
  "Der Clownfisch fragt: Kennst Du Gargaud ?\n",
  "Der Clownfisch schwimmt nach oben.\n",
  "Der Clownfisch macht BLUBB...\n",
  "Du lachst ueber den Clownfisch.\n"}) );
  SetAttackChats(10, ({
  "Der Clownfisch versucht zu fliehen.\n",
  "Der Clownfisch taucht unter.\n",
  "Der Clownfisch will nicht sterben.\n",
  "Der Clownfisch schreit: Lass mich doch...\n",
  "Der Clownfisch sagt: Ich erzaehle Dir auch einen Witz....\n"}) );

}
