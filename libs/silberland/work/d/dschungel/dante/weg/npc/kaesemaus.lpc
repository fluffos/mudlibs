//kaesemaus
inherit "std/mnpc";     

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "files.h"
#include <mnpc.h>


create()
{
  if (!is_clone(ME)) return;
  ::create();
  SetProp (P_SHORT, "Eine kleine Maus");
  SetProp (P_LONG, bs("Die kleine graue Maus blickt Dich mit ihren noch "+
    "kleineren schwarzen Knopfaugen misstrauisch an.\n"));
  SetProp (P_NAME, "Maus");
  SetProp (P_GENDER, FEMALE);
  SetProp(P_RACE, "Nagetier");
  AddId ( ({"maus", "\nkaesemaus"}));
  create_default_npc (5);
  SetProp (P_SIZE, 12);
  SetProp (P_HEAL, 8);
   SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10, T_RANGE_MAX: 45]));   

  SetProp (P_MSGIN, "trappselt herein");
  SetProp(P_MMSGIN, "springt aus der Spalte heraus");   
 SetProp(P_INFO, "Diese Maus hat einen Kaese, auch wenn Du den nicht sehen "
 "kannst.\n");
 SetProp(P_WIMPY, 20+random(10));       
 SetProp(P_MMSGIN,"trapselt herein");
 SetProp(P_MMSGOUT, "trapselt weit weg");
 SetProp(P_MNPC_AREA, "d/dschungel/dante/weg/room/" );
 SetProp(P_MNPC_WAIT, ({ 5, 10, 10 }));
 SetProp(P_MNPC_DEFAULTROOM, ROOM "brunnen1");
 SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES );


  SetProp (P_HANDS, ({" mit ihren kleinen Pfoten", 50}));
  SetProp (P_ALIGN, 20);
  SetProp(P_DIE_MSG, " faellt mausetot um.\n");

//SUID;
//CLONEME("d/dschungel/dante/weg/obj/kaese");

}

Defend(int dam, string dtype, int spell, object enemy)
 {
  if ((!present("ESSEN", enemy))||(deep_present("KAESE", enemy)) )
   {
    write("Die Maus weicht Dir geschickt aus!\n"
    "Dann beisst sie Dir in den Fuss!\n");
    enemy->do_damage(10);
     enemy->StopHuntFor(ME);
                     StopHuntFor(enemy);
                     }
       else
          return::Defend(dam, dtype,spell, enemy);
          
              }              
     die(arg)
     {
     object ob;
     if(present("ESSEN", TP)) {
     write(BS("Die sterbende Maus verliert ein Stueck Kaese, das direkt "
     "in Deine Arme faellt.")); 
     ob=clone_object("/d/dschungel/dante/weg/obj/kaese");
     ob->move(TP, M_NOCHECK);
     call_other("d/dschungel/dante/weg/room/brunnen1", "create_new_mouse");
         }
     ::die(arg);
     }
      
