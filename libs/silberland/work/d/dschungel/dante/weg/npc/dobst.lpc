// ein braver obstpfluecker

inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include "files.h"
#include <mnpc.h>
create()
{
  object cash;
   
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Plantagenarbeiter");
  SetProp(P_LONG, BS(
    "Dieser Plantagenarbeiter pflegt die Baeume, Straeucher und Stauden der"
    " Obstfelder von Tijara.\n"));
  SetProp(P_NAME, "Plantagenarbeiter");
  SetProp(P_GENDER, MALE);
  AddId(({"arbeiter", "plantagenarbeiter"}));

  create_default_npc(12+random(2));
  SetProp(P_HANDS, ({" mit seinen kraeftigen Faeusten ", 160+random(10),DT_BLUDGEON}));
  SetProp(P_MAX_HP, 250+random(50));
  SetProp(P_MAX_SP, 1000);
  SetProp(P_BODY, 70+random(10));
  SetProp(P_RACE, "mensch");
  SetProp(P_SIZE, 200);
  SetProp(P_ALIGN, 100);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,5);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 50+random(20));
  SetProp(P_NOMAGIC,5);

  SetProp(P_MSGIN, "kommt laut schreiend angerannt");
  SetProp(P_MSGOUT, "laeuft wuetend");
  SetProp(P_MMSGIN, "kommt laut schreiend angerannt");
  SetProp(P_MMSGOUT, "laeuft laut bruellend davon");
   SetProp(P_MNPC_AREA, ROOM "planta" );
  SetProp(P_MNPC_WAIT, ({ 5, 15, 10 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "planta5");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES );

  SetProp(P_DIE_MSG,  " bricht in Erfuellung seiner Pflicht nieder.\n");
  SetProp(P_NOCORPSE, 0 );

  AddInfo(DEFAULT_INFO, "schreit: Verschwinde von hier!!!\n");
  AddInfo("dante", "Dante hat mich erschaffen.","sagt: ");

  SetProp( P_REJECT, ({ REJECT_KEEP,
    "Der Arbeiter schreit: Ich bin unbestechlich! :)\n" }) );

  SetProp(P_SPELLRATE,50);
  AddSpell(4,200,
    "Der Plantagenarbeiter schlaegt Dir den Schaedel ein.\n",
    "Der Plantagenarbeiter schlaegt @WEM den Schadel ein .\n",
     DT_BLUDGEON ,([SP_SHOW_DAMAGE:1]));
  
  AddSpell(3,300,
  "Der Plantagenarbeiter attackiert Dich mit seiner Arbeitsmoral.\n",
  "Der Plantagenarbeiter attackiert @WEN mit seiner Arbeitsmoral.\n",
  DT_MAGIC, ([SP_SHOW_DAMAGE:1]));
  
  SetChats(3, ({
  "Der Plantagenarbeiter jaehtet Unkraut.\n",
  "Der Plantagenarbeiter begutachtet die Ernte.\n",
  "Der Plantagenarbeiter pflueckt eine Frucht.\n"}) );
  
  SetAttackChats(15, ({
  "Der Plantagenarbeiter versucht Dich aus der Plantage zu werfen.\n",
  "Der Plantagenarbeiter wuergt Dich.\n",
  "Der Plantagenarbeiter schreit: Hier ist ein Dieb!!!\n",
  "Der Plantagenarbeiter schreit laut um Hilfe!\n",
  "Der Plantagenarbeiter verteidigt sein Obst!\n",
  "Der Plantagenarbeiter ruft: Das Obst gehoert uns!\n",
  "Der Plantagenarbeiter bruellt Dich an: Verschwinde von hier!\n",
  "Der Plantagenarbeiter schreit: Los holt die Gardisten!\n"}) );

  SUID;
  cash=CLONEOB("/obj/money");
  cash->SetProp(P_AMOUNT, random(200));
  cash->move(ME);
  CLONEME(WEAPON"demesser");
  command("zuecke messer");
  CLONEME(OBJ "dj");
}

