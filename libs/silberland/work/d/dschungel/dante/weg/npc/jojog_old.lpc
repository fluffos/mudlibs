spell_eat(int dam, string dtype, int spell, object enemy)    
{
  
  tell_room(environment(TO),
	    "Der Jojogeist sagt: Moment, ich muss mal was essen gehen!\n");
  
  if(file_name(environment(TO))==("/d/ebene/Midas/room/kneipe_saal") )
    {
      tell_room(environment(TO),
		"Der Jojogeist bestellt sich ein Kinderschnitzel.\n"
		"Der Jojogeist bestellt sich ein Putenschnitzel!\n");     
      TO->heal_self(50);
    }
  if(file_name(environment(TO))!=("/d/ebene/Midas/room/kneipe_saal") )   
    {
      
      tell_room("/d/ebene/Midas/room/kneipe_saal",
		"Ein Jojogeist kommt hereingelaufen!\n"
		"Der Jojogeist bestellt ein Kinderschnitzel.\n"
		"Der Jojogeist bestellt ein Putenschnitzel.\n"
		"Dann bruellt er MAHLZEIT und haut gesaettigt wieder ab!\n");
      tell_room(environment(TO),
		"Der Jojogeist laeuft schnell zu Max.\n"
		"Der Jojogeist laeuft nun wieder satt herein!\n");     
      TO->heal_self(50);
      tell_room(environment(TO),
		"Der Jojogeist ruelpst laut und sagt: MAHLZEIT!!!\n");
    }
}

/*
  Modifikationen von PROtheG:
  statt "nimm alles" nun "nimm ruestungen" und "nimm waffen"
  Lichtobjekte werden nun auch hin und wieder zerstoert!
*/

init()
{
  object ob, obaxt, lob;

  ::init();

    
  if(present("bumerang", environment(TO)))
    {
      command_me("fange bumerang");
      write("Der Jojogeist schnappt sich Deinen Bumerang\n");
    }
  
  if(interactive(TP))
    {
      if(obaxt=deep_present("axt", TP))
	{
	  switch(random(100))
	    {
	    case 0 .. 1:
	      write("Der Jojogeist sagt: "+CAP_TPN+", Deine Axt ist nett!\n"
		    "Daraufhin nimmt er Dir sie einfach weg!\n");
	      obaxt->move(TO, M_NOCHECK+M_TPORT);
	      break;
	    case 2..99:
	      break;
	    default: write("BLOEDSINN!\n");
	    }
	}
   }
    
    
     
  if(ob=present("elementar", environment(TO)))
    {
      switch(random(100))
	{
	case 0 .. 1:
	  tell_room(environment(TO),
		    "Der Jojogeist bruellt auf und saugt das Elementar einfach in sich auf!\n");
	  ob->remove();
	  break;
	case 2 .. 99:
	  break;
	default:write("HIHI!\n");
	}
    }
  
  if(interactive(TP))
    {
    if(lob=present("PRIVATE_LICHT", TP))
    
    {
      switch(random(100))
	      {
	      case 0 .. 1 :
	        tell_room(environment(TO),
		          "Der Jojogeist bruellt: Jaaa, ein Lichtdingsbums!\n"+
		          "Daraufhin nimmt er es Dir weg.\n");
	        break;
	      case 2 .. 99:
	      break;
	      default:write("HIHI!\n");
	      }
    }

}
call_out("get_all", 0);



}

get_all()  {

object *inv;
int i;

inv=all_inventory(environment(TO));

if(!sizeof(inv))  { 
	return;
	}


 for (i=sizeof(inv)-1;i>=0;i--)    {
      
      	
 if(! (
                      inv[i]->QP(P_NEVERDROP) ||inv[i]->QP(P_CURSED)||
	  inv[i]->QP(P_NODROP)   ||
	  inv[i]->QP(P_NOGET)    ||inv[i]->QP(P_INVIS) ||
                      interactive(inv[i]) || query_once_interactive(inv[i])||
                      living(inv[i]) ) )
        {

       	inv[i]->move(TO, M_NOCHECK);
   
      	tell_room(environment(TO),
      	"Der Jojogeist schnappt sich "+inv[i]->name(WEN)+"!\n");
    }
}


}



void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  TP->StopHuntFor(ME);
  StopHuntFor(TP);
NAL1
}     

NAL2

void registerOwner(string owner)
{ 
  myOwner=owner;
}

int go(string str)
{
  object mon;
  string monster, ich;
  
  notify_fail("Was soll der Jojogeist machen?\n");
  if(!str)
    {
      TP->do_damage(10);
      write("Der Jojogeist schlaegt Dir aufs Mauls und sagt frech:\n"
	    "Mach das ja nicht nochmal mit mir Du Sack!\n");
      return 1;
    }
  
  if(this_player()->name() != myOwner)
    {
      write("Der Jojogeist sagt: DU hast mir nichts zu sagen!\n");
      write("Der Jojogeist sagt: Ich bin der Jojogeist von "+capitalize(myOwner)+"!\n");
      TP->do_damage(10);
      return 1;
    }
  
  if(sscanf(str,"%s verfolg %s",ich,monster )!=2 &&
     sscanf(str,"%s verfolge %s",ich,monster)!=2) return 0;   
   
    
      
  if(sscanf(str,"%s verfolge %s",ich,monster)!=-1)  
    {
      if(!mon=find_player(monster))
        {
	  write("Der Jojogeist teilt Dir mit:  "+capitalize(monster)+
		" ist nicht anwesend. Leider!\n");
	  return 1;
	}
       
      if(mon->name()==TPN)
	{
          write("Der Jojogeist sagt: Du Trottel, willst dass ich Dich verfolge!\n");
          write("Der Jojogeist spuckt Dir mitten ins Auge.\n");
          TP->do_damage(10);
          return 1;
	}
      
      if(IS_WIZARD(mon))
	{
          write("Der Jojogeist lacht Dich aus und sagt grinsend: \n"
		"Diese Frechheit muss ich leider hart bestrafen!\n");
          call_out("geld",0);
          return 1;
	}
      
      if(mon->QueryProp(P_INVIS)||IS_LEARNER(mon)||
	 mon->QueryProp( P_TESTPLAYER))
	{
	  write("Der Jojogeist weigert sich und zieht Dich am Ohr.\n");
	  TP->do_damage(5);
	  return 1;
	}
      else
	{
	  SetProp(P_MMSGOUT, "eilt nervend zu "+capitalize(getuid(mon))+""); 
	  this_object()->move( environment(mon), M_TPORT );   
	  tell_object( mon, "Der Jojogeist sagt: Hallo "+mon->name()+"! "+
		       TP->name()+" hat mich geschickt, damit ich Dich quaelen kann.\n");
	  mon->AddPursuer(this_object());
       
	  SetProp(P_MSGOUT, "nervt "+capitalize(getuid(mon))+" hinterher" ); 
	  return 1;
	}
      return 0;
    }                                                                         
}

void geld()
{
  int menge;

  /*
    int menge, menge_self;
    object x;
    object y;
  
    if(x=deep_present("geld", TP))
    {
    menge=x->QueryProp(P_AMOUNT);   
    y= deep_present("geld",TO);
    menge_self=y->QueryProp(P_AMOUNT);
    y->SetProp(P_AMOUNT, menge_self+menge);
    x->remove();
  */
  if(menge=TP->QueryMoney() && menge>=100)
    {
      TP->AddMoney(-menge);
      write("Der Jojogeist klaut Dir all Dein Geld.\n");
    }
  else
    {
      write("Der Jojogeist tritt Dir voll ins Gesicht.\n");
      TP->do_damage(15);
    }
}
        
int brezel(string str)
{
  object ob;

  notify_fail("Was willst Du vom Jojogeist kaufen?\n");
  if(!str) return 0;
  
  if(TP->QueryMoney() < 100)
    return notify_fail("Ein Brezel kostet 100 Muenzen und soviel hast Du nicht bei Dir.\n"),0;
  
  if((member(({"brezel","brezel von geist","brezel von jojogeist"}), str)!=-1)&&
     (TP->QueryMoney() > 99 ))
    if(brez)
      {
	ob=clone_object("/d/dschungel/dante/weg/obj/brezel.lpc");
	ob->move(TP, M_NOCHECK);
	TP->AddMoney(-100);
	write("Du kaufst ein Brezel vom Jojogeist.\n");
	brez--; 
	return 1;
      }
    else
      {
        write("Der Jojogeist sagt: Pech gehabt! Ausverkauft!\n");
        return 1;
      }
  return 0;
}

peace(string str)
{
  notify_fail("Wen willst Du hier befrieden?\n");
  if(!str) return 0;
  
  if(str=="jojogeist" || str=="jojo" || str=="geist")
    {
      write("Du befriedest den Jojogeist. Er aergert sich, muss aber gehorchen.\n"+
	    "Trotzdem schlaegt er Dir nochmal mitten auf die Nase.\n"+
	    "Der Jojogeist sagt: Beim naechcten Mal haue ich haerter zu.\n");
      dam++;
      TP->StopHuntFor(ME);
      StopHuntFor(TP);
      SetProp(P_KILL_NAME, "Oftmaliges Aergern eines Jojogeistes");  
      TP->do_damage(dam*5);        //hehe spass
      TP->restore_spell_points(dam*-5);//damits nicht zu oft geht
      return 1;
    }
  return 0;
}

die(arg)
{
  object ob; 
  write("Der Geist ist endlich weg, und Du bekommst dafuer ein Jojo.\n");
  ob=clone_object("/d/dschungel/dante/weg/obj/jojo");
  ob->move(TP, M_NOCHECK);
  ::die(arg);    
}

weg()
{
  object ob1;
  object ob2;
  
  tell_room(environment(TO),
	    "Der Jojogeist haut Dir nocheinmal aufs Maul und verschwindet dann.\n"
	    "Du seufzt erleichtert und bist froh, diesen Quaelgeist los zu sein.\n");
  
  if(ob1=present("brezel", TO))
    {
      ob1->remove();
    }
  while (ob2=present("muenzen", TO))
    {
      ob2->remove();
    }
  
  TO->move("d/dschungel/dante/weg/room/jojobaum",M_TPORT+ M_SILENT+M_NO_SHOW);
  //das is damit alle dinge die er so klaut in diesem raum liegen!!!
  call_out("remove", 0);    
}

void adjust_damage(object enemy, int damage, mixed dam_type) 
{
  damage=enemy->QueryProp(P_LEVEL)*8;//20 war extrem brutal dante
  enemy->Defend(damage, dam_type, ([SP_NAME:"jojoattack", SP_SHOW_DAMAGE:1]));
  return;
}

void spell_unfug(object enemy, int damage, mixed dam_type)
{
  object fake;
  int i;
  int groesse; 
  object *inv;

  inv=all_inventory(enemy);
  groesse=sizeof(inv);  
  
  if(!sizeof(inv))
      tell_object(enemy, "Der Jojogeist lacht Dich armen Schlucker aus!\n");
   
  if(groesse)   
    {
      i=random(groesse);
      tell_object(enemy,
		  "Der Jojogeist versucht Deine Sachen gegen Schrott auszutauschen!!!\n");
 
      if(inv[i]->QP(P_NEVERDROP)||inv[i]->QP(P_CURSED)||
	 inv[i]->QP(P_NODROP)   ||inv[i]->QP(P_AUTOLOADOBJ)||
	 inv[i]->QP(P_INVIS)   || inv[i]->QP(P_NOGET) )
	{       
	  tell_object(enemy,
		      "Der Jojogeist bruellt: Verdammt! Dante hat mir verboten sowas zu klauen!\n");
	  return ;
	}
      
      else
	{
	  tell_object(enemy,
		      "Der Jojogeist klaut Dir etwas!\n");
	  inv[i]->move(TO, M_NOCHECK, M_TPORT);
	  
	  // inv[random(sizeof(inv))]->move(TO, M_NOCHECK+M_TPORT);
 
	  command_me("zieh alles an");
	  switch(random(10))
	    {
	    case 0:
	      fake=clone_object("/d/dschungel/dante/weg/obj/dpilz");
	      fake->move(enemy, M_NOCHECK+M_TPORT);
	      break;
	    case 1:
	      fake=clone_object("/d/dschungel/dante/weg/obj/dmanda");
	      fake->move(enemy, M_NOCHECK+M_TPORT);
	      break;
	    case 2:
	      fake=clone_object("/d/dschungel/dante/weg/obj/dbana");
	      fake->move(enemy, M_NOCHECK+M_TPORT);
	      break;
	    case 3:
	      fake=clone_object("/d/dschungel/dante/weg/obj/pizza");
	      fake->move(enemy, M_NOCHECK+M_TPORT);
	      break;
	    case 4:
	      fake=clone_object("/d/dschungel/dante/stein/obj/bug");
	      fake->move(enemy, M_NOCHECK+M_TPORT);
	      break;
	    case 5:
	      fake=clone_object("/d/dschungel/dante/stein/obj/typo");
	      fake->move(enemy, M_NOCHECK+M_TPORT);
	      break;
	    case 6:
	      fake=clone_object("/d/dschungel/dante/stein/obj/rzg");
	      fake->move(enemy, M_NOCHECK+M_TPORT);
	      break;
	    case 7:
	      fake=clone_object("/d/dschungel/feyaria/tijara/obj/fisch4");
	      fake->move(enemy, M_NOCHECK+M_TPORT);//tja das is PECH!!!!
	      break;
	    case 8:
	      fake=clone_object("/d/dschungel/feyaria/tijara/obj/fisch6");
	      fake->move(enemy, M_NOCHECK+M_TPORT);
	      break;
	    case 9:
	      fake=clone_object("/d/dschungel/feyaria/tijara/obj/fisch5");
	      fake->move(enemy, M_NOCHECK+M_TPORT);//tja das is PECH!!!!
	      break;
	    default: write("HIHI!\n");
	    }
	}
    }
}

