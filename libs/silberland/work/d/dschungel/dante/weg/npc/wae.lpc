// 97 dante@SilberLand

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"



void init()
{
  ::init();
  if(interactive(TP)) call_out("hallo",0);
} 

object cash;

void create()
{

  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein kraeftiger Waechter");
  SetProp(P_LONG, BS(
        "Dieser kraeftige Waechter sorgt fuer Ruhe und Ordnung in dem "
        "von Menschen, Zwergen und anderen Teilen der Hoehle. Er ist freundlich, "
        "aber bestimmt."));    
  SetProp(P_NAME, "Waechter");
  SetProp(P_GENDER, MALE);
  AddId(({ "waechter", "wache"}));

  create_default_npc(12);
  // P_LEVEL   = x
  // P_SP/P_HP = x*8+42       =
  // P_HANDS   = x*10         = 
  // P_BODY    = x*20/3       =  
  // P_XP      = HP*HANDS*5   =   // 1/100 davon als Killbonus
  SetProp(P_HANDS, ({" mit seinen starken Armen",130+random(20),DT_BLUDGEON}));
  SetProp(P_MAX_HP, 200+random(50));
  SetProp(P_BODY, 50+random(10));
  // SetProp(P_XP, QueryProp(P_XP)+y*100); // Bonus fuer Spells
  SetProp(P_RACE, "waechter");
  SetProp(P_SIZE, 180);
  SetProp(P_ALIGN, 100);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,5);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,3);

  SetProp(P_MSGIN, "marschiert herein");
  SetProp(P_MSGOUT, "marschiert");
  SetProp(P_MMSGIN, "marschiert zornig herein");
  SetProp(P_MMSGOUT, "marschiert weit weg");

  SetProp(P_DIE_MSG,  " bricht in Plichterfuellung nieder.\n");
  SetProp(P_NOCORPSE, 0 );

  AddInfo(DEFAULT_INFO, "sagt: Hier herrscht Ruhe und Ordnung!\n");
  AddInfo("dante", "Dante hat mich erschaffen.\n","sagt: ");
  AddInfo("mini",
      "sagt: Stirb! Moerder!\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
        "Der Waechter sagt: Nein, auch so bekommst Du keine Gnade von mir!\n" }) );

  SetProp(P_SPELLRATE,50);

  AddSpell(3,300,
      "Der Waechter schlaegt Dir in den Bauch.\n",
      "Der Waechter schlaegt @WEM in den Bauch.\n",
      DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));
  AddSpell(3,300,
      "Der Waechter sticht Dir in Dein Bein.\n",
      "Der Waechter sticht @WEM in sein Bein.\n",
      DT_PIERCE,([SP_SHOW_DAMAGE:1]));
  AddSpell(3,300,
      "Der Waechter schlitzt fast Deinen Arm auf.\n",
      "Der Waechter schlitzt fast @WESSEN Arm auf.\n",
      DT_RIP,([SP_SHOW_DAMAGE:1]));

  SetChats(3, ({
        "Der Waechter warnt Dich eindringlichst.\n",
        "Der Waechter schaut Dich pruefend an.\n",
        "Der Waechter stoeht ueber seine Arbeit.\n",
        "Der Waechter fragt Dich: Kennst Du den Gouverneur ?\n",
        "Der Waechter baut sich vor Dir auf.\n",
        "Der Waechter sagt: Diese Steingiganten sind ziemlich laestig.\n",
        "Der Waechter sagt: Du, was willst Du hier?!\n"}) );
  SetAttackChats(10, ({
        "Der Waechter bedraengt Dich hart.\n",
        "Der Waechter schreit: Verschwinde schnell!\n",
        "Du stolperst fast...\n",
        "Der waechter sagt: Moerder!!!\n",
        "Der Waechter sagt: Rache fuer Mini!!!\n",
        "Der Waechter ist staerker als Du dachtest...\n",
        "Der Waechter flucht laut.\n"}) );

  SUID;

  cash=CLONEOB("/obj/money");
  cash->SetProp(P_AMOUNT, random(500));
  cash->move(ME);

  CLONEME( "/p/weapon/sword/saebel" );
  command("zuecke saebel");
  CLONEME("/p/armour/boots/kampfstiefel");      
  CLONEME ( "/p/armour/armour/bronzepanzer");
  command("trage alles");  
}

void hallo()
{
  command("emote bruellt: "+TPN+", wer hat Mini getoetet!?!\n");
}
