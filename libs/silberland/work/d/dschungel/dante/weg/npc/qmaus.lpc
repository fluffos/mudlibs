//maus fuer miniquest
// Id "NOCONTROL" eingefuegt -> Missbrauch von Fippsi moeglich
// Eros: 11.09.2021


inherit "std/mnpc";     

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "/players/dante/myowndefine.h"
#include <mnpc.h>
#define QUESTKEY "Fippsi, die verwirrte Maus"

int runde=0;

init()  {
  ::init();
  if(interactive(TP)) call_out("tag", 0);
}

tag() {

  if(TP->QueryQuest(QUESTKEY)) {
    write("Fippsi bruellt: He, "+TPN+", ich bin noch immer ein Drache!\n");
    return ; 
  }

  if((present("\nfippsiobj", TP)) || (present("\nfippsigegeben", TP)) ) {
    write("Fippsi bruellt: "+TPN+", na was is nun, bin ich ein Drache?!?!\n");
    return ; 
  }


  else {
    command("emote bruellt: WAHHHH!!! Ich bin ein Drache! Erzittere vor mir!\n");
    return ;
  }   
}



create()
{
  if (!is_clone(ME)) return;
  ::create();
  SetProp (P_SHORT, "Fippsi, die kleine, gruene Dschungelmaus");
  SetProp (P_LONG, BS(
        "Das ist Fippsi, die kleine, gruene Dschungelmaus. Die Farbe Gruen "
        "mag fuer eine Maus ungewoehnlich sein, doch Fippsi lebt schon sehr lange "
        "im Dschungel und hat sich ihrer Umgebung perfekt angepasst. Sie versucht "
        "Dich blutruenstig anzustarren, doch sieht das bei einer so kleinen Maus "
        "eher lustig als bedrohlich aus. Angeblich leidet Fippsi unter Wahnvorstellungen. "
        "Sie glaubt ein grosser, gefaehrlicher Drache zu sein. Frag sie einfach danach, "
        "wenn Du ihr helfen willst."));

  SetProp (P_NAME, "Fippsi");
  SP(P_ARTICLE, 0);

  SetProp (P_GENDER, FEMALE);
  SetProp(P_RACE, "Nagetier");
  AddId (({"fippsi", "maus", "dschungelmaus", "NOCONTROL"}));
  create_default_npc (6);
  SetProp (P_SIZE, 25);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10, T_RANGE_MAX: 45]));   
  SetProp( P_REJECT, ({ REJECT_KEEP,
        "Fippsi sagt: Ja, huldige dem Drachen Fippsi!\n"}));

  SetProp (P_MSGIN, "springt fippsend herein");
  SetProp(P_MMSGIN, "springt fippsend aus dem Dschungel hervor");   
  SetProp(P_WIMPY, 0);       
  SetProp(P_MMSGOUT,"spring fippsend");
  SetProp(P_MMSGOUT, "trapselt weit weg");
  SetProp(P_MNPC_AREA, "d/dschungel/dante/weg/room/fip" );
  SetProp(P_MNPC_WAIT, ({ 10, 10, 10 }));
  SetProp(P_MNPC_DEFAULTROOM,  "d/dschungel/dante/weg/room/fip1" );  
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES );


  AI("hilfsmittel",
      "Du meinst einen Ast, oder?", "sagt: ");
  AI("ast",
      "Hmm, ja einen zangenfoermigen Ast, gibts in der Naehe angeblich. "
      "Ich denke beim Schlamm oder so...", "sagt: ");
  AI("schlamm",
      "Naja, der Schlamm hier im Dschungel.", "grinst: ");
  AI("maus",
      "Ich bin keine Maus! Ich bin ein Drache!", "bruellt: ");
  AI("dschungelmaus",
      "Ich bin ein boeser, grosser Drache und fresse Maeuse!", "bruellt: ");
  AI("dschungel",
      "Ich hause im Dschungel und fresse gerne die Daemonen auf!", "tobt: ");
  AI(({"daemon","daemone"}),
      "Die schmecken so gut!", "bruellt: ");
  AI("drache",
      "Ich bin ein grosser Drache, man nennt mich den Herrscher des Dschungel. "
      "Alle Tiere fuerchten mich, weil ich so schrecklich bin. Und ich habe sicher "
      "keine Wahnvorstellungen!!!", "bruellt: ");
  AI("fippsi",
      "Das bin ich, Fippsi, ein schrecklicher Drache!", "bruellt: ");
  AI(({"erde","stelle"}),
      "Hmm, kann man graben dort. Ist sicher was versteckt oder so....", "sagt: ");

  AI(({"tiere","tier"}),
      "Die Tiere des Dschungels verspeise ich alle mit einem Biss!", "bruellt: ");

  AI(({"wahn","wahnvorstellungen","wahnvorstellung"}),
      "WAHHH!!! Soll ich Dich etwa zerfetzen, Du Wurm! "
      "Ich habe keine Wahnvorstellungen, "
      "ich bin ein grosser, boeser Drache! Naja, der Waechter des Dschungels "
      "hat mal "
      "behauptet, dass ich unter Wahnvorstellungen leide. Doch der irrt sich sicher! "
      "Wenn Du mich aber vom Gegenteil ueberzeugen willst, dann tipp einfach "
      "<hilffippsi>.",
      "sagt: ");



  SP(P_INFO, BS("Fippsi glaubt ein Drache zu sein, doch das kann ja kaum stimmen! "
        "Angeblich kann man sie aber von ihren Wahnvorstellungen irgendwie heilen. "
        "Irgendwer hat da mal behauptet, das man Fippsi zuerst etwas Pflanzliches "
        "geben muss, damit sie einsichtiger wird und ihr dann einen Spiegel vorhalten "
        "soll..., aber ob das stimmt...?"
        " Solltest Du diese Quest bereits haben, Deinen Spiegel aber nicht mehr, so "
        "tippe einfach <neuerspiegel>, und Du bekommst einen Neuen."));



  AI(({"spiegel","spiegel der wahrheit"}),
      "Ja, angeblich soll es einen Spiegel geben, der mir mein wahres "
      "Gesicht zeigt. Aber ich bezweifle, dass es den gibt. Der Waechter des "
      "Dschungels weiss angeblich mehr darueber, aber der redet viel, wenn der "
      "Tag lange ist. Solltest Du aber jemals diesen Spiegel finden, so komm "
      "zu mir und tipp einfach <fippsispiegel>. Allerdings, so einfach wird "
      "das sicher nicht gehen! Wenn Du die Quest bereits hast und einen "
      "neuen Spiegel willst, tipp einfach <neuerspiegel>!",
      "bruellt: ");

  AI(({"waechter","dschungelwaechter"}),
      "Ach, der hat keine Ahnung, den fress ich auf!", "tobt: ");
  AI(({"daemonenkraut","kraut"}),
      "Ja, das fresse ich gerne! Wenn Du eines hast, "
      "komm wieder zu mir und tipp einfach <fippsikraut>.", "bruellt: ");

  AI("syntax",
      "Die Syntax um diese Aufgabe zu beginnen: hilffipsi\n"
      "Die restlichen Syntaxen: fippsikraut, fippsispiegel, neuerspiegel\n",
      "Fippsi sagt: ");


  SetProp (P_HANDS, ({" mit ihren kleinen Pfoten", 50}));
  SetProp (P_ALIGN, 500);
  SetProp(P_DIE_MSG, " faellt mausetot um.\n");
  SetProp(P_AGGRESSIVE,0);    


  AI(DEFAULT_INFO, ({
        "bruellt Dich an!\n",
        "tobt wie ein irrer Drache!\n",
        "bruellt: Ich bin ein Drache!\n",
        "sagt: Frag den Waechter!\n",
        "sagt: HE DU! Identifizier mich!!!\n",
        "sagt: Hmm, der Waechter weiss alles!\n",
        "fragt: Hast Du Angst vor mir?\n",
        "bruellt: Wir Drachen sind unschlagbar!\n"}));


  SC(5,({
        "Fippsi bruellt wie ein Drache!\n",
        "Fippsi versucht Feuer zu speien!\n",
        "Fippsi sagt: Wer identifiziert gewinnt!!!\n",
        "Fippsi sagt: Ich bin der staerkste aller Drachen!\n",
        "Fippsi sagt: Mist, wo sind meine Drachenschuppen!\n",
        "Fippsi tobt wild umher.\n"}));


  AddCmd("hilffippsi", "start");
  AddCmd("fippsikraut", "kraut");
  AddCmd("fippsispiegel", "ende");
  AddCmd("neuerspiegel", "get_or_not");

}


int get_or_not()  {
  object ob;
  if
    ((TP->QueryQuest(QUESTKEY)) &&(!deep_present("spiegel der wahrheit",TP)))
    {
      write(BSA(
            "Ah, "+TPN+", Dein Spiegel ist ja abhanden gekommen. Wie das?! "
            "Egal hier hast Du einen neuen! Viel Spass damit. Moege er Dir "
            "etwas ueber Dich sagen.", "Fippsi bruellt: "));
      ob=clone_object("/d/dschungel/dante/weg/obj/qspiegel");
      ob->move(TP, M_NOCHECK);
      return 1; 
    }
  else  {
    write(BSA(
          "Hmm, ja das waere schoen fuer Dich, klar. Aber wir Drachen moegen "
          "zwar haesslich sein, aber dumm sind wir sicher nicht! Hau ab!",
          "Fippsi bruellt aergerlich: "));
    return 1; 
  }
  return 0; 
}




int ende()  {
  object ob1, ob2, ob3, ob4;

  if(TP->QueryQuest(QUESTKEY))  {
    write("Aber "+TPN+", Du hast Doch diese Quest bereits gemacht!\n");
    return 1;
  }
  ob1=present("\nfippsigegeben", TP);
  ob2=present("\nfippsiobj", TP);
  ob3=deep_present("\nfippsispiegel", TP);
  if(!ob1) {
    write(BSA(
          "Nein, so geht das nicht!",     
          "Fippsi bruellt: "));
    return 1; 
  }
  if(!ob2) {
    write(BSA(
          "Hmm, "+TPN+", leider, so geht das nicht.",
          "Fippsi bruellt: "));
    return 1; 
  }
  if(!ob3) {
    write(BSA(
          "Hmm, sehr interessant "+TPN+", aber wo bitte ist den Dein "
          "bloeder Spiegel!", "Fippsi tobt: "));
    return 1; 
  }

  else {
    write(BSA(
          "AHHHHHH!!!!!!! Was sehe ich denn da in Deinem Spiegel der Wahrheit! "
          "Schrecklich, ich bin ja gar kein Drache, sondern eine kleine, "
          "gruene Dschungelmaus! NEIN!!! Das kann doch nicht sein! Ich fasse "
          "es nicht. LUEGNER!!!", "Fippsi fiepst: "));
    write(BS(
          "Fippsi ueberlegt kurz, grinst und bruellt wieder wie ein Drache! "
          "Hmm, ganz ueberzeugt scheinst Du sie ja nicht zu haben! "
          "Dann blitzt Dein alter, dreckiger Spiegel hell auf!!!"));

    TP->GiveQuest(QUESTKEY);
    write_file("/log/quests/fippsi", 
        dtime(time())+": "+capitalize(getuid(TP))+" hat die Quest beendet.\n");
    ob1->remove();
    ob2->remove();
    ob3->remove();
    ob4=clone_object("d/dschungel/dante/weg/obj/qspiegel");
    ob4->move(TP, M_NOCHECK);
    return 1;  
  }
  return 0;  
}





int kraut() {

  object ob, gegeben;
  ob=deep_present("\nfippsikraut", TP);
  if(!present("\nfippsiobj", TP)) {
    write(BSA(
          "Nein, so geht das nicht "+TPN+"!\n","Fippsi bruellt: ")); return 1; }


  if(present("\nfippsigegeben", TP)) {

    write(BSA(
          "Aber "+TPN+", Du hast mir doch ein Daemonenkraut bereits gegeben! ",
          "Fippsi bruellt: "));


    if(ob)  {

      write(BSA(
            "Das war nett, aber das hier fresse ich trotzdem auf!",
            "Fippsi bruellt: "));
      ob->remove();
    }

    return 1;
  }



  if(!ob) {
    write(BSA( 
          "Aber "+TPN+" was soll der Unfug! Du hast gar kein Daemonenkraut! "
          "Wenn Du eines hast, komm wieder und tipp nochmal <fippsikraut>",
          "Fippsi bruellt: ")); return 1; }

  else {
    write(BSA(
          "AHH!!! Danke "+TPN+", das Du mir ein Daemonenkraut gebracht hast! "
          "Dafuer verschone ich Dich auch, Du winziger Wurm! "
          "Ich glaube, ich bin nun etwas einsichtiger und erkenne mich selbst etwas "
          "besser. Ich bin bereit fuer den Spiegel der Wahrheit!",
          "Fippsi bruellt: "));  
    write(BS("Dann reisst Dir Fippsi das Daemonenkraut aus der Hand und frisst "
          "es laut schmatzend sofort auf!"));
    ob->remove();
    gegeben=clone_object("d/dschungel/dante/weg/obj/fippsigegeben");
    gegeben->move(TP, M_NOCHECK);
    return 1;
  } 
}





int start()
{
  object q;
  if(TP->QueryQuest(QUESTKEY)) {
    write(BSA(
          "Aber "+TPN+", Du hast mich doch schon einmal ueberzeugen wollen, "
          "und das hat auch nicht geholfen, oder!?", "Fippsi bruellt: "));
    return 1; 
  }

  if(deep_present("\nfippsiobj", TP)) {
    write(BSA(
          CAP_TPN+", was soll das? Du willst mir ja bereits beweisen, dass ich "
          "kein Drache bin, Du Bloedel!", "Fippsi bruellt: ")); return 1; 
  }

  else  {


    //write_file(....blabla
    q=clone_object("d/dschungel/dante/weg/obj/fippsiobj");
    q->move(TP, M_GET);
    write(BSA(
          "Okay, wenn Du unbedingt willst, dann beweise mir, dass Ich "
          "kein Drache bin. Aber, wenn Du das nicht schaffst, fresse ich "
          "Dich auf!", "Fippsi bruellt: ")); return 1; 
  } 
}




Defend(int dam, string dtype, int spell, object enemy)
{ 

  if(runde==0) {
    tell_object(enemy,
        "Fippsi, die Dschungelmaus bruellt: "+enemy->name()+", lass das lieber!\n\n"
        "Dann rast eine Feuerwolke von irgendwo her auf Dich zu!!!\n"
        "Die Feuerwolke verbrennt Dich fast!\n");
    enemy->do_damage(100);
    enemy->StopHuntFor(ME);
    StopHuntFor(enemy); runde++; 
    return;
  }

  else  {
    tell_object(enemy,
        "Fippsi sagt: "+enemy->name()+", Du wolltest ja nicht hoeren! Nun fuehle!\n");
    enemy->move("/d/dschungel/dante/weg/room/tuempel1", M_TPORT+M_NO_SHOW,
        "von einem Orkan weggeschleudert", "wird",
        "wird hereingewirbelt");
    runde=0;
    enemy->StopHuntFor(ME);
    StopHuntFor(enemy);
    return 0;  
  }
}              


die(arg)
{
  heal_self(100);
  write("Fippsi grinst Dich an und sagt: Nein, ich sterbe nicht!\n");
  return ;
}

