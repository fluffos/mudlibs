//frosch by dante 97 -99 

inherit "std/npc";
inherit "std/npc/sequencer";
#include <properties.h>
#include <language.h>
#include <moving.h>
#include <combat.h>
#include "/players/dante/myowndefine.h"
#include <wizlevels.h>


create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein magischer Frosch");
  SetProp(P_LONG, BS(
  "Das ist ein magischer Frosch. Er sitzt hier still und leise, doch ist "
  "er in der Lage unsichtbare Magier zu erkennen."));
   
SP(P_NAME_ADJ, "magisch");
SP(P_MAGIC, 1);
SP(P_CURSED, 1);

  SetProp(P_NAME, "Frosch");
  SetProp(P_GENDER, MALE);
  AddId ("frosch");
  create_default_npc (10);
  SP(P_NOATTACK, "sagt: Nana, ich sterbe sicher nicht!");
  
  SetProp(P_HANDS, ({" mit seiner langen Zunge", 40, DT_WHIP}));
  SetProp(P_RACE, "Frosch");
  SetProp(P_SIZE, 16);
  SetProp(P_ALIGN, 100);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_MSGIN, "huepft herein");
  SetProp(P_MSGOUT, "huepft weiter");
  SetProp(P_MMSGIN, "springt herein");
  SetProp(P_MMSGOUT, "springt weit fort");
  AddInfo(DEFAULT_INFO, ("quakt nur leise.\n"));

  AddInfo("dante",
          "quakt: Ich kann viel besser quaken als er...\n"); 
  SetProp(P_REJECT, ({ REJECT_DROP, 
     "Der Frosch springt quakend ueber @WEN hinweg.\n"}));
SP(P_TEMPERATURE_RANGE, ([T_RANGE_MIN: 0, T_RANGE_MAX:100]));
  
  
}


init() {
  ::init();

  if(interactive(TP))  {
   call_out("hallo", 1);  }

 if( !interactive(TP))  
     {
//  call_out("weg", 1);
  
     }
   }
  
  /*
  weg()  {
  if(environment(TO)==environment(TP))  {
  
  say(BS(
   "Der magische Frosch verschluckt "+TP->name(WEN)+" einfach!"));
   TP->move("/players/dante/workroom",M_NOCHECK+M_SILENT);
   TP->remove(); 

    }
  }
  

*/

   

   hallo()  {
     if(environment(TP)!=environment(TO)) return;
     
     
     if (TP->QP(P_INVIS)!=0 )  {
           
      tell_object(TP,
     "Der Frosch quaakt laut!\n");
     
   tell_room(environment(TO),
   "Der Frosch quakt laut: HAALLOO "+CAP(getuid(PL))+"!!!\n\n", ({TP}));
    return ;  }
    
   write(BSA(
   "Hallo "+CAP(getuid(PL))+", willkommen bei der Quelle!",
   "Der Frosch quakt: "));
   
   tell_room(environment(TO),
 "Der Frosch quakt: HALLO, "+CAP(getuid(PL))+"!!!\n", ({TP}));
   
           }
           
           
           die(arg)  {
           return ; }


destruct()  {
 return 0; }

remove()  {
         return 0; }
              