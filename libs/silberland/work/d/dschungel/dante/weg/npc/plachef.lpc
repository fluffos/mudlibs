//chef der obstheinis hat samen! hanf:-) dante

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include "files.h"
#include <npc.h>


init()  {
	::init();
if(interactive(TP))  { call_out("tag", 1);  }

}

tag()  {
 if(environment(TO) != environment(TP))  { return;  }

write("Der Aufseher sagt: Willkommen "+TPN+"! Rauch doch was!\n");

   }		

create()
{
  object cash;
   
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Der Aufseher der Plantagenarbeiter");
  SetProp(P_LONG, BS(
"Der Aufseher sollte eigentlich auf die Arbeiter aufpassen und sie "
"antreiben. Lieber liegt er hier herum und raucht..."));

  SetProp(P_NAME, "Aufseher");
  SetProp(P_GENDER, MALE);
  AddId(({"arbeiter", "aufseher"}));

  create_default_npc(25);
  SetProp(P_HANDS, ({" mit seinen kraeftigen Faeusten ", 160+random(10),DT_BLUDGEON}));
  SetProp(P_BODY, 70+random(10));
  SetProp(P_RACE, "mensch");
  SetProp(P_SIZE, 200);
  SetProp(P_ALIGN, 100);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,5);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);

  SetProp(P_MSGIN, "kommt gemuetlich herein");
  SetProp(P_MSGOUT, "geht gemuetlich");
  SetProp(P_MMSGIN, "kommt laut singend angerannt");
  SetProp(P_MMSGOUT, "laeuft laut singend davon");

  SetProp(P_DIE_MSG,  " bricht in Erfuellung seiner Pflicht nieder.\n");
  SetProp(P_NOCORPSE, 0 );

  AddInfo(DEFAULT_INFO, "schreit: Verschwinde von hier!!!\n");
  AddInfo("dante", "Dante hat mich erschaffen.","sagt: ");

  SetProp( P_REJECT, ({ REJECT_KEEP,
    "Der Aufseher schreit: Ich bin unbestechlich! :)\n" }) );

  SetProp(P_SPELLRATE,50);
  AddSpell(4,300,
    "Der Aufseher schlaegt Dir den Schaedel ein.\n",
    "Der Aufseher schlaegt @WEM den Schadel ein .\n",
     DT_BLUDGEON ,([SP_SHOW_DAMAGE:1]));
  
  AddSpell(3,400,
  "Der Aufseher attackiert Dich mit seiner Arbeitsmoral.\n",
  "Der Aufseher attackiert @WEN mit seiner Arbeitsmoral.\n",
  DT_MAGIC, ([SP_SHOW_DAMAGE:1]));
  
  SetChats(3, ({
  "Der Aufseher jaehtet sicher kein Unkraut.\n",
  "Der Aufseher begutachtet die Ernte.\n",
  "Der Aufseher pflueckt eine Frucht und isst sie.\n"}) );
  
  SetAttackChats(15, ({
  "Der Aufseher versucht Dich aus der Plantage zu werfen.\n",
  "Der Aufseher wuergt Dich.\n",
  "Der Aufseher schreit: Hier ist ein Dieb!!!\n",
  "Der Aufseher schreit laut um Hilfe!\n",
  "Der Aufseher verteidigt sein Obst!\n",
  "Der Aufseher ruft: Das Obst gehoert uns!\n",
  "Der Aufseher bruellt Dich an: Verschwinde von hier!\n",
  "Der Aufseher schreit: Los holt die Gardisten!\n"}) );

  SUID;
  cash=CLONEOB("/obj/money");
  cash->SetProp(P_AMOUNT,100+ random(200));
  cash->move(ME);
  CLONEME(WEAPON"demesser");
  command("zuecke messer");
  CLONEME(OBJ "dj");
  CLONEME("/d/dschungel/dante/tijaraneu/obj/hsamen");

AddInfo(({"samen","hanfsamen", "gras", "marihuana", "hanf"}),
"Habe ich, bekommst Du aber nicht!\n", "sagt: ");
}

