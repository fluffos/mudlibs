

inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "/players/dante/myowndefine.h"
#include <mnpc.h>
#include <wizlevels.h>
#include <exploration.h>

int marsh=10;

reset()  {
	::reset();
	marsh=10; }
	
void create()
{
 
  if (!is_clone(TO)) return;
  mnpc::create();

  SetProp(P_SHORT, "Der Marshmallowman");
  SetProp(P_LONG, BS(
"Das ist der Marshmallowman. Oder einer von vielen. Niemands weiss ob es mehrere gibt. "
"Er ist rundlich und knuffig und sieht einfach zum knuddeln aus. Er ist sehr freundlich, "
"kann aber auch kraeftig zuschlagen, wenn man ihn angreift. Also Respekt! "
"Du kannst auch ein Marshmallow von ihm kaufen!"));

  SetProp(P_NAME, "Marshmallowman");
  SetProp(P_GENDER, MALE);
  AddId(({"man","marshmallowman"}));
  
  set_living_name("marshmallowman");//questrelevant daher sln
  SetProp(P_WIMPY, 100);
  
  SetProp(P_INFO, ("Irgendwas stimmt mit dem Marshmallowman nicht...\n"));
  create_default_npc(40);
  SetProp(P_HANDS, ({" mit seinen dicken Armen",350+random(50),({DT_BLUDGEON,DT_UNHOLY}) }));
  SetProp(P_SIZE, 500);
  SetProp(P_ALIGN, 500);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,100);
  SetProp(P_AGGRESSIVE,0);

  SetProp(P_MSGIN, "kommt laechelnd herein");
  SetProp(P_MSGOUT, "stampft grinsend");
  SetProp(P_MMSGIN, "waelzt sich lachend herein");
  SetProp(P_MMSGOUT, "waelzt sich langsam weiter");
  //SetProp(P_MNPC_AREA, ("/"));
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES+MOV_BACKWARDS+MOV_INFIGHT+MOV_INDOORS+MOV_SPECIAL );
  SetProp(P_MNPC_WAIT, ({10, 20, 15}));
  SetProp(P_MNPC_DEFAULTROOM, "/gilden/abenteurer");

  SetProp(P_DIE_MSG,  " faellt grinsend mit einem lauten Rums um.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "%s, bitte iss mich auf!");
 // SetProp(P_KILL_MSG, "Von einem Marshmallowman erschlagen...");
  AddInfo("marshmallowman", "sagt: Der steht vor Dir!\n");
  AddInfo("marshmallow",
  "lacht: Ja, die esse ich gerne!\n");
  AddInfo("tessa",
  "sagt: Wegen ihr gibt es mich hier.\n");
  AddInfo("moppy",
  "sagt: Uihhhhhhhhh!!!\n ");



  
  AddInfo(DEFAULT_INFO, "jammert nur herum...\n");
  AddInfo("dante", "Dante wird bald ein Penner sein..","sagt: ");
  SetProp( P_REJECT, ({ REJECT_KEEP,
    "Der Marshmallowman sagt: Danke!\n" }) );


  SetChats(5, ({
  "Der Marshmallowman sagt: Hast Du ein paar Muenzen fuer mich...\n",
  "Der Marshmallowman kratzt sich...\n",
  "Der Marshmallowman sagt: Gib mir bitte was zu essen...\n",
  "Der Marshmallowman verflucht Suesstoffe.\n",
  "Ein Zuckervogel schwirrt um den Marshmallowman...\n",
  "Der Marshmallowman grinst Dich an.\n",
  "Du musst zuruecklacheln, ob Du willst oder nicht.\n",
  "Der Marshmallowman kichert dumm.\n",
  "Der Marshmallowman meint: Die Leute werde auch immer dicker.\n",
  "Der Marshmallowman bittet Dich um eine Torte.\n",
  "Eine Ameise krabbelt auf dem Marshmallowman herum.\n",
  "Der Marshmallowman schaut Dich mit lustigen Augen an.\n",
  "Der Marshmallowman lacht laut.\n"}) );

SUID;
CLONEME("/d/dschungel/dante/weg/obj/marsh2");


 AddCmd( ({ "kauf", "kaufe" }), "marsh" );
  
}

void init()
{
  ::init();
  if(interactive(TP)) call_out("hallo",0);
}


 
void hallo()
{
  if(environment(TP)!=environment(TO))
    return;
  switch(random(3))
  {
    case 0:
      command("emote laechelt und sagt: Hallo "+ TP->name(RAW) +", wie gehts?\n" );
      break;
    case 1:
      tell_object(TP, "Der Marshmallowman grinst Dich an.\n");
      tell_room(MENV, "Der Marshmallowman grinst "+TP->name(WEN)+" dicklich an.\n", 
        ({TP, TO}));
      break;
    case 2:
      command("emote haelt die Hand auf und sagt: Hallo!!! \n");
      break;
  }
}


void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (find_call_out("react")!= -1) return; 
  
   switch(gruppe) 
     {
         case "fies":
      call_out("react", 0, "sagt: Lass das bitte!",
     "sagt: "+TP->name(WER)+" ist so gemein zu mir!!!");
          break;
     case "aergerlich":
      call_out("react", 0, "sag: Bist du doof, "+TPN+"?",0);
 break;
    case "albern":
   call_out("react", 0, "sagt: HIHI! Du bist lustig!",0);
    break;
   case "neutral":
  call_out("react", 0, "sagt: Sei doch lustig!", "grinst "+TP->name(WEN)+" an.");
   break;
     case "intim":
      call_out("react", 0, "knuddelt Dich feste!", "knuddelt "+TP->name(WEN)+" sehr fest.");
       break;
   case "froh":
  call_out("react", 0, "laechelt Dich froehlich an.",
         "laechelt "+TP->name(WEN)+" doof an.");
        break;
               case "aengstlich":
        call_out("react", 0, "sagt: Keine Angst!",
          "sagt: "+TP->name(WER)+", Du brauchst keine Angst haben!");
           break;


case "traurig":
      call_out("react", 0, "muntert Dich etwas auf!",
      "muntert "+TP->name(WEN)+" etwas auf!");
      break;
    case "frech":
     call_out("react", 0, "kichert lustig und amusiert.", "kichert "+TP->name(WEN)+" an.");
           break;
 
 
   case "nett":
         call_out("react", 0, "umarmt Dich inniglich.", "umarmt "+TP->name(WEN)+" kraeftig.");
               break;
                           
        }     
}




   
   
   void StartReactionAll(string verb, string gruppe, string adverb, int touch)
   {
     return StartReaction(verb, gruppe, adverb, touch);
     }
     
   
   
   
   void react(string victim, string others)
   {
     if (present(TP, ENV(TO))) 
       {
           if( !others ) others = victim;
               tell_object(TP, BS(Name(WER, 1) + " "+victim) );
        tell_room(ENV(TO), BS(Name(WER, 1)+" "+others), ({TP,TO}) );
     }
      }

int marsh(string str)
{
  object ob;

  notify_fail("Was willst Du vom Marshmallowman kaufen?\n");
  if(!str) return 0;
  
  if(TP->QueryMoney() < 10)
    return notify_fail("Ein Marshmallow kostet 10 Muenzen und soviel hast Du nicht bei Dir.\n"),0;
  
  if((member(({"marshmallow","brezel von marshmallowman","marshmallow von marshmallowman"}), str)!=-1)&&
     (TP->QueryMoney() > 9 ))
  {
    if(marsh)
    {
      ob=clone_object("/d/dschungel/dante/weg/obj/marsh2.lpc");
      ob->move(TP, M_NOCHECK);
      TP->AddMoney(-10);
      write("Du kaufst ein Marshmallow vom Marshmallowman.\n");
      marsh--; 
      return 1;
    }
    else
    {
      write("Der Marshmallowman sagt: Tut mir wirklich leid! Ausverkauft!\n");
      return 1;
    }
  }
  return 0;
}
