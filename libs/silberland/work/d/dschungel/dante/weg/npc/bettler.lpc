
// dante februar 97

inherit "std/mnpc";
inherit "std/npc/sequencer";
inherit "/gilden/bardengilde/obj/std_spellprovider";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "files.h"
#include <mnpc.h>
#include <wizlevels.h>
#include <exploration.h>

object cash;
void create()
{
 
  if (!is_clone(TO)) return;
  mnpc::create();

  SetProp(P_SHORT, "Ein Bettler");
  SetProp(P_LONG, BS(
    "Ein in Lumpen gehuellter, magerer Bettler der hier sein karges Dasein fristet "
    "und von milden Gaben vorbeikommender Abenteurer sich kaerglich ernaehrt...\n")); 
  SetProp(P_NAME, "Bettler");
  SetProp(P_GENDER, MALE);
  AddId(({"bettler"}));
  
  set_living_name("bettler");//questrelevant daher sln
  SetProp(P_WIMPY,100);
  
  SetProp(P_INFO, ("Irgendwas stimmt mit dem Bettler nicht...\n"));
  create_default_npc(13);
  SetProp(P_HANDS, ({" mit seinen ausgemergelten Armen",150+random(30),({DT_BLUDGEON,DT_UNHOLY}) }));
  SetProp(P_MAX_HP, 500+random(50));
  SetProp(P_SIZE, 180);
  SetProp(P_ALIGN, 100);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,-5);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_RESISTANCE, ({ DT_TERROR })); 
  SetProp(P_NOMAGIC,3);

  SetProp(P_MSGIN, "humpelt herein");
  SetProp(P_MSGOUT, "humpelt");
  SetProp(P_MMSGIN, "humpelt herein");
  SetProp(P_MMSGOUT, "humpelt schnell weiter");
  SetProp(P_MNPC_AREA, ("/d/dschungel/dante/weg/room/weg"));
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES+MOV_BACKWARDS+MOV_INFIGHT );
  SetProp(P_MNPC_WAIT, ({10, 20, 15}));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "wegp3");

  SetProp(P_DIE_MSG,  " haucht sein schaebiges Leben aus.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "%s, Du mieser Lump!");
 // SetProp(P_KILL_NAME, "Bettler");
 // SetProp(P_KILL_MSG, "Von einem Bettler erschlagen...");
  SetProp(P_LOG_INFO, "dante/dbettler");
  AddInfo("greis", "sagt: Der Irre mit dem Jojowahn...\n");
  AddInfo("jojo",
      "lacht: Ja, die regnen vom Himmel...\n");
  AddInfo("irre",
      "sagt: Der hat mir mal eine Formel erzaehlt...\n");
  AddInfo("formel",
      "sagt: Die Formel ist komm-komm...\n ");
  AddInfo("schlamm",
      "sagt: Hmm, frag mal den Koenig der Steingiganten danach.\n");
  AddInfo("koenig",
      "sagt: Der lebt bei den Steingiganten.\n");
  AddInfo("steingigant",
      "sagt: Die Steingiganten leben in Hoehlen.\n");
  AddInfo("steingiganten",
      "sagt: Die Steingiganten leben in Hoehlen.\n");
  AddInfo("hoehle",
      "sagt: Hoehlen gibts ueberall...\n");
  AddInfo("hoehlen",
      "grinst: Du musst nur eine Hoehle finden.\n");
  AddInfo("salz",
      "Hmm ich hab eine kleine Prise Salz. Kannst Du mir abkaufen!", "sagt: ");

  AddInfo(DEFAULT_INFO, "jammert nur herum...\n");
  AddInfo( ({"dante", "oberkapitalist"}), "Dante wird bald auch ein Penner sein..","sagt: ");
  AddInfo("tijara",
      "sagt: Der Gouverneur kann uns Bettler nicht ausstehen.\n");
  AddInfo("gouverneur",
      "spuckt nur auf den Boden.\n");
  AddInfo( ({"geld", "kohle"}),
      "sagt: Gib mir Deines, Kapitalistenschwein!\n");

  // 01.10.2020 - Gwenshara: Fuer die Bardengilde
  AddInfo( ({"leben"}),
    "Ich sag dir was, frueher war ich wer ganz anderes! Aber der Kapitalismus und "
    "Expansionismus hat mich ruiniert!!!", "schreit: ");

  AddInfo( ({"kapitalismus", "grundhaltung"}),
    "Dante, dieser Oberkapitalist ist der uebelste von allen! Da gehts nur ums Geld "
    "und Wirtschaftswachstum!", "sagt: ");

  AddInfo( ({"wirtschaftswachstum", "wachstum"}),
    "Endloses Wachstum gibt es nicht! Wirtschaftswachstum fuehrt zu Ressourcenknappheit!",
    "proklamiert: ");

  AddInfo( ({"wirtschaft"}),
    "Geht's der Wirtschaft gut, gehts uns allen gut!", "sagt sarkastisch: ");

  AddInfo( ({"expansionismus"}),
    "Wegen der kapitalistischen Grundhaltung meines Heimatlandes wurde hier her "
    "expandiert! Ureinwohner wurden vertrieben um mehr Kohle mit mehr Plantagen zu machen!!!",
    "kreischt: ");

  AddInfo( ({"ressourcenknappheit", "knappheit"}),
    "Je mehr Kohle man hat, desto mehr von dem neuesten magischen Luxusmist will man haben!",
    "sagt: ");

  AddInfo( ({"einwohner", "ureinwohner"}),
    "Eigentlich heisst das ja 'idigene Bevoelkerung'.", "sagt politisch korrekt: ");

  AddInfo( ({"heimatland", "heimatlands", "kontinent"}),
    "Ich komm von einem fremden Kontinent. Mein Vater hat mich hier her gescheucht, "
    "damit ein 'Mann' aus mir wird. Siehst eh wie das geendet hat!", "sagt: ");

  AddInfo( ({"vater", "koenig"}),
    "Mein Vater war ein Koenig. Und ich also ein Prinz oder sowas. Aber mit dem "
    "Kapitalistenmuell will ich nichts mehr zu tun haben.@@inspireIfBard@@", "lamentiert: ");

  AddInfo( ({"prinz", "prinzen"}),
    "Nieder mit dem monarchistischen Kapitalismus!!!!", "schreit: ");

  SetProp( P_REJECT, ({ REJECT_KEEP,
        "Der Bettler sagt: Naja, bischen mehr koennte es schon sein, Du Geizhals...\n" }) );

  SetProp(P_SPELLRATE,90);
  AddSpell(5,300,
      "Der Bettler verflucht Dich zu ewiger Armut.\n",
      "Der Bettler verflucht @WEN zu ewiger Armut.\n",
      DT_MAGIC,([SP_SHOW_DAMAGE:1]));

  SetChats(5, ({
        "Der Bettler sagt: Hast Du ein paar Muenzen fuer mich...\n",
        "Der Bettler kratzt sich...\n",
        "Der Bettler sagt: Gib mir bitte was zu essen...\n",
        "Der Bettler verflucht den Gouverneur.\n",
        "Fliegen schwirren um den Bettler...\n",
        "Der Bettler stinkt furchtbar...\n",
        "Dir wird ganz uebel von dem Gestank.\n",
        "Der Bettler sabbert...\n",
        "Der Bettler meint: Die Leute werde auch immer knausriger.\n",
        "Der Bettler bittet Dich um ein paar Muenzen.\n",
        "Der Bettler stinkt nach billigem Schnaps.\n",
        "Eine Laus krabbelt auf dem Bettler herum.\n",
        "Der Bettler schreit: Du mieser Geizhals!\n",
        "Der Bettler schaut Dich mit entzuendeten Augen an.\n",
        "Der Bettler jammert...\n"}) );

  SetAttackChats(10, ({
        "Der Bettler schreit: Du mieses Schwein...\n",
        "Der Bettler bruellt: Los, hau ab...\n",
        "Der Bettler tritt Dir ins Knie.\n",
        "Der Bettler wuergt Dich.\n",
        "Der Bettler spuckt Dich an.\n"}) );

  AddSpell(1,500,
      "Der Bettler spuckt Eiter auf Dich.\n",
      "Der Bettler spuckt Eiter auf @WEN.\n",
      DT_ACID,([SP_SHOW_DAMAGE:1]));
  AddSpell(5,300,
      "Der Bettler schleudert seine Kraetze auf Dich.\n",
      "Der Bettler schleudert seine Kraetze auf @WEN.\n",
      DT_POISON,([SP_SHOW_DAMAGE:1]));

  AddSpell(5,300,
      "Der Bettler wuenscht Dir seine Beulenpest an den Hals.\n",
      "Der Bettler wuenscht @WEM seine Beulenpest an den Hals.\n",
      DT_TERROR,([SP_SHOW_DAMAGE:1]));
     
  SUID;
  cash=CLONEOB("/obj/money");
  cash->SetProp(P_AMOUNT, random(100)); 
  cash->move(ME);
  CLONEME(ARMOUR"dlumpen");
  command("trage alles");
  CLONEME(OBJ"pizza");
  
 // AddCmd(({"zeige","zeige"}), "zeigen");
  AddCmd(({"tritt","trete","lieb","kuess","taetschle","umarm","spuck","lach"}),"kill",1);  
   
  AddCmd(({"kaufe", "kauf"}), "get");

  RegisterGive( "geldbekommen",
    ({
      ({ "sage Oh! Geld! Na endlich bekomm ich mal was!",3 }),
      ({ "emote betrachtet erfreut seine Muenzen.", 2})
     }) );
}

public void learnSpell(object player) {
    LearnBardSpell(player, "der dinge wahrer hintergrund", "Mit diesem Lied erfaehrst du mehr ueber andere Lebewesen.",
                 "spiele 'der dinge wahrer hintergrund' auf <ziel>");

	return;
}

public string inspireIfBard() {
  if(!objectp(this_player())) return "";

  if(this_player()->QueryProp(P_GUILD) != "bardengilde") return "";

  if(this_player()->QuerySkill("der dinge wahrer hintergrund") != 0) return "";

  call_out("learnSpell", 2, this_player());
  return "";
}

int get(string str)
{
  int betrag;
  object ob;
  betrag=TP->QueryProp(P_LEVEL)*100;
  notify_fail("Was willst Du kaufen?\n");
  if(str=="salz"||str=="prise salz")
  {

    if(!present("ESSEN", TP))
    {
      write("Der Bettler sagt: Dir verkaufe ich sicher nix!\n");
      return 1;
    }

    if(deep_present("SALZ", TP))
    {
      write("Der Bettler sagt: Nein, im Moment habe ich keine Lust dazu!\n");
      return 1;
    }

    if(TP->QueryMoney()<(betrag))
    {
      write("Der Bettler sagt: Nein, Du hast nicht genug Geld!\n"
          "Der Bettler sagt: Du braeuchtest "+betrag+" Muenzen, \n"
          "Der Bettler sagt: hast aber nur "+TP->QueryMoney()+" Muenzen!\n");
      return 1;
    }
    else
    {
      write("Der Bettler sagt: "+CAP_TPN+", das Geschaeft gilt!\n"
          "Daraufhin gibts Du ihm "+betrag+" Muenzen und er "
          "Dir etwas Salz!\n");
      TP->AddMoney(-betrag);
      ob=clone_object("d/dschungel/dante/weg/obj/salz");
      ob->move(TP, M_NOCHECK);
      return 1;
    }
    return 0;
  }  
  return 0;
}

int geldbekommen(object ob)
{
  if( ob->id("geld") )
  {
    EPMASTER->GiveExplorationPoint("bettlergeld", EP_MISC);
    return 1;
  }
  return 0;
}

void give_notify(object ob)
{
  mixed vars;
  object item;
  if(ob->id("muenzen")) {
    if((item=present("\npaladintaskitem", TP)) && item->GetTask(2, TP))
    {
      vars=item->GetVar();
      if(!mappingp(vars)) vars=([]);
      if(!member(vars, "bettler2")) vars+=(["bettler2":0]);
      vars["bettler2"]+=ob->QueryProp(P_AMOUNT);
      if(vars["bettler2"]>=3000)
        item->SetFlag(2);
      item->SetVar(vars);
    }
  }
         
  sequencer::give_notify(ob);
  mnpc::give_notify(ob);
}

void catch_tell(string str)
{
  sequencer::catch_tell(str);
  mnpc::catch_tell(str);
}


void init()
{
  ::init();
  if(interactive(TP)) call_out("hallo",0);
}

int kill(string str)
{
  if( str=="bettler")
    call_out("kill2",0);
  return 0;
}

void kill2()
{
  write("Der Bettler laesst sich von Dir sowas nicht gefallen.\n");
  if(!IS_LEARNING(TP) )
    Kill(TP);
}



int zeigen(string str)
{
  object ob;
  notify_fail("Was willst Du wem zeigen ?\n");
  if(!str || str =="")
  {
    write("Was willst Du dem Bettler zeigen ?\n");
    return 1;
  }
  if (str == "schlamm" || str == "batzen" || str == "schlammbatzen")
  {
    if (!(ob=present("schlammbatzen", TP)) )
    {
      write("Der Bettler sagt: Hey, Du hast doch gar keinen Schlamm bei Dir!\n");
      return 1;
    }
    ob->remove();
    write("Der Bettler freut sich, nimmt Dir den Schlamm weg, schmiert ihn sich "
        "ins Gesicht und sagt lachend: Nimm diese Kelle und grab im Nordosten des Hochplateaus "
        "ein Loch.\n");
    return 1;
  }
}

void hallo()
{
  if(environment(TP)!=environment(TO))
    return;
  switch(random(3))
  {
    case 0:
      command("emote laechelt und sagt: Hallo "+ TP->name(RAW) +", hast Du "
          "etwas Geld fuer mich...");
      break;
    case 1:
      tell_object(TP, "Der Bettler bettelt Dich um Geld an.\n");
      tell_room(MENV, "Der Bettler bettelt "+TP->name(WEN)+" um Geld an.\n", 
          ({TP, TO}));
      break;
    case 2:
      command("emote haelt die Hand auf und sagt: Hast Du Geld fuer mich, "+
        TPN+"?");
      break;
  }
}
