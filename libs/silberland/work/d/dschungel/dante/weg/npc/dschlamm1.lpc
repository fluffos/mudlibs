// /d/<region>/<magiername>/<gebiet>/npc/standard_npc.c   
// Ein Standard File fuer NPCs
// 27-10-1996  Feyaria@SilberLand

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein gruener Monsterschlammspringer");
  SetProp(P_LONG, BS(
    "Der Monsterschlammspringer ist gleich wie seine kleinen grauen Verwandten,"
    "nur ungefaehr zehnmal so gross. Du solltest ihn nicht unterschaetzen."));
  SetProp(P_NAME, "Monsterschlammspringer");
  SetProp(P_GENDER, MALE);
  AddId(({"springer","monster", "schlammspringer","monsterschlammspringer"}));

  create_default_npc(19);
  SetProp(P_HANDS, ({" mit seinen Schlammpfoten", 150,({DT_ACID,DT_POISON})}));
  SetProp(P_RACE, "schlammspringer");
  SetProp(P_SIZE, 50);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_RESISTANCE, ({ DT_ACID,DT_WATER })); 

  SetProp(P_MSGIN, "springt herein");
  SetProp(P_MSGOUT, "springt");
  SetProp(P_MMSGIN, "wuehlt sich aus dem Schlamm hervor");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_DIE_MSG,  " versinkt im Schlamm.\n");
  SetProp(P_NOCORPSE, 1 );

  AddInfo(DEFAULT_INFO, "sagt: BLUBB BLUBB.\n");
  AddInfo("Dante", "Dante hat mich erschaffen.","sagt: ");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Schlammspringer will @WEN nicht tragen.\n" }) );

  SetChats(3, ({
  "Der Schlammspringer sagt: BLUBB BLUBB\n",
  "Der Schlammspringer wuehlt im Schlamm.\n",
  "Der Schlammspringer bespritzt Dich mit Schlamm\n",
  "Der Schlammspringer huepft im Schlamm herum.\n"}) );
  SetAttackChats(10, ({
  "Der Schlammspringer springt Dich an.\n",
  "Der Schlammspringer versucht im Schlamm unterzutauchen.\n",
  "Der Schlammspringer schleudert Dir Schlamm ins Gesicht.\n",
  "Der Schlammspringer versteckt sich im Schlamm.\n"}) );

  SUID;
  CLONEME("/obj/gems/lapislazuli" );
}

