
//dantes kaetzchen 

inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "files.h"
#include <mnpc.h>
create()

{

  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Tiger");
  SetProp(P_LONG, (
        "Dieser Tiger hat erschreckend grosse Reisszaehne, mit denen er Dir "
        "sicherlich furchtbare Wunden zufuegen kann. Lautlos schleicht er durch"
        " den Dschungel nur drauf lauernd, wo sich die naechste Gelegenheit "
        "bietet Beute zu machen.\n"));  

  SetProp(P_NAME, "Tiger");
  SetProp(P_GENDER, MALE);

  set_living_name("dschungeltiger");

  AddId(({"tiger", "raubkatze", "dschungeltiger"}));
  AddDetail(({"zaehne","reisszaehne"}),
      ("Mit diesen scharfen Mordwerkzeugen ist er der unumstrittene Herrscher "
       "des Dschungels!"));
  create_default_npc( 24 );
  SetProp(P_HANDS, ({" mit seinen schrecklichen Pranken", 280, 
        ({DT_RIP,DT_PIERCE,DT_TERROR})}));
  SetProp(P_RACE, "Raubkatze");
  SetProp(P_SIZE, 170+random(100));
  SetProp(P_ALIGN,-300);

  SetProp(P_MSGIN, "schleicht herein");
  SetProp(P_MSGOUT, "schleicht");
  SetProp(P_MMSGIN, "kommt aus dem Dickicht");
  SetProp(P_MMSGOUT, "verschwindet im Dickicht");
  SetProp(P_MNPC_AREA, ("/d/dschungel/"));
  SetProp(P_MNPC_WAIT, ({10, 5, 5}));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "weg14");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES+MOV_BACKWARDS+MOV_SPECIAL);

  SetProp(P_HEAL, 10);
  SetProp(P_AGGRESSIVE, 0.01);
  SetProp(P_NOMAGIC, 5);
  SetProp(P_DIE_MSG,  " bruellt noch einmal laut auf und verendet.\n");

  SetProp(P_DEFAULT_INFO, "faucht Dich nur an.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
        "Der Koenig des Dschungels braucht Deine Sachen nicht.\n" }) );

  SetProp(P_MAX_HANDS, 4);
  SetProp(P_RESISTANCE, ({DT_WHIP, DT_RIP, DT_LIGHT, DT_MAGIC })); 

  SetProp(P_SPELLRATE,90);
  AddSpell(5, 300,
      "Der Tiger zerfleischt Deinen Koerper beinahe.\n",
      "Der Tiger zerfleicht @WESSEN Koerper beinahe.\n",
      DT_RIP, ([SP_SHOW_DAMAGE:1]));
  AddSpell(1, 1100,
      "Der Tiger springt Dich an, reisst Dich zu Boden und graebt seine "
      "Krallen\nin Deine Brust.\n",
      "Der Tiger springt und reisst @WEN zu Boden.\n",
      DT_RIP, ([SP_SHOW_DAMAGE:1]));
  AddSpell(4, 500,
      "Der Tiger zerfetzt Deine Beine zu blutigen Klumpen.\n",
      "Der Tiger zerfetzt @WESSEN Beine zu blutigen Klumpen.\n",
      DT_RIP, ([SP_SHOW_DAMAGE:1]));
  AddSpell(4, 400,
      "Der Tiger attackiert Dich mit messerscharfen Zaehnen.\n",
      "Der Tiger attackiert Dich mit messerscharfen Zaehnen.\n",
      DT_RIP, ([SP_SHOW_DAMAGE:1]));
  AddSpell(2, 700,
      "Der Tiger schlaegt Dir eine Pranke ins Gesicht.\n",
      "Der Tiger schlaegt @WEM eine Pranke ins Gesicht.\n",
      DT_PIERCE, ([SP_SHOW_DAMAGE:1]));
  AddSpell(5, 300,
      "Der Tiger faucht Dich furchtbar an.\n",
      "Der Tiger faucht @WEN furchtbar an.\n",
      DT_TERROR, ([SP_SHOW_DAMAGE:1]));

  SetChats(4, ({
        "Der Tiger faucht Dich an.\n",
        "Du bestaunst beeindruckt den Koenig des Dschungels.\n",
        "Der Tiger schaut Dich mit seinen leuchtenden Katzenaugen an.\n",
        "Der Tiger zeigt seinen gewaltigen Reisszaehne.\n",
        "Der Tiger schleicht um Dich herum.\n",
        "Der Tiger macht sich zu Angriff bereit.\n",
        "Der Tiger bruellt laut.\n",
        "Du weichst erschrocken vor dem Tiger zurueck.\n",
        "Der Tiger schnurrt leise.\n",
        "Der Tiger fletscht seine Zaehne.\n"}) );

  SetAttackChats(9, ({
        "Der Tiger bruellt laut.\n",
        "Der Tiger versucht Dich zu zerfleischen.\n",
        "Der Tiger attackiert Dich von hinten.\n",
        "Det Tiger bohrt seine Krallen in Deinen Leib.\n",
        "Der Tiger fletscht seine Zaehne.\n"}) );

  SUID;
  CLONEME(ARMOUR "dtigerfell");
  CLONEME("/d/dschungel/dante/stein/obj/krblase");

  command("trage alles");
}
