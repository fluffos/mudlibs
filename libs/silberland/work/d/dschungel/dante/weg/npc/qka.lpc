// nochn vogel.....
//dante 97 jaenner
// 
// 

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include "files.h"

create()
{
  if (!is_clone(ME)) return;
  ::create();

  SetProp(P_SHORT, "Ein Kakadu");
  SetProp(P_LONG, (
    "Der Kakadu, eine kleine Papageienart, sitzt auf einem Baumstamm "
    "und pickt Wuermer aus dem Holz.") );
  SetProp(P_NAME, "Kakadu");
  SetProp(P_GENDER, MALE);
  AddId( ({"kakadu"}));

  create_default_npc (7);
  SetProp(P_HANDS, ({" mit seinem spitzen Schnabel", 60+random(20), DT_PIERCE}));
  SetProp(P_RACE, "Vogel");
  SetProp(P_SIZE, 12);
  SetProp(P_ALIGN, 50);
  SetProp(P_DIE_MSG, " frisst nun sicher niemals mehr einen Wurm.\n");
  SetProp(P_HEAL, 5);
  SetProp(P_BODY, 20+random(5));
  SetProp(P_MSGIN, "flattert herein");
  SetProp(P_MSGOUT, "flattert");
  SetProp(P_MMSGIN, "flattert herein");
  SetProp(P_MMSGOUT, "flattert weit weg");

  AddInfo(DEFAULT_INFO, "flattert aufgeregt mit seinen Fluegeln.\n");
  
  SetProp(P_REJECT, ({ REJECT_DROP, 
    "Der Kakadu kann das doch gar nicht tragen.\n"}));


AddCmd(({"pflueck","pfluecke"}), "no", 1);

}

int no()  
{
 write("Der Kakadu hackt Dir in die Hand!\n");
 return 1; 
}


int Defend(int dam, string dtype, int spell, object enemy)
{
  if ((!present("\nfippsiobj", enemy))||(deep_present("daemonenkraut", enemy)) )
  {
    write(BS("Der Kakadu fliegt einfach etwas nach oben und hackt Dir dann "
          "brutal in den Schaedel! "
          "So triffst Du ihn nie!"));
    enemy->do_damage(20);
    if (enemy)
      enemy->StopHuntFor(ME);
    StopHuntFor(enemy);   
  }
  else
    return::Defend(dam, dtype,spell, enemy);
}

void die(int poisondeath)  
{
  call_other("d/dschungel/dante/weg/room/fip2", "delay_time");
  ::die(poisondeath);   
}


