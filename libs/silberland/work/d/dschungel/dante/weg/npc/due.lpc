//dante sl 99

inherit "std/mnpc";
#include "/players/dante/myowndefine.h"
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <mnpc.h>
#include <new_skills.h>

object cash;

create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein dummer Dumpfelf");
  SetProp(P_LONG, BS (
	"Das ist ein kleiner, wehrloser Dumpfelf. Er hat violettschwarze "
	"Haare, karnickelrote Augen und leichenblasse Haut. Du kannst an "
	"ihm Deine ganzen Agressionen gegenueber den Dunkelelfen auslassen."));
	
	AD(({"agression","agressionen"}),
	"Du kannst ihn treten, blenden und anspucken.");
		
  SetProp(P_NAME, "Dumpfelf");
  SetProp(P_NAME_ADJ, "dumm");
  
  SetProp(P_GENDER, MALE);
  AddId(({"elf","dumpfelf", "trint"}));
  AddAdjective( ({"dummer", "dummen", "dummem"}) );
  create_default_npc(17);
  SetProp(P_HANDS, ({" mit seinen leichenkalten Haenden", 111, DT_BLUDGEON}));
  SetProp(P_MAX_HP, 400);
  SetProp(P_BODY,40);
  SetProp(P_SIZE, 170+random(20));
  SetProp(P_ALIGN, 100);
  SetProp(P_MAX_SP, 4000);
  SetProp(P_MAX_HANDS, 2);
  AddInfo(DEFAULT_INFO, "schaut Dich nur nach Schmerzen bettelnd an.\n");
  SetProp(P_REJECT, ({ REJECT_KEEP, 
     "Dumpfi grinst Dich an und behaelt @WEN.\n"}));
  SetProp(P_DIE_MSG, " faellt 'Danke Massa.' aechzend tot zu Boden.\n");
  SetProp(P_KILL_MSG, ("Bedank Dich bei Sisqui.\n")); 
  SetProp(P_HEAL,-30);
  SetProp( P_RESISTANCE_STRENGTHS,([DT_MAGIC:-0.9, DT_BLUDGEON:-0.3,
  DT_FIRE:1.0, DT_WATER:-0.8,DT_COLD:-1.0]));      
  SetProp(P_NOMAGIC, 10);
    
  SP(P_SPELLRATE, 99);
  
  
  AddSpell(5, 250,
  "Der Dumpfelf schlaegt mit seinen kalten Haenden nach Dir.\n",
  "Der Dumpfelf schlaegt mit seinen kalten Haenden nach @WEM!\n",
  DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));
  
     
  SetProp(P_MSGIN, "kommt dumm guckend herein");
  SetProp(P_MSGOUT, "geht dumm guckend");
  SetProp(P_MMSGIN, "kommt dumm guckend herein");
  SetProp(P_MMSGOUT, "sagt: Adios Embrios!");
  
   SetProp(P_MNPC_AREA, ("/d/dschungel/dante/stein/room/"));
   SetProp(P_MNPC_FLAGS,MOV_OUTDOORS + MOV_INDOORS+MOV_MOVES+
   MOV_BACKWARDS+MOV_SPECIAL+MOV_INFIGHT);
   SetProp(P_MNPC_WAIT, ({1, 20, 30}));
   SetProp(P_MNPC_DEFAULTROOM, "/d/dschungel/dante/stein/room/stein3");


AI("sisqui",
"sagt: Kartoffel! Kartoffel!");    
    AI("dante",
    "Der Arsch hat mich gemacht!", "sagt: ");
AI(({"elf","elfen","elfe"}),
"Die Elfen sind allesamt dumme Hunde!", "sagt: ");
AI(({"dunkelelf","dunkelelfen","dunkelelfe"}),
"Die Dunkelelfen kriechen nur im Dreck unter der Erde umher und stinken alle "
"wie alte Maden!", "sagt: ");
AI("dumpfelf",
"Alle Elfen sind Dumpfelfen!", "sagt: ");

  AddSpell(1, 200,
    "Die Dummheit des Dumpfelf trifft Dich.\n",
    "Die Dummheit des Dumpfelfen trifft @WEN.\n",
      DT_MAGIC,([SP_SHOW_DAMAGE: 1]));      
    
    
      SetProp(P_MMSGIN, "dumpft herein");
      SetProp(P_MMSGOUT, "dumpft davon");
          
  
   SUID;                                                                                                                        
   CLONEME("/d/dschungel/dante/weg/obj/dj");
cash=clone_object("/obj/money");
cash->SetProp(P_AMOUNT, 200+random(300));
cash->move(TO, M_GET);

 SetChats(10, ({
    "Der Dumpfelf bohrt in der Nase.\n",
    "Der Dumpfelf starrt Loecher in die Luft.\n",
    "Der Dumpfelf sagt: Die Grazer Mudder sind Meckerziegen!\n",
    "Der Dumpfelf sagt: VIVA ZZZZZZAPPPPATTTTTTTA!\n",
    "Der Dumpfelf kratzt sich am Hintern.\n"}));
    
    
    CLONEME("d/dschungel/dante/weg/obj/ichbinich");
    
    
  }





reset()  {
::reset();
if(!random(50))  {
domainshout("Ein Dumpfelf ruft: Ich bin in der Hoehle der Steingiganten!\n"); }}


   

  init(){
    ::init();
      
      if(interactive(TP)){
      call_out("hallo", 0); }
      

}



      hallo()   {
      if(environment(TO)!=environment(TP))  { return ;}
      
      switch(random(50))  {
      case 0..48:
      write("Der Dumpfelf suddert: Hi "+CAP_TPN+", tritt mir, Du %&%&/!\n");
      break;
      case 49:
      domainshout("Der Dumpfelf bruellt: "+CAP_TPN+" ist noch duemmer als mich!\n");
      break;
      default: write("");
      } }  



void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (find_call_out("react")!= -1) return; 
  
   switch(gruppe) 
     {
         case "fies":
      call_out("react", 0, "sagt: Ja! Gibs mich feste!!",
     "sagt: "+TP->name(WER)+" ist sooo gut zu mir!!!");
          break;
     case "aergerlich":
      call_out("react", 0, "sag: JA! Tritt mir ruhig, "+TPN+"?",0);
 break;
    case "albern":
   call_out("react", 0, "sagt: Tritt mir lieber!",0);
    break;
   case "neutral":
  call_out("react", 0, "sagt: DAS war zu nett, Du Idiot!", "grinst "+TP->name(WEN)+" an.");
   break;
     case "intim":
      call_out("react", 0, "tritt Dich.", "tritt "+TP->name(WEN)+".");
       break;
   case "froh":
  call_out("react", 0, "laechelt Dich doof an.",
         "laechelt "+TP->name(WEN)+" doof an.");
        break;
               case "aengstlich":
        call_out("react", 0, "sagt: Feiger Arsch!.",
          "sagt: "+TP->name(WER)+", Du feiger Arsch!");
           break;


case "traurig":
      call_out("react", 0, "lacht Dich aus!",
      "tritt "+TP->name(WEN)+" nieder!");
      break;
    case "frech":
     call_out("react", 0, "stoehnt laut.", "lechzt "+TP->name(WEN)+" an.");
           break;
 
 
   case "nett":
         call_out("react", 0, "kotzt auf Dich.", "kotzt "+TP->name(WEN)+" an.");
               break;
                           
        }     
}




   
   
   void StartReactionAll(string verb, string gruppe, string adverb, int touch)
   {
     return StartReaction(verb, gruppe, adverb, touch);
     }
     
   
   
   
   void react(string victim, string others)
   {
     if (present(TP, ENV(TO))) 
       {
           if( !others ) others = victim;
               tell_object(TP, BS(Name(WER, 1) + " "+victim) );
        tell_room(ENV(TO), BS(Name(WER, 1)+" "+others), ({TP,TO}) );
     }
      }

