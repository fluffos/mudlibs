// knuddelfisch

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein suesser Knuddelfisch");
  SetProp(P_LONG, BS(
    "Der Knuddelfisch ist ein freundlicher Bewohner des Wassers und wie sein "
    "Name schon sagt, knuddelt er am liebsten alle, die an ihm vorbei schwimmen."));
  SetProp(P_NAME, "Knuddelfisch");
  SetProp(P_GENDER, MALE);
  AddId(({"fisch", "knuddelfisch"}));

  create_default_npc(8);
  SetProp(P_HANDS, ({" mit seinen knuddeligen Flossen ", 80,({DT_WATER,DT_BLUDGEON})}));
  SetProp(P_RACE, "fisch");
  SetProp(P_SIZE, 80);
  SetProp(P_ALIGN, 200);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 10);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_RESISTANCE, ({ DT_WATER })); 
  SetProp(P_VULNERABILITY, ({ DT_FIRE }));
  SetProp(P_NOMAGIC, 5);
  SetProp(P_MSGIN, "schwimmt vorsichtig herein");
  SetProp(P_MSGOUT, "schwimmt");
  SetProp(P_MMSGIN, "schwimmt vorsichtig herein");
  SetProp(P_MMSGOUT, "schwimmt weit weg");

  SetProp(P_DIE_MSG,  " wird niemehr jemanden knuddeln.\n");
  SetProp(P_NOCORPSE, 0 );

  AddInfo(DEFAULT_INFO, "schaut Dich aus grossen Fischaugen fragend an.\n");
  AddInfo("dante", "Dante will nie mit mir knuddeln","sagt: ");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Knuddelfisch will nur knuddeln!\n" }) );

  SetProp(P_SPELLRATE,50);
  
  AddSpell(5,200,
    "Der Knuddelfisch knuddelt Dich fast zu Tode.\n",
    "Der Knuddelfisch knuddelt @WEN fast zu Tode.\n",
     DT_MAGIC,([SP_SHOW_DAMAGE:1]));
 AddSpell(5,200,
    "Der Knuddelfisch macht einen Kampfknuddler.\n",
    "Der Knuddelfisch macht einen Kampfknuddler.\n",
     DT_MAGIC,([SP_SHOW_DAMAGE:1]));
      AddSpell(5,200,
    "Der Knuddelfisch geraet in Knuddelwut.\n",
    "Der Knuddelfisch geraet in Knuddelwut.\n",
     DT_TERROR,([SP_SHOW_DAMAGE:1]));
     
  SetChats(3, ({
  "Der Knuddelfisch knuddelt Dich.\n",
  "Der Knuddelfisch schaut Dich freundlich an.\n",
  "Der Knuddelfisch sagt: Knuddel mich!\n",
  "KNUDDL...KNUDDL...\n",
  "Der Knuddelfisch sagt: Knuddeln ist mein Liebstes.\n",
  "Der Knuddelfisch schwimmt um Dich herum.\n",
  "Der Knuddelfisch schaut Dich aus grossen Augen an.\n",
  "Der Knuddelfisch schwimmt nach unten.\n",
  "Der Knuddelfisch schwimmt nach oben.\n",
  "Der Knuddelfisch macht BLUBB...\n",
  "Du knuddelst den Knuddelfisch.\n"}) );
  
  SetAttackChats(10, ({
  "Der Knuddelfisch versucht zu fliehen.\n",
  "Der Knuddelfisch taucht unter.\n",
  "Der Knuddelfisch will nicht sterben.\n",
  "Der Knuddelfisch schreit: Lass mich doch...\n",
  "Der Knuddelfisch sagt: Ich knuddel Dich auch....\n"}) );

}
