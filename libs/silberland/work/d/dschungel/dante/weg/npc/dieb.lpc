// dante 2.april     @SilberLand

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <wizlevels.h>
#include "def.h"

object cash;

void create()
{

  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein geldgieriger Erdgnom");
  SetProp(P_LONG, BS(
        "Der Erdgnom sitzt den ganzen Tag hier in dieser Grube und wartet nur darauf, "
        "dass ein leichtsinniger Abenteurer hier vorbei kommt, dem er dann sein Geld "
        "wegnehmen kann. Eben genau wie Dir..."));

  SetProp(P_NAME, "Erdgnom");
  SetProp(P_GENDER, MALE);
  AddId(({"gnom", "erdgnom"}));
  SetProp(P_RACE, "Gnom");

  create_default_npc(18);
  SetProp(P_HANDS, ({" mit seinen dreckigen Klauen",160+random(30),({DT_UNHOLY,DT_TERROR,DT_BLUDGEON}) }));
  SetProp(P_SIZE, 150+random(30));
  SetProp(P_ALIGN, -300);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_RESISTANCE, ({ DT_TERROR,DT_UNHOLY })); 
  SetProp(P_VULNERABILITY, ({ DT_HOLY }));
  SetProp(P_NOMAGIC,5);

  SetProp(P_MSGIN, "schlurft herein");
  SetProp(P_MSGOUT, "schlurft");
  SetProp(P_MMSGIN, "schlurft herein");
  SetProp(P_MMSGOUT, "schlurft davon");

  SetProp(P_DIE_MSG,  " grinst Dich noch einmal geldgierig an und faellt dann tot um.\n");
  SetProp(P_NOCORPSE, 0 );

  AddInfo("wuschel", "Wuschel ist mir noch lieber als Geld!\n","schwaermt: ");
  AddInfo(DEFAULT_INFO, "spuckt Dich an.\n");
  AddInfo("dante", "Dante hat mich erschaffen.\n","sagt: ");
  AddInfo("geld", "Ich liebe Geld!\n", "sagt: ");
  AddInfo("muenzen", "Ich liebe alles was glitzert und funkelt und wertvoll ist.","sagt: ");
  SetProp( P_REJECT, ({ REJECT_KEEP,
        "Der Erdgnom schreit: Ich will Geld, Geld, nur Geld!\n" }) );

  SetProp(P_SPELLRATE,50);

  AddSpell(5,400,
      "Der Erdgnom erschreckt Dich fast zu Tode.\n",
      "Der Erdngnom erschreckt @WEN fast zu Tode.\n",
      DT_TERROR,([SP_SHOW_DAMAGE:1]));
  AddSpell(3,500,
      "Der Erdgnom verflucht Dich lauthals.\n",
      "Der Erdgnom verflucht @WEN lauthals.\n",
      DT_UNHOLY,([SP_SHOW_DAMAGE:1]));
  AddSpell(3,500,
      "Der Erdgnom spuckt Dir in die Augen.\n",
      "Der Erdgnom spuckt @WEM in die Augen.\n",
      DT_ACID,([SP_SHOW_DAMAGE:1]));
  AddSpell(2,600,
      "Der Erdgnom stopft Dir Steine in den Mund.\n",
      "Der Erdgnom stopft @WEM Steine in den Mund.\n",
      DT_TERROR,([SP_SHOW_DAMAGE:1]));

  SetChats(3, ({
        "Der Erdgnom grinst Dich boesartig an.\n",
        "Der Erdgnom scheint etwas auszuhecken...\n",
        "Der Erdgnom lacht laut.\n",
        "Der Erdgnom zieht Dich an der Nase.\n",
        "Der Erdgnom kratzt seinen Buckel.\n",
        "Der Erdgnom wuehlt im Boden.\n", 
        "Der Erdgnom stinkt ziemlich.\n"}) );

  SetAttackChats(10, ({
        "Der Erdgnom tritt Dich.\n",
        "Der Erdgnom schreit laut.\n",
        "Der Erdgnom will fluechten.\n"}) );

  SUID;
  cash=CLONEOB("/obj/money");
  cash->SetProp(P_AMOUNT, 10);
  cash->move(ME);

}

init()
{
  ::init();
  call_out("geld", 0);
}

void geld()
{
  int menge, menge_self;
  object ob, ob1;
  if( IS_WIZARD(TP))
  {
    write("Der Erdgnom moecht Dein Geld stehlen, aber er traut sich nicht.\n");
    return;
  }

  if(ob=deep_present("geld", TP)  )
  {

    menge=ob->QueryProp(P_AMOUNT);

    ob1= deep_present("geld",TO);
    menge_self=ob1->QueryProp(P_AMOUNT);
    ob1->SetProp(P_AMOUNT, menge_self+menge);
    ob->remove();
    write("Der Erdgnom stiehlt Dir alle Deine Muenzen.\n");
  }
  else
  {
    write("Der Erdgnom verflucht Dich lauthals.\n");
  }
}
