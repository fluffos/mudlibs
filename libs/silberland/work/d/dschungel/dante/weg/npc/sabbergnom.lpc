//sabbergnom dante

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "/players/dante/myowndefine.h"
void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Sabbergnom");
  SetProp(P_LONG, BS(
  "Dieser Gnom sabbert alles und jeden an. Er ist auch der wahre "
  "Erfinder des Sabberlatzes. Man hat ihn hier eingesperrt, weil er "
  "sonst das ganze Silberland vollsabbern wuerd."));
    
  SetProp(P_NAME, "Sabbergnom");
  SetProp(P_GENDER, MALE);
  AddId(({"gnom", "sabbergnom"}));
  SetProp(P_RACE, "Gnom");

  create_default_npc(15);
  SetProp(P_HANDS, ({" mit seinen Sabberklauen",160+random(30),({DT_ACID}) }));
  SetProp(P_SIZE, 120+random(30));
  SetProp(P_ALIGN, -300);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,-10);
  SetProp(P_BODY, 40);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);

  SetProp(P_NOMAGIC,0);

  SetProp(P_MSGIN, "sabbert herein");
  SetProp(P_MSGOUT, "sabbert");
  SetProp(P_MMSGIN, "wird sabbernd hereingeworfen");
  SetProp(P_MMSGOUT, "sabbert");

  SetProp(P_DIE_MSG,  " sabbert laut und zerfaellt dann zu Sabber.\n");
  SetProp(P_NOCORPSE, 0 );

  AddInfo(DEFAULT_INFO, "spuckt Dich an.\n");
  AddInfo("dante", "Dante hat mich erschaffen.","sagt: ");

  SetProp( P_REJECT, ({ REJECT_KEEP,
    "Der Sabbergnom bruellt: SAAAAAAABBBER!!!!\n" }) );

  SetProp(P_SPELLRATE,50);
AI("sabber",
"Ich bin Sabber", "sagt: ");
AI("kaefig",
"Ich sabbere den Kaefig voll!", "sagt: ");
AI("kette",
"sabbert traurig.\n");  
  AI(({"latz","sabberlatz"}),
  "Den bekommst Du ?*+/&%& nur ueber meinen Sabber!", "sagt: ");
  AddSpell(4,200,
    "Der Sabbergnom sabbert Dich an.\n",
    "Der Sabbergnom sabbert @WEN an.\n",
     DT_ACID,([SP_SHOW_DAMAGE:1]));
 AddSpell(1,300,
    "Der Sabbergnom wirft mit Sabber nach Dir.\n",
    "Der Sabbergnom wirft mit Sabber nach @WEM.\n",
     DT_ACID,([SP_SHOW_DAMAGE:1]));
     
  SetChats(3, ({
  "Der Sabbergnom grinst Dich boesartig an.\n",
  "Der Sabbergnom scheint etwas auszuhecken...\n",
  "Der Sabberngnom lacht laut.\n",
  "Der Sabbergnom zieht Dich an der Nase.\n",
  "Der Sabbergnom kratzt seinen Buckel.\n",
  "Der Sabbergnom sabbert.\n",
  "Der Sabbergnom sabbert laut.\n" 
  "Der Sabbergnom stinkt ziemlich.\n"}) );

}

 die(arg)  {
   object ob;
   if(deep_present("sabberlatz", TP) ) { 
   write("Der Sabbergnom bruellt: HAHA! Du hast ja einen Latz.\n");
    }
   else   {
   write("Sterbend wirft der Sabbergnom Dir einen Sabberlatz zu!\n");
   ob=clone_object("/d/dschungel/dante/weg/obj/latz");
   ob->move(TP, M_NOCHECK);
   ob->SetProp(P_SHORT, CAP_TPN+"s Sabberlatz");
   } ::die(arg); }
   
