
//monster das wurzzelreissen verhindert


inherit "std/npc";

#include "files.h"
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <player.h>
#include <npc.h>


init()
{
  ::init();
  if(deep_present("wurm", TP))
  {
    write("Der Worminator bruellt: "+TPN+", gib mir den Wurm!\n");
    Kill(TP);
  }
}



create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Worminator");
  SetProp(P_LONG, BS(
        "Das ist ein Worminator. Seinen Namen traegt er, weil er alle Wuermer sofort "
        "vernichten will. Dich uebrigens auch, falls Du einen Wurm bei Dir traegst."));
  SetProp(P_NAME, "Worminator");
  SetProp(P_GENDER, MALE);
  AddId( ({"worminator"}) );

  create_default_npc(10);
  SetProp(P_HANDS, ({" mit seinem Ruesselhaenden", 150+random(20),(DT_BLUDGEON)}));
  SetProp(P_RACE, "Worminator");
  SetProp(P_SIZE, 100+random(20));
  SetProp(P_ALIGN, -200);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_WEIGHT, 2000);
  SetProp(P_INFO, "Der Worminator verteidigt seine Wuermer...\n");
  SetProp(P_REJECT, ({ REJECT_DROP, 
        "Der Worminator will das nicht!\n"}));
  SetProp(P_DIE_MSG, " bruellt: Wuermer, ich kommme!\n");
  SetProp(P_NOCORPSE, 0);
  SetProp(P_AGGRESSIVE, 0.1);

  SetProp(P_MMSGIN, "kriecht wurmsuchend herein");
  SetProp(P_MMSGOUT, "kriecht wurmsuchend weg");
  SetProp(P_MSGIN, "kriecht wurmsuchend herein");
  SetProp(P_MSGOUT, "kriecht wurmsuchend");
  SetProp(P_KILL_MSG, "bruellt: Du Wurm!");
  SetProp( P_MSG_FLAGS, ([P_KILL_MSG:1]) );

  SetChats(5, ({
        "Der Worminator sagt: Wo seid ihr liebe Wuermer!\n",
        "Der Worminator sucht Wuermer.\n",
        "Der Worminator sagt: Du hast sie gestohlen!!!\n",
        "Der Worminator sagt: Wuermer!!! Wuermer!!!\n",
        "Der Worminator sagt: Bist Du ein Wurm?\n",
        "Der Worminator sagt: Wo sind sie, die Wuermer!\n"}));          
  SetProp(P_SPELLRATE, 60);
  AddSpell(5, 300, 
      "Der Worminator versucht Dich einzusaugen.\n",
      "Der Worminator versucht @WEN einzusaugen.\n",
      DT_TERROR, ([SP_SHOW_DAMAGE:1]));
  AddSpell(3, 400, 
      "Der Worminator wurmt Dich extrem.\n",
      "Der Worminator wurmt @WEN extrem.\n",
      DT_MAGIC, ([SP_SHOW_DAMAGE:1]));
  AddSpell(4, 300, 
      "Der Worminator bruellt Dir WURMTOD! ins Ohr!\n",
      "Der Worminator bruellt @WEM Wurmtod ins Ohr!\n",
      DT_TERROR, ([SP_SHOW_DAMAGE:1]));                                                               
  SetProp(P_DEFAULT_INFO,
      "Du Wurm, halts Maul!\n");


  AddCmd(({"reiss","reisse"}), "no", 1);


  AddInfo("dante",
      "sagt: Dante ist ein Wurm!\n");   
  AddInfo(({"wurm"}),
      "sagt: Ich liebe die Wuermer...\n");
  AddInfo("wuermer",
      "sagt: Ich fresse sie sooo gerne.\n");

}

int no()
{
  write("Der Worminator sagt: Nix da! Meine Wurzel! Hau ab!\n");
  return 1;
}

