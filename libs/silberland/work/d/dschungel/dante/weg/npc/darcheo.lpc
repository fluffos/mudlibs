// Ein dummer vogel.....dante   
// 
// 

inherit "std/npc";
inherit "std/npc/sequencer";
#include "files.h"
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>

create()
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein Archaeopterix");
  SetProp(P_LONG, (
    "Der Archaeopterix ist der sogenante Urvogel. Von ihm leiten sich "
    "alle anderen Voegel ab. Er hat ein auffallend buntes Gefieder und "
    "ist am ehesten mit einem grossen Kakadu zu vergleichen. Seltsam, "
    "dass es ihn hier noch gibt.\n"));
  SetProp(P_NAME, "Archaeopterix");
  SetProp(P_GENDER, MALE);
  SetProp(P_ARTICLE, 1);
  AddId( ({"vogel", "archaeopterix"}) );
  AddDetail( ({"gefieder", "federn"}),
    "Die Federn des Archaeopterix sind bunt schillernde Kunstwerke der "
    "Natur und bringen sicher viel Geld ein...\n");
  

  create_default_npc(9);
  SetProp(P_HANDS, ({" mit seinem Schabel", 70+random(10),
                     DT_BLUDGEON}));
  SetProp(P_RACE, "Vogel");
  SetProp(P_SIZE, 130+random(20));
  SetProp(P_ALIGN, 200);
  SetProp(P_NOCORPSE, 1);
  SetProp(P_DIE_MSG, " flattert laut schreiend davon.\n");
  SetProp(P_WIMPY, 50);
  SetProp(P_MSGIN, "flattert herein");
  SetProp(P_MSGOUT, "flattert");
  SetProp(P_MMSGIN, "flattert herein");
  SetProp(P_MMSGOUT, "flattert davon");
  SetProp(P_RESISTANCE, ({DT_MAGIC}));
  
  SetProp(P_NOMAGIC, 20);
  
  AddInfo(DEFAULT_INFO, "schaut Dich nur an.\n");
  AddInfo("dante", "Ich bin ein Vogel, Dante hat einen...", "teilt Dir mit: ");
  SetProp(P_REJECT, ({ REJECT_DROP, 
     "Was soll ein Vogel mit Deinem Kram?\n"}));
  SetChats(10, ({
   "Archaeopterix schuettelt sein prachtvolles Gefieder.\n",
   "Du bewunderst diesen seltenen Vogel.\n",
   "Archaeopterix faengt eine kleine Maus.\n",
   "Archaeopterix sieht sich vorsichtig um.\n",
   "Archaeopterix stoesst einen Balzruf aus.\n",
   "Archaeopterix scharrt am Boden nach Wuermern.\n",
   "Archaeopterix angelt sich eine Beere.\n"}) );
 SetAttackChats(20, ({
   "Archaeopterix stoesst aufgeregte Laute aus.\n",
   "Archaeopterix versucht Dich zu kratzen.\n",
   "Archaeopterix hackt Dir in Die Hand.\n"}) );  
 
 SUID;
 CLONEME(OBJ"dfeder");
}
