// gorilla von dante 97 jaenner

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>

#include "files.h"

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Pavian");
  SetProp(P_LONG, BS(
    "Der Pavian ist ein froehlicher, netter Dschungelbewohner, der einen knallroten "
    "Po hat. Akrobatisch springt er im Dschungel auf und nieder, und ist immer "
    "zu einem Scherz bereit."));
  AddDetail(("po"),
    "Du willst doch nicht so indiskret sein, oder?");
  SetProp(P_NAME, "Pavian");
  SetProp(P_GENDER, MALE);
  AddId(({ "affe", "pavian"}));

  create_default_npc(14);
  SetProp(P_HANDS, ({" mit seinen kraeftigen Armen",150+random(20), DT_BLUDGEON}));
  SetProp(P_RACE, "affe");
  SetProp(P_SIZE, 100);
  SetProp(P_ALIGN, 100);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_RESISTANCE, ({ DT_BLUDGEON})); 
  SetProp(P_NOMAGIC,0);

  SetProp(P_MSGIN, "springt herein");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "springt von einem Baum herab");
  SetProp(P_MMSGOUT, "verschwindet wieder in den Urwald");

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");

  AddInfo(DEFAULT_INFO, "kratzt sich nur am Kopf.\n");
  AddInfo("urwald", "UGGA UGGA...","sagt: ");
  AddInfo("dante", "Dante ist mein Herr und Meister","sagt: ");

  SetProp( P_REJECT, ({ REJECT_KEEP,          
    "Der Pavian freut sich.\n" }) );

  SetChats(4, ({
  "Der Pavian springt froehlich auf und ab.\n",
  "Der Pavian kratzt sich am Kopf.\n",
  "Der Pavian zieht an Deiner Kleidung.\n",
  "Der Pavian zieht an Deinen Haaren.\n",
  "Der Pavian furzt.\n",
  "Der Pavian macht einen Salto.\n",
  "Der Pavian grunzt laut.\n",
  "Der Pavian macht einen Purzelbaum.\n",
  "Der Pavian will mit Dir spielen.\n",
  "Der Pavian schubst Dich.\n",
  "Der Pavian macht einen Handstand.\n"}) );
  
  SetAttackChats(20, ({
  "Der Pavian beisst Dich.\n",
  "Der Pavian kratzt Dich.\n",
  "Der Pavian beisst Dir in den Arm.\n",
  "Der Pavian schlaegt Dich zu Boden.\n",
  "Der Pavian spuckt Dich an.\n",
  "Der Pavian schreit: UGGA UGGA !!!\n"}) );
  
}

