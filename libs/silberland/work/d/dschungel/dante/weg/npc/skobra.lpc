// satanskobra fuer die boesen buben

inherit "std/npc";
inherit "std/npc/spells";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include "files.h"
#include <new_skills.h>
 create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Speikobra");
  SetProp(P_LONG, BS(
    "Die Speikobra ist eine hochgiftige riesengrosse Schlange. Bevorzugt "
    "toetet sie ihre Opfer dadurch, dass sie ihnen Gift in die Augen spuckt."));
  AddDetail(({"giftzaehne","zahn","zaehne"}),
  "Diese Zaehne sind eine toedliche Waffe.\n");
  
  SetProp(P_NAME, "Speikobra");
  SetProp(P_GENDER, FEMALE);
  AddId(({"schlange", "kobra", "speikobra"}));
  SetProp(P_RACE, "Schlange");

  create_default_npc(16);
  SetProp(P_HANDS, ({" mit ihrem Giftzaehnen",150+random(20),({DT_POISON,DT_PIERCE}) }) );
  SetProp(P_SIZE, 500);
  SetProp(P_ALIGN, -400);
  SetProp(P_MAX_HANDS, 0);
  SetProp(P_HEAL, 5);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_RESISTANCE, ({ DT_POISON,DT_MAGIC,DT_FIRE})); 
  SetProp(P_VULNERABILITY, ({ DT_WATER,DT_COLD }));
  SetProp(P_NOMAGIC,5);

  SetProp(P_MSGIN, "schlaengelt herein");
  SetProp(P_MSGOUT, "schlaengelt");
  SetProp(P_MMSGIN, "schlaengelt herein");
  SetProp(P_MMSGOUT, "schlaengelt hinaus");

  SetProp(P_DIE_MSG,  " zischt Dich nie wieder an.\n");
  SetProp(P_NOCORPSE, 0 );

  AddInfo(DEFAULT_INFO, "zischt Dich nur boese an.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Die Speikobra braucht Deinen Muell nicht.\n" }) );

  SetProp(P_SPELLRATE,60+random(20));
  AddSpell(4,200,
    "Die Speikobra schlaegt ihre Zaehne in Dein Fleisch.\n",
    "Die Speikobra schlaegt ihre Zaehne in @WESSEN Fleich.\n",
    DT_RIP, ([SP_SHOW_DAMAGE:1]));
  AddSpell(1,700,   
    "Die Speikobra spuckt Dir Gift in die Augen.\n",
    "Die Speikobra spuckt @WEM Gift in die Augen.\n",
    DT_POISON, ([SP_SHOW_DAMAGE:1]));
     AddSpell(1,700,   
    "Die Speikobra erwuergt Dich beinahe.\n",
    "Die Speikobra erwuergt @WEN beinahe.\n",
    DT_SQUEEZE, ([SP_SHOW_DAMAGE:1]));
     AddSpell(5,300,   
    "Die Speikobra zerfetzt Dein Bein.\n",
    "Die Speikobra zerfetzt @WESSEN Bein.\n",
    DT_RIP, ([SP_SHOW_DAMAGE:1]));
  AddDefaultSpell(2,1,DS_POISON);
  
  SetChats(3, ({
  "Die Speikobra zischt Dich boese an.\n",
  "Die Speikobra richtet sich auf.\n",
  "Die Speikobra schnappt nach Dir.\n",
  "Du bekreuzigst Dich aengstlich.\n",
  "Die Speikobra beobachtet Dich genau.\n",
  "Die Speikobra faucht Dich an.\n",
  "Die Speikobra beisst sich in den Schwanz.\n",
  "Die Speikobra schlaengelt naeher an Dich heran.\n",
  "Die Speikobra schlaengelt zwischen Deinen Beinen durch.\n"}) );
  
  SetAttackChats(10, ({
  "Die Speikobra versucht Dich zu erwuergen.\n",
  "Die Speikobra draengt Dich in ein Eck.\n",
  "Die Speikobra zerquetscht Dein Bein.\n",
  "Du stolperst ueber Die Kobra.\n"}) );
}

