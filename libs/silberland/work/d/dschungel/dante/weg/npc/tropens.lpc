//dante 97 jaenner
// 
// 
//tropensau hat schinken
inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include "files.h"
#include <mnpc.h>    
create()
{
  if (!is_clone(ME)) return;
  ::create();

  SetProp(P_SHORT, "Eine Tropensau");
  SetProp(P_LONG, (
  "Das ist eine Tropensau. Eine seltene Art Schwein, das besonders leckeren "
  "Schinken abliefert. Dante isst die aeusserst gerne."));
  SetProp(P_NAME, "Tropensau");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"sau", "tropensau", "schwein", "\n_dantes_tropensau"}));

  create_default_npc (11);
  SetProp(P_HANDS, ({" mit ihrer borstigen Schnauze", 90+random(20), DT_PIERCE}));
  SetProp(P_RACE, "Schwein");
  SetProp(P_SIZE, 90);
  SetProp(P_ALIGN, 50);
  SetProp(P_DIE_MSG, " bricht quiekend nieder.\n");
  SetProp(P_HEAL, 10);
  SetProp(P_BODY, 30+random(5));
  SetProp(P_MSGIN, "kommt grunzend herein");
  SetProp(P_MSGOUT, "geht grunzend");
  SetProp(P_MMSGIN, "kommt laut oinkend herein");
  SetProp(P_MMSGOUT, "rennt weit weg");
   SetProp(P_MNPC_AREA, ("/d/dschungel/dante/weg/room/weg"));
     SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES+MOV_BACKWARDS+MOV_INFIGHT );
       SetProp(P_MNPC_WAIT, ({5, 5, 5}));
         SetProp(P_MNPC_DEFAULTROOM, ROOM "weg9");
  SetProp(P_NOCORPSE, 1);
  
  
  
  AddInfo(DEFAULT_INFO, "oinkt laut.\n");
   SetProp(P_WIMPY,50);      
  SetProp(P_REJECT, ({ REJECT_DROP, 
    "Die Tropensau oinkt Dich laut an.\n"}));

  SetChats(4, ({
  "Die Tropensau oinkt laut.\n"
  "Die Tropensau grunzt Dich an!\n",
  "Die Tropensau denkt . o O `Ah! Ein Artgenosse!`\n",
  "Die Tropensau quiekt laut.\n",
  "Die Tropensau graebt im Boden!\n",
  "Die Tropensau scharrt im Boden!\n",
  "Die Tropensau hofft . o O `Ich will nicht als Hamburger enden!`\n"}));
  

}
Defend(int dam, string dtype, int spell, object enemy)
 {
  if( (!present("ESSEN", enemy))||(deep_present("SCHINKEN", TP)) )
     {
         write("Die Tropensau weicht Dir geschickt aus!\n"
         "Dann beisst sie Dir brutal in die Fuesse!!!\n");
         enemy->do_damage(10);//muss sein
         
              enemy->StopHuntFor(ME);
                  StopHuntFor(enemy);
         }
         else
           return::Defend(dam, dtype,spell, enemy);
           
                         }                                   
  
  
  die(arg) {
    object ob;


    if(present("ESSEN", TP))
    { 
        ob=clone_object("d/dschungel/dante/weg/obj/schinken");

    
      write("Sterbend verwandelt sich die Tropensau in einen herrlichen "
        "Schinken, der Dir in die Arme faellt!\n");
      ob->move(TP, M_NOCHECK);
    }
    call_other("/d/dschungel/dante/weg/room/weg9", "new_pig");
    ::die(arg);
    }
                                        
