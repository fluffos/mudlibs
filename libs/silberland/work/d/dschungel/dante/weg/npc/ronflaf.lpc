//dante sl 98

inherit "std/mnpc";      
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <actions.h>
#include <new_skills.h>
#include "/players/dante/myowndefine.h"
#include <mnpc.h>
#include <class.h>

int i, l;
string *was;
string wer;

init()  {
	
	 ::init();
	  
	   if( interactive(TP))   {
	call_out("tag", 2);
	}  
}
	            tag()  {
	            	object ob1, ob2;
		if(environment(TP)== environment(TO) )  {
			
	if( TP && interactive(TP)&& environment(TP) && present("fee", environment(TP)))  {
	
	ob1=clone_object("obj/misc/furz");
        ob1->move(environment(TP), M_NOCHECK);
        tell_room(environment(TO),
        "Der Flaffe furzt hemmungslos herum!\n");
        
        
        ob2=clone_object("/d/dschungel/dante/weg/obj/fkot");
        ob2->move(environment(TP), M_NOCHECK);
        tell_room(environment(TO),
        "Der Flaffe verrichtet sein Geschaeft!\n");
        }
			
			if(TP->QP(P_RACE)== "Fee")  {
				write(BSA(
				"WAEHHH!!! Du stinkende Fee "+CAP(getuid(TP))+"!!!",
				"Der Flaffe bruellt: "));
			}
			else
			
			write(BS(
			"Der Flaffe quiekt irgendetwas von "+TPN+" und grinst froehlich dabei."));
			} }


create()
{
  if (!is_clone(TO)) return;
    ::create();

switch(random(10)) {
	case 0:
	l=1;
	wer="winzig";
	break;
        case 1:
	l=2;
	wer="klein";
	break;
	case 2:
	l=3;
	wer="mittelgross";
	break;
	case 3:
	l=4;
	wer="gross";
	break;    
        l=5;
	wer="sehr gross";
	break;    
        l=6;
	wer="riesig";
	break;    
        l=7;
	wer="gigantisch";
      default:
   l=3;
   wer="mittelgross";
  }


was=({
	 "braun","weiss","schwarz","hellbraun",
	 "ockerfarben","gestreift","gepunktet",
	 "weiss","dunkelbraun","schwarzbraun" });
	
	i=random(sizeof(was)); 


  SetProp (P_SHORT, "Ein "+wer+"er, "+was[i]+"er Flaffe");
  SetProp (P_LONG, BS(
"Das ist ein Flaffe. Ein gefluegelter Affe. Richtig fliegen kann er nicht, aber zumindest "
"leicht vom Boden abheben und wild umherschlagen mit seinen kleinen Fluegeln. "
"Dieses Exemplar hat ein "+was[i]+"es Fell und ist ein "+wer+"es Exemplar seiner Art. "
"Flaffen sind eigentlich gutmuetige, lustige Tiere. Flaffen koennen weiters Feen absolut nicht ausstehen "
"und verdrecken gerne das Schloss der Feen!"));
  
  SetProp (P_NAME, "Flaffe");
  SetProp (P_GENDER, MALE);
  SP(P_NAME_ADJ, ({wer, was[i]}));
  
  AddId (({"affe","flaffe"}));
  create_default_npc (10+l);
  SetProp (P_SIZE, 30+l*14);
  SetProp (P_HEAL, l);




 SetProp( P_RESISTANCE_STRENGTHS,([DT_COLD: 0.2, DT_FIRE:0.1,
   DT_BLUDGEON:-0.1]));
     
SetProp(P_MSGIN, "springt kreischend herein");
  SetProp(P_MSGOUT, "springt kreischend");
    SetProp(P_MMSGIN, "springt pfeiffend herein");
      SetProp(P_MMSGOUT, "springt bruellend davon");
    SetProp(P_MNPC_AREA, ("/d/ebene/ronja/feenquest/room/"));
          SetProp(P_MNPC_DEFAULTROOM, "/d/ebene/ronja/feenquest/room/sgang13");
            SetProp(P_MNPC_FLAGS,MOV_OUTDOORS+MOV_INDOORS+ MOV_MOVES + MOV_BACKWARDS+MOV_INFIGHT);
              SetProp(P_MNPC_WAIT, ({5, 5, 20}));  
  
  SetProp (P_HANDS, ({" mit seinen scharfen Krallen", 40+random(20)+l*10, ({DT_PIERCE}) }));
  SetProp (P_ALIGN, 100);
  
  SetChats(5, ({
  "Der "+wer+"e "+was[i]+"e Flaffe kreischt laut.\n",
  "Der "+wer+"e "+was[i]+"e Flaffe fletscht seine Zaehne.\n",	
  "Der "+wer+"e "+was[i]+"e Flaffe springt umd Dich herum.\n",
  "Der "+wer+"e "+was[i]+"e Flaffe schnuppert nach Dir.\n",
  "Der "+wer+"e "+was[i]+"e Flaffe wuehlt im Boden.\n",
  "Der "+wer+"e "+was[i]+"e Flaffe kratzt sich.\n",
  "Der "+wer+"e "+was[i]+"e Flaffe sagt 'DUDUDUUU!'.\n",
  "Der "+wer+"e "+was[i]+"e Flaffe sucht eine Banane.\n",
  "Der "+wer+"e "+was[i]+"e Flaffe sucht nach Essen.\n" }) );
  

     AddSpell(1,100+l*15,
     "Der "+wer+"e "+was[i]+"e Flaffe will seine Zaehne in Dein Bein schlagen!\n",
     "Der "+wer+"e "+was[i]+"e Flaffe will seine Zaehne in @WESSEN Bein schlagen.\n",
   DT_RIP, ([SP_SHOW_DAMAGE:1]));
                                                                         
    
     AddSpell(3,70+l*10,
     "Der "+wer+"e "+was[i]+"e Flaffe will seine Zaehne in Deinen Arm schlagen!\n",
     "Der "+wer+"e "+was[i]+"e Flaffe will seine Zaehne in @WESSEN Arm schlagen.\n",
   DT_RIP, ([SP_SHOW_DAMAGE:1]));                                                                     

SUID;
//CLONEME("/d/gebirge/dante/gruft/armour/vwfell.lpc");
//command("ziehe alles an");

}

 
 void NotifyPlayerDeath(object player, object killer, int lostexp)
 {
NAL1
}
NAL2

