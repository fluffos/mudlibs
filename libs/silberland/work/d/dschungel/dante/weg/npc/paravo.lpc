// nochn vogel.....
//dante 97 jaenner
// 
// 

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include "files.h"

create()
{
  if (!is_clone(ME)) return;
  ::create();

  SetProp(P_SHORT, "Ein Paradiesvogel");
  SetProp(P_LONG, (
  "Der Paradiesvogel ist wirklich so schoen, als ob er direkt aus "
  "dem Paradies stammt. Irgendwo hier hat er sicher sein Nest!!! Suchs!"));
  SetProp(P_NAME, "Paradiesvogel");
  SetProp(P_GENDER, MALE);
  AddId( ({"vogel", "paradiesvogel"}));

  create_default_npc (9);
  SetProp(P_HANDS, ({" mit seinem spitzen Schnabel", 70+random(20), DT_PIERCE}));
  SetProp(P_RACE, "Vogel");
  SetProp(P_SIZE, 20);
  SetProp(P_ALIGN, 50);
  SetProp(P_DIE_MSG, " fliegt direkt ins Paradies.\n");
  SetProp(P_HEAL, 5);
  SetProp(P_BODY, 20+random(5));
  SetProp(P_MSGIN, "flattert herein");
  SetProp(P_MSGOUT, "flattert");
  SetProp(P_MMSGIN, "flattert herein");
  SetProp(P_MMSGOUT, "flattert weit weg");

  AddInfo(DEFAULT_INFO, "flattert aufgeregt mit seinen Fluegeln.\n");
  
  SetProp(P_REJECT, ({ REJECT_DROP, 
    "Der Paradiesvogel kann das doch gar nicht tragen.\n"}));

  SetChats(4, ({
  "Der Paradiesvogel beobachtet sein Nest!\n",
  "Der Paradiesvogel setzt sich kurz auf sein Nest!\n",
    "Der Paradiesvogel haemmert gegen den Stamm.\n",
    "Der Paradiesvogel fliegt zum naechsten Ast.\n",
    "Der Paradiesvogel schaut Dich neugierig an.\n",
    "Der Paradiesvogel scheint Dich mit seinem Lied zu verhoehnen.\n",
    "Du hoerst begeistert dem Traellern des Paradiesvogels zu.\n",
    "Der Paradiesvogel putzt sein Gefieder.\n",
    "Der Paradiesvogel flattert aufgeregt mit den Fluegeln.\n",
    "Der Paradiesvogel traellert eine froehliche Melodie.\n"}) );


AddCmd(({"stiehl", "stehle"}), "no", 1);
}
 int no()
   {
   write("Der Paradiesvogel hackt Dir in die Hand!\n");
   TP->do_damage(5);
   return 1;
   }
Defend(int dam, string dtype, int spell, object enemy)
 {
  if((!present("ESSEN", enemy))||(deep_present("paradiesvogelei", enemy)) )
     {
         write("Der Paradiesvogel weicht Dir geschickt aus!\n"
         "Dann hackt er Dir ins Bein!\n");
         enemy->do_damage(10);
              enemy->StopHuntFor(ME);
                  StopHuntFor(enemy);
         }
         else
           return::Defend(dam, dtype,spell, enemy);
           
                         }                                   
    die(arg)
    {
    call_other("d/dschungel/dante/weg/room/palme", "new_bird" );
    ::die(arg);
    }
