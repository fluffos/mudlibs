
inherit "std/mnpc";
inherit "std/npc/spells";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <mnpc.h>
#include "files.h"
#include <new_skills.h>
create()
{
if (!is_clone(this_object())) return;
:: create();
create_default_npc ( 9 );
SetProp(P_NAME, "Mamba");
SetProp(P_NAME_ADJ, "braun");
SetProp(P_GENDER, FEMALE);
SetProp(P_SHORT, "Eine braune Mamba");
SetProp(P_HEAL, 0);
SetProp(P_SIZE, 150);
SetProp(P_WEIGHT, 9000);
SetProp(P_ALIGN, -200);
SetProp(P_AGGRESSIVE, 0);
SetProp(P_MAX_HANDS, 0);
SetProp(P_HANDS, ({" mit ihren spitzen Zaehnen an.", 80+random(30),({DT_POISON,DT_RIP}) }));
AddId(({"schlange","mamba"}));
AddAdjective( ({"braun", "braune"}) );
SetProp(P_DIE_MSG, " windet sich noch einmal am Boden und verendet dann lautlos.\n");
SetProp(P_REJECT, ({ REJECT_KEEP, "Die Mamba zischt Dich nur an.\n"}) );

SetAttackChats(20, ({
    "Die Mamba will Dir ins Beine beissen.\n",
    "Die Mamba versucht Deine Hand zu zerfetzen.\n",
    "Die Mamba will Dir an den Hals springen.\n",
    "Die Mamba springt Dir an die Kehle.\n"}));
SetChats(5, ({
    "Die Mamba richtet sich auf und faucht Dich an.\n",
    "Die Mamba kriecht naeher an Dich heran.\n",
    "Die Mamba versucht Dich zu attackieren.\n",
    "OH!!! Fast waerst Du auf die Mamba getreten!\n",
    "Du weichst der Mamba behende aus.\n",
    "Die Mamba schlaengelt um Dich herum.\n"}) );

SetProp(P_SPELLRATE, 30+random(10));
           
AddSpell(5,200,
    "Die Mamba schlaegt ihre Zaehne in Deine Hand.\n",
    "Die Mamba schlaegt ihre Zaehne in @WESSEN Hand.\n",
    DT_RIP, ([SP_SHOW_DAMAGE:1])); 
 AddSpell(2,300,
    "Die Mamba spuckt Dir Gift in die Augen.\n",
    "Die Mamba spuckt @WEM Gift in die Augen.\n",
    DT_POISON, ([SP_SHOW_DAMAGE:1]));
     AddSpell(4,300,
    "Die Mamba beisst Dir ins Bein.\n",
    "Die Mamba beisst @WEM ins Bein.\n",
    DT_PIERCE, ([SP_SHOW_DAMAGE:1]));
     AddSpell(2,400,
    "Die Mamba zerfetzt Dein Gesicht.\n",
    "Die Mamba zerfetzt Dein Gesicht.\n",
    DT_RIP, ([SP_SHOW_DAMAGE:1]));

     AddDefaultSpell(1,1,DS_POISON);

SetProp(P_LONG, ("Die braune Mamba ist eine giftige Schlange. Ihren Namen "
                 "hat sie, weil ihr Koerper eine braune Farbe aufweist."));

 SetProp(P_MSGIN, "schlaengelt herein");
 SetProp(P_MSGOUT,"schlaengelt");
 SetProp(P_MMSGIN, "schlaengelt fauchend");
 SetProp(P_MMSGOUT, "schlaengelt davon");
 SetProp(P_MNPC_AREA, ROOM "grube");
 SetProp(P_MNPC_WAIT, ({10,10,5}));
 SetProp(P_MNPC_DEFAULTROOM, ROOM"grube");
 SetProp(P_MNPC_FLAGS, MOV_MOVES + MOV_BACKWARDS + MOV_OUTDOORS);
                 

}     
