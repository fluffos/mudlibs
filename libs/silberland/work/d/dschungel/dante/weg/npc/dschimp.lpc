// gorilla von dante 97 jaenner

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>

#include "files.h"

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein kleiner Schimpanse");
  SetProp(P_LONG, BS(
    "Du siehst einen kleinen, froehlichen Schimpansen vor Dir, der Dich "
    "freundlich und intelligent angrinst."));
  SetProp(P_NAME, "Schimpanse");
  SetProp(P_GENDER, MALE);
  AddId(({ "affe", "schimpanse"}));

  create_default_npc(12);
  SetProp(P_HANDS, ({" mit seinen kleinen Armen",120, DT_BLUDGEON}));
  SetProp(P_RACE, "Affe");
  SetProp(P_SIZE, 90);
  SetProp(P_ALIGN, 300);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 30);
  SetProp(P_NOMAGIC,10);

  SetProp(P_MSGIN, "springt herein");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "springt von einem Baum herab");
  SetProp(P_MMSGOUT, "verschwindet wieder in den Urwald");

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0);

  AddInfo(DEFAULT_INFO, "sagt: Du bist mein naechster Verwandter.\n");
  AddInfo("urwald", "UGGA UGGA...","sagt: ");
  AddInfo("dante", "Dante ist mein Herr und Meister","sagt: ");
AddInfo("tarzen", "Ich Tarzan, Du Jane...","sagt: ");
  SetProp( P_REJECT, ({ REJECT_KEEP,
    "Der Schimpanse laechelt freundlich.\n" }) );


  SetChats(4, ({
  "Der Schimpanse springt froehlich auf und ab.\n",
  "Der Schimpanse kratzt sich am Kopf.\n",
  "Der Schimpanse zieht an Deiner Kleidung.\n",
  "Der Schimpanse zieht an Deinen Haaren.\n",
  "Der Schimpanse furzt.\n",
  "Der Schimpanse macht einen Salto.\n",
  "Der Schimpanse grunzt laut.\n",
  "Der Schimpanse macht einen Purzelbaum.\n",
  "Der Schimpanse will mit Dir spielen.\n",
  "Der Schimpanse schubst Dich.\n",
  "Der Schimpanse macht einen Handstand.\n"}) );
  
  SetAttackChats(20, ({
  "Der Schimpanse beisst Dich..\n",
  "Der Schimpanse kratz Dich.\n",
  "Der Schimpanse beisst Dir in den Arm.\n",
  "Der Schimpanse schlaegt Dich zu Boden.\n",
  "Der Schimpanse spuckt Dich an.\n",
  "Der Schimpanse ruft: Tarzan, hilf mir!\n",
  "Der Schimpanse schreit: UGGA UGGA !!!\n"}) );
  
  SUID;
  CLONEME(OBJ"kokos");
}

