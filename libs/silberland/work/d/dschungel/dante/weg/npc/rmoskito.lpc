
inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <mnpc.h>

#include "../def.h"

create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Riesenmoskito");
  SetProp(P_LONG, 
    "Moskitos sind laestige Insekten des Dschungels. Sie sind ueberall, kommen \n"+
    "ueberall hinein und stechen Dich auch an allen Koerperstellen. Richtige \n"+
    "Quaelgeister, deren laestiges Geraeusch immer und ueberall hier zu hoeren ist.\n"+
    "Dieses Exemplar ist sicher ueber einen Meter gross!!!\n");
    
    
  SetProp(P_NAME, "Riesenmoskito");
  SetProp(P_GENDER, NEUTER);
  AddId(({"moskito","riesenmoskito"}));

  SetProp(P_DIE_MSG, (" wird Dich nie wieder quaelen.\n"));
  SetProp(P_INFO, BS("SSSSSSS......SSSSSSS....."));
  SetChats(10, ({
  "Das Moskito surrt laestig herum.\n",
  "Das Moskito setzt sich auf Deine Nase.\n",
  "Das Moskito laesst sich auf Deiner Hand nieder.\n",
  "Du versuchst das Moskito zu vertreiben.\n",
  "SSSURRR.......SSSURRR......\n",
  "Das Moskito sticht Dich ins Bein.\n",
  "Du schlaegst nach dem Moskito.\n",
  "Das Moskito hat Dein warmes Blut gewittert.\n",
  "Das Moskito saugt begierig Dein Blut.\n",
  "Du denkst Dir 'Der Dschungel ist ein furchtbarer Ort'.\n",
  "SSSSS...SSSSS....SSSSS....\n",
  "AUA!!! Der Stich schmerzt hoellisch!\n"
  }));
  
  create_default_npc(12);
  SetProp(P_HANDS, ({" mit seinem spitzen Stachel",120,DT_POISON}));
  SetProp(P_RACE, "Insekt");
  SetProp(P_SIZE, 100);
  SetProp(P_ALIGN, -100);
  SetProp(P_MAX_HANDS, 6);
  SetProp(P_HEAL,5);
  SetProp(P_AGGRESSIVE, 0.01);
  SetProp(P_WIMPY, 0);
  SetProp(P_RESISTANCE, ({ DT_SLASH,DT_BLUDGEON,DT_RIP,DT_PIERCE })); 
  SetProp(P_VULNERABILITY, ({ DT_WATER }));
   SetProp(P_MNPC_AREA, ("/d/dschungel/"));
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_INDOORS+
  MOV_SPECIAL+MOV_MOVES+MOV_BACKWARDS+MOV_INFIGHT );
  SetProp(P_MNPC_WAIT, ({10, 10, 10}));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "weg6");

  SetProp(P_MSGIN, "surrt herein");
  SetProp(P_MSGOUT, "surrt");
  SetProp(P_MMSGIN, "surrt von oben herab");
  SetProp(P_MMSGOUT, "haut ab");

 
  AddInfo(DEFAULT_INFO, "SSSS....SSS....\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Aber wie soll so ein kleines Insekt das tragen?\n" }) );
 SetProp(P_TRANSPARENT, 0);
 
 
}

die(arg)
{
  if(!random(5))     {
 if(!deep_present("\nimp", TP)) {  	
  if(!deep_present("dmala", TP))  {	
    CLONE(OBJ"dmala", TP);  } }}
    
  ::die(arg);
}

