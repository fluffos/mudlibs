// dante@SilberLand

inherit "std/mnpc";
#include <mnpc.h>   
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "files.h"
#define QUESTKEY "Buckel vor Mini"
#define  BSA(x,y) break_string(x,78,y)      

void create()
{
  object ob;
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Mini, die Minischnecke");
  SetProp(P_LONG, BS(
        "Das ist Mini, eine sehr kleine Schnecke, die hier als Wirtin arbeitet."));
  SetProp(P_NAME, "Mini, die Minischnecke");
  SetProp(P_GENDER, FEMALE);
  AddId(({"minischnecke","schnecke", "mini"}));
  SetProp(P_ARTICLE, 0);
  SetProp(P_RACE, "Schnecke");
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10, T_RANGE_MAX: 45]));
  create_default_npc(8);
  // P_LEVEL   = x
  // P_SP/P_HP = x*8+42       =
  // P_HANDS   = x*10         = 
  // P_BODY    = x*20/3       =  
  // P_XP      = HP*HANDS*5   =   // 1/100 davon als Killbonus
  SetProp(P_HANDS, ({" mit ihrem schleimigen Schwanz",160,DT_ACID}));
  SetProp(P_MAX_HP, 200);
  SetProp(P_BODY, 30);
  //  SetProp(P_XP, QueryProp(P_XP)+y*100); // Bonus fuer Spells
  SetProp(P_SIZE, 50);
  SetProp(P_ALIGN, 300);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);
  set_living_name("mini");
  SetProp(P_NOCORPSE,1);


  AddInfo(({"aufgabe","aufgeben","schluss","aus","ende","selbstmord"}),
      "Wenn Du an der Quest verzweifelst gib einfach <aufgabe> ein! Haben schon "
      "mehrer Spieler vor Dir versagt!!!", "grinst: ");

  SetProp(P_INFO, "Frag sie doch nach Selbstmord!!!");


  SetProp(P_MSGIN, "kriecht herein");
  SetProp(P_MSGOUT, "kriecht");
  SetProp(P_MMSGIN, "kriecht herein");
  SetProp(P_MMSGOUT, "kriecht");


  AddInfo("kneipe",
      "Da lebe und arbeite ich!","sagt: ");
  AddInfo("schnecke",
      "Tja, ich bin eine.", "sagt: ");
  AddInfo("haus",
      "Ich habe eines am Ruecken.","sagt: ");
  AddInfo("tausendfuessler",
      "Zaehl mal seine Beine ab!", "sagt: ");
  AddInfo("dschungel",
      "Da leben wir!", "sagt: ");
  AddInfo("schneckenhaus", 
      "Hmmm, ich hab eines und lebe in einem...","sagt: ");
  AddInfo("kiste",
      "Hmm, ja mit der Kiste habe ich so meine liebe Not.", "sagt: ");
  AddInfo("not",
      "Ich wuerde Hilfe brauchen.","sagt: ");
  AddInfo(({"tisch","tische"}),
      "Naja, eigentlich ist ja hier nur ein Tisch, der Holztisch.",
      "sagt: ");
  AddInfo("holz",
      "Das Holz vom Holztisch ist alt und morsch.","sagt: ");

  AddInfo(({"quest","hilfe"}),
      "Ich wuerde sehr wohl Hilfe gebrauchen koennen. "
      "Siehst Du die Kiste die da steht? Die ist viel zu schwer "
      "fuer mich. Ich versuche schon seit langem sie auf den Holztisch "
      "zu heben, schaffe es aber nicht. Wenn Du mir helfen willst, "
      "dann tipp doch einfach 'hilfmini'. Es soll nicht Dein Schaden sein!",
      "sagt: ");

  SetProp(P_DIE_MSG,  " kriecht sterbend davon um Hilfe zu holen!\n");
  AddInfo("holztisch",
      "Ja, der is alt und wackelig.", "sagt: ");

  AddInfo(DEFAULT_INFO, "sagt: Bestell lieber ne Keule!\n");
  AddInfo("dante", "Dante, hmm, der war mal mein bester Gast.","sagt: ");
  AddInfo("wuschel", "UI! Die hat eine lustige Nase!", "sagt: ");
  SetProp( P_REJECT, ({ REJECT_KEEP,
        "Mini sagt: Danke...\n" }) );

  SetProp(P_SPELLRATE,60);

  AddSpell(3,150,
      "Mini schleimt Dich voll.\n",
      "Mini schleimt @WEN voll.\n",
      DT_ACID,([SP_SHOW_DAMAGE:1]));
  AddSpell(3,250,
      "Mini schleudert Dir Schneckendreck ins Auge.\n",
      "Mini schleudert @WEM Schneckendreck ins Auge.\n",
      DT_POISON,([SP_SHOW_DAMAGE:1]));


  SetChats(2, ({
        "Mini sagt: Was darfs sein?\n",
        "Mini kramt herum.\n",
        "Mini kriecht umher.\n",
        "Mini schleimt herum.\n",
        "Du musterst Mini genau!\n",
        "Mini sagt: Schoener Tag heute...\n",
        "Mini sagt: Trink was!\n",
        "Mini sagt: Probieren Sie unsere Keulen!\n"}));


  SUID;
  CLONEME(ARMOUR"minih");   


  command("zieh alles an");  


  AddCmd("hilfmini", "start");

} 

int start()
{
  object ob;

  /*     
         if(TP->QueryQuest(QUESTKEY)) {
         write(BSA(
         "Aber "+TPN+", was soll das denn nun? Du hast doch bereits "
         "versucht mir zu helfen und warst viel zu schwach! "
         "Ich kann mich noch gut daran "
         "erinnern wie Du jaemmerlich versagt hast. "
         "Sagte ich Dir nicht, "
         "dass Du noch viele Knoedel essen musst um diese Kiste aufheben zu "
         "koennen. Du bist doch der groesste Schwaechling weit und breit!",
         "Mini, die Minischnecke sagt: "));
         return 1;
         }

*/ 
  // die pl sollen button imer wieder bekommen koennen


  if(deep_present("\nminibutton", TP)) {
    write("Aber Du hast doch schon einen Button!\n"); 
    return 1;
  }

  if(present("\nminiquest", TP))  {
    write(BSA(
          "Aber "+TPN+", Du wolltest mir Doch schon helfen. "
          "Hast Du das etwa vergessen!", 
          "Mini, die Minischnecke sagt: "));
    return 1;
  }
  else  {
    write(BSA(
          "Das freut mich sehr, dass Du mir helfen willst die Kiste auf den "
          "Holztisch zu heben. Also los, zeig wie stark Du bist!",
          "Mini, die Minischnecke sagt: "));
    ob=clone_object("/d/dschungel/dante/weg/obj/miniquest");
    ob->move(TP, M_NOCHECK);
    // write_file("/log/quests/mini",
    // dtime(time())+": "+getuid(this_player())+ "beginnt die Quest.\n");
    return 1;
  }
  return 0;
}





void init()
{
  ::init();
  if(interactive(TP)) call_out("hallo",0);
}                


void hallo()
{

  if(environment(TP)!=environment(TO))        return;  

  if(present("\nminiquest", TP)) {
    command("emote sagt: "+TPN+", Du wolltest mir Doch helfen!??!\n");
    return ;
  }
  if(TP->QueryQuest("Hilf Mini, der Minischnecke"))  {
    command
      ("emote lacht: "+TPN+", Du Schwaechling, kennst Du die Kiste noch?!\n");
    return ;
  }
  else 
    command("emote sagt freundlich: "+TP->name(RAW) +", willkommen im Schneckenhaus!\n");
}


die(arg)
{
  object ob;
  ob=clone_object("/d/dschungel/dante/weg/npc/wae.lpc");
  ob->move(environment(TP), M_TPORT);
  ob->Kill(TP);
  ::die(arg);
}


