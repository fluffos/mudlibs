/*
** Ein rattenzahn dante 97 jaenner sl
** (
*/

inherit "std/weapon";

#include <properties.h>     /* Definition der Properties */
#include <combat.h>         /* Definition der kampfspezifischen Konstanten */
#include <language.h>       /* Definition von MALE, FEMALE, WER, ... */

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  AddId (({"zahn", "rattenzahn"}));
  SetProp (P_SHORT, "Ein Rattenzahn");
  SetProp (P_LONG, "Dieser Rattenzahn war wohl einmal die Waffe einer Ratte.\n");
  SetProp (P_NAME, "Rattenzahn");
  SetProp (P_GENDER, MALE);
  SetProp(P_INFO, ("Dieser Zahn ist vergiftet!\n"));
  SetProp (P_VALUE, 300);
  SetProp (P_WEIGHT, 50);
  SetProp (P_WEAPON_TYPE, WT_KNIFE);
  SetProp (P_DAM_TYPE,({DT_PIERCE,DT_POISON}));
  SetProp (P_WC, 70);
  SetProp (P_NR_HANDS, 1);
  SetProp (P_MATERIAL, MAT_HORN);
}
