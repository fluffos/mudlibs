//peitscjhe fuer gnom by dante

inherit "std/weapon";

#include <properties.h>     // Properties definieren 
#include <combat.h>         // Kampfspezifische Daten        		
#include <language.h>       // Definition von MALE, FEMALE, NEUTER, WER, ...
#include <new_skills.h>

#include "files.h"


create()
{
  
  if (!is_clone(TO)) return;
  ::create();
  
  AddId (({"peitsche", "gnompeitsche"}));       // IDs
  SetProp(P_SHORT, "Eine Gnompeitsche");    //Kurzbeschreibung
  SetProp(P_LONG, BS(
  "Diese Peitsche gehoerte einst einem boesen Gnom. Sie ist gaenzlich aus "
  "Leder. Nur der Griff ist aus Metall"));
  AddDetail("griff",
  "Der Griff ist kurz und aus Metall.");
  AddDetail("metall",
  "Hmm, keine Ahnung.");             
  AddDetail(({"leder"}), 
  "Hartes gutes Hobbitleder!\n");
  SetProp(P_INFO, "Die Gnompeitsche macht Terrorschaden!\n");
  SetProp (P_NAME, "Gnompeitsche"); 
  SetProp (P_GENDER, FEMALE);  
  SetProp (P_VALUE, 600+random(101)); 
  SetProp (P_WEIGHT, 500); 
  SetProp (P_MAGIC, 0);
  SetProp (P_WEAPON_TYPE, WT_WHIP);
  SetProp (P_DAM_TYPE, ({DT_WHIP, DT_TERROR})); 
  SetProp (P_NOBUY, 1);
  SetProp (P_WC, 180);
  SetProp (P_WC_FIX, 20);
  SetProp (P_NR_HANDS, 1);
  SetProp (P_MATERIAL, ([MAT_SKIN:50, MAT_STEEL: 10]));
  SetProp (P_KILL_NAME, "Eine Gnompeitsche"); 
  SetProp (P_WIELD_RESTRICTIONS, ([A_STR: 10]));
  SetProp (P_WC_BONUS, (["NPC":100]));

}
