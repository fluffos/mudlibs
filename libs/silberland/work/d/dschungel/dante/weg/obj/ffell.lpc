// Vampirwolffell.....
// dante sl 97 jaaen danke feyaria

#include "/players/dante/myowndefine.h"

//inherit "std/armour";
inherit "std/unit";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein Flaffenfell");
  SetProp(P_LONG, BS(
"Du siehst nun ein Fell aus Flaffenhaut. Angeblich kann man aus "
"vielen solcher Fellen etwas sehr Gutes machen, aber wie?!"));
     AddSingularId("fell");
  AddPluralId("felle");
  AddSingularId("flaffenfell");
  AddPluralId("flaffenfelle");
  SetCoinsPerUnits(10,1);
  SetGramsPerUnits(1,10);

    
    
    
    SP(P_INFO, BS(
    "Mit 100 Flaffenfellen kann man mit dem Kommando "
    "<flaffenzauber> etwas Gutes erzeugen. Etwas sehr Gutes!"));
    
  SetProp(P_NAME, ({"Flaffenfell", "Flaffenfelle"}));
  SetProp(P_GENDER, NEUTER);
  SetProp(P_NOBUY, 1);
  SetProp(P_MATERIAL, ([MAT_PELT:100]) );
}

