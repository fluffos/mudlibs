// Februar 1997 nicht ganz ernst zu nehmen.......
//erweiter mit jojogeist sehr schwacher npc!

inherit "std/thing";
#include "files.h"
#include <properties.h>
#include <language.h>
#include <moving.h>

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT,"Ein buntes Jojo");
  SetProp(P_LONG,"Das Jojo glitztert in vielen Farben und fordert Dich direkt "
      "zum spielen auf. Es gibt folgende Moeglichkeiten: spiele, wirf, schleudere, "
      "rolle, hoch, beine, artist, wahnsinn, suizid, amok.");
  AddId(({"jojo"}));
  SetProp(P_NAME,"Jojo");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 200);
  SetProp(P_MATERIAL,MAT_METAL,MAT_WOOD);
  SetProp(P_INFO, ("Frueher war das Jojo eine Waffe und sein Namen heisst soviel wie 'Komm-Komm'. ")); 
  SetProp(P_SMELL, ("Das Jojo riecht nach Bananen.\n"));
  SetProp(P_SOUND, ("Das Jojo fluestert Dir zu: Spiel mit mir..."));

  AddCmd(({"spiele","spiele"}), "spielen");
  AddCmd(({"wirf","werfe"}), "werfen"); 
  AddCmd(({"schleuder","schleudere"}), "schleudern");
  AddCmd(({"rolle","rollen"}), "rollen");
  AddCmd(({"hoch"}),"hoch");
  AddCmd(({"beine"}), "beine");
  AddCmd(({"artist"}),"artist");
  AddCmd(({"wahnsinn"}), "wahnsinn");
  AddCmd(({"suizid"}),"suizid");
  AddCmd(({"amok"}),"amok");

}

int spielen(string str)
{
  notify_fail ("Womit willst Du spielen ?\n");
  if ( !str ) return 0;
  if ( member( ({"jojo", "mit jojo"}),str) !=-1 )
  {
    write(" \n"
        "Du laesst das Jojo langsam nach unten laufen und holst es mit einer \n"
        "geschickten Bewegung aus dem Handgelenk wieder nach oben.\n");
    say (""+TPN+" laesst das Jojo langsam nach unten laufen und holt es mit einer \n"
        "geschickten Bewegung aus dem Handgelenk wieder nach oben.\n"); 
    return 1;
  }
  return 0;
}


int amok(string str)
{
  notify_fail ("Womit willst Du spielen ?\n");
  if ( !str ) return 0;
  if ( member( ({"jojo", "mit jojo"}),str) !=-1 )
  {
    write(" \n"+BS(
        "Du bekommst einen irren Blick, schnaubst wild, Deine Augen gluehen rot und "
        "Du\nbeginnst das Jojo wild im Raum herumzuschleudern. Du drehst Dich dabei "
        "wie ein\nDerwisch im Kreis und Dir wird schwindlig und Du geraetst in leichte Trance.\n"
        "WUMMM! Das Jojo knallt Dir voll auf den Kopf. Schnell beruhigst Du "
        "Dich wieder.\nAua, das tat weh!\n"));
    TP->do_damage(3);
    say(bs(""+TPN+" schaut Dich irr an, schnaubt wild, "+TPN+"'s Augen gluehen "
        "und ploetzlich beginnt "+TPN+" wie wahnsinnig das Jojo im Raum herumzuschleudern. "
        ""+TPN+" dreht sich dabei wie ein Derwisch im Kreis und stoesst seltsame Laute "
        "aus. WUMMMM!!! Das Jojo knallt "+TPN+" voll gegen den Kopf und bringt "+TPN+""
        " wieder zur Besinnung!"));
    return 1;
  }
  return 0;
}

