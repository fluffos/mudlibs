int suizid(string str)
{
  object ob;
  object ob2;

  notify_fail ("Womit willst Du spielen ?\n");
  if ( !str ) return 0;
  if ( member( ({"jojo", "mit jojo"}),str) !=-1 )
  {
    if(present("jojogeist", environment(TP)) )
    {
      write(BS("Ein starrst das Jojo an und ploetzlich wird Dir bewusst, dass "
          "hier ja ein lebendiger Jojogeist ist (Wenn man bei einem Geist "
          "von lebendig sprechen kann."));
      return 1;
    }

    write(" \n"+BS(
        "Du starrst das Jojo an und ploetzlich glaubst Du in ihm einen Feind zu erkennen."
        "Ein boesartiger Jojogeist scheint Dich frech anzugrinsen, und dass kannst Du\n"
        "Dir natuerlich nicht gefallen lassen. Du beginnst wie wild auf das Jojo "
        "einzupruegeln, als das Jojo ploetzlich waechst und waechst und ploetzlich...\n"));

    say(""+TPN+" starrt das Jojo an und ploetzlich scheint sich das Jojo zu veraendern.\n"
        "Das Jojo grinst "+TPN+" frech an und auf einmal...\n");
//    if( allowed_environment(environment(TP)) )
  //  {
    
      ob=clone_object("/d/dschungel/dante/weg/npc/jojog");
      ob->move(environment(TP), M_TPORT);
      ob2=clone_object("/d/dschungel/dante/weg/obj/attjo");
      ob2->move(TP, M_NOCHECK);  
      call_out("weg", 0);
      TP->AddPursuer(ob);
      ob->registerOwner(this_player()->name());
      remove(); 
    //}
    
    
    /*else
    
    {
      tell_room(environment(TP), "...der Jojogeist erscheint, zeigt Dir die "
          "Zunge und verschwindet sofort wieder.\n");
    }
    */
    
    
    return 1;
  }
  return 0;
}

//jojo muss weg

weg()
{
  object ob;
  if(ob=present("jojo", TP))   
  {
    ob->remove();
  }
}


int werfen(string str)
{
  notify_fail ("Was willst Du werfen ?\n");
  if ( !str ) return 0;
  if ( member( ({"jojo", "mit jojo"}),str) !=-1 )
  {
    write(" \n"
        "Du wirfst das Jojo mit einem Ruck, es laeuft schnell an der Schnur nach\n"
        "vorne und kommt blitzartig wieder zu Dir zurueck.\n");
    say (""+TPN+" wirft das Jojo mit einem Ruck. Das Jojo laeuft schnell nach vorne \n"
        "und kommt ebenso schnell zu "+TPN+" zurueck.\n"); 
    return 1;
  }
  return 0;
}

int schleudern(string str)
{
  notify_fail ("Was willst Du schleudern ?\n");
  if ( !str ) return 0;
  if ( member( ({"jojo"}),str) !=-1 )
  {
    write(" \n"
        "Du schleuderst das Jojo kraeftig von Dir, es rast an der Schnur abwaerts\n"
        "und zischt wieder zu Dir zurueck.\n");
    say (""+TPN+" schleudert das Jojo kraeftig von sich. Das Jojo rast an der\n"
        "Schnur nach unten und kehrt ebenso schnell wieder zu "+TPN+" zurueck.\n"); 
    return 1;
  }
  return 0;
}
int rollen (string str)
{
  notify_fail ("Was willst Du rollen ?\n");
  if ( !str ) return 0;
  if ( member( ({"jojo"}),str) !=-1 )
  {
    write(" \n"
        "Mit einer coolen Handbewegung laesst Du das Jojo nach unten rollen. Es bleibt \n"
        "kurz stehen, kommt aber wie durch Geisterhand bewegt wieder zu zurueck.\n");
    say (""+TPN+" laesst das Jojo mit einer coolen Handbewegung nach unten rollen.\n"
        "Das Jojo bleibt kurz stehen, rollt aber dann wieder zu "+TPN+" zurueck.\n"); 
    return 1;
  }
  return 0;
}
int hoch(string str)
{
  notify_fail ("Was willst Du hoch ueber Deinen Kopf werfen ?\n");
  if ( !str ) return 0;
  if ( member( ({"jojo"}),str) !=-1 )
  {
    write(" \n"
        "Du laesst das Jojo senkrecht ueber Deinen Kopf in die Luft sausen \n"
        "und faengst es im Fallen laessig wieder ab.\n");
    say (""+TPN+" laesst das Jojo senkrecht ueber dem Kopf in die Luft sausen \n"
        "und faengt es im Fallen laessig wieder ab.\n"); 
    return 1;
  }
  return 0;
}

int beine(string str)
{
  notify_fail ("Was soll durch Deine Beine sausen?\n");
  if ( !str ) return 0;
  if ( member( ({"jojo"}),str) !=-1 )
  {
    write(" \n"
        "Du schleuderst das Jojo rueckwaerts durch Deine Beine, es rast nach \n"
        "hinten und kehrt sausend wieder zu Dir zurueck.\n");
    say (""+TPN+" schleudert das Jojo rueckwaerts durch die Beine, das Jojo \n"
        "rast nach hinten, kehrt zurueck und "+TPN+" faengt es mit einem Grinsen\n"
        "Du bist beindruckt von "+TPN+"!\n"); 
    return 1;
  }
  return 0;
}
int artist(string str)
{
  notify_fail ("Was soll artistisch sein ?\n");
  if ( !str ) return 0;
  if ( member( ({"jojo"}),str) !=-1 )
  {
    write(" \n"
        "Du machst einen einhaendigen Handstand und wirfst das Jojo laessig zur \n"
        "Seite. Das Jojo schnellt davon, kehrt rasend zurueck und Du faengst es \n"
        "ohne hinzuschauen.\n");
    say (""+TPN+" macht einen einhaendigen Handstand, wirft das Jojo laessig \n"
        "zur Seite und faengt es wieder ohne hinzuschauen.\n"
        "Du applaudierst "+TPN+" laut.\n");
    return 1;
  }
  return 0;
}

int wahnsinn(string str)
{
  notify_fail ("Was soll hier wahnsinnig sein ?\n");
  if ( !str ) return 0;
  if ( member( ({"jojo"}),str) !=-1 )
  {
    write(" \n"
        "Du machst einen Rueckwaertssalto, schleuderst das Jojo wild von Dir \n"
        "und faengst es waehrend Du im Spagat landest.\n");
    say (""+TPN+" macht einen Rueckwaertssalto, schleudert das Jojo wild in\n"
        "in die Luft und faengt es waerend "+TPN+" im Spagat landet.\n"
        "Du kniest vor Begeisterung nieder und kuesst "+TPN+" die Fuesse.\n");
    return 1;
  }
  return 0;
}

