//kraut fuer fippsi
inherit "std/food";

#include <properties.h>
#include <food.h>
#include "/players/dante/myowndefine.h"

create()
{
  if (!is_clone(ME)) return;
  ::create();
  SetProp (P_SHORT, "Ein Daemonenkraut");
  SetProp (P_LONG, BS(
  "Warum dieses unscheinbare Kraut Daemonenkraut heisst, weiss keiner. "
  "Man schreibt ihm die Faehigkeit zu sich so zu erkennen, wie man "
  "wirklich ist. Doch auch das ist umstritten..."));
  SetProp (P_NAME, "Daemonenkraut");
  SetProp (P_GENDER, NEUTER);
  SetProp (P_VALUE, 100);
  SetProp (P_WEIGHT, 10);
  SetProp(P_SIZE, 10);
  SetProp (P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  SP(P_INFO, "Das Daemonenkraut solltest Du Fippsi geben!\n");
  AddId (({"kraut","daemonenkraut","\nfippsikraut"}));
  SetProp (P_FOOD_INFO, ([F_HEAL: 0, F_SOAK: 0, F_ALCOHOL: 0, F_POISON: 0]));
}

BeimEssen()
{
write ("Du isst das Daemonenkraut, doch passieren tut nichts.\n");
say (TPN+" isst das Daemonenkraut auf.\n");
return ::BeimEssen();  
}


