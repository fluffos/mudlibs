/* eine leckere banane
**
** 
** 
*/

inherit "std/food";

#include <properties.h>
#include <food.h>
#include "files.h"

create()
{
  if (!is_clone(ME)) return;
  ::create();
  SetProp (P_SHORT, "Eine Banane");
  SetProp (P_LONG, "Eine schoene, reife Banane aus dem Dschungel.\n");
  SetProp (P_NAME, "Banane");
  SetProp (P_GENDER, FEMALE);
  AddId (({"banane", "frucht","\nplantangenfrucht"}));
  SetProp (P_INFO, ("Die Banane schmeckt sicherlich gut..."));
  SetProp (P_VALUE, 100);
  SetProp (P_WEIGHT, 100);
  SetProp (P_NOBUY, 0);
  SetProp (P_MATERIAL, MAT_FOOD);
  SetProp (P_FOOD_INFO, ([F_HEAL: 10, F_SOAK: 3, F_ALCOHOL: 0, F_POISON:0]));
}

BeimEssen()
{
  write ("Du isst die Banane mit affenartigem Grinsen.\n");
  say (TPN+" verspeisst die Banane und grinst wie ein Affe.\n");
  return ::BeimEssen();
}
