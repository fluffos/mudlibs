//sabberlatz, questbelohnung fuer omelettquest,
//senkt P_FOOD pro reset um 20-30 runter
//dante sl 98

inherit "std/armour";

#include <food.h>
#include <properties.h>
#include <combat.h>
#include <language.h>

#include "/players/dante/myowndefine.h"

int soak=1;

create()
{
  if (!is_clone(this_object()))
    return;
  ::create();

  AddId (({"latz","sabberlatz", "sabber-latz","SAB"}));
  SetProp (P_SHORT, "Ein Sabberlatz");
  SetProp (P_LONG,BS(
        "Das ist Dein Sabberlatz. Der Waechter des Dschungels, hat ihn Dir "
        "als Dank, fuer das Omelett geschenkt. Besonders aufregend sieht er nicht "
        "aus. Der grobe, weisse Stoff, weist schon einige Schmutzflecke auf. "
        "Nur eine kleine Stickerei verziert den sonst voellig schmucklosen "
        "Sabberlatz."));

  AD("stoff",
      "Grobe, ehemals weisse Baumwolle.");
  AD(({"wolle","baumwolle"}),
      "Die Baumwolle stammt angeblich aus dem Dschungel.");
  AD(({"fleck","flecke","schmutz","schmutzflecke","schmutzfleck"}),
      "Die Schmutzflecke stammen sicher vom sabbern...");
  ASD("stickerei","latz_gag");



  SP(P_INFO,BS(
        "Der Sabberlatz kann Dir gute Dienste erweisen. Sabber doch einfach "
        "mal in den Sabberlatz...\n"));

  SetProp (P_NAME, "Sabberlatz");
  SetProp (P_GENDER, MALE);
  SetProp (P_WEIGHT, 30);
  SetProp (P_VALUE, 5000);
  SetProp (P_NOBUY, 1);
  SetProp (P_ARMOUR_TYPE, AT_MISC);
  SetProp (P_AC, 0);
  SetProp (P_MATERIAL, ([MAT_MAGIC: 10,MAT_COTTON:80,MAT_FOOD:10]));
  SetProp(P_NODROP, 
      "Aber Du willst doch Deinen Sabberlatz nicht wegwerfen!\n");
  SetProp(P_NOSELL, 
      "Nein! Dein Sabberlatz trennt sich nicht von Dir!\n");
  SP(P_NEVERDROP, 
      "Nein! Dein Sabberlatz trennt sich nicht von Dir!\n");
  ACD(({"sabber", "sabbere"}), "do_soak");
 SP(P_NO_DAMAGE_DESTRUCT, 1);
 
}

string latz_gag()
{ 
  write("\n"
      "+-----------------------------------------------+\n"
      "|                                               |\n"
      "|  "+sprintf("%-43s","Fuer "+CAP(getuid(TP))+", Mammis suessen Liebling !")+"  |\n"
      "|                                               |\n"
      "|                                               |\n"
      "|  Damit Du Dich nicht zuviel ansabberst !      |\n"
      "|                                               |\n"
      "+-----------------------------------------------+\n");
  return "";
}



int do_soak(string str)
{
  NF("Wo willst Du hineinsabbern?\n");

  if(str=="in latz"||str=="in sabberlatz")
  {  

    if(!TO->QueryWorn())
    {
      write("Du musst den Sabberlatz erst anziehen!\n");
      return 1;
    }
    else 

      if(soak==0 || TP->QueryProp(P_FOOD) < TP->QueryProp(P_MAX_FOOD)/2 )

      {
        write("Du sabberst in den Sabberlatz.\n"
            "Du ekelst Dich ein wenig vor Dir selbst, sonst passiert aber nichts!\n");
        say(CAP_TPN+" sabbert in einen Sabberlatz. Eklig!!!\n");
        return 1;
      }
    if(soak)
    {
      TP->SetProp(P_FOOD, TP->QueryProp(P_FOOD)-20-random(30));
      write("Du sabberst in den Sabberlatz.\n"
          "Ploetzlich rumort es in Deinem Magen und Du fuehlst Dich etwas leichter.\n");
      say(CAP_TPN+" sabbert in einen Sabberlatz.\n");
      soak=0;
      return 1;
    }
    return 0;
  }
  return 0;
}

reset(){
  ::reset();

  if(QueryProp(P_WORN) && soak==0)  
  {
    soak=1;  
    tell_object(QueryProp(P_WORN),"Der Sabberlatz sabbert ploetzlich sehr laut.\n");
  }
}
