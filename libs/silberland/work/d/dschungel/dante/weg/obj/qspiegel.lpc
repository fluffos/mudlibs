//questbelohnung ehern gag

inherit "std/thing";

#include <properties.h>
#include "/players/dante/myowndefine.h"
#include <new_skills.h>
#include <mnpc.h>

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp (P_SHORT, "Ein alter, dreckiger Spiegel");
  SetProp (P_LONG,BS (
    "Dieser Spiegel ist alt und zerbrochen. Er ist dreckverschmiert und "
      "sein Spiegelbild kann man darin schon gar nicht erkennen."));
      
      
   AD(({"bild","spiegelbild"}),
   "Nein, so kann man nichts erkennen!");   
  SetProp (P_NAME, "Spiegel");
  SP(P_NAME_ADJ, ({"alt", "dreckig"}));
  SetProp (P_GENDER, MALE);
  SetProp (P_VALUE, 10000);
  SetProp (P_WEIGHT, 50);
  SetProp (P_NOBUY, 1);
  SP(P_INFO, 
  "Dieser Spiegel kann Dir einiges ueber Dich sagen:\n"
  "Der Befehl dazu ist <hcinibrew>.\n");   
  SetProp (P_NEVERDROP, 1);
  SetProp(P_AUTOLOADOBJ, 1);
  AddId (({"spiegel", "spiegel der wahrheit", "\nspiegel"}));
SetProp(P_MATERIAL, ([MAT_GOLD:90, MAT_MISC_MAGIC:10]));
 AddCmd("hcinibrew", "spass");       
 SetProp(P_NODROP, 1);   
}

   spass()
        {
             int mp,age,sek,min,h, d, rand;
            string gild, sex;
            gild=TP->QueryProp(P_GUILD);
            age=TP->QueryProp(P_AGE);
  sek=age*2;    
   min=sek/60;
          h=min/60;
                 d=h/24;
   rand=200+random(800);
   sex=TP->QueryGenderString();
   mp=TP->QueryProp(P_SP);
   
   if(mp<10) {
        write
  ("Du kannst Dein Spiegelbild nicht erkennen!\n");
    return 1;  }
 else
 {
 write("Der Spiegel blitzt auf und ploetzlich erkennst Du etwas:\n"
 "Dein Name ist "+CAP_TPN+", was ein eher haesslicher Name ist.\n"
 "Dein Alter ist "+sek+" Sekunden, oder "+min+" Minuten, oder "+h+" Stunden.\n"
 "Mit anderen Worten bist Du "+d+" Tage alt.\n"
 "Dein Geschlecht ist "+(sex)+", was Dich schon immer stoerte.\n"
 "Du bist "+capitalize(gild)+" und das heisst Du bist ein Jammerlappen.\n"
"Dein Gildenlevel ist "+TP->QueryProp(P_GUILD_LEVEL)+"! Bloeder Anfaenger!\n"
"Du bist ein "+TP->QueryProp(P_RACE)+" und die stinken alle!\n"
"Du hast den Level "+TP->QueryProp(P_LEVEL)+", worueber Du heulen koenntest.\n"
"Im Moment bist Du "+TP->QueryProp(P_ALIGN_STRING)+", wofuer Du Dich sehr schaemst.\n"
"Deine Kraft ist "+TP->QueryAttribute(A_STR)+", was einer besoffenen Ameise entspricht.\n"
"Deine Geschicklichkeit ist "+TP->QueryAttribute(A_DEX)+", was Dich zum "
"Tolpatsch macht.\n"
"Deine maximale Ausdauer ist "+TP->QueryProp(P_MAX_HP)+", was einem "
"Lungenkranken entspricht.\n"
"Deine momentane Ausdauer ist "+TP->QueryProp(P_HP)+"; ein Froschhieb wuerde "
"Dich umlegen.\n"
"Deine maximale Magie ist "+TP->QueryProp(P_MAX_SP)+", was der Magie einer "
"Semmel entspricht.\n"
"Deine momentane Magie ist "+TP->QueryProp(P_SP)+", und das reicht kaum fuer "
"eine Fackel.\n"
 "Deine Erfahrung liegt bei "+TP->QueryProp(P_XP)+", was ja fast NULL ist.\n"
  "Bei nur "+TP->QueryProp(P_WIMPY)+" Punkten, machst Du Dir in die Hosen und "
  "haust ab!\n"
   "Deine Abenteuerpunkte liegen bei "+TP->QueryProp(P_QP)+", was bedeutet, "
    "dass Du niemals in Deinem Leben, "
    "welches Du schon "+TP->QueryProp(P_DEADS)+" mal ausgehaucht "
     "hast, aus Midas rausgekommen bist.\n"
      "Du siehst nicht, dass Du schon "+rand+" Forscherpunkte hast.\n"
      "Im Grossen und Ganzen bist Du ein jaemmerlicher Versager!\n");
       TP->restore_spell_points(-5);                    
       return 1;
       }
   return 0;
   }
       
