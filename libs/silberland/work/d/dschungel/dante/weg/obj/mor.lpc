//ne dooofe krankheit

inherit "std/thing";

#include <properties.h>
#include <moving.h>
#include "/players/dante/myowndefine.h"
#define TIME 30


int i, x, y, z;
object *inv;
object ding;
string *liste;
string *text;
string *listewaf;
string *listerue;
string *definitiv;
string *wahn;


create()
{

  ::create();
  if (!is_clone(this_object())) return;
  SetProp(P_NAME, 0);
  SetProp(P_SHORT, 0);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_NODROP, 1);
  AddId (({"MORB",}));
  call_out("washamma", TIME*5);

  SetProp(P_WEIGHT, 0);

  liste=({
      "Hallo!\n",
      "Du bist doch nur ein Feigling!\n",
      "Du kleine Ratte!\n",
      "Selbstloeschung!!!\n",
      "Dein Password ist ja zu leicht!\n",
      "Es ist 34Uhr Rot!\n",
      "In Deinem Inventory gefaellt es mir gut!\n",
      "Verkauf mich!\n",
      "Dein Inventory wurde soeben geloescht!\n",
      "Hau mich endlich weg!\n",
      "Verwende mich doch endlich!\n",
      "Verkauf mich bitte nicht!\n",
      "Wie gehts?!\n"});

  text=({
      "sagt ploetzlich zu Dir",
      "sagt auf einmal zu Dir",
      "spricht zu Dir",
      "sagt",
      "spricht",
      "redet",
      "murmelt",
      "bruellt",
      "schreit",
      "fluestert",
      "stottert",
      "labbert herum"});

  listewaf=({
      "Ha, Deine Feinde haben Angst vor mir!\n",
      "Ich erschlage alle Deine Feinde!\n",
      "Ich bin die mieseste Waffe im Silberland!\n",
      "Waffen aller Laender vereinigt Euch!\n",
      "Reparier mich bitte!\n",
      "Ich will Blut sehen!\n",
      "Ich werde Deinen Kopf abtrennen.\n",
      "Ich bin doch eine viel zu gute Waffe fuer Dich!\n"});

  listerue=({
      "Ich sehe wirklich gut an Dir aus!\n",
      "Ich bin wohl eine Nummer zu gross fuer Dich.\n",
      "Ich bin vier Nummern zu klein fuer Dich.\n",
      "Du solltest mich wiedermal richtig waschen!\n",
      "Ich bin eine wirklich gute Ruestung.\n",
      "Bitte verkauf mich nicht!\n",
      "Bitte verkauf mich um eine Muenze, Du Depp!\n",
      "Eigentlich passe ich Dir recht gut!\n"});

  wahn=({
      "Was ist nur mit Dir los?!\n",
      "Bin ich nun total verrueckt?!\n",
      "Was geht da nur vor sich?!\n",
      "Ich sollte wohl noch mehr mudden!\n",
      "Bin ich wahnsinnig?!\n",
      "Mein Inventory spricht zu mir?!?!\n",
      "Waren Drogen in meinem Essen?!\n",
      "Hallo hier ist Dein Hirn!\n",
      "Ein Jojogeist teilt Dir mit: Na, Du, wie gehts?\n",
      "Der Boden unter Dir geht auf und Du siehst rosa Elefanten!\n",
      "Ein gefluegeltes Nashorn spielt Trompete!\n",
      "Kleine Molche kommen aus Deinem Mund und begruessen Dich herzlich!\n",
      "Deine Hand wird warm und dann ein Broetchen!\n",
      "2+2=5 oder wie man verrueckt wird durch mudden...\n",
      "Hanswurst spielt mit Deiner Leber Tischtennis.\n",
      "Saetze sind Bananen und Bananen lieben Mozart!\n",
      "Bunte Steine singen Choraele fuer Deine Zehen!\n",
      "Tische tanzen Tago tagsueber teilweise testmaessig.\n",
      "Organische Olme winken Dir froehlich zu.\n",
      "Panzerlibellen stricken Wege aus Elfenbein.\n"});



}

reset()  {
  ::reset();
  if(!ENV(ME)) {
    remove();
    return;
  }
  if(present("MORB 2", MENV) || !query_once_interactive(MENV) )
    call_out("remove",0); 
}


void init()
{
  ::init();
  if(present("MORB 2", MENV) || !query_once_interactive(MENV) )
    call_out("remove",0);
}


washamma()  {


  if(environment() && interactive(environment() ) ) {	
    inv=all_inventory(environment());

    if(!sizeof(inv))  { call_out("washamma", TIME); }
    i=random(sizeof(inv));
    z=random(sizeof(wahn));

    y=random(sizeof(text));

    // write(inv[i]->name()+"\n");
    // write(liste[x]+"\n");

    if(!random(8)) {
      tell_object(environment(),
          wahn[z] );
      call_out("washamma", TIME);
      return;
    }

    if( inv[i]->QP(P_INVIS)!=1 && 
        !inv[i]->TO &&
        inv[i]->name()!= 0 &&
        strlen(inv[i]->QP(P_SHORT)) < 15 &&
        inv[i]->QP(P_SHORT)!=0 ) {

      if(inv[i]->QP(P_ARMOUR_TYPE ) ) {
        definitiv=listerue;
      }  
      if(inv[i]->QP(P_WEAPON_TYPE) ) {
        definitiv=listewaf; } 

      if(!inv[i]->QP(P_ARMOUR_TYPE ) && !inv[i]->QP(P_WEAPON_TYPE) ) {
        definitiv=liste; }   

      x=random(sizeof(definitiv));

      //write(file_name(inv[i])+"\n");

      if(inv[i]->IsUnit() && inv[i]->QP(P_AMOUNT) > 1 ) {



        tell_object(environment(TO),BSA(
              definitiv[x],
              inv[i]->Name()+" sagen: "));
        call_out("washamma", TIME);
        return;
      }

      tell_object(environment(TO),BSA(
            definitiv[x],
            inv[i]->QP(P_SHORT)+" "+text[y]+": "));

      call_out("washamma", TIME);
      return;

    }  call_out("washamma", TIME);
    return;}  call_out("washamma", TIME); 
    return; }






