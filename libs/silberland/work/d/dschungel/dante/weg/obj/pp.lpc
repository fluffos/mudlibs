inherit "std/thing";

#include <properties.h>



create()
{
  ::create();
  if (!is_clone(this_object())) return;
  SetProp (P_IDS, ({"\nohnmacht"}));
  SetProp (P_SHORT, 0);
  SetProp (P_NAME, 0);
  SetProp (P_NEVERDROP, 1);
  SetProp (P_NODROP, 1);
  SetProp (P_WEIGHT, 0);
  call_out ("remove", 10);
  AddCmd ("", "no", 1);
 
}

int no()
{
  write ("Aber Du bist doch ohnmaechtig!\n");
  return 1;
}

