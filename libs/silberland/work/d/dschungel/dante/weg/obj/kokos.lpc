// kokosnuss
// Februar 1997 nicht ganz ernst zu nehmen.......

inherit "std/food";
#include <food.h>
#include "files.h"
#include <properties.h>
#include <language.h>
#define textlist ({ "Die Milch in der Kokosnuss plaetschert leise.\n", \
 "Du wuerdest die Kokosnuss so gerne einem Magier an den Kopf werfen.\n", \
 "Die Kokosnuss fluestert Dir zu: Iss mich, iss mich...\n", \
 "Wirf doch endlich die Kokosnuss auf einen Spieler.\n", \
 "Die Kokosnuss sagt: Dein Kopf ist ja hohler als ne Nuss!\n", \
 "Seltsam, aber hat die Kokosnuss nicht eben gesprochen ?\n", \
                 });
 string *text;
 string str;
 string cstr;  

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  text=textlist;
  SetProp(P_SHORT,"Eine grosse runde Kokosnuss");
  SetProp(P_LONG,"Eine grosse Kokosnuss aus Dantes Dschungel. Man kann sie auf "
  "andere Spieler und Magier werfen, und auch sonst ist sie sehr eigenartig...");
  AddId(({"kokosnuss","nuss"}));
  SetProp(P_NAME,"Kokosnuss");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 100);
  SetProp(P_MATERIAL,MAT_FOOD);
  SetProp(P_INFO, ("Diese Kokosnuss enthaelt leckere Milch.\n")); 
  SetProp(P_FOOD_INFO, ([F_HEAL: 15, F_SOAK: 3, F_ALCOHOL: 0, F_POISON:0,
     F_MSG: "Du trinkst isst die Kokosnuss auf.\n",
     F_MSG_ROOM: " isst eine Kokosnuss auf.\n"
      ]));		   
  SetProp(P_SMELL, ("Die Kokosnuss duftet wunderbar nach Dschungel und suesser Milch.\n"));

  call_out("sprechen",60+random(30));
  AddCmd("wirf", "throw_it");
  AddCmd("ww", "ww");
}  

void sprechen() 
{
  string thistext;
  thistext = text [ random(sizeof(text)) ];
  if(living(environment()))
    tell_object(environment(), thistext);
  else
    tell_room(environment(), thistext);
  call_out("sprechen",60+random(30)); 
}

 
remove()
 {
   while (remove_call_out("sprechen") != -1);
   return ::remove();
 }



BeimEssen()
{
  write (BS("Du bohrst ein Loch in die harte Schale der Kokosnuss und trinkst "
  "mit einem Schluck die gesamte Milch. Dann stellst Du mit Erstaunen fest, dass "
  "die Kokosnuss sich in Luft aufloest."));
  say( BS(TPN+" bohrt ein Loch in eine Kokosnuss und trinkt die ganze leckere "
        "Milch mit einem Schluck weg."));
  return ::BeimEssen();
}

int throw_it(string str)
{
  int treffer;
  string victim_name,werfer_name;
  string victim_string,werfer_string;
  string was,at,wen;
  int fehler;
  object victim;

  if (!str) return 0;
  fehler = 0;
  if (sscanf(str,"%s %s %s",was,at,wen) != 3)
    fehler = 1;
  if (!id(was) || at != "nach")
    fehler = 1;
  if (fehler)
  { notify_fail("Zum Werfen: wirf Kokosnuss nach <spielername>\n");
    return 0;
  }
  victim = find_living(wen);
  if (!victim || !present(victim,environment(this_player())))
    { write("Du scheinst Dschungelfieber zu haben, den dieser Spieler ist hier nicht anwesend.\n");                                
      return 1;                                                                                                                                                                                      
    }                                                                           
  victim_name = capitalize(victim->name());
  werfer_name = capitalize(this_player()->query_real_name());
  treffer = random(5);
  write("Du schmeisst die Kokosnuss " + victim_name +".\n");
  say(werfer_name + " wirft die Kokosnuss nach " + victim_name + ".\n");
  if (treffer==0)
  {
    werfer_string = "Die Kokosnuss fliegt an " + victim_name + " vorbei.\n";
    victim_string = werfer_name + " trifft Dich nicht.\n";
    this_object()->move(environment(this_player()));
  }
  if (treffer==1)
  {
    werfer_string = "Die Kokosnuss zerplatzt an " + victim_name + "'s Koerper und besudelt die gesamte Kleidung mit Milch.\n";
    victim_string = "Die Kokosnuss  zerbricht an Deinem Koerper, und die Milch verteilt sich af Deiner Kleidung.\n";
  }
  if (treffer==2)
  {
    werfer_string = "WOMMM! Du triffst " + victim_name + " mitten ins Gesicht.\n";
    victim_string = "WOMMM! Die Kokosnuss trifft Dich mitten im Gesicht!\n";
  }
  if (treffer==3)
  {
    werfer_string = "WOMMM! Die Kokosnuss trifft " + victim_name + "'s Nase mit voller Wucht - AUA!\n";
    victim_string = "WOMMM! Die Kokosnuss fliegt mit voller Wucht gegen Deine Nase - AUA!!!\n";
  }
  if (treffer==4)
  { 
    werfer_string = victim_name + " versucht zu fluechten, und kriegt dabei die Kokosnuss mitten auf den Hinterkopf - AUA!!!\n";
    victim_string = "Du versuchst zu fluechten, und kriegst die Kokosnuss dabei mitten auf den Hinterkopf - AUA!!!\n";
  }
  write(werfer_string);
  tell_object(victim,victim_string);
  
  if (treffer) this_object()->move(victim);
  return 1;
}

int ww(string str)
{
  if (str)
    return throw_it("Kokosnuss nach "+str);
  else
  {
    object *all, *liv;
    int i;

    all=all_inventory(environment(this_player()));
    for (i=0; i<sizeof(all); i++)
      if (query_once_interactive(all[i]))
        if (!liv)
	  liv = ({all[i]});
        else
          liv = liv+({all[i]});
    i = random(sizeof(liv));
    return throw_it("Kokosnuss nach "+lower_case(liv[i]->query_real_name()));
  }
}

void reset()
{
  if (!is_clone(this_object())) return;
  ::reset();
  if( !random(5) )
  {
    if( environment())
    tell_object(environment(), "Die Kokosnuss verfault.\n");
    call_out("remove",0);
  }
}
