//brotfrucht

inherit "std/food";

#include <properties.h>
#include <food.h>
#include "files.h"

create()
{
  if (!is_clone(ME)) return;
  ::create();
  SetProp (P_SHORT, "Eine Brotfrucht");
  SetProp (P_LONG, "Eine schoene, reife Brotfrucht aus dem Dschungel.\n");
  SetProp (P_NAME, "Brotfrucht");
  SetProp (P_GENDER, FEMALE);
  AddId (({"brotfrucht","brot", "frucht"}));
  SetProp (P_INFO, ("Die Brotfrucht wird den Waechter erfreuen.\n"));
  SetProp (P_VALUE, 0);
  SetProp (P_WEIGHT, 10);
  SetProp (P_NOBUY, 0);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_NODROP, 1);
  SetProp (P_MATERIAL, MAT_FOOD);
  SetProp (P_FOOD_INFO, ([F_HEAL: 1, F_SOAK: 3, F_ALCOHOL: 0, F_POISON:0]));
}

BeimEssen()
{
  write ("Du isst die Brotfrucht.\n");
  say (TPN+" verspeisst die Brotfrucht.\n");
  return ::BeimEssen();
}
