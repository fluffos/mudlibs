//invis obj fuer jojo suizid
//dante 97 dez

inherit "std/thing"; 
#include <language.h>
#include <properties.h>
#include <combat.h>
#include <defines.h>
#include <moving.h>
#include "files.h"

create()

{ if(!is_clone(this_object())) return;
  thing::create();
  SetProp(P_SHORT, 0);
  SetProp(P_LONG, 0);

  SetProp(P_VALUE,0);
  SetProp(P_WEIGHT,0);
  SetProp(P_GENDER, MALE);
  SetProp(P_NAME,0);
  
  AddId(({"jojoattacke","attjo"}));
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
 SetProp(P_NODROP, 1);
 SetProp(P_NEVERDROP, 1);
 call_out("weg", 1001);
 
}

weg()
{
remove();
}