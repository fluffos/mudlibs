// dante@SilberLand teil1 fuer august

#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Der Ring von Augusts Jojo-Schnur");
  SetProp(P_LONG, BS( 
    "Das ist der Ring von der Schnur von Augusts Jojo. Verlier ihn nicht!"));
  SetProp(P_NAME, "Ring");
  SetProp(P_GENDER, MALE);
  AddId(({"einzelteil" ,"ring","teil"}));

  SetProp(P_MATERIAL, ({MAT_JEWEL}));
  SetProp(P_WEIGHT, 20);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
}
