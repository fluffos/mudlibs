// dante@SilberLand teil1 fuer august

#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Die bunte Schnur von Augusts Jojo");
  SetProp(P_LONG, BS( 
    "Das ist einer der Einzelteile von Augusts Jojo. Du solltest gut auf ihn aufpassen..."));
  SetProp(P_NAME, "Schnur");
  SetProp(P_GENDER, FEMALE);
  AddId(({"einzelteil" ,"schnur","teil"}));

  SetProp(P_MATERIAL, ({MAT_GUM}));
  SetProp(P_WEIGHT, 20);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
}
