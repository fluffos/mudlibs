/*
** Steinpilz
** ---
*/

inherit "std/food";

#include <properties.h>
#include <food.h>
#include "files.h"

create()
{
  if (!is_clone(ME)) return;
  ::create();
  SetProp (P_SHORT, "Ein Gigantensteinpilz");
  SetProp (P_LONG, "Ein riesengrosser, steinharter Gigantensteinpilz.\n");
  SetProp (P_NAME, "Gigantensteinpilz");
  SetProp (P_GENDER, MALE);
  SetProp (P_NOSELL, 1);
  SetProp (P_WEIGHT, 500);
  SetProp(P_SIZE, 50);
  SetProp (P_NOBUY, 1);
  SetProp(P_INFO, ("Der Steingigantenkoenig liebt diese Pilze. \n"));
  AddId (({"gigantensteinpilz"}));
  SetProp (P_FOOD_INFO, ([F_HEAL: 1, F_SOAK: 50, F_ALCOHOL: 0, F_POISON: 0]));
}

BeimEssen()
{
write ("Du wuergst den riesigen Gigantensteinpilz hinunter und fuellst Dich enorm gesaettigt.\n");
say (TPN+"wuergt den rieseigen Gigantensteinpilz hinunter und platzt fast...\n");
return ::BeimEssen();
}