inherit "std/thing"; 
#include <language.h>
#include <properties.h>
#include <combat.h>
#include <defines.h>
#include <moving.h>
#include "files.h"

int weg;
create()

{ if(!is_clone(this_object())) return;
  thing::create();
  SetProp(P_SHORT, 0);
  SetProp(P_LONG, 0);

  weg = 0;
  SetProp(P_VALUE,0);
  SetProp(P_WEIGHT,0);
  SetProp(P_GENDER, MALE);
  SetProp(P_NAME,0);
  
  AddId(({"prot"}));
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
 SetProp(P_NODROP, 1);
 SetProp(P_NEVERDROP, 1);
  SetProp (P_TEMPERATURE_PROTECTION, ([ T_COLD_PROT:5, T_HEAT_PROT:12 ])); 
 //fett schuetze haut auch gegen kaelte!!!!!
 
}


void reset()
  {
 ::reset();
   weg++;
   if(weg==1+random(2))
        {
         call_out("rem", 0);
         }
  }
                      
  rem()
 { 
 write("Der Schutz der Sonnencreme verschwindet wieder.\n");
  remove();
  }
  