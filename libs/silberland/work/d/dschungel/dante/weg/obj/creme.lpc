//dante 97 dezember
//sonnecremtube fuer miniquest von lostboy
//mehrmals zu verwenden dann leer, hilft als temp schutz
inherit "std/thing";

#include <moving.h>
#include <properties.h>
#include <language.h>
int offen;
int inhalt;

#include "files.h"
create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT, "Eine unscheinbare Tube (geschlossen)");
  SetProp(P_NAME, "Tube");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_LONG, BS(
  "Diese unscheinbare Tube enthaelt pflanzliche Fette, die Gerio aus den "
  "verschiedensten Pflanzen und Kraeutern der Steppe gewonnen hat. Die "
  "genaue Mixtur kennt nur er, daher ist sie auch sehr wertvoll."
  " Ausserdem soll angeblich noch eine geheime Substanz darin enthalten sein, "
  "aber was das ist, weiss keiner ausser Gerio so genau. "
  "Wenn Du etwas davon auf Deine Haut auftraegst, wird es Dich zumindest "
  "eine Zeit lang vor der Sonne schuetzen. Du siehst auch noch ein "
  "kleines Schild, das an der Tube haengt."));
  AddDetail("schild",
  "+-----------------+\n"
  "| (c) by Dante 97 |\n"
  "+-----------------+\n");
  
  AddId("tube");
  AddId(({"creme","schutz","sonnecreme"}));
  SetProp(P_WEIGHT, 130); 
  SetProp(P_VALUE, 2000);
  SetProp(P_NOSELL, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NODROP, 0);
  SetProp(P_INFO, ("Die spezielle Zutat ist Kot von verschiedenen Tieren der Steppe. \n"));
  
  AddCmd(({"oeffne"}),"open");
  AddCmd(({"schliess","schliesse","verschliesse","verschliess"}), "close");
  AddCmd(({"druecke","drueck"}), "cream");
  
  offen=0;
  inhalt=10+random(5);
    
  
  SetProp(P_MATERIAL, ([ MAT_PLASTIC:100]) ); 
}

cream(string str)
   {
    object ob;
    notify_fail("Was willst Du hier druecken!\n");
    if (!str) return 0;
    
        if( (str=="tube") && (offen) && (inhalt) )
            {
              ob=clone_object("/d/dschungel/dante/weg/obj/prot.lpc");
    ob->move(TP,M_NOCHECK);
        write("Du drueckst Dir etwas Creme aus der Tube heraus.\n");
        say(""+TPN+" drueckt sich etwas Creme aus der Tube heraus.\n");
        inhalt--;
        return 1;
           }
        
         if( (str=="tube") && (!offen))
            {
            write("Du drueckst wie ein Idiot auf der geschlossenen Tube herum.\n");
            say(""+TPN+" drueckt auf einer geschlossenen Tube herum.\n");
            return 1;
            }
       
           if( (str=="tube") && (!inhalt))
             {
             SetProp(P_WEIGHT, 30);
             SetProp(P_VALUE, 30);
             SetProp(P_SHORT, "Eine unscheinbare Tube(leer)");
           write("Du drueckst vergeblich auf der Tube herum, denn sie ist leer.\n");
           say(""+TPN+" aergert sich, dass die Tube voller Creme schon leer ist.\n");
           return 1;
             }
          return 0;
          } 
             
            
 
close(string str)
   {
   notify_fail("Was willst Du verschliessen, die Tube?\n");
   if (!str) return 0;
     
     if( (str=="tube") && (offen) )
        {
        SetProp(P_SHORT, "Eine unscheinbare Tube(verschlossen)");
         write("Du verschliesst die Tube wieder.\n");
         say(""+TPN+" verschliesst eine Tube voller Creme.\n");
         offen=0;
         return 1;
         }
    
     if ( (str =="tube") && (!offen) )     
         {
         write("Aber die Tube ist doch verschlossen.\n");
         say(""+TPN+" dregt doof an einer Tube herum.\n");
         
         return 1;
         }
         return 0;
    }
   


open(string str)
   {
   notify_fail("Was willst Du oeffnen, die Tube?\n");
   if (!str) return 0;
     
     if( (str=="tube") && (offen) )
        {
         write("Aber die Tube ist doch schon geoeffnet!\n");
         say(""+TPN+" stellt sich ziemlich doof an.\n");
         return 1;
         }
    
     if ( (str =="tube") && (!offen) )     
         {
         SetProp(P_SHORT, ("Eine unscheinbare Tube(geoeffnet)"));
         write("Du oeffnest mit einem Ruck die Tube.\n");
         say(""+TPN+" oeffnet mit einem Ruck eine Tube voller Creme.\n");
         offen++;
         return 1;
         }
         return 0;
    }
   

