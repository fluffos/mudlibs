inherit"std/armour.lpc";
inherit "/std/container";

#include <properties.h>
#include <combat.h>
#include "/players/dante/myowndefine.h"

inherit "/players/dante/my/behaelter.lpc";

void set_name(string wer)
{
  AddDetail("schild",
      "\n\n\n" +
      "+-------------------------+\n" +
      "|                         |\n" +
      "|                         |\n" +
      "|                         |\n" +
      "|         ,,,,,           |\n" +
      "|    W   ( ++ ++ )   W    |\n" +
      "|   ( )  ( --- )  ( )     |\n" +
      "|    ( )  _| |_  ( )      |\n" +
      "|      ( )     ( )        |\n" +
      "|        (==o==)          |\n" +
      "|         (   )           |\n" +
      "|        ( ) ( )          |\n" +
      "|       ( )   ( )         |\n" +
      "|      ( )     ( )        |\n" +
      "|    .uuu       uuu.      |\n" +
      "|                         |\n" +
      "| (c) by dante 98         |\n" +
      "+-------------------------+\n" +
      "          "+wer+"\n");

  switch (wer[<1])
  {
    case 'x': case 's': case 'z': wer = wer + "'"; break;
    default: wer = wer + "s";
  }
  SetProp(P_NAME, wer+" Rucksack");
  SetProp(P_SHORT, wer+" Rucksack");
  SetProp(P_LONG,
        "Das ist "+wer+" Rucksack. Er wurde aus einem sehr widerstandsfaehigem, robustem "
        "Material gefertig, ist aber trotzdem aeusserst leicht. Doch das ist nicht das "
        "Erstaunlichste an diesem Rucksack. Viel verwunderlicher ist die Tatsache, das "
        "der Rucksack sehr klein wirkt, auf jeden Fall zu klein um mehr als einige "
        "Muenzen darin verstauen zu koennen. Trotzdem ist der Rucksack aber in der Lage "
        "Unmengen von Sachen aufzunehmen. Wie ist und bleibt Dir ein Raetsel, denn auch "
        "Dante weiss dieses Geheimniss nicht. Das kann Dir auch egal sein, denn Du freust "
        "Dich sehr, so einen genialen Rucksack zu besitzen. Ausserdem Du erkennst ein kleines "
        "Schild an dem Rucksack. Du kannst immer nur einen Rucksack dieser Sorte haben!");
}

void create()
{
  armour::create();
  container::create();

  SetProp(P_NAME, "Rucksack");
  SetProp(P_GENDER,MALE);
  SetProp(P_MATERIAL, ([MAT_CHITIN:80, MAT_MAGIC:10, MAT_FOOD:10]) );
  AddId(({"rucksack", "waechterrucksack", "dschungelwaechterrucksack","D_RS"}));
  SetProp(P_ARTICLE, 0);
  SetProp(P_SHORT, "Ein Rucksack");
  SetOffen();

  SetProp(P_WEAR_TEXT, ({ "Du ziehst %s an.\n", " zieht %s an.\n" }));
  SetProp(P_UNWEAR_TEXT, ({ "Du ziehst %s aus.\n", " zieht %s aus.\n" }));



  SetProp(P_WEAR_RESTRICTIONS, ([A_INT:10]) );
  SetProp(P_MAX_WEIGHT, 5000);//hmmmm
  SetProp(P_WEIGHT, 100);
  SetProp(P_WEIGHT_PERCENT, 40);
  SetProp(P_NOBUY, 1);
  SetProp(P_VALUE, 2000);
  SetProp(P_ARMOUR_TYPE, AT_MISC);
  SetProp(P_AC, 0);
  SetProp(P_INFO,
      "Diesen Rucksack kann man anziehen und auch essen!\n");

  AddCmd(({"iss", "esse"}), "eat");

  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_WEAR_FUNC, this_object());
  SetProp(P_REMOVE_FUNC, this_object());
  SetProp(P_QUALITY_DECAY, 0);
  SetProp(P_NO_DAMAGE_DESTRUCT, 1);
}


int eat(string str)
{
  if (!str) return 0;

  if (id(str))
  {
    say(CAP_TPN+" begutachtet einen Rucksack, grinst hungrig und stopft sich "
        "dann den ganzen Rucksack auf einmal in dem Mund.\n"
        "Danach sieht "+TPN+" stark und mutig aus.\n");


    write("Du begutachtest den Rucksack, grinst hungrig und stopfst Dir "
        "dann den ganzen Rucksack aufeinmal in den Mund.\n"
        "Nun fuehlst Du Dich wieder stark und maechtig!\n"
        "Den Inhalt des Beutels musst Du nun allerdings wieder in der Hand tragen.\n");

    domainshout(""+this_player()->name(WER,RAW)+" ruft: Ich fuehl mich stark wie ein Rucksack!\n");
    TP->heal_self(50);
    remove();
    return 1;
  }
  return 0;
}



string short(){
  string str;
  str=QueryProp(P_SHORT);
  str=str+(QueryProp(P_CNT_STATUS)?" (geschlossen)":" (geoeffnet)");
  str=str+(QueryProp(P_WORN)?" und (angezogen).\n":".\n");
  return str;
}

string long(){
  return container::long();}


void init()
{
  armour::init();

  add_action("open","oeffne");
  add_action("close","schliesse");
  add_action("close","schliess");
  add_action("getout","nimm");
  add_action("putin","stecke");
  add_action("putin","steck");
  add_action("putin","leg");
  add_action("putin","lege");

  if(living(environment()) && (present("D_RS 2", environment())))
    remove();
}

varargs int move(mixed dest, int method)
{
  if (stringp(dest))
  {

    call_other(dest, "???"); dest=find_object(dest);
  }
  return (int)::move(dest , method);
}

int open(string str)
{
  if(!str) return 0;
  if(!id(str)) return 0;
  if(this_object()->QueryWorn())
  {
    write("Dazu musst Du den Rucksack ausziehn!\n");
    return 1;
  }
  return (int)::oeffne(str);
}


int close(string str)
{
  if(!str) return 0;
  if(!id(str)) return 0;
  if(this_object()->QueryWorn())
  {
    write("Dazu musst den Rucksack ausziehn!\n");
    return 1;
  }
  return (int)::schliesse(str);
}

int getout(string str)
{
  string dum,dum2;
  if(str && sscanf(str,"%s aus %s",dum,dum2))
  {
    if(id(dum2))
      if(this_object()->QueryWorn())
      {
        write("Dazu musst Du den Rucksack ausziehn!\n");
        return 1;
      }
  }
}


int putin(string str)
{
  string dum,dum2;
  if(str && sscanf(str,"%s in %s",dum,dum2))
  {
    if(id(dum2))
      if(this_object()->QueryWorn())
      {
        write("Dazu musst Du den Rucksack ausziehn!\n");
        return 1;
      }
  }
}

