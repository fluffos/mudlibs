//brotfrucht

inherit "std/thing";

#include <properties.h>
#include "files.h"

create()
{
  if (!is_clone(ME)) return;
  ::create();
  SetProp (P_SHORT, "Eine Prise Salz");
  SetProp (P_LONG, "Eine kleine Prisa Salz, zum wuerzen...\n");
  SetProp (P_NAME, "Salz");
  SetProp (P_GENDER, NEUTER);
  AddId (({"salzprise","SALZ","salz", "prise"}));
  SetProp (P_INFO, ("Mit dem Salz kann man Speisen wuerzen.\n"));
  SetProp (P_VALUE, 0);
  SetProp (P_WEIGHT, 1);
  SetProp (P_NOBUY, 0);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_NODROP, 1);
  SetProp (P_MATERIAL, MAT_FOOD);
}
