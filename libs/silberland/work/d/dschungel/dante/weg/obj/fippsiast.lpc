//ast der als zange funzt

inherit "std/thing";

#include <properties.h>
#include "files.h"
create()
{
  if (!is_clone(ME)) return;
  ::create();
  SetProp (P_SHORT, "Ein seltsamer Ast");
  SetProp (P_LONG, BS(
  "Dieser Ast ist merkwuerdig geformt. Irgendwie gebogen, irgendwie "
  "verformbar. Man kann ihn sicher irgendwie verwenden."));
  SetProp (P_NAME, "Ast");
  SetProp(P_NAME_ADJ, "seltsam");
  SetProp (P_GENDER, MALE);
  AddId (({"ast", "zange", "FIPPSI_ZANGE"}));
  SetProp (P_INFO, ("Dieser Ast kann als eine Art Zange verwendet werden!\n"));
  SetProp (P_VALUE, 0);
  SetProp (P_WEIGHT, 100);
  SetProp (P_NOBUY, 0);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_NODROP, 1);
  SetProp (P_MATERIAL, ([MAT_OAK: 100]));
}
