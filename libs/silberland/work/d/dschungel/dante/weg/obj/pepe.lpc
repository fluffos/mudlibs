//brotfrucht

inherit "std/thing";

#include <properties.h>
#include "files.h"

create()
{
  if (!is_clone(ME)) return;
  ::create();
  SetProp (P_SHORT, "Eine Pfefferkorn");
  SetProp (P_LONG, "Eine kleines Pfefferkorn. Scharf und wuerzig.\n");
  SetProp (P_NAME, "Pfeffer");
  SetProp (P_GENDER, MALE);
  AddId (({"korn","PEPE","pfeffer", "pfefferkorn"}));
  SetProp (P_INFO, ("Mit dem Pfeffer kann man Speisen wuerzen.\n"));
  SetProp (P_VALUE, 0);
  SetProp (P_WEIGHT, 1);
  SetProp (P_NOBUY, 0);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_NODROP, 1);
  SetProp (P_MATERIAL, MAT_FOOD);
}
