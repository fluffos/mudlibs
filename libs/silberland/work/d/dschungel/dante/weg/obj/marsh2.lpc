inherit "std/food";

#include <properties.h>
#include <food.h>
#include "files.h"


void create()
{
  if (!is_clone(ME)) return;
  ::create();
  SetProp (P_SHORT, "Marshmallowmans Marshmallow");
  SetProp (P_LONG, BS(
  "Das ist Marshmallowmans Marshmallow. Zumindest eines davon. Es schmeckt herrlich und macht gar nicht dick..."));
  SetProp (P_NAME, "Marshmallow");
  SetProp (P_GENDER, NEUTER);
  SetProp (P_VALUE, 10);
  SetProp (P_WEIGHT, 1);
  SetProp(P_SIZE, 5);
  SetProp (P_NOBUY, 1);
  SetProp(P_NOSELL, 0);
  
  SetProp(P_INFO, ("Ja, das Marshmallow ist von Marshmallowman.\n"));
  AddId (({"marshmallow"}));
  SetProp (P_FOOD_INFO, ([F_HEAL: 5, F_SOAK: 1, F_ALCOHOL: 0, F_POISON: 0]));
}

BeimEssen()
{
  if(member(TP->QueryProp(P_IDS), "tessa")!=-1)   {
    write(
        "Du bist Tessa, die wahre Marshmallowmanfreundin und daher schmeckt Dir das Marshmallow auch "
        "besonders gut. Du freust Dich und steckst Dir Dein Marshmallow in den Mund.\n");

    return ::BeimEssen();
  }
  else{
    write("Du bist nicht der echte Marshmallowmanfreund und daher schmeckt Dir Marshmallows "
        "Marshmallow auch nicht so gut extrem wie der wahren Marshmallowmanfreundin selbst. "
        "Du bekommst ein schlechtes Gewissen, doch es schmeckt trotzdem sehr gut!\n");

    return ::BeimEssen(); 
  }
}


void reset()
{
  
  object pl;
  ::reset();
  if( !MENV ||
      ( query_once_interactive(MENV) && (pl=MENV) && !random(10)) ||
      ( !pl && objectp(ENV(MENV)) && query_once_interactive(ENV(MENV)) && 
        (pl=ENV(MENV))) && !random(10) ||
      ( !pl && random(2)) )
  {
    if( objectp(pl) )
    {
      if( !interactive(pl) ) return ;
      tell_object(pl, "Ein Marshmallow zerfaellt zu Staub.\n");
    }
    else if( MENV )
      tell_room( MENV, "Ein Marshmallow zerfaellt zu Staub.\n");
    remove();
  }
}
