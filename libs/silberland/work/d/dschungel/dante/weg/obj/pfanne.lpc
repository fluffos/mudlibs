//brotfrucht

inherit "std/thing";

#include <properties.h>
#include "files.h"

create()
{
  if (!is_clone(ME)) return;
  ::create();
  SetProp (P_SHORT, "Eine alte Pfanne");
  SetProp (P_LONG, "Eine alte Pfanne zum braten und kochen.\n");
  SetProp (P_NAME, "Pfanne");
  SetProp (P_GENDER, FEMALE);
  AddId (({"pfanne", "PFANNE"}));
  SetProp (P_INFO, ("Die Pfanne dient zur Zubereitung der Speisen.\n"));
  SetProp (P_VALUE, 0);
  SetProp (P_WEIGHT, 100);
  SetProp (P_NOBUY, 0);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_NODROP, 1);
  SetProp (P_MATERIAL, MAT_STEEL);
}
