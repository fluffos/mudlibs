inherit "std/food";

#include <properties.h>
#include <food.h>
#include "files.h"

create()
{
  if (!is_clone(ME)) return;
  ::create();
  SetProp (P_SHORT, "Ein leckeres Schokobon");
  SetProp (P_LONG, "Ein kleines, leckeres Schokobon aus der magischen Wundertuete von Dante.\n");
  SetProp (P_NAME, "Schokobon");
  SetProp (P_GENDER, NEUTER);
  SetProp (P_VALUE, 10);
  SetProp (P_WEIGHT, 5);
  SetProp(P_SIZE, 2);
  SetProp (P_NOBUY, 1);
  SetProp(P_NOSELL, 0);
  SetProp(P_INFO, ("Hmmmm, einfach herrlich....\n"));
  AddId (({"schokobon","schoko","bon"}));
  SetProp (P_FOOD_INFO, ([F_HEAL: 0, F_SOAK: 2, F_ALCOHOL: 0, F_POISON: 0]));
}

BeimEssen()
{
  write (break_string("Du steckst das leckere Schokobon in den Mund und "
        "laesst es mit Genuss auf der Zunge zergehen.\n"));
  say (break_string(TPN+" steckt sich froehlich grinsend ein leckeres Schokobon "
        "in den Mund und laesst es mit grossem Genuss auf der Zunge zergehen."));
  return ::BeimEssen();
}
