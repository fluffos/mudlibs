// dante@SilberLand ein patzen schlamm

#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Ein Schlammbatzen");
  SetProp(P_LONG, BS( 
    "Ein ekliger, grauer Batzen Schlamm.") );
  SetProp(P_INFO, "Der Schlammbatzen hat sicher eine Bedeutung.\n");
  SetProp(P_NAME, "Schlammbatzen");
  SetProp(P_GENDER, MALE);
  AddId(({"schlamm","batzen","schlammbatzen","batzen schlamm"}));
  SetProp(P_NOSELL, 1);
  SetProp(P_MATERIAL, ({ MAT_ANIMAL, MAT_PLANT}) );
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 10);
  SetProp(P_NOBUY, 1);

}
