//brotfrucht

inherit "std/thing";

#include <properties.h>
#include "files.h"

create()
{
  if (!is_clone(ME)) return;
  ::create();
  SetProp (P_SHORT, "Ein trockener Ast");
  SetProp (P_LONG, "Ein trockener Ast, der sich gut fuer ein Feuer eignet.\n");
  SetProp (P_NAME, "Ast");
  SetProp (P_GENDER, MALE);
  AddId (({"AST", "ast"}));
  SetProp (P_VALUE, 0);
  SetProp (P_WEIGHT, 1);
  SetProp (P_NOBUY, 0);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_NODROP, 1);
  SetProp (P_MATERIAL, MAT_WOOD);
}
