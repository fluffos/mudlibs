//creme zum auftragen fuer schutz vor sonne usw
//dante 97

inherit "std/thing"; 
#include <language.h>
#include <properties.h>
#include <combat.h>
#include <defines.h>
#include <moving.h>
#include "files.h"



create()

{ if(!is_clone(this_object())) return;
  thing::create();
  SetProp(P_SHORT, "Ein Batzen fetthaltiger Creme");
  SetProp(P_LONG, BS(
  "Du siehst vor Dir einen Batzen fetthaltiger Creme aus einer Tube, die "
  "von Gerio stammt. Du kannst sie auf Deine Haut auftragen und sie "
  "wird Dich eine gewisse Zeit vor der Sonne schuezten.\n"));

  SetProp(P_VALUE,0);
  SetProp(P_WEIGHT,10);
  SetProp(P_GENDER, FEMALE);
  SetProp(P_NAME, "Creme");
  
  call_out("weg", 500);
  
  AddId(({"batzen","creme","fett"}));
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
 SetProp(P_NODROP, 0);
 SetProp(P_NEVERDROP, 0);
  SetProp(P_MATERIAL, ([ MAT_SHIT:15, MAT_FAT:100, MAT_MISC_HERBAL:50,MAT_MISC_PLANT:50]) );


AddCmd(({"creme","schmiere","schmier"}), "heat");     
  
}

 heat(string str)
   {
  object ob;
   if (!str) return 0;
   if ( member(({"creme","creme auf haut","auf koerper","dich ein"}),str) !=1)
      {
      if(present("prot", TP))
      {
      write("Aber Du hast Dich ja gerade erst eingecremt!\n");
      return 1;
      }
      
     else
     { 
      
   write("Du cremst Deine freie Haut mit der Creme ein. Sofort spuerst "
   "Du wie kuehlend und erfrischend sie wirkt.\n");
   say(""+TPN+" traegt etwas Creme auf seiner Haut auf.\n");
  

   ob=clone_object("/d/dschungel/dante/weg/obj/prot2.lpc");
      ob->move(TP, M_NOCHECK);      
   remove();
   return 1;                                                                
      }
      return 0;
    }
      
   return 0;
   }
