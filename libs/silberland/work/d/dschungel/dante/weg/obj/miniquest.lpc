//obj fuer quest by dante
inherit "std/thing"; 
#include <language.h>
#include <properties.h>
#include <combat.h>
#include <defines.h>
#include "/sys/mail.h"
#include <moving.h>
#include "files.h"
#define  BSA(x,y) break_string(x,78,y)      
#define QUESTKEY "Buckel vor Mini"

int counter=0;
int versuche=0;
int wieoft=10+random(5);
void NextTry();
 
create()
{
  if(!is_clone(this_object())) return;

  ::create();

  seteuid( getuid(this_object()));  
  SetProp(P_SHORT, 0);
  SetProp(P_LONG, 0);

  SetProp(P_VALUE,0);
  SetProp(P_WEIGHT,0);
  SetProp(P_GENDER, MALE);
  SetProp(P_NAME,0);
  
  AddId(({"\nminiquest"}));
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  AddCmd("aufgabe", "try"); 
}

try()
{
  object ob, na, but;
  int    gq;

  ob=environment(TO);
  na=ob->QueryProp(P_NAME);
   
  if(!present("mini", environment(ob)))
  {
    write("Nein, ohne Mini auch keine Aufgabe!\n");
    return 1;
  }
   
  if(versuche < wieoft)
  {
    write(BSA(
    "Nein, Du kannst noch nicht aufgeben, Du hast es ja noch "
    "gar nicht richtig versucht! Jammerlappen!", 
    "Mini, die Minischnecke sagt: "));
    return 1;
  }
  else
  {
    write(BSA(
     ""+na+", Du mieser, kleiner Schwaechling. Schaem Dich! Du "
     "Versager kannst nicht einmal eine Kiste hochheben! Sowas hab "
     "ich ja noch nie erlebt! Los verschwinde aus meinen Augen!",
     "Mini, die Minischnecke sagt: "));
     write(BS(
     "Dann hebt sie die Kiste mit ihren kleinen Minischneckenhaenden "
     "hoch, stellt sie auf den Tisch und lacht Dich aus. Die Kiste "
     "faellt zwar gleich wieder zu Boden, doch irgendetwas kommt Dir da "
     "doch seltsam vor. Hat sich die Minischnecke oder gar ihr Erschaffer "
     "etwa einen Spass mit Dir erlaubt?!?!\n"));

    gq = TP->GiveQuest(QUESTKEY);



/*
   send_mail();
mit der zeit nervt sowas
*/




    if (gq==1 || gq==-1)        // 1: geloest, -1: wurde schon mal geloest
    {
      write_file("/log/quests/mini",
          dtime(time())+": "+capitalize(getuid(this_player()))+ " loest die Quest"+
            (gq==-1 ? " nochmal" : "")+".\n"); 
      //damit mua nicht soooo viel arbeit hat:))   
      // danke :)
  



      if(!deep_present("\nminibutton", TP))
      {    but=clone_object("/d/dschungel/dante/weg/obj/verarscht");
        but->move(TP, M_GET);
        write(BSA(
         "Naja, fuer Deine Buckelei bekommst Du etwas, hier da hast Du!",
         "Mini lacht: "));   
        remove();
        return 1;
      }
      else
      {
        remove();
        return 1;
      }
    }
    else {
      write("Fehler!!! Code: "+gq+", Bitte Magier verstaendigen!\n");
      return 1;
    }
  }
}


   reset() {
   ::reset();
   counter++;
   if(counter>20)
     {
     tell_object(environment(TO),
       "Du willst Mini, der Minischnecke nicht mehr helfen!\n");
        remove();
       }
   }



       
   void NextTry(){
   versuche++;
   if(versuche==wieoft) {
   call_out("text", 0); //das is nur damit ne zeitverzoerung entsteht
   //sonst kommt der text von mini VOR dem nichtkistehochhebekoennen
   //lustiges wort oder?
   } }
      
   
   void text() {
   object ob, na;
   ob=environment(TO);
   na=ob->QueryProp(P_NAME);
   tell_object(ob,
   "Mini, die Minischnecke sagt: "+na+", gib doch auf!\n"
   "Mini, die Minischnecke sagt: Was Du hier machst ist ja voellig\n"
   "Mini, die Minischnecke sagt: sinnlos. Siehs doch ein! Du bist ein\n"
   "Mini, die Minischnecke sagt: jaemmerlicher Schwaechling! Sei froh,\n"
   "Mini, die Minischnecke sagt: dass Du Dir nicht weh getan hast!\n"
   "Mini, die Minischnecke sagt: Aber bitte, wenn Du willst mach weiter!\n"
   "Mini, die Minischnecke sagt: Ich amuesiere mich gut dabei!\n"
   "Mini, die Minischnecke sagt: Andererseits kenne ich einen Level 1\n"
   "Mini, die Minischnecke sagt: Spieler, der die Kiste ohne Probleme\n"
   "Mini, die Minischnecke sagt: auf den Holztisch gehoben hat.\n"
   "Mini, die Minischnecke sagt: Vielleicht bist Du ja nicht zu schwach,\n"
   "Mini, die Minischnecke sagt: sondern nur zu doof dazu!\n"
   "syntax: <aufgabe>\n");
    }
   
       
     
send_mail()  {
	

   mixed* mail;
   string text;

   text =
   "Hallo Xandi! "+CAP(getuid(TP))+" hat die Miniquest geloest.\n";

   mail = allocate(9);
   mail[MSG_FROM] = "Miniquest";
   mail[MSG_SENDER] = "Mini";
   mail[MSG_RECIPIENT] = "dante@a1.net";
   mail[MSG_CC]=0;
   mail[MSG_BCC]=0;
   mail[MSG_SUBJECT]="Mini Quest!";
   mail[MSG_DATE]=dtime(time());
   mail[MSG_ID]="miniquest";
   mail[MSG_BODY]=text;

   return "/secure/mailer"->DeliverMail(mail,1);
}

