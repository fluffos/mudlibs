inherit "std/thing";

#include "../def.h" 


object player;

void create()
{
  ::create();
  if (!is_clone(this_object())) return;
  SetProp(P_NAME, 0);
  SetProp(P_SHORT, 0);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_NODROP, 1);
  AddId (({"MALA", "Krankheit"}));
  AddClass(CL_DISEASE);
  call_out("st1", 150);

  SetProp(P_WEIGHT, 0);
}


void init()
{
  ::init();
  if(present("MALA 2", MENV) || !interactive(MENV) )
    call_out("remove",0);
  player=MENV;
}


st1()
{
  if( !player ) remove();
  tell_object( player,  "Dir wird ploetzlich ganz heiss...\n");
  tell_room( ENV(player), capitalize(player->name())+" bekommt einen roten Kopf.\n", ({player}));
  call_out("st2",10);
}

st2()
{ 
  if( !player ) remove();
  tell_room( ENV(player), capitalize(player->name())+" schwitzt sehr stark.\n", ({player}));
  tell_object( player, "Du schwitzt sehr stark...\n");
  player->reduce_hit_point(10);
  call_out("st3",10);
}

st3()
{
  if( !player ) remove();
  tell_room( ENV(player), capitalize(player->name())+" scheint hohes Fieber zu haben.\n", ({player}));
  tell_object( player, 
      "Du fuehlst Dich sehr schwach.\n");
  call_out("story4", 10);
}

story4()
{
  if( !player ) remove();
  tell_room( ENV(player), capitalize(player->name())+" scheint sehr krank zu sein.\n", ({player}));
  tell_object( player,  "Du scheinst eine schlimme Krankheit zu haben.\n");
  player->reduce_hit_point(15);
  call_out("story5", 10);
}

story5()
{  
  if( !player ) remove();
  tell_room( ENV(player), capitalize(player->name())+" taumelt herum...\n", ({player}));
  tell_object( player,  "Du hast sehr hohes Fieber...\n");
  call_out("story6", 10);
  tell_room( ENV(player), capitalize(player->name())+" hat sehr boesen Schuettelfrost.\n", ({player}));
}

story6()
{  
  if( !player ) remove();
  tell_room( ENV(player), capitalize(player->name())+" redet wirres Zeug im Fieberwahn.\n", ({player}));
  tell_object( player,  "Du wirst immer schwaecher...\n");
  player->reduce_hit_point(20);
  call_out("story7", 10);
}

story7()
{  
  if( !player ) remove();
  tell_room( ENV(player), capitalize(player->name())+" schaut sehr krank aus.\n", ({player}));
  tell_object( player,  "Du scheinst an der Malaria erkrankt zu sein.\n");
  call_out("story8", 10);
}

story8()
{ 
  if( !player ) remove();
  tell_room( ENV(player), capitalize(player->name())+" scheint zu gluehen.\n", ({player}));
  tell_object( player,  "Du hast sehr hohes Fieber.\n");
  call_out("story9", 10);
}

story9()
{ 
  if( !player ) remove();
  tell_object( player,  "Du hast sehr schlimmen Schuettelfrost.\n");
  tell_room( ENV(player), capitalize(player->name())+" wird von Schuettelfrost gebeutelt.\n", ({player}));
  call_out("story10", 10);
  player->reduce_hit_point(15);
}

story10()
{ 
  if( !player ) remove();
  tell_object( player,  "Das Fieber wird immer hoeher...\n");
  call_out("story11", 15);
  tell_room( ENV(player), capitalize(player->name())+" schwitzt sehr stark.\n", ({player}));
}

story11()
{ 
  if( !player ) remove();
  tell_object( player,  "Du taumelst nur mehr umher...\n");
  call_out("story12", 10);
  tell_room( ENV(player), capitalize(player->name())+" ist an Malaria erkrankt.\n", ({player}));
  player->reduce_hit_point(10);
}

story12()
{  
  if( !player ) remove();
  tell_room( ENV(player), capitalize(player->name())+" hat sehr hohes Fieber.\n", ({player}));
  tell_object( player,  "Du fuehlst Dich sterbenskrank!\n");
  call_out("story13" ,10);
  player->reduce_hit_point(15);
}

story13()
{ 
  if( !player ) remove();
  tell_room( ENV(player), capitalize(player->name())+" fuehlt sich sehr schlecht.\n", ({player}));
  tell_object( player,  "Du wirst von Schuettelfrost gebeutelt.\n");
  call_out("story14", 10);
}

story14()
{ 
  if( !player ) remove();
  tell_room( ENV(player), capitalize(player->name())+" kotzt sich von oben bis unten an...\n", ({player}));
  tell_object( player,  "Die Malaria hat Dich voll erwischt.\n");
  player->reduce_hit_point(15);
  call_out("story15", 10);
}

story15()
{
  if( !player ) remove();
  tell_room( ENV(player), capitalize(player->name())+" scheint zu gluehen.\n", ({player}));
  tell_object( player,  "Du hast extrem hohes Fieber.\n");
  call_out("story16", 10);
}

story16()
{ 
  if( !player ) remove();
  tell_room( ENV(player), capitalize(player->name())+" wird von Schuettelfrost gebeutelt.\n", ({player}));
  tell_object( player,  "Du scheinst bald zu sterben...\n");
  call_out("story20", 10);
  player->reduce_hit_point(20);
}

story20()
{ 
  if( !player ) remove();
  tell_room( ENV(player), capitalize(player->name())+" schwitzt sehr stark...\n", ({player}));
  tell_object( player,  "Du taumelst nur mehr im Fieberwahn herum...\n");
  call_out("story21", 10);
}

story21()
{ 
  if( !player ) remove();
  tell_room( ENV(player), capitalize(player->name())+" hat sehr hohes Fieber.\n", ({player}));
  tell_object( player,  "Soll das wirklich schon Dein Ende sein?\n"
      "(Man beachte bitte die korrekte Schreibweise von wirklich!\n");
  call_out("story22" ,10);
}

story22()
{
  if( !player ) remove();
  tell_object( player,  "Dein Kopf scheint zu gluehen...\n");
  call_out("story17" ,10);
  player->reduce_hit_point(10);
}

story17()
{ 
  if( !player ) remove();
  tell_room( ENV(player), capitalize(player->name())+" ist an Malaria erkrankt.\n", ({player}));
  tell_object( player,  "Dein Fieber scheint zu sinken...\n");
  call_out("story18", 10);
}

story18()
{ 
  if( !player ) remove();
  tell_room( ENV(player), capitalize(player->name())+" scheint Fieber zu haben.\n", ({player}));
  tell_object( player,  "Du erholst Dich langsam wieder...\n");
  call_out("story19", 5);
}

story19()
{
  if( !player ) remove();
  tell_room( ENV(player), capitalize(player->name())+" scheint sich wieder zu erholen.\n", ({player}));
  tell_object( player,  "Das Fieber sinkt und sinkt... \n");
  call_out("story30", 3);
}

story30()
{
  if( !player ) remove();
  if(getuid(previous_object())=="GUILD.berserker_spells")
    player=TP;
  tell_room( ENV(player), capitalize(player->name())+" ist scheinbar wieder gesund.\n", ({player}));
  tell_object( player,  "Du hast die Malaria ueberwunden.\n\n");
  call_out("story31", 5);
}

story31()
{
  if( !player ) remove();
  tell_room( ENV(player), capitalize(player->name())+" denkt sich . o O 'Dante ist ein Idiot!'\n", ({player}));
  tell_object( player,  "Du denkst Dir . o O 'DANTE ist ein IDIOT!'\n");
  ME->remove();
  return 1;
}

void NotifyPlayerDeath(object victim, object killer, int lost_xp)
{
  remove();
}
