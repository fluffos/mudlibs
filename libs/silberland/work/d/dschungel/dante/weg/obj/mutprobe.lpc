//dante mutprobe zaehlt kampfrunden
//98 99
inherit "std/thing"; 
#include "/players/dante/myowndefine.h"
#include <language.h>
#include <properties.h>
#include <moving.h>
#define TIME 130
#define RUNDEN 30

int runden=0;

create()

{
 if(!is_clone(this_object())) return;
  thing::create();
  SetProp(P_SHORT, 0);
  SetProp(P_LONG,0);
  
  SetProp(P_VALUE,0);
  SetProp(P_WEIGHT,0);
  SetProp(P_GENDER, FEMALE);
  SetProp(P_NAME,0);
  
  AddId(({"D_WK", "MUT"}));
SP(P_NODROP, 1);
SP(P_NEVERDROP, 1);
SP(P_MAGIC, 1);
call_out("aus", TIME);
//AddCmd("aufgabe", "wegdamit");

}


runden_zaehler()  {
	object ob;
	runden++;
 if(runden >= RUNDEN)  {
 	AddId("D_GESCHAFFT");
 	RemoveId("D_WK");
call_out("weg", 3);
  }
}


aus()  {
	
	if(id("D_WK"))  {
	domainshout(BS(
CAP(getuid(PL))+" besteht die Mutprobe nicht!!!"));

if(environment(TO))  {	
	tell_object(environment(TO),
"Der Waechter teilt Dir mit: Die Mutprobe ist zu Ende!\n"
"Der Waechter teilt Dir mit: Du hast es nicht geschafft!\n");
}

write_file("/d/dschungel/dante/weg/log/probenix",
ctime()+": "+CAP(getuid(PL))+" besteht die Mutprobe nicht. Runden: "+runden+"\n");
}

call_out("weg", 0);
 }


weg()  {
remove_call_out("aus");
remove();  }

init()  {
	::init();
if(!living(environment(TO)))  {
	call_out("weg", 0);  } }
	
		
