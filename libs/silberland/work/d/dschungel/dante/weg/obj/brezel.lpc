// brezels brezel dante
inherit "std/food";

#include <properties.h>
#include <food.h>
#include "files.h"


void create()
{
  if (!is_clone(ME)) return;
  ::create();
  SetProp (P_SHORT, "Brezels Brezel");
  SetProp (P_LONG, BS(
  "Das ist Brezels Brezel. Zumindest eine davon. Sie schmeckt herrlich und kann "
  "noch einiges mehr..."));
  SetProp (P_NAME, "Brezel");
  SetProp (P_GENDER, FEMALE);
  SetProp (P_VALUE, 50);
  SetProp (P_WEIGHT, 10);
  SetProp(P_SIZE, 10);
  SetProp (P_NOBUY, 0);
  SetProp(P_NOSELL, 0);
  
  SetProp(P_INFO, ("Ja, die Brezel ist von Brezel.\n"));
  AddId (({"brezel"}));
  SetProp (P_FOOD_INFO, ([F_HEAL: 10, F_SOAK: 4, F_ALCOHOL: 0, F_POISON: 0]));
}

BeimEssen()
{
  if(member(TP->QueryProp(P_IDS), "brezel")!=-1)   {
    write(
        "Du bist der wahre Brezel und daher schmeckt Dir Deine Brezel auch "
        "besonders gut. Du freust Dich und steckst Dir Deine Brezel in den Mund.\n");
    //   TP->SetProp(P_PRESAY, "Der wahre Gott");
    //  TP->SetProp(P_TITLE, "liebt Brezels Brezel");
    return ::BeimEssen();
  }
  else{
    write("Du bist nicht der echte Brezel und daher schmeckt Dir Brezels "
        "Brezel auch nicht so gut wie Brezel selbst. Du bekommst ein schlechtes Gewissen, "
        "doch nahrhaft war\nBrezels Brezel trotzdem.\n");

    //   TP->SetProp(P_PRESAY, "Brezeldieb");
    //  TP->SetProp(P_TITLE, "stiehlt Brezels Brezel");
    return ::BeimEssen(); 
  }
}

void reset()
{
  int d;
  object pl;
  ::reset();
  if( !MENV ||
      ( query_once_interactive(MENV) && (pl=MENV) && !random(10)) ||
      ( !pl && objectp(ENV(MENV)) && query_once_interactive(ENV(MENV)) && 
        (pl=ENV(MENV))) && !random(10) ||
      ( !pl && random(2)) )
  {
    if( objectp(pl) )
    {
      if( !interactive(pl) ) return ;
      tell_object(pl, "Eine Brezel zerfaellt zu Staub.\n");
    }
    else if( MENV )
      tell_room( MENV, "Eine Brezel zerfaellt zu Staub.\n");
    remove();
  }
}
