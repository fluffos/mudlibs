/*
** Steinpilz
** ---
*/

inherit "std/food";

#include <properties.h>
#include <food.h>
#include "files.h"

create()
{
  if (!is_clone(ME)) return;
  ::create();
  SetProp (P_SHORT, "Eine Tafel Nougatschokolade");
  SetProp (P_LONG, "Diese Tafel herrlicher, suesser Nougatschokolade gehoert Wuschel.");
  SetProp (P_NAME, "Nougatschokolade");
  SetProp (P_GENDER, FEMALE);
  SetProp (P_VALUE, 300);
  SetProp (P_WEIGHT, 200);
  SetProp(P_SIZE, 40);
  SetProp (P_NOBUY, 1);
  SetProp(P_INFO, ("Die Nougatschokolade ist koestlich..."));
  AddId (({"schoko","schokolade","nougatschokolade"}));
  SetProp (P_FOOD_INFO, ([F_HEAL: 20, F_SOAK: 6, F_ALCOHOL: 0, F_POISON: 0]));
}

BeimEssen()
{
  write ("Du isst die koestliche, suesse Nougatschokolade und willst mehr davon.\n");
  say (""+TPN+" isst die koestliche, suesse Nougatschokolade mit lautem Schmatzen und Sabbern.\n");
return ::BeimEssen();
}
