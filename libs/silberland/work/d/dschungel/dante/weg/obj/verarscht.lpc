
inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include "/players/dante/myowndefine.h"
#include <language.h>
#include <wizlevels.h>

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  AddId (({"button"}));
  SetProp (P_SHORT, "Ein 'Ich wurde verarscht und hatte sogar Spass dabei'-Button");
  SetProp (P_LONG, BS(
  "Ein voellig sinnloser Button."));

  SetProp (P_NAME, "'Ich wurde verarscht und hatte sogar Spass dabei'-Button");
  SetProp (P_GENDER, MALE);
  SetProp (P_WEIGHT, 1);
  SetProp (P_VALUE, 1);

  SetProp (P_ARMOUR_TYPE, AT_MISC);  
  SetProp (P_AC, 0);
  SetProp (P_AUTOLOADOBJ, 1);
  SetProp (P_WORN_TEXT, "angesteckt");
  SetProp (P_MATERIAL, MAT_MISC);
}
