//brotfrucht

inherit "std/food";

#include <properties.h>
#include <food.h>
#include "files.h"

create()
{
  if (!is_clone(ME)) return;
  ::create();
  SetProp (P_SHORT, "Ein Schinken einer Tropensau");
  SetProp (P_LONG, "Dieser Schinken gehoerte einst einer Tropensau.\n");
  SetProp (P_NAME, "Tropensauschinken");
  SetProp (P_GENDER, MALE);
  AddId (({"SCHINKEN", "schinken","sauschinken", "tropensauschinken"}));
  SetProp (P_VALUE, 0);
  SetProp (P_WEIGHT, 90);
  SetProp (P_NOBUY, 0);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_NODROP, 1);
  SetProp (P_MATERIAL, MAT_FLESH);
  SetProp (P_FOOD_INFO, ([F_HEAL: 5, F_SOAK: 3, F_ALCOHOL: 0, F_POISON:0]));
}

BeimEssen()
{
  write ("Du isst den Schinken.\n");
  say (TPN+" verspeisst einen Tropensauschinken.\n");
  return ::BeimEssen();
}
