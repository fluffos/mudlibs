inherit "std/thing";

#include <properties.h>

object pl;
create()
{
  ::create();
  if (!is_clone(this_object())) return;
  AddId("trip");
  SetProp (P_SHORT, 0);
  SetProp (P_NAME, 0);
  SetProp (P_NEVERDROP, 1);
  SetProp (P_NODROP, 1);
  SetProp(P_INVIS);
  SetProp (P_WEIGHT, 0);
  call_out ("remove", 15);
  AddCmd ("", "no", 1);
  pl=0; 
}



int remove()
{
  if (pl)
    catch(tell_object (pl, ""));
  return ::remove();
}

int no()
{
  write (" \n"
         "Was willst Du denn ? Du stuerzt doch gerade in den Tod...\n"
         " \n");
  return 1;
}
