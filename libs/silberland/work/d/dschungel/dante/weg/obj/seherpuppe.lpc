/*
eine kleine puppe die einen seher darstellt by dante aus einer idee
von woody heraus...

*/
inherit "std/weapon";
#include <properties.h>
#include <combat.h>
#include <language.h>
#include <wizlevels.h>
#include "/players/dante/myowndefine.h"
#define TIME 30
#define USES 20

knuddeln_moeglich();

int runden=5+random(5);
int leiche=0;

int sp_abzug=25;
int hp_abzug=10+random(10);

string namen="";
int moeglich=1;
int counter=0;








create()
{
  if (!is_clone(this_object()))
     return;
  ::create();

  AddId (({"puppe","seherpuppe","seher"}));
  SetProp (P_SHORT, "Eine kleine, aengstliche Seherpuppe aus Stoff");

SP(P_LONG, "\t"+BS(
"Du siehst nun eine kleine, aengstlich dreinblickende Puppe aus Stoff vor Dir. "
"Dir Puppe sieht fast weinerlich aus und jeden Moment koennen ihr die Traenen "
"aus den Augen rollen. Sie stellt einen typischen Seher dar und es sieht so aus "
"als wenn neben ihrer Aengstlichkeit auch eine grosse Portion Unzufriedenheit, "
"Unverschaemtheit und Motzerei zu ihren Haupteigenschaften gehoeren wuerde. "
"Irgendetwas passt der Puppe auf jeden Fall nie! Hmm, aber mit der Puppe "
"kann man sicher noch mehr machen...")+"@@long_fun@@");

  SetProp (P_NAME, "Stoffseherpuppe");
  SetProp (P_GENDER, FEMALE);
  SetProp(P_NAME_ADJ,  ({"klein","aengstlich"}));
  SetProp (P_WEIGHT, 10);
  SetProp (P_VALUE, 555);
  SP(P_INFO, BS(
  "Bring die Seherpuppe irgendwie um, benenne sie nach einem Spieler und "
  "knuddle die Puppe!!! <benenne spielername>"));
  
   SetProp (P_NR_HANDS, 1);
  SetProp(P_WEAPON_TYPE, WT_CLUB);
  SetProp(P_WC, 50);
  SetProp (P_MATERIAL, ([MAT_COTTON:80, MAT_MAGIC:20]));
 SP(P_WIELD_FUNC, TO);
 SP(P_UNWIELD_FUNC, TO);
 SP(P_HIT_FUNC, TO);
ACD(({"benenne","benennen","benenn"}), "gib_namen");
ACD(({"knuddle","knuddel"}), "knuddle_puppe"); 

 }
 
 
 int knuddle_puppe(string str)  {
 	object opfer;
 
 if(str=="leiche"||str=="puppe"||str=="seherpuppe")  {
 
 write(BS( 		
 "Du knuddelst "+name(WEN)+"."));
 say(BS(
 CAP_TPN+" knuddelt "+name()+"."));
 


if(namen=="")  {
	write(BS(
    "Du musst der Puppenleiche einen Namen geben um einen Effekt zu erzielen!"));
    return 1; }	


if(moeglich==0)  {
     write(BS(
     "Momentan scheint es mit der Magie der Puppe nicht so zu klappen. "
     "Warte ein wenig."));
     return 1;    }
     



opfer=find_living(namen);

     
     	

  
	
if(!opfer )  {
	
	write(BS(
         "Ich kann Spieler "+CAP(namen)+" leider nicht finden!"));
          return 1;  }	

if(opfer->QP(P_INVIS))  {
	write(BS(
         "Ich kann Spieler "+CAP(namen)+" leider nicht finden!"));
          return 1;  }		


if(!interactive(opfer))  {
      write(BS(
     "Nein! "+opfer->QP(P_SHORT)+" ist kein Spieler!"));
     return 1; }
     
     
if(opfer->QP(P_GHOST))  {
 
	write(BS(
  "Leider ist "+opfer->name()+" momentan ein Geist!"));
  return 1; }

if(IS_WIZARD(opfer) )  {
    
    tell_object(opfer,
    CAP(getuid(TP))+" wollte Dich mit Dantes Seherpuppe quaelen!!!\n");
    	
     write(BS(
    opfer->name()+" ist doch ein Magier und kein Seher!"));
    write(BS(
    opfer->name()+" gibt Dir eine Ohrfeige!"));
    TP->AddHp(-10);
    
    return 1; }
    

if(!IS_SEER(opfer))  {
	write(BS(
	"Aber "+opfer->name()+" ist doch gar kein Seher!"));
	return 1;  }
	

if(opfer->InFight())  {
	write(BS(
"Leider ist "+opfer->name()+" mitten in einem Kampf!"));
  return 1; }


if(TP->QP(P_SP) <= sp_abzug )     {
	
	write(BS(
  "Du hast leider zuwenig Magie im Moment!"));  
    return 1;  }


write(
"Ploetzlich kreischt "+CAP(namen)+" auf und weint und heult laut!\n"
"Vor Deinem geistigen Auge entsteht ein amusantes Bild:\n\n"
"Du siehst wie "+opfer->name(WER)+" zusammenzuckt und ploetzlich laut "
"zu weinen und heulen beginnt. So eine Memme!!! Was fuer ein Waschlappen "
"von Seher! Was fuer ein Jammerlappenseher! "+opfer->name(WER)+" ist ein "
"echter Wurstseher!\n\n");

    if(getuid(TP)==getuid(opfer))  {

write(BS(
"Bitte, wenn es Dir Spass macht, dann quaele Dich selbst!"));
return 1;  }


//opfer->AddHp(-hp_abzug);
TP->AddSp(-sp_abzug);

tell_object(opfer,
"Ploetzlich fuehlst Du Dich von einer unbekannten, sehr starken Macht geknuddelt. "
"ARGHHH, das schmerzt!!! Du heulst laut auf und beginnst zu weinen. Still "
"jammerst Du dann vor Dich hin, im Bewusstsein ein echter Wurstseher zu sein! "
"Eben ein echter Waschlappen! Du bist eben nur ein Jammerlappen von einem Seher! "
"Dicke Traenen rollen Dir aus den Augen ueber Dein weinerliches und aengstliches "
"Gesicht! Schaem Dich!\n\n"
"Du hoerst wie sich "+TPN+" halbtot lacht!\n");

tell_room(environment(opfer),
"Ploetzlich sieht Du wie "+opfer->name(WER)+" von einer unbekannten, sehr starken Macht geknuddelt wird. "
"ARGHHH, das schmerzt!!! "+opfer->name(WER)+" heult laut auf und beginnt zu weinen. Still "
"jammert "+opfer->QueryPronoun(WER)+" dann vor Dich hin, im Bewusstsein ein echter "
"Wurstseher zu sein! "
"Eben ein echter Waschlappen! "+opfer->name(WER)+" ist eben nur ein Jammerlappen von einem Seher! "
"Dicke Traenen rollen "+opfer->QueryPronoun(WEM)+" aus den Augen ueber das weinerliche und aengstliche "
"Gesicht! Schaemen soll sich "+opfer->name(WER)+"!\n\n"
"Du hoerst wie sich "+TPN+" halbtot lacht!\n",
({opfer}));

    write_file("/d/dschungel/dante/weg/log/seherpuppe",
  ctime()+": !"+opfer->name()+" wurde von "+CAP(getuid(TP))+" geknuddelt.\n");

call_out("knuddeln_moeglich", TIME);

moeglich=0;
counter++;

if(counter>=USES)  {
     write(BS(
     "Die Seherpuppe zerplatzt ploetzlich!"));
     call_out("weg_damit", 1);
     }
     	
return 1;
 
     }
 
} 
 
 
 weg_damit(){
  remove(); 
   return; }	
 
 
 knuddeln_moeglich()  {

moeglich=1;

    if(!environment(TO))  { return;  }
    if(!interactive(environment(TO))) { return; } 
 
    tell_object(environment(TO),
    QP(P_SHORT)+" kann nun wieder erfolgreich geknuddelt werden.\n");
    
                       }
 
 
 
 
 
 int gib_namen(string str)   {
   NF("Wie willst Du die Puppe benennen?!\n");
   if(!str) return 0;
   
   if(str)  {

   		
 if(leiche!=0)  {

namen=str;
 	write(BS(
 "Du gibts der Leiche den Namen "+CAP(namen)+". Ein guter Name!"));
        TO->SP(P_NAME, "Seherpuppenleiche namens "+CAP(namen)+"");
  TO->SP(P_SHORT,
  "Die Leiche einer Seherpuppe namens "+CAP(namen)+"");
  TO->SP(P_LONG, BS(      
  "Das ist die kleine Leiche einer ehemals aengstlichen Seherpuppe aus Stoff. "
  "Sie war immer ein Jammerlappen und sehr weinerlich. "+CAP_TPN+" "
  "hat sie umgebracht! Sie hat den Namen "+CAP(namen)+" bekommen!"));
        
             if(getuid(TP)==""+namen+"")  {
 	write(BS(
 	"Bitte, wenn Du willst auch Deinen eigenen Namen!"));
 	  }
         return 1; }
 
 
  if(leiche==0)  {
  	write(BSA(
    "NEIN! Bitte nicht, ich will keinen solchen ekligen Namen wie"
    " "+CAP(str)+" haben!",
    "Die Seherpuppe weint: "));
    
    write(BS(
    "Du denkst . o O'Ich sollte sie irgendwie umbringen!'!"));
    return 1;  }
         
         return 0;
          }
    return 0;
    }
   
   

string extra_look()
{
	if(leiche==0)  {
  return( CAP(ENV(TO)->QueryPronoun(WER))+" hat eine kleine weinerliche Seherpuppe in einer Hand!\n");
}

return( CAP(ENV(TO)->QueryPronoun(WER))+" hat eine kleine Leiche einer Seherstoffpuppe in einer Hand!\n");

                    }
                    
                    
                    
                    
   int UnwieldFunc(object waffe)   {   	
   	
   if(leiche==0)  {	
    say(BS(
     "Die kleine laecherliche Seherpuppe von "+TP->name(WEM)+" heult und weint "
     "laut auf als "+TPN+" sie aus der Hand geben will."));    
    
    write(BS(
    "Die weinerliche Seherpuppe jammert laut als Du sie aus den Haenden geben willst."));
          }

 
 say(BS(
     "Die kleine Leiche einer Seherpuppe von "+TP->name(WEM)+" schweigt "
     "als "+TPN+" sie aus der Hand geben will."));    
    
    write(BS(
    "Die kleine Leiche der Seherpuppe schweigt wie ein Grab als Du sie aus der geben Hand willst."));


       
    return 1;  }
    
    
    
    
    
    
   int WieldFunc(object waffe)  {
   
             if(leiche==0)  {	  
             say(BS(
        "Die weinerliche Seherpuppe von "+TP->name(WEM)+" freut sich sehr als "
        "sie von "+TP->name(WEM)+" in die Hand genommen wird!"));    	            
        
   write(BS(
   "Die weinerliche Seherpuppe freut sich als Du sie in die Hand nimmst "
   "und sieht Dich dabei aus ihren aengstlichen Augen an!"));                 
     }

if(leiche!=0)  {
	
 say(BS(
     "Die kleine Leiche einer Seherpuppe von "+TP->name(WEM)+" schweigt "
     "als "+TPN+" sie in die Hand nimmt."));    
    
    write(BS(
    "Die kleine Leiche der Seherpuppe schweigt wie ein Grab als Du sie in die Hand nehmen willst."));
      }
	
   return 1; 
   
    }






     
     
     int HitFunc(object enemy)    {
 object pl;
 pl=TP;

if(leiche==0)  {     

     write(
     "Die Seherpuppe weint laut und bittet Dich aufzuhoeren als Du mit ihr auf"
     " "+enemy->name(WEN)+" einschlaegst! Sie hat angeblich unertraegliche Schmerzen.\n");
      
      tell_object(enemy,
      CAP_TPN+" schlaegt mit einer weinerlichen Seherpuppe auf Dich ein "
      "und dabei bruellt die aengstliche Seherpuppe wie eine Memme!\n");

       
        runden--;                    
       
        if(runden<=0)  {

     write("\n");
     write(BS(
     "Die Seherpuppe bruellt extrem laut auf und stirbt dann vor lauter Angst "
     "und Aufregung an einem Herzinfarkt."));
write("\n");

        tell_object(enemy,
      "Die Seherpuppe von "+TP->name(WEM)+" bruellt extrem laut auf und "
      "stirbt dann an einem Herzinfarkt.\n");
          
    //call_out("frieden", 0, enemy);
          
  TO->SP(P_NAME, "Seherpuppenleiche");
  TO->SP(P_SHORT,
  "Die Leiche einer Seherpuppe");
  TO->SP(P_LONG, BS(      
  "Das ist die kleine Leiche einer ehemals aengstlichen Seherpuppe aus Stoff. "
  "Sie war immer ein Jammerlappen und sehr weinerlich. "+CAP(getuid(TP))+" "
  "hat sie umgebracht!"));
  AddId("leiche");
  leiche=1;
                        }

                  }
        }
                    
                    
                  frieden(object feind)  {
       feind->StopHuntFor( QueryProp(P_WIELDED));
           QueryProp(P_WIELDED)->StopHuntFor(feind);
          }


          
           
                    
string long_fun()   {
	
 if(IS_SEER(TP))  {

if(!IS_WIZARD(TP))  {
     if(TP->QP(P_LEVEL)<45)  {
	  return (
        "Die Puppe sieht genauso aus wie "+CAP(getuid(TP))+"! Huch, das bist ja DU! "
        "Seher sind ja allesamt Waschlappen!\n");
                }

        if(TP->QP(P_LEVEL)>=45)  { 
	 return (
        "Die Puppe sieht genauso aus wie "+CAP(getuid(TP))+"! Huch, das bist ja DU! Ihr "
        "Erzseher seid ja noch schlimmer als die normalen Seher!\n");
                }
        }
}
	
if(IS_WIZARD(TP))  {
    return (
    "Du "+CAP(getuid(TP))+", bist Magier und kennst die Jammerlappen von Seher ja sowieso...\n");
               }


  return (
  ""+CAP(getuid(TP))+", Du bist noch Spieler, wirst aber sicher auch einmal so ein verweichlichter "
  "Jammerlappen von Seher werden.\n");

     }




varargs int move(mixed dest, int method)
{
  int res;
  object e_prev,e;

  e_prev=MENV;
  res = ::move(dest,method);
  e=MENV;
  if (e_prev && e)
    if (interactive(e_prev) && (ENV(e_prev) == e))
      tell_object(e_prev,
          QP(P_SHORT)+" sieht Dich jammerlappenmaessig an, als Du sie wegwirfst!!!\n");
    else if (interactive(e) && (ENV(e) == e_prev))
      tell_object(e,
          QP(P_SHORT)+" schaut Dich weinerlich an, als Du sie nimmst.\n");
  return res;
}