//brotfrucht

inherit "std/thing";

#include <properties.h>
#include "files.h"

create()
{
  if (!is_clone(ME)) return;
  ::create();
  SetProp (P_SHORT, "Ein Paradiesvogelei");
  SetProp (P_LONG,
  "Das ist das Ei eines Paradiesvogels.");
  SetProp (P_NAME, "Paradiesvogelei");
  SetProp (P_GENDER, NEUTER);
  AddId (({"paradiesvogelei","vogelei", "ei"}));
  SetProp (P_VALUE, 1);
  SetProp (P_WEIGHT, 1);
  SetProp (P_NOBUY, 0);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_NODROP, 1);
  SetProp (P_MATERIAL, ({MAT_FOOD, MAT_HORN}));
}
