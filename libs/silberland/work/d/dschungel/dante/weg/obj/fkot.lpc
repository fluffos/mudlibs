
#include "/players/dante/myowndefine.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Ein Haufen Flaffenkot");
  SetProp(P_LONG, BS( 
    "Ein ekliger, grauer Batzen Flaffenkot. Man kann erkennen, dass der Flaffe Bananen und Wuermer gegessen hat.") );
  SetProp(P_NAME, "Flaffenkot");
  SetProp(P_GENDER, MALE);
  AddId(({"flaffenkot","kot"}));
  SetProp(P_MATERIAL, ([ MAT_SHIT:100]) );
  SP(P_NOGET, 0+random(2) );
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 0);
SP(P_SMELL, "WAEHH!!! Das stinkt ja!!!\n");
}
