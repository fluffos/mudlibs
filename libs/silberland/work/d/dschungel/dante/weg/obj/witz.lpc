//papagei

inherit "std/thing";

#include <properties.h>
#include <moving.h>
#include <combat.h>
#include <ansi.h>
#include <language.h>
#include "/players/dante/myowndefine.h"

 witz();



create()
{
  if (!is_clone(this_object())) return;
  ::create();


  SetProp(P_SHORT,"Ein Witz");
  SetProp(P_LONG, BS(
"Das ist ein Witz. Ein moederisch guter Witz. Wenn Du ihn lesen willst. "
"Dann tippe einfach 'lies witz'. Viel Spass. ACHTUNG! Dieser Witz "
"koennte Dich WIRKLICH toeten!!!"));


  AddId( ({ "killing_joke", "witz"}) );
  SetProp(P_NAME,"Witz");
  SP(P_NAME_ADJ, "moerderischgut");
  
  SetProp(P_GENDER, MALE);
  SP(P_MATERIAL, ([MAT_MISC_MAGIC: 100 ]));
  SetProp(P_WEIGHT,0);
  SP(P_VALUE, 99);
SP(P_KILL_NAME, "Ein moerderischguter Witz");
SP(P_KILL_MSG, "HAHA! Ich lach mich tot!");

ARD("witz", #'witz);

}


      mixed witz()  {
      	int dam;
     	write(BS(
     	"Du liest den Witz und beginnst zu lachen und lachst und lachst "
     	"und lachst....Dich tot!"));
     	
    
      tell_room(environment(TP),
      CAP_TPN+" lacht sich tot.\n", ({TP}));
     
       if(TP->InFight())  {
       	TP->die();  
       	 write_file("/d/dschungel/dante/weg/log/witz",
    ctime()+": "+CAP(getuid(TP))+" stirbt am Witz.\n"); 
     }
       
       else
       
      dam=TP->QueryProp(P_MAX_HP)/2+ TP->QueryProp(P_LEVEL);
     TP->do_damage(dam);
    	 write_file("/d/dschungel/dante/weg/log/witz",
    ctime()+": "+CAP(getuid(TP))+" verliert "+dam+" LPs am Witz.\n"); 

       call_out("remove", 1);
       return "\n";
        }
           	