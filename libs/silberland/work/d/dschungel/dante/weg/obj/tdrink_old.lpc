//tragbare heilung nur trinken

inherit "std/thing";

#include <properties.h>
#include "files.h"

int full=5;


create()
{
  if (!is_clone(ME)) return;
  ::create();
  SetProp (P_SHORT, "Eine Flasche Magier-Blut");
  SetProp (P_LONG, BS("In dieser Flasche hat irgendjemand Magierblut gesammelt. "
  "Rot und dick schwappt es traege hin und her."));
  SetProp (P_NAME, "Magierblut");
  SetProp (P_GENDER, MALE);
  SetProp (P_VALUE, 3000);
  SetProp (P_WEIGHT, 100);
  SetProp(P_SIZE, 20);
  SetProp (P_NOBUY, 1);
  SetProp(P_INFO, ("Das Blut wirkt auch gegen Vergiftungen...\n"));
  AddId (({"blut","magierblut","flasche"}));
  SetProp(P_MATERIAL, ([MAT_BLOOD:100, MAT_MAGIC:10, MAT_GLASS:30]));
AddCmd( ({"trinke","trink"}), "trinken");
}
int trinken(string str)
{
  int md,ma;
    notify_fail("Was willst Du trinken?\n");
        ma=this_player()->QueryProp(P_ALCOHOL);
          md=this_player()->QueryProp(P_DRINK);

 if (id(str) ) {
             
            if (md>94||ma>75) {
                 write ("Soviel kannst Du nicht trinken.\n");
                      return 1;
            }
 

         
         
        if(TP->QueryProp(P_POISON)==0) 
        
         {
       write("Du trinkst das Blut und fuehlst Dich vampirmaessig gut.\n");
        
         this_player()->heal_self(50);
         this_player()->SetProp(P_DRINK,md+5);
        this_player()->Setprop(P_ALCOHOL,ma+15);

                full--;
             if(full<1)  {
              
              write(BS(
              "Deine Flasche explodiert!"));
                          
                      remove();
                           }
                return 1;
                  }


        
        if(TP->QueryProp(P_POISON)>0) 
         {
       write("Du trinkst das Blut und fuehlst Dich vampirmaessig gut.\n"
       "Deine Vergiftung ist verschwunden!\n");
         this_player()->heal_self(25);
         this_player()->SetProp(P_DRINK,md+5);
        this_player()->Setprop(P_ALCOHOL,ma+15);
               this_player()->AddPoison(-full);           
    write(BS(
              "Deine Flasche explodiert!"));
         remove(); 
                return 1;
                  }
                  
             }         
     }
     
            
