//brotfrucht

inherit "std/thing";

#include <properties.h>
#include "files.h"

create()
{
  if (!is_clone(ME)) return;
  ::create();
  SetProp (P_SHORT, "Ein Feuerstein");
  SetProp (P_LONG, "Ein Feuerstein. Was kann man damit wohl machen?\n");
  SetProp (P_NAME, "Feuerstein");
  SetProp (P_GENDER, MALE);
  AddId (({"FEUERSTEIN", "stein", "feuerstein"}));
  SetProp (P_VALUE, 1);
  SetProp (P_WEIGHT, 30);
  SetProp (P_NOBUY, 0);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_INFO, ("Mit dem Feuerstein kann man Feuer machen, was sonst?!?!?\n"));
  SetProp (P_MATERIAL, MAT_STONE);
}
