/*eine frucht fuer die mumie..dante nach birne woody
**
** 
** 
*/

inherit "std/food";

#include <properties.h>
#include <food.h>
#include "files.h"

create()
{
  if (!is_clone(ME)) return;
  ::create();
  SetProp (P_SHORT, "Eine Frucht");
  SetProp (P_LONG, "Eine Dir unbekannte Frucht, die aber komischerweise noch "
                   "geniessbar aussieht. Vielleicht solltest Du sie kosten?\n");
  
  
  SetProp (P_NAME, "Frucht");
  SetProp (P_GENDER, FEMALE);
  AddId ("frucht");
  
  SetProp (P_VALUE, 50);
  SetProp (P_WEIGHT, 100);
  SetProp (P_NOBUY, 1);
  SetProp (P_MATERIAL, MAT_FOOD);
  SetProp (P_FOOD_INFO, ([F_HEAL:15, F_SOAK:5, F_ALCOHOL:1, F_POISON:0]));
}

BeimEssen()
{
  write ("Du verspeist die Frucht mit einem seltsamen Gefuehl.\n");
  say (TPN+" verspeisst die Frucht mit seltsamen Gesichtsausdruck.\n");
  return ::BeimEssen();
}
