
inherit "std/thing";

#include <properties.h>
#include <moving.h>
#include "files.h"
#include <wizlevels.h>


init()  {
	::init();
	if(!is_clone(TO))  { remove(); return;  }
	

if(!environment(TO))  { remove(); return;  }

if(!interactive(environment(TO))) { remove(); return;  }

}



object player;
create() 
{

::create();
if (!is_clone(this_object())) return;
SetProp(P_NAME, "Staubschicht");
SetProp(P_NAME_ADJ, "dick");
SetProp(P_SHORT, "Eine dicke Staubschicht");
SetProp(P_LONG, "Eine dicke Staubschicht. Eklig!\n");
SetProp(P_NEVERDROP, 1);
SetProp(P_SHOW_INV, 1);
SetProp(P_NODROP, 1);
SetProp(P_GENDER, FEMALE);
AddId (({"staub","staubschicht"}));
call_out("st1", 20);
//SetProp(P_EXTRA_LOOK, ""+TPN+" ist ueber und ueber mit Staub bedeckt.\n");
SetProp(P_WEIGHT, 0);
AddDetail("staub", "Du bist total verstaubt.\n");
}


  
 st1()
 
 {
 
 
 player=this_player();
 write(
       "Etwas Staub faellt von Deinem Kopf...\n");
  say(capitalize(player->name())+" sieht etwas verstaubt aus.\n");     
       
 call_out("st2",25);           
 
  }  
      
st2()
 { say(capitalize(player->name())+" verliert etwas Staub...\n");
 
 write("Ein kleiner Staubwuzzel faellt von Deinem Kopf...\n");
      call_out("st3",25); 
       }
       
 st3()
 { 
  say(capitalize(player->name())+" sieht sehr staubig aus.\n");
   write(
        "Es staubt wenn Du Dich bewegst.\n");
  call_out("story4", 25);
  }           
  story4()
  { 
   say(capitalize(player->name())+" staubt stark.\n");
   write(
        "Du siehst sehr verstaubt aus.\n");
  call_out("story5", 50);
  }
  
  story5()
  {
remove();
return ;
}
