//dante 97 dez
//macht spieler fuer einen zeitlang 1 haendig da schlangenbiss

inherit "std/thing"; 
#include <language.h>
#include <properties.h>
#include <combat.h>
#include <defines.h>
#include <moving.h>
#include "files.h"

create()

{ if(!is_clone(this_object())) return;
  thing::create();
  SetProp(P_SHORT, 0);
  SetProp(P_LONG, 0);

 call_out("weg", 1000);
  SetProp(P_VALUE,0);
  SetProp(P_WEIGHT,0);
  SetProp(P_GENDER, MALE);
  SetProp(P_NAME,0);
  TP->SetProp(P_HANDS, 1);
  AddId(({hands","nohands"}));
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
 SetProp(P_NODROP, 1);
 SetProp(P_NEVERDROP, 1);
 call_out("check", 0);
 
 
}


 check()
 {
 ob=(TP->QueryProp(P_WEAPON))
 if( present(TP, ob))
 {
 ob->move(environment(TP));
 write("Deine Waffe faellt zu Boden, da Du sie wegen dem Schlangebiss nicht "
 "mehr halten kannst.");
 }
 
 }
 
 
 
weg()
{
 TP->SetProp(P_HANDS, 2);
 write("Du kannst Deine zweite Hand nun wieder verwenden. Die Verletzung "
 "scheint sich gebessert zu haben.\n");
 remove();
 }
 