//tragbare heilung nur trinken
// 29.9.2002 Auf std/food umgestellt Feyaria@SilberLand

inherit "std/food";

#include <properties.h>
#include <food.h>
#include "files.h"

int full=0;
object owner;

void create()
{
  if (!is_clone(ME)) return;
  ::create(({"trink", "trinke"}));
  SetProp (P_SHORT, "Eine Flasche Magier-Blut");
  SetProp (P_LONG, BS("In dieser Flasche hat irgendjemand Magierblut gesammelt. "
  "Rot und dick schwappt es traege hin und her."));
  SetProp (P_NAME, "Magierblut");
  SetProp (P_GENDER, NEUTER);
  SetProp (P_VALUE, 3000);
  SetProp (P_WEIGHT, 100);
  SetProp (P_SIZE, 20);
  SetProp (P_NOBUY, 1);
  SetProp (P_INFO, ("Das Blut wirkt auch gegen Vergiftungen...\n"));
  AddId (({"blut","magierblut","flasche"}));
  SetProp (P_MATERIAL, ([MAT_BLOOD:60, MAT_MAGIC:10, MAT_GLASS:30]));
  SetProp(P_FOOD_INFO, ([
        F_HEAL:50, F_DRINK: 5, F_ALCOHOL: 5, F_POISON: 0,
        F_MSG: "Du trinkst das Blut und fuehlst Dich vampirmaessig gut.\n",
        F_MSG_ROOM : "trinkt einen Schluck Magierblut.\n",
        F_VERB: "trinken"]) );
}

int second_life(object pl)
{
  if (pl->QueryProp(P_POISON)) 
  {
    pl->AddPoison(-full);
    if (pl->QueryProp(P_POISON)) 
      write("Deine Vergiftung verringert sich ");
    else
      write("Deine Vergiftung verschwindet ");
    write("und die Flasche mit Magierblut explodiert!\n");
    return 0;
  }
  full--;
  if(full<1)
  {
    write("Die Flasche mit Magierblut explodiert!\n");
    return 0;
  }
  SetProp(P_FOOD_INFO, QueryProp(P_FOOD_INFO) + ([F_HEAL: 10*full]) );
  return 1;
}

int wizards(object ob)
{
  if( IS_LEARNER(ob) && !ob->QueryProp(P_INVIS))
    return 1;
  return 0;
}

string random_wiz()
{
  object *wizes;
  wizes = filter_array(users(), "wizards");
  if( sizeof(wizes) )
    return wizes[random(sizeof(wizes))]->Name();
  else
    return "Ein Magier";
}

void reset()
{
  ::reset();
  if( full>1 && owner && interactive(owner) && !random(5))     // Netztote ausnehmen
  {
    full--;
    SetProp(P_FOOD_INFO, QueryProp(P_FOOD_INFO) + ([F_HEAL: 10*full]) );
    tell_object(owner, random_wiz()+" kommt an und trinkt etwas von Deinem "
        "Magierblut!\n");
  }
}

varargs int move(mixed dest, int method)
{
  if( !full && query_once_interactive(dest) )
  {
    full = 5;
    owner = dest;
  }
  return ::move(dest, method);
}

