//brotfrucht

inherit "std/thing";

#include <properties.h>
#include "files.h"
int x=0;
create()
{
  if (!is_clone(ME)) return;
  ::create();
  SetProp (P_SHORT, "Eine Pfanne");
  SetProp (P_LONG, "Eine Pfanne voller herrlichem Omelett.\n");
  SetProp (P_NAME, "Pfanne");
  SetProp (P_GENDER, FEMALE);
  AddId (({"pfanne", "PFANNEFERTIG"}));
  SetProp (P_INFO, ("Bring die Pfanne sofort dem Waechter, sonst wird alles kalt.\n"));
  SetProp (P_VALUE, 0);
  SetProp (P_WEIGHT, 200);
  SetProp (P_NOBUY, 0);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_NODROP, 1);
  SetProp (P_MATERIAL, ({MAT_STEEL, MAT_FOOD}));
}


reset(){
::reset();
x++;
if(x==3)
  {
  write("Das Omelett wird kalt. Du wirfst die Pfanne weg!\n");
  remove();
  }
}
  
