
inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <wizlevels.h>
#include "/players/dante/myowndefine.h"


create()
{
  if(!is_clone(this_object())) return;
  ::create();

  AddId(({"PRIVATE_OBJ","ichbinich","ich"}));
  SetProp(P_SHORT, "Das kleine Ichbinich");
  SetProp(P_LONG, BS(
    "Das ist Dein kleines Ichbinich. Es ist mindestens so laestig, so frech, so "
    "motzig, so eine Nervensaege wie Du. Trotzdem ist es eigentlich lieb."));
  SetProp(P_NAME, "Ichbinich");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_NAME_ADJ, "klein");
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 100);
  SetProp(P_ARMOUR_TYPE, AT_MISC);
  SetProp(P_AC, 0);
  SetProp(P_MATERIAL, ([MAT_COTTON:20, MAT_MAGIC:80]));
}

string extra_look()
{
  return BS(CAP(ENV(TO)->QueryPronoun(WER))+" hat ein kleines Ichbinich auf "+
    "der Schulter sitzen!\n");
}
