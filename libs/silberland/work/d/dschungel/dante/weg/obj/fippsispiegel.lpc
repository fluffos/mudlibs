
inherit "std/thing";

#include <properties.h>
#include "/players/dante/myowndefine.h"

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp (P_SHORT, "Ein alter, dreckiger Spiegel");
  SetProp (P_LONG,BS (
  "Dieser Spiegel ist alt und zerbrochen. Er ist dreckverschmiert und "
  "sein Spiegelbild kann man darin schon gar nicht erkennen."));
  SetProp (P_NAME, "Spiegel");
  SP(P_NAME_ADJ, ({"alt", "dreckig"}));
  SetProp (P_GENDER, MALE);
  SetProp (P_VALUE, 0);
  SetProp (P_WEIGHT, 20);
  SetProp (P_NOBUY, 1);
  SP(P_INFO, 
   "Das soll der beruehmte Spiegel der Wahrheit sein?!\n");   
  SetProp (P_NEVERDROP, 1);
  AddId (({"\nfippsispiegel", "spiegel"}));
SetProp(P_MATERIAL, ([MAT_METAL:90, MAT_MISC_MAGIC:10]));
SP(P_NODROP, 1);
}
