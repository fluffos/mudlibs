#include "../def.h"

inherit "std/thing";

#include <properties.h>
object pl;
create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, 0);
  SetProp(P_INFO, "");
  SetProp(P_NAME, 0);
  AddId("ver");

  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 0);
  SetProp(P_NODROP, 1);
  call_out("remove", 20);
  pl = 0;
}
 int remove()
{
if (pl)
catch(tell_object (pl, ""));
return ::remove();
}
