//papagei

inherit "std/thing";

#include <properties.h>
#include <moving.h>
#include <combat.h>
#include <ansi.h>
#include <language.h>
#include "/players/dante/myowndefine.h"


string *farben=({ANSI_RED, ANSI_BLUE, ANSI_GREEN, ANSI_CYAN,
                 ANSI_WHITE,ANSI_YELLOW, ANSI_PURPLE});
int i;


create()
{
  if (!is_clone(this_object())) return;
  ::create();


  SetProp(P_SHORT,"Ein bunter Papagei");
  SetProp(P_LONG, BS(
"Dieser Papagei kann alles was Du willst sagen. "
"Ob er wirklich lebt ist unklar, denn er ist voellig steif und starr. "
"Er wirkt irgendwie magisch, er kann sicher etwas."));

SP(P_INFO, BS(
"Dieser Papagei kann alles sagen was Du willst. "
"syntax: <papageitext text>. "
"Die anderen Spieler sehen aber nicht, wer das wirklich gesagt hat, sondern "
"nur: Ein magischer Papagei sagt: text ."));

  AddId( ({"PAPAGEI", "papagei", "PRIVATE_OBJ"}) );
  SetProp(P_NAME,"Papagei");
  SP(P_NAME_ADJ, "bunt");
  
  SetProp(P_GENDER, MALE);
  SP(P_MATERIAL, ([MAT_MISC_MAGIC: 100 ]));
  SetProp(P_WEIGHT,10);
  SP(P_VALUE, 777);
  ACD(({"papageitext"}), "do_talk");

}

 int do_talk(string str)   {
  NF("Was soll der Papagei denn sagen?!\n");
  
  if(!str) return 0;

 // varargs int send(string ch, object pl, string msg, int type)
 // Angrox teilt Dir mit: ok. alles vorbereitet. id "\nelement_ring_feuer",
//Angrox teilt Dir mit: "\nelement_ring_eis", ... [21:49]
 write(BS(
 "Du befiehlst dem Papagei etwas zu sagen."));
    
i=random(sizeof(farben));

   str=this_player()->_unparsed_args();           
   
   tell_room(environment(this_player()),            
   
    break_string(
    ""+farben[i]+""+str+""+ANSI_NORMAL+"",
    78,""+ANSI_NORMAL+"Ein magischer Papagei sagt: "+farben[i]+""),
    ({this_player()}));           
   
    tell_object(this_player(),             
   break_string( ""+farben[i]+""+str+""+ANSI_NORMAL+"",78,""+ANSI_NORMAL+"Der Papagei sagt: "+farben[i]+""));                   
 
 
      return 1; }

     