//invis obj fuer jojo suizid
//dante 97 dez

inherit "std/thing"; 
#include <language.h>
#include <properties.h>
#include <combat.h>
#include <defines.h>
#include <moving.h>
#include "files.h"

void create()
{ 
  int muenz;
  if(!is_clone(this_object())) return;
  thing::create();
  muenz=10000+random(60000);
  SetProp(P_SHORT, muenz+" Muenzen");
  SetProp(P_LONG, "Du siehst "+muenz+" Muenzen.");
  SetProp(P_VALUE,10);
  SetProp(P_WEIGHT,10);
  SetProp(P_GENDER, FEMALE);
  SetProp(P_NAME, muenz+" Muenzen");
  SetProp(P_ARTICLE, 0);
  
  AddId(({"geld","muenzen"}));
  SetProp(P_NOBUY, 0);
  SetProp(P_NOSELL, 0);
  SetProp(P_NODROP, 0);
  SetProp(P_NEVERDROP, 0);
  SetProp(P_INFO, "Viel Geld!\n");
  SetProp(P_MATERIAL, MAT_METAL);
}
