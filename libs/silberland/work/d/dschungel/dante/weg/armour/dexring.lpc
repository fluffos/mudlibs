
/*
 * blaeulich schimmernder ring
 * hoehle wassergsit
 * ---
 * 
 */

#include "files.h"
#include <properties.h>
#include <combat.h>
#include <attributes.h>

inherit "std/armour";
int dex;

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  AddId(({"ring", "geschicklichkeitsring", "ring der geschicklichkeit",
      "wasserring", "dexring"}));
  SetProp(P_SHORT, "Ein blaeulich schimmernder Wasserring");
  SetProp(P_LONG,
    "Der Ring besteht aus einem Dir unbekanntem blaeulich schimmernden "
    "Kristall. In seinem Inneren scheint eine durchsichtige Fluessigkeit "
    "zu fliessen. Der Ring scheint eine verborgene Kraft zu haben...");
  SetProp(P_NAME, "Wasserring");
  SetProp(P_GENDER, MALE);
  SetProp(P_ARMOUR_TYPE, AT_RING);
  SetProp(P_AC, 1 + random(5));

  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 750+random(300));
  SetProp(P_MATERIAL, ([MAT_MISC_JEWEL:50, MAT_MISC_FLUID:50]));
  SetProp(P_MAGIC,1);
  SetProp(P_NOBUY, 1);
  SetProp(P_WEAR_RESTRICTIONS, ([P_LEVEL:15]) );
  SetProp(P_QUALITY_DECAY, ([ DT_FIRE : 140, DT_WATER : 0, 0 : 270 ]) );
  SetProp(P_DAM_PROTECTION, QueryProp(P_DAM_PROTECTION) + ([DT_WATER: 2]) );
  SetProp(P_INFO, BS(
    "Dieser Ring verleiht seinem Traeger moeglicherweise zusaetzliche "
    "Geschicklichkeit."));
  switch(random(100))
  {
    case 0..20: dex=-2; break;
    case 21..42: dex=-1; break;
    case 43..64: dex=0; break;
    case 65..86: dex=1; break;
    case 87..96: dex=2; break;
    case 97..99: dex=3; 
                 if (!random(10)) dex=4;
                 if (!random(100)) dex=5;
      break;
  }

  if(dtime(time())[0..6]=="Fre, 13") // Am Freitag dem 13. hat man eben pech
    dex=-random(6);
    
  //dex=-2+random(3)*random(3)+random(2)*random(2); 

  SetProp(P_CURSED,1);
  SetProp(P_NEVERDROP,1);

  SetProp (P_M_ATTR_MOD, ([ A_DEX:dex]) );  

  if(dex > 0 && this_player())
  {
    WLOG(LOG "wasserring", "findet einen +"+dex+" Wasserring");
  }
}


