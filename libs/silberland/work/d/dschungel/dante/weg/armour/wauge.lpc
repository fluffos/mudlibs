//kann blinde entblinden
//dante sl 98
//
//Aenderungen:
//
// 23/02/98 Thor: - Aufladen des Auges im reset() gemacht, das ist
//                  resourcenfreundlicher als ein call_out von 2000
//                - Objekt zerstoert sich nun nach 5 Entblindungen 
//                  selbst.

#include <properties.h>
#include <combat.h>
inherit "std/armour";
#include "files.h"
 
int ready, count=0;

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  ready = 1;
  SetProp(P_SHORT, "Das Wasserauge");
  SetProp(P_LONG,BS(
  "Das ist das beruemte Wasserauge des Spiegelgeistes! Es haengt an einer Kette "
  "mit deren Hilfe man es anziehen kann! Die Pupille des Auges scheint genau "
  "auf Dich gerichtet zu sein!"));
  AddDetail("pupille",
  "In Deinem Geist formt sich ein Wort: `opthalmolo'!");
  
  AddDetail("kette",
  "Zum anziehen!"); 
  SetProp(P_NAME, "Wasserauge");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_ARMOUR_TYPE, AT_AMULET);
  SetProp(P_AC, 4);
  SetProp(P_WEIGHT, 300);
  SetProp(P_VALUE, 2200);
  SetProp(P_NODROP, 1);
  SetProp(P_INFO, "Das Wasserauge kann Blinde sehend machen! Verwende es "
                 +"allerdings nur, wenn Du es unbedingt brauchst.\n");
  SetProp(P_MATERIAL, ([MAT_WATER:90, MAT_MISC_MAGIC:10]));
  AddId(({"amulett", "auge","wasserauge"}));
  AddCmd("opthalmolo", "done");
}

done()
{
  if (QueryWorn()!=this_player())
  {
    notify_fail("Du hast das Wasserauge nicht angezogen.\n");
    return 0;
  }
  if (!ready)
  {
    write("Das Wasserauge ist noch geschwaecht.\n");
    return 1;
  }
  
  if ((TP->QueryProp(P_BLIND)!=0)&&(ready))
  {
  write("Das Wasserauge blitz kurz auf, ein Strahl trifft Deine Augen und Du "
  "kannst wieder sehen!\n");
  
  say("Das Wasserauge von "+this_player()->name(WESSEN)+
      " blitzt kurz auf und ein Strahl trifft "+this_player()->name(WESSEN)+
      " Augen.\n");
  TP->SetProp(P_BLIND, 0);
  ready=0;
  count++;

  if(count>=5)
    {
    write(BS("Das Wasserauge hat seine ganze Energie aufgebraucht und "
            +"explodiert in einem kleinen Knall.\n"));
    TP->reduce_hit_point(15);
    ME->remove(1);
    return 1;
    }
  return 1;
  }
                
if ((TP->QueryProp(P_BLIND)==0)&&(ready))
  {
  say(""+TPN+" erblindet aus eigener Schuld!\n");          
  write("Du warst nicht blind! Dafuer bist Du es nun!\n"
  "Das Wasserauge laesst nicht mit sich Spassen!\n");
  TP->SetProp(P_BLIND, 500);
  ready=0;
  count++;

  if(count>=5)
    {
    write(BS("Das Wasserauge hat seine ganze Energie aufgebraucht und "
            +"explodiert in einem kleinen Knall.\n"));
    TP->reduce_hit_point(15);
    ME->remove(1);
    return 1;
    }
   return 1;
   }
  return 0;
}
    
reset()
{
  ::reset();
  write("Das Wasserauge blitzt kurz auf.\n");
  ready = 1;
}

//ende
