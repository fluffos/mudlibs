//minis haus

inherit "std/armour";

#include "files.h"
#include <wizlevels.h>
#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>

create()
{
  if (!is_clone(this_object()))
     return;
  ::create();

  AddId (({"haus", "minis haus","schneckenhaus"}));
  SetProp (P_SHORT, "Minis Schneckenhaus");
  SetProp (P_LONG, BS(
  "Das ist Minis Schneckenhaus. Es ist so klein, das man es als Helm verwenden kann."));
  
  SetProp (P_MATERIAL, ([MAT_HORN, MAT_CHITIN])); 
  SetProp (P_NAME, "Schneckenhaus");
  SetProp (P_GENDER, NEUTER);
  SetProp (P_WEIGHT, 300);
  SetProp (P_VALUE, 500);
  SetProp (P_ARMOUR_TYPE, AT_HELMET);
    SetProp (P_MATERIAL, ([MAT_HORN, MAT_CHITIN])); 
  SetProp (P_AC, 5);
}

