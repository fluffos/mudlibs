// 
// lumpen

#include "files.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Dreckige Lumpen");
  SetProp(P_LONG, BS( 
    "Die Lumpen sind nur mehr graue, stinkende Fetzen.") );
  SetProp(P_INFO, BS("Die kann man nur mehr wegwerfen.") );
  SetProp(P_NAME, "Lumpen");
  SetProp(P_GENDER, MALE);
  AddId( ({"lumpen", "fetzen"}) );
  
  SetProp(P_ARMOUR_TYPE, AT_ARMOUR );
  SetProp(P_AC, 10);
  SetProp(P_MATERIAL, MAT_CLOTH);
  SetProp(P_WEIGHT, 1000);
  SetProp(P_VALUE, 50);
  SetProp(P_NOBUY, 0);

}
