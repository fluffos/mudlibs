// suedlcih von tijara

#include "files.h"

inherit "std/room";
#include <moving.h>
#include <properties.h>
#include <language.h>
create()
{ 
  ::create();
  SetProp( P_INT_SHORT, "Auf dem Dschungelpfad" );
  SetProp( P_INT_LONG, BS(
        "Der Weg fuehrt Richtung Osten am Abgrund der Schlucht entlang. "
        "In der Tiefe rauscht der Fluss dahin, im Norden dichtester Dschungel. "
        "Die Vegetation ist hier sehr ueppig, besonders auffallend sind hohe "
        "Palmen, mit grossen runden Kokosnuessen.\n"
        "Eine umgefallene Tafel.\n")); 

  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_JUNGLE]) );
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);

  AddSound(DEFAULT_SOUND,
      "Der Wasserfall ist auch hier noch recht laut zu hoeren.");
  AddSmell(DEFAULT_SMELL,
      "Du riechst das frische, saubere Wasser des Rio de la Puseta.");
  AddDetail( ({"vegetation"}),
      "Die Vegetation ist hier sehr ueppig, besonders auffallend sind hohe "
      "Palmen, mit grossen runden Kokosnuessen.");
  AddDetail("tafel",
      "Die Tafel ist leider umgefallen und liegt hier einfach so herum "
      "und wartet bis sie vermodert. Du kannt ja probieren sie zu lesen.");
  AddReadDetail("tafel",
      "+-------------------------+\n"
      "|           ZUR           |\n"
      "|          STADT          |\n"
      "|           DER           |\n"
      "|       STEINGIGANTEN     |\n"
      "+-------------------------+\n");

  AddDetail(("norden"),
      "Im Norden ist der Dschungel sehr dicht und ueppig.");
  AddDetail(("dschungel"),
      "Der Dschungel scheint hier uneindringbar zu sein. Die hohen Palmen "
      "gefallen Dir besonders gut. Auch ein Zwergdschungelhickory faellt Dir auf.");
  AddDetail(({"zwergdschungelhickory","hickory","zwerghickory","dschungelhickory"}),
      "Der Zwergdschungelhickory ist ein Baum der bekannt ist fuer sein besonders "
      "hartes Holz. Normalerweise waechst der Hickory nur im hohen Norden...");
  AddDetail(("baum"),
      "Baeume gibt es im Dschungel viele...");
  AddDetail(({"palme","palmen"}),
      "Die Palmen wachsen hier besonders hoch. Sie tragen runde, grosse Kokosnuesse, "
      "haben gewaltige Palmblaetter und spenden herrlichen Schatten.");
  AddDetail(("schatten"),
      "Der Schatten ist Dir bei dieser Hitze sehr willkommen.");
  AddDetail(({"palmblaetter","blaetter"}),
      "Die Palmblaetter sind riesengross...");
  AddDetail(({"kokosnuesse","kokosnuss"}),
      "Du wuerdest gerne eine pfluecken, aber hier sind keine fuer Dich zu erreichen.");
  AddDetail(("nuss","nuesse"),
      "Du meinst doch sicher Kokosnuesse...");
  AddDetail(("weg"),
      "Der Weg fuehrt leicht abwaerts gen Osten immer sehr nahe an der Schlucht entlang.");
  AddDetail(("osten"),
      "Der Weg fuehrt hier Richtung Osten weiter...");
  AddDetail(("richtung"),
      "Die Schlucht verlaeuft hier in Ost-West Richtung.");
  AddDetail(("westen"),
      "Im Westen liegt der Pfad und noch weiter im Westen der Wasserfall.");
  AddDetail(("wasserfall"),
      "Der Wasserfall ist auch von hier noch zu erkennen.");
  AddDetail(("pfad"),
      "Der Pfad liegt weiter im Westen");
  AddDetail(({"schlucht", "abgrund"}),
      "Du stehst hier gefaehrlich nahe am Rand der Schlucht.");
  AddDetail(("rand"),
      "Der Rand der Schlucht ist nur wenige Meter von Dir entfernt. "
      "In ihrer Tiefe rauscht ein grosser Fluss dahin. Dir faellt auch ein Felsen auf.");
  AddDetail(("felsen"),
      "Als Du Dir den Felsen naeher betrachtest, entdeckst Du einen kleinen, extrem "
      "steilen Felsweg.");
  AddDetail(("felsweg"),
      "Der Felsweg fuehrt nahezu senkrecht die Felswaende hinunter...");
  AddDetail(({"waende","wand","felswaende","felswand"}),
      "Die Felswaende fallen senkrecht zum Fluss hinab...");
  AddDetail(("tiefe"),
      "Viele Meter wuerdest Du hier abstuerzen.");
  AddDetail(("meter"),
      "Ein Meter hat 100 Zentimeter...");
  AddDetail(("zentimeter"),
      "Ein Zentimeter hat 10 Millimeter...");
  AddDetail( ({"milimeter"}),
      "Ein Millimeter hat...aber lassen wir das lieber...");
  AddDetail(("fluss"),
      "Der Fluss ist der beruehmte Rio de la Puseta, der bekannt ist fuer sein "
      "smaragdgruenes Wasser.");
  AddDetail(("wasser"),
      "Gruen und klar stroemt es in der Tiefe dahin.");
  AddDetail(("himmel"),
      "Der Himmel ist ober Dir.");
  AddDetail(("boden"),
      "Der Boden ist unter Dir.");
  AddDetail(({"rio","puseta","rio de la puseta"}),
      "Dieser Fluss ist ein Juwel der Natur.");
  AddDetail(("juwel"),
      "Er ist einfach grossartig...");
  AddDetail(("natur"),
      "Schau Dich ruhig um...");

  SetProp(P_HIDE_EXITS, ({"unten"}) ); //ich weiss nicht ob man wirklich alles
  // so verstecken sollte????????

  AddExit("unten", "./vorsprung2");
  AddExit("osten", "./weg13");
  AddExit("westen", "./weg11");

  AddItem( ({NPC"dmoskito", NPC"dstechmuecke"}), REFRESH_DESTRUCT);

}

