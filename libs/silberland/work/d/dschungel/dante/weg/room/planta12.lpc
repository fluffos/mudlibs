/*
 ** plantage mit ananas
 ** dante 97 feb 
 ** 
 */

inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>

#include "files.h"
inherit ROOM "planta_inh.lpc";
nosave int manda;

create()
{
  room::create();
  planta_inh::create();     
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:30, ENV_TERRAIN:TT_JUNGLE]));
  SetProp (P_INT_LONG, BS(
        "Du befindest Dich nun hinter dem Holzzaun inmitten der Obstplantagen "+
        "von Tijara. Die Erde hier ist saftig und weich, die pralle Sonne des "+
        "tiefen Sueden verleiht dem Obst eine unnachahmliche Farbe und die Fruechte"+
        " lachen Dich verlockend an. Ein leichter Wind blaest durch die Felder "+
        "und Du vergisst fast, dass Du hier unerlaubt eingedrungen bist. "+
        "Im Nordwesten kannst Du nahe der Stadtmauer einen Brunnen erkennen. "+
        "Im Westen liegt ein Teil der Plantagen, der scheinbar etwas verkommen ist.\n"));

  AddDetail("teil",
      "Schau ihn Dir doch an!");
  AddDetail(("brunnen"),
      "Von hier aus kann man noch nicht viel erkennen.\n");
  AddDetail(({"mauer","stadtmauer"}),
      "Es ist die Stadtmauer von Tijara, die man im Norden sehen kann.\n");
  AddDetail(("norden"),
      "Im Norden liegt die grosse Stadt Tijara, die Sitz des Gouverneurs ist.\n");
  SetProp (P_INT_SHORT, "Auf der Obstplantage");

  AddDetail(({"plantage","plantagen","obstplantagen","obstplantage"}),
      "In diesem Bereich der Plantage baut man vor allem Mandastromostauden an.\n");
  AddDetail(({"stauden","staude","obststaude","obststauden"}),
      "Eine grosse Anzahl von Mandastromostauden grinst Dich direkt an.\n");
  AddDetail(("sueden"),
      "Du befindest Dich tief im Sueden, oder hast Du das vergessen?\n");
  AddDetail(("obst"),
      "Auf den Plantagen von Tijara baut man Mango, Ananas, Bananen, Papayas \n"
      "und noch vieles mehr an...\n");
  AddDetail(({"feld","felder"}),
      "So weit Dein Auge nur reicht, nichts als Obst...\n");
  AddDetail(({"frucht","fruechte"}),
      "Die Fruechte haengen an den Obststauden und warten nur mehr auf die Ernte.\n");

  AddDetail(({"holzzaun","zaun"}),
      "Der Zaun ist von hier schon ein ganzes Stueck entfernt.\n");
  AddDetail ( ("farbe"), "In vielen bunten Farben haengen sie an den Stauden.\n");
  AddDetail ("erde",
      "Die Erde ermoeglicht neben dem idealen Klima das ausgezeichnete"
      " Wachstum der Fruechte.");
  AddDetail ( ({"wind", "blaetter"}),
      "Der Wind laesst die Blaetter hin und herwogen.\n");
  AddDetail (({"sonne", "ernte", "ernten"}),
      "Die Sonne lacht vom Himmel. Sie laesst in diesen Breiten mehrere"
      " Ernten in einem Jahr zu.");
  AddDetail ("himmel", "Der Himmel erstrahlt in tiefstem Blau.\n");
  AddDetail ( ({"stadt", "tijara"}), "Du befindest Dich hier auf dem Grund des "+
      "Gouverneurs von Tijara.\n");

  AddSpecialDetail (({"mandastromostaude","mandastromostauden"}), "d_staude");

  AddDetail(("boden"),
      "Der Boden ist hier sehr fruchtbar.");

  AddSmell( ({DEFAULT_SMELL,"fruechte"}),
      "Die Fruechte hier riechen einfach koestlich.\n");
  AddSound( ({DEFAULT_SOUND, "bienen"}),
      "Die Bienen summen ueber die Obstplantage.\n");
  AddExit( "sueden", "./planta11");
  AddExit( "osten", "./planta9");
  AddExit( "nordwesten", "./brunnen1");
  AddExit("westen", "./plantaw");
  AddItem(NPC"dbiene" , REFRESH_DESTRUCT);
  AddItem( ({NPC"dmoskito", NPC"dstechmuecke"}), REFRESH_DESTRUCT);
  manda = 5;

  AddCmd ( ({"stehle","stiehl","stehlen" }), "pflueck" );
}

reset()
{
  ::reset();
  manda=5;
}

string d_staude()
{
  if (manda)                                                                                         
    return "Eine Mandastromo haengt im Moment ganz in Deiner Naehe. Du koenntest sie stehlen...\n";
  else return BS("Im Moment scheint keine Mandastromo in Deiner Reichweite zu sein. "+
      "Jedenfalls kannst Du hier im Moment keine stehlen.\n");
}



int pflueck(string str)
{
  object ob;
  notify_fail ("Was willst Du hier stehlen?\n");
  if (!str) return 0;
  if (str!="mandastromo")  return 0;
  if (!manda) 
  {
    notify_fail("Im Moment ist leider keine Mandastromo in Deiner Reichweite.\n");
    return 0;
  }  
  write ("Du stiehlst eine koestliche Mandastromo und steckst sie sofort ein.\n");
  say (CAP(TPN)+
      (TP->QueryProp(P_GENDER) == MALE ? " der miese Dieb": " die miese Diebin")+
      " stiehlt eine koestliche Mandastromo.\n");

  CLONE(OBJ"dmanda", TP);
  manda--;
  if(ob=present("plantagenarbeiter") )
  {
    tell_room(TO,"Der Plantagenarbeiter schreit: HALTET DEN DIEB!\n");
    ob->Kill(TP);
  }
  return 1;
}

