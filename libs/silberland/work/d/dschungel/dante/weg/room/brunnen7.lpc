// brunnen 3 dante

#include "files.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
create()
{
  ::create();

  SetProp( P_INT_SHORT, "In Schlamm" );
  SetProp( P_INT_LONG, BS(
        "Du steckst voellig im stinkendem Schlamm fest. Ueberall nur Schlamm...\n"));

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20,ENV_TERRAIN:TT_CAVE]) );

  AddDetail(("schlamm"),
      "Vorne Schlamm, hinten Schlamm, ober Dir Schlamm, unter Dir Schlamm,...");

  AddSound( DEFAULT_SOUND,
      "Der Schlamm sagt: Der Name des Magiers, der das hier verbrochen hat, ist die Loesung!");

  AddSmell( DEFAULT_SMELL,
      "Waeh, hier stinkt es.");

  AddDetail(("decke"),
      "PLATSCH!!! Genau ins Auge!");
  AddDetail(("boden"),
      "Hier wird der Boden wieder etwas haerter...");
  AddDetail(({"wand","waende"}),
      "Die Waende sind, wie originell, aus Schlamm.");
  AddRoomMessage( 
      ({"Du geraetst in Panik...\n",
       "Angst ergreift Besitz von Dir...\n",
       "Ach, waerst Du doch nicht in den Brunnen gesprungen.\n",
       "Du denkst . o O 'BLUBB BLUBB BLUBB'\n",
       "Der Schlamm erdrueckt Dich fast.\n",
       "BLUBB....BLUBB....BLUBB....\n",
       "Dante teilt Dir mit: IHH, Du stinkst ja nach faulem Schlamm!\n",
       "Gib nicht auf, Du hast es bald geschafft, oder auch nicht...\n",
       "Der Schlamm blubbert und blubbert.\n",
       "Eine beschissene Situation...\n"}) );
  AddItem(NPC"dschlamm", REFRESH_DESTRUCT); 
  SetProp(P_HIDE_EXITS, ({"dante"} ));
  AddExit( "dante", "nach BLUBB#./brunnen8");
}




