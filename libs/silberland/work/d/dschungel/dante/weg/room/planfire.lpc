/*
 ** plantage mit passionsfrucht
 ** dante 97 feb 
 ** 
 */

inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>

#include "files.h"


int fire=0;

create()
{  
  ::create();

  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:30, ENV_TERRAIN:TT_JUNGLE]));
  SetProp (P_INT_LONG, BS(
        "Hier scheint die Plantage nicht gepflegt zu werden. Rings um Dich siehst "
        "Du vertrocknete, alte Straeucher, die sicherlich nie mehr Fruechte tragen "
        "werden."));
  SetProp (P_INT_SHORT, "Auf der Obstplantage");



  AddDetail(({"frucht","fruechte"}),
      "Hier wachsen sicherlich keine!");
  AddDetail(({"wand","waende"}),
      "Waende gibts es hier keine, nur Straeucher.");
  AddDetail("teil",
      "Du befindest Dich im westlichsten Teil der Plantage.");
  AddDetail("osten",
      "Im Osten liegt der bewirtschaftete Teil der Plantage.");
  AddDetail("himmel",
      "Der Himmel ist strahlend blau. Diese Farbe gefaellt Dir gut!");
  AddDetail("farbe",
      "Die Farbe ist ein helles Blau.");
  AddDetail("blau",
      "Strahlendblau!");
  AddDetail("boden",
      "Am Boden ist eine kleine Feuerstelle.");
  AddSpecialDetail(({"feuerstelle","feuer"}), "feuer");
  AddDetail(({"plantage", "plantagen", "obstplantagen","obstplantage"}),
      "Dieser Teil der Plantagen ist verkommen und ausgetrocknet.");
  AddDetail(({"strauch","straeucher"}),
      "Die Straeucher sind alt und ungepflegt. Ihre Wurzeln liegen teilweise schon "
      "im Freien.");
  AddDetail(({"freien"}),
      "Da stehst Du auch!");
  AddDetail(({"wurzel","wurzeln"}),
      "Die Wurzeln der Straeucher sind alt und vertrocknet. Vielleicht "
      "kann man ja einen trockenen Ast verwenden...");
  AddDetail("ast",
      "Trocken, duerr, gut fuer Feuer!");

  AddSmell(DEFAULT_SMELL,
      "Hier riecht es nach Feuer...\n");

  AddSound( DEFAULT_SOUND,
      "Stille, Ruhe, Frieden.\n");

  AddExit( "suedosten", "./plantaw");

  AddCmd(({"reisse", "reiss","brech", "brich", "breche"}), "out");  
  AddCmd(({"mach", "mache", "zuende", "zuend"}), "make_fire");
  AddCmd(({"brate","brat", "koch","mach","mache", "koche", "bereite"}), "make_meal");

}



int make_meal(string str)
{
  object ob1, ob2, ob3, ob4, ob5, ob6, ob7, ob8, ob9;
  ob1=present("SALZ", TP);
  ob2=present("PEPE", TP);
  ob3=present("SCHINKEN", TP);         
  ob4=present("PFANNE", TP);
  ob5=present("paradiesvogelei", TP);
  ob6=present("KAESE", TP);
  ob7=present("brotfrucht", TP);
  ob8=deep_present("FEUERSTEIN", TP);   
  notify_fail("Was willst Du kochen, braten, zubereiten!\n"
      "syntax < bereite omelette zu >!\n"
      "Wenn Du ein Feuer machen willst, so zuende einfach eines an!!!\n");


  if(str=="omelette zu" ||str=="omelett zu"||str=="omelett"||str=="omelette"||
      str=="omelette in pfanne zu"||str=="omelett zu") {

    if(!fire)
    {
      write("Ohne Feuer wird das nie was!\n");
      return 1;
    }
    if(!present("ESSEN", TP))     
    {
      write("Du kannst hier gar nichts zubereiten?! Geh zuerst zum Waechter!\n");
      return 1;
    }


    if(!ob1)
    {
      write("Du hast kein Salz!\n");
      return 1;
    }

    if(!ob2)
    {
      write("Du hast keinen Pfeffer!\n");
      return 1;
    }
    if(!ob3)
    {
      write("Du hast keinen Schinken!\n");
      return 1;
    }


    if(!ob4)
    {
      write("Du hast keine Pfanne!\n");
      return 1;
    }

    if(!ob5)
    {
      write("Du hast kein Ei!\n");
      return 1;
    }

    if(!ob6)
    {
      write("Du hast keinen Kaese!\n");
      return 1;
    }


    if(!ob7)
    {
      write("Du hast kein Brot!\n");
      return 1;
    }
    else
    {
      write(BS("Du schlaegst das Ei in die Pfanne, schneidest Kaese und Schinken dazu, "
            "wuerzt das ganze mit Salz und Pfeffer und zu guter letzt schneidest "
            "Du auch das Brot noch auf und voila, das Omelett a la Dschungelwaechter "
            "ist fertig!"));
      fire=0;
      ob1->remove(1);
      ob2->remove(1);
      ob3->remove(1);
      ob4->remove(1);
      ob5->remove(1);
      ob6->remove(1);
      ob7->remove(1);
      ob8->remove(1);
      ob9=clone_object("d/dschungel/dante/weg/obj/questpfanne");
      ob9->move(TP, M_NOCHECK);
      ob9->SetProp(P_SHORT, ""+CAP_TPN+"`s Omelett Pfanne");
      return 1;
    }   
    return 0;
  }
  return 0;
}




int make_fire(string str)
{
  object ob;
  ob=present("AST", TP);
  notify_fail("Was willst Du hier machen!? Etwa ein Feuer?! \n"
      "syntax < zuende feuer an>!\n");

  if(member(({"feuer", "feuer mit feuerstein", "feuer in feuerstelle",
          "feuer an", "feuer mit stein an", "feuer mit feuerstein an"}),str)!=-1)
  {
    if(!present("ESSEN", TP))
    {
      write("Du kannst hier kein Feuer machen! Geh zuerst zum Waechter!\n");
      return 1;
    }
    if(!present("AST", TP))         
    {
      write("Du brauchst doch etwas, dass Du anzuenden kannst.\n");
      return 1;
    }
    if(!present("FEUERSTEIN", TP))
    {
      write("Du brauchst doch etwas, womit Du Feuer machen kannst!\n");
      return 1;
    }
    if(fire)
    {
      write("Aber hier brennt bereits ein Feuer!\n");
      return 1;
    }
    else
    {
      write(BS("Du reibst den Feuerstein, der Ast faengt Funken, und dann "
          "legst Du den brennenden Ast in die Feuerstelle. Er verbrennt schnell, "
          "aber das restliche Holz in der Feuerstelle gibt ein nettes, kleines "
          "Feuerchen! Beeil Dich, lange brennt es nicht!\n"));
      fire=1;
      ob->remove();
      call_out("fire_out", 120);
      return 1;
    }
    return 0;
  }  
  return 0;
}


void fire_out()
{
  tell_room("d/dschungel/dante/weg/room/planfire",
      "Das Feuer geht wieder aus!\n");
  fire=0;
  return ;
}

string feuer()
{
  if(fire)
  {
    write("Im Moment brennt gerade ein kleines Feuer. Das solltest "
        "Du nuetzen!\n");
  }

  if(!fire)
  {
    write("Die Feuerstelle ist noch warm, aber Feuer brennt keines!\n");
  }
  return "";
}

out(string str)
{
  object wu;
  notify_fail("Was willst Du hier ausreissen, abbrechen?\n");
  if (!str) return 0;

  if (member(({"ast ab", "ast"}),str)!=-1)
  {
    if(!present("ESSEN", TP))
    {
      write("Du kannst keinen Ast abbrechen!\n");
      return 1;
    }    
    if(deep_present("AST", TP))
    {write(
        "Du versuchst einen Ast abzubrechen, bist aber zu schwach!\n");
    return 1;
    }

    else
    {
      write("Du brichst einen trockenen Ast ab!\n");
      wu=clone_object("/d/dschungel/dante/weg/obj/ast");
      wu->move(TP , M_NOCHECK);
      return 1;
    }
    return 0;             
  }
  return 0;

}

