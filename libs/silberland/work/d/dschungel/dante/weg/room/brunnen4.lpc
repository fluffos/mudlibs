// brunnen 4 dante

#include "files.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
create()
{
  ::create();

  SetProp( P_INT_SHORT, "In Schlamm" );
  SetProp( P_INT_LONG, BS(
    "Du steckst voellig im stinkendem Schlamm fest. Ueberall nur Schlamm...\n"));
AddDetail(("decke"),
"Als Du nach oben blickst, faellt Dir ein ekliger Schlammbatzen genau in den Mund.");
AddDetail(("boden"),
"Schlamm...");
AddDetail(({"wand","waende"}),
"Als Du Dir Die Waende naeher betrachtest, faellt Dir etwas auf...");
AddDetail(("etwas"),
"Ein Abdruck im Schlamm sieht irgendwie Nostromo aehnlich...");
AddDetail(("nostromo"),
"Nostromo, der Wurst , aeh, Pizzamagier...");
AddDetail(("abdruck"),
"Der Abdruck hat wirkliche grosse Aehnlichkeit mit Nostromo.");
    
    
    
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20,ENV_TERRAIN:TT_CAVE]) );

  
  AddDetail(("schlamm"),
  "Vorne Schlamm, hinten Schlamm, ober Dir Schlamm, unter Dir Schlamm,...");
 
  AddSound( DEFAULT_SOUND,
    "Der Schlamm schweigt.");
    
  AddSmell( DEFAULT_SMELL,
    "Hmm, irgendwie zieht der Gestank nach rechtsunten. ");

  AddRoomMessage( 
    ({"Du geraetst in Panik...\n",
      "Angst ergreift Besitz von Dir...\n",
      "Ach, waerst Du doch nicht in den Brunnen gesprungen.\n",
      "Du denkst . o O 'BLUBB BLUBB BLUBB'\n",
      "Der Schlamm erdrueckt Dich fast.\n",
      "BLUBB....BLUBB....BLUBB....\n",
      "Der Schlamm blubbert und blubbert.\n",
      "Eine beschissene Situation...\n"}) );
      
  AddItem(NPC"dschlamm", REFRESH_DESTRUCT );
  SetProp(P_HIDE_EXITS, ({"rechtsunten"}));
  AddExit( "rechtsunten", "./brunnen5"); 
 }
