// weg von tijara raus 1

#include "files.h"

inherit "std/room";
#include <moving.h>
#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Auf dem Pfad durch die Plantagen");
  SetProp(P_INT_LONG,
      BS(               
        "Der Pfad fuehrt hier zwischen bunten Obstplantagen weiter nach Sueden in "
        "den Dschungel. Tijara und das suedliche Stadttor kann man von hier aus "
        "nur mehr recht schwer erkennen. Rings um Dich breiten sich saftige Felder "
        "voller Obstbaeume und Straeucher aus, die alle in voller Pracht Dir ihre "
        "reifen Fruechte zeigen. Ein Zaun soll die begeehrte Ernte vor allzu "
        "hungrigen Wanderern schuetzen.")+
      "Ein Schild.\n");
  AddDetail(({"strauch","straeucher"}),
      "Ueber den Zaun hinweg kannst Du von den Straeuchern nicht viel erkennen.");
  AddDetail(({"baum","obstbaeume","baeume","obstbaum","paradies"}),
      "Die bunten Obstbaeume erscheinen Dir wie aus dem Paradies...");
  AddDetail(("zaun"),
      "Hier ist der Schutzzaun in besonders gutem Zustand.");
  AddDetail(("schutzzaun"),
      "Bei dem Schutzzaun handelt es sich um einen Holzzaun.");
  AddDetail(("zustand"),
      "Der hohe Zaun soll Diebe fernhalten.");
  AddDetail(("holzzaun"),
      "Als Du Dir den Holzzaun naeher betrachtest, kommt Dir der Gedanke, dass"
      " er eigentlich fuer Dich kein Hindernis darstellen sollte.");
  AddDetail(("hindernis"),
      "Der Zaun scheint hier unueberwindlich...");
  AddDetail(("schutz"),
      "Du willst aber unbedingt eine Frucht haben!");
  AddDetail(("buerger"),
      "Die fleissigen Menschen haetten keine Freude mit einem Dieb...");
  AddDetail(("ernte"),
      "Die Buerger von Tijara freuen sich schon lange auf die reiche Ernte.");
  AddDetail(("gouverneur"),
      "Er residiert im Palast in der Stadt Tijara und soll ein strenger, aber "
      "gerechter Mann sein.");
  AddDetail(({"rechts","rechte","rechten"}),
      "Der Zaun scheint hier zu hoch zu sein, um drueber zu klettern.");
  AddDetail(({"links","linken","linke"}),
      "Hier kommst Du niemals drueber. Im Zaun kannst Du ein kleines Astloch "
      "erkennen.");
  AddDetail(({"loch","astloch", "durch loch", "durch astloch"}),
      "Als Du durch das Astloch blickst, erkennst Du einen fleissigen Arbeiter, "
      "der gerade bei der Ernte ist.");
  AddDetail(("eigentum"),
      "Die Plantagen gehoeren dem Gouverneur von Tijara.");
  AddDetail(({"diebe","dieb", "gegend"}),
      "Diebe werden in dieser Gegend hart bestraft.");
  AddDetail(({"wanderer","leute", "gesindel", "pack", "tagediebe", "taugenichtse"}),
      "Gesindel, mieses Pack, Tagediebe, Taugenichtse, eben solche Typen wie Du " 
      "sollen vom Obst ferngehalten werden.");
  
  AddDetail(({"tor","stadttor"}),
      "Das suedliche Stadttor kann man aus dieser Entfernung noch recht gut erkennen.");
  AddDetail(({"stadt","tijara"}),
      "Tijara ist schon ein ganzes Stueck von hier entfernt.");
  AddDetail(("pfad"),
      "Der Pfad fuehrt mitten durch bunte Felder voller reifer Fruechte in den "
      "dichten Dschungel.");   
  AddDetail(({"sueden","dschungel"}),
      "Der Dschungel breitet sich in all seiner Pracht im Sueden vor Dir aus."); 
  AddDetail(("obst"),
      "Du kannst das herrliche Obst ueber den Zaun hinweg sehn.");
  AddDetail(({"obstplantagen","plantagen"}),
      "Angehnem duftend liegen sie zu beiden Seiten des Pfades, und laden geradezu "
      "ein sich an den koestlichen Fruechten zu laben.");
  AddDetail(({"feld","felder"}),
      "So weit Dein Auge reicht, nichts als Felder voller suesser Fruechte.");
  AddDetail(("fruechte"),
      "Wie gerne haettest Du nur eine davon.");
  AddReadDetail(("schild"),
      "+------------------+\n"
      "|                  |\n" 
      "|     BETRETEN     |\n"       
      "|     VERBOTEN     |\n"
      "|                  |\n"
      "|  Der Gouverneur  |\n"
      "+------------------+\n"
      "         ||\n"
      "         ||\n"
      "         ||\n"
      "         ||\n"
      "         ||\n"
      "         ||\n");                     
  AddDetail(("schild"),
      "Du kannst es lesen.");        
  SetProp(P_LIGHT, 1);
  AddDetail(("boden"),
      "Der Boden ist weich und saftig und manchmal sieht man vereinzelte, "
      "groessere Grasbueschel.");
  AddDetail(({"bueschel","grasbueschel"}),
      "Hmm, interessant...");

  AddDetail(({"gras","farbe"}),
      "Ganz normales Gras. Die Farbe des Grases unterscheidet sich gar nicht "
      "von normalem Gras. Die Bueschel scheinen sehr interessant zu sein...");
  AddDetail( ({"grases", "pfades"}),
      "Achtung! Wenn Du das Wort Xackfryukd untersuchst stirbst Du augenblicklich!\n"
      "Das ist kein Scherz sondern eine Warnung, die Du ernstnehmen solltest!!!\n");
  AddDetail(({"scherz","warnung","wort","achtung"}),
      "Ich scherze oft, aber hier nicht! Sei also gewarnt!");

  AddDetail(("himmel"),
      "Der Himmel ist strahlendblau, nur die Sonne lacht Dich an.");
  AddDetail(("sonne"),
      "Die Sonne sticht heute wieder besonders arg.");

  AddSpecialDetail(({"xackfryukd"}), "d_die"); 

  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_JUNGLE]) );

  AddSound( ({DEFAULT_SOUND, "plantagen", "lied"}),
      "Von den Plantagen hoerst Du ein froehliches Lied.\n");

  AddSmell( ({DEFAULT_SMELL, "duft", "fruechte", "frucht"}),
      "Der suesse Duft der Fruechte steigt Dir verlockend in die Nase.");

  AddItem( ({NPC"dbiene", NPC"dkoli", NPC"dkakadu", NPC"dbiene", NPC"dbiene"}), 
      REFRESH_DESTRUCT);

  AddCmd(({"wuehle", "wuehl","durchwuehle","durchwuehl", "durchsuche"}), "get");

  AddExit( "norden", "./wegp1");
  AddExit( "sueden", "./wegp3");
}

get(string str)
{
  object ob;
  notify_fail("Was willst Du hier durchsuchen!\n");
  if(str=="grasbueschel"||str=="bueschel"||str=="in bueschel"||str=="in grasbueschel")
  {
    if(!present("ESSEN", TP))
    {
      write("Du findest nichts!\n");
      return 1;
    }


    if(deep_present("PFANNE", TP))
    {
      write("Du durchsuchst die Grasbueschel, aber findest nichts!\n");
      return 1;
    }
    else
    {
      write("Du durchsuchst die Grasbueschel, und findest eine alte Pfanne.\n");
      ob=clone_object("d/dschungel/dante/weg/obj/pfanne");
      ob->move(TP, M_NOCHECK);
      return 1;
    }
    return 0;
  }
  return 0;
}


string d_die()
{
  write("Du hast auf meine Warnung nicht gehoert oder scriptest!!!\n"
      "                   NUN FOLGT DIE STRAFE!\n");
  TP->die();
  SetProp(P_KILL_NAME, "Eine Skriptfalle");
  return("");
}

