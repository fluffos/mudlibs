//fippsiraum

#include "/players/dante/myowndefine.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#define QUESTKEY "Fippsi, die verwirrte Maus"     


create()
{
  ::create();

  SetProp( P_INT_SHORT, "Mitten im Dschungel" );
  SetProp( P_INT_LONG, BS(
        "Nun ist der Dschungel um Dich herum so dicht geworden, dass Du ueberhaupt "
        "nichts mehr siehst ausser gruenen Pflanzen. Sie sind einfach ueberall. "
        "Ueber Dir, unter Dir, neben Dir, ueberall. Hoffentlich hat man Dich in "
        "keine Falle gelockt..."));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp( P_ENVIRONMENT,([ENV_TEMPERATURE: 25, ENV_TERRAIN:TT_JUNGLE]) );

  AD("dschungel",
      "Der ist ueberall.");
  AD(({"pflanze","pflanzen"}),
      "Hier herrschen vor allem Pflanzen mit grossen, hellgruenen Blaettern vor. "
      "Sie wiegen sich sanft im Wind. Grosse Straeucher umringen Dich.");
  AD(({"strauch","straeucher"}),
      "Die Straeucher stehen hier ueberall. Im Osten kann man sich durch sie "
      "zurueckzwaengen.");
  AD("osten",
      "Da gehts raus.");

  AD(({"blatt","blaetter"}),
      "Die Blaetter sind enorm gross. Der Wind bewegt sie sanft.");

  AD("wind",
      "Den Wind kann man direkt hoeren. Er rauscht durch die Blaetter.");

  AD("boden",
      "Der Boden ist kaum zu erkennen. Zu dicht stehen die Pflanzen.");
  AD("himmel",
      "Der Himmel haengt voller gruener Blaetter. Trotzdem scheint die Sonne "
      "sanft herein.");
  AD("sonne",
      "Ein Sonnenstrahl faellt auf eine eigenartige Stelle.");

  AD(({"strahl","sonnenstrahl"}),
      "Hell leuchtet er herunter.");
  AD("falle",
      "Hmm, hat Dich ein boesartiger Magier in eine Falle gelockt, in der Du "
      "nun von noch boesartigeren Monstern zerfetzt wirst.");
  AD("magier",
      "Wer koennte das sein...");
  AD(({"monster","monstern"}),
      "Warte ein wenig...");

  AD("stelle",
      "Die Stelle ist viel heller als normal. Seltsam. Ah, Du entdeckst eine "
      "kleine Inschrift.");
  AD("inschrift",
      "Lies sie.");
  ARD("inschrift",
      "Der Wind, das gute Kind, hilft Dir und mir.");
  AD("kind",
      "Steht da, ist aber nicht da. Ist auch nicht wichtig.");
  AD(({"wand","waende"}),
      "Im uebertragenen Sinne koennte man die vielen Blaetter als eine Wand "
      "bezeichnen.");
  AD("sinne",
      "HMMPPFFF!!! Was Spieler so alles untersuchen...");
  AD("suedwesten",
      "Der Wind kommt aus dem Suedwesten. Dort ist der Dschungel scheinbar etwas "
      "lichter und Du erkennst ein kleines Loechlein.");
  AD("loch",
      "Nein, nicht da.");
  AD("loechlein",
      "In dem sehr kleinen Loechlein schimmert etwas Gruenes.");
  AD("gruenes",
      "Hmm, es koennte ein Pflaenzchen sein.");
  AD("pflaenzchen",
      "Ja, es ist eines. Kann man das etwa irgendwie bekommen?!");



  AddSound( DEFAULT_SOUND,
      "Du hoerst den Wind rauschen...");
  AddSound("wind",
      "Rausch rausch. Es scheint als kaeme er aus dem Suedwesten.");
  AddSmell( DEFAULT_SMELL,
      "Hmm, es riecht nach Kraeutern!");
  AddSmell(({"kraut","kraeuter"}), 
      "Hmm, wo sind die bloss.\n");


  AddCmd(({"pflueck","pfluecke", "nimm", "hole","greife","greif"}), "pfluecken");  
  AddCmd(({"zwaenge","zwaeng"}), "go");  


  AIT("d/dschungel/dante/weg/npc/qka", REFRESH_DESTRUCT);


}

void delay_time()  {
  call_out("new_bird", 30);  }
  //30 sek fuer krautpfleucken is genug!!! der voegel is eh lahm

  void new_bird()  {
    object ob;
    if(!present("kakadu", TO) ) {
      ob=clone_object("/d/dschungel/dante/weg/npc/qka");
      ob->move(TO, M_TPORT);  
    }
  }




init()  {
  ::init();
  if(interactive(TP))
    call_out("tag", 10);  
}


void tag()   {
  if(ENV(TP)!=TO) return;
  write("Du hoerst lautes Bruellen von irgendwo her.\n");
  call_out("tag2", 10);   
}


void tag2()   {
  if(TP && ENV(TP)!=TO) return;
  write("Das Bruellen kommt immer naeher und wird bedrohlich.\n");
  call_out("tag3", 10);   }


  void tag3()   {
    if(TP && ENV(TP)!=TO) return;
    write("Ein schreckliches Monster muss ganz in Deiner Naehe sein. Fluechte!\n");
    call_out("tag4", 10);   }


    void tag4()   {
      if(TP && ENV(TP)!=TO) return;
      write("Hinter Dir bruellt ein Monster! ANGST! Hau ab!!!\n");
      call_out("tag5", 10);   
    }


void tag5()   {
  if(TP && ENV(TP)!=TO) return;
  write("Du hast schreckliche Angst. Es scheint ein Drache zu sein.\n");
  call_out("tag6", 10);  
}



void tag6()   {
  if(ENV(TP)!=TO) return;
  write("Ein Drache stuermt aus dem Dschungel auf Dich zu.\n"
      "Der Drache pulverisiert Dich.\n");
  call_out("tag7", 4);   
}


void tag7()   {
  if(ENV(TP)!=TO) return;
  write("Fippsi grinst Dich an und sagt: Reingefallen!\n"
      "Dann verschwindet Fippsi wieder im Dschungel!\n");
}




int go(string str)   {
  NF("Wo willst Du Dich durchzwaengen?\n");
  if(str=="durch straeucher"||str=="durch straeucher im osten"||
      str=="durch strauch im osten" ||str=="nach osten durch straeucher" ||
      str=="durch strauch")  {



    write("Du zwaengst Dich durch die Straeucher im Osten.\n");
    TP->move("/d/dschungel/dante/weg/room/fip", M_GO,
        "im Dschungel", "verschwindet", "kommt herein gekrochen");

    return 1;  
  }
  return 0; 
}


int pfluecken (string str)
{
  object ob, zange;
  zange=present("FIPPSI_ZANGE", TP);

  notify_fail("Was willst Du hier pfluecken ?\n");
  if( !str)
    return 0;
  if ( member ( ({"kraut","kraeuter","daemonenkraut","pflaenzchen",
          "kraut mit ast", "daemonenkraut mit ast", "pflaenzchen mit ast"}), str ) !=-1 ){
    if(!present("\nfippsiobj", TP)) {
      write("Du versuchst ein Kraut zu pfluecken, doch schaffst es nicht!\n");
      return 1; 
    }
    if(deep_present("\nfippsikraut", TP))  {
      write("Du hast Doch schon ein Daemonenkraut!\n");
      return 1; 
    }
    if(!zange)  {
      write(BS("Du versuchst das Kraut ohne Hilfsmittel zu pfluecken, doch so "    
            "einfach geht das nicht. Dir fehlt ein Hilfsmittel mit dem man zupacken kann. "
            "Vielleicht weiss ja Fippsi etwas darueber."));
      return 1;  
    }


    else   {
      zange->remove();
      write(BS("Du pflueckst Dir mit Deiner Zange ein Daemonenkraut! "
            "Deine Zange zerbricht dabei."));
      ob=clone_object("/d/dschungel/dante/weg/obj/fippsikraut");
      ob->move(TP, M_NOCHECK);
      return 1; 
    }  
    return 0; 
  }  
  return 0; 
}


