// weg von tijara raus 1

#include "files.h"

inherit "std/room";
#include <moving.h>
#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Auf dem Pfad durch die Plantagen");
  SetProp(P_INT_LONG,
      BS(               
        "Der Pfad fuehrt hier zwischen bunten Obstplantagen weiter nach Sueden in "
        "den Dschungel. Tijara und das suedliche Stadttor kann man von hier aus "
        "nur mehr recht schwer erkennen. Ringsum Dich breiten sich saftige Felder "
        "voller Obstbaeume und Straeucher aus, die alle in voller Pracht Dir ihre "
        "reifen Fruechte zeigen. Ein Zaun soll die begehrte Ernte vor allzu "
        "hungrigen Wanderern schuetzen.")+
      "Ein Schild.\n");

  AddItem("/d/dschungel/dante/tijaraneu/npc/schleimw", REFRESH_DESTRUCT);

  AddDetail(("wanderer"),
      "Du singst froehlich 'Das Wandern ist des Muellers Lust...'"); 
  AddDetail(({"strauch","straeucher"}),
      "Ueber den Zaun hinweg kannst Du von den Straeuchern nicht viel erkennen.");
  AddDetail(({"baum","obstbaeume","baeume","obstbaum", "paradies"}),
      "Die bunten Obstbaeume erscheinen Dir wie aus dem Paradies...");
  AddDetail(("zaun"),
      "Hier ist der Schutzzaun in besonders gutem Zustand. Er soll Diebe von der "
      "Ernte fernhalten.");
  AddDetail(({"busch","zierbuesche","buesche","zierbusch"}),
      "Als Du Dir am Boden des rechten Zaunes die Buesche naeher betrachtest, "
      "faellt Dir hinter einem Busch eine kleine Oeffnung im Zaun auf.");
  AddDetail(("boden"),
      "Am Boden des westlichen Holzzaunes wachsen kleine Buesche.");
  AddDetail(("oeffnung"),
      "Durch die Oeffnung im westlichen Zaun kann man sicher durchkriechen.");
  AddDetail(("holzzaun"),
      "Als Du Dir den Holzzaun naeher betrachtest, kommt Dir der Gedanke, dass"
      " er eigentlich fuer Dich kein Hindernis darstellen sollte.");
  AddDetail(("hindernis"),
      "Der Zaun scheint hier unueberwindlich...");
  AddDetail(("schutz"),
      "Du willst aber unbedingt eine Frucht haben!");
  AddDetail(("buerger"),
      "Die fleissigen Menschen haetten keine Freude mit einem Dieb...");
  AddDetail(("ernte"),
      "Die Buerger von Tijara freuen sich schon lange auf die reiche Ernte.");
  AddDetail(("gouverneur"),
      "Er residiert im Palast in der Stadt Tijara und soll ein strenger, aber "
      "gerechter Mann sein.");
  AddDetail(({"rechts","rechte","rechten"}),
      "Der Zaun scheint hier zu hoch zu sein, um drueber zu klettern. Am Boden "
      "hat man einige kleine Zierbuesche gepflanzt.");
  AddDetail(({"links","linken","linke"}),
      "Hier kommst Du niemals drueber.");
  AddDetail(("eigentum"),
      "Die Plantagen gehoeren dem Gouverneur von Tijara.");
  AddDetail(({"diebe","dieb"}),
      "Diebe werden in dieser Gegend hart bestraft.");
  AddDetail(({"abenteurer","leute"}),
      "Gesindel, mieses Pack, Tagediebe, Penner, eben solche Typen wie Du " 
      "sollen vom Obst ferngehalten werden.");                                                                          
  AddDetail(({"tor","stadttor"}),
      "Das suedliche Stadttor kann man aus dieser Entfernung noch recht gut erkennen.");
  AddDetail(({"stadt","tijara"}),
      "Tijara ist schon ein ganzes Stueck von hier entfernt.");
  AddDetail(("pfad"),
      "Der Pfad fuehrt mitten durch bunte Felder voller reifer Fruechte in den "
      "dichten Dschungel.");   
  AddDetail(({"sueden","dschungel"}),
      "Der Dschungel breitet sich in all seiner Pracht im Sueden vor Dir aus."); 
  AddDetail(("obst"),
      "Du kannst das herrliche Obst ueber den Zaun hinweg sehn.");
  AddDetail(({"obstplantagen","plantagen"}),
      "Angenehm duftend liegen sie zu beiden Seiten des Pfades, und laden geradezu "
      "ein sich an den koestlichen Fruechten zu laben.");
  AddDetail(({"feld","felder"}),
      "So weit Dein Auge reicht, nichts als Felder voller suesser Fruechte.");
  AddDetail(("fruechte"),
      "Wie gerne haettest Du nur eine davon.");
  AddReadDetail(("schild"),
      "+------------------+\n"
      "|                  |\n"      
      "|     BETRETEN     |\n"       
      "|     VERBOTEN     |\n"
      "|                  |\n"
      "|  Der Gouverneur  |\n"
      "+------------------+\n"
      "         ||\n"
      "         ||\n"
      "         ||\n"
      "         ||\n"
      "         ||\n"
      "         ||\n");                     
  AddDetail(("schild"),
      "Du kannst das Schild lesen.\n");        
  SetProp(P_LIGHT, 1);

  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_JUNGLE]) );

  AddDetail(("himmel"),
      "Der Himmel haengt hier voller Geigen...");
  AddDetail(({"geige","geigen"}),
      "Eine Wolke zieht uber Dich hinweg und Du denkst an Paganini...");
  AddDetail(({"wolke","paganini"}),
      "Paganini solltest Du schon kennen...");

  AddSound( DEFAULT_SOUND,
      "Von den Plantagen hoerst Du ein froehliches Lied.\n");

  AddSmell( DEFAULT_SMELL,
      "Der suesse Duft der Fruechte steigt Dir verlockend in die Nase.");

  AddCmd( ({"krieche", "kriech"}), "kriechen");

  AddItem( ({NPC"dbiene", NPC"dkoli", NPC"dkakadu", NPC"dbiene", NPC"dbiene",
        PAPAGEI, SCHMETTERLING}), REFRESH_DESTRUCT);

  AddExit( "norden", "./wegp2");
  AddExit( "suedosten", "./weg2");
}

int kriechen(string str)
{
  notify_fail("Wo willst Du durchkriechen?\n");
  if( !str ) return 0;
  if( member( ({"durch oeffnung", "oeffnung" 
          }),str) !=-1 )
  {
    write("                                                                      \n"
        "Du kriechst durch die kleine Oeffnung im rechten Holzzaun.\n");
    TP->move("/d/dschungel/dante/weg/room/planta7", M_GO, 
        "unerlaubterweise die Obstplantagen", "betritt",
        "kommt durch die Oeffnung im Zaun gekrochen");
    return 1;
  }
  return 0;
}

