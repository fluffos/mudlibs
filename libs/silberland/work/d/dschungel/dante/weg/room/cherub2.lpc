#include "/players/dante/myowndefine.h"
inherit "std/room";
#include <properties.h>
#include <language.h>
#include <moving.h>
#define Z write("\n\n"); 
#include <wizlevels.h>

#define NIX  if(environment(TP)!=TO || !TP) return 0;     

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einem kleinen Floss im Dschungel" );
  SetProp( P_LIGHT, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN:TT_HOUSE]) );
   AddCmd ("", "no", 1);   

  SetProp(P_NO_TPORT, NO_TPORT_OUT);           
}

 
 int no()
 {
   write (
"Du willst hier nichts tun, sondern nur die kurze Fahrt geniessen!\n");
     return 1;
   }
     

  init()
  {::init();

  if(query_once_interactive(this_player())){
  call_out("a1", 1);}
  }
  

  a1()
    {
    NIX
    Z
    write(BS(
"Das Floss wird sehr rasch den Fluss hinuntergetrieben."));

    call_out("a2", 2);
    }
    
   a2()
   {NIX
   Z
   write(BS(
"UI! Immer schneller geht es dahin!"));
   call_out("a3", 2);
     }
 
 
    
   a3()
   {NIX
   Z
   write(BS(
 "Das Floss erreicht das offene Meer und treibt auf Tijara zu."));
   call_out("a4", 2);
     }
 
    
   a4()
   {NIX
   Z
   write(BS(
"Das Floss naehert sich Tijara."));
   call_out("a5", 2);
     }
    
   a5()
   {NIX
   Z
 
   write(BS(
   "Das Floss legt im Hafen von Tijara an und Du steigst aus. "
   "Das Floss verschwindet so schnell wie es kam."));
 
  tell_room("d/dschungel/feyaria/tijara/room/steg_d1", 
  "Ein kleines Floss kommt in den Hafen.\n");
  
 TP->move("d/dschungel/feyaria/tijara/room/steg_d1", M_GO,
 "aus dem Floss heraus", "steigt",
 "kommt aus einem kleinen Floss an Land gestiegen");
 
 tell_room("d/dschungel/feyaria/tijara/room/steg_d1", 
  "Ein kleines Floss verlaesst den Hafen.\n", ({TP}));
 
 }
 
  
  
BecomesNetDead(object pl)  {
	pl->move("/d/dschungel/dante/weg/room/cherub1",M_GO+ M_SILENT+
	M_NO_SHOW);
	return 1;
	}

  
  