inherit "std/room";
#include <properties.h>
#include <language.h>
#include <moving.h>

#include "/players/dante/myowndefine.h"

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Eine kleine Insel" );
  SetProp( P_INT_LONG,BS(
     "Du stehst auf einer kleinen etwas abgelegeneren Insel. "
     "Neben ein paar so irreal aussehenden "
     "Blumen, die gar nicht echt sein koennen, siehst Du noch eine "
     "grosse Betelpalme. Sonst gibt es hier nicht wirklich etwas "
     "Interessantes zu sehen. Die kleine Bruecke fuehrt Dich wieder zurueck."));
     

  
  
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN:TT_JUNGLE]) );


  AddDetail( ({"boden", "sand"}),
    "Der Boden ist sandig, warm und leicht feucht, also sehr angenehm "
    "oder?");
  AddDetail( "himmel",
    "Trotz der Tatsache, dass die Sonne sehr kraeftig auf Deinen Kopf "
    "scheint ist es hier nicht zu heiss, aber auch nicht zu kalt.");
  AddDetail( "tatsache",
    "Tatsache ist, dass die Sonne scheint.");
  AddDetail( "sonne",
    "Die Sonne meint es hoffentlich nicht zu gut mit Dir.");
  AddDetail( "kopf",
    "Dein Kopf ist noch da....nur keine Sorge.");
  AddDetail( "sorge",
    "Wie schon gesagt, Du musst Dir keine machen.");
  AddDetail( "insel",
    "Eine nette kleine Insel auf der es Dir sicher sehr gut gehen wird.");
  AddDetail( "gloeckchen",
    "Gloeckchen ist eine 66 Zentimeter grosse Fee.");
  AddDetail( "zentimeter",
    "Das ist eine realistische Groesse fuer eine Fee.");
  AddDetail( "groesse" ,
    "Wie schon gesagt: 66 Zentimeter....es wird nicht mehr.");
  AddDetail( "fee",
    "Gloeckchen ist eine.");
  AddDetail( "blumen",
    "Du bist Dir nicht sicher was fuer Blumen das ueberhaupt sind. "
    "Aber es scheinen Blumen zu sein. Oder sind es etwa Kraeuter?");
  AddDetail( "kraeuter",
    "Hmm ja, es scheinen auch sich auch einige Kraeuter darunter zu "
    "befinden. Doch nur ein Kraut siehst Du hier oefter.");
  AddDetail( "kraut",
    "Naja Kraut scheint wohl etwas untertrieben zu sein. Es ist wohl doch "
    "eher eine Staude.");
  AddDetail( "staude",
    "Diese niederwuechsige Staude hat weisse Blueten und sehr viele "
    "duenne Stengel mit etlichen Blaettern. Wie heisst doch schnell "
    "der Name dieser Staude?");
    AD("palme",
    "Es ist eine Betelpalme.");
    
  AddDetail( "name",
    "Der Name dieser Staude ist Steppenraute.");
  AddDetail( "steppenraute",
    "So heisst sie nun mal, ich kann auch nichts dafuer.");
  AddDetail( "stengel",
    "Die Stengel sind sehr duenn und zahlreich.");
  AddDetail( "blaetter",
    "Naja welche Blaetter denn?");
    
  AddDetail( "steppenrauteblaetter",
    "Die Blaetter der Steppenraute schauen sehr fragil aus, fast so "
    "als wuerden sie zerbrechen, greife man sie an.");
  AddDetail( "blueten",
    "Die Blueten sind weiss, und reifen bei guten Bedingungen zu "
    "Fruechten heran.");
  AddDetail( "bedingungen",
    "Die sind alle vorhanden.");
  AddDetail( "fruechte",
    "Meinst Du die von der Steppenraute oder die von der Betelpalme?");
  AddDetail( "steppenrautefruechte",
    "Die Fruechte sind dreichfaechrig und werden, je reifer sie sind, "
    "immer roetlicher. Sie beinhalten braun-schwarze Samen.");
  AddDetail( "samen",
    "Den Samen wird nachgesagt, dass sie antidepressiv und phantasiefoerdernd "
    " sind. Doch wie ist denn ihre Anwendung?");
  AddDetail( "anwendung",
    "Probiers mal mit rauchen!");
  AddDetail( "betelpalme",
    "Die Betelpalme schaut aus, als waere sie schon ein paar Jahre "
    "alt, so gross wie sie ist. Hinter ihr scheint sich etwas zu "
    "befinden.");
  AddDetail( "jahre",
    "Das ist auch gut so, dass sie schon aelter ist, denn erst ab "
    "einem Alter von zirka 15 Jahren tragt sie Fruechte.");
  AddDetail( "betelpalmenfruechte",
    "Die Fruechte der Betelpalme nennt man auch Betelnuss.");
  AddDetail( "betelnuss",
    "Die Betelnuss koennte konsumiert werden, wenn sie reif waere. "
    "Da sie das aber leider noch nicht ist musst Du noch warten. "
    "Doch wie steht es um die Blaetter?");
  AddDetail( "betelpalmenblaetter",
    "Diese Blaetter kann man mit etwas kauen und erreicht dadurch "
    "eine leicht psychedelische Wirkung.");
  AddDetail( "wirkung",
    "Sehr viele bezeichnen diese Wirkung als angenehm.");
  AddDetail( "interessantes",
    "Fast haettest Du es uebersehen, obwohl es Dir sehr unnatuerlich "
    "vorkommt, soetwas hier zu finden. Aber Deine Sinne taeuschen "
    "Dich nicht. Hier ist wahrhaftig eine kleine Felsformation.");
  AddDetail( "sinne",
    "Deine Sinne sind momentan nicht getruebt.");
  AddDetail( ({"felsformation" , "formation" }),
    "Eine etwas abartige Formation von weissen Felsen sind in Deinem "
    "Blickfeld sichtbar.");
  AddDetail( "felsen",
    "Die Felsen scheinen aus Kalk zu bestehen und zeigen deutliche "
    "Kratzspuren.");
  AddDetail( "kratzspuren",
    "Wofuer kratzt man Kalk aus einem Felsen?");
  AddDetail( "kalk",
    "Kalk hat viele Verwendungszwecke. Unteranderem kann man ihn mit "
    "Betelpalmenblaettern kauen.");
  AddDetail( "verwendungszwecke",
    "Mit Kalk braucht man etwa fuer Gips.");
  AddDetail( "gips",
    "Naja Gips ist wiederrum notwendig falls Du Dir was brichst.");

  AddSound(DEFAULT_SOUND,
    "Du hoerst das Rauschen der Wellen.\n");
  AddSound(({"wellen", "rauschen" }),
    "Das Rauschen der Wellen wirkt beruhigend auf Dich.\n");
  AD("bruecke",
      "Die kleine Bruecke fuehrt wieder zurueck.");

  AE("osten", "./cherub1");

  SetProp( P_HIDE_EXITS, ({ "westen" }) );
//Jahrealt, Kopfscheint.
}

