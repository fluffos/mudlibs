// 27-10-96  tante dante@SilberLand

#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>


void init()
{ 

  ::init();
  if (query_once_interactive(this_player()))
  {
    if(present("\nkajuboknopse",TP))
    {
      write("Um nicht zu ertrinken isst Du schnell eine Kajuboknospe.\n");
      TP->command_me("iss kajuboknospe");
    }
    else
      call_out("st1", 50);
  }
}

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Unter Wasser" );
  SetProp( P_INT_LONG, BS(
        "Du tauchst nun in dem gruenen Wasser des kleinen Tuempels. "
        "Der Grund des Tuempels ist voller Wasserpflanzen und vermodertem Holz."
        " Du glaubst auch einen dunklen, grossen Schatten zu erkennen, bist Dir "
        "aber nicht sicher, denn Du siehst nur sehr verschwommen."));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1);
  SetProp(P_ENVIRONMENT,
      ([ENV_TEMPERATURE: 20,ENV_TERRAIN:TT_UNDERWATER, ENV_WATER:500]) );
  AddDetail(("schatten"),
      "Der Schatten erweist sich als ein Eingang in eine Hoehle.");
  AddDetail(("hoehle"),
      "Die Hoehle schaut sehr dunkel und bedrohlich aus.");
  AddDetail(("eingang"),
      "Durch den Eingang koenntest Du in die Hoehle schwimmen.");
  AddDetail(({"pflanze","pflanzen","wasserpflanzen"}),
      "Seltsame Algen strecken sich dem Licht, das durch die Wasseroberflaeche faellt "
      "entgegen.");
  AddDetail(("algen"),
      "Die Algen treiben im Wasser hin und her und verleihen dem Wasser "
      "seine gruene Farbe.");
  AddDetail(("farbe"),
      "Die Farbe des Wassers ist gruen.");
  AddDetail(({"holz"}),
      "Der Grund ist uebersaet mit altem, vermodertem Holz.");
  AddDetail(("ufer"),
      "Das Ufer kannst Du nicht erkennen.");
  AddDetail(("schilf"),
      "Das Schilf ist von hier nicht zu sehen.");
  AddDetail(("sonne"),
      "Die Sonne kann nach hier unten kaum dringen.");
  AddDetail(("licht"),
      "Hier unten im Wasser ist es schon ziemlich dunkel.");
  AddDetail(("blaeschen"),
      "BLOBB machen sie wenn sie an der Oberflaeche zerplatzen.");
  AddDetail(("wasser"),
      "Das Wasser ist gruen und voller Algen. Man kann den Grund des Tuempels nicht "
      "mehr erkennen.");
  AddDetail(({"grund", "boden"}),
      "Der Grund ist uebersaeht mit Holz und Algen.");
  AddDetail(("oberflaeche"),
      "Die Oberflaeche schaut von unten seltsam aus.");
  AddDetail( ({ "tuempel" }),
      "Du tauchst gerade mitten im Tuempel.");
  AddDetail(({"tiere"}),
      "Tiere kannst Du keine erblicken.");
  AddDetail(("dschungel"),
      "Der Dschungel liegt irgendwo ober Dir.");
  AddSound( DEFAULT_SOUND,
      "Du hoerst manchmal ein Glucksen, sonst nichts.");

  AddSmell( DEFAULT_SMELL,
      "Unter Wasser riechen ?");

  AddRoomMessage(({
        "Du solltest nicht vergessen aufzutauchen.\n",
        "Das Wasser ist angenehm warm.\n",
        "Dein Luftvorrat ist begrenzt.\n",
        "Vergiss nicht! Du hast keine Kiemen.\n",
        "GLUCK...GLUCK...GLUCK...\n",
        "Hast Du noch genug Atemluft ?\n"}),60);

  AddCmd( ({ "tauche","tauch" }), "tauchen" );
  AddCmd(({"schwimme","schwimm"}), "schwimmen");
  AddItem(NPC "kfisch" , REFRESH_DESTRUCT);
  AddItem(NPC "cfisch", REFRESH_DESTRUCT);


}

tauchen(string str )
{
  notify_fail( "Wohin willst Du tauchen ?\n" );
  if ( !str ) return 0;
  if ( member( ({"auf","rauf","hoch","nach oben","zur oberflaeche"}),str) !=-1 )
  {
    write( " \n"
        "Du tauchst wieder an die Oberflaeche zurueck.\n");
    TP->move("/d/dschungel/dante/weg/room/tuempel2", M_GO,
        "taucht nach oben zur Oberflaeche","taucht", 
        "taucht aus dem Wasser auf");
    remove_call_out("st1");
    remove_call_out("st2");
    remove_call_out("st3");
    remove_call_out("st4");
    remove_call_out("st5");
    return 1;
  }
  return 0;
}
schwimmen(string str )
{
  notify_fail( "Wohin willst Du schwimmen ?\n" );
  if ( !str ) return 0;
  if ( member( ({"hoehle","zur hoehle","in hoehle","in eingang","eingang","durch eingang"}),str) !=-1 )
  {
    write( " \n"
        "Du nimmst allen Mut zusammen und schwimmst in die Hoehle.\n");
    TP->move("/d/dschungel/dante/weg/room/tuempel4", M_GO,
        "wagemutig in die Hoehle", "schwimmt", "kommt in die Hoehle geschwommen");
    remove_call_out("st1");
    remove_call_out("st2");
    remove_call_out("st3");
    remove_call_out("st4");
    remove_call_out("st5");
    return 1;
  }

  return 0;
}


st1()
{ 
  if( !TP || !present(TP) ) return; // sicher ist sicher... Feyaria.
  write(
      "Du solltest besser auftauchen, Deine Luft wird knapp.\n");
  say( ""+TPN+" hat bald keine Atemluft mehr.\n");
  TP->reduce_hit_point(5);
  call_out("st2",25);
}

st2()
{
  if( !TP || !present(TP) ) return;
  write(
      "Tauch auf oder Du erstickst hier unten.\n");
  say( ""+TPN+" droht zu ersticken.\n");
  TP->reduce_hit_point(10);
  call_out("st3",25);
}

st3()
{
  if( !TP || !present(TP) ) return;
  write(
      "Du bist nahe am Ersticken!!!\n");
  say (""+TPN+" erstickt fast.\n");
  TP->reduce_hit_point(30);
  call_out("st4",20);
}

st4()
{
  if( !TP || !present(TP) ) return;
  write(
      "DU ERSTICKST GLEICH!!!\n");
  say (""+TPN+" erstickt gleich!!!\n");
  TP->reduce_hit_point(30);
  call_out("st5",10);
}

st5()
{
  if( !TP || !present(TP) ) return;
  write(
      "DU ERSTICKST ELENDIGLICH!!!\n");
  say (""+TPN+" erstickt elendiglich!!!\n");
  SetProp(P_KILL_NAME, "Ertrinken");
  TP->do_damage(400);
}
