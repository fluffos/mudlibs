// 27-10-96  tante dante@SilberLand

#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
create()
{
  ::create();

  SetProp( P_INT_SHORT, "In einem hohlem Baumstamm" );
  SetProp( P_INT_LONG, BS(
        "Du steckst in einem hohlen Baumstamm. Ausser etwas morscher Rinde und "
        "vermodertem Holz, sind hier nur mehr einige Wuermer zu erkennen."));
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30,ENV_TERRAIN:TT_CAVE]) );
  AddDetail(({"wuermer","wurm"}),
      "Du ekelst Dich vor diesen schleimige Tieren.");
  AddDetail(("tier"),
      "Wuermer sind Tiere... ");
  AddDetail(({"baumstamm","stamm", "boden", "decke", "wand", "waende"}),
      "Du steckst mitten im Baumstamm drinnen.");
  AddDetail(({"holz"}),
      "Das Holz hier drinnen ist faul und morsch.");
  AddDetail( ({"rinde"}),
      "Die Rinde ist morsch.");
  AddDetail(("sonne"),
      "Die Sonne dringt hier nicht mehr hinein.");
  AddDetail(("himmel"),
      "Den Himmel kann man hier drinnen nicht erkennen.");
  AddDetail(("dschungel"),
      "Den Dschungel kann man im hohlen Baumstamm nur mehr hoeren.");
  AddSound( DEFAULT_SOUND,
      "Du hoerst den lebendigen Dschungel von draussen herein.");

  AddSmell( DEFAULT_SMELL,
      "Das Holz stinkt nach Moder.");
  if(random(3) )  {
    AddItem(NPC "jojog.lpc" , REFRESH_DESTRUCT);	  }
  AddItem(NPC "dkobra.lpc" , REFRESH_DESTRUCT);
  AddCmd(({"krieche","kriechen","kriech"}), "krieche");
}

krieche (string str )
{
  notify_fail( "Wohin willst Du kriechen ?\n" );
  if ( !str ) return 0;
  if ( member( ({"raus","aus stamm","hinaus","aus baumstamm","nach draussen"}),str) !=-1 )
  {
    write( " \n"
        "Du kriechst wieder aus dem hohlen Baumstamm nach draussen.\n");
    TP->move("/d/dschungel/dante/weg/room/weg7", M_GO,
        "wieder nach draussen","kriecht", "kommt aus einem hohlen Baumstamm gekrochen");
    return 1;
  }
  return 0;
}
