// brunnen 5 dante

#include "files.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
create()
{
  ::create();

  SetProp( P_INT_SHORT, "In Schlamm" );
  SetProp( P_INT_LONG, BS(
    "Du steckst voellig im stinkendem Schlamm fest. Ueberall nur Schlamm...\n"));
    
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20,ENV_TERRAIN:TT_CAVE]) );
  
  AddDetail(("schlamm"),
  "Vorne Schlamm, hinten Schlamm, ober Dir Schlamm, unter Dir Schlamm,...");
  
  AddDetail(("decke"),
  "Von der Decke tropft Schlamm...");
  AddDetail(("boden"),
  "Du stehst bis zur Huefte im Schlamm.");
  AddDetail( ({"huefte"}),
    "Du kannst Deine Huefte nicht sehen, da sie im Schlamm steckt!");
  AddDetail(({"wand","waende"}),
  "An der Wand siehst Du einen Pfeil.");
  AddDetail(("pfeil"),
  "Der Pfeil zeigt zu einem Loch.");
  AddDetail(("loch"),
  "Das Loch ist gar kein Loch, sondern eher ein Kreis.");
  AddDetail(("kreis"),
  "Im Kreis kann man eine Zeichnung erkennen.");
  AddDetail(("zeichnung"),
  "Auf der Zeichnung sieht man, wie Dante einen Druidenkreis betritt, und im "
  "naechsten Moment verschwunden ist...");
  AddDetail( ({"dante"}),
    "Dante ist auf der Zeichnung.");
  AddDetail(("druidenkreis"),
  "Der Druidenkreis scheint im Dschungel auf einem Berg zu sein...");
  AddDetail(("dschungel"),
  "Ohne Zweifel, es ist der Dschungel.");
  AddDetail(("berg"),
  "Hmm, wo im Dschungel gibt es einen Berg..."); 
  AddSound( DEFAULT_SOUND,
    "Der Schlamm lacht verlogen...");
  AddSound( ({"lachen", "schlamm"}),
    "Der Schlamm lacht: Nach 'vorneoben' gehts hier sicher nicht weiter!");
  
  AddSmell( DEFAULT_SMELL,
    "IGITT!!!Hier riecht es nach Tod und Verwesung.");

  AddRoomMessage( 
    ({"Du geraetst in Panik...\n",
      "Angst ergreift Besitz von Dir...\n",
      "Ach, waerst Du doch nicht in den Brunnen gesprungen.\n",
      "Du denkst . o O 'BLUBB BLUBB BLUBB'\n",
      "Der Schlamm erdrueckt Dich fast.\n",
      "BLUBB....BLUBB....BLUBB....\n",
      "Du kannst kaum noch atmen...\n",
      "Ende ist auch eine Option...\n",
      "In Deinem Kopf beginnt es zu Blubbern...\n",
      "Du verfluchst Dante!\n",
      "Du denkst an Selbstloeschung...\n",
      "Dante lacht Dich aus!\n",
      "Das Leben stinkt!\n",
      "Wie waers mit 'vorneoben' ?\n",
      "Der Schlamm blubbert und blubbert.\n",
      "Eine beschissene Situation...\n"}) );
 //gebe zu, das hier ist gemein
 
 SetProp(P_HIDE_EXITS, ({"vorneoben"} ));
 AddExit( "vorneoben", "nach BLUBB#./brunnen6");
 }
 
 
 
 
