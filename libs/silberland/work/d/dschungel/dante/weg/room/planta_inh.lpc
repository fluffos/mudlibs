// inh fuer planta nur hinweis auf pflcueken!!!
//nette typos

#include "../def.h"
#include <properties.h>

inherit "std/room";    

create()
{
  ::create();
                 
 AddCmd(({"pflueck","pfluecke"}), "no");
 }
 
 int no(string str)
 {
 notify_fail("Was willst Du hier pfluecken?\n");
 if (!str) return 0;   
 
 if (str=="frucht" || str=="obst" || str=="papaya" || str=="mandastromo" ||
 str =="ananas" || str == "zwergananas" || str=="mango" || str =="banane" ||
 str =="passionsfrucht" )
 
 
 {
 write("Du bist widerrechtlich hier eingedrungen, und bist daher ein Dieb. "
 "Was machen Diebe so im Allgemeinen denn...\n");
 say(""+TPN+" wird bald kriminell werden...\n");
 return 1;
 }
return 0;
}
                     