// weg von tijara raus 1
//dante sl 98 99 97???
#include "files.h"

inherit "std/room";
#include <moving.h>
#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Auf dem Pfad durch die Plantagen");
  SetProp(P_INT_LONG,
      BS(               
        "Der Pfad fuehrt hier zwischen bunten Obstplantagen weiter nach Sueden in "
        "den Dschungel. Man kann die Stadt und das Tor von hier noch erkennen."
        " Zu beiden Seiten erstrecken sich weite Felder voller Obstbaeume und "
        "Straeucher, durch die ein sanfter Wind blaest. Ein hoher Zaun soll die"
        " begehrte Ernte vor Dieben und hungrigen Abenteurern schuetzen.")+
      "Ein Schild.\n");
  AddDetail( ({"wind", "haare"}),
      "Ein sanfter Wind blaest durch Deine Haare.");
  AddDetail(("pracht"),
      "Ueppig und gruen liegt der Dschungel im Sueden.");
  AddDetail(("holz"),
      "Das Holz scheint noch sehr gut erhalten zu sein.");
  AddDetail(({"seite","seiten"}),
      "Oestlich und westlich von Dir schuetzt ein Zaun die Felder vor Dieben.");

  AddDetail(({"strauch","straeucher"}),
      "Ueber den Zaun hinweg kannst Du von den Straeuchern nicht viel erkennen.\n");
  AddDetail(({"baum","obstbaeume","baeume","obstbaum"}),
      "Die bunten Obstbaeume erscheinen Dir wie aus dem Paradiese...\n");
  AddDetail(("zaun"),
      "Westlich und oestlich vom Pfad hat man zum Schutz der Plantagen einen Holzzaun"
      " errichtet, der genau solche Leute wie Dich abhalten soll, sich an fremden"
      " Eigentum zu vergreifen!\n");
  AddDetail(("holzzaun"),
      "Als Du Dir den Holzzaun naeher betrachtest, kommt Dir der Gedanke, dass"
      " er eigentlich fuer Dich kein Hindernis darstellen sollte. Genauer gesagt, "
      "gibt es hier einen Westzaun und einen Ostzaun.");

  AddDetail(("hindernis"),
      "Ueber den Zaun kommst Du sicher irgendwie drueber...\n");
  AddDetail(("schutz"),
      "Ha, waere ja gelacht...\n");
  AddDetail(("ernte"),
      "Die Ernte wird dieses Jahr besonders gut ausfallen. Eigentlich gehoert sie "
      "dem Gouverneur der Stadt Tijara.\n");
  AddDetail(("gouverneur"),
      "Er residiert im Palast in der Stadt Tijara und soll ein strenger, aber \n"
      "gerechter Mann sein.\n");
  AddDetail(({"westen","westlich"}),
      "Auf dieser Seite scheint der Zaun sehr hoch zu sein. Probiers mal auf der "
      "anderen Seite des Holzzauns.\n");
  AddDetail(({"osten","oestlich"}),
      "Der Zaun ist hier etwas eingefallen...\n");
  AddDetail(("eigentum"),
      "Die Plantagen gehoeren dem Gouverneur von Tijara,\n");
  AddDetail(({"diebe","dieb"}),
      "Diebe werden in dieser Gegend hart bestraft.\n");
  AddDetail(({"abenteurer","leute"}),
      "Gesindel, mieses Pack, Tagediebe, Taugenichtse, eben solche Typen wie Du " 
      "sollen vom Obst ferngehalten werden.\n");                                                                          
  AddDetail(({"tor","stadttor"}),
      "Es ist das suedliche Stadttor, das hier die einzige Moeglichkeit ist Tijara "
      "zu betreten.\n");
  AddDetail(({"stadt","tijara"}),
      "Im Norden liegt die Stadt Tijara, Hauptwohnsitz des Gouverneurs.\n");
  AddDetail(("pfad"),
      "Der Pfad fuehrt mitten durch bunte Felder voller reifer Fruechte in den "
      "dichten Dschungel.\n");   
  AddDetail(({"sueden","dschungel"}),
      "Der Dschungel breitet sich in all seiner Pracht im Sueden vor Dir aus.\n"); 
  AddDetail(("obst"),
      "Die saftigen Fruechte lachen Dich ueber den Zaun hinweg an.\n");
  AddDetail(({"obstplantagen","plantagen"}),
      "Angehnem duftend liegen sie zu beiden Seiten des Pfades, und laden geradezu\n"
      "ein sich an den koestlichen Fruechten zu laben.\n");
  AddDetail(({"feld","felder"}),
      "So weit Dein Auge reicht, nichts als Felder voller suesser Fruechte.\n");
  AddDetail( ({"auge", "augen", "spiegel"}),
      "Du versucht Deine Augen anzusehen, aber ohne Spiegel klappt das nicht.");
  AddDetail(("fruechte"),
      "Dir laeuft bei dem Gedanken das Wasser im Mund zusammen.\n");
  AddReadDetail(("schild"),
      "+------------------+\n"
      "|                  |\n" 
      "|     BETRETEN     |\n"       
      "|     VERBOTEN     |\n"
      "|                  |\n"
      "|  Der Gouverneur  |\n"
      "+------------------+\n"
      "         ||\n"
      "         ||\n"
      "         ||\n"
      "         ||\n"
      "         ||\n"
      "         ||\n");                     
  AddDetail(("schild"),
      "Du kannst das Schild lesen.");        
  SetProp(P_LIGHT, 1);

  AddDetail(("boden"),
      "Der Boden weist hier kaum Besonderheiten auf. Es ist einfach ein normaler Pfad.");
  AddDetail(({"besonderheit","besonderheiten"}),
      "Komisch eine kleine Spur fuehrt nach Osten...");
  AddDetail(("spur"),
      "Hmm, welchen Sinn die wohl hat...");
  AddDetail(("sinn"),
      "Den musst Du wohl alleine herausfinden...");
  AddDetail(("himmel"),
      "Am Himmel fliegt gerade ein kleiner Rednaxela vorbei...");
  AddDetail(("rednaxela"),
      "Du weisst nicht was ein Rednaxela ist ? Ein Rednaxela ist etwas ganz "
      "tolles, fabelhaftes, grossartiges...");


  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_JUNGLE]) );

  AddSound( DEFAULT_SOUND,
      "Von den Plantagen hoerst Du ein froehliches Lied.\n");

  AddSmell( DEFAULT_SMELL,
      "Der suesse Duft der Fruechte steigt Dir verlockend in die Nase.");

  AddCmd( ({"kletter", "klettere"}), "kletter");

  AddItem(({NPC"dbiene", NPC"dkoli", NPC"dkakadu", NPC"dbiene", NPC"dbiene",
        SCHMETTERLING, PAPAGEI}) , REFRESH_DESTRUCT);

  AddExit( "norden", "./weg1");
  AddExit( "sueden", "./wegp2");

  AddDetail(({"westlicher zaun", "zaun im westen", "westzaun"}),
      "Der Zaun im Westen ist sehr hoch. Da kommst Du so nie rueber, aber irgendwie "
      "kommt man dorthin. Aber eben nicht hier.");
  AddDetail(({"ostzaun", "zaun im osten", "oestlicher zaun"}),
      "Der Zaun im Osten ist niedrig und eingefallen. Ideal zum drueberklettern!");

}

int kletter(string str)
{
  notify_fail("Ueber welchen Zaun willst Du klettern? Tip: westzaun/ostzaun?\n");
  if( !str ) return 0;
  if( member( ({"ueber oestlichen zaun", "ueber oestlicher zaun", "zaun im osten", "ueber zaun nach osten",
          "ueber oestlicher holzzaun", "ueber oestlichen holzzaun", "ueber ostzaun", "oestlicher holzzaun", "ueber holzzaun nach osten",
          }),str) !=-1 )
  { write(" \n"
      "Du kletterst mit Muehe ueber den oestlichen Holzzaun.\n");


  TP->move("/d/dschungel/dante/weg/room/planta1", M_GO, 
      "ueber den Holzzaun", "klettert",
      "kommt ueber den Zaun geklettert");
  return 1;
  }

  if(member(({"ueber westzaun", "ueber westlichen zaun", "ueber zaum im westen"}),str)!=-1)  {
    write(BS(
          "Du versuchst es, aber schaffst es nicht."));
    return 1; }


    return 0;
}

