/*
 ** plantage mit ananas
 ** dante 97 feb 
 ** 
 */

inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include "files.h"
inherit ROOM "planta_inh.lpc";

nosave int ananas;

create()
{

  room::create();
  planta_inh::create();

  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:30, ENV_TERRAIN:TT_JUNGLE]));
  SetProp (P_INT_LONG, BS(
        "Du befindest Dich nun hinter dem Holzzaun inmitten der Obstplantagen "+
        "von Tijara. Die Erde hier ist saftig und weich, die pralle Sonne des "+
        "tiefen Sueden verleiht dem Obst eine unnachahmliche Farbe und die Fruechte"+
        " lachen Dich verlockend an. Ein leichter Wind blaest durch die Felder "+
        "und Du vergisst fast, dass Du hier unerlaubt eingedrungen bist.\n"));
  SetProp (P_INT_SHORT, "Auf der Obstplantage");

  AddDetail(("boden"),
      "Der Boden ist weich und saftig.");

  AddDetail(({"plantage","plantagen","obstplantagen","obstplantage"}),
      "In diesem Bereich der Plantage baut man vor allem Ananasstauden an.\n");
  AddDetail(({"stauden","staude","obststaude","obststauden"}),
      "Eine unzaehlbare Menge von Ananasstauden waechst und reift hier.\n");

  AddDetail(("sueden"),
      "Du befindest Dich tief im Sueden, oder hast Du das vergessen?\n");
  AddDetail(("obst"),
      "Auf den Plantagen von Tijara baut man Mango, Ananas, Bananen, Papayas \n"
      "und noch vieles mehr an...\n");
  AddDetail(({"feld","felder"}),
      "So weit Dein Auge nur reicht, nichts als Obst...\n");
  AddDetail(({"frucht","fruechte"}),
      "Die Fruechte haengen an den Obststauden und warten nur mehr auf die Ernte.\n");

  AddDetail(({"holzzaun","zaun"}),
      "Der Zaun fuehrt zurueck auf den Pfad. Er ist hier nicht ganz so hoch "
      "wie an anderen Stellen. Man kann ueber ihn drueber klettern.");
  AddDetail ( ("farbe"), "In vielen bunten Farben haengen sie an den Stauden.\n");
  AddDetail ("erde",
      "Die Erde ermoeglicht neben dem idealen Klima das ausgezeichnete "
      "Wachstum der Fruechte.");
  AddDetail ( ({"wind", "blaetter"}),
      "Der Wind laesst die Blaetter hin und herwogen.\n");
  AddDetail ( ({"sonne", "ernte", "ernten"}),
      "Die Sonne lacht vom Himmel. Sie laesst in diesen Breiten mehrere"
      " Ernten in einem Jahr zu.");
  AddDetail ("himmel", "Der Himmel erstrahlt in tiefstem Blau.\n");
  AddDetail ( ({"stadt", "tijara"}), "Du befindest Dich hier auf dem Grund des "+
      "Gouverneurs von Tijara.\n");


  AddSpecialDetail (({"ananasstaude","ananasstauden"}), "d_staude");

  AddSmell( DEFAULT_SMELL,
      "Die Fruechte hier riechen einfach koestlich.\n");

  AddSound( DEFAULT_SOUND,
      "Die Bienen summen ueber die Obstplantage.\n");
  AddExit( "sueden", "./planta2");
  AddExit( "osten", "./planta4");

  AddItem( ({NPC"dbiene", NPC"dkoli", NPC"dkakadu",NPC"dmoskito",SCHMETTERLING}),
      REFRESH_DESTRUCT);
  AddItem(NPC"dobst" , REFRESH_DESTRUCT);

  ananas = 3;

  AddCmd ( ({"kletter","klettere"}), "kletter" );
  AddCmd ( ({"stehle","stiehl"}), "pflueck" );
}

reset()
{
  ::reset();
  ananas=3;
}

string d_staude()
{
  if (ananas)                                                                                         
    return "Eine Ananas haengt im Moment ganz in Deiner Naehe. Du koenntest sie stehlen...\n";
  else return BS("Im Moment scheint keine Ananas in Deiner Reichweite zu sein. "+
      "Jedenfalls kannst Du hier im Moment keine stehlen.\n");
}



int pflueck(string str)
{
  object ob;
  notify_fail ("Was willst Du hier stehlen ?\n");
  if (!str) return 0;
  if (str!="ananas")  return 0;
  if (!ananas)
  {
    notify_fail("Leider ist im Moment keine Ananas in Deiner Reichweite.\n");
    return 0;

  }
  write ("Du stiehlst eine koestliche Ananas und steckst sie sofort ein.\n");
  say (CAP(TPN)+ 
      (TP->QueryProp(P_GENDER) == MALE ? " der miese Dieb": " die miese Diebin")+
      " stiehlt eine koestliche Ananas.\n");
  CLONE(OBJ"dananas", TP);
  ananas--;
  if(ob=present("plantagenarbeiter") )
  {
    tell_room(TO,"Der Plantagenarbeiter schreit: HALTET DEN DIEB!\n");
    ob->Kill(TP);
  }
  return 1;
}

int kletter(string str)
{
  notify_fail ("Wohin willst Du klettern?\n");
  if ( !str ) return 0;
  if ( member( ({"ueber zaun", "ueber holzzaun"}),str) !=-1 )
  {
    write(" \n"
        "Du kletterst ueber den Holzzaun zurueck auf den Pfad.\n");
    TP->move("/d/dschungel/dante/weg/room/wegp1", M_GO,
        "ueber den Holzzaun zurueck auf den Pfad","klettert",
        "kommt ueber den Zaun geklettert");
    return 1;
  }
  return 0;
}
