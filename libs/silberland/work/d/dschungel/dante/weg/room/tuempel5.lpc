// maerz 97  tante dante@SilberLand

#include "files.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <player.h>
#include <mnpc.h>

int ring;

create()
{
  ::create();

  ring = 1;

  SetProp( P_INT_SHORT, "In der Unterwasserhoehle" );
  SetProp( P_INT_LONG, BS(
        "Du stehst nun in der Unterwasserhoehle und stellst sehr erstaunt fest, "
        "dass der Wasserstand Dir nur bis zur Huefte reicht und sich in der Hoehle "
        "eine grosse Luftblase gebildet hat, die Dir das Atmen ermoeglicht. Die "
        "Hoehle ist sehr karg und besteht eigentlich nur aus blankem Fels."));
  SetProp( P_LIGHT, 1 );
  AddDetail(("decke"),
      "Die Decke ist ziemlich niedrig. Ab und zu tropft etwas Wasser herunter.");
  AddDetail(({"wand","waende"}),
      "Die Waende sind feucht und mit Moos bewachsen.");
  AddDetail(("moos"),
      "Gruenes Moos wachst an den Waenden.");
  AddDetail(("fels"),
      "Der Fels ist kahl bis auf etwas Moos.");
  SetProp( P_INDOORS, 1);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20,ENV_TERRAIN:TT_UNDERWATER, ENV_WATER:60]) );
  AddDetail(({"pflanze","pflanzen"}),
      "Nur einige Moose wachsen hier.");
  AddDetail(("algen"),
      "Die Algen treiben im Wasser hin und her und verleihen dem Wasser "
      "seine gruene Farbe.");
  AddDetail(("farbe"),
      "Die Farbe des Wassers ist gruen.");
  AddDetail(({"hoehle","unterwasserhoehle"}),
      "Die Hoehle scheint etwas hoeher als der Wasserspiegel des Tuempels zu liegen. "
      "Der Eingang der Hoehle liegt im Osten.");
  AddDetail(("tuempel"),
      "Der Tuempel liegt ausserhalb der Hoehle. Du kannst ihn den Tuempel zurueck tauchen.");
  AddDetail(("huefte"),
      "Wenn Du aufrecht stehst reicht das Wasser Dir bis zur Huefte.");
  AddDetail(({"luftblase","blase"}),
      "Ohne die Luftblase koenntest Du hier nicht atmen.");
  AddDetail(("atmen"),
      "Durch die vorhandene Luft kann man hier normal atmen.");
  AddDetail(("sonne"),
      "Wenige Sonnenstrahlen fallen durch den Eingang herein und reflektieren "
      "sich, an der Oberflaeche.");
  AddDetail(("himmel"),
      "Den Himmel kann man hier nicht sehen.");
  AddDetail(({"wasserstand","stand"}),
      "Das Wasser steht hier ziemlich niedrig.");
  AddDetail(("eingang"),
      "Der Eingang zur Hoehle liegt weiter im Osten.");
  AddDetail(("wasser"),
      "Das Wasser ist gruen und voller Algen.");
  AddDetail(("grund"),
      "Der Grund ist hier steinig und leicht zu erkennen. Dir faellt ein "
      "glaenzender Gegenstand am Grund des Wassers auf.");
  AddDetail(("gegenstand"),
      "Es koennte sich um ein Schmuckstueck handeln...");
  AddDetail(("oberflaeche"),
      "Da Du hier nur ruhig stehst, und Dich kaum bewegst, ist das Wasser "
      "hier ruhig. Ein kleiner Kaefer ist zu sehen.");
  AddDetail(({"tiere"}),
      "Ein blauer Wassermolch schwimmt umher...");
  AddDetail(({"kaefer","wasserkaefer"}),
      "Ein netter, kleiner Kaefer.");
  AddDetail(("dschungel"),
      "Der Dschungel scheint weit weg zu sein....");
  AddSound( DEFAULT_SOUND,
      "Das Wasser plaetschert sanft dahin.");
  AddDetail(("boden"),
      "Meinst Du den Grund oder das Wasser ?");
  AddSmell( DEFAULT_SMELL,
      "Das Wasser riecht modrig.");
  AddDetail(({"spiegel","wasserspiegel"}),
      "Er ist hoch genug fuer Fische.");
  AddDetail(({"fisch","fische"}),
      "Sie sind recht oft hier.");
  AddDetail("luft",
      "Ohne sie waers nicht gut hier...");

  AddExit("osten", "./tuempel4");
  AddItem("/d/wasser/dante/zinsel/npc/stdfisch", REFRESH_DESTRUCT);
  AddItem("/d/wasser/dante/zinsel/npc/stdfisch", REFRESH_DESTRUCT);


  AddSpecialDetail(({"schmuckstueck","stueck","schmuck"}), "bekommen");
}

reset()
{
  ring = 1;
  ::reset();
  set_next_reset(-1); // Reset wird von tuempel4 aus aktiviert
}

string bekommen()
{
  object ob;
  int ret;
  call_other(ROOM "tuempel4", "???");
  if(ob=present("wassergeist", find_object(ROOM "tuempel4")))
  {
    write("Der Wassergeist schnappt Dich und schleppt Dich weg.\n");
    TP->move(ROOM "tuempel4",M_GO,"wird vom Wassergeist weggeschleppt", "",
        "wird vom Wassergeist hereingeschleppt");
    ob->Kill(TP);
    return "";
  }

  if(present("fisch", TO))  {
    write("Der Fisch stoesst Dich weg!\n");
    say("Der Fisch stoesst "+TP->name(WEN)+" weg!\n");
    return ""; }


    if (!ring)
      return BS("Du tastest mit der Hand den Grund ab, doch Du hast Dich scheinbar "
          "getaeuscht.\n");

    write("Am Grund des Wassers liegt ein seltsamer Ring.\n");
    ob = clone_object(ARMOUR"dexring");
    ret = ob->move(this_player());
    if ( ret==ME_TOO_HEAVY)
    {
      write("Du versuchst den Ring zu nehmen, aber er ist Dir zu schwer.\n");
      ob->remove();
      return "";
    }
    else
    {
      write("Du tastest nach dem Ring und steckst ihn sofort ein.\n");
      say(capitalize(this_player()->name())+" tastet den Grund des Wassers ab "
          "und findet einen Ring.\n");
      ring = 0;
      return "";
    }
}
