//rumpel
#include "files.h"
#include <moving.h>

inherit "std/room";
#include <properties.h>
#include <language.h>
#include <player.h>

nosave int bon;

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Dantes Rumpelkammer" );
  SetProp( P_INT_LONG, (
        "Hier wirft Dante all das herein, war er im Moment nicht brauchen kann. "
        "Ueberall liegt Schrott und unnuetzes Zeug. Es ist auch ziemlich staubig hier, "
        "denn Dantes Putzfrau ist im Streik, weil er sie zu schlecht bezahlt. "
        "Aber vielleicht kannst Du ja aufraeumen..."));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN:TT_JUNGLE]) );
  AddDetail(("boden"),
      "Der Boden ist so schmutzig und ueberfuellt, dass man ihn kaum erkennen kann. "
      "Es liegt soviel Muell herum und man muss aufpassen, dass man nicht stolpert.");
  AddDetail(("streik"),
      "Dante teilt Dir mit: Ne, dieses faule Aas bekommt nicht mehr Geld!");
  AddDetail(("muell"),
      "Hier sollte man wirklich einmal sauber machen...");
  AddDetail(("frau"),
      "Du meinst sicher die Putzfrau.");
  AddDetail(({"kammer","rumpelkammer"}),
      "Du denkst . o 0 'So wohnen also Magier...'");
  AddDetail(("titel"),
      "In Oesterreich sind Titel sehr wichtig, denn ohne einen bist Du nichts.");
  AddDetail(("oesterreich"),
      "Hmmm, ist das was zu essen, wir leben doch im Silberland, oder?");
  AddDetail(("silberland"),
      "Unsere schoene Heimat!");
  AddDetail(("putzfrau"),
      "Dantes Putzfrau hies Erna und wollte Staubmanagerin gennant werden.");
  AddDetail(("erna"),
      "Du singst 'Erna, die fette Erna...'");
  AddDetail(("staub"),
      "Ueberall liegt hier Staub herum. Du selbst bist schon ganz staubig.");
  AddDetail(({"managerin","staubmanagerin"}),
      "Ein daemlicher Titel!");
  AddDetail(("decke"),
      "Die Decke haengt voller Spinnweben...");
  AddDetail(({"wand", "waende"}),
      "An den steht etwas geschrieben.");
  AddDetail(("etwas"),
      "Du kannst es lesen.");
  AddReadDetail(("etwas"),
      "Bin im Streik und ruehre keinen Finger fuer Dante, diesen kapitalistischen Ausbeuter!");
  AddDetail(("schrott"),
      "Wofuer braucht dante all dieses sinnlose Zeug?");
  AddDetail(("zeug"),
      "Eigentlich ist der Muell ziemlich uninteressant, nur die Kiste gefaellt "
      "Dir ganz gut.");
  AddDetail(("kiste"),
      "Hmmm, die Kiste muss nicht immer da sein.");
  AddDetail(({"spinnweben","spinnwebe"}),
      "Grau und gross haengen sie hier ueberall. Du ekelst Dich direkt.");
  AddSound( DEFAULT_SOUND,
      "Es ist sehr still hier.");

  AddSmell( DEFAULT_SMELL,
      "Es riecht hier nach billigem Nuttenparfum.");
  bon=1;


  AddItem(OBJ"jojo", REFRESH_REMOVE);
  AddItem(OBJ"schoko1", REFRESH_REMOVE);
  AddItem(OBJ"dj", REFRESH_REMOVE);
  AddItem(OBJ"dpilz", REFRESH_REMOVE);
  AddItem(OBJ"dhirn",REFRESH_REMOVE);
  // AddItem(NPC"wkiste", REFRESH_DESTRUCT); 
  AddCmd(({"raeum","raeume","mach","mache"}), "clean");
}


reset()
{
  ::reset();
  bon=1;
}


clean (str )
{ 

  notify_fail("Was willst Du hier machen?\n");
  if (( str=="sauber" || str=="auf")  && ( !bon))  

  {
    write("Du versuchst die Rumpelkammer aufzuraeumen, gibst aber bald wieder auf.\n");
    say(""+TPN+" versucht vergeblich die Rumpelkammer aufzuraeumen.\n");
    return 1;
  }
  if (( str=="sauber" || str=="auf")  && ( bon))
  {
    write("Du versuchst die Rumpelkammer aufzuraeumen, gibst aber bald auf.\n"
        "Als Belohnung bekommst Du dafuer Etwas sehr leckeres......\n");
    bon--;
    clone_object("/d/dschungel/dante/weg/obj/schokobons.lpc")->move(TP);

    return 1;
  }
  return 0;
}



void init()
{
  ::init();
  if(!random(2))
    CLONE(OBJ"staub", TP);
}       
