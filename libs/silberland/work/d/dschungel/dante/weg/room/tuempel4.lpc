// maerz 97  tante dante@SilberLand

#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
create()
{
  ::create();

  SetProp( P_INT_SHORT, "In der Unterwasserhoehle" );
  SetProp( P_INT_LONG, BS(
        "Du stehst nun in der Unterwasserhoehle und stellst sehr erstaunt fest, "
        "dass der Wasserstand Dir nur bis zur Huefte reicht und sich in der Hoehle "
        "eine grosse Luftblase gebildet hat, die Dir das Atmen ermoeglicht. Die "
        "Hoehle ist sehr karg und besteht eigentlich nur aus blankem Fels."));
  SetProp( P_LIGHT, 1 );
  AddDetail(("decke"),
      "Die Decke ist ziemlich niedrig. Ab und zu tropft etwas Wasser herunter.");
  AddDetail(({"wand","waende"}),
      "Die Waende sind feucht und mit Moos bewachsen.");
  AddDetail(("moos"),
      "Gruenes Moos wachst an den Waenden.");
  AddDetail(("fels"),
      "Der Fels ist kahl bis auf etwas Moos.");
  SetProp( P_INDOORS, 1);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20,ENV_TERRAIN:TT_CAVE]) );
  AddDetail(({"pflanze","pflanzen"}),
      "Nur einige Moose wachsen hier.");
  AddDetail(("algen"),
      "Die Algen treiben im Wasser hin und her und verleihen dem Wasser "
      "seine gruene Farbe.");
  AddDetail(("farbe"),
      "Die Farbe des Wassers ist gruen.");
  AddDetail(({"hoehle","unterwasserhoehle"}),
      "Die Hoehle scheint etwas hoeher als der Wasserspiegel des Tuempels zu liegen. "
      "Durch den Eingang kannst Du wieder hinaus tauchen.");
  AddDetail(("tuempel"),
      "Der Tuempel liegt ausserhalb der Hoehle. Du kannst in den Tuempel zurueck tauchen.");
  AddDetail(("huefte"),
      "Wenn Du aufrecht stehst reicht das Wasser Dir bis zur Huefte.");
  AddDetail(({"luftblase","blase"}),
      "Ohne die Luftblase koenntest Du hier nicht atmen.");
  AddDetail(("atmen"),
      "Durch die vorhandene Luft kann man hier normal atmen.");
  AddDetail(("sonne"),
      "Wenige Sonnenstrahlen fallen durch den Eingang herein und reflektieren sich, an der Oberflaeche.");
  AddDetail(("himmel"),
      "Den Himmel kann man hier nicht sehen.");
  AddDetail(({"wasserstand","stand"}),
      "Das Wasser steht hier ziemlich niedrig.");
  AddDetail(("eingang"),
      "Durch den Eingang kannst Du wieder hinaus tauchen.");
  AddDetail(("wasser"),
      "Das Wasser ist gruen und voller Algen.");
  AddDetail(("grund"),
      "Der Grund ist hier steinig und leicht zu erkennen. ");
  AddDetail(("oberflaeche"),
      "Da Du hier nur ruhig stehst, und Dich kaum bewegst, ist das Wasser hier ruhig. Ein kleiner Kaefer ist zu sehen.");
  AddDetail(({"tiere"}),
      "Ein kleiner Wasserkaefer padeelt herum...");
  AddDetail(({"kaefer","wasserkaefer"}),
      "Ein netter, kleiner Kaefer.");
  AddDetail(("dschungel"),
      "Der Dschungel scheint weit weg zu sein....");
  AddSound( DEFAULT_SOUND,
      "Das Wasser plaetschert sanft dahin.");
  AddDetail(("boden"),
      "Meinst Du den Grund oder das Wasser ?");
  AddSmell( DEFAULT_SMELL,
      "Das Wasser riecht modrig.");

  AddCmd( ({ "tauche","tauch" }), "tauchen" );
  AddItem(NPC "wassergeist" , REFRESH_DESTRUCT);

  AddGuardedExit("westen", "/d/dschungel/dante/weg/room/tuempel5",
      "wassergeist", "Der Wassergeist taucht Dich kurz unter das Wasser und lacht.\n");

}

tauchen(string str )
{
  notify_fail( "Wohin willst Du tauchen ?\n" );
  if ( !str ) return 0;
  if ( member( ({"raus","in tuempel","hinaus","aus hoehle","aus hoehle raus","aus hoehle hinaus","tuempel","nach draussen","durch eingang"}),str) !=-1 )
  {
    write( " \n"
        "Du holst tief Luft und tauchst in den Tuempel zurueck.\n");
    TP->move("/d/dschungel/dante/weg/room/tuempel3", M_GO,
        "tief Luft und taucht unter","holt", "kommt aus der Hoehle hereingetaucht");
    return 1;
  }
  return 0;
}

void reset()
{
  ::reset();
  call_other("/d/dschungel/dante/weg/room/tuempel5", "reset");
}
