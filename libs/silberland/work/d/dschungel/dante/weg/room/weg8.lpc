// suedlcih von tijara

#include "files.h"

inherit "std/room";
#include <moving.h>
#include <properties.h>
#include <language.h>
create()
{ 
  ::create();
  SetProp( P_INT_SHORT, "Auf dem Dschungelpfad" );
  SetProp( P_INT_LONG, BS(
    "Der Dschungel faellt hier steil, ja beinahe senkrecht ab und Du hast grosse Muehe, "
    "dem Pfad zur Schlucht nach unten zu folgen. Der gigantische Fluss rauscht in der "
    "Tiefe und die Sonne spiegelt sich im schillernden Wasser. Nun ist auch die Bruecke, "
    "die zum anderen Ufer fuehrt ganz deutlich zu erkennen. Auch der gewaltige Wasserfall "
    "ist nun etwas weiter flussaufwaerts im Westen zu erkennen. "));

  AddDetail(("muehe"),
      "Der Pfad fuehrt nahezu senkrecht nach unten...");
  AddDetail(("wasserfall"),
      "Der Wasserfall liegt weiter flussaufwaerts im Westen. Von hier scheint kein Weg "
      "hin zu fuehren.");
  AddDetail(({"weg"}),
      "Es scheint keine Moeglichkeit zu geben zum Wasserfall zu kommen.");
  AddDetail(({"rio","buseta","rio de la puseta"}),
      "Der Rio de la Puseta ist der groesste Fluss im Silberland.");
  AddDetail(("silberland"),
      "Du befindest Dich mitten darin.");
  AddDetail(({"bruecke"}),
      "Die Haengebruecke fuehrt ueber die Schlucht.");
  AddDetail(("haengebruecke"),
      "Auf der Haengebruecke glaubst Du einen grossen Affen zu erkennen.");
  AddDetail(("affe"),
      "Du glaubst Dich laust der Affe...");
  AddDetail(("wasser"),
      "Das Wasser ist smaragdgruen und funkelt in der Tiefe.");
  AddDetail(("himmel"),
      "Der Himmel ist strahlendblau, nur einige Wolken ziehen ueber Dich hinweg.");
  AddDetail(("sonne"),
      "Die Sonne lacht Dich vom Himmel herab an.");
  AddDetail(("ufer"),
      "Auf der anderen Seite der Schlucht beginnt unerforschtes Neuland.");
  AddDetail(("neuland"),
      "Angeblich sollen dort Kannibalen wohnen.");
  AddDetail(({"kannibalen","kannibale"}),
      "Du wirst auch schon hungrig.");
  AddDetail(("westen"),
      "Im Westen liegt der grosse Wasserfall.");
  AddDetail(("gestalt"),
      "Noch bist Du zu weit weg um genaueres zu erkennen.");


  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_JUNGLE]) );

  AddDetail(({"dschungel", "pflanzen"}),
      "Abseits des Pfades wachsen Straeucher, Baeume, Farne, Blumen und Graeser, "
      "die Du alle noch nie zuvor gesehn hast."); 
  AddDetail(({"straeucher","strauch"}),
      "Die Straeucher wachsen hier sehr gut...");
  AddDetail(({"farn","farne"}),
      "Schoen langsam langweilen Dich diese Farne.");
  AddDetail(({"blume","blumen"}),
      "Eine der Blumen faellt Dir besonders auf. Es ist eine Wolkenlilie.");
  AddDetail(({"wolkenlilie"}),
      "Als Du Dir die Wolkenlilie naeher betrachtest, fallen Dir erst die herrlichen Wolken "
      "am Himmel auf.");
  AddDetail(("lilie"),                                                                               
      "Du meinst sicher eine Wolkenlilie.");
  AddDetail(({"wolken","wolke"}),
      "Eine der Wolken schwebt auffallend niedrig dahin. Du glaubst eine "
      "Gestalt darauf zu erkennen.");
  AddDetail(("gestalt"),
      "Du scheinst Dich getaeuscht zu haben, aber wenn nicht, wie kommt dann "
      "die Gestalt auf die Wolke?");
  AddDetail(("wasser"),
      "Das Wasser des Rio de la Puseta ist gruen.");
  AddDetail(({"gras","graeser"}),
      "Hier waechst das sogenannte Gouverneursgras. Eine Sorte Gras, die sehr selten ist.");
  AddDetail(("sorte"),
      "Benannt zu Ehren des Gouverneurs von Tijara.");
  AddDetail(("gouverneursgras"),
      "Diese Sorte hat man nach dem Gouverneur von Tijara benannt. Ein Halm faellt Dir besonders auf.");
  AddDetail(("halm"),
      "Der Halm ist merkwuerdig abgebogen und zeigt zum Rand des Pfades.");
  AddDetail(("rand"),
      "Am Rand siehst Du einen seltsames Ding liegen...");
  AddDetail(("ding"),
      "Bei genauerer Betrachtung erkennst Du, dass es sich um ein eigenartige Gummipflanze "                 
      "handelt.");
  AddDetail(("gummipflanze"),
      "Die Gummipflanze sieht aus wie eine Art natuerliches Trampolin...");
  AddDetail(("gummi"),
      "Die Gummipflanze besteht aus Gummi.");
  AddDetail(("art"),
      "So etwas hast Du noch nie gesehen!");
  AddDetail(("trampolin"),
      "Hmm, Du ueberlegst Dir wozu ein Trampolin denn da ist...");

  AddDetail(("tijara"),
      "Eine groesse Stadt im Norden...");
  AddDetail(("stadt"),
      "Tijara ist eine Stadt.");
  AddDetail(("gouverneur"),
      "Der Gouverneur wohnt in Tijara. Frag ihn mal nach Ratten.");
  AddDetail(({"ratte","ratten"}),
      "Huch! Da ist ja gerade eine Ratte durch das Gras gelaufen...");

  AddDetail(({"baum","baeume"}),
      "Die Baeume werden hier wieder etwas kleiner.");
  AddDetail(("boden"),
      "Der Boden ist weich und saftig durch die feuchte Luft.");
  AddDetail(({"pfad","kurven","kurve"}),
      "Der Pfad fuehrt fast senkrecht nach unten in die Schlucht.");
  AddDetail(("schlucht"),
      "Die breite Schlucht liegt hier fast unter Dir. Eine lange Bruecke fuehrt ueber sie "
      "zum anderen Ufer.");
  AddDetail(("fluss"),
      "Dieser Fluss ist der Rio de la Puseta, der fuer sein smaragdgruenes Wasser bekannt ist.");
  AddDetail(("tiefe"),
      "Die Schlucht scheint sehr tief zu sein, also pass besser auf.");
  AddDetail(({"fels","wand","felswand"}),
      "Die Felswand ist hier eigentlich nicht mehr zu sehen, nur einige wenige Steine liegen "
      "noch herum.");
  AddDetail(({"stein","steine"}),
      "Vereinzelt liegen sie im Gras...");


  AddItem("/d/dschungel/dante/weg/npc/rmoskito", REFRESH_DESTRUCT);



  AddSound( ({DEFAULT_SOUND, "tosen", "wasser"}),
      "Das Tosen des Wasser uebertoent hier fast alles.");

  AddSmell( DEFAULT_SMELL,
      "Die Luft ist hier schon sehr feucht...");

  AddExit( "norden", "./weg7");
  AddExit( "unten", "./weg9");

  AddItem(NPC"bmamba", REFRESH_DESTRUCT );

  AddCmd( ({"spring","springe"}), "springen");
  //AddItem( NPC"babydrache",REFRESH_DESTRUCT);

}
 int springen(string str)
{
  notify_fail("Worauf oder womit willst Du springen ?\n");
  if( !str ) return 0;
  if( member( ({"auf trampolin", "trampolin","mit trampolin","in trampolin", 
          }),str) !=-1 )

  {write (" \n"
      "Du nimmst Anlauf und springst mit grosser Wucht in das natuerliche Trampolin.\n"
      "Das Trampolin schleudert Dich hoch in mitten der Wolken...\n");


  say(""+TPN+" nimmt grossen Anlauf und springt dann mit grosser Wucht in ein natuerliches Trampolin, das "+TPN+" hoch in die Wolken katapultiert.\n");


  clone_object("/d/dschungel/dante/weg/obj/obwolke.lpc")->move(TP, M_NOCHECK);        
  call_out("st1",4);      
  return 1;

  }
  return 0;
}  
st1()
{
  write(" \n"
      " \n"
      " \n"
      "Du saust durch die Wolken und landest wohlbehalten auf einer kleinen Wolke.\n");
  TP->move("/d/luft/dante/wolken/room/wolke",M_GO +M_NO_SHOW,
      "in hohem Bogen durch die Luefte und man kann erkennen, wie "+TPN+
      " auf einer kleinen Wolke landet", "fliegt",
      "kommt durch die Wolken heraufgeflogen und landet sanft neben Dir");
}

