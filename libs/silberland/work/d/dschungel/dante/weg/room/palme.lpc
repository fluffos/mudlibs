// palme 

#include "files.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einer grossen, schraegen Palme" );
  SetProp( P_INT_LONG, BS(
    "Du befindest mitten auf einer gewaltigen, sehr schraegen Palme. Ringsum Dich kannst Du "
    "nur Blaetter, Aeste und Kokosnuesse erkennen. Die Sonne lacht freundlich "
    "vom Himmel, die Voegel zwitschern ein froehliches Lied. Am dicken Stamm "
    "kann man wieder nach unten klettern."));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_JUNGLE]) );
AddDetail(("himmel"),
"Der Himmel ist heute strahlendblau. Nur vereinzelt kann man kleine Wolken "
"sehen.");
AddDetail(({"wolke","wolken"}),
"Die Wolken ziehen ruhig ueber den Himmel.");
AddDetail(({"aeste","ast"}),
"Die Aeste sind eigentlich keine richtigen Aeste, denn eine Palme hat keine "
"Aeste. Es sind die grossen dicken Blaetter, Du Depp.");
AddDetail(({"depp", "idiot", "banause", "narr"}),
"Idiot, Banause, Narr,...");
AddDetail(("palme"),
"Die schraege Palme auf der Du Dich gerade befindest, ist riesengross, und ragt ueber "
"alle anderen hinweg, so dass man eine schoene Aussicht hat.");
AddDetail(("aussicht"),
"Du erkennst im Sueden eine grosse Schlucht, durch die ein grosser Fluss fliesst."
"Im Norden siehst Du einen Tafelberg, der eigentlich gar nicht so weit "
"weg von hier ist. Wie man da wohl hinkommt ?");
AddDetail(("schlucht"),
"Am Grunde der Schlucht fliesst der Rio de la Puseta dahin.");
AddDetail(({"rio","puseta","rio de la puseta"}),
"Der Rio de la Puseta ist der groesste Fluss dieser Region und fuehrt smaragdgruenes Wasser.");
AddDetail(("wasser"),
"Herrlich gruen rauscht es in der Tiefe dahin.");
AddDetail(("sueden"),
"Ueber die Schlucht hinweg sieht man im Sueden unerforschtes Gebiet.");
AddDetail(("gebiet"),
"Angeblich wohnen hier die Kannibalen.");
AddDetail(({"kannibale","kannibalen"}),
"Ob Du ihnen schmecken wuerdest ?");
AddDetail(("norden"),
"Im Norden liegt ein grosser Tafelberg.");
AddDetail(({"berg","tafelberg"}),
"Der Tafelberg ist ueber und ueber mit Pflanzen bewachsen, und verwehrt so "
"jeden Einblick. Er ist wirklich nicht weit weg...");
AddDetail(("region"),
"Du bist im Dschungel...");
AddDetail(("fluss"),
"Der Fluss ist der Rio de la Puseta. Woher der wohl seinen Namen hat...");
AddDetail(({"name","namen"}),
"Du solltest am besten Dante fragen...");
AddDetail(("lied"),
"Gutgelaunt probierst Du mitzupfeiffen, gibst aber gleich wieder auf, "
"denn mit Deiner Musikalitaet ist es nicht allzu weit her.");
  AddDetail(("stamm"),
  "Der Stamm ist sehr dick und weisst eine weissgraue Behaarung auf.");
  AddDetail(("behaarung"),
  "Kleine, sehr duenne graue Haare wachsen am Stamm."),
  AddDetail(({"haare","haar"}),
  "Als Du Dir die Haare genauer betrachtest faellt Dir ein Knoten auf.");
  AddDetail(("knoten"),
  "Der Knoten gehoert zu einem Seil, das die Palme mit dem Boden verbindet. "
  "Im Moment hat er keine Funktion aber bald...");
  AddDetail(("seil"),
  "Erst jetzt "
  "kapierst Du warum diese Palme so schraeg ist. Das Seil spannt sie wie eine "
  "Schnur einen Bogen.");
  AddDetail(("bogen"),
  "Der Bogen diente nur der Veranschaulichung.");
  AddDetail(("schnur"),
  "Hmm, wenn man den Knoten loest, was passiert dann wohl...?");
  AddDetail(("lage"),
  "Die Palme steht gebogen wie ein C da. Das Dir das nicht frueher aufgefallen ist...");
  
  AddDetail( ("boden"),
  "Den Boden kannst Du von hier oben nicht erkennen. Die vielen Pflanzen\n"
  "versperren Dir jegliche Sicht nach unten, viel interessanter jedoch, "
  "ist das kleine Vogelnest...");
  AddDetail(({"nest", "vogelnest"}),
  "Es ist sehr gut versteckt und kaum zu finden. Du glaubst Eier in ihm "
  "zu sehen!");
  AddDetail(({"ei","eier"}),
  "Du glaubst einige Eier zu sehen! Du glaubst! Wenn Du sie haben willst, "
  "musst Du sie stehlen!!!");
  
  
  AddDetail(({"sicht","pflanzen","pflanze"}),
  "Die vielen Schichten von Blaettern und Aesten machen es unmoeglich weit\n"
  "nach unten zu sehn.\n");
  AddDetail(("sonne"),
  "Hoch oben am Himmel steht die pralle Sonne und strahlt direkt auf Dich\n"
   "herab.\n");
   AddDetail(({"schicht","schichten"}),
   "Tief unter Dir liegt der Boden, durch viele Blaetter kaum zu erkennen.");
  AddDetail(({"blaetter","blaettern"}),
   "Du bist direkt umzingelt von Blaettern und Aesten.\n");
  AddDetail(({"voegel","vogel"}),
   "Du kannst keinen sehen, aber hoeren tust Du sie.\n");
  AddDetail(({"dschungel"}),
   "Du steckst mitten drin im Dschungel.");
 AddDetail(({"kokosnuss","kokosnuesse","nuesse","nuss"}),
 "Gross und rund lachen sie Dich an, aber es scheint keine in Deiner Reichweite "
 "zu sein...");
  AddSound( DEFAULT_SOUND,
    "Du hoerst das Singen und Traellern der Voegel. ");
    
  AddSmell( DEFAULT_SMELL,
    "AHH! Hier riecht man die pure Natur!");

 
 AddItem( ({NPC"dkoli", NPC"dkakadu"}) , REFRESH_DESTRUCT);
 AddItem(({NPC"dgorilla2", NPC"dschimp", NPC"dpavian"}), REFRESH_DESTRUCT);
AddItem(NPC"paravo", REFRESH_NONE);
 
 AddCmd(( {"klettere", "kletter"}), "klettern");
 AddCmd(( {"loese", "loes"}), "loesen");    
 AddCmd(({"stehle", "stiehl"}), "get");
  
}

int get(string str)
{
  object ob;
  notify_fail("Was willst Du hier stehlen?\n");

  if(str=="ei"||str=="eier"||str=="eier aus nest"||str=="ei aus nest")
  {
    if(!present("ESSEN", TP))
    {
      write("Du kannst die Eier nicht stehlen!\n");
      return 1;
    }

    if(deep_present("paradiesvogelei", TP))     {
      write("Du siehst doch kein Ei im Nest!\n");
      return 1;
    }

    else
    {
      write("Du stiehlst ein Ei aus dem Nest!\n");
      ob=clone_object("d/dschungel/dante/weg/obj/eier");
      ob->move(TP, M_NOCHECK);
      return 1;
    }

    return 0;
  }
  return 0;
}

   
   
   
   
     
   
   

 int klettern(string str )
{
  notify_fail( "Wohin willst Du klettern?\n" );
  if( !str ) return 0; 
  if( member( ({"runter","nach unten", "von palme" }),str) !=-1 )
                      
    
  {
    write (" \n"
     "Du kletterst mit grosser Muehe von der Palme nach unten.\n");
    TP->move("/d/dschungel/dante/weg/room/weg14", M_GO, "nach unten","klettert",
      "kommt von der Palme herab geklettert");
      
    return 1;
       }
  return 0;
     }


 
 int loesen(string str )
{

  
  notify_fail( "Was willst Du loesen? Ein Raetsel ?\n" );
  if( !str ) return 0; 
  if( member( ({"knoten","knoten auf"}),str) !=-1 )
                      
      write_file("/d/dschungel/dante/weg/log/knoten", 
         dtime(time())+": "+capitalize(getuid(TP))+" loest den Knoten.\n");
    
    
    
    {
    write(" \n"
    "Du loest den Knoten vom Stamm und die Palme schnellt ruckartig nach vor."
    " \n"
    " \n"
    "SSSSSSSS........\n"
    " \n"
    "          SSSSSSSSS........\n"
    " \n"
    "                      SSSSSSSSSS.......\n"
    " \n"
    "                                    SSSSSSSSSS.......\n"
    " \n"
    "                                               SSSUISSSCHHH.....\n"
    " \n"
    " \n"
    "....DU SAUST DURCH DIE LUFT......\n"
    " \n"
    "                           ......UND LANDEST IRGENDWO AUF EINER INSEL.....\n"
    " \n");
    
    
    TP->move("/d/dschungel/dante/weg/room/cherub1", M_GO, "den Knoten und saust durch die Luft davon",
    "loest",
      "kommt durch die Luft geflogen und landet wohlbehalten am weichen Boden");
      
    return 1;
       }
  return 0;
     }

void NewBird()
{
  object ob;
  ob=clone_object("d/dschungel/dante/weg/npc/paravo");
  ob->move(TO, M_NOCHECK);
}

void new_bird()
  {
  call_out("NewBird", 20);
  }
  
