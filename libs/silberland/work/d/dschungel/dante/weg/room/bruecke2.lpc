// 27-10-96  tante dante@SilberLand
//hier is die leiter
//umgebaut 2000 dante

#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <wizlevels.h>
create()
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einer grossen Haengebruecke" );
  SetProp( P_INT_LONG, BS(
        "Du stehst nun auf der stark schaukelnden Haengebruecke, die quer ueber "
        "eine tiefe Schlucht fuehrt. In der Tiefe rauscht ein grosser Fluss dahin,"
        " der Wind pfeift Dir um die Ohren, und Du hast grosse Muehe das Gleichgewicht "
        "zu behalten. Flussaufwaerts siehst Du einen gigantischen Wasserfall. "
        "Eine schmale Leiter ist im Westen an der Bruecke befestigt.\n"));                                                                        

  AddDetail("leiter",
      "Die Leiter ist schmal und alt. Sie fuehrt nach unten auf eine recht, grosse "
      "Sandbank. Leider ist sie noch nicht fertig!!!");

  AddDetail("sandbank",
      "Die Sandbank liegt am Ufer des Flusses. Sie ist recht ausgedehnt und sieht "
      "ungefaehrlich aus. Dort unten soll ein alter Matrose leben.");
  AddDetail("matrose",
      "Kletter runter und er hat sicher einige Abenteuer fuer Dich!");
  AddDetail("abenteuer",
      "Du bist suechtig danach!");

  AddDetail("ufer",
      "Das Ufer liegt direkt unter Dir. Steile Klippen. Direkt unter Dir, "
      "befindet sich aber eine Sandbank, die Du mit der Leiter erreichen kannst.");
  AddDetail(({"klippen","klippe"}),
      "Der Fluss ist von steilen, hohen Klippen umrahmt.");
  AddDetail("sand",
      "Ja, wirklich, die Sandbank besteht aus Sand.");


  AddDetail(("westen"),
      "Im Westen liegt der Wasserfall und die Leiter. Der Wasserfall liegt "
      "natuerlich viel weiter im Westen.");   
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_JUNGLE]) );
  AddDetail(("wasserfall"),
      "Der Wasserfall ist wirklich beeindruckend.");
  AddDetail(({"bruecke","haengebruecke"}),
      "Die Bruecke spannt sich von hier ueber die ganze Schlucht nach Sueden. "
      "Sie ist eine einfache Konstruktion aus Holzbrettern und Seilen.");
  AddDetail(("holz"),
      "Das Holz schaut schon ziemlich morsch aus. Hier scheint jemand Zeichen ins Holz geritzt zu haben...");
  AddDetail(({"seil","seile"}),
      "Die Seile verbinden die einzelnen Bretter und zwei besonders dicke Seile "
      "sind als Gelaender rechts und links gespannt.");
  AddDetail(("gelaender"),
      "Das Gelaender besteht nur aus zwei Seilen. Pass auf, dass Du nicht in die "
      "Tiefe stuerzt.");
  AddDetail(("zeichen"),
      "Hier sprang der Abenteurer Ovid am 11.3.1997 in den Tod. Friede seiner Seele.\n");
  AddDetail(("bretter"),
      "Zwischen den Brettern sind grosse Luecken...");
  AddDetail(({"luecken","luecke"}),
      "So manchem Abenteurer wurden diese Luecken zum Verhaengniss...");
  AddDetail(("verhaengniss"),
      "                                TOD!!!\n");
  AddDetail(("abenteurer"),
      "Solche Leute wie Du...");
  AddDetail(("pfad"),
      "Der Pfad liegt im Norden und im Sueden der Bruecke...");
  AddDetail(("sueden"),
      "Die Bruecke fuehrt gen Sueden ueber die Schlucht in den Dschungel.");
  AddDetail(("norden"),
      "Im Norden fuehrt der Pfad steil wieder bergauf...");
  AddDetail(("dschungel"),
      "Der Dschungel liegt zu beiden Seiten der Schlucht.");
  AddDetail(("muehe"),
      "Die Bruecke schwankt gewaltig...");
  AddDetail(("gleichgewicht"),
      "OOOPS!!! Fast waerst Du in die Tiefe gestuerzt.");
  AddDetail(({"pflanze","pflanzen"}),
      "Der Dschungel ist schon ein ganzes Stueck von Dir entfernt...");
  AddDetail(("farbe"),
      "Die Farbe des Wassers ist gruen.");
  AddDetail(({"fluss"}),
      "Unter Dir fliesst der Rio de la Puseta dahin...");
  AddDetail(({"rio","puseta","rio puseta","rio de la puseta"}),
      "Der Rio de la Puseta schaut von hier oben noch viel maechtiger und breiter aus.");
  AddDetail(("wind"),
      "Der Wind laesst die Bruecke hin und herschwanken...");
  AddDetail(({"ohr","ohren"}),
      "Du hoerst den Fluss rauschen und den Wind pfeiffen...");
  AddDetail(("tiefe"),
      "Du wagst es einen Blick ueber die Seile in die Tiefe zu werfen, und gehst sofort "
      "wieder einen Schritt zurueck, bevor Dir schwindlig wird.");
  AddDetail(("sonne"),
      "Die Sonne strahlt hell herab.");
  AddDetail(("himmel"),
      "Die blaue Farbe des Himmels ist ein schoener Kontrast zum gruenen Wasser.");
  AddDetail(("blick"),
      "Viele, viele Meter gehst es in die Tiefe...");
  AddDetail(("wasser"),
      "Das Wasser rauscht tief unter Dir dahin... ");
  AddDetail(("schlucht"),
      "Die Schlucht liegt unter Dir und beeindruckt Dich mit ihren gewaltigen Ausmassen.");
  AddDetail(({"ausmasse","ausmassen"}),
      "Die Schlucht schaut von hier oben wirklich gigantisch aus.");
  AddSound( DEFAULT_SOUND,
      "In der Tiefe rauscht das Wasser.");

  AddSmell( DEFAULT_SMELL,
      "Die Luft schmeckt und riecht hier sehr feucht.");

  AddRoomMessage(({
        "Die Bruecke schaukelt gewaltig hin und her...\n",
        "Der Wind zerzaust Dein Haar.\n",
        "In der Tiefe rauscht der Fluss.\n",
        "Fast waerst Du gestolpert...\n",
        "Das Holz knarrt verdaechtig laut...\n", 
        "Die Bruecke schwankt im Wind...\n"}),40);

  AddItem(NPC"dgeier", REFRESH_DESTRUCT);
  AddItem(NPC"dkakadu", REFRESH_DESTRUCT);

  AddExit("sueden", "./bruecke3");
  AddExit("norden", "./bruecke1");
  AddCmd(({"springe","spring"}), "tod");
  AddCmd(({"kletter", "klettere"}), "down");
}

down(string str)
{
  notify_fail("Wo oder womit willst Du nach unten klettern!\n");
  if(str=="nach unten"||str=="runter"||str=="mit leiter runter"||
      str=="an leiter runter"||str=="mit leiter nach unten")
  {
    if(TP->QueryProp(P_GHOST))
    {
      write("Nein, als Geist sicher nicht!\n");
      return 1;
    }


    if(getuid(TP)=="cute"  )   {

      write(BS(
            "Fleissige Tester duerfen hier alles!"));
      TP->move("d/dschungel/dante/fisch/room//bruecke4", M_GO,
          "an der Leiter nach unten", "klettert",
          "kommt die Leiter nach unten geklettert");
      return 1; }




      if(!IS_WIZARD(TP))  {
        write(BS(
              "Sorry, nicht fertig! Dante."));
        return 1; }


      else




        if(find_living("tantalus"))
        {
          write("Du kletterst die Leiter nach unten, bereit mit "
              "Tantalus auf Leben und Tod zu kaempfen!\n");
          TP->move("d/dschungel/dante/fisch/room/bruecke4", M_GO,
              "an der Leiter nach unten", "klettert", 
              "kommt die Leiter nach unten geklettert");
          return 1;
        }
        else
        {
          write("Du kletterst die Leiter nach unten.\n");
          TP->move("d/dschungel/dante/fisch/room//bruecke4", M_GO,
              "an der Leiter nach unten", "klettert",
              "kommt die Leiter nach unten geklettert");
          return 1;
        }
      return 0;
  }
  return 0;
}




tod(string str )
{
  notify_fail( "Wohin willst Du springen ?\n" );
  if ( !str ) return 0;
  if ( member( ({"nach unten","runter","in wasser","in fluss","in tiefe","ueber seil","von bruecke" }),str) !=-1 )
  {
    if(TP->QueryProp(P_GHOST))
    {
      write("Aber Du bist doch schon tot!!\n");
      return 1;
    }
    write(BS("Du willst Dein Leben also beenden? Dann gib 'spring "
          "selbstmoerderisch von der bruecke' ein."));
    return 1;
  }
  if( member(({"selbstmoerderisch von der bruecke","selbstmoerderisch von bruecke"}), str) !=-1)                              
  {
    say(CAP_TPN+" setzt seinem jaemmerlichen Leben ein Ende und springt in den Tod.\n");
    clone_object("/d/dschungel/dante/weg/obj/sprung.lpc")->move(TP,M_NOCHECK);
    TP->move("/d/dschungel/dante/weg/room/tod",M_SILENT + M_NO_SHOW + M_GO);
    write(
        " \n"
        "Du setzt einen Schlusstrich unter Dein jaemmerliches Leben und springst ueber das Seil in den Tod.\n"
        " \n"
        "      AHHHH.....\n"
        " \n"
        "             HHHHH.....\n"
        " \n"
        "                    HHHHH.....\n"
        " \n"
        "                           HHHHH.....\n"
        " \n");
    call_out("st1",6);

    return 1;
  }
  return 0;
}
st1()
{
  write(" \n"
      "Du bereust diesen unueberlegten Schritt noch waerend Du in der Luft nach unten "
      "rast, aber nun ist es zu wohl spaet, Du Idiot...\n");
  tell_room(TO,"Du siehst wie "+TPN+" in die Tiefe stuerzt.\n");
  call_out("st2",6);
}

st2()
{
  write(" \n"
      "Du prallst auf dem steinharten Wasser auf und wirst zerschmettert!!!\n");
  tell_room(TO,"Du erkennst in der Tiefe der Schlucht wie "+TPN+" zerschmettert wird.\n");
  TP->do_damage(500);
  SetProp(P_KILL_NAME, "Ein selbstmoerderischer Sprung");
}
