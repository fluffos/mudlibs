// ein kleines baumhaus

#include "/d/dschungel/dante/weg/room/files.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

int jojo;

create()
{
  ::create();
  jojo = 3;
  SetProp( P_INT_SHORT, "Auf einem Jojobaum" );
  SetProp( P_INT_LONG, BS(
        "Du befindest Dich hier sehr hoch ueber dem Boden auf einem Jojobaum. Die Sonne "
        "scheint, die Aussicht ist eher schlecht, denn Du steckst mitten im dichtesten "
        "Dschungel."));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_JUNGLE]) );
  AddDetail(("baum"),
      "Dieser Baum ist ein sogenannter Jojobaum.");
  AddDetail(("jojobaum"),
      "Ueber den Jojobaum erzaehlen sich die Alten viele Geschichten.");
  AddDetail(({"alte","alten"}),
      "Die Alten sind oft sehr weise...");
  AddDetail(({"geschichte","geschichten"}),
      "Die Geschichten ueber den Jojobaum sind wohl eher Mythen.");
  AddDetail(({"mythen","mythos"}),
      "Der Mythos wurde urspruenglich von einem Greis erzaehlt...");
  AddDetail(("greis"),
      "Der Greis lebt aber nun schon lange in einer Psychiatrie.");
  AddDetail(("psychiatrie"),
      "Der Greis behauptet naemlich allen Ernstes, dass wenn man eine bestimmte "
      "Formel auf einem Jojobaum sitzend murmelt, Jojos vom Himmel fallen!");
  AddDetail(("formel"),
      "Angeblich weiss der Bettler suedlich von Tijara diese Formel.");
  AddDetail(("bettler"),
      "Er lungert beim suedlichen Tor herum...");
  AddDetail(("tijara"),
      "Die groesste Stadt im Dschungel.");
  AddDetail(("stadt"),
      "Tijara ist eine Stadt.");
  AddDetail(("himmel"),
      "Der Himmel ist wolkenlos. He! Da geht es ja nach oben in ein kleines Haus!");
      AddDetail("haus", 
      "Gehe einfach nach oben...");
      
  AddDetail( ("boden"),
      "Den Boden kannst Du von hier oben nicht erkennen. Die vielen Pflanzen\n"
      "versperren Dir jegliche Sicht nach unten.\n");
  AddDetail(({"sicht","pflanzen"}),
      "Die vielen Schichten von Blaettern und Aesten machen es unmoeglich weit\n"
      " nach unten zu sehn.\n");
  AddDetail(("sonne"),
      "Hoch oben am Himmel steht die pralle Sonne und strahlt direkt auf Dich\n"
      "herab.\n");
  AddDetail(({"blaetter","ast","aeste","blaettern","aesten","pflanze","pflanzen"}),
      "Gruen, gruen, gruen, alles nur gruen...\n");
  AddDetail(("aussicht"),
      "Im Norden kann man von hier leider nur Pflanzen erblicken. "
      "Im Sueden erkennt man eine tiefe Schlucht und einen grossen Fluss. "
      "Im Westen erstreckt sich das Meer und im Osten kann man einen Tafelberg "
      "sehen.");   
  AddDetail(({"norden"}),
      "Die Sicht nach Norden ist sehr begrenzt.");
  AddDetail(({"westen","meer"}),
      "Blau, blau und unendlich weit...\n");
  AddDetail(({"sueden","schlucht"}),
      "Der Pfad scheint direkt zur Schlucht und noch weiter zu fuehren. "
      "Sehr weit im Sueden glaubst Du ein Dorf zu erkennen.");
  AddDetail(("fluss"),
      "Dieser Fluss ist der Rio de la Puseta, der fuer sein smaragdgruenes Wasser bekannt ist.");
  AddDetail(({"rio","puseta","rio de la puseta","rio puseta"}),
      "Der Rio de la Puseta soll der groesste Fluss hier sein.");                                             
  AddDetail(("wasser"),
      "Das Wasser funkelt smaragdgruen."); 
  AddDetail(("dorf"),
      "Wer wohl in dem Dorf wohnen mag?\n");
  AddDetail(({"dschungel"}),
      "Bis zum Horizont kannst Du nur den scheinbar unendlich grossen Dschungel\n"
      "erblicken.\n");
  AddDetail(({"berg","tafelberg"}),
      "Ein recht grosser Tafelberg liegt Dir gegenueber im Osten.");
  AddDetail(("osten"),
      "Im Osten liegt ein Tafelberg.");

  AddSound( DEFAULT_SOUND,
      "Du hoerst das Singen und Traellern der Voegel. ");

  AddSmell( DEFAULT_SMELL,
      "AHH! Hier riecht man die pure Natur!");

  AddItem( ({NPC"dschimp", NPC"dpavian"}) , REFRESH_DESTRUCT);
  AddItem( ({NPC"dkoli", NPC"dkakadu", NPC"dbiene"}), REFRESH_DESTRUCT);

  AddCmd(( {"kletter", "klettere"}), "klettern");
  AddCmd(( {"murmel","murmle"}), "murmeln");    
  
  
  SetProp(P_HIDE_EXITS, ({"oben"}) );

}

reset() {
  jojo=1;
  ::reset();
  set_next_reset(15*60); // 15 minuten
}

klettern(string str) {
  notify_fail( "Wohin willst Du klettern?\n" );

  if( !str ) 
    return 0; 
  if( member( ({"unten", "nach unten", "runter", "hinunter", "zu boden",
          "hinab"}),str) !=-1 ) {
    write(
        "Du kletterst mit grosser Muehe vom Jojobaum nach unten.\n" );
    TP->move( "/d/dschungel/dante/weg/room/weg6", M_GO, "nach unten",
        "klettert", "kommt von oben herab geklettert");
    return 1;
  }
  return 0;
}

murmeln ( str ) {

  notify_fail("Was willst Du murmeln ?\n");
  if( (str == "komm-komm") ) {
    say(
        TPN+" murmelt etwas unverstaendliches...\n" );
    if( this_player()->FindPotion(
          "Du murmelst die Formel 'komm-komm' und ein Zaubertrank, denn Du "+
          "sofort trinkst faellt aus heiterem Himmel genau in Deine Haende.\n") ) {
      WLOG(LOG "jojo_zt", "findet den ZT auf dem Jojobaum"); 
      1;
    }
    else {
      if( jojo ) {
        write(
            "Du murmelst die Formel 'komm-komm' und ein Jojo faellt aus "+
            "heiterem Himmel genau in Deine Haende.\n" );
        CLONE( OBJ"jojo", TP );
        jojo--;
        return 1;
      }
      write(
          "Du murmelst die Formel 'komm-komm', doch nichts passiert.\n" );
      return 1;
    }
  }
  return 0;
}
