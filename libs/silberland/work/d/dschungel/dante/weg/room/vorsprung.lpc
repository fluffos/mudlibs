//felsvorsprung 

#include "files.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
create()
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einem Felsvorsprung hoch ueber der Schlucht" );
  SetProp( P_INT_LONG, BS(
    "Du stehst nun auf einem kleinen Felsvorsprung hoch ueber der Schlucht. Tief"
    " unter Dir rauscht ein reissender Fluss und nach oben fuehrt ein steiler "
    "Weg wieder zurueck in den Dschungel. Ein grosses Loch oeffnet sich in der "
    "Felswand und fuehrt tief in eine dunkle Hoehle. Das andere Ufer kann man "
    "von hier noch gut erkennen."));
    AddDetail(("ufer"),
    "Irgendwie kommt man da sicher hin...");
   AddDetail(({"felsvorsprung","vorsprung"}),
   "Steil und schmal liegt er hier hoch ueber dem Fluss.");
   AddDetail(("himmel"),
   "Strahlendblau scheint er heute zu sein.");
    
   AddDetail(("hoehle"),
   "Die Hoehle scheint tief in den Fels zu fuehren."); 
   AddDetail(("boden"),
   "Der Boden besteht aus blankem Granit.");
   AddDetail(("granit"),
   "Im Granit kannst Du seltsame Spuren erkennen.");
   AddDetail(({"spur","spuren"}),
   "Sieht aus als haette jemanden in den Stein gebissen..."); 
   AddDetail("loch",
   "Vor Dir klafft ein meterhohes Loch in der Felswand."), 
  AddDetail("weg",
  "Der kleine, steinige Weg fuehrt fast senkrecht die Felswaende hinauf und scheint "
  "nocht etwas nach unten zu fuehren.");
  AddDetail(({"felswand","felswaende"}),
  "Steil ragen die Waende der Schlucht hier nach oben.\n");
  AddDetail(({"felsen","fels"}),
  "Auf einer Seite nur Fels, auf der anderen faellt die Felswand senkrecht bis "
  "zum Wasser hinab.\n");
  AddDetail(("wasser"),
  "Das Wasser des Rio de la Puseta ist hier smaragdgruen."); 
  AddDetail(("fluss"),
  "Der smaragdgruene Rio de la Puseta rauscht tief unter Dir dem Meer entgegen.");
  AddDetail(("meer"),
  "Das Meer ist von hier sehr weit entfernt.\n");
  AddDetail(("schlucht"),
  "Die enge Schlucht bildet hier die Grenze zwischen dem erforschtem Gebiet im"
  " Norden und dem unbekanntem Land im Sueden.");
  AddDetail(("grenze"),
  "Die Schlucht zerreist den Dschungel hier jaeh.");
  AddDetail(("sueden"),
  "Am anderen Ufer des Rio de la Puseta beginnt voellig unerforschtes Neuland.\n");
  AddDetail(("gebiet"),
  "Das erforschte Gebiet liegt in der groesseren Umgebung von Tijara.");
  AddDetail(("tijara"),
  "Tijara ist eine grosse Stadt, die weit im Norden liegt.");
  AddDetail(("norden"),
  "Im Norden liegt die Stadt Tijara.");
  AddDetail(("neuland"),
  "Deine Abenteuerlust steigt...");
  AddDetail(("land"),
  "Das Land ist reich und wild in dieser Region.\n");
  AddDetail(({"rio","puseta","rio de la puseta"}),
  "Der Rio de la Puseta ist der groesste Fluss im Silberland.");
  AddDetail(("dschungel"),
  "Der Dschungel liegt ober Dir.");
    
  SetProp( P_LIGHT, 1);
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 23, ENV_TERRAIN:TT_JUNGLE]) );
 
  AddSound( DEFAULT_SOUND,
    "Aus der Hoehle hoert man lautes Krachen.");
    
  AddSmell( DEFAULT_SMELL,
    "Du kannst das Wasser direkt riechen.");
 
 AddExit( "norden", "/d/dschungel/dante/stein/room/eingang1");
 AddExit( "oben", "./vorsprung2"); 
 AddExit("unten","./vorsprung3");
 
 AddItem(NPC"dschlange", REFRESH_DESTRUCT);
} 
