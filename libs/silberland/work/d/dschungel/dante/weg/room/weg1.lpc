create()
{
  ::create();

  SetProp( P_INT_SHORT, "Vor dem suedlichen Stadttor von Tijara" );
  SetProp( P_INT_LONG, BS(
        "Du stehst vor dem suedlichen Stadttor von Tijara. Es scheint hier der "
        "einzige Eingang in die Stadt zu sein, denn ringsum erhebt sich die hohe "
        "Stadtmauer. Ueber dem Tor kannst Du eine Tafel und eine steinerne Figur"
        " erkennen. Der Pfad fuehrt zwischen Obstplantagen geradewegs in den "
        "Dschungel hinein. Direkt neben der Mauer steht ein seltsamer Kaefig."
        "                                         Vier Plakate."));    

  AddDetail(({"plakate","plakat"}),
      "Es ist ein weisses, ein rotes, ein gelbes und ein schwarzes Plakat!");
  AddSpecialDetail("weisses plakat", "show_sieger");
  AddSpecialDetail("schwarzes plakat", "show_verlierer");
  AddSpecialDetail("rotes plakat", "show_tote");
  AddSpecialDetail("gelbes plakat", "show_aufgabe");
  AddDetail("kaefig",
      "Der Kaefig steht am Boden neben der Stadtmauer. Er ist circa 2 mal 2 Meter "
      "gross. Er besteht aus stabilen Metall und seine Tuer wird durch einen "
      "Riegel gesichert. Irgendwie sieht er angesabbert aus.");
  AddDetail("metall",
      "Das Metall sieht stabil und recht neu aus. Sabber tropft herunter...");
  AddDetail("sabber",
      "Der Sabber rinnt langsam zu Boden. Eklig!");
  AddDetail("riegel",
      "Der Riegel sieht auch recht stabil aus. Ein Schild ist unter ihm am "
      "Kaefig angebracht.");
  AddDetail("schild",
      "Das Schild ist auch angesabbert. Lies es!");
  AddReadDetail("schild",
      "+----------------------+\n"
      "|       ACHTUNG!!!     |\n"
      "|      Sabbergnom      |\n"
      "+----------------------+\n");
  AddDetail(({"gnom","sabbergnom"}),
      "Der Sabbergnom lebt im Kaefig. Du musst schon in den Kaefig reinsteigen.");
  AddDetail(({"tuer","tuere"}),
      "Die Tuere ist aus stabilen Metall, wie der Kaefig auch. Wenn Du ihn "
      "den Kaefig willst --> <steige in kaefig>!");


  AddDetail(({"tor","eingang","stadttor"}),
      "Im Norden siehst Du ein grosses Tor, durch das man die Stadt betreten "
      "kann. Rechts und links davon schliesst sich die Stadtmauer an.");
  AddDetail(({"mauer","stadtmauer"}),
      "Die Stadtmauer ist aus grossen hellgrauen Steinbloecken erbaut und ist "
      "hier ungefaehr 4 Meter hoch und besonders stark befestigt. Scheinbar "
      "lauern aus dem Sueden die meisten Gefahren. Ein Steinblock "
      "scheint etwas lose zu sein. Du siehst einen weissen Fleck.");
  AddDetail("fleck",
      "Der Fleck erweist sich als ein Knochen, den irgendjemand hier "
      "eingemauert hat.");
  AddDetail("knochen",
      "Der Knochen ist sproede und fast zerbroeckelt. Er ist ueberzogen von Punkten "
      "und Kratzern.");
  AddDetail(({"punkt","punkte"}),
      "Die Punkte sind ueberall.");
  AddDetail(({"kratzer"}),
      "Die Kratzer bilden ein eigenartiges Muster.");
  AddDetail("muster",
      "Das Muster ergibt fuer Dich keinen Sinn, aber es geht etwas bedrohliches "
      "von ihm aus. Du solltest vorsichtig sein! Irgendwie kannst Du aber "
      "doch einen kleinen, eingeritzen Totenschaedel erkennen.");
  AddDetail(({"schaedel","totenschaedel"}),
      "Der Schaedel ist nur sehr klein, die Augen kann man aber gut erkennen.");
  AddDetail(({"augen","auge"}),
      "Die Augen signalisieren Dir etwas und ploetzlich formt "
      "sich ein Bild in Deinem Kopf. Du siehst eine Mauer vor einer Stadt. "
      "Nahe der Mauer steht Jemand und im naechsten Moment ist er auch schon weg! "
      "Hmmm, vielleicht solltest Du irgendetwas mit dem Knochen machen...");

  AddDetail(({"gefahr","gefahren"}),
      "Wenn Du ewig hier stehst, wirst Du wohl nie erfahren welche Gefahren im "
      "Sueden lauern.");
  AddDetail(({"bloecke","block","steinbloecke","steinblock","stein","steine"}),
      "Die Steinbloecke sind grosse Quader aus Granit, die sicherlich sehr viel "
      "wiegen und sich ideal fuer solche Bauten eignen.");
  AddDetail(({"stadt","tijara"}),
      "Im Norden liegt die Stadt Tijara, Hauptwohnsitz des Gouverneurs.");
  AddDetail(("pfad"),
      "Der Pfad fuehrt mitten durch bunte Felder voller reifer Fruechte in den "
      "dichten Dschungel hinein.");
  AddDetail(("himmel"),
      "Der Himmel ist strahlendblau, keine Wolke ist in Sicht.");
  AddDetail(({"sicht","wolke"}),
      "Oh, da ist ja doch eine ganz kleine Wolke...");
  AddDetail(("boden"),
      "Der Boden ist hier noch ziemlich ausgetrampelt und weist einige Spuren auf.");
  AddDetail(({"spuren","spur"}),
      "Die Spuren scheinen von Tieren, Personen und Fuhrwaegen zu stammen.");
  AddDetail(({"tiere","tier","tieren"}),
      "Im Moment scheint keines hier zu sein. Vielleicht Dein Glueck...");
  AddDetail(({"wagen","fuhrwagen","fuhrwaegen"}),
      "Tiefe Rillen haben die schwer beladenen Fuhrwaegen in den weichen Boden gefressen.");
  AddDetail(({"rille","rillen"}),
      "Als Du Dir die Rillen genauer betrachtest und Dich dabei bueckst, schmerzt "
      "Dein Kreuz wieder einmal. Tja, Du wirst alt...");
  AddDetail(({"person","personen"}),
      "Hier kommen viele Abenteurer vorbei...");
  AddDetail(("abenteurer"),
      "Ruhelose Gesellen, die in der Ferne ihr Glueck versuchen wollen...");
  AddDetail(({"ferne","glueck"}),
      "Wozu in die Ferne schweifen, liegt das Gute doch so nah..."); 
  AddDetail(({"geselle","gesellen"}),
      "Lustige Gesellen auf Wanderschaft haben oft Durst...");
  AddDetail(("durst"),
      "Wie waers mit einem kuehlen Bier in der Hafenkneipe von Tijara ?");
  AddDetail(("bier"),
      "Das Wasser laeuft Dir im Munde zusammen...");
  AddDetail(({"kneipe","hafenkneipe"}),
      "Sie liegt noerdlich von hier direkt am Hafen...");
  AddDetail(("hafen"),
      "Der Hafen liegt auch im Norden...");
  AddDetail(({"sueden","dschungel"}),
      "Der Dschungel breitet sich in all seiner Pracht im Sueden vor Dir aus."); 
  AddDetail(("obst"),
      "Was hier alles angebaut wird, kannst Du von hier nicht erkennen.");
  AddDetail(({"obstplantagen","plantagen"}),
      "Herrlich bunt liegen sie zu beiden Seiten des Pfades.");
  AddDetail(({"feld","felder"}),
      "So weit Dein Auge reicht, nichts als Felder voller suesser Fruechte.");
  AddDetail(("fruechte"),
      "Dir laeuft bei dem Gedanken das Wasser im Mund zusammen.");
  AddReadDetail(("tafel"),

      "+--------------------+\n"
      "|                    |\n"  
      "|      TIJARA        |\n"       
      "|                    |\n" 
      "|     Haupstadt      |\n"
      "|        des         |\n"
      "|   Gouvernements    |\n"
      "|     Dschungel      |\n"
      "|                    |\n"
      "+--------------------+\n");
  AddDetail(("tafel"),
      "Auf der Tafel steht irgendetwas. Du kannst sie lesen.");
  AddDetail(("figur"),
      "Hoch ueber Dir kannst Du einen steinernen Kopf erkennen, der Dir doch "
      "irgendwie bekannt vor kommt. Hmm, wer koennte das wohl sein...");
  AddDetail(("kopf"),
      "Du erkennst ploetzlich, dass der Kopf kein anderer als der von Dante sein "
      "kann, der Dir freundlich laechelnd zuzwinkert. Was macht der nur da oben?");         

  SetProp(P_LIGHT, 1);

  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_JUNGLE]) );

  AddSound( DEFAULT_SOUND,
      "Du kannst bereits das rege Treiben aus Tijara hoeren.");

  AddSmell( DEFAULT_SMELL,
      "Die Luft riecht nach Tieren, Pflanzen, eben nach dem Dschungel.");
  AddItem(NPC"bettler", REFRESH_DESTRUCT);

  AddItem("/d/dschungel/dante/weg/npc/nein", REFRESH_DESTRUCT);

  AddItem("/d/dschungel/dante/weg/npc/rmoskito", REFRESH_DESTRUCT);

  AddItem("d/dschungel/dante/news/obj/rep1", REFRESH_DESTRUCT);

  //AddItem("/players/dante/ghost", REFRESH_DESTRUCT);

  AddCmd(({"ziehe","zieh"}), "godown");


  AddCmd(({"steig","steige"}), "kaefig");
  AddExit( "norden", WEG_TIJARA); 
  AddExit( "sueden", "./wegp1");


}


show_sieger()  {
  write(
      "Das sind die Helden, die die Mutprobe bestanden haben:\n\n");

  TP->More(read_file("/d/dschungel/dante/weg/log/probeja"));
  return "";  
}


show_tote()  {
  write(
      "Das sind die Ungluecklichen die ihr Leben bei der Mutprobe verloren:\n\n");

  TP->More(read_file("/d/dschungel/dante/weg/log/wkillt"));
  return "";  
}


show_aufgabe()  {
  write(
      "Das sind die feigen Hunde, die jaemmerlich aufgaben!\n\n");

  TP->More(read_file("/d/dschungel/dante/weg/log/aufgabe"));
  return "";  
}



show_verlierer()  {
  write(
      "Das ist die Masse der Versager und Schwaechlinge:\n\n");

  TP->More(read_file("/d/dschungel/dante/weg/log/probenix"));
  return "";  
}


int kaefig(string str)   {
  notify_fail("Wo willst Du reinsteigen! <steige in kaefig>?!\n");

  if(str=="in kaefig"||str=="in kaefig rein"||str=="in kaefig hinein")  {
    if(TP->QueryQuest(QUESTKEY))  {
      write(
          "Du ueberwindest den Ekel, oeffnest die Tuere und steigst in den Kaefig!\n");
      TP->move("d/dschungel/dante/weg/room/kaefig", M_GO, "zum Sabbergnom in den Kaefig hinein",
          "steigt", "kommt in den Kaefig gestiegen");
      return 1; 
    }
    else  {
      write("Du kannst noch nicht in den Kaefig steigen!\n");
      say(CAP_TPN+" ruettelt wie bloed am Kaefig. \n");
      return 1; 
    }
    return 0; 
  }
  return 0; 
}


int godown(string str)
{
  notify_fail("Was willst Du bewegen?\n");
  if (!str) return 0;
  if (str=="knochen")
  {
    write("Du ziehst am Knochen, doch das ist nur ein Teil vom Ganzen. \n"
        "Zieh ihn mal aus der Mauer...\n");
    return 1;
  }

  if (str=="knochen aus mauer"||str=="knochen aus der mauer"||
      str=="knochen aus stadtmauer")
  {
    write("Du machst Dich am Knochen zu schaffen, ploetzlich schwenkt "
        "einer der grossen Steinbloecke hervor, haelt kurz inne, und "
        "reisst Dich dann beim Zurueckschwenken mit.\n");
    TP->move("/d/dschungel/dante/weg/room/itemroom.lpc", M_TPORT+M_SILENT );
    return 1;
  }
  return 0;
}

