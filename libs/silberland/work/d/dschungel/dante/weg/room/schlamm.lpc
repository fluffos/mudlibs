// a, felsen 2  by dante 97
//dante schlamm

#include "files.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Bei einem grossen Schlammloch" );
  SetProp( P_INT_LONG, BS(
        "Du folgst dem kleinen, schlammigen Pfad und gelangst mitten ins wildeste Dickicht."
        " Rings um Dich undurchdringbarer Dschungel, nur ein gewaltiges Schlammloch erregt "
        "Deine Aufmerksamkeit. Es blubbert und blubbert, und manchmal glaubst Du Stimmen "
        "aus der Tiefe des Schlamms zu hoeren."));
  AddDetail("himmel",
      "Der Himmel ist blau. Nur eine kleine Wolke ist zusehen.");
  AddDetail("wolke",
      "Die Wolke schwebt hoch ueber Dir dahin. Sie wirft einen kleinen Schatten "
      "auf den Boden.");
  AddDetail("boden",
      "Der Boden besteht aus Schlamm.");
  AddDetail("pfad",
      "Der Pfad fuehrt zurueck.");
  AddDetail("schatten",
      "Der Schatten sieht irgendwie einer Maus aehnlich.");
  AddDetail("maus",
      "Hmm, der Kopf der Maus ist interessant.");
  AddDetail("kopf",
      "Er sieht nur sehr wage dem Kopf einer echten Maus gleich. Die Augen sehen "
      "aber irgendwie doch real aus.");
  AddDetail(({"auge","augen"}),
      "Die Augen weisen nach Norden.");
  AddDetail("norden",
      "Im Norden ist der Dschungel undurchdringbar. Aber da haengt ein sehr interessanter "
      "Ast.");
  AddDetail("ast",
      "Der Ast sieht irgendwie einer Zange aehnlich. Man kann ihn einfach abbrechen!!!");
  AddDetail("zange",
      "Den Ast kann man sicher verwenden.");

  AddDetail(({"stimme","stimmen"}),
      "Du wirst Dich wohl taeuschen...");
  AddDetail(({"aufmerksamkeit"}),
      "In Deiner Aufmerksamkeit ist Dir entgangen, dass Dir jemand Deine Muenzen geklaut hat!");
  AddDetail(({"loch","schlammloch"}),
      "Das grosse Schlammloch blubbert und blubbert und verstroemt einen furchtbaren "
      "Gestank. Viele Fliegen schwaermen um das Loch und ab und zu fliegt ein Batzen "
      "Schlamm heraus.");
  AddDetail(("gestank"),
      "Gestank kann man meistens nicht sehen.");
  AddDetail(("batzen"),
      "Schon wieder wird ein Batzen Schlamm herausgeschleudert.");
  AddDetail(("schlamm"),
      "Grauer, dickfluessiger, stinkender Schlamm.");
  AddDetail(({"fliege","fliegen"}),
      "Die Fliegen kreisen um das Loch und nun auch schon um Dich.");
  AddDetail(("dickicht"),
      "Da die Straeucher, Baeume und Farne hier so dicht wachsen, kannst Du nur "
      "wenige Meter in den Dschungel sehen.");
  AddDetail(({"pflanzen","pflanze"}),
      "Du erkennst Baeume, Farne, Straeucher,...");
  AddDetail(({"farn","farne"}),
      "Die Farne hier erreichen fast die Hoehe eines ausgewachsenen Zwergs.");
  AddDetail(("hoehe"),
      "Die Farne sind hier wirklich besonders hoch.");
  AddDetail(({"strauch","straeucher"}),
      "Die Straeucher kitzeln Dich ein wenig an der Nase.");
  AddDetail(("nase"),
      "Deine Nase hat Dich eigentlich schon immer gestoert!");
  AddDetail(({"zwerge","zwergs","zwerg"}),
      "Die Zwerge wohnen im Norden in einer von Dusty erschaffenen Stadt.");

  AddDetail(("dusty"),
      "Eine Goettin des Silberland...");
  AddDetail(("silberland"),
      "Du befindest Dich mitten darin...");
  AddDetail(({"baum","baeume"}),
      "Hier wachsen vor allem Bobabas, die fuer ihre spitzen Stacheln bekannt sind.");
  AddDetail(({"bobabas","bobaba"}),
      "Der Bobaba ist eine kleine Gummibaumart, die nur suedlich der Stadt Tijara vorkommt.");
  AddDetail(({"gummibaum","gummibaumart","art"}),
      "Aus ihnen stellen fleissige Bauern Kaugummi her.");
  AddDetail(({"bauer","bauern"}),
      "Sie bewirtschaften grosse Bobabaplantagen.");
  AddDetail(({"plantagen","Bobabaplantagen","plantage"}),
      "Hier wachsen die Bobabas besonders gut. Muss wohl mit dem Schlamm zu tun haben.");
  AddDetail(("kaugummi"),
      "Einen Kaugummi haettest Du sehr gerne im Moment.");
  AddDetail(({"stadt","tijara"}),
      "Tijara ist die groesste Stadt des Gouvernements Dschungel.");
  AddDetail(("gouvernements"),
      "Der Gouverneur der Stadt Tijara leitet das Gouvernement Dschungel.");
  AddDetail(({"stachel","stacheln"}),
      "Pass bloss auf, dass Du ihnen nicht zu nahe kommst!");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25,ENV_TERRAIN:TT_SWAMP]) );

  AddDetail(({"sonne","licht"}),
      "Die Sonne strahlt hier unbarmherzig herab, wird jedoch durch den leichten\n"
      "Wind ertraeglicher gemacht.\n");
  AddDetail(("wind"),                                                            
      "Der Wind macht dem Gestank etwas ertraeglicher.\n");
  AddDetail(("dschungel"),
      "Du siehst den Dschungel vor lauter Pflanzen nicht.\n");
  AddDetail(("vegetation"),
      "Die Vegetation ist hier ueppig und dicht.\n");
  AddDetail(({"blatt","blaetter"}),
      "Sogar die Blaetter sind hier schlammverschmiert.\n");

  AddSound( ({DEFAULT_SOUND, "blubb"}),
      "BLUBB....BLUBB....BLUBB....");

  AddSmell( ({DEFAULT_SMELL, "loch", "gestank"}),
      "Hier stinkt es gewaltig.");


  AddItem(NPC"dschlamm", REFRESH_DESTRUCT);
  AddItem(NPC"dschlamm", REFRESH_DESTRUCT);
  AddCmd(({"brich","breche","reiss","reisse"}), "get");
  AddExit( "osten", "./weg4");
  AddExit("suedwesten", "./fip");

}


int get(string str) {
  object ast;
  notify_fail("Was willst Du hier abbrechen?\n");
  if(str=="ast ab"||str=="ast aus")  {
    if(!present("\nfippsiobj", TP))   {
      write("Du zerrst am Ast, schaffst es aber nicht!\n");
      return 1; 
    }
    if(deep_present("FIPPSI_ZANGE", TP))  {
      write("Aber Du hast doch schon einen Ast!\n");  return 1; 
    }
    else  {
      write("Du brichst den zangenaehnlichen Ast ab!\n");
      say(CAP_TPN+" fummelt an einem Strauch herum.\n");
      ast=clone_object("/d/dschungel/dante/weg/obj/fippsiast");
      ast->move(TP, M_NOCHECK);
      return 1;  
    }
    return 0; 
  }
  return 0; 
}

