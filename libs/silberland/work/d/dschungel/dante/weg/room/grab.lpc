// suedlcih von tijara

#include "files.h"

inherit "std/room";
#include <moving.h>
#include <properties.h>
#include <language.h>

int skelett_num;
#define MAX_SKELETTE 3

create()
{
  ::create();

  skelett_num=0;

  SetProp( P_INT_SHORT, "In einer Grube" );
  SetProp( P_INT_LONG, BS(
        "Du steckst mitten in einer tiefen Grube die scheinbar voellig leer ist. "
        "Die Waende weisen kaum Besonderheiten auf, der Boden ist sandig und weich. "
        "Dir kommt der Gedanke, dass es vielleicht voellig sinnlos war, hier herunter "
        "zu springen, denn vielleicht kommst Du hier gar nicht mehr hinaus..."));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_JUNGLE]) );
  AddDetail( ({"himmel"}),
      "Der Himmel ist weit ueber Dir.");
  AddDetail(("gedanke"),
      "Du haettest Dir wohl frueher ueberlegen sollen was Du machst...");
  AddDetail(("grube"),
      "Die Grube ist nicht sehr gross, aber dafuer umso tiefer...");
  AddDetail(("boden"),
      "Der Boden besteht aus Sand und Lehm.");
  AddDetail(("sand"),
      "Vereinzelt sieht man Gras und Moos am Boden.");
  AddDetail(("gras"),
      "Das Gras ist gruen und saftig.");
  AddDetail(("moos"),
      "Das Moos wirkt irgendwie krank...");
  AddDetail(("lehm"),
      "Der Lehm ist hart und man sieht Abdruecke ihn ihm.");
  AddDetail(({"abdruck","abdruecke"}),
      "Die Abdruecke stammen von knochigen Beinen, seltsam...");
  AddDetail(({"beine","beinen"}),
      "Hmm, sieht aus wie der Abdruck eines Skeletts...");
  AddDetail(("skelett"),
      "Tja, woher soll das hier kommen ?");
  AddDetail(("dschungel"),
      "Der Dschungel ist etwas ober Dir. Du kannst kaum etwas erkennen."); 
  AddDetail(({"fels","felsblock","block"}),
      "Der gigantische Stein ist von hier kaum mehr zu sehn.");
  AddDetail(({"besonderheit","besonderheiten"}),
      "Wie schon gesagt, viel gibt es hier nicht. Dir fallen einige Loecher, "
      "Nischen, Kratzer und Spuren auf, aber sonst nichts...");
  AddDetail(({"loecher","loch"}),
      "In einem der Loecher erkennst Du einen auffaelligen Stein...");
  AddDetail(("stein"),
      "Auf dem Stein steht: Made by Dante(97)!");
  AddDetail(({"nische","nischen"}),
      "In einer der Nischen erkennst Du einen Schriftzug...");
  AddDetail(({"schrift","schriftzug"}),
      "Du kannst ihn probieren ihn zu lesen...");
  AddReadDetail(({"schrift","schriftzug"}),
      "Wo ist der Herr des Dschungels, wenn man ihn braucht...");
  AddDetail(("kratzer"),
      "Du kratzt Dich am Kopf...");
  AddDetail(({"spuren","spur"}),
      "Tja, welche Spur fuehrt hier wohl hinaus...");
  AddDetail(({"rinnsale","rinnsal","bach","baeche"}),
      "Die Rinnsale und Baeche kannst Du nur mehr hoeren.");

  AddDetail(("pfad"),
      "Der Pfad liegt ober Dir...");
  AddDetail(("tal"),
      "Das Tal liegt im Sueden, aber von hier ist natuerlich nichts zu erkennen.");
  AddSound( DEFAULT_SOUND,
      "Du hoerst, das der Dschungel voller Leben sein muss. ");

  AddSmell( DEFAULT_SMELL,
      "Du kannst exotische Pflanzen, Tiere und Deinen eigenen Schweiss riechen.");
  AddDetail(({"wand","waende"}),
      "Die Waende sind steil und hoch und bestehen aus glattem Lehm. Ab und zu "
      "sieht man einige kleine Kaefer und Pflanzen...");
  AddDetail(("kaefer"),
      "Die Kaefer krabbeln umher und suchen Nahrung.");
  AddDetail(("nahrung"),
      "Was essen Kaefer denn ueberhaupt so...");
  AddDetail(({"pflanze","pflanzen"}),
      "Einige Efeuarten gedeihen hier...");
  AddDetail(("efeu"),
      "Efeu gibt es in vielen Arten...");
  AddDetail(({"art","arten", "efeuarten", "efeuart"}),
      "Eine Art heisst zum Beispiel Rufsokommich, eine andere Drueckknopf...");
  AddDetail(("rufsokommich"),
      "Ein seltsamer Name...");
  AddDetail(("name"),
      "Hmm, wen oder was sollst Du denn rufen ? Welcher Dschungelheld wird Dir denn "
      "da wohl helfen koennen.");
  AddDetail( ({"held", "dschungelheld"}),
      "Du kennst doch sicher den bekannten Dschungelheld mit seinem beruehmten "
      "Schrei.");
  AddDetail(("druecknopf"),
      "Eine verwirrende Bezeichnung...");
  AddDetail(("bezeichung"),
      "Was soll das wohl bedeuten...");
  AddDetail(("knopf"),
      "He, da ist ja wirklich ein Knopf..."); 
  AddDetail( "tarzan",
      "Tarzan hilft Dir sicher, wenn Du nach ihm rufst.");

  AddItem(NPC"dieb", REFRESH_DESTRUCT);

  AddCmd(({"drueck","druecke"}), "skel");  
  AddCmd(({"ruf","rufe"}), "up");
}

int up(string str)
{
  notify_fail("Was willst Du hier rufen?\n");
  if ( !str) return 0;

  if (member( ({"tarzan"}),str) !=-1 )
  {
    write(BS(
          "Von Weitem hoerst Du schon den weltbekannten Schrei von Tarzan und kurz "
          "danach grinst er Dich auch schon von oben herab an. "
          "Er packt Dich mit seiner kraeftigen Hand am Schopf, zieht Dich aus der "
          "Grube und ist im naechsten Moment wieder im Dickicht des Dschungels "
          "verschwunden..."));
    TP->move("/d/dschungel/dante/weg/room/weg4", M_GO,
        "von Tarzan, dem Herrn des Dschungels nach oben gezogen", "wird",
        "kommt mit Hilfe von Tarzan, dem Herrn des Dschungels aus einer tiefen Grube herauf");
    return 1;
  }
  if (member( ({"magier","eros","angrox","trogor","lamuerte", "wuschel", 
          "dante","feyaria","woody","dusty","creative","sargola"}),str) !=-1 )
  {
    write("Ein Magier kann Dir hier nicht helfen!\n");
  }
  else
    write("Nein, so einfach ist das hier nicht...\n");
  return 1;
}


int skel(string str)
{
  notify_fail("Was willst Du hier druecken?\n");
  if ( !str) return 0;

  if (member( ({"knopf" ,"auf knopf"}),str) !=-1 )
  {
    object ob;
    write(" \n"
        "Du drueckst den Knopf und...\n");
    say(CAP_TPN+" drueckt auf einen Knopf und...\n");
    if(present("skelett") || skelett_num > MAX_SKELETTE )
      tell_room(TO, "....nichts passiert.\n");
    else
    {
      ob = clone_object("/d/dschungel/dante/hoehle/npc/dskelett.lpc");
      ob->move(environment(TP), M_TPORT);
      skelett_num++;
    }
    return 1;
  }
  return 0;
}

void reset()
{
  ::reset();
  skelett_num=0;
}
