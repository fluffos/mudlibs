// suedlich von tijara

#include "files.h"

inherit "std/room";
#include <moving.h>
#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Auf dem Dschungelpfad" );
  SetProp( P_INT_LONG, BS(
        "Der Dschungelpfad fuehrt weiter bergab in ein enges Tal. Der gigantische \n"
        "Felsblock neben Dir scheint immer maechtiger zu werden und die Rinnsale \n"
        "wachsen sich zu kleinen Baechen aus. Von hier aus hast Du schon einen\n"
        "guten Ausblick ueber die Schlucht. Der Dschungel abseits des Pfades wird\n"
        "immer wilder und undurchdringbarer.\n"));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_JUNGLE]) );

  AddDetail(({"dschungel", "vegetation", "pflanzen"}),
      "Wild wuchert hier die Vegetation. An ein Verlassen des Pfades ist hier " 
      "nicht zu denken...");                                      
  AddDetail(({"fels","felsblock","block", "stein", "felsen", "felswand"}),
      "Der gigantische Stein wird hoeher und hoeher, fast koennte man schon von "
      "einer Felswand sprechen.");
  AddDetail(({"rinnsale","rinnsal","bach","baeche"}),
      "Das Wasser stroemt von oben in die Tiefe und vereinigt sich zu immer "
      "groesseren Baechen.");
  AddDetail(("pfad"),
      "Der Pfad schlaengelt sich vorbei an dem Felsen immer tiefer hinab in "
      "das Tal. Nach Westen fuehrt eine kleine, schlammige Abzweigung.");
  AddDetail(("westen"),
      "Nach Westen kann man einen kleinen Pfad entlang gehen.");
  AddDetail(("abzweigung"),
      "Die Abzweigung fuehrt nach Westen.");
  AddDetail(("tal"),
      "Vor Dir erstreckt sich ein enges Tal, das jaeh von einer tiefen Schlucht "
      "zerschnitten wird.");
  AddDetail(("schlucht"),
      "Ein tiefer Graben zerschneidet das Tal und scheint ein unueberwindbares "
      "Hindernis darzustellen.");  

  AddDetail(("graben"),
      "Tief und breit erstreckt er sich vor Dir.");
  AddDetail(("hindernis"),
      "Wie kommt man da wohl drueber?");
  AddDetail(("boden"),
      "Der Boden ist hier sehr weich und feucht vom vielen Wasser.");
  AddDetail(("wasser"),
      "Es gluckst und plaetschert dahin...");
  AddDetail(("himmel"),
      "Der Himmel ist ganz klar und man kann sogar den Mond erkennen.");
  AddDetail(("mond"),
      "Selten aber doch kann man Mond und Sonne gleichzeitig sehen.");
  AddDetail(("sonne"),
      "Die Sonne ist der Mittelpunkt unseres Planetensystems...");
  AddDetail(({"mittelpunkt", "mitte","punkt"}),
      "Oder dreht sich doch die Erde um die Sonne...");
  AddDetail(("erde"),
      "Als Du so ueber die Erde nachdenkst faellt Dir eine Grube etwas abseits des Weges in der Erde auf, "
      "in die man sicher runter kann...");
  AddDetail(({"system","planeten","planetensytem"}),
      "Bin ich Steven Hawking...???");
  AddDetail(("grube"),
      "Die Grube ist tief, aber nicht zu tief...");
  AddSound( DEFAULT_SOUND,
      "Du hoerst, das der Dschungel voller Leben sein muss. ");

  AddSmell( ({DEFAULT_SMELL, "pflanzen", "tiere", "schweiss"}),
      "Du kannst exotische Pflanzen, Tiere und Deinen eigenen Schweiss riechen.");


  AddExit( "westen", "./schlamm");
  AddExit( "nordosten", "./weg3");
  AddExit( "sueden", "./weg5");

  AddCmd(({"spring","springe"}), "down");

  AddItem( ({NPC"dfrosch2", NPC"dfrosch1"}) , REFRESH_DESTRUCT);

  AddItem( ({NPC"dschimp", NPC"dpavian"}), REFRESH_DESTRUCT);
}

int down(string str)
{
  notify_fail("Wohin willst Du springen ?\n");
  if ( !str) return 0;

  if (member( ({"in grube","in grube hinein"}),str) !=-1 )
  {
    write(" \n"
        "Du springst in die tiefe Grube hinein.\n");
    TP->move("/d/dschungel/dante/weg/room/grab", M_GO,
        "in eine tiefe Grube", "springt",
        "kommt von oben herab gesprungen");
    return 1;
  }
  return 0;
}
