// brunnen 4 dante

#include "files.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
create()
{
  ::create();

  SetProp( P_INT_SHORT, "In Schlamm" );
  SetProp( P_INT_LONG, BS(
    "Du steckst voellig im stinkendem Schlamm fest. Ueberall nur Schlamm...\n"));
AddDetail(("boden"),
"Der Boden ist...schlammig, richtig!");

AddDetail(("decke"),
"An der Decke haengt ein langer Faden.");
AddDetail(("faden"),
"Der Faden baumelt im Wind ? Wind, woher soll hier Wind kommen ?");
AddDetail(("wind"),
"Der Wind pfeifft aus einem kleinen Loch an der Nordwand...");
AddDetail(("nordwand"),
"An der Nordwand erkennt man ein kleines Loch.");
AddDetail(("loch"),
"Aus dem Loch pfeifft ein kuehler Wind in Richtung vornehinten???");
AddDetail(("richtung"),
"Tja, die Richtung ist vornehinten...");
AddDetail(({"wand","waende"}),
"Als Du die Waende naeher betrachtest, faellt Dir etwas auf...");
AddDetail(("etwas"),
"Du scheinst Dich getaeuscht zu haben...");
    
    
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20,ENV_TERRAIN:TT_CAVE]) );

  
  AddDetail(("schlamm"),
  "Vorne Schlamm, hinten Schlamm, ober Dir Schlamm, unter Dir Schlamm,...");
 
  AddSound( DEFAULT_SOUND,
    "Der Schlamm schweigt.");
    
  AddSmell( DEFAULT_SMELL,
    "Hmm, hier stinkt es gewaltig...");

  AddRoomMessage( 
    ({"Du geraetst in Panik...\n",
      "Angst ergreift Besitz von Dir...\n",
      "Ach, waerst Du doch nicht in den Brunnen gesprungen.\n",
      "Du denkst . o O 'BLUBB BLUBB BLUBB'\n",
      "Der Schlamm erdrueckt Dich fast.\n",
      "BLUBB....BLUBB....BLUBB....\n",
      "Der Schlamm blubbert und blubbert.\n",
      "Eine beschissene Situation...\n"}) );
      
 AddItem(NPC"dschlamm", REFRESH_DESTRUCT );
 
 SetProp(P_HIDE_EXITS, ({"vornehinten"} ));
 AddExit("vornehinten", "nach BLUBB#./ziel");
  SetProp(P_HIDE_EXITS, ({"vornehinten"} ));
 }
 
 
 
 
