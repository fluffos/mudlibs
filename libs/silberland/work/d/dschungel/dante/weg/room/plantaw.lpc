/*
** plantage mit passionsfrucht
** dante 97 feb 
** 
*/

inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>

#include "files.h"


int wurm;

create()
{  
  ::create();
  
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:30, ENV_TERRAIN:TT_JUNGLE]));
  SetProp (P_INT_LONG, BS(
  "Hier scheint die Plantage nicht gepflegt zu werden. Rings um Dich siehst "
  "Du vertrocknete, alte Straeucher, die sicherlich nie mehr Fruechte tragen "
  "werden. Nur im Osten kann man wieder zurueck auf den bearbeiteten Teil "
  "der Plantagen."));
  SetProp (P_INT_SHORT, "Auf der Obstplantage");
   
   
  wurm=random(7)+4;
   
   AddDetail(({"frucht","fruechte"}),
   "Hier wachsen sicherlich keine!");
   AddDetail(({"wand","waende"}),
   "Waende gibts es hier keine, nur Straeucher.");
   AddDetail("teil",
   "Du befindest Dich im westlichsten Teil der Plantage.");
   AddDetail("osten",
   "Im Osten liegt der bewirtschaftete teil der Plantage.");
   AddDetail("himmel",
   "Der Himmel ist strahlend blau. Diese Farbe gefaellt Dir gut!");
   AddDetail("farbe",
   "Die Farbe ist ein helles Blau.");
   AddDetail("blau",
   "Als Du das letze Mal so richtig blau warst, bist Du ueber eine Wurzel gestolpert "
   "und hast sie danach ausgerissen, oder war das Dante...");
   AddDetail(({"dante","mal"}),
   "Voellig unwichtig...");
   AddDetail("boden",
   "Der Boden ist hart und ausgetrocknet. Manchmal scheint irgendetwas kurz "
   "auf zu blitzen.");
   AddDetail(({"etwas","irgendetwas"}),
   "Hmm, was koennte das sein.");
   
   AddDetail(({"plantage", "plantagen", "obstplantagen","obstplantage"}),
   "Dieser Teil der Plantagen ist verkommen und ausgetrocknet.");
   AddDetail(({"strauch","straeucher"}),
   "Die Straeucher sind alt und ungepflegt. Ihre Wurzeln liegen teilweise schon "
   "im Freien.");
   AddDetail(({"freien"}),
   "Da stehst Du auch!");
   AddDetail(({"wurzel","wurzeln"}),
   "Die Wurzeln der Straeucher sind alt und vertrocknet. Eine der Wurzeln weisst "
   "einen kleinen Riss auf.");
   AddDetail("riss",
   "Nein, es ist kein Riss, sondern eine Spur.");
   AddDetail("spur",
   "Die Spur scheint von einem winzigem Tier zu stammen.");
   AddDetail("tier",
   "Dieses Tier scheint unter der Wurzel zu leben. Wie kommt man da wohl hin? "
   "Wie koennte man das Tier unter der Wurzel rauskriegen?");
   
   
  AddSmell(DEFAULT_SMELL,
      "Hier riecht es nach Wuermern...\n");

  AddSound( DEFAULT_SOUND,
      "Stille, Ruhe, Frieden.\n");

  AddExit( "osten", "./planta12");
  AddExit( "nordwesten", "./planfire");
   
   AddCmd(({"reisse", "reiss"}), "out");  

 AddItem(NPC"pasmon", REFRESH_DESTRUCT); 
}

   out(string str)
    {
    object wu;
    notify_fail("Was willst Du hier ausreissen?\n");
    if (!str) return 0;
    
         if (member(({"wurzel aus", "wurzel heraus"}),str)!=-1)
              {
        if (!wurm)
                   {
        write("Du versuchst die Wurzel aus zu reissen, gibts aber "
        "bald auf. Hier scheint sich nichts mehr zu tun!\n");
        say(""+TPN+" macht sich an den Straeuchern zu schaffen.");
        return 1;
                   }
       
      if (wurm)
         {
         switch(random(10))
              {
              case 0 .. 4 :
              write("Du ziehst an der Wurzel, ein kleiner Lichtwurm lugt hervor, "
              "verschwindet aber wieder blitzschnell unter der Wurzel!!!\n");
            say(""+TPN+" macht sich an den Straeuchern zu schaffen und erschrickt "
            "ploetzlich sehr!\n");
             break;
                
      case 5 .. 9:
            
            write("Du ziehst an der Wurzel und erschrickst ploetzlich!\n");
            say(""+TPN+" macht sich an den Straeuchern zu schaffen und erschrickt "
            "ploetzlich sehr!\n");
             wurm--;
             wu=clone_object("/d/dschungel/dante/weg/npc/lw.lpc");
             wu->move(environment(TP), M_TPORT);
             break;
             
        default: write("BUG!\n");
                   }
           return 1;
             
               }
       return 1;
      }      
     return 0;
     }
     
  void reset()
    {
    ::reset();
   wurm=random(7)+4;
    }

