// hoehle 3

#include "files.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
int lap;
create()
{
  ::create();
  lap = 1;
  SetProp( P_INT_SHORT, "Am Brunnengrund" );
  SetProp( P_INT_LONG, BS(
        "Du stehst nun am Grund des Brunnens und stellst mit Erstaunen fest, dass "
        "hier ausser Schlamm und einer stinkenden Bruehe, ueberhaupt kein Wasser "
        "zu finden ist. Hoch ueber Dir siehst Du die Oeffnung, durch die Du so "
        "leichtsinnig gesprungen bist. Die Waende sind voller Schimmel und Moder "
        "und der Geruch ist auch nicht sehr angenehm."));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 15,ENV_TERRAIN:TT_CAVE]) );
  AddDetail(("bruehe"),
      "Du stehst knietief in faulem, brackigem Wasser, und scheinst immer tiefer "
      "und tiefer zu sinken.");
  AddDetail(("schlamm"),
      "Der Schlamm ist zaeh und braun und wirft manchmal kleine Blaeschen auf. "
      "Vielleicht solltest Du ihn mal naeher untersuchen ?");
  AddDetail(("wasser"),
      "Das wenige Wasser das Du hier unten siehst ist faul. Woher bekommen die "
      "Plantagenarbeiter denn nun Wasser fuer die Fruechte?");
  AddDetail( ({"decke"}),
      "Es gibt hier keine Decke, Du bist ja in einem Brunnen.");
  AddDetail(({"grund", "boden"}),
      "Der Grund des Brunnens ist sehr weich. Das hat auch Deinen Aufprall etwas " 
      "abgebremst..."); 
  AddDetail(({"blasen","blaeschen"}),
      "Die Blaeschen blubbern und blubbern...");
  AddDetail(("aufprall"),
      "Durch Deinen Aufprall hast Du einen ziemlichen Krater in den Schlamm "
      "geschlagen. Du solltest etwas abnehmen.");
  AddDetail(("krater"),
      "Seltsam der Krater zeigt in eine Richtung...");
  AddDetail(("richtung"),
      "Als Du die Richtung des Kraters naeher betrachtest, faellt Dir auf, dass "
      "er ganz deutlich von Hinten nach Vorne verlaeuft. Oder umgekehrt? "
      "Schau besser noch einmal nach.");
  AddDetail( ("moder"),
      "Der Brunnen scheint hier unten langsam zu verrotten.");
  AddDetail(({"wand","waende"}),
      "Die Waende sind aeusserst glatt. Wie sollst Du hier jemals wieder raus kommen?");
  AddDetail(("schimmel"),
      "Der Schimmel ueberzieht schon fast die gesamte Flaeche der Waende.");
  AddDetail(("geruch"),
      "Es riecht so unangehehm, dass man es fast schon sehen kann...");
  AddDetail(("oeffnung"),
      "Die Oeffnung sehr weit oben...");

  AddSound( DEFAULT_SOUND,
      "Der Schlamm blubbert...");

  AddSmell( DEFAULT_SMELL,
      "IGITT!!!Hier riecht stinkt es nach faulem Wasser.");

  AddCmd(({"wuehle","wuehl"}),"wuehlen");

  SetProp(P_HIDE_EXITS, ({"hinten"}) );

  AddItem(NPC_HOEHLE"dfledermaus" , REFRESH_DESTRUCT ,([P_WIMPY: 0]));
  AddExit("hinten", "nach BLUBB#./brunnen3");
  SetProp(P_HIDE_EXITS, ({"hinten"}) );

} 

reset()
{
  lap=1;
  ::reset();
}


wuehlen ( str )
{
  notify_fail("Wo willst Du wuehlen ?\n");
  if(str != "in schlamm")

    return 0;

  if (!lap)
  {
    write(" \n"
        "Du wuehlst einige Zeit im Schlamm, gibst aber bald wieder auf.\n");
    say(""+TPN+" wuehlt grunzend wie ein Ferkel im Schlamm.\n");

    return 1;
  }
  {
    object ob;

    if (str== "in schlamm")
      write(" \n"
          "Du wuehlst im Schlamm und findest einen funkelden Gegenstand, denn Du sofort einsteckst.\n");
    say(""+TPN+" wuehlt einige Zeit im Schlamm und grinst Dich dann erfreut an.\n");
    CLONE("/obj/gems/amethyst", TP);

    ob = clone_object("/d/dschungel/dante/weg/npc/dschlamm2");
    ob->move(environment(TP), M_TPORT);

    lap--;
    return 1;
  }
  return 0;
}



