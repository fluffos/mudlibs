// suedlcih von tijara

#include "files.h"

inherit "std/room";
#include <moving.h>
#include <properties.h>
#include <language.h>
create()
{ 
  ::create();
  SetProp( P_INT_SHORT, "Auf dem Dschungelpfad" );
  SetProp( P_INT_LONG, BS(
        "Der Dschungelpfad wird hier wieder flacher und fuehrt eben auf eine lange "
        "Haengebruecke hin, die eine gewaltige Schlucht ueberspannt und die aeussere Grenze "
        "des bekannten Dschungels darstellt. Tief unter Dir rauscht ein grosser Fluss "
        "dahin. Der laut tosende Wasserfall ist von hier in seiner gesamten Pracht "
        "zu ueberblicken und die herabstuerzenden Wassermassen uebertoenen hier jedes "
        "andere Geraeusch."));

  AddDetail(("grenze"),
      "Hinter der Schlucht im Sueden beginnt unerforschtes Neuland.");
  AddDetail(("sueden"),
      "Im Sueden beginnt angeblich das Land der Kannibalen.");
  AddDetail(("holz"),
      "Das Holz schaut von hier noch sehr stabil aus.");
  AddDetail(("wind"),
      "Der Wind blaest hier schon recht stark.");
  AddDetail(("groesse"),
      "Du stehst einen Augenblick still und laesst diesen herrlichen Anblick auf Dich wirken.");

  AddDetail(({"wassermassen","wassermasse","masse","massen"}),
      "Ungeheure Massen von Wasser stuerzen den Wasserfall rauschend hinab.");
  AddDetail(({"geraeusch","geraeusche"}),
      "Geraeusche hoert man...");
  AddDetail(("anblick"),
      "Du bist ueberwaeltigt von der Groesse der Natur.");
  AddDetail(("natur"),
      "Achte und huete die Natur!!!");
  AddDetail(("pracht"),
      "Der laut tosende Wasserfall ist wirklich ein sehr erhebender Anblick.");
  AddDetail(("wasserfall"),
      "Der Wasserfall breitet sich von hier aus im Westen ueber die gesamte Breite "
      "der Schlucht aus.");
  AddDetail(({"breite"}),
      "Genau weisst Du nicht wie breit der Wasserfall ist, aber er ist sicherlich viele "
      "Elfen lang.");
  AddDetail(({"elf","elfen"}),
      "Elfen sind ja bekannt grosse Wesen.");
  AddDetail(({"rio","rio de la puseta","puseta"}),
      "Angeblich ist der Rio de la Puseta einer der groessten, wenn nicht der groesste "
      "Fluss dieser Welt.");
  AddDetail(("welt"),
      "Dies ist unser aller Welt.");
  AddDetail(("silberland"),
      "Du befindest Dich mitten darin.");
  AddDetail(({"bruecke","haengebruecke"}),
      "Die Haengebruecke besteht aus Holz und scheint sehr lang zu sein. "
      "Sie knarrt und schaukelt im Wind, dass Dir schon hier fast schwindlig wird. "
      "Ein grosser Affe scheint auf der Bruecke herumzuturnen.");
  AddDetail(({"affe", "gorilla"}),
      "Der Affe scheint ein Gorilla zu sein...");
  AddDetail(("wasser"),
      "Das Wasser ist smaragdgruen und funkelt in der Tiefe.");
  AddDetail(("himmel"),
      "Der Himmel ist strahlendblau, nur einige Wolken ziehen ueber Dich hinweg.");
  AddDetail(("sonne"),
      "Die Sonne lacht Dich vom Himmel herab an.");
  AddDetail(("ufer"),
      "Auf der anderen Seite der Schlucht beginnt unerforschtes Neuland.");
  AddDetail(("neuland"),
      "Angeblich sollen dort Kannibalen wohnen.");
  AddDetail(({"kannibalen","kannibale"}),
      "Sollst Du es wagen auf die andere Seite des Flusses zu gehen.");
  AddDetail(("westen"),
      "Im Westen liegt der grosse Wasserfall.");


  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_JUNGLE]) );

  AddDetail(("dschungel"),
      "Abseits des Pfades wachsen hier nur mehr vereinzelt Straeucher, Baeume, Farne, Blumen und Graeser, "
      "die Du alle noch nie zuvor gesehn hast."); 
  AddDetail(({"straeucher","strauch"}),
      "Die Straeucher werden hier seltener und kleiner.");
  AddDetail(({"farn","farne"}),
      "Die Farne nehmen an Groesse und Zahl ab. Ueberhaupt ist hier der Dschungel viel lichter als im Norden.");
  AddDetail(({"blume","blumen"}),
      "Die Blumen stehen nur mehr vereinzelt und durchnaesst umher.");
  AddDetail(({"wolken","wolke"}),
      "Die Wolken scheinen hier zum Greifen nahe.");

  AddDetail(({"gras","graeser"}),
      "Das Gras waechst hier ueppig und fett dahin...");

  AddDetail(({"baum","baeume"}),
      "Baeume gibt es hier kaum noch welche, und wenn dann sind sie klein.");
  AddDetail(("boden"),
      "Der Boden ist weich und saftig durch die feuchte Luft.");
  AddDetail(({"dschungelpfad","pfad","kurven","kurve"}),
      "Der Pfad fuehrt fast waagrecht auf die Haengebruecke zu. Ein kleiner "
      "Weg biegt Richtung Osten hin ab.");
  AddDetail(("weg"),
      "Der Weg biegt ostwaerts ab und scheint entlang der Schlucht nach Osten zu "
      "fuehren."); 
  AddDetail(({"schlucht", "schlund"}),
      "Die Schlucht liegt direkt vor Dir wie ein grosser geoeffneter Schlund.");
  AddDetail(("fluss"),
      "Dieser Fluss ist der Rio de la Puseta, der fuer sein smaragdgruenes Wasser bekannt ist.");
  AddDetail(("tiefe"),
      "Die Schlucht scheint sehr tief zu sein, also pass besser auf.");
  AddDetail(({"fels","wand","felswand"}),
      "Die Felswand liegt weiter im Norden. ");
  AddDetail(("osten"),
      "Richtung Osten fuehrt ein kleiner Weg entlang der Schlucht.");
  AddDetail(({"norden"}),
      "Im Norden wird der Dschungel wieder dichter.");





  AddSound( ({DEFAULT_SOUND, "tosen", "wasser"}),
      "Das Tosen des Wasser uebertoent hier fast alles.");

  AddSmell( DEFAULT_SMELL,
      "Die Luft ist hier schon sehr feucht...");

  AddExit( "oben", "./weg9");
  AddExit( "sueden", "./bruecke1");
  AddExit("osten", "./weg11");

  AddItem(NPC"fak", REFRESH_DESTRUCT);

  AddItem(({ NPC"dkoli", NPC "dmoskito", NPC"dztapir", NPC"dtiger"}),REFRESH_DESTRUCT);
}



void init()
{
  object ob;
  ::init();

  if(deep_present("\nimp", TP))  { return;  }
  if(deep_present("MALA", TP)) { return; }

  switch(random(100))
  {
    case 0 .. 97:
      break;

    case 98 .. 99:

      ob=clone_object("/d/dschungel/dante/weg/obj/dmala.lpc");
      ob->move(TP, M_NOCHECK);
  }
}
