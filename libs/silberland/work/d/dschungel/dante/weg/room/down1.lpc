// suedlcih von tijara


#include "/players/dante/myowndefine.h"

inherit "std/room";
#include <moving.h>
#include <properties.h>
#include <language.h>


create()
{ 
  ::create();
  SetProp( P_INT_SHORT, "An einer steilen Klippe" );
  SetProp( P_INT_LONG, BS(
        "Der Weg endet hier jaeh und abrupt an einer steilen Klippe! "
        "Noch ein Meter und Du faellst hinunter. Der Absturz wuerde Dich "
        "zwar nicht umbringen, aber Mut gehoert sicher dazu! Unter Dir "
        "rauscht der Fluss vorbei und am anderen Ufer sieht man ein Dorf!"));
  AD("absturz",
      "Der Absturz wuerde Dich nicht toeten. Viel interessanter als Dein Tod, "
      "ist aber das Dorf, das man am anderen Ufer erkennen kann!");
  AD("tod",
      "Der Tod wohnt im Dorf!");
  AD("dorf",
      "Wer wohl in dem Dorf wohnt. Es liegt nahe dem Fluss an einem seitlichen "
      "Arm. Angeblich hausen dort Kannibalen.");
  AD(({"kannibale","kannibalen"}),
      "Die Kannibalen erwarten Dich sicher schon!");
  AD("arm",
      "Flussarm. Er fuehrt irgendwo anders hin!");
  AD("decke",
      "Wo soll die hier sein?!");
  AD("himmel",
      "Der Himmel strahlt blau! Naja eigentlich die Sonne!");
  AD("sonne",
      "Die Sonne steht hoch am Himmel.");
  AD("mut",
      "Los spring!");
  AD("ufer",
      "An dem einen Ufer stehst Du, am anderen Ufer sieht man ein Dorf.");


  AD("weg",
      "Der Weg endet hier jaeh an der Klippe. Etwas weiter und Du stuerzt ab!");
  AD(({"klippe", "klippen"}), 
      "Die Klippen fallen hier sehr steil ab und enden dann im Fluss, der unter "
      "ihnen vorbeirauscht.");
  AD("boden",
      "Der Boden weist hier wenige Pflanzen auf. Er ist weiss und aus hartem "
      "Stein.");
  AD("stein",
      "Der Stein ist weiss und sehr hart. Hallo! Was siehst Du da! Ein Loch, gross genug um hinein zu kriechen!");
      
      AD("loch", "Geh einfach nach Norden und schon hast Du Dich durch das Loch gezwaengt.");
      
  AD(({"pflanzen", "pflanze"}),
      "Hier wachsen nur mehr wenige Pflanzen. Im Norden werden sie wieder dichter "
      "und mehr. Nach Nordoben fuehrt der Weg zurueck!");
  AD("nordoben",
      "Von dort kammst Du herunter.");
  AD("sueden",
      "Im Sueden liegt der Fluss, dahinter das Dorf.");

  AD("norden",
      "Im Norden wird der Dschungel dichter.");
  AD("fluss",
      "Der Fluss rauscht unter Dir vorbei! Romantisch! Noch schoener waere es allerdings, "
      "wenn man von hier runter ins Wasser springen wuerde!");
  AD("wasser",
      "Das Wasser leuchtet gruen und blau. Wie schoen waere es, wenn man da rein "
      "springen koennte!");


  AD("meter",
      "Von hier:                           bis hier!");


  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_JUNGLE]) );


  AddSound(DEFAULT_SOUND,
      "Der Wasserfall ist auch hier noch recht laut zu hoeren.");
  AddSmell(DEFAULT_SMELL,
      "Du riechst das frische, saubere Wasser des Rio de la Puseta.");

  AD("wasserfall",
      "Der Wasserfall donnert im Norden herab!");
  AD(({"rio", "puseta"}),
      "So heisst dieser Fluss!");

  AddExit("nordoben", "./weg13");
//AddExit("norden", "/d/seher/haus/marihella:00:00");
  AddItem( ({"/d/dschungel/dante/weg/npc/dschimp", 
        "/d/dschungel/dante/weg/npc/dpavian"})  , REFRESH_DESTRUCT);

  ASE("sueden", "nix");
  ASE("unten", "nix");
  ACD(({"spring","springe"}), "fluss_schwimm");
SetProp(P_HIDE_EXITS, ({"norden"}) );

}

nix()  {
  write("Nein. Du musst schon springen!\n");
  return 1; 
}


int fluss_schwimm(string str) {

  notify_fail("Wo moechtest Du rein springen?\n");
  if(!str) return 0;
  if(str!="in fluss" && str!="runter in fluss" &&str!="in fluss runter"&&
      str!="runter"&&str!="in wasser")

    return 0; 

  tell_room(ME, BS(sprintf("%s scheint verrueckt zu sein und "
          "springt in den Fluss hinunter und beginnt zu schwimmen! "
          "Kaum ist %s ein paar " 
          "Meter weit gekommen, wird %s auch schon von der Stroemung "
          "weggerissen. Tja, Pech gehabt. Willkommen im Dschungel.",
          TP->Name(), TP->QueryPronoun(WER), TP->QueryPronoun(WER))), 
      ({TP}));
  tell_object(TP, BS("Du nimmt allen Mut zusammen und springst in den Fluss. "
        "Gerade "
        "als es Dir so richtig gefaellt, kommt Dir der Gedanke, dass es nicht "
        "gerade schlau war, bei dieser starken Stroemung schwimmen zu gehen. "
        "Du willst gerade umkehren, als Dich schliesslich eine starke Stroemung "
        "erfasst und gegen einen Stein schleudert ... "));
  tell_object(TP, "\n\n\nSchwaerze ...\n\n\n");
  tell_object(TP, "Schliesslich kommst Du zu Dir ...\n");
  TP->move("d/dschungel/charon/kannibalendorf/room/room_r9:"+getuid(TP), 
      M_NOCHECK|M_SILENT);
  return 1;
}




