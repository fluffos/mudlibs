// brunnen 3 dante

#include "files.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
create()
{
  ::create();

  SetProp( P_INT_SHORT, "In Schlamm" );
  SetProp( P_INT_LONG, BS(
    "Du steckst voellig im stinkendem Schlamm fest. Ueberall nur Schlamm...\n"));
    AddDetail(("decke"),
    "Von der Decke tropft Schlamm.");
    AddDetail(({"wand","waende"}),
    "Die Waende bestehen aus Schlamm.");
    AddDetail(("boden"),
    "Schlamm...");
    
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20,ENV_TERRAIN:TT_CAVE]) );
  
  AddDetail(("schlamm"),
  "Vorne Schlamm, hinten Schlamm, ober Dir Schlamm, unter Dir Schlamm,...");
 
  AddSound( DEFAULT_SOUND,
    "Der umgedrehte, verkehrte Schlamm fluestert Dir 'hintenoben' zu.");
    
  AddSmell( DEFAULT_SMELL,
    "IGITT!!!Hier riecht es nach Tod und Verwesung.");
 AddItem(NPC"dschlamm", REFRESH_DESTRUCT);
  AddRoomMessage( 
    ({"Du geraetst in Panik...\n",
      "Angst ergreift Besitz von Dir...\n",
      "Ach, waerst Du doch nicht in den Brunnen gesprungen.\n",
      "Du denkst . o O 'BLUBB BLUBB BLUBB'\n",
      "Der Schlamm erdrueckt Dich fast.\n",
      "BLUBB....BLUBB....BLUBB....\n",
      "Der Schlamm blubbert und blubbert.\n",
      "Eine beschissene Situation...\n"}) );
 
 SetProp(P_HIDE_EXITS, ({"obenhinten"} ));
 AddExit( "obenhinten", "nach BLUBB#./brunnen7");
 }
 
 
 
 
