// suedlcih von tijara

#include "files.h"

inherit "std/room";
#include <moving.h>
#include <properties.h>
#include <language.h>
int geld;
create()
{ 

  geld = 3;
  ::create();
  SetProp( P_INT_SHORT, "Auf dem Dschungelpfad" );
  SetProp( P_INT_LONG, BS(
        "Der Pfad durch den Dschungel fuehrt nun schon ziemlich steil nach unten. "
        "Die Felswand wird wieder etwas niedriger und die herabstuerzenden Baeche "
        "nehmen auch ab. Noch in einiger Entfernung liegt eine gewaltige Schlucht "
        "vor Dir und Du kannst auch schon einen gigantischen Wasserfall rauschen hoeren. "
        "Der Dschungel ringsum Dich wird immer ueppiger und dichter."));
  AddDetail(("wasserfall"),
      "Der Wasserfall muss schon ziemlich nahe sein.");
  AddDetail(("entfernung"),
      "Ein kleines Stueck Pfad trennt Dich noch von der Schlucht, aber "
      "Du kannst bereits eine lange Haengebruecke erkennen.");
  AddDetail(({"rio","puseta","rio de la puseta"}),
      "Dieser Fluss ist ein gewaltiges Naturschauspiel. Sein gruenes Wasser funkelt und glitzert "
      "in der Sonne, das es eine wahre Freude ist.");
  AddDetail(({"naturschauspiel","natur","schauspiel"}),
      "Du bleibst kurz stehen und betrachtest die wunderbare Natur.");
  AddDetail(("freude"),
      "Vor Begeisterung jauchzt Du!");
  AddDetail(("silberland"),
      "Silberland ist unser aller Heimat.");
  AddDetail(("heimat"),
      "Dies ist unsere Welt.");
  AddDetail(("himmel"),
      "Der Himmel ist fast wolkenlos. Nur einige kleine Schaefchenwolken sind zu erblicken.");
  AddDetail(("wasser"),
      "Das Wasser des Rio de la Puseta ist smaragdgruen. Das Wasser am Boden ist eher schmutzig und braun.");
  AddDetail(({"wolken","schaefchenwolken","wolke"}),
      "Wie kleine, pummelige Schaefchen sehen sie aus.");
  AddDetail(({"schaf","schafe", "ochse"}),
      "Nicht wie Schafe, Du Ochse!");
  AddDetail(("schaefchen"),
      "Direkt zum ankuscheln...");
  AddDetail(("welt"),
      "Da faellt Dir doch ein Lied ein...");
  AddDetail(("lied"),
      "We are the world...");
  AddDetail(({"bruecke","haengebruecke"}),
      "Die Haengebruecke fuehrt ueber die Schlucht.");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_JUNGLE]) );

  AddDetail(("dschungel"),
      "Abseits des Pfades wachsen Straeucher, Baeume, Farne, Blumen und Graeser, "
      "die Du alle noch nie zuvor gesehn hast. Im Suedosten sieht man eine Luecke im sonst so dichten Dschungel."); 
  AddDetail(("luecke"),
      "Im Suedosten kann man den Dschungel betreten.");
  AddDetail(("suedosten"),
      "Im Suedosten sieht man eine Luecke im dichten Dschungel.");                                     
  AddDetail(({"straeucher","strauch"}),
      "Straeucher so hoch wie Huetten wachsen hier.");
  AddDetail(({"huette","huetten"}),
      "Erst nun bemerkst Du die traurigen Ueberreste einer alten Huette etwas "
      "abseits des Weges.");
  AddDetail(({"ueberreste","ueberrest"}),
      "Nur mehr die Truemmer liegen herum...");
  AddDetail(("truemmer"),
      "Vielleicht solltest Du die Truemmer genauer untersuchen..."); 
  AddDetail(({"farn","farne"}),
      "Die Farne sind hier besonders hoch und auf einem Farn faellt Dir ein seltsames "
      "Loch auf.");
  AddDetail(("loch"),
      "Hmm, warum hat der Farn ein Loch...");
  AddDetail(({"blume","blumen"}),
      "Ringsum Dich bluehen die farbigsten und schoensten Blumen, die Du jemals "
      "erblickt hast.\n");
  AddDetail(({"gras","graeser"}),
      "Die Graeser machen einen geknickten Eindruck, als wenn sie etwas niedergetrampelt haette...");
  AddDetail(({"baum","baeume"}),
      "Grosse starke Baeume wachsen hier. Ein Jojo-Baum faellt Dir besonders auf.");
  AddDetail(({"jojobaum","jojo-baum"}),
      "Hmm, vielleicht kann man auf den Baum raufklettern..."); 
  AddDetail(("boden"),
      "Der Boden ist weich und saftig durch das viele Wasser.");
  AddDetail(({"pfad","kurven","kurve"}),
      "Der Pfad fuehrt steil hinab zu Schlucht.");
  AddDetail(({"tal","weite"}),
      "Unter Dir erstreckt sich ein gruener Talkessel.");
  AddDetail(("schlucht"),
      "In der Tiefe der Schlucht erkennst Du schon den Fluss.");
  AddDetail(("fluss"),
      "Dieser Fluss ist der Rio de la Puseta, der fuer sein smaragdgruenes Wasser bekannt ist.");
  AddDetail(("tiefe"),
      "Das Wasser faellt mit grosser Wucht von hoch oben herab.");
  AddDetail(({"fels","wand","felswand","gebirge","hoehe"}),
      "Der Felsen werden hier wieder kleiner.");
  AddDetail(({"baeche","bach"}),
      "Die Baeche stuerzen die Fels hinab und verschwinden alle in einem Loch"
      " am Fusse des Felsens.");
  AddDetail(("loch"),

      "Das Loch im Boden ist hier kaum zu erkennen, weil es stark verwachsen ist.");


  AddSound( DEFAULT_SOUND,
      "Der tosende Wasserfall scheint schon sehr nahe zu sein.");

  AddSmell( DEFAULT_SMELL,
      "Der Dschungel duftet hier suess...");

  AddExit( "nordosten", "./weg5");
  AddExit( "suedwesten", "./weg7");
  AddExit("suedosten", "./tuempel1");

  AddItem( ({NPC"dratte", NPC"dbiene", NPC"bmamba"}), REFRESH_DESTRUCT);  
  AddCmd( ({"kletter","klettere"}), "krieche");
  AddCmd( ({"wuehle","wuehl"}), "wuehlen");

}


int krieche(string str)
{
  notify_fail("Wohin willst Du klettern ?\n");
  if( !str ) return 0;
  if( member( ({"auf jojo-baum", "auf jojobaum","jojobaum","jojo-baum" 
          }),str) !=-1 )

  {
    write (" \n"
        "Du kletterst  geschickt auf den Jojo-baum.\n");
    TP->move("/d/dschungel/dante/weg/room/jojobaum", M_GO,
        "auf den Jojo-baum", "klettert",              
        "kommt von unten herauf geklettert");
    return 1;

  }
  return 0;
}  

reset()
{
  geld=1;
  ::reset();
}


wuehlen( str )
{
  notify_fail("Wo willst Du wuehlen ?\n");
  if (str != "in truemmer")
  {
    write(""); return 0;
  }
  if (!geld)
  {
    write(" \n"
        "Du wuehlst in den Truemmern und verschneidest Dir die Finger.\n");
    TP->reduce_hit_point(10);
    say (CAP_TPN+" wuehlt in den Truemmern und verschneidet sich die Finger.\n");
    return 1;
  }
  if (str == "in truemmer")
    write( "\n"
        "Du wuehlst in den Truemmern und findest einige Muenzen, die Du hocherfreut einsteckst.\n");

  say (CAP_TPN+" wuehlt in den Truemmern, findet etwas und schaut Dich erfreut an.\n");
  TP->AddMoney( 300+random(600)); 
  geld--;
  return 1;
}             

