// suedlcih von tijara

#include "files.h"

inherit "std/room";
#include <moving.h>
#include <properties.h>
#include <language.h>

create()
{ 
  ::create();
  SetProp( P_INT_SHORT, "Auf dem Dschungelpfad" );
  SetProp( P_INT_LONG, BS(
        "Der Pfad durch den Dschungel fuehrt hier immer steiler nach unten. Von hier aus ist "
        "die Schlucht nun in ihrer ganzen Pracht einzusehen. Auch der Fluss, der in "
        "der Tiefe dahinrauscht ist zu erkennen. Die Felswand neben Dir ist auf einen "
        "niedrigen Brocken zusammengeschrumpft. Die tosenden Massen des Wasserfalls "
        "sind hier nicht mehr zu ueberhoeren."));
  AddDetail(("pracht"),
      "Gewaltig liegt die Schlucht vor Dir.");
  AddDetail(("wasserfall"),
      "Der Wasserfall uebertoent hier fast alle anderen Laute.");
  AddDetail(({"laute","lautstaerke"}),
      "Du kannst Dein eigenes Wort kaum mehr verstehen.");
  AddDetail(("massen"),
      "Nach der Lautstaerke zu urteilen, muss der Wasserfall sehr gross sein.");
  AddDetail(({"rio","puseta","rio de la puseta"}),
      "Der Rio de la Puseta ist der groesste Fluss im Silberland.");
  AddDetail(("silberland"),
      "Du befindest Dich mitten darin.");
  AddDetail(({"bruecke","haengebruecke"}),
      "Die Haengebruecke fuehrt ueber die Schlucht. Du glaubst eine grosse Gestalt "
      "auf der Bruecke zu erkennen.");
  AddDetail(("gestalt"),
      "Noch bist Du zu weit weg um genaueres zu erkennen.");


  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_JUNGLE]) );

  AddDetail(("dschungel"),
      "Abseits des Pfades wachsen Straeucher, Baeume, Farne, Blumen und Graeser, "
      "die Du alle noch nie zuvor gesehn hast."); 
  AddDetail(({"straeucher","strauch"}),
      "Die Straeucher sind hier besonders hoch. Einige Stauden fallen Dir auf.");
  AddDetail(({"staude", "stauden"}),
      "Auf diesen Stauden waechst Pfeffer, bzw Pfefferkoerner.");
  AddDetail(({"pfefferkoerner", "pfeffer", "koerner"}),
      "Sie haengen hier und sind reif!");

  AddDetail(({"farn","farne"}),
      "Farne soweit Dein Auge reicht...");
  AddDetail(({"blume","blumen"}),
      "Die Blumen haben hier besonders praechtige Farben.");
  AddDetail(("farben"),
      "Rot, blau, violett, gelb,...");
  AddDetail(({"gras","graeser"}),
      "Hier waechst das sogenannte Gouverneursgras. Eine Sorte Gras, die sehr selten ist.");
  AddDetail(("sorte"),
      "Benannt zu Ehren des Gouverneurs von Tijara.");
  AddDetail(("gouverneursgras"),
      "Diese Sorte hat man nach dem Gouverneur von Tijara benannt. He, da liegt "
      "ja mitten im Gras ein Baumstamm...");
  AddDetail(({"baumstamm","stamm"}),
      "Mitten im Gras liegt ein hohler Baumstamm, in den man scheinbar kriechen kann."
      " Du hast bei diesem Gedanken aber ein sehr ungutes Gefuehl...");
  AddDetail(("tijara"),
      "Eine grosse Stadt im Norden...");
  AddDetail(("stadt"),
      "Tijara ist eine Stadt.");
  AddDetail(("gouverneur"),
      "Der Gouverneur wohnt in Tijara.");

  AddDetail(({"baum","baeume"}),
      "Die Baeume werden hier wieder etwas kleiner.");
  AddDetail(("boden"),
      "Der Boden ist weich und saftig durch die feuchte Luft.");
  AddDetail(({"pfad","kurven","kurve"}),
      "Der Pfad fuehrt steil hinab zu Schlucht.");
  AddDetail(("schlucht"),
      "Die breite Schlucht ist schon ziemlich nahe. Du erkennst eine Bruecke, die "
      "etwas weiter suedlich ueber die Schlucht zu fuehren scheint...");
  AddDetail(("fluss"),
      "Dieser Fluss ist der Rio de la Puseta, der fuer sein smaragdgruenes Wasser bekannt ist.");
  AddDetail(("tiefe"),
      "Die Schlucht ist sehr tief.");
  AddDetail(({"fels","wand","felswand"}),
      "Die Felswand ist hier nur mehr sehr niedrig. Eigentlich ist sie keine Wand mehr, "
      "sondern eher ein grosser Stein.");
  AddDetail(("stein"),
      "Die ehemals hohe Felswand ist nur mehr ein kleiner Brocken.");
  AddDetail(("brocken"),
      "Die Felswand ist hier schon sehr mickrig.");
  AddDetail(("himmel"),
      "Der Himmel ist weit und strahlenblau.");
  AddDetail(("wasser"),
      "Das Wasser des Rio de la Puseta ist eine Augenweide. Das Wasser des Bodens dreckig.");  
  AddDetail(("luft"),
      "Die Luft ist feucht und schwuel.");
  AddDetail(("augenweide"),
      "Ein erhebender Anblick.");
  AddDetail(("weide"),
      "MUH!!!! MUH!!!!");




  AddSound( DEFAULT_SOUND,
      "Der tosende Wasserfall scheint schon sehr nahe zu sein.");

  AddSmell( DEFAULT_SMELL,
      "Die Luft ist hier schon sehr feucht...");

  AddItem( ({NPC"dpavian", NPC"dschimp", PAPAGEI}), REFRESH_DESTRUCT);

  AddExit( "nordosten", "./weg6");
  AddExit( "sueden", "./weg8");
  AddExit( "westen", "/d/dschungel/clementine/wantan/room/anschluss");

  AddCmd( ({"krieche","kriech"}), "krieche");
  AddCmd(({"pfluecke", "pflueck"}), "get");

}




int get(string str)
{
  object ob;
  notify_fail("Was willst Du hier pfluecken!?\n");
  if(str=="pfeffer"||str=="pfefferkorn"||str=="pfefferkoerner")
  {

    if(!present("ESSEN", TP))
    {
      write("Du erreichst leider keines der Koerner.\n");
      return 1;
    }
    if(deep_present("PEPE", TP))
    {
      write("Nein, nur ein Pfefferkorn fuer Dich!\n");
      return 1;
    }
    else
    {
      write("Du pflueckst Dir ein Pfefferkorn!\n");
      ob=clone_object("d/dschungel/dante/weg/obj/pepe");
      ob->move(TP, M_NOCHECK);
      return 1;
    }
    return 0;
  }
  return 0;
}





int krieche(string str)
{
  notify_fail("Wohin willst Du kriechen ?\n");
  if( !str ) return 0;
  if( member( ({"in baumstamm", "baumstamm","in hohlen baumstamm","in stamm", 
          }),str) !=-1 )

  {write (" \n"
      "Du ziehst Deinen Bauch ein und kriechst in den hohlen Baumstamm.\n");
  TP->move("/d/dschungel/dante/weg/room/stamm", M_GO,
      "in einen hohlen Baumstamm", "kriecht",              
      "kommt von draussen hereingeklettert");
  return 1;

  }
  return 0;
}  
