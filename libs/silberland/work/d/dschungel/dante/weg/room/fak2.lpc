//dante 98 schneckenhauskneipe
//  "bewegt " sich mit 100 fuessler mit
//man kan sehn wo man isw usw
//mini schnecke is keeper

inherit "std/pub";

#include <moving.h>
#include <player.h>


#define MINIQUEST present("\nminiquest", TP);
#define QUESTKEY "Buckel vor Mini"     
#include <properties.h>
#include <pub.h>
#include "files.h"



create()
{
  ::create();

  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 1);
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:20]));
  SetProp (P_INT_SHORT, "Im Schneckenhaus");
  SetProp (P_INT_LONG, BS(
  "Du befindest Dich nun im Schneckenhaus, besser gesagt in einer kleinen "
  "Kneipe die sich in einem Schneckenhaus befindet. " 
  "Einrichtung gibt es hier kaum, weder Baenke "
  "noch Tische. Alles ist ziemlich leer, wie eben ein Schneckenhaus ohne Schnecke "
  "so ist. An einer der Waende haengt eine Tafel. Darunter ist ein kleiner "
  "Eisblock auf dem die Getraenke und Speisen gelagert werden. Durch eine "
  "kleine Oeffnung kommst Du wieder raus. Mit <unt umgebung> kannst Du sehen wo "
  "Du Dich gerade befindest."));
  
  
  AddSpecialDetail("umgebung", "look");
  AddDetail(({"stich", "sonnenstich"}),
  "Draussen ist es ziemlich warm. Du solltest Dich vor der Sonne schuetzen...");
  AddDetail("sonne",
  "Hier dringt sie nur sehr spaerlich ein.");
  AddDetail("tafel",
  "Mit <menue> kannst Du sie lesen.");
  AddDetail("einrichtung",
  "Die Einrichtung besteht aus einem Eisblock und einer Tafel.");
  AddDetail(({"baenke","bank"}),
  "Doch in einer Ecke steht eine imaginaere Bank. Du hast wohl einen Sonnenstich!");
  AddDetail(({"tisch","tische"}),
  "Hmm, ja da steht wirklich ein Holztisch.");
  AddDetail("holztisch",
  "Der Holztisch ist alt und sieht nicht sehr stabil aus.");
  AddDetail("holz",
  "Das Holz ist alt und morsch.");
  
  AddDetail(({"eck","ecke"}),
  "Gibt es hier nicht, das Haus ist rund.");
  AddDetail("himmel",
  "Den Himmel kann man hier natuerlich nicht sehen.");
  AddDetail("schnecke",
  "Die hat hier frueher mal gelebt.");
  AddDetail(({"wand","waende"}),
  "Die Waende sind glatt und sauber. An einer der Waende haengt eine Tafel. "
  "Gegenueber sieht man eine kleine Oeffnung.");
  AddDetail(({"eisblock","block"}),
  "Der Eisblock haelt die Getraenke und Speisen kuehl. Du wunderst Dich, dass "
  "er nicht zerrinnt. Naja, hier ist es ueberhaupt angenehm kuehl.");
  AddDetail(({"getraenk","getraenke","speisen","speise"}),
  "Du siehst alles moegliche auf dem Eisblock. Glaeser, Flaschen, eine kleine Kiste...");
  AddDetail("kiste",
  "Hmm, die Kiste sieht nicht allzu schwer aus. Sie steht direkt vor "
  "dem Holztisch. Frag mal Mini danach!");
    
  
  AddDetail(({"glas","glaeser"}),
  "Du bekommst Durst!");
  AddDetail(({"flasche","flaschen"}),
  "Hmm, was da wohl alles drin ist.");
  
  AddDetail("oeffnung",
  "Durch die Oeffnung kommst Du wieder raus.");
  AddDetail("boden",
  "Der Boden ist sauber und besteht aus Chitin und Horn.");
  AddDetail(({"horn","chitin"}),
  "Daraus besteht das Schneckenhaus.");
   AddDetail(({"haus","kneipe","schneckenhaus"}),
   "Du stehst mitten drin!");
   
   
   
  SetProp(P_PUB_FLAGS, PUB_HASKEEPER+PUB_NEEDSKEEPER);
  SetProp(P_PUBKEEPER_ID, "mini");
  SetProp(P_PUBKEEPER_NAME, "Mini");
  SetProp(P_PUBMSG_NOKEEPER, "Mini, die Wirtin ist nicht da.\n");
  SetProp(P_PUBMSG_NOENEMY, BS("Aber Du kaempfst doch gerade mit Mini, glaubst "
      "Du im Ernst, dass sie Dir dann auch noch etwas servieren wuerde???"));
  SetProp(P_PUBMSG_NOINVITE, BS("Mini denkt gar nicht daran, ihren Gegnern "
      "auch noch etwas zu servieren."));
  SetProp(P_PUBMSG_FIGHTING, "Mini hat gerade was zu tun!!!\n");
  AddSound (DEFAULT_SOUND,
    "Von draussen hoerst Du den Laerm des Dschungels.\n");

  AddSmell(DEFAULT_SMELL,
  "Es riecht nach... hmm... Schnecke???\n");
  
  AddDetail(({"haus","schneckenhaus","raum"}),
  QueryProp(P_INT_LONG));
  
AddSound(({"dschungel","laerm"}),
"Der Laerm des Dschungels ist hier auch noch zu hoeren.");


//drinks
  
  AddDrink("Schneckensaft",({"saft","schneckensaft"}),      // Name, IDs,
           70, 12, 0, 5,                       // Preis, LP, Alk, Saettigung,
           ({"Mini bringt Dir ein kleines Glas Schneckensaft, "+
             "das Du vorsichtig anschaust und dann runterwuergst. "+
             "Waeh! Eklig!",
             "&& trinkt mit verzerrtem Gesicht ein Glas mit braunem Schneckensaft.\n"+
             "Dann wuergt && herum..."}));

  AddDrink("Dschungelpils", ({"pils", "dschungelpils", }),
           100, 15, 3, 6,
           ({"Mini serviert Dir ein Dschungelpils.",
             "&& trinkt mit lautem Ruelpsen ein Dschungelpils."}));

  AddDrink("Schlammwein", ({"wein","schlammwein","schlamm"}),
      150, 17,5,5,
           ({"Mini bringt Dir Dein Glaeschen Schlammwein. "+
             "Er schmeckt genauso wie er heisst, schlammig!",
             "&& geniesst ein Glaeschen schlammigen Schlammwein."}));

  AddDrink("Affenschnaps", ({"affenschnaps", "schnaps"}), 200, 22, 10, 1,
           ({"Mini bringt Dir Deinen Affenschnaps.\n"+
             "Du trinkst ihn und springst dann wie ein Affe herum!",
             "&& kippt ein Stamperl Affenschnaps runter, springt "+
             "dann wie ein Affe herum."}));

  AddDrink("Kannibalentod", ({"kannibalentod", "tod"}),
           300,26,6,4,
           ({ "Mini bringt Dir einen hohlen Schaedel, gefuellt mit "
              "einer blutroten Fluessigkeit. Du leerst das Zeug runter und "
              "fuehlst Dich stark wie ein Kannibale!",
              "&& bestellt sich einen Kannibalentod und bruellt dabei wie am "
              "Spiess!" }));


  AddDrink("Malariabrand", ({"malaria","malariabrand","brand"}),
  400, 30,11,0,
           ({"Mini bringt Dir Dein Glas Malariabrand."+
           "Es macht seinem Namen alle Ehre!",
             "&& geniesst ein Glaeschen Malariabrand und roechelt dann."}));

  AddDrink("Tigerblut", ({"tiger","tigerblut","blut"}),
  1000, 80,0,23,
           ({"Mini bringt Dir Dein Glas Tigerblut.\n"
           "Du trinkst es aus und denkst Dir waechst ein Fell!!! ROARRRR!!!",
           "&& trinkt Tigerblut und schaut Dich hungrig an!"}));


  AddFood("Bananenmatsch",({"bananen","matsch","bananenmatsch"}),
  30, 5,2,
  ({"Du bekommst zermatsche Bananen von Mini.", 
  "&& isst zermatsche Bananen!"}));


  AddFood("Moskitosandwich",({"moskito","sandwich","moskitosandwich"}),
  40, 7,3,
  ({"Du isst ein Sandwich, das mit Moskitos belegt ist. "
  "Irgendwie ist Dir nun flau im Magen!", 
  "&& isst ein Moskitosandwich."}));
  
  
  AddFood("Schlangensuppe",({"suppe","schlangensuppe","schlange"}),
  90, 18 ,8,
  ({"Du loeffelst eine Schlangensuppe!",
  "&& loeffelt eine Schlangensuppe."}));



  AddFood("Spielerkeule",({"keule","spieler","spielerkeule"}),
  150, 15,10,"iss_spieler");
  
  AddFood("Affenhirn",({"hirn","affenhirn","affe"}),
  160, 17,6,
  ({"Du bestellst ein Affenhirn, isst es auf und fuehlst Dich "
  "danach viel schlauer.",
  "&& isst ein Affenhirn und glaubt nun klueger zu sein!"}));
  
  AddFood("Tapirmilz",({"milz","tapirmilz","tapir"}),
  320, 40 ,14,
  ({"Du isst die Milz eines Tapirs!",
  "&& frisst die Milz eines Tapirs."}));
  
  AddFood("Ein halber Kannibale",({"kannibale","halber kannibale", 
          "halben kannibalen"}),
  750, ({100, 20, 40}),28,
  ({"Du frisst einen halben Kannibalen!!!", 
  "&& frisst einen halben Kannibalen."}));
  
  AddFood("Wurstmagier",({"magier","wurst","wurstmagier"}),
  1350, ({30,130, 100}),35,
  ({"Du bekommst eine Riesenwurst, die einen Magier darstellt. "
  "Sie schmeckt irgendwie faul...", 
  "&& frisst gerne Wurstmagier auf."}));
  
  AddFood("Kobraspaghetti",({"kobra","kobraspaghetti","spaghetti"}),
  5555, 222,44,
  ({"Du bekommst einige verwickelte Jungkobras mit Sauce! "
  "Langsam lasst Du sie in Deinen Mund gleiten!", 
  "&& frisst verwickelte Kobras mit Sauce!"}));
  
  AddDetail("decke",
  "Die Decke ist aus Horn und Chitin und ziemlich rund...");
  
  AddCmd(({"oeffne","mach","schliesse","schliess"}),"noopen");
//  AddCmd(({"steige","kletter","steig","klettere"}),"get");

  AddSpecialExit("raus", "find");

  AddItem (NPC "mite", REFRESH_DESTRUCT);

AddCmd(({"heb","hebe"}), "try");

}


   int try(string str)  {
   object mini;
   notify_fail("Was willst Du hier vom Boden auf den Holztisch heben?\n"
   "syntax < hebe kiste von boden auf tisch >!\n");
   

   if(member(({"kiste vom boden auf holztisch",
               "kiste von boden auf holztisch",
               "kiste auf holztisch von boden",
               "kiste auf holztisch vom boden",
               "kiste vom boden auf tisch",
               "kiste von boden auf tisch"}),str)!=-1)  {
   
   
   if(!present("mini", environment(TP)))  {
   write("Nein, Mini, die Minischnecke muss anwesend sein!\n");
   return 1;
   }
   if(!present("\nminiquest", TP))  {
   write("Nein, Du musst zuerst mit Mini reden!\n");
   return 1;
   }
/*
   if(TP->QueryQuest(QUESTKEY)) {                      
   write("Aber Du hast doch schon einmal total versagt!\n");
   return 1;
   }
*/
if(deep_present("\nminibutton", TP)) {
  write("Aber Du hast doch bereits einen Button!\n");
  return 1;  }
  

    else {
    mini=MINIQUEST
    mini->NextTry();
    switch(random(10))  {
    case 0:
    write(BS("Du versuchst die Kiste hochzuheben, scheiterst aber klaeglich! "
    "Du bist scheinbar viel schwaecher als Du geglaubt hast! "
    "Mini, die Minischnecke lacht Dich aus!\n"));
    break;
    case 1:
    write(BS("Du konzentrierst Dich, dann willst Du die Kiste hochheben. "
    "Doch Du bekommst die Kiste nicht einmal einen Zentimeter vom Boden! "
    "Mini, die Minischnecke rotflt!\n"));
    break;
    case 2:
    write(BS("Du atmest tief ein und versuchst die Kiste zu heben!\n"
    "Du schaffst es sie hochzuheben, doch dann gleitet sie Dir aus den "
    "Haenden und faellt genau auf Deine Fuesse! AUA!!!\n"
    "Mini, die Minischnecke verhoehnt Dich.\n"));
    break;
    case 3:
    write(BS("Du packst die Kiste mit beiden Armen und hebst sie hoch. "
    "Doch dann verlassen Dich Deine Kraefte und Du musst sie wieder "
    "am Boden abstellen!\n"
    "Mini, die Minischnecke sagt: Du Versager!\n"));
    break;
    case 4:
    write(BS("Du versuchst die Kiste hochzuheben, doch fuer Dich "
    "ist sie viel zu schwer.\n"
    "Mini, die Minischnecke tritt Dich!\n"));
    break;
    case 5:
    write(BS("Du baust Dich vor der Kiste auf, und versuchst sie mit "
    "einem Ruck hochzureissen. Das einzige das passiert, ist ein "
    "schmerzliches Stechen in Deiner Wirbelsaeule. AUA!!!\n"
    "Mini, die Minischnecke sagt: Lass es! Du bist zu schwach!\n"));
    domainshout("Mini ruft: "+TPN+" kann nicht einmal eine Kiste hochheben!\n");
    break;
    case 6:
    write(BS("Du packst die Kiste und willst sie hoch heben! "
    "Doch dann verlassen Dich Deine Kraefte und Du gibst frustriert auf! "
    "Mini, die Minischnecke rollt lachend am Boden umher.\n"));
    break;
    case 7:
    write(BS("Du hebst die Kiste auf. Stellst sie auf den Holztisch, "
    "doch dann wackelt der bloede Tisch und die Kiste faellt wieder "
    "zu Boden. Mini, die Minischnecke grinst Dir ins Gesicht.\n"));
    break;
    case 8:
    write(BS("Du versuchst die Kiste hochzuheben, rutscht dabei aus "
    "und faellst der Laenge nach hin. Mini, die Minischnecke denkt "
    ". o O 'Was fuer ein Versager!'\n"));
    break;
    case 9:
    write(BS("Du willst die Kiste hochheben, schaffst es auch! Doch dann "
    "tritt Dich jemand von hinten und die Kiste rumpelt zu Boden! "
    "Dann schaut Dich Mini, die Minischnecke unschuldig an! Hmm, "
    "wie soll Dich eine Schnecke treten...\n"));
    break;
    default: write("BUG!\n");
    }
    
    
    return 1;
    }
  return 0;} return 0;}  
        
    
    
    
    
    
    
    
    
    
    
  
 int iss_spieler(object e, object z)
    {
      tell_object(e,BS(mess(
      "Du bestellst eine Spielerkeule und bekommst von Mini eine "+e->name()+"-Keule "
      "serviert! Etwas verwundert und angeekelt isst Du alles auf!",e)));

      tell_room(ME,BS(e->Name()+" bestellt eine Spielerkeule und bekommt kurz "
     "darauf von Mini eine "+e->name()+"-Keule serviert. Kannibale!!!"), ({e}));  
      }

