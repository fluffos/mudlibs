 noopen(string str)
   {
   notify_fail("Was willst Du mit der Kiste machen?\n");
   if (!str) return 0;
      if(member(({"kiste","kiste auf"}),str)!=-1)
          {
          write("Du versuchst die Kiste irgendwie zu oeffnen, aber so "
          "scheint das nicht zu klappen. Vielleicht kann man ja mit der Kiste "
          "etwas anderes machen!\n");
          say(CAP_TPN+" macht sich an der Kiste zu schaffen.\n");
          return 1;
          }
     return 0;
    }

look()
  {
     object ob;
     ob = find_living("schneckenhaus");

     if(objectp(ob))
     
     return("Du schaust durch die kleine Oeffnung nach draussen:\n"+environment(ob)->QueryProp(P_INT_LONG));
     
     else
     
     return BS("Die Umgebung sieht langweilig aus.\n");
     
     }
      
     
            
   find()
    {
   object ob;
   ob = find_living("schneckenhaus"); 
       
       
   if(objectp(ob))
    TP->move(environment(ob), M_GO);
    else
   TP->move("/d/dschungel/dante/weg/room/weg14", M_GO);
   return 1;
       }                                                      
                                                               
       
