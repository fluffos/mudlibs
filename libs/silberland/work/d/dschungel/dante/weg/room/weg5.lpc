// suedlcih von tijara

#include "files.h"

inherit "std/room";
#include <moving.h>
#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Auf dem Dschungelpfad" );
  SetProp( P_INT_LONG, BS(
        "Der Pfad wird nun immer steiler und fuehrt in engen Kurven in das Tal\n"
        "hinab. Vor Dir kannst Du nun die ganze Weite des Tals ueberblicken.\n"
        "Die Schlucht scheint immer breiter zu werden. Die Felswand ueber Dir ragt\n"
        "einem Gebirge gleich in die Hoehe und grosse Baeche stuerzen von oben\n"
        "vorbei in die Tiefe. Der Dschungel ringsum Dich wird immer exotischer.\n"));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_JUNGLE]) );

  AddDetail( ({"himmel"}),
      "Der Himmel ist weit ueber Dir.");
  AddDetail(("dschungel"),
      "Abseits des Pfades wachsen Straeucher, Baeume, Farne, Blumen und Graeser, "
      "die Du alle noch nie zuvor gesehn hast.");                                      
  AddDetail(({"straeucher","strauch"}),
      "Diese bunten, hohen Straeucher sind Dir voellig fremd."); 
  AddDetail(({"farn","farne"}),
      "Die Farne sind fast einen Meter hoch.");
  AddDetail(({"blume","blumen"}),
      "Ringsum Dich bluehen die farbigsten und schoensten Blumen, die Du jemals "
      "erblickt hast.");
  AddDetail(({"gras","graeser"}),
      "Hier waechst das Gras besonders kraeftig und hoch.");
  AddDetail(({"baum","baeume", "pflanzen"}),
      "Die Baeume und auch alle anderen Pflanzen scheinen durch den feuchten Boden"
      " besonders gut zu gedeihen."); 
  AddDetail(("boden"),
      "Der Boden ist weich und saftig durch das viele Wasser.");
  AddDetail(({"pfad","kurven","kurve"}),
      "Eng und stark gewunden fuehrt der Pfad steil nach unten.");
  AddDetail(({"tal","weite", "talkessel"}),
      "Unter Dir erstreckt sich ein gruener Talkessel.");
  AddDetail(("schlucht"),
      "Die Schlucht scheint von hier wie ein grosser, gieriger Schlund.");
  AddDetail(({"tiefe", "wasser"}),
      "Das Wasser faellt mit grosser Wucht von hoch oben herab.");
  AddDetail(({"fels","felsen","wand","felswand","gebirge","hoehe"}),
      "Der Felsen hat hier gigantische Ausmasse. Das obere Ende ist von hier "
      "unten nicht mehr zu erkennen.");
  AddDetail( ({"ende", "wurst"}),
      "Alles hat ein Ende nur die Wurst hat zwei.");
  AddDetail( ({"ausmasse"}),
      "Die Ausmasse der Felswand sind wahrhaft gigantisch.");
  AddDetail(("baeche"),
      "Die Baeche stuerzen mit lautem Getoese die Wand herab und verschwinden "
      "alle in einem grossen Loch am Fusse des Felsens, um irgendwo wieder ans"
      " Tageslicht zu treten.");
  AddDetail(("loch"),
      "Als Du Dir das grosse Loch im Felsen naeher betrachtest, faellt Dir "
      "ein enger Spalt knapp neben dem herabstuerzenden Wasser auf.");
  AddDetail(({"spalt","spalte"}),
      "Der Spalt im Felsen scheint tiefer in den Fels hinein zu fuehren.");

  AddSound( ({DEFAULT_SOUND, "tosen", "wasserfall"}),
      "Der tosende Wasserfall scheint schon sehr nahe zu sein.");

  AddSmell( ({DEFAULT_SMELL, "geruch", "pflanzen"}),
      "Der Geruch von morschen Pflanzen liegt in der Luft.");


  AddExit( "norden", "./weg4");
  AddExit( "suedwesten", "./weg6");

  AddCmd( ({"krieche","kriech","zwaenge","zwaeng","kletter","klettere"}), 
      "krieche");

  AddItem(NPC"dztapir", REFRESH_DESTRUCT);



}
int krieche(string str)
{
  notify_fail("Wohin willst Du kriechen?\n");
  if( !str ) return 0;
  if( member( ({"in hoehle", "durch spalt", "in spalt","in spalte","durch spalte"
          }),str) !=-1 )

  {write(" \n"
      "Du kriechst durch den Spalt und faellst jaeh nach unten.\n");
  TP->move("/d/dschungel/dante/hoehle/room/hoehle1", M_GO, 
      "in den dunklen Spalt","kriecht",
      "kommt durch den Spalt geflogen");
  return 1;

  }
  return 0;
}   
