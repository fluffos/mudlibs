//raUM in der stadtmauer von tijara

#include "files.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <wizlevels.h>


int heal, schale;
create()
{
  ::create();

  schale=1;
  heal=3;
  SetProp( P_INT_SHORT, "In einer geheimen Kammer" );
  SetProp( P_INT_LONG, BS(
        "Du stehst in einem ovalen Raum, der eine ueberdimensionale Schale darstellt. "
        "Der Boden steigt an den Waenden leicht an, genau wie bei einer Schale, "
        "nur eben viel groesser. Hmmm, normalerweise liegt in Schalen oft "
        "Essen herum. Solltest Du die Mahlzeit fuer irgend ein boesartiges Wesen sein?"));
  AddDetail("mahlzeit",
      "Wer wird Dich wohl fressen?");
  AddDetail(({"anderen","andere", "anderes","andere"}),
      "Naja, die Anderen sehen anders aus. Daher heissen sie die Anderen.");

  AddDetail("boden",
      "Der Boden der Schale besteht aus einem glasartigen Material. "
      "Ausserdem sieht man ein Loch im Boden.");

  AddDetail("loch",
      "Das Loch fuehrt scheinbar nach unten, wohin genau erkennst Du nicht.");

  AddDetail("material",
      "Du kennst Dich mit solchen Sachen nicht gut aus, warum solltest "
      "Du dann das Material erkennen?");
  AddDetail(({"sache", "sachen"}),
      "Sachen zum lachen.");
  AddSpecialDetail("essen", "heil");
  AddDetail("grund",
      "Na das am Boden...");
  AddDetail(({"rand", "raender"}),
      "Die Raender gehen in die Wand ueber.");
  AddDetail(({"wand", "waende"}),
      "Die Wand geht in den Boden und in die Decke ueber.");
  AddDetail("decke",
      "Die Decke ist flach und glatt. Also fad.");
  AddDetail("raum",
      "Der Raum hat die Form einer Schale.");
  AddDetail("form",
      "Oval.");

  AddDetail("wesen",
      "Das Wesen, das diese Schale erschaffen hat, ist nicht hier. Dein Glueck.");
  AddDetail("glueck",
      "Du hast Glueck, denn auf einmal entdeckst Du ein winziges Symbol, das gruen "
      "schimmert.");
  AddDetail(({"gruenes symbol", "winziges symbol"}),
      "Das Symbol leuchtet nun hell auf und weist auf eine Stelle an der Wand.");
  AddDetail("stelle",
      "Dort wo der gruene Schimmer hinfaellt, ist eine Zeichnung.");
  AddDetail("schimmer",
      "Der gruene Schimmer zeigt auf eine Stelle an der Wand.");
  AddDetail("zeichnung",
      "Die Zeichnung zeigt eine Nische.");
  AddDetail("Du siehst an der Wand eine gezeichete Nische, oder ist sie doch "
      "nur ein Trugbild.");
  AddDetail(({"trugbild", "bild"}),
      "Nein, sie ist weder gezeichnet noch ein Trugbild.");
  AddSpecialDetail("nische", "show");

  AddDetail(({"schale", "schalen"}),
      "Du befindest Dich mitten in einer riesigen Schale. Die Raender sind mit seltsamen "
      "Symbolen versehen.");
  AddDetail(({"symbole", "symbol"}),
      "Die Symbole sagen Dir nichts. Eines sieht anders als die Anderen aus. Du erkennst "
      "in ihm eine kleine Vertiefung.");
  AddDetail("vertiefung",
      "Die kleine Vertiefung ist wirklich nur klein. Am Grund der Vertiefung "
      "entdeckst Du einen Hebel.");
  AddDetail("hebel",
      "Der Hebel ist natuerlich noch kleiner als die Vertiefung.\n");
  //  AddSpecialDetail("schale in nische", "here");
  SetProp( P_LIGHT, 0);
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20,ENV_TERRAIN:TT_CAVE]) );
  AddSound( DEFAULT_SOUND,
      "Hier ist es voellig still.");

  AddSmell( DEFAULT_SMELL,
      "Eigentlich riecht es hier nach nichts.");


  AddItem("/d/dschungel/dante/weg/npc/imon.lpc", REFRESH_DESTRUCT);



  AddCmd(({"zieh", "ziehe","bewege", "beweg"}), "nix");
  AddCmd(({"nimm", "nehme"}), "get");
  AddCmd(({"unt", "untersuche", "schau"}), "nischeschau");
  
  AddSpecialExit("raus", "try");
  SetProp(P_HIDE_EXITS, ({"unten"}) ); 

}
string here();

int nischeschau(string str)
{
  if(str=="schale in nische")
    return here(),1;
  else
    return 0;
}

int try()
{
  if (present("ykath", TO))
  {
    switch(random(10))
    {
      case 0..2:
        write("Der Ykath haelt Dich lachend fest!\n");
        return 1;
        break;
      case 3..9:
        return this_player()->move("/d/dschungel/dante/weg/room/weg1", M_GO+M_SILENT);
        break;
      default: write("BUG!\n");
    }
  }
  if(!present("ykath", TO))
  {  
    return this_player()->move("/d/dschungel/dante/weg/room/weg1", M_GO+ M_SILENT);  
  }
}



string here()
{
  if(schale)
  {
    write(BS("Die Schale steht einfach in der Nische. Um sie genauer untersuchen "
        "zu koennen, musst Du sie schon aus der Nische herausnehmen.\n"));
  }
  if (!schale)
  {
    write("Sowas ist nicht hier.\n");
  }
  return "";
}

int get(string str)
{
  object ob;
  notify_fail("Was willst Du woraus nehmen?\n");
  if (!str) return 0;

  if(str=="schale aus nische")
  {
    if(!schale)
    {
      write("Da ist keine Schale, die Du aus der Nische nehmen koenntest.\n");
      return 1;
    }
    if (schale)
    {
      write("Du nimmst die Schale aus der Nische.\n");
      ob=clone_object("/d/gebirge/angrox/obj/obsidianschale");
      ob->move(TP, M_NOCHECK);
      schale--;
      return 1;
    }
    return 0;
  }
  return 0;
}


string heil()
{
  if (heal)
  {
    write("Du denkst an Essen und fuehlst Dich auf einmal stark und gesaettigt.\n");
    TP->heal_self(15+random(15));
    heal--;
  }
  if (!heal)
  {
    write("Tja, pass bloss auf...\n");
  }
  return "";
}


string show()
{
  if(schale)
  {
    write("In der Nische siehst Du eine Schale.\n");
  }
  if(!schale)
  {
    write("Die Nische ist leider leer.\n");
  }
  return "";
}


int nix(string str)
{
  notify_fail("Was willst Du hier tun?\n");
  if (!str) return 0;
  if (str=="hebel"||str=="an hebel")
  {
    write("Du ziehst am Hebel, doch ausser einer dunklen Stimme, die Dich "
        "auslacht, passiert nichts.\n");
    return 1;
  }
  return 0;
}


reset()
{
  ::reset();
  schale=1;
  heal=3;
}

