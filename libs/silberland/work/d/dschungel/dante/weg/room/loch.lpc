// a, felsen 2  by dante 97

#include "files.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#define IWO_ANSCHLUSS  "/d/dschungel/iwo/anschluss"


create()
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einer kleinen Dschungellichtung" );
  SetProp( P_INT_LONG, BS(
        "Du folgst dem kleinen Pfad bis an sein Ende und kommst auf eine "
        +"kleine Lichtung."
        " Ringsum Dich kannst ausser einem grossen Felsklotz nur den "
        +"dichten Dschungel " 
        "erkennen. Der Boden ist hier besonders saftig, was die reiche "
        +"Vegetation zeigt."));
  AddDetail(({"pfad","ende"}),
      "Der Pfad fuehrt von hier nur mehr zurueck nach Westen.\n");
  AddDetail(("lichtung"),
      "Die Lichtung ist nicht allzu gross und wird von dem Felsklotz beherrscht.");
  AddDetail(("boden"),
      "Der Boden ist uebersaet mit wild wuchernden Blumen.\n");
  AddDetail(("blumen"),
      "Bunte, exotische Blumen wiegen sich hier zart im Wind.\n");
  AddDetail(({"wind"}),
      "Hier weht ein kuehler, angenehmer Wind.");
  AddDetail(({"felsklotz","klotz"}),
      "Der Felsklotz ist grau und sicher so gross wie ein Elefant.");
  AddDetail(({"elefant"}),
      "Elefanten siehst Du hier keinen, aber eine Vorder- und Rueckseite "
      "des Felsklotzes.");
  AddDetail(("seite"),
      "Welche Seite meinst Du ?");
  AddDetail(("rueckseite"),
      "An die Rueckseite kommst Du nur sehr schlecht heran. Ein grosser "
      +"Ast versperrt "
      "Dir die Sicht.");
  AddDetail(("sicht"),
      "Der Ast versperrt Dir die Sicht auf die Rueckseite.");
  AddDetail(("ast"),
      "Der Ast ist knorrig und hat eine harte, schon leicht sproede Rinde.");
  AddDetail(("rinde"),
      "Du betrachtest die Rinde und Du sieht eine kleine Einkerbung.");
  AddDetail(("einkerbung"),
      "Die Einkerbung erweist sich als Pfeil, der nach unten zeigt...");
  AddDetail(("pfeil"),
      "Deine Blicke folgen dem Pfeil nach unten und Du siehst ein kleines "
      +"Loch im Boden.");
  AddDetail(("loch"),
      "Das Loch ist sehr klein, aber man kann da sicher hineinkriechen.");
  AddDetail(({"vorderseite"}),
      "An der Vorderseite kann man nichts besonders erkennen. Etwas Moos hat sich "
      "hier festgesetzt.");
  AddDetail(("moos"),
      "Das Moos ist gruen und frisch. Einige kleine Insekten krabbeln in ihm "
      +"herum.");
  AddDetail(({"insekt","insekten"}),
      "Die Insekten laufen zwischen dem Moos hin und her und geniessen die "
      +"warme Sonne. Dir faellt ein dunkler Fleck zwischen dem Moos auf.");
  AddDetail("fleck",
      "Hmm, scheint ein ganz besonderer Stein zu sein!.");
  AddDetail("stein",
      "Es handelt sich um einen Feuerstein. Er scheint aber sehr fest am "
      "Klotz dran zu sein. Du musst ihn sicher mit Gewalt herunterreissen!");
  AddDetail("gewalt",
      "ARGHHHHHHHHHHHHHHHHHHHHH");
  AddDetail("feuerstein",
      "Nein, nicht Fred, sondern ein Stein mit dem man Feuer erzeugen kann.");
  AddDetail(({"fred", "feuer"}),
      "Hmm, koennte sinnvoll sein, das Feuer, Fred nicht!");

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25, ENV_TERRAIN:TT_JUNGLE]) );

  AddDetail(("himmel"),
      "Die Sonne scheint auf Dich herab und taucht alles in gleissendes Licht.");
  AddDetail(("brise"),
      "Ein leichter Wind ist damit gemeint...");

  AddDetail(({"sonne","licht"}),
      "Die Sonne strahlt hier warm und angenehm herab, wird jedoch durch "
      "den leichten Wind ertraeglicher gemacht.");
  AddDetail(("wind"),
      "Hier weht eine leichte Brise, die Dich angenehm kuehlt.\n");
  AddDetail(("dschungel"),
      "Du siehst den Dschungel vor lauter Pflanzen nicht.\n");
  AddDetail(("vegetation"),
      "Die Vegetation ist hier ueppig und dicht.\n");

  AddSound( DEFAULT_SOUND,
      "Der Wind rauscht leise durch die Blumen.");

  AddSmell( ({DEFAULT_SMELL, "blumen", "duft"}),
      "Die Blumen verstroemen einen wunderbaren Duft.");

  AddCmd(({"kriech","krieche"}), "kriechen");
  AddCmd(({"reiss","reisse"}), "get");  
  AddItem( ({NPC"dmoskito", NPC"dstechmuecke"}), REFRESH_DESTRUCT);
  AddItem( ({NPC"dfrosch2", NPC"dfrosch1"}), REFRESH_DESTRUCT);

  // AddExit("osten", IWO_ANSCHLUSS);

  AddExit( "westen", "./weg2");
}

int get(string str)
{
  object ob;
  notify_fail("Was willst Du hier ausreissen?\n");
  if(str=="stein"||str=="feuerstein"||str=="stein vom klotz"||
      str=="feuerstein von klotz"||str=="stein aus"||str=="feuerstein aus")
  {   
    if(!present("ESSEN", TP))
    {
      write("Du bist doch viel zu schwach!\n");
      return 1;
    }

    if(deep_present("FEUERSTEIN", TP))     {
      write("Der Feuerstein sitzt viel zu fest fuer Dich!\n");
      return 1;
    }
    else
    {
      write("Du konzentrierst Dich und reisst mit aller Gewalt am Feuerstein.\n"
          "Es gelingt Dir zumindest einen Teil auszureissen.\n");
      ob=clone_object("d/dschungel/dante/weg/obj/firest");
      ob->move(TP, M_NOCHECK);
      return 1;
    }
    return 0;
  }   
  return 0;
}



int kriechen( string str)
{
  notify_fail("Wo willst Du hineinkriechen ?\n");
  if ( !str ) return 0;
  if ( member ( ({"in loch", "durch loch"}),str) !=-1)
  {
    write(" \n"
        "Du ziehst Deinen Bauch ein und kriechst in das Loch.\n");
    TP->move("/d/dschungel/dante/hoehle/room/loch2", M_GO,
        "in ein kleines Loch","kriecht",
        "kommt durch das kleine Loch gekrochen");
    return 1;
  }
  return 0;
}


