/*
 ** plantage mit ananas
 ** dante 97 feb 
 ** 
 */

inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>

#include "files.h"
inherit ROOM "planta_inh.lpc";

nosave int papaya;

create()
{
  room::create();
  planta_inh::create();     
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:30, ENV_TERRAIN:TT_JUNGLE]));
  SetProp (P_INT_LONG, BS(
        "Du befindest Dich nun hinter dem Holzzaun inmitten der Obstplantagen "+
        "von Tijara. Die Erde hier ist saftig und weich, die pralle Sonne des "+
        "tiefen Sueden verleiht dem Obst eine unnachahmliche Farbe und die Fruechte"+
        " lachen Dich verlockend an. Ein leichter Wind blaest durch die Felder "+
        "und Du vergisst fast, dass Du hier unerlaubt eingedrungen bist.\n"));
  SetProp (P_INT_SHORT, "Auf der Obstplantage");

  AddDetail(({"plantage","plantagen","obstplantagen","obstplantage"}),
      "In diesem Bereich der Plantage baut man vor allem Papayastauden an.\n");
  AddDetail(({"stauden","staude","obststaude","obststauden"}),
      "Die Papayastauden lachen Dich mit ihren Fruechten an.\n");
  AddDetail(("sueden"),
      "Du befindest Dich tief im Sueden, oder hast Du das vergessen?\n");
  AddDetail(("obst"),
      "Auf den Plantagen von Tijara baut man Mango, Ananas, Bananen, Papayas "
      "und noch vieles mehr an...");
  AddDetail(({"feld","felder"}),
      "So weit Dein Auge nur reicht, nichts als Obst...\n");
  AddDetail(({"frucht","fruechte"}),
      "Die Fruechte haengen an den Obststauden und warten nur mehr auf die Ernte.\n");

  AddDetail(({"holzzaun","zaun"}),
      "Der Zaun liegt schon weiter im Westen entfernt.\n");
  AddDetail ( ("farbe"), "In vielen bunten Farben haengen sie an den Stauden.\n");
  AddDetail ("erde",
      "Die Erde ermoeglicht neben dem idealen Klima das ausgezeichnete"
      " Wachstum der Fruechte. In diesem Bereich der Plantage fallen Dir einige "
      "Erdhuegel besonders auf.");
  AddDetail(({"erdhuegel","huegel"}),
      "Du betrachtest due Erdhuegel etwas genauer und Dir faellt hinter einem "
      "ein grosses Loch im Boden auf.");
  AddDetail(("loch"),
      "Das Loch fuehrt direkt nach unten und wuerde gross genug fuer Dich sein...");
  AddDetail ( ({"wind", "blaetter"}),
      "Der Wind laesst die Blaetter hin und herwogen.\n");
  AddDetail( ({"sonne", "ernte", "ernten"}),
      "Die Sonne lacht vom Himmel. Sie laesst in diesen Breiten mehrere"
      " Ernten in einem Jahr zu.");
  AddDetail ("himmel", "Der Himmel erstrahlt in tiefstem Blau.\n");
  AddDetail ( ({"stadt", "tijara"}), "Du befindest Dich hier auf dem Grund des "+
      "Gouverneurs von Tijara.\n");


  AddDetail(("boden"),
      "Der Boden ist hier weich und saftig. Dir fallen einige Erdhuegel auf...");


  AddSpecialDetail (({"papayastaude","papayastauden"}), "d_staude");

  AddSmell( ({DEFAULT_SMELL,"fruechte"}),
      "Die Fruechte hier riechen einfach koestlich.\n");

  AddSound( ({DEFAULT_SOUND, "bienen"}),
      "Die Bienen summen ueber die Obstplantage.\n");

  AddExit( "westen", "./planta3");
  AddExit( "norden", "./planta5");
  AddItem(NPC"dobst", REFRESH_DESTRUCT);
  AddItem( ({NPC"dbiene", NPC"dkoli", NPC"dkakadu", SCHMETTERLING}) , 
      REFRESH_DESTRUCT);

  papaya = 4;

  AddCmd ( ({"stehle","stiehl","stehlen" }), "pflueck" );
  AddCmd( ({"kletter","klettere","steig","steige"}), "down");

}

reset()
{
  papaya = 4;
  ::reset();

}

string d_staude()
{
  if (papaya)                                                                                         
    return "Eine Papaya haengt im Moment ganz in Deiner Naehe. Du koenntest sie stehlen...\n";
  else return BS("Im Moment scheint keine Papaya in Deiner Reichweite zu sein. "+
      "Jedenfalls kannst Du hier im Moment keine stehlen.\n");
}



int pflueck(string str)
{
  object ob;
  notify_fail ("Was willst Du hier stehlen ?\n");
  if (!str) return 0;
  if (str!="papaya")  return 0;
  if (!papaya) 
  {
    notify_fail("Im Moment ist leider keine keine Papaya in Deiner Reichweite.\n");
    return 0;
  }

  write ("Du stiehlst eine koestliche Papaya und steckst sie sofort ein.\n");
  say (CAP(TPN)+
      (TP->QueryProp(P_GENDER) == MALE ? " der miese Dieb": " die miese Diebin")+
      " stiehlt eine koestliche Papaya.\n");
  CLONE(OBJ"dpapaya", TP);
  papaya--;
  if(ob=present("plantagenarbeiter") )
  {
    tell_room(TO,"Der Plantagenarbeiter schreit: HALTET DEN DIEB!\n");
    ob->Kill(TP);
  }
  return 1;
}

int down(string str)
{
  notify_fail("Wo willst Du hinein klettern ?\n");
  if ( !str ) return 0;
  if ( member ( ( {"in loch","nach unten","runter"}),str )!=-1)
  {
    write(" \n"
        "Du kletterst nach unten in das dunkle Loch.\n");
    TP->move("/d/dschungel/dante/erde/room/erde21", M_GO,
        "in das dunkle Loch nach unten","klettert", "kommt von oben herab geklettert");
    return 1;
  }
  return 0;
}

