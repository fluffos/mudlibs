//fippsiraum
//dantes eigentum

#include "/players/dante/myowndefine.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#define QUESTKEY "Fippsi, die verwirrte Maus"     


create()
{
  ::create();

  SetProp( P_INT_SHORT, "Mitten im Dschungel" );
  SetProp( P_INT_LONG, BS(
        "Du folgst dem kleinen Pfad und gelangst mitten ins wildeste Dickicht. "
        "Rings um Dich undurchdringbarer Dschungel, nur der Pfad gibt Dir einen "
        "Anhaltspunkt. Hier ist der Pflanzenwuchs besonders dicht, so dass man "
        "die naehere Umgebung ueberhaupt nicht mehr erkennen kann."));
  AddDetail(("umgebung"),
      "Da die Straeucher, Baeume und Farne hier so dicht wachsen, kannst Du nur "
      "wenige Meter in den Dschungel sehen.");
  AD("anhaltspunkt",
      "Der Pfad fuehrt nach Nordosten und endet hier. Im Westen scheinen die "
      "Straeucher aber nicht so dicht zu sein.");
  AD("westen",
      "Vielleicht kann man sich irgendwie durch die Straeucher im Westen zwaengen.");
  AddDetail(({"wuchs","pflanzenwuchs"}),
      "Die Pflanzen wachsen hier besonders ueppig und gedeihen praechtig.");
  AddDetail(({"pflanzen","pflanze"}),
      "Du erkennst Baeume, Farne, Straeucher,...");
  AddDetail(({"farn","farne"}),
      "Die Farne hier erreichen fast die Hoehe eines ausgewachsenen Elfen.");
  AD("boden",
      "Der Boden ist wild ueberwuchert und kaum zu erkennen. Doch, da scheint "
      "ein brauner Fleck durch.");
  AD("meter",
      "Der Dschungel wird hier nach wenigen Metern undurchdringlich.");
  AD("moment",
      "Closing down.\n"
      "% Connection closed by foreign host.\n"
      "LPmudQuoting\n"
      "---- No world ----\n");


  AD("fleck",
      "Der Fleck erweist sich als braune Erde, die umlaengst aufgegraben wurde.");
  AD("erde",
      "Die Erde sieht nicht besonders weich aus. Hmm, ohne Schaufel wird man "
      "hier kaum weit kommen.");
  AD("schaufel",
      "Eine Schaufel nuetzt Dir hier sicher.");
  AddDetail(("hoehe"),
      "Naja, recht hoch eben.");
  AddDetail(({"strauch","straeucher"}),
      "Die Straeucher kitzeln Dich ein wenig an der Nase.");
  AddDetail(("nase"),
      "Dir haengt ein wenig Rotz aus der Nase. Du solltest Dich besser schneuzen!");
  AddDetail("rotz",
      "IIHH, bist Du eklig!");
  AddDetail(({"elf","elfen","elfe"}),
      "Kennst Du doch, diese seltsamen Typen mit den langen Ohren!");
  AD(({"ohr","ohren"}),
      "Spitz!");
  AD(({"typ","typen"}),
      "Elfen sind seltsam! AUS!");
  AddDetail(({"baum","baeume", "naobab", "naobabs"}),
      "Hier wachsen vor allem Naobabs, die fuer ihre spitzen Stacheln bekannt sind.");
  AddDetail(({"bobaba","bobabas"}),
      "Der Bobaba ist eine Gummibaumart, die nur im Dschungel vorkommt. "
      "Hinter einem der Baeume faellt Dir ein vermoderter Baumstamm auf.");
  AddDetail(({"baumstamm","stamm"}),
      "Der Baumstamm ist umgefallen und vermodert langsam. Eine kleine Unke sitzt auf ihm...");
  AddDetail(("unke"),
      "Die Unke quakt und springt ueber etwas weiss-braeunlich schimmerndes hinweg.");
  AddDetail(("etwas"),
      "Hmm, das Etwas koennte ein Kraut sein, aber sicher bist Du Dir da nicht...");
  AddDetail(("kraut"),
      "Du solltest vielleicht probieren es zu bekommen.");
  AddDetail(({"gummibaum","gummibaumart","art"}),
      "Aus ihnen stellen fleissige Bauern Kaugummi her.");
  AddDetail(({"bauer","bauern"}),
      "Sie bewirtschaften grosse bobabaplantagen.");
  AddDetail(({"plantagen","bobabaplantagen","plantage"}),
      "Hier wachsen die Bobabas allerdings wild.");
  AD("pfad",
      "Der Pfad verliert sich hier. Er kommt aus Nordosten.");
  AD("nordosten",
      "Der Pfad fuehrt nach Nordosten.");
  AD("himmel",
      "Der Himmel ist wegen der vielen, dichten Pflanzen kaum zu erkennen.");
  //AD("meter",

  AddDetail("kaugummi",
      "Einen Kaugummi haettest Du im Moment sehr gerne...");
  AddDetail(({"stachel","stacheln"}),
      "Pass bloss auf, dass Du ihnen nicht zu nahe kommst!");
  AddDetail(("dickicht"),
      "Wild wuchern die Pflanzen hier...\n");  
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25, ENV_TERRAIN:TT_JUNGLE]) );

  AddDetail(({"sonne","licht"}),
      "Die Sonne strahlt hier unbarmherzig herab, wird jedoch durch den leichten\n"
      "Wind ertraeglicher gemacht.\n");
  AddDetail(("wind"),                                                            
      "Hier weht eine leichte Brise, die Dich angenehm kuehlt.\n");
  AddDetail(("dschungel"),
      "Du siehst den Dschungel vor lauter Pflanzen nicht.\n");
  AddDetail(("vegetation"),
      "Die Vegetation ist hier ueppig und dicht.\n");
  AddDetail(({"blatt","blaetter"}),
      "Die Blaetter rauschen in der leichten Brise.\n");

  AddSound( DEFAULT_SOUND,
      "Du hoerst den Wind rauschen...");
  AddSound("wind",
      "Rausch rausch...");
  AddSmell( DEFAULT_SMELL,
      "Hmm, es riecht nach Kraeutern!");
  AddSmell(({"kraut","kraeuter"}), 
      "Hmm, wo sind die bloss.\n");


  AddCmd(({"pflueck","pfluecke"}), "pfluecken");  
  ACD(({"grab","grabe"}), "get");
  ACD(({"zwaenge","zwaeng"}), "go");  
  AIT("/d/dschungel/dante/weg/npc/qmaus", REFRESH_DESTRUCT);

  AddExit( "nordosten", "./schlamm");
}

int go(string str)   {
  NF("Wo willst Du Dich durchzwaengen? Etwa durch die Straeucher?!\n");

  if(!str) { return 0; }


  if(str=="durch straeucher"||str=="durch straeucher im westen"||
      str=="durch strauch im westen" ||str=="nach westen durch straeucher"||
      str=="durch strauch")  {

    write("Du zwaengst Dich durch die Straeucher im Westen\n");
    TP->move("/d/dschungel/dante/weg/room/fip2", M_GO,
        "im Dschungel", "verschwindet", "kommt herein gekrochen");
    return 1;  
  }
  return 0; 
}



int get(string str)  {
  object ob;


  NF("Wo willst Du hier graben? Und womit? Ohne Schaufel wird das nichts!?\n"
      "syntax <grabe mit schaufel in erde>!\n");


  if(!str)  { write(BS(
        "Du kannst hier nur mit einer Schaufel graben und nur dann wenn Du "
        "Dich bereits eingehend mit Fippsi unterhalten hast!")); return 1; 
  }



  if(member(({"mit schaufel in erde",
          "mit schaufel bei fleck",
          "erde mit schaufel um",
          "in erde mit schaufel",
          "in erde", "erde um",
          "mit schaufel in fleck"}),str)!=-1)  {


    if(!present("schaufel", TP)) { //irgendeine egal welche
      write("Du graebst mit blossen Haenden, doch das ist sinnlos.\n"
          "Nebenbei bemerkt, Du hast gar keine Schaufel!\n");
      return 1;  
    }

    if(!present("\nfippsiobj", TP)) {
      write("Du graebst mit der Schaufel in der Erde herum.\n"
          "Doch noch kannst Du hier nichts finden. Du musst zuerst mit Fippsi reden.\n"
          "Frag ihn mal nach Drache...\n");


      return 1; 
    }


    if(!present("\nfippsigegeben", TP))  {
      write("Du graebst mit der Schaufel in der Erde herum.\n"
          "Doch finden kannst Du hier noch nichts! Noch nicht, vielleicht musst \n"
          "Du bevor Du graben kannst etwas anderes machen. Zum Beispiel Fippsi \n"
          "irgendetwas geben. Wie waers mit einem Kraut?!\n");
      return 1; 
    }


    if(deep_present("\nfippsispiegel", TP))  {
      write("Aber Du hast doch bereits einen Spiegel der Wahrheit!\n");
      return 1;
    }

    if(TP->QueryQuest(QUESTKEY))  {
      write("Fein, dass Du diese Quest noch einmal spielen willst!\n");
      return 1;
    }
    else   {
      write(BS("Du graebst mit der Schaufel in der Erde und findest "
            "einen alten Spiegel."));
      ob=clone_object("d/dschungel/dante/weg/obj/fippsispiegel");
      ob->move(TP, M_NOCHECK);
      return 1;
    }
    return 0;
  }
  return 0;
}



int pfluecken (string str)
{
  object ob;
  notify_fail("Was willst Du hier pfluecken ?\n");
  if(str=="kraut"||str=="daemonenkraut")  {
    write(BS("Du versuchst ein Daemonenkraut zu pfluecken, doch gerade als "
          "Du es nehmen willst, kommt ein kleiner Daemon und reisst es Dir aus der "
          "Hand. Dann grinst er und haut wieder ab. "
          "Vergiss es, hier ist scheinbar nicht die richtige Stelle fuer Dich! "
          "Probiers mal woanders, ganz in der Naehe!!!"));

    say(BS(CAP_TPN+" versucht ein Daemonenkraut zu pfluecken. Ein kleiner Daemon "
          "kommt aber "+TPN+" zuvor. Tja, das ist Pech!"));
    return 1;  
  }
  return 0;  
}

