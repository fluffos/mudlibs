// suedlcih von tijara
/*


   weg nach suedunten eingebaut fuer charons quest
   dante 99
   */






#include "files.h"

inherit "std/room";
#include <moving.h>
#include <properties.h>
#include <language.h>

nosave int heilen;

create()
{ 
  ::create();
  SetProp( P_INT_SHORT, "Auf dem Dschungelpfad" );
  SetProp( P_INT_LONG, BS(
        "Der Weg fuehrt Richtung Osten am Abgrund der Schlucht entlang. "
        "In der Tiefe rauscht der Fluss dahin, im Norden dichtester Dschungel. "
        "Die Vegetation ist hier sehr ueppig, besonders auffallend sind hohe "
        "Palmen, mit grossen runden Kokosnuessen. Im Sueden fuehrt "
        "eine sehr kleine Spur steil bergab!"));

  AddDetail("ufer",
      "Du bist an einem Ufer. Am anderen Ufer hingegen ist etwas viel Besseres!");
  AddDetail("besseres",
      "Du glaubst ein Dorf zu erkennen, aber Du musst wohl nach suedunten gehen!");
  AddDetail("dorf",
      "Koennten das etwa Kannibalen sein?!");
  AddDetail(({"kannibalen", "kannibale"}),
      "So genau kann man das von hier nicht sagen...");

  AddDetail( ({"vegetation"}),
      "Die Vegetation ist hier sehr ueppig, besonders auffallend sind hohe "
      "Palmen, mit grossen runden Kokosnuessen.");
  AddDetail("spur", 
      "Die Spur fuehrt steil nach unten! Man kann ihr sicher folgen, ohne "
      "sofort abzustuerzen!");
  AddDetail("sueden",
      "Im Sueden liegt eine steile Spur, die nach unten zum Fluss fuehrt. "
      "Dahinter liegt der Fluss und dann das Ufer!");


  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_JUNGLE]) );
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);

  AddSound(DEFAULT_SOUND,
      "Der Wasserfall ist auch hier noch recht laut zu hoeren.");
  AddSmell(DEFAULT_SMELL,
      "Du riechst das frische, saubere Wasser des Rio de la Puseta.");
  AddDetail(("boden"),
      "Der Boden ist ausgetrocknet durch die heisse Sonne.");
  AddDetail(("sonne"),
      "Die Sonne scheint hier fast immer...");
  AddDetail(("himmel"),
      "Hoch oben am Himmel steht die Sonne und scheint die Natur fast zu verbrennen.");
  AddDetail(("natur"),
      "Die Natur um Dich ist trotzdem ueppig und voller Leben.");
  AddDetail(("norden"),
      "Im Norden ist der Dschungel sehr dicht und ueppig.");
  AddDetail(("dschungel"),
      "Der Dschungel scheint hier uneindringbar zu sein. Die hohen Palmen "
      "gefallen Dir besonders gut.");
  AddDetail(("baum"),
      "Baeume gibt es im Dschungel viele...");
  AddDetail(({"palme","palmen"}),
      "Die Palmen wachsen hier besonders hoch. Sie tragen runde, grosse Kokosnuesse, "
      "haben gewaltige Palmblaetter und spenden herrlichen Schatten. Weiter im "
      "Nordosten faellt Dir eine besonders grosse Palme auf.");
  AddDetail(("nordosten"),
      "Der Weg fuehrt weiter nach Nordosten, wo er an einer grossen Palme endet.");
  AddDetail(("schatten"),
      "Der Schatten ist Dir bei dieser Hitze sehr willkommen. Vielleicht wuerde "
      "es Dir gut tun, wenn Du Dich kurz in den Schatten legst...");
  AddDetail(({"palmblaetter","blaetter"}),
      "Die Palmblaetter sind riesengross...");
  AddDetail(({"kokosnuesse","kokosnuss"}),
      "Du wuerdest gerne eine pfluecken, aber hier sind keine fuer Dich zu erreichen.");
  AddDetail(("nuss","nuesse"),
      "Du meinst doch sicher Kokosnuesse...");
  AddDetail(("weg"),
      "Der Weg fuehrt leicht abwaerts gen Osten immer sehr nahe an der Schlucht entlang.");
  AddDetail(("osten"),
      "Der Weg fuehrt hier Richtung Osten weiter...");
  AddDetail(("richtung"),
      "Die Schlucht verlaeuft hier in Ost-West Richtung.");
  AddDetail(("westen"),
      "Im Westen liegt der Pfad und noch weiter im Westen der Wasserfall.");
  AddDetail(("wasserfall"),
      "Der Wasserfall ist von hier kaum mehr zu erkennen.");
  AddDetail(("pfad"),
      "Der Pfad liegt weiter im Westen");
  AddDetail(("schlucht"),
      "Du stehst hier gefaehrlich nahe am Rand der Schlucht.");
  AddDetail(("rand"),
      "Der Rand der Schlucht ist nur wenige Meter von Dir entfernt. "
      "In ihrer Tiefe rauscht ein grosser Fluss dahin.");
  AddDetail(("tiefe"),
      "Viele Meter wuerdest Du hier abstuerzen.");
  AddDetail(("meter"),
      "Kennst Du das Pariser Urmeter ?");
  AddDetail(("urmeter"),
      "Ich bin kein Lexikon...");
  AddDetail(("fluss"),
      "Der Fluss ist der beruehmte Rio de la Puseta, der bekannt ist fuer sein "
      "smaragdgruenes Wasser.");
  AddDetail(("wasser"),
      "Gruen und klar stroemt es in der Tiefe dahin.");
  AddDetail(({"rio","puseta","rio de la puseta"}),
      "Woher dieser Name wohl stammt...");
  AddDetail(("name"),
      "Einen Tip gebe ich: Es ist nicht Spanisch...");

  AddExit("nordosten", "./weg14");
  AddExit("westen", "./weg12");
  AddExit("suedunten", "./down1");

  AddItem( ({NPC"dschimp", NPC"dpavian", NPC"dschlange", NPC"dratte"})  , REFRESH_DESTRUCT);

  heilen = 1;


  AddCmd(({"lieg","lege", "liege"}), "liegen");
}
/*
   nix()   {
   write("Du schaffst es nicht nach suedunten zu gehen! Geduld bitte!\n");
   return 1; }
   */









reset()
{
  heilen = 1;
  ::reset();
}

liegen (string str)
{
  notify_fail("Wo willst Du Dich hinlegen ?\n");
  if ( str != "in schatten")
  {
    write(""); 
    return 0;
  }

  if ( !heilen )
  {
    write ( " \n"+BS(
          "Du legst Dich fuer kurze Zeit im Schatten der Palmen nieder, stehst aber bald "
          "wieder auf, weil der Boden doch sehr hart ist.\n"));

    say(BS(TPN+" legt sich im Schatten der Palmen kurz nieder, steht aber bald "
          "wieder auf, weil "+TPN+" der Boden zu hart ist.\n"));
    return 1;
  }

  if (str =="in schatten")
  {
    write(" \n"+BS(
          "Du legst Dich fuer kurze Zeit in den Schatten der Palmen und stehst "
          "nach kurzer Zeit frisch und erholt wieder auf.\n"));
    say(BS(TPN+" legt sich in den Schatten der Palmen und steht nach kurzer Zeit "
          "froehlich und erholt wieder auf.\n"));
    TP->heal_self(90+random(20));
    heilen--;
    return 1;
  }
  return 0;
}


