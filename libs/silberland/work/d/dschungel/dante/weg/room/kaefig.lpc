//kaefig fuer sabbergnom

#include "/players/dante/myowndefine.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#define QUESTKEY "Der hungrige Dschungelwaechter"     
#include "wizlevels.h"

int heilen=3;

init()  {
::init();
if(!interactive(TP))  { return ; }

if(IS_WIZARD(TP)) {return;  }

if (!TP->QueryQuest(QUESTKEY))  {
write("He! Was willst Du da!\n");
TPM("/d/dschungel/dante/weg/room/weg1", M_TPORT);
     } }
      


create()
{
  ::create();

  SetProp( P_INT_SHORT, "In einem angesabberten Kaefig" );
  SetProp( P_INT_LONG, BS(
  "Der Kaefig ist auch innen aus reinem Metall. Nur sieht man von dem "
  "Metall nicht mehr allzuviel, weil der Sabbergnom alles angesabbert hat. "
  "Der Sabber ist wirklich ueberall, eklig. Eine schwere Kette ist an "
  "der Wand angebracht."));
  AD("kette",
  "An dieser Kette ist sonst der Sabbergnom angebunden.");
AD(({"gnom","sabbergnom"}),
"Der Sabbergnom ist wohl nicht da.");
  
  AD("kaefig",
  "Da bist Du gerade. Im total angesabberten Kaefig.");
  AD("metall",
  "Das Metall war einmal total sauber. Nun ist es nur mehr angesabbert.");
  AD("sabber",
  "Der Sabber ist ueberall. Er ist am Boden, er tropft von der Decke, er "
  "rinnt von den Waenden. Sogar in den Ecken ist er...");
  AD("boden",
  "Der Boden ist ueber und ueber mit Sabber bedeckt.");
  AD("decke",
  "Der Sabber rinnt und tropft langsam von der Decke herab.");
  AD(({"wand","waende"}),
  "Die Waende sind voller Sabber. Er rinnt langsam herab. An einer der "
  "Waende ist eine Tuere.");
  AD(({"tuer","tuere"}),
  "Die Tuere fuehrt nach draussen. Mit <raus> kommst Du da hin.");
  AD(({"ecke","eck","ecken"}),
  "In der Ecke sammelt sich viel Sabber. Eklig waer es, wenn man sich darin "
  "waelzen wuerde.");
  AD("himmel",
   "Gibt es net.");
   
  
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25, ENV_TERRAIN:TT_CAVE]) );
  
  
  AddSound( DEFAULT_SOUND,
    "Du hoerst den Sabber fliessen.");
  AddSmell( DEFAULT_SMELL,
  "Hmm, es riecht nach Sabber!");
    
AIT("/d/dschungel/dante/weg/npc/sabbergnom", REFRESH_DESTRUCT);
  ACD(({"waelz","waelze"}), "get");
  AddExit( "raus", "./weg1");
}
 int get(string str)  {
 NF("Wo willst Du Dich waelzen? Worin?\n");
  if(str=="in sabber"||str=="im sabber")   {
  if(heilen)  {
  say(CAP_TPN+" waelzt sich im Sabber! SCHWEIN!!!\n");
  write("Du waelzt Dich im Sabber und findest das soooo gut!\n");
  TP->heal_self(25+random(25));
  heilen--;
 return 1; }
 else   {
 write("Du waelzt Dich im Sabber, Du Schwein!\n");
 say(CAP_TPN+" waelzt sich im Sabber.\n");
 return 1; }
 return 0;  }
 return 0; }
 
 reset()  {
 ::reset();
 heilen=3;  }
   