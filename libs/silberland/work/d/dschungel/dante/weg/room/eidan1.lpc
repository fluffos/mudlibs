
#include "/players/dante/myowndefine.h"
inherit "std/room";
#include <properties.h>
#include <language.h>
#include <moving.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einer kleinen Insel mitten im Fluss" );
  SetProp( P_INT_LONG, BS(
  "Du bist nun auf einer sehr kleinen Insel mitten auf dem grossen "
  "Fluss gelandet. Hier sieht es sehr friedlich und ruhig aus, fast "
  "wie im Paradies. Wunderschoene Blumen schillern in bunten Farben, "
  "frisches, kristallklares Wasser sprudelt aus einem kleinen Felsen "
  "hervor. Gruenes Gras ueberzieht die ganze Insel wie ein dichter "
  "Teppich, der wie geschaffen dafuer ist sich hier kurz auszuruhen. "
  "Die Insel reicht von hier aus auch noch nach Norden. "
  "Im Sueden erkennst Du ein Gebaeude. "
  "Im Nordwesten liegt ein gestrandetes Schiff am Ufer."));

  AD("schiff",
      "Es ist hier gestrandet.");
  AD("gebaeude",
  "Sieht merkwuerdig aus....");
  
  AD("bruecke",
  "Leicht gebogen wird sie Dich sicher ueber das Wasser fuehren.");
  
AD("norden",
"Geh hin!");
AD("teppich",
"Du fuehlst Dich wirklich wohl hier.");
AD("floss",
"Du kannst das kleine Floss im Norden besteigen.");
AD("boden",
"Der Boden wird von dichtem Gras gebildet.");
AD("himmel",
"Der Himmel ist strahlendblau.");
AD("ufer",
"Die Ufer gleiten sanft in das Wasser und verschwinden im Fluss.");
AD("ort",
"Du willst fuer immer hier bleiben.");
AD("mitte",
"In der Mitte sieht man eine kleine, weisse Wolke dahinschweben.");
AD("wolke",
"Was fuer ein magischer Ort! Die Wolke sieht so freundlich und friedlich aus! ");
AD(({"blume","blumen"}),
"Die Blumen leuchten in vielen Farben.");
AD("farben",
"Es sind mehr als Du bisher kanntest.");
AD("gras",
"Das Gras ist herrlich gruen und saftig.");
AD("fluss",
"Der Fluss fliesst hier eher ruhig vorbei. Das Wasser ist frisch und klar.");
AD("wasser",
"Klares Wasser sprudelt aus dem Felsen hervor und fliesst in den grossen "
"Fluss.");
AD("felsen",
"Er ruht inmitten des gruenen Grases.");
AD("paradies",
"Friedlich und ruhig kann man hier verweilen.");
AD("insel",
"Diese kleine Insel scheint ein friedliches Paradies inmitten einer "
"rauhen Welt zu sein.");
AD("welt",
"Sie steckt voller Gefahren.");
AD(({"gefahr","gefahren"}),
"Hier lauert keine auf Dich.");
AD("inseln",
"Schau sie Dir an!");

  
  
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN:TT_JUNGLE]) );

  AddSound( DEFAULT_SOUND,
    "Du hoerst das Rauschen des Wassers.");
    
    AddSound(({"wasser","rauschen"}),
    "Es wirkt sehr beruhigend.");
  AddSmell( DEFAULT_SMELL,
    "AHH! Hier riecht man die pure Natur!");
AddSmell("natur",
"Frisch und gesund.");

 AE("norden", "./cherub1");
  
}

  	
