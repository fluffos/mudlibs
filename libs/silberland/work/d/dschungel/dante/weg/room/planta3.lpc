/*
 ** plantage mit ananas
 ** dante 97 feb 
 ** 
 */

inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>
#include "files.h"
inherit ROOM "planta_inh.lpc";


create()
{
  room::create();
  planta_inh::create();
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:30, ENV_TERRAIN:TT_JUNGLE]));
  SetProp (P_INT_LONG, BS(
        "Du befindest Dich nun hinter dem Holzzaun inmitten der Obstplantagen "+
        "von Tijara. Die Erde hier ist saftig und weich, die pralle Sonne des "+
        "tiefen Sueden verleiht dem Obst eine unnachahmliche Farbe und die Fruechte"+
        " lachen Dich verlockend an. Ein leichter Wind blaest durch die Felder "+
        "und Du vergisst fast, dass Du hier unerlaubt eingedrungen bist.\n"));
  SetProp (P_INT_SHORT, "Auf der Obstplantage");

  AddDetail(({"plantage","plantagen","obstplantagen","obstplantage"}),
      "In diesem Bereich der Plantage baut man vor allem Papayastauden an.\n");
  AddDetail(({"stauden","staude","papayastaude","papayastauden",
        "obststaude", "obststauden"}),
      "Die Papayastauden lachen Dich mit ihren koestlichen Fruechten nur so an.\n");
  AddDetail(("papaya"),
      "Tja, leider kannst Du hier keine erblicken.\n");
  AddDetail(("sueden"),
      "Du befindest Dich tief im Sueden, oder hast Du das vergessen?\n");
  AddDetail(("obst"),
      "Auf den Plantagen von Tijara baut man Mango, Ananas, Bananen, Papayas "
      "und noch hier, aber nur hier auch die Brotfrucht!!!");
  AddDetail(({"brotfrucht","frucht"}),
      "Die Brotfrucht hat die Form von Laiben und schmeckt wie Brot, angeblich "
      "sogar besser.");
  AddDetail("brot",
      "Das haengt am Brotfruchtbaum!");
  AddDetail(({"form","laib", "laibe"}),
      "Rund, oval, und recht gross.");
  AddDetail(({"brotfruchtbaum"}),
      "Hier steht der einzige weit und breit!\n");

  AddDetail(({"feld","felder"}),
      "So weit Dein Auge reicht, nichts als Obst...\n");
  AddDetail(({"frucht","fruechte"}),
      "Die Fruechte haengen an den Obststauden und warten nur mehr auf die Ernte.\n");

  AddDetail(("boden"),
      "Der Boden ist gruen und saftig. Ein grosser Laubhaufen faellt Dir auf.");
  AddDetail("haufen",
      "Du meinst den Laubhaufen...");
  AddDetail("laubhaufen",
      "Der Laubhaufen wurde ordentlich hier zusammengerecht. Er sieht so aus, "
      "als wenn ab und zu etwas von oben mitten in den Haufen faellt.");
  AddDetail("laub",
      "Das Laub wurde hier ordentlich zusammengeputzt.");

  AddDetail(({"holzzaun","zaun"}),
      "Der Zaun ist hier sehr hoch. Da kommst Du nie drueber.\n");

  AddDetail ( ("farbe"), "In vielen bunten Farben haengen sie an den Stauden.\n");
  AddDetail ("erde",
      "Die Erde ermoeglicht neben dem idealen Klima das ausgezeichnete"
      " Wachstum der Fruechte."); 
  AddDetail ( ({"wind", "blaetter"}),
      "Der Wind laesst die Blaetter hin und herwogen.\n");
  AddDetail (({"sonne", "ernte", "ernten"}),
      "Die Sonne lacht vom Himmel. Sie laesst in diesen Breiten mehrere"
      " Ernten in einem Jahr zu.");
  AddDetail ("himmel",
      "Der Himmel erstrahlt in tiefstem Blau. Nur eine kleine Wolke ist zu erkennen.");
  AddDetail("wolke",
      "Die Wolke scheint sehr nahe zu sein...");
  AddDetail ( ({"stadt", "tijara"}), "Du befindest Dich hier auf dem Grund des "+
      "Gouverneurs von Tijara.\n");


  AddSmell( ({DEFAULT_SMELL,"fruechte"}),
      "Die Fruechte hier riechen einfach koestlich.\n");

  AddSound( ({DEFAULT_SOUND, "bienen"}),
      "Die Bienen summen ueber die Obstplantage.\n");

  AddExit( "osten", "./planta6");
  AddExit( "norden", "./planta2");

  AddItem( ({NPC"dkakadu", NPC "dbiene", SCHMETTERLING}) , REFRESH_DESTRUCT);
  AddCmd(({"pflueck", "pfluecke"}), "get_bread"); 
}


int get_bread(string str)
{
  object ob;
  notify_fail("Was willst Du hier pfluecken!?\n");
  if(str=="brot"||str=="brotfrucht")
  {

    if(!present("ESSEN", TP))
    {
      write("Du bist viel zu klein...\n");
      return 1;
    }

    if(deep_present("brotfrucht", TP))
    {
      write("Du hast doch schon ein Brot! Gierhals!\n");
      return 1;
    }

    else


    {
      write("Du pflueckst Dir eine Brotfrucht!\n");
      ob=clone_object("d/dschungel/dante/weg/obj/brot");
      ob->move(TP, M_NOCHECK);
      return 1;
    }
    return 0;
  }
  return 0;
}

