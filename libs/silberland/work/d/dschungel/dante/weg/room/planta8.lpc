/*
 ** plantage mit passionsfrucht
 ** dante 97 feb 
 ** 
 */

inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>

#include "files.h"
inherit ROOM "planta_inh.lpc";

nosave int passionsfrucht;

create()
{  
  room::create();
  planta_inh::create();     
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:30, ENV_TERRAIN:TT_JUNGLE]));
  SetProp (P_INT_LONG, BS(
        "Du befindest Dich nun hinter dem Holzzaun inmitten der Obstplantagen "+
        "von Tijara. Die Erde hier ist saftig und weich, die pralle Sonne des "+
        "tiefen Sueden verleiht dem Obst eine unnachahmliche Farbe und die Fruechte"+
        " lachen Dich verlockend an. Ein leichter Wind blaest durch die Felder "+
        "und Du vergisst fast, dass Du hier unerlaubt eingedrungen bist.\n"));
  SetProp (P_INT_SHORT, "Auf der Obstplantage");

  AddDetail(({"plantage","plantagen","obstplantagen","obstplantage"}),
      "In diesem Bereich der Plantage baut man vor allem Passionsfruchtstauden an.\n");
  AddDetail(({"stauden","staude","obststauden","obststaude"}),
      "Eine grosse Menge von Passionsfruchtstauden waechst und reift hier.\n");
  AddDetail(("sueden"),
      "Du befindest Dich tief im Sueden, oder hast Du das vergessen ?\n");
  AddDetail(("obst"),
      "Auf den Plantagen von Tijara baut man Mango, Ananas, Bananen, Papayas "
      "und noch vieles mehr an...");
  AddDetail(({"feld","felder"}),
      "So weit Dein Auge nur reicht, nichts als Obst...\n");
  AddDetail(({"frucht","fruechte"}),
      "Die Fruechte haengen an den Obststauden und warten nur mehr auf die Ernte.\n");

  AddDetail(("boden"),
      "Der Boden ist sehr saftig.");

  AddDetail(({"holzzaun","zaun"}),
      "Der Zaun ist hier besonders hoch. Du siehst keine Moeglichkeit hier drueber zu "
      "kommen...");
  AddDetail ( ("farbe"), "In vielen bunten Farben haengen sie an den Stauden.\n");
  AddDetail ("erde",
      "Die Erde ermoeglicht neben dem idealen Klima das ausgezeichnete"
      " Wachstum der Fruechte.");
  AddDetail ( ({"wind", "blaetter"}),
      "Der Wind laesst die Blaetter hin und herwogen.\n");
  AddDetail ( ({"sonne", "ernte", "ernten"}),
      "Die Sonne lacht vom Himmel. Sie laesst in diesen Breiten mehrere"
      " Ernten in einem Jahr zu.");
  AddDetail ("himmel", "Der Himmel erstrahlt in tiefstem Blau.\n");
  AddDetail ( ({"stadt", "tijara"}), "Du befindest Dich hier auf dem Grund des "+
      "Gouverneurs von Tijara.\n");

  AddSpecialDetail (({"passionsfruchtstauden","passionsfruchtstaude"}), "d_staude");

  AddSmell( ({DEFAULT_SMELL,"fruechte"}),
      "Die Fruechte hier riechen einfach koestlich.\n");

  AddSound( ({DEFAULT_SOUND, "bienen"}),
      "Die Bienen summen ueber die Obstplantage.\n");

  AddExit( "norden", "./planta9");
  AddExit( "westen", "./planta11");
  AddExit( "sueden", "./planta7");

  AddItem( ({NPC"dkoli", NPC"dmoskito", NPC"dbiene"}) , REFRESH_DESTRUCT);

  passionsfrucht = 2;
  AddCmd ( ({"stehle","stiehl","stehlen" }), "pflueck" );
}

reset()
{
  ::reset();
  passionsfrucht=2;
}

string d_staude()
{
  if (passionsfrucht)                                                                                         
    return "Eine Passionsfrucht haengt im Moment ganz in Deiner Naehe. Du koenntest sie stehlen...\n";
  else return BS("Im Moment scheint keine Passionsfrucht in Deiner Reichweite zu sein. "+
      "Jedenfalls kannst Du hier im Moment keine stehlen.\n");
}



int pflueck(string str)
{
  object ob;
  notify_fail ("Was willst Du hier stehlen?\n");
  if (!str) return 0;
  if (str!="passionsfrucht")  return 0;
  if (!passionsfrucht) 
  { 
    notify_fail("Im Moment is leider keine Passionsfrucht in Deiner Reichweite.\n");
    return 0;
  }


  write ("Du stiehlst eine koestliche Passionsfrucht und steckst sie sofort ein.\n");
  say (CAP(TPN)+
      (TP->QueryProp(P_GENDER)== MALE ? " der miese Dieb": " die miese Diebin")+
      " stiehlt eine koestliche Passionsfrucht.\n");
  CLONE(OBJ"dfpas", TP);
  passionsfrucht--;
  if(ob=present("plantagenarbeiter") )
  {
    tell_room(TO,"Der Plantagenarbeiter schreit: HALTET DEN DIEB!\n");
    ob->Kill(TP);
  }
  return 1;
}

