// 27-10-96  tante dante@SilberLand

#include "../def.h"

inherit "std/room";
#include <moving.h>
#include <properties.h>
#include <language.h>
#include <mnpc.h>


void create()
{
  ::create();

  SetProp( P_INT_SHORT, "In einem kleinen Tuempel" );
  SetProp( P_INT_LONG, BS(
        "Du schwimmst mitten in einem kleinen Tuempel. Das Wasser ist gruen und "
        "voller Algen. Ab und zu steigen kleine Blaeschen an die Oberflaeche. "
        "Ringsum den Tuempel kannst Du einen kleinen Schilfguertel erkennen, "
        "dahinter beginnt der dichte Dschungel."));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,
      ([ENV_TEMPERATURE: 30,ENV_TERRAIN:TT_UNDERWATER, ENV_WATER:200]) );
  AddDetail(({"pflanze","pflanzen"}),
      "Du kennst keine einzige der Pflanzen, die hier wachsen.");
  AddDetail(("algen"),
      "Die Algen treiben im Wasser hin und her und verleihen dem Wasser "
      "seine gruene Farbe.");
  AddDetail(("farbe"),
      "Die Farbe des Wassers ist gruen.");
  AddDetail(({"schilfguertel","guertel"}),
      "Ringsum den kleinen Tuempel sieht man das mit Schilf bewachsene Ufer.");
  AddDetail(("ufer"),
      "Zum Ufer kannst Du schwimmen.");
  AddDetail(("schilf"),
      "Die Halme wogen im Wind hin und her.");
  AddDetail(({"halme","halm"}),
      "Duenne, gelbe Halme.");
  AddDetail(("wind"),
      "Der Wind blaest leicht ueber den Tuempel und macht so die Sonne ertraeglicher.");
  AddDetail(("sonne"),
      "Die Sonne lacht Dich vom Himmel herab an.");
  AddDetail(("himmel"),
      "Strahlendblau ist er heute wieder einmal...");
  AddDetail(("blaeschen"),
      "BLOBB machen sie wenn sie an der Oberflaeche zerplatzen.");
  AddDetail(("wasser"),
      "Das Wasser ist gruen und voller Algen. Man kann den Grund des Tuempels nicht "
      "mehr erkennen.");
  AddDetail(({"grund", "boden"}),
      "Der Grund ist von der Oberflaeche nicht zu sehen, aber Du kannst ja mal "
      "tauchen...");
  AddDetail(("oberflaeche"),
      "Durch Deine ungeschickten Paddelbewegungen ist das Wasser sehr unruhig.");
  AddDetail(({"bewegungen","bewegung","paddelbewegung","paddelbewegungen"}),
      "PLANTSCH!!! PLANTSCH!!!");
  AddDetail( ({ "tuempel" }),
      "Der Tuempel befindet sich mitten im dichten Dschungel und ist ein "
      "eigener kleiner Mikrokosmos.");
  AddDetail(("mikrokosmos"),
      "Hier kann man Tiere und Pflanzen finden, die sonst nirgends im Dschungel "
      "zu finden sind.");
  AddDetail(({"tiere"}),
      "Eine Libelle schwirrt gerde an Deinem Kopf vorueber, ein Molch taucht "
      "erschreckt unter...");
  AddDetail(("libelle"),
      "Die Libelle erinnert Dich an einen Helikopter.");
  AddDetail(("molch"),
      "PLATSCH!!! Schon ist er im Wasser verschwunden.");
  AddDetail(("dschungel"),
      "Wegen der feuchten Erde ist der Dschungel hier besonders ueppig.");
  AddDetail(("erde"),
      "Die kannst Du vom Wasser aus nicht sehen.");
  AddSound( DEFAULT_SOUND,
      "Das Wasser plaetschert sanft dahin.");

  AddSmell( DEFAULT_SMELL,
      "Das Wasser riecht modrig.");

  AddCmd( ({ "tauche","tauch" }), "tauchen" );
  AddCmd(({"schwimme","schwimm"}), "schwimmen");

  AddItem( ({NPC"dmoskito", NPC"dstechmuecke"}) , REFRESH_DESTRUCT);
  AddItem(NPC"kfisch", REFRESH_DESTRUCT);
}

int tauchen(string str )
{
  notify_fail( "Wohin willst Du tauchen ?\n" );
  if ( !str ) return 0;
  if ( member( ({"unter","runter","in wasser","in tuempel","nach unten"}),str) !=-1 )
  {
    write( " \n"
        "Du holst tief Luft und tauchst in das gruene Wasser nach unten.\n");
    TP->move(ROOM "tuempel3", M_GO,
        "tief Luft und taucht unter","holt", "kommt von oben herab getaucht");
    return 1;
  }
  return 0;
}

int schwimmen(string str )
{
  notify_fail( "Wohin willst Du schwimmen ?\n" );
  if ( !str ) return 0;
  if ( member( ({"an land", "an ufer","zu ufer","zum ufer","ufer", 
          "ans ufer", "an das ufer"}), str) !=-1 )
  {
    write( " \n"
        "Du schwimmst ans Ufer und steigst aus dem Wasser.\n");
    TP->move(ROOM "tuempel1", M_GO,
        "ans Ufer und steigt aus dem Wasser", "schwimmt", 
        "kommt ans Ufer geschwommen und steigt aus dem Wasser");
    return 1;
  }
  return 0;
}
