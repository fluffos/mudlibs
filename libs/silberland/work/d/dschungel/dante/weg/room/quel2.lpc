mag_test()  {
  int x;
  object *envs;

  int count;
  envs=all_inventory(TO);
  x=0;


  write(BS(
        "Du ueberpruefst die Quelle nach unsichtbaren Magiern und spritzt mit Wasser herum!"));
  say(BS(
        CAP_TPN+" ueberprueft die Quelle nach unsichtbaren Magiern und spritzt mit Wasser um sich!"));

  if(!sizeof(envs))  {
    write (BS("Nichts und gar nichts ausser Dir hier!"));
    return 1;
  }

  for(count=0; count<sizeof(envs); count++)

    if( living(envs[count]) && envs[count]->QueryProp(P_INVIS)) {

      x++;
      say(BS(
            CAP(getuid(envs[count]))+" wird vom Wasser getroffen !!!"));  
      write (BS(
            CAP(getuid(envs[count]))+" wird vom Wasser getroffen!!!"));  
    }


  if(x==0)  {
    write( BS(
          "Kein unsichtbarer Magier hier!"));  
  }   

  return 1; 
}

