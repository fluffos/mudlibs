//dante sl 99

inherit "std/room";

#include <properties.h>
#include <wizlevels.h>
#include "/players/dante/myowndefine.h"
#define PlayerGender this_player()->QueryProp(P_GENDER)
#include <moving.h>

int temp=20+random(21);


reset()  {
  ::reset();
  temp=20+random(20);

  tell_room( "/d/dschungel/dante/weg/room/quel2.lpc",
      "Die Wassertemperatur scheint sich zu veraendern.\n");
}

init()  {
  ::init();

  if( (IS_WIZARD(TP))  && (TP->QP(P_INVIS)!=0) ) {

    tell_room( "/d/dschungel/dante/weg/room/quel2.lpc",
        ""+CAP(getuid(PL))+" ist gerade unsichtbar in die Quelle gestiegen.\n");
    //"Das Wasser macht "+TP->QueryPronoun(WEN)+" wieder sichtbar!\n");
    //TP->SetProp(P_INVIS, 0);
  }
}






create()
{
  ::create();
  SetProp( P_INT_SHORT, "In einer wunderbaren Quelle" );
  SetProp(P_NO_TPORT, NO_TPORT_IN);          

  SetProp( P_INT_LONG, BS( 
        "Du sitzt nun gemuetlich mitten in der wunderbaren Quelle. Ringsum Dich herum "
        "sind grosse, glatt geschliffene Steine in einem Kreis angeordnet, die dem "
        "Ganzen ein fast teichaehnliches Ambiente verleihen. Um diesen steinernen Kreis "
        "herum hat man dunkelgruene, sehr dichte Buesche gepflanzt, so dass man "
        "hier sicherlich voellig ungestoert baden kann. Das Wasser erreicht diese "
        "Quelle auf zwei Wegen. Einerseits sprudelt es munter aus dem Boden, "
        "andererseits faellt es von einem grossen Felsen herab, der am hinteren "
        "Rand der Quelle steht. Am Fusse dieses Felsens siehst Du auch "
        "einen schweren Hebel. Sechs Stangen stehen ebenfalls "
        "kreisfoermig um die Quelle herum. Zwischen ihnen ist ein grosses Tuch aufgespannt, "
        "das vor der heissen Sonne des Dschungels schuetzt.          Eine Tafel."));


  AD("tafel", "Lies sie!");

  ARD("tafel", 
      "Nebenbei bemerkt, diese Quelle "
      "kann kein Magier unsichtbar oder leise betreten, sowohl die Quelle selbst als auch der Frosch "
      "versuchen das zu verhindern. Sollte kein Frosch da sein, kannst Du mit <quak> "
      "einen neuen Frosch herbei zaubern. Mit <plantsch> kannst Du sehen, ob "
      "sich ein unsichtbarer Magier bereits im Raum befindet.");



  AE("vorne", "./quel");




  AD("frosch",
      "Er sollte hier sein!");


  AD("seide",
      "Kostbare Seide.");

  AD(({"stange","stangen"}),
      "Sechs Stangen, die fest im Boden verankert sind, stuetzen das Tuch.");
  AD("tuch",
      "Das Tuch ist aus dicker, trotzdem leichter Seide und sieht von den "
      "Farben einem total klaren Nachthimmel aehnlich! Herrlich!!!");
  AD(({"farbe","farben"}),
      "Das Tuch ist blau, dunkelblau, hellblau, gelb, rot, weiss, schwarz...");
  AD(({"nachthimmel","nacht"}),
      "Der Nachthimmel sieht beeindruckend schoen aus.");

  AD("rand",
      "Am hinteren Rand der Quelle steht ein Felsen.");

  SP(P_INDOORS, 1);
  SP(P_LIGHT, 1);



  AD("sonne",
      "Das grosse Tuch schuetzt vor der Sonne des Dschungels.");
  AD("dschungel",
      "Du bist mitten drin.");
  AD("himmel",
      "Das Tuch laesst Dich den Himmel kaum sehen.");
  AD("magier",
      "Magier koennen hier nicht unsichtbar hereinkommen!");
  AD(({"wand","waende"}),
      "Richtige Wand gibt es hier nicht. Naja, die Buesche.");
  AD("fusse",
      "Genau da ist der Hebel.");

  AD("wasser",
      "Das Wasser ist sehr frisch weil es sich dauernd bewegt. Die Temperatur kann aeusserst "
      "unterschiedlich sein!");

  ASD("temperatur", "wie_is");


  AD(({"weg","wege"}),
      "Das Wasser sprudelt einerseits aus dem Boden, andererseits faellt es von dem "
      "grossen Felsen herab.");
  AD("boden",
      "Den Boden kann man wegen des Wassers nicht so genau sehen.");
  AD("felsen",
      "Der Felsen steht am hinteren Rand der Quelle. Wasser faellt von oben herab. "
      "Am Fuss des Felsen siehst Du einen schweren Hebel.");

  AD("hebel", "Den Hebel kann man nach oben und nach unten ziehen! Was er "
      "wohl bewirkt?!");



  AD(({"busch","buesche"}),
      "Die Buesche sind sehr dicht gepflanzt und schuetzen Dich vor neugierigen "
      "Blicken.");
  AD(({"blick","blicken"}),
      "Hier sieht Dich keiner!");

  AD("ambiente",
      "Die Quelle ist wirklich praedestiniert zum baden und sich erholen!");

  AD(({"ganzes", "ganzen"}),
      "Ein wirklich schoener und gemuetlicher Ort.");
  AD("ort",
      "Hier gefaellt es Dir.");

  AD("kreis",
      "Sowohl die Steine als auch die Stangen bilden einen Kreis.");
  AD("quelle",
      "Du sitzt mitten in dieser wunderbaren Quelle und es geht Dir so richtig gut hier.");
  AD(({"steine","stein"}),
      "Die grossen, glatten Steine begrenzen die Quelle kreisfoermig und verleihen "
      "ihr ein teichaehnliches Aussehen.");
  AD("decke",
      "Naja, das Tuch ist die Decke.");
  AD("fuss",
      "Am Fuss des Felsens ist der Hebel angebracht.");
  AD("aussehen",
      "Naja, nur aehnlich.");

  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: temp, ENV_TERRAIN:TT_WATER]) ); 

  AIT("d/dschungel/dante/weg/npc/tfro", REFRESH_DESTRUCT);


  AddSound( DEFAULT_SOUND,
      "Das Wasser blubbst und gluckst.");
  AddSmell(DEFAULT_SMELL,
      "Es riecht nach dem heilenden Wasser.");    

  AddCmd (({"ziehe","zieh"}), "temp_func");
  ACD("quak", "new_frog");
  ACD(({"plantsche","plantsch" }), "mag_test");
}



int out(string dir)  {
  return TP->move("/d/dschungel/dante/weg/room/weg3",M_GO, "aus der Quelle heraus",
      "steigt", "kommt aus der Quelle herausgestiegen");

}

int temp_func(string str)  {
  NF("Was willst Du ziehen?!\n");
  if(str=="hebel"||str=="am hebel")  {

    write(BS(
          "Du kannst den Hebel nach oben und nach unten ziehen!"));  
    return 1; 
  }

  if (str=="hebel nach oben") { 

    if (temp>=99)   {

      write(BS(
            "Nein! Weiter nach oben kann man den Hebel nicht ziehen! Das "
            "Wasser ist heiss genug!"));
      return 1; 
    }

    else  {

      write(BS(
            "Du ziehst den Hebel nach oben. Die Temperatur des Wassers steigt leicht."));
      say(BS(
            CAP_TPN+" zieht den Hebel nach oben. Die Temperatur des Wassers steigt leicht"));
      temp=temp+2;
      call_out("temp_func2", temp);
      return 1; 
    }
    return 0; 
  }



  if (str=="hebel nach unten") { 

    if (temp<=2)   {

      write(BS(
            "Nein! Weiter nach unten kann man den Hebel nicht ziehen! Das "
            "Wasser ist kalt genug!"));
      return 1; 
    }

    else  {

      write(BS(
            "Du ziehst den Hebel nach unten. Die Temperatur des Wassers sinkt leicht."));
      say(BS(
            CAP_TPN+" zieht den Hebel nach unten. Die Temperatur des Wassers sinkt leicht."));
      temp=temp-2;
      call_out("temp_func2", temp);
      return 1; 
    }
    return 0; 
  }
  return 0; 
}



temp_func2()  {

  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: temp, ENV_TERRAIN:TT_WATER]) );
}

wie_is()  {
  return BS(
      "Momentan hat das Wasser "+temp+" Grad.");  
}



new_frog()  {
  object ob;
  write(BS(
        "Du quakst wie ein Frosch."));
  say(BS(
        CAP_TPN+" quakt wie ein Frosch."));
  if(!present("frosch", TO))  {
    ob=CLONEOB("d/dschungel/dante/weg/npc/tfro");

    ob->move(TO, M_NOCHECK, "springt quakend herein");
    return 1; 
  }
  else {
    write(BS(
          "Der magische Frosch antwortet Dir quakend."));
    say(BS(
          "Der magische Frosch antwortet "+TP->name(WEM)+" quakend."));			
    return 1; 
  }
  return 0; 
}

