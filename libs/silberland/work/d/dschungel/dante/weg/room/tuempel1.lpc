// 27-10-96  tante dante@SilberLand
//erneuert 98
#include "../def.h"

inherit "std/room";
#include <moving.h>
#include <properties.h>
#include <language.h>
#include <mnpc.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "An einem kleinen Tuempel" );
  SetProp( P_INT_LONG, BS(
        "Du stehst hier an einem kleinen Tuempel mitten im dichtesten Urwald. "
        "Das Wasser schimmert gruen und scheint voller Algen zu sein. Ab und "
        "zu steigen kleine Blaeschen an die Oberflaeche. "
        "Um den Tuempel herum siehst Du einen schmalen Schilfguertel. "
        "Einige Steine liegen entlang des Ufers verstreut."));
  AddDetail(({"steine","stein"}),
      "Die Steine liegen entlang des Ufers, als ob sie jemand hier abgelegt hat. "
      "Einige sind mit Moos bewachsen.");
  AddDetail(("moos"),
      "Das Moos ist gruen und saftig. Eine Stelle faellt Dir besonders auf.");
  AddDetail(("stelle"),
      "Komisch, aber da hat jemand eine Zeichnung gemacht.");
  AddDetail(("zeichnung"),
      "Du siehst auf der Zeichnung wie ein Spieler einen Magier tritt. ");
  AddDetail(("spieler"),
      "Der Spieler tritt einen Magier...");
  AddDetail(("magier"),
      "Der Magier tritt zurueck, aber dem Spieler passiert nix schlimmes...");
  AddDetail(("jemand"),
      "Wer das wohl war ?");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_JUNGLE]) );
  AddDetail(({"pflanze","pflanzen"}),
      "Du kennst keine einzige der Pflanzen, die hier wachsen.");
  AddDetail(("algen"),
      "Die Algen treiben im Wasser hin und her und verleihen dem Wasser "
      "seine gruene Farbe.");
  AddDetail(("farbe"),
      "Die Farbe des Wassers ist gruen und laedt zum Schwimmen ein.");
  AddDetail(({"schilfguertel","guertel"}),
      "Ringsum den kleinen Tuempel sieht man das mit Schilf bewachsene Ufer.");
  AddDetail(("ufer"),
      "Das Ufer ist steil und mit Schilf bewachsen.");
  AddDetail(("schilf"),
      "Die Halme wogen im Wind hin und her.");
  AddDetail(({"halme","halm"}),
      "Duenne, gelbe Halme.");
  AddDetail(("wind"),
      "Der Wind kraeuselt die Oberflaeche des Wassers.");
  AddDetail(("sonne"),
      "Die Sonne lacht Dich vom Himmel herab an.");
  AddDetail(("himmel"),
      "Strahlendblau ist er heute wieder einmal...");
  AddDetail(("blaeschen"),
      "BLOBB machen sie wenn sie an der Oberflaeche zerplatzen.");
  AddDetail(("wasser"),
      "Das Wasser ist gruen und voller Algen.");
  AddDetail(({"grund", "boden"}),
      "Der Tuempel scheint recht tief zu sein. Den Grund kann man jedenfalls "
      "nicht erkennen.");
  AddDetail(("oberflaeche"),
      "An der Oberflaeche kraeuselt der Wind das Wasser leicht auf.");
  AddDetail( ({ "tuempel" }),
      "Der Tuempel befindet sich mitten im dichten Dschungel und ist ein "
      "eigener kleiner Mikrokosmos. Du kannst ja probieren im Tuempel zu schwimmen...");
  AddDetail(("mikrokosmos"),
      "Hier kann man Tiere und Pflanzen finden, die sonst nirgends im Dschungel "
      "zu finden sind.");
  AddDetail(({"tiere"}),
      "Hast Du da nicht eben einen Fisch im Wasser gesehen...");
  AddDetail(("fisch"),
      "Ja, Du kannst im Wasser einen Fisch erkennen.");
  AddDetail(({"dschungel", "urwald"}),
      "Der Dschungel ist hier besonders dicht und verhindert so jedes Eindringen. "
      "Nur nach Nordwesten kannst Du wieder auf den Pfad zurueck.");
  AddDetail(("pfad"),
      "Der Pfad liegt von hier aus im Nordwesten.");
  AddDetail(("nordwesten"),
      "Im Nordwesten kommt man durch eine Luecke im Dschungel wieder auf den Pfad "
      "zurueck.");
  AddDetail(("luecke"),
      "Durch diese Luecke kommt man auf den Pfad zurueck.");
  AddDetail(("erde"),
      "Die Erde ist hier feucht und saftig.");
  AddSound( DEFAULT_SOUND,
      "Das Wasser plaetschert sanft dahin.");

  AddSmell( DEFAULT_SMELL,
      "Das Wasser riecht modrig.");

  AddExit("nordwesten", "./weg6");

  AddCmd(({"schwimme","schwimm"}), "schwimmen");

  AddItem(NPC "gmamba", REFRESH_DESTRUCT,
      ([P_MNPC_FLAGS:0, P_AGGRESSIVE:0]));
  AddItem(({NPC"dstechmuecke", NPC"dmoskito"}), REFRESH_DESTRUCT);
  AddItem(NPC"phantom", REFRESH_DESTRUCT);

  AddItem(NPC"rmoskito", REFRESH_DESTRUCT);
  AddItem(NPC"rmoskito", REFRESH_DESTRUCT);

}

schwimmen(string str )
{
  notify_fail( "Wohin willst Du schwimmen ?\n" );
  if ( !str ) return 0;
  if ( member( ({"in wasser","in tuempel","tuempel","ins wasser"}),str) !=-1 )
  {
    write( " \n"
        "Du steigst vorsichtig ins Wasser und schwimmst mitten in den Tuempel hinaus.\n");
    TP->move("/d/dschungel/dante/weg/room/tuempel2", M_GO,
        "ins Wasser und schwimmt mitten in den Tuempel hinaus", "steigt", 
        "steigt in den Tuempel und schwimmt mitten in den Tuempel hinaus");
    return 1;
  }
  return 0;
}

void init()
{
  object ob;
  ::init();

  if(deep_present("\nimp", TP))  { return;  }
  if(deep_present("MALA", TP)) { return; }

  switch(random(100))
  {
    case 0 .. 95:
      break;

    case 96 .. 99:

      ob=clone_object("/d/dschungel/dante/weg/obj/dmala.lpc");
      ob->move(TP, M_NOCHECK);
  }
}

