// brunnen 3 dante

#include "files.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
create()
{
  ::create();

  SetProp( P_INT_SHORT, "In Schlamm" );
  SetProp( P_INT_LONG, BS(
        "Du steckst voellig im stinkendem Schlamm fest. Ueberall nur Schlamm...\n"));
  AddDetail(("decke"),
      "Wenn man mitten im Schlamm steckt, kann man von Decke ja kaum reden. Aber sei beruhigt, "
      "sie ist auch aus Schlamm.");
  AddDetail(("boden"),
      "Der Boden besteht, wie koennte es anders sein, aus Schlamm...");
  AddDetail(({"wand","waende"}),
      "Die Waende bestehen origineller Weise aus Schlamm. Eine kleine Schlammblase faellt "
      "Dir auf.");
  AddDetail(("blase"),
      "Du verspuerst Druck auf der Blase. Du solltest wohl nicht so viel trinken...");
  AddDetail(("schlammblase"),
      "Die Schlammblase blubbert und ab und zu schleudert sie etwas Schlamm in alle "
      "moeglichen Richtungen");
  AddDetail(({"richtung","richtungen"}),
      "Besonders nach nordnordwest spritzt der Schlamm...");    


  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20,ENV_TERRAIN:TT_CAVE]) );


  AddDetail(("schlamm"),
      "Vorne Schlamm, hinten Schlamm, ober Dir Schlamm, unter Dir Schlamm,...");

  AddSound( DEFAULT_SOUND,
      "Der Schlamm fluestert irgendwas und lacht Dich aus.");

  AddSmell( DEFAULT_SMELL,
      "IGITT!!!Hier riecht es nach Tod und Verwesung.");

  AddRoomMessage( 
      ({"Du geraetst in Panik...\n",
       "Angst ergreift Besitz von Dir...\n",
       "Ach, waerst Du doch nicht in den Brunnen gesprungen.\n",
       "Du denkst . o O 'BLUBB BLUBB BLUBB'\n",
       "Der Schlamm erdrueckt Dich fast.\n",
       "BLUBB....BLUBB....BLUBB....\n",
       "Der Schlamm blubbert und blubbert.\n",
       "Eine beschissene Situation...\n"}) );

  SetProp(P_HIDE_EXITS, ({"nordnordwest"} ));
  AddExit( "nordnordwest", "nach BLUBB#./brunnen9");
}




