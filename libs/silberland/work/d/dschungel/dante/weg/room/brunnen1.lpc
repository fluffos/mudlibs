/*
 ** brunnen
 ** dante 97 feb 
 ** 
 */

inherit "std/room";

#include <moving.h>
#include <player.h>
#include <properties.h>

#include "files.h"


create()
{
  ::create();
  SetProp (P_LIGHT, 1);
  SetProp (P_INDOORS, 0);
  SetProp (P_ENVIRONMENT, ([ENV_TEMPERATURE:30, ENV_TERRAIN:TT_JUNGLE]));
  SetProp (P_INT_LONG, BS(
        "Du stehst nun nahe der Stadtmauer von Tijara an einem alten Brunnen "+
        "aus Stein. Der Brunnen sieht schon ziemlich verfallen aus, ist aber "+
        "noch immer in Betrieb und die Hauptquelle fuer die Bewaesserung der"+
        " Obstplantagen im Sueden.\n"));
  AddDetail(({"gewaechs","gewaechse"}),
      "Eben Gruenzeug aller Art...\n");
  AddDetail(("gruenzeug"),
      "Das Gruenzeug interessiert Dich ueberhaupt nicht.");
  AddDetail(("grundwasser"),
      "Das Grundwasser kann man natuerlich nicht sehen.");
  AddDetail(("konstrunktion"),
      "Eine alte, aber scheinbar stabile Konstruktion.");
  AddDetail(({"geruest","grundgeruest"}),
      "Die Backsteine sind einfach einer ueber dem anderen aufgestapelt worden.");

  AddDetail(("brunnen"),
      "Das Fundament des Brunnens bilden dicke Backsteine, die schon etwas " 
      +"Moos "
      +"angesetzt haben. Sonst besteht er nur noch aus einem Balken, den "
      +"man ueber die kreisrunde Oeffnung gelegt hat.");
  AddDetail(("fundament"),
      "Der Brunnen ist eine solide alte Konstruktion.");
  AddDetail(("oeffnung"),
      "Ob man durch sie wohl irgendwie in den Brunnen springen kann?\n");
  AddDetail(("balken"),
      "In den Holzbalken siehst Du einige Zeichen eingeritzt.\n");
  AddDetail(("moos"),
      "Das warme Klima und die feuchte Umgebung sind ein idealer Naehrboden "
      +"fuer "
      "Gewaechse aller Art.");
  AddDetail(("klima"),
      "Tropisches Klima herrscht hier.\n");
  AddDetail(("umgebung"),
      "Die naehere Umgebung des Brunnens ist durch das Grundwasser sehr "
      +"feucht.");
  SetProp (P_INT_SHORT, "Am Brunnen");
  AddDetail(("betrieb"),
      "Die Plantagenarbeiter sorgen fuer die Funktionstuechtigkeit des "
      +"Brunnens.");
  AddDetail(({"mauer","stadtmauer"}),
      "Gleich hinter dem Brunnen erhebt sich die hohe Stadtmauer von Tijara.\n");
  AddDetail(({"hauptquelle","quelle"}),
      "Von diesem alten Brunnen aus werden die Plantagen mit Wasser versorgt.\n");
  AddDetail(("bewaesserung"),
      "In diesem tropischen Klima benoetigen die Pflanzen viel frisches "
      +"Wasser.");
  AddDetail(({"plantage","plantagen","obstplantagen","obstplantage"}),
      "Die Obstplantagen erstrecken sich von hier bis weit in den Sueden.\n");
  AddDetail(("sueden"),
      "Nach Sueden gehts wieder aud die Obstplantagen der Stadt Tijara zurueck.\n");
  AddDetail(("obst"),
      "Auf den Plantagen von Tijara baut man Mango, Ananas, Bananen, Papayas \n"
      "und noch vieles mehr an...\n");
  AddDetail(({"backsteine","backstein"}),
      "Grosse, vieleckige Backsteine bilden das Grundgeruest des Brunnens.\n");
  AddDetail(({"wasser","bewaesserung"}),
      "Mit Eimern muessen die Arbeiter das Wasser vom Brunnen zu den "
      +"Stauden tragen.");
  AddDetail(({"stauden","staude"}),
      "Von hier kann man sie nicht besonders deutlich erkennen.\n");

  AddDetail(("zeichen"),
      "Die Zeichen sind nicht mehr zu entziffern...");
  AddDetail(({"holzzaun","zaun"}),
      "Der Zaun liegt weit im Osten von hier. \n");

  AddDetail ( ("stein"),
      "Der Brunnen ist aus alten Backsteinen gemauert.\n");
  AddDetail ("himmel", "Der Himmel erstrahlt in tiefstem Blau.\n");
  AddDetail ( ({"stadt", "tijara"}), "Du befindest Dich hier auf dem Grund "
      +"des "
      +"Gouverneurs von Tijara. Die Stadt liegt gleich hinter der Mauer.");
  AddDetail(("boden"),
      "Der Boden ist hier sehr nass und teilweise sogar matschig.");    

  AddSmell( DEFAULT_SMELL,
      "Aus dem Brunnen kommt ein brackiger Geruch.\n");
  AddSound( DEFAULT_SOUND,
      "Das Wasser gluckst und plaetschert im Brunnen.\n");
  AddExit( "suedosten", "./planta12");
  AddItem(NPC"dfrosch1" , REFRESH_DESTRUCT);
  AddItem(NPC"kaesemaus", REFRESH_DESTRUCT);
  AddCmd ( ({"spring","springe",}), "kletter" );
}

void create_new_mouse()
{
  call_out("create_new_mouse2", 300);
}
//so wird das andauernde holen der mauese erschwert...also kein ueben...
//und 5 min warten nervt...

void create_new_mouse2()
{
  object ob;
  if (!present("\nkaesemaus"))
  {
    ob=clone_object("d/dschungel/dante/weg/npc/kaesemaus");
    ob->move(TO, M_NOCHECK);
  }
}


int kletter(string str)
{
  notify_fail ("Wohin willst Du springen ?\n");
  if ( !str ) return 0;
  if ( member( ({"in brunnen", "durch oeffnung","in oeffnung" }),str) !=-1 )
  {
    write("                                                               \n"
        "Du nimmst allen Mut zusammen und springst in den Brunnen.\n");
    TP->move("/d/dschungel/dante/weg/room/brunnen2", M_GO,
        "wagemutig in den Brunnen","springt","kommt von oben heruntergesprungen");
    return 1;
  }
  return 0;
}

