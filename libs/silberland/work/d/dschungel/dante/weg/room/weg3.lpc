//dante
// dschungelpfad


#include "files.h"

inherit "std/room";

#include <properties.h>
#include <language.h>


void new_pig();

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Auf dem Dschungelpfad" );
  SetProp( P_INT_LONG, BS(
        "Der Pfad faellt nun leicht ab und windet sich um einen gigantischen"
        " Felsblock. Die Vegetation wird immer dichter und die Geraeusche der"
        " Tiere immer unheimlicher. Neben dem Pfad siehst Du eine ganze Reihe"
        " von Palmen und dahinter den undurchdringbaren Dschungel. In der Ferne"
        " glaubst Du eine tiefe Schlucht zu erkennen. Zwischen einigen Pflanzen"
        " liegt ein vermodertes altes Schild. Im Westen erkennst Du eine Quelle, "
        "die Du Dir unbedingt ansehen solltest!                                "
        "                                    Eine Tafel!"));

  AddDetail("tafel",
      "Lies sie!");

  AddReadDetail("tafel",
      "Besuchen sie die magische Quelle!!!");


  AddDetail(({"westen","quelle"}),
      "Geh unbedingt hin!");

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_JUNGLE]) );

  AddDetail( ({"pfad"}),
      "Der Pfad faellt nun leicht ab und windet sich um einen gigantischen"
      " Felsblock."); 

  AddDetail(("himmel"),
      "Blau und wolkenfrei haengt er ober Dir. Manchmal ziehen einige Voegel "
      "vorueber...");
  AddDetail(({"vogel","voegel"}),
      "Du kannst nicht erkennen welche es sind. Sie fliegen viel zu hoch.");
  AddDetail(("schild"),
      "Du kannst es lesen.");
  AddDetail(("tal"),
      "Das Tal liegt weiter im Sueden.");
  AddDetail(("sueden"),
      "Tief im Sueden soll es sehr gefaehrlich sein...");
  AddDetail(({"fels","felsen"}),
      "Die Felsen werden immer hoeher, je weiter Du nach Sueden wanderst.");
  AddDetail( ({"felsblock","fels","block"}),
      "Gewaltig ragt er neben Dir in die Hoehe, glatt und unueberwindbar. "
      "Von oben herab stroemen einige Rinnsale, die im feuchten Boden "
      "wieder verschwinden.");
  AddDetail(({"rinnsal","rinnsale","wasser", "wand"}),
      "Das Wasser fliesst die steile Wand herunter, und macht den Fels nur"
      " noch rutschiger.");
  AddDetail(("boden"),
      "Der Boden am Fusse des Felsen ist feucht und weich.");
  AddDetail(({"tier","tiere"}),
      "Hoeren kannst Du sie, aber sehen laesst sich keiner der scheuen ",
      "Dschungelbewohner.");
  AddSound(({"tier","tiere"}),
      "Hoeren kannst Du sie, aber sehen laesst sich keiner der scheuen ",
      "Dschungelbewohner.");
  AddDetail(({"vegetation","dschungel"}),
      "Der Dschungel wuchert und waechst und versucht den gerodeten Boden "
      "wieder einzunehmen.");
  AddDetail(({"palme","palmen","reihe","luft"}),
      "Die Palmen ragen hoch in die Luft. Hoch oben erkennst Du Kokosnuesse.");
  AddDetail(({"pflanze","pflanzen"}),
      "Das Schild wird von den Pflanzen fast vollstaendig verdeckt.");
  AddDetail(("schlucht"),
      "Tief unter Dir im Tal kannst Du eine breite Schlucht erkennen, die "
      "unueberwindbar scheint.");  

  AddDetail(({"nuss","kokosnuss","kokosnuesse","nuesse"}),
      "Die Kokosnuesse haengen wirklich sehr hoch oben. Aber irgendwie kommt "
      "man sicher an sie ran...");


  AddReadDetail(("schild"),
      "+------------------+\n"
      "|     ACHT NG!     |\n"
      "|   as Betr   en   |\n"
      "|       des        |\n"
      "|    Ds  ung ls    |\n"
      "|    esc ieht auf  |\n"
      "|  ei  nes   siko! |\n"
      "|                  |\n"
      "|         Da te    |\n"
      "+------------------+\n");


  new_pig();


  AddSound( DEFAULT_SOUND,
      "Du hoerst wie der Dschungel ringsum Dich voller Leben ist.");

  AddSmell( DEFAULT_SMELL,
      "Du riechst den warmen, typischen Dschungelgeruch.");

  AddCmd(({"schuettel","schuettle","ruettel","ruettle","ruettl","tritt"}), "schuettel");

  AddItem( ({NPC"darcheo", NPC"dkakadu"}), REFRESH_DESTRUCT);

  AddSpecialExit("westen", "check");

  AddExit( "norden", "./weg2" );
  AddExit( "suedwesten", "./weg4");
}

int check()  {

  if(interactive(TP)!=1)  {
    return 1;  
  }
  if(TP->QueryProp(P_INVIS)!=0)  {
    write (BS(
          "Unsichtbar kannst Du da nicht hin!!!"));
    tell_room("d/dschungel/dante/weg/room/quel.lpc",
        ""+CAP(getuid(PL))+" wollte unsichtbar in die Quelle steigen!\n");
    return 1; 
  }
  else  
    return TP->move("/d/dschungel/dante/weg/room/quel", M_NOCHECK,
        "in die Quelle", "steigt", "kommt in die Quelle gestiegen");   
}


int schuettel(string str)
{
  notify_fail("Was willst Du der armen Palme antun?\n");
  if( !str ) return 0;
  if( member( ({"palme","palmen","an palme","an palmen"}),str) !=-1 )
  {
    write ("AUA!!!Die Kokosnuss faellt genau auf Deinen Kopf und purzelt "
        "weiter in den Dschungel.\n");
    say(BS(TPN+" ruettelt an einer Palme und eine grosse Kokosnuss faellt "+ 
          TP->QueryPronoun(WEM)+" genau auf den Kopf.\n"));
    TP->do_damage(1+random(5));
    SetProp(P_KILL_NAME, "Eine herabfallende Kokosnuss");
    return 1;
  } 
  return 0;
}



void new_pig()
{
  object ob;
  if (!find_living("tropensau")) { // Bugfix, Angrox (16071999) 
    ob=clone_object("d/dschungel/dante/weg/npc/tropens");
    ob->move(TO, M_GO);
    ob->AddId("tropensau2");
  }
}

//bugfix, bitte nicht loeschen. 19980927, muaddib
void reset() {
  new_pig();
  ::reset();
}

