// a, felsenkammer

#include "files.h"

inherit "std/room";
#include <moving.h>
#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Im Schlamm" );
  SetProp( P_INT_LONG, BS(
        "Du befindest Dich noch immer im Schlamm, doch etwas ist hier anders..."));
  AddDetail(("schlamm"),
      "Du erkennst eine grosse Schlammblase, die seltsam pulsiert...\n");
  AddDetail(({"blase","schlammblase"}),
      "Die Schlammblase ist ein natuerliches Teleporttor.\n");
  AddDetail(({"tor","teleporttor"}),
      "Du kannst es betreten...\n"); 

  SetProp( P_LIGHT, 1 );

  AddDetail(("decke"),
      "Von der Decke tropft Schlamm.");
  AddDetail(("boden"),
      "Der Boden ist hier etwas fester.");
  AddDetail(({"wand","waende"}),
      "Die Waende bestehen aus Schlamm.");
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25,ENV_TERRAIN:TT_CAVE]) );


  AddSound( DEFAULT_SOUND,
      "Der Schlamm blubbert und blubbert.");

  AddSmell( DEFAULT_SMELL,
      "Hier stinkt es...");

  AddItem(NPC"dschlamm1", REFRESH_DESTRUCT);  

  AddCmd( ({"betrete", "betritt"}), "tele");


}

int tele(string str)
{
  notify_fail("Was willst Du hier machen?\n");
  if( !str ) return 0;
  if( member( ({"blaeschen", "blase","schlammblase","tor", "teleporttor"}),str) !=-1 )
  {
    write("                                                                          \n"

        "Du betrittst die Schlammblase, sie zerplatzt und schleudert Dich wieder an \n"
        "die Oberflaeche zurueck.                                                  \n"
        "                                                                    \n");
    TP->do_damage(5);
    TP->move("/d/dschungel/dante/weg/room/schlamm", M_GO, 
        "aus dem Schlamm fortgeschleudert","wird",
        "wird ploetzlich aus dem Schlammloch geschleudert");
    return 1;
  }
  return 0;
}

