

#include "/players/dante/myowndefine.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "wizlevels.h"
#include <mnpc.h>


create()
{
  ::create();

  SetProp( P_INT_SHORT, "Im Nebenraum des Beutelnestes" );
  SetProp( P_INT_LONG, BS(
"Du bist nun im Nebenraum des Beutelnestes. Hier buggt alles und ist "
"gar nicht schoen anzusehen. Alles unfertig, nichts geht. Ab und zu "
"kommen ein paar Magier vorbei und reden gross und machen Unsinn..."));

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25, ENV_TERRAIN:TT_CAVE]) );
    
  AddSound( DEFAULT_SOUND,
    "Du hoerst hier nichts.");
  AddSmell( DEFAULT_SMELL,
  "Hmm, es riecht nichts.");
  
  
  
 AddExit("nest", "wieder hinaus#/players/dante/bnest");

}

varargs string GetDetail(mixed key, mixed race) {
	
	return BS(
	"Naja, so wie das Land in dem das originale Nest ist...");
	}
