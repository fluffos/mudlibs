//felsvorsprung 
//wasserlache

#include "files.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
create()
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einem Felsvorsprung hoch ueber der Schlucht" );
  SetProp( P_INT_LONG, BS(
        "Hier endet der schmale, steile Weg in einer kleinen Felsnische. Du befindest "
        "Dich hier nicht mehr ganz so hoch ueber dem Fluss und das Wasser spritzt "
        "herauf. Am Boden haben sich kleine Wasserlachen gebildet..."));

  AddDetail(({"wasserlache", "wasserlachen"}),
      "Sie bedecken fast den gesamten Boden der Nische, irgendetwas scheint "
      "hier aber komisch zu sein...");
  AddDetail(("ufer"),
      "Irgendwie kommt man da sicher hin...");
  AddDetail(("nische"),
      "Die Nische besteht aus blanken, rutschigen Felsen.");
  AddDetail("felsnische",
      "Das Wasser spritzt von unten herauf und bedeckt fast den ganzen Boden!");
  AddDetail(("himmel"),
      "Strahlendblau scheint er heute zu sein.");
  AddDetail("weg",
      "Der Weg endet hier und fuehrt nur mehr nach oben...");
  AddDetail(("boden"),
      "Der Boden besteht aus blankem Fels. Ueberall sieht man hier Wasserlachen.");
  AddDetail(("lachen"),
      "Nein, zum Lachen ist hier nichts.");
  AddDetail(({"felswand","felswaende","wand","waende"}),
      "Steil ragen die Waende der Schlucht hier nach oben. An einer der Waende erkennst "
      "Du tiefe Risse.");
  AddDetail(({"riss","risse"}),
      "Die Risse sehen so aus, als ob man mit ihrer Hilfe nach oben klettern koennte...");
  AddDetail("hilfe",
      "NEIN! Gibts hier nicht!");
  AddDetail(({"felsen","fels"}),
      "Auf einer Seite nur Fels, auf der anderen faellt die Felswand senkrecht bis "
      "zum Wasser hinab.");
  AddDetail(("wasser"),
      "Das Wasser des Rio de la Puseta ist hier smaragdgruen."); 
  AddDetail(("fluss"),
      "Der smaragdgruene Rio de la Puseta rauscht tief unter Dir dem Meer entgegen.");
  AddDetail(("meer"),
      "Das Meer ist von hier sehr weit entfernt.\n");
  AddDetail(("schlucht"),
      "Die enge Schlucht bildet hier die Grenze zwischen dem erforschtem Gebiet im"
      " Norden und dem unbekanntem Land im Sueden.");
  AddDetail(("grenze"),
      "Die Schlucht zerreist den Dschungel hier jaeh.");
  AddDetail(("sueden"),
      "Am anderen Ufer des Rio de la Puseta beginnt voellig unerforschtes Neuland.\n");
  AddDetail(("gebiet"),
      "Das erforschte Gebiet liegt in der groesseren Umgebung von Tijara.");
  AddDetail(("tijara"),
      "Tijara ist eine grosse Stadt, die weit im Norden liegt.");
  AddDetail(("norden"),
      "Im Norden liegt die Stadt Tijara.");
  AddDetail(("neuland"),
      "Deine Abenteuerlust steigt...");
  AddDetail(("land"),
      "Das Land ist reich und wild in dieser Region.\n");
  AddDetail(({"rio","puseta","rio de la puseta"}),
      "Der Rio de la Puseta ist der groesste Fluss im Silberland.");
  AddDetail(("dschungel"),
      "Der Dschungel liegt ober Dir.");

  SetProp( P_LIGHT, 1);
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 23, ENV_TERRAIN:TT_JUNGLE]) );

  AddSound( DEFAULT_SOUND,
      "Aus der Hoehle hoert man lautes Krachen.");

  AddSmell( DEFAULT_SMELL,
      "Du kannst das Wasser direkt riechen.");

  AddSpecialExit( "oben", "pech"); 

  AddCmd(({"kletter", "klettere"}), "up");

  AddItem(OBJ_STEIN"lache", REFRESH_DESTRUCT);
} 


up (string str)
{
  notify_fail("Wohin willst Du hier klettern? Womit?\n");
  if (!str) return 0;
  if (member(({"mit hilfe der risse nach oben", "mit risse nach oben",
          "mit risse hinauf", "mit rissen hinauf", "mit hilfe der risse hinauf",
          "mit hilfe der risse rauf", "mit riss rauf", "mit rissen rauf",
          "in risse rauf", "in riss rauf", "in risse hinauf", "in rissen nach oben"}), str)!=-1)
  {
    write("Du kletterst mit Hilfe der Risse nach oben.\n");
    TP->move("/d/dschungel/dante/weg/room/vorsprung", M_GO,
        "nach oben", "klettert", "kommt von unten herauf geklettert");
    return 1;
  }
  return 0;
}


int pech()
{
  write("Du willst den Weg nach oben gehen, rutscht aber dauernd am nassen, "
      "rutschigen Felsen aus! So kommst Du hier nicht mehr weg!\n");
  return 1;
}

