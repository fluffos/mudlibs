// suedlcih von tijara

#include "files.h"

inherit "std/room";
#include <moving.h>
#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Auf dem Dschungelpfad" );
  SetProp( P_INT_LONG, BS(
        "Du befindest Dich auf dem Pfad, der von Tijara direkt in den Dschungel "
        "fuehrt. Im Norden kannst Du noch die Mauern der Stadt erkennen, doch vor "
        "und neben Dir beginnt bereits der wilde Dschungel, der schon nach "
        "wenigen Metern undurchdringbar scheint.\n")); 
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_JUNGLE]) );

  AddDetail(("himmel"),
      "Der Himmel ist strahlendblau...");
  AddDetail(("boden"),
      "Der Boden ist saftig und gruen und nicht so ausgetreten wie naeher bei der Stadt.");

  AddDetail( ({"tijara","stadt", "sitz"}),
      "Im Norden liegt die grosse Stadt Tijara, Sitz des Gouverneurs.");
  AddDetail(({"mauer","stadtmauer", "mauern"}),
      "Aus dieser Entfernung schaut auch die hohe Stadtmauer von Tijara schon "
      "recht klein aus.");
  AddDetail(("dschungel"),
      "Abseits des Pfades wachsen Straeucher, Baeume, Farne, Blumen und Graeser, "
      "die Du alle noch nie zuvor gesehn hast.");                                      
  AddDetail(({"meter","metern"}),
      "Du probierst tiefer in den Dschungel einzudringen, doch gibst gleich wieder "
      "auf.");
  AddDetail(({"straeucher","strauch"}),
      "An einem der Straeucher scheint etwas auffaellig zu glitzern."); 
  AddDetail(({"etwas","glitzern", "sonnenstrahl"}),
      "Du musst Dich wohl geirrt haben, hier spiegelt sich nur ein Sonnenstrahl.");
  AddDetail(({"farn","farne"}),
      "Weisst Du nicht wie Farne aussehen?");
  AddDetail(({"blume","blumen"}),
      "Ringsum Dich bluehen die farbigsten und schoensten Blumen, die Du jemals "
      "erblickt hast. Auf einer roten Blume kannst Du einen Kaefer erkennen.");
  AddDetail(({"kaefer", "kerlchen"}),
      "Das putzige Kerlchen scheint vom Nektar der Blume zu naschen...");
  AddDetail(("nektar"),
      "Du hast wohl sehr gute Augen...");
  AddDetail(({"gras","graeser"}),
      "Hier waechst das Gras besonders kraeftig und hoch.");
  AddDetail(({"baum","baeume"}),
      "Um Dich herum siehst Du Baeume aller Art. Manche Arten kennst Du, andere "
      "wiederum nicht. Eine Dschungeleibe faellt Dir besonders auf."); 
  AddDetail(({"eibe","dschungeleibe", "stamm"}),
      "Am Stamm erkennst Du Spuren. Was die wohl zu bedeuten haben?");
  AddDetail(({"spur","spuren"}),
      "Du betrachtest die Spuren und den Stamm genauer und stellst fest, dass "
      "hier jemand nach oben geklettert ist!");
  AddDetail(("pfad"),
      "Der Pfad fuehrt weiter in den tiefen Dschungel hinein. Nach Osten kann man eine kleine "
      "Lichtung betreten.");
  AddDetail(("osten"),
      "Ein kleiner Pfad fuehrt hier auf eine Lichtung.");
  AddDetail(("lichtung"),
      "Die Lichtung scheint nicht besonders gross zu sein.");
  AddSound( DEFAULT_SOUND,
      "Du hoerst, dass der Dschungel voller Leben sein muss. ");

  AddDetail(({"fels","felsen"}),
      "Die Felsen werden gen Sueden immer hoeher...");
  AddDetail(("sueden"),
      "Im Sueden beginnt der dichte Dschungel.");

  AddSmell( DEFAULT_SMELL,
      "Du kannst exotische Pflanzen, Tiere und Deinen eigenen Schweiss riechen.");


  AddExit( "nordwesten", "./wegp3");
  AddExit( "sueden", "./weg3");
  AddExit( "osten", "./loch");
  AddCmd( ({"kletter","klettere"}), "klettern");


  if(random(3))  {
    AddItem("/d/gebirge/angrox/obj/astralring", REFRESH_REMOVE,
        ([P_NOGET: "Der Astralring sagt: Nein! So sicher nicht!\n" ]));
  }


  AddItem("/d/dschungel/dante/weg/npc/due", REFRESH_DESTRUCT);

}
int klettern(string str)
{
  notify_fail("Wohin willst Du klettern?\n");
  if( !str ) return 0;
  if( member( ({"rauf", "nach oben", "auf baum", "hoch", "auf eibe", "auf stamm",
          "auf dschungeleibe"}),str) !=-1 ) 
  {
    //auf news geaendert !!!!!!!
    // write("Leider, im Moment wird da oben gebaut! Du kannst da nicht rauf!\n");
    write("Du kletterst mit grosser Muehe auf die Eibe.\n");
    TP->move("/d/dschungel/dante/news/room/bhaus1", M_GO, "auf eine Eibe",
        "klettert", "kommt von unten herauf geklettert");
    return 1;
  }
  return 0;
}   

