// ein kleines baumhaus
//veraednert fuer bildquest dante 98 sl
#include "files.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>


void create()
{
  ::create();

  SetProp( P_INT_SHORT, "Im kleinen Baumhaus" );
  SetProp( P_INT_LONG, BS(
        "Du befindest Dich hier hoch ueber dem Boden in einem kleinen Baumhaus.\n"
        "Es bietet kaum Platz fuer eine Person und die Sonne brennt direkt auf\n"
        "Dich herab, aber die Aussicht ist wunderschoen. Wer mag wohl der\n"
        "Erbauer gewesen sein?\n"));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_JUNGLE]) );



  AddDetail(({"auge","augen"}),
      "Weit, weit...");
  AddDetail(({"bananen","banane"}),
      "Hmm, irgendwie sieht Deine Nase aus wie eine Banane!\n");
  AddDetail("nase",
      "Deine Nase rotzt!");
  AddDetail(({"mauer","stadtmauer","tor","suedtor"}),
      "Schlecht zu erkennen...");
  AddDetail("mandastromo",
      "Hmm, die schmecken so gut nach Nostromo!");
  AddDetail("nostromo",
      "Nostromo ruft: He, lass das!!!");


  AddDetail( ("boden"),
      "Den Boden kannst Du von hier oben nicht erkennen. Die vielen Pflanzen\n"
      "versperren Dir jegliche Sicht nach unten.\n");
  AddDetail(({"sicht","pflanzen"}),
      "Die vielen Schichten von Blaettern und Aesten machen es unmoeglich weit\n"
      "nach unten zu sehn.\n");
  AddDetail(("sonne"),
      "Hoch oben am Himmel steht die pralle Sonne und strahlt direkt auf Dich\n"
      "herab.\n");
  AddDetail(({"blaetter","ast","aeste","blaettern","aesten","pflanze","pflanzen"}),
      "Gruen, gruen, gruen, alles nur gruen...\n");
  AddDetail(("person"),
      "Diese Person bist Du!\n");
  AddDetail(("platz"),
      "Wie schon erwaehnt, davon ist hier nicht allzu viel. In der Ferne "
      "erkennst Du aber doch ein helles Aufblitzen.");
  AddDetail("ferne",
      "Weit, weit weg...");
  AddDetail("aufblitzen",
      "Du siehst wie ein Lichtstrahl von irgendwoher aus Tijara reflektiert "
      "wird und hier genau auf eine kleine Spalte trifft.");
  AddDetail(({"strahl", "lichtstrahl"}),
      "Er trifft genau auf eine kleine Spalte.");
  AddDetail("spalte",
      "Die Spalte ist sehr schmal. Du glaubst, dass da etwas drinnen sitzt.");

  AddDetail(("erbauer"),
      "Sei froh, dass der gerade nicht da ist.\n");
  AddDetail(("aussicht"),
      "Du erkennst von hier oben im Norden die Stadt Tijara, im Sueden glaubst\n"
      "Du eine breite Schlucht zu sehen und noch suedlicher ein Dorf.\n"
      "Im Westen erstreckt sich das Meer und nach Osten nichts als der gruene\n"
      "Dschungel so weit Dein Auge reicht.\n");   
  AddDetail(({"norden","stadt","tijara"}),
      "Du erkennst die Stadtmauer und das Suedtor, aber sonst nichts. "
      "Etwas naeher bei Dir erkennst Du die Plantagen von Tijara...");
  AddDetail(({"plantagen","plantage"}),
      "Auf diesen Plantagen bauen Arbeiter Obst an.");
  AddDetail(("obst"),
      "Mangos, Bananen, Mandastromos,...");
  AddDetail(("arbeiter"),
      "Die Arbeiter schuetzen und behueten das Obst...");
  AddDetail(({"westen","meer"}),
      "Blau, blau und unendlich weit...\n");
  AddDetail(({"sueden","schlucht"}),
      "Der Pfad scheint direkt zur Schlucht und noch weiter zu fuehren.\n");
  AddDetail(("dorf"),
      "Wer wohl in dem Dorf wohnen mag?\n");
  AddDetail(({"dschungel","osten"}),
      "Bis zum Horizont kannst Du nur den scheinbar unendlich grossen Dschungel\n"
      "erblicken.\n");
  AddDetail(({"haus","baumhaus"}),
      "Genau da stehst du nun...");

  AddDetail("horizont",
      "Du entdeckst direkt vor Dir eine Liane. Tja, da sucht man den Horizont ab "
      "und findet direkt vor seiner Nase nicht einmal eine Liane.");
  AddDetail("nase",
      "Deine Nase interessiert niemanden.");
  AddDetail("pfad",
      "Der Pfad fuehrt nach Norden und Sueden, aber er liegt natuerlich unter Dir.");
  AddDetail("himmel",
      "Der Himmel ist blau, aber teilweise durch Blaetter verdeckt. He, da war was im Nordwesten!");
  AddDetail("liane",
      "Die Liane haengt von oben, aus dem Wipfel der Pflanzen herab.");
  AddDetail("wipfel",
      "Ueber Dir. Die Liane ist recht kraeftig und haelt Dein Gewicht sicher aus.");
  AddDetail("gewicht",
      "Hmmm, ca. 34,4 Tonnen. Hmm, im Nordwesten scheint auch etwas zu sein...");
  AddDetail(({"etwas","nordwesten"}),
      "Hmm, wie kommt man da hin.");

  AddSound( DEFAULT_SOUND,
      "Du hoerst das Singen und Traellern der Voegel. ");

  AddSmell( DEFAULT_SMELL,
      "AHH! Hier riecht man die pure Natur!");

  AddItem("/d/dschungel/dante/weg/npc/dgeier" , REFRESH_DESTRUCT);
  AddItem("/d/dschungel/dante/weg/obj/dfrucht" , REFRESH_REMOVE);

  AddCmd(( {"kletter", "klettere"}), "klettern");
  AddCmd(({"schwinge", "schwing"}), "try");    
  AddCmd(({"greife","greif","lange"}), "get");
}

int get(string str)
{
  object m;
  notify_fail("Wo willst Du hineingreifen?\n");

  if(member(({"in spalt","in spalte"}),str)!=-1) 
  {
    if(!present("ELEF", TP))
    {
      write("Du greifst in die Spalte, aber nichts passiert.\n");
      return 1;
    }
    if(present("gmaus", environment(TP)))
    {
      write("Du greifst in die Spalte, aber sie ist leer.\n");
      return 1;
    }
    if(deep_present("SPITZER", TP))
    {
      write("Ein Gebiss muss Dir genuegen!\n");
      return 1;
    }
    else
    {
      write("Du greifst in die Spalte und lockst ein kleines Tier hervor.\n");
      if(!present("\ndantemaus")) {
        m=clone_object("d/dschungel/dante/news/obj/gmaus");
        m->move(environment(TP), M_TPORT);
        m->SetOwner(getuid(TP)); 
      }
      else {
        tell_room(ME, BS("Eine Maus springt aus der "
              "Spalte heraus."));
        write_file("/d/dschungel/dante/news/log/gmaus.log", 
            sprintf("%s: %s(%s) versucht mehr Maeuse zu holen!\n", 
              dtime(time()), getuid(TP), getuid(TI)));
      }
      return 1;
    }
    return 0;
  }
  return 0;
}

int try(string str)
{
  notify_fail("Wohin willst Du mit der Liane schwingen?\n");
  if(member(({"mit liane nach norden", "mit liane nach sueden", 
          "mit liane nach osten",
          "mit liane nach nach suedosten", "mit liane nach nordosten",
          "mit liane nach suedwesten"}), str)!=-1)
  {
    write("Du greifst Dir die Liane und holst Schwung.\n"
        "Das bringt Dir aber wenig, denn hier ist nix. Du schwingst daher wieder "
        "zum Baumhaus zurueck.\n");
    return 1;
  }
  if(str=="mit liane nach nordwesten")
  {
    write("Du greifst Dir die Liane und schwingst damit nach Nordwesten.\n");
    TP->move("/d/dschungel/dante/news/room/bhaus2:"+getuid(this_player()), 
        M_TPORT,
        "mit einer Liane davon", "schwingt sich", 
        "schwingt sich mit einer liane herein");
    return 1;
  }
  if(str=="mit liane nach westen")
  {
    write("Du schwingst Dich mit der Liane nach Westen.\n");
    TP->move("d/dschungel/dante/news/room/bhaus3",M_TPORT,
        "mit einer Liane davon", "schwingt sich",
        "schwingt sich mit einer Liane herein");
    return 1;
  }
  return 0;
}

int klettern(string str )
{
  notify_fail( "Wohin willst Du klettern?\n" );
  if( !str ) return 0; 
  if( member( ({"unten", "nach unten", "runter", "hinunter", "zu boden",
          "hinab"}),str) !=-1 )

  {
    write("Du kletterst mit grosser Muehe vom Baumhaus nach unten.\n");
    TP->move("/d/dschungel/dante/weg/room/weg2", M_GO, "nach unten.","klettert",
        "kommt von oben herab geklettert.");

    return 1;
  }
  return 0;
}
