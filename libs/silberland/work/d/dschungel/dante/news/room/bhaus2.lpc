// ein kleines baumhaus
#include "files.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
int feen=1;
int color;

/*
   ich wollte diesen raum ja multiplayer faehig machen, aber
   das is keine gute idee, denn dann haben 5 spieler jeweils ihre eigenen 
   feen im raum, versuchen sie zu fangen usw....
   die muessten dann immer fange fee nummer 12 usw...tippen...
   gaebe nur chaos....
   */


create()
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einem Ast" );
  SetProp( P_INT_LONG, BS(
        "Du sitzt hier auf einem Ast, der bedrohlich hin und her schwankt. "
        "Rings um Dich siehst Du nur Blaetter und das undurchdringbare "
        "Dickicht des Dschungels. Eine Liane schwingt auch sanft im Wind "
        "hin und her."));

  AddDetail("liane",
      "Mit der Liane kannst Du Dich wieder zurueck schwingen.");
  AddDetail("wall",
      "Du singst 'Just another brick in the wall...'.");
  AddDetail("blaetterwall",
      "Die Blaetter sind hier so dicht, dass die eine fast Mauer bilden.");
  AddDetail("dschungel",
      "Du bist mitten drin. Solltest Du hier mitarbeiten wollen, wuerde ich mich freuen.");
  AddDetail("wind",
      "Der Wind kommt aus dem Norden.");
  AddDetail("norden",
      "Im Norden liegt Tijara.");
  AddDetail("tijara",
      "Solltest Du kennen!");
  AddDetail(({"hase","osterhase"}),
      "Der mit den langen Ohren...");
  AddDetail(({"ohr","ohren"}),
      "Zum hoeren...");

  AddDetail("mauer",
      "Sehr dicht.");
  AddDetail("ausruestung",
      "Wenn Du hier zu schwer bist, wirst Du irgendwann hinunterfallen...");
  AddDetail("dickicht",
      "Das Dickicht laesst kaum weitere Blicke zu. Zu dicht ist die "
      "der Blaetterwall.");
  AddDetail("moment",
      "Einen Moment bitte, das Detail wird erst eingelesen.");
  AddDetail("detail",
      "Moment bitte.");

  AddDetail(({"blick","blicke"}),
      "Du kannst hier kaum 3 Meter weit sehen.");
  AddDetail("meter",
      "Tja, und in 2 Meter Entfernung siehst Du...");
  AddDetail("entfernung",
      "Direkt vor Dir steht ein kleines, buntes Haeuschen.");
  AddDetail(({"haus"}),
      "Ist nicht da.");
  AddDetail("haeuschen",
      "Das ist das Haeuschen Farbenfroh. In Ihm wohnen die Farbfeen. Es ist "
      "das farbenfrohste, das Du jemals gesehen hast. Der Osterhase und seine "
      "Farben sind monochrom dagegen.");
  AddDetail(({"fee","farbfee","feen","farbfeen"}),
      "Tja, sie wohnen im Haeuschen. Ob die auch herauskommen?");
  AddDetail("farbenfroh",
      "Ein kleines, schmuckes Haeuschen mit kleinen bunten Fenstern und einer "
      "kleinen bunten Tuer und einem kleinen bunten Dach und einem kleinen bunten "
      "Kamin. Kitschig irgendwie, aber zweifelsohne bunt.");
  AddSpecialDetail(({"tuer","tuere","dach","fenster","kamin"}), "farben");






  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_JUNGLE]) );
  AddDetail(({"blatt", "blaetter"}),
      "Die Blaetter leuchten hier in besonders vielen, auffallend kraeftigen "
      "Farben. Hmm, das ist kein normaler Ort.");
  AddDetail("ort",
      "An diesem Ort wohnen die Farbfeen. Wer immer das auch sein mag...");
  AddDetail(({"farben","farbe"}),
      "Die Blaetter leuchten in Gruen, Gelb, Rot, Blau, Schwarz, Weiss, Orange, "
      "Tuerkis, Violett, Blutrot, Dunkelgelb, Blaugruen, Pink...");

  AddDetail(({"tuerkis","gruen","gelb","rot","blau","schwarz","weiss",
        "orange","violett","blutrot","dunkelgelb","blaugruen","pink"}), 
      "Diese Farben sind so praechtig, dass Du sie bewunderst!!!");

  color=random(13)+1;


  AddDetail("ast",
      "Der Ast ist recht dick, trotzdem schwingt er unter Deinem Gewicht hin "
      "und her, und vielleicht faellst Du ja auch runter...");
  AddSpecialDetail("gewicht", "fett");


  AddDetail( ("boden"),
      "Kannst Du von hier nicht sehen...\n");
  AddDetail("decke",
      "Gibt es hier nicht.");
  AddDetail("himmel",
      "Der Himmel ist strahlendblau. Viel siehst Du aber durch die Blaetter "
      "nicht von ihm.");
  AddDetail(({"wand","waende"}),
      "Die Waende sind blau und gruen gestrichen?!?!??! Gibt es hier nicht, Depp!");


  AddSound( ({DEFAULT_SOUND, "singen", "traellern", "voegel"}),
      "Du hoerst das Singen und Traellern der Voegel. ");

  AddSmell( DEFAULT_SMELL,
      "AHH! Hier riecht man die pure Natur!");

  AddCmd(({"bewunder","bewundere"}), "maybeget");
  AddCmd(({"locke","lock"}),"feencome"); 
  AddCmd(({"schwinge", "schwing"}), "try");    

  previous_object()->CustomizeObject();
}



//soll verhindern das viele razzis rumlaufen



int feencome(string str)
{
  object ob;
  notify_fail("Wen willst Du womit herauslocken?\n"
      "<locke wen mit was heraus>\n");
  if(!str) return 0;
  if(!present("ELEF", TP))
  {
    write("Du kannst hier nichts herauslocken!\n");
    return 1;
  }

  if(!present("BONBON", TP))
  {
    write("Du hast nichts zum anlocken!\n");
    return 1;
  }


  if(member(({"feen mit bonbon heraus", "farbfeen mit bonbon heraus",
          "farbfee mit bonbon heraus", "fee mit bonbon heraus",
          "farbfeen mit farbfeenbonbon heraus","farbfee mit farbfeenbonbon heraus",
          "feen mit farbfeenbonbon heraus"}),str)!=-1)
  {

    if(present("FF", environment(TP)))
    {
      write("Die Farbfee sagt: He, ich bin ja schon da!!!\n");
      return 1;
    }
    if(!feen)
    {
      write(BS("Du versuchst die Farbfeen aus ihrem Haeuschen herauszulocken...\n"
            "Die Farbfeen teilen Dir mit: "+CAP_TPN+", wir haben keine Lust!\n"
            "Die Farbfeen teilen Dir mit: Komm spaeter wieder!\n"));
      return 1;
    }
    if(feen)
    {
      write(BS("Du versuchst die Farbfeen mit dem Farbfeenbonbon herauszulocken.\n"
            "Auf einmal stuerzt sich eine Horde Farbfeen auf Dich und entreisst "
            "Dir das Bonbon. Danach pruegeln sie sich gar nicht feenhaft um das "
            "Bonbon. Wer es schliesslich isst, bekommst Du nicht genau mit.\n"));
      ob=present("BONBON", TP);
      ob->remove();
      call_out("come_fee", 0);
      feen--;
      return 1;
    }
    return 0;
  }
  return 0;
}

void come_fee()
{
  int i;
  object fee; 
  for (i=0; i<5; i++){
    fee=clone_object("d/dschungel/dante/news/obj/ffee1");
    fee->SetOwner(getuid(TP));
    fee->move(environment(TP), M_TPORT);}

}    

int try(string str)
{
  notify_fail("Wohin willst Du Dich mit der Liane schwingen?\n");
  if (!str) return 0;
  if(str=="mit liane nach suedosten"||
      str=="mit liane nach suedost")
  {
    write("Du greifst die Liane und schwingst Dich davon.");
    TP->move("d/dschungel/dante/news/room/bhaus1", M_GO,
        "sich mit einer Liane davon", "schwingt",
        "schwingt sich mit einer Liane herein");
    return 1;
  }

  else
  {
    write("Du schwingst Dich mit der Liane dumm herum, was aber nichts "
        "bringt. Also zurueck!\n");
    return 1;
  }
  return 0;
}


string farben()
{
  string *col;
  int i;

  col=({"blau","weiss","gelb","schwarz","violett","gruen", "pink",
      "ultramarinblau","hellorange","blaugrau","blaugruen","dunkelrot",
      "tuerkis","ocker","onyxfarben", "hellgruen","gelbbraun","blutrot"});

  i=random(sizeof(col));     
  write("Das Dach ist "+col[i]+".\n");
  i=random(sizeof(col));    
  write("Die Tuere ist "+col[i]+".\n");
  i=random(sizeof(col));    
  write("Das Fenster ist "+col[i]+".\n");
  i=random(sizeof(col));    
  write("Der Kamin ist "+col[i]+".\n");
  //ich weiss, net grad elegeant, aber einfach:)

  return "";
}

int maybeget(string str)
{
  notify_fail("Was willst Du bewundern?\n");
  if(!str) return 0;

  if(!present("ELEF", TP))
  {
    write("Du bewunderst "+capitalize(str)+", was Dir wenig bringt.\n");
    return 1;
  }

  if(present("ELEF", TP))       
  {

    if((color==1)&&(str=="tuerkis"))
    {
      call_out("getdrop", 0);
      return 1;
    }
    if((color==2)&&(str=="gruen"))
    {
      call_out("getdrop", 0);
      return 1;
    }
    if((color==3)&&(str=="gelb"))
    {
      call_out("getdrop", 0);
      return 1;
    }
    if((color==4)&&(str=="rot"))
    {
      call_out("getdrop", 0);
      return 1;
    }
    if((color==5)&&(str=="blau"))
    {
      call_out("getdrop", 0);
      return 1;
    }
    if((color==6)&&(str=="schwarz"))
    {
      call_out("getdrop", 0);
      return 1;
    }
    if((color==7)&&(str=="weiss"))
    {
      call_out("getdrop", 0);
      return 1;
    }
    if((color==8)&&(str=="orange"))
    {
      call_out("getdrop", 0);
      return 1;
    }
    if((color==9)&&(str=="blutrot"))
    {
      call_out("getdrop", 0);
      return 1;
    }
    if((color==10)&&(str=="dunkelgelb"))
    {
      call_out("getdrop", 0);
      return 1;
    }
    if((color==11)&&(str=="blaugruen"))
    {
      call_out("getdrop", 0);
      return 1;
    }

    if((color==12)&&(str=="pink"))
    {
      call_out("getdrop", 0);
      return 1;
    }

    if((color==13)&&(str=="violett"))
    {
      call_out("getdrop", 0);
      return 1;
    }
    else
    {
      write("Du bewunderst "+capitalize(str)+". Findest Du das sinnvoll?\n");
      return 1;
    }
    return 0;
  }          

  return 0;
}


init()
{
  ::init();
  if(interactive(TP)){ call_out("check", 3);}
}



check()
{
  object gewicht, totalgewicht;

  gewicht=TP->QueryProp(P_WEIGHT);
  totalgewicht=TP->QueryProp(P_TOTAL_WEIGHT);

  if( (environment(TP)==TO) &&
      (interactive(TP)) && ( (totalgewicht)>=(gewicht+10000) ) )

  {
    write("Der Ast knirscht verdaechtig unter Deinem Gewicht...\n");
    call_out("down", 15+random(15));
  }
}


void down()
{
  if(environment(TP)!=TO || !TP) {return 0;}    

  write("Du bist viel zu schwer fuer diesen Ast.\n"
      "WUMMMMMMMM!! Unter Dir kracht es und Du zu Boden!!!\n");
  TP->move("d/dschungel/dante/weg/room/grab", M_SILENT+M_TPORT+M_NO_SHOW);

  tell_room("d/dschungel/dante/news/room/bhaus2",
      CAP_TPN+" faellt vom Ast zu Boden!\nWUMMMMMMMMMMMMMMMMM!\n");

  TP->do_damage(10);
}



void getdrop()
{
  object ob;
  ob=clone_object("d/dschungel/dante/news/obj/zucker");
  ob->move(TP, M_NOCHECK);
  write(BS("Du bewunderst genau die richtige Farbe und ploetzlich hast Du etwas in "
        "der Hand.\n"));
  color=random(13)+1;
}

reset()
{
  ::reset();
  feen=1;
}

string fett()
{
  write("Du wiegst im Moment samt Ausruestung "+TP->QueryProp(P_TOTAL_WEIGHT)+".\n");
  return "";
}
