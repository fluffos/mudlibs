
//keller von dschungelpost dante 98 sl
#include "files.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#define NF notify_fail
#define TPM TP->move

#define NIX if(!deep_present("NEWS", TP)) { write(BS("Hmm, irgendetwas haelt Dich davon ab. Vielleicht solltest Du das etwas spaeter als Volontaer noch einmal probieren!\n")); return 1;}

#define FOTONIX1 if(deep_present("FOTO1", TP)) { write("Nein. Hast Du doch schon einmal!\n"); return 1;}
#define FOTONIX2 if(deep_present("FOTO2", TP)) { write("Nein. Hast Du doch schon einmal!\n"); return 1;}




/*
   int cam=1;
   int cam2=1;
   int cam3=1;
   int cam4=1;
   */
create()

{
  ::create();

  SetProp( P_INT_SHORT, "In einem hohlen Baum" );
  SetProp( P_INT_LONG, BS(
        "Du bist nun in dem hohlen Baum unter der Zentrale der Dschungelpost. "
        "Du staunst, als Du siehst wie feudal und angenehm die Reporter "
        "hier unten wohnen. Eine grosse, bequeme Couch, ein Eisschrank, "
        "eine Haengematte, 2 weiche, gepolsterte Sessel machen den "
        "Reportern das Leben so angenehm wie moeglich. Weit und breit "
        "kein Schreibtisch. Eine grosse Uhr haengt an der Wand."));

  AddDetail("leben",
      "Ein ruhiges, gemuetliches Leben.");
  AddDetail("ausgabe",
      "Noch nie ist eine Ausgabe der Dschungelpost erschienen.");  
  AddDetail( ({"decke", "loch"}),
      "Von der Decke haengt eine gedaempfte, kleine Lampe herab. "
      "Ein Loch fuehrt nach oben.");
  AddDetail("boden",
      "Der Boden ist mit weichen Teppichen ausgelegt.");
  AddDetail(({"teppich", "teppiche"}),
      "Weich, dick, dunkelblau.");
  AddDetail(({"wand","waende"}),
      "Die Waende sind mit Holz vertaefelt und sehen sehr nobel aus.");
  AddDetail("holz",
      "Das Holz ist hellbraun und sieht ungemein teuer aus.");

  AddDetail(({"schrank", "eisschrank"}),
      "Der Eisschrank ist gross und strahlt eine angenehme Kaelte aus.");
  AddDetail("kaelte",
      "Herrlich!!!");
  AddDetail(({"matte","haengematte"}),
      "Die Haengematte ist an 2 Haken an der Wand befestigt und schaukelt "
      "leicht.");
  AddDetail("haken",
      "Die Haken wurden in die Wand gebohrt. Einer der beiden sieht etwas "
      "verdreht aus.");
  AddDetail("sessel",
      "Die Sessel sind gepolstert und sehen sehr gemuetlich aus.");
  AddDetail( ({"sprungfeder", "feder"}),
      "Eine Sprungfeder schaut aus dem Sessel heraus, darum sollte man "
      "sich da besser nicht darauf setzen.");
  AddDetail("tisch",
      "Keiner.");
  AddDetail("schreibtisch",
      "Nein, hier ist keiner, hier arbeitet niemand.");
  AddDetail("uhr",
      "Die Uhr ist rund, gross und schwarz. Doch kein Zeiger bewegt sich.");
  AddDetail("zeiger",
      "Die Zeiger stehen still. Niemanden interessiert hier wie spaet es ist "
      "und welche Zeit wir haben. "
      "Vielleicht sollte man das aendern.");
  AddDetail("lampe",
      "Dieses Detail widme ich demjenigen Spieler, der mir mailte, dass das Detail "
      "Lampe fehlt. Vielen Dank, leider weiss ich nicht mehr wer das war, hm...."
      "Die Lampe strahlt supermegahell. Cooles Detail, oder?!");


  AddDetail("zeit",
      "Die Uhr hat eine kleine Kurbel, mit der man sie aufziehen kann.");
  AddDetail("kurbel",
      "Die Kurbel sieht alt und rostig aus.");
  AddDetail("baum",
      "Der Baum ist geraeumiger und viel groesser als er von oben aussieht.");
  AddDetail("zentrale", 
      "Die wahre Zentrale der Dschungelpost liegt ober Dir.");
  AddDetail(({"dschungelpost","post"}),
      "Noch nie ist eine Ausgabe der Dschungelpost erschienen, und nun "
      "verstehst Du auch wieso...");
  AddDetail("reporter",
      "Die Reporter arbeiten nie, sie liegen immer nur hier unten herum...");
  AddDetail("couch",
      "Die Couch ist weich und hat ein lustiges Muster.");
  AddDetail("muster",
      "Grosse und kleine Elefanten.");
  AddDetail(({"elefant","elefanten"}),
      "Die grossen und kleinen Elefanten sehen sehr spassig aus.");
  AddDetail(({"grosser elefant","grosse elefanten"}),
      "Sie troeten und trampeln auf der Couch herum, naja nicht wirklich.");
  AddDetail(({"kleiner elefant", "kleine elefanten"}),
      "Du siehst einen sehr auffaelligen Elefanten, er ist weiss.");
  AddDetail(({"weisser elefant","weissen elefant", "weissen elefanten"}),
      "Vor dem Elefanten steht ein Mann und gibt ihm einen Pilz.");
  AddDetail("mann",
      "Oder auch eine Frau.");
  AddDetail("frau",
      "Weiblich.");
  AddDetail("frucht",
      "Hmm, es scheint ein Trompetenpilz zu sein.");
  AddDetail("trompetenpilz",
      "Hmm, kennst Du, aber hast Du noch nie gesehen.");
  AddDetail("pilz",
      "Trompetenpilz.");

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN:TT_JUNGLE]) );

  AddSound( DEFAULT_SOUND,
      "Du hoerst das Knirschen des Baumes.\n");
  AddSmell( DEFAULT_SMELL,
      "AHH! Hier richt man die pure Natur!");
  AddCmd(( {"kletter", "klettere"}), "klettern");
  AddCmd(({"drehe", "dreh","verdrehe","verdreh"}), "out");
  AddCmd(({"ziehe", "zieh"}), "get1");
  AddCmd(({"oeffne"}), "get2");
  AddCmd(({"lieg", "lege", "sitz","setze"}), "sleep");

  AddItem("d/dschungel/dante/news/obj/rep2", REFRESH_DESTRUCT);
}

int sleep(string str)
{
  object ob1, ob2,c3,c4;
  c3=deep_present("CAM3", TP);
  c4=deep_present("CAM4", TP);

  NF("Wo willst Du Dich hinsetzen oder legen?\n");

  if(str=="in matte"||str=="in haengematte"||
      str=="auf matte"||str=="auf haengematte")
  {
    NIX    
      FOTONIX1
      FOTONIX2
      if(!c3)
      {
        write("Du legst Dich in die Haengematte, ploetzlich beginnt sie hin und "
            "her zu schaukeln. WUMMMM! Du faellst aus der Matte auf den Boden, direkt "
            "auf einen harten Gegenstand, den Du sofort nimmst.\n");
        ob1=clone_object("d/dschungel/dante/news/obj/cam3");
        ob1->move(TP, M_NOCHECK);
        return 1;
      }
    if(c3)
    {
      write("Du legst Dich in die Haengematte, ploetzlich beginnt sie hin und "
          "her zu schaukeln. WUMMMM! Du faellst aus der Matte auf den Boden.\n");
      TP->do_damage(5);
      return 1;
    }
    return 0;
  }      
  if(str=="in sessel"||str=="auf sessel")
  {
    write("Du setzt Dich auf den Sessel.\n"
        "AUA!! Du hast eine herraustehende Sprungfeder uebersehen.\n");
    TP->do_damage(5);
    return 1;
  }
  if(str=="auf couch"||str=="in couch")
  {
    NIX
      FOTONIX1
      FOTONIX2
      if(!c4)
      {
        write("Du legst Dich auf die Couch. Aua! Da piekst etwas. "
            "Du untersuchst die Couch genauer und findest einen kleinen "
            "Gegenstand, den Du sofort nimmst.\n");
        ob2=clone_object("d/dschungel/dante/news/obj/cam4");
        ob2->move(TP, M_NOCHECK);
        return 1;
      }
    if(c4)
    {
      write("Du legst Dich auf die Couch, stehst aber wieder auf. "
          "Nicht bequem genug...\n");
      return 1;
    }
    return 0;
  }
  return 0;
}







int get1(string str)
{
  object ob,c1;
  c1=deep_present("CAM1", TP);
  NF("Was willst Du hier womit aufziehen?\n");
  if(member(({"uhr mit kurbel auf"}),str)!=-1)
  {
    NIX
      FOTONIX1
      FOTONIX2
      if(!c1)
      {
        write(BS("Du versuchst mit der Kurbel die Uhr aufzuziehen, doch "
            "alles was passiert ist ein Rattern und Knattern und dann "
            "faellt Dir ploetzlich ein Gegenstand direkt in die Hand. "
            "Er war hinter der Uhr versteckt!\n"));
        ob=clone_object("d/dschungel/dante/news/obj/cam1");
        ob->move(TP, M_NOCHECK);
        return 1;
      }
    if(c1)
    {
      write(BS("Du versuchst mit der Kurbel die Uhr aufzuziehen, doch "
          "alles was passiert ist ein Rattern und Knattern.\n"));
      return 1;
    }
    return 0;
  }
  return 0;
}               



int get2(string str)
{
  object ob, c2;
  c2=deep_present("CAM2", TP); 
  NF("Was willst Du hier oeffnen?\n");
  if(member(({"eisschrank","schrank"}),str)!=-1)
  {
    NIX
      FOTONIX1
      FOTONIX2
      if(!c2)
      {
        write("Du oeffnest den Kuehlschrank, was Du siehst ist nicht viel. "
            "Ein kleiner Gegenstand, sonst nichts. Kein Essen, keine Getraenke. "
            "Bevor Du die Tuere schliesst, nimmst Du den Gegenstand an Dich.\n");
        ob=clone_object("d/dschungel/dante/news/obj/cam2");
        ob->move(TP, M_NOCHECK);
        return 1;
      }
    if(c2)
    {
      write("Du oeffnest den Eisschrank, er ist leer. Traurig schliesst Du "
          "wieder die Tuere.\n");
      return 1;
    }
    return 0;
  }
  return 0;
}               


int out(string str)
{
  NF("Was willst Du hier drehen?\n"); 
  if(str=="haken"||str=="haken in wand")

  {
    write("Du drehst den Haken in der Wand und ploetzlich oeffnet sich eine "
        "bis dato verborgene Klapptuere, reisst Dich mit und schwupp, bist Du "
        "nicht mehr im hohlen Baum!\n");
    TPM("d/dschungel/dante/weg/room/weg2", M_GO+M_NO_SHOW);
    return 1;
  }
  return 0;
}




int klettern(string str )
{
  NF( "Wohin willst Du klettern?\n" );
  if( !str ) return 0; 
  if( member( ({"oben", "rauf", "hinauf", "nach oben", "durch loch",
          "durch loch rauf"}),str) !=-1 )

  {
    write("Du versuchst nach oben zu klettern, doch schaffst Du es nicht!\n");
    return 1;
  }
  return 0;
}


