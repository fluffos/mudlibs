// ein kleines baumhaus
//veraednert fuer bildquest dante 98 sl
#include "files.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

#define  LOCH (member(loch, getuid(this_player()))!=-1)
string *loch=({});


int zahl=random(50)+50;
int zahl2, zahl3, zahl4, zahl5, hierstift, hiernotiz;

create()

{
  ::create();

  zahl2=random(30)+30;
  zahl3=random(30)+10;
  zahl4=random(50)+50;
  zahl5=random(50)+30;

  SetProp( P_INT_SHORT, "Im einem Baumhaus" );
  SetProp( P_INT_LONG, BS(
        "Du bist nun in der Zentrale der Dschungelpost, doch der Name Zentrale "
        "spottet jeder Beschreibung. Ein kleines Baumhaus mit Dach. Das Inventar "
        "beschraenkt sich auf einen Schreibtisch, einen Stuhl und einen "
        "grossen Schrank. Ein grosser, etwas seltsamer Ventilator surrt "
        "und sorgt fuer kuehle, frische Luft."));
  AddDetail("himmel",
      "Der Himmel wird vom Dach verdeckt.");
  AddDetail("holz",
      "Das Holz, das hier ueberall ist, stammt aus dem Dschungel.");
  AddDetail("inventar",
      "Viel gibt es hier nicht. Stuhl, Schreibtisch, Ventilator, Schrank und ein "
      "grosses Bild, das an der Wand haengt.");
  AddDetail("bild",
      "Es zeigt einen Reporter, der den Balrog interviewt.");
  AddDetail("lade",
      "Die ist sicher sehr wichtig!");
  AddDetail("statistik",
      "Wer die wohl fuehrt...");

  AddDetail("balrog",
      "Der Balrog sieht freundlich aus, komisch, ist er etwa mediengeil?");
  AddDetail("schrank",
      "Der Schrank ist ebenfalls aus Holz und ist ueberfuellt mit Papieren.");
  AddDetail(({"papiere","papier"}),
      "Das Papier stapelt sich, wie soll man hier etwas finden?");
  AddDetail("stuhl",
      "Der Stuhl ist alt und wacklig. Sitzen oder draufsteigen ist keine gute "
      "Idee.");
  AddDetail("idee",
      "?");
  AddDetail(({"tisch","schreibtisch"}),
      "Der Schreibtisch ist ebenfalls aus Holz, recht alt und wurmstichig. "
      "Du findest auch eine kleine Lade.");



  AddDetail(({"wand","waende"}),
      "Die Waende bestehen ebenfalls aus Holz und weisen grosse Fenster auf.");
  AddDetail("fenster",
      "Neben einem der Fenster ist eine Liane.");
  AddDetail("liane",
      "Mit der Liane hast Du Dich durch ein Fenster hereingeschwungen.");
  AddSpecialDetail("zettel", "luege");

  AddDetail("decke",
      "Die Decke ist das Dach.");
  AddDetail("luft",
      "Der Ventilator erzeugt kuehle, frische Luft.");
  AddDetail("ventilator",
      "Was Du siehst erfreut Dich sehr, oder auch nicht. Viele kleine "
      "Zwerge wurden in ein Laufrad gesperrt und muessen hier, hamstergleich, "
      "laufen, laufen und laufen. Damit betreiben sie grosse Rotorblaetter an, "
      "die dann kuehle Luft erzeugen. Ab und zu siehst Du etwas Laengliches, "
      "dass die Zwerge verwenden um sich gegenseitig zu pieksen. Seltsam...");
  AddDetail(({"etwas","laengliches"}),
      "Hmm, scheint ein Stift zu sein. Was wollen die Zwerge mit dem Stift? "
      "Ob sie den Stift wohl hergeben? Ueberhaupt, diese Zwerge sind nicht normal...");
  AddDetail("stift",
      "Ja, es ist einer, und Du willst den haben!");

  AddDetail(({"blaetter","blatt","rotorblatt","rotorblaetter"}),
      "Sie drehen sich schnell, angetrieben durch die Zwerge.");
  AddDetail(({"rad","laufrad"}),
      "In dem Rad sind Zwerge eingesperrt, die hier bis zu ihrem Tod laufen "
      "muessen.");
  AddDetail(({"zwerg","zwerge"}),
      "Die Zwerge im Laufrad sehen gequaelt und ungluecklich aus. Vielleicht, "
      "sollte man ihnen helfen...");


  AddDetail("zwerge",
      "Die Zwerge schuften bis zu ihrem Tod.");
  AddDetail("tod",
      "Aktuelle Statistik:\n"
      ""+zahl2+" tote Zwerge.\n"
      ""+zahl3+" Zwergenselbstmorde.\n"
      ""+zahl4+" Aufstaende der Zwerge.\n"
      ""+zahl5+" Streiks der Zwerge.\n");

  AddDetail(({"haus","baumhaus"}),
      "Du stehst mitten im Baumhaus der Dschungelpost.");
  AddDetail("dach",
      "Das Dach ist flach, aus Holz und schuetzt vor der Sonne.");
  AddDetail("sonne",
      "Hier im Dschungel brennt die Sonne unbarmherzig herab.");
  AddDetail("dschungel",
      "Rings um Dich herum.");
  AddDetail("boden",
      "Am Boden liegen einige Zettel und Notizen herum.");
  AddDetail(({"notizen", "notiz"}),
      "Lies sie!");
  AddReadDetail(({"notiz","notizen"}),
      "Schon wieder ein Reporter toedlich verunglueckt. Das war der "+zahl+" "
      "in diesem Jahr. Aus unserer Dschungelpost, wird wohl nie etwas.");


  AddDetail("zentrale",
      "Der Name Zentrale spottet jeder Beschreibung.");
  AddDetail("name",
      "Das hier ist die Zentrale der Dschungelpost.");
  AddDetail("beschreibung",
      "Tippe <schaue>");
  AddDetail(({"post","dschungelpost"}),
      "Hast Du schon jemals eine Ausgabe der Dschungelpost gesehen?");
  AddDetail("ausgabe",
      "Es gab noch nie eine Ausgabe, weil alle Reporter verungluecken.");
  AddDetail("reporter",
      "Versuche Dein Glueck!");
  AddDetail("glueck",
      "Wirst Du brauchen!");


  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN:TT_JUNGLE]) );

  AddItem("d/dschungel/dante/news/obj/pu", REFRESH_DESTRUCT);

  AddSound( DEFAULT_SOUND,
      "Du hoerst das Singen und Traellern der Voegel. ");
  AddDetail("loch",
      "Durch das kleine Loch im Boden kann man nach unten, in einen hohlen "
      "Baum klettern.");
  AddDetail("baum",
      "Du befindest Dich auf einem hohlen Baum in einem Baumhaus, das auf dem "
      "Baum gebaut wurde.");

  AddSound(({"voegel", "traellern","singen"}),
      "Die Voegel scheinen Dich zu verhoehnen! Na, wer kann ihnen das uebel nehmen.\n");

  AddSmell(({"natur"}),
      "Hmmm, riecht das herrlich!\n");


  AddSmell( DEFAULT_SMELL,
      "AHH! Hier richt man die pure Natur!");
  AddCmd(({"steige","steig"}), "up");
  AddCmd(({"sitz","setze"}), "sitzt");
  AddCmd(( {"kletter", "klettere"}), "klettern");
  AddCmd(({"schwinge", "schwing"}), "try");    
  AddCmd(({"oeffne", "mach","breche","brich"}), "nixda");  
  AddCmd(({"befreie","befrei","hilf","helfe"}), "helpdwarf"); 
  AddCmd(({"durchsuche","suche","wuehle","wuehl"}), "find"); 
}

int find(string str)
{
  object ob, notiz;
  notiz=deep_present("NOTIZ", TP);
  notify_fail("Was willst Du hier durchsuchen oder finden und wo?\n");
  if(str=="papier"|| str=="in papier"||str=="papiere"||str=="im papier"||str=="in papieren")
  {
    if(!present("ELEF", TP))
    {
      write("Du durchsuchst die Papiere, findest aber so sicher nichts!\n");
      return 1;
    }
    if(!notiz)
    {
      ob=clone_object("d/dschungel/dante/news/obj/notiz");
      ob->move(TP, M_GO);
      write("Du durchsuchst die Papiere und findest einen Notizblock.\n");
      return 1;
    }
    if(notiz)
    {
      write("Du durchsuchst die Papiere, findest aber leider nichts. Geduld!\n");
      return 1;
    }
    return 0;
  }
  return 0;
}      

int helpdwarf(string str)
{
  object ob, stift;
  stift=deep_present("STIFT", TP);
  notify_fail("Wem willst Du hier helfen bzw. befreien?\n");
  if(str=="zwerge"||str=="zwerg")
  {
    if(!present("ELEF", TP))
    {
      write("Du kannst den Zwergen nicht helfen!\n");
      return 1;
    }

    if(!stift)
    {
      write("Du versuchst die armen Zwerge zu befreien, doch die Zwerge "
          "wehren sich dagegen. Ja gibt es denn sowas, die Zwerge sind "
          "Masochisten! Trotzdem, die Zwerge wissen, Deine Hilfe doch "
          "zu schaetzen und schenken Dir etwas.\n");
      ob=clone_object("d/dschungel/dante/news/obj/stift");
      ob->move(TP, M_GO);
      return 1;
    }
    if(stift)
    {
      write("Du versuchst den armen Zwergen zu helfen, doch die wollen nicht! "
          "Sie machen das gerne. Da soll einer diese Zwerge verstehen?!?!?\n");
      return 1;
    }
    return 0;
  }
  return 0;
}     


int sitzt(string str)
{
  object knife;
  notify_fail("Wo willst Du sitzen?\n");
  if(str=="auf stuhl"||str=="stuhl")
  {
    if(!present("KILLREP", TP))
    {
      write("Du kannst Dich so nicht auf den Stuhl setzen.\n");
      return 1;
    }

    if((present("KILLREP", TP))&&(deep_present("REPMES", TP)))         
    {
      write("Du hast Dir doch das Messer bereits in den Po gebohrt...\n");
      return 1;
    }
    else

    {
      write(
          "Du setzt Dich auf den Stuhl!!! AUA!!!\n"
          "Irgendein spitzer Gegenstand hat sich mitten in Deinen Po gebohrt.\n"
          "Du ziehst ihn heraus und findest ein spezielles Messer.\n");
      knife=clone_object("d/dschungel/dante/news/obj/repmes");
      knife->move(TP, M_GET);
      return 1;
    }
    return 0;
  }
  return 0;
}



int up(string str)
{
  notify_fail("Wo willst Du hier hinaufsteigen?\n");
  if(str=="auf stuhl")
  {
    if(LOCH)
    {
      write("Das dauernde auf den Stuhlsteigen muss ja sehr fad sein...\n");
      return 1;
    }
    if(!LOCH)
      write("Du steigst auf den Stuhl und da faellt Dir doch glatt von "
          "oben ein Loch im Boden auf!\n");
    loch +=  ({getuid(this_player())});   
    return 1;
  }
  return 0;
}



int nixda(string str)
{
  notify_fail("Was willst Du hier oeffnen?\n");
  if(str=="lade"||str=="lade auf")
  {
    write("Du machst Dich an der Lade zu schaffen, kannst sie aber so sicher "
        "nicht oeffnen.\n");
    return 1;
  }
  return 0;
}

string luege()
{
  write("Auf den Zetteln stehen einige Schlagzeilen:\n");
  switch(random(6))
  {
    case 0:
      write("Balrog verliebt sich in Ayla!\n");
      break;
    case 1:
      write("Nostromo idelt nicht!\n");
      break;
    case 2:
      write("Max ist doch kein Alkoholiker!\n");
      break;
    case 3:
      write("Der Dschungel wird zu betoniert.\n");
      break;
    case 4:
      write("Druiden fressen Elementare auf!\n");
      break;
    case 5:
      write("Berserker werden lammfromm!\n");
      break;
    default: write("Dante buggt nicht mehr!\n");
  }
  return "";
}
reset(){
  ::reset();
  zahl=random(50)+50;
  zahl2=random(30)+30;
  zahl3=random(30)+10;
  zahl4=random(50)+50;
  zahl5=random(50)+30;
}

int try(string str)
{
  notify_fail("Wohin willst Du mit der Liane schwingen?\n");
  if(!str) return 0;
  if(member(({"mit liane nach norden", "mit liane nach sueden", 
          "mit liane nach westen","mit liane nach norwesten"
          "mit liane nach nach suedosten", "mit liane nach nordosten",
          "mit liane nach suedwesten"}), lower_case(str))!=-1)
  {
    write("Du greifst Dir die Liane und schwingst damit nach "+
        CAP(explode(str, " ")[3])+".\n"
        "Das bringt Dir aber wenig, denn hier ist nix. Du schwingst daher wieder "
        "zur Zentrale zurueck.\n");
    return 1;
  }
  if(lower_case(str)=="mit liane nach osten")
  {
    write("Du greifst Dir die Liane und schwingst damit nach Osten.\n");
    TP->move("/d/dschungel/dante/news/room/bhaus1", M_TPORT,
        "mit einer Liane davon", "schwingt sich", 
        "schwingt sich mit einer Liane herein");
    return 1;
  }
  return 0;
}



int klettern(string str )
{
  notify_fail( "Wohin willst Du klettern?\n" );
  if( !str ) return 0; 
  if( member( ({"unten", "nach unten", "runter", "hinunter", "zu boden",
          "hinab"}),str) !=-1 )
    if(!LOCH)
    {
      write("Du musst erst nach oben, um nach unten zu kommen...\n");
      return 1;
    }
    else  

    {
      write("Du kletterst mit grosser Muehe duch das Loch nach unten.\n");
      TP->move("/d/dschungel/dante/news/room/lab", M_GO, "nach unten.","klettert",
          "kommt von oben herab geklettert.");
      return 1;
    }
  return 0;
}
