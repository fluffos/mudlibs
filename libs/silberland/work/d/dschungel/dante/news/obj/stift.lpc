//riesenstein der einem auf den kopf faellt
inherit "std/thing";
#include <language.h>
#include <properties.h>
#include "files.h"

int gesp;

create()
{
   if (!is_clone(this_object())) return;
   ::create();
   AddId(({"STIFT","stift", "STIFTALT","schreibstift","bleistift"}));
   SetProp(P_NAME, "Bleistift");
   SetProp( P_GENDER , MALE );
   SetProp(P_ARTICLE, 1 );
   SetProp(P_SHORT, "Ein Bleistift" );
   SetProp(P_LONG, BS(
   "Das ist ein magischer Bleistift. Du hast ihn von den "
   "Zwergen im Laufrad bekommen. Seine Spitze ist interessant."));
   AddSpecialDetail("spitze", "show");

gesp=0;

    SetProp(P_MATERIAL, ([MAT_WOOD:90, MAT_MAGIC:10]));
   SetProp(P_VALUE,0);
   SetProp(P_WEIGHT,10 );
   SetProp(P_NODROP, 1);
   SetProp(P_NEVERDROP, 1);
  AddCmd(({"schaerfe","schaerf","spitze","spitz"}), "sharp");
  }
  
  int sharp(string str)
     {
     object ob;int mes;
     ob=present("SPITZER", TP);
     notify_fail("Was willst Du hier spitzen?\n");
     if(str=="stift"||str=="spitze"||str=="bleistift")
       {
       if(gesp)
         {
         write("aber dein Stift ist doch schon gespitzt!\n");
         return 1;
         }
       if(!gesp)
       {
        if(!ob)
          {
          write("Aber zum Spitzen braucht man einen Spitzer...\n");
          return 1;
          }
          if(ob)            
          {
     write("Du spitzt mit dem Gebiss den Stift.\n"
 "Danach zerfaellt das Gebiss! Die Maus hat wohl nicht viel vom Zaehneputzen \n"
 "gehalten, so fragil wie ihr Gebiss war!\n");
     ob->remove();
 AddId(({"stift", "STIFT","STIFTNEU","schreibstift","bleistift"}));
      gesp++;
         }
      return 1;
      }
   return 0;
   }
return 0;
}
      

   string show()
     {
     if(!gesp)
       {
       write("Die Spitze ist stumpf.\n");
       }
       if(gesp)
       {
       write("Die Spitze ist spitz! Ideal zum schreiben!\n");
       }
     return "";
     }
            