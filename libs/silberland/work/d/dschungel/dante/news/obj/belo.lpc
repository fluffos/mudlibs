//dante sl 98
//questbelohnung nur 1 mal pro spieler
//x pics pro reset moeglich
inherit "std/thing";
#include <language.h>
#include <properties.h>
#include <moving.h>
#include "files.h"
#define  BSA(x,y) break_string(x,78,y)    

int farbe=10;
string *farben;
string *wieises;     
create()

{
   if (!is_clone(this_object())) return;
   ::create();
   AddId(({"FOTOBELOHNUNG", "kaestchen","kasten"}));
   SetProp(P_NAME, "Kaestchen");
   SetProp( P_GENDER , NEUTER );
   SetProp(P_ARTICLE, 1 );
   SetProp(P_SHORT, "Ein seltsames, buntes Kaestchen" );
   SetProp(P_LONG, BS(
   "Dieses Kaestchen ist kein gewoehnliches Kaestchen. Es ist in der Lage "
   "Bilder von Lebewesen herzustellen. Dazu sitzen im Inneren kleine "
   "Farbfeen, die Du da drinnen eingesperrt hast. Sie malen auf Deinen "
   "Befehl hin sofort ein Bild, das sie Dir dann geben!"));

  SetProp(P_INFO, ("Der Befehl heisst: farbfee(n) <name des lebewesen>\n"
  "Du kannst andere Spieler, Monster, aber auch Gegenstaende malen lassen.\n"));
  

SetProp(P_MATERIAL, ([MAT_MAGIC:10,MAT_MISC_LIVING:10, MAT_STEEL:10, MAT_WOOD:70]));
   SetProp(P_NOGET, 0);   
   SetProp(P_VALUE,10000);
   SetProp(P_NODROP, 1);
   SetProp(P_NEVERDROP, 1);
   SetProp(P_WEIGHT,10 );
   SetProp(P_AUTOLOADOBJ, 1);
   AddCmd(({"farbfeen","farbfee"}), "getpic");
 }
   
int getpic(string str) {
  string npc;
  
  int i, u;
  object ob, pic;
  notify_fail("Was willst Du hier malen lassen?\n");
  
  farben=({"rot","gruen","blau","violett","braun","gelb", "gruen","weinrot",
           "orange","tuerkis","dunkelrot","hellrot","hellblau","dante",
           "angrox","silber","gold","anthrazit","zwiebelgelb",
           "kirschrot","purpur","fleisch","wolken","kirschrot",
           "dunkelviolett","hellviolett","hellorange",
           "zitronengelb","zitronenblau","woodygrau",
           "dunkelblau","gruenblau","ocker","kaki","stahl"});
  wieises=({"schoenes","dummes","interessantes","aufregendes",
           "langweiliges","beeindruckendes","erheiterndes",
           "abgenutztes","zerknittertes","geiles","megageiles",
           "zerknuelltes","bedrohliches","angsteinfloessendes",
           "dantinisches","altruistisches","sexy",
           "abgedroschenes","spannendes","spassiges", "rassiges",
            "lustiges","ekelerregendes","schwachsinnges"});         
  i=random(sizeof(farben));      
  u=random(sizeof(wieises));
  
  if(!str) { 
    write("Die Farbfeen malen nichts!\n"); 
    return 1;
  }
  if(sscanf(str, "%s", npc)) {
    if(!ob=present(npc,environment(TP))) {
      write("Die Farbfeen teilen Dir mit:\n" 
        "Aber "+CAP_TPN+", "+capitalize(npc)+" ist doch nicht hier!\n");
      return 1;
    }

  if(!farbe)
    {
    write(BSA(
    "Leider haben wir im Moment keine Farbe, gedulde Dich ein wenig "+CAP_TPN+"!",
    "Die Farbfeen teilen Dir mit: "));
     return 1;
     }

    else {
      write("Die Farbfeen teilen Dir mit:\n"
            "Zu Befehl, Meister "+CAP_TPN+"!\n"
        "Daraufhin malen sie ein Bild von "+ob->name(WEM)+".\n");
     pic=clone_object("d/dschungel/dante/news/obj/pic");
pic->SetProp(P_SHORT, "Ein "+farben[i]+"farbenes Bild "+ob->name(WESSEN)+"");  
pic->SetProp(P_LONG,BS(
"Dieses Bild haben die Farbfeen im Auftrag von "+CAP_TPN+" gemalt. "
"Es ist ein "+farben[i]+"farbenes Bild "+ob->name(WESSEN)+"."
" Ein wirklich "+wieises[u]+" Motiv!"));
pic->move(TP, M_NOCHECK);
write("Dann geben Dir die Farbfeen das Bild.\n");
  farbe--;
  return 1;
     }
 return 0;
  }
return 0;
}  


reset(){
::reset();
farbe=10;
}
