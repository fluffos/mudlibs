//messer fuer reporterquest....
//nur mit ihm trifft man razzi baba
#include "../def.h"
inherit "std/weapon";
#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Ein Messer");
  SetProp(P_LONG, BS( 
  "Dieses Messer ist weder besonders spitz noch besonders scharf. Eigentlich "
  "ist es sogar ziemlich unbrauchbar...")); 
  SetProp(P_NAME,"Messer");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"messer", "REPMES"}) );
  SetProp(P_INFO, "Dieses Messer kann nicht viel, aber seltsamerweise "
  "trifft es gewisse Reporter besonders gut.\n");
  SetProp(P_WEAPON_TYPE, WT_KNIFE );
  SetProp(P_WC,50);
  SetProp(P_DAM_TYPE,({DT_RIP,DT_BLUDGEON}) );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_SIZE, 30);
  SetProp(P_MATERIAL, ([MAT_STEEL:9, MAT_MAGIC:91]));
  SetProp(P_WEIGHT, 350);
  SetProp(P_MAGIC, 1);
  SetProp(P_VALUE,0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_NODROP, 1);
}
