//riesenstein der einem auf den kopf faellt
inherit "std/thing";
#include <language.h>
#include <properties.h>
#include "files.h"


create()
{
   if (!is_clone(this_object())) return;
   ::create();
   AddId(({"bild", "bildchen"}));
   SetProp(P_NAME, "Bild");
   SetProp( P_GENDER , NEUTER );
   SetProp(P_ARTICLE, 1 );
   SetProp(P_SHORT, "Ein Bild" );
   SetProp(P_LONG, BS(
   "Ein Bild"));
  SetProp(P_INFO, 
  ("Mit diesen Bildern kannst Du Deine Freunde sicher beeindrucken!\n"
  "Wenn Dir das Bild nicht gefaellt, zerreiss es einfach.\n"));


    SetProp(P_MATERIAL, ([MAT_MAGIC:10, MAT_PAPER:90]));
   SetProp(P_NOGET, 0);   
   SetProp(P_VALUE,0);
   SetProp(P_WEIGHT,1 );
AddCmd(({"zerreisse","zerreiss"}), "weg_damit");
}

int weg_damit(string str) {
 notify_fail("Was willst Du zerreisen\n");
   if(str=="bild")  {
   write("Du zerreist das Bild und wirfst es weg!\n");
   remove();
   return 1;
   }
   return 0;
   }
   