//photoapparat, mit dem der spieler fuer quest fotos machen muss
//dante sl 98
inherit "std/thing";
#include <language.h>
#include <properties.h>
#include <moving.h>
#include "files.h"
 
 
int full=0; 
     
create()

{
   if (!is_clone(this_object())) return;
   ::create();
   AddId(({"FOTO1", "kaestchen","kasten"}));
   SetProp(P_NAME, "Kaestchen");
   SetProp(P_AUTOLOADOBJ, 1);
   
   SetProp( P_GENDER , NEUTER );
   SetProp(P_ARTICLE, 1 );
   SetProp(P_SHORT, "Ein seltsames, buntes Kaestchen" );
   SetProp(P_LONG, BS(
   "Dieses Kaestchen ist kein gewoehnliches Kaestchen. Angeblich ist es "
   "in der Lage Bilder zu machen, aber irgendetwas fehlt hier noch..."));

  SetProp(P_INFO, ("Irgendetwas oder jemand kann man in das Kaestchen stecken. "
  "Mit dem Befehl < unt inhalt> kannst Du sehen, was bereits in dem Kaestchen ist.\n"));
  


    SetProp(P_MATERIAL, ([MAT_MAGIC:10, MAT_STEEL:10, MAT_WOOD:80]));
   SetProp(P_NOGET, 0);   
   SetProp(P_VALUE,0);
   SetProp(P_NODROP, 1);
   SetProp(P_NEVERDROP, 1);
   SetProp(P_WEIGHT,10 );
 AddCmd(({"steck","stecke"}), "tues"); 
 AddSpecialDetail("inhalt", "show");
 }
 
string show()
 {
 if(!full)
      {
   write("Das Kaestchen ist leer.\n");
      }
   if(full==1)
     {
   write("Das Kaestchen beinhaltet eine Farbfee.\n");
      }
  if(full>1)
     {
  write("Das Kaestchen beinhaltet "+full+" Farbfeen.\n");
      }
  return ""; 
  }


//reinstecken

  int tues(string str)
    {
    object foto;
    object ob;
    ob=present("FF2", TP);
    notify_fail("Was willst Du in das Kaestchen stecken?!\n");
    if(member(({"fee in kaestchen", "farbfee in kaestchen"}),str)!=-1)
    
    {
            
   if(!ob)
        {
   write("Du hast nichts zum in das Kaestchen stecken.\n");
   return 1;
        }
    
    if(ob)
        {
      if(full==4)
      {
      write("Du steckst die kleine Farbfee in das Kaestchen, es beginnt "
      "im Inneren zu surren und brummen, scheinbar beginnen die Farbfeen "
      "mit ihrer Arbeit und sind bereit.\n");
      foto=clone_object("d/dschungel/dante/news/obj/foto");
      foto->SetProp(P_SHORT, ""+CAP_TPN+"'s seltsames, buntes Kaestchen");
      foto->move(TP, M_NOCHECK);
      remove();
      return 1;
      }
        
    if(full<4)    
      {  
     ob->remove();
    write("Du steckst die kleine Farbfee in das Kaestchen.\n");
    full++;
    return 1;
        }
    return 0;
    }
          
return 0;
  }
     
return 0;
}
