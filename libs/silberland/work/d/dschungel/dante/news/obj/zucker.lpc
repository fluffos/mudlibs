//riesenstein der einem auf den kopf faellt
inherit "std/thing";
#include <language.h>
#include <properties.h>
#include "files.h"

#define  NF notify_fail

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  AddId(({"bonbon", "BONBON","farbfeenbonbon","feenbonbon"}));
  SetProp(P_NAME, "Farfbfeenbonbon");
  SetProp( P_GENDER , NEUTER );
  SetProp(P_ARTICLE, 1 );
  SetProp(P_SHORT, "Ein Farbfeenbonbon" );
  SetProp(P_LONG, BS(
        "Das ist eines der seltenen Farbfeenbonbons. Angeblich sind die Farbfeen "
        "ganz wild daurauf und vergessen jede Vorsicht, wenn man sie damit anlocken "
        "will."));
  SetProp(P_MATERIAL, ([MAT_MAGIC:10, MAT_FOOD:90]));
  SetProp(P_VALUE,0);
  SetProp(P_WEIGHT,1 );
  SetProp(P_INFO, "Wozu das wohl dient?!\n");
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  AddCmd(({"iss","esse", "lutsch","lutsche"}), "wegises");
}

int wegises(string str)
{
  NF("Was willst Du essen?\n");
  if(str=="bonbon"||str=="feenbonbon"||str=="farbfeenbonbon")
  {
    TP->AddPoison(3);
    write("Du isst das Bonbon auf. Das war nicht fuer Dich bestimmt!\n"
        "Es bekommt Dir gar nicht gut. Du laeufst in allen Farben an und "
        "fuehlst Dich sehr mies.\n");
    remove();
    return 1;
  }
  return 0;
}

