//maus mit gebiss dante sl quest
inherit "std/mnpc";     

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "files.h"
#include <mnpc.h>


string owner;
create()
{
  if (!is_clone(ME)) return;
  ::create();
  SetProp (P_SHORT, "Eine Maus");
  SetProp (P_LONG, bs("Die kleine graue Maus blickt Dich mit ihren noch "+
    "kleineren schwarzen Knopfaugen misstrauisch an.\n"));
  SetProp (P_NAME, "Maus");
  SetProp (P_GENDER, FEMALE);
  SetProp(P_RACE, "Nagetier");
  AddId ("maus");
  AddId ("\ndantemaus");
  create_default_npc (5);
  SetProp (P_SIZE, 12);
  SetProp (P_HEAL, 8);
   SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10, T_RANGE_MAX: 45]));   
  SetProp (P_MSGIN, "trappselt herein");
   SetProp(P_MMSGIN, "springt aus der Spalte heraus");   
  SetProp (P_HANDS, ({" mit ihren kleinen Pfoten", 50}));
  SetProp (P_ALIGN, 20);
  SetProp(P_DIE_MSG, " faellt mausetot um.\n");
  call_out("weg_damit", 120);
//absichtlich so gemacht, da sonst vielleicht 20 mauese im raum waeren


}

 void weg_damit()
   {
   write("Die Maus verschwindet zwischen den Blaettern!\n");
   remove();
   }
   

void SetOwner(string str) {
  owner=str;
    }
  string QueryOwner() { return owner; }     
  
  
  
    mixed _query_noattack()
      {
          if ((QueryOwner() != getuid(TP)) && (TP != ME))
                  return "ist von Dir nicht zu treffen!";
                            return 0;
      }
 
 
 void die(int poisondeath)        
 {
 object ob;
 ob=clone_object("d/dschungel/dante/news/obj/spitzer");
 ob->move(TP, M_NOCHECK);
 write("Als die Maus stirbt fliegt ihr Gebiss direkt zu Dir!\n");
 ::die(poisondeath);
 }
                                         
