// dante@SilberLand ausweis fuer august

#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Ein Ausweis");
  SetProp(P_LONG, BS( 
  "Dieser Ausweis zeichnet Dich als offizieller Reporter der Dschungelpost aus!"));
  SetProp(P_NAME, "Ausweis");
  SetProp(P_GENDER, MALE);
  AddId(({"ausweis","NEWS"}));
  SetProp(P_AUTOLOADOBJ, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_MATERIAL, ([MAT_PAPER:80,MAT_GUM:20]));
  SetProp(P_WEIGHT, 20);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
  AddCmd(({"baue", "bau"}), "gofor");
  
}
  int gofor(string str)
  {
  object cam1, cam2, cam3, cam4,fix;
  notify_fail("Was willst Du hier zusammenbauen?\n");
  
  cam1=present("CAM1", TP);
  cam2=present("CAM2", TP);
  cam3=present("CAM3", TP);
  cam4=present("CAM4", TP);
  
  
  if(member(({"kaestchen zusammen","kaestchen"}),str)!=-1)
    {
      if( (cam1)&&(cam2)&&(cam3)&&(cam4) )
         {  
         write("Du baust alle 4 Stuecke zum Kaestchen zusammen.\n");
         cam1->remove();
         cam2->remove();
         cam3->remove();
         cam4->remove();
         fix=clone_object("d/dschungel/dante/news/obj/fotonix");
        fix->SetProp(P_SHORT, ""+CAP_TPN+"'s seltsames, buntes Kaestchen");
        fix->move(TP, M_NOCHECK);
        return 1;
        }
    else
       {
     write("Du hast nichts, oder noch zu wenig um etwas Sinnvolles zu bauen.\n");
     return 1;
       }
   return 0;
   }
  return 0;
  }                 
