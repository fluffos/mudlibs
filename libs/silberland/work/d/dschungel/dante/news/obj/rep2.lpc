//schlafender reporter fuer quest
//kann nix, weiss nix


inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "files.h"
#include <mnpc.h>

object cash;
void create()
{
 
  if (!is_clone(this_object())) return;
     ::create();

                                              
  SetProp(P_SHORT, "Dussel, der schnellste Reporter der Dschungelpost");
  SetProp(P_LONG, BS(
  "Das ist Dussel, der schnellste Reporter des Silberlandes. Dich wundert "
  "nun nicht mehr, dass die Dschungelpost noch nie erschienen ist. Er doest "
  "hier vor sich hin und macht kaum seine Augen auf.\n"));
  
  SetProp(P_ARTICLE, 0);
  SetProp(P_NAME, "Dussel");
  SetProp(P_RACE, "Mensch");
  SetProp(P_GENDER, MALE);
  AddId(({ "dussel", "reporter"}));
  
  SetProp(P_WIMPY,50);
  
  create_default_npc(10);
  SetProp(P_HANDS, ({" mit seinen Haenden",110+random(30),({DT_BLUDGEON}) }));
  SetProp(P_BODY, 20+random(10));
  SetProp(P_SIZE, 200);
  SetProp(P_ALIGN, -300);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_NOATTACK, "schlaeft doch! Du Verbrecher!\n");
  SetProp(P_MSGIN, "schlafwandelt herein");
  SetProp(P_MSGOUT, "rast auf der Suche nach Neuigkeiten");
  SetProp(P_MMSGIN, "schlafwandelt herein");
  SetProp(P_MMSGOUT, "rast neugierig davon");

  SetProp(P_NOCORPSE, 0 );
  
  AddInfo(DEFAULT_INFO,({        
   "sagt: Ich will schlafen....\n",
   "schnarcht nur laut.\n",
   "sagt: Gib Ruhe, ich schlafe, eh, ich arbeite...\n",
   "sagt: Frag einen anderen Reporter.\n",
   "sagt: Nichts ist so alt wie die Zeitung von gestern!\n",
   "traeumt nur...\n"}));
  SetProp( P_REJECT, ({ REJECT_DROP,
    "Dussel schlaeft doch....\n" }) );

  SetChats(10, ({
     "Dussel schnarcht laut.\n"
     "Dussel traeumt vom weissen Elefanten.\n",
     "Dussel schlaeft unruhig.\n",
     "Dussel spricht im Traum...\n",
     "Dussel murmelt etwas vom weissen Elefanten und den Steingiganten...\n",
     "Dussel schnarcht.\n",
     "Dussel dreht sich um.\n",
     "Dussel traeumt von den Steingiganten und dem weissen Elefanten...\n"}));
     
  SUID;
  cash=CLONEOB("/obj/money");
  cash->SetProp(P_AMOUNT, random(300)); 
  cash->move(ME);     
    
    
      
  CLONEME ("/d/ebene/lamuerte/wwald/obj/sschuhe");
  CLONEME("/d/ebene/obj/ruestung/otterfell");
  command("trage alles");

}

