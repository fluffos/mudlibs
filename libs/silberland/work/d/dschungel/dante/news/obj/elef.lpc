// dante@SilberLand ausweis fuer august

#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Eine kleine, weisse Elefantenstatue");
  SetProp(P_LONG, BS( 
  "Das ist eine Statue, die einen kleinen, weissen Elefanten darstellt."));

  SetProp(P_NAME, "Statue");
  SetProp(P_GENDER, FEMALE);
  AddId(({"statue","ELEF","elefantenstatue"}));
  SetProp(P_NEVERDROP, 1);
  SetProp(P_MATERIAL, ({MAT_IVORY,MAT_MAGIC}));
  SetProp(P_WEIGHT, 20);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_INFO, "Mit dem Befehl <trompete> kann Dir diese Statue den Weg "
  "zum weissen Elefanten weisen...\n");
  SetProp(P_NODROP, 1);
  AddCmd("trompete", "gofor");  
}
  int gofor(string str)
  {
  if(file_name(environment(TP))==("/d/dschungel/dante/stein/room/stein30"))
    {
    write("Die Statue trompetet auf einmal laut und Du hoerst ein "
    "lautes Trompeten von irgendwoher.\n"
    "Ploetzlich schnellt ein weisser Ruessel aus der Wand und "
    "zieht Dich mit sich!\n");
    TP->move("/d/dschungel/dante/stein/room/elefraum", M_TPORT+M_SILENT);
    return 1;
    }
    
    
    if(file_name(environment(TP))==("/d/dschungel/dante/stein/room/stein10"))   
    {
    write("Die Statue trompetet und man hoert von irgendwoher ein leises "
    "Trompeten! Du musst dem Ziel sehr nahe sein!\n");
    return 1;
    }
    
    if(file_name(environment(TP))==("/d/dschungel/dante/stein/room/stein3"))   
    {
    write("Die Statue trompetet und man hoert von irgendwoher ein sehr leises "
    "Trompeten! Du musst dem Ziel sehr nahe sein!\n");
    return 1;
    }
    
    if(file_name(environment(TP))==("/d/dschungel/dante/stein/room/stein9"))   
    {
    write("Die Statue trompetet und man hoert von irgendwoher ein sehr leises "
    "Trompeten! Du musst dem Ziel sehr nahe sein!\n");
    return 1;
    }
    
    else
    {
    write("Die Statue trompetet, aber sonst hoert man nichts!\n");
    return 1;
    }
    return 0;
    }
    
    
