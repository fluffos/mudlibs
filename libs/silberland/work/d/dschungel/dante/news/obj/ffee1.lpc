//farbfeen fuer quest
inherit "std/mnpc";
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "files.h"
#include <mnpc.h>    


string owner;


create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine kleine Farbfee");
  SetProp(P_LONG, BS(
   "Das ist eine Farbfee. Klein, zierlich und ueberall mit Farben angekleckst. "
   "Irgendwie sieht sie sehr putzig aus."));  
  SetProp(P_NAME, "Farbfee");
  SetProp(P_GENDER, FEMALE);
  AddId(({"FF", "farbfee", "fee"}));
  
  create_default_npc(1);
  SetProp(P_HANDS, ({" mit ihren winzigen Zaehnchen", 10, DT_POISON}));
  SetProp(P_RACE, "Fee");
  SetProp(P_SIZE, 3);
  SetProp(P_ALIGN, 0);

  SetProp(P_MSGIN, "fliegt herein");
  SetProp(P_MSGOUT, "fliegt");
  SetProp(P_MMSGIN, "fliegt wild aus dem Haeuschen heraus");
  SetProp(P_MMSGOUT, "fliegt wieder in ihr Haeuschen zurueck");
  SetProp(P_DIE_MSG,  " fliegt wieder in ihr Haeuschen zurueck.\n");
  SetProp(P_DEFAULT_INFO, "sagt: Belaestige uns nicht.\n");
  SetProp(P_NOCORPSE, 1);
    

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Die Farbfee kann Deine Sachen doch gar nicht tragen.\n" }) );

  SetProp(P_AGGRESSIVE,0);
  SetProp(P_MAX_HANDS, 0);


AddInfo(({"farbe","farben"}), 
"Wir sind Farbe und wir machen Farbe", "sagt: ");
AddInfo("haeuschen",
"Na, da wohnen wir, Du Depp!", "sagt: ");
AddInfo("bonbon",
"schmatzt laut.");
AddInfo(({"farbonbon","farbfeenbonbon"}),
"Los besorg welche!", "lacht: ");

 AddCmd(({"fange", "fang"}), "tryget");
}


void SetOwner(string str) {
  owner=str;
}
    
    
string QueryOwner() { return owner; }     
       
tryget(string str)
  {
  notify_fail("Wen oder was willst Du hier einfangen?\n");
  if (!str)
      {
      write("Du versuchst Deinen Po zu fangen, doch das klappt nicht so recht. "
      "Er scheint wohl zu dick zu sein!\n");
      say(""+TPN+" versucht sich selbst zu fangen! Verliert aber gegen sich "
      "selbst.\n");
      return 1;
      }
      
  if (member(({"fee ein","fee","farbfee", "farbfee ein"}),str)!=-1)
    {
    
     if ((QueryOwner() != getuid(TP)) && (TP != ME))      
     {
     write("Die Farbfee zeigt Dir die lange Nase!\n");
     return 1;
     }
     
    else
    
    switch(random(10))
         {
         case 0 .. 3:
         write("Du versuchst die Farbfee zu fangen, doch sie schluepft zwischen "
         "Deinen Haenden hindurch.\n");
         break;
         case 4 .. 6:
         write("Du packst blitzschnell zu und faengst eine kleine "
         "Farbfee ein.\n");
         call_out("weg", 0);
         break;
         case 7 .. 9:
         write("Du versuchst die Farbfee einzufangen, doch sie beisst "
         "Dir blitzschnell in die Hand!\n");
         TP->do_damage(3);
         break;
         default: write("BUG!\n");
        } 
       return 1;
     }
  return 0;
  }

   void reset()
   {
   ::reset();
   write("Die Farbfee fliegt wieder in ihr Haeuschen zurueck.\n");
   TO->remove();
   }
   
 
   weg()
     {
     object wu;
     wu=clone_object("/d/dschungel/dante/news/obj/ffee2.lpc");
     wu->move(TP, M_NOCHECK);
     TO->remove(1);
     }
     
     
