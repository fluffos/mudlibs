//riesenstein der einem auf den kopf faellt
inherit "std/thing";
#include <language.h>
#include <properties.h>
#include "files.h"

int x=0;

create()
{
   if (!is_clone(this_object())) return;
   ::create();
   AddId(({"spitzer", "SPITZER","gebiss"}));
   SetProp(P_NAME, "Maeusegebiss");
   SetProp( P_GENDER , NEUTER );
   SetProp(P_ARTICLE, 1 );
   SetProp(P_SHORT, "Ein Gebiss einer Maus" );
   SetProp(P_LONG, BS(
  "Das ist das Gebiss einer Maus. Es ist scharf und sehr spitz.\n"));

    SetProp(P_MATERIAL, ([MAT_BONE:90, MAT_MAGIC:10]));
   SetProp(P_VALUE,0);
   SetProp(P_WEIGHT,10 );
  
SetProp(P_INFO, "Hmm, irgendwie koennte man ja damit etwas "
   "schaerfen oder so...!\n"
   "Aber nur wenn man den richtigen Gegenstand dafuer hat...\n");
   
  
  
   SetProp(P_NODROP, 1);
   SetProp(P_NEVERDROP, 1);
   
 }
  reset(){
  ::reset();
  x++;
  if(x>=5)
    {
    write("Das Maeusegebiss zerfaellt zu Staub.\n");
    remove();
    }
 }
 
 
 