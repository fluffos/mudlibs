inherit "std/thing"; 
#include <language.h>
#include <properties.h>
#include <combat.h>
#include <defines.h>
#include <moving.h>
#include "files.h"

create()

{
 if(!is_clone(this_object())) return;
  thing::create();
  SetProp(P_SHORT,"Ein Heft mit Nacktbildern");
  SetProp(P_LONG,BS(
  "Du haelst ein Heft mit Nacktbildern in den Haenden. Tja, das hat Dir "
  "Pu Litza nicht gesagt, dass es sich um sein Privateigentum handelt "
  "und er es nur wieder zurueck haben will. Der Inhalt interessiert "
  "Dich sicher..."));

  AddDetail("inhalt",
  "Lies mal...");
  AddReadDetail(({"inhalt","heft"}),"@@sho@@");
  
  
  SetProp(P_VALUE,0);
  SetProp(P_WEIGHT,100);
  SetProp(P_GENDER, NEUTER);
  SetProp(P_NAME,"Heft");
  SetProp(P_MATERIAL, ([MAT_PAPER:100]));
  SetProp(P_INFO, ("Wirklich schweinisch ist dieses Heft nicht...\n"));
  
  AddId(({"nacktbilder", "porno","heft", "bilder"}));
  SetProp(P_NOBUY, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);

}

sho()
   {
   
  domainshout(CAP_TPN+" versucht pornographische Hefte zu lesen!!!\nSo ein Ferkel!!!PFUI!!!\n");
    return ("Du Ferkel! Lass das ja sein! Schaem Dich!\n");
    }
    
         
