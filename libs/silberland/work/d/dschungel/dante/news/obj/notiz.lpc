//notizblock fuer quest
inherit "std/thing";
#include <language.h>
#include <properties.h>
#include "files.h"


create()
{
   if (!is_clone(this_object())) return;
   ::create();
   AddId(({"notizblock", "block", "NOTIZ"}));
   SetProp(P_NAME, "Notizblock");
   SetProp( P_GENDER , MALE );
   SetProp(P_ARTICLE, 1 );
   SetProp(P_SHORT, "Ein Notizblock" );
   SetProp(P_LONG, BS(
   "Das ist ein Notizblock, der wohl einem Reporter gehoert. Er besteht "
   "nur mehr aus einem Blatt, das Dir aber reicht."));

    SetProp(P_MATERIAL, ([MAT_WOOD:90, MAT_PAPER:10]));
   SetProp(P_VALUE,0);
   SetProp(P_WEIGHT,10 );
   SetProp(P_NODROP, 1);
   SetProp(P_NEVERDROP, 1);
  }
