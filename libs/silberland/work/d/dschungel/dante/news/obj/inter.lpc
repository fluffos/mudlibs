//notizblock fuer quest
inherit "std/thing";
#include <language.h>
#include <properties.h>
#include "files.h"


create()
{
  if (!is_clone(this_object())) return;
  ::create();
  AddId(({"notizblock", "block", "INTER"}));
  SetProp(P_NAME, "Notizblock");
  SetProp( P_GENDER , MALE );
  SetProp(P_ARTICLE, 1 );
  SetProp(P_SHORT, "Ein Notizblock" );
  SetProp(P_LONG, BS(
        "Das ist der Notizblock, auf dem Du das Interview mit dem weissen Elefanten "
        "geschrieben hast. "));
  SetProp(P_MATERIAL, ([MAT_WOOD:90, MAT_PAPER:10]));
  SetProp(P_VALUE,0);
  AddDetail("interview",
      "Lies es!");
  AddReadDetail("interview",
      "Du hast doch keine Lust es zu lesen, war ja auch sehr fad...");
  SetProp(P_WEIGHT,10 );
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
}
