//pilz fuer bild quest dante sl 98
inherit "std/food";

#include <properties.h>
#include <food.h>
#include "files.h"


int weg=6;
create()
{
  if (!is_clone(ME)) return;
  ::create();
  SetProp (P_SHORT, "Ein Trompetenpilz");
  SetProp (P_LONG, BS(
  "Das ist also ein Trompetenpilz. Was an ihm so toll sein soll, ist "
  "Dir ein Raetsel..."));
  SetProp (P_NAME, "Trompetenpilz");
  SetProp (P_GENDER, MALE);
  SetProp (P_VALUE, 100);
  SetProp (P_WEIGHT, 10);
  SetProp(P_SIZE, 10);
  SetProp (P_NOBUY, 1);
  SetProp(P_MATERIAL, ({MAT_MUSHROOM}));
  SetProp(P_INFO, ("Dieser Pilz verfault schnell, also eile...\n"));
  AddId (({"pilz","TRPILZ","trompetenpilz"}));
  SetProp (P_FOOD_INFO, ([F_HEAL: 0, F_SOAK: 10, F_ALCOHOL: 0, F_POISON: 3]));
}

BeimEssen()
{
write ("Du Idiot isst den Trompetenpilz.\n");
say (TPN+" isst einen Trompetenpilz, schoen bloed....\n");
return ::BeimEssen();
}

reset()
  {weg--;
  ::reset();
  if(weg==0)
  {
  write("Der Trompetenpilz verfault und zerfaellt dann.\n");
  remove();
  }
}
  