//farbfee starr fuer kamera

#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

int runde=0;

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Eine kleine Farbfee (gefangen)");
  SetProp(P_LONG, BS( 
   "Das ist eine von Dir gefangene Farbfee. Sie ruehrt sich aus Angst nicht mehr."));    
    SetProp(P_INFO, "Diese Farbfee solltest Du verwenden um....\n");
    
  SetProp(P_NAME, "Farbfee");
  SetProp(P_GENDER, FEMALE);
  AddId(({"FF2", "fee", "farbfee"}));
  SetProp(P_MATERIAL, ([ MAT_ANIMAL:100]) );
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  
}
   reset()  {
   ::reset();
   runde++;
   if(runde>=5)  {
   write("Deine Farbfee wird wieder wach und fliegt davon!\n");
   }
   }
   
