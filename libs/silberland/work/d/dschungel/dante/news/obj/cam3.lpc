//photoapparat, mit dem der spieler fuer quest fotos machen muss
//dante sl 98
inherit "std/thing";
#include <language.h>
#include <properties.h>
#include <moving.h>
#include "files.h"


     
create()

{
   if (!is_clone(this_object())) return;
   ::create();
   AddId(({"CAM3", "teil"}));
   SetProp(P_NAME, "Teil");
   SetProp( P_GENDER , MALE );
   SetProp(P_ARTICLE, 1 );
   SetProp(P_SHORT, "Ein seltsamer, bunter Teil" );
   SetProp(P_LONG, BS(
   "Das ist ein kleiner Teil eines seltsamen Kaestchens. Er ist bunt. "
   "Leider weisst Du nicht wozu er dient."));   
    SetProp(P_MATERIAL, ([MAT_MAGIC:10, MAT_STEEL:10, MAT_WOOD:80]));
   SetProp(P_NOGET, 0);
   SetProp(P_INFO, "Das ist der dritte Teil des magischen Kaestchens.\n");   
   SetProp(P_VALUE,0);
   SetProp(P_NODROP, 1);
   SetProp(P_NEVERDROP, 1);
   SetProp(P_WEIGHT,10 );
 }
