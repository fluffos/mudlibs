//quest npc fuer bilderquest dante sl 98
//pu litza:))

inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "files.h"
#include <mnpc.h>
#define  BSA(x,y) break_string(x,78,y)           
#define QUESTKEY "Die rasenden Dschungelreporter"

int runden=0;
object cash;
void create()
{

  if (!is_clone(this_object())) return;
  ::create();


  SetProp(P_SHORT, "Pu Litza");
  SetProp(P_LONG, BS(
        "Das ist Pu Litza, der bekannte Chef der Dschungelpost. Er leidet sehr unter "
        "seinen dummen Reportern, die nichts, aber auch gar nichts, koennen."));
  SetProp(P_ARTICLE, 0);
  SetProp(P_NAME, "Pu Litza");
  SetProp(P_RACE, "Mensch");
  SetProp(P_GENDER, MALE);
  AddId(({"pu litza","litza", "pu", "reporter"}));

  SetProp(P_WIMPY, 0);

  SetProp(P_INFO, BS("Pu Litza kann Dir sicher weiterhelfen. "
        "Und wenn er es nicht kann, dann frage einfach den Waechter des Dschungels."));

  create_default_npc(15);
  SetProp(P_HANDS, ({" mit seinen Reporterhaenden",110+random(30),({DT_BLUDGEON}) }));
  SetProp(P_BODY, 50+random(10));
  SetProp(P_SIZE, 200);
  SetProp(P_ALIGN, 300);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_NOATTACK, 0);//nuur im mom so
  SetProp(P_MSGIN, "rast neugierig herein");
  SetProp(P_MSGOUT, "rast auf der Suche nach Neuigkeiten");
  SetProp(P_MMSGIN, "rast neugierig herein");
  SetProp(P_MMSGOUT, "rast neugierig davon");

  AddInfo(({"waechter","dschungelwaechter"}),
      "Der Waechter des Dschungels weiss eigentlich recht viel. Trotzdem steht er "
      "den ganzen Tag nur bloed herum. Schoen bloed...", "sagt: ");

  AddInfo("hilfe",
      "So, so, Du willst Hilfe...", "grinst: ");

  SetProp(P_DIE_MSG,  " schreit sterbend: Na, wenn das keine Schlagzeilen gibt!\n");
  SetProp(P_NOCORPSE, 0 );
  AddInfo("dante",
      "Dante hat mich verbrochen.","lacht bloed: ");
  AddInfo(({"bild","bilder"}),
      "Wichtige Dokumente!", "sagt: ");
  AddInfo("silberland",
      "Hmm, was ist das?", "sagt: ");

  AddInfo(({"nacktbild","nacktbilder"}),
      "Davon weiss ich nichts!", "luegt: ");
  AddInfo("zeitung",
      "Die allerbeste ist die Dschungelpost!", "sagt: ");
  AddInfo("post",
      "Du meinst unsere Dschungelpost...", "sagt: ");
  AddInfo("dschungelpost",
      "Die Dschungelpost ist die beste aller Zeitungen!!!", "sagt: ");
  AddInfo(({"slp","SLP"}),
      "Lahmes Blatt, keine Konkurrenz!", "schimpft: ");
  AddInfo("reporter",
      "Wenn Du einer werden willst, dann tippe: <volontaer> ein!", "sagt: "); 
  AddInfo("pu",
      "Das bin ich!", "sagt: ");
  AddInfo("litza",
      "Das bin auch ich!", "lacht: ");
  AddInfo("elefant",
      "Hmm, der weisse Elefant, ja den gibts angeblich!", "sagt: ");
  AddInfo("weisser elefant",
      "Irgendwo im Silberland lebt der...", "sagt: ");
  AddInfo("dussel", 
      "Der Penner!", "flucht: ");
  AddInfo(({"kasten","kaestchen"}),
      "Hm, mit dem kann man Bilder machen, wenn man kann. "
      "Alles was ich darueber weiss ist, dass er aus 4 Teilen besteht die man "
      "zusammensetzen muss. Und dann muss noch irgendwas rein, dass Farbe hat.",
      "sagt: ");
  AddInfo(({"teile","teil"}),
      "Hm, wo die sind, weiss ich nicht. Tut mit leid!", "sagt: ");
  AddInfo("farbe",
      "Hmm, irgendwo im Dschungel, nicht weit von hier, wohnen die "
      "Farbfeen.", "sagt: ");
  AddInfo(({"fee","farbfee","farbfeen"}),
      "Die Farbfeen haben moeglicherweise etwas mit dem seltsamen "
      "Kasten zu tun...", "grinst haemisch: ");

  AddInfo("razzi",
      "Der miese /&%)(/(/(!\n", "flucht: ");
  AddInfo("baba",
      "Hmm, frag ihn doch wo er ist...", "sagt: ");
  AddInfo("interview",
      "Tja, dafuer braucht man einen Stift und einen Block, denke ich mal...",
      "hmmt: ");
  AddInfo(({"block","notizblock","stift"}),
      "Braucht man fuer ein Interview, ja stimmt!", "grinst: ");




  AddInfo(DEFAULT_INFO,({        
        "sagt: Sorry, muss recherchieren.\n",
        "sagt: Keine Zeit, ich recherchiere grad.\n",
        "sagt: Hmm, weiss nicht...\n",
        "sagt: Frag einen Erzmagier.\n",
        "sagt: Nichts ist so alt wie die Zeitung von gestern!\n",
        "sagt: Weisst Du was neues?\n",
        "sagt: Los, erzaehl mir Neuigkeiten!\n",
        "sagt: Angeblich ist Dante ein Wurstmagier...\n",
        "sagt: Los, gib mir News, ich zahle gut?\n"}));

  AddInfo("erzmagier",
      "Hmm, ist das was zum trinken?", "lacht: ");    
  SetProp( P_REJECT, ({ REJECT_DESTRUCT,
        "Pu Litza sagt: Was soll ich damit?!\n"}));
  SetProp(P_SPELLRATE,60);


  AddInfo(({"tijara","gouverneur"}),
      "Frueher war unsere Zentrale in Tijara, doch angeblich haben wir "
      "bloede Geruechte ueber eine Liasion des Gouverneurs erfunden, und so "
      "mussten wir hier herziehen.", "sagt: ");


  AddSpell(3,250,
      "Pu Litza bewirft Dich mit Skandalen!\n",
      "Pu Litza bewirft @WEN mit Skandalen!\n",
      DT_TERROR,([SP_SHOW_DAMAGE:1]));
  AddSpell(3, 300,
      "Pu Litza schleudert Dich zu Boden!\n",
      "Pu Litza schleudert @WEN zu Boden!\n",
      DT_TERROR,([SP_SHOW_DAMAGE:1]));    

  AddSpell(1,350,
      "Pu Litza rammt Dich nieder.\n",
      "Pu Litza rammt @WEN nieder.\n",
      DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));



  SetChats(3, ({
        "Pu Litza sagt: Wann gibts endlich die erste Ausgabe!!!\n",
        "Pu Litza sucht in seinen Papieren.\n",
        "Pu Litza ruelpst.\n",
        "Pu Litza sagt: Ich brauche Skandale!\n",
        "Pu Litza fragt Dich: Weisst Du etwas ueber die Skandale der Erzmagier?\n",
        "Pu Litza fragt: Stimmt es, dass Midas abgebrannt ist?\n",
        "Pu Litza murmelt irgendetwas.\n",
        "Pu Litza sagt: Man, hier findet man auch gar nichts wieder!\n"}));
  set_living_name("pu");
  AddInfo(({"erzmagier","magier"}),
      "Die Erzmagier sind nur dazu da, die anderen Magier und Spieler "
      "zu nerven und zu quaelen!", "lacht: ");
  AddInfo(({"spieler","seher"}),
      "Spieler und Seher sind sowieso alle bloed!", "sagt: ");

  SUID;
  cash=CLONEOB("/obj/money");
  cash->SetProp(P_AMOUNT, random(300)); 
  cash->move(ME);     
  CLONEME("/d/gebirge/angrox/quest/feder");
  CLONEME("/d/ebene/lamuerte/wwald/obj/sschuhe");
  CLONEME("/obj/misc/kissen");
  CLONEME("/d/gebirge/angrox/obj/robe");
  CLONEME("/d/dschungel/dante/stein/obj/typo");
  command("ziehe alles an");


  AddCmd("volontaer", "start_quest");
  AddCmd("bilder", "quest_bilder");  
  AddCmd("auftrag", "quest_ende");
  AddCmd("erledigt", "GIVEQUEST");

  AddInfo(({"syntax","hilfe"}),
      "Um die Quest zu starten tippe <volontaer>.\n"
      "Wenn Du das Heft hast tippe <bilder>.\n"
      "Wenn Du das Interview hast tippe <auftrag>.\n"
      "Wenn Du alle Bilder malen hast lassen tippe <erledigt>.\n",
      "sagt: ");

}

int GIVEQUEST()
{
  object foto, belohnung, elef, ausweis;
  belohnung=clone_object("d/dschungel/dante/news/obj/belo");
  foto=present("FOTOFERTIG", TP);
  if(!deep_present("FOTOFERTIG", TP))
  {
    write(BSA(
          "Du bist nicht fertig mit dieser Aufgabe, vergeude meine Zeit nicht, "
          "Du Wurstie!", "Pu Litza sagt: "));
    return 1;
  }


  if(present("FOTOFERTIG", TP))
  {
    write(BS("Pu Litza freut sich und klopft Dir auf die Schulter.\n"));
    write(BSA(
          "Gratuliere "+CAP_TPN+"! Du hast es wirklich geschafft! Ich bin "
          "beeindruckt! Nun glaube ich wieder an die erste Ausgabe der "
          "Dschungelpost. Hier Dein Geschenk!!! Achja, "
          "ich nehme Dir noch den Ausweis und die Statue ab.",
          "Pu Litza sagt: "));
    write(BS("Daraufhin nimmt er Dir die alte Kamera weg und beginnt "
          "mit der ersten Ausgabe der Dschungelpost weiterzuarbeiten!\n"));
    foto->remove();

    if(deep_present("FOTOBELOHNUNG", TP) || TP->QueryQuest(QUESTKEY))
    {
      write(BS("Pu Litza sagt: Tut mir leid, aber wozu eine zweite Kamera!\n"));
      return 1;
    }

    if(!deep_present("FOTOBELOHNUNG", TP) && !TP->QueryQuest(QUESTKEY))
    {
      ausweis=deep_present("NEWS", TP);
      elef=deep_present("ELEF", TP);

      if(elef)  {
        elef->remove();
      }
      if(ausweis)  { ausweis->remove();}




      this_player()->GiveQuest(QUESTKEY);
      write_file("/log/quests/news", 
          dtime(time())+": "+capitalize(getuid(this_player()))+ " loest die Quest.\n");
      belohnung->move(TP, M_NOCHECK);
      belohnung->SetProp(P_SHORT, ""+CAP_TPN+"'s seltsames buntes Kaestchen.");
      return 1;
    }
    return 0;
  }
  return 0;
}



int quest_bilder()
{
  object elef;
  object pic;
  pic=deep_present(""+CAP_TPN+"PORNO", TP);
  if(!pic)
  {
    write(BSA(
          "Du Idiot, Du hast gar keine Bilder, und wenn Du "
          "welche hast, dann sind sie nicht legal erworben!",
          "Pu Litza flucht: "));
    return 1;
  }

  if(pic)
  {
    write(BS("Pu Litza wird rot, schaemt sich und grummelt ein bisschen.\n"));
    write(BSA(
          "Ich hoffe, Du hast sie Dir nicht angesehen, die gehen Dich nichts an! "
          "Egal, gut, Du hast bewiesen, dass Du das Zeug zum Reporter hast! "
          "Nun ein etwas schwierigerer Auftrag. Besorg mir ein Interview "
          "mit dem weissen Elefanten, der irgendwo im Silberland lebt. "
          "Bisher ist es noch keinem meiner Reporter gelungen eines zu bekommen! "
          "Der weisse Elefant hat angeblich sehr hohe Ansprueche, mehr weiss ich "
          "selbst nicht. Was Dir aber sicher helfen wird, ist diese Statue. "
          "Wenn Du wirklich ein Interview bekommen solltest, komm wieder her "
          "und tippe <auftrag>."
          " Und nun verschwinde, ich muss meine Bilder studieren!",
          "Pu Litza sagt: "));
    write(BS("Daraufhin drueckt er Dir eine kleine Statue in die Hand, "
          "nimmt Dir die Bilder weg und dreht sich um!\n"));
    elef=clone_object("d/dschungel/dante/news/obj/elef");
    elef->move(TP, M_NOCHECK);
    pic->remove();
    return 1;
  }
  return 0;
}

int quest_ende()
{
  object in;
  object ausweis;
  in=deep_present(""+CAP_TPN+"INTER", TP);

  if(!in)   
  {
    write(BSA(
          "Du dummer Sack! Kommst ohne Interview, und wenn Du eines hast, "
          "dann hat Dir ein Magier geholfen!", "Pu Litza flucht: "));
    return 1;
  }
  if(in)
  {   
    write(BS("Pu Litza staunt und freut sich ueber das Interview!\n"));
    write(BSA(
          ""+CAP_TPN+", ich bin beeindruckt! Das war keine schlechte "
          "Leistung! Hier, ich gebe Dir Deinen persoenlichen Ausweis der "
          "Dschungelpost! Dein naechster Auftrag ist es mir Bilder von "
          "Lebenwesen aus dem gesamten Silberland zu bringen! Aber sei "
          "vorsichtig, das kann sehr gefaehrlich werden! Ein Problem "
          "gibt es aber, ich habe nichts mit dem Du Bilder machen kannst. "
          "Das musst Du Dir schon selbst besorgen! Und nun los! "
          "Wenn Du alle Bilder gemacht hast, komm zu mir und tippe <erledigt>. ", 
          "Pu Litza sagt: "));
    in->remove();
    ausweis=clone_object("d/dschungel/dante/news/obj/ausweis");
    ausweis->SetProp(P_SHORT, CAP_TPN+"'s Ausweis der Dschungelpost");
    ausweis->move(TP, M_NOCHECK);
    return 1;
  }
  return 0;
}






int start_quest()
{
  object ob;

  if(deep_present("ELEF", TP))
  {
    write(BS("Pu Litza sagt: Aber Du bist doch schon Reporter!\n"));
    return 1;
  }

  if(deep_present("NEWS", TP))
  {
    write(BS("Pu Litza sagt: He, Du bist schon Reporter!\n"));
    return 1;
  }
  if(deep_present("KILLREP", TP))
  {
    write(BS("Pu Litza sagt: Du bist schon Volontaer, hau ab!\n"));
    return 1;
  }

  else
  {

    write_file("/d/dschungel/dante/news/log/quest.start",
        ctime(time())+": "+CAP_TPN+" beginnt die Rep_Quest!\n");  
    write_file("/log/quests/news",
        dtime(time())+": "+CAP_TPN+" beginnt die Quest.\n");

    write(BS("Pu Litza gruebelt kurz und mustert Dich von oben bis unten.\n"));
    write(BSA(
          "Weisst Du ueberhaupt, was Dich als Reporter der Dschungelpost erwartet! "
          "Das Leben ist hart und gefaehrlich. Wir brauchen mutige, schlaue "
          "Leute, keine Weicheier und Wursties!!! Bevor Du wirklicher Reporter "
          "werden kannst, musst Du wichtige Bilder zurueckbringen und mir "
          "geben. Ein Reporter einer anderen Zeitung hat sie mir gestohlen! Es "
          "sind wichtige, hochoffizielle Bilder! Der Reporter heisst Razzi Baba und "
          "kann ueberall sein! Hmmm, ihm gefaellt es sogar, uns zu sagen wo er ist, "
          "aber finden konnten wir ihn noch nie! Also Eile! Wenn Du die "
          "Bilder hast, dann tipp einfach <bilder>.",
          "Pu Litza sagt: "));
    ob=clone_object("d/dschungel/dante/news/obj/killrep");
    ob->move(TP, M_NOCHECK);
    return 1;
  }
}





init()
{::init();

  if (query_once_interactive(this_player()))    
    call_out("hallo", 1);
}


void hallo()
{

  if(!present(TP, environment(TO))) return 0;       
  write(BS("Pu Litza sagt: "+CAP_TPN+", Hallo! Gibts was neues im Silberland!?\n"));
}



Defend(int dam, string dtype, int spell, object enemy)
{

  runden++;
  if(runden<3)
  {
    tell_object(enemy,
        "Pu Litza sagt: "+enemy->name()+", hoer lieber sofort damit auf!\n");
    return::Defend(dam, dtype, spell, enemy);  
  }

  if(runden>=3)         
  {
    TO->heal_self(500);
    enemy->command("ziehe alles aus");
    enemy->command("wirf alles weg");
    enemy->move("/d/luft/dante/wolken/room/wolke3", M_NO_SHOW+M_TPORT); 
    tell_object(enemy,
        "Pu Litza teilt Dir mit: Wer nicht hoeren will, muss sterben!\n");
    runden=0;
    return ;
  }
}

