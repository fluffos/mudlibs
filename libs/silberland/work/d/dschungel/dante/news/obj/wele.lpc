//weisse elefant fuer quest....
//wird an verschiedenen orten stehen je nach spieler per random ausgewaehlt
//vielelicht je nach level, je hoeher desto schwieriger
//mal sehn


inherit "std/npc";
#include <mnpc.h>   
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "files.h"
#define  BSA(x,y) break_string(x,78,y) 


#define  FREUND (member(freund, getuid(this_player()))!=-1)
 string *freund=({});

#define  GIVENPILZ (member(givenpilz, getuid(this_player()))!=-1)
 string *givenpilz=({});



int runden=0;
void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein weisser Elefant");
  SetProp(P_LONG, BS(
  "Das ist der lange gesuchte und schon fuer unwirklich geglaubte weisse Elefant. "
  "Hell und strahlend steht er vor Dir und laechelt Dich freundlich an. Ein "
  "wirklich beeindruckendes Tier, obwohl es eher klein ist. "
   "Du schliesst ihn sofort ihn Dein Herz.\n"));
  set_living_name("elefant");
  SetProp(P_NAME, "Elefant");
  SetProp(P_NAME_ADJ, "weiss");
  SetProp(P_GENDER, MALE);
  AddId(({"elefant", "weisser elefant", "WELE"}));
  SetProp(P_ARTICLE, 1);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10, T_RANGE_MAX: 45]));
  create_default_npc(10);
  SetProp(P_HANDS, ({" mit seinem weissen Ruessel",100,DT_BLUDGEON}));
  SetProp(P_BODY, 50);
  SetProp(P_SIZE, 100);
  SetProp(P_ALIGN, 1000);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_INFO, "Der Elefant haette gerne Freunde!\n");
   SetProp( P_RESISTANCE_STRENGTHS,([DT_HOLY:- 1.0, DT_FIRE:0.1, DT_TERROR:1.0]));
   
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,100);
  SetProp(P_NOCORPSE, 1);
  SetProp(P_MSGIN, "trampelt herein");
  SetProp(P_MSGOUT, "trampelt gemuetlich");
  SetProp(P_MMSGIN, "trampelt");
  SetProp(P_MMSGOUT, "trampelt davon");
  
  SetProp(P_DIE_MSG,  " sagt: Nein, ich sterbe nicht!\n");
  
  AddInfo(({"pilze","pilz"}),
  "Naja, alle mag ich nicht, aber einen besonders gerne!", "sagt: ");
  AddInfo("interview",
  "Das haetten viele gerne, aber nicht jedem gebe ich eines...", "sagt: ");
  AddInfo("freunde",
  "Hmm, ich hab einige, willst Du auch einer werden?!","sagt: ");
  AddInfo("freund",
  "Dante ist mein bester Freund!","grinst: ");
  AddInfo("trompetenpilz",
  "So einen will ich haben! Wenn Du einen findest, komm zu mir "
  "und tippe einfach <trompetenpilz>!\n",
   "freut sich sehr und sagt: ");
  
  
  SetChats(5, ({
  "Der weisse Elefant sagt: Mir ist fad!\n",
  "Der weisse Elefant trompetet laut.\n",
  "Der weisse Elefant murmelt etwas von Trompeten oder so...\n",
  "Der weisse Elefant hebt seinen Ruessel.\n",
  "Der weisse Elefant sagt: Tja, so ist das eben!\n",
  "Der weisse Elefant dreht sich kurz um.\n",
  "Der weisse Elefant sagt: Tut mir leid, aber Du hast keine Ahnung!\n",
  "Der weisse Elefant sagt: Ich haette so gerne Freunde!\n",
  "Der weisse Elefant laechelt Dich an.\n"}));
  
  AddInfo(DEFAULT_INFO,({
  "sagt: Hmm, mir neu...\n",
  "grinst nur freundlich.",
  "laechelt Dich an!\n",
  "sagt: Hmm, mails an Dante!\n",
  "sagt: Nein, das ist sicher falsch!\n",
  "sagt: Frag den Balrog!\n"}));
  

  AddInfo("dante", "Dante, der bloede Sack!","sagt: ");
  SetProp( P_REJECT, ({ REJECT_GIVE,
    "Der weisse Elefant wirft Dir @WEN einfach wieder zu.\n" }) );

AddCmd(({"interview", "interviewe"}), "get");
AddCmd(({"biete","biet"}), "friend");
AddCmd(({"trompetenpilz"}), "give_pilz");  
  } 


int get(string str)
  {
  object ob1, ob2, ob3;
  
  
  notify_fail("Wen willst Du interviewen?\n");
  if(!str) return 0;
  
 if(member(({"elefant", "weisser elefant","weissen elefant"}),str)!=-1)
       {
   write("Du versuchst vom weissen Elefanten ein Interview zu bekommen!\n");
       
    if(!present("STIFTNEU", TP))
       {
       //npcs [x] x 1..5
      // : mapping npcs; npcs=([1:({"npc1", "npc2",....}),
     //  : 2:({...})...,5:({..}) )];
     //gehoert net hier her....
     
       write(BS("Der weisse Elefant sagt: "+CAP_TPN+", schreibst Du mit Deiner Nase?\n"));
        return 1;
        }
    if(!present("NOTIZ", TP))
      {
 write(BS("Der weisse Elefant sagt: "+CAP_TPN+", schreibst Du auf Deine Haende?\n"));
      return 1;
      }
  if(!FREUND)
       {
 write(BSA(
 "Von einem Fremden lasse ich mich schon gar nicht interviewen!",
 "Der weisse Elefant sagt: "));
 return 1;
       }
       if(!GIVENPILZ)
     {
     write(BSA(
     "Tja, wir sind zwar Freunde "+CAP_TPN+", aber so einfach geht das "
     "nicht, sonst wuerde mich ja jeder interviewen koennen, oder...",
     "Der weisse Elefant sagt: "));      
      return 1;
      }
      
      else
      {
      write(BS("Der weisse Elefant laechelt freundlich und raeuspert sich.\n"
      "Du zueckst den Stift und notierst alles mit.\n"));
      write(BSA(
      "Also, ich verstehe zwar nicht warum alle ein Interview mit mir wollen, "
      "aber bitte Du hast Dich bemueht, bist freundlich und daher erzaehle "
      "ich Dir etwas. Also geboren wurde ich irgendwann, irgendwo. "
      "Wer meine Mutter war, weiss ich auch nicht, angeblich war es Dante, "
      "aber sicher ist das nicht. Naja, nun stehe ich schon, nachdem "
      "die bei Dante ueblichen Bugs entfernt wurden, hier dumm herum "
      "und warte genau auf solche Spieler wie Dich. Dann, wenn sie nett "
      "sind erzaehle ich ihnen genau diese langweilige Geschichte, sie schauen "
      "bloed und denken sich `Dem Idioten faellt aber auch nur Unfug ein`. "
      "Tja, das war das grosse Interview...", 
      "Der Weisse Elefant sagt: "));
      ob1=present("STIFTNEU", TP);
      ob2=present("NOTIZ", TP);
       ob1->remove();
       ob2->remove();
       
      ob3=clone_object("/d/dschungel/dante/news/obj/inter");
  ob3->SetProp(P_SHORT, sprintf("%s Interview mit dem weissen Elefanten",
  TP->name(WESSEN)));

      ob3->AddId(({""+CAP_TPN+"INTER", "block","notiz","interview","notizblock"}));
      ob3->move(TP, M_NOCHECK);
      
      return 1;
      }
  return 0;
  }
return 0;
}
      
      

 int give_pilz()
     {
     object ob;
     ob=present("TRPILZ", TP);
     
       if(!ob)  {
       write(BSA(
       "Was soll der Unsinn, "+CAP_TPN+"! Du hast gar nichts, was mich "
       "interesieren koennte! Lass das! Du Bloedel!",
       "Der weisse Elefant trompetet: "));
       return 1;
       }

     if(ob)
       {    
  
     if(!FREUND) {
       write(BSA("Nein, "+CAP_TPN+" von Dir nehme ich nichts, ich kenne "
       "Dich nicht und Du bist auch nicht mein Freund!", 
       "Der weisse Elefant sagt: "));
       write("Daraufhin zertrampelt er den Trompetenpilz!\n");
       ob->remove();
       return  1; 
     }
     
      if((FREUND)&&(GIVENPILZ)) {
       write(BSA(""+CAP_TPN+", Du hast mir bereits einen Trompetenpilz "
         "gegeben, aber ich nehme ihn trotzdem gerne.", 
         "Der weisse Elefant sagt laechelnd: "));
       ob->remove();
       return 1;
     }
     
      if((!GIVENPILZ)&&(FREUND))  {
       write(BSA("Ah, "+CAP_TPN+", von Freunden nehme ich gerne etwas! "
         "Danke fuer den Trompetenpilz.", "Der weisse Elefant sagt freundlich: "));
       write(BS("\nDaraufhin trompetet der weisse Elefant und frisst "
        "den Trompetenpilz weg.\n"));
       givenpilz += ({getuid(this_player())});
       ob->remove();
       return  1;
        }     
    return 0;
    }
  return 0;  
 }
    
//ende

     
int friend(string str)
  {
  notify_fail("Wem willst Du hier Freundschaft anbieten?\n");
  if(!str) return 0;
  
  if(member(({"elefant freundschaft an","weisser elefant freundschaft an",
  "weissem elefant freundschaft an", "weissen elefant freundschaft an"}),
  lower_case(str))!=-1)
    {
    if(FREUND)
      {
 write("Der weisse Elefant sagt: "+CAP_TPN+", wir sind doch schon Freunde.\n");
  return 1;
      }
      else
      {
      write(BS("Der weisse Elefant strahlt und laechelt Dich an.\n"
      "Dann knuddelt er Dich wie wild und nun seid ihr beide Freunde!\n"));
       freund += ({getuid(this_player())});     
       return 1;
       }
    return 0;
    }
return 0;
}
       
  
  

 Defend(int dam, string dtype, int spell, object enemy)
   {

   runden++;
if(runden<3)
    {
    tell_object(enemy,
    "Der weisse Elefant sagt: "+enemy->name()+", hoer besser auf!\n");
            return::Defend(dam, dtype, spell, enemy);        
            }
      if(runden>=3)
           {
           TO->heal_self(300);
        enemy->SetProp(P_BLIND, -1);//heheheheh
        enemy->command("ziehe alles aus");
        enemy->command("wirf alles weg");
    enemy->move("d/dschungel/dante/weg/room/wolke3", M_NO_SHOW+M_TPORT);
           enemy->StopHuntFor(ME);
          StopHuntFor(enemy);
    tell_object(enemy,
    "Der weisse Elefant teilt Dir mit: Tja, viel Spass...\n");
    runden=0;
        return ;      
        }
    }
 
 
  //gestorben wird auch nie      
  die(arg)
   {
   write("Der weisse Elefant grinst und heilt sich einfach selbst!\n");
   TO->heal_self(300);
   return ;
   }
        
                                       
