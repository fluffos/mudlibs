mixed test123() {
  return ret;
}


int getpic(string str) {
  string npc;
  object ob;
  string n;

  notify_fail("Was willst Du hier malen lassen?\n");
  if(!str) { 
    write("Die Farbfeen malen nichts!\n"); 
    return 1;
  }
  if(sscanf(str, "%s", npc)) {
    if(!ob=present(npc,environment(TP))) {
      write("Die Farbfeen teilen Dir mit:\n" 
          "Aber "+CAP_TPN+", "+capitalize(npc)+" ist doch nicht hier!\n");
      return 1;
    }
    if(!living(ob)) {
      write("Die Farbfeen teilen Dir mit:\n"
          ""+CAP_TPN+", wir malen nichts totes, nur Lebewesen!\n");
      return 1;
    }

    if(ob->QueryProp(P_INVIS))  {
      write("Die Farbfeen teilen Dir mit:\n"
          "Netter Versuch "+CAP_TPN+", aber Magier finden auch Farbfeen nicht.\n");
      tell_object(ob,
          ""+CAP_TPN+" wollte Dich mit der magischen Kamera enttarnen!\n");
      return 1;     
    }

    if(query_once_interactive(ob) )      {
      write("Die Farbfeen teilen Dir mit:\n"
          "Aber "+CAP_TPN+", dieser Trick hat einen laengeren Bart als Merlin!\n");
      write_file("/d/dschungel/dante/news/log/trick",
          ctime()+": "+capitalize(getuid(PL))+" versucht einen Spieler namens "
          ""+ob->name()+" zu malen.\n");
      return 1;          
    }
    else {
      if (stringp(ob->QueryProp(P_NAME)))
        n = ob->QueryProp(P_NAME);
      else if (pointerp(ob->QueryProp(P_NAME)))
        n = ob->QueryProp(P_NAME)[0];
      if(sel && n == ret[motiv]) 
      {
        ret-=({ret[motiv]});
        write("Die Farbfeen teilen Dir mit:\n"
            "Zu Befehl, Meister "+CAP_TPN+"!\n"
            "Daraufhin malen sie ein Bild von "+ob->name(WEM)+".\n");

        sel=0;
        write(BSA("Gut, nun das naechste Motiv...", 
              "Die Feen fluestern Dir zu "));
        SelectMotiv();zahl++;
      }    
      else
      {
        write("Du sollst das Motiv "+ret[motiv]+" malen und nicht "+ob->name(WER)+"!\n");
      }
      return 1;
    }
    return 0;
  }
  return 0;
}

int SelectMotiv() {
  if (!pointerp(ret))
    pic_wahl();
  if(sizeof(ret)<1) { 
    write(BSA("Du hast bereits alle Motive geschossen!", 
          "Die Feen teilen Dir mit: "));
    TO->AddId(({"kasten","kaestchen","FOTO2", "FOTOFERTIG"}));
    return 1;
  }
  if(!sel) { 
    motiv=random(sizeof(ret));
    sel=1;
  }
  write(BSA(sprintf("Du musst jetzt jemanden, der sich '%s' nennt, suchen "
          "und malen lassen!", ret[motiv]), "Die Feen teilen Dir mit: "));
  return 1;
}

void _set_autoloadobj(mixed data)
{     
  ret = data;
}

mixed _query_autoloadobj()
{   
  return ret;
}

