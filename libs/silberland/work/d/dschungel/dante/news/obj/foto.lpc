//apparat fuer fotoquest
//dante sl 98
inherit "std/thing";
#include <language.h>
#include <properties.h>
#include <moving.h>
#include "files.h"
#define MUST_MAKE_PICS 20 

#define BSA(x,y) break_string(x,78,y)

int ende=0;

//Prototypen
int SelectMotiv();

string *alle_pics;
int motiv, rand, i;
int sel;
int zahl=0;
string *ret;
int noch;

void create()
{
  if (!is_clone(this_object())) return;
  ::create();
  sel=0;
  AddId(({"FOTO2", "kaestchen","kasten"}));
  SetProp(P_NAME, "Kaestchen");
  SetProp( P_GENDER , NEUTER );

  SetProp(P_ARTICLE, 1 );
  SetProp(P_SHORT, "Ein seltsames, buntes Kaestchen" );
  SetProp(P_LONG, BS(
        "Dieses Kaestchen ist kein gewoehnliches Kaestchen. Es ist in der Lage "
        "Bilder von Lebewesen herzustellen. Dazu sitzen im Inneren kleine "
        "Farbfeen, die Du da drinnen eingesperrt hast. Sie malen auf Deinen "
        "Befehl hin sofort ein Bild."));

  ret=({});

  SetProp(P_INFO, ("Der Befehl heisst: farbfee(n) <name des lebewesen>\n"
        "Mit <motiv> bekommst Du Deinen 1. Auftrag!\n"
        "Mit <anzahl> kannst Du sehen wieviele Bilder Du bereits gemacht hast.\n"));

  SetProp(P_MATERIAL, ([MAT_MAGIC:10,MAT_MISC_LIVING:10, MAT_STEEL:1, MAT_WOOD:10]));
  SetProp(P_NOGET, 0);   
  SetProp(P_VALUE,1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_WEIGHT,10 );

  AddCmd(({"farbfeen","farbfee"}), "getpic");
  AddCmd("motiv", "SelectMotiv");
  AddCmd("anzahl", "how_much");
  AddCmd("test123", "fake");

  call_out("pic_wahl", 0);
}

int fake()  
{
  if( getuid(TP) != "dante" )  { return 1;  }
  AddId("FOTOFERTIG");
}

int how_much()
{
  noch=20-zahl;
  if(!zahl) {
    write("Du hast bisher kein einziges Bild malen lassen.\n"
        "Du musst noch 20 Bilder malen lassen.\n");
    return 1;
  }
  if(zahl>=20)   {
    write("Du hast bereits alle Bilder malen lassen.\n");
    return 1;
  }
  else {
    write("Du hast bereits "+zahl+" Bild(er) malen lassen.\n"
        "Du musst noch "+noch+" Bild(er) malen lassen.\n");

    return 1;
  }
}


