#include <properties.h>
inherit "std/room";
#include "/players/dante/myowndefine.h"

create()
{
::create();
SetProp ( P_LIGHT, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25,ENV_TERRAIN:TT_CAVE]) );      
SetProp ( P_INDOORS, 1 );
SetProp ( P_INT_SHORT, "Eine Wendeltreppe");
SetProp ( P_INT_LONG, break_string ("Diese Wendeltreppe fuehrt mehrere tausend Stufen "
+"hinauf. Du kannst leider nicht erkennen, wo sie endet. Aber sie scheint in Alanon's"
+" Privatbibliothek im hohen Turm zu enden. Die Waende schimmern in leichtem Silber.\n", 78)); 
AddDetail ( ({ "wendeltreppe", "treppe" }), break_string(
"Die Wendeltreppe besitzt mehrere tausend Stufen. Es wird Dir ueberdruessig, "
+"sie alle zu zaehlen.\n", 78));
AddDetail ( ({ "stufen", "stufe" }), break_string(
"Die Stufen sind aus Stein. Selbst hier spuerst Du die geballte Energie, die von dem Feuer im"
+" Keller ausgeht.\n", 78));
AddDetail (( "turm"), break_string(
"Den Turm hattest Du von aussen gesehen. Er stellt den hoechsten Punkt der"
+" Runenmaennerburg dar. Hier sitzt Alanon oft naechtelang und studiert die alten Schriften"
+" und Ueberlieferungen, welche noch von der 'alten Zeit' uebrig geblieben sind.\n", 78));
AddDetail ( ({ "boden", "fussboden" }), break_string(
"Die Stufen sind aus Stein. Selbst hier spuerst Du die geballte Energie, die von dem Feuer im"
+" Keller ausgeht.\n", 78));
AddDetail ( ({ "wand", "waende" }), break_string(
"Der silberne Glanz der Waende scheint magischen Ursprungs zu sein. Du hattest schon die "
+" ganze Zeit das Gefuehl, dass dieser Ort von einer magischen Aura umgeben ist. Dir kommen"
+" die Geschichten in Erinnerung, die Dir einmal Dein Vater am Bett erzaehlt hat:"
+" Brimen, der Gruender des Runenmaennerrates legte einen Zauber auf Paranor, der der Burg"
+" solange Schutz und Macht gibt, wie es noch Runenmaenner auf der Welt gibt."
+" Dir laeuft es eiskalt den Ruecken runter, als Du Dich daran erinnerst, dass "
+" Alanon der nun letzte Druide ist.\n", 78));
AddDetail ( ({ "silberner glanz", "glanz", "ursprung" }), break_string(
"Der silberne Glanz ruehrt von Brimen's Zauber her, der mehrere hundert Jahre vor Deiner"
+" Geburt gesprochen wurde. Nur ein Mensch kann und muss diesen Zauber ab und an erneuern."
+" Es ist der letzte Druide, der heute bekannten Welt, Alanon.\n", 78));
AddDetail ( ("decke"), break_string(
"Du kannst die Decke ueber Dir leider nur erahnen. Aber da Du bei Regen"
+" nicht nass wirst, gehst Du davon aus, dass dieser Raum eine solche"
+" besitzt.", 78));
AddExit ( "unten","./halle" );
AddExit ( "oben","./bibliothek" );
}
