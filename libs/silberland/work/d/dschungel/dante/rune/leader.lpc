
/*

  QUESTITEM fuer den Fuehrer der QuestZordan@SL

*/

inherit "std/thing";

#include <properties.h>
#include "../def.h"

string helper1,helper2;

init() {
  ::init();
  if (!living(MENV)) TO->remove();
}

create() {
  if (!is_clone(this_object())) return;
  ::create();

  helper1="";
  helper2="";

  SetProp (P_IDS, ({"\n_leader"}));
  SetProp (P_SHORT, 0);
  SetProp (P_NAME, 0);
  SetProp (P_NEVERDROP, 1);
  SetProp (P_NODROP, 1);
  SetProp (P_WEIGHT, 0);
}

void setvars(string a,string b) {
  helper1=a;
  helper2=b;
}

string gethelfer1() {
  return helper1;
}

string gethelfer2() {
  return helper2;
}
