/*
der meister der runen....
dante sl 99
*/
inherit "std/npc";
#include <npc.h>   
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "/players/dante/myowndefine.h"
#define RMASTER "/d/dschungel/dante/rune/rmaster"
#include <food.h>
#include "../burg.h"

void create()
{
 object ob;
 
  if (!is_clone(TO)) return;
  ::create();
  
  
  
  SetProp(P_SHORT, "Der Meister der Runen");
  SetProp(P_LONG, BS(
  "Das ist der grosse Meister der Runen. Er hat unglaubliches Wissen um die "
  "Magie der Runen, doch Dir wird er nichts verraten. Koerperlich scheint "
  "er nicht so stark zu sein, doch lass Dich davon besser nicht taeuschen..."));
    

  SetProp(P_NAME,"Meister der Runen");
  
  SetProp(P_GENDER, MALE);
  AddId(({"mann","runenmann","meister","runenmeister"}));
  SetProp(P_ARTICLE, 1);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10, T_RANGE_MAX: 45]));
  create_default_npc(40);
  SetProp(P_HANDS, ({" mit einer meisterlichen Runenformel",1000,DT_MAGIC}));
  SetProp(P_BODY, 70);
  SetProp(P_SIZE, 160);
  SetProp(P_ALIGN, -999);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_INFO, "Er ist der Meister!\n");
  SetProp( P_RESISTANCE_STRENGTHS,([DT_HOLY: 0.3, DT_TERROR:-1.0]));
   
  SetProp(P_HEAL,5);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,20);
  SetProp(P_NOCORPSE, 0);
  SetProp(P_MSGIN, "steht ploetzlich vor Dir");
  SetProp(P_MSGOUT, "verschwindet");
  SetProp(P_MMSGIN, "taucht ploetzlich auf");
  SetProp(P_MMSGOUT, "verschwindet");
  
  SetProp(P_DIE_MSG,  " sagt: Ich komme wieder!\n");
  AddInfo("runen",
  "Ich bin ihr Meister!", "sagt: ");
  
  AddInfo("rune",
  "Ich weiss alles darueber!", "sagt: "); 
  SetProp(P_TRANSPARENT, 1);
  
   SUID;

  CLONEME(FA"run");
    CLONEME(FA"ruho");
       CLONEME(FA"ruha");
      CLONEME(FO"prune");
   CLONEME(FW"w");
//absichtlich net gezueckt
  command("zieh alles an");
 
 AddInfo(({"harnisch","runenharnisch"}),
 "Der Runenharnisch gehoert mir , nur mir, dem Meister der Runen!", "sagt: ");
 AddInfo("magie",
 "Die beste Magie ist die Magie der Runen!", "sagt :");
 
 AddInfo(DEFAULT_INFO, "lacht Dich nur aus!\n");
  AddInfo("dante", "Dante, der bloede Sack!","sagt: ");
  SetProp( P_REJECT, ({ REJECT_DROP,
    "Was soll der Meister der Runen damit?!\n" }) );
AddInfo(({"umhang","runnenumhang"}),
"Der Umhang weist Dich als Mitglied der Runenmaenner aus.", "sagt: ");
AddInfo(({"runnenmann","runnenmaenner"}),
"Ich bin ihr Meister!", "sagt: ");
AddInfo("meister",
"Der steht vor Dir!", "behauptet: ");




  SetProp(P_SPELLRATE,75);
     
 AddSpell(1,100,
    "Der Meister der Runen entzuendet sich selbst.\n",
    "Der Meister der Runen entzuendet sich selbst.\n",
     DT_MAGIC, "spell_int");
     
    
AddSpell(4,1000,
  "Der Meister der Runen schleudert die Rune des Todes nach Dir!\n"
  "Sein Spruch gelingt natuerlich perfekt.\n",
  "Der Meister der Runen schleudert die Rune des Todes nach @WEM!\n",
  DT_MAGIC, ([SP_SHOW_DAMAGE:1]));
  
AddSpell(4,1000,
  "Der Meister der Runen stopft Dir eine Terrorrune in den Mund.\n"
  "Dein Spruch gelingt natuerlich perfekt.\n",
  "Der Meister der Runen stopft @WEM eine Terrorrune in den Mund.\n",
  DT_TERROR, ([SP_SHOW_DAMAGE: 1]));
 
 
AddSpell(5,100,
  "Der Meister der Runen zerbricht eine Meisterrune ueber Dir.\n",
  "Der Meister der Runen zerbricht eine Meisterrune ueber @WEM.\n",
   DT_MAGIC, "spell_rune");

AddSpell(5,100,
  "Der Meister der Runen zerbricht eine Meistermagierune ueber Dir.\n",
  "Der Meister der Runen murmelt eine Meistermagierune ueber @WEM.\n",
   DT_MAGIC, "spell_mp");


AddSpell(5,100,
  "Der Meister der Runen zerbricht eine blaue Zwangsrune ueber Dir.\n",
  "Der Meister der Runen murmelt eine blaue Zwangsrune ueber @WEM.\n",
   DT_MAGIC, "spell_p");

AddSpell(5,100,
  "Der Meister der Runen zerbricht eine gelbe Zwangsrune ueber Dir.\n",
  "Der Meister der Runen murmelt eine gelbe Zwangsrune ueber @WEM.\n",
   DT_MAGIC, "spell_rd");

AddSpell(5,100,
  "Der Meister der Runen zerbricht eine fluessige Rune ueber Dir.\n",
  "Der Meister der Runen murmelt eine fluessige Rune ueber @WEM.\n",
   DT_MAGIC, "spell_a");


AddSpell(5,100,
  "Der Meister der Runen zerbricht eine Frassrune ueber Dir.\n",
  "Der Meister der Runen murmelt eine Frassrune ueber @WEM.\n",
   DT_MAGIC, "spell_t");



AddSpell(3,100,
  "Der Meister der Runen sagt : Runenfriede!!!\n",
  "Der Meister der Runen sagt:  Runenfriede!!!\n",
   DT_MAGIC, "spell_peace");
//eigentlich sollte man da den enemy aus dem master rausnehmen damit alle
//runenmaenner aufhoeren....naja



set_living_name("runenmeister");

   SetChats(5,({
   "Der Meister der Runen sagt: Ich bin der Meister!\n",
   "Der Meister der Runen protzt mit seinem Wissen!\n",
   "Der Meister der Runen sagt: Knie nieder, Wurm!\n",
   "Der Meister der Runen sagt: Du mieser Knecht!\n",
   "Der Meister der Runen sagt: Elsurion ist ein Knilch!\n",
   "Der Meister der Runen sagt: Runen sind Runen.\n"}));
    
RMASTER->add_mann();
   
SP(P_KILL_NAME, "Der Meister der Runen");
SP(P_MURDER_MSG, "Der Zauber der Runen hat versagt!");
SP(P_KILL_MSG, "bruellt: Niemand widersteht dem Zauber der Runen!!!");
   SetProp(P_MSG_FLAGS, ([P_KILL_MSG:1, P_MURDER_MSG:1 ]));  
  }
   
 void spell_int(object enemy,int damage,mixed dam_type)    
   {
        object *inv;
   int i;
   
     inv=PresentEnemies();
     damage=1000+random(1000);
     damage/=sizeof(inv);         
    tell_room(ENV(ME), BS("Eine lebendige Feuerwalze entsteht!\n"));
      for(i=sizeof(inv)-1;i>=0;i--)
       {               
      tell_object(inv[i], "Die lebendige Feuerwalze verbrennt Dich total!\n"
      "Der Grossmeister der Runen wirft mit grellen Blitzen um sich!\n");
      
 inv[i]->Defend(damage, dam_type,
          ([SP_SHOW_DAMAGE:1,SP_NAME:"Feuerwalze"]), this_object());       
                 
   }
}


 void spell_peace(object enemy,int damage,mixed dam_type)    
  {
  tell_object(enemy,
  "Ploetzlich versagen fuer Sekunden Deine Kraefte und du stehst still.\n"
  "Danach schaust Du den Meister der Runen friedlich an!\n"
  "Der Meister der Runen grinst und ploetzlich schiesst ein blutroter "
  "Blitz aus seinen Augen!!! AHHHHHHHH!!! Das schmerzt hoellisch!!!\n");
  enemy->do_damage(random(10)+10);
      enemy->StopHuntFor(ME);
          StopHuntFor(enemy);
              return 0;                 
   }


void spell_t(object enemy,int damage,mixed dam_type)    
  {
  string f;
  f=enemy->QueryProp(F_SOAK);
  
  tell_object(enemy,
  "Dein Magen blaeht sich auf.\n");
  switch(random(5))
    {
    case 0:
    enemy->QueryProp(F_SOAK)==(f+20);
    break;
    case 1:
      enemy->QueryProp(F_SOAK)==(f+30);   
    break;
    case 2:
      enemy->QueryProp(F_SOAK)==(f+50);
      break;
      case 3:
        enemy->QueryProp(F_SOAK)==(f+70);
        case 4:
          enemy->QueryProp(F_SOAK)==(f+100);
          break;
          default:write("BUG!\n");
          }
      }




void spell_a(object enemy,int damage,mixed dam_type)    
  {
  string f, g;
  f=enemy->QueryProp(F_DRINK);
  f=enemy->QueryProp(F_ALCOHOL);
  tell_object(enemy,
  "Du hoerst Fluessigkeit in Dir blubbern.\n");
  switch(random(5))
    {
    case 0:
    enemy->QueryProp(F_DRINK)==(f+10);
     enemy->QueryProp(F_ALCOHOL)==(g+10);
    break;
    case 1:
    enemy->QueryProp(F_DRINK)==(f+30);
     enemy->QueryProp(F_ALCOHOL)==(g+30);
    break;
    case 2:
    enemy->QueryProp(F_DRINK)==(f+50);
     enemy->QueryProp(F_ALCOHOL)==(g+50);
    break;
    case 3:
    enemy->QueryProp(F_DRINK)==(f+70);
     enemy->QueryProp(F_ALCOHOL)==(g+70);
    break;
    case 4:
    enemy->QueryProp(F_DRINK)==(f+100);
     enemy->QueryProp(F_ALCOHOL)==(g+100);
    break;
    default:write("BUG!\n");
     }
   }
   


                   
void spell_rd(object enemy,int damage,mixed dam_type)    
  {
    
    object ob1;
    string waffenname;
    ob1= enemy->QueryProp(P_WEAPON);
    if (ob1 && !(ob1->QueryProp(P_CURSED)))
    {
    ob1->UnWield();
    ob1->move(ENV(ME), M_NOCHECK);
    
    }
    else
  tell_object(enemy,
  "Du gibts dem Runenmeister Deine Magie!\n");
  TO->heal_self(50);
  enemy->restore_spellpoints(-50+random(50));
  }
  


void spell_p(object enemy, int damage, mixed dam_type)       
{

 object ob;
 
  if (ob=present("ruestung", enemy) )
   {
    enemy->command_me("!\gib ruestung an meister");
      }
      
       if (ob=present("panzer", enemy) )
     {
     enemy->comman_me("!\gib panzer an meister");
     }
     
     else
     {
     tell_object(enemy,
     "Der Meister der Runen sticht Dir in Deinen nackten Koerper.\n");
     enemy->do_damage(30+random(30));
     }
   }
     

void spell_rune(object enemy,int damage,mixed dam_type)    
  {
  switch(random(4))
    {
    case 0:
    tell_object(enemy,
    "Ein blutroter Blitz schleudert Dich fort!\n");
    enemy->do_damage(10+random(20));
    enemy->move("/d/dschungel/dante/geist/room/geist7", M_TPORT);
    break;
    case 1:
    tell_object(enemy,
    "Ein harter Windstoss schleudert Dich fort!\n");
    enemy->do_damage(10+random(20));
    enemy->move("d/dschungel/dante/geist/room/seil", M_TPORT);
    break;
    case 2:
    tell_object(enemy,
    "Wassermassen reissen Dich fort!\n");
    enemy->do_damage(10+random(20));
    enemy->move("/d/dschungel/dante/geist/room/sk1", M_TPORT);
    break;
    case 3:
    tell_object(enemy,
    "Ein Feurwall reisst Dich fort!\n");
    enemy->do_damage(10);
    enemy->move("/d/dschungel/dante/weg/room/brunnen2", M_TPORT);
    break;
    default:write("BUG!\n");
    }
    
}



void spell_mp(object enemy,int damage,mixed dam_type)    
  {
  
    tell_object(enemy,
    "Deine Magie wechselt zum Meister der Runen ueber!\n");
    switch(random(11))
    {
    
    case 0 ..1:
    enemy->restore_spell_points(-10);
    TO->heal_self(10);
    break;
    case 2..3:
    enemy->restore_spell_points(-20);
    TO->heal_self(20);
    break;
     case 4..5:
    enemy->restore_spell_points(-30);
    TO->heal_self(30);
    break;
    case 6..7:
    enemy->restore_spell_points(-40);
    TO->heal_self(40);
    break;
    case 8..9:
    enemy->restore_spell_points(-50);
    TO->heal_self(50);
    break;
    case 10:
    enemy->restore_spell_points(-100);
    TO->heal_self(100);
    break;
   default:write("BUG!\n");
      }
   }
   



 Defend(int dam, string dtype, mixed spell, object enemy)
  {
      RMASTER->ruf_um_hilfe(enemy);
      
      
      
      
             if (!pointerp(dtype))
                        dtype = ({ dtype });
                        
         if (sizeof(dtype & ({ DT_MAGIC }) ))        
      {
      
      tell_room(environment(),
      "Der Meister der Runen wird staerker und staeker!\n");
      heal_self(dam*2);
   return ::Defend(0, dtype, spell, enemy);
                                                 
            }

      
         if (sizeof(dtype & ({ DT_TERROR }) ))        
      {
      
      tell_room(environment(),
      "Der Meister der Runen wird staerker und staeker!\n");
      heal_self(dam*2);
   return ::Defend(0, dtype, spell, enemy);
                                                 
            }

             return ::Defend(dam, dtype, spell, enemy);
        }              
  
  
  
  
  remove(int arg)
    {
        RMASTER->remove_mann(this_object());
            ::remove(arg);
              }
              
   
     die(arg)
        {
             write_file("/d/dschungel/dante/geist/log/rume.kills",
                  ctime()+": "+CAP(getuid(PL))+" killt den Meister der Runen.\n");
            ::die(arg);                                                                                       
                }
  
  
  
  
   void NotifyPlayerDeath(object player, object killer, int lostexp)
       {
        write_file("/d/dschungel/dante/geist/log/rume.deads",
       ctime()+": Der Meister der Runen hat "+CAP(getuid(PL))+" umgebracht.\n");
         }                                  