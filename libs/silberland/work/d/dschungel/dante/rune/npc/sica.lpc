
/*
    Sica, der QuestNPC. Zordan@SL
*/

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <wizlevels.h>
#include "../def.h"

#define sag(x) call_out("sagfkt",0,x)

int got_griff;
string got_from;
string anfuehrer,helfer1,helfer2;

void create() {
  if (!is_clone(TO)) return;
  ::create();

  got_griff=0;
  got_from="xxx";
  anfuehrer="";
  helfer1="";
  helfer2="";

  SetProp(P_SHORT, "Sica");
  SetProp(P_LONG,
    "Sica ist ein alter Menschenmann, der gemuetlich in seinem Schaukelstuhl "
    "sitzt. Sein weisser Bart taeuscht nicht ueber sein Alter hinweg. "
    "Anscheinend denkt er angestrengt ueber irgendetwas nach. Es sieht "
    "auch so aus, als ob er Dich nicht weiter beachtet." );
  SetProp(P_NAME, "Sica");
  SetProp(P_GENDER, MALE);
  SetProp (P_ARTICLE, 0);

  AddId( ({ "sica","mann" }) );

  set_living_name("sica");
  create_default_npc(10);

  SetProp(P_HANDS, ({" zitternden Haenden",50,DT_BLUDGEON}));

  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 170+random(20));
  SetProp(P_ALIGN, 150+random(50));
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_NOATTACK, "ist einfach kein Gegner fuer Dich.");

  AddInfo(DEFAULT_INFO, "seufzt: Darueber weiss ich nun wirklich nichts.\n");

  SetProp(P_LOG_INFO, "sica.log");

  SetProp( P_REJECT, ({ REJECT_GIVE,
    "" }) );

  AddDetail( ({ "bart" }),
    "Der weisse Bart haengt Sica halb den Koerper hinunter. Sica muss schon "
    "sehr alt sein." );
 
  AddDetail( ({ "alter" ,"jahre" }),
    "Du schaetzt Sica auf knapp einhundert Jahre, aber irgendwie scheint "
    "er aelter zu sein." );

  SetChats(1, ({
    "Sica steht kurz auf, nimmt sich was zu essen und setzt sich wieder.\n",
    "Sica denkt . o O ( Man wird mich doch wohl nicht stoeren ? )\n",
    "Sica gruebelt vor sich hin.\n",
    "Sica nimmt ein Buch und schlaegt was nach.\n",
    "Sica grummelt: Ich selber bin einfach zu schwach.\n",
    "Sica seufzt.\n",
    "Sica lehnt sich entspannt nach hinten.\n",
    "Sica schaut ganz kurz zu Dir auf.\n",
    "Sica kraeuselt seinen Bart.\n",
    "Sica schaukelt in seinem Schaukelstuhl.\n",
    "Sica murmelt: Das Herz, das Herz.\n",
    "Sica denkt angestrengt nach.\n"}) );

  AddInfo( ({"griff","klinge","dinge"}),
    "Genau diese Dinge musst Du mir geben.",
    "sagt: ");

  AddInfo( ({"teil","teile"}),
    "Die wirst Du schon selber suchen muessen.",
    "sagt: ");

  AddInfo( ({"bart"}),
    "Ist mein Bart nicht wunderschoen?",
    "fragt: ");

  AddInfo( ({"hoehle"}),
    "Ich lebe in dieser wundervollen Hoehle.",
    "sagt: ");

  AddInfo( ({"frau"}),
    "Ich lebe getrennt von meiner Frau.",
    "sagt: ");

  AddInfo( ({ "hilfe","quest" }),
    "Ich brauche unbedingt das Herz eines Riesen, um endlich meiner kranken "
    "Mutter einen Heiltrank machen zu koennen. Leider bin ich selber viel zu "
    "schwach, um gegen den Riesen anzutreten. Wenn Du mir helfen moechtest, "
    "dann biete mir einfach Deine Hilfe an.",
    "sagt: " );

  AddInfo( ({ "herz" }),
    "Das Herz des Riesen besteht aus einem mir unbekannten Material, das ich "
    "aber laut meinen Buechern fuer den Heiltrank brauche.",
    "erlaeutert: " );

  AddInfo( ({ "saebel","mithrilsaebel" }),
    "Nur mit dem Saebel kannst Du das Herz des Riesen herausschneiden.",
    "erlaeutert: " );

  AddInfo( ({ "armreif","reif" }),
    "Leider wirkt der Armreif immer anders. Du musst schon selber "
    "herausfinden, was er genau macht.",
    "erklaert: " );

  AddInfo( ({ "riese","riesen" }),
    "Der Riese wurde vor langer Zeit von einem boesen Magier dazu verflucht, "
    "auf einer grossen Felsplatte sein Leben zu fristen. Er kann diese Platte "
    "niemals mehr verlassen. Ihn zu toeten ist eine der schwierigsten "
    "Aufgaben, die ich in meinem langen Leben zu Ohren bekommen habe.",
    "sagt: " );

  AddInfo( ({ "mutter" }),
    "Meine liebe Mutter liegt im Sterben. Ich muss fuer sie unbedingt einen "
    "Heiltrank brauen, damit sie noch ein paar Jahre zu leben hat.",
    "erzaehlt weinend: " );

  AddInfo( ({ "sterben" }),
    "Das Sterben gehoert ja eigentlich genauso zum Leben wie die Geburt. "
    "Aber muss es unbedingt jetzt schon meine Mutter treffen ? Ich finde "
    "nicht.","sagt: " );

  AddInfo( ({ "leben" }),
    "Das Leben ist eine Gabe unserer Goetter. Ich wuensche Dir ein langes "
    "und unbeschwertes Leben.","sagt: " );

  AddInfo( ({ "saeure" }),
    "Das war wohl eine sehr aetzende Saeure.","sagt: " );

  AddInfo( ({ "schaukelstuhl","stuhl" }),
    "Das ist der Schaukelstuhl meiner Vorfahren. Nur ich darf darin "
    "sitzen.","sagt energisch: " );

  AddInfo( ({ "zelt" }),
    "Ist es nicht ein schoenes Zelt?","fragt: " );

  AddInfo( ({ "goetter","woody","dusty" }),
    "Unsere Goetter sind Woody und Dusty.","erklaert Dir: " );

  AddInfo( ({ "geburt","anfang" }),
    "Die Geburt ist der Anfang allen Lebens.","sagt: " );

  AddInfo( ({ "aufgabe" }),
    "Deine Aufgabe ist es den Riesen zu toeten. Dafuer wuerdest Du "
    "sogar etwas wertvolles von mir bekommen.","sagt: " );

  AddInfo( ({ "bruecke" }),
    "Nur ich kann Dir die Erlaubnis geben, ueber die Bruecke zu gehen.",
    "sagt: " );

  AddInfo( ({ "heiltrank","trank" }),
    "Das ist ein uralter Trank, den ich in meinen Buechern gefunden habe. "
    "Leider bist Du nicht weise genug, um ihn selber herzustellen.",
    "erklaert: " );

  AddInfo( ({ "material","materialien" }),
    "Ich konnte bisher nur herausfinden, dass das Herz selber aus magischen "
    "Materialien besteht. Welche das sind, weiss ich leider selber auch nicht. ",
    "sagt: " );

  AddInfo( ({ "buch","buecher" }),
    "In meinen Buechern stehen viele, teilweise sehr alte, interessante Dinge. "
    "Ich selber habe sie alle gelesen. Doch leider nimmt mit meinem Alter so "
    "langsam mein Gedaechtnisvermoegen ab, so dass ich doch hin und wieder "
    "in den Buechern nachlesen muss.",
    "sagt: " );

  AddInfo( ({ "gedaechtnis","gedaechtnisvermoegen","vermoegen" }),
    "Mit den Jahren verliert man langsam sein Vermoegen, sich Dinge zu "
    "merken. Wenn Du erst einmal so alt geworden bist wie ich, dann "
    "wirst Du es verstehen.","sagt: " );

  AddInfo( ({ "zeit","magier" }),
    "Ein boeser Magier hat den armen Zwerg vor etlicher Zeit in einen Riesen "
    "verwandelt und ihn auf die Felsplatte verbannt. Gemacht hat er das, weil "
    "der Zwerg dem Magier ein wenig Saeure ins Gesicht geschuettet hat und "
    "ihn damit total entstellt hat.",
    "seufzt: " );

  AddInfo( ({ "zwerg","mitarbeiter","glas" }),
    "Der Zwerg war ein Mitarbeiter des Magiers. Er hat in einer unbedachten "
    "Situation dem Magier ein Glas mit Saeure ins Gesicht geschuettet. Das "
    "hat ihm der Magier nie verziehen.","sagt: " );

  AddInfo( ({ "situation" }),
    "Genaueres weiss ich darueber leider nicht.","sagt: " );

  AddInfo( ({ "gesicht" }),
    "Das Gesicht des Magiers ist so verstellt, dass viele schon meinten er "
    "waere ein wahres Monster. Er wurde auch schon seit vielen Jahren nicht "
    "mehr gesehen. Da kann ich Dir auch nicht mehr helfen.",
    "sagt: " );

  AddInfo( ({ "saeure" }),
    "Es handelte sich wohl um eine sehr stark aetzende Saeure, denn das "
    "Gesicht des Magiers wurde komplett zerstoert dabei.",
    "seufzt: " );

  AddInfo( ({ "felsplatte","ort","fels" }),
    "Die Felsplatte ist ein sehr gefaehrlicher Ort. Nur der Riese selber kann "
    "sich dort ohne Gefahr bewegen.",
    "sagt: " );

  AddInfo( ({ "gefahr" }),
    "Die Gefahr ist SEHR gross auf der Felsplatte. Nur wenn Du sehr mutig und "
    "erfahren bist, kann ich Dir den Zutritt auf die Felsplatte erlauben.",
    "erklaert: " );

  AddInfo( ({ "zutritt" }),
    "Du kannst mich um Erlaubnis fragen. Vielleicht gebe ich sie Dir ja.",
    "sagt: " );

  AddInfo( ({ "alter","jahr","jahre" }),
    "Ich bin jetzt schon ueber zweihundert Jahre alt. Ich erhalte mir mein "
    "langes Leben durch einen meiner Heiltraenke. Leider brauche ich fuer "
    "einen ganz speziellen Heiltrank die Hilfe anderer.",
    "sagt stolz: " );

  AddInfo( ({ "brueckenwaechter","waechter","gehilfe" }),
    "Der Brueckenwaechter ist mein Gehilfe und sorgt dafuer, dass nur Leute "
    "mit meiner Erlaubnis die Bruecke ueberqueren.",
    "sagt: " );

  AddInfo( ({ "leute" }),
    "Na das sind Leute wie Du und ich.","sagt: " );

  AddInfo( ({ "heilen","heilung","tanke","tanken","essen","trinken" }),
    "Ich kann Dich heilen. Du musst mir nur etwas geben und ich heile Dich "
    "dann fuer den entsprechenden Gegenwert.","sagt: " );

  AddInfo( ({ "gegenwert","wert" }),
    "Ich verrechne den Wert der Gegenstaende um in die Kosten eines meiner "
    "Heiltraenke.","erklaert: " );

  AddInfo( ({ "heiltraenke","traenke" }),
    "Meine Heiltraenke sind mein Geheimnis. Und ich werde sicher nichts "
    "darueber verraten.","sagt: " );

  AddInfo( ({ "kosten" }),
    "Die Kosten liegen so in etwa bei: Ein wenig Heilung fuer den Wert von "
    "acht bis zehn Muenzen.","sagt: " );

  AddInfo( ({ "gegenstand","gegenstaende","muenzen" }),
    "Es muessen schon Gegenstaende sein. Mit Muenzen kann ich nichts anfangen.",
    "sagt: " );

  AddInfo( ({ "zordan","schelm" }),
    "Der alte Schelm hat mich schon lange nicht mehr besucht.",
    "seufzt: " );

  AddInfo( ({ "genehmigung","erlaubnis" }),"@@erlaubnis@@" );

  AddCmd( ({ "biete","biet" }), "bietfkt" );
  AddCmd( ({ "loese","loes" }), "loesfkt" );

  SUID;
  CLONEME( "/p/armour/lederstiefel" );
  CLONEME( "/p/armour/umhang" );
  command("trage alles");
}

int _query_wimpy() { return 0; }

void sagfkt(string str) {
  tell_room(MENV,break_string(str,78,"Sica sagt: "));
}

int bietfkt(string str) {
  notify_fail("Wem moechtest Du was anbieten ?\n");
  if (str != "sica hilfe" && str != "sica hilfe an" ) { return 0; }
  sag("Du moechtest mir also wirklich helfen, "+TPN+" ? Gut. Das Bedarf allerdings einer "
   "kleinen Prozedur. Alleine kannst Du gegen den Riesen nicht bestehen. Daher "
   "brauchst Du zwei Helfer, die Dich im Kampf unterstuetzen. Wichtig dabei ist "
   "auch, dass die beiden Helfer immer mit Dir hier bei mir sind, sonst kann "
   "ich Euch nicht weiterhelfen. Wenn Du und Deine Helfer soweit seid, dann antworte "
   "mir einfach mit 'ich bin Anfuehrer'. Dann sehen wir weiter. Sollte "
   "irgendwo etwas unklar sein, dann biete mir Deine Hilfe neu an und wir fangen "
   "ganz von vorne an.");
  say(CAP_TPN+" bietet Sica seine Hilfe an.\n", ({ TP }) );
  anfuehrer="";
  helfer1="";
  helfer2="";
  return 1;
}

int loesfkt(string str) {
  object ob1,ob2,ob3,ob4;
  string temp1,temp2;
  notify_fail("Was moechtest Du aufloesen ?\n");
  if (str != "team auf") { return 0; }
  if (!ob1=present("\n_leader",TP)) {
    write("Sica sagt: Du bist kein Anfuehrer von einem Team!\n");
    return 1;
  }
  temp1=ob1->gethelfer1();
  temp2=ob1->gethelfer2();
  if (!ob2=present(LOWER(temp1))) {
    write("Sica sagt: Dein Helfer "+temp1+" muss auch hier sein!\n");
    return 1;
  }
  if (!ob3=present(LOWER(temp2))) {
    write("Sica sagt: Dein Helfer "+temp2+" muss auch hier sein!\n");
    return 1;
  }
  tell_room(MENV,break_string("Ok "+TPN+", das Team mit "
    +temp1+" und "+temp2+" ist aufgeloest.\n",78,"Sica weint: "));
  ob1->remove();
  if (ob4=present("\n_helper",ob2)) { ob4->remove(); }
  if (ob4=present("\n_helper",ob3)) { ob4->remove(); }
  return 1;
}

nosave int checklevel(object ob) {
  if ((ob->QueryProp(P_LEVEL) < 35) || (!IS_SEER(ob))) {
    sag("Tut mir sehr leid, aber Deine Erfahrung reicht nicht aus um "
        "mir zu helfen. Um Dein Leben zu schonen erlaube ich Dir nicht "
        "mir zu helfen. Du musst schon Seherfaehigkeiten haben und "
        "mindestens Stufe 35 sein.");
    return 0;
  }
  return 1;
}

catch_tell( text ) {
  string wer;
  object ob,ob1,ob2,ob3;
  if (sscanf(LOWER(text),"%s antwortet dir: ich bin anfuehrer", wer) == 1) {
    if(!checklevel(TP)) return;
    if (ob=present("\n_leader",TP)) {
      sag("Aber Du bist schon Anfuehrer von "
       +ob->gethelfer1()+" und "+ob->gethelfer2()+".");
      return;
    }
    if (ob=present("\n_helper",TP)) {
      sag("Aber Du bist schon Helfer von "+ob->getleader()+".");
      return;
    }
    if (anfuehrer != "") {
      sag("Aber "+anfuehrer+" ist schon Anfuehrer.");
      return;
    }
    sag("Ok, "+capitalize(wer)+" ist Anfuehrer. Als naechstes brauchen wir "
     "dann den ersten Helfer. Der erste Helfer soll mir mit 'ich bin helfer "
     "eins' antworten.");
    anfuehrer=capitalize(wer);
    return;
  }
  if (sscanf(LOWER(text),"%s antwortet dir: ich bin helfer eins", wer) == 1) {
    if(!checklevel(TP)) return;
    if (ob=present("\n_leader",TP)) {
      sag("Aber Du bist schon Anfuehrer von "
       +ob->gethelfer1()+" und "+ob->gethelfer2()+".");
      return;
    }
    if (ob=present("\n_helper",TP)) {
      sag("Aber Du bist schon Helfer von "+ob->getleader()+".");
      return;
    }
    if (anfuehrer == "") {
      sag("Zuerst brauchen wir einen Anfuehrer !");
      return;
    }
    if (helfer1 != "") {
      sag("Aber "+helfer1+" ist schon Helfer eins.");
      return;
    }
    helfer1=capitalize(wer);
    if (helfer1 == anfuehrer) {
      sag(anfuehrer+", ich hab Dir gesagt, Du brauchst zwei Helfer.");
      helfer1="";
      return;
    }
    if (!present(LOWER(anfuehrer))) {
      sag(anfuehrer+" muss aber anwesend sein.");
      helfer1="";
      return;
    }
    sag("Ok, "+capitalize(wer)+" ist jetzt der erste Helfer. Als naechstes "
     "brauchen wir dann den zweiten Helfer. Der zweite Helfer soll mir mit "
     "'ich bin Helfer zwei' antworten.");
    return;
  }
  if (sscanf(LOWER(text),"%s antwortet dir: ich bin helfer zwei", wer) == 1) {
    if(!checklevel(TP)) return;
    if (ob=present("\n_leader",TP)) {
      sag("Aber Du bist schon Anfuehrer von "
       +ob->gethelfer1()+" und "+ob->gethelfer2()+".");
      return;
    }
    if (ob=present("\n_helper",TP)) {
      sag("Aber Du bist schon Helfer von "+ob->getleader()+".");
      return;
    }
    if (anfuehrer == "") {
      sag("Zuerst brauchen wir einen Anfuehrer !");
      return;
    }
    if (helfer1 == "") {
      sag("Zuerst brauchen wir noch Helfer eins !");
      return;
    }
    if (helfer2 != "") {
      sag("Aber "+helfer2+" ist schon Helfer zwei.");
      return;
    }
    helfer2=capitalize(wer);
    if (helfer2 == anfuehrer) {
      sag(anfuehrer+", ich hab Dir gesagt, Du brauchst zwei Helfer.");
      helfer2="";
      return;
    }
    if (helfer1 == helfer2) {
      sag(anfuehrer+", ich hab Dir gesagt, Du brauchst zwei unterschiedliche Helfer.");
      helfer2="";
      return;
    }
    if (!present(LOWER(anfuehrer))) {
       sag(anfuehrer+" muss aber anwesend sein.");
      helfer2="";
      return;
    }
    if (!present(LOWER(helfer1))) {
      sag(helfer1+" muss aber anwesend sein.");
      helfer2="";
      return;
    }
    sag("Ok, "+capitalize(wer)+" ist jetzt der zweite Helfer. "+anfuehrer+" muss "
     "mir jetzt folgende Auswahl mit der Antwort 'ist ok so' bestaetigen: "
     "Helfer eins ist "+helfer1+" und Helfer zwei ist "+helfer2+".");
    return;
  }
  if (sscanf(LOWER(text),"%s antwortet dir: ist ok so", wer) == 1) {
    if(!checklevel(TP)) return;
    if ((helfer2 == "") || (anfuehrer == "") || (helfer1 == "" )) {
      sag("Die Auswahl wurde noch nicht vollstaendig durchgefuehrt.");
      return;
    }
    if (anfuehrer != capitalize(wer)) {
      sag("Nur "+anfuehrer+" kann die Auswahl bestaetigen.");
      return;
    }
    if (!present(LOWER(anfuehrer))) {
      sag(anfuehrer+" muss aber anwesend sein.");
      helfer2="";
      return;
    }
    if (!present(LOWER(helfer1))) {
      sag(helfer1+" muss aber anwesend sein.");
      helfer2="";
      return;
    }
    if (!present(LOWER(helfer2))) {
      sag(helfer2+" muss aber anwesend sein.");
      helfer2="";
      return;
    }
    sag("Alles klar. Ihr drei bildet jetzt also das Team um fuer mich gegen den "
     "Riesen anzutreten. Bedenkt folgendes: Keiner von Euch kann in einem "
     "anderen Team als in diesem antreten, bis "+anfuehrer+" mir das Herz "
     "gebracht hat !! "+anfuehrer+" kann das Team jederzeit mit dem "
     "Befehl 'loese Team auf' aufloesen. Dabei gehen aber alle bisher erreichten "
     "Dinge verloren.\n"
     "Damit "+anfuehrer+" auch am Ende das Herz des Riesen "
     "herausschneiden kann, brauchen wir einen besonderen Saebel. Irgendwo "
     "in dieser Hoehle habe ich ihn verloren. Dabei ist er leider kaputtgegangen. "
     "Bringt mir zuerst die Teile und ich mache Euch einen Saebel daraus.\n"
     "Achja, falls Ihr einmal in Not seid und Heilung benoetigt, dann fragt mich "
     "einfach danach und ich heile Euch.");
    ob1=present(LOWER(anfuehrer));
    ob2=present(LOWER(helfer1));
    ob3=present(LOWER(helfer2));
    ob=clone_object( OBJ "leader" );
    ob->setvars(helfer1,helfer2);
    ob->move(ob1, M_NOCHECK);
    ob=clone_object( OBJ "helper" );
    ob->setvars(anfuehrer,helfer2);
    ob->move(ob2, M_NOCHECK);
    ob=clone_object( OBJ "helper" );
    ob->setvars(anfuehrer,helfer1);
    ob->move(ob3, M_NOCHECK);
    if (!present("\n_erlaubnis",ob1)) { CLONE( OBJ "erlaubnis", ob1); }
    if (!present("\n_erlaubnis",ob2)) { CLONE( OBJ "erlaubnis", ob2); }
    if (!present("\n_erlaubnis",ob3)) { CLONE( OBJ "erlaubnis", ob3); }
    write_file( LOG "riese.quest" ,
      ctime()+": Neues Team: "+anfuehrer+" mit "+helfer1+" und "+helfer2+".\n");
    anfuehrer="";
    helfer1="";
    helfer2="";
    return;
  }
}

string erlaubnis () {
  string str;
  if (present("\n_erlaubnis",TP)) {
    return "sagt: "+TPN+", Du hast doch schon meine Erlaubnis.\n";
  }
  if (present("\n_leader",TP)) {
    CLONE( OBJ "erlaubnis",TP);
    return "sagt: "+TPN+", Du fuehrst ein Team an und bekommst "
           +"die Erlaubnis.\n";
  }
  if (present("\n_helper",TP)) {
    CLONE( OBJ "erlaubnis",TP);
    return "sagt: "+TPN+", Du hilfst in einem Team und bekommst "
           +"die Erlaubnis.\n";
  }
