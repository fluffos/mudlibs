inherit "std/room";
#include <properties.h>
#include <language.h>
#include "/players/dante/myowndefine.h"
create()
{
::create();

SetProp(P_LIGHT, 0);
SetProp ( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25,ENV_TERRAIN:TT_CAVE]) );      
SetProp ( P_INT_SHORT, break_string("Dies ist ein finsterer Tunnel.", 78));
SetProp ( P_INT_LONG, break_string("Der Tunnel scheint sich in alle Richtungen"
+" zu verzweigen. Der Staub, den Du hier in einer Dicke von mehreren "
+"Zentimetern antriffst, laesst vermuten, dass hier garantiert keine "
+"Reinemachefrau ihrer Arbeit nachgeht.", 78));
AddDetail ( ({"staub","staubschicht" }), break_string(
"Hmmm, genau wie in den anderen Tunnelpassagen befindet sich hier Staub."
+" An diesem Staub ist nichts besonderes Zu erkennen, nur das er schon "
+"sehr lange hier liegen muss.", 78));
AddDetail ( ({"tunnel", "tunnelsystem" }), break_string(
"Der Tunnel scheint nicht EIN Tunnel zu sein, sondern ein ganzes Tunnelsystem."
+" Es erstreckt sich ueber mehrere Kilometer in verschiedene Richtungen unter"
" und um das Gebiet der Burg herum.", 78));
AddDetail ( ({"waende","wand"}), break_string(
" Die Waende scheinen leicht zu schimmern. Du kannst nicht genau"
+" erkennen, aus welchem Gestein sie bestehen. Aber eins ist sicher,"
+" es ist haerter als Granit und beeindruckt Dich mit einem "
+"leicht silbernen Glaenzen, das den Schein Deines Lichtes sanft"
+" zurueckstrahlt.", 78));
AddDetail ( ({"boden", "fussboden" }), break_string(
"Dieser Boden ist, wie Du vielleicht schon bemerkt hast mit Staub bedeckt. "
+"Der Boden ist also nicht zu erkennen, es sei denn, Du machst "
+"Dir die Muehe und fegst hier mal richtig durch.", 78));
AddDetail ( ({"decke", "tunneldecke"}), break_string(
"Die Tunneldecke ist relativ niedrig, so wie es sich fuer "
+"finstere Tunnel gehoert.", 78));
AddDetail ( ({"zugaenge", "gaenge", "wege","abzweigungen"}), break_string(
" Die Abzweigungen die Du erkennen kannst, laufen kreuz und quer"
+" unter der Burg durch. Du must aufpassen, dass Du dich nicht verlaeufst.", 78));

AddExit ("nordwesten","./tunnel3.lpc");
AddExit ("osten","./tunnel1.lpc");
}
