// dante@SilberLand
//monster fuer katakomben
//nicht so arg gemein
inherit "std/npc";
#include <npc.h>   
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "/players/dante/myowndefine.h"
#define RMASTER "/d/dschungel/dante/rune/rmaster"

  init()
  {
  ::init();
  if(present("runenharnisch",environment( TO))||present("rune", environment(TO)))
  
  {
  command("nimm alles");
  command("zieh alles an ");
  
    }
  }
  
void create()
{
 object ob;
 
  if (!is_clone(TO)) return;
  ::create();
  
  
  
  SetProp(P_SHORT, "Ein Runenmann (III.Grad)");
  SetProp(P_LONG, BS(
  "Das ist einer der beruechtigten Runenmaenner. Sie leben in den dunklen "
  "Katakomben und scheuen das Tageslicht. Angeblich haben sie magische "
  "Kraefte. Dieser hat den III.Grad, den letzen vor dem Meister. Doch verglichen "
  "mit seinem Meister ist er ein mieser Wurm. Trotzdem, fuer Dich ist er ein "
  "ernster Gegner."));
  

  SetProp(P_NAME,"Runenmann");
  
  SetProp(P_GENDER, MALE);
  AddId(({"mann","runenmann","RUM"}));//RUM fuer defender
  SetProp(P_ARTICLE, 1);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10, T_RANGE_MAX: 45]));
  create_default_npc(18);
  // P_LEVEL   = x
  // P_SP/P_HP = x*8+42       =
  // P_HANDS   = x*10         = 
  // P_BODY    = x*20/3       =  
  // P_XP      = HP*HANDS*5   =   // 1/100 davon als Killbonus
  SetProp(P_HANDS, ({" mit einer  sehr starken Runenformel",250,DT_MAGIC}));
  SetProp(P_BODY, 55);
//  SetProp(P_XP, QueryProp(P_XP)+y*100); // Bonus fuer Spells
  SetProp(P_SIZE, 200);
  SetProp(P_ALIGN, -100);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_INFO, "Die Rune des Runenmannes interessiert Dich...\n");
   SetProp( P_RESISTANCE_STRENGTHS,([DT_HOLY: 1.0, DT_TERROR:-1.0]));
   
  SetProp(P_HEAL,5);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,15);
  SetProp(P_NOCORPSE, 0);
  SetProp(P_MSGIN, "steht ploetzlich vor Dir");
  SetProp(P_MSGOUT, "verschwindet");
  SetProp(P_MMSGIN, "taucht ploetzlich auf");
  SetProp(P_MMSGOUT, "verschwindet");
  
  SetProp(P_DIE_MSG,  " bruellt: Und das mir, einem III.Grad!\n");
  
  AddInfo("rune",
  "Hmm, die ist zu gut fuer Dich!", "sagt: "); 
  SetProp(P_TRANSPARENT, 1);
  
  SUID;
  
  CLONEME("/d/dschungel/dante/rune/run");
  CLONEME("/d/dschungel/dante/rune/ruho");
   CLONEME("/d/dschungel/dante/rune/ruha");
   //hier kommt noch ne waffe dazu
command("zieh alles an");
 
 AddInfo(DEFAULT_INFO, "lacht Dich nur aus!\n");
  AddInfo("dante", "Dante, der bloede Sack!","sagt: ");
  SetProp( P_REJECT, ({ REJECT_DROP,
    "Was soll der Runenmann damit?!\n" }) );
AddInfo(({"rune","runen"}),
"Die Runen haben gewaltige Magie, aber es dauert viele Jahre bis man sie "
"nuetzen kann.", "sagt: ");
AddInfo(({"umhang","runenumhang"}),
"Der Umhang weist Dich als Mitglied der Runenmaenner aus.", "sagt: ");
AddInfo(({"runnenmann","runnenmaenner"}),
"Ich bin einer davon, im III.Grad!", "sagt: ");
AddInfo("meister",
"Unser Meister ist unsterblich!", "behauptet: ");

  SetProp(P_SPELLRATE,70);
  
  AddSpell(5,400,
    "Der Runenmann murmelt eine dunkle Formel ueber Dir.\n"
    "Sein Spruch gelingt.\n",
    "Der Runenmann murmelt eine dunkle Formel ueber @WEM.\n",
     DT_MAGIC,([SP_SHOW_DAMAGE:1]));
 AddSpell(4,500,
    "Der Runenmann zeigt Dir eine Hassrune.\n"
    "Sein Spruch gelingt.\n",
    "Der Runenmann zeigt @WEM eine Hassrune.\n",
     DT_TERROR,([SP_SHOW_DAMAGE:1]));
 AddSpell(5,400,
    "Der Runenmann wirft eine Feuerrune nach Dir.\n"
    "Sein Spruch gelingt.\n",
    "Der Runenmann wirft eine Feuerrune nach Dir.\n",
     DT_FIRE,([SP_SHOW_DAMAGE:1]));
 AddSpell(5,400,
    "Der Runenmann laesst eine Hoellenrune explodieren.\n"
    "Sein Spruch gelingt.\n",
    "Der Runenmann laest eine Hoellenrune explodieren.\n",
     DT_LIGHTNING,([SP_SHOW_DAMAGE:1]));
 AddSpell(4,600,
    "Der Runenmann haelt Dir eine Eisrune unter die Nase.\n"
    "Sein Spruch gelingt.\n",
    "Der Runenmann haelt @WEM eine Eisrune unter die Nase.\n",
     DT_COLD,([SP_SHOW_DAMAGE:1]));
 AddSpell(3,600,
    "Der Runenmann zerbricht eine Sturmrune ueber Dir.\n"
    "Sein Spruch gelingt.\n",
    "Der Runenmann zerbricht eine Sturmrune ueber @WEM.\n",
     DT_AIR,([SP_SHOW_DAMAGE:1]));
     
AddSpell(1,700,
  "Der Runenmann schleudert die Rune des Todes nach Dir!\n"
  "Sein Spruch gelingt.\n",
  "Der Runenmann schleudert die Rune des Todes nach @WEM!\n",
  DT_MAGIC, ([SP_SHOW_DAMAGE:1]));
AddSpell(2,600,
  "Der Runenmann stopft Dir eine Terrorrune in den Mund.\n"
  "Dein Spruch gelingt.\n",
  "Der Runenmann stopft @WEM eine Terrorrune in den Mund.\n",
  DT_TERROR, ([SP_SHOW_DAMAGE: 1]));
  
  //nicht gut:)
  
     
AddSpell(1,200,
  "Der Runenmann schleudert die Rune des Todes nach Dir!\n"
  "Sein Spruch misslingt.\n",
  "Der Runenmann schleudert die Rune des Todes nach @WEM!\n",
  DT_MAGIC, ([SP_SHOW_DAMAGE:1]));
AddSpell(1,200,
  "Der Runenmann stopft Dir eine Terrorrune in den Mund.\n"
  "Dein Spruch misslingt.\n",
  "Der Runenmann stopft @WEM eine Terrorrune in den Mund.\n",
  DT_TERROR, ([SP_SHOW_DAMAGE: 1]));
    
  
  AddSpell(1,200,
    "Der Runenmann murmelt eine dunkle Formel ueber Dir.\n"
    "Sein Spruch gelingt nur halb.\n",
    "Der Runenmann murmelt eine dunkle Formel ueber @WEM.\n",
     DT_MAGIC,([SP_SHOW_DAMAGE:1]));
 AddSpell(1,200,
    "Der Runenmann zeigt Dir eine Hassrune.\n"
     "Sein Spruch gelingt nur halb.\n",
    "Der Runenmann zeigt @WEM eine Hassrune.\n",
     DT_TERROR,([SP_SHOW_DAMAGE:1]));
 AddSpell(1,200,
    "Der Runenmann wirft eine Feuerrune nach Dir.\n"
     "Sein Spruch gelingt nur halb.\n",
    "Der Runenmann wirft eine Feuerrune nach Dir.\n",
     DT_FIRE,([SP_SHOW_DAMAGE:1]));
 AddSpell(1,200,
    "Der Runenmann laesst eine Hoellenrune explodieren.\n"
     "Sein Spruch gelingt nur halb.\n",    
    "Der Runenmann laest eine Hoellenrune explodieren.\n",
     DT_LIGHTNING,([SP_SHOW_DAMAGE:1]));
 AddSpell(1,200,
    "Der Runenmann haelt Dir eine Eisrune unter die Nase.\n"

    "Der Runenmann haelt @WEM eine Eisrune unter die Nase.\n",
     DT_COLD,([SP_SHOW_DAMAGE:1]));
 AddSpell(1,200,
    "Der Runenmann zerbricht eine Sturmrune ueber Dir.\n"
     "Sein Spruch gelingt nur halb!\n",
    "Der Runenmann zerbricht eine Sturmrune ueber @WEM.\n",
     DT_AIR,([SP_SHOW_DAMAGE:1]));

   SetChats(5,({
   "Der Runenmann sagt: Verschwinde!\n",
   "Der Runenmann bruellt Dich an!\n",
   "Der Runenmann bedraengt Dich!\n",
   "Der Runenmann sagt: Was willst Du!?\n",
   "Der Runenmann dreht sich kurz weg.\n",
   "Der Runenmann lacht Dich aus.\n"}));

RMASTER->add_mann();
   
  
  } 


void Defend(int dam, mixed dam_type, mixed spell, object enemy)
  {
      RMASTER->ruf_um_hilfe(enemy);
          ::Defend(dam, dam_type, spell, enemy);
            }
  
  
  
  
  remove(int arg)
    {
        RMASTER->remove_mann(this_object());
            ::remove(arg);
              }          