//wurfrune laehmt gegner kurz
inherit "std/thing";

#include <properties.h>
#include "/players/dante/myowndefine.h"

create()
{
  if (!is_clone(this_object())) return;  
  ::create();
  SetProp(P_SHORT, "Eine Rune");
  SetProp(P_LONG, 
  "Eigentlich ist das ja ein Stein, in den eine Rune eingemeiselt "
  "wurde. Der Stein liegt recht gut in der Hand.");
  AddReadDetail("rune",
  "Du kannst sie nicht lesen. Aber dir faellt etwas auf. Der Stein bzw die Rune "
  "kann man sicher gut auf seine Gegner schleudern!\n");
  SetProp(P_WEIGHT, 80);
  SetProp(P_VALUE, 3800+random(500));
  SetProp(P_NAME, "Rune");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_MATERIAL, MAT_MISC_STONE);
  SetProp(P_MAGIC, 1);
  SetProp(P_NOBUY, 1);
  SetProp(P_INFO, "Loese das Geheimniss...\n");
  AddId(({"stein", "rune"}));
  AddCmd(({"wirf", "werfe"}), "wirf");
}

wirf(str)
{
  string was, wer;
  object victim, tp;
  int dauer;
  notify_fail("Was moechtest Du werfen?\n");
  if (!str)
     return 0;
  if (!sscanf(str, "%s auf %s", was, wer))
    return 0;
  if (!id(was))
    return 0;
  notify_fail("Nach wem moechtest Du die Rune werfen?\n");
  if (!(victim=present(wer, environment(this_player()))))
    return 0;
  if (query_once_interactive(victim))
  {
    write("Wirf niemals Runen nach Deinen Mitspielern!\n");
    return 1;
  }
  tp = this_player();
  if (tp->QueryProp(P_ATTACK_BUSY))
  {
     write("Im Moment kannst Du das nicht mehr.\n");
     return 1;
  }
  tp->SetProp(P_ATTACK_BUSY,1);
  dauer = (tp->QueryAttribute(A_DEX) + tp->QueryAttribute(A_STR))/2 - 
    (20 - tp->QueryProp(P_LEVEL))/6;
  if (dauer > 30)
    dauer = 30;
  dauer = random(dauer);
  if (dauer>0)
     victim->SetProp(P_DISABLE_ATTACK, 
		     victim->QueryProp(P_DISABLE_ATTACK)+dauer);
  write("Du wirfst "+victim->name(WEM)+" die Rune an den Kopf.\n");
  say(capitalize(tp->name())+" wirft "+victim->name(WEM)+
      " die Rune an den Kopf.\n");
  tell_room(environment(tp), capitalize(victim->name(WER, 1))+
	    " wird mit einer Rune beworfen.\n");
  remove();
  return 1;
}
//ob das so geht weiss net, zeit usw....
