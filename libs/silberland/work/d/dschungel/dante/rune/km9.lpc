// dante@SilberLand
//runnemann
//nicht so arg gemein
inherit "std/mnpc";
#include <mnpc.h>   
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "/players/dante/myowndefine.h"
#define RMASTER "/d/dschungel/dante/rune/rmaster"

 init()
{
::init();
 if(present("runenharnisch", environment(TO))||present("rune", environment(TO)))
{
command("nimm alles");
command("zieh harnisch an");
  }
}

void create()
{
 object ob;
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Runenmann (I.Grad)");
  SetProp(P_LONG, BS(
  "Das ist einer der beruechtigten Runenmaenner. Sie leben in den dunklen "
  "Katakomben und scheuen das Tageslicht. Angeblich haben sie magische "
  "Kraefte. Dieser allerdings ist noch in Ausbildung und traegt daher keinen Runenumhang."));
 RMASTER->add_mann();
 
  SetProp(P_NAME,"Runenmann");
  
  SetProp(P_GENDER, MALE);
  AddId(({"mann","runenmann","RUM"}));//rum fuer defender
  
  SetProp(P_ARTICLE, 1);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10, T_RANGE_MAX: 45]));
  create_default_npc(13);
  // P_LEVEL   = x
  // P_SP/P_HP = x*8+42       =
  // P_HANDS   = x*10         = 
  // P_BODY    = x*20/3       =  
  // P_XP      = HP*HANDS*5   =   // 1/100 davon als Killbonus
  SetProp(P_HANDS, ({" mit einer Runenformel",150,DT_MAGIC}));
  SetProp(P_BODY, 40);
//  SetProp(P_XP, QueryProp(P_XP)+y*100); // Bonus fuer Spells
  SetProp(P_SIZE, 200);
  SetProp(P_ALIGN, -100);
  SetProp(P_MAX_HANDS, 2);
 SetProp(P_INFO, "Der Umhang scheint interessant zu sein.\n");
   SetProp( P_RESISTANCE_STRENGTHS,([DT_HOLY: 1.0, DT_TERROR:-1.0]));
   
  SetProp(P_HEAL,5);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,5);
  SetProp(P_NOCORPSE, 0);
  SetProp(P_MSGIN, "steht ploetzlich vor Dir");
  SetProp(P_MSGOUT, "verschwindet");
  SetProp(P_MMSGIN, "taucht ploetzlich auf");
  SetProp(P_MMSGOUT, "verschwindet");
  
  SetProp(P_DIE_MSG,  " murmelt eine Formel, die ihm wenig nuetzt!\n");
  
  
  
//  SUID;
//  CLONEME("/d/gebirge/dante/armour/run");
 // command("zieh alles an");
 
 
 AddInfo(DEFAULT_INFO, "sagt: TKiut NuiZtro!\n");
  AddInfo("dante", "Dante, der bloede Sack!","sagt: ");
  SetProp( P_REJECT, ({ REJECT_DROP,
    "Was soll der Runenmann damit?!\n" }) );
AddInfo(({"rune","runen"}),
"Die Runen haben gewaltige Magie, aber es dauert viele Jahre bis man sie "
"nuetzen kann.", "sagt: ");
AddInfo("umhang",
"Der Umhang weist Dich als Mitglied der Runenmaenner aus.", "sagt: ");
AddInfo(({"runnenmann","runnenmaenner"}),
"Ich bin einer davon. Aber nur im I.Grad!", "sagt: ");
AddInfo("runenumhang",
"Der Umhang darf erst ab der 2. Stufe getragen werden!", "sagt: ");
  SetProp(P_SPELLRATE,70);
  
  AddSpell(3,200,
    "Der Runenmann murmelt eine dunkle Formel ueber Dir.\n"
    "Sein Spruch gelingt.\n",
    "Der Runenmann murmelt eine dunkle Formel ueber @WEM.\n",
     DT_MAGIC,([SP_SHOW_DAMAGE:1]));
 AddSpell(2,300,
    "Der Runenmann zeigt Dir eine Hassrune.\n"
    "Sein Spruch gelingt.\n",
    "Der Runenmann zeigt @WEM eine Hassrune.\n",
     DT_TERROR,([SP_SHOW_DAMAGE:1]));
 AddSpell(3,200,
    "Der Runenmann wirft eine Feuerrune nach Dir.\n"
    "Sein Spruch gelingt.\n",
    "Der Runenmann wirft eine Feuerrune nach Dir.\n",
     DT_FIRE,([SP_SHOW_DAMAGE:1]));
 AddSpell(3,200,
    "Der Runenmann laesst eine Hoellenrune explodieren.\n"
    "Sein Spruch gelingt.\n",
    "Der Ruenenmann laest eine Hoellenrune explodieren.\n",
     DT_LIGHTNING,([SP_SHOW_DAMAGE:1]));

  
  AddSpell(1,50,
    "Der Runenmann murmelt eine dunkle Formel ueber Dir.\n"
    "Sein Spruch misslingt.\n",
    "Der Runenmann murmelt eine dunkle Formel ueber @WEM.\n",
     DT_MAGIC,([SP_SHOW_DAMAGE:1]));
 AddSpell(1,100,
    "Der Runenmann zeigt Dir eine Hassrune.\n"
    "Sein Spruch misslingt.\n",
    "Der Runenmann zeigt @WEM eine Hassrune.\n",
     DT_TERROR,([SP_SHOW_DAMAGE:1]));
 AddSpell(1,50,
    "Der Runenmann wirft eine Feuerrune nach Dir.\n"
    "Sein Spruch misslingt.\n",
    "Der Runenmann wirft eine Feuerrune nach Dir.\n",
     DT_FIRE,([SP_SHOW_DAMAGE:1]));
 AddSpell(1,50,
    "Der Runenmann laesst eine Hoellenrune explodieren.\n"
    "Sein Spruch misslingt.\n",
    "Der Ruenenmann laest eine Hoellenrune explodieren.\n",
     DT_LIGHTNING,([SP_SHOW_DAMAGE:1]));





   SetChats(5,({
   "Der Runenmann sagt: Verschwinde!\n",
   "Der Runenmann bruellt Dich an!\n",
   "Der Runenmann bedraengt Dich!\n",
   "Der Runenmann sagt: Was willst Du!?\n",
   "Der Runenmann dreht sich kurz weg.\n",
   "Der Runenmann lacht Dich aus.\n"}));
   
  
  } 




void Defend(int dam, mixed dam_type, mixed spell, object enemy)
  {
        RMASTER->ruf_um_hilfe(enemy);
                  ::Defend(dam, dam_type, spell, enemy);
                              }
                              

  remove(int arg)
      {
              RMASTER->remove_mann(this_object());
                          ::remove(arg);
      }
      