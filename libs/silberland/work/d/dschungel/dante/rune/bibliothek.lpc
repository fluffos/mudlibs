
inherit "std/room";
#include "/players/dante/myowndefine.h"
#include <properties.h>
#include <language.h>

create()
{
	::create();
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25,ENV_TERRAIN:TT_CAVE]) );      
SetProp( P_INT_SHORT, " Die Geheimbibliothek der Runenmaenner" );
SetProp( P_INT_LONG, break_string(" Du stehst inmitten der riesigen"
+" Bibliothek der Runenmaenner. Hier stehen alle Schriftstuecke, "
+"die jemals auf der Welt geschrieben wurden. Du kannst sogar Schriftstuecke "
+"aus der Zeit vor den 'grossen Kriegen' finden. Du schaetzt die Anzahl der "
+"Buecher auf mehrere Millionen. Die Hoehe der Bibliothek laesst sich "
+" nicht erahnen. Laenge und Breite sind auf ca 200 m zu schaetzen.", 78));
	SetProp( P_LIGHT, 1 );
	SetProp( P_INDOORS, 1 );

AddDetail( ({ "buch", "buecher", "schriftstuecke"}), break_string(
" Du bist lustig. 1. gibt es hier soviele Buecher, dass diese fuer ein "
+"ganzes Heer reichen wuerde, um bis zu ihrem Lebensende nichts anderes "
+"zu tun, als zu lesen. 2. kannst Du diese Buecher sowieso nicht lesen, "
+" da sie in der alten Sprache geschrieben sind.", 78));
AddDetail( ({"boden", "fussboden"}), break_string(
" Der Boden besteht scheinbar aus nacktem Gestein. Aber das Gestein"
+" ist nicht wie erwartet kalt, sondern es strahlt eigenartigerweise "
+"eine leichte Waerme ab. Ausserdem vibrieren die Waende, an denen keine"
+" Regale stehen leicht.", 78));
AddDetail ( ("decke"), break_string(
"Die Decke, na ja, sie ist halt oben und so hoch ueber Dir, "
+"dass Du nur ein leichtes Schimmern siehst. Was koennte das "
+"Schimmern nur sein ???", 78));
AddDetail ( ("schimmern"), break_string(
"Das Schimmern ruehrt wohl von der Decke her. Leider kannst Du von "
+"diesem Standpunkt aus nichts weiter erkennen.", 78));
AddDetail( ({"waerme", "hitze"}), break_string("Die Waerme strahlt "
+"eine leichte Behaglichkeit aus. Von ihr scheint nichts Bedrohliches "
+"auszugehen.", 78));
AddDetail( ({"wand", "waende"}), break_string("Die Waende scheinen"
+" glatt und eben zu sein. Aber Moment mal, was ist das ??"
+" Ist da nicht ein kleiner Ritz zu sehen ??", 78));
AddDetail ( ({"regal", "regale"}), break_string(
"Die Regale sind vollgepackt mit Buechern. Nur die Wenigsten kannst Du "
+"lesen. Ein Grossteil der Buecher ist mit eigenartigen Zeichen beschrieben, welche"
+" wohl nur die Runenmaenner entziffern koennen.", 78));
AddDetail ( ({"zeichen", "eigenartige zeichen"}), break_string(
"Die Zeichen sehen sehr geheimnisvoll aus. Sie verstaerken"
+" nur noch den Eindruck, den Du sowieso schon von dieser Burg hast.", 78));

AddDetail( ("ritz"), break_string("Als Du Dir den Ritz genauer ansiehst, "
+" kannst Du eine Geheimtuer ausmachen, die wohl nicht durch menschliche "
+"Kraefte geoeffnet werden kann.", 78));
 

AddExit ( "unten", "./treppengang" );
}

