inherit "std/room";
#include <properties.h>
#include <language.h>
#include "/players/dante/myowndefine.h"
create()
{
::create();



  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25,ENV_TERRAIN:TT_CAVE]) );      
SetProp(P_LIGHT, 1);
SetProp ( P_INDOORS, 1 );
SetProp ( P_INT_SHORT, break_string("Dies ist das Herzstueck Paranors", 78));
SetProp ( P_INT_LONG, break_string ("Dieser Raum ist im Grunde nicht viel mehr als als"
+" eine Art kreisfoermiger Laufgang ueber eine tiefe Grube, die weit ueber 30 Meter ins Gestein hinabfuehrt."
+" Am Grunde lodert ein gigantisches Feuer, das von einer unbekannten Quelle gespeist wird und dessen orange- und dunkelrote Flammen den Schacht hinaufzuengeln."
+" Oben am Innenrand verlaeuft nur der kleine Laufgang, etwa einen Meter breit,"
+" mit einem niedrigen Eisengelaender. Von der Decke und den Waenden leiten "
+"Heizungsschaechte die Waerme in andere Teile des Gebaeudes. Ein unsichtbares"
+" Pumpsystem steuert die vom offenen Schmelzofen erzeugte Waermemenge."
+" Du hast Glueck, dass die Blasebaelge nicht voll in Betrieb sind. Dies haette"
+" naemlich Deinen sicheren Tod bedeutet.", 78 ));
AddDetail ( ({ "feuer", "flammen" }), 
"Das Feuer sieht nicht nur heiss aus, es ist es auch bestimmt.\n" );
AddDetail ( ({ "raum", "laufgang" }), break_string(
"Du befindest Dich mittendrin. Der Laufgang ist relativ schmal."
+" Mehr als eine Person (in der Breite) kann den Laufgang nicht betreten."
+" Zum Glueck ist er mit einem Eisengelaender abgesichert. Aber ist das "
+"Gitter auch wirklich sicher ????", 78));
AddDetail ( ({"gitter", "eisengitter"}), break_string(
"Das Eisengitter scheint, trotz seines hohen Alters, sehr robust "
+"und stabil"
+" zu sein. Die damalige Baukunst schien ein enormes Wissen zu erfordern, wenn"
+" man solche Arbeiten zustande bringen konnte.", 78));
AddDetail ( ({ "boden", "grund", "grunde" }), break_string(
"Auf dem Boden lodert das Feuer, welches wohl die komplette"
+" Druidenburg heizt. Du bist Dir nicht sicher, aber hast das Gefuehl, als"
+" ob dieses Feuer noch einem anderen Sinn und Zweck dient.", 78 ));
AddDetail( ({"wand", "waende", "decke"}), break_string(
"An den Waenden und der Decke siehst Du viele Rohre und Leitungen,"
+" welche die Abwaerme, die hier erzeugt wird in das Innere der Burg transportieren."
+" Bei der Menge an Waerme, die hier erzeugt wird, kannst Du Dir nun grob "
+"vorstellen, wie gross diese Burg sein muss.", 78));
AddDetail( ({"rohre", "leitung"}), break_string(
"Die Rohre fuehren ueber die Waende durch die Decke. Sie dienen"
+" wohl der zentralen Heizung der Burg. Aber wer weiss, "
+"ob diese Druiden nicht noch andere Machschaften in diesem "
+"Raum durchgefuehrt haben. ", 78));
AddDetail( ({"blasebalg", "blasebaelger"}), break_string(
"Die Blasebaelge haben wohl nur eine Funktion, naemlich das "
+"Feuer anzuheizen und ihm stets die optimale Sauerstoffzufuhr zu ermoeglichen."
+" Es sind, soweit Du erkennen kannst 4 Blasebaelge am Boden zu erkennen, wobei "
+"jeder Einzelne etwa manngross ist.", 78));
AddDetail ( ({"pumpsystem", "pumpe", "pump"}), break_string(
"Wie Du vielleicht ueberlesen haben koenntest...ES IST NICHT SICHTBAR!!!", 78));
AddExit ( "oben", "./keller1" );
AddExit ( "sueden", "./keller3.lpc" );
}
