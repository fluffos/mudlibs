//dante umhang der runenmaenner
//erkennungszeichen...sonst guardedexits

#include "/players/dante/myowndefine.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein Runenumhang");
  SetProp(P_LONG, BS( 
  "Dieser Umhang ist das Erkennungszeichen der Runenmaenner. Normalerweise "
  "wird er einem in einer feierlichen Zeremonie verliehen, aber mann kann "
  "auch so, wie Du, zu ihm kommen. Er besteht aus dicken, roten Stoff und "
  "ist ueber und ueber mit schwarzen Runen bestickt."));
  AddDetail(({"runen","rune"}),
  "Dir sagen die Runen ueberhaupt nichts.");
 SetProp(P_DAM_PROTECTION, ([DT_TERROR:3, DT_SLASH:1, DT_MAGIC:2]));
         
  SetProp(P_NAME, "Runenumhang");
  SetProp(P_GENDER, MALE);
  AddId( ({"runenumhang", "umhang","/nRUH"}) );
  SetProp(P_INFO, ("Der Umhang kann Dir gute Dienste leisten!\n"));
  SetProp(P_NOBUY, 1);
  SetProp(P_ARMOUR_TYPE, AT_CLOAK );
  SetProp(P_AC, 8);
  SetProp(P_MATERIAL, MAT_CLOTH );
  SetProp(P_WEIGHT, 500);
  SetProp(P_VALUE, 2000);
}

