//der harnisch des runenmeisters

inherit "std/armour";
#include <moving.h>

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <wizlevels.h>
#include "/players/dante/myowndefine.h"
    
create()
{
  if (!is_clone(this_object()))
     return;
  ::create();

  AddId (({"harnisch","runenharnisch","harnisch des meisters"}));
  SetProp (P_SHORT, "Der Harnisch des Runenmeisters");
  SetProp (P_LONG, BS(
  "Das ist der Harnisch des Runenmeisters. Er besteht aus schwarz-glaenzendem "
  "Metall und ist kunstvoll verziert mit blutroten Runen. Seine maechtige Aura "
  "beeindruckt Dich und Du bist froh, so ein wertvolles Stueck zu besitzen!\n"));
  
  SetProp (P_NAME, "Runenharnisch");
   SetProp (P_GENDER, MALE);
   SetProp (P_WEIGHT, 2000);
   SetProp(P_INFO, ("Der Runenharnisch wehrt ab und zu Magie ab!\n "));
   SetProp (P_VALUE, 5000);
    SetProp (P_MATERIAL, ([MAT_STEEL:50, MAT_GOLD:30, MAT_BLOOD:10, MAT_MAGIC:20]));
     SetProp (P_ARMOUR_TYPE, AT_ARMOUR);
   SetProp(P_AC, 39+random(2)); 
SetProp(P_RESISTANCE, ({DT_MAGIC,DT_FIRE, DT_BLUDGEON, DT_SLASH, DT_RIP, DT_PIERCE}));
   SetProp(P_WEAR_RESTRICTIONS, ([A_INT:16]) );
  SetProp(P_NOBUY, 1);
  SetDefendFunc(this_object());
                      
   
  
  }
  
  int DefendFunc(mixed dam_type,mixed spell,mixed enemy)
  {
object pl,env;
  if (!objectp(pl=QueryProp(P_WORN)))
      return 0;
        if (!pointerp(dam_type)) dam_type=({dam_type});
          if (member(dam_type,DT_MAGIC)>=0)      
         switch(random(10))
         {
         case 0..1:
         tell_object(environment(TO),
         "Der Runenharnisch wehrt den Angriff ergolgreich ab!\n");
         return 500;
         break;
         case 2..9:
         return 0;
         break;
         default:write("BUG!\n");
         
         }
    return 0;
    }
            

                                                          

