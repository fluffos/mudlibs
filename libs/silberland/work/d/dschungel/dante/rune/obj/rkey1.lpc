//schluessel fuer TOR in hof
inherit "std/thing";

#include <properties.h>
#include <rooms.h>
#include "/players/dante/myowndefine.h"


int count=0;

reset()  {
	::reset();
  count++;
  if(count>=10)  {
  say(BS(
  "Der Schluessel loest sich in Luft auf!"));
 remove(); }  }
  	

create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp (P_SHORT, "Ein grosser Schluessel");
  SetProp (P_LONG,BS (
"Der grosse Schluessel ist mit vielen Runen verziert."));
  AD(({"runen","rune"}),
"Dir sagen sie nichts.");
  SetProp (P_NAME, "Schluessel");
  SetProp(P_NAME_ADJ, "gross");
  SetProp (P_GENDER, MALE);
  SetProp (P_VALUE, 0);
  SetProp (P_WEIGHT, 100);
  SetProp (P_NOBUY, 1);
  SetProp (P_NEVERDROP, 1);
  SP(P_NODROP, 1);
  AddId (({"RKEY_1", "schluessel"}));
  
SetProp(P_MATERIAL, ([MAT_IRON:100]));
}
string QueryDoorKey()
{
return ("/d/dschungel/dante/rune/room/bruecke2")+":"+("/d/dschungel/dante/rune/room/hof1");   
}



