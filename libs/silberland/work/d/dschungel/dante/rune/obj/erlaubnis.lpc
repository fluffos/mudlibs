
/*

   Die Erlaubnis um ueber die Bruecke zu gehen QUESTITEM Zordan@SL

*/

inherit "std/thing";

#include <properties.h>
#include "../def.h"

init() {
  ::init();
  if (!living(MENV)) TO->remove();
}

create() {
  ::create();
  if (!is_clone(this_object())) return;

  SetProp (P_IDS, ({"\n_erlaubnis"}));
  SetProp (P_SHORT, 0);
  SetProp (P_NAME, 0);
  SetProp (P_NEVERDROP, 1);
  SetProp (P_NODROP, 1);
  SetProp (P_WEIGHT, 0);
}
