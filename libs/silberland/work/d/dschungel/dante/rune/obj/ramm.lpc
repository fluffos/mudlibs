//dante sl 99
//rammbock

inherit "std/thing"; 
#include <language.h>
#include <properties.h>
#include <combat.h>
#include <moving.h>
#include "../global.h"

int count=0;

reset()  {
	::reset();
  count++;
  if(count>=10)  {
  say(BS(
  "Der Baumstamm loest sich in Luft auf!"));
 remove(); }  }
  		

create()

{
 if(!is_clone(this_object())) return;
  thing::create();
  SP(P_NAME_ADJ, "gewaltig");
  SetProp(P_SHORT,"Ein gewaltiger Baumstamm");
  SetProp(P_LONG,BS(
"Der Baumstamm ist sicher 3 Meter lang und sehr schwer. Wozu er dient "
"ist Dir noch raetselhaft, aber mit ihm kann man sicher einiges zerstoeren..."));   
  SetProp(P_VALUE, 0);
  SetProp(P_WEIGHT,3000);
  SetProp(P_GENDER, MALE);
  SetProp(P_NAME,"Baumstamm");
  SetProp(P_MATERIAL, ([MAT_OAK:100]));
  SetProp(P_INFO, BS(
  "Der Baumstamm ist sicher ein sehr guter Rammbock!!!"));
  SP(P_MAGIC, 1);
  AddId(({"baumstamm","stamm", "DANTE_RAMMBOCK"}));
  SetProp(P_NOBUY, 1);
  SP(P_NODROP, 1);
  SP(P_NEVERDROP, 1);
}
