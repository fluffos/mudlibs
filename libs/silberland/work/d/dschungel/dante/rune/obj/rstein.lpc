//rammbock

inherit "std/thing"; 
#include <language.h>
#include <properties.h>
#include <combat.h>
#include <moving.h>
#include "../global.h"

  		

create()

{
 if(!is_clone(this_object())) return;
  thing::create();
  SP(P_NAME_ADJ, "gross");
  SetProp(P_SHORT,"Ein grosser Stein");
  SetProp(P_LONG,BS(
"Dieser Stein ist sicher zu gross um ihn aufzuheben, doch rollen "
"kann man ihn sicher."));
  SetProp(P_VALUE, 0);
  SP(P_NOGET, 1);
  SetProp(P_WEIGHT,30000000);
  SetProp(P_GENDER, MALE);
  SetProp(P_NAME,"Stein");
  SetProp(P_MATERIAL, ([MAT_STONE:100]));
  SetProp(P_INFO, BS(
"Vielleicht hat er ja mit dem Katapult unter Dir zu tun..."));
  SP(P_MAGIC, 1);
  AddId(({"stein","R_STEIN"}));
  SetProp(P_NOBUY, 1);
}
