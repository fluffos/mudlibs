inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include "/players/dante/myowndefine.h"

create()
{
  ::create();
  SetProp(P_SHORT, "Eine Runenhose");
  SetProp(P_LONG,BS(
  "Die Runenhosen bestehen aus dunkelroten, groben Stoff, in den grosse, "
  "schwarze Runen aus Gold eingenaeht sind."));
  AddDetail(({"runen","rune"}),
  "Dir sagen sie leider nichts.\n");
  SetProp(P_NAME, "Runenhose");
  AddId(({"runenhose","hose"}));
  SetProp(P_GENDER, FEMALE);
  SetProp(P_ARTICLE, 1);
  SetProp(P_WEIGHT,1000);
  SetProp(P_VALUE,2000);
  SetProp(P_AC, 10);
  SP(P_DAM_PROTECTION, ([DT_TERROR: 1,DT_HOLY: 0.3, DT_FIRE:1, DT_SLASH:2]));
   
  SetProp(P_ARMOUR_TYPE, AT_TROUSERS);
  SetProp(P_MATERIAL, ([MAT_CLOTH:80, MAT_GOLD:20]));
}
