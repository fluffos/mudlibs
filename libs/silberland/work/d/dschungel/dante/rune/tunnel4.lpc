inherit "std/room";
#include <properties.h>
#include <language.h>
#include "/players/dante/myowndefine.h"
#include <moving.h>

create()
{
::create();
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25,ENV_TERRAIN:TT_CAVE]) );      
SetProp(P_LIGHT, 0);
SetProp ( P_INDOORS, 1 );
SetProp ( P_INT_SHORT, break_string("Dies ist ein finsterer Tunnel.", 78));
SetProp ( P_INT_LONG, break_string("Dieser Tunnel hier unterscheidet sich ein wenig "
+"von den Anderen. Die Waende scheinen ein wenig zu vibrieren, als Du sie versuchsweise "
+"beruehrst. Du fragst Dich nicht zum ersten Mal, ob Du"
+" in dieser Burg wohl behuetet und"
+" gut aufgehoben bist. Der Boden ist, ganz anders als die anderen Gaenge"
+" fast voellig staubfrei und scheint mit leicht schimmernden Streifen"
+" versehen zu sein.", 78));
AddDetail ( ({"tunnel", "tunnelsystem" }), break_string(
"Der Tunnel scheint nicht EIN Tunnel zu sein, sondern ein ganzes Tunnelsystem."
+" Es erstreckt sich ueber mehrere Kilometer in verschiedene Richtungen unter"
" und um das Gebiet der Burg herum.", 78));
AddDetail ( ({"waende","wand"}), break_string(
" Die Waende scheinen leicht zu schimmern. Du kannst nicht genau"
+" erkennen, aus welchem Gestein sie bestehen. Aber eins ist sicher,"
+" es ist haerter als Granit und beeindruckt Dich mit einem "
+"leicht silbernen Glaenzen, das den Schein Deines Lichtes sanft"
+" zurueckstrahlt.", 78));
AddDetail ( ({"boden", "fussboden" }), break_string(
"Der Boden ist besteht, ebenso wie die Waende, aus diesem herrlichen"
+" Gestein. Dieses silberne Glaenzen erinnert Dich an den Glanz des"
+" Mithrils, welches die Zwerge vor langen Jahren in den Zwergenminen"
+" der groessten Berge abgebaut haben. Sie schufen aus ihm die "
+"herrlichsten Waffen und Ruestungen, die heute noch ihresgleichen"
+" suchen.", 78));
AddDetail ( ({"mithril", "glanz", "silber", "streifen"}), break_string(
"Wer einmal diesen Glanz gesehen hat, der wird ihn nie "
+"vergessen. Dieses Silber ist sehr selten und kann, wenn"
+" es von den faehigsten Zwergenschmieden bearbeitet wird, "
+"sogar magische Kraefte freisetzen, welche die Waffen und"
+" Ruestungen um ein Vielfaches staerker machen, als sie es"
+" ohnehin schon sind.", 78));
AddDetail ( ({"decke", "tunneldecke"}), break_string(
" Die Tunneldecke laesst den leicht silbernen Glanz der Waende"
+" und des Bodens zurueckschimmern. Auch in der Decke scheint"
+" sich dieses seltene Metall zu befinden.", 78));

AddExit ("suedwesten","./tunnel3.lpc");
}
