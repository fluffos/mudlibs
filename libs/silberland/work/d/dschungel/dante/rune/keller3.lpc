inherit "std/room";
#include <properties.h>
#include <language.h>
#include "/players/dante/myowndefine.h"
create()
{
::create();


  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25,ENV_TERRAIN:TT_CAVE]) );      
SetProp(P_LIGHT, 0);
SetProp ( P_INDOORS, 1 );
SetProp ( P_INT_SHORT, break_string("Dies ist ein finsterer Tunnel.", 78));
SetProp ( P_INT_LONG, break_string("Der Tunnel fuehrt, wie die Roehren des "
+"Pump- und Heizsystems anscheinend durch die ganze Druidenburg. Verschiedene"
+" Zu- und Abgaenge sind seit laengerem nicht benutzt worden, da die Boeden "
+"mit einer zentimeterhohen Schicht Staub bedeckt sind.", 78));
AddDetail ( ({"staub", "staubschicht" }), break_string(
"Der Staub scheint schon einige Zeit hier zu liegen, wie Du an der Dicke der Schicht sehen kannst.", 78));
AddDetail ( ({"tunnel", "tunnelsystem" }), break_string(
"Der Tunnel scheint nicht EIN Tunnel zu sein, sondern ein ganzes Tunnelsystem."
+" Es erstreckt sich ueber mehrere Kilometer in verschiedene Richtungen unter"
+" und um das Gebiet um die Burg herum.", 78));
AddDetail ( ({"boden", "fussboden" }), break_string(
"Du stehst auf einen leicht verstaubten Fussboden. Hier scheint vor "
+"kurzem noch jemand gegangen zu sein. Eigentlich kann es nur Alanon"
+" gewesen sein, aber vielleicht solltest Du dir die Spuren mal "
+" genauer ansehen.", 78));
AddDetail ( ({ "spuren", "fusspuren", "abdruecke", "fussabdruecke" }),
break_string("Die Spuren, die Du hier im Staub siehst, stammen von den "
+"Schuhen eines Menschen. Anhand der Groesse kannst Du fesstellen, dass"
+" sie von einem grossen Mann stammen muessen.", 78));
AddDetail ( ({"decke", "wand", "waende", "tunneldecke"}), break_string(
"Die Decke und die Waende strahlen eine leichte Waerme aus. Sie scheinen"
+" von einer, im moment nicht zu identifizierenden Waermequelle durchflossen"
+" zu werden. Die Waende sind glatt und ohne Makel. Du siehst des oefteren"
+" weitere Durchgaenge in den Waenden. Diese Burg muss ein ganzes Tunnelgeflecht"
+" besitzen.", 78));
AddDetail ( ({"zugaenge", "gaenge", "wege","abzweigungen"}), break_string(
" Die Abzweigungen die Du erkennen kannst, laufen kreuz und quer"
+" unter der Burg durch. Du must aufpassen, dass Du dich nicht verlaeufst.", 78));

AddExit ( "norden", "./keller2.lpc" );
AddExit ("suedwesten","./tunnel1.lpc" );
}
