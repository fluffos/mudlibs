#include <properties.h>        
#include <combat.h>
#include <language.h>

inherit "/std/weapon";

create ()
{
        ::create();
        SetProp(P_WEAPON_TYPE, WT_CLUB);
SetProp(P_INFO, break_string(
"Dies ist ein unwahrscheinlich leicht in der Hand liegender Streitkolben. "
+"Er ist am Griff mit geheimen Zeichen bedeckt. Am Griff ist ausserdem"
+" noch eine kleine Schlaufe.", 78));
        SetProp(P_DAM_TYPE, DT_BLUDGEON);
SetProp(P_GENDER, MALE);
SetProp(P_VALUE, 1900);
SetProp(P_WEIGHT, 2000);
SetProp(P_SHORT, "Ein Runenstreitkolben");
SetProp(P_NAME, "Runenstreitkolben");
SetProp(P_WC, 200);
SetProp(P_LONG, break_string("Dieser Streitkolben ist einer der legendaeren"
+" Zwergenhochlandwaffen, die, da das Wissen um die Herstellung dieser Waffen"
+" verloren gegangen ist, aeusserst selten sind. Sie wurden einst von dem "
+"beruehmten Zwergenschmied Bruenor Heldenhammer geschmiedet, der sein"
+" ganzes Leben der Waffenschmiedekunst widmete."
+" Am Griff des Kolbens befindet sich eine Schlaufe. Diese Schlaufe dient " 
+"dem waffenfuehrenden Besitzer zur Sicherung des "
+"Streitkolbens. Um das Handgelenk gelegt kann ihm die Waffe so schnell"
+" nicht entgleiten oder entrissen werden."
+" Der Griff ist mit magischen Runen bestueckt. Die zwar keines magischen"
+" Ursprungs sind, aber den Bestizer der Waffe beschuetzen und heilvoll"
+" aus jeder noch so aussichtslosen Lage befreien sollen.", 78)); 
       AddId("waffe");
AddId("kolben");
AddId("streitkolben");
AddId("Kolben");
SetProp(P_NR_HANDS, 1);
  SetProp (P_MATERIAL, ([MAT_STEEL: 20, MAT_OAK:80]));         
 SetProp (P_MAGIC, 1);
 SetProp (P_NOBUY, 1);
 SetProp (P_WC_FIX, 50);
 SetProp (P_WIELD_RESTRICTIONS, ([A_STR: 10, A_INT:15, A_DEX:15]));        

}
