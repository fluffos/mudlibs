//dante sl 99 98
//raum im zentralturm

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../burg.h"

int besetzt=0;
string besetzer="";


create()
{
  ::create();

SetProp( P_INT_SHORT, "In einem Turm der Runenburg" );
  SetProp( P_INT_LONG, BS(
"der Runenburg."));


      
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20,ENV_TERRAIN:TT_HOUSE]) );

  AddSound( DEFAULT_SOUND,
    "Du hoerst Schreie von irgendwo her.");
AddSound(({"schrei","schreie"}),
"ALARM!!!");    
  AddSmell( DEFAULT_SMELL,
"Es riecht nach Kampf!");
    AddSmell("kampf",
"Keine Ahnung wie Kampf riecht...");



ASE("unten", "chek");
                                                                  
ACD(({"katapultier","katapultiere"}), "up");
ACD(({"steige","steig"}), "besetze");
ACD(({"verlasse", "verlass"}), "runter");
ASE("oben", "nix");
}


nix()  {
 	NF(BS("Du versuchst zu dem Loch in der Decke zu gelangen, aber "
 	"so schaffst Du es sicher nicht. Vielleicht kann Dir ja etwas in dem "
 	"Raum hier dabei helfen?!"));
 }
 	
 	
  ist_jem_da()  {
 	object ob;
  if(besetzt==0)  {
  	//call_other( FR"ztu4", "stone_dest");
  	tell_object(TP,
  	"Du rollst einen grossen Stein durch das Loch nach unten.\n"
  	"Der Stein faellt auf das Katapult und zerbricht, doch leider\n"
  "steht niemand auf dem Katapult!\n");
  tell_room(FR"ztu4",
  CAP_TPN+" rollt einen grossen Stein durch das Loch nach unten!\n",
  ({TP}));
  
  tell_room(FR"ztu3",
  "Ein grosser Stein faellt durch das Loch von oben herab und zerbricht!\n"
  ""+CAP_TPN+" hat ihn heruntergeworfen!\n"); return; }
   
  else {
  ob=find_living(besetzer);
  tell_object(ob,
  "\n"
  "Ein grosser Stein wird von "+TPN+" heruntergeworfen und landet\n"
  "krachen auf dem anderen Ende des Katapultes! Der Stein zerbricht in\n"
  "1000 Teile und Du wirst vom Katapult nach oben geschleudert!!!\n\n");
tell_room(FR"ztu3",
"Ein grosser Stein faellt durch das Loch von oben genau auf das "
"Katapult.\n"+TPN+" hat ihn heruntergeworfen!\nDer Stein zerbricht und "+CAP(besetzer)+" wird nach oben katapultiert!\n", ({besetzer}));
//call_other( FR"ztu4", "stone_dest");
  	tell_object(TP,
  	"\n"
  "Du rollst einen grossen Stein zu dem Loch und wirfst ihn nach unten!\n"
  "Der Stein faellt genau auf ein Ende des Katapultes und katapultiert\n"
  "so "+CAP(besetzer)+" zu Dir herauf!\n\n");		
ob->move(FR"ztu4", M_GO, "nach oben katapultiert", "wird", "kommt durch das Loch herauf geflogen");  
besetzt=0;
besetzer="";
}}



int chek()  {
	if(getuid(TP)==besetzer)  {
		besetzer="";
		besetzt=0;
write(BS(
"Du steigst vom Katapult herunter."));		
		}
		
 return TPM(FR"ztu2", M_GO, "durch das Loch nach unten", "springt",
"kommt von oben herabgesprungen");  }

int runter(string str)  {
	NF("Was willst Du verlassen?!\n");
if(str=="katapult")  {

	if(besetzt==0)  {
write(BS(
"Aber Du warst doch gar nicht auf dem Katapult!"));
 return 1; }

if(getuid(PL)!=besetzer)  {
	write(BS(
"Aber Du warst doch gar nicht auf dem Katapult!"));
return 1; }
else {
	write(BS(
"Du steigst vom Katapult herab!"));
besetzt=0;
besetzer="";
return 1; }
return 0; }
return 0; }
	

 			
 
 int besetze(string str)  {
 	NF("Worauf willst Du steigen?!\n");
 if(str=="auf katapult")  {
 	  if(besetzt!=0)  {
  write(BS(
  "Aber das Katapult ist schon von "+CAP(besetzer)+" besetzt!"));
   return 1; }

if(besetzer==getuid(PL))  {
	write(BS(
	"Du bist doch schon am Katapult!!!"));
	return 1; }
	
  
  if(besetzt==0)  {
  	besetzt=1;
  besetzer=getuid(PL);
  write(BS(
  "Du steigst auf das Katapult und machst Dich bereit!"));
  return 1; }
    return 0; }
     return 0; }
     	 	  		
 
 int up(string str)  {
 	object ob;
 	NF("Worauf willst Du springen?!\n");
 if(!str) return 0;
 
 if(present("runenmann", TO))  {
 	write(BS(
 "Der Runenmann haelt Dich fest!"));
   return 1; }	
 	
 if(sscanf(str, "%s nach oben", besetzer) )  {
 	
 if(besetzt==0)  {
 	write(BS(
 "Aber das Katapult ist nicht besetzt!"));
 return 1; }

  	
   		
 	
 ob=find_living(besetzer);

if(!ob)  {
	write(BS(
"Aber Spieler "+CAP(besetzer)+" ist nicht mehr da!\n"));
  return 1; }
  
    if(ob->id(getuid(PL)))  {
  	write(BS( 
  "Nana, wie soll das gehen?!"));
  return 1; }
  
  
  //eigentlich ueberfluessig
  if(!interactive(ob))  {
  	write(BS(
  "Aber "+CAP(besetzer)+" kannst Du nicht katapultieren!"));
  return 1; }
  	
  
if(!present(besetzer, environment(TP)))  {
	write(BS(
	"Aber "+CAP(besetzer)+" ist nicht hier!\n"));
return 1; }
	  	

else {
	write(BS(
"Du springst mit aller Gewalt auf das eine Ende des Katapultes und "
""+CAP(besetzer)+" wird durch das Loch in der Decke nach oben katapultiert!!!"));


 tell_object(ob,
   CAP_TPN+" springt mit aller Gewalt auf das andere Ende des Katapultes und\nDu "
   "wirst durch das Loch in der Decke nach oben katapultiert!!!\n");
ob->move(FR"ztu4", M_GO, "nach oben katapultiert", "wird", "kommt durch das Loch herauf geflogen");
besetzer="";
besetzt=0;	
	return 1; }
	


return 0; }
return 0; }


	
	BecomesNetDead(object pl)  {
	if(getuid(pl)==besetzer)  {
		besetzt=0;
		besetzer="";
	tell_object(pl,
"Du steigst vom Katapult herab!\n");			
}}
