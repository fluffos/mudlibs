//dante sl 99 98
//raum im zentralturm

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../burg.h"

int open=0;
#define PULL  (member(pull, getuid(this_player()))!=-1)
 string *pull=({});
int kraft=0;

create()
{
  ::create();

SetProp( P_INT_SHORT, "In einem Turm der Runenburg" );
  SetProp( P_INT_LONG, BS(
"der Runenburg."));

ASD("tor", "tor");
      
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20,ENV_TERRAIN:TT_HOUSE]) );

  AddSound( DEFAULT_SOUND,
    "Du hoerst Schreie von irgendwo her.");
AddSound(({"schrei","schreie"}),
"ALARM!!!");    
  AddSmell( DEFAULT_SMELL,
"Es riecht nach Kampf!");
    AddSmell("kampf",
"Keine Ahnung wie Kampf riecht...");



AE("unten", "./ztu4");
                                                                  
ACD(({"schiebe","schieb"}), "pull");




}

int pull(string str)  {
	NF(BS("Was willst Du schieben?!"));
if(str=="tor"||str=="tor auf")  {

if(open!=0)  {
	write(BS(
 "Aber das Tor ist doch schon aufgeschoben!"));
  return 1; }

  if(PULL)  {
  	write(BS(
  	"Aber Du schiebst doch schon!\n"));
  	return 1; }


if(!PULL) {
say(BS(
CAP_TPN+" beginnt das Tor aufzuschieben!"));	
	write(BS(
 "Du beginnst mit aller Kraft das Tor aufzuschieben!"));
  kraft++;
   pull += ({getuid(this_player())});   	  	
   call_out("check", 3, TP);
   return 1; }
  return 0; }
 return 0; }

 
 check()  {
 		 if(environment(TP)!=TO)  {
 write(BS(
 "Da Du den Raum verlassen hast, kannst Du kaum schieben!"));
 kraft--;
 pull -= ({getuid(this_player())}); 
  return ; }
 	
 	if(kraft>=2)  {
 write(BS(
 "WOW!!! Gemeinsam schafft ihr es das Tor aufzuschieben!"));
 kraft=0;
 AE("norden", "./ztu6");
 open=1;  
 pull -= ({getuid(this_player())});   return;	 }		

if(open!=0)  {
	return; }
	

else  {
	pull -= ({getuid(this_player())}); 
	kraft--; 	
  write(BS(
  "Du gibst auf, alleine schaffst Du das nie!"));
  say(BS(
  CAP_TPN+" gibt den Versuch das Tor aufzuschieben erfolglos auf!"));
}
}
	 	 
  reset() {
  	::reset();
  	if(open!=0)  {
  	RemoveExit("norden", "./ztu6");
  	open=0;
  	tell_room(FR"ztu5",
  	"Das Tor schliesst sich!\n");
} }

string tor()  {
	if(open==0)  {
write(BS(
"Das Tor fuehrt nach Norden. Es ist allerdings zugeschoben!!!"));}
if(open!=0)  {
	write(BS(
	"Das Tor fuehrt nach Norden! Es ist aufgeschoben!!!")); }
	return ""; }
			
  		 	