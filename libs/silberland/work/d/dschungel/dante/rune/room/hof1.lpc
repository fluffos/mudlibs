//raum fuer hof der runenmannburg

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "./hof_inh.lpc"

create()
{
  ::create();


hof_details();

  SetProp( P_INT_SHORT, "Im Hof der Runenburg" );
  SetProp( P_INT_LONG, BS(
  "Du stehst mitten im Hof der Runenburg. Dicke Mauern sollten Dein "
  "Eindringen eigentlich verhindern, trotzdem ist es Dir gelungen "
  "bis hier her vorzudringen. Ueberall im Hof stehen grosse, "
  "steineren Bloecke, die wohl Runen symbolisieren sollen. "
  "Der Boden besteht aus grauen Steinen, "
  "in die hunderte Runen eingemeiselt wurden. Im Sueden kannst Du den "
  "Hof durch ein Tor wieder verlassen."));



AD("sueden",
"Im Sueden liegt das rettende Tor.");

 
AddGuardedExit("norden", FR"hof2", "runenmann",
"Der Runenmann tritt Dich nieder.\n");

    
AddGuardedExit("westen", FR"hof3", "runenmann",
"Der Runenmann tritt Dich nieder.\n");


AddGuardedExit("osten", FR"hof5", "runenmann",
"Der Runenmann tritt Dich nieder.\n");

  

// AddItem(FN"vamp7", REFRESH_DESTRUCT);
// AddItem(FN"vamp7", REFRESH_DESTRUCT);

AD(({"steine","stein"}),
"Die Steine in der suedlichen Mauer sehen irgendwie einer Leiter "
"aehnlich.");
AD("leiter",
"Vielleicht kann man ja so ueber die Mauer klettern.");
                                                                    

 NewDoor("sueden", (FR"bruecke2"),
  ({"tor"}),
  
   ({
    D_FLAGS, DOOR_RESET_CL | DOOR_NEEDKEY | DOOR_CLOSED,
     D_LONG, "Das Tor besteht aus stabilen Holzbalken.",
               D_GENDER, NEUTER,
                D_SHORT, "Ein %ses Tor.",
                 D_NAME, "Tor",
                  } ));    

ACD(({"kletter","klettern"}), "up"); 
 }

int up(string str)  {
	NF("Worueber willst Du klettern?\n");
if(present("runenmann", TO))  {
	write(BS(
"Der Runenmann haelt Dich auf."));
return 1; }
if(str=="ueber mauer"||str=="auf mauer"||str=="ueber mauer drueber")  {
	write(BS(
"Du kletterst ueber die Mauer und springst dann auf die Bruecke "
"hinab!"));
TPM(FR"bruecke2", M_GO, "auf die Mauer und springt dann hinab",
"klettert", "kommt von der Mauer herabgesprungen");
return 1; }
return 0; }
			