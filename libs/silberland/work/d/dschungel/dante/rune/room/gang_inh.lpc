#include "../burg.h"


void gang_details()
{




AD("decke",
"Die Decke ist ist niederig und auch aus Stein.");
AD("stein",
"Der Stein ist grau und grob behauen.");
AD("boden",
"Der Boden besteht auch aus Stein und ist blank gefegt. Scheinbar "
"sind die Runenmaenner sehr sauber...");
AD(({"wand","waende"}),
"Die Waende sind aus Stein und mit Runen verziert. Sie sind "
"durchzogen von Spalten.");
AD(({"rune","runen"}),
"Leider sagen sie Dir nichts!");



AD(({"fackel","fackeln"}),
"Die Fackeln stecken in Spalten in der Wand und erzeugen ein difusses "
"Licht.");
AD("licht",
"Es ist hier nicht hell, aber man erkennt genug.");
AD(({"spalte","spalten"}),
"Die Waende sind ueberall durchzogen mit Spalten.");

AD(({"runenburg","burg"}),
"Du bist mitten drin.");
AD(({"runenmann","runenmaenner"}),
"Die Runenmaenner leben hier und sich sicher nicht "
"erfreut, dass Du hier bist.");



      
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20,ENV_TERRAIN:TT_HOUSE]) );



 
  AddSound( DEFAULT_SOUND,
    "Du hoerst Schreie von irgendwo her.");
AddSound(({"schrei","schreie"}),
"ALARM!!!");    
  AddSmell( DEFAULT_SMELL,
"Es riecht nach Kampf!");
    AddSmell("kampf",
"Keine Ahnung wie Kampf riecht...");
 } 