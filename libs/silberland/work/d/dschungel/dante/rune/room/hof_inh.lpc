//dante sl 99 98
//stdraum fuer den hof der burge

#include "../burg.h"


void hof_details()
{



      
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20,ENV_TERRAIN:TT_PLAIN]) );

AD("boden",
"Der steineren Boden ist voller Runen und teilweise sieht man "
"auch Blut.");
AD("blut",
"Es stammt sicher von einem Eindringling.");
AD("eindringling",
"So einer wie Du!");

 
AD(({"block","bloecke"}),
"Die Bloecke sehen sehr unterschiedlich aus. Sie symbolisieren "
"Runen, doch Du versteht davon ueberhaupt nichts.");
AD("decke",
"Hier ist der Himmel die Decke.");
AD("ahnung",
"Leider sagen Dir die Runen nichts.");
AD("holz",
"Es sind schwere, alte Balken.");
AD(({"balken","holzbalken"}),
"Die Holzbalken sind braeunlich und sicher sehr schwer.");

AD(({"rune","runen"}),
"Hier ist alles voller Runen, Doch Dir hilft das nichts.");


AD(({"wand","waende"}),
"Die Waende sind hier sie Mauern der Burg.");
AD("himmel",
"Der Himmel ist so weit oben, das man ihn kaum erkennt, da der "
"Hof recht dunkel ist.");


AD("eindringen",
"Jeder Eindringling wird sofort angegriffen!");

AD(({"mauer","mauern"}),
"Die Mauern sind viele Meter hoch, so das der Hof recht dunkel wirkt. "
"Sie bestehen aus sehr grossen Steinen, die sorgsam geschlichtet und "
"verputzt wurden.");
AD("meter",
"Fuenf oder sechs sicherlich.");
AD(({"steine","steinen"}),
"Die Steine sind grau und sehr schwer.");


AD("hof",
"Der Hof ist recht weitlaeufig, doch wirkt er durch die "
"hohen Mauern doch sehr beengend.");
AD(({"runenburg","burg"}),
"Du bist hier mitten in der Burg der Runenmaenner.");
AD(({"runenmann","runenmaenner"}),
"Sie ueben hier auf diesem Hof ihre Kunst.");
AD("kunst",
"Die Kunst mit Runen zu zaubern.");


 
  AddSound( DEFAULT_SOUND,
    "Du hoerst Schreie von irgendwo her.");
AddSound(({"schrei","schreie"}),
"ALARM!!!");    
  AddSmell( DEFAULT_SMELL,
"Es riecht nach Kampf!");
    AddSmell("kampf",
"Keine Ahnung wie Kampf riecht...");
 } 