//dante sl 99 98
//pfad
inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../burg.h"

int open=0;
string taeter="";
int wieoft=0;
int x=random(3)+3;
create()
{
  ::create();

SetProp( P_INT_SHORT, "Vor dem Wehrturm" );
  SetProp( P_INT_LONG, BS(
"Du marschierst auf einem schmalen, tief ausgetretenen Pfad. "
"Zu beiden Seiten stehen steinerne Bloecke, die scheinbar "
"Runen symbolisieren. Ab und zu sieht man auch kleine "
"Pflanzen am Rand des Pfades, doch die Bloecke dominieren bei weitem. "
"Im Norden sieht man eine maechtige Burg, die Burg der Runenmaenner, doch "
"zuvor musst Du wohl irgendwie den kleinen Wehrturm ueberwinden, der "
"den Zugang zur Bruecke versperrt."));


AD("wehrturm",
"Der Wehrturm ist eigentlich nur ein sehr stabiles Tor, durch "
"das man hindurch muss, wenn man die Bruecke zur Burg betreten will.");

ASD("tor", "tor");


AD("zugang",
"Er versperrt ihn!");
AD("bruecke",
"Die Bruecke liegt direkt hinter dem Wehrturm. Rechts und links von "
"ihr gaehnt ein tiefer Abgrund, der , so scheint es, mit Saeure "
"gefuellt ist!!!");
AD("abgrund",
"Er fuehrt direkt in einen tiefen Graben!");
AD("graben",
"Der Graben ist mit Saeure gefuellt.");
AD("saeure",
"Wer da hineinfaellt wird unbarmherzig aufgeloest!");



AD(({"pflanze","pflanzen"}),
"Die Pflanzen wachsen recht bescheiden am Rand des Pfades dahin.");
AD("boden",
"Der Boden besteht aus harter, zusammengetretener Erde.");
AD("erde",
"Sie ist schwarz und sehr hart.");
AD(({"block","bloecke"}),
"Die Bloecke sind quadratisch und sehr massiv. Sie symbolisieren Runen.");
AD(({"rune","runen"}),
"Sie haben sicher einen Sinn, doch der wird Dir nicht offenbar.");
AD("sinn",
"Den kennst Du nicht.");
AD("rand",
"Am Rand des Pfades stehen die Bloecke und manchmal auch kleine Pflanzen.");


AD("pfad",
"Der Pfad ist recht schmal und tief ausgetreten. Er schlaengelt sich "
"leicht zwischen den Bloecken dahin und fuehrt zur Burg der Runenmaenner.");
AD(({"seite","seiten"}),
"Rechts und links des Pfades hat man grosse, steinerne Bloecke aufgestellt, "
"die Runen symbolisieren. Sie erzeugen eine unheimliche Aura.");
AD("aura",
"Du fuehlst Dich beklemmt.");
AD("burg",
"Die Burg liegt im Norden von hier und ist ueber die Bruecke, die "
"hinter dem Wehrturm beginnt zu erreichen. Man erkennt ihre Mauern "
"und Tuerme.");
 

AD("norden",
"Im Norden erkennt man bereits die Burg der Runenmaener, doch davor "
"steht noch der kleine Wehrturm.");
AD(({"runenmann","runenmaenner"}),
"Die Runenmaenner haben diese Burg vor langer Zeit erobert. "
"Alle Einwohner bis auf einen haben sie umgebracht.");
AD("einwohner",
"Sie sind alle bis auf einen schon lange tot.");
AD("zeit",
"Die Burg besteht schon sehr, sehr lange.");
AD(({"mauer","mauern"}),
"Die Mauern scheinen sehr hoch und stabil zu sein. Es wird nicht "
"leicht die Burg zu stuermen.");
AD(({"tuerme","turm"}),
"Hell leuchten sie in der Sonne.");
AD("sonne",
"Die Sonne strahlt vom Himmel herab und taucht die Burg in ein "
"helles, gleissendes Licht.");
AD("licht",
"Hell.");
AD("himmel",
"Der Himmel ist blau und wolkenlos. Die Sonne strahlt herab.");





      
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20,ENV_TERRAIN:TT_PLAIN]) );

  AddSound( DEFAULT_SOUND,
    "Du hoerst Schreie von irgendwo her.");
AddSound(({"schrei","schreie"}),
"ALARM!!!");    
  AddSmell( DEFAULT_SMELL,
"Es riecht nach Kampf!");
    AddSmell("kampf",
"Keine Ahnung wie Kampf riecht...");

AE("sueden", "./pfad1");

//AddGuardedExit("norden", FR"bruecke1", "runenmann",
//"Der Runenmann tritt Dich nieder.\n");
                                                                  
ACD(({"ramme", "ramm"}), "tor_dam");
}

int tor_dam(string str)  {
	object ob;
NF("Was willst Du rammen?!\n");
if(str=="tor"||str=="tor ein")  {

	    if(open!=0)  {

write(BS(
"Aber "+CAP(taeter)+" hat das Tor schon eingerammt!"));
  return 1; }

 ob=deep_present("DANTE_RAMMBOCK", TP);
 
 if(!ob)  {
 	write(BS(
 "Du versuchst das Tor einzurammen, doch so schaffst Du es nie!"));
 say(BS(
 CAP_TPN+" versucht verzweifelt das Tor einzurammen."));  
 return 1; }
 
 else  {
 	
 if(wieoft==x)  {
 	
 	
 	write(BS(
 "Du rammst den Rammbock mit aller Gewalt ins Tor und WUMMMM!!!"
 " Das Tor gibt nach und bricht auf. Der Weg auf die Bruecke ist "
 "frei!!!"));
 say(BS(
 CAP_TPN+" rammt den Rammbock mit aller Gewalt gegen das Tor!!!"
 " WUMMM!!! Das Tor bricht auf, der Weg auf die Bruecke ist frei!!!"));
  wieoft=0;   
 open=1;
 tell_room(FR"bruecke1",
 CAP_TPN+" rammt von Sueden her das Tor ein!!!\n");
 taeter=getuid(TP);
 call_out("tor_kaputt", 0);		
 call_other(FR"bruecke1",  "s_weg",  taeter);	
 return 1; }
 
 if(wieoft<x)   {
 
 tell_room(FR"bruecke1",
 CAP_TPN+" versucht von Aussen das Tor einzurammen!\n");
 
 write(BS(
 "Du rammst den Rammbock mit aller Gewalt ins Tor und WUMMMM!!!"
 " Das Tor gibt ein Stueck nach!!!"));
 wieoft++;
 say(BS(
 CAP_TPN+" rammt den Rammbock mit aller Gewalt gegen das Tor!!!"
 " Das Tore gibt ein Stueck nach!"));
 return 1; }
 return 0; }
 return 0; }
 return 0; }
 
  	    		
	
tor_kaputt()  {
	AddGuardedExit("norden", FR"bruecke1", "runenmann",
	"Der Runenmann laesst Dich nicht auf die Bruecke!\n");
            }

	
	reset() {
		::reset();
		wieoft=0;
		open=0;
	RemoveExit("norden", FR"bruecke1");
	say(BS(
"Runenmaenner stuermen herein, reparieren das Tor und eilen davon!"));
call_other(FR"bruecke1", "weg_weg", taeter);
}
		



	

 tor()  {
	
	if(open==0)  {
return BS(
"Das Tor scheint sehr massiv zu sein. Es ist geschlossen!"); }

if(open!=0)  {
	return BS(
"Das Tor wurde von "+CAP(taeter)+" eingerammt und man kann "
"die Bruecke nach Norden betreten.");
}}

			 