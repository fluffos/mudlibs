int hol_rauf(string str)  {
	object ob;
	NF("Was willst Du runter rollen?!\n");
if(str=="stein nach unten")  {
ob=present("R_STEIN", TO);

if(!ob)  {
	write(BS(
"Aber da ist kein geeigneter Stein hier."));
 return 1; }
 else {
 	ob->remove();
 call_other(FR"ztu3", "ist_jem_da", TP);
 return 1; }
 return 0; }		
return 0; }

	

 			
 