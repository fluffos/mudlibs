//dante sl 99 98
//raum im zentralturm

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../burg.h"

int x;

create()
{
  ::create();

SetProp( P_INT_SHORT, "In einem Turm der Runenburg" );
  SetProp( P_INT_LONG, BS(
"der Runenburg."));


      
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20,ENV_TERRAIN:TT_HOUSE]) );

  AddSound( DEFAULT_SOUND,
    "Du hoerst Schreie von irgendwo her.");
AddSound(({"schrei","schreie"}),
"ALARM!!!");    
  AddSmell( DEFAULT_SMELL,
"Es riecht nach Kampf!");
    AddSmell("kampf",
"Keine Ahnung wie Kampf riecht...");



AE("unten", "./ztu3");
AE("oben", "./ztu5");
                                                                  
ACD(({"rolle","roll"}), "hol_rauf");
//absichtlich nicht das verb wirf werfen usw

for(x=1; x<=4+random(4); x=x+1) {
AIT(FO"rstein", REFRESH_DESTRUCT); }



}

