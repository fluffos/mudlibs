//dante sl 99 98
//bruecke1

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../burg.h"

int open=0;

create()
{
  ::create();

SetProp( P_INT_SHORT, "Auf der Bruecke zur Runenburg" );
  SetProp( P_INT_LONG, BS(
"Du stehst nun direkt auf der Bruecke zur Burg, direkt hinter "
"dem Wehrturm. "
"Die Bruecke besteht aus stabilen Holzbalken, die "
"ab und zu unheimlich knarren. Zu beiden Seiten geht es tief nach unten "
"in den Saeuregraben. Wer von der Bruecke hinabstuerzt ist "
"unwiderruflich verloren. Im Norden sieht Du die maechtigen Mauern "
"der Runenburg."));


AD("wehrturm",
"Der Wehrturm und sein Tor liegen im Sueden. Dir faellt eine "
"Leiter am Wehrturm auf.");
AD("leiter",
"Mit dieser Leiter kann man ueber den Wehrturm nach aussen klettern.");

AD("sueden",
"Da ist das Tor des Wehrturmes!");

AD(({"burg","runenburg"}),
"Die Burg der Runenmaenner liegt direkt vor Dir. Ihre Mauern sehen "
"von hier sehr gewaltig aus.");
AD(({"mauer","mauern"}),
"Die Mauern sind sicher an die 6 Meter hoch.");
AD("meter",
"Geschaetzt...");


AD("norden",
"Da ist die Runenburg.");
AD(({"runenmann", "runenmaenner"}),
"Hier leben und ueben sie!");
AD("boden",
"Der Boden besteht aus den Holzbalken.");
AD("himmel",
"Hoch ober Dir siehst Du die Tuerme der Burg!");
AD(({"tuerme", "turm"}),
"Die Tuerme leuchten hell in der Sonne.");
AD("sonne",
"Die Sonne beleuchtet die Tuerme der Burg.");

AD(({"seite","seiten"}),
"Zu beiden Seiten der Bruecke ist ein tiefer Graben.");
AD(({"saeuregraben","graben"}),
"Der Graben ist mit Saeure gefuellt.");
AD("saeure",
"Welche Saeure es ist, weisst Du nicht, aber sie ist sicher "
"sehr gefaehrlich.");


AD("bruecke",
"Die Bruecke besteht aus sehr dicken Holzbalken. Sie ist nicht "
"allzu breit, also sei vorsichtig!");
AD(({"balken", "holzbalken"}),
"Die Balken bestehen aus einem schwarzen Holz.");
AD("holz",
"Das Holz ist uralt, trotzdem stabil.");



ASD("tor", "tor");
      
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20,ENV_TERRAIN:TT_PLAIN]) );

  AddSound( DEFAULT_SOUND,
    "Du hoerst Schreie von irgendwo her.");
AddSound(({"schrei","schreie"}),
"ALARM!!!");    
  AddSmell( DEFAULT_SMELL,
"Es riecht nach Kampf!");
    AddSmell("kampf",
"Keine Ahnung wie Kampf riecht...");



AddGuardedExit("norden", FR"bruecke2", "runenmann",
"Der Runenmann tritt Dich nieder.\n");
                                                                  
ACD(({"kletter","klettern"}), "up"); 
}
 s_weg(string taeter)  {
 AE("sueden", "./pfad2");
 open=1;
   }
 
int up(string str)  {
	NF("Worueber willst Du klettern?\n");
if(present("runenmann", TO))  {
	write(BS(
"Der Runenmann haelt Dich auf."));
return 1; }
if(str=="ueber wehrturm"||str=="auf leiter"||str=="ueber wehrturm mit leiter")  {
	write(BS(
"Du kletterst mit der Leiter auf den Wehrturm und springst dann hinab!"));

TPM(FR"pfad2", M_GO, "auf den Wehrturm und springt dann hinab",
"klettert", "kommt vom Wehrturm herabgesprungen");
return 1; }
return 0; }
	
 weg_weg()  {
 	open=0;
 	RemoveExit("sueden", "./pfad2");
 	tell_room(FR"bruecke1",
 "Runenmaenner stuermen vorbei nach Sueden und reparieren das Tor.\n");
}

	

 tor()  {
	
	if(open==0)  {
return BS(
"Das Tor scheint sehr massiv zu sein. Es ist geschlossen!"); }

if(open!=0)  {
	return BS(
"Das Tor wurde eingerammt und man kann "
"die Bruecke nach Sueden verlassen.");
}}

		