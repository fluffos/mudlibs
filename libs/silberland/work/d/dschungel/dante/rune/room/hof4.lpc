//raum fuer hof der runenmannburg

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "./hof_inh.lpc"


int open=0;

create()
{
  ::create();


hof_details();

  SetProp( P_INT_SHORT, "Im Hof der Runenburg" );
  SetProp( P_INT_LONG, BS(
  "Du stehst mitten im Hof der Runenburg. Dicke Mauern sollten Dein "
  "Eindringen eigentlich verhindern, trotzdem ist es Dir gelungen "
  "bis hier her vorzudringen. Ueberall im Hof stehen grosse, "
  "steineren Bloecke, die wohl Runen symbolisieren sollen. "
  "Der Boden besteht aus grauen Steinen, "
  "in die hunderte Runen eingemeiselt wurden. Im Norden fuehrt "
  "ein Tor in den Haupttrakt der Burg."));


ASD("tor", "tor");

AD("norden",
"Da liegt ein Tor.");
AD(({"trakt", "haupttrakt"}),
"Der Haupttrakt der Burg liegt im Norden.");


 

AE("sueden", "./hof3");

    
ASE("osten", "nix");
  

// AddItem(FN"vamp7", REFRESH_DESTRUCT);
// AddItem(FN"vamp7", REFRESH_DESTRUCT);

                         AD("blut",
   "Mitten im Blut entdeckst Du ein Seil!");
   AD("seil",
   "Hmm, daran kann man ziehen.");
                                              

 ACD(({"zieh","ziehe"}), "pull");
 }
	
	
reset()  {
	::reset();
	if(open!=0)  {  call_out("weg_weg", 0); }}



int pull(string str)  {
	NF("Was willst Du ziehen?!\n");
if(str=="seil"||str=="am seil")  {
	
	if(present("runenmann", TO)) {
write(BS(
"Der Runenmann haelt Dich auf."));
return 1; }

	write(BS(
"Du ziehst am Seil und hoerst ein lautes Geraeusch aus dem Osten."));
call_other(FR"hof6", "weg_da");
 return 1; }
 
 return 0; }
 					
		
	
	
weg_da()  {
	open=1;
	AE("norden", "./gw1");  
tell_room(FR"hof4",
"Das Tor scheint sich zu bewegen.\n");

  }

weg_weg()  {
	open=0;
	RemoveExit("norden", "./gw1");
	tell_room(FR"hof4",
"Das Tor geht zu.\n");  }		
	
	
nix()  {
	NF(BS("Du wirst durch einen grossen Block aufgehalten. Hier "
	"kommt man nicht durch."));
	 }
	

 tor()  {
	
	if(open==0)  {
return BS(
"Das Tor ist geschlossen!"); }

if(open!=0)  {
	return BS(
"Das Tor ist geoeffnet.");
}}

	