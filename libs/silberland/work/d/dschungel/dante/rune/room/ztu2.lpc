//dante sl 99 98
//raum im zentralturm

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../burg.h"


create()
{
  ::create();

SetProp( P_INT_SHORT, "In einem Turm der Runenburg" );
  SetProp( P_INT_LONG, BS(
"der Runenburg."));


      
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20,ENV_TERRAIN:TT_HOUSE]) );

  AddSound( DEFAULT_SOUND,
    "Du hoerst Schreie von irgendwo her.");
AddSound(({"schrei","schreie"}),
"ALARM!!!");    
  AddSmell( DEFAULT_SMELL,
"Es riecht nach Kampf!");
    AddSmell("kampf",
"Keine Ahnung wie Kampf riecht...");



AE("unten", "./ztu1");
AE("oben", "./ztu3");                                                                  
ACD(({"ziehe","zieh"}), "up"); 
}
 
 int up(string str)  {
 	object ob;
 	string zug;
 	NF("Wen willst Du nach oben ziehen?!\n");
 if(!str) return 0;
 
 if(present("runenmann", TO))  {
 	write(BS(
 "Der Runenmann haelt Dich fest!"));
   return 1; }	
 	
 if(sscanf(str, "%s nach oben", zug) )  {
 	
 ob=find_living(zug);

if(!ob)  {
	write(BS(
"Aber Spieler "+CAP(zug)+" ist nicht mehr dort!\n"));
  return 1; }
  
  if(!interactive(ob))  {
  	write(BS(
  "Aber "+CAP(zug)+" kannst Du nicht hochziehen!"));
  return 1; }
  	
  
  	
if(file_name(environment(ob))!=(FR"ztu1"))  {
	write(BS(
	"Aber "+CAP(zug)+" ist nicht direkt unter Dir!\n"));
  return 1; }

else {
	write(BS(
"Du greifst mit den Armen durch das Loch nach unten "
   "und ziehst "+CAP(zug)+" nach oben zu Dir!\n"));
 tell_object(ob,
   CAP_TPN+" greift mit den Armen herab und zieht Dich nach oben.\n");
ob->move(FR"ztu2", M_GO, "nach oben gezogen", "wird", "kommt durch das Loch herauf");
	return 1; }


return 0; }
return 0; }


	