//dante sl 99 98
//raum im zentralturm

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../burg.h"


create()
{
  ::create();

SetProp( P_INT_SHORT, "In einem Turm der Runenburg" );
  SetProp( P_INT_LONG, BS(
"Du stehst nun direkt auf der Bruecke zur Burg, direkt hinter "
"dem Wehrturm. "
"Die Bruecke besteht aus stabilen Holzbalken, die "
"ab und zu unheimlich knarren. Zu beiden Seiten geht es tief nach unten "
"in den Saeuregraben. Wer von der Bruecke hinabstuerzt ist "
"unwiderruflich verloren. Im Norden sieht Du die maechtigen Mauern "
"der Runenburg."));


      
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20,ENV_TERRAIN:TT_HOUSE]) );

  AddSound( DEFAULT_SOUND,
    "Du hoerst Schreie von irgendwo her.");
AddSound(({"schrei","schreie"}),
"ALARM!!!");    
  AddSmell( DEFAULT_SMELL,
"Es riecht nach Kampf!");
    AddSmell("kampf",
"Keine Ahnung wie Kampf riecht...");



AE("unten", "./zt0");
ASE("oben", "nix");
                                                                  
ACD(({"steig","steige"}), "up"); 
}

 nix()  {
 	NF(BS("Du versuchst zu dem Loch in der Decke zu gelange, aber "
 	"so schaffst Du es sicher nicht. Vielleicht bist Du alleine "
 	"ja zu klein..."));
 }
 	
 int up(string str)  {
 	object ob;
 	string leiter;
 	NF("Worauf willst Du nach oben steigen?!\n");
 if(!str) return 0;
 
 if(present("runenmann", TO))  {
 	write(BS(
 "Der Runenmann haelt Dich fest!"));
   return 1; }	
 	
 if(sscanf(str, "auf %s nach oben", leiter) )  {
 	ob=present(leiter, TO);
 	if(!ob)  {
 write(BS(
 "Aber "+CAP(leiter)+" ist nicht hier."));
   return 1; }
   
  if(ob->id(getuid(PL)))  {
  	write(BS( 
  "Nana, wie soll das gehen?!"));
  return 1; }
  	
   
   if(!interactive(ob))  {
   	write(BS(
   "Aber "+CAP(leiter)+" ist nicht dazu geeignet."));
   return 1; }
   else  {

write(BS(
"Du steigst auf die Schultern von "+CAP(leiter)+" und ziehst Dich "
"dann durch das Loch nach oben!"));
tell_object(ob,
CAP_TPN+" steigt auf Deine Schultern und zieht sich dann durch das "
"Loch nach oben.\n");
TPM(FR"ztu2", M_GO, "nach oben" , "steigt", "steigt von unten herauf");


   	return 1; }
   return 0; }
  return 0; }
   
   
   
   
 
		 	
   					