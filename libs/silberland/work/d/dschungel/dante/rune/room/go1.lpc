//raum fuer den gang der runenburg

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "./gang_inh.lpc"

int open=0;

create()
{
  ::create();


gang_details();



SP(P_INT_SHORT, "In der Runenburg");
SP(P_INT_LONG, BS(
"Ein dunkler Gang scheint tiefer in die Burg der Runenmaenner zu fuehren. "
"Fackeln erleuchten die Waende, die ueber und ueber mit Runen verziert sind. "
"Die Decke ist recht niedrig und scheint Dich fast zu erdruecken. "
"Der Boden besteht aus hartem Stein. Im Sueden kommst Du durch das "
"Tor wieder zurueck in den Hof der Burg."));


AD("decke",
"Die decke ist sehr niedrig. Du siehst einen Hebel.");
AD("hebel", 
"Was kann man mit dem wohl machen!");


AD("sueden",
"Im Sueden liegt das Tor, durch das Du gekommen bist.");
AD("hof",
"Der Hof liegt im Sueden, hinter dem Tor.");

AddGuardedExit("norden", FR"go2", "runenmann",
"Der Runenmann tritt Dich nieder.\n");
 AD("tor", 
 "Das Tor ist offen, oder doch zu. Irgendetwas ist da faul!!!");
 
 ACD(({"zieh","ziehe"}), "pull");
 ASE("sueden", "gag");
 }



gag()  {
	NF(BS("Du willst nach Sueden, doch eine magische Barriere haelt Dich auf!"));
}


	

int pull(string str)  {
	NF("Was willst Du ziehen?!\n");
if(str=="hebel"||str=="am hebel")  {
	
	if(present("runenmann", TO)) {
write(BS(
"Der Runenmann haelt Dich auf."));
return 1; }

	write(BS(
"Du ziehst am Hebel und ploetzlich saugt Dich eine unheimliche "
"Kraft durch die Barriere in den Hof!"));
TPM(FR"hof6", M_GO, "ploetzlich von hier", "verschwindet",
"erscheint ploetzlich vor Dir");
return 1; }
return 0; }
	
	

