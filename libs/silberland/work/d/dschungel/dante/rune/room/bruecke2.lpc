//dante sl 99 98
//stdraum fuer den hof der burge

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../burg.h"
int da=1;
reset()  {
	::reset();
	da=1; }
	
create()
{
  ::create();

SetProp( P_INT_SHORT, "Auf der Bruecke zur Runenburg" );
  SetProp( P_INT_LONG, BS(
"Die Bruecke zur Runenburg besteht aus stabilen Holzbalken, die "
"ab und zu unheimlich knarren. Zu beiden Seiten geht es tief nach unten "
"in den Saeuregraben. Wer von der Bruecke hinabstuerzt ist "
"unwiderruflich verloren. Im Norden sieht Du die maechtigen Mauern "
"der Runenburg. Ein grosses Tor fuehrt hinein."));



AD("wehrturm",
"Der Wehrturm liegt im Sueden.");

AD("sueden",
"Da ist der Wehrturm!");

AD(({"burg","runenburg"}),
"Die Burg der Runenmaenner liegt direkt vor Dir. Ihre Mauern sehen "
"von hier sehr gewaltig aus.");
AD(({"mauer","mauern"}),
"Die Mauern sind sicher an die 6 Meter hoch. Dir faellt ein Haken "
"in der Mauer auf.");
AD("haken",
"Hmm, was koennte man mit dem Haken machen?!");
AD("meter",
"Geschaetzt...");


AD("norden",
"Da ist die Runenburg. Direkt vor Dir!");
AD(({"runenmann", "runenmaenner"}),
"Hier leben und ueben sie!");
AD("boden",
"Der Boden besteht aus den Holzbalken.");
AD("himmel",
"Hoch ober Dir siehst Du die Tuerme der Burg!");
AD(({"tuerme", "turm"}),
"Die Tuerme leuchten hell in der Sonne.");
AD("sonne",
"Die Sonne beleuchtet die Tuerme der Burg.");

AD(({"seite","seiten"}),
"Zu beiden Seiten der Bruecke ist ein tiefer Graben.");
AD(({"saeuregraben","graben"}),
"Der Graben ist mit Saeure gefuellt.");
AD("saeure",
"Welche Saeure es ist, weisst Du nicht, aber sie ist sicher "
"sehr gefaehrlich.");


AD("bruecke",
"Die Bruecke besteht aus sehr dicken Holzbalken. Sie ist nicht "
"allzu breit, also sei vorsichtig!");
AD(({"balken", "holzbalken"}),
"Die Balken bestehen aus einem schwarzen Holz.");
AD("holz",
"Das Holz ist uralt, trotzdem stabil.");



      
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20,ENV_TERRAIN:TT_PLAIN]) );

  AddSound( DEFAULT_SOUND,
    "Du hoerst Schreie von irgendwo her.");
AddSound(({"schrei","schreie"}),
"ALARM!!!");    
  AddSmell( DEFAULT_SMELL,
"Es riecht nach Kampf!");
    AddSmell("kampf",
"Keine Ahnung wie Kampf riecht...");

AE("sueden", "./bruecke1");
 

                                                                  

 NewDoor("norden", (FR"hof1"),
  ({"tor"}),
  
   ({
    D_FLAGS, DOOR_RESET_CL | DOOR_NEEDKEY | DOOR_CLOSED,
     D_LONG, "Das Tor besteht aus stabilen Holzbalken.",
               D_GENDER, NEUTER,
                D_SHORT, "Ein %ses Tor.",
                 D_NAME, "Tor",
                 //D_TESTFUNC, "check",
                  } ));    

ACD(({"zieh","ziehe"}), "get_key");
}

int get_key(string str)  {
	object ob;
if(str=="haken")  {
if(present("runenmann", TO))  {
	write(BS(
"Der Runenmann schlaegt Dich!"));
TP->do_damage(5);
return 1; }
		
	
	if(!da)  {
write(BS(
"Du ziehst am Haken, doch nichts passiert."));
say(BS(
CAP_TPN+" macht sich an einer Mauer zu schaffen."));
return 1; }
if(da)  {
say(BS(
CAP_TPN+" macht sich an einer Mauer zu schaffen."));				 		
write(BS(
"Du ziehst am Haken und ploetzlich haeltst Du den ganzen Haken "
"in der Hand. Hmm, scheinbar war der Haken ein Schluessel!"));
da--;
ob=CLONEOB(FO"rkey1");
ob->move(TP, M_GET);
return 1; }
return 0; }
return 0; }
