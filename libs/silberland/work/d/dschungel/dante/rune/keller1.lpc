
inherit "std/room";

#include <properties.h>
#include <language.h>
#include "/players/dante/myowndefine.h"
create()
{
	::create();

SetProp( P_INT_SHORT, "Ein Kellerraum" );
	SetProp( P_INT_LONG,
break_string("Dies ist der erste Raum des riesigen Kellers. "
+"Die Waerme, die Dir entgegenstrahlt, wird immer staerker."
+" Du fragst Dich, was die Ursache fuer diese Hitze sein mag."
+" Im Sueden siehst Du eine kleine Tuer, durch die ein Lichtstrahl zu kommen scheint. "
+"An den Waenden siehst Du verstaubte Bilder. In einer Ecke siehst Du"
+" Geruempel liegen. Vielleicht findest Du ja etwas Brauchbares.", 78));
	SetProp( P_LIGHT, 1 );
	SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 35,ENV_TERRAIN:TT_CAVE]) );      
AddDetail( ({ "hitze", "waerme" }), break_string(
" Die Waerme, die Dir entgegenschlaegt, scheint aus dem Raum hinter der kleinen"
+" Tuer zu kommen.", 78));
AddDetail( ({ "staub", "staubschicht"}), break_string(
"Es sieht so aus, als ob hier schon seit ewigen Zeiten niemand Staub"
+" gewischt haette. Als Du den Staub entfernst, kannst Du endlich mal die"
+" Bilder betrachten.", 78));
AddDetail( ({"bild", "bilder"}), break_string(
"Dies sind die Bilder der beruehmten Druiden des Druidenrates."
+" Eines Tages wird auch das Bild von Alanon hier haengen."
+" Du siehst das Bild von Brimen, dem einstigen Oberhaupt des Druidenrates."
+" Ausserdem war er der Vater von Alanon. Wann immer Alanon seinen Rat "
+"braucht, kann er ihn am Finsterweiher rufen, da dort sein Geist fuer "
+"die Nachwelt gebannt wurde.", 78));
AddDetail( ({"strahl", "lichtstrahl"}), break_string("Dieser Lichtstrahl kommt aus dem Raum"
+" hinter der kleinen Tuer.", 78));
AddDetail( ({"brimen", "bild von brimen"}), break_string(
"Dies ist Alanons Vater. Er fuehrte den Druidenrat zu voller Bluete"
+" und brachte den vier Rassen nach den grossen Kriegen den Frieden."
+" Er war der unumstrittene Fuehrer der Druiden und ihr weises Oberhaupt."
+ " Bis, ja bis der abtruennige Druide Brona die Druiden an die "
+"Maechte der Finsternis verriet und somit alle Druiden (bis auf einen )"
+" mit Hilfe seiner Anhaenger, den Gnomem und Schaedeltraegern"
+", toetete. Er verbannte den Geist Brimens in den Finsterweiher, wo er "
+"wohl nie zur Ruhe kommen wird.", 78));

AddDetail ( ({"boden", "grund"}), break_string(
"Der Boden ist mit allerlei Geruempel bedeckt.", 78));

AddDetail ( ({"wand", "waende"}), break_string(
"Die Waende sind fein und glatt geschliffen und strahlen eine "
+"gewisse innere Waerme aus, die Du aber nicht genau"
+" erklaeren kannst.", 78));
AddDetail( ({"rassen", "4 rassen","vier rassen"}), break_string(" Die vier Rassen"
+" bestehen aus Zwergen, Menschen, Elfen und den Trollen.", 78));
AddDetail( ({"trolle", "troll"}), break_string("Die Trolle sind die"
+" groessten Lebewesen, die momentan die heute bekannte Welt belagern."
+" Sie leben in einzelnen Staemmen, weit versteut im Kahaarg-Gebirge.", 78));
AddDetail( ("geruempel"), break_string("Leider sind die Dinge, die "
+"Du hier entdeckst so alt und verrostet, dass Du nichts davon"
+" gebrauchen kannst.", 78));
AddDetail( ({"elfen", "elf"}), break_string(
"Die Elfen leben in der Waldelfensiedlung"
+" in den Baeumen. Sie sind ein sehr stilles Volk, welches sich in der "
+"Heilkunde besonders gut auskennt.", 78));
AddDetail( ({"zwerge", "zwerg"}), break_string("Die Zwerge leben in der Zwergenstadt"
+", die sich westlich des Gebirges. Sie sind ein zaehes Volk, welches"
+" sich aber hervorragend in der Schmiedekunst auskennt.", 78));
AddDetail( ({"menschen", "mensch"}), break_string("Die Menschen sind "
+" die groesste und widerstandsfaehigste Rasse auf der nun bekannten Welt"
+" und haben sogar mit einem unwahrscheinlichen Glueck die 'grossen Kriege' "
+"in kleiner Zahl ueberlebt.", 78));
	AddDetail( "tuer" ,
		"Sie steht seit Jahren offen und ist in dieser Lage\n"
	+	"hoffnungslos festgerostet.\n"
	);

	AddCmd( ({ "schliesse", "oeffne", "bewege",
		"schliess", "beweg" }), "beweg_etwas" );
AddExit ( "oben","./halle" );
AddExit ( "unten","./keller2" );
}

beweg_etwas( str )
{
	notify_fail( "Was willst Du denn bewegen ?" );
	if( str == "tuer" )
	{
		write( "Die Tuer ist hoffnungslos festgerostet.\n" );
		return 1;
	}
}
