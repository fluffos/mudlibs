//eingangshalle zu den runenmaennern

#include <properties.h>
#include "/players/dante/myowndefine.h"

inherit "std/room";
create()
{
::create();
  SetProp ( P_LIGHT, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25,ENV_TERRAIN:TT_CAVE]) );      
SetProp ( P_INT_SHORT, "Die Halle");
SetProp ( P_INT_LONG, break_string ("Dies ist die grosse Halle der Runneburg."
+" Sie ist ueberaus eindrucksvoll, ein riesiger hoher Raum, die Waende ganz aus "
+"Holz, poliert, bis sie im gemischten gelben Licht lodernder Fackeln und "
+"dem roetlichen Schimmer des durch hohe, schraege Fenster hereindringenden Lichts"
+" prachtvoll glaenzt. Die Taefelung ist geschmueckt mit Gemaelden, mit"
+" gemeisselten und geschnitzten Figuren aus Stein und Holz auf Mosaikpodesten"
+", mit langen, handgewebten Gobelins, die in Falten auf den schimmernden "
+"Marmorboden herabhaengen. In verschiedenen Abstaenden gibt es grosse Statuen"
+" aus Stein, Skulpturen aus einem anderen Zeitalter, ueber die langen "
+"Jahrhunderte hinweg in dieser zeitlosen Heimstatt bewahrt. Die Statuen scheinen"
+" die schweren, geschnitzten Holztueren zu bewachen, die auf herrliche Weise"
+" mit Klinken aus kupferfarbenem Messing geschmueckt sind."));
AddDetail ( ({ "halle", "raum" }), break_string(
"Du stehst inmitten dieser herrlichen Halle, die vor Jahrhunderten erbaut worden"
+" ist.", 78));
AddDetail ( ({ "waende", "wand", "holz" }), break_string(
"Die Waende sind aus feinstem Holz. Es scheint ein Eschenholz zu sein, welches"
+" im Laufe der Jahrhunderte bereits sehr stark abgedunkelt ist.", 78));
AddDetail ( ({"licht", "fackeln", "fackel"}), break_string(
"Das Licht der Fackeln taucht den Raum in eine mystische und himmlische Aura."
+"  .", 78));
AddDetail ( ("decke"), break_string(
"Die Decke befindet sich wie ueblich ueber Dir. An ihr befestigt, siehst Du "
+"einen riesigen Kronleuchter, welcher mit schaetzungsweise 300 Kerzen "
+"bestueckt ist.", 78));
AddDetail ( ({"leuchter", "kronleuchter"}), break_string(
"Der Kronleuchter haengt an der Decke. Das Licht, welches die Kerzen "
+"dem Raum zufuehren unterstuetzt die mystische Aura des Fackellichtes.", 78));
AddDetail( ({"kerze", "kerzen"}), break_string(
"Die Kerzen sind rund um den Kronleuchter angeordnet. Sie erleuchten den"
+" Raum nicht komplett, sondern tauchen ihn nur in eine himmlische Aura.", 78));
AddDetail( ({"aura", "mystik", "himmlische Aura", "mystische aura"}), break_string(
"Die Aura geht von dem Licht und Schattenspiel der Fackeln und Kerzen aus."
+" Zusaetzlich wird dieser Effekt von dem Lichteinfall der Fenster unterstuetzt.", 78));
AddDetail ( ({ "fenster", "schraege fenster" }), break_string(
"Die Fenster sind gross und torbogenfoermig. Sie lassen trotz ihrer Groesse"
+" nicht genug Licht hindurch, um den Raum ausreichend zu erhellen. Aus diesem "
+"Grunde sind ueberall in dieser Halle Fackeln angeordnet.", 78));
AddDetail ( ({"falte", "falten"}), break_string(
"Die Gobelins schlagen leichte Falten, die wellenfoermig ueber den "
+"Boden zu fliessen scheinen. In den Falten koennte was versteckt sein."
+" Bei einer genaueren Untersuchung kannst Du aber leider nichts erkennen."
+" Halt. Was ist das ?? Du siehst in einer kleinen Falte ein Flaeschchen "
+"haengen.", 78));
AddDetail ( ({"flasche", "flaeschchen"}), break_string(
"Verdammt, das Flaeschchen ist unwahrscheinlich fest verschlossen."
+" Es scheint sehr alt zu sein, denn der versiegelte Korken hat sich"
+", so wie es aussieht, in den Flaschenhals hineingefressen. Als Du mit Gewalt"
+" versuchst, die Flasche zu oeffnen, faellt sie Dir aus der Hand. "
+"Tja, Du hast leider den guten Zaubertrank verschuettet.", 78));
AddDetail ( ({ "marmor", "fussboden", "boden" }), break_string(
"Der Marmor scheint auf dem ersten Blick matt und stumpf zu sein."
+" Als Du aber genauer hinsiehst, erkennst Du ein inneres Leuchten, "
+"welches direkt aus dem Gestein herauszudringen scheint.", 78));
AddDetail ( ("leuchten"), break_string(
"Das Leuchten, dass Du beim genaueren Hinsehen entdeckst, scheint"
+" keine definierte und fixe Quelle zu haben. Du fragst Dich, "
+"ob irgendetwas in dieser Burg nichts mit Magie zu tun hat.", 78));

AddDetail ( ("taefelung"), break_string(
"Die Taefelung aus reinstem Eichenholz, geschmueckt mit verschiedenen"
+" Gemaelden aus dem Zeitalter der 'alten' und 'neuen' Welt.", 78 ));
 AddDetail ( ({ "gemaelde", "bilder" }), break_string(
"Die Bilder dienen als geschichtliche Erinnerung an die alten Zeiten"
+" und sollen der Nachwelt eine Warnung sein, nicht dieselben Fehler"
+" zu begehen, wie ihre Vorgaenger.", 78 ));
AddDetail ( ({ "figuren", "figuren aus stein", "figuren aus holz", "holzfiguren", "steinfiguren" }), break_string(
"Die Figuren zeigen die Antlitze vieler grosser Regenten und Koenige der alten"
+" und neuen Rassen, die die Welt einstmals und heute beherrscht haben.", 78));
AddDetail ( ({"gobelins", "teppiche" }), break_string(
"Die Gobelins sind wie auch der Rest der Einrichtung (abgesehen von den neueren"
+" Figuren) sehr alt. Trotz des Alters sind ihre Farben noch sehr klar und"
+" sauber.", 78));
AddDetail ( ({"farben","alter"}), break_string(
"Die Gobelins leuchten in kraeftigen Farben und scheinen wohl auch mehrere hundert"
+" Jahre alt zu sein.", 78));
AddDetail ( ({"podest", "mosaikpodest", "mosaik","podeste","mosaikpodeste"}), break_string(
"Die Mosaikpodeste sind herrlich anzusehen. Sie besitzen eine vollkommene "
+"geometrische Form und scheinen mit der Halle verwachsen zu sein.", 78));
AddDetail ( ({"statue", "statuen"}), break_string(
"Die Statuen sollen wohl der Abschreckung von Feinden dienen."
+" Es koennte aber auch sein, dass sie einfach der Zierde wegen aufgestellt"
+" wurden.", 78));
AddDetail ( ({"skulpturen","skulptur"}), break_string(
"Die Skulpturen zeigen Dir, dass Du entweder keine Ahnung von Kunst hast, "
+"oder dass diese Dinger wirklich haesslich sind.", 78));
AddDetail ( ({"tueren", "tuer", "holztuer", "holztueren"}), break_string(
"Die Tueren sind, ebenso wie die Taefelung aus einem festen Eichenholz geschnitzt."
+" Sie sind unwahrscheinlich dick und aeusserst robust.", 78));
AddDetail ( ({"klinken", "klinke", "messing"}), break_string(
"Die Klinken der Tueren sind aus dem wohl gebraeuchlistem Metall fuer Tuerklinken,"
+" naemlich Messing.", 78));
AddExit ("oben","./treppengang" );
AddExit ( "unten","./keller1" );
}
