//master fuer runenmaenner



  object *mann;

  create()
  {
    if (is_clone(this_object())) return 0;
    mann = ({});
  }

  add_mann()
    {
    mann += ({ previous_object() });
    }

  ruf_um_hilfe(object spieler)
    {
    int u;
    object *w;
    w=mann;
    for (u=sizeof(w)-1;u>=0;u--)
      if (catch(w[u]->InsertEnemy(spieler)))
        mann -= ({ w[u] });
    }

  remove_mann()
    {
    mann -= ({ previous_object() });
    }
    
//ende hoffe es geht
