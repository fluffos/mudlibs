/* 

der taetowierer in tijara, dante sl 2001
gibt auskunft und taetowiert...

*/
 
inherit "std/npc";
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <actions.h>
#include <new_skills.h>
#include "/players/dante/myowndefine.h"
#include <ansi.h>
#define SAVEFILE "/d/dschungel/dante/tijaraneu/log/joesave"

nosave object cash;
nosave int preis;
nosave int motiv;
nosave string farbe;
nosave string region;
nosave int i;
sags_auf_kanal(nosave object wer,nosave string region,nosave string color);
nosave string text;
 
string opfer_liste();

string *opfer;

nosave int rand=100+random(50);

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();
  
  
restore_object(SAVEFILE);

if(!restore_object(SAVEFILE) )  {

opfer=({});

}
  SetProp(P_SHORT, "Kopfgeldjaeger Joe");
  SetProp(P_LONG, BS(
"Das ist der Kannibale Kopfgeldjaeger Joe. Frueher war er ein echter Kannibale, "
"doch das dauernde Zwergenleber, Elfendarm, Hobbitaugen und Menschenmilz fressen "
"wurde ihm auf die Dauer zu langweilig. Spaeter wurde er Kopfgeldjaeger und "
"erschlug gefaehrliche Spieler im Auftrag von Dante. Nun aber ist er friedlich "
"und hat sich ganz aufs Taetowieren verlegt, worin er eine echter Meister wurde. "
"Angeblich sind seine Methoden jedoch aeusserst brutal. Er ist gross, sehnig und "
"sehr muskuloes. Seine alte, braungebrannte, ledrige Haut, ist ueber und ueber "
"mit Taetowierungen bedeckt. Es sind soviele, dass man die echte, originale "
"Haut kaum mehr erkennen kann. "
"An seinem Guertel haengen einige Koepfe. Er spricht nicht gerne, "
"aber dafuer gibt es ja viele Tafeln und Schilder hier."));

AD(({"haut","taetowierung","taetowierungen"}),
"Joe, ist eine grosse, lebende Taetowierung. Du zaehlst schnell und kommst "
"auf "+rand+" Taetowierungen...");

AD("guertel",
"Da haengen einige Koepfe seiner Opfer!");
AD(({"opfer","koepfe","kopf"}), #'opfer_liste);



    
  SP(P_RACE, "Mensch");
  SetProp(P_NAME, ({
  	"Ex-Kopfgeldjaeger Joe",
  	"Ex-Kopfgeldjaeger Joe",
  	"Ex-Kopfgeldjaeger Joe",
  	"Ex-Kopfgeldjaeger Joe"}));
  	
  //SP(P_NAME_ADJ, "ehemalig");
  


  SetProp(P_GENDER, MALE);
  AddId(({"kopfgeldjaeger","NOWIMPY", "NOCONTROLL","joe", "kannibale"}));

  create_default_npc(40);
SP(P_ARTICLE, 1);

  SetProp(P_HANDS, ({" mit seinen Klauen",290+random(20),({DT_BLUDGEON})}));
  SetProp(P_SIZE, 220);
  SetProp(P_ALIGN, 100);


//SP(P_NOATTACK, "sagt: Nein! Katrin! NEIN!");


  SetProp(P_MAX_HANDS, 2);
    SetProp(P_BODY, 150);
  SetProp(P_HEAL,10);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
   SetProp(P_RESISTANCE_STRENGTHS, ([DT_MAGIC: 0.2, DT_FIRE:0.2, DT_BLUDGEON:-0.3,
  DT_TERROR: -0.9, DT_ACID: 0.4,DT_COLD:-0.1, DT_SLASH: -0.3]));   
  SetProp(P_NOMAGIC,5);

  SetProp(P_MSGIN, "kommt hierher");
  SetProp(P_MSGOUT, "geht eilig");
  SetProp(P_MMSGIN, "kommt breitgrinsend herein");
  SetProp(P_MMSGOUT, "rennt davon");

  SetProp(P_DIE_MSG,  " bricht bruellend und fluchend zusammen.\n");
  SetProp(P_NOCORPSE, 0 );
 SetProp(P_KILL_MSG, "Dir habe ich das Wort TOD aufs Hirn taetowiert!\n");  
  SetProp(P_MSG_FLAGS, ([P_KILL_MSG:0, P_MURDER_MSG:0 ]));
  SP(P_MURDER_MSG, "Deinen Kopf hole ich mir schon noch!\n");
  
  AddInfo(DEFAULT_INFO, ({
  "sagt: Du stellst aber kluge Fragen!\n",
  "spuckt vor Deine Fuesse.\n",
  "lacht nur ueber Dich.\n",
  "sagt: Ich habe fliegende Schweine gesehen.\n",
  "macht eine abwehrende Geste.\n",
  "staunt ueber so eine dumme Frage.\n",
  "gratuliert zu Deinem Wissen.\n",
  "sagt: Ja, Du hast vollkommen Recht.\n",
  "antwortet: Dante sagte das auch immer...\n",
  "fluestert: Bohr Dir doch ein Loch ins Knie...\n",
  "grinst Dich nur an.\n",
  "sagt: Hmm, Deine Ausruestung gefaellt mir.\n",
  "schaut Dich boese an.\n",
  "sagt: Naja, gib mir Geld, dann...\n"}));
  
  
  
  AI(({"taetowierung","tattoo","preis","hilfe"}),
  "Ich rede nicht gerne, schau Dich einfach um, ueberall stehen "
  "Tafeln und Schilder und Plakate! Da steht alles oben!",
  "sagt: ");
  
  AddInfo("dante", "Dante hat mich erschaffen.","sagt: ");


cash=CLONEOB("/obj/money");
cash->SP(P_AMOUNT, 2000+random(2000));
cash->move(ME, M_NOCHECK);


  SetProp(P_SPELLRATE,65);


set_living_name("joe");

 AddSpell(1,1,
"Joe, der Kopfgeldjaeger haelt Dir Deine Augen zu!\n",
"Joe, der Kopfgeldjaeger haelt @WESSEN Augen zu!\n",
DT_MAGIC, "spell_blind");

  
  AddSpell(1,1,
"Joe, der Kopfgeldjaeger dreht sich im Kreis und Dir schwinden alle Sinne.\n",
"Joe, der Kopfgeldjaeger dreht sich im Kreis und @WEM schwinden alle Sinne.\n",
DT_MAGIC, "spell_trans");
   

    AddSpell(5,300,
"Joe, der Kopfgeldjaeger wuergt Dich!\n",
"Joe, der Kopfgeldjaeger wuergt @WEN.\n",
DT_SQUEEZE, ([SP_SHOW_DAMAGE:1]));

    AddSpell(5,350,
"Joe, der Kopfgeldjaeger schlaegt Dir mir der Faust auf die Nase.\n",
"Joe, der Kopfgeldjaeger schlaegt @WEM mit der Faust auf die Nase.\n",
DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));

    AddSpell(5,300,
"Joe, der Kopfgeldjaeger bruellt Dich an.\n",
"Joe, der Kopfgeldjaeger bruellt @WEN an.\n",
DT_TERROR, ([SP_SHOW_DAMAGE:1]));

  AddSpell(5,500,
"Joe, der Kopfgeldjaeger schleudert Knochen auf Dich.\n",
"Joe, der Kopfgeldjaeger schleudert Knochen auf @WEN.\n",
DT_MAGIC, ([SP_SHOW_DAMAGE:1]));

 AddSpell(5,400,
"Joe, der Kopfgeldjaeger stopft Dir Farbe in den Mund.\n",
"Joe, der Kopfgeldjaeger stopft Farbe in @WESSEN Mund.\n",
DT_MAGIC, ([SP_SHOW_DAMAGE:1]));


  SetChats(3, ({
  "Joe, der Kopfgeldjaeger grinst Dich boesartig an.\n",
  "Joe, der Kopfgeldjaeger scheint etwas auszuhecken...\n",
  "Joe, der Kopfgeldjaeger lacht laut.\n",
"Joe, der Kopfgeldjaeger sagt: He! Lass Dich taetowieren!\n"
"Joe, der Kopfgeldjaeger sagt: Du bist ein Feigling!\n",
"Joe, der Kopfgeldjaeger sagt: Ich mache die besten Taetowierungen!\n",
"Joe, der Kopfgeldjaeger spitzt einen Knochen zu.\n",
"Joe, der Kopfgeldjaeger ruehrt etwas Farbe an.\n",
"Joe, der Kopfgeldjaeger reisst einem Huhn den Kopf ab und isst das Huhn dann auf.\n",
"Joe, der Kopfgeldjaeger sagt: Hmm, ich brauche neue Farbe.\n",
  "Joe, der Kopfgeldjaeger sagt: Du bist ziemlich doof.\n",
  "Joe, der Kopfgeldjaeger sagt: Gegen mich bist Du ein Weichei!\n",
  "Joe, der Kopfgeldjaeger kratzt seinen Buckel.\n",
  "Joe, der Kopfgeldjaeger murmelt irgendetwas.\n", 
  "Joe, der Kopfgeldjaeger stinkt ziemlich.\n"}) );
  
 
 SP(P_KILL_NAME, "Kopfgeldjaeger Joe");
 
 SUID;
 //CLONEME(WEAPON"st2");
 //absichtlich keinzuecken 
  
  
}

string opfer_liste()  {

if(!sizeof(opfer))  {
	return BS(
	"Du kennst keines der Opfer!");
	}
write("Du kannst den Kopf von:\n");
for(i=0;i<sizeof(opfer);i++)  {
 
 write(""+CAP(opfer[i])+" und\n");
            }
 write("Dante haengen sehen.");   	
    return "\n";    }

    
    	
  init()
  {
  object defender;	
  	
  ::init();
  if(interactive(TP)) call_out("hallo",0);
  }


 void hallo()
 {
 	
if(environment(TO)!=environment(TP)) return;

	
	
if(deep_present("DANTE_TATTOO", TP))   {
	
write(BSA(
CAP_TPN+" sei gegruesst! Noch eine Taetowierung gefaellig!",
"Joe sagt: "));
           }

if(!deep_present("DANTE_TATTOO", TP))   {		 		
 
 	switch(random(2))  {
 case 0:
 write(BS("Joe sagt: Hallo "+TPN+"!\n"));
 break;
 case 1:
 write(BS("Joe fragt Dich: Was fuehrt Dich zu mir?"));
 break;
default: command("emote fragt Dich: Was fuehrt Dich zu mir?");
                      }
  
 }

}

 
void spell_trans(object enemy)
{

switch(random(100))
{
	
	tell_object(enemy,
	"Joe will Dich aus dem Haus werfen!\n");
	
tell_room(environment(TO),
"Joe will "+enemy->name(WEN)+" aus dem Haus werfen!\n", ({enemy}));


	
case 0 .. 30:
     enemy->move("/d/dschungel/dante/tijaraneu/room/ti_pfad11",M_NO_SHOW + M_TPORT);
     break;
case 31.. 50:
     break; enemy->move("/d/dschungel/dante/tijaraneu/room/ti_pfad10",M_NO_SHOW + M_TPORT);
     break;
case 51 .. 99:
     tell_object (enemy,
     "Joe, der Kopfgeldjaeger schreit: Du Wurm hast nur Glueck gehabt!\n");
     break;
     }
 }
 
 
 
void spell_blind(object enemy)
{
switch(random(100))
{
case 0 .. 50:
     enemy->SetProp(P_BLIND, 10+random(20));
     break;
case 51.. 100:
     tell_object(enemy,
     "Joe, der Kopfgeldjaeger schreit: Du hast nochmal Glueck gehabt!!!\n");
     }
 }
 
 
 die(arg)  {
 	write_file("/d/dschungel/dante/weg/log/joe",
  ctime()+": Joe, der Kopfgeldjaeger wurde von "+CAP(getuid(TP))+" umgebracht.\n");
 ::die(arg);  }
 
 
 void NotifyPlayerDeath(object player, object killer, int lostexp)
 {


   if(member_array( getuid(player), opfer)==-1)  { 

  opfer+=({ getuid(player) });

save_object(SAVEFILE);

     }
 


  
  NAL1
  heal_self(1000);
  }
  NAL2
  
  
  reset()  { object cash;
  
  	::reset();
  if(!is_clone())  { return;  }
 rand=100+random(50);
 
  cash=deep_present("muenzen", TO);
  
 if(file_name(cash)[0..10]=="/obj/money#") {  
 
 if(cash->QueryProp(P_AMOUNT) > 50000 )   {
 
  "/p/daemon/zentralbank"->PayIn(cash-3333);  	
  AddMoney(-(cash-3333));
    }
  }
 }
  	
sags_auf_kanal(object wer, string region, string color)  {
	  
text=""+CAP(getuid(wer))+" laesst sich gerade "+region+" eine "+color+"e "
"Taetowierung von mir stechen!\n";

 "/p/daemon/channeld"->join("algemein", TO);     
   "/p/daemon/channeld"->send("allgemein", TO ,text); 
}	
