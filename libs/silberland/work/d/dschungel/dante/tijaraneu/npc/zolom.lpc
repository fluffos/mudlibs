#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "/players/dante/myowndefine.h"
#include <mnpc.h>

#include "/players/dante/myowndefine.h"


inherit "/d/dschungel/dante/tijaraneu/npc/std_npc_zolom";
 
 create()

{
 
  if (!is_clone(TO)) return;
  ::create();
AddId("zolom");

switch(random(106))   {
case 0..10:	
create_std_zolom(1);
break;
case 11..20:	
create_std_zolom(2);
break;
case 21..30:	
create_std_zolom(3);
break;
case 31..45:	
create_std_zolom(4);
break;
case 46..60:	
create_std_zolom(5);
break;
case 61..75:	
create_std_zolom(6);
break;
case 76..86:	
create_std_zolom(7);
break;
case 87..95:	
create_std_zolom(8);
break;
case 96..101:	
create_std_zolom(9);
break;
case 102..105:	
create_std_zolom(10);
break;
    
    default:
create_std_zolom(6);
    
     }

}
