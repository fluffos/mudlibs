/*
dante sl 2000
*/

inherit "std/npc";
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include "/players/dante/myowndefine.h"
#include <new_skills.h>

 create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine fleischfressende Riesenrose namens Godania godania");
  SetProp(P_LONG, BS(
"Diese riesengrosse Rose isst am liebsten kleine Abenteurer. Ihren "
"wundervollen Namen hat sie von Tithon bekommen. Er nannte sie so "
"aus Respekt vor Godan, den ersten wahren Bezwinger von "
"Phytokarnizerkatos. Er hat gemeinsam mit Cute den Drachen besiegt! "
"Godan musste insgesamt zwei mal sein Leben hergeben, um den Drachen "
"dann den Todesstoss versetzen zu koennen."));

  
  SetProp(P_NAME, "Godania godania");
  SetProp(P_GENDER, FEMALE);
  AddId(({"godania","pflanze", "riesenrose", "rose", "NOWIMPY"}));
  SetProp(P_RACE, "Pflanze");

  create_default_npc(20);
  SetProp(P_HANDS, ({" mit ihren stacheligen Blaettern",180+random(20),({DT_POISON,DT_RIP,DT_PIERCE}) }) );
  SetProp(P_SIZE, 200);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 0);
  SetProp(P_HEAL, 5);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_NOMAGIC,0);

  SetProp(P_MSGIN, "waechst aus dem Boden");
  SetProp(P_MSGOUT, "schlaengelt");
  SetProp(P_MMSGIN, "waechst aus dem Boden");
  SetProp(P_MMSGOUT, "verwelkt ploetzlich");

  SetProp(P_DIE_MSG,  " verwelkt ploetzlich abrupt.\n");
  SetProp(P_NOCORPSE, 0);

  AddInfo(DEFAULT_INFO, "reisst ihr Maul auf.\n");

  SetProp( P_REJECT, ({ REJECT_KEEP,
    "Die Riesenrose namens Godania godania reisst ihr Maul weit auf.\n" }) );

  SetProp(P_SPELLRATE,60);
  AddSpell(5,300,
    "Die Riesenrose namens Godania godania versucht Dich zu verschlucken.\n",
    "Die Riesenrose namens Godania godania versucht @WEN zu verschlucken.\n",
    DT_TERROR, ([SP_SHOW_DAMAGE:1]));
   AddSpell(2,400,   
    "Die Riesenrose namens Godania godania spritzt Schleim auf Dich.\n",
    "Die Riesenrose namens Godania godania spritzt Schleim auf Dich.\n",
    DT_ACID, ([SP_SHOW_DAMAGE:1]));
     AddSpell(4,350,   
    "Die Riesenrose namens Godania godania beisst Dir ins Bein.\n",
    "Die Riesenrose namens Godania godania beisst @WEM ins Bein.\n",
    DT_RIP, ([SP_SHOW_DAMAGE:1]));
    
  SetChats(3, ({
  "Die Riesenrose namens Godania godania reisst ihr Maul weit auf.\n",
  "Die Riesenrose namens Godania godania schliesst ihr Maul.\n",
  "Die Riesenrose namens Godania godania verschluckt eine Fliege.\n",
  "Die Riesenrose namens Godania godania schnappt nach Dir.\n",
  "Die Riesenrose namens Godania godania ruelpst.\n",
  "Die Riesenrose namens Godania godania verschluckt einen unsichtbaren Vogel.\n"}));
 
  SetAttackChats(10, ({
  "Die Riesenrose namens Godania godania versucht Deinen Kopf zu verschlingen.\n",
  "Die Riesenrose namens Godania godania schnappt nach Dir.\n",
  "Die Riesenrose namens Godania godania spuckt Schleim neben Dich.\n",
  "Doe Riesenlilie namens Cutensia cutensia reisst ihr Maul sehr weit auf.\n"}) );
  
}


init()
{
  object defender;
  ::init();


if(interactive(TP)) {
   
   
   if(getuid(TP)=="godan")  {

call_out("tag", 1);
      }
    }
   }
   
   tag()  {
   if(environment(TP)!=environment(TO)) return;
   
   
   say(BS(
   "Die Riesenrose Godania godania verneigt sich vor ihrem "
   "Namenspatron Godan! Sie weiss, das sie den schoenen Namen "
   "Godania godania Godan zu verdanken hat!"));
   
       }
