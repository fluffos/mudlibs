// dante@SilberLand
/*
   der gute alte folterknecht
   uralt teil
   dante 97-2000
   */

inherit "std/npc";
#include <mnpc.h>   
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "/players/dante/myowndefine.h"

void init()  {
  ::init();
  if(interactive(TP))  { call_out("hallo", 1);  }
}

hallo()  {
  if(environment(TO)!=environment(TP)) return;

  write(BSA(
        "HALLO "+CAP(getuid(TP))+"! Wie waers mit einer kleinen Folter!",
        "Der Folterknecht bruellt: "));  
}


void create()
{

  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein gnadenloser Folterknecht namens Fingernagelreisser");
  SetProp(P_LONG, BS(
        "Das ist Dantes Folterknecht. Der gnadenlose Fingernagelreisser!"
        " Er ist schon sehr alt und mitgenommen vom vielen "
        "Foltern. Trotzdem, wer weiss, was er so alles kann..."));

  SetProp(P_NAME, "Folterknecht");
  SP(P_NAME_ADJ, "gnadenlos");
  SetProp(P_GENDER, MALE);
  AddId(({"knecht", "folterknecht", "fingernagelreisser"}));
  SetProp(P_ARTICLE, 1);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10, T_RANGE_MAX: 45]));
  create_default_npc(18);
  SetProp(P_HANDS, ({" mit seinen Folterhaenden",150,DT_BLUDGEON}));
  SetProp(P_BODY, 50);
  SetProp(P_SIZE, 200);
  SetProp(P_ALIGN, -200);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_RACE, "Mensch");

  AI(({"fingernagel","finger","nagel","fingernagelreisser"}),
      "Dir werde ich die Fingernaegel ausreissen und dann einen Nagel ins Auge"         " treiben!", "sagt: ");
  AddCmd(({"folter","foltere","befreie","befrei","entfessle",
        "entfessel","fessel","fessle"}), "noget", 1);      

  SetProp( P_RESISTANCE_STRENGTHS,([DT_HOLY: 0.1, DT_TERROR:-1.0]));

  SetProp(P_HEAL,3);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);
  SetProp(P_NOCORPSE, 0);
  SetProp(P_MSGIN, "taucht auf");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "taucht auf");
  SetProp(P_MMSGOUT, "geht davon");


  SetProp(P_DIE_MSG,  " sagt: Du Sadist!\n"
      "Dann faellt er tot um!\n");

  SP(P_KILL_MSG, "HAHA! Wieder einer zu Tode gefoltert!!!\n");

  SP(P_MURDER_MSG, "OH! NEIN! Nun erwartet mich die ewige Folter bei Lars!\n");


  SetProp(P_MSG_FLAGS, ([P_KILL_MSG:0, P_MURDER_MSG:0 ]));


  SUID;
  CLONEME("p/armour/trousers/hose");
  CLONEME("p/armour/armour/hemd");
  CLONEME("p/armour/belt/guertel");
  CLONEME("p/armour/boots/lederstiefel");

  CLONEME("p/weapon/chain/morgenstern");

  command("ziehe alles an");
  command("zuecke morgenstern");

  AddInfo(DEFAULT_INFO, "bruellt: FOLTER!!!\n");

  AddInfo("dante", "Dante, der bloede Sack! Foltert immer die armen"
      " Spieler!",
      "sagt: ");

  SetProp( P_REJECT, ({ REJECT_DROP,
        "Was soll der Folterknecht damit?!\n" }) );
  SetChats(5,({
        "Der Folterknecht sagt: Los foltere jemanden!\n",
        "Der Folterknecht sagt: Schmerzen bereiten ist gut!\n",
        "Der Folterknecht ruelpst laut.\n",
        "Der Folterknecht sagt: Ich werde Dich fesseln!\n",
        "Der Folterknecht schaerft einen Spiess.\n"}));
  SetProp(P_SPELLRATE,70);

  AddSpell(5,200,
      "Der Folterknecht will Dir Schmerzen bereiten!\n",
      "Der Folterknecht will@WEM Schmerzen bereiten!\n",
      DT_TERROR,([SP_SHOW_DAMAGE:1]));

  AddSpell(4,300,
      "Der Folterknecht foltert Dich!\n",
      "Der Folterknecht foltert Dich!\n",
      DT_TERROR,([SP_SHOW_DAMAGE:1]));

  AddSpell(4,300,
      "Der Folterknecht bereitet Dir Schmerzen!\n",
      "Der Folterknecht bereitet Dir Schmerzen!\n",
      DT_TERROR,([SP_SHOW_DAMAGE:1]));

  AddSpell(2,300,
      "Der Folterknecht bereitet Dir Schmerzen!\n",
      "Der Folterknecht bereitet Dir Schmerzen!\n",
      DT_TERROR,([SP_SHOW_DAMAGE:1]));

  /*
     AddSpell(1,100,
     "Der Folterknecht versucht Dich zu fesseln!\n",
     "Der Folterknecht versucht Dich zu fesseln!\n",
     DT_MAGIC, "spell_t");

*/

  AddInfo("folterkammer",
      "Die Folterkammer ist mein Reich!", "sagt: ");
  AddInfo("kammer",
      "Hier foltere Ich Dich!\n");
  AddInfo("folter",
      "Folter macht Spass!", "lacht: ");
  enable_commands();

  set_living_name("folterknecht");

}

int noget()
{
  write("Der Folterknecht bruellt: HE! Das mache nur ich!\n");
  return 1;
}



spell_t(object enemy,int damage,mixed dam_type)
{
  switch(random(4))
  {
    case 0:
      tell_object(enemy,
          "Du hast Glueck, der Folterknecht schafft es nicht Dich zu fesseln!\n");
      break;
    case 1..3:
      enemy->StopHuntFor(ME);
      StopHuntFor(enemy);
      call_other(("/d/dschungel/dante/tijaraneu/room/fkammer"),"bondage", enemy);      
      break;
    default: write("BUG!\n");
  }
}                   



die(arg)  {
  write_file("/d/dschungel/dante/weg/log/folter",
      ctime()+": Der Knecht wurde von "+CAP(getuid(TP))+" umgebracht.\n");
  domainshout(CAP(getuid(PL))+" hat den Folterknecht bezwungen!\n");
  ::die(arg);  }


void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  write_file("/d/dschungel/dante/weg/log/folter",
      ctime()+": Der Folterknecht hat gerade "+CAP(getuid(player))+" umgebracht.\n");
}

_query_wimpy() { return 0;}  
