// dante@SilberLand

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "/players/dante/myowndefine.h"
#include <npc.h>

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Side-Show-Bob");
  SetProp(P_LONG, BS(
  "Side-Show-Bob ist eigentlich Krustys Assistent. Er ist ihm aber dessen "
  "Popularitaet sehr neidig und macht daher oft krumme Dinge, die Krusty auch "
  "mal ins Gefaengnis bringen..."));
  
    
  SetProp(P_NAME, "Side-Shoe-Bob");
  SetProp(P_GENDER, MALE);
  AddId(({"side-show-bob","bob", "clown"}));
  SetProp(P_ARTICLE, 0);
  create_default_npc(17);
  SetProp(P_HANDS, ({" mit seinem miesen Charakter",130,DT_TERROR}));
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 177);
  SetProp(P_ALIGN, 600);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 100);
  SetProp(P_NOMAGIC,10);

  SetProp(P_MSGIN, "stapft froehlich herein");
  SetProp(P_MSGOUT, "stapft froehlich");
  SetProp(P_MMSGIN, "stapft froehlich herein");
  SetProp(P_MMSGOUT, "stapft froehlich wieder weit weg");
  
  SetProp(P_DIE_MSG,  " schreit laut: Bring doch lieber Krusty um...\n");
  SetProp(P_NOCORPSE, 0 );

  SetProp(P_LOG_INFO, "dante/dclowns");
  AddInfo("krusty","Krusty ist ja primitiv.","sagt: ");
  AddInfo("moe", "Moe's Bar ist cool!","sagt: ");
  AddInfo("bart","Bart Simpson ist mein Feind!","sagt: ");
  AddInfo("bob","Side-Show-Bob ist der wahre Held...","sagt: ");
  AddInfo(DEFAULT_INFO, "sagt: Ich will eine eigene TV-Sendung.\n");
  AddInfo("dante", "Dante hat mich erschaffen.","sagt: ");
  AddInfo("wuschel", "Wuschel liegt meinem Erschaffer scheinbar am Herzen oder auch im Magen!", "sagt: ");
  SetProp( P_REJECT, ({ REJECT_KEEP,
    "Side-Shoe-Bob sagt: Ja, her damit.\n" }) );

  SetProp(P_SPELLRATE,99);
  
  AddSpell(3,200,
    "Side-Show-Bob attackiert Dich mit Verleumdungen.\n",
    "Side-Show-Bob attackiert @WEN mit Verleumdungen.\n",
     DT_TERROR,([SP_SHOW_DAMAGE:1]));
 AddSpell(3,200,
   "Side-Show-Bob verbreitet Luegen ueber Dich.\n"
   "Side-Show-Bob verbreitet Luegen ueber @WEN.\n"
      DT_TERROR,([SP_SHOW_DAMAGE:1]));
 AddSpell(3,200,
   "Side-Show-Bob laesst Dich ueber seine Beine stolpern.\n",
   "Side-Show-Bob laesst @WEN ueber seine Beine stolpern.\n",
     DT_TERROR,([SP_SHOW_DAMAGE:1]));

  SetChats(10, ({
  "Side-Show-Bob sagt: Itchy und Scratchy sind primitiv.\n",
  "Side-Show-Bob flucht ueber Krusty.\n",
  "Side-Show-Bob schaut neidisch auf Krusty...\n",
  "Side-Show-Bob schaut Dich musternd an.\n",
  "Side-Show-Bob erzaehlt Dir Luegen ueber Krusty.\n",
  "Side-Show-Bob fragt Dich: Was ist die Wurzel aus 8449871249 ?\n",
  "Du magst Side-Show-Bob nicht besonders gerne.\n",
  "Side-Show-Bob erzaehlt Dir schlechte Witze.\n"}) );
  
  SetAttackChats(10, ({
  "Side-Show-Bob schreit laut nach Krusty!\n",
  "Side-Show-Bob schreit: Aber mich lieben Doch alle!\n",
  "Side-Show-Bob sagt: Hoer auf oder ich hole Pennywise.\n",
  "Side-Show-Bob bietet Dir Geld fuer sein Leben.\n",
  "Du bekommst grossen Hass auf Side-Show-Bob.\n"}));



	




     SUID;
     CLONEME("/d/dschungel/dante/tijaraneu/armour/cloak" );
     command("zieh alles an");  
  
  AddCmd(({"tritt","trete","kitzl","lieb","spuck","wuerg","umarm",
 "toet","kuess"}),"lieb",1);
 
 /*
 if(!random(3))  {
 	CLONEME("/players/dante/k1");
  }
 */
  	 
  } 

int lieb(string str)
{
  if( str && id(str) )
    call_out("fehler",0);
  return 0;
}

void fehler()
{
  write("Side-Show-Bob sagt: Das war soziologisch betrachtet ein Fehler!\n");
}
 
void init()
{
  ::init();
  if(interactive(TP)) call_out("hallo",0);
}

void hallo()
{
  command("emote schaut grantig und sagt: Hallo "+ TP->name(RAW) +"!");
}
   
