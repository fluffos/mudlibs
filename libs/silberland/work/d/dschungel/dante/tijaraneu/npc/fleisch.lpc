/*
   dante sl 97 -2000
   */

inherit "std/npc";
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include "/players/dante/myowndefine.h"
#include <new_skills.h>

void create()
{

  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine fleischfressende Vogelfalle");
  SetProp(P_LONG, BS(
        "Vor Dir siehst Du ein besonders schoenes Exemplar einer fleischfressenden "
        " Pflanze. Gierig reisst sie ihr grosses Maul auf um Insekten aber auch kleine "
        "Voegel zu verschlingen."));
  AddDetail(("maul"),
      "Das Maul ist so gross, dass Dein Kopf muehelos hineinpasst...");

  SetProp(P_NAME, "Vogelfalle");
  SetProp(P_GENDER, FEMALE);
  AddId(({"pflanze", "vogelfalle", "falle", "NOWIMPY"}));
  set_living_name("vogelfalle");
  SetProp(P_RACE, "Pflanze");

  create_default_npc(13);
  SetProp(P_HANDS, ({" mit ihrem grossem Maul",110+random(20),({DT_POISON,DT_RIP,DT_PIERCE}) }) );
  SetProp(P_SIZE, 100);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 0);
  SetProp(P_HEAL, 3);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_NOMAGIC,0);

  SetProp(P_MSGIN, "waechst aus dem Boden");
  SetProp(P_MSGOUT, "schlaengelt");
  SetProp(P_MMSGIN, "waechst aus dem Boden");
  SetProp(P_MMSGOUT, "verwelkt ploetzlich");

  SetProp(P_DIE_MSG,  " verwelkt ploetzlich abrupt.\n");
  SetProp(P_NOCORPSE, 0);

  AddInfo(DEFAULT_INFO, "reisst ihr Maul auf.\n");

  SetProp( P_REJECT, ({ REJECT_KEEP,
        "Die Vogelfalle reisst ihr Maul weit auf.\n" }) );

  SetProp(P_SPELLRATE,60);
  AddSpell(5,200,
      "Die Vogelfalle versucht Dich zu verschlucken.\n",
      "Die Vogelfalle versucht @WEN zu verschlucken.\n",
      DT_TERROR, ([SP_SHOW_DAMAGE:1]));
  AddSpell(2,400,   
      "Die Vogelfalle spritzt Schleim auf Dich.\n",
      "Die Vogelfalle spritzt Schleim auf Dich.\n",
      DT_ACID, ([SP_SHOW_DAMAGE:1]));
  AddSpell(4,350,   
      "Die Vogelfalle beisst Dir ins Bein.\n",
      "Die Vogelfalle beisst @WEM ins Bein.\n",
      DT_RIP, ([SP_SHOW_DAMAGE:1]));

  SetChats(3, ({
        "Die Vogelfalle reisst ihr Maul weit auf.\n",
        "Die Vogelfalle schliesst ihr Maul.\n",
        "Die Vogelfalle verschluckt eine Fliege.\n",
        "Die Vogelfalle schnappt nach Dir.\n",
        "Die Vogelfalle ruelpst.\n",
        "Die Vogelfalle verschluckt einen unsichtbaren Vogel.\n"}));

  SetAttackChats(10, ({
        "Die Vogelfalle versucht Deinen Kopf zu verschlingen.\n",
        "Die Vogelfalle schnappt nach Dir.\n",
        "Die Vogelfalle spuckt Schleim neben Dich.\n",
        "Doe Vogelfalle reisst ihr Maul sehr weit auf.\n"}) );

  // SUID;
  // CLONEME(OBJ "leiche");
}


init()
{
  object defender;
  ::init();
  if (defender = present("tithon")) AddDefender(defender);
  if (defender = present("vogelfalle 2")) AddDefender(defender);
  if (defender = present("vogelfalle 3")) AddDefender(defender);
  if (defender = present("vogelfalle 4")) AddDefender(defender);

}
void InformDefend(object enemy)
{
  Kill(enemy);
}

Defend(int dam, string dtype, int spell, object enemy)    
{
  object ob;
  ob=find_living("tithon");

  if(ob)  {
    ob->Kill(enemy);   	
  }

  return ::Defend(dam, dtype, spell, enemy);
}

