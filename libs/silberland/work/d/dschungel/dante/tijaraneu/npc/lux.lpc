inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <npc.h>
#include <moving.h>
#include <actions.h>
#include <new_skills.h>
#include "/players/dante/myowndefine.h"

#define SCHROTT ({"/d/dschungel/dante/weg/obj/jojo", \
                  "/d/dschungel/dante/weg/obj/schoko1", \
                  "/d/dschungel/dante/weg/obj/schokobons", \
                  "/d/dschungel/dante/weg/obj/dpilz", \
                  })

#define LOBJ "/d/dschungel/dante/private_obj/licht_items/"

void create()
{
  if(!is_clone(TO)) return;
  ::create();
  
  SetProp(P_SHORT, "Lux, die Lichtfee");
  SetProp(P_LONG, BS(
    "Vor Dir siehst Du die hell strahlende Lichtfee Lux, ein magisches "+
    "Wesen. Sie schimmert gelb und hellrot und verbreitet ueberall "+
    "wo sie nur auftaucht helles, klares Licht. Angeblich ist sie im "+
    "Besitz von magischen Objekten, die selbst Licht spenden sollen..."));
    
  SetProp(P_NAME,({"Lux, die Lichtfee",
		     "Lux, der Lichtfee",
		     "Lux, der Lichtfee",
		     "Lux, die Lichtfee"}));
  SetProp(P_GENDER, FEMALE);
  AddId(({"lux","NOWIMPY", "lichtfee","fee"}));
  set_living_name("lux");

  create_default_npc(30+random(3));
  
  SetProp(P_ARTICLE, 0);
  SetProp(P_RACE, "Fee");
  SetProp(P_HANDS, ({" mit einem Lichtblitz",350+random(20),({DT_LIGHT,DT_LIGHTNING})}));
  SetProp(P_SIZE, 30+random(30));
  SetProp(P_ALIGN, 500);

  SetProp(P_MAX_HANDS, 2);
  SetProp(P_BODY, 80);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE, ([P_RACE:(["Dunkelelf":0.3,0:0.0])]));
  SetProp(P_WIMPY, 0);
  SetProp(P_RESISTANCE_STRENGTHS, 
	  ([DT_MAGIC:-0.7, DT_FIRE:-0.5, DT_BLUDGEON:0.5,
	  DT_TERROR:0.9, DT_LIGHT: -0.9,DT_LIGHTNING: -0.9, DT_SLASH: 0.3]));   

  SetProp(P_NOMAGIC,10+random(10));

  SetProp(P_MSGIN, "schwebt strahlend");
  SetProp(P_MSGOUT, "schwebt strahlend");
  SetProp(P_MMSGIN, "schwebt strahlend");
  SetProp(P_MMSGOUT, "schwebt strahlend davon");

  SetProp(P_DIE_MSG, " loest sich in hellen Lichtblitzen auf.\n");
  SetProp(P_NOCORPSE, 1);
  SetProp(P_KILL_MSG, "sagt: Die Magie des Lichtes ist zu stark fuer Dich!\n");  
  SetProp(P_MSG_FLAGS, ([P_KILL_MSG:1, P_MURDER_MSG:1 ]));
  SetProp(P_MURDER_MSG, "AHHH!!! Wo war meine Lichtmagie\n");
  
  AddInfo(DEFAULT_INFO, 
	  ({
	    "strahlt Dich nur hell an!\n",
	      "sagt: Wo Licht, da Leben!\n",
	      "blitzt Dich kurz an.\n",
	      "sagt: Du bist ja duemmer als ein dummer Dunkelelf!\n",
	      "sagt: Folge dem Licht!\n"}));
  
  AddInfo(({"magie","lichtmagie"}),
     "Die Lichtmagie ist die Beste! ", "sagt: ");
  AddInfo(({"dunkelelfen","elfen", "dunkelelf"}),
     "Die Dunkelelfen sind arme Kreaturen!",
     "sagt: ");
  AddInfo("wachs",
     "Das Wachs naehrt die Lichtkugel!", "sagt: ");
  AddInfo(({"kugel","lichtkugel"}),
     "Sie ist das Geheimnis meiner Macht!", "sagt: ");
  AddInfo("macht",
     "Ohne sie bin ich verloren!", "sagt: ");
  AddInfo("geheimnis",
     "Denkst Du ich bin so bloed?!", "sagt: ");
  AddInfo(({"licht","lichtfee","lux"}),
     "Ich bin die Lichtfee Lux, die immerwaehrendes Licht erzeugt!",
     "sagt strahlend: ");
  AddInfo(({"lichtobjekte","objekt", "objekte"}),
     "Ja, ich bin die Herrin der Lichtobjekte! Kaempfe mit mir und "
     "vielleicht kannst Du eines haben!", "sagt: ");

  AddInfo("dante", "Dante hat mich erschaffen.","sagt: ");
  
  SetProp(P_LIGHT, 2);

  SetProp(P_SPELLRATE,65);
  
  AddSpell(5,300,
	   "Die Lichtfee schiesst mit Blitzen nach Dir!\n",
	   "Die Lichtfee schiesst mit Blitzen nach @WEM!\n",
	   DT_LIGHTNING, ([SP_SHOW_DAMAGE:1]));
  
  AddSpell(3,450,
	   "Die Lichtfee schiesst einen grossen, blauen Blitz nach Dir!\n",
	   "Die Lichtfee schiesst einen grossen, blauen Blitz nach @WEM!\n",
	   ({DT_WATER,DT_LIGHTNING}), ([SP_SHOW_DAMAGE:1]));
  
  AddSpell(3,450,
	   "Die Lichtfee schiesst einen grossen, roten Blitz nach Dir!\n",
	   "Die Lichtfee schiesst einen grossen, roten Blitz nach @WEM!\n",
	   ({DT_FIRE,DT_LIGHTNING}), ([SP_SHOW_DAMAGE:1]));
  
  AddSpell(3,450,
	   "Die Lichtfee schiesst einen grossen, gruenen Blitz nach Dir!\n",
	   "Die Lichtfee schiesst einen grossen, gruenen Blitz nach @WEM!\n",
	   ({DT_POISON,DT_LIGHTNING}), ([SP_SHOW_DAMAGE:1]));
    
  AddSpell(3,400,
	   "Die Lichtfee spricht einen kleinen Lichtzauber ueber Dich!\n",
	   "Die Lichtfee spricht einen kleinen Lichtzauber ueber @WEN!\n",
	   DT_LIGHT, ([SP_SHOW_DAMAGE:1]));
  
  AddSpell(1,700,
	   "Die Lichtfee spricht einen grossen Lichtzauber ueber Dich!\n",
	   "Die Lichtfee spricht einen grossen Lichtzauber ueber @WEN!\n",
	   DT_LIGHT, ([SP_SHOW_DAMAGE:1]));

  AddSpell(1,1,
	   "Die Lichtfee flattert wie wild um Dich herum!\nDu bist verwirrt.\n",
	   "Die Lichtfee flattert wie wild um @WEN herum!\n",
	   DT_AIR, "verwirren");

  AddSpell(1,1,
	   "Die Haende der Lichtfee flammen kurz auf!\n",
	   "Die Haende der Lichtfee flammen kurz auf!\n",
	   DT_FIRE, "feuer");

  SetChats(3, ({
    "Die Lichtfee strahlt hell auf.\n",
      "Die Lichtfee blitzt kurz auf.\n",
      "Helles Licht geht von der Lichtfee aus!\n",
      "Die Lichtfee schwebt umher.\n",
      "Die Lichtfee naehert sich dem Objekt!\n",
      "Die Lichtfee schwebt auf die Lichtkugel zu!\n",
      "Die Lichtfee sagt: Das Licht ist Leben!\n",
      "Die Lichtfee sagt: Lichtmagie ist besser als Dunkelheit!\n",
      "Die Lichtfee sagt: Meide das Dunkel!\n",
      "Die Lichtfee gibt helles Licht ab.\n",
      "Die Lichtfee sorgt sich um die Lichtkugel!\n",
      "Die Lichtfee sagt: Hoffentlich zerstoert niemand die Lichtkugel!\n",
      "Die Lichtfee hat Angst, dass die Lichtkugel zerstoert wird.\n",
      "Die Lichtkugel kann angeblich zerstoert werden!\n",
      "Die Lichtfee sagt: Dunkelelfen sind dumm und stinken!\n",
      "Die Lichtfee schimmert unheimlich.\n",
      "Die Lichtfee sagt: Es werde Licht!\n"}));
  
 SUID;
}

verwirren(object enemy, int dam, mixed dam_type)
{
  enemy->AddProp(P_DISABLE_ATTACK, 1+random(2));
}

feuer(object enemy, int dam, mixed dam_type)
{
  object feuer;
  
  if(present("feuer 5", ENV(TO))) return;
  
  feuer=clone_object("d/dschungel/dante/tijaraneu/npc/lfire");
  feuer->move(ENV(ME), M_NOCHECK);
  feuer->Kill(enemy);
}

Defend(int dam, string dtype, int spell, object enemy)    
{
  if(!TO->id("zerstoert")) 
    {
      tell_object(enemy, BS("Die Lichtfee lacht Dich wissend aus!")); 
      return ::Defend(0, dtype, spell, enemy);        
    }
   
  if(!pointerp(dtype))
    dtype=({ dtype });
  
  if(sizeof(dtype & ({ DT_LIGHTNING }) ))
    {
      tell_room(environment(), "Die Lichtfee strahlt kurz erfreut auf.\n");
      heal_self(dam);
      return ::Defend(0, dtype, spell, enemy);
    }

  if(sizeof(dtype & ({ DT_LIGHT }) ))
    {
      tell_room(environment(), "Die Lichtfee strahlt kurz erfreut auf.\n");
      heal_self(dam);
      return ::Defend(0, dtype, spell, enemy);
    }
  

  if(sizeof(dtype & ({ DT_COLD }) ))
    {
      tell_room(environment(), "Die Lichtfee bruellt vor Schmerzen auf!\n");
      return ::Defend(dam+random(20), dtype, spell, enemy);
    }

  return ::Defend(dam, dtype, spell, enemy);    
}

void InformDefend(object enemy)
{
  Kill(enemy);
}
      
init()
{
  object defender;	
  
  ::init();

  if (defender = present("l_fire")) AddDefender(defender);
  if(interactive(TP)) call_out("hallo",0);
}

hallo()
{
  if (!TP || !present(TP, environment(this_object())))
    return;
  if(deep_present("PRIVATE_LICHT", TP))  
    {
      write(BSA("AH! Du hast ja ein magisches Lichtobjekt!", "Die Lichtfee sagt: "));
      return;  
    } 	
 	
  if(TP->QP(P_RACE)=="Fee")  
    {
      write(BSA("Sei gegruesst, Feenschwester "+TPN+"!", "Die Lichtfee sagt: "));
      return; 
    }
  
  if(TP->QP(P_RACE)=="Dunkelelf")  
    {
      write(BSA("Du verfluchter Dunkelelf! Hau ab "+TPN+"!","Die Lichtfee flucht: ")); 
      return; 
    }
  
  switch(random(2))  
    {
    case 0:
      write(BS("Die Lichtfee sagt: Hallo "+TPN+"!\n"));
      break;
    case 1:
      write(BS("Die Lichtfee sagt: Das Licht sei mit Dir, "+TPN+"!"));
      break;
    default: command("emote fragt Dich: Was fuehrt Dich zu mir?");
    }
  
}

die(arg)  
{
  object ob;
  string *inv;
  int i,own;

  ob=0;
  own=0;

  if(!interactive(TP)) return ::die(arg);

  if((!deep_present("PRIVATE_LICHT", TP)) && !random(2))
    {
      inv=get_dir(LOBJ+"lobj_*");
      
      if(!sizeof(inv)) inv=SCHROTT;
      
      for(i=sizeof(inv)-1;i>=0;i--)
        if(strstr(inv[i], getuid(TP))!=-1)
          {
            ob=CLONEOB(LOBJ+inv[i]);
            own=1;
          }
      
      if(!own)
        ob=CLONEOB(LOBJ+to_string(inv[random(sizeof(inv))]));
    }
  else
    {
      ob=CLONEOB(SCHROTT[random(sizeof(SCHROTT))]);
    }

  ob->move(TP, M_NOCHECK);
      
  tell_object(TP, 
              "Die Lichtfee verliert ein Objekt, das genau in Deine Haende faellt!\n"+
              (own ? "Du hast Dein magisches Lichtobjekt wieder!\n":""));
    
    
  write_file("/d/dschungel/dante/private_obj/licht_items/lux",
	     dtime(time())+": "+CAP(getuid(TP))+" kriegt "+ob->QP(P_NAME)+"\n");
  
  ::die(arg);
  
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  write_file("d/dschungel/dante/private_obj/licht_items/lux",
	     dtime()+": Lux toetet "+CAP(getuid(player))+" ("+lostexp+")\n");
  heal_self(1000);
  tell_room(ENV(TO), "Lux strahlt hell auf als sie "+player->name(WESSEN)+" Energie "+
	    "absorbiert.\n");
  call_out("nimm_alles_aus_leiche", 0);
}

nimm_alles_aus_leiche()
{ 
  if(present("leiche", environment(TO)))
    command("nimm alles aus leiche");
}

