inherit "std/npc";
#include "/players/dante/myowndefine.h"
#include <properties.h>
#include <language.h>
#include <moving.h>
#include <combat.h>
#include <new_skills.h>
#include <npc.h>


void create()
{


if (!is_clone(TO)) return;
::create();

create_default_npc(15);

SetProp(P_GENDER, MALE);

SP(P_NAME, "Schleimwerfer");
SP(P_SHORT, "Ein Schleimwerfer");
SP(P_LONG, BS(
"Der Schleimwerfer ist eine ekelhafte, kleine Kreatur, die ueber und "
"ueber mit Schleim ueberzogen ist."));
AD("schleim",
"PFUI!");
SetProp(P_RACE, "Schleimwesen");
AddId(({"schleimwerfer", "werfer"}));
SetProp(P_ARTICLE, 1);

SetProp(P_HANDS, ({" mit seinem schleimigen Haenden", 150,DT_BLUDGEON}));
SetProp(P_BODY, 40);
SetProp(P_SIZE, 70);
SetProp(P_ALIGN, -100);

SetProp(P_HEAL,-5);
SetProp(P_AGGRESSIVE, 0);
SetProp(P_WIMPY, 0);
SetProp(P_NOMAGIC, 3);
SetProp(P_NOCORPSE, 0);
SetProp(P_MSGIN, "kommt schleimend herein");
SetProp(P_MSGOUT, "geht schleimend und sabbernd");
SetProp(P_MMSGIN, "taucht ploetzlich neben Dir auf");
SetProp(P_MMSGOUT, "verschwindet");

AddSpell(1,250,
"Der Schleimwerfer wirft Schleim nach Dir.\n",
"Der Schleimwerfer wirft Schleim nach @WEM.\n",
DT_ACID, ([SP_SHOW_DAMAGE:1]));
SetProp(P_DIE_MSG, " sagt: 'Justavius, da ist ein Typo!' und faellt sabbernd tot um!\n");

SetChats(5,({
"Der Schleimwerfer sagt: Du schleimst ja!\n",
"Der Schleimwerfer sagt: Schleimer!\n",
"Der Schleimwerfer stinkt erbaermlich.\n",
"Der Schleimwerfer sabbert herum.\n",
"Der Schleimwerfer sagt: DU stinkst ja!\n"}));


AddInfo(DEFAULT_INFO,({
"grinst nur bloed.\n",
"sagt: Du Schleimer!\n"}));
SUID;
if(random(2)) {
CLONEME("/d/ebene/ronja/feenquest/obj/sball");
}

}




