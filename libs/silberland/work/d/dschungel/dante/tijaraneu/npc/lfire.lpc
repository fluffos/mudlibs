// dante@SilberLand

inherit "std/npc";

#include <mnpc.h>   
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "/players/dante/myowndefine.h"

void create()
{
  if (!is_clone(TO)) return;
  ::create();
  
  SetProp(P_SHORT, "Ein helles Feuer");
  SetProp(P_LONG, 
	  BS("Das ist eine Art lebendiges Feuer, das die Lichtfee zu Hilfe gerufen hat!"));
  SetProp(P_NAME, "Feuer");
  SP(P_NAME_ADJ, "hell");
  SetProp(P_GENDER, NEUTER);
  AddId(({"feuer", "l_fire", "NOWIMPY"}));
  SetProp(P_ARTICLE, 1);
  SetProp(P_RACE, "Elementar");
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:20, T_RANGE_MAX: 45]));
  create_default_npc(13);
  SetProp(P_HANDS, ({" mit enormer Hitze",150,DT_FIRE}));
  SetProp(P_BODY, 50);
  SetProp(P_SIZE, 200);
  SetProp(P_ALIGN, -300);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_RESISTANCE_STRENGTHS,
      ([DT_LIGHT: -0.9, DT_WATER:0.6, DT_FIRE:-0.9, DT_TERROR:-1.0]));
   
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,10);
  SetProp(P_NOCORPSE, 1);
  SetProp(P_MSGIN, "rast herein");
  SetProp(P_MSGOUT, "rast blitzschnell");
  SetProp(P_MMSGIN, "rast herein");
  SetProp(P_MMSGOUT, "rast davon");
  
  SetProp(P_DIE_MSG,  " explodiert in einer Feuerwolke!\n");
  
  AddInfo(DEFAULT_INFO, "kann Dich doch nicht verstehen!\n");
  
  AddInfo("dante", "Dante, der bloede Sack!","sagt: ");
  
  SetProp(P_SPELLRATE,60);
  
  AddSpell(3,150,
	   "Das Feuer umhuellt Dich!\n",
	   "Das Feuer umhuellt @WEN.\n",
	   DT_FIRE,([SP_SHOW_DAMAGE:1]));
  AddSpell(3,250,
	   "Das Feuer sprueht Feuerregen auf Dich!\n",
	   "Das Feuer sprueht Feuerregen auf @WEN.\n",
	   DT_FIRE,([SP_SHOW_DAMAGE:1]));
} 

Defend(int dam, string dtype, int spell, object enemy)
{
  if(!pointerp(dtype))
    dtype = ({ dtype });
  
  if(sizeof(dtype & ({ DT_FIRE }) ))
    {
      tell_room(environment(), "Du staerkst das Feuer nur!\n");
      heal_self(dam/2);
      return ::Defend(0, dtype, spell, enemy);
    }         
  
  if(sizeof(dtype & ({ DT_COLD }) ))
    {
      tell_room(environment(), "Das Feuer wird kleiner!\n");
      return ::Defend(2*dam, dtype, spell, enemy);
    }         
  
  return ::Defend(dam, dtype, spell, enemy);
}

void InformDefend(object enemy)
{
  Kill(enemy);
}

init()
{
  object defender;	
  
  ::init();

  if (defender = present("lux")) AddDefender(defender);
}

