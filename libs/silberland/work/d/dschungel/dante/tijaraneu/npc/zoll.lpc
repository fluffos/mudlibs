// 97 dante@SilberLand

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "/players/dante/myowndefine.h"


string wieviel();
string *bezahlt;
int preis;

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

bezahlt=({});


  SetProp(P_SHORT, "Ein kraeftiger Zollwaechter");
  SetProp(P_LONG, BS(
"Dieser Waechter steht hier um den Wegezoll einzukassieren. "
"Das Geld wird fuer die Erhaltung der Stadt Tijara gebraucht."
" Frage ihn nach Zoll!"));

  SetProp(P_NAME, "Zollwaechter");
  SetProp(P_GENDER, MALE);
  AddId(({ "waechter", "wache","zollwaechter"}));

  create_default_npc(14);
  SetProp(P_HANDS, ({" mit seinen starken Armen",130+random(20),DT_BLUDGEON}));
  SetProp(P_BODY, 50+random(10));
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 180);
  SetProp(P_ALIGN, 100);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,5);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,3);

  SetProp(P_MSGIN, "marschiert herein");
  SetProp(P_MSGOUT, "marschiert");
  SetProp(P_MMSGIN, "marschiert herein");
  SetProp(P_MMSGOUT, "marschiert weit weg");

  SetProp(P_DIE_MSG,  " bricht in Plichterfuellung nieder.\n");
  SetProp(P_NOCORPSE, 0 );

  AddInfo(DEFAULT_INFO, "sagt: Hier herrscht Ruhe und Ordnung!\n");
  AddInfo("dante", "Dante hat mich erschaffen.\n","sagt: ");
  
  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Waechter sagt: Nein, auch so bekommst Du nichts von mir!\n" }) );

  SetProp(P_SPELLRATE,50);
  
  AddSpell(3,250,
    "Der Waechter schlaegt Dir in den Bauch.\n",
    "Der Waechter schlaegt @WEM in den Bauch.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));
  AddSpell(5,200,
    "Der Waechter sticht Dir in Dein Bein.\n",
    "Der Waechter sticht @WEM in sein Bein.\n",
     DT_PIERCE,([SP_SHOW_DAMAGE:1]));
  AddSpell(1,300,
    "Der Waechter schlitzt fast Deinen Arm auf.\n",
    "Der Waechter schlitzt fast @WESSEN Arm auf.\n",
     DT_RIP,([SP_SHOW_DAMAGE:1]));

  SetChats(3, ({
  "Der Waechter warnt Dich eindringlichst.\n",
  "Der Waechter schaut Dich pruefend an.\n",
  "Der Waechter stoehnt ueber seine Arbeit.\n",
  "Der Waechter baut sich vor Dir auf.\n",
  "Der Waechter sagt: Du, was willst Du hier !\n"}) );
  SetAttackChats(10, ({
  "Der Waechter bedraengt Dich hart.\n",
  "Der Waechter schreit: Verschwinde schnell !\n",
  "Du stolperst fast...\n",
  "Der Waechter ist staerker als Du dachtest...\n",
  "Der Waechter flucht laut.\n"}) );

SUID;
  
 CLONEME("p/armour/shield/kupferschild");
   CLONEME("p/armour/trousers/fellhose");
    CLONEME("p/armour/boots/sandalen");
    CLONEME("p/weapon/chain/morgenstern");
    command("ziehe alles an");
    command("zuecke morgenstern");
    
    
    AI(({"zoll","wegezoll","geld","muenzen","stadt","tijara","preis"}),
    #'wieviel, "sagt: ");
 
 ACD(({"norden", "n"}), "look");
    
}

int look()  {
	preis=100+TP->QueryProp(P_LEVEL)*5;	
      
      if(member_array(getuid(TP), bezahlt)==-1 )   {
      	write(BSA(
      	"STOP!!! Zoll zahlen! Und zwar "+preis+" Muenzen!",
      	"Der Waechter sagt: "));
      	return 1;  }
      		
write(BS(
"Der Waechter winkt Dir zu!"));

     }
	

string wieviel()  {
 
 preis=100+TP->QueryProp(P_LEVEL)*5;	

 return 
 "Du musst mir "+preis+" Muenzen geben, damit Du passieren darfst!\n";
        }


  give_notify(object ob)
        { 
        	preis=100+TP->QueryProp(P_LEVEL)*5;	
        	
      if(file_name(ob)[0..10]=="/obj/money#")  {
      	
      if(ob->QP(P_AMOUNT) < preis )  {	
      	
      	write(BSA(
      	"Danke fuer das Geld!",
      	"Der Waechter sagt: "));
      	ob->remove();
      	return;
          }	
      
       if(ob->QP(P_AMOUNT) >= preis )  {	 
      	  	
         if(member_array(getuid(TP), bezahlt)==-1 )   {
         
          bezahlt+=({getuid(TP)});
         
           write(BSA(
         "Danke fuer Deinen Beitrag!",
          "Der Waechter sagt: "));
          ob->remove();
            return ;  }
       
       
       else   {
       
         
           
          write(BSA(
         "Danke fuer Deinen Beitrag! Du hattest aber schon einmal bezahlt!",
          "Der Waechter sagt: "));
          ob->remove();
            return ;  
                      }
              }
      } 	  
         
         
         
          write(BSA("Danke fuer "+ob->name(WEN,1)+"!\n"
          "Ich bin aber nicht bestechlich!",
             "Der Waechter sagt: "));
            return ;  
                      
        }






init()  {
        ::init();
if(interactive(TP)) { call_out("tag", 0); }}




tag()  {

        if(environment(TO)!=environment(TP)) return ;

if(member_array(getuid(TP), bezahlt)!=-1 )   {

write(BSA(
"Hallo "+TPN+" Willkommen! Danke fuer Deinen Beitrag!",
"Der Waechter sagt: "));
  return ;  }
  
  else
  
  write(BSA(
  "STOP! Zollstelle! Zur Kasse "+TPN+"!",
  "Der Waechter sagt: "));
}



reset()  {int x;

	::reset();
x++;

if(x==10)  {
  x=0;
  bezahlt=({});
    }		
}
_query_wimpy()  {
	return 0;  }
	
