// dante@SilberLand

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "/players/dante/myowndefine.h"
#include <npc.h>

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Krusty, der Clown");
  SetProp(P_LONG, BS(
  "Krusty, der Clown ist immer lustig, zumindest in der Oeffentlichkeit. Alle "
  "Kinder lieben ihn und so natuerlich auch wir. Aber so lieb und nett wie sich "
  "Krusty uns praesentiert ist er gar nicht. Er saeuft, nimmt Drogen und ist geldgierig..."));
    
  SetProp(P_NAME, "Krusty");
  SetProp(P_GENDER, MALE);
  AddId(({"krusty", "clown"}));
  SetProp(P_ARTICLE, 0);
  create_default_npc(23);
  SetProp(P_HANDS, ({" mit seinen langen Armen",190,DT_TERROR}));
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 193);
  SetProp(P_ALIGN, 500);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 100);
  SetProp(P_NOMAGIC,10);

  SetProp(P_MSGIN, "schlurft froehlich herein");
  SetProp(P_MSGOUT, "schlurft froehlich");
  SetProp(P_MMSGIN, "schlurft froehlich herein");
  SetProp(P_MMSGOUT, "verzieht froehlich wieder");
  
  SetProp(P_DIE_MSG,  " schreit laut: Warum nur ich..\n");
  SetProp(P_NOCORPSE, 0 );
  
  SetProp(P_LOG_INFO, "dante/dclowns");
  AddInfo("moe", "Moe's Bar ist cool!","sagt: ");
  AddInfo("bart","Bart Simpson ist mein Freund!","sagt: ");
  AddInfo("bob","Side-Show-Bob , hmmm...","sagt: ");
  AddInfo(DEFAULT_INFO, "sagt: Kauf die guten Krustyflakes.\n");
  AddInfo("dante", "Dante hat mich erschaffen.","sagt: ");
  AddInfo("wuschel", "UI! Die hat eine lustige Nase!", "sagt: ");
  SetProp( P_REJECT, ({ REJECT_GIVE,
    "Krusty sagt: Gibs lieber Side-Show-Bob.\n" }) );

  SetProp(P_SPELLRATE,99);
  
  AddSpell(7,350,
    "Krusty tritt Dich mit seinen langen Schuhen.\n",
    "Krusty tritt @WEN mit seinen langen Schuhen.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));
 AddSpell(1,950,
    "Krusty elektrisiert Dich mit seinem Herzschrittmacher.\n",
    "Krusty elektrisiert @WEN mit seinem Herzschrittmacher.\n",
     DT_ELECTRIC,([SP_SHOW_DAMAGE:1]));
 AddSpell(5,250,
    "Krusty zeigt Dir seine ueberfluessige Brustwarze.\n",
    "Krusty zeigt @WEN seine ueberfluessige Brustwarze.\n",
     DT_TERROR,([SP_SHOW_DAMAGE:1]));
 AddSpell(9,150,
 "Krusty bewirft Dich mit Aspirin.\n",
 "Krusty bwirft @WEN mit Aspirin.\n",
     DT_TERROR,([SP_SHOW_DAMAGE:1]));


  SetChats(10, ({
  "Krusty sagt: Und nun liebe Kinder kommen Itchy und Scratchy.\n",
  "Krusty singt 'The Itchy and Scratchy Show...\n",
  "Krusty sagt: Kennst Du Side-Show-Bob...\n",
  "Krusty sagt: Kauf meine Krustyflakes.\n",
  "Krusty lacht lauthals.\n",
  "Krusty sagt: Komm ins Krustyland!\n",
  "Krusty zeigt Dir seinen dicken Bauch.\n",
  "Krusty sagt: Komm, gehn wir zu Moes's einen saufen.\n"}) );
  
  SetAttackChats(10, ({
  "Krusty schreit laut nach Bob!\n",
  "Krusty schreit: Aber mich lieben Doch alle!\n",
  "Krusty sagt: Hoer auf oder ich hole Pennywise.\n",
  "Dir tut Krusty auf einmal sehr leid.\n",
  "Krusty schaut Dich traurig an.\n"}));

   SUID;
   CLONEME("/d/dschungel/dante/tijaraneu/armour/shuw" );
   command("zieh alles an");  
  
  AddCmd(({"tritt","trete","kitzle","liebe","spucke","wuerge","umarme",
 "toete","kuesse"}),"lieb");
  
  } 

int lieb(string str)
{
  if( str && id(str) )
    call_out("fehler",0);
  return 0;
}

void fehler()
{
  write("Krusty sagt: Hey, das sag ich MOE!\n");
}
 
void init()
{
  ::init();
  if(interactive(TP)) call_out("hallo",0);
}

void hallo()
{
  command("emote grinst dumm und sagt: Hallo "+TP->name(RAW)+", ich bin Krusty.");
}
   
