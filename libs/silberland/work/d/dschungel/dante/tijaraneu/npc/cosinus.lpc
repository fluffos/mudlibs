// dante sl 99
/*
   cosinus der zaehlenkasper:-)

*/

inherit "std/npc";
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <npc.h>
#include <player.h>
#include <new_skills.h>
#include "/players/dante/myowndefine.h"
int x;


init(){
  ::init();
  if(interactive(TP)){
    call_out("tag", 1); 
  }
}

tag()  {
  if(environment(TO)!=environment(TP))  return ;
  if(deep_present("ZEC", TP))  {		
    write(BSA(
          "Hallo, "+TPN+"! Na was macht die Zolomjagd!!!",
          "Cosinus sagt: "));
  }  else  {
    x=1+random(1000000000);
    write(BSA(
          "Guten Tag, "+TPN+", welche Zahl hast Du am liebsten?! Die "+x+"?!",
          "Cosinus sagt: "));
  }
}

create()
{ 

  if (!is_clone(this_object())) return;

  ::create();

  SetProp (P_SHORT, "Der Zahlenmeister Cosinus");
  SetProp (P_LONG, BS (
        "Das ist Cosinus, der Zahlenmeister. Er verwaltet das Haus der Zahlen und "
        "zahlt Dir auch das Kopfgeld fuer die erschlagenen Zolome aus. Er ist ein "
        "kleiner Zwerg der sich den ganzen Tag nur mit Mathematik beschaeftigt und "
        "dann und wann etwas in seinen langen, grauen Bart murmelt."));
  SetProp (P_NAME, "Cosinus");
  SetProp(P_ARTICLE, 0);
  SetProp (P_GENDER, MALE);
  SP(P_RACE, "Zwerg");
  set_living_name("cosinus");
  AddId(({"NOCONTROL","NOWIMPY", "cosinus", "zahlenmeister"}));

  create_default_npc( 30 );
  SP(P_MAX_HP, 2000);
  SetProp(P_BODY, 140);
  SetProp(P_HANDS, ({" mit seinen kraeftigen Haenden", 200, DT_BLUDGEON}));

  SetProp(P_MSGIN,"kommt murmelnd herein");
  SetProp(P_MSGOUT,"geht murmelnd ");  
  SetProp(P_MMSGIN,"kommt murmelnd herein");
  SetProp(P_MMSGOUT,"laeuft ploetzlich davon");

  SetProp(P_MAX_HANDS, 2); 
  SetProp(P_ALIGN, 200);
  SetProp(P_SIZE, 120);
  SetProp(P_REJECT, ({REJECT_KEEP,
        "Cosinus sagt: Ich werde daraus Deinen IQ errechnen!? \n"}));
  SetProp (P_DIE_MSG," sagt: Gibt es im Himmel auch Zahlen?!\n"
      "Dann faellt er tot zu Boden!\n");

  SP(P_KILL_MSG, "Du hast eben keine Ahnung von Angriffsmathematik! HAHA!\n");
  SP(P_MURDER_MSG, "Danke %s, nun errechne ich die Anzahl aller Engel im Himmel!\n");
  SP(P_MSG_FLAGS, ([P_KILL_MSG: 1, P_MURDER_MSG:0]));

  SetChats(5, ({
        "Cosinus sagt: Ich kenne mehr Zahlen als ein Hobbit Haare hat!\n",
        "Cosinus sagt: Ich kenne einen Fossy-Baer, der viel Wurst isst!\n",
        "Cosinus sagt: Ich kenne eine Maus, die gerne Schokolade isst!\n",
        "Cosinus sagt: Ich kenne Honzo und Mausi!\n"
        "Cosinus sagt: Ich kenne mehr Zahlen als ein Fossy Biere trinken kann!\n",
        "Cosinus sagt: Ich kenne einen Honzo, der zu viel telefoniert!\n",
        "Cosinus sagt: Ich kenne den Wollmann!!!!!!!!!!!!\n",
        "Cosinus sagt: Toetet alle Zolome!\n"
        }) );

  SP(P_SPELLRATE, 50);
  SP(P_NOMAGIC, 15);

  AddSpell(3, 600, 
      "Cosinus bewirft Dich mit alten Zahlen.\n",
      "Cosinus bewirft @WEN mit alten Zahlen.\n",
      DT_POISON, ([SP_SHOW_DAMAGE:1]));
  AddSpell(5, 400,
      "Cosinus wirft Dir ein Buch an den Kopf. PLATSCH!\n",
      "Cosinus wirft @WEM ein Buch an den Kopf. PLATSCH!\n",
      DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));

  SUID;
  CLONEME("p/armour/gloves/lederhandschuhe");
  CLONEME("p/armour/cloak/schuerze");
  CLONEME("p/armour/armour/hemd");
  CLONEME("p/armour/boots/lederstiefel");
  command("ziehe alles an");

  AddInfo( DEFAULT_INFO, 
      ({
       "sagt: Zahlen sind besser!\n",
       "sagt: Zahlen sind wie Drachen!\n",
       "sagt: Frag doch nicht sowas dummes!\n",
       "sagt: Formeln habe ich auch sehr gerne!\n",
       "stopft sich nur eine Zahl in den Mund.\n",
       "sagt: Meine Formeln sind geheim!\n"
       }) );
  AI(({"zolom","zolome"}),
      "Zolome sind furchtbare Riesenwuermer die unter Tijara leben! Ab und an stuermen "
      "sie hervor und fressen die Plantagen leer.",
      "sagt: ");
  AI(({"kopfgeld","geld","praemie"}),
      "Momentan gibts es pro Zolom 100 Muenzen und dann, wenn man mehr Zolome erschlaegt "
      "auch eine Praemie. Wenn Du alle Zolome vernichtet hast, dann komm zu mir und "
      "tippe einfach 'kopfgeld'! Mach das aber nur, wenn Du bereits alle erschlagen hast, "
      "oder keine jungen Zolome mehr da sind oder Du einfach aufgibts. Wenn Du waehrend "
      "einer Plage mehrmals zu mir kommst und 'kopfgeld' tippst, wuerde Dein Ergebnis "
      "um vieles schlechter ausfallen als es der Realitaet entspricht!!!", 
      "sagt: ");
  AI(({"cosinus"}),
      "Das bin ich!",
      "sagt stolz: ");
  AI("tijara",
      "Da wohne ich!",
      "sagt: ");
  AI(({"lux","lichtfee"}),
      "Die wohnt auch in Tijara!",
      "sagt: ");
  AI(({"tithon"}),
      "Der wohnt gleich nebenan!", "sagt: ");
  AI("dschungel",
      "Der ist ganz nah von hier",
      "sagt: ");
  AI("silberland",
      "Viel zu wenig Zahlengibts hier!", "sagt: ");
  AI("dante",
      "Der wahre Herr des Dschungels!", "sagt: ");
  AI(({"zahlen","zahl","haus"}),
      "Hier ist das Haus der Zahlen. Hier sammeln wir viele Daten.",
      "sagt: ");
}

