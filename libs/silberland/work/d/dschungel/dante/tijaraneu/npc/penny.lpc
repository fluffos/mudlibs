// dante 2.april     @SilberLand
//dante 99 -97
inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <actions.h>
#include <new_skills.h>
#include "/players/dante/myowndefine.h"

void create()
{
   int i;
   
    
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Pennywise, der Clown");
  SetProp(P_LONG, BS(
  "Pennywise ist der boesartigste Clown dieser Welt. Ein blutgieriges Monster, "
  "immer auf der Lauer nach neuen Opfern. Er grinst Dich dreckig an und ist nur darauf "
  "aus Dich zu zerfetzten...")); 
    
  SetProp(P_NAME, "Pennywise");
  SetProp(P_GENDER, MALE);
  AddId(({"clown","penny","pennywise"}));
  set_living_name("pennywise");
  SetProp(P_RACE, "Mensch");
  create_default_npc(27);
  SetProp(P_HANDS, ({" mit seinen blutigen Handschuhen", 200,({DT_MAGIC,DT_TERROR}) }));
  SetProp(P_SIZE, 200+random(30));
  SetProp(P_ALIGN, -600);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE, 0.2);
  SetProp(P_WIMPY, 0);
  SetProp(P_RESISTANCE, ({ DT_TERROR,DT_UNHOLY })); 
  SetProp(P_VULNERABILITY, ({ DT_HOLY }));
  SetProp(P_NOMAGIC,10);
  SetProp(P_ARTICLE, 0);
  SetProp(P_MSGIN, "zaubert sich herein");
  SetProp(P_MSGOUT, "zaubert sich");
  SetProp(P_MMSGIN, "zaubert sich herein");
  SetProp(P_MMSGOUT, "zaubert sich davon");

  SetProp(P_DIE_MSG,  " lacht noch einmal laut auf und faellt dann tot um.\n");
  SetProp(P_NOCORPSE, 0 );
  
  SetProp(P_LOG_INFO, "dante/dclowns");
  AddInfo("dante", "Dante hat mich erschaffen.","sagt: ");
  AddInfo(DEFAULT_INFO, "grinst Dich nur dreckig an.\n");

  SetProp(P_SPELLRATE,70);
  
  SUID;
  CLONEME("/d/dschungel/dante/tijaraneu/armour/maske");
  //absichtlich nicht angezogen!!!


 AddSpell(1,500,
"Pennywise versucht Dir ein Auge auszureissen.\n",
"Pennywise versucht @WEM ein Auge auszureissen\n",
DT_TERROR, ([SP_SHOW_DAMAGE: 1]));

 AddSpell(1,500,
"Pennywise schlaegt seine Zaehne in Deinen Hals.\n",
"Pennywise schlaegt seine Zaehne in @WESSEN Hals.\n",
DT_RIP, ([SP_SHOW_DAMAGE: 1]));

 AddSpell(1,400,
  "Pennywise will Dir den Kopf abreissen.\n",
  "Pennywise will @WEM den Kopf abreissen.\n",
  DT_TERROR, ([SP_SHOW_DAMAGE: 1]));
    AddSpell(1,400,
"Pennywise wuergt Dich mit einer Stahlgirlande.\n",
"Pennywise wuergt @WEN mit einer Stahlgirlande.\n",
DT_SQUEEZE, ([SP_SHOW_DAMAGE: 1]));

    AddSpell(1,300,
    "Pennywise stopft Dir seine rote Clownnase in den Mund.\n",
    "Pennywise stopft @WEM seine rote Clownnase in den Mund.\n",
DT_TERROR, ([SP_SHOW_DAMAGE:1]));

AddSpell(1,1,
"Pennywise versucht Dich aus seinem Reich zu werfen.\n",
"Pennywise versucht @WEN aus seinem Reich zu werfen.\n",
DT_MAGIC, "spell_out");

AddSpell(3,1,
"Pennywise bekommt grossen Hunger...\n",
"Pennywise bekommt grossen Hunger...\n",
DT_MAGIC, "spell_eat");

AddSpell(1,1,
"Pennywise versucht sich mit Deiner Lebensenergie zu heilen.\n",
"Pennywise versucht sich mit @WESSEN Lebensenergie zu heilen.\n",
DT_MAGIC, "spell_life");

AddSpell(2,1,
"Pennywise schaut Dir tief in die Seele.\n",
"Pennywise schaut @WEM tief in die Seele.\n",
DT_MAGIC, "spell_end");


  SetChats(5, ({
  "Pennywise lacht nur ueber Dich.\n",
  "Pennywise grinst Dich boesartig an.\n",
  "Du bekommst grosse Angst vor Pennywise.\n",
  "Du faellst fast zu Boden.\n",
  "Pennywise macht einen Satz nach hinten.\n",
  "Pennywise schreit: Am liebsten esse ich Kinder.\n",
  "Die Clowns an der Wand scheinen zu leben.\n"}));

  SetAttackChats(5, ({
  "Pennywise lacht nur ueber Dich.\n",
  "Pennywise grinst Dich boesartig an.\n",
  "Du bekommst grosse Angst vor Pennywise.\n",
  "Du faellst fast zu Boden.\n",
  "Pennywise macht einen Satz nach hinten.\n",
  "Pennywise schreit: Am liebsten esse ich Kinder.\n",
  "Die Clowns an der Wand scheinen zu leben.\n"}));
  
for(i=0;i<random(8)+8;i++)
  CLONEME("/d/dschungel/dante/tijaraneu/obj/krapfen");
   
}

void init()
{
  ::init();
  if(interactive(TP)) call_out("hallo", 0);
}

 void spell_end(object enemy, int damage, mixed dam_type)
 {
 
  if ( enemy->QueryProp(P_HP)<100)
  {
   enemy->do_damage(70+random(10));
   tell_object(enemy,
   "Pennywise schlaegt Dir fast die Seele aus dem Leib!\n");
  } 
     if (enemy->QueryProp(P_HP)>100)
     {
     tell_object(enemy,
     "Pennywise grinst: Dir gehts noch viel zu gut !!!\n");
     enemy->AddPoison(1);
     tell_room(MENV,"Pennywise lacht giftig.\n", ({enemy}));   //hihi:)))
     }
     
    }
    

void hallo()
  {
  command("emote grinst und sagt: Hallo "+TP->name(RAW)+", Zeit zum Sterben!");
  }
  


void spell_out(object enemy, int damage, mixed dam_type)
{
switch(random(100))
{
case 0 .. 40:
  enemy->move("d/dschungel/dante/tijaraneu/room/clown", M_NO_SHOW + M_SILENT + M_GO);
  tell_object(enemy,
  "Pennywise schleudert Dich einfach aus dem Raum.\n");
  say("Pennywise schleudert seinen Gegner aus diesem Raum.\n");
  enemy->do_damage(5);
  break;

case 41 .. 64:
  enemy->move("d/dschungel/dante/tijaraneu/room/ti_pfad1", M_NO_SHOW + M_SILENT + M_GO);
  tell_object(enemy,
  "Pennywise schleudert Dich einfach aus seinem Reich.\n");
  say("Pennywise schleudert seinen Gegner aus seinem Reich.\n");
  enemy->do_damage(5);
  break;

case 65 .. 100:
    tell_object(enemy,
    "Pennywise schafft es nicht Dich aus seinem Raum hinauszuwerfen.\n");
    say("Pennywise schafft es nicht seinen Gegner aus seinem Reich zu werfen.\n");
    
   }
   
 }


 void spell_eat(object enemy, int damage, mixed dam_type)
  {

 if(QueryProp(P_HP)<500 && present("krapfen"))
 {
  command("iss krapfen");
  tell_room(MENV,
  "Pennywise verschlingt einen seiner Krapfen.\n");
 }

 if(QueryProp(P_HP)>500 && present("krapfen"))
{
tell_room(MENV,
"Pennywise lacht: Fuer Dich brauche ich doch meine Krapfen nicht!\n");
}

 if(QueryProp(P_HP)<500 && !present("krapfen"))
 
  {
   tell_room(TO,
   "Pennwise flucht: Verdammt, ich habe keine Krapfen mehr!\n");
  }


}



void spell_life(object enemy, int damage , mixed dam_type)
{
 switch(random(100))
  {
   case 0 .. 13:
       
      tell_object(enemy,
      "Pennywise schafft es nicht Dir Lebensenergie zu stehlen.\n");
     break;
     
   case 14 .. 25:
     enemy->reduce_hitpoints(15);
     heal_self(5);
     tell_object(enemy,
     "Pennywise saugt Dir ein wenig Lebensenergie ab und heilt sich damit.\n");
     break;
     
   case  26 .. 55:
      enemy->reduce_hitpoints(20);
      heal_self(10);
      tell_object(enemy,
      "Pennywise saugt Dir etwas Lebensenergie ab und heilt sich damit.\n");
     break;
     
   case 56 .. 73:
        enemy->reduce_hitpoints(30);
      heal_self(15);
      tell_object(enemy,
      "Pennywise saugt Dir viel Lebensenergie ab und heilt sich damit.\n");
      break;
      
   case 74 .. 89:  
      enemy->reduce_hitpoints(40);
      heal_self(20);
      tell_object(enemy,
      "Pennywise saugt Dir sehr viel Lebensenergie ab und heilt sich damit.\n");
     break;
     
   case 90 .. 100:   
      enemy->reduce_hitpoints(50);
      heal_self(30);
      tell_object(enemy,
      "Pennywise saugt Dir enorm viel Lebensenergie ab und heilt sich damit.\n");
     break;
        
    }
 }
     

 void die(int poisondeath) {
   object ob;
   
   while(ob=present("krapfen 4",this_object()))
     ob->remove();
   ::die(poisondeath);
 }
 
