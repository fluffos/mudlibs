/* das tijara zoelom
   aus dem Spiel FF7
   original is es natuerlichz das midgar zoelom
   by dante 2000 sl


dante: xps herabgesetzt, gems reduziert, mithrilzeugs stark reduziert

feyaria: xp geaendert, 

dante: xps weiter runter egsetzt, dafuer die killer spells leicht runter

feyaria: indented, jetzt ist das file auch lesbar, 
sachen aus /p/armour/<armoutyp>/ clonen
feinabstimmung der spells

 */
inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "/players/dante/myowndefine.h"
#include <mnpc.h>
#include <wizlevels.h>

int level;
object cash;
string was;
int lang;
int z=random(7);

void create()
{
  if (!is_clone(this_object())) return;
  ::create();
}

void init() {
  object riese;
  ::init();
  riese=present("riese", environment(TO));

  if( interactive(TP) ) {
    call_out("hallo", 1);
  }

  if( riese ) {
    Kill(riese);
    write(BS(
          "Das Zolom greift den Riesen an.")
         );
  }
}

void hallo() {
  if(environment(TO)!=environment(TP)) {return; }


  if(getuid(TP)=="roc")  {
    write(BSA(
          "Roc! Du Furzkopf!!!!!!",
          "Das Zolom spuckt Roc an: ")
         );
  }

  if(!random(10)) {
    write(BS( 
          "Das Zolom knurrt irgendwas mit Verfluchtsei"+getuid(TP)+"verdammt..."
            ));
  }
}

string level_string(int level)
{
  string was;
  switch(level)  {

    case 1: 
      was="sehr klein";
      break; 

    case 2: 
      was="klein";
      break; 

    case 3: 
      was="mittelgross";
      break; 

    case 4: 
      was="gross";
      break; 

    case 5: 
      was="sehr gross";
      break; 

    case 6: 
      was="extrem gross";
      break; 

    case 7: 
      was="gigantisch";
      break; 

    case 8: 
      was="bombastisch";
      break; 

    case 9: 
      was="ultimativ";
      break; 

    case 10: 
      was="dantinisch";
      break; 

    case 11:
      was="uralt";
      //          level=16;
      break;

    default: was ="gross";
  }
  return was;
}

void create_std_zolom(int _level) {
  if(_level<1 || _level>11 ) {
    level=1+random(11); 
  }
  else
    level = _level;

  was = level_string(level);
  lang=level+7+level/2;

  SetProp(P_SHORT, "Ein "+was+"es Tijara-Zolom");
  SetProp(P_LONG, BS(
        "Das Zolom ist ein Riesenwurm, der an seinem vorderen Ende einen grossen, "
        "scharfen Schnabel hat, eine Art Schnabelmaul. In diesem Maul "
        "hat es grosse, scharfe Zaehne. Mit diesen kann er seinen "
        "Gegnern muehelos Arme und Beine ausreissen und sie so zerfetzen. Es gibt verschiedenste "
        "Zolome in dieser Welt. Dieses hier ist ein "+was+"es Zolom. Sei auf der Hut vor ihm! "
        "Es ist ungefaehr "+lang+" Meter lang!")
         );

  SetProp(P_AGGRESSIVE, 0.08+level*0.01);

  SetProp(P_RESISTANCE_STRENGTHS,([DT_HOLY: 0.3, DT_TERROR:-0.5, DT_BLUDGEON:0.3,
        DT_FIRE:-0.3, DT_WATER:-0.5, DT_ACID:-0.9, DT_COLD:0.3, DT_SLASH:0.3])
         );

  SetProp(P_NAME, "Zolom");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_NAME_ADJ, ""+was+"");
  set_living_name("zolom");
  AddId(({"tijarazolom","tijara-zolom", "wurm", "zolom","NOWIMPY"}));
  AddAdjective( ({was, was+"es", was+"em", was+"en"}) );

  create_default_npc( 11+level*4 ); 
  SetProp(P_HANDS, ({" mit seinem schrecklichen Schnabelmaul", 250+level*20, ({DT_RIP,DT_PIERCE})}));
  SetProp(P_XP, QueryProp(P_XP)+level*2345 ); // Feyaria

  SetProp(P_RACE, "Wurm");
  SetProp(P_SIZE, lang*100);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 8);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0, T_RANGE_MAX:50]));

  SetProp(P_MSGIN, "kriecht schmatzend herein");
  SetProp(P_MSGOUT, "kriecht schmatzend");
  SetProp(P_MMSGIN, "kriecht laut bruellend herein");
  SetProp(P_MMSGOUT, "verschwindet irgendwohin");

  SetProp(P_MNPC_AREA, ("/d/dschungel/dante/tijaraneu/room/z"));
  SetProp(P_MNPC_WAIT, ({50, 50, 50}));
  SetProp(P_MNPC_DEFAULTROOM, "/d/dschungel/dante/tijaraneu/room/z"+z+"");
  SetProp(P_MNPC_FLAGS,MOV_MOVES+MOV_BACKWARDS+MOV_INDOORS+MOV_SPECIAL);

  SetProp(P_HEAL, 5+level*3);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_NOMAGIC, level);
  SetProp(P_DIE_MSG,  " bruellt noch einmal laut auf und verendet.\n");
  SetProp(P_DEFAULT_INFO, "faucht Dich nur an.\n");
  SetProp(P_REJECT, ({ REJECT_DROP,
        "Das Zolom braucht Deine Sachen nicht.\n" }) 
         );

  SetProp(P_MURDER_MSG, "Mein grosser Bruder, das "+level_string(level+1)+
      "e Zolom, wird mich raechen, %s!!!\n");
  SetProp(P_KILL_NAME, "Ein "+was+"es Zolom");
  SetProp(P_KILL_MSG, "Deine Leiche wird mir schmecken!!!\n");
  SetProp(P_MSG_FLAGS, ([P_KILL_MSG:0, P_MURDER_MSG:0 ]));

  SetProp(P_SPELLRATE, 20+level*3);
  AddSpell(5, 300+level*30,
      "Das Zolom zerfleischt Deinen Koerper beinahe.\n",
      "Das Zolom zerfleischt @WESSEN Koerper beinahe.\n",
      DT_RIP, ([SP_SHOW_DAMAGE:1]));
  AddSpell(1, 500+level*70,
      "Das Zolom springt Dich an, reisst Dich zu Boden.\n",
      "Das Zolom springt und reisst @WEN zu Boden.\n",
      DT_RIP, ([SP_SHOW_DAMAGE:1]));
  AddSpell(4, 250+level*50,
      "Das Zolom zerfetzt Deine Beine zu blutigen Klumpen.\n",
      "Das Zolom zerfetzt @WESSEN Beine zu blutigen Klumpen.\n",
      DT_RIP, ([SP_SHOW_DAMAGE:1]));
  AddSpell(4, 350+level*40,
      "Das Zolom attackiert Dich mit messerscharfen Zaehnen.\n",
      "Das Zolom attackiert Dich mit messerscharfen Zaehnen.\n",
      DT_RIP, ([SP_SHOW_DAMAGE:1]));
  AddSpell(2, 550+level*50,
      "Das Zolom schlaegt Dir einen Zahn ins Gesicht.\n",
      "Das Zolom schlaegt @WEM einen Zahn ins Gesicht.\n",
      DT_PIERCE, ([SP_SHOW_DAMAGE:1]));
  AddSpell(5, 200+level*45,
      "Das Zolom faucht Dich furchtbar an.\n",
      "Das Zolom faucht @WEN furchtbar an.\n",
      DT_TERROR, ([SP_SHOW_DAMAGE:1]));

  SetChats(4, ({
        "Das Zolom faucht Dich an.\n",
        "Du bestaunst beeindruckt das Zolom.\n",
        "Das Zolom schaut Dich mit seinen leuchtenden Wurmaugen an.\n",
        "Das Zolom zeigt seine gewaltigen Reisszaehne.\n",
        "Das Zolom kriecht um Dich herum.\n",
        "Das Zolom macht sich zum Angriff bereit.\n",
        "Das Zolom bruellt laut.\n",
        "Du weichst erschrocken vor dem Zolom zurueck.\n",
        "Das Zolom knurrt leise.\n",
        "Das Zolom fletscht seine Zaehne.\n"}) );
  SetAttackChats(9, ({
        "Das Zolom bruellt laut.\n",
        "Das Zolom versucht Dich zu zerfleischen.\n",
        "Das Zolom attackiert Dich von hinten.\n",
        "Das Zolom bohrt seine Zaehne in Deinen Leib.\n",
        "Das Zolom fletscht seine Zaehne.\n"}) );

  SUID;
  switch(random(4)) {
    case 0: 
      "obj/gemmaster"->DistributeGem(level/2, 3,1, 1);
      break;

    case 1:
      if(level>8) {
        if(!random(5)) 
          CLONEME("p/weapon/club/kriegshammer");
        else if(!random(15)) 
          CLONEME("p/weapon/axe/streitaxt");
        else
          "obj/gemmaster"->DistributeGem(level/2, 1,1, 1);
      }
      if(level>6) {
        "obj/gemmaster"->DistributeGem(1, 3,1, 1);
      } 
      if(level>6) {
        if(!random(10)) CLONEME("p/armour/helm/mithrilhelm");  
      }
      if(level>7) {     
        if(!random(10)) CLONEME("p/armour/shield/mithrilschild");
      } 
      if(level>8) {    
        if(!random(10)) CLONEME("p/armour/bracers/mithrilarmschienen"); 
      }
      if(level>9) { 
        if(!random(10)) CLONEME("p/armour/armour/mithrilpanzer");
      } 
      break;

    case 2:
      cash=clone_object("obj/money");
      cash->move(TO, M_NOCHECK);
      cash->SetProp(P_AMOUNT, level*234+random(1000));
      //nun mehr als halbiert
      break;

    case 3:
      "obj/pearlmaster"->DistributePearl(level/2, 3,1, 1);
      break;

    default:
  } 
}

void die(int poisondeath) {
  write_file("/d/dschungel/dante/tijaraneu/log/zolom",
      ctime()+": "+CAP(getuid(TP))+" killt ein "+was+"es Zolom.\n"
            );
  if(query_once_interactive(TP) && !IS_LEARNER(TP) && !TP->QueryProp(P_TESTPLAYER))
    call_other("/d/dschungel/dante/tijaraneu/obj/zolom_master",
        "AddKill", getuid(TP), level);
  ::die(poisondeath);
}


void NotifyPlayerDeath(object player, object killer, int lostexp) {
  write_file("/d/dschungel/dante/tijaraneu/log/zolom",
      ctime()+": "+CAP(getuid(player))+" wird gekillt von einem "+was+"es Zolom.\n"
            );
  call_other("/d/dschungel/dante/tijaraneu/obj/zolom_master",
      "AddDeath", getuid(TP), level);
  NAL1
}
NAL2


int _query_wimpy() {
  return 0;  
}


int Defend(int dam, mixed dtype, mixed spell, object enemy) {
  if(enemy->id("riese") ){
    return ::Defend(0, dtype, spell, enemy);      }
  else if( interactive(enemy)) 
    SetProp( P_PREFERED_ENEMY, ({80,enemy}));
  if(!random(50-level)) {
    tell_object(enemy,
        "Das Zolom lenkt Deinen Angriff auf Dich um!\n"
               );
    enemy->Defend(2*dam/2, dtype, ([SP_SHOW_DAMAGE:1]), TO);
    return ::Defend(dam/3, dtype, spell, enemy);
  }
  return ::Defend(dam, dtype, spell, enemy);
}
