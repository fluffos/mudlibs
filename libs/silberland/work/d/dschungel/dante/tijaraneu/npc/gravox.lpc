//2. release, graviert nun texte und ids! dante 2002 jaenner

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <npc.h>
#include <player.h>
#include <new_skills.h>
#include "/players/dante/myowndefine.h"
#define PREIS 15

string text;
int busy=0;
string kunde="";
string oldwas="";
string *verboten;
int x;
 
void init()
{
  ::init();
  if(interactive(TP))
  {
    call_out("tag", 1); 
  }
}

void tag()  
{
  if(environment(TO)!=environment(TP))  return ;
  write(BSA(
        "Guten Tag, "+TPN+", wieder was zum gravieren?!",
        "Kratz Gravox: "));
}

void create()
{ 

  if (!is_clone(this_object())) return;

  ::create();

  SetProp (P_SHORT, "Der Graveur Kratz Gravox");

  SetProp (P_LONG, 
        "Das ist Kratz Gravox, der Graveur von Tijara. Er ist ein eigentlich ein "
        "sehr geschickter Schmied, hat sich aber auf Gravuren spezialisiert. "
        "Er kann Deinen Namen oder jeden beliebigen anderen Text in Waffen, "
        "Ruestungen und andere Sachen eingravieren. Du kannst so zum Beispiel "
        "Widmungen, Racheschwuere oder Liebeserklaerungen in "
        "den Gegenstand Deiner Wahl eingravieren lassen! "
        "Frag ihn am besten nach Gravur.");

  SetProp(P_NAME, "Gravox");
  SetProp(P_ARTICLE, 0);
  SetProp(P_GENDER, MALE);
  AddId(({"kratz","gravox", "NOWIMPY"}));

  AddInfo(({"gravur","gravieren","graveur","gravier","hilfe"}),
      "Ich kann Dir jeden Text auf Dinge gravieren, sodass Du, sollte "
      "Dir etwas gestohlen werden, beweisen kannst, dass es Dir gehoert. "
      "Du kannst das natuerlich auch als Verzierung sehen oder als persoenliche "
      "Note Deiner Sachen oder als Widmung, wie immer Du eben willst."
      " Das sieht dann zum Beispiel so aus: "
      "Ein Langschwert (graviert). Und natuerlich kannst Du Deine Gravur "
      "untersuchen mit <untersuche gravur>. Dort sieht man dann den Text."
      " Gravieren kostet bisschen Geld, nicht viel, haengt von der Laenge des Textes ab, "
      "und dauert einige Sekunden. Sollte Dir irgendwie ein graviertes Objekt "
      "abhanden gekommen sein, so kann ich es suchen. Sollte es einer der anwesenden "
      "Spieler haben, werde ich es finden und Dir sagen. <gravursuche>."
      , "sagt: ");

  AddInfo( DEFAULT_INFO, 
      ({
       "Gravox sagt: Ich graviere gerne!\n",
       "Gravox dreht sich schulterzuckend um!\n",
       "Gravox sagt: Hmm, gute Frage.\n",
       }) );

  AddInfo("tijara",
      "Da wohne ich!",
      "sagt: ");
  AddInfo(({"lux","lichtfee"}),
      "Die wohnt auch in Tijara!",
      "sagt: ");
  AddInfo(({"tithonos"}),
      "Der wohnt gleich nebenan!", "sagt: ");
  AddInfo("dschungel",
      "Der ist ganz nah von hier.",
      "sagt: ");
  AddInfo("silberland",
      "Viel zu wenig Zwerge gibts hier!", "sagt: ");
  AddInfo("dante",
      "Der wahre Herr des Dschungels!", "sagt: ");


  create_default_npc( 25 );

  SetProp(P_BODY, 80);
  SetProp(P_HANDS, ({" mit seinen kraeftigen, Haenden", 200, DT_BLUDGEON}));

  SetProp(P_MSGIN,"kommt singend herein");
  SetProp(P_MSGOUT,"geht pfeifend");  
  SetProp(P_MMSGIN,"kommt singend herein");
  SetProp(P_MMSGOUT,"geht weit davon");

  SetProp(P_MAX_HANDS, 2); 
  SetProp(P_ALIGN, 200);
  SetProp(P_RACE, "Zwerg");
  SetProp(P_SIZE, 130);
  SetProp(P_REJECT, ({REJECT_GIVE,
        "Kratz Gravox sagt: Frag mich lieber nach Gravur!? \n"}));
  SetProp (P_DIE_MSG," bricht tot zusammen.\n");

  SetProp(P_KILL_MSG, "Dich habe ich zu Tode graviert!\n");
  SetProp(P_MURDER_MSG, "Danke %s, im Himmel gibt es sowieso schoenere Gravuren!\n");
  SetProp(P_MSG_FLAGS, ([P_KILL_MSG: 0, P_MURDER_MSG:0]));


  SetChats(5, ({
        "Gravox poliert sein Graviermesser.\n"
        "Gravox graviert schnell ein Schwert.\n",
        "Gravox sagt: Los! Gib mir etwas zum gravieren.\n",
        "Gravox sagt: Schoenes Wetter heute.\n",
        "Gravox murmelt etwas unverstaendliches.\n",
        "Gravox scheint zu schielen.\n"
        }) );

  SetProp(P_SPELLRATE, 50);
  SetProp(P_NOMAGIC, 0);

  AddSpell(3, 300,
      "Gravox versucht Dich mit seinem Graviermesser aufzuschlitzen.\n",
      "Gravox versucht @WEN mit seinem Graviermesser aufzuschlitzen.\n",
      DT_RIP, ([SP_SHOW_DAMAGE:1]));

  AddSpell(5, 300,
      "Gravox versucht Dich mit seinem Graviermesser zu stechen!\n",
      "Gravox versucht @WEN mit seinem Graviermesser zu stechen!\n",
      DT_PIERCE, ([SP_SHOW_DAMAGE:1]));

  SUID;

  CLONEME("p/armour/gloves/lederhandschuhe");
  CLONEME("p/armour/cloak/schuerze");
  CLONEME("p/armour/armour/hemd");
  CLONEME("p/armour/boots/lederstiefel");
  command("ziehe alles an");

  CLONEME("/d/dschungel/dante/tijaraneu/weapon/grvmesser");
  command("zuecke messer");

  AddCmd(({"graviere","gravier","gravur"}), "gravieren");

  AddCmd(({"gravursuche"}), "find_gravur");

  verboten=({
      "/p/service/obj/zeitung/slp",
      "/p/service/woody/obj/fband2",
      "/d/dschungel/dante/tijaraneu/ascii/t.a",
      "/gilden/paladine/armour/wappenrock",
      "/gilden/berserker/obj/stirnband",
      "/gilden/zechpreller/obj/z_17erschluessel",
      "/gilden/druidenzirkel/armour/a_amulett",
      "/obj/teddy"});
}

void write_found(object ob, string wer)
{
  write(BSA( wer+" hat "+ob->name(WEN)+" von Dir.", "Gravox sagt: "));
  x++;
  if(getuid(TP)==wer) 
    write(BSA(
          "Aber da ja Du wer bist, denke ich, das geht in Ordnung.",
          "Gravox sagt grinsend: "));
}

varargs int find_gravur(string str, int i)  
{
  object *pls;
  object ob;

  if (!i)
    i = x = 0;
    
  NF("Gravox sagt: Was finden ?!?!\n");

  if(TP->QueryMoney() < PREIS*15 )  
  {
    write(BSA(
          "Das kostet aber "+PREIS*15+" Muenzen!",
          "Gravox sagt: "));
    return 1; 
  }
  pls=users();

  if (!i)
    write(BS( "Du bezahlst "+PREIS*15+" Muenzen an Gravox."));

  if(!sizeof(pls))  
    return 1; 

  for(i; i<sizeof(pls); i++)  
  {
    if( (pls[i])->QP(P_INVIS)==0 )  
    {
      if (get_eval_cost() < 100000)
      {
        call_out("find_gravur", 2, str, i);
        return 1;
      }
      filter_array(filter_objects(all_inventory(pls[i]), "id", 
            "\n"+CAP(getuid(TP))+"_GRAVUR"), #'write_found, CAP(getuid(pls[i])) );
    }
  }
  if(x==0)  
  {
    write(BSA("Keiner der Anwesenden hat ein graviertes Objekt von Dir.",
          "Gravox sagt: "));
  }   

  return 1;  
}
 
 

//***********************************************************************
int gravieren(string str)  
{
  object was;
  string was1;
  int preis;
  string oldshort;

  NF("Gravox sagt: Was soll ich gravieren?!\n"
      "Gravox sagt: 'graviere text auf z.b langschwert'\n");

  if(!str) 
    return 0;

  if(busy!=0)  {
    write(BSA(
          "Sorry, "+TPN+" ich arbeite gerade an "+oldwas+" "
          "fuer "+kunde+"!",
          "Gravox sagt: "));
    return 1;
  }

  str=this_player()->_unparsed_args();

  if(sscanf(str, "%s auf %s", text, was1)!=2) 
    return 0;

  was=present(was1, TP);
  if(!was)  
  {
    write(BSA(
          "Aber "+TPN+", Du hast '"+was1+"' gar nicht!",
          "Kratz Gravox sagt: "));
    return 1; 
  }
  if(InFight(TO))  
  {
    write(BSA(
          "Sorry, "+TPN+" aber ich muss kaempfen!",
          "Gravox sagt: "));
    return 1;
  }		
  if (was->QP(P_NODROP)) 
  {
    write(BSA("Aber "+TPN+", Du darfst "+was->name(WEN)+" doch gar nicht " +
          "weggeben!",
          "Kratz Gravox sagt: "));
    return 1;
  }
  if (was->QP(P_NEVERDROP)) 
  {
    write(BSA("Aber "+TPN+", Du darfst "+was->name(WEN)+" doch gar nicht " +
          "weggeben!",
          "Kratz Gravox sagt: "));
    return 1; 
  }
  if (was->QP(P_CURSED)) 
  {
    write(BSA("Nein, "+was->name(WER)+" ist ja verflucht! Nein,"+TPN+", " 
          ""+was->QueryArticle(WEN, 1, 1)+" fasse ich nicht an!",
          "Kratz Gravox sagt: "));
    return 1;
  }		
  if(member_array(file_name(was), verboten)!=-1)  
  {

    write(BSA("Tut mir leid, "+was->name(WER)+" ist leider verboten! Nein, "+TPN+", " 
          "Das graviere ich nicht!",
          "Kratz Gravox sagt: "));
    return 1;
  }		
  if(was->id()=="DANTE_GRAVUR" ||
      strstr(was->QP(P_SHORT) ,"(graviert)")!=-1 ) 
  {
    write(BSA(
          "Sorry "+TPN+", "
          ""+was->name(WEN)+" habe ich schon einmal graviert!",
          "Kratz Gravox sagt: "));
    return 1; 
  }
  if( was->IsUnit() || !was->QP(P_SHORT) || was->QP(P_SHORT)==0 ||
      was->QP(P_INVIS))  
  {
    write(BSA(
          "Sorry "+TPN+", Dante hat mir verboten "
          ""+was->name(WEN)+" zu gravieren!",
          "Kratz Gravox sagt: "));
    return 1; 
  }
  if(strlen(text) > 400)  
  {   	
    write(BSA(
          "Sorry "+TPN+", dieser Text ist zu lange!",
          "Kratz Gravox sagt: "));
    return 1; 
  }

  preis=was->QP(P_VALUE)/PREIS+strlen(text)*5;
  if(preis <= 200 ) 
    preis=200+random(100);

  if(TP->QueryMoney() < preis )  
  {
    write(BSA(
          "Sorry "+TPN+", Du hast zu wenig Geld! "
          "Das Gravieren von "+was->name(WEN)+" "
          "wuerde Dich "+preis+" Muenzen kosten!",
          "Kratz Gravox sagt: "));
    return 1; 
  }
  kunde=CAP(getuid(TP));
  busy=1;
  oldwas=was->name(WEM);

  was->move(TO, M_NOCHECK);

  write(BS(
        "Gravox nimmt Dir schnell "+was->name(WEN)+" weg."));

  tell_room(environment(TO),
      "Gravox nimmt "+TP->name(WEM)+" schnell "+was->name(WEN)+" weg "
      "und beginnt zu gravieren...\n", ({TP}));

  write(BSA(
        "Nun gut "+TPN+", ich will Dir "+was->name(WEN)+" gravieren! "
        "Das kostet Dich "+preis+" Muenzen!", "Gravox sagt: "));

  write(BS(
        "Du gibst Gravox "+preis+" Muenzen. Er steckt sie schnell ein!"));

  call_out("gravur1", 6, was);
  TP->AddMoney(-preis);
  return 1; 
}

void gravur1(object was)  
{
  if(environment(TP)!=environment(TO) )  
  {
    if(TP) 
    {
      tell_object(TP,
          "Gravox teilt Dir mit: Komm zurueck "+TPN+"!\n");
    }
  }
  tell_room(environment(TO),
      "Gravox haemmert kratzt und ritzt auf "+was->name(WEM)+" herum.\n");
  call_out("gravur2", 5, was);
}


void gravur2(object was)  
{
  if(environment(TP)!=environment(TO) )  
  {
    if(TP) 
    {
      tell_object(TP,
          "Gravox teilt Dir mit: Komm zurueck "+TPN+"!\n");
    }
  }
  tell_room(environment(TO),
      "Gravox kratzt nun feine Linien in "+was->name(WEN)+".\n");
  call_out("gravur3", 5, was);
}

int gravur3(object was)  
{
  string oldshort;
  kunde="";
  busy=0;
  if(environment(TP)!=environment(TO) )  
  {
    if(TP) 
    {
      tell_object(TP,BSA(
            "Tja, Pech gehabt! Ich behalte nun das "
            "Geld und "+was->name(WEN)+"!",
            "Gravox teilt Dir mit: "));
      return 1;
    }
  }
  tell_room(environment(TO),
      "Gravox gibt "+TP->name(WEM)+" "+was->name(WEN)+" zurueck.\n");
  oldshort=was->QP(P_SHORT);

  was->SP(P_SHORT, oldshort+" (graviert)");
  was->AddId("DANTE_GRAVUR");
  was->AddId("\n"+CAP(getuid(TP))+"_GRAVUR");

  was->AddDetail("gravur",BS(
        text));

  write_file("/d/dschungel/dante/weg/log/gravox",
      ctime()+": Kunde: "+CAP(getuid(TP))+" Obj: "+was->name(WER)+" \n"+text+"\n");

  was->move(TP, M_NOCHECK);

  write(
      "\nGravox gibt Dir "+was->name(WEN)+" graviert zurueck. Das ging ja schnell.\n");
  write(BSA(
        "Hier hast Du "+TPN+"! Fertig!",
        "Gravox sagt: "));
  return 1;
} 

