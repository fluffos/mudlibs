// npc fuer zolomevent

inherit "std/mnpc";
#include "/players/dante/myowndefine.h"
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <mnpc.h>

int lang=random(30)+50;
int ort=1+random(12);

void create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein kleines, junges Zolom");
  SetProp(P_LONG, BS (
        "Vor Dir siehst Du ein kleines, noch sehr junges Zolom. Zolome sind eigentlich "
        "Riesenwuermer die angeblich ueber 30 Meter lange werden koennen. Dieses hier "
        "ist aber nur "+lang+" Zentimeter gross und stellt keine echte Gefahr fuer "
        "Dich dar. Wohl aber fuer die Plantage von Tijara, denn kleine Zolome "
        "ernaehren sich am liebsten von Obst und Gemuese. Vernichte also alle, die "
        "Du nur finden kannst. Cosinus wird Dich sicher dafuer "
        "belohnen."));

  SetProp(P_NAME, "Zolom");
  SP(P_NAME_ADJ, ({"klein","jung"}));

  SetProp(P_GENDER, NEUTER);
  AddId( ("zolom") );
  AddId("wurm");
  AddId("event_zolom");
  set_living_name("event_zolom");
  enable_commands();

  SP(P_XP, 10);
  SP(P_MURDER_MSG, 0);

  create_default_npc(4);
  SetProp(P_HANDS, ({" mit seinem kleinen Schnabel", 50, DT_RIP}));
  SetProp(P_BODY,40);
  SetProp(P_MAX_HP, 80);
  SetProp(P_RACE, "Wurm");
  SetProp(P_SIZE, 20+random(30) );
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 8);
  AddInfo(DEFAULT_INFO, " schaut Dich nur stumm an.\n");
  SetProp(P_REJECT, ({ REJECT_DROP, 
        "Das Zolom will Deine Sachen nicht.\n"}));
  SetProp(P_DIE_MSG, " bricht quiekend zusammen.\n");
  SetProp(P_HEAL, 1);
  SetProp(P_NOMAGIC, 0);

  SetProp(P_MSGIN, "kriecht kreischend herein");
  SetProp(P_MSGOUT, "kriecht kreischend");
  SetProp(P_MMSGIN, "kriecht kreischend hierher");
  SetProp(P_MMSGOUT, "springt weit davon");

  SetProp(P_MNPC_AREA, ("/d/dschungel/dante/weg/room/planta"));
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES+MOV_BACKWARDS+MOV_INFIGHT );
  SetProp(P_MNPC_WAIT, ({3, 1, 7}));
  SetProp(P_MNPC_DEFAULTROOM, "/d/dschungel/dante/weg/room/planta"+ort+"");   

  SetChats(1, ({
        "Das junge Zolom sieht sehr hungrig aus.\n",
        "Das junge Zolom kreischt laut.\n",
        "Das junge Zolom will die Plantagen leer fressen.\n",
        "Das junge Zolom giert nach Obst.\n",
        "Das junge Zolom ist sehr hungrig.\n",
        "Das junge Zolom will endlich Obst fressen.\n",
        "Das junge Zolom reisst seinen kleinen Schnabel weit auf.\n"}));

}

void die(int arg) 
{
  object ob, da;

  if (!TP || !interactive(TP)) return;
  da=deep_present("zolom_event_counter", TP);
  if(!da)  
  {
    ob=clone_object("/d/dschungel/dante/tijaraneu/obj/zolom_ev_obj");
    ob->move(TP, M_NOCHECK);	
    write("Du toetest bei dieser Zolomplage Dein erstes junges Zolom!!!\n");
  }
  if(da)  
  {      
    da->zolom_kills();
  }	
  ::die(arg);
}

void reset()  
{
  ::reset();
  if(!is_clone(TO))  { return;  }
  deep_remove();
}	

