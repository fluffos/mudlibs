// dante@SilberLand

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "/players/dante/myowndefine.h"
#include <npc.h>

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Enrico, der Clown");
  SetProp(P_LONG, BS(
    "Sicher hast Du frueher und auch manchmal heute noch den Clown Enrico "
    "bewundert. Wenn er Dir gleich auf die Nerven geht wie mir, leg ihn um. "
    "Sein bloedes Grinsen, sein Gehopse und seine dummen, ueberhaupt nicht "
    "witzigen Sprueche nerven Dich ja auch, oder ? Also zoegere nicht..."));
  SetProp(P_NAME, "Enrico");
  SetProp(P_GENDER, MALE);
  AddId(({"enrico", "clown"}));
  SetProp(P_ARTICLE, 0);
  create_default_npc(17);
  SetProp(P_HANDS, ({" mit seinem dummen Grinsen",200,({DT_POISON,DT_TERROR})}));
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 170);
  SetProp(P_ALIGN, 200);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 10);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 100+random(100));
  SetProp(P_RESISTANCE, ({ DT_TERROR })); 
  SetProp(P_NOMAGIC,3);

  SetProp(P_MSGIN, "schlurft dumm grinsend herein");
  SetProp(P_MSGOUT, "schlurft dumm grinsend");
  SetProp(P_MMSGIN, "schlurft dumm grinsend herein");
  SetProp(P_MMSGOUT, "verzieht sich endlich wieder");
  
  SetProp(P_DIE_MSG,  " grinst bloed und faellt tot um.\n");
  SetProp(P_NOCORPSE, 0 );

  SetProp(P_LOG_INFO, "dante/dclowns");
  AddInfo(DEFAULT_INFO, "grinst Dich nur bloed an.\n");
  AddInfo("dante", "Dante ist auch so ein Clown.","sagt: ");
  AddInfo("wuschel", "UI! Die hat eine lustige Nase!", "sagt: ");
  AddInfo( ({"clown", "enrico"}), "Ja, ich bin Enrico, der Clown!", "sagt: ");
  SetProp( P_REJECT, ({ REJECT_KEEP,
    "Enrico sagt: Danke, Du Clown.\n" }) );

  SetProp(P_SPELLRATE,99);
  
  AddSpell(3,250,
    "Enrico bombardiert Dich mit dummen Spruechen.\n",
    "Enrico bombardiert @WEN mit dummen Spruechen.\n",
     DT_TERROR,([SP_SHOW_DAMAGE:1]));
 AddSpell(3,300,
    "Enrico schlaegt Dir seinen Zylinder auf den Kopf.\n",
    "Enrico schlaegt @WEM seinen Zylinder auf den Kopf.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));
 AddSpell(3,200,
    "Enrico spritzt Wasser aus seiner Blume auf Dich.\n",
    "Enrico spritzt Wasser aus seiner Blume auf @WEN.\n",
     DT_WATER,([SP_SHOW_DAMAGE:1]));
 AddSpell(3,250,
    "Enrico laesst Dich ueber seine langen Schuhe stolpern.\n",
    "Enrico laesst @WEN ueber seine langen Schuhe stolpern.\n",
     DT_TERROR,([SP_SHOW_DAMAGE:1]));


  SetChats(10, ({
  "Enrico huepft um Dich herum.\n",
  "Enrico stammelt bloedes Zeug.\n",
  "Du wuerdest Enrico gerne treten.\n",
  "Wut steigt hoch in Dir ueber diesen doofen Clown.\n",
  "Du denkst . o O (Tod fuer Enrico!)\n",
  "Enrico stolpert ueber seine Schuhe.\n",
  "Enrico drueckt auf seiner Nase herum.\n",
  "Enrico grinst extrem dumm.\n"}) );
  
  SetAttackChats(10, ({
  "Enrico schreit: Wo ist meine AmDamDes-Tante !\n",
  "Du steigerst Dich in einen Blutrausch.\n",
  "Enrico sagt: Hoer auf Du Schurke.\n",
  "Enrico grinst noch immer dumm.\n",
  "Enrico macht sich in die Hosen.\n",
  "Enrico sagt: Das ist aber nicht mehr lustig.\n"}) );

  SUID;
  CLONEME("/d/dschungel/dante/tijaraneu/armour/button" );
  
  
  AddCmd(({"tritt","trete","kitzle","liebe","spucke","wuerge","umarme",
 "toete","kuesse"}),"lieb");
  
  } 

int lieb(string str)
{
  if( str && id(str))
    call_out("lieb2",0);
}

void lieb2()
{
  write("Enrico sagt: Danke, ganz lieb!\n");
}
 
void init()
{
  ::init();
  if(interactive(TP)) call_out("hallo",0);
}

void hallo()
{
  command("emote grinst dumm und sagt: Hallo "+ TP->name(RAW) +
          ", ich bin der lustige Clown Enrico.");
}
   
