{
  write("Kerak sagt: Die Topliste der besten "+zolomnamen[1]+"en Zolomtoeter\n");
  write(break_string( call_other(OBJ "zolom_master", "TopList", 1, 1), 78,
        "Kerak sagt: ", BS_LEAVE_MY_LFS));
