//dante
//
// feyaria: haut jetzt auf spieler statt auf zolome
//          stabaxt statt streitaxt



inherit "std/mnpc";

#include "../def.h"

void create()
{

  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Kerak der Riese");
  SetProp(P_LONG, BS(
        "Du stehst nun vor Kerak dem Riesen, dessen Lebensaufgabe es ist, alle Zolome "
        "die er findet zu vernichten. Er ist ueber und ueber mit Narben und Wunden "
        "bedeckt und schaut sich grimmig nach seinen Feinden um."));


  SetProp(P_NAME, "Kerak");
  SetProp(P_GENDER, MALE);
  AddId( ({"riese", "kerak", "Axtmeister"}) );
  SetProp(P_ARTICLE, 0);

  create_default_npc(40);
  SetProp(P_HANDS, ({" mit seinen Haenden", 290+random(30), DT_BLUDGEON}));
  SetProp(P_RACE, "Riese");
  SetProp(P_SIZE, 500+random(20));
  SetProp(P_ALIGN, 100);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_MAX_HANDS, 2);
  AddInfo(DEFAULT_INFO, "sagt: Toete alle Zolome.\n");
  SetProp(P_REJECT, ({ REJECT_DESTRUCT, 
        "Der Riese vernichtet @WEN.\n"}));
  SetProp(P_DIE_MSG, " bricht bruellend nieder.\n");
  SetProp(P_NOCORPSE, 0);
  SetProp(P_NOMAGIC, 3);
  SetProp(P_SPELLRATE, 50);

  AddSpell(4, 999,
      "Kerak der Riese schleudert Dich zu Boden.\n",
      "Kerak der Riese schleudert @WEN zu Boden.\n",
      DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));
  AddSpell(5, 666,
      "Kerak der Riese stampft wild auf die Erde.\n",
      "Kerak der Riese stampft wild auf die Erde.\n",
      DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));

  SetProp(P_MSGIN, "stampft grimmig herein");
  SetProp(P_MMSGIN, "stampft grimmig herein");
  SetProp(P_MMSGOUT, "stampft tobend weit weg");
  SetProp(P_MSGOUT, "stampft grimmig");
  SetProp(P_MNPC_AREA, "/d/dschungel/dante/tijaraneu/room/");
  SetProp(P_MNPC_WAIT, ({100, 20,20}));
  SetProp(P_MNPC_FLAGS, MOV_MOVES + MOV_BACKWARDS + MOV_SPECIAL+ MOV_INDOORS +MOV_INFIGHT);
  SetProp(P_MNPC_DEFAULTROOM, "/d/dschungel/dante/tijaraneu/room/z1");

  SetChats(4, ({
        "Kerak der Riese stampft mit dem Fuss auf den Boden.\n",
        "Kerak der Riese laesst die Erde erzittern.\n",
        "Kerak der Riese schlaegt mit der Faust auf den Boden.\n",
        "Kerak der Riese tritt Dich.\n",
        "Kerak der Riese schaut sich nach Zolomen um!\n",
        "Kerak der Riese bruellt: Tod allen Zolomen!\n",
        "Die Erde scheint zu erzittern.\n",
        "Der Boden unter Deinen Fuessen wackelt.\n"
        "Kerak der Riese sagt: Alle Zolome muessen sterben!\n",
        "Kerak der Riese sagt: Ich hasse alle Zolome!\n",
        }));

  AddInfo("dante",
      "sagt: Dante, der alte Angsthase!\n");   


  AddInfo(({"riese","kerak"}),
      "Das bin ich! Kerak der Zolomtoeter!", "sagt: ");
  AddInfo(({"zolom","zolome"}),
      "Wir Riesen sind die Todfeinde der Zolome!", "sagt: ");
  AddInfo(({"dung","schleim","feuer","brenner","zolombrenner"}),
      "Den Dung kann man mit einem Zolombrenner vernichten!", "sagt: ");
  AddInfo(({"nest"}),
      "Das Nest ist irgendwo im Norden!","sagt: ");
  AddInfo( ({"listen", "topliste", "toplisten", "liste"}),
      "Ich kann Dir folgende Toplisten zeigen: 'Zolomtoeter' und 'Zolomsterber', "
      "und zusaetzlich sogar noch fuer jede Zolomart, zb 'Zolomtoeter1' fuer die "
      "sehr kleinen Zolome oder 'Zolomsterber10' fuer diejenigen die an einem "
      "dantinischen Zolom gestorben sind. Fuer das uralte Zolom musst Du "
      "allerdings das ur- der Frage voranstellen. Ich kann Dir sogar auch "
      "Deinen eigenen 'Zolomstatus' sagen.", 
      "erklaert Dir: ");
  AddInfo( ({"zolomstatus", "status"}), "@@zolomstatus@@", "sagt: ");
  AddInfo( ({"zolomtoeter"}), "@@zolomtoeter@@", "", 1);
  AddInfo( ({"zolomtoeter1"}), "@@zolomtoeter1@@", "", 1);
  AddInfo( ({"zolomtoeter2"}), "@@zolomtoeter2@@", "", 1);
  AddInfo( ({"zolomtoeter3"}), "@@zolomtoeter3@@", "", 1);
  AddInfo( ({"zolomtoeter4"}), "@@zolomtoeter4@@", "", 1);
  AddInfo( ({"zolomtoeter5"}), "@@zolomtoeter5@@", "", 1);
  AddInfo( ({"zolomtoeter6"}), "@@zolomtoeter6@@", "", 1);
  AddInfo( ({"zolomtoeter7"}), "@@zolomtoeter7@@", "", 1);
  AddInfo( ({"zolomtoeter8"}), "@@zolomtoeter8@@", "", 1);
  AddInfo( ({"zolomtoeter9"}), "@@zolomtoeter9@@", "", 1);
  AddInfo( ({"zolomtoeter10"}), "@@zolomtoeter10@@", "", 1);
  AddInfo( ({"urzolomtoeter"}), "@@zolomtoeter11@@", "", 1);
  AddInfo( ({"zolomsterber"}), "@@zolomsterber@@", "", 1);
  AddInfo( ({"zolomsterber1"}), "@@zolomsterber1@@", "", 1);
  AddInfo( ({"zolomsterber2"}), "@@zolomsterber2@@", "", 1);
  AddInfo( ({"zolomsterber3"}), "@@zolomsterber3@@", "", 1);
  AddInfo( ({"zolomsterber4"}), "@@zolomsterber4@@", "", 1);
  AddInfo( ({"zolomsterber5"}), "@@zolomsterber5@@", "", 1);
  AddInfo( ({"zolomsterber6"}), "@@zolomsterber6@@", "", 1);
  AddInfo( ({"zolomsterber7"}), "@@zolomsterber7@@", "", 1);
  AddInfo( ({"zolomsterber8"}), "@@zolomsterber8@@", "", 1);
  AddInfo( ({"zolomsterber9"}), "@@zolomsterber9@@", "", 1);
  AddInfo( ({"zolomsterber10"}), "@@zolomsterber10@@", "", 1);
  AddInfo( ({"urzolomsterber"}), "@@zolomsterber11@@", "", 1);

  SUID;
  CLONEME("d/dschungel/dante/tijaraneu/obj/burner");

  CLONEME("p/armour/shield/eisenschild");
  CLONEME("p/armour/armour/plattenpanzer");
  CLONEME("p/armour/amulet/amulett");
  CLONEME("p/armour/boots/lederstiefel");
  CLONEME("/p/weapon/axe/stabaxt");
  command("zuecke axt");
  command("trage alles");
}


int Defend(int dam, mixed dtype, int spell, object enemy)
{
  if(enemy->id("zolom")) {      
    return ::Defend(0, dtype, spell, enemy);      
  }
  else if( interactive(enemy)) 
    SetProp( P_PREFERED_ENEMY, ({100,enemy}));

  return ::Defend(dam, dtype, spell, enemy);

}


void init()  {
  object zolom;
  ::init();

  zolom=present("zolom", environment(TO));

  if(interactive(TP))  {
    call_out("tag", 1);
  }


  if( zolom )	{
    Kill(zolom);

    write(BS(
          "Kerak stuerzt sich tobend auf das Zolom!"));
  } 

}

void tag()  {
  write(break_string(
        "HE! "+TPN+"! Toete alle Zolome! Hilf mir los!", 78,
        "Kerak teilt Dir mit: "));
} 	

string *zolomnamen = ({"","sehr klein", "klein", "mittelgross", "gross", 
                       "sehr gross", "extrem gross", "gigantisch", "bombastisch",
                       "ultimativ", "dantinisch", "uralt"});

string zolomstatus()
{
  mapping kills, deads;
  int i, flag;
  string antwort;

  antwort = "";
  flag = 0;
  if(kills = call_other(OBJ "zolom_master", "KillInfo", getuid(TP)))
  {
    for(i=1; i<=11; i++)
      if(kills[i])
      {
        antwort += "Du hast schon "+kills[i]+ " " + zolomnamen[i] + 
          "e" + (kills[i] == 1 ? "s" : "") + " Zolom" + 
          (kills[i] == 1 ? "" : "e") + " getoetet. ";
        flag += kills[i];
      }
  }
  if(flag)
    antwort += "Insgesamt sind das " + flag + " Zolomkill" + 
      (flag == 1 ? "" : "s") + ". ";
  else
    antwort += "Du hast noch keine Zolome getoetet. ";
  flag = 0;
  if(deads = call_other(OBJ "zolom_master", "DeathInfo", getuid(TP)))
  {
    for(i=1; i<=11; i++)
      if(deads[i])
      {
        antwort += "Du wurdest schon "+deads[i]+ " mal heldenhaft im Kampf gegen "
          "ein " + zolomnamen[i] + "es Zolom getoetet. ";
        flag += deads[i];
      }
  }
  if(flag)
    antwort += "Insgesamt sind das " + flag + " Tod" + 
      (flag == 1 ? "" : "e") + ". ";
  else
    antwort += "Noch kein Zolom hat Dich getoetet. ";
  return antwort;
}

string zolomtoeter()
{
  write("Kerak sagt: Die Topliste der besten Zolomtoeter\n");
  write(break_string( call_other(OBJ "zolom_master", "TopList", 0, 1), 78,
        "Kerak sagt: ", BS_LEAVE_MY_LFS));
  return "grinst.";
}

