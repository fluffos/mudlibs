// dante sl 99
/*
   der baecker verkauft torten fuer geburtstagskinder

*/

inherit "std/npc";
inherit "std/npc/spells";
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <npc.h>
#include <player.h>
#include <new_skills.h>
#include "/players/dante/myowndefine.h"

#define PATH "/d/dschungel/dante/tijaraneu/obj/"

int max_alter=999;
object cash;

int preis=500;

init(){
  ::init();
  if(interactive(TP)){
    call_out("tag", 1); 
  }
}

tag()  {
  if(environment(TO)!=environment(TP))  return ;



  if(deep_present("geburtstagstorte", TP))  {		
    write(BSA(
          "Hallo, "+TPN+"! HE! Du hast ja eine meiner Torten!",
          "Konditorox, der Baecker sagt: "));
  }  

  else  {
    write(BSA(
          "Guten Tag, "+TPN+", was kann ich fuer Dich tun? Eine Torte gefaellig!?",
          "Konditorox, der Baecker sagt: "));

  }
}

create()
{ 
  object ob;

  if (!is_clone(this_object())) return;

  ::create();

  SetProp (P_SHORT, "Der Baecker Konditorox");

  SetProp (P_LONG, BS (
        "Das ist der Baecker Konditorox. Er baeckt und knetet den ganzen "
        "Tag die besten Torten und Teige des Silberlandes. Und wie man an "
        "seiner Leibesfuelle leicht erkennen kann, "
        "isst er sie auch sehr gerne selbst! Er kann Dir eine Geburtstagstorte "
        "verkaufen! Frag ihn danach!"));


  AI(({"torte","geburtstagstorte","torten"}),
      "Ich verkaufe Dir gerne eine Torte. Sie kostet "+preis+" Muenzen. "
      "Tipp einfach <torte name des geburtstagskindes alter>! "
      "Also zum Beispiel <torte dante 10>!", "sagt: ");

  AI(({"baecker","konditorox"}),
      "Das bin ich!",
      "sagt stolz: ");
  AI("tijara",
      "Da wohne ich!",
      "sagt: ");
  AI(({"lux","lichtfee"}),
      "Die wohnt auch in Tijara!",
      "sagt: ");
  AI(({"tithonos"}),
      "Der wohnt gleich nebenan!", "sagt: ");
  AI("dschungel",
      "Der ist ganz nah von hier",
      "sagt: ");
  AI("silberland",
      "Viel zu wenig Torten gibts hier!", "sagt: ");

  AI("dante",
      "Der wahre Herr des Dschungels!", "sagt: ");

  AI("kuchen",
      "Kuchen habe ich auch recht gerne!",
      "sagt: ");
  AI("teig",
      "Der Teig ist das wichtigste!",
      "sagt: ");

  create_default_npc( 20 );

  SetProp (P_NAME, "Konditorox");
  SetProp(P_ARTICLE, 0);
  SetProp (P_GENDER, MALE);
  SetProp(P_BODY, 80);
  SetProp(P_HANDS, ({" mit seinen kraeftigen, teigverschmierten Haenden", 200, DT_BLUDGEON}));

  SetProp(P_MSGIN,"kommt teigknetend herein");
  SetProp(P_MSGOUT,"geht eine Torte essend");  
  SetProp(P_MMSGIN,"kommt teigknetend herein");
  SetProp(P_MMSGOUT,"geht eine Torte essend davon");

  SetProp(P_MAX_HANDS, 2); 
  SetProp(P_ALIGN, 400);
  SetProp(P_RACE, "Zwerg");
  SetProp(P_SIZE, 120);
  SP(P_WEIGHT, 300000); // der is fett!!!
  SetProp(P_REJECT, ({REJECT_KEEP,
        "Konditorox sagt: Kann man das essen!? \n"}));
  SetProp (P_DIE_MSG," sagt: Gibt es im Himmel auch Torten?\n"
      "Dann faellt er tot zu Boden!\n");

  SP(P_KILL_MSG, "Torten, Torten alle Sorten! HAHA!\n");
  SP(P_MURDER_MSG, "Danke %s, im Himmel gibt es sowieso mehr Torten!\n");

  AD(({"leibesfuelle","leib","fuelle"}),
      "Der Baecker ist total fett! Fast so fett wie ZENSUR!!!");
  SP(P_MSG_FLAGS, ([P_KILL_MSG: 0, P_MURDER_MSG:0]));


  SetChats(5, ({
        "Konditorox begutachtet seine neue Torte.\n",
        "Konditorox sagt: Backen ist mein Leben!\n",
        "Konditorox sagt: Kaufen Sie eine Torte!\n",
        "Konditorox stopft sich ein Tortenstueck in den Mund!\n",
        "Konditorox sagt: Ich liebe alle Torten!\n",
        "Konditorox sagt: Meine Torten sind die besten!\n",
        "Konditorox knetet wie wild Teig!\n",
        "Konditorox ruehrt neuen Teig an.\n"
        }) );


  SP(P_SPELLRATE, 50);
  SP(P_NOMAGIC, 0);

  AddId(({"baecker","konditorox", "NOWIMPY"}));

  AddDefaultSpell(3, 300, DS_POISON,
      "Konditorox bewirft Dich mit altem Teig.\n",
      "Konditorox bewirft @WEN mit altem Teig.\n");



  SUID;
  CLONEME("p/armour/gloves/lederhandschuhe");
  CLONEME("p/armour/cloak/schuerze");
  CLONEME("p/armour/armour/hemd");
  CLONEME("p/armour/boots/lederstiefel");
  command("ziehe alles an");





  AddSpell(5, 300,
      "Konditorox wirft Dir eine Torte an den Kopf. PLATSCH!\n",
      "Konditorox wirft @WEM eine Torte an den Kopf. PLATSCH!\n",
      DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));

  AddInfo( DEFAULT_INFO, 
      ({
       "sagt: Torten sind besser!\n",
       "sagt: Kuchen habe ich auch sehr gerne!\n",
       "stopft sich nur eine Torte in den Mund.\n",
       "sagt: Meine Rezepte sind geheim!\n"
       }) );



  ACD(({"torte"}), "cake");
}

cake(string str)  {
  string kind;
  int alt;
  object ob;
  NF(BS("Konditorox sagt: Nein, so geht das nicht! Noch einmal!"));	

  if(!str) {
    return 0; 
  }

  if(TP->QueryMoney()<preis)  {
    write(BSA(
          "Aber Du hast doch keine "+preis+" Muenzen!", 
          "Konditorox sagt: "));		
    return 1; 
  }

  if(sscanf(str, "%s %d" , kind, alt)!=2) return 0;

  if(alt>max_alter || alt<1)  {
    write(BSA(
          "Nein! So alt kann man nicht sein! Bedaure!",
          "Konditorox sagt: "));
    return 1;  
  }

  else
  {

    if(strlen(kind)>20)  {
      write("Konditorox sagt: Nein, das ist zu lange!!\n");
      return 1;  
    }

    TP->AddMoney(-preis);

    ob=CLONEOB(PATH"geburtstag");

    ob->create(kind, alt);
    ob->move(TP, M_NOCHECK);
    cash=CLONEOB("/obj/money");
    cash->SP(P_AMOUNT, preis);
    cash->move(TO, M_NOCHECK);

    write(BS(
          "Konditorox oeffnet einen der Kaesten, holt eine Torte hervor und "
          "verziert und beschriftet sie in Windeseile. "
          "Du gibts ihm dafuer "+preis+" Muenzen."));

    write("\n");

    write(BSA(
          "Hier ist die Torte fuer "+CAP(kind)+", "+TPN+". Es brennen wie "
          "verlangt "+alt+" Kerzen auf ihr! Viel Spass damit! ",
          "Konditorox sagt: "));

    return 1; 
  }
  return 0; 
}

