/*
   dante sl 2000
   */

inherit "std/npc";
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include "/players/dante/myowndefine.h"
#include <new_skills.h>

void create()
{

  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine fleischfressende Riesenlilie namens Cutensia cutensia");
  SetProp(P_LONG, BS(
        "Diese Riesenlilie hat sicher grossen Hunger auf solche Leute wie Dich! "
        "Tithon hat sie gezuechtet, weil Cute zu den heldenhaften Erstbezwingern "
        "von Phytokarnizerkatos, dem schrecklichen Pflanzendrachen gehoert!!! "
        "Sie hat einen sehr hohen Preis dafuer bezahlt. Nicht weniger als "
        "sechs Tode musste sie erleiden, bevor der Drache sein Leben aushauchte. "
        "Ein wahrer Phyrhossieg!"));


  SetProp(P_NAME, "Cutensia cutensia");
  SetProp(P_GENDER, FEMALE);
  AddId(({"cutensia","pflanze", "riesenlilie", "lilie", "NOWIMPY"}));
  SetProp(P_RACE, "Pflanze");

  create_default_npc(20);
  SetProp(P_HANDS, ({" mit ihren grossen Blaettern",180+random(20),({DT_POISON,DT_RIP,DT_PIERCE}) }) );
  SetProp(P_SIZE, 200);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 0);
  SetProp(P_HEAL, 5);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_NOMAGIC,0);

  SetProp(P_MSGIN, "waechst aus dem Boden");
  SetProp(P_MSGOUT, "schlaengelt");
  SetProp(P_MMSGIN, "waechst aus dem Boden");
  SetProp(P_MMSGOUT, "verwelkt ploetzlich");

  SetProp(P_DIE_MSG,  " verwelkt ploetzlich abrupt.\n");
  SetProp(P_NOCORPSE, 0);

  AddInfo(DEFAULT_INFO, "reisst ihr Maul auf.\n");

  SetProp( P_REJECT, ({ REJECT_KEEP,
        "Die Riesenlilie namens Cutensia cutensia reisst ihr Maul weit auf.\n" }) );

  SetProp(P_SPELLRATE,60);
  AddSpell(5,300,
      "Die Riesenlilie namens Cutensia cutensia versucht Dich zu verschlucken.\n",
      "Die Riesenlilie namens Cutensia cutensia versucht @WEN zu verschlucken.\n",
      DT_TERROR, ([SP_SHOW_DAMAGE:1]));
  AddSpell(2,400,   
      "Die Riesenlilie namens Cutensia cutensia spritzt Schleim auf Dich.\n",
      "Die Riesenlilie namens Cutensia cutensia spritzt Schleim auf Dich.\n",
      DT_ACID, ([SP_SHOW_DAMAGE:1]));
  AddSpell(4,350,   
      "Die Riesenlilie namens Cutensia cutensia beisst Dir ins Bein.\n",
      "Die Riesenlilie namens Cutensia cutensia beisst @WEM ins Bein.\n",
      DT_RIP, ([SP_SHOW_DAMAGE:1]));

  SetChats(3, ({
        "Die Riesenlilie namens Cutensia cutensia reisst ihr Maul weit auf.\n",
        "Die Riesenlilie namens Cutensia cutensia schliesst ihr Maul.\n",
        "Die Riesenlilie namens Cutensia cutensia verschluckt eine Fliege.\n",
        "Die Riesenlilie namens Cutensia cutensia schnappt nach Dir.\n",
        "Die Riesenlilie namens Cutensia cutensia ruelpst.\n",
        "Die Riesenlilie namens Cutensia cutensia verschluckt einen unsichtbaren Vogel.\n"}));

  SetAttackChats(10, ({
        "Die Riesenlilie namens Cutensia cutensia versucht Deinen Kopf zu verschlingen.\n",
        "Die Riesenlilie namens Cutensia cutensia schnappt nach Dir.\n",
        "Die Riesenlilie namens Cutensia cutensia spuckt Schleim neben Dich.\n",
        "Doe Riesenlilie namens Cutensia cutensia reisst ihr Maul sehr weit auf.\n"}) );

}


init()
{
  object defender;
  ::init();


  if(interactive(TP)) {


    if(getuid(TP)=="cute")  {

      call_out("tag", 1);
    }
  }
}

tag()  {
  if(environment(TP)!=environment(TO)) return;


  say(BS(
        "Die Riesenlilie Cutensia cutensia verneigt sich vor ihrer "
        "Namenspatronin Cute! Sie weiss, das sie den schoenen Namen "
        "Cutensia cutensia Cute zu verdanken hat!"));

}
