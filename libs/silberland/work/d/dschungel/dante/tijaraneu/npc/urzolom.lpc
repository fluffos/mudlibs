/*
   ein beispiel zolom
   dante sl 200
   */



#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>


#include "/players/dante/myowndefine.h"


#include <mnpc.h>

inherit "/d/dschungel/dante/tijaraneu/npc/std_npc_zolom";




void create()
{

  if (!is_clone(TO)) return;
  ::create();

  create_std_zolom(11);
  AddId("urzolom");
  set_living_name("urzolom");
  SP(P_MNPC_FLAGS, 0);
  SP(P_NAME, "Urzolom");
  SP(P_NAME_ADJ, ({"ewiglebend", "uralt"}));
  SP(P_SHORT, "Das ewiglebende, uralte Urzolom");


  SetProp(P_LONG, BS(
        "Dieses Zolom ist das aelteste aller Zolome. Der Sage nach hat es alle anderen "
        "Zolome gezeugt. Mit ihm ist nicht zu Spassen!!! "
        "Es ist ungefaehr "+lang+" Meter lang!"));   
  SetProp(P_AGGRESSIVE, 0.5);


  SetProp(P_MURDER_MSG, "Wie konnte mir, dem Urzolom aller Zolome das nur passieren!!! Dante mach mich staerker!!!\n");
  SetProp(P_KILL_NAME, "Ein uraltes Tijara-Zolom");
  SetProp(P_KILL_MSG, "Deine Leiche wird mir schmecken! Ja, mit mir dem Urzolom legt man sich besser nicht an! Hail meinem Schoepfer!\n");
  SetProp(P_MSG_FLAGS, ([P_KILL_MSG:0, P_MURDER_MSG:0 ]));

}
