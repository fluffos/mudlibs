 
inherit "std/mnpc";
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <actions.h>
#include <mnpc.h>
#include <new_skills.h>
#include "/players/dante/myowndefine.h"
#include <ansi.h>

void weg(object opfer);

nosave object cash;

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();
  
  
  SetProp(P_SHORT, "Schnippschnapp Hodini");
  SetProp(P_LONG, BS(
"Das ist Schnippschnapp Hodini. Eine merkwuerdige Gestalt, halb Mensch, "
"halb Oger, sieht er nicht gerade ansehnlich aus. Eigentlich ist er aber harmlos, "
"wenn da nicht etwas waere..."));

    
  SP(P_RACE, "Oger-Mensch");
SP(P_NAME, "Hodini");

  SetProp(P_GENDER, MALE);
  AddId(({"hodini","NOWIMPY", "NOCONTROLL","schnippschnapp"}));

  create_default_npc(30);
   SP(P_ARTICLE, 0);

  SetProp(P_HANDS, ({" mit seinem Messer",290+random(20),({DT_RIP})}));
  SetProp(P_SIZE, 220);
  SetProp(P_ALIGN, -100);

SP(P_TRANSPARENT, 0);


  SetProp(P_MAX_HANDS, 2);
    SetProp(P_BODY, 150);
  SetProp(P_HEAL,7);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
   SetProp(P_RESISTANCE_STRENGTHS, ([DT_MAGIC: 0.2, DT_FIRE:0.2, DT_BLUDGEON:-0.3,
  DT_TERROR: -0.9, DT_ACID: 0.4,DT_COLD:-0.1, DT_SLASH: -0.3]));   

  SetProp(P_MSGIN, "kommt hierher");
  SetProp(P_MSGOUT, "geht eilig");
  SetProp(P_MMSGIN, "kommt breitgrinsend herein");
  SetProp(P_MMSGOUT, "rennt davon");

  SetProp(P_MNPC_AREA, ("/d/dschungel/"));
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS +MOV_INDOORS+ MOV_MOVES+MOV_BACKWARDS+MOV_INFIGHT );
  SetProp(P_MNPC_WAIT, ({10, 20, 15}));
  SetProp(P_MNPC_DEFAULTROOM, "/d/dschungel/dante/tijaraneu/room/ti_pfad1");


  SetProp(P_DIE_MSG,  " bricht bruellend und fluchend zusammen.\n");
  SetProp(P_NOCORPSE, 0 );
  
  AddInfo(DEFAULT_INFO, ({
  "sagt: Du stellst aber kluge Fragen!\n",
  "spuckt vor Deine Fuesse.\n",
  "lacht nur ueber Dich.\n",
  "macht eine abwehrende Geste.\n",
  "staunt ueber so eine dumme Frage.\n",
  "grinst Dich nur an.\n",
  "sagt: Hmm, Deine Ausruestung gefaellt mir.\n",
  "schaut Dich boese an.\n",
  "sagt: Naja, gib mir Geld, dann...\n"}));
  
  
  

cash=CLONEOB("/obj/money");
cash->SP(P_AMOUNT, 2000+random(2000));
cash->move(ME, M_NOCHECK);


  SetProp(P_SPELLRATE,75);



 AddSpell(1,1,
"Hodini Schnippschnapp haelt Dir Deine Augen zu!\n",
"Hodini Schnippschnapp haelt @WESSEN Augen zu!\n",
DT_MAGIC, "spell_blind");

  
 AddSpell(1,1,
"Hodini Schnippschnapp schnellt mit seinem Messer direkt auf Dich zu!\n",
"Hodini Schnippschnapp schnellt mit seinem Messer direkt auf @WEN zu!\n",
DT_MAGIC, "spell_weg");
   

    AddSpell(4,300,
"Hodini Schnippschnapp wuergt Dich!\n",
"Hodini Schnippschnapp wuergt @WEN.\n",
DT_SQUEEZE, ([SP_SHOW_DAMAGE:1]));

    AddSpell(4,350,
"Hodini Schnippschnapp schlaegt Dir mir der Faust auf die Nase.\n",
"Hodini Schnippschnapp schlaegt @WEM mit der Faust auf die Nase.\n",
DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));

    AddSpell(4,300,
"Hodini Schnippschnapp bruellt Dich an.\n",
"Hodini Schnippschnapp bruellt @WEN an.\n",
DT_TERROR, ([SP_SHOW_DAMAGE:1]));

  AddSpell(2,400,
"Hodini Schnippschnapp schleudert ein Messer auf Dich.\n",
"Hodini Schnippschnapp schleudert ein Messer auf @WEN.\n",
DT_MAGIC, ([SP_SHOW_DAMAGE:1]));

 AddSpell(2,400,
"Hodini Schnippschnapp stopft Dir Dreck in den Mund.\n",
"Hodini Schnippschnapp stopft Dreck in @WESSEN Mund.\n",
DT_MAGIC, ([SP_SHOW_DAMAGE:1]));



  SetChats(3, ({
  "Hodini Schnippschnapp grinst Dich boesartig an.\n",
  "Hodini Schnippschnapp scheint etwas auszuhecken...\n",
  "Hodini Schnippschnapp lacht laut.\n",
  "Hodini Schnippschnapp sagt: Du bist ein Feigling!\n",
  "Hodini Schnippschnapp sagt: Du bist ziemlich doof.\n",
  "Hodini Schnippschnapp sagt: Gegen mich bist Du ein Weichei!\n",
  "Hodini Schnippschnapp kratzt seinen Buckel.\n",
  "Hodini Schnippschnapp murmelt irgendetwas.\n", 
  "Hodini Schnippschnapp stinkt ziemlich.\n"}) );
  
 
 
 SUID;
// CLONEME("/d/dschungel/dante/tijaraneu/weapon/mes.lpc"); Deaktiviert weils buggt
 //absichtlich keinzuecken 
  
set_living_name("hodini");
  
  call_out("trans_sl", 0);
}


   void trans_sl()
   {
   switch(random(8))
     {
     case 0:
     TO->move("d/dschungel/feyaria/dorf/room/weg3", M_TPORT);
     break;
     case 1: 
     TO->move("/d/gebirge/speedy/trollager/room/t6", M_TPORT);
     break;
     case 2:
     TO->move("/d/ebene/zordan/ogerhoehle/room/room_e3", M_TPORT);
     break;
     case 3:
     TO->move("/d/ebene/lamuerte/wwald/room/12y_25x", M_TPORT);
     break;
     case 4:
     TO->move("/d/gebirge/dusty/weg/l27", M_TPORT);
     break;
     case 5:
     TO->move("/d/polar/lamuerte/dorf/rooms/steg", M_TPORT);
     break;
     case 6:
     TO->move("/d/huegelland/raballion/hobbits/room/nordtor", M_TPORT);
     break;
     case 7:
     TO->move("/d/kristallwald/sargola/wald/room/1002", M_TPORT);
     break;
     default: TO->move("/gilden/abenteurer", M_TPORT);
     }
   }  
  
  reset()
  {
  ::reset();
  if(!is_clone(TO)) { return;  }
  call_out("trans_sl", 0);
  }
     
     
     
     
 catch_tell(string str)

    {
            string dum1,dum2,dum3;
      if(sscanf(str,"%s teilt Dir mit: %s",dum1,dum2))   
      { call_out("back",2,dum1,dum2);}
                        }




   back(string dum1,string dum2)
     {  string dum3;
        object ob;
   object env;
   string *path;
   string ans;               
 dum3=explode(dum1," ");
   dum3=dum3[sizeof(dum3)-1];
  ob=find_player(lower_case(dum3));
if(!ob)  { return;  }

    if(strstr(dum2,"wo bist du")!=-1 || strstr(dum2,"Wo bist du")!=-1)
  {
    if (!(env=environment()))
        return;
 path=explode(file_name(env),"/");      
   if (path[0]=="d")
     {
         switch(path[1])
             {
    case "dschungel":
     case "gebirge":
    case "kristallwald":
   case "huegelland":  
      ans="im "+capitalize(path[1]);        
      break;
         case "polar":
     ans="im Polargebiet";
     break;
   case "wasser":
           ans="am Wasser";
      break;
     case "ebene":
    switch(path[2])
    {
    case "Gaffos":
     ans="bei den Gaffos";
  break;
  case "Silberwald":
     case "Park":
   ans="im "+path[2];  
   break;
      case "Midas":
     ans="in Midas";
       break;
       default:
     ans="in der Ebene";
    } 
     break;
    case "wueste":
     case "tundra":
       case "unterwelt":
     ans="in der "+capitalize(path[1]);
    break;
     case "wahnsinn":
  
     ans="in einer verrueckten Umgebung";
             break;
     default:
             ans="werweisswo ..";
      }
          ans="Ich bin "+ans+"";
            }
 if (path[0]=="players")
  ans="Ich hab mich verlaufen - ich schaetze, "+capitalize(path[1])+
  " hat was damit zu tun ...\n";               
 if (path[0]=="gilden")
     ans="Ich bin in einer Gilde.\n";
         
  tell_object(ob,
  "Hodini teilt Dir mit: "+ans+"!!! \n");
  }
  
  else
  {
  switch(random(5))
     {
     case 0:
     tell_object(ob,
     "Hodini teilt Dir mit: Schnippschnapp ab der Sack!!!\n");
     break;
     case 1:
        tell_object(ob, 
        "Hodini teilt Dir mit: Du Pimmelmann!\n");
        break;
        case 2:
        tell_object(ob,
    "Hodini teilt Dir mit: Magier haben Kurze!!!\n");    
    break;
     case 3:

        tell_object(ob, 
    "Hodini teilt Dir mit: Belaestig doch jemand anderen!?\n");
    break;
    case 4:
       tell_object(ob, 
       "Hodini teilt Dir mit: Holladrio!\n");
       break;
       default:tell_object(ob,
       "BUG!\n!");
      }
  }    
       
}
               


//************************************************************
  init()
  {
  	
  ::init();
  if(interactive(TP)) call_out("hallo",1);
  }


 void hallo()
 {
 	
if(environment(TO)!=environment(TP)) return;

	
write(BSA(
CAP_TPN+", heute schon mein Messer gespuert...",
"Hodini sagt: "));
           }

 spell_weg(object enemy) {
 	int ges, i;
        object *rue;
        
 	ges=enemy->QP(P_GENDER);
 	
 	if(ges==1 && interactive(enemy)  ) {
           
            rue=enemy->QP(P_ARMOURS);
            
        if(!sizeof(rue))  {
        	weg(enemy); return; }
        
            if(sizeof(rue))  {
    
            for(i=0; i<sizeof(rue); i++)   {
            
            if( rue[i]->QP(P_ARMOUR_TYPE)==AT_TROUSERS)   {
            	tell_object(enemy,
            	"Hodini flucht laut auf! Er hat keine Chance bei Dir!\n"
            	""+rue[i]->Name(WER, 1)+" schuetzt Dich vor seinem boesen Angriff!\n");
                return;
        } 
             }} 
//        weg(enemy); deaktiviert wegen bug
        return;
     }

if(ges!=1)  {
      tell_object(enemy,
 "Hodini sticht Dir sein Messer in den Bauch!\n");
 enemy->do_damage(10+random(10));
        }    }  

weg(opfer) {
	string *wie;
        int i;
	object penis;
	
	wie=({
	"klein","winzig","mini",
	"runzelig", "sehr klein",
	"duenn","niedlich"});
	
penis=clone_object("/d/dschungel/dante/tijaraneu/obj/penis");

 i=random(sizeof(wie));

penis->SP(P_LONG, BS(
"Das ist der Penis von "+opfer->name(WEM)+"! Hodini Schnippschnapp hat ihn mit einem "
"Kastriermesser abgeschnitten. Ziemlich "+wie[i]+", der Penis von "+opfer->name(WEM)+"!"));
 		
 penis->SP(P_SHORT, "Der abgeschnittene "+wie[i]+"e Penis von "+opfer->name(WEM)+"");
 		
 		
 		penis->move(environment(TP), M_NOCHECK);
 	
 		
 		opfer->SP(P_GENDER, NEUTER);
 		
 		tell_object(opfer,BS(
 		"Hodini Schnippschnapp schneidet mit einem "
 		"schnellen, sauberen Schnitt Deinen Penis ab! AUA! Das tut weh! "
 		"Du bruellst vor Schmerzen auf und beginnst mit hoher, weiblicher "
 		"Stimme zu weinen. DU Jammerlappen bist nun ein ES! "
 		"Achja, Dein Penis liegt in einer Blutlache am Boden herum!"));
 		opfer->do_damage(10+random(10));
 		
 		tell_room(environment(TP),BS(
 		"Hodini Schnippschnapp schneidet mit einem "
 		"schnellen, sauberen Schnitt den Penis von "+opfer->name(WEM)+" ab!"
 		"AUA! Das tut weh!"
 		""+opfer->name(WER)+" bruellt vor Schmerzen auf "
 		"und beginnt mit hoher, weiblicher "
 		"Stimme zu weinen. So ein Jammerlappen! Er nun ein ES! "
 		"Achja, der Penis liegt in einer Blutlache am Boden herum!"),
               ({opfer}));
              
 }
 
 
 
 
 //*********************************************************
void spell_blind(object enemy)
{
switch(random(100))
{
case 0 .. 50:
     enemy->SetProp(P_BLIND, 10+random(20));
     break;
case 51.. 100:
     tell_object(enemy,
     "Hodini Schnippschnapp schreit: Du hast nochmal Glueck gehabt!!!\n");
     }
 }
 
 
 die(arg)  {
 	write_file("/d/dschungel/dante/weg/log/hodini",
  ctime()+": Hodini Schnippschnapp wurde von "+CAP(getuid(TP))+" umgebracht.\n");
 ::die(arg);  }
 
 
 void NotifyPlayerDeath(object player, object killer, int lostexp)
 {
 	 	write_file("/d/dschungel/dante/weg/log/hodini",
  ctime()+": Hodini Schnippschnapp toetete "+CAP(getuid(player))+".\n");
  NAL1
  heal_self(1000);
  }
  NAL2
  
