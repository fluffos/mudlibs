/*
der pflanzendrache hinter tihtons haus
einer meiner vielen drachen
dante sl 2000
*/



inherit "/p/std/dragons/dragon";
#include "/players/dante/myowndefine.h"
#include <properties.h>
#include <language.h>
#include <combat.h> // fuer die damage types
#include <moving.h> // fuer REJECT_KEEP
#include <wizlevels.h>
#include <new_skills.h>
#include <class.h>
#define TIME 10
object cash;

void create()
{ 
  if (!is_clone(this_object())) return;
  ::create();    
  create_default_dragon(5,11,0,35+random(15));

  AddId(({"drache","pflanzendrache", "phytokarnizerkatos"}));
  SetProp(P_LONG,BS(
        "Der Pflanzendrache erscheint wie eine grosse, undurchdrinbare Wand aus "
        "gruenen, boesartigen, fleischfressenden Pflanzen. Uebersaeht mit spitzen "
        "Dornen, gepanzert durch enorm dicke und stahlharte Blaetter. Wo genau sein "
        "Kopf und wo sein Schwanz ist, kann man nur schwer erkennen."));
  SetProp(P_NAME, "Phytokarnizerkatos");
  SetProp(P_SHORT, "Phytokarnizerkatos, der gruene Pflanzendrache");
  SetProp(P_NAME_ADJ, 0);//muss so bleiben!!!
  SetProp(P_ARTICLE, 0);

  SetProp(P_RESISTANCE_STRENGTHS, QueryProp(P_RESISTANCE_STRENGTHS) + ([
        DT_BLUDGEON: -0.5, DT_RIP:-0.5, DT_PIERCE:-0.5,
        DT_FIRE: 0.1, DT_COLD:0.2, DT_ACID:0.4]));

  SetProp(P_AGGRESSIVE, 1);

  set_living_name("pflanzendrache");
  SP(P_NOCORPSE, 1);
  SP(P_DIE_MSG, "loest sich in 10000 gruene Blaetter auf.\n");
  SP(P_KILL_MSG, "Tithon, mein Erschaffer! Ich habe Dich erfolgreich geraecht!");
  SP(P_MURDER_MSG, "Tithon, meine gruene Magie hat versagt! Hilf mir!");

  SetProp(P_MSG_FLAGS, ([P_KILL_MSG:0, P_MURDER_MSG:0 ]));

  SetProp(P_MSGIN, "bricht aus dem Dschungel ploetzlich hervor");
  SetProp(P_MMSGIN, "bricht aus dem Dschungel ploetzlich hervor");

  SetProp(P_SPELLRATE, 60);

  AddSpell(2, 1000,
      "Phytokarnizerkatos schleudert einen Baumstamm nach Dir!\n",
      "Phytokarnizerkatos schleudert einen Baumstamm nach @WEM!\n",
      DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));

  AddSpell(2, 800,
      "Phytokarnizerkatos schleudert Wurzeln nach Dir!\n",
      "Phytokarnizerkatos schleudert Wurzeln nach @WEM!\n",
      DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));

  AddSpell(2,100,
      "Phytokarnizerkatos versucht Dir magische Energie abzusaugen!\n",
      "Phytokarnizerkatos versucht @WEM magische Energie abzusaugen!\n",
      DT_MAGIC, "spell_mp");

  AddSpell(1,100,
      "Phytokarnizerkatos schuechtert Dich ein!\n",
      "Phytokarnizerkatos schuechtert @WEN ein!\n",
      DT_MAGIC, "spell_vorsicht");

  AddSpell(1,100,
      "Phytokarnizerkatos versucht Dich zu verdauen!\n",
      "Phytokarnizerkatos versucht Dich zu verdauen!\n",
      DT_MAGIC, "spell_magen");

  SUID;
  cash=clone_object("obj/money");
  cash->SetProp(P_AMOUNT, 10000+random(20000));
  cash->move(TO, M_NOCHECK);
  CLONEME("d/wasser/dante/zinsel/obj/magictrichter");
  if (random(2))
  {
    cash = clone_object("/gilden/druidenzirkel/obj/focus");
    cash->SetVariables("humus", 1 + random(2) + !random(3) + !random(7) + !random(10));
    cash->move(TO, M_NOCHECK);
  }
}


void spell_magen(object enemy, int damage, mixed dam_type)
{
  int i;
  object *inv, ob;

  object da;
  da=find_living("dante");

  inv=PresentEnemies();
  inv-=({ this_object() });

  tell_room(ENV(ME), BS(
        "Phytokarnizerkatos speiht eklige Saeure wie irr herum!!!"));

  for(i=0;i<sizeof(inv);i++)
  {
    if( (interactive(inv[i])) &&(!present("saeuretot", inv[i])) &&
        (!deep_present("RPD", inv[i]))   )   
    {       
      inv[i]->Defend(500+random(500), dam_type,
          ([SP_SHOW_DAMAGE:1,SP_NAME:"Phytokarnizerkatos"]), this_object());
      if(da)  
        tell_object(da, "JO! "+inv[i]->name()+"!\n");
      tell_object(inv[i], "Du wirst von Phytokarnizerkatos voll getroffen!!!\n"
          "Du solltest Dich raschest im Dschungel in den Schlamm werfen!!!\n");
      write_file("/d/dschungel/dante/weg/log/plantdragon",
          ctime()+": "+inv[i]->name()+" wird verschleimt.\n");
      ob=clone_object("d/dschungel/dante/tijaraneu/obj/saeuretot");
      ob->move(inv[i], M_NOCHECK);
      inv[i]->SP(P_TITLE, "ist voller ekliger Pflanzendrachensaeure");  
    }
  }     
}   


void spell_vorsicht(object enemy, int damage, mixed dam_type)
{
  int plvo;
  plvo=enemy->QueryProp(P_WIMPY);
  enemy->SetProp(P_WIMPY, plvo/2);
}


void spell_mp(object enemy, int damage, mixed dam_type)
{
  int plmp;
  int rand;

  rand=3+random(3);
  plmp=enemy->QueryProp(P_SP);

  if(!random(4))  
  {
    enemy->reduce_spell_points(plmp/rand);
    tell_object(enemy,
        "Deine Magie wird schwaecher!\n");
  }
  else 
  {
    tell_object(enemy,
        "Du schaffst es Dich der Magie des Pflanzendrachen zu widersetzen!\n");  
  }
}


// Kills mitloggen
void die(int poisondeath)
{
  write_file("/d/dschungel/dante/weg/log/plantdragon",
      ctime()+": "+CAP(getuid(TP))+" killt den Pflanzendrachen.\n");
  if( !IS_LEARNER(TP) )
    domainshout(CAP(TP->query_real_name())+
        " hat den Pflanzendrachen Phytokarnizerkatos bezwungen.\n");
  ::die(poisondeath);
}


void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  write_file("/d/dschungel/dante/weg/log/plantdragon",           
      ctime()+": Der Pflanzendrache hat gerade "+CAP(getuid(player))+" umgebracht.\n");
}

