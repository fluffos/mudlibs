inherit "std/npc";
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <actions.h>
#include <new_skills.h>
#include "/players/dante/myowndefine.h"


int wiealt=75;
int preis=5000;
object cash;
object stuhl;
int alter;

void create()
{

  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Tithon, der uralte Pflanzentrollmagier");
  SetProp(P_LONG, 
      "Der Pflanzentrollmagier ist schon sehr alt, aber ein sehr hinterlistiges Wesen. Seine dunklen "
      "Augen funkeln Dich listig an. Du solltest Dich vor ihm in Acht nehmen, denn "
      "schon viele Abenteurer machten den Fehler ihn zu unterschaetzen. Angeblich "
      "hat er sein ganzes Leben damit verbracht die Magie der Pflanzen "
      "zu studieren, doch sei Dir sicher, er wird Dir nichts davon verraten! "
      "Aussergewoehnlich, dass ein dummer Troll sich mit Magie beschaeftigt!!! "
      "Tithon soll ausserdem den beruehmten, legendaeren Rollstuhl besitzen!!! "
      "Frag ihn unbedingt danach!");

  SP(P_RACE, "Troll");

  AddDetail(({"auge","augen"}),
      "Dunkel und hinterlistig blinzeln Dich die Augen des Pflanzentrollmagier an.");
  AI("roc",
      "Ja, das ist doch der Typ da aus Stralsund der geil auf den schoenen Buzzom ist?!",
      "fragt: ");
  AI("buzzom",
      "Ein toller Typ! Roc ist verliebt in ihn!!!", "sagt: ");

  AI(({"hilfe","quest","abenteuer","aufgabe","aufgaben"}),
      "Achso, Du hast vom Fluch gehoert. Vor einiger Zeit hat mich der "
      "Vater eines Jungen bestohlen und so musste ich seinen Jungen verfluchen! "
      "Der Vater ist dann gestorben, oder hat er sich umgebracht?! Mir ist das "
      "egal! "
      "Das passiert, wenn man sich mit mir anlegt. Im Nordosten von hier, ist "
      "eine Ruine, da solltest Du Dich auch einmal umsehen. Da kannst Du mehr "
      "erfahren! Aber das wichtigste ist den Jungen zu finden!", "sagt: ");

  AI(({"jungen","fluch","rattenjunge","ruine", "junge","ratte","ratten"}),
      "Tja, der Vater hatte mich bestohlen und so verfluchte ich den Jungen! "
      "Der ist nun fuer immer und ewig eine Art grosse Ratte! In der Ruine haust "
      "angeblich auch der Geist des Vaters. Such den Rattenjungen und frage ihn aus. "
      "Weit von hier kann er nicht sein!", "sagt: ");
  AI(({"quadrat", "zahlen"}),
      "Du musst die Zahlen multiplizieren! Aber die richtigen drei Zahlen!",
      "sagt: ");

  AI(({"vater","rattenjungenvater","geist"}),
      "Der Geist des Vaters ist ein harter Gegner. Aber es gibt eine Moeglichkeit "
      "ihn schneller zu vernichten!", "sagt: ");
  AI(({"gegner","moeglichkeit"}),
      "Jeder Geist ist auf einen bestimmten Gegenstand anfaellig, zum Beispiel "
      "auf ein Yari oder das Repfile von Dante!", "sagt: ");
  AI(({"repfile", "repfile von dante"}),
      "Da stehen alle Typos und Bugs von Dante drinnen, Ich bezweifel, ob "
      "Du stark genug bist, es zu tragen, aber vielleicht findest Du ja "
      "einen anderen Gegenstand, der Dir helfen kann.", "sagt: ");
  AI(({"yari","yaris","urne"}),
      "Hmm, ja, was ist das Yari?! Schwer zu erklaeren! Geh zum Feldlager! "
      "Dort ist eine Urne!",
      "sagt: ");
  AI("gouffre",
      "Lebt irgendwo in der Ebene!", "sagt: ");
  AI("ebene",
      "Da ist es flach!", "lacht: ");



  SetProp(P_NAME,({ "Tithon, der Pflanzentrollmagier",
        "Tithon, des Pflanzentrollmagiers",
        "Tithon, dem Pflanzentrollmagier",
        "Tithon, den Pflanzentrollmagier"}));
  SetProp(P_GENDER, MALE);
  AddId(({"pflanzentroll","NOWIMPY", "NOCONTROLL""troll","magier","pflanzentrollmagier", "tithon"}));

  create_default_npc(35);
  SP(P_ARTICLE, 0);

  SetProp(P_HANDS, ({" mit seinen gruenen Klauen",190+random(20),({DT_MAGIC,DT_ACID,DT_BLUDGEON})}));
  SetProp(P_SIZE, 320+random(30));
  SetProp(P_ALIGN, 0);

  SetProp(P_ATTRIBUTES, ([A_INT:20, A_DEX:20, A_STR:40, A_CON:35]) );
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_BODY, 130);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_RESISTANCE_STRENGTHS, ([DT_MAGIC:-0.7, DT_FIRE:0.5, DT_BLUDGEON:-0.5,
     DT_TERROR:0.9, DT_ACID: 0.7, DT_SLASH: 0.3]));   
  SetProp(P_NOMAGIC,10);

  SetProp(P_MSGIN, "schlurft herein");
  SetProp(P_MSGOUT, "schlurft");
  SetProp(P_MMSGIN, "schlurft herein");
  SetProp(P_MMSGOUT, "schlurft davon");

  SetProp(P_DIE_MSG,  " zerfaellt zu gruenem Pflanzenstaub.\n");
  SetProp(P_NOCORPSE, 1 );
  SetProp(P_KILL_MSG, "bruellt: Dich verspeise ich mit Bambussprossen!\n");  
  SetProp(P_MSG_FLAGS, ([P_KILL_MSG:1, P_MURDER_MSG:1 ]));
  SP(P_MURDER_MSG, "bruellt: AHHH!!! Wo war meine Pflanzenmagie!\n");

  AddInfo(DEFAULT_INFO, ({
        "sagt: Du stellst aber kluge Fragen!\n",
        "spuckt vor Deine Fuesse.\n",
        "lacht nur ueber Dich.\n",
        "sagt: Ich habe fliegende Schweine gesehen.\n",
        "macht eine abwehrende Geste.\n",
        "staunt ueber so eine dumme Frage.\n",
        "gratuliert zu Deinem Wissen.\n",
        "sagt: Ja, Du hast vollkommen Recht.\n",
        "antwortet: Meine Mutter sagte das auch immer...\n",
        "fluestert: Bohr Dir doch ein Loch ins Knie...\n",
        "grinst Dich nur an.\n",
        "sagt: Hmm, Deine Ausruestung gefaellt mir.\n",
        "schaut Dich boese an.\n",
        "sagt: Naja, gib mir Geld, dann...\n"}));

  AI("elsurion",
      "HAHA! Dieses Weichei! Nein! Er ist ein maechtiger Zauberer! Leider ist "
      "er aber schon sehr alt und verkalkt! Alterssenil!", "sagt: ");

  AddInfo("dante", "Dante hat mich erschaffen.","sagt: ");
  AI("raetsel",
      "Frag mich lieber nach Rollstuhl!", "sagt: ");


  alter=30+random(100);

  cash=CLONEOB("/obj/money");
  cash->SP(P_AMOUNT, 2000+random(3000));
  cash->move(ME, M_NOCHECK);


  SetProp(P_SPELLRATE,65);

  AI(({"stuhl","rollstuhl"}),
      "Den kannst Du bei mir kaufen! "
      "Er kostet "+preis+" Muenzen! Aber Du musst alt genug sein! "
      "Zumindest "+wiealt+" Tage! Und mir eine Frage beantworten! "
      "Fuer Raetsel: syntax <raetsel>. "
      "Fuer Loesung: syntax: <loesung loesung>. "
      "Allerdings kostet jede falsche Antwort auch "+preis+" Muenzen! "
      "Doch keine Sorge, das Raetsel ist nicht unloesbar!",
      "lacht: ");




  set_living_name("tithon");


  AddSpell(1,1,
      "Der Pflanzentrollmagier versucht Dir Deine Waffe aus der Hand zu reissen!\n",
      "Der Pflanzentrollmagier versucht @WEM die Waffe aus der Hand zu reissen!\n",
      DT_MAGIC, "spell_zwing");

  AddSpell(1,1,
      "Der Pflanzentrollmagier haelt Dir Deine Augen zu!\n",
      "Der Pflanzentrollmagier haelt @WESSEN Augen zu!\n",
      DT_MAGIC, "spell_blind");

  AddSpell(1,1,
      "Der Pflanzentrollmagier saugt Dir Lebensenergie ab und heilt sich damit!\n",
      "Der Pflanzentrollmagier saugt @WEM Lebensenergie ab und heilt sich damit!\n",
      DT_MAGIC, "spell_zwing2");

  AddSpell(1,1,
      "Der Pflanzentrollmagier schreit: Eine Ruestung muss her!\n",
      "Der Pflanzentrollmagier schreit @WEN an: Eine Ruestung muss her!\n",
      DT_MAGIC, "spell_zwing3");

  AddSpell(1,1,
      "Der Pflanzentrollmagier schreit: GIB MIR DEIN GELD!\n",
      "Der Pflanzentrollmagier schreit @WEN an: GIB MIR DEIN GELD!\n",
      DT_MAGIC, "spell_muenzen");


  AddSpell(1,2,
      "Der Pflanzentrollmagier murmelt irgendeine seltsame Formel.\n",
      "Der Pflanzentrollmagier murmelt irgendeine seltsame Formel.\n",
      DT_MAGIC, "spell_unfug");

  AddSpell(1,1,
      "Der Pflanzentrollmagier dreht sich im Kreis und Dir schwinden alle Sinne.\n",
      "Der Pflanzentrollmagier dreht sich im Kreis und @WEM schwinden alle Sinne.\n",
      DT_MAGIC, "spell_trans");

  AddSpell(1,1,
      "Der Pflanzentrollnagier haelt eine eklige Kroete vor Dein Gesicht.\n",
      "Der Pflanzentrollmagier haelt @WEM eine Kroete vor das Gesicht.\n",
      DT_MAGIC, "spell_frog");

  AddSpell(5,300,
      "Der Pflanzentrollmagier wuergt Dich!\n",
      "Der Pflanzentrollmagier wuergt @WEN.\n",
      DT_SQUEEZE, ([SP_SHOW_DAMAGE:1]));

  AddSpell(5,350,
      "Der Pflanzentrollmagier schlaegt Dir mir der Faust auf die Nase.\n",
      "Der Pflanzentrollmagier schlaegt @WEM mit der Faust auf die Nase.\n",
      DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));

  AddSpell(5,300,
      "Der Pflanzentrollmagier bruellt Dich an.\n",
      "Der Pflanzentrollmagier bruellt @WEN an.\n",
      DT_TERROR, ([SP_SHOW_DAMAGE:1]));

  AddSpell(5,500,
      "Der Pflanzentrollmagier schleudert Baeume auf Dich.\n",
      "Der Pflanzentrollmagier schleudert Baeume auf @WEN.\n",
      DT_MAGIC, ([SP_SHOW_DAMAGE:1]));

  AddSpell(5,400,
      "Der Pflanzentrollmagier zaubert Dir einen Quellsamen in Deinen Magen.\n",
      "Der Pflanzentrollmagier zaubert einen Quellsamen in @WESSEN Magen.\n",
      DT_MAGIC, ([SP_SHOW_DAMAGE:1]));


  SetChats(3, ({
        "Der Pflanzentrollmagier grinst Dich boesartig an.\n",
        "Der Pflanzentrollmagier scheint etwas auszuhecken...\n",
        "Der Pflanzentrollmagier lacht laut.\n",
        "Der Pflanzentrollmagier sagt: Du bist ziemlich doof.\n",
        "Der Pflanzentrollmagier sagt: Gegen mich ist Elsurion ein Weichei!\n",
        "Der Pflanzentrollmagier kratzt seinen Buckel.\n",
        "Der Pflanzentrollmagier geht im Kreis.\n",
        "Der Pflanzentrollmagier murmelt irgendetwas.\n", 
        "Der Pflanzentrollmagier stinkt ziemlich.\n"}) );




  SUID;
  //CLONEME(WEAPON"st2");
  //absichtlich keinzuecken 

  ACD("raetsel", "raetsel");
  ACD("loesung", "get_stuhl");

}


void InformDefend(object enemy)
{
  Kill(enemy);
}


int raetsel()  {
  alter=30+random(100);
  write(BSA(
        "Wieviel Sekunden ist ein "+alter+" Tage alter Spieler alt?!",
        "Tithon fragt: "));	
  say(BS(
        "Tithon stellt "+TPN+" eine Frage!"), ({TP}));
  return 1; 
}


int get_stuhl(string str)  {

  int richtig;
  richtig=alter*86400;

  NF(BSA(
        "Was soll die dumme Antwort!", "Tithon sagt: "));

  if(!str) {
    write(BSA(
          "Die Syntax ist <raetsel loesung>!",
          "Tithon sagt: "));
    return 1; 
  }

  if(deep_present("rollstuhl", TP))  {
    write(BSA(
          "Sorry, Du hast schon einen Rollstuhl!",
          "Tithon sagt: "));
    return 1; 
  }

  if(TP->QueryMoney()<preis)  {
    write(BSA(
          "Aber Du hast zuwenig Muenzen!",
          "Tithon sagt: "));
    return 1; 
  }


  if(TP->QueryProp(P_AGE)<wiealt*43200)  {//imho ein hp = 2 seks daher!!!
    write(BSA(
          "Du bist leider viel zu jung!",
          "Trithon lacht: "));
    return 1; 
  }


  if(str!=""+richtig+"")  {

    write(BSA(
          "Nein! Leider total falsch!" 
          " Los neues Raetsel! Frag mich!",
          "Tithon lacht: "));
    alter=30+random(100);	
    TP->AddMoney(-preis);
    cash=CLONEOB("obj/money");
    cash->SP(P_AMOUNT, preis);
    cash->move(ME, M_NOCHECK);
    return 1; 
  }



  if(str==""+richtig+"")  {
    write(BSA(
          "Korrekt! Das ist richtig! "+richtig+" ist die Loesung! "
          "Hier ist Dein Rollstuhl! Viel Spass damit, Du Greis!",
          "Tithon sagt: "));
    alter=30+random(100);	
    stuhl=clone_object("/d/dschungel/dante/rstuhl/rstuhl");
    stuhl->move(TP, M_NOCHECK);
    TP->AddMoney(-preis);
    cash=CLONEOB("obj/money");
    cash->SP(P_AMOUNT, preis);
    cash->move(ME, M_NOCHECK); // mir is klar das is net gut
    //weils immer neue objs sind 5000 5000 usw....
    //dante
    return 1; 
  }

  return 0; 
}

Defend(int dam, string dtype, int spell, object enemy)    
{


  if (!pointerp(dtype))
    dtype = ({ dtype });


  /*        if (sizeof(dtype & ({ DT_FIRE }) ))
            {
            tell_room(environment(), "Der Pflanzentrollmagier freut sich.\n");
            heal_self(dam/2);
            return ::Defend(0, dtype, spell, enemy);
            }

*/   
  if (sizeof(dtype & ({ DT_MAGIC }) ))
  {
    heal_self(dam);
    tell_room(environment(), "Der Pflanzetrollmagier bedankt sich.\n");
    return ::Defend(0, dtype, spell, enemy);
  }

  if (sizeof(dtype & ({ DT_ACID }) ))
  {
    tell_room(environment(), "Der Pflanzetrollmagier windet sich vor Schmerzen.\n");
    return ::Defend(2*dam, dtype, spell, enemy);
  }


  if (sizeof(dtype & ({ DT_AIR }) ))
  {
    tell_room(environment(), "Der Pflanzetrollmagier lacht sehr laut ueber diesen Angriff!\n");
    return ::Defend(0, dtype, spell, enemy);
  }


  if (sizeof(dtype & ({ DT_WATER }) ))
  {
    tell_room(environment(), "Der Pflanzetrollmagier lacht ueber diesen Angriff!\n");
    return ::Defend(dam/4, dtype, spell, enemy);
  }

  if (sizeof(dtype & ({ DT_COLD }) ))
  {
    tell_room(environment(), "Der Pflanzetrollmagier schreit laut auf!\n");
    return ::Defend(dam+random(20), dtype, spell, enemy);
  }



  return ::Defend(dam, dtype, spell, enemy);    
}


init()
{
  object defender;	

  ::init();
  if (defender = present("vogelfalle")) AddDefender(defender);
  if(interactive(TP)) call_out("hallo",0);
}


void hallo()
{
  if(!present(this_player(), environment()) ) return;

  if(TP->QP(P_RACE)=="Troll")  {
    write(BSA(
          "Hallo "+TPN+"! Endlich wiedermal ein Troll hier!",
          "Tithon sagt: "));
  }


  if(deep_present("rollstuhl", TP))  {

    write(BSA(
          "AH! Du hast ja einen Rollstuhl "+TPN+", Du Greis!",
          "Tithon lacht: "));
  }



  else {

    switch(random(2))  {
      case 0:
        write(BS("Tithon sagt: Hallo "+TPN+"!\n"));
        break;
      case 1:
        write(BS("Tithon fragt Dich: Was fuehrt Dich zu mir?"));
        break;
      default: command("emote fragt Dich: Was fuehrt Dich zu mir?");
    }

  }

}


void spell_zwing(object enemy, int damage, mixed dam_type)
{

  object ob1;
  ob1= enemy->QueryProp(P_WEAPON);

  if ( ob1 && !(ob1->QueryProp(P_CURSED))  && !(ob1->QP(P_AUTOLOADOBJ)) &&

      !(ob1->QP(P_NODROP)) && !(ob1->QP(P_NEVERDROP)) && !(ob1->QP(P_MAGIC))  )

  {
    ob1->UnWield();
    ob1->move(ENV(ME), M_NOCHECK);

  }
  else

    tell_object(enemy,
        "Der Pflanzetrollmagier schlaegt Dir aus Zorn in den Bauch.\n");
  enemy->do_damage(10)+random(5);       
}





void spell_muenzen(object enemy, int damage, mixed dam_type)
{
  object ob;
  if (ob=present("muenzen",enemy) )
  {
    enemy->command_me("gib muenzen an tithon");
  }
  else
  {
    enemy->do_damage(10)+random(5);
    tell_object(enemy,
        "Der Pflanzentrollmagier schlaegt Dir aus Wut ueber Deine Armut ins Gesicht.\n");
  }
}

void spell_unfug(object enemy)
{
  switch(random(100))
  {
    case 0 .. 16 :
      enemy->SetProp(P_WIMPY_DIRECTION, "TOD");
      break;
    case 17 .. 35:

      if(enemy->QueryProp(P_GUILD)=="Berserker")  
        break;  


      enemy->SetProp(P_WIMPY, 0);
      tell_object(enemy,
          "Unglaublicher Mut ueberkommt Dich!\n");
      break;
    case 36 .. 47:
      tell_object(enemy,
          "Der Pflanzentroll bruellt: Das naechste Mal erwisch Ich Dich!!!\n");
      break;     
    case 48 .. 58:
      enemy->command_me("rufe Ich bin ein Feigling!\n");
      break;
    case 59 .. 73:
      enemy->command_me("zieh alles aus");
      break;
    case 74 .. 95:
      enemy->command_me("wirf alles weg");
      break;
    case 96 .. 100:
      enemy->command_me("gib alles an tithon");
      command("zieh alles an");             
  }
}

void spell_trans(object enemy)
{
  switch(random(100))
  {

    tell_object(enemy,
        "Tithon will Dich fortzaubern!\n");

    case 0 .. 20:
    enemy->move("/d/dschungel/dante/weg/room/weg3",M_NO_SHOW + M_TPORT);
    break;
    case 21.. 40:
    enemy->move("/d/dschungel/dante/weg/room/vorsprung",M_NO_SHOW + M_TPORT);
    break;
    case 41 .. 65:
    enemy->move("/d/dschungel/dante/stein/room/stein3",M_NO_SHOW + M_TPORT);
    break;
    case 66 .. 85:
    tell_object (enemy,
        "Der Pflanzentrollmagier schreit: Du Wurm hast nur Glueck gehabt!\n");
    break;

    case 86 .. 95:
    enemy->move("/d/gebirge/eros/room/berg_d18",M_NO_SHOW + M_TPORT);
    break;
    case 96 .. 100:
    enemy->move("/d/ebene/lamuerte/wwald/room/18y_29x", M_TPORT);          
  }
}



void spell_zwing2 (object enemy, int damage, mixed dam_type)
{
  switch(random(100))
  {

    tell_object(enemy,
        "Tithon versucht sich mit Deiner Energie zu heilen!\n");

    case 0 .. 35 :
    enemy->do_damage(10);
    heal_self(10);
    break;

    case 36 .. 60 :
    enemy->do_damage(20);
    heal_self(20);
    break;

    case 61 .. 77 :
    enemy->do_damage(30);
    heal_self(30);
    break;

    case 78 .. 91 :
    enemy->do_damage(40);
    heal_self(40);
    break;

    case 92 .. 100 :
    enemy->do_damage(50);                                            
    heal_self(50);
  }
}


void spell_zwing3 (object enemy, int damage, mixed dam_type)
{
  object ob;

  if( !ob && !(ob->QP(P_CURSED)) && !(ob->QP(P_AUTOLOADOBJ)) &&
      !(ob->QP(P_NODROP)) && !(ob->QP(P_NEVERDROP)) && !(ob->QP(P_MAGIC))  ) {

    write(BS(
          "Tithon flucht ueber "+enemy->name(WEN)+"!\n"));
    return;  
  }	


  if (ob=present("ruestung", enemy) )
  {

    enemy->command_me("gib ruestung an tithon");
    command("zieh ruestung an");
  }

  if (ob=present("panzer", enemy) )
  {
    enemy->command_me("gib panzer an tithon");
    command("zieh panzer an");
  }

  else
  {
    enemy->do_damage(10)+random(5);
    tell_object(enemy,
        "Der Pflanzentrollmagier schreit: Du bist ja fast nackt!\n");
  }
}

void spell_blind(object enemy)
{
  switch(random(100))
  {
    case 0 .. 50:
      enemy->SetProp(P_BLIND, 60);
      break;
    case 51.. 100:
      tell_object(enemy,
          "Der Pflanzentrollmagier schreit: Du hast nochmal Glueck gehabt!!!\n");
  }
}



void spell_frog(object enemy)
{
  switch(random(100))
  {
    case 0 .. 30:
      tell_object(enemy,
          "Du wirst ploetzlich ganz gruen!\n");

      enemy->SetProp(P_FROG, 1);
      break;
    case 31 .. 100:
      tell_object(enemy,
          "Der Pflanzentrollmagier schreit: Du hast nochmal Glueck gehabt!!!\n");
  }
}


die(arg)  {
  write_file("/d/dschungel/dante/weg/log/troll",
      ctime()+": Der Pflanzentrollmagier wurde von "+CAP(getuid(TP))+" umgebracht.\n");

  if(interactive(TP))  {

    domainshout(CAP(getuid(PL))+" hat Tithon bezwungen!\n");

  }

  ::die(arg);  
}


void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  write_file("/d/dschungel/dante/weg/log/troll",
      ctime()+": Der Pflanzentrollmagier hat gerade "+CAP(getuid(player))+" umgebracht.\n");

  NAL1
    heal_self(1000);
}
NAL2

