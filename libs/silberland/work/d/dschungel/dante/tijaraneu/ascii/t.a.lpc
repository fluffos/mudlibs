
#include "/players/dante/myowndefine.h"
inherit "std/thing";
#include <properties.h>
#include <language.h>
#include <ansi.h>

string motiv, region, farbe, color, hgfarbe;
void setze_werte(string motiv1, string region1, string farbe1,
 string color1, string hgfarbe1);



create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_GENDER, FEMALE);
  SetProp(P_MATERIAL, ([  MAT_MISC_HERBAL:40, MAT_MISC_DEAD:30,MAT_BLOOD:10,MAT_MISC_POISON:20]) );
  SetProp(P_WEIGHT,  0);
  SetProp(P_VALUE,  0);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_CURSED, 1);
  
  AddId(({"taetoo","taetto","taetto","taetowierung"}));
// ACD("test123", "test123");

seteuid(getuid(TO));
ACD(({"zeige","zeigen","zeig"}), "show");

}

 int show(string str)  {
string wem, was;
object wer;
int i;
object *alle;

if(!str) return 0;
	if(sscanf(str, "%s %s", wem, was)!=2)   {	
   return 0;
    }




if(sscanf(str, "%s %s", wem, was)==2)   {



   if( id(was) && wem=="allen" )  {
   
   if(!environment(TP)) {return 0;}
   	
   alle=all_inventory(environment(TP));

  if(!sizeof(alle))  { 
  write("Verflucht! Keiner da!\n");
  return 1;  }
  
  write("Du zeigst allen Anwesenden Deine Taetowierung!\n");
  
   tell_room(environment(TP),
 CAP_TPN+" zeigt Dir "
 ""+(TP->QueryProp(P_GENDER) == MALE ? "seine": "ihre")+" "+color+"e Taetowierung, "
 "die "+TP->QueryPronoun(WER)+" "+region+" hat.\n\n", ({TP}));
 
    for(i=0;i<sizeof(alle); i++)  {

   
    if(living(alle[i]) && TP->name()!= alle[i]->name() )  {
   
    tell_object(alle[i], ""+farbe+" "+hgfarbe+"\n");
 alle[i]->More(read_file(motiv));
 tell_object(alle[i],
 ""+ANSI_NORMAL+"\n"); 
               }	
      }
     return 1; 
      }



wer=find_living(wem);
 
 
if(wer && getuid(wer)==getuid(TP))  {

write(BS(
"Du solltest sie Dir besser genau anschauen!"));
return 1;  }


 if(wer && present(wer,environment(TP)) && id(was) )  {
 	
 	write(
 "Du zeigst "+wer->name(WEM)+" Deine Taetowierung.\n");

 tell_object(wer,
 CAP_TPN+" zeigt Dir "
 ""+(TP->QueryProp(P_GENDER) == MALE ? "seine": "ihre")+" "+color+"e Taetowierung, "
 "die "+TP->QueryPronoun(WER)+" "+region+" hat.\n\n");
 
 
 
 tell_object(wer,
 ""+farbe+" "+hgfarbe+"\n");
 wer->More(read_file(motiv));
 tell_object(wer,
 ""+ANSI_NORMAL+"\n"); 


 return 1; }
     }
 }



 int test123()  {
 	write (BS(
"region: "+region+", motiv "+motiv+", color "+color+" "));
return 1; }


void setze_werte(string motiv1, string region1, string farbe1, string color1,
string hgfarbe1)  {
     
     motiv=motiv1;
     region=region1;
     farbe=farbe1;
     color=color1;
     hgfarbe=hgfarbe1;     	
       
       AddId(""+region+"");
       
       }


_query_short()  {
	return "Eine "+color+"e Taetowierung "+region+"";
                 }	

	
_query_name()  {
	return ""+color+"e Taetowierung "+region+"";	
           }

_query_extralook()  {
	return BS(
    environment(TO)->Name()+" hat eine "+color+"e Taetowierung "+region+".");
    }	

_query_long()  {

	//write(""+farbe+" "+hgfarbe+"\n");
	
   return write(""+farbe+" "+hgfarbe+"\n") , TP->More(read_file(motiv)) , ""+ANSI_NORMAL+"\n";
   
            }
 
mixed _query_autoloadobj()
{
  return ({ region, motiv, QueryProp(P_IDS), farbe, color, hgfarbe });
}

void _set_autoloadobj(mixed arg)
{
  if (sizeof(arg) > 1)
  {
    region=arg[0];
    motiv=arg[1];
    AddId(arg[2]);
    farbe=arg[3];
    color=arg[4];
    hgfarbe=arg[5];
    
  }
}  	

//auskommentiert wegen interactive........->verschwinden. dante
//14.4
//query_once_interactive geaendert...16.4 dante

init()  {
	::init();
 if(!environment(TO)) { remove();  }
 if(!query_once_interactive(environment(TO)))  { remove();  }
}



reset()  {
    ::reset();
    if(!is_clone(TO))  { return;  }
     if(!environment(TO)) { remove();  }
      if(!query_once_interactive(environment(TO)))  { remove();  }
        }
  
      
