/* das haus von tithon dem uralten pflanzentrollmagier
   dante sl 2000
   */


inherit "std/room";
#include <properties.h>
#include <language.h>
#include <moving.h>
#include <wizlevels.h>
#include "/players/dante/myowndefine.h"



int da=1;

create()
{
  ::create();

  SetProp( P_INT_SHORT, "In Tithons Haus in Tijara" );
  SetProp( P_INT_LONG, BS(
        "Du befindest Dich nun im Haus von Tithon, dem uralten "
        "Pflanzentrollmagier. Der Raum ist sehr hoch, da sein Besitzer "
        "ja auch sehr gross ist. An den Waenden stehen einige Schraenke "
        "ueber denen Regale aus Holz angebracht sind. Eine alte, schwere "
        "Truhe steht in einer Ecke. Im Sueden fuehrt eine Tuer in die "
        "Privatraeume von Tithon. Im Nordwesten fuehrt eine Tuer wieder hinaus."));


  AD(({"raeume","privatraeume","privatraum"}),
      "Sie sind im Sueden. Dort gibt es angeblich grosse Schaetze zu holen.");
  AD(({"schatz","schaetze"}),
      "Los hol sie Dir!");
  AD("sueden",
      "Da geht es in die Privatraeume.");
  AD("nordwesten",
      "Da geht es hinaus.");

  AD(({"tuer","tuere"}),
      "Es gibt hier zwei davon.");

  AD("truhe",
      "Die Truhe besteht aus Metall und sieht sehr schwer aus.");
  AD("metall",
      "Hartes, schwarzes Metall.");
  AD(({"ecke","eck","ecken"}),
      "Es gibt derer vier. In einer steht die Truhe.");
  AD(({"schrank","schraenke"}),
      "Die Schraenke sind aus altem Holz. Einer ist gruen gestrichen!");

  AD(({"gruener schrank", "gruenen schrank"}),
      "Der gruene Schrank scheint wichtig zu sein!");


  AD("decke",
      "Die Decke ist aus braunem Holz.");
  AD("boden",
      "Der Boden ist auch aus Holz. Pflanzen liegen herum.");

  AD(({"wand","waende"}),
      "Die Waende sind ebenfalls aus Holz. Einige Regale sind an ihnen "
      "befestigt.");
  AD(({"regal","regale"}),
      "Auf den Regalen sind unzaehlige Pflanzen gelagert. "
      "Da steht auch eine Flasche.");
  AD("flasche",
      "Auf der Flasche ist ein Etikett.");
  AD("etikett",
      "Lies es!");

  ARD("etikett",
      "Nicht oeffnen!!!");

  AD(({"pflanze","pflanzen"}),
      "Ueberall haengen und liegen hier verschiedenste, Dir aber unbekannte "
      "Pflanzen!");
  AD("raum",
      "Der Raum bietet sehr viel Platz fuer all die Schraenke und Regale von "
      "Tithon.");
  AD(({"troll","magier","trollmagier","pflanzentrollmagier","pflanzentroll"}),
      "Tithon hat sich zeitlebens mit Pflanzen und ihrer Magie beschaeftigt.");
  AD("magie",
      "Angeblich gibt es viele magische Pflanzen.");
  AD("tithon",
      "Tithon, der Pflanzentrollmagier hat sich dieses Haus fuer seine "
      "letzen Jahre gebaut.");
  AD(({"jahr","jahre"}),
      "Er ist schon sehr alt und wird sicher bald sterben.");


  AD("haus",
      "Das Haus ist recht hoch und geraeumig. Es besteht gaenzlich aus Holz.");
  AD("holz",
      "Das Holz ist schon recht alt und braeunlich.");

  AD("platz",
      "Hier ist genug Platz.");
  AD("besitzer",
      "Das ist natuerlich Tithon!");


  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN:TT_HOUSE]) );

  AddSound( DEFAULT_SOUND,
      "Hier ist es sehr leise.");
  AddSmell( DEFAULT_SMELL,
      "Hmm, es riecht nach Pflanzen!");
  AddSmell(({"pflanzen","pflanze"}),
      "Es sind zu viele verschieden...");

  AIT("/d/dschungel/dante/tijaraneu/npc/titon", REFRESH_DESTRUCT);
  AIT("/d/dschungel/dante/tijaraneu/npc/fleisch", REFRESH_DESTRUCT);

  if(!random(3))  {
    AIT("/d/dschungel/dante/tijaraneu/npc/fleisch", REFRESH_DESTRUCT); 
  }

  if(!random(10)) {
    AIT("/d/dschungel/dante/tijaraneu/npc/fleisch", REFRESH_DESTRUCT); 
  }

  if(!random(15))  {
    AIT("/d/dschungel/dante/tijaraneu/npc/fleisch", REFRESH_DESTRUCT); 
  }


  AE("nordwestoben", "./ti_pfad4");

  ASE("sueden", "go_dead");

  ACD(({"oeffne","oeffnen"}), "open_func");
  SP(P_KILL_NAME, "Eine Giftpflanze in Tithons Haus");
}


int go_dead()  {

  if(present("tithon", environment(TP))) {
    write(BSA(
          "HE! "+CAP_TPN+", was soll das! Hier geblieben!",
          "Tithon bruellt: "));
    return 1; 
  }

  if(!IS_SEER(TP))  {
    write(BSA(
          "Du bist kein Seher und darfst daher nicht nach hinten gehen!",
          "Dante teilt Dir mit: "));
    return 1; 
  }


  write(BS(
        "Du als Seher darfst nach hinten gehen!"));
  TPM("/d/dschungel/dante/tijaraneu/room/tihi", M_GO,
      "stolz in die Privatraeume von Tithon", "marschiert",
      "kommt stolz herein");
  return 1; 
}


int open_func(string str)  {
  object ob, ob1, ob2, ob3;	
  NF(BS("Was willst Du oeffnen?! Hier gibts einiges!"));

  if(!str) return 0; 

  if(present("tithon", environment(TP)))  {

    write(BSA( "Nein, "+TPN+"! Das geht nicht! Lass das!",
          "Tithon sagt: "));  
    return 1; 
  }

  if(str=="flasche")   {

    write(BS(
          "Du oeffnest die Flasche! Gruener Dampf stroemt heraus! "
          "Du machst sie schnell wieder zu!"));
    say(BS(
          CAP_TPN+" oeffnet eine Flasche! Dampf stroemt heraus!!!"));
    TP->AddHP(-10-random(10));
    TP->SP(P_FROG, 1);	
    return 1; 
  }

  if(str=="truhe")  {

    write(
        "Du oeffnest die Truhe!\n"
        "Eine Giftpflanze schiesst heraus und greift Dich an!\n"
        "Die Giftpflanze trifft Dich sehr hart!\n");
    TP->do_damage(10+random(10));
      write(
        "Du verfehlst die Giftpflanze!\n"
        "Die Giftpflanze trifft Dich hart!\n\n");
    TP->do_damage(6+random(6));
    write(
        "Ploetzlich ist die Giftpflanze wieder weg und die Truhe zu!\n\n"
        "HE! Was war das denn?!\n");

    TP->AddPoison(0+random(2));//0 - 1
    say(BS(
          CAP_TPN+" unterliegt einer optischen Taeuschung!"));
    return 1; 
  }


  if(str=="schrank"||str=="schraenke")  {
    write(BS( "Welchen Schrank genau!")); 
    return 1; 
  }

  if(str=="gruener schrank"||str=="gruenen schrank") {

    write(BS("Du oeffnest den gruenen Schrank!"));	

    say(BS( CAP_TPN+" oeffnet einen Schrank!"));

    if(da)  {
      write(BS( "Du findest darin einige Pflanzen!"));
      switch(random(4))
      {
        case 0:
          ob=clone_object("d/dschungel/feyaria/tijara/obj/giftefeu");
          ob->move(TP, M_NOCHECK);
          break;

        case 1:
          ob1=clone_object("d/dschungel/feyaria/tijara/obj/wunder");
          ob1->move(TP, M_NOCHECK); 
          break;

        case 2:
          ob2=clone_object("d/dschungel/feyaria/tijara/obj/rbalsam");
          ob2->move(TP, M_NOCHECK);
          break;

        case 3:
          ob3=clone_object("d/dschungel/feyaria/tijara/obj/wirsel");
          ob3->move(TP, M_NOCHECK);
          break;
      }
    da--;
    return 1; 
    }
    if(!da)  {
      write(BS( "Leider ist der Schrank leer!"));
      say(BS( CAP_TPN+" schaut dumm aus!"));
      return 1; 
    }
    return 0; 
  }
  return 0; 
}


reset() {
  ::reset();
  da=1;   
}


