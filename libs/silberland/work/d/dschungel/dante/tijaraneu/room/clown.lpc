//dante sl 97-99


#include "/players/dante/myowndefine.h"

inherit "/d/dschungel/dante/tijaraneu/room/clown_inh";

#include <properties.h>
#include <language.h>
#include <moving.h>
create()
{
  clown_create();

  SetProp( P_INT_SHORT, "Bei den Clowns" );
  SP(P_INT_LONG, QP(P_INT_LONG)+"Im Suedwesten ist eine Tuere die "
      "wieder hinaus fuehrt. Im Osten, Sueden und Norden liegen andere Raeume.");

  AD("raeume",
      "Geh doch einfach hin!");
  AD(({"osten","sueden","norden"}),
      "Geh hin!");

  AddExit("osten", "./clown2");
  AddExit("norden","./clown3");
  AddExit("sueden","./clown4");

  AD(({"tuer","tuere"}),
      "Die Tuere fuehrt nach draussen.");
  AddCmd(({"spiel","spiele"}), "out");
  AD("suedwesten",
      "Im Suedwesten ist eine Tuere.");

  ACD(({"oeffne","oeffnen"}), "nix");
  ASE("suedwesten", "nix2");
}

int nix(string str)  {
  NF("Was willst Du oeffnen?!\n");
  if(!str) return 0;

  if(str=="tuer"||str=="tuere")  {      
    write(BS(
          "Du reisst an der Tuere herum, aber so kommt man nicht aus dem Haus."));
    say(BS(
          CAP_TPN+" reisst an der Tuere herum. Vergeblich!"));
    return 1; 
  }
  return 0; 
}



int out (string str)
{
  notify_fail("Womit willst Du spielen ?\n");

  if (!str)
  {
    return 0;
  }

  if ( str == "mit spielzeug" || str == "mit spielsachen")
  {
    write(BS("Du kniest Dich auf den Boden und beginnst wie ein kleines Kind "
          "zu spielen. Bald vergeht Dir aber der Spass an der Sache und Du stehst "
          "wieder auf. Dann geht die Tuere auf und Du kannst hinaus."));
    TP->move("/d/dschungel/dante/tijaraneu/room/ti_pfad2", M_GO,
        "durch die Tuere nach draussen", "verschwindet", "kommt aus dem bunten Haus heraus");
    return 1;
  }
  return 0;
}


int nix2()  {
  write(BS(
        "Du laeufst mit voller Wucht in die Tuere! AUA!"));
  say(BS(
        CAP_TPN+" laueft voll gegen die Tuere! AUA!"));
  TP->do_damage(5);
  return 1;
}

