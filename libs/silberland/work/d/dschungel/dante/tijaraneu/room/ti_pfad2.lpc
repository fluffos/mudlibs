/*
pfad von alttijara nach neuneutijara 
dante 99.08.29

*/


#include "/players/dante/myowndefine.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <wizlevels.h>
#include <moving.h>
#include <mnpc.h>

int heilen=3;

reset()  {
  ::reset();
 heilen=3; }


create()
{
  ::create();

  SetProp( P_INT_SHORT, "Ein kleiner Pfad in Tijara" );
  SetProp( P_INT_LONG, BS(
  "Du befindest Dich nun auf einem schmalen Pfad in Tijara. Er verbindet "
  "das Wohngebiet mit den neueren Teilen der Stadt. "
  "Eine auffaellige Statue steht am Rande des Pfades. Am Boden liegen "
  "helle Kieselsteine und vom Himmel brennt die Sonne erbarmungslos "
  "herab. Im Nordosten sieht man ein sehr buntes, grosses Haus. "
   "Der Hauptplatz liegt im Nordwesten von hier. "
  "Der Pfad laeuft weiter nach Suedosten."));
  
  SetProp( P_LIGHT, 2 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 29, ENV_TERRAIN: TT_TOWN]) );
//alles exakt wie bei fey

AD("nordosten",
"Da steht ein gross, bunt verziertes Haus.");
AD("haus",
"Das Haus ist sehr bunt verziert. An der Tuer haengt eine Maske.");
AD("maske",
"Die Maske soll wohl einen Clown darstellen.");
AD("clown",
"Der Clown sieht recht lustig aus mit seiner fetten, roten Nase.");
AD("nase",
"Die Nase ist allzu fett. Drueck sie doch!");
AD(({"tuer","tuere"}),
"Die Tuere scheint seltsam zu sein. Keine Schnalle, nichts.");
AD("schnalle",
"Eben keine.");


AD("decke",
"Nur der Himmel ist hier.");
AD(({"wand","waende"}),
"Der Pfad ist bis auf den Nordwesten und Suedosten von Waenden umgeben.");



AddDetail("pfad",
"Der Pfad fuehrt nach Suedosten in die neueren Teile von Tijara.");
AddDetail(({"teil","teile"}),
"Sie wurden erst nachtraeglich angebaut, denn Tijara waechst und waechst.");
AddDetail("suedosten",
"Der Pfad fuehrt weiter nach Suedosten.");
AddDetail(({"kieselstein","kiesel","kieselsteine"}),
"Die Kieselsteine sind natuerlich viel kleiner als die anderen Steine. Sie "
"sind hell und sauber.");



  
  AddDetail( ({ "tijara", "stadt" }), BS(
    "Du befindest Dich mitten in den neueren Teilen von Tijara.") );
  AddDetail( ({ "sonne", "himmel", "hitze" }), BS(
    "Die Sonne brennt erbarmungslos vom Himmel herunter, und das ist auch "
    "der Grund fuer die Hitze hier.") );
 
  AddDetail( ({ "strasse", "weg", "knick" }), 
 "Die Strasse liegt im Nordwesten.");
 
  AddDetail( ({ "hauptplatz", "platz" }), BS(
    "Der Hauptplatz von Tijara ist im Nordwesten. Er scheint sehr gross zu "
    "sein, aber Du bist noch zu weit weg, um naeheres erkennen zu "
    "koennen.") );
  AddDetail( ({ "gardist", "gardisten" }), BS(
    "Obwohl die Gardisten die Stadt sehr gut bewachen, ist gerade keiner "
    "in der Naehe.") );
  AddDetail( ({ "boden", "stein", "steine"}), BS(
  "Der Boden ist uebersaeht mit Kieselsteinen, die wohl den Pfad bilden."));
  
  
  AddDetail( ({ "wohngebiet", "wohnung", "wohnungen", "gebiet" }), BS(
   "Das Wohngebiet liegt etwas weiter im Nordwesten."));
   

AD("nordwesten",
"Dort liegt die Strasse, das Wohngebiet und noch weiter nordwestlich "
"dann der Hauptplatz.");

AD(({"rand","rande"}),
"Am Rande des Pfades steht eine Statue.");
AD("statue",
"Die Statue stellt Feyaria dar.");
AD("feyaria",
"Feyaria, eine Elfin, ist die Gruenderin dieser Stadt. Sie laechelt freundlich "
"und scheint Dir eine Hand zum Gruss zu reichen.");

AD(({"elf","elfin"}),
"Kennst Du doch...");

AD("gruenderin",
"Sie hat diese Stadt urspruenglich erschaffen.");
AD("gruss",
"Du solltest den Gruss irgendwie erwidern...");
AD("hand",
"Hmm, Feyarias Hand ist zu weit oben. Wie koennte man Feyaria nur gruessen?!");



  AddExit( "nordwesten", "./ti_pfad1" );
  AddExit( "suedosten", "./ti_pfad3" );

ASE("nordosten", "nix2");

ACD(({"gruesse","gruess"}), "get_lps");
ACD(({"oeffne","oeffnen"}), "nix1");
ACD(({"druecke","drueck"}), "get_in");



AIT("/d/dschungel/feyaria/tijara/npc/gardist", REFRESH_DESTRUCT,
  ([ 
    P_MNPC_AREA: "/d/dschungel/dante/tijaraneu/room/",
    P_MNPC_DEFAULTROOM: "/d/dschungel/dante/tijaraneu/room/ti_pfad2"]));



 AddSound( DEFAULT_SOUND,
     "Du kannst bereits das rege Treiben aus Tijara hoeren.");
     AddSound(({"treiben","tijara"}),
     "Wie eine Stadt eben so ist.");
       AddSmell( DEFAULT_SMELL,
  "Es riecht nach Elfen?!");
  AddSmell(({"elfen","elf"}),
  "Hmm, es ist wohl das Parfum vom Feyaria!");
  AddSmell(({"parfum","feyaria"}),
  "Bezaubernd!!!");
           

}


get_in(string str)  {
   NF("Was willst Du druecken?\n");
   if(str=="nase")  {
   write(BS(
   "Du drueckst die Nase des Clowns, die Tuere geht auf und schwupp "
   "bist Du auch schon drinnen."));
   TPM("/d/dschungel/dante/tijaraneu/room/clown", M_GO,
   "durch die Tuere ins Haus", "geht", "kommt herein");
   return 1; }
  return 0; }
   

int nix2()  {
  write(BS(
  "Du laeufst mit voller Wucht in die Tuere! AUA!"));
  say(BS(
  CAP_TPN+" laueft voll gegen die Tuere! AUA!"));
  TP->do_damage(5);
  return 1; }
  
  

int nix1(string str)  {
  NF("Was willst Du oeffnen?!\n");
     if(!str) return 0; 
     if(str=="tuer"||str=="tuere")  {
     write(BS(
     "Du reisst an der Tuere herum, aber so kommt man nicht ins Haus."));
     say(BS(
     CAP_TPN+" reisst an der Tuere herum. Vergeblich!"));
     return 1; }
  return 0; }
     



int get_lps(string str)  {
  NF("Wen willst Du hier gruessen?!\n");
     if(!str) return 0; 
 if(str=="feyaria")  {
   if(heilen)  {
   
   say(BS(
   CAP_TPN+" macht sich an der Statue zu schaffen."));
    
    write(BS(
    "Du gruesst Feyaria und sie zwinkert Dir freundlich zu. "
    "Ploetzlich fuehlst Du Dich staerker."));
    TP->heal_self(25+random(25));
    heilen--; 
    return 1; }
       

if(!heilen)  {
   say(BS(
   CAP_TPN+" macht sich an der Statue zu schaffen."));
    
    write(BS(
    "Du gruesst Feyaria und sie zwinkert Dir freundlich zu."));
       return 1; }
    return 0; }
return 0; }


   
