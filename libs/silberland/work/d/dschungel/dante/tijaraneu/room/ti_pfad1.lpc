/*
pfad von alttijara in neutijara 
dante 99.08.29

*/


#include "/players/dante/myowndefine.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <wizlevels.h>
#include <moving.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Ein kleiner Pfad in Tijara" );
  SetProp( P_INT_LONG, BS(
  "Du befindest Dich nun auf einem schmalen Pfad in Tijara. Er verbindet "
  "das Wohngebiet mit den neueren Teilen der Stadt. Am Boden liegen "
  "helle Kieselsteine und vom Himmel brennt die Sonne erbarmungslos "
  "herab. Der Hauptplatz liegt im Nordwesten von hier und im Norden "
  "steht das Haus von Gonzo. Im Sueden "
  "befindet sich ein kleines Gebaeude, auf dem ein Schild haengt. "
  "Der Pfad laeuft weiter nach Suedosten."));
  
  SetProp( P_LIGHT, 2 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 29, ENV_TERRAIN: TT_TOWN]) );
//alles exakt wie bei fey
AD("decke",
"Nur der Himmel ist hier.");
AD(({"wand","waende"}),
"Der Pfad ist bis auf den Nordwesten und Suedosten von Waenden umgeben.");


AD("gebaeude",
"Es ist ein Edelsteinladen.");
AD(({"edelsteinladen","laden"}), 
"Betritt ihn doch!");
AD("schild",
"Lies es!");
ARD("schild",
"+----------------+\n"
"|  Willkommen !  |\n"
"+----------------+\n");
AD("sueden",
"Da liegt ein kleines Gebaeude.");


AddDetail("pfad",
"Der Pfad fuehrt nach Suedosten in die neueren Teile von Tijara.");
AddDetail(({"teil","teile"}),
"Sie wurden erst nachtraeglich angebaut, denn Tijara waechst und waechst.");
AddDetail("suedosten",
"Der Pfad fuehrt weiter nach Suedosten.");
AddDetail(({"kieselstein","kiesel","kieselsteine"}),
"Die Kieselsteine sind natuerlich viel kleiner als die anderen Steine. Sie "
"sind hell und sauber. Hmm, da sieht man eine Spur!");

AD("spur",
"Hmm, sie fuehrt direkt auf eine Wand zu. Hmm, seltsam. Sollte man vielleicht "
"probieren durch die Wand zu gehen?!");




  AddDetail( ({"gonzohaus", "haus von gonzo", "seherhaus von gonzo", 
               "gonzo", "haus"}),
    "Das Haus von Gonzo liegt im Norden."); 
  AD("norden",
  "Da ist das Haus von Gonzo. Von hier aus kannst Du es nicht betreten.");
  
  
  AddDetail( ({ "tijara", "stadt" }), BS(
    "Du befindest Dich mitten in den neueren Teilen von Tijara.") );
  AddDetail( ({ "sonne", "himmel", "hitze" }), BS(
    "Die Sonne brennt erbarmungslos vom Himmel herunter, und das ist auch "
    "der Grund fuer die Hitze hier.") );
 
  AddDetail( ({ "strasse", "weg", "knick" }), 
 "Die Strasse liegt im Nordwesten.");
 
  AddDetail( ({ "hauptplatz", "platz" }), BS(
    "Der Hauptplatz von Tijara ist im Nordwesten. Er scheint sehr gross zu "
    "sein, aber Du bist noch zu weit weg, um naeheres erkennen zu "
    "koennen.") );
  AddDetail( ({ "gardist", "gardisten" }), BS(
    "Obwohl die Gardisten die Stadt sehr gut bewachen, ist gerade keiner "
    "in der Naehe.") );
  AddDetail( ({ "boden", "stein", "steine"}), BS(
  "Der Boden ist uebersaeht mit Kieselsteinen, die wohl den Pfad bilden."));
  
  
  AddDetail( ({ "wohngebiet", "wohnung", "wohnungen", "gebiet" }), BS(
   "Das Wohngebiet liegt etwas weiter im Nordwesten."));
   

AD("nordwesten",
"Dort liegt die Strasse, das Wohngebiet und noch weiter nordwestlich "
"dann der Hauptplatz.");

  AddExit( "nordwesten", "/d/dschungel/feyaria/tijara/room/wohn_f5" );
  AddExit( "suedosten", "./ti_pfad2" );
  AddExit("sueden", "/d/dschungel/dante/gemquest/gemladen");

 AddSound( DEFAULT_SOUND,
     "Du kannst bereits das rege Treiben aus Tijara hoeren.");
     
        AddSound(({"treiben","tijara"}),
             "Wie eine Stadt eben so ist.");
     
       AddSmell( DEFAULT_SMELL,
"Es riecht nach stinkenden Magiern!");
AddSmell(({"magier","magiern" }),
"PFUI!!! EXTRA PFUI!!!");

ACD(({"gehe","geh"}),"nix");
}

int nix(string str) {
 NF("Wo willst Du durchgehen?! <syntax: gehe durch wand>\n");
  if(!str) return 0; 
  
  if(str=="durch wand")  {
  
    write(BS(
    "Du versuchst durch die Wand zu gehen!!! WUMMM!!! Voll knallst Du gegen "
    "die Wand und faellst einfach um!"));
    say(BS(
    CAP_TPN+" knallt mit dem Kopf voll gegen eine Wand und faellt dann um!"));


TP->SetProp(P_PARALYZED, ([PARALYZE_TIME: 1+ random(4),
      PARALYZE_MSG: "Aber Du bist doch bewusstlos!\n",
   PARALYZE_MSG_OTHER: "%s wird bewusstlos!\n",                                 
    PARALYZE_END: "Du erwachst wieder aus Deiner Bewusstlosigkeit.\n",
    PARALYZE_END_OTHER: "%s erwacht wieder aus "
    +TP->QueryPossPronoun(FEMALE,WEN,SINGULAR)+" Bewusstlosigkeit.\n"]));
    
    return 1; }
return 0; }

    