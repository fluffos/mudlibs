
#include "/players/dante/myowndefine.h"

inherit "/d/dschungel/dante/tijaraneu/room/clown_inh";

#include <properties.h>
#include <language.h>
#include <moving.h>
create()
{
  clown_create();

  SetProp( P_INT_SHORT, "Bei Enrico" );
  AddExit("sueden", "./clown");
  
  AddItem("/d/dschungel/dante/tijaraneu/npc/enrico", REFRESH_DESTRUCT);
  
  AddCmd(({"spiel","spiele"}), "out");
    
}

int out (string str)
{
   notify_fail("Womit willst Du spielen ?\n");
   
   if (!str)
   {
   return 0;
   }
   
   if ( str == "mit spielzeug" || str == "mit spielsachen")
   {
   write("Du kniest Dich auf den Boden und beginnst wie ein kleines Kind "
   "zu spielen. Bald vergeht Dir aber der Spass an der Sache und Du stehst "
   "wieder auf.\n");
   return 1;
   }
   return 0;
}
