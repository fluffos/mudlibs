//dante sl 97-99
#include "/players/dante/myowndefine.h"
#include <properties.h>
#include <language.h>
#include <moving.h>

inherit "std/room";

void clown_create()
{
  ::create();

  SetProp( P_INT_LONG, BS(
        "Du stehst nun mitten in dem bunten Haus und blickst Dich um. "
        "Die Umgebung scheint sehr lustig zu sein! Ein grosser "
        "heller, freundlicher Raum erheitert Dich. "
        "Bunte Clowns zieren eine farbenfrohe "
        "Tapete und lachen Dich "
        "freundlich an. Der rote Teppich ist uebersaeht mit Spielzeug aller Art "
        "und "
        "Du fuehlst Dich fast wie in Deinem alten Kinderzimmer. Wer mag wohl hier "
        "wohnen ?"));

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN:TT_HOUSE]) );
  AD("art",
      "Alles moegliche.");
  AD("haus",
      "Du stehst mitten drin im Haus!");
  AddDetail(("umgebung"),
      "Hier sieht es aus wie ein einem Spielzimmer...");
  AddDetail(({"spielzimmer","kinderzimmer","zimmer"}),
      "Bunte, frohe Farben, Spielsachen wohin man auch schaut...");
  AddDetail(({"spielsachen","sachen"}),
      "Du bist fast versucht mit ihnen zu spielen...");
  AddDetail(({"farbe","farben"}),
      "Jegliche erdenkliche Farbe findet man in diesem Raum...");
  AddDetail(("raum"), QueryProp(P_INT_LONG) );
  AddDetail(("licht"),
      "Bunte Lampen haengen an der Decke und verbreiten ein helles, "
      "freundliches Klima.");
  AD("klima",
      "Freundlich!");

  AddDetail(("decke"),
      "Die Decke ist hellblau gestrichen und bunte Lampen haengen herab.");
  AddDetail(({"lampe","lampen"}),
      "Die Lampen strahlen freundlich und schaffen eine angenehme Atmosphaere.");
  AddDetail(("atmosphaere"),
      "Du fuehlst Dich hier richtig wohl...");
  AddDetail(({"tapete", "tapeten"}),
      "Die Tapete ist voller bunter Clowns, die Kunststuecke vollfuehren und "
      "allerlei "
      "Schabernack treiben...");
  AddDetail(({"kunststuecke","kunststueck"}),
      "Alles was man sich nur so ausdenken kann wird hier gezeigt...");
  AddDetail(("schabernack"),
      "Ein dummes Wort...");
  AddDetail(({"wand","waende"}),
      "Die Waende sind voller bunter Tapeten...");

  AddDetail(({"zeug","spielzeug"}),
      "Wild verstreut liegt es ueber den ganzen Boden veteilt...");
  AddDetail(("boden"),
      "Am Boden sieht man einen bunten Teppich der uebersaet ist mit "
      "Spielsachen.");
  AddDetail(({"clown","clowns"}),
      "Die Clowns sehen alle gleich aus, nur einer in einem rotem Kostuem "
      "sieht anders aus...");
  AddDetail(("kostuem"),
      "Du ueberlegst und erkennst Pennywise...");
  AddDetail(("pennywise"),
      "Pennywise ist ein boesartiger, kindermordender Clown, ein Monster. "
      "Irgendwo "
      "hier ganz nahe muss er sein...");
  AddDetail(("monster"),
      "Huete Dich vor ihm...");
  AddDetail(("teppich"),
      "Dick und weich liegt er am Boden...");

  AddSound( ({DEFAULT_SOUND, "lied", "kinderlied", "stimme"}),
      "Du hoerst ein altes bekanntes Kinderlied gesungen von einer "
      "unheimlichen Stimme...");

  AddSmell( ({DEFAULT_SMELL, "popcorn", "lakritze"}),
      "Hier riecht es nach Popcorn und Lakritze...");

}

