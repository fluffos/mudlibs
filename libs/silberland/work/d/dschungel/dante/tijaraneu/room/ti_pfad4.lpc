/*
   pfad von alttijara nach neuneutijara 
   dante 99.08.29

*/


#include "/players/dante/myowndefine.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <wizlevels.h>
#include <moving.h>

int i;


int da=3;

void reset()  {
  ::reset();
  da=3;
}


void create()
{
  ::create();

  SetProp( P_INT_SHORT, "Ein kleiner Pfad in Tijara" );
  SetProp( P_INT_LONG, BS(
        "Du befindest Dich nun auf einem schmalen Pfad in Tijara. Er verbindet "
        "das Wohngebiet mit den neueren Teilen der Stadt. "
        "Am Boden liegen helle Kieselsteine und ein groesserer Brocken. "
        "Vom Himmel brennt die "
        "Sonne erbarmungslos "
        "herab. Im Suedosten steht ein Holzhaus, das voellig mit "
        "Pflanzen ueberwuchert ist. Es ist etwas vertieft, "
        "und der Pfad geht direkt daran vorbei! Wer da wohl wohnen mag? "
        "Der Hauptplatz liegt im Nordwesten von hier. "
        "Der Pfad laeuft weiter nach Suedosten! HE, da steht etwas sehr "
        "merkwuerdiges! Ein Haus, von dem sehr helles Licht ausgeht!"
        " Es steht auf Pfaehlen, ist also ein Pfahlhaus. Im Norden ist die "
        "Baeckerei von Tijara!"));
  SetProp( P_LIGHT, 2 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 29, ENV_TERRAIN: TT_TOWN]) );
  //alles exakt wie bei fey

  AddDetail(({"norden","baeckerei"}),
      "Besuche sie unbedingt!!! Ein Schild steht davor.");
  AddDetail("schild",
      "Da steht nur 'BAECKEREI'. Langweilig.");
  ARD("schild",
      "Untersuche es!");
  AddDetail( ({"licht"}), 
      "Es geht von dem Pfahlhaus aus.");
  AddDetail(({"pfaehle","pfahl"}),
      "Dicke Pfaehle aus Holz, auf denen das Pfahlhaus steht. Um nach Osten zu "
      "gelangen muss man unter dem Haus durch. Sozusagen eine Bruecke! "
      "Achja, eine Leiter zum raufklettern steht da auch noch.");
  AddDetail("leiter",
      "Damit gehts es nach oben!");
  AddDetail("pfahlhaus",
      "Hmm, wer da wohl leben mag! Kletter einfach rauf!");
  AddDetail("bruecke",
      "Naja, so in etwa eben.");
  AddDetail("haus",
      "Welches Haus! Holzhaus oder Pfahlhaus!");
  AddDetail(({"holzhaus"}),
      "Das Haus ist aus braunem Holz erbaut. Wild haengen Pflanzen vom Dach herab.");
  AddDetail("holz",
      "Das Holz ist schon recht alt, aber trotzdem sehr stabil.");
  AddDetail("dach",
      "Die Pflanzen wachsen vom Dach bis ganz nach unten.");
  AddDetail(({"pflanze","pflanzen"}),
      "Sie bedecken schon fast das gesamte Haus!");
  AddDetail("grund",
      "Ja, das ist er!");
  AddDetail("brocken",
      "Der Brocken scheint ist sehr massiv und schwer. Ob man ihn umdrehen kann?");
  AddDetail("suedosten",
      "Im Suedosten steht ein Holzhaus.");
  AddDetail("decke",
      "Nur der Himmel ist hier.");
  AddDetail(({"wand","waende"}),
      "Der Pfad ist bis auf den Nordwesten und Suedosten von Waenden umgeben.");
  AddDetail("nordwesten",
      "Da geht der Pfad direkt nach Tijara weiter.");
  AddDetail("pfad",
      "Der Pfad fuehrt nach Suedosten in die neueren Teile von Tijara.");
  AddDetail(({"teil","teile"}),
      "Sie wurden erst nachtraeglich angebaut, denn Tijara waechst und waechst.");
  AddDetail("suedosten",
      "Der Pfad fuehrt weiter nach Suedosten.");
  AddDetail(({"kieselstein","kiesel","kieselsteine"}),
      "Die Kieselsteine sind natuerlich viel kleiner als die anderen Steine. Sie "
      "sind hell und sauber.");
  AddDetail( ({ "tijara", "stadt" }), BS(
        "Du befindest Dich mitten in den neueren Teilen von Tijara.") );
  AddDetail( ({ "sonne", "himmel", "hitze" }), BS(
        "Die Sonne brennt erbarmungslos vom Himmel herunter, und das ist auch "
        "der Grund fuer die Hitze hier.") );
  AddDetail( ({ "strasse", "weg", "knick" }), 
      "Die Strasse liegt im Nordwesten.");
  AddDetail( ({ "hauptplatz", "platz" }), BS(
        "Der Hauptplatz von Tijara ist im Nordwesten. Er scheint sehr gross zu "
        "sein, aber Du bist noch zu weit weg, um naeheres erkennen zu "
        "koennen.") );
  AddDetail( ({ "gardist", "gardisten" }), BS(
        "Obwohl die Gardisten die Stadt sehr gut bewachen, ist gerade keiner "
        "in der Naehe.") );
  AddDetail( ({ "boden", "stein", "steine"}), BS(
        "Der Boden ist uebersaeht mit Kieselsteinen, die wohl den Pfad bilden."));
  AddDetail( ({ "wohngebiet", "wohnung", "wohnungen", "gebiet" }), BS(
        "Das Wohngebiet liegt etwas weiter im Nordwesten."));
  AddDetail("nordwesten",
      "Dort liegt die Strasse, das Wohngebiet und noch weiter nordwestlich "
      "dann der Hauptplatz.");

  AddSound( DEFAULT_SOUND,
      "Du glaubst Kinder schreien zu hoeren.");
  AddSound("kinder",
      "IHHHH!!!!!!!Kreisch!!!!");

  AddSmell( DEFAULT_SMELL,
      "Es riecht recht frisch hier.");

  AddExit("norden", "./baeck");
  AddExit( "nordwesten", "./ti_pfad3" );
  AddExit( "suedosten", "./ti_pfad5" );
  AddExit("suedostunten", "./titonhaus");

  AddSpecialExit("oben", "check");

  for(i=0;i<random(3)+1;i++)
    AIT("/d/dschungel/dante/weg/npc/dratte", REFRESH_DESTRUCT);

  ACD(({"drehe","dreh"}), "turn_stone");
}

int check()  {

  if(TP->QP(P_TOTAL_LIGHT) < -5 )  {
    write(BS(
          "Du hast zuviel Dunkelheit um Dich, um dort hinauf zu gelangen!"));
    return 1;}

  else
  { 
    TPM("/d/dschungel/dante/tijaraneu/room/luxhaus", M_GO,
        "die Leiter nach oben", "klettert", "kommt von unten heraufgeklettert");
    return 1; 
  }
}



int turn_stone(string str)  {
  object ob;
  NF("Was willst Du hier umdrehen?!\n");
  if(str=="brocken um")  {

    if(!da)  {
      write(BS(
            "Du drehst den Brocken um. Fein. Nichts passiert. Geduld."));
      say(BS(
            CAP_TPN+" dreht einen Brocken um."));
      return 1; 
    }

    if(da)  {
      da--;
      say(BS(
            CAP_TPN+" dreht einen Brocken um."));
      write(BS(
            "Du drehst den Brocken um und ploetzlich schiesst eine "
            "Schlange unter dem Brocken hervor."));
      ob=clone_object("d/dschungel/dante/weg/npc/dschlange");
      ob->move(environment(TP), M_SILENT+M_GO);
      ob->Kill(TP);
      return 1; 
    }
    return 0; 
  }
  return 0;
}







