//std raum fuer die hoehle der zolome unter neutijara


#include "/players/dante/myowndefine.h"
inherit "std/room";
#include <properties.h>
#include <language.h>
#include <moving.h>
#define ZROOM "/d/dschungel/dante/tijaraneu/room/"
#define ZNPC "/d/dschungel/dante/tijaraneu/npc/"

#define BURNER if(!deep_present("zolom_burn", TP))  { write(BS("Du schaffst es nicht den Dung wegzubrennen.")); return 1;  }
#define BURN  write(BS("Dein kleiner Feuerball erzeugt im Zolombrenner einen Rueckstoss und eine Feuerwand schiesst aus dem Brenner heraus."));

void std_zolom()  {

  SetProp( P_INT_SHORT, "In der Hoehle der Zolome" );
SP(P_INT_LONG, BS(
"Das ist die Hoehle der Zolome. Zolome sind riesengrosse, wurmartige Kreaturen, "
"die am liebsten in sumpfigen Hoehlen wohnen. "
"Der Legende nach soll es irgendwo ein uraltes, noch viel groesseres "
"Zolom geben, von dem alle Zolome dieser Welt abstammen, doch kein "
"Lebender hat es je gesehen. "
"Ueberall sieht man den Schleim "
"und den Dung der Wuermer, so dass man weder den Boden noch die Waende genauer "
"erkennen kann. Der Schleim ist dick und zaehfluessig und schwappt langsam hin "
"und her. Der Dung stapelt sich teilweise meterhoch auf und es riecht hier "
"sehr streng. Angeblich gibt es irgendwo ein Nest der Zolome, wo die "
"kleinen, jungen Zolome heranreifen und erst hervorkommen, wenn sie "
"gross sind."));
   
  
  
  
  AD("boden",
  "Der Boden ist ueber und ueber mit Schleim bedeckt. Auch Dung liegt unterschiedlich "
  "viel herum.");
  
  AD(({"wand","waende"}),
  "Auch die Waende sind voller Schleim und Dung.");
  AD("decke",
  "Die Decke ist sehr unregelmaessig und teilweise sehr hoch oben.");
  AD("nest",
  "Das sagenhafte Nest der Zolome ist sicher ganz in der Naehe des uralten "
  "Zoloms. Man sollte das Nest zerstoeren!!!");
  
  
  
 AD("schleim",
  "Der Schleim ist sehr zaeh und sieht gruenlich bis graeulich aus. Ekelhaft!");
  AD(({"wurm","wuermer","meter"}),
  "Zolome koennen angeblich ueber 30 Meter gross werden!");
   
AD(({"hoehle","hoehlen"}),
"Die Hoehle ist sehr weitlaeufig, sonst koennten so grosse Kreaturen hier auch "
"nicht hausen.");

AD("naehe",
"Irgendwo im Norden...");
AD("norden",
"Da musst Du hin!");
AD("kerak",
"Kerak der Riese ist oft hier unten und schlachtet Zolome. Oder die Zolome ihn!");


AD(({"zolom","zolome"}),
"Es gibt unterschiedlichste Zolome, von eher klein bis gigantisch gross. Eigentlich "
"sind sie nicht besonders boesartig, aber aufpassen solltest Du trotzdem!");
AD(({"kreatur","kreaturen"}),
"Sie sollen angeblich schon uralt sein und fast ewig in dieser Welt hausen.");
AD("welt",
"Eine unheimliche, gefaehrliche, aber oft sehr schoene Welt!");
  AD("legende",
  "Irgendwo hier muss dieses uralte Zolom doch leben!");
  AD("lebender",
  "Die wirklich grossen Zolome muessen auch einen Drachen nicht fuerchten!");
  AD("drache",
  "Drachen machen sich wenig aus Zolomen, aber Riesen hassen sie!");
  AD(({"riese","riesen","feinde","feind"}),
  "Riesen und Zolome sind Feinde. Wo immer ein Riese ein Zolom sieht, "
  "wird er es sofort angreifen und umgekehrt natuerlich auch!");
   
   
   
   
   
   
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25, ENV_TERRAIN:TT_CAVE]) );
  
  
  AddSound( DEFAULT_SOUND,
    "Du hoerst die Zolome kriechen.");
    
  AddSmell( DEFAULT_SMELL,
    "Hier riecht es stark nach Schleim und Dung.");
AddSmell(({"schleim", "dung"}),
"Pfui!");
  
   
}

