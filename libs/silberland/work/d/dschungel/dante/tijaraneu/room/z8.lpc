inherit "std/room";

#include <moving.h>
#include <properties.h>
#include <language.h>
#include <mnpc.h>
#include "/d/dschungel/dante/tijaraneu/room/std_zolom.lpc"

#define LOG "/d/dschungel/dante/tijaraneu/log/"
#define TIME_MASTER "/d/dschungel/dante/tijaraneu/obj/time_master"


int exits_versperrt=1;
string wer="";

int event_moeglich=1;
object event_zolom;
int belohnung=100;
int counter=0;
int wieviele=0;
int zaehler=0;

int ort;


