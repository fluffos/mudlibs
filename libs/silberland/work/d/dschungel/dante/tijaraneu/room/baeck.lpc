create()
{
  ::create();

  SetProp( P_INT_SHORT, "In der Baeckerei von Konditorox" );
  SetProp( P_INT_LONG,
   BS(
"Du bist nun in der Baeckerei von "
"Tijara. Sie gehoert dem Baecker Konditorox, "
"einem Zwerg, der sich hier schon vor langem niedergelassen hat. Wohlige" 
" Gerueche "       
"durchziehen die Baeckerei und machen Dich sehr hungrig. "
"In mehreren Backoefen "
"werden hier die leckersten Baeckereien hergestellt. In grossen"
 " Schuesseln "
"wird der Teig angeruehrt. An den Waenden stehen Regale mit Buechern, die "
"angeblich die wertvollen Rezepte beinhalten. Im Sueden fuehrt eine Tuer "
"wieder hinaus nach.                                                    "
"Ein Schild."));


ARD("schild","Untersuche es besser!");


AD("schild",
"+----------------------------------------------------------------------+\n"
"|                    KAUFEN SIE EINE GEBURTSTAGSTORTE                  |\n"
"|                                                                      |\n"
"|                     FUER IHRE FREUNDE UND LIEBEN!                    |\n"
"+----------------------------------------------------------------------+\n");


SP(P_KILL_NAME, "Hunger, Gier und ein heisser Ofen");

AD("konditorox",
"Der hiesige Baecker!");

AD(({"wand","waende"}),
"An den Waenden haengen mehrere Regale. In ihnen lagern Buecher.");
AD(({"buch","buecher"}),
"Sie kannst Du lesen.");
ARD(({"buch","buecher"}),
"Verdammt! Altzwergisch! Du nix kapieren!");
AD(({"regal","regale"}),
"Die Regale sind voller Buecher!");
AD(({"rezept","rezepte"}),
"Die Rezepte sind natuerlich geheim!");
AD(({"teig","teige"}),
"Die Teige werden in grossen Schuesseln angeruehrt.");
AD(({"schuessel","schuesseln"}),
"In den Schuesseln lagern und ruhen die Teige nachdem sie dort auch angeruehrt wurden.");
AD(({"decke","boden"}),
"Die Decke besteht so wie der Boden aus blankem Stein.");
AD("stein",
"Der Stein ist sehr gut abwaschbar. AH! Daher!!!");
AD("sueden",
"Da geht es wieder raus.");
AD(({"tuer","tuere"}),
"Die Tuere ist offen.");
AD("tijara",
"Da bist Du gerade!");
AD("baeckerei",
"Du stehst mitten drin!");
AD("baecker",
"Der Baecker heisst Konditorox, ein sehr fetter Zwerg!");
AD("zwerg",
"Konditorox ist der wohl fetteste Zwerg den es ueberhaupt gibt. Er fr(isst) alle "
"seine Baeckereien angeblich selbst!");
AD("gerueche",
"Hmmmm, nur riechen kann man sie noch besser.");
AD(({"ofen","backofen","backoefen","oefen"}),
"Die Oefen sind alt, aber noch immer sehr brauchbar. Sie bestehen aus "
"Metall und scheinen alle gerade in Betrieb zu sein. Hitze geht von ihnen aus.");
AD("metall",
"Das Metall ist schwarz und scheint teilweise fast zu gluehen. Jeder Ofen hat "
"vorne eine grosse Klappe.");
AD("betrieb",
"Hier wird immer gebacken!");
AD("hitze",
"Die Hitze ist nahe den Oefen sehr gross. Die Klappen muessen enorm heiss sein! "
"Man sollte sie so ohne weiteres nicht angreifen! Zumindest ungeschuetzt nicht.");
AD(({"klappen","klappe"}),
"Die Klappen verbergen die koestlichen Baeckereien. Man kann sie sicher oeffnen!");
AD(({"baeckereien"}),
"Koestlichste Baeckereien aus den wunderbarsten Teigen werden hier hergestellt. "
"Doch leider isst sie der Baecker alle selbst auf! Man muesste einfach die "
"Klappen oeffnen und sie stehlen!!! Doch ob das, dem Baecker gefaellt?!");


     
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_HOUSE]) );

  AddSound( DEFAULT_SOUND,
    "Die Oefen knarren und kraechzen.");
 AddSound(({"ofen","oefen"}),
 "KNARRRR!!!"); 
  AddSmell( DEFAULT_SMELL,
    "HMMMMMMMM!!! Es riecht hier so gut nach Baeckereien!!!");

  AddSmell(({"baeckerei","baeckereien", "geruch","gerueche"}),  
  lambda(0, ({#'sprintf, "Es riecht hier %s!\n",
            ({ #'zustand}) }) ));
             
  // das ganze hier ist natuerlich nur eine bloede spielerei, die nicht unbendingt
  // sinn macht, einfacher wuerd auch gehn:-) dante
    
AIT(PATH"npc/baecker", REFRESH_DESTRUCT);

AE("sueden", "./ti_pfad4");
ACD(({"oeffne","oeffnen"}), "ofen_fun");


}


zustand()  {
 string *wie;
 int i;
 wie=({"suess","gut","sehr gut","suesslich","herrlich", "appetitanregend",
 "ungemein gut", "verlockend"});
 i=random(sizeof(wie));
 return wie[i];  }
 

int ofen_fun(string str)  {
     object ob;
     int i;
     object *rue;
     
     NF("Was willst Du hier oeffnen!\n");
  
  if(str=="klappe"||str=="klappen")  {
           
           say(BS(CAP_TPN+" hantiert an einem der Oefen herum."));
           write(BS(
           "Du versuchst eine der Klappen zu oeffnen!"));
               
            if(present("konditorox", environment(TP)))  {
               write(BSA(
               "HE! Bist Du wahnsinnig "+TPN+"!",   
               "Konditorox bruellt: "));
                   say(BSA(
               "HE! Bist Du wahnsinnig "+TPN+"!",   
               "Konditorox bruellt: "));
               
               
               return 1; }
               
  
     
              if(gebaeck<=0)  {
              write(BS(
              "Doch sie scheint zu klemmen!"));
              return 1; }
            
              
             if(gebaeck>0)  {

            rue=TP->QP(P_ARMOURS);
            
            if(!sizeof(rue))  {
              write(BS(
             "AHHHHHHHH!!!! Du verbrennst Deine ungeschuetzten Haende am heissen "
             "Ofen! ARGH!!!"));
             say(BS(
             CAP_TPN+" bruellt vor Schmerzen auf!"));
              TP->do_damage(25+random(15));
               return 1; }
               
            
            for(i=0; i<sizeof(rue); i++)   {
            
            if( rue[i]->id("handschuhe") || rue[i]->id("handschuh") )   {
            
            
            write(BS(
            "Du greifst mit geschuetzen Haenden in den Ofen und holst "
            "Dir einige herrliche Baeckereien heraus! HMMMMM!!!!"));
            
         for(i=0; i<4+random(3); i++)  {   
            
            ob=CLONEOB(PATH"obj/gebaeck");
            switch(random(5))  {
            case 0:
            ob->SP(P_GENDER, FEMALE);
            ob->AddId("semmel");
            ob->move(TP, M_NOCHECK);
            ob->SetProp(P_NAME, "Semmel");
            ob->SP(P_SHORT, "Eine herrliche Semmel");
            ob->SP(P_LONG, BS("Eine herrliche Semmel von Konditorox."));
            break;
            case 1:
            ob->SP(P_GENDER, NEUTER);
            ob->AddId("brot");
            ob->move(TP, M_NOCHECK);
            ob->SetProp(P_NAME, "Brot");
            ob->SP(P_SHORT, "Ein herrliches Brot");
            ob->SP(P_LONG, BS("Ein herrliches Brot von Konditorox."));
            break;
            case 2:
             ob->SP(P_GENDER, NEUTER);
            ob->AddId("kipferl");
            ob->move(TP, M_NOCHECK);
            ob->SetProp(P_NAME, "Kipferl");
            ob->SP(P_SHORT, "Ein herrliches Kipferl");
            ob->SP(P_LONG, BS("Ein herrliches Kipferl von Konditorox."));
            break;
            case 3:
             ob->SP(P_GENDER, NEUTER);
            ob->AddId("weckerl");
            ob->move(TP, M_NOCHECK);
            ob->SetProp(P_NAME, "Weckerl");
            ob->SP(P_SHORT, "Ein herrliches Weckerl");
            ob->SP(P_LONG, BS("Ein herrliches Weckerl von Konditorox."));
            break;
            
            case 4:
             ob->SP(P_GENDER, NEUTER);
            ob->AddId("striezel");
            ob->move(TP, M_NOCHECK);
            ob->SetProp(P_NAME, "Striezel");
            ob->SP(P_SHORT, "Ein herrliches Striezel");
            ob->SP(P_LONG, BS("Ein herrliches Striezel von Konditorox."));
            break;
            default:    }
            
            }
            
                
            
            gebaeck--;
           return 1;
                         }
                         
           }         
                  
              write(BS(
   "AHHHHHHHH!!!! Du verbrennst Deine ungeschuetzten Haende am heissen "
             "Ofen! ARGH!!!"));
             say(BS(
             CAP_TPN+" bruellt vor Schmerzen auf!"));
              TP->do_damage(25+random(15));
                  

            return 1;    }

            
           
        return 0; }
return 0; }

             
            
            
                                
