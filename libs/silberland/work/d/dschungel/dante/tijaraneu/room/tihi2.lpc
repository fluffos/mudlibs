
//die privatraeume von titon hehehehehe

inherit "std/room";
#include <properties.h>
#include <language.h>
#include <moving.h>
#include <wizlevels.h>
#include "/players/dante/myowndefine.h"

int i;
   

init()  {
  ::init();
  if(interactive(TP))  {  

if(present("pflanzendrache", environment(TP))) return;  

  if( find_call_out("come_plant_dragon") ==-1)   {  
  
  call_out("come_plant_dragon", 60);  }
         }
        }
    


create()
{
  ::create();

  SetProp( P_INT_SHORT, "Hinter Tithons Haus in Tijara" );
  SetProp( P_INT_LONG, BS(
"Du bist nun in die Privatraeume von Tithon eingedrungen und das "
"wird Dich teuer zu stehen kommen. Du schaust Dich um und bist "
"erschrocken!!! Du stehst mitten im wildesten Dschungel. Haus gibt es "
"hier keines mehr. Wild wuchern ueberall grosse, bedrohliche Pflanzen, "
"Lianen haengen von irgendwo oben herab und der Boden ist sumpfig. "
"Das kann nicht mit rechten Dingen zu gehen, da muss Magie im Spiel "
"sein. Irgendetwas lauert hier auf Dich, doch was. Sei vorsichtig!"));



AD("lianen",
"Die Lianen kommen von so weit oben, dass man nicht mehr erkennt woher "
"sie genau kommen.");
AD("dschungel",
"Der Dschungel ist hier wild und natuerlich. Er wirkt bedrohlich und sehr"     
  " gefaehrlich.");

AD(({"dinge","dingen"}),
"Es handelt sich hier natuerlich um Tithons Magie!");

AD("spiel",
"Spiel ist das hier keines mehr.");



AD("tithon",
"Tithon sieht das gar nicht gerne, was Du hier tust.");
AD("haus",
"Hier sieht man kein Haus mehr.");
AD("tijara",
"Tijara scheint weit weg zu sein.");
AD(({"raeume","raum", "privatraeume"}),
"Du hast Dir soetwas wirklich nicht vorstellen koennen. Dichter Dschungel?!");



AD(({"tuer","tuere"}),
"Siehst Du nicht.");


AD(({"decke","himmel"}),
"Von oben haengen Lianen herab.");
AD("boden",
"Der Boden ist eigentlich ein Sumpf.");
AD("sumpf",
"Es brodelt und wabbelt ueberall. Blasen steigen auf.");
AD("blasen",
"Die Blasen stinken erbaermlich!");


AD(({"wand","waende"}),
"Waende sind hier nicht zu sehen. Ueberall nur Pflanzen!!!");

AD(({"pflanze","pflanzen"}),
"Ueberall haengen und liegen hier grosse, wildwuchernde Pflanzen herum. "
"Hier herrscht dichtester Dschungel. Von den Pflanzen geht eine dunkle "
"Aura aus.");
AD("aura",
"Unheimlich! Es handelt sich um Fleischfresser bei den Pflanzen!");
AD(({"fleisch","fresser","fleischfresser"}),
"Sie verspeisen Dich und dann verdauen sie Dich zu einer anderen Pflanze!");

AD("raum",
"Hier ist kein Raum, nur Dschungel.");

AD(({"troll","magier","trollmagier","pflanzentrollmagier","pflanzentroll"}),
"Tithon hat sich zeitlebens mit Pflanzen und ihrer Magie beschaeftigt. Und "
"die wirst Du bald spueren!");

AD("magie",
"Angeblich gibt es viele magische Pflanzen.");
     
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_JUNGLE]) );

  AddSound( DEFAULT_SOUND,
    "Hier ist es sehr laut. Wie eben im echten Dschungel");
  AddSmell( DEFAULT_SMELL,
    "Hmm, es riecht nach Pflanzen! Und den ekligen, stinkenden Blasen!");
    AddSmell(({"pflanzen","pflanze"}),
    "Es sind zu viele verschieden...");
    
     AddSmell( ({ "blase", "blasen" }), 
     "Sie stinken eklig!");


/*AGE("norden", "/d/dschungel/dante/tijaraneu/room/tihi",
"vogelfalle", "Die Vogelfallelacht Dich aus!\n");
*/

AE("norden", "./tihi");


for(i=0;i<2+random(1);i++)  {
AIT("/d/dschungel/dante/tijaraneu/npc/fleisch", REFRESH_DESTRUCT);
          }
	}



come_plant_dragon()   {
  object ob;

  if(environment(TP)!=TO)  return;

  if(present("pflanzendrache", TO))   return;
  
  if(present("vogelfalle", TO)) { 
  call_out("come_plant_dragon", 15);  return; }
  
  
  ob=clone_object("d/dschungel/dante/tijaraneu/npc/plantdragon");
  tell_room("d/dschungel/dante/tijaraneu/room/tihi2", BS(
  "Ploetzlich hoerst Du lautes Knacken im Dschungel!!!"));
  ob->move(TO, M_NOCHECK);     }
  