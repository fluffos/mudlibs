t1()  {
  if( environment(TP)!=TO )  { return;  }
  if(!joe) {return; }

  tell_object(TP,
      "Joe zueckt einige Spitze Knochen und holt verschiedene Farben heraus! Dann beginnt er wie "
      "wild "+region+" von Dir herumzustechen! AUA!!! Das tut so weh!\n\n");
  TP->AddHp(-10);

  tell_room(environment(TP),
      "Joe zueckt einige Spitze Knochen und holt verschiedene Farben heraus! Dann beginnt er wie "
      "wild "+region+" von "+TP->name(WEM)+" herumzustechen! AUA!!! Das tut sicher weh! "
      ""+CAP_TPN+" bruellt laut auf! Was fuer ein Feigling!\n\n",
      ({TP}));

  call_out("t2", 4);
}	


t2()  {
  if( environment(TP)!=TO )  { return;  }
  if(!joe) {return; }

  tell_object(TP,
      "Joe sticht wild auf Dich ein und grunzt dabei laut. Du hast starke Schmerzen!\n\n");
  TP->AddHp(-10);
  tell_room(environment(TP),
      "Joe sticht wild auf "+TPN+" ein. "+CAP_TPN+" hat starke Schmerzen und heult auf!\n\n",
      ({TP}));
  call_out("t3", 4);
}	


t3()  {
  if( environment(TP)!=TO )  { return;  }
  if(!joe) {return; }

  tell_object(TP,
      "Die Arbeit von Joe geht flott voran und die Taetowierung nimmt Gestalt an! "
      "Sieht schon recht gut aus!\n\n");
  tell_room(environment(TP),
      "Die Arbeit von Joe geht flott voran und die Taetowierung nimmt Gestalt an! "
      "Sieht schon recht gut aus! "+CAP_TPN+" jammert aber noch immer laut herum!\n\n",
      ({TP}));

  call_out("geht_wieder", 4);
}	


geht_wieder()  {

  if(joe)  {
    joe->RemoveId("joe_tut_was");
    joe->SetProp(P_NOATTACK, 0);
    tell_room(environment(joe),
        "Joe grinst zufrieden und freut sich ueber die gelungene "
        "Arbeit die er an "+opfer->name(WEM)+" vollbracht hat!\n\n",
        ({TP}));
    tell_object(TP,
        "Froh, dass es vorbei ist stehst Du wieder auf und freust Dich "
        "ueber diese gute Arbeit von Joe!\n\n");
  }	
}		
