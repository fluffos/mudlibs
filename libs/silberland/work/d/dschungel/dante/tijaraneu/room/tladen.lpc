#include "/players/dante/myowndefine.h"
inherit "std/room";
#include <properties.h>
#include <language.h>
#include <wizlevels.h>
#include <moving.h>
#include <ansi.h>
#include <combat.h>
#define PREIS 5000


#define PFAD "/d/dschungel/dante/tijaraneu/ascii/"

string show_infos();
string *files;
int i, nummer, welche, gruppennummer, motivnummer;
string check_dirs(string dir);
string gruppe, motiv, region, farbe, hgfarbe, color, hcolor, text, owner;
string *region_array;
string *farb_array;
object opfer, joe, cash, besitz;
int groesse, level, preis, bonus, x, y, alle;



init()  {::init();

  if(getuid(TP)=="dante")  return;

  if(IS_WIZARD(TP))  { call_out("hi", 1);
  }
}

hi()  {
  if(environment(TP)!=TO) return;


  write("\n"
      "Willkommen in Dantes Tattooladen Kollege "+CAP(getuid(TP))+"!\n"
      "Wenn Du das Angebot an Motiven erweitern willst, geht das ganz einfach.\n"
      "Du musst nur die Asciis aussagekraeftig benennen, also die files und sie\n"
      "dann in das richtige directory legen. Willst Du ein neues directory anlegen,\n"
      "also eine neue Motivgruppe erzeugen, musst Du nur ein directory anlegen,\n"
      "also z.b frauen. Der Rest geht dann automatisch.\n"
      "\ncmds:\nunt tafel zeigt alle Gruppen.\n"
      "betrachte tafel nummer zeigt eine Liste der Motive in der Gruppe nummer.\n"
      "motiv nummer zeigt das Motiv nummer wie es als Ascii aussieht.\n"
      "Dante\n");

}


create()
{
  ::create();
  files=({});

  SetProp( P_INT_SHORT, "Im Tattoo-Laden von Tijara" );
  SetProp( P_INT_LONG, BS(
        "Du stehst nun in dem merkwuerdigen Gebaeude und auch hier stehen "
        "interessante Gegenstaende ueberall herum. Totems, ein kleiner Marterpfahl "
        "einige Schaedel und allerlei Zeug, das Du nicht kennst. An der Wand steht "
        "ein grosser, schwerer Tisch aus Holz, an dem fuenf Schlaufen aus Leder "
        "angebracht sind. Direkt ober dem Tisch haengt ein Regal, auf dem mehrere "
        "kleine Flaschen und viele kleine, sehr spitze Knochen liegen. Durch die "
        "Tuere im Westen kommst Du wieder hinaus.                                  "
        "                            Einige Tafeln.                                                            "
        "                            Ein Schild.                                   "
        "                                 Ein Plakat mit Kurzinfos."));




  AD(({"plakat", "infos","kurzinfos","info"}),
      "+----------------------------------------------------------------------------+\n"
      "| Kommandos:                                                                 |\n"
      "|                                                                            |\n"
      "| 'unt tafel': zeigt alle Motivgruppen an.                                   |\n"
      "| 'betrachte tafel <nummer>': zeigt die Motivliste der Gruppe <nummer> an.   |\n"
      "| 'motiv nummer': zeigt das Motiv <nummer> wie es als Ascii aussieht.        |\n"
      "|                                                                            |\n"
      "| 'taetowiere <nummer> auf <region> in <farbe> auf <hintergrundfarbe>':      |\n"
      "|  Dir wird das Motiv nummer auf die ausgewaehlte Region in der gewuenschten |\n"
      "|  Farbe taetowiert. Mehr dazu mit 'hilfe taetowierung'.                     |\n"
      "|  Mit <motivliste> bekommst Du eine kleine Statistik.                       |\n"
      "|                                                                  Dante     |\n"
      "|                                                                            |\n"
      "+----------------------------------------------------------------------------+\n");

  AD("schild",
      "Lies es!");
  AD("leder",
      "Hartes, braunes Leder.");
  AD(({"tuer","tuere","westen"}),
      "Da gehts raus!");
  AD("laden",
      "Hier wird taetowiert!");
  AD("tisch",
      "Der Tisch besteht aus massivem Holz. Hier wird man festgebunden, wenn man "
      "sich taetowieren laesst. Dazu dienen sie Schlaufen.");
  AD(({"schlaufen","schlaufe"}),
      "Mit den Schlaufen wird man am Tisch festgebunden, waehrend man taetowiert wird.");
  AD("regal",
      "Auf dem Regal siehst Du viele kleine Knochen und einige Flaschen.");
  AD("knochen",
      "Die Knochen werden in die Flaschen getaucht und dann wird Dir die Farbe "
      "unter die Haut gestochen! AUA!");
  AD("haut",
      "Das tut verdammt weh! Sei Dir sicher!");
  AD(({"flasche","flaschen"}),
      "Die Flaschen beinhalten viele verschiedene Farben.");




  AD(({"wand","waende"}),
      "Die Waende sind aus Stein und ziemlich vollgeraeumt.");
  AD(({"pfahl","marterpfahl"}),
      "Der kleine hoelzerne Marterpfahl sieht sehr mitgenommen aus. Scheinbar wurde "
      "er oft verwendet.");
  AD("schaedel",
      "Die Schaedel liegen einfach so herum. Sehr unordentlich hier.");
  AD(({"gegner","gegnern"}),
      "Es muessen sehr viele Gegner gestorben sein...");
  AD(({"totems","totem"}),
      "Die Totems stellen erschlagene Gegner des Besitzers des Hauses dar."),
  AD(({"gebaeude","haus"}),
      "Das Haus wirkt sehr interessant, doch auch unheimlich.");
  AD("besitzer",
      "Wem mag es wohl gehoeren?!");
  AD(({"zeug","gegenstand","gegenstaende"}),
      "Hmm, spitz, rund, bunt, schwarz, hoelzern, pflanzlich..alles dabei. Du "
      "hast wirklich keine Ahnung was das alles soll.");
  AD("ahnung",
      "Hast Du doch selten...");
  AD("boden",
      "Der Boden besteht aus festgewalzten Lehm.");
  AD("lehm",
      "Der Lehm hat viele farbige Flecken.");
  AD(({"fleck","flecke","flecken"}),
      "Die muessen wohl beim Taetowieren irgendwie entstanden sein. Schaut aus "
      "wie Farbe und Blut.");
  AD("blut",
      "Hmm, sich taetowieren lassen scheint gefaehrlich zu sein...");
  AD(({"farbe","farben"}),
      "Scheinbar gibt es auch bunte Taetowierungen.");
  AD(({"taetowierung","taetowierungen"}),
      "Ja, die werden hier gemacht.");

  AD("gebaeude",
      "Das Gebaeude ist recht flach und besteht aus rauhen, grauen Steinen.");
  AD(({"steine","stein"}),
      "Die Steine sehen voellig uninteressant aus.");
  AD("decke",
      "Die Decke besteht aus grobem Holz und ist recht niedrig.");
  AD("holz",
      "Grob behauenes, dunkles Holz. Sicher sehr alt. He! Da ist eine Kritzelei!");
  AD("kritzelei",
      "Dank an Netter/Dragonmage/Snowbone die viele Asciis beigesteuert haben! "
      "Ebenso an Protheg und andere...");
  AD(({"dank","ascii","snowbone","dragonmage","netter","protheg", "andere"}),
      "DANKE!");




  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );


  AE("westen", "./ti_pfad11");

  AIT("/d/dschungel/dante/tijaraneu/npc/taet", REFRESH_DESTRUCT);



  AddSound( DEFAULT_SOUND,
      "Du glaubst Laerm zu hoeren.");
  AddSound("laerm",
      "Das ist eben eine Stadt hier.\n");
  AddSound("stadt",
      "LAUT!!!!!");

  AddSmell( DEFAULT_SMELL,
      "Es riecht hier nach frischer Luft.");

  AddSmell("luft",
      "Frisch.");

  ARD("schild", #'show_infos);
  AD(({"motiv","motive"}), 
      "Mit 'motiv nummer' kannst Du Dir die einzelnen Motive ansehen!");


  ASD(({"tafel","tafeln"}), "show_motivgruppen");
  ACD(({"betracht","betrachte","betrachten"}), "show_motive_short");
  ACD(({"motiv"}), "show_motive_long");
  ACD(({"hilfe"}), "help");
  ACD(({"taetowiere","taetowier","taetowieren"}), "make_tattoo");
  ACD(({"entferne","entfern","entfernen"}), "weg_damit");

  region_array=({
      "gesicht", "stirn", "linkes schulterblatt","rechtes schulterblatt",
      "schulter", "ruecken",
      "linke pobacke", "rechte pobacke", "po",
      "rechter oberschenkel","linker oberschenkel",
      "rechter unterschenkel", "linker unterschenkel",
      "rechter fuss","linker fuss","brust",
      "rechte brust", "linke brust", "bauch",
      "rechter oberarm", "linker oberarm",
      "rechter unterarm","linker unterarm",
      "rechte hand", "linke hand","nase"});





  farb_array=({
      "schwarz", "gruen", "rot", "gelb", "blau", "violett", "cyan", "weiss", "normal"});	

  ACD(({ "mt","motivliste"}), "motivliste");

}

motivliste()  {


  string *dirs;
  string *files;
  int ii, gr;
  alle=0;
  gr=0;

  dirs=filter_array(get_dir(PFAD"*"), #'check_dirs);

  if(!sizeof(dirs))  {  write("Keine Directorys!\n"); return ; }

  for(i=0;i<sizeof(dirs);i++)  {
    gr++;


    files=filter_array(get_dir(PFAD""+dirs[i]+"/*"), #'check_dirs);	

    if(!sizeof(files))  { return;  }

    for(ii=0;ii<sizeof(files);ii++)  {

      alle++;
    }

  }
  write(
      "Momentan gibts es "+alle+" verschiedene Motive in "+gr+" verschiedenen Gruppen!\n");
  return 1;
}



// ***********************************************************************

int weg_damit(string str)  {
  object entfernen;
  string was;
  int welche, i;
  object *inv;

  NF(BS("Welche Taetowierung willst Du Dir entfernen lassen?! "
        "syntax: 'entferne taetowierung nummer'. Wobei Nummer angibt "
        "die wievielte Taetowierung entfernt werden soll. Die erste in "
        "Deinem Inventory aufscheinende ist die Nummer 1 usw..."));
  if(!str)  return 0;	

  if(!deep_present("taetowierung", TP))  {
    write(BSA(
          "Du hast ja gar keine Taetowierung!",
          "Joe sagt: "));
    return 1;  
  }
  joe=find_living("joe");


  if(!joe)  {
    write(BS(
          "Sieh Dich besser um! Joe ist doch gar nicht da!"));
    return 1;    
  }	


  if(!present("joe", environment(TP) ) ) {
    write(BS(
          "Sieh Dich besser um! Joe ist nicht da!"));
    return 1;    
  }	

  if(joe  && present("joe_tut_was", environment(TP))) {

    write(BSA(
          "HE! Siehst Du nicht, ich arbeite gerade hart an "
          "der Taetowierung von "+opfer->name(WER)+"! Gib Ruhe!",
          "Joe sagt grantig: "));
    return 1;  
  }


  if(TP->QueryProp(P_GHOST))   {
    write(BSA(
          "Geistern kann ich nicht helfen!",
          "Joe sagt: "));
    return 1;  
  }

  if(TP->QueryGuest())  {
    write(BSA(
          "Gaesten will ich nicht helfen!",
          "Joe sagt: "));
    return 1;  
  }

  if(TP->QueryProp(P_FROG))   {
    write(BSA(
          "Froeschen kann ich nicht helfen!",
          "Joe sagt: "));
    return 1;  
  }

  if( TP->InFight() )  {
    write(BSA(
          "Aber Du kaempfst ja gerade!",
          "Joe sagt: "));
    return 1;  
  } 
  if( joe->InFight() )  {
    write(BSA(
          "Aber Ich kaempfe doch gerade!",
          "Joe sagt: "));
    return 1;  
  } 

  if(sscanf(str, "%s %d", was, welche)==2)  {

    if(welche<1)  {
      write(BSA(
            "Nein! Diese Nummer ist zu klein.",
            "Joe sagt: "));
      return 1;  
    }

    if(!deep_present(was, TP))  {

      write(BSA(
            "Ich kann "+CAP(was)+" nicht finden!",
            "Joe sagt: "));
      return 1;  
    }

    if(TP->QueryMoney() < PREIS/10 )  {
      write(BSA(
            "Das entfernen lassen von Taetowierungen kostet "
            "momentan "+PREIS/10+" Muenzen! Du hast nicht soviel!",
            "Joe sagt: "));
      return 1;
    }


    if(was!="taetowierung")  {

      write(BSA(
            "Ich kann "+CAP(was)+" nicht entfernen!",
            "Joe sagt: "));
      return 1;  
    }

    inv=all_inventory(TP);

    if(!sizeof(inv))  {
      write(BSA(
            "Hast Du doch gar nicht!",
            "Joe sagt: "));
      return 1;  
    }
    x=0;

    for(i=0; i<sizeof(inv); i++)  {

      if(explode(explode(file_name(inv[i]), "#")[0], "/")[<1] == "t.a")  {

        x++;

        if( x  == welche )  {	

          inv[i]->remove();


          write(BSA(
                "Gut, ich entferne Dir die "+welche+". Taetowierung!",
                "Joe sagt: "));
          write(BS(
                "Daraufhin nimmt Joe ein altes Messer und kratzt brutal und blitzschnell "
                "die Taetowierung herunter! Du bruellst auf! AUA! Dann grinst Joe und Du gibst "
                "ihm das Geld!"));

          tell_room(environment(TP),
              "Joe entfernt mit einem alten Messer eine Taetowierung von "+TPN+"!\n",
              ({TP}));	


          besitz=present("muenzen", joe);

          TP->AddMoney(-( PREIS/10 ) );
          if(besitz)  {
            besitz->SetProp(P_AMOUNT, PREIS/10 + besitz->QueryProp(P_AMOUNT));
          }
          if(!besitz)  {	
            cash=clone_object("obj/money");
            cash->SetProp(P_AMOUNT, PREIS/10 );
            cash->move(joe, M_NOCHECK);
          }


          return 1;
        }
      } 
    }

    write(BSA(
          "Hast Du doch gar nicht!",
          "Joe sagt: "));
    return 1;  
  }


  write("\n");
  return 1;  
}




int make_tattoo(string str)  {

  object tattoo;

  joe=find_living("joe");

  NF("Syntax: taetowiere nummer auf region in farbe auf hintergrundfarbe.\n");

  if(!str) return 0;


  if(sscanf(str, "%d auf %s in %s auf %s", welche, region, farbe, hgfarbe)==4)  {

    if(!joe)  {
      write(BS(
            "Sieh Dich besser um! Joe ist nicht da!"));
      return 1;    
    }	


    if(!deep_present("joe", environment(TP) ) ) {
      write(BS(
            "Sieh Dich besser um! Joe ist nicht da!"));
      return 1;    
    }	

    if(joe  && present("joe_tut_was", environment(TP))) {

      write(BSA(
            "HE! Siehst Du nicht, ich arbeite gerade hart "
            "der Taetowierung von "+opfer->name(WER)+"! Gib Ruhe!",
            "Joe sagt grantig: "));
      return 1;  
    }


    if(TP->QueryProp(P_GHOST))   {
      write(BSA(
            "Geister kann ich nicht taetowieren!",
            "Joe sagt: "));
      return 1;  
    }

    if(TP->QueryGuest())  {
      write(BSA(
            "Gaeste will ich nicht taetowieren!",
            "Joe sagt: "));
      return 1;  
    }

    if(TP->QueryProp(P_FROG))   {
      write(BSA(
            "Froesche kann ich nicht taetowieren!",
            "Joe sagt: "));
      return 1;  
    }

    if( TP->InFight() )  {
      write(BSA(
            "Aber Du kaempfst ja gerade!",
            "Joe sagt: "));
      return 1;  
    } 
    if( joe->InFight() )  {
      write(BSA(
            "Aber Ich kaempfe doch gerade!",
            "Joe sagt: "));
      return 1;  
    } 




    if(welche <=100 )  {
      write(BSA(
            "Diese Nummer ist zu klein!",
            "Joe sagt: "));
      return 1;    
    }

    if(welche >=10000 )  { 
      write(BSA(
            "Diese Nummer ist zu gross!",
            "Joe sagt: "));
      return 1;    
    }	

    if(member_array(region, region_array)==-1 )   {

      write(BSA(
            "Sorry, ich verstehe Region '"+region+"' nicht! "
            "Wohin willst Du nun die Taetowierung haben?!",
            "Joe sagt: "));
      return 1;   
    }


    if(member_array(farbe, farb_array)==-1 )   {

      write(BSA(
            "Sorry, die Farbe '"+farbe+"' kenne ich nicht! "
            "Welche Farbe willst Du nun haben?!",
            "Joe sagt: "));
      return 1;   
    }



    if(member_array(hgfarbe, farb_array)==-1 )   {

      write(BSA(
            "Sorry, die Farbe '"+farbe+"' kenne ich nicht! "
            "Welche Farbe willst Du nun haben?!",
            "Joe sagt: "));
      return 1;   
    }



    gruppennummer=welche/100;
    motivnummer=welche-(gruppennummer*100);


    if( gruppennummer > sizeof( filter_array(get_dir(PFAD"*"), #'check_dirs ) ))  {

      write(BSA("Diese Motivgruppe gibt es momentan nicht! "
            "Die Nummer ist zu hoch!", "Joe sagt: "));
      return 1;  
    }



    gruppe= filter_array(get_dir(PFAD"*"), #'check_dirs) [gruppennummer-1];


    files=filter_array(get_dir(PFAD""+(filter_array(get_dir(PFAD"*"), #'check_dirs ))[gruppennummer-1]+"/*"), #'check_dirs);

    if(!sizeof(files))  { 
      write(BSA("Leider ist die Motivgruppe "+CAP(gruppe)+" momentan leer.",
            "Joe sagt: "));
      return 1;    
    }

    if( (motivnummer) > sizeof(files) )   {

      write(BSA("Leider gibt es das Motiv "+welche+" in der Motivgruppe "
            +CAP(gruppe)+" momentan nicht.", "Joe sagt: "));
      return 1;    
    }


    if(motivnummer <=0 )  {
      write(BSA(
            "Diese Motivnummer gibt es nicht. Motive beginnen immer "
            "erst ab 1. Also z.b 501.", "Joe sagt: "));
      return 1;  
    }



    motiv=files[motivnummer-1];

    if(gruppe=="Privat")  {

      if( strstr(motiv, CAP(getuid(TP)) )==-1 )

      {   	
        owner=explode(motiv, "_")[0];


        write(BSA(
              "Sorry! Diese Taetowierung gehoert "+owner+"! "
              "Wenn Du sie unbedingt haben willst, frag "+owner+"! "
              "Wenn Du auch eine private Taetowierung haben willst, wende Dich an "
              "Dante!",
              "Joe sagt: "));

        return 1;  
      }
    }   
    //und aus gruppe privat stammt motiv



    bonus=0;

    groesse=file_size(PFAD""+gruppe+"/"+motiv+"");

    groesse=groesse*2;

    level=TP->QueryProp(P_LEVEL)*10;
    if(level<1)  { level=1;  }


    if(farbe!="normal")  {
      bonus=bonus+1000;
    }	

    if(hgfarbe!="normal")  {
      bonus=bonus+1000;
    }	


    preis=level+groesse+PREIS+bonus;

    if(TP->QueryMoney() < preis )  {
      write(BSA(
            "Das wuerde "+preis+" Muenzen "
            "kosten. Soviel hast Du aber nicht!",
            "Joe sagt: "));
      return 1; 
    }


    if(present(""+region+" 2", TP))  {
      write(BSA(
            "Hmm, Du hast schon zwei Taetowierungen dort.",
            "Joe sagt: "));
      return 1;  }






      write("Du suchst Dir das Motiv "+welche+" '"+motiv+"' aus der Gruppe "+CAP(gruppe)+" aus.\n\n");
      write("Du gibst Joe "+preis+" Muenzen.\n\n");




      besitz=present("muenzen", joe);

      TP->AddMoney(-( preis ) );
      if(besitz)  {
        besitz->SetProp(P_AMOUNT, preis+besitz->QueryProp(P_AMOUNT));
      }
      if(!besitz)  {	
        cash=clone_object("obj/money");
        cash->SetProp(P_AMOUNT, preis);
        cash->move(joe, M_NOCHECK);
      }



      if(joe && !present("joe_tut_was", environment(TP) ) ){


        tell_object(TP,
            "Joe springt blitschnell auf Dich zu und wirft Dich auf den Holztisch! "
            "Dann bindet er Dich mit den Schlaufen fest! Du kannst nun nicht mehr zurueck!"
            " Los gehts!\n\n");

        tell_room(environment(TP),
            "Joe springt blitschnell auf Dich zu und wirft "+TPN+" auf den Holztisch! "
            "Dann bindet er "+TPN+" mit den Schlaufen fest! "+CAP_TPN+" kann nun nicht mehr zurueck!"
            " Los gehts! "+CAP_TPN+" wird nun taetowiert!\n", ({TP}));

        call_out("t1", 4);


        joe->AddId("joe_tut_was");  
        opfer=TP;
        joe->SetProp(
            P_NOATTACK, "Joe bruellt: He Du Idiot! Ich taetowiere gerade "+opfer->name()+"!\n");

        TP->SetProp(P_PARALYZED, ([PARALYZE_TIME: 8,
PARALYZE_MSG: "Halt Still! Du wirst gerade taetowiert!\n",
PARALYZE_MSG_OTHER: "%s jammert und zuckt laut vor Schmerzen!\n",
PARALYZE_END: "Joe sagt: Fertig!!! Los! Steh auf!\n",
PARALYZE_END_OTHER: "%s sieht Dich gluecklich an, denn "
+TP->QueryPossPronoun(FEMALE, WEN, SINGULAR)+" Taetowierung ist nun fertig!\n"]));

      }


      tattoo=clone_object(PFAD"t.a");
      tattoo->move(TP, M_NOCHECK);
      tattoo->AddId(region);

      switch(region)   {
        case "gesicht":               region="im Gesicht"; break;
        case "stirn":                 region="auf der Stirn"; break;
        case "linkes schulterblatt":  region="auf dem linken Schulterblatt"; break;
        case "rechtes schulterblatt": region="auf dem rechten Schulterblatt"; break;
        case "schulter":              region="auf der Schulter"; break;
        case "ruecken":               region="auf dem Ruecken"; break;
        case "linke pobacke":         region="auf der linken Pobacke"; break;
        case "rechte pobacke":        region="auf der rechten Pobacke"; break;
        case "po":                    region="auf dem Po"; break;
        case "rechte hand":           region="auf der rechten Hand";break;
        case "linke hand":            region="auf der linken Hand";break;
        case "rechter unterarm":      region="auf dem rechten Unterarm";break;
        case "linker unterarm":       region="auf dem linken Unterarm";break;
        case "rechter oberschenkel":  region="auf dem rechten Oberschenkel";break;
        case "linker oberschenkel":   region="auf dem linken Oberschenkel";break;
        case "rechter oberarm":       region="auf dem rechten Oberarm";break;
        case "linker oberarm":        region="auf dem linken Oberarm";break;
        case "rechter unterschenkel": region="auf dem rechten Unterschenkel";break;
        case "linker unterschenkel":  region="auf dem linken Unterschenkel";break;
        case "rechte brust":          region="auf der rechten Brust";break;
        case "linke brust":           region="auf der linken Brust";break;
        case "brust":                 region="auf der Brust"; break;
        case "bauch":                 region="auf dem Bauch"; break;
        case "rechter fuss":          region="auf dem rechten Fuss";break;
        case "linker fuss":           region="auf dem linken Fuss";break;
        case "nase":                  region="auf der Nase"; break;

        default: region="auf dem Po";
      }                



      switch(farbe)  {

        case "normal": farbe=ANSI_NORMAL; color="farblos";  break;
        case "schwarz": farbe=ANSI_BLACK; color="schwarz"; break;
        case "weiss": farbe=ANSI_WHITE; color="weiss";break;
        case "gruen": farbe=ANSI_GREEN; color="gruen"; break;	
        case "rot": farbe=ANSI_RED; color="rot";  break;
        case "gelb": farbe=ANSI_YELLOW; color="gelb"; break;
        case "blau": farbe=ANSI_BLUE; color="blau"; break;
        case "cyan": farbe=ANSI_CYAN; color="zyanfarben"; break; 
        case "violett": farbe=ANSI_PURPLE; color="violett"; break;

        default: farbe=ANSI_NORMAL;  

      }

      joe->sags_auf_kanal(opfer, region, color);


      write_file("/d/dschungel/dante/weg/log/joe",
          ctime()+": !"+CAP(getuid(TP))+" "+region+" "+color+"\n"
          "Motiv: "+motiv+" Nummer: "+welche+" \n");



      switch(hgfarbe)  {

        case "normal": hgfarbe=""; hcolor="farblos";  break;
        case "schwarz": hgfarbe=ANSI_BG_BLACK; hcolor="schwarz"; break;
        case "weiss": hgfarbe=ANSI_BG_WHITE; hcolor="weiss";break;
        case "gruen": hgfarbe=ANSI_BG_GREEN; hcolor="gruen"; break;	
        case "rot": hgfarbe=ANSI_BG_RED; hcolor="rot";  break;
        case "gelb": hgfarbe=ANSI_BG_YELLOW; hcolor="gelb"; break;
        case "blau": hgfarbe=ANSI_BG_BLUE; hcolor="blau"; break;
        case "cyan": hgfarbe=ANSI_BG_CYAN; hcolor="zyanfarben"; break; 
        case "violett": hgfarbe=ANSI_BG_PURPLE; hcolor="violett"; break;

        default: hgfarbe=ANSI_NORMAL;  

      }

      tattoo->setze_werte(PFAD""+gruppe+"/"+motiv+"", region, farbe, color, hgfarbe);

      domainshout(BSA(""+CAP(getuid(TP))+" laesst sich gerade "+region+" eine "+color+"e "
            "Taetowierung von mir stechen!",
            "Joe ruft: "));


      return 1;  
  }

  return 0;  
}


int help(string str)   {

  if(str=="taettoo"||str=="taetto"||str=="taetowierung"||str=="taetowieren")  {

    write(
        "Du kannst Dich hier taetowieren lassen. Das kostet natuerlich Geld und\n"
        "der Preis ist abhaengig von der Groesse und der Genauigkeit des Taettoos.\n\n"
        "Die Syntax ist: 'taetowiere <nummer> auf <region> in <farbe> auf <hintergrundfarbe>'.\n"
        "Ad nummer:\n" 
        "Die Nummer des Motives bekommt man mit 'betrachte tafel nummer bzw unt tafel'.\n"
        "Mehr dazu auf den Tafel bzw Plakat.\n\n"
        "Ad region:\n"
        "Du kannst Dir aussuchen wo Du Dein Taettoo haben willst. Es gibt momentan:\n"
        "Gesicht, Stirn, linkes/rechtes Schulterblatt, Schulter, Ruecken,\n"
        "linke Pobacke, rechte Pobacke, Po,\n"
        "rechter/linker Oberschenkel, rechter/linker Unterschenkel,\n"
        "rechter/linker Fuss, Brust, rechte/linke Brust, Bauch,\n"
        "rechter/linker Oberarm, rechter/linker Unterarm, rechte/linke Hand.\n\n"
        "Ad Farbe:\n"
        "Du kannst Dein Taettoo auch faerbig haben. Es gibt momentan:\n"
        "Schwarz, gruen, rot, gelb, blau, violett, cyan, weiss zum auswaehlen.\n\n"
        "Ad Hintergrundfarbe:\n"
        "Es gibt die gleichen Farben wie unter ad Farben genannt!\n"
        "ACHTUNG! Durch verschiedene Einstellungen und Kombinationen koennen sehr\n"
        "merkwuerdige und haessliche Effekte entstehen! Die Verwantwortung dafuer\n"
        "liegt bei Dir selbst!\n"
      "Wenn Du weder Farbe noch Hintergrundfarbe haben willst must Du als Argument\n"
      "jeweils 'normal' angeben! Farben kosten pro Farbe 1000 Muenzen zusaetzlich!\n"
      "Also maximal 2000 Muenzen mehr!\n\n"
      "Mit <entferne taetowierung> kannst Du Dir eine Taetowierung wieder entfernen\n"
      "lassen! Kosten: "+PREIS/10+" Muenzen!\n"
      "Achtung! Du musst angeben welche Taetowierung! Also wenn Du die dritte \n"
      "Taetowierung in Deinem Inventory entfernen lassen willst, musst Du\n"
      "<entferne taetowierung 3> eingeben!\n"
      "Mit <motivliste> bekommst Du eine kleine Statistik.\n");     

    return 1;  
  }

}

//zeigt einzelne motive an

int show_motive_long(string str)  {

  NF("Welches Motiv willst Du ansehen?!'motiv nummer'\n");

  if(!str) return 0;

  if(sscanf(str, "%d", welche)!=1)  {

    write("Die Syntax ist 'motiv nummer'\n"
        "Z.B.: motiv 101\n");
    return 1;                    
  }


  if(welche <= 100 )  { 
    write("Diese Nummer ist zu klein!\n");
    return 1;  
  }


  if(welche >= 10000 )  { 
    write("Diese Nummer ist zu gross!\n");
    return 1;  
  }

  gruppennummer=welche/100;
  motivnummer=welche-(gruppennummer*100);

  //write("gruppe: "+gruppennummer+"   welche: "+welche+"   motivnummer: "+motivnummer+"\n");




  if( gruppennummer > sizeof( filter_array(get_dir(PFAD"*"), #'check_dirs ) ))  {

    write("Diese Motivgruppe gibt es momentan nicht!\n"
        "Die Nummer ist zu hoch!\n");
    return 1;  
  }



  gruppe= filter_array(get_dir(PFAD"*"), #'check_dirs) [gruppennummer-1];


  files=filter_array(get_dir(PFAD""+(filter_array(get_dir(PFAD"*"), #'check_dirs ))[gruppennummer-1]+"/*"), #'check_dirs);

  if(!sizeof(files))  { 
    write("Leider ist die Motivgruppe "+CAP(gruppe)+" momentan leer.\n");
    return 1;    
  }


  if( (motivnummer) > sizeof(files) )   {

    write("Leider gibt es das Motiv "+welche+" in der Motivgruppe "
        +CAP(gruppe)+" momentan nicht.\n");
    return 1;    
  }


  if(motivnummer <=0 )  {
    write(
        "Diese Motivnummer gibt es nicht. Motive beginnen immer "
        "erst ab 1. Also z.b 501.\n");
    return 1;  
  }



  motiv=files[motivnummer-1];

  level=TP->QueryProp(P_LEVEL)*10;
  if(level<1)  { level=1;  }

  groesse=file_size(PFAD""+gruppe+"/"+motiv+"");

  groesse=groesse*2;

  preis=level+groesse+PREIS;


  write("Du betrachtest das Motiv "+welche+" '"+motiv+"' aus der Gruppe "+CAP(gruppe)+":\n");
  write("Der Preis fuer dieses Motiv ist momentan "+preis+" ohne Farben!\n");


  TP->More(read_file(PFAD""+gruppe+"/"+motiv+""));



  write("\n");


  return 1;  
}




//zeigt alle gruppen an

string show_motivgruppen() 

{


  if(!sizeof(get_dir(PFAD"*")))  
  {
    return ("Diese Tafel scheint leer zu sein?!\n");
  } 		

  write("Folgende Motivgruppen gibt es momentan:\n\n");

  files=filter_array(get_dir(PFAD"*"), #'check_dirs );

  for(i=0; i<sizeof(files); i++)   

  {


    write(""+(i+1)+".) "+CAP(files[i])+"\n");
  }	

  return "\nMit 'betracht(e) tafel nummer' siehst Du eine Auflistung samt "
    "Kurzbeschreibung aus der von Dir gewuenschten Gruppe.\n"
    "Siehe auch 'hilfe taetowierung' oder Plakat.\n";

}


//hilfsfunktion um den schrott aus den dirs zu entfernen

string check_dirs(string dir)   {

  if(strstr(dir, ".")==-1) return dir;

}



//zeigt die einzelnen motive aus einer gruppe an (liste)

int show_motive_short(string str)   {


  NF("Was willst Du betrachten?!\n");

  if(!str) return 0;

  if(sscanf(str, "tafel %d", welche)!=1)  {

    write("Die Syntax ist 'betrachte tafel zahl'\n"
        "Z.B.: betrachte tafel 1\n");
    return 1;                    
  }

  if(welche < 1 )  { 
    write("Diese Zahl ist zu klein!\n");
    return 1;  
  }



  if( welche > sizeof( filter_array(get_dir(PFAD"*"), #'check_dirs ) ))  {

    write("Soviele Motivgruppen gibt es momentan nicht!\n");
    return 1;  
  }

  gruppe= filter_array(get_dir(PFAD"*"), #'check_dirs) [welche-1];


  files=filter_array(get_dir(PFAD""+(filter_array(get_dir(PFAD"*"), #'check_dirs ))[welche-1]+"/*"), #'check_dirs);

  if(!sizeof(files))  { 
    write("Leider ist die Motivgruppe "+CAP(gruppe)+" momentan leer.\n");
    return 1;    
  }

  write("Du betrachtest die Motive aus der Gruppe "+CAP(gruppe)+":\n");

  for(i=0; i<sizeof(files);i++)  {
    nummer= welche*100+(i+1);
    write(""+nummer+".) "+files[i]+"\n");
  }	
  write("\n"
      "Mit 'motiv nummer' kannst Du Dir die Motive ansehen!\n"
      "Siehe auch 'hilfe taetowierung' oder Plakat.\n");


  return 1; 
}




