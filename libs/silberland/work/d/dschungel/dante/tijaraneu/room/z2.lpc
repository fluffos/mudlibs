inherit "std/room";

#include <moving.h>
#include <properties.h>
#include <language.h>
#include <mnpc.h>
#include "/d/dschungel/dante/tijaraneu/room/std_zolom.lpc"

int burner=3;

int exits_versperrt=1;
string wer="";

create()
{
  ::create();

  std_zolom();

  SP(P_INT_LONG, "\t"+BS(
        "Das ist die Hoehle der Zolome. Zolome sind riesengrosse, wurmartige Kreaturen, "
        "die am liebsten in sumpfigen Hoehlen wohnen. "
        "Der Legende nach soll es irgendwo ein uraltes, noch viel groesseres "
        "Zolom geben, von dem alle Zolome dieser Welt abstammen, doch kein "
        "Lebender hat es je gesehen. "
        "Ueberall sieht man den Schleim "
        "und den Dung der Wuermer, so dass man weder den Boden noch die Waende genauer "
        "erkennen kann. Der Schleim ist dick und zaehfluessig und schwappt langsam hin "
        "und her. Der Dung stapelt sich teilweise meterhoch auf und es riecht hier "
        "sehr streng. Angeblich gibt es irgendwo ein Nest der Zolome, wo die "
        "kleinen, jungen Zolome heranreifen und erst hervorkommen, wenn sie "
        "gross sind.")+"@@exit_fun@@");

  AD("schleim",
      "Der Schleim wirft hier seltsame Auffaltungen auf. Die sehen Dir sehr verdaechtig aus. "
      "Hmm, sollte man im Schleim wuehlen?!");
  AD(({"auffaltungen","auffaltung"}),
      "Darin scheint sich etwas zu verbergen.");

  ASE("osten", "check_osten");
  ASE("sueden","check_sueden");

  ACD(({"brenne","brenn"}), "exit_weg");
  ASD(({"dung","ausgang","ausgaenge"}), "exit_fun");

  ACD(({"wuehle","wuehl","wuehlen"}), "get_burner");

  AIT("/d/dschungel/dante/tijaraneu/npc/zolom", REFRESH_DESTRUCT);
}


int get_burner(string str)  {
  object ob;
  NF("Worin willst Du wuehlen?!\n");
  if(str=="im schleim"||str=="in schleim"||str=="schleim")  {

    write(BS(
          "Du wuehlst angeekelt im Schleim."));	
    say(BS(
          CAP_TPN+" wuehlt im Schleim. Lecker!"));

    if(burner)  {
      write(BS(
            "Du findest darin ein seltsames Geraet."));
      ob=clone_object("/d/dschungel/dante/tijaraneu/obj/burner");
      ob->move(TP, M_NOCHECK);
      burner--;
      if(!random(15))  {
        TP->AddPoison(1+random(2));
        write(BS(
              "Der Schleim scheint Dich ein wenig vergiftet zu haben."));
      }	
      return 1;      
    }

    if(!burner)  {
      write(BS(
            "Der Schleim scheint nichts zu enthalten. Vielleicht spaeter..."));
      return 1; 
    }

    return 0; 
  }

  return 0; 
}


string exit_fun()  {
  if(exits_versperrt!=0)  {
    return 
      (BS("Momentan liegt hier enorm viel Dung der Zolome herum, der die Ausgaenge "
          "zu blockieren scheint. Der Weg nach Sueden scheint aber frei zu sein.\n"));
  }

  if(exits_versperrt==0)   {
    return 
      (BS("Momentan sieht man hier nicht so viel Dung der Zolome herumliegen. "+wer+" "
          "hat alle Ausgaenge freigebrannt.\n"));
  }      	                		
}

int exit_weg(string str)  {
  NF("Was willst Du hier wegbrennen?!\n");

  if( str=="dung weg"||
      str=="dung ab"||
      str=="ausgang frei"||
      str=="ausgaenge frei")  {


    write(BS(
          "Du entzuendest einen kleinen Feuerball und versuchst damit die Ausgaenge freizu "
          "brennen."));

    say(BS(
          CAP_TPN+" entzuendet einen kleinen Feuerball und versucht die Ausgaenge freizubrennen."));

    if(exits_versperrt!=0)  {

      BURNER

        BURN

        write(BS(
              "Du brennst die Ausgaenge frei."));
      say(BS(
            CAP_TPN+" brennt die Ausgaenge frei."));
      wer=CAP(getuid(TP));

      exits_versperrt=0;
      return 1; 
    }

    if(exits_versperrt==0)  {
      write(BS(
            "Die Ausgaenge sind momentan nicht durch Dung der Zolome versperrt. "
            ""+wer+" hat sie schon freigebrannt."));
      return 1; 
    }
    return 0; 
  }
  return 0; 
}

reset()  {
  ::reset();
  burner=3;

  if(exits_versperrt==0)  {


    tell_object(TO,
        "Der Dung der Zolome versperrt wieder die Ausgaenge.\n");
    exits_versperrt=1; 
  }
}


int check_osten()  {

  if(exits_versperrt!=0)  {
    write(BS(
          "Du schaffst es nicht ueber den Dung der Zolome hinweg "
          "nach Osten zu gelangen."));
    return 1;    
  }   
  if(exits_versperrt==0)   {

    TPM(ZROOM"z4", M_GO, "nach Osten");
    return 1;
  }

}


int check_sueden()  {

  /*  if(exits_versperrt!=0)  {
      write(BS(
      "Du schaffst es nicht ueber den Dung der Zolome hinweg "
      "nach Sueden zu gelangen."));
      return 1;    
      }   
      if(exits_versperrt==0)   {
      */

  TPM(ZROOM"z1", M_GO, "nach Sueden");
  return 1;              

}		
