
#include "/players/dante/myowndefine.h"
inherit "std/room";
#include <properties.h>
#include <language.h>
#include <wizlevels.h>
#include <moving.h>
#include <ansi.h>
#include <combat.h>
 
 
create()
{
  ::create();

  SetProp( P_INT_SHORT, "In Gravox Haus" );
  SetProp( P_INT_LONG, BS(
"Du bist nun in einem kleinen, bescheidenen Haus in Tijara. Es gehoert "
"Kratz Gravox, dem hiesigen Graveur. An den Waenden haengen einige "
"Geraete, die er wohl zum gravieren braucht. An der Decke haengt eine "
"Oellampe. Sonst siehst Du nur einen "
"Tisch und einen Stuhl. Eine Tuer fuehrt wieder hinaus. "
  "                            Ein Schild."));


ARD("schild",
"+-------------------------------------------------------+\n"
"|                                                       |\n"
"| Willkommen im einzigen Gravur-Laden des Silberlandes! |\n"
"|                                                       |\n"
"+-------------------------------------------------------+\n");
AD("tijara",
"Du bist mitten drin.");
AD(({"kratz","gravox"}),
"Gravox ist Graveur und kann Dir sicher behilflich sein.");
AD("graveur",
"Er kann Dir Dinge gravieren.");
AD(({"ding","dinge","waffen","ruestungen","waffe","ruestung"}),
"Waffen, Ruestungen,...");
AD(({"geraete","geraet"}),
"Sie schauen recht unterschiedlich aus. Spitz, rund, eckig...");
AD("stuhl",
"Der Stuhl ist aus Holz, naja irgendwo muss Gravox ja auch sitzen.");
AD("schild",
"Lies es!");
AD(({"tuer","tuere","westen"}),
"Da gehts raus!");
AD("tisch",
"Der Tisch dient Gravox wohl zum arbeiten.");


AD(({"wand","waende"}),
"Die Waende sind aus Stein. Einige Geraete sind da aufgehaengt.");
  AD(({"gebaeude","haus"}),
"Das Haus ist aus Stein und eher bescheiden.");
AD("stein",
"Grauer und brauner Stein.");

AD("boden",
"Der Boden besteht aus festgewalzten Lehm.");
AD("lehm",
"Der Lehm ist schmutzig und braun.");
    
AD(({"steine","stein"}),
"Die Steine sehen voellig uninteressant aus.");
AD("decke",
"Die Decke besteht aus grobem Holz und ist recht niedrig.");
AD("holz",
"Grob behauenes, dunkles Holz. Eine Oellampe haengt herunter.");
AD(({"lampe","oellampe"}),
"Sie erhellt das Haus etwas.");


  
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );


  AE("westen", "./ti_pfad13");

AIT("/d/dschungel/dante/tijaraneu/npc/gravox", REFRESH_DESTRUCT);



 AddSound( DEFAULT_SOUND,
     "Du glaubst Laerm zu hoeren.");
     AddSound("laerm",
     "Das ist eben eine Stadt hier.\n");
     AddSound("stadt",
     "LAUT!!!!!");
     
 AddSmell( DEFAULT_SMELL,
  "Es riecht hier nach frischer Luft.");

AddSmell("luft",
"Frisch.");


}
