/*
pfad von alttijara nach neuneutijara 
dante 99.08.29

*/


#include "/players/dante/myowndefine.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <wizlevels.h>
#include <moving.h>
#include <mnpc.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Ein kleiner Pfad in Tijara" );
  SetProp( P_INT_LONG, BS(
  "Du befindest Dich nun auf einem schmalen Pfad in Tijara. Er verbindet "
  "das Wohngebiet mit den neueren Teilen der Stadt. "
  "Am Boden liegen helle Kieselsteine. "
  "Vom Himmel brennt die Sonne erbarmungslos herab. "
  "Im Suedosten sieht man ein grosses, prunkvolles Gebaeude. " 
  "Im Norden kommt man wieder zurueck und im Sueden versperrt ein grosses "
  "Tor den Pfad. Eine aufaellige Statue steht direkt neben dem Gebaeude."));
  
  AD("statue",
  "Die Statue zeigt Justl.");
  AD("justl",
  "Justl sieht recht irr drein und scheint irgendwas zu bruellen. Sieht so "
  "aus als ob er 'Typo' bruellt. Das nervt Dich. Du kannst Justl treten.");
  AD("typo",
  "Gibt es keine!!! :-)");
  
  AD("gebaeude",
  "Es wurde aus Marmor erbaut und glaenzt hell in der Sonne.");
  AD("marmor",
  "Seltsam, in den Marmor hat man unglaublich viele, verschiedene "
  "Zahlen eingemeiselt.");
  
  AD(({"zahl","zahlen"}),
  "Es muessen, nein, es sind soviele, dass es Dir unmoeglich ist sie zu zaehlen...");
  
  
AD("suedosten",
"Geh weiter.");
AD("sueden",
"Das Tor ist momentan fest verschlossen.");  
 AD("tor",
 "Das Tor scheint hier den Pfad abzuriegeln. Was dahinter ist kann man auch nicht "
 "erkennen.");
 AD("norden",
 "Der Pfad fuehrt wieder zurueck in die zentraleren Teile von Tijara.");
 
  
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 29, ENV_TERRAIN: TT_TOWN]) );

AD("decke",
"Nur der Himmel ist hier.");
AD(({"wand","waende"}),
"Hier kaum zu sehen.");

AddDetail("pfad",
"Der Pfad fuehrt nach Norden und Osten.");
AddDetail(({"teil","teile"}),
"Sie wurden erst nachtraeglich angebaut, denn Tijara waechst und waechst.");
AddDetail(({"kieselstein","kiesel","kieselsteine"}),
"Die Kieselsteine sind natuerlich viel kleiner als die anderen Steine. Sie "
"sind hell und sauber.");



  
  AddDetail( ({ "tijara", "stadt" }), BS(
    "Du befindest Dich mitten in den neueren Teilen von Tijara.") );
  AddDetail( ({ "sonne", "himmel", "hitze" }), BS(
    "Die Sonne brennt erbarmungslos vom Himmel herunter, und das ist auch "
    "der Grund fuer die Hitze hier.") );
 AD("grund",
 "Die Sonne.");
 
 
  AddDetail( ({ "hauptplatz", "platz" }), BS(
    "Der Hauptplatz von Tijara ist im Nordwesten. Er scheint sehr gross zu "
    "sein, aber Du bist noch zu weit weg, um naeheres erkennen zu "
    "koennen.") );
  AddDetail( ({ "gardist", "gardisten" }), BS(
    "Obwohl die Gardisten die Stadt sehr gut bewachen, ist gerade keiner "
    "in der Naehe.") );
  AddDetail( ({ "boden", "stein", "steine"}), BS(
  "Der Boden ist uebersaeht mit Kieselsteinen, die wohl den Pfad bilden."));
  
  
  AddDetail( ({ "wohngebiet", "wohnung", "wohnungen", "gebiet" }), BS(
   "Das Wohngebiet liegt etwas weiter im Nordwesten."));
   

AD("nordwesten",
"Dort liegt die Strasse, das Wohngebiet und noch weiter nordwestlich "
"dann der Hauptplatz.");



//ASE("osten", "nix1");
AE("suedosten", "./galerie");

  
  
  AE("norden", "./ti_pfad7");
  
  AIT("/d/dschungel/dante/weg/npc/dkoli", REFRESH_DESTRUCT,
([ P_MNPC_AREA:"/d/dschungel/",
   P_MNPC_DEFAULTROOM:"/d/dschungel/dante/tijaraneu/room/ti_pfad7",
   P_MNPC_FLAGS:  MOV_BACKWARDS +MOV_MOVES+MOV_OUTDOORS
  ]));
 
  
  AIT("/d/dschungel/dante/weg/npc/dbiene", REFRESH_DESTRUCT,
([ P_MNPC_AREA:"/d/dschungel/",
   P_MNPC_DEFAULTROOM:"/d/dschungel/dante/tijaraneu/room/ti_pfad7",
   P_MNPC_FLAGS:  MOV_BACKWARDS +MOV_MOVES+MOV_OUTDOORS
  ]));
  
  if(random(2) )  {
  AIT("/d/dschungel/dante/weg/npc/dkakadu", REFRESH_DESTRUCT,
([ P_MNPC_AREA:"/d/dschungel/",
   P_MNPC_DEFAULTROOM:"/d/dschungel/dante/tijaraneu/room/ti_pfad7",
   P_MNPC_FLAGS:  MOV_BACKWARDS +MOV_MOVES+MOV_OUTDOORS
  ])); 
 
 

}



 AddSound( DEFAULT_SOUND,
     "Du glaubst Schreie zu hoeren.");
     AddSound("schreie",
     "HHHHILLLLLLLLFFFFFE!!!!!\n");
     
 AddSmell( DEFAULT_SMELL,
  "Es riecht hier nach Tod.");

AddSmell("tod",
"Hmm, Unter Dir...!");
 ACD(({"tritt","trete","tret"}), "tritt"); 
}

int tritt(string str)  {
     
     if (str=="justl"||str=="statue") {
     	
     write(BS(
     "Du holst mit dem Fuss weit aus und trittst brutal in die Justlstatue."));	
say(BS(
CAP_TPN+" holt weit aus und tritt brutal in Justl."));

switch(random(4))   {
case 0:
write(BS(
"Justl bruellt laut auf und weint. HAHA!!!"));
say(BS(
"Justl bruellt laut auf und weint. HAHA!!!"));
break;
case 1:
write(BS(
"Justl jammert laut!"));
say(BS(
"Justl jammert laut!"));
break;
case 2:
write(BS(
"Justl spuckt Dich an."));
say(BS(
"Justl spuckt "+TP->name(WEN)+" an."));
break;
case 3:

write(BS(
"Du tust Dir nur weh! AUA!"));
say(BS(
CAP_TPN+" tut sich weh! AUA!"));
break;
default:
     }
return 1;  }
}





int nix1()  {
  write(BS(
  "Sorry, momentan noch nicht vollendet!"));
  return 1; }
  
