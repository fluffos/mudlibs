inherit "std/room";


#include "/players/dante/myowndefine.h"
#include <properties.h>
#include <language.h>
#include <moving.h>

create()
{

  ::create();
  SetProp( P_LIGHT, 1 );
  SetProp( P_INT_SHORT, "In einer Jungfrau" );
  SetProp( P_INT_LONG,BS(
"Du bist nun in einer Jungfrau. Nein, was denkst Du?! In einer eisernen "
"Jungfrau natuerlich. Das ist ein Foltergeraet. Dieses hier dient aber nicht "
"wirklich der Folter, sondern hat eher die groesse eines Raumes und ist eher "
"ein Versteck."));  


AD(({"geraet","folter","foltergeraet"}),
"Eigentlich sollte die Jungfrau ja zum Foltern dienen, diese hier aber "
"ist ein Raum.");
AD(({"raum","raumes","versteck"}),
"Hier verstecken sich die alten Jungfrauen...");  
  AD(({"jungfrau"}),
  "Die eiserne Jungfrau dient zum foltern. Ein wirklich abscheuliches "
  "Geraet.");
  
  AddDetail(({"kammer", "folterkammer"}),
  "Die ist drausen.");
  AddDetail("magier",
  "Na, rat mal wer das wohl war...");
  AddDetail(({"wand","waende"}),
  "Die Waende sind aus Metall.");
  AD("metall",
  "Kalt und hart.");

  AddDetail("decke",
  "Die Decke ist niedrig und auch aus Metall.");
  AddDetail("boden",
  "Der Boden ist blutverschmiert.");

  SetProp(P_INDOORS,1);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20,ENV_TERRAIN:TT_CAVE]) );    
AddSound( DEFAULT_SOUND,                                                      
    "Hier ist es voellig still.");   
 AddSmell( DEFAULT_SMELL,                                                      
     "Eigentlich riecht es hier nach nichts.");  


AE("raus", "./fkammer");
}
