/*

   der std_raum fuer den weg in neutijara
   exit eingebaut
   dante; zu angel



*/


#include "/players/dante/myowndefine.h"
inherit "std/room";
#include <properties.h>
#include <language.h>
#include <wizlevels.h>
#include <moving.h>
#include <ansi.h>
#include <mnpc.h>

// Zum Abklemmen der Arena:
// #define NO_ARENA

string show();
int da=3;

void reset()  {
  ::reset();
  da=3;
}

void create()
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einem Weg in Tijara" );
  SetProp( P_INT_LONG, BS(
        "Du befindest Dich nun auf einem Weg in Tijara. Er laeuft von Norden nach Sueden "
        "oder umgekehrt, von wo man eben kommt. "
        "Vom Himmel brennt die Sonne erbarmungslos herab und kein Schatten koennte "
        "Dich vor der Hitze schuetzen. Gluecklicherweise steht direkt neben dem Weg "
        "im Westen ein grosser, prunkvoller Brunnen, der gleichzeitig auch die "
        "Wand bildet. In diesen grossen Brunnen, hat man ein massives Tor eingebaut. Es ist offen. "
        "Den Weg markieren ordentlich verlegte weisse Platten, die aus Stein bestehen. "
        "Im Osten siehst Du ein wild aussehendes Gebaeude, vor dem grosse Totems "
        "stehen. An die Waende wurden Schrumpfkoepfe genagelt und ober der Tuere "
        "steht ein aus Knochen gebildeter Schriftzug. Das Tor im Westen fuehrt "
        "in die erste Arena des Silberlandes!"));
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 31, ENV_TERRAIN: TT_TOWN]) );

  AddDetail("silberland",
      "Hmm, was ist das?!");
  AddDetail(({"gegner","gegnern"}),
      "Es muessen sehr viele Gegner gestorben sein...");
  AddDetail(({"tuer","tuere"}),
      "Die Tuere steht offen. Ober ihr ist ein aus Knochen bestehender Schriftzug angebracht.");
  AddDetail("knochen",
      "Die Knochen gehoerten einst den Gegnern des Besitzers des Hauses.");
  AddDetail(({"schriftzug","schrift"}),
      "Lies ihn!");
  AddDetail("tor",
      "Das Tor fuehrt zwischen den grossen Skulpturen hindurch in die Arena.");
  AddDetail("arena",
      "Geh hin!");
  ARD(({"schrift","schriftzug"}), #'show);

  AddDetail(({"schatten"}),
      "Kein Schatten zu sehen.");
  AddDetail("hitze",
      "Hier im Dschungel ist es wirklich verdammt heiss.");
  AddDetail("dschungel",
      "Tijara ist die Hauptstadt des Dschungels.");
  AddDetail(({"stadt","hauptstadt"}),
      "Sie ist die beste Stadt ueberhaupt!");
  AddDetail("westen",
      "Im Westen steht ein grosser, prunkvoller Brunnen. Er besteht aus mehrern "
      "grossen Skulpturen, die ein massives Tor umrahmen. Dort ist die Arena!");
  AddDetail("brunnen",
      "Der Brunnen besteht aus Skulpturen, die aus Marmor gemeiselt wurden.");
  AddDetail("marmor",
      "Marmor aus dem Dschungel.");
  AddDetail(({"skulpturen","skulptur"}),
      "Die Skulpturen wirken wild und bedrohlich, sie haben lange Haare und "
      "wirken irgendwie betrunken. Eine Skulptur, ein Magier, scheint sich zu uebergeben. "
      "Waeh! Widerlich! Das Tor ist von den Skulpturen umrahmt.");
  AddDetail("magier",
      "Aus dem weit aufgerissenen Mund des Magiers fliesst eiskaltes Wasser, das "
      "am Boden in einem Loch versickert.");
  AddDetail("mund",
      "Aus dem Mund stroemt herrliches kuehles Wasser.");
  AddDetail(({"haar","haare"}),
      "Lange eklige Haare! Pfui!");
  AddDetail("wasser",
      "Das Wasser ist herrlich kuehl und erfrischend! Man kann es sicher kosten!");
  AddDetail("loch",
      "In diesem Loch versickert das Wasser...");
  AddDetail("osten",
      "Im Osten steht ein merkwuerdiges Gebaeude. Totems stehen davor!");
  AddDetail(({"totems","totem"}),
      "Die Totems stellen erschlagene Gegner des Besitzers des Hauses dar."),
  AddDetail(({"gebaeude","haus"}),
      "Das Haus wirkt sehr interessant, doch auch unheimlich.");
  AddDetail("besitzer",
      "Wem mag es wohl gehoeren?!");
  AddDetail(({"wand","waende"}),
      "Die Wand des Hauses im Osten ist mit graesslichen Schrumpfkoepfen verziert.");
  AddDetail(({"kopf","schrumpfkopf","koepfe","schrumpfkoepfe"}),
      "Diese Koepfe gehoerten einst den Gegnern des Besitzers des Hauses. Er hat sie "
      "alle eigenhaendig erschlagen!");
  AddDetail("decke",
      "Nur der Himmel ist hier.");
  AddDetail( ({ "tijara", "stadt","teile","teilen" }), BS(
        "Du befindest Dich mitten in den neueren Teilen von Tijara.") );
  AddDetail( ({ "sonne", "himmel" }), BS(
        "Die Sonne brennt erbarmungslos vom Himmel herunter, und das ist auch "
        "der Grund fuer die Hitze hier.") );
  AddDetail("grund",
      "Die Sonne.");
  AddDetail( ({ "weg","sueden" }),
      "Der Weg geht hier nach Norden weiter. Nach Sueden auch, klar!");
  AddDetail( ({ "hauptplatz", "platz" }), BS(
        "Der Hauptplatz von Tijara ist im Nordwesten. Er scheint sehr gross zu "
        "sein, aber Du bist noch zu weit weg, um naeheres erkennen zu "
        "koennen.") );
  AddDetail( ({ "gardist", "gardisten" }), BS(
        "Obwohl die Gardisten die Stadt sehr gut bewachen, ist gerade keiner "
        "in der Naehe.") );
  AddDetail( ({ "boden", "stein", "steine"}),
      "Der Boden wird hier durch Steinplatten gebildet.");
  AddDetail("stein",
      "Der Stein war einmal weiss, nun ist er grau.");
  AddDetail(({"platte","platten","steinplatten","steinplatte"}),
      "Sie sind ordentlich verlegt "
      "und fuehren nach Norden und Sueden weiter.");
  AddDetail("norden",
      "Der Weg fuehrt hier weiter nach Norden.");
  AddDetail( ({ "wohngebiet", "wohnung", "wohnungen", "gebiet" }), BS(
        "Das Wohngebiet liegt etwas weiter im Westen."));

  AddSound( DEFAULT_SOUND,
      "Du glaubst Laerm zu hoeren.");
  AddSound("laerm",
      "Das ist eben eine Stadt hier.\n");
  AddSmell( DEFAULT_SMELL,
      "Es riecht hier nach frischer Luft.");
  AddSmell("luft",
      "Frisch.");

  if(random(3))  {
    AIT("/d/dschungel/dante/weg/npc/dfrosch1", REFRESH_DESTRUCT,
        ([ P_MNPC_AREA:"/d/dschungel/",
           P_MNPC_DEFAULTROOM:"/d/dschungel/dante/tijaraneu/room/ti_pfad11",
           P_MNPC_FLAGS:  MOV_BACKWARDS +MOV_MOVES+MOV_OUTDOORS
           ]));
  }
  if(random(3))  {
    AIT("/d/dschungel/dante/weg/npc/dschlange", REFRESH_DESTRUCT,
        ([ P_MNPC_AREA:"/d/dschungel/",
           P_MNPC_DEFAULTROOM:"/d/dschungel/dante/tijaraneu/room/ti_pfad11",
           P_MNPC_FLAGS:  MOV_BACKWARDS +MOV_MOVES+MOV_OUTDOORS
           ]));
  }

  ACD(({"kost","koste","kosten"}), "kosten");

  AE( "osten", "./tladen" );
  AE("sueden","/d/dschungel/dante/ratmanquest/room/ti_pfad10");
  // ASE("norden", "nix1");
  AE("norden", "./ti_pfad12");
  // ASE("westen", "nix1");
#ifndef NO_ARENA
// Arena abgehaengt wegen Bug auf Anfrage von Malar (Cirion)
  AE("westen", "/d/dschungel/angel/arena/room/suedteil");
  AddItem("/d/dschungel/angel/arena/npc/arena_guard.lpc", REFRESH_DESTRUCT);
#endif
}



int kosten(string str)  {

  NF("Was willst Du kosten?!\n");
  if(str=="wasser"||str=="von wasser"||str=="vom wasser")  {

    write(BS(
          "Du kostest vom eiskalten Wasser."));
    say(BS(
          CAP_TPN+" kostet vom eiskalten Wasser."));

    if(da)  {
      /*
              call_other("/obj/tmp_prop_master", "SetTmpProp", this_player(),
              P_TEMPERATURE_OFFSET,
              this_player()->QueryProp(P_TEMPERATURE_OFFSET)-8,180);
              */
      write(BS(
            "AHHH!!! Das Wasser ist nicht nur erfrischend, es kuehlt Dich auch herrlich. "
            "Das heisse Wetter macht Dir nun weniger aus."));
      TP->heal_self(15+random(30));
      say(BS(
            CAP_TPN+" sieht sehr erfrischt aus."));

      da--;
      return 1;
    }

    else   {
      write(BS(
            "So erfrischend ist es nun auch wieder nicht."));
      return 1;
    }
    return 0;
  }
  return 0;
}


string show()  {

  return

    ""+ANSI_BOLD+""+ANSI_RED+""
    "\t\t          KANNIBALEN TAETOWIERUNGEN\n\n"
    "\t\t                gemacht von\n\n"
    "\t\toriginal, Ex-Kannibalen und Spielerjaeger Knochen-Joe.\n\n"
    ""+ANSI_NORMAL+"";

}

int nix1()  {
  write(BS(
        "Momentan geschlossen, bitte spaeter wieder kommen! Danke!"));
  return 1;
}



