
/*
   erster raum des hauses der zahlen
   nix anders als raeume wo man statistiken sehen kann

   hier zolome
   dante sl 2000-99
   */


inherit "std/room";
inherit "std/more";
#include <properties.h>
#include "/players/dante/myowndefine.h"
#include <moving.h>

#define STATMASTER ("/d/dschungel/dante/tijaraneu/obj/statmaster")

create()   {
  ::create();


  SetProp( P_INT_SHORT, "Im Haus der Zahlen - Zolome" );
  SetProp( P_INT_LONG, 
      "Du bist nun im Haus der Zahlen und stehst in einer prunkvollen Halle "
      "aus weissem Marmor. An den Waenden sieht man ueberall eingemeisselte "
      "Zahlen, es sind soviele Zahlen, dass Dir fast schwindlig wird. "
      "Der Boden besteht aus schweren, roten Samt, in den auch ueberall "
      "Zahlen eingestickt wurden. Im Nordwesten kommst Du wieder nach draussen, "
      "eine prunkvolle Treppe aus Marmor fuehrt nach oben.\n"
      "Zwei Informationstafeln.\n"
      "Ein grosses Bild!\n"
      "Ein Schild!\n");

  AD("schild", "Lies es!");
  ARD("schild",
      "*****************************************************************************\n"
      "*                            Die Zolomplage!                                *\n"
      "*                                                                           *\n"
      "* Unter der Stadt Tijara gibt es irgendwo eine Hoehle, in der Zolome hausen.*\n"
      "* Zolome sind unheimliche, uralte, riesige, wurmartige Wesen, die seit      *\n" 
      "* jeher die Todfeinde aller Riesen sind.                                    *\n"
      "* Diese Wuermer werden merkwuerdiger Weise in Eiern ausgebruetet.           *\n"
      "* Tapfere Krieger sollen angeblich schon dieses Nest gefunden und zerstoert *\n"
      "* haben. Doch was sie nicht wussten, war, dass sie damit eine Katastrophe   *\n"
      "* ausgeloest hatten. Heerscharen von kleinen, jungen Zolome ueberfielen     *\n"
      "* die Plantagen von Tijara und vernichteten die gesamte Ernte.              *\n"
      "* Seit diesen Tagen kann man, wenn wieder eine Plage die Plantagen bedroht, *\n"
      "* sich als Soeldner verdingen und fuer jedes tote Zolom Kopfgeld erhalten.  *\n"
      "* Nur muss sich vorher ein Held finden, der die Kraft hat bis zum Nest      *\n"
      "* vorzudringen.                                                             *\n"
      "* Wenn Du dann Zolome erschlagen hast, so komme hier her zurueck und        *\n"
      "* frage Cosinus nach 'kopfgeld'.                                            *\n"
      "* Aber beeile Dich! Weder die Zolome noch das Kopfgeld sind allzu lange     *\n"
      "* zu finden!                                                                *\n"
      "*                                                                           *\n"
      "*                                                                Dante      *\n"
    "*****************************************************************************\n");


  AD("treppe",
      "Die Treppe fuehrt leicht geschwungen nach oben.");

  AD("nordwesten",
      "Da kommst Du wieder hinaus.");
  AD("boden",
      "Der Boden wurde mit rotem Samt ueberzogen.");
  AD("samt",
      "Er sieht sehr elegant und schwer aus. Viele Zahlen wurden eingestickt.");


  AD("decke",
      "Die Decke besteht aus weissem Stuck, der irgendwie kitschig wirkt.");
  AD("stuck",
      "Hmm, eigentlich uebertrieben.");




  AD("haus",
      "Du bist im Haus der Zahlen, einem prunkvollen Gebaeude aus Marmor.");
  AD("gebaeude",
      "Es sieht wirklich beeindruckend aus.");
  AD("marmor",
      "Der Marmor muss sehr teuer gewesen sein. Er glaenzt weisslich.");
  AD("halle",
      "Die Halle wirkt sehr elegant mit dem Marmor und dem roten Samt.");
  AD(({"wand","waende"}),
      "Die Waende bestehn aus weissem Marmor, in dem viele Zahlen eingraviert wurden.");
  ASD(({"zahl","zahlen"}), "zahlen");
  AD (({"kordel", "weg"}),
      "Eine dicke Kordel versperrt momentan den Weg nach oben!");

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN:TT_HOUSE]) );


  AddDetail(({"tafel","tafeln","informationstafel"}),
      "Du kannst die Tafeln lesen, und zwar mit\n\n"+
      "         lies informationstafel\n"+
      "                  oder\n"+
      "         lies tafel [nummer] <nummer der tafel>\n");

  AddCmd(({"lese","lies"}),"lesen");


  ASD("bild", "zolom");


  AE("nordwesten", "./ti_pfad8");
  ASE("oben", "nix");

  call_out("new_cosinus", 1);

}


reset()  {
  ::reset();
  new_cosinus();  
}



new_cosinus()  {
  object cosinus, finde;
  finde=find_living("cosinus");

  if(finde)  {
    tell_room(TO, BS(
          "Cosinus begutachtet all die vielen Zahlen hier."));
    return;  
  }

  if(!finde)   {
    cosinus=clone_object("d/dschungel/dante/tijaraneu/npc/cosinus");
    cosinus->move(TO, M_NOCHECK+M_TPORT);
    return;
  }
}



int nix()  {
  write(BS(
        "Eine dicke Kordel versperrt momentan den Weg nach oben! "
        "Das obere Stockwerk wurde noch nicht eroeffnet."));
  return 1; 
}

string zolom()  {
  sprintf(""+TP->More(read_file("/d/dschungel/dante/tijaraneu/ascii/t-rex.txt"))+"");
  return "       TIREKS\n";
}



lesen(was)
{
  int nummer;

  notify_fail(
      "Wenn Du die Tafel lesen moechtest, versuche mal folgendes:\n\n"+
      "         lies informationstafel\n"+
      "                  oder\n"+
      "         lies tafel [nummer] <nummer der tafel>\n");

  if (!was) return 0;

  if(was=="informationstafel")   {

    write(
        "+--------------------------------------------------------+\n"
        "| 	                                                 |\n"
        "|  Hier koennen Sie allerhand ueber Zolome und Spieler   |\n"
        "|                      erfahren!                         |\n"
        "|                                            Dante       |\n"
        "+--------------------------------------------------------+\n");

    return 1; 
  }

  if (sscanf(was,"tafel %d",nummer) != 1)
    if  (sscanf(was,"tafel nummer %d",nummer) != 1 )
      return 0;

  switch (nummer)
  {
    case 1: ::More(STATMASTER->query_best_players(CAP(getuid(TP))));
            break;

    case 2: ::More(STATMASTER->query_pers_rekord(CAP(getuid(TP))));
            break;

    default: write(
                 "Eine Tafel mit der Nummer gibt es leider nicht.\n");
  }
  return 1;
}


string zahlen()  {
  int zahl;
  zahl=1+random(100000000);
  return BS(
      "Du siehst die Zahl "+zahl+"!");
}

