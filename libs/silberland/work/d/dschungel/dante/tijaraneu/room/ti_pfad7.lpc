/*
   pfad von alttijara nach neuneutijara 
   dante 99.08.29

*/


#include "/players/dante/myowndefine.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <wizlevels.h>
#include <moving.h>
#include <mnpc.h>



create()
{
  ::create();

  SetProp( P_INT_SHORT, "Ein kleiner Pfad in Tijara" );
  SetProp( P_INT_LONG, BS(
        "Du befindest Dich nun auf einem schmalen Pfad in Tijara. Er verbindet "
        "das Wohngebiet mit den neueren Teilen der Stadt. "
        "Am Boden liegen helle Kieselsteine. "
        "Vom Himmel brennt die Sonne erbarmungslos herab. "
        "Hier gabelt sich der Pfad auf. Du kannst nach Osten und Sueden weitergehen."
        " Im Suedosten sieht man eine kleine Holzhuette." 
        " Im Norden kommt man in den alten Teil von Tijara zurueck. "
        "Im Boden siehst Du ein grosses Loch, das den Eingang in einen alten, verfallenen "
        "Schacht bildet."));

  AD("loch",
      "Es fuehrt tief nach unten in den Schacht.");
  AD("eingang",
      "Dunkel und unheimlich gaehnt er im Boden.");

  AD("schacht",
      "Wohin der Schacht fuehrt weiss man nicht.");

  AD(({"holzhuette","huette","holz"}),
      "In der Huette befindet sich ein sehr spezieller Laden! Besuche ihn unbedingt.");


  AD("osten",
      "Geh weiter.");
  AD("sueden",
      "Dahin kannst Du auch gehen.");  

  AD(({"sachen","sache","laden"}),
      "Dort kann man sicher tolle Sachen machen!");


  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 29, ENV_TERRAIN: TT_TOWN]) );
  //alles exakt wie bei fey


  AD("decke",
      "Nur der Himmel ist hier.");
  AD(({"wand","waende"}),
      "Hier kaum zu sehen.");

  AD("westen",
      "Da geht der Pfad direkt nach Tijara weiter.");
  AddDetail("pfad",
      "Der Pfad fuehrt nach Osten und Sueden in die neueren Teile von Tijara.");
  AddDetail(({"teil","teile"}),
      "Sie wurden erst nachtraeglich angebaut, denn Tijara waechst und waechst.");
  AddDetail(({"kieselstein","kiesel","kieselsteine"}),
      "Die Kieselsteine sind natuerlich viel kleiner als die anderen Steine. Sie "
      "sind hell und sauber.");




  AddDetail( ({ "tijara", "stadt" }), BS(
        "Du befindest Dich mitten in den neueren Teilen von Tijara.") );
  AddDetail( ({ "sonne", "himmel", "hitze" }), BS(
        "Die Sonne brennt erbarmungslos vom Himmel herunter, und das ist auch "
        "der Grund fuer die Hitze hier.") );
  AD("grund",
      "Die Sonne.");

  AddDetail( ({ "strasse", "weg", "knick" }), 
      "Die Strasse liegt im Nordwesten.");

  AddDetail( ({ "hauptplatz", "platz" }), BS(
        "Der Hauptplatz von Tijara ist im Nordwesten. Er scheint sehr gross zu "
        "sein, aber Du bist noch zu weit weg, um naeheres erkennen zu "
        "koennen.") );
  AddDetail( ({ "gardist", "gardisten" }), BS(
        "Obwohl die Gardisten die Stadt sehr gut bewachen, ist gerade keiner "
        "in der Naehe.") );
  AddDetail( ({ "boden", "stein", "steine"}), BS(
        "Der Boden ist uebersaeht mit Kieselsteinen, die wohl den Pfad bilden."));


  AddDetail( ({ "wohngebiet", "wohnung", "wohnungen", "gebiet" }), BS(
        "Das Wohngebiet liegt etwas weiter im Nordwesten."));


  AD("nordwesten",
      "Dort liegt die Strasse, das Wohngebiet und noch weiter nordwestlich "
      "dann der Hauptplatz.");



  AE("sueden", "./ti_pfad8");


  AE( "suedosten", "/d/dschungel/protheg/neutijara/room/hofer");

  //ASE("osten", "nix1");

  AE("norden", "./ti_pfad5");


  AE("unten", "./z0");
  //ASE("unten", "nix1");

  AE("osten", "./ti_pfad6");

  AddSound( DEFAULT_SOUND,
      "Du glaubst Schreie zu hoeren.");
  AddSound("schreie",
      "HHHHILLLLLLLLFFFFFE!!!!!\n");

  AddSmell( DEFAULT_SMELL,
      "Es riecht hier nach Tod.");

  AddSmell("tod",
      "Nordunten!");
  if(random(3))  {

    AIT("/d/dschungel/dante/weg/npc/dschimp", REFRESH_DESTRUCT,
        ([ P_MNPC_AREA:"/d/dschungel/",
         P_MNPC_DEFAULTROOM:"/d/dschungel/dante/tijaraneu/room/ti_pfad7",
         P_MNPC_FLAGS:  MOV_BACKWARDS +MOV_MOVES+MOV_OUTDOORS
         ]));  
  }

  AIT("/d/dschungel/dante/weg/npc/dkakadu", REFRESH_DESTRUCT,
      ([ P_MNPC_AREA:"/d/dschungel/",
         P_MNPC_DEFAULTROOM:"/d/dschungel/dante/tijaraneu/room/ti_pfad7",
         P_MNPC_FLAGS:  MOV_BACKWARDS +MOV_MOVES+MOV_OUTDOORS
         ]));




}


int nix1()  {
  write(BS(
        "Sorry, momentan noch nicht vollendet!"));
  return 1; 
}

