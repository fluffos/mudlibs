inherit "std/room";

#include <moving.h>
#include <properties.h>
#include <language.h>
#include <mnpc.h>
#include "/d/dschungel/dante/tijaraneu/room/std_zolom.lpc"

int exits_versperrt=0;
string wer="Kerak, der Riese";


/*
   init()  {
   ::init();

   if( getuid(TP)=="baldur" || getuid(TP)=="fenris"  ) {
   TP->move("/d/dschungel/dante/weg/room/brunnen3", M_GO+M_NO_SHOW);
   write(BSA(
   "Petzen, falsche Hunde, Prolos und Moechtegernbodybuilder haben hier nichts mehr verloren."
