/*
   pfad von alttijara nach neuneutijara 
   dante 99.08.29

*/


#include "/players/dante/myowndefine.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <wizlevels.h>
#include <moving.h>

int time1auf=9;
int time1zu=12;

int time2auf=15;
int time2zu=18;

int time3auf=21;
int time3zu=24;


string mitarbeiter=("Protheg");

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Ein kleiner Pfad in Tijara" );
  SetProp( P_INT_LONG, BS(
        "Du befindest Dich nun auf einem schmalen Pfad in Tijara. Er verbindet "
        "das Wohngebiet mit den neueren Teilen der Stadt. "
        "Am Boden liegen helle Kieselsteine. "
        "Im Norden siehst Du ein grosses Gebaeude, das Dich sehr interessiert. "
        "Es liegt etwas tiefer als der Pfad. "
        "Vom Himmel brennt die Sonne erbarmungslos herab. "
        "Hier gabelt sich der Pfad auf. Du kannst nach Suedosten und Westen weitergehen. "
        "Im Nordwesten und Westen kommt man in den alten Teil von Tijara zurueck. "
        "                                                            Ein Schild! "));
  SetProp( P_LIGHT, 2 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 29, ENV_TERRAIN: TT_TOWN]) );
  //alles exakt wie bei fey


  AddDetail("schild",
      "Auf dem Schild steht ein Text! Lies ihn!");
  AddDetail("text",
      "LESEN!!!");
  ARD("text",
      "+-----------------------------------------------+\n"
      "+                                               +\n"
      "+ Buero fuer Antraege auf private Gegenstaende! +\n"
      "+                                               +\n"
      "+ Oeffnungszeiten:                              +\n"
      "+                                               +\n"
      "+ "+time1auf+" bis "+time1zu+" Uhr                                 +\n"
      "+ "+time2auf+" bis "+time2zu+" Uhr                                 +\n"
      "+ "+time3auf+" bis "+time3zu+" Uhr                                 +\n"
      "+                                               +\n"
      "+                                               +\n"
      "+                                               +\n"
      "+ Kein Ruhetag!                                 +\n"
      "+                                               +\n"
      "+ Dante, i. N. von               "+mitarbeiter+"!       +\n"
      "+                                               +\n"
      "+-----------------------------------------------+\n");



  AddDetail("gebaeude",
      "Das Gebaeude beinhaltet das Buero fuer Antraege auf private Gegenstaende.");  
  AddDetail(({"buero","antrag","antraege","gegenstand","gegenstaende"}),
      "Das Buero wurde von Dante gegruendet und wird nun von mehreren Magiern "
      "betreut. Dort kannst Du einen Antrag stellen auf einen privaten Gegenstand. Alles "
      "andere erfaehrst Du im Buero!");
  AddDetail("dante",
      "Er hat es gegruendet.");
  AddDetail("suedosten",
      "Geh weiter.");
  AddDetail("westen",
      "Dahin kannst Du auch gehen.");  
  AddDetail("decke",
      "Nur der Himmel ist hier.");
  AddDetail(({"wand","waende"}),
      "Hier kaum zu sehen.");
  AddDetail("westen",
      "Da geht der Pfad direkt nach Tijara weiter.");
  AddDetail("pfad",
      "Der Pfad fuehrt nach Suedosten in die neueren Teile von Tijara.");
  AddDetail(({"teil","teile"}),
      "Sie wurden erst nachtraeglich angebaut, denn Tijara waechst und waechst.");
  AddDetail(({"kieselstein","kiesel","kieselsteine"}),
      "Die Kieselsteine sind natuerlich viel kleiner als die anderen Steine. Sie "
      "sind hell und sauber.");
  AddDetail( ({ "tijara", "stadt" }), 
        "Du befindest Dich mitten in den neueren Teilen von Tijara.");
  AddDetail( ({ "sonne", "himmel", "hitze" }),
        "Die Sonne brennt erbarmungslos vom Himmel herunter, und das ist auch "
        "der Grund fuer die Hitze hier.");
  AddDetail("grund",
      "Die Sonne.");
  AddDetail( ({ "strasse", "weg", "knick" }), 
      "Die Strasse liegt im Nordwesten.");
  AddDetail( ({ "hauptplatz", "platz" }),
        "Der Hauptplatz von Tijara ist im Nordwesten. Er scheint sehr gross zu "
        "sein, aber Du bist noch zu weit weg, um naeheres erkennen zu "
        "koennen.");
  AddDetail( ({ "gardist", "gardisten" }), 
        "Obwohl die Gardisten die Stadt sehr gut bewachen, ist gerade keiner "
        "in der Naehe.");
  AddDetail( ({ "boden", "stein", "steine"}), 
        "Der Boden ist uebersaeht mit Kieselsteinen, die wohl den Pfad bilden.");
  AddDetail( ({ "wohngebiet", "wohnung", "wohnungen", "gebiet" }), 
        "Das Wohngebiet liegt etwas weiter im Nordwesten.");
  AddDetail("nordwesten",
      "Dort liegt die Strasse, das Wohngebiet und noch weiter nordwestlich "
      "dann der Hauptplatz.");

  AddExit( "westen", "./ti_pfad7" );
  AddExit( "nordwesten", "./ti_pfad5" );
  AddExit( "suedosten", "./ti_pfad9" );
  AddSpecialExit("nordunten", "time_check");

  AddItem("/d/dschungel/dante/tijaraneu/npc/clilie", REFRESH_DESTRUCT);

  AddSound( DEFAULT_SOUND,
      "Du glaubst Laerm zu hoeren.");
  AddSound("laerm",
      "Das ist eben eine Stadt hier.\n");
  AddSmell( DEFAULT_SMELL,
      "Es riecht hier nach frischer Luft.");
  AddSmell("luft",
      "Frisch.");

}

int nix1()  {
  if(getuid(TP)=="dante")  {

    TPM("d/dschungel/dante/tijaraneu/room/ti_pfad9", M_GO);

    return 1;  
  }
  else  {

    write(BS(
          "Sorry, momentan noch nicht vollendet!"));
    return 1; 
  }
}  

/*
   int nix1()  {
   write(BS(
   "Sorry, momentan noch nicht vollendet!"));
   return 1; }
   */


int time_check()  {
  string mom;
  string stunde;
  int stundeint;

  mom=dtime(time());
  stunde=dtime(time())[19..20];
  stundeint=to_int(stunde);

  if(IS_WIZARD(TP))  {
    write(BS(
          "Magier duerfen immer..."));

    TPM("/d/dschungel/dante/private_obj/objbuero", M_GO, "froehlich ins Buero", "geht",
        "kommt froehlich herein");

    return 1;  
  }

  if  (  ( stundeint>=time1auf  && stundeint<time1zu) ||
      ( stundeint>=time2auf  && stundeint<time2zu) || 
      ( stundeint>=time3auf  && stundeint<time3zu) )  {

    write(BS(
          "Du hast Glueck, das Buero hat gerade offen. Du gehst froehlich hinein."));
    TPM("/d/dschungel/dante/private_obj/objbuero", M_GO, "froehlich ins Buero", "geht",
        "kommt froehlich herein");


    return 1;  
  }	

  write("Du versuchst in das Buero fuer private Gegenstaende zu gehen!\n");

  write(BSA(
        "HE! "+TPN+"! Es ist momentan genau "+dtime(time())[19..]+"! "
        "Das bedeutet, wir haben Pause und das Buero ist geschlossen! Komm "
        "bitte spaeter wieder. ", "Eine lahme Stimme bruellt aus dem Buero heraus: "));

  return 1; 
}
