/*

  der std_raum fuer den weg in neutijara
  dante
 */


#include "/players/dante/myowndefine.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <wizlevels.h>
#include <moving.h>
#include <ansi.h>
#include <mnpc.h>

#define ZOOHANDLUNG "/d/dschungel/angel/petshop/room/petshop"
#define PREIS 100
#define HLB_ARRA "/d/wueste/protheg/arrakeen/room/ara_2_4_0"

void create()
{
  ::create();
  
  SetProp(P_INT_SHORT, "Auf einem Weg in Tijara");
  SetProp(P_INT_LONG, 
	  BS("Du befindest Dich nun auf einem Weg in Tijara. Er geht hier von "
	     "Sueden nach Norden. Hell scheint die Sonne am Himmel. Man sieht "
	     "keine Schatten. Die Hitze ist fast nicht zu ertragen. "
	     "Weisse Platten, die aus Stein bestehen, zeigen Dir den Weg. "
	     "Im Osten steht ein Haus aus Stein. Die Tuere steht offen. "
	     "Im Westen steht eine massive Mauer, dahinter ist die Arena. "
	     "Du kannst sie etwas weiter im Sueden betreten.")+
	  BS("Eine grosse Holzkonstruktion mit einer Holztreppe, an "
	     "deren Ende ein Schild befestigt ist, steht hier."));
  
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 31, ENV_TERRAIN: TT_TOWN]));
  
  AD(({"fassade","wand","waende"}),
     "Die Fassade glaenzt und blinkt in der Sonne.");

  AD("osten",
     "Das Gebaeude im Osten ist eine Tierhandlung.");

  AD(({"tierhandlung", "handlung"}),
     "Dort kannst Du Dir ein Tier kaufen!");

  AD("haus",
     "Das Haus ist eine Tierhandlung.");

  AD(({"tuer","tuere"}),
     "Die Tuere steht offen und Du bist scheinbar willkommen.");

  AD("westen",
     "Da siehts Du die grosse Mauer und dahinter liegt die Arena!");        

  AD("mauer",
     "Die Mauer besteht aus grossen, geschliffenen Steinen.");

  AD(({"stein","steine"}),
     "Sie sind grauweiss und quaderfoermig. Die Steine vom Haus sind eher "
     "grau bis braun.");

  AD("arena",
     "Im Sueden kannst Du sie betreten und Dich dort duellieren.");

  AD("silberland",
     "Hmm, was ist das?!");

  AD(({"schatten"}),
      "Kein Schatten zu sehen.");

  AD("hitze", 
      "Hier im Dschungel ist es wirklich verdammt heiss.");

  AD("dschungel",
      "Tijara ist die Hauptstadt des Dschungels.");

  AD(({"stadt","hauptstadt"}),
      "Sie ist die beste Stadt ueberhaupt!");

  AD("decke",
     "Nur der Himmel ist hier.");

  AD(({"tijara", "stadt","teile","teilen" }), 
     "Du befindest Dich mitten in den neueren Teilen von Tijara.");

  AD(({"sonne"}), 
     "Die Sonne brennt erbarmungslos vom Himmel herunter, und das ist auch "
     "der Grund fuer die Hitze hier.");

  AD("grund",
     "Die Sonne.");
  
  AD(({"weg","sueden"}), 
     "Der Weg geht hier nach Norden weiter. Nach Sueden auch, klar!");

  AD(({"hauptplatz", "platz"}),
     "Der Hauptplatz von Tijara ist im Westen. Er scheint sehr gross zu "
     "sein, aber Du bist noch zu weit weg, um naeheres erkennen zu "
     "koennen.");

  AD(({"gardist", "gardisten"}),
     "Obwohl die Gardisten die Stadt sehr gut bewachen, ist gerade keiner "
     "in der Naehe.");

  AD(({"boden", "stein", "steine"}), 
     "Der Boden wird hier durch Steinplatten gebildet.");

  AD("stein",
     "Der Stein war einmal weiss, nun ist er grau.");

  AD(({"platte","platten","steinplatten","steinplatte"}),
     "Sie sind ordentlich verlegt und fuehren nach Norden und Sueden weiter.");

  AD("norden",
     "Der Weg fuehrt hier weiter nach Norden.");
  
  AD(({"tier","tiere"}),
     "Es gibt viele verschiedene Tiere zu kaufen.");

  AD(({"wohngebiet", "wohnung", "wohnungen", "gebiet"}),
     "Das Wohngebiet liegt etwas weiter im Westen.");

  AddDetail(({"treppenende","ende","holztreppenende"}),
	    "Am Ende der Holztreppe ist ein Schild befestigt.");

  AddDetail(({"konstruktion","holzkonstruktion"}),
	    "Eine seltsam anmutende Holzkonstruktion, die entfernt an einen "
	    "Galgen erinnert.");

  AddDetail(({"galgen"}),
	    "Nein, das ist ganz sicher kein Galgen, da bist Du Dir ziemlich "
	    "sicher.");

  AddDetail(({"treppe","holztreppe"}),
	    "Eine hoelzerne Treppe fuehrt hinauf zu einem Podest auf der "
	    "Holzkonstruktion.");

  AddDetail(({"podest","holzpodest"}),
	    "Das Podest ist mit einem gruenen Teppich belegt und an den "
	    "Raendern liegen dicke, zusammengerollte Taue.");

  AddDetail(({"schild","holzschild"}),
	    "Auf dem Schild steht eine Art Fahrplan.");

  AddDetail(({"plan","fahrplan"}),
	    "Der steht auf dem Schild.");

  AddDetail(({"rand","podestrand","raender","podestraender"}),
	    "An den Raendern des Podestes liegen einige zusammengerollte "
	    "Taue.");

  AddDetail(({"teppich"}),
	    "Ein gruener Teppich zieht sich vom Podest bis hier herunter "
	    "ans Ende der Treppe. Er soll offensichtlich die harten "
	    "Steinplatten ueberdecken und somit das Aussteigen erleichtern.");

  AddDetail(({"tau","taue"}),
	    "Dicke zusammengerollte Taue liegen auf dem Podest. Wofuer man "
	    "sie wohl braucht?");

  AddReadDetail(({"schild","holzschild","treppenschild","treppenholzschild",
		    "plan","fahrplan"}),
"    _______________________________________________________________________\n"
"  /                                                                      / \\\n"
" |              Wagen Sie eine Fahrt mit dem Heissluftballon!           | O |\n"
" |             -----------------------------------------------          |\\_/\n"
" |                                                                      |\n"
" |    Kommen  Sie und erholen  sie sich bei  einer Reise mit  unserem   |\n"
" |    wunderbaren Heissluftballon. Geniessen Sie die ueberwaeltigende   |\n"
" |    Aussicht und lassen Sie sich den  heissen Wuestenwind durch die   |\n"
" |    Haare wehen...                                                    |\n"
" |                                                                      |\n"
" |    Eine Ueberfahrt kostet nur "+PREIS+" Muenzen.                           |__\n"
" |                                                                      |/ \\\n"
" |                                                  Ihre Reiseleitung   | O |\n"
"  \\                                                                      \\ /\n"
"   `----------------------------------------------------------------------'\n");



  AddSpecialDetail(({"himmel"}), "himmelguggn");
  
  AE("sueden","./ti_pfad13");
  //AE("norden", "./ti_pfad13");
  AE("osten",ZOOHANDLUNG);  
  ASE("norden","nix1");

  AddSound(DEFAULT_SOUND,
	   "Du glaubst Laerm zu hoeren.");
  
  AddSound("laerm",
	   "Das ist eben eine Stadt hier.\n");
  
  AddSmell(DEFAULT_SMELL,
	   "Es riecht hier nach frischer Luft.");
  
  AddSmell("luft",
	   "Frisch und kuehl.");
}

int nix1()  
{
  write(BS("Sorry, da wird noch gebaut!"));
  return 1; 
}

nosave himmelguggn()
{
  if(present("\nballon"))
    return "Der Himmel wird von einem grossen, bunten Heissluftballon verdeckt.\n";
  else
    return "Die Sonne brennt erbarmungslos vom Himmel herunter, und das ist "
      "auch der Grund fuer die Hitze hier.\n";
}

void init()
{
  ::init();
  
  if((TP) && (interactive(TP)))
    call_other(HLB_ARRA, "???");
}
