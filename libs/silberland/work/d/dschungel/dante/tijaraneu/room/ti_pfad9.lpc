/*

   der std_raum fuer den weg in neutijara


*/


#include "/players/dante/myowndefine.h"
inherit "std/room";
#include <properties.h>
#include <language.h>
#include <wizlevels.h>
#include <moving.h>

void create()
{
  ::create();


  SetProp( P_INT_SHORT, "Eine Weg-Pfad Kreuzung in Tijara" );
  SetProp( P_INT_LONG, BS(
        "Du befindest Dich nun auf einem schmalen Pfad in Tijara. Er verbindet "
        "das Wohngebiet mit den neueren Teilen der Stadt. "
        "Vom Himmel brennt die Sonne erbarmungslos herab. "
        "Der Pfad wird hier zu einem recht gut ausgebauten Weg, der aus "
        "ordentlich verlegten weissen Platten aus Stein besteht. "
        "Der Weg fuehrt hier geradeaus nach Norden. "
        "Im Osten endet er an einem grossen Tor. Im Sueden an einer Hausmauer. "
        "Im Nordwesten geht es wieder zurueck in den alten Teil von Tijara."));

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp( P_ENVIRONMENT,([ENV_TEMPERATURE: 29, ENV_TERRAIN: TT_TOWN]) );

  AD("osten",
      "Im Osten wird der Weg durch ein grosses Tor abgeriegelt.");
  AD("tor",
      "Das Tor scheint fest verschlossen zu sein.");
  AD("decke",
      "Nur der Himmel ist hier.");
  AD(({"wand","waende", "stadtmauer"}),
      "Hier kaum zu sehen. Ausser der Stadtmauer und einer Hausmauer.");
  AD("nordwesten",
      "Da geht der Pfad direkt nach Tijara weiter.");
  AddDetail("pfad",
      "Der Pfad fuehrt nach Nordwesten weiter und wird hier zu einem Weg.");
  AddDetail(({"teil","teile", "teilen"}),
      "Im Westen liegt der alte Teil von Tijara.");
  AddDetail(({"kieselstein","kiesel","kieselsteine"}),
      "Die Kieselsteine wurden hier durch Steinplatten ersetzt.");
  AddDetail( ({ "tijara", "stadt" }), 
      "Du befindest Dich mitten in den neueren Teilen von Tijara.") ;
  AddDetail( ({ "sonne", "himmel", "hitze" }), 
      "Die Sonne brennt erbarmungslos vom Himmel herunter, und das ist auch "
      "der Grund fuer die Hitze hier.") ;
  AD("grund",
      "Die Sonne.");
  AddDetail( ({ "weg" }), 
      "Der Weg geht hier nach Norden weiter.");
  AddDetail( ({ "hauptplatz", "platz" }),
      "Der Hauptplatz von Tijara ist im Nordwesten. Er scheint sehr gross zu "
      "sein, aber Du bist noch zu weit weg, um naeheres erkennen zu "
      "koennen.");
  AddDetail( ({ "gardist", "gardisten" }), 
      "Obwohl die Gardisten die Stadt sehr gut bewachen, ist gerade keiner "
      "in der Naehe.");
  AddDetail( ({ "boden", "stein", "steine"}), 
      "Der Boden wird hier durch Steinplatten gebildet.");
  AD("stein",
      "Der Stein war einmal weiss, nun ist er grau.");
  AD(({"platte","platten","steinplatten","steinplatte"}),
      "Die Steinplatten loesen hier die Kieselsteine ab. Sie sind ordentlich verlegt "
      "und fuehren nach Norden weiter.");
  AD("norden",
      "Der Weg fuehrt hier weiter nach Norden.");
  AD(({"sueden","hausmauer","haus", "mauer"}),
      "Im Sueden steht ein Haus und seine Mauer versperrt hier den Weg.");
  AddDetail( ({ "wohngebiet", "wohnung", "wohnungen", "gebiet" }), 
      "Das Wohngebiet liegt etwas weiter im Westen.");


  AddSound( DEFAULT_SOUND,
      "Du glaubst Laerm zu hoeren.");
  AddSound("laerm",
      "Das ist eben eine Stadt hier.\n");

  AddSmell( DEFAULT_SMELL,
      "Es riecht hier nach frischer Luft.");

  AddSmell("luft",
      "Frisch.");

  AddExit( "nordwesten", "./ti_pfad6" );
  AddExit("norden","/d/dschungel/dante/ratmanquest/room/ti_pfad10");

  AIT("/d/dschungel/dante/tijaraneu/npc/zoll", REFRESH_DESTRUCT);

  AIT("/d/dschungel/dante/weg/npc/dratte", REFRESH_DESTRUCT);

}

