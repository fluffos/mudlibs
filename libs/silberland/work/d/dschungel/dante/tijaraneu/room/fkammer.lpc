inherit "std/room";

//folterkammer by dante sl 98
//hehe

#include "/players/dante/myowndefine.h"
#include <properties.h>
#include <language.h>
#include <moving.h>
#include <wizlevels.h>

#include "/sys/mail.h"

string alttitel;
object ob;
object gefangener=0;

clean_up()
{
return 1;
}

reset()
{
  ::reset();
    if(gefangener)
    {
    if( find_player(gefangener) )
    { ob=find_player(gefangener);}
    else
    if( find_netdead(gefangener) )
    { ob=find_netdead(gefangener);}
    if(ob)
    {
    if(ob->QueryProp("P_DANTE_FOLTER") ==0)
    {
    return 1;
    }
    else
    {
    ob->SetProp(P_TITLE,ob->QueryProp("P_DANTE_FOLTER"));
    ob->SetProp("P_DANTE_FOLTER",0);
    gefangener=0;
    tell_object(ob,
    "Dante kommt rein und befreit Dich!\n");
    this_object()->setuid();seteuid("dante");
    write_file("/d/dschungel/dante/weg/log/folter",(ctime()+": "+
    "Dante befreite "+ capitalize(ob->query_real_name())+" von den Ketten.\n"));
    return 1;    
          }
        } 
      }
    }

create()
{

  ::create();
  SetProp( P_LIGHT, 1 );
  SetProp( P_INT_SHORT, "Eine Folterkammer" );
  SetProp( P_INT_LONG,BS(
  "Du stehst mitten in einer Folterkammer, die boese Magier vor langer "
  "Zeit eingerichtet haben, um Spieler zu foltern. "
  "Hier foltert der gnadenlose Folterknecht Fingernagelreisser freche "
  "Spieler! "
  "An der Wand siehst "
  "Du eine Vorrichtung, an die Du Deine Opfer fesseln kannst. Zahlreiche "
  "Geraete liegen am Boden herum, alle geeignet Schmerzen zubereiten. "
  "Im Sueden geht es wieder hinauf, solange Du nicht gerade gefesselt bist "
  "und gefoltert wirst! In einer Ecke steht eine eiserne Jungfrau. "
  "                                                          Eine Tafel."));
  
  
  AD(({"ecke","jungfrau"}),
  "Die eiserne Jungfrau dient zum foltern. Ein wirklich abscheuliches "
  "Geraet. Man kann sie oeffnen.");
  
  AD("sueden",
  "Hau ab, solange Du kannst! <suedoben>");
  
  AD(({"schmerz","schmerzen"}),
  "Hier wirst Du sie kennenlernen!");
  AD(({"fingernagel","ausreisser","fingernagelreisser"}),
  "Er herrscht hier!");
  
  
  AddDetail(({"kammer", "folterkammer"}),
  "Du stehst mitten drinnen.");
  AddDetail("magier",
  "Na, rat mal wer das wohl war...");
  AddDetail("zeit",
  "Sehr lange her...");
  AddDetail(({"wand","waende"}),
  "Die Waende sind aus Stein und sehr dick. Niemand wird Dein Opfer "
  "schreien hoeren.");
  AddDetail("stein",
  "Grau, schwer, hart.");
  AddDetail("spieler",
  "Naja, die Spieler gehoeren gequaelt!");
  AddDetail("opfer",
  "Bald wirst Du auch eines sein.");
  AddDetail("decke",
  "Die Decke ist niedrig und auch aus Stein.");
  AddDetail("boden",
  "Der Boden ist blutverschmiert. Einige Geraete liegen herum. "
  "Daneben liegt eine Tafel. Im Boden erkennst Du ein stinkendes grosses Loch!");
  
  AD("loch",
  "Das Loch fuehrt nach unten in das Buero der Dschungelmagier.");
  AD(({"buero","magier","dschungelmagier"}),
  "Du solltest besser nicht dorhin gehen. Dort ist es nur unordentlich und langweilig.");
  
  
  AddDetail("tafel",
  "Lies sie!");
  AddReadDetail("tafel",
  "+---------------------------+\n"
  "|         Achtung!          |\n"
  "|   Dein Opfer kann hier    |\n"
  "|        sterben!!!         |\n"
  "| Mir, Dante, ist das egal, |\n"
  "|  doch fuer die Reaktion   |\n"
  "|  des Sheriffs garantiere  |\n"
  "|       ich nicht!!!        |\n"
  "|                           |\n"
  "|      folter <name>        |\n"
  "|      fessel <name>        |\n"
  "|      befreie <name>       |\n"
  "|                           |\n"
  "| Viel Spass beim Foltern!  |\n"
  "+---------------------------+\n");

AddItem("d/dschungel/dante/tijaraneu/npc/folterk", REFRESH_DESTRUCT);
    
  AddDetail("blut",
  "Eklig, rot...");
  AddDetail(({"vorrichtung"}),
  "Eine einfache Vorrichtung um jemanden zu fesseln.");
  AddDetail(({"geraet","geraete"}),
  "Sie sehen alle recht gefaehrlich aus. Zangen, Spiesse, Hammer...");
  AddDetail(({"zangen", "zange"}),
  "Zum kneifen der Opfer."); 
  AddDetail("hammer",
  "Zum bearbeiten der Opfer.");
  AddDetail(({"spiess", "spiesse"}),
  "Zum stechen der Opfer.");
  
  SetProp(P_INDOORS,1);
  SetProp(P_NO_TPORT,NO_TPORT_OUT);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20,ENV_TERRAIN:TT_CAVE]) );    
AddSound( DEFAULT_SOUND,                                                      
    "Hier ist es voellig still.");   
 AddSmell( DEFAULT_SMELL,                                                      
     "Eigentlich riecht es hier nach nichts.");  

SP(P_KILL_NAME, "Brutalste Folter und unendliche Qualen");

AddCmd( ({ "fessle", "fessel" }), "fessle_spieler" );
AddCmd( ({ "befrei", "befreie", "entfessel", "entfessle" }), "free_spieler" ); 
AddCmd( ({ "folter", "foltere" }), "folter_spieler" );
AddCmd( ({ "ende", "quit" }), "en_de" );
AddCmd( ({ "schlaf", "schlafe" }), "schlafe_ein" );
AddSpecialExit("suedoben", "go_south");



ASE("unten", "check");
ACD(({"oeffne","oeffnen"}), "weg");
}

int weg(string str)  {
	if(str=="jungfrau")  {
	write(BS(
	"Du oeffnest die eiserne Jungfrau und kletterst hinein."));	
		TPM("/d/dschungel/dante/tijaraneu/room/fkammer2", M_GO,
		"in die eiserne Jungfrau", "oeffnet die eiserne Jungfrau und klettert",
		"kommt von drausen herein");
	return 1; }
	}	

int check()  {
	if(!interactive(TP)) return 1;


if(!IS_WIZARD(TP))  {
	write(BS(
"Nein! Du willst dort gar nicht hin!")); return 1;  }		


if(IS_WIZARD(TP))  {
	TPM("d/dschungel/dante/dschungelbuero", M_GO,
"von oben herab herein", "kommt", "geht nach unten in das Buero");
return 1; }


}	


en_de()
{
if( this_player()->QueryProp("P_DANTE_FOLTER") ==0)
  {
  return 0;
  }
  else
  {
  write( "Solange Du gefesselt bist, kannst Du Dich nicht ausloggen!\n" );
  return 1;
  }
}
schlafe_ein()
{
if( this_player()->QueryProp("P_DANTE_FOLTER") ==0)
  {
  return 0;
  }
  else
  {
  write( "Es gelingt Dir nicht, einzuschlafen, die Ketten sind zu unbequem!\n");
  return 1;
  }
}



go_south()
{
  if( this_player()->QueryProp("P_DANTE_FOLTER") == 0)
  {
  write( "Du bist wirklich froh, dass Du nicht gefesselt bist, und die Kammer\n"
  +"ohne Schwierigkeiten verlassen kannst.\n"
  +"\n" );
  say( this_player()->name(WER,2)+" verlaesst die Kammer.\n" );
  this_player()->move("/d/dschungel/dante/tijaraneu/room/ti_pfad5", M_GO|M_SILENT);
  tell_room(environment(this_player()), this_player()->name(WER,2)+
  " kommt aus der Folterkammer herein.\n", ({this_player()}));
  return 1;
  }
  else
  {
  write( "Du windest Dich in Deinen Fesseln, kannst Dich aber nicht befreien.\n"
  +"Es ist Dir nicht moeglich, die Kammer zu verlassen.\n" );
  say( this_player()->name(WER,2)+
       " windet sich in den Fesseln, kann sich aber nicht befreien.\n" );
  return 1;
  }

}



//fuer call_other aus knecht

bondage(enemy)
   {
   if(present("folterknecht", TO))
      {
     
          
      alttitel = enemy->QueryProp(P_TITLE);
      enemy->SetProp("P_DANTE_FOLTER",alttitel);
      enemy->SetProp(P_TITLE,alttitel+" (gefesselt)");
      gefangener=enemy->query_real_name();
      tell_room("d/dschungel/dante/tijaraneu/room/fkammer",
      "Der Folterknecht fesselt "+enemy->name()+"!\n");
      tell_object(enemy,
      "Der Folterknecht kettet Dich an!\n");  

         }
        
   else
     {
     write("BUG!\n");
     //kann eh net vorkommen:)
     }   
  }    
      


     BecomesNetDead(object spieler)  {
  
  if( spieler->QueryProp("P_DANTE_FOLTER") != 0)  {
   
  spieler->SetProp(P_TITLE,spieler->QueryProp("P_DANTE_FOLTER"));
 spieler->SetProp("P_DANTE_FOLTER",0);
 gefangener=0;
 write(BS(
 "Du entkommst aus der Folter!"));
     return 1;
       }
   return 1;
    }
       



fessle_spieler( str )
{
  if(!gefangener)
  {
    ob=find_player(str);
    if(ob)
    {
    if( !present(str,this_object()) )
    {
    write( "Du kannst nur Spieler fesseln, die hier im Raum sind!\n" );
    return 1;
    }
    
    else
    
  { 
      if( this_player()->query_real_name() == str )
      {
      write( "Du kannst Dich doch nicht selbst fesseln!\n" );
      return 1;
      }      
      else
 //   Das hier ist absichtlich draussen weil sont der folterknecht net fesslen kann
 //   und anders zu proggen waer sehr umstanedlich
      
      
      {
      
      
     if(ob->QP(P_GHOST))  {
     write(BS(
     "Geister kann man nicht fesseln!"));
     return 1; }
      
      
      
 if( ob->QueryProp("P_DANTE_FOLTER") != 0)
     {
     write( "Dieser Spieler ist doch schon gefesselt!\n" );
   return 1;
   }
   else
   {
     if( this_player()->QueryProp("P_DANTE_FOLTER") != 0)
     {
     write( "Du kannst niemanden fesseln, wenn Du selbst gefesselt bist!\n" );
     return 1;
     }
     else
     {
     
      alttitel = ob->QueryProp(P_TITLE);
      ob->SetProp("P_DANTE_FOLTER",alttitel);
      ob->SetProp(P_TITLE,alttitel+" (gefesselt)");
      gefangener=ob->query_real_name();
      write( "Du fesselst "+capitalize(ob->query_real_name())
      +" mit Ketten an die Wand.\n" );
      say( this_player()->name(WER,2)+" fesselt "+capitalize(ob->query_real_name())
    +" mit Ketten an die Wand.\n", ({ob, this_player()}));
      tell_object(ob, this_player()->name(WER,2)
    +" fesselt Dich mit Ketten an die Wand. Willst Du Dir das\n"
    +"gefallen lassen?\n");
      if( find_player("dante") && interactive(find_player("dante")) ==1)
      {
      tell_object(find_player("dante"), this_player()->name(WER,2)
    +" fesselt gerade "+capitalize(ob->query_real_name())
    +".\n" );
      }
      
      this_object()->setuid();seteuid("dante");
      
      
      
      
      write_file("/d/dschungel/dante/weg/log/folter",(ctime()+": "+
      capitalize(this_player()->query_real_name())+" fesselte "+
      capitalize(str)+".\n"));
      return 1;
      }
 }
     }
    }
  }
  else
  {
  write("Das geht nicht!\n" );
  return 1;
  }
  }
  else
  {
  write("Es ist keine Kette mehr frei.\n");
  return 1;
  }
}

free_spieler( str )
{
ob=find_player(str);
    if(ob)
    {
    if( !present(str,this_object()) )
    {
    write( "Du kannst nur Spieler befreien, die hier im Raum sind!\n" );
    return 1;
    }
    else
    {
      if( this_player()->query_real_name() == str )
      {
      write( "Es gelingt Dir nicht, Dich selbst zu befreien!\n" );
      return 1;
      }      
      else
      {
 if( this_player()->QueryProp("P_DANTE_FOLTER") != 0)
 {
 write( "Du kannst niemanden befreien, wenn Du selbst gefesselt bist!\n" );
 return 1;
 }
 else
 {
 if( ob->QueryProp("P_DANTE_FOLTER") != 0)
 {
 ob->SetProp(P_TITLE,ob->QueryProp("P_DANTE_FOLTER"));
 ob->SetProp("P_DANTE_FOLTER",0);
 gefangener=0;
 write( "Du befreist "+capitalize(ob->query_real_name())
        +" von den schweren Ketten.\n" );
 say( this_player()->name(WER,2)+" befreit "+capitalize(ob->query_real_name())
      +" von den schweren Ketten.\n", ({ob, this_player()}));
 tell_object(ob, this_player()->name(WER,2)
      +" befreit Dich von den schweren Ketten. Du solltest Dich jetzt\n"
      +"vielleicht bedanken.\n");
 if( find_player("dante") && interactive(find_player("dante")) ==1)
 {
 tell_object(find_player("dante"), this_player()->name(WER,2)
      +" befreite gerade "+capitalize(ob->query_real_name())
      +".\n" );
 }
 this_object()->setuid();seteuid("dante");
 write_file("/d/dschungel/dante/weg/log/folter",(ctime()+": "+
 capitalize(this_player()->query_real_name())+" befreite "+
 capitalize(str)+" von den Ketten.\n"));
 return 1;    
 }
 else
 {
 write( "Dieser Spieler ist doch gar nicht gefesselt!\n" );
 return 1;
 }
      }
     } 
    }
  }
  else
  {
  write("Das geht nicht!\n" );
  return 1;
  }
}



folter_spieler( str )
{
int schaden;
ob = find_player(str);
  if(ob)
  {
  if( !present(str,this_object()) )
  {
  write( "Du kannst nur Spieler foltern, die hier im Raum sind!\n" );
  return 1;
  }
  else
  {
    if( this_player()->query_real_name() == str )
    {
    write( "Das ist doch sicher nicht Dein Ernst!\n" );
    return 1;
    }
    else
    {
      if( ob->QueryProp("P_DANTE_FOLTER") == 0)
      {
      write( "Du kannst nur Spieler foltern, die gefesselt sind!\n" );
      return 1;
      }
      else
      { 
 if( this_player()->QueryProp("P_DANTE_FOLTER") !=0)
 {
 write( "Du bist doch gefesselt!\n" );
 return 1;
 }
 else
 {
 write( "Du folterst "+capitalize(ob->query_real_name())+""
        " mit Zangen, Spiessen und einem Hammer!\n"
        ""+capitalize(ob->query_real_name())+" bruellt laut auf und "
        "windet sich unter starken Schmerzen!\n"
        "Dir macht das grossen Spass!\n");

  say( this_player()->name(WER,2)+" foltert "+capitalize(ob->query_real_name())+""
       " mit Spiessen, Zangen und ein paar "
       "anderen Instrumenten, die in der Kammer herumliegen.\n", ({ob, this_player()}));
 tell_object(ob, this_player()->name(WER,2)
      +" foltert Dich auf gemeinste Weise mit Zangen,\n"
      +"Spiessen und verschiedenen anderen Instrumenten. Du fuehlst,\n"
      +"wie Deine Kraefte allmaehlich schwinden.\n" );
 if( find_player("dante") && interactive(find_player("dante")) ==1)
 {
 tell_object(find_player("dante"), this_player()->name(WER,2)
      +" foltert gerade "+capitalize(ob->query_real_name())
      +".\n" );
 }
 
 
 schaden=this_player()->QueryAttribute("str");
 ob->do_damage(schaden, this_player());
 if( ob->QueryProp(P_GHOST)==1)
 {
 ob->SetProp(P_TITLE,ob->QueryProp("P_DANTE_FOLTER"));
 ob->SetProp("P_DANTE_FOLTER",0);
 gefangener=0;
 
  write_file("/d/dschungel/dante/weg/log/folter",(ctime()+": "+
 capitalize(this_player()->query_real_name())+" folterte "+
 capitalize(str)+" bis zum TOD!!!!\n"));
 call_out("mail", 0);
 
 }
 this_object()->setuid();seteuid("dante");
 write_file("/d/dschungel/dante/weg/log/folter",(ctime()+": "+
 capitalize(this_player()->query_real_name())+" folterte "+
 capitalize(str)+" (HP danach: "+ob->QueryProp(P_HP)+").\n"));
 return 1;
 }
      }
    }
  }
  }
  else
  {
  write("Das geht nicht!\n" );
  return 1;
  }
}

mail()  {

   mixed* mail;
   string text;

   text =
   "FOLTERTOD! "+getuid(TP)+" hat gerade "+ob->getuid(ob)+"\n"
   "umgebracht! LOG: /d/dschungel/dante/weg/log/folter !!!\n";
   


   mail = allocate(9);
   mail[MSG_FROM] = "folterkammer";
   mail[MSG_SENDER] = "lars";
   mail[MSG_RECIPIENT] = "dante";
   mail[MSG_CC]=0;
   mail[MSG_BCC]=0;
   mail[MSG_SUBJECT]="FOLTERTOD!!!:";
   mail[MSG_DATE]=dtime(time());
   mail[MSG_ID]=MUDNAME+":"+time();
   mail[MSG_BODY]=text;

   return "/secure/mailer"->DeliverMail(mail,1);
}

 
