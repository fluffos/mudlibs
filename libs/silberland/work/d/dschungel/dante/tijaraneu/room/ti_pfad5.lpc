/*
pfad von alttijara nach neuneutijara 
dante 99.08.29

*/


#include "/players/dante/myowndefine.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <wizlevels.h>
#include <moving.h>


create()
{
  ::create();

  SetProp( P_INT_SHORT, "Ein kleiner Pfad in Tijara" );
  SetProp( P_INT_LONG, BS(
  "Du befindest Dich nun auf einem schmalen Pfad in Tijara. Er verbindet "
  "das Wohngebiet mit den neueren Teilen der Stadt. "
  "Am Boden liegen helle Kieselsteine und Dir faellt sofort "
  "ein sehr niedriges, schaurig aussehendes Gebaeude auf. "
  "Vom Himmel brennt die Sonne erbarmungslos herab. "
  "Hier gabelt sich der Pfad auf. Du kannst nach Suedosten und Sueden weitergehen."
  " Im Nordwesten kommt man in den alten Teil von Tijara zurueck. Du siehst "
  "ausserdem noch ein seltsames sehr dickes Rohr, das direkt aus dem Boden "
  "herauskommt."));
  
  
  
  AD("rohr",
  "Das Rohr ist sehr gross und Du verstehst nicht was es hier soll. "
  "Eine kleine Inschrift wurde angebracht.");
  
  
  AD("inschrift",
  "Lies sie!");
  ARD("inschrift",
  "ACHTUNG! Zolome!!! Dieses Rohr wurde von dieser Seite aus magisch versiegelt!\n"
  "Man kann von hier aus nicht zu den Zolomen gelangen!\n"
  "Der Gouverneur!\n\n"
  "Hmm, was ist ein Zolom?!\n");
  
  AD("seite",
  "Hmm, es gibt sicher einen Weg zu den Zolomen! Aber wo?!");
  
  AD(({"zolome","zolom"}),
  "Ein Zolom ist ein riesiger Wurm. Angeblich leben unter Tijara sehr viele davon.");
  AD(({"wurm","meter"}),
  "Sie werden angeblich bis zu 30 Meter lang!!!");
  
  
AD("gebaeude",
"Das Gebaeude ist halb im Boden versenkt. Es ist die Folterkammer von "
"Dante. Du solltest sie unbedingt besuchen!!!");
  
  AD("dante",
  "Er hat sie erschaffen.");
  AD(({"kammer","folterkammer"}),
  "Dort kann man foltern oder gefoltert werden! Du kannst sie mit <nordunten>"
  " betreten!");
  
AD("suedosten",
"Geh weiter.");
AD("sueden",
"Dahin kannst Du auch gehen.");  
 
 
  
  SetProp( P_LIGHT, 2 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 29, ENV_TERRAIN: TT_TOWN]) );
//alles exakt wie bei fey


AD("decke",
"Nur der Himmel ist hier.");
AD(({"wand","waende"}),
"Hier kaum zu sehen.");

AD("nordwwesten",
"Da geht der Pfad direkt nach Tijara weiter.");
AddDetail("pfad",
"Der Pfad fuehrt nach Suedosten und Sueden in die neueren Teile von Tijara.");
AddDetail(({"teil","teile"}),
"Sie wurden erst nachtraeglich angebaut, denn Tijara waechst und waechst.");
AddDetail(({"kieselstein","kiesel","kieselsteine"}),
"Die Kieselsteine sind natuerlich viel kleiner als die anderen Steine. Sie "
"sind hell und sauber.");



  
  AddDetail( ({ "tijara", "stadt" }), BS(
    "Du befindest Dich mitten in den neueren Teilen von Tijara.") );
  AddDetail( ({ "sonne", "himmel", "hitze" }), BS(
    "Die Sonne brennt erbarmungslos vom Himmel herunter, und das ist auch "
    "der Grund fuer die Hitze hier.") );
 AD("grund",
 "Die Sonne.");
 
  AddDetail( ({ "strasse", "weg", "knick" }), 
 "Die Strasse liegt im Nordwesten.");
 
  AddDetail( ({ "hauptplatz", "platz" }), BS(
    "Der Hauptplatz von Tijara ist im Nordwesten. Er scheint sehr gross zu "
    "sein, aber Du bist noch zu weit weg, um naeheres erkennen zu "
    "koennen.") );
  AddDetail( ({ "gardist", "gardisten" }), BS(
    "Obwohl die Gardisten die Stadt sehr gut bewachen, ist gerade keiner "
    "in der Naehe.") );
  AddDetail( ({ "boden", "stein", "steine"}), BS(
  "Der Boden ist uebersaeht mit Kieselsteinen, die wohl den Pfad bilden."));
  
  
  AddDetail( ({ "wohngebiet", "wohnung", "wohnungen", "gebiet" }), BS(
   "Das Wohngebiet liegt etwas weiter im Nordwesten."));
   

AD("nordwesten",
"Dort liegt die Strasse, das Wohngebiet und noch weiter nordwestlich "
"dann der Hauptplatz.");


  AddExit( "nordwesten", "./ti_pfad4" );

  AE( "suedosten", "./ti_pfad6" );
  AE("sueden", "./ti_pfad7");
  
  AE("nordunten", "./fkammer");



AIT("/d/dschungel/dante/tijaraneu/npc/grose", REFRESH_DESTRUCT);
//AIT("/d/dschungel/dante/tijaraneu/npc/clilie", REFRESH_DESTRUCT);



 AddSound( DEFAULT_SOUND,
     "Du glaubst Schreie zu hoeren.");
     AddSound("schreie",
     "HHHHILLLLLLLLFFFFFE!!!!!\n");
     
 AddSmell( DEFAULT_SMELL,
  "Es riecht hier nach Tod.");

AddSmell("tod",
"Nordunten!");

}
/*
int nix1()  {
  write(BS(
  "Sorry, momentan noch nicht vollendet!"));
  return 1; }
  
 */ 