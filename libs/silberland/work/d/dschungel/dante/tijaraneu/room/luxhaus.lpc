/*
haus von lux der lichtfee
dante sl 2000

angepasst an Private Obj PROtheG 29-12-2000
*/

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <wizlevels.h>
#include "/players/dante/myowndefine.h"

#define LUX "/d/dschungel/dante/tijaraneu/npc/lux"
#define LFIRE "/d/dschungel/dante/tijaraneu/npc/lfire"

nosave int zerstoert=0;
nosave string wer="";

do_lfire()
{
  if(present("l_fire", ME)) return;
  clone_object(LFIRE)->move(ME,M_NOCHECK);
  
  if(!random(3))
    clone_object(LFIRE)->move(ME,M_NOCHECK);
  
  if(!random(5))
    clone_object(LFIRE)->move(ME,M_NOCHECK);
}


reset()
{
  object ob;
     
  ::reset();
  
  ob=find_living("lux");
  
  if( (ob) && ob->id("zerstoert"))
    ob->RemoveId("zerstoert");
  
  wer=="";
  zerstoert=0;
  
  do_lfire();
}

create()
{
  ::create();
  
  SetProp( P_INT_SHORT, "Im Haus von Lux der Lichtfee" );
  SetProp( P_INT_LONG, BS(
    "Du bist nun im Haus der Lichtfee Lux. Ueberall stehen hell brennende "
    "Kerzen und strahlende Lampen umher. Mitten im Raum befindet sich ein "
    "seltsames, gleissendes Objekt, von dem eine angenehme Waerme und ein "
    "gelbliches Licht ausgeht. Sonst ist hier eigentlich nichts Interessantes "
    "zu sehen, oder denkst Du etwa, dass eine Fee ein Bett oder einen Stuhl "
    "braucht?! Mit der Leiter geht es wieder raus auf die Strassen von Tijara."));
  

  AD("objekt",
     "Das Objekt scheint ueber dem Boden zu schweben und mit dem fast unsichtbaren Dampf, "
     "der vom Wachs ausgeht, betrieben zu werden! Eine helle Lichtkugel scheint direkt "
     "im Objekt zu schweben.");
  AD("dampf", 
     "Man sieht ihn kaum.");
  AD(({"interessantes"}), 
     "Oder vielleicht doch...");
  AD(({"strasse","strassen"}), 
     "Die Strassen von Tijara sind sehr lebendig.");
  AD("waerme",
     "Du fuehlst Dich hier sehr geborgen.");
  AD("tijara",
     "Das wartet ausserhalb auf Dich.");
  AD("leiter",
     "Die Leiter fuehrt nach draussen.");
  AD("bett",
     "Braucht sie nicht.");
  AD("stuhl",
     "Wozu!");
  AD(({"kerzen","kerze"}),
     "Die Kerzen spenden ein helles, freundliches Licht.");
  AD(({"lampe","lampen"}),
     "Die Lampen strahlen ein gelbiches Licht aus, so dass der ganze Raum sehr, sehr "
     "hell ist.");
  AD("raum",
     ""+QP(P_INT_LONG)+"");
  AD("licht",
     "Das Licht, das die Lampen und Kerzen, aber vor allem das merkwuerdige Objekt, "
     "hier verbreiten wirkt sehr angenehm und warm.");
  AD(({"wand","waende"}),
     "Die Waende sind voll von Kerzen und Lampen.");
  AD("decke",
     "Auch von der Decke haengen Lampen herab.");
  AD("boden",
     "Der Boden ist voller heller Kerzen. Wachs ueberzieht ihn teilweise.");
  AD(({"wachs", "kerzenwachs"}),
     "Das Kerzenwachs sieht merkwuerdig aus.");
  AD("haus",
     "Es ist ein seltsames Haus, das auf Pfaehlen steht.");
  AD(("pfahl","pfaehle"),
     "Die Pfaehle sind von hier nicht zu sehen. Doch da faellt Dir an der Wand eine "
     "kleine Inschrift auf!");
  AD("inschrift",
     "Lies sie!");
  AD(({"lux","lichtfee","fee"}),
     "Lux, die Lichtfee wohnt hier.");

  ARD("inschrift",
      "Zerstoere es! Zerstoere es!\n"
      "Gut, aber was zerstoeren! Muss doch mit der Fee etwas zu tun haben! Da bist Du "
      "Dir ganz sicher! Etwa das Objekt oder die Lichtkugel oder...");

  ASD(({"lichtkugel","kugel"}), "check");

  AddSound(DEFAULT_SOUND,
	   "Hier ist es sehr leise.");
  AddSmell(DEFAULT_SMELL,
	   "Hmm, es riecht nach Kerzen!");
  AddSmell(({"kerzen","kerze"}),
	   "Hmm, irgendwie suess.");
  
  SetProp(P_LIGHT, 3);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_HOUSE]));

  AIT(LUX, REFRESH_DESTRUCT);
  
  do_lfire();
 
  AE("unten", "./ti_pfad4");
  ACD(({"zerstoere","zerstoer"}), "weg");
}


int weg(string str)
{
  object ob;
  
  NF("Was willst Du zerstoeren?!\n");
  
  if(str=="kugel"||str=="lichtkugel")
    {
      if(zerstoert==0)
	{
	  write(BS("Du holst weit aus und zertruemmerst die Lichtkugel!!!"));
	  
	  say(BS(CAP_TPN+" zerstoert irgendetwas im hellen Objekt!"));
	  
	  zerstoert=1;

	  wer=CAP(getuid(TP));
	  
	  if(ob=present("lux", environment(TP)))
	    {
	      ob->AddId("zerstoert");
	      say(BSA("HE! Was soll das!!! Bist Du wahnsinnig, "+TPN+"!",
		      "Die Lichtfee bruellt: "));
	    }
	  return 1;
	}
      else
	return write(BS("Die Lichtkugel wurde bereits von "+wer+" zerstoert!")),1;
      return 0;
    }
  return 0; 
}

string check()
{
  if(zerstoert==0)
    return BS("Die Lichtkugel strahlt besonders hell!!!");
  else
    return BS("Die Lichtkugel gibt kein Licht mehr von sich. Sie wurde von "+
	      wer+" zerstoert!");
}

