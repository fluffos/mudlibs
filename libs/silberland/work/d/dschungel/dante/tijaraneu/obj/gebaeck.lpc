//essen fuer den baecker dante sl 2000

#include "/players/dante/myowndefine.h"

inherit "std/food";
#include <properties.h>
#include <language.h>
#include <food.h>

create()
{
if (!is_clone(TO) )  return;

::create();

AddId( ({"gebaeck"}) );

SetProp(P_MATERIAL, MAT_MISC_FOOD );
SetProp(P_WEIGHT, 1);
SetProp(P_VALUE, 50);
SetProp(P_FOOD_INFO, ([F_HEAL: 7, F_SOAK: 3, F_ALCOHOL: 0,F_POISON: 0]));

}

BeimEssen()
{
write(BS(
"Das Gebaeck schmeckt Dir sehr gut!"));
say(BS(
CAP_TPN+" isst ein gutes Gebaeck von Konditorox."));
return::BeimEssen();
}