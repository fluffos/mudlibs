/* 
das obj fuer den zolom event
zaehlt mit: anzahl der zolome
            laenge aller zolome zusammengereiht :-)
           
*/



inherit "std/thing"; 
#include <language.h>
#include <properties.h>
#include <combat.h>
#include <defines.h>
#include "/sys/mail.h"
#include <moving.h>
#include "/players/dante/myowndefine.h"
#define LOG "/d/dschungel/dante/tijaraneu/log/"
#define STATMASTER "/d/dschungel/dante/tijaraneu/obj/statmaster"

send_mail();

int counter=1;//muss so sein! lassen! 
int kopfgeld=100;
int maxanzahl=200;
int praemie;
int sonderpraemie=0;
int wegdamit=0;
int totalpraemie;
object money;


reset()  {
	::reset();

if(!is_clone(TO))  { return;  }

if(!environment(TO))  { remove(); return;  }

if(!interactive(environment(TO)))  { remove(); return;  }

if(interactive(environment(TO)))  {
	wegdamit++;
 }

if(wegdamit>=2)  {
	remove(); return;   }

}	



 
create()
{
  if(!is_clone(this_object())) return;

  ::create();

  seteuid( getuid(this_object()));  
  SetProp(P_SHORT, 0);
  SetProp(P_LONG, 0);

  SetProp(P_VALUE,0);
  SetProp(P_WEIGHT,0);
  SetProp(P_GENDER, MALE);
  SetProp(P_NAME,0);
  
  AddId(({"zolom_event_counter", "ZEC"}));
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);

ACD(({"kopfgeld"}), "get_belohnung");

ACD("test123", "get_info");

}

get_info()  {
   write("counter: "+counter+"\n");
   return 1;  }
   


int get_belohnung()  {

    if(file_name(environment(TP))!=("/d/dschungel/dante/tijaraneu/room/galerie") )
    
                  {

     write(BSA(	
    "Aber Du bist doch gar nicht in meiner Umgebung! Komm zu mir!",
    "Cosinus teilt Dir mit: "));
     return 1;  
                             }



    else        {




   if(!present("cosinus", environment(TP)))   {
    
    "/d/dschungel/dante/tijaraneu/room/galerie"->new_cosinus();
    
          }




    	
    write(BSA(
    "Gut "+TPN+"! Dann sehen wir mal wieviele Zolome Du getoetet hast und "
    "wie hoch das Kopfgeld dafuer dann auch dafuer ist!",
    "Cosinus sagt: "));
    
    if(counter<=0)  {
    	
        write(BSA(
        "He, Du hast ja noch kein einziges Zolom umgebracht! Was soll den das! "
        "Los! Bring die kleinen Wuermer endlich um! Du bekommst natuerlich nichts dafuer!",
        "Cosinus sagt: "));
        	return 1;       
        	              }
    
    	
if(counter>0 && counter <= maxanzahl)    {


praemie=counter*kopfgeld;
sonderpraemie=counter*counter;

     write(BSA(
     "Gut "+TPN+"! Die Anzahl der von Dir getoeteten Zolome ist: "+counter+"! ",
     "Cosinus sagt: "));

//TP->AddMoney(praemie);
money=clone_object("obj/money");
money->SetProp(P_AMOUNT, praemie);
money->move(environment(TP), M_NOCHECK);


 switch(counter)  {
   case 1..15:
   write(BSA(
   "Dieses Ergebnis ist uebrigens erbaermlichst!"
   " Du bekommst eine Praemie von "+praemie+" Muenzen!",
   "Cosinus sagt: "));
   break;
   
   case 16..35:
   write(BSA(
   "Dieses Ergebnis ist uebrigens sehr schlecht!"
     " Du bekommst eine Praemie von "+praemie+" Muenzen!",
   "Cosinus sagt: "));
   break;
   
    case 36..55:
   write(BSA(
   "Dieses Ergebnis ist uebrigens schlecht!"
     " Du bekommst eine Praemie von "+praemie+" Muenzen!",
   "Cosinus sagt: "));
   break;

  case 56..70:
   write(BSA(
   "Dieses Ergebnis ist uebrigens fast mittelmaessig!"
     " Du bekommst eine Praemie von "+praemie+" Muenzen!"
     "Weiters eine Sonderpraemie von "+sonderpraemie+" Muenzen!",
   "Cosinus sagt: "));
   break;

 case 71..100:
   write(BSA(
   "Dieses Ergebnis ist uebrigens mittelmaessig!"
    " Du bekommst eine Praemie von "+praemie+" Muenzen!"
     "Weiters eine Sonderpraemie von "+sonderpraemie+" Muenzen!",
   "Cosinus sagt: "));
   break;
   
    case 101..125:
   write(BSA(
   "Dieses Ergebnis ist uebrigens fast gut!"
    " Du bekommst eine Praemie von "+praemie+" Muenzen!"
     "Weiters eine Sonderpraemie von "+sonderpraemie+" Muenzen!",
   "Cosinus sagt: "));
   break;

 case 126..150:
   write(BSA(
   "Dieses Ergebnis ist uebrigens gut!"
    " Du bekommst eine Praemie von "+praemie+" Muenzen!"
     "Weiters eine Sonderpraemie von "+sonderpraemie+" Muenzen!",
   "Cosinus sagt: "));
   break;


 case 151..170:
   write(BSA(
   "Dieses Ergebniss ist uebrigens beinahe sehr gut! "
    " Du bekommst eine Praemie von "+praemie+" Muenzen!"
     "Weiters eine Sonderpraemie von "+sonderpraemie+" Muenzen!",
   "Cosinus sagt: "));
   break;
   


 case 171..180:
   write(BSA(
   "Dieses Ergebniss ist uebrigens sehr gut! "
 " Du bekommst eine Praemie von "+praemie+" Muenzen!"
     "Weiters eine Sonderpraemie von "+sonderpraemie+" Muenzen!",
   "Cosinus sagt: "));
   break;


 case 181..190:
   write(BSA(
   "Dieses Ergebniss ist uebrigens beinahe exzellent! "
 " Du bekommst eine Praemie von "+praemie+" Muenzen!"
     "Weiters eine Sonderpraemie von "+sonderpraemie+" Muenzen!",
   "Cosinus sagt: "));
   break;


 case 191..199:
   write(BSA(
   "Dieses Ergebniss ist uebrigens exzellent! "
 " Du bekommst eine Praemie von "+praemie+" Muenzen!"
     "Weiters eine Sonderpraemie von "+sonderpraemie+" Muenzen!",
   "Cosinus sagt: "));
   break;


 case 200:
   write(BSA(
   "Dieses Ergebniss ist uebrigens PERFEKT!!! "
 " Du bekommst eine Praemie von "+praemie+" Muenzen!"
     "Weiters eine Sonderpraemie von "+sonderpraemie+" Muenzen!",
   "Cosinus sagt: "));

   shout(BSA(
   CAP(getuid(TP))+" hat alle jungen Zolome im Alleingang vernichtet!!! "
   "Ein dreifaches Dschungelhurra fuer "+CAP(getuid(TP))+"!!! "
   "HURRA! HURRA! HURRA! Was fuer ein Held!",
   "Cosinus bruellt: "));
   
   

   break;
   
   default: write(BS("BUG!!!"));
        
     
  write_file(LOG"anzahl_zolome",
     ctime()+": "+CAP(getuid(PL))+":BUG_1 zahl: "+counter+" praemie: "+praemie+" sp: "+sonderpraemie+"\n");
   
          }
     
     if(counter>=56)  {
     
     //TP->AddMoney(sonderpraemie);  
     money->SetProp(P_AMOUNT, sonderpraemie);
     money->move(environment(TP), M_NOCHECK);
     
     
     totalpraemie=praemie+sonderpraemie;

  STATMASTER->addiere_zu_persoenlicher_liste(
  CAP(getuid(TP)), counter, totalpraemie, counter);         

         write_file(LOG"anzahl_zolome",
         ctime()+": "+CAP(getuid(PL))+": zahl: "+counter+" praemie: "+praemie+" sp: "+sonderpraemie+"\n");
       
       send_mail();
       
       call_out("remove", 1);
       
        return 1;
        
        }
    
  STATMASTER->addiere_zu_persoenlicher_liste(
  CAP(getuid(TP)), counter, praemie, counter);  
    
     
     
  write_file(LOG"anzahl_zolome",
     ctime()+": "+CAP(getuid(PL))+": zahl: "+counter+" praemie: "+praemie+" sp: "+sonderpraemie+"\n");

send_mail();
   
   call_out("remove", 1);
     return 1;  }

          }



write_file(LOG"anzahl_zolome",
     ctime()+": "+CAP(getuid(PL))+":BUG_2 zahl: "+counter+" praemie: "+praemie+" sp: "+sonderpraemie+"\n");

  write(BS(
 "Achtung BUG im Zolomevent! Dante bitte melden! Danke!"));

     call_out("remove", 1);

   return 1; }



void zolom_kills()   {
    
    counter++;   
                  }	





send_mail()  {
	

   mixed* mail;
   string text;

   text =
   "Hallo "+CAP(getuid(TP))+"! Danke, dass Du mitgeholfen hast, die Plantagen\n"+
   "von Tijara von den Zolomen zu befreien. Bitte hilf uns auch bei der\n"+
   "naechsten Zolomplage! Dein Ergebniss war: "+counter+"!\nDanke,\n"+
   "der Gouverneur von Tijara.\n";

   mail = allocate(9);
   mail[MSG_FROM] = "Der Gouverneur von Tijara";
   mail[MSG_SENDER] = "Der Gouverneur von Tijara";
   mail[MSG_RECIPIENT] = ""+getuid(TP)+"";
   mail[MSG_CC]=0;
   mail[MSG_BCC]=0;
   mail[MSG_SUBJECT]="Zolomplage in Tijara";
   mail[MSG_DATE]=dtime(time());
   mail[MSG_ID]="zolomplage";
   mail[MSG_BODY]=text;

   return "/secure/mailer"->DeliverMail(mail,1);
}

