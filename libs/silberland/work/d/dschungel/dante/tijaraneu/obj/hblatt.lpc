/*

blatt

*/


inherit "std/thing";
#include <properties.h>
#include <language.h>
#include <wizlevels.h>
#include <moving.h>
#include "/players/dante/myowndefine.h"
#include <ansi.h>

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  AddId(({"blaetter", "blatt", "hanfblatt","hanfblaetter","HANFBLATT"}));

  SetProp(P_SHORT, "Einige frische Hanfblaetter");
  SP(P_LONG, BS(
  "Vor Dir siehst Du einige frische Hanfblaetter. Du kannst Dir daraus "
  "einen Joint drehen. Die Blaetter sind nicht ewig frisch und verfaulen..."));
  
  SetProp(P_NAME, "Hanfblaetter");
SP(P_PLURAL, 1);
  SetProp(P_GENDER, MALE);
  SetProp(P_WEIGHT, 3);
  SetProp(P_VALUE, 100 );
 
  SetProp(P_MATERIAL, ([MAT_MISC_HERBAL:10, MAT_MISC_WOOD:30, MAT_CANNABIS:60]));
    
  
ACD(({"roll","drehe","dreh", "rolle"}), "get_joint");
}


int get_joint(string str)  {
object joint;	

NF("Was willst Du rollen ?!\n");

if (str=="joint" ||str=="jolly"||str=="ofen")  {
say(BS(	
CAP_TPN+" dreht sich aus einigen Hanfblaettern einen Joint."));
write(BS(
"Du drehst Dir aus einigen Hanfblaettern einen Joint."));

joint=clone_object("d/dschungel/dante/weg/obj/dj");
joint->move(TP, M_NOCHECK);
remove();

return 1;  }

}


reset()  {
	::reset();

if(!environment(TO))  { return;  }

if(interactive(environment(TO)))  {
	tell_object(environment(TO),
                  "Die Hanfblaetter verfaulen!\n");		
	remove();
                  }
    }	