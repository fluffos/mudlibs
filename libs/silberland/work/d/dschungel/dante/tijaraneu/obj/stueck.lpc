//dante sl 98 wuschel
inherit "std/thing";

#include <properties.h>
#include <language.h>

#include "/players/dante/myowndefine.h"

void create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_WEIGHT, 15);
  SetProp(P_VALUE, 0);
  SetProp(P_GENDER, NEUTER);
  SetProp (P_SHORT, "Ein Tortenstueck (Schokolade)");
  SetProp (P_LONG, "Hmmmm, locker flockig.\n");
  SetProp (P_NAME, "Schokoladentortenstueck");

  AddId (({"tortenstueck", "stueck"}));
  SP(P_MATERIAL, ([MAT_FOOD:100]));
  AddCmd(({"essen","iss"}), "iss_torte");
}

int iss_torte (string str)
{
  notify_fail("Was moechtest Du essen?\n");
  if ( str && id(str))
  {
    write (BS("Du isst ein Stueck Schokoladentorte. Es ist "
          "einfach koestlich!\n"));
    say (BS(TPN+ " isst ein Stueck Schokoladentorte.\n"));
    remove();
    return 1;
  }
  return 0;
}


