
#include "/players/dante/myowndefine.h"
inherit "std/thing";
#include <properties.h>
#include <language.h>

int an=0;
int x=0;

create()
{
  if (!is_clone(TO) )  return;

  ::create();


  SetProp(P_SHORT, "Ein Zolombrenner");
  SetProp(P_LONG, BS(
 "Der Zolombrenner ist ein langes Rohr aus Stahl das mit gluehenden Diamanten "
 "gefuellt ist. An einem der Enden sieht man eine kleine Oeffnung. Wozu "
 "der Zolombrenner dient, ist ungewiss. Waffe scheint er keine zu sein."));
 
  SetProp(P_NAME, "Zolombrenner");
  SetProp(P_GENDER, MALE);
  SetProp(P_MATERIAL, ([MAT_STEEL:50, MAT_FIRE:20, MAT_DIAMOND:30]) );
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 500);
  AddId(({"brenner","zolombrenner"}));


AD(({"rohr","diamanten","diamant","ende"}),
"Du hast wirklich keine Ahnung wozu dieses Objekt dient.");
ASD("oeffnung", "ein");


}
   
    string ein()   {
     write(BS(
     "Du betrachtest Dir die Oeffnung genauer."));
     
     if(an==0)  {
   
     an=1;
     AddId("zolom_burn");

     return  BS(
     "Ploetzlich leuchtet der Zolombrenner hell auf.");
         }
     
     if(an!=0)  {

     an=0;
     RemoveId("zolom_burn");
     return BS
     ("Der Zolombrenner wird wieder dunkler! Er ist nun inaktiviert!");  

          }
     }



     
     
   reset()  {
   ::reset();
   
   if(!environment(TO)) { return;  }

   if(!interactive(environment(TO)))  { return;  }
    x++;


if(x>=10)  {    
   if(an!=0)  {
     tell_object(environment(TO),
     "Der Zolombrenner beginnt zu gluehen!!! Schalte ihn sofort aus!!!\n");
       call_out("weg", 30); 
      }
    }
 }




int weg()  {
     if(!environment(TO)) { return 1;  }
   if(!interactive(environment(TO)))  { return 1;  }	
     
       if(an!=0)  {
     
        tell_object(environment(TO),
     "Der Zolombrenner explodiert mit lautem Getoese.\n");	
     remove();  return 1; }
    return 1;
    }
