
inherit "std/food";
#include <properties.h>     // Properties definieren
#include <language.h>       // Definition von MALE, FEMALE, NEUTER, WER, ...
#include <new_skills.h>
#include <food.h>
#include "/players/dante/myowndefine.h"
string *wie;
int i;




create()
{

if (!is_clone(this_object()))
return;
::create();


	
SetProp (P_NAME, "Penis");
SetProp (P_GENDER, MALE);
SetProp (P_VALUE, 100);
SetProp (P_WEIGHT, 10);
SP(P_SIZE, 20);

AddId(({"penis","schwanz"}));

SetProp (P_MATERIAL, ([MAT_MISC_LIVING:100]));

SetProp(P_FOOD_INFO, ([F_HEAL: 5, F_SOAK: 1, F_ALCOHOL: 0,F_POISON: 0]));
}

BeimEssen()
{
write ("Mit Ekel steckst Du den Penis in den Mund und verschluckst ihn auf einmal! WUERG!.\n");
say (CAP_TPN+" steckt sich einen Penis in den Mund und verschluckt ihn! PFUI!\n");
return ::BeimEssen();
}