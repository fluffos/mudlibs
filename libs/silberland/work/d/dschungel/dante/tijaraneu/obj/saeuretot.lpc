//das boese boese saeureobj dante sl 2000

#include "/players/dante/myowndefine.h"

inherit "std/thing";
#include <properties.h>
#include <language.h>
#define TIME 60  //d.h man hat

void init()  
{
  ::init();
  if(environment(TO)->id("drache") ) { remove(); }

  if(!MENV || present("saeuretot 2", MENV) || !interactive(MENV))
    call_out("remove",0);
}




void create()
{
  if (!is_clone(TO) )  return;

  ::create();

  AddId( ({"saeuretot"}) );

  SetProp(P_MATERIAL, MAT_MISC_FOOD );
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NAME, 0);
  SetProp(P_SHORT, 0);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_AUTOLOADOBJ, 1);
  SetProp(P_INVIS, 1);
  call_out("kill_env0", TIME);
  SetProp(P_KILL_NAME, "Die gruene Saeure von Phytokarnizerkatos, dem Pflanzendrachen");

}

void kill_env0()  
{
  if(!MENV || !interactive(MENV) || MENV->id("drache"))
    remove();

  tell_object(environment(TO), BS(
        "Die Saeure auf Deinem Koerper zerfrisst Dich bald ganz!!! "
        "Du musst sie unbedingt sehr schnell im Schlamm abwaschen!!!"
        " Du lebst sonst noch nur mehr 4 Minuten!!!"));
  call_out("kill_env1", TIME);
}

void kill_env1()  
{
  if(!MENV || !interactive(MENV) || MENV->id("drache"))
    remove();

  tell_object(environment(TO), BS(
        "Die Saeure auf Deinem Koerper zerfrisst Dich bald ganz!!! "
        "Du musst sie unbedingt sehr schnell im Schlamm abwaschen!!!"
        " Du lebst sonst noch nur mehr 3 Minuten!!!"));
  call_out("kill_env2", TIME);
}


void kill_env2()  
{
  if(!MENV || !interactive(MENV) || MENV->id("drache"))
    remove();

  tell_object(environment(TO), BS(
        "Die Saeure auf Deinem Koerper zerfrisst Dich bald ganz!!! "
        "Du musst sie unbedingt sehr schnell im Schlamm abwaschen!!!"
        " Du lebst sonst noch nur mehr 2 Minuten!!!"));
  call_out("kill_env3", TIME);
}


void kill_env3()  
{
  if(!MENV || !interactive(MENV) || MENV->id("drache"))
    remove();

  tell_object(environment(TO), BS(
        "Die Saeure auf Deinem Koerper zerfrisst Dich bald ganz!!! "
        "Du musst sie unbedingt sehr schnell im Schlamm abwaschen!!!"
        " Du lebst sonst noch nur mehr 1 Minute!!!"));
  call_out("kill_env", TIME);
}


void kill_env()  
{
  if(!MENV || !interactive(MENV) || MENV->id("drache"))
    return remove(), 0;

  tell_object(environment(TO), BS(
        "Die Saeure auf Deinem Koerper zerfrisst Dich total!!! DU STIRBST!!!"));

  environment(TO)->die(); //HAHAHA!!!!

  write_file("/d/dschungel/dante/weg/log/plantdragon",
      ctime()+": "+environment(TO)->name()+" stirbt am Schleim!!!\n");

  remove();
}

string extra_look()
{
  return( BS(CAP(ENV(TO)->QueryPronoun(WER))+" wurde von Phytokarnizerkatos, "
        "dem Pflanzendrachen voellig mit ekelhafter, gruener Saeure "
        "eingeschleimt!"));
}
