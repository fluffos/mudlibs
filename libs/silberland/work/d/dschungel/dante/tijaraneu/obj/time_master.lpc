 */

#include <properties.h> 
#include "/players/dante/myowndefine.h"
#include <moving.h>
#include <wizlevels.h>
#include <ansi.h>
#include <moving.h>

#define SAVEFILE "/d/dschungel/dante/tijaraneu/save/eventzeiten"
#define EVENTROOM "/d/dschungel/dante/tijaraneu/room/z8"
#define BUGLOG "/d/dschungel/dante/tijaraneu/log/master"
//aus dem raum z8.c kommen die aufrufe fuer den master
#define TIME  60*60*12 //differenz die zwischen 2 events sein muss spaeter 12/24h
//wichtig ist aber unten int unterschied!!!!

#define ANZAHL 10 //10
#define DESTINATION "/d/dschungel/dante/weg/room/planta"+ort+""
#define RUNDEN  20 //20 ->200 zolome
#define REMOVE_TIME 60*15 //15 mins

nosave int unterschied;
nosave int vergleichs_zeit; 
nosave int counter;
nosave int i;
nosave int ort;
nosave object zolom;
nosave object da;
nosave string spieler;
nosave int momentane_zeit;
nosave int zaehler;
nosave object event_zolom;
nosave int geduld;
nosave string warten;

 int last_event_time;
 string *ausloeser;
 string *lesbare_zeit;
 nosave string wann;
 
create()
{


     if( is_clone(TO) ) {
     	 destruct(this_object()); 
	return ;  }
 seteuid(getuid(this_object()));
counter=0;
	
   restore_object(SAVEFILE);
 
  if (!restore_object(SAVEFILE))
  {
last_event_time=0;
ausloeser=({});
lesbare_zeit=({});

   save_object( SAVEFILE ); // Damit Savefile und Daten immer synchron sind.
  }


 
  da=find_living("dante");

unterschied=60*60*12; 
}

//create aus






ist_event_moeglich( spieler, momentane_zeit)  {

   counter=0;

      if (!CheckIfAllowed()) return;   

      
         if(last_event_time==0)  {

                tell_room(EVENTROOM,BS(
                "Eine grosse Stichflamme schiesst aus dem Brenner von "+CAP(spieler)+" "
                "und scheint die Eier zu verbrennen. Du hoerst wie tausende kleine Zolome "
                 "irgendwo hervorkriechen und die Plantagen von Tijara ueberfallen."));

                event_start();	


              shout(BSA(
              "Die Plantagen von Tijara werden von jungen Zolomen ueberfallen! Komm und hilf "
              "mit sie zu vernichten! Schuld daran ist "
              ""+CAP(spieler)+"! Verflucht sei "+CAP(spieler)+"!",
               "Cosinus ruft: "));


  
                 wann=dtime(momentane_zeit);
                 ausloeser+=({ spieler});
                 last_event_time=momentane_zeit;
                lesbare_zeit+=({ wann });
     
                 call_out("remove_all_zoloms", REMOVE_TIME);
           
           
          save_object(SAVEFILE); 
             return;
                   }



           vergleichs_zeit=last_event_time+unterschied;

         if( vergleichs_zeit <= momentane_zeit)  
        {
  	event_start();

              tell_room(EVENTROOM,BS(
             "Eine grosse Stichflamme schiesst aus dem Brenner von "+CAP(spieler)+" "
             "und scheint die Eier zu verbrennen. Du hoerst wie tausende kleine Zolome "
              "irgendwo hervorkriechen und die Plantagen von Tijara ueberfallen."));

 shout(BSA(
              "Die Plantagen von Tijara werden von jungen Zolomen ueberfallen! Komm und hilf "
              "mit sie zu vernichten! Schuld daran ist "
              ""+CAP(spieler)+"! Verflucht sei "+CAP(spieler)+"!",
               "Cosinus ruft: "));

      
      
      
      
                 wann=dtime(momentane_zeit);
               ausloeser+=({spieler});
                last_event_time=momentane_zeit;
                lesbare_zeit+=({ wann});

                 save_object(SAVEFILE);
                  call_out("remove_all_zoloms", REMOVE_TIME); 
     
     
                  return;  }



                if( vergleichs_zeit  > momentane_zeit)  
                {

                geduld= (vergleichs_zeit-momentane_zeit);
 
              warten=time2string( "%d:%02h:%02m:%02s", geduld );  

             tell_room(EVENTROOM,BS(
           "Eine grosse Stichflamme schiesst aus dem Brenner von "+CAP(spieler)+" "
            "und scheint die Eier zu verbrennen. Doch die Zeit ist noch nicht reif! "
             "Du musst noch "+warten+" warten!"));


          return;  }

        }

//************************************************************************

event_start(object ausloeser)   {
      if(da)  {
     tell_object(da,
"Event in event_start angekommen!\n");
                    }		

for(i=0; i<ANZAHL; i++)  {
 event_zolom=clone_object("/d/dschungel/dante/tijaraneu/npc/ev_zolom");
	ort=1+random(12);
  event_zolom->move(DESTINATION, M_GO+M_NOCHECK,
 "","","kommt hereingekrochen");
        
          }

counter++;   

if(counter<RUNDEN)  {
call_out("event_start", 1);
            
            }
return;
}


//************************************************************************



  remove_all_zoloms()   {
 
 zolom=find_living("event_zolom");	
 
if(!zolom)  {
	if(da)  {
	tell_object(da,
      "Vernichtet: "+zaehler+"! Keine Zolome haben ueberlebt!!!!\n");
                        }	
	
shout(BSA(
"Die jungen Zolome haben sich alle wieder von den Plantagen "
"von Tijara zurueckgezogen! Die Plage ist "
"ueberstanden! Kommt zu mir und holt euch das Kopfgeld ab!!!",
"Cosinus ruft: "));

	
             return ;  }	




   
    zaehler++;
    zolom->move("players/dante/workroom", M_GO+M_SILENT);
    zolom->remove();
	
call_out("remove_all_zoloms", 0);


return ;

}





int CheckIfAllowed()
{
 object ob;
 string fname;
 ob=previous_object();
 fname=file_name(ob);
 if(!IS_ARCH(getuid(ob))&&getuid(ob)!="d.dschungel.dante") {
   write_file(BUGLOG, 
      dtime(time())+": Versuchte Aenderung im Master "
      +"von "+CAP(getuid(ob))+"\n");
   return 0;
 }
 return 1;
}

//ende
