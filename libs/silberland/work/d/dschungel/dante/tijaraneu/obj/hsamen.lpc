/*

samen by dante

*/


inherit "std/thing";
#include <properties.h>
#include <language.h>
#include <wizlevels.h>
#include <moving.h>
#include "/players/dante/myowndefine.h"
#include <ansi.h>
#define TIME 60
string setzer="";


create()
{
  if (!is_clone(this_object())) return;
  ::create();

  AddId(({ "hanfsamen","samen","HANFSAMEN"}));

  SetProp(P_SHORT, "Ein kleiner Hanfsamen");
  SP(P_LONG, BS(
"Das ist ein kleiner, aber gesunder Hanfsamen. Du kannst ihn "
"pflanzen und auf Grund seiner magischen Kraft wird daraus ein Strauch wachsen. "
"Achtung! Ewig haelt dieser Samen nicht!"));

  
  SetProp(P_NAME, "Hanfsamen");
  SetProp(P_GENDER, MALE);
  SetProp(P_WEIGHT, 3);
  SetProp(P_VALUE, 100 );
 
  SetProp(P_MATERIAL, ([MAT_MISC_HERBAL:10, MAT_MISC_WOOD:30, MAT_CANNABIS:60]));
    
ACD(({"pflanz","pflanze","pflanzen","setze","setz","setzen"}), "seed");  
}


int seed(string str)  {

NF("Was willst Du pflanzen ?!\n");

if (str=="samen"||str=="hanfsamen")  {


if(present("SAMEN_GEPFL", environment(TP)))  {
	write(BS(
	"Hier wurde bereits ein Samen gepflanzt!"));
	return 1;  }


if(present("hanfstrauch", environment(TP)))  {
	write(BS(
	"Hier wurde bereits ein Hanfstrauch gepflanzt!"));
	return 1;  }
say(BS(	
CAP_TPN+" steckt einen Samen in den Boden."));
write(BS(
"Du schaffst es den Hanfsamen in den Boden zu stecken."));


if(!environment(TP))  { remove();  }
TO->move(environment(TP), M_NOCHECK);
AddId("SAMEN_GEPFL");

setzer=CAP(getuid(TP));

SetProp(P_NOGET, BS(
"Der Samen wurde von "+setzer+" eingepflanzt!"));
SetProp(P_SHORT, "Ein kleiner Hanfsamen (eingepflanzt von "+setzer+") ");
  SP(P_LONG, BS(
"Das ist ein kleiner, aber gesunder Hanfsamen. "
"Er wurde von "+setzer+" eingepflanzt und es soll daraus einmal ein "
"grosser Hanfstrauch werden!"));


call_out("wachsen", TIME);
return 1;  }

}


wachsen()  {
object strauch;
if(!environment(TO))  { remove();  }

if(interactive(environment(TO)) ) { remove();  }
	
strauch=clone_object("d/dschungel/dante/tijaraneu/obj/hs");
strauch->move(environment(TO), M_NOCHECK);

strauch->wer_setzt_mich(getuid(TP));

tell_room(environment(TO), 
"Ploetzlich beginnt ein Strauch wie wild aus dem Samen zu wachsen!\n");

remove();
 
 }




reset()  {
	::reset();

if(!environment(TO))  { return;  }

if(interactive(environment(TO)))  {
	tell_object(environment(TO),
                  "Die Hanfsamen verfaulen!\n");		
	remove();
                  }
    }	
