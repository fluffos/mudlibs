inherit "std/thing";

#include <properties.h>
#include <moving.h>
#include <language.h>
#include "/players/dante/myowndefine.h"
#define amount this_player()->QueryMoney()

int list_size, word_length, counter, counter_rek, ret, game_allow, win, win_count,statistic_win, statistic_count;
string *word_list, guess, gword, this_word, letter, can_play;


create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT,"Ein Hangman-Spiel-Automat");
  SetProp(P_LONG, ("Vor Dir siehst Du einen Hangman-Automat.\n"
                   "Er basiert auf einem Unwerk von Nostromo\n"
                   " und Konsorten, wurde aber von Dante\n"
                   " vollendet und hier aufgestellt.\n"                    
                    
  		  +"Mit <spiel> beginnst Du ein neues Spiel.\n"
  		  +"Mit <rate [Buchstabe]> raetst Du einen Buchstaben (zB: rate e).\n"
  		  +"Mit <beende spiel> beendest Du ein Spiel.\n"
  		  +"Mit <neues spiel> kannst Du nochmals anfangen.\n"
  		  +"Mit <statistik> wird eine Statistik ueber das bisherige Spiel gegeben.\n"
  		  +"PS: Die Anzahl der restlichen Versuche wird nur bei einem falschem\n"
  		  +"    Buchstaben weniger.\n"));
  AddId( ({"hangmanautomat", "hangman", "hma","automat","spiel"}) );
  SetProp(P_NAME,"Hangman-Spielautomat");
  SetProp(P_GENDER,MALE);
  SetProp(P_NOGET,1);
  SetProp(P_WEIGHT,250000);
  SetProp(P_MATERIAL, ([MAT_STEEL:50, MAT_MAGIC:50]));
  SetProp(P_INFO, (
  "Auf der Rueckseite des Automaten entdeckst Du eine kleine Notiz:\n"
 +"SL-Allgemein, NPC's, Ladeninventar, uae.\n"
 +"Tja hier handelt es sich wohl um die Themenkreise fuer die Woerter.\n"
 +"Na hoffentlich hilft's.\n"));
 
word_list=({"silberland","goetter","elfen","elfengilde","feenschloss",
 "hangmanautomat","abenteuergilde","sargola","spielerhilfe","ogerlager"
 "quest","stufenpunkte","attributpunkte","forscherpunkte","zaubertrank",
 "lebenspunkte","gilden","tijara","karavelle","dschungel","gebirge",
 "kristallwald","rattenplage","todessequenz","komplettloesung","midas",
 "zaubertrankliste","ebenen","idlezeit","zuckerbuebchen","monsterlag",
 "offizier","silberwolf","eichhoernchen","gecko","wildschwein","ameise",
 "babybaer","strandlaeufer","elsurion","schildkroete","ente","wildkaninchen","maus",
 "frosch","angler","wanderzwerg","henk","ketzer","elsurion","rok","balrog",
 "gouverneur","alrik","schwammerlsucher","fraggle","giftschlange","kobold",
 "ogerwaechter","rausschmeisser","anfuehrerwolf","jaguar","tiger","papagei",
 "mithrilpanzer","mordorschwert","mithrilhelm","kevlarschild","windelhose",
 "freundschaftsband","zitteraalherz","ogerhelm","zwergenaxt","handaxt",
 "saebel","kapitaensmuetze","wolfsfell","lederstiefel","bronzehelm",
 "lederbeutel","eisenpanzer","schaufel","bienenstachel","braunbaerenfell",
 "igelfellchen","lederhandschuhe","dschungel","unfug","playerkill",
 "tireks","ogerlager","plantage","monster","drache","pflanzendrache",
 "skelettdrache","ykath","vampir","vampirdrache","zombie",
 "zombieinsel","elessar","kyranda","abenteuer","gilde",
  "dschungelwaechter","paladin","nekromant","zauberer","magier",
 "fee","troll","hobbit","banane","hexe","magie",
 "insel","jojogeist","luftgeist","daemon","orkandaemon","erdbebendaemon",
 "turm","schloss","burg","verlies","wassergeist","wasserdaemon",
 "riese", "untoter","seher","erzseher","spieler",
 "hoehle","steingigant","steingigantenhoehle","keule",
 "paladinburg","druide","ayla","anvar","kronang",
 "berserker","felseninsel","dunkelelf","wueste",
 "huegelland","elementar","beinschiene","ush","nazgul",
 "armschiene","drachenschuppe","erzmagier","regionsmagier",
 "luftschwert","granitpanzer","silberdrache"
 
});

counter=10;
gword="";
game_allow=0;
can_play="";
win=0;
win_count=0;
statistic_count=0;
statistic_win=0;

  AddCmd (({"rate"}), "gletter");
  AddCmd (({"spiel" , "spiele"}), "game");
  AddCmd (({"beende"}), "end");
  AddCmd (({"neues"}), "new_game");
  AddCmd (({"statistik"}), "statistic");

}

//---------------------------------------GAME-------------------------------

game(string str)
{
if(!can_play=="")
{ 
  if(present(can_play))
    {
      return 1;
    }
  return 1;
}
else
{
  player_here();
}
if(!game_allow)
{
 list_size=sizeof(word_list);
 this_word=word_list[random(list_size)];
 if(!can_play) can_play=getuid(TP);
 if (can_play && present(can_play, environment(this_object())) && getuid(TP) != can_play )
	return write("Du musst leider warten, "+capitalize(can_play)+" spielt gerade.\n"),1;
 can_play=getuid(this_player());

 if (can_play && find_player(can_play) && (ENV(ME) == ENV(find_player(can_play))))
  {
   say(this_player()->name()+" spielt eine Runde Hang-Man.\n");
   write("Ein neues Spiel beginnt.\n");
   gword="";
   word_length=strlen(this_word);
   write("Das gesuchte Wort hat "+word_length+" Buchstaben.\n");
   statistic_count++;
   game_allow=1;
   counter=10;
   gletter(str);
   return 1;
  }
  return 1;
 }
else
 {
  if(capitalize(can_play)!=TP->QueryProp(P_NAME) )
  { 
   write(BS("Du musst leider warten, "+capitalize(can_play)+" spielt gerade.\n"));
   return 1;
  }
 else
  { 
   write("Aber Du spielst doch schon.\n");
   return 1;
  }
 }
}

//---------------------------------------GLETTER----------------------------

gletter(string guess)
{
player_here();
if(capitalize(can_play)!=TP->QueryProp(P_NAME) )
 {
  if(can_play=="")
  {
    write("Mit <neues spiel>, oder <spiel> kannst Du beginnen.\n");
    return 1;
  }
  else
  {
    write(BS("Du musst leider warten, "+capitalize(can_play)+" spielt gerade.\n"));
    return 1;
  }
 }
if(game_allow==1)
  {
   word_length=strlen(this_word);
   if (gword=="") gword = "...........................";
   counter_rek=0;
   counter_rek--;
   if(counter>1)
     {
      if(!gletter_rek(guess)) counter--;
      gletter_rek(guess);
      if(gword==this_word) 
       {
       win=1;
       check(win);
       return 1;
       };
      write("Du hast noch "+counter+" Versuche.\n");
      write(gword+"\n");
      return 1;
     }
   else
     {
      game_allow=0;
      win=0;
      check(win);
      return 1;
     }
  }
 else
  {
   write("Du musst erst ein neues Spiel starten.\n");
   return 1;
  }
}

//---------------------------------------GLETTER-REK------------------------

gletter_rek(string guess)
{
 string *temp, *gtemp;
 int i, ret;
 temp = new_explode(this_word,"");
 gtemp = new_explode(gword,"");
 gword = "";
 for (i = word_length-1; i>=0; i--)
   {
   if (guess==temp[i]) {gword = temp[i] +gword; ret = 1; }
   else gword = gtemp[i] + gword;
   }
   return ret;
}

//---------------------------------------NEW-GAME---------------------------

new_game(string str)
{
if(capitalize(can_play)!=TP->QueryProp(P_NAME) )
 {
  player_here();
  game();
  return 1;
 }
 else
 {
  notify_fail("Syntax: <neues spiel>\n");
  if (str != "spiel") return 0; 
  write("Du beginnst eine neue Spielrunde.\n");
  say(this_player()->name()+" spielt noch eine Runde Hangman.\n");
  this_word="";
  game_allow=0;
  can_play="";
  win_count=0;
  game(this_word);
  return 1; 
 }
}

//--------------------------------------END---------------------------------

end(string str)
{
if (str == "spiel")
  {
    if(game_allow && capitalize(can_play)==TP->QueryProp(P_NAME))
      {
       write("Du gibst das Hangman-Spiel auf.\n");
       say(this_player()->name()+" gibt das Hangman-Spiel auf.\n");
       can_play="";
       game_allow=0;
       statistic_count=0;
       statistic_win=0;
       return 1;
      }
    else
      {
       if(capitalize(can_play)!=TP->QueryProp(P_NAME) )
          { 
           write(BS("Du spielst doch gar nicht. Nur "+capitalize(can_play)+" koennte das Spiel beenden.\n"));
           return 1;
          }
      return 1;
      }
  }
else
  {
  write("Was willst Du beenden ?\n");
  return 1;
  }
 
}

//---------------------------------------CHECK------------------------------

check(string win)
{
if(win==1)
  {
  write("GEWONNEN\n");
  win_count++;
  statistic_win++;
  choice(win_count);
  return 1;
  }
else
  {
  write("VERLOREN\n");
  write("Das richtige Wort waere \""+this_word+"\" gewesen.\n");
  win_count=0;
  game_allow=0;
  this_word="";
  gword="";
  game();
  return 1;
  }
}

//---------------------------------------CHOICE-----------------------------

choice(string win_count)
{
write("Du hast nun "+win_count+" mal hintereinander gewonnen.\n");
game_allow=0;
this_word="";
gword="";
game();
}

//---------------------------------------STATISTIC--------------------------

statistic(string str)
{
if(statistic_count==1)
 { 
  write("Von einem Spiel wurden "+win_count+" gewonnen.\n");
  return 1;
 }
else
 {
  write("Von "+statistic_count+" Spielen wurden "+statistic_win+" gewonnen.\n");
  return 1;
 }
}

//---------------------------------------PLAYER-HERE------------------------

player_here(string str)
{
if(present(can_play) && find_player(can_play)) 
  {
   return 1;
  }
else
  {
   if(can_play!="")
     {
       write("Nachdem "+capitalize(can_play)+" nicht mehr da ist, spielst Du eine Runde Hang-Man.\n");
       counter=10;
       gword="";
       game_allow=0;
       can_play="";
       win=0;
       win_count=0;
       statistic_count=0;
       statistic_win=0;
       return 1;
     }
   else
     {
       counter=10;
       gword="";
       game_allow=0;
       win=0;
       win_count=0;
       statistic_count=0;
       statistic_win=0;
       return 1;
     }
  }
}
