/*

seherhanfstrauch


*/


inherit "std/thing";
#include <properties.h>
#include <language.h>
#include <wizlevels.h>
#include "/players/dante/myowndefine.h"
#include <moving.h>

void wer_setzt_mich(string wer);

int total=0;

int uses=3;
string zuechter;

reset()  {
     ::reset();
     uses=3;  }
     	


create()
{
  if (!is_clone(this_object())) return;
  ::create();

  AddId(({"strauch", "hanfstrauch", "hanf","HANFSTRAUCH"}));

  SetProp(P_SHORT, "Ein frischer, saftiger Hanfstrauch");
 zuechter="dante";
  
  SetProp(P_NAME, "Hanfstrauch");
  SetProp(P_GENDER, MALE);
  SetProp(P_WEIGHT, 1000);
  SetProp(P_VALUE, 1000+uses*uses*uses);
 SP(P_NOGET, BS(
 "Der Hanfstrauch ist am Boden festgewachsen."));
 
  SetProp(P_MATERIAL, ([MAT_MISC_HERBAL:10, MAT_MISC_WOOD:30, MAT_CANNABIS:60]));
    
  
ACD(({"pfluecke","pflueck"}), "get_leaf");
}


int get_leaf(string str)  {
object blatt;	
NF("Was willst Du pfluecken ?!\n");

if (str=="blatt"||str=="blaetter"||str=="marihuana"||
str=="canabis")  {
	
if(uses < 1 )   {
	write(BS(
	"Leider wurden alle Blaetter schon geerntet."));
        return 1;  
        }			

if(uses > 0 )  {
	uses--;
write(BS(
"Du zupfst vorsichtig einige Blaetter vom Hanfstrauch."));
say(BS(	
CAP_TPN+" zupft einige Blaetter vom Hanfstrauch."));
blatt=clone_object("d/dschungel/dante/tijaraneu/obj/hblatt");
blatt->move(TP, M_NOCHECK);
total++;

if(total > 20+random(5) )  {

write(BS(
"Ploetzlich verwelkt der Strauch!"));
say(BS(
"Ploetzlich verwelkt der Strauch!"));

remove();
}

return 1;  }

     }
}





_query_long()   {
	if(uses > 1 )   {
return BS(
 "Du siehst einen saftigen, grossen Hanfstrauch vor Dir, dessen "
 "Blaetter sehr  frisch und gesund aussehen. Du kannst versuchen einige "
 "davon zu pfluecken. Der Strauch wurde von "+CAP(zuechter)+" grossgezogen und "
 "wie es aussieht sind noch Blaetter fuer "+uses+" Joints da.");
  	}
  if(uses==1 )  {
  return BS(
 "Du siehst einen saftigen, grossen Hanfstrauch vor Dir, dessen "
 "Blaetter sehr  frisch und gesund aussehen. Du kannst versuchen einige "
 "davon zu pfluecken. Der Strauch wurde von "+CAP(zuechter)+" grossgezogen und "
 "wie es aussieht sind leider nur mehr Blaetter fuer "+uses+" Joint da.");
  	}		 
  
if(uses < 1)  {
	return BS(
 "Du siehst einen saftigen, grossen Hanfstrauch vor Dir, dessen "
 "Blaetter sehr  frisch und gesund aussehen. Du kannst versuchen einige "
 "davon zu pfluecken. Der Strauch wurde von "+CAP(zuechter)+" grossgezogen."
" Leider wurde der Straucht total abgeerntet. Da muss "
"jemand einiges geraucht haben...");
                 }
}


void wer_setzt_mich(string wer)  {
	zuechter=wer;  }
	