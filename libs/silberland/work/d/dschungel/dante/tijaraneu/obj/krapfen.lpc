//dante krapfen pennywise 97
inherit "std/food";

#include "/players/dante/myowndefine.h"
#include <properties.h>
#include <food.h>

void create()
{
  string str;

  if (!is_clone(this_object())) return; 
  ::create();

  SetProp(P_SHORT, "Ein Krapfen");
  SetProp(P_LONG, "Ein grosser, herrlich duftender Krapfen von Pennywise. "
      "Er schmeckt sicher vorzueglich!\n");
  SetProp(P_GENDER, MALE);
  SetProp(P_WEIGHT, 30);
  AddId(({"krapfen"}));
  SetProp(P_INFO, "Dieser Krapfen verleiht Kraft!!!\n");
  SetProp(P_NAME, "Krapfen");
  SetProp(P_MATERIAL, MAT_FOOD);
  SetProp(P_VALUE, 100);
  SetProp (P_FOOD_INFO, ([F_HEAL: 11, F_SOAK: 3, F_ALCOHOL: 0, F_POISON: 0]));

}

void BeimEssen()
{
  write("Der Krapfen schmeckt herrlich gut...\n");
  say("Du willst auch so einen Pennywisekrapfen, wie ihn "+ TPN+ " gerade isst.\n");
  return ::BeimEssen();
}

