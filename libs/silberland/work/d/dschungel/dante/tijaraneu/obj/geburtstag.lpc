create(string kind, string alt)
{
  if (!is_clone(this_object())) return;
  ::create();
  kerzen_aus = 0;
  alter="";

  geburtstagskind=""+kind+"";
  alter=""+alt+"";

  AddId (({"geburtstagstorte", "torte"}));
  SetProp (P_SHORT, ""+C(geburtstagskind)+ "\'s riesige Geburtstagstorte");
  SetProp (P_NAME, "Geburtstagstorte");
  SetProp (P_GENDER, FEMALE);
  SetProp (P_WEIGHT, 100);
  SetProp (P_VALUE, 2000);
  SetProp (P_NOBUY, 0);
  SetProp(P_MATERIAL, ([MAT_FOOD:100]));

  AddCmd ("blase", "blase_torte");
  AddCmd ("schneide", "schneide_torte");
  AddCmd(({"wuensche","wuensch"}), "get_zt");
  seteuid(getuid(this_object()));
}

int get_zt(string str)  {

  NF("Was willst Du Dir wuenschen!\n");
  if(!str) return 0; 

  if(wunsch==0)  {
    write(BS(
          "Nein, Du hast Dir schon etwas gewunschen und pro Torte "
          "gibt es nur einen Wunsch!"));
    return 1; }
    if(!kerzen_aus)  {
      write(BS(
            "Zuerst musst Du die Kerzen ausblasen!"));
      return 1; }

      if(str=="zaubertrank"|| str=="zt")  {
        wunsch=0;
        if(TP->FindPotion())  {
          write("\n");	
          write(BS(
                "Du wuenscht Dir einen Zaubertrank und ploetzlich hast "
                "Du einen in der Hand, den Du sofort trinkst! WOW!!! Was fuer eine "
                "geniale Torte!"));
          say(BS(
                CAP_TPN+" wuenscht sich einen Zaubertrank und haelt dann "
                "ploetzlich einen in der Hand! Unglaublich!!!"));
          return 1; }

        else {
          write(BS(
                "Du wuenscht Dir einen Zaubertrank, doch nicht alle Wuensche "
                "koennen in Erfuellung gehen! Leider!"));
          say(BS(
                CAP_TPN+" wuenscht sich einen Zaubertrank, doch dieser "
                "Wunsch wird "+TP->QueryPronoun(WEM)+" leider nicht erfuellt!"));
          return 1;   
        }	 		
        return 0; }

      else  {
        write(BS(
              "Du wuenscht Dir '"+str+"' und hoffst, das sich dieser "
              "Wunsch erfuellen wird!"));
        say(BS(
              CAP_TPN+" wuenscht sich etwas und hofft, das dieser Wunsch "
              "sich erfuellen wird!"));
        wunsch=0;   
        return 1; }
        return 0; }


_query_long()
{
  if (!kerzen_aus)
    return (BS ("Auf dieser gigantischen Geburtstagstorte brennen " +
          alter +  
          " Kerzen. Mit gelbem Zuckerguss steht in der Mitte " +
          "der Torte geschrieben: Alles Gute " +C(geburtstagskind)+"!"
          " Dir laeuft das Wasser im Mund zusammen - wie " 
          "waere es, wenn Du ein Stueck von der Torte " + 
          "abschneidest?\n"));
  else
    return (BS ("Auf dieser gigantischen Geburtstagstorte befinden sich "
          + alter + 
          " ausgeblasene Kerzen. Mit gelbem Zuckerguss steht in der "
          "Mitte der Torte "
          "geschrieben: \"Alles Gute " +C(geburtstagskind) +
          "!\" Dir laeuft das Wasser im Mund zusammen - wie "
          "waere es, wenn Du ein Stueck von der Torte " +
          "abschneidest?\n"));
}


blase_torte (string str)

{
  int result;
  result = 0;
  notify_fail ("Was willst Du ausblasen?\n");
  if (str && str=="kerzen aus")
  {
    if (LOWER(TPN)==LOWER(geburtstagskind))
    {
      if (!kerzen_aus)
      {
        write (BS ("Du holst ganz tief Luft und blaest mit einem Zug "
              "die Kerzen "
              "aus. Du darfst Dir was wuenschen!\n"));
        say (BS (TPN+ " holt ganz tief Luft und blaest mit einem Zug "
              "die Kerzen " + TP->QueryPossPronoun(FEMALE, WESSEN) + 
              " Geburtstagstorte aus. " + TPN + " macht die Augen zu und "
              "scheint sich etwas zu wuenschen.\n"));
        kerzen_aus=1;
      }
      else
        write (BS ("Die Kerzen sind doch schon aus.\n"));
    }
    else
      write (BS ("Das darf nur " +C( geburtstagskind) +".\n"));
    result = 1;
  }
  return result;
}

schneide_torte (string str)
{
  int result;
  object ob;
  result = 0;
  notify_fail ("Was willst Du denn abschneiden?\n");
  if (str && str=="stueck ab")
  {   
    if (stueckzahl > 0)
    {
      if (kerzen_aus)
      {
        if (LOWER(TPN)==LOWER(geburtstagskind))
        {
          write (BS ("Du schneidest ein grosses Stueck von Deiner "
                "Torte ab.\n"));
          say (BS (TPN+ " schneidet ein grosses Stueck von "
                + TP->QueryPossPronoun(FEMALE, WESSEN) + " Torte ab.\n"));
          ob=clone_object("/d/dschungel/dante/tijaraneu/obj/stueck");
          stueckzahl--;
          ob->move(TP, M_NOCHECK);
        }
        else
          write (BS ("Das darf nur " +C( geburtstagskind) + ".\n"));
      }
      else
        write (BS ("Du musst die Kerzen zuerst ausblasen.\n"));
    }
    if (stueckzahl<=0)
    {
      write (BS ("Das war das letzte Stueck Torte. Jetzt musst Du leider wieder "
            "bis naechstes Jahr warten.\n"));
      remove ();
    }
    result=1;
  }
  return result;
}
