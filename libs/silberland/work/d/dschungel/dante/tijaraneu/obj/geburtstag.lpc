inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <moving.h>

#include "/players/dante/myowndefine.h"
#define C capitalize




int wunsch=1;
int kerzen_aus;
string alter;
int stueckzahl=10;
string geburtstagskind;

#define PlayerGender this_player()->QueryProp(P_GENDER)

