//liste fuer alltime high aller spieler!!!!!

query_list(name_arr, anz_arr,geld_arr, wer)
{
  string ausgabe;
  int i;
  int index;

  index = member(name_arr, wer);

  ausgabe = "";

  for (i=0;(i<20) && (i<sizeof(name_arr));i++)
    ausgabe+=sprintf("         %3d.) %-11s   %7d             %9d\n",i+1,name_arr[i],anz_arr[i],geld_arr[i]);

  if (index >= 20)
  {
    ausgabe+="\n\n";
    for (i=index-3;(i < index +4) && (i<sizeof(name_arr));i++)
      ausgabe+=sprintf("         %3d.) %-11s   %7d             %9d\n",i+1,name_arr[i],anz_arr[i],geld_arr[i]);
  }
  else
    if (index == -1)
      ausgabe+="\n\n\tDein Name taucht in der Liste nicht auf!\n";

  return ausgabe;
}
