query_best_players(spielername)
{
  string ausgabe;

  ausgabe = 
"\tBeste Zolomjaeger aller Zeiten absolut betrachtet:\n"+
"\t==================================================\n"+
"\t  Rang/Name:          Anzahl:        Kopfgeld(total):\n\n"+ 
""+query_list(best_players, counters, money, spielername)+"";

  return ausgabe;
}
     
fuege_im_array_hinzu( name_arr, anz_arr,geld_arr,rekord_arr, wer, wieviel, 
    wievielgeld, rekord)
{
  int index;
  string dummy_name;
  int dummy_kills;
  int dummy_geld;
  int dummy_rekord;
  bool stat;

  if (!name_arr)
  {
    name_arr = ({});
    anz_arr = ({});
    geld_arr=({});
    rekord_arr=({});
  }

//d.h er steht nicht drin

  if ((index = member(name_arr, wer)) == -1)
  {
    name_arr+=({wer});
    anz_arr+=({wieviel});
    geld_arr+=({wievielgeld});
    rekord_arr+=({rekord});
    index = sizeof(name_arr) -1;
  }
  //d.h er steht schon drin
  else
  {
    anz_arr[index]+=wieviel;
    geld_arr[index]+=wievielgeld;
    if(rekord > rekord_arr[index]  )
    {
      rekord_arr[index]=0;
      rekord_arr[index]+=rekord;
    }
  }
  stat = TRUE;
  while ((index > 0) && (stat))
  {
    if (anz_arr[index-1] <= anz_arr[index])
    {
      dummy_name = name_arr[index];
      dummy_kills = anz_arr[index];
      dummy_geld= geld_arr[index];
      dummy_rekord= rekord_arr[index];
       
      name_arr[index]  =   name_arr[index-1];
      anz_arr[index]   =   anz_arr[index-1];
      geld_arr[index]  =   geld_arr[index-1];
      rekord_arr[index]=   rekord_arr[index-1];
      
      anz_arr[index-1] =    dummy_kills;
      name_arr[index-1]=    dummy_name;
      geld_arr[index-1]=    dummy_geld;
      rekord_arr[index-1]=  dummy_rekord;
      
      index --;
    }
    else
      stat = FALSE;
  }

  return ([ 0:name_arr, 1:anz_arr, 2:geld_arr, 3:rekord_arr]);
}



