//*******************neue fun eingebaut fuer topliste 2 .....fluch fluh fluch



query_pers_rekord(spielername)    {
  string *z;
  string *n;
  string ausgabe;
  ausgabe=(
      "\tTopliste fuer erlegte Zolome waehrend einer Zolomplage:\n"
      "\t=======================================================\n"
      "\t  Rang/Name:          Anzahl:          Kopfgeld:\n\n");    

  for(i=0 ;i<sizeof(best_players); i++) {
    for(i=0 ;i<sizeof(pers_rekord); i++) {
      to_int(pers_rekord[i]);
      map += ([ best_players[i]: pers_rekord[i] ]);     	
    }
  }   
  
 n=m_indices(map);
 z=m_values(map);

//z=sort_array(m_values(map), #'>);
//n=m_indices(map);
//z=m_values(map);

//e Sortiergeschichte:
// Array aus den keys vom mapping bilden (=spielernamen)
// array_toplist =  sort_array(m_indices(mapping_toplist), #'SortHelp);

  z=sort_array(m_indices(map), #'SortHelp);



// Nun mithilfe des sortieren Arrays als key die Werte richtig
// Aus dem mapping holen. Fullstring ist die sortierte Liste nacher

//      for (i=0;i<sizeof(array_toplist);i++)
        
//        fullstring += sprintf("     %15.15-s%9.4d%9.8d\n", CAP(toplist[i]),
//                   mapping_toplist[array_toplist[i],0],
//                   mapping_toplist[array_toplist[i],1]);
    
//ausgabe+=(""+x+".) "+CAP(z[i])+" "+map[z[i]]+"\n");
             
             
  for(i=0 ;i<sizeof(z); i++)  {
    if(map[z[i]] < 60 )  {	
      ausgabe+=sprintf("         %3d.) %-11s   %7d         %9d\n",
          i+1,CAP(z[i]),map[z[i]],map[z[i]]*kopfgeld);
    }
    if(map[z[i]]  >= 60 )  {
      totalpraemie=(map[z[i]]*kopfgeld)+(map[z[i]]*map[z[i]]);
      ausgabe+=sprintf("         %3d.) %-11s   %7d         %9d\n",
          i+1,CAP(z[i]),map[z[i]],totalpraemie);
    }
  }                                                       

  return ausgabe;  
}
 
 //*****************************************************************
 
int SortHelp(string name1, string name2)
{
  // Der Wert von 1 ist groesser als der von 2
  if (map[name1,0]<map[name2,0]) return 1;
  // Der wert von 2 ist groesser als der von 1
  else if (map[name1,0]>map[name2,0]) return 0;
  // Die Werte sind gleich - Name alphabetisch ordnen
  else return name1<name2;
}                  	

