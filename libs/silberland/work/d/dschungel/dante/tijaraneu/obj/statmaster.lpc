nosave mapping map=([]);

int SortHelp(string name1, string name2);
string *best_players;
int *counters;
int *money;
int *pers_rekord;
nosave int i;
nosave string *z;
nosave string *n;
nosave int kopfgeld=100;
nosave int totalpraemie;

void create()
{
  seteuid(getuid());
  if (!restore_object(SAVEFILE))
  {
    best_players = ({});
    counters = ({});
    money=({});
    pers_rekord=({});
    
  }
}


//TP->name(), counter, totalpraemie, counter);         

addiere_zu_persoenlicher_liste(spielername, anzahl, geld, rekordwert)   {
	
 mapping dummy;
 
 /*if (getuid(previous_object()) != "event")
  {
    BUGLOG("WARNUNG: Unbefugter Versuch, die Statistiken zu verfaelschen durch "+getuid(previous_object()) + "\n");
    return FALSE;
  }	
*/

  dummy = fuege_im_array_hinzu(
    best_players, counters, money,pers_rekord,
    spielername, anzahl, geld, rekordwert);

  best_players = dummy[0];
  counters = dummy[1];
  money=dummy[2];
  pers_rekord=dummy[3];
  
  save_object(SAVEFILE);
}


