//dante sl 96 99
inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include "/players/dante/myowndefine.h"
#include <wizlevels.h>

int usedcount;

create()
{
  if (!is_clone(this_object()))
     return;
  ::create();
  
usedcount = 0;

  SetProp (P_SHORT, "Eine bunte, boesartige Clownmaske");
  SetProp (P_LONG, (
  "Diese Maske gehoerte einst dem Clown Pennywise. Sie zeigt ein "
  "boesartiges Grinsen und wirkt angsteinfloessend auf Dich."));
  SetProp (P_INFO, "Die Clownmaske macht Dich boese! \n");
  SetProp (P_NAME, "Clownmaske");
  SetProp (P_GENDER, FEMALE);
  AddId (({"maske","clownmaske"}));
  SetProp (P_WEIGHT, 500);
  SetProp (P_NOBUY, 1);
  SetProp (P_VALUE, 3800);
  SetProp (P_ARMOUR_TYPE, AT_HELMET);
  SetProp (P_AC, 7);
  SetProp(P_RESISTANCE, ({ DT_TERROR, DT_UNHOLY}));
  SetProp(P_MATERIAL, MAT_MAGIC);
  AddDetail(("grinsen"),
  "Du erschreckst Dich als Du die Maske naeher betrachtest!");
  SetProp(P_WEAR_FUNC, this_object());
  
}

WearFunc(object maske)

{
  int tpal;
  tpal=this_player()->QueryProp(P_ALIGN);

 if( TP->QueryProp(P_XP)< 500000 ||
 TP->QueryAttribute(A_INT)<15 )
 {
 write("Die Clownmaske verhoehnt Dich...\n"
 "Du bist noch nicht in der Lage sie anzuziehen...\n");
 return 0;
 }

 if (usedcount>10+random(10))
  {
 write("Die Maske grinst und verschwindet wieder zu Pennywise.\n");
 this_object()->remove();
 return 0;
 }
 
 if ((tpal>100) && (tpal<700))
 {
   write(
   "Beim Anziehen der Maske ueberkommt Dich ein boeser Fluch!\n");
   this_player()->SetProp(P_ALIGN, TP->QueryProp(P_ALIGN)-random(600));
   usedcount++;
   return 1;
   }
    if (tpal>700)
 {
   write(
   "Beim Anziehen der Maske fuehlst Du einen brennenden Schmerz im Kopf.\n");
   this_player()->SetProp(P_ALIGN, TP->QueryProp(P_ALIGN)-random(600));
   TP->do_damage(5);
   usedcount++;
   return 1;
   }
    if (tpal< -700)
 {
   write(
   "Beim Anziehen der Maske fuehlst Du Dich auf einmal sehr wohl.\n");
   this_player()->SetProp(P_ALIGN, -700);
   TP->heal_self(5);
   usedcount++;
   return 1;
   }
   return 1;
   }
   
