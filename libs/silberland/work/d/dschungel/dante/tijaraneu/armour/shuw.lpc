//dante schuhe

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <wizlevels.h>
#include "/players/dante/myowndefine.h"
create()
{
  if (!is_clone(this_object()))
     return;
  ::create();

  AddId (({"clownstiefel","schuhe","clownschuhe"}));
  SetProp (P_SHORT, "Ein Paar Schuhe von Krusty dem Clown");
  SetProp(P_LONG, BS(
  "Diese Schuhe gehoerten einst Krusty dem Clown. Sie sind riesengross und ziemlich "
  "ausgetreten."));
  SetProp (P_NAME, "Paar Krusty-der-Clown-Schuhe");
  SetProp (P_GENDER, NEUTER);
  SetProp (P_WEIGHT, 400);
  SetProp(P_MATERIAL, MAT_LEATHER);
  SetProp (P_VALUE, 800);
  SetProp (P_ARMOUR_TYPE, AT_BOOT);  
  SetProp (P_AC, 5);
   SetProp(P_MATERIAL, MAT_LEATHER);
   SetProp(P_NOBUY, 0);
   
}
