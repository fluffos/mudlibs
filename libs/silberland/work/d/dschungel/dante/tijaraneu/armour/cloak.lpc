// tigerfell.....
// dante sl 97 jaaen danke feyaria

#include "/players/dante/myowndefine.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Side-Show-Bob's Mantel");
  SetProp(P_LONG, BS(
  "Dieser Mantel gehoerte einst Side-Show-Bob, dem Assistenten von Krusty. "
  "Er ist eigentlich nichts besonderes, bunt, etwas abgetragen und ziemlich weit."));  
    
  SetProp(P_NAME, "Side-Show-Bob's Mantel");
  SetProp(P_GENDER, MALE);
  AddId( ({"mantel"}) );
  SetProp(P_NOBUY, 0);
  SetProp(P_ARMOUR_TYPE, AT_CLOAK );
  SetProp(P_AC, 5);
  SetProp(P_MATERIAL, MAT_CLOTH );
  SetProp(P_WEIGHT, 700);
  SetProp(P_VALUE, 700);
}

