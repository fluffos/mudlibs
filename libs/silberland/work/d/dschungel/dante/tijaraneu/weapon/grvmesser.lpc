
inherit "std/weapon";
#include <properties.h>     // Properties definieren
#include <combat.h>         // Kampfspezifische Daten
#include <language.h>       // Definition von MALE, FEMALE, NEUTER, WER, ...
#include <new_skills.h>
#include "/players/dante/myowndefine.h"


create()
{

if (!is_clone(this_object()))
return;
::create();


SetProp (P_NAME, "Graviermesser");
SetProp (P_GENDER, NEUTER);
SetProp (P_VALUE, 222);
SetProp (P_WEIGHT, 100);
SP(P_SIZE, 33);
SetProp (P_WEAPON_TYPE, WT_KNIFE);
SP(P_LONG, BS(
"Das ist ein sehr scharfes und spitzes Graviermesser. "
"Es gehoerte einst Kratz Gravox. Du kannst damit leider nicht umgehen..."));
SP(P_WC_BONUS, (["gravox":200]));
AddId(({"messer","graviermesser"}));
SP(P_NR_HANDS, 1);

SP(P_SHORT, "Ein scharfes Graviermesser");

SetProp (P_DAM_TYPE, ({DT_RIP}));
SetProp (P_WC, 66);
SetProp (P_MATERIAL, ([MAT_STEEL:100]));

}
