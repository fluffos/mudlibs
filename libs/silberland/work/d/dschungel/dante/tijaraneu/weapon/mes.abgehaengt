
inherit "std/weapon";
#include <properties.h>     // Properties definieren
#include <combat.h>         // Kampfspezifische Daten
#include <language.h>       // Definition von MALE, FEMALE, NEUTER, WER, ...
#include <new_skills.h>
#include <moving.h>
#include <wizlevels.h>
#include "/players/dante/myowndefine.h"
#define MAX 3

string *wie;
int i;
int uses=0;

reset()  { ::reset();
uses--; }



create()
{

if (!is_clone(this_object()))
return;
::create();

wie=({
	"klein","winzig","mini",
	"runzelig", "sehr klein",
	"duenn","niedlich"});
	
	

SetProp (P_NAME, "Kastriermesser");
SetProp (P_GENDER, NEUTER);
SetProp (P_VALUE, 777);
SetProp (P_WEIGHT, 100);
SP(P_SIZE, 50);
SetProp (P_WEAPON_TYPE, WT_KNIFE);
SP(P_LONG, BS(
"Du siehst ein spitzes, scharfes Kastriermesser von Kastrator. "
"Mit <kastriere name> kannst Du...Alles klar?!"));
SP(P_WC_BONUS, (["kastrator":200]));
AddId(({"messer","kastriermesser"}));
SP(P_NR_HANDS, 1);

SP(P_SHORT, "Ein scharfes Kastriermesser");

SetProp (P_DAM_TYPE, ({DT_RIP}));
SetProp (P_WC, 100);
SetProp (P_MATERIAL, ([MAT_STEEL:100]));
ACD(({"kastrier","kastriere"}), "do_cut");

}

int do_cut(string str)  {
	object opfer, penis;
       string was;
       int ges;
  NF("Wen willst Du quaelen?!\n");

if( !QueryWielded(TO) )  {
	write(BS(
	"Zueck es lieber!"));
	return 1; }

	
	if(!str)  {
 	write(BS(
 	"Dumm fuchtelst Du mit dem Kastriermesser herum!"));
 	say(BS(
 	CAP_TPN+" fuchtelt dumm mit einem Kastriermesser herum."));
        return 1;
         }


if(uses >= MAX && !IS_WIZARD(TP) )  {
	write(BS(
	"Nein, sooft darfst Du das nicht, warte etwas ab!")); 
	return 1;}

was=str;

opfer=find_living(was);

if(getuid(TP) == was )  {
	write("Nein, Dich selbst willst Du nicht kastrieren!\n");
	say(BS(
	CAP_TPN+" wollte sich kastrieren!"));
	return 1; }
	


if(!opfer)  {
	write(BS(
	CAP(was)+" ist gar nicht da!"));
	say(BS(
 	CAP_TPN+" fuchtelt dumm mit einem Kastriermesser herum."));
	return 1;
}

if( !present(opfer, environment(TP)) ) {
	write(BS(
	"Schau Dich besser um! "+CAP(was)+" ist gar nicht da!"));
	say(BS(
 	CAP_TPN+" fuchtelt dumm mit einem Kastriermesser herum."));
	return 1;
	}

if(!interactive(opfer))	 {
	write(BS(
	"Nein, "+opfer->name(WER)+" laesst sich das nicht gefallen!"));
	say(BS(
 	CAP_TPN+" fuchtelt dumm mit einem Kastriermesser herum."));
 	return 1; }
 
 if(opfer && interactive(opfer) )  {
 	
 	ges=opfer->QP(P_GENDER);
 	
 	if(ges==0  ) {
 		write(BS(
 		opfer->name(WER)+" ist schon saechlichen Geschlechtes. "
 		"Lass es lieber bleiben!"));
 		tell_object(opfer,
 		CAP_TPN+" wollte Dich kastrieren, doch da Du schon "
 		"saechlich bist war das wohl umsonst.\n");
 		tell_room(environment(TP),
              CAP_TPN+" wollte "+opfer->name(WEN)+" kastrieren, "
              "doch "+opfer->name(WER)+" ist schon saechlich...\n",
              ({opfer, TP}));
              return 1; }
             
             if(ges== 2 )  {
 		write(BS(
 		opfer->name(WER)+" ist weiblich. "
 		"Wie soll das funktionieren!"));
 		tell_object(opfer,
 		CAP_TPN+" wollte Dich kastrieren, doch da Du weiblich "
 		"bist funktioniert das nicht so ganz bei Dir.\n");
 		tell_room(environment(TP),
              CAP_TPN+" wollte "+opfer->name(WEN)+" kastrieren, "
              "doch "+opfer->name(WER)+" ist weiblich. Schoener Idiot dieser "+TPN+"!\n",
              ({opfer, TP}));
              return 1; } 
 
 
 	
 	if(ges==1 )  {
 		penis=clone_object("/d/dschungel/dante/tijaraneu/obj/penis");

i=random(sizeof(wie));

penis->SP(P_LONG, BS(
"Das ist der Penis von "+opfer->name(WEM)+"! "+CAP_TPN+" hat ihn mit einem "
"Kastriermesser abgeschnitten. Ziemlich "+wie[i]+", der Penis von "+opfer->name(WEM)+"!"));
 		
 penis->SP(P_SHORT, "Der abgeschnittene "+wie[i]+"e Penis von "+opfer->name(WEM)+"");
 		
 		
 		penis->move(environment(TP), M_NOCHECK);
 	uses++;
 		
 		write(
 		opfer->name(WER)+" schaut erschrocken als Du mit einem\n"
 		"blitzschnellen Schnitt sein bestes Stueck abschneidest!\n"
 		"Blut tropft auf den Boden und faellt direkt neben den\n"
 		"Penis von "+opfer->name(WEN)+"!\n"
 		""+opfer->name(WER)+" bruellt vor Schmerzen auf und redet\n"
 		"auf einmal mit hoher Stimme!*lol*!\nGut gemacht! "
 		"Das Boese ist stolz auf Dich!\n");
 		opfer->SP(P_GENDER, NEUTER);
 		
 		tell_object(opfer,BS(
 		CAP_TPN+" zueckt ein Kastriermesser und schneidet mit einem "
 		"schnellen, sauberen Schnitt Deinen Penis ab! AUA! Das tut weh! "
 		"Du bruellst vor Schmerzen auf und beginnst mit hoher, weiblicher "
 		"Stimme zu weinen. DU Jammerlappen bist nun ein ES! "
 		"Achja, Dein Penis liegt in einer Blutlache am Boden herum!"));
 		opfer->AddHp(-10);
 		
 		tell_room(environment(TP),BS(
 		CAP_TPN+" zueckt ein Kastriermesser und schneidet mit einem "
 		"schnellen, sauberen Schnitt den Penis von "+opfer->name(WEM)+" ab!"
 		"AUA! Das tut weh!"
 		""+opfer->name(WER)+" bruellt vor Schmerzen auf "
 		"und beginnt mit hoher, weiblicher "
 		"Stimme zu weinen. So ein Jammerlappen! Er nun ein ES! "
 		"Achja, der Penis liegt in einer Blutlache am Boden herum!"),
               ({opfer, TP}));
              
              
                   return 1;  }
              
              return 0; }
return 0; }
