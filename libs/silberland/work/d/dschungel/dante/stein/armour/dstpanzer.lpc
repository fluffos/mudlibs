/*
** steinpanzer dante sl jaenner 97
** 
*/

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <wizlevels.h>
#include "files.h"
create()
{
  if (!is_clone(this_object()))
     return;
  ::create();

  AddId (({"panzer","steinpanzer","granitpanzer"}));
  SetProp (P_SHORT, "Ein gigantischer Granitpanzer");
  SetProp (P_LONG, BS("Dieser Panzer gehoerte einst einem gigantischen Steiniganten."
  " Er ist ein hervorragender Schutz."));
  SetProp (P_NAME, "Granitpanzer");
  SetProp (P_GENDER, MALE);
  SetProp (P_WEIGHT, 5000);
  SetProp(P_INFO, ("Der Granitpanzer ist sehr schwer.\n "));
  SetProp (P_VALUE, 4000);
  SetProp (P_MATERIAL, MAT_STONE);
  SetProp (P_ARMOUR_TYPE, AT_ARMOUR); 
  SetProp (P_AC, 38);
  SetProp (P_MATERIAL, MAT_GRANITE);
  SetProp(P_WEAR_RESTRICTIONS, ([A_STR:18]) );
  SetProp(P_QUALITY_DECAY, 88 );
}

