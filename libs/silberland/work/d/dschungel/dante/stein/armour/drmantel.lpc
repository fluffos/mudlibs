inherit "std/armour";
// mantel von dr.creep
#include <language.h>
#include "files.h"     
#include <properties.h>
#include <combat.h>

create()
{
  ::create();
  SetProp(P_SHORT, "Ein weisser Arbeitsmantel");
  SetProp(P_LONG,BS(
  "Das ist der Arbeitsmantel von Dr.Creep. Er ist strahlend weiss und auch "
  "sonst ist an ihm nichts zu erkennen, doch ein kleines Schildchen."));
  SetProp(P_NAME, "Arbeitsmantel");
  AddId(({"arbeitsmantel","mantel"}));
  SetProp(P_GENDER, MALE);
  SetProp(P_WEIGHT, 300);
  SetProp(P_VALUE, 300);
  SetProp(P_AC, 4);
  SetProp(P_ARMOUR_TYPE, AT_CLOAK);
 SetProp(P_MATERIAL, MAT_CLOTH);
 SetProp(P_ARTICLE, 1);
 
 AddDetail(({"schildchen","schild"}),
 "Lies das Schildchen!");
 AddReadDetail(({"schildchen","schild"}),
 "\n"
 "\n"
 "+------------------+\n"
 "|     DR.CREEP     |\n"
 "+------------------+\n");
 }