//haut von tireks
//umhang
#include "files.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein grosses Stueck Haut von Tireks");
  SetProp(P_LONG, BS( 
   "Das ist ein grosses Stueck von Tireks Haut. Es ist ueber und "
   "ueber mit Schuppen bedeckt und gibt sicher einen guten Umhang ab."));
  AddDetail(({"schuppen","schuppe"}),
"Die Schuppen schuetzen Dich sicher sehr gut.");

 SetProp(P_DAM_PROTECTION, QueryProp(P_DAM_PROTECTION)+ ([DT_TERROR:3,
         DT_BLUDGEON:1, DT_SLASH:1, DT_FIRE:1, DT_MAGIC:0]));
  SetProp(P_WEAR_RESTRICTIONS, ([A_STR:15, A_INT:15]));         
  SetProp(P_NAME, "Tirekshaut");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"\ntirekshaut", "tirekshaut", "umhang", "haut"}) );
  SetProp(P_NOBUY, 1);
  SetProp(P_ARMOUR_TYPE, AT_CLOAK );
  SetProp(P_AC, 9);
  SetProp(P_MATERIAL, ({MAT_HORN, MAT_FLESH, MAT_LEATHER}) );
  SetProp(P_WEIGHT, 700);
  SetProp(P_VALUE, 2500);
}


