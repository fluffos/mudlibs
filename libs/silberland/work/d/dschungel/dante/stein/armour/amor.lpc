//wandelpanzer fuer quest eher mies

inherit "std/armour";

#include <properties.h>     /* Definition der Properties */
#include <combat.h>         /* Definition der kampfspezifischen Konstanten */
#include <language.h>       /* Definition von MALE, FEMALE, WER, ... */
#include <new_skills.h>
#include "files.h"


init()
{
  ::init();
  switch(random(5))
     {
     case 0:
     SetProp(P_SHORT, "Ein Schreckenspanzer");
     SetProp(P_LONG, "Das ist ein Schreckenspanzer. Er gehoerte einst einem "
     "schrecklichen Wesen aus Dantes Mutantenlabor.");
     SetProp(P_NAME, "Schreckenspanzer");
     AddId(({"schreckenspanzer","panzer","morph"}));
     break;
     case 1:
   SetProp(P_SHORT, "Ein Brutalopanzer");
     SetProp(P_LONG, "Das ist ein Brutalopanzer. Er gehoerte einst einem "
     "brutalen Wesen aus Dantes Mutantenlabor.");
     SetProp(P_NAME, "Brutalopanzer");
     AddId(({"brutalopanzer","panzer","morph"}));
     break;
     case 2:
      SetProp(P_SHORT, "Ein Terrorpanzer");
     SetProp(P_LONG, "Das ist ein Terrorpanzer. Er gehoerte einst "
     "einem laestigen Wesen aus Dantes Mutantenlabor.");
     SetProp(P_NAME, "Terrorpanzer");
     AddId(({"terrorpanzer","panzer","morph"}));
    break;
    case 3:
     SetProp(P_SHORT, "Ein Angstpanzer");
     SetProp(P_LONG, "Das ist ein Angstpanzer. Er gehoerte einst "
     "einem angsteinfloessendem Wesen aus Dantes Mutantenlabor.");
     SetProp(P_NAME, "Angstpanzer");
     AddId(({"angstpanzer","panzer","morph"}));
    break;
    case 4:
     SetProp(P_SHORT, "Ein Ekelpanzer");
     SetProp(P_LONG, "Das ist ein Ekelpanzer. Er gehoerte einst "
     "einem ekelerregendem Wesen aus Dantes Mutantenlabor.");
     SetProp(P_NAME, "Ekelpanzer");
     AddId(({"ekelpanzer","panzer","morph"}));
    break;
    default: write("BUG!\n");
     }
    
  }
  
create()
{
  if (!is_clone(this_object()))
     return;
  ::create();


  SetProp (P_GENDER, MALE);
  SetProp (P_VALUE, 3000+random(500));
  SetProp(P_WEIGHT, 1000);
  SetProp (P_ARMOUR_TYPE, AT_ARMOUR);
  
  SetProp(P_RESISTANCE_STRENGTHS, ([DT_UNHOLY:-3.0, DT_TERROR:-3.0,DT_HOLY:2.0])); 
  SetProp (P_AC, 35);
  SetProp(P_MATERIAL, ([MAT_SULFUR:10, MAT_OCTARINE:40 ,MAT_MARBLE:30 ,MAT_SALPETER:20, MAT_GHOST:20]));
  SetProp(P_NAME, "Panzer");//ohne den kommt immer du ziehst 0 an, das gleiche
  //gilt fuer die morph waffe
  
   SetProp(P_NOBUY, 1); 
   SetProp(P_WEAR_RESTRICTIONS, ([A_STR:12]) ); 
  SetProp(P_INFO, BS("Dieser Panzer wehrt alles boese recht gut ab.\n"));
}

