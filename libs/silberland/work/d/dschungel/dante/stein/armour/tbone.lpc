//dieser ring wehrt XXXXX ab

inherit "/std/armour";

#define MAXWERT 500
//wie hoch das nun wirklich sein soll
//weiss ich nicht..23 mal geaendert



#include <properties.h>
#include <language.h>
#include <combat.h>
#include <attributes.h>
#include "files.h"

int wert, *help;


create()

{
  if (!is_clone(ME)) return;
  ::create();
  SetProp(P_SHORT, "Ein kleines Stueck von Tireks Schaedel");
  SetProp(P_LONG,BS(
        "Das ist ein Teil des Schaedelknochens von Tireks. Genauer gesagt, ein Teil "
        "seiner Orbita. Er ist ringfoermig, leuchtet leicht roetlich, und scheint "
        "irgendwie mit boeser Magie belegt zu sein..."));
  SetProp(P_NAME,"Schaedelstueck");
  SetProp(P_MATERIAL,([MAT_FLESH:20,MAT_BONE:70,MAT_MISC_MAGIC:10]));
  SetProp(P_GENDER,NEUTER);
  SetProp(P_ARTICLE,1);
  AddDetail("magie",
      "Dunkel, boese, purer Hass.");

  AddId(({"schaedel","ring","stueck", "teil", "schaedelstueck", "orbita", 
        "knochen", "\ntbone"}));
  SetProp(P_WEIGHT,100);
  SetProp(P_VALUE,5000);
  SetProp(P_NOBUY,1);
  SetProp(P_AC,5);
  SetProp(P_INFO, "Das Schaedelstueck wehrt bestimmte Angriffe ab!\n");
  SetProp(P_ARMOUR_TYPE,AT_RING);
  SetProp(P_DEFEND_FUNC, this_object());
  wert=MAXWERT;
  SetProp(P_WEAR_RESTRICTIONS, ([A_INT:18, A_DEX: 15]));

}


int DefendFunc(mixed dam_type,mixed spell,mixed enemy)

{
  object pl,env;
  if (!objectp(pl=QueryProp(P_WORN)))
    return 0;
  if (!pointerp(dam_type)) dam_type=({dam_type});
  if (member(dam_type,DT_TERROR)>=0)

  {
    env=environment(pl);
    wert--;
    tell_object(pl,"Das Stueck von Tireks Schaedel wehrt den Angriff ab!\n");
    tell_object(env,capitalize(pl->name(WESSEN))+" Schaedelstueck wehrt den Angriff ab!\n");
    if (!query_once_interactive(pl))
      return 1000;
  }

  if (wert<=0)

  {
    DoUnwear(1);

    tell_object(pl,
        "Das Schaedelstueck verschwindet wieder zu Tireks!\n");
    call_out("weg",0);
  }
  return 5;
}



reset()

{
  object pl;

  ::reset();
  if (objectp(pl=QueryProp(P_WORN)) && living(pl))
  {
    if (interactive(pl))
      wert+=10;
    if (wert>MAXWERT)
      wert=MAXWERT;
  }
}

void weg()
{
  remove();
}
