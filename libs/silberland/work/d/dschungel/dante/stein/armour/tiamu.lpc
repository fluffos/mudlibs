//amulett schutz gegen tireks!!!!

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

#include "/players/dante/myowndefine.h"


create()
{
  if (!is_clone(this_object()))
     return;
  ::create();
  AddId (({"amulett","steinamulett","TIREKS_AMU"}));
  SetProp (P_SHORT, "Ein schweres Steinamulett");
  SetProp (P_LONG, BS(
"Dieses Amulett gehoerte einst dem Koenig der Steingiganten. "
"Er trug es zum Schutz gegen ein bestimmtes Unwesen."));    
  SetProp (P_NAME, "Steinamulett");
  SetProp (P_GENDER, NEUTER);
  SetProp (P_WEIGHT, 300);
  SetProp (P_VALUE, 5600+random(1000));
  SetProp (P_NOBUY, 1);
  SetProp (P_ARMOUR_TYPE, AT_MISC);
  SetProp (P_AC, 0);
  SetProp(P_INFO, BS(
  "Dieses Amulett schuetzt vor steinernen Angriffen einer "
  "bestimmten Kreatur!"));
  SP(P_MAGIC, 1);
  SetProp(P_MATERIAL, ([MAT_STONE:100]));
}
