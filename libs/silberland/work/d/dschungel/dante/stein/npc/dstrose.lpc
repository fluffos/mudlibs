

inherit "std/mnpc";

#include "files.h"
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <mnpc.h>
create()
{
  int i;
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Steinrose");
  SetProp(P_LONG, (
    "Die Steinrose ist eine lebendige Blume aus Stein. Wie sie leben kann, "
     "weiss keiner so genau im Silberland, aber, dass sie lebt wirst Du merken, "
    "wenn Du sie belaestigst, denn ihre Dornen sind hart und spitz und ihre Blaetter ein guter Schutz."));
  SetProp(P_NAME, "Steinrose");
  SetProp(P_GENDER, FEMALE);
  AddDetail(({"blaetter","blatt"}),
  "Die Blaetter der Steinrose wehren laestige Angreifer wie Dich ab.");
  AddDetail(("blume"),
  "Sie ist das exakte Ebenbild einer normalen Rose, nur ist sie um ein vielfaches groesser.");
  AddId( ({"rose","steinrose"}) );
  AddDetail(({"bild","ebenbild"}),
  "Die Aehnlichkeit ist wirklich verblueffend.");
  
  AddDetail(({"stein"}),
    "Die Steinrose besteht aus hartem Granit...");
    AddDetail(("granit"),
    "Der harte Granit ist ein guter Schutz.");
    AddDetail(({"dorn","dornen"}),
    "Die Dornen der Steinrose sind gute Waffen.");
  create_default_npc(12+random(2));
  SetProp(P_HANDS, ({" mit ihren spitzen Granitdornen", 160+random(50), DT_PIERCE}));
  SetProp(P_MAX_HP, 500+random(50));
  SetProp(P_BODY,110+random(20));
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_XP, 7000*100);
  SetProp(P_RACE, "steinrose");
  SetProp(P_SIZE, 100+random(50));
  SetProp(P_ALIGN, 0);
  SetProp(P_NOCORPSE, 1);
  SetProp(P_MAX_SP, 4000);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_WEIGHT, 20000);
  AddInfo(DEFAULT_INFO, "Die Steinrose kann Dich doch nicht verstehen...\n");
  SetProp(P_REJECT, ({ REJECT_KEEP, 
     "Die Steinrose bleibt einfach nur stumm...\n"}));
  SetProp(P_DIE_MSG, " zerbricht in tausend kleine Steine.\n");
  SetProp(P_MATERIAL,  MAT_STONE);
  SetProp(P_RESISTANCE, ({ DT_BLUDGEON,DT_RIP,DT_PIERCE,DT_SLASH}));
  
 SetProp(P_MMSGIN, "waechst aus dem Boden heraus");
 SetProp(P_MMSGOUT, "verschwindet auf seltsame Weise");
  
  SetProp(P_NOMAGIC, 10+random(10));
  SetProp(P_SPELLRATE, 70+random(10));
  AddSpell(5, 200+random(100), 
   "Die Steinrose bohrt Dir einen Dorn in das Bein.\n",
    "Die Steinrode bohrt @WEM einen Dorn in das Bein.\n",
    DT_PIERCE, ([SP_SHOW_DAMAGE:1]));                                                               
  AddSpell(3, 300+random(100), 
    "Die Steinrose schlitzt Dich beinahe auf.\n",
    "Die Steinrose schlitzt @WEN beinahe auf.\n",
     DT_RIP, ([SP_SHOW_DAMAGE:1]));
  AddSpell(2, 500+random(100),
    "Die Steinrose bohrt Dir einen Dorn ins Auge.\n",
    "Die Steinrose bohrt @WEM einen Dorn ins Auge.\n",
     DT_RIP, ([SP_SHOW_DAMAGE:1]));
  AddSpell(30, 300+random(100),
    "Die Steinrose sprueht Pflanzengift auf Dich.\n",
    "Die Steinrose sprueht Pflanzengift auf @WEN.\n",
     DT_POISON, ([SP_SHOW_DAMAGE:1]));
  

 SetChats(3, ({
    "Die Steinrose bleibt voellig stumm.\n",
    "Die Steinrose scheint zu wachsen...\n",
    "Die Steinrose scheint doch nicht zu leben...\n",
    "Die Steinrose welkt langsam...\n",
    "Die Steinrose zeigt Dir ihre Dornen.\n",
    "Die Steinrose verliert ein Blatt...\n"}) );
    
 SUID;
/*
 CLONEME(WEAPON"ststachel");
*/    
}
