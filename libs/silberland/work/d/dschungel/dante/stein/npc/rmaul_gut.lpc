inherit "std/npc";
#include <npc.h>
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "files.h"


#pragma strong_types;


void init()
{
  ::init();
  if(interactive(TP)) call_out("gag", 0);     
}

void create()
{
  if (!is_clone(TO)) return;
  ::create();

  create_default_npc(10);

  SetProp(P_SHORT, "Ein Riesensteinmaul");
  SetProp(P_LONG,BS(
        "Dieses Riesensteinmaul besteht eigentlich nur aus einem gigantischen Maul. "
        "Mit ihm vernichtet ee alles, was Du willst. Deine Feinde natuerlich nicht! "
        "Nur will das Riesensteinmaul sicher etwas dafuer haben!"));
  SetProp(P_NAME, "Riesensteinmaul");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_ARTICLE,1);
  SetProp(P_HANDS, ({ "mit seinem gigantischen Maul", 300, DT_ACID}));
  AddId( ({ "riesensteinmaul", "steinmaul", "maul" }) );
  SetProp(P_WEIGHT, 9000000);
  SetProp(P_SIZE, 500);
  SetProp(P_RACE, "Steinmaul");
  SetProp(P_ALIGN, 100);
  SetProp(P_INFO, "Das Riesensteinmaul solltest Du besser nicht angreifen!\n");
  SetProp(P_BODY, 200);
  SetProp(P_DEFAULT_INFO, "Ich fresse alles! Frag mich nach Fressen!\n");
  AddInfo("maul",
      "Mit dem kann ich alles fressen!", "sagt: ");
  AddInfo(({"dr.creep","creep"}),
      "Der alte Halsabschneider!", "flucht: ");
  AddInfo("dante",
      "Der kann noch mehr essen als ich!", "grinst: ");
  AddInfo(({"geschwuere","magengeschwuere", "geschwuer","magengeschwuer"}),
      "Naja, das daunernde Fressen von eurem Muell kann ja nicht gesund sein...",
      "jammert: ");
  AddInfo(({"gastritis", "magen"}),
      "Meinem Magen gehts nicht gut, er ist ziemlich empfindlich geworden.",
      "jammert: ");
  AddInfo("fressen",
      "Ich fresse alles auf! Nur kostet es Geld! Schliesslich kostet die Behandlung "
      "meiner Magengeschwuere und Gastritis auch viel! Dr.Creep is ja unverschaemt "
      "teuer! Wenn Du etwas wegefressen haben willst, so geht das mit <fresse objekt>, "
      "wenn Du wissen willst was das kostet so geht das mit <koste objekt>.", "brummt: ");
  AddDetail("maul",
      "Es ist so riesig, dass wenn das Riesensteinmaul Lust dazu haette, es das "
      "gesamte Silberland schlucken koennte. Aber zu unserem Glueck, will es ja nicht...");

  SetChats(5,({
        "Das Riesensteinmaul sagt: Ich fresse alles!\n",
        "Das Riesensteinmaul mault Dich an!\n",
        "Das Riesensteinmaul sagt: Dich fresse Ich auch noch!\n",
        "Das Riesensteinmaul mault herum.\n",
        "Das Riesensteinmaul reisst sein Riesenmaul auf.\n",
        "Das Riesensteinmaul sagt: Verfluchte Gastritis!\n"}));

  SetProp(P_MSGIN, "kommt maulend herein");
  SetProp(P_MSGOUT, "mault weiter");
  SetProp(P_MMSGIN, "kommt laut maulend herein");
  SetProp(P_MMSGOUT, "stampft maulend weit weg");

  AddCmd(({"fresse", "friss"}), "weg");
  AddCmd( ({ "kost", "koste" }), "test" );
}



int Defend(int dam, mixed dam_type, mixed spell, object enemy)  
{
  enemy->StopHuntFor(ME);
  StopHuntFor(enemy);
  call_out("eat", 0);
  return 0;    
}

void eat()
{
  write("Das Riesensteinmaul reisst sein gigantisches Maul auf und verschluckt "
      "Dich einfach. Tja, das haettest Du wohl nicht gedacht...\n");
  say(capitalize(TPN)+" greift das Riesensteinmaul an!\n");
  TP->move("/d/dschungel/dante/stein/room/magen.lpc", M_TPORT,
      "vom Riesensteinmaul einfach verschluckt", "wird",
      "kommt herabgerutscht");
}

int weg(string was)
{
  object ob;
  int amount;
  int rang;
  int cursedcost;

  rang=TP->QueryProp(P_LEVEL);

  notify_fail( "Das Riesensteinmaul sagt: Was soll ich nun fressen!?\n" );

  if (!was || was == "")
    return 0;

  ob = deep_present(was, TP);
  if (!ob)
  {
    write( "Das Riesensteinmaul sagt: Das hast Du doch nicht!!\n");
    return 1;
  }

  if (ob->QueryProp(P_NAME)==("Freundschaftsband"))
  {
    write(BS("Das Riesensteinmaul sagt: Nein! Das Freundschaftsband kann ich "
          +"nicht essen! Deine Freunde waeren alle beleidigt!\n"));
    return 1;
  }

  if (ob->QueryProp(P_NAME)==("Harfe der Winde"))
  {
    write(BS("Das Riesensteinmaul sagt: Nein! Die Harfe der Winde ess ich "
          +"nicht, die liegt mir immer so schwer im Magen!\n"));
    return 1;
  }

  if (ob->QueryProp(P_NAME)==(0))
  {
    write(BS("Das Riesensteinmaul sagt: Nein! Das geht sicher nicht! Haettest "
          +"Du wohl gerne, "+TPN+"!\n"));
    return 1;
  }

  if (ob->QueryProp(P_INVIS)==1) 
  {
    write(BS("Das Riesensteinmaul sagt: Das sehe ich nicht, und Du auch nicht!" 
          +" Und wenn Du es siehst bist Du ein Magier oder ein Irrer!\n"));
    return 1;
  }

  amount = ob->QueryProp(P_VALUE);

  if (amount < 300)
    amount = 300;

  cursedcost= amount*rang;


  if( (TP->QueryMoney() < cursedcost)&&(ob->QueryProp(P_CURSED)==1))
  {
    write(BS("Das Riesensteinmaul sagt: "+ob->name(WER,1)+" ist verflucht! "
          +"Und das hat seinen Grund! Das Fressen von "+ob->name(WEM,1)
          +" kostet "+cursedcost+" Muenzen! Du hast aber nur laecherliche "
          +TP->QueryMoney()+" Muenzen!\n")); 
    return 1;
  }

  if( (TP->QueryMoney() >= cursedcost)&&(ob->QueryProp(P_CURSED)==1))   
  {
    write(BS("Das Riesensteinmaul nimmt Dir "+cursedcost+" Muenzen ab und "
          +"frisst "+ob->name(WEN)+" sofort auf. Danach schmatzt es und "
          +"sagt: Hmm, schmeckt verflucht gut!\n"));
    TP->AddMoney(-cursedcost);
    "/p/daemon/zentralbank"->PayIn(cursedcost, 100); //Geld wird der
    //Zentralbank ueberwiesen, die ist eh immer so pleite
    ob->SetProp(P_CURSED, 0);
    //absichtlich weil sonst immer: du kannst blabla net wegstecken kommt
    ob->remove(1);
    return 1;
  }

  if (TP->QueryMoney() < amount)
  {
    write( BS(
          "Das Riesensteinmaul grinst maulig und sagt danach:\n"
          +TPN+" Du armer Schlucker! Viel Geld hast Du nicht!\n"
          "Das Fressen von "+ob->name(WEM,1)+" kostet Dich "+amount+" Muenzen!\n"
          "Du hast aber nur laecherliche "+TP->QueryMoney()+" Muenzen!\n")); 
    return 1;
  }

  if (TP->QueryMoney() >= amount)
  {
    write("Das Riesensteinmaul nimmt Dir "+amount+" Muenzen ab und frisst "
        +ob->name(WEN)+"\nsofort auf.\n"
        "Danach schmatzt es, ruelpst und schaut noch immer hungrig drein!\n");
    TP->AddMoney(-amount);
    "/p/daemon/zentralbank"->PayIn(amount, 100);
    ob->remove(1);
    return 1;
  }

  return 0;
}

int test(string was)
{
  object ob;
  int preis;
  int rang;
  int cursedpreis;
  rang=TP->QueryProp(P_LEVEL);

  notify_fail( "Das Riesensteinmaulsagt: Was soll ich den kosten?\n" );

  if (!was || was == "")
    return 0;

  ob =deep_present(was, TP);
  if (!ob)
  {
    notify_fail( "Das Riesensteinmaul brummt: Sowas hast Du nicht!\n");
    return 0;
  }

  if (ob->QueryProp(P_INVIS)==1)
  {
    notify_fail(BS("Das Riesensteinmaul sagt: Das kann ich nicht sehen und Du "
          +"auch nicht! Entweder bist Du irr oder Magier oder "
          +"beides!\n"));
    return 0;
  }

  if (ob->QueryProp(P_NAME)==(0))
  {
    write("Das Riesensteinmaul sagt: Nein! Das geht sicher nicht! \n"
        "                          Haettest Du wohl gerne, "+TPN+"!\n");
    return 1;
  }

  if (ob->QueryProp(P_NAME)==("Freundschaftsband"))
  {
    write(BS("Das Riesensteinmaul sagt: Nein! Das Freundschaftsband kann ich "
          +"nicht kosten! Deine Freunde waeren alle beleidigt! Ausserdem "
          +"schmeckt das schlecht!\n"));
    return 1;
  }

  if (ob->QueryProp(P_NAME)==("Harfe der Winde"))
  {
    write(BS("Das Riesensteinmaul sagt: Nein! Die Harfe der Winde koste ich "
          "nicht! Die liegt mir immer so schwer im Magen!\n"));
    return 1;
  }

  preis=ob->QueryProp(P_VALUE);

  if (preis < 500)
    preis = 500;

  cursedpreis=rang*preis;  

  if (ob->QueryProp(P_CURSED)==1)      
  {
    write("Das Riesensteinmaul sagt: "+ob->name(WER,1)+" ist verflucht! Und das hat seinen Grund!\n"
        "Das Fressen "+ob->name(WESSEN,1)+" kostet Dich "+cursedpreis+" Muenzen!\n");
    return 1;
  }

  write( break_string( "Wenn ich "+ob->name(WEN,1)+" fressen soll, wird Dich "
        +"das "+preis+" Muenzen kosten.", 70, "Das Riesensteinmaul sagt: ") );
  return 1;
}

gag()
{  
  string *namen;
  int i;

  namen = TP->QueryProp("friends");
  if(!sizeof(namen)) 
    write(BS("Das Riesensteinmaul laestert: Du hast ja gar keine Freunde!\n"));
  else
  {
    write("Das Riesensteinmaul lacht Dich aus und sagt:\n"
        "WAEH! Du bist eklig! Du bist ja befreundet mit:\n");

    for (i=sizeof(namen)-1;i>=0;i--)
      write(sprintf( "%s", capitalize(namen[i]))+(i==0?" !":", ")); 
    write("\nDas sind doch alles Idioten und Stinker!\n");
    printf(capitalize( namen[random(sizeof(namen))]));
    printf(" ist besonders doof!\n");
  }
}          

