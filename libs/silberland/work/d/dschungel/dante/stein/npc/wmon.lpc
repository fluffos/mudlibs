
// dante november 97

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "files.h"
#include <npc.h>

 void  init()
  {
  ::init();
   switch(random(4))
    {
    case 0:
     
  SetProp(P_SHORT, "Ein Cosinusmonster");
  SetProp(P_LONG, BS(
  "Das ist ein Cosinusmonster"));
  SetProp(P_NAME, "Cosinusmonster");
    break;
     
     case 1:
     
  SetProp(P_SHORT, "Ein Sinusmonster");
  SetProp(P_LONG, BS(
  "Das ist ein Sinusmonster"));
  SetProp(P_NAME, "Sinusmonster");
  break;
  case 2:
  
  SetProp(P_SHORT, "Ein Tangensmonster");
  SetProp(P_LONG, BS(
  "Das ist ein Tangensmonster"));
  SetProp(P_NAME, "Tangensmonster");
  break;
  case 3:
  
  SetProp(P_SHORT, "Ein Cotangensmonster");
  SetProp(P_LONG, BS(
  "Das ist ein Cotangensmonster"));
  SetProp(P_NAME, "Cotangensmonster");
  break;
  
  default: write("BUG!\n");
    }
 }
    

void create()

 

{
 
  if (!is_clone(TO)) return;
  ::create();
  
  SetProp(P_GENDER, NEUTER);
    AddId(({"monster","cosinusmonster","cotangensmonster","sinusmonster","tangensmonster"}));
  create_default_npc(10);
  
  SetProp(P_WIMPY,0);
  
  SetProp(P_HANDS, ({" mit mieser Algebra",150+random(30),({DT_MAGIC}) }));
  SetProp(P_BODY, 20+random(10));
  SetProp(P_SIZE, 70);
  SetProp(P_ALIGN, -300);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,1);
  SetProp(P_NOMAGIC,10);
  
  
  SetProp(P_MSGIN, "springt aus den Winkeln hervor");
  SetProp(P_MSGOUT, "dividiert sich");
  SetProp(P_MMSGIN, "multipliziert sich herein");
  SetProp(P_MMSGOUT, "multipliziert sich weit weg");

  SetProp(P_DIE_MSG,  " multipliziert sich ins Reich der Algebra.\n");
  SetProp(P_NOCORPSE, 1 );
  SetProp(P_MURDER_MSG, "Dich dividiere ich noch immer weg!");
  SetProp(P_KILL_NAME, "Ein Winkelfunktionsmonster");
  SetProp(P_KILL_MSG, "Du bist dafuer in Mathematik durchgefallen!\n");


 }
