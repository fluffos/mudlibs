//2 haendiges wesen, das auch abwechselnd so kaempft

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

int ork;

create()
{
    if (!is_clone(TO)) return;
    ::create();
    
    SetProp(P_SHORT,"Ein dantemesisches Orkzwillingspaar");
    SetProp(P_LONG,BS(
    "Dieses dantemesisches Orkzwillingspaar stammt aus Dantes Mutantenlabor. "
    "Es hat vier Beine, vier arme und auch zwei Koepfe. Warum es hier eingesperrt "
    "ist , weiss keiner so genau. Auf jeden Fall haengen die beiden aber in der MItte zusammen und sind so gezwungen, alles gemeinsam zu machen."));
    
    SetProp(P_NAME,"Orkzwillingspaar");
    AddId(({"ork","orks","orkwillinge","orkzwillingspaar"}));
    create_default_npc(15);
    SetProp(P_ALIGN,-100);
    SetProp(P_GENDER,NEUTER);
    SetProp(P_BODY, 60);
    SetProp(P_SIZE,160);
    SetProp(P_MAX_HANDS,4);
    SetProp(P_RACE,"Ork");
    SetProp(P_NOMAGIC, 5);
    SetProp(P_HEAL, 5);
    SetProp(P_WEIGHT, 20000);
    SetProp(P_AGGRESSIVE, 1);
    SetProp(P_INFO, ("Das Orkzwillingspaar ist wirklich etwas sehr seltsames. \n"));
    SetProp( P_RESISTANCE_STRENGTHS,([DT_BLUDGEON: -1.0, DT_SLASH:-1.0, DT_MAGIC:0.5,
    DT_FIRE: 1.0, DT_HOLY: 2.0, DT_ACID: 2.0]));

  SetProp(P_MSGIN, "wird hereingeworfen");
    SetProp(P_MSGOUT, "wackelt weg");
      SetProp(P_MMSGIN, "wird hereingeworfen");
        SetProp(P_MMSGOUT,  "taumelt davon");
    SetProp(P_SPELLRATE, 30);
    SetProp(P_DIE_MSG, " stirbt einen doppelten TOD.\n");
    SetProp(P_KILL_MSG, " sagt: Freut und doppelt.\n");

     AddInfo(DEFAULT_INFO, (
     "sagt: Halt doppelt das Maul.\n"));
       SetProp( P_REJECT, ({ REJECT_KEEP,
       "Das Orkzwillingspaerchen sagt: Wir wollen das zweimal haben!\n"}));

 AddSpell(2, 200,
   "Der linke Ork will Dir Dein linkes Ohr ausreissen.\n",
     "Der linke Ohr will @WESSEN linkes Ohr ausreisen.\n",
        DT_TERROR, ([SP_SHOW_DAMAGE:1]));
 AddSpell(2, 200,
   "Der rechte Ork will Dir Dein rechtes Ohr ausreissen.\n",
     "Der rechte Ohr will @WESSEN rechtes Ohr ausreisen.\n",
        DT_TERROR, ([SP_SHOW_DAMAGE:1]));
 AddSpell(2, 300,
   "Der rechte Ork versucht Dir Dein rechtes Auge zu zerquetschen.\n",
     "Der rechte Ork versucht @WESSEN rechtes Auge zu zerquetschen.\n",
        DT_SQUEEZE, ([SP_SHOW_DAMAGE:1]));
 AddSpell(2, 300,
   "Der linke Ork versucht Dir Dein linkes Auge zu zerquetschen.\n",
     "Der linke Ork versucht @WESSEN linkes Auge zu zerquetschen.\n",
        DT_RIP, ([SP_SHOW_DAMAGE:1]));
 AddSpell(2, 300,
   "Der linke Ork versucht Dir Deinen linken Arm auszureissen.\n",
     "Der linke Ork versucht @WEM den linken Arm auszureissen.\n",
        DT_RIP, ([SP_SHOW_DAMAGE:1]));
    AddSpell(2, 300,
   "Der rechte Ork versucht Dir Deinen rechten Arm auszureissen.\n",
     "Der rechte Ork versucht @WEM den rechten Arm auszureissen.\n",
        DT_RIP, ([SP_SHOW_DAMAGE:1]));

    ork = 0;
}


heart_beat()
{
  ::heart_beat();
    return ::heart_beat();
  }

Attack(object enemy)
{
  SetProp(P_HANDS,({" mit dem "+((ork=!ork)?"linkem":"rechtem")+" Ork", 170+random(20),({DT_BLUDGEON,DT_UNHOLY}) }));
  return ::Attack(enemy);
}
