//eine seifenblase
#include "/players/dante/myowndefine.h"

inherit "std/mnpc";
inherit "std/npc/sequencer";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <mnpc.h>


void reset()
{
  ::reset();
  if (!is_clone(ME)) return;
  if(environment(TO)) 
    tell_object(environment(TO), "Die Seifenblase zerplatzt.\n");
  remove();
}

void create()
{
  if (!is_clone(ME)) return;
  ::create();
  SetProp (P_SHORT, "Eine Seifenblase");
  SetProp (P_LONG, BS(
        "Das ist eine Seifenblase, erzeugt aus einer magischen Kristallblase. "
        "Sie schimmert in bunten Farben und ist fast total durchsichtig."));
  SetProp (P_NAME, "Seifenblase");
  SetProp (P_GENDER, FEMALE);
  SetProp(P_RACE, "Seifenblase");
  AddId (({"blase", "seifenblase"}));
  create_default_npc (1);
  SetProp (P_SIZE, 10);
  SetProp (P_HEAL, 0);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10, T_RANGE_MAX: 45]));   

  SetProp (P_MSGIN, "schwebt sanft herein");
  SetProp(P_MMSGIN, "schwebt sanft aus der Kristallblase heraus");   
  SetProp(P_MSGOUT,"schwebt sanft");
  SetProp(P_MMSGOUT, "schwebt weit weg");
  SetProp(P_MNPC_AREA, "/" );
  SetProp(P_MNPC_WAIT, ({ 10, 10, 10 }));
  SetProp(P_MNPC_DEFAULTROOM, "/players/dante/workroom");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES+MOV_INDOORS+MOV_SPECIAL+MOV_BACKWARDS );
  SetProp(P_NOATTACK, "ist so nicht zu zerstoeren!\n");

  SetProp (P_ALIGN, 20);
  SetProp(P_DIE_MSG, " schwebt weit weg.\n");

  SC(10,({
        "Die Seifenblase schwebt sanft nach oben.\n",
        "Die Seifenblase schwebt sanft nach unten.\n",
        "Die Seifenblase beruehrt ganz leicht Deine Nase.\n",
        "Die Seifenblase schmimmert hell.\n",
        "Die Seifenblase blitzt im Licht auf.\n",
        "Du kannst Dich in der Seifenblase spiegeln.\n",
        "Die Farben der Seifenblase sind wunderschoen.\n",
        "Die Seifenblase reflektiert das Licht.\n",
        "Die Seifenblase zerlegt das Licht in viele bunte Einzelstrahlen.\n",
        "Die Seifenblase schwebt ueber Deinem Kopf.\n"}));

}
