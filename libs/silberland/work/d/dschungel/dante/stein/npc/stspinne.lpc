//dante dante tante dante 97


inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <combat.h>
#include <mnpc.h>
#include <new_skills.h>
#include "files.h"




create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT, "Eine Granitspinne");
  SetProp(P_LONG, BS("Die Granitspinne besteht voellig aus Stein und muss ein "
           "enormes Gewicht haben. Sie bewegt sich aber "
           +"trotzdem erstaunlich leichtfuessig..."));
   
  SetProp(P_NAME,"Granitspinne");
  AddId(({"spinne", "steinspinne","granitspinne"}));
  SetProp(P_GENDER, FEMALE);
  create_default_npc(11);
  SetProp(P_MAX_HANDS, 8);
  SetProp(P_HANDS, ({" mit Steinzangen", 110+random(20), DT_SQUEEZE,DT_BLUDGEON}));
  SetProp(P_BODY, 90+random(20));
  SetProp(P_ALIGN, 0);
  SetProp(P_SIZE, 200+random(100));
  SetProp(P_RACE, "Spinne");
  SetProp(P_MATERIAL, MAT_STONE);
  SetProp(P_WEIGHT, 200000);
  SetProp(P_RESISTANCE, ({DT_COLD, DT_PIERCE,DT_WATER}));
  SetProp(P_NOCORPSE, 0);
  SetProp( P_REJECT, ({ REJECT_DROP, "Die Granitspinne beachtet es nicht.\n" }) );
  SetProp( P_DIE_MSG, " bricht mit lautem Krachen nieder.\n");
  
  SetProp(P_MSGIN, "krabbelt herein");
  SetProp(P_MMSGIN, "krabbelt herein");
  SetProp(P_MMSGOUT, "krabbelt hinaus");
  SetProp(P_MSGOUT, "krabbelt");

  SetChats(3, ({
  "Die Spinne beachtet Dich nicht.\n",
  "Die Spinne bewegt sich erstaunlich schnell...\n",
  "Die Spinne rennt Dich fast um.\n",
  "Die Spinne frisst einen Stein.\n",
    "Die Spinne knabbert am Felsen.\n",
    "Die Spinne krabbelt unruhig umher.\n"}) );
    
  SetProp(P_NOMAGIC, 10+random(10));
  SetProp(P_SPELLRATE, 30);
  AddSpell(3,250+random(50),
	" Die Spinne beisst Dich in eine ungeschuetzte Stelle.\n",
	" Die Spinne beisst @WEN in eine ungeschuetzte Stelle.\n",
          DT_POISON,([SP_SHOW_DAMAGE:1]));

  AddSpell(4,200+random(50), 
        " Die Spinne schleudert Dir ein Steinnetz ins Gesicht.\n", 
        " Die Spinne schleudert Dir ein Steinnetz ins Gesicht.\n",
          DT_SLASH,([SP_SHOW_DAMAGE:1]));
 AddSpell(1,500+random(50), 
        " Die Spinne versucht Dich mit ihrem Gewicht zu zerquetschen.\n", 
        " Die Spinne versucht @WEN mit ihrem Gewicht zu zerquetschen.\n",
          DT_SQUEEZE,([SP_SHOW_DAMAGE:1]));
 AddSpell(4,200+random(50), 
        " Die Spinne trifft Dich mit ihren Zangen am Bein.\n", 
        " Die Spinne trifft @WEN mit ihren Zangen am Bein.\n",
          DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));
                    
  SetProp(P_MNPC_AREA, "/d/dschungel/dante/stein/room/stein");
  SetProp(P_MNPC_WAIT, ({ 10, 20, 20 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "stein3" );
  SetProp (P_MNPC_FLAGS, MOV_INDOORS + MOV_MOVES + MOV_BACKWARDS);
}

