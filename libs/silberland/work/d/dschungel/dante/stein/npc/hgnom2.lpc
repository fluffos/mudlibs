//umgebaut erweiter august dante 2.april     @SilberLand

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"
void create()
{
  object ob;
  
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein frecher Hoehlengnom");
  SetProp(P_LONG, BS(
    "Der Hoehlengnom ist ein kleines, aber sehr kraeftiges Wesen. Seine dunklen "
    "Augen funkeln Dich hinterlistig an. Du solltest Dich vor ihm in Acht nehmen..."));

  AddDetail(({"auge","augen"}),
  "Dunkel und hinterlistig blinzeln Dich die Augen des Hoehlengnoms an.");
    
  SetProp(P_NAME, "Hoehlengnom");
  SetProp(P_GENDER, MALE);
  AddId(({"gnom", "hoehlengnom"}));
  SetProp(P_RACE, "Gnom");

  create_default_npc(18);
  SetProp(P_HANDS, ({" mit seinen dreckigen Klauen",140+random(30),({DT_UNHOLY,DT_TERROR,DT_BLUDGEON}) }));
  SetProp(P_SIZE, 120+random(30));
  SetProp(P_ALIGN, -300);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_RESISTANCE, ({ DT_TERROR,DT_UNHOLY })); 
  SetProp(P_VULNERABILITY, ({ DT_HOLY }));
  SetProp(P_NOMAGIC,3);
  
  SetProp(P_MSGIN, "schlurft herein");
  SetProp(P_MSGOUT, "schlurft");
  SetProp(P_MMSGIN, "schlurft herein");
  SetProp(P_MMSGOUT, "schlurft davon");

  SetProp(P_DIE_MSG,  " grinst Dich noch einmal frech an und faellt dann tot um.\n");
  SetProp(P_NOCORPSE, 0 );
  
  AddSpell(2,200,
  "Ploetzlich ueberkommt Dich ein Anflug von Frieden und Ruhe.\n",
  "Ploetzlich ueberkommt @WEN ein Anflug von Frieden und Ruhe.\n",  
  DT_MAGIC,"spell_paralyse");
  
  AddInfo("waffe", "Du meinst den Wandler...", "sagt: ");
  AddInfo(DEFAULT_INFO, "spuckt Dich an.\n");
  AddInfo("dante", "Dante hat mich erschaffen.","sagt: ");
  AddInfo("hoehle", "Mir gefaellt sie gut.","sagt: ");
  AddInfo("monster", "Du meinst Tireks.","sagt: ");
  AddInfo("jojo",
  "Tja, ich kann Dir schon helfen, aber dafuer musst Du mir einen grossen Gefallen erweisen!","sagt: ");
  AddInfo("gefallen",
  "Als es geht um...", "sagt: ");
  //NICHT FERTIG!!!!!!!!!!!!!!!
  
  
  AddInfo("tireks", "Er ist eigentlich ganz nett zu mir. Wir haben eine Vereinbarung","sagt: ");
  AddInfo("vereinbarung", "Naja, er tut mir nichts und ich ihm nichts!","lacht: ");
  SetProp( P_REJECT, ({ REJECT_KEEP,
    "Der Hoehlengnom schreit: Gib mir Deine Muenzen!\n" }) );

  SetProp(P_SPELLRATE,90);
  
  AddSpell(5,300,
    "Der Hoehlengnom erschreckt Dich fast zu Tode.\n",
    "Der Hoehlengnom erschreckt @WEN fast zu Tode.\n",
     DT_TERROR,([SP_SHOW_DAMAGE:1]));
 AddSpell(3,300,
    "Der Hoehlengnom verflucht Dich lauthals.\n",
    "Der Hoehlengnom verflucht @WEN lauthals.\n",
     DT_UNHOLY,([SP_SHOW_DAMAGE:1]));
   AddSpell(3,300,
  "Der Hoehlengnom spuckt Dir in die Augen.\n",
  "Der Hoehlengnom spuckt @WEM in die Augen.\n",
     DT_ACID,([SP_SHOW_DAMAGE:1]));
     AddSpell(2,400,
  "Der Hoehlengnom stopft Dir Steine in den Mund.\n",
  "Der Hoehlengnom stopft @WEM Steine in den Mund.\n",
     DT_TERROR,([SP_SHOW_DAMAGE:1]));

SetProp(P_TRANSPARENT, 0);
     
  SetChats(3, ({
  "Der Hoehlengnom grinst Dich boesartig an.\n",
  "Der Hoehlengnom scheint etwas auszuhecken...\n",
  "Der Hoehlengnom lacht laut.\n",
  "Der Hoehlengnom zieht Dich an der Nase.\n",
  "Der Hoehlengnom kratzt seinen Buckel.\n",
  "Der Hoehlengnom wuehlt im Boden.\n", 
  "Der Hoehlengnom stinkt ziemlich.\n"}) );
  
  SetAttackChats(10, ({
  "Der Hoehlengnom tritt Dich.\n",
  "Der Hoehlengnom schreit laut.\n",
  "Der Hoehlengnom will fluechten.\n"}) );


SUID;

  if(ob=clone_object("/d/dschungel/dante/stein/obj/antireks"))
    ob->move(this_object(),2);

}

  void spell_paralyse(object enemy, int damage, mixed dam_type)
  {
   switch(random(100))
   {
   case 0 .. 30 :
    tell_object(enemy,
    "Du kannst dem Zauber zum Glueck widerstehen.\n");
    break;
    
   case 31 .. 50 :
    tell_object(enemy,
    "Du hoerst kurz auf zu kaempfen und schaust den Gnom friedlich an.\n");
    enemy->SetProp(P_DISABLE_ATTACK, 1);
    break;
    
   case 51 .. 80 :
    tell_object(enemy,
    "Du stehst voellig friedlich und ruhig vor dem Hoehlengnom.\n");
    enemy->SetProp(P_DISABLE_ATTACK, 2);
    break;
    
    case 81 .. 100 :
    tell_object(enemy,
    "Du spuerst das starke Verlangen den Hoehlengom zu kuessen.\n");
    enemy->SetProp(P_DISABLE_ATTACK, 3);
    
    }
   }
   

