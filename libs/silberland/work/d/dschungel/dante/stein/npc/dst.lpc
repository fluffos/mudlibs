

inherit "std/mnpc";

#include "files.h"
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <mnpc.h>
create()
{
  int i;
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein lebendiger Stein");
  SetProp(P_LONG, (
    "Du traust Deinen Augen nicht, aber dieser Stein lebt wirklich. "
    "Frech grinst er Dich aus seinem grossen Maul an und seine steineren "
    "Augen funkeln Dich nur so an. Seine groessten Feinde sind die "
    "Steingiganten, die ihn zum fressen gerne haben."));
  SetProp(P_NAME, "Stein");
  SetProp(P_GENDER, MALE);
  AddDetail(("maul"),
  "In seinem grossen Maul sieht man spitze Zaehne aus Granit...");
  AddId( ({"stein"}) );
  AddDetail(({"feind","feinde"}),
  "Die lebendigen Steine sind immer auf der Flucht vor den Steingiganten.");
  AddDetail(({"zahn","zaehne"}),
    "Die Zaehne blitzen Dich bedrohlich an...");
    AddDetail(("granit"),
    "Der harte Granit ist ein guter Schutz.");
    AddDetail(({"augen","auge"}),
    "Die steinernen Augen schauen Dich unfreundlich an.");
  create_default_npc(12);
  SetProp(P_HANDS, ({" mit seinen spitzen Granitzaehnen", 110+random(20), DT_BLUDGEON}));
  SetProp(P_AGGRESSIVE, 0.01);
  SetProp(P_RACE, "stein");
  SetProp(P_SIZE, 50+random(100));
  SetProp(P_ALIGN, -200);
  SetProp(P_NOCORPSE, 1);
  SetProp(P_MAX_HANDS, 0);
  AddInfo(DEFAULT_INFO, "Der lebendige Stein schaut Dich nur boese an.\n");
  SetProp(P_REJECT, ({ REJECT_DROP, 
     "Was soll ein Stein damit...\n"}));
  SetProp(P_DIE_MSG, " zerbricht in tausend kleine Steine.\n");
  SetProp(P_INFO, ("Die lebendigen Steine sind voellig unberechenbar..."));
  SetProp(P_RESISTANCE, ({ DT_BLUDGEON,DT_RIP,DT_PIERCE,DT_SLASH}));
  
 SetProp(P_MSGIN, "rollt laut krachend herein");
 SetProp(P_MSGOUT, "rollt laut krachend");
 SetProp(P_MMSGIN, "rollt laut krachend herein");
 SetProp(P_MMSGOUT, "rollt laut krachend weit weg");
 SetProp(P_MNPC_WAIT, ({10+random(10), 15, 15}));
 SetProp(P_MNPC_AREA, ROOM "stein");
 SetProp(P_MNPC_DEFAULTROOM, ROOM "stein7");
 SetProp(P_MNPC_FLAGS, MOV_MOVES + MOV_INDOORS + MOV_BACKWARDS ); 
  
  SetProp(P_NOMAGIC, 3);
  SetProp(P_SPELLRATE, 50);
  AddSpell(5, 100+random(50), 
   "Der lebendige Stein zertruemmert Deinen Arm.\n",
    "Der lebendige Stein zertruemmert @WESSEN Arm.\n",
    DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));                                                               
  AddSpell(2, 300, 
    "Der lebendige Stein schleudert Felsbloecke nach Dir.\n",
    "Der lebendige Stein schleudert Felsbloecke nach @WEM.\n",
     DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));
  AddSpell(2, 300,
    "Der lebendige Stein beisst Dir in die Waden.\n",
    "Die lebendige Stein beisst @WEM in die Waden.\n",
     DT_RIP, ([SP_SHOW_DAMAGE:1]));
  AddSpell(1, 400,
    "Der lebendige Stein zerquestscht Dich an der Wand.\n",
    "Der lebendige Stein zerquetscht @WEN an der Wand.\n",
     DT_SQUEEZE, ([SP_SHOW_DAMAGE:1]));
  

 SetChats(2, ({
    "Der lebendige Stein kaut einen Stein.\n",
    "Der lebendige Stein grinst boese.\n",
    "Der lebendige Stein lacht ueber Dich.\n",
    "Der lebendige Stein sagt: Los, hau ab!\n",
    "Der lebendige Stein tritt Dir ins Schienbein.\n",
    "Der lebendige Stein rollt ueber Deinen Zeh.\n",
    "Der lebendige Stein rollt umher.\n",
    "Der lebendige Stein ueberrollt Dich fast.\n",
    "Der lebendige Stein will Dich zerquetschen'\n",
    "Der lebendige Stein sagt: Ich hasse die Steinbeisser.\n"}));

 SetAttackChats(20, ({
    "Der lebendige Stein kaut einen Stein.\n",
    "Der lebendige Stein grinst boese.\n",
    "Der lebendige Stein lacht ueber Dich.\n",
    "Der lebendige Stein sagt: Los, hau ab!\n",
    "Der lebendige Stein tritt Dir ins Schienbein.\n",
    "Der lebendige Stein rollt ueber Deinen Zeh.\n",
    "Der lebendige Stein rollt umher.\n",
    "Der lebendige Stein ueberrollt Dich fast.\n",
    "Der lebendige Stein will Dich zerquetschen'\n",
    "Der lebendige Stein sagt: Ich hasse die Steinbeisser.\n"}));
    
}
