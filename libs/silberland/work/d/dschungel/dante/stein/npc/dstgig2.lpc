

inherit "std/mnpc";

#include "files.h"
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <mnpc.h>
#include <new_skills.h>
create()
{
  int i;
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein mittlerer Steingigant");
  SetProp(P_LONG, (
        "Der mittlere Steingigant besteht aus purem Granit. Seine steinerne Haut "
        "schuetzt ihn vor laestigen Angreifern, die er mit seinen gewaltigen "
        "Faeusten zermalmt. Eigentlich ist er aber ein gutmuetiger Geselle.\n"));
  SetProp(P_NAME, "Steingigant");
  SetProp(P_GENDER, MALE);
  AddDetail(("granit"),
      "Granit, Granit , er besteht eben nur aus Granit...\n");
  AddId( ({"gigant", "steingigant"}) );
  AddDetail(({"faust","faeuste"}),
      "Die Faeuste des Steingiganten solltest Du besser niemals zu spueren bekommen.\n");
  AddDetail(("haut"),
      "Die harte Haut des Steingiganten ist ein hervorragender Schutz.\n");
  SetProp(P_MATERIAL, MAT_STONE);
  create_default_npc(15);
  SetProp(P_HANDS, ({" mit seinen steinernen Faeusten", 200, DT_BLUDGEON}));
  SetProp(P_BODY, 100+random(10));
  SetProp(P_RACE, "Gigant");
  SetProp(P_SIZE, 300+random(20));
  SetProp(P_ALIGN, 100);
  SetProp(P_MAX_HANDS, 2);
  AddInfo(DEFAULT_INFO, "Der Steingigant sagt: Steine schmecken mir so gut.\n");
  SetProp(P_REJECT, ({ REJECT_KEEP, 
        "Der Steingigant sagt: Naja, Steine habe ich lieber.\n"}));
  SetProp(P_DIE_MSG, " faellt mit lautem Getoese zu Boden.\n");
  SetProp(P_INFO, ("Dieser Steingigant ist kleiner als  seine grossen Brueder.\n"));
  SetProp(P_RESISTANCE, ({ DT_BLUDGEON,DT_RIP,DT_PIERCE,DT_SLASH}));


  SetProp(P_MSGIN, "stampft polternd herein");
  SetProp(P_MMSGIN, "stampft laut polternd herein");
  SetProp(P_MMSGOUT, "stampft laut polternd davon");
  SetProp(P_MSGOUT, "stampft polternd");
  SetProp(P_MNPC_AREA, ROOM "stein");
  SetProp(P_MNPC_WAIT, ({5,15,10}));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "stein7");
  SetProp(P_MNPC_FLAGS, MOV_MOVES + MOV_BACKWARDS + MOV_INDOORS);


  SetProp(P_NOMAGIC, 10);
  SetProp(P_SPELLRATE, 60);
  AddSpell(5, 250, 
      "Der Steingigant zertruemmert Deinen Arm.\n",
      "Der Steingigant zertruemmert @WESSEN Arm.\n",
      DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));                                                               
  AddSpell(2, 350, 
      "Der Steingigant schleudert Felsbloecke nach Dir.\n",
      "Der Steingigant schleudert Felsbloecke nach @WEM.\n",
      DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));
  AddSpell(5, 350,
      "Die Faust des Steingiganten schlaegt auf Deinen Schaedel.\n",
      "Die Faust des Steingiganten schlaegt auf @WESSEN Schaedel.\n",
      DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));
  AddSpell(1, 550,
      "Der Steingigant zerquestscht Dich an der Wand.\n",
      "Der Steingigant zerquetscht @WEN an der Wand.\n",
      DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));


  SetChats(4, ({
        "Der Steingigant kaut einen Stein.\n",
        "Der Steingigant laechelt freundlich.\n",
        "Der Steingigant lacht ueber Dich.\n",
        "Der Steingigant sagt: Stein ist alles was ich liebe.\n",
        "Der Steingigant jongliert mit Felsen.\n",
        "Der Steingigant beisst in die Felswand.\n",
        "Der Steingigant zermalmt einen grossen Stein.\n",
        "Der Steingigant kegelt mit Felsen.\n",
        "Der Steingigant singt 'Granit, oh Du mein Granit...'\n",
        "Der Steingigant wirft ein kleines Steinchen nach Dir.\n"}));
  SetAttackChats(20, ({
        "Der Steingigant lacht ueber Deine Ausruestung.\n",
        "Der Steingigant versucht Dich zu zermalmen.\n",
        "Der Steingigant ruft seine grossen Brueder zu Hilfe.\n",
        "Der Steingigant schlaegt mit der Faust nach Dir.\n",
        "Du beginnst zu taummeln.\n",
        "Der Steingigant zerquestscht Dich fast.\n"}));



  AddInfo(({"priester","kannibalenpriester"}),
      "fluestert: Hihi, der ist ja nur aus Fleich und Blut!\n");
  AddInfo("dante",
      "sagt: Dante hat ein herz aus Stein!\n");   
  AddInfo(({"kannibalen","kannibale"}),
      "sagt: Die wissen ja nicht wie gut Steine schmecken.\n");
  AddInfo("dschungel",
      "sagt: Der Dschungel ist leider viel zu wenig aus Stein.\n");
  AddInfo("feyaria",
      "sagt: Sie ist die Herrin des Dschungels.");   
  AddInfo("silberland",
      "sagt: Der Dschungel ist das schoenste Gebiet im Silberland.");   
  AddInfo("pyramide",
      "sagt: Ja! Viele grosse Steine.\n");
  AddInfo("stein",
      "sagt: Hmm, die schmecken ja so gut...\n");
  AddInfo("granit",
      "sagt: Eben mein Fleisch und Blut.\n");
  AddInfo("steine",
      "lacht froh...\n");
  AddInfo("pflanzen",
      "sagt: Hmm, versteinerte Pflanzen habe ich lieber!");
  AddInfo("tijara",
      "sagt: da gibts viele Steine.");
  AddInfo("gigant",
      "sagt: Ich bin einer!\n");
  AddInfo(("steingigant"),
      "lacht und sagt: Na warte bis Du meine grossen Brueder kennenlernst.\n");
  AddInfo("bruder",
      "sagt: Soll ich einen holen?\n");
  AddInfo("tiere",
      "sagt: Naja, Steine habe ich eben viel lieber.");
  AddInfo("einsiedler",
      "sagt: Der Einsiedler hat einen Nierenstein!.\n");               
}


