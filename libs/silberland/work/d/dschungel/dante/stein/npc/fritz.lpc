
// dante februar 97
//soll wie ein spieler wirken
//hat rucksack
//ne hat spritze
inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "files.h"
#include <mnpc.h>

object cash;
void create()
{

  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Fritz");
  SetProp(P_LONG, BS(
        "Das ist Fritz."));
  SetProp(P_ARTICLE, 0);
  SetProp(P_NAME, "Fritz");
  SetProp(P_RACE, "Mensch");
  SetProp(P_GENDER, MALE);
  AddId(({"npc","fritz"}));

  SetProp(P_WIMPY,70);

  SetProp(P_INFO, ("Du kannst nichts besonders an Fritz erkennen.\n "));
  create_default_npc(15);
  SetProp(P_HANDS, ({" mit seinen Haenden",110+random(30),({DT_BLUDGEON}) }));
  SetProp(P_BODY, 30+random(10));
  SetProp(P_SIZE, 220);
  SetProp(P_ALIGN, 100);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_NOATTACK, 0);//nuur im mom so
  SetProp(P_MSGIN, "kommt herein");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "kommt herein");
  SetProp(P_MMSGOUT, "geht schnell weiter");
  SetProp(P_MNPC_AREA, ("/d/dschungel/dante/"));
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES +MOV_INDOORS +MOV_INFIGHT);
  SetProp(P_MNPC_WAIT, ({10+random(10), 7, 7}));
  SetProp(P_MNPC_DEFAULTROOM, ("/d/dschungel/dante/stein/room/stein12"));

  SetProp(P_DIE_MSG,  " faellt tot um.\n");
  SetProp(P_NOCORPSE, 0 );
  AddInfo(({"sack","rucksack","dantes rucksack"}),
      "Dante hat mir den Sack wieder weggenommen!\n","sagt: ");
  AddInfo("fritz",
      "Das bin ich!\n", "sagt: \n");
  AddInfo("dante",
      "Der hat mir meinen Rucksack geklaut und nach sich benannt.\n","sagt: ");
  AddInfo(({"larve"}),
      "Die gebe ich nicht her!", "sagt: ");
  AddInfo(({"glas","gurkenglas"}),
      "Tja, das haettest Du Wicht gerne, oder!", "lacht: ");

  AddInfo(DEFAULT_INFO,({

        "sagt: Sorry, muss metzeln.\n",
        "sagt: Keine Zeit, ich queste grad.\n",
        "sagt: Hmm, weiss nicht...\n",
        "sagt: Frag einen anderen Spieler.\n",
        "sagt: Weisst Du wo hier der ZT ist?\n",
        "sagt: Aeh...\n",
        "sagt: Gib mir bitte etwas Geld.\n",
        "sagt: Kannst Du mir ne Waffe geben?\n",
        "sagt: Der Dschungel ist das beste hier...\n",
        "sagt: Kennst Du Dante?\n"}));

  AddInfo("dante", "Dante hat mich verbrochen.","sagt: ");
  SetProp( P_REJECT, ({ REJECT_KEEP,
        "Fritz sagt: Naja, bischen mehr koennte es schon sein, Du Geizhals...\n" }) );

  SetProp(P_SPELLRATE,60);

  AddSpell(4,250,
      "Fritz schleudert einen kleinen Feuerball auf Dich.\n",
      "Fritz schleudert einen kleinen Feuerball auf @WEN.\n",
      DT_FIRE,([SP_SHOW_DAMAGE:1]));

  AddSpell(3,500,
      "Fritz schleudert einen grossen Feuerball auf Dich.\n",
      "Fritz schleudert einen grossen Feuerball auf @WEN.\n",
      DT_FIRE,([SP_SHOW_DAMAGE:1]));

  AddSpell(3,350,
      "Fritz schleudert einen Feuerball auf Dich.\n",
      "Fritz schleudert einen Feuerball auf @WEN.\n",
      DT_FIRE,([SP_SHOW_DAMAGE:1]));


  AddSpell(3,200,
      "Fritz schiesst einen magischen Pfeil auf Dich.\n",
      "Fritz schiesst einen magischen Pfeil auf @WEN.\n",
      DT_MAGIC,([SP_SHOW_DAMAGE:1]));


  SetChats(3, ({
        "Fritz stolpert.\n"
        "Fritz sagt: Tschuess.\n",
        "Fritz ruelpst.\n",
        "Fritz sagt: Muss metzeln gehn!\n",
        "Fritz seufzt.\n",
        "Fritz grinst Dich an.\n",
        "Fritz sagt: Hmm, was is los?\n",
        "Fritz sagt: Gibts eine neue Quest?\n"}));

  SUID;
  cash=CLONEOB("/obj/money");
  cash->SetProp(P_AMOUNT, random(300)); 
  cash->move(ME);     

  AddCmd(({"tritt","trete","wuerge","liebe","knuddle","lache","kuesse","taetschle","umarme","spucke","lache"}),"kill");  


  CLONEME( "/d/dschungel/dante/stein/obj/anti");
  CLONEME( "/d/dschungel/dante/weg/weapon/demesser" );  
  command("zuecke messer");
  CLONEME ( "/d/dschungel/feyaria/tijara/armour/bronzepanzer");
  CLONEME ("/p/armour/boots/seidenschuhe");
  CLONEME ("/d/wasser/stahldorn/knarkh/obj/knarkhhelm");
  CLONEME("/d/wasser/stahldorn/knarkh/obj/knarkhhose");
  CLONEME("/d/ebene/obj/ruestung/otterfell");
  command("trage alles");

  //if(!random(2))  {


  CLONEME( "/d/dschungel/dante/stein/obj/gurkenglas"); 

  /*   if(!random(3))  {
       CLONEME("/players/dante/k4");
       }       
       */

}

void init()
{
  ::init();

  if (interactive(TP)) call_out("hi", 2);
}


void hi()
{
  switch(random(12))
  {

    case 0:
      command("emote sagt: Hallo "+ TP->name(RAW) +", Hast Du etwas Geld fuer mich...");
      break;

    case 1:
      command("emote sagt: Hallo "+ TP->name(RAW) +"!\n");
      break;

    case 2:
      command("emote laechelt Dich an.\n");
      break;
    case 3:
      command("emote teilt Dir mit: "+ TP->name(RAW) +", wie gehts?");
      break;
    case 4:
      command("emote teilt Dir mit: He, lange nicht gesehn!");
      break;
    case 5 .. 10:
      break;
    case 11:
      command("emote sagt: "+ TP->name(RAW) +", auch mal wieder da?");
  }  
}

kill()
{
  switch(random(8))
  {
    case 0:
      command("emote sagt: He! "+ TP->name(RAW) +", lass das!\n");
      break;
    case 1:
      command("emote sagt: "+ TP->name(RAW) +", gib Ruhe!\n");
      break;
    case 2:
      command("emote sagt: Hau ab!\n");
      break;
    case 3:
      command("emote laechelt doof.\n");
      break;
    case 4:
      command("emote sagt: Du bist ein ziemlicher Depp, "+ TP->name(RAW) +" !\n");
      break;
    case 5:
      command("emote sagt: Naja muss das sein, "+ TP->name(RAW) +" ?\n");  
      break;
    case 6 .. 7:
  }
}

