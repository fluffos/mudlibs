// 97 dante@SilberLand

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"



void init()
{
  ::init();
  if(interactive(TP)) call_out("hallo",0);
}   
object cash;

void create()
{

  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein kraeftiger Torwaechter");
  SetProp(P_LONG, 
      "Dieser Torwaechter hat vom Gouverneur von Tijara den Auftrag, "
      "niemanden hinter das grosse Tor im Osten zu lassen. Er schaut Dich "
      "freundlich aber bestimmt an. Sein ernster und auch etwas aengstlicher "
      "Gesichtsausdruck laesst nichts Gutes hinter dem Tor erwarten.");

  SetProp(P_NAME, "Torwaechter");
  SetProp(P_GENDER, MALE);
  AddId(({"torwaechter", "waechter", "wache"}));

  create_default_npc(15);
  SetProp(P_HANDS, ({" mit seinen starken Armen",180+random(20),DT_BLUDGEON}));
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 180);
  SetProp(P_ALIGN, 100);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,3);

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "marschiert herein");
  SetProp(P_MMSGOUT, "marschiert weit weg");

  SetProp(P_DIE_MSG,  " bricht in Plichterfuellung nieder.\n");
  SetProp(P_NOCORPSE, 0 );

  AddInfo(DEFAULT_INFO, "sagt nur: Huete Dich vor dem Monster!\n");
  AddInfo("dante", "Dante hat mich erschaffen.\n","sagt: ");

  AddInfo("tor",
      "sagt: Ich bewache das Tor!\n");
  AddInfo("steingigant",
      "sagt: Naja, eigentlich sind sie ja recht freundlich.\n");
  AddInfo("tijara",
      "sagt: Meine alte Heimat...\n");
  AddInfo("gouverneur",
      "sagt stolz: Ich habe einen Spezialauftrag von ihm!\n");
  AddInfo("schluessel",
      "Den Schluessel darf ich niemandem geben! Hinter dem Tor ist ein Monster!\n", "sagt: ");
  AddInfo("monster",
      "sagt: Wir haben es gefangen und hier eingesperrt!\n");



  SetProp( P_REJECT, ({ REJECT_DROP,
        "Der Torwaechter sagt: Nein, auch so bekommst Du nichts von mir!\n" }) );

  SetProp(P_SPELLRATE,50);

  AddSpell(3,300,
      "Der Torwaechter schlaegt Dir in den Bauch.\n",
      "Der Torwaechter schlaegt @WEM in den Bauch.\n",
      DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));
  AddSpell(2,400,
      "Der Torwaechter sticht Dir in Dein Bein.\n",
      "Der Torwaechter sticht @WEM in sein Bein.\n",
      DT_PIERCE,([SP_SHOW_DAMAGE:1]));
  AddSpell(1,500,
      "Der Torwaechter schlitzt fast Deinen Arm auf.\n",
      "Der Torwaechter schlitzt fast @WESSEN Arm auf.\n",
      DT_RIP,([SP_SHOW_DAMAGE:1]));

  SetChats(3, ({
        "Der Torwaechter warnt Dich eindringlichst.\n",
        "Der Torwaechter schaut Dich pruefend an.\n",
        "Der Torwaechter stoehnt ueber seine Arbeit.\n",
        "Der Torwaechter fragt Dich: Kennst Du den Gouverneur ?\n",
        "Der Torwaechter murmelt etwas von einem Monster.\n",
        "Der Torwaechter baut sich vor Dir auf.\n",
        "Der Torwaechter sagt: Diese Steingiganten sind ziemlich laestig.\n",
        "Der Torwaechter sagt: Du, was willst Du hier !\n"}) );
  SetAttackChats(10, ({
        "Der Torwaechter bedraengt Dich hart.\n",
        "Der Torwaechter schreit: Verschwinde schnell !\n",
        "Du stolperst fast...\n",
        "Der Torwaechter ist staerker als Du dachtest...\n",
        "Der Torwaechter sagt: Unwissender !\n",
        "Der Torwaechter sagt: Meinen Schluessel bekommst Du nicht!\n",
        "Der Torwaechter flucht laut.\n"}) );

  SUID;

  cash=CLONEOB("/obj/money");
  cash->SetProp(P_AMOUNT, random(100));
  cash->move(ME);
  CLONEME(OBJ "keytor" );
  CLONEME( "/p/weapon/spear/hellebarde" );
  command("zuecke hellebarde");
  CLONEME ( "/p/armour/armour/bronzepanzer");
  command("trage alles");
}

void hallo()
{

  if ( present("angriff", TP))
  {
    Kill(TP);
    command("emote bruellt: "+ TP->name(RAW) +", lass meine Bank in Ruhe!");
  }
  else
  {
    command("emote bruellt: "+ TP->name(RAW) +", sei gegruesst!");
  }
}      
