
inherit "std/npc/sequencer";
inherit "std/npc";

#include "../def.h"
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <class.h>
#include <mnpc.h>
create()
{

  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Steingigantenbaby");
  SetProp(P_LONG, (
        "Dieses Steingigantenbaby besteht aus purem Granit. Seine steinerne Haut "
        "schuetzt ihn vor laestigen Angreifern, die es mit seinen kleinen "
        "Faeusten abzuwehren probiert. Es ist wirklich noch sehr klein und verspielt.\n"));
  SetProp(P_NAME, "Steingigantenbaby");
  SetProp(P_GENDER, NEUTER);
  AddDetail(("granit"),
      "Granit, Granit , es besteht eben nur aus Granit...\n");
  AddId( ({"gigant", "steingigant","baby","steingigantenbaby"}) );
  AddDetail(({"faust","faeuste"}),
      "Die Faeuste des Steingigantenbabys sind im Moment noch ziemlich klein.\n");
  AddDetail(("haut"),
      "Die harte Haut des Steingigantenbabys wird einmal ein hervorragender Schutz werden."
      " Im Moment ist sie noch recht schwach ausgebildet.");

  create_default_npc(8);
  SetProp(P_HANDS, ({" mit seinen kleinen Faeustchen", 80, DT_BLUDGEON}));
  SetProp(P_BODY, 70+random(10));
  SetProp(P_RACE, "Gigant");
  SetProp(P_SIZE, 100+random(20));
  SetProp(P_ALIGN, 100);
  SetProp(P_MAX_HANDS, 2);
  AddInfo(DEFAULT_INFO, ("sagt: Steini essi hmm, leckerli."));
  SetProp(P_REJECT, ({ REJECT_DESTRUCT, 
        "Das Baby isst @WEN auf.\n"}));
  SetProp(P_DIE_MSG, " kommt in den Steingigantenbabyhimmel.\n");
  SetProp(P_INFO, ("Das Steingigantenbaby ist wirklich noch sehr klein.\n"));
  SetProp(P_RESISTANCE, ({ DT_BLUDGEON,DT_RIP,DT_PIERCE,DT_SLASH}));

  SetProp(P_NOMAGIC, 5);
  SetProp(P_SPELLRATE, 10);
  AddSpell(5, 100, 
      "Das Steingigantenbaby zertruemmert Deinen Arm.\n",
      "Das Steingigantenbaby zertruemmert @WESSEN Arm.\n",
      DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));                                                               
  AddSpell(2, 120, 
      "Das Steingigantenbaby schleudert Felsbloecke nach Dir.\n",
      "Das Steingigantenbaby schleudert Felsbloecke nach @WEM.\n",
      DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));
  AddSpell(5, 200,
      "Die Faust des Steingigantenbabys schlaegt auf Deinen Schaedel.\n",
      "Die Faust des Steingigantenbabys schlaegt auf @WESSEN Schaedel.\n",
      DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));
  AddSpell(1, 250,
      "Das Steingigantenbaby zerquestscht Dich an der Wand.\n",
      "Das Steingigantaby zerquetscht @WEN an der Wand.\n",
      DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));


  SetChats(4, ({
        "Das Steingigantenbaby kaut einen Stein.\n",
        "Das Steingigantenbaby laechelt freundlich.\n",
        "Das Steingigantenbaby kitzelt Dich.\n",
        "Das Steingigantenbaby sagt: Meine Mami ist aus Stein.\n",
        "Das Steingigantenbaby spielt mit den Felsen.\n",
        "Das Steingigantenbaby nuckelt am Granit.\n",
        "Das Steingigantenbaby zermalmt einen kleinen Stein.\n",
        "Das Steingigantenbaby ruft nach seinem Papi.\n",
        "Das Steingigantenbaby zeigt Dir seine Granitwindeln.\n",
        "Das Steingigantenbaby wirft ein kleines Steinchen nach Dir.\n"}));
  SetAttackChats(20, ({
        "Das Steingigantenbaby ruft nach seiner Mami.\n",
        "Das Steingigantenbaby weint laut.\n",
        "Das Steingigantenbaby ruft seine grossen Brueder zu Hilfe.\n",
        "Das Steingigantbaby schlaegt mit seiner kleinen Faust nach Dir.\n",
        "Du schaemst Dich ein Baby toeten zu wollen.\n",
        "Das Steingigantenbaby ruft: Hilfe! Hilfe!.\n"}));
  SUID;
  CLONEME(ARMOUR"dstwind");
  command("trage alles");
}

die(arg)
{
  clone_object(NPC "dstmama")->move(MENV, M_NOCHECK); 
  ::die(arg);
}
