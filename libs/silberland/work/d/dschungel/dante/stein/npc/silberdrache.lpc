// Der Silberdrache bei den Steingiganten

inherit "/p/std/dragons/dragon";
#include "../def.h"
#include <properties.h>
#include <language.h>
#include <combat.h> // fuer die damage types
#include <moving.h> // fuer REJECT_KEEP
#include <wizlevels.h>

void create()
{ 
  if (!is_clone(this_object())) return;
  ::create();    
  create_default_dragon(4,6+random(3),1,15+random(30));

  SetProp(P_NAME, "Ehcardreblisnie");
  SetProp(P_SHORT, "Ehcardreblisnie, der Silberdrache");
  SetProp(P_ARTICLE, 0);
  SetProp(P_NAME_ADJ, 0);
  SetProp(P_LONG, BS(
        "Das ist Ehcardreblisnie, der Silberdrache. "
        "Du erschauderst vor Ehrfurcht, als Dir der Silberdrache in die Augen "
        "blickt und Dampf aus seinen Nuestern blaest. Er ist ueber und ueber mit "
        "Schuppen bedeckt, die die meisten Zauber und den meisten physischen Schaden "
        "abwehren. Seine Klauen sind so gross wie ein Kurzschwert und so scharf, dass"
        "sie alles zerreissen koennen, was in ihre Naehe kommt. Sein Schwanz laeuft in "
        "gefaehrliche  Hornspitze aus, die schon so manchen Helden, der sich "
        "zuviel zutraute, in zwei Haelften geteilt hat."));

  AddId(({"drache","silberdrache","ehcardreblisnie"}));

  CLONEME(WEAPON "silberspeer");

  AddCmd(({"steck","stecke","leg","lege","nehme", "nimm"}), "nehmen", 1);
}

int nehmen(string str)
{
  write("Der Drache faucht Dich will an, als Du seinen Schatz stehlen willst!\n");
  if ( !IS_LEARNER(TP) ) 
    Kill(TP);
  return 1;
}

// Kills mitloggen
void die(int poisondeath)
{
  write_file(LOG "drache",
    ctime()+": "+CAP(getuid(TP))+" killt den Silberdrachen.\n");
  if( !IS_LEARNER(TP) )
    domainshout(CAP(TP->query_real_name())+
        " hat den Silberdrachen bezwungen.\n");
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  write_file(LOG "drache",
    ctime()+": Der Silberdrache hat gerade "+CAP(getuid(player))+" umgebracht.\n");
  ::NotifyPlayerDeath(player, killer, lostexp);
}

