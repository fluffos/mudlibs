// h2ogeist

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"
#include <wizlevels.h>
void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein freches Kellermonster");
  SetProp(P_LONG, BS(
  "Das ist ein Kellermonster. Eigentlich ist es ja gar kein so boeses Monster, "
  "aber wer sein Leben im Keller verbringt ist wohl suspekt. Auf jeden Fall "
  "hast Du es in seiner Ruhe gestoert."));
  SetProp(P_NAME, "Kellermonster");
  SetProp(P_GENDER, NEUTER);
  
  AddId(({"kellermonster", "monster"}));

  create_default_npc(10);
  SetProp(P_HANDS, ({" mit seinen haesslichen Klauen", 150+random(30),({DT_WATER,DT_TERROR}) }));
  SetProp(P_BODY, 30+random(10));//body herabgesetzt:))
  SetProp(P_RACE, "monster");
  SetProp(P_SIZE, 200);
  SetProp(P_ALIGN, -100);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_RESISTANCE, ({ DT_TERROR}));
  SetProp(P_VULNERABILITY, ({DT_HOLY})); 
  SetProp(P_MSGIN, "springt auf Dich zu");
  SetProp(P_MSGOUT, "springt kreischend");
  SetProp(P_MMSGIN, "springt auf Dich zu");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");
  SetProp(P_SPELLRATE, 60);
  SetProp(P_NOMAGIC, 3);
  SetProp(P_DIE_MSG,  " verschwindet wieder irgendwo im Dunkeln.\n");
  SetProp(P_NOCORPSE, 1);

  AddInfo(DEFAULT_INFO, "sagt: Das ist mein Keller!\n");
  AddInfo("Dante", "Dante hat mich erschaffen.","sagt: ");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Das Kellermonster will @WEN nicht tragen.\n" }) );


AddCmd(({"rolle","roll","drehe","dreh","ziehe","zieh","wische","wisch","staube", "staub"}), "nehmen", 1);
    
 AddSpell(4,250,
"Das Kellermonster wirft Dir Schimmelpilze ins Gesicht.\n",
"Der Kellermonster wirft @WEM Schimmelpilze ins Gesicht.\n",
DT_POISON, ([SP_SHOW_DAMAGE:1]));
 AddSpell(4,350,
"Das Kellermonster bruellt Dir ins Ohr.\n",
"Das kellermonster bruellt @WEM ins Ohr.\n",
DT_TERROR, ([SP_SHOW_DAMAGE:1]));
 AddSpell(4,350,
"Das Kellermonster kuesst Dich!\n",
"Das Kellermonster kuesst @WEN!\n",
DT_TERROR, ([SP_SHOW_DAMAGE:1]));
}


int nehmen()
{
write("Das Kellermonster haelt Dich zurueck!!\n");
if ( !IS_LEARNER(TP) ) Kill(TP);
return 1;
}


