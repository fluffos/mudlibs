//WIDOLT RIESE
inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"
#include <actions.h>

void init()
{
  ::init();
      if(interactive(TP)) call_out("hallo",0);
          }   

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein fast verhungerter Haeftling");
  SetProp(P_LONG, BS(
  "Dieser arme Haeftling scheint nur mehr aus Haut und Knochen zu bestehen. "
  "Sei so nett und gib ihm den Gnadenstoss..."));
  SetProp(P_NAME, "Haeftling");
  SetProp(P_ARTICLE, 1);
  SetProp(P_GENDER, MALE);
  
  AddId(({"haeftling"}));

  create_default_npc(5);
  
  SetProp(P_HANDS, ({" mit seinen schwaechlichen Armen", 50+random(10),({DT_BLUDGEON}) }));
  SetProp(P_BODY, 20+random(15));
  SetProp(P_RACE, "haeftling");
  SetProp(P_SIZE, 170);
  SetProp(P_ALIGN, 100);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_INFO, ("Der Haeftling ist sehr schwach. \n"));   
  SetProp( P_RESISTANCE_STRENGTHS,([DT_BLUDGEON: 2.0, DT_SLASH:1.0, DT_MAGIC:0.5,
    DT_FIRE: 1.0, DT_AIR:2.0, DT_PIERCE:1.0, DT_RIP:2.0, DT_WHIP:2.0]));
    
    
  SetProp(P_MSGIN, "taumelt herein");
  SetProp(P_MSGOUT, "taumelt");
  SetProp(P_MMSGIN, "taumelt herein");
  SetProp(P_MMSGOUT,  "taumelt davon");
  SetProp(P_SPELLRATE, 70);
  SetProp(P_NOMAGIC, 0);
  SetProp(P_DIE_MSG,  " sagt: Danke! Du hast mich erloest.\n");
  SetProp(P_NOCORPSE, 0);

  AddSpell(2, 70,
  "Der Haeftling versucht Dich zu treten.\n",
  "Der Haeftling versucht @WEN zu treten.\n",
   DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));
   
    AddSpell(2, 800,
    "Der Haeftling versucht Dir ins Bein zu beissen.\n",
    "Der Haeftling versucht @WEM ins Bein zu beissen.\n",
   DT_PIERCE, ([SP_SHOW_DAMAGE:1]));
      
 AddSpell(2, 100,
  "Der Haeftling versucht Dir ins Gesicht zu schlagen.\n",
  "Der Haeftling versucht @WEM ins Gesicht zu schlagen.\n",
   DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));
   
  AddInfo(DEFAULT_INFO, ({
  "sagt: Erloese mich doch bitte.\n"}));
  AddInfo("tod",
  "Ja, ich will sterben.","sagt: ");
  AddInfo("zelle",
  "Naja, sie wird wohl mein Grab werden.","sagt: ");
  SetProp( P_REJECT, ({ REJECT_GIVE,
    "Der Haeftling sagt: Ich will sterben und nicht Deinen Muell.\n" }) );

 SetChats(3, ({
 "Der Haeftling fleht Dich an.\n",
 "Der Haeftling stoehnt.\n",
 "Der Haeftling seufzt laut.\n",
 "Der Haeftling sagt: Toete mich bitte.\n",
 "Der Haeftling jammert ueber sein Schicksal.\n"}));
 

}

void hallo()
{
command("emote fleht Dich an:  "+ TP->name(RAW) +", bitte toete mich.\n");
}
