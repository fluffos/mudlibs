//ok ich gebs zu angrox und zordan; ich bin doof*lach* und hier ein extra ,
//fuer euch!!!
inherit "std/mnpc";
#include <mnpc.h>
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "/players/dante/myowndefine.h"



void create()
{
  if (!is_clone(TO)) return;
  ::create();
  SetProp(P_SHORT, "Krkk, das Hakenmonster");
  SetProp(P_LONG, BS(
        "Krkk, das Hakenmonster schaut am ehesten dem Balrog aehnlich, doch anstatt "
        "der Arme, hat Krkk, lange hakenfoermige Gebilde. Es ist dumm, aber "
        "trotzdem nicht zu unterschaetzen."));
  SetProp(P_NAME,"Krkk, das Hakenmonster");
  SetProp(P_GENDER, NEUTER);
  AddId(({"hakenmonster","monster","krkk"}));
  SetProp(P_RACE, "Daemon");
  SetProp(P_ARTICLE, 0);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10, T_RANGE_MAX: 45]));
  create_default_npc(18);
  SetProp(P_HANDS, ({" mit einem hakenfoermigen Gebilde",
        170+random(50),DT_RIP}));
  SetProp(P_BODY, 80);
  SetProp(P_SIZE, 300);
  SetProp(P_ALIGN, -500);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_INFO, "Krkks Haken ist sehr interessant!!!\n");
  SetProp( P_RESISTANCE_STRENGTHS,
      ([DT_FIRE: -1.0, DT_TERROR:-1.0, DT_BLUDGEON:0.3, DT_MAGIC:-0.5, 
        DT_WATER:1.0, DT_COLD:0.4, DT_SLASH: 0.3]));

  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE, 0.1);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC, 5);
  SetProp(P_NOCORPSE, 0);
  SetProp(P_MSGIN, "kommt bruellend herein");
  SetProp(P_MSGOUT, "rennt bruellend weiter");
  SetProp(P_MMSGIN, "kriecht aus einem Spalt");
  SetProp(P_MMSGOUT, "springt weit weg");

  SetProp(P_MURDER_MSG, "Verdammt, wieder ist mein Haken weg!");
  SetProp(P_KILL_NAME, "Krkk, das Hakenmonster");
  SetProp(P_KILL_MSG, "Wer will als naechster meinen Haken spueren!?!");

  AddInfo("krkk",
      "Das bin ich Du Idiot!", "bruellt: ");                                                               
  AddInfo("haken",
      "Den haettest Du gerne, Du /%&(%&%&)/()/(!!!", "lacht: ");
  AddInfo("tireks",
      "Tireks ist mein Freund, Du Penner!", "sagt: "); 

  SetProp(P_SPELLRATE,80);


  AddSpell(4,200,
      "Krkk schlaegt einen Haken in Dein Bein!\n",
      "Krkk schlaegt einen Haken in @WESSEN Bein!\n",  
      DT_RIP,([SP_SHOW_DAMAGE: 1]));

  AddSpell(3,300,
      "Krkk schlaegt einen Haken in Deinen Arm!\n",
      "Krkk schlaegt einen Haken in @WESSEN Arm!\n", 
      DT_RIP,([SP_SHOW_DAMAGE: 1]));

  AddSpell(1,500,
      "Krkk schlaegt einen Haken in Deinen Kopf!\n",
      "Krkk schlaegt einen Haken in @WESSEN Kopf!\n",
      DT_RIP,([SP_SHOW_DAMAGE: 1]));

  AddSpell(2,400,
      "Krkk schlaegt einen Haken in Deinen Bauch!\n",
      "Krkk schlaegt einen Haken in @WESSEN Bauch!\n",
      DT_RIP,([SP_SHOW_DAMAGE: 1]));

  SetChats(10,({            
        "Krkk zeigt Dir einen Haken.\n",
        "Krkk grunzt laut.\n",
        "Krkk sagt: Angeblich ist eine Seherin mit Kuechennamen extrem laestig!\n",
        "Krkk flucht irgendetwas ueber Dich!\n",
        "Krkk schnellt nach vorne.\n",
        "Krkk sagt: Dieser Haken gehoert in Deinen Kopf!\n",
        "Krkk krkkt.\n"}));

  SUID;
  CLONEME("/d/dschungel/dante/stein/weapon/tihak");
} 



void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  write_file("/d/dschungel/dante/stein/log/krkk",
      ctime()+": Krkk hat "+CAP(getuid(PL))+" umgebracht.\n");
}

varargs void die(int arg)
{
  write_file("/d/dschungel/dante/stein/log/krkk",
      ctime()+": Krkk wurde von "+CAP(getuid(PL))+" umgebracht.\n");
  ::die(arg);
}
