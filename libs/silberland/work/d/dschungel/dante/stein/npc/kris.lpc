//kristallgigant
inherit "std/mnpc";

#include "/players/dante/myowndefine.h"
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <mnpc.h>
#include <player.h>    
#include <new_skills.h>
create()
{
  int i;
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Kristallgigant");
  SetProp(P_LONG, BS(
  "Das ist einer der seltenen Kristallgiganten. Er besteht voellig aus "
  "Kristall. Er glitzert und schimmert in allen Farben! "
  "Sein Koerper ist gedrungen und sehr kraeftig, und der harte "
  "Kristallpanzer bietet ihm sicher guten, zusaetzlichen Schutz. "
  "An Groesse ueberragt er Dich mit Leichtigkeit...")); 
AD("groesse",
"Sicher 5 Meter!");
AD(({"panzer","kristallpanzer"}),
"Den haettest Du gerne!");
  AD(({"farben","farbe"}), 
  "Bunt!");
  AD("kristall",
  "Sein gesamter Koerper besteht aus Kristall.");
  AD("koerper",
  "Massig, gedrungen, doch trotzdem durchsichtig.");
  SetProp(P_NAME, "Kristallgigant");
  SetProp(P_GENDER, MALE);
  AddId( ({"gigant", "KRIS", "kristallgigant"}) );
  SetProp(P_MATERIAL, MAT_CRYSTAL);
  create_default_npc(20+random(2));
  SP(P_AGGRESSIVE, 1);
  SetProp(P_HANDS, ({" mit seinen kristallinen Faeusten", 350+random(100), DT_BLUDGEON}));
  SetProp(P_BODY, 140);
  SetProp(P_RACE, "Gigant");
  SetProp(P_SIZE, 500+random(20));
  SetProp(P_ALIGN, 100);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_REJECT, ({ REJECT_KEEP, 
     "Der Kristallgigant sagt: Naja, Kristalle habe ich lieber.\n"}));
  SetProp(P_DIE_MSG, " zerfaellt in 1000000 Scherben.\n");
  SetProp(P_NOCORPSE, 1);
  SetProp(P_RESISTANCE, ({DT_FIRE, DT_COLD, DT_BLUDGEON,DT_RIP,DT_PIERCE,DT_SLASH}));
  
  
  SetProp(P_MSGIN, "stampft polternd herein");
  SetProp(P_MMSGIN, "entsteht aus Kristall");
  SetProp(P_MMSGOUT, "stampft laut polternd davon");
  SetProp(P_MSGOUT, "wird wieder zu Kristall");
  SetProp(P_NOMAGIC, 10);
  SetProp(P_SPELLRATE, 75);
  AddSpell(3, 500, 
   "Der Kristallgigant zertruemmert Deinen Arm.\n",
    "Der Kristallgigant zertruemmert @WESSEN Arm.\n",
    DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));                                                               
  AddSpell(4, 550, 
    "Der Kristallgigant schleudert Kristallbloecke nach Dir.\n",
    "Der Kristallgigant schleuder Kristallbloecke nach @WEM.\n",
     DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));
  AddSpell(6,500,
    "Die Faust des Kristallgiganten schlaegt auf Deinen Schaedel.\n",
    "Die Faust des Kristallgiganten schlaegt auf @WESSEN Schaedel.\n",
     DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));
  AddSpell(2, 600,
    "Der Kristallgigant zerquestscht Dich an der Wand.\n",
    "Der Kristallgigant zerquetscht @WEN an der Wand.\n",
     DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));
AddSpell(2, 800,
"Kristallnadeln schiessen aus dem Waenden!\n",
"Kristallnadeln schiessen aus den Waenden!\n",  
  DT_MAGIC, ([SP_SHOW_DAMAGE:1]));
AddSpell(1, 100,
  "Der Kristallgigant schleudert Kristallnadeln um sich.\n",
  "Der Kristallgigant schleudert Kristallnadeln um sich.\n",
  DT_PIERCE, "spell_blind",([SP_SHOW_DAMAGE:1]));
SUID;
CLONEME("/d/gebirge/thor/hoehlenquest/armour/kpanzer");
command("ziehe panzer an");
CLONEME("d/dschungel/dante/stein/obj/krblase");

 SC(4, ({
  "Der Kristallgigant schimmert hell.\n",
  "Der Kristallgigant ist voellig durchsichtig.\n",
  "Der Kristallgigant schimmert blaeulich.\n",
  "Der Kristallgigant presst Kristall.\n",
  "Der Kristallgigant sagt: Kristall, Kristall!\n"}));
  //kommen noch mehr dazu
  
  AI(({"blase","kristallblase"}),
  "Nein, die gehoert nur mir!", "sagt: ");
  AI(({"panzer","kristallpanzer"}),
  "Den gebe Ich niemals her!", "sagt streng: ");
AI("kristall",
"Ich bin lebendiger Kristall!", "sagt: "); 
    AddInfo(({"steingigant", "giganten", "gigant"}),
    "Nette Kerle!", "sagt: ");
 AI("licht",
 "Das Licht nervt mich!\n", "sagt: ");
 
// ACD(({"spalt","spalte"}), "nix_da", 1);
// ACD(({"froststrahl","feuersturm"}), "njet", 1);
}
