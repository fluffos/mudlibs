 void NotifyPlayerDeath(object player, object killer, int lostexp)
  {
  command_me("nimm alles aus leiche");
  command_me("friss leiche");
  heal_self(100);
  write_file("/d/dschungel/dante/stein/log/krispltod",
    "Am "+ctime()+" ist "+player->name()+" beim Krisgig krepiert.\n");
}


  die(arg)
{

write_file("/d/dschungel/dante/stein/log/kristod",
      ctime()+": "
                +((TP->QueryProp(P_FROG))?CAP(getuid(TP)):TP->name(WER))
                              +" killt den Kristallgiganten.\n");
        ::die(arg);
}


 Defend(int dam, string dtype, int spell, object enemy)
    {
   if (!pointerp(dtype))
   dtype = ({ dtype });
 if (sizeof(dtype & ({ DT_LIGHTNING, }) ))
 
                   {
 tell_room(environment(), "Der Kristallgigant reflektiert diesen Angriff!\n");
 tell_object(enemy, "Die Reflexionen treffen Dich hart!\n");
 enemy->reduce_hit_point(30+random(30));
    heal_self(dam);
  return ::Defend(0, dtype, spell, enemy);
   }
   return ::Defend(dam, dtype, spell, enemy);                        
}


 spell_blind(object enemy, int damage, mixed dam_type)
    {
   enemy->SetProp(P_BLIND, 120);
   tell_object(enemy,
   "Die Kristallnadeln bohren sich tief in Deine Augen!!!\n");
   }
                          
