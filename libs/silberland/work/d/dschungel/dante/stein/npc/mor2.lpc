
// dante november 97
//jaenner 98
inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "files.h"
#include <npc.h>

    

void create()

 

{
 
  if (!is_clone(TO)) return;
  ::create();
  
  SetProp(P_NAME, "Knopfmonster");
  SetProp(P_SHORT, "Ein ekliges Knopfmonster");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_LONG, BS(
  "Das ist ein ekliges Knopfmonster. Es ist nur geschaffen worden, um Dich zu "
  "knoepfen aeh koepfen."));
  create_default_npc(12);
  
  SetProp(P_WIMPY,0);
  
  SetProp(P_HANDS, ({" mit seinen Knoepfen",200+random(30),({DT_RIP, DT_PIERCE}) }));
  SetProp(P_BODY, 20+random(10));
  SetProp(P_SIZE, 200);
  SetProp(P_RACE, "Monster");
  SetProp(P_ALIGN, -700);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,1);
  SetProp(P_SPELLRATE, 60);
  
  SetProp(P_NOMAGIC,5);
   SetProp( P_RESISTANCE_STRENGTHS,([DT_TERROR: -2.0,DT_UNHOLY:- 2.0,
   DT_HOLY:2.0, DT_COLD:1.0]));
  
  SetProp(P_MSGIN, "springt aus einem Knopf hervor");
  SetProp(P_MSGOUT, "knopft sich davon");
  SetProp(P_MMSGIN, "springt aus einem Knopf hervor");
  SetProp(P_MMSGOUT, "knopft sich weit weg");

      AddSpell(5,300,
      "Das Knopfmonster bewirft Dich mit Knoepfen.\n",
       "Das Knopfmonster bewirft @WEN mit Knoepfen.\n",
     DT_MAGIC,([SP_SHOW_DAMAGE:1]));
    AddSpell(3,400,
      "Das Knopfmonster haut Dir auf den Knopf aeh Kopf.\n",
       "Das Knopfmonster haut @WEM auf den Knopf aeh Kopf.\n",
     DT_MAGIC,([SP_SHOW_DAMAGE:1]));


  SetProp(P_DIE_MSG,  " verschwindet in einem Knopfloch.\n");
  SetProp(P_NOCORPSE, 1 );
  
 // SetProp(P_MURDER_MSG, "Dich dividiere ich noch immer weg!");
 // SetProp(P_KILL_NAME, "Ein Winkelfunktionsmonster");
 // SetProp(P_KILL_MSG, "Du bist dafuer in Mathematik durchgefallen!\n");
 // SetProp(P_MSG_FLAGS, ([P_KILL_MSG:1, P_MURDER_MSG:1 ]));
  

 }
