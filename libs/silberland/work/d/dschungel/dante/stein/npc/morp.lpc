inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
//#include "files.h"
#include "def.h"
#include <npc.h>

 void  init()
  {
  ::init();
   switch(random(5))
    {
    case 0:
     
  SetProp(P_SHORT, "Ein haesslicher, grosser,roter Virenork");
  SetProp(P_NAME, "Virenork");
   AddId(({"monster","ork","virenork","mutant"}));
    break;
     
     case 1:
     
  SetProp(P_SHORT, "Ein gewalttaetiger Riesengoblin");
  SetProp(P_NAME, "Riesengoblin");
   AddId(({"monster","goblin","riesengoblin"}));
  break;
  case 2:
  
  SetProp(P_SHORT, "Ein Wuergetroll");
  SetProp(P_NAME, "Wuergetroll");
   AddId(({"monster","troll","wuergetroll"}));
  break;
  case 3:
  
  SetProp(P_SHORT, "Ein Fresszombie");
  SetProp(P_NAME, "Fresszombie");
   AddId(({"monster","zombie","fresszombie"}));
  break;
  
  case 4:  
  SetProp(P_SHORT, "Ein Beulendrakonier");
  SetProp(P_NAME, "Beulendrakonier");
   AddId(({"monster","drakonier","beulendrakonier"}));
  break;
  
  default: write("BUG!\n");
    }
 }
    

void create()

 

{
 
  if (!is_clone(TO)) return;
  ::create();
  
  SetProp(P_GENDER, MALE);
  create_default_npc(12);
   call_out("weg", 600);  
  SetProp(P_WIMPY,0);
  SetProp(P_LONG, BS(
  "Das ist eines der ekligen Monster aus dantes Mutantenlabor. Es kennt nur "
  "eines! Toeten! Und zwar Dich!"));
  
  SetProp(P_HANDS, ({" mit seinen scharfen Klauen",250+random(30),({DT_RIP, DT_PIERCE}) }));
  SetProp(P_BODY, 50+random(10));
  SetProp(P_SIZE, 200);
  SetProp(P_ALIGN, -700);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,1);
  SetProp(P_NOMAGIC,5);
   SetProp( P_RESISTANCE_STRENGTHS,([DT_TERROR: -2.0,DT_UNHOLY:- 2.0,
   DT_HOLY:2.0, DT_COLD:1.0]));
  
  SetProp(P_MSGIN, "springt von hoch oben herab");
  SetProp(P_MSGOUT, "klettert die Seile hoch");
  SetProp(P_MMSGIN, "springt von hoch oben herab");
  SetProp(P_MMSGOUT, "klettert die Seile wieder hoch");
  AddId("monster");
  
  SetProp(P_DIE_MSG,  " bricht bruellend nieder.\n");
  SetProp(P_NOCORPSE, 0 );
  
 // SetProp(P_MURDER_MSG, "Dich dividiere ich noch immer weg!");
 // SetProp(P_KILL_NAME, "Ein Winkelfunktionsmonster");
 // SetProp(P_KILL_MSG, "Du bist dafuer in Mathematik durchgefallen!\n");
 // SetProp(P_MSG_FLAGS, ([P_KILL_MSG:1, P_MURDER_MSG:1 ]));
    SUID;
    CLONEME(WEAPON"wmor");
    command("zuecke schwert");
   CLONEME(ARMOUR"amor");
    command("zieh alles an");
  

 }

 void weg()
 {
 object ob2;
   object ob;
     if (ob=present("schwert",TO))
        {
           ob->remove();
          }
     if (ob2=present("panzer",TO))
        {
           ob2->remove();
              }
     remove();
     }
     
              