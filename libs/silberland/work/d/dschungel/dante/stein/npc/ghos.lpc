// h2ogeist

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create()
{

  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein boesartiger Wassergeist");
  SetProp(P_LONG, BS(
        "Dieser Wassergeist ist der kleine Bruder des Dir vielleicht schon bekannten. "
        "Er ist viel kleiner, aber auch nicht zu unterschaetzen!"));
  SetProp(P_NAME, "Wassergeist");
  SetProp(P_GENDER, MALE);

  AddId(({"wassergeist", "geist"}));

  create_default_npc(14);
  SetProp(P_HANDS, ({" mit seinen waessrigen Klauen", 150+random(30),({DT_WATER,DT_TERROR}) }));
  SetProp(P_BODY, 50+random(10));//body herabgesetzt:))
  SetProp(P_RACE, "geist");
  SetProp(P_SIZE, 200);
  SetProp(P_ALIGN, -500);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE, 1);
  SetProp(P_RESISTANCE, ({ DT_TERROR,DT_WATER,DT_ACID }));
  SetProp(P_VULNERABILITY, ({DT_LIGHTNING,DT_ELECTRIC})); 
  SetProp(P_MSGIN, "fliesst herein");
  SetProp(P_MSGOUT, "fliesst");
  SetProp(P_MMSGIN, "taucht aus dem Wasser auf");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");
  SetProp(P_SPELLRATE, 90);
  SetProp(P_NOMAGIC, 5);
  SetProp(P_DIE_MSG,  " zerfliesst einfach.\n");
  SetProp(P_NOCORPSE, 1);

  AddInfo(DEFAULT_INFO, "sagt: Dich ersaeufe ich auch noch.\n");
  AddInfo("Dante", "Dante hat mich erschaffen.","sagt: ");

  SetProp( P_REJECT, ({ REJECT_DROP,
        "Der Waasergeist will @WEN nicht tragen.\n" }) );

  SetAttackChats(10, ({
        "Der Wassergeist versucht Dich zu ertraenken.\n",
        "Der Wassergeist versucht Dich zu ersticken.\n",
        "Der Wassergeist bruellt: Wasser so hilf mir doch!\n",
        "Der Wassergeist schreit: Ersticken sollst Du!\n"}) );

  AddSpell(2,250,
      "Der Wassergeist presst die Luft aus Dir.\n",
      "Der Wassergeist presst die Luft aus @WEM.\n",
      DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));
  AddSpell(4,350,
      "Der Wassergeist ertraenkt Dich beinahe.\n",
      "Der Wassergeist ertraenkt @WEN beinahe.\n",
      DT_WATER, ([SP_SHOW_DAMAGE:1]));
  AddSpell(4,350,
      "Der Wassergeist umschlingt Dich fest.\n",
      "Der Wassergeist umschlingt @WEN fest.\n",
      DT_TERROR, ([SP_SHOW_DAMAGE:1]));
  AddSpell(2,450,
      "Der Wassergeist saugt Dir die Luft ab.\n",
      "Der Wassergeist saugt @WEM die Luft ab.\n",
      DT_AIR, ([SP_SHOW_DAMAGE:1]));

  AddSpell(3,300,
      "Der Wassergeist umspuelt Dich mit faulem Wasser.\n",
      "Der Wassergeist umspuelt @WEN mit faulem Wasser.\n",
      DT_ACID, ([SP_SHOW_DAMAGE:1]));

  AddSpell(1,400+random(100),
      "Der Wassergeist kriecht in Deine Lungen.\n",
      "Der Wassergeist kriecht in @WESSEN Lungen.\n",
      DT_MAGIC, ([SP_SHOW_DAMAGE:1]));
}

