inherit "std/npc";
//koenig der steingiganten bewacht keule usw
//update am 27.8 97
/*

hat nun das amul fuer tireks!!!


*/




#include "/players/dante/myowndefine.h"
#include <properties.h>
#include <language.h>
#include <combat.h>

#include <moving.h>
#include <new_skills.h>
create()
{
  int i;
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Der Koenig der Steingiganten");
  SetProp(P_LONG, (
    "Der Koenig der Steingiganten besteht aus purem Granit. Seine steinerne Haut "
    "schuetzt ihn vor laestigen Angreifern, die er mit seinen gewaltigen "
    "Faeusten zermalmt. Eigentlich ist er aber ein gutmuetiger Geselle. "
    "Huete Dich besser vor Ihm, denn er ist noch viel gigantischer als alle "
    "anderen Steingiganten."));
  SetProp(P_NAME, "Steingigantenkoenig");
  SetProp(P_GENDER, MALE);
  AddDetail(("granit"),
  "Granit, Granit , er besteht eben nur aus Granit...\n");
  AddId( ({"gigant", "steingigant","steingigantenkoenig","koenig"}) );
  AddDetail(({"faust","faeuste"}),
    "Die Faeuste des Steingiganten solltest Du besser niemals zu spueren bekommen.\n");
    AddDetail(("haut"),
    "Die harte Haut des Steingiganten ist ein hervorragender Schutz.\n");
  SetProp(P_MATERIAL, MAT_STONE);
  create_default_npc(33);
  
  SetProp(P_HANDS, ({" mit seinen steinernen Faeusten", 450, DT_BLUDGEON}));
  SetProp(P_BODY, 160+random(20));
  SetProp(P_RACE, "Gigant");
  SetProp(P_SIZE, 800+random(200));
  SetProp(P_AGGRESSIVE, 0.1);
  SetProp(P_ALIGN, 100);
  SetProp(P_MAX_HANDS, 2);
  AddInfo(DEFAULT_INFO, "sagt: Du Wurm hau ab!\n");
  SetProp(P_REJECT, ({ REJECT_KEEP, 
     "Der Steingigant sagt: Naja, Steine habe ich lieber.\n"}));
  SetProp(P_DIE_MSG, " kracht mit lautem Getoese tot auf den Granitboden.\n");
  SetProp(P_INFO, ("Der Steingigantenkoenig bewacht eine magische Waffe.\n"));
  SetProp(P_RESISTANCE, ({DT_MAGIC,DT_FIRE,DT_BLUDGEON,DT_RIP,DT_PIERCE,DT_SLASH}));
  SetProp(P_VULNERABILITY, DT_WATER);

AddInfo(({"amulett","steinamulett"}),
  "Das haettest Du wohl gerne! Aber das bekommst Du sicher nicht! "
  "Es hat magische Kraefte und kann im Kampf gegen Tireks helfen!",
  "sagt: ");
  AddInfo("tireks",
  "Ein schreckliches Wesen! Ohne Vorbereitung ist man des Todes!",
  "sagt: ");
  AddInfo("vorbereitung",
  "Tja, frag besser jemanden anderen!", "grinst: ");
  
  SetProp(P_NOMAGIC, 10);
  SetProp(P_SPELLRATE, 90);
  AddSpell(5, 500, 
   "Der Steingigantenkoenig zertruemmert Deinen Arm.\n",
    "Der Steingigantenkoenig zertruemmert @WESSEN Arm.\n",
    DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));                                                               
  AddSpell(2, 600, 
    "Der Steingigantenkoenig schleudert Felsbloecke nach Dir.\n",
    "Der Steingigantenkoenig schleudert Felsbloecke nach @WEM.\n",
     DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));
  AddSpell(5, 500,
    "Die Faust des Steingigantenkoenigs schlaegt auf Deinen Schaedel.\n",
    "Die Faust des Steingigantenkoenigs schlaegt auf @WESSEN Schaedel.\n",
     DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));
  AddSpell(1, 800,
    "Der Steingigantenkoenig zerquetscht Dich an der Wand.\n",
    "Der Steingigantenkoenig zerquescht @WEN an der Wand.\n",
     DT_SQUEEZE, ([SP_SHOW_DAMAGE:1]));
  AddSpell(1, 1100,
  "Der Steingigantenkoenig beschwoert alle Geister des Granit.\n",
  "Der Steingigantenkoenig beschwoert alle Geister des Granit.\n",
  DT_MAGIC, ([SP_SHOW_DAMAGE:1]));

 SetChats(4, ({
    "Der Steingigantenkoenig kaut einen Stein.\n",
    "Der Steingigantenkoenig sagt: Los bring mir ein Granitbier!\n",
    "Der Steingigantenkoenig lacht ueber Dich.\n",
    "Der Steingigantenkoenig sagt: Stein ist alles was ich liebe.\n",
    "Der Steingigantenkoenig jongliert mit Felsen.\n",
    "Der Steingigantenkoenig beisst in die Felswand.\n",
    "Der Steingigantenkoenig zermalmt einen grossen Stein.\n",
    "Der Steingigantenkoenig kegelt mit Felsen.\n",
    "Der Steingigantenkoenig singt 'Granit, oh Du mein Granit...'\n",
    "Der Steingigantenkoenig ruft: Untertanen zu mir!\n"}));
 SetAttackChats(20, ({
    "Der Steingigantenkoenig lacht ueber Deine Ausruestung.\n",
    "Der Steingigantenkoenig versucht Dich zu zermalmen.\n",
    "Der Steingigantenkoenig ruft seine Untertanen zu Hilfe.\n",
    "Der Steingigantenkoenig schlaegt mit der Faust nach Dir.\n",
    "Der Steingigantenkoenig zerquetscht Dich fast.\n"}));
 
 
 
 AddInfo(({"priester","kannibalenpriester"}),
    "fluestert: Hihi, der ist ja nur aus Fleich und Blut!\n");
 AddInfo("dante",
 "sagt: Dante hat ein Herz aus Stein!\n");   
 AddInfo(({"kannibalen","kannibale"}),
    "sagt: Die wissen ja nicht wie gut Steine schmecken.\n");
 AddInfo("dschungel",
    "sagt: Der Dschungel ist leider viel zu wenig aus Stein.\n");
 AddInfo("feyaria",
 "sagt: Sie ist die Herrin des Dschungels.");   
 AddInfo("silberland",
 "sagt: Der Dschungel ist das schoenste Gebiet im Silberland.");   
 AddInfo("pyramide",
    "sagt: Ja! Viele grosse Steine.\n");
    AddInfo("stein",
    "sagt: Hmm, die schmecken ja so gut...\n");
    AddInfo("granit",
    "sagt: Eben mein Fleisch und Blut.\n");
    AddInfo("steine",
    "lacht froh...\n");
    AddInfo("pflanzen",
    "sagt: Hmm, versteinerte Pflanzen habe ich lieber!");
    AddInfo("tijara",
    "sagt: da gibts viele Steine.");
    AddInfo("gigant",
    "sagt: Ich bin einer!\n");
    AddInfo("steingigant",
    "lacht und sagt: Alle Giganten sind meine Untertanen.\n");
    AddInfo("untertanen",
    "sagt: Sie alle sind fleissige Arbeiter.\n");
    AddInfo("tiere",
    "sagt: Naja, Steine habe ich eben viel lieber.");
   // AddInfo("schlamm",
   // "sagt: Ich weiss, wo es Schlamm zu finden gibt, aber Du "
   // "                              musst mir zuerst einen Gefallen erweisen.\n");
   // AddInfo("bettler",
   // "arglt: Der Bettler schickt immer Leute zu mir...\n");
   // AddInfo("gefallen",
   // "sagt: Bring mir einen Gigantensteinpilz und dann zeig "
   // "                               ihn mir.\n");
   // AddInfo("pilz",
   // "lacht: Welchen Pilz meinst Du ?\n");
   // AddInfo("gigantensteinpilz",
   // "sagt: Die wachsen angeblich in Dantes Pilzfarm...\n");
    AddInfo("farm",
    "lacht ueber Deine Dummheiten...\n");
    AddInfo("jojo",
    "sagt: Ich spiele lieber mit Steinen...\n");
    AddInfo("pilzfarm",
    "sagt: Dante gehoert getreten...\n");
 AddInfo("einsiedler",
    "sagt: Der Einsiedler hat einen Nierenstein!.\n");
 AddInfo("keule",
 "sagt: Die Keule kriegst Du nie!\n");
 AddInfo("krone",
 "sagt: Die Krone ist zu gut fuer Dich!\n");
 AddInfo("koenig",
 "sagt: Knie nieder vor mir!\n");

//AddCmd(({"zeige","zeig"}), "zeigen"); 
                   
  SUID;
  CLONEME("/d/dschungel/dante/stein/armour/dstkrone");
  CLONEME("/d/dschungel/dante/stein/armour/tiamu");


switch(random(3))  {
	case 0:
  "obj/gemmaster"->DistributeGem(2, 2,1, 1);
  break;
  case 1:
  "obj/pearlmaster"->DistributePearl(2, 2,1, 1);
  break;
  case 2:
  break;
  default:
                    }




  command ("trage alles");
  }


