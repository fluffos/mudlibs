void NotifyPlayerDeath(object player, object killer, int lostexp)
{
command("nimm alles aus leiche");
write_file("/d/dschungel/dante/stein/log/koenig",
ctime()+": CrisF "+CAP(getuid(PL))+" umgebracht.\n");
}

die(arg)
{
domainshout(CAP_TPN+" hat den Koenig der Steingiganten besiegt.\n", "dschungel");
write_file("/d/dschungel/dante/stein/log/koenig",
ctime()+": Koenig wurde von "+CAP(getuid(PL))+" umgebracht.\n");

::die(arg); }

