//koffeinjunkie fuer quest, daher stark, absichtlich nicht noattack
//baldrian geben, erlaubnis in keller zu gehen
inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

object cash;

void create()
{

  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Koffeinjunkie");
  SetProp(P_LONG, BS(
        "Das was einmal ein ganz normaler Abenteurer, bis er hier Dantes Kaffees "
        "gekostet hat. Nun ist er suechtig nach Melange, Cappuccino uae. Er steht "
        "den ganzen Tag, nein er steht nicht, er zappelt den ganzen Tag hier herum "
        "und trinkt einen Kaffee nach dem anderen! Schlafen tut er natuerlich auch nie. "
        "Wozu auch, er hat ja seinen Kaffee!"));
  SetProp(P_NAME, "Koffeinjunkie");
  SetProp(P_GENDER, MALE);

  AddId(({"koffeinjunkie", "junkie"}));

  create_default_npc(17);
  //  SetProp(P_HANDS, ({" mit seinen blitzschnellen Haenden", 250+random(30),({DT_MAGIC}) }));
  SetProp(P_BODY, 50+random(10));//body herabgesetzt:))
  SetProp(P_RACE, "junkie");
  SetProp(P_SIZE, 200);
  SetProp(P_ALIGN, 100);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_MSGIN, "zappelt herein");
  SetProp(P_MSGOUT, "zappelt");
  SetProp(P_MMSGIN, "zappelt herein");
  SetProp(P_MMSGOUT, "zappelt weit weg");
  SetProp(P_SPELLRATE, 60);
  SetProp(P_NOMAGIC, 0);
  SetProp(P_DIE_MSG,  " trinkt nie mehr Kaffe!\n");
  SetProp(P_NOCORPSE, 0);

  AddInfo(DEFAULT_INFO, "sagt: Ich will mehr Kaffee!\n");
  AddInfo("Dante", "Dante hat mich erschaffen.","sagt: ");

  AddInfo(({"schwarzen kaffee", "kaffee schwarz"}),
      "LOS! Gib mir einen!", "sagt: ");

  AddInfo(({"kaffe","kaffee","cofe"}),
      "Ich liebe jeden Kaffee", "sagt: ");
  AddInfo("melange",
      "JAAA!!Mehr davon!", "sagt: ");
  AddInfo("jojo",
      "Ist mir egal!", "sagt: ");
  AddInfo("rellek",
      "Kaffee Rellek ist der Beste! Nur ist er ungeniessbar, wenn Ich Dir nicht helfe! "
      "Bring mir Baldrian damit ich wieder schlafen kann! Dann helfe ich Dir weiter!",
      "sagt: ");
  AddInfo("baldrian", 
      "Ich brauch unbedingt etwas Baldrian, nur weiss ich nicht mehr wo der ist...",
      "sagt: ");

  AddInfo("17",
      "Na, stell Dich nicht so dumm an!", "sagt: ");
  AddDetail("nummer",
      "lacht Dich auch!");

  SetProp(P_INFO, "Der Kaffeejunkie will nur Kaffee!!!\n");


  SetProp( P_REJECT, ({ REJECT_DROP,
        "Der Koffeinjunkie will Kaffee, nicht Deinen Muell!\n" }) );

  SetProp( P_RESISTANCE_STRENGTHS,([DT_TERROR:-3.0, DT_FIRE:-1.0,
DT_BLUDGEON:-1.0, DT_RIP:2.0]));


  SetChats(10, ({
        "Der Koffeinjunkie sagt: Mehr Kaffee!\n",
        "Der Koffeinjunkie zappelt herum!\n",
        "Der Koffeinjunkie zappelt hin und her.\n",
        "Der Koffeinjunkie sagt: Hey, ich will Kaffe!\n",
        "Der Koffeinjunkie schaut Dich irr an!\n",
        "Der Koffeinjunkie sagt: Mein Puls ist auf 180!\n",
        "Der Koffeinjukie sagt: Magst Du Kaffee!\n",
        "Der Koffeinjunkie rennt im Kreis!\n",
        "Der Koffeinjunkie holt sich eine Melange.\n",
        "Der Koffeinjunkie trinkt einen Cappuccino.\n",
        "Der Koffeinjunkie sagt: KAFFEE!!!\n"}));

  AddSpell(3,350,
      "Der Koffeinjunkie pruegelt wie irr auf Dich ein.\n",
      "Der KOffeinjunkie pruegelt wie irr auf @WEN ein.\n",
      DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));
  AddSpell(4,450,
      "Der Koffeinjunkie bruellt Dir KAFFEE ins Ohr.\n",
      "Der Koffeinjunkie bruellt @WEM Kaffee ins Ohr.\n",
      DT_TERROR, ([SP_SHOW_DAMAGE:1]));
  AddSpell(2,450,
      "Der Koffeinjunkie rast um Dich herum.\n",
      "Der Koffeinjunkie rast um @WEN herum.\n",
      DT_TERROR, ([SP_SHOW_DAMAGE:1]));

  SUID;
  cash=CLONEOB("/obj/money");
  cash->SetProp(P_AMOUNT, random(1000));

  AddCmd(({"lade", "lad", "spendier", "spendiere"}), "tip");


}

void give_notify(object ob)
{
  if ((ob->id("bald")))
  {
    write("Der Koffeinjunkie trinkt die ganze Flasche Baldrian aus und sagt:\n"
        "Tja, hilft nichts, aber drueck mal Knopf 17!\n"
        "Danach zappelt er weiter...\n");
    CLONE(OBJ"kellerja.lpc", TP);
    ob->remove();
    return;
  }
  ::give_notify(ob);
}  


int tip(string str)
{
  notify_fail("Wen willst Du etwas spendieren?\n");
  if (!str) return 0;
  if(member(({ "junkie schwarzen kaffee","junkie kaffee schwarz",
          "junkie auf scharzen kaffee ein","junkie auf kaffee schwarz ein",
          "koffeinjunkie auf scharzen kaffee ein","koffeinjunkie auf kaffee schwarz ein",
          "koffeinjunkie schwarzen kaffee","koffeinjunkie kaffee schwarz"}), str)!=-1)

  {  
    write("Du spendierst dem Koffeinjunkie einen schwarzen Kaffee.\n"
        "Er leert den Kaffee grinst freundlich, tut geheimnisvoll und sagt: \n"
        "Probier mal Kaffee Rellek!!!\n"
        "Danach zappelt er weiter herum...\n");
    return 1;
  }

  if (member(({"junkie kaffee","junkie melange","junkie auf melange ein",
          "junkie auf cappuccino ein","junkie cappuccino","junkie eiskaffee",
          "junkie irish coffe","junkie kaffe hell","junkie brauner"}), str)!=-1)
    //muss erweitert werden
  {
    write("Du spendierst dem Junkie einen Kaffee. Er leert ihn runter, "
        "grinst irr und zappelt weiter.\n");
    return 1;
  }
  return 0;
}



heart_beat()
{
  ::heart_beat();
  return ::heart_beat();
}

Attack(object enemy)
{
  SetProp(P_HANDS,({" mit dem seinen blitzschnellen Haenden", 270+random(20),({DT_TERROR}) }));
  return ::Attack(enemy);
}



