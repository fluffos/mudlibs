void spell_stone(object enemy, int damage, mixed dam_type){
  object ob;
  ob=present("TIREKS_AMU", enemy);

  if(ob)
  {

    if(ob->QueryWorn())  {
      tell_object(enemy,
          "Dein Steinamulett schuetzt Dich vor dem Felsbrocken!\n");
      tell_room(environment(enemy),
          "Das Steinamulett schuetzt "+TPN+" vor dem Felsbrocken!\n",
          ({enemy}));   }


      if(!ob->QueryWorn())  {
        tell_object(enemy,
            "Der Felsbrocken trifft Dich mit voller Wucht!!!\n"
            "Dein Steinamulett leuchtet hell auf!!!\n");

        enemy->Defend(1500+random(1000), DT_BLUDGEON,
            ([SP_SHOW_DAMAGE: 1]));

        tell_room(environment(enemy),
            "Der Felsbrocken trifft "+TPN+" voll!!!\n",
            ({enemy}));   }	 

  }

  if(!ob)  {
    tell_object(enemy,
        "Der Felsbrocken trifft Dich mit voller Wucht!!!\n"
        "Scheinbar fehlt Dir irgendetwas um diesen Angriff abzuwehren!!!\n");

    enemy->Defend(1000+random(500), DT_BLUDGEON,
        ([SP_SHOW_DAMAGE: 1]));

    tell_room(environment(enemy),
        "Der Felsbrocken trifft "+TPN+" voll!!!\n",
        ({enemy}));   }	 
}




void spell_away(object enemy, int damage, mixed dam_type)    
{
  if(!interactive(enemy))   {
    enemy->do_damage(random(50));
    tell_room(environment(TO),
        ""+enemy->name()+" wehrt den Zauber ab, wird aber hart von Tireks getroffen!\n");

  }
  if(interactive(enemy) ) {	
    switch(random(100))
    {
      case 0 .. 25:
        enemy->move("/d/dschungel/dante/stein/room/monster1",M_NO_SHOW +
            M_TPORT);
        tell_object(enemy, "Tireks schafft es Dich wegzuschleudern.\n");
        enemy->do_damage(4);
        tell_room(environment(TO),
            "Tireks schafft es "+enemy->name(WEN)+" weit wegzuschleudern!\n",
            ({enemy}));



        break;
      case 26 .. 60:
        tell_room(environment(TO),
            "Tireks schafft es nicht "+enemy->name(WEN)+" weit wegzuschleudern!\n",
            ({enemy}));

        tell_object(enemy, "Tireks schafft es nicht Dich wegzuschleudern.\n");
        enemy->do_damage(12);
        break;    
      case 61 .. 77:  tell_room(environment(TO),
                          "Tireks schafft es "+enemy->name(WEN)+" weit wegzuschleudern!\n",
                          ({enemy}));

                      enemy->do_damage(6);
                      enemy->move("/d/dschungel/dante/stein/room/vor2",M_NO_SHOW + M_TPORT);
                      tell_object(enemy, "Tireks schafft es Dich weit wegzuschleudern.\n");
                      break;
      case 78 .. 90:
                      tell_room(environment(TO),
                          "Tireks schafft es "+enemy->name(WEN)+" weit wegzuschleudern!\n",
                          ({enemy}));

                      enemy->do_damage(8);
                      enemy->move("/d/dschungel/dante/weg/room/weg13",M_NO_SHOW + M_TPORT);
                      tell_object(enemy, "Tireks schafft es Dich sehr weit "
                          +"wegzuschleudern.\n");
                      break;
      case 91 .. 99:
                      tell_room(environment(TO),
                          "Tireks schafft es "+enemy->name(WEN)+" weit wegzuschleudern!\n",
                          ({enemy}));

                      enemy->do_damage(10);
                      enemy->move("/d/dschungel/dante/weg/room/brunnen3",M_NO_SHOW + M_TPORT);
                      tell_object(enemy, "Tireks schafft es Dich mitten in den SCHLAMM "
                          +"zuschleudern.\n");
                      break;

      default: write("BUG!\n");
    }
  }

}


void spell_ghost(object enemy, int damage, mixed dam_type)
{

  if(interactive(enemy))  {


    switch(random(100))


    {
      case 0 .. 30 :
        enemy->command_me("wirf alles weg");
        command("nimm alles");
        enemy->SetProp(P_GHOST, 1);
        tell_object(enemy,
            "Tireks beraubt Dich Deines Koerpers!\n");
        tell_room(environment(TO),
            "Tireks raubt "+enemy->name(WEM)+" den Koerper!\n",({enemy}));


        break;

      case 31 .. 99 :
        enemy->do_damage(10);
        tell_room(environment(TO),
            "Tireks schafft es nicht "+enemy->name(WEM)+" den Koerper "
            "zu stehlen!\n",({enemy}));

        tell_object(enemy,
            "Tireks schafft es nicht Dir Deinen Koeper zu stehlen!\n");
        break;
      default: write("BUG!\n");
               //fruher 0..40 nun o..20 dante
    }

  }  
  if(!interactive(enemy))  {
    tell_room(environment(TO),
        ""+enemy->name(WER)+" widersteht dem Zauber, wird jedoch hart getroffen!\n");
    enemy->do_damage(random(50));
  }   }






void spell_sleep(object enemy, int damage, mixed dam_type)
{

  switch(random(100))
  {
    case 0 .. 30:
      enemy->SetProp(P_PARALYZED, ([
            PARALYZE_TIME: random(7), 
            PARALYZE_MSG: "Aber Du bist doch bewusstlos!\n",
            PARALYZE_MSG_OTHER: "",
            PARALYZE_END: "Du erwachst wieder aus Deiner "
                    +"Bewusstlosigkeit.\n",
            PARALYZE_END_OTHER: "%s erwacht wieder aus "
                    +TP->QueryPossPronoun(FEMALE, WEN, SINGULAR)
                    +" Bewusstlosigkeit.\n"]));
      break;

    case 31 .. 100:
      enemy->do_damage(5);
      tell_room(environment(TO),
          "Tireks schafft es nicht, dass "+enemy->name(WER)+" ohnmaechtig wird!\n",
          ({enemy}));
      tell_object(enemy,
          "Du taumelst umher, wirst aber nicht ohnmaechtig.\n");
  }

}


void spell_ruestung(object enemy,int damage, mixed dam_type)
{
  int groesse, i;
  object* ob;
  ob=enemy->QueryProp(P_ARMOURS);
  groesse=sizeof(ob);

  if(groesse)
  {
    i=random(groesse);
    if( ob[i]->QueryProp(P_MAGIC) || 
        ob[i]->QueryProp(P_NODROP) || 
        ob[i]->QueryProp(P_CURSED) || 
        ob[i]->QueryProp(P_NEVERDROP) ||
        ob[i]->QueryProp(P_INVIS) || 
        ob[i]->QueryProp(P_AUTOLOADOBJ) ||
        ob[i]->id("drachenarmschienen")||
        ob[i]->id("drachenbeinschienen")||         
        ob[i]->id("drachenstiefel")||
        ob[i]->id("drachenpanzer")||         
        ob[i]->id("drachenhelm")||
        ob[i]->id("drachenschild") )         

      return;
    else
    {
      ob[i]->remove();
      tell_room(environment(TO),
          "Tireks zerbroeselt die Ruestung von "+enemy->name(WEM)+"!\n",
          ({enemy}));
      tell_object(enemy,
          "Tireks zerbroeselt Deine Ruestung!\n");
    }
  }


  else
  {
    enemy->do_damage(20)+random(10);
    tell_room(environment(TO),
        "Tireks bricht "+enemy->name(WEM)+" fast die Rippen!\n",({enemy}));

    tell_object(enemy,
        "Tireks bricht Dir fast die Rippen.\n");
  } 

}

void spell_waffe(object enemy,int damage, mixed dam_type)
{
  object ob1;
  string waffenname;
  ob1=enemy->QueryProp(P_WEAPON);

  if (ob1)
  {
    if( ob1->QueryProp(P_CURSED)||
        ob1->QueryProp(P_NEVERDROP) ||
        ob1->QueryProp(P_MAGIC) ||
        ob1->QueryProp(P_NODROP) ||
        ob1->QueryProp(P_AUTOLOADOBJ))
      return;
    else
    {
      tell_room(environment(TO),
          "Tireks schlaegt "+enemy->name(WEM)+" die Waffe weg!\n",
          ({enemy}));
      tell_object(enemy,
          "Tireks schlaegt Dir Deine Waffe aus der Hand und vernichtet sie.\n");
      ob1->remove();
    }
  }
  else
  {
    tell_room(environment(TO),
        "Tireks trifft "+enemy->name(WEN)+" hart!\n",
        ({enemy}));
    tell_object(enemy,
        "Tireks trifft Dich sehr hart.\n");
    enemy->do_damage(20)+random(10);
  }
}


// Mitloggen wenn ein Spieler den NPC killt:
void die(int poisondeath)
{
  object ob, ob2, ob3, ob4,ob5;

  ob2=deep_present("TIREKS_HAKEN", TP);
  ob3=deep_present("TIREKS_AMU", TP);
  ob4=deep_present("TIREKS_AXT", TP);
  ob5=deep_present("TIREKS_STANGE", TP);
  if(!interactive(TP))  {
    return ;    
  }
  //er kann nur von spielern getoetet werden!!!


  while(ob2)  {
    write("Sterbend vernichtet Tireks den Haken.\n");
    ob2->remove(1);  
  }


  while(ob3)  {
    write("Sterbend vernichtet Tireks das Amulett.\n");
    ob3->remove(1);  
  }

  while(ob4)  {
    write("Sterbend vernichtet Tireks die Axt.\n");
    ob4->remove(1);  
  }

  while(ob5)  {
    write("Sterbend vernichtet Tireks die Magiestange.\n");
    ob5->remove(1);  
  }





  ob=clone_object("/d/dschungel/dante/stein/obj/spli");   
  ob->move(TP, M_NOCHECK);

  write("Splitter aus Tireks furchtbaren Gebiss schiessen auf Dich zu!\n"
      "Du hast Glueck, Dir passiert nichts und Du faengst die Splitter "
      "geschickt auf.\n");


  domainshout(BSA("Endlich ist es einem Helden gelungen, das abscheuliche Monster "
        "mit Namen Tireks zu besiegen! Ruhm und Ehre werden Dir, oh "+CAP_TPN+", "
        "fuer immer erhalten bleiben. Dein Name soll fortan stehen fuer Mut und "
        "Tapferkeit! Ein dreifaches Hoch fuer "+CAP_TPN+"! HOCH, HOCH, HOCH!!!", 
        "Der Waechter des Dschungels bruellt: "));  
  write_file("/d/dschungel/dante/stein/log/tireks.kills",
      "Am "+ctime()+" hat "+CAP(getuid(PL))+" Tireks besiegt.\n");
  ::die(poisondeath);


  /*
     fuer mua wenn wir echt ne quest draus machen, dahh einfach hier
     klammern weg usw.....
     cool wuerd ichs finden




     TP->GiveQuest(QUESTKEY);
     write_file("/d/dschungel/dante/stein/log/tireks.quest",M
     "Am "+ctime()+" hat "+CAP(getuid(PL))+" Tireks das erste Mal besiegt.\n");M



*/

}


void NotifyPlayerDeath(object player, object killer, int lostexp)
{

  if(interactive(TP))  {


    write_file("/d/dschungel/dante/stein/log/spieler.deads",
        "Am "+ctime()+" wurde "+CAP(getuid(PL))+" von Tireks zerfetzt.\n");
    command_me("iss leiche");
    heal_self(100);
    shout(
        "Tireks hat gerade die Leiche von "+player->QueryProp(P_NAME)+" verschlungen!\n");
  }

}

//ende
