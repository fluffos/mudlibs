  //stange beginn


int spell_rate_minus(string str)  {
  object ob;
  int oldrate, oldnomagic;
  oldrate=QueryProp(P_SPELLRATE);
  oldnomagic=QueryProp(P_NOMAGIC);

  ob=present("TIREKS_STANGE", TP);

  notify_fail("Was wilst Du stechen?! Wo?\n");

  if(member(({"tireks", "in tireks","in koerper", "in auge","in haut",
          "haut","auge","herz","in herz"}),str)!=-1)   {

    if(!ob)  {
      say(CAP_TPN+" versucht verzweifelt Tireks zu stechen!\n"
          "Tireks schlaegt seine Zaehne in "+TPN+"!\n", ({TP}));

      write("Du versuchst ohne geeignete Waffe Tireks zu stechen.\n"
          "Tireks dreht sich zu Dir und schlaegt seine Zaehne in Dich!\n");
      TP->do_damage(50+random(50));
      return 1; 
    }


    if((ob) && (!ob->QueryProp(P_WIELDED) ))   {
      write("Du hast Deine Stange nicht gezueckt!!!\n"
          "Tireks trifft Dich mit voller Wucht am Kopf!\n");
      say(CAP_TPN+" versucht Tireks zu stechen!\n"
            "Tireks trifft "+TPN+" voll am Kopf!\n", ({TP}));
        TP->do_damage(50+random(50));  
        return 1; 
    }

    if(ob->QueryProp(P_WIELDED)) {
      write(BS("Du versuchst Tireks mit der Stange zu stechen! "
            "Du stichst Tireks, doch nichts passiert!!! War wohl nicht "
            "die richtige Stelle!!!"));
      write("Tireks trifft Dich voll!!!\n");

      say(CAP_TPN+" versucht Tireks mit einer Stange zu stechen!\n"
          "Der Versuch von "+TPN+" schlaegt total "
          "daneben!\n"
          ""+TPN+" wird von Tireks hart getroffen!", ({TP}));
      TP->do_damage(50+random(50));

      return 1; 
    }
    return 0; 
  }





  if(member(({"in zentrum","zentrum","magiezentrum",
          "in magiezentrum"}), str)!=-1)   {



    if(!ob)  {
      say(CAP_TPN+" versucht verzweifelt in Tireks Magiezentrum zu stechen!\n"
          "Tireks schlaegt seine Zaehne in "+TPN+"!\n", ({TP}));

      write(
          "Du versuchst ohne geeignete Waffe in Tireks Magiezentrum zu stechen.\n"
          "Tireks dreht sich zu Dir und schlaegt seine Zaehne in Dich!\n");
      TP->do_damage(50+random(50));
      return 1; 
    }


    if((ob) && (!ob->QueryProp(P_WIELDED) ))   {
      write("Du hast Deine Stange nicht gezueckt!!!\n"
          "Tireks trifft Dich mit voller Wucht am Kopf!\n");
      say(CAP_TPN+" versucht in Tireks Magiezentrum zu stechen!\n"
          "Tireks trifft "+TPN+" voll am Kopf!\n", ({TP}));
      TP->do_damage(50+random(50));  return 1; 
    }

    if (oldrate<=10)   {
      write(BS("Du stichst die Stange in Tireks Magiezentrum, "
            "die Stange glueht gruen auf, doch nichts passiert. Die Magie "
            "von Tireks scheint schon total geschwaecht zu sein!!!"));
      return 1; 
    }  


    if(ob->QueryProp(P_WIELDED)) {


      write(BS("Du versuchst die Stange in Tireks Magiezentrum zu stechen!!!"));

      say(CAP_TPN+" versucht eine Stange in Tireks "
          "Magiezentrum zu stechen!\n", ({TP}));

      if(nixda2!=0)  {
        write("So schnell kannst Du nicht zustechen!!!!\n");
        return 1; 
      }




      else  {

        switch(random(20))  {

          case 0..6:
            write(BS("Die Stange glueht in Tireks Magiezentrum leicht auf. "
                  "Die Magie von Tireks verschwindet ein kleinwenig!!!"));
            say(
                "Die Stange von "+TPN+" glueht in Tireks Magiezentrum "
                "leicht auf!\nDie Magie von Tireks schwindet ein kleinwenig!!!\n",
                ({TP}));
            SetProp(P_SPELLRATE,oldrate-1);

            write_file("/d/dschungel/dante/stein/log/spellrate",
                ctime()+": Minus 1 von "+TPN+".\n");
            TO->do_damage(5+random(5));    
            break;     


          case 7..10:
            write(BS("Die Stange glueht in Tireks Magiezentrum auf. "
                  "Die Magie von Tireks verschwindet ein wenig!!!"));
            say(
                "Die Stange von "+TPN+" glueht in Tireks Magiezentrum "
                "auf!\nDie Magie von Tireks schwindet ein wenig!!!\n",
                ({TP}));
            SetProp(P_SPELLRATE,oldrate-2);

            write_file("/d/dschungel/dante/stein/log/spellrate",
                ctime()+": Minus 2 von "+TPN+".\n");
            TO->do_damage(10+random(5));    
            break;     

          case 11..14:
            write(BS("Die Stange glueht in Tireks Magiezentrum stark auf. "
                  "Die Magie von Tireks verschwindet teilweise!!!!!!"));
            say(
                "Die Stange von "+TPN+" glueht im Magiezentrum "
                "stark auf!\nDie Magie von Tireks schwindet teilweise!!!\n",
                ({TP}));
            SetProp(P_SPELLRATE,oldrate-3);
            SP(P_NOMAGIC, oldnomagic-1);
            //d.h. nomagic kann negativ werden..     
            write_file("/d/dschungel/dante/stein/log/spellrate",
                ctime()+": Minus 3 rate minus 1 nomagic von "+TPN+".\n");
            TO->do_damage(20+random(5));    
            break;     

          case 15..18:
            write(BS("Die Stange glueht nicht auf!!!"
                  "Die Magie von Tireks verschwindet ueberhaupt nicht!!!"));
            say(
                "Die Stange von "+TPN+" glueht nicht auf!\n "
                "Die Magie von Tireks verschwindet ueberhaupt nicht!!!\n",({TP}));

            write_file("/d/dschungel/dante/stein/log/spellrate",
                ctime()+": Minus 0 von "+TPN+".\n");
            break;     


          case 19:
            write(BS("Du triffst Tireks nicht, sondern Dich selbst!!!"
                  "Du verletzt Dich selbst!!!"));
            say(
                "Die Stange von "+TPN+" verfehlt Tireks Magiezentrum!!! \n"
                "Die Stange trifft "+TPN+" selbst!!!\n",({TP}));
            TP->do_damage(10+random(10));

            write_file("/d/dschungel/dante/stein/log/spellrate",
                ctime()+": Verfehlt von "+TPN+".\n");
            break;     
          default: write("Sorry, shutdown!\n");
        }
        nixda2=1;
        call_out("nexttry2", TIME);
        return 1;
      }
      return 1; 
    }
    return 0;
  }
  return 0;
}


void nexttry2() {
  nixda2=0;  
}



//ENDE STANGE

int body_minus(string str)  {
  object ob;
  int oldbody;
  oldbody=QueryProp(P_BODY);

  notify_fail("Was willst Du ausreissen?!\n");

  if(member(({"schuppe aus", "schuppen aus"}),str)!=-1)   {

    ob=present("TIREKS_HAKEN", TP);


    if(!ob)  {
      say(CAP_TPN+" reisst verzweifelt an Tireks herum!\n"
          "Tireks schlaegt seine Zaehne in "+TPN+"!\n", ({TP}));
      write("Du versuchst ohne geeignete Waffe Tireks etwas auszureissen.\n"
          "Tireks dreht sich zu Dir und schlaegt seine Zaehne in Dich!\n");
      TP->do_damage(50+random(50));
      return 1; 
    }


    if((ob) && (!ob->QueryProp(P_WIELDED) ))   {
      write("Du hast Deinen Haken nicht gezueckt und versuchst es ohne.\n"
          "Tireks trifft Dich mit voller Wucht am Kopf!\n");
      say(CAP_TPN+" versucht Tireks ohne Haken eine Schuppe auszureissen.\n"
          "Tireks trifft "+TPN+" voll am Kopf!\n", ({TP}));
      TP->do_damage(50+random(50));  return 1; 
    }

    if(ob->QueryProp(P_WIELDED)) {

      if(QueryProp(P_BODY)<= 100)  {
        say(CAP_TPN+" versucht Tireks mit einem Haken eine Schuppe auszureissen.\n"
            ""+TPN+" scheitert leider.\n", ({TP}));

        write("Du versuchst mit Deinem Haken Tireks eine Schuppe auszureissen.\n"
            "Du scheiterst klaeglich!\n");   return 1; 
      }

      else {
        if(nixda!=0)  {
          write("So schnell kannst Du die Schuppen nicht ausreissen!\n");
          return 1; 
        }

        switch(random(20))  {

          case 0..8:
            say(CAP_TPN+" reisst Tireks mit einem Haken eine Schuppe aus.\n"
                "Tireks bruellt vor Schmerzen auf.\n", ({TP}));
            write("Du reisst mit Deinem Haken Tireks eine Schuppe aus dem Panzer.\n"
                "Tireks bruellt vor Schmerzen auf!\n");
            SetProp(P_BODY,oldbody-1);

            write_file("/d/dschungel/dante/stein/log/schuppen",
                ctime()+": 1 Schuppe von "+TPN+" ausgerissen.\n");
            TO->do_damage(5+random(5));    
            break;     


          case 9..12:
            say(CAP_TPN+" reisst Tireks mit einem Haken zwei Schuppen aus.\n"
                "Tireks bruellt vor Schmerzen auf.\n", ({TP}));
            write("Du reisst mit Deinem Haken Tireks zwei Schuppen aus dem Panzer.\n"
                "Tireks bruellt vor Schmerzen auf!\n");
            SetProp(P_BODY,oldbody-2);

            write_file("/d/dschungel/dante/stein/log/schuppen",
                ctime()+": 2 Schuppen von "+TPN+" ausgerissen.\n");
            TO->do_damage(10+random(5));     
            break;     

          case 13..15:
            say(CAP_TPN+" reisst Tireks mit einem Haken drei Schuppen aus.\n"
                "Tireks bruellt vor Schmerzen auf.\n", ({TP}));
            write("Du reisst mit Deinem Haken Tireks drei Schuppen aus dem Panzer.\n"
                "Tireks bruellt vor Schmerzen auf!\n");
            SetProp(P_BODY,oldbody-3);

            write_file("/d/dschungel/dante/stein/log/schuppen",
                ctime()+": 3 Schuppen von "+TPN+" ausgerissen.\n");
            TO->do_damage(15+random(5));     
            break;     

          case 16..18:
            write("Du versuchst Tireks mit Deinem Haken eine Schuppe auszureissen!\n"
                "Tireks dreht sich schnell weg und Du schaffst es nicht.\n");
            say(CAP_TPN+" versucht Tireks eine Schuppe auszureissen.\n"
                "Tireks ist aber zu schnell.\n", ({TP}));
            write_file("/d/dschungel/dante/stein/log/schuppen",
                ctime()+": 0 Schuppen von "+TPN+" ausgerissen.\n");
            break;     


          case 19:
            write("Du versuchst Tireks mit Deinem Haken eine Schuppe auszureissen!\n"
                "Tireks dreht sich schnell weg und trifft Dich mit seinem Schwanz.\n");
            say(CAP_TPN+" versucht Tireks eine Schuppe auszureissen.\n"
                "Tireks schlaegt "+TPN+" mit seinem Schwanz.\n" ,({TP}));
            TP->do_damage(20+random(20));//ev erhoehen
            write_file("/d/dschungel/dante/stein/log/schuppen",
                ctime()+": 0 Schuppen von "+TPN+" ausgerissen und Spielerschaden.\n");
            break;     
          default: write("Sorry, shutdown!\n");
        }
        nixda=1;
        call_out("nexttry", TIME);
        return 1;
      }
      return 1; 
    }
    return 0; 
  }
  return 0; 
}


void nexttry() {
  nixda=0;  
}

//ende

int Defend(int dam, mixed dtype, int spell, object enemy)
{
  if (!pointerp(dtype))
    dtype = ({ dtype });

  if (member(dtype, DT_BLUDGEON ) != -1)
  {
    tell_room(environment(), "Tireks schaut Dich nur stumm an!!!\n");
    return ::Defend(0, dtype,spell, enemy);
  }

  if (member( dtype, DT_FIRE ) != -1)
  {
    tell_room(environment(), "Tireks freut sich sehr ueber diesen "
        +"Angriff!\n");
    heal_self(dam/2);
    return ::Defend(0, dtype, spell, enemy);
  }

  if (member( dtype, DT_UNHOLY ) != -1)
  {        
    tell_room(environment(), "Tireks freut sich ueber diesen Angriff!\n");
    heal_self(dam);
    return ::Defend(0, dtype, spell, enemy);
  }
  //muss sein wegen vorteil fuer paladine

  if (member( dtype, DT_HOLY ) != -1)
  {        
    tell_room(environment(), "Tireks lacht sich ueber diesen Angriff tot!\n");
    heal_self(0);
    return ::Defend(0, dtype, spell, enemy);
  }

  return ::Defend(dam, dtype, spell, enemy);
}

invis1()
{

  object ob;
  object ob2;
  object bone;

  // alles selbst geclonte silent (1) remove'n
  mystuff -= ({0});
  filter_objects( mystuff, "remove", 1 );

  if (bone=present("knochen",TO))
  {
    bone->remove();
  }

  if (ob=present("auge",TO))
  {
    ob->remove();
  }

  if (ob2=present("wandler",TO))
  {
    ob2->remove();
  }

  call_out("invis3",0);

}


invis3()
{
  write_file("/d/dschungel/dante/stein/log/tirekswirdvis",
      "Am "+ctime()+" haut Tireks ab.\n"); 
  tell_room(environment(this_object()),
      "Tireks wird wieder unsichtbar und verschwindet!\n");
  remove();
}


void spell_stone_shield(object enemy, int damage, mixed dam_type){
  object ob;
  ob=present("TIREKS_AMU", enemy);

  if(ob)
  {

    if(ob->QueryWorn())  {
      tell_object(enemy,
          "Dein Steinamulett schuetzt Dich vor dem Steinschlag!\n");
      tell_room(environment(enemy),
          "Das Steinamulett schuetzt "+TPN+" vor dem Steinschlag!\n",
          ({enemy}));   }


      if(!ob->QueryWorn())  {
        tell_object(enemy,
            "Der Steinschlag trifft Dich mit voller Wucht!!!\n"
            "Dein Steinamulett leuchtet hell auf!!!\n");

        enemy->Defend(1000+random(1000), DT_BLUDGEON,
            ([SP_SHOW_DAMAGE: 1]));

        tell_room(environment(enemy),
            "Der Steinschlag trifft "+TPN+" voll!!!\n",
            ({enemy}));   }	 

  }

  if(!ob)  {
    tell_object(enemy,
        "Der Steinschlag trifft Dich mit voller Wucht!!!\n"
        "Dir scheint etwas Bestimmtes zu fehlen!!!\n");

    enemy->Defend(2000+random(1000), DT_BLUDGEON,
        ([SP_SHOW_DAMAGE: 1]));

    tell_room(environment(enemy),
        "Der Steinschlag trifft "+TPN+" voll!!!\n",
        ({enemy}));   }	 
}






