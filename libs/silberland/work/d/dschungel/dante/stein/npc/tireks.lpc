inherit "std/mnpc";

//heilen bei bludgeon rausgenommen
//20.5.99
//umbau spellrate, hands, spezialspells dante
#define QUESTKEY "Kampf dem Ungeheuer Tireks"
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "/players/dante/myowndefine.h"
#include <mnpc.h>
#define TIME 1   //delaytime nach spezialattacke
#define SPR 80  //spellrate


#define HAUTAB 2400

//zeit minimal erhoeht!!!! dante 99.11.

int hands=600;  //selbsterklaerend oder?

object *mystuff;        // Array von Objekten - hier speichern wir,
// was sich der Tireks selbst gecloned hat.
int nixda, nixda2, nixda3;

string *killers=({"cute","gomli","sengir","conan","baldur",
    "gaaron","ramirez","carla","chlchmd","justavius","sol",
    "slayven","dante"});


void init()  {
  ::init();
  if(!interactive(TP)) return;

  //    if(IS_WIZARD(TP)) return

  if(member_array(getuid(TP), killers)!=-1)  {
    call_out("tag", 1);     }

}


void tag(object enemy)  {
  int i;

  string *wo;

  wo=({"Kopf","Bein","Hals","Fuss","Bauch","Arm","Ruecken",
      "Hals","Auge","Ohr","Schulterbereich","Nacken","Knie"});

  i=random(sizeof(wo));

  enemy=TP;
  if(environment(TP)!=environment(TO)) return;

  write(BS(
        "Tireks stuerzt sich mit Todesverachtung auf Dich, "+CAP(getuid(TP))+"! "
        "Er will seinen Tod raechen und Dich diesmal vernichten!"));


  shout(BS(
        "Tireks stuerzt sich mit lautem Bruellen auf "+CAP(getuid(TP))+"!"
        " Er will seinen Tod raechen und "+CAP(getuid(TP))+" diesmal toeten!"));



  switch(random(100))   {

    case 0..20:
      write(BS(
            "Tireks trifft Dich leicht am "+wo[i]+"!"));
      tell_room(environment(TO),
          "Tireks trifft "+enemy->name(WEN)+" leicht am "+wo[i]+"!\n", ({enemy}));
      enemy->do_damage(5);
      break;

    case 21..35:
      write(BS(
            "Tireks trifft Dich am "+wo[i]+"!"));
      tell_room(environment(TO),
          "Tireks trifft "+enemy->name(WEN)+" am "+wo[i]+"!\n", ({enemy}));
      enemy->do_damage(10);
      break;

    case 36..50:
      write(BS(
            "Tireks trifft Dich hart am "+wo[i]+"!"));
      tell_room(environment(TO),
          "Tireks trifft "+enemy->name(WEN)+" hart am "+wo[i]+"!\n", ({enemy}));
      enemy->do_damage(15);
      break;

    case 51..60:
      write(BS(
            "Tireks trifft Dich sehr hart am "+wo[i]+"!"));
      tell_room(environment(TO),
          "Tireks trifft "+enemy->name(WEN)+" sehr hart am "+wo[i]+"!\n", ({enemy}));
      enemy->do_damage(20);
      break;

    case 61..99:
      write(BS(
            "Tireks verfehlt Dich!"));
      tell_room(environment(TO),
          "Tireks verfehlt"+enemy->name(WEN)+"!\n", ({enemy}));
      break;

    default:
      write(BS(
            "Tireks trifft Dich leicht am "+wo[i]+"!"));
      tell_room(environment(TO),
          "Tireks trifft "+enemy->name(WEN)+" leicht am "+wo[i]+"!\n", ({enemy}));
      enemy->do_damage(5);


  }

  killers-=({ getuid(TP) });

  /* for(i=0; i<sizeof(killers); i++)  {
     write(""+killers[i]+"\n");  }
     testfunc
     */ 

}





void create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Tireks");

  SetProp(P_LONG, BS(
        "Der Tireks ist ein abscheuliches Monster aus einer anderen Zeit. "
        "Mutige Abenteurer und waghalsige Forscher haben ihn in einer anderen Welt gefunden, gefangen und "
        "wollten ihn zu einer Attraktion machen. Doch leider hat der Tireks die "
        "Eigenschaft in unserer Welt unsichtbar zu sein, es sei denn man behandelt "
        "ihn mit einem Spezialspray, doch auch diese Wirkung haelt nur kurze Zeit an. "
        "Neben Tireks wirkst Du wie ein kleiner Wurm, alleine sein Schatten ist furcht"
        "einfloessend. In seinem gigantischen, blutverschmierten Maul blitzen "
        "spitze, dolchartige Zaehne auf, so lang wie Deine Beine. Aus kleinen, "
        "jedoch hinterhaeltig und brutal wirkenden Augen sieht er Dich an, und "
        "Du weisst, dass hier zu sein ein grosser Fehler ist. Sein langer, mit "
        "spitzen Haken versehener Schwanz wirbelt surrend durch die Luft, und "
        "Gnade sei dem, den er zerschmettert. Seine Arme, verziert durch lange, "
        "gebogene Krallen, floessen Dir Furcht ein. Sie sind nur dazu da, unvorsichtige "
        "Spieler wie Dich zu zerfetzen. Staemmige Beine, die ihm sowohl "
        "Schnelligkeit und Standfestikeit verleihen, dienen ihm dazu, Dich zu zerquetschen. "
        "Sein gesamter Koerper ist ueberzogen mit einer undurchdringbaren, gruen und "
        "schwarz schmimmernden harten Haut, die besser als jeder Panzer den Du "
        "kennst, ihn zu schuetzen vermag. Du erblasst vor Ehrfurcht, ergibst Dich Deinem "
        "Schicksal und erwartest einen schnellen Tod. Diesem nur zum Toeten erschaffenen "
        "Monster aus laengst vergangenen Tagen, bist Du nicht gewachsen..."));

  AddDetail("schatten",
      "Der Schatten ist groesser als ein Berg.");
  AddDetail("maul",
      "Sein Maul ist so gross wie ein Tor.");
  AddDetail(({"zahn","zaehne"}),
      "Die Zaehne zerreisen Dich in Sekunden...");
  AddDetail(({"auge","augen"}),
      "Listig und brutal.");
  AddDetail("schwanz",
      "Tireks schlaegt damit hin und her.");
  AddDetail(({"arm","arme"}),
      "Komm ihnen nicht in die Quere!");
  AddDetail(({"kralle","krallen"}),
      "Eine Bekanntschaft mit ihnen, waere die erste und letzte. "
      "Angeblich kann man mit einer speziellen Waffe die Krallen nach "
      "und nach entschaerfen!!!");
  AddDetail("bein",
      "WUMMMM!!!");
  AddDetail("haut",
      "Seine Haut ist undurchdringbar. Nur eine Stelle, direkt ueber "
      "dem Magiezentrum von Tireks scheint nicht so stark zu sein!!!");
  AD("stelle",
      "Diese Stelle ist sicher mit der geeigneten Waffe zu durchdringen!");
  AD(({"zentrum","magiezentrum"}),
      "Hier muesste man mit einer geeigneten Waffe hineinstechen. Die "
      "Magie von Tireks wuerde sicher darunter leiden!!!");
  AddDetail("koerper",
      "Massig und doch blitzschnell.");
  AddDetail("panzer",
      "Sein Panzer besteht aus stahlharten Schuppen.");
  AddDetail(({"schuppen","schuppe"}),
      "Die Schuppen sind extrem hart. Angeblich kann man sie aber ausreissen!!!");

  SetProp(P_NAME, "Tireks");
  SetProp(P_GENDER, MALE);
  AddId(({"tireks"}));
  set_living_name("tireks");
  SetProp(P_TRANSPARENT, 0);
  create_default_npc(52);
  SetProp(P_HANDS, ({" mit seinen furchtbaren Klauen",hands+1,({DT_RIP, DT_PIERCE, DT_BLUDGEON })}));
  SetProp(P_RACE, "Monster");
  SetProp(P_SIZE, 800);
  SetProp(P_ALIGN, -300);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_WEIGHT, 10000000);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,1);
  SetProp(P_WIMPY, 0);
  SetProp(P_FOOD,0);
  SetProp( P_RESISTANCE_STRENGTHS,([DT_BLUDGEON: -0.5 ,DT_FIRE: -0.6, 
       DT_SLASH: -0.5, DT_MAGIC:-0.6, DT_HOLY: 0.1, DT_ACID:0.6, DT_COLD:-0.7,
       DT_TERROR:-1.0,DT_RIP:-0.5, DT_ELECTRIC: 0.5]));

  SetProp(P_BODY, 200);//???hmm zu hart?

  //spieler koennen
  //body koennen, wenn sie schuppen ausreissen
  //min body im mom 100

  SetProp(P_NOMAGIC, 20); // ... und dafuer die nomagic erhoeht. Angrox.

  /*
     fuer angrox: ich habe die restists teilweise erniedrigt.....
     -1.0 is zu stark gewesen, und die nomagic auf um 5 gesenkt...


*/

  SP(P_XP, 10000000);

  SetProp(P_MSGIN, "stampft bruellend auf Dich zu");
  SetProp(P_MSGOUT, "stampft bruellend");
  SetProp(P_MMSGIN, "wird ploetzlich durch die magische Farbe sichtbar");
  SetProp(P_MMSGOUT, "wird ploetzlich wieder unsichtbar");
  SetProp(P_MNPC_AREA, ("/d/dschungel/dante/stein/room/monster"));
  SetProp(P_MNPC_FLAGS, MOV_INDOORS + MOV_MOVES+MOV_BACKWARDS );
  SetProp(P_MNPC_WAIT, ({50+random(10), 30, 20}));
  SetProp(P_MNPC_DEFAULTROOM,  "/d/dschungel/dante/hoehle/room/monster4");



  SetProp(P_DIE_MSG,  " stuerzt mit lautem Gebruell zu Boden und wird wieder unsichtbar.\n");
  SetProp(P_NOCORPSE, 1);

  SetProp(P_MURDER_MSG, "ICH KOMME WIEDER!!!");
  SetProp(P_KILL_NAME, "Tireks");
  SetProp(P_KILL_MSG, "bruellt: Hmm, das war lecker! Der naechste bitte!!! Ihr Feiglinge!!!");
  SetProp(P_MSG_FLAGS, ([P_KILL_MSG:1, P_MURDER_MSG:0 ]));

  SetProp(P_ARTICLE, 0);
  AddInfo(DEFAULT_INFO, "bruellt Dich nur an.\n");
  AddInfo("dante", "Dante hat mich erschaffen.","sagt: ");

  SetProp( P_REJECT, ({ REJECT_DROP,
        "Was soll Tireks mit Deinem Schrott.\n" }) );


  SetProp(P_SPELLRATE, SPR);//spellrate erhoeht wegen stange!!!

  AddSpell(4,800,
      "Tireks schlaegt Dir seine Krallen in den Leib.\n",
      "Tireks schlaegt @WEM seine Krallen in den Leib.\n",
      DT_RIP,([SP_SHOW_DAMAGE:1]));
  AddSpell(4,700,
      "Tireks huellt Dich in eine Feuerwolke ein.\n",
      "Tireks huellt @WEN in eine Feuerwolke ein.\n",
      DT_FIRE,([SP_SHOW_DAMAGE:1]));
  AddSpell(4,600,
      "Tireks versucht Dich mit seinen gewaltigen Beinen zu zertreten.\n",
      "Tireks versucht @WEN mit seinen gewaltigen Beinen zu zertreten.\n",
      DT_SQUEEZE,([SP_SHOW_DAMAGE:1]));
  AddSpell(4,900,
      "Tireks probiert Dir den Kopf abzureissen.\n",
      "Tireks probiert @WESSEN Kopf abzureissen.\n",
      DT_TERROR,([SP_SHOW_DAMAGE:1]));
  AddSpell(4,700,
      "Tireks spuckt Fluesse von Magensaeure auf Dich.\n",
      "Tireks spuckt Fluesse von Magensaeure auf @WEN.\n",
      DT_ACID,([SP_SHOW_DAMAGE:1]));
  AddSpell(4,700,
      "Tireks schlaegt Dir den Boden unter den Beinen weg.\n",
      "Tireks schlaegt @WEM den Boden unter den Beinen weg.\n",
      DT_WHIP,([SP_SHOW_DAMAGE:1]));
  AddSpell(4,700,
      "Tireks speit einen gewaltigen Wasserstrahl auf Dich.\n",
      "Tireks speit einen gewaltigen Wasserstrahl auf @WEN.\n",
      DT_WATER,([SP_SHOW_DAMAGE:1]));
  AddSpell(1,1500,
      "Tireks schlaegt Dir seine Klauen genau ins HERZ!!!\n",
      "Tireks schlaegt seine Klauen genau in @WESSEN HERZ!!!\n",
      DT_RIP,([SP_SHOW_DAMAGE:1]));
  AddSpell(2,150,
      "Tireks loest einen Steinschlag aus!!!\n",
      "Tireks loest ueber @WEM einen Steinschlag aus!!!\n",
      DT_BLUDGEON,"spell_stone_shield",([SP_SHOW_DAMAGE:1]));
  AddSpell(2,150,
      "Tireks schleudert einen gigantischen Felsbrocken auf Dich!!!\n",
      "Tireks schleudert einen gigantischen Felsbrocken auf @WEN!!!\n",
      DT_BLUDGEON,"spell_stone",([SP_SHOW_DAMAGE:1]));
  AddSpell(1,150,
      "Tireks versetzt Dir einen extrem harten Schlag auf die Arme.\n",
      "Tireks versetzt @WEM einen extem harten Schlag auf die Arme.\n",
      DT_BLUDGEON,"spell_waffe",([SP_SHOW_DAMAGE:1]));
  AddSpell(1,150,
      "Tireks schlaegt Dir mit ungeheurer Wucht auf den Oberkoerper.\n",
      "Tireks schlaegt @WEN mit ungeheurer Wucht auf den Oberkoerper.\n",
      DT_BLUDGEON,"spell_ruestung",([SP_SHOW_DAMAGE:1]));
  AddSpell(1,150,
      "Tireks schlaegt Dir mit grosser Wucht auf den Kopf.\n",
      "Tireks schlaegt @WEN mit grosser Wucht auf den Kopf.\n",
      DT_BLUDGEON,"spell_sleep",([SP_SHOW_DAMAGE:1]));
  AddSpell(1,100,
      "Tireks versucht Dir Deinen Koerper zu stehlen.\n",
      "Tirels versucht @WESSEN Koerper zu stehlen.\n",
      DT_MAGIC, "spell_ghost",([SP_SHOW_DAMAGE:1]));
  AddSpell(1, 2000, // Lassen wir den Spell mal, der koennte sich als
      // 'SPielerkiller' erweisen. Wenn zu heftig -> abwerten
      "TIREKS ZERQUETSCHT DICH!!!\n",
      "TIREKS ZERQUETSCHT @WEN!!!\n",
      DT_SQUEEZE, ([SP_SHOW_DAMAGE:1]));        
  AddSpell(2,400,
      "Tireks versucht Dich aus seiner Hoehle zu schleudern.\n",
      "Tireks versucht @WEN aus seiner Hoehle zu schleudern.\n",
      DT_TERROR, "spell_away",([SP_SHOW_DAMAGE:1]));



  SetAttackChats(10, ({
        "Tireks bruellt Dich laut an.\n",
        "Du zitterst aus Angst!\n",
        "Tireks kommt immer naeher an Dich heran.\n",
        "Du brichst beinahe zusammen.\n",
        "Tireks draengt Dich zurueck.\n",
        "Dein Atem rast dahin...\n",
        "Tireks kommt direkt auf Dich zu.\n",
        "Fluechte lieber...\n",
        "Tireks schaut Dir genau in die Augen.\n",
        "Tireks tobt wie wild...\n",
        "Tireks will Dich vernichten.\n"}) );


  call_out("invis1", HAUTAB); // Sicherheitshalber auf 30 mins erhoeht. 
  // Sollten die spieler ihn zu schnell schaffen ->
  // senken. angrox. auf 2000 erhoeht spieler
  //hatten auch zu 4 extreme probleme

  SUID;
  CLONEME("/d/dschungel/dante/stein/weapon/tpei");
  CLONEME("/d/dschungel/dante/stein/obj/auge");
  CLONEME("/d/dschungel/dante/stein/obj/auge");
  CLONEME("/d/dschungel/dante/stein/armour/tbone");
  CLONEME("/d/dschungel/dante/stein/armour/thaut");


  mystuff = all_inventory(this_object());

  AddCmd(({"stich","steche","stech"}), "spell_rate_minus");
  AddCmd(({"reiss","reisse"}), "body_minus");
  AddCmd(({"hacke","hack"}), "hands_minus");


}

//hands beginn


int hands_minus(string str)  {
  object ob;

  ob=present("TIREKS_AXT", TP);

  notify_fail("Was willst Du abhacken?!\n");


  if(member(({"kralle", "kralle ab", "krallen", "in kralle",
          "in krallen", "tireks krallen ab", "tireks kralle ab"}), str)!=-1)   {

    if(!ob)  {
      say(CAP_TPN+" versucht verzweifelt Tireks Krallen abzuhacken!!!\n"
          "Tireks schlaegt seine Zaehne in "+TPN+"!\n", ({TP}));

      write(
          "Du versuchst ohne geeignete Waffe Tireks Krallen abzuhacken.\n"
          "Tireks dreht sich zu Dir und schlaegt seine Zaehne in Dich!\n");
      TP->do_damage(50+random(50));
      return 1; 
    }


    if((ob) && (!ob->QueryProp(P_WIELDED) ))   {
      write("Du hast Deine Axt nicht gezueckt!!!\n"
          "Tireks trifft Dich mit voller Wucht am Kopf!\n");
      say(CAP_TPN+" versucht Tireks Krallen abzuhacken!!!\n"
          "Tireks trifft "+TPN+" voll am Kopf!\n", ({TP}));
      TP->do_damage(50+random(50));  return 1; 
    }

    if (hands<=100)   {
      write(BS("Du hackst brutal auf Tireks Krallen ein, "
            "doch die Krallen sind schon so verstuemmelt, dass auch das"
            "nicht viel bringt!!!"));
      return 1; 
    }  


    if(ob->QueryProp(P_WIELDED)) {


      write(BS("Du versuchst die Krallen von Tireks abzuhacken!!!"));

      say(CAP_TPN+" versucht die Krallen von Tireks abzuhacken!!!\n", ({TP}));

      if(nixda3!=0)  {
        write("So schnell kannst Du nichts abhacken!!!!\n");
        return 1; 
      }




      else  {

        switch(random(20))  {

          case 0..8:
            write(BS("Du schwingst die Axt und triffst die Krallen von Tireks leicht!"));
            say(
                CAP_TPN+" trifft die Krallen von Tireks leicht!\n",
                ({TP}));
            hands-=2;
            SetProp(P_HANDS, 
                ({" mit seinen furchtbaren Klauen",hands,
                 ({DT_RIP, DT_PIERCE, DT_BLUDGEON })}));

            write_file("/d/dschungel/dante/stein/log/hands",
                ctime()+": Minus 2 von "+TPN+".\n");
            TO->do_damage(5+random(5));    
            break;     





          case 9..12:
            write(BS(
                  "Du schwingst die Axt und triffst die Krallen von Tireks hart!"));
            say(
                CAP_TPN+" trifft die Krallen von Tireks hart!\n",
                ({TP}));
            hands-=4;
            SetProp(P_HANDS, 
                ({" mit seinen furchtbaren Klauen",hands,
                 ({DT_RIP, DT_PIERCE, DT_BLUDGEON })}));
            write_file("/d/dschungel/dante/stein/log/hands",
                ctime()+": Minus 4 von "+TPN+".\n");
            TO->do_damage(10+random(5));    
            break;     




          case 13..15:
            write(BS(
                  "Du schwingst die Axt und triffst die Krallen von Tireks sehr hart!"));
            say(
                CAP_TPN+" trifft die Krallen von Tireks sehr hart!\n",
                ({TP}));
            hands-=6;
            SetProp(P_HANDS, 
                ({" mit seinen furchtbaren Klauen",hands,
                 ({DT_RIP, DT_PIERCE, DT_BLUDGEON })}));

            write_file("/d/dschungel/dante/stein/log/hands",
                ctime()+": Minus 6 von "+TPN+".\n");

            TO->do_damage(20+random(5));    
            break;     

          case 16..18:
            write(BS("Du verfehlst mit der Axt Tireks total!"));
            say(
                CAP_TPN+" verfehlt mit der Axt Tireks total!\n",
                ({TP}));

            write_file("/d/dschungel/dante/stein/log/hands",
                ctime()+": Minus 0 von "+TPN+".\n");
            break;     


          case 19:
            write(BS("Dein Axthieb trifft Tireks nicht, sondern Dich selbst!!!"
                  "Du verletzt Dich selbst mit Deiner Axt!!!!"));
            say(
                CAP_TPN+" trifft sich selbt mit der Axt!!!\n",({TP}));
            TP->do_damage(10+random(10));

            write_file("/d/dschungel/dante/stein/log/hands",
                ctime()+": Selbstgetroffen mit Axt von "+TPN+".\n");
            break;     
          default: write("Sorry, shutdown!\n");
        }
        nixda3=1;
        call_out("nexttry3", TIME);
        return 1;
      }
      return 1; 
    }
    return 0;
  }
  return 0; 
}


void nexttry3() {
  nixda3=0;  
}


