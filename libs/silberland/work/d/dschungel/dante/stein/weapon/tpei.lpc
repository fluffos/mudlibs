//tireks schwanz als waffe peitsche
//wird je nach splitter besser

inherit "std/weapon";

#include <properties.h>     // Properties definieren 
#include <combat.h>         // Kampfspezifische Daten        		
#include <language.h>       // Definition von MALE, FEMALE, NEUTER, WER, ...
#include <new_skills.h>

#include "files.h"

#pragma combine_strings
// ;-)))
int anzahl, rounds;

void create()
{
  
  if (!is_clone(TO)) return;
  ::create();
  
  rounds=0;
  
  AddId (({"peitsche", "schwanz", "tireksschwanz"}));       // IDs
  SetProp(P_SHORT, "Der Schwanz von Tireks");    //Kurzbeschreibung
  SetProp(P_LONG, 
      "Das ist der Schwanz des sagenumwobenen Monster Tireks. Er sieht wie "
      "eine dicke, extrem harte, aber doch leicht zu fuehrende Peitsche aus. "
      "Stahlharte, gezackte Schuppen reissen die Haut Deiner Opfer auf. 7 "
      "grosse Zacken am Ende des Schwanzes zerfetzen alles, was ihnen in die "
      "Quere kommt. Teilweise weisst der Schwanz viele, kleine Loecher auf, "
      "deren Sinn Dir noch nicht klar ist...");
  anzahl=0;
  AddDetail(({"schuppe", "schuppen"}),
      "Die Schuppen haben gezackte Raender.");
  AddDetail(({"rand", "raender"}),
      "vvvvvvvvvvvvvvvvvvv\n");
  AddDetail("sinn",
      "Hmm, sie haben sicher einen...");
  AddDetail("tireks",
      "Ein furchtbares Monster, aber scheinbar nicht unbesiegbar.");
  AddDetail("monster",
      "Zitter, heul, jammer...");
  AddDetail("ende",
      "Mach das lieber nicht.");
  AddDetail(({"zacke", "zacken"}),
      "VVVVVVVVVV");
  AddDetail("opfer",
      "Probiers mit dem Wassergeist, dem Orkandaemon oder vielleicht mit "
      "der boesartigen Gewitterwolke.");
  
  
  AddSpecialDetail(({"loch", "loecher", "splitter", "zahn", "zaehne"}),"show");
  SetProp(P_NAME, "Tireksschwanz"); 
  SetProp(P_GENDER, MALE);  
  SetProp(P_VALUE, 15005+random(5000)); 
  SetProp(P_WEIGHT, 900); 
  SetProp(P_MAGIC, 1);
  SetProp(P_WEAPON_TYPE, WT_WHIP);
  SetProp(P_DAM_TYPE, ({DT_WHIP, DT_TERROR, DT_PIERCE, DT_RIP, DT_MAGIC})); 
  SetProp(P_NOBUY, 1);
  SetProp(P_WC, 245);
  SetProp(P_WC_FIX, 50);
  SetProp(P_QUALITY_DECAY, 150);      
  SetProp(P_NR_HANDS, 2);
  SetProp(P_HIT_FUNC, TO);
  SetProp(P_MATERIAL, ([MAT_SKIN:30, MAT_HORN:40, MAT_BONE:30]));
  SetProp(P_WIELD_RESTRICTIONS, ([A_STR: 20, A_INT:10, A_DEX:25]));

  SetProp(P_INFO,BS("Die Loecher in dem Schwanz haben den Sinn, dass man in sie "
  "die Splitter von Tireks Gebiss stecken kann, und so die Waffe mit spitzen, "
  "gefaehrlichen, kleinen Spiessen bestueckt, was ihre Wirkung natuerlich "
  "verbessert. Je mehr, umso besser! Die Syntax dafuer ist neuerdings "
  "< bestuecke splitter in loch >. Mit < tireksentferne anzahl splitter > "
  "kannst Du die Splitter wieder herausnehmen."));

  AddCmd(({"bestuecke", "bestueck", "doin"}), "putin");
  AddCmd(({"tireksentferne", "tireksentfernen"}), "get_out");
}


string show()
{
  if (!anzahl)
  {
    write("Der Schwanz von Tireks ist noch nicht bestueckt.\n");
  }
  else
  {
    write("Der Schwanz von Tireks ist mit "+anzahl+" Splitter bestueckt.\n");
  }
  return "";
}


get_out(string str)  {
  object ob, hatschon;
  int spl;
  int oldval;
  oldval=TO->QueryProp(P_VALUE);

  notify_fail("Wieviele Splitter?! Eine ganze Zahl bitte! Maximal "+anzahl+"! "
      "<tireksentferne anzahl splitter>\n");
  if(!str) return 0;

  if(sscanf(str, "%d splitter",spl)) {

    if(anzahl<=0)   {
      write(BS(
            "In Deinem Schwanz stecken keine Splitter!"));
      return 1; 
    }

    if(spl>anzahl)   {
      write(BS(
            "Du kannst kaum "+spl+" Splitter aus dem Schwanz nehmen, wenn da nur "
            ""+anzahl+" Splitter im Schwanz stecken. Dieser versuchte Betrug wurde "
            "automatisch mitgeloggt und der Sheriff per Mudmail informiert."));
      return 1;
    }

    //wir gehen auf nummer sicher.
    if(spl<=anzahl)   {
      hatschon=present("\nspli_dante", TP);

      if(!hatschon)
      {	
        ob=clone_object("d/dschungel/dante/stein/obj/spli");
        ob->SetProp(P_AMOUNT, spl);

        anzahl=anzahl-spl;
        TO->SetProp(P_VALUE, oldval -(100*spl) );

        ob->move(TP, M_NOCHECK);
        write(BS("Du nimmst "+spl+" Splitter aus dem Schwanz von Tireks."));
        say(BS(CAP_TPN+" nimmt "+spl+" Splitter aus dem Schwanz von Tireks."));
        return 1; 
      }

      if(hatschon)  {
        hatschon->AddAmount(spl);
        anzahl=anzahl-spl;
        TO->SetProp(P_VALUE, oldval -(100*spl) );

        write(BS("Du nimmst "+spl+" Splitter aus dem Schwanz von Tireks."));
        say(BS(CAP_TPN+" nimmt "+spl+" Splitter aus dem Schwanz von Tireks."));

        return 1; 
      }
    }

    return 0; 
  }

  return 0; 
}


putin(string str)
{
  int spl;
  object ob;
  int oldval;
  oldval=TO->QueryProp(P_VALUE);


  notify_fail("Was willst Du wo hineinstecken bzw bestuecken?!\n");
  if (!str) return 0;

  if (!present("\nspli_dante", TP))
  {
    write("Du hast nichts geeignetes dafuer.\n");
    return 1;
  }

  if(member(({"splitter in loch", "splitter in loecher", "splitter in peitsche",
          "splitter in schwanz", "zaehne in loch", "zahn in loch", "zahn in peitsche",
          "zaehne in peitsche", "zaehne in schwanz", "zahn in schwanz"}), str)!=-1)
  {
    write("Wieviele Splitter willst Du in die Peitsche stecken?\n");
    write("<bestuecke anzahl splitter in peitsche>\n");
    return 1;
  }

  if(sscanf(str, "%d splitter in peitsche",spl)) 
  {
    int menge;

    ob=present("\nspli_dante", TP);
    menge=ob->QueryProp(P_AMOUNT);
    if(anzahl>=51)
    {
      write("Du kannst leider keine Splitter mehr in den Schwanz "
          "stecken. Da ist kein Platz mehr, sorry.\n");
      return 1;
    }
    if(anzahl+spl>=51)
    {
      write("Soviele Splitter haben keinen Platz mehr im Schwanz!\n");
      return 1;
    }
    if((menge) >= (spl))       
    {
      write("Du steckst "+spl+" Splitter in die Peitsche!\n");
      ob->AddAmount(-spl);
      TO->SetProp(P_VALUE, (100*spl)+oldval);
      anzahl=anzahl+spl;
      return 1;
    }
    else
    {
      write("Du willst "+spl+" in die Peitsche stecken, hast aber "
          "nur "+menge+" Splitter!\n");
      return 1;
    }  

    return 1;
  }
  return 0;
}


int HitFunc(object enemy)
{
  int pllev, pldex, damself;

  if( (pllev=TP->QueryProp(P_LEVEL)) > 70) pllev = 70;
  pldex=TP->QueryAttribute(A_DEX);
  damself=anzahl-pldex;
  rounds++; 
  if(anzahl>50) anzahl=50; 
  if(anzahl>0 && ( enemy->QueryProp(P_TOTAL_AC)>100) )
    //es ist nicht logisch wenn einem bei ner maus ne zacke ausbricht...
    //dante 16.8.2000
  {
    switch(random(2000))
    {
      case 0..2:
        tell_object(environment(TO),
            "Ein Splitter Deiner Peitsche bricht aus.\n");
        anzahl--;
        break;
      case 3..4:
        tell_object(environment(TO),
            "Ein Splitter Deiner Peitsche bricht aus und verletzt Dich!\n");
        TP->do_damage(10+random(20));
        anzahl--;
        break;
      case 5..1999:
        break;
      default:write("BUG!\n");
    }
  }

  //die sache mit dem 100-pllevel kann ein problem werden, wenn die spieler mal
  //groesser levl 100 haben
  // pllev jetzt auf 70 limitiert.. ist zu stark sonst - Feyaria
  /*if((anzahl!=0)&&(rounds!=(100-(pllev))))
  {

    //das hier is die variante von woody,
    //hatte zur folge das man sich andauernd auch mit z.b nur 4 splittern
    //selbst traf...wasnet sinn der sache war
    //also alte variante rein      
    //      if(damself>0&&random(anzahl)>=(anzahl-damself)) 


//    if(damself>0 && random(anzahl)>damself)  
//    auch unlogisch, da trifft man sich weniger oft je mehr splitter drinnen sind
    if(random(damself) > random(10) && random(pldex) < random(damself))  
    {
      tell_object(environment(TO),
          "Die Peitsche surrt herum und trifft Dich!!!\n");
      TP->Defend(damself*damself,DT_TERROR,0,TO);
    }
  }*/
  if(rounds==(100-(pllev)))
  {
    tell_object(environment(TO),
        "Deine Peitsche zischt laut durch die " 
        "Luft und trifft "+enemy->name(WEN)+" brutalst!\n");
    rounds=0;
    return 1 + anzahl + pllev + pldex + random(anzahl*4 + pllev*2 + pldex*2);

  }
  else
    return 1 + anzahl + random(anzahl*2);
}

