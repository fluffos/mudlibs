// Silberspeer fuer Silberdrache
// 27.1.2005 Feyaria@SilberLand

#include "../def.h"

inherit "/std/weapon";

void create()
{
  if( !is_clone(TO) ) return;
  ::create();
  SetProp(P_SHORT, "Ein Silberspeer");
  SetProp(P_LONG, 
    "Ein langer Speer, der nur aus Silber zu bestehen scheint. "
    "Ob man mit so einer wertvollen Waffe kaempfen soll? Er hat eine "
    "stahlharte Spitze, die mit vielen Widerhaken verstaerkt ist, sodass "
    "man den Gegner eher zerreisst als aufspiesst. Er liegt sehr gut in "
    "der Hand, sodass man ihn sogar mit einer Hand fuehren kann.");
  SetProp(P_NAME, "Silberspeer");
  SetProp(P_GENDER, MALE);
  AddId( ({"silberspeer", "speer" }) );  
  SetProp(P_INFO,
      "Werwoelfe und andere auf Silber anfaellige Wesen sollten sich "
      "vor dieser toedlichen Waffe fuerchten!");

  SetProp(P_WEAPON_TYPE, WT_SPEAR);
  SetProp(P_WC, 190);
  SetProp(P_WC_FIX, 55);
  SetProp(P_DAM_TYPE, ({DT_RIP}) );
  SetProp(P_QUALITY_DECAY, 200);
  SetProp(P_NR_HANDS, 1);
  SetProp(P_WEIGHT, 1200);
  SetProp(P_VALUE, 2700);
  SetProp(P_WIELD_RESTRICTIONS, ([A_STR: 16, A_DEX: 22, P_LEVEL: 25]) );
  SetProp(P_MATERIAL, ([MAT_SILVER:100]) ); 
}


