 
 inherit "/std/unit";
  
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <wizlevels.h>
#include <new_skills.h>
#include "files.h" 
 
  create() {
    if (!is_clone(TO) ) return;
   ::create();
    SetProp(P_NAME,({"Granitstachel","Granitstacheln"}));
    AddId("granitstachel");   AddSingularId("stachel");
    AddId("\nvstachel");
   AddSingularId("granitstachel");
   SetProp(P_SHORT, "Ein Granitstachel");
   SetProp(P_LONG, 
   "Dieser Stachel stammt von einer Steinrose.");
   SetProp(P_INFO, "Der Stachel ist eine magische Waffe. Cmd:<stich, steche> \n");
   SetProp(P_MATERIAL, ({MAT_STONE,MAT_MAGIC}));
   AddPluralId("stacheln");
   AddPluralId("granitstacheln");
   SetCoinsPerUnits(100,1);
    SetGramsPerUnits(50,1);
   // SetProp(P_AMOUNT, 6);
    SetProp(P_NOBUY,1);
   SetProp(P_GENDER, MALE);
   SetProp(P_WEIGHT, 50);
   SetProp(P_SIZE, 30);
   SetProp(P_VALUE, 500);  
  
  
    SetProp(P_COMBATCMDS, (["stich stachel":
                            ([C_MIN:10,C_AVG:22,C_MAX:35,C_DTYPES:({DT_MAGIC,DT_RIP,DT_PIERCE})])
                          ]));
    AddCmd(({"stich","steche"}),"stechen");
  }
  
  stechen(str) {
    object pl,ob,targs,env;
    int i,dam;
    string aus;
  
    if (!str) return 0;
    if (!(pl=PL)) return 0;
    if (ME!=present(lower_case(str),PL)) return 0;
   if (!env=environment(PL)) return 0;
   if (QueryProp(P_AMOUNT)<1) return 0;
   if (pl->QueryProp(P_GHOST)) {
         notify_fail("Das kannst Du in diesem immateriellen Zustand nicht.\n");
         return 0;
   }
   if ((pl->QueryProp(P_MAX_HANDS) -
        pl->QueryProp(P_USED_HANDS)) <1) {
     write("Du brauchst mindestens eine freie Hand.\n");
     return 1;
   }
 
   if(PL->QueryProp(P_ATTACK_BUSY))
         {
    write( "Langsam, langsam. Immer schoen ruhig bleiben.\n");
       return 1;
         }
   PL->SetProp(P_ATTACK_BUSY, 1);  
   targs=({});  
   if (query_once_interactive(PL)) {
         for (ob=first_inventory(env);ob;ob=next_inventory(ob)) {
           if (!living(ob)) continue;
           if (query_once_interactive(ob)) continue;
//           if( ob->QueryProp( P_NO_GLOBAL_ATTACK)) continue;
           targs+=({ob});
         }
   } else {
         for (ob=first_inventory(env);ob;ob=next_inventory(ob)) {
           if (!living(ob)) continue;
           if (!interactive(ob)) continue;
           if (IS_LEARNER(ob))
                 if (ob->QueryProp(P_INVIS) || ob->QueryProp(P_WANTS_TO_LEARN))
                   continue;
  //         if( ob->QueryProp( P_NO_GLOBAL_ATTACK)) continue;
        targs+=({ob});
         }
  }
 
   AddAmount(-1);
   write("Du zueckst einen Granitstachel.\n");
   say(capitalize(PL->name(WER))+
           " zueckt einen Granitstachel.\n",PL);
   if (!sizeof(targs)) {
         tell_room(env,"Der Granitstachel leuchtet auf und zersplittert, trifft aber niemanden.\n");
         return 1;
   }
   aus="";
   for (i=sizeof(targs)-1;i>=0;i--) {
         aus+=targs[i]->name(WEN);
         if (i)
           aus+=((string)((i>1)?", ":" und "));
   }
   say(break_string("Der Granitstachel leuchtet auf, zersplittert und trifft "+aus+".\n",78),
           targs);
   dam= 50+pl->QueryAttribute(A_INT)*5+random(150);  // 50..314 (50+23*5+149)
   for (i=sizeof(targs)-1;i>=0;i--) {
 	ob=targs[i];
         tell_object(ob,"Der zersplitternde Granitstachel trifft Dich.\n");
         ob->Defend( dam, ({DT_MAGIC}), 
               ([SP_NAME:"Granitstachel", SP_SHOW_DAMAGE:1]), PL);
   }
   return 1;
  }
