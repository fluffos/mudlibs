/*
** ne keule(eisenstange) fuer widolt
** 
*/

inherit "std/weapon";

#include <properties.h>     /* Definition der Properties */
#include <combat.h>         /* Definition der kampfspezifischen Konstanten */
#include <language.h>       /* Definition von MALE, FEMALE, WER, ... */
#include <wizlevels.h>
#include "files.h"
create()
{
  if (!is_clone(this_object())) return;
  ::create();

  AddId (({"stange","eisenstange"}));
  SetProp (P_SHORT, "Eine gewaltige Eisenstange");
  SetProp (P_LONG,BS( "Diese Eisenstange gehoerte einst dem Riesen Widolt. In den "
  "richtigen Haenden ist sie eine gefaehrliche Waffe."));
  SetProp(P_NOBUY, 1); 
  SetProp (P_NAME, "Eisenstange");
  SetProp (P_GENDER, FEMALE);
  SetProp(P_INFO, "Die Eisenstange ist recht schwer, aber kann gewaltig zuschlagen.  ");
  SetProp (P_VALUE, 3000);
  SetProp (P_WEIGHT, 3500);
  SetProp (P_WEAPON_TYPE, WT_CLUB);
  SetProp (P_DAM_TYPE, ({DT_BLUDGEON,DT_EXPLOSION,DT_TERROR}));
  SetProp (P_WC, 260);
  SetProp (P_NR_HANDS, 2);
  SetProp (P_MATERIAL, MAT_IRON);
  SetProp(P_WIELD_FUNC, TO);
  SetProp(P_HIT_FUNC, TO);

  SetProp(P_NODROP, 0);
  SetProp(P_NOSELL, 0);

}
int WieldFunc(object waffe)
{
if ( TP->QueryAttribute(A_STR)<16 )
{
write("Du bist nicht stark genug um diese Eisenstange zu fuehren.\n");
return 0;
}
return 1;
}


int HitFunc(object enemy)
{
int schaden;
if ( enemy->id("rok") )
{
schaden=random(400);
 if (schaden>200)
 write("Der Hass von Widolt uebertraegt sich auf seine Eisenstange.\n");
 return 50*enemy->QueryProp(P_LEVEL)+schaden;
 }
 else
 return 10+random(10);
 
 }
 
