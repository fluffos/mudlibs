//wandelwaffe fuer quest eher mies

inherit "std/weapon";

#include <properties.h>     /* Definition der Properties */
#include <combat.h>         /* Definition der kampfspezifischen Konstanten */
#include <language.h>       /* Definition von MALE, FEMALE, WER, ... */
#include <new_skills.h>
#include "files.h"


init()
{
  ::init();
  switch(random(5))
     {
     case 0:
     SetProp(P_SHORT, "Ein Schreckensschwert");
     SetProp(P_LONG, "Das ist ein Schreckenschwert. In den richtigen "
     "Haenden eine brauchbare Waffe.");
     SetProp(P_NAME, "Schreckensschwert");
     AddId(({"schwert","schreckensschwert","morph"}));
     break;
     case 1:
     SetProp(P_SHORT, "Ein Brutaloschwert");
     SetProp(P_LONG, "Das ist ein Brutaloschwert. In den richtigen "
     "Haenden eine brauchbare Waffe.");
     SetProp(P_NAME, "Brutaloschwert");
     AddId(({"schwert","brutaloschwert","morph"}));
     break;
     case 2:
      SetProp(P_SHORT, "Ein Haudraufschwert");
     SetProp(P_LONG, "Das ist ein Haudraufschwert. In den richtigen "
     "Haenden eine brauchbare Waffe.");
     SetProp(P_NAME, "Haudraufschwert");
     AddId(({"schwert","haudraufschwert","morph"}));
    break;
    case 3:
     SetProp(P_SHORT, "Ein Kopfabschwert");
     SetProp(P_LONG, "Das ist ein Kopfabschwert. In den richtigen "
     "Haenden eine brauchbare Waffe.");
     SetProp(P_NAME, "Kopfabschwert");
     AddId(({"schwert","kopfabschwert","morph"}));
    break;
    case 4:
     SetProp(P_SHORT, "Ein Dubistgleichtotschwert");
     SetProp(P_LONG, "Das ist ein Dubistgleichtotschwert. In den richtigen "
     "Haenden eine brauchbare Waffe.");
     SetProp(P_NAME, "Dubistgleichtotschwert");
     AddId(({"schwert","dubistgleichtotschwert","morph"}));
    break;
    default: write("BUG!\n");
     }
    
  }
  
create()
{
  if (!is_clone(this_object()))
     return;
  ::create();


  SetProp (P_GENDER, NEUTER);
  SetProp (P_VALUE, 800+random(500));
  SetProp(P_WEIGHT, 600);
  SetProp (P_WEAPON_TYPE, WT_SWORD);
  SetProp (P_DAM_TYPE, ({DT_SLASH,DT_TERROR}));
  SetProp(P_NOBUY, 0);
  SetProp (P_WC, 160+random(10));
  SetProp(P_MATERIAL, ({MAT_METAL,MAT_STEEL}));
  SetProp (P_NR_HANDS, 1);
  AddId(({"schwert","brutaloschwert","kopfabschwert",
  "schreckensschwert","dubistgleichtotschwert",
  "haudraufschwert"}));
 SetProp(P_NAME, "Schwert");//???
   
  SetProp(P_INFO, BS("Diese Waffe macht Schreckensschaden.\n"));
}

