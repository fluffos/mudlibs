//keule by dante

inherit "std/weapon";

#include <properties.h>     /* Definition der Properties */
#include <combat.h>         /* Definition der kampfspezifischen Konstanten */
#include <language.h>       /* Definition von MALE, FEMALE, WER, ... */
#include <wizlevels.h>
#include "files.h"

int x;

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  x=0;

  AddId(({"steinkeule","keule"}));
  SetProp(P_SHORT, "Eine riesige Granitkeule");
  SetProp(P_LONG, "Die Granitkeule ist gewaltig gross und sehr schwer, aber "
      "sie verursacht auch gewaltigen Schaden. An ihrer "
      "Spitze erkennst Du einige extrem harte Stacheln.");

  AddDetail(({"spitze","stachel","stacheln"}),
      "Hart und spitz. Neben bei noch mit Gift getraenkt.");
  AddDetail("gift",
      "Ein boeses, langsam wirkendes Gift.");    
  SetProp(P_NAME, "Granitkeule");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_INFO, BS("In der Granitkeule haben die Steingiganten einen Geist "
        "gefangen, der viele Jahre lang ihr Gegner war. Diese Waffe wirkt daher "
        "besonders gut gegen die Steingiganten, hat aber doch ihre Eigenheiten. "
        "Vielleicht steckt aber doch noch einiges anderes in ihr."));

  SetProp(P_VALUE, 5000);
  SetProp(P_WEIGHT, 3000);
  SetProp(P_WEAPON_TYPE, WT_CLUB);
  SetProp(P_DAM_TYPE, DT_BLUDGEON);
  SetProp(P_WC, 170);
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL, ({MAT_MAGIC,MAT_STONE}));
  SetProp(P_WEAR_RESTRICTIONS, ([A_STR:16]) );
  SetProp(P_HIT_FUNC, TO);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 0);
}

void reset()
{
  if (!is_clone(this_object())) return;
  ::reset();
  if ((x++) >= 20)
    call_out("destroy", 0);
  
}

int HitFunc(object enemy)
{
  int schaden;
  int wiemax, wiemom;
  wiemax=enemy->QueryProp(P_MAX_HP);
  wiemom=enemy->QueryProp(P_HP);

  if ( enemy->id("steingigant") )
  {
    write("Der Geist der Granitkeule will den Giganten vernichten!\n");
    return random(50*enemy->QueryProp(P_LEVEL)+TP->QueryProp(A_STR)*50);
  }

  if ((wiemom * 10) <= wiemax)    
  {
    write("Die Steinkeule erkennt wie schwach "+enemy->name()+" bereits ist "
        "und schlaegt ihre Stachel extrem brutal in Dein Opfer.\n");
    return random(80)+80;
  } 
  return 0;
}


void destroy()
{
  write(
      " \n"
      "Der Geist der Granitkeule will ausbrechen...\n");
  call_out("destroy2",100);
}

void destroy2()
{
  write(
      " \n"
      "Die Granitkeule zerbroeselt...\n");
  SetProp(P_WC,150);
  call_out("destroy3",100);
}

void destroy3()
{
  write(
      " \n"
      "Der Geist der Granitkeule will ausbrechen...\n");
  SetProp(P_WC,130);
  call_out("destroy4",100);
}

void destroy4()
{
  write(
      " \n"
      "Die Granitkeule zerbroeselt immer mehr...\n");
  SetProp(P_WC,90);
  call_out("destroy5",100);
}

void destroy5()
{
  write(
      " \n"
      "Die Granitkeule zerfaellt zu Staub und der ehemals eingesperrte Geist ist wieder frei.\n");
  remove();
}
