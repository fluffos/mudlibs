inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include "/players/dante/myowndefine.h"
create()
{
  if (!is_clone(this_object())) return;
  ::create();

  AddId (({"haken", "TIREKS_HAKEN"}));
  SetProp (P_SHORT, "Ein langer, schwerer Haken");
  SetProp (P_LONG, BS(
"Dieser Haken wurde aus haertestem Stahl gefertigt. An seiner Spitze hat "
"er mehrere scharfe, gewunden Widerhaken, mit denen man sicher sehr gut "
"Dinge packen und ausreissen kann."));
  SP(P_NAME_ADJ, ({"lang", "schwer"}));
  SetProp (P_NAME, "Haken");
  SetProp (P_GENDER, MALE);
 SetProp(P_MAGIC, 1);
 SP(P_INFO, "Der Haken eignete sich zum ausreissen von bestimmten Schuppen.");
SP(P_WIELD_RESTRICTIONS, ([A_STR: 15]));

  SetProp (P_VALUE, 3000);
  SetProp (P_WEIGHT, 800);
  SetProp (P_WEAPON_TYPE, WT_SPEAR);
  SetProp (P_DAM_TYPE, DT_RIP);
  SetProp(P_NOBUY, 1);
  SetProp (P_WC, 100);
  SetProp (P_NR_HANDS, 2);
  SetProp (P_MATERIAL, ([MAT_STEEL:1, MAT_OAK:99]));
}

