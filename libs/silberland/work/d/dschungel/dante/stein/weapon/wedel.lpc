//ernas wedel 
// 

#include "../def.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Ernas Staubwedel");
  SetProp(P_LONG, BS( 
  "Das ist Ernas Staubwedel mit dem sie staubwischt und auch ziemlich zuschlagen "
  "kann...")); 
  SetProp(P_NAME,"Staubwedel");
  SetProp(P_GENDER,MALE);
  AddId( ({"wedel", "staubwedel"}) );

  SetProp(P_WEAPON_TYPE, WT_CLUB );
  SetProp(P_WC,65);
  SetProp(P_DAM_TYPE,({DT_BLUDGEON}) );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_SIZE, 740);
  SetProp(P_MATERIAL, MAT_WOOD);
  SetProp(P_WEIGHT, 300);
  SetProp(P_VALUE,150);
  SetProp(P_NOBUY, 0);
}
