// dante@SilberLand

#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>0

create()
{
  ::create();

  SetProp( P_INT_SHORT, "In einer kleinen Felsspalte" );
  SetProp( P_INT_LONG, BS(
        "Du steckst nun hinter dem grossen Truemmerhaufen inmitten all der Felsen. "
        "Viel ist hier nicht zu entdecken, denn hier ist alles aus Stein. Dir bleibt "
        "wohl kein andere Weg als wieder zurueck in die Hoehle. Lediglich am Boden "
        "erkennt man etwas Stroh und daneben einen kleinen Sessel."));

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE:20]));    
  AddDetail( ({"truemmer","haufen","truemmerhaufen" }),
      "Der gewaltige Haufen aus Truemmern ist eigentlich ueberall rings um Dich.");
  AddDetail( ({"fels","felsen" }),
      "Wie ein Berg tuermen sich die Felsen hier ueberall auf.");
  AddDetail( ({"stein","steine" }),
      "Alles, der Boden, die Waende, alles ist purer Stein.");
  AddDetail(("boden"),
      "Am Boden liegt etwas Stroh herum.");
  AddDetail("berg",
      "Die Felsen liegen hochaufragend um Dich herum.");

  AddDetail(("stroh"),
      "Hier hat wohl jemand gelebt...");
  AddDetail(({"wand","waende"}),
      "Die Waende sind unregelmaessig...");
  AddDetail(("weg"),
      "Hier gibts es nur einen Weg hinaus.");
  AddDetail(("decke"),
      "Die Decke ist von hier nicht zu erkennen.");
  AddDetail(("hoehle"),
      "Du befindest Dich noch immer in der Hoehle des Monsters.");
  AddDetail(("monster"),
      "Hier bist Du in Sicherheit.");
  AddDetail( ({"sicherheit" }),
      "Oder doch nicht...");
  AddDetail( ({"sessel" }),
      "Der Sessel ist aus Holz gefertigt und schon ziemlich alt.");
  AddDetail( ({"holz" }),
      "Auf dem Holz erkennt man einige Schriftzeichen.");
  AddDetail(({"zeichen","schriftzeichen"}),
      "Du kannst versuchen sie zu entziffern...");
  AddReadDetail(({"zeichen","schriftzeichen"}),
      "So einfach ist das hier nicht...");  

  AddItem(NPC"hgnom2",REFRESH_DESTRUCT);

  AddSound( DEFAULT_SOUND,
      "Hier ist es sehr still.");

  AddSmell( DEFAULT_SMELL,
      "Es riecht nach altem Stroh.");


  AddExit( "raus", "./monster5" );
}

