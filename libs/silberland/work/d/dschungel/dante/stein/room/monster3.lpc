// hoehle der steingiganten1

#include "files.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <player.h>


nosave int dose;

create()
{
  ::create();

  dose = 1;

  SetProp( P_INT_SHORT, "In einer riesigen unheimlichen Hoehle" );
  SetProp( P_INT_LONG, 
      "Du hast Dich nun verbotener Weise hinter das grosse Tor gewagt. Leise steigen "
      "Zweifel in Dir hoch, ob das eine kluge Idee war. Solltest Du nicht besser umkehren "
      "meldet sich eine Stimme in Dir. Viel zu sehen ist hier nicht, denn die Hoehle "
      "hat solche Ausmasse, dass Du den Hall Deiner eigenen Schritte hoeren kannst. "
      "Die Waende steigen steil nach oben und die Decke kannst Du kaum mehr erkennen. "
      "Hier scheint die Hoehle zu enden, denn im Sueden versperrt Dir ein gigantisches "
      "Gitter den Weg.");

  AddDetail("stadt",
      "Midas");
  AddDetail("rest",
      "Von Dir wird nicht viel uebrigbleiben.");
  AddDetail("stimme",
      "Sie droehnt in Dir.");
  AddDetail("vergleich",
      "Du bist toter als tot.");
  AddDetail("tor",
      "Das rettende Tor ist weit weg , Du Tor.");
  AddDetail("waende",
      "Untersuche bitte Wand.");
  AddDetail("rest",
      "Dein Rest wird verschlungen werden.");
  AddDetail("farbe",
      "Die Farbe des Todes ist pink-gruen kariert, oder hmm...");
  AddDetail("tod",
      "Der kommt gleich.");  
  AddDetail("gefaegnis",
      "Wer ist hier eingesperrt?");

  AddDetail(("weg"),
      "Weiter nach Sueden kann man nicht gehen, denn das Gitter reicht vom Boden bis zur Decke.");
  AddDetail(("sueden"),
      "Die Hoehle scheint im Sueden enger und niederiger zu werden. Du erkennst hinter dem Gitter eine kleine "
      "Huette, Baenke, ein Schild...");
  AddDetail(("huette"),
      "Die Huette sollte eigentlich einmal eine kleine Kneipe werden.");
  AddDetail(("kneipe"),
      "Diese Kneipe scheint verlassen zu sein. Warum wohl ?");
  AddDetail(({"bank","baenke"}),
      "Leer und teilweise zerbrochen liegen und stehen sie herum...");
  AddDetail(("schild"),
      "Das Schild ist schon ziemlich weit hinter dem Gitter, aber Du kannst "
      "die Worte 'Monsterbesichtigung' und 'Eroeffnung' noch entziffern.");
  AddDetail(("gitter"),
      "Das Gitter reicht von ganz oben bis nach ganz unten und ist aus haertestem Stahl gefertigt. "
      "Die Raeume zwischen den einzelnen Staeben sind sehr eng, sodass niemand hindurchkriechen kann. "
      "An einem Stab hat man einen kleinen Kasten angebracht.");
  AddDetail(("kasten"),
      "Der Kasten ist schwarz und ebenfalls aus Stahl. Er weisst eine kleine Klappe auf.");
  AddDetail(("klappe"),
      "Die Klappe kann man sicher irgendwie oeffnen...");

  AddDetail(("stahl"),
      "Der Stahl wurde von Alberich..ach was natuerlich nicht von dem...");
  AddDetail(("alberich"),
      "Den kennst Du nicht?");
  AddDetail(("raeume"),
      "Sie sind ziemlich eng, ein Zwerg kommt da sicher nicht durch...");
  AddDetail(({"stab","staebe"}),
      "Baumstammdick stehen sie vor Dir und scheinen fuer die Ewigkeit gemacht...");
  AddDetail(("ewigkeit"),
      "Da faellt Dir doch glatt auf, dass an einem der Staebe sich etwas Rost "
      "angesetzt hat...");
  AddDetail(("rost"),
      "Wie soll Stahl den rosten??? Ausserdem ist es kein Rost, sondern eine kleiner Hebel...");
  AddDetail(("hebel"),
      "Wozu wohl Hebel so da sind...");

  AddDetail(("boden"),
      "Der Boden ist glatt, weisst aber teilweise sehr tiefe Gruben auf...");
  AddDetail(({"grube","gruben"}),
      "Woher die wohl stammen...");
  AddDetail(("zelle"),
      "Du denkst . o O 'Ich waere gern in einer sicheren Zelle..'!");
  AddDetail(("aufmerksamkeit"),
      "Vor Angst kannst Du Dich kaum konzentrieren...");
  AddDetail(("wand"),
      "Die Waende sind hier enger beisammen als im Rest der Hoehle.");  
  AddDetail(("idee"),
      "Hoffentlich endet die Idee nicht bei Lars!!!");
  AddDetail(("lars"),
      "R.I.P.");

  AddDetail(("hoehle"),
      "Die Hoehle ist ein riesengrosses Gefaengnis...");
  AddDetail(("gefaegnis"),
      "Wer benoetigt eine Zelle mit diesen Ausmassen ?");
  AddDetail(({"ausmmase","asumassen","ausmass"}),
      "Ich hoffe fuer Dich, dass Du das niemals herrausfindest...");
  AddDetail(("schritte"),
      "Langsam und aengstlich bewegst Du Dich hier...");
  AddDetail(("hall"),
      "Gruselig ist es in dieser Hoehle.");
  AddDetail(("zweifel"),
      "Geh lieber wieder nach Midas.");
  AddDetail(("midas"),
      "Die groesste Stadt dieser Welt heisst so.");
  AddDetail(("welt"),
      "Unsere Welt...");
  SetProp( P_LIGHT, 0);
  SetProp( P_INDOORS, 1 );

  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE:20]));    
  AddDetail(("decke"),
      "Die Decke ist so weit oben, dass Du sie nur erahnen kannst. Ausserdem scheint "
      "die Luft mit Nebel erfuellt zu sein.");
  AddDetail(("luft"),
      "Wie ein dichter, grauer Schleier huellt sie alles in ein gespentisches Grau ein.");
  AddDetail(("schleier"),
      "Nur ein Vergleich...");
  AddDetail(("grau"),
      "Die Farbe Grau ist gemeint!");
  AddDetail(("nebel"),
      "Der Nebel ist irgendwie zu warm und ploetzlich erahnst Du, das es sich hier um den "
      "heissen Atem eines gewaltigen Monsters handeln muss.");
  AddDetail(("atem"),
      "Dir scheint er wird immer dichter und heisser...");
  AddDetail(("monster"),
      "Du willst gar nicht an sowas denken...");

  AddDetail("zwerg",
      "Klein, aber stark.");
  AddSound( DEFAULT_SOUND,
      "Hier ist es totenstill...");

  AddSmell( DEFAULT_SMELL,
      "Du riechts Deinen eigenen Angstschweiss...");
  AddCmd(({"oeffne"}), "na"); 
  AddCmd(({"zieh","ziehe"}), "get");
  AddExit( "norden", "./monster2");
}



int na(string str)
{
  notify_fail("Was willst Du hier oeffnen?\n");
  if (!str) return 0;
  if (str=="klappe")
  {
    write("Du reisst den Mund weit auf. Wie immer.\n");
    return 1;
  }
  return 0;
}


reset()
{
  dose = 1; 
  ::reset();
}

create_dose()
{
  object a;
  a = clone_object(OBJ"spray.lpc");
  return a;
}


int get(string str)
{ 
  notify_fail("Was willst Du ziehen ?\n");
  if (!str) return 0;

  if (member(({"an hebel","hebel","hebel herunter"}), str ) !=-1)
  {
    if ( !dose)
    {
      write(" \n"
          "Du ziehst den Hebel, aber nichts passiert.\n");
      say(""+TPN+" hantiert am Gitter herum.\n");
      return 1;
    }


    if (dose)
    {
      write(" \n"
          "Du ziehst am Hebel, die Klappe oeffnet sich und ein Gegenstand faellt heraus. "
          "Du steckst den Gegenstand sofort ein.\n");
      say(""+TPN+" hantiert am Gitter herum.\m");
      CLONE(OBJ"spray",TP);
      dose--;
      return 1;
    }
    return 0;
  }
}  

