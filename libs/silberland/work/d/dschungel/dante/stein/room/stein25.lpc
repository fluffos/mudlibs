// hoehle der steingiganten1

#include "files.h"

inherit ROOM "stein_inh";

#include <properties.h>
#include <language.h>
#include <moving.h>
create()
{
  ::create();

  AddDetail( ({"hoehle"}),
    "Die Hoehle ist hier sehr eng."); 
     
 AddGuardedExit("unten", ROOM "stein26", "steingigant",
 "Der Steingigant bruellt: Nur ueber meinen Leiche!\n");
 
 
 AddGuardedExit("osten", ROOM "stein26", "steingigant",
 "Der Steingigant bruellt: Nur ueber meinen Leiche!\n");
 
 
 
 AddItem(NPC"dstgig3" , REFRESH_DESTRUCT);

 AddExit( "nordwesten", "./stein4");
 AddExit("osten", "./hakenraum");
 }
 
 
 
 
