// hoehle der steingiganten1

#include "files.h"

inherit "/d/gebirge/angrox/room/std_bergwerk_new";

#include <properties.h>
#include <language.h>
#include <moving.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "In der Hoehle der Steingiganten" );
  SetProp( P_INT_LONG, BS(
    "Du stehst nun in der gewaltigen Hoehle der Steingiganten. Alles, aber "
    "wirklich alles besteht hier aus purem Stein. Die Waende, der Boden, die "
    "Decke, Du siehst nichts als Stein. Ueberall liegen meterhohe "
    "Gesteinstruemmer herum."));
  SetProp( P_LIGHT, 0);
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN:TT_CAVE]) );

  AddDetail(({"gesteinstruemmer","truemmer","gestein", "arbeit"}),
    "Die Steingiganten haben ganze Arbeit geleistet und die Hoehle zu einem "
    "einzigen steinernen Chaos gemacht."),
  AddDetail(({"chaos", "arbeit"}),
    "Truemmer, Truemmer und nochmals Truemmer...");
  AddDetail(({"stein", "gestein"}),
    "Du glaubst Granit zu erkennen.");
  AddDetail(("granit"),
    "Granit ist ein besonders hartes Gestein.");
  AddDetail( ("boden"),
    "Der Boden besteht aus blankem Granit und ist uebersaet mit Kratzern.");
  AddDetail(({"wand","waende"}),
    "Die Waende sind aus Stein und weisen viele seltsame Loecher auf.");
  AddDetail(("kratzer"),
    "Die Spuren am Boden scheinen von gewaltigen Werkzeugen herzuruehren.");
  AddDetail( ({"werkzeug", "werkzeuge"}),
    "Man braucht schon gutes Werkzeug um solche Kratzer zu erzeugen.");
  AddDetail(({"loecher","loch"}),
    "Diese Loecher sehen wie riesengrosse Bissspuren aus. Von wem die wohl "
    "alle stammen?");
  AddDetail(({"bissspuren","spuren","spur","bissspur", "bisspur", "bisspuren"}),
    "Hier beissen hungrige Steingiganten ab und zu einmal ab.\n");
  AddDetail(("decke"),
    "Die Decke besteht aus reinem Granit und ist sehr weit oben.");
  AddDetail(("hoehle"),
    "Die Hoehle der Steingiganten soll sehr weitlaeufig sein und ist groessten "
    "Teils unerforscht...");
  AddDetail( ({"steingiganten", "giganten", "steingigant", "gigant"}),
    "Hier leben die Steingiganten.");
 
  AddSound( ({DEFAULT_SOUND, "stein"}),
    "Du hoerst wie tief im Inneren Stein zermalmt wird.");
    
  AddSmell( ({DEFAULT_SMELL, "stein"}),
    "Seltsam, aber hier riecht es steinig ?");
 
}
 
