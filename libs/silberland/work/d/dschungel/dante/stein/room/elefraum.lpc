// hoehle der steingiganten1

#include "files.h"

inherit ROOM "stein_inh";

#include <properties.h>
#include <language.h>
#include <moving.h>
create()
{
  ::create();

  AddDetail( ({"hoehle"}),
    "Die Hoehle ist hier etwas schmaeler und kleiner. Nur ein sehr enger "
    "Spalt fuehrt wieder hinaus.");
    AddDetail("spalt",
    "Durch den Spalt kommst Du wieder raus.\n");

  AddExit( "raus", "./stein30");     
  AddItem("d/dschungel/dante/news/obj/wele", REFRESH_DESTRUCT);
 }
 
 
 
 
