// hoehle der steingiganten1

#include "files.h"

inherit ROOM "stein_inh";

#include <properties.h>
#include <language.h>
#include <moving.h>

#define GIGANT "/d/dschungel/dante/stein/npc/p_gig"

create()
{
  ::create();
  
  AddDetail(({"hoehle"}),
	    "Die Hoehle verzweigt sich hier nach Westen, Sueden und Oben.");
  
  AddItem(GIGANT, REFRESH_DESTRUCT);
  AddExit ("westen", "./stein23");
  AddExit( "sueden", "./stein7");
  AddGuardedExit("oben", "/d/dschungel/dante/stein/room/stein24", "steingigant",
		 "Der Steingigant stoesst Dich zu Boden, als Du versuchst nach "
		 "oben zu gehen.\n");
}
