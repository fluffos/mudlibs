// hoehle der steingiganten1

#include "files.h"

inherit ROOM "stein_inh";

#include <properties.h>
#include <language.h>
#include <moving.h>
nosave int fackel;
create()
{
  ::create();

  fackel = 1;

  AddDetail( ({"hoehle"}),
      "Die Hoehle erstreckt sich hier nach Osten.");
  AddDetail(({"werkzeuge","werkzeug"}),
      "Als Du so ueber Werkzeuge nachdenkst, faellt Dir am Boden eine Grube auf.");
  AddDetail(("grube"),
      "Was wohl in der Grube drinnen sein mag...");

  AddItem(NPC"dstrose", REFRESH_DESTRUCT);
  AddExit( "osten", "./stein12");


  AddCmd(({"greif", "greife"}), "greifen");
}

reset()
{
  fackel = 1;
  ::reset();
}

greifen( string str)
{
  notify_fail("Wo willst Du hinein greifen ?\n");
  if ( str != "in grube") return 0;
  if ( !fackel)
  { write (BS( 
        "Du greifst mit der Hand in die Grube und spuerst einen stechenden Schmerz. "
        "Du ziehst Deine Hand darauf sofort wieder zurueck."));
  say(BS(CAP_TPN+" greift mit seiner Hand in ein Loch und schreit ploetzlich vor "
        "Schmerzen laut auf."));
  TP->reduce_hit_points(15);
  return 1;
  }
  write (BS( 
        "Du greifst mit der Hand in die Grube und findest eine Fackel, die Du "
        "sofort erfreut an Dich nimmst."));
  say(BS(CAP_TPN+" greift mit der Hand in ein Loch im Boden und grinst Dich "
        "dann erfreut an."));
  CLONE("/obj/fackel", TP);
  fackel--;
  return 1;
}

