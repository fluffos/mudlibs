// hoehle der steingiganten1

#include "files.h"

inherit ROOM "stein_inh";

#include <properties.h>
#include <language.h>
#include <moving.h>
nosave int heilen;

create()
{
  ::create();

  AddDetail( ({"hoehle"}),
    "Die Hoehle fuehrt weiter nach unten.");
  AddDetail(("kratzer"),
  "Diese Spuren hier schauen eher wie eine Rune aus...\n");
  AddDetail(({"rune","runen"}),
  "Verstehen kannst Du sie nicht, aber was kann man mit einer Rune sonst noch "
  "machen...");
  
 AddExit( "unten", "./stein10");
 AddItem(NPC"dstrose", REFRESH_DESTRUCT);
 
  heilen = 3;
//   AddItem("/players/dante/mtisch", REFRESH_DESTRUCT);
   
 AddCmd(({"lies","lese"}), "lesen"); 
 }
 
 reset()
 {
 heilen=3;
 ::reset();
 }
 
 lesen(string str)
 {
 notify_fail("Was willst Du hier lesen ?\n");
 if ( str != "rune") return 0;
 
 if (!heilen)
 {
 write("Du versuchst die Rune zu lesen, aber es passiert scheinbar nichts.\n");
 return 1;
 }
 if (str == "rune")
 write(BS("Du versuchst die Rune zu lesen, und eine angenehme Waerme "
          "durchflutet Deinen Koerper."));
 say(CAP_TPN+" scheint irgendetwas zu lesen und schaut danach erholt aus...\n");
 TP->heal_self(90+random(30));
 heilen--;
 return 1;
 }
 
