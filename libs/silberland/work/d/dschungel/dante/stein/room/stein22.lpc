// hoehle der steingiganten1

#include "files.h"

inherit ROOM "stein_inh";

#include <properties.h>
#include <language.h>
#include <moving.h>


nosave int beeren;
nosave int stone;

create()
{
  ::create();

  AddDetail( ({"hoehle"}),
      "Die Hoehle fuehrt hier von Sueden nach Norden.");
  AddDetail(("truemmer"),
      "Zwischen den Truemmern faellt Dir ein maechtiger Klotz auf.");
  AddDetail(("klotz"),
      "Der Klotz versperrt Dir die Sicht auf einen versteinerten Baum. Der "
      "Klotz weist eine seltsame Form auf.");
  AddDetail("form",
      "Irgendetwas Bedrohliches und zugleich Lustiges geht von diesem Klotz aus.");
  AddDetail("bedrohliches",
      "Das Bedrohliche betrifft nicht diesen Raum, sondern den Raum suedlich von hier.");
  AddDetail("raum"
      "Du stehst in der Hoehle der Steingiganten.");
  AddDetail("sueden",
      "Im Sueden ist auch die Hoehle der Steingiganten.");
  AddDetail("lustiges",
      "Das Lustige daran ist, das, wenn man den Baum nur fest genug schuettelt, "
      "im suedlichen Raum ein Steinschlag ausgeloest wird.");
  AddDetail("steinschlag",
      "Tja, wenn Du jemanden nicht leiden kannst...");


  AddDetail(("sicht"),
      "Du gehst etwas zur Seite und erkennst einen versteinerten Granitapfelbaum.");
  AddDetail(("baum"),
      "Der Klotz versperrt leider jegliche Sicht.");
  AddDetail(({"granitapfelbaum","apfelbaum"}),
      "Der Granitapfelbaum traegt sogar Fruechte...");
  AddDetail(({"frucht","fruechte"}),
      "Der Granitapfelbaum traegt reife Granitaepfel...\n");
  AddDetail(({"apfel","aepfel","granitapfel","granitaepfel"}),
      "Vielleicht sind die Aepfel ja geniessbar und Du kannst einen pfluecken...");

  AddExit( "norden", "./stein18");
  AddExit( "sueden", "./stein16");

  AddExit ("unten", "/d/dschungel/dante/uwhoehle/room/bstartoben2");


  AddItem(NPC"dstbaby", REFRESH_DESTRUCT);
  stone=3;
  beeren=3;
  AddCmd(({"pflueck","pfluecke"}),"heilen");
  AddCmd(({"schuettel", "schuettle"}), "kill");

}

reset()
{
  ::reset();
  beeren=3;
  stone=3;
}


kill(string str)
{
  notify_fail("Was willst Du wie schuetteln?\n");
  if (!str) return 0;

  if(member(({"baum","apfelbaum","granitapfelbaum"}),str)!=-1)
  {
    write("Du schuettelst den Baum, doch ist das viel zu locker "
        "um einen Steinschlag auszuloesen...\n");
    return 1;
  }

  if((stone) && ( member(({"baum fest","apfelbaum fest","granitapfelbaum fest"}),str)!=-1))
  {
    write("Du schuettelst den Baum fest und im suedlichen Raum hoerst "
        "Du die Steine herabregnen. WUMMM!!! Mit etwas Glueck hast Du einen "
        "Spieler erledigt!!!\n"
        "Dante teilt Dir mit: Gut so!!!\n");
    say(""+TPN+" erlaubt sich ein kleines Spaesschen!\n");
    call_other(("/d/dschungel/dante/stein/room/stein16"), "steinfall");
    stone--;
    return 1;
  }                                                                                      
  if((!stone) && ( member(({"baum fest","apfelbaum fest","granitapfelbaum fest"}),str)!=-1))
  {
    write("Du schuettelst den Baum fest, doch scheinbar bist Du zu schwach!\n");
    return 1;
  }
  return 0;
}


heilen (string str)
{
  notify_fail("Was willst Du hier pfluecken ?\n");
  if( !str) return 0;
  if ( member( ({"granitaepfel","aepfel","granitapfel","apfel"}), str) !=-1 )
  {
    if(beeren)
    {
      write( " \n"
          "Du pflueckst einen frischen Granitapfel und verspeist ihn mit Genuss.\n");
      say(CAP_TPN+" pflueckt einen Granitapfel und verspeist ihn mit Genuss.\n");
      this_player()->heal_self(20+random(10));
      beeren--;
      return 1;
    }

    write( " \n"
        "Du pflueckst einen Granitapfel und verspeisst ihn, aber nichts passiert.\n");
    say(CAP_TPN+" pflueckt einen Granitapfel und verspeist ihn.\n");
    return 1;
  }
  return 0;
}

