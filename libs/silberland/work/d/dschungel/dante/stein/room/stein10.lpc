// hoehle der steingiganten1

#include "files.h"

inherit ROOM "stein_inh";

#include <properties.h>
#include <language.h>
#include <moving.h>
create()
{
  ::create();

  AddDetail( ({"hoehle", "knick"}),
    "Die Hoehle macht hier einen Knick von Osten nach Norden. "
    "Nach oben kommt man in eine kleine Kammer.");
  AddDetail( ({"kammer"}),
    "Nach oben kommt man in eine kleine Kammer.");

  AddExit( "norden", "./stein9");
  AddExit( "oben", "./stein30");
  AddExit( "osten", "./stein3");
  AddExit ("unten", "/d/dschungel/dante/uwhoehle/room/frei2");
  
 }
