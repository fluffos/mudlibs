// hoehle der steingiganten1

#include "files.h"

inherit ROOM "stein_inh";

#include <properties.h>
#include <language.h>
#include <moving.h>
create()
{
  ::create();

  AddDetail( ({"hoehle"}),
    "Die Hoehle erstreckt sich hier nach Osten, Sueden und Westen.");
    
 AddExit( "osten", "./stein23");
 AddExit( "sueden", "./stein13");
 AddExit( "westen", "./stein16");
 
 AddItem(NPC"stspinne",REFRESH_DESTRUCT);
 AddItem(NPC"dst", REFRESH_DESTRUCT);
 }
 
 
 
 
