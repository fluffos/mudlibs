// hoehle der steingiganten1

#include "files.h"

inherit ROOM "stein_inh";

#include <properties.h>
#include <language.h>
#include <moving.h>
create()
{
  ::create();

  AddDetail( ({"hoehle"}),
    "Die Hoehle verzweigt sich hier nach Norden, Westen und Sueden.");

  AddItem(NPC"dstgig", REFRESH_DESTRUCT);
  AddItem(NPC"dstgig2", REFRESH_DESTRUCT);
  AddItem(NPC"dstgig3", REFRESH_DESTRUCT);
   
  AddExit( "westen", "./stein12");     
  AddExit( "norden", "./stein8");
  AddExit( "sueden", "./stein10");
}
