// hoehle der steingiganten1

#include "files.h"

inherit ROOM "stein_inh";

#include <properties.h>
#include <language.h>
#include <moving.h>
create()
{
  ::create();

  AddDetail( ({"hoehle"}),
    "Die Hoehle erstreckt sich hier in alle Richtungen.");

  AddExit( "westen", "./stein15");     
  AddExit( "norden", "./stein13");
  AddExit( "osten", "./stein9");
  AddExit( "sueden", "./stein14");
  AddItem(NPC"stspinne", REFRESH_DESTRUCT);
  AddItem(NPC"fritz", REFRESH_DESTRUCT);
 }
 
 
 
 
