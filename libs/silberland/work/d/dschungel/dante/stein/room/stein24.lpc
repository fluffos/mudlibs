// hoehle der steingiganten1

#include "files.h"

inherit ROOM "stein_inh";

#include <properties.h>
#include <language.h>
#include <moving.h>


object ob;
create()
{
  int i,anzahl;
  ::create();

  SetProp( P_INT_SHORT, "In der Schatzkammer der Steingiganten" );
  SetProp( P_INT_LONG, 
      "Du stehst nun in der Schatzkammer der Steingiganten. Eigentlich ist hier "
      "nichts anders als im Rest der Hoehle, ausser, dass hier einige "
      "Habseligkeiten der Steingiganten herumliegen. Alles, aber wirklich "
      "alles besteht hier aus purem Stein. Die Waende, der Boden, die Decke, Du siehst"
      " nichts als Stein. Ueberall liegen meterhohe Gesteinstruemmer herum...");

  AddDetail(({"kammer","schatzkammer", "hoehle", "raum"}),
      "Die Schatzkammer ist eigentlich nur ein kleiner Raum der etwas ueber dem "
      "Niveau der restlichen Hoehle liegt.");
  AddDetail(({"habseligkeiten","habseligkeit"}),
      "Was die Steingiganten eben gerade so finde, wird hier abgelegt.");

  AddExit( "unten", "./stein11");

  AddItem( NPC "silberdrache", REFRESH_DESTRUCT);

  AddItem("/obj/fackel", REFRESH_REMOVE);

  "obj/gemmaster"->DistributeGem(2+random(5), 5,1, 1);

  AddItem( "/obj/money", REFRESH_REMOVE, ([P_AMOUNT:random(20000)]));

  AddItem("/d/dschungel/dante/hoehle/obj/dsi", REFRESH_REMOVE);

  if(!random(2))  {
    AddItem("/d/dschungel/dante/hoehle/obj/dsi", REFRESH_REMOVE); }

  AddItem("/d/dschungel/dante/stein/obj/dgo", REFRESH_REMOVE);
}

reset()
{
  object ob;
  int i;
  ::reset();
  if( ob = present("geld") )
  {
    i=random(20000);
    if(i<ob->QueryProp(P_AMOUNT) )
      ob->SetProp(P_AMOUNT, ob->QueryProp(P_AMOUNT)+i/10);
    else
      ob->SetProp(P_AMOUNT, i);
  }
}

