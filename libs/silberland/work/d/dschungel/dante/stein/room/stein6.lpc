// hoehle der steingiganten1

#include "files.h"

inherit ROOM "stein_inh";
#define AD AddDetail

#include <properties.h>
#include <language.h>
#include <moving.h>
#define BSA(x,y) break_string(x,78,y)    

create()
{
  ::create();

  AddDetail( ({"hoehle", "knick"}),
      "Die Hoehle macht hier einen Knick von Sueden nach Westen.");
  SetProp (P_INT_LONG,BS(
        "Du stehst nun in der gewaltigen Hoehle der Steingiganten. Alles, aber wirklich "
        "alles besteht hier aus purem Stein. Die Waende, der Boden, die Decke, Du "
        "siehst nichts als Stein. Ueberall liegen meterhohe Gesteinstruemmer herum. "
        "Hier fliesst ein Wasserfall direkt aus einer Oeffnung in der Decke herab, der "
        "dann in einem Loch im Boden verschwindet. Spuren fuehren direkt hinein..."));
  AD("oeffnung",
      "Aus der Oeffnung in der Decke fliesst ein Wasserfall herab.");
  AD("loch",
      "Das Loch ist recht gross, Du wuerdest sicher hineinpassen, wenn Du "
      "ueberhaupt mutig genug bist.");
  AD(({"spur","spuren"}),
      "Die Spuren fuehren direkt zum Loch. Das erregt Deine Neugier.");
  AD("neugier",
      "Man kann in das Loch sicher hineinspringen.");
  AD(({"wasserfall","fall"}),
      "Der Wasserfall erscheint hier und verschwindet auch sofort wieder in dem "
      "Loch im Boden. AH! Da steckt in einer Wand ein Zahn!");
  AD("zahn",
      "Der Zahn steckt verdammt fest in der Wand. Es ist ein Zahn eines "
      "Unterwasserdrachens.");
  AD(({"drachen","unterwasserdrachen","drachens","unterwasserdrachens"}),
      "Hmm, ob sie dort unten wohnen?!");

  AddExit( "sueden", "./stein5");
  AddItem(NPC"dstbaby", REFRESH_DESTRUCT);
  AddItem(NPC"wasserwaechter", REFRESH_DESTRUCT);
  AddExit( "westen", "./stein7");
  AddCmd(({"spring","springe","springen"}), "go_down");
}

int go_down(string str)  {

  notify_fail("Wo willst Du hinein springen!\n");
  if(str=="in loch"||str=="ins loch"||str=="runter"||str=="hinunter"||
      str=="in loch runter"||str=="ins loch hinunter"||str=="in loch hinein"||
      str=="ins loch hinein")  {

    if(present("waechter", TO))  {
      say(BS( CAP_TPN+" wird von einem Waechter festgehalten!"));
      write(BSA(
            "HALT! Du kannst nicht dahinein springen! Aus diesen Unterwasserquellen "
            "beziehen wir unser Trinkwasser! HAU AB!",
            "Der Waechter sagt: "));
      return 1;  
    }
    write(BS( "Mutig springst Du durch das Loch in den Wasserfall."));
    write(BS(
          "Wassermassen erfassen Dich und werfen Dich scheinbar weit nach Sueden..."));
    write("\n");
    TP->move("d/dschungel/dante/uwhoehle/room/droom1", M_GO,
        "in den Wasserfall","springt","kommt von oben herabgesprungen");
    return 1;  
  }
  return 0; 
}




