// hoehle der steingiganten1

#include "files.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
int keule;
create()
{
  ::create();
  keule = 1;
  SetProp( P_INT_SHORT, "In einer kleinen Kammer aus Granit" );
  SetProp( P_INT_LONG, 
      "Du befindest Dich in einer kleinen Kammer die voellig leer ist und aus Granit besteht. "
      "Die Waende, der Boden, die Decke, einfach alles besteht aus reinem Granit. "
      "In der Mitte der Kammer faellt Dir ein Podest auf.");
  SetProp( P_LIGHT, 1);
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN:TT_CAVE]) );
  AddDetail(("podest"),
      "Das Podest ist doppelt so hoch wie Du und aus schwarzem Stein gefertigt. "
      "Oben auf dem Podest liegt eine gewaltiger Gegenstand.");
  AddDetail(("stein"),
      "Reiner Granit wohin Du auch blickst.");
  AddDetail(({"granit", "gestein"}),
      "Granit ist ein besonders hartes Gestein.");
  AddDetail(("mitte"),
      "In der Mitte der Kammer steht ein grosse Podest.\n");
  AddDetail(("gefaengnis"),
      "Fuer wenn koennte diese Kammer wohl gedacht sein...\n");
  AddDetail( ("boden"),
      "Der Boden besteht aus blankem Granit.\n");
  AddDetail(({"wand","waende"}),
      "Die Waende sind reinem glatten Granit. Die Nordwand faellt Dir besonders auf.\n");
  AddDetail(("nordwand"),
      "An der Nordwand faellt Dir eine grosse Zeichnung auf.");
  AddDetail(("zeichnung"),
      "Die Zeichnung zeigt einen Kampf.");
  AddDetail(("kampf"),
      "Der Koenig der Steingiganten kaempft gegen einen Steingeist.");
  AddDetail(("koenig"),
      "Sei froh, dass er nicht im Raum ist...");
  AddDetail( ({"raum"}), QueryProp(P_INT_LONG));
  AddDetail(({"steingeist","geist"}),
      "Der Steingeist war der einzige Gegner des Koenigs der Steingiganten, "
      "er wurde aber besiegt und in eine Waffe aus Granit gesperrt. Diese  "
      "wird nun von den Steingiganten bewacht und liegt am Podest...");
  AddDetail(("decke"),
      "Die Decke besteht aus reinem Granit und ist sehr weit oben.");
  AddDetail(("kammer"),
      "Die Kammer ist eine Art Gefaengnis...");
  AddSound( DEFAULT_SOUND,
      "Du hoerst wie eine Stimme aus der Keule Dir etwas miteilen will.");
  AddSound( "stimme",
      "Die Stimme kommt aus der Keule. Ob es sich hier um den eigesperrten "
      "Steingeist handelt?");
  AddSound( "keule",
      "Aus der Keule hoerst Du eine geisterhafte Stimme.");
  AddSound( ({"geist", "steingeist"}),
      "Der Steingeist wispert mit leiser Stimme: Befreie mich!");
  AddDetail(("gegenstand"),
      "Du kannst von hier unten wenig erkennen, aber es sieht wie eine Keule aus.\n"),   
  AddSmell( DEFAULT_SMELL,
      "Du riechst hier nichts...");

  AddCmd(({"befreie", "rette","befrei"}), "befreien");


  AddExit("sueden", "./stein28");
}

reset()
{
  keule=1;
  ::reset();
}

befreien ( str )
{
  notify_fail("Wen willst Du befreien ?\n");
  if (str != "steingeist") return 0; 

  if (!keule)
  {
    write
      (
       " \n"
       "Du konzentrierst Dich auf den eingekerkerten Steingeist, aber nichts passiert.\n");
    say (CAP_TPN+" konzentriert sich sehr auf etwas...\n");
    return 1;
  }
  write (BS(
        "Du konzentrierst Dich auf den eingekerkerten Steingeist und ploetzlich schwebt "
        "die Keule wie von Geisterhand bewegt zu Dir herab."));
  say(CAP_TPN+" konzentriert sich ploetzlich sehr auf etwas...\n");
  CLONE(WEAPON"keul", TP);
  keule--;
  return 1;
}

