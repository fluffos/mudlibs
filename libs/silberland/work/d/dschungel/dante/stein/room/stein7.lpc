#include "files.h"

inherit ROOM "stein_inh";

#include <properties.h>
#include <language.h>
#include <moving.h>
create()
{
  ::create();

  AddDetail( ({"hoehle"}),
    "Die Hoehle verzweigt sich hier nach Norden, Westen und Osten.");
 
  AddItem(NPC"dst", REFRESH_DESTRUCT);
  AddItem(NPC"dst", REFRESH_DESTRUCT);
  
  AddExit( "westen", "./stein8");
  AddExit( "norden", "./stein11");
  AddExit( "osten", "./stein6");
 }
 
 
 
 
