// hoehle der steingiganten1

#include "files.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
create()
{
  ::create();

  SetProp( P_INT_SHORT, "In einer riesigen unheimlichen Hoehle" );
  SetProp( P_INT_LONG, 
      "Du hast Dich nun verbotener Weise hinter das grosse Tor gewagt. Leise steigen "
      "Zweifel in Dir hoch, ob das eine kluge Idee war. Solltest Du nicht besser umkehren "
      "meldet sich eine Stimme in Dir. Viel zu sehen ist hier nicht, denn die Hoehle "
      "hat solche Aussmasse, dass Du den Hall Deiner eigenen Schritte hoeren kannst. "
      "Die Waende steigen steil nach oben und die Decke kannst Du kaum mehr erkennen. "
      "Hier scheint die Hoehle zu enden, denn im Norden ragt eine hohe Wand empor.");

  AddDetail(("weg"),
      "Weiter nach Norden kann man nicht gehen, denn hier ist das natuerliche Ende der Hoehle.");
  AddDetail(("norden"),
      "Im Norden versperrt eine gewaltige Wand den Weg.");
  AddDetail(("boden"),
      "Der Boden ist glatt, weisst aber teilweise sehr tiefe Gruben auf...");
  AddDetail(({"grube","gruben"}),
      "Woher die wohl stammen...");
  AddDetail(("zelle"),
      "Du denkst . o O 'Ich waere gern in einer sicheren Zelle..'!");
  AddDetail(("aufmerksamkeit"),
      "Vor Angst kannst Du Dich kaum konzentrieren...");
  AddDetail(({"wand", "waende"}),
      "Die Waende steigen hier steil nach oben. Lediglich die Nordwand scheint nicht "
      "so steil zu sein.");
  AddDetail(("nordwand"),
      "Eigentlich besteht die Nordwand aus einem riesigen Haufen Truemmer. Es scheint "
      "so als waere die Hoehle hier eingestuerzt.");
  AddDetail(("haufen"),
      "Berge von Steinen tuermen sich hier auf und versperren den Durchgang.");
  AddDetail(({"steine","stein"}),
      "Grosse, sehr grosse, gewaltige Steine...");
  AddDetail(("durchgang"),
      "Du findest zwar keinen Durchgang, aber Du entdeckts etwas Glitzerndes.");
  AddDetail(("glitzerndes"),
      "Leider nur Katzensilber, also nichts wert.");
  AddDetail(({"silber","katzensilber"}),
      "Wertloses Zeug.");
  AddDetail(("truemmer"),
      "Die Truemmer bauen sich vor Dir zu einer unueberwindbaren Huerde auf.");
  AddDetail(("huerde"),
      "Die Huerde ist gar nicht so unueberwindbar, denn man kann eigentlich recht bequem "
      "ueber sie drueber klettern...");
  AddDetail(("idee"),
      "Hoffentlich endet die Idee nicht bei Lars!!!");
  AddDetail(("lars"),
      "R.I.P.");
  AddDetail("zeug",
      "Wertlos.");
  AddDetail(("hoehle"),
      "Die Hoehle ist ein riesengrosses Gefaengnis...");
  AddDetail(("gefaegnis"),
      "Wer benoetigt eine Zelle mit diesen Ausmassen ?");
  AddDetail(({"ausmmase","ausmassen","ausmass"}),
      "Ich hoffe fuer Dich, dass Du das niemals herrausfindest...");
  AddDetail(("schritte"),
      "Langsam und aengstlich bewegst Du Dich hier...");
  AddDetail(("hall"),
      "Gruselig ist es in dieser Hoehle.");
  AddDetail(("zweifel"),
      "Geh lieber wieder nach Midas.");
  AddDetail(("midas"),
      "Die groesste Stadt dieser Welt heisst so.");
  AddDetail(("welt"),
      "Unsere Welt...");
  SetProp( P_LIGHT, 0);
  SetProp( P_INDOORS, 1 );

  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE:20]));    
  AddDetail(("decke"),
      "Die Decke ist so weit oben, dass Du sie nur erahnen kannst. Ausserdem scheint "
      "die Luft mit Nebel erfuellt zu sein.");
  AddDetail(("luft"),
      "Wie ein dichter, grauer Schleier huellt sie alles in ein gespentisches Grau ein.");
  AddDetail(("schleier"),
      "Nur ein Vergleich...");
  AddDetail(("grau"),
      "Die Farbe Grau ist gemeint!");
  AddDetail(("nebel"),
      "Der Nebel ist irgendwie zu warm und ploetzlich erahnst Du, das es sich hier um den "
      "heissen Atem eines gewaltigen Monsters handeln muss.");
  AddDetail(("atem"),
      "Dir scheint er wird immer dichter und heisser...");
  AddDetail(("monster"),
      "Du willst gar nicht an sowas denken...");

  AddSound( DEFAULT_SOUND,
      "Hier ist es totenstill...");

  AddSmell( DEFAULT_SMELL,
      "Du riechts Deinen eigenen Angstschweiss...");

  AddCmd(({"kletter","klettere"}),"up"); 

  AddExit( "sueden", "./monster1");
}


int up(string str)
{
  notify_fail("Wohin willst Du klettern ?\n");
  if (!str) return 0;

  if ( member(({"ueber huerde","ueber huerde drueber"}),str ) !=-1 )   
  {


    write("Du kletterst ueber die Huerde aus Truemmern.\n");
    TP->move("/d/dschungel/dante/stein/room/monster6", M_GO,
        "ueber die Truemmer.", "klettert",
        "kommt ueber die Truemmer geklettert");
    return 1;
  }
  return 0;
}


