// hoehle der steingiganten1

#include "files.h"

inherit ROOM "stein_inh";

#include <properties.h>
#include <language.h>
#include <moving.h>
int leiter;
create()
{ leiter=1;
  ::create();

  AddDetail( ({"hoehle", "sackgasse"}),
    "Die Hoehle endet hier in einer Sackgasse.");
  AddDetail(({"loecher","loch"}),
    "Diese Loecher sehen wie riesengrosse Bisspuren aus. Eines der Loecher "
    "sieht eher wie eine kuenstliche Vertiefung aus.");
  AddDetail(("vertiefung"),
    "Die  Vertiefung ist hoch oben, aber wenn Du Dich bemuehst, kannst Du "
    "sicher hineinlangen.");

AddCmd(({"lang", "lange"}), "langen");
 AddExit( "suedwesten", "./stein5");
      

AddItem(NPC"dst", REFRESH_DESTRUCT);
AddItem(NPC"dstrose", REFRESH_DESTRUCT); 

 }
 
 reset()
 {
 leiter=1;
 ::reset();
 }
 
 int langen (string str)
 {
 notify_fail ("Wo willst Du hineinlangen ?\n");
 if(str != "in vertiefung" && str != "in vertiefung hinein" ) return 0;

 if (!leiter || present("\ndleiter", TP) ) 
 {
  write(BS("Du streckst Dich so weit es geht nach oben, langst "
    "in die Vertiefung und spuerst etwas Schleimiges. Angeekelt ziehst Du "
    "Deine Hand sofort wieder zurueck."));
 say (BS(CAP_TPN+" streckt sich nach oben, langt in ein grosses Loch und zieht "
    "seine Hand angeekelt wieder zurueck."));
 return 1;
 }
 write (BS("Du streckst Dich so weit es geht nach oben und langst in die "
    "Vertiefung und findest einen langen Gegenstand, den Du sofort an Dich "
    "nimmst."));
 CLONE(OBJ"dleiter", TP);
 say(CAP_TPN+" streckt sich nach oben und langt in ein grosses Loch.\n");
 leiter--;
 return 1;
 }
 
 
 
 
 
 
