// hoehle der steingiganten1
//dante sl 97 98 99

#include "files.h"

inherit ROOM "stein_inh";

#include <properties.h>
#include <language.h>
#include <moving.h>

int schlegel=1;
create()
{
  ::create();

  AddDetail( ({"hoehle"}),
    "Die Hoehle erstreckt sich weit nach Norden.");

  AddDetail(("decke"),
  "Die Decke besteht aus reinem Granit und ist sehr weit oben. "
  "Du erkennst einen kleinen Hebel...\n");
 
 AddDetail(("hebel"),
 "Der Hebel ist sehr weit oben. Wie man da wohl hinauf kommt ?");
    
 AddExit( "norden", "./stein12");
  AddItem(NPC"rmaul", REFRESH_DESTRUCT);

AddCmd(({"zieh","ziehe","bewege","beweg"}), "get");
 }
 
 
 int get(string str)   {
 object ob;
 notify_fail("Was willst Du hier ziehen?!\n");
 if(str=="hebel"||str=="am hebel"||str=="an hebel")  {
   if(!present("granitleiter", TP))  {
   write(BS("Du versuchst den Hebel zu ziehen, doch so bist Du viel zu klein. "
   "Du brauchst etwas um groesser zu werden oder draufzusteigen!"));
   say(CAP_TPN+" versucht einen Hebel zu ziehen, doch ist zu klein.\n");
   
   return 1; }
   else  {
   if(schlegel)  {
   write(BS(
   "Du steigst auf die Granitleiter und ziehst den Hebel. Ein schwerer "
   "Gegenstand faellt Dir aus einer sich oeffnenden Geheimklappe direkt "
   "in die Arme."));
   say(CAP_TPN+" zieht einen Hebel an der Decke.");
   ob=clone_object("d/dschungel/dante/stein/obj/dgo");
   ob->move(TP, M_GET);
   schlegel--;
        return 1;   }
       if(!schlegel)  {
         say(CAP_TPN+" zieht einen Hebel an der Decke.");         
         write(BS(
    "Du steigst auf die Granitleiter und ziehst den Hebel. "
    "Es kracht laut, doch sonst passiert nichts."));
    return 1;   }      
        
     return 0;  }
   return 0; }
  return 0; }
       
 
 
 
