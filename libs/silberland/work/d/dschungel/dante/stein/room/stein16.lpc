// hoehle der steingiganten1

#include "files.h"

inherit ROOM "stein_inh";

#include <properties.h>
#include <language.h>
#include <moving.h>

create()
{
  ::create();

  AddDetail( ({"hoehle"}),
    "Die Hoehle macht hier einen Knick von Osten nach Norden.");
  AddDetail( ("boden"),
  "Der Boden besteht aus blankem Granit und ist uebersaeht mit Kratzern. "
  "Am Boden kannst Du auch einige grosse Flecken erkennen.");
  AddDetail(({"flecken","flecke","fleck"}),
  "Die Flecke sind grosse Blutflecke...");
  AddDetail(("decke"),
  "Die Decke besteht aus reinem Granit und ist sehr weit oben. Dir faellt auf, "
  "dass eine der Waende in einen hohen Kamin weiterfuehrt, dessen oberes Ende "
  "man aber nicht erkennen kann.");
  AddDetail(("kamin"),
  "Der Kamin ist eine Art Schacht, die senkrecht nach oben fuehrt.");
  AddDetail(("schacht"),
  "Der Schacht fuehrt nach oben. Pass nur auf, dass hier nichts runter geflogen "
  "kommt.");
  AddDetail(("ende"),
  "Du singst 'Alles hat ein Ende, nur die Wurst hat zwei...' und kommst "
  "Dir sehr dumm dabei vor.");

AddDetail(({"blut", "blutflecke"}),
"Dieser Ort ist gefaehrlich!");
AddDetail("ort",
"Traue hier keinem!");
 
   AddItem(NPC"dstgig3", REFRESH_DESTRUCT);
  AddExit( "osten", "./stein21");
  AddExit( "norden", "./stein22");
 }


  steinfall()
    {
    tell_room("/d/dschungel/dante/stein/room/stein16",
    "Ploetzlich hoerst Du ein lautes Poltern und Rumpeln ueber Dir!\n"
    "Es scheint sich um einen beginnenden Steinschlag zu handeln!!!\n"
    "Fliehe wenn Dir Dein Leben etwas wert ist!!!\n");
    call_out("kill", 3+random(3));
    return 1;
    }





     void kill() 
     {
     object sto;
     int i;
             object *inv;
             inv=all_inventory(this_object());
              for(i=sizeof(inv)-1;i>=0;i--) if(living(inv[i]))
              inv[i]->do_damage(1000);
              
     tell_room("/d/dschungel/dante/stein/room/stein16",
    "WUMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMM\n"
    "Ein gigantischer Steinschlag zerquetscht Dich wie eine Fliege!!!\n");
    SetProp(P_KILL_NAME, "Ein hinterlistiger Spieler");
    sto=clone_object("/d/dschungel/dante/stein/obj/rock.lpc");
    sto->move("/d/dschungel/dante/stein/room/stein16.lpc", M_TPORT);
    
    }
    
