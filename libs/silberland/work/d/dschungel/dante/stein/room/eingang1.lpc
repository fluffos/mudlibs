// hoehle der steingiganten1

#include "files.h"

inherit ROOM "stein_inh";

#include <properties.h>
#include <language.h>
#include <moving.h>

create()
{
  ::create();

  SetProp( P_INT_LONG, BS(
    "Du stehst nun in der gewaltigen Hoehle der Steingiganten. Alles, aber "
    "wirklich alles besteht hier aus purem Stein. Die Waende, der Boden, die "
    "Decke, Du siehst nichts als Stein. Ueberall liegen meterhohe "
    "Gesteinstruemmer herum. Im Sueden fuehrt ein Ausgang ins Tageslicht."));
  SetProp( P_LIGHT, 1);

  AddDetail(("hoehle"),
    "Die Hoehle der Steingiganten soll sehr weitlaeufig sein und ist groessten "
    "Teils unerforscht...");
  AddDetail( ({"ausgang", "tageslicht", "licht", "sueden"}),
    "Im Sueden fuehrt ein Ausgang ins Tageslicht."); 

  AddItem(NPC"dstgig" , REFRESH_DESTRUCT);
  AddExit( "norden", "./eingang2");
  AddExit( "sueden", "/d/dschungel/dante/weg/room/vorsprung");
}
 
 
 
 
