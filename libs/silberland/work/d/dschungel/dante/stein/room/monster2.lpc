// hoehle der steingiganten1

#include "files.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

int heilen;

create()
{
  ::create();


  heilen=random(3)+3;

  SetProp( P_INT_SHORT, "In einer riesigen, unheimlichen Hoehle" );
  SetProp( P_INT_LONG, 
      "Du hast Dich nun verbotener Weise hinter das grosse Tor gewagt. Leise steigen "
      "Zweifel in Dir hoch, ob das eine kluge Idee war. Solltest Du nicht besser umkehren "
      "meldet sich eine Stimme in Dir. Viel zu sehn ist hier nicht, denn die Hoehle "
      "hat solche Ausmasse, dass Du den Hall Deiner eigenen Schritte hoeren kannst. "
      "Die Waende steigen steil nach oben und die Decke kannst Du kaum mehr erkennen. "
      "Was Dich hier verbluefft ist ein gewaltiger Haufen aus Bueschen, Stroh und Leichenteilen...");
  AddDetail(("haufen"),
      "Der Haufen ist nicht so hoch, hat aber einen gewaltigen Durchmesser und weisst "
      "in der Mitte eine tiefen Abdruck auf. Vielleicht sollte man den Haufen naeher untersuchen...");
  AddDetail(("mitte"),
      "Irgendetwas sehr schweres muss oft in der Mitte liegen.");
  AddDetail(("durchmesser"),
      "Du kannst den Durchmesser nur grob abschaetzen und kommst auf ueber 20 Meter!!!");
  AddDetail(("abdruck"),
      "Wer wiegt soviel um einen solchen Abdruck zu hinterlassen ?");
  AddDetail(("stroh"),
      "Unmengen von Stroh sind hier aufgetuermt.");
  AddDetail(({"buesche","busch"}),
      "Die Buesche sind ebenso platt gewalzt wie alles andere. Koennte es sich bei dem "
      "Haufen um das gewaltige Nest eines Ungeheuers handeln ?");
  AddDetail(("nest"),
      "Dir schaudert bei dem Gedanken...");
  AddDetail(("ungeheuer"),
      "Ach was, die gibts es ja nur im Maerchen...");
  AddDetail(({"teile","leichen","leichenteile"}),
      "Zu Hauf liegen zerfetze Koerper hier herum...");
  AddDetail(("koerper"),
      "Die Koerper scheinen von Tieren zu stammen, die wohl das Futter darstellen.");
  AddDetail(("futter"),
      "Futter fuer wen oder was fragst Du Dich...");
  AddDetail(("koerper"),
      "Du siehst die Reste von Ochsen und Baeren...");
  AddDetail(("reste"),
      "Grausam zerfetzt liegen sie herum...");
  AddDetail(({"baeren","baer","ochse","ochsen"}),
      "Wer verschlingt solche grossen Tiere...");
  AddDetail(("boden"),
      "Der Boden ist glatt, weisst aber teilweise sehr tiefe Gruben auf...");
  AddDetail(({"grube","gruben"}),
      "Woher die wohl stammen...");
  AddDetail(("zelle"),
      "Du denkst . o O 'Ich waere gern in einer sicheren Zelle..'!");
  AddDetail(("aufmerksamkeit"),
      "Vor Angst kannst Du Dich kaum konzentrieren...");
  AddDetail(({"wand", "waende"}),
      "Die Waende sind hier sehr weit weg von Dir, nur in der Westwand erkennst Du das grosse "
      "Tor.");
  AddDetail(("westwand"),
      "In der Westwand, nun schon etwas weiter entfernt, befindet sich ein grosses Tor.");
  AddDetail(("idee"),
      "Hoffentlich endet die Idee nicht bei Lars!!!");
  AddDetail(("lars"),
      "R.I.P.");
  AddDetail(("hoehle"),
      "Die Hoehle ist ein riesengrosses Gefaengnis...");
  AddDetail(("gefaegnis"),
      "Wer benoetigt eine Zelle mit diesen Ausmassen ?");
  AddDetail(({"ausmasse","ausmassen","ausmass"}),
      "Ich hoffe fuer Dich, dass Du das niemals herrausfindest...");
  AddDetail(("schritte"),
      "Langsam und aengstlich bewegst Du Dich hier...");
  AddDetail(("hall"),
      "Gruselig ist es in dieser Hoehle.");
  AddDetail(("zweifel"),
      "Geh lieber wieder nach Midas.");
  AddDetail(("midas"),
      "Die groesste Stadt dieser Welt heisst so.");
  AddDetail(("welt"),
      "Unsere Welt...");
  SetProp( P_LIGHT, 0);
  SetProp( P_INDOORS, 1 );

  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE:20])); 

  AddDetail(({"schweiss","angstschweiss","angst","ruecken"}),
      "Mach Dir nur nicht noch in die Hosen...");
  AddDetail(({"hosen","hose"}),
      "Aber dafuer bist Du ja schon zu alt oder ?");
  AddDetail(("decke"),
      "Die Decke ist so weit oben, dass Du sie nur erahnen kannst. Ausserdem scheint "
      "die Luft mit Nebel erfuellt zu sein.");
  AddDetail(("luft"),
      "Wie ein dichter, grauer Schleier huellt sie alles in ein gespentisches Grau ein.");
  AddDetail(("schleier"),
      "Nur ein Vergleich...");
  AddDetail(("grau"),
      "Die Farbe Grau ist gemeint!");
  AddDetail(("tor"),
      "Das Tor liegt im Westen.");
  AddDetail(("nebel"),
      "Der Nebel ist irgendwie zu warm und ploetzlich erahnst Du, das es sich hier um den "
      "heissen Atem eines gewaltigen Monsters handeln muss.");
  AddDetail(("atem"),
      "Dir scheint er wird immer dichter und heisser...");
  AddDetail(("monster"),
      "Du willst gar nicht an sowas denken...");

  AddSound( DEFAULT_SOUND,
      "Hier ist es totenstill...");

  AddSmell( DEFAULT_SMELL,
      "Du riechts Deinen eigenen Angstschweiss...");
  AddExit("sueden", "./monster3");
  AddExit( "westen", "./monster1");
  AddExit( "norden", "./monster4");

  AddCmd(({"wuehle","wuehl"}), "get");

}

get (string str)
{
  notify_fail("Worin willst Du wuehlen?\n");
  if(!str) return 0;

  if(!heilen)
  {
    write("Du wuehlst im Haufen, aber findest nichts.\n");
    return 1;
  }

  if ((heilen)&&(str=="in haufen"||str=="im haufen"))
  {
    TP->heal_self(20)+random(10);
    write(BS("Du wuehlst im Haufen herum und findest einen guten, alten, "
        "klassischen Zaubertrank, die leider immer seltener werden."));
    say(TPN+" wuehlt herum...\n");
    heilen--;
    return 1;
  }
  return 0;
}

void reset()
{
  ::reset();
  heilen=3+random(3);
}

