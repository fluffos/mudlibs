
inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <wizlevels.h>
#include "/players/dante/myowndefine.h"

int li=1;
int mon=1;
object ob;

reset(){
  ::reset();
  mon=1;
  li=1;
}


create()
{
  ::create();


  SetProp( P_INT_SHORT, "In einem Raum aus Kristall" );
  SetProp( P_INT_LONG, BS(
        "Dieser Raum hier besteht nur aus Kristall. Es leuchtet und funkelt "
        "so hell, dass Du fast geblendet wirst. Alles, aber auch wirklich "
        "alles, ist hier aus lupenreinem, hellen Kristall. Im Osten "
        "kommst Du wieder zurueck in den bekannten Teil der Hoehle."));

  AD("hoehle",
      "Sie liegt im Osten.");
  AD("osten",
      "Dort liegt die Hoehle der Steingiganten.");
  AD(({"steingiganten","gigant","steingigant"}),
      "Gross, aber nett.");
  AD("teil",
      "Du entdeckst einen Kreis, den irgendjemand in den Kristall geritzt hat. "
      "Ausserdem siehst Du ein seltsames Licht, das hin und her tanzt.");
  AD("licht",
      "Es tanzt hin und her. Sehr merkwuerdig. Irgendwie stoert es aber die "
      "wunderbaren Reflexionen im Kristall. ");
  AD(({"reflexion","reflexionen",}),
      "Sie beeindrucken Dich sehr...");

  AD("kreis",
      "Hmm, was wohl passiert, wenn man den betritt?");
  AD("raum",
      "Der Raum besteht nur aus Kristall.");
  AD("kristall",
      "Er funkelt und blitzt, irgendwie unheimlich.");
  AD("boden",
      "Der Boden ist ebenso aus Kristall. Du kannst Dein Spiegelbild "
      "erkennen.");
  ASD("spiegelbild", "show");
  AD("bild",
      "Spiegelbild.");
  AD("decke",
      "Die Decke ist voellig glatt und auch aus Kristall.");
  AD(({"wand","waende"}),
      "Die Waende sind ebenso aus reinem Kristall und scheinen zu pulsieren. "
      "Irgendwie lebt dieser Raum.");



  SetProp( P_LIGHT, 1);
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20,ENV_TERRAIN:TT_CAVE]) );
  AddSound( DEFAULT_SOUND,
      "Der Kristall pulsiert.");

  AddSmell( DEFAULT_SMELL,
      "Es riecht nach Kristall.");

  AddExit("osten", "./stein18"); 
  ACD(({"betritt", "betrete"}), "come_npc");
  ACD(({"loesche","loesch"}),"aus");
}

int aus(string str)
{
  NF("Was willst Du hier loeschen?\n");
  if(str=="licht"||str=="tanzendes licht")
  {
    if(li==0)
    {
      write("Du versuchst das tanzende Licht zu loeschen, schaffst es aber "
          "nicht!\n");
      say(CAP_TPN+" versucht das tanzende Licht zu loeschen...\n");
      return 1;
    }
    if(li==1)
    {
      say(CAP_TPN+" versucht das tanzende Licht zu loeschen...\n");
      write("Du versuchst das tanzende Licht zu loeschen, schaffst es aber "
          "nicht. Der Kreis hingegen leuchtet kurz auf...\n");
      li=0;
      return 1;
    }
    return 0;
  }
  return 0;
}      


string show()
{
  write("Du, "+CAP_TPN+", schaust Dir direkt selbst ins Gesicht!\n");
  return "";
}

int come_npc(string str)
{
  NF("Was willst Du hier betreten!?\n");
  if(str=="kreis"||str=="kristallkreis")
  {

    if(li==1)
    {
      write("Du versuchst den Kreis zu betreten, doch das tanzende Licht "
          "stoesst Dich auf einmal zur Seite!\n");
      say(CAP_TPN+" wird vom tanzenden Licht zur Seite gestossen!\n");
      return 1;
    }

    if(present("KRIS", environment(TP)))
    {
      write("Du betrittst den Kreis, aber nichts passiert.\n");
      return 1; }
      if(!mon)
      {
        write(BS("Du betrittst den Kreis, es funkelt kurz im Kristall, aber nichts "
              "passiert sonst.")); return 1; }
        if(mon)  {
          tell_room("d/dschungel/dante/stein/room/kristall",
              "Der Kristall funkelt und blitzt und ploetzlich scheint sich eine "
              "Gestalt aus dem Kristall zu formen! \n");
          ob=clone_object("d/dschungel/dante/stein/npc/kris");
          ob->move(environment(TP), M_TPORT);
          mon--;
          return 1;
        }
        return 0;
  }
  return 0;
}     
