// hoehle der steingiganten1

#include "files.h"

inherit ROOM "stein_inh";

#include <properties.h>
#include <language.h>
#include <moving.h>
create()
{
  ::create();
  
  AddDetail( ({"hoehle"}),
    "Die Hoehle erstreckt sich von Norden nach Sueden (oder umgekehrt). "
    "Nach Nordosten fuehrt ein schmaler Nebengang.");
  AddDetail( ({"nebengang", "gang"}),
   "Nach Nordosten fuehrt ein schmaler Nebengang.");
      
 AddItem(NPC"dstgig", REFRESH_DESTRUCT);
 AddItem(NPC"dstgig2" , REFRESH_DESTRUCT);
 AddExit( "sueden", "./stein4");
 AddExit( "nordosten", "./stein17"); 
 AddExit( "norden", "./stein6");
 }
 
