// hoehle der steingiganten1

#include "files.h"

inherit ROOM "stein_inh";

#include <properties.h>
#include <language.h>
#include <moving.h>
create()
{
  ::create();
  AddDetail("westen",
  "Im Westen siehst Du ein kleines Tor.");
  AddDetail("tor",
  "Es leuchtet hell und glitzert irgendwie. Du glaubst das Funkeln von "
  "Kristallen zu erkennen. Irgendwie zieht Dich das Tor an, irgendwie "
  "hast Du aber auch etwas Angst...");
  AddDetail("angst",
  "Du rufst: Ich bin feige!");
  AddDetail("funkeln",
  "So hell, dass es Dich fast blendet.");
  AddDetail(({"kristall","kristalle"}),
  "Du kannst durch das Tor kaum etwas erkennen, nur ein helles Funkeln.");
  AddDetail( ({"hoehle"}),
    "Die Hoehle endet hier.");
  AddDetail(("decke"),
    "Die Decke besteht aus reinem Granit und ist sehr weit oben. Hoch ober Dir "
    "kannst Du aber eine Oeffnung erkennen.");
  AddDetail(("oeffnung"),
    "Die Oeffnung ist sehr hoch oben, Du wirst schon eine Leiter benoetigen in "
    "die Oeffnung zu steigen...");
    
   AddCmd(({"steige","steig"}), "steigen"); 

 AddItem(NPC"dstgig", REFRESH_DESTRUCT);
  AddExit( "sueden", "./stein22");
 AddExit( "westen", "./kristall");
  
 }
 
 steigen (str)
 {
 notify_fail("Wo willst Du hineinsteigen ?\n");
 if(( !present("leiter", TP))&&(str == "in oeffnung" || str == "durch oeffnung"))
 {
 write(BS("Du versuchst in die Oeffnung zu steigen, gibst aber bald auf, denn "
          "ohne Leiter klappt das nie..."));
 notify_fail("Du solltest wohl noch eine Leiter suchen!\n");
 return 0;
 }
 if (( present("leiter", TP))&&(str == "in oeffnung" || str == "durch oeffnung"))
 {
 write ("Du steigst mit der Leiter durch die Oeffnung nach oben.\n"
 " \n");
 TP->move("/d/dschungel/dante/hoehle/room/hoehle22", M_GO,
 "mit der Leiter durch die Oeffnung nach oben","steigt",
 "kommt von unten herauf gestiegen");
 return 1;
 }
 return 0;
}





 
