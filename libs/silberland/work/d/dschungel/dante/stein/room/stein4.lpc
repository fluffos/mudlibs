#include <moving.h>
create()
{
  ::create();

 AddDetail( ({"hoehle", "richtungen"}),
   "Die Hoehle verzweigt sich hier in 3 Richtungen.");
 
 AddItem(NPC"dstgig3" , REFRESH_DESTRUCT);
 
 AddExit( "westen", "./stein3");
