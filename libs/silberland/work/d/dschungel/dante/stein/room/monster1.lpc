// hoehle der steingiganten1
//bei tireks

#include "files.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
create()
{
  ::create();

  SetProp( P_INT_SHORT, "In einer riesigen, unheimlichen Hoehle direkt vorm Tor" );
  SetProp( P_INT_LONG, 
      "Du hast Dich nun verbotener Weise hinter das grosse Tor gewagt. Leise "
      "steigen Zweifel in Dir hoch, ob das eine kluge Idee war. Solltest Du "
      "nicht besser umkehren meldet sich eine Stimme in Dir. Viel zu sehn "
      "ist hier nicht, denn die Hoehle hat solche Ausmasse, dass Du den Hall "
      "Deiner eigenen Schritte hoeren kannst. Die Waende steigen steil nach "
      "oben und die Decke kannst Du kaum mehr erkennen. Lediglich der Boden "
      "erregt Deine Aufmerksamkeit...");

  AddDetail("weise",
      "Weise war das nicht hierher zukommen...");
  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE:20]));      
  AddDetail(("boden"),
      "Der Boden ist glatt, weisst aber teilweise sehr tiefe Gruben auf...");
  AddDetail(({"grube","gruben"}),
      "Woher die wohl stammen...");
  AddDetail(("zelle"),
      "Du denkst . o O 'Ich waere gern in einer sicheren Zelle..'!");
  AddDetail(("aufmerksamkeit"),
      "Vor Angst kannst Du Dich kaum konzentrieren...");
  AddDetail(({"wand", "waende"}),
      "Die Waende sind hier sehr weit weg von Dir, nur in der Westwand erkennst "
      +"Du das grosse "
      "Tor.");
  AddDetail(("westwand"),
      "In der Westwand befindet sich ein grosses Tor.");
  AddDetail(("idee"),
      "Hoffentlich endet die Idee nicht bei Lars!!!");
  AddDetail(("lars"),
      "R.I.P.");
  AddDetail("stimme",
      "Sollte man auf sie hoeren?");
  AddDetail("stadt",
      "Midas...");
  AddDetail("vergleich",
      "Du bist dumm wie Bohnenstroh, z.B.....");
  AddDetail(("hoehle"),
      "Die Hoehle ist ein riesengrosses Gefaengnis...");
  AddDetail(("gefaengnis"),
      "Wer benoetigt eine Zelle mit diesen Ausmassen ?");
  AddDetail(({"ausmase","ausmassen","ausmass"}),
      "Ich hoffe fuer Dich, dass Du das niemals herrausfindest...");
  AddDetail(("schritte"),
      "Langsam und aengstlich bewegst Du Dich hier...");
  AddDetail(("hall"),
      "Gruselig ist es in dieser Hoehle.");
  AddDetail(("zweifel"),
      "Geh lieber wieder nach Midas.");
  AddDetail(("midas"),
      "Die groesste Stadt dieser Welt heisst so.");
  AddDetail(("welt"),
      "Unsere Welt...");
  SetProp( P_LIGHT, 0);
  SetProp( P_INDOORS, 1 );
  AddDetail(("bohlen"),
      "Die Bohlen sind aus hartem Holz und scheinen sehr schwer zu sein.");
  AddDetail(("holz"),
      "Das Holz des Tores weisst tiefe Einkerbungen auf.");
  AddDetail(({"einkerbung","einkerbungen"}),
      "Bei naeherer Betrachtung zeigt sich, dass das Tor auf dieser Seite "
      +"uebel zugerichtet ist.");
  AddDetail(("betrachtung"),
      "Irgendetwas Gewaltiges, Monstroeses muss sich verzweifelt gegen das "
      +"Tor geworfen haben.");
  AddDetail(("seite"),
      "Vielleicht waers besser, wenn Du auf der anderen Seite des Tores waerst...");
  AddDetail(({"gewaltiges","monstroeses"}),
      "Dir laeuft der Angstschweiss den Ruecken hinunter...");
  AddDetail(({"schweiss","angstschweiss","angst","ruecken"}),
      "Mach Dir nur nicht noch in die Hosen...");
  AddDetail(({"hosen","hose"}),
      "Aber dafuer bist Du ja schon zu alt oder ?");
  AddDetail(("decke"),
      "Die Decke ist so weit oben, dass Du sie nur erahnen kannst. Ausserdem "
      "scheint "
      "die Luft mit Nebel erfuellt zu sein.");
  AddDetail(("luft"),
      "Wie ein dichter, grauer Schleier huellt sie alles in ein gespenstisches "
      "Grau ein.");
  AddDetail(("schleier"),
      "Nur ein Vergleich...");
  AddDetail(("grau"),
      "Die Farbe Grau ist gemeint!");
  AddDetail("farbe",
      "ANSI_GREY");
  //absichtlich so:)

  AddDetail(("nebel"),
      "Der Nebel ist irgendwie zu warm und ploetzlich erahnst Du, das es sich "
      +"hier um den "
      "heissen Atem eines gewaltigen Monsters handeln muss.");
  AddDetail(("atem"),
      "Dir scheint er wird immer dichter und heisser...");
  AddDetail(("monster"),
      "Du willst gar nicht an sowas denken...");

  AddSound( DEFAULT_SOUND,
      "Hier ist es totenstill...");

  AddSmell( ({DEFAULT_SMELL, "schweiss", "angstschweiss"}),
      "Du riechts Deinen eigenen Angstschweiss...");


  NewDoor("westen", ("/d/dschungel/dante/stein/room/eingang2"),
      ({"tor","holztor"}),

      ({
       D_FLAGS, DOOR_RESET_CL | DOOR_NEEDKEY | DOOR_CLOSED,
       D_LONG, "Das Tor sieht sehr stabil aus und ist aus dicken Bohlen gefertigt.\n",
       D_GENDER, NEUTER,
       D_SHORT, "Ein %ses Tor.",
       D_NAME, "Tor",
       } ));




  //AddSpecialExit( ({"osten", "norden"}), "nix");  
  AddExit( "osten", "./monster2");
  AddExit( "norden", "./monster5");
}

int nix()
{
  write("Hier geht es vorlaeufig nicht mehr weiter!\n");
  return 1;
}

