// hoehle der steingiganten1

#include "files.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
int lap;
create()
{
  ::create();
  lap = 1;
  SetProp( P_INT_SHORT, "In der Kloake der Steingiganten" );
  SetProp( P_INT_LONG, 
      "IGITT!!! Du bist kopfueber in die stinkende Kloake der Steingiganten "
      "gefallen. Der erbaermliche Gestank steigt Dir in die Nase und Du "
      "musst Dich beinahe uebergeben. Ringsum Dich nur ein seltsamer grauer "
      "Steinbrei von dem ein ekelerregender Geruch aus geht. "
      "Manchmal siehst Du eine Steinlaus im Kot herumkriechen...");
  AddDetail(("nase"),
      "DEINE ARME NASE!!!");
  AddDetail(("kloake"),
      "Durch ein grosses Rohr in der Decke faellt der gesamte Kot der Steingiganten "
      "herab und wird hier langsam von den Steinlaeusen abgebaut.");
  AddDetail(("rohr"),
      "PLUMMMS!!! Ein Haufen Kot trifft Dich mitten am Kopf!!!");
  AddDetail(({"laus","laeuse","steinlaus","steinlaeuse"}),
      "Die Steinlaus heisst mit korrektem Namen Petropharga Lorioti. Sie wird von den "
      "Steingiganten gezuechtet, und baut hier den Kot ab.");
  AddDetail(("geruch"),
      "Es stinkt hier so, dass man es fast schon sehen kann.");
  AddSmell( ({"geruch"}),
      "Es stinkt hier so, dass man es fast schon sehen kann.");
  AddDetail(({"gesteinstruemmer","truemmer","gestein"}),
      "Hier sieht man kaum mehr Truemmer. Alles ist mit Steingigantenkot ueberzogen.");
  AddDetail(("kot"),
      "Der Kot der Steingiganten ist ein grausiger, stinkender Brei aus zermalmten Steinen. "
      "Du kannst drin wuehlen...");
  SetProp( P_LIGHT, 0);
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN:TT_CAVE]) );
  AddDetail(("stein"),
      "Der Granit ist ueberall mit Steinbrei ueberzogen.");
  AddDetail(("granit"),
      "Von dem sieht man nicht allzu viel hier.");
  AddDetail(("grau"),
      "Grau eben...");
  AddDetail( ("boden"),
      "Wie willst Du den Boden erkennen, wenn Du bis zum Kopf im Kot steckst ?\n");
  AddDetail(({"wand","waende"}),
      "Die Waende sind auch fast zur Gaenze mit Kot verschmiert.\n");
  AddDetail(({"brei","steinbrei","steingigantenkot"}),
      "Der stinkende von Steinlaeusen durchzogene Brei hat eine graue Farbe.\n");
  AddDetail(("farbe"),
      "Diese Farbe ist ein dunkles Grau, das manchmal farbig schimmert.");
  AddDetail(({"schimmer"}),
      "Sieht irgendwie wie der Schimmer von Edelsteinen aus...\n");

  AddDetail(("decke"),
      "Die Decke ist gar nicht soweit von Dir entfernt und Du kannst Durch eine Klappe nach oben steigen.");
  AddDetail(("klappe"),
      "Durch die Klappe kommt man wieder in die Hoehle.");
  AddSound( DEFAULT_SOUND,
      "Du hoerst wie die Steinlaeuse im Kot arbeiten.");

  AddSmell( ({DEFAULT_SMELL,"kot", "brei","steinbrei","steingigantenkot", "kloake"}),
      "WAEH!!! Hier stinkt es erbaermlich!!!");

  AddRoomMessage( 
      ({"Du musst Dich uebergeben.\n",
       "Es stinkt hier erbaermlich.\n"
       "Eine Steinlaus kriecht in Dein Ohr.\n",
       "Eine fette Steinlaus wuehlt sich durch den Kot.\n",
       "IGITT!!! Der Ort ist wirklich eklig.\n",
       "PLATSCH!!! Ein Haufen Kot landet knapp neben Dir.\n"}) );

  AddCmd(({"wuehle","wuehl"}), "wuehlen");
  SetProp(P_HIDE_EXITS, ({"oben"}));
  AddExit( "oben", "./stein13");

}

reset()
{
  lap=1;
  ::reset();
}

int wuehlen ( string str )
{
  notify_fail("Worin willst Du wuehlen ?\n");
  if (str != "in kot") return 0;
  if (!lap)
  {
    write( BS ("Du wuehlst mit Deinen Haenden lange im ekligen Kot, findest "
          "aber nichts!"));
    return 1;
  }
  write (BS("Du wuehlst in stinkenden Kot und findest einen glaenzenden "
        "Edelstein, den Du sofort einsteckst."));
  say (CAP_TPN+" wuehlt lange mit grosser Freude im Kot...\n");
  CLONE("/obj/gems/lapislazuli", TP);
  lap--;
  return 1;
}

