// hoehle der steingiganten1

#include "files.h"

inherit ROOM "stein_inh";

#include <properties.h>
#include <language.h>
#include <moving.h>
create()
{
  ::create();

  AddDetail( ({"hoehle"}),
    "Die Hoehle fuehrt hier steil nach oben und unten.");
      
  AddExit( "unten", "./stein28");
 
  AddItem(NPC"dst", REFRESH_DESTRUCT);
  AddItem(NPC"dst", REFRESH_DESTRUCT);
  AddExit("oben", "./stein26");
}
 
 
 
 
