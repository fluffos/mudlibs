// hoehle der steingiganten1

#include "files.h"

inherit ROOM "stein_inh";

#include <properties.h>
#include <language.h>
#include <moving.h>

nosave int fackel;
create()
{
  ::create();


  AddDetail(("hoehle"),
      "Die Hoehle erstreckt sich hier nach allen Richtungen...");
  AddDetail(({"richtung","richtungen"}),
      "Pass nur auf, dass Du Dich nicht verlaeufst...");

  fackel = 1;
  AddDetail(({"wand","waende"}),
      "Die Waende sind aus Stein und weisen viele seltsame Loecher auf. "
      "Die Nordwand faellt Dir besonders auf.");
  AddDetail(("nordwand"),
      "An der Nordwand erkennst Du eine seltsame Zeichnung.");
  AddDetail(("zeichnung"),
      "Die Zeichung stellt einen Oktopus dar...");
  AddDetail(("oktopus"),
      "Als Du Dir so ueberlegst, was ein Oktopus hier zu suchen hat, faellt "
      "Dir sein grosses Auge auf.");
  AddDetail(("auge"),
      "Das Auge scheint Dich direkt anzusehen und Dir faellt auf, dass es etwas "
      "aus der Wand hervorsteht...");

  AddExit( "osten", "./stein4");
  AddExit( "sueden", "./eingang2");
  AddExit( "westen", "./stein10");


  AddItem(NPC"stspinne", REFRESH_DESTRUCT);
  AddItem(NPC"dst", REFRESH_DESTRUCT); 
  AddCmd(({"druecke","drueck"}), "druecken");

}

reset()
{
  fackel=1;
  ::reset();
}

druecken ( string str )
{
  notify_fail("Was willst Du druecken ?\n");
  if ( str != "auge")
  { write ("");
    return 0;
  }

  if ( !fackel)
  { write(" \n"
      "Du drueckst auf das Auge des Oktopus, aber nichts passiert...\n");
  say(CAP_TPN+" drueckt irgendetwas an der Wand, aber nichts passiert.\n");
  return 1;
  }
  if (str == "auge")
    write ( BS(
          "Du drueckst auf das Auge des Oktopus und ploetzlich faellt Dir von "
          "oben ein Gegenstand genau in Deine Arme."));
  say(BS(CAP_TPN+" drueckt irgendetwas an der Wand und schaut Dich dann sehr "
        "erfreut an."));
  CLONE("/obj/fackel", TP);
  fackel--;
  return 1;
}



