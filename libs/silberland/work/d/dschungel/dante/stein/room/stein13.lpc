// hoehle der steingiganten1

#include "files.h"

inherit ROOM "stein_inh";

#include <properties.h>
#include <language.h>
#include <moving.h>
create()
{
  ::create();

  AddDetail( ({"hoehle"}),
    "Die Hoehle verlaeuft hier von Norden nach Sueden.");

  AddDetail(("kratzer"),
  "Die Spuren am Boden scheinen von gewaltigen Werkzeugen herzuruehren."
  " Du glaubst eine versteckte Klappe zu erkennen.\n");
  AddDetail(("klappe"),
  "Die Klappe fuehrt scheinbar nach unten.\n");
  AddDetail(({"bisspuren","spuren","spur","bisspur"}),
  "Hier beissen hungrige Steingiganten ab und zu einmal ab.\n"
  "Eine der Bisspuren sieht eher wie ein Abdruck.\n");
  AddDetail(("abdruck"),
  "Der Abdruck sieht aus, als ob sich jemand mit seiner Hand zu lange angelehnt hat...");
  AddDetail(("hand"),
  "Hmm, was kann man mit Haenden wohl alles so machen ?");

AddCmd(({"schuettel", "schuettle","schuettl"}), "schuetteln");

  AddRoomMessage( 
    ({"Die Steine scheinen sich zu bewegen.\n",
      "Du hoerst ein laute Platschen.\n"
      "Die Erde scheint zu erbeben.\n",
      "Irgendwie klingt der Boden hohl...\n",
      "Hier riecht es sehr streng...\n",
      "Von unten zieht Gestank herauf...\n",
      "Die Steine scheinen hier zu leben...\n",
      "Eine kleiner Stein faellt von der Decke herab.\n"}),50);
      
 AddExit( "norden", "./stein21");
  AddExit( "sueden", "./stein12");
 } 
 
 
 int schuetteln(string str )
 {        
 notify_fail("Was oder wen willst Du schuetteln ?\n");
 if ( !str ) return 0;
 if ( member( ({ "hand", "steinhand"}), str) !=-1 )
 {
 write(
 " \n"
 "Du versuchst den steinernen Abdruck einer Hand zu schuetteln und\n"
 "ploetzlich oeffnet sich eine Klappe im Boden und Du faellst nach unten.\n"
 " \n");
 TP->move(ROOM "stein20", M_GO, "durch eine Klappe im Boden",
 "faellt", "kommt durch eine Klappe in der Decke herab geflogen.");
 
 return 1;
 }
                                                                                                                                                                                                    
 return 0;
 }
 
 
