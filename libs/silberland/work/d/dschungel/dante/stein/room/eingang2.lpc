// hoehle der steingiganten1
//erweiter im juli 98 tafel fuer  tirekskills undopfer
//dante:)
#include "files.h"

inherit ROOM "stein_inh";

#include <properties.h>
#include <language.h>
#include <moving.h>
#define ASD AddSpecialDetail
#define AD AddDetail
string sieger();

create()
{
  ::create();

  SetProp( P_INT_LONG, 
      "Du stehst nun in der gewaltigen Hoehle der Steingiganten. Alles, aber wirklich "
      "alles besteht hier aus purem Stein. Die Waende, der Boden, die Decke, Du siehst"
      " nichts als Stein. Ueberall liegen meterhohe Gesteinstruemmer herum.\n"
      "Eine schwarze Marmortafel.\n"
      "Eine weisse Marmortafel.\n");


  AddDetail("tafel",
      "Welche Tafel willst Du untersuchen?");
  AddSpecialDetail(({"weisse tafel", "weisse marmortafel"}), "sieger");
  AddSpecialDetail(({"schwarze tafel", "schwarze marmortafel"}), "versager");
  AddDetail(({"marmor", "marmortafel"}),
      "Schwarzer und weisser Marmor. Sehr nobel.");

  AddDetail(("stahl"),
      "HART!");
  AddDetail(("hoehle"),
      "Die Hoehle wird immer dunkler und fuehrt tief in den Stein hinein.");
  AddDetail(({"wand","waende"}),
      "Die Waende sind aus Stein und weisen viele seltsame Loecher auf. "
      "In der Ostwand siehst Du ein grosses Tor.");
  AddDetail(("ostwand"),
      "In der Ostwand hat jemand ein grosses Tor errichtet, das einen sehr "
      "stabilen Eindruck macht.");
  AddDetail(("bohlen"),
      "Die Bohlen sind aus hartem Holz und scheinen sehr schwer zu sein.");
  AddDetail(("holz"),
      "Du betrachtest das Holz naeher und erkennst ein kleines Schild.");
  AddDetail(("schild"),
      "Du kannst das Schild lesen.");
  AddReadDetail("schild",
      "+-----------------+\n"
      "|      DAS        |\n"
      "|    OEFFNEN      |\n"
      "|      DES        |\n"
      "|     TORES       |\n"
      "|      IST        |\n"
      "|    VERBOTEN !   |\n"
      "+-----------------+\n");

  AddDetail(("schloss"),
      "Das Schloss ist aus hartem Stahl gefertigt. Irgendjemand muss wohl den "
      "passenden Schluessel haben.");
  AddDetail(("schluessel"),
      "Wer den wohl hat?");

  AddItem(NPC"waechter", REFRESH_DESTRUCT);

  AddDetail("zeichnung",
      "Die Zeichung zeigt ein unglaubliches Monster, das gerade gegen mehrere "
      "Krieger kaempft.");
  AddDetail("monster",
      "Das Monster ist gigantisch gross. Es hat einen Panzer aus Schuppen.");
  AddDetail("panzer",
      "Der Panzer hat keine Schwachstelle! Keine, oder doch etwa...");
  AddDetail("schuppen",
      "Harte Schuppen!");
  AddDetail("schwachstelle",
      "Dort wo Du Dein Herz hast, hat dieses Monster eine Ansammlung "
      "boeser Magie. Es ist seine Magiestelle!");
  AddDetail(({"magie","magiestelle","ansammlung"}),
      "Einer der Krieger sticht gerade eine Stange in diese Magiestelle!!! "
      "Wahnsinn!");
  AddDetail("stange",
      "Die Stange wird wohl irgendwo existieren!");
  AddDetail("krieger",
      "Die Krieger scheinen zu unterliegen!!! Einer davon hat eine Stange in der Hand! "
      "Untersuche unbedingt das Detail Hand!!!!!!!!!!");
  AddDetail("hand",
      "Da ist die Stange, Du Seicherl.");
  AddDetail("seicherl",
      "Du schlaegst ein Lexikon auf und suchst nach Seicherl.\n"
      "Da steht: Synonym fuer Sengir.\n"
      "Wusstest Du es doch!");
  ASD("sengir", "show");


  NewDoor("osten", (ROOM "monster1"),
      ({"tor","holztor"}),

      ({
       D_FLAGS, DOOR_RESET_CL | DOOR_NEEDKEY | DOOR_CLOSED,
       D_LONG, "Das Tor sieht sehr stabil aus und ist aus harten Bohlen gefertigt. "
       "Ein grosses Schloss sichert es und eine Zeichnung verziert es.",
       D_GENDER, NEUTER,
       D_SHORT, "Ein %ses Tor.",
       D_NAME, "Tor",
       } ));

  AddRoomMessage(({
        "Irgendetwas Boesartiges muss hier irgendwo sein.\n",
        "Das Detail Hand ist enorm wichtig!\n",
        "Die Hoehle scheint zu beben.\n",
        "Du hast Angst!\n",
        "Das Tor sieht sehr interessant aus!\n",
        "Du denkst . o O '                 '! Das ist nicht viel!\n"}),30);

  AddExit( "sueden", "./eingang1");
  AddExit( "norden", "./stein3");
  seteuid(getuid(this_object()));
}



string show()  {
  object ob;
  if (getuid(this_player())=="sengir")  {      
    write("Gruess Dich Sengir! Na sowas! Du bists ja selbst!\n");  
  }
  else 
  {
    ob=find_living("sengir");

    write("Tja, Du bist "+TPN+" und nicht Sengir, da staunst Du!\n");
    if(ob)  {
      tell_object(ob,
          CAP_TPN+" untersucht gerade das Detail Sengir bei den Steingiganten!\n");
      write("Sengir ist gerade anwesend, aerger ihn doch einwenig!\n");

      if(present(ob, environment(TP)) ) {
        write("Nebenbei bemerkt ist er im selben Raum wie Du, Du Ei!\n");
      }
      else  {
        write("Sengirs Umgebung sieht gerade so aus:\n"
            ""+environment(ob)->QueryProp(P_INT_LONG)+"");
      }

    }
    if(!ob)  {
      write("Leider ist Sengir im Moment nicht da!\n");
    }  
  }

  return ""; 
}


string sieger()
{
  write("Gewidmet den heldenhaften Bezwingern von Tireks. Moege das ganze "
      "Silberland von ihrem Mut, ihrer Ehre und Tapferkeit erfahren. Sie leben hoch!!!\n\n");

  TP->more("/d/dschungel/dante/stein/log/tireks.kills");
  return "";

}

string versager()
{
  write("Zum Andenken an die furchtlosen, doch leider dummen Opfer "
      "von Tireks.\nSie alle hatten einen langen, qualvollen und grausamen Tod.\n\n");
  TP->more("/d/dschungel/dante/stein/log/spieler.deads");
  write("\n                            R.I.P.\n");
  return "";
}

