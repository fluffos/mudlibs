//beAMERLAUBNIS FUER DR:CREEP DANTE 97

inherit "std/thing"; 
#include <language.h>
#include <properties.h>
#include <combat.h>
#include <defines.h>
#include <moving.h>
#include "files.h"

create()

{ if(!is_clone(this_object())) return;
  thing::create();
  SetProp(P_SHORT,"Dr.Creeps ID");
  SetProp(P_LONG,BS(
  "Das ist Dr.Creeps Identifikationskarte. Eigentlich ist sie ja nicht viel "
  "wert, aber wer weiss, vielleicht hat sie ja doch einen Sinn."));
  SetProp(P_VALUE,30);
  SetProp(P_WEIGHT,100);
  SetProp(P_GENDER, FEMALE);
  SetProp(P_NAME,"Identifikationskarte");
  SetProp(P_MATERIAL, ({MAT_MAGIC, MAT_PAPER}));
  SetProp(P_INFO, ("Sie hat einen Sinn, jawohl! :)\n"));
  
  AddId(({"beam","scotty","id","karte","identifikatioskarte"}));
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 0);

}

