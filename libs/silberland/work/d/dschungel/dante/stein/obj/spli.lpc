//ein zahn von tireks
//kann man sammeln wird dann autoload zum rumprotzen
//kann man in waffe stecken
inherit "std/unit";

#include <properties.h>
#include <language.h>
#include "files.h"

create()
{
  if (!is_clone(this_object()) )  return;

  ::create();

  SetProp(P_SHORT, "Ein Reisszahn von Tireks");
  SetProp(P_LONG,BS(  
    "Eigentlich ist das gar kein ganzer Reisszahn, sondern nur ein kleines, "
    "scharfes Stueck davon. Es blitzt und glaenzt und manchmal glaubst Du "
    "ein seltsames Grinsen zu sehen?!?\n"));
    AddDetail("grinsen",
    "Deine Phantasie spielt Dir einen Streich. Du hast wohl Angst vor Tireks "
    "grausamer und brutaler Rache!");
    AddDetail("stueck",
    "Ein Splitter.");
    AddDetail("splitter",
    "Hmm, wozu die Splitter wohl dienen?");
    
    
  SetProp(P_INFO, 
    "Der Splitter dient als Beweis fuer Deine erbrachte Heldentat.\n"
    "Ausserdem kann man damit, nein, nix wird verraten.\n");
    
  SetProp(P_NAME, ({"Reisszahn", "Reisszaehne"}) );
  SetProp(P_GENDER, MALE);

  AddSingularId( ({"reisszahn", "zahn","splitter", "\nspli_dante"}) );
  AddPluralId( ({"zaehne", "splitter","reisszaehne", "\nspli_dante"}) );
  SetCoinsPerUnits(100,1);
  SetGramsPerUnits(1,1);
  SetProp(P_AMOUNT, 20+random(20));
  SetProp(P_MATERIAL, ({MAT_BONE, MAT_MAGIC}) );
  SetProp(P_NOBUY, 1);
  SetProp(P_NODROP, 0);

}
