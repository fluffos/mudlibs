
inherit "std/thing";

#include <properties.h>
#include <moving.h>
#include "files.h"
#include <wizlevels.h>
#include <language.h>
#include <new_skills.h>
string oldtitle, oldlook;

object player;
create() 
{

::create();
if (!is_clone(this_object())) return;
SetProp(P_NAME, 0);
SetProp(P_SHORT, 0);
SetProp(P_NEVERDROP, 1);
SetProp(P_NODROP, 1);
AddId (({"spot","pickelgesicht"}));//absichtlicht nicht pickel

call_out("st1", 10);
SetProp(P_WEIGHT, 0);
SetProp(P_EXTRA_LOOK, ""+TPN+" hat sehr viele Pickel im Gesicht.\n"); 
oldtitle=TP->QueryProp(P_PRESAY);
oldlook=TP->QueryProp(P_EXTRA_LOOK);     
}


  
 st1()
 
 {
 TP->SetProp(P_PRESAY, "Das Pickelgesicht");
 player=this_player();
 write(
       "Du ekelst Dich vor Deinen Pickeln...\n");
  say(capitalize(player->name())+" hat sehr viele Pickel im Gesicht.\n");     
 call_out("st2",200);           
 
  }  
      
st2()
 { say(capitalize(player->name())+" ist ein Pickelgesicht.\n");
 
 write("Du schaemst Dich fuer Deine Pickel!\n");
      call_out("st3",200); 
       }
       
 st3()
 { 
  say(capitalize(player->name())+" sieht ziemlich eklig aus.\n");
   write(
        "Deine Pickel platzen auf.\1~;\n");
  call_out("story4", 200);
         
  }
  
  story4()
  {
  TP->SetProp(P_PRESAY, oldtitle);
  TP->SetProp(P_EXTRA_LOOK, oldlook);
  
remove("spot");
return 1;
}
