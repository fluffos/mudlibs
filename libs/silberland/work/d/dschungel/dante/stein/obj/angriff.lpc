inherit "std/thing";

#include <properties.h>

create()
{
  ::create();
  if (!is_clone(this_object())) return;
  AddId("angriff");
  SetProp (P_SHORT, 0);
  SetProp (P_NAME, 0);
  SetProp (P_NEVERDROP, 1);
  SetProp (P_NODROP, 1);
  SetProp(P_INVIS);
  SetProp (P_WEIGHT, 0);
  call_out ("remove", 600 );
  
}



 remove()
{
write("Der Zorn der Waechter hat sich wieder gelegt.\n");
  ::remove();
}
