inherit "std/thing"; 
#include <language.h>
#include <properties.h>
#include <combat.h>
#include "/players/dante/myowndefine.h"
#include <moving.h>

int count=0;
object da;

create()

{ if(!is_clone(this_object())) return;
  thing::create();
  SetProp(P_SHORT,"Eine Spraydose");
  SetProp(P_LONG, 
   "Eine kleine Spraydose. Solche Dosen werden normalerweise von Malern "
   "zum spruehen verwendet, doch diese Dose erscheint Dir etwas merkwuerdig. Ein kleines "
   "Schild baumelt mit einem Faden befestigt an der Dose.");

  SetProp(P_NOGET,0);
  SetProp(P_VALUE,10);
  SetProp(P_WEIGHT,20);
  SetProp(P_GENDER, FEMALE);
  SetProp(P_NAME,"Spraydose");
  AddId(({"dose","spray","spraydose"}));
  AddDetail("dose",this_object()->QueryProp(P_LONG));
  SetProp(P_NOBUY, 1);
  
  AddDetail("schild",
   "Dies ist ein Sichtbarmacher! Aeusserste VORSICHT!!.\n");
   
 
 AddDetail("faden",
  "An dem Faden haengt ein Schild.\n");
 
 
  seteuid(getuid());
  AddCmd(({"spruehe","sprueh"}),"sfunc");

}

 sfunc(str)
  { string *ob;
    notify_fail("Achso?!");

    
    count ++;
    
    if (count >= 4)
     {write("Es scheint als haette die magische Farbe ihre Kraft verloren.\n");
      write("Die Spraydose loest sich in Deinen Haenden auf.\n");
      this_object()->remove();
      return 1;
     }
    
    write("Du spruehst mit der magischen Farbe im Raum herum.\n");    
    say(this_player()->QueryProp(P_NAME)+" sprueht mit magischer Farbe in der Gegend herum.\n");
    ob=environment(this_player())->QueryProp(P_IDS);
if(!present("tireks",environment(this_player())))
 {
   
  da=find_living("tireks");   
   if(objectp(da))
   {
   write("Nein! Tireks ist noch sichtbar hier.\n");
   return 1;
   }


    if(member_array("spraymob",ob)!=-1)
     {
      write_file("/d/dschungel/dante/stein/log/tirekswirdvis",
         "Am "+ctime()+" hat "+CAP_TPN+" Tireks erzeugt.\n");
     
      clone_object("/d/dschungel/dante/stein/npc/tireks.lpc")->move(
       "/d/dschungel/dante/stein/room/monster4.lpc",M_NOCHECK+ M_TPORT);
      write("Tireks reisst Dir die Spraydoese aus der Hand und frisst sie genuesslich auf.\n");
      this_object()->remove();
      return 1;
     }
  
 }  
    write("Doch es passiert nichts.\n");
    return 1;    
    
    }
