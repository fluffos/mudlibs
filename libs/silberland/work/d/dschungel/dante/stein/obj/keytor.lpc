/*
** schlueysel fuer tor stein
** 
** 2. 4 97 dante
*/

inherit "std/thing";

#include <properties.h>
#include <rooms.h>


create()
{
  if (!is_clone(this_object())) return;
  ::create();
  SetProp (P_SHORT, "Ein grosser Metallschluessel");
  SetProp (P_LONG, (
  "Dieser Schluessel muss wohl ein gewaltiges Tor sperren. Er liegt schwer in der "
  "Hand. Wem er wohl einmal gehoert hat..."));
  
  SetProp (P_NAME, "Metallschluessel");
  SetProp (P_GENDER, MALE);
  SetProp (P_VALUE, 0);
  SetProp (P_WEIGHT, 300);
  SetProp (P_NOBUY, 1);
  SetProp (P_NEVERDROP, 0);
  AddId (({"metallschluessel", "schluessel"}));
  
  SetProp(P_INFO, "Der Metallschluessel koennte Dich ins Verderben fuehren.\n");  
SetProp(P_MATERIAL, MAT_IRON);
}
string QueryDoorKey()
{
return ("/d/dschungel/dante/stein/room/eingang2")+":"+("/d/dschungel/dante/stein/room/monster1");   
}



