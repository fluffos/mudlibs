//ding fuer quest!!!!

inherit "std/thing"; 
#include <language.h>
#include <properties.h>
#include <combat.h>
#include <defines.h>
#include <moving.h>
#include "files.h"

create()

{ if(!is_clone(this_object())) return;
  thing::create();
  SetProp(P_SHORT,"Eine praehistorische Energiezelle");
  SetProp(P_LONG,BS(
  "Das ist keine eigentliche Energiezelle, sondern nur ein Stueck Metall, " 
  "das auf magische Art Energie speichert..."));
  SetProp(P_VALUE,10);
  SetProp(P_WEIGHT,500);
  SetProp(P_GENDER, FEMALE);
  SetProp(P_NAME,"Energiezelle");
  SetProp(P_MATERIAL, ({MAT_MAGIC, MAT_METAL}));
  SetProp(P_INFO, ("Irgendeinen Sinn wird die Energiezelle schon haben.\n"));
  
  AddId(({"zelle","energiezelle"}));
  SetProp(P_NOBUY, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
// nicht fertig da quest auc nicht fertig

}

