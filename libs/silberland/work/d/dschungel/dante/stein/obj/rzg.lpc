//ein bug fuer dem MM

inherit "std/thing"; 
#include <language.h>
#include <properties.h>
#include <combat.h>
#include <defines.h>
#include <moving.h>
#include "files.h"

create()

{ if(!is_clone(this_object())) return;
  thing::create();
  SetProp(P_SHORT,"Ein Fehler im Raum-Zeit-Gefuege");
  SetProp(P_LONG,BS(
   "Das ist ein Fehler im Raum-Zeit-Gefuege. Wer den wohl verursacht hat?"));
  SetProp(P_VALUE,0);
  SetProp(P_WEIGHT,10);
  SetProp(P_GENDER, MALE);
  SetProp(P_NAME,"Raum-Zeit-Gefuege-Fehler");
  SetProp(P_MATERIAL, ({MAT_MAGIC}));
  SetProp(P_INFO, ("So etwas lieben alle Magier!\n"));
  
  AddId(({"fehler"}));
  SetProp(P_NOBUY, 0);
  SetProp(P_NOSELL, 0);

}

