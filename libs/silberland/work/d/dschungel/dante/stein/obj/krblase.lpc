//eine duene blase aus kristall erzeugt seifenblasen
//dante sl 98


#include "/players/dante/myowndefine.h"


inherit "std/thing";
#include <language.h>
#include <properties.h>
#include <combat.h>
#include <defines.h>
#include <moving.h>


int blase =10;

create()
{
  if (!is_clone(ME)) return;
  ::create();
  SetProp (P_SHORT, "Eine hauchduenne Kristallblase");
  SetProp (P_LONG, BS(
  "Das ist eine hauchduenne Blase aus Kristall. Sie schimmert "
  "und glitzert im Licht. In ihrem Inneren schwappt langsam "
  "eine klare Fluessigkeit hin und her."));
  SetProp (P_NAME, "Kristallblase");
  AD("kristall",
  "Der Kristall schmimmert hell.");
  AD("licht",
  "Das Licht gleisst und funkelt.");
  AD("fluessigkeit",
  "Sie ist sehr klar und scheint irgendwie zu leben.");
  AD(({"inneres","innen", "inneren"}),
  "Innen im Kristall befindet sich eine klare Fluessigkeit.");
  SetProp (P_GENDER, FEMALE);
  AddId(({"blase","kristallblase"}));
  SetProp (P_INFO, ("Mit dem Befehl <kblase> kann man Seifenblasen erzeugen.\n" 
  "Mit dem Befehl <untersuche inhalt>, siehst Du wieviele Seifenblasen Du noch erzeugen "
  "kannst.\n"));
  SetProp (P_VALUE, 200);
  SetProp (P_WEIGHT, 50);
  SetProp (P_NOBUY, 1);
  SetProp (P_MATERIAL, ({MAT_MAGIC, MAT_CRYSTAL, MAT_MISC_FLUID}));
  ACD("kblase", "create_blase");
  ASD("inhalt", "show_inhalt");
}

  string show_inhalt()
  {
  if(blase==1)
    return "Du kannst noch eine Seifenblase erzeugen!\n";
  else
    return "Du kannst noch "+blase+" Seifenblasen erzeugen!\n";
  }
     
     
     
 int create_blase()
   {
   object ob;

   write(BS("Du schaust tief in das Innere der Kristallblase und die "
      "Fluessigkeit beginnt hin und her zu schwappen. Dann loest sich "
      "langsam ein Teil der Fluessigkeit und verlaesst die Kristallblase."));
    ob=clone_object("d/dschungel/dante/stein/npc/sblase");
    ob->move(environment(TP), M_TPORT);
    blase--;

    if(!blase)
      {
      write(BS("Dann zerplatzt Deine Kristallblase."));
      remove();
      }
   return 1;
   }
