//ein bug fuer dem MM

inherit "std/thing"; 
#include <language.h>
#include <properties.h>
#include <combat.h>
#include <defines.h>
#include <moving.h>
#include "files.h"

nosave int key;

create()

{ if(!is_clone(this_object())) return;
  thing::create();
  SetProp(P_SHORT,"Eine seltsame Statue");
  SetProp(P_LONG,BS(
        "Die Statue, die da eben direkt vor Dir aus dem Boden gefahren ist, sieht "
        "sehr merkwuerdig aus. Eigentlich stellt sie eine Figur dar, die Dich an irgendetwas erinnertn..."));
  AddDetail("figur",
      "Sieht irgendwie aus wie August, aber das Gesicht ist ziemlich entstellt.");
  AddDetail("august",
      "August, der irre Jojofreak...");
  AddDetail("gesicht",
      "Aus grossen Augen starrt sie Dich an. Der Mund ist weit offen, die Nase "
      "angeschwollen und die Ohren haengen schlaff herab.");
  AddDetail(({"auge","augen"}),
      "Die Augen schmimmern grau und tot.");
  AddDetail("mund",
      "Der Mund steht weit offen, sehr weit offen.");
  AddDetail("nase",
      "Die Nase ist rund und knollenmaessig.");
  AddDetail(({"ohren","ohr"}),
      "Die Ohren haengen wie nasse Lappen vom Kopf.");
  AddDetail("kopf",
      "Der Kopf ist rund und hat ein eigenartiges Gesicht.");
  AddDetail("koerper",
      "Der Koerper ist gedrungen und rundlich.");
  AddDetail("lappen",
      "Ein Vergleich...");

  SetProp(P_VALUE,0);
  SetProp(P_WEIGHT,10000000000);
  SetProp(P_GENDER, FEMALE);
  SetProp(P_NAME,"Statue");
  SetProp(P_MATERIAL, ({MAT_MAGIC, MAT_STONE}));
  SetProp(P_INFO, ("Irgendwas muss an der Statue ja dran sein. \n"));

  AddId(({"statue"}));
  SetProp(P_NOBUY, 0);
  SetProp(P_NOSELL, 0);
  SetProp(P_NOGET, ("Die Statue ist viel zu schwer fuer Dich Schwaechling.\n"));
  AddCmd(({"stecke","steck","leg","lege","wirf","werfe"}), "get");  

  key = 1;
}

void reset()
{
  ::reset();
  key=1;
}   


int get(string str)
{
  object ob;
  notify_fail("Was willst Du wohinein werfen?\n");
  if (!str) return 0;

  if((str=="kopf in mund") && (key) && (present("kopf",TP))) 
  {
    write("Du wirfst den kleinen Kopf in den Mund der Statue, die Statue "
        "explodiert und ein anderer Gegenstand landet direkt vor Deinen "
        "Beinen...\n");
    say(""+TPN+" macht sich an der Statue zu schaffen und ploetzlich "
        "explodiert diese...\n");
    ob=clone_object("/d/dschungel/dante/stein/obj/ding2");
    ob->move(environment(TP), M_TPORT);
    key--;
    call_out("weg", 0);


    return 1;
  }


  if((str=="kopf in mund") && (!key) && (present("kopf",TP))) 
  {
    write("Du wirfst den Kopf in den Mund der Statue, doch seltsamerweise "
        "spuckt diese den Kopf immerwieder zu Dir zurueck.\n");
    say(""+TPN+" macht sich vergeblich an der Statue zu schaffen.\n");
    return 1;
  }
  if((str=="kopf in mund") && (present("!kopf",TP)) )
  {
    write("Aber Du hast nichts geeignetes zum in den Mund werfen.\n");
    say(""+TPN+" macht nur Unfug.\n");
    return 1;
  }
  return 0;
}

//damir auch alle wieder verschwident

weg()
{
  object ob2;
  object ob;
  if(ob=present("kopf", TP))
  {
    ob->remove();
  }
  if(ob2=present("statue", environment(TP)))
  {
    ob2->remove();
  }


  else
  {
    write("BUG! Magier verstaendigen!\n");
  }
}

