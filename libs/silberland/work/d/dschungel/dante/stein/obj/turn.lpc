//invis obj fuer fdrehwurm
//kein dammage nur spass....moeglichweweise verwirrug des orietierungssinns
//mal sehn dante 98 sl

#include "../def.h"   

inherit "std/thing"; 

string oldlook;
int count;
object t;
object te;

create()
{
  if(!is_clone(this_object())) return;
  ::create();
  SetProp(P_SHORT, 0);
  SetProp(P_LONG, 0);
  count = 0;

  SetProp(P_VALUE,0);
  SetProp(P_WEIGHT,0);
  SetProp(P_GENDER, MALE);
  SetProp(P_NAME,0);

  AddId(({"\ndrehwurmturn","TURN", "Krankheit"}));
  AddClass(CL_DISEASE);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  call_out("a", 10);
  oldlook="";
}

string extra_look()
{
  return "Du glaubst einen Drehwurm zu erkennen!!!\n";
}

void a()
{

  //naja eigentlivch sollte der raum auch was mitkriegen aber irgendwie
  //bekam der spieler beides mit also tell_Object und tell_room
  //mich nervt das nun..wenn du irgendwie so machst das der spieler nur
  //tell_obj hat und der raum tell room waers cool danke
  //dante fuer  thor

  t=environment(TO); //->capitalize(name());
  te=environment(t);
  //oldlook=QueryProp(P_EXTRA_LOOK, t);

  tell_object(t,"Du fuehlst wie irgendetwas in Dir herumkriecht.\n");
  if (te)
    tell_room(te, t->Name(WER)+" zuckt. Ein winziger Wurm lugt aus "+
        t->QueryPossPronoun(NEUTER, WEM)+" Ohr hervor.\n", ({t}));
  call_out("b", 15);
}

b()
{
  if (!t || !environment(t)) return remove();
  tell_object (t,"Du spuerst genau wie irgendetwas in Deinem Kopf herumkriecht.\n");
  tell_room(environment(t), t->Name()+" tastet aengstlich den Kopf ab.\nIrgendetwas kriecht in "
      +t->QueryPossPronoun(MALE, WEM)+" Kopf herum. Kein schoenes Gefuehl!\n", ({t}));
  call_out("c", 15);
}

c()
{
  if (!t || !(te=environment(t))) return remove();
  if (count>=random(15)+(5))
  {
    call_out("ende", 10);
  }
  else
  {

    switch(random(10))
    {
      case 0:
        tell_object(t,"Du scheinst den Drehwurm zu haben!\n"
            "Du drehst Dich um die eigene Achse!\n");
        tell_room(te, t->Name(WER)+" hat den Drehwurm!\n"
            +t->QueryPronoun(WER)+" dreht sich um die eingene Achse.\n", ({t}));
        count++;
        break;
      case 1:
        tell_object(t,"Du drehst Dich wie wild herum.\n");
        tell_room(te, t->Name(WER)+" dreht sich wie wild herum.\n", ({t}));
        count++;
        break;       
      case 2:
        tell_object(t,"Dir wird schwindlig vom vielen Herumdrehen!\n");
        tell_room(te, t->Name(WER)+" wird vom vielen Herumdrehen gruen im "
            +"Gesicht.\n", ({t}));
        count++;
        break;
      case 3:
        tell_object(t,"Du drehst Dich wie ein irrer Kreisel herum.\n");
        tell_room(te, t->Name(WER)+" dreht sich wie ein irrer Kreisel herum.\n",
            ({t}));
        count++;
        break;
      case 4:
        tell_object(t,"Der Drehwurm zwingt Dich zu einer ganzen "
            +"Drehung!\n");
        tell_room(te, t->Name(WER)+" macht eine ganze Drehung!\n", ({t}));
        count++;
        break;
      case 5:
        tell_object(t,"Der Drehwurm dreht sich und Dich herum!\n");
        tell_room(te, t->Name(WER)+" wird vom Drehwurm herumgedreht!\n", ({t}));
        count++;
        break;
      case 6:
        tell_object(t,"Du drehst Dich wie eine Ballerina mit "
            +"Kinderlaehmung im Kreis.\n");
        tell_room(te, t->Name(WER)+" dreht sich wie eine Ballerina mit "
            +"Kinderlaehmung im Kreis.\n", ({t}));
        count++;
        break;
      case 7:
        tell_object(t,"Wummm!!! Du drehst Dich und landest unsanft am "
            +"Boden!\n");
        tell_room(te, t->Name(WER)+" dreht sich und landet unsanft am Po!\n", 
            ({t}));
        count++;
        break;
      case 8:
        tell_object(t,"Du machst eine grazioese Drehung! Grazioes wie "
            +"ein besoffenes Nashorn!\n");
        tell_room(te, t->Name(WER)+" dreht sich grazioes wie ein besoffenes "
            +"Nashorn!\n", ({t}));
        count++;
        break;
      case 9:
        tell_object(t,"Du drehst Dich wild im Kreis und stoesst ueberall "
            +"an!\n");
        tell_room(te, t->Name(WER)+" dreht sich und rammt Dich dabei! Flegel!\n",
            ({t}));
        count++;
        break;
      default:write("BUG!\n");
    }
    call_out("c", random(5)+(10));

  }
}


ende()
{
  if (!t || !(te=environment(t))) return remove();
  tell_object(t,"Der Drehwurm scheint Dich nicht mehr zu drehen!\n");
  tell_room(te, t->Name(WER)+" ist vom Drehwurm erloest!\n", ({t}));
  remove();
}

