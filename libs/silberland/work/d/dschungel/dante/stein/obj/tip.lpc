// dante@SilberLand ausweis fuer august

#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Ein dreckiger, alter Zettel");
  SetProp(P_LONG, (
   "                           ...mutabo...\n"  
   "                ...exa..bulc...drows...pihw..raeps...\n"
   "                           ...bersa...\n")); 
  SetProp(P_INFO,  "Was soll das wohl bedeuten...\n" );
  SetProp(P_NAME, "Zettel");
  SetProp(P_GENDER, MALE);
  AddId(("zettel"));

  SetProp(P_MATERIAL, MAT_PAPER);
  SetProp(P_WEIGHT, 20);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
}
