// leuter von dante sl 97 feb

#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Eine lange Granitleiter");
  SetProp(P_LONG, BS( 
    "Diese Granitleiter besteht wie der Name schon sagt aus Granit. Trotzdem ist sie nicht allzu schwer."));
  SetProp(P_NAME, "Granitleiter");
  SetProp(P_GENDER, FEMALE);
  AddId(({"granitleiter","leiter", "dleiter", "\ndleiter"}));
  SetProp(P_NOBUY, 1);
  SetProp(P_MATERIAL, MAT_STONE);
  SetProp(P_WEIGHT, 3000);
  SetProp(P_VALUE, 300);
  SetProp(P_SIZE, 100);
}
