//riesenstein der einem auf den kopf faellt
inherit "std/thing";
#include <language.h>
#include <properties.h>
#include "files.h"


create()
{
   if (!is_clone(this_object())) return;
   ::create();
   AddId(({"papier","zettel","pergament"}));
   SetProp(P_NAME, "Pergament");
   SetProp( P_GENDER , NEUTER );
   SetProp(P_SHORT, "Ein altes Pergament" );
   SetProp(P_LONG, BS(
    "Dieses Pergament scheint schon recht alt zu sein. Auf jeden Fall ist es vergilbt "
    "und riecht recht unangenehm. Einige Hieroglyphen scheinen aber noch erhalten zu sein."));
    AddDetail("hieroglyphen",
    "Hmm, es scheinen keine Hieroglyphen zu sein, sondern eher eine Art Code.");
    AddDetail("code",
    "Wie der Code funktioniert, weiss Du noch nicht, aber hier steht: \n"
    "!9t9g q, #2w#9 ii, s($+? z ");
    
   SetProp(P_SMELL,(
   "Hmm, Du riechst am Pergament und ploetzlich formen sich in Deinem Kopf\n"
   "merkwuerdige Zeichen:\n"
   "!=H, g=l, #=t, z=c, q=5, w=s, (=n, i=3, +=p                         \n"));     
   SetProp(P_NODROP, 1);
   SetProp(P_NEVERDROP, 1);   
   SetProp(P_MATERIAL,MAT_PAPYRUS);
   SetProp(P_VALUE,0);
   SetProp(P_WEIGHT,100 );
}

