inherit "std/food";

#include <properties.h>
#include <food.h>
#include "files.h"

create()
{
  if (!is_clone(ME)) return;
  ::create();
  SetProp (P_SHORT, "Hexenblut");
  SetProp (P_LONG, BS(
  "Das ist kein richtiges Blut, sondern eine Pflanze, die blutrot ist und "
  "der man magische Faehigkeiten zuordnet. Wer weiss wozu sie gut ist."));
  SetProp (P_NAME, "Hexenblut");
  SetProp (P_GENDER, NEUTER);
  SetProp (P_VALUE, 1000);
  SetProp (P_WEIGHT, 50);
  SetProp(P_SIZE, 10);
  SetProp (P_NOBUY, 1);
  SetProp(P_NOSELL, 0);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_INFO, ("Ja, das Hexenblut hat magische Faehigkeiten, aber welche ? "
  "Angeblich soll esmanchmal auch gefaehrlich sein...\n")); 
  AddId (({"blut","hexenblut","bon"}));
  SetProp (P_FOOD_INFO, ([F_HEAL: 0, F_SOAK: 1, F_ALCOHOL: 0, F_POISON: 0]));
}

BeimEssen()
{
switch(random(100))
{
case 0..5:
TP->SetProp(P_POISON, 2);
write ("Du isst das Hexenblut ganz auf und wartest was passiert.\n");
say (TPN+" isst das Hexenblut auf.\n");
return ::BeimEssen();
break;

case 6.. 10:
TP->SetProp(P_FROG, 1);
write ("Du isst das Hexenblut ganz auf und wartest was passiert.\n");
say (TPN+" isst das Hexenblut auf.\n");
return ::BeimEssen();
break;
 
case 11..50:
write ("Du isst das Hexenblut ganz auf und wartest was passiert.\n");
say (TPN+" isst das Hexenblut auf.\n");    
TP->heal_self(250);
return ::BeimEssen();  
break;

case 51.. 75:
TP->restore_spell_points(250);
write ("Du isst das Hexenblut ganz auf und wartest was passiert.\n");
say (TPN+" isst das Hexenblut auf.\n");
return ::BeimEssen();

case 76 .. 95:
TP->SetProp(P_SP, 200);
write ("Du isst das Hexenblut ganz auf und wartest was passiert.\n");
say (TPN+" isst das Hexenblut auf.\n");
return ::BeimEssen(); 
break;

case 96 ..99:
TP->SetProp(P_BLIND, 1);
write ("Du isst das Hexenblut ganz auf und wartest was passiert.\n");
say (TPN+" isst das Hexenblut auf.\n");
return ::BeimEssen();  
}

}
