//kopf der figur fuer quest!!!!

inherit "std/thing"; 
#include <language.h>
#include <properties.h>
#include <combat.h>
#include <defines.h>
#include <moving.h>
#include "files.h"

create()

{ if(!is_clone(this_object())) return;
  thing::create();
  SetProp(P_SHORT,"Ein kleiner goldener Kopf");
  SetProp(P_LONG,BS(
  "Dieser Kopf gehoerte einst zu einer Figur. Er ist ziemlich klein und "
  "sein Sinn ist Dir noch fremd."));   

  SetProp(P_VALUE,10);
  SetProp(P_WEIGHT,200);
  SetProp(P_GENDER, MALE);
  SetProp(P_NAME,"Kopf");
  SetProp(P_MATERIAL, ({MAT_MAGIC, MAT_METAL}));
  SetProp(P_INFO, ("Irgendeinen Sinn wird der Kopf schon haben.\n"));
  
  AddId(({"kopf"}));
  SetProp(P_NOBUY, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);

}

