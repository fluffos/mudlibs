//flaschen fuer quest von dante sl 98
inherit "std/thing";
#include "files.h"
#include <food.h>
#include <properties.h>
#include <moving.h>
#include <wizlevels.h>


create()
{
if (!is_clone(this_object()))
return;

::create();


SetProp(P_SHORT, "Eine Flasche Trinkmichnie");
SetProp(P_LONG,BS(
"Dies ist eine Flasche Rosewein der Marke Trinkmichnie."));

AddId(({"flasche","fl6","wein","rosewein"})); 
SetProp(P_NOSELL, 1);
SetProp(P_SMELL, ("Die Flasche riecht nach Tod...\n"));
SetProp(P_VALUE, 0);
SetProp(P_WEIGHT, 100);
SetProp(P_SIZE, 40);
SetProp(P_GENDER, FEMALE);
SetProp(P_NEVERDROP, 1);
SetProp(P_INFO, "Du solltest diesen Wein nicht trinken!\n");

SetProp(P_MATERIAL, ({MAT_GLASS,MAT_MAGIC}));
SetProp(P_NAME, "Flasche");

AddCmd(({"trinke","trink"}), "no1");
AddCmd(({"oeffne"}), "no2");
}

 int no1(string str)
 {
  notify_fail("Was willst Du trinken?\n");
  if (!str) return 0;
   if (str=="flasche" || str=="aus flasche" || str=="wein" || str=="rosewein")
       {
       write("Du trinkst die Flasche Expectorans aus und was passiert...\n"
       "Dir wird aufeinmal schwarz vor Augen und Du krepierst elendiglich!\n");
       TP->do_damage(1000);
       SetProp(P_KILL_MSG, "Eine Flasche Trinkmichnie und Dummheit");
       
       call_out("weg", 0);
       return 1;
       }
       return 0;
   }

 int no2(string str)
 {
  notify_fail("Was willst Du oeffnen?\n");
  if (!str) return 0;
   if (str=="flasche" || str=="weinflasche" || str=="wein" || str=="rosewein")
       {
       write("Du versuchst die Flasche zu oeffnen, doch leider faellt sie "
       "auf den Boden und zerspringt in 1000 Einzelteile.\n");
       
       call_out("weg", 0);
       return 1;
       }
       return 0;
   }



       
   weg()
    {
    remove();
    }
       
 