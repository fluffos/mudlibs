//antirekswaffe
inherit "std/thing";

#include <properties.h>
#include "files.h"
#include <moving.h>



#define WIE "/d/dschungel/dante/stein/obj/wieoft"     

void create()
{

  if (!is_clone(this_object())) return;  
  ::create();
  if(!WIE->allow_anti()) return destruct(this_object());      


  SetProp(P_SHORT, "Ein kleines Monster");
  SetProp(P_LONG, 
      "Das ist natuerlich kein lebendes, kleines Monster, sondern nur eine "
      "Figur aus Elfenbein, die ein Monster darstellt.");
  AddDetail("elfenbein",
      "Ein sehr schoenes Material.");
  AddDetail("material",
      "Weiss-gelblich glaenzend.");
  WIE->create_anti();


  SetProp(P_WEIGHT, 80);
  SetProp(P_VALUE, 1000);
  SetProp(P_NAME, "Monster");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_MATERIAL, ([MAT_IVORY:90,MAT_MAGIC:10]));
  SetProp(P_MAGIC, 1);
  SetProp(P_INFO, "Diese Figur ist eine Nachbildung von Tireks. "
      "Ein guter Magier hat sie mit magischen Faehigkeiten belegt. Sie kann "
      "Dir sicher gute Dienste leisten.\n");

  AddId(({"antireks","monster", "figur", "elfenbein"}));
  AddCmd(({"wirf", "werfe"}), "wirf");
}


varargs int remove(int silent)
{
  if(is_clone(ME))
    WIE->destruct_anti();
  return ::remove(silent);
} 



int wirf(string str)
{
  string was, wer;
  object ob;
  object ti;
  int x;
  x=random(100);
  notify_fail("Was moechtest Du werfen?\n");
  if (!str)
    return 0;
  if (!sscanf(str, "%s auf %s", was, wer))
    return 0;
  if (!id(was))
    return 0;
  if (!ob=present(wer,environment(TP)))    
  {
    write("Ist doch gar nicht hier, blindes Huhn!\n");
    return 1;
  }

  if(living(ob))
  {
    if(ob->Name(WER,1) == "Tireks")

    {

      if(x==66)  {
        write(BS(
              "Die kleine Figur explodiert in Deinen Haenden! AUA!"));
        say(BS(
              "Das kleine Monster explodiert in "+TP->name(WESSEN)+" Haenden. AUA!!!"));		
        TP->AddHp(-10);
        call_out("remove", 0);
        RemoveCmd( ({ "wirf","werfe" }) );	
        return 1;  

      }	
      say("Das Monster explodiert mit Blitz und Donner auf Tireks.\n");

      write("Das Monster explodiert mit Blitz und Donner auf Tireks.\n"
          "Tireks bruellt furchtbar auf und stuerzt sich auf Dich.\n");
      ob->Defend(400+random(300), DT_MAGIC, ([SP_SHOW_DAMAGE:1]), TP);
      call_out("remove",0);
      RemoveCmd( ({ "wirf","werfe" }) );
      return 1;
    }
    else
    {   
      write("Du wirfst das Monster auf "+(ob->name(WEN))+".\n"
          ""+(ob->Name(WER))+" zuckt ueberrascht zusammen und schaut Dich dann boese an.\n");
      tell_object(ob,
          CAP_TPN+" wirft Dir ein Monster an den Kopf.\n"
          "Du zuckst ueberrascht zusammen, dann aber merkst Du, dass alles ein Spass war "
          "und grinst "+TPP(WEN)+" an.\n");
      TO->move(environment(TP), M_GO);
      return 1;
    }
    return 1;
  }
  return 0;
}

