/*
** schluesel fuer zellen stein
** 
** 10 97 dante
*/

inherit "std/thing";

#include <properties.h>
#include <rooms.h>
#include "../files.h"


create()
{
  if (!is_clone(ME)) return;
  ::create();
  SetProp (P_SHORT, "Ein alter, verrosteter Messingschluessel");
  SetProp (P_LONG, (
  "Dieser Schluessl gehoert irgendwie zu Ernas Laden."));
  SetProp (P_NAME, "Messingschluessel");
  SetProp (P_GENDER, MALE);
  SetProp (P_VALUE, 30);
  SetProp (P_WEIGHT, 100);
  SetProp (P_NOBUY, 1);
  SetProp (P_NEVERDROP, 0);
  AddId (({"messingschluessel", "schluessel"}));
  
  call_out("st1", 900);
  SetProp(P_INFO, "Der Messingschluessel fuehrt in die Zellen unter der Hoehle der Steinbeisser.\n");  
SetProp(P_MATERIAL, MAT_METAL);
}
string *QueryDoorKey()
{
return({

       ("/d/dschungel/dante/stein/room/zelle1")+":"+("/d/dschungel/dante/stein/room/zelle2"),
     ("/d/dschungel/dante/stein/room/zelle1")+":"+("/d/dschungel/dante/stein/room/zelle3"),
      ("/d/dschungel/dante/stein/room/zelle1")+":"+("/d/dschungel/dante/stein/room/zelle4"),  
      ("/d/dschungel/dante/stein/room/zelle1")+":"+("/d/dschungel/dante/stein/room/zelle6")
      });
}

st1()
{
write("Der Messingschluessel zerfaellt immer mehr.\n");
call_out("st2",600);
}

st2()
{
write("Der Messingschluessel zerfaellt bald zu Staub.\n");
call_out("st3", 600);
}

st3()
{
write("Der Messingschluessel loest sich gleich auf.\n");
call_out("st4",600);
}

st4()
{
write("Der Messingschluessel zerfaellt zu Staub.\n");
remove();
}

