
inherit "std/thing";

#include <properties.h>
#include <moving.h>
#include "files.h"
#include <wizlevels.h>


object player;
create() 
{

::create();
if (!is_clone(this_object())) return;
SetProp(P_NAME, 0);
SetProp(P_SHORT, 0);
SetProp(P_NEVERDROP, 1);
SetProp(P_NODROP, 1);
AddId (({"taub"}));
call_out("st1", 5);
SetProp(P_WEIGHT, 0);
}


  
 st1()
 
 {
 
 
 player=this_player();
 write(
       "Dein Kopf droehnt gewaltig...\n");
  say(capitalize(player->name())+" taumelt umher und haelt sich seine Ohren zu.\n");     
  TP->SetProp(P_DEAF, CAP_TPN+" hat wohl etwas zu heftig auf die Granitglocke "
  "geschlagen und ist daher leider ertaubt.\n");     
 call_out("st2",10);           
 
  }  
      
st2()
 { say(capitalize(player->name())+" sagt: Meine Ohren schmerzen so...\n");
 
 write("Du sagst: Meine Ohren schmerzen so!\n");
      call_out("st3",15); 
       }
       
 st3()
 { 
  say(capitalize(player->name())+" jammert: Ich bin taub!\n");
   write(
        "Du denkst . o O 'Diese verfluchte Glocke!'\n");
  call_out("story4", 20);
  }           
  story4()
  { 
   say(capitalize(player->name())+" greift sich mit schmerzverzertem Gesicht auf die Ohren.\n");
   write(
        "Deine Ohren tun Dir sehr weh.\n");
  call_out("story5", 20);
  }
  
  story5()
  {
  write("Langsam verklingt das Droehnen in Deinen Ohren und der Schmerz "
  "wird auch weniger, aber hoeren kannst Du noch immer nicht.\n");
   say(capitalize(player->name())+"schaut wieder etwas gluecklicher drein, "
   "bleibt aber taub.\n");
   call_out("story6", 100);
   }
 story6()
 {
 write("Du kannst wieder hoeren.");
  say(capitalize(player->name())+" erholt sich vom Droehnen der Granitglocke.");
  TP->SetProp(P_DEAF, 0);
  remove();
  }
 

