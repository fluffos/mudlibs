inherit "std/thing";

#include <properties.h>

object pl;

create()
{
  ::create();
  if (!is_clone(this_object())) return;
  SetProp (P_IDS, ({"\nbewusstlosigkeit"}));
  SetProp (P_SHORT, 0);
  SetProp (P_NAME, 0);
  SetProp (P_NEVERDROP, 1);
  SetProp (P_NODROP, 1);
  SetProp (P_WEIGHT, 0);
  call_out ("remove", 7);
  AddCmd ("", "no", 1);
  pl=0;
}

void init()
{
  ::init();
  if (!interactive(pl=environment())) pl=0;
  else catch(tell_object(pl, "Du wirst bewusstlos.\n"));
}

int remove()
{
  if (pl)
    catch(tell_object (pl, "Du erwachst wieder aus Deiner "
          +"Bewusstlosigkeit.\n"));
  return ::remove();
}

int no()
{
  write ("Aber Du bist doch bewusstlos!\n");
  return 1;
}

string extra_look()
{
  return capitalize(pl->QueryPronoun())+" ist derzeit ohne Bewusstsein.\n";
}
