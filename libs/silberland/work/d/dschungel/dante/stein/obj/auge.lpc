//   dante@SilberLand

#include "../def.h"

inherit "std/food";

#include <properties.h>
#include <language.h>
#include <food.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Ein Auge von Tireks");
  SetProp(P_LONG, BS( 
    "Vor Dir siehst Du das Auge von Tireks. Es ist so gross wie eine Melone, fuehlt "
    "sich aber hart und geschmeidig zugleich an. Der Erbeuter dieses Auges muss "
    "ein wahrer Held sein."));
    
  SetProp(P_INFO, "Das Auge von Tireks ist sehr nahrhaft!");
  SetProp(P_NAME, "Auge");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"auge", "\nauge"}) );

  SetProp(P_MATERIAL, MAT_ANIMAL );
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 3000);
  SetProp(P_NOBUY, 1);
  SetProp(P_FOOD_INFO, ([F_HEAL: 100, F_SOAK: 20, F_ALCOHOL: 0, F_POISON: 0]));
  //absichtlich soak 20...soll ja net zu gut sein
  }
  
BeimEssen()
{
write("Du wuergst das ganze Auge auf einmal hinunter, und fuehlst Dich bereit "
"zu neuen Heldentaten.\n");
say(""+TPN+" wuergt ein ganzes Auge auf einmal hinunter.\n");
return::BeimEssen();
}

