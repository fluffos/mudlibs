//ei von drehwurm kann man in spieler stecken
//erzeugt schwindel aber kein damage

#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Ein Drehwurmei");
  SetProp(P_LONG, BS( 
   "Das ist das Ei eines Drehwurms. Es ist klein, grau und voellig "
   "unscheinbar. Vielleicht kann man ja damit etwas machen..."));    
    SetProp(P_INFO, "Dieses Ei kann man anderen Spielern in den Mund stopfen.\n"
    "<stopfe ei in mund von name>\n");
    
  SetProp(P_NAME, "Drehwurmei");
  SetProp(P_GENDER, NEUTER);
  AddId(({"ei","drehwurmei"}));
  SetProp(P_MATERIAL, ({ MAT_ANIMAL, MAT_HORN}) );
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 100);
  SetProp(P_NOBUY, 1);
  
  AddCmd(({"stopfe","stopf"}), "put");
}

put(string str)
{
  object get;
  string vic;
  object ob;
  notify_fail("Was willst Du wem wohinein stopfen?!\n");
  if (!str) return 0;
      
    if(sscanf(str, "ei in mund von %s", vic))
      {
      if(!ob=present(vic,environment(TP)))
        {
        write(CAP(vic)+" ist doch nicht hier!\n");
        return 1;
        }
      if (!interactive(ob))
        {
        write("Nein! Das geht leider nicht!\n");
        return 1;
        }
      if(present("turn", ob))         
        {
        write("Nein! "+(capitalize(vic))+" hat schon den Drehwurm!\n");
        return 1;
        }
      else
        {
        get=clone_object("/d/dschungel/dante/stein/obj/turn");
        get->move(ob, M_NOCHECK);
           
        write("Du steckst das Drehwurm ein in den Mund von "
             +(capitalize(vic))+"!\n"+(capitalize(vic))+" wuergt und schaut "
             +"dann verbluefft!\n");
        tell_object(ob,
        "Irgendein Boesewicht steckt Dir ein Drehwurmei in den Mund.\n");
        TO->remove();
        return 1;
        }
      return 0;
      }
    return 0;
}
