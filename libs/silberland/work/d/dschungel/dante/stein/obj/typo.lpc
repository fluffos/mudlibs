//ein bug fuer dem MM

inherit "std/thing"; 
#include <language.h>
#include <properties.h>
#include <combat.h>
#include <defines.h>
#include <moving.h>
#include "files.h"

create()

{ if(!is_clone(this_object())) return;
  thing::create();
  SetProp(P_SHORT,"Ein doofer Typo");
  SetProp(P_LONG,BS(
  "Das ist ein ziemlich dummer Typo. So einer von der Art 'wircklich'")); 
  SetProp(P_VALUE,0);
  SetProp(P_WEIGHT,10);
  SetProp(P_GENDER, MALE);
  SetProp(P_NAME,"Typo");
  SetProp(P_MATERIAL, ({MAT_MAGIC}));
  SetProp(P_INFO, ("Der Dipo ist fals gesripen! \n"));
  
  AddId(({"typo"}));
  SetProp(P_NOBUY, 0);
  SetProp(P_NOSELL, 0);

}

