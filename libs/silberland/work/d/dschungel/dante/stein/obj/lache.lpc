//Aenderungen
//
//23/02/98 Thor: - Das Spiegelbild kann pro Spieler nur 1 x pro Reset
//                 geholt werden. Ansonsten koennte man hier nonstop
//                 Spells ueben.
//war zu stark ..etwas geschaecht dante hmmmm 
inherit "/std/thing";
//warnung eingebaut 16.4.98 dante
#include "../def.h"

string *players;

void create() {
  if (!is_clone(this_object()))
    return;
  ::create();
  SetProp(P_SHORT,"Eine seltsame Wasserpfuetze");
  SetProp(P_LONG,BS("Die Wasserpfuetze erscheint Dir aeusserst merkwuerdig. "
  "Sie glitzert und funkelt unheimlich und Du glaubst sogar Dein Spiegelbild "
  "zu erkennen. Irgendwie ist Dir das hier nicht ganz geheuer. Du solltest "
  "vorsichtig sein, man weiss ja nie wovor man vielleicht fluechten muss..."));
  SetProp(P_NOGET,1);
  SetProp(P_NAME,"Wasserpfuetze");
  SetProp(P_GENDER,FEMALE);
  SetProp(P_INFO,"Diese Wasserpfuetze birgt ein Geheimniss.\n");
  SetProp(P_VALUE,0);
  SetProp(P_MATERIAL,([MAT_WATER:80,
    MAT_MISC_MAGIC:20]));
  SetProp(P_WEIGHT,100);
  AddId( ({"pfuetze", "wasserpfuetze", "lache"}) );
  AddSpecialDetail(({"spiegelbild","bild"}), "attack");
  
  players=({});
  
}

void reset()
{
  ::reset();
  players=({});
}

string attack()
{
  object npc;
  string s,sh;
  int i;
  if(TP->QueryProp(P_GHOST)) return "Geister haben doch kein Spiegelbild...\n";
  if(present("spiegelbild",environment(TP)) ||
     (member_array(getuid(TP), players)!=-1) )
    return "Seltsam, aber Du kannst kein Spiegelbild erkennen.\n";

  players+=({getuid(TP)});
  s=TP->short();
  i=strlen(s)-3;
  sh=s[0..i];
  write("Oh oh, was passiert nun mit Dir...\n");
  npc=clone_object("/d/dschungel/dante/stein/npc/eben");
  npc->SetOwner(getuid(TP));
  npc->SetProp(P_SHORT, TP->QueryProp(P_SHORT));
  npc->SetProp(P_NAME, TP->QueryProp(P_NAME));
  npc->SetProp(P_GENDER, TP->QueryProp(P_GENDER));
  npc->SetProp(P_ARTICLE, 0);
  npc->SetProp(P_MSGIN, TP->QueryProp(P_MSGIN));
  npc->SetProp(P_MSGOUT, TP->QueryProp(P_MSGOUT));
//  npc->SetProperties(TP->QueryProperties());
  npc->SetProp(P_ATTRIBUTES,TP->QueryProp(P_ATTRIBUTES));
  npc->SetProp(P_BODY,10+TP->QueryProp(P_TOTAL_AC));
  npc->SetProp(P_ATTRIBUTES, ([A_INT:30, A_DEX:30, A_STR:30, A_CON:30]) );
  npc->SetProp( P_RESISTANCE_STRENGTHS,
               ([DT_MAGIC: 1.0, DT_FIRE: 1.0, DT_WATER:-1.0,DT_BLUDGEON:-1.0, DT_WHIP:1.0]));
  npc->SetProp(P_SHORT,sh);
  npc->SetProp(P_LONG,TP->long());
  npc->SetProp(P_MAX_HP, TP->QueryProp(P_MAX_HP)*2); 
  npc->AddId(({"spiegelbild", "bild"}));
  
  npc->SetProp(P_INFO, "Das ist nur ein Spiegelbild von "+TPN+"\n");
  npc->set_living_name("spiegelbild");
  npc->move(environment(ME),M_NOCHECK);
  TP->AddPursuer(npc);
  return "In dieser Wasserpfuetze wurde vor langer Zeit ein boeser Geist verbannt, "
  "der jede Gestalt annehmen kann.\n";
}

