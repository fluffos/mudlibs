//antimalariaserum

#include "../def.h"
inherit "std/thing";
#include <properties.h>
#include <language.h>
int dosis;

create()
{
  if (!is_clone(TO) )  return;

  ::create();

 dosis =3;

  SetProp(P_SHORT, "Die Larve eines Augenfressers ( Anwendungen: "+dosis+" )");
  SetProp(P_LONG, BS(
  "Das ist die Larve eines Augenfressers. Dieser Kaefer kommt nur in "
  "ganz bestimmten Regionen des Dschungels vor. Sie enthaelt Stoffe, "
  "die angeblich gegen Malaria helfen. Solltest Du allerdings keine "
  "Malaria haben, verwende sie lieber nicht. Du kannst sie mit "
  "< reibe larve in auge > verwenden. Dir ekelt bei dieser Vorstellung.")); 
    SetProp(P_INFO, "Diese Larve kann sehr hilfreich sein!\n");
  SetProp(P_NAME, "Larve");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_NOSELL, 1);
  SetProp(P_MATERIAL, ({ MAT_HORN, MAT_PLASTIC, MAT_ANIMAL}) );
  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 1000);
  SetProp(P_NOBUY, 1);
  AddId(({"larve","augenfresser"}));
 AddCmd(({"reibe","reib"}), "heal");
}
   
   heal(string str)
   {
   object m;
   notify_fail("Was willst Du hier wo reiben?\n");
   if (!str) return 0;
   
       if (member(({"larve in auge","larve in augen"}),str)!=-1)
           {
           if ((!dosis) && (present("MALA", TP)))
              {
              write("Du reibst die Larve in Deinem Auge hin und her. Aber nichts passiert.\n");
              return 1;
              }
              
              if( (dosis) && (present("MALA", TP)))
              
              {
                 write("Du reibst die Larve in Deinem Auge hin und her und fuehlst Dich erleichtert.\n");
                 dosis--;
                 SetProp(P_SHORT, "Die Larve eines Augenfressers ( Anwendungen: "+dosis+" )");
                 m=present("MALA", TP);
                 m->remove(1);
                 
                 return 1;
               }
               
            if( (dosis) && (!present("MALA", TP)))
            {
            
            write("Du reibst die Larve in Deinem Auge hin und her, obwohl Du keine Malaria hast.\n");
            TP->AddPoison(3);
            dosis--;
            
           SetProp(P_SHORT, "Die Larve eines Augenfressers ( Anwendungen: "+dosis+" )");
            return 1;
            }
                           
                if ((!dosis) && (!present("MALA", TP)))
             {
      write("Du hast keine Malaria und die Larve keine Inhaltsstoffe mehr!\n");
             
             return 1;
             }
           return 0;
           }   
       
       return 0;
       }
             
                  
