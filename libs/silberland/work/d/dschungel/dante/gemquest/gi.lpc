int buy(string str)  {

  object ob;
  int zi, tu, dia, to, sma, kr;
  int wert, preis;


  NF("Gihr sagt: Was willst Du mir verkaufen?!\n");

  if (!str) return 0;              


  ob=present(str, TP);

  // ARGL DANTE
  // Man kann nicht blind annehmen, dass ein Objekt eine Unit ist!!!
  // Also vorher pruefen!!!!!!!!! sonst geht das AddAmount(-1) gar nicht,
  // und man kriegt TROTZDEM das Geld...
  // Quickfix - Woody, 8.11.2000

  /*
     Lieber Woody das was Du da gebaut hast bugt leider auch :-))
     wenn du schon mich anoergelst dann machs bitte besser und denk nicht immer
     ich sei ein depp ok????:-))
     danke

*/

  /*
     Tja es war eben ein Quickfix, wie geschrieben, und ein Bug auf -Debug
     ist bei weitem unkritischer als eine endlose Geldquelle. Oder? Normal
     haettest ja ne Mail gekriegt, aber nachdem das ja ausgenutzt werden
     konnte, musste es sofort ge(quick!)fixt werden... insofern war es eh
     besser gemacht, aber ich lass Dir halt Spielraum :)
     Ausserdem bist Du kein Depp. Nur manchmal etwas nachlaessig ;)
     -Woody-
     */

  /*

     der bug ist von woody eingebaut. wenn da steht
     ob=presnet(str,TP); und dann if (!ob->IsUnit, kann
     trotzdem ob=0 sein und dann geht das ob->name(WER,1) u.a
     gar nicht...

*/

  /*
     Ja, dann buggts, aber dann sieht man das auch sofort, und der Spieler
     bekommt nicht still und heimlich endlos Geld =)  Make your choice...
     */

  if(!ob)  {
    write(BSA(
          "Aber "+TPN+", Du hast doch "+CAP(str)+" gar nicht!",
          "Gihr sagt: "));
    return 1; 
  }



  if(!ob->IsUnit())  {
    write(BSA(
          "Nein! Das will ich nicht kaufen! "
          "Das gefaellt mir nicht!",
          "Gihr sagt: "));
    return 1; 
  }


  /*
     if (!ob->IsUnit()) {
     write(BSA("Nein, "+(ob->name(WER,1))+
     (ob->IsPlural() ? " gefallen" : " gefaellt")+
     " mir irgendwie nicht, den kauf ich nicht.",
     "Gihr sagt: "));
     return 1;
     }
     */

  // End of Quickfix
  // P.S. bitte lern einruecken, sonst ist das debuggen eine Qual
  //p.s.: bitte lern debuggen, sonst ist das dedebuggen eine qual:-) 

  if(str=="stein"||str=="steine")  {
    write(BSA(
          "Ich kaufe nur Edelsteine, Perlen und Bergkristalle!",
          "Gihr sagt leise: "));
    return 1; 
  }


  if(str=="perle")  {

    if(!ob || file_name(ob)[0..11]!="/obj/pearls/")  {
      write(BSA(
            "Aber Du hast gar keine Perle, vielleicht hast Du ja eine "
            "irgendwo eingesteckt?!",
            "Gihr sagt leise: "));
      return 1; 
    }

    if(ob)  {

      wert=ob->QueryProp(P_VALUE);   

      preis=wert+100;

      write(BSA(
            "Ok, "+TPN+" das Geschaeft ist fixiert. Ich gebe Dir dafuer "+preis+" "
            "Muenzen!", "Gihr sagt leise: "));
      write("Gihr wirft das Geld vor Deine Fuesse und Du gibst ihm "+ob->name(WEN)+"!\n"
          "Dann sperrt er "+ob->name(WEN)+" schnell in einen Schrank!\n");

      cash=clone_object("obj/money");
      cash->SetProp(P_AMOUNT, preis);
      cash->move(environment(TP), M_NOCHECK);

      //TP->AddMoney(preis);
      ob->AddAmount(-1);
      return 1; 
    }
    return 0;
  }     


  if(str=="bergkristall"||str=="kristall")  {

    if(!present("bergkristall", TP) )  {
      write(BSA(
            "Aber Du hast gar keinen Bergkristall, vielleicht hast Du ja einen "
            "irgendwo eingesteckt?!",
            "Gihr sagt leise: "));
      return 1; 
    }

    if(ob)  {

      wert=ob->QueryProp(P_VALUE);   

      preis=wert+200+random(BONUS);

      write(BSA(
            "Ok, "+TPN+" das Geschaeft ist fixiert. Ich gebe Dir dafuer "+preis+" "
            "Muenzen!", "Gihr sagt leise: "));
      write("Gihr wirft das Geld vor Deine Fuesse und Du gibst ihm "+ob->name(WEN)+"!\n"
          "Dann sperrt er "+ob->name(WEN)+" schnell in einen Schrank!\n");
      //TP->AddMoney(preis);
      cash=clone_object("obj/money");
      cash->SetProp(P_AMOUNT, preis);
      cash->move(environment(TP), M_NOCHECK);



      ob->AddAmount(-1);
      return 1; 
    }
    return 0;
  }     











  if(str=="edelstein"||str=="edelsteine")  {

    if(!present("edelstein", TP))  {
      write(BSA(
            "Aber Du hast gar keinen Edelstein, vielleicht hast Du ja einen "
            "irgendwo eingesteckt?!",
            "Gihr sagt leise: "));
      return 1; 
    }

    if(present("edelstein", TP))  { 
      write(BSA(
            "Welchen Edelstein willst Du mir verkaufen?! Genau bitte!",
            "Gihr sagt leise: "));
      return 1; 
    }

    return 0;  
  }

  if(!ob)  {
    write(BSA(
          "Aber "+TPN+", Du hast "+capitalize(str)+" doch gar nicht!",
          "Gihr sagt leise: "));
    return 1; 
  }


  if(ob)  {


    if(!ob->id("edelstein"))  {             
      write(BSA(
            CAP_TPN+", ist "+capitalize(str)+" etwa ein Edelstein?!",
            "Gihr sagt grantig: "));
      return 1; 
    }



    if(ob->id("edelstein"))  {

      wert=ob->QueryProp(P_VALUE);


      write("Gihr schaut sich "+ob->name(WEN)+" mit einer Lupe genau an.\n\n");


      if(file_name(ob)[0..9]=="/obj/gems/")  {


        preis=wert+100+random(BONUS);

        write(BSA(
              "Ok, "+TPN+" das Geschaeft ist fixiert. Ich gebe Dir dafuer "+preis+" "
              "Muenzen!", "Gihr sagt leise: "));
        write("Gihr wirft das Geld vor Deine Fuesse und Du gibst ihm "+ob->name(WEN)+"!\n"
            "Dann sperrt er "+ob->name(WEN)+" schnell in einen Schrank!\n");
        //TP->AddMoney(preis);
        cash=clone_object("obj/money");
        cash->SetProp(P_AMOUNT, preis);
        cash->move(environment(TP), M_NOCHECK);

        ob->AddAmount(-1);
        return 1; 
      }


      return 0; 
    }
    return 0; 
  }
  return 0; 
}




Defend(int dam, string dtype, mixed spell, object enemy)
{

  if(!interactive(enemy))

  {

    return ::Defend(0, dtype, spell, enemy); 

  }	



  if(deep_present("GEM_HAMMER", enemy))  {
    write(BS(
          "Gihr sagt: Wozu noch ein Hammer?! STOP!!!"));
    StopHuntingMode();
    enemy->StopHuntingMode();
    return ;
  }


  if(enemy->QueryQuest(QUESTKEY)) {

    //  TP muss nicht zwingend enemy sein!! 
    return ::Defend(dam, dtype, spell, enemy); }




  if(!deep_present("DANTE_GEM_ALLE", enemy))
  {
    write(BS(
          "Gihr bruellt: He! Was soll das! Ich bin Geschaeftsmann!!!"));
    StopHuntingMode();
    enemy->StopHuntingMode();
    heal_self(dam);
    return ;
  }

  if(deep_present("DANTE_GEM", enemy))   {
    write(BS(
          "Gihr bruellt: He! Wir haben einen Vertrag! Du arbeitest fuer mich!"));

    StopHuntingMode();
    enemy->StopHuntingMode();
    heal_self(dam);
    return ;

  }
  else   {
    return ::Defend(dam, dtype, spell, enemy); }}


    die(arg)   {
      object ob, questob;
      questob=deep_present("DANTE_GEM_ALLE", TP);
      if(!interactive(TP))  {
        return;  
      }



      if((questob) || 
          (TP->QueryQuest(QUESTKEY)) ||
          (!deep_present("GEM_HAMMER", TP )) ) {
        write(BSA(
              "Halt! Stop! Ich gebe auf! Du hast gewonnen! Aber ich kann "
              "Dir nicht soviel Geld zahlen! Ich habe gelogen! Hier bitte "
              "nimm diesen magischen Hammer! Ich hoffe, Du bist mir nicht "
              "mehr boese! Bitte!", "Gihr fleht: "));
        heal_self(500);
        ob=clone_object("/d/dschungel/dante/gemquest/gemhammer");
        ob->move(TP, M_NOCHECK);
        ob->SetProp(P_SHORT, "Der Edelsteinhammer von "+CAP(getuid(PL))+"");

        if(questob)  {
          questob->remove();
        }

        if(!TP->QueryQuest(QUESTKEY))  {
          switch (TP->GiveQuest(QUESTKEY)) {
            case 1:  write_file("/log/quests/gemquest",
                         dtime(time())+": "+CAP(getuid(TP))+" loest die Quest.\n");
                     break;
            default: write_file("/log/quests/gemquest",
                         dtime(time())+": Fehler bei "+CAP(getuid(TP))+"!\n");
          }
        }



        return ;	}
      else    {
        write(BS(
              "Gihr sagt: Nix da!"));
        heal_self(500);
        return ;   
      }   
    }


string make_zutaten(string gem)
{
  return "Ein "+capitalize(gem[0..<3]);
}


string *ZutatenAuswahl()
{
  string *alle_zutaten;
  string *ret;
  int i, rand;

  alle_zutaten=(get_dir("/obj/gems/*.lpc"));
  alle_zutaten=map_array( alle_zutaten, "make_zutaten" );

  ret = ({});
  //erweitert auf die neuen 33 gems statt 15!! dante 2001 14.01  
  // perle weg -> 32 gems feyaria 
  // Peridot und Okatrin dazu
  // Edelsteinliste dynamisch generieren (feyaria)

  for (i=0; i < NEEDED_GEMS; i++)
  {
    rand=random(sizeof(alle_zutaten));
    ret += ({ alle_zutaten[rand] });
    alle_zutaten -= ({ alle_zutaten[rand] });
  }
  return ret;
}


string ver(string str)   {

  if(TP->QueryQuest(QUESTKEY))   {
    write(BSA(
          "Aber wir beide hatten ja schon einmal einen! "
          "Hast Du das vergessen!", "Gihr sagt: "));
    return ""; 
  }

  if(present("DANTE_GEM_ALLE", TP))   {
    write(BSA(
          "Du Trottel! Na wo ist denn Dein Vertrag?! Haettest "
          "besser auf ihn aufpassen sollen!!! Hau ab!",
          "Gihr lacht Dich aus: "));  return ""; 
  }
  if(present("DANTE_GEM", TP) )   {
    write(BSA(
          "Na, da ist er doch! Bring mir die Edelsteine und Du "
          "wirst reich belohnt!", "Gihr sagt: "));
    return "";   
  }
  else   {
    write(BSA(
          "Naja, frag mich mal nach Geschaeft?!",
          "Gihr sagt: "));   return "";   
  } 
}



string questanfang(string str)
{
  object liste;
  string *zutaten;
  if(TP->QueryQuest(QUESTKEY))  {
    write(BSA(
          "Eh, "+TPN+", wenn Du noch einen Hammer haben willst, "
          "musst Du mich nur toeten, also los Feigling!",
          "Gihr sagt: "));
    return ""; 
  }


  if(deep_present("DANTE_GEM_ALLE", TP))  
  {
    return 
      "Aber "+TPN+", willst Du noch einmal so bloed sein! " +
      "Hau lieber ab, Du &/%$%&%!!!";  
  }


  if(deep_present("DANTE_GEM", TP))
  {
    return 
      "Aber wir haben doch schon ein Geschaeft vereinbart! " +
      "Suche und bring mir lieber Edelsteine!";
  }


  liste=clone_object("/d/dschungel/dante/gemquest/ve");
  liste->move(TP, M_NOCHECK);
  liste->SetZutaten(ZutatenAuswahl());

  /*
     if(!(TP->QueryQuest(QUESTKEY)))
     write_file("/d/dschungel/dante/gemquest/log/questbegin", 
     dtime(time())+": "+TP->Name()+" beginnt die Quest.\n" );
     */

  write(BSA(
        "Also, wir vereinbaren nun ein Geschaeft! Du bringst mir von " 
        "jeder Edelsteinart die es im Silberland gibt ein Exemplar. " 
        "Du kannst sie mir auch einzeln geben, ich merke mir das, denn " 
        "als guter Geschaeftsmann fuehre ich genauestens Buch! Wenn Du " 
        "mir alle gebracht hast, werden wir dann einen Preis " 
        "pro Stueck ausmachen. Ich bin als grosszuegiger " 
        "Geschaeftsmann bekannt und Ich denke da an, hmm, 25000 Muenzen " 
        "pro Edelstein! Aber darueber reden wir dann noch! " 
        "Hier ist ein Vertrag, unterschreibe ihn!\n" 

        "Also los, mach Dich auf die Suche nach Edelsteinen!",
        "Gihr sagt: ")); 

  write(BS("Du unterschreibst den Vertrag!"));
  tell_room(environment(TO),
      CAP_TPN+" unterschreibt mit Gihr einen Vertrag!\n", ({TP}));  
  return "";
}


give_notify(object ob)
{
  object liste;
  string ob_short;

  if(objectp(liste=present("DANTE_GEM", TP)) && 
      member(liste->QueryZutaten(), ob_short=ob->QueryProp(P_SHORT)) > -1)
  {
    if(liste->QueryZutatErledigt(ob_short))
    {
      write(BSA(
            "Aber "+TPN+", "+ob->name(WEN)+" hast Du mir doch schon gegeben! "
            "Trotzdem danke!!!",
            "Gihr Heuchlox sagt: "));
      //absichtlich kein remove!!!

      tell_room(environment(TO),(BS(
              "Gihr Heuchlos steckt "+ob->name(WEN)+" ein und freut sich!\n")));
    }
    else
    {

      say(BSA(
            "Danke "+TPN+", "+ob->name(WER)+" hat noch gefehlt!",

            "Gihr Heuchlox sagt: "));
      liste->SetZutatErledigt(ob_short);
      ob->remove();

      if(liste->QueryErledigt())
      {
        write(BSA(
              "Gut gemacht "+TPN+", Du hast mir nun alle Edelsteine gebracht! "
              "Danke sehr! Und nun verlass bitte meinen Laden, ich hab noch "
              "viel zu tun! Ich muss leider den Laden schliessen, weil ich "
              "fuer lange Zeit verreise! Machs gut!",
              "Gihr Heuchlox sagt eilig: "));
        write(BS(
              "Dann nimmt Gihr Dir Deinen Vertrag schnell weg und zerreisst ihn einfach! So eine "
              "Frechheit! Glatter Betrug!!! Rache!!!"));

        tell_room(environment(TO),
            "Gihr sagt: Danke "+TPN+", dass Du mir alle Steine gebracht hast!\n"
            "Und nun verlasse den Laden! Auf Wiedersehen! Hau ab!\n"
            "Dann nimmt Gihr "+TPN+" den Vertrag weg und zerreist ihn einfach!!!\n", ({TP}));

        liste->AddId("DANTE_GEM_ALLE");
        liste->SetProp(P_SHORT, 0);
        liste->RemoveId("vertrag");
        liste->SetProp(P_NAME, 0);
        liste->SetProp(P_LONG, 0);
        liste->RemoveId("DANTE_GEM");//!!!!!!

      }
    }
  }

  else
  {
    say("Gihr Heuchlox sagt: Was soll ich damit,"+TPN+"!!?\n");
    ob->remove();
    write("Gihr Heuchlox wirft etwas in den Muell!\n");
  }
}
