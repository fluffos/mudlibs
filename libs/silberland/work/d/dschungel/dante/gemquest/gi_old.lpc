//questnpc by dante
//dank an stahl auf dessen npc teile meines npcs basieren...

inherit "std/npc";
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include "/players/dante/myowndefine.h"
#include <new_skills.h>
#define NEEDED_GEMS 15 //15 sind gleich alle
#define QUESTKEY "Im Edelsteingeschaeft"

string questanfang(string str);
string ver(string str);
#define BONUS 200



init(){
::init();
if(interactive(TP))  {
call_out("hallo", 0); }}

hallo() {
if(environment(TO)!=environment(TP)) return ;
 
if(present("DANTE_GEM_ALLE", TP)) {
	write(BSA(	
CAP_TPN+", Du Idiot! Was willst Du denn hier hau ab!",
"Gihr Heuchlox sagt grinsend: "));
 return ; }
 
if(present("DANTE_GEM", TP)) {
	write(BSA(
	"Hallo "+TPN+", mein Lieblingskunde! Hast Du Edelsteine fuer mich?!",
	"Gihr Heuchlox heuchelt: ")); 
	
	  return ;  }

 if(TP->QueryQuest(QUESTKEY))  {
 	write(BSA(
  CAP_TPN+", Du verfluchtes &%&%$§$!!! Verschwinde! Los hau ab!",
  "Gihr Heuchlox flucht laut: "));  return ;  }
  		 
else  {
  write(BSA(
  "Hallo, "+TPN+", was kann ich fuer Sie tun, wehrter Kunde!",
  "Gihr Heuchlox sagt schleimig: "));  return ; }}
  	



void create()
{
 
  if (!is_clone(TO)) return;
  ::create();
  create_default_npc(16);
  SetProp(P_SHORT, "Gihr Heuchlox");
  SetProp(P_LONG, BS(
  "Das ist Gihr Heuchlox, ein undurchsichtiger Zwerg, der sich "
  "hier, weit ab von seiner Heimat, niedergelassen hat. Er "
  "betreibt Geschaefte mit Edelsteinen und es gibt das Geruecht, "
  "das er unserioes sei. Aus listigen, kleinen Augen blickt er "
  "Dich an, und Du glaubst fast die pure Gier nach Edelsteinen "
  "und Geld darin zu erkennen. Du kannst ihm mit <verkaufe> auch "
  "Edelsteine verkaufen."));
  
  AD(({"auge","augen"}),
  "Sie leuchten direkt wie Edelsteine...");
   
  SP(P_INFO, "Frag Gihr doch einfach nach Geschaeft!");
  SetProp(P_NAME, "Gihr Heuchlox");
  SetProp(P_GENDER, MALE);
  AddId( ({"zwerg", "gihr", "heuchlox", "gihr heuchlox"}));
  SetProp(P_RACE, "Zwerg");
  SetProp(P_SIZE, 120);
  SetProp(P_ALIGN, -100);
  
  SetProp(P_MAX_HANDS, 2);
  SP(P_ARTICLE, 0);
  SP(P_BODY, 50);
  
  
  
 SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:20, T_RANGE_MAX: 40]));

SetProp(P_HANDS, ({" mit seinen starken Armen",180,({DT_BLUDGEON})}));

 AI(({"verkauf","kauf"}),
 "Ich kaufe und verkaufe Edelsteine. Ich zahle gut! "
 "Ich zahle Dir je nach Edelstein verschieden!" , "sagt: ");



AI("preis",
"Ich zahle um einiges besser als die normalen Haendler!", "sagt: ");

 
SetProp(P_HEAL, 0);
SetProp(P_AGGRESSIVE, 0);
SetProp(P_WIMPY, 0);
SetProp(P_NOMAGIC,3);
SetProp(P_NOCORPSE, 0);
SetProp(P_MSGIN, "kommt gierig nach Edelsteinen herein");
SetProp(P_MSGOUT, "geht gierig");
SetProp(P_MMSGIN, "kommt voller Gier herein");
SetProp(P_MMSGOUT, "geht gierig davon");
/*
SetProp(P_MURDER_MSG, "");
SetProp(P_KILL_NAME, "Ein Blitzdaemon");
SetProp(P_KILL_MSG, "Ihr elenden Sterblichen, Eure Tage sind gezaehlt! "
"Ich vernichte Euch alle mit meinen Blitzen!!!");
SetProp(P_MSG_FLAGS, ([P_KILL_MSG:1, P_MURDER_MSG:1 ]));
*/



SetProp(P_SPELLRATE,60);


AddSpell(4,200,
 "Gihr Heuchlox greift Dich mit purer Gier an!\n",
 "Gihr Heuchlox greift @WEN mit purer Gihr an!\n",
DT_TERROR, ([SP_SHOW_DAMAGE:1]));

AddSpell(2, 300,
"Gihr Heuchlox schleudert einen Stein nach Dir!\n",
"Gihr Heuchlox schleudert einen Stein nach @WEM!\n",
DT_BLUDGEON, ([SP_SHOW_DAMAGE: 1]));

AddSpell(1, 400,
"Gihr Heuchlox pruegelt irr vor Gier auf Dich ein!\n",
"Gihr Heuchlox pruegelt irr vor Gier auf @WEN ein!\n",
DT_BLUDGEON, ([SP_SHOW_DAMAGE: 1]));

SetChats(10,({
"Gihr Heuchlox sagt: Ich liebe alle Edelsteine!\n",
"Gihr Heuchlox sagt: Diamanten!!! Ich verehre sie!\n",
"Gihr Heuchlox zaehlt seine Edelsteine!\n",
"Gihr Heuchlox ueberprueft seine Edelsteine!\n",
"Gihr Heuchlox poliert einen Opal!\n",
"Gihr Heuchlox sagt: Hast Du Turmaline?!\n",
"Gihr Heuchlox sagt: Bring mir einen Rubin!\n",
"Gihr Heuchlox sagt: Edelsteine sind mein Leben!\n",
"Gihr Heuchlox sagt: Ich bin serioes!\n",
"Gihr Heuchlox sagt: Wollen wir ein Geschaeft machen?!\n",
"Gihr Heuchlox sagt: Du kannst mir vertrauen!\n"}));

SetAttackChats(10,({
"Gihr Heuchlox sagt: Du mieser Raeuber!\n",
"Gihr Heuchlox sagt: Hilfe!\n",
"Gihr Heuchlox schreit: Ueberfall!!!\n",
"Gihr Heuchlox sagt: Du Verbrecher!\n",
"Gihr Heuchlox sagt: Hau ab!\n"}));




AI(({"gihr", "heuchlox","gihr heuchlox"}),
"Das bin ich, wer sonst?!", "sagt: ");
AI("zwerg",
"ich bin ein Zwerg!", "sagt: ");
AI("gier",
"He! Ich bin nicht gierig!", "luegt: ");
AI("geld",
"Ach ich speende alles!", "luegt: ");
AI(({"edelstein","edelsteine"}),
"Im ganzen Silberland gibt es viele verschiedene davon! Ich "
"liebe sie alle und handle damit! Nur muss ich hier bleiben "
"und meinen Laden hueten und kann sie so nicht selbst suchen. "
"Die Edelsteine sind ja meistens an schwer zu findenden Orten "
"oder werden von boesen Wesen bewacht. "
"Aber einem Geschaeft bin ich nie abgeneigt!", "sagt: ");
AI("silberland",
"Na, hier leben wir alle?!", "sagt: ");
