AI(({"dschungelphantom", "phantom"}),
"Das Dschungelphantom treibt sich gerne bei einem Tuempel "
"herum. Es zaubert sich aber im ganzen Dschungel umher, und so "
"ist es schwer es zu finden.", "sagt: ");
AI("tuempel",
"Im Sueden der Stadt ist ein Weg, folge dem einfach...", "sagt: ");
AI(({"weg", "sueden"}),
"Geh den Weg nach Sueden!", "sagt: ");

AI("zirkon",
"Zirkone sind angeblich irgendwie elektrisch. Sie sind braun.",
"sagt: ");
AI("turmalin",
"Turmaline sind unheimliche, gruenschwarze Steine, die oft "
"bei boesem Zauber eingesetzt werden!", "sagt: ");

AI("topas",
"Der Topas ist ein sonnengelber Stein, der irgendwie luftig ist.",
"sagt: ");
AI("smaragd",
"Er ist giftgruen, kann heilen aber auch giftig sein.", "sagt: ");
AI("saphir",
"Der saphir ist eisblau und glitzert. Er hat eine enge Beziehung "
"zu Eis, was immer das heisst.", "sagt: ");
AI("rubin",
"Der Rubin ist feuerrot und liebt das Feuer!", "sagt: ");
AI("perle",
"Nein, Perle will ich keine?! Ist das etwa ein Edelstein?! Ich "
