//raum fuer gihr heuchlox in tijara
//dante sl 99
#include "/players/dante/myowndefine.h"
inherit "std/room";
#include <wizlevels.h>      
#include <properties.h>
#include <language.h>
#include <moving.h>
#include <new_skills.h>
#include <player.h>

int get=1;
int rand=random(3000)+3000;

string wer;

#define STR 20

init()  {
  ::init();
  if(IS_ARCH(TP))  { write(BS(
        "Hallo lieber Erzmagier! Ich hoffe, das Du diese Tafel nicht allzu "
        "ernst nimmst. Solltest Du damit ein Problem haben, bist Du zwar "
        "humorlos, darfst Dich aber bei mir, praepotentem Arsch gerne melden! "
        "Mit der Bitte um Verstaendniss, danke Dein liebster Dante!"));  
  }
}


create()
{
  ::create();

  wer="";

  SetProp( P_INT_SHORT, "Im Edelsteinladen von Gihr Heuchlox");

  SetProp( P_INT_LONG, BS(
        "Das ist der Edelsteinladen von Gihr Heuchlox. Hier werden "
        "Edelsteine aller Art gekauft, verkauft und getauscht. Die "
        "Waende sind voll mit dicken, stabilen Schraenken, in denen "
        "Gihr die Edelsteine lagert. Ein fetter Panzerschrank "
        "steht in einer Ecke, gut gesichert durch 12 Schloesser. "
        "Gihr steht meistens hinter dem Tresen, von wo aus er seine "
        "Geschaefte erledigt. "
        "Im Norden fuehrt eine Tuere wieder auf "
        "die Strassen von Tijara hinaus.")+
      "Eine grosse Tafel.\n"
      "Ein grosses Schild.\n");


  AD("himmel",
      "Nicht hier.");

  AD("tafel",
      "Bitte lesen.");
  ARD("tafel",
      "\n"

      "+_________________________________________________________________+\n"
      "|                                                                 |\n"
      "|          Guten Tag, verehrte Kundinnen und Kunden!              |\n"
      "|                                                                 |\n"
      "|  Bitte nehmen sie zur Kenntniss, das hier auf Serioesitaet      |\n"
      "|  und Ehrlichkeit beim Geschaeft hoechster Wert gelegt wird!     |\n"
      "|  Der ehrliche Gihr Heuchlox garantiert fuer hoechste Qualitaet  |\n"
      "|  zu fast geschenkten Preisen! Unsere Gewinne spenden wir        |\n"
      "|  einem Fond fuer altersschwache, senile und inkontinente        |\n"
      "|  Erzmagier, die es in dieser Welt ja leider nur all zu oft      |\n"
      "|  gibt. In diesem Sinne hoffen wir auf gute Geschaefte fuer      |\n"
      "|  uns und unsere Kunden, denn das Glueck und die Zufriedenheit   |\n"
      "|  unserer Kunden ist unser Ziel und unsere Pflicht! Und haben    |\n"
      "|  Sie bitte Mitleid mit Erzmagiern und anderen armen, vom        |\n"
      "|  Schicksal schwer gestraften Kreaturen dieser Welt!             |\n"
      "|                                                                 |\n"
      "|                                Ihr Gihr Heuchlox i.V. Dante     |\n"
      "|                                                                 |\n" 
      "|            ES LEBE DIE FREIE REPUBLIK DSCHUNGEL !!!             |\n"
    "+_________________________________________________________________+\n");






  AD(({"geschaeft","geschaefte"}),
      "Gihr macht gerne solche.");
  AD("norden",
      "--->Tuere.");

  AD("tresen",
      "Der Tresen ist aus massivem Holz. Dahinter arbeitet Gihr.");
  AD("holz",
      "Schoenes, schwarzes Holz. Sehr elegant.");
  AD(({"tuer","tuere"}),
      "Da geht es raus.");
  AD("tijara",
      "Da bist Du momentan.");
  AD(({"strassen","strasse"}),
      "Da ist sicher mehr los als hier.");


  ASD("panzerschrank","det1");


  ASD(({"schloesser","schloss"}), "det2");

  AD("decke",
      "Die Decke ist aus Stein. Eine kleine Lampe erhellt "
      "den Raum.");
  AD("raum",
      "Der Edelsteinladen in Tijara.");
  AD("lampe",
      "Sie bringt etwas Licht in den Laden.");
  AD("licht",
      "Nicht viel, aber es reicht.");
  AD("boden",
      "Der Boden ist auch aus Stein. Ein Spruch ist eingemeisselt.");
  AD("spruch",
      "Lies ihn.");
  ARD("spruch",
      "Pecunia non olet.");
  AD("pecunia",
      "Tja, was heisst denn das wohl...");


  AD(({"wand","waende"}),
      "Die Waende sind aus festem Stein gemauert. Damit niemand so "
      "leicht hier einbrechen kann. Ueberall stehen stabile "
      "Schraenke.");
  AD("stein",
      "Hart wie Stein ist der Stein, logisch oder...");
  AD(({"schrank","schraenke"}),
      "Die Schraenke beinhalten die Edelsteine von Gihr. Sie sind "
      "aus Stahl und Du bekommst sie sicher nicht auf! Vergiss es!");
  AD("stahl",
      "Fuer Dich nicht zu oeffnen.");


  AD(({"edelstein","edelsteine"}),
      "Es gibt zumindest 30 verschieden Arten hier. Vielleicht auch "
      "mehr...");
  AD(({"art","arten"}),
      "Opal, Diamant, Turmalin, Bergkristall, Lapislazuli, "
      "Saphir, Rubin, Smaragd, Amethyst, Zirkon, Onyx, Granat, "
      "Bernstein, Topas, Aquamarin.");

  AD(({"opal", "diamant", "turmalin", "bergkristall", "lapislazuli",
        "saphir", "rubin", "smaragd", "amethyst", "zirkon", "onyx",
        "granat", "bernstein", "topas", "aquamarin"}),
      "Alles schoene Edelsteine. Frag am besten Gihr danach!");
  AD("ecke",
      "Da steht der Panzerschrank.");
  AD("schild",
      "Lesen.");
  ARD("schild",
      "+~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~+\n"
      "| Momentan leider nur Ankauf    |\n"
      "|                               |\n"
      "|          moeglich!            |\n"
      "|                               |\n"
      "|       Gihr Heuchlox           |\n"
      "+~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~+\n");



  AD("zwerg",
      "Klein, oft baertig, stinkend und magisch wie Weissbrot.");
  AD(({"brot","weissbrot"}),
      "Wie magisch ist denn wohl Weissbrot?!");

  AD(({"laden","edelsteinladen"}),
      "Der Laden gehoert dem Zwerg Gihr Heuchlox. Er handelt hier "
      "Edelsteine aller Art.");
  AD(({"gihr","heuchlox","gihr heuchlox"}),
      "Er ist der Ladenbesitzer.");
  AD(({"ladenbesitzer","besitzer"}),
      "Gihr Heuchlox, der Name sollte Dir was sagen.");
  AD(({"name","namen"}),
      "Hmm, Dir ist nicht zu helfen.");

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN:TT_HOUSE]) );

  AddSound(DEFAULT_SOUND,
      "Von draussen hoert man den Laerm der Stadt!");
  AddSound(({"stadt","laerm"}),
      "In Tijara ist viel los!");


  AddSmell( DEFAULT_SMELL,
      "Es riecht hier nach purer Gier!");
  AddSmell("gier",
      "Auch Du riechst so!");

  AddItem("/d/dschungel/dante/gemquest/gi" , REFRESH_DESTRUCT);
  AIT("/d/dschungel/dante/stein/npc/waechter2", REFRESH_DESTRUCT);

  AE("norden", "/d/dschungel/dante/tijaraneu/room/ti_pfad1"); 

  ACD(({"brich","breche","brech"}), "get_mz");

}


int get_mz(string str)  {
  object cash;
  object w, w2;

  NF("Was willst Du aufbrechen?!\n");

  if(str=="schrank auf"||str=="schraenke auf")  {
    write("Du kannst nur versuchen den Panzerschrank aufzubrechen!\n");
    say(CAP_TPN+" reisst verzweifelt an einem Schrank herum.\n");
    return 1; 
  }


  if(str=="panzerschrank auf"||str=="schloesser auf")    {

    if(!get)  {
      write("Der Panzerschrank wurde schon von "+wer+" aufgebrochen!\n"
          "Er ist leer, leider! "+wer+" muss extrem kraeftig sein!!! WOW!!\n");
      say(CAP_TPN+" reisst an einem aufgebrochenen Panzerschrank herum!\n"
          "Doch den hat "+wer+" schon vor ihm aufgebrochen!\n");
      return 1;  
    }

    if(get)   {

      if(TP->QueryAttribute(A_STR)>=STR)   {   //ob 25 ok is????

        w=present("waechter", TO);

        if(w)  {

          w->Kill(TP);
          write(BS(
                "Der Waechter bruellt: STOP!!! "+CAP(getuid(TP))+"!"));
          return 1; 
        }

        write("Du holst tief Luft und konzentrierst Dich!\n"
            "Dann versuchst Du mit aller Gewalt den Panzerschrank aufzubrechen!\n"
            "Du schaffst es mit letzter Kraft!\n"
            "Der Panzerschrank bricht auf und das Geld, das darin liegt faellt heraus!\n"
            "Leider aber waren es nur "+rand+" Muenzen, seltsam...\n\n");

        say(CAP_TPN+" schafft es den Panzerschrank aufzubrechen!!! WAHNSINNN!!!\n"
            ""+CAP_TPN+" muss ja extrem stark sein!!!\n");

        cash=clone_object("obj/money");
        cash->SetProp(P_AMOUNT, rand);
        cash->move(environment(TP), M_NOCHECK);

        wer=TP->name();
        get=0;
        call_out("aua", 2);
        return 1;  
      }

      if(TP->QueryAttribute(A_STR)<STR)   {  
        write("Du holst tief Luft, konzentrierst Dich!\n"
            "Dann versuchst Du den Panzerschrank aufzubrechen!\n"
            "Doch leider bist Du zu schwach! Gib auf!\n"
            "Komm wieder wenn Du staerker geworden bist!\n\n");

        domainshout(
            CAP_TPN+" ist zu schwach Gihr Heuchlox Panzerschrank aufzubrechen!\n");

        say(CAP_TPN+" versucht den Panzerschrank auszubrechen!\n"
            ""+TPN+" ist aber viel zu schwach!\n"
            "Du lachst ueber diesen Schwaechling!\n");
        call_out("lach", 2);
        return 1; 
      }

      return 0; 
    }

    return 0; 
  }
  return 0; 
}


void aua()   {
  if( (present("gihr", environment(TP))) && (TO==environment(TP)))  {
    write(BSA(
          "HE!!! "+TPN+"!! Was soll das! Bist Du irr!!! Der Schrank ist extrem teuer! "
          "Los hau ab! Verschwinde! Du &%&/!!!",
          "Gihr bruellt: "));
    write(BS("Gihr wuerde Dich gerne schlagen, er ist aber nicht nur gierig, "
          "sondern auch eine total feige &/&/%%$%!!!"));
    say(BSA(
          "HE!!! "+TPN+"!!! Bist Du wahnsinnig!!! WAS SOLL DAS!!! "
          "Los hau ab!!!", "Gihr bruellt "+TPN+" an: "));
  }  
}

void lach()  {
  if((present("gihr", TO) ) && (TO==environment(TP)))  {  
    write("Gihr Heuchlox lacht Dich aus!\n"
        "Gihr sagt: Na, "+TPN+" zu schwach!!!\n");
    say(
        "Gihr Heuchlox lacht sich krumm ueber "+TPN+"!\n"
        "Gihr sagt: Na, "+TPN+", bist wohl zu schwach dafuer!\n");
  }
}



det1()  {     
  if(get)  {
    write(BS(  
          "Der Panzerschrank ist auch aus Stahl, doch sein Stahl ist noch "
          "zusaetzlich 12 mal gehaertet worden. Er wird durch 12 Schloesser "
          "gesichert."));  
  }
  if(!get)    {
    write("Der Panzerschrank wurde von "+wer+" bereits aufgebrochen!\n"
        "Unglaublich, aber wahr. Die Kraefte von "+wer+" muessen unglaublich sein!\n");
  }
  return "";  
}


det2()   {
  if(get)  {
    write(BS(
          "12 sind es, ebenfalls aus Stahl. Die bekommst Du nie auf, oder doch?! "
          "Du kannst ja mal probieren ihn aufzubrechen!!!"));  
  }
  if(!get)  {
    write(BS(
          "Die Schloesser wurden alle von "+wer+" aufgebrochen und der "
          "Panzerschrank wurde ausgeraeumt!!! Wahnsinn!!!"));
  }
  return "";  
}

reset()  {
  ::reset();
  wer="";
  get=1;
}

