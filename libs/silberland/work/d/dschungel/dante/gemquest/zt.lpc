//dante sl 99
/*


   fuer woody:
   der zt entsteht wenn man einen gem mit dem gemhammer zertruemmert
   je nach gem heilt er.
   heilungswert abhaengig vom wert der zertruemmerten gems
   max wert= 800(diamant) -> _
HEAL: ({ val/25+20,val/25+20}), F_DRINK:val/40+5, F_ALCOHOL:0, F_POISON:0,
also heal max 52 bei diamant, die anderen sind bedeutend mieser


*/



#include "/players/dante/myowndefine.h"

inherit "std/food";

#include <properties.h>
#include <language.h>
#include <food.h>

string wer;
int count=0;

void reset() {
  ::reset();
  if(!is_clone(TO)) return;
  if( !environment(TO) ) remove();
  if( id("LEERERTRANK") )
  {
    tell_object(environment(TO),BS(
          "Der leere Zaubertrank loest sich auf."));
    remove();
  }
  else
  {
    count++;
    if(count >= 100)  {
      call_out("st1", 0); }
  }
}


void st1()  {
  if(!environment(TO)) return ;
  tell_object(environment(TO),BS(
        "Dein Zaubertrank wird sehr bald aufloesen! Trinke ihn so schnell "
        "wie moeglich!"));
  call_out("st2", 60);  
}

void st2()  {
  if(!environment(TO)) return ;
  tell_object(environment(TO),BS(
        "Dein Zaubertrank beginnt sich aufzuloesen! Trinke ihn so schnell "
        "wie moeglich!"));
  call_out("st3", 60);  
}

void st3()  {
  if(!environment(TO)) return ;
  tell_object(environment(TO),BS(
        "Dein Zaubertrank loest sich langsam auf! Zu spaet!!!"));
  TO->remove();
}

void create()
{
  if (!is_clone(TO) )  return;
  ::create( ({"trink","trinke"}) );  

  count=0;
  SetProp(P_SHORT, "Ein kleiner Zaubertrank");

  SetProp(P_NAME, "Zaubertrank");
  SetProp(P_GENDER, MALE);
  SP(P_NAME_ADJ, "klein");
  AddId( ({"zaubertrank", "trank", "ZAUBERTRANK"}) );

  SP(P_INFO, "Du kannst den Zaubertrank trinken!\n");


  SetProp(P_MATERIAL, ([MAT_MISC_FLUID: 50, MAT_MAGIC:50]) );
  SetProp(P_WEIGHT, 50);
  SetProp(P_VALUE, 20);
  SetProp(P_NOBUY, 1);

  SetProp (P_FOOD_INFO, ([
        F_HEAL     : ({0,0}),               
        F_DRINK:15, F_ALCOHOL:0, F_POISON:0,  
        F_MSG      : "Du trinkst den Zaubertrank aus. Hmm, der schmeckte gut!!!\n",
        F_MSG_ROOM : "trinkt einen Zaubertrank leer und freut sich dann!\n",
        F_VERB     : "trinken" ]) );


  SP(P_NODROP, 1);
  SP(P_NEVERDROP, 1);
  //nur so geclonte bringen nix

}




void wie_gut(int val)  {
  SetProp (P_FOOD_INFO, ([
        F_HEAL: ({ val/20+20,val/20+20}), F_DRINK:val/100+7, F_ALCOHOL:0, F_POISON:0,
        F_MSG      : "Du trinkst den Zaubertrank aus. Hmm, der schmeckte gut!!!\n", 
        F_MSG_ROOM : "trinkt einen Zaubertrank leer und freut sich dann!\n",
        F_VERB     : "trinken" ]) );



}

varargs int second_life(object pl)  {
  count=-99;
  SP(P_NAME_ADJ, "leer");
  SP(P_SHORT, "Ein leerer Zaubertrank");
  SP(P_VALUE, 10);
  SP(P_WEIGHT, 1);
  SP(P_NODROP,0);
  SP(P_NEVERDROP,0);
  SP(P_LONG,"Dieser Zaubertrank wurde schon verbraucht :(");
  RemoveCmd( ({"trink","trinke" }) );
  RemoveId("ZAUBERTRANK");
  AddId("LEERERTRANK");
  SetProp(P_FOOD_INFO, ([
        F_HEAL: ({ 0,0 }) ]) );
  return 1;
}

