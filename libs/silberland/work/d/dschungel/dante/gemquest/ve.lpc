//questobj fuer gemquest dante sl 98-99
/*
das neue questobj:
aus allen 33 neuen gems werden 15 ausgesucht die man bringen muss.
per random. immer anders, klar
d.h die quest wurde viel aufwendiger, daher neubewertung notwendig
dante 14.01.2001
*/
//bugfix 15.3.03 nun wirklich 100% rebootfest


#include "/players/dante/myowndefine.h"
inherit "std/thing";
#include <properties.h>
#include <language.h>

string *gems;
mapping erledigt;

init()  {
   ::init();
if(!living(environment(TO))) {
   destruct(); }}
   


create()
{
  if (!is_clone(TO) )  return;
  ::create();

  SetProp(P_SHORT, "Ein Vertrag mit Gihr Heuchlox");
  SetProp(P_NAME, "Vertrag");
  SetProp(P_GENDER, MALE);
  SP(P_LONG, BS(
"Das ist der Vertrag den Du mit Gihr Heuchlox abgeschlossen hast. "
"Er garantiert Dir zumindest 25000 Muenzen fuer jeden einzelnen "
"Edelstein, wenn Du Gihr von jeder Edelsteinart, die es hier gibt, "
"ein Exemplar bringst. Du solltest ihn genauer untersuchen!"));
  
  AddId( ({"DANTE_GEM", "vertrag"}));

  SetProp(P_MATERIAL, ([MAT_PAPER:100]) );
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_MAGIC, 1);

}



 _query_info()
 
{
  string ret;
  int i;


  ret = "Eine Liste von abgegebenen und noch zu bringenden Edelsteinen:\n\n"; 
  for(i=0; i<sizeof(gems); i++)
  {
     ret += "   "+gems[i]+((erledigt[gems[i]])?("   (abgegeben)"):"")+"\n";
  }
  ret += 
     "\nWenn Du einen Edelstein hast, so liefere ihn bei Gihr ab!\n";
        
  return ret;
}


void SetZutaten(string *arg)
{
  int i;  
  
  erledigt = ([]);
  gems = arg;
  for (i=0; i<sizeof(gems); i++)
    erledigt[gems[i]] = 0;
  return;
}

string *QueryZutaten() { return gems; }

void SetZutatErledigt(string key) { erledigt[key] = 1; }

int QueryZutatErledigt(string key) { return erledigt[key]; }

int QueryErledigt() 
{ 
  int i, done;

  done = 1;
  for(i=0; i<sizeof(gems); i++)
  {
    if(!erledigt[gems[i]]) 
      done = 0;
  }
  return done;
}



mixed _query_autoloadobj()
{
  return ({erledigt, gems, QueryProp(P_IDS)});
}

void _set_autoloadobj(mixed arg)
{
  if (sizeof(arg) > 1)
  {
    erledigt=arg[0];
    gems=arg[1];
    AddId(arg[2]);
    
  }

}


