// /d/dschungel/feyaria/tijara/room/weg_a5.c
// Weg in Tijara, A5
// 30-10-96  Feyaria@SilberLand
// 17 Details, 1 Sound, 1 Smell

/*
Exit nach westen eingebaut fuer den Edelsteinladen
Dante 99
long angepasst
*/


#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Ein Weg in Tijara" );
  SetProp( P_INT_LONG, BS(
    "Du befindest Dich auf einem Weg in Tijara. Er macht hier einen Knick "
    "und fuehrt nach Norden an der Stadtmauer entlang und nach Osten zum "
    "Hauptplatz. Die Haeuser machen hier einen etwas armseligen Eindruck. "
    "Hier leben wohl die aermeren Einwohner, trotzdem hat sich ein "
    "Edelsteinhaendler hier angesiedelt. Seinen Laden kannst Du im "
    "Westen betreten."));
    
  SetProp( P_LIGHT, 2 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 29, ENV_TERRAIN: TT_TOWN]) );

  AddDetail( ({ "tijara", "stadt" }),
    "Du befindest Dich mitten in der Stadt Tijara.");
  AddDetail( ({ "sonne", "himmel", "hitze" }),
    "Die Sonne brennt erbarmungslos vom Himmel herunter, und das ist auch "
    "der Grund fuer die Hitze hier.");
  AddDetail( ({ "haeuser", "behausungen"}),
    "Bei diesen armseligen Haeusern handelt es sich um die Behausungen von "
    "armen Fischern.");
  AddDetail( ({ "eindruck"}),
    "Wirklich ein armseliger Eindruck.");
  AddDetail( ({ "einwohner", "fischer"}),
    "Die meisten Einwohner hier sind arme Fischer.");
  AddDetail( ({ "stein", "steinblock", "steinbloecke", "block", "bloecke"}),
    "Die Steinbloecke sind aus hellgrauem, harten Stein, der sich ideal "
    "fuer Befestigungsbauten eignet.");
  AddDetail( ({ "befestigungen", "befestigungsbauten", "befestigung"}),
    "Zu Befestigungen zaehlt die Stadtmauer mit ihren grossen Toren.");
  AddDetail( ({"weg", "norden"}),
    "Der Weg fuehrt von Norden an der Stadtmauer entlang und nach Osten zum "
    "Hauptplatz.");
  AddDetail( ({ "mauer", "stadtmauer", "wand", "waende"}),
    "Die Stadtmauer ist aus grossen hellgrauen Steinbloecken erbaut und ist "
    "ca. 3 Meter hoch. Oben ist sie mit spitzen Holzpfloecken bestueckt, "
    "um ein Ueberklettern zu verhindern. Sie erstreckt sich nach Norden bis "
    "zum Stadttor und nach Sueden am Weg entlang.");
  AddDetail( ({"tor", "stadttor"}),
    "Das Stadttor ist im Norden.");
  AddDetail( ({ "holz", "pfloecke", "holzpfloecke", "spitzen", "spitze"}),
    "Die Holzpfloecke sind wirklich richtig spitz.");
  AddDetail( ({ "boden", "erde"}),
    "Der Boden besteht hier aus festgestampfter Erde.");
  AddDetail( ({ "nordwesten", "westen", "suedwesten"}),
    "In diese Richtung verhindert die Stadtmauer das Weiterkommen.");
  AddDetail( ({ "nordosten", "suedosten", "sueden"}),
    "In diese Richtung ist eine Hausmauer.");
  AddDetail( ({ "haus"}),
    "Kein Haus faellt Dir hier besonders auf.");
  AddDetail( ({ "platz", "hauptplatz", "osten"}),
    "Nach Osten geht es zum Hauptplatz von Tijara.");
  AddDetail( ({ "knick"}),
    "Der Weg macht hier einen Knick von Norden nach Osten.");
  AddDetail( ({ "richtungen", "richtung"}),
    "Es gibt acht verschiedene Richtungen: Norden, Nordosten, Osten, "
    "Suedosten, Sueden, Suedwesten, Westen und Nordwesten.");

  AddSound( DEFAULT_SOUND,
    "Hier ist es richtig ruhig.");
  AddSmell( ({DEFAULT_SMELL, "stadtgeruch", "geruch"}),
    "Es hat hier einen ganz normalen Stadtgeruch.");

AddDetail("westen",
"Im Westen hat man in die Stadtmauer einen Edelsteinladen hineingebaut.");
AddDetail("laden",
"Es ist ein Edelsteinladen.");
AddDetail("edelsteinladen",
"Es ist der Laden von Gihr Heuchlox.");
AddDetail(({"gihr","heuchlox","gihr heuchlox"}),
"Gihr Heuchlox ist der Edelsteinhaendler von Tijara.");
AddDetail(({"haendler","edelsteinhaendler"}),
"Der Edelsteinhaendler heisst Gihr Heuchlox.");


  AddItem( NPC "gardist" , REFRESH_DESTRUCT);

  AddExit( "norden", "./weg_a4" );
  AddExit( "osten", "./weg_b5" );
  AddExit("westen","in den Edelsteinladen#/d/dschungel/dante/gemquest/gemladen");
  
}
