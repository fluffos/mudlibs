// hoehle der steingiganten1

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "/players/dante/myowndefine.h"
#include <wizlevels.h>

init()  {
	::init();
if(!interactive(TP)) { return;  }

if(IS_ARCH(TP))  { return;  }

if(getuid(TP)!="dante")  {
	
  TP->move("/gilden/abenteurer", M_NOCHECK); return; }
 		
 }


create()
{
  ::create();
SetProp (P_INT_SHORT,BS(
"Hier hast Du nichts zu suchen, solange Du nicht Erzmagier, Gott oder Dante bist!"));
 SetProp (P_INT_LONG,BS(
"Hier hast Du nichts zu suchen, solange Du nicht Erzmagier, Gott oder Dante bist!"));


  AddItem("/d/dschungel/dante/tante/tante.lpc", REFRESH_DESTRUCT);
}
 
 
