//dante sl 99 98
inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "/players/dante/myowndefine.h"
#include <wizlevels.h>



int beginn;
int ende;

init()   {
	
  int i;
  object *inv;
  
	::init();
 
  inv=all_inventory(this_object());
  if(inv && sizeof(inv))
    for(i=sizeof(inv)-1;i>=0;i--)
if(!living(inv[i])) destruct(inv[i]);
 

if(interactive(TP))  {
	call_out("check", 1);  }  }
	


 	

	
	check()  {
	if(TO!=environment(TP)) return;
if(beginn==ende)   {
	 tell_object(TP,
	 "JA!!!\n");   }}
	 			


create()
{
  ::create();

beginn=1+random(99999);
ende=1+random(99999);


SetProp( P_INT_SHORT, "In einem Labyrinth" );
  SetProp( P_INT_LONG, BS(
 "Im Laby: details boden, ziel!"));
 

      
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20,ENV_TERRAIN:TT_HOUSE]) );

  AddSound( DEFAULT_SOUND,
    "Du hoerst Schreie von irgendwo her.");
AddSound(({"schrei","schreie"}),
"ALARM!!!");    
  AddSmell( DEFAULT_SMELL,
"Es riecht nach Kampf!");
    AddSmell("kampf",
"Keine Ahnung wie Kampf riecht...");

ASE("osten", "get_o");
ASE("westen", "get_w");
ASE("norden", "get_n");
ASE("sueden", "get_s");
ASE("nordwesten", "get_nw");
ASE("nordosten", "get_no");
ASE("suedwesten", "get_sw");
ASE("suedosten", "get_so");
ASD("ziel", "show_ziel");

ASD("boden", "show_beginn");

}


show_ziel()  {
	return BS(
	"Die Zahl ist "+ende+"!");  }
	
	
show_beginn()  {

	return BS(
"Die Zahl am Boden ist "+beginn+"!");  }

 int get_no()  {
  beginn=beginn/5;
  if(beginn<=0)   {
  	beginn=1+random(99999);  }
  	
   TP->move("/d/dschungel/dante/lab", M_GO +M_SILENT);
 return 1;
 }

 int get_sw()  {
  beginn=beginn*5;
  if(beginn>99999)   {
  	beginn=1+random(99999);  }
  	
   TP->move("/d/dschungel/dante/lab", M_GO +M_SILENT);
 return 1;
 }


 int get_so()  {
  beginn=beginn/4;
  if(beginn<=0)   {
  	beginn=1+random(99999);  }
  	
   TP->move("/d/dschungel/dante/lab", M_GO +M_SILENT);
 return 1;
 }

 int get_nw()  {
  beginn=beginn*4;
  if(beginn>99999)   {
  	beginn=1+random(99999);  }
  	
   TP->move("/d/dschungel/dante/lab", M_GO +M_SILENT);
 return 1;
 }





 int get_w()  {
  beginn=beginn*3;
  if(beginn>99999)   {
  	beginn=1+random(99999);  }
  	
   TP->move("/d/dschungel/dante/lab", M_GO +M_SILENT);
 return 1;
 }


 int get_o()  {
  beginn=beginn/3;
  if(beginn<=0)   {
  	beginn=1+random(99999);  }
  	
   TP->move("/d/dschungel/dante/lab", M_GO +M_SILENT);
 return 1;
 }






	
 int get_s()  {
  beginn=beginn*2;
  if(beginn>99999)  {
  	beginn=1+random(99999);
}

   TP->move("/d/dschungel/dante/lab", M_GO +M_SILENT);
 return 1;
 }



 int get_n()  {
  beginn=beginn/2;
if(beginn<=0)  {
	beginn=1+random(99999);}
	

   TP->move("/d/dschungel/dante/lab", M_GO +M_SILENT);
 return 1;
 }
