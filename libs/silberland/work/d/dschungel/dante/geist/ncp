
inherit "/players/dante/waechterdaemon.c";



#include <combat.h>
#include <moving.h>
#include <properties.h>
#include "/players/dante/myowndefine.h"
#include <new_skills.h>
#include <npc.h>
#define QL QueryProp(P_LEVEL)

object cash;

create(){
   if (!is_clone(TO)) return;    
   ::create();
  create_default_npc(5);

  if(QL<7) {
  SP(P_SHORT,"Ein winziger Waechterdaemon");
  SP(P_NAME_ADJ, "winzig"); return ; }
  
 if(QL>6 && QL<9)  {
 SP(P_SHORT,"Ein sehr kleiner Waechterdaemon");
 SP(P_NAME_ADJ, "sehr klein"); return; }
  
 if(QL>8 && QL<11)  {
 SP(P_SHORT,"Ein kleiner Waechterdaemon");
 SP(P_NAME_ADJ, "klein"); return;}
  
 if(QL>10 && QL<13)  {
 SP(P_SHORT,"Ein mittelgrosser Waechterdaemon");
 SP(P_NAME_ADJ, "mittelgross"); return;}
  
 if(QL>12 && QL<15)  {
 SP(P_SHORT,"Ein grosser Waechterdaemon");
 SP(P_NAME_ADJ, "gross"); return;}
  
 if(QL>14 && QL<17)  {
 SP(P_SHORT,"Ein sehr grosser Waechterdaemon");
 SP(P_NAME_ADJ, "sehr gross"); return;}
  
 if(QL>16 && QL<19)  {
 SP(P_SHORT,"Ein gewaltiger Waechterdaemon");
 SP(P_NAME_ADJ, "gewaltig");return; }
  
 if(QL>18 && QL<21)  {
 SP(P_SHORT,"Ein gigantischer Waechterdaemon");
 SP(P_NAME_ADJ, "gigantisch"); return;}
  
 if(QL>20 && QL<25)  {
 SP(P_SHORT,"Ein bombastischer Waechterdaemon");
 SP(P_NAME_ADJ, "bombastisch");return; }

 if(QL>24) {
 SP(P_SHORT,"Ein ultimativer Waechterdaemon");
 SP(P_NAME_ADJ, "ultimativ"); return;}
  
cash=clone_object("/obj/money");
cash->SetProp(P_AMOUNT, 100);
cash->move(ME);
  
  }
  
