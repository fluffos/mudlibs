

inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <combat.h>
#include <new_skills.h>
#include <npc.h>
#include "/players/dante/myowndefine.h"




void create()
{


if (!is_clone(TO)) return;
::create();
SetProp(P_SHORT, "Garto Gnadenstoss");
SetProp(P_LONG, BS(
"Garto Gnadenstoss war frueher einmal ein Daemonenjaeger, nun ist er aber "
"schon lange hier der Wirt. Er spricht nicht gerne ueber Daemone, weiss aber "
"trotzdem einiges."));
SetProp(P_NAME,"Garto Gnadenstoss");
SetProp(P_GENDER, MALE);

AddId(({"gnadenstoss","daemonenjaeger","jaeger","garto gnadenstoss","garto"}));

set_living_name("garto");


SetProp(P_ARTICLE, 0);
SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10, T_RANGE_MAX: 45]));
create_default_npc(20);
SetProp(P_HANDS, ({" mit seinem Monsterangriff geschickt",
200+random(100),DT_SLASH}));
SetProp(P_BODY, 50);
SetProp(P_SIZE, 200);
SetProp(P_ALIGN, 500);
SetProp(P_MAX_HANDS, 2);
SetProp( P_RESISTANCE_STRENGTHS,([DT_FIRE: 0.6, DT_TERROR:1.0,
 DT_BLUDGEON:-1.0, DT_MAGIC:-0.5, DT_WATER: 0.4, DT_COLD: -0.5 ]));

SetProp(P_HEAL,10);
SetProp(P_AGGRESSIVE, 0);
SetProp(P_WIMPY, 0);
SetProp(P_NOMAGIC, 3);
SetProp(P_NOCORPSE, 0);

SetProp(P_MSGIN, "kommt froehlich herein");
SetProp(P_MSGOUT, "geht");
SetProp(P_MMSGIN, "sagt: Was darfs sein?!");
SetProp(P_MMSGOUT, "geht");

SetProp(P_MURDER_MSG, "Ohne mich seid Ihr verloren!");
SetProp(P_KILL_NAME, "Garto Gnadenstoss");
SetProp(P_KILL_MSG, "Du hast Lokalverbot!");
SetProp(P_MSG_FLAGS, ([P_KILL_MSG:1, P_MURDER_MSG:1 ]));




SetChats(5,({
"Garto Gnadenstoss sagt: Tja, das Leben hier ist nicht leicht.\n",
"Garto Gnadenstoss sagt: Frueher habe ich auch mal Daemone erschlagen!\n",
"Garto Gnadenstoss sagt: Komm, trink noch was!\n",
"Garto Gnadenstoss schnekt sich selbst was ein.\n",
"Garto Gnadenstoss sagt: Kennst Du Dantes boeses ich?\n",
"Garto Gnadenstoss traeumt von alten Zeiten.\n",
"Garto Gnadenstoss sagt: Die Spieler sind auch nicht mehr das was sie mal waren!\n",
"Garto Gnadenstoss sagt: Aufgeschrieben wird hier nicht!\n"}));

AddInfo(({"mops","terrormops"}),
"lacht sich krumm ueber den Terrormops!");
AI("nosferatu",
"Er ist der oberste aller Vampire!", "sagt leise: ");
AI(({"meister","meister der runen","runenmeister"}),
"Der Meister der Runen ist der Chef der Runenmaenner.", "sagt: ");
AI(({"maenner","runen","rune","runenmaenner"}),
"Die Runenmaenner leben irgendwo hier in einer Burg. Sie zaubern "
"mit Hilfe von Runen. ", "sagt: ");

SetProp(P_SPELLRATE,70);

SUID;
 CLONEME("/d/gebirge/speedy/trollager/armour/trollruestung");
 CLONEME("/p/weapon/club/streitkolben");
 CLONEME("/p/armour/boots/lederstiefel");
 CLONEME("/obj/thermometer");
 CLONEME("/d/ebene/lamuerte/wwald/obj/ogerhelm");
 command("zuecke kolben");
 command("zieh alles an");
 


AI(({"cristof","feuerwind"}),
"Das ist der beruehmte Jaeger der Daemonen!",
"sagt: ");
AI(({"daemon","daemone"}),
"Frueher habe ich sie auch gejagt.", "sagt: ");

AI(({"drache","skelettdrache"}),
"Hmm, der wohnt in der Unterwelt.","sagt: ");

AI("vampirdrache",
"Der lebt im Nordosten der Vampirhoehlen", "sagt: ");

AI(({"statue"}),
"Angeblich ist sie hohl...", "sagt: ");
AI(({"vampir","vampire"}),
"Die Vampire leben in einer versteckten Hoehle. Irgendwo tief drinnen ist auch "
"die Gruft von Nosferatu.", "sagt: ");
AI("gruft",
"Hmm, ich denke Du bist noch zu schwach dafuer...", "grinst: ");
AI("hoehle",
"Die Hoehle der Vampire liegt hmm ja wo ist die...", "sagt: ");
AI("mutantenvampir",
"Direkt bei ihm kann man die Hoehle betreten...", "sagt: ");
AI(({"jona","furchtlos"}),
"Auch ein Jaeger.", "sagt ernst: ");
AI("dante",
"Der hat all das hier verbrochen...!\n", "sagt: ");
AI(({"boeses ich","boese","dantes boeses ich","ich"}),
"Hmm, tja da ann Ich Dir weiterhelfen. Also, das Boese ich lebt auch hier bei den "
"Daemonen. Eigetlich lebt es in der ewigen Dunkelheit, also da wo Du nichts mehr "
"siehst, wird es wohl sein. Heute Dich vor ihm. Greife es nie unvorbereitet an, denn "
"das waere Dein Tod. Du musst Dich gut vorbereiten, glaub mir! Mehr will ich und "
"kann Ich Dir nicht sagen, denn das boese Ich ist im Pakt mit dem Namenlosen "
"und der hoert und weiss alles.", "sagt leise: ");

 AddInfo(DEFAULT_INFO,({
"sagt: Hmm, gute Frage!\n",
"lacht wissend.\n",
"grinst bloed.\n",
"sagt: Trink lieber noch was!\n",
"sagt: PSST!!! Der Namenlose hoert alles mit!\n",
"sagt leise: Heute Dich vor Dantes boesem Ich!\n",
"sagt: Bedenke, Du bist nur ein Wurm!\n",
"sagt: Du musst bei der Statue lange stehen bleiben! Das macht Spass!\n"}));


AddSpell(4,250,
"Garto Gnadenstoss greift Dich mit einem grossen Feuerball an.\n",
"Garto Gnadenstoss greift @WEN mit einem grossen Feuerball an.\n",
DT_FIRE, ([SP_SHOW_DAMAGE:1]));


AddSpell(2,300,
"Garto Gnadenstoss schlaegt Dir ins Gesicht.\n",
"Garto Gnadenstoss schlaegt @WEM ins Gesicht.\n",
DT_SLASH, ([SP_SHOW_DAMAGE:1]));

}

init() {
::init();
if(interactive(TP)) {
call_out("tag", 0);  }}

void tag(){
  
   if(environment(TP)!=environment(TO))  return ;
command("emote sagt: "+TPN+", wie hast Du Dich zu mir verirrt?! Hallo!\n");}


HitFunc(int dam, string dtype, mixed spell, object enemy)
{
if(getuid(enemy)=="daemon")  {
return -1000;
} }


Defend(int dam, string dtype, mixed spell, object enemy)
{


if(getuid(enemy)=="daemon")  {
return ::Defend(0, dtype, spell, enemy);

}

return ::Defend(dam, dtype, spell, enemy);
}



void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  shout(
  "Garto Gnadenstoss bruellt: Danke fuer die "+lostexp+" Eps, "+TPN+"!\n");
  
 write_file("/d/dschungel/dante/geist/log/garto",
 ctime()+":  Gartod  hat "+CAP(getuid(PL))+" umgebracht.\n");
}

die(arg)
{
write("Der Namenlose teilt Dir mit: Gut gemacht!\n");

write_file("/d/dschungel/dante/geist/log/garto",
 ctime()+":  Garto wurde von "+CAP(getuid(PL))+"umgebracht.\n");

::die(arg);
}



