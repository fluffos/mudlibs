
inherit "std/npc";
#include <combat.h>
#include <properties.h>
#include <language.h>
#include <new_skills.h>
#include "/players/dante/myowndefine.h"
#include <moving.h>


void create()
{


if (!is_clone(TO)) return;
::create();


SetProp(P_SHORT, "Ein verstossener Daemon");
SP(P_LONG, BS(
"Dieser Daemon wurde sogar von seinen Daemonenkollegen verstossen. Das hat sicher "
"seine Gruende, doch die kennst Du nicht."));
SetProp(P_NAME,"Daemon");
SP(P_NAME_ADJ, "verstossen");
SetProp(P_GENDER, MALE);
AddId(({"daemon"}));
SetProp(P_ARTICLE, 1);
SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10, T_RANGE_MAX: 45]));
create_default_npc(8+random(3));



SetProp(P_HANDS, ({" mit seine giftigen Haenden",50+random(50),DT_POISON}));
SetProp(P_BODY, 50+random(10));
SetProp(P_SIZE, 160+random(20));
SetProp(P_ALIGN, -500);
SetProp(P_MAX_HANDS, 2);
SetProp( P_RESISTANCE_STRENGTHS,([DT_BLUDGEON:1.0, DT_HOLY: 0.3,DT_UNHOLY:-1.0, DT_TERROR:-1.0]));
SP(P_INFO, "Toete diesen Daemon niemals. Noch besser waere, wenn Du ihm aus dem Weg gehst.\n");
SetProp(P_HEAL,-5);
SetProp(P_AGGRESSIVE, 0);
SetProp(P_WIMPY, 0);
SetProp(P_NOMAGIC,5);
SetProp(P_NOCORPSE, 1);
SetProp(P_MSGIN, "steht ploetzlich giftig vor Dir");
SetProp(P_MSGOUT, "verschwindet grinsend");
SetProp(P_MMSGIN, "taucht ploetzlich auf");
SetProp(P_MMSGOUT, "verschwindet");

SetProp(P_MURDER_MSG, "Du dummer Wurm wolltest nicht hoeren!");
SetProp(P_KILL_NAME, "Dummheit und ein verstossener Daemon");
SetProp(P_KILL_MSG, "Bloed gelaufen fuer Dich!!!");
SetProp(P_MSG_FLAGS, ([P_KILL_MSG:1, P_MURDER_MSG:1 ]));



SetProp(P_SPELLRATE,99);


AddSpell(4,100+random(100),
"Der Daemon pruegelt auf Dich ein!\n",
"Der Daemon pruegelt auf @WEN ein.\n",
DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));

AddSpell(2,100+random(100),
"Der Daemon schlaegt Dich nieder!\n",
"Der Daemon schlaegt @WEN nieder.\n",
DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));

SetChats(10,({
"Der verstossene Daemon tritt Dich!\n",
"Der verstossene Daemon sagt: Hau ab!\n",
"Du fuehlst Dich sehr schlecht hier.\n",
"Der verstossene Daemon sagt: Lass mich ja in Ruhe!\n",
"Der verstossene Daemon grinst Dich boesartig an!\n",
"Der verstossene Daemon lacht Dich aus!\n"}));
SetAttackChats(5,({
"Der verstossene Daemon sagt: STOP!!!\n",
"Der verstossene Daemon sagt: Hoer auf damit, ich warne Dich!\n",
"Der verstossene Daemon sagt: Fliehe, es wird Dein Tod sein!\n",
"Der verstossene Daemon sagt: Hoer auf mich!!!\n"}));

}


Defend(int dam, string dtype, mixed spell, object enemy)
{

if(getuid(enemy)=="daemonenjaeger")  {
return -1000;   }


if (!pointerp(dtype))
dtype = ({ dtype });


if (sizeof(dtype & ({ DT_TERROR }) ))
{

tell_room(environment(),
"Der Daemon lacht Dich aus!!!!\n");
heal_self(dam);
return ::Defend(0, dtype, spell, enemy);

}

return ::Defend(dam, dtype, spell, enemy);
}


die(arg)
{

write(BSA(
"Du dummer Sterblicher wolltest ja nicht hoeren. Was habe ich Dir gesagt!!! "
"Wenn ich sterbe, explodiere ich und meine Eingeweide sind so giftig, dass "
"sogar die Daemonen und Untoten sie fuerchten muessen. Du Narr!!!",
"Der verstossene Daemon bruellt: "));

write("Danach explodiert er und die Eingeweide treffen Dich voll!!!\n");


TP->AddPoison(5+random(3));// da heissts laufen.....

//TP->SetProp(P_HP, 10);
//TP->SetProp(P_MP, 10); //fals zauber moeglich der heilt:))))))
//hehehehehehehehehe wer sehr sehr schnell ist..kann ueberleben...


write_file("/d/dschungel/dante/geist/log/explo",
ctime()+": Daemon hat "+CAP(getuid(PL))+" vergiftet.\n");

::die(arg);
}

