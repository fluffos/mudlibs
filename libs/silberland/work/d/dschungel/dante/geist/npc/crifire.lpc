inherit "std/mnpc";
#include "/players/dante/myowndefine.h"
#include <properties.h>
#include <language.h>
#include <moving.h>
#include <combat.h>
#include <new_skills.h>
#include <mnpc.h>


int heilen=1;
void create()
{


if (!is_clone(TO)) return;
::create();
SetProp(P_SHORT, "Cristof Feuerwind, der Oberdaemonenjaeger");
SetProp(P_LONG, BS(
"Cristof Feuerwind ist der Chef der Daemonenjaeger. Keiner hat soviele "
"Daemonen wie er erlegt. Aber keiner hat auch soviel Hiebe auf den Kopf "
"bekommen wie er..."));
SetProp(P_NAME,"Cristof Feuerwind");
SetProp(P_GENDER, MALE);
AddId(({"daemonenjaeger","oberdaemonenjaeger","feuerwind","cristof"}));
SetProp(P_ARTICLE, 0);
SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10, T_RANGE_MAX: 45]));
create_default_npc(20);
SetProp(P_HANDS, ({" mit seinem Luftschwert geschickt",
200+random(100),DT_SLASH}));
set_living_name("cristof");
SetProp(P_BODY, 60);
SetProp(P_SIZE, 250);
SetProp(P_ALIGN, 500);
SetProp(P_MAX_HANDS, 2);
SetProp(P_INFO, "Feuerwind kennt sich hier gut aus!!!\n");
SetProp( P_RESISTANCE_STRENGTHS,([DT_FIRE: -1.0, DT_TERROR:1.0,
 DT_BLUDGEON:-0.3, DT_MAGIC:-0.5, DT_WATER:0.4, DT_COLD:-0.5]));

SetProp(P_HEAL,10);
SetProp(P_AGGRESSIVE, 0);
SetProp(P_WIMPY, 100);
SetProp(P_NOMAGIC, 5);
SetProp(P_NOCORPSE, 0);
SetProp(P_MSGIN, "kommt auf der Jagd nach Daemonen herein");
SetProp(P_MSGOUT, "stuermt auf der Jagd nach Daemonen");
SetProp(P_MMSGIN, "taucht ploetzlich neben Dir auf");
SetProp(P_MMSGOUT, "verschwindet ");

SetProp(P_MNPC_AREA, ("/d/dschungel/dante/geist/room/"));
SetProp(P_MNPC_FLAGS, MOV_MOVES+MOV_BACKWARDS+
MOV_INFIGHT+MOV_INDOORS +MOV_OUTDOORS+MOV_SPECIAL);

SetProp(P_MNPC_WAIT, ({10, 10, 10}));
SetProp(P_MNPC_DEFAULTROOM, "d/dschungel/dante/geist/room/geist22");
SetProp(P_MURDER_MSG, "Ohne mich seid Ihr verloren!");
SetProp(P_KILL_NAME, "Cristof Feuerwind");
SetProp(P_KILL_MSG, "Ich toete nicht nur Daemonen!");
SetProp(P_MSG_FLAGS, ([P_KILL_MSG:1, P_MURDER_MSG:1 ]));




SetChats(5,({
"Cristof Feuerwind sagt: Komm, lass uns Daemonen toeten!\n",
"Cristof Feuerwind  sagt: Ich habe bisher ueber 5000 Daemone erlegt!\n",
"Cristof Feuerwind sagt: Neulich erlegte ich einen besonders fetten Daemon!\n",
"Cristof Feuerwind deutet nach Norden!\n",
"Cristof Feuerwind sagt: Kennst Du den Skelettdrachen?\n",
"Cristof Feuerwind sagt: Morgen toete ich den Vampirdrachen!\n",
"Cristof Feuerwind sagt: Die Daemone sind auch nicht mehr das was sie einmal waren!\n",
"Cristof Feuerwind grinst wissend.\n",
"Cristof sagt: Psst! Der Namenlose kommt!!!\n",
"Cristof Feuerwind sagt: Hmm, die grosse Statue ist sehr interessant.\n",
}));

AddInfo(({"mops","terrormops"}),
"lacht sich krumm ueber den Terrormops!");



SetProp(P_SPELLRATE,70);
 SUID;
CLONEME("/p/armour/plattenpanzer");
CLONEME("p/armour/mithrilhelm");
CLONEME("/p/armour/lederschild");
CLONEME("/p/armour/robe");
CLONEME("/p/armour/lederhose");
CLONEME("/p/weapon/morgenstern");
command("zieh alles an");
command("zuecke morgenstern");


AI(({"daemon","daemone"}),
"Hier leben die Daemone! Irgendwo treibt sich auch ihr Herrscher herum!",
"sagt: ");
AI(({"herrscher","daemonenanfuehrer","anfuehrer"}),
"Der Namenlose soll in der Statue leben!","sagt: ");
AI(({"namelose","namenloser"}),
"Er ist der Herrscher der aller Daemonen!","sagt: ");
AI(({"jona","furchtlos"}),
"Ah, der alte Jona. Was macht der denn so? Hast Du mir von ihm etwas zu sagen?",
"sagt: ");

AI(({"cristof","feuerwind"}),
"Das bin ich!", "sagt: ");
AI(({"daemon","daemone"}),
"Sterben muessen sie alle! Wenn Du mehr wissen willst, frag den Waechter des "
"Dschungels. Der weiss alles.",
"sagt ernst: ");
AI(({"drache","skelettdrache"}),
"Hmm, der wohnt irgendwo in der Unterwelt.","sagt: ");
AI("vampirdrache",
"Der lebt irgendwo in den Hoehlen der Vampire...", "sagt: ");
AI(({"statue"}),
"Irgendwie kommt man da hinein...", "sagt: ");
AddInfo(DEFAULT_INFO,({
"sagt: Hmm, gute Frage!\n",
"lacht wissend.\n",
"grinst bloed.\n",
"sagt: Du musst bei der Statue lange stehen bleiben!\n"}));


AddSpell(4,300,
"Cristof Feuerwind greift Dich mit einem grossen Feuerball an.\n",
"Cristof Feuerwind greift @WEN mit einem grossen Feuerball an.\n",
DT_FIRE, ([SP_SHOW_DAMAGE:1]));


AddSpell(2,400,
"Cristof Feuerwind sticht wild auf Dich ein.\n",
"Cristof Feuerwind sticht wild auf @WEN ein.\n",
DT_PIERCE, ([SP_SHOW_DAMAGE:1]));


AddSpell(1,600,
"Cristof Feuerwind schleudert einen Feuerwind nach Dir.\n",
"Cristof Feuerwind schleudert einen Feuerwind nach @WEM!\n",
DT_FIRE, ([SP_SHOW_DAMAGE:1]));
ACD(({"richt","richte"}), "get");
}


int get(string str)  {
NF("Was willst Du hier tun?\n");
if(member(({"gruesse von jona aus",   "schoene gruesse von jona aus",
"gruesse von jona furchtlos aus", "cristof gruesse von jona aus",
"cristof schoene gruesse von jona aus",
"cristof feuerwind gruesse von jona aus"}),str)!=-1)  {

//explmaster usw.....

if(!heilen) {
write("Jona sagt: "+TPN+", dass ist nett von Dir! Danke!\n");
return 1;  }

else  {
write("Jona sagt: "+TPN+",  vielen Dank! Dafuer heile ich Dich aus!\n");
TP->heal_self(300); //is viel aber auch nur einmal pro resest und man kanns hier gebrauchen
heilen--;
return 1;
}
return 0;
}
return 0;
}

reset()  {
::reset();
heilen=1;
}



init()
{object ob;
::init();
ob=present("daemon", environment(TO));
if(ob) ob->Kill();
if(interactive(TP))  { call_out("tag", 0);}
}

void tag()  {
 if(environment(TP)!=environment(TO))   return ;
  else
   write("Cristof Feuerwind sagt: "+TPN+", lass und Daemonen toeten!\n");  }
   




HitFunc(int dam, string dtype, mixed spell, object enemy)
{
if(getuid(enemy)=="daemon")  {
return -1000;
} }


Defend(int dam, string dtype, mixed spell, object enemy)
{


if(getuid(enemy)=="daemon")  {
return ::Defend(0, dtype, spell, enemy);

}



if (!pointerp(dtype))
dtype = ({ dtype });

if (sizeof(dtype & ({ DT_FIRE }) ))
{

tell_object(enemy,
"Dein Angriff prallt von Cristof Feuerwind ab und trifft Dich!!!\n");
enemy->Defend(dam, DT_FIRE, ([SP_SHOW_DAMAGE:1]));

return ::Defend(0, dtype, spell, enemy);

}

return ::Defend(dam, dtype, spell, enemy);
}



void NotifyPlayerDeath(object player, object killer, int lostexp)
{
write_file("/d/dschungel/dante/geist/log/crifeuer",
ctime()+": CrisF "+CAP(getuid(PL))+" umgebracht.\n");
}

die(arg)
{
write_file("/d/dschungel/dante/geist/log/crifire",
ctime()+": CrisF wurde von "+CAP(getuid(PL))+" umgebracht.\n");

::die(arg);
}



