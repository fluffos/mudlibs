inherit "std/mnpc";
#include "/players/dante/myowndefine.h"
#include <properties.h>
#include <language.h>
#include <moving.h>
#include <combat.h>
#include <new_skills.h>
#include <mnpc.h>


void create()
{


if (!is_clone(TO)) return;
::create();
SetProp(P_SHORT, "Jona Furchtlos, der Daemonenschlaechter");
SetProp(P_LONG, BS(
"Das ist Jona Furchtlos, seines Zeichens  Monsterschlaechter und Spezialist "
"fuer  Monster aller Art. Er lebt seit langem hier und kann Dir sicher einiges "
"ueber Daemone, Vampire und Runenmaenner erzaehlen."));
SetProp(P_NAME,"Jona Furchtlos");
SetProp(P_GENDER, MALE);
AddId(({"daemonenjaeger","furchtlos","jona"}));
SetProp(P_ARTICLE, 0);
SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10, T_RANGE_MAX: 45]));
create_default_npc(20);
SetProp(P_HANDS, ({" mit seinem Monsterangriff geschickt",
200+random(100),DT_SLASH}));
SetProp(P_BODY, 50);
SetProp(P_SIZE, 200);
SetProp(P_ALIGN, 500);
SetProp(P_MAX_HANDS, 2);
SetProp( P_RESISTANCE_STRENGTHS,([DT_FIRE: 0.6, DT_TERROR:1.0,
DT_BLUDGEON:-0.3, DT_MAGIC:-0.5, DT_WATER:0.3, DT_COLD:-0.7]));

set_living_name("jona");


SetProp(P_HEAL,10);
SetProp(P_AGGRESSIVE, 0);
SetProp(P_WIMPY, 100);
SetProp(P_NOMAGIC, 5);
SetProp(P_NOCORPSE, 0);
SetProp(P_MSGIN, "kommt auf der Jagd nach Monstern herein");
SetProp(P_MSGOUT, "stuermt auf der Jagd nach Monstern");
SetProp(P_MMSGIN, "taucht ploetzlich neben Dir auf");
SetProp(P_MMSGOUT, "verschwindet ");

SetProp(P_MNPC_AREA, ("/d/dschungel/dante/geist/room/"));
SetProp(P_MNPC_FLAGS, MOV_MOVES+MOV_BACKWARDS+
MOV_INFIGHT+MOV_INDOORS +MOV_OUTDOORS+MOV_SPECIAL);

SetProp(P_MNPC_WAIT, ({10, 10, 10}));
SetProp(P_MNPC_DEFAULTROOM, "d/dschungel/dante/geist/room/geist56");
SetProp(P_MURDER_MSG, "Ohne mich seid Ihr verloren!");
SetProp(P_KILL_NAME, "Jona Furchtlos, der Monsterschlaechter");
SetProp(P_KILL_MSG, "Ich toete nicht nur Monster!");
SetProp(P_MSG_FLAGS, ([P_KILL_MSG:1, P_MURDER_MSG:1 ]));




SetChats(5,({
"Jona Furchtlos sagt: Komm, lass uns Vampire toeten!\n",
"Jona Furchtlos sagt: Ich habe bisher ueber 1000 Daemone erlegt!\n",
"Jona Furchtlos sagt: Neulich toete ich einen Blutvampir!\n",
"Jona Furchtlos sagt: Huete Dich vor Nosferatu!\n",
"Jona Furchtlos sagt: Kennst Du Nosferatu?\n",
"Jona Furchtlos sagt: Morgen toete ich den Vampirdrachen!\n",
"Jona Furchtlos sagt: Die Spieler sind auch nicht mehr das was sie einmal waren!\n",
"Jona Furchtlos grinst wissend.\n",
"Jona Furchtlos sagt: Hmm, die grosse Statue ist sehr interessant.\n",
"Jona Furchtlos sagt: Der Meister der Runen hat angeblich einen Harnisch!\n"}));

AddInfo(({"mops","terrormops"}),
"lacht sich krumm ueber den Terrormops!");
AI("nosferatu",
"Er ist der oberste aller Vampire!", "sagt leise: ");
AI(({"meister","meister der runen","runenmeister"}),
"Der Meister der Runen ist der Chef der Runenmaenner.", "sagt: ");
AI(({"maenner","runen","rune","runenmaenner"}),
"Die Runenmaenner leben irgendwo hier in einer Burg. Sie zaubern "
"mit Hilfe von Runen. ", "sagt: ");

SetProp(P_SPELLRATE,70);

SUID;
CLONEME("/p/armour/lederschuhe");
CLONEME("/p/armour/mithrilpanzer");
CLONEME("/p/armour/umhang");
CLONEME("/p/armour/hose");
CLONEME("/p/armour/guertel");
CLONEME("/p/weapon/langschwert");
command("zuecke schwert");
command("zieh alles an");


AI(({"cristof","feuerwind"}),
"Das ist der beruehmte Jaeger der Daemonen! Wenn Du ihn triffst,"
"so richte ihm schoene Gruesse von mir aus!!!", "sagt: ");
AI(({"daemon","daemone"}),
"Meine Speziaelitaet sind eher Vampire! Aber auch Daemone toete ich gerne!", "sagt ernst: ");
AI(({"drache","skelettdrache"}),
"Hmm, der wohnt iin der Unterwelt.","sagt: ");
AI("vampirdrache",
"Der lebt im Nordosten der Vampirhoehlen", "sagt: ");
AI(({"statue"}),
"Angeblich ist sie hohl...", "sagt: ");
AI(({"vampir","vampire"}),
"Die Vampire leben in einer versteckten Hoehle. Irgendwo tief drinnen ist auch "
"die Gruft von Nosferatu.", "sagt: ");
AI("gruft",
"Hmm, ich denke Du bist noch zu schwach dafuer...", "grinst: ");
AI("hoehle",
"Die Hoehle der Vampire liegt hmm ja wo ist die...", "sagt: ");
AI("mutantenvampir",
"Direkt bei ihm kann man die Hoehle betreten...", "sagt: ");
AI(({"jona","furchtlos"}),
"Der groesste aller Helden!!!", "sagt ernst: ");
AI("dante",
"Der hat all das hier verbrochen...!\n", "sagt: ");

AddInfo(DEFAULT_INFO,({
"sagt: Hmm, gute Frage!\n",
"lacht wissend.\n",
"grinst bloed.\n",
"sagt: Bedenke, Du bist nur ein Wurm!\n",
"sagt: Du musst bei der Statue lange stehen bleiben!\n"}));


AddSpell(4,250,
"Jona Furchtlos greift Dich mit einem grossen Feuerball an.\n",
"Jona Furchtlos greift @WEN mit einem grossen Feuerball an.\n",
DT_FIRE, ([SP_SHOW_DAMAGE:1]));


AddSpell(2,300,
"Jona Furchtlos schlaegt Dir ins Gesicht.\n",
"Jona Furchtlos schlaegt @WEM ins Gesicht.\n",
DT_SLASH, ([SP_SHOW_DAMAGE:1]));


AddSpell(1,400,
"Jona Furchtlos schleudert einen Furchtfluch nach Dir.\n",
"Jona Furchtlos schleudert einen Furchtfluch nach @WEM!\n",
DT_TERROR, ([SP_SHOW_DAMAGE:1]));

}

init()
{
object ob;
::init();
ob=present("daemon", environment(TO));
if(ob) ob->Kill();
if(interactive(TP))  { call_out("tag", 0);}
}

void tag()  {
 if(environment(TP)!=environment(TO))   return ;
 else
 write("Jona Furchtlos sagt: "+TPN+", willkommen bei den Daemonen!\n");  }
 


HitFunc(int dam, string dtype, mixed spell, object enemy)
{
if(getuid(enemy)=="daemon")  {
return -1000;
} }


Defend(int dam, string dtype, mixed spell, object enemy)
{


if(getuid(enemy)=="daemon")  {
return ::Defend(0, dtype, spell, enemy);

}



if (!pointerp(dtype))
dtype = ({ dtype });

if (sizeof(dtype & ({ DT_TERROR }) ))
{

tell_object(enemy,
"Dein Angriff prallt von Jona einfach ab\n");
enemy->Defend(dam, DT_TERROR, ([SP_SHOW_DAMAGE:1]));

return ::Defend(0, dtype, spell, enemy);

}

return ::Defend(dam, dtype, spell, enemy);
}



void NotifyPlayerDeath(object player, object killer, int lostexp)
{
write_file("/d/dschungel/dante/geist/log/jona",
ctime()+": CrisF "+CAP(getuid(PL))+" umgebracht.\n");
}

die(arg)
{
write_file("/d/dschungel/dante/geist/log/jona",
ctime()+": CrisF wurde von "+CAP(getuid(PL))+" umgebracht.\n");

::die(arg);
}



