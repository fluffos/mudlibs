/*
Dantes Boeses Ich kann nur besiegt werden, wenn der enemy allle
man kanns auch ohne rue umhauen aber eben sehr sehr schwer
ruestungsbestandteile hat die gegen dunkle materie schuetzen.....
Dann is es kein problem mehr ueberhaupt keines sogar.......*/



inherit "std/npc";
#include "/players/dante/myowndefine.h"
#include <properties.h>
#include <language.h>
#include <moving.h>
#include <combat.h>
#include <new_skills.h>
#include <npc.h>




void create()
{


if (!is_clone(TO)) return;
::create();


SetProp(P_SHORT, "Dantes boeses Ich");
SetProp(P_LONG, BS(
"Dantes boeses Ich schimmert schwarz vor Dir. Es ist gestaltlos und flimmert "
"wie ein dunkler "
"Schatten vor Dir hin und her. Konturen scheint  es auch keine zu haben."
"Du solltest Dich vor"
"ihm hueten. Etwas boesartigeres und hinterhaeltigeres hast Du noch nie gesehen. "
"Es scheint Dich auszulachen und siegesgewiss zu sein."));

SetProp(P_NAME,"Dantes boeses Ich");

SetProp(P_GENDER, NEUTER);
AddId(({"dantes","ich","dantes ich","boeses ich","dantes boeses ich","das boese"}));
SetProp(P_ARTICLE, 0);
SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10, T_RANGE_MAX: 45]));
create_default_npc(20);
SP(P_NAME, "Dantes boeses Ich");

SetProp(P_HANDS, ({" mit purer Boesartigkeit",200+random(100),DT_TERROR}));
SetProp(P_BODY, 100+random(20));//hands kommt bei rate 99 eh net wirklich
SetProp(P_SIZE, 10000);
SetProp(P_ALIGN, -1000);
SetProp(P_MAX_HANDS, 2);
SetProp( P_RESISTANCE_STRENGTHS,([DT_HOLY: 0.3, DT_TERROR:-1.0, DT_BLUDGEON:-1.0]));
SUID;
//CLONEME("d/dschungel/dante/geist/armour/boesepanzer");

SetProp(P_HEAL,0);
SetProp(P_AGGRESSIVE,0);
SetProp(P_WIMPY, 0);
SetProp(P_NOMAGIC,0);
SetProp(P_NOCORPSE, 1);
SetProp(P_MSGIN, "entsteht aus dunkler Materie");
SetProp(P_MSGOUT, "verschwindet");
SetProp(P_MMSGIN, "entsteht aus dunkler Materie");
SetProp(P_MMSGOUT, "verschwindet");



SetProp(P_SPELLRATE,75);//austeten


AddSpell(1,1,
"Dantes boeses Ich sieht sich Deine Fuesse genauer an.\n",
"Dantes boeses Ich sieht sich @WESSEN Fuesse genauer an.\n",
DT_MAGIC, "spell_fuesse");

AddSpell(1,1,
"Dantes boeses Ich sieht sich Deine Haende genauer an.\n",
"Dantes boeses Ich sieht sich @WESSEN Haende genauer an.\n",
DT_MAGIC, "spell_haende");


AddSpell(1,1,
"Dantes boeses Ich sieht sich Deine Beine genauer an.\n",
"Dantes boeses Ich sieht sich @WESSEN Beine genauer an.\n",
DT_MAGIC, "spell_beine");


AddSpell(1,1,
"Dantes boeses Ich sieht sich Deine Arme genauer an.\n",
"Dantes boeses Ich sieht sich @WESSEN Arme genauer an.\n",
DT_MAGIC, "spell_arme");


AddSpell(1,1,
"Dantes boeses Ich sieht sich Deinen Kopf genauer an.\n",
"Dantes boeses Ich sieht sich @WESSEN Kopf genauer an.\n",
DT_MAGIC, "spell_kopf");



AddSpell(1,1,
"Dantes boeses Ich wirft einen Blick auf Deinen Oberkoerper.\n",
"Dantes boeses Ich sieht sich @WESSEN  Oberkoerper genauer an.\n",
DT_MAGIC, "spell_oberkoerper");





SetChats(3,({
"Dantes boeses Ich schweigt, doch das Schweigen macht Dir Angst!\n",
"Dantes boeses Ich macht keine Bewegegung, doch du zitterst.\n",
"ANGST STEIGT IN DIR HOCH!\n",
"Dantes boeses Ich sieht Dir tief in die Augen.\n",
"Dantes boeses ich bleibt stummt.\n",
"Dantes boeses ich deutet in die ewige Dunkelheit.\n"}));

AI(DEFAULT_INFO,({
"schweigt stummt.\n",
"deutet nur in die ewige Dunkelheit.\n",
"sieht Dir nur tief in die Augen.\n",
"erkennt Dein wahres Ich.\n"}));


}

void spell_kopf(object enemy,int damage,mixed dam_type) {
object rue;
rue=present("BAD_HELMET", enemy);

if(rue->QueryProp(P_WORN)) {
tell_object(enemy,
"Dein Kopf juckt leicht, doch Dein Helm schuetzt Dich vor der dunklen Materie.\n");
  }
else
tell_object(enemy,
"Dein Kopf beginnt zu rotieren und explodiert dann!\n");
enemy->Defend(5000, DT_TERROR,([SP_SHOW_DAMAGE:1]));  }


void spell_fuesse(object enemy,int damage,mixed dam_type) {
object rue;
rue=present("BAD_SHOES", enemy);
if(rue->QueryProp(P_WORN)) {
tell_object(enemy,
"Deine Fuesse brennen leicht, doch Deine Stiefel schuetzen Dich vor der dunklen Materie.\n");
 }

else
tell_object(enemy,
"Deine Fuesse entzuenden sich explosionsartig und Du bruellst auf!\n");
enemy->Defend(1000, DT_TERROR,([SP_SHOW_DAMAGE:1]), enemy);  }



void spell_arme(object enemy,int damage,mixed dam_type) {
object rue;
rue=present("BAD_BRACERS", enemy);
if(rue->QueryProp(P_WORN)) {
tell_object(enemy,
"Deine Arme brennen leicht, doch Deine Schienen schuetzen Dich vor der dunklen Materie.\n");
  }
else
tell_object(enemy,
"Deine Arme lodern hell auf!\n");
enemy->Defend(1000, DT_TERROR,([SP_SHOW_DAMAGE:1]));  }



void spell_beine(object enemy,int damage,mixed dam_type) {
object rue;
rue=present("BAD_TROUSER", enemy);
if(rue->QueryProp(P_WORN)) {
tell_object(enemy,
"Deine Beine brennen leicht, doch Deine Hose schuetzt Dich vor der dunklen Materie.\n");
 }
else
tell_object(enemy,
"Deine Beine entzuenden sich explosionsartig und Du bruellst auf!\n");
enemy->Defend(1000, DT_TERROR,([SP_SHOW_DAMAGE:1]));  }


void spell_oberkoerper(object enemy,int damage,mixed dam_type) {
object rue;
rue=present("BAD_PANZER", enemy);
if(rue->QueryProp(P_WORN)) {
tell_object(enemy,
"Dein Oberkoerper zuckt leicht, doch Dein Panzer schuetzt Dich vor der dunklen Materie.\n");
  }
else
tell_object(enemy,
"Dein Oberkoerper explodiert beinahe!!!\n");
enemy->Defend(1000, DT_TERROR,([SP_SHOW_DAMAGE:1]));  }


void spell_haende(object enemy,int damage,mixed dam_type) {
object rue;
rue=present("BAD_GLOVE", enemy);
if(rue->QueryProp(P_WORN)) {
tell_object(enemy,
"Deine Haende brennen leicht, doch Deine Handschuhe schuetzen Dich "
"vor der dunklen Materie.\n");
  }
else
tell_object(enemy,
 "Deine Haende brennen und verkohlen fast!\n");
 enemy->Defend(1000, DT_TERROR,([SP_SHOW_DAMAGE:1])); }



_query_info() {
write(BSA(
"Normalerweise sollte Ich Dich in den Tod laufen lassen, aber, naja "
"fuer Dich mache ich eine Ausnahme. Huete Dich vor meinem "
"boesem Ich. Ohne Vorbereitung wird es Dich in Sekunden toeten!"
"Dantes boeses Ich ist DAS Boese schlechthin!",
"Dante teilt Dir mit: "));
return ;
}


Defend(int dam, string dtype, mixed spell, object enemy)
{
if (!pointerp(dtype))
dtype = ({ dtype });

if (sizeof(dtype & ({ DT_TERROR }) ))
{

tell_object(enemy,
"Das Boese ich lenkt Deinen Angriff auf Dich um!\n");
enemy->Defend(dam, DT_TERROR, ([SP_SHOW_DAMAGE:1]));

return ::Defend(0, dtype, spell, enemy);

}

return ::Defend(dam, dtype, spell, enemy);
}



void NotifyPlayerDeath(object player, object killer, int lostexp)
{
 command("nimm alles aus leiche");
 write_file("/d/dschungel/dante/geist/log/boesesich",
 ctime()+": Das Boeseich hat "+CAP(getuid(PL))+" umgebracht.\n");
}

die(arg)
{
write(BS(
"Dantes boeses Ich bruellt auf und verschwindet in der ewigen Dunkelheit!\n"));

shout("Du hoerst ein Toben und Bruellen aus dem Reich der Daemone!\n"
""+CAP_TPN+" hat Dantes Boeses Ich vertrieben!\n");
shout("Dantes boeses Ich bruellt: Bald komme ich wieder und hole "+TPN+"!\n");
write_file("/d/dschungel/dante/geist/log/boesesich",
ctime()+": Das Boeseich wurde von "+CAP(getuid(PL))+" umgebracht.\n");
::die(arg);
}


