
inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <combat.h>
#include <new_skills.h>
#include <mnpc.h>
#include "/players/dante/myowndefine.h"



init(){
::init();
if((interactive(TP)&&(TP->QueryProp(P_ALIGN)>300)) ){
if(!present("D_NO", TP))  {
TO->Kill(TP);}
}}

void create()
{

if (!is_clone(TO)) return;
::create();

SetProp(P_SHORT, "Ein gefluegelter Daemon");
SetProp(P_LONG, BS(
"Dieser Daemon hat am Ruecken zwei grosse Fluegel, mit denen er durch diese "
"duestere Dimension segelt. Mit ihm Schritt zu haten, ist fuer Dich kaum moeglich!"));
SetProp(P_NAME,"Daemon");
SP(P_NAME_ADJ, "gefluegelt");
SetProp(P_GENDER, MALE);
AddId(({"gefluegelter daemon","daemon"}));
SetProp(P_ARTICLE, 1);
SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10, T_RANGE_MAX: 45]));
create_default_npc(15+random(2));
SetProp(P_HANDS, ({" mit seinen Krallendluegeln", 150+random(50),DT_RIP}));
SetProp(P_BODY, 40+random(20));
SetProp(P_SIZE, 200);
SP(P_MAX_HP, 400+random(100));
SetProp(P_ALIGN, -500);
SetProp(P_MAX_HANDS, 2);
SetProp(P_INFO, "Dieser Daemon ist blitzschnell\n");
SetProp( P_RESISTANCE_STRENGTHS,([DT_HOLY: 0.3, DT_TERROR:-1.0,
 DT_BLUDGEON:-1.0, DT_FIRE:0.5, DT_COLD:-0.5]));
SUID;
CLONEME("d/dschungel/dante/geist/obj/flucht");

SetProp(P_HEAL,10);
SetProp(P_AGGRESSIVE, 0);
SetProp(P_WIMPY, 200);
SetProp(P_NOMAGIC,5);
SetProp(P_NOCORPSE, 0);
SetProp(P_MSGIN, "segelt bruellend herein");
SetProp(P_MSGOUT, "segelt kreischen");
SetProp(P_MMSGIN, "taucht ploetzlich auf");
SetProp(P_MMSGOUT, "verschwindet");

SetProp(P_MNPC_AREA, ("/d/dschungel/dante/geist/room/"));
SetProp(P_MNPC_FLAGS, MOV_MOVES+MOV_BACKWARDS+
MOV_INFIGHT+MOV_INDOORS +MOV_OUTDOORS+MOV_SPECIAL);

SetProp(P_MNPC_WAIT, ({1, 1, 1}));//pure absicht
//so schnell, dass er kaum zu erschlagen ist
//dafuer body mies
SetProp(P_MNPC_DEFAULTROOM, "d/dschungel/dante/geist/room/geist17");
SetProp(P_MURDER_MSG, "Ich fliege direkt zu Lars!!!");
SetProp(P_KILL_NAME, "Ein gefluegelter Daemon");
SetProp(P_KILL_MSG, "Das naechste Mal musst Du wohl etwas schneller sein!");
SetProp(P_MSG_FLAGS, ([P_KILL_MSG:1, P_MURDER_MSG:1 ]));




SetProp(P_SPELLRATE,60);


AddSpell(3,200,
"Der gefluegelte Daemon hackt von oben auf Dich ein.\n",
"Der  gefluegelte Daemon hackt von oben auf @WEN ein.\n",
DT_PIERCE, ([SP_SHOW_DAMAGE:1]));


AddSpell(1,300,
"Der gefluegelte Daemon rammt Dich um.\n",
"Der  gefluegelte Daemon rammt @WEN um.\n",
DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));



AddSpell(1,100,
"Der gefluegelte Daemon packt Dich, traegt Dich davon und lasst Dich dann fallen.\n",
"Der  gefluegelte Daemon packt Dich und traegt @WEN davon.\n",
DT_MAGIC, "spell_weg");

SetChats(15,({
"Der gefluegelte Daemon segelt um Dich herum.\n",
"Der gefluegelte Daemon landet kurz neben Dir.\n",
"Der gefluegelte Daemon bruellt schrecklich.\n",
"Der gefluegelte Daemon schaut Dich schief an.\n",
"Der gefluegelte Daemon schlaegt mit seinen Fluegeln.\n",
"Der gefluegelte Daemon segelt nach oben.\n",
"Der gefluegelte Daemon segelt nach unten.\n"}));


AddInfo(({"dante"}),
"Der ist das allerschlimmste Monster dieser Dimension und ueberhaupt!",
"sagt zitternd: ");
AddInfo("daemon",
"Ich bin einer...", "lacht: ");

}



void spell_away(object enemy,int damage,mixed dam_type)
{
if(!random(3)) {
switch(random(5))  {
case 0..7:
enemy->move("d/dschungel/dante/geist/room/g78", M_TPORT+M_SILENT);
break;
case 8:
enemy->move("d/dschungel/dante/geist/room/kneipe", M_TPORT+M_SILENT);
break;
case 9:
enemy->move("d/dschungel/dante/weg/room/brunnen2", M_TPORT+M_SILENT);
break;
default: enemy->do_damage(10);
}  }
else
tell_object(enemy,
"Der gefluegelte Daemon schafft es nicht Dich wegzutragen!\n");
}




Defend(int dam, string dtype, mixed spell, object enemy)
{

if(getuid(enemy)=="daemonenjaeger")  {
return -1000;   }

if (!pointerp(dtype))
dtype = ({ dtype });

if (sizeof(dtype & ({ DT_BLUDGEON }) ))
{

tell_object(enemy,
"Dein Angriff zerschmettert dem gefluegelte Daemon die Fluegel.\n");
return ::Defend(dam*2, dtype, spell, enemy);

}

if (sizeof(dtype & ({ DT_TERROR }) ))
{
tell_object(enemy,
"Der gefluegelte Daemon weicht geschickt aus.\n");
heal_self(dam);
return ::Defend(0, dtype, spell, enemy);
}
return ::Defend(dam, dtype, spell, enemy);
}



void NotifyPlayerDeath(object player, object killer, int lostexp)
{
write_file("/d/dschungel/dante/geist/log/flued",
ctime()+": Der Fluedaem hat "+CAP(getuid(PL))+" umgebracht.\n");
}

die(arg)
{
write_file("/d/dschungel/dante/geist/log/flued",
ctime()+": Der Fluedam wurde von "+CAP(getuid(PL))+" umgebracht.\n");

::die(arg);
}
