inherit "std/npc";
#include "/players/dante/myowndefine.h"
#include <properties.h>
#include <language.h>
#include <moving.h>
#include <combat.h>
#include <new_skills.h>
#include <npc.h>


void create()
{


if (!is_clone(TO)) return;
::create();
SetProp(P_SHORT, "Ein grauer Steindaemon");
SetProp(P_LONG, BS(
"Dieser Daemon ist aus purem Stein. Sein Panzer ist steinhart und ebenso sein Herz. "
"Stumm blickt er Dich an und denkt sich sicher nichts gutes ueber Dich."));
SetProp(P_NAME,"Steindaemon");
SetProp(P_GENDER, MALE);
SP(P_NAME_ADJ, "grau");
AddId(({"steindaemon","daemon"}));
SetProp(P_ARTICLE, 1);
SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10, T_RANGE_MAX: 45]));
create_default_npc(15);
SetProp(P_HANDS, ({" mit seinen steinernen Krallen",
200,DT_RIP}));
SetProp(P_BODY, 90);
SetProp(P_SIZE, 250);
SetProp(P_ALIGN, 500);
SetProp(P_MAX_HANDS, 2);
SetProp(P_INFO, "Der Steindaemon bewacht etwas...\n");
SetProp( P_RESISTANCE_STRENGTHS,([DT_FIRE: -1.0, DT_TERROR:1.0,
DT_BLUDGEON:-0.3, DT_MAGIC:-0.5, DT_WATER:0.4, DT_COLD:-0.5]));

SetProp(P_HEAL,0);
SetProp(P_AGGRESSIVE, 0);
SetProp(P_WIMPY, 0);
SetProp(P_NOMAGIC, 0);
SetProp(P_NOCORPSE, 1);
SetProp(P_MSGIN, "kommt auf der Jagd nach Dir herein");
SetProp(P_MSGOUT, "stuermt");
SetProp(P_MMSGIN, "entsteht aus einer Steinwolke");
SetProp(P_MMSGOUT, "verschwindet");

SetProp(P_MURDER_MSG, "Der Steindaemon zerfaellt zu Staub");
SetProp(P_KILL_NAME, "Der steinigste aller Daemone");
SetProp(P_KILL_MSG, "Ich fresse nicht nur Steine!");
SetProp(P_MSG_FLAGS, ([P_KILL_MSG:1, P_MURDER_MSG:1 ]));




SetChats(5,({
"Der Steindaemon sagt: He! Du hau ab!\n",
"Der Steindaemon grinst steinig.\n",
"Der Steindaemon sagt: Weg von meinem Boden!\n",
"Der Steindaemon begutachtet den Boden!\n",
"Der Steindaemon sagt: Wo ist nur meine Daemonenhacke!\n"
}));


AI("stein",
"Der ist nichts fuer Dich!", "sagt: ");
AI("boden",
"Der Boden ist mein! Hau ab!", "sagt: ");
AddInfo(({"hacke","daemonenhacke"}),
"Die habe ich irgendwo verloren, aber wo. Bring sie mir wieder!",
"lacht verlogen: ");


SetProp(P_SPELLRATE,70);

SUID;

//command("zieh alles an");
//command("zuecke morgenstern");


AddInfo(DEFAULT_INFO,({
"lacht wissend.\n",
"grinst bloed.\n",
"sagt: Du bist doch bloed wie eine Semmel!\n",
"sagt: Du musst bei der Statue lange stehen bleiben!\n"}));




AddSpell(4,100+random(100),
"Der Steindaemon schlaegt hart auf Dich ein!\n",
"Der Steindaemon schlaegt hart auf @WEN ein.\n",
DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));


AddSpell(1,200+random(100),
"Der Steindaemon schlaegt extrem hart auf Dich ein!\n",
"Der Steindaemon schlaegt extrem hart auf @WEN ein.\n",
DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));

ACD(({"brich","breche"}), "no", 1);

}

int no() {
write("Der Steindaemon schlaegt Dich nieder!\n");
TP->do_damage(10); return 1;  }


Defend(int dam, string dtype, mixed spell, object enemy)
{
if (!pointerp(dtype))
dtype = ({ dtype });


if (sizeof(dtype & ({ DT_TERROR }) ))
{

tell_room(environment(),
"Der Steindaemon lacht Dich aus!!!!\n");
heal_self(dam);
return ::Defend(0, dtype, spell, enemy);

}


if (sizeof(dtype & ({ DT_BLUDGEON }) ))
{

tell_room(environment(),
"Dein Angriff prallt vom Steindaemon ab und trifft Dich selbst.\n");
heal_self(dam);
enemy->Defend(dam, DT_TERROR, ([SP_SHOW_DAMAGE:1]));
return ::Defend(0, dtype, spell, enemy);
}
return ::Defend(dam, dtype, spell, enemy);
}



void NotifyPlayerDeath(object player, object killer, int lostexp)
{
write_file("/d/dschungel/dante/geist/log/steindaemon",
ctime()+": Steindaemon hat "+CAP(getuid(PL))+" umgebracht.\n");
}

die(arg)
{
write_file("/d/dschungel/dante/geist/log/steindaemon",
ctime()+": Steindaem wurde von "+CAP(getuid(PL))+" umgebracht.\n");
::die(arg);
}


