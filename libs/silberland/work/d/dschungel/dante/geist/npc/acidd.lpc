inherit "/std/mnpc";

#include <combat.h>
#include <moving.h>
#include <properties.h>
#include "/players/dante/myowndefine.h"
#include <new_skills.h>
#include <mnpc.h>

void create()
{
if (!is_clone(TO)) return;
::create();
SetProp(P_SHORT, "Ein gifttiggruener Saeuredaemon");

SP(P_LONG, BS(
"Dieser Daemon besteht aus einer schwankenden Masse purer Saeure. "
"Gruen und giftig grinst er Dich an, bereit Dich sofort aufzuloesen!"));
SetProp(P_NAME,"Saeuredaemon");
SP(P_NAME_ADJ, "giftiggruen");
SetProp(P_GENDER, MALE);
AddId(({"daemon","saeuredaemon"}));
SetProp(P_ARTICLE, 1);
SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:20, T_RANGE_MAX: 40]));
create_default_npc(18+random(3));
SetProp(P_HANDS, ({" mit seinen Saeureklauen",222,({DT_TERROR,DT_ACID})}));
SetProp(P_BODY, 40+random(10));
SetProp(P_SIZE, 260+random(200));
SetProp(P_ALIGN, -500);
SetProp(P_MAX_HANDS, 2);
SetProp( P_RESISTANCE_STRENGTHS,
([DT_HOLY: 0.3,DT_UNHOLY:-1.0, DT_TERROR:-1.0, DT_FIRE:-1.0, DT_BLUDGEON:-1.0,
DT_SLASH:-0.5, DT_WHIP:0.4,DT_COLD:0.6, DT_AIR:-0.6, DT_RIP:-0.7,
 DT_PIERCE:-0.7,DT_LIGHTNING:-1.0, DT_ELECTRIC:-1.0]));

SetProp(P_HEAL, 0);
SetProp(P_AGGRESSIVE, 0);
SetProp(P_WIMPY, 0);
SetProp(P_NOMAGIC,3);
SetProp(P_NOCORPSE, 1);
SetProp(P_MSGIN, "fliesst herein");
SetProp(P_MSGOUT, "fliesst davon");
SetProp(P_MMSGIN, "taucht ploetzlich aus einer Saeurewolke auf");
SetProp(P_MMSGOUT, "verschwindet in einem Loch");
SetProp(P_MNPC_AREA, ("/d/dschungel/dante/geist/room/geist"));
SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES+
MOV_BACKWARDS+ MOV_INFIGHT );

SetProp(P_MNPC_WAIT, ({10, 20, 20}));
SetProp(P_MNPC_DEFAULTROOM, "d/dschungel/dante/geist/room/g55");





SetProp(P_MURDER_MSG, "Die Rache ist unser, elender Sterblicher!!!");
SetProp(P_KILL_NAME, "Ein Saeuredaemon");
SetProp(P_KILL_MSG, "Ihr elenden Sterblichen, Eure Tage sind gezaehlt! "
"Ich zersetze Euch alle!!!");
SetProp(P_MSG_FLAGS, ([P_KILL_MSG:1, P_MURDER_MSG:1 ]));



SetProp(P_SPELLRATE,60);


AddSpell(4,200,
"Der Saeuredaemon schleudert einen Saeureball nach Dir.\n",
"Der Saeuredaemon schleudert einen Saeureball nach @WEM.\n",
 DT_ACID, ([SP_SHOW_DAMAGE:1]));

AddSpell(2, 300,
"Der Saeuredaemon umhuellt Dich mit einer Saeurewolke!\n",
"Der Saeuredaemon umhuellt @WEN mit einer Saeurewolke!\n",
DT_ACID, ([SP_SHOW_DAMAGE: 1]));

AddSpell(1, 400,
"Der Saeuredaemon sprueht Saeure in Deine Augen!\n",
"Der Saeuredaemon sprueht Saeure in @WESSEN Augen!\n",
DT_ACID, ([SP_SHOW_DAMAGE: 1]));

SetChats(10,({
"Der Saeuredaemon stiert Dich an.\n",
"Der Saeuredaemon bruellt Dich an.\n",
"Du fuehlst Dich sehr schlecht hier neben dem Saeuredaemon.\n",
"Der Saeuredaemon sagt: Ich werde Dich zersetzen!\n",
"Der Saeuredaemon grinst Dich boesartig an!\n",
"Dante kommt herein.\n",
"Der Saeuredaemon lacht Dich aus!\n"}));

}

Defend(int dam, string dtype, mixed spell, object enemy)
{
if (!pointerp(dtype))
dtype = ({ dtype });


if (sizeof(dtype & ({ DT_TERROR }) ))
{

tell_room(environment(),
"Der Saeuredaemon lacht Dich aus!!!\n");
heal_self(dam);
return ::Defend(0, dtype, spell, enemy);

}

if (sizeof(dtype & ({ DT_ACID }) ))
{
tell_object(enemy,
"Der Saeuredaemon staerkt sich durch Deinen dummen Angriff.\n"
"Saeurestrahlen schiessen aus dem Daemon direkt auf Dich zu!!!\n");
 enemy->Defend(200+random(100), DT_ACID, ([SP_SHOW_DAMAGE: 1]));
tell_room(environment(TO),
""+enemy->name()+" wird von Saeurestrahlen getroffen!\n", ({enemy}));

heal_self(1000);

return ::Defend(0, dtype, spell, enemy);
}

return ::Defend(dam, dtype, spell, enemy);
}
