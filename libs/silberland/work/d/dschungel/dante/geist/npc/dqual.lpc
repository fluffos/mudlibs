
inherit "std/npc";
#include <combat.h>
#include <properties.h>
#include <language.h>
#include <new_skills.h>
#include "/players/dante/myowndefine.h"
#include <moving.h>

create()
{
::create();
SetProp(P_NAME, "Daemon");
SP(P_NAME_ADJ, "gequaelt");
SetProp(P_GENDER, MALE);
SetProp(P_SIZE, 200);
SetProp(P_SHORT, "Ein Daemon der Qualen");
SetProp(P_LONG,BS(
"Dieser arme Daemon wurde von seinem Erschaffer gezwungen sich selbst "
"fuer alle Ewigkeit seine scharfen Krallen in den Leib zu rammen und sich "
"so selbst zu quaelen. Die Eingeweide haengen aus ihm heraus, Du ekelst Dich!"));
AD("eingeweide",
"Sie haengen aus dem offenen Daemon heraus.");
AD("leib",
"Sein Leib ist zerfetzt und blutverschmiert.");
AD(({"krallen","kralle"}),
"Scharf und gefaehrlich!");

AddId(({"daemon", "gequaelter daemon"}));
create_default_npc(15);
SP(P_BODY, 40);
SP(P_AGGRESSIVE,  0);
SetProp(P_ALIGN, -500);

SetProp(P_RESISTANCE_STRENGTHS, ([
DT_BLUDGEON: -0.5, DT_SLASH: -0.5, DT_RIP:-0.5,
DT_PIERCE:0.5, DT_WHIP:0.8, DT_TERROR:-1.0,
DT_UNHOLY:-1.0, DT_COLD:-0.7, DT_HOLY:0.6]));

SP(P_INFO,
"Der Daemon will erloest werden...");
SetProp(P_HANDS, ({" mit seinen Daemonenkrallen ", 130, DT_TERROR}));
SetProp(P_DIE_MSG, " bruellt erloest auf!\n");
SetProp(P_NOCORPSE, 0);
SetProp(P_DEFAULT_INFO,"bruellt gepeinigt auf.\n");
SP(P_SPELLRATE, 40);

AddSpell(1, 100,
"Der gequaelte Daemon schlaegt seine Krallen in Dich!\n",
"Der gequaelte Daemon schlaegt seine Krallen in @WEN!\n",
DT_RIP, ([SP_SHOW_DAMAGE:1]));

}

die(arg)  {
object ob;
ob=clone_object("d/dschungel/dante/geist/armour/badbracers");
ob->move(TP, M_GET);
write("Der Daemon bedankt sich bei Dir in dem er Dir sterbend etwas zuwirft.\n");
::die(arg); }

Defend(int dam, string dtype, mixed spell, object enemy)
{

if(getuid(enemy)=="daemonenjaeger")  {
return -1000;   }
//die daemonen und ihre jaeger sollen sich ja nicht echt schaden...



if (!pointerp(dtype))
dtype = ({ dtype });


if (sizeof(dtype & ({ DT_TERROR }) ))
{

tell_room(environment(),
"Der gequaelte Daemon lacht Dich aus!!!!\n");
heal_self(dam);
return ::Defend(0, dtype, spell, enemy);

}

return ::Defend(dam, dtype, spell, enemy);
}

