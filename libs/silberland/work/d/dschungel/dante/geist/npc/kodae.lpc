inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <combat.h>
#include <new_skills.h>
#include <mnpc.h>
#include "/players/dante/myowndefine.h"

void create()
{
if (!is_clone(TO)) return;
::create();
SetProp(P_SHORT, "Ein kopfloser Daemon");
SP(P_LONG, BS(
"Dieser Daemon ist eine arme Kreatur. Sein Erschaffer hat "
"ihm seinen Kopf abgeschlagen und nun laeuft er kopflos "
"herum und sucht seinen Kopf."));

SetProp(P_NAME,"Daemon");
SP(P_NAME_ADJ, "kopflos");
SetProp(P_GENDER, MALE);
AddId(({"daemon","kopfloser daemon"}));
SetProp(P_ARTICLE, 1);
SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10, T_RANGE_MAX: 45]));
create_default_npc(10+random(2));
SetProp(P_HANDS, ({" seinen Krallen",50+random(50),DT_BLUDGEON}));
SetProp(P_BODY, 40+random(10));
SetProp(P_SIZE, 160+random(20));
SetProp(P_ALIGN, -500);
SetProp(P_MAX_HANDS, 2);
SetProp( P_RESISTANCE_STRENGTHS,([DT_BLUDGEON:1.0, DT_HOLY: 0.3,DT_UNHOLY:-1.0, DT_TERROR:-1.0]));
SP(P_INFO, "Hmm, vielleicht kannst Du dem Daemon ja helfen?!\n");
SetProp(P_HEAL,-5);
SetProp(P_AGGRESSIVE, 0);
SetProp(P_WIMPY, 30);
SetProp(P_NOMAGIC,0);
SetProp(P_NOCORPSE, 1);
SetProp(P_MSGIN, "steht ploetzlich kopflos vor Dir");
SetProp(P_MSGOUT, "irrt kopflos");
SetProp(P_MMSGIN, "taucht ploetzlich auf");
SetProp(P_MMSGOUT, "verschwindet");

SetProp(P_MNPC_AREA, ("/d/dschungel/dante/geist/room/"));
SetProp(P_MNPC_FLAGS, MOV_MOVES+MOV_BACKWARDS+
MOV_INFIGHT+MOV_INDOORS +MOV_OUTDOORS+MOV_SPECIAL);
SetProp(P_MNPC_WAIT, ({1, 10, 10}));
SetProp(P_MNPC_DEFAULTROOM, "d/dschungel/dante/geist/room/geist23");




AI("kopf",
"Den hat mir Dante abgeschlagen! Solltest Du ihn finden, "
"bring mir ihn.", "sagt: ");
AI("dante",
"Der !%&%$&/(& hat mir meinen Kopf abgeschlagen!", "sagt: ");



SetProp(P_MURDER_MSG, "Die Rache ist unser, elender Sterblicher!!!");
SetProp(P_KILL_NAME, "Der Kopflose aus der Armee der Daemonen");
SetProp(P_KILL_MSG, "Ihr elenden Sterblichen, Eure Tage sind gezaehlt!");
SetProp(P_MSG_FLAGS, ([P_KILL_MSG:1, P_MURDER_MSG:1 ]));
SetProp(P_SPELLRATE, 60);

AddSpell(4,100,
"Der kopflose Daemon versucht Dich zu treffen!\n",
"Der kopflose Daemon versucht @WEN zu treffen.\n",
DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));
AddSpell(2,200,
"Der kopflose Daemon schlaegt wild nach Dir.\n",
"Der kopflose Daemon schlaegt wild nach @WEM\n",
DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));

AI("trintrasil",
"Naja, ein Seicherl durch und durch!", "sagt grinsend: ");
SetChats(10,({
"Der kopflose Daemon sagt: Wo ist denn nur mein Kopf!\n",
"Der kopflose Daemon sagt: Kopf ab!\n",
"Der kopflose Daemon sagt: Trintrasil is ja sooo doof!\n",
"Der kopflose Daemon: Hilfe! Wo bin ich hier!\n",
"Der kopflose Daemon: He! Du! Dein Kopf rollt davon!\n",
"Der kopflose Daemon grinst Dich boesartig an!\n",
"Der kopflose Daemon lacht Dich aus!\n"}));
}
Defend(int dam, string dtype, mixed spell, object enemy)
{
if (!pointerp(dtype))
dtype = ({ dtype });


if (sizeof(dtype & ({ DT_TERROR }) ))
{

tell_room(environment(),
"Der kopflose Daemon lacht Dich aus!!!!\n");
heal_self(dam);
return ::Defend(0, dtype, spell, enemy);

}

return ::Defend(dam, dtype, spell, enemy);
}

void give_notify(object ob)  {
object glove;

if((ob->id("DKOPF"))) {
write(BSA(
""+CAP_TPN+", ich danke Dir. Dafuer gebe ich Dir etwas, dass Du gut "
"gebrauchen kannst. Hier hast Du! Und nun hau ab!",
"Der kopflose Daemon sagt: "));
write(BS(
"Dann setzt er sich den Kopf auf, doch der Kopf faellt "
"einfach wieder ab und rollt polternd davon."));
glove=clone_object("d/dschungel/dante/geist/armour/badglove");
glove->move(TP, M_GET);


ob->remove();
}
::give_notify(ob);  }

