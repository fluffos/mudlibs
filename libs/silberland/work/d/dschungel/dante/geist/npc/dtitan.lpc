
inherit "std/npc";
#include <combat.h>
#include <properties.h>
#include <language.h>
#include <new_skills.h>
#include "/players/dante/myowndefine.h"
#include <moving.h>



create()
{
::create();
SetProp(P_NAME, "Titandaemon");
SetProp(P_GENDER, MALE);
SetProp(P_SIZE, 220);
SetProp(P_SHORT, "Ein Titandaemon");
SP(P_MATERIAL, ([MAT_TITANIUM:100]));
SetProp(P_LONG,BS(
"Der Titandaemon steht voellig ruhig und regungslos da. Er scheint nicht zu leben, oder "
"in eine Art Starre verfallen zu sein. Er besteht aus einem extrem harten Material, "
"dem so leicht nichts gewachsen ist."));


AddId(({"daemon", "titandaemon"}));
create_default_npc(11+random(2));
SP(P_BODY, 300);
SP(P_AGGRESSIVE, 0.01);
SetProp(P_ALIGN, -500);
SetProp(P_RESISTANCE_STRENGTHS, ([
DT_BLUDGEON: -1.0, DT_SLASH:-1.0, DT_RIP:-1.0,
DT_PIERCE:-1.0, DT_WHIP:-1.0, DT_TERROR:-1.0,
DT_UNHOLY:-1.0, DT_COLD:-1.0, DT_HOLY:-1.0]));


SP(P_INFO,
"Das Material aus dem der Titandaemon besteht ist haerter als alles andere!\n");
SetProp(P_HANDS, ({" mit seinen titanenen Daemonenkrallen", 140, DT_TERROR}));
SetProp(P_DIE_MSG, " zerfaellt in 1000 kleine Stuecke.\n");
SetProp(P_NOCORPSE, 1);
SetProp(P_DEFAULT_INFO,"bewegt sich nicht.\n");
SP(P_SPELLRATE, 50);


AddSpell(1, 100,
"Der Titandaemon erwacht kurz!\n",
"Der Titandaemon erwacht kurz!\n",
DT_MAGIC, "spell_waffe_weg");

}



spell_waffe_weg(object enemy,int damage,mixed dam_type)
{
object wp;
wp=enemy->QueryProp(P_WEAPON);
if(wp)
{
if(wp->QueryProp(P_CURSED))
return "";

wp->move(TO, M_GET);


tell_object(enemy,
"Als der Titandaemon erwacht reisst er Dir Deine Waffe aus der Hand!\n"
"Dann lacht Dich der Titandaemon aus.\n");
 TO->heal_self(1000);

tell_room(environment(TO), BS(
"Der Titandaemon entwaffnet "+enemy->name(WER)+"!\n"
"Dann lacht der Titandaemon "+enemy->name(WEN)+" aus!\n"),({enemy}));

enemy->StopHuntingMode();
this_object()->StopHuntingMode();
}


else



{
tell_object(enemy,
"Der Titandaemon sagt: "+enemy->name()+", stoere meine Totenstarre nicht!\n"
"Danach schlaegt er Dir extrem brutal ins Gesicht!\n");
enemy->Defend(200+random(100), DT_BLUDGEON, ([SP_SHOW_DAMAGE: 1]));


tell_room(environment(TO),BS(
"Der Titandaemon sagt: "+enemy->name()+", stoer mich nicht!\n"
"Danach tritt er "+enemy->name(WEN)+" nieder!\n"), ({enemy}));

enemy->StopHuntingMode();
TO->StopHuntingMode();

       }

      }


/*
d.h mit waffeis er nie umzuhauen....waffe weg-> er total geheilt
ohne waffe gehts, aber der spieler hat sicher schaden
und muss eben
immer wieder angreifen....
*/

Defend(int dam, string dtype, mixed spell, object enemy)
{

if(getuid(enemy)=="daemonenjaeger")  {
return -1000;   }

if (!pointerp(dtype))
dtype = ({ dtype });


if (sizeof(dtype & ({ DT_TERROR }) ))
{

tell_room(environment(),
"Der Titandaemon lacht Dich aus!!!!\n");
heal_self(dam);
return ::Defend(0, dtype, spell, enemy);

}
return ::Defend(dam, dtype, spell, enemy);
}

