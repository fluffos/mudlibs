inherit "std/npc";
#include "/players/dante/myowndefine.h"
#include <properties.h>
#include <language.h>
#include <moving.h>
#include <combat.h>
#include <new_skills.h>
#include <npc.h>


void create()
{


if (!is_clone(TO)) return;
::create();
SetProp(P_SHORT, "Ein schwarzer Stahlblock");
SetProp(P_LONG, BS(
"Der Block wurde aus haertestem Stahl geformt. Seine Oberflaeche ist rauh und "
"weist seltsame Schlitze und Oeffnungen auf."));

AD(({"oeffnungen","oeffnung"}),
"Hmm, man kann nichts genaues erkennen.");
AD(({"schlitz","schlitze"}),
"Die Schlitze scheinen sich zu bewegen.");
AD("oberflaeche",
"Die Oberflaeche scheint zu pulsieren.");



 SetProp(P_NAME,"Stahlblock");

SetProp(P_GENDER, MALE);
SP(P_NAME_ADJ, "schwarz");
AddId(({"stahlblock","daemon","block"}));
SetProp(P_ARTICLE, 1);
SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10, T_RANGE_MAX: 45]));
create_default_npc(15);
SetProp(P_HANDS, ({" mit seinen Stahlkrallen", 100,DT_RIP}));
SetProp(P_BODY, 500);
SetProp(P_SIZE, 25000);
SetProp(P_ALIGN, -500);
SetProp(P_MAX_HANDS, 2);
SetProp(P_INFO, "Der Stahlblock ist eine seltsame Lebensform, halb Metall, halb Daemon.\n");
SetProp( P_RESISTANCE_STRENGTHS,([DT_FIRE: -1.0, DT_TERROR:1.0,
DT_BLUDGEON:-0.3, DT_MAGIC:-0.5, DT_WATER:0.4, DT_COLD:-0.5]));

SetProp(P_HEAL,0);
SetProp(P_AGGRESSIVE, 0);
SetProp(P_WIMPY, 0);
SetProp(P_NOMAGIC, 0);
SetProp(P_NOCORPSE, 1);
SetProp(P_MSGIN, "kommt auf der Jagd nach Dir herein");
SetProp(P_MSGOUT, "stuermt");
SetProp(P_MMSGIN, "waechst aus dem Boden");
SetProp(P_MMSGOUT, "verschwindet im Boden");

SetProp(P_MURDER_MSG, "Der Stahldaemon zerfaellt zu Metallstaub");
SetProp(P_KILL_NAME, "Ein Stahldaemon");
SetProp(P_KILL_MSG, "Ich schweige!");
SetProp(P_MSG_FLAGS, ([P_KILL_MSG:1, P_MURDER_MSG:1 ]));





}

/*
_query_default_info()  {
write ("Frage jemand, der lebt.\n");  
  return "";}
*/

 _query_material() {       
 write("Der Stahlblock besteht aus Stahl, oder...\n");
 return ""; }
 
 


short(){
  if(!InFight())return "Ein grauer Stahlblock\n";
  else
    return "Ein Stahldaemon\n";
    }
    
    long(){
          if(!InFight())return QueryProp(P_LONG);
          else
  return "Der Stahlblock scheint ja doch ein Stahldaemon zu sein!\n";
          }
 
 InFight()  {
 SP(P_NAME, "Stahldaemon");
 
 }
          
          




Defend(int dam, string dtype, mixed spell, object enemy)
{
if (!pointerp(dtype))
dtype = ({ dtype });


if (sizeof(dtype & ({ DT_TERROR }) ))
{

tell_object(enemy,
"Der Stahlblock lacht Dich aus!!!!\n");
heal_self(dam);
return ::Defend(0, dtype, spell, enemy);

}


if (sizeof(dtype & ({ DT_BLUDGEON }) ))
{

tell_room(environment(TO),
""+enemy->name()+" wird von einem abprallenden Angriff getroffen!\n",
({enemy}));

tell_object(enemy,
"Dein Angriff prallt vom Stahlblock ab und trifft Dich selbst.\n");
heal_self(dam);
enemy->Defend(dam, DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));
return ::Defend(0, dtype, spell, enemy);
}
return ::Defend(dam, dtype, spell, enemy);
}



void NotifyPlayerDeath(object player, object killer, int lostexp)
{
write_file("/d/dschungel/dante/geist/log/stahl",
ctime()+": Stahl hat "+CAP(getuid(PL))+" umgebracht.\n");
}

die(arg)
{
write_file("/d/dschungel/dante/geist/log/stahl",
ctime()+": Stahl wurde von "+CAP(getuid(PL))+" umgebracht.\n");
::die(arg);
}


