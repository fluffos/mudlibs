inherit "/std/mnpc";

#include <combat.h>
#include <moving.h>
#include <properties.h>
#include "/players/dante/myowndefine.h"
#include <new_skills.h>
#include <mnpc.h>

void create()
{
if (!is_clone(TO)) return;
::create();
SetProp(P_SHORT, "Ein gruener Giftdaemon");

SP(P_LONG, BS(
"Dieser Giftdaemon besteht aus purem Gift. Er schleicht umher und sucht Opfer "
"die er mit seinem Gift toeten kann. Huete Dich!"));
SetProp(P_NAME,"Giftdaemon");
SP(P_NAME_ADJ, "gruen");
SetProp(P_GENDER, MALE);
AddId(({"daemon","giftdaemon"}));
SetProp(P_ARTICLE, 1);
SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:20, T_RANGE_MAX: 40]));
create_default_npc(14+random(3));
SetProp(P_HANDS, ({" mit seinen Giftklauen",130,({DT_TERROR,DT_POISON})}));
SetProp(P_BODY, 30+random(10));
SetProp(P_SIZE, 260+random(200));
SetProp(P_ALIGN, -500);
SetProp(P_MAX_HANDS, 2);
SetProp( P_RESISTANCE_STRENGTHS,
([DT_HOLY: 0.3,DT_UNHOLY:-1.0, DT_TERROR:-1.0, DT_FIRE:-1.0, DT_BLUDGEON:-1.0,
DT_SLASH:-0.5, DT_WHIP:0.4,DT_COLD:0.6, DT_AIR:-0.6, DT_RIP:-0.7
, DT_PIERCE:-0.7,DT_LIGHTNING:-1.0, DT_ELECTRIC:-1.0]));

SetProp(P_HEAL, 0);
SetProp(P_AGGRESSIVE, 0);
SetProp(P_WIMPY, 0);
SetProp(P_NOMAGIC,3);
SetProp(P_NOCORPSE, 1);
SetProp(P_MSGIN, "giftet herein");
SetProp(P_MSGOUT, "giftet davon");
SetProp(P_MMSGIN, "taucht ploetzlich aus einer Giftwolke auf");
SetProp(P_MMSGOUT, "verschwindet");
SetProp(P_MNPC_AREA, ("/d/dschungel/dante/geist/room/geist"));
SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES+
MOV_BACKWARDS+ MOV_INFIGHT );

SetProp(P_MNPC_WAIT, ({10, 5, 10}));
SetProp(P_MNPC_DEFAULTROOM, "d/dschungel/dante/geist/room/g43");





SetProp(P_MURDER_MSG, "Die Rache ist unser, elender Sterblicher!!!");
SetProp(P_KILL_NAME, "Ein Giftdaemon");
SetProp(P_KILL_MSG, "Ihr elenden Sterblichen, Eure Tage sind gezaehlt! "
"Ich vergifte Euch alle!!!");
SetProp(P_MSG_FLAGS, ([P_KILL_MSG:1, P_MURDER_MSG:1 ]));



SetProp(P_SPELLRATE,60);


AddSpell(8,200,
"Der Giftdaemon schleudert einen Giftball nach Dir.\n",
"Der Giftdaemon schleudert einen Giftball nach @WEM.\n",
DT_POISON, ([SP_SHOW_DAMAGE:1]));

AddSpell(4, 100,
"Der Giftdaemon umhuellt Dich mit einer Giftwolke!\n",
"Der Giftdaemon umhuellt @WEN mit einer Giftwolke!\n",
DT_POISON, "spell_gift");

SetChats(10,({
"Der Giftdaemon stiert Dich an.\n",
"Der Giftdaemon bruellt Dich an.\n",
"Du fuehlst Dich sehr schlecht hier neben dem Giftdaemon .\n",
"Der Giftdaemon sagt: Ich werde Dich vergiften!\n",
"Der Giftdaemon grinst Dich giftig an!\n",
"Giftige Daempfe kriechen herein!\n",
"Der Giftdaemon lacht Dich aus!\n"}));

}

spell_gift(object enemy,int damage,mixed dam_type)
{
switch(random(10))  {
case 0..4:
tell_object(enemy,
"Giftige Daempfe vergiften Dich!\n");
enemy->AddPoison(1+random(2));
break;
case 5..9:
tell_object(enemy,
"Du kannst Dich gerade noch vor den giftigen Daempfen retten.\n");
break;
default:write("BUG!\n");
}}



Defend(int dam, string dtype, mixed spell, object enemy)
{
if (!pointerp(dtype))
dtype = ({ dtype });


if (sizeof(dtype & ({ DT_TERROR }) ))
{

tell_room(environment(),
"Der Giftdaemon lacht Dich aus!!!\n");
heal_self(dam);
return ::Defend(0, dtype, spell, enemy);

}

if (sizeof(dtype & ({ DT_POISON }) ))
{
tell_object(enemy,
"Der Giftdaemon staerkt sich durch Deinen dummen Angriff.\n"
"Giftstrahlen schiessen aus dem Daemon direkt auf Dich zu!!!\n");
enemy->Defend(200+random(100), DT_POISON, ([SP_SHOW_DAMAGE: 1]));
tell_room(environment(TO),
""+enemy->name()+" wird von Giftstrahlen getroffen!\n", ({enemy}));
heal_self(1000);

return ::Defend(0, dtype, spell, enemy);
}

return ::Defend(dam, dtype, spell, enemy);
}


