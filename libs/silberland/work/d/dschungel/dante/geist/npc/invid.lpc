
inherit "std/npc";
#include <combat.h>
#include <properties.h>
#include <language.h>
#include <new_skills.h>
#include "/players/dante/myowndefine.h"
#include <moving.h>

void create()
{
if (!is_clone(TO)) return;
::create();
SetProp(P_SHORT, 0);
SetProp(P_LONG, BS(
"Du kannst das unbekannte Wesen nicht sehen, aber Du spuerst, dass etwas "
"Boesartiges und Bedrohliches ganz in Deiner Naehe ist. Sein heisser, stinkender "
"Atem dringt Dir in Mark und Bein!"));
SetProp(P_NAME, "Waechterdaemon");
SP(P_NAME_ADJ, "unsichtbar");
SetProp(P_GENDER, MALE);
AddId(({ "daemon","waechter","waechterdaemon" }));
create_default_npc(10+random(3));
SetProp(P_BODY, 60);
SetProp(P_HANDS, ({" unsichtbaren Klauen", 150,
({ DT_TERROR, DT_UNHOLY }) }));
SetProp(P_RACE, "Daemon");
SetProp(P_SIZE, 190+random(200));
SetProp(P_ALIGN, -950);
SetProp(P_MAX_HANDS, 2);
SetProp(P_AGGRESSIVE, 0);
SP(P_FRIEND, 1);
SetProp(P_WIMPY, 0);
SetProp(P_TRANSPARENT, 0);
SetProp(P_RESISTANCE_STRENGTHS, ([DT_UNHOLY: -0.9, DT_HOLY: 0.2, DT_WATER: 0.9]));
SetProp(P_NOCORPSE, 1);
SP(P_NOMAGIC, 0);
SP(P_SPELLRATE, 50);
SP(P_DEFEND_FUNC, TO);
AddSpell(3,250,
"Der unsichtbare Waechterdaemon taucht hinter Dir auf und tritt Dich !\n",
"Der unsichtbare Waechterdaemon taucht hinter @WEM auf und tritt @WEM!\n",
DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));



SetProp(P_DIE_MSG,  " verschwindet wider.\n");
ACD(({"untersuch","untersuche"}), "show", 1);
}
int show(string str)
{
if(!id(str)) return 0;

write(QueryProp(P_LONG));

return 1;
}

Defend(int dam, string dtype, mixed spell, object enemy)
{
switch(random(20))
{
case 0:
tell_object(enemy,
"Dein Angriff geht ins Leere. Du triffst den Waechterdaemon nicht.\n");
return ::Defend(0, dtype, spell, enemy);
break;
case 1..18:
return ::Defend(dam, dtype, spell, enemy);
break;
case 19:
tell_object(enemy,
"Dein Angriff trifft den Waechterdaemon nicht , sondern Dich selbst!!!\n");
enemy->do_damage(dam);
return ::Defend(0, dtype, spell, enemy);
break;
default: return ::Defend(dam, dtype, spell, enemy);
}
}


