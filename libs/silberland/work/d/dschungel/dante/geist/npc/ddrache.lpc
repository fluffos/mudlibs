//daemonendrache

inherit "/p/std/dragons/dragon";
#include "/players/dante/myowndefine.h"
#include <properties.h>
#include <language.h>
#include <combat.h> // fuer die damage types
#include <moving.h> // fuer REJECT_KEEP
#include <wizlevels.h>
#include <class.h>

create()
{ 
  if (!is_clone(this_object())) return;
  ::create();    
  create_default_dragon(3+random(2),8+random(2),0,22+random(9));

  AddId(({"drache","kronomortis", "daemonendrache"}));
  SetProp(P_LONG,BS(
"Der Daemonendrache Kronomortis ist eine Ausgeburt der Hoelle. Mit unheimlichen, "
"leeren Augen scheint er Dich zu durchdringen. Halb Daemon, halb Drache, kann "
"man nie wissen, was er vor hat."));
  SetProp(P_NAME, "Kronomortis");
 SetProp(P_SHORT, "Kronomortis, der Daemonendrache");
 SetProp(P_NAME_ADJ, 0);//muss so bleiben!!!
 SetProp(P_ARTICLE, 0);
    
 SetProp(P_RESISTANCE_STRENGTHS,([DT_BLUDGEON: 0.4,DT_FIRE: -0.5,
 DT_UNHOLY:-1.0, DT_HOLY:0.3, DT_RIP:-0.3, DT_PIERCE:-0.3,DT_TERROR:-1.0]));

SetProp(P_AGGRESSIVE, 0.1);

AddId(({"kronomortis","drache","daemonendrache"}));

set_living_name("daemonendrache");

  AddSpell(1,100,
   "Kronomortis, der Daemonendrache spuckt giftigen Schleim nach Dir!\n",
   "Kronomortis, der Daemonendrache spuckt giftigen Schleim nach @WEM!!\n",
              DT_POISON, "spell_gift");

  AddSpell(1,100,
   "Kronomortis, der Daemonendrache blickt Dir direkt in Deine Augen!\n",
   "Kronomortis, der Daemonendrache blickt Dir direkt in Deine Augen!\n",
              DT_POISON, "spell_blindalle");

/*
SUID;
CLONEME("d/unterwelt/dante/skel/knoring");
*/

}










 void spell_blindalle(object enemy, int damage, mixed dam_type)
    {
    int i;   
    object *inv;
    inv=PresentEnemies();
    
    if(!random(10))  {
              tell_room(ENV(ME), BS(
              "Kronomortis lacht wissend ueber seine Feinde!\n"));
                 for(i=sizeof(inv)-1;i>=0;i--)      {
                     tell_object(inv[i], "Deine Augen schmerzen heftig!\n");
                     inv[i]->SetProp(P_BLIND, 180);
                     } }
              else
             {    for(i=sizeof(inv)-1;i>=0;i--)      {
         tell_object(inv[i],
         "Du wendest Dich blitzschnell von Kronomortis ab!\n");  } }
               }
                                       


 void spell_gift(object enemy, int damage, mixed dam_type)
   {
   if(!random(8)) {
   tell_object(enemy,
   "Der giftige Schleim dringt tief in Deine Haut ein!\n");
   enemy->AddPoison(1+random(3));  }
   
   else
   tell_object(enemy,
   "Der giftige Schleim verfehlt Dich nur knapp.\n"); }
      
   
  
  _query_wimpy() { return 0;}
  
    
    
    
void die(int poisondeath)
{
  write_file("/d/dschungel/dante/geist/log/daemonendrache",
    ctime()+": "+CAP(getuid(TP))+" killt den Ddrachen.\n");
  if( !IS_LEARNER(TP) )
    domainshout(CAP(TP->query_real_name())+
        " hat Nekromortis, den Daemonendrachen bezwungen.\n");
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  write_file("/d/dschungel/dante/geist/log/daemonendrache",           
    ctime()+": Der Ddrache hat gerade "+CAP(getuid(player))+" umgebracht.\n");
command("nimm alles aus leiche");
}

