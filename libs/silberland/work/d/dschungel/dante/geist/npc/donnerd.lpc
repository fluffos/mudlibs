inherit "/std/mnpc";

#include <combat.h>
#include <moving.h>
#include <properties.h>
#include "/players/dante/myowndefine.h"
#include <new_skills.h>
#include <mnpc.h>




void create()
{
if (!is_clone(TO)) return;
::create();
SetProp(P_SHORT, "Ein runder Donnerdaemon");

SP(P_LONG, BS(
"Der Donnerdaemon ist ein plumpes, langsames Wesen, das nichts kann ausser "
"laut Bruellen und Krach zu machen. Aber das dafuer um so beeindruckender."));
SetProp(P_NAME,"Donnerdaemon");
SP(P_NAME_ADJ, "rund");
SetProp(P_GENDER, MALE);
AddId(({"daemon","donnerdaemon"}));
SetProp(P_ARTICLE, 1);
SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0, T_RANGE_MAX: 45]));
create_default_npc(15+random(3));
SetProp(P_HANDS, ({" mit lautem Bruellen",166,({DT_TERROR,DT_SOUND})}));
SetProp(P_BODY, 30+random(10));
SetProp(P_SIZE, 360+random(200));
SetProp(P_ALIGN, -500);
SetProp(P_MAX_HANDS, 2);
SetProp( P_RESISTANCE_STRENGTHS,
([DT_HOLY: 0.3,DT_UNHOLY:-1.0, DT_TERROR:-1.0, DT_FIRE:-1.0, DT_BLUDGEON:-1.0,
DT_SLASH:-0.5, DT_WHIP:0.4,DT_COLD:0.6, DT_AIR:-0.6, DT_RIP:-0.7
, DT_PIERCE:-0.7,DT_LIGHTNING:-1.0, DT_ELECTRIC:-1.0]));

SetProp(P_HEAL, 0);
SetProp(P_AGGRESSIVE, 0);
SetProp(P_WIMPY, 0);
SetProp(P_NOMAGIC,0);
SetProp(P_NOCORPSE, 1);
SetProp(P_MSGIN, "stampft laut bruellend herein");
SetProp(P_MSGOUT, "stampft bruellend davon");
SetProp(P_MMSGIN, "entsteht aus einem lauten KNALL");
SetProp(P_MMSGOUT, "verschwindet mit einer Explosion");
SetProp(P_MNPC_AREA, ("/d/dschungel/dante/geist/room/geist"));
SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES+
MOV_BACKWARDS+ MOV_INFIGHT );
SetProp(P_MNPC_WAIT, ({5, 5, 20}));
SetProp(P_MNPC_DEFAULTROOM, "d/dschungel/dante/geist/room/g66");
SetProp(P_MURDER_MSG, "Die Rache ist unser, elender Sterblicher!!!");
SetProp(P_KILL_NAME, "Ein Donnerdaemon");
SetProp(P_KILL_MSG, "Ihr elenden Sterblichen, Eure Tage sind gezaehlt! ");
SetProp(P_MSG_FLAGS, ([P_KILL_MSG:1, P_MURDER_MSG:1 ]));



SetProp(P_SPELLRATE,60);


AddSpell(4,200,
"Der Donnerdaemon bruellt Dich an!\n",
"Der Donnerdaemon bruellt @WEN laut an.\n",
DT_SOUND, ([SP_SHOW_DAMAGE:1]));

AddSpell(2, 300,
"Der Donnerdaemon bruellt dich extrem laut an!\n",
"Der Donnerdaemon bruellt @WEN extrem laut an.\n",
DT_SOUND, ([SP_SHOW_DAMAGE: 1]));

AddSpell(1, 500,
"Der Donnerdaemon laesst einen Donner auf Dich los!\n",
"Der Donnerdaemon laesst einen Donner auf @WEN los.\n",
DT_SOUND, ([SP_SHOW_DAMAGE: 1]));

SetChats(10,({
"Der Donnerdaemon stiert Dich an.\n",
"Der Donnerdaemon DONNERT!\n",
"Der Donnerdaemon bruellt herum.\n",
"Du wirst fast taub.\n",
"Der Donnerdaemon DONNERT LAUT!\n",
"Der Donnerdaemon brummt laut.\n",
"Der Donnerdaemon summt dumpf!\n",
"Der Donnerdaemon tobt bruellend um Dich herum!\n",
"Der Donnerdaemon bruellt knapp an Dir vorbei!\n",
"Der Donnerdaemon lacht Dich donnernd aus!\n"}));

}

Defend(int dam, string dtype, mixed spell, object enemy)
{
if (!pointerp(dtype))
dtype = ({ dtype });


if (sizeof(dtype & ({ DT_TERROR }) ))
{

tell_room(environment(),
"Der Donnerdaemon lacht Dich donnernd aus!!!\n");
heal_self(dam);
return ::Defend(0, dtype, spell, enemy);

}

if (sizeof(dtype & ({ DT_SOUND }) ))
{
tell_object(enemy,
"Der Donnerdaemon staerkt sich durch Deinen dummen Angriff.\n"
"Ein DONNER schiesst aus dem Daemon direkt auf Dich zu!!!\n");

enemy->Defend(300+random(100), DT_SOUND, ([SP_SHOW_DAMAGE: 1]));
tell_room(environment(TO),
""+enemy->name()+" wird von einem DONNER getroffen!\n", ({enemy}));
heal_self(1000);

return ::Defend(0, dtype, spell, enemy);
}

return ::Defend(dam, dtype, spell, enemy);
}
