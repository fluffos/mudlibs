inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <combat.h>
#include <new_skills.h>
#include <mnpc.h>
#include "/players/dante/myowndefine.h"
#define QN QueryProp(P_NAME)
#define QL QueryProp(P_LEVEL)
 
  int i, x, raum;
  string *wie, *was;

//  raum=1+random(25);

  void create()
  {
  if (!is_clone(TO)) return;
  ::create();

 wie=({"klein","gross","winzig","gigantisch","duenn","fett","dick",
 "klobig","bombastisch","lang","kurz","breit","schmal"});

 was=({"schwarz","weiss","grau","rot","blutrot","dantinisch","dumm","eklig",
 "haesslich","untot","verwest","stinkend","trintrasilhassend","halb","verfault"
  "angroxliebend","amnenionverlachend","brezelmaessig",
 "nachtschwarz","todesgeil","zappelnd","grinsend","hoehnisch","furchtlos"});
 
 x=random(sizeof(wie));
 i=random(sizeof(was));

 SP(P_SHORT, "Ein "+wie[x]+"er, "+was[i]+"er Daemon");
 //SP(P_NAME_ADJ, ({"+wie[x]+","+was[i]+"}));
 SetProp(P_NAME,"Daemon");

  SetProp(P_GENDER, MALE);
  AddId(({"daemon"}));
  SetProp(P_ARTICLE, 1);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10, T_RANGE_MAX: 45]));
  create_default_npc(10+random(11));

  SetProp(P_HANDS, ({" mit seinen Daemonenkrallen",
  80+QueryProp(P_LEVEL)*10,DT_TERROR}));
  SetProp(P_BODY, 40+QueryProp(P_LEVEL)*2);
 SetProp(P_SIZE, 160+QueryProp(P_LEVEL)*10);
  SetProp(P_ALIGN, -300-QueryProp(P_LEVEL)*10);
  SetProp(P_MAX_HANDS, 2);
  SetProp( P_RESISTANCE_STRENGTHS,
  ([DT_HOLY: 0.3, DT_UNHOLY:-1.0, DT_TERROR:-1.0,
 DT_ACID:-0.5, DT_FIRE:0.4, DT_BLUDGEON:0.5]));

  SetProp(P_HEAL, -QueryProp(P_LEVEL));
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC, QueryProp(P_LEVEL)-10);
  SetProp(P_NOCORPSE, 1);
  SetProp(P_MSGIN, "tobt kreischend herein");
  SetProp(P_MSGOUT, "verschwindet");
  SetProp(P_MMSGIN, "taucht ploetzlich  aus dem Nichts auf");
  SetProp(P_MMSGOUT, "verschwindet bruellend");

  SetProp(P_MNPC_AREA, ("/d/dschungel/dante/geist/room/geist"));
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES+
  MOV_BACKWARDS+ MOV_INFIGHT );

  SetProp(P_MNPC_WAIT, ({10, 20, 20}));
  SetProp(P_MNPC_DEFAULTROOM, "d/dschungel/dante/geist/room/geist"+raum+"");
  SetProp(P_MURDER_MSG, "Die Rache ist unser, elender Sterblicher!!!");
  SetProp(P_KILL_NAME, "Einer aus der Armee der Daemonen");
  SetProp(P_KILL_MSG, "Ihr elenden Sterblichen, Eure Tage sind gezaehlt!");
 SetProp(P_MSG_FLAGS, ([P_KILL_MSG:1, P_MURDER_MSG:1 ]));



 SetProp(P_SPELLRATE, QueryProp(P_LEVEL)*4);


 AddSpell(5,150+QueryProp(P_LEVEL)*10,
 "Der "+QN+" versucht Dich zu erwuergen.\n",
 "Der "+QN+" versucht @WEN zu erwuergen!\n",
 DT_TERROR, ([SP_SHOW_DAMAGE:1]));

 AddSpell(4, 250+QueryProp(P_LEVEL)*10,
 "Der "+QN+" schlaegt brutal auf Dich ein!\n",
 "Der "+QN+" schlaegt brutal auf @WEN ein!\n",
 DT_BLUDGEON, ([SP_SHOW_DAMAGE: 1]));
 AddSpell(1, 100,
 "Der "+QN+" spuckt Dich an!\n",
 "Der "+QN+" spuckt @WEN an!\n",
 DT_POISON, "spell_gift");

 SetChats(3,({
 "Der "+QueryProp(P_NAME)+" tritt Dich!\n",
 "Der "+QueryProp(P_NAME)+" sagt: Hau ab!\n",
 "Du fuehlst Dich sehr schlecht hier.\n",
 "Der "+QN+" grinst Dich boesartig an!\n",

 "Der "+QueryProp(P_NAME)+" lacht Dich aus!\n"}));


 }

 _query_long()   {

 if(QL < 14)  {
 write(BS(
 "Das ist einer der eher harmlosen, weniger gefaehrlichen Daemonen dieser Dimension. "
 "Trotzdem, er wird nicht zoegern Dich zu toeten."
 "Dieser hier ist ein "+wie[x]+"es, "+was[i]+"es "
  "Unwesen aus der Art der Daemonen."));
 }
 if(QL > 13 && QL < 18)  {
 write(BS("Dieser Daemon ist ein gefaehrliches Monster, das hier sein "
 "Unwesen treibt, obgleich er noch viel staerkere Artgenossen hat. "
 "Dieses Exemplar ist "+wie[x]+" und "+was[i]+"!"));  }

 else {
 write(BS("Dieser Daemon koennte Dich ohne Probleme toeten, "
 "er ist einer der staerksten und gefaehrlichsten der normalen "
 "Daemonen. Verglichen mit dem Namenlosen, ist er jedoch ein Wurm. "
 "Dieser Daemon ist "+wie[x]+" und "+was[i]+"!"));  }
 return ;
 }




 init(){
 ::init();
 if((interactive(TP)&&(TP->QueryProp(P_ALIGN)>0))) {
 if(!present("D_NO", TP))  {
 TO->Kill(TP);} }}



 void spell_gift(object enemy,int damage,mixed dam_type)
 {
 switch(random(20))
 {
 case 0..6:
 enemy->AddPoison(1);
 break;
 case 7..8:
 enemy->AddPoison(2);
 break;
 case 9:
 enemy->AddPoison(3);
 case 10..19:
 tell_object(enemy,
 "Der Daemon verfehlt Dich!\n");
 break;
 default: enemy->AddPoison(1);} }


 Defend(int dam, string dtype, mixed spell, object enemy)
 {

 if(getuid(enemy)=="DAEMJAEGER")  {
 return -1000;   }
 if (!pointerp(dtype))
 dtype = ({ dtype });

 if (sizeof(dtype & ({ DT_TERROR }) ))
 {

 tell_room(environment(),
 "Der Daemon lacht Dich aus!!!!\n");
 heal_self(dam);
 return ::Defend(0, dtype, spell, enemy);

 }

 return ::Defend(dam, dtype, spell, enemy);
 }

