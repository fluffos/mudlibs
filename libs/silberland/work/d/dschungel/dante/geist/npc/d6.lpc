

inherit "/std/npc";

#include <combat.h>
#include <moving.h>
#include <properties.h>
#include "/players/dante/myowndefine.h"
#include <new_skills.h>
#include <npc.h>
#define QL QueryProp(P_LEVEL)
#define QN QueryProp(P_NAME)

object cash;
 
void create()
  {   
  if (!is_clone(TO)) return;
 ::create();

SP(P_NAME, "Waechterdaemon");
SP(P_LONG, BS(
"Dieser Waechterdaemon hat nur eines im Sinn. Dich aufzuhalten und "
"wenn moeglich dabei zu toeten. Grimmig blickt er Dich an und deutet Dir "
"zu verschwinden. Der Waechterdaemon ist schon sehr gross."));
SP(P_SHORT, "Ein sehr grosser Waechterdaemon");
SP(P_NAME_ADJ, "sehr gross");
create_default_npc(15);
SetProp(P_GENDER, MALE);
AddId(({"daemon","waechterdaemon","waechter"}));
SetProp(P_ARTICLE, 1);

SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10, T_RANGE_MAX: 50]));
SetProp(P_SIZE, QL*20);
SetProp(P_ALIGN, -500);
SetProp(P_MAX_HANDS, 2);
SetProp(P_BODY, QL*4);
SetProp(P_HANDS, ({" mit seinen Daemonenkrallen",QL*20,({DT_TERROR,DT_RIP})}));
SetProp(P_RACE, "Daemon");



SetProp( P_RESISTANCE_STRENGTHS,
([DT_HOLY: 0.3,DT_UNHOLY:-1.0, DT_TERROR:-1.0, DT_FIRE:0.4, DT_BLUDGEON:-0.3,
DT_SLASH:-0.2, DT_WHIP:0.4,DT_COLD:0.6, DT_AIR:0.6, DT_RIP:-0.3
, DT_PIERCE:-0.1,DT_LIGHTNING:0.7, DT_ELECTRIC:-0.2]));



SetProp(P_HEAL, 0);
SetProp(P_AGGRESSIVE, 0);
SetProp(P_WIMPY, 0);
SetProp(P_NOMAGIC,QL/2);
SetProp(P_NOCORPSE, 0);
SetProp(P_MSGIN, "marschiert herein");
SetProp(P_MSGOUT, "marschiert");
SetProp(P_MMSGIN, "entsteht aus einem Knall");
SetProp(P_MMSGOUT, "verschwindet mit einer Explosion");

SetProp(P_MURDER_MSG, "Die Rache ist unser, elender Sterblicher!!!");
SetProp(P_KILL_NAME, "Ein Waechterdaemon");
SetProp(P_KILL_MSG, "Ihr elenden Sterblichen, Eure Tage sind gezaehlt! ");
SetProp(P_MSG_FLAGS, ([P_KILL_MSG:1, P_MURDER_MSG:1 ]));



SetProp(P_SPELLRATE,70);


AddSpell(4,QL*15,
"Der Waechterdaemon versucht Dich zu zerfetzen.\n",
"Der Waechterdaemon versucht @WEN zu zerfetzen.\n",
DT_RIP, ([SP_SHOW_DAMAGE:1]));

AddSpell(2, QL*20,
"Der Waechterdaemon pruegelt auf Dich ein!\n",
"Der Waechterdaemon pruegelt auf @WEN ein!\n",
DT_BLUDGEON, ([SP_SHOW_DAMAGE: 1]));

AddSpell(1, QL*25,
"Der Waechterdaemon schleudert eine Feuerwalze nach Dir!\n",
"Der Waechterdaemon schleudert eine Feuerwalze nach @WEM!\n",
DT_FIRE, ([SP_SHOW_DAMAGE: 1]));

SetChats(10,({
"Der Waechterdaemon sagt: Stop!\n",
"Der Waechterdaemon sagt: Halt! Wer da!\n",
"Der Waechterdaemon sagt: Hau ab!\n",
"Der Waechterdaemon sagt: Nein! Das geht so nicht!\n",
"Der Waechterdaemon tritt Dich!\n",
"Der Waechterdaemon sagt: Verschwinde!\n",
"Der Waechterdaemon sagt: Dreh um, Du Kind eines Erzmagiers!\n"}));

SUID;
 cash=CLONEOB("/obj/money");
    cash->SetProp(P_AMOUNT, QL*QL*10);
         cash->move(ME);  

         
}
           

 Defend(int dam, string dtype, mixed spell, object enemy)
{
if (!pointerp(dtype))
dtype = ({ dtype });


if (sizeof(dtype & ({ DT_TERROR }) ))
{

tell_room(environment(),
"Der Waechterdaemon lacht Dich aus!!!\n");
heal_self(dam);
return ::Defend(0, dtype, spell, enemy);

}

return ::Defend(dam, dtype, spell, enemy);
}
