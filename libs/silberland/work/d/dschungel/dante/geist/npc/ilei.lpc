

inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <combat.h>
#include <new_skills.h>
#include <mnpc.h>
#include "/players/dante/myowndefine.h"

int hilf=1;


void create()
{


if (!is_clone(TO)) return;
::create();
SetProp(P_SHORT, "Ileija Todesangst");
SetProp(P_LONG, BS(
"Das ist ist Ileija Todesangst, einer der weniger erfoglreichen Daemonenjaeger. "
"Er lebt zwar auch schon lange hier, hat aber wenig Glueck, bei der Jagd nach "
"Daemonen. Oft schon kam er in aergste Not..."));

SetProp(P_NAME,"Ileija Todesangst");
SetProp(P_GENDER, MALE);
AddId(({"daemonenjaeger","ileija","todeasangst","ileija todesangst"}));
SetProp(P_ARTICLE, 0);
SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10, T_RANGE_MAX: 45]));
create_default_npc(20);
SetProp(P_HANDS, ({" mit seinem Luftschwert geschickt",
200+random(100),DT_SLASH}));

set_living_name("ileija");

SetProp(P_BODY, 30);
SetProp(P_SIZE, 250);
SetProp(P_ALIGN, 500);
SetProp(P_MAX_HANDS, 2);
SetProp(P_INFO, "Ileija Todesangst wuerde Hilfe benoetigen.\n");
SetProp( P_RESISTANCE_STRENGTHS,([DT_FIRE: -0.3, DT_TERROR:1.0,
 DT_BLUDGEON:0.7, DT_MAGIC:-0.5, DT_WATER:1.0, DT_COLD:-0.5]));

SetProp(P_HEAL,10);
SetProp(P_AGGRESSIVE, 0);
SetProp(P_WIMPY, 100);
SetProp(P_NOMAGIC, 5);
SetProp(P_NOCORPSE, 0);
SetProp(P_MSGIN, "humpelt leidend herein");
SetProp(P_MSGOUT, "humpelt weit weg");
SetProp(P_MMSGIN, "taucht ploetzlich leidend neben Dir auf");
SetProp(P_MMSGOUT, "verschwindet leidend");

SetProp(P_MNPC_AREA, ("/d/dschungel/dante/geist/room/"));
SetProp(P_MNPC_FLAGS, MOV_MOVES+MOV_BACKWARDS+
MOV_INFIGHT+MOV_INDOORS +MOV_OUTDOORS+MOV_SPECIAL);

SetProp(P_MNPC_WAIT, ({10, 20, 20}));
SetProp(P_MNPC_DEFAULTROOM, "d/dschungel/dante/geist/room/geist12");
SetProp(P_MURDER_MSG, "Eine Sterbenden toeten, sehr mutig!");
SetProp(P_KILL_NAME, "Ileija Todesangst");
SetProp(P_KILL_MSG, "Ich toete nicht nur Daemonen!");
SetProp(P_MSG_FLAGS, ([P_KILL_MSG:1, P_MURDER_MSG:1 ]));




SetChats(15,({
"Ileija Todeasangst schaut Dich leidend an!\n",
"Ileija Todeasangst sagt: He,Du, hilf mir!\n",
"Ileija Todeasangst sagt: Ich habe den Namenlosen gesehen!\n",
"Ileija Todeasangst kruemmt sich vor Schmerzen!\n",
"Ileija Todeasangst sagt: Der Namenlose ist unbesiegbar! Glaube mir!\n",
"Ileija Todeasangst kotzt vor Deine Fuesse!\n",
"Ileija Todeasangst sagt: Der Namenlose hat mich verflucht!\n",
"Ileija Todeasangst bruellt vor Schmerzen auf.\n",
"Ileija Todeasangst hat Hoellenqualen!\n"}));

AddInfo(({"mops","terrormops"}),
"lacht sich krumm ueber den Terrormops!");
AI("namenlose",
"Der Namenlose hat mich verflucht. Irgendetwas ist in mir und quaelt mich "
"schon seit langem. Angeblich gibt es ein Heilmittel, aber wo...", "sagt: ");
AI("hilfe",
"stoehnt irgendetwas vom Namenlosen.");
AI(({"heilmittel","mittel"}),
"Angeblich ist es in einem der Tuerme, aber dort hausen "
"Daemone, die keine Freude mit Dir haben werden. Geh hin, und brings mir! "
"Es soll Dein Schaden nicht sein!", "sagt: ");
AI("schaden",
"Hmm, ich helfe Dir dann Dantes boeses Ich zu besiegen!", "sagt leise: ");
AI(({"turm","tuerme"}),
"Hier unten gibt es 4 Tuerme. In jedem haust ein anderer schrecklicher "
"Daemon.", "sagt: ");
AI(({"daemon","daemone"}),
"Tja, ich jage sie, aber der Namenlose hat mich verflucht!", "sagt: ");
AI("fluch",
"Der Namenlose hat irgendetwas in mich gezaubert...","sagt: ");


SetProp(P_SPELLRATE,70);
SUID;
CLONEME("d/dschungel/dante/weg/weapon/lschwert");
command("zuecke schwert");
CLONEME("/d/dschungel/dante/weg/obj/dpilz");
CLONEME("d/dschungel/dante/weg/armour/dtigerfell");
CLONEME("/d/wasser/stahldorn/knarkh/obj/knarkhhelm");
CLONEME("/d/gebirge/dusty/zwerge/obj/sanda");


 command("zieh alles an");


AI(({"jona","furchtlos"}),
"Ah, der alte Jona. Auch ein guter Daemonenjaeger.","sagt: ");
AI(({"cristof","feuerwind"}),
"Cristof ist der beste aller Daemonenjaeger.", "sagt: ");
AI(({"drache","skelettdrache"}),
"Hmm, der wohnt irgendwo in der Unterwelt.","sagt: ");
AI("vampirdrache",
"Der lebt irgendwo in den Hoehlen der Vampire...", "sagt: ");
AI(({"statue"}),
"Irgendwie kommt man da hinein, aber besser Du fragst Cristof Feuerwind...",
 "sagt: ");

AddInfo(DEFAULT_INFO,({
"jammert laut.\n",
"sagt: Ich bin verflucht!\n",
"sagt: Hilf mir!\n",
"bruellt vor Schmerzen auf.\n"}));
SP(P_HP, 80);

AddSpell(4,200,
"Ileija Todeasangst greift Dich mit einem grossen Feuerball an.\n",
"Ileija Todeasangst greift @WEN mit einem grossen Feuerball an.\n",
DT_FIRE, ([SP_SHOW_DAMAGE:1]));


AddSpell(1,300,
"Cristof Feuerwind schleudert einen magischen Pfeil nach Dir.\n",
"Cristof Feuerwind schleudert einen magischen Pfeil nach @WEM!\n",
DT_MAGIC, ([SP_SHOW_DAMAGE:1]));
}


init()
{object ob;
::init();
 ob=present("daemon", environment(TO) );
 if(ob){ ob->Kill();} 
 if(interactive(TP))  { call_out("tag", 0);}
 }
 
 void tag()  {
  if(environment(TP)!=environment(TO))   return ;
   else
    write("Ileija sagt: "+TPN+", ich warne Dich vor den Daemonen!\n");  }
    



HitFunc(int dam, string dtype, mixed spell, object enemy)
{
if(getuid(enemy)=="daemon")  {
return -1000;
} }


Defend(int dam, string dtype, mixed spell, object enemy)
{


if(getuid(enemy)=="daemon")  {
return ::Defend(0, dtype, spell, enemy);

}

else

return ::Defend(dam, dtype, spell, enemy);
}



void notify_give(object ob)  {
object rue;

if((ob->id("D_HEIL")))  {

write(BSA(
"Danke lieber "+TPN+", ich hoffe es hilft. Ich werde es sofort ausprobieren! "
"Dafuer schenke Ich Dir etwas. Hier hast Du!\n",
"Ileija Todeasangst sagt: "));

rue=clone_object("/d/dschungel/dante/geist/armour/badhose");
rue->move(TP, M_GET);

ob->remove();
}
::give_notify(ob);  }



