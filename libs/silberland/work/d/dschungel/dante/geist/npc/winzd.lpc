
inherit "std/npc";
#include <combat.h>
#include <properties.h>
#include <language.h>
#include <new_skills.h>
#include "/players/dante/myowndefine.h"
#include <moving.h>





void create()
{
if (!is_clone(TO)) return;
::create();
SetProp(P_SHORT, "Ein winziger Daemon");
SP(P_LONG, BS(
"Dieser Daemon ist wirklich winzig. Er geht Dir kaum bis an die Knie. Trotzdem "
"grinst er Dich frech an.\n"));


SetProp(P_NAME,"Daemon");
SP(P_NAME_ADJ, "winzig");
SetProp(P_GENDER, MALE);
AddId(({"daemon","winziger daemon"}));
SetProp(P_ARTICLE, 1);
SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10, T_RANGE_MAX: 45]));
create_default_npc(5+random(3));
SetProp(P_HANDS, ({" mit seine winzigen Haenden",50+random(50),DT_BLUDGEON}));
SetProp(P_BODY, 20+random(10));
SetProp(P_SIZE, 16+random(20));
SetProp(P_ALIGN, -500);
SetProp(P_MAX_HANDS, 2);
SetProp( P_RESISTANCE_STRENGTHS,([DT_BLUDGEON:1.0, DT_HOLY: 0.3,DT_UNHOLY:-1.0, DT_TERROR:-1.0]));
SP(P_INFO, "Irgendetwas stimmt mit dem winzigen Daemon nicht...\n");
SetProp(P_HEAL,-5);
SetProp(P_AGGRESSIVE, 0);
SetProp(P_WIMPY, 0);
SetProp(P_NOMAGIC,5);
SetProp(P_NOCORPSE, 1);
SetProp(P_MSGIN, "steht ploetzlich vor Dir");
SetProp(P_MSGOUT, "verschwindet");
SetProp(P_MMSGIN, "taucht ploetzlich auf");
SetProp(P_MMSGOUT, "verschwindet");

SetProp(P_MURDER_MSG, "Die Rache ist unser, elender Sterblicher!!!");
SetProp(P_KILL_NAME, "Der Winzigste aus der Armee der Daemonen");
SetProp(P_KILL_MSG, "Ihr elenden Sterblichen, Eure Tage sind gezaehlt!");
SetProp(P_MSG_FLAGS, ([P_KILL_MSG:1, P_MURDER_MSG:1 ]));
SetProp(P_SPELLRATE,99);
AddSpell(4,500+random(100),
"Der winzige Daemon pruegelt wie irr auf Dich ein!\n",
"Der winzige Daemon pruegelt wie irr auf @WEN ein.\n",
DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));
AddSpell(2,700+random(100),
"Der winzige Daemon schlaegt Dich in Todeswut nieder!\n",
"Der winzige Daemon schlaegt @WEN nieder.\n",
DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));

AddSpell(1,900+random(100),
"Der winzige Daemon macht seine Todesattacke auf Dich!\n",
"Der winzige Daemon macht seine Todesattacke auf Dich.\n",
DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));

SetChats(10,({
"Der winzigeDaemon tritt Dich!\n",
"Der winzige Daemon sagt: Hau ab!\n",
"Du fuehlst Dich sehr schlecht hier.\n",
"Der winzige Daemon sagt: KLEIN! Aber oho!\n",
"Der winzige Daemon sagt: Tja, so kann man sich taeuschen.\n",
"Der winzige Daemon grinst Dich boesartig an!\n",
"Der winzige Daemon sagt: Angeblich ist Brezels Schnidel auch winzig!\n",
"Der winzige Daemon lacht Dich aus!\n"}));
}
Defend(int dam, string dtype, mixed spell, object enemy)
{
if (!pointerp(dtype))
dtype = ({ dtype });


if (sizeof(dtype & ({ DT_TERROR }) ))
{

tell_room(environment(),
"Der winzige Daemon lacht Dich aus!!!!\n");
heal_self(dam);
return ::Defend(0, dtype, spell, enemy);

}

return ::Defend(dam, dtype, spell, enemy);
}

