//essen

#include "/players/dante/myowndefine.h"

inherit "std/food";

#include <properties.h>
#include <language.h>
#include <food.h>

create()
{
if (!is_clone(TO) )  return;

::create();

SetProp(P_SHORT, "Ein Daemonenbraten");
SetProp(P_LONG, BS(
"Dieser Daemonenbraten wurde von tapferen Daemonenjaegern zubereitet. Eine "
"leckere, einzigartige Delikatesse dieser Welt!"));
SP(P_INFO, "Dieser Braten ist nur fuer gute Helden schlecht!\n");
SetProp(P_NAME, "Daemonenbraten");
SetProp(P_GENDER, MALE);
AddId( ({"daemonenbraten", "braten"}) );

SetProp(P_MATERIAL, MAT_MISC_DEAD );
SetProp(P_WEIGHT, 100);
SetProp(P_VALUE, 1000);
SetProp(P_NOBUY, 1);
}

BeimEssen()
{
//if(TP->QueryProp(P_ALIGN)>=(300) )  {

if(interactive(environment(TO)) &&
  environment(TO)->QueryProp(P_ALIGN)<300)  {
SetProp(P_FOOD_INFO, ([F_HEAL: -20, F_SOAK: 8, F_ALCOHOL: 0, F_POISON: 5]));

write("Du verschlingst den Daemonenbraten mit einem Bissen!\n"
"Du Unseliger, dieser Braten war fuer Dich doch giftig und sehr ungesund!\n");

say(CAP_TPN+" wuergt einen hochgiftigen Daemonenbraten hinunter.\n");
return::BeimEssen();

}

else

{
SetProp(P_FOOD_INFO, ([F_HEAL: 50, F_SOAK: 6, F_ALCOHOL: 0,F_POISON: 0]));

write("Der Daemonenbraten schmeckt Dir hervorragend!\n");

say(CAP_TPN+" verschlingt einen Daemonenbraten!\n"); 

return::BeimEssen();
}
}