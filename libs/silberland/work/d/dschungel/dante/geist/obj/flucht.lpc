// dante@SilberLand ausweis fuer august

#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <moving.h>
create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Eine kleine Kugel");
  SetProp(P_LONG, BS( 
    "Diese kleine Kugel schaut voellig unscheinbar aus. Nichts, aber auch garnichts "
    "erweckt Dein Interesse an ihr."));
  SetProp(P_INFO, "Die Kugel kann Dich vom richtigen Ort einmal aus dieser Dimension "
  "bringen. Dazu musst Du sie in Deinen Haenden drehen...\n");
  SetProp(P_NAME, "Kugel");
  SetProp(P_GENDER, FEMALE);
  AddId(({"kugel","fluchtkugel"}));

  SetProp(P_MATERIAL, ({MAT_MAGIC,MAT_METAL}));
  SetProp(P_WEIGHT, 20);
  SetProp(P_VALUE, 1000+random(100));
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL,0);
  SetProp(P_NODROP,0);
  
  AddCmd(({"drehe","dreh"}),"weg");
}

int weg(string str)
{
 notify_fail("Was willst Du wo drehen ?\n");
 if (!str)
 return 0;
 
 if ( member( ({"kugel in hand","kugel in haende","kugel in haenden"}),str) !=-1)
 {
 write(" \n"
 "Du drehst die Kugel in deinen Haenden und ploetzlich scheinen Zeit "
 "und Raum aufgehoben zu sein...\n");
 say(""+TPN+" dreht eine magische Kugel in seinen Haenden...");
 TP->move("/d/dschungel/dante/geist/room/geist1", M_NO_SHOW+ M_GO,
 "ploetzlich in einen Raum-Zeit-Spalt gerissen.\n","wird",
 "wird aus einem Raum-Zeit-Spalt vor Deine Fuesse geschleudert.\n");
 remove("kugel");
 return 1;
 }
 return 0;
 }