inherit "std/thing";
#include "/players/dante/myowndefine.h"
#include <properties.h>
#include <language.h>

int counter=0;
int oldlight;
create()
{
if (!is_clone(TO) )  return;

::create();

SetProp(P_SHORT, "Ein Daemonenstein");
SetProp(P_LONG, BS(
"Der Daemonenstein ist ein zackiger, zerfurchter Klumpen, der sich warm "
"in Deinen Haenden anfuehlt. Seine Oberflaeche ist aeusserst rauh.\n"));

oldlight=TO->QueryProp(P_LIGHT);

SP(P_INFO, "Der Daemonenstein kann Licht erzeugen! Aber wie?\n");
SetProp(P_NAME, "Daemonenstein");
SP(P_NAME_ADJ, "zerfurcht");
AD("oberflaeche",
"Die Oberflaeche ist rau und zerfurcht. Du erkennst einen roten Punkt.");
ASD("punkt", "do_light");
SetProp(P_GENDER, MALE);
AddId( ({"daemonenstein", "stein"}) );

SetProp(P_MATERIAL,([MAT_STONE:50, MAT_MAGIC:50]));
SetProp(P_WEIGHT, 159);
SetProp(P_VALUE, 3000);
SetProp(P_NOBUY, 1);
}

string do_light()  {
if(QueryProp(P_LIGHT)==5)  {
write("Der Punkt leuchtet bereits sehr hell.\n");  }
else
{
SetProp(P_LIGHT, 5);
write("Der rote Punkt leuchtet ploetzlich sehr hell auf.\n");  }
return ""; }

 reset() {
  ::reset();
  if(counter>=50)  {
  SetProp(P_LIGHT, oldlight-1);
  write("Der Stein verliert an Kraft.\n");  }
  //d.h der kann auch negativ werden...
  counter++;
  }
