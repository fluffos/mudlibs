
#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>

create()
{
  if (!is_clone(TO) )  return;

  ::create();

  SetProp(P_SHORT, "Eine alte Karte");
  SetProp(P_LONG, BS( 
    "Diese Karte hat einst ein mueder Abenteurer in den Ritzen einer Mauer versteckt. "
    "Sie ist ziemlich vergilbt und ihre Rueckseite weist einige Flecken auf. Man kann sie aber noch lesen."));
  SetProp(P_NAME, "Karte");
  SetProp(P_GENDER, FEMALE);
  AddId("karte");
  SetProp(P_INFO, "Der Abenteurer hat die Karte verschluesselt...");
  SetProp(P_MATERIAL, MAT_PAPER );
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 30);
  SetProp(P_NOBUY, 1);
  SetProp(P_NODROP, 1);
AddDetail(("seite"),
"Welche Seite meinst Du ?");
AddDetail(("rueckseite"),
"Auf der Rueckseite der Karte erkennt man einige schmutzige, oelige Flecken.");
AddDetail(({"fleck","flecke","flecken"}),
"Du betrachtest die Flecke naeher und erkennst ein Gekritzel...");

AddDetail(("gekritzel"),
"IM SUEDEN GEHT DIE SONNE AUF.\n"
"IM WESTEN IST DER MEISTE SCHNEE.\n"
"IM OSTEN LIEGT DAS ABENDLAND.\n"
"IM NORDEN LIEGT DER DSCHUNGEL.\n");

AddReadDetail(("karte"),
"+----------------------------------------------------+\n"
"|                                                    |\n"
"|                                                    |\n" 
"|                                          II        |\n"
"|      ___                                IIII       |\n"
"|      | |                             _IIIIIIII_    |\n"                             
"|      | |    s    w    w    s    w    |        |    |\n"
"|      | |                             |   ___  |    |\n"
"|     IIIII                            |   | |  |    |\n"
"|                                                    |\n"
"|                                                    |\n"
"|                                          II        |\n"
"|                                         IIII       |\n"
"|    _________                         _IIIIIIII_    |\n"
"|    |   |   |                         |        |    |\n"
"|    |   |.  |    w    o    w    w     |   ___  |    |\n"
"|    |   |   |                         |   | |  |    |\n"
"|                                                    |\n"
"|                                                    |\n"
"|        II                                          |\n"
"|       IIII                              ___        |\n"
"|    _IIIIIIII_                           | |        |\n"
"|    |        |                           | |        |\n"
"|    |   ___  |    n   o   o   n   n      | |        |\n"
"|    |   | |  |                          IIIII       |\n"
"|                                                    |\n"
"|                                                    |\n"
"+----------------------------------------------------+\n");

}
  