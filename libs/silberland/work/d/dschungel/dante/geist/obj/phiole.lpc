

#include "/players/dante/myowndefine.h"
#include <properties.h>
#include <language.h>
inherit "std/thing";

create()
{
if (!is_clone(TO) )  return;

::create();

SetProp(P_SHORT, "Eine kleine Phiole");
SetProp(P_LONG, BS(
"Diese kleine Phiole scheint eine Fluessigkeit zu enthalten, denn wenn Du ganz leise "
"bist, hoerst Du es glucksen. Sie ist fest verschlossen und Du bekommst sie auch sicher "
"nicht auf.")),
SP(P_INFO, "Der Inhalt dieser Phiole koennte ein Heilmittel beinhalten!\n");
SetProp(P_NAME, "Phiole");
SP(P_NAME_ADJ, "klein");
SetProp(P_GENDER, FEMALE);
AddId( ({"phiole", "D_HEIL"}) );

SetProp(P_MATERIAL,([MAT_GLASS:50, MAT_MISC_FLUID:50]));
SetProp(P_WEIGHT, 50);
SetProp(P_VALUE, 3000);
SetProp(P_NOBUY, 1);
}

