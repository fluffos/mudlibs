
#include "/players/dante/myowndefine.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <food.h>

int voll=10;

create()
{
if (!is_clone(TO) )  return;

::create();

SetProp(P_SHORT, "Eine Flasche SisQui Brutal");
SetProp(P_LONG, BS(
"Das ist eine der seltenen Flaschen SisQui Brutal. Feinster, kristallklarer Wodka! "
"Er schmeckt vorzueglich und ist stark im Abgang. Doch sei vor seinem hohen "
"Alkoholgehalt gewarnt."));
SetProp(P_NAME, "Wodkaflasche");
SetProp(P_GENDER, FEMALE);
AddId( ({"wodka","flasche", "wodkaflasche","sisQui brutal","brutal"}) );

SP(P_INFO, "Die Syntax fuer diese Flasche ist <wodka>.\n"
"Mit <untersuche inhalt> siehst Du wie voll Die Flasche noch ist.\n");
SetProp(P_MATERIAL, ([ MAT_GLASS: 10, MAT_MISC_FLUID:90]));
SetProp(P_WEIGHT, 500);
SetProp(P_VALUE, 3000);
SetProp(P_NOBUY, 1);
ASD("inhalt", "show");
ACD(({"wodka"}), "fuel");
}


int fuel() {
int oldsoak, oldalc;
if(voll)  {
oldsoak=TP->QueryProp(F_SOAK);
oldalc=TP->QueryProp(F_ALCOHOL);
TP->QueryProp(F_SOAK, oldsoak+5);
TP->QueryProp(F_ALCOHOL, oldalc+10);
TP->heal_self(10);
write("Du nimmst einen grossen Schluck aus Deiner Flasche SisQui Brutal.\n"
"Kurz lodert ein Feuerstrahl aus Deinem Mund!\n");
say(CAP_TPN+" trinkt einen grossen Schluck SisQui Brutal!\n"
"Danach lodert kurz ein Feuerstrahl aus dem Mund von "+TPN+"!\n");

voll--; return 1;  }

else  {
say(BS(CAP_TPN+" saugt an einer leeren Flasche SisQui Brutal herum "
"und blickt Dich dann aus kindlichen Augen an! Rabaeh!"));
write(BS("Du saugst an der leere Flasche SisQui Brutal und kommst Dir "
"ploetzlich recht kindlich vor. Rabaeh! Rabaeh!"));  return 1; } }


string show()  {
int inhalt;
inhalt=10*voll;

if(voll==10)  {
write("Deine Flasche SisQui Brutal ist noch total voll.\n");  }
if(!voll) {
write("Deine Flasche SisQui Brutal ist leer.\n");  }
else  {
write("Deine Flasche SisQui Brutal ist noch zu "+inhalt+"% voll.\n");  }
return "";  }

