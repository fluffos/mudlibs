// naturgeist die erste

#include "files.h"

inherit ROOM "geist_inh";

#include <properties.h>
#include <language.h>
#include <moving.h>

int heilen=3;
create()
{
//  ::create();
   make_room();

  SetProp( P_INT_LONG, BS(
    "Du hast Dich nun endgueltig im dichten Nebel verlaufen. Hinter Dir, vor Dir,"
    " nichts als Nebelschwaden. Einzig die Lichtpunkte sind eine kleine Abwechslung in"
    " dieser trueben, monotonen Landschaft. Einzig ein grosser Stein erregt "
    "Dein Interesse..."));
  AddDetail(("interesse"),
    "Du wirst ihn Dir schon genauer betrachten muessen...");
  AddDetail(("stein"),
    "Der grosse Stein besteht aus grauem Fels und ragt aufrecht in den Himmel. "
    "Eine magische Anziehungskraft geht von ihm aus und Du glaubst eine "
    "schwarze Inschrift zu erkennen...");
  AddDetail(({"kraft","anziehungskraft"}),
    "Der Stein zieht Dich unwiderstechlich an...");
  AddDetail(("fels"),
    "Ganz normaler grauer Fels. Doch irgendwie strahlt der Stein Waerme ab...");
  AddDetail(("waerme"),
    "Du fuehlst Dich in der naehe des Steines sehr wohl, vielleicht solltest Du "
    "dem Stein noch naeher kommen...");
  AddDetail(("inschrift"),
    "Du kannst sie lesen.");
  AddReadDetail(("inschrift"),
    "NOLI ME NON TANGERE!!!!!!!");
   
  

  AddExit("osten", "./g16");
    AddExit( "norden", "./g6");
      AddExit( "westen", "./g14" );
        AddExit( "sueden", "./g24" );
          
  AddCmd(({"beruehre","beruehr","fuehle","fuehle"}), "energy");
}

reset()
{
heilen = 3;
::reset();
}

energy ( string str)
{
notify_fail("Was willst Du beruehren ?\n");

if ( str != "stein")
return 0;

if ( !heilen)
{
write(
"Du beruehrst den Stein aber nichts passiert...\n");
say(CAP_TPN+" beruehrt den Stein, aber nichts scheint zu passieren.\n");
return 1;
 }
else
 {
 write(
 "Du beruehrst den Stein und ploetzlich durckzuckt Dich ein greller Blitz.\n"
 "Du fuehlst Dich sehr stark und erholt...\n");
 TP->heal_self(50)+random(50);
 say(CAP_TPN+" beruehrt den Stein und wird von einem hellen Blitz getroffen.\n"
 +CAP_TPN+" sieht ploetzlich sehr erholt aus...\n");
 heilen--;
return 1;
 }
return 0;
}
