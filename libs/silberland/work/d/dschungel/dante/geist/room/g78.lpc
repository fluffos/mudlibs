// naturgeist die erste

#include "../def.h"

inherit ROOM "geist_inh";

#include <properties.h>
#include <language.h>
#include <moving.h>

int stone=1;
create()
{
//  ::create();
  make_room();

AddDetail("boden",
"Der Boden ist hier weder feucht noch weich. Es scheint so als stuendest "
"Du auf einer sehr harten Flaeche aus Stein.");
AddDetail("flaeche",
"Der Stein ist rauh und zerfurcht.");
AddDetail("stein",
"Der Stein schimmert hell und wirkt sehr anziehend auf Dich! Ueberall sieht "
"man kleine rote Punkte.");
AddDetail(({"punkt","punkte"}),
"Die Punkte erzeugen Licht und Waerme. Faszinierend!");
AddDetail(({"licht","waerme"}),
"Sie leuchten nur schwach, das kann man aber irgendwie aendern. Egal. Viel "
"interessanter ist die Gier die in Dir nach so einem Stein hochsteigt!");
AddDetail("gier",
"Du willst unbedingt so einen Stein! Aber wie, der Stein ist sehr hart?! "
"Ohne entsprechendes Werkzeug wird da wohl kaum was zu machen sein. "
"Irgendwie kann man sicher einen kleinen Stein herausbrechen!");
AddDetail("werkzeug",
"Schaufel: Nein\n"
"Spitzhacke: Ja\n"
"Haende: Aua!!\n"
"Magier: Ja\n");
AddDetail(({"magier","schaufel","haende"}),
"Nein, lass das lieber.");
AddDetail(({"hacke","spitzhacke"}),
"Schon besser...");

AddItem("d/dschungel/dante/geist/npc/steind", REFRESH_DESTRUCT);

  AddExit("osten", "./g79");
  AddExit( "norden", "./g69");
  AddExit( "westen", "./g77" );
  AddExit( "sueden", "./g6" );

AddCmd(({"brich","breche"}), "get");

}

reset()  {
::reset();
stone=1;  }


int get(string str)  {
  object ob;
  
  notify_fail("Was willst Du herausbrechen?\n");
  if(member(({
  "stein aus stein", "stein aus flaeche","stein aus boden",
  "stein mit hacke aus boden",
  "stein mit spitzhacke aus boden",
  "stein heraus"}),str)!=-1)  {
  
  if(!present("spitzhacke", TP))  {  
  //mir is egal welche hacke der hat...
  write("Du versuchst es ohne Spitzhacke.\n"
  "Ein gruenes Wesen formt sich aus dem Stein und sagt: SCHWUPP!\n");
  TP->SetProp(P_FROG, 1);
  say(CAP_TPN+" quakt froehlich umher.\n");
  return 1;
  }
 if(present("spitzhacke", TP) && (!present("D_HACKE", TP))) {
 write("Du hackst mit Deiner jaemmerlichen Hacke herum, doch "
 "mit der Hacke wird das nie was.\n");  return 1; }
 
 
 
 if(present("D_HACKE", TP))  {
 if(!stone)  {
 write("Du versuchst mit der Spitzhacke einen Stein herauszubrechen, doch"
 " leider schaffst Du das im Moment nicht.\n");
 say(CAP_TPN+" hackt am Boden herum.\n");
 return 1; }
 if(stone) {
 write("Du hackst mit Deiner Spitzhacke eine kleinen Stein aus dem "
 "Boden heraus.\n");
 stone--;
 ob=clone_object("d/dschungel/dante/geist/obj/dstein");
 ob->move(TP, M_GET);  return 1;  }
        return 0;  } 
 return 0; }
 
 return 0;  }
 
 
  
  