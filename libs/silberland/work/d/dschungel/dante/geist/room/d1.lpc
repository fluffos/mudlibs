inherit "/std/npc";

#include <combat.h>
#include <moving.h>
#include <properties.h>
#include "/players/dante/myowndefine.h"
#include <new_skills.h>
#include <npc.h>

void create()
{
if (!is_clone(TO)) return;
::create();
SetProp(P_SHORT, "Ein winziger Waechterdaemon");

SP(P_LONG, BS(
"Dieser Daemon hat nur den Sinn Dich aufzuhalten. Doch so "
"winzig wie er ist, wird er das wohl nicht schaffen."));

SetProp(P_NAME,"Waechterdaemon");
SP(P_NAME_ADJ, "winzig");
SetProp(P_GENDER, MALE);
AddId(({"daemon","waechterdaemon"}));
SetProp(P_ARTICLE, 1);
SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:20, T_RANGE_MAX: 40]));
create_default_npc(5);
SetProp(P_HANDS, ({" mit seinen Daemonenklauen",50,({DT_TERROR,DT_RIP})}));
SetProp(P_BODY, 10);
SetProp(P_SIZE, 30);
SetProp(P_ALIGN, -500);
SetProp(P_MAX_HANDS, 2);
SetProp( P_RESISTANCE_STRENGTHS,
([DT_HOLY: 0.3,DT_UNHOLY:-1.0, DT_TERROR:-1.0, DT_FIRE:-1.0, DT_BLUDGEON:-1.0,
DT_SLASH:-0.5, DT_WHIP:0.4,DT_COLD:0.6, DT_AIR:-0.6, DT_RIP:-0.7
, DT_PIERCE:-0.7,DT_LIGHTNING:-1.0, DT_ELECTRIC:-1.0]));

SetProp(P_HEAL, 0);
SetProp(P_AGGRESSIVE, 0);
SetProp(P_WIMPY, 0);
SetProp(P_NOMAGIC,0);
SetProp(P_NOCORPSE, 0);
SetProp(P_MSGIN, "marschiert");
SetProp(P_MSGOUT, "marschiert");
SetProp(P_MMSGIN, "entsteht aus einem Knall");
SetProp(P_MMSGOUT, "verschwindet mit einer Explosion");

SetProp(P_MURDER_MSG, "Die Rache ist unser, elender Sterblicher!!!");
SetProp(P_KILL_NAME, "Ein winziger Waechterdaemon");
SetProp(P_KILL_MSG, "Ihr elenden Sterblichen, Eure Tage sind gezaehlt! ");
SetProp(P_MSG_FLAGS, ([P_KILL_MSG:1, P_MURDER_MSG:1 ]));



SetProp(P_SPELLRATE,50);


AddSpell(4,25,
"Der Waechterdaemon versucht Dich zu zerfetzen.\n",
"Der Waechterdaemon versucht @WEN zu zerfetzen.\n",
DT_RIP, ([SP_SHOW_DAMAGE:1]));

AddSpell(2, 50,
"Der Waechterdaemon pruegelt auf Dich ein!\n",
"Der Waechterdaemon pruegelt auf @WEN ein!\n",
DT_BLUDGEON, ([SP_SHOW_DAMAGE: 1]));

AddSpell(1, 75,
"Der Waechterdaemon schleudert eine Feuerwalze nach Dir!\n",
"Der Waechterdaemon schleudert eine Feuerwalze nach @WEM!\n",
DT_FIRE, ([SP_SHOW_DAMAGE: 1]));

SetChats(10,({
"Der Waechterdaemon sagt: Stop!\n",
"Der Waechterdaemon sagt: Halt! Wer da!\n",
"Der Waechterdaemon sagt: Hau ab!\n",
"Der Waechterdaemon sagt: Nein! Das geht so nicht!\n",
"Der Waechterdaemon tritt Dich!\n",
"Der Waechterdaemon sagt: Verschwinde!\n",
"Der Waechterdaemon sagt: Hhd2p PUIUH piuh.\n"}));



}

Defend(int dam, string dtype, mixed spell, object enemy)
{
if (!pointerp(dtype))
dtype = ({ dtype });


if (sizeof(dtype & ({ DT_TERROR }) ))
{

tell_room(environment(),
"Der Waechterdaemon lacht Dich aus!!!\n");
heal_self(dam);
return ::Defend(0, dtype, spell, enemy);

}

return ::Defend(dam, dtype, spell, enemy);
}
