// naturgeist die erste

#include "../def.h"

inherit ROOM "geist_inh";

#include <properties.h>
#include <language.h>
#include <moving.h>
create()
{
//  ::create();
  make_room();

  SetProp( P_INT_LONG, BS(
 "Du hast Dich nun endgueltig im dichten Nebel verlaufen. Hinter Dir, vor Dir,"
 " nichts als Nebelschwaden. Einzig die Lichtpunkte sind eine kleine Abwechslung in"
 " dieser trueben, monotonen Landschaft. Doch, da ist etwas im Nordwesten!"));
 AddDetail("nordwesten",
 "Im Nordwesten kann man einen Turm erkennen.");
 AddDetail("turm",
 "Schmenehaft zeichnet er sich im Nebel ab.");



  AddExit("osten", "./g2");
  AddExit( "norden", "./g73");
  AddExit( "westen", "./g9" );
  AddExit( "sueden", "./g10" );
  AddExit("nordwesten", "./nwturm1");
  
}

