// naturgeist die erste

#include "../def.h"

inherit ROOM "geist_inh";

#include <properties.h>
#include <language.h>
#include <moving.h>






create()
{
//  ::create();
  make_room();
  
  SetProp(P_INT_LONG,BS(
  "Du hast Dich nun endgueltig im dichten Nebel verlaufen. Hinter Dir, vor Dir, "
  "nichts als Nebelschwaden. Einzig die Lichtpunkte sind eine kleine Abwechslung "
  "in dieser trueben, monotonen Landschaft. Ein grosser schwarzer Felsen, "
  "der einsam und voellig losgeloest von der restlichen Landschaft im Sueden von "
  "hier liegt, erregt Dein Interesse."));
  AddDetail("interesse",
  "Der grosse, schwarze Felsen liegt im Sueden von hier. Sehr interessant.");
  AddDetail("sueden",
  "Im Sueden liegt der grosse, schwarze Felsen.");
  AddDetail(({"felsen","fels"}),
  "Der Felsen ist aus schwarzem Stein, der voellig naturbelassen wirkt. "
  "Hoch erhebt er sich vor Dir, noch viel groesser als ein Drache.");
  AddDetail(({"drache","drachen"}),
  "Der schwarze Felsen ist das Nest des Daemonendrachen Kronomortis.");
  AddDetail(({"daemonendrache","kronomortis"}),
  "Er haust im Inneren des schwarzen Felsen in einer Hoehle.");
  AddDetail(({"inneres","innerem","inneren"}),
  "Geh nach Sueden, dort findest Du die Hoehle.");
  AddDetail("nest",
  "Dort haust der Daemonendrache und wartet auf Dich!");
  AddDetail("stein",
  "Der Stein ist schwarz, aber das weisst Du ja schon.");
  AddDetail("hoehle",
  "Die HOehle ist im Inneren des schwarzen Felsen im Sueden.");
  AddDetail("sueden",
  "Im Sueden liegt die Hoehle im schwarzen Felsen, in der Nekromortis lebt.");
  
  
  
  AddExit("osten", "./g78");
  AddExit( "norden", "./g68");
  AddExit( "westen", "./g76" );
  AddExit( "sueden", "./draum" );
}

