inherit "std/room";
#include "/players/dante/myowndefine.h"
#include <language.h>
#include <properties.h>
#include <moving.h>     
#include <mnpc.h>


create()  {
::create();


SP(P_INT_SHORT, "Auf einem Turm bei den Daemonen");
SP(P_LIGHT, 1);
SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:20]));
  

SP(P_INT_LONG, BS(
"Du befindest Dich nun am nordwestlichen Turm im Reich der Daemonen. "
"Einst lebte hier Cristof Feuerwind, doch der wurde wie all die "
"anderen Daemonenjaeger laengst vertrieben. Von der frueher auch nur "
"kargen Einrichtung ist nichts uebriggeblieben. Vereinzelt liegen Truemmer "
"als Zeugen eines schrecklichen Kampfes herum. Die Daemonen muessen "
"grausam gewuetet haben. Eine schmale Treppe fuehrt wieder nach unten."));

AD("reich",
"Hier herrscht ein Pestdaemon!");
AD("pestdaemon",
"Der ist nicht da!");
AD(({"daemon","daemone"}),
"Die Daemonen haben diesen Turm erobert und nun lebt hier ein Pestdaemon!");

AD("boden",
"Am Boden liegen die Truemmer der ehemaligen Einrichtung herum.");
AD("truemmer",
"Wild verstreut liegen sie am Boden herum. Wie in Deinem Zimmer!");
AD("zimmer",
"Wuerdest Du lieber in diesem Turm leben?!");
AD("einrichtung",
"Die Einrichtung wurde von den Daemonen voellig zertruemmert. "
"Nur eine Kiste steht noch recht gut erhalten herum.");
AD("kiste",
"Was da wohl drinnen ist.");
AD(({"zeuge","zeugen"}),
"Die Daemonen haben ausser Cristof keinen Zeugen entkommen lassen.");
AD("kampf",
"Der Kampf war hart und lange, doch letzendlich mussten die "
"Daemonenjaeger erkennen, dass sie den Daemonen unterlegen waren.");
AD("treppe",
"Die Treppe fuehrt nach unten vor den Turm.");



AD("turm",
"Dieser Turm ist der nordwestliche Turm. Er wurde erbaut von Cristof "
"Feuerwind, einem Daemonenjaeger. Harter Stein, geschaffen fuer ewig, "
"hat die Daemonen auch nicht gehindert ihn zu erobern und Cristof zu "
"vertreiben. Der Turm ist oben offen und hat nur sehr kleine "
"Scharten.");
AD(({"scharte","scharten"}),
"Die Scharten dienten einst der Beobachtung der Daemone.");
AD("beobachtung",
"Hat wohl nicht viel genuetzt.");
AD(({"cristof","feuerwind"}),
"Einer der letzen noch lebenden Daemonenjaeger.");
AD(({"jaeger","daemonenjaeger"}),
"Einst waren sie viele, uebriggeblieben sind nur 5.");




AD("blut",
"Das Blut ist schon alt und vertrocknet.");

AD("decke",
"Decke gibt es keine, denn der Turm ist offen.");
AD("himmel",
"Der Himmel ist nebelverhangen.");
AD("nebel",
"Der Nebel ist hier kaum zu bemerken.");
AD(({"wand","waende"}),
"Die Waende des Turmes bestehen aus hartem Stein. Trotzdem sind sie aber "
"teilweise eingestuerzt.");
AD("stein",
"Der Stein ist teilweise blutverschmiert und weist viele Schrammen auf.");
ASD(({"schramme","schrammen"}), "aua"); 


AddSound(DEFAULT_SOUND,
"Du hoerst das Toben der Daemonen von unten.\n");
AddSound("toben",
"Das Toben gilt auch Dir.\n");
AddSmell(DEFAULT_SMELL,
"Es riecht nach Kot.\n");
AddSmell("kot",
"Auch Daemonen muessen manchmal...\n");

AIT("d/dschungel/dante/geist/npc/pestdaemon", REFRESH_DESTRUCT,
  ([ P_MNPC_FLAGS: 0]));

AE("unten", "./noturm1");
ACD("oeffne", "get");
}

int get(string str)  {
object helm;
  NF("Was willst Du hier oeffnen!\n");
   if(str=="kiste")  {
    
    if(present("daemon", TO))  {
    write("Der Daemon tritt Dich um!\n");
       return 1; }
       
       
   if(deep_present("BAD_HELMET", TP))  {
   write("Du schaffst es nicht die Kiste zu oeffnen!\n");
   say(CAP_TPN+" hantiert an einer Kiste herum!\n");
   return 1; }
   else  {
   write("Du oeffnest die Kiste und findest einen seltsamen Helm!\n");
      say(CAP_TPN+" hantiert an einer Kiste herum!\n");       
  helm=clone_object("d/dschungel/dante/geist/armour/badhelm");
  helm->move(TP, M_GET);
         return 1; }
     return 0; }
  return 0; }
  

string aua() {
write("WUMM!!! Du schrammst Dir den Kopf an einem Stein an!\n");
TP->do_damage(5);  return ""; }
