// naturgeist die erste

#include "../def.h"

inherit ROOM "geist_inh";

#include <properties.h>
#include <language.h>
#include <moving.h>
create()
{
//  ::create();
  make_room();
  
  AddDetail("nordosten",
  "Im Nordosten scheint ein grosses Gebaeude zu sein! Ein Weg fuehrt dorthin!");
  AddDetail("gebaeude",
  "Hmm, man kann nicht viel sehen.");
  AddDetail("weg",
  "Der Weg fuehrt nach Nordosten.");
  
  
  SetProp(P_HIDE_EXITS, ({"nordosten"}));
  AddExit("nordosten", "./noturm1");
  AddExit("osten", "./g1");
  AddExit( "norden", "./g81");
  AddExit( "westen", "./g8" );
  AddExit( "sueden", "./g18" );
}

init() {
::init();
if(interactive(TP)) call_out("tag", 3);
}
void tag()  {
 if(ENV(TP)==TO)   {
 write("Du fuehlst Dich nach Nordosten gezogen.\n"); }}
 