// naturgeist die erste

#include "files.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

int x=random(4);

create()
{
  ::create();

  SetProp( P_INT_SHORT, "In der Dimension der Naturgeister und Daemonen" );
  SetProp( P_INT_LONG, BS(
    "Du haengst nun hoch in der Luft am Ende eines Seils. Sehen kannst Du "
    "hier ausser Nebel ueberhaupt nichts, aber Du bist froh Dich vor den "
    "Daemonen und ihren Hunden in Sicherheit gebracht zu haben..."));
    AddDetail(("himmel"),
     "Den Himmel kann man wegen des Nebels nicht erkennen.");
    AddDetail(("seil"),
    "Das Seil endet hier, und scheint merkwuerdigerweise nirgends angebunden zu sein..."); 
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25]) );
AddDetail(("ende"),
"Das Seil scheint zu schweben...");
AddDetail(({"daemon","daemone"}),
"Unten lauern sie auf Dich! Doch hier ist etwas viel besseres...");
AddDetail("etwas",
"Na, dieses Detail ist aber sehr abgedroschen!");
AddDetail("detail",
"Dieses auch!");
AddDetail("atmen",
"Das Atmen ist hier recht schwer, da die Luft so feucht ist.");

AddDetail(({"hunde","hunden"}),
"Hier rauf kommt sicher keiner, es sei denn es ist einer der klettern kann, "
"was aber eher unwahrscheinlich ist. Oder doch nicht...");
   AddDetail( ({ "nebelschwaden","nebelschwade","nebel"}),
  "Der Nebel liegt wie ein Leichentuch schwer ueber der unheimlichen Landschaft"
  " und scheint alles und jeden zu verschlucken.");
 AddDetail( ({ "leichentuch","tuch"}),   "Du fuehlst Dich eingeengt, das Atmen faellt Dir schwer...");
 AddDetail( ({ "landschaft"}),
 "Von der Landschaft kannst Du nur schemenhafte, verzerrte Umrisse erkennen."
 "Der Nebel verhindert jede genauere Betrachtung.");
 AddDetail(({"umriss","umrisse"}),
 "Umrisse kannst Du hier keine mehr erkennen...");
  AddSound( DEFAULT_SOUND,
    "Du hoerst ein dumpfes Grollen von weit her.");
    AddDetail("boden",
    "Der Boden ist von hier aus natuerlich nicht zu sehen.");
    AddDetail("sicherheit",
    "Mit Sicherheit bist Du hier auch nicht sicher.");
    AddDetail("luft",
    "Die Luft ist feucht und irgendwie seltsam.");
    AddDetail("betrachtung",
    "Bei genauerer Betrachtung entdeckst Du 4 seltsame schwebende Kugeln.");
    AddDetail(({"kugel","kugeln"}),
    "Die Kugeln schweben einfach vor Dir in der Luft hin und her. Sie sind "
    "recht blass, sodass sie auch schwer zu entdecken waren. Sie haben "
    "4 verschiedene Farben.");
    AddDetail(({"farbe","farben"}),
    "Runengrau, blutrot, knochenweiss und biergelb.");
  
  AddDetail(({"blutrot","knochenweiss","biergelb","runengrau"}),
  "Die Kugel dieser Farbe sieht besonders interessant aus. "
  "Vielleicht solltest Du probieren sie zu fangen...");
    
  AddSmell( DEFAULT_SMELL,
    "Du kannst den Nebel direkt riechen.");
   
  
  AddCmd(({"kletter","klettere","steig","steige"}), "up");
  AddCmd(({"fang","fange"}), "get");
}

  int get(string str)  {
  object ob;
  notify_fail("Was willst Du hier fangen?\n");
 
  if(str=="kugel"||str=="kugeln")  {
  write("Welche Kugel?!\n"); return 1;}
 
 //ob=clone_object("d/dschungel/dante/geist/armour/badshoe");
  
  
  
 if(x==0&& str=="blutrote kugel")  {
 write("Du versuchst die blutrote Kugel zu fangen, doch alles "
 "was Du erwischt sind seltsame Stiefel?!\n");
// ob->move(TP, M_GET); x=random(4);
    return 1;  }
 
 
 if(x==1 && str=="runengraue kugel")  {
 write("Du versuchst die runengraue Kugel zu fangen, doch alles "
 "was Du erwischt sind seltsame Stiefel?!\n");
// ob->move(TP, M_GET);x=random(4);
    return 1;  }
 
 
 if(x==2 && str=="biergelbe kugel")  {
 write("Du versuchst die biergelbe Kugel zu fangen, doch alles "
 "was Du erwischt sind seltsame Stiefel?!\n");
// ob->move(TP, M_GET);x=random(4);
    return 1;  }
 
 
 if( x==3 && str=="knochenweisse kugel")  {
 write("Du versuchst die knochenweisse Kugel zu fangen, doch alles "
 "was Du erwischt sind seltsame Stiefel?!\n");
// ob->move(TP, M_GET); x=random(4);
    return 1;  }
 
 else  {
 write("Irgendwie schaffst Du es nicht eine Kugel zu fangen!\n"
 "Probiers mal mit einer anderen Kugel.\n");
 return 1; }
 
          return 0;  }
  
  
  
  


int up(string str)
{
notify_fail("Womit willst Du wohin klettern ?\n");

if ( !str)
return 0;

if ( member( ({"mit seil nach unten","auf seil nach unten","an seil runter",
"mit seil nach unten","auf seil nach unten","an seil nach unten","mit seil runter",
"an seil runter","an seil runter"}),str ) !=-1 )

{
write(" \n"
"Du kletterst am Seil nach unten...\n");
TP->move("/d/dschungel/dante/geist/room/g21", M_GO,
"am Seil nach unten", "klettert",
"kommt von oben herabgeklettert");
return 1;
}
return 0;
}
