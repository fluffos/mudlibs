inherit "std/room";
#include "/players/dante/myowndefine.h"
#include <language.h>
#include <properties.h>
#include <moving.h>     

int heilen=3;

create()  {
::create();


SP(P_INT_SHORT, "Vor einem Turm");
SP(P_LIGHT, 1);

  SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_SWAMP, ENV_TEMPERATURE:20]));
  

SP(P_INT_LONG, BS(
"Hier lichtet sich der Nebel etwas und Du erkennst direkt vor Dir einen dunklen Turm, "
"der wie ein Monument des Boesen in die Luft ragt. Ein Tor, das mehr einem"
" offenen Schlund "
"aehnelt, fuehrt direkt nach oben in die Ungewissheit. Ueber dem Tor erkennt man ein "
"verschlungenes Symbol. Im Suedosten kommst Du wieder in den verwirrenden, dichten "
"Nebel zurueck."));

AD("tor",
"Das Tor steht weit offen, Du wirst also bereits erwartet.");
AD("schlund",
"Weit offen steht das Tor um dumme Sterbliche wie Dich in den Turm "
"zu locken.");
AD("ungewissheit",
"Sollst Du nach oben gehen oder nicht...");


AD("symbol",
"Das Symbol zeigt einen stolzen Daemonenjaeger, dem einst dieser Turm "
"gehoert hat. Irgendein lustiger Daemon hat aber etwas am Kopf des "
"Daemonenjaegers veraendert.");
AD("etwas",
"Das etwas ist eine rostige Axt, die gerade den Kopf des Daemonenjaegers "
"spaltet. Grausig tropft Blut zu Boden.");
AD("kopf",
"Der Kopf wird gerade von einer Axt gespalten."),


AD("axt",
"Die rostige Axt trifft genau!");
AD(({"wand","waende"}),
"Der Turm ist aus festem Stein erbaut. Du erkennt eine kleine Inschrift.");
AD("inschrift",
"Lies sie.");




AddReadDetail("inschrift",
"Erbaut von Cristof Feuerwind.");
ASD(({"cristof","feuerwind","cristof feuerwind"}),"show");




AD("boden",
"Der Boden ist weich und zeigt deutliche Spuren.");
AD(({"spur","spuren"}),
"Die Spuren fuehren nur in den Turm hinein, was sicher nichts positives bedeutet.");



AD("monument",
"Hoch ragt er auf vor Dir.");
AD(({"boese","boeses"}),
"Noch kein Sterblicher hat diesen Turm jemals wieder verlassen,");
AD(({"sterbliche", "sterblicher"}),
"Du bist auch einer.");
AD("luft",
"Du blickst nach oben und der Turm scheint zu schwanken. Schnell blickst Du "
"wieder nach unten.");


AD("nebel",
"Der Nebel scheint hier etwas lichter zu sein, wird aber im Suedosten wieder dichter.");
AD("suedosten",
"Im Suedosten ist nichts zu erkennen, da der Nebel hier sehr dicht ist.");
AD("turm",
"Der Turm ragt hoch und dunkel vor Dir in den Himmel. Er scheint Dich zu warnen "
"ihn zu betreten. Erbaut wurde er einst als Bollwerk gegen die Daemonen, doch "
"schon vor langer Zeit haben sie ihn erobert und hausen nun selbst darin.");
AD("himmel",
"Der Himmel ist kaum zu erkennen.");
AD("bollwerk",
"Angeblich haben die Daemonenjaeger ihn erbaut.");
AD(({"jaeger","daemonenjaeger"}),
"Scheinbar keiner hier.");
AD(({"daemon", "daemonen", "daemone"}),
"Gluecklicherweise ist keiner hier, doch vielleicht erwartet Dich einer "
"im Turm...");
AD("zeit",
"Vor langer, langer Zeit.");
AD("decke",
"Ne warme Decke waer praktisch hier.");






AddSound(DEFAULT_SOUND,
"Von oben hoerst Du ein schreckliches Bruellen.\n");
AddSound("bruellen",
"Das Bruellen stammt sicher von einem Daemon.\n");
AddSmell(DEFAULT_SMELL,
"Es riecht nach Blut.\n");


AddSmell("blut",
"Ja, wirklich, am Boden ist eine grosse Blutlache.\n");
AD(({"lache","blut","blutlache"}),
"Die Blutlache scheint frisch zu sein. Sie sieht recht lecker aus?! Vielleicht solltest "
"Du aus ihr trinken?\n");
ACD(({"trink","trinke"}), "get");
AddGuardedExit("oben", "/d/dschungel/dante/geist/room/nwturm2",
"waechter", "Irgendetwas unsichtbares haelt Dich fest!\n");
AE("suedosten", "./g1");
AIT("d/dschungel/dante/geist/npc/invid", REFRESH_DESTRUCT);
}

string show()  {
object ob;
ob=find_living("cristof");
if(ob)  {
write(BSA(
"Hallo "+TPN+", freut mich, dass Du meinen alten Turm gefunden hast. "
"Erober ihn zurueck, doch sei wachsam. Dort oben haust ein Pestdaemon!",
"Cristof Feuerwind teilt Dir mit: "));
//epmaster usw waer gut tnx
}
else
write("Leider, Cristof Feuerwind lebt nicht.\n");
return "";
}


int get(string str)  {
NF("Woraus willst Du trinken?/n");
if(member(({
"aus lache", "blut aus lache","blut aus blutlache","aus blutlache"}),str)!=-1)  {
if(!heilen)  {
write("Du trinkst aus der Blutlache, doch nichts passiert.\n");
say(CAP_TPN+" trinkt aus einer Blutlache.\n");
return 1; }
else  {
write("Du trinkst aus der Blutlache und fuehlst Dich enorm gut.\n");
say(CAP_TPN+" trinkt aus einer Blutlache.\n");
TP->heal_self(75+random(50));
heilen--;  return 1; }
return 0; }
return 0;  }


reset(){
::reset();
heilen=3;  }

