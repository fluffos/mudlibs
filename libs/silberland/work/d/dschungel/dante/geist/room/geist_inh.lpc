// naturgeist die erste

#include "../def.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>

void make_room()
{
  ::create();

  SetProp( P_INT_SHORT, "In der Dimension der Daemonen" );
  SetProp( P_INT_LONG, BS(
    "Du hast Dich nun endgueltig im dichten Nebel verlaufen. Hinter Dir, vor Dir,"
    " nichts als Nebelschwaden. Einzig die Lichtpunkte sind eine kleine Abwechslung in"
    " dieser trueben, monotonen Landschaft.")); 
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25]) );
    AddDetail(("himmel"),
    "Der Himmel ist durch den Nebel nicht zu erkennen.");
 AddDetail(("boden"),
 "Der Boden ist feucht und kaum zu erkennen...");
  AddDetail(("abwechslung"),
    "Nebel, Nebel, nichts als Nebel...");
  AddDetail( ({ "lichtpunkte","punkt","lichtpunkt","punkte" }),
    "Die Lichtpunkte kreisen um Dich und scheinen Dich zu begutachten.");
   AddDetail( ({ "nebelschwaden","nebelschwade","nebel"}),
  "Der Nebel liegt wie ein Leichentuch schwer ueber der unheimlichen Landschaft "
  "und scheint alles und jeden zu verschlucken.");
 AddDetail( ({ "leichentuch","tuch"}),   "Du fuehlst Dich eingeengt, das Atmen "
     "faellt Dir schwer...");

 AddDetail("betrachtung",
 "Du siehst hier fast nichts...");
 AddDetail("atmen",
 "Vergiss nicht darauf!");
 AddDetail( ({ "landschaft"}),
 "Von der Landschaft kannst Du nur schemenhafte, verzerrte Umrisse erkennen."
 "Der Nebel verhindert jede genauere Betrachtung.");
 AddDetail(({"umriss","umrisse"}),
 "Umrisse kannst Du hier keine mehr erkennen...");
  AddDetail( ({ "westen", "osten", "sueden", "norden"}),
 "Du wirst schon in diese Richtung gehen muessen, um mehr zu erkennen");
  AddDetail( ({ "pfad"}),
 "Den Pfad scheinst Du im dichten Nebel verloren zu haben.");
 AddDetail( ("bauwerk"),
 "Der Nebel ist so dicht, dass Du das Bauwerk nicht mehr sehen kannst");
  AddDetail( ({ "statue"}),
  "Die Statue kann man von hier nicht mehr erkennen.");
  AddDetail( ({ "augenblick"}),
  "Fuer einen kurzen Moment reisst der Nebel auf, und Du siehst....leider nichts.");
  AddSound( DEFAULT_SOUND,
    "Du hoerst ein dumpfes Grollen von weit her.");
    
  AddSmell( ({DEFAULT_SMELL, "nebel"}),
    "Du kannst den Nebel direkt riechen.");

AddSound("grollen", 
"Das duestere Grollen scheint von sehr weit weg zu kommen.\n");


/*  AddRoomMessage( ({
  "Nebelschaden ziehen an Dir vorueber.\n",
  "Durch die Erde scheint ein leichtes Zittern zugehen.\n",
  "Die Lichtpunkte kreisen um Dich herum.\n",
   "Die Lichtpunkte tanzen durch den Nebel.\n",
   "Du glaubst ein dumpfes Grollen von sehr weit weg zu hoeren.\n",
   "Ein greller Blitz durchzuckt den Nebel.\n",
   "Du hast Dich voellig im Nebel verirrt.\n",
   "Du glaubst Stimmen aus dem Nebel zu hoeren.\n",
   "Der Wind reisst die Nebelschleier kurz auf.\n",
   "Halt! Da war doch der Pfad, oder...\n",
   "Der Nebel huellt Dich ein...\n",
   "Hat da nicht eben jemand Deinen Namen gerufen...\n"}),90);
*/
}

