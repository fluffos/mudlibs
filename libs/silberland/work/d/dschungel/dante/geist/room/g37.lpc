// naturgeist die erste

#include "../def.h"

inherit ROOM "geist_inh";

#include <properties.h>
#include <language.h>
#include <moving.h>

create()
{
//  ::create();
  make_room();

SetProp(P_LIGHT, -1);

  SetProp( P_INT_LONG, BS(
"Du hast Dich nun endgueltig im dichten Nebel verlaufen. Hinter Dir, vor Dir,"
          " nichts als Nebelschwaden. Einzig die Lichtpunkte sind eine kleine "
          "Abwechslung in dieser trueben, monotonen Landschaft. Doch "
          "wie Dir vielleicht aufgefallen ist, herrscht hier Dunkelheit. "
          "Etwas Boesartiges scheint in Deiner Naehe zu sein..."));
          
      AddDetail("naehe",
      "Du weisst nicht woher...");
      AddDetail("dunkelheit",
      "Die Dunkelheit stroemt direkt aus dem westen hier her.");
      AddDetail("westen",
    "Aus dem Westen faellt Dunkelheit bis hier her. Das Boesartige "
   "scheint dort auf Dich zu lauern.");
   AddDetail(({"boesartige","boesartiges"}),
   "Wenn Du nicht nach Westen gehst, wirst Du es nie erfahren...");
          
          


  AddExit("osten", "./g38");
  AddExit( "norden", "./g28");
  AddGuardedExit( "westen", "/d/dschungel/dante/geist/room/dunkel",
  "daemon", "Irgendetwas haelt Dich hier fest!\n");
  
  AddExit( "sueden", "./g46" );
}

