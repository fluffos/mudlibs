// naturgeist die erste

#include "files.h"

inherit ROOM "geist_inh";

#include <properties.h>
#include <language.h>
#include <moving.h>


create()
{
  make_room();
  SetProp( P_INT_LONG, BS(
    "Du hast Dich nun endgueltig im dichten Nebel verlaufen. Hinter Dir, vor Dir,"
    " nichts als Nebelschwaden. Einzig die Lichtpunkte sind eine kleine Abwechslung in"
    " dieser trueben, monotonen Landschaft. Seltsam, aber irgendetwas scheint in der Naehe zu sein...")); 
AddDetail(("naehe"),
"Ja, etwas ist in Deiner Naehe, aber wo ?");
  AddDetail( ({ "osten"}),
 "Im Osten kannst Du ein kleines Gebaeude erkennen...");
 AddDetail(("boden"),
 "Am Boden liegt ein zerbrochenes Schild.");
 AddDetail(("schild"),
 "Du kannst es wenn Du Dich bemuehst noch lesen...");
 AddReadDetail(("schild"),
 "Wi lkomm n in uns r   k ei e!");
 AddDetail(("gebaeude"),
 "Von hier kannst Du nicht viel erkennnen, aber moeglicherweise handelt es "
 "sich um eine Kneipe...");
 AddDetail(("kneipe"),
 "Moeglicherweise...");
  AddSound( DEFAULT_SOUND,
    "Aus dem Osten kommt Laerm...");

AddSmell("rum",
"Ja, direkt im Osten muss etwas sein, das nach Rum riecht!\n");
    
  AddSmell( DEFAULT_SMELL,
    "Du glaubst Rum zu riechen...");
AddSound("laerm",
"Der Laerm kommt aus dem Osten!\n");

  AddGuardedExit("osten", "/d/dschungel/dante/geist/room/kneipe", 
  "waechter", "Irgendetwas unsichtbares haelt Dich auf!\n");
  
  AddExit("norden", "./g36");
  AddExit("sueden", "./g54");
  AddExit("westen", "./g44");

AddItem("/d/dschungel/dante/geist/npc/invid", REFRESH_DESTRUCT);

}

