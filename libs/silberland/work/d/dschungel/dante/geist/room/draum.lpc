inherit "std/room";
#include "/players/dante/myowndefine.h"
#include <language.h>
#include <properties.h>
#include <moving.h>     


create()  {
::create();


SP(P_INT_SHORT, "Im Nest von Kronomortis");
SP(P_LIGHT, 0);
SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_CAVE, ENV_TEMPERATURE:20]));
  

SP(P_INT_LONG, BS(
"Die Hoehle von Kronomortis dem Daemonendrache ist noch groesser und hoeher "
"als es der schwarze Felsen erahnen haette lassen. Der Boden ist uebersaeht "
"mit Knochen und halbverfaulten Leichen. An den Waenden sieht man Blutspritzer, "
"die langsam zu Boden rinnen. Gemuetlich ist es hier sicher nicht. Im Norden "
"kommst Du wieder zurueck in den Nebel."));

AD(({"wand","waende"}),
"Die Waende bestehen ebenfalls aus dem schwarzen Felsen, der nun aber blutrot "
"gefaerbt ist. Die Blutspritzer rinnen langsam zu Boden und bilden kleine "
"Lachen.");
AD(({"blutspritzer","spritzer"}),
"Die Waende sind durch die vielen Blutspritzer rot gefaerbt worden.");


AD(({"lachen","lache"}),
"Kleine Lachen aus Blut bilden sich am Boden.");


AD("norden",
"Im Norden, draussen vor der Hoehle, beginnt der unendliche Nebel.");
AD("nebel",
"Im Norden lauert er auf Dich.");
AD("decke",
"Die Decke ist sehr weit oben. Ab und zu tropft Blut herab.");


AD("hoehle",
"Die Hoehle ist sehr weitlaeufig, aber schliesslich ist ein Drache ja auch "
"sehr gross. Ueberall sieht man Knochen und Blut.");
AD(({"drache","daemonendrache","kronomortis"}),
"Hier herrscht er!");
AD(({"fels","felsen"}),
"Der Felsen war hier auch einmal schwarz. Nun ist er aber laengst blutrot gefaerbt.");
AD("boden",
"Der Boden ist uebersaeht mit Knochen und halbverfaulten Leichen. Du musst "
"fast aufpassen nicht auf eine zu steigen.");
AD("knochen",
"Teilweise sind die Knochen sehr sauber abgenagt, teilweise sind "
"sie auch einfach zerfetzt und zerbrochen.");
AD(({"leiche","leichen"}),
"Die Leichen liegen wild verstreut umher. Es handelt sich um die "
"Opfer von Kronomortis. Ihr Anblick ekelt Dich und Du musst "
"Dich fast uebergeben.");
AD("opfer",
"Die Opfer hatten sicher keinen leichten Tod hier.");
AD("tod",
"Der Tod kam langsam und qualvoll.");
AD("anblick",
"Du uebergibst Dich doch.");






AddSound(DEFAULT_SOUND,
"Hier ist es totenstill.\n");


AddSmell(DEFAULT_SMELL,
"Es riecht nach Blut.\n");


AddSmell("blut",
"Ja, wirklich, es riecht nach Blut.\n");

AE("norden", "./g77");
AIT("d/dschungel/dante/geist/npc/ddrache", REFRESH_DESTRUCT);
}
