
#include "files.h"

inherit ROOM "geist_inh";

#include <properties.h>
#include <language.h>
#include <moving.h>

create()
{
//  ::create();

  make_room();

  SetProp( P_INT_LONG, BS(
    "Wo bist Du hier nur hingeraten? Alles sieht verzerrt und verschwommen"
    " aus. Nebelschwaden ziehen an Dir vorbei, seltsame Lichtpunkte schwirren"
    " um Dich herum und ueberhaupt scheint hier alles so fremd zu sein."
    " Schemenhaft glaubst Du eine grosse Gestalt zu erkennen, und Du beginnst"
    " Dich zu fuerchten."));

AddDetail("hoehe",
"Gigantisch hoch!");
AddDetail("betrachtung",
"Du zitterst...");

 AddDetail( ({"umrisse","umriss"}),
 "Im Norden glaubst du einen grossen dunkelgrauen Schatten zu erkennen.");
  AddDetail( ({ "schatten"}),
 "Der Schatten ragt drohend in die Hoehe, doch fuehlst Du Dich magisch"
"von ihm angezogen.");
  AddDetail( ({ "norden"}),
 "Nach Norden scheint ein kleiner Pfad zu fuehren.");
 AddDetail( ("pfad"),
 "Der Nebel ist so dicht, dass Du den Pfad nur einige wenige Meter "
 "erkennen kannst, dann verschwindet er in dieser unheimlichen Landschaft. "
 "Er scheint nach ueberall zu fuehren...");
 AddDetail( ({ "gestalt"}),
 "Bei genauerer Betrachtung erweist sich die Gestalt als eine gigantische"
 "Statue...");
  AddDetail( ({ "statue"}),
  "Die Statue ist aus einem eigenartigem Material gemacht und is das Abbild"
  " eines riesigen Daemons.");
  AddDetail("daemon",
  "Es handelt sich um den Namenlosen, den Anfuehrer aller Daemone!");
AddDetail(({"namenloser", "namenlose"}),
"Er ist der schreckliche Anfuehrer aller Daemone.");

AddDetail("anfuehrer",
"Der Namenlose regiert hier. Huete Dich vor ihm!");
   AddDetail( ({ "material"}),
   "Etwas aehnliches hast Du noch nie erblickt. Irgendwie hast Du den Eindruck,"
  "dass die Statue zu leben scheint, den das Material scheint zu fliessen und"
    "zu pulsieren...");
  AddDetail( ({ "eindruck"}),
   "Deine Sinne koennten Dir auch einen Streich spielen, aber...");
   AddDetail( ({ "abbild","bild"}),
  "Die Erschaffer dieser gigantischen Statue muessen sehr lange fuer die"
 "Vollendung dieses Giganten gebraucht haben.");
   AddDetail( ({ "gigant","giganten"}), 
  "Die Statue ist so gewaltig hoch, dass Du ihren Schaedel kaum mehr im Nebel"
 "erkennen kannst.");
   AddDetail( ({ "erschaffer"}),
  "Du raetselst wer sowas wohl zustande bringt...");
  AddDetail( ({ "sinne","sinn","streich"}),
  "Hat nicht jemand gerade Deinen Namen gerufen ?");
   AddDetail( ({ "schadel"}),
   "Hoch ober Dir kannst Du ihn schemenhaft eine grausige Fratze erkennen.");
 AddDetail( ({ "fratze"}),
  "Die Fratze scheint voller zerstoererrischer Wut einen unsichtbaren Gegner"
  "zu verhoehnen. Augen, beinahe so gross wie Du, blicken hasserfuellt nach Norden"
   "und der Mund ist zu einem boesartigen Grinsen verzogen.");
     AddDetail( ({ "wut"}),
  "Du bist sehr froh, dass der Namenlose nur eine Statue ist.");
  AddDetail( ({ "auge","auge"}),
  "In den Augen scheint ein rotgluehendes Feuer zu brennnen.");
   AddDetail( ({ "feuer"}),
    "Du glaubst beinahe die Hitze zu spueren, die von den Augen ausgeht.");
    AddDetail( ({ "angst"}),
         "Dir wird Angst und Bange...");
          AddDetail( ({ "gegner"}),
        "Wer der Gegner des Namenlosen ist, weisst Du nicht, aber Du bist froh nicht"
        "an seiner Stelle sein zu muessen.");
          AddDetail( ({ "mund"}),
        "Der Mund ist leicht geoeffnet und Dich blitzen meterlange messerscharfe Reisszaehne an.");
          AddDetail( ({ "grinsen"}),
         "Der Namenlose scheint seine Gegner nicht als ebenbuertig einzustufen.");
           AddDetail( ({ "zaehne","reisszaehne","zahn"}),
         "Furchterregende Werkzeuge des Todes...");
           AddDetail( ({ "daemon","daemons"}),
  "Vor Dir siehst Du den Namenlosen, den Anfuehrer der Daemone der Oedniss, der Dunkelheit"
 " des Todes, der Seuchen, Naturkatastrophen und allen nur jemals von dunklen"
         " Maechten erdachten Feinde der bluehenden Natur.");
         AddDetail(("oeddnis"),
         "Voellig leblos soll diese Welt werden.");
         
         AddDetail(({"katastrophen","katastrophe","naturkatastrophe","naturkatastrophen"}),
         "Die Daemone verursachen Braende, Flutwellen, Erdbeben,...");
         AddDetail(("dunkelheit"),
         "In ewige Finsterniss wollen sie das Silberland stuerzen.");
  AddDetail(({"seuchen","seuche"}),
  "Als Du so ueber Seuchen sinnierst, faellt Dir eine fleckige Stelle an der Statue auf.");
  AddDetail(("stelle"),
  "Die Stelle scheint eine verwitterte alte Marmortafel zu sein.");       
           AddDetail( ({ "anfuehrer"}),
         "Er ist nach alten Mythen mit seiner Schreckensbande ausgezogen um jegliches"
         " Leben auf dieser Welt auszuloechen und ewige Dunkelheit zu bringen.");
           AddDetail( ({ "welt"}),
         "Noch haben die dunklen Gesellen ihr Ziel nicht erreicht, noch gibt es Leben"
         " im Silberland, noch...");
         AddDetail(({"tafel","marmortafel"}),
         "Du kannst die Tafel lesen.");
         AddDetail(("marmor"),
         "Der zahn der Zeit hat dem Marmor ziemlich zugesetzt.");
           AddDetail( ({ "natur"}),
           "Bete fuer die Natur solange Du noch kannst...");
          AddDetail( ({ "silberland"}),
          "Das ist die herrliche Welt in der Du Dich befindest.");
 AddDetail( ({ "gesellen"}),             
 "Pluendernd und mordend ziehen sie durch die Lande und zerstoren alles Leben.");
  AddDetail( ({ "ziel"}),            
  "Ihr Ziel ist die Ausrottung allen Lebens im Silberland.");
   AddDetail( ({ "mythen","mythos"}),
   "Die Daemonenjaeger wissen mehr darueber.");
   AddDetail(({"jaeger","daemonenjaeger"}),
   "Frag sie nach den Daemonen.");
    AddDetail( ({ "maechte","macht"}),
   "Boese Maechte haben am Beginn des Lebens Schrecken aller Art erdacht.");
    AddDetail( ({ "schrecken"}),
   "Beschwoere die Schrecken nicht, du wuerdest es mit dem Leben bezahlen...");
    AddDetail( ({ "leben"}),
    "Wie lange noch...?");
     AddDetail( ({ "tod"}),
     "Der Tod ist naeher als Du denkst!");          
  AddReadDetail( ({ "tafel" }),
    "+---------------+\n"
    "|               |\n"
    "|   BETE fuer   |\n"
    "|               |\n"
    "|      die      |\n"
    "|               |\n"
    "|     NATUR     |\n"
    "|               |\n"
    "|     doch      |\n"  
    "|               |\n"
    "|   beschwoere  |\n"
    "|               |\n"
    "|    niemals    |\n"
    "|               |\n"
    "|      den      |\n" 
    "|               |\n"
    "|   SCHRECKEN   |\n" 
    "|               |\n" 
    "+---------------+\n");

   AddCmd( ({ "bete" }), "bete" );
   AddCmd( ({ "beschwoere", "beschwoere"}), "beschwoeren" );
  
   AddExit( "sueden", "./g50" );
   AddExit( "norden", "./g32" );
   AddExit( "westen", "./g40" );
   AddExit( "osten", "./g42" );
  
}

 beschwoeren( str )
{ object ob;
  notify_fail( "Was willst Du hier beschwoeren ?\n" );
  if ( !str){     
  notify_fail("Was willst Du hier beschwoeren ?\n");
  return 1;
  }
  if( str == "schrecken" )
  {write(" \n"
    "Du kniest nieder und murmelst wie in Trance archaische Formeln, die "
    "Dir irgendeine dunkle Macht eingibt."
    " \n");
    say(CAP_TPN+" kniet nieder und murmelt wie in Trance dunkelanmutende Worte in einer archaischen Sprache.\n");
    call_out("st1",2);
    return 1;
  }
  
  return 0;
}

st1()
{
  if(ENV(TP)==TO)
  {

    tell_room(TO,
      "Der Namenlose teilt Dir mit: Wer wagt es uns zu stoeren ?\n");
    call_out("st2", 30);
  }
}

st2()
{
  if(ENV(TP)==TO)
  {
    tell_room(TO,"Der Namenlose teilt Dir mit: Verschwinde, oder ich toete Dich!\n");
    call_out("st3", 30);
  }
}
st3()
{
  if(ENV(TP)==TO)
  {
    tell_room(TO,
      "Der Namenlose bruellt: Sterblicher, das ist Deine letzte Chance!\n");
    call_out("st4", 30);
  }
}

st4()
{
  if(ENV(TP)==TO)
  {
  tell_room(TO,
  "Ploetzlich schiesst ein roter Feuerstrahl von oben herab!!!\n");
    SetProp(P_KILL_NAME, "Zu wenig Respekt vor dem Namenlosen");
    TP->do_damage(300);
  }    
}

init() {
::init();
if(interactive(TP))  {
call_out("tag", 0);  }}

  void tag()  {
 if(ENV(TP)==TO)   {
 write("Irgendetwas fesselt Dich magisch an diesen Ort!\n");  }}
       

int  bete(string str )
{
  notify_fail( "Wofuer willst du hier beten?\n" );
  if (!str)
  {return 0;
  }
  
  if( str == "fuer natur" )
  {object ob;
  write(" \n"
    "Du kniest nieder und sprichst ein Gebet fuer die Geister und Erschaffer der Natur und wirst im selben Moment in eine andere Dimension geschleudert."
    " \n");
    say(""+TPN+" kniet nieder und spricht ein Gebet fuer die Geister und Erschaffer der Natur."
    " \n");
    TP->move("d/dschungel/dante/hoehle/room/portal2",M_NO_SHOW + M_TPORT);
    //raum muss noch geaendert werden....
    while (ob=present("fluchtkugel",TP))
    {
    write("Die magische Kugel zerplatzt.\n");
    ob->remove();
    }
    return 1;
  }
  return 0;
}
