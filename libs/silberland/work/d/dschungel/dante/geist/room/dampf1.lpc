/*
1. in portal2.c tor einbauen indampf1
*/
//done



#include <moving.h>
inherit "std/room";
#include <properties.h>
#include <language.h>
#include "/players/dante/myowndefine.h"
#include <new_skills.h>

create()
{
  ::create();

SP(P_INT_SHORT, "In einem dunklem Gang");
SP(P_INT_LONG, BS(
"Hier beginnt sich die normale Welt bereits aufzuloesen und mit der Dimension "
"des Schreckens zu vermischen. Undurchdringbarer Nebel und giftige Daempfe "
"verperren Dir fast jegliche Sicht. Vom Boden steigen gelbe Schwefeldaempfe auf, "
"die sich im Nirgendwo ueber Dir verlieren. "));

 SetProp( P_INDOORS, 1);
 SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20,ENV_TERRAIN:TT_CAVE]) );

AD("nirgendwo",
"Was ober Dir ist, weisst Du nicht. Der Himmel sicher nicht.");
AD("himmel",
"Der kann Dir hier auch nicht mehr helfen.");
AD("decke",
"Nein."),
AD(({"wand","waende"}),
"Waende sind hier sicher keine. Trotzdem fuehrt ein Tor wieder zurueck in Deine Welt.");
AD("tor",
"Das Tor ist im Osten.");
AD("osten",
"Im Osten kommst Du wieder zurueck.");

AD("boden",
"Der Boden ist wegen der Daempfe nicht zu erkennen. Du entdeckst trotzdem "
"eine Leiche, die halbverfault am Boden liegt.");
AD("leiche",
"Die Leiche ist schon ziemlich verwest.  Sie starrt Dich aus toten Augen an.");
AD(({"auge","augen"}),
"Leer und verfault. Grausig.");
AD("nebel",
"Der Nebel scheint hier zu leben, er tanzt um Dich herum und scheint Dich zu "
"verhoehnen. Im Nordwesten scheint er sich etwas zu lichten.");
AD("nordwesten",
"Hier scheint es weiter zu gehen.");
AD(({"dampf","daempfe"}),
"Gruen und gelb umhuellen sie Dich und ab und zu glaubst Du eine "
"Gestalt zu erkennen.");
AD("gestalt",
"Du hast Dich wohl geirrt.");
AD("sicht",
"Die Daempfe und der Nebel machen die Sicht sehr schwer...");
AD(({"schwefel","schwefeldampf","schwefeldaempfe"}),
"Die Schwefeldaempfe sind hochgiftig. Du solltest hier nicht allzu lange bleiben.");

AD("welt",
"Alles was Du bisher kanntest endet hier...");
AD("alles",
"Dein geliebtes Silberland endet hier ebenso wie Dein mickriges Leben.");
ASD("leben", "show");
AD("silberland",
"Das Silberland loest sich hier auf um in die Dimension des Schreckens ueberzugehen.");
AD("dimension",
"Du bist dabei die Dimension des Schreckens zu betreten, wo Daemonen und "
"Untote herrschen.");
AD("schrecken",
"Dein Leben ist hier nichts mehr wert.");
AD(({"daemon","daemone"}),
"Sie lieben es Sterbliche wie Dich zu zerfetzen.");
AD("sterbliche",
"Der Namenlose teilt Dir mit: Sterblicher, ich warte...");
AD(({"untote","untoter"}),
"Bald bist Du einer von ihnen...");
 SetProp(P_HIDE_EXITS, ({"nordwesten"}) );

AddExit("nordwesten", "./dampf2");
AddExit("osten", "/d/unterwelt/dante/skel/portal2");

AddExit("norden", "./dampf1");

AddExit("westen", "./dampf1");
AddExit("sueden", "./dampf1");
AddExit("nordosten", "./dampf1");
AddExit("suedosten", "./dampf1");
AddExit("suedwesten", "./dampf1");
ASE("nordsueden", "gag");

}

int gag()
{
write("Du versuchst gleichzeitig nach Norden und Sueden zu gehen.\n"
"Du scheiterst knapp und es zerreisst Dich fast!!! AAAAAA!!!!!!!!!!\n");
TP->do_damage(10+random(10));
return 1;
}

string show()
  { 
  domainshout(CAP_TPN+" hat im Moment noch"+TP->QueryProp(P_HP)+" Lebenspunkte!\n");
 write("Du hast im Moment noch "+TP->QueryProp(P_HP)+" Lebenspunkte.\n"
  "Wenn Du sie behalten willst, kehre besser um.\n");
  return "";
  }
  
  
  init() {
  ::init();
  if(interactive(TP)) {
  call_out("gift1", 240); }
  }
  
  
    
   gift1()
  {
  if (TO!=environment(TP)) return 1;
  
  write("Die giftigen Daempfe machen Dir ziemlich zu schaffen."),
  TP->AddPoison(1+random(2));
  call_out("gift2", 120);
  }

   gift2()
  {
  if (TO!=environment(TP)) return 1;
  
  write("Der Schwefel beginnt Deine Lunge zu zerfressen."),
  TP->AddPoison(2+random(2));
  call_out("gift1", 120);
  }
  
  