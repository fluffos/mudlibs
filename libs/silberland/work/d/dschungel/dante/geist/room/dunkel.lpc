
#include "/players/dante/myowndefine.h"

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>


create()
{
  ::create();
   SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20,ENV_TERRAIN:TT_SWAMP]) );    
    SetProp( P_INDOORS, 0);      


SP(P_LIGHT, -3-random(2));
//die frucht auf den plantagen und der daemonenstein  sind so hell
SP(P_INT_SHORT, "In ewiger Dunkelheit");
SP(P_INT_LONG, BS(
"Hier herrscht ewige Dunkelheit. Nur sehr wenige Objekte ermoeglichen "
"es Dir hier etwas zu erkennen. Trotzdem kannst Du kaum etwas erkennen. "
"Dunkle Schatten scheinen um Dich herum zu tanzen. Schemenhaft glaubst Du "
"haessliche Fratzen, die Dich verhoehnen, zu sehen. Real oder nur ein "
"boeses Trugbild, dass weiss niemand."));

AD("trugbild",
"Wahr oder fiktiv. Das zaehlt hier nicht. Ob Du ein Held wirst, das ist die Frage.");
AD("held",
"Wer Dantes Boeses Ich besiegt, erloest die Seelen der Opfer.");
AD("material",
"Das Material absorbiert das Licht. Irgendwie scheint das Licht im engsten "
"Sinne des Wortes fuer Dich sehr wichtig zu sein!");
AD(({"wort","wortes","worte"}),
"Licht");
AD(({"sinn","sinne"}),
"Hmm, was hat schon einen...");
AD("fall",
"Der Fall ist, was der Fall ist.");

ASD("frage",  "get");
AD(({"fratze","fratzen"}),
"Sie grinsen veraechtlich und gleichzeitig mitleidsvoll. Scheinbar wissern sie "
"was Dir bevorsteht. Es handelt sich bei all den Fratzen und Schatten um die "
"Seelen der Opfer von Dantes boesem Ich.");
AD("opfer",
"Unzaehlige Opfer muessen hier auf alle Zeit in ewiger Dunkelheit hausen. "
"Nur wer das Boese Ich besiegt kann sie erloesen.");
AD("zeit",
"Fuer immer!");
AD(({"seele","seelen"}),
"Sie sind fuer immer hier gefangen. Sicher kein lustiges Schicksal.");
AD("schicksal",
"Ob es Dir auch so ergehen wird?");

AD("schatten",
"Die Schatten sind manchmal da, manchmal nicht. Sie wollen Dir etwas sagen. "
"Nein, das scheint eher eine Warnung zu sein.");
AD("warnung",
"Huete Dich vor Dantes boesem Ich.");
AD(({"boese","ich","boeses ich", "dantes boeses ich"}),
"Es treibt sich angeblich hier herum.");
AD("dunkelheit",
"Die Dunkelheit umhuellt Dich total. Manchmal glaubst Du etwas zu erkennen, "
"doch sicher bist Du Dir da nicht.");
AD("objekte",
"Eine seltsame Frucht soll auch hier Licht spenden koennen und der sagenumwobene "
"Daemonenstein auch.");
AD("frucht",
"Hmm, sie soll im Dschungel wachsen.");
AD("dschungel",
"Weit, weit weg von hier.");
AD(({"stein","daemonenstein"}),
"Der soll irgendwo vergraben sein. Der Boden soll an dieser Stelle extrem hart sein.");
AD("stelle",
"Geh von der grossen Statue immer nordwaerts.");
AD("statue",
"Sieht man von hier aus nicht.");


AD("decke",
"Decke gibt es hier keine, aber einen Himmel.");
AD("himmel",
"Dunkel und drohend haengt er ober Dir..");
AD(({"wand","waende"}),
"Waende gibt es hier auch keine. Die Dunkelheit scheint auch raeumlich ewig zu sein.");
AD("osten",
"Im Osten kannst Du etwas Licht erkennen.");
AD("licht",
"Etwas Licht scheint aus dem Osten sogar bis hier her. Vielleicht kommt man ja "
"so irgendwie wieder hier heraus. Das Licht scheint auf jeden Fall wichtig zu sein.");
AD("boden",
"Der Boden scheint aus einem Dir unbekannten Material zu bestehen. Er absorbiert "
"alles Licht.");


SP(P_HIDE_EXITS, ({"licht"}));

AddExit("nordwesten", "./dunkel");
AddExit("westen", "./dunkel");
AddExit("norden", "./dunkel");

ASE("osten", "gag");
AddExit("sueden", "./dunkel");
AddExit("nordosten", "./dunkel");
AddExit("suedosten", "./dunkel");
AddExit("suedwesten", "./dunkel");
AddExit("licht", "./g37");
ACD(({"der namenlose","namenloser"}), "come");

}


int come() {
object ob, da;

if(present("ich", environment(TP)))  {
write("Irgendetwas hindert Dich daran!\n"); return 1;}

da=find_living("ich");
if(da)  {
write("Nein, irgendetwas will das nicht.\n");  return 1; }


else  {
write("Du murmelst den Namen des Namenlosen und...\n");

ob=clone_object("/d/dschungel/dante/geist/npc/boesesich");
ob->move(TO, M_TPORT);
return 1;} return 0; }




int gag()
{
write("Du willst nach Osten, doch die Dunkelheit haelt Dich einfach auf.\n");
say(CAP_TPN+" versucht verzweifelt nach Osten zu gehen.\n");
return 1;}




string get()
{
write(
"Eine dunkle Stimme lacht kurz boese auf und stellt Dir folgende Frage:\n"
"Oh "+TPN+", was wagst Du Dich in mein Reich. Verloren bist Du\nwenn "
"Du nicht weißt den Namen des Herrschers aller Daemone.\n"
"syntax <name>.\n");    return "";   }

