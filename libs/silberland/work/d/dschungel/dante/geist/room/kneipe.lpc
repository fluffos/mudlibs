// kneipe by dante

#include "../def.h"

inherit "std/pub";
#include <pub.h>  
#include <properties.h>
#include <language.h>
#include <moving.h>
#include <player.h>

 int obj, hacke;

create()
{
  ::create();

obj = 1;
hacke=1+random(2);

  SetProp(P_LIGHT, 1);
   SetProp (P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:20]));   
  SetProp( P_INT_SHORT, "Die Kneipe in der Dimension der Daemonen" );

SetProp(P_PUB_FLAGS, PUB_HASKEEPER+PUB_NEEDSKEEPER);
 SetProp(P_PUBKEEPER_ID, "garto");
      SetProp(P_PUBKEEPER_NAME, "Garto Gnadenstoss");
 SetProp(P_PUBMSG_NOKEEPER, "Sorry, aber Garto Gnadenstoss ist nicht hier.\n");
SetProp(P_PUBMSG_NOENEMY, BS(
"Garto Gnadenstoss serviert DIR hoechstens den Tod!"));

 SetProp(P_PUBMSG_NOINVITE, BS(
 "Garto Gnadenstoss serviert Dir sicher nichts!"));
 SetProp(P_PUBMSG_FIGHTING, "Garto Gnadenstoss ist doch beschaeftigt!!!\n");
                            
  
  
  SetProp( P_INT_LONG, BS(
    "Du stehst hier mitten in der Daemonen- und Daemonenjaegerkneipe. Ueberall "
    "liegen Truemmer und zerbrochen Glaeser herum. Die Daemonen haben bei ihrer "
    "letzten Orgie dieses Chaos angerichtet und seitdem haben sie hier auch "
    "Lokalverbot. Du kannst ueberhaupt froh sein, dass man hier noch etwas "
    "bestellen kann.")+
    "Eine grosse Tafel.\n"
    "Ein kleines Schild.\n");
    AddDetail(({"daemonenjaeger","jaeger","daemonenjaegerkneipe"}),
    "Normalerweise sollte hier immer ein Daemonenjaeger, der Dich "
    "bewirten kann, sein.");
    AddDetail(({"wand","waende"}),
    "Die Waende sind aus stabilem Holz gefertig.");

AddItem("d/dschungel/dante/geist/npc/garto", REFRESH_DESTRUCT);

    AddDetail("holz",
    "Das Holz hat die Daemonen nicht unversehrt ueberstanden. "
    "Ueberall hat es Loecher und Dellen.");
    AddDetail(({"loecher","loch"}),
    "Die Loecher sind teilweise sehr tief.");
    AddDetail(({"delle", "dellen"}),
    "Hmm , eine sieht recht seltsam aus...");
    AddDetail("moment",
    "Hier ist es angenehm ruhig.");
    
    AddDetail(("schild"),
    "Du kannst es lesen...");
    AddReadDetail(("schild"),
    "+------------------+\n"
    "|                  |\n"
    "|     Der Wirt     |\n"
    "|                  |\n" 
    "|  empfiehlt heute |\n"
    "|                  |\n"
    "|     unseren      |\n"
    "|                  |\n"
    "|  DAEMONENKILLER  |\n"
    "|                  |\n"
    "|       zum        |\n"
    "|                  |\n"
    "|    Sonderpreis   |\n"
    "|                  |\n"
    "+------------------+\n");
    AddDetail(({"daemon","daemonen"}),
    "Im Moment ist keiner hier, aber draussen findest Du bestimmt einen...");
    AddDetail(({"geister","geist"}),
    "Seit Krieg zwischen den Daemonen und den Geistern herrscht ist diese Kneipe "
    "ausgestorben...");
    AddDetail(({"verbot","lokalverbot"}),
    "Hier scheint es sicher zu sein vor den Daemonen...");
  AddDetail(("chaos"),
  "Du stehst mitten im Chaos, das die Daemonen hinterlassen haben.");
  AddDetail(("orgie"),
  "So wie es hier aussieht, muessen die Daemonen sehr arg gewuetet haben.");
  AddDetail(("kneipe"),
  "Die Kneipe war frueher ein beliebter Ort fuer Daemonen, aber "
  "mittlerweile ist sie nur mehr ein Haufen Truemmer...");
  AddDetail(("ort"),
  "Du stehst mitten in einer zertruemmerten Kneipe.");
  AddDetail(("haufen"),
  "Ueberall liegen zerbrochene Glaeser und Truemmer herum. He, was siehst "
  "Du da! Einen hellen Schimmer?!?");
  AddSpecialDetail(({"schimmer"}), "get");
  AddDetail(({"glas","glaeser"}),
  "Nur einige wenige sind ganz geblieben...");
  AddDetail(("truemmer"),
  "Die gesamte Einrichtung haben die Daemonen zerstoert...");
  AddDetail(("einrichtung"),
  "Von der Einrichtung ist nichts mehr zu sehen...");
  AddDetail(({"rahmen","bilderrahmen"}),
  "Der Rahmen ist breit und dick. Eine Klappe faellt Dir daran auf.");
  AddDetail(("klappe"),
  "Wozu sind klappen da...");
  AddDetail(("decke"),
  "An der Decke haengt ein grosser Kerzenleuchter.");
  AddDetail(({"leuchter","kerzenleuchter"}),
  "Der Kerzenleuchter haengt schief und halbzerbrochen von der Decke. "
  "Die Kerzen sind fast alle abgebrannt...");
  AddDetail(({"kerze","kerzen"}),
  "Eine einzelne Kerze brennt noch und Wachs tropft auf den Boden.");
  AddDetail(("boden"),
  "Der Boden ist uebersaeht mit Truemmern...");
  AddDetail(("wachs"),
  "Das Wachs tropft auf den Boden und bildet einen Kreis, weil der Leuchter "
  "hin und herschwankt...");
  AddDetail(("kreis"),
  "Der Kreis aus Wachs sieht wie ein Pentagramm aus...");
  AddDetail(("pentagramm"),
  "Die Spitzen des Pentagramms zeigen in verschiedene Richtungen, aber das "
  "sollte ja ohnehin logisch sein..");
  AddDetail(({"spitzen"}),
  "Die Spitzen sind voellig uninteressant. Nicht jedes Pentagramm hat eine "
  "Bedeutung...");
  AddDetail(("bedeutung"),
  "KEINE BEDEUTUNG!");
  AddDetail(({"richtungen","richtung"}),
  "Norden, Sueden, Osten, Westen, Nordosten, Nordwesten, Suedosten, Suedwesten.");
  AddDetail(({"Norden, Sueden, Osten, Westen, Nordosten, Nordwesten, Suedwesten"}),
  "Fein, dass Du so viele Himmelsrichtungen kennst...");
  AddDetail(("suedosten"),
  "Im Suedosten faellt dir an der Mauer ein Bild auf...");
  AddDetail(("mauer"),
  "Die Mauer besteht aus Ziegelsteinen.");
  AddDetail(({"ziegel","ziegelstein","stein","ziegelsteine","stein"}),
  "Die Ziegelsteine sind schwarz angepinselt...");
  AddDetail(("bild"),
  "Du gehst naeher an das Bild heran und stellst fest, dass das Bild "
  "verkehrt aufgehaengt ist..."); 
    
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp( P_ENVIRONMENT,([ENV_TEMPERATURE: 25]) );

AddDetail(("tafel"),
"Du kannst sie lesen.\n");
AddReadDetail(("tafel"),
 "+----------------+\n"
 "|                |\n"
 "|    DAEMONEN    |\n"
 "|                |\n"
 "|   haben hier   |\n"
 "|                |\n"
 "|  LOKALVERBOT!  |\n"
 "|                |\n"
 "+----------------+\n");


    
  AddSmell(DEFAULT_SMELL,
  "Hier riecht es nach Alkohol und frischem Fleisch.\n");
  AddSmell("alkohol",
  "Trink was!\n");
  AddSmell("fleisch",
  "Iss was!\n");
  
  AddSound(DEFAULT_SOUND,
  "Es ist hier im Moment sehr leise, aber das war nicht immer so...\n");


AddCmd(({"drehe","dreh"}), "pic");
AddCmd(({"oeffne"}), "open");



  AddDrink("Nebelbecher", ({"becher", "nebel", "nebelbecher"}),
    47+random(10), 13, 0, 6,
    ({"Du trinkst den halbfluessigen, weissen Nebelbecher.",
      "&& trinkt einen halbfluessigen, weissen Nebelbecher."}));
  AddDrink("Feiglingswasser", ({"feiglingswasser", "wasser", "feigling"}),
    65+random(10), 5, 0, 9,
    ({"Du bestellt Dir ein Feiglingswasser und bekommst eine warme Milch "
    "in einer Tasse serviert auf der Mamis Liebling steht.",
      "&& bestellt sich ein Feiglingswasser und jammert dabei aengstlich."}));
  AddDrink("Daemonenbraeu", ({"braeu", "daemonenbraeu"}),
    90+random(20), 20, 6, 9,
    ({"Du trinkst ein starkes, bitteres Daemonenbraeu.",
      "&& trinkt ein starkes, bitteres Daemonenbraeu."}));

  AddDrink("Flutwelle", ({"flutwelle", "welle", "flut"}),
    365+random(15), 50, 12, 12,"trinke_welle");
      
  AddDrink("Geisteratem",({"atem","geisteratem"}),
    243+random(17), 50, 12, 13,
    ({"Du bekommst ein voellig durchsichtiges Getraenk. Anfangs zoegerst "
      "Du, aber dann nimmst Du allen Mut zusammen und trinkst es mit einen "
      "Schluck weg.",
      "&& bekommt ein voellig durchsichtiges Getraenk. && zoegert zuerst, "
      "nimmt dann aber allen Mut zusammen und trinkt es mit einem Schluck "
      "weg."}));

 AddDrink("Brennendes Inferno",({"inferno","brennendes inferno"}),
    487+random(30), 100, 17, 15,
    ({"Du bekommst einfach einen grossen Topf brennenden Rum. "
      "Du trinkst den Topf leer, verbrennst Dir hoellisch die Zunge "
      "und weisst nun warum das Getraenk Inferno genannt wird.",
      "&& bestellt sich ein brennendes Inferno, trinkst es und hat danach einen "
      "hochroten Kopf und eine verbrannte Zunge."}));
      
  AddDrink("Daemonenblut", ({"blut", "daemonenblut"}),
    393+random(17), 140, 20, 18,
    ({"Du bekommst einen grossen Krug, der randvoll gefuellt ist mit "
      "schwarzem, dickfluessigem Blut der verschiedensten Daemonen. "
      "Du ekelst Dich, trotzdem schuettest Du es in Dich hinein und "
      "fuehlst Dich danach sehr stark.",
      "&& trinkt mit Ekel und Grausen einen grossen Krug, der randvoll "
      "mit Daemonenblut ist."}));
  AddDrink("Pestextrakt", ({"pest", "pestextrakt"}),
    173+random(14), 20, 14, 11,
    ({"Du trinkst ein Glas tiefschwarzen, bitteren Pestextrakt.",
      "&& trinkt mit verzogenem Gesicht ein Glas tiefschwarzen Pestextrakt."}));
  AddDrink("Heldentot", ({"tot", "heldentot","held"}),
    565+random(12),150, 22,22,
    ({"Mit geschwollener Brust leerst du den Becher voller Heldentot, "
    "und kommst Dir sehr mutig vor.",
      "&& trinkt mit geschwollener Brust einen Becher Heldentot und kommt sich sehr gut vor."}));


  AddFood ( "Daemonenauge", ({"auge", "daemonenauge", 
    }),  295+random(10), 35, 18,
    ({"Du bestellst Dir ein Daemonenauge und bekommst eine schleimige, "+
    "glitschrige Kugel serviert. Du wuergst das Auge runter und musst Dich "+
    "fast uebergeben.",
    "&& bekommt eine schleimige, glitschrige Kugel serviert, die && nur "
    "unter Wuergen vertilgt."}));
    
     AddFood ( "Nebelkuchen", ({"kuchen", "nebelkuchen", 
    }),  99+random(5), 15, 8,
    ({"Du bestellst Dir ein Stueck Nebelkuchen, das so leicht ist, "+
    "dass es Dir fast wieder aus dem Magen heraufschwebt.",
    "&& bekommt ein Stueck Nebelkuchen. "}));
    
  AddFood ( "Geisterhirn", ({"hirn", "geisterhirn"}), 
      412+random(10), 70, 20,
    ({"Du bekommst ein halbes Geisterhirn, dass erstaunlicherweise "+
    "koestlich schmeckt.",
    "&& bekommt ein halbes Geisterhirn. "}));
    
    AddFood ( "Toter Daemon", ({"toter daemon", "daemon","toter","toten"}), 
      710+random(33), 120, 29,
    ({"Du bestellt einen toten Daemonen und erhaeltst tatsaechlich einen "
    "ganzen, wenn auch kleinen gebackenen Daemonen, denn Du mit grosser "
    "Muehe verschlingst.",
    "&& bestellt sich eine ganzen, wenn auch kleinen toten Daemonen, den "
     "&& mit Muehe tatsaechlich alleine verschlingt."}));
     
     AddFood ( "Frisches Geisterherz", ({"herz", "geisterherz"}), 
      284+random(12), 30,15 ,
    ({"Du isst mit Gruseln ein frisches Geisterherz.",
    "&& isst mit Gruseln ein frisches Geisterherz."}));
    
     AddFood ( "Daemon a la Surprise", ({"surprise", "surpris"}), 
      183+random(15), 10,10 ,
    ({"Du bekommst den Daemon a la Surprise und bist sehr enttaeuscht. "
    "Die Ueberraschung besteht aus einem kleinen Marzipandaemon, der nicht einmal "
    "gut schmeckt...",
    "&& bestellt sich einen Daemon a la Surprise."}));
    
     AddFood ( "Magiergeschnetzeltes", ({"magier", "geschnetzeltes","magiergeschnetzeltes"}), 
      300+random(30), 28,13 ,
    ({"Das Magiergeschnetzeltes besteht aus geschnetzeltem Nostromo, der "
      "scheinbar einmal zu oft frech war. Nostromo schmeckt ziemlich zaeh und "
    "flachsig.",
    "&& bestellt sich ein Magiergeschnetzeltes und schaut ziemlich doof "
    "drein, als && sieht was && sich da eigentlich kommen hat lassen."}));
    
     AddDrink ( "Daemonenkiller", ({"killer", "daemonenkiller"}), 
      973+random(56), 170,25,28,
      ({"Du bestellt einen Daemonenkiller und fuehlst Dich bereit zu "
      "neuen Taten.",
      "&& bestellt sich einen Daemonenkiller und fuehlt sich bereit zu neuen Taten."}));
      
      
      AddDetail(({"daemonenkiller","killer"}),
      
    "Der Daemonenkiller ist das ultimative Kampfgetraenk, nur hat es manchmal "
      "kleine Nebenwirkungen... ");
    
  AddExit( "westen", "./g45" );
}



string get()  {

object hack;
write("Der Schimmer entpuppt sich als eine Daemonenhacke!\n");
if(!hacke)   {
write("Die Daemonenhacke ist alt und rostig, Du willst sie nicht.\n");  }

if(deep_present("D_HACKE", TP))  {
write("Hmm, noch eine Daemonenhacke. Nein!\n"); return ""; }

if(present("D_HACKE", environment(TP)))  {
write("Nimm doch die Hacke die da liegt!\n"); return "";}
 else
 {
 write("Du nimmst die Daemonenhacke zu Dir.\n");  
 hack=clone_object("d/dschungel/dante/geist/weapon/dhacke");
 hack->move(TP, M_GET);
 hacke--; return ""; }
  }
 
  





int trinke_welle(object z, object e)
{
switch(random(100))
{
case 0 .. 62 :
tell_object(e,BS(mess(
"Du bestellst Dir eine Flutwelle, trinkst sie sofort aus...",e)));
tell_room(ME,BS(UPPER(e->name())+" trinkt eine Flutewelle und..."),
({e}) );
break;

case 63 .. 83 : 
 tell_room(ME,BS(UPPER(e->name())+" trinkt eine Flutwelle und ploetzlich..."),
 ({e}) );
 
 tell_object(e," \n"
 "Du trinkst eine Flutwelle und ploetzlich...\n"
 "Ploetzlich schwinden Dir die Sinne, alles dreht sich und Du glaubst, dass "
 "Dich ein riesiger Daemon aus der Kneipe fortreisst...\n");

 TP->move("/d/dschungel/dante/geist/room/g7",M_NO_SHOW + M_GO, "weit weg geschleudert.",
 "wird","wird gereingeschleudert.");
 break;
 
 case 84 .. 93 :
 
 tell_room(ME,BS(UPPER(e->name())+" trinkt eine Flutwelle und ploetzlich..."),
 ({e}));
 tell_object(e," \n"
 "Du trinkst eine Flutwelle und ploetzlich...\n"
 "Ploetzlich schwinden Dir die Sinne, alles dreht sich und Du glaubst, dass "
 "Dich ein riesiger Daemon aus der Kneipe fortreisst...\n");

 TP->move("/d/dschungel/dante/geist/room/g1",M_NO_SHOW + M_GO, "weit weg geschleudert.",
 "wird","wird gereingeschleudert.");
 break;
 
 case 94 .. 99 :
 
 tell_room(ME,BS(UPPER(e->name())+" trinkt eine Flutwelle und ploetzlich..."),
 ({e}));
 tell_object(e," \n"
 "Du trinkst eine Flutwelle und ploetzlich...\n"
 "Ploetzlich schwinden Dir die Sinne, alles dreht sich und Du glaubst, dass "
 "Dich ein riesiger Daemon aus der Kneipe fortreisst...\n");

 TP->move("/d/dschungel/dante/weg/room/jojobaum",M_NO_SHOW + M_GO, "weit weg geschleudert.",
 "wird","wird gereingeschleudert.");
 break;
  }
  
}

reset()
{
obj= 1;
hacke=1+random(2);
::reset();
}

int pic(string str)
{
notify_fail("Was willst Du hier umdrehen ?\n");
if ( !str)
return 0;

if ( member ( ({"bild um","bild herum","bild richtig"}),str ) !=-1)
{
if (obj)
{
 write( " \n"
"Du drehst das Bild um, eine Klappe am Rahmen springt auf und ein "
"seltsamer Gegenstand wird in deine Arme geschleudert.\n"
"Das Bild dreht sich danach wieder in seine alte Position zurueck.\n");
say(""+TPN+" macht sich an der Wand zu schaffen...\n");
CLONE(OBJ"flucht",TP);
obj--;
 return 1;
 }
  write( " \n"
"Du drehst das Bild um, eine Klappe am Rahmen springt auf und ein "
"kleiner Daemon schnellt hervor. Er schlaegt Dir mit der Faust ins Gesicht und verschwindet dann wieder.\n"
"Das Bild dreht sich danach wieder in seine alte Position zurueck.\n");
say(""+TPN+" macht sich an der Wand zu schaffen...\n");
 TP->reduce_hit_points(random(10));
return 1;
}
return 0;
}


int open(string str)
{
notify_fail("Was willst Du oeffnen ?\n");
 if (!str) return 0;
  if ( str =="klappe")
  {
  write(" \n"
  "Du versuchst die Klappe zu oeffnen, aber so geht sie sicher nie auf.\n");
  say(""+TPN+" reisst verzweifelt an einer Klappe herum.\n");
  return 1;
  }
  return 0;
  }
  
