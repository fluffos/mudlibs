// naturgeist die erste

#include "files.h"

inherit ROOM "geist_inh";

#include <properties.h>
#include <language.h>
#include <moving.h>
create()
{
//  ::create();
  make_room();
  SetProp( P_INT_LONG, BS(
    "Du hast Dich nun endgueltig im dichten Nebel verlaufen. Hinter Dir, vor Dir,"
    " nichts als Nebelschwaden. Einzig die Lichtpunkte sind eine kleine Abwechslung in"
    " dieser trueben, monotonen Landschaft. Seltsam, aber ein Seil haengt vom Himmel "
    "herab..."));
    AddDetail(("himmel"),
    "Wohin das Seil in den Himmel fuehrt kann man wegen des Nebels nicht erkennen.");
    AddDetail(("seil"),
    "Das Seil fuehrt direkt nach oben in den Nebel..."); 
   

  AddExit("osten", "./g9");
    AddExit( "norden", "./g80");
      AddExit( "westen", "./g7" );
        AddExit( "sueden", "./g17" );
        

  
  AddCmd(({"kletter","klettere","steig","steige"}), "up");
}

int up(string str)
{
notify_fail("Womit willst Du wohin klettern ?\n");

if ( !str)
return 0;

if ( member( ({"mit seil nach oben","auf seil nach oben","an seil in himmel",
"mit seil in himmel","auf seil nach oben","an seil nach oben","mit seil rauf",
"an seil rauf","an seil hoch","mit seil hoch"}),str ) !=-1 )

{
write(" \n"
"Du kletterst am Seil nach oben...\n");
TP->move("/d/dschungel/dante/geist/room/seil", M_GO,
"am Seil nach oben.", "klettert",

"kommt aus dem Nebel von unten herauf geklettert.");
return 1;
}
return 0;
}
