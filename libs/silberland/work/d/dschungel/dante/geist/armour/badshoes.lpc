// ruestung
inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include "/players/dante/myowndefine.h"
#include <new_skills.h>

create()
{
if (!is_clone(this_object()))
return;
::create();

SetProp (P_SHORT, "Ein Paar schwarze Stiefel");
SetProp (P_LONG, BS(
"Diese Stiefel bestehen aus purer Magie. Sie sind ist voellig schwarz und absorbieren das Licht fast vollstaendig."));
SetProp (P_INFO, "Diese Stiefel werden Dir sicher helfen.\n");
SetProp (P_NAME, "Paar Stiefel");
SP(P_NAME_ADJ, "schwarz");
SetProp (P_GENDER, NEUTER);

SP(P_NODROP, 1);
SP(P_NEVERDROP, 1);


AddId (({"stiefel","BAD_SHOES","schwarze stiefel","paar"}));
SetProp (P_WEIGHT, 400);
SetProp (P_NOBUY, 1);
SetProp (P_VALUE, 3000);
SetProp (P_ARMOUR_TYPE, AT_BOOT);
SetProp (P_AC, 7);
SetProp(P_RESISTANCE, ({DT_AIR, DT_TERROR, DT_UNHOLY}));
SetProp(P_MATERIAL, ([MAT_MISC_MAGIC:100]));
SP(P_WEAR_FUNC, TO);
}

int WearFunc(object me , int silent)
{
tell_object(environment(TO),
"Die schwarzen Stiefel fluestern: Wir sind bereit fuer das Boese Ich!\n");
return 1;
}


