inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include "../def.h"
#include <new_skills.h>
#include "/gilden/druidenzirkel/druiden_extern.h"

create()
{
  if (!is_clone(this_object()))
     return;
  ::create();

  SetProp (P_SHORT, "Ein Orkandaemonumhang");
  SetProp (P_LONG, (
    "Dieser Umhang gehoerte einst einem maechtigen Orkandaemon. "
    " Er trug ihn selbst als Schutz vor seinen toedlichen Orkanen."));
  SetProp (P_INFO, "Der Orkandaemonumhang ist  hervorragend. \n");
  SetProp (P_NAME, "Orkandaemonumhang");
  SetProp (P_GENDER, MALE);
  AddId (({"umhang","orkandaemonumhang"}));
  SetProp (P_WEIGHT, 600);
  SetProp (P_NOBUY, 1);
  SetProp (P_VALUE, 2800+random(1000));
  SetProp (P_ARMOUR_TYPE, AT_CLOAK);
  SetProp (P_AC, 7+random(4));
  SetProp(P_MAGIC, 1);
  SetProp(P_DAM_PROTECTION, QueryProp(P_DAM_PROTECTION)
      +([DT_AIR:1, DT_TERROR:1, DT_UNHOLY:1]));
  SetProp(P_MATERIAL, ({MAT_MAGIC, MAT_AIR}));
  SetProp(P_WEAR_RESTRICTIONS, ([SR_SEER:1, SR_GOOD:0, A_INT:13]) );
  SetProp(P_ITEMD_ELEMENTAL_VALUE, (["luft": 3]) ); 
}
