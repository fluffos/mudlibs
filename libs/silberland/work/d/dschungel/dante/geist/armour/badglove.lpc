// ruestung
inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include "/players/dante/myowndefine.h"
#include <new_skills.h>

create()
{
if (!is_clone(this_object()))
return;
::create();

SetProp (P_SHORT, "Ein Paar schwarze Handschuhe");
SetProp (P_LONG, BS(
"Diese Handschuhe bestehen aus purer Magie. Sie sind ist voellig schwarz und absorbieren das Licht fast vollstaendig."));
SetProp (P_INFO, "Diese Handschuhe werden Dir helfen.\n");
SetProp (P_NAME, "Paar Handschuhe");
SP(P_NAME_ADJ, "schwarz");
SetProp (P_GENDER, NEUTER);
AddId (({"handschuhe","BAD_GLOVE","schwarze handschuhe","paar"}));
SetProp (P_WEIGHT, 400);
SetProp (P_NOBUY, 1);
SetProp (P_VALUE, 3000);
SetProp (P_ARMOUR_TYPE, AT_GLOVE);
SetProp (P_AC, 7);
SetProp(P_RESISTANCE, ({DT_AIR, DT_TERROR, DT_UNHOLY}));
SetProp(P_MATERIAL, ([MAT_MISC_MAGIC:100]));
SP(P_WEAR_FUNC, TO);

SP(P_NODROP, 1);
SP(P_NEVERDROP, 1);


}

int WearFunc(object me , int silent)
{
tell_object(environment(TO),
"Die schwarzen Handschuhe fluestern: Wir sind bereit fuer das Boese Ich!\n");
return 1;
}


