// ruestung
inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include "/players/dante/myowndefine.h"
#include <new_skills.h>

create()
{
if (!is_clone(this_object()))
return;
::create();


SP(P_NODROP, 1);
SP(P_NEVERDROP, 1);

SetProp (P_SHORT, "Eine schwarze Hose");
SetProp (P_LONG, BS(
"Diese schwarze Hose besteht aus purer Magie. Sie ist ist voellig schwarz und absorbiert das Licht fast vollstaendig."));
SetProp (P_INFO, "Diese Hose rettet Dir Dein Leben!\n");
SetProp (P_NAME, "Hose");
SP(P_NAME_ADJ, "schwarz");
SetProp (P_GENDER, FEMALE);
AddId (({"BAD_TROUSER","hose"}));
SetProp (P_WEIGHT, 600);
SetProp (P_NOBUY, 1);
SetProp (P_VALUE, 3000);
SetProp (P_ARMOUR_TYPE, AT_TROUSERS);
SetProp (P_AC, 7);
SetProp(P_RESISTANCE, ({DT_AIR, DT_TERROR, DT_UNHOLY}));
SetProp(P_MATERIAL, ([MAT_MISC_MAGIC:100]));
SP(P_WEAR_FUNC, TO);
}

int WearFunc(object me , int silent)
{
tell_object(environment(TO),
"Die schwarze Hose fluestert: Ich bin bereit fuer das Boese Ich!\n");
return 1;
}


