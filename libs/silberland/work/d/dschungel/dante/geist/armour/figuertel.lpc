inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include "/players/dante/myowndefine.h"
#include <new_skills.h>

create()
{
if (!is_clone(this_object()))
return;
::create();

SetProp (P_SHORT, "Ein roter Feuerguertel");
SetProp (P_LONG, BS(
"Dieser Guertel besteht aus rotem Stahl, der sich kunstvoll "
"gewunden wie eine Schlange um Dich herum fuegt. Manchmal blitzen "
"rote Flammen auf und erhellen seinen Traeger."));
SetProp (P_INFO, "Der Feuerguertel kann Feuer abwenden!\n");
SetProp (P_NAME, "Feuerguertel");
SP(P_NAME_ADJ, "rot");
SetProp (P_GENDER, MALE);
AddId (({"feuerguertel","guertel"}));
SetProp (P_WEIGHT, 300);
SetProp (P_NOBUY, 1);
SetProp (P_VALUE, 5000);
SetProp (P_ARMOUR_TYPE, AT_BELT);
SetProp (P_AC, 5);
SetProp(P_RESISTANCE, ({DT_FIRE, DT_TERROR, DT_UNHOLY}));
SetProp(P_MATERIAL, ([MAT_MISC_MAGIC:10, MAT_STEEL:90]));
SP(P_WEAR_FUNC, TO);
  SetProp(P_DEFEND_FUNC, this_object());         
}

int WearFunc(object me , int silent)
{
tell_object(environment(TO),
"Der Feuerguertel umhuellt Dich schuetzend!\n");
return 1;
}


int DefendFunc(mixed dam_type,mixed spell,mixed enemy)

 {
 
   object pl,env;
   int schutz;
   schutz=50+random(50);
 
     
     if (!objectp(pl=QueryProp(P_WORN)))
         return 0;

           if (!pointerp(dam_type)) dam_type=({dam_type});
     if (member(dam_type,DT_FIRE)>=0) {
     if(!random(15))  {
  env=environment(pl);
  tell_object(pl,
  "Dein Fuerguertel schluckt den Angriff von "+enemy->name(WEM)+"!\n");
tell_object(env,capitalize(pl->name(WESSEN))+" Feuerguertel wehrt den "
"Angriff von "+enemy->name(WEM)+" ab!\n");
  return schutz;
     } }
  return 5;  }
     