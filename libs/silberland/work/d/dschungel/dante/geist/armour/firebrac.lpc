// ruestung
inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include "/players/dante/myowndefine.h"
#include <new_skills.h>

create()
{
if (!is_clone(this_object()))
return;
::create();
SetProp (P_SHORT, "Ein Paar Feuerarmschienen");
SetProp (P_LONG, (
"Dieses Paar Daemonenarmschienen ist aus haertestem Stahl gefertigt.  Seine Oberflaeche "
"ist feuerrot und sehr rauh. "
"Ab und zu zuengeln rote und gelbe Flammen ueber "
"die Oberflaeche."
" Innen sind sie mit weichem, feuerrotem Stoff ueberzogen, sodass "
"Du Dich nicht verletzen kannst. "));
AD("oberflaeche",
"Sie ist rauh und hart."),
AD("stoff",
"Der Stoff ist feuerrot und gefaellt Dir gut. Du erkennst eine kleines Schild.");
AD("schild",
"Lies es!");
ARD("schild",
"Besiege die 4 Grossen und Du triffst den Namenlosen!");
AD(({"flamme","flammen"}),
"Ab und zu zuengeln helle Flammen ueber die Armschienen.");
SetProp (P_NAME, "Paar Feuerarmschienen");

SetProp (P_GENDER, NEUTER );
AddId (({"armschienen","daemonenarmschienen","feuerarmschienen","schienen", "paar"}));
SetProp (P_WEIGHT, 500);
SetProp (P_NOBUY, 1);
SetProp (P_VALUE, 3600);
SetProp (P_ARMOUR_TYPE, AT_BRACERS);
SetProp (P_AC, 10);
SetProp(P_RESISTANCE, ({DT_HOLY, DT_TERROR, DT_UNHOLY, DT_FIRE}));
SetProp(P_MATERIAL, ([MAT_STEEL:80, MAT_SILK: 10, MAT_FIRE:10]));
SetProp(P_WEAR_RESTRICTIONS, ([A_INT:14]) );

}


