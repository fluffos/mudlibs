// ruestung
inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include "/players/dante/myowndefine.h"
#include <new_skills.h>

int counter=0;

create()
{
if (!is_clone(this_object()))
return;
::create();

SetProp (P_SHORT, "Ein  Krallenhelm");
SetProp (P_LONG, BS(
"Der Krallenhelm ist ueber und ueber mit spitzen Krallen aus Stahl besetzt. Sicher fuer jeden eine "
"brauchbare Waffe.")),
AD(({"waffe","krallen","kralle"}),
"Die Krallen koennen hart zustechen!");

SetProp (P_INFO, "Der Krallenhelm huetet ein schreckliches Geheimniss. \n");
SetProp (P_NAME, "Krallenhelm");

SetProp (P_GENDER, MALE);
AddId (({"helm","krallenhelm"}));
SetProp (P_WEIGHT, 300);
SetProp (P_NOBUY, 1);
SetProp (P_VALUE, 1400);
SetProp (P_ARMOUR_TYPE, AT_HELMET);
SetProp (P_AC, 10);//nuetz eh keinem was
SetProp(P_RESISTANCE, ({DT_AIR, DT_TERROR, DT_UNHOLY}));
SetProp(P_MATERIAL, ([MAT_STEEL:100]));
SP(P_WEAR_FUNC, TO);


}


int DoUnwear(int silent)  {
 remove_call_out("dam");
  return 0; }
  

int WearFunc(object me , int silent)
{
tell_object(environment(TO),
"Der Krallenhelm passt Dir sehr gut! ZU GUT!!!\n");
call_out("dam", 60);
return 1;
}


init()
{
object ob;
ob=environment(TO);
::init();
if(ob!=interactive() )
{
remove_call_out("dam");
}
}




int move(mixed dest,int method)
{
remove_call_out("dam");
return ::move(dest, method);
}




void dam()
{


switch(random(5))
{
case 0:
tell_object(environment(TO),
"Die Krallen bohren sich in Deinen Kopf!\n");
TP->do_damage(10+random(10));
break;
case 1:
tell_object(environment(TO),
"Der Krallenhelm schliesst sich immer fester um Deinen Kopf!\n");
TP->do_damage(15+random(10));
break;
case 2:
tell_object(environment(TO),
"Die Krallen fuegen Dir stechende Schmerzen zu.\n");
TP->do_damage(15+random(10));
break;
case 3:
tell_object(environment(TO),
"Der Krallenhelm zerquetscht Dir fast den Schaedel!\n");
TP->do_damage(15+random(20));
break;
case 4:
tell_object(environment(TO),
"Die Krallen bohren sich bis in Dein Hirn!\n");
TP->do_damage(10+random(15));
break;
default:write("GRRRRRR\n");
}
call_out("dam", 5+random(5));
counter++;
  if(counter>10)  {
  SetProp(P_CURSED, 1); //hihihihihihi freu!!!  
  }
}








