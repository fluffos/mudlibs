//dante stiefel fuer daemonen

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>
#include "../def.h"
create()
{
  if (!is_clone(this_object()))
     return;
  ::create();

  AddId (({"flutwellenstiefel","stiefel","daemonenstiefel","flutwellendaemonenstiefel"}));
  SetProp (P_SHORT, "Ein Paar Flutwellendaemonstiefel");
  SetProp (P_LONG, ("Die Flutwellenstiefel gehoerten einst einem Flutwellendaemonen. "
                   "Er trug sie selbst zum Schutz vor seinen eigenen Flutwellen."));
  SetProp (P_NAME, "Paar Flutwellendaemonstiefel");
  SetProp (P_GENDER, NEUTER);
  SetProp (P_WEIGHT, 700);
  SetProp(P_MATERIAL, MAT_MAGIC);
  SetProp (P_VALUE, 2500);
  SetProp (P_INFO, ("Die Flutwellenstiefel sind hervorragend.\n"));
  SetProp (P_ARMOUR_TYPE, AT_BOOT);  
  SetProp (P_AC, 9);
  SetProp(P_RESISTANCE, ({DT_WATER,DT_TERROR,DT_UNHOLY}));
  SetProp(P_MATERIAL, MAT_MAGIC);
  SetProp(P_NOBUY, 1);
  SetProp(P_WEAR_RESTRICTIONS, ([SR_SEER:1, SR_GOOD:0, A_INT:18]) );
}
