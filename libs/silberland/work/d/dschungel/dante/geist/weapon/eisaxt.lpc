/*

Die Eisaxt vom Eisdaemon dem 2 sterksten aller Daemone
nach dem Namenlosen! Extrem schwer zu bekommen!!!!

*/

inherit "std/weapon";

#include <properties.h>     // Properties definieren
#include <combat.h>         // Kampfspezifische Daten
#include <language.h>       // Definition von MALE, FEMALE, NEUTER, WER, ...
#include <new_skills.h>

#include "/players/dante/myowndefine.h"

create()
{

if (!is_clone(this_object()))
return;
::create();

SetProp (P_NAME, "Eisaxt");
SetProp (P_GENDER, FEMALE);
SP(P_NAME_ADJ, "dunkelblau");
SetProp (P_VALUE, 5005+random(101));
SetProp (P_WEIGHT, 1500);
SetProp (P_MAGIC, 1);
SetProp (P_WEAPON_TYPE, WT_AXE);
SP(P_LONG, BS(
"Diese Axt besteht aus einem Dir unbekanntem Eis, das dunkelblau schimmert. "
"Der Griff besteht aus haertestem Daemonenstahl. Vom Blatt der Axt "
"geht eine unheimliche Kaelte aus."));
AddId(({"axt","eisaxt"}));

AD("eis",
"Das Eis glaenzt dunkelblau.");
AD("griff",
"Der Griff besteht aus Daemonenstahl, der in das dunkelblaue Eis uebergeht.");
AD(({"stahl","daemonenstahl"}),
"Der Stahl ist enorm hart und fuehlt sich auch kalt an."),
AD("schneide",
"Das Blatt der Axt ist zweiseitig und scheint so kalt zu sein, dass Dich alleine "
"sein Anblick zu laehmen scheint. Eine wirklich grossartige Axt!");

SP(P_SHORT, "Eine dunkelblaue Eisaxt");

SetProp (P_DAM_TYPE, ({ DT_TERROR, DT_COLD}));
SetProp (P_NOBUY, 1);
SetProp (P_WC, 290);
SetProp (P_WC_FIX, 50);
SetProp( P_QUALITY_DECAY, 90);
SetProp (P_NR_HANDS, 1);
SetProp(P_HIT_FUNC, TO);
SetProp (P_MATERIAL, ([MAT_STEEL:10, MAT_ICE:90,]));
SetProp (P_WIELD_RESTRICTIONS, ([A_STR: 18, A_INT:15, A_DEX:15]));
SetProp(P_HIT_FUNC, TO);

}

int HitFunc(object enemy)
{
if(!random(10))
{
tell_object(environment(TO),
"Deine Eisaxt laesst "+enemy->name(WEN)+" im Kaelteschock kurz erstarren!\n");
enemy->SetProp(P_PARALYZED, ([PARALYZE_TIME: 2+random(4),
PARALYZE_MSG: "",
PARALYZE_MSG_OTHER: "%s gefriert zu Eis.",
PARALYZE_END: "",
PARALYZE_END_OTHER: "%s erwacht wieder aus "
+TP->QueryPossPronoun(FEMALE, WEN, SINGULAR)+" Eisstarre.\n"]));
return 0;
}
return 0;
}






