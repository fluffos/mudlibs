inherit "std/weapon";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include "/players/dante/myowndefine.h"
create()
{
  if (!is_clone(this_object())) return;
  ::create();

  AddId (({"hacke", "spitzhacke","D_HACKE"}));
  SetProp (P_SHORT, "Eine Daemonenhacke");
  SetProp (P_LONG, BS(
  "Diese Hacke wird von den Daemonen zum bearbeiten von Gestein verwendet. "
  "Sie ist extrem hart und zerhackt alle!\n"));
  SetProp (P_NAME, "Daemonenhacke");
   SetProp (P_GENDER, FEMALE);
SetProp(P_MAGIC, 1);

  SetProp (P_VALUE, 2000);
  SetProp (P_WEIGHT, 1000);

  SetProp (P_WEAPON_TYPE, WT_AXE);
  SetProp (P_DAM_TYPE, DT_SLASH);
  SetProp(P_NOBUY, 1);
  SetProp (P_WC, 100);
  SetProp (P_NR_HANDS, 2);
  SetProp (P_MATERIAL, ([MAT_TITANIUM:100]));
}

