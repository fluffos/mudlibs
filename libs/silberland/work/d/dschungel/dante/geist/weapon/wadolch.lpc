
inherit "std/weapon";

#include <properties.h>     // Properties definieren
#include <combat.h>         // Kampfspezifische Daten
#include <language.h>       // Definition von MALE, FEMALE, NEUTER, WER, ...
#include <new_skills.h>

#include "/players/dante/myowndefine.h"

int bad=2;



reset(){
::reset();
bad=2;
write("Boeses Wasser tropft aus den Poren des Dolches.\n");
}

create()
{

if (!is_clone(this_object()))
return;
::create();

SetProp (P_NAME, "Wasserdolch");
SetProp (P_GENDER, MALE);
SetProp (P_VALUE, 2005+random(101));
SetProp (P_WEIGHT, 700);
SetProp (P_MAGIC, 1);
SetProp (P_WEAPON_TYPE, WT_KNIFE);
SP(P_LONG, BS(
"Dieser Dolch besteht nicht aus Wasser. Lediglich aus den Poren an seiner Klinge "
"tropft manchmal etwas Wasser heraus."));
AD("wasser",
"Das Wasser stinkt und scheint nicht gerade gesund zu sein.");
AD("klinge",
"Die Klinge ist eher stumpf, weist aber einige kleine Poren auf");
AD(({"poren"}),
"Die Poren sind sehr fein. Wasser tropft manchmal heraus."),

AddId(({"dolch","wasserdolch"}));

SP(P_SHORT, "Ein Wasserdolch");

SetProp (P_DAM_TYPE, ({ DT_TERROR, DT_WATER}));
SetProp (P_NOBUY, 1);
SetProp (P_WC, 50);
SetProp (P_WC_FIX, 50);
SetProp( P_QUALITY_DECAY, 90);
SetProp (P_NR_HANDS, 1);
SetProp(P_HIT_FUNC, TO);
SP(P_INFO, "Du solltest Dich mit dem Wasserdolch einmal selbst stechen!");
SetProp (P_MATERIAL, ([MAT_STEEL:10, MAT_WATER:90,]));
SetProp (P_WIELD_RESTRICTIONS, ([A_STR: 10, A_INT:15, A_DEX:15]));
SetProp(P_HIT_FUNC, TO);
ACD(({"stich","steche"}), "bad");
}

int bad(string str)  {
NF("WEN willst Du mit dem Wasserdolch stechen? Dich selbst?!\n");
if(str=="dich selbst mit wasserdolch"||
   str=="dich selbst mit dolch")
   
   {


if(bad)  {
TP->SetProp(P_ALIGN, -1000);
write("Du stichst Dich mit dem Wasserdolch. Boeses Wasser fliesst in Dein Blut!\n");
say(CAP_TPN+" sticht sich selbst mit einem Wasserdolch.\n");
bad--;
return 1;
}
else
{
write("Du stichst Dich mit dem Wasserdolch. AUA!\n");
say(CAP_TPN+" sticht sich selbst mit einem Wasserdolch!\n");
return 1;
}
return 0;
}
return 0;  }




