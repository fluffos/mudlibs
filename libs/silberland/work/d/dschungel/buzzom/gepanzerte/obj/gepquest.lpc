
/*

 Das Questitem fuer die Gepanzerten Quest Buzzom@SL

*/

#include "../def.h"

inherit "std/thing";

#include <properties.h>
#include <language.h>


create() {
  if (!is_clone(this_object())) return;
  ::create();
  
  SetProp(P_SHORT, 0 );
  SetProp(P_LONG,  0 );
  SetProp(P_NAME, "Ich bin nur ein Questitem ;)");
  SetProp(P_GENDER, NEUTER);
  AddId("\n_invasion_quest");

  SetProp(P_MATERIAL, MAT_MISC );
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_NEVERDROP, 1);
}
