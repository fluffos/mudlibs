//buzzom@sl 2001

inherit "std/transport";
#include <properties.h>
#include <moving.h>
#include <language.h>
#include "/players/dante/myowndefine.h"




create()
{
  ::create();
  SetProp( P_NAME, "Lastenwagen" );
  AddId( ({ "wagen", "lastenwagen" }) );
  SetProp( P_GENDER, MALE );
  SetProp( P_INT_SHORT, "Auf einem Lastenwagen" );
  SetProp( P_INT_LONG,
    "Dieser Lastenwagen verkehrt zwischen Cugluch und dem Grenzgebiet. Er hat viele\n"+
    "wichtige Kriegsgeraetschaften geladen. Ausserdem versorgt er die Truppe mit \n"+
    "Proviant. \n"
	  );
  SetProp( P_SHORT, "Ein Lastenwagen" );
  SetProp( P_LONG, BS(
    "Dieser Lastenwagen verkehrt zwischen Cugluch und dem Grenzgebiet. Vier Tausendfuessler "
    "ziehen den Wagen, der von einer Heuschrecke gelenkt wird. "
    ));
  SetProp( P_LIGHT, 1 );
  
  
  
  SetProp( P_DEPARTMSG, ({
    "Der Kutscher knallt seine Peitsche auf die Tausendfuessler\n"
    "und der Wagen verlaesst @@QueryArrived@@.\n", 
    "Die Heuschrecke knallt ihre Peitsche auf die Tausendfuessler\n"
    "und der Wagen beginnt zu rollen.\n"
  }) );
      
  SetProp( P_ARRIVEMSG, ({
    "Der Lastenwagen erreicht @@QueryArrived@@.\n",
    "Ein Lastenwagen kommt langsam zum stehen.\n"
    }) );
    
  SetProp( P_ENTERMSG, ({
    "klettert auf den Lastenwagen",
    "kommt kletternd auf den Lastenwagen"
    }) );
	
  SetProp( P_LEAVEMSG, ({
    "springt vom Wagen",
    "springt vom Wagen"
    }) );

     SetProp( P_LEAVEFAIL, ({
     "Du bist noch nicht am Ziel Deiner Reise. Besser Du bleibst sitzen",
     "gruebelt vom Wagen zu springen. Laesst es dann aber doch sein"
     }) );

  SetProp( P_ENTERFAIL, "Es ist nur Platz fuer 4 Personen" );
  SetProp( P_MAX_PASSENGERS, 4 );

  
  AddDetail( ({ "wagen", "lastenwagen" }),
   "Dieser Lastenwagen verkehrt zwischen Cugluch und dem Grenzgebiet. "
   );
  
  AddDetail( ({ "kriegsgeraetschaften", "geraete", "geraetschaften"  }),
   "Waffen aller Art sind hier geladen. Sie werden an zum Grenzgebiet gebracht. "
   );
 
 AddDetail( ({ "waffen" }),
   "Aexte, Schwerter, Lanzen befinden sich unter den Waffen. "
   );
 
 AddDetail( ({ "axt", "aexte", "kampfaexte" }),
   "Normale Kampfaexte. "
   );
 AddDetail( ({ "schwerter", "schwert", "kampfschwerter" }),
   "Normale Schwerter. Bihaendige und Einhaendige. "
   );
 AddDetail( ({ "lanze", "lanzen" }),
   "Lange Lanzen zum Auspiessen von Gegnern. "
   );  
 AddDetail( ({ "nahrung", "proviant", "insektennahrung" }),
   "Zucker und andere Suesstoffe. "
   );
 AddDetail( ({ "zucker", "suesstoffe" }),
   "Sie sind energiereich. "
   ); 
  

  AddSound( ({DEFAULT_SOUND}), "Du hoerst nur das rauschen des Fahrtwindes.");
  AddSmell( ({DEFAULT_SMELL}), "Es riecht nach suesslich nach Insektennahrung.");

  AddCmd( ({ "kletter", "klettere"}), "enter_wagen" );
  AddCmd( ({ "verlasse", "verlass", "springe", "spring"}), "leave_wagen" );




AddRoute("/d/dschungel/buzzom/gepanzerte/room/weg_b10", 30,30, 
	 "eine tropische Wiese",
	 ({"wiese","tropische wiese","dschungel"}),
	 "zurueck zum Dschungel");
 AddMsg( "Der Wagen rauscht durch die endlosen tropischen Wiesen.\n", 10 );
 AddMsg( "Langsam aendert sich die Landschaft und die Wiesen verschwinden.\n", 10 );
 AddMsg( "Dunkle knorrige Baeume saeumen den Weg. In der Ferne siehst Du viele\n"
         "Krieger auf dem Weg nach Norden.\n", 10 );
 AddMsg( "Diese lange Fahrt macht Dich muede. Du schlaefst ein bisschen.\n", 25 );
 AddMsg( "Du wirst wieder wach. Im sueden kannst Du eine riesige Stadt erkennen.\n"
         "Ob das Cugluch ist?\n", 5 );




 AddRoute("/d/dschungel/buzzom/gepanzerte/room/stadt_g13", 30, 30, 
	  "eine Wagenstation",
	  ({"stadt","wagenstation","cugluch","station","hauptstadt"}),
	  "nach Cugluch" );
 AddMsg( "Du bist froh Cugluch wieder zu verlassen. Nichts koennte Dich dort halten.\n", 10 );
 AddMsg( "Die lange Fahrt macht Dich muede. Du schlummerst ein bisschen.\n", 25 );
 AddMsg( "Frisch ausgeruht schaust Du Dir die duestere aber dennoch beeindruckende\n"
         "Landschaft an.\n", 10 );
 AddMsg( "Langsam aendert sich die Landschaft und tropische Wiesen tauchen auf.\n", 10 );
 
 
 

Start();
}

enter_wagen(string str)
{  
  if (str=="auf wagen" || "auf lastenwagen")
    return Enter();
}

leave_wagen(string str)
{  
  if (str=="von wagen" || "von lastenwagen" || "wagen" || "lastenwagen")
    return Leave();
}
