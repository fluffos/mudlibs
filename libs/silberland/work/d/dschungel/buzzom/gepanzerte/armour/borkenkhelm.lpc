//Buzzom@SL 2000
inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  AddId (({"helm", "borkenkaeferhelm", "\nborkenkhelm"}));
  SetProp (P_SHORT, "Ein Borkenkaeferhelm");
  SetProp (P_LONG, "Der Helm sieht aus wie der Kopf eines Borkenkaefers. ");
  SetProp (P_NAME, "Borkenkaeferhelm");
  SetProp (P_GENDER, MALE);
  SetProp (P_WEIGHT, 200);
  SetProp(P_MATERIAL, ([ MAT_CHITIN:80, MAT_HORN:20]) );

  SetProp (P_ARMOUR_TYPE, AT_HELMET);
  SetProp (P_AC, 8);
  SetProp (P_VALUE, 1500);
  SetProp (P_QUALITY_DECAY, 150);
}
