inherit "/std/armour";

#include <properties.h>
#include <combat.h>

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT,"Eine Plattenhose");
  SetProp(P_LONG,
    "Diese Plattenenhose besteht aus lauter kleinen Eisenplatten die auf "
    "kunstvolle Art und Weise zusammen gefuegt wurden. Die Hose wurde "
    "wahrscheinlich einem Fisch imitiert, denn sie sieht durch ihre vielen "
    "Plaettchen schuppenartig aus. Sie bietet sicher einen guten Schutz vor "
    "Stichen und Hieben. " );
  SetProp(P_NAME, "Plattenhose");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"hose", "plattenhose"}));

  SetProp(P_ARMOUR_TYPE, AT_TROUSERS);
  SetProp(P_AC, 10);
  SetProp(P_MATERIAL, ([MAT_IRON:100]) );
  SetProp(P_WEIGHT, 4000);  
  SetProp(P_VALUE, 2500); 
  SetProp(P_QUALITY_DECAY, 115);
}

