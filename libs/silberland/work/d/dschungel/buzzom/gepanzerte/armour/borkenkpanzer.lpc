//Buzzom@SL 2000

inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein Borkenkaeferpanzer");
  SetProp(P_LONG, 
    "Der Panzer schuetzt den Borkenkaefer bei seiner Arbeit im Wald und "
    "vor starken Witterungseinfluessen. Wenn man ihn traegt, sieht man "
    "selber fast wie ein Borkenkaefer aus. ");
  SetProp(P_NAME, "Borkenkaeferpanzer");
  SetProp(P_GENDER, MALE);
  AddId( ({"panzer", "borkenkaeferpanzer", "\nborkenkpanzer"}) );
  SetProp(P_INFO,
    "Der Borkenkaeferpanzer ist thermoverstaerkt und schuetzt daher vor "
    "Witterungseinfluessen. Ausserdem passt er sich genau Deinem Koerper an "
    "und gibt Dir fast das Aussehen eines Borkenkaefers. ");

  SetProp(P_ARMOUR_TYPE, AT_ARMOUR );
  SetProp(P_AC, 30+random(7));
  SetProp(P_MATERIAL, ([ MAT_CHITIN:80, MAT_HORN:20]) );
  SetProp(P_WEIGHT, 1000);
  SetProp(P_VALUE, 3500);
  SetProp(P_NOBUY, 1);

// Thermoverstaerkung
  SetProp(P_DAM_PROTECTION, QueryProp(P_DAM_PROTECTION)
                            + ([DT_FIRE:1, DT_COLD:1]) );
  SetProp(P_TEMPERATURE_PROTECTION, ([ T_COLD_PROT:6, T_HEAT_PROT:2 ]) );

  

}
