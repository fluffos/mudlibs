//Buzzom@SL 2000

inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <mnpc.h>

// #include "../def.h"

//gardisten sollen sich gegenseitig helfen bei angriff
init()
{
  ::init();
  if (this_player() && this_player()->id("gardist")) AddDefender(this_player());
}


create()
{ object ob;
  if (!is_clone(this_object())) return;
  ::create();     
  
  SetProp(P_SHORT, "Ein Grenzgardist");
  SetProp(P_LONG,
    "Der Grenzgardist bewacht die Grenze zum Reich der Gepanzerten. Er ist relativ "
    "gut bewaffnet und traegt eine hervorragende Ruestung. Gegen eine feindliche Armee "
    "haette er allerdings im Kampf keine Chance. "
  );
  SetProp (P_NAME, "Grenzgardist");
  SetProp (P_GENDER, MALE);
  SetProp(P_RACE, "Mensch");
  AddId(({"grenzgardist", "gardist"}));
  create_default_npc (15);
  set_living_name("grenzgardist");
  
  SetProp(P_BODY, 100);
  SetProp(P_SIZE, 175);
  SetProp(P_HANDS, ({" mit seinen Haenden", 30}));
  SetProp(P_ALIGN, 300);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_XP,10000);
  SetProp(P_DIE_MSG, " bricht zusammen.\n");
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:       0.1, DT_COLD:      -0.7, DT_WATER:  -0.7, DT_AIR:    -0.5, 
      DT_LIGHTNING: -0.5, DT_EXPLOSION:  0.1, DT_SOUND:  -0.8, DT_LIGHT:  -0.7,
      DT_ELECTRIC:  -0.5, DT_ACID:      -0.8, DT_POISON: -0.7, DT_TERROR: -0.7,
      DT_HOLY:      -0.5, DT_UNHOLY:    -0.5, DT_MAGIC:  -0.5 ]) );
  SetProp(P_NOMAGIC,10);
  SetProp(P_MSGIN, "kommt an und beginnt seine Wache");
  SetProp(P_MSGOUT, "geht");
  
  SetProp(P_DEFAULT_INFO,"sagt: Frag den Grenzkommandanten.");
  
  seteuid(getuid(this_object()));
 
 //Ruestung
 clone_object("/p/armour/eisenpanzer")->move(this_object());
  command("trage panzer");
 
 clone_object("/p/armour/eisenhelm")->move(this_object());
  command("trage helm");
 
 clone_object("/p/armour/sandalen")->move(this_object());
  command("trage sandalen");
  
 //Waffe
 clone_object("/p/weapon/hellebarde")->move(this_object());
  command("zuecke hellebarde");
  
  
}

//gardisten helfen sich gegenseitig indem sie versuchen feind zu toeten
void InformDefend(object enemy)  
{
  Kill(enemy);
}

// nimmt das beste aus leiche unt traegt bzw zueckt es
void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  command_me("nimm alles aus leiche");
  command_me("ziehe alles aus");
  command_me("trage_beste_ruestungen");
  command_me("zuecke_beste_waffe");
  command_me("trage alles");
}