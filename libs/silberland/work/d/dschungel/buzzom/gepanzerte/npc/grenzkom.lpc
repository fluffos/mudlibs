//Buzzom@SL 2000

inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <mnpc.h>
#include <moredef.h>


// #include "../def.h"




create()
{ object ob;
  if (!is_clone(this_object())) return;
  ::create();     
  
  SetProp(P_SHORT, "Ein Grenzkommandant");
  SetProp(P_LONG,
    "Der Grenzkommandant befehligt die Grenzgardisten und bewacht die Grenze zum Reich "
    "der Gepanzerten. Er ist sehr gut bewaffnet und traegt eine hervorragende Ruestung. "
    "Auch Verwaltungsangelegenheiten des Grenzposten fallen in seinen Aufgabenbreich.  "
    "Er kann viele Fragen bezueglich der Grenze und ueber die Gepanzerten beantworten.  "
  );
  SetProp (P_NAME, "Grenzkommandant");
  SetProp (P_GENDER, MALE);
  SetProp(P_RACE, "Mensch");
  AddId(({"grenzkommandant", "kommandant"}));
  create_default_npc (32);
  set_living_name("grenzkommandant");
  
  SetProp(P_BODY, 100);
  SetProp(P_SIZE, 185);
  SetProp(P_HANDS, ({" mit seinen Haenden", 30}));
  SetProp(P_ALIGN, 500);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_XP,80000);
  SetProp(P_DIE_MSG, " bricht zusammen.\n");
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:       0.1, DT_COLD:      -0.7, DT_WATER:  -0.7, DT_AIR:    -0.5, 
      DT_LIGHTNING: -0.5, DT_EXPLOSION:  0.1, DT_SOUND:  -0.8, DT_LIGHT:  -0.7,
      DT_ELECTRIC:  -0.5, DT_ACID:      -0.8, DT_POISON: -0.7, DT_TERROR: -0.7,
      DT_HOLY:      -0.5, DT_UNHOLY:    -0.5, DT_MAGIC:  -0.5 ]) );
  SetProp(P_NOMAGIC,10);
  SetProp(P_MSGIN, "kommt an und beginnt seine Wache");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MURDER_MSG, "Buzzom wird mich raechen!");
  SetProp(P_KILL_MSG, "Die Grenze ist wieder gesichert.");
  
  SetProp(P_DEFAULT_INFO,"sagt: Alles weiss ich nun auch wieder nicht. ");
  SetProp(P_LOG_INFO, "invasion-quest.log");
  
  SetProp(P_SPELLRATE,30);

  AddSpell(1,650, 
    "Der Grenzkommandant zertruemmert mit seinem Hammer Deinen Schaedel.\n",
    "Der Grenzkommandant zertruemmert mit seinem Hammer @WESSEN Schaedel.\n",
    DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]) );
    
  AddSpell(1,450, 
    "Der Grenzkommandant zertruemmert mit seinem Hammer Dein rechtes Bein.\n",
    "Der Grenzkommandant zertruemmert mit seinem Hammer @WESSEN rechtes Bein.\n",
    DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]) );
  
  AddSpell(1,300, 
    "Der Grenzkommandant poliert Dir die Fresse.\n",
    "Der Grenzkommandant poliert @WEN die Fresse. \n",
    DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]) );
    
  SetChats(10, ({
  "Der Grenzkommandant murmelt: Ich glaube die Gepanzerten bereiten einen Angriff vor.\n",
  "Der Grenzkommandant fragt Dich: Hast Du Lust auf ein Abenteuer?\n",
  "Der Grenzkommandant unterhaelt sich mit einem Gardisten.\n",
  }) );
  
  AddInfo( ({ "abenteuer","quest","aufgabe","hilfe", "angriff", "abenteuer", "invasion"}), "@@hilfefkt@@" );
  
  AddInfo( ({"gepanzerte","gepanzerten", "insekten"}), 
    "Die Gepanzerten leben suedlich der Palisade. Es ist ein sehr kriegerisches "
    "Volk aus Insekten. Schon oft haben sie versucht Tijara zu erobern. ","sagt: ");
  
  AddInfo( ({"tijara"}), 
    "Tijara ist die groesste und reichste Stadt hier im Dschungel. "
    "Sie liegt westlich von hier. ","sagt: ");
  
  AddInfo( ({"mauer","palisade", "palisaden"}), 
    "Die Palisade ist zum Schutz vor den Gepanzerten gedacht. Schon "
    "vielen Angriffen hat sie standgehalten. ","sagt: ");
  
  AddInfo( ({"koenigin","skrritch"}), 
    "Das ist die Fuehrerin der Gepanzerten. Niemand hat sie bisher gesehen. ","sagt: ");
  
  AddInfo( ({"dschungel","wald"}), 
    "Ueberall hier ist Dschungel. Viele gefaehrliche Tiere kannst Du dort finden. ","sagt: ");
  
  AddInfo( ({"magie"}), 
    "Wahrscheinlich haben die Gepanzerten auch Magier, die sie schuetzen. ","sagt: ");
  
  AddInfo( ({"cugluch", "hauptstadt"}), 
    "Nur wenig ist ueber diese Stadt bekannt. Wir hoffen durch Dich mehr zu erfahren. ","sagt: ");
  
  AddCmd( "biete","bietefkt" );
  
  seteuid(getuid(this_object()));

 //Ruestung
 clone_object("/p/armour/plattenpanzer")->move(this_object());
  command("trage panzer");
 
 clone_object("/p/armour/eisenhelm")->move(this_object());
  command("trage helm");
 
 clone_object("/p/armour/panzerhandschuhe")->move(this_object());
  command("trage handschuhe");
 
 clone_object("/p/armour/lederstiefel")->move(this_object());
  command("trage stiefel");
 
 clone_object("/d/dschungel/buzzom/gepanzerte/armour/plattenhose")->move(this_object());
  command("trage hose");
  
 //Waffe
 clone_object("/p/weapon/kriegshammer")->move(this_object());
  command("zuecke hammer");
}

//Q U E S T "Invasion auf Tijara" 
string hilfefkt(string str) 
{

  if(!present("\n_invasion_quest",this_player())) 
  {
    write(break_string(
      "Durch unsere Spaehtrupps haben wir verstaerkte militaerische "
      "Aktivitaeten nahe der Grenze entdeckt. Ich glaube die Gepanzerten "
      "planen einen erneuten Angriff auf uns und die Stadt Tijara. "
      "Bisher konnten wir sie jedesmal zurueckschlagen, doch diesmal ist "
      "ihre Truppenstaerke einfach zu gross fuer uns. Ausserdem scheinen "
      "die Krieger durch eine Art Magie besonders motiviert. Wenn Du uns "
      "helfen willst den Angriff zu vereiteln, biete mir einfach Deine Hilfe "
      "an. Wenn Du erfolgreich bist, werden wir Dich reich belohnen. ",
      78,"Der Grenzkommandant sagt: "));
      return "hofft auf Deine Hilfe. ";
  }
  write(break_string(
    "Leider ist die Gefahr immer noch nicht gebannt. ",
    78,"Der Grenzkommandant sagt: "));
  return "seufzt.";
}

int bietefkt(string str) {
  object ob;


  notify_fail("Moechtest Du vielleicht Deine Hilfe anbieten?\n");
  if (str != "hilfe an" && str != "kommandant hilfe an" && str != "grenzkommandant hilfe an") return 0;
  if(present("\n_invasion_quest",this_player())) {
    write(break_string(
      "Aber Du hast mir Deine Hilfe doch schon angeboten. ",
      78,"Der Grenzkommandant sagt: "));
    return 1;
  }
  if(this_player()->QueryQuest("Invasion auf Tijara")) {
    write(break_string(
      "Du hast Tijara bereits gerettet. Wir alle danken Dir dafuer. ",
      78,"Der Grenzkommandant sagt: "));
    return 1;
  }
  write(break_string(
    "Also dann, "+CAP_TPN+". Um Tijara vor einer Invasion der Gepanzerten "
    "zu retten musst Du versuchen nach Cugluch, der Hauptstadt der "
    "Gepanzerten, zu kommen. Finde dort die Koenigin Skrritch und toete sie. "
    "Unserer Meinung nach sollte ohne Fuehrung kein Angriff mehr Zustande "
    "kommen. Beeile Dich, denn die Zeit ist knapp. ",
    78,"Der Grenzkommandant sagt: "));
  CLONE( "/d/dschungel/buzzom/gepanzerte/obj/gepquest" , this_player());
  write_file("/d/dschungel/buzzom/gepanzerte/log/quest.log", 
             dtime(time())+": "+CAP(getuid(this_player()))+" beginnt die Quest.\n" );
  return 1;
}

// nimmt das beste aus leiche unt traegt bzw zueckt es

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  command_me("nimm alles aus leiche");
  command_me("ziehe alles aus");
  command_me("trage_beste_ruestungen");
  command_me("zuecke_beste_waffe");
  command_me("trage alles");
}



