inherit "std/mnpc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <mnpc.h>

#include "../def.h"

init()
{
  object *ob, *hl;

  ::init();

  if(TP && interactive(TP))
  {
    ob = filter_objects( TP->QueryProp(P_ARMOURS), "id", "\nborkenkpanzer"); 
    if(!sizeof(ob)) Kill(TP);
    
    
    
   // write(BS(
   //   "ALARM!!! SPIONE SIND EINGEDRUNGEN!!!\n"));
  }

  if(TP && interactive(TP))
  {
    hl = filter_objects( TP->QueryProp(P_ARMOURS), "id", "\nborkenkhelm"); 
    if(!sizeof(hl)) Kill(TP);
    
    
    
   // write(BS(
   //   "ALARM!!! SPIONE SIND EINGEDRUNGEN!!!\n"));
  }
}


