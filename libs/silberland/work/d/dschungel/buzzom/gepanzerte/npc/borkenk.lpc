create()
{ object ob;
  if (!is_clone(this_object())) return;
  ::create();     
  
  SetProp(P_SHORT, "Ein Holzfaellerkaefer");
  SetProp(P_LONG,
    "Dieser Holzfaeller sieht einem Borkenkaefer sehr aehnlich. Nur Groesse und "
    "Kleidung unterscheiden ihn doch erheblich. Er ist so sehr mit seiner Arbeit "
    "beschaeftigt, dass er Dich gar nicht beobachtet. Besonders intelligent scheint "
    "er auch nicht zu sein. "
  );
  SetProp (P_NAME, "Holzfaellerkaefer");
  SetProp (P_GENDER, MALE);
  SetProp(P_RACE, "Kaefer");
  AddId(({"holzfaellerkaefer", "kaefer", "insekt", "gepanzerter"}));
  create_default_npc (13);
  set_living_name("holzfaellerkaefer");
  
  SetProp(P_BODY, 100);
  SetProp(P_SIZE, 150);
  SetProp(P_HANDS, ({" mit seinen Vorderzangen", 100}));
  SetProp(P_ALIGN, -200);
  SetProp(P_MAX_HANDS, 6);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_XP,55000);
  SetProp(P_DIE_MSG, " sackt zusammen.\n");
  SetProp(P_RESISTANCE_STRENGTHS , 
    ([DT_FIRE:       0.1, DT_COLD:      -0.7, DT_WATER:  -0.7, DT_AIR:    -0.5, 
      DT_LIGHTNING: -0.5, DT_EXPLOSION:  0.1, DT_SOUND:  -0.8, DT_LIGHT:  -0.7,
      DT_ELECTRIC:  -0.5, DT_ACID:      -0.8, DT_POISON: -0.7, DT_TERROR: -0.7,
      DT_HOLY:       0.5, DT_UNHOLY:    -0.5, DT_MAGIC:   0.0 ]) );
  SetProp(P_NOMAGIC,10);
  SetProp(P_MSGIN, "kommt an und beginnt mit der Arbeit");
  SetProp(P_MSGOUT, "geht");
  
  SetProp(P_DEFAULT_INFO,"sagt: Ich hab keine Zeit. ");
      
  seteuid(getuid(this_object()));
 
 //Ruestung
 clone_object("/d/dschungel/buzzom/gepanzerte/armour/borkenkpanzer")->move(this_object());
  command("trage panzer");
 
 clone_object("/d/dschungel/buzzom/gepanzerte/armour/borkenkhelm")->move(this_object());
  command("trage helm");
   
 //Waffe
 clone_object("/p/weapon/axe/handaxt")->move(this_object());
  command("zuecke axt");
  
 
  
}



