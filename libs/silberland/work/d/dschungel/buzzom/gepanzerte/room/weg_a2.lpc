inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <verben.h>
#include "../def.h"

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Eine Lichtung" );
  SetProp( P_INT_LONG,
   "Eine grosse Lichtung erstreckt sich hier entlang der Palisade, welche nun "
   "hinter Dir liegt. Wahrscheinlich wurde diese freie Flaeche zum besseren Blick "
   "auf das Grenzgebiet gerodet. Weiter suedlich beginnt der duestere Dschungelwald. "
   "Seitlich des Weges wachsen einige dunkle Pflanzen. Ab und zu sieht man auch "
   "einen Baumstumpf herausragen. "
   );
	
   SetProp( P_LIGHT, 1 );
   SetProp(P_INDOORS, 0 );
   SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_JUNGLE]) );
  
  AddDetail( ({ "weg", "boden", "pfad" }),
   "Seitlich des Weges wachsen einige dunkle Pflanzen. "
   );
  AddDetail( ({ "pflanze", "pflanzen" }),
   "Die Pflanzen sehen zwar tropisch aus, sind jedoch ganz dunkel statt gruen. "
   );
  AddDetail( ({ "himmel", "blau" }),
   "Der Himmel prangt ueber Dir. "
   );
  AddDetail( ({ "lichtung", "flaeche", "rodung"}),
   "Die Lichtung erstreckt sich hier entlang der Palisade. "
   );
  AddDetail( ({ "palisade", "mauer", "palisadenmauer" }),
   "Von dieser Seite sieht die Mauer schon sehr beschaedigt aus. Sie scheint schon "
   "des oefteren in Kampfhandlungen verwickelt gewesen zu sein. "
   );
  AddDetail( ({ "kampfhandlung", "kampfhandlungen" }),
   "Im Augenblick scheint keine Kampfhandlung im Gange zu sein. "
   );
  AddDetail( ({ "augenblick" }),
   "Jetzt. "
   );
  AddDetail( ({ "seite" }),
   "Die andere Seite der Mauer halt. :) "
   );
  AddDetail( ({ "blick" }),
   "Ja, so laesst es sich viel besser nahende Truppen zu entdecken. "
   );
  AddDetail( ({ "truppen" }),
   "Zum Glueck sind noch keine da. "
   );
  AddDetail( ({ "glueck" }),
   "Hoffentlich hast Du genug davon. "
   );
  AddDetail( ({ "grenzgebiet", "grenze", "gebiet" }),
   "Hier ist das Grenzgebiet. Es trennt den Dschungel von Tijara mit dem Reich der "
   "Gepanzerten. "
   );
  AddDetail( ({ "reich", "gepanzerte" }),
   "Hier beginnt das Reich der Gepanzerten. Sei ja vorsichtig! "
   );
  AddDetail( ({ "dschungelwald", "wald", "baeume"}),
   "Du kannst momentan nur etliche merkwuerdige Baeume im Sueden erkennen. "
   );
  AddDetail( ({ "dschungel" }),
   "Noerdlich der Palisade geht es wieder zurueck in den Dschungel von Tijara. "
   );
  AddDetail( ({ "baumstumpf", "stumpf" }),
   "Er ist ein Ueberbleibsel der Rodung. "
   );
  AddDetail( ({ "ueberbleibsel", "bleibsel" }),
   "Der Baumstumpf ist solch ein Ueberbleibsel. "
   );
   
  AddSound( DEFAULT_SOUND,
   "Abgesehen vom Wind hoerst Du nichts. ");

   
   
   AddExit( "nordosten", "./weg_b1" );
   AddExit( "sueden", "./weg_a3" );
   
}

