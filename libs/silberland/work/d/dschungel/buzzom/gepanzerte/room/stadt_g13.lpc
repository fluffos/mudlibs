inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
/*#include <verben.h>
#include "../def.h"*/

create()
{
  ::create();

  SetProp( P_INT_SHORT, "An einer Wagenstation" );
  SetProp( P_INT_LONG,
   "Hier befindest Du dich an der Wagenstation von Cugluch. Von hier aus kannst "
   "Du wieder in den normalen Dschungel zurueckreisen. Vor Dir kannst Du ein "
   "riesiges Tor erkennen, dass in eine Stadt zu fuehren scheint. Jedenfalls "
   "laesst die grosse Mauer in der das Tor eingelassen ist darauf schliessen. "
   "Vor dem Tor kannst du mehrere Wachen sehen, die jeden Fremdling davon "
   "abhalten werden, durch das Tor zu treten.\n"
   "Eine Tafel."
   );
	
   SetProp( P_LIGHT, 1 );
   SetProp(P_INDOORS, 0 );
   SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_JUNGLE]) );
  
  AddDetail( ({ "wagen" }),
   ""
   );
  AddDetail( ({ "wagenstation","station" }),
   "Du befindest Dich hier an der Wagenstation. Von hier aus kannst du wieder in "
   "den Dschungel zurueckreisen. "
   );
  AddDetail( ({ "wagen" }),
   "Im Moment ist kein Wagen hier, aber wenn Du noch ein Weilchen wartest wird "
   "bestimmt gleich einer auftauchen. "
   );
  AddDetail( ({ "dschungel" }),
   "Hier befindest Du Dich nicht mehr im Dschungel. Dies ist das Land der "
   "Insekten. "
   );
  AddDetail( ({ "tor" }),
   "Ein riesiges Tor erhebt sich vor Dir. Es besteht aus einem seltsam "
   "schimmernden Material. Das Tor siehts so schwer aus, dass Du Dir nicht "
   "vorstellen kannst, es allein bewegen zu koennen. "
   );
  AddDetail( ({ "material" }),
   "Es schimmert seltsam dunkel. Was es jedoch ist, kannst Du leider nicht "
   "erkennen. "
   );
  AddDetail( ({ "stadt","cugluch","insektenstadt" }),
   "Dies ist wahrscheinlich die sagenumwobene Insektenstadt Cugluch. Jeder "
   "Abenteurer, der sich hierher aufgemacht hat wurde nie wieder gesehen. "
   "Sie ist weniger wegen ihrer Reichtuemer als wegen der Brutalitaet ihrer "
   "Einwohner beruehmt. In ihrem Inneren beherbergt sie als kulturelles und "
   "spirituelles Zentrum den Palast der Koenigin. "
   );
  AddDetail( ({ "abenteurer" }),
   "Es waren alles verwegene Abenteurer, so wie Du einer bist. "
   );
  AddDetail( ({ "reichtum","reichtuemer" }),
   "Glaubst Du wirklich Insekten wuerden sich mit so etwas niedrigem wie Gold und "
   "Edelsteinen abgeben? "
   );
  AddDetail( ({ "gold","edelsteine","interesse" }),
   "Dafuer haben Insekten kein Interesse, ihr einziges Streben gilt dem Wohl der "
   "Koenigin."
   );
  AddDetail( ({ "koenigin" }),
   "Sie lebt im Palast und leitet von dort aus die Geschicke ihres Staates. Ob Du "
   "sie jemals zu Gesicht bekommen wirst ist fraglich."
   );
  AddDetail( ({ "koenig" }),
   "Hast du jemals davon gehoert, das ein Insektenstaat einen Koenig hat? "     /*Forscherpunkt ???*/
   );
  AddDetail( ({ "gesicht" }),
   "Naturlich dein Gesicht. "
   );
  AddDetail( ({ "insektenstaat","staat" }),
   "Ein Insektenstaat wird von einer Koenigin regiert. Desweiteren gibt es auch "
   "noch Arbeiterinnen und natuerlich die Soldaten. "
   );
  AddDetail( ({ "soldaten","soldat" }),
   "Die Soldaten bewachen die Stadt. "
   );
  AddDetail( ({ "arbeiterin","arbeiterinnen" }),
   "Sie schuften tagein und tagaus und bringen alles was der Staat zum Ueberleben "
   "braucht in die Stadt. Unablaessig laufen, oder eher krabbeln, sie an Dir "
   "vorbei in die Stadt hinein. "
   );
  AddDetail( ({ "einwohner","volk" }),
   "Ein riesiges Volk von Insekten bewohnt die Stadt Cugluch. "
   );
  AddDetail( ({ "insekten","ameisen","arbeiterameisen","heuschrecken","termiten","arten","rassen" }),
   "Dieses Insektenvolk besteht aus unterschiedlichen Rassen. Du kannst "
   "Arbeiterameisen, Heuschrecken, Termiten und noch verschiedene Arten erkennen. "
   );
  AddDetail( ({ "brutalitaet","fortbestand","standpunkt" }),
   "Fuer Menschen und andere normale Rassen mag dies Volk unbeschreiblich brutal "
   "wirken. Wenn man es allerdings vom Standpunkt der Insekten betrachtet, "
   "sichern sie nur den Fortbestand ihrer Rasse. "
   );
  AddDetail( ({ "punkt" }),
   "Welchen Punkt meinst du denn, den Standpunkt oder den Lichtpunkt? "
   );
  AddDetail( ({ "lichtpunkt","zaubertrank" }),
   "Nein, hier gibt es leider keinen Zaubertrank :-)"
   );
  AddDetail( ({ "zentrum" }),
   "Der Palast bildet das Zentrum der Stadt. "
   );
  AddDetail( ({ "palast" }),
   "Von hier aus kannst Du ihn nur schemenhaft erkennen, aber er scheint wahrhaft "
   "riesig zu sein. Ein Weg fuehrt direkt auf ihn zu. "
   );
  AddDetail( ({ "weg","wege" }),
   "Es fuehren Wege nach Westen, Osten und Norden. Der westliche und oestliche "
   "Weg fuehrt direkt an der Mauer entlang. Der noerdliche Weg hingegen fuehrt "
   "direkt auf den Palast zu. "
   );
  AddDetail( ({ "mauer" }),
   "Eine hohe steinerne Mauer umgibt die Stadt zum Schutz vor Feinden. "
   );
  AddDetail( ({ "feinde","betracht" }),
   "Zwar kannst Du dir nicht vorstellen, dass diese jemals bis hier vordringen "
   "werden, aber die Insekten haben alles in Betracht gezogen. "
   );
  AddDetail( ({ "stein","steine" }),
   "Die amuer besteht aus Stein und ist daher mehr als stabil genug. "
   );
  AddDetail( ({ "himmel","sonne" }),
   "Ein blauer wolkenloser Himmel prangt ueber dir, von dem die Sonne erbarmungslos "
   "ihre Strahlen auf die Erde fallen laesst. Gelegentlich fliegt ein Insekt "
   "vorueber und laesst seinen Schatten auf die Erde fallen. "
   );
  AddDetail( ({ "erde" }),
   "Erde gibt es hier zuhauf."
   );
  AddDetail( ({ "schatten" }),
   "Jedesmal zuckst Du innerlich zusammen wenn ein Schatten dich ueberfliegt. "
   );
  AddDetail( ({ "boden" }),
   "Der Boden ist festgetreten von den vielen Insekten, die hier taeglich "
   "entlanglaufen. "
   );
  AddDetail( ({ "tafel" }),
   "Lesen waer eine Idee. "
   );
  AddDetail( ({ "idee","ideen" }),
   "So etwas kann Dir hier auch nicht weiterhelfen. "
   );
 
  AddReadDetail ( "tafel",
   "Frei uebersetzt steht dort geschrieben ... "
   "\n"
   "+----------------------------------------------+\n"
   "| o                                          o |\n"
   "|      Hier verkehrt ein Lastenwagen           |\n"
   "|      zwischen Cugluch und dem Dschungel.     |\n"
   "|      Es liegt an Euch das Gefaehrt zu        |\n"
   "|      benutzen, oder gegebenenfalls           |\n"
   "|      hier in der Stadt zu bleiben und        |\n"
   "|      der grossen Insektenkoenigin zu         |\n"
   "|      dienen.                                 |\n"
   "| o                                          o |\n"
   "+----------------------------------------------+\n"
   );

  AddSound( DEFAULT_SOUND,
   "Ein bestaendiges Schwirren und Surren ist um dich herum. ");
  AddSound( ({ "schwirren","surren" }),
   "SSSSSSSS ... SSSSS ... SSS ");

  AddSmell( DEFAULT_SMELL,
   "Ein eigenartiger Geruch umgibt dich. ");
  AddSmell( ({ "geruch" }),
   "Du kannst ihn nicht naeher bestimmen, er ist irgendwie ... eigenartig. ");
  
  
   
   AddExit( "", "./" );
   AddExit( "", "./" );
   
}