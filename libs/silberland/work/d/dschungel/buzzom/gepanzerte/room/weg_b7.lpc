inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <verben.h>
#include "../def.h"

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Eine tropische Wiese" );
  SetProp( P_INT_LONG,
   "Auf beiden Seiten des Weges siehst Du eine tropische Wiese. Zwischen den "
   "vereinzelt auftretenden Bueschen und Kakteen sind viele grosse Militaerzelte "
   "zu sehen. Um sie herum ueben die Truppen der Gepanzerten fuer den Angriff auf "
   "Tijara. Ausserdem sind ueberall verschiedene Kriegsgeraetschaften aufgebaut, "
   "an denen die Krieger ausgebildet werden. "
   );
	
   SetProp( P_LIGHT, 1 );
   SetProp(P_INDOORS, 0 );
   SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_PLAIN]) );
  
  AddDetail( ({ "weg", "boden", "pfad" }),
   "Der Weg schlaengelt sich weiter Richtung Sueden durch die Wiese. "
   );
  AddDetail( ({ "wiese" }),
   "Auf der Wiese sind viele Zelte mit uebenden Truppen zu sehen. "
   );
  AddDetail( ({ "seite" }),
   "Links und rechts des Weges. "
   );
  AddDetail( ({ "busch", "buesche" }),
   "Es sind ganz dornige Buesche. "
   );
  AddDetail( ({ "kaktus", "kakteen" }),
   "Die Kakteen haben grosse stabile Stacheln. Die Gepanzerten nutzen sie zum Waffenbau. "
   );
  AddDetail( ({ "stachel" }),
   "Sie sind lang, stabil und sehr gefaehrlich. "
   );
  AddDetail( ({ "zelte", "zelt", "militaerzelte", "militaerzelt" }),
   "Die Zelte sind aus einem Dir fremden Material. In ihnen schlafen nachts die Krieger. "
   );
  AddDetail( ({ "material" }),
   "Es ist wohl aus der Seide bestimmter Insekten. "
   );
  AddDetail( ({ "seide" }),
   "Insektenseide. "
   );
  AddDetail( ({ "truppen", "truppe", "krieger", "gepanzerte" }),
   "Es sind verschiedene Rassen von Insekten. Sie sehen sehr stark und gefaehrlich aus. "
   );
  AddDetail( ({ "rassen", "rasse", "insekten" }),
   "Unter ihnen erkennst Du kaefer- und schabenartige Gepanzerte. "
   );
  AddDetail( ({ "angriff" }),
   "Der Angriff auf Tijara muss kurz bevor stehen. "
   );
  AddDetail( ({ "geraetschaften", "kriegsgeraetschaften" }),
   "Steinschleudern, Rammboecke und viele Handwaffen kannst Du darunter ausmachen. "
   );
  AddDetail( ({ "handwaffen", "waffen", "schwerter", "aexte", "lanzen" }),
   "Schwerter, Aexte und Lanzen befinden sich unter den Handwaffen. "
   );
  AddDetail( ({ "rammboecke", "bock", "rammbock" }),
   "Sie sind zum zerstoeren von Mauern gedacht. "
   );
  AddDetail( ({ "steinschleudern", "steinschleuder", "schleuder", "artillerie" }),
   "Die Schleudern stellen die Artillerie der Gepanzerten dar. "
   );
  AddDetail( ({ "himmel", "blau" }),
   "Der Himmel ist hier recht blau. "
   );
     
  AddSound( DEFAULT_SOUND,
   "Du hoerst viele verschiedene Stimmen und Kampfschreie der uebenden Truppen. ");
  AddSound( ({ "kampfschreie", "schreie" }),
   "Sie hoeren sich sehr boesartig an. "
   );
  AddSound( ({ "stimmen", "stimme" }),
   "Die Stimmen hoeren sich kraechtsend an. "
   );

  AddSmell( DEFAULT_SMELL,
   "Kaempferischer Geruch haengt in der feuchten Luft. ");
   
   
  AddExit( "nordosten", "./weg_c6" );
   AddExit( "suedwesten", "./weg_a8" );
   
}

