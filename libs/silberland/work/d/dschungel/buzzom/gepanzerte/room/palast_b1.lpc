inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <verben.h>
#include "../def.h"
#include "/d/dschungel/buzzom/gepanzerte/room/inh_palast.lpc"

create()
{
  ::create();
  
  palast_details();

  SetProp( P_INT_SHORT, "Ein Palastgang" );
  SetProp( P_INT_LONG,
   "Hier erstreckt sich ein ruendlicher Palastgang. In der noerdlichen Wand "
   "geht ein Tunnel hinauf. Wo er endet ist nicht zu erkennen. Das schwache "
   "Licht aus der Decke kann den Gang nicht sonderlich erhellen. Dadurch wirkt "
   "es hier recht unheimlich. Es gibt hier auch keine Gegenstaende, die von "
   "Bedeutung waeren. Vielleicht solltest Du einfach durch den Tunnel nach oben "
   "kriechen. "
   );

  AddDetail( ({ "wand", "tunnel" }),
   "In der noerdlichen Wand ist ein Tunnel, der nach oben fuehrt. "
   );	
   
  
  
  
    
   AddExit( "osten", "./palast_c1" );
   AddExit( "suedwesten", "./palast_a2" );
   
   
}

