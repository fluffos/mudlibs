inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <verben.h>
#include "../def.h"
#include "/d/dschungel/buzzom/gepanzerte/room/inh_palast.lpc"

create()
{
  ::create();
  
  palast_details();

  SetProp( P_INT_SHORT, "Ein Palastgang" );
  SetProp( P_INT_LONG,
   "Hier erstreckt sich ein ruendlicher Palastgang. Wo er enden wird ist nur zu "
   "erahnen. Das schwache Licht aus der Decke kann den Gang nicht sonderlich "
   "erhellen. Dadurch wirkt es hier recht unheimlich. Es gibt hier auch keine "
   "Gegenstaende, die von Bedeutung waeren. Vielleicht solltest Du einfach noch "
   "ein wenig weiter gehen. Suedlich ist der Ausgang in die Stadt Cugluch. "
   );
	
   
  
  AddDetail( ({ "ausgang" }),
   "Suedlich ist der Ausgang, durch den Du in den Palast gekommen bist. "
   );
  
    
   AddExit( "westen", "./palast_b4" );
   AddExit( "nordosten", "./palast_d3" );
   AddExit( "sueden", "./stadt_g7" );
   
}

