inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <verben.h>
#include "../def.h"

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einem Dschungelweg" );
  SetProp( P_INT_LONG,
   "Hier endet der heitere Dschungel. Weiter suedlich wird die Landschaft "
   "trueber und karger. Entfernt kannst Du einen Wald aus eigenartigen Baeumen "
   "erkennen. Eine breite Palisadenmauer erstreckt sich hier von Westen nach "
   "Osten. Das grosse geschlossene Tor in der Mauer fuehrt wohl gen Sueden. "
   "Nach den bewaffneten Gardisten zu urteilen, scheint es sich hier um einen "
   "Grenzposten zu handeln. Ein Schild haengt schon etwas wacklig an einem "
   "kleineren Baum. " 
   );
	
   SetProp( P_LIGHT, 1 );
   SetProp(P_INDOORS, 0 );
   SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_JUNGLE]) );
  
  AddDetail( ({ "weg", "boden", "pfad" }),
   "Links und rechts des Weges wachsen viele tropische Pflanzen. "
   );
  AddDetail( ({ "pflanze", "pflanzen" }),
   "Es wuchern zuviele hier, um sie ganuer zu unterscheiden. "
   );
  AddDetail( ({ "himmel", "blau" }),
   "Der Himmel ist heute schoen Blau. "
   );
  AddDetail( ({ "dschungel" }),
   "Der Dschungel wuchert gleich neben dem Weg. Ein Durchkommen ist ohne "
   "Machete kaum moeglich. "
   );
  AddDetail( ({ "durchkommen", "unterfangen" }),
   "Selbst mit Machete wird es ein irrsinniges Unterfangen werden. "
   );
  AddDetail( ({ "landschaft" }),
   "Sie wird weiter suedlich trueb und karg. Hier ist sie jedoch noch freundlich. "
   );
  AddDetail( ({ "ferne" }),
   "Versuche doch weiter suedlich zu kommen! "
   );
  AddDetail( ({ "wald", "baeume" }),
   "Der Wald in der Ferne besteht auch aus tropischen Baeumen. Sie sehen aber "
   "ganz und gar anders aus als hier. "
   );
  AddDetail( ({ "mauer", "palisade", "palisadenmauer" }),
   "Sie ist aus starkem Tropenholz gefertigt. Es scheint, als ob sie vor irgendetwas "
   "Schutz bieten soll. "
   );
  AddDetail( ({ "schutz" }),
   "Vermutlich koennen die Gardisten Dir mehr dazu erzaehlen. "
   );
  AddDetail( ({ "holz", "tropenholz" }),
   "Vermutlich Palmenholz. Aber Du bist Dir nicht ganz sicher. "
   );
  AddDetail( ({ "palmenholz" }),
   "Die Palisade ist daraus gefertigt. "
   );
  AddDetail( ({ "westen" }),
   "Im Westen liegt die Stadt Tijara. "
   );
  AddDetail( ({ "osten" }),
   "Oestlich von Dir breitet sich der dichte Dschungel aus. "
   );
  AddDetail( ({ "sueden" }),
   "Im Sueden veraendert sich die Landschaft schlagartig. "
   );
  AddDetail( ({ "tor" }),
   "Das Tor wird wohl ein special detail!!! "
   );
  AddDetail( ({ "gardisten", "soldaten", "soeldner" }),
   "Sie bewachen den Grenzposten. "
   );
  AddDetail( ({ "posten", "grenzposten", "grenze" }),
   "Die Palisade mit den Gardisten ergeben den Grenzposten. Vielleicht gibt das "
   "Schild mehr Aufschluss. "
   );
  AddDetail( ({ "baum" }),
   "Der Baum scheint abgestorben zu sein. An ihm haengt wacklig ein Schild. "
   );
  AddDetail( ({ "aufschluss" }),
   "Um Aufschluss zu bekommen, solltest Du das Schild schon lesen. "
   );
  AddDetail( ({ "schild" }),
   "Du kannst das Schild lesen. "
   );
  
  AddSound( DEFAULT_SOUND,
   "Du hoerst, das der Dschungel voller Leben sein muss. ");
   
  AddSmell( DEFAULT_SMELL,
   "Du kannst exotische Pflanzen, Tiere und Deinen eigenen Schweiss riechen.");


 
   
  AddReadDetail( "schild",
    "    /----------------------------------------\\\n"
    "   |                                          |\n"
    "   |             !!! H A L T !!!              |\n"
    "   |                                          |\n"
    "   |  Suedlich der Grenze beginnt das Reich   |\n"
    "   |  der Gepanzerten.                        |\n"
    "   |                                          |\n"
    "   |  Betreten auf eigene Gefahr!             |\n"
    "   |                                          |\n"
    "   |  Bei erhoehtem Grenzverkehr bitte in     |\n"
    "   |  einer Reihe aufstellen und Passier-     |\n"
    "   |  schein vorzeigen!                       |\n"
    "   |                                          |\n"
    "   |          i.A. Der Gouverneur von Tijara  |\n"
    "   |                                          |\n"
    "    \\----------------------------------------/\n"
    "                       |   |                   \n"
    "                       |   |                   \n");

  
  AddExit( "suedwesten", "./weg_a2" );

  AddItem("/d/dschungel/buzzom/gepanzerte/npc/gardist" , REFRESH_DESTRUCT);
  AddItem("/d/dschungel/buzzom/gepanzerte/npc/gardist" , REFRESH_DESTRUCT);
  AddItem("/d/dschungel/buzzom/gepanzerte/npc/grenzkom" , REFRESH_DESTRUCT);
    
}

