inherit "std/room";
#include <properties.h>
#include <language.h>
#include <moving.h>

void palast_details()
{
  

  

   SetProp( P_LIGHT, 1 );
   SetProp(P_INDOORS, 1 );
   SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN:TT_HOUSE]) );
  
  AddDetail( ({ "wand","waende" }),
   "Der Waende scheinen aus einer Art Lehm gefertigt worden zu sein. Ausserdem  "
   "sind sie ein wenig klebrig und glitzern schwach. "
   );
  AddDetail( ({ "lehm","putz", "art" }),
   "Der klebrige Lehm wurde mit Insektensekreten aufbereitet. Dadurch wird eine "
   "hohe Stabilitaet gewaerleistet. "
   );
  AddDetail( ({ "sekret","sekreten", "stabilitaet" }),
   "Durch das Sekret bekommt der Palast erst seine hohe Stabilitaet. "
   );
  AddDetail( ({ "cugluch", "stadt", "hauptstadt" }),
   "Cugluch ist die Hauptstadt der Gepanzerten. Hier gibt es sicher viele Abenteuer "
   "zu bestehen. "
   );
  AddDetail( ({ "boden" }),
   "Der Boden ist aus klebrigem Lehm. Dennoch geht es sich angenehm leicht. "
   );
  AddDetail( ({ "palast" }),
   "Du befindest Dich hier im Palast von Cugluch. Sei gewarnt vor den Fallen, die es "
   "hier ueberall geben soll. Ob die Koenigin hier zu finden ist?" 
   );
  AddDetail( ({ "falle", "fallen" }),
   "Sie koennen ueberall versteckt sein. Sei vorsichtig! " 
   );
  AddDetail( ({ "koenigin" }),
   "Normalerweise regieren Koeniginen von Plaesten aus. " 
   );
  AddDetail( ({ "gang", "gaenge", "palastgang" }),
   "Die Palastgaenge sind Kreisfoermig angeordnet. Irgendwo muss man weiter nach oben "
   "kommen. "
   );
  AddDetail( ({ "decke", "licht" }),
   "Das Licht kommt aus merkwuerdigen runden Scheiben, die in die Decke eingelassen zu "
   "sein scheinen. "
   );
  AddDetail( ({ "scheibe", "scheiben", "lichtquelle", "lichtquellen", "quelle", "quellen" }),
   "Solche Lichtquellen hast Du noch nie im Silberland gesehen. Es it auch nicht zu "
   "erkennen wie sie funktionieren. "
   );
  
    
  AddSound( DEFAULT_SOUND,
   "Du kannst hier ueberhaupt nichts hoeren. Entweder bist du Taub oder hier gibt es "
   "tatsaechlich keine Geraeusche. "
   );
  AddSound( ({ "geraeusche","geraeusch" }),
   "Nicht, absolut nichts ist zu hoeren. Irgendwie unheimlich. "
   );

  AddSmell( DEFAULT_SMELL,
   "Es riecht suesslich. "
   );
  
   
}