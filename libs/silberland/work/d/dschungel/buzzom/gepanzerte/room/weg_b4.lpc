inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <verben.h>
#include "../def.h"

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Ein dunkler Dschungelwald" );
  SetProp( P_INT_LONG,
   "Grosse, dunkle, halb ausgetrocknete Baeume saeumen den Waldweg. Am Rand des "
   "Pfades liegt ein grosser Holzhaufen, der wohl von Holzfaellern hier aufgestapelt "
   "wurde. Der Weg fuehrt suedlich immer tiefer in den Wald. Ein Ende ist noch "
   "nicht in Sicht. Ab und zu ist ein Knacken und Borsten zu hoeren, welches Dich "
   "hier erschaudern laesst. "
   );
	
   SetProp( P_LIGHT, 1 );
   SetProp(P_INDOORS, 0 );
   SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 30, ENV_TERRAIN:TT_JUNGLE]) );
  
  AddDetail( ({ "weg", "boden", "pfad", "waldweg" }),
   "Seitlich des Weges wachsen einige dunkle Pflanzen. Ein Holzhaufen liegt am Rand. "
   );
  AddDetail( ({ "pflanze", "pflanzen" }),
   "Die Pflanzen sehen zwar tropisch aus, sind jedoch ganz dunkel statt gruen. "
   );
  AddDetail( ({ "himmel", "blau" }),
   "Der Himmel ist durch die dichte Vegetation nicht sichtbar. "
   );
  AddDetail( ({ "vegetation" }),
   "Baeume bilden den Grossteil der Vegetation. "
   );
  AddDetail( ({ "baeume", "baum", "dschungelbaeume" }),
   "Es sind zwar Dschungelbaeume, dennoch unterscheiden sie sich durch Farbe und "
   "Blattwuchs erheblich von normalen tropischen Baeumen. "
   );
  AddDetail( ({ "farbe" }),
   "Dunkelrote bis schwarze Farben lassen den Dschungel duester aussehen. "
   );
  AddDetail( ({ "blattwuchs", "wuchs", "blaetter" }),
   "Die Blaetter sehen irgendwie bedrohlich aus. "
   );
  AddDetail( ({ "rand", "stapel", "holzstapel", "haufen", "holzhaufen" }),
   "Ein ordentlich aufgestapelter Holzhaufen befindet sich am Rand des Weges. "
   );
  AddDetail( ({ "holzfaeller" }),
   "Sie scheinen ihrer Arbeit im Wald nachzugehen. "
   );
  AddDetail( ({ "arbeit" }),
   "Die Arbeit besteht aus dem Faellen der Baeume. "
   );
  AddDetail( ({ "wald", "dschungel"}),
   "Dieser Wald ist ganz anders als der Dschungel bei Tijara. "
   );
  AddDetail( ({ "ende", "sicht"}),
   "Das Ende des Waldes ist noch nicht in Sicht. "
   );
  
  AddSound( DEFAULT_SOUND,
   "Ab und zu ist ein Knacken und Borsten zu hoeren. ");
  AddSound( ({ "knacken", "borsten" }),
   "Es hoert sich an als ob Baeume zerbersten. "
   );

  AddSmell( DEFAULT_SMELL,
   "Feuchter, heisser Waldduft zieht in Deine Nase. ");
   
   
  AddExit( "nordwesten", "./weg_a3" );
  AddExit( "suedosten", "./weg_c5" );
  
  AddItem("/d/dschungel/buzzom/gepanzerte/npc/borkenk" , REFRESH_DESTRUCT);
  AddItem("/d/dschungel/buzzom/gepanzerte/npc/borkenk" , REFRESH_DESTRUCT);
   
}

