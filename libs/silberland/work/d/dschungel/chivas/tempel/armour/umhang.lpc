#include "../def.h"

inherit "std/armour";
void create()
{
  if(!is_clone(this_object())) return; 
  ::create();


  SetProp(P_SHORT, "Ein gruener Umhang");
  SetProp(P_LONG,
    "Es ist ein langer gruener Umhang, der aus lauter Blaettern zu bestehen "
    "scheint. Wenn man mit ihm im Dschungel ist, wird man sicher kaum gesehen."
  );

  SetProp(P_GENDER, MALE);
  SetProp(P_NAME, "Umhang");
  AddId("umhang");

  SetProp(P_NAME_ADJ, ({"gruen"}) );

  AddAdjective( ({"gruenen","gruener","gruenes"}) );


  SetProp(P_INFO,
      "Der gruene Umhang schuetzt Dich gut bei Hitze.\n");


  SetProp(P_WEIGHT, 400);
  SetProp(P_VALUE, 200);
  SetProp(P_MATERIAL, ([ MAT_MISC_HERBAL : 100 ]) );
  SetProp(P_ARMOUR_TYPE, AT_CLOAK);
  SetProp(P_AC, 6);
  SetProp(P_QUALITY_DECAY, 80); 
  SetProp(P_DAM_PROTECTION, PHYSICAL_DAMAGE_TYPES);

  SetProp(P_WORN_TEXT, "umgehaengt");
  SetProp(P_WEAR_TEXT, ({ "Du huellst Dich in den gruenen Umhang.\n",
                          " huellt sich in einen gruenen Umhang.\n" }) );
  SetProp(P_UNWEAR_TEXT, ({ "Du streifst den Umhang von Deinen Schultern.\n",
                            " streift einen Umhang von den Schultern.\n" }) );

  SetProp(P_TEMPERATURE_PROTECTION,
      ([ T_COLD_PROT:0,T_HEAT_PROT: 6 ]) );
}

