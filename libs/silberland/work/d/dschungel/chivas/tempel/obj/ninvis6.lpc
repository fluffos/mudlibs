// von Chivas

#include "../def.h"

inherit "std/thing";

#include <properties.h>

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, 0);
  SetProp(P_LONG, "Unsichtbar!" );
  SetProp(P_NAME, 0);
  SetProp(P_GENDER, MALE);
  AddId(({"ninvis6","unsichtbar"}));

  SetProp(P_MATERIAL, ([MAT_GLASS: 100]) );
  SetProp(P_WEIGHT, 0);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
}
void reset()
{
  ::reset();
  remove();

}
