// von Chivas

#include "../def.h"

inherit "std/thing";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein rostiger Schluessel");
  SetProp(P_LONG,
    "Ein rostiger Schluessel, mit dem Du sicher die Zellen im Tempel "
    "oeffnen kannst.");

//--Namen------------------------------------------------------------------


  SetProp(P_NAME, "Schluessel");
  SetProp(P_GENDER, MALE);
  AddId("schluessel");
  AddId("tempelschluessel");

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([MAT_METAL: 100]) );
  SetProp(P_WEIGHT, 50);
  SetProp(P_SIZE, 80);
  SetProp(P_VALUE, 50);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 0);
  SetProp(P_NEVERDROP, 0);

}
