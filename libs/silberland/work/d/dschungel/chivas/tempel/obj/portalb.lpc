#include "../def.h"

inherit "std/thing";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein blaues Portal");
  SetProp(P_LONG,
    "Das Portal steht mitten im Raum und hat eine kreisrunde Form mit einem "
    "Durchmesser von 3 Metern. Innerhalb der kreisrunden Form, die aus einer "
    "Art Metall zu bestehen scheint, ist eine wasserartige Fluessigkeit, die "
    "blaeulich schimmert. Durch diese Fluessigkeit kannst Du das Portal "
    "betreten.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Portal");
  SetProp(P_GENDER, MALE);
  AddId("Portal");
  AddId("portal");

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([MAT_ADAMANT: 70,MAT_MISC_FLUID: 30 ]) );
  SetProp(P_WEIGHT, 80000);
  SetProp(P_SIZE, 3000);
  SetProp(P_VALUE, 150);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NEVERDROP, 1);

  AddDetail( ({"form"}),
	    "Das Portal ist kreisrund.");

  AddDetail( ({"durchmesser","meter"}),
	    "Das Portal hat einen Durchmesser von ca. drei Metern.");

  AddDetail( ({"metall"}),
	    "Das Metall ist Dir gaenzlich unbekannt.");

  AddDetail( ({"fluessigkeit","wasser"}),
	    "Die Fluessigkeit wirkt wie Wasser. Du kannst das Portal durch sie "
            "betreten.");

}
