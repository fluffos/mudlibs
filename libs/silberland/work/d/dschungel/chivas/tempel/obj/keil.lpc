#include "../def.h"

inherit "std/thing";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein kleiner Keil");
  SetProp(P_LONG,
    "Der kleine Keil besteht vollstaendig aus Holz. Du kannst sicher etwas mit "
    "ihm blockieren.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Keil");
  SetProp(P_GENDER, MALE);
  AddId("keil");

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([MAT_MISC_WOOD : 100]) );
  SetProp(P_WEIGHT, 20);
  SetProp(P_SIZE, 150);
  SetProp(P_VALUE, 15);
  SetProp(P_NOBUY, 0);
  SetProp(P_NOSELL, 0);
  SetProp(P_NEVERDROP, 0);

}
