
inherit "std/npc";
inherit "std/npc/spells";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create()
 {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein grosser Golem");
  SetProp(P_LONG, BS(
    "Der grosse Golem besteht vollkommen aus Stein. Seine Gliedmassen und "
    "sein Kopf sind nur grob behauen. In seinem Schaedel erkennst Du zwei "
    "kleine rot leuchtende Punkte, die Dich erbarmungslos anstarren."));
  SetProp(P_NAME, "Golem");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-10,T_RANGE_MAX:40]));
  AddId( ({ "golem"}) );
  AddId(({"Axtmeister"}));

  create_default_npc(39);
  SetProp(P_HANDS, ({" mit seinen Steinhaenden" ,QueryProp(P_HANDS)[1], DT_SQUEEZE }) );
  SetProp(P_RACE, "Golem");
  SetProp(P_SIZE, 350 );
  SetProp(P_ALIGN, -300);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,2);
  SetProp(P_AGGRESSIVE,1);
  SetProp(P_WIMPY, 0);
  SetProp(P_SPELLRATE, 30);
  SetProp(P_ARTICLE, 1);
  SetProp(P_NOMAGIC,20);
  SetProp(P_RESISTANCE_STRENGTHS , 
  ([DT_FIRE:      -1.0,  DT_COLD:     -0.5,  DT_WATER: 0.5,  DT_AIR:   0.2, 
    DT_LIGHTNING: 0.3,  DT_EXPLOSION: 0.4,  DT_SOUND:  0.3,  DT_LIGHT: -0.5,
    DT_ACID:      -0.5,  DT_POISON: -1.0,  DT_TERROR: -0.5,
    DT_HOLY:      0.2,  DT_UNHOLY:    0.2,  DT_MAGIC: 0.3, DT_BLUDGEON: 0.3]));

  SetProp(P_MSGIN, "poltert herein");
  SetProp(P_MSGOUT, "poltert");
  SetProp(P_MMSGIN, "poltert unbeholfen herein");
  SetProp(P_MMSGOUT, "poltert weiter");

  SetProp(P_DIE_MSG,  " zerfaellt in lauter Steine.\n");
  SetProp(P_NOCORPSE, 1 );
  SetProp(P_KILL_NAME, "Ein grosser Golem");
  SetProp(P_KILL_MSG, "Du bist nicht hart genug!");

  AddDetail( ({ "stein"}),
    "Der Golem besteht aus blanken Stein.");
  AddDetail( ({ "gliedmassen","massen"}),
    "Die Gliedmasse sind grob behauen.");
  AddDetail( ({ "kopf","schaedel"}),
    "Der Schaedel wirkt globig. Nur zwei rote Punkte beunruhigen Dich.");
  AddDetail( ({ "punkte","augen"}),
    "Die roten Punkte scheinen die Augen des Golems zu sein.");

  AddInfo(DEFAULT_INFO, "ist viel zu dumm um Dich zu verstehen.\n");
  AddInfo("chivas", "Chivas hat mich erschaffen.","sagt: ");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Golem will Deine Sachen nicht haben.\n" }) );

  AddSpell(5,600, 
     "Der Golem wirft Dir grosse Steinbrocken entgegen.\n",
     "Der Golem bewirft @WEN mit grossen Steinbrocken.\n",
     ({DT_BLUDGEON}), ([SP_SHOW_DAMAGE:1]));

  AddSpell(1,1500, 
     "Der Golem zermalmt Deinen Kopf zwischen seinen grossen Haenden.\n",
     "Der Golem zermalmt @WEN den Kopf zwischen seinen grossen Haenden.\n",
     ({DT_SQUEEZE}), ([SP_SHOW_DAMAGE:1]));

  AddDefaultSpell(2, 1, DS_PARALYZE,
    "Der Golem haut Dir voller Wucht auf den Kopf, so dass Du nur noch Sterne siehst und zu Boden sackst!\n",
    "Der Golem haut @WEN voller Wucht mit der Faust auf den Kopf und sackt zu Boden!\n" );

  SetChats(2, ({
          "Der Golem durchbohrt Dich mit seinem Blick.\n",
          "Der Golem scheint auszuholen um Dich zu schlagen.\n"}) );
  SetAttackChats(10, ({
    "Der Golem zermalmt Dich mit seinen Haenden.\n",
    "Der Golem zerschmettert Dich voller Kraft.\n"}) );

 SUID;
  CLONEME( "/p/weapon/axe/steinaxt" );
  command("zuecke axt");

}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (find_call_out("react")!= -1)
    return;

  
  switch(gruppe)
  {
    case "fies": 
      call_out("react", 0, "knurrt Dich an.", "knurrt " +
        TP->Name(WEN) + " boesartig.");
      break; 

    case "aergerlich":
      call_out("react", 0, "droht mit seinen Haenden.",
        "bedroht " + TP->Name(WEM) +
        " mit seinen Klauen.");
    break;

    default:
      call_out("react", 0, "poltert umher.",
	"schleicht herum.");
    break;
  }
}

void react(string victim, string others)
{
  if (present(TP, ENV(TO)))
  {
    tell_object(TP, BS(Name(WER) + " "+victim));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+others), ({TP,TO}));
  }
}


void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}


void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}
