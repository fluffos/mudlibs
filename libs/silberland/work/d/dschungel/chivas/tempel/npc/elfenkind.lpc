//erstellt im mai 04 von chivas
inherit "std/mnpc";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <mnpc.h>
#include "../def.h"

int anzahl;

void create() {
  if (!is_clone(TO)) return;
  ::create();

  anzahl=1;

  SetProp(P_SHORT, "Ein kleines Elfenmaedchen");
  SetProp(P_LONG,
    "Das kleine Elfenmaedchen schaut Dich mit ihren grossen Kulleraugen an. "
    "Es hat ein liebes und freundliches Gesicht und laechelt Dich staendig an. "
    "Es springt spielend im ganzen Raum umher und geht Dir doch irgendwie "
    "auf die Nerven.");
  SetProp(P_NAME, "Elfenmaedchen");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId( ({ "elfenmaechen","maedchen","elfe"}) );

  create_default_npc(8);
  SetProp(P_HANDS, ({" mit seinen Haenden" ,50, DT_RIP }) );
  SetProp(P_SIZE, 120 );
  SetProp(P_RACE, "Elf");
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_SPELLRATE,30);
  SetProp(P_ARTICLE, 1);
  SetProp(P_NOMAGIC,3);

  SetProp(P_MSGIN, "laeuft herein");
  SetProp(P_MSGOUT, "laeuft");
  SetProp(P_MMSGIN, "kommt Dich mit grossen Kulleraugen anschauend herein");
  SetProp(P_MMSGOUT, "laeuft auf der Suche nach Spielkameraden weiter");
  
  SetProp(P_MNPC_AREA, ( {ROOM "tem3-9"}));
  SetProp(P_MNPC_WAIT, ({ 10, 20, 20 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "tem3-9");
  SetProp(P_MNPC_FLAGS, MOV_INDOORS + MOV_MOVES + MOV_BACKWARDS); 

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Ich komme wieder %s, dann zerreiss ich Dich!");
  SetProp(P_KILL_NAME, "Ein kleines Elfenmaedchen");
  SetProp(P_KILL_MSG, "Du greifst keine kleinen Maedchen mehr an!");

  AddDetail( ({ "augen", "kulleraugen"}),
    "Die Kulleraugen sind gross und sehen richtig niedlich aus.");
  AddDetail( ({ "gesicht"}),
    "Das Gesicht sieht lieb aus, obwohl sich dahinter anscheinend mehr verbirgt.");

  AddInfo(DEFAULT_INFO, "tritt Dir auf den Fuss nur um Dich zu aergern.\n");
  AddInfo("chivas", "Chivas hat mich erschaffen.","sagt: ");
  AddInfo("tempel", "Nerv mich nicht mit dem Tempel, spiel mit mir.","sagt: ");
  AddInfo("spielen", "Du musst aber auch verlieren, Du Looser.","sagt: ");
  AddInfo("drache", "Der ist in der Tempelspitze. Er ist ein sehr guter "
          "Freund.","sagt: ");
  AddInfo("freund", "Du sollst auf jedenfall keiner werden. Ich kann Dich "
          "naemlich nicht leiden.","sagt: ");

  SetProp(P_LOG_INFO, "chivas/tempel");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Das Maedchen will Deine Sachen nicht tragen.\n" }) );

  SetChats(3, ({
    "Ein kleines Elfenmaedchen zupft an Deiner Hose und probiert Dir Deine "
    "Sachen wegzunehmen.\n",
    "Ein kleines Elfenmaedchen probiert Dir auf den Fuss zu treten.\n",
    "Ein kleines Elfenmaedchen zieht an Deinen Haaren.\n"}) );

}

// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch) {
  if (find_call_out("reaction") != -1) return;
  switch (gruppe) {
    case "aengstlich":
      call_out("reaction", 0, TP,
        "haelt Dich fuer ein Weichei.",
        "haelt Dich fuer einen grossen Seicherl.");
      break;
    case "aergerlich":
      call_out("reaction", 0, TP,
        "schimpft leise auf Dich.",
        "grummelt ueber dich.");
      break;
    case "albern":
      call_out("reaction", 0, TP,
        "findet Dich gar nicht lustig.",
        "findet gar nichts lustig.");
      break;
    case "fies":
      call_out("reaction", 0, TP,
        "droht mit ihren kleinen Faeusten.",
        "schaut boese.");
      break;
    case "frech":
      call_out("reaction", 0, TP,
        "kneift Dich.",
        "kneift Dir in den Hintern.");
      break;
    case "froh":
      call_out("reaction", 0, TP,
        "tritt Dir dafuer auf den Fuss.",
        "grinst Dich gemein an und tritt Dir auf den Fuss.");
      break;
    case "intim":
      call_out("reaction", 0, TP,
        "findet Deine Annaehrungsversuche daemlich.",
        "haelt Dich fuer einen Seicherl.");
      break;
    case "nett":
      call_out("reaction", 0, TP,
        "schaut Dich uninteressiert an.",
        "haelt Dich fuer ein Weichei.");
      break;
    case "neutral":
      call_out("reaction", 0, TP,
        "beruehrt das nicht besonders.",
        "beruehrt das nicht besonders.");
      break;
    case "traurig":
      call_out("reaction", 0, TP,
        "lacht Dich aus.",
        TP->Name(WER)+" wird von einem kleinen Elfenmaedchen ausgelacht.");
      break;
  }
}
void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
  
  
}

Defend(int dam, mixed dtype, mixed spell, object enemy)
{
   if ( anzahl )
    {
    write(BS( "Ploetzlich verwandelt sich das kleine Elfenmaedchen vor Deinen "
           "Augen in einen grossen behaarten mit spitzen Zaehnen bewaffneten "
           "Werwolf.\n"));
    SetProp(P_SHORT, "Ein blutruenstiger Werwolf");
    SetProp(P_LONG,
      "Der Werwolf fletscht seine grossen spitzen Zaehne in seinem riesigen "
      "Maul, an dem immer noch ein paar Fleischreste des letzten Abenteurers "
      "kleben. Sein rotes Fell ist zottelig und sieht ungepflegt aus.");
    SetProp(P_NAME, "Werwolf");
    SetProp(P_GENDER, MALE);
    AddId( ({ "werwolf","wolf"}) );
 
    create_default_npc(38);
    SetProp(P_HANDS, ({" mit seinen Klauen" ,QueryProp(P_HANDS)[1], DT_RIP }) );
    SetProp(P_SIZE, 220 );
    SetProp(P_RACE, "Werwolf");
    SetProp(P_AGGRESSIVE, 1);
    SetProp(P_ALIGN, -750);
    SetProp(P_WEIGHT, 220000);
    SetProp(P_HEAL,4);
    SetProp(P_NOMAGIC,10);

    SetProp(P_MSGIN, "spring herein");
    SetProp(P_MSGOUT, "springt");
    SetProp(P_MMSGIN, "kommt Dich anfauchend herein");
    SetProp(P_MMSGOUT, "schleicht nach Opfern suchend weiter");

    AddSpell(4,600, 
     "Ein Werwolf zerreisst Dich mit seinen Klauen.\n",
     "Ein Werwolf zerreisst @WEN mit seinen Klauen.\n",
     ({DT_BLUDGEON}), ([SP_SHOW_DAMAGE:1]));

   SetAttackChats(10, ({
    "Der blutruenstige Werwolf zerfetzt Dich.\n",
    "Der blutruenstige Werwolf zereisst Dich.\n"}) );

    SetChats(1, ({
    "Ein Werwolf umrundet Dich blutruenstig.\n"}) );
    anzahl--;
    return 1;
    }
 return ::Defend(dam, dtype, spell, enemy);
}

