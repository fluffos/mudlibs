
inherit "std/npc";
inherit "std/npc/spells";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create()
 {
  if (!is_clone(TO)) return;
  ::create();

 SetProp(P_SHORT, "Eine Riesenspinne");
  SetProp(P_LONG, "Vor Dir steht eine riesige Spinne. Sie schaut Dich mit "
      "ihren Facettenaugen boese an und von ihren Giftzaehnen tropft eine "
      "ekelige Fluessigkeit. Ihre langen Beine sind behaart und sehen "
      "auch recht gefaehrlich aus.");
  SetProp(P_NAME, "Riesenspinne");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10,T_RANGE_MAX:30]));
  AddId( ({ "riesenspinne","spinne"}) );

  create_default_npc(20+random(15));
  SetProp(P_HANDS, ({" mit Ihren Spinnenbeinen" ,300, DT_RIP }));
  SetProp(P_RACE, "Spinne");
  SetProp(P_SIZE, 150 );
  SetProp(P_ALIGN, -500);
  SetProp(P_MAX_HANDS, 8);
  SetProp(P_WEIGHT, 220000);
  SetProp(P_HEAL,2);
  SetProp(P_AGGRESSIVE,1);
  SetProp(P_WIMPY, 0);
  SetProp(P_ARTICLE, 1);
  SetProp(P_SPELLRATE, 30);
  SetProp(P_NOMAGIC,10);
  SetProp(P_NOCORPSE, 0 );

  SetProp(P_MSGIN, "krabbelt herein");
  SetProp(P_MMSGIN, "krabbelt herein");
  SetProp(P_MMSGOUT, "krabbelt hinaus");
  SetProp(P_MSGOUT, "krabbelt");

  SetProp( P_REJECT, ({ REJECT_DROP, "Die Spinne laesst es fallen.\n" }) );
  SetProp( P_DIE_MSG, " faellt tot zu Boden.\n");
  SetProp( P_KILL_MSG, ({"saugt den leblosen Koerper aus.",MSG_EMOTE}));

  AddDetail( ({ "facettenaugen","augen"}),
    "Die Augen glitzern gespenstisch im Licht.");
  AddDetail( ({ "giftzaehne","zaehne"}),
    "Die Giftzaehne sehen gefaehrlich scharf und gefaehrlich aus.");
  AddDetail( ({ "fluessigkeit","gift"}),
    "Die Fluessigkeit ist sicher Gift.");
  AddDetail( ({ "beine"}),
    "Die Beine der Spinne sind ekelig behaart.");

  AddInfo(DEFAULT_INFO, "ist viel zu dumm um Dich zu verstehen.\n");
  AddInfo("chivas", "Chivas hat mich erschaffen.","sagt: ");

  AddDefaultSpell(2,800,DS_POISON,
	" Die Riesenspinne beisst Dich mit Ihren Giftzaehnen.\n",
	" Die Riesenspinne beisst @WEN mit ihren Giftzaehnen.\n");

  AddDefaultSpell(4, 1, DS_SLOW,
    "Die Riesenspinne spinnt Dich ein, wodurch Deine Angriffe langsamer werden!\n",
    "Die Riesenspinne spinnt @WEN ein und die Angriffe werden langsamer!\n" );

  SetChats(2, ({
          "Die Spinne durchleuchtet Dich mit Ihren Facettenaugen.\n",
          "Die Riesenspinne umkreist Dich.\n"}) );
  SetAttackChats(10, ({
    "Die Riesenspinne greift Dich mit Ihren acht Beinen an.\n",
    "Die Riesenspinne schlaegt wild um sich.\n"}) );
  SUID;

}

void react(string victim, string others)
{
  if (present(TP, ENV(TO)))
  {
    tell_object(TP, BS(Name(WER) + " "+victim));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+others), ({TP,TO}));
  }
}


void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}
void die(int poisondeath) {
  write_file(LOG "tempel.log",
    ctime()+": "+(CAP(getuid(QueryProp(P_KILLER)||TP))||"<Unbekannt>")+" killt eine Riesenspinne.\n");
  ::die(poisondeath);
}

