
inherit "std/mnpc";
inherit "std/npc/spells";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <mnpc.h>
#include "../def.h"

void create()
 {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Istar i' Bereg, der Tempelzauberer");
  SetProp(P_LONG, BS(
    "Istar i' Bereg steht in seiner dunklen Robe vor Dir. Seine Augen "
    "wirken kalt und hart. Seine ganze Statur wirkt sehr schmaechtig, aber Du "
    "spuerst trotzdem die Macht, die von ihm ausgeht. Vor allem seine "
    "Haende leuchten voll magischer Energie. "));
  SetProp(P_NAME, "Istar i' Bereg");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-20,T_RANGE_MAX:50]));
  AddId( ({ "istar","istar i' bereg","tempelzauberer","zauberer"}) );

  create_default_npc(45);
  SetProp(P_HANDS, ({" mit seinen Haenden" ,QueryProp(P_HANDS)[1], DT_RIP }) );
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 170 );
  SetProp(P_ALIGN, -400);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,2);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_SPELLRATE,80);
  SetProp(P_WIMPY, 0);
  SetProp(P_ARTICLE, 0);
  SetProp(P_NOMAGIC,20);
  SetProp(P_RESISTANCE_STRENGTHS , 
  ([DT_FIRE:      -0.2,  DT_COLD:     -0.2,  DT_WATER: -0.2,  DT_AIR:   -0.2, 
    DT_LIGHTNING: 0.3,  DT_EXPLOSION: 0.4,  DT_SOUND:  0.3,  DT_LIGHT: 0.0,
    DT_ELECTRIC:  0.0,  DT_ACID:      0.0,  DT_POISON: 0.0,  DT_TERROR: 0.0,
    DT_HOLY:      0.2,  DT_UNHOLY:  -0.2,  DT_MAGIC: -0.2, DT_BLUDGEON: -0.6]));
  SetProp(P_MSGIN, "schleicht murmelnd herein");
  SetProp(P_MSGOUT, "schleicht murmelnd weiter");
  SetProp(P_MMSGIN, "schleicht fluesternd herein");
  SetProp(P_MMSGOUT, "schleicht fluesternd weiter");

  SetProp(P_MNPC_AREA, ( {ROOM "tem3-1", ROOM "tem3-2", ROOM "tem3-3",
                          ROOM "tem3-4",ROOM "tem3-5", ROOM "tem3-6", 
                          ROOM "tem3-7", ROOM "tem3-8", ROOM "tem3-9"}));
  SetProp(P_MNPC_WAIT, ({ 10, 20, 20 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "tem3-6");
  SetProp(P_MNPC_FLAGS, MOV_INDOORS + MOV_MOVES + MOV_BACKWARDS); 

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_KILL_NAME, "Istar i' Bereg");
  SetProp(P_KILL_MSG, "Dunkle Magie ist viel zu stark fuer Dich!");

  AddDetail( ({ "robe"}),
    "Die dunkle Robe verbirgt mehr als man denkt. Unter der Robe scheint "
    "ein starker Zauberer zu stecken.");
  AddDetail( ({ "augen"}),
    "Seine Augen wirken boese und kalt.");
  AddDetail( ({ "statur","figur"}),
    "Seine Statur ist schmaechtig, aber seine Figur ist auch nebensaechlich.");
  AddDetail( ({ "macht"}),
    "Von ihm geht eine starke Macht aus.");
  AddDetail( ({ "haende","energie"}),
    "Seine Haende leuchten von der magischen Energie.");

  AddInfo(DEFAULT_INFO, "spielt mit ein paar Feuerbaellen in seinen Haenden "
                        "und beachtet Dich nicht.\n");
  AddInfo("chivas", "Chivas hat mich erschaffen.","sagt: ");
  AddInfo("tempel", "Ich habe hier viel Magie im Tempel eingesetzt.","sagt: ");
  AddInfo("magie", "Auf diese Ebene bin ich besonders stolz.","sagt: ");
  AddInfo("ebene", "Hier habe ich ganze Arbeit geleistet.","sagt: ");
  AddInfo("arbeit", "Meine Aufgabe besteht darin, den Tempel zu schuetzen.",
          "sagt: ");
  AddInfo("aufgabe", "Diese Aufgabe nehme ich sehr wichtig.","sagt: ");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Istar i' Bereg brauch Deine Sachen nicht.\n" }) );

  AddSpell(5,800, 
    "Ein Blitz schnellt aus der Hand von Istar i' Bereg und trifft Dich.\n",
    "Ein Blitz aus der Hand von Istar i' Bereg trifft @WEN mitten am "
    "Oberkoerper.\n",
    ({DT_LIGHTNING}), ([SP_SHOW_DAMAGE:1]));

  AddSpell(2,1500, 
    "Ein Feuerball schnellt aus der Hand von Istar i' Bereg und trifft Dich.\n",
    "Ein Feuerball aus der Hand von Istar i' Bereg trifft @WEN .\n",
    ({DT_FIRE}), ([SP_SHOW_DAMAGE:1]));

  AddSpell(3,1000, 
    "Istar i' Bereg trifft Dich mit einem hervorgezauberten Riesenhammer.\n",
    "Istar i' Bereg beschwoert einen Riesenhammer, der @WEN mit aller Wucht trifft.\n",
    ({DT_BLUDGEON}), ([SP_SHOW_DAMAGE:1]));

  AddDefaultSpell(2, 1, DS_PARALYZE,
    "Istar i' Bereg spricht boese Formeln und Du kannst Dich nicht mehr bewegen!\n",
    "Istar i' Bereg paralysiert @WEN!\n" );

  AddDefaultSpell(3, 1, DS_ANTIMAGIC,
    "Istar i' Bereg verhindert Deine Zauber!\n",
    "Istar i' Bereg verhindert, dass @WER Magie anwenden kann!\n" );

  AddDefaultSpell(3, 100, DS_DISARM);    

  SetChats(2, ({
          "Istar i' Bereg spricht ein paar duestere Beschwoerungen.\n",
          "Istar i' Bereg murmelt unverstaendliche Worte.\n"}) );
  SetAttackChats(10, ({
    "Istar i' Bereg schuetzt sich mit einem magischen Schild.\n",
    "Istar i' Bereg weicht gekonnt aus.\n"}) );

 SUID;
  CLONEME( "/p/armour/boots/lederstiefel" );
  CLONEME( "/p/armour/trousers/hose" );
  CLONEME( "/d/dschungel/feyaria/tijara/armour/zauberrobe" );
  CLONEME( "/d/unterwelt/amazora/dimension/obj/statring");
  command("trage alles");

}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (find_call_out("react")!= -1)
    return;
  
  switch (gruppe) {
    case "aengstlich":
      call_out("reaction", 0, TP,
        "haelt Dich fuer ein unwichtiges Wesen, darum reagiert er nicht.",
        "findet Dich uninteressant.");
      break;
    case "aergerlich":
      call_out("reaction", 0, TP,
        "verflucht Dich.",
        "bewegt seine Haende und entzuendet ein Feuer unter Deinem Hintern.");
        TP->AddHp(-10);
      break;
    case "albern":
      call_out("reaction", 0, TP,
        "haelt Dich einfach nur fuer laestig.",
        "beachtet Dich nicht.");
      break;
    case "fies":
      call_out("reaction", 0, TP,
        "entzuendet magisch ein kleines Feuer unter Deinen Fuessen.",
        "tritt Dich.");
        TP->AddHp(-10);
      break;
    case "froh":
      call_out("reaction", 0, TP,
        "findet das ekelig.",
        "will Dich nicht mehr sehen.");
      break;
    case "intim":
      call_out("reaction", 0, TP,
        "verhext Dich sofort.",
        "findet das ekelig.");
      break;
    case "nett":
      call_out("reaction", 0, TP,
        "findet das ekelig.",
        "will Dich nicht mehr sehen.");
      break;
    case "neutral":
      call_out("reaction", 0, TP,
        "beruehrt das nicht besonders.",
        "beruehrt das nicht besonders.");
      break;
    case "traurig":
      call_out("reaction", 0, TP,
        "lacht Dich aus.",
        TP->Name(WER)+" wird von Istar ausgelacht.");
    break;
  }
}

void react(string victim, string others)
{
  if (present(TP, ENV(TO)))
  {
    tell_object(TP, BS(Name(WER) + " "+victim));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+others), ({TP,TO}));
  }
}


void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}


void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}
void daemon()
{
 object daemon;
 tell_room(ENV(TO), "Istar i' Bereg beschwoert einen Daemon, der ihn im Kampf unterstuetzt.\n");
daemon=clone_object (NPC "dwizard" );
 daemon->move(ENV(TO), M_GO|M_NOCHECK);
}

void Attack(object enemy)
{
   ::Attack(enemy);
   if (!random(5))
    daemon();
}

