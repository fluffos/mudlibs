inherit "p/std/dragons/dragon";

#include <properties.h>
#include <language.h>
#include <combat.h> // fuer die damage types
#include <moving.h> // fuer REJECT_KEEP
#include <defines.h>
#include <moredef.h>
#include "/gilden/waldlaeufer/ranger_tasks.h"


create()
{ int zufall;
  object ob;
  if (!is_clone(this_object())) return;
  ::create();    
  create_default_dragon(5,6,0,25);
  SetProp(P_SHORT, "Cruentosanies, der Blutdrache");
  SetProp(P_NAME, "Cruentosanies");
  AddId("cruentosanies");
  SetProp(P_ARTICLE, 0);
  SetProp(P_NAME_ADJ, 0);
  SetProp(P_LONG, 
      "Cruentosanies, der Blutdrache und Herrscher ueber den "
      "Tempel 'Iaun en Sereg'. Er hat riesige gelbe Zaehne und scharfe "
      "Krallen. Seine grossen gelben Augen mustern Dich und er erblickt "
      "Deine tiefsten Aengste und Sehnsuechte. Er ist ein gnadenloser "
      "Drache ohne Skrupel und Gefuehl.");
  SetProp(P_SPELLRATE, 30);
  
  //    Beschreibung
 
//    -------------
//    create_default_dragon(a,b,c,d);
//    a...DrachenLevel  Wert:1-5
//    b...DrachenAlter  Wert:1-12
//    c...Alignment     Wert:0/1
//    d...Schuppen      Wert:0-..
//   --------------  
//   
//   zu a,c:
//   
//   Die DrachenLevel sind Alignmentabhaengig (gut/boese) unterteilt in:
//    
//       |   # Gut         |    # Boese
//    *1 | Kupfer Drachen  | Schwarzer Drachen  
//    *2 | Bronze Drachen  | Weisser Drachen
//    *3 | Messing Drachen | Gruener Drachen
//    *4 | Silber Drachen  | Blauer Drachen
//    *5 | Gold Drachen    | Roter Drachen
//  
//     *...Wert a    #...Wert c
//   -------------- 
//   
//   zu b:
//   
//   Weiters gibt es noch 12 Altersabstufungen, und zwar:
//    
//                kundig erfahren weise
//    jung      |   1   |   2    |  3   |
//    erwachsen |   4   |   5    |  6   |
//    alt       |   7   |   8    |  9   |
//    steinalt  |  10   |  11    | 12   | 
//   --------------
//   
//   zu d:
//   
//   Dieser Wert legt fest wieviele Drachenschuppen ein Drache
//   bei sich traegt. (..werden benoetigt um bei Schmieden versch.
//   DrachenRuestungsTeile fertigen zu lassen.)
//  
//   Momentan Beschraenkungen noch nicht festgelegt!
//   (mal schaun...)
//   ----------------
//   
//   Es werden jetzt allerhand Props festgelegt, die auf den Drachen
//   abgestimmt sind. Eigentlich sollte man nur mehr (wenn man will)
//   Die P_LONG umsetzen. 
//   Sollte man Ruestungsteile reinclonen?! Mal ueberlegen...
//   Geld kann man reinclonen wenn man will...
 
 
}


public void die(int poisondeath)
{
  object ob, killer;

  killer = TP || QueryProp(P_KILLER);
  if(objectp(killer->QueryOwner())) killer = killer->QueryOwner();
  if(objectp(ob=present(RANGER_TASK_COURIER, killer))) {
    ob->SetTeil(1);
  }
   
  ::die(poisondeath);
}


