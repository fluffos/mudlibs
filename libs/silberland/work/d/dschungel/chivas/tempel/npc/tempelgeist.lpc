
inherit "std/npc/spells";
inherit "std/npc";

#include "../def.h"

void create() {
    
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein boeser Geist");
  SetProp(P_LONG, BS(
    "Das ist ein boeser Geist, welcher Dir nur zu gern nach "
    "Deinem Leben trachtet. Nichts wird ihn aufhalten koennen "
    "Dich zu vernichten."));
  SetProp(P_NAME, "Geist");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-20,T_RANGE_MAX:40]));
  AddId(({"geist"}));
 
 
   create_default_npc(25);
  SetProp(P_HANDS, ({" mit seinen Haenden an",280,DT_COLD}));
  SetProp(P_RACE, "Untoter");
  SetProp(P_SIZE, 180);
  SetProp(P_WEIGHT, 5000);
  SetProp(P_ALIGN, -450);
  SetProp(P_MAX_HANDS, 2);
 
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE,([ P_GUILD:(["paladine":1])]));
  SetProp(P_WIMPY, 0);
  SetProp(P_ARTICLE, 1);
 
    SetProp(P_RESISTANCE_STRENGTHS ,
    ([DT_FIRE:      -0.3,  DT_COLD:     -1,  DT_WATER: -0.3,  DT_AIR:   
-0.3,
      DT_LIGHTNING: -0.3,  DT_EXPLOSION: -0.3,  DT_SOUND:  -0.3,  
DT_LIGHT: 0.1,
      DT_ELECTRIC:  -0.3,  DT_ACID:      -1,  DT_POISON: -1,  DT_TERROR: -1,
      DT_HOLY:      0.3,  DT_UNHOLY:    -1,  DT_MAGIC:  -0.3,  
DT_MIND:   -1,
      DT_SLASH:     -0.2,  DT_BLUDGEON:   -0.2,  DT_PIERCE:  -0.2, 
DT_SQUEEZE:  -0.2,
      DT_WHIP:      -0.2,  DT_RIP:        -0.2]));
  SetProp(P_NOMAGIC,20);

  SetProp(P_MSGIN, "schwebt herein");
  SetProp(P_MSGOUT, "schwebt");
  SetProp(P_MMSGIN, "schwebt aus einem Tor");
  SetProp(P_MMSGOUT, "verschwindet");

  SetProp(P_DIE_MSG, " loest sich auf.\n");
  SetProp(P_NOCORPSE, 1);
  SetProp(P_KILL_NAME, "Ein boeser Geist");
  SetProp(P_KILL_MSG, "Deine Lebensenrgie wird mir schmecken.");
  SetProp(P_MURDER_MSG, "Ich werde zurueckkehren und mich an %s raechen.");
 
  AddInfo(DEFAULT_INFO, "wuerdigt Dich keines Blickes.\n");
 
     
  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Geist reagiert nicht auf Deinen Bestechungsversuch.\n" }) );

  SetChats(8, ({
          
        "Der Geist heult.\n",
    "Der Geist reisst sich selbst einen Arm aus.\n",
    "Der Geist betrachtet Dich eingehend.\n",
    "Der Geist murmelt etwas Unverstaendliches.\n",
    "Der Geist studiert jede Deiner Bewegungen.\n",
    "Der Geist zeigt mit einem toten Finger auf Dich und laechelt daemonisch.\n"}));
 
  SetAttackChats(10, ({
    "Der Geist heult zufrieden.\n",
    "Der Geist macht eine Finte.\n",
    "Der Geist konzentriert sich auf Deine boese Seele.\n"
    "Der Geist konzentriert sich auf Dein schwaches Herz.\n"}));

// ----- Spells Anfang -----

  SetProp(P_SPELLRATE, 40);

  AddSpell(3, 410, "Der Geist schleudert Dir eine Kaeltekugel entgegen.\n",
           "Der Geist schleudert @WEM eine Kaeltekugel entgegen.\n",
           ({DT_COLD,DT_UNHOLY}),([SP_SHOW_DAMAGE:1]) );

  AddSpell(2, 580, "Die Geist entzieht Dir Deine Lebensenergie.\n",
           "Die Geist saugt an den Kraeften von @WEM.\n",
           ({DT_UNHOLY, DT_COLD}), ([SP_SHOW_DAMAGE:1]));

  AddDefaultSpell(1, 350, DS_FEAR, "Der Geist bringt Dich um Deinen Verstand.\n",
                                   "Der Geist bringt @WEN um den Verstand.\n" );

// ----- Spells Ende -----
 
}

void StartReaction(string verb, string gruppe, string adverb, int touch) {
  if (find_call_out("react")!= -1)
    return;

 
  switch(gruppe)
  {
    case "fies":
      call_out("react", 0, "belegt Dich mit einem Fluch.",
     "belegt "+TP->Name(WEN)+" mit einem Fluch.");
      break;

    case "aergerlich":
      call_out("react", 0, "spuckt Dich an.",
        "spuckt "+TP->Name(WEM)+" an.");
    break;

    case "frech":
      call_out("react", 0, "zeigt Dir einen Vogel",
        "zeigt "+TP->Name(WEM)+" einen Vogel.");
    break;

    case "nett":
      call_out("react", 0, "spuckt Dich an.",
        " spuckt "+TP->Name(WEM)+" an.");
    break;

    case "froh":
      call_out("react", 0, "ist erleichtert.",
        "ist erleichtert.");
    break;

  }
}

void react(string victim, string others)
{
  if (present(TP, ENV(TO)))
  {
    tell_object(TP, BS(Name(WER) + " "+victim));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+others), ({TP,TO}));
  }
}


void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}


void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}



