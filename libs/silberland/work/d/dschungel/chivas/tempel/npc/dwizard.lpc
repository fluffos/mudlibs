
inherit "std/npc";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create()
 {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein boeser Daemon");
  SetProp(P_LONG, BS(
    "Ein boesartig aussehender Daemon mit einem ueblen Atem starrt Dich aus "
    "hohlen dummen Augen an. Er ist sicher nicht sehr klug, dafuer aber "
    "toedlich. "));
  SetProp(P_NAME, "Daemon");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:1,T_RANGE_MAX:2]));
  AddId( ({ "daemon"}) );

  create_default_npc(13);
  SetProp(P_HANDS, ({" mit ihren Haenden" ,QueryProp(P_HANDS)[1], DT_RIP }) );
  SetProp(P_RACE, "Daemon");
  SetProp(P_SIZE, 150 );
  SetProp(P_ALIGN, -500);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,2);
  SetProp(P_AGGRESSIVE,1);
  SetProp(P_SPELLRATE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_ARTICLE, 1);
  SetProp(P_NOMAGIC,20);

  SetProp(P_MSGIN, "schleicht herein.");
  SetProp(P_MSGOUT, "schleicht.");
  SetProp(P_MMSGIN, "entsteht aus einer Rauchwolke.");
  SetProp(P_MMSGOUT, "schleicht weiter.");

  SetProp(P_DIE_MSG,  " loesst sich in einer Rauchwolke auf.\n");
  SetProp(P_NOCORPSE, 1 );
  SetProp(P_KILL_NAME, "Ein boeser Daemon");
  SetProp(P_KILL_MSG, "Die dunkle Seite der Macht ist staerker!");

  AddDetail( ({ "augen"}),
    "Die Augen wirken kalt und unfreundlich.");
  AddDetail( ({ "atem"}),
    "Der Atem stinkt nach Tod.");
  AddDetail( ({ "tod"}),
    "Vielleicht ereilt er Dich bald..");

  AddInfo(DEFAULT_INFO, "ist zu dumm um Dich zu beachten.\n");
  AddInfo("chivas", "Chivas hat mich erschaffen.","sagt: ");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Daemon will Deine Sachen nicht haben.\n" }) );

  AddSpell(3,300, 
    "Ein dunkler Strahl des Daemons faehrt durch Deinen Koerper.\n",
    "Ein dunkler Strahl des Daemons trifft @WEN am ganzen Koerper.\n",
    ({DT_UNHOLY}), ([SP_SHOW_DAMAGE:1]));

  SetChats(1, ({
          "Der Daemon schleicht um Dich herum.\n"}) );
  SetAttackChats(10, ({
    "Der Daemon zerfetzt Dich.\n",
    "Der Daemon beisst Dich.\n"}) );

}

