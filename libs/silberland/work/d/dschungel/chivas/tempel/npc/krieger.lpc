//erstellt im mai 04 von chivas
inherit "std/mnpc";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <mnpc.h>
#include "../def.h"

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein alter Krieger");
  SetProp(P_LONG,
    "Dieser alte Krieger hat schon eine Menge Kaempfe durchgestanden. Er hat "
    "langes graues Haar und ein wettergegerbtes Gesicht. Er kann Dir sicher "
    "einiges ueber den Tempel erzaehlen.");
  SetProp(P_NAME, "Krieger");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId( ({ "krieger"}) );
  AddId(({"Schwertexperte"}));


  create_default_npc(33);
  SetProp(P_HANDS, ({" mit seinen Haenden" ,150, DT_RIP }) );
  SetProp(P_SIZE, 170 );
  SetProp(P_RACE, "Mensch");
  SetProp(P_ALIGN, 300);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_SPELLRATE,25);
  SetProp(P_ARTICLE, 1);
  SetProp(P_NOMAGIC,3);

  SetProp(P_MSGIN, "schreitet herein");
  SetProp(P_MSGOUT, "schreitet");
  SetProp(P_MMSGIN, "kommt Dich inspizierend herein");
  SetProp(P_MMSGOUT, "schreitet auf der Suche nach boesen Wesen weiter");
  
  SetProp(P_MNPC_AREA, ( {ROOM "tem8", ROOM "tem9", ROOM "tem10",
                          ROOM "tem11",ROOM "tem12", ROOM "tem13", 
                          ROOM "tem14", ROOM "tem15", ROOM "tem16",
                          ROOM "tem19",ROOM "tem20", ROOM "tem21", 
                          ROOM "tem25",ROOM "tem26", ROOM "tem27", 
                          ROOM "tem22", ROOM "tem23", ROOM "tem24",
                          ROOM "tem17",ROOM "tem18"}));
  SetProp(P_MNPC_WAIT, ({ 10, 20, 20 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "tem23");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS); 

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Ich komme wieder %s, dann bist Du dran!");
  SetProp(P_KILL_NAME, "Ein alter Krieger");
  SetProp(P_KILL_MSG, "Ich fordere mehr Respekt vor dem Alter!");

  AddDetail( ({ "menge", "kaempfe"}),
    "Der alte Krieger hat schon einige Kaempfe hinter sich.");
  AddDetail( ({ "haar"}),
    "Das lange graue Haar macht einen weisen Eindruck.");
  AddDetail( ({ "gesicht"}),
    "Das wettergegerbte Gesicht sieht wissend aus und hat auch ein paar "
    "Narben.");
  AddDetail( ({ "narben"}),
    "Die Narben stammen sicher von den vielen Kaempfen.");
  AddDetail( ({ "tempel"}),
    "Er weiss einiges ueber den Tempel.");

  AddInfo(DEFAULT_INFO, "weiss einiges ueber den dunklen Tempel.\n");
  AddInfo("chivas", "Chivas hat mich erschaffen.","sagt: ");

  AddInfo( ({"tempel"}),
    "Der Tempel wurde vor Jahrhunderten von boesen Kreaturen erbaut. ","sagt: ");

  AddInfo( ({"jahrhunderten","jahrhunderte"}),
    "Der Tempel war der Schrecken des Dschungels. Viele Dschungelelfen "
    "wurden hier geopfert. ","sagt: ");

  AddInfo( ({"kreaturen","skelette","zombies","ghoule"}),
    "Die Kreaturen waren hauptsaechlich Skelette, Zombies, Ghoule und "
    "Zauberer. Der wahre Schrecken war damals aber etwas anderes.","sagt: ");

  AddInfo( ({"schrecken"}),
    "Der Schrecken war damals ein junger nach blut duerstender Drache. ","sagt: ");

  AddInfo( ({"zauberer"}),
    "Der Tempel wurde von boesen Zauberern magisch geschuetzt. Ihre "
    "Magie ist immer noch sehr stark im Tempel. ","sagt: ");

  AddInfo( ({"dschungelelfen","elfen","heer"}),
    "Irgendwann maschierten die Dschungelelfen mit einem Heer im Tempel "
    "ein und vertrieben den Schrecken aus dem Tempel und dem Dschungel. "
    "Jedoch hat sich das Boese erneut im Tempel niedergelassen.","sagt: ");

  AddInfo( ({"boese"}),
    "Das Boese ist in den Tempel zurueck gekehrt und ist staerker als "
    "je zuvor. ","sagt: ");
  AddInfo( ({"magie","fallen"}),
    "Es gibt viele Fallen im Tempel. Viele dieser Fallen sind magisch. ","sagt: ");

  AddInfo( ({"drache","gegner","tempelspitze","spitze"}),
    "Der Drache ist zurueck gekehrt. Aber jetzt ist er nicht mehr jung und "
    "einfach zu vertreiben. Er ist alt, weise, gerissen und skrupelos. Ein "
    "toedlicher Gegner, der in der Tempelspitze auf einem Schatz sitzt.","sagt: ");

  AddInfo( ({"schatz"}),
    "Der Schatz soll riesig sein.","sagt: ");
    
  SetProp(P_LOG_INFO, "chivas/tempel");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der alte Krieger will Deine Sachen nicht tragen.\n" }) );
  AddSpell(3,700, 
     "Der alte Krieger trifft Dich nach einer gelungenen Finte.\n",
     "Der alte Krieger trifft @WEN nach einer gelungenen Finte.\n",
     ({DT_BLUDGEON}), ([SP_SHOW_DAMAGE:1]));

  SetChats(3, ({
    "Ein alter Krieger murmelt etwas ueber den abscheulichen Tempel.\n",
    "Ein alter Krieger verflucht die dunklen Geschoepfe im Tempel.\n",
    "Ein alter Krieger murmelt etwas von Ratschlaegen.\n"}) );
  SetAttackChats(10, ({
    "Der alte Krieger schlaegt Dich nieder.\n",
    "Der alte Krieger ueberrascht Dich mit ein paar Tricks.\n"}) );

 SUID;
  CLONEME( "/p/armour/shield/kupferschild" );
  CLONEME( "/p/armour/gloves/lederhandschuhe" );
  CLONEME( "/p/armour/armour/lederruestung" );
  CLONEME( "/p/weapon/sword/kurzschwert");
  command("trage alles");
  command("zuecke schwert");
  
}

// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch) {
  if (find_call_out("reaction") != -1) return;
  switch (gruppe) {
    case "aengstlich":
      call_out("reaction", 0, TP,
        "redet beruhigend auf Dich ein.",
        "beruhigt Dich fluesternd.");
      break;
    case "aergerlich":
      call_out("reaction", 0, TP,
        "schimpft leise auf Dich.",
        "grummelt ueber Dich fluesternd.");
      break;
    case "albern":
      call_out("reaction", 0, TP,
        "findet gar nichts lustig.",
        "findet gar nichts lustig.");
      break;
    case "fies":
      call_out("reaction", 0, TP,
        "droht Dir mit einem Schwert.",
        "schaut boese.");
      break;
    case "frech":
      call_out("reaction", 0, TP,
        "faucht Dich fluesternd an.",
        "faucht fluesternd.");
      break;
    case "froh":
      call_out("reaction", 0, TP,
        "laechelt Dich guetig an.",
        "laechelt guetig.");
      break;
    case "intim":
      call_out("reaction", 0, TP,
        "fluestert Dir zu: Nicht wenn ich Dienst habe Schatz.",
        "fluestert Dir zu: Spaeter mein Engel, jetzt muss ich arbeiten.");
      break;
    case "nett":
      call_out("reaction", 0, TP,
        "schaut Dich streng an.",
        "guckt ein wenig boese.");
      break;
    case "neutral":
      call_out("reaction", 0, TP,
        "beruehrt das nicht besonders.",
        "beruehrt das nicht besonders.");
      break;
    case "traurig":
      call_out("reaction", 0, TP,
        "troestet Dich.",
        TP->Name(WER)+" wird von einem Krieger getroestet.");
      break;
  }
}
void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}

