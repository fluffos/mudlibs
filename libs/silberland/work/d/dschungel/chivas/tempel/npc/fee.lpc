
inherit "std/npc";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create()
 {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine kleine verwirrte Fee");
  SetProp(P_LONG, BS(
    "Eine kleine Fee steht zitternd vor Dir. Sie hat ueberall Schuerfwunden "
    "und sieht ziemlich fertig aus. Ihre angstvollen Augen machen einen "
    "verwirrten Eindruck. Sie muss schon einiges hier im Tempel erlebt "
    "haben."));
  SetProp(P_NAME, "Fee");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10,T_RANGE_MAX:30]));
  AddId( ({ "fee"}) );

  create_default_npc(16);
  SetProp(P_HANDS, ({" mit ihren Haenden" ,QueryProp(P_HANDS)[1], DT_RIP }) );
  SetProp(P_RACE, "Fee");
  SetProp(P_SIZE, 280 );
  SetProp(P_ALIGN, 700);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,2);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_ARTICLE, 1);
  SetProp(P_NOMAGIC,5);

  SetProp(P_MSGIN, "rennt herein");
  SetProp(P_MSGOUT, "rennt");
  SetProp(P_MMSGIN, "laeuft zitternd herein");
  SetProp(P_MMSGOUT, "laeuft vor Angst schreiend weiter");

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_KILL_NAME, "Eine Fee");
  SetProp(P_KILL_MSG, "Du tust mir nicht mehr weh!");

  AddDetail( ({ "schuerfwunden","wunden","versuch"}),
    "Die Wunden hat sie sich sicher bei dem Versuch zu entkommen zugezogen.");
  AddDetail( ({ "augen"}),
    "Ihre Augen haben einen angstvollen Eindruck.");
  AddDetail( ({ "eindruck"}),
    "Sie scheint schon ganz verwirrt zu sein.");

  AddInfo(DEFAULT_INFO, "zuckt nur veraengstigt zusammen.\n");
  AddInfo("chivas", "Chivas hat mich erschaffen.","sagt: ");

  AddInfo( ({"angst"}),
    "Ich laufe hier schon seit Tagen alleine rum. Ich will nur hier raus. ","sagt: ");

 AddInfo( ({"hilfe"}),
    "Ich trau Dir nicht, Du gehoerst doch auch zu den Boesen, ich traue "
    "niemandem mehr. ","sagt: ");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Die kleine Fee will Deine Sachen nicht haben.\n" }) );

  SetChats(2, ({
          "Die kleine Fee zuckt bei jeder Deiner Bewegungen aengstlich "
          "zusammen.\n",
          "Die kleine Fee zittert am ganzen Koerper.\n"}) );
  SetAttackChats(10, ({
    "Die kleine Fee pruegelt voller Angst auf Dich ein.\n",
    "Die kleine Fee ruft nach Hilfe.\n"}) );

 SUID;
  CLONEME( "/p/weapon/knife/dolch" );
  CLONEME( "/d/ebene/ronja/feenquest/armour/spitz" );
  CLONEME( "/d/ebene/ronja/feenquest/armour/kleid" );
  CLONEME( "/d/ebene/ronja/feenquest/armour/brustp");
  command("trage alles");
  command("zuecke dolch");

}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (find_call_out("react")!= -1)
    return;
  
  switch (gruppe) {
    case "aengstlich":
      call_out("reaction", 0, TP,
        "hat selbst zuviel Angst um Dich zu beruhigen.",
        "beruhigt Dich fluesternd.");
      break;
    case "aergerlich":
      call_out("reaction", 0, TP,
        "traut sich nicht darauf zu reagieren.",
        "grummelt ueber Dich fluesternd.");
      break;
    case "albern":
      call_out("reaction", 0, TP,
        "hat viel zu viel Angst um auf Deine Albernheiten zu reagieren.",
        "kichert leise.");
      break;
    case "fies":
      call_out("reaction", 0, TP,
        "kreischt laut los vor Angst.",
        "tritt Dich.");
      break;
    case "froh":
      call_out("reaction", 0, TP,
        "fuerchtet sich trotzdem.",
        "laechelt guetig.");
      break;
    case "intim":
      call_out("reaction", 0, TP,
        "will Dich eigentlich nicht mehr loslassen.",
        "kuschelt Dich zaertlich.");
      break;
    case "nett":
      call_out("reaction", 0, TP,
        "hat viel zu viel Angst.",
        "fluestert das ihr das sehr gefaellt.");
      break;
    case "neutral":
      call_out("reaction", 0, TP,
        "beruehrt das nicht besonders.",
        "beruehrt das nicht besonders.");
      break;
    case "traurig":
      call_out("reaction", 0, TP,
        "braucht selber Trost.",
        TP->Name(WER)+" wird von einer kleinen Fee getroestet.");
    break;
  }
}

void react(string victim, string others)
{
  if (present(TP, ENV(TO)))
  {
    tell_object(TP, BS(Name(WER) + " "+victim));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+others), ({TP,TO}));
  }
}


void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}


void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}
