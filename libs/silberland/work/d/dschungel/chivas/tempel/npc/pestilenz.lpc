
inherit "std/npc";
inherit "std/npc/spells";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create()
 {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Pestilenz, ein Reiter der Apokalypse");
  SetProp(P_LONG, BS(
    "Pestilenz sieht sehr ungesund aus. Er ist ueberall mit grossen Pusteln "
    "und Eitergeschwueren bedeckt. Er sieht sehr krank aus wie er auf seinem "
    "Pferd sitzt. Man sollte ihn aber denoch nicht unterschaetzen."));
  SetProp(P_NAME, "Pestilenz");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10,T_RANGE_MAX:30]));
  AddId( ({ "pestilenz","reiter"}) );
  AddId(({"Schwertmeister"}));

  create_default_npc(38);
  SetProp(P_HANDS, ({" mit seinen gelblich kranken Klauen" ,QueryProp(P_HANDS)[1], DT_RIP }) );
  SetProp(P_RACE, "Daemon");
  SetProp(P_SIZE, 280 );
  SetProp(P_ALIGN, -800);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,2);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_SPELLRATE,60);
  SetProp(P_WIMPY, 0);
  SetProp(P_ARTICLE, 0);
  SetProp(P_NOMAGIC,30);
  SetProp(P_RESISTANCE_STRENGTHS , 
  ([DT_FIRE:      -0.2,  DT_COLD:     -0.2,  DT_WATER: -0.2,  DT_AIR:   -0.2, 
    DT_LIGHTNING: 0.3,  DT_EXPLOSION: 0.4,  DT_SOUND:  -0.3,  DT_LIGHT: 0.5,
    DT_HOLY:      0.4,  DT_UNHOLY:  -0.2,  DT_MAGIC: -0.2, DT_BLUDGEON: 0.4,
    DT_PIERCE: -0.5, DT_SLASH: -0.7]));

  SetProp(P_MSGIN, "reitet herein.");
  SetProp(P_MSGOUT, "reitet.");
  SetProp(P_MMSGIN, "reitet geschwind herein.");
  SetProp(P_MMSGOUT, "reitet weiter.");

  SetProp(P_DIE_MSG,  " loest sich in Rauch auf.\n");
  SetProp(P_NOCORPSE, 1 );
  SetProp(P_KILL_NAME, "Pestilenz, ein Reiter der Apokalypse");
  SetProp(P_KILL_MSG, "Gruess meinen Bruder TOD von mir!");

  AddDetail( ({ "pusteln","pustel"}),
    "Die Pusteln sehen ekelig aus und eine zaehe Fluessigkeit fliesst aus "
    "ihnen heraus. Dir wird beim Anblick schlecht.");
  AddDetail( ({ "pferd"}),
    "Das Pferd hat auch lauter Geschwuere und Ausschlaege wie Pestilenz.");
  AddDetail( ({ "eiter","eitergeschwuere","geschwuere","geschwuer","eitergeschwuer"}),
    "Die Eitergeschwuere von Pestilenz scheinen zu leben.");
  AddDetail( ({ "fluessigkeit"}),
    "Es ist einfach nur ekelig.");

  AddDetail( ({ "ausschlaege"}),
    "Die Ausschlaege sehen nicht besser als die Geschwuere aus.");
  AddInfo(DEFAULT_INFO, "reagiert nicht auf kleine Abenteurer.\n");
  AddInfo("chivas", "Chivas hat mich erschaffen.","sagt: ");

  AddInfo( ({"tod","hunger","krieg"}),
    "Tod, Hunger und Krieg sind meine Brueder. ","sagt: ");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Pestilenz will Deine Sachen nicht haben.\n" }) );

  AddSpell(5,750, 
     "Pestilenz schmettert Dir kleine Blitze entgegen.\n",
     "Pestilenz zerschmettert @WEN mit der Macht von Blitzen.\n",
     ({DT_LIGHTNING}), ([SP_SHOW_DAMAGE:1]));

  AddDefaultSpell(3, 1, DS_POISON,
     "Pestilenz vergiftet Dich leicht.\n",
     "Pestilenz vergiftet @WEN leicht.\n",
     5);
  
  AddDefaultSpell(3, 100, DS_DISARM);     
  SetChats(2, ({
          "Pestilenz durchbohrt Dich mit seinen Blick.\n",
          "Pestilenz haucht Dich mit seinem ueblen Atem an.\n"}) );
  SetAttackChats(10, ({
    "Pestilenz zerreist Dich mit seinen Klauen.\n",
    "Pestilenz zerschmettert Dich voller Kraft.\n"}) );

 SUID;
  CLONEME( "/d/ebene/obj/waffe/mithrilschwert" );
  CLONEME( "/d/ebene/obj/ruestung/schw_umhang" );
  CLONEME( "/d/kristallwald/chivas/zentauren/armour/sternenpanzer" );
  CLONEME( "/d/kristallwald/chivas/zentauren/armour/sternenhelm");
  command("trage alles");
  command("zuecke schwert");

}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (find_call_out("react")!= -1)
    return;

  
  switch(gruppe)
  {
    case "fies": 
      call_out("react", 0, "knurrt Dich an.", "knurrt " +
        TP->Name(WEN) + " boesartig.");
      break; 

    case "aergerlich":
      call_out("react", 0, "droht mit seinen Klauen.",
        "bedroht " + TP->Name(WEM) +
        " mit seinen Klauen.");
    break;

    default:
      call_out("react", 0, "schleicht umher.",
	"schleicht herum.");
    break;
  }
}

void react(string victim, string others)
{
  if (present(TP, ENV(TO)))
  {
    tell_object(TP, BS(Name(WER) + " "+victim));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+others), ({TP,TO}));
  }
}


void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}


void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}
