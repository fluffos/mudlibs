//erstellt im mai 04 von chivas
inherit "std/mnpc";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <mnpc.h>
#include "../def.h"

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Krieger der Dschungelelfen");
  SetProp(P_LONG,
    "Der junge Elfenkrieger scheint hier auf dem Tempel Patrouille zu laufen. "
    "Seine Figur ist schlank und athletisch. Sein Gesicht sieht nett aber "
    "dennoch sehr ernst aus. Er scheint seine Aufgabe sehr ernst zu nehmen.");
  SetProp(P_NAME, ({"Krieger der Dschungelelfen",
                    "Kriegers der Dschungelelfen",
                    "Krieger der Dschungelelfen",
                    "Krieger der Dschungelelfen",
                    }));
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId( ({ "krieger","dschungelelf","elfenkrieger"}) );
  AddId(({"Schwertexperte"}));


  create_default_npc(28);
  SetProp(P_HANDS, ({" mit seinen Haenden" ,QueryProp(P_HANDS)[1], DT_RIP }) );
  SetProp(P_SIZE, 220 );
  SetProp(P_RACE, "Elf");
  SetProp(P_ALIGN, 500);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,2);
  SetProp(P_WIMPY, 0);
  SetProp(P_SPELLRATE,20);
  SetProp(P_ARTICLE, 1);
  SetProp(P_NOMAGIC,10);

  SetProp(P_MSGIN, "schreitet herein");
  SetProp(P_MSGOUT, "schreitet");
  SetProp(P_MMSGIN, "kommt Dich inspizierend herein");
  SetProp(P_MMSGOUT, "schreitet auf der Suche nach boesen Wesen weiter");
  
  SetProp(P_MNPC_AREA, ( {ROOM "tem1-10", ROOM "tem1-11", ROOM "tem1-12",
                          ROOM "tem1-13",ROOM "tem1-17", ROOM "tem1-18", 
                          ROOM "tem1-14", ROOM "tem1-15", ROOM "tem1-16",
                          ROOM "tem1-19",ROOM "tem1-20", ROOM "tem1-21", 
                          ROOM "tem1-25", ROOM "tem1-22", ROOM "tem1-23", 
                          ROOM "tem1-24"}));
  SetProp(P_MNPC_WAIT, ({ 10, 20, 20 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "tem1-18");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS); 

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Ich komme wieder %s, dann wird das Gute gewinnen!");
  SetProp(P_KILL_NAME, "Ein Krieger der Dschungelelfen");
  SetProp(P_KILL_MSG, "Du hattest die falsche Seite gewaehlt!");

  AddDetail( ({ "tempel"}),
    "Er scheint den Tempel zu bewachen.");
  AddDetail( ({ "patrouille"}),
    "Er macht einscheinend eine Patrouille.");
  AddDetail( ({ "gesicht"}),
    "Sein Gesicht ist sehr ernst. Seine Aufgabe scheint ihm sehr wichtig zu "
    "sein.");
  AddDetail( ({ "figur"}),
    "Seine Figur ist athletisch. Er ist sicher ein guter Kaempfer.");
  AddDetail( ({ "aufgabe"}),
    "Seine Aufgabe ist den Tempel zu bewachen.");

  AddInfo(DEFAULT_INFO, "bewacht weiter den Tempel und laesst sich nicht ablenken.\n");
  AddInfo("chivas", "Chivas hat mich erschaffen.","sagt: ");

  AddInfo( ({"tempel"}),
    "Der Tempel ist von schrecklichen Kreaturen bewohnt, obwohl wir "
    "sie vor Jahren vertrieben haben, ist das Boese zurueck gekehrt. "
    "Seitdem halten wir Wache, dass das Boese im Tempel bleibt und sich "
    "nicht in den Dschungel ausbreitet.","sagt: ");

  AddInfo( ({"jahren"}),
    "Wir, die Dschungelelfen, hatten das Boese vertrieben, aber es ist "
    "in den Tempel zurueck gekehrt. ","sagt: ");

  AddInfo( ({"kreaturen","wesen","skelette","zombies","ghoule"}),
    "Die Kreaturen sind hauptsaechlich Skelette, Zombies, Ghoule und "
    "noch viele andere Wesen.","sagt: ");

  AddInfo( ({"boese","tempelspitze","spitze"}),
    "Das Boese soll direkt in der Tempelspitze sitzen, ich war damals "
    "noch zu jung und war nie dort oben.","sagt: ");

  AddInfo( ({"dschungelelfen","elfen","heer"}),
    "Irgendwann maschierten die Dschungelelfen mit einem Heer im Tempel "
    "ein und vertrieben den Schrecken aus dem Tempel und dem Dschungel. "
    "Jedoch hat sich das Boese erneut im Tempel niedergelassen.","sagt: ");

  AddInfo( ({"boese"}),
    "Das Boese ist in den Tempel zurueck gekehrt und ist staerker als "
    "je zuvor. ","sagt: ");

  AddInfo( ({"wache","patrouille"}),
    "Seit das Boese zurueck gekehrt ist halten wir hier Wache und passen auf. "
    ,"sagt: ");

  SetProp(P_LOG_INFO, "chivas/tempel");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Krieger will Deine Sachen nicht tragen.\n" }) );
  AddSpell(3,600, 
     "Der Elfenkrieger trifft Dich voller Wucht mit einem gekonnten Schlag.\n",
     "Der Elfenkrieger trifft @WEN voller Wucht mit einem gekonnten Schlag.\n",
     ({DT_BLUDGEON}), ([SP_SHOW_DAMAGE:1]));

  SetChats(3, ({
    "Der Elfenkrieger achtet auf jede Bewegung am Tempel.\n",
    "Der Elfenkrieger beobachtet misstrauisch die Fenster.\n",
    "Der Elfenkrieger nimmt seine Patrouille sehr ernst.\n"}) );
  SetAttackChats(10, ({
    "Der Elfenkrieger schlaegt Dich nieder.\n",
    "Der Elfenkrieger ueberrascht Dich mit ein paar Tricks.\n"}) );

 SUID;
  CLONEME( "/d/kristallwald/sargola/dorf/armour/armschienen" );
  CLONEME( "/p/armour/armour/lederpanzer" );
  CLONEME( "/p/weapon/sword/bihaender" );
  CLONEME( "/p/armour/gloves/lederhandschuhe");
  command("trage alles");
  command("zuecke bihaender");
  
}

// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch) {
  if (find_call_out("reaction") != -1) return;
  switch (gruppe) {
    case "aengstlich":
      call_out("reaction", 0, TP,
        "redet beruhigend auf Dich ein.",
        "beruhigt Dich fluesternd.");
      break;
    case "aergerlich":
      call_out("reaction", 0, TP,
        "schimpft leise auf Dich.",
        "grummelt ueber Dich fluesternd.");
      break;
    case "albern":
      call_out("reaction", 0, TP,
        "findet gar nichts lustig.",
        "findet gar nichts lustig.");
      break;
    case "fies":
      call_out("reaction", 0, TP,
        "droht Dir mit einem Schwert.",
        "schaut boese.");
      break;
    case "frech":
      call_out("reaction", 0, TP,
        "faucht Dich fluesternd an.",
        "faucht fluesternd.");
      break;
    case "froh":
      call_out("reaction", 0, TP,
        "laechelt Dich guetig an.",
        "laechelt guetig.");
      break;
    case "intim":
      call_out("reaction", 0, TP,
        "fluestert Dir zu: Nicht wenn ich Dienst habe Schatz.",
        "fluestert Dir zu: Spaeter mein Engel, jetzt muss ich arbeiten.");
      break;
    case "nett":
      call_out("reaction", 0, TP,
        "schaut Dich streng an.",
        "guckt ein wenig boese.");
      break;
    case "neutral":
      call_out("reaction", 0, TP,
        "beruehrt das nicht besonders.",
        "beruehrt das nicht besonders.");
      break;
    case "traurig":
      call_out("reaction", 0, TP,
        "troestet Dich.",
        TP->Name(WER)+" wird von einem Krieger getroestet.");
      break;
  }
}
void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}

