
inherit "std/npc";
inherit "std/npc/spells";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create()
 {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Hunger, Reiter der Apokalypse");
  SetProp(P_LONG, BS(
    "Hunger sitzt ausgemergelt auf seinem schrecklich aussehendem Pferd. "
    "Man kann die einzelnen Knochen unter seiner schlaffen Haut deutlich "
    "erkennen. Seine Ruestung sitzt recht locker. Trotzdem sollte "
    "man ihn nicht unterschaetzen."));
  SetProp(P_NAME, "Hunger");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10,T_RANGE_MAX:30]));
  AddId( ({ "hunger","reiter"}) );
  AddId(({"Schwertmeister"}));

  create_default_npc(38);
  SetProp(P_HANDS, ({" mit seinen Klauen" ,QueryProp(P_HANDS)[1], DT_RIP }) );
  SetProp(P_RACE, "Daemon");
  SetProp(P_SIZE, 280 );
  SetProp(P_ALIGN, -800);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,2);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_SPELLRATE,60);
  SetProp(P_WIMPY, 0);
  SetProp(P_ARTICLE, 0);
  SetProp(P_NOMAGIC,30);

  SetProp(P_MSGIN, "reitet herein.");
  SetProp(P_MSGOUT, "reitet.");
  SetProp(P_MMSGIN, "reitet geschwind herein.");
  SetProp(P_MMSGOUT, "reitet weiter.");

  SetProp(P_DIE_MSG,  " loest sich in Rauch auf.\n");
  SetProp(P_NOCORPSE, 1 );
  SetProp(P_KILL_NAME, "Hunger, Reiter der Apokalypse");
  SetProp(P_KILL_MSG, "Gruess meinen Bruder TOD von mir!");

  AddDetail( ({ "pferd"}),
    "Das Pferd sieht genau so ausgemergelt aus wie Hunger selbst.");
  AddDetail( ({ "knochen","haut"}),
    "Die Knochen sind deutlich unter der blassen Haut zu erkennen.");
  AddDetail( ({ "ruestung"}),
    "Die Ruestung sitzt zwar locker, ist aber in einem tadelosen Zustand.");

  AddInfo(DEFAULT_INFO, "reagiert nicht auf kleine Abenteurer.\n");
  AddInfo("chivas", "Chivas hat mich erschaffen.","sagt: ");

  AddInfo( ({"tod","pestilenz","krieg"}),
    "Tod, Pestilenz und Krieg sind meine Brueder. ","sagt: ");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Hunger will Deine Sachen nicht haben.\n" }) );

  AddSpell(4,650, 
     "Hunger schmettert Dir kleine Blitze entgegen.\n",
     "Hunger zerschmettert @WEN mit der Macht von Blitzen.\n",
     ({DT_LIGHTNING}), ([SP_SHOW_DAMAGE:1]));


  AddDefaultSpell(3, 1, DS_SLOW,
     BS("Hunger bringt Deinen Verstand durcheinander und Du glaubst jeden "
        "Momemnt vor Hunger tot umzufallen. Du kannst Dich vor Hunger "
        "kaum noch bewegen."),
     "Hunger laesst @WEN vor lauter Erschoepfung kriechen.\n",
     1+random(5));

  AddDefaultSpell(3, 1, DS_POISON,
     "Hunger bringt Deine Verdauung durcheinander, Du erholst Dich nichtmehr.\n",
     "Huger laesst @WEN verhungern.\n",
     1);
  
  AddDefaultSpell(3, 100, DS_DRAIN_MANA);  
 
  SetChats(2, ({
          "Hunger durchbohrt Dich mit seinen Blick.\n",
          "Hunger haucht Dich mit seinem ueblen Atem an.\n"}) );
  SetAttackChats(10, ({
    "Hunger zerreist Dich mit seinen Klauen.\n",
    "Hunger zerschmettert Dich voller Kraft.\n"}) );

 SUID;
  CLONEME( "/d/ebene/obj/waffe/mithrilschwert" );
  CLONEME( "/d/ebene/obj/ruestung/schw_umhang" );
  CLONEME( "/d/kristallwald/chivas/zentauren/armour/sternenpanzer" );
  CLONEME( "/d/kristallwald/chivas/zentauren/armour/sternenhelm");
  command("trage alles");
  command("zuecke schwert");

}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (find_call_out("react")!= -1)
    return;

  
  switch(gruppe)
  {
    case "fies": 
      call_out("react", 0, "knurrt Dich an.", "knurrt " +
        TP->Name(WEN) + " boesartig.");
      break; 

    case "aergerlich":
      call_out("react", 0, "droht mit seinen Klauen.",
        "bedroht " + TP->Name(WEM) +
        " mit seinen Klauen.");
    break;

    default:
      call_out("react", 0, "schleicht umher.",
	"schleicht herum.");
    break;
  }
}

void react(string victim, string others)
{
  if (present(TP, ENV(TO)))
  {
    tell_object(TP, BS(Name(WER) + " "+victim));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+others), ({TP,TO}));
  }
}


void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}


void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}
