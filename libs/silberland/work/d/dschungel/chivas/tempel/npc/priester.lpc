
inherit "std/npc";
inherit "std/npc/spells";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create()
 {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Priester des Tempels");
  SetProp(P_LONG, BS(
    "Der Priester ist fuer die boesartigen Rituale hier im Tempel zustaendig. "
    "Er leitet diese Rituale und fuehrt sie auch selber durch. Seine Haende "
    "sehen ein wenig blutig aus, als ob er gerade etwas geopfert hat."));
  SetProp(P_NAME, "Priester");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10,T_RANGE_MAX:30]));
  AddId( ({ "priester"}) );

  create_default_npc(32);
  SetProp(P_HANDS, ({" mit ihren Haenden" ,QueryProp(P_HANDS)[1], DT_RIP }) );
  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 180 );
  SetProp(P_ALIGN, -300);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,2);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_ARTICLE, 1);
  SetProp(P_NOMAGIC,15);
  SetProp(P_RESISTANCE_STRENGTHS , 
  ([DT_FIRE:      0.2,  DT_COLD:     0.2,  DT_WATER: 0.0,  DT_AIR:   0.0, 
    DT_LIGHTNING: 0.3,  DT_EXPLOSION: 0.4,  DT_SOUND:  0.3,  DT_LIGHT: 0.3,
    DT_ELECTRIC:  0.0,  DT_ACID:      0.0,  DT_POISON: 0.0,  DT_TERROR: 0.0,
    DT_HOLY:      0.2,  DT_UNHOLY:  -0.7,  DT_MAGIC: -0.2, DT_BLUDGEON: 0.0]));

  SetProp(P_MSGIN, "kommt betend herein");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "laeuft betend herein");
  SetProp(P_MMSGOUT, "laeuft betend weiter");

  SetProp(P_DIE_MSG,  " faellt tot zu Bode.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_KILL_NAME, "Ein Priester");
  SetProp(P_KILL_MSG, "Du Unglaeubiger hattest keine Chance!");

  AddDetail( ({ "rituale","ritual"}),
    "Du willst eigentlich nichts ueber die Rituale wissen, der Anblick der"
    "blutigen Haende reicht Dir vollkommen.");
  AddDetail( ({ "anblicke","haende"}),
    "Die Haende des Priesters sind blutverschmiert.");
  AddDetail( ({ "tempel"}),
    "Er ist fuer die Rituale hier im Tempel zustaendig.");

  AddInfo(DEFAULT_INFO, "betet unbeeindruckt weiter.\n");
  AddInfo("chivas", "Chivas hat mich erschaffen.","sagt: ");

  AddInfo( ({"tempel","ort"}),
    "Dies ist der Tempel des Blutes. Ein heiliger Ort, senke Dein Haupt. ","sagt: ");
  AddInfo( ({"ritual","rituale"}),
    "Die Rituale sind dem Drachen des Tempels gewidmet ","sagt: ");

 AddInfo( ({"blut"}),
    "Blut ist die Lebenskraft in jedem Wesen. Der Herrscher des Tempels "
    "badet gerne in Blut. ","sagt: ");

 AddInfo( ({"herrscher"}),
    "Der Herrscher des Tempels ist ein uralter Drache. ","sagt: ");

 AddInfo( ({"drache","wesen","namen"}),
    "Der Drache ist ein heiliges Wesen. Seinen Namen wage ich nicht "
    "auszusprechen.","sagt: ");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Priester will Dein Opfer nicht annehmen.\n" }) );

  AddSpell(5,800, 
    "Ein dunkler Strahl Energie des Priesters trifft Dich.\n",
    "Ein dunkler Strahl Energie des Priesters trifft @WEN und er zittert am "
    "ganzen Koerper.\n",
    ({DT_UNHOLY}), ([SP_SHOW_DAMAGE:1]));

  AddSpell(1,900, 
    "Ein Feuerball schnellt aus der Hand des Priesters und trifft Dich.\n",
    "Ein Feuerball aus der Hand des Priesters trifft @WEN .\n",
    ({DT_FIRE}), ([SP_SHOW_DAMAGE:1]));

  AddDefaultSpell(3, 100, DS_DISARM);    

  SetChats(3, ({
          "Der Priester kniet nieder und betet vor dem Altar.\n",
          "Der Priester betet das Boese an.\n",
          "Der Priester verflucht Ayla.\n"}) );
  SetAttackChats(10, ({
    "Der Priester verflucht Dich.\n",
    "Der Priester fleht das Boese um Beistand an.\n"}) );

 SUID;
  CLONEME( "/p/weapon/club/kampfstab" );
  CLONEME( "/p/armour/trousers/hose" );
  CLONEME( "/p/armour/boots/lederstiefel" );
  CLONEME( "/d/wueste/arthoas/erg/armour/mkutte");
  command("trage alles");
  command("zuecke stab");

}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (find_call_out("react")!= -1)
    return;
  
  switch (gruppe) {
    case "aengstlich":
      call_out("reaction", 0, TP,
        "lacht Dich aus.",
        "findet Dich laestig.");
      break;
    case "aergerlich":
      call_out("reaction", 0, TP,
        "verflucht Dich.",
        "grummelt Dich an.");
      break;
    case "albern":
      call_out("reaction", 0, TP,
        "haelt Dich fuer albern und beachtet Dich nicht.",
        "findet Dich gar nicht witzig.");
      break;
    case "fies":
      call_out("reaction", 0, TP,
        "murmelt leise ein paar Verfluchungen.",
        "schaut Dich boese an.");
      break;
    case "froh":
      call_out("reaction", 0, TP,
        "interessiert sich nicht fuer Dich.",
        "laechelt fies.");
      break;
    case "intim":
      call_out("reaction", 0, TP,
        "findet Deine Annaehrung laestig.",
        "findet Dich nervig.");
      break;
    case "nett":
      call_out("reaction", 0, TP,
        "interessiert sich nicht fuer Dich.",
        "laechelt fies.");
      break;
    case "neutral":
      call_out("reaction", 0, TP,
        "beruehrt das nicht besonders.",
        "beruehrt das nicht besonders.");
      break;
    case "traurig":
      call_out("reaction", 0, TP,
        "haelt Dich fuer ein Weichei.",
        TP->Name(WER)+" wird von einem Priester ausgelacht.");
    break;
  }
}

void react(string victim, string others)
{
  if (present(TP, ENV(TO)))
  {
    tell_object(TP, BS(Name(WER) + " "+victim));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+others), ({TP,TO}));
  }
}


void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}


void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}
