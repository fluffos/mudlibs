
inherit "std/npc";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create()
 {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Steinloewe");
  SetProp(P_LONG, "Ein Steinloewe, dessen Maehne gerade zu "
      "gigantisch ist. Seine Zaehne glaenzen in einer silbernen Farbe und "
      "sehen sehr spitz aus. Die grossen Muskeln kann man sehr gut auf "
      "seiner steinernden Haut sehen.");
  SetProp(P_NAME,"Steinloewe");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10,T_RANGE_MAX:35]));
  AddId(({ "steinloewe","loewe" }));

  create_default_npc(15);
  SetProp(P_HANDS, ({" mit seinen Klauen" ,QueryProp(P_HANDS)[1], DT_RIP }) );
  SetProp(P_RACE, "Loewe");
  SetProp(P_SIZE, 250 );
  SetProp(P_ALIGN, 500);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_HEAL,2);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_ARTICLE, 1);
  SetProp(P_SPELLRATE, 15);
  SetProp(P_NOMAGIC,10);

  SetProp(P_MSGIN, "springt herein");
  SetProp(P_MMSGIN, "springt herein");
  SetProp(P_MMSGOUT, "springt hinaus");
  SetProp(P_MSGOUT, "springt");

  SetProp( P_DIE_MSG, " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_KILL_NAME, "Ein Steinloewe");
  SetProp( P_KILL_MSG, ({"GROAHRRRRRRT.",MSG_EMOTE}));

  AddDetail( ({ "stein"}),
    "Der Steinloewe besteht aus blanken Stein.");
  AddDetail( ({ "zaehne","farbe","silber"}),
    "Die Zaehne scheinen aus Silber zu sein.");
  AddDetail( ({ "muskeln"}),
    "Die Muskeln des Steinloewen scheinen sehr stark zu sein.");
  AddDetail( ({ "haut","fell"}),
    "Die Haut und das Fell besteht aus hartem Stein.");

  AddInfo(DEFAULT_INFO, "ist viel zu dumm um Dich zu verstehen.\n");
  AddInfo("chivas", "Chivas hat mich erschaffen.","sagt: ");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Der Steinloewe will Deine Sachen nicht haben.\n" }) );

  AddSpell(2,500, 
	" Der Steinloewe zerfetzt Dich mit seinen Klauen und Zaehnen.\n",
	" Der Steinloewe zerfetzt @WEN mit seinen Klauen und Zaehnen.\n",
     ({DT_BLUDGEON}), ([SP_SHOW_DAMAGE:1]));

  SetChats(2, ({
          "Der Steinloewe schleicht lauernd um Dich herum.\n"}) );
  SetAttackChats(10, ({
    "Der Steinloewe zermalmt Dich mit seinen Zaehnen.\n",
    "Der Steinloewe zerschmettert Dich voller Kraft.\n"}) );

}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (find_call_out("react")!= -1)
    return;

  
  switch(gruppe)
  {
    case "fies": 
      call_out("react", 0, "knurrt Dich an.", "knurrt " +
        TP->Name(WEN) + " boesartig.");
      break; 

    case "aergerlich":
      call_out("react", 0, "faucht Dich an.",
        "bedroht " + TP->Name(WEM) +
        " mit seinen Klauen.");
    break;

    default:
      call_out("react", 0, "schleicht umher.",
	"schleicht herum.");
    break;
  }
}

void react(string victim, string others)
{
  if (present(TP, ENV(TO)))
  {
    tell_object(TP, BS(Name(WER) + " "+victim));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+others), ({TP,TO}));
  }
}


void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}


void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}
