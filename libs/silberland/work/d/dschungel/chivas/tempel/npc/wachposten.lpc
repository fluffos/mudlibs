
inherit "std/npc";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create()
 {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Eine Wache des Tempels");
  SetProp(P_LONG, BS(
    "Die Wache bewacht die Gefaengniszellen im Tempel. Sie ist ein "
    "mittelgrosser Dunkelelf mit weissen Haaren und boesen roten Augen. "
    "Er scheint aber nicht besonders motiviert zu sein, da er Dich kaum "
    "beachtet."));
  SetProp(P_NAME, "Wache");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10,T_RANGE_MAX:30]));
  AddId( ({ "dunkelelf","elf","wache"}) );

  create_default_npc(18);
  SetProp(P_HANDS, ({" mit ihren Haenden" ,QueryProp(P_HANDS)[1], DT_RIP }) );
  SetProp(P_RACE, "Dunkelelf");
  SetProp(P_SIZE, 220 );
  SetProp(P_ALIGN, -300);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,2);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_ARTICLE, 1);
  SetProp(P_NOMAGIC,5);
  SetProp(P_NOCORPSE, 0 );

  SetProp(P_MSGIN, "laeuft herein");
  SetProp(P_MSGOUT, "laeuft");
  SetProp(P_MMSGIN, "laeuft bewachend herein");
  SetProp(P_MMSGOUT, "laeuft bewachend weiter");

  SetProp(P_DIE_MSG,  " faellt tot zu Bode.\n");
  SetProp(P_KILL_NAME, "Eine Wache im Tempel");
  SetProp(P_KILL_MSG, "Da hast Du Dich mit der falschen Wache angelegt!");

  AddDetail( ({ "gefaengniszellen","zellen"}),
    "Die Wache bewacht die Zellen ein wenig lustlos.");
  AddDetail( ({ "dunkelelf","elf"}),
    "Die Wache ist ein mittelgrosser Dunkelelf.");
  AddDetail( ({ "haare"}),
    "Die weissen Haare haengen ueber die Ruestung.");
  AddDetail( ({ "augen"}),
    "Die roten Augen sehen brutal und kalt aus.");

  AddInfo(DEFAULT_INFO, "bewacht ohne grosse Lust die Zellen und beachtet Dich nicht.\n");
  AddInfo("chivas", "Chivas hat mich erschaffen.","sagt: ");

  AddInfo( ({"zellen","zelle","gefaengniszellen","gefaengniszelle"}),
    "In den Zellen stecken immer wieder arme Abenteurer. Die Tueren sind "
    "aber abgeschlossen.","sagt: ");

 AddInfo( ({"abenteurer"}),
    "Es sind meistens Abenteurer wie Du einer bist. ","sagt: ");

 AddInfo( ({"tueren","tuer","tuere"}),
    "Die Tueren sind abgeschlossen und der Schluessel ist irgendwo versteckt. "
    ,"sagt: ");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Die Wache will Deine Sachen nicht haben.\n" }) );

  SetChats(2, ({
          "Die Wache putzt ihre Waffen und gaehnt ein wenig lustlos.\n",
          "Die Wache schreitet vor den Zellen auf und ab.\n"}) );
  SetAttackChats(10, ({
    "Die Wache pruegelt wie wild auf Dich ein.\n",
    "Die Wache sticht Dich hinterhaeltig.\n"}) );

 SUID;
  CLONEME( "/d/unterwelt/zordan/dhrkion/weapon/diamantschwert" );
  CLONEME( "/d/unterwelt/zordan/dhrkion/armour/stiefel" );
  CLONEME( "/d/unterwelt/zordan/dhrkion/armour/umhang" );
  CLONEME( "/d/unterwelt/zordan/dhrkion/armour/guertel");
  command("trage alles");
  command("zuecke schwert");

}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (find_call_out("react")!= -1)
    return;
  
  switch (gruppe) {
    case "aengstlich":
      call_out("reaction", 0, TP,
        "haelt Dich fuer ein Weichei.",
        "beruhigt Dich fluesternd.");
      break;
    case "aergerlich":
      call_out("reaction", 0, TP,
        "grummelt Dich an.",
        "grummelt ueber Dich fluesternd.");
      break;
    case "albern":
      call_out("reaction", 0, TP,
        "laechelt muede.",
        "kichert leise.");
      break;
    case "fies":
      call_out("reaction", 0, TP,
        "tritt Dir auf den Fuss.",
        "tritt Dich mit seinen Stiefeln.");
      break;
    case "froh":
      call_out("reaction", 0, TP,
        "laechelt ein wenig.",
        "laechelt.");
      break;
    case "intim":
      call_out("reaction", 0, TP,
        "schreckt vor Dir zurueck.",
        "kuschelt Dich zaertlich.");
      break;
    case "nett":
      call_out("reaction", 0, TP,
        "laechelt ein wenig.",
        "fluestert das ihr das sehr gefaellt.");
      break;
    case "neutral":
      call_out("reaction", 0, TP,
        "beruehrt das nicht besonders.",
        "beruehrt das nicht besonders.");
      break;
    case "traurig":
      call_out("reaction", 0, TP,
        "troestet Dich ein wenig.",
        TP->Name(WER)+" wird von einer Wache getroestet.");
    break;
  }
}

void react(string victim, string others)
{
  if (present(TP, ENV(TO)))
  {
    tell_object(TP, BS(Name(WER) + " "+victim));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+others), ({TP,TO}));
  }
}


void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}


void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}
