
inherit "p/std/dragons/dragon";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

create()
{
  object cash;
  if (!is_clone(this_object())) return;
  ::create();
  
  SetProp(P_SHORT, "Grisinoruk, der Blutdrache");
  SetProp(P_LONG, "Ein grosser Drache, dessen Schuppenhaut blutrot "
      "schimmert, schaut Dich mit seinen toedlichen gelben Augen an. Aus "
      "seinen Nuestern steigt Qualm empor und seine spitzen Zaehne "
      "glaenzen im Sonnenlicht.");
      
  SetProp(P_NAME,"Grisinoruk");
  AddId(({ "drache","CHIVASDRACHE","grisinoruk" }));
  create_default_dragon(5,7,1,25);

  SetProp(P_GENDER, MALE);
  SetProp(P_RACE, "Drache");
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_NOCORPSE, 1);

  SUID;
  cash=CLONEOB("/obj/money");
  cash->SetProp(P_AMOUNT, random(1000));
  cash->move(ME);
 

  SetProp( P_REJECT, ({ REJECT_DROP, "Der Blutdrache laesst es fallen.\n" }) );
  SetProp( P_DIE_MSG, " faellt tot zu Boden.\n");
  SetProp( P_KILL_MSG, ({"GROAHRRRRRRT.",MSG_EMOTE}));
  
  SetProp(P_MSGIN, "taucht auf");
  SetProp(P_MMSGIN, "erscheint");
  SetProp(P_MMSGOUT, "verschwindet");
  SetProp(P_MSGOUT, "verschwindet");

void NotifyPlayerDeath(object player, object killer, int lostexp) {
  if(killer == ME)
    write_file(LOG "tempel.log",
      ctime()+": Ein Blutdrache hat gerade "+CAP(getuid(player))+" umgebracht.\n");
}

