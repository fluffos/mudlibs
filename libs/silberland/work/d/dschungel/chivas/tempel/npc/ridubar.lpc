//erstellt im mai 04 von chivas
inherit "std/mnpc";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <mnpc.h>
#include "../def.h"

void create() {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ridubar, der Assasine");
  SetProp(P_LONG,
    "Ridubar ist ein grosser Dunkelelf mit einem eingefallenen Gesicht. Die "
    "Augen von Ridubar sehen kalt und herzlos aus und hinter seiner schmalen "
    "Figur steckt mehr als Du sehen kannst.");
  SetProp(P_NAME, "Ridubar");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));
  AddId( ({ "ridubar","assasine"}) );
  AddId(({"Schwertmeister"}));


  create_default_npc(35);
  SetProp(P_HANDS, ({" mit seinen Haenden" ,150, DT_RIP }) );
  SetProp(P_SIZE, 230 );
  SetProp(P_RACE, "Dunkelelf");
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_SPELLRATE,40);
  SetProp(P_ARTICLE, 0);
  SetProp(P_NOMAGIC,10);

  SetProp(P_MSGIN, "schleicht herein");
  SetProp(P_MSGOUT, "schleicht");
  SetProp(P_MMSGIN, "kommt Dich nach Schwaechen begutachtend herein");
  SetProp(P_MMSGOUT, "sucht nach Opfern weiter");
  
  SetProp(P_MNPC_AREA, ( {ROOM "tem37", ROOM "tem38"}));
  SetProp(P_MNPC_WAIT, ({ 10, 20, 20 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "tem37");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_MOVES + MOV_BACKWARDS); 

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );
  SetProp(P_MURDER_MSG, "Ich komme wieder %s, dann spuerst Du meinen Dolch in deinem Ruecken!");
  SetProp(P_KILL_NAME, "Ridubar, der Assasine");
  SetProp(P_KILL_MSG, "Du warst ein lohnender Auftrag!");

  AddDetail( ({ "dunkelelf"}),
    "Ridubar ist ein Vorzeigedunkelelf. Er ist link und verschlagen.");
  AddDetail( ({ "gesicht"}),
    "Sein Gesicht zeigt keine Regung als er Dich mustert.");
  AddDetail( ({ "augen"}),
    "Seine Augen wirken kalt und herzlos.");
  AddDetail( ({ "figur"}),
    "Die Figur ist schmall, man sollte ihn aber trotzdem nicht unterschaetzen.");
  AddInfo(DEFAULT_INFO, "begutachtet Dich sehr genau.\n");  
  AddInfo("chivas", "Chivas hat mich erschaffen.","sagt: ");
  AddInfo("assasine", "Assasine zu sein ist ein ehrenwerter Beruf.","sagt: ");
  AddInfo("beruf", "Der Beruf setzt einiges voraus. Man muss schon dafuer "
          "geboren sein. Du koenntest es nicht. Du bist viel zu weich.","sagt: ");
  AddInfo("opfer","geld", "Die Opfer interessieren mich nicht, hauptsache es gibt "
          "Geld.","sagt: ");
  AddInfo("auftrag", "Momentan habe ich leider zu viel zu tun und kann keine "
          "neuen Auftraege annehmen.","sagt: ");

  SetProp(P_LOG_INFO, "npc_logfile");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Ridubar will Deine Sachen nicht tragen.\n" }) );
  AddSpell(1,800, 
     "Ridubar attackiert Dich mit einer Assasinenfinte und schlaegt Dich sehr hart.\n",
     "Ridubar schlaegt @WEN mit einer geschickten Finte.\n",
     ({DT_BLUDGEON}), ([SP_SHOW_DAMAGE:1]));

  SetChats(3, ({
    "Ridubar schleicht lauernd um Dich herum.\n",
    "Ridubar analysiert Deine Schwaechen.\n",
    "Ridubar fixiert eine Stelle an Deinem Ruecken mit seinem Dolch.\n"}) );
  SetAttackChats(10, ({
    "Ridubar meuchelt Dich nieder.\n",
    "Ridubar sticht Dir erbarmungslos in den Ruecken.\n"}) );

 SUID;
  CLONEME("/p/weapon/knife/obsidiandolch" );
  CLONEME( "/p/armour/gloves/lederhandschuhe" );
  CLONEME( "/d/kristallwald/chivas/zentauren/armour/kometenpanzer" );
  CLONEME( "/d/kristallwald/chivas/zentauren/armour/kometenhelm");
  command("trage alles");
  command("zuecke dolch");

// Reactions
}
void StartReaction(string verb, string gruppe, string adverb, int touch) {
  if (find_call_out("reaction") != -1) return;
  switch (gruppe) {
    case "aengstlich":
      call_out("reaction", 0, TP,
        "redet beruhigend auf Dich ein.",
        "beruhigt Dich fluesternd.");
      break;
    case "aergerlich":
      call_out("reaction", 0, TP,
        "schimpft leise auf Dich.",
        "grummelt ueber dich fluesternd.");
      break;
    case "albern":
      call_out("reaction", 0, TP,
        "findet gar nichts lustig.",
        "findet gar nichts lustig.");
      break;
    case "fies":
      call_out("reaction", 0, TP,
        "droht Dir mit einem Schwert.",
        "schaut boese.");
      break;
    case "frech":
      call_out("reaction", 0, TP,
        "faucht Dich fluesternd an.",
        "faucht fluesternd.");
      break;
    case "froh":
      call_out("reaction", 0, TP,
        "laechelt Dich guetig an.",
        "laechelt guetig.");
      break;
    case "intim":
      call_out("reaction", 0, TP,
        "fluestert Dir zu: Nicht wenn ich Dienst habe Schatz.",
        "fluestert Dir zu: Spaeter mein Engel, jetzt muss ich arbeiten.");
      break;
    case "nett":
      call_out("reaction", 0, TP,
        "schaut Dich streng an.",
        "guckt ein wenig boese.");
      break;
    case "neutral":
      call_out("reaction", 0, TP,
        "beruehrt das nicht besonders.",
        "beruehrt das nicht besonders.");
      break;
    case "traurig":
      call_out("reaction", 0, TP,
        "beachtet Dein Verhalten gar nicht.",
        TP->Name(WER)+" wird von einer Palastwache gar nicht beachtet.");
      break;
  }
}
void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
  
  
}


