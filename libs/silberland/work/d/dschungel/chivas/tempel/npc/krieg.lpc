
inherit "std/npc";
inherit "std/npc/spells";

#include <properties.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../def.h"

void create()
 {
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Krieg, Reiter der Apokalypse");
  SetProp(P_LONG, BS(
    "Krieg ist ein muskuloeser Krieger. Seine Haut ist an vielen Stellen "
    "mit Narben uebersaeht. Seine Ruestung und die seines grossen Pferdes "
    "sehen von Kaempfen gezeichnet aus, scheinen aber besser zu sein, als "
    "das was Du hast."));
  SetProp(P_NAME, "Krieg");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:10,T_RANGE_MAX:30]));
  AddId( ({ "krieg","reiter"}) );
  AddId(({"Schwertmeister"}));

  create_default_npc(38);
  SetProp(P_HANDS, ({" mit seinen Klauen" ,QueryProp(P_HANDS)[1], DT_RIP }) );
  SetProp(P_RACE, "Daemon");
  SetProp(P_SIZE, 280 );
  SetProp(P_ALIGN, -800);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,2);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_ARTICLE, 0);
  SetProp(P_NOMAGIC,30);
  SetProp(P_SPELLRATE, 57);

  SetProp(P_MSGIN, "reitet herein.");
  SetProp(P_MSGOUT, "reitet.");
  SetProp(P_MMSGIN, "reitet geschwind herein.");
  SetProp(P_MMSGOUT, "reitet weiter.");

  SetProp(P_DIE_MSG,  " loest sich in Rauch auf.\n");
  SetProp(P_NOCORPSE, 1 );
  SetProp(P_KILL_NAME, "Krieg, Reiter der Apokalypse");
  SetProp(P_KILL_MSG, "Gruess meinen Bruder TOD von mir!");

  AddDetail( ({ "krieger"}),
    "Krieg sieht wie ein muskuloeser und starker Krieger aus.");
  AddDetail( ({ "muskel","muskeln"}),
    "Die Muskeln von Krieg sind riesig.");
  AddDetail( ({ "haut","stellen","narben"}),
    "Die Haut ist von vielen Narben ueberzogen.");
  AddDetail( ({ "ruestung","kaempfe"}),
    "Die Ruestung hat schon viele Kaempfe ueberstanden.");
  AddDetail( ({ "pferd"}),
    "Das Pferd ist muskuloes und riesig.");

  AddInfo(DEFAULT_INFO, "reagiert nicht auf kleine Abenteurer.\n");
  AddInfo("chivas", "Chivas hat mich erschaffen.","sagt: ");

  AddInfo( ({"tod","pestilenz","hunger"}),
    "Tod, Hunger und Pestilenz sind meine Brueder. ","sagt: ");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Krieg will Deine Sachen nicht haben.\n" }) );

  AddSpell(6,800, 
     "Krieg schmettert Dir kleine Blitze entgegen.\n",
     "Krieg zerschmettert @WEN mit der Macht von Blitzen.\n",
     ({DT_LIGHTNING}), ([SP_SHOW_DAMAGE:1]));
  AddSpell(1,1500, 
     "Krieg greift in Deine Seele und reisst einen Teil heraus.\n",
     "Krieg greift @WEN in die Seele und reisst einen Teil heraus.\n",
     ({DT_LIGHTNING}), ([SP_SHOW_DAMAGE:1]));

  AddDefaultSpell(3, 100, DS_REDUCE_AC);    
  AddDefaultSpell(3, 100, DS_REDUCE_WC);  
  AddDefaultSpell(3, 100, DS_FEAR);    
  AddDefaultSpell(3, 100, DS_DISARM);     

  SetChats(2, ({
          "Krieg durchbohrt Dich mit seinen Blick.\n",
          "Krieg haucht Dich mit seinem ueblen Atem an.\n"}) );
  SetAttackChats(10, ({
    "Krieg zerreist Dich mit seinen Klauen.\n",
    "Krieg zerschmettert Dich voller Kraft.\n"}) );

 SUID;
  CLONEME( "/d/ebene/obj/waffe/mithrilschwert" );
  CLONEME( "/d/ebene/obj/ruestung/schw_umhang" );
  CLONEME( "/d/kristallwald/chivas/zentauren/armour/sternenpanzer" );
  CLONEME( "/d/kristallwald/chivas/zentauren/armour/sternenhelm");
  command("trage alles");
  command("zuecke schwert");

}

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (find_call_out("react")!= -1)
    return;

  
  switch(gruppe)
  {
    case "fies": 
      call_out("react", 0, "knurrt Dich an.", "knurrt " +
        TP->Name(WEN) + " boesartig.");
      break; 

    case "aergerlich":
      call_out("react", 0, "droht mit seinen Klauen.",
        "bedroht " + TP->Name(WEM) +
        " mit seinen Klauen.");
    break;

    default:
      call_out("react", 0, "schleicht umher.",
	"schleicht herum.");
    break;
  }
}

void react(string victim, string others)
{
  if (present(TP, ENV(TO)))
  {
    tell_object(TP, BS(Name(WER) + " "+victim));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+others), ({TP,TO}));
  }
}


void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}


void reaction(object ob, string macher, string andere) {
  if (present(ob, ENV(TO))) {
    tell_object(ob, BS(Name(WER, 1)+" "+macher));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
  }
}
