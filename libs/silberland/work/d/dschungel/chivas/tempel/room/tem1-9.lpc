// von Chivas
inherit "std/room";

#include "../def.h"

int skelettda;

void create()
	
{
  ::create();

  skelettda=1; 

  SetProp( P_INT_SHORT, "In einem Tempel");
  SetProp( P_INT_LONG,
        "Dies ist die erste Ebene im Tempel. Du bist froh das Labyrinth "
        "im Erdgeschoss hinter Dir zu haben. Hier wirkt auch alles gleich "
        "ein wenig heller, da durch die grossen Fenster auf dieser Ebene "
        "ein wenig Licht herein kommt. Jedoch wirkt auch diese Ebene nicht "
        "gerade beruhigender auf Dich, da gleich neben der Treppe ein "
        "Skelett auf dem Boden liegt und auch die Malereien an den Waenden "
        "wirken nicht beruhigend." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----

  AddDetail( ({"ebene"}), 
            "Dies ist also die erste Ebene des Tempels. Du kommst der Spitze "
            "des Tempels langsam naeher.");

  AddDetail( ({"tempel","tempels","erdgeschoss"}),
	    "Der Tempel ist sehr gross, dies ist erst die erste Ebene ueber "
	    "dem Erdgeschoss.");

  AddDetail( ({"labyrinth"}),
	    "Das Labyrinth ist im Erdgeschoss. Du hast es hinter Dir "
            "gelassen.");

  AddDetail( ({"erdgeschoss"}), 
            "Ueber die Treppe kommst Du ins Erdgeschoss.");

  AddDetail( ({"fenster"}),
	    "Die Fenster lassen ein wenig Licht herein, jedoch nur einen "
            "Teil. Sie sind mit einem magischen Schimmer ueberzogen, der "
            "das meiste Licht und alles andere von draussen fern haelt.");

  AddDetail( ({"licht"}),
	    "Das Licht, welches durch die Fenster herein scheint, reicht "
            "aus um die Halle, in der Du Dich befindest, zu erhellen."); 
  
  AddDetail( ({"treppe","steintreppe"}), 
            "Die Steintreppe fuehrt in das Erdgeschoss mit dem Labyrinth.");

  AddDetail( ({"skelett","skeletts"}),
	    "Genau neben der Treppe liegt ein Skelett. Es ist auch kein "
            "Wunder, dass der Besitzer des Skeletts nicht ueberlebt hat. Mit "
            "einer Axt im Schaedel laesst sich schlecht weiterleben.");

  AddDetail( ({"boden"}),
	    "Am Boden neben der Treppe liegt ein Skelett. Ansonsten sieht man "
            "grosse Steinplatten am Boden.");

  AddDetail( ({"wand","waende","waenden"}), 
            "Die Waende sind mit Malereien geschmueckt. Sie sehen gruselig aus.");

  AddDetail( ({"malereien"}),
	    "Die Malereien zeigen Tod und Verderben.");

  AddDetail( ({"spitze","tempelspitze"}),
	    "Die Tempelspitze ist jetzt viel naeher."); 
  
  AddDetail( ({"schimmer"}), 
            "Der magische Schimmer scheint auf allen Fenstern zu liegen und "
            "einen grossen Teil des Lichtes auszusperren. Vielleicht passiert "
            "etwas, wenn Du den Schimmer beruehrst.");

  AddDetail( ({"halle"}),
	    "Die Halle ist gross und sehr geraeumig.");

  AddDetail( ({"besitzer"}),
	    "Du hoffst, dass Du den Besitzer des Skeletts nicht kennst.");

  AddDetail( ({"schaedel"}), 
            "Der Schaedel ist gespalten worden. Die Axt steckt immer noch im "
            "Schaedel.");

  AddDetail( ({"axt"}),
	    "Die Axt sieht gross und wuchtig aus. Du erkennst, dass es eine "
            "magische Axt sein muss, da von dem Axtblatt ein magisches "
            "Leuchten ausgeht.");

  AddDetail( ({"axtblatt","blatt","axtblattes"}),
	    "Das Axtblatt ist scharf und leuchtet gruenlich."); 
  
  AddDetail( ({"leuchten"}), 
            "Das Leuchten des Axtblattes zieht Dich magisch an. Vielleicht "
            "kannst Du es rausziehen. Aber bedenke, das Stoeren der Ruhe eines "
            "Toten hat in diesem Tempel schon zu viel Unheil gefuehrt.");

  AddDetail( ({"toten"}),
	    "Damit ist das Skelett gemeint.");

  AddDetail( ({"stoeren","ruhe","sache"}),
	    "Das Stoeren der Ruhe ist keine schoene Sache.");

  AddDetail( ({"unheil"}), 
            "Ein Unheil kann sehr schnell ueber Dich kommen.");

  AddDetail( ({"steinplatten","platten"}),
	    "Die Platten sind schmucklos.");

  AddDetail( ({"tod"}),
	    "Du wirst Tod schon bald treffen."); 
  
  AddDetail( ({"verderben"}), 
            "Das Verderben wird ueber Dich kommen.");

  AddDetail( ({"teil"}),
	    "Das meiste Licht bleibt draussen.");

  AddDetail( ({"wunder"}),
	    "Wunder gibt es immer wieder, vor allem hier im "
            "Silberland.");

  AddDetail( ({"silberland"}), 
            "Du befindest Dich im Silberland und findest es toll hier.");

  AddDetail( ({"himmel"}),
	    "Hier gibt es nur eine Decke.");

  AddDetail( ({"decke"}),
	    "Die Decke ist schmucklos und uninteressant."); 
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Tod.");  
 
  AddSmell( ({"tod","geruch"}),
	   "Der Geruch gefaellt Dir nicht.");

  AddSound(DEFAULT_SOUND, "Du hoerst das magische Knistern der Fenster.");

  AddSound( ({"knistern"}),
	   "Die Fenster sind magisch. Ein Schimmer liegt auf ihnen.");
  
//-----Details Ende-----
  
AddExit("runter", ROOM "tem52");
AddExit("westen", ROOM "tem1-8");

AddCmd( ({"zieh", "ziehe" }), "ziehen" );
AddCmd( ({"beruehr", "beruehre" }), "beruehren" );

}
void reset()
{
  ::reset();
  skelettda=1;
}

int ziehen(string str)
{
  object skelett;
  notify_fail ("Was moechtes Du wo rausziehen?\n");

  if(!(str == "axt aus schaedel","axt aus schaedel raus" )) return 0;
  if (present("skelett",TO) || !skelettda)

  {
    write(BS("Du bist zu schwach. Ein unsichtbarer Magier lacht Dich aus und "
             "hat sich wohl einen Spass mit Dir erlaubt."));
    return -1;
  }
  write(BS("Du ziehst an der Axt, doch als Du denkst Du hast sie, zerfaellt "
           "sie zu Staub. Statt dessen steht das Skelett auf und ist ziemlich "
           "sauer auf Dich.\n"));
  skelettda=0;
  skelett = clone_object (NPC "skelett1.lpc" );
  skelett->move(TO,M_GO|M_NOCHECK,"steht auf.");
  return 1;
}

int beruehren(string str)
{
   notify_fail("Was moechtest Du beruehren?\n");
   if ( member( ({ "schimmer","den schimmer" }),str) != -1) 
  {
    write(BS( "Du beruehrst den Schimmer und fuehlst einen starken Schmerz.\n"));
    say( TPN+" verzieht das Gesicht vor Schmerzen.\n");
    TP->AddHp(-30);
    return 1;
  }
}

