// von Chivas
inherit "std/room";

#include "../def.h"

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einem Tempel im Dschungel");
  SetProp( P_INT_LONG,
        "Der Weg auf dem Tempel ist ein wenig beschwerlich, da an dieser "
        "Stelle viele Brocken auf dem Boden liegen, die von weiter oben "
        "auf diese Ebene herunter gefallen sind. Weiterhin sind lauter "
        "Schlingpflanzen am Boden, ueber die man leicht stolpern kann." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 30, ENV_TERRAIN: TT_JUNGLE]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );
  
//-----Details Anfang-----

  AddDetail( ({"weg"}), 
            "Hier ist es ein wenig beschwerlicher voran zu kommen, da lauter "
            "grosse Brocken auf dem Boden liegen.");

  AddDetail( ({"tempel","tempels"}),
	    "Du bist auf einem dunklen Tempel im Dschungel.");

  AddDetail( ({"stelle"}),
	    "An dieser Stelle des Tempels liegen grosse Brocken auf dem "
            "Boden.");

  AddDetail( ({"brocken","brockens"}), 
            "Die grossen Brocken die hier rum liegen sind anscheinend von "
            "weiter oben vom Tempel abgebrochen und hier runter gefallen. "
            "Der Grund dafuer ist Dir nicht bekannt. Einer der Brocken sieht "
            "ein wenig komisch aus, da er aus einem anderen Material ist, als "
            "die anderen Brocken.");

  AddDetail( ({"boden"}),
	    "Auf dem Boden vor Dir liegen einige Brocken und es sind auch "
            "einige Schlingpflanzen zu sehen.");

  AddDetail( ({"ebene"}),
	    "Du bist auf der ersten Ebene des Tempels."); 
  
  AddDetail( ({"schlingpflanzen","stolperfallen","fallen"}), 
            "Die Schlingpflanzen am Boden sind richtige Stolperfallen. Man "
            "muss aufpassen, dass man nicht hinfaellt. Neben den "
            "Schlingpflanzen sind sonst nur noch ein paar Graeser und Moose "
            "zu sehen.");

  AddDetail( ({"himmel","tag"}),
	    "Der Himmel ist schoen blau. Es ist ein herrlicher Tag im "
            "Silberland.");

  AddDetail( ({"dschungel"}),
	    "Du bist auf einem Tempel mitten im Dschungel.");

  AddDetail( ({"material","stein"}), 
            "Das Material des einen Brockens sieht anders aus als die anderen "
            "Brocken. Es scheint kein Stein zu sein, es ist ein richtiger "
            "Knochen.");

  AddDetail( ({"silberland"}),
	    "Du bist im Silberland.");

  AddDetail( ({"graeser","moose","graesern","moosen"}),
	    "An den Graesern und Moosen ist nichts besonderes zu erkennen.");

  AddDetail( ({"knochen"}),
	    "Der Knochen scheint mit den anderen Brocken von oben herunter "
            "gefallen zu sein. Er scheint von einem Abenteurer wie Dir zu "
            "stammen. Du bist ein wenig beunruhigt."); 
  
  AddDetail( ({"grund"}), 
            "Den Grund kannst Du von hier aus nicht erkennen.");

  AddDetail( ({"abenteurer"}),
	    "Anscheinend wurde er Opfer eines Kampfes und ist aus dem "
            "Tempel gefallen.");

  AddDetail( ({"kampf","kampfes"}),
	    "Du kannst es nur vermuten, dass der Grund ein Kampf war.");

  AddDetail( ({"opfer","hauptsache"}), 
            "Die Hauptsache ist, dass Du hier nichts zum Opfer faellst.");

  AddSmell(DEFAULT_SMELL, "Es riecht nach Dschungel.");  
 
  AddSmell( ({"dschungel"}),
	   "Es riecht dschungelig.");

  AddSound(DEFAULT_SOUND, "Du hoerst nicht viel, nur die ueblichen Geraeusche "
                          "des Dschungels.");

  AddSound( ({"geraeusche","dschungel","voegel","tiere"}),
	   "Du hoerst ein paar Voegel und andere Tiere im Dschungel.");
  
//-----Details Ende-----
  
AddExit("osten", ROOM "tem1-10");
AddExit("westen", ROOM "tem1-24");

}

