// von Chivas
inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();


  SetProp( P_INT_SHORT, "In einem Tempel");
  SetProp( P_INT_LONG,
        "Du stehst in einer grossen Kammer, die vollkommen leer zu sein "
        "scheint, bis auf ein grosses Portal in der Mitte der Kammer. Es gibt "
	"keinerlei Fackeln, die die Kammer erhellen. Die einzige Lichtquelle "
        "im Raum ist das blau schimmernde Portal. Ansonsten sind die Waende "
        "und die Decke kahl." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  
  AddDetail( ({"kammer"}), 
            "Die Kammer ist kreisrund und genau in der Mitte steht ein "
            "grosses Portal.");

  AddDetail( ({"mitte"}),
	    "In der Mitte steht ein Portal. Du kannst es sicher betreten und "
            "sehen, wohin es Dich bringt und was mit Dir geschieht.");

  AddDetail( ({"fackeln","fackel"}),
	    "Es sind keine Fackeln vorhanden.");

  AddDetail( ({"lichtquelle"}), 
            "Die einzige Lichtquelle ist das Portal.");

  AddDetail( ({"raum"}),
	    "Die Kammer ist gross und kreisrund.");

  AddDetail( ({"waende","waenden","wand"}),
	    "An den Waenden kann man ausser dem Mauerwerk nicht viel sehen."); 
  
  AddDetail( ({"decke"}), 
            "Die Decke ist kahl. Aber genau ueber dem Portal erkennst Du eine "
            "Halterung.");

  AddDetail( ({"boden"}),
	    "Am Boden laufen Linien kreisfoermig in die Mitte der Kammer.");

  AddDetail( ({"himmel"}),
	    "Ein guter Witz, einen Himmel gibt es hier im Tempel nicht zu "
            "sehen.");

  AddDetail( ({"witz"}), 
            "Ein Witz wird jetzt nicht erzaehlt.");

  AddDetail( ({"mauerwerk","mauer"}),
	    "Man erkennt die etwas roh behauenen Steinquader.");

  AddDetail( ({"linien"}),
	    "Die Linien laufen auf das Portal in der Mitte zu. Sie sind "
            "auch von Magie umgeben, da sie zu zucken scheinen. Wenn Du nicht "
            "bald Deinen Blick abwendest, wirst Du sicher hypnotisiert."); 
  
  AddDetail( ({"steinquader","quader"}), 
            "An einer Stelle scheint doch Etwas zu sein.");

  AddDetail( ({"stelle","etwas"}),
	    "Es ist eine Inschrift.");

  AddDetail( ({"inschrift"}),
	    "Du kannst sie lesen.");

  AddDetail( ({"halterung"}),
	    "An der Halterung hat sicher einmal eine Lampe oder ein "
            "Kronleuchter gehangen.");

  AddDetail( ({"lampe","kronleuchter","leuchter"}),
	    "Der Kronleuchter haengt schon lange nicht mehr da.");

  AddDetail( ({"blick"}), 
            "Nur mit aller Willenskraft kannst Du Deinen Blick abwenden.");

  AddDetail( ({"willenskraft"}),
	    "Du haettest nicht gedacht, dass Du so etwas wie Willenskraft "
            "besitzt. Vielleicht hast Du auch noch andere Dinge die Du bisher "
            "nicht entdeckst hast.");

  AddDetail( ({"dinge"}),
	    "Halt Dinge wie Charakter, Charme, Klasse und Stil."); 
  
  AddDetail( ({"charakter","charme","klasse","stil"}), 
            "Du solltest besser nicht weiter forschen. Du koenntest "
            "enttaeuscht werden.");

  AddDetail( ({"tempel"}),
	    "Du bist schon recht weit im Tempel vorgedrungen.");

  AddSmell(DEFAULT_SMELL, "Es riecht eigentlich nach gar nichts.");  
 
  AddSound(DEFAULT_SOUND, "Du hoerst ein magisches Knistern.");

  AddSound( ({"knistern","portal","magie"}),
	   "Das Knistern kommt von der starken Magie, die das Portal "
           "ausstrahlt.");
  
  AddReadDetail( ({"inschrift"}),
		"Dusty schuetze uns Paladine. Dieser Tempel ist verflucht. \n"
                " \n"
                "Du denkst: . o O (Ob der Paladin der dies schrieb, hier den "
                "Tod gefunden hat?) Du bezweifelst es.");

//-----Details Ende-----
AddItem(OBJ "portalb", REFRESH_DESTRUCT);
  
AddExit("osten", ROOM "tem30");

AddCmd( ({"betrete" }), "betreten" );

}
int betreten(string str)
{
   notify_fail("Was moechtest Du betreten?\n");
   if ( member( ({ "portal","blaues portal" }),str) != -1) 
  {
    write(BS ( "Du betrittst das schimmernde Portal und die Umgebung "
               "verschwimmt. Mal sehen wo Dich das Portal hinbringt.\n"));
    say( TPN+" betritt das Portal und verschwindet.\n");
    this_player()->move(ROOM "tem32", M_TPORT);
    TP->AddSp(-50);
    return 1;
  }
}

