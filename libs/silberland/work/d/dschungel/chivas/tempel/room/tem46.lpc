// von Chivas
inherit "std/room";

#include "../def.h"

void create()
	
{
  ::create();


  SetProp( P_INT_SHORT, "In einem Tempel");
  SetProp( P_INT_LONG,
        "Der Gang ist wieder duester und feucht. Von der Decke tropft Wasser "
        "auf Dich herab. In die Mauern des Ganges sind schreckliche Fratzen "
	"eingemeisselt und auf dem Boden haben sich kleine Pfuetzen gebildet, "
        "so dass der Boden recht glitschig ist. " );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  
  AddDetail( ({"gang","ganges"}), 
            "Der Gang ist duester und feucht.");

  AddDetail( ({"decke","himmel"}),
	    "An verschiedenen Stellen tropft es von der Decke. Ansonsten "
            "ist nicht viel an der Decke zu erkennen.");

  AddDetail( ({"wasser"}),
	    "Das Wasser tropft von der Decke und bildet ein paar Pfuetzen "
            "am Boden.");

  AddDetail( ({"mauern","mauer","waende","wand"}), 
            "Die Waende sind kahl, bis auf ein paar aus Stein gemeisselte "
            "Fratzen und Fackeln an der Wand.");

  AddDetail( ({"fratzen"}),
	    "Die Fratzen sehen ekelig aus. Du erkennst, dass die Fratzen das "
            "Aussehen von Trollen und Ogern haben.");

  AddDetail( ({"boden"}),
	    "Am Boden sind einige Pfuetzen zu sehen."); 
  
  AddDetail( ({"pfuetzen"}), 
            "Das Licht der Fackeln spiegeln sich in den Pfuetzen und ein "
            "paar Algen haben sich darin gebildet.");

  AddDetail( ({"fackeln"}),
	    "Die Fackeln leuchten in einem magischen, gruenlichen Licht.");

  AddDetail( ({"aussehen","trollen","trolle","oger","ogern"}),
	    "Sie sehen jedenfalls so aus.");

  AddDetail( ({"licht"}), 
            "Es gibt nicht viel Licht, aber man kann was erkennen.");

  AddDetail( ({"stellen"}),
	    "Es tropft aus ein paar Rissen an der Decke.");

  AddDetail( ({"rissen","risse"}),
	    "Es sind recht kleine Risse. Ansonsten gibt es nicht viel zu "
            "sehen."); 
  
  AddDetail( ({"algen"}), 
            "Die Algen machen den Boden glitschig. Du solltest aufpassen, dass "
            "Du nicht ausrutscht.");

  AddDetail( ({"stein","detail"}),
	    "Chivas war zu faul dieses Detail zu beschreiben.");

  AddDetail( ({"chivas"}),
	    "Ein fuerwahr genialer Magier. ;)");

  AddDetail( ({"magier"}), 
            "Er haelt sich jedenfalls fuer einen.");

  AddSmell(DEFAULT_SMELL, "Es riecht nach absolut gar nichts.");  
 
  AddSound(DEFAULT_SOUND, "Du hoerst ein Tropfen.");

  AddSound( ({"tropfen"}),
	   "Das Tropfen stammt vom Wasser, dass von der Decke auf den "
           "Boden tropft.");

//-----Details Ende-----
  
AddExit("norden", ROOM "tem41");
AddExit("nordosten", ROOM "tem47");
AddExit("nordwesten", ROOM "tem41");
AddExit("osten", ROOM "tem45");
AddExit("westen", ROOM"tem41");
AddExit("suedosten", ROOM "tem41");
AddExit("suedwesten", ROOM "tem41");
AddExit("sueden", ROOM "tem41");

}

