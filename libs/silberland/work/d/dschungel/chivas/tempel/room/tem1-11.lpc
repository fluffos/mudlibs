// von Chivas
inherit "std/room";

#include "../def.h"

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einem Tempel im Dschungel");
  SetProp( P_INT_LONG,
        "Die Steinquader am Boden sind kaum zu erkennen. Genauso sieht es mit "
        "den Steinen an der Aussenmauer der ersten Ebene aus. Der Dschungel "
        "hat einen grossen Teil des Tempels zurueck erkaempft und ihn in sein "
        "Gruen getaucht." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 30, ENV_TERRAIN: TT_JUNGLE]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  AddDetail( ({"steinquader","quader"}), 
            "Die Quader am Boden sind kaum noch zu erkennen, da sich lauter "
            "Pflanzen auf dem Boden ausgebreitet haben.");

  AddDetail( ({"steinen","steine"}),
	    "Die Steine der Aussenmauer sind mit vielen Ranken und "
            "Schlingpflanzen zugewachsen.");

  AddDetail( ({"aussenmauer","mauer"}),
	    "Die Mauer ist hinter den Ranken und Schlingpflanzen kaum noch zu "
            "erkennen.");

  AddDetail( ({"ebene"}), 
            "Die Ebene ist fast vollkommen mit Pflanzen zugewachsen.");

  AddDetail( ({"dschungel","teil","gruen","dschungels"}),
	    "Der Dschungel hat sich fast komplett auf diese Ebene zurueck "
            "gekaempft. Der Tempel ist unter den ganzen Pflanzen kaum noch "
            "zu erkennen.");

  AddDetail( ({"tempels","tempel","stelle"}),
	    "Du befindest Dich auf einem Tempel im tiefen Dschungel. Von dem "
            "Tempel ist an dieser Stelle nicht mehr viel zu sehen."); 
  
  AddDetail( ({"boden"}), 
            "Am Boden haben sich allerlei Pflanzen ausgebreitet. Die darunter "
            "befindlichen Steinquader sind kaum noch zu sehen.");

  AddDetail( ({"himmel"}),
	    "Der Himmel ist wunderschoen blau. Nur am Horizont sieht man "
            "einige weisse Wolken.");

  AddDetail( ({"pflanzen"}),
	    "Auf dem Boden siehst Du verschiedene Graeser, Moose und Blumen. "
            "An der Aussenmauer haben sich einige Ranken und Schlingpflanzen "
            "festgesetzt.");

  AddDetail( ({"ranken"}), 
            "Die Ranken sind an der Aussenmauer hochgewachsen und bedecken "
            "sie fast komplett.");

  AddDetail( ({"schlingpflanzen"}),
	    "Die Schlingpflanzen haengen an der Aussenmauer und verbergen "
            "die dahinter liegenden Steine.");

  AddDetail( ({"horizont","wolken"}),
	    "Der Horizont und die Wolken sind weit weg."); 
  
  AddDetail( ({"graeser"}), 
            "Die Graeser wachsen schon recht hoch. Manche von ihnen gehen Dir "
            "bis zu den Knien.");

  AddDetail( ({"blumen"}),
	    "Du erkennst die ueblichen Blumen des Dschungels.");

  AddDetail( ({"moose","moos"}),
	    "Das gruene Moos ist angenehm weich. Es ist angenehm auf ihm "
            "zu gehen.");

  AddDetail( ({"knien","knie","kniee"}), 
            "Die hast zwei davon.");

  AddSmell(DEFAULT_SMELL, "Du riechst den herrlichen Duft der Blumen am "
                          "Boden.");  
 
  AddSmell( ({"boden","blumen","duft"}),
	   "Die Blumen duften wirklich herrlich.");

  AddSound(DEFAULT_SOUND, "Du hoerst die ueblichen Geraeusche des Dschungels.");

  AddSound( ({"dschungel","geraeusche","voegel","tiere"}),
	   "Du kannst einige Tiere und Voegel hoeren.");
  
//-----Details Ende-----
  
AddExit("sueden", ROOM "tem1-12");
AddExit("norden", ROOM "tem1-10");

}

