// von Chivas
inherit "std/room";

#include "../def.h"

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einem Dschungelpfad");
  SetProp( P_INT_LONG,
        "Ein enger Dschungelpfad fuehrt tiefer in den Urwald. Zu beiden "
        "Seiten stehen grosse Baeume, die mit Schlingpflanzen zugewachsen "
        "sind und dem Pfad die Richtung vorgeben. Die Sonne schafft es kaum, "
        "das dichte Blaetterdach zu durchdringen. Nach Sueden hin scheint der "
        "Pfad noch enger zu werden." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 30, ENV_TERRAIN: TT_JUNGLE]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );
  
//-----Details Anfang-----
  
  AddDetail( ({"dschungel"}), 
            "Du bist hier tiefer im Dschungel. Ueberall um Dich herum kannst "
            "Du Pflanzen sehen. Im Norden siehst Du zwischen den Pflanzen "
            "immer noch ein wenig das Meer. Im Sueden wird der Pfad enger und "
            "fuehrt Dich weiter in den Dschungel rein.");

  AddDetail( ({"dschungelpfad","pfad"}),
	    "Der Pfad fuehrt tief in den Dschungel herein.");

  AddDetail( ({"urwald","wort"}),
	    "Urwald ist ein anderes Wort fuer Dschungel.");

  AddDetail( ({"seiten"}), 
            "Zu beiden Seiten des Pfades stehen grosse Baeume, welche mit "
            "vielen Schlingpflanzen zugewachsen sind.");

  AddDetail( ({"baeume","baeumen"}),
	    "Die Baeume stehen gleich sehr dicht und zwaengen dem Pfad die "
            "Richtung auf. Die Baeume, sind mit Schlingpflanzen zugewachsen, "
            "zwischen ihnen stehen viele Straeucher, so dass ein "
            "Abweichen vom Pfad unmoeglich ist.");

  AddDetail( ({"schlingpflanzen","vorankommen","anzahl"}),
	    "Dicke Schlingpflanzen haengen an den Baeumen und Du bist sicher, "
            "dass ihre Anzahl tiefer im Dschungel noch zunehmen wird und "
            "dadurch das Vorankommen schwerer werden wird."); 
  
  AddDetail( ({"pflanzen"}), 
            "Die unterschiedlichsten Pflanzen wachsen im Dschungel. Die "
            "meisten davon kennst Du nicht.");

  AddDetail( ({"richtung"}),
	    "Die Baeume, die den Pfad eingrenzen, geben die Richtung vor.");

  AddDetail( ({"sonne"}),
	    "Die Sonne dringt kaum durch das dichte Blaetterdach durch. Die "
            "Blaetter bilden ein richtiges Dach. Wenn es regnen wuerde, "
            "wuerdest Du sicher nicht nass werden.");

  AddDetail( ({"blaetter"}), 
            "Die Blaetter im Dschungel haben die unterschiedlichsten Formen, "
            "Groessen und Farben.");

  AddDetail( ({"blaetterdach","dach"}),
	    "Das dichte Blaetterdach laesst kaum Licht durch, so dass die "
            "Lichtverhaeltnisse nicht die besten sind.");

  AddDetail( ({"sueden","gebiet"}),
	    "Im Sueden geht der Pfad weiter in unbekanntes Gebiet. Du bist "
            "sehr neugierig und willst genau wissen was am Ende des Pfades "
            "ist."); 
  
  AddDetail( ({"boden"}), 
            "Am Boden wachsen einige Graeser und ein paar Moose.");

  AddDetail( ({"himmel"}), 
            "Der Himmel ist durch das dichte Blaetterdach kaum zu sehen.");

  AddDetail( ({"meer","norden","strand"}),
	    "Im Norden kannst Du noch ein bisschen von Strand und Meer "
            "erkennen. Wenn Du noch weiter nach Sueden gehst, wirst Du den "
            "Strand und das Meer sicher nicht mehr erkennen koennen, da der "
            "Dschungel doch sehr dicht ist.");

  AddDetail( ({"abweichen"}),
	    "Man kann den Pfad nicht verlassen.");

  AddDetail( ({"straeucher","namen"}), 
            "An den Seiten zwischen den Baeumen stehen viele Straeucher. Du "
            "kennst aber ihren Namen nicht. Du beschliesst Dich diesbezueglich "
            "ein wenig fortzubilden.");

  AddDetail( ({"ende"}),
	    "Wuerde es hier in einem Detail beschrieben sein, waere es doch "
            "wirklich langweilig.");

  AddDetail( ({"detail"}),
	    "Dies ist ein Detail. Du hast es gerade untersucht."); 
  
  AddDetail( ({"graeser","gras"}), 
            "Die Graeser sind nicht sehr interessant.");

  AddDetail( ({"moos","moose"}),
	    "Es scheinen verschiedene Arten von Moosen zu sein.");

  AddDetail( ({"art","arten"}),
	    "So gut kennst Du Dich da nicht aus.");

  AddDetail( ({"licht","lichtverhaeltnisse","verhaeltnisse"}), 
            "Es gibt Orte im Silberland, wo man mehr sehen kann.");

  AddDetail( ({"orte"}),
	    "Davon gibt es einige im Silberland.");

  AddDetail( ({"silberland"}),
	    "Du bist im Silberland. Wo auch sonst!"); 
  
  AddDetail( ({"treibhaus"}), 
            "Du untersuchst auch wirklich alles.");

  AddDetail( ({"formen"}),
	    "Die Formen sind schwer zu beschreiben, man muss es einfach "
            "selber sehen.");

  AddDetail( ({"groessen"}),
	    "Die Groessen gehen von winzig klein bis fast so gross wie Du.");

  AddDetail( ({"farben"}), 
            "Es sind alle moeglichen Gruentoene zu erkennen.");

  AddDetail( ({"gruentoene","toene","hellgruen","dunkelgruen"}),
	    "Sie reichen von heller als Hellgruen bis dunkeler als "
            "Dunkelgruen.");

  AddDetail( ({"wort","gnom"}),
	    "Dieses Detail ist an einen Gnom vermietet."); 
  
  AddSmell(DEFAULT_SMELL, "Du riechst die gruenen Pflanzen.");  
 
  AddSmell( ({"pflanzen"}),
	   "Es riecht wie in einem Treibhaus.");

  AddSound(DEFAULT_SOUND, "Du hoerst einige Voegel im Dschungel trillern.");

  AddSound( ({"voegel"}),
	   "triller, triller, triller");
  
//-----Details Ende-----
  
AddExit("sueden", ROOM "tem2");
AddExit("nordosten", "/d/dschungel/feyaria/kueste/room/room_l6");

}

