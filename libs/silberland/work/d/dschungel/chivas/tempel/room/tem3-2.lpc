// von Chivas
inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

int anzahl;

void create()
	
{
  ::create();

  anzahl = 3;

  SetProp( P_INT_SHORT, "In einem Tempel");
  SetProp( P_INT_LONG,
        "In dieser Kammer haengen grosse Waffen und Schilde an den Waenden. "
        "Ausserdem faellt Dir in der Mitte der Kammer ein kleiner "
        "Springbrunnen auf, der zwar nicht mehr funktioniert, aber noch "
        "ein wenig Wasser beinhaltet." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );
  
//-----Details Anfang-----
  
  AddDetail( ({"kammer"}), 
            "In der Kammer steht ein kleiner Springbrunnen und Waffen und "
            "Schilde haengen an den Waenden.");

  AddDetail( ({"waffen"}),
	    "Du siehst verschiedene Waffen an den Waenden haengen. Du siehst "
            "maechtige Schwerter und Keulen.");

  AddDetail( ({"schilde"}),
	    "Die Schilde an den Waenden sind reich verziert und tragen "
            "Wappen.");

  AddDetail( ({"mitte"}), 
            "In der Mitte der Kammer steht ein kleiner Springbrunnen.");

  AddDetail( ({"springbrunnen","brunnen","becken","jahren"}),
	    "Der kleine Springbrunnen funktioniert zwar seit Jahren nicht "
            "mehr, jedoch ist noch etwas Wasser im Becken.");

  AddDetail( ({"wasser"}),
	    "Das Wasser sieht ein wenig gruenlich aus, jedoch kann man es "
            "sicher noch trinken."); 
  
  AddDetail( ({"boden"}), 
            "Am Boden sind die fuer diese Ebene typischen Marmorplatten zu "
            "erkennen.");

  AddDetail( ({"decke"}),
	    "An der Decke haengt ein kleiner Kronleuchter.");

  AddDetail( ({"waenden","waende","fackeln","platz","wand"}),
	    "An den Waenden haengen diesmal keine Fackeln. Den Platz der "
            "Fackeln nehmen diesmal Waffen und Schilde ein.");

  AddDetail( ({"schwerter"}), 
            "Grosse scharfe Schwerter haengen an den Waenden. Vielleicht "
            "kannst Du eins abreissen und selber benutzen.");

  AddDetail( ({"keulen","schaden"}),
	    "Grosse schwere Keulen haengen an der Wand. Sie richten sicher "
            "einigen Schaden an. Vielleicht kannst Du eine abreissen und "
            "selber benutzen.");

  AddDetail( ({"wappen","familien","elfen","menschen","besitzer","trophaee"}),
	    "Die Wappen stellen verschiedene Familien der Elfen und Menschen "
            "dar. Die Besitzer sind anscheinend hier im Tempel gestorben und "
            "ihre Schilde wurden als Trophaee hier aufgehaengt."); 
  
  AddDetail( ({"marmorplatten","platten","schein"}), 
            "Die weissen Marmorplatten glaenzen im roetlichen Schein der "
            "Kerzen.");

  AddDetail( ({"kronleuchter"}),
	    "Die Kerzen im Kronleuchter brennen und erhellen die Kammer mit "
            "einem roten Leuchten.");

  AddDetail( ({"kerzen","leuchten","farbe"}),
	    "Die Kerzen leuchten in einer roetlichen Farbe.");

  AddDetail( ({"tempel"}), 
            "Du bist nun auf der dritten Ebene im Tempel. Du bist fast oben "
            "angekommen.");

  AddDetail( ({"ebene"}),
	    "Du bist auf der hoechsten Ebene im Tempel. Nur noch die "
            "Tempelspitze ist ueber Dir.");

  AddDetail( ({"himmel"}),
	    "Da musst Du wohl hoch in die Tempelspitze."); 
  
  AddDetail( ({"tempelspitze","spitze","osten"}), 
            "Da musst Du nach Osten gehen, um hoch zu kommen.");

  AddSmell(DEFAULT_SMELL, "Es riecht nach altem Wasser.");  
 
  AddSmell( ({"wasser"}),
	   "Das Wasser im Becken des Springbrunnens riecht ein wenig uebel.");

  AddSound(DEFAULT_SOUND, "Du hoerst das Flackern der Kerzen am Kronleuchter.");

  AddSound( ({"flackern"}),
	   "flacker,flacker,flacker,flacker");

//-----Details Ende-----
  
AddExit("osten", ROOM "tem3-1");
AddExit("norden", ROOM "tem3-3");
AddExit("sueden", ROOM "tem3-9");

AddCmd( ({"reiss", "reisse" }), "reissen" );
AddCmd( ({"trink", "trinke" }), "trinken" );

}
void reset()
{
  ::reset();
  anzahl=3;
}
int reissen(string str)
{
   notify_fail("An was willst Du reissen?\n");
   if ( member( ({ "an schwert", "an keule" }),str) != -1) 
  {
    write(BS( "Du probierst eine Waffe von der Wand zu reissen, aber eine "
           "magische Macht haelt sie an der Wand fest. Chivas wollte nur "
           "mal sehen, wie gierig Du bist.\n"));
    say( TPN+" probiert eine Waffe von der Wand zu reissen.\n");
    return 1;
  }
}
int trinken(string str)
{
   notify_fail("Was moechtest Du trinken?\n");
   if ( member( ({ "wasser" }),str) != -1) 
  { 
    write(BS( "Du trinkst einen Schluck des gruenlichen Wassers und Dir wird "
              "schlecht. Nachdem Du die Uebelkeit ueberwunden hast, "
              "geht es Dir aber schon viel besser."));
    say(BS( TPN+" trinkt einen Schluck gruenlichen Wassers."));
    if ( anzahl )
    {
      TP -> heal_self(50+random(20));
      anzahl--;
    }
    return 1;
  }
}

