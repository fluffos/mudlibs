// von Chivas
inherit "std/room";

#include "../def.h"

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "An einem Tempel im Dschungel");
  SetProp( P_INT_LONG,
        "Dies scheint die nordwestliche Ecke des Tempels zu sein, da der Pfad "
        "Richtung Suedwesten abbiegt. Die Ecken des Tempels sind mit grossen "
	"Statuen 'verschoenert', wenn man es so ausdruecken mag. Ansonsten "
        "bildet der Dschungel eine natuerliche Grenze und bietet keinerlei "
        "Moeglichkeiten den Pfad zu verlassen. " );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 30, ENV_TERRAIN: TT_JUNGLE]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"ecke"}), 
            "Dies ist die nordwestliche Ecke des Tempels, Du kannst weiter "
            "nach Suedwesten um den Tempel herum gehen.");

  AddDetail( ({"tempels","tempel"}),
	    "Der Tempel sieht ueberall einfach schaurig aus. Besonders an "
            "dieser Ecke, wo zwei Statuen den Tempel 'verschoenern'.");

  AddDetail( ({"pfad"}),
	    "Der Pfad ist gut begehbar und fuehrt zwischen dem Tempel und "
            "dem Dschungel um den Tempel herum.");

  AddDetail( ({"richtung","richtungswechsel"}), 
            "Hier findet ein Richtungswechsel statt und der Pfad biegt um "
            "die Ecke nach Suedwesten um den Tempel herum.");

  AddDetail( ({"suedwesten"}),
	    "Das ist eine Richtung.");

  AddDetail( ({"ecken"}),
	    "Hier stehen zwei riesengrosse Statuen. Sie sehen schaurig aus."); 
  
  AddDetail( ({"statuen"}), 
            "Die zwei Statuen an der Ecke sind riesengross und haben "
            "graesslich aussehende Fratzen. Ihre Koerper machen einen "
            "muskuloesen Eindruck. Du bist froh, dass sie aus Stein bestehen "
            "und Dir nichts antun koennen. \n"
            "             \n"
            "Jedenfalls hoffst Du es.");

  AddDetail( ({"dschungel"}),
	    "Der Dschungel mit seiner Unmenge an Pflanzen zwingt Dir die "
            "Richtung auf. Es besteht keine Moeglichkeit sich da durch "
            "zu kaempfen.");

  AddDetail( ({"grenze"}),
	    "Diese Grenze kannst Du nicht ueberschreiten.");

  AddDetail( ({"moeglichkeit"}), 
            "Keine Moeglichkeit heisst hier geht es nicht weiter.");

  AddDetail( ({"boden"}),
	    "Am Boden liegen einige kleine Steine, Blaetter und Aeste.");

  AddDetail( ({"himmel","blaetterdach","dach"}),
	    "Am Himmel erkennst Du die Sonne und einige Wolken. Das "
            "Blaetterdach ist hier nicht sehr dicht."); 
  
  AddDetail( ({"sonne"}), 
            "Die Sonne steht fast senkrecht und laesst Dich schwitzen.");

  AddDetail( ({"wolken","regen"}),
	    "Es sind nur harmlose Schaefchenwolken. Es sieht nicht so aus "
            "als ob es Regen geben wuerde. ");

  AddDetail( ({"steine"}),
	    "Sehr uninteressant. Du kannst an den Steinen nichts besonderes "
            "entdecken.");

  AddDetail( ({"blaetter"}), 
            "Die Blaetter sind von den Pflanzen herunter gefallen und es "
            "raschelt wenn man ueber sie geht.");

  AddDetail( ({"aeste"}),
	    "Die Aeste stammen auch von den Pflanzen am Pfad.");

  AddDetail( ({"fratzen"}),
	    "Die Fratzen sind graesslich. Sie sehen so aus, als ob sie sich "
            "am Leiden anderer ergoetzen. Das Schlimmste jedoch sind die "
            "Augen der Statuen."); 
  
  AddDetail( ({"koerper","eindruck"}), 
            "Die Koerper sind reich verziert mit grausligen Totenkoepfen. "
            "Der Steinmetz, der diese Arbeit hergestellt hat, muss schon sehr "
            "eigenartig gewesen sein.");

  AddDetail( ({"stein"}),
	    "Es scheint sich um schwarzen Granit zu handeln.");

  AddDetail( ({"schaefchenwolken"}),
	    "Maaeeehhhh!");

  AddDetail( ({"pflanzen","unmenge"}), 
            "Es gibt hier alle moeglichen Pflanzen. Du siehst Baeume, Buesche, "
            "Lianen und Blumen.");

  AddDetail( ({"granit","steinart","thema"}),
	    "Dies ist eine Steinart, mehr weisst Du nicht ueber das Thema.");

  AddDetail( ({"baeume","bestandteil"}),
	    "Baeume sind ein wesentlicher Bestandteil im Dschungel."); 
  
  AddDetail( ({"lianen"}), 
            "Sie sehen sehr stabil aus. Man koennte ja mal versuchen sich "
            "wie Tarzan an ihnen zu schwingen.");

  AddDetail( ({"tarzan","legende","kauz"}),
	    "Tarzan soll laut einer Legende so ein komischer Kauz gewesen sein, "
            "der den ganzen Tag bruellend durch den Dschungel gesprungen ist, also "
            "wie heute der moderne Berserker.");

  AddDetail( ({"tag","zeiteinheit"}),
	    "Dies ist eine Zeiteinheit.");

  AddDetail( ({"berserker","kronang"}),
	    "Wenn Du das nicht weisst, geh zu Kronang und er erzaehlt es Dir.");

  AddDetail( ({"blumen"}),
	    "Du siehst die ueblichen Dschungelblumen.");

  AddDetail( ({"buesche"}),
	    "Die Buesche sind uninteressant. Sie verhindern primaer, dass Du "
            "den Pfad verlassen kannst.");

  AddDetail( ({"dschungelblumen"}), 
            "Rate doch mal!!!!");

  AddDetail( ({"arbeit","steinmetz","kuenstler"}),
	    "Der Kuenstler ist nicht da.");

  AddDetail( ({"totenkoepfen","totenkoepfe","abscheu"}),
	    "Du wendest Dich voller Abscheu ab. Grauslig."); 

  AddDetail( ({"leiden"}),
	    "Die Leiden in diesem Tempel muessen schlimm gewesen sein, wenn "
            "man davon ausgeht, dass es hier draussen schon so boese "
            "aussieht."); 
  
  AddDetail( ({"schlimmste","augen","bewegungen","nackenhaare","haare"}),
	    "Die Augen scheinen lebendig zu sein und sind blutunterlaufen. Sie "
            "achten genau auf jede Deiner Bewegungen. Deine Nackenhaare "
            "stellen sich auf."); 

  AddDetail( ({"naehe","untersuchungen"}),
	    "Chivas verzweifelt an Deinen Untersuchungen."); 
  
  AddSmell(DEFAULT_SMELL, "Es riecht irgendwie dschungelig.");  
 
  AddSmell( ({"dschungelig","dschungel","pflanzen"}),
	   "Es riecht nach Pflanzen, also was ganz normales.");

  AddSound(DEFAULT_SOUND, "Die Blaetter rascheln unter Deinen Schritten. Es "
                          "ist nur merkwuerdig, dass Du ansonsten keine "
                          "Tiere oder Voegel hoerst. Anscheinend trauen sie "
                          "sich nicht in die Naehe des Tempels.");

  AddSound( ({"rascheln","schritten","schritte"}),
	   "Die Blaetter rascheln, wenn Du ueber sie gehst.");
  
  AddSound( ({"tiere","voegel"}),
		"Die sind nicht da. Wirklich komisch.");

//-----Details Ende-----
  
AddExit("suedwesten", ROOM "tem27");
AddExit("osten", ROOM "tem10");

AddCmd( ({"schwing", "schwinge" }), "schwingen" );
AddCmd( ({"rat", "rate" }), "raten" );

}
int schwingen(string str)
{
   notify_fail("An was moechtest Du schwingen ?\n");
   if ( member( ({ "an lianen", "an liane" }),str) != -1) 
  {
    write(BS( "Du schwingst Dich voller Mut mit der Liane durch die Gegend und "
           "wie es sein musste, knallst Du voller Wucht gegen den naechsten "
           "Baum. Herzliche Glueckwunsch.\n"));
    say( TPN+" schwingt an einer Liane und tut sich richtig weh dabei. Du "
             "verdrehst die Augen und denkst: . o O (Was fuer ein Idiot).\n");
    TP->AddHp(-30);
    return 1;
  }
}
int raten(string str)
{
   notify_fail("Was moechtest Du raten ?\n");
   if ( member( ({ "orchideen", "orchidee" }),str) != -1) 
  {
    write(BS ( "Du raetst Orchidee und diese Antwort ist richtig. Ein "
               "heranspringender Schimpanse schuettelt Dir die Hand und "
               "verschwindet sofort wieder zwischen den Pflanzen."));
    say( TPN+" ueberlegt und kriegt ploetzlich die Hand von einem Schimpansen "
             "geschuettelt. Irgendwie ist der Abenteurer Dir nicht ganz geheuer. "
             "Du beschliesst ihn im Auge zu behalten.\n");
    return 1;
  }
return 0;
}  

