// von Chivas
// 
inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

int dietrich_zahl;

void create()
	
{
  ::create();

  dietrich_zahl=1;

  SetProp( P_INT_SHORT, "In einer Gefaengniszelle");
  SetProp( P_INT_LONG,
	"Du stehst in einer Gefaengniszelle, sie bietet nicht sehr viel Platz "
	"und ist sehr kahl. Der Boden besteht aus Steinen und die "
        "Gitter der Zelle machen einen sehr stabilen Eindruck. "
        "In einer Feuerstelle brennt ein kleines aber heisses Feuer. Du "
        "schwitzt ein wenig.");
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 50, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  AddDetail( ({"boden","luecke"}), 
            "Der Boden besteht aus Steinen. Sie sind zwar roh behauen aber "
            "es ist keine Luecke zu erkennen. In der Mitte der Zelle brennt "
            "ein kleines Feuer.");

  AddDetail( ({"feuerstelle","stelle","feuer","sauna","mitte"}), 
            "In der Feuerstelle brennt ein kleines Feuer. Du kommst Dir vor "
            "wie in einer Sauna.");

  AddDetail( ({"steinen","steine"}),
	    "Die Steine sind sehr uninteressant.");

  AddDetail( ({"gefaengniszelle","zelle"}),
             QueryProp(P_INT_LONG));

  AddDetail( ({"gitter"}), 
            "Die Gitter der Zelle machen einen stabilen Eindruck. Ohne "
            "Schluessel kommst Du hier wohl nicht raus.");

  AddDetail( ({"waende","wand"}),
	    "Die Waende der Zelle sind kahl, bis auf die Zellentuer siehst Du "
            "nichts was interessant ist.");

  AddDetail( ({"decke","chance"}),
	    "Die Decke ist einfach trostlos, keine Chance durch die Decke zu "
            "entkommen.");

  AddDetail( ({"himmel"}),
	    "Das waere schoen, wenn Du ihn hier sehen koenntest.");

  AddDetail( ({"schluessel"}),
	    "Ohne Schluessel wirst Du wohl hier bis zum Reboot sitzen, oder "
            "Du findest einen netten Spieler der Dich hier raus holt, wenn "
            "die Tuer zu ist."); 
  
  AddDetail( ({"reboot","alternative"}), 
            "Das ist eine schlechte Alternative.");

  AddDetail( ({"dietrich"}),
	    "Du musst ihn finden.");

  AddDetail( ({"spieler"}),
	    "Ein anderer Spieler wie Du.");

  AddDetail( ({"tuer","zellentuer"}),
	    "Durch die Zellentuer kommt man wieder raus, falls sie nicht zu "
            "ist und Du hier einsitzt.");

  AddDetail( ({"platz"}), 
            "Es ist recht beengend.");

  AddDetail( ({"eindruck"}),
	    "Die Gitter scheinen sehr stabil zu sein.");

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");

  AddSmell(DEFAULT_SMELL, "Es riecht nach nichts.");  
 
  AddSound(DEFAULT_SOUND, "Es herrscht Totenstille in der Zelle.");

  AddSound( ({"totenstille"}),
	   "Die Totenstille hier ist wohl das letzte was Du hoerst. Aber war "
           "da nicht eben ein metallisches Klingen im Feuer?");

  AddSound( ({"klingen","feuer"}),
	   "Das Klingen kommt von einem kleinen Dietrich im Feuer. Du musst "
           "wohl ins Feuer greifen um ihn zu bekommen.");
  
//-----Details Ende-----

AddCmd( ({"oeffne" }), "oeffnen" );
AddCmd( ({"greif","greife" }), "greife" );

}
void reset()
{
  ::reset();
  dietrich_zahl=1;
}
int greife(string str)
{
  object dietrich;
  notify_fail( "Wo moechtest Du reingreifen?\n" );
  if(!str || str == "") return 0;
  if(!(str == "in feuer" ||
       str == "ins feuer" ||
       str == "in das feuer hinein"||
       str == "ins feuer hinein" )) return 0; 

   {
     if( dietrich_zahl < 1 )
     {
        write("Du greifst ins Feuer, aber anscheinend hast Du Dich geirrt.\n");
        say(sprintf("%s greift sinnlos ins Feuer.\n", TP->Name(WER)));
        TP->AddHp(-30);
        return -1;
     }
      if ( present("tempeldietrich",TP) )
      {
      write("Du hast bereits einen Dietrich, wie viele willst Du denn "
      +"noch ?\n" );
      say(sprintf("%s stellt sich dumm an.\n", TP->Name(WER)));
      TP->AddHp(-30);
      return -1;
      }
      else
      {
        {dietrich = clone_object( OBJ "dietrich.lpc");
        if ( ME_TOO_HEAVY == dietrich->move(TP,M_GET|M_SILENT) )

          {
          write(
          "Der Dietrich ist Dir zu schwer. Du Weichei!\n" );
          say(BS(sprintf("%s findet einen Dietrich und laesst ihn fallen.\n", TP->Name(WER))));
          dietrich -> remove();
          return 1;
          }
          else
          {
          write("Du greifst ins Feuer. Es tut zwar weh, aber Du findest "
                "ploetzlich einen Dietrich.\n");
          say(sprintf("%s findet etwas.\n",
          TP->Name(WER)));
          dietrich_zahl--;
          return 1;
          }
        }
     }
    return 0;
   }
  return 0;
}

int oeffnen(string str)
{
 notify_fail("Was moechtest Du womit oeffnen?\n");

 if(!str || str == "") return 0;
 if(!(str == "tuer mit schluessel" ||
      str == "zellentuer mit schluessel" ||
      str == "zelle mit schluessel"||
      str == "zellentuer mit dietrich" ||
      str == "zelle mit dietrich"||
      str == "tuer mit dietrich" )) return 0;
 
 if( str == "tuer mit schluessel" ||
     str == "zellentuer mit schluessel" ||
     str == "zelle mit schluessel"){

  if(!present("tempelschluessel", TP)){
	  
  write(BS("Du hast doch gar nicht den richtigen Schluessel fuer die Tuer.\n"));
 
  say(TPN+" stellt sich dumm an.\n");
  return -1;
  }
  else 
  {
  write(BS("Du oeffnest die Zellentuer mit dem Schluessel.\n"));
  say(TPN+" oeffnet die Zellentuer.\n");
  AddExit("nordwestoben", ROOM "tem49");
  return -1;
  }}

 if( str == "tuer mit dietrich" ||
     str == "zellentuer mit dietrich" ||
     str == "zelle mit dietrich"){

  if(!present("tempeldietrich", TP)){
	  
  write(BS("Du hast doch gar keinen Dietrich, aber schau Dich doch mal um.\n"));
 
  say(TPN+" stellt sich dumm an.\n");
  return -1;
  }
  else 
  {
  object ob;
  write(BS("Du oeffnest die Zellentuer mit dem Dietrich, dabei wird der "
           "Dietrich leider zerstoert.\n"));
  say(TPN+" oeffnet die Zellentuer.\n");
  while(ob=present("tempeldietrich", TP))
  ob->remove(1);
  AddExit("nordwestoben", ROOM "tem49");
  return -1;
  }}
}
