// von Chivas
inherit "std/room";

#include "../def.h"

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Tempel");
  SetProp( P_INT_LONG,
        "An den Waenden der Kammer haengen ein paar uralte Gobbelins, die "
        "schon bessere Tage erlebt haben. Auch auf dem Granitboden liegt "
	"ein alter Teppich, seine Muster sind ausgebleicht und er hat einige "
        "Brandloecher und Risse, die anscheinend von einem Kampf zu stammen "
        "scheinen." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 0 );

  
//-----Details Anfang-----

  
  AddDetail( ({"wand","waende","waenden","grund","fackeln"}), 
            "An den Waenden haengen ein paar alte Gobbelins und Halterungen "
            "fuer Fackeln, die jedoch leer sind. Dies ist auch der Grund "
            "wieso es hier so dunkel ist.");

  AddDetail( ({"kammer"}),
	    "In der Kammer ist nichts zu sehen, was einen gewissen Wert hat. "
            "Die alten Gobbelins an den Waenden sind ausgebleicht und nichts "
            "mehr wert.");

  AddDetail( ({"gobbelins","gobbelin"}),
	    "Die Gobbelins sind ausgebleicht und die Zeichnungen sind kaum "
            "noch zu erkennen.");

  AddDetail( ({"halterungen"}), 
            "Die Halterungen sind leer.");

  AddDetail( ({"tage"}), 
            "Es ist lange her, dass sie aufgehaengt wurden.");

  AddDetail( ({"granitboden","boden"}),
	    "Auf dem Granitboden liegt ein uralter Teppich.");

  AddDetail( ({"teppich"}),
	    "Der Teppich hat lauter Risse und Brandloecher. Die Muster auf "
            "dem Teppich sind fast vollkommen ausgebleicht."); 
  
  AddDetail( ({"muster"}), 
            "Die Muster auf dem Teppich bestehen aus Linien und Quadraten. "
            "Ab und zu kann man auch ein paar Symbole erkennen.");

  AddDetail( ({"brandloecher","loecher"}),
	    "Die Brandloecher scheinen von einem Treffen zwischen den "
            "Bewohnern des Tempels und einigen Abenteurern zu stammen. Es "
            "sieht so aus, als ob ein paar Feuerbaelle den Teppich getroffen "
            "haben.");

  AddDetail( ({"risse"}),
	    "Die Risse sind altersbedingt.");

  AddDetail( ({"kampf"}), 
            "Es wird der Kampf zwischen den Dschungelelfen und den Huetern "
            "des Tempels gezeigt. Die Dschungelelfen scheinen zu fliehen.");

  AddDetail( ({"decke","himmel"}),
	    "An der Decke sieht man einige Spinnweben zu sehen.");

  AddDetail( ({"wert"}),
	    "Die Gobbelins sind sicher wertvoll fuer Historiker, aber nicht "
            "fuer Dich."); 
  
  AddDetail( ({"historiker"}), 
            "Du bist keiner und willst auch keiner werden.");

  AddDetail( ({"zeichnungen"}),
	    "Die Zeichnungen stellen den Kampf der Dschungelelfen gegen die "
            "Hueter des Tempels dar.");

  AddDetail( ({"tempel","tempels"}),
	    "Der Tempel ist riesig. Du bist gespannt was erst alles in den "
            "Ebenen ueber dem Erdgeschoss kommt.");

  AddDetail( ({"jahrzehnte","jahrzehnten"}), 
            "Wann genau es geschehen ist, weisst Du nicht.");

  AddDetail( ({"dschungelelfen","boese"}),
	    "Die Dschungelelfen haben vor Jahrzehnten das Boese aus dem Tempel "
            "vertrieben, aber wie Du schon weisst, ist es zurueck gekehrt.");

  AddDetail( ({"hueter"}),
	    "Die Hueter des Tempels auf dem Gobbelin sind Trolle, Oger und "
            "Dunkelelfen."); 
  
  AddDetail( ({"linien"}), 
            "Die Linien auf dem Teppich sind kaum noch zu erkennen.");

  AddDetail( ({"quadrate"}),
	    "Die Quadrate auf dem Teppich sind recht uninteressant.");

  AddDetail( ({"symbole","wissen","magie"}),
	    "Die Symbole stellen anscheinend boese Magie dar, aber um dies "
            "genau zu definieren, fehlt Dir das Wissen.");

  AddDetail( ({"treffen"}), 
            "Das Treffen war sicher nicht freundlich.");

  AddDetail( ({"bewohner","bewohnern"}),
	    "Du bist schon auf ein paar Bewohner gestossen.");

  AddDetail( ({"abenteurern","abenteurer"}),
	    "Du hoffst, dass die Abenteurer gewonnen haben."); 
  
  AddDetail( ({"feuerbaelle"}), 
            "Momentan sind keine Feuerbaelle mehr zu sehen und Du bist froh "
            "darueber.");

  AddDetail( ({"spinnweben"}),
	    "Die Spinnweben sind sehr alt und verlassen.");

  AddDetail( ({"ebenen"}),
	    "Ueber dem Erdgeschoss sind noch 3 Ebenen und die Tempelspitze.");

  AddDetail( ({"erdgeschoss"}), 
            "Du befindest Dich immer noch im Erdgeschoss.");

  AddDetail( ({"tempelspitze","spitze"}),
	    "Die Tempelspitze ist noch fern.");

  AddDetail( ({"trolle","oger","dunkelelfen","rassen","boesen"}),
	    "Diese Rassen scheinen mit dem Boesen verbuendet zu sein."); 
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach altem Teppich.");  
 
  AddSmell( ({"teppich"}),
	   "Der Teppich riecht verschimmelt.");

  AddSound(DEFAULT_SOUND, "Es ist totenstill.");

//-----Details Ende-----
  
AddExit("nordosten", ROOM "tem49");

}

