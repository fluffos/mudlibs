// von Chivas
inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Tempel");
  SetProp( P_INT_LONG,
        "In dieser Kammer geht es sehr luftig zu. Die Flammen der Fackeln "
        "tanzen durch den Wind auf und ab. Der Wind wird durch ein halbes "
        "Dutzend kleiner Tornados entfacht, die sich im Uhrzeigersinn um "
        "die Kammermitte drehen. Genau in der Mitte der Kammer ist eine grosse "
        "Rune auf den Boden gezeichnet." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"kammer"}), 
            "Die Kammer ist sehr luftig. Kleine Tornados tanzen in der Mitte "
            "im Uhrzeigersinn.");

  AddDetail( ({"flammen"}),
	    "Die rot gluehenden Flammen der Fackeln huepfen im Wind immer auf "
            "und ab.");

  AddDetail( ({"fackeln","licht"}),
	    "Die Fackeln haengen an den Waenden und erhellen die Kammer mit "
            "roetlichem Licht.");

  AddDetail( ({"wind"}), 
            "Der Wind, der hier herrscht, zerzaust Dein Haar. Deine Frisur ist "
            "hinueber.");

  AddDetail( ({"dutzend","tornados","uhrzeigersinn"}),
	    "Ein Dutzend kleine Tornados drehen sich um eine Rune am Boden in "
            "der Mitte der Kammer.");

  AddDetail( ({"kammermitte","mitte"}),
	    "In der Kammermitte ist eine Rune auf dem Boden eingraviert. Um "
            "diese Rune drehen sich ein Dutzend kleiner Tornados."); 
  
  AddDetail( ({"rune"}), 
            "Die Rune am Boden bedeutet 'Wind', wie sollte es bei solch einer "
            "Kammer auch anders sein.");

  AddDetail( ({"boden"}),
	    "Am Boden siehst Du fuer diese Ebene die typischen Marmorplatten. "
            "In der Mitte ist eine grosse Rune eingraviert.");

  AddDetail( ({"decke"}),
	    "An der Decke haengen kleine Spiegel, in denen man die Rune und "
            "die Tornados sehen kann.");

  AddDetail( ({"waende","waenden"}), 
            "An den Waenden siehst Du eiserne Halterungen, in denen die "
            "Fackeln stecken, die den Raum erhellen.");

  AddDetail( ({"haar","frisur"}),
	    "Deine Frisur kannst Du bei diesem Wind vergessen.");

  AddDetail( ({"marmorplatten","platten","marmor"}),
	    "Der Marmor der Platten ist weiss und glatt. Er muss sehr teuer "
            "gewesen sein."); 
  
  AddDetail( ({"spiegel","architekt"}), 
            "Wozu die Spiegel an der Decke sind, entzieht sich Deinem Wissen. "
            "Der zustaendige Architekt wird es schon gewusst haben.");

  AddDetail( ({"wissen"}),
	    "Dein Wissen ist eigentlich sehr bescheiden. Du solltest da nicht "
            "weiter nachforschen.");

  AddDetail( ({"halterungen"}),
	    "Die eisernen Halterungen sind schlicht und uninteressant.");

  AddDetail( ({"nase","rasse"}), 
            "Fuer Deine Rasse hast Du eine sehr grosse Nase.");

  AddDetail( ({"ebene","tempel"}),
	    "Du bist auf der dritten Ebene im Tempel.");

  AddDetail( ({"raum"}),
	    "Dieser Raum ist eine sehr windige Kammer."); 
  
  AddDetail( ({"himmel"}), 
            "Hier herrscht zwar ein starker Wind, aber den Himmel kannst Du "
            "nicht sehen.");

  AddSmell(DEFAULT_SMELL, "Du riechst die Fackeln brennen.");  
 
  AddSmell( ({"fackeln","geruch"}),
	   "Der uebliche Geruch von brennenden Fackeln steigt Dir in die "
           "Nase.");

  AddSound(DEFAULT_SOUND, "Die Tornados sind unglaublich laut.");

  AddSound( ({"tornados","tornado"}),
	   "Die Tornados zischen laut in der Kammermitte umher.");
  
//-----Details Ende-----
  
AddExit("sueden", ROOM "tem3-6");
AddExit("westen", ROOM "tem3-4");
AddExit("suedwesten", ROOM "tem3-1");

}

