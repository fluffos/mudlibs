// von Chivas
inherit "std/room";

#include "../def.h"

void create()
	
{
  ::create();


  SetProp( P_INT_SHORT, "In einem Tempel");
  SetProp( P_INT_LONG,
        "Es ist unangenehm hier im Tempel. Neben dem Ausgang im Westen ist ein "
        "kleines Becken, aus dem eine rote Fluessigkeit in eine Rinne fliesst. "
	"Neben dem Ausgang im Osten ist ein Loch in der Wand, was jedoch "
        "vergittert ist. Die Fluessigkeit scheint dort den Tempel zu "
        "verlassen. Du willst eigentlich gar nicht wissen, was das ist." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  
  AddDetail( ({"tempel"}), 
            "Der Tempel ist einfach kein schoener Ort.");

  AddDetail( ({"ausgang","richtung"}),
	    "Es gib in jede Richtung einen Ausgang. Du bist aber an das "
            "Problem schon gewohnt.");

  AddDetail( ({"westen"}),
	    "Im Westen steht ein kleines Becken aus Granit. Aus dem Becken "
            "fliesst eine Fluessigkeit.");

  AddDetail( ({"becken"}), 
            "Aus einem kleinen Becken aus Granit fliesst eine rote "
            "Fluessigkeit. Das Becken ist mit kleinen Symbolen geschmueckt.");

  AddDetail( ({"fluessigkeit"}),
	    "Du koenntest die rote Fluessigkeit, die in der Rinne fliesst, "
            "kosten. Aber bedenke, dass dies in einem solchen Tempel Folgen "
            "haben koennte.");

  AddDetail( ({"rinne"}),
	    "In der Rinne, die ueber den Boden vom Becken zum Loch im Osten "
            "verlaeuft, fliesst eine rote Fluessigkeit."); 
  
  AddDetail( ({"osten"}), 
            "Im Osten ist ein Loch, wo die Fluessigkeit verschwindet.");

  AddDetail( ({"loch"}),
	    "Ueber dem Loch ist ein Gitter.");

  AddDetail( ({"wand"}),
	    "An der Wand im Osten ist ein vergittertes Loch.");

  AddDetail( ({"gitter","moeglichkeit"}), 
            "Das Gitter ist verrostet und es besteht keine Moeglichkeit es "
            "von hier drinnen zu oeffnen.");

  AddDetail( ({"boden"}),
	    "Am Boden sind grosse Steinplatten und eine Rinne, die quer durch "
            "den Raum verlaeuft.");

  AddDetail( ({"waende"}),
	    "Die Waende sind kahl, bis auf die Wand im Osten, wo ein Loch "
            "ist."); 
  
  AddDetail( ({"decke","himmel"}), 
            "An der Decke ist nichts interessantes zu entdecken.");

  AddDetail( ({"steinplatten","platten"}),
	    "Die Steinplatten bestehen aus Marmor.");

  AddDetail( ({"ort"}),
	    "Du waerst lieber woanders.");

  AddDetail( ({"problem","probleme"}), 
            "Du hast einige Probleme, manche sind groesser und manche "
            "kleiner.");

  AddDetail( ({"granit","gesteinsart"}),
	    "Dies ist eine Gesteinsart.");

  AddDetail( ({"symbolen","symbole"}),
	    "Als Du die Symbole naeher untersuchst, erkennst Du, dass es sich "
            "um Runen handelt."); 
  
  AddDetail( ({"runen","rune"}), 
            "Die Runen stehen fuer einige Dir bekannte Woerter.");

  AddDetail( ({"woerter","wort","woertern"}),
	    "Die Runen bilden die Woerter Tod, Feuer und Drache.");

  AddDetail( ({"tod"}),
	    "Die Rune, die das Wort Tod bildet beunruhigt Dich doch schon "
            "sehr.");

  AddDetail( ({"feuer","zusammenhang"}), 
            "Das Wort Feuer ist normalerweise nicht schlimm, aber in dem "
            "Zusammenhang mit Tod und Drache laeuft Dir schon ein eiskalter "
            "Schauer ueber den Ruecken.");

  AddDetail( ({"schauer","ruecken","zeit"}),
	    "In der letzten Zeit laeuft Dir oefter ein eiskalter Schauer ueber "
            "den Ruecken.");

  AddDetail( ({"drache","moeglichkeit","drachen"}),
	    "Mit der Rune Drache auf dem Becken ist sicher nicht die niedliche "
            "und kuschelige Art von Drachen gemeint. Vor allem mit den "
            "Woertern Tod und Feuer kann man diese Moeglichkeit vergessen."); 
  
  AddDetail( ({"art","arten"}), 
            "Du hast gehoert, dass es solche Arten geben soll.");

  AddDetail( ({"folgen"}),
	    "Manche Folgen sind toedlich oder ...!");

  AddDetail( ({"rost","eisen"}),
	    "Rost entsteht, wenn Eisen oxydiert.");

  AddDetail( ({"wasser"}),
	    "Wasser ist normalerweise nicht roetlich.");

  AddDetail( ({"marmor"}),
	    "Der Marmor ist sehr zerkratzt und nicht gepflegt.");

  AddDetail( ({"raum","kammer"}), 
            "Der Raum ist eigentlich eine Kammer.");
  
  AddSmell(DEFAULT_SMELL, "Es liegt ein suesslicher Geruch in der Luft.");  
 
  AddSmell( ({"luft","geruch","fluessigkeit"}),
	   "Der suessliche Geruch kommt von der Fluessigkeit.");

  AddSound(DEFAULT_SOUND, "Du hoerst wie die Fluessigkeit durch die Rinne "
                          "fliesst.");

  AddSound( ({"fluessigkeit"}),
	   "*plaetscher*");

//-----Details Ende-----
  
AddExit("norden", ROOM "tem31");
AddExit("nordosten", ROOM "tem31");
AddExit("nordwesten", ROOM "tem34");
AddExit("osten", ROOM "tem31");
AddExit("westen", ROOM "tem31");
AddExit("suedosten", ROOM "tem31");
AddExit("suedwesten", ROOM "tem31");
AddExit("sueden", ROOM "tem32");


AddCmd( ({"koste" }), "kosten" );

}
int kosten(string str)
{
   notify_fail("Was moechtest Du kosten?\n");
   if ( member( ({ "fluessigkeit" }),str) != -1) 
  {
    write(BS( "Du kostest die rote Fluessigkeit und es handelt sich um Wasser. "
           "Das Wasser ist durch Rost rotgefaerbt und das ist alles. Du bist "
           "irgendwie sehr erleichtert.\n"));
    say( TPN+" ist sehr erleichtert.\n");
    return 1;
  }
}

