// von Chivas
inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Tempel");
  SetProp( P_INT_LONG,
        "In der Mitte der Kammer fuehrt eine Wendeltreppe nach unten auf die "
        "zweite Ebene. An den Waenden haengen einige Fackeln, die mit ihrem "
        "roten Leuchten die Kammer ein wenig erhellen. Ansonsten wirkt die "
        "Kammer recht leer. Du spuerst aber eine staerkere magische Energie "
        "auf dieser Ebene knistern." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"mitte"}), 
            "In der Mitte der Kammer fuehrt eine Wendeltreppe runter auf die "
            "zweite Ebene.");

  AddDetail( ({"kammer","einzige"}),
	    "Die Kammer ist eigentlich sehr uninteressant. Das Einzige was "
            "interessant ist, ist die Wendeltreppe, die Dich wieder runter "
            "auf die zweite Ebene fuehrt.");

  AddDetail( ({"wendeltreppe","treppe","verzierungen"}),
	    "Die steinernde Wendeltreppe steht in der Mitte der Kammer. Sie "
            "hat keinerlei Verzierungen oder sonstiges. Sie fuehrt nur runter "
            "auf die zweite Ebene.");

  AddDetail( ({"ebene"}), 
            "Du bist nun endlich auf der dritten Ebene der Tempels angekommen. "
            "Ueber die Wendeltreppe kannst Du wieder runter auf die zweite "
            "Ebene gelangen.");

  AddDetail( ({"fackeln"}),
	    "Die Fackeln leuchten auf dieser Ebene in einer magischen roten "
            "Farbe.");

  AddDetail( ({"waenden","waende"}),
	    "An den Waenden haengen rot leuchtende Fackeln. Ansonsten sieht "
            "man nur die kahle Mauer."); 
  
  AddDetail( ({"leuchten"}), 
            "Das rote magische Leuchten fuehrt nicht dazu, dass Du beruhigter "
            "bist.");

  AddDetail( ({"boden","steinplatten","verbesserung","vergleich"}),
	    "Der Boden ist mit weissen Marmorplatten ausgelegt. Zum Vergleich "
            "mit den anderen Ebenen eine deutliche Verbesserung zu den alten "
            "Steinplatten weiter unten.");

  AddDetail( ({"decke","himmel"}),
	    "An der Decke siehst Du ein paar ekelige Fratzen, die Dich "
            "anschauen.");

  AddDetail( ({"energie","magie"}), 
            "Du kannst das Knistern der magischen Energie sogar hoeren.");

  AddDetail( ({"tempel","tempels"}),
	    "Du bist auf der dritten Ebene im Tempel angekommen.");

  AddDetail( ({"farbe"}),
	    "Die roetliche Farbe erinnert Dich irgendwie an Blut."); 
  
  AddDetail( ({"blut","gedanken"}), 
            "Die Farbe und Deine Gedanken beunruhigen Dich schon ein wenig.");

  AddDetail( ({"mauer"}),
	    "Die Mauer besteht aus kahlen, grossen Steinquadern.");

  AddDetail( ({"marmorplatten","platten"}),
	    "Die Marmorplatten sehen sauber und geputzt aus. Als ob jemand "
            "erst vor kurzem hier sauber gemacht hat.");

  AddDetail( ({"fratzen"}), 
            "Die Fratzen sehen schauerlich aus, jedoch macht es Dir schon "
            "lange nichts mehr aus.");

  AddDetail( ({"steinquadern","steinquader","quader"}),
	    "Die grossen Steinquader sind glatt geschliffen. Nur an einer "
            "Stelle ist etwas auffaelliges.");

  AddDetail( ({"stelle"}),
	    "An der einen Stelle ist eine kleine Inschrift in einen "
            "Steinquader geritzt."); 
  
  AddDetail( ({"inschrift"}), 
            "Du kannst sie lesen.");

  AddDetail( ({"todes","tod"}),
	    "Der Tod kann Dich sicher sehr gut auf dieser Ebene ereilen.");

  AddSmell(DEFAULT_SMELL, "Es riecht in dieser Kammer nach Sauberkeit.");  
 
  AddSmell( ({"sauberkeit"}),
	   "Es riecht so, als ob vor kurzem jemand hier richtig sauber gemacht "
           "hat.");

  AddSound(DEFAULT_SOUND, "Du hoerst die magische Energie auf der dritten "
                          "Ebene sogar knistern.");

  AddSound( ({"energie","knistern"}),
	   "**knister*knister*knister*knister**");
  
  AddReadDetail( ({"inschrift"}),
		"Willkommen auf der Ebene des Todes!!!!");

//-----Details Ende-----
AddItem(NPC "elfenkind", REFRESH_DESTRUCT);
  
AddExit("runter", ROOM "tem2-9");
AddExit("osten", ROOM "tem3-8");
AddExit("nordosten", ROOM "tem3-1");
AddExit("norden", ROOM "tem3-2");

}

