// von Chivas
inherit "std/room";

#include "../def.h"

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einem Tempel im Dschungel");
  SetProp( P_INT_LONG,
        "Vor Dir in Richtung Westen ist ein breiter Abgrund, da ein Teil der "
        "Decke eingestuerzt ist. Direkt neben dem Tempel steht ein grosser "
        "Baum und von den Aesten haengen Lianen herunter auf den Tempel." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 30, ENV_TERRAIN: TT_JUNGLE]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"richtung","westen"}), 
            "Im Westen ist ein tiefer Abgrund.");

  AddDetail( ({"abgrund"}),
	    "Der Abgrund ist tief, da dort die Decke eingestuerzt ist.");

  AddDetail( ({"teil","decke"}),
	    "Ein grosser Teil der Decke ist eingestuerzt und bildet jetzt "
            "einen tiefen Abgrund.");

  AddDetail( ({"tempel","tempels"}), 
            "Du bist auf einem dunklen Tempel.");

  AddDetail( ({"baum"}),
	    "Der Baum steht direkt am Tempel und seine Aeste haengen ueber die "            "Ebene, auf der Du Dich befindest.");

  AddDetail( ({"aeste","aesten"}),
	    "Die Aeste haengen weit ueber die Ebene, auf der Du bist. An ihnen "
            "haengen einige Lianen."); 
  
  AddDetail( ({"lianen","liane"}), 
            "Die Lianen haengen vor Dir auf den Boden. Du kannst sicher mit "
            "einer Liane ueber den Abgrund schwingen.");

  AddDetail( ({"boden"}),
	    "Am Boden wachsen ein paar Pflanzen.");

  AddDetail( ({"himmel"}),
	    "Der Himmel ist klar und schoen blau.");

  AddDetail( ({"ebene","ebenen"}), 
            "Du bist auf der ersten Ebene ausserhalb des Tempels. Du kannst "
            "nur innerhalb des Tempels auf andere Ebenen gelangen.");

  AddDetail( ({"pflanzen"}),
	    "Es gibt am Boden ein paar Graeser und Moose.");

  AddDetail( ({"graeser"}),
	    "Die Graeser sind nicht sehr interessant."); 
  
  AddDetail( ({"moose","moos"}), 
            "Das Moos ist angenehm weich, um auf ihm zu gehen.");

  AddSmell(DEFAULT_SMELL, "Es riecht nach den ueblichen Pflanzen im "
                          "Dschungel.");  
 
  AddSmell( ({"pflanzen","dschungel"}),
	   "Die Pflanzen riechen ganz normal.");

  AddSound(DEFAULT_SOUND, "Es ist recht still und es gibt auch nichts "
                          "besonderes zu hoeren.");

//-----Details Ende-----
  
AddExit("osten", ROOM "tem1-24");

AddCmd( ({"schwing","schwinge" }), "schwingen" );

}
int schwingen(string str)
{
   notify_fail("Wohin moechtest Du womit schwingen?\n");
   if ( member( ({ "mit liane nach westen","mit liane ueber abgrund" }),str) != -1) 
  {
    write(BS ( "Du greifst eine Liane und schwingst Dich ueber den Abgrund "
               "auf die andere Seite. Du bist froh, dass die Liane gehalten "
               "hat.\n"));
      TP->move(ROOM "tem1-22", M_GO, 
      "sich eine Liane und verschwindet", "schnappt", 
      "schwingt sich mit einer Liane herein");
    return 1;
  }
}

