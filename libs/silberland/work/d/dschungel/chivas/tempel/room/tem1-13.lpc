// von Chivas
inherit "std/room";

#include "../def.h"

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einem Tempel im Dschungel");
  SetProp( P_INT_LONG,
        "Die Pflanzen haben sich auf der gesamten Ebene ausserhalb des Tempels "
        "verteilt. Der Dschungel rings um Dich herum ist sehr nahe an den "
        "Tempel herangewachsen und schliesst den Tempel komplett ein. In "
        "Richtung Sueden befindet sich ein breiter Riss im Boden der Ebene. "
        "Komischerweise kannst Du in der Dunkelheit nicht das Erdgeschoss des "
        "Tempels sehen." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 30, ENV_TERRAIN: TT_JUNGLE]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----

  AddDetail( ({"pflanzen","beschlag"}), 
            "Lauter Graeser, Ranken und Schlingpflanzen haben den Boden und "
            "die Aussenmauern des Tempels in Beschlag genommen.");

  AddDetail( ({"ebene","ebenen"}),
	    "Du bist ausserhalb des Tempels auf der ersten Ebene. Auf die "
            "anderen Ebenen kommt man nur im Tempel.");

  AddDetail( ({"tempel","tempels"}),
	    "Du bist auf einem Tempel mitten im Dschungel.");

  AddDetail( ({"dschungel"}), 
            "Der Dschungel ist von hier oben gut zu sehen. Ueberall nur "
            "grosse Baeume um Dich herum.");

  AddDetail( ({"richtung","sueden"}),
	    "In Richtung Sueden befindet sich ein breiter Riss im Boden.");

  AddDetail( ({"riss","loch"}),
	    "Ein breiter Riss ist im Boden und Du siehst nur Dunkelheit, wenn "
            "Du hinunter schaust. Du kannst sicher ueber den Riss springen."); 
  
  AddDetail( ({"boden"}), 
            "Am Boden sind allerlei Pflanzen und ein breiter Riss zu sehen.");

  AddDetail( ({"dunkelheit","erdgeschoss"}),
	    "Die Dunkelheit im Erdgeschoss ist undurchdringbar. Du glaubst "
            "aber eine Gestalt erkannt zu haben.");

  AddDetail( ({"himmel","tag"}),
	    "Der Himmel ist klar. Es ist ein schoener Tag.");

  AddDetail( ({"ranken","ranke"}), 
            "Lauter Ranken sind an der Aussenmauer des Tempels zu sehen.");

  AddDetail( ({"schlingpflanzen","schlingpflanze"}),
	    "Einige Schlingpflanzen sind am Boden und an der Mauer.");

  AddDetail( ({"graeser","gras"}),
	    "Verschiedene kleine Graeser wachsen am Boden."); 
  
  AddDetail( ({"aussenmauern","aussenmauer","mauer"}), 
            "Die Aussenmauern sind mit lauter Ranken und Schlingpflanzen "
            "bewachsen.");

  AddDetail( ({"baeume","baum"}),
	    "Grosse Baeume stehen im Dschungel und auch direkt am Tempel.");

  AddDetail( ({"nase"}),
	    "Du hast eine ziemlich grosse Nase.");

  AddDetail( ({"gestalt"}), 
            "Auf jedenfall waren da rote Augen zu sehen.");

  AddDetail( ({"augen"}),
	    "Es waren kalte und boese Augen. Augen, die Du nicht noch einmal "
            "sehen willst. Sie sind auf jedenfall nicht mehr zu sehen. "
            "Vielleicht war es auch nur eine Taeuschung.");

  AddDetail( ({"taeuschung"}),
	    "Du bist Dir zwar sicher, dass Du diese Augen gesehen hast, aber "
            "Du hoffst jedenfalls, dass es nur eine Taeuschung war."); 
  
  AddSmell(DEFAULT_SMELL, "Ein uebler Gestank steigt Dir in die Nase.");  
 
  AddSmell( ({"gestank","riss"}),
	   "Der Gestank kommt aus dem Riss.");

  AddSound(DEFAULT_SOUND, "Du hoerst ein leises Schreien.");

  AddSound( ({"schreien"}),
	   "Das Schreien kommt aus der Dunkelheit. Mehr kannst Du nicht "
           "hoeren.");
  
//-----Details Ende-----
  
AddExit("norden", ROOM "tem1-12");

AddCmd( ({"spring","springe" }), "springen" );

}
int springen(string str)
{
   notify_fail("Ueber was moechtest Du springen?\n");
   if ( member( ({ "ueber loch","ueber riss" }),str) != -1) 
  {
    write(BS ( "Du springst ueber das Loch auf die andere Seite. Beinahe "
               "haette Deine Sprungkraft nicht gereicht. Du hast nochmal "
               "Glueck gehabt.\n"));
     TP->move(ROOM "tem1-14", M_GO,
     "ueber das Loch und verschwindet", "spring", "springt herein");
    return 1;
  }
}

