// von Chivas
inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();


  SetProp( P_INT_SHORT, "In einem Tempel");
  SetProp( P_INT_LONG,
        "Hier in den ersten Ebene des Tempels gibt es endlich nur "
        "noch klare Ausgaenge zu sehen. Das Verwirrspiel scheint ein Ende zu "
        "haben. Ausserdem scheint etwas Licht aus den grossen Fenstern "
        "in den Tempel, so dass die Sicht annehmbar ist. Die Waende sind mit "
        "alten, verrottenden Teppichen behangen und auf dem Boden erkennt "
        "man verblassende Buchstaben in den Steinplatten." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  
  AddDetail( ({"ebene"}), 
            "Du bist auf der ersten Ebene des Tempels.");
  
  AddDetail( ({"richtungen"}), 
            "Es gibt zwei Richtungen in die Du gehen kannst.");

  AddDetail( ({"tempel","tempels"}),
	    "Der Tempel scheint recht gross zu sein und Du fuehlst Dich hier "
            "nicht gerade wohl.");

  AddDetail( ({"ausgaenge"}),
	    "Du bist froh, dass es hier nicht mehr Ausgaenge in alle "
            "Richtungen gibt.");

  AddDetail( ({"verwirrspiel","spiel","spielchen","fallen","wahrscheinlichkeit"}), 
            "Die Wahrscheinlichkeit ist sehr gering, dass es keine Spielchen "
            "oder Fallen mehr gibt.");

  AddDetail( ({"ende","witz"}),
	    "Ein sehr guter Witz. Es ist definitiv nicht das Ende.");

  AddDetail( ({"fenstern","fenster"}),
	    "Die Fenster sind recht gross, so dass normalerweise sehr viel "
            "Licht in den Tempel fallen muesste, jedoch siehst Du ein leichtes "
            "milchiges Flimmern an den Fenstern, dass das Licht auszubremsen "
            "scheint."); 
  
  AddDetail( ({"licht","sicht"}), 
            "Du kannst zwar besser sehen als im Erdgeschoss, jedoch ist es "
            "immer noch duester.");

  AddDetail( ({"waende","wand"}),
	    "An den Waenden sind grosse Fenster, durch die jedoch nur wenig "
            "Licht in den Tempel eindringt. Ausserdem haengen verrottende "
            "Teppiche an der Wand.");

  AddDetail( ({"teppiche","teppichen"}),
	    "Die Teppiche zeigen Greueltaten der Vergangenheit.");

  AddDetail( ({"boden"}), 
            "Am Boden erkennst Du verblassende Buchstaben auf den einzelnen "
            "Steinplatten. Ausserdem erkennst Du eine kleine Inschrift.");

  AddDetail( ({"buchstaben","buchstabe"}),
	    " "
            "+-------+-------+-------+-------+-------+\n"
            "|       |       |       |       |       |\n"
            "|   D   |   C   |   W   |   R   |   J   |\n"
            "|       |       |       |       |       |\n"
            "+-------+-------+-------+-------+-------+\n"
            "|       |       |       |       |       |\n"
            "|   H   |   U   |   K   |   L   |   F   |\n"
            "|       |       |       |       |       |\n"
            "+-------+-------+-------+-------+-------+\n"
            "|       |       |       |       |       |\n"
            "|   M   |   B   |   I   |   G   |   T   |\n"
            "|       |       |       |       |       |\n"
            "+-------+-------+-------+-------+-------+\n"
            "|       |       |       |       |       |\n"
            "|   N   |   Y   |   Q   |   E   |   V   |\n"
            "|       |       |       |       |       |\n"
            "+-------+-------+-------+-------+-------+\n"
            "|       |       |       |       |       |\n"
            "|   A   |   E   |   R   |   P   |   O   |\n"
            "|       |       |       |       |       |\n"
            "+-------+-------+-------+-------+-------+\n"
            "|       |       |       |       |       |\n"
            "|   W   |   K   |   S   |   Z   |   X   |\n"
            "|       |       |       |       |       |\n"
            "+-------+-------+-------+-------+-------+\n");

  AddDetail( ({"steinplatten","platten"}),
	    "Auf jeder der Platten ist ein Buchstabe abgebildet. Sehr "
            "interessant."); 
  
  AddDetail( ({"flimmern"}), 
            "Das Flimmern an den Fenstern scheint eine magische Barriere zu "
            "sein, die das Licht aus dem Tempel auszusperren versucht. Die "
            "Barriere ist aber nicht mehr so stark wie noch vor Jahrhunderten, "
            "deswegen kannst Du recht gut sehen. Damals gab es hier sicher nur "
            "Dunkelheit.");

  AddDetail( ({"barriere"}),
	    "Die Barriere ist ein Stueck erstklassige Magie.");

  AddDetail( ({"dunkelheit"}),
	    "Es ist duester, aber nicht wirklich dunkel.");

  AddDetail( ({"jahrhunderte","jahrhunderten"}), 
            "Das ist sehr lange her.");

  AddDetail( ({"stueck","magie"}),
	    "Damals war die Magie hier im Tempel wirklich maechtig.");

  AddDetail( ({"vergangenheit"}),
	    "In der Vergangenheit war es sehr gefaehrlich hier im Tempel."); 
  
  AddDetail( ({"greultaten"}), 
            "Die Greultaten zeigen Folterungen und Blutopfer.");

  AddDetail( ({"folterungen","blutopfer"}),
	    "Aufgrund juengerer Spieler verzichtet der zustaendige Magier "
            "auf weitere Details zu diesem Thema.");

  AddDetail( ({"spieler"}),
	    "Du bist einer.");

  AddDetail( ({"magier"}), 
            "Du rufst: Hoch sollen sie leben!");

  AddDetail( ({"details","thema"}),
	    "Dies wird nicht weiter beschrieben.");

  AddDetail( ({"inschrift"}),
	    "Du kannst sie lesen."); 
  
  AddDetail( ({"himmel","decke"}), 
            "An der Decke haengen ein paar verlassene Spinnweben.");

  AddDetail( ({"spinnweben"}),
	    "Die Spinnweben sind sehr uninteressant.");

  AddDetail( ({"erdgeschoss"}),
	    "Das Erdgeschoss ist unter Dir und Du bist froh, dass Du es hinter "
            "Dir hast.");

  AddDetail( ({"a","b","c","d","e","f","g","h","i","j","k","l","m","n","o","p","q","r","s","t","u","v","w","x","y","z"}),
	    "Dies ist ein Buchstabe."); 
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach gar nichts.");  
 
  AddSound(DEFAULT_SOUND, "Du hoerst eine sagenhafte Totenstille.");

  AddSound( ({"totenstille","tod","HARHARHAR!!!!"}),
	   "Tod sagt: HARHARHAR!!!!");
  
  AddReadDetail( ({"inschrift"}),
		"Wandle auf dem Namen des Schoepfers des Tempels. \n"
                "<betrete 'buchstabe'>");

//-----Details Ende-----
  
AddExit("osten", ROOM "tem1-9");
AddSpecialExit( "westen", "go_westen" );

AddCmd( ({"betrete" }), "betreten" );

}
int go_westen(string dir)
{

  if(!(present("ninvis6", TP)))
  {
    write( BS( "Chivas sagt: So einfach kannst Du nicht nach Westen gehen, schau "
	       "Dir den Boden an und forsche!!!") );
    say("Chivas haelt grinsend "+TP->Name(WEN)+" davon ab, "
      "nach Westen zu gehen.\n");
  return -1;
  }
  write(BS("Du gehst weiter nach Westen.\n"));
 
  say(TPN+" verschwindet nach Westen.\n");
  this_player()->move(ROOM "tem1-7", M_TPORT);
  return 1;
}

int betreten(string str)
{
 object ninvis1;
 object ninvis2;
 object ninvis3;
 object ninvis4;
 object ninvis5;
 object ninvis6;

 notify_fail("Welchen Buchstaben moechtest Du betreten? \n");

 if(!str || str == "") return 0;
 if(!(str == "a" ||
      str == "b" ||
      str == "c" ||
      str == "d" ||
      str == "e" ||
      str == "f" ||
      str == "g" ||
      str == "h" ||
      str == "i" ||
      str == "j" ||
      str == "k" ||
      str == "l" ||
      str == "m" ||
      str == "n" ||
      str == "o" ||
      str == "p" ||
      str == "q" ||
      str == "r" ||
      str == "s" ||
      str == "t" ||
      str == "u" ||
      str == "v" ||
      str == "w" ||
      str == "x" ||
      str == "y" ||
      str == "z" )) return 0;
 

 if( str == "c"){
    
  if(present("ninvis1", TP)){
	  
  write(BS("Du befindest Dich auf dem Buchstaben C oder warst dort schon und "
           "zurueck willst Du ja nicht.\n"));
  return -1;
  }
  write(BS("Du betrittst die Steinplatte mit dem Buchstaben C und sie "
           "scheint zu halten.\n"));
 
  say(TPN+" betritt die erste richtige Platte, wirkt aber immer noch sehr nervoes.\n");
  ninvis1=clone_object(OBJ "ninvis1")->move(TP, M_NOCHECK);
  return 1;
 }

 if( str == "h"){
 
  if(!present("ninvis1", TP)){
	  
  write(BS("Bis zu diesem Buchstaben kommst Du ja noch gar nicht!\n"));
 
  say(TPN+" stellt sich dumm an.\n");
  return -1;
  }
  if(present("ninvis2", TP)){
	  
  write(BS("Du befindest Dich auf dem Buchstaben H oder warst dort schon und "
           "zurueck willst Du ja nicht.\n"));
  return -1;
  }
  write(BS("Du betrittst die Steinplatte mit dem Buchstaben H und sie haelt. "
           "Du wischst Dir den Schweiss von der Stirn.\n"));
 
  say(TPN+" betritt eine weitere Platte auf dem Boden.\n");
  ninvis2=clone_object(OBJ "ninvis2")->move(TP, M_NOCHECK);
  return 1;
 }

 if( str == "i"){
 
  if(!present("ninvis2", TP)){
	  
  write(BS("Bis zu diesem Buchstaben kommst Du ja noch gar nicht!\n"));
 
  say(TPN+" stellt sich dumm an.\n");
  return -1;
  }
  if(present("ninvis3", TP)){
	  
  write(BS("Du befindest Dich auf dem Buchstaben I oder warst dort schon und "
           "zurueck willst Du ja nicht.\n"));
  return -1;
  }
  write(BS("Du betrittst die Steinplatte mit dem Buchstaben I und sie haelt. "
           "Du wischst Dir den Schweiss von der Stirn.\n"));
 
  say(TPN+" betritt eine weitere Platte auf dem Boden.\n");
  ninvis3=clone_object(OBJ "ninvis3")->move(TP, M_NOCHECK);
  return 1;
 }

 if( str == "v"){
 
  if(!present("ninvis3", TP)){
	  
  write(BS("Bis zu diesem Buchstaben kommst Du ja noch gar nicht!\n"));
 
  say(TPN+" stellt sich dumm an.\n");
  return -1;
  }
  if(present("ninvis4", TP)){
	  
  write(BS("Du befindest Dich auf dem Buchstaben V oder warst dort schon und "
           "zurueck willst Du ja nicht.\n"));
  return -1;
  }
  write(BS("Du betrittst die Steinplatte mit dem Buchstaben V und sie haelt. "
           "Du wischst Dir den Schweiss von der Stirn.\n"));
 
  say(TPN+" betritt eine weitere Platte auf dem Boden.\n");
  ninvis4=clone_object(OBJ "ninvis4")->move(TP, M_NOCHECK);
  return 1;
 }

 if( str == "a"){
 
  if(!present("ninvis4", TP)){
	  
  write(BS("Bis zu diesem Buchstaben kommst Du ja noch gar nicht!\n"));
 
  say(TPN+" stellt sich dumm an.\n");
  return -1;
  }
  if(present("ninvis5", TP)){
	  
  write(BS("Du befindest Dich auf dem Buchstaben A oder warst dort schon und "
           "zurueck willst Du ja nicht.\n"));
  return -1;
  }
  write(BS("Du betrittst die Steinplatte mit dem Buchstaben A und sie haelt. "
           "Du wischst Dir den Schweiss von der Stirn.\n"));
 
  say(TPN+" betritt eine weitere Platte auf dem Boden.\n");
  ninvis5=clone_object(OBJ "ninvis5")->move(TP, M_NOCHECK);
  return 1;
 }

 if( str == "s"){
 
  if(!present("ninvis5", TP)){
	  
  write(BS("Bis zu diesem Buchstaben kommst Du ja noch gar nicht!\n"));
 
  say(TPN+" stellt sich dumm an.\n");
  return -1;
  }
  write(BS("Du betrittst die letzte Platte und bist erleichtert das "
           "sie haelt. Mit einem letzten Sprung bist Du wieder auf "
           "festem Boden und kannst nun nach Westen gehen.\n"));
 
  say(TPN+" betritt die letzte richtige Platte im Westen und hat die "
          "Platten ueberwunden\n");
  ninvis6=clone_object(OBJ "ninvis6")->move(TP, M_NOCHECK);
  return 1;
 }

 if( str == "b" ||
     str == "d" ||
     str == "e" ||
     str == "f" ||
     str == "g" ||
     str == "j" ||
     str == "k" ||
     str == "l" ||
     str == "m" ||
     str == "n" ||
     str == "o" ||
     str == "p" ||
     str == "q" ||
     str == "r" ||
     str == "t" ||
     str == "u" ||
     str == "w" ||
     str == "x" ||
     str == "y" ||
     str == "z"){

  write(BS("Du betrittst eine falsche Platte und faellst schreiend in die Tiefe.\n"));
 
  say(TPN+" tritt auf eine falsche Platte und verschwindet schreiend im Boden.\n");
    this_player()->move(ROOM "tem48", M_TPORT);
    TP->AddHp(-50);
  return 1;
 }
}
