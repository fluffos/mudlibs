// von Chivas
inherit "std/room";

#include "../def.h"

void create()
	
{
  ::create();


  SetProp( P_INT_SHORT, "In einem Tempel");
  SetProp( P_INT_LONG,
        "Eine weitere grosse Halle breitet sich vor Dir aus. Diesmal haengen "
        "keine Fackeln an der Wand, die die Halle erhellen. In der Mitte der "
	"Halle, in einem von Steinbloecken umgebenen Kreis, ist eine "
        "riesengrosse roetliche Flamme. Um die Flamme herum knien ein paar "
        "dunkle Gestalten. " );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 35, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  
  AddDetail( ({"halle"}), 
            "Die Halle ist wirklich gross. In ihrer Mitte brennt eine "
            "grosse Flamme.");

  AddDetail( ({"fackeln"}),
	    "Es sind keine Fackeln zu sehen. Die Halle wird nur durch die "
            "grosse Flamme in der Mitte erhellt.");

  AddDetail( ({"wand","waende","waenden"}),
	    "An den Waenden erkennst Du Wandteppiche, die ausnahmsweise noch "
            "nicht zerstoert sind und keinerlei Loecher oder Risse aufweisen.");

  AddDetail( ({"mitte","mittelpunkt"}), 
            "In der Mitte der Halle bilden Steinbloecke einen Kreis, wo im "
            "Mittelpunkt eine grosse Flamme aus dem Boden kommt.");

  AddDetail( ({"steinbloecken","steinbloecke","bloecke","rest"}),
	    "Die Steinbloecke sind in Kreisform um die Flamme angeordnet und "
            "trennen die Flamme mit den vor ihr knieenden Gestalten vom Rest "
            "der Halle ein wenig ab.");

  AddDetail( ({"kreis","kreisform"}),
	    "Es sieht so aus, als ob der Kreis von Steinbloecken die Flamme "
            "von der restlichen Halle abtrennt."); 
  
  AddDetail( ({"flamme"}), 
            "Die Flamme brennt vom Boden bis fast an die Decke. Sie leuchtet "
            "in einem roetlichen Licht und heizt die ganze Halle auf. Direkt "
            "in der Flamme kannst Du Etwas erkennen.");

  AddDetail( ({"gestalten"}),
	    "Die Gestalten scheinen zu der Flamme zu beten.");

  AddDetail( ({"boden"}),
	    "Am Boden liegen Steinplatten, die bis zu dem Kreis aus "
            "Steinbloecken verlaufen. In der Mitte der Halle brennt eine "
            "riesige Flamme direkt aus dem Boden.");

  AddDetail( ({"decke","himmel"}), 
            "Die Decke ist sehr schmutzig, da die Flamme immer wieder hinauf "
            "zuengelt.");

  AddDetail( ({"wandteppiche","teppiche","teppich"}),
	    "Die Wandteppiche zeigen die grosse Flamme und ein Wesen, dass "
            "aus purem Feuer besteht.");

  AddDetail( ({"loecher","risse","zustand"}),
	    "Die Wandteppiche sind im besten Zustand."); 
  
  AddDetail( ({"etwas"}), 
            "Es scheint eine Kreatur direkt in der Flamme zu schweben.");

  AddDetail( ({"kreatur"}),
	    "Die Kreatur scheint sich sehr wohl in den Flammen zu fuehlen. "
            "Die Kreatur kommt Dir irgendwie bekannt vor. Sie hat Hoerner und "
            "scheint selbst aus Feuer zu bestehen. Es scheint jedoch erst "
            "ein kleines Exemplar zu sein.");

  AddDetail( ({"feuer","hoerner"}),
	    "Du ueberlegst, welche Kreatur aus reinem Feuer besteht und dazu "
            "noch Hoerner hat.");

  AddDetail( ({"exemplar","schuppen","augen","schauspiel"}), 
            "Dir faellt es wie Schuppen von den Augen, es scheint ein kleiner "
            "Balrog zu sein, der hier in der Flamme geboren wird. Ein "
            "erstaunliches Schauspiel.");

  AddDetail( ({"balrog"}),
	    "Er ist noch recht klein, aber Du weisst, dass er einmal stark "
            "und boese sein wird. Spaeter willst Du ihm ungerne begegnen.");

  AddDetail( ({"wesen","wesens"}),
	    "Das Wesen auf den Teppichen sieht boese und gefaehrlich aus. Es "
            "haelt auf den Teppichen eine Peitsche in der Hand, die auch aus "
            "Feuer zu bestehen scheint."); 
  
  AddDetail( ({"peitsche","hand","waffe"}), 
            "Die Peitsche in der Hand des Wesens ist sicher eine starke "
            "Waffe.");

  AddDetail( ({"licht","lichtquellen"}),
	    "Das Licht in der Halle stammt von der Flamme, ansonsten gibt "
            "es keinerlei Lichtquellen.");

  AddDetail( ({"steinplatten","platten","vergleich"}),
	    "Die Steinplatten sind uninteressant im Vergleich mit der Flamme.");

  AddSmell(DEFAULT_SMELL, "Es riecht nach Rauch.");  
 
  AddSmell( ({"rauch"}),
	   "Der Rauch kommt von der Flamme.");

  AddSound(DEFAULT_SOUND, "Du hoerst das Flackern und Zischen der grossen "
                          "Flamme in der Mitte der Halle.");

  AddSound( ({"flackern","zischen","flamme"}),
	   "Das Flackern und Zischen ist schon fast ein Tosen.");

  AddSound( ({"tosen"}),
	   "Das Tosen ist fast ohrenbetaeubend.");
  
//-----Details Ende-----
  
AddExit("norden", ROOM "tem41");
AddExit("nordosten", ROOM "tem41");
AddExit("nordwesten", ROOM "tem41");
AddExit("osten", ROOM "tem41");
AddExit("westen", ROOM "tem46");
AddExit("suedosten", ROOM "tem41");
AddExit("suedwesten", ROOM "tem41");
AddExit("sueden", ROOM "tem44");

}

