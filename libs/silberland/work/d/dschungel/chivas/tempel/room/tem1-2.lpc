// von Chivas
inherit "std/room";

#include "../def.h"

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Tempel");
  SetProp( P_INT_LONG,
        "Der Gang biegt nun nach Westen in das Innere des Tempels ab. An der "
        "Ostwand ist ein letztes Fenster zu sehen, durch das wie auf fast der "
        "der ganzen Ebene kaum Licht eindringt. An der Nordwand haengt ein "
        "grosses Gemaelde. " );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"gang","westen","innere"}), 
            "Der Gang biegt in das Innere des Tempels ab. Was Dich da wohl "
            "erwarten wird.");

  AddDetail( ({"tempel","tempels"}),
	    "Du bist auf der ersten Ebene im Tempel.");

  AddDetail( ({"ostwand"}),
	    "An der Ostwand ist ein grosses Fenster, durch das jedoch nicht "
            "viel Licht einfaellt.");

  AddDetail( ({"fenster"}), 
            "Das Fenster ist wie fast auf der ganzen Ebene mit einem magischen "
            "Schleier belegt, so dass kaum Licht in den Tempel eindringt.");

  AddDetail( ({"ebene"}),
	    "Du befindest Dich auf der ersten Ebene im Tempel 'Iaun en "
            "Sereg'.");

  AddDetail( ({"licht"}),
	    "Das Licht erhellt den Gang laum. Es ist recht duester."); 
  
  AddDetail( ({"nordwand"}), 
            "An der Nordwand haengt ein grosses altes Gemaelde.");

  AddDetail( ({"gemaelde","gemaeldes"}),
	    "Das Gemaelde zeigt einen grossen roten Drachen, der auf einem "
            "riesigen Schatz sitzt und ihn zu verteidigen scheint. Der Rahmen "
            "des Gemaeldes scheint aus Gold zu sein.");

  AddDetail( ({"wand","waende"}),
	    "Welche Wand meinst Du?");

  AddDetail( ({"boden"}), 
            "Der Boden besteht aus grossen Steinplatten.");

  AddDetail( ({"decke","himmel"}),
	    "Die Decke ist schmucklos.");

  AddDetail( ({"schleier"}),
	    "Ein magischer milchiger Schleier liegt ueber dem Fenster und "
            "laesst kaum Licht in das Innere des Tempels."); 
  
  AddDetail( ({"iaun en sereg","iaun","sereg","blutes","blut","name"}), 
            "'Iaun en Sereg' ist der Tempel des Blutes. Ein wirklich nicht "
            "sehr schoener Name. Du schluckst.");

  AddDetail( ({"drache","drachen"}),
	    "Der rote Drache auf dem Gemaelde sieht sehr gefaehrlich aus. Du "
            "willst ihm nicht begegnen.");

  AddDetail( ({"schatz"}),
	    "Der Schatz sieht schon sehr verlockend aus. Lauter Goldmuenzen, "
            "Edelsteine und Perlen scheinen den Schatz zu bilden.");

  AddDetail( ({"rahmen","rahmens"}), 
            "Der Rahmen besteht aus Gold, was Dich jedoch nicht sehr "
            "interessiert. Viel interessanter ist der kleine Hebel, der direkt "
            "neben dem Rahmen haengt.");

  AddDetail( ({"gold"}),
	    "Das Gold des Rahmens ist sicher viel wert. Leider ist der Rahmen "
            "zu schwer, um ihn mitzunehmen.");

  AddDetail( ({"goldmuenzen"}),
	    "Sie glitzern sogar auf dem Gemaelde."); 
  
  AddDetail( ({"edelsteine"}), 
            "Du erkennst Smaragde, Rubine, Diamanten und Saphire.");

  AddDetail( ({"hebel"}),
	    "Vielleicht kann man den Hebel ziehen, obwohl es in einem solchen "
            "Tempel nicht besonders ratsam ist, einfach Hebel zu "
            "ziehen, dessen Auswirkung man nicht kennt.");

  AddDetail( ({"smaragde","rubine","diamanten","saphire"}),
	    "Diese Edelsteine gefallen Dir.");

  AddDetail( ({"steinplatten","platten"}), 
            "Die grossen Steinplatten am Boden sind mit einer leichten "
            "Staubschicht bedeckt.");

  AddDetail( ({"auswirkung"}),
	    "Die Auswirkung kann hier im Tempel auch sehr negativ sein.");

  AddDetail( ({"staub","staubschicht","schicht"}),
	    "Im Staub kann man ein paar Spuren erkennen."); 
  
  AddDetail( ({"spuren"}), 
            "Du weisst nicht, ob sie von jemand anderem oder nur von Dir "
	    "stammen.");

  AddDetail( ({"perlen"}),
	    "Die Perlen sind so gross wie Trollfaeuste.");

  AddDetail( ({"faeuste","trollfaeuste"}),
	    "Sie sind riesig.");

  AddSmell(DEFAULT_SMELL, "Es riecht nach gar nichts, ausser nach ein wenig "
                          "Staub.");  
 
  AddSmell( ({"staub"}),
	   "Der Staub riecht ueberhaupt nicht.");

  AddSound(DEFAULT_SOUND, "Es ist genau so still wie in der Kammer im Sueden.");

  AddSound( ({"sueden","kammer"}),
	   "Es ist totenstill.");
  
//-----Details Ende-----
  
AddExit("westen", ROOM "tem1-1");
AddExit("sueden", ROOM "tem1-3");

AddCmd( ({"zieh", "ziehe" }), "ziehen" );

}
int ziehen(string str)
{
   notify_fail("Was moechtest Du ziehen?\n");
   if ( member( ({ "an hebel", "hebel" }),str) != -1) 
  {
    write(BS( "Du ziehst wagemutig an dem Hebel und ploetzlich oeffnet sich unter "
           "Dir eine Falltuer. Du faellst eine Roehre herunter und knallst "
           "voller Wucht auf den Boden.\n"));
    say( TPN+" verschwindet durch eine Falltuer.\n");
    TP->AddHp(-50);
    this_player()->move(ROOM "temz1", M_TPORT);
    say( TPN+" verschwindet durch eine Falltuer.\n");
    return 1;
  }
}

