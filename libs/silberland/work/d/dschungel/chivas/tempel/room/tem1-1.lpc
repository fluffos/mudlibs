// von Chivas
inherit "std/room";

#include "../def.h"

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Tempel");
  SetProp( P_INT_LONG,
        "Du stehst mitten in einer grossen kreisrunden Kammer. An den Waenden "
        "haengen Fackeln, die die Kammer mit ihren gruenlichen Flammen "
        "erhellen. Am Boden ist ein Mosaik zu erkennen und von der Decke "
        "haengt eine grosse rostige Kette." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----

  AddDetail( ({"kammer"}), 
            "Du stehst in einer kreisrunden Kammer in der Mitte des Tempels.");

  AddDetail( ({"waenden","waende","wand"}),
	    "An den kahlen Waenden haengen einige Fackeln in ihren "
            "Halterungen.");

  AddDetail( ({"fackeln"}),
	    "Die Fackeln an der Wand spenden ein wenig Licht mit ihren "
            "gruenlichen Flammen.");

  AddDetail( ({"flammen"}), 
            "Die Flammen flackern in einem gruenlichen Licht, die von einem "
            "kleinen Windzug in Bewegung geraten sind.");

  AddDetail( ({"boden"}),
	    "Am Boden ist ein wunderschoenes Mosaik unter einer leichten "
            "Staubschicht zu erkennen.");

  AddDetail( ({"mosaik"}),
	    "Das Mosaik, welches aus kleinen Steinchen zusammengesetzt ist, "
            "zeigt den Tempel in seiner Bluetezeit."); 
  
  AddDetail( ({"decke","himmel"}), 
            "An der Decke ist ein grosses Loch, durch das eine Kette bis auf "
            "den Boden haengt.");

  AddDetail( ({"kette"}),
	    "An der alten rostigen Kette, die von der Decke haengt, kann man "
            "sicher rauf klettern.");

  AddDetail( ({"loch"}),
	    "Durch das Loch kommt man sicher auf die zweite Ebene im Tempel.");

  AddDetail( ({"ebene"}), 
            "Du bist auf der ersten Ebene und kannst hier wohl an der Kette "
            "auf die zweite Ebene rauf klettern.");

  AddDetail( ({"tempel","tempels"}),
	    "Du bist mitten im Tempel und kannst wohl in dieser Kammer eine "
            "Ebene nach oben klettern.");

  AddDetail( ({"mitte"}),
	    "Es muesste jedenfalls die Mitte des Tempels sein, wenn Du nicht "
            "Deinen Orientierungssinn verloren hast."); 
  
  AddDetail( ({"orientierungssinn"}), 
            "Dein Orientierungssinn hat Dich sicher nicht getaeuscht.");

  AddDetail( ({"bewegung","windzug"}),
	    "Du spuerst einen kleinen Windzug durch das Loch in der Decke "
            "kommen, der die Fackeln zum flackern bringt.");

  AddDetail( ({"licht"}),
	    "Ein wenig Licht von den Fackeln erhellt die Kammer.");

  AddDetail( ({"steinchen"}), 
            "Verschieden farbige Steinchen bilden ein grosses Mosaik am "
            "Boden.");

  AddDetail( ({"bluetezeit","zeit"}),
	    "Das Mosaik zeigt den Tempel in der Bluetezeit. Er sieht finster "
            "und boese aus und der umrandete Dschungel hat noch einen grossen "
            "Abstand vom Tempel.");

  AddDetail( ({"halterungen"}),
	    "Die Halterungen sind schmucklos und bestehen aus Eisen."); 
  
  AddDetail( ({"dschungel","abstand"}), 
            "Der Dschungel war in der Bluetezeit des Tempels weit weg vom "
            "Tempel. Erst in den letzten Jahrzehnten hatte sich der Dschungel "
            "wieder herangekaempft.");

  AddDetail( ({"jahrzehnten"}),
	    "Dies ist lange her.");

  AddDetail( ({"eisen","jahre"}),
	    "Das Eisen ist ein wenig rostig. Dennoch werden sie wohl noch "
            "Jahre die Fackeln halten koennen.");

  AddDetail( ({"staubschicht","staub","schicht","blick"}), 
            "Die kleine Schicht aus Staub, die sich auf dem Boden angesammelt "
            "hat, verhindert nicht den Blick auf das Mosaik.");

  AddSmell(DEFAULT_SMELL, "Es riecht ein wenig faulig vom oben durch das "
                          "Loch.");  
 
  AddSmell( ({"loch"}),
	   "Da solltest Du schon nach oben klettern.");

  AddSound(DEFAULT_SOUND, "Du hoerst einen leichten Windzug, der durch das "
                          "Loch in der Decke kommt.");

  AddSound( ({"windzug"}),
	   "Der Windzug bringt die Fackeln zum flackern, was recht beruhigend "
           "klingt.");
  
//-----Details Ende-----
AddItem(NPC "golemk", REFRESH_DESTRUCT);
  
AddExit("osten", ROOM "tem1-2");

AddCmd( ({"kletter", "klettere" }), "klettern" );

}
int klettern(string str)
{
   notify_fail("Woran moechtest Du wohin klettern?\n");
   if ( member( ({ "an kette", "an kette nach oben","an kette rauf" }),str) != -1) 
  {
    write( "Du kletterst an der Kette nach oben.\n");
    TP->move(ROOM "tem2-1", M_GO, "nach oben", "klettert",
    "kommt heraufgeklettert");
    return 1;
  }
}

