// von Chivas
inherit "std/room";

#include "../def.h"

int raupeda;

void create()
	
{
  ::create();

   raupeda=1; 

  SetProp( P_INT_SHORT, "Auf einem Dschungelpfad");
  SetProp( P_INT_LONG,
        "Der Pfad ist hier wirklich schlecht, ueberall haengen Schlingpflanzen "
        "von den Baeumen und stoeren die Sicht in alle Richtungen. Der Himmel "
        "ist kaum zu sehen, da das Blaetterdach sehr dicht ist. Auf dem kaum "
	"erkennbaren Pfad liegt ein umgestuerzter Baumstamm. " );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 30, ENV_TERRAIN: TT_JUNGLE]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  
  AddDetail( ({"pfad"}), 
            "Der Pfad fuehrt von Norden nach Suedosten. Genau auf dem Pfad "
            "liegt ein umgefallener Baumstamm.");

  AddDetail( ({"norden","strand"}), 
            "Nach Norden fuehrt der Pfad wieder in Richtung Strand.");

  AddDetail( ({"suedosten"}), 
            "Nach Suedosten geht es weiter in den Dschungel hinein.");

  AddDetail( ({"schlingpflanzen"}),
	    "Viele Schlingpflanzen haengen von den grossen Baeumen herab und "
            "stoeren Dich beim Vorankommen.");

  AddDetail( ({"baeumen","baeume"}),
	    "Die Baeume, die neben dem Pfad stehen, machen ein Abweichen vom "
            "Pfad unmoeglich.");

  AddDetail( ({"sicht"}), 
            "Die Sicht ist recht schlecht, da ueberall Schlingpflanzen von "
            "den Baeumen haengen und recht wenig Licht durch das dichte "
            "Blaetterdach dringt.");

  AddDetail( ({"richtungen","richtung"}),
	    "Die Richtungen, in die Du gehen kannst, werden von dem dichten "
            "Dschungel vorgegeben.");

  AddDetail( ({"himmel"}),
	    "Der Himmel ist nur ab und zu mal zu sehen, wenn der Wind das "
            "Blaetterdach ein wenig bewegt."); 
  
  AddDetail( ({"blaetterdach","dach","blick"}), 
            "Das Blaetterdach ist ziemlich dicht und laesst kaum Licht durch. "
            "Nur durch ein wenig Wind sind die Blaetter in Bewegung und lassen "
            "ab und zu einmal einen Blick auf den Himmel zu.");

  AddDetail( ({"dschungel"}),
	    "Du bist mittendrin.");

  AddDetail( ({"pflanzen"}),
	    "Du kennst die Pflanzen nicht.");

  AddDetail( ({"baumstamm","stamm","baumstaemmen"}),
	    "Ein Baumstamm liegt quer ueber den Pfad. Er muss hier schon recht "
            "lange liegen, da er mit viel Moos bewachsen ist. Er behindert "
            "Dich nicht daran, weiter zu gehen.");

  AddDetail( ({"boden"}), 
            "Am Boden siehst Du einige Pflanzen und verschiedene Blumen. "
            "Ausserdem liegt ein Baumstamm quer vor Dir.");

  AddDetail( ({"blumen"}),
	    "Viele Blumen kennst Du nicht, aber ein paar schoene Orchideen "
            "fallen Dir auf.");

  AddDetail( ({"moos"}),
	    "Das Moos bedeckt fast den ganzen Baumstamm. Nur an einigen "
            "Stellen waechst kein Moos."); 
  
  AddDetail( ({"rinde"}), 
            "Die Rinde ist morsch und weisst ein paar Loecher auf.");

  AddDetail( ({"loecher"}),
	    "Die kleinen Loecher stammen anscheinend von verschiedenen "
            "Insekten, die ihre Behausungen in dem Stamm haben. Ein Loch "
            "faellt Dir besonders auf.");

  AddDetail( ({"loch"}),
	    "Ein Loch ist ein wenig groesser als die anderen. Wenn Du mutig "
            "genug bist, weisst Du was Du zu tun hast.");

  AddDetail( ({"orchideen","orchidee"}), 
            "Du siehst einige Orchideen der Art Cymbidium und welche von der "
            "Art Phalaenopsis. Du bist wirklich gebildet.");

  AddDetail( ({"art","arten"}),
	    "Es gibt verschiedene Arten von Orchideen.");

  AddDetail( ({"cymbidium"}),
	    "Das Cymbidium kommt in den tropischen Gebieten des Silberlandes "
            "und auf einigen Inseln vor. Es waechst zwischen Felsen, Blaettern "
            "und umgefallenen Baumstaemmen. "); 
  
  AddDetail( ({"phalaenopsis","schmetterlingsorchidee"}), 
            "Der Phalaenopsis wird auch Schmetterlingsorchidee genannt. ");

  AddDetail( ({"vorankommen"}),
	    "Es wird immer schwieriger vorwaerts zu kommen.");

  AddDetail( ({"abweichen"}),
	    "Durch die Baeume und Straeucher musst Du auf dem Pfad bleiben.");

  AddDetail( ({"straeucher","straeuchern"}), 
            "Die Straeucher haben ganz normale Blaetter, mehr scheint an den "
            "Straeuchern nicht zu sein. Du bist halt kein Experte was "
            "Straeucher betrifft.");

  AddDetail( ({"blaetter"}),
	    "Es sind ueberall Blaetter an den Baeumen und Straeuchern zu "
            "sehen.");

  AddDetail( ({"licht"}),
	    "Das Licht ist schlecht und der Himmel kaum zu erkennen."); 
  
  AddDetail( ({"bewegung","wind","bewegungen"}), 
            "Du siehst den Wind durch die Bewegungen der Blaetter weiter oben. "
            "Hier unten ist es windstill.");

  AddDetail( ({"stelle","stellen"}),
	    "Die Rinde hat an einigen Stellen ein paar Loecher.");

  AddDetail( ({"insekten"}),
	    "Momentan siehst Du keine Insekten, aber Du bist sicher, dass es "
            "im Dschungel welche gibt.");

  AddDetail( ({"behausungen","behausung"}), 
            "Fuer Dich waere es keine adequate Behausung, aber jeder wie er "
            "will.");

  AddDetail( ({"silberland","silberlandes"}),
	    "Du bist im Silberland."); 

  AddDetail( ({"inseln","insel"}),
	    "Im Silberland gibt es einige."); 

  AddDetail( ({"felsen"}),
	    "Zwischen den Straeuchern sind ein paar kleine Felsen, aber ausser "
            "den Orchideen ist nichts zu sehen."); 

  AddDetail( ({"experte"}),
	    "Du waerst gerne einer!"); 

  AddDetail( ({"definition","beschreibung","gebieten","sueden"}),
	    "Du untersuchst wirklich alles."); 
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Pflanzen im Dschungel.");  
 
  AddSmell( ({"pflanzen"}),
	   "Es riecht irgendwie pflanzig. Dies ist die einzige Definition, "
           "die Dir einfaellt.");

  AddSmell( ({"dschungel"}),
	   "Es riecht dschungelig. Dies ist eine korrekte Beschreibung.");

  AddSound(DEFAULT_SOUND, "Du hoerst den Wind im Blaetterdach.");

  AddSound( ({"wind"}),
	   "Es ist mehr ein Rauschen durch die Blaetter.");

  AddSound( ({"rauschen","blaetter"}),
	   "Es wirkt sehr beruhigend.");
  
//-----Details Ende-----
  
AddExit("norden", ROOM "tem4");
AddExit("suedosten", ROOM "tem6");

AddCmd( ({"greifen", "greife","greif" }), "greifen" );

}
void reset()
{
  ::reset();
  raupeda=1;
}

int greifen(string str)
{
  object raupe;
  notify_fail ("Worein moechtest Du greifen?\n");

  if(!(str == "in loch" )) return 0;
  if (present("CHIVASRAUPE",TO) || !raupeda)

  {
    write(BS("Du findest gerade nichts."));
    return -1;
  }
  write(BS("Du greifst in das Loch und holst eine grosse Raupe aus dem Loch, "
           "die Du angewiedert fallen laesst.\n"));
  raupeda=0;
  raupe = clone_object (NPC "raupe.lpc" );
  raupe->move(TO,M_GO|M_NOCHECK,"krabbelt");
  return 1;
}

