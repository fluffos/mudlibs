// von Chivas
inherit "std/room";

#include "../def.h"

void create()
	
{
  ::create();


  SetProp( P_INT_SHORT, "An einem Tempel im Dschungel");
  SetProp( P_INT_LONG,
        "Der Pfad macht hier eine Richtungsaenderung nach Suedosten, da die "
        "nordoestliche Ecke des Tempels erreicht ist. Hier stehen einige "
	"grossen Steinstatuen, die keinen freundlichen Eindruck machen. Der "
        "Dschungel neben dem Pfad ist sehr dicht und draengt Dich sehr nahe an "
        "den Tempel." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_JUNGLE]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  
  AddDetail( ({"pfad"}), 
            "Der Pfad aendert an der Ecke seine Richtung nach Suedosten. Er "
            "wird sehr schmal und fuehrt sehr eng am Tempel vorbei.");

  AddDetail( ({"ecke"}),
	    "An der Ecke stehen grosse Steinstatuen. Der Pfad fuehrt ganz nahe "
            "an ihnen vorbei.");

  AddDetail( ({"richtungsaenderung","aenderung","suedosten","richtung"}),
	    "Die Richtung wechselt nach Suedosten.");

  AddDetail( ({"tempels","tempel"}), 
            "Der Tempel ist ein wenig zugewachsen. An seiner Ecke stehen "
            "grosse Steinstatuen.");

  AddDetail( ({"steinstatuen","statuen"}),
	    "Die Steinstatuen sind mehrere Meter gross und sie sehen stark "
            "und gefaehrlich aus. Vor allem die Gesichter und Haende "
            "beunruhigen Dich.");

  AddDetail( ({"eindruck"}),
	    "Dein erster Eindruck hat Dich noch nie getaeuscht."); 
  
  AddDetail( ({"dschungel"}), 
            "Der Dschungel ist sehr dicht und draengt den Pfad und damit auch "
            "Dich sehr nah an den Tempel.");

  AddDetail( ({"boden"}),
	    "Am Boden liegen viele Blaetter, die von den Baeumen und Pflanzen "
            "abgefallen sind.");

  AddDetail( ({"steine"}),
	    "Die Steine sind uninteressant. Die Knochen dagegen nicht.");

  AddDetail( ({"blaetter","blaettern"}), 
            "Zwischen den Blaettern erkennst Du ein paar Steine und was viel "
            "schlimmer ist, Knochen.");

  AddDetail( ({"knochen"}),
	    "Die Knochen sind ausgebleicht und liegen zu Fuessen der Statuen.");

  AddDetail( ({"fuessen","fuesse"}),
	    "Die Fuesse sind riesig, aber sie interessieren Dich nicht."); 
  
  AddDetail( ({"gesichter"}), 
            "Die Gesichter sehen grimmig aus, aber es scheint so, als ob man "
            "auch ein Grinsen sehen kann.");

  AddDetail( ({"haende","meter"}),
	    "Die Haende sehen so aus, als ob sie jeden Moment zugreifen "
            "koennten. Sie sind genau auf der Hoehe von Deinem Hals. Du "
            "schluckst.");

  AddDetail( ({"grinsen"}),
	    "Das Grinsen der Statuen weckt nicht gerade Vertrauen in Dir.");

  AddDetail( ({"pflanzen"}), 
            "Es gibt unzaehlige verschiedene Pflanzen am Rand des Pfades.");

  AddDetail( ({"baeume","baeumen"}),
	    "Die Baeume stehen sehr dicht.");

  AddDetail( ({"vertrauen"}),
	    "Vertrauen hat schon zu so manchem Tod gefuehrt."); 
  
  AddDetail( ({"tod","ohr","komm","schon"}), 
            "Tod fluestert Dir ins Ohr: KOMM SCHON! ;)");

  AddDetail( ({"hoehe","hals","halses"}),
	    "Ob es etwas zu bedeuten hat, dass die Haende in der Hoehe Deines "
            "Halses sind?");

  AddDetail( ({"rand"}),
	    "Du siehst alle moeglichen Pflanzen. Du kennst kaum welche.");

  AddDetail( ({"himmel"}), 
            "Der Himmel scheint blau zu sei, obwohl Du ihn nicht so gut sehen "
            "kannst, da das Blaetterdach sehr dicht ist.");

  AddDetail( ({"blaetterdach","dach"}),
	    "Das Blaetterdach der Baeume ist sehr dicht.");

  AddDetail( ({"moment"}),
	    "Der Moment wird sicher kommen, wo Du Tod wieder begegnest."); 
  
  AddSmell(DEFAULT_SMELL, "Du riechst die Pflanzen im Dschungel.");  
 
  AddSmell( ({"pflanzen","dschungel","blumen"}),
	   "Die Pflanzen duften nach Blumen und anderen Pflanzen.");

  AddSound(DEFAULT_SOUND, "Du hoerst die Voegel im Dschungel zwitschern.");

  AddSound( ({"voegel","dschungel"}),
	   "*tschip*tschip*tschip*triller*tschip*tschip*tschip*");
  
//-----Details Ende-----
  
AddExit("westen", ROOM "tem11");
AddSpecialExit( "suedosten", "go_suedosten" );

AddCmd( ({"draeng", "draenge" }), "draengen" );

}
int draengen(string str)
{
   notify_fail("An was moechtest Du Dich vorbei draengen?\n");
   if ( member( ({ "an statue vorbei" }),str) != -1) 
  {
    write(BS( "Du draengst Dich an der Statue vorbei, als sie ploetzlich "
           "versucht Dich zu ergreifen. Du duckst Dich im letzten Moment und "
           "schluepfst vorbei.\n"));
    say( TPN+" verschwindet nach Suedosten.\n");
    this_player()->move(ROOM "tem13", M_TPORT);
    return 1;
  }
}

int go_suedosten(string dir)
{

  if(!(present("chivas", TP)))
  {
    write( BS( "Du willst nach Suedosten gehen, aber kannst es nicht so "
               "einfach. Die einzige Moeglichkeit ist wohl sich an den "
               "Statuen vorbei zu draengen.") );
    say(TP->Name(WEN)+" kommt nicht so einfach nach Suedosten.\n");
  return -1;
  }
  write(BS("Du gehst weiter nach Suedosten.\n"));
 
  say(TPN+" verschwindet nach Surdosten.\n");
  this_player()->move(ROOM "tem13", M_TPORT);
  return 1;
}

