// von Chivas
inherit "std/room";

#include "../def.h"

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "An einem Tempel im Dschungel");
  SetProp( P_INT_LONG,
        "An der nordoestlichen Ecke des Tempels sind grosse Statuen zu  "
        "erkennen, die nicht gerade einen netten Eindruck machen. Der Pfad "
	"fuehrt nach Nordwesten wieder zum Tor des Tempels oder nach Sueden um "
        "den Tempel rum. Der Dschungel ist sehr dicht und hat sich in den "
        "letzten Jahren immer naeher an den Tempel herangekaempft. " );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 30, ENV_TERRAIN: TT_JUNGLE]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );
  
//-----Details Anfang-----
  
  AddDetail( ({"ecke"}), 
            "An der Ecke stehen grosse Statuen, die viel groesser sind als "
            "Du.");

  AddDetail( ({"statuen"}),
	    "Die Statuen sind wirklich haesslich und ihre Gesichter sehen "
            "grimmig aus.");

  AddDetail( ({"eindruck","beste"}),
	    "Der Eindruck, den die Statuen machen, ist nicht der Beste.");

  AddDetail( ({"pfad","pfades"}), 
            "Der Pfad wird an der Ecke recht schmal und verlaeuft ganz nahe "
            "an den Statuen vorbei.");

  AddDetail( ({"nordwesten"}),
	    "Der Pfad fuehrt nach Nordwesten zum Tor des Tempels.");

  AddDetail( ({"tor"}),
	    "Das Tor ist nordwestlich von Dir."); 
  
  AddDetail( ({"tempel","tempels"}), 
            "Der Tempel ist riesig. Das Erdgeschoss nimmt sehr viel Platz ein "
            "und ausserdem siehst Du noch drei weitere Ebenen und eine "
            "Spitze.");

  AddDetail( ({"sueden"}),
	    "Wenn Du nach Sueden gehst, kannst Du den Tempel noch weiter "
            "umrunden.");

  AddDetail( ({"dschungel"}),
	    "Der Dschungel ist recht nahe an den Tempel heran gewachsen.");

  AddDetail( ({"jahren","jahre"}), 
            "Es hat einige Jahre gedauert, bis sich der Dschungel wieder so "
            "weit an den Tempel heran gekaempft hat.");

  AddDetail( ({"gesichter"}),
	    "Die Gesichter sehen gemein aus und ein Grinsen ist zu erkennen.");

  AddDetail( ({"erdgeschoss","platz"}),
	    "Das Erdgeschoss ist riesig."); 
  
  AddDetail( ({"ebenen"}), 
            "Es scheint inklusive Tempelspitze vier Ebenen neben dem "
            "Erdgeschoss zu geben.");

  AddDetail( ({"spitze","tempelspitze"}),
	    "Die Tempelspitze ist weit weg.");

  AddDetail( ({"grinsen"}),
	    "Das Grinsen ist nicht sehr nett.");

  AddDetail( ({"boden"}), 
            "Am Boden liegen einige Blaetter.");

  AddDetail( ({"blaetter"}),
	    "Die Blaetter sind von den Pflanzen abgefallen.");

  AddDetail( ({"pflanzen","rand"}),
	    "Es gibt viele Pflanzen am Rand des Pfades."); 
  
  AddDetail( ({"himmel"}), 
            "Der Himmel ist durch das dichte Blaetterdach kaum zu sehen.");

  AddDetail( ({"blaetterdach"}),
	    "Das Blaetterdach der Baeume ist sehr dicht.");

  AddDetail( ({"baeume"}),
	    "Die Baeume stehen sehr dicht.");

  AddSmell(DEFAULT_SMELL, "Es riecht nach Dschungel.");  
 
  AddSmell( ({"dschungel"}),
	   "Es riecht halt dschungelig.");

  AddSound(DEFAULT_SOUND, "Du hoerst ein paar Voegel.");

  AddSound( ({"voegel"}),
	   "Die Voegel singen ein wenig. Nicht besonders interessant.");
  
//-----Details Ende-----
  
AddExit("nordwesten", ([ EX_DEST : ROOM "tem12",
                         EX_PLMSG   : "Du draengst Dich an den Statuen "
                                      "vorbei.\n",
                         EX_MSG  : "draengt sich an den Statuen vorbei" ]) );
AddExit("sueden", ROOM "tem14");

}

