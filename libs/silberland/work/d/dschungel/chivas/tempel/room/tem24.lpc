// von Chivas
inherit "std/room";

#include "../def.h"

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "An einem Tempel im Dschungel");
  SetProp( P_INT_LONG,
        "Lauter Schlingpflanzen und Ranken haben sich auf der Mauer des "
        "Tempels ausgebreitet und geben dem Tempel ein truegerisches Aussehen. "
	"Ansonsten ist der Pfad angenehm breit zum gehen, da die groesseren "
        "Baeume die Naehe des Tempels zu meiden scheinen. " );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 30, ENV_TERRAIN: TT_JUNGLE]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );
  
//-----Details Anfang-----

  AddDetail( ({"schlingpflanzen"}), 
            "Die Schlingpflanzen haengen von ein paar Baeumen und haben sich "
            "auch auf der Tempelmauer niedergelassen, so dass sie kaum noch "
            "zu sehen ist.");

  AddDetail( ({"ranken"}),
	    "Die Ranken habe sind an die Tempelmauer gewachsen. Ihre "
            "schwarzen Blueten stinken fuerchterlich.");

  AddDetail( ({"blueten"}),
	    "Die Blueten sind schwarz. Eine ungewoehnliche Farbe fuer "
            "Blueten.");

  AddDetail( ({"tempels","tempel","weg"}), 
            "Der Tempel sieht so zugewachsen truegerisch friedlich aus. Du "
            "traust dem Aussehen nicht ueber den Weg.");

  AddDetail( ({"aussehen"}),
	    "Es sieht fast so aus, als ob hier nichts Boeses sein koennte.");

  AddDetail( ({"pfad","probleme"}),
	    "Der Pfad ist schoen breit. Du kannst ohne Probleme weiter gehen."); 
  AddDetail( ({"baeume","baeumen"}), 
            "Von den Baeumen haengen einige Schlingpflanzen herunter. Sie "
            "scheinen den Tempel irgendwie zu meiden.");

  AddDetail( ({"naehe"}),
	    "Du hast eigentlich auch nicht so grosse Lust dem Tempel so nah "
            "zu kommen.");

  AddDetail( ({"boden"}),
	    "Am Boden wachsen einige junge Straeucher und andere Pflanzen.");

  AddDetail( ({"himmel","sonne"}), 
            "Der Himmel ist recht gut zu sehen, da die Baeume nicht so nah "
            "am Tempel stehen. Er ist schoen blau und die Sonne scheint.");

  AddDetail( ({"lust"}),
	    "Spar Dir Deine Lust fuer andere Sachen auf.");

  AddDetail( ({"sachen"}),
	    "Das Silberland ist jugendfrei, darum wird auf dieses Thema nicht "
            "weiter eingegangen."); 
  
  AddDetail( ({"thema"}), 
            "Das Thema ist sowieso nichts fuer Dich.");

  AddDetail( ({"silberland"}),
	    "Du bist im Silberland und normalerweise fuehlst Du Dich recht "
            "wohl hier. Der Tempel jedoch verdirbt Dir ein wenig die gute "
            "Laune.");

  AddDetail( ({"laune"}),
	    "Du bist normalerweise immer gut gelaunt.");

  AddDetail( ({"tempelmauer","mauer"}), 
            "Die Mauer ist fast komplett mit Schlingpflanzen und Ranken "
            "zugewachsen. Nur an ein paar Stellen kann man die Steinquader "
            "noch erkennen.");

  AddDetail( ({"stellen","steinquader","quader","steinquadern"}),
	    "Die Mauer besteht aus grossen und schweren Steinquadern.");

  AddDetail( ({"farbe","farben","formen","natur"}),
	    "Die Natur bringt alle moeglichen Formen und Farben ins "
            "Silberland."); 
  
  AddDetail( ({"boeses","boese"}), 
            "Du bist Dir aber sicher, dass das Boese in diesem Tempel haust.");

  AddDetail( ({"straeucher"}),
	    "An den Straeuchern sind einige Beeren zu sehen.");

  AddDetail( ({"beeren","vogelbeeren","vogelbeere","beere"}),
	    "Die Beeren sind saftig rot. Sie sehen aus wie Vogelbeeren. Du "
            "kannst natuerlich die Beeren pfluecken und essen, aber sie sind "
            "sicher nicht gesund.");

  AddDetail( ({"pflanzen"}), 
            "Es sind ein paar Blumen. Die restlichen Pflanzen sind "
            "uninteressant.");

  AddDetail( ({"blumen"}),
	    "Es sind ein paar Orchideen.");

  AddDetail( ({"orchideen"}),
	    "Du hast schon einige Orchideen hier im Dschungel gesehen. Sie "
            "sind sehr huebsch."); 
  
  AddDetail( ({"dschungel"}), 
            "Du bist mittendrin.");

  AddDetail( ({"konzentration"}),
	    "Du solltest immer aufpassen.");

  AddSmell(DEFAULT_SMELL, "Die Blueten den Ranken stinken fuerchterlich.");  
 
  AddSmell( ({"blueten","ranken"}),
	   "Dir wird ein wenig schlecht.");

  AddSound(DEFAULT_SOUND, "Du hoerst wie der Wind durch die Wipfel der Baeume "
                          "weht.");

  AddSound( ({"wind","wipfel","baeume"}),
	   "Es wirkt beruhigend, obwohl Deine Konzentration nicht nachlassen "
           "sollte.");
  
//-----Details Ende-----
  
AddExit("sueden", ROOM "tem23");
AddExit("norden", ROOM "tem25");

AddCmd( ({"pflueck", "pfluecke" }), "pfluecken" );

}
int pfluecken(string str)
{
   notify_fail("Was moechtest Du pfluecken?\n");
   if ( member( ({ "beere","beeren","vogelbeeren","vogelbeere" }),str) != -1) 
  {
    write(BS( "Du pflueckst eine Vogelbeere und isst sie. Das war wohl keine "
           "so gute Idee, Du haettest die Warnung ernst nehmen sollen.\n"));
    say( TPN+" verzieht das Gesicht und sieht nicht besonders gut aus.\n");
    this_player()->AddPoison(3);
    return 1;
  }
}

