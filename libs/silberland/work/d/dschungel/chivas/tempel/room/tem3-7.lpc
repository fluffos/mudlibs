// von Chivas
inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

int anzahl;

void create()
	
{
  ::create();

  anzahl=1;

  AddRoomMessage( ({ "Ein eiskalter Windzug bringt Dich zum Zittern. Deine "
                     "Zaehne klappern ganz laut.\n"}),
                     30, "sound" );

  SetProp( P_INT_SHORT, "In einem Tempel");
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: -10, ENV_TERRAIN: TT_ARCTIC]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----

  AddDetail( ({"gang"}), 
            "Der Gang wurde eindeutig magisch veraendert. Ueberall ist Eis und "
            "Schnee zu sehen.");

  AddDetail( ({"decke","himmel"}),
	    "Von der Decke haengen grosse Eiszapfen. Wenn einer von ihnen "
            "runterfaellt und Dich trifft, dann bist Du tot.");

  AddDetail( ({"eiszapfen","zapfen"}),
	    "Die Eiszapfen bestehen aus festem Eis und sind sehr spitz. Wenn "
            "Dich einer trifft, war es das mit Dir.");

  AddDetail( ({"zauberer","zauberers","faehigkeiten"}), 
            "Der Zauberer laeuft hier sicher noch irgendwo auf der Ebene rum. "
            "Bei der Macht, die er hat, willst Du ihm nicht begegnen.");

  AddDetail( ({"tempel"}),
	    "Du bist auf der hoechsten Ebene im Tempel.");

  AddDetail( ({"boden"}),
	    "Am Boden liegt der Schnee sehr hoch. Es ist schwer, voran zu "
            "kommen."); 
  
  AddDetail( ({"schnee"}), 
            "Der Schnee ist weiss und eisig. Du spuerst Deine Fuesse kaum "
            "noch.");

  AddDetail( ({"gangmitte","skulptur","eisskulptur"}),
	    "In der Gangmitte steht eine grosse Skulptur, die aus Eis zu "
            "bestehen scheint. Jedoch sieht die Skulptur doch sehr sehr "
            "menschlich aus, als ob es ein Abenteurer wie Du sein koennte.");

  AddDetail( ({"waende","waenden"}),
	    "An den Waenden haengen grosse mit Eis ueberzogene Fackeln.");

  AddDetail( ({"eis"}), 
            "Das Eis strahlt Dich an. Du zitterst.");

  AddDetail( ({"macht"}),
	    "Die Macht willst Du sicher nicht zu spueren bekommen.");

  AddDetail( ({"ebene"}),
	    "Du bist auf der dritten Ebene im Tempel."); 
  
  AddDetail( ({"abenteurer"}), 
            "Als Du genauer hinschaust erkennst Du, dass es wirklich ein "
            "eingefrohrener Abenteurer unter der Eisschicht ist. Dir wird "
            "auf einmal noch kaelter.");

  AddDetail( ({"eisbrocken","brocken"}),
	    "Grosse Eisbrocken liegen auf dem Boden. Es sieht so aus, als ob "
            "eine Eisskulptur zerschlagen wurde.");

  AddDetail( ({"fackeln"}),
	    "Die Fackeln leuchten in einem eisigen Weiss.");

  AddDetail( ({"weiss"}), 
            "Du solltest aufpassen, dass Du nicht schneeblind wirst.");

  AddDetail( ({"eisschicht"}),
	    "Vielleicht kannst Du die Eisschicht zerschlagen?");

  AddDetail( ({"fuesse"}),
	    "Deine Fuesse sind eiskalt."); 
  
  AddDetail( ({"windzug","zittern"}), 
            "Der Windzug der hier herrscht, bringt Dich noch mehr zum "
            "Zittern.");

  AddSmell(DEFAULT_SMELL, "Es ist viel zu eisig hier, um noch was riechen zu "
                          "wollen.");  
 
  AddSound(DEFAULT_SOUND, "Du hoerst Deine eigenen Zaehne klappern.");

  AddSound( ({"zaehne"}),
	   "Auch wenn Du probierst, Dich zusammen zu reissen, Du schaffst es "
           "nicht.");
  
//-----Details Ende-----
  
AddExit("westen", ROOM "tem3-8");
AddExit("norden", ROOM "tem3-6");
AddExit("nordwesten", ROOM "tem3-1");

AddCmd( ({"zerschlag", "zerschlage" }), "zerschlagen" );

}
string _query_int_long()
{
  string txt;

    if ( anzahl )
    {
     txt = "Der Gang ist eisig. Von der Decke haengen grosse Eiszapfen und der "
        "Boden ist mit Schnee bedeckt. Die magischen Faehigkeiten des boesen "
        "Zauberers, der den Tempel magisch veraendert hat, muessen riesig "
        "gewesen sein. Du bist beeindruckt und zugleich erschuettert, als Du "
        "eine Skulptur in der Gangmitte entdeckst. ";
    }
    else
    {
    txt = "Der Gang ist eisig. Von der Decke haengen grosse Eiszapfen und der "
        "Boden ist mit Schnee bedeckt. Die magischen Faehigkeiten des boesen "
        "Zauberers, der den Tempel magisch veraendert hat, muessen riesig "
        "gewesen sein. Am Boden liegen ausserdem ein paar Eisbrocken als ob "
        "etwas aus dem Eis entkommen ist. ";    }
  return BS(txt);
}
void reset()
{
  ::reset();
  anzahl=1;
}
int zerschlagen(string str)
{
   notify_fail("Was moechtest Du zerschlagen?\n");
   if ( member( ({ "eis", "eisschicht" }),str) != -1) 
  {
    if ( anzahl )
    {
    write(BS( "Du zerschlaegst die Eisschicht der Skulptur und der Abenteurer "
           "erwacht zum Leben. Er bedankt sich dafuer, dass Du ihn "
           "befreit hast und flieht aus dem Tempel.\n"));
    say( TPN+" zerschlaegt die Eisschicht der Eisskulptur und befreit "
             "jemanden.\n");
    anzahl--;
    return 1;
    }
    else
    {
    write(BS( "Die Skulptur ist schon zerstoert. Du brauchst es nicht mehr "
           "zu tun.\n"));
    say( TPN+" schlaegt mit der Waffe stupide in der Luft rum.\n");
    return 1;
    }
  }
}

