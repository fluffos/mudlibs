// von Chivas
inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In der Spitze eines Tempels");
  SetProp( P_INT_LONG,
        "Die Spitze des Tempels kann man eigentlich als Schatzkammer "
        "bezeichnen. Ueberall sind grosse Haufen von Gold, Mithril und "
        "anderem Geschmeide. Durch die grossen Fenster kommt sehr viel "
        "Licht herein und spiegelt sich in dem Schatz. Der Boden besteht "
        "aus grossen blanken Marmorplatten und alles ist sehr sauber. Du "
        "spuerst die Magie des Raumes bis in Deine Haarspitzen." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----

  AddDetail( ({"spitze"}), 
            "Nun bist Du endlich oben angekommen. Gratulation.");

  AddDetail( ({"tempel","tempels"}),
	    "Du bist im Tempel. Genauer gesagt in der Spitze des Tempels 'Iaun "
            "en Sereg'.");

  AddDetail( ({"schatzkammer","kammer"}),
	    "Hier liegen so viele Schaetze herum. Es koennte eine Schatzkammer "
            "sein.");

  AddDetail( ({"haufen","taschen"}), 
            "Es gibt lauter Haufen mit Mithril, Gold, Edelsteine usw. Hier "
            "moechtest Du gerne einmal Deine Taschen fuellen.");

  AddDetail( ({"gold"}),
	    "Es liegt unglaublich viel Gold herum. Auf dem Gold scheint jedoch "
            "ein magischer Schimmer zu liegen.");

  AddDetail( ({"mithril","schmuck","herstellen"}),
	    "Das viele Mithril koenntest Du gut zum Herstellen von Schmuck "
            "gebrauchen. Jedoch liegt ein magischer Schimmer ueber dem "
            "Mithril."); 
  
  AddDetail( ({"geschmeide","samt","seide"}), 
            "Es gibt viel Samt und Seide, jedoch nichts was Du gebrauchen "
            "koenntest.");

  AddDetail( ({"fenster","bild"}),
	    "Die Fenster lassen viel Licht herein und Du kannst auch den "
            "Himmel draussen gut erkennen. An dem idyllischem Bild stoert "
            "nur der Qualm der sich unter der Decke gebildet hat und langsam "
            "durch das Fenster verschwindet.");

  AddDetail( ({"licht"}),
	    "Sehr viel Licht dringt durch die Fenster herein und glitzert "
            "auf dem Gold, Mithril und den Edelsteinen.");

  AddDetail( ({"schatz"}), 
            "Man kann eigentlich nicht von Schatz reden, es sind schon mehrere "
            "Schaetze.");

  AddDetail( ({"boden"}),
	    "Am Boden liegen lauter wertvolle Sachen auf den Marmorplatten. Du "
            "gierst gerade zu danach.");

  AddDetail( ({"marmorplatten","marmor","platten"}),
	    "Die Marmorplatten sind sauber verarbeitet und es ist kein "
            "Staubkorn zu sehen."); 
  
  AddDetail( ({"magie"}), 
            "Du kannst die Magie im Raum spueren.");

  AddDetail( ({"raum","raumes"}),
	    "Dies ist die Spitze des Tempels.");

  AddDetail( ({"haarspitzen"}),
	    "Deine Haarspitzen knistern vor Magie hier in der Spitze des "
            "Tempels.");

  AddDetail( ({"edelsteine"}), 
            "Alle moeglichen Edelsteine liegen herum.");

  AddDetail( ({"iaun","sereg","iaun en sereg","blutes","blut"}),
	    "Uebersetzt heisst es 'Tempel des Blutes'.");

  AddDetail( ({"stelle"}),
	    "An einer kleinen Stelle ist der Schimmer nicht zu sehen. Man "
	    "erkennt ein Glitzern an der Stelle.");

  AddDetail( ({"glitzern"}),
	    "Vielleicht probierst Du einfach nach dem Glitzern zu greifen, "
	    "vielleicht passiert nichts und vielleicht ist es auch was "
	    "Wertvolles. Aber natuerlich alles auf eigene Verantwortung "
	    "hier im Tempel.");

  AddDetail( ({"schimmer","personen","pech"}),
	    "Der magische Schimmer scheint das Gold und Mithril vor Personen "
            "wie Dir zu schuetzen. Du hast leider Pech gehabt und kannst "
            "nichts von dem Schatz mitnehmen. Nur an einer kleinen Stelle "
	    "scheint der Schimmer ein wenig unterbrochen"); 
  
  AddDetail( ({"decke"}), 
            "Die Decke ist nicht richtig zu erkennen, da lauter Qualm unter "
            "der Decke haengt.");

  AddDetail( ({"himmel","tag"}),
	    "Draussen ist der Himmel schoen blau. Es scheint ein schoener Tag "
            "zu sein.");

  AddDetail( ({"waende","waenden"}),
	    "Grosse Fenster in jede Richtung sind an den Waenden zu sehen. "
            "Ausserdem haengen ein paar Wandteppiche dort, wie auch in anderen "
            "Raeumen im Tempel.");

  AddDetail( ({"qualm"}), 
            "Der Qualm unter der Decke stammt sicher von dem Drachen. Wenn "
            "er Feuer spuckt, entsteht automatisch auch Qualm.");

  AddDetail( ({"feuer"}),
	    "Das ein Drache Feuer spuckt, willst Du eigentlich nicht sehen.");

  AddDetail( ({"drachen","drache"}),
	    "Hier in der Spitze des Tempels haust ein Drache.");

  AddDetail( ({"richtung"}),
	    "Die Fenster gehen in alle vier Himmelsrichtungen."); 
  
  AddDetail( ({"wandteppiche"}), 
            "Die Teppiche sind alle heile und sehr kostbar. Auf allen ist die "
            "gleiche Gestalt abgebildet.");

  AddDetail( ({"raeumen","raeume","kammern","gaenge"}),
	    "Damit sind die Kammern, Gaenge etc. hier im Tempel gemeint.");

  AddDetail( ({"schaetze"}),
	    "Der Drache ist unermesslich reich.");

  AddDetail( ({"sachen"}), 
            "Halt die ueblichen Edelsteine, Mithril und Gold.");

  AddDetail( ({"staubkorn","staub"}),
	    "Im restlichen Tempel war alles so dreckig, dagegen ist hier alles "
            "sauber und es ist kein bisschen Staub zu erkennen.");

  AddDetail( ({"himmelsrichtungen"}),
	    "Ost, West, Nord und Sued"); 

  AddDetail( ({"gestalt"}),
	    "Es ist ein grosser blutroter Drache.");

  AddDetail( ({"nase"}),
	    "Du hast eine sehr grosse Nase."); 
  
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Qualm.");  
 
  AddSmell( ({"qualm"}),
	   "Der Qualm beisst sehr in der Nase.");

  AddSound(DEFAULT_SOUND, "Du hoerst geradezu die Magie im Raum knistern.");

  AddSound( ({"magie"}),
	   "*knister**knister**knister*");
  
//-----Details Ende-----

AddItem(NPC "cruentosanies", REFRESH_DESTRUCT);
  
AddSpecialExit( "runter", "go_runter" );

AddCmd( ({"spring", "springe" }), "springen" );
AddCmd( ({"nimm", "nehme","greif","greife" }), "nehmen" );

}
int springen(string str)
{
   object zange;
   object fell;
   {
   if( str != "aus fenster"     &&
       str != "runter"              )
  {
   
  notify_fail("Woraus moechtest Du springen?\n");

  return 0;
  }
    {
    write(BS("Du geraetst vollkommen in Panik und hechtest in Richtung "
             "Fenster. Da Dich Deine Sachen zu sehr behindern, wirfst "
             "Du sie in Deinem Angstzustand weg und springst. Als Du "
             "unten aufschlaegst schwinden Dir die Sinne."));
    this_player()->command_me("wirf alles weg");    
    say( TPN+" springt voller Panik aus dem Fenster.\n");
    fell = clone_object( "/d/ebene/obj/ruestung/igelfellteil.lpc");
    fell->move(this_player(), M_NOCHECK);
    zange = clone_object( "/d/ebene/obj/waffe/azange.lpc");
    zange->move(this_player(), M_NOCHECK);
    TP->move(ROOM "tem8", M_GO|M_NOCHECK|M_NO_SHOW, 
    "auf den Boden vor dem Tempel wie Du aus dem Fenster sehen kannst",
    "knallt", "knallt vom Himmel fallend auf den Boden");
    TP->AddHp(-500);
    TP->SetProp(P_PARALYZED, 100);
    TP->SetProp(P_PARALYZED, ([
    PARALYZE_TIME: 10,
    PARALYZE_MSG: "Du bist ohnmaechtig und kannst gar nichts tun.\n",
    PARALYZE_END:"Als Du wieder zu Dir kommst hoerst Du wie der Drache "
                 "Dich verhoehnt und sich bei bei Dir bedankt, dass "
                 "Du Deine Sachen bei ihm gelassen hast. Als Dank "
                 "wirft er etwas hinter Dir her, was Du auffaengst "
                 "und sofort einsteckst.\n",
    PARALYZE_END_OTHER:"Die arme Person kommt wieder zu sich."
                              ]) );	

    return 1;
  }
 }
}
int go_runter(string dir)
{
  if(!(present("cruentosanies", TO)) || present("cruentosanies")->QueryProp(P_HP) > 200)
  {
    TP->move(ROOM "tem3-1", M_GO); 
    return 1;
  }
  write(BS("Du probierst nach unten zu gehen, aber der Drache versperrt "
        "Dir den Weg. Dies wird ein Kampf auf Leben und Tod.\n"));
  return 1;
}

int nehmen(string str)
{
  object dolch;
  notify_fail( "Wem willst Du nehmen?\n" );
  if ( member( ({ "glitzern", "dolch","etwas","nach glitzern" }), str ) != -1 ) 

   {
     if( !present("dragoninvis1",TP))
     {
        write(BS("Das Glitzern hat sich leider nur als Sabber im Lichtschein "
		 "herausgestellt. Er stammt sicher von dem Drachen, der hier "
		 "haust.\n"));
        return -1;
     }

      if ( present("CHIVASDOLCH",TP) )
      {
      write(BS("Das Glitzern hat sich leider nur als Sabber im Lichtschein "
		 "herausgestellt. Er stammt sicher von dem Drachen, der hier "
		 "haust.\n" ));
      say(sprintf("%s sucht umsonst.\n", TP->Name(WER)));
      return -1;
      }
      else
      {
      {dolch = clone_object("/d/kristallwald/chivas/dragonquest/weapon/chdolch");

       if ( ME_TOO_HEAVY == dolch->move(TP,M_GET|M_SILENT) )

          {
          write(
          "Der Dolch wuerde Dir zu schwer werden.\n" );
          say(BS(sprintf("%s ist einfach zu schwach.\n", TP->Name(WER))));
          dolch -> remove();
          return 1;
          }
          else
          {
          write(BS("Du greifst nach dem Glitzern und hast ploetzlich einen "
		   "wunderschoenen Dolch in der Hand.\n"));

      return 1;
          }
        }
     }
    return 0;
   }
  return 0;
}
