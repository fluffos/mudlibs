// von Chivas
inherit "std/room";

#include "../def.h"

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einem Tempel im Dschungel");
  SetProp( P_INT_LONG,
        "Dies ist die nordoestliche Ecke des Tempels. Rund um Dich herum ist "
        "der Dschungel recht nahe an den Tempel gewachsen. Die Steinquader "
        "unter Dir sind mit allerlei Pflanzen bewachsen und die Aussenmauer "
        "ist glatt und eben und komischerweise findet man an der Mauer nicht "
        "eine einzige Pflanze." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 30, ENV_TERRAIN: TT_JUNGLE]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----

  AddDetail( ({"ecke"}), 
            "Du stehst nun an der nordoestlichen Ecke des Tempels. Genau "
            "unter Dir siehst Du die Koepfe einiger Steinstatuen.");

  AddDetail( ({"tempel","tempels"}),
	    "Du bist auf einem Tempel mitten im Dschungel.");

  AddDetail( ({"dschungel"}),
	    "Der Dschungel ist hier recht nahe am Tempel.");

  AddDetail( ({"steinquader","quader","boden"}), 
            "Die Steinquader am Boden sind mit allerlei Pflanzen bewachsen.");

  AddDetail( ({"pflanzen","pflanze"}),
	    "Es sind ein paar Graeser und Blumen.");

  AddDetail( ({"aussenmauer","mauer","fuge"}),
	    "Die Aussenmauer ist glatt und nicht eine Fuge ist zu sehen, "
            "obwohl nicht eine Pflanze an der Mauer haengt. Irgendwie sieht "
            "die Mauer komisch aus. Vielleicht solltest Du sie mal "
            "beruehren."); 
  
  AddDetail( ({"koepfe","steinstatuen","statuen","vorteil"}), 
            "Die Statuen sehen von hier oben genau so scheusslich aus wie "
            "von unten. Der einzige Vorteil ist, hier oben koennen sie Dir "
            "nichts antun.");

  AddDetail( ({"graeser"}),
	    "Du kennst die Graeser nicht und beschliesst, Dich diesbezueglich "
            "bald fortzubilden.");

  AddDetail( ({"blumen"}),
	    "Ein paar Blumen hast Du noch nie gesehen, aber ein paar "
            "Orchideen kannst Du ausmachen.");

  AddDetail( ({"orchideen","schoenheit","pracht"}), 
            "Die Orchideen bluehen in voller Pracht. Es ist schon ein Wunder "
            "solche Schoenheit an einem solch dunklen Tempel zu finden.");

  AddDetail( ({"wunder"}),
	    "Wunder gibt es immer wieder!");

  AddDetail( ({"himmel"}),
	    "Der Himmel ist schoen blau, nur am Horizont scheinen einige "
            "Wolken aufzutauchen."); 
  
  AddDetail( ({"wolken","horizont"}), 
            "Die weissen Wolken am Horizont sehen nicht nach Regen aus, aber "
            "sie haben eine eigenartige Form.");

  AddDetail( ({"regen"}),
	    "Es wird keinen Regen geben.");

  AddDetail( ({"form"}),
	    "Die Form der Wolken sieht aus wie ein Gesicht.");

  AddDetail( ({"gesicht"}), 
            "Das Gesicht sieht irgendwie vertraut aus. Es sieht aus wie ein "
            "Magier.");

  AddDetail( ({"magier"}),
	    "Es ist ein Hasibaerchi, wie suess. Hasibaerchi laechelt Dich an. "
            "Aber als Du wieder hinschaust, sehen die Wolken wieder wie ganz "
            "normale Wolken aus. Es war anscheinend doch nur eine Taeuschung.");

  AddDetail( ({"hasibaerchi","taeuschung"}),
	    "Du hast Dich sicher getaeuscht."); 
  
  AddSmell(DEFAULT_SMELL, "Es riecht eigentlich nach nichts.");  
 
  AddSound(DEFAULT_SOUND, "Du hoerst ein paar Voegel im Dschungel zwitschern.");

  AddSound( ({"voegel","zwitschern","dschungel"}),
	   "*zwitscher*zwitscher*zwitscher*");
  
//-----Details Ende-----

AddItem( "/d/dschungel/dante/weg/npc/dschimp", REFRESH_DESTRUCT,
        ([P_MNPC_DEFAULTROOM: "tem1-10",
          P_MNPC_AREA:({ROOM "tem1-11", ROOM "tem1-12", ROOM "tem1-13",
                        ROOM "tem1-25"}),
          P_MNPC_FLAGS: MOV_OUTDOORS + MOV_MAYLOAD + MOV_MOVES
        ]) );
  
AddExit("sueden", ROOM "tem1-11");
AddExit("westen", ROOM "tem1-25");

AddCmd( ({"beruehr","beruehre" }), "beruehren" );

}
int beruehren(string str)
{
   notify_fail("Wo moechtest Du beruehren?\n");
   if ( member( ({ "mauer","aussenmauer","wand" }),str) != -1) 
  {
    write(BS ( "Du beruehrst mit einer Hand die Aussenmauer des Tempels. Sie "
               "ist kochend heiss. Anscheinend brennt im Tempel ein grosses "
               "heisses Feuer.\n"));
    say( TPN+" beruehrt etwas, Du kannst jedoch nicht genau sehen was.\n");
    return 1;
  }
}

