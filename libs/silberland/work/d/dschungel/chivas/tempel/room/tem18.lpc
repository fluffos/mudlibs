// von Chivas
inherit "std/room";

#include "../def.h"

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "An einem Tempel im Dschungel");
  SetProp( P_INT_LONG,
        "Die haesslichen Statuen an der Ecke des Tempels starren Dich boese "
        "an. Man koennte fast denken sie leben. Der Pfad macht an dieser "
	"Stelle eine Biegung nach Nordosten um die Ecke herum. Ansonsten geht "
        "der Weg, dicht an die Tempelmauer gedrueckt, an der Suedseite des "
        "Tempels weiter." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 30, ENV_TERRAIN: TT_JUNGLE]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----

  AddDetail( ({"statuen"}), 
            "Die Statuen sind gross und haesslich. Sie scheinen zwei Orks "
            "darzustellen. Sie sind schon etwas von den Pflanzen des "
            "Dschungels zugewachsen.");

  AddDetail( ({"ecke"}),
	    "An der Ecke stehen zwei grosse Statuen.");

  AddDetail( ({"tempel","tempels"}),
	    "Dies ist die suedoestliche Ecke des grossen Tempels.");

  AddDetail( ({"pfad","weg"}), 
            "Der Pfad macht eine Biegung nach Nordosten und drueckt sich eng "
            "an die Mauer des Tempels.");

  AddDetail( ({"stelle","moeglichkeit","norden"}),
	    "An dieser Stelle hat man die Moeglichkeit, wieder nach Norden zu "
            "gelangen.");

  AddDetail( ({"biegung","nordosten"}),
	    "Du kannst um die Ecke nicht sehr gut herum sehen. Du must wohl "
            "nach Nordosten gehen um zu sehen was da ist."); 
  
  AddDetail( ({"tempelmauer","mauer"}), 
            "Die Tempelmauer ist mit einigen Pflanzen bewachsen.");

  AddDetail( ({"suedseite","westen","seite"}),
	    "Um die Suedseite des Tempels weiter zu erkunden, kannst Du nach "
            "Westen gehen.");

  AddDetail( ({"orks"}),
	    "Die Orks sind schon sehr stark zugewachsen. Man kann aber noch "
            "immer sehr gut die Gesichter der Statuen erkennen.");

  AddDetail( ({"pflanzen"}), 
            "Einige Pflanzen aus dem Dschungel haben sich auf der Tempelmauer "
            "und den Statuen festgesetzt. Es sind wohl ein paar Moose und "
            "Flechten.");

  AddDetail( ({"dschungels","dschungel","teil"}),
	    "Der Dschungel ist sehr nahe am Tempel. Die grossen Baeume am Weg "
            "verdecken zum groessten Teil den Himmel.");

  AddDetail( ({"boden"}),
	    "Am Boden sind einige kleine unbedeutende Pflanzen und viele "
            "Blaetter zu sehen, die von den Baeumen herunter gefallen sind."); 
  
  AddDetail( ({"himmel","blick"}), 
            "Der Himmel ist durch das dichte Blaetterdach der grossen Baeume "
            "kaum zu sehen. Er scheint schoen blau zu sein.");

  AddDetail( ({"gesicht","gesichter"}),
	    "In den Gesichtern der Statuen fallen Dir besonders die grossen, "
            "boesartigen Augen auf.");

  AddDetail( ({"moose","flechten"}),
	    "Die Moose und Flechten haben sich auf der Mauer und den Statuen "
            "festgesetzt. Sie haben aber eine ungesunde Farbe.");

  AddDetail( ({"farbe","gruen","gelb"}), 
            "Es ist nicht das erfrischende Gruen, was die anderen Pflanzen des "
            "Dschungels haben, sondern es ist ein kraenkliches Gelb.");

  AddDetail( ({"baeume","baeumen","innere","durchlass"}),
	    "Die Baeume stehen dicht am Weg und geben keinen Durchlass in das "
            "Innere des Dschungels. Du musst auf dem Pfad bleiben.");

  AddDetail( ({"blaetterdach","dach"}),
	    "Das dichte Blaetterdach ueber Dir versperrt fast den kompletten "
            "Blick auf den Himmel."); 
  
  AddDetail( ({"augen"}), 
            "Die Augen scheinen Dich genau zu beobachten und in ihnen scheint "
            "ein rotes Gluehen zu sein.");

  AddDetail( ({"blaetter"}),
	    "Viele Blaetter liegen auf dem Boden. Sie sind sicher von den "
            "Baeumen herunter gefallen. Auch an den Baeumen befinden sich "
            "natuerlich Blaetter.");

  AddDetail( ({"gluehen"}),
	    "Das rote Gluehen scheint magisch zu sein und floesst Dir ein "
            "wenig Angst ein.");

  AddDetail( ({"angst"}), 
            "Normalerweise bist Du sehr recht tapfer.");

  AddDetail( ({"wegrand"}),
	    "Am Wegrand stehen ein paar kleine zierliche Blumen.");

  AddDetail( ({"blumen"}),
	    "Es sind Orchideen."); 
  
  AddDetail( ({"orchideen"}), 
            "Die Orchideen bluehen in wunderschoenen Farben.");

  AddDetail( ({"farben"}),
	    "Alle Farben eines Regenbogens.");

  AddDetail( ({"regenbogens","regenbogen"}),
	    "Einen Regenbogen siehst Du hier natuerlich nicht.");

  AddSmell(DEFAULT_SMELL, "Es riecht nach Blumen.");  
 
  AddSmell( ({"blumen"}),
	   "Am Wegrand entdeckst Du ein paar Blumen. Sie riechen wunderbar.");

  AddSound(DEFAULT_SOUND, "Du hoerst ein Rascheln.");

  AddSound( ({"rascheln"}),
	   "Das Rascheln erzeugst Du selbst, wenn Du ueber die Blaetter "
           "schlurfst.");

//-----Details Ende-----
  
AddExit("nordosten", ROOM "tem17");
AddExit("westen", ROOM "tem19");

}

