// von Chivas
inherit "std/room";

#include "../def.h"

int anzahl;
int keil_zahl; 

void create()
	
{
  ::create();

  anzahl=1;
  keil_zahl=1;

  SetProp( P_INT_SHORT, "In einem Tempel");
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----

  AddDetail( ({"granitboden","boden"}), 
            "Der Boden ist mit den ueblichen Steinplatten bedeckt.");

  AddDetail( ({"steinplatten","platten"}),
	    "Die Steinplatten sind wie in allen anderen Gaengen oder Kammern "
            "quadratisch. Es gibt nur sehr kleine, aber wichtige Unterschiede.");

  AddDetail( ({"klack"}),
	    "Als Du dieses Geraeusch hoerst, merkst Du, dass Du eine Falle "
            "ausgeloest hast.");

  AddDetail( ({"falle"}), 
            "Du stehst mit dem einen Fuss auf der Falle. Du koenntest sie "
            "sicher irgendwie blockieren und Dich retten.");

  AddDetail( ({"waende","waenden"}),
	    "An den Waenden sind die ueblichen Fackeln, jedoch auch kleine, "
            "nicht besonders freundlich aussehende Loecher.");

  AddDetail( ({"loecher"}),
	    "Die Loecher sehen so aus, als ob aus ihnen etwas unerfreuliches "
            "kommen koennte, wenn die Falle nicht entschaerft wird."); 
  
  AddDetail( ({"decke","himmel"}), 
            "An der kahlen Decke gibt es ueberhaupt nichts zu sehen.");

  AddDetail( ({"fuss"}),
	    "Ein Fuss steht auf der Falle. Falls sie nicht schon blockiert "
            "wurde, wuerde ich mir an Deiner Stelle jetzt ernste Sorgen "
            "machen.");

  AddDetail( ({"stelle","sorgen"}),
	    "Sorgen sind fuer Dich etwas ganz normales.");

  AddDetail( ({"kammern","gaengen","gaenge"}), 
            "Du kennst schon viele Kammern und Gaenge hier im Tempel.");

  AddDetail( ({"tempel"}),
	    "Der Tempel ist riesig und Du bist mittendrin.");

  AddDetail( ({"unterschiede","unterschied"}),
	    "Ein grosser Unterschied ist jedenfalls die Falle auf der Du "
            "momentan stehst. Ausserdem siehst Du kleine Kratzspuren auf einer "
            "Steinplatte."); 
  
  AddDetail( ({"steinplatte","platte"}), 
            "Eine Platte weisst Kratzspuren auf.");

  AddDetail( ({"kratzspuren","spuren"}),
	    "Als Du genauer hinschaust merkst Du, dass es eigentlich ein "
            "kleiner Riss in der Platte ist.");

  AddDetail( ({"riss"}),
	    "Du kannst ja mal in den Riss greifen.");

  AddDetail( ({"fackeln"}), 
            "Die blau leuchtenden Fackeln erhellen den Gang, in dem Du Dich "
            "befindest.");

  AddDetail( ({"gang"}),
	    "Dies ist ein Gang, der Dir gar nicht gefaellt.");

  AddSmell(DEFAULT_SMELL, "Du riechst nur Deinen eigenen Angstschweiss.");  
 
  AddSmell( ({"angstschweiss","schweiss"}),
	   "Du stinkst, geh Dich waschen.");

  AddSound(DEFAULT_SOUND, "Du hoerst nur das Klack der Falle.");

  AddSound( ({"klack","geraeusch"}),
	   "Hoffentlich hast Du sie schon entschaerft, ansonsten kann es "
           "uebel ausgehen.");
  
//-----Details Ende-----
  
AddExit( "westen", ([
              EX_PLMSG   : "Du gehst nach Westen.\n",
              EX_FUNC    : "func1" ]) );
AddExit( "osten", ([
              EX_PLMSG   : "Du gehst nach Osten.\n",
              EX_FUNC    : "func2" ]) );

AddCmd( ({"greifen", "greife","greif" }), "greifen" );
AddCmd( ({"blockier", "blockiere" }), "blockieren" );

}
void reset()
{
  ::reset();
  anzahl=1;
  keil_zahl=1;
}
string _query_int_long()
{
  string txt;

    if ( anzahl )
    {
      txt = "Du gehst recht schnell ueber den Granitboden mit seinen recht "
        "uninteressanten Steinplatten, als Du ein verraeterisches 'Klack' "
        "hoerst. Auf einmal merkst Du, dass Du eine Falle ausgeloest haben "
        "musst und an den Waenden fallen Dir ploetzlich auch kleine Loecher "
        "auf. Du schluckst und bleibst abrupt stehen.";
    }
    else
    {
      txt = "Du gehst recht schnell ueber den Granitboden mit seinen recht "
        "uninteressanten Steinplatten, als Du ein verraeterisches 'Klack' "
        "hoerst. Auf einmal merkst Du, dass Du eine Falle ausgeloest haben "
        "musst. Jedoch hast Du Glueck gehabt, die Falle ist schon deaktiviert "
        "und die Loecher an den Waenden beunruhigen Dich nicht mehr so sehr.";
    }
  return BS(txt);
}
int greifen(string str)
{
   object keil;
   notify_fail("Wo rein moechtest Du greifen?\n");
   if ( member( ({ "in riss", "in riss an Boden" }),str) != -1) 
   {
     if( keil_zahl < 1 )
     {
        write(BS("Du findest nichts in dem Riss, dass Dich weiter bringen "
              "wuerde.\n"));
        say(sprintf("%s greift umsonst wo rein.\n", TP->Name(WER)));
        return -1;
     }
      if ( present("keil",TP) )
      {
      write(BS("Da Du bereits einen Keil hast, brauchst Du es nicht mehr "
            "zu tun.\n" ));
      say(sprintf("%s sucht nach weiteren Dingen in einem Riss.\n", TP->Name(WER)));
      return -1;
      }
      else
      {
        {keil = clone_object( OBJ "keil");
        if ( ME_TOO_HEAVY == keil->move(TP,M_GET|M_SILENT) )
 
          {
          write(BS(
          "Der Keil wuerde Dir zu schwer werden.\n" ));
          say(BS(sprintf("%s probiert etwas aus einem Riss zu nehmen,scheint "
          "aber von seinem Gepaeck behindert zu werden.\n", TP->Name(WER))));
          keil -> remove();
          return 1;
          }
          else
          {
          write(BS("Du greifst in den Riss und findest einen kleinen Holzkeil.\n"));
          say(sprintf("%s findet etwas.\n",
          TP->Name(WER)));
          keil_zahl--;
          return 1;
          }
        }
     }
    return 0;
   }
  return 0;
}
int blockieren(string str)
{
 notify_fail("Was willst Du womit blockieren?\n");

 if(!str || str == "") return 0;
 if(!(str == "mechanismus" ||
      str == "falle" ||
      str == "mechanismus mit keil"||
      str == "falle mit keil" )) return 0;
 

 if( str == "mechanismus mit keil" ||
     str == "falle mit keil"){
    
  if(!present("keil", TP)){
	  
  write(BS("Du hast ja gar nichts, womit Du die Falle blockieren kannst.\n"));
 
  say(TPN+" denkt nach.\n");
  return -1;
  }
  write(BS("Du nimmst den Keil und blockierst gekonnt den Mechanismus der "
	  "Falle.\n"));
 
  say(TPN+" blockiert einen Mechanismus.\n");
  present("keil",TP)->remove();
  anzahl--;
  return 1;
 }
 if( str == "mechanismus" ||
     str == "falle"){
 
 write(BS("Womit willst Du denn den Mechanismus blockieren ? "
	  "Ein Keil waere sicher das richtige.\n"));

 say(TPN+" stellt sich dumm an.\n");
 return 1;
 }
}
int func1() 
 {
 if ( anzahl )
 {
 write(BS("Als Du weiter gehst, ohne die Falle zu beachten, treffen Dich lauter "
       "Pfeile aus den Loechern in den Waenden und Du faellst durch eine "
       "grosse Falltuer.\n"));
 TP->AddHp(-80);
 this_player()->move(ROOM "temz3", M_GO|M_NOCHECK|M_NO_SHOW,"","faellt durch ein Falltuer");
 return 1;
 }
 else 
 this_player()->move(ROOM "tem2-7", M_GO);
 return 1;
}
int func2() 
 {
 if ( anzahl )
 {
 write(BS("Als Du weiter gehst, ohne die Falle zu beachten, treffen Dich lauter "
       "Pfeile aus den Loechern in den Waenden und Du faellst durch eine "
       "grosse Falltuer.\n"));
 TP->AddHp(-80);
 this_player()->move(ROOM "temz3", M_GO|M_NOCHECK|M_NO_SHOW,"","faellt durch ein Falltuer");
 return 1;
 }
 else 
 this_player()->move(ROOM "tem2-5", M_GO);
 return 1;
}

