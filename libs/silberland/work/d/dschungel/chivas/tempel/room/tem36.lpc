// von Chivas
inherit "std/room";

#include "../def.h"

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Tempel");
  SetProp( P_INT_LONG,
        "Dies scheint wieder ein weiterer Abschnitt im Tempel zu sein. Du bist "
        "froh, dass der Boden nicht mehr so glitschig ist, bist aber trotzdem "
        "ein wenig beunruhigt, als Du die aufgestapelten Totenkoepfe in den "
	"Ecken des Raumes erkennst. Es muessen hunderte sein." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  
  AddDetail( ({"abschnitt","stelle"}), 
            "Du bist nun an einer komplett anderen Stelle im Erdgeschoss des "
            "Tempels.");

  AddDetail( ({"tempel","tempels","schritt"}),
	    "Du bist wieder einen Schritt weiter im Tempel. Mal sehen was nun "
            "auf Dich zukommt.");

  AddDetail( ({"boden"}),
	    "Der Boden ist mit Staub bedeckt. Es war wohl sehr lange keiner "
            "mehr in diesem Raum.");

  AddDetail( ({"totenkoepfe"}), 
            "Es muessen hunderte von Totenkoepfe sein. Sie wurden in den "
            "Ecken aufgestapelt. Du wunderst Dich nur wo die restlichen "
            "Knochen der armen Kreaturen sind.");

  AddDetail( ({"ecken","ecke"}),
	    "In den Ecken wurden Totenkoepfe von jemandem aufgestapelt. Es "
            "soll Dich wohl ein wenig abschrecken, weiter zu gehen.");

  AddDetail( ({"raum","raumes"}),
	    "Es ist kein sehr grosser Raum. Er ist nur sehr dreckig und die "
            "Ecken gefallen Dir gar nicht."); 
  
  AddDetail( ({"wand","waende","waenden","mauer"}), 
            "An den Waenden haengen die ueblichen Fackeln. Ansonsten sieht man "
            "den blanken Stein.");

  AddDetail( ({"decke","himmel"}),
	    "An der Decke erkennt man eigentlich gar nichts.");

  AddDetail( ({"erdgeschoss","spitze"}),
	    "Es ist noch ein weiter Weg bis in die Spitze des Tempels.");

  AddDetail( ({"kreaturen"}), 
            "Es ist egal wer diese Kreaturen waren. Du moechtest jedenfalls "
            "nicht mit ihnen tauschen.");

  AddDetail( ({"fackeln"}),
	    "Die Fackeln erhellen den Raum ein wenig, damit Du wenigstens "
            "ein bisschen siehst.");

  AddDetail( ({"staub"}),
	    "Der Staub liegt schon sehr dick auf dem Boden. Die einzigen "
            "Spuren, die Du siehst, gehoeren Dir selbst."); 
  
  AddDetail( ({"spuren"}), 
            "Die Spuren sind von Dir.");

  AddDetail( ({"stein"}),
	    "Es sind grosse Steinquader, die sauber verfugt sind.");

  AddDetail( ({"steinquader","quader"}),
	    "Die grossen Steinquader bilden eine massive Mauer. Du erkennst "
            "auch gerade so die kleinen Fugen. Auf den ersten Blick haette es "
            "auch ein einziger Block sein koennen.");

  AddDetail( ({"block","23","dreiundzwanzig"}), 
            "Es sind genau dreiundzwanzig, wenn Du es genau wissen willst.");

  AddDetail( ({"blick","augen","besten"}),
	    "Deine Augen sind auch nicht mehr die Besten.");

  AddDetail( ({"fugen"}),
	    "In den Fugen ist kein Loch zu erkennen. Der Moertel ist kaum "
            "herausgebroeselt."); 
  
  AddDetail( ({"moertel","jahrhunderte"}), 
            "Der Moertel in den Fugen ist immer noch hart, obwohl er schon "
            "Jahrhunderte alt ist.");

  AddDetail( ({"knochen"}),
	    "Es sind keine Knochen zu sehen, nur die Totenkoepfe werden hier "
            "gelagert. Vielleicht findest Du die Knochen noch auf Deinem Weg "
            "durch den Tempel.");

  AddDetail( ({"weg"}),
	    "Der Weg ist noch lang.");

  AddSmell(DEFAULT_SMELL, "Es riecht nach Staub.");  
 
  AddSmell( ({"staub"}),
	   "Als Du an dem Staub riechst, musst Du niesen.");

  AddSound(DEFAULT_SOUND, "Die Flammen der Fackeln knistern ein wenig.");

  AddSound( ({"flammen","fackeln"}),
	   "Die Fackeln knistern ganz normal, wie es Fackeln die brennen "
           "tun.");
  
//-----Details Ende-----
  
AddExit("westen", ROOM "tem37");

}

