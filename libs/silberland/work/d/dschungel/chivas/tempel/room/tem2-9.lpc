// von Chivas
inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

int anzahl;

void create()
	
{
  ::create();

  anzahl = 1;

  SetProp( P_INT_SHORT, "In einem Tempel");
  SetProp( P_INT_LONG,
        "Du stehst in einer grossen, von blaeulich schimmernden Fackeln "
        "erhellten Kammer. Direkt vor Dir fuehrt eine steinerne Wendeltreppe "
        "hinauf auf die dritte Ebene im Tempel. An den Waenden stehen alte, "
        "verrostete Ritterruestungen, die ein wenig schaebig und "
        "blutverschmiert aussehen." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----

  AddDetail( ({"fackeln"}), 
            "Die Fackeln schimmern in einem kalten Blau.");

  AddDetail( ({"kammer","sachen"}),
	    "In der Kammer sind die einzig interessanten Sachen die Ruestungen "
            "und die Wendeltreppe, die auf die dritte Ebene im Tempel fuehrt.");

  AddDetail( ({"wendeltreppe","treppe"}),
	    "Die steinerne Wendeltreppe fuehrt hoch auf die dritte Ebene im "
            "Tempel. Die einzelnen Stufen sind mit Rissen zerfurcht.");

  AddDetail( ({"tempel","tempels"}),
	    "Du befindest Dich mitten im Tempel. Momentan bist Du auf der "
            "zweiten Ebene.");

  AddDetail( ({"waende","waenden"}),
	    "An den Waenden stehen alte Ritterruestungen und die ueblichen "
            "Fackeln haengen in ihren Halterungen."); 
  
  AddDetail( ({"ritterruestungen","ruestungen"}), 
            "Die Ruestungen sind nicht mehr zu gebrauchen. Sie sind rostig und "
            "man kann sie sicher nicht mehr bewegen. An ihnen klebt "
            "getrocknetes Blut.");

  AddDetail( ({"boden"}),
	    "Am Boden sind die ueblichen Steinplatten des Tempels zu sehen.");

  AddDetail( ({"decke","himmel"}),
	    "An der Decke sind ein paar Verzierungen zu erkennen.");

  AddDetail( ({"blau","eis"}), 
            "Das Blau der Fackeln glaenzt wie Eis.");

  AddDetail( ({"ebene"}),
	    "Momentan bist Du noch auf der zweiten Ebene. Ueber die "
            "Wendeltreppe kommst Du auf die dritte Ebene.");

  AddDetail( ({"stufen","rissen","risse"}),
	    "Auf den Stufen der Wendeltreppe sind tiefe Risse zu erkennen. "
            "Ein Riss sieht etwas anders aus."); 
  
  AddDetail( ({"riss"}), 
            "In dem Riss scheint Etwas zu stecken.");

  AddDetail( ({"etwas"}),
	    "Vielleicht kannst Du es aus dem Riss ziehen?");

  AddDetail( ({"halterungen"}),
	    "Die Halterungen sind sehr uninteressant.");

  AddDetail( ({"blut","schauer","ruecken","zeugen","kampfes","kampf"}), 
            "Anscheinend wurden sie Zeugen eines schlimmen Kampfes in dieser "
            "Kammer und das Blut ist bis auf die Ruestungen gespritzt. Ein "
            "Schauer laeuft Dir den Ruecken runter.");

  AddDetail( ({"verzierungen"}),
	    "Die Verzierungen scheinen magisch zu sein. Sie zeigen ein "
            "komisches Bild.");

  AddDetail( ({"bild"}),
	    "Du erkennst Dich selbst, wie Du in dieser Kammer stehst und an "
            "die Decke schaust. Du bist ein wenig verwirrt."); 
  
  AddDetail( ({"steinplatten","platten","blick","steinplatte"}), 
            "Erst auf den zweiten Blick bemerkst Du, dass die Platten doch ein "
            "wenig anders sind als sonst. Auf den Steinplatten sind kleine "
            "Runen eingraviert, die auch ein wenig golden schimmern.");

  AddDetail( ({"runen"}),
	    "Auch die Runen scheinen magisch zu sein. Du kannst genau vier "
            "Runen auf den ganzen Platten entdecken. Nicht auf jeder "
            "Steinplatte ist eine eingraviert.");

  AddDetail( ({"rune"}),
	    "Welche Rune meinst Du? Rune 1, Rune 2, Rune 3 oder Rune 4?");

  AddDetail( ({"rune 1","rune eins","tod","warnung"}),
	    "Die erste Rune stellt das Wort Tod dar. Du solltest besser die "
            "Finger von dieser Rune lassen. Du kannst sie natuerlich auch "
            "trotz der Warnung beruehren.");

  AddDetail( ({"rune 2","rune zwei","vegiftung"}), 
            "Die zweite Rune stellt das Wort Vergiftung dar. Klingt auch nicht "
            "sehr nett. Beruehre sie und Du siehst, was geschieht.");

  AddDetail( ({"rune 3","rune drei","ueberraschung"}),
	    "Die dritte Rune stellt das Wort Ueberraschung dar. Solltest Du es "
            "wagen? Wenn Du mutig bist, beruehre sie einfach.");

  AddDetail( ({"rune 4","rune vier","heilung"}),
	    "Die vierte Rune stellt das Wort Heilung dar. Damit kannst Du "
            "endlich was anfangen. Ein Beruehrung wird Dir zeigen, was "
            "geschieht."); 
  
  AddDetail( ({"wort"}), 
            "Du untersuchst wirklich alles, oder ist das ein Script?");

  AddDetail( ({"script"}),
	    "Dies ist eine Scriptfalle. Nicht weiter untersuchen.");

  AddSpecialDetail( ({ "scriptfalle" }), "faketod" );

  AddSmell(DEFAULT_SMELL, "Es riecht ein wenig nach Blut.");  
 
  AddSmell( ({"blut","geruch"}),
	   "Der Geruch kommt von dem Blut an den Ruestungen.");

  AddSound(DEFAULT_SOUND, "Du hoerst die Magie von der Ebene ueber Dir "
                          "knistern.");

  AddSound( ({"magie","ebene"}),
	   "Anscheinend nimmt die Magie von Ebene zu Ebene zu.");
  
//-----Details Ende-----
  
AddExit("rauf", ROOM "tem3-9");
AddExit("norden", ROOM "tem2-8");

AddCmd( ({"zieh", "ziehe" }), "ziehen" );
AddCmd( ({"beruehr", "beruehre" }), "beruehren" );

}
void reset()
{
  ::reset();
  anzahl=1;
}
int ziehen(string str)
{
   notify_fail("Was moechtest Du woraus ziehen?\n");
   if ( member( ({ "etwas aus riss", "etwas aus stufe" }),str) != -1) 
  {
    write(BS( "Du ziehst eine alte abgebrochene Klinge aus dem Riss. Anscheinend "
           "ist sie bei einem Kampf abgebrochen. Sie hat leider keinen Wert "
           "und Du wirfst sie weg.\n"));
    say( TPN+" findet etwas, aber wirft es wieder weg.\n");
    return 1;
  }
}
string faketod()
{
  SetProp(P_KILL_NAME, "Eine Scriptfalle");
  write("Du loest eine Scriptfalle aus.\n");
  TP->SetProp(P_GHOST, 1);
  TP->move("/room/death/death_room", M_GO);
  return "";
}
int beruehren(string str)
{
 notify_fail("Welche Rune willst Du beruehren? \n");

 if(!str || str == "") return 0;
 if(!(str == "rune 1" ||
      str == "rune 2" ||
      str == "rune 3" ||
      str == "rune 4" )) return 0;
 

 if( str == "rune 1"){
    
  write(BS("Du beruehrst die erste Rune und Du spuerst, wie ein starker "
           "Schmerz Dir durch die Glieder faehrt.\n"));
 
  say(TPN+" beruehrt etwas und faellt tot um.\n");
  SetProp(P_KILL_NAME, "Dummheit");
  write("Du hast die Warnung ignoriert.\n");
  TP->SetProp(P_GHOST, 1);
  TP->move("/room/death/death_room", M_GO);
  return 1;
 }

 if( str == "rune 2"){
 
  write(BS("Du beruehrst die zweite Rune und Du merkst, wie eine Vergiftung "
           "Deinen Koerper ergreift.\n"));
 
  say(TPN+" beruehrt etwas und fuehlt sich sehr schlecht.\n");
  TP->AddHp(-15);
  this_player()->AddPoison(2);
  return 1;
 }

 if( str == "rune 3"){
 
  write(BS("Du beruehrst die dritte Rune und fuehlst, wie Du weggerissen "
           "wirst.\n"));
 
  say(TPN+" beruehrt etwas und sieht verzweifelt aus.\n");
  this_player()->move(ROOM "temz2", M_TPORT);
  return 1;
 }

 if( str == "rune 4"){
 
  write(BS("Du beruehrst die vierte Rune und Du merkst, wie Dich eine "
           "staerkende Kraft durchfaehrt.\n"));
 
  say(TPN+" beruehrt etwas und fuehlt sich besser.\n");
    if ( anzahl )
    {
    TP->AddHp(80);
    anzahl--;
    }
    return 1;
  }
}

