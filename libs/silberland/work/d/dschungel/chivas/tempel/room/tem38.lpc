// von Chivas
inherit "std/room";

#include "../def.h"

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Tempel");
  SetProp( P_INT_LONG,
        "In dieser Kammer ist ein fuerchterlicher Gestank und der ganze Boden "
        "ist mit Wuermer und ekligem Getier uebersaet. Anscheinend sind hier "
	"erst vor kurzem ein paar neugierige Abenteurer wie Du ums Leben "
        "gekommen." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );
  
//-----Details Anfang-----
  
  AddDetail( ({"kammer","hand","nase","augen"}), 
            "Es stinkt in der Kammer fuerchterlich. Du haeltst Dir die Hand "
            "vor die Nase und Deine Augen traenen durch den beissenden "
            "Gestank.");

  AddDetail( ({"gestank"}),
	    "Den Gestank kann man nur riechen.");

  AddDetail( ({"boden"}),
	    "Der ganze Boden wuselt vor sich hin, es sind lauter Wuermer und "
            "anderes Getier. Die Steinplatten sind unter den Wuermern kaum "
            "wahrzunehmen.");

  AddDetail( ({"wuermer","wuermern","wurm"}), 
            "Lauter dicke und grosse Wuermer bewegen sich auf dem Boden. Aus "
            "einem grossen Haufen von Wuermern schaut Etwas hervor.");

  AddDetail( ({"getier"}),
	    "Es sind alle moeglichen Arten von Insekten. Ausserdem erkennst Du "
            "auch ein paar Schlangen.");

  AddDetail( ({"abenteurer","teppich"}),
	    "Du kannst zwar keinen sehen, aber Du willst auch nicht wissen "
            "was unter dem Teppich aus Wuermern und Insekten zu finden ist."); 
  
  AddDetail( ({"leben"}), 
            "Noch bist Du am Leben und so soll das auch bleiben.");

  AddDetail( ({"decke","himmel"}),
	    "An der Decke ist nichts interessantes zu erkennen.");

  AddDetail( ({"waende","waenden","wand"}),
	    "An den Waenden haengen ein paar Fackeln, die die Kammer ein wenig "
            "erhellen.");

  AddDetail( ({"steinplatten","platten"}), 
            "Die Steinplatten erkennst Du durch das Durcheinander am Boden "
            "kaum.");

  AddDetail( ({"durcheinander"}),
	    "Ein grosses Durcheinander an den unterschiedlichsten Wuermern, "
            "Insekten usw..");

  AddDetail( ({"haufen"}),
	    "In einem Haufen von Wuermern steckt Etwas."); 
  
  AddDetail( ({"etwas"}), 
            "Es ist ein Knochen an dem die Wuermer zu nagen scheinen.");

  AddDetail( ({"knochen"}),
	    "Der Knochen ist schon fast komplett sauber. Trotzdem wird Dir "
            "schlecht und Du musst Dich fast uebergeben.");

  AddDetail( ({"schlangen","schlange"}),
	    "Du kennst die Schlangen nicht und versuchst, ihnen auch nicht "
            "zu nahe zu kommen, da Du nicht weisst, ob sie giftig sind.");

  AddDetail( ({"arten","insekten","kaefer","kaefern","ameisen","art","insek","ameise"}), 
            "Die Insekten reichen von kleinen roten Kaefern bis zu fetten "
            "Ameisen.");

  AddDetail( ({"fackeln","anblick"}),
	    "Die Fackeln brennen in ihrem magischen gruenen Licht. Du hast "
            "Dich an den Anblick schon gewoehnt.");

  AddDetail( ({"licht"}),
	    "Durch das Licht kannst Du wenigstens ein bisschen was erkennen."); 

  AddSmell(DEFAULT_SMELL, "Hier ist ein ekeliger Gestank.");  
 
  AddSmell( ({"gestank"}),
	   "Es riecht nach Verwesung.");

  AddSmell( ({"verwesung","geruch"}),
	   "Der Geruch der Verwesung stammt von ein paar Knochen, die aus den "
           "Wuermern herausragen.");

  AddSound(DEFAULT_SOUND, "Es knirscht, wenn Du ueber den Boden gehst.");

  AddSound( ({"knirschen","boden"}),
	   "Das Knirschen stammt vom Zertreten der Insekten und Wuermer. "
           "Ekelig!");
  
  AddSound( ({"zertreten"}),
		"knirsch, knirsch, knack, knirsch");

//-----Details Ende-----
  
AddExit("norden", ROOM "tem35");
AddExit("nordosten", ROOM "tem39");
AddExit("nordwesten", ROOM "tem35");
AddExit("osten", ROOM "tem35");
AddExit("westen", ROOM "tem35");
AddExit("suedosten", ROOM "tem35");
AddExit("suedwesten", ROOM "tem35");
AddExit("sueden", ROOM "tem37");

}

