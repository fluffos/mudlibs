// von Chivas
inherit "std/room";

#include "../def.h"

void create()
	
{
  ::create();

  AddRoomMessage( ({ "Du versinkst langsam im Sand. Du solltest Dich nicht zu "
                     "lange hier aufhalten.\n","Du bist dabei im Sand zu versinken.\n"}),
                     30 );

  SetProp( P_INT_SHORT, "In einem Tempel");
  SetProp( P_INT_LONG,
        "Du stehst in einem kleinen Saal, wo der Boden mit Sand bedeckt ist. "
        "Du erkennst im Sand einige Gegenstaende, als ob etwas im Sand "
        "versunken ist. An den Waenden haengen die ueblichen Fackeln und "
        "spenden Dir ein wenig Licht. Die Decke ist mit einer Zeichnung "
        "versehen. Auch dieser Raum strahlt eine magische Energie aus, wie "
        "Du sie auf den unteren Ebenen nicht gespuert hast." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_DESERT]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----

  AddDetail( ({"saal","kammer","raum"}), 
            "Der kleine Saal ist eher eine grosse Kammer, aber das ist auch "
            "nicht so wichtig. Interessant ist viel mehr der Sand auf dem "
            "Boden.");

  AddDetail( ({"boden","platten"}),
	    "Am Boden sind diesmal keine Platten zu sehen. Der gesamte Boden "
            "ist mit Sand bedeckt.");

  AddDetail( ({"sand"}),
	    "Der Sand ist sehr weich und man kann sehr schnell in ihm "
            "versinken. Einige Gegenstaende scheinen im Sand zu stecken.");

  AddDetail( ({"gegenstaende"}), 
            "Du kannst die Gegenstaende nicht so gut sehen. Du musst sicher "
            "im Sand wuehlen um sie zu bekommen.");

  AddDetail( ({"waende","waenden"}),
	    "An den Waenden haengen ein paar Halterungen, in denen die "
            "ueblichen Fackeln stecken.");

  AddDetail( ({"fackeln","flammen"}),
	    "Die Fackeln erhellen den Saal mit ihrem roetlichen Flammen."); 
  
  AddDetail( ({"licht","schein"}), 
            "Du kannst durch den Schein der Fackeln recht gut sehen.");

  AddDetail( ({"decke","himmel"}),
	    "An der Decke faellt Dir eine grosse Zeichnung auf.");

  AddDetail( ({"zeichnung"}),
	    "Die Zeichnung scheint eine Karte zu sein.");

  AddDetail( ({"halterungen"}), 
            "Die Halterungen haben wunderschoene Verzierungen.");

  AddDetail( ({"karte"}),
	    "Die Karte zeigt anscheinend die Wueste im Silberland.");

  AddDetail( ({"verzierungen"}),
	    "Die Verzierungen sind kleine Runen."); 
  
  AddDetail( ({"silberland"}), 
            "Das Silberland ist toll. Du bist mittendrin.");

  AddDetail( ({"ebenen","ebene","tempel"}),
	    "Du bist auf der dritten Ebene im Tempel.");

  AddDetail( ({"energie"}),
	    "Du kannst die magische Energie spueren, die diesen Saal "
            "magisch erschaffen hat.");

  AddDetail( ({"wueste","leben"}), 
            "Die Wueste auf der Karte wirkt riesig. Du siehst viel Sand, aber "
            "auch Orte, wo Leben zu sein scheint.");

  AddDetail( ({"orte"}),
	    "Du beschliesst diese Orte einmal aufzusuchen, wenn Du hier lebend "
            "raus kommst.");

  AddDetail( ({"runen","rune"}),
	    "Die Runen bedeuten Hitze, Wueste und Tod."); 

  AddSpecialDetail( ({ "hitze" }), "hitze" );
  
  AddDetail( ({"wueste"}),
	    "Die Rune Wueste schimmert leicht im Schein der roetlichen "
            "Fackeln.");

  AddDetail( ({"tod"}),
	    "Die Rune Tod beunruhigt Dich ein wenig.");

  AddSmell(DEFAULT_SMELL, "Es riecht recht steril in diesem Saal. Du kannst "
                          "nichts riechen.");  
 
  AddSound(DEFAULT_SOUND, "Du hoerst den Sand unter Deinen Fuessen knirschen.");

  AddSound( ({"sand","fuessen","fuesse"}),
	   "*knirsch*");
  
//-----Details Ende-----
AddItem(NPC "golemg", REFRESH_DESTRUCT);
  
AddExit("osten", ROOM "tem3-4");
AddExit("sueden", ROOM "tem3-2");
AddExit("suedosten", ROOM "tem3-1");

AddCmd( ({"wuehl", "wuehle" }), "wuehlen" );

}
int wuehlen(string str)
{
   notify_fail("Worin moechtest Du wuehlen?\n");
   if ( member( ({ "in sand" }),str) != -1) 
  {
    write(BS( "Du wuehlst im Sand und findest nur alte kaputte Ruestungsteile "
           "und wirfst sie wieder weg.\n"));
    say( TPN+" wirft enttaeuscht etwas weg.\n");
    return 1;
  }
}
string hitze(string key)
{
  say( TPN+" untersucht etwas und es wird auf einmal viel waermer hier im "
           "Saal.\n");
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 40, ENV_TERRAIN: TT_DESERT]) );
  return(BS("Als Du die Rune Hitze untersuchst, wird Dir auf einmal sehr heiss.\n"));
}

