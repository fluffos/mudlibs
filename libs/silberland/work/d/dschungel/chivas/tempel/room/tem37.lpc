// von Chivas
inherit "std/room";

#include "../def.h"

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Tempel");
  SetProp( P_INT_LONG,
        "An den Waenden sind lauter Einbuchtungen, in denen Skelette von "
        "laengst verstorbenen Abenteurern liegen. Am Boden liegen auch einige "
	"Knochen, aber nicht so viele wie Totenkoepfe in der Kammer im "
        "Osten. Ein paar Spuren sind auch zu erkennen." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"wand","waende","waenden"}), 
            "An den Waenden sind grosse Einbuchtungen zu erkennen. Ausserdem "
            "haengen die ueblichen Fackeln in den Halterungen und hellen den "
            "duesteren Raum ein wenig auf.");

  AddDetail( ({"einbuchtungen","einbuchtung"}),
	    "In den Einbuchtungen liegen Skelette von Abenteurern, die hier "
            "ihren Tod gefunden haben. Sie wurden mit allen Ehren in die "
            "Einbuchtungen gelegt und nicht von den Kreaturen im Tempel "
            "geschaendet. Anscheinend werden sie von einer magischen Kraft "
            "beschuetzt.");

  AddDetail( ({"skelette","toten","leben"}),
	    "Die Skelette in den Einbuchtungen stammen von Elfen, Menschen und "
            "Feen, die hier im Tempel ihr Leben gelassen haben. Ihre Skelette "
            "wurden von ihren Freunden in diesen Einbuchtungen magisch "
            "versiegelt, so dass keine der Kreaturen im Tempel sie schaenden "
            "kann. Du erkennst die teilweise wertvollen Waffen und Ruestungen, "
            "die normalerweise nicht lange dort gelegen haetten.");

  AddDetail( ({"abenteurer","abenteurern"}), 
            "Du bist auch einer.");

  AddDetail( ({"boden"}),
	    "Am staubigen Boden liegen einige Knochen und auch ein paar Spuren "
            "sind im Staub zu erkennen.");

  AddDetail( ({"knochen","oger","ogern","trolle","troll","trollen","betrachtung"}),
	    "Es sind nur ein paar Knochen und bei genauerer Betrachtung faellt "
            "Dir auf, dass es sich hauptsaechlich um Knochen von Ogern, "
            "Trollen und anderen boesartigen Kreaturen handelt."); 
  
  AddDetail( ({"totenkoepfe","anzahl"}), 
            "Es liegen hier nur Knochen auf dem Boden. Die Anzahl der Knochen "
            "ist aber bei weitem geringer als die Anzahl der Totenkoepfe in "
            "der Kammer die im Osten liegt.");

  AddDetail( ({"kammer","Osten"}),
	    "In der Kammer im Osten lagen hunderte von Totenkoepfe.");

  AddDetail( ({"spuren","hinweis","weg","richtungen","staub"}),
	    "Die Spuren stammen nicht alleine von Dir und sie fuehren in alle "
            "Richtungen. Sie bieten Dir leider keinen Hinweis auf den "
            "richtigen Weg.");

  AddDetail( ({"raum"}), 
            "Der Raum ist zwar duester, jedoch fuehlst Du Dich durch den "
            "magischen Schimmer der die Einbuchtungen umgibt auch ein wenig "
            "geschuetzt.");

  AddDetail( ({"fackeln","flammen","schein"}),
	    "Die Fackeln erhellen den Raum nur ein wenig mit ihren gruenen "
            "Flammen.");

  AddDetail( ({"halterungen"}),
	    "Die Halterungen haengen an der Wand und halten die brennenden "
            "Fackeln."); 
  
  AddDetail( ({"tod"}), 
            "Tod sagt: WAS WILLST DU VON MIR, DU STIRBST DOCH ERST IN "
            "ZEHN MINUTEN. MELDE DICH DANN NOCH EINMAL BEI MIR.");

  AddDetail( ({"ehren"}),
	    "Sie wurden mit ihren Waffen und Ruestungen bestattet und bisher "
            "von keiner Kreatur geschaendet.");

  AddDetail( ({"kreaturen","kreatur"}),
	    "Es gibt viele schreckliche Kreaturen im Tempel.");

  AddDetail( ({"tempel","erdgeschoss"}), 
            "Der Tempel ist riesig und Du fragst Dich, wie gross das "
            "Erdgeschoss noch ist.");

  AddDetail( ({"kraft"}),
	    "Als Du Dich einer Einbuchtung ein wenig mehr naeherst, erkennst "
            "Du einen goldenen Schimmer.");

  AddDetail( ({"schimmer"}),
	    "Der Schimmer scheint die Einbuchtungen zu schuetzen. Du haettest "
            "nicht geglaubt, dass es auch gute Magie im Tempel gibt, die etwas "
            "beschuetzt."); 
  
  AddDetail( ({"magie","arten"}), 
            "Es gibt verschiedene Arten von Magie.");

  AddDetail( ({"elfen","menschen","feen","rassen","gute"}),
	    "Dies sind die Rassen der Toten. Sie traten wohl fuer das Gute ein "
            "und fanden den Tod.");

  AddDetail( ({"waffen"}),
	    "Die Waffen der Toten sehen immer noch scharf und gefaehrlich "
            "aus. Jedoch kannst Du Dir keine nehmen, da sie durch Magie "
            "geschuetzt werden.");

  AddDetail( ({"ruestungen","glanz"}), 
            "Die Ruestungen strahlen immer noch einen Glanz im Schein der "
            "Fackeln aus. Auch an sie kommst Du nicht heran.");

  AddDetail( ({"decke","himmel"}),
	    "Die Decke ist schmucklos.");

  AddDetail( ({"freunde","freunden"}),
	    "Du hoffst jemand wuerde dies auch fuer Dich tun."); 
  
  AddSmell(DEFAULT_SMELL, "Es riecht ein wenig staubig.");  
 
  AddSmell( ({"staub"}),
	   "Du musst niesen.");

  AddSound(DEFAULT_SOUND, "Man hoert nur das Knistern der Flammen.");

  AddSound( ({"flammen","knistern"}),
	   "Die Flammen flackern und knistern ein wenig.");
  
  AddReadDetail( ({""}),
		"");

//-----Details Ende-----
AddItem(NPC "ridubar", REFRESH_DESTRUCT);
  
AddExit("norden", ROOM "tem38");
AddExit("nordosten", ROOM "tem35");
AddExit("nordwesten", ROOM "tem35");
AddExit("osten", ROOM "tem36");
AddExit("westen", ROOM "tem35");
AddExit("suedosten", ROOM "tem35");
AddExit("suedwesten", ROOM "tem35");
AddExit("sueden", ROOM "tem35");

}

