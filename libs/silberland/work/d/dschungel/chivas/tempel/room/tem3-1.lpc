// von Chivas
inherit "std/room";

#include "../def.h"

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Tempel");
  SetProp( P_INT_LONG,
        "Dies ist eine grosse kreisrunde Kammer, wo in der Mitte "
        "eine Wendeltreppe in die Tempelspitze fuehrt. Beim Anblick der "
        "Statuen und der Treppe straeuben sich Dir saemtliche Nackenhaare. Du "
        "hast das Gefuehl, dass der wahre Schrecken des Tempels direkt ueber "
        "Dir haust. Du siehst ein kleines, fluechtig aufgestelltes Schild an "
        "der Treppe lehnen. Derjenige, der es aufstellen wollte, hatte wohl "
        "nicht mehr genug Zeit, es richtig zu befestigen." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"kammer","weg"}), 
            "Die scheint wohl die letzte Kammer auf Deinem Weg bis in die "
            "Spitze des Tempels zu sein. Ein langer und steiniger Weg liegt "
            "hinter Dir.");

  AddDetail( ({"mitte"}),
	    "In der Mitte windet sich eine breite Wendeltreppe in die "
            "Tempelspitze.");

  AddDetail( ({"wendeltreppe","treppe"}),
	    "Die breite steinige Wendeltreppe fuehrt wohl in die Tempelspitze, "
            "die sich genau ueber Dir zu befinden scheint. An der Treppe lehnt "
            "ein kleines Schild, was wohl aufgestellt werden sollte, aber es "
            "wohl aus Zeitgruenden nicht mehr dazu gekommen ist.");

  AddDetail( ({"tempelspitze","spitze"}), 
            "Aus der Tempelspitze quillt ein wenig Qualm in die Kammer "
            "herunter.");

  AddDetail( ({"anblick","nackenhaare","spannung"}),
	    "Eigentlich straeuben sich Deine Nackenhaare schon seit dem "
            "Erdgeschoss, aber diesmal wohl mehr vor Spannung, was Dich oben "
            "erwarten wird.");

  AddDetail( ({"statuen","statue","seiten"}),
	    "An beiden Seiten der Treppe steht jeweils eine trollhohe Statue. "
            "Beide Statuen stellen Golems dar, die grosse Keulen in der Hand "
            "haben und die Treppe bewachen zu scheinen. Du denkst aber nicht, "
            "dass sie Dich daran hindern werden, nach oben zu gehen."); 
  
  AddDetail( ({"gefuehl","schlimmste"}), 
            "Du hast sicher recht, dass das Schlimmste noch kommen wird.");

  AddDetail( ({"schrecken"}),
	    "Der Schrecken wohnt sicher oben in der Tempelspitze.");

  AddDetail( ({"tempel","tempels"}),
	    "Du bist nun fast in der Tempelspitze angekommen. Du hast schon "
            "einen weiten Weg durch den Tempel hinter Dir gebracht.");

  AddDetail( ({"schild","holzschild","schildes"}), 
            "Ein kleines Holzschild lehnt an der Treppe, was nicht richtig "
            "aufgestellt wurde. Auf dem Schild steht etwas geschrieben und Du "
            "kannst es lesen.");

  AddDetail( ({"zeit","zeitgruenden","zeitgruende","aufstellen"}),
	    "Die Zeit hat wirklich nicht gereicht. Derjenige der das Schild "
            "aufstellen wollte, liegt als Skelett neben dem Schild, wie Du "
            "gerade gesehen hast.");

  AddDetail( ({"qualm"}),
	    "Dicker weisser Qualm dringt durch die Oeffnung in der Decke, "
            "durch die die Treppe nach oben fuehrt."); 
  
  AddDetail( ({"erdgeschoss"}), 
            "Das Erdgeschoss ist weit unter Dir.");

  AddDetail( ({"golem","golems"}),
	    "Die Golems bestehen aus hartem Granit. Sie sind eigentlich "
            "wunderschoen gearbeitet, obwohl die Golems ansich sehr haesslich "
            "sind.");

  AddDetail( ({"keulen","hand"}),
	    "Die Keulen sehen gross und schwer und natuerlich auch gefaehrlich "
            "aus.");

  AddDetail( ({"granit","gestein"}), 
            "Granit ist ein sehr hartes Gestein.");

  AddDetail( ({"skelett"}),
	    "Du weisst jetzt, warum es nicht mehr zum Aufstellen des Schildes "
            "gekommen ist. Das Skelett sieht irgendwie abgenagt aus. Du "
            "erschauerst.");

  AddDetail( ({"oeffnung"}),
	    "Durch die Oeffnung in der Decke fuehrt eine Treppe nach oben. "
            "Ausserdem quillt weisser Qualm von oben nach unten."); 
  
  AddDetail( ({"decke","himmel"}), 
            "Die Decke ist recht kahl. Bis auf die Oeffnung in der Decke ist "
            "nichts interessantes zu erkennen.");

  AddDetail( ({"boden"}),
	    "Am Boden sind grosse Marmorplatten zu erkennen.");

  AddDetail( ({"fackeln","flammen"}),
	    "Die Fackeln erhellen die Kammer mit ihren blutroten Flammen.");

  AddDetail( ({"waende","waenden","wand"}),
	    "An den Waenden haengen ein paar Gemaelde und die ueblichen "
            "Fackeln.");

  AddDetail( ({"marmor","marmorplatten","platten"}), 
            "Auf dem teuren Marmor ist kein Staubkorn zu erkennen. Aber an "
            "einer Stelle ist noch Etwas anderes zu sehen.");

  AddDetail( ({"stelle","etwas"}),
	    "Du siehst einige Tropfen Blut auf dem weissen Marmor.");

  AddDetail( ({"tropfen","blut","punkt"}),
	    "Als Du die Tropfen naeher betrachtest, merkst Du, dass das Blut "
            "noch frisch ist. Ein weiterer Punkt, der Dich sehr beunruhigt."); 
  
  AddDetail( ({"gemaelde"}), 
            "Die Gemaelde sind zerrissen. Du kannst nichts mehr auf ihnen "
            "erkennen. Eigentlich haengen nur noch die Rahmen.");

  AddDetail( ({"rahmen"}),
	    "Die Rahmen haengen zwar noch an den Waenden, jedoch sehen sie "
            "sehr ruiniert aus. Du erkennst viele Kratzspuren auf ihnen.");

  AddDetail( ({"kratzspuren","spuren"}),
	    "Die Kratzspuren sind sehr tief. Sie muessen von scharfen starken "
            "Krallen stammen.");

  AddDetail( ({"krallen"}), 
            "Diesen Krallen willst Du nicht zu nahe kommen.");

  AddDetail( ({"nase","rasse"}),
	    "Du hast fuer Deine Rasse eine sehr grosse Nase.");

  AddDetail( ({"staubkorn","staub"}),
	    "Es gibt keinen Staub zu sehen."); 
  
  AddSmell(DEFAULT_SMELL, "Der Qualm, der von oben herunter kommt, sticht in "
                          "Deiner Nase.");  
 
  AddSmell( ({"qualm","fleisch"}),
	   "Der Qualm riecht nach verbranntem Fleisch. Dir wird ein wenig "
           "schlecht.");

  AddSound(DEFAULT_SOUND, "Du hoerst von oben ein lautes Knurren und Bruellen.");

  AddSound( ({"bruellen","knurren"}),
	   "Da musst Du wohl nach oben gehen, um heraus zu finden, was es ist.");
  
  AddReadDetail( ({"schild"}),
		"+-----------------------------------------+\n"
                "|                                         |\n"
                "|   Abenteurer sei gewarnt, wenn Du es    |\n"
                "|    wagst, den Herrscher des Tempels     |\n"
                "|   anzugreifen, so achte darauf, dass    |\n"
                "|      Du manchmal nicht die Chance       |\n"
                "|    bekommst, nach unten zu fluechten.   |\n"
                "|                                         |\n"
                "|     Tip: Mit einem Sprung aus der       |\n"
                "|     Tempelspitze (springe runter),      |\n"
                "|     kannst Du vielleicht Dein Leben     |\n"
                "|     retten!                             |\n"
                "|                       gez. Chivas       |\n"
                "|                                         |\n"
                "+-----------------------------------------+\n");

//-----Details Ende-----
  
AddExit("westen", ROOM "tem3-2");
AddExit("rauf", ROOM "tem4-1");
AddExit("osten", ROOM "tem3-6");
AddExit("sueden", ROOM "tem3-8");
AddExit("norden", ROOM "tem3-4");
AddExit("nordwesten", ROOM "tem3-3");
AddExit("nordosten", ROOM "tem3-5");
AddExit("suedosten", ROOM "tem3-7");
AddExit("suedwesten", ROOM "tem3-9");

}

