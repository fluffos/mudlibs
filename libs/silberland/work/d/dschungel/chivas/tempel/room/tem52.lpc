// von Chivas
inherit "std/room";

#include "../def.h"

void create()
	
{
  ::create();


  SetProp( P_INT_SHORT, "In einem Tempel");
  SetProp( P_INT_LONG,
        "Du befindest Dich wieder in einer Halle. Der Boden ist mit grossen "
        "Granitplatten ausgelegt und kein Staubkorn ist zu sehen. Das "
	"Imposanteste an der Halle ist jedoch die riesige Steintreppe, die "
        "nach oben fuehrt. Links und rechts von ihr stehen zwei mannshohe "
        "Statuen in der Form kleiner Drachen." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  
  AddDetail( ({"halle","blickfang"}), 
            "Die Halle ist sehr gross und der Blickfang der Halle ist eine "
            "imposante Steintreppe, die anscheinend auf die erste Ebene des "
            "Tempels fuehrt.");

  AddDetail( ({"boden","oberflaeche"}),
	    "Die Granitplatten im Boden sehen aus wie eine einzige "
            "Oberflaeche. Man kann die Fugen zwischen den Platten nur erahnen. "
            "Auf den Platten ist eine riesige Karte abgebildet.");

  AddDetail( ({"granitplatten","platten"}),
	    "Die Platten sind makellos. Nicht ein Staubkorn befindet sich auf "
            "ihnen.");

  AddDetail( ({"staubkorn","staub"}), 
            "Es gibt keinen Staub in der Halle. Der Boden sieht so aus, als "
            "ob er erst eben gesaeubert wurde.");

  AddDetail( ({"impulsanteste","steintreppe","treppe"}),
	    "Die Steintreppe hat ungeheure Ausmasse. Es koennten sicher ein "
            "Dutzend Krieger nebeneinander hoch gehen. Sie scheint komplett "
            "aus Marmor zu bestehen, in dem sich die Fackeln an den Waenden "
            "spiegeln. An beiden Seiten der Treppe stehen mannshohe Statuen.");

  AddDetail( ({"statuen","seiten"}),
	    "Die Treppe wird von zwei Statuen flankiert, die das Aussehen von "
            "zwei Drachen haben."); 
  
  AddDetail( ({"form","drachen","aussehen"}), 
            "Die Drachen bestehen zwar aus einem Dir unbekannten Material, "
            "da die Statuen nicht wie normale Statuen aus Stein wirken. Die "
            "Drachen scheinen Dich anzuschauen und aus ihren Nuestern kommt "
            "Qualm.");

  AddDetail( ({"material","stein"}),
	    "Du weisst nicht was fuer ein Material das ist, ausser das es kein "
            "Stein ist."); 

  AddDetail( ({"wand","waende"}),
	    "An den Waenden haengen Gemaelde und die ueblichen Fackeln, obwohl "
            "hier mehr Fackeln haengen als im ganzen Erdgeschoss zusammen.");

  AddDetail( ({"decke"}),
	    "Die Decke ist wie der Himmel bei Nacht bemalt.");

  AddDetail( ({"fugen"}), 
            "Du kannst keine Fugen entdecken, nur erahnen.");

  AddDetail( ({"qualm","nuestern"}),
	    "Schwarzer Qualm kommt aus den Nuestern der Statuen. Bei normalen "
            "Statuen hast Du so etwas noch nie gesehen. Ausserdem fallen Dir "
            "die Augen auf einmal auf.");

  AddDetail( ({"augen"}),
	    "Die Augen sind gelb und sehen intelligent aus. Sie blinzeln. Du "
            "bist Dir nicht mehr sicher, dass es wirklich Statuen sind."); 
  
  AddDetail( ({"karte","silberland"}), 
            "Die Karte am Boden zeigt das Silberland wie Du erkennen kannst. "
            "Du siehst Midas, Tijara, den Kristallwald, die Wueste mit "
            "Arrakeen, die Felseninsel, Roch Adan, Kyranda und vieles mehr. Dir "
            "fallen aber auch einige Gebiete auf, wo Du noch nie warst.");

  AddDetail( ({"fackeln"}),
	    "Es muessen hunderte von Fackeln sein. Ihr gruenlich magischer "
            "Schimmer erhellt die Halle.");

  AddDetail( ({"erdgeschoss","erdgeschosses"}),
	    "Du bist noch im Erdgeschoss, aber Du kannst ueber die Treppe "
            "auf die erste Ebene gelangen.");

  AddDetail( ({"himmel","nacht","zauber","sterne","sternen"}), 
            "Du erkennst die Sterne am Himmel. Ein sehr beeindruckender "
            "Zauber. Zwischen den Sternen erkennst Du auch was Besonderes.");

  AddDetail( ({"schimmer"}),
	    "Der magische Schimmer erhellt die ganze Halle.");

  AddDetail( ({"midas","kyranda","roch","adan","roch adan","tijara","arrakeen"}),
	    "Dies sind Staedte im Silberland."); 
  
  AddDetail( ({"staedte"}), 
            "Es gibt noch mehr, aber mehr wollte der faule Magier hier nicht "
            "aufzaehlen.");

  AddDetail( ({"magier"}),
	    "Magier sind faul und boese, jedoch bieten sie Dir manchmal auch "
            "einen schnelleren Weg aus dem Tempel. Du entdeckst ein kleines "
            "Schild und einen Hebel an der Wand.");

  AddDetail( ({"wueste","kristallwald","felseninsel","regionen"}),
	    "Das sind Regionen, wo Du sicher schon einmal warst.");

  AddDetail( ({"gebiete","namen"}), 
            "Du erkennst Gebiete und Namen auf der Karte, von denen Du noch "
            "nie gehoert hast. Du beschliesst sie aufzusuchen, wenn Du das "
            "hier ueberlebst.");

  AddDetail( ({"besonderes"}),
	    "Du siehst eine Schildkroete am Himmel.");

  AddDetail( ({"schildkroete"}),
	    "Auf dem Ruecken der Schildkroete stehen vier Elefanten."); 
  
  AddDetail( ({"ruecken","elefanten"}), 
            "Die Elefanten tragen eine kleine Scheibenwelt.");

  AddDetail( ({"scheibenwelt","blick"}),
	    "Du bekommst einen komplett neuen Blick fuer das Universum. Es "
            "gibt also noch andere Welten.");

  AddDetail( ({"welten"}),
	    "Du wirst nie viel ueber diese Welten erfahren. Du findest, Du "
            "musst erst einmal hier alles kennen.");

  AddDetail( ({"universum"}), 
            "Das Universum ist viel zu gross fuer Dich.");

  AddDetail( ({"weg"}),
	    "Das findest Du sehr nett, wenn es einen schnelleren Weg aus dem "
            "Tempel gibt.");

  AddDetail( ({"schild"}),
	    "Du kannst es lesen.");

  AddDetail( ({"hebel"}),
	    "Der Hebel ist klein und unauffaellig. Er besteht aus purem "
            "Gold."); 

  AddDetail( ({"gold"}),
	    "Das Gold glaenzt ein wenig im Schein der Fackeln.");  

  AddDetail( ({"schein"}),
	    "Der Schein der Fackeln huellt fast alles in der Halle ein.");

  AddDetail( ({"ebene"}),
	    "Die erste Ebene ist direkt ueber Dir. Du kannst sie ueber die "
            "Steintreppe erreichen."); 

  AddDetail( ({"ausmasse"}),
	    "Die Treppe ist wirklich breit.");  

  AddDetail( ({"tempel","tempels","ende"}),
	    "Du hast endlich das Ende des Erdgeschosses erreicht."); 

  AddDetail( ({"dutzend","krieger"}),
	    "So viele Krieger koennten nebeneinander die Treppe hochgehen, ohne "
            "sich gegenseitig zu stoeren."); 

  AddDetail( ({"marmor"}),
	    "Der Marmor glaenzt im Schein der Fackeln. Er ist sicher sehr "
            "teuer gewesen."); 

  AddDetail( ({"gemaelde"}),
	    "Alle Gemaelde stellen den Blutdrachen dar."); 

  AddDetail( ({"blutdrache","blutdrachen"}),
	    "Ob der Blutdrache in der Tempelspitze haust?"); 

  AddDetail( ({"tempelspitze","spitze"}),
	    "Die Spitze ist noch weit ueber Dir."); 

  AddSmell(DEFAULT_SMELL, "Es riecht nach Qualm.");  
 
  AddSmell( ({"qualm"}),
	   "Der Qualm sticht ein wenig in den Augen.");

  AddSound(DEFAULT_SOUND, "Du hoerst das magische Knistern der Fackeln.");

  AddSound( ({"knistern"}),
	   "Das Knistern ist hier besonders laut, da hier viel mehr Fackeln "
           "sind als sonst wo im Tempel.");
  
  AddReadDetail( ({"schild"}),
		"+----------------------------------+\n"
                "| Zieh an dem Hebel und Du stehst  |\n"
                "| wieder vor dem Tempel. Aber      |\n"
                "| bedenke, alles hat Folgen !!!    |\n"
                "+----------------------------------+\n");

//-----Details Ende-----
AddItem( "/d/gebirge/angrox/npc/ghoul", REFRESH_DESTRUCT,
        ([P_MNPC_DEFAULTROOM: "tem52",
          P_MNPC_AREA:({ROOM "tem52"}),
          P_MNPC_FLAGS: MOV_INDOORS + MOV_MAYLOAD + MOV_MOVES
        ]) );
AddItem( "/d/unterwelt/basics/central/npc/skelett", REFRESH_DESTRUCT,
        ([P_MNPC_DEFAULTROOM: "tem52",
          P_MNPC_AREA:({ROOM "tem52"}),
          P_MNPC_FLAGS: MOV_INDOORS + MOV_MAYLOAD + MOV_MOVES
        ]) );
  
AddExit("rauf", ROOM "tem1-9");
AddExit("sueden", ROOM "tem51");


AddCmd( ({"zieh", "ziehe" }), "ziehen" );

}
int ziehen(string str)
{
   notify_fail("Was moechtest Du ziehen?\n");
   if ( member( ({ "hebel" }),str) != -1) 
  {
    write(BS( "Du ziehst an dem Hebel und die Sinne schwinden Dir..\n"));
    say( TPN+" verschwindet vor Deinen Augen.\n");
    TP->AddHp(-50);
    TP->AddSp(-50);
    this_player()->move(ROOM "tem8", M_TPORT);
    return 1;
  }
}

