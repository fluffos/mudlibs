// von Chivas
inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Tempel");
  SetProp( P_INT_LONG,
        "Es ist komplett dunkel in der Kammer. Der Boden ist mit einer "
        "duennen Schicht Staub bedeckt. Die Portraits an den Waenden sehen "
        "ein wenig verblasst aus und an der Decke haengen ein paar Spinnweben. "
        "Es ist eine absolute Durchschnittskammer in diesem Tempel." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 0 );

//-----Details Anfang-----
  
  AddDetail( ({"kammer","durchschnittskammer"}), 
            "In der Kammer gibt es wirklich nicht besonders viel zu sehen. Die "
            "ueblichen Fackeln an den Waenden, die normalen Steinplatten am "
            "Boden, nur die Portraits sind ein wenig interessant.");

  AddDetail( ({"boden"}),
	    "Am Boden siehst Du die fuer den Tempel typischen Steinplatten "
            "unter einen duennen Schicht Staub.");

  AddDetail( ({"schicht","staub","staubschicht"}),
	    "Ein duenne Schicht Staub liegt auf den Steinplatten. Nur Deine "
            "eigenen Fussabdruecke zeichnen sich in ihm ab.");

  AddDetail( ({"portraits","portrait"}), 
            "Die Portraits sind verblasst und zeigen verschiedene "
            "Persoenlichkeiten des Tempels.");

  AddDetail( ({"waenden","waende","wand"}),
	    "An den Waenden haengen ein paar Fackeln, die die Kammer jedoch "
            "nicht erhellen, da sie aus sind, und vier Portraits.");

  AddDetail( ({"tempel","tempels"}),
	    "Du bist tief im Tempel."); 
  
  AddDetail( ({"decke","himmel"}), 
            "Die Decke ist kahl bis auf ein paar alte Spinnweben.");

  AddDetail( ({"spinnweben","jahren"}),
	    "Die Spinnweben wurden schon vor Jahren verlassen.");

  AddDetail( ({"steinplatten","platten"}),
	    "Die Steinplatten sind unter einer duennen Staubschicht gut zu "
            "sehen, obwohl dort nichts zu entdecken ist.");

  AddDetail( ({"fussabdruecke","abdruecke"}), 
            "Es sind Deine eigenen Fussabdruecke, die Du im Staub erkennen "
            "kannst.");

  AddDetail( ({"persoenlichkeiten","who"}),
	    "Du erkennst genau vier verschiedene Personen in den vier "
            "Portraits. Es scheint das Who is Who des Tempels zu sein.");

  AddDetail( ({"personen"}),
	    "Unter jedem Portrait haengt eine bronzene Plakette zu den "
            "Personen."); 
  
  AddDetail( ({"plakette"}), 
            "Welche der vier Plaketten meinst Du?");

  AddDetail( ({"plakette 1","tempelwache"}),
	    "Auf der ersten Plakette, unter dem ersten Portrait eines boese "
            "dreinschauenden Trolls, steht: Grob, erster Hauptmann der "
            "Tempelwache.");

  AddDetail( ({"plakette 2"}),
	    "Auf der zweiten Plakette, unter einem hochnaesig wirkenden "
            "Menschen, steht: Gracius, erster Berater des Tempels.");

  AddDetail( ({"plakette 3"}), 
            "Auf der dritten Plakette, unter einem eleganten Dunkelelfen, "
            "steht: Rudici, erster Assasini des Tempels.");

  AddDetail( ({"plakette 4"}),
	    "Auf der vierten Plakette, unter einem edel aussehendem Elfen in "
            "Paladinuniform, steht: Harion, der Topspion des Tempels.");

  AddDetail( ({"troll","trolls","grob","hauptmann","zeitgenosse"}),
	    "Der Troll sieht boesartig und muskuloes aus. Sicher kein netter "
            "Zeitgenosse zum rumhaengen."); 
  
  AddDetail( ({"menschen","gracius","berater"}), 
            "Gracius sieht hochnaesig und hinterhaeltig aus. Er war sicher "
            "kein Mensch, dem Du den Ruecken zudrehen wuerdest.");

  AddDetail( ({"dunkelelfen","rudici","assasini"}),
	    "Rudici spielt auf dem Portrait auch mit einem spitzen Dolch, was "
            "ihn nicht gerade vertrauenswuerdiger macht.");

  AddDetail( ({"elfen","paladinuniform","uniform","harion","spion","mann"}),
	    "Du kannst es kaum glauben, dass dieser nett aussehende Mann, in "
            "Wirklichkeit ein hinterhaeltiger Spion gewesen sein soll.");

  AddDetail( ({"wirklichkeit"}), 
            "Was ist schon wirklich?");

  AddDetail( ({"fackeln"}),
	    "Die Fackeln sind aus und brennen nicht.");

  AddDetail( ({"nase"}),
	    "Du hast eine sehr grosse Nase, Du kannst sicher gut riechen."); 
  
  AddSmell(DEFAULT_SMELL, "Der Staub kitzelt ein wenig in der Nase, ansonsten "
                          "gibt es nichts zu riechen.");  
 
  AddSound(DEFAULT_SOUND, "Es ist totenstill.");

//-----Details Ende-----
AddItem(NPC "pestilenz", REFRESH_DESTRUCT);
  
AddExit("westen", ROOM "tem2-6");
AddExit("sueden", ROOM "tem2-4");

}

