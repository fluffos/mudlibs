// von Chivas
inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Tempel");
  SetProp( P_INT_LONG,
        "Dies ist ein einfacher Verbindungsgang zwischen den verschiedenen "
        "Kammern auf dieser Ebene. Man sieht an den Waenden ein paar Fackeln "
        "haengen und der Marmor auf dem Boden glaenzt im Schein der Flammen. "
        "An der Decke sind ein paar Verzierungen zu erkennen." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----

  AddDetail( ({"gang","verbindungsgang"}), 
            "Der Gang bringt Dich zu anderen Kammern auf dieser Ebene. Du "
            "kannst nach Norden, Westen oder Osten gehen.");

  AddDetail( ({"kammern","kammer"}),
	    "Hier auf der Ebene gibt es sehr viele Kammern.");

  AddDetail( ({"ebene","tempel"}),
	    "Du bist auf der dritten Ebene im Tempel.");

  AddDetail( ({"waende","waenden"}), 
            "An den schmucklosen Waenden haengen die Fackeln in ihren "
            "Halterungen.");

  AddDetail( ({"fackeln"}),
	    "Die Fackeln erhellen den Gang mit ihrem roetlichen Licht.");

  AddDetail( ({"marmor"}),
	    "Der weisse Marmor war sicher sehr teuer."); 
  
  AddDetail( ({"boden"}), 
            "Auf dem Boden ist weisser Marmor zu sehen. Aber er ist nicht "
            "sehr interessant.");

  AddDetail( ({"schein","licht"}),
	    "Du kannst durch die Fackeln im Gang sehr gut sehen.");

  AddDetail( ({"flammen"}),
	    "Die roten Flammen erhellen mit ihrem Schein den Gang.");

  AddDetail( ({"decke","himmel"}), 
            "An der Decke siehst Du einige Verzierungen.");

  AddDetail( ({"verzierungen"}),
	    "Die Verzierungen sind eigentlich nur ein paar Schnoerkel und "
            "Kreise.");

  AddDetail( ({"norden","mitte"}),
	    "Im Norden scheint die Mitte der Ebene zu sein."); 
  
  AddDetail( ({"westen","treppe"}), 
            "Im Westen muesste die Treppe sein, die auf die zweite Ebene "
            "herunter fuehrt.");

  AddDetail( ({"osten"}),
	    "Du weisst nicht mehr, was im Osten war, oder ob Du ueberhaupt "
            "schon da warst.");

  AddDetail( ({"schnoerkel","kreise"}),
	    "Sie sehen ganz nett an der Decke aus, sind aber auch nicht sehr "
            "interessant.");

  AddDetail( ({"halterungen"}), 
            "Die Halterungen sind aus Eisen und halten die Fackeln an den "
            "Waenden.");

  AddDetail( ({"eisen"}),
	    "Das Eisen ist ein wenig verrostet. Es lohnt sich nicht gerade, die "
            "Halterungen zu klauen.");

  AddSmell(DEFAULT_SMELL, "Es riecht nach gar nichts. Du schnueffelst "
                          "umsonst.");  
 
  AddSound(DEFAULT_SOUND, "Aus den anderen Kammern hoerst Du gar nichts. Sie "
                          "scheinen magisch abgeschottet zu sein.");

//-----Details Ende-----
  
AddExit("westen", ROOM "tem3-9");
AddExit("norden", ROOM "tem3-1");
AddExit("osten", ROOM "tem3-7");

}

