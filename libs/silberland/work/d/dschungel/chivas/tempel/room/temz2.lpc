// von Chivas
// 
inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

int dietrich_zahl;

void create()
	
{
  ::create();

  dietrich_zahl=1;

  SetProp( P_INT_SHORT, "In einer Gefaengniszelle");
  SetProp( P_INT_LONG,
	"Du stehst in einer Gefaengniszelle, sie bietet nicht sehr viel Platz "
	"und ist sehr kahl. Der Boden besteht aus kleinen Steinplatten und in "
        "der Ecke liegt ein Skelett.");
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 10, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  AddDetail( ({"boden"}), 
            "Der Boden besteht aus kleinen Steinplatten. Ein altes Skelett "
            "liegt in der Ecke.");

  AddDetail( ({"skelett","ecke","jahren","abenteurer"}), 
            "Das Skelett hat sicher auch schon bessere Zeiten erlebt. Es "
            "scheint hier schon seit Jahren zu liegen. Es war anscheinend ein "
            "armer Abenteurer wie Du.");

  AddDetail( ({"steinplatten","platten"}),
	    "Die Steinplatten sind mit Kratzern bedeckt und sind sauber "
            "verfugt.");

  AddDetail( ({"gefaengniszelle","zelle"}),
             QueryProp(P_INT_LONG));

  AddDetail( ({"gitter"}), 
            "Die Gitter der Zelle machen einen stabilen Eindruck. Ohne "
            "Schluessel kommst Du hier wohl nicht raus.");

  AddDetail( ({"himmel"}),
	    "Das waere schoen, wenn Du ihn hier sehen koenntest.");

  AddDetail( ({"schluessel"}),
	    "Ohne Schluessel wirst Du wohl hier bis zum Reboot sitzen, oder "
            "Du findest einen netten Spieler der Dich hier raus holt, wenn "
            "die Tuer zu ist."); 

  AddDetail( ({"waende","wand"}),
	    "Die Waende der Zelle sind kahl, bis auf die Zellentuer siehst "
            "Du nichts was interessant ist.");

  AddDetail( ({"decke","chance"}),
	    "Die Decke ist einfach trostlos, keine Chance durch die Decke zu "
            "entkommen.");
  
  AddDetail( ({"reboot","alternative"}), 
            "Das ist eine schlechte Alternative.");

  AddDetail( ({"spieler"}),
	    "Ein anderer Spieler wie Du.");

  AddDetail( ({"tuer","zellentuer"}),
	    "Durch die Zellentuer kommt man wieder raus, falls sie nicht zu "
            "ist und Du hier einsitzt.");

  AddDetail( ({"fugen"}), 
            "Die Fugen sind fast ueberall noch intakt, bis auf eine Stelle.");
  
  AddDetail( ({"platz"}), 
            "Es ist recht beengend.");

  AddDetail( ({"kratzer","kratzern"}), 
            "Die Kratzer stammen sicher von einer armen Kreatur.");

  AddDetail( ({"kreatur"}), 
            "Eine arme Kreatur die hier nicht mehr rausgekommen ist.");

  AddDetail( ({"zeiten","zeit"}), 
            "Vielleicht musst Du hier ja auch einige Zeit verbringen.");

  AddDetail( ({"eindruck"}),
	    "Die Gitter scheinen sehr stabil zu sein.");

  AddDetail( ({"stelle"}),
	    "An dieser Stelle sind die Fugen kaputt. Du kannst die Platte "
            "vielleicht anheben."); 

  AddDetail( ({"du","dich","dir","dein","deines","deiner","deinem","deinen"}),
	    "Du befuehlst Dich selbst und entdeckst, dass Du dreckig bist. "
	    "Du erroetest und planst Dich bald zu waschen.");

  AddSmell(DEFAULT_SMELL, "Es riecht nach Tod.");  
 
  AddSmell( ({"tod","geruch","todes"}),
	   "Der Geruch des Todes gefaellt Dir gar nicht.");

  AddSound(DEFAULT_SOUND, "Es herrscht Totenstille in der Zelle.");

  AddSound( ({"totenstille"}),
	   "Du hoerst nichts.");

//-----Details Ende-----

AddCmd( ({"oeffne" }), "oeffnen" );
AddCmd( ({"hebe","heb" }), "heben" );

}
void reset()
{
  ::reset();
  dietrich_zahl=1;
}
int heben(string str)
{
  object dietrich;
  notify_fail( "Was moechtest Du anheben ?\n" );
  if ( member( ({ "platte an","steinplatte an","platte","steinplatte" }), str ) != -1 ) 

   {
     if( dietrich_zahl < 1 )
     {
        write("Du hebst die Platte an, aber findest momentan leider nichts.\n");
        say(sprintf("%s hebt eine Platte an, ist aber enttaeuscht.\n", TP->Name(WER)));
        return -1;
     }
      if ( present("tempeldietrich",TP) )
      {
      write("Du hast bereits einen Dietrich, wie viele willst Du denn "
      +"noch ?\n" );
      say(sprintf("%s stellt sich dumm an.\n", TP->Name(WER)));
      return -1;
      }
      else
      {
        {dietrich = clone_object( OBJ "dietrich.lpc");
        if ( ME_TOO_HEAVY == dietrich->move(TP,M_GET|M_SILENT) )

          {
          write(
          "Der Dietrich ist Dir zu schwer. Du Weichei!\n" );
          say(BS(sprintf("%s findet einen Dietrich und laesst ihn fallen.\n", TP->Name(WER))));
          dietrich -> remove();
          return 1;
          }
          else
          {
          write("Du hebst die Platte an und findest ploetzlich "
                "einen Dietrich.\n");
          say(sprintf("%s findet etwas.\n",
          TP->Name(WER)));
          dietrich_zahl--;
          return 1;
          }
        }
     }
    return 0;
   }
  return 0;
}

int oeffnen(string str)
{
 notify_fail("Was moechtest Du womit oeffnen?\n");

 if(!str || str == "") return 0;
 if(!(str == "tuer mit schluessel" ||
      str == "zellentuer mit schluessel" ||
      str == "zelle mit schluessel"||
      str == "zellentuer mit dietrich" ||
      str == "zelle mit dietrich"||
      str == "tuer mit dietrich" )) return 0;
 
 if( str == "tuer mit schluessel" ||
     str == "zellentuer mit schluessel" ||
     str == "zelle mit schluessel"){

  if(!present("tempelschluessel", TP)){
	  
  write(BS("Du hast doch gar nicht den richtigen Schluessel fuer die Tuer.\n"));
 
  say(TPN+" stellt sich dumm an.\n");
  return -1;
  }
  else 
  {
  write(BS("Du oeffnest die Zellentuer mit dem Schluessel.\n"));
  say(TPN+" oeffnet die Zellentuer.\n");
  AddExit("westoben", ROOM "tem49");
  return -1;
  }}

 if( str == "tuer mit dietrich" ||
     str == "zellentuer mit dietrich" ||
     str == "zelle mit dietrich"){

  if(!present("tempeldietrich", TP)){
	  
  write(BS("Du hast doch gar keinen Dietrich, aber schau Dich doch mal um.\n"));
 
  say(TPN+" stellt sich dumm an.\n");
  return -1;
  }
  else 
  {
  object ob;
  write(BS("Du oeffnest die Zellentuer mit dem Dietrich, dabei wird der "
           "Dietrich leider zerstoert.\n"));
  say(TPN+" oeffnet die Zellentuer.\n");
  while(ob=present("tempeldietrich", TP))
  ob->remove(1);
  AddExit("westoben", ROOM "tem49");
  return -1;
  }}
}
