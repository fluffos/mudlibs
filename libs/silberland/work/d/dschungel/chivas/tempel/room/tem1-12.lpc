// von Chivas
inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>
int stein_zahl; 
int anzahl; 

void create()
	
{
  ::create();
   stein_zahl=1;
   anzahl=1;

  SetProp( P_INT_SHORT, "Auf einem Tempel im Dschungel");
  SetProp( P_INT_LONG,
        "Die Aussenmauer der ersten Ebene ist fast komplett zugewachsen. "
        "Das Einzige, was einen daran erinnert, dass man an einem Tempel ist, "
        "sind die Fenster, durch die man, Dank eines magischen Schimmers, nicht "
        "in das Innere des Tempels schauen kann." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 30, ENV_TERRAIN: TT_JUNGLE]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----

  AddDetail( ({"aussenmauer","mauer"}), 
            "Die Aussenmauer ist fast komplett hinter Ranken und "
            "Schlingpflanzen verschwunden.");

  AddDetail( ({"einzige","fenster","fenstern"}),
	    "Die Fenster haben einen magischen Schimmer und es ist unmoeglich, "
            "durch sie hindurch in den Tempel zu schauen.");

  AddDetail( ({"dank","innere"}),
	    "Vielleicht ist es besser, wenn man das Innere und das dort "
            "vorhandene Boese nicht sehen kann.");

  AddDetail( ({"schimmer","schimmers","moeglichkeit"}), 
            "Ein magischer Schimmer liegt ueber den Fenstern und daher gibt "
            "es keine Moeglichkeit, in das Innere des Tempels zu schauen.");

  AddDetail( ({"tempel"}),
	    "Du bist auf der ersten Ebene ausserhalb des Tempels. Um auf die "
            "anderen Ebenen zu kommen, musst Du wohl den Tempel betreten.");

  AddDetail( ({"boden"}),
	    "Der Boden ist mit lauter Pflanzen zugewachsen."); 
  
  AddDetail( ({"himmel","farbe"}), 
            "Der Himmel hat eine tolle blaue Farbe.");

  AddDetail( ({"ebene","ebenen"}),
	    "Du befindest Dich ausserhalb des Tempels auf einer Ebene.");

  AddDetail( ({"ranken"}),
	    "Die Ranken haben sich auf der ganzen Mauer ausgebreitet. Nur um "
            "die Fenster rum ist die Mauer noch ein wenig zu sehen.");

  AddDetail( ({"schlingpflanzen"}), 
            "Die Schlingpflanzen teilen sich mit den Ranken den Platz an der "
            "Aussenmauer. Die Blaetter der Schlingpflanzen verdecken die Mauer "
            "fast komplett.");

  AddDetail( ({"boese"}),
	    "Das Boese soll immer noch in dem Tempel lauern.");

  AddDetail( ({"pflanzen"}),
	    "Allerlei Graeser und Blumen sind am Boden zu erkennen."); 
  
  AddDetail( ({"blaetter","seite","platz"}), 
            "Die grossen Blaetter verbergen, was sich an der Mauer befindet. "
            "Vielleicht solltest Du die Blaetter mal zur Seite biegen.");

  AddDetail( ({"graeser"}),
	    "Die ueblichen Graeser des Dschungels sind zu sehen. Sie sind "
            "nicht sehr interessant.");

  AddDetail( ({"blumen"}),
	    "Kleine Blumen wachsen zwischen den Graesern. Du kennst leider die "
            "Art nicht.");

  AddDetail( ({"art","orchideen"}), 
            "Du weisst nur, dass es keine Orchideen sind.");

  AddSpecialDetail( ({ "loch" }), "loch" );

  AddDetail( ({"dschungel"}),
	    "Der Dschungel ist rings um den Tempel.");

  AddSmell(DEFAULT_SMELL, "Es riecht nach Dschungel.");  
 
  AddSmell( ({"dschungel","pflanzen","tiere","tieren"}),
	   "Es riecht nach Pflanzen und Tieren.");

  AddSound(DEFAULT_SOUND, "Du hoerst die Fenster magisch knistern.");

  AddSound( ({"fenster"}),
	   "knister,knister,knister");
  
//-----Details Ende-----
  
AddExit("sueden", ROOM "tem1-13");
AddExit("norden", ROOM "tem1-11");

AddCmd( ({"bieg", "biege" }), "biegen" );
AddCmd( ({"greif", "greife" }), "greifen" );

}
void reset()
{
  ::reset();
  stein_zahl=1;
  anzahl=1;
}
int biegen(string str)
{
   notify_fail("Was moechtest Du zur Seite biegen?\n");
   if ( member( ({ "blaetter zur seite", "blaetter weg" }),str) != -1) 
  {
    write(BS( "Du siehst hinter den Blaettern ein kleines Loch in der Mauer. "
           "Vielleicht solltest Du mal in das Loch greifen, aber sei "
           "vorsichtig, Du weisst nicht was in dem Loch lauert.\n"));
    say( TPN+" beschaeftigt sich mit den Pflanzen.\n");
    anzahl--;
    return 1;
  }
}

int greifen(string str)
{
 object stein;
  notify_fail("In was willst Du greifen?\n");
 if( str != "in loch"     ||
     str != "loch"              )
 {
    if ( anzahl )
    {
    write(BS("Du hast ja noch gar kein Loch entdeckt.\n"));
    return 1;
    }
  {
  if(stein_zahl <1)
  {
   write(BS("Irgendwer hat wohl schon vor Dir in das Loch gegriffen. "
            "Du kommst anscheinend zu spaet. Vielleicht warst Du es ja auch "
            "selbst!"));
   say(TPN + " sieht enttaeuscht aus.\n");
   return 1;
  }
  else
  {
   write(BS("Du greifst voller Mut in das Loch und hast "
            "ploetzlich einen Edelstein in Deinen Haenden, den Du sofort "
            "einsteckst."));
      switch(random(12))
          {
          case 0: stein = clone_object( "/obj/gems/rubin.lpc");
          break;
          case 1: stein = clone_object( "/obj/gems/diaspor.lpc");
          break;
          case 2: stein = clone_object( "/obj/gems/citrin.lpc");
          break;
          case 3: stein = clone_object( "/obj/gems/amethyst.lpc");
          break;
          case 4: stein = clone_object( "/obj/gems/lapislazuli.lpc");
          break;
          case 5: stein = clone_object( "/obj/gems/saphir.lpc");
          break;
          case 6: stein = clone_object( "/obj/gems/tuerkis.lpc");
          break;
          case 7: stein = clone_object( "/obj/gems/onyx.lpc");
          break;
          case 8: stein = clone_object( "/obj/gems/bergkristall.lpc");
          break;
          case 9: stein = clone_object( "/obj/gems/achat.lpc");
          break;
          case 10: stein = clone_object( "/obj/gems/bernstein.lpc");
          break;
          case 11: stein = clone_object( "/obj/gems/diamant.lpc");
          break;
          } 
   if(stein->move(this_player(), M_GET) != 1)
   {
    tell_object(this_player(), "Du kannst nichts mehr tragen. Du Seicherl!\n");
    stein->move(this_object(), M_NOCHECK);
   }
   stein_zahl--;
   say(TPN+ " tut geheimnisvoll.\n");
   return 1;
  }
 }
}
}
string loch(string key)
{
    if ( anzahl )
    {
    return(BS("Du siehst momentan gar kein Loch. Woher weisst Du, dass hier "
              "ein Loch sein sollte."));
    }
    else
    {
    return(BS("Das Loch ist gut zu sehen. Greif doch mal rein und mal schauen "
              "was passiert."));
    }
}


