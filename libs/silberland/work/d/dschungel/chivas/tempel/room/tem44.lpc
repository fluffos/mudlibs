// von Chivas
inherit "std/room";

#include "../def.h"

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Tempel");
  SetProp( P_INT_LONG,
        "Ein kleiner Verbindungsgang verbindet die Kammer im Osten mit einer "
        "grossen Halle, die durch ein roetliches Flackern in glaenzendes Licht "
	"getaucht ist. Es ist halt das alte Problem, dass die Halle in allen "
        "Richtungen zu sein scheint. Aber wie Du ja schon gelernt hast, sind "
        "die meisten Richtungen nur Illusion." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  
  AddDetail( ({"verbindungsgang","gang"}), 
            "Es ist ein ganz normaler kleiner Gang. Er ist nicht gerade "
            "beeindruckend.");

  AddDetail( ({"kammer","osten","ausgang","ausgaenge","sachlage","gaenge"}),
	    "Im Osten ist eine Kammer, der Ausgang ist klar, da Du dort ja "
            "schon warst. Bei den anderen Ausgaengen ist die Sachlage ein "
            "wenig schwieriger.");

  AddDetail( ({"halle"}),
	    "In der grossen Halle flackert ein roetliches Licht. Die Frage "
            "ist nur, in welche Richtung die Halle liegt.");

  AddDetail( ({"flackern","flamme"}), 
            "Eine grosse roetliche Flamme muss in der Halle sein.");

  AddDetail( ({"licht"}),
	    "Das einzige Licht im Gang kommt aus der Halle. Die Halterungen, "
            "die normalerweise die Gaenge erhellen sind leer.");

  AddDetail( ({"problem"}),
	    "Du seufzt und bist langsam deprimiert."); 
  
  AddDetail( ({"richtungen","illusion","verwirrspiel","spiel"}), 
            "Dieses Verwirrspiel geht Dir langsam auf die Nerven. Verflucht "
            "sei Chivas.");

  AddDetail( ({"chivas","magier"}),
	    "Chivas ist der verdammte Magier, der diesen Tempel verbrochen "
            "hat.");

  AddDetail( ({"waende","wand","waenden","mauer"}),
	    "Die Waende sind kahl und man kann die blanken Steinbloecke der "
            "Mauer sehen. In den Halterungen, die sonst die Fackeln "
            "beinhalten, steckt ausnahmsweise gar nichts.");

  AddDetail( ({"fackeln"}), 
            "Es sind keine zu sehen. Die Halterungen sind leer.");

  AddDetail( ({"steinbloecke","steinbloecken"}),
	    "Die Steinbloecke sind sehr dick und bilden eine stabile Mauer.");

  AddDetail( ({"halterungen"}),
	    "Die Halterungen an den Waenden beinhalten keine Fackeln. Das "
            "einzige Licht kommt aus der Halle."); 
  
  AddDetail( ({"boden"}), 
            "Am Boden sind die ueblichen Steinplatten zu erkennen.");

  AddDetail( ({"steinplatten","platten"}),
	    "Die Steinplatten sind mit einer Staubschicht bedeckt.");

  AddDetail( ({"staub","staubschicht","schicht"}),
	    "Die Staubschicht ist nicht sehr dick, jedoch reicht es aus, um "
            "im Staub einige Spuren zu sehen.");

  AddDetail( ({"spuren"}), 
            "Die Spuren fuehren nach Osten und auch in die anderen Richtungen. "
            "Du bist ein wenig enttaeuscht, da Du gehofft hast, einen Hinweis "
            "auf den weiteren Weg zu bekommen.");

  AddDetail( ({"decke","himmel"}),
	    "An der Decke ist nichts interessantes zu sehen.");

  AddDetail( ({"frage"}),
	    "Sein oder nicht sein, dass ist hier die Frage."); 
  
  AddDetail( ({"tempel"}), 
            "Du bist mittendrin.");

  AddDetail( ({"hinweis"}),
	    "Hier gibt es keinen Hinweis. Tut mir leid.");

  AddDetail( ({"weg","pech"}),
	    "Du musst Dich wohl einfach trauen, in eine Richtung zu gehen. Pech "
            "gehabt.");

  AddDetail( ({"nerven"}), 
            "Die Nerven kann man hier schon verlieren.");

  AddSmell(DEFAULT_SMELL, "Es riecht nach Staub.");  
 
  AddSmell( ({"staub"}),
	   "Am Boden liegt Staub.");

  AddSound(DEFAULT_SOUND, "Du hoerst das Flackern einer Flamme.");

  AddSound( ({"flackern","flamme"}),
	   "Die Flamme scheint in der Halle zu sein.");

//-----Details Ende-----
AddItem( "/d/gebirge/dante/gruft/npc/vamp2", REFRESH_DESTRUCT,
        ([P_MNPC_DEFAULTROOM: "tem44",
          P_MNPC_AREA:({ROOM "tem44","tem42","tem43"}),
          P_MNPC_FLAGS: MOV_INDOORS + MOV_MAYLOAD + MOV_MOVES
        ]) );
  
AddExit("norden", ROOM "tem45");
AddExit("nordosten", ROOM "tem41");
AddExit("nordwesten", ROOM "tem41");
AddExit("osten", ROOM "tem43");
AddExit("westen", ROOM "tem41");
AddExit("suedosten", ROOM "tem41");
AddExit("suedwesten", ROOM "tem41");
AddExit("sueden", ROOM "tem41");

}

