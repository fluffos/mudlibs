// von Chivas
inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

int schluessel_zahl; 

void create()
	
{
  ::create();

  schluessel_zahl=1;

  SetProp( P_INT_SHORT, "In einem Tempel");
  SetProp( P_INT_LONG,
        "Eine weitere Kammer mit vielen Ausgaengen. Der einzige Unterschied "
        "sind drei vergitterte Tueren. Es scheint so, als ob dies die "
	"Gefaengniszellen im Tempel sind. An einer Wand steht ein alter Tisch "
        "und ein Stuhl, wo sonst eine Wache zu sitzen scheint. " );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  
  AddDetail( ({"kammer"}), 
            "Die Kammer ist wohl der Wachraum fuer die Zellen.");

  AddDetail( ({"ausgaengen","ausgaenge"}),
	    "Du bist die vielen Ausgaenge schon gewohnt.");

  AddDetail( ({"unterschied"}),
	    "Bisher hast Du hier im Tempel noch keine Tueren gesehen, Du bist "
            "gespannt, was sich dahinter verbirgt und wie die Zellen "
            "aussehen.");

  AddDetail( ({"tueren"}), 
            "Die Tueren sind stabil und die Gitter sehen auch nicht "
            "gerade zerbrechlich aus.");

  AddDetail( ({"gefaengniszellen","zellen","zelle"}),
	    "Die Zellen befinden sich hinter den Tueren.");

  AddDetail( ({"tempel"}),
	    "Du wusstest, dass es sowas in diesem Tempel auch geben muss."); 
  
  AddDetail( ({"wand","waende"}), 
            "An den Waenden haengen ein paar Fackeln. Ausserdem steht ein "
            "Tisch und ein Stuhl an einer Wand.");

  AddDetail( ({"tisch"}),
	    "Der Tisch ist alt und hat viele Kratzer. Ausserdem erkennst Du "
            "eine Schublade.");

  AddDetail( ({"stuhl","moment"}),
	    "Der Stuhl sieht alt und gebrechlich aus. Er bricht sicher jeden "
            "Moment zusammen.");

  AddDetail( ({"wache"}), 
            "Eine Wache ist gerade nicht zu sehen.");

  AddDetail( ({"gitter"}),
	    "Du schaust durch ein Gitter und siehst eine kahle Zelle, die nach "
            "unten verlaeuft.");

  AddDetail( ({"fackeln"}),
	    "Die Fackeln erhellen die Kammer mit ihrem magischen Licht ein "
            "wenig."); 
  
  AddDetail( ({"licht"}), 
            "Es ist nicht viel Licht, aber es reicht.");

  AddDetail( ({"kratzer"}),
	    "Die Kratzer stammen sicher von einer Wache, die vor lauter "
            "Langeweile mit einem Messer rumgespielt hat.");

  AddDetail( ({"schublade"}),
	    "Vielleicht kannst Du sie oeffnen?");

  AddDetail( ({"messer"}), 
            "Die Wache hat es sicher mitgenommen.");

  AddDetail( ({"langeweile"}),
	    "Du hast keine Langeweile.");

  AddDetail( ({"boden"}),
	    "Am Boden sind die ueblichen Steinplatten."); 
  
  AddDetail( ({"decke","himmel"}), 
            "An der Decke sind ein paar Symbole zu erkennen.");

  AddDetail( ({"wachraum"}),
	    "Die Kammer, die als Wachraum dient, ist recht spaerlich "
            "eingerichtet.");

  AddDetail( ({"symbole"}),
	    "Die mystischen Symbole scheinen in der Vergangenheit die "
            "Ueberwachung der Zellen unterstuetzt zu haben. Ihre Magie ist "
            "jedoch erloschen.");

  AddDetail( ({"ueberwachung"}), 
            "Momentan werden die Zellen gar nicht bewacht.");

  AddDetail( ({"magie"}),
	    "Die Magie der Symbole ist erloschen.");

  AddDetail( ({"vergangenheit","ort"}),
	    "Die Vergangenheit war sehr boese an diesem Ort."); 
  
  AddDetail( ({"steinplatten","platten"}), 
            "Sie sind schmucklos und uninteressant.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht ein wenig schimmelig aus den Zellen.");  
 
  AddSmell( ({"zellen"}),
	   "Es stinkt in den Zellen.");

  AddSound(DEFAULT_SOUND, "Du hoerst ein Wimmern.");

  AddSound( ({"wimmern","zellen"}),
	   "Das Wimmern kommt aus einer der Zellen.");
  
//-----Details Ende-----
AddItem(NPC "wachposten", REFRESH_DESTRUCT);
  
AddExit("norden", ROOM "tem47");
AddExit("nordosten", ROOM "tem47");
AddExit("nordwesten", ROOM "tem47");
AddExit("osten", ROOM "tem47");
AddExit("westen", ROOM "tem47");
AddExit("suedosten", ROOM "tem47");
AddExit("suedwesten", ROOM "tem48");
AddExit("sueden", ROOM "tem50");

AddCmd( ({"oeffne" }), "oeffnen" );
AddCmd( ({"reiss","reisse"}), "reissen" );

}
void reset()
{
  ::reset();
  schluessel_zahl=1;
}
int oeffnen(string str)
{
 notify_fail("Was moechtest Du womit oeffnen?\n");

 if(!str || str == "") return 0;
 if(!(str == "zelle 1 mit schluessel" ||
      str == "zelle 2 mit schluessel" ||
      str == "zelle 3 mit schluessel"||
      str == "tuer 1 mit schluessel" ||
      str == "tuer 2 mit schluessel" ||
      str == "tuer 3 mit schluessel"||
      str == "zellentuer 1 mit schluessel" ||
      str == "zellentuer 2 mit schluessel"||
      str == "schublade"||
      str == "zellentuer 3 mit schluessel" )) return 0;
 
 if( str == "tuer 1 mit schluessel" ||
     str == "zellentuer 1 mit schluessel" ||
     str == "zelle 1 mit schluessel"){

  if(!present("tempelschluessel", TP)){
	  
  write(BS("Du hast doch gar nicht den richtigen Schluessel fuer die Tuer.\n"));
 
  say(TPN+" stellt sich dumm an.\n");
  return -1;
  }
  else 
  {
  write(BS("Du oeffnest die erste Zellentuer mit dem Schluessel.\n"));
  say(TPN+" oeffnet die erste Zellentuer.\n");
  AddExit("nordostunten", ROOM "temz1");
  return -1;
  }}

 if( str == "tuer 2 mit schluessel" ||
     str == "zellentuer 2 mit schluessel" ||
     str == "zelle 2 mit schluessel"){

  if(!present("tempelschluessel", TP)){
	  
  write(BS("Du hast doch gar nicht den richtigen Schluessel fuer die Tuer.\n"));
 
  say(TPN+" stellt sich dumm an.\n");
  return -1;
  }
  else 
  {
  write(BS("Du oeffnest die zweite Zellentuer mit dem Schluessel.\n"));
  say(TPN+" oeffnet die zweite Zellentuer.\n");
  AddExit("ostunten", ROOM "temz2");
  return -1;
  }}

 if( str == "tuer 3 mit schluessel" ||
     str == "zellentuer 3 mit schluessel" ||
     str == "zelle 3 mit schluessel"){

  if(!present("tempelschluessel", TP)){
	  
  write(BS("Du hast doch gar nicht den richtigen Schluessel fuer die Tuer.\n"));
 
  say(TPN+" stellt sich dumm an.\n");
  return -1;
  }
  else 
  {
  write(BS("Du oeffnest die dritte Zellentuer mit dem Schluessel.\n"));
  say(TPN+" oeffnet die dritte Zellentuer.\n");
  AddExit("suedostunten", ROOM "temz3");
  return -1;
  }}
 if( str == "schublade"){

  write(BS("Du probierst die Schublade zu oeffnen, aber sie klemmt. So "
           "bekommst Du sie nicht auf. Ueberleg mal wie Du sie noch "
           "aufbekommen kannst. Reiss Dich zusammen!\n"));
  say(TPN+" probiert eine Schublade am Tisch zu oeffnen.\n");
  return 1;
  }}

int reissen(string str)
{
   object schluessel;
   notify_fail("An was moechtest Du mit aller Kraft reissen?\n");
   if ( member( ({ "mit aller Kraft an schublade","an schublade" }),str) != -1) 
   {
     if( schluessel_zahl < 1 )
     {
        write("Du findest nichts in der Schublade.\n");
        say(sprintf("%s ist ein wenig enttaeuscht.\n", TP->Name(WER)));
        return -1;
     }
      if ( deep_present("tempelschluessel",TP) )
      {
      write("Da Du bereits einen Schluessel hast, brauchst Du es nicht mehr "
            "zu tun.\n" );
      say(sprintf("%s sucht krankhaft nach weiteren Schluesseln.\n", TP->Name(WER)));
      return -1;
      }
      else
      {
        {schluessel = clone_object( OBJ "schluessel");
        if ( ME_TOO_HEAVY == schluessel->move(TP,M_GET|M_SILENT) )
 
          {
          write(
          "Der Schluessel wuerde Dir zu schwer werden.\n" );
          say(BS(sprintf("%s ist ein Weichei und kann noch nicht mal einen "
          "Schluessel tragen.\n", TP->Name(WER))));
          schluessel -> remove();
          return 1;
          }
          else
          {
          write(BS("Du reisst mit aller Kraft an der Schublade und sie geht auf. "
                "Du findest einen Schluessel und schliesst die Schublade "
                "wieder.\n"));
          say(sprintf("%s findet einen Schluessel.\n",
          TP->Name(WER)));
          schluessel_zahl--;
          return 1;
          }
        }
     }
    return 0;
   }
  return 0;
}
