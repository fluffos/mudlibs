// von Chivas
inherit "std/room";

#include "../def.h"

void create()
	
{
  ::create();


  SetProp( P_INT_SHORT, "In einem Tempel");
  SetProp( P_INT_LONG,
        "Das Innere des Tempels ist verwirrend. In alle Richtungen sind "
        "Ausgaenge zu erkennen. Das Beunruhigende an dieser Kammer sind jedoch "
	"die verschiedenen mannshohen Statuen, die zwischen den an der Wand "
        "angebrachten Fackeln stehen. Im Augenwinkel kannst Du erkennen, dass "
        "sie ihre Koepfe nach Dir umdrehen. Deine Nackenhaare stellen sich "
        "auf. " );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  
  AddDetail( ({"tempels","tempel","innere"}), 
            "Du bist im Erdgeschoss des Tempels.");

  AddDetail( ({"richtungen","ausgaenge","ausgang"}),
	    "Das uebliche Spiel: Finde den richtigen Ausgang.");

  AddDetail( ({"beunruhigende"}),
	    "Die Statuen beunruhigen Dich ein wenig.");

  AddDetail( ({"kammer"}), 
            "Die Kammer ist nicht sehr gross, aber unheimlich.");

  AddDetail( ({"statuen"}),
	    "Es sind insgesamt drei Statuen zu sehen, die an der Wand stehen.");

  AddDetail( ({"wand","waende","waenden"}),
	    "Die Waende sind kahl. Nur die Statuen und die Halterungen mit den "
            "Fackeln verkleiden die Waende ein wenig."); 
  
  AddDetail( ({"fackeln"}), 
            "Die Fackeln in den Halterungen erhellen die Kammer ein wenig mit "
            "ihrem gruenen magischen Lichtschein.");

  AddDetail( ({"koepfe","augenwinkel"}),
	    "Es scheint so als ob sie ihre Koepfe bewegen koennen.");

  AddDetail( ({"nackenhaare"}),
	    "Deine Nackenhaare stellen sich in letzter Zeit oefter auf. Du "
            "bist sehr schreckhaft.");

  AddDetail( ({"decke","himmel"}), 
            "An der Decke sind einige Zeichen erkennen.");

  AddDetail( ({"boden"}),
	    "Am Boden siehst Du Steinplatten.");

  AddDetail( ({"steinplatten","platten"}),
	    "Es handelt sich um ganz normale uninteressante Steinplatten. Es "
            "ist nicht ein Kratzer auf ihnen zu erkennen."); 
  
  AddDetail( ({"zeichen"}), 
            "Die Zeichen sind recht uninteressant. Nur ein Pfeil faellt Dir "
            "besonders auf.");

  AddDetail( ({"pfeil"}),
	    "        *                    \n"
            "       **                    \n"
            "      **********             \n"
            "     **********              \n"
            "      **********             \n"
            "       **                    \n"
            "        *                    \n");

  AddDetail( ({"erdgeschoss"}),
	    "Ueber Dir sind sicher noch ein paar Ebenen.");

  AddDetail( ({"ebenen"}), 
            "Es sah von draussen so aus, als ob es ueber dem Erdgeschoss "
            "noch drei Ebenen und eine Tempelspitze gibt.");

  AddDetail( ({"tempelspitze","spitze","weg"}),
	    "Der Weg bis dort hin ist noch sehr weit.");

  AddDetail( ({"kratzer"}),
	    "Kein Kratzer heisst, dass keiner da ist. Du untersuchst wirklich "
            "alles."); 
  
  AddDetail( ({"zeit","detail"}), 
            "Man muesste mehr Zeit haben, um wirklich jedes Detail zu "
            "untersuchen.");

  AddDetail( ({"statue 1","troll","erste statue"}),
	    "Die erste Statue stellt einen grossen, globigen Troll da. Er "
            "schaut recht boese drein und Du bist froh, dass er nur aus Stein "
            "besteht.");

  AddDetail( ({"statue 2","oger","hand","zweite statue"}),
	    "Die zweite Statue, die Dir auffaellt, ist ein grimmiger und "
            "gefraessiger Oger. Er haelt eine schwere Kette in der Hand.");

  AddDetail( ({"statue 3","dritte statue","elfin"}), 
            "In der Mitte zwischen dem Troll und dem Oger steht eine kleinere "
            "und viel zierlichere Statue. Sie stellt eine Elfin da, die durch "
            "eine Kette um ihren Hals gefangen ist. Das andere Ende der Kette "
            "hat der Oger in seiner Hand.");

  AddDetail( ({"statue"}),
	    "Welche Statue meinst Du? 1,2 oder 3?");

  AddDetail( ({"halterungen"}),
	    "In den Halterungen an den Waenden haengen Fackeln, die die "
            "Kammer ein wenig erhellen.");

  AddDetail( ({"spiel"}),
	    "Das Spiel gefaellt Dir nicht.");

  AddDetail( ({"lichtschein","licht"}),
	    "Das Licht erhellt die Kammer nur ein wenig.");

  AddDetail( ({"stein","werkstoff"}),
	    "Stein ist ein guter Werkstoff, um Statuen zu erstellen."); 
  
  AddDetail( ({"kette"}), 
            "Die Kette besteht aus Metall und verbindet zwei Statuen "
            "miteinander.");

  AddDetail( ({"metall","eisen"}),
	    "Das Metall ist wohl gewoehnliches Eisen.");

  AddDetail( ({"hals","stelle"}),
	    "Die Kette ist an der Stelle wo sie den Hals umschliesst ein wenig "
            "sehr verrostet. Vielleicht kann man sie an dieser Stelle "
            "zerreissen.");

  AddSmell(DEFAULT_SMELL, "Es riecht nach Schmutz und Unrat.");  
 
  AddSmell( ({"schmutz","unrat"}),
	   "Hier wird anscheinend nie richtig sauber gemacht.");

  AddSound(DEFAULT_SOUND, "Du hoerst nur das Flackern der Fackeln.");

  AddSound( ({"flackern","fackeln"}),
	   "*flacker**flacker**flacker*");

//-----Details Ende-----
AddItem( "/d/unterwelt/basics/central/npc/skelett", REFRESH_DESTRUCT,
        ([P_MNPC_DEFAULTROOM: "tem30",
          P_MNPC_AREA:({ROOM "tem29", ROOM "tem30", ROOM "tem31"}),
          P_MNPC_FLAGS: MOV_INDOORS + MOV_MAYLOAD + MOV_MOVES
        ]) );
  
AddExit("norden", ROOM "tem8");
AddExit("nordosten", ROOM "tem8");
AddExit("nordwesten", ROOM "tem8");
AddExit("osten", ROOM "tem8");
AddExit("westen", ROOM "tem31");
AddExit("suedosten", ROOM "tem8");
AddExit("suedwesten", ROOM "tem8");
AddExit("sueden", ROOM "tem29");


AddCmd( ({"zerreiss", "zerreisse" }), "zerreissen" );

}
int zerreissen(string str)
{
   notify_fail("Was willst Du zerreissen?\n");
   if ( member( ({ "kette" }),str) != -1) 
  {
    write(BS( "Du zerreisst die Kette am Hals der Elfin. Fuer einen kurzen "
           "Augenblick wirkt die Statue lebendig und sie gibt Dir einen "
           "dankbaren Kuss auf die Wange. Im naechsten Moment bewegt sich "
           "der Oger und legt der Elfin eine neue Kette um. Beide erstarren "
           "wieder.\n"));
    say( TPN+" zerreisst eine Kette.\n");
    return 1;
  }
}

