// von Chivas
inherit "std/room";

#include "../def.h"

void create()
	
{
  ::create();


  SetProp( P_INT_SHORT, "In einem Tempel");
  SetProp( P_INT_LONG,
        "Deine Schritte hallen auf dem Granitboden, so dass sie sicher im "
        "ganzen Tempel zu hoeren sind. Ueber Dir haengen ein paar "
	"Schlingpflanzen von der Decke, die in den Jahren einen Weg durch das "
        "Gemaeuer in den Tempel gefunden haben. Sie sehen jedoch nicht sehr "
        "gesund aus, was sicher an der Umgebung liegt." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  
  AddDetail( ({"schritte"}), 
            "Deine Schritte auf dem Boden kann man gut hoeren.");

  AddDetail( ({"granitboden","boden"}),
	    "Auf dem Boden hallen Deine Schritte sehr laut. Die grossen "
            "Granitplatten am Boden sehen makellos aus.");

  AddDetail( ({"tempel"}),
	    "Du bist schon ziemlich tief im Tempel.");

  AddDetail( ({"schlingpflanzen"}), 
            "Die Schlingpflanzen haben einen Weg in den Tempel gefunden. Es "
            "scheint ihnen aber hier nicht sehr gut zu gehen, da ihre "
            "gelbliche Farbe nicht sehr gesund aussieht.");

  AddDetail( ({"decke","himmel"}),
	    "An der Decke haengen einige Schlingpflanzen, die von draussen "
            "hier rein gewachsen sind.");

  AddDetail( ({"jahren","jahre"}),
	    "Es hat sicher ein paar Jahre gedaurt sich bis in den Tempel "
            "vorzukaempfen."); 
  
  AddDetail( ({"weg"}), 
            "Die Schlingpflanzen scheinen ein paar Risse in der Decke gefunden "
            "zu haben.");

  AddDetail( ({"gemaeuer","mauern","mauer"}),
	    "Die Mauern und die Decke sind ansonsten sehr stabil.");

  AddDetail( ({"umgebung","inneren"}),
	    "Die Umgebung im Inneren des Tempels scheint den Pflanzen nicht "
            "gut zu tun. Die Faerbung ihrer Blaetter sieht ein wenig krank "
            "aus.");

  AddDetail( ({"waende","wand","waenden"}), 
            "An den Waenden haengen ein paar Halterungen, ansonsten sind sie "
            "kahl und man kann die Steinquader der Mauer erkennen.");

  AddDetail( ({"granitplatten","platten"}),
	    "Auf den Granitplatten liegen ab und zu ein paar Blaetter, die von "
            "den Pflanzen abgefallen sind. Sie verrotten am Boden.");

  AddDetail( ({"farbe","faerbung"}),
	    "Die gelbliche Faerbung sieht kraenklich aus."); 
  
  AddDetail( ({"risse"}), 
            "Die Risse sind nicht sehr gross, aber es hat gereicht, um sich "
            "hier im Tempel einzunisten.");

  AddDetail( ({"pflanzen"}),
	    "Es sind hauptsaechlich Schlingpflanzen.");

  AddDetail( ({"blaetter","blaettern"}),
	    "Die Blaetter sehen gelblich aus und auch ein wenig verschimmelt. "
            "Viele liegen auf dem Boden und verrotten dort.");

  AddDetail( ({"halterungen","eisen"}), 
            "Die Halterungen bestehen aus rostigem Eisen. In ihnen haengen "
            "Fackeln, die den Gang erhellen.");

  AddDetail( ({"steinquader","quader","tonnen"}),
	    "Die Steinquader sind massiv und wiegen sicher einige Tonnen. An "
            "einer Stelle erkennst Du eine Inschrift.");

  AddDetail( ({"fackeln"}),
	    "Die Fackeln erhellen den Gang mit ihren gruenlich brennenden "
            "Flammen."); 
  
  AddDetail( ({"gang"}), 
            "Dies ist ein ganz normaler Gang in diesem Tempel.");

  AddDetail( ({"flammen"}),
	    "Die Flammen der Fackeln sind magisch.");

  AddDetail( ({"stelle","inschrift"}),
	    "Du kannst die Inschrift lesen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach verschimmelnden Blaettern.");  
 
  AddSmell( ({"blaetter"}),
	  "Die Blaetter stinken ein wenig waehrend sie am Boden verschimmeln.");

  AddSound(DEFAULT_SOUND, "Du hoerst Deine eigenen Schritte auf dem Boden "
                          "hallen.");

  AddSound( ({"schritte"}),
	   "Deine Schritte sind sicher weit im Tempel zu hoeren.");
  
  AddReadDetail( ({"inschrift"}),
		"Du bist schon sehr weit gekommen, gratuliere. \n"
                "                                    Chivas    \n");

//-----Details Ende-----
AddItem( "/d/unterwelt/basics/central/npc/skelett", REFRESH_DESTRUCT,
        ([P_MNPC_DEFAULTROOM: "tem40",
          P_MNPC_AREA:({ROOM "tem39", ROOM "tem40"}),
          P_MNPC_FLAGS: MOV_INDOORS + MOV_MAYLOAD + MOV_MOVES
        ]) );
AddItem( "/d/unterwelt/basics/central/npc/skelett", REFRESH_DESTRUCT,
        ([P_MNPC_DEFAULTROOM: "tem40",
          P_MNPC_AREA:({ROOM "tem39", ROOM "tem40"}),
          P_MNPC_FLAGS: MOV_INDOORS + MOV_MAYLOAD + MOV_MOVES
        ]) );
  
AddExit("norden", ROOM "tem41");
AddExit("nordosten", ROOM "tem35");
AddExit("nordwesten", ROOM "tem35");
AddExit("osten", ROOM "tem39");
AddExit("westen", ROOM "tem35");
AddExit("suedosten", ROOM "tem35");
AddExit("suedwesten", ROOM "tem35");
AddExit("sueden", ROOM "tem35");

}

