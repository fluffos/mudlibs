// von Chivas
inherit "std/room";

#include "../def.h"

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "An einem Tempel im Dschungel");
  SetProp( P_INT_LONG,
        "Die suedwestliche Ecke des Tempels ist mit graesslichen Fratzen und "
        "beunruhigend aussehenden Statuen verziert. Der Pfad fuehrt zwischen "
	"Dschungel und Tempel entweder weiter nach Osten oder um die Ecke "
        "nach Nordwesten. " );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 30, ENV_TERRAIN: TT_JUNGLE]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----

  AddDetail( ({"statuen"}), 
            "An der Ecke stehen drei grosse Statuen, dessen Koepfe bis hoch "
            "auf die erste Ebene reichen. Es sind drei verschiedene Statuen. "
            "Die erste stellt einen Dunkelelfen dar, die zweite Statue einen "
            "grossen Troll und die dritte Statue in der Mitte einen grossen "
            "Drachen.");

  AddDetail( ({"pfad"}),
	    "Der Pfad fuehrt um den ganzen Tempel herum.");

  AddDetail( ({"fratzen","anblick"}),
	    "Die Fratzen sehen nicht gerade freundlich aus, aber Du hast Dich "
            "an einen solchen Anblick bereits gewoehnt..");

  AddDetail( ({"biegung"}),
	    "Hier macht der Pfad eine Biegung um die Ecke des Tempels herum.");

  AddDetail( ({"ecke","osten","nordwesten"}), 
            "An der Ecke stehen drei Statuen und der Pfad macht eine Biegung "
            "nach Nordwesten.");

  AddDetail( ({"tempel","tempels"}),
	    "Der Tempel ragt neben Dir in den Himmel.");

  AddDetail( ({"rueckseite","dschungel","seite","dschungels","westseite"}),
	    "Auf der Rueckseite scheint der Dschungel naeher an den Tempel "
            "zu ruecken. Die Baeume und anderen Pflanzen sind dort dichter als "
            "hier an der Westseite."); 
  
  AddDetail( ({"boden"}), 
            "Am Boden sind verschiedene, Dir unbekannte Graeser zu erkennen. "
            "Ansonsten ist nicht viel zu sehen.");

  AddDetail( ({"himmel"}),
	    "Der Himmel ist blau, soweit Du es durch das Blaetterdach sehen "
            "kannst.");

  AddDetail( ({"mitte","drachen","drache"}),
	    "Der Drache in der Mitte sieht furchteinfloessend aus. Aus seinen "
            "Nuestern steigt ein wenig Qualm.");

  AddDetail( ({"troll","Trolls","hand"}), 
            "Die Statue des Trolls hat eine grosse Keule in der Hand. Sie "
            "besteht nicht aus Stein, sondern aus einem grossen Knochen, an "
            "dem am oberen Ende Eisenspitzen stecken.");

  AddDetail( ({"dunkelelf","dunkelelfen"}),
	    "Die Statue des Dunkelelfen verfolgt Deinen Weg. Seine Augen "
            "folgen Dir auf Schritt und Tritt.");

  AddDetail( ({"koepfe","ebene"}),
	    "Die Statuen sind so gross, dass ihre Koepfe bis zur ersten Ebene "
            "des Tempels hochragen."); 
  
  AddDetail( ({"nuestern","qualm"}), 
            "Aus den Nuestern, die aus ganz normalem Stein bestehen, quillen "
            "kleine Qualmwoelkchen.");

  AddDetail( ({"qualmwoelkchen","woelkchen"}),
	    "Du kannst sie sicher riechen.");

  AddDetail( ({"schritt","tritt","weg"}),
	    "Du untersuchst wirklich alles.");

  AddDetail( ({"augen"}), 
            "Die Augen sind nicht aus Stein. Sie sind lebendig und folgen Dir "
            "aufmerksam. Das ist irgendwie einschuechternd.");

  AddDetail( ({"stein"}),
	    "Die Statuen und der Tempel bestehen aus Stein.");

  AddDetail( ({"keule","waffe"}),
	    "Die Keule ist sicher eine gefaehrliche Waffe. Vielleicht kannst "
            "Du sie dem Troll klauen und fuer Dich benutzten. Sie sieht viel "
            "besser aus als Deine Waffe."); 
  
  AddDetail( ({"knochen"}), 
            "Die Keule besteht aus einem riesigen Knochen. Er stammt sicher "
            "von einem grossen Mammut.");

  AddDetail( ({"eisenspitzen","schlag","ende"}),
	    "Die Eisenspitzen an der Keule verschlimmern sicher noch einen "
            "Schlag mit der Keule um einiges.");

  AddDetail( ({"mammut","oberschenkelknochen","mammuts"}),
	    "Es ist sicher der Oberschenkelknochen eines Mammuts.");

  AddDetail( ({"baeume"}), 
            "Die Baeume sind gross und stehen dicht beieinander, so dass Du "
            "den Pfad nicht verlassen kannst.");

  AddDetail( ({"pflanzen"}),
	    "Es gibt viele Pflanzen hier im Dschungel. Die meisten von ihnen "
            "kennst Du nicht.");

  AddDetail( ({"blaetterdach","dach"}),
	    "Das Blaetterdach ist zwar dicht, trotzdem kannst Du den Himmel "
            "ein bisschen sehen."); 
  
  AddDetail( ({"statue"}), 
            "Welche meinst Du?");

  AddDetail( ({"graeser"}),
	    "Du kennst die Graeser am Boden nicht.");

  AddSmell(DEFAULT_SMELL, "Die Luft riecht ein wenig verbrannt.");  
 
  AddSmell( ({"luft"}),
	   "Die Luft ist von Qualm erfuellt, da aus den Nuestern einer Statue "
           "Qualm kommt.");

  AddSmell( ({"qualm","qualmwoelkchen"}),
	   "Der Qualm riecht nach ekeligem Schwefel.");

  AddSmell( ({"schwefel","duft"}),
	   "Es ist kein Duft der angenehm riecht.");

  AddSound(DEFAULT_SOUND, "Du hoerst die ueblichen Geraeusche des Dschungels.");

  AddSound( ({"geraeusche","dschungel"}),
	   "Es klingt alles so dschungelig, anders kann man es nicht "
           "ausdruecken.");
  
//-----Details Ende-----
  
AddExit("nordwesten", ROOM "tem23");
AddExit("osten", ROOM "tem21");

AddCmd( ({"klau", "klaue" }), "klauen" );

}
int klauen(string str)
{
   notify_fail("Was moechtest Du von wem klauen?\n");
   if ( member( ({ "keule von troll", "keule von statue" }),str) != -1) 
  {
    write(BS( "Du probierst an die Keule heran zu kommen, jedoch ist sie "
           "viel zu hoch. Du beschliesst Dir die Stelle zu merken und "
           "es vielleicht spaeter von oben noch einmal zu probieren.\n"));
    say( TPN+" probiert an etwas heran zukommen, scheitert jedoch.\n");
    return 1;
  }
}

