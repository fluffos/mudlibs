// von Chivas
inherit "std/room";

#include "../def.h"

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "An einem Tempel im Dschungel");
  SetProp( P_INT_LONG,
        "Der Pfad scheint kein Ende zu nehmen, der Tempel scheint im Innern "
        "riesig zu sein. Die Aussenmauer der Tempels ist hier komplett mit "
	"Ranken zugewachsen und die Baeume stehen dicht an der Wand, so dass "
        "man sich dicht an ihr an den Baeumen vorbeizwaengen muss. " );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_JUNGLE]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----

  AddDetail( ({"pfad"}), 
            "Der Pfad fuehrt um den ganzen Tempel herum. Er scheint riesig "
            "zu sein.");

  AddDetail( ({"ende"}),
	    "Irgendwann hat alles mal ein Ende.");

  AddDetail( ({"tempel","innern","tempels"}),
	    "Der Tempel ist riesig. Was sich wohl alles im Innern befindet?");

  AddDetail( ({"aussenmauer","mauer","wand"}), 
            "Die Aussenmauer ist komplett mit Ranken zugewachsen. Die Steine "
            "der Mauer sind nicht mehr zu erkennen.");

  AddDetail( ({"ranken"}),
	    "Die Ranken bedecken die ganze Mauer. Ein paar Blueten sind an "
            "ihnen zu sehen.");

  AddDetail( ({"baeumen","baeume"}),
	    "Die Baeume am Pfad ragen hoch hin den Himmel. Ihre Staemme sind "
            "dick und rissig."); 
  
  AddDetail( ({"boden"}), 
            "Am Boden wachsen einige kleinere Pflanzen.");

  AddDetail( ({"himmel"}),
	    "Der Himmel ist kaum durch die Blaetter der Baeume zu sehen.");

  AddDetail( ({"steine"}),
	    "Die Steine der Mauer sind komplett hinter den Ranken "
            "verschwunden.");

  AddDetail( ({"blueten"}), 
            "Die Blueten haben eine nicht so uebliche Farbe fuer Blueten.");

  AddDetail( ({"farbe"}),
	    "Die Blueten sind schwarz und stroemen einen ekeligen Geruch aus.");

  AddDetail( ({"staemme"}),
	    "Die Staemme sind dick und rissig. An einem Stamm faellt Dir Etwas "
            "auf."); 
  
  AddDetail( ({"stamm","etwas"}), 
            "Es sind ein paar Kratzer.");

  AddDetail( ({"kratzer"}),
	    "Die Kratzer scheinen eine Inschrift zu sein.");

  AddDetail( ({"inschrift"}),
	    "Du kannst sie lesen.");

  AddDetail( ({"blaetter"}), 
            "Die Blaetter der Baeume verbergen fast den ganzen Himmel.");

  AddDetail( ({"pflanzen"}),
	    "Es sind ein paar Farne, kleinere Straeucher und junge Baeume. "
            "In ein paar Jahren ist der Pfad nicht mehr zu erkennen.");

  AddDetail( ({"jahren","jahre"}),
	    "Es dauert noch ein wenig."); 
  
  AddDetail( ({"farne","farnen","windzug"}), 
            "Die Farne bewegen sich leicht, da ein kleiner Windzug am Boden "
            "entlangweht.");

  AddDetail( ({"straeucher","botanik"}),
	    "Du kennst die Straeucher nicht. Du musst Dich wohl mehr mit der "
            "Botanik im Dschungel beschaeftigen.");

  AddDetail( ({"dschungel"}),
	    "Du bist mittendrin.");

  AddDetail( ({"mittagessen","silberlandbank","detail","ihnen"}),
	    "Dieses Detail wird Ihnen von der Silberlandbank praesentiert."); 
  
  AddSmell(DEFAULT_SMELL, "Es liegt ein ekeliger Geruch in der Luft.");  
 
  AddSmell( ({"geruch","luft","blueten"}),
	   "Die schwarzen Blueten stroemen einen ekeligen Geruch aus, so dass "
           "Dir fast das Mittagessen wieder hoch kommt.");

  AddSound(DEFAULT_SOUND, "Du hoerst ein leichtes Rascheln.");

  AddSound( ({"rascheln","farne","wind"}),
	   "Das Rascheln stammt von den Farnen, die sich leicht im Wind "
           "bewegen.");
  
  AddReadDetail( ({"inschrift"}),
		"Ich ueberlebte den Tempel, aber ich werde immer noch "
                "verfolgt. Ich hoere meine Verfolger. Verlasse diesen "
                "trostlosen Ort. Ich werde ihn sicher nie verlassen. \n"
                "gez. ein armer Paladin, der fuer Dusty stirbt");

//-----Details Ende-----
  
AddExit("osten", ROOM "tem20");
AddExit("westen", ROOM "tem22");

}

