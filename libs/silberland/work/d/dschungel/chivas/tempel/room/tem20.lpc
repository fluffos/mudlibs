// von Chivas
inherit "std/room";

#include "../def.h"

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "An einem Tempel im Dschungel");
  SetProp( P_INT_LONG,
        "Ein grosser Baum ist aus dem Dschungel heraus auf den Tempel "
        "gestuerzt und hat dabei einige grosse Steinbrocken aus dem Tempel "
        "rausgebrochen, die nun zwischen den Pflanzen auf dem Pfad liegen. Du "
        "kannst aber ohne Probleme unter dem umgefallenen Baum durchgehen. " );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 30, ENV_TERRAIN: TT_JUNGLE]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----

  AddDetail( ({"baum","baumstamm","stamm","baumes"}), 
            "Der Baum ist umgestuerzt und liegt mit dem oberen Ende auf der "
            "ersten Ebene des Tempels.");

  AddDetail( ({"dschungel"}),
	    "Der Dschungel ist sehr dicht, lauter grosse Baeume und Straeucher "
            "versperren die Sicht. Nur an einer Stelle kann man ein wenig "
            "in den Dschungel gucken.");

  AddDetail( ({"tempel","tempels"}),
	    "Der Tempel ist noerdlich von Dir. Aus seiner Mauer sind einige "
            "grosse Steinbrocken heraus gebrochen.");

  AddDetail( ({"steinbrocken","brocken"}), 
            "Auf dem Pfad, dem Du bis hier her gefolgt bist, liegen einige "
            "grosse Steinbrocken. Sie sind aus der Mauer heraus gebrochen, "
            "als der Baumstamm auf die Mauer gefallen ist.");

  AddDetail( ({"pflanzen"}),
	    "Rings um Dich herum sind unzaehlige Pflanzen zu erkennen. Du "
            "kennst keine von ihnen.");

  AddDetail( ({"pfad"}),
	    "Du stehst auf dem Pfad der Dich bis hier her gefuehrt hat."); 
  
  AddDetail( ({"probleme"}), 
            "Du kannst, ohne Dir den Kopf zu stossen, unter dem Baumstamm "
            "durchgehen.");

  AddDetail( ({"boden"}),
	    "Zwischen den Pflanzen am Boden liegen die heraus gebrochenen "
            "Steinbrocken.");

  AddDetail( ({"himmel"}),
	    "Der Himmel ist blau. Durch die grosse Luecke, die der umgefallene "
            "Baum im Blaetterdach hinterlassen hat, kann man den Himmel gut "
            "erkennen.");

  AddDetail( ({"ebene"}), 
            "Der Tempel hat mehrere Ebenen. Der Baum liegt mit seinem oberen "
            "Ende auf der ersten Ebene des Tempels. Man kann sicher an dem "
            "umgestuerzten Baum hochklettern.");

  AddDetail( ({"stelle","anblick"}),
	    "An der Stelle, wo der umgefallene Baum gestanden hat, kann man "
            "etwas weiter in den Dschungel gucken. Erstaunlich, Du kannst "
            "viele Baeume erkennen. Du hast einen solchen Anblick nicht "
            "erwartet.");

  AddDetail( ({"baeume","baeumen"}),
	    "Grosse Baeume stehen direkt am Pfad. Von einigen haengen lange "
            "Schlingpflanzen herunter."); 
  
  AddDetail( ({"straeucher","mal"}), 
            "Es gibt hier verschiedene Straeucher. Du kennst sie jedoch nicht "
            "und beschliesst Dich das naechste Mal ein wenig schlauer zu "
            "machen, bevor Du in den Dschungel gehst.");

  AddDetail( ({"schlingpflanzen"}),
	    "Grosse lange Schlingpflanzen haengen von den Baeumen herunter. "
            "Du kommst ihnen besser nicht zu nahe, sie sehen so aus, als ob "
            "sie nach Dir greifen wuerden.");

  AddDetail( ({"luecke","blaetterdach","dach"}),
	    "Der umgefallene Baum hat eine grosse Luecke im Blaetterdach "
            "hinterlasssen. Ansonsten koenntest Du den Himmel sicher kaum "
            "sehen.");

  AddDetail( ({"mauer"}), 
            "Die Mauer sieht ein wenig lediert aus. An einigen Stellen sind "
            "ein paar Steinbrocken heraus gebrochen. Ansonsten kann man an "
            "ihr nicht viel erkennen.");

  AddDetail( ({"kopf","rasse"}),
	    "Dein Kopf ist fuer Deine Rasse viel zu gross.");

  AddDetail( ({"ende"}),
	    "Das obere Ende des Baumes liegt auf der ersten Ebene des "
            "Tempels."); 
  
  AddDetail( ({"sicht","seite"}), 
            "Du siehst nur Dschungel und natuerlich den Tempel auf der anderen "
            "Seite.");

  AddSmell(DEFAULT_SMELL, "Es riecht nach Dschungel.");  
 
  AddSmell( ({"dschungel"}),
	   "Es riecht nach den Pflanzen.");

  AddSmell( ({"pflanzen"}),
	   "Die Pflanzen stroemen verschiedene Duefte aus.");

  AddSmell( ({"duefte"}),
	   "Mal riecht es suesslich und manchmal ein wenig herb.");

  AddSound(DEFAULT_SOUND, "Du hoerst die Blaetter in den Baumen rauschen.");

  AddSound( ({"blaetter","rauschen","wind"}),
	   "Der Wind weht durch die Blaetter und bringt sie zum Rauschen.");
  
//-----Details Ende-----
  
AddExit("osten", ROOM "tem19");
AddExit("westen", ROOM "tem21");

AddCmd( ({"kletter","klettere" }), "klettern" );

}
int klettern(string str)
{
   notify_fail("Woran moechtest Du hochklettern?\n");
   if ( member( ({ "baum","baum hoch","an baum hoch","an baumstamm hoch","baumstamm hoch","baumstamm","stamm hoch","stamm" }),str) != -1) 
  {
    write(BS ( "Du kletterst mit Muehe den umgekippten Baumstamm hoch und "
               "erreichst eine Art Terasse auf der ersten Ebene des "
               "Tempels.\n"));
    TP->move(ROOM "tem1-16", M_GO, 
      "einen umgefallenen Baumstamm hoch und verschwindet",
      "klettert", "kommt ueber den Baumstamm heraufgeklettert");
    return 1;
  }
}

