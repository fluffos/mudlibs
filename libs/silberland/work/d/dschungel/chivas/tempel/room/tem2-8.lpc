// von Chivas
inherit "std/room";

inherit "/std/player/moneyhandler";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();


  SetProp( P_INT_SHORT, "In einem Tempel");
  SetProp( P_INT_LONG,
        "An der westlichen Wand steht ein scheusslich aussehender Altar und "
        "einige dunkle Gestalten knien davor und murmeln boesartige Gebete. "
        "An beiden Seiten des Altars stehen grosse Steinkruege, in denen ein "
        "magisches Feuer brennt, dass bei jedem Gebet der knieenden Gestalten "
        "aufleuchtet und die jeweilige Person in eine magische Aura huellt." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  
  AddDetail( ({"wand","waende"}), 
            "An der westlichen Wand steht ein grosser Altar. Die anderen "
            "Waende sind schmucklos und man sieht nur die ganz normale "
            "Mauer.");

  AddDetail( ({"altar","altars"}),
	    "Der Altar wirkt dunkel und duester. Der Altar scheint das Boese "
            "geradezu anzuziehen. Auf dem Altar sind einige Totenkoepfe "
            "gestapelt und einige Gefaesse scheinen mit Blut gefuellt zu sein. "
            "Ausserdem entdeckst Du eine kleine Plakette, die am Altar "
            "befestigt ist.");

  AddDetail( ({"gestalten"}),
	    "Ein paar duestere Gestalten beten vor dem Altar das Boese an.");

  AddDetail( ({"gebete","gebet"}), 
            "Du kannst sie nicht untersuchen. Lausche doch mal.");

  AddDetail( ({"seiten"}),
	    "Zu beiden Seiten des Altars stehen grosse Steinkruege, in denen "
            "ein magisches Feuer brennt.");

  AddDetail( ({"steinkruege","steinkrug","kruege","krug","steinkruegen"}),
	    "Die Steinkruege sind aus Granit und unzerstoerbar. In ihnen "
            "brennt ein magisches Feuer."); 
  
  AddDetail( ({"feuer"}), 
            "Das magische Feuer leuchtet in einem kalten Blau. Ab und zu, wenn "
            "eine der Personen vor dem Altar ein Gebet, eine Huldigung oder "
            "eine Verfluchung wispert, umgibt das magische Feuer die Person "
            "und staerkt sie.");

  AddDetail( ({"person","personen"}),
	    "Eine der duesteren Gestalten, die betet.");

  AddDetail( ({"aura"}),
	    "Die Aura, die von den Steinkruegen ausgeht und die Gestalten "
            "waehrend der Gebete umgibt, ist eine maechtige Magie.");

  AddDetail( ({"boden"}), 
            "Auf dem Boden erkennt man Steinplatten. ");

  AddDetail( ({"decke","himmel"}),
	    "Die Decke ist ein wenig verrusst. Ansonsten ist nichts zu "
            "erkennen.");

  AddDetail( ({"steinplatten","platten"}),
	    "Auf den Steinplatten sind Verzierungen zu erkennen."); 
  
  AddDetail( ({"verzierungen"}), 
            "Die Verzierungen sind magische Symbole.");

  AddDetail( ({"mauer"}),
	    "Die Mauer besteht aus grossen Steinquadern.");

  AddDetail( ({"steinquader","steinquadern","arbeit"}),
	    "Die Steinquader sind sauber verfugt. Keinerlei Risse oder Loecher "
            "sind zu erkennen. Eine saubere Arbeit.");

  AddDetail( ({"risse","loecher"}), 
            "Beides ist nicht zu erkennen.");

  AddDetail( ({"symbole"}),
	    "Es sind Symbole von boeser Magie.");

  AddDetail( ({"magie"}),
	    "Magie kann ein wertvoller Verbuendeter sein oder ein starker "
            "Feind."); 
  
  AddDetail( ({"feind","feinde"}), 
            "Feinde hast Du genug.");

  AddDetail( ({"verbuendeter","verbuendeten"}),
	    "Einen Verbuendeten zu haben ist immer gut.");

  AddDetail( ({"boese"}),
	    "Das Boese tritt in verschiedenen Erscheinungsformen auf.");

  AddDetail( ({"erscheinungsformen","formen"}), 
            "Du kennst einige, aber bei weitem nicht alle.");

  AddDetail( ({"granit","steinart"}),
	    "Granit ist eine Steinart, die sehr sehr hart ist.");

  AddDetail( ({"huldigung"}),
	    "Eine Huldigung ist immer gut."); 
  
  AddDetail( ({"verfluchung"}), 
            "Manche Personen verdienen eine anstaendige und saubere "
            "Verfluchung.");

  AddDetail( ({"blut","gefaesse"}),
	    "Das Blut in den Gefaessen scheint ein Opfer darzustellen. "
            "Du wendest Dich angeekelt ab.");

  AddDetail( ({"totenkoepfe","kampf","helden"}),
	    "Die Totenkoepfe scheinen von Helden zu stammen, die den Kampf "
            "gegen das Boese verloren haben.");

  AddDetail( ({"blau"}), 
            "Das Blau des Feuers wirkt kalt und boese.");

  AddDetail( ({"opfer"}),
	    "Du hoffst, dass Du hier im Tempel nicht auch noch irgendwem zum "
            "Opfer faellst.");

  AddDetail( ({"tempel"}),
	    "Du bist nun schon ziemlich tief im Tempel.");

  AddDetail( ({"plakette"}),
	    "Auf der Plakette, die ein wenig blutbefleckt ist, steht etwas "
            "geschrieben. Du kannst die Plakette lesen."); 
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Weihrauch.");  
 
  AddSmell( ({"weihrauch","geruch","feuer"}),
	   "Der Geruch kommt von dem Feuer.");

  AddSound(DEFAULT_SOUND, "Du hoerst das Gemurmel der Gebete.");

  AddSound( ({"gemurmel","gebete"}),
	   "Das Gemurmel und die Gebete kannst Du nicht genau verstehen. "
           "Du weisst aber, dass es boese Gebete zu sein scheinen.");
  
  AddReadDetail( ({"plakette"}),
		"+-------------------------------------------------+\n"
                "| Folgende Gebete, Huldigungen und Verfluchungen  |\n"
                "| koennen erworben werden:                        |\n"
                "|                                                 |\n"
                "| Gebet an Lloth                     1000 Muenzen |\n"
                "| Huldigung von Xarfai               1200 Muenzen |\n"
                "| Verfluchung von Ayla               1500 Muenzen |\n"
                "| Verfluchung von Dusty              1800 Muenzen |\n"
                "| Huldigung des Boesen               2500 Muenzen |\n"
                "|                                                 |\n"
                "| Syntax: <kaufe 'lloth' oder 'xarfai'...         |\n"
                "+-------------------------------------------------+\n");

//-----Details Ende-----
AddItem(NPC "priester", REFRESH_DESTRUCT);
  
AddExit("sueden", ROOM "tem2-9");
AddExit("norden", ROOM "tem2-7");

AddCmd( ({"kauf", "kaufe"}), "kaufen" );

}
int kaufen(string str)
{

 notify_fail("Was moechtest Du kaufen? \n");

 if(!str || str == "") return 0;
 if(!(str == "lloth" ||
      str == "xarfai" ||
      str == "ayla" ||
      str == "dusty" ||
      str == "boesen" )) return 0;
 

 if( str == "lloth"){
  if (TP->QueryMoney() < 1000){
  write(BS("Soviele Muenzen hast Du nicht."));
  return -1;
  }
  write(BS("Du trittst vor den Altar und kniest betend nieder. Waehrend Du "
           "Lloth anbetest, durchfaehrt Dich eine magische Aura und Du "
           "fuehlst Dich erfrischt und ein bisschen boeser als vorher.\n"));
 
  say(TPN+" betet zu Lloth und wird von einer magischen Aura aus dem Feuer \n"
          "umschlossen. " );
  this_player()->AddMoney(-1000);
  TP->AddHp(50);
  TP->AddSp(50);
  TP->SetProp(P_ALIGN, TP->QueryProp(P_ALIGN)-100);
  return 1;
  }

 if( str == "xarfai"){
  if (TP->QueryMoney() < 1200){
  write(BS("Soviele Muenzen hast Du nicht."));
  return -1;
  }
  write(BS("Du trittst vor den Altar und huldigst dem glorreichen "
           "Xarfai, dem Kaempfer fuer das Boesen. Ploetzlich umgibt Dich eine "
           "magische Aura und gibt Dir mehr Kraft des Boesen.\n"));
 
  say(TPN+" huldigt Xarfai und fuehlt sich durch die magische Aura gestaerkt und "
          "boeser als zuvor.\n");
  TP->AddHp(70);
  TP->AddSp(70);
  this_player()->AddMoney(-1200);
  TP->SetProp(P_ALIGN, TP->QueryProp(P_ALIGN)-100);
  return 1;
  }

 if( str == "ayla"){
  if (TP->QueryMoney() < 1500){
  write(BS("Soviele Muenzen hast Du nicht."));
  return -1;
  } 
  write(BS("Du verfluchst knieend Ayla vor dem dunklen Altar und eine magische "
           "Aura umgibt Dich und gibt Dir wieder Kraft und Magie.\n"));
 
  say(TPN+" verflucht Ayla und fuehlt sich im Kampf gegen das Gute bestaerkt.\n");
  this_player()->AddMoney(-1500);
  TP->AddHp(90);
  TP->AddSp(90);
  TP->SetProp(P_ALIGN, TP->QueryProp(P_ALIGN)-100);
  return 1;
  }

 if( str == "dusty"){
  if (TP->QueryMoney() < 1800){
  write(BS("Soviele Muenzen hast Du nicht."));
  return -1;
  }
  write(BS("Du verfluchst Dusty, die Goettin des Guten, worauf Dich eine magische "
           "Aura umgibt und Dich im Kampf des Boesen staerkt.\n"));
 
  say(TPN+" verflucht die Goettin der Paladine und eine magische Aura spendet Kraft.\n");
  this_player()->AddMoney(-1800);
  TP->AddHp(110);
  TP->AddSp(110);
  TP->SetProp(P_ALIGN, TP->QueryProp(P_ALIGN)-100);
  return 1;
  }

 if( str == "boesen"){
  if (TP->QueryMoney() < 2500){
  write(BS("Soviele Muenzen hast Du nicht."));
  return -1;
  }
  write(BS("Du trittst vor den Altar, kniest nieder und huldigst das Boese selbst. "
           "Ein magisches Feuer aus den Steinkruegen umgibt Dich und gibt Dir mehr "
           "Kraft und Magie, um das Gute auf dieser Welt aufzuhalten.\n"));
 
  say(TPN+" fuehlt sich durch die Huldigung des Boesen gestaerkt.\n");
  this_player()->AddMoney(-2500);
  TP->AddHp(200);
  TP->AddSp(200);
  TP->SetProp(P_ALIGN, TP->QueryProp(P_ALIGN)-100);
  return 1;
  }
}

