// von Chivas
inherit "std/room";

#include "../def.h"

void create()
	
{
  ::create();

  AddRoomMessage( ({ "Der Ast auf dem Du sitzt, knackst sehr bedenklich.\n"}),
                     30);


  SetProp( P_INT_SHORT, "Auf einem Baum im Dschungel");
  SetProp( P_INT_LONG,
        "Du sitzt hoch auf einem Baum ueber dem Pfad weit unter Dir. Du hast "
        "einen tollen Ausblick ueber den Dschungel. Du kannst sehen wie sich "
        "der Fluss in Richtung Meer schlaengelt und auch Tijara, wie es ganz "
        "friedlich im Dschungel liegt. Ueber Dir steht die Sonne fast "
        "senkrecht, aber sie wird teilweise von den paar kleinen Wolken "
        "verdeckt." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 30, ENV_TERRAIN: TT_JUNGLE]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  
  AddDetail( ({"baum"}), 
            "Hier oben auf dem Baum hat man eine herrliche Aussicht. Du siehst "
            "den Fluss, das Meer, Tijara und das riesige Blaetterdach des "
            "Dschungels von oben. Weit unter Dir auf dem Boden ist der Pfad, "
            "ueber den Du hier her gekommen bist.");

  AddDetail( ({"pfad"}),
	    "Der Pfad ist tief unter Dir. Ein Sturz von hier oben waere sehr "
            "ungesund.");

  AddDetail( ({"ausblick","aussicht"}),
	    "Der Ausblick ist herrlich. Du sitzt fast auf dem hoechsten Baum "
            "und kannst alles sehen.");

  AddDetail( ({"fluss"}), 
            "Der Fluss glitzert in der Sonne, die ein wenig von den Wolken "
            "verdeckt ist und schlaengelt sich in Richtung Meer.");

  AddDetail( ({"richtung","meer","muendung"}),
	    "Du siehst die Muendung vom Fluss und das grosse Meer. In einiger "
            "Entfernung siehst Du die Karavelle, die Kurs auf Tijara nimmt.");

  AddDetail( ({"tijara"}),
	    "Tijara liegt oestlich von Dir, inmitten des grossen Dschungels."); 
  
  AddDetail( ({"dschungel"}), 
            "Der Dschungel liegt friedlich unter Dir.");

  AddDetail( ({"sonne","teil"}),
	    "Die Sonne steht fast senkrecht am Himmel. Nur ein paar Wolken "
            "sind zu sehen, die einen Teil der Sonne verdecken.");

  AddDetail( ({"himmel"}),
	    "Der Himmel ist schoen blau, nur ein paar Wolken sind zu sehen.");

  AddDetail( ({"wolken"}), 
            "Ein paar weisse Wolken ziehen am Himmel entlang. Momentan "
            "verdecken sie ein bisschen die Sonne, was jedoch kaum Einfluss "
            "auf die Sonnenstrahlen hat.");

  AddDetail( ({"entfernung","karavelle","kurs"}),
	    "Die Karavelle nimmt anscheinend Kurs auf Tijara und bringt "
            "Abenteurer von Midas in die Region Dschungel.");

  AddDetail( ({"boden"}),
	    "Der Boden ist weit unter Dir."); 
  
  AddDetail( ({"blaetterdach"}), 
            "Das Blaetterdach erstrahlt von hier oben in einem hellen Gruen.");

  AddDetail( ({"einfluss"}),
	    "Es ist fast genau so hell, als ob die Wolken nicht da waeren.");

  AddDetail( ({"sonnenstrahlen","strahlen"}),
	    "Die Sonnenstrahlen glitzern im Meer und im Fluss.");

  AddDetail( ({"midas","hauptstadt"}), 
            "Midas ist die Hauptstadt des Silberlandes.");

  AddDetail( ({"region"}),
	    "Die Region Dschungel ist sehr interessant, aber auch "
            "gefaehrlich.");

  AddDetail( ({"silberland","silberlandes"}),
	    "Du bist im Silberland."); 
  
  AddDetail( ({"gruen"}), 
            "Es sind auch ein paar Brauntoene und auch etwas Gelb zu sehen.");

  AddDetail( ({"brauntoene"}),
	    "Es ist nicht richtig braun, halt ein bisschen ins braun gehend.");

  AddDetail( ({"gelb","farbe"}),
	    "Die gelbe Farbe stammt anscheinend von ein paar Blueten auf den "
            "anderen Baeumen.");

  AddDetail( ({"baeume","baeumen"}), 
            "Es gibt sehr viele Baeume in einem Dschungel. Du sitzt auf "
            "einem.");

  AddDetail( ({"blueten","dschungelriesen","riesen","meter","naehe"}),
	    "Die Blueten sind an einem Dschungelriesen, der ein paar Meter von "
            "Dir entfernt ist. Er ist jedoch unerreichbar.");

  AddDetail( ({"ast","astes"}),
	    "Du sitzt auf einem grossen Ast."); 
  
  AddDetail( ({"abenteurer"}), 
            "Du bist auch einer und zwar ein aeussert wagemutiger.");

  AddDetail( ({"sturz"}),
	    "Ein Sturz wuerde richtig weh tun, falls Du es ueberlebst.");

  AddSmell(DEFAULT_SMELL, "Du riechst den Duft von Blueten.");  
 
  AddSmell( ({"duft","blueten"}),
	   "Die Blueten stammen von einem Baum ganz in Deiner Naehe.");

  AddSound(DEFAULT_SOUND, "Das Knacksen des Astes unter Dir wird immer "
                          "lauter.");

  AddSound( ({"knacksen","ast"}),
	   "*knacks*knirsch*knacks*");
  
//-----Details Ende-----
  
AddExit("runter", ROOM "tem6");

}

