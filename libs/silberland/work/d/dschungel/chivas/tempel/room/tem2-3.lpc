// von Chivas
inherit "std/room";

#include "../def.h"

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Tempel");
  SetProp( P_INT_LONG,
        "Die Kammer, in der Du stehst, knistert geradezu vor magischer Energie. "
        "Der gesamte Boden schimmert in einem kalten Blau aehnlich den Fackeln "
        "an den Waenden. Die Decke scheint mit Bildern verziert zu sein, die "
        "sich jedoch staendig veraendern." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----

  AddDetail( ({"kammer"}), 
            "Die Kammer knistert vor Magie, so dass Dir saemtliche Haare vom "
            "Koerper abstehen. Ein komisches Gefuehl.");

  AddDetail( ({"energie"}),
	    "Die magische Energie um Dich herum ist so stark, dass sie am "
            "knistern ist.");

  AddDetail( ({"boden","bodens"}),
	    "Der Boden schimmert in einem magischen Blau. Es schimmert fast "
            "wie Eis.");

  AddDetail( ({"blau"}), 
            "Das Blau des Bodens und der Fackeln um Dich herum erfuellt die "
            "Kammer mit einem kalten Licht.");

  AddDetail( ({"fackeln"}),
	    "Es sind nur die ueblichen Fackeln, wie Du sie auf dieser Ebene "
            "schon oefters gesehen hast.");

  AddDetail( ({"waende","waenden"}),
	    "An den kahlen Waenden haengen nur die ueblichen Fackeln. "
            "Ansonsten ist an ihnen nichts zu erkennen."); 
  
  AddDetail( ({"decke","himmel"}), 
            "Die Decke ist fastzinierend. Es scheinen magische Bilder an der "
            "Decke abgebildet zu sein, die sich jedoch staendig veraendern.");

  AddDetail( ({"bilder","bildern"}),
	    "Die Bilder an der Decke wirken sehr real. Es scheint, so als ob "
            "die Personen, die in den Bildern erscheinen, in den Bildern "
            "gefangen sind.");

  AddDetail( ({"haare","koerper","gefuehl"}),
	    "Ein wirklich komisches Gefuehl, so von Magie umgeben zu sein.");

  AddDetail( ({"magie"}), 
            "Um Dich herum herrscht eine starke Magie. Sie scheint von Ebene "
            "zu Ebene groesser zu werden.");

  AddDetail( ({"ebene"}),
	    "Du bist auf der zweiten Ebene des Tempels. Weiter oben wird die "
            "Magie sicher noch staerker.");

  AddDetail( ({"tempel","tempels"}),
	    "Du bist auf der zweiten Ebene im Tempel."); 
  
  AddDetail( ({"eis"}), 
            "Da von dem Boden eine leichte Waerme ausgeht, bist Du Dir sicher, "
            "dass es kein Eis ist.");

  AddDetail( ({"waerme"}),
	    "Es ist keine starke Waerme, die vom Boden ausgeht, es ist nur ein "
            "paar Grad waermer als in den anderen Raeumen auf dieser Ebene.");

  AddDetail( ({"raeumen","raeume","gaenge","raum"}),
	    "Dieser Raum ist eine Kammer, aber es gibt auch noch Gaenge und "
            "andere grosse Raeume.");

  AddDetail( ({"grad"}), 
            "Es ist kaum zu bemerken. Es sind sicher nur so um die fuenf "
            "Grad.");

  AddDetail( ({"licht"}),
	    "Das blaeuliche Licht wirkt magisch und kalt.");

  AddDetail( ({"personen"}),
	    "Die Personen in den Bildern stammen aus allen Rassen, die es im "
            "Silberland gibt. Sie wirken schmerzverzerrt und scheinen zu "
            "schreien. Die Schreie der Personen sind jedoch nicht zu hoeren, "
            "aber Du spuerst das sie grosse Qualen erleiden. Du wendest Deinen "
            "Blick ab und willst weiter gehen."); 
  
  AddDetail( ({"silberland"}), 
            "Du befindest Dich tief im Silberland.");

  AddDetail( ({"schreie"}),
	    "Du kannst die Schreie nur erahnen. Du kannst sie nicht hoeren.");

  AddDetail( ({"qualen"}),
	    "Die Qualen muessen sehr schlimm sein. Die Gesichter sind "
            "schmerzverzerrt.");

  AddDetail( ({"blick"}), 
            "Du kannst die Decke nicht mehr ansehen.");

  AddDetail( ({"rassen","aufzaehlung","chivas"}),
	    "Eine Aufzaehlung der Rassen ist hier sicher nicht noetig. Chivas "
            "ist zu faul.");

  AddDetail( ({"gesichter","gesichtern"}),
	    "Du wirst sicher von den Gesichtern traeumen. Du kannst es sicher "
            "nie wieder vergessen."); 
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach gar nichts. Die Kammer wirkt gerade "
                          "zu steril.");  
 
  AddSound(DEFAULT_SOUND, "Du hoerst das Knistern der Magie.");

  AddSound( ({"knistern","magie"}),
	   "*knister*knister*knister*");
  
//-----Details Ende-----
  
AddExit("norden", ROOM "tem2-4");
AddExit("westen", ROOM "tem2-2");

}

