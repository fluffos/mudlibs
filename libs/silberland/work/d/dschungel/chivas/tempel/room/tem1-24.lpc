// von Chivas
inherit "std/room";

#include "../def.h"

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einem Tempel im Dschungel");
  SetProp( P_INT_LONG,
        "Du stehst genau ueber dem Eingang zum Tempel. Unter Dir siehst Du "
        "die Lichtung vor dem Tempel. Hier auf der ersten Ebene ausserhalb des "
        "Tempels stehen zwei Steingargyls, die die ganze Lichtung von oben zu "
        "bewachen scheinen." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 30, ENV_TERRAIN: TT_JUNGLE]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );
  
//-----Details Anfang-----
  
  AddDetail( ({"eingang"}), 
            "Der Eingang zum Tempel liegt unter Dir. Du kannst ihn direkt "
            "nicht sehen, aber Du erkennst die Lichtung vor dem Eingang.");

  AddDetail( ({"tempel","vorderseite","tempels"}),
	    "Du bist auf der Vorderseite des Tempels. Der Eingang liegt direkt "
            "unter Dir.");

  AddDetail( ({"lichtung"}),
	    "Die Lichtung vor dem Tempel kommt Dir bekannt vor. Das liegt "
            "sicher daran, weil Du schon auf ihr gestanden hast.");

  AddDetail( ({"ebene","ebenen"}), 
            "Du bist auf der ersten Ebene ausserhalb des Tempels. Auf die "
            "anderen hoeheren Ebenen kommst Du jedoch nur innerhalb des "
            "Tempels.");

  AddDetail( ({"steingargyls","gargyls","stein"}),
	    "Zwei grosse Gargyls aus Stein stehen vor Dir und scheinen den "
            "Eingang von oben zu bewachen. Sie sehen sehr lebendig aus. Du "
            "solltest sie nicht stoeren. Ihre Augen scheinen sich sogar zu "
            "bewegen.");

  AddDetail( ({"boden"}),
	    "Am Boden sind ausnahmsweise keine Graeser, Blumen oder Moose zu "
            "sehen, da alles verbrannt zu sein scheint. Du siehst nur die "
            "blanken Steinquader der Decke des Erdgeschosses und kleine "
            "Haeufchen von Asche."); 
  
  AddDetail( ({"himmel"}), 
            "Der Himmel ist blau. Ein paar Voegel fliegen hoch oben am "
            "Himmel.");

  AddDetail( ({"augen"}),
	    "Die Augen der Steingargyls leuchten rot. Dies ist ein eindeutiges "
            "Zeichen, dass es keine normalen Statuen sind.");

  AddDetail( ({"statuen","zeichen"}),
	    "Bei normalen Statuen leuchten recht selten die Augen.");

  AddDetail( ({"voegel","vogel"}), 
            "Es scheinen ein paar Geier zu sein.");

  AddDetail( ({"geier"}),
	    "Sie scheinen auf Deinen Kadaver zu warten. Du schluckst.");

  AddDetail( ({"kadaver"}),
	    "Es ist noch nicht soweit, sie muessen sich noch ein wenig "
            "gedulden."); 
  
  AddDetail( ({"haeufchen","asche","vorstellung"}), 
            "Was die Asche einmal gewesen sein koennte, entzieht sich Deiner "
            "Vorstellung oder Du willst es Dir einfach nicht vorstellen.");

  AddDetail( ({"steinquader","quader"}),
	    "Die Steinquader der Decke weisen eindeutige Brandspuren auf.");

  AddDetail( ({"decke","erdgeschosses","erdgeschoss"}),
	    "Es ist natuerlich klar, dass der Boden auf dem Du stehst, die "
            "Decke des Erdgeschosses sein muss.");

  AddDetail( ({"brandspuren","spuren"}), 
            "Es sieht so aus, als ob hier ein Kampf stattgefunden hat.");

  AddDetail( ({"kampf"}),
	    "Der Kampf ist laengst vorbei.");

  AddDetail( ({"blumen","graeser","moose"}),
	    "So etwas kannst Du hier nicht mehr sehen. Alles was einmal am "
            "Boden gewachsen ist, ist verbrannt."); 
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Asche.");  
 
  AddSmell( ({"asche"}),
	   "Anscheinend ist hier irgendetwas verbrannt.");

  AddSound(DEFAULT_SOUND, "Du hoerst das Kraechzen der Geier am Himmel.");

  AddSound( ({"kraechzen","geier"}),
	   "Das Kraechzen der Geier beruhigt Dich nicht besonders.");
  
//-----Details Ende-----
  
AddExit("osten", ROOM "tem1-25");
AddExit("westen", ROOM "tem1-23");

}

