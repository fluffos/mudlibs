// von Chivas
inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();


  SetProp( P_INT_SHORT, "In einem Tempel");
  SetProp( P_INT_LONG,
        "In dieser Kammer ist erneut ein Portal. Dieses Mal schimmert es in "
        "einer roetlichen Farbe. Ein paar leutchtende Linien am Boden laufen "
	"direkt auf das Portal zu, so dass es fast wie eine rote Sonne "
        "aussieht. Ansonsten wirkt die Kammer auf Dich recht leer. Die Waende "
        "und die Decke kahl." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  
  AddDetail( ({"kammer"}), 
            "In dieser Kammer gibt es mal wieder ein Portal. Du freust Dich.");

  AddDetail( ({"portal"}),
	    "Das Portal schimmert roetlich. Du bist gespannt wo es Dich "
            "hinbringen wird.");

  AddDetail( ({"mal"}),
	    "Dieses Mal ist das Portal rot.");

  AddDetail( ({"farbe","rot"}), 
            "Die roetliche Farbe sieht fast wie Blut aus.");

  AddDetail( ({"linien"}),
	    "Die Linien laufen von aussen auf die Mitte in der Kammer zu. Sie "
            "schimmern in einem magischen Rot.");

  AddDetail( ({"sonne"}),
	    "Dies war nur bildlich gemeint. Ausserhalb des Tempels scheint "
            "sicher die Sonne. Du willst eigentlich raus und sie sehen."); 
  
  AddDetail( ({"boden"}), 
            "Am Boden sind normale Steinplatten, auf denen die Linien zu sehen "
            "sind, die in die Mitte laufen.");

  AddDetail( ({"decke","himmel"}),
	    "Die Decke ist schmucklos. Nur ein paar Spinnweben sind zu "
            "sehen.");

  AddDetail( ({"waende","wand"}),
	    "An den Waenden haengen normalerweise Halterungen mit Fackeln. "
            "Diesmal sind keine zu erkennen und die Waende sind kahl.");

  AddDetail( ({"blut"}), 
            "Es sieht nur so aus, keine Angst.");

  AddDetail( ({"angst"}),
	    "Du hast eigentlich vor nichts mehr Angst. Du bist sehr tapfer.");

  AddDetail( ({"tempels","tempel","frage"}),
	    "Hier im Tempel ist es meistens duester und dunkel. Du bist "
            "aber schon so weit gekommen, dass ein Rueckzug fuer Dich nicht "
            "in Frage kommt."); 
  
  AddDetail( ({"rueckzug"}), 
            "Du bist ein grosser Krieger/in. Einen Rueckzug wirst Du nicht "
            "machen.");

  AddDetail( ({"halterungen","fackeln"}),
	    "Es sind keine zu sehen, nur die Loecher, in denen die Halterungen "
            "einmal befestigt waren.");

  AddDetail( ({"mitte"}),
	    "In der Mitte der Kammer steht das Portal.");

  AddDetail( ({"krieger","fall"}), 
            "Auf jeden Fall willst Du mal einer werden.");

  AddDetail( ({"spinnweben","jahren"}),
	    "Die Spinnweben wurden schon vor Jahren verlassen. Wo die Spinnen "
            "jetzt sind, weisst Du nicht und willst es auch gar nicht wissen.");

  AddDetail( ({"spinnen","spinne"}),
	    "Du magst keine Spinnen und Du bist froh, dass Du keine siehst."); 
  
  AddDetail( ({"loecher"}), 
            "In den Loechern waren einmal die Halterungen fuer die Fackeln "
            "befestigt. Sie wurden sicher abgebaut, als das Portal aufgestellt "
            "wurde, da dieses den Raum gut genug erhellt.");

  AddDetail( ({"raum"}),
	    "Der Raum ist eine normale Kammer.");

  AddDetail( ({"steinplatten","platten"}),
	    "Die Steinplatten sind bis auf die Linien schmucklos. Es ist nicht "
            "einmal ein bisschen Staub auf den Platten zu erkennen.");

  AddDetail( ({"staub"}), 
            "Es ist keiner zu sehen.");

  AddSmell(DEFAULT_SMELL, "Es riecht nach gar nichts.");  
 
  AddSound(DEFAULT_SOUND, "Es ist totenstill.");

//-----Details Ende-----

AddItem(OBJ "portalr", REFRESH_DESTRUCT);
//AddItem( "/d/kristallwald/chivas/zentauren/npc/geist", REFRESH_DESTRUCT,
AddItem(NPC "tempelgeist", REFRESH_DESTRUCT,
        ([P_MNPC_DEFAULTROOM: "tem41",
          P_MNPC_AREA:({ROOM "tem39", ROOM "tem40", ROOM "tem41"}),
          P_MNPC_FLAGS: MOV_INDOORS + MOV_MAYLOAD + MOV_MOVES
        ]) );
  
AddExit("sueden", ROOM "tem40");


AddCmd( ({"betrete" }), "betreten" );

}
int betreten(string str)
{
   notify_fail("Was moechtest Du betreten?\n");
   if ( member( ({ "portal","rotes portal" }),str) != -1) 
  {
    write(BS ( "Du betrittst das schimmernde Portal und die Umgebung "
               "verschwimmt. Mal sehen wo Dich das Portal hinbringt.\n"));
    say( TPN+" betritt das Portal und verschwindet.\n");
    TP->AddSp(-50);
    this_player()->move(ROOM "tem42", M_TPORT);
    return 1;
  }
}

