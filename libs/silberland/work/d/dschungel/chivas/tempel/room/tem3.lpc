// von Chivas
inherit "std/room";

#include "../def.h"

int salada;

object resetsala;

void create()
	
{
  ::create();

   salada=1; 

  SetProp( P_INT_SHORT, "Auf einem Dschungelpfad");
  SetProp( P_INT_LONG,
        "Du befindest Dich schon recht tief im Dschungel. Der Pfad scheint "
        "Richtung Norden besser sichtbar zu sein als Richtung Sueden. "
	"Ueberall sind Pflanzen in den unterschiedlichsten Gruentoenen, die "
        "Du jedoch nicht kennst. Der Boden ist mit Laub bedeckt, dass von "
        "den Pflanzen abgefallen ist." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 30, ENV_TERRAIN: TT_JUNGLE]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  
  AddDetail( ({"dschungel","urwald"}), 
            "Es ist ueberall Dschungel um Dich herum. Ueberall sind nur "
            "Pflanzen zu sehen.");

  AddDetail( ({"pfad"}),
	    "Der Pfad im Norden ist besser einsehbar. Im Sueden werden die "
            "die Baeume immer dichter und das voran kommen schwerer.");

  AddDetail( ({"richtung"}),
	    "Es geht nach Norden und nach Sueden.");

  AddDetail( ({"norden"}), 
            "Im Norden ist der Pfad besser.");

  AddDetail( ({"sueden"}),
	    "Im Sueden wird der Pfad immer undurchdringlicher.");

  AddDetail( ({"pflanzen"}),
	    "Ueberall um Dich herum sind Pflanzen. Die Vielfalt reicht von "
            "Graesern am Boden bis zu den Urwaldriesen um Dich herum."); 
  
  AddDetail( ({"gruentoene","gruentoenen","gruen","toene","farbpalette"}), 
            "Die Farbpalette der Gruentoene reicht von einem hellen Grasgruen "
            "bis zu einem dunklen Salamandergruen.");

  AddDetail( ({"boden"}),
	    "Am Boden sind einige Graeser zu sehen und viel Laub, dass von den "
            "Baeumen und Straeuchern hier im Wald herunter gefallen ist. Es "
            "nimmt langsam eine gelbgruene Faerbung an.");

  AddDetail( ({"laub","schicht"}),
	    "Das Laub bildet eine dicke Schicht zwischen den Graesern am "
            "Boden, so dass Du richtig im Laub einsinkst. Der Boden ist durch "
            "das Laub ganz weich.");

  AddDetail( ({"urwaldriesen","riesen"}), 
            "Die Urwaldriesen sind grosse Baeume hier im Dschungel.");

  AddDetail( ({"graesern","graeser","gras"}),
	    "Einzelne Graeser sind am Boden zwischen dem Laub zu erkennen. "
            "Sie sind jedoch nicht sehr interessant.");

  AddDetail( ({"grasgruen"}),
	    "Die Graeser am Boden sind grasgruen und auch manche Blaetter "
            "haben eine solche Farbe."); 
  
  AddDetail( ({"salamandergruen"}), 
            "Du wunderst Dich ein wenig, da das Salamandergruen sogar Augen "
            "hat.");

  AddDetail( ({"wald","typ"}),
	    "Der Wald ist sehr alt und die Baeume sind gross. Diesen Typ von "
            "Wald nennt man Dschungel oder Urwald.");

  AddDetail( ({"faerbung"}),
	    "Die Faerbung vom Laub ist ein wenig gelblich, da das Laub bereits "
            "am verrotten ist.");

  AddDetail( ({"baeumen","baeume"}), 
            "Die grossen Baeume im Dschungel sind alt und gross. Lauter dicke "
            "Schlingpflanzen haengen von ihren Aesten herunter.");

  AddDetail( ({"straeuchern","straeucher","rand"}),
	    "Am Rand des Pfades sind viele kleinere und groessere Straeucher "
            "zwischen den Baeumen. Leider tragen sie keine Beeren, die Du "
            "essen koenntest.");

  AddDetail( ({"farbe","hauptfarbe"}),
	    "Die Hauptfarbe hier im Dschungel ist komischerweise Gruen."); 
  
  AddDetail( ({"aesten","aeste"}), 
            "Die Aeste der Baeume sind auch riesig. Viele Schlingpflanzen "
            "haengen von ihnen herab.");

  AddDetail( ({"schlingpflanzen","weg"}),
	    "Die Schlingpflanzen, die von den Baeumen herunter haengen, "
            "stoeren Dich auf Deinem Weg durch den Dschungel. Sie haengen "
            "staendig im Weg und Du musst Dich durch sie durchkaempfen.");

  AddDetail( ({"blaetter","anzahl"}),
	    "Die Blaetter bewegen sich weiter oben an den Baeumen leicht im "
            "Wind. Hier unten sind sie bewegungslos.");

  AddDetail( ({"beeren"}), 
            "Die Beeren sehen giftig aus. Sie sind sicher nur fuer die Tiere "
            "und Voegel im Dschungel geniessbar.");

  AddDetail( ({"tiere"}),
	    "Momentan kannst Du keine Tiere im Dschungel sehen, aber Du bist "
            "sicher, dass es hier welche gibt.");

  AddDetail( ({"voegel"}),
	    "Die Voegel kannst Du auch nicht sehen, aber hoeren."); 
  
  AddDetail( ({"wind"}), 
            "Du kannst den Wind nur erahnen, da es hier unten am Boden "
            "windstill ist. Nur weiter oben bewegen sich die Blaetter leicht "
            "im Wind.");

  AddDetail( ({"blumen"}),
	    "Einige Blumen sind am Boden zu sehen. Du hast sie vorher gar "
            "nicht bemerkt.");

  AddDetail( ({"himmel"}),
	    "Der Himmel ist durch das dichte Blaetterdach nicht zu sehen.");

  AddDetail( ({"blaetterdach","dach"}),
	    "Die Blaetter weiter oben an den Baeumen bilden ein dichtes Dach, "
            "durch das der Himmel nicht zu sehen ist.");

  AddDetail( ({"vielfalt"}),
	    "Die Vielfalt an Pflanzen im Dschungel ist sehr gross.");

  AddSpecialDetail( ({ "augen"}),"detailaugen" );

  AddSmell(DEFAULT_SMELL, "Es riecht nach Blumen.");  
 
  AddSmell( ({"blumen"}),
	   "Die Blumen riechen suesslich.");

  AddSound(DEFAULT_SOUND, "Du hoerst die Voegel im Wald zwitschern und den "
                          "Wind wie er durch die Blaetter weht.");

  AddSound( ({"voegel","zwitschern","tschip"}),
	   "Tschip, Tschip, Tschip...");

  AddSound( ({"wind","blaetter"}),
	   "Er weht nur ganz leicht und laesst die Blaetter rascheln.");
  

//-----Details Ende-----
  
AddExit("nordosten", ROOM "tem2");
AddExit("sueden", ROOM "tem4");

AddCmd( ({"beruehr", "beruehre" }), "beruehren" );

}
string detailaugen()
{
  if (!present("CHIVASSALAMANDER",TO))
    return(BS("Vielleicht solltest Du versuchen die Augen zu beruehren, um "
              "heraus zu finden was es ist.\n"));
  return("Du musst Dich wohl getaeuscht haben, da ist doch nichts zu sehen.\n");
}
void reset()
{
  ::reset();
  salada=1;
  resetsala=present("CHIVASSALAMANDER",TO); 

  
}

int beruehren (string str)
{
  object salamander;
  notify_fail ("Was moechtest Du beruehren?\n");

  if(!str || str == "auge") return 0;
  
  if(!(str == "auge","augen" )) return 0;
  if (present("CHIVASSALAMANDER",TO) || !salada)

  {
    write(BS("Du kannst gerade nichts erkennen."));
    return -1;
  }
  write(BS("Du probierst die Augen zu beruehren und merkst, dass es sich "
           "um einen kleinen gruenen Salamander handelt.\n"));
  salada=0;
  salamander = clone_object (NPC "salamander.lpc" );
  salamander->move(TO,M_GO|M_NOCHECK,"krabbelt");
  return 1;
}


