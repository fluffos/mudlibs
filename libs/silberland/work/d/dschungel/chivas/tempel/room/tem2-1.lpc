// von Chivas
inherit "std/room";

#include "../def.h"

int anzahl;

void create()
	
{
  ::create();

  anzahl = 5;

  SetProp( P_INT_SHORT, "In einem Tempel");
  SetProp( P_INT_LONG,
        "Hier auf der zweiten Ebene ist eine ebenso grosse runde Kammer "
        "wie auf der Ebene darunter. An der Decke ist eine schwere rostige "
        "Kette befestigt, die durch ein Loch im Boden in die darunter "
        "liegende Ebene haengt. An den Waenden haengen wiederum Fackeln, die "
        "jedoch nicht in einem gruenlichen Licht erstrahlen, sondern in einer "
        "blaeulich kalten Farbe Licht spenden." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----

  AddDetail( ({"ebene"}), 
            "Du bist nun auf der zweiten Ebene des Tempels. Wenn Du die Kette "
            "runter kletterst, kommst Du wieder auf die erste Ebene.");

  AddDetail( ({"kammer"}),
	    "Die Kammer ist fast identisch wie die Kammer auf der ersten "
            "Ebene. Es gibt nur ein paar wenige Unterschiede.");

  AddDetail( ({"decke","himmel"}),
	    "An der Decke haengt an einem grossen Haken eine alte rostige "
            "Kette. Ansonsten ist die Decke kahl bis auf ein paar alte "
            "Spinnenweben.");

  AddDetail( ({"kette"}), 
            "Die alte rostige Kette haengt von der Decke durch das Loch im "
            "Boden in die darunter liegende Kammer. Man kann an ihr runter "
            "auf die erste Ebene klettern.");

  AddDetail( ({"loch"}),
	    "Durch das grosse Loch im Boden erkennst Du die darunter liegende "
            "Kammer.");

  AddDetail( ({"boden"}),
	    "Im staubigen Boden siehst Du ein paar Fussspuren und ein grosses "
            "Loch."); 
  
  AddDetail( ({"waenden","waende"}), 
            "An den Waenden haengen blaeulich kalt scheinende Fackeln in ihren "
            "Halterungen.");

  AddDetail( ({"fackeln"}),
	    "Die Fackeln scheinen in einem blaeulich kaltem Licht.");

  AddDetail( ({"licht"}),
	    "Das blaeuliche Licht erhellt die Kammer ein wenig. Es ist "
            "trotzdem noch sehr duester.");

  AddDetail( ({"farbe","flammen","flamme"}), 
            "Die Flammen der Fackeln brennen in einer blaeulichen Farbe.");

  AddDetail( ({"unterschiede","unterschied"}),
	    "Einer der Unterschiede ist, dass hier ein Loch im Boden ist und "
            "dass die Fackeln nicht gruen, sondern blaeulich schimmern.");

  AddDetail( ({"spinnenweben"}),
	    "Die alten Spinnenweben sind schon lange verlassen und sehr "
            "uninteressant."); 
  
  AddDetail( ({"haken"}), 
            "Der Haken haengt fest an der Decke. An ihm haengt eine grosse "
            "alte rostige Kette.");

  AddDetail( ({"fussspuren","spuren"}),
	    "Die Fussspuren im Staub stammen anscheinend von Dir selbst.");

  AddDetail( ({"staub"}),
	    "Ein wenig Staub liegt auf dem Boden. Ein paar Spuren kann man "
            "erkennen.");

  AddDetail( ({"halterungen"}), 
            "Die Halterungen haben ein paar kleine Verzierungen.");

  AddDetail( ({"verzierungen"}),
	    "Die Verzierungen stellen kleine Totenkoepfe dar.");

  AddDetail( ({"totenkoepfe","koepfe"}),
	    "Ein Totenkopf faellt Dir besonders auf."); 
  
  AddDetail( ({"totenkopf","kopf"}), 
            "Es scheint ein Knopf zu sein.");

  AddDetail( ({"knopf"}),
	    "Ob Du ihn druecken solltest? Es ist hier immer gefaehrlich, so "
            "etwas zu finden.");

  AddDetail( ({"tempel","tempels"}),
	    "Du stehst nun auf der dritten Ebene im Tempel.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht hier auf der zweiten Ebene nicht "
                          "sonderlich gut, aber Du kannst den Geruch nicht "
                          "weiter deuten.");  

  AddSmell( ({"geruch"}),
	   "Woher der Geruch kommt, kannst Du momentan noch nicht ausmachen.");

  AddSound(DEFAULT_SOUND, "Du hoerst einen Windzug.");

  AddSound( ({"windzug"}),
	   "husch");
  
//-----Details Ende-----
  
AddExit("sueden", ROOM "tem2-2");

AddCmd( ({"kletter", "klettere" }), "klettern" );
AddCmd( ({"drueck", "druecke" }), "druecken" );

}
void reset()
{
  ::reset();
  anzahl=5;
}
int klettern(string str)
{
   notify_fail("Woran moechtest Du wohin klettern?\n");
   if ( member( ({ "an kette", "an kette nach unten","an kette runter" }),str) != -1) 
  {
    write( "Du kletterst an der Kette nach unten.\n");
      TP->move(ROOM "tem1-1", M_GO, "durch ein Loch nach unten", 
      "verschwindet", "kommt die Kette heruntergeklettert");
    return 1;
  }
}
int druecken(string str)
{
   notify_fail("Was moechtest Du druecken?\n");
   if ( member( ({ "knopf" }),str) != -1) 
  { 
    write(BS( "Du drueckst den Knopf und eine magische Energie gibt Dir wieder "
              "Kraft."));
    say(BS( TPN+" wird von einer magischen Energie umgeben und sieht erfrischt "
                "aus."));
    if ( anzahl )
    {
      TP -> heal_self(50+random(20));
      anzahl--;
    }
    return 1;
  }
}

