// von Chivas
inherit "std/room";

#include "../def.h"

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Tempel");
  SetProp( P_INT_LONG,
        "Du befindest Dich in einer grossen Halle, wo in der Mitte des Raumes "
        "ein Podest steht. Auf dem Boden sind zentrische Kreise angeordnet, "
        "die sich in die Raummitte hin verkleinern. \n"
	"Als Du ueber die Linien der Kreise schreitest fuehlst Du geradezu die "
        "maechtige Magie, die in ihnen steckt. " );
SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----

  AddDetail( ({"halle","raum","raumes"}),
	    "Die Halle ist recht gross und genau in der Mitte faellt Dir "
            "sofort ein Podest auf.");

  AddDetail( ({"mitte","raummitte"}),
	    "In der Mitte steht ein Podest, auf dem eine riesige Statue "
            "steht.");

  AddDetail( ({"podest"}),
	    "Auf dem Podest steht eine riesige Statue aus Glas. Direkt am "
            "Podest ist eine kleine Plakette.");

  AddDetail( ({"boden"}),
	    "Auf den Steinplatten am Boden sind zentrische Kreise "
            "eingezeichnet, die in Richtung Podest kleiner werden."); 
  
  AddDetail( ({"kreise","kreisen"}), 
            "Die Kreise bestehen aus feinen Linien, die silbern schimmern und "
            "Magie ausstrahlen.");

  AddDetail( ({"linien","linie"}),
	    "Die feinen Linien pulsieren in einem silbernen Schimmer.");

  AddDetail( ({"magie"}),
	    "Die Magie der Kreise scheint maechtig zu sein.");

  AddDetail( ({"waende","waenden","wand"}), 
            "An den Waenden haengen Teppiche und Halterungen, in denen die "
            "gruenlich leuchtenden Fackeln stecken.");

  AddDetail( ({"decke","himmel"}),
	    "An der Decke sind die gleichen Kreise wie am Boden.");

  AddDetail( ({"statue"}),
	    "Die Statue stellt einen Dunkelelfen dar."); 
  
  AddDetail( ({"glas"}), 
            "Die ganze Statue besteht aus durchsichtigem Glas. Ein solches "
            "Meisterwerk hast Du in einem solchen Tempel nicht erwartet.");

  AddDetail( ({"plakette"}),
	    "Die Plakette besteht aus purem Gold. Es scheint so, als ob die "
            "Person, die auf dem Podest steht, eine wichtige Persoenlichkeit "
            "gewesen sein muss. Du kannst die Inschrift auf der Plakette "
            "lesen.");

  AddDetail( ({"persoenlichkeit","person"}),
	    "Sie war sehr wichtig.");

  AddDetail( ({"gold"}), 
            "Das Gold der Plakette ist sehr wertvoll. Vielleicht kann man die "
            "Plakette abreissen, ohne das Jemand es merkt.");

  AddDetail( ({"jemand"}),
	    "Falls es jemand merkt, kann dies natuerlich Folgen haben.");

  AddDetail( ({"folgen","vergangenheit","aktionen"}),
	    "Wie Du aus der Vergangenheit weisst, sind die Folgen solcher "
            "Aktionen sehr oft schlecht fuer Dich ausgegangen."); 
  
  AddDetail( ({"schimmer"}), 
            "Es schimmert silbern, aber was Dich mehr beeindruckt, ist das "
            "Pulsieren.");

  AddDetail( ({"pulsieren"}),
	    "Es ist ein bestimmter Takt.");

  AddDetail( ({"takt"}),
	    "Der Takt ist folgender: ... --- ... \n"
            " \n"
            "Der Takt kommt Dir bekannt vor.");

  AddDetail( ({"teppiche"}), 
            "Die Teppiche sind alt und haengen in Fetzen von der Wand. Sie "
            "haben ihre beste Zeit hinter sich. Die Muster und Zeichnungen "
            "sind kaum noch zu erkennen.");

  AddDetail( ({"fackeln"}),
	    "Die Fackeln strahlen ihr magisches gruenes Licht aus.");

  AddDetail( ({"halterungen"}),
	    "Die Halterungen sind alt und rostig. In ihnen stecken Fackeln, "
            "die anscheinend ewig brennen."); 
  
  AddDetail( ({"licht"}), 
            "Die Halle wird von dem gruenen Licht der Fackeln und von dem "
            "silbernen Pulsieren der Kreise erhellt.");

  AddDetail( ({"steinplatten","platten"}),
	    "Die Steinplatten sind eigentlich uninteressant, waeren die "
            "Kreise nicht da.");

  AddDetail( ({"meisterwerk"}),
	    "Es muss ein wahrer Meister gewesen sein, der die Statue "
            "hergestellt hat.");

  AddDetail( ({"tempel"}), 
            "Du bist schon weit in den Tempel vorgedrungen.");

  AddDetail( ({"dunkelelfen","dunkelelf","kaempfer"}),
	    "Der Dunkelelf muss ein wahrer Kaempfer fuer das Boese gewesen "
            "sein, dass ihm eine Statue gewidmet wurde. Jetzt siehst Du auch, "
            "dass es eigentlich eine Dunkelelfin ist.");

  AddDetail( ({"dunkelelfin","haenden","haende","schein"}),
	    "Sie hat einen harten Blick und das Glasschwert in ihren Haenden "
            "glaenzt im Schein der Fackeln. Sie sieht unbesiegbar aus.");

  AddDetail( ({"glasschwert","schwert"}), 
            "Du willst Dich nicht mit dem Schwert anlegen.");

  AddDetail( ({"blick"}),
	    "Es ist zwar nur eine Statue, trotzdem kannst Du den Blick nicht "
            "standhalten.");

  AddDetail( ({"boese"}),
	    "Das Boese ist hier im Tempel sehr verbreitet."); 

  AddDetail( ({"muster","zeichnungen"}),
	    "Du kannst nicht mehr viel auf den Mustern und Zeichnungen "
            "erkennen. Es sind aber schreckliche Dinge, die Du noch erkennen "
            "kannst."); 

  AddDetail( ({"dinge"}),
	    "Diese Dinge sind unaussprechlich."); 

  AddDetail( ({"meister"}),
	    "Der Meister ist nicht da."); 

  AddDetail( ({"inschrift"}),
	    "Du kannst sie lesen."); 

  AddDetail( ({"fetzen"}),
	    "Die Teppiche haengen fast nur noch in Fetzen an der Wand."); 

  AddDetail( ({"richtung","zeit"}),
	    "Du untersuchst wirklich alles."); 
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach den verfaulenden Teppichen an den "
                          "Waenden.");  
 
  AddSmell( ({"teppiche"}),
	   "Die Teppiche stinken fuerchterlich.");

  AddSound(DEFAULT_SOUND, "Du hoerst ein magisches Knistern.");

  AddSound( ({"knistern"}),
	   "Das Knistern kommt von den pulsierenden Kreisen.");
  
  AddReadDetail( ({"inschrift"}),
		"+------------------------------+\n"
                "|    Diese Statue ist den      |\n"
                "| gloreichen Drow gewidmet und |\n"
                "|     ihrer einzigartigen      |\n"
                "|        Anfuehrerin           |\n"
                "|        'Nathvyll'            |\n"
                "|  (Sie erschlug alleine 50    |\n"
                "| erbaermliche Dschungelelfen  |\n"
                "| beim 1. Kampf um den Tempel) |\n"
                "+------------------------------+\n");

//-----Details Ende-----
AddItem( "/d/gebirge/angrox/npc/ghoul", REFRESH_DESTRUCT,
        ([P_MNPC_DEFAULTROOM: "tem34",
          P_MNPC_AREA:({ROOM "tem33", ROOM "tem34", ROOM "tem35"}),
          P_MNPC_FLAGS: MOV_INDOORS + MOV_MAYLOAD + MOV_MOVES
        ]) );
//AddItem( "/d/kristallwald/chivas/zentauren/npc/geist", REFRESH_DESTRUCT,
AddItem(NPC "tempelgeist", REFRESH_DESTRUCT,
        ([P_MNPC_DEFAULTROOM: "tem34",
          P_MNPC_AREA:({ROOM "tem33", ROOM "tem34", ROOM "tem35"}),
          P_MNPC_FLAGS: MOV_INDOORS + MOV_MAYLOAD + MOV_MOVES
        ]) );
 
AddExit("norden", ROOM "tem31");
AddExit("nordosten", ROOM "tem31");
AddExit("nordwesten", ROOM "tem31");
AddExit("osten", ROOM "tem35");
AddExit("westen", ROOM "tem31");
AddExit("suedosten", ROOM "tem33");
AddExit("suedwesten", ROOM "tem31");
AddExit("sueden", ROOM "tem31");


AddCmd( ({"reiss", "reisse" }), "reissen" );

}
int reissen(string str)
{
   notify_fail("Was moechtest Du abreissen?\n");
   if ( member( ({ "plakette ab", "gold ab" }),str) != -1) 
  {
    write(BS("\nDu probierst mit aller Kraft, die Plakette abzureissen, als "
           "sich ploetzlich die Statue bewegt und mit dem grossen Schwert nach "
           "Dir haut. Sie trifft Dich mit aller Kraft.\n"));
    say( TPN+" kriegt von der Statue einen sehr harten Schlag bei dem Versuch, "
             "eine Plakette zu stehlen.\n");
    TP->AddHp(-50);
    TP->SetProp(P_PARALYZED, ([
           PARALYZE_TIME: 16,
           PARALYZE_MSG: "Du bist gerade ohnmaechtig und kannst nichts tun.\n",
           PARALYZE_END: "Als Du zu Dir kommst, siehst Du noch, wie die "
                         "Statue in ihre urspruengliche Position "
                         "zurueckkehrt.\n"
                              ]) );	
      call_out("fall1",4);
    return 1;
  }
 }
void fall1()
{
  write(BS( "Du fliegst von dem Schlag durch die halbe Halle und als Du "
            "aufschlaegst schwinden Dir die Sinne. Dein Kopf droehnt und "
            "Dir wird schwarz vor Augen.\n"));
}  

