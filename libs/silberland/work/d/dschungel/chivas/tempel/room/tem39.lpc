// von Chivas
inherit "std/room";

#include "../def.h"

void create()
	
{
  ::create();


  SetProp( P_INT_SHORT, "In einem Tempel");
  SetProp( P_INT_LONG,
        "Der Gestank nimmt zwar ein wenig ab, aber nicht die Abscheulichkeit, "
        "die der Tempel einem im Inneren bietet. Neben den magisch brennenden "
	"Fackeln haengen einige Folterinstrumente, wo man auch Personen "
        "wunderschoen festketten kann, um sich dann naeher mit ihnen zu "
        "beschaeftigen." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  
  AddDetail( ({"gestank"}), 
            "Es stinkt nicht so sehr wie im Suedwesten, aber angenehm ist "
            "es trotzdem nicht.");

  AddDetail( ({"suedwesten"}),
	    "Im Suedwesten ist der Raum mit den viele Wuermern und anderen "
            "Viechern.");

  AddDetail( ({"raum","wuermern","viechern","viecher","wuermer"}),
	    "Da willst Du nicht mehr hin.");

  AddDetail( ({"abscheulichkeit","abscheulichkeiten"}), 
            "Es gibt sehr viele Abscheulichkeiten hier im Tempel.");

  AddDetail( ({"tempel","tempels"}),
	    "Der Tempel ist sehr gross und unheimlich.");

  AddDetail( ({"inneren","inneres","innere"}),
	    "Es gibt schoenere Plaetze im Silberland als hier im Inneren des "
            "Tempels."); 
  
  AddDetail( ({"fackeln"}), 
            "Die Fackeln haengen in ihren Halterungen und erhellen die Kammer "
            "ein wenig. Ihr gruenes Licht scheint magisch zu sein.");

  AddDetail( ({"folterinstrumente","instrumente"}),
	    "Es haengen verschiedene Folterinstrumente an der Wand. Du "
            "erkennst Zangen und Ketten und auch eine Eiserne Jungfrau, die in "
            "einer Ecke steht.");

  AddDetail( ({"personen","stunden"}),
	    "Die Personen, die hier festgekettet wurden, haben sicher keine "
            "netten Stunden hier verbracht. An einer Wand ist immer noch "
            "ein Skelett festgekettet.");

  AddDetail( ({"plaetze","insel","mauritius"}), 
            "Die Insel Mauritius ist recht schoen.");

  AddDetail( ({"silberland"}),
	    "Du befindest Dich im Silberland und fuehlst Dich normalerweise "
            "sehr wohl hier.");

  AddDetail( ({"licht"}),
	    "Ohne die Fackeln waere es stockdunkel im Tempel."); 
  
  AddDetail( ({"wand","waende","waenden"}), 
            "An den Waenden haengen die Fackeln und einige nette "
            "Folterinstrumente.");

  AddDetail( ({"ketten","zeiten","kette"}),
	    "Die Ketten sehen zwar rostig aus, man kann sie aber sicher immer "
            "noch gut benutzen, um Personen fuer alle Zeiten hier "
            "festzuhalten.");

  AddDetail( ({"zangen","zange"}),
	    "Wozu genau die Zangen benutzt wurden, moechtest Du gar nicht "
            "so genau wissen. Du kannst Dir aber vorstellen, dass es nicht "
            "viel Spass gemacht hat.");

  AddDetail( ({"ecke"}), 
            "In einer Ecke steht eine Eiserne Jungfrau.");

  AddDetail( ({"eiserne jungfrau","jungfrau","eiserne"}),
	    "Die Eiserne Jungfrau ist ein wenig geoeffnet und Du kannst sie "
            "Dir genau anschauen. Sie ist ungefaehr so gross wie Du und ihre "
            "spitzen Nadeln sehen immer noch todbringend aus.");

  AddDetail( ({"halterungen"}),
	    "Die Halterungen haengen an den Waenden und die Fackeln in ihnen "
            "erhellen die Kammer."); 
  
  AddDetail( ({"skelett","abenteurer","jahre"}), 
            "Das Skelett haengt sicher schon einige Jahre hier. Anscheinend "
            "wurde der arme Abenteurer einfach vergessen.");

  AddDetail( ({"spass"}),
	    "Spass hat man sicher recht selten in einer solchen Umgebung.");

  AddDetail( ({"kammer","umgebung"}),
	    "In dieser Kammer wurden sicher Personen gefoltert, die nicht "
            "mit den Einwohnern vom Tempel kooperiert haben.");

  AddDetail( ({"einwohnern","einwohner"}), 
            "Ein paar der Einwohner hast Du ja schon kennen gelernt.");

  AddDetail( ({"nadeln","nadel"}),
	    "An den Nadeln scheint auch noch ein wenig Blut des letzten "
            "Opfers zu kleben.");

  AddDetail( ({"blut"}),
	    "Das Blut ist schwarz und getrocknet."); 
  
  AddDetail( ({"opfers","opfer","opfern"}), 
            "Du moechtest hier nicht einen solchen Tod sterben.");

  AddDetail( ({"tod"}),
	    "Tod fragt: HAST DU MICH GERUFEN?");

  AddDetail( ({"spinnweben"}),
	    "Die Spinnweben sind schon sehr alt.");

  AddDetail( ({"spuren"}),
	    "Es sind Deine eigenen Spuren.");

  AddDetail( ({"waffen"}),
	    "Die Waffen sind alt und verrostet. Du laesst sie liegen.");

  AddDetail( ({"decke","himmel"}),
	    "An der Decke sind nur einige Spinnweben zu sehen. Ansonsten ist "
            "die Decke schmucklos.");

  AddDetail( ({"stoffreste","reste"}), 
            "Die Stoffreste sind wohl von den Opfern dieser Kammer.");

  AddDetail( ({"boden"}),
	    "Der Boden ist mit Staub bedeckt. Ausserdem siehst Du einige "
            "Stoffreste und einige Waffen am Boden liegen.");

  AddDetail( ({"staub","staubschicht","schicht"}),
	    "Die Staubschicht ist schon recht dick. Du erkennst einige Spuren."); 
  
  AddSmell(DEFAULT_SMELL, "Du riechst den Gestank aus dem Suedwesten.");  
 
  AddSmell( ({"gestank","geruch"}),
	   "Der Gestank hat zwar ein wenig abgenommen, jedoch ist der Geruch "
           "immer noch recht beissend.");

  AddSound(DEFAULT_SOUND, "Du hoerst die Ketten ein wenig klirren.");

  AddSound( ({"ketten"}),
	   "Die Ketten stossen gegeneinander und klirren ein wenig.");
  
//-----Details Ende-----
  
AddExit("norden", ROOM "tem35");
AddExit("nordosten", ROOM "tem35");
AddExit("nordwesten", ROOM "tem35");
AddExit("osten", ROOM "tem35");
AddExit("westen", ROOM "tem40");
AddExit("suedosten", ROOM "tem35");
AddExit("suedwesten", ROOM "tem38");
AddExit("sueden", ROOM "tem35");

}

