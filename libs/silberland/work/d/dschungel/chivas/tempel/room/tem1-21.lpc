// von Chivas
inherit "std/room";

#include "../def.h"

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einem Tempel im Dschungel");
  SetProp( P_INT_LONG,
        "Die Steinquader, die die Decke des Erdgeschosses bilden auf der Du "
        "stehst, sind kaum noch zu erkennen. Alle moeglichen Gewaechse sind "
        "am Tempel hochgewachsen und haben hier Wurzeln geschlagen. Die "
        "Aussenmauer der ersten Ebene ist an dieser Stelle kaum bewachsen." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 30, ENV_TERRAIN: TT_JUNGLE]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----

  AddDetail( ({"steinquader","quader"}), 
            "Die Quader sind mit allerlei Pflanzen bewachsen und kaum noch "
            "zu erkennen.");

  AddDetail( ({"decke","erdgeschosses","erdgeschoss"}),
	    "Die Decke des Erdgeschosses ist der Boden auf dem Du stehst.");

  AddDetail( ({"gewaechse","wurzeln","pflanzen"}),
	    "Es sind einige Graeser, Moose, Ranken und Schlingpflanzen die "
            "sich hier niedergelassen haben.");

  AddDetail( ({"aussenmauer","mauer","aussenmauern"}), 
            "An der Mauer sind nur ein paar Ranken zwischen den Fenstern zu "
            "sehen.");

  AddDetail( ({"ebene"}),
	    "Du bist auf der ersten Ebene ausserhalb des Tempels.");

  AddDetail( ({"stelle","stellen"}),
	    "Die Aussenmauern sind an dieser Stelle kaum bewachsen."); 
  
  AddDetail( ({"boden"}), 
            "Am Boden sind allerlei Pflanzen zu sehen.");

  AddDetail( ({"himmel"}),
	    "Der Himmel ist herrlich blau.");

  AddDetail( ({"graeser","knie"}),
	    "Die Graeser sind schon recht gross gewachsen. Sie gehen Dir bis "
            "zum Knie.");

  AddDetail( ({"moose","moos"}), 
            "Das Moos, auf dem Du gehst ist, angenehm weich. Man kann sehr gut "
            "auf ihm gehen.");

  AddDetail( ({"ranken"}),
	    "Einige Ranken haengen an der Aussenmauer, die jedoch nicht so "
            "stark bewachsen ist wie an anderen Stellen.");

  AddDetail( ({"schlingpflanzen"}),
	    "Am Boden sind einige Schlingpflanzen, ueber die man schnell "
            "stolpern kann."); 
  
  AddDetail( ({"fenstern","fenster"}), 
            "Die Fenster sind mit dem ueblichen magischen Schimmer "
            "ueberzogen.");

  AddDetail( ({"tempel","tempels"}),
	    "Du bist auf einem Tempel im Dschungel.");

  AddDetail( ({"schimmer"}),
	    "Der magische Schimmer hindert Dich daran in das Innere des "
            "Tempels zu schauen.");

  AddDetail( ({"dschungel"}), 
            "Der Dschungel ist rings um den Tempel herum sehr dicht.");

  AddDetail( ({"innere"}),
	    "Du weisst nicht, ob Du das Innere ueberhaupt sehen willst.");

  AddSmell(DEFAULT_SMELL, "Es riecht nach Dschungel.");  
 
  AddSmell( ({"dschungel"}),
	   "Es riecht dschungelig.");

  AddSound(DEFAULT_SOUND, "Du hoerst ein paar unbekannte Tiere im Dschungel.");

  AddSound( ({"tiere"}),
	   "Du weisst nicht, was es fuer Tiere sind.");
  
//-----Details Ende-----
  
AddExit("sueden", ROOM "tem1-20");
AddExit("norden", ROOM "tem1-22");

}

