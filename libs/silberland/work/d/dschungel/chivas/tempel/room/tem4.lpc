// von Chivas
inherit "std/room";

#include "../def.h"

void create()
	
{
  ::create();


  SetProp( P_INT_SHORT, "Auf einem Dschungelpfad");
  SetProp( P_INT_LONG,
        "Der Dschungel ist an dieser Stelle durch eine Bresche unterbrochen. "
        "Es sieht fast so aus, als ob eine Herde Elefanten den Pfad gekreuzt "
        "hat, da links und rechts des Pfades die Pflanzen niedergetrampelt und "
        "die Baeume ausgerissen sind. Sei froh, dass Du nicht hier warst als "
        "die Herde hier durchgerast ist. " );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 30, ENV_TERRAIN: TT_JUNGLE]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  
  AddDetail( ({"dschungel","wald"}), 
            "Du stehst schon recht tief im Dschungel. Ueberall sind "
            "Pflanzen um Dich herum, bis auf die Stelle, wo die Bresche ist.");

  AddDetail( ({"bresche"}),
	    "Eine grosse Bresche wurde durch den Wald geschlagen. Es sieht so "
            "aus, als ob eine Herde Elefanten den Pfad gekreuzt hat und dabei "
            "alles niedergetrampelt hat, was im Weg gestanden hat.");

  AddDetail( ({"stelle"}),
	    "An der Stelle ist ein riesengrosse Bresche. Du bist froh, dass "
            "Du nicht hier warst, als sie entstanden ist.");

  AddDetail( ({"herde"}), 
            "Es scheint eine Herde Elefanten gewesen zu sein, da Du einige "
            "Abdruecke am Boden siehst.");

  AddDetail( ({"elefanten","elefant"}),
	    "Es sind keine Elefanten mehr da. Sie sind wohl weiter gezogen.");

  AddDetail( ({"weg"}),
	    "Alles was den Elefanten im Weg stand, ist kurz und klein gehauen "
            "oder niedergetrampelt worden."); 
  
  AddDetail( ({"pfad","pfades"}), 
            "Der Pfad fuehrt von Norden nach Sueden.");

  AddDetail( ({"pflanzen"}),
	    "Die meisten Pflanzen sind niedergedrueckt oder nicht mehr "
            "vorhanden, da wo die Herde durchgetrampelt ist. Nur neben der "
            "Bresche stehen wieder ein paar Straeucher und Farne.");

  AddDetail( ({"baeume"}),
	    "Die Baeume sind hier ein wenig lichter, da die Elefanten einige "
            "niedergerissen haben. Da das Blaetterdach nicht mehr so dicht "
            "ist, kann man sehr gut den Himmel sehen.");

  AddDetail( ({"boden"}), 
            "Am Boden sieht man viele niedergetrampelte Pflanzen. Aeste und "
            "Zweige liegen neben umgestuerzten Baeumen. Es herrscht absolutes "
            "Chaos wo die Elefanten durchgekommen sind. Man erkennt es an den "
            "grossen Abdruecken, die von Osten nach Westen fuehren.");

  AddDetail( ({"aeste","zweige"}),
	    "Lauter Aeste und Zweige liegen am Boden, die von den Baeumen "
            "abgerissen wurden, als sich die Elefanten ihren Weg bahnten.");

  AddDetail( ({"himmel"}),
	    "Du kannst den Himmel gut erkennen. Die Sonne steht fast senkrecht "
            "am Himmel und einige Wolken sind zu erkennen."); 
  
  AddDetail( ({"sonne"}), 
            "Die Sonne brennt vom Himmel herunter.");

  AddDetail( ({"wolken"}),
	    "Einige weisse Wolken sind zu sehen, aber es sieht nicht so aus, "
            "als ob es regnen wuerde.");

  AddDetail( ({"farne","farn"}),
	    "Einige grosse Farne stehen am Rand des Pfades, der den Elefanten "
            "nicht zum Opfer gefallen ist.");

  AddDetail( ({"abdruecke","abdruecken"}), 
            "Die Abdruecke sind die einer Herde von Elefanten.");

  AddDetail( ({"blaetterdach","dach"}),
	    "Das Blaetterdach ist nicht so dicht, da einige Baeume fehlen.");

  AddDetail( ({"norden","sueden"}),
	    "In die Richtungen kannst Du weitergehen."); 
  
  AddDetail( ({"osten","westen","reise"}), 
            "Die Elefanten kamen aus dem Osten auf ihrer Reise nach Westen. "
            "Du hast aber keine Lust ihnen zu folgen.");

  AddDetail( ({"richtung","richtungen"}),
	    "Die Richtung ist durch den Pfad vorgegeben.");

  AddDetail( ({"lust"}),
	    "Du hast Lust auf Forschen.");

  AddDetail( ({"forschen"}), 
            "Forschen ist super!!!");

  AddDetail( ({"rand"}),
	    "Am Rand des Pfades stehen ein paar Farne.");

  AddDetail( ({"opfer"}),
	    "Du bist der Herde nicht zum Opfer gefallen."); 
  
  AddDetail( ({"haufen"}), 
            "Der Haufen ist einfach ekelig. Du wendest Dich angewidert ab.");

  AddDetail( ({"straeucher"}),
	    "Ein paar Straeucher sind den Elefanten entkommen und stehen am "
            "Rand des Pfades.");

  AddDetail( ({"chaos"}),
	    "Ein richtiges Chaos, wie bei Dir daheim.");

  AddDetail( ({""}), 
            "");

  AddDetail( ({""}),
	    "");

  AddDetail( ({""}),
	    ""); 
  
  AddSmell(DEFAULT_SMELL, "Es riecht Etwas komisch hier.");  
 
  AddSmell( ({"etwas"}),
	   "Der komische Geruch kommt vom Rand der Bresche.");

  AddSmell( ({"geruch","rand","bresche"}),
	   "Es ist eigentlich eher ein Gestank.");

  AddSmell( ({"gestank"}),
	   "Der Gestank kommt von einem Haufen, den wohl ein Elefant "
           "hinterlassen hat.");

  AddSmell( ({"haufen"}),
	   "Du bist ekelig, dass Du daran schnupperst.");

  AddSound(DEFAULT_SOUND, "Du hoerst in der Ferne noch die Elefanten durch "
                          "den Dschungel wueten.");

  AddSound( ({"ferne","elefanten"}),
	   "Du hoerst die Elefanten troeten.");
  
//-----Details Ende-----
  
AddExit("norden", ROOM "tem3");
AddExit("sueden", ROOM "tem5");

}

