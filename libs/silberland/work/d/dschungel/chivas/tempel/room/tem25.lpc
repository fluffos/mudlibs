// von Chivas
inherit "std/room";

#include "../def.h"

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "An einem Tempel im Dschungel");
  SetProp( P_INT_LONG,
        "Du bist sehr froh, dass der Pfad um den Tempel ein wenig breiter ist "
        "und Du Dich nicht an der Tempelmauer entlang druecken must. Die "
	"verblassten Malereien und eingemeisselten Verzierungen strahlen eine "
        "boesartige Aura aus." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 30, ENV_TERRAIN: TT_JUNGLE]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----

  AddDetail( ({"pfad","pfades"}), 
            "Der Pfad ist angenehm breit und Du kommst gut voran.");

  AddDetail( ({"tempel","tempels"}),
	    "Der Tempel ragt neben Dir in den Himmel. Er ist riesig und "
            "strahlt eine boesartige Aura aus.");

  AddDetail( ({"tempelmauer","mauer","mauern"}),
	    "An der Mauer sind lauter Malereien und Verzierungen zu sehen, "
            "obwohl sie in Richtung Sueden von immer mehr Ranken und "
            "Schlingpflanzen verdeckt werden.");

  AddDetail( ({"malereien"}), 
            "Die Malereien stellen verschiedene Szenen dar.");

  AddDetail( ({"verzierungen"}),
	    "Es sind ein paar Schnoerkel, Kreise und Linien zu sehen.");

  AddDetail( ({"himmel","tag"}),
	    "Der Himmel ist schoen blau. Eigentlich ist ein wunderschoener "
            "Tag."); 
  
  AddDetail( ({"boden"}), 
            "Der Boden ist mit verschiedenen kleinen Pflanzen bewachsen. Auch "
            "ein paar Steine sind zu sehen.");

  AddDetail( ({"richtung","sueden"}),
	    "Da kannst Du auch hingehen.");

  AddDetail( ({"schlingpflanzen"}),
	    "Die Schlingpflanzen nehmen nach Sueden hin immer mehr zu.");

  AddDetail( ({"ranken"}), 
            "Die Ranken werden nach Sueden hin immer mehr. Sie haben "
            "schwarze, ekelig riechende Blueten.");

  AddDetail( ({"aura"}),
	    "Das ist nur so ein Gefuehl von Dir, aber Dein Gefuehl hat Dich "
            "nur recht selten betrogen.");

  AddDetail( ({"gefuehl"}),
	    "Manchmal ist es sehr gut, wenn man sich auf sein Gefuehl "
            "verlaesst."); 
  
  AddDetail( ({"blueten"}), 
            "Solche Blueten wuerdest Du Dir nie in Dein Seherhaus stellen.");

  AddDetail( ({"seherhaus"}),
	    "Falls Du noch keins hast, dann beeil Dich mal.");

  AddDetail( ({"schnoerkel","kreise","linien"}),
	    "Du kannst keinen Sinn dahinter erkennen.");

  AddDetail( ({"sinn","dinge"}), 
            "Viele Dinge ergeben keinen Sinn.");

  AddDetail( ({"steine"}),
	    "Die Steine sind ein wenig eckig, aber ansonsten sehr sehr "
            "uninteressant.");

  AddDetail( ({"pflanzen"}),
	    "Die Pflanzen am Boden sind hauptsaechlich Graeser und ganz junge "
            "Baeume."); 
  
  AddDetail( ({"dschungel","moeglichkeit","dschungels","dickicht"}), 
            "Der Dschungel, der gleich neben dem Pfad anfaengt, ist sehr dicht. "
            "Es gibt keine Moeglichkeit, den Pfad hier zu verlassen.");

  AddDetail( ({"szenen","bau","elfenkinder","frieden"}),
	    "Auf den Szenen ist anscheinend das Leben vor dem Bau des Tempels "
            "dargestellt. Es zeigt froehliche Elfenkinder, die im Dschungel "
            "spielen und ansonsten herrscht ueberall Frieden. Das letzte Bild "
            "sieht dagegen etwas anders aus.");

  AddDetail( ({"graeser","graesern"}),
	    "Zwischen den Graesern wachsen auch einige kleine Blumen.");

  AddDetail( ({"baeume"}), 
            "Die Baeume auf dem Pfad sind noch sehr klein im Vergleich mit "
            "den Riesen am Rand des Pfades wo der Dschungel anfaengt.");

  AddDetail( ({"riesen","vergleich","rand"}),
	    "Die Baeume am Rand des Pfades sind schon ausgewachsen und ragen "
            "in den blauen Himmel.");

  AddDetail( ({"blumen"}),
	    "Die Blumen sind sehr huebsch und viel zu schade zum pfluecken, "
            "oder doch nicht?"); 
  
  AddDetail( ({"leben","sorgen"}), 
            "Das Leben war friedlich und schoen. Es gab keine Sorgen und alle "
            "waren gluecklich.");

  AddDetail( ({"bild","arbeit"}),
	    "Das letzte Bild der Szenen zeigt den Tempel im Bau. Die "
            "froehlichen Elfen sind verschwunden und sie schleppen grosse "
            "Steinquader. Sie sind versklavt und werden von Kreaturen der "
            "Hoelle bei der Arbeit angetrieben. So schnell kann sich was "
            "aendern.");

  AddDetail( ({"elfen"}),
	    "Die Elfen auf dem Bild sehen ausgehungert und gequaelt aus.");

  AddDetail( ({"kreaturen"}), 
            "Ob solche Kreaturen noch immer im Tempel hausen?");

  AddDetail( ({"hoelle"}),
	    "Im Tempel kommt man der Hoelle sicher recht nahe. Vielleicht "
            "solltest Du ihn nie betreten.");

  AddDetail( ({"steinquader","quader"}),
	    "Die Quader sind riesig. Sie bilden die Mauern des Tempels."); 
  
  AddSmell(DEFAULT_SMELL, "Die Blueten der Ranken duften ekelig.");  
 
  AddSmell( ({"blueten","ranken"}),
	   "Die Blueten stinken fuerchterlich.");

  AddSound(DEFAULT_SOUND, "Du hoerst die ueblichen Geraeusche des Dschungels.");

  AddSound( ({"dschungel","geraeusche"}),
	   "Du hoerst ab und zu ein Knacksen der Aeste im Dschungel.");
  
  AddSound( ({"knacksen","aeste"}),
		"Du kannst in dem Dickicht des Dschungels nicht ausmachen "
                "woher das Knacksen kommt. Vielleicht ist es auch besser wenn "
                "Du es nicht weisst.");

//-----Details Ende-----
  
AddExit("sueden", ROOM "tem24");
AddExit("norden", ROOM "tem26");

AddCmd( ({"pflueck", "pfluecke","pfluecken" }), "pfluecken" );

}
int pfluecken(string str)
{
   notify_fail("Was moechtest Du pfluecken?\n");
   if ( member( ({ "blume","blumen" }),str) != -1) 
  {
    write(BS( "Du probierst eine der Blumen am Boden zu pfluecken, als ein "
           "kleiner Maulwurf aus der Erde erscheint, Dir mit seinen "
           "kleinen Zaehnchen in den Finger zwickt und darauf sofort "
           "wieder verschwindet. Du solltest es wohl lieber lassen.\n"));
    say( TPN+" verzieht das Gesicht und schreit: AUA!\n");
    return 1;
  }
}

