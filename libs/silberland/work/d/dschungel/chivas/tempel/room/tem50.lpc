// von Chivas
inherit "std/room";

#include "../def.h"

void create()
	
{
  ::create();


  SetProp( P_INT_SHORT, "In einem Tempel");
  SetProp( P_INT_LONG,
        "Die Kammer sieht so aus, als ob hier erst vor kurzem ein Kampf "
        "stattgefunden hat. An den Waenden sind Brocken aus den Quadern "
	"gebrochen und ueberall liegen kleine Haeufchen von Asche herum. "
        "Du schluckst und bist froh, dass Du nicht hier warst. " );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  
  AddDetail( ({"kammer"}), 
            "In der Kammer herrscht ein grosses Durcheinander. Ueberall "
            "liegen Steinbrocken der Mauer und andere Sachen rum.");

  AddDetail( ({"kampf"}),
	    "Der Kampf muss wild gewesen sein. Es gab sicher viele Opfer.");

  AddDetail( ({"waende","wand","waenden","mauer"}),
	    "An den Waenden sind einige grosse Brocken rausgesprengt worden.");

  AddDetail( ({"brocken","steinbrocken"}), 
            "Lauter grosse und kleinere Brocken liegen am Boden verstreut.");

  AddDetail( ({"quader","quadern"}),
	    "Die Quader der Mauer haben einige Luecken und viele Brandspuren.");

  AddDetail( ({"haeufchen","asche"}),
	    "Am Boden liegen viele Haeufchen mit Asche. Anscheinend wurden "
            "mindestens zehn Personen zu Asche verbrannt."); 
  
  AddDetail( ({"schwerter","schwert"}), 
            "Die Schwerter sind abgebrochen und nicht mehr zu gebrauchen.");

  AddDetail( ({"boden"}),
	    "Der Boden ist mit lauter Brocken der Mauer und anderen Sachen "
            "uebersaeht.");

  AddDetail( ({"decke","himmel"}),
	    "An der Decke haengt ein kleiner Kaefig.");

  AddDetail( ({"sachen"}), 
            "Ein paar zerstoerte Schilde, abgebrochene Schwerter und einige "
            "Haeufchen Asche.");

  AddDetail( ({"kaefig"}),
	    "In dem Kaefig sind ein paar Irrlichter gefangen.");

  AddDetail( ({"irrlichter"}),
	    "Die Irrlichter spenden ein wenig Licht, so dass Du das Chaos "
            "in der Kammer sehen kannst."); 
  
  AddDetail( ({"licht"}), 
            "Es ist nicht viel Licht, aber es reicht um die vielen Ausgaenge "
            "zu sehen.");

  AddDetail( ({"ausgaenge"}),
	    "Du bist es gewoehnt, so viele Ausgaenge zu haben. Du willst es "
            "gar nicht mehr anders.");

  AddDetail( ({"opfer"}),
	    "Wenn man die Anzahl der Haeufchen am Boden sieht, so muessen "
            "es mindestens zehn Opfer gewesen sein.");

  AddDetail( ({"personen"}), 
            "Du bist froh, dass Du es nicht bist.");

  AddDetail( ({"luecken"}),
	    "Die Luecken stammen von den Brocken, die aus der Mauer gesprengt "
            "wurden.");

  AddDetail( ({"anzahl"}),
	    "Es koennten auch einen paar mehr als zehn sein."); 
  
  AddDetail( ({"chaos","durcheinander"}), 
            "Das Durcheinander in der Kammer kann man nur als Chaos "
            "bezeichnen.");

  AddDetail( ({"schilde"}),
	    "Die Schilde sind komplett zerstoert.");

  AddDetail( ({"brandspuren","spuren"}),
	    "Die Brandspuren stammen sicher von Feuerbaellen, die ihr Ziel "
            "verfehlt haben.");

  AddDetail( ({"feuerbaellen","feuerbaelle","feuerball","ball"}), 
            "Du moechtest nicht von einem getroffen werden.");

  AddDetail( ({"ziel"}),
	    "Das Ziel wurde aber auch oft genug getroffen, wie man an den "
            "Haeufchen sehen kann.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht ein wenig nach Rauch.");  
 
  AddSmell( ({"rauch"}),
	   "Der Kampf scheint noch nicht lange her zu sein.");

  AddSound(DEFAULT_SOUND, "Es ist sehr still, wie es immer nach einem Kampf "
                          "ist.");

//-----Details Ende-----
AddItem( "/d/dschungel/dante/hoehle/npc/dskor2", REFRESH_DESTRUCT,
        ([P_MNPC_DEFAULTROOM: "tem50",
          P_MNPC_AREA:({ROOM "tem50"}),
          P_MNPC_FLAGS: MOV_INDOORS + MOV_MAYLOAD + MOV_MOVES
        ]) );
  
AddExit("norden", ROOM "tem49");
AddExit("nordosten", ROOM "tem47");
AddExit("nordwesten", ROOM "tem47");
AddExit("osten", ROOM "tem51");
AddExit("westen", ROOM "tem47");
AddExit("suedosten", ROOM "tem47");
AddExit("suedwesten", ROOM "tem47");
AddExit("sueden", ROOM "tem47");

}

