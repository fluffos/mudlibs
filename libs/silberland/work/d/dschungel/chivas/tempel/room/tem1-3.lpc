// von Chivas
inherit "std/room";

#include "../def.h"

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Tempel");
  SetProp( P_INT_LONG,
        "Der Gang geht weiter und auf dem Boden erkennst Du einige Knochen "
        "und Gegenstaende. Die Waende sind erneut mit alten Wandteppichen "
        "behangen und an der Decke haengt ein alter Kronleuchter, der schon "
        "sehr lange nicht mehr angezuendet wurde." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----

  AddDetail( ({"gang"}), 
            "Der Gang ist schmutzig und auf dem Boden liegt allerhand herum.");

  AddDetail( ({"boden"}),
	    "Auf dem Boden liegen ein paar alte Knochen und verschiedene "
            "Gegenstaende.");

  AddDetail( ({"knochen","knochenbesitzer","knochenbesitzers"}),
	    "Die Knochen sehen abgenagt aus und stammen anscheinend von einem "
            "Abenteurer, wie Du einer bist.");

  AddDetail( ({"gegenstaende"}), 
            "Die Gegenstaende gehoeren wohl zur Ausruestung des "
            "Knochenbesitzers.");

  AddDetail( ({"waende","waenden"}),
	    "An den Waenden haengen alte Wandteppiche, wie Du sie schon "
            "oefters im Tempel gesehen hast.");

  AddDetail( ({"wandteppichen","wandteppiche","teppiche"}),
	    "Die Teppiche sind ausgefranst und ein paar verbleichte Muster "
            "sind zu erkennen."); 
  
  AddDetail( ({"decke","himmel"}), 
            "An der Decke haengt ein grosser alter Kronleuchter, der aber "
            "noch intakt zu sein scheint.");

  AddDetail( ({"kronleuchter","leuchter"}),
	    "Der Kronleuchter ist mit Spinnenweben bedeckt. Auch einige alte "
            "Kerzen kannst Du noch erkennen.");

  AddDetail( ({"abenteurer","besitzer"}),
	    "Naja, fast so einer wie Du. Dem Besitzer der Knochen scheint es "
            "gesundheitlich weitaus schlechter als Dir zu gehen.");

  AddDetail( ({"muster"}), 
            "Die Muster zeigen das uebliche Greuel, was hier im Tempel "
            "stattgefunden hat.");

  AddDetail( ({"ausruestung"}),
	    "Die Ausruestung scheint ein Panzer und anderes Kettenzeug "
            "gewesen zu sein.");

  AddDetail( ({"kerzen"}),
	    "Die Kerzen brennen schon lange nicht mehr und sind schon sehr "
            "heruntergebrannt."); 
  
  AddDetail( ({"spinnweben","spinnenweben"}), 
            "Die Spinnweben sind alt und scheinen verlassen zu sein. Auch "
            "wenn sie noch bewohnt waeren, haettest Du nicht viel Angst, da "
            "es nur kleine Spinnen gewesen sein koennen.");

  AddDetail( ({"greul","foltern","metzeln"}),
	    "Das uebliche Foltern und Metzeln.");

  AddDetail( ({"tempel"}),
	    "Du bist auf der ersten Ebene im Tempel.");

  AddDetail( ({"ebene","ebenen"}), 
            "Es liegen noch ein paar Ebenen ueber Dir.");

  AddDetail( ({"panzer","kettenzeug"}),
	    "Alles ist total verrostet und dadurch fuer Dich sehr "
            "uninteressant.");

  AddDetail( ({"angst"}),
	    "So etwas kennst Du nicht."); 
  
  AddDetail( ({"spinnen"}), 
            "Du hast schon Spinnen gesehen, vor denen man sich fuerchten "
            "muss.");

  AddSmell(DEFAULT_SMELL, "Es riecht ein bisschen nach Moder.");  
 
  AddSmell( ({"moder","geruch"}),
	   "Der moderige Geruch kommt von den Wandteppichen.");

  AddSound(DEFAULT_SOUND, "Es herrscht Totenstille.");

  AddSound( ({"totenstille","mir","von","willst"}),
	   "Tod sagt: WAS WILLST DU VON MIR?");
  
//-----Details Ende-----
  
AddExit("westen", ROOM "tem1-4");
AddExit("norden", ROOM "tem1-2");

}

