// von Chivas
inherit "std/room";

#include "../def.h"

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Tempel");
  SetProp( P_INT_LONG,
        "Ein Saal tut sich vor Dir auf. Der Boden besteht aus Parkett und an "
        "den Waenden stehen Stuehle und Tische, die jedoch mit Laken "
        "zugedeckt sind. Anscheinend wurden damals hier Sitzungen gehalten. "
        "Diese Zeit ist lange vorbei und nun sind die einzigen Kreaturen die "
        "hier im Saal sind ein paar Spinnen an der Decke." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----

  AddDetail( ({"saal"}), 
            "Der Saal ist recht gross, aber bis auf die Tische und Stuehle an "
            "den Waenden leer.");

  AddDetail( ({"boden"}),
	    "Der Boden ist mit Staub bedeckt. Unter der Staubschicht erkennt "
            "man altes Parkett.");

  AddDetail( ({"parkett"}),
	    "Das Parkett ist alt und sieht schon ein wenig bruechig aus. "
            "Einige Loecher sind auch zu erkennen.");

  AddDetail( ({"waende","waenden","wand"}), 
            "An den Waenden, wo die ueblichen Halterungen mit den Fackeln "
            "sind, stehen mit Laken abgedeckte Stuehle und Tische.");

  AddDetail( ({"stuehle"}),
	    "Die Stuehle sind mit Laken abgedeckt. Man erkennt nur die "
            "Stuhlbeine.");

  AddDetail( ({"tische"}),
	    "Auch die Tische sind mit Laken abgedeckt. Die grossen Tischbeine "
            "lucken unter den Laken hervor."); 
  
  AddDetail( ({"laken","jahre"}), 
            "Die Laken, die die Tische und Stuehle abdecken, waren "
            "anscheinend einmal weiss. Durch den Staub und die Jahre die "
            "vergangen sind, haben sie eine eher graeuliche Farbe angenommen.");

  AddDetail( ({"sitzungen"}),
	    "Damals wurden anscheinend Sitzungen in diesem Saal abgehalten. "
            "Die Tische und Stuehle haben damals sicher sauber aufgestellt im "
            "Saal gestanden.");

  AddDetail( ({"zeit"}),
	    "Es ist viel Zeit vergangen.");

  AddDetail( ({"kreaturen"}), 
            "Es gibt sicher viele ekelige Kreaturen hier im Tempel. Die "
            "einzigen, die Du momentan sehen kannst, sind ein paar kleine "
            "Spinnen an der Decke.");

  AddDetail( ({"spinnen"}),
	    "Die kleinen Spinnen an der Decke sind harmlos. Sie haengen traege "
            "in ihren kleinen Spinnenweben.");

  AddDetail( ({"decke","himmel"}), 
            "Die Decke ist kahl bis auf ein paar Spinnenweben mit ein paar "
            "kleinen Spinnen darin.");

  AddDetail( ({"staub","staubschicht","schicht"}),
	    "Die Staubschicht auf dem Parkett ist nicht sehr dick. Es sind ein "
            "paar Spuren zu erkennen.");

  AddDetail( ({"loecher","loechern"}),
	    "Die Loecher scheinen keinen natuerlichen Ursprung zu haben.");

  AddDetail( ({"stuhlbeine","beine"}), 
            "Die Stuhlbeine haben ein paar Verzierungen.");

  AddDetail( ({"tischbeine","tisch"}),
	    "Die Tischbeine scheinen aus grossen Knochen zu bestehen. Den "
            "restlichen Tisch willst Du gar nicht erst sehen.");

  AddDetail( ({"farbe"}),
	    "Die graeuliche Farbe gefaellt Dir gar nicht, aber die Laken "
            "willst Du auch nicht waschen."); 
  
  AddDetail( ({"spinnenweben"}), 
            "Die Spinnenweben sind nicht sehr interessant.");

  AddDetail( ({"spuren"}),
	    "Du hast nicht das Gefuehl, dass es Deine Spuren sind. Da sie in "
            "eine Richtung fuehren, wo Du noch gar nicht warst.");

  AddDetail( ({"richtung"}),
	    "Du bist Dir sicher, dass Du da noch nicht warst. Es muss von "
            "jemanden sein, der vor Dir hier war.");

  AddDetail( ({"gefuehl"}), 
            "Dein Gefuehl hat Dich eigentlich noch nie getaeuscht.");

  AddDetail( ({"ursprung"}),
	    "Es sieht so aus, als ob irgendwelche Tiere die Loecher in das "
            "Parkett gebissen haben.");

  AddDetail( ({"tiere","wesen"}),
	    "Als Du in eines der Loecher guckst, kannst Du kleine gelbe Augen "
            "sehen und ein Knurren hoeren."); 
  
  AddDetail( ({"augen","ruhe"}), 
            "Die Augen sehen boese und gemein aus. Du solltest die Wesen in "
            "den Loechern besser in Ruhe lassen.");

  AddDetail( ({"verzierungen"}),
	    "Die Verzierungen sind schon ein wenig verblasst, jedoch kann man "
            "das eine oder andere Runenwort noch erkennen.");

  AddDetail( ({"knochen","trollen"}),
	    "Die Knochen, aus denen die Tischbeine bestehen, sind riesig. Sie "
            "muessen von grossen Trollen stammen.");

  AddDetail( ({"runenwort","wort","runenwoerter","woerter"}), 
            "Die Runenwoerter, die Du noch erkennen kannst, bedeuten etwas wie "
            "Tod, Pestilenz und Unglueck. Du schluckst.");

  AddDetail( ({"tod","pestilenz","unglueck"}),
	    "Tod, Pestilenz und Unglueck sind Woerter, die Dir nicht gerade "
            "gefallen.");

  AddDetail( ({"tempel","tempels"}),
	    "Du bist mittendrin."); 

  AddDetail( ({"fackeln"}),
	    "Die Fackeln leuchten in einem kalten Blau."); 
  
  AddDetail( ({"blau","faerbung","flammen"}),
	    "Die blaue Faerbung der Flammen ist sicher magisch."); 
  
  AddDetail( ({"halterungen"}),
	    "In den Halterungen an der Wand haengen die leuchtenden Fackeln."); 
  
  
  AddSmell(DEFAULT_SMELL, "Es riecht ein wenig uebel aus den Loechern.");  
 
  AddSmell( ({"loecher"}),
	   "Es stinkt ekelig.");

  AddSound(DEFAULT_SOUND, "Du hoerst ein leises Knurren.");

  AddSound( ({"knurren"}),
	   "Das Knurren kommt von den Wesen in den Loechern. Besser Du laesst "
           "sie in Ruhe.");
  
//-----Details Ende-----
AddItem(NPC "hunger", REFRESH_DESTRUCT);
  
AddExit("norden", ROOM "tem2-1");
AddExit("osten", ROOM "tem2-3");

}

