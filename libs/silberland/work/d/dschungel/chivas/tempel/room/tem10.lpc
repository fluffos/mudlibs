// von Chivas
// 
inherit "std/room";

#include "../def.h"

void create()
	
{
  ::create();


  SetProp( P_INT_SHORT, "An einem Tempel im Dschungel");
  SetProp( P_INT_LONG,
        "Dies ist ein kleiner Pfad, der sich anscheinend um den ganzen Tempel "
        "zieht. Der Tempel ist teilweise eingestuerzt und an einigen Stellen "
	"fast komplett zugewachsen. Man kann nur einige Mauern des Tempels "
        "klar erkennen, wo der Dschungel sich noch nicht zurueckgekaempft hat.");
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 30, ENV_TERRAIN: TT_JUNGLE]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  
  AddDetail( ({"pfad"}), 
            "Der Pfad ist zwar ein wenig zugewachsen, aber man kann recht gut "
            "auf ihm gehen.");

  AddDetail( ({"tempel","tempels"}),
	    "Der Tempel ist hier ein wenig eingestuerzt. Es sieht so aus, als "
            "ob ein grosser Blitz direkt an der Mauer eingeschlagen ist und "
            "ein paar Brocken herausgesprengt hat.");

  AddDetail( ({"stellen","pflanzen"}),
	    "An einigen Stellen ist die Mauer fast von Schlingpflanzen und "
            "Efeu zugewachsen. Die Pflanzen sehen zwar nicht sehr gesund aus, "
            "aber sie scheinen trotzdem zu ueberleben.");

  AddDetail( ({"mauern","mauer"}), 
            "Die Mauern des Tempels bestehen aus Sandstein und sind an einigen "
            "Stellen zugewachsen.");

  AddDetail( ({"dschungel","durchkommen"}),
	    "Der Dschungel ist dicht und es ist kein Durchkommen. Du musst "
            "wohl auf dem Pfad bleiben. ;)");

  AddDetail( ({"boden"}),
	    "Am Boden liegen Blaetter von den Pflanzen, einige kleine Steine "
            "und ein paar grosse Brocken, die wohl vom Tempel stammen."); 
  
  AddDetail( ({"sandstein"}), 
            "Es sind grosse Steinbloecke, die sauber verfugt sind.");

  AddDetail( ({"bloecke","steinbloecke","tonnen","arbeit"}),
	    "Die Steinbloecke wiegen sicher einige Tonnen und es muss eine "
            "schwere Arbeit gewesen sein, diese aufeinander zu stapeln um "
            "den Tempel zu bauen. Ein Steinblock faellt Dir besonders auf.");

  AddDetail( ({"fugen"}),
	    "Die Fugen sind schon ein wenig poroes, was aber nicht "
            "verwunderlich ist, da der Tempel schon Jahrhunderte alt ist.");

  AddDetail( ({"himmel"}), 
            "Der Himmel ist blau und die Sonne steht fast senkrecht.");

  AddDetail( ({"wolken"}),
	    "Die Wolken sind eigentlich nicht erwaehnenswert.");

  AddDetail( ({"sonne"}),
	    "Die Sonne brennt vom Himmel und die paar Wolken haben nicht die "
            "Kraft sie zu verdecken."); 
  
  AddDetail( ({"steine"}), 
            "Die Steine sind eigentlich sehr uninteressant, waeren da nicht "
            "auch lauter fette Wuermer, die zwischen den Steinen umher "
            "kriechen. Das ist echt ekelig.");

  AddDetail( ({"blaetter"}),
	    "Die Blaetter sind sicher von den Baeumen auf den Pfad gefallen.");

  AddDetail( ({"wuermer"}),
	    "Die Wuermer machen sich anscheinend ueber die Reste eines toten "
            "Tieres her. Baaeeehhhh! ");

  AddDetail( ({"baeume"}), 
            "Ganz normale Baeume wie im ganzen Dschungel.");

  AddDetail( ({"schlingpflanzen","efeu"}),
	    "Schlingpflanzen und Efeu haben sich an einigen Stellen am Tempel "
            "festgesetzt und verbergen die dahinter liegende Mauer.");

  AddDetail( ({"brocken"}),
	    "Die Brocken wurden aus dem Tempel herausgesprengt und liegen "
            "auf dem Boden."); 
  
  AddDetail( ({"blitz","einhalt"}), 
            "Ob der Blitz direkt von den Goettern gekommen ist, um dem Boesen "
            "im Tempel Einhalt zu gewaehren?");

  AddDetail( ({"goettern","goetter"}),
	    "Da kommen nur zwei in Frage. Entweder war es Woody oder Dusty.");

  AddDetail( ({"woody","mudgott"}),
	    "Das ist der Mudgott.");

  AddDetail( ({"frage"}), 
            "Du untersuchst ja wirklich alles.");

  AddDetail( ({"dusty","mudgoettin"}),
	    "Dies ist die Mudgoettin.");

  AddDetail( ({"boesen"}),
	    "Das ist unbeschreiblich."); 
  
  AddDetail( ({"jahrhunderte"}), 
            "Das ist sehr lang.");

  AddDetail( ({"steinblock"}),
	    "Auf einem Steinblock wurde Etwas eingeritzt.");

  AddDetail( ({"etwas"}),
	    "Es scheint eine Warnung zu sein.");

  AddDetail( ({"warnung"}), 
            "Du kannst sie sicher lesen.");

  AddDetail( ({"kraft","seicherl"}),
	    "Sowas haettest Du auch gerne Du Seicherl.");

  AddDetail( ({"reste","tieres","sache","resten","tier","tiere"}),
	    "Du untersuchst die Sache nicht weiter und wendest Dich angeekelt "
            "ab."); 
  
  AddSmell(DEFAULT_SMELL, "Es riecht leicht nach Verwesung.");  
 
  AddSmell( ({"verwesung","geruch"}),
	   "Der Geruch kommt von den Resten eines Tieres auf dem Pfad.");

  AddSound(DEFAULT_SOUND, "Es ist absolut still. Es wirkt irgendwie "
                          "unheimlich.");
  
  AddReadDetail( ({"warnung"}),
		"LAUF, ABER LAUF SCHNELL!!!");

//-----Details Ende-----
  
AddExit("westen", ROOM "tem9");
AddExit("osten", ROOM "tem8");

}

