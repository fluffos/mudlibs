// von Chivas
inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Tempel");
  SetProp( P_INT_LONG,
        "Mitten im Raum schwebt eine grosse feuerrote Flamme. Die Waende "
        "spiegeln das Feuer in die Unendlichkeit wieder, da die Waende aus "
        "plankem Lavagestein bestehen. Am Boden sind erneut einige "
        "Aschehaeufchen, die Dich aber nicht mehr sehr beunruhigen, da Du es "
        "ja langsam gewohnt bist." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 45, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"raum"}), 
            "In dem hell erleuchtetem Raum brennt eine grosse feuerrote "
            "Flamme.");

  AddDetail( ({"flamme"}),
	    "Die Flamme brennt heiss und spiegelt sich in den Waenden.");

  AddDetail( ({"waende","waenden","oberflaeche"}),
	    "Die Waende bestehen aus Lavagestein, sind ganz glatt und "
            "glaenzend. Das Feuer der Flamme spiegelt sich in der glatten "
            "Oberflaeche.");

  AddDetail( ({"feuer"}), 
            "Das heisse Feuer der Flamme spiegelt sich in den Waenden.");

  AddDetail( ({"unendlichkeit"}),
	    "Diese Unendlichkeit wirst Du nur im Tod erleben.");

  AddDetail( ({"lavagestein","gestein"}),
	    "Das Lavagestein ist ganz glatt und in der Oberflaeche spiegelt "
            "sich das Feuer der Flamme."); 
  
  AddDetail( ({"boden"}), 
            "Am Boden sind Marmorplatten zu erkennen. Auf ihnen liegen "
            "einzelne Aschehaeufchen.");

  AddDetail( ({"decke","himmel"}),
	    "Die Decke ist kahl, bis auf einen grossen Fleck in der Mitte der "
            "Decke.");

  AddDetail( ({"asche","aschehaeufchen","haeufchen"}),
	    "In den Haeufchen von Asche ist nichts mehr zu erkennen. Alles "
            "wurde eingeaeschert. Nicht einmal Teile der Ausruestung oder der "
            "Waffen sind mehr zu erkennen.");

  AddDetail( ({"tod","gerufen","mich"}), 
            "Tod fragt: HAST DU MICH GERUFEN?");

  AddDetail( ({"marmor","marmorplatten","platten"}),
	    "Die Marmorplatten sind weiss und makelos.");

  AddDetail( ({"mitte","fleck","russ"}),
	    "Der Fleck ist vom Russ der Flamme."); 
  
  AddDetail( ({"teile","ausruestung","waffen"}), 
            "Es ist in der Asche nichts mehr zu erkennen.");

  AddDetail( ({"magie","werk"}),
	    "Sehr starke Magie ist in diesem Raum am Werk.");

  AddSmell(DEFAULT_SMELL, "Es riecht nach Feuer und Asche.");  
 
  AddSmell( ({"feuer","asche"}),
	   "Das Feuer und die Asche riechen irgendwie magisch. Was anderes "
           "als Magie kann die Flamme und die Haeufchen auch nicht "
           "erschaffen haben.");

  AddSound(DEFAULT_SOUND, "Du hoerst das Flackern der grossen Flamme.");

  AddSound( ({"flamme","flackern"}),
	   "*flacker*flacker*flacker*");
  
//-----Details Ende-----
AddItem(NPC "istar", REFRESH_DESTRUCT);
  
AddExit("sueden", ROOM "tem3-7");
AddExit("norden", ROOM "tem3-5");
AddExit("westen", ROOM "tem3-1");

}

