// von Chivas
inherit "std/room";

#include "../def.h"

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "An einem Tempel im Dschungel");
  SetProp( P_INT_LONG,
        "Der Pfad ist hier viel breiter als an den anderen Stellen, da "
        "mehrere grosse Baeume umgefallen sind und die anderen Baeume "
	"mitgerissen haben. Es sind nur einige kleine Pflanzen und Buesche "
        "direkt am Weg und am Tempel." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 30, ENV_TERRAIN: TT_JUNGLE]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----

  AddDetail( ({"pfad","weg","pfades","seiten"}), 
            "Der Pfad ist hier angenehm breit. Nur ein paar kleinere Pflanzen "
            "haben begonnen, die Luecken zu schliessen, die die grossen Baeume "
            "hinterlassen haben. Einige wachsen direkt auf beiden Seiten des "
            "Pfades, obwohl die Gewaechse direkt am Tempel nur eine ungesunde "
            "gelbliche Farbe haben.");

  AddDetail( ({"stellen"}),
	    "An anderen Stellen is der Pfad erheblich schmaler als hier.");

  AddDetail( ({"baeume"}),
	    "Ein paar Baeume sind umgefallen und haben dabei auch andere "
            "mitgerissen. Dadurch sind einige grosse Luecken im Dschungel "
            "entstanden, die erst langsam wieder zuwachsen.");

  AddDetail( ({"pflanzen"}), 
            "Ein paar Buesche, Graeser und kleine Baeume.");

  AddDetail( ({"buesche","bueschen","platz"}),
	    "Die Buesche haben den Platz der grossen Baeume eingenommen. "
            "Direkt am Tempel haben sie jedoch eine ungesunde gelbliche "
            "Farbe.");

  AddDetail( ({"tempel","tempels"}),
	    "Direkt am Tempel stehen ein paar Buesche, ansonsten kann man aber "
            "recht gut die Mauer des Tempels sehen."); 
  
  AddDetail( ({"gewaechse","farbe","umwelt"}), 
            "Die Gewaechse direkt an der Mauer des Tempels haben eine "
            "ungesunde gelbliche Farbe. Der Tempel scheint sich negativ auf "
            "seine Umwelt auszuwirken.");

  AddDetail( ({"mauer"}),
	    "Die Mauer besteht aus grossen Steinquadern.");

  AddDetail( ({"luecken","luecke"}),
	    "Die Luecken wachsen langsam mit Graesern, kleinen Bueschen und "
            "kleinen Baeumen zu. Die alten Staemme liegen am Boden und "
            "verrotten.");

  AddDetail( ({"staemme","staemmen"}), 
            "Ein paar Staemme der umgefallenen Baeume liegt auf dem Boden "
            "in der grossen Luecke im Dschungel. Sie sind schon sehr mit "
            "Moos bewachsen und verrotten langsam.");

  AddDetail( ({"graeser","graesern"}),
	    "Die Graeser gedeihen recht gut, da sie durch die grossen Luecken "
            "viel Sonne abbekommen.");

  AddDetail( ({"sonne"}),
	    "Die Sonne steht beinahe senkrecht am Himmel."); 
  
  AddDetail( ({"himmel"}), 
            "Der Himmel ist schoen blau. Nur ein paar kleine Wolken sind zu "
            "sehen.");

  AddDetail( ({"wolken","gefahr","regen"}),
	    "Die Wolken sind klein und weiss. Es besteht also nicht die "
            "Gefahr, dass Du nass wirst und es Regen gibt.");

  AddDetail( ({"boden"}),
	    "Am Boden wachsen ein paar Graeser. Ansonsten siehst Du ein paar "
            "Blaetter, die von den Bueschen abgefallen sind.");

  AddDetail( ({"steinquadern","steinquader","quader","quaders","arbeit"}), 
            "Die Steinquader sind riesig. Es muss eine schwere Arbeit "
            "gewesen sein, sie hier her zu bringen und den Tempel zu bauen. "
            "An einer Ecke eines Quaders faellt Dir Etwas auf.");

  AddDetail( ({"ecke","etwas"}),
	    "Es ist eine eingeritzte Inschrift zu erkennen.");

  AddDetail( ({"inschrift"}),
	    "Du kannst sie lesen."); 
  
  AddDetail( ({"blaetter"}), 
            "Die Blaetter haengen an den Bueschen und Baeumen, die noch "
            "stehen, einige liegen auch auf dem Pfad.");

  AddDetail( ({"dschungel"}),
	    "Du bist im Dschungel.");

  AddDetail( ({"blumen"}),
	    "Ein paar Blumen wachsen zwischen den umgefallenen Staemmen.");

  AddDetail( ({"chivas","magier"}), 
            "Chivas ist einer dieser merkwuerdigen Magier.");

  AddDetail( ({"moos"}),
	    "Das Moos ist gruen und waechst fast auf allen Staemmen.");

  AddSmell(DEFAULT_SMELL, "Es riecht nach Blumen.");  
 
  AddSmell( ({"blumen"}),
	   "Die Blumen duften herrlich.");

  AddSound(DEFAULT_SOUND, "Du hoerst ein paar Voegel trillern.");

  AddSound( ({"voegel"}),
	   "Sie trillern irgend ein Lied.");

  AddSound( ({"lied"}),
	   "Du kennst das Lied nicht, aber es hoert sich schoen an.");
  
  AddReadDetail( ({"inschrift"}),
		"Chivas war hier.");

//-----Details Ende-----
AddItem( "/d/dschungel/dante/weg/npc/dtiger", REFRESH_DESTRUCT,
        ([P_MNPC_DEFAULTROOM: "tem19",
          P_MNPC_AREA:({ROOM "tem18", ROOM "tem19", ROOM "tem20"}),
          P_MNPC_FLAGS: MOV_OUTDOORS + MOV_MAYLOAD + MOV_MOVES
        ]) );
  
AddExit("osten", ROOM "tem18");
AddExit("westen", ROOM "tem20");

}

