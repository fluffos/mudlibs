// von Chivas
inherit "std/room";

#include "../def.h"

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "An einem Tempel im Dschungel");
  SetProp( P_INT_LONG,
        "Der Pfad, der um den Tempel herum fuehrt, ist angenehm breit. Du musst "
        "Dich nicht zwischen der Mauer und den grossen Baeumen hindurch "
        "zwaengen. Der Boden ist mit lauter Laub der Baeume und kleinen "
	"Pflanzen bedeckt. Einige Schlingpflanzen und Ranken haben es "
        "gewagt sich an der Tempelmauer festzusetzen. " );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 30, ENV_TERRAIN: TT_JUNGLE]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----

  AddDetail( ({"pfad"}), 
            "Der Pfad fuehrt hier um die noerdwestliche Ecke des Tempels "
            "wieder zurueck zum Eingang oder nach Sueden weiter um den Tempel "
            "herum.");

  AddDetail( ({"tempel","tempels"}),
	    "Der Tempel ist direkt neben Dir. Du bist aber froh, dass der Pfad, "
            "auf dem Du stehst, recht breit ist, da Du im nicht zu nahe kommen "
            "willst. Er strahlt irgendwie eine boesartige Aura aus.");

  AddDetail( ({"mauer","tempelmauer","mauern","aussenmauer"}),
	    "Die Mauern des Tempels sind ein wenig zugewachsen. Man kann aber "
            "immer noch die grossen Steinquader der Aussenmauer erkennen.");

  AddDetail( ({"baeume","baeumen","chance","wand"}), 
            "Die Baeume des Dschungels bilden eine unueberwindliche Wand. Du "
            "hast keine Chance, den Pfad zu verlassen.");

  AddDetail( ({"boden"}),
	    "Am Boden ist viel Laub zu sehen, ausserdem einige kleine Pflanzen "
            "und viele Graeser, die recht hoch wachsen.");

  AddDetail( ({"laub"}),
	    "Viel Laub der Baeume liegt auf dem Boden.");

  AddDetail( ({"pflanzen"}),
	    "Es sind ein paar Blumen, aber hauptsaechlich Graeser, die Du nicht "
            "kennst."); 
  
  AddDetail( ({"schlingpflanzen"}), 
            "Die Schlingpflanzen haengen von ein paar Baeumen, aber "
            "hauptsaechlich an der Tempelmauer.");

  AddDetail( ({"ranken"}),
	    "Einige Ranken haengen neben den Schlingpflanzen an der Mauer. Sie "
            "sind nicht sehr interessant.");

  AddDetail( ({"ecke"}),
	    "Die nordwestliche Ecke des Tempels ist mit ein paar "
            "Schlingpflanzen und Ranken zugewachsen.");

  AddDetail( ({"eingang"}), 
            "Den Eingang erreichst Du, wenn Du um die Ecke gehst.");

  AddDetail( ({"sueden"}),
	    "Wenn Du nach Sueden gehst, wirst Du wohl den Tempel umrunden.");

  AddDetail( ({"aura","gefuehl"}),
	    "Es ist nur ein Gefuehl, aber Du traust dem Tempel nicht."); 
  
  AddDetail( ({"steinquader","quader"}), 
            "Die Quader haben riesige Ausmasse. Es muss eine Knochenarbeit "
            "gewesen sein, diese aufzustapeln.");

  AddDetail( ({"ausmasse"}),
	    "Die Steinquader sind groesser als Du selbst.");

  AddDetail( ({"knochenarbeit","arbeit"}),
	    "Falls man beim Bau unter einen solchen Quader geraten ist, waren "
            "die Knochen auf jedenfall kaputt und man besuchte Gevatter Tod.");

  AddDetail( ({"bau"}), 
            "Der Bau des Tempels ist schon Jahrhunderte her.");

  AddDetail( ({"jahrhunderte","zeit"}),
	    "Das ist eine sehr lange Zeit.");

  AddDetail( ({"knochen"}),
	    "Deine Knochen sind momentan alle heile."); 
  
  AddDetail( ({"gevatter","tod","sense","ohr"}), 
            "Eine geheimnisvolle Stimme fluestert Dir ins Ohr: Komm ruhig mal "
            "vorbei. Meine Sense wartet.");

  AddDetail( ({"stimme"}),
	    "Die Stimme laesst Dich erschauern.");

  AddDetail( ({"graeser","huefte"}),
	    "Die Graeser gehen Dir bis zur Huefte. Deine Fuesse kannst Du "
            "nicht sehen.");

  AddDetail( ({"blumen"}), 
            "Die Blumen sind sehr schoen und bluehen in den verschiedensten "
            "Farben.");

  AddDetail( ({"farben"}),
	    "Alle Farben des Regenbogens.");

  AddDetail( ({"regenbogen","regenbogens"}),
	    "Das war nur bildlich gemeint."); 
  
  AddDetail( ({"ranke"}), 
            "Es sieht so aus, als ob man an der Ranke auf die erste Ebene des "
            "Tempels klettern kann.");

  AddDetail( ({"fuesse"}),
	    "Du stoesst mit Deinen Fuessen gegen Etwas.");

  AddDetail( ({"etwas"}),
	    "Es ist eine besonders dicke Ranke, die am Boden liegt und weiter "
            "an der Tempelmauer hochwaechst.");

  AddDetail( ({"ebene"}), 
            "Man kann anscheinend auch von aussen auf dem Tempel herum gehen.");

  AddDetail( ({"dschungel"}),
	    "Der Dschungel beginnt direkt neben dem Pfad.");

  AddDetail( ({"himmel","sonne"}),
	    "Der Himmel ueber Dir ist wunderbar blau und die Sonne scheint."); 
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Blumen.");  
 
  AddSmell( ({"blumen"}),
	   "Die Blumen duften herrlich.");

  AddSound(DEFAULT_SOUND, "Es ist recht still. Irgendwie ungewohnlich fuer "
                          "einen Dschungel.");

//-----Details Ende-----
  
AddExit("sueden", ROOM "tem26");
AddExit("nordosten", ROOM "tem9");

AddCmd( ({"kletter", "klettere" }), "klettern" );

}
int klettern(string str)
{
   notify_fail("Woran moechtest Du wohin klettern?\n");
   if ( member( ({ "an ranke hoch", "an ranke rauf" }),str) != -1) 
  {
    write(BS( "Du kletterst an der Ranke hoch und erreichst die erste Ebene des "
           "Tempels von aussen.\n"));
      TP->move(ROOM "tem1-22", M_GO, "nach oben", "verschwindet",
      "kommt auf einer Ranke heraufgeklettert");
    return 1;
  }
}

