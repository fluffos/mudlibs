// von Chivas
inherit "std/room";

#include "../def.h"

int anzahl;

void create()
	
{
  ::create();

  anzahl=1;

  SetProp( P_INT_SHORT, "An einem Tempel im Dschungel");
  SetProp( P_INT_LONG,
        "Ein kleines Rinnsal kreuzt den Pfad. In der Tempelmauer ist ein "
        "mittelgrosses Loch durch das Wasser in den Dschungel abfliesst. "
        "Das Wasser ist rot und irgendwie dickfluessig und laedt nicht "
	"dazu ein es zu trinken. Auch die Pflanzen direkt am Rinnsal sehen "
        "recht kraenklich aus. " );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 30, ENV_TERRAIN: TT_JUNGLE]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----

  AddDetail( ({"rinnsal"}), 
            "Ein kleines Rinnsal kreuzt den Pfad. Das Wasser kommt aus einem "
            "Loch in der Tempelmauer und versickert im Dschungel.");

  AddDetail( ({"pfad"}),
	    "Der Pfad fuehrt an der Tempelmauer entlang nach Norden und "
            "Sueden.");

  AddDetail( ({"tempelmauer","mauer"}),
	    "In der Tempelmauer die ein wenig zugewachsen ist, ist ein Loch.");

  AddDetail( ({"wasser"}),
	    "Das Wasser ist rot und dickfluessig. Es ist ekelig. Ob man es "
            "trinken kann?");

  AddDetail( ({"dschungel","dschungels"}),
	    "Der Dschungel beginnt gleich neben dem Pfad."); 
  
  AddDetail( ({"pflanzen"}), 
            "Lauter Pflanzen wachsen um Dich herum. Die Pflanzen genau neben "
            "dem Rinnsal sehen ein wenig kraenklich aus.");

  AddDetail( ({"boden"}),
	    "Am Boden liegen einige Blaetter und das Rinnsal, dass im "
            "Dschungel verschwindet, ist zu sehen.");

  AddDetail( ({"himmel"}),
	    "Der Himmel ist blau, jedoch kann man ihn durch das Blaetterdach "
            "des Dschungels nicht besonders gut sehen.");

  AddDetail( ({"blaetter"}),
	    "Ein paar Blaetter von den Baeumen liegen auf dem Boden."); 
  
  AddDetail( ({"baeume","baeumen"}), 
            "Die riesigen Baeume des Dschungels stehen gleich neben dem "
            "Pfad.");

  AddDetail( ({"blaetterdach","dach"}),
	    "Das Blaetterdach ist sehr dicht.");

  AddDetail( ({"moeglichkeit","moeglichkeiten"}),
	    "Das Leben bietet viele Moeglichkeiten.");

  AddDetail( ({"tempel"}), 
            "Du stehst direkt am Tempel. Er ist sehr alt und scheint immer "
            "noch boesartige und magische Energie zu beherbergen.");

  AddDetail( ({"energie","magie"}),
	    "Du spuerst die Energie der Magie und Deine Nackenhaare stellen "
            "sich auf.");

  AddDetail( ({"nackenhaare","haare"}),
	    "Du fuehlst Dich nicht gerade beruhigt."); 
  
  AddDetail( ({"leben"}), 
            "Dein Leben kann im und am Tempel recht schnell enden.");

  AddSpecialDetail( ({ "gitter" }), "gitter" );
  AddSpecialDetail( ({ "vorhaengeschloss","schloss" }), "schloss" );
  AddSpecialDetail( ({ "loch" }), "loch" );
  
  AddSmell(DEFAULT_SMELL, "Es riecht ein wenig nach stinkendem Wasser.");  
 
  AddSmell( ({"wasser"}),
	   "Das Wasser stinkt und riecht ekelig.");

  AddSound(DEFAULT_SOUND, "Du hoerst das Wasser aus dem Loch plaetschern.");

  AddSound( ({"wasser","tropfen","plaetschern"}),
	   "Es ist mehr ein Tropfen als ein Plaetschern.");
  
//-----Details Ende-----
  
AddExit("norden", ROOM "tem15");
AddExit("sueden", ROOM "tem17");

AddCmd( ({"trink", "trinke" }), "trinken" );
AddCmd( ({"brech", "breche","brich" }), "brechen" );
AddCmd( ({"kletter", "klettere" }), "klettern" );

}
int trinken(string str)
{
   notify_fail("Was moechtest Du trinken?\n");
   if ( member( ({ "wasser" }),str) != -1) 
  {
    write(BS( "Du trinkst das rote Wasser und es schmeckt nicht besonders "
           "gut, aber Du bist schon froh, dass es keine anderen "
           "negativen Auswirkungen hat.\n"));
    say( TPN+" trinkt ein wenig Wasser und verzieht das Gesicht.\n");
    return 1;
  }
}
int klettern(string str)
{
   notify_fail("Wo moechtest Du hin klettern?\n");
   if(!str || str == "") return 0;
   if(!(str == "in loch" ||
      str == "loch")) return 0;

   if( str == "in loch","loch"){

    if (TP->QueryProp(P_LEVEL) < 20) {
    write("Du traust Dich noch nicht weiter.\n");
    return -1;
    }

     if( anzahl < 1 )
      {
    write(BS( "Du kletterst ist das Loch und hinter Dir faellt das "
              "Gitter zu. Hier kommst Du nicht mehr raus.\n"));
    say( TPN+" klettert in ein Loch und verschwindet. Ein Gitter faellt zu und "
             "ein Schloss erneuert sich auf magische Weise.\n");
      TP->move(ROOM "tem33", M_GO,
      "in einem Loch und das Gitter faellt zu", "verschwindet",
      "kommt durch das Gitter herein" );
    anzahl=1;
    return 1;
     }
     else
     {
        write(BS("Du kannst nicht einfach so in ein Loch klettern.\n"));
        say(sprintf("%s probiert etwas unmoegliches.\n", TP->Name(WER)));
        return -1;
     }}
}
int brechen(string str)
{

 notify_fail("Was moechtest Du aufbrechen? \n");

 if(!str || str == "") return 0;
 if(!(str == "schloss auf" ||
      str == "schloss vorsichtig auf" ||
      str == "schloss mit vorsicht auf")) return 0;

 if( str == "schloss auf"){

     if( anzahl < 1 )
     {
        write(BS("Du kannst das Schloss nicht aufbrechen, da es schon "
                 "aufgebrochen wurde.\n"));
        say(sprintf("%s probiert etwas unmoegliches.\n", TP->Name(WER)));
        return -1;
     }

    write(BS("Du probierst das rostige Schloss aufzubrechen, rutscht aber dabei "
           "ab und verletzt Dich. Du haettest es mit mehr Vorsicht probieren "
           "sollen.\n"));
 
  say(TPN+" probiert ein rostiges Schloss aufzubrechen und verletzt sich "
          "dabei.\n");
  TP->AddHp(-15);
  this_player()->AddPoison(2);
  return 1;
 }

 if( str == "schloss mit vorsicht auf","schloss vorsichtig auf"){
     if( anzahl < 1 )
     {
        write(BS("Du kannst das Schloss nicht aufbrechen, da es schon "
                 "aufgebrochen wurde.\n"));
        say(sprintf("%s probiert etwas unmoegliches.\n", TP->Name(WER)));
        return -1;
     }

  write(BS("Du brichst das Schloss vorsichtig auf und hebst das Gitter an. Du "
           "koenntest jetzt in das Loch klettern.\n"));
 
  say(TPN+" bricht ein Schloss auf und hebt ein Gitter.\n");
  anzahl=0;
  return 1;
}}
string schloss(string key)
{
    if ( anzahl )
    {
    return(BS("Ein altes verrostetes Schloss haengt am Gitter, so dass Du es "
            "nicht oeffnen kannst. Vielleicht waere dies hier eine andere "
            "Moeglichkeit in den Tempel zu gelangen. Man kann es vielleicht "
            "aufbrechen. Pass aber auf, da es sehr rostig ist und man sich "
            "leicht verletzen kann."));
    }
    else
    {
    return(BS("Das Vorhaengeschloss ist aufgebrochen und nun absolut "
              "nutzlos."));
    }
}
string loch(string key)
{
    if ( anzahl )
    {
    return(BS("Das Loch ist mittelgross und das Wasser fliesst aus ihm heraus. "
            "Ein rostiges Gitter versperrt das Loch."));
    }
    else
    {
    return(BS("Das Loch ist frei und nicht mehr von dem Gitter versperrt."));
    }
}
string gitter(string key)
{
    if ( anzahl )
    {
    return(BS("Ein rostiges Gitter versperrt das Loch."));
    }
    else
    {
    return(BS("Das Loch ist frei und nicht mehr von dem Gitter versperrt."));
    }
}

