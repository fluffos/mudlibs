// von Chivas
inherit "std/room";

#include "../def.h"

void create()
	
{
  ::create();


  SetProp( P_INT_SHORT, "In einem Tempel");
  SetProp( P_INT_LONG,
        "Dies ist die Eingangshalle des Tempels. Man merkt die daemonische "
        "Magie, die hier vor Urzeiten bewirkt wurde. Sie scheint teilweise "
	"immer noch aktiv zu sein. An den Waenden, die aus grossen Quadern "
        "bestehen, haengen Fackeln. Die Fackeln brennen in einem gruenlichen "
        "Licht, dass nur durch Magie entstehen kann." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 30, ENV_TERRAIN: TT_JUNGLE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  
  AddDetail( ({"eingangshalle","halle","eingang"}), 
            "Du stehst nun im Tempel und Dein Herzschlag erhoeht sich. Ein "
            "unangenehmes Gefuehl befaellt Dich.");

  AddDetail( ({"tempels","tempel"}),
	    "Nun bist Du im Tempel und Du fuehlst Dich nicht besser als "
            "draussen. Irgendwie sogar schlechter.");

  AddDetail( ({"magie"}),
	    "Du spuerst noch die Magie, die damals hier geherrscht haben "
            "muss. Auch die Fackeln scheinen magisch zu sein, ansonsten "
            "wuerden sie nicht in diesem Licht erstrahlen.");

  AddDetail( ({"urzeiten","gott"}), 
            "Da gab es Dich noch gar nicht, ausser Du bist ein Gott.");

  AddDetail( ({"waenden","waende","wand"}),
	    "An den Waenden haengen Halterungen, in denen Fackeln stecken. "
            "Ansonsten sind die Waende kahl und man kann die Quader sehen.");

  AddDetail( ({"quader","quadern"}),
	    "Die grossen Quader bilden die Waende. Ausser ein paar Kratzspuren "
            "und den Halterungen sind sie uninteressant."); 
  
  AddDetail( ({"fackeln","fackel"}), 
            "Die Fackeln leuchten in einem magischen gruenen Licht.");

  AddDetail( ({"licht"}),
	    "Das gruenliche Licht muss einen magischen Ursprung haben.");

  AddDetail( ({"boden"}),
	    "Auf dem Boden kannst Du einen grossen Kreis sehen und einige "
            "Pfuetzen.");

  AddDetail( ({"decke","himmel"}), 
            "An der Decke, die weit ueber Dir ist, haengen riesengrosse "
            "Spinnweben. Du erschauerst. Ausserdem tropft es von ihr auf "
            "den Boden.");

  AddDetail( ({"spinnweben"}),
	    "Die Spinnen, die hier wohnen muessen riesig sein.");

  AddDetail( ({"spinnen"}),
	    "Du kannst momentan keine sehen und bist froh darueber."); 
  
  AddDetail( ({"mosaik"}), 
            "Das Mosaik besteht aus kleinen Steinchen.");

  AddDetail( ({"steinchen"}),
	    "Die Steinchen innerhalb des Kreises bilden ein Muster.");

  AddDetail( ({"drachen","drache"}),
	    "Ein grosser roter Drache, der ein paar Einwohner des Silberlandes "
            "abschlachtet. Ist dies ein Zeichen, was in diesem Tempel haust?");

  AddDetail( ({"kreis","kreises"}), 
            "Der Kreis ist aus kleinen Steinplatten gebildet. Innerhalb "
            "des Kreises ist ein Mosaik zu erkennen.");

  AddDetail( ({"steinplatten","platten"}),
	    "Die Steinplatten bilden einen Kreis.");

  AddDetail( ({"muster"}),
	    "Das Muster bildet einen grossen Drachen."); 
  
  AddDetail( ({"zeichen","deuten"}), 
            "Das Deuten von Zeichen liegt Dir nicht.");

  AddDetail( ({"einwohner"}),
	    "Du siehst wie der Drache sie einfach zermalmt. Er scheint Freude "
            "dabei zu haben. Unter den zermalmten Koerpern erkennst Du Etwas.");

  AddDetail( ({"silberlandes","silberland"}),
	    "Da befindest Du Dich.");

  AddDetail( ({"freude","anblick"}), 
            "Freude verspuerst Du bei dem Anblick nicht, es ist eher ein "
            "beunruhigendes Gefuehl.");

  AddDetail( ({"gefuehl","kneipe","midas"}),
	    "In der Kneipe in Midas wuerdest Du Dich momentan sicher besser "
            "fuehlen.");

  AddDetail( ({"herzschlag","herz"}),
	    "Du hoerst Dein eigenes Herz laut schlagen."); 
  
  AddDetail( ({"koerpern","etwas"}), 
            "Du erkennst einen kleinen Schriftzug.");

  AddDetail( ({"schriftzug"}),
	    "Du kannst ihn lesen.");

  AddDetail( ({"pfuetzen","pfuetze"}),
	    "Es scheint von der Decke zu tropfen.");

  AddDetail( ({"ursprung"}), 
            "Sie brennen sicher schon Jahrhunderte.");

  AddDetail( ({"jahrhunderte","zeit"}),
	    "Eine lange Zeit.");

  AddDetail( ({"nase"}),
	    "Du hast eine und zwar eine ziemlich grosse.");

  AddDetail( ({"halterungen","eisen","stellen","rost"}),
	    "Die Halterungen der Fackeln sind schmucklos und bestehen aus "
            "Eisen, welche an manchen Stellen ein wenig Rost aufweisen. "); 

  AddDetail( ({"kratzspuren","spuren","wesen","leben","sache"}),
	    "Die Spuren stammen sicher von einem armen Wesen, dass hier sein "
            "Leben ausgehaucht hat. Du willst eigentlich nicht mehr ueber die "
            "Sache wissen."); 
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach verottetem Fleisch und Weihrauch.");  
 
  AddSmell( ({"fleisch"}),
	   "Du haelst Dir die Nase zu. Es stinkt fuerchterlich.");

  AddSmell( ({"weihrauch"}),
	   "So etwas haettest Du hier nicht erwartet. Komisch.");

  AddSound(DEFAULT_SOUND, "Du hoerst nur Dein Herz schlagen.");

  AddSound( ({"herz"}),
	   "Es pocht ganz laut.");
  
  AddReadDetail( ({"schriftzug"}),
		"Der Drache des Blutes, der Herrscher des Tempels.");

//-----Details Ende-----
AddItem( "/d/unterwelt/basics/central/npc/skelett", REFRESH_DESTRUCT,
        ([P_MNPC_DEFAULTROOM: "tem28",
          P_MNPC_AREA:({ROOM "tem28", ROOM "tem29", ROOM "tem30"}),
          P_MNPC_FLAGS: MOV_INDOORS + MOV_MAYLOAD + MOV_MOVES
        ]) );
AddItem( "/d/wasser/dante/zinsel/npc/zo1", REFRESH_DESTRUCT,
        ([P_MNPC_DEFAULTROOM: "tem28",
          P_MNPC_AREA:({ROOM "tem28", ROOM "tem29", ROOM "tem30"}),
          P_MNPC_FLAGS: MOV_INDOORS + MOV_MAYLOAD + MOV_MOVES
        ]) );
  
AddExit("norden", ROOM "tem8");
AddExit("suedwesten", ROOM "tem29");

}

