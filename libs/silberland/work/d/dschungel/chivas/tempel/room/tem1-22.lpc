// von Chivas
inherit "std/room";

#include "../def.h"

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einem Tempel im Dschungel");
  SetProp( P_INT_LONG,
        "In Richtung Osten kannst Du nicht weitergehen, da ein Teil der Decke "
        "des Erdgeschosses eingestuerzt ist und es sehr tief herunter geht. "
        "Direkt am Tempel stehen einige grosse Baeume, dessen Aeste ueber den "
        "Tempel reichen, wo Du gerade stehst. Du solltest nicht zu nah an den "
        "Abgrund gehen, da Du Dir bei einem Sturz sicher sehr weh tun "
        "wuerdest.");
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 30, ENV_TERRAIN: TT_JUNGLE]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"richtung","osten"}), 
            "In Richtung Osten ist ein Abgrund.");

  AddDetail( ({"teil","decke","erdgeschosses","erdgeschoss"}),
	    "Ein Teil der Decke ist eingestuerzt und normalerweise koenntest "
            "Du in das Erdgeschoss sehen, jedoch ist die Dunkelheit dort "
            "unten zu gross und Du siehst nichts.");

  AddDetail( ({"tempel","tempels"}),
	    "Du bist auf einem Tempel im Dschungel.");

  AddDetail( ({"baeume","baeumen"}), 
            "Die Baeume stehen hier sehr dicht am Tempel. Ihre Aeste haengen "
            "ueber Dir.");

  AddDetail( ({"aeste"}),
	    "Die Aeste der Baeume haengen ueber Dir und einige Lianen baumeln "
            "an ihnen.");

  AddDetail( ({"abgrund"}),
	    "Der Abgrund ist sehr tief."); 
  
  AddDetail( ({"sturz"}), 
            "So ein Sturz tut sicher ziemlich weh, vor allem wenn man nicht "
            "einmal sieht, wohin man faellt.");

  AddDetail( ({"boden"}),
	    "Am Boden sind ein paar Pflanzen zu sehen.");

  AddDetail( ({"ranken"}),
	    "Einige Ranken sind an der Aussenmauer des Tempels zu sehen. Eine "
            "andere Ranke faellt Dir aber mehr auf.");

  AddDetail( ({"lianen","liane"}), 
            "Die Lianen sehen sehr reissfest aus. Vielleicht kann man sich mit "
            "einer Liane ueber den Abgrund schwingen.");

  AddDetail( ({"himmel","farbe"}),
	    "Der Himmel hat eine schoene blaue Farbe.");

  AddDetail( ({"dunkelheit"}),
	    "Die Dunkelheit ist undurchdringbar. Es kann natuerlich auch sein, "
            "dass ein wenig Magie Dir die Sicht behindert."); 
  
  AddDetail( ({"magie","sicht"}), 
            "Die Magie an und in dem Tempel ist sehr gross.");

  AddDetail( ({"dschungel"}),
	    "Der Dschungel ist hier sehr dicht am Tempel.");

  AddDetail( ({"pflanzen"}),
	    "Einige Moose, Ranken und Schlingpflanzen haben sich am Boden und "
            "an der Aussenmauer festgesetzt.");

  AddDetail( ({"aussenmauer","mauer"}), 
            "An der Aussenmauer siehst Du einige Ranken und die Fenster, wie "
            "auf der ganzen Ebene.");

  AddDetail( ({"ebene"}),
	    "Die Ebene ausserhalb des Tempels ist schon fast zugewachsen.");

  AddDetail( ({"fenster"}),
	    "Die Fenster haben einen magischen Schimmer."); 
  
  AddDetail( ({"moose","moos","oberflaeche"}), 
            "Das Moos hat sich fast auf dem ganzen Boden ausgebreitet und "
            "bildet eine weiche gruene Oberflaeche.");

  AddDetail( ({"schlingpflanzen","stolperfallen","fallen"}),
	    "Einige Schlingpflanzen am Boden sind gute Stolperfallen.");

  AddDetail( ({"schimmer"}),
	    "Der Schimmer laesst einen Blick in das Innere des Tempels nicht "
            "zu.");

  AddDetail( ({"blick","innere"}), 
            "Eigentlich interessiert es Dich auch gar nicht was im Tempel so "
            "vor sich geht.");

  AddDetail( ({"ranke"}),
	    "Eine Ranke haengt auf den Pfad hinunter.");

  AddDetail( ({"pfad"}),
	    "Du kannst sicher an der Ranke runter klettern, um den Pfad zu "
            "erreichen."); 
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Dschungel.");  
 
  AddSmell( ({"dschungel","baeume"}),
	   "Das liegt sicher an den Baeumen und das Du im Dschungel bist.");

  AddSound(DEFAULT_SOUND, "Du hoerst einige Voegel zwitschern.");

  AddSound( ({"voegel","dschungel"}),
	   "Die Voegel sind irgendwo im Dschungel.");
  
//-----Details Ende-----
  
AddExit("sueden", ROOM "tem1-21");

AddCmd( ({"schwing","schwinge" }), "schwingen" );
AddCmd( ({"kletter", "klettere" }), "klettern" );

}
int schwingen(string str)
{
   notify_fail("Wohin moechtest Du womit schwingen?\n");
   if ( member( ({ "mit liane nach osten","mit liane ueber abgrund" }),str) != -1) 
  {
    write(BS ( "Du greifst eine Liane und schwingst Dich ueber den Abgrund "
               "auf die andere Seite. Du bist froh, dass die Liane gehalten "
               "hat.\n"));
      TP->move(ROOM "tem1-23", M_GO, 
      "sich eine Liane und verschwindet", "schnappt", 
      "schwingt sich mit einer Liane herein");
    return 1;
  }
}
int klettern(string str)
{
   notify_fail("Woran moechtest Du wohin klettern?\n");
   if ( member( ({ "an ranke runter", "an ranke hinunter" }),str) != -1) 
  {
    write( "Du kletterst an der Ranke nach unten und erreichst den Boden.\n");
      TP->move(ROOM "tem27", M_GO, "nach unten", "verschwindet",
      "kommt von Tempel heruntergeklettert");    
    return 1;
  }
}

