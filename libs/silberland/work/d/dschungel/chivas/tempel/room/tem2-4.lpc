// von Chivas 
inherit "std/room";

#include "../def.h"

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Tempel");
  SetProp( P_INT_LONG,
        "Einige blaue Flammen der Fackeln erhellen den Gang. An den Waenden "
        "und an der Decke haengen grosse Spiegel, wodurch der Gang viel "
        "groesser aussieht, als er ist. Am Boden liegen ein paar Sachen "
        "wahllos herum, als ob sie in aller Eile weggeworfen wurden." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"flammen"}), 
            "Die Flammen verstroemen ihr eiskaltes blaues Licht.");

  AddDetail( ({"fackeln"}),
	    "Die Fackeln haengen in ihren Halterungen an den Waenden und "
            "erhellen den Gang.");

  AddDetail( ({"gang","raum"}),
	    "Der Gang ist voller Spiegel und ein ungutes Gefuehl ueberkommt "
            "Dich.");

  AddDetail( ({"waende","waenden"}), 
            "An den Waenden haengen die ueblichen Fackeln und lauter grosse "
            "Spiegel.");

  AddDetail( ({"decke","himmel"}),
	    "Auch an der Decke haengen grosse Spiegel.");

  AddDetail( ({"spiegel"}),
	    "Als Du in die Spiegel schaust, laeuft Dir ein eiskalter Schauer "
            "den Ruecken runter. Du erkennst den ganzen Gang, Deine Ruestung, "
            "Deine Waffe, aber alles schwebt irgendwie in der Luft. Du fehlst. "
            "Du solltest schnell weitergehen, dass ist kein guter Raum."); 
  
  AddDetail( ({"boden"}), 
            "Am Boden liegen einige alte Sachen auf den Steinplatten.");

  AddDetail( ({"sachen"}),
	    "Am Boden liegen ein paar alte Panzer und zerbrochene Klingen. Du "
            "kannst nichts davon mehr gebrauchen.");

  AddDetail( ({"eile"}),
	    "Du willst eigentlich auch schnell hier weg.");

  AddDetail( ({"licht"}), 
            "Das blaue Licht der Fackeln erhellt den Gang ein wenig.");

  AddDetail( ({"halterungen"}),
	    "Die Halterungen, in denen die Fackeln haengen, sind zwar rostig "
            "aber halten.");

  AddDetail( ({"gefuehl"}),
	    "Du hast kein gutes Gefuehl, als Du in die Spiegel schaust."); 
  
  AddDetail( ({"schauer","ruecken"}), 
            "Dieses Gefuehl hattest Du jetzt schon oefter in diesem Tempel.");

  AddDetail( ({"ruestung","waffe","luft","helm","stelle","stellen"}),
	    "Alle Deine Gegenstaende, die Du anhast, scheinen an der richtigen "
            "Stelle zu sein. Nur an den Stellen wo Du Dich selbst sehen "
            "solltest, ist nichts zu sehen. Dein Helm schwebt in der Luft.");

  AddDetail( ({"tempel"}),
	    "Der Tempel mit all seiner Magie beunruhigt Dich doch sehr.");

  AddDetail( ({"magie","beweis"}), 
            "Hier ist viel Magie im Spiel. Die Spiegel sind der beste Beweis "
            "dafuer.");

  AddDetail( ({"spiel"}),
	    "Dieses Spiel sagt Dir nicht besonders zu. Du bist froh, wenn Du "
            "wieder aus dem Tempel heraus bist.");

  AddDetail( ({"panzer"}),
	    "Die Panzer sind verrostet und unbrauchbar."); 
  
  AddDetail( ({"klingen"}), 
            "Die Klingen sind zerbrochen und stumpf.");

  AddDetail( ({"steinplatten","platten"}),
	    "Die Steinplatten sind sehr uninteressant.");

  AddDetail( ({"gegenstaende"}),
	    "Damit ist Deine Ruestung, Deine Waffe, Dein Helm usw. gemeint.");

  AddSmell(DEFAULT_SMELL, "Es riecht nach gar nichts in diesem Gang.");  
 
  AddSound(DEFAULT_SOUND, "Du hoerst nur Dein Herz schlagen, als Du in die "
                          "Spiegel schaust.");

  AddSound( ({"herz"}),
	   "*bumm*bumm*bumm*");
  
//-----Details Ende-----
  
AddExit("norden", ROOM "tem2-5");
AddExit("sueden", ROOM "tem2-3");

}

