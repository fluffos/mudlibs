// von Chivas
inherit "std/room";

#include "../def.h"

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einem Tempel im Dschungel");
  SetProp( P_INT_LONG,
        "Dies ist die suedoestliche Ecke des Tempels. Die Pflanzen, die hier "
        "wachsen, sehen nicht gut aus. Sie haben eine gelbe Farbe und sie "
        "haben sich auch nicht soweit an dieser Stelle am Tempel festgesetzt "
        "wie an anderen Stellen, die Du schon gesehen hast. Anscheinend hat "
        "der Tempel hier noch mehr dunkle Magie gespeichert, wie wo anders auf "
        "dieser Ebene am Tempel. Ausserdem ist ein breiter Riss in Richtung "
        "Norden, ueber den man nicht so einfach gelangt." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 30, ENV_TERRAIN: TT_JUNGLE]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----

  AddDetail( ({"ecke"}), 
            "Du bist nun an der suedoestlichen Ecke des Tempels angekommen. "
            "Du erkennst auch den Pfad, der um den ganzen Tempel herum "
            "fuehrt.");

  AddDetail( ({"tempel","tempels"}),
	    "Du bist auf der ersten Ebene ausserhalb eines Tempels im "
            "Dschungel.");

  AddDetail( ({"pflanzen"}),
	    "Die Graeser und Schlingpflanzen haben eine ungesunde gelbliche "
            "Farbe.");

  AddDetail( ({"farbe","stelle"}), 
            "Die gelbliche Farbe an dieser Stelle zeigt Dir, dass die boese "
            "Magie des Tempels hier wohl noch sehr stark zu sein scheint.");

  AddDetail( ({"stellen"}),
	    "An anderen Stellen sehen die Pflanzen deutlich gesuender aus.");

  AddDetail( ({"magie"}),
	    "Die Magie des Tempels ist hier noch sehr stark. Wie ist es "
            "wohl erst im Tempel."); 
  
  AddDetail( ({"ebene","ebenen"}), 
            "Du bist auf der ersten Ebene. Um auf die anderen Ebenen zu kommen "
            "musst Du wohl den Tempel betreten.");

  AddDetail( ({"riss","loch"}),
	    "Ein breiter Riss ist in Richtung Norden. Das Erdgeschoss ist "
            "trotz der Dunkelheit nicht zu sehen. Du kannst sicher ueber den "
            "Riss springen.");

  AddDetail( ({"richtung","norden"}),
	    "In Richtung Norden ist ein breiter Riss zu erkennen.");

  AddDetail( ({"boden"}), 
            "Am Boden sind ein paar kraenkliche Pflanzen zu sehen und ein "
            "breiter Riss.");

  AddDetail( ({"himmel"}),
	    "Der Himmel ist schoen blau und ein paar Voegel ziehen weit oben "
            "ihre Kreise.");

  AddDetail( ({"pfad"}),
	    "Der Pfad fuehrt um den gesamten Tempel."); 
  
  AddDetail( ({"erdgeschoss","dunkelheit"}), 
            "Das Erdgeschoss ist durch die Dunkelheit nicht zu erkennen.");

  AddDetail( ({"voegel","kreise"}),
	    "Die Voegel sind sehr weit oben. Du kannst nicht erkennen, was "
            "es fuer welche sind.");

  AddDetail( ({"nackenhaare","haare"}),
	    "Deine Haare straeuben sich. ");

  AddDetail( ({"graeser"}), 
            "Die gelblichen Graeser sehen nicht gut aus.");

  AddDetail( ({"schlingpflanzen"}),
	    "Die Schlingpflanzen hatten auch schon einmal eine bessere Farbe.");

  AddDetail( ({"dschungel"}),
	    "Der Dschungel ist an dieser Stelle nicht so nahe an den Tempel "
            "heran gewachsen."); 
  
  AddSmell(DEFAULT_SMELL, "Es riecht wirklich uebel aus dem Riss.");  
 
  AddSmell( ({"riss"}),
	   "Eigentlich stinkt es sogar fuerchterlich.");

  AddSound(DEFAULT_SOUND, "Du hoerst leise Schreie aus dem Riss.");

  AddSound( ({"schreie","riss"}),
	   "Dir straeuben sich saemliche Nackenhaare, als die Schreie "
           "ploetzlich verstummen.");
  
//-----Details Ende-----
  
AddExit("westen", ROOM "tem1-15");

AddCmd( ({"spring","springe" }), "springen" );

}
int springen(string str)
{
   notify_fail("Ueber was moechtest Du springen?\n");
   if ( member( ({ "ueber loch","ueber riss" }),str) != -1) 
  {
    write(BS ( "Du springst ueber das Loch auf die andere Seite. Beinahe "
               "haette Deine Sprungkraft nicht gereicht. Du hast nochmal "
               "Glueck gehabt.\n"));
     TP->move(ROOM "tem1-13", M_GO,
     "ueber das Loch und verschwindet", "spring", "springt herein");
    return 1;
  }
}

