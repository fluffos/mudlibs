// von Chivas
inherit "std/room";

#include "../def.h"

void create()
	
{
  ::create();


  SetProp( P_INT_SHORT, "Auf einem Dschungelpfad");
  SetProp( P_INT_LONG,
        "Der Dschungel zeigt sich in seiner ganzen Pracht. Links und Rechts "
        "des Weges stehen atemberaubende Urwaldriesen und am Boden bluehen "
	"verschiedene Orchideen in allen Farben des Regenbogens. Waere es "
        "nicht so schwuel und heiss, waere es sicher ein schoener Ort zum "
        "Verweilen." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 30, ENV_TERRAIN: TT_JUNGLE]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  
  AddDetail( ({"Dschungel"}), 
            "Der Dschungel besteht aus lauter grossen Baeumen, "
            "Schlingpflanzen, Blumen und einem grossen Durcheinander "
            "der unterschiedlichsten Pflanzen. An ein Durchkommen ist da "
            "nicht zu denken.");

  AddDetail( ({"pracht"}),
	    "Es sind ueberall die unterschiedlichen Farben zu sehen.");

  AddDetail( ({"links","rechts"}),
	    "Das ist eine Richtungsangabe.");

  AddDetail( ({"weg","weges"}), 
            "Du befindest Dich auf einem Weg im tiefen Dschungel.");

  AddDetail( ({"urwald"}),
	    "Das ist ein anderes Wort fuer Dschungel.");

  AddDetail( ({"urwaldriesen","riesen"}),
	    "Die Baeume sind riesig. Von dort oben hat man sicher eine gute "
            "Aussicht."); 
  
  AddDetail( ({"boden"}), 
            "Am Boden sind allerlei Pflanzen und wunderschoene Orchideen.");

  AddDetail( ({"orchideen"}),
	    "Die Orchideen sehen wunderschoen aus und riechen herrlich.");

  AddDetail( ({"farbe","farben"}),
	    "Die Farben gefallen Dir sehr und es sieht einfach toll aus.");

  AddDetail( ({"regenbogen","regenbogens","sinne"}), 
            "Einen Regenbogen gibt es hier momentan nicht. Nur im bildlichen "
            "Sinne.");

  AddDetail( ({"ort","verweilen"}),
	    "Wenn es nicht so heiss und schwuel waere, koennte man es hier "
            "sicher aushalten.");

  AddDetail( ({"himmel"}),
	    "Der Himmel ist durch das Blaetterdach kaum zu erkennen."); 
  
  AddDetail( ({"blaetterdach","dach"}), 
            "Das Blaetterdach der grossen Baeume ist fast undurchdringlich und "
            "laesst kaum Licht hindurch.");

  AddDetail( ({"blaetter"}),
	    "Die Blaetter der Baeume und Pflanzen um Dich herum versperren die "
            "Sicht in alle Richtungen.");

  AddDetail( ({"richtungsangabe","angabe","gnom","detail","wort"}),
	    "Dieses Detail wurde an einen Gnom vermietet.");

  AddDetail( ({"aussicht"}), 
            "Du hast von hier aus keine gute Aussicht. Vielleicht kannst Du "
            "an den Schlingpflanzen hochklettern.");

  AddDetail( ({"richtung","richtungen","seiten"}),
	    "Du kannst nur dem Weg mit Deinem Blick folgen. Zu beiden Seiten "
            "ist der Blick durch die Baeume und Pflanzen versperrt.");

  AddDetail( ({"blick"}),
	    "Du siehst, dass der Weg weiter nach Sueden fuehrt. "); 
  
  AddDetail( ({"schlingpflanzen","schlingpflanze"}), 
            "Dicke Schlingpflanzen haengen von den grossen Baeumen herunter.");

  AddDetail( ({"baeume"}),
	    "Die Baeume sind richtige Urwaldriesen.");

  AddDetail( ({"pflanzen","ahnung"}),
	    "Hier im Dschungel gibt es unzaehlige verschiedene Arten von "
            "Pflanzen. Du hast keine Ahnung, wie sie alle heissen.");

  AddDetail( ({"blumen"}), 
            "Du erkennst verschiedene Orchideen.");

  AddDetail( ({"durcheinander"}),
	    "Viele Pflanzen zwingen dem Weg seine Richtung auf.");

  AddDetail( ({"durchkommen","moeglichkeit"}),
	    "Es gibt keine Moeglichkeit vom Weg abzuweichen."); 
  
  AddDetail( ({"licht","lichtverhaeltnisse"}), 
            "Die Lichtverhaeltnisse sind nicht sehr gut, da das "
            "Blaetterdach kaum Licht durchlaesst.");

  AddDetail( ({"arten"}),
	    "Du beschliesst Dich demnaechst einmal darueber zu informieren.");

  AddDetail( ({"sicht"}),
	    "Da die Pflanzen sehr dicht um Dich herum stehen, ist die Sicht "
            "nicht die Beste.");

  AddDetail( ({"beste"}), 
            "Vielleicht hast Du irgendwo anders eine bessere Aussicht.");

  AddSmell(DEFAULT_SMELL, "Die Orchideen duften herrlich.");  
 
  AddSmell( ({"orchideen"}),
	   "Du riechst an den Orchideen und fuehlst Dich herrlich.");

  AddSound(DEFAULT_SOUND, "Du hoerst den Wind durch die Blaetter wehen.");

  AddSound( ({"wind"}),
	   "Der Wind bewegt ganz leicht die Blaetter.");
  
//-----Details Ende-----
  
AddExit("nordwesten", ROOM "tem5");
AddExit("sueden", ROOM "tem7");

AddCmd( ({"kletter", "klettere" }), "klettern" );

}
int klettern(string str)
{
   notify_fail("Wohin moechtest Du woran hochklettern?\n");
   if ( member( ({ "an schlingpflanze hoch","an baum hoch","an schlingpflanzen hoch","an schlingpflanzen rauf" }),str) != -1) 
  {
    write(BS ( "Du kletterst wie ein Verrueckter an den Schlingpflanzen hoch "
               "und erreichst nach einiger Zeit die Spitze des Urwaldriesen.\n"));
        TP->move(ROOM "temb", M_GO,
      "sich eine Schlingpflanze und verschwindet", "schnappt",
      "kommt von unten heraufgeklettert");
    return 1;
  }
}

