// von Chivas
inherit "std/room";

#include "../def.h"

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Tempel");
  SetProp( P_INT_LONG,
        "Du befindest Dich nun im vierten Abschnitt des Erdgeschosses im "
        "Tempel. Hier ist es absolut dunkel, anscheinend gibt es in dieser "
        "Kammer keine Fackeln. Wenn es so weiter geht, wirst Du bald "
        "verrueckt, da Du komplett die Orientierung verloren hast. Die "
        "vergangenen Abschnitte waren von der Umgebung schon schlimm, "
        "wer weiss, was nun noch alles kommt." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 0 );

  
//-----Details Anfang-----

  
  AddDetail( ({"abschnitt","abschnitte","frage"}), 
            "Du bist nun im vierten Abschnitt des Erdgeschosses. Die Frage ist "
            "wie viele Abschnitte noch folgen werden.");

  AddDetail( ({"erdgeschoss","erdgeschosses"}),
	    "Das Erdgeschoss muss riesig sein. Du warst jetzt schon in so "
            "vielen Gaengen und Kammern, dass es langsam reicht.");

  AddDetail( ({"tempel"}),
	    "Der Tempel scheint wirklich ziemlich gross zu sein.");

  AddDetail( ({"kammer","kammern"}), 
            "Dies ist eine weitere Kammer. Hier scheint nicht viel zu sein.");

  AddDetail( ({"fackeln"}),
	    "Es haengen zwar Fackeln an den Waenden aber sie brennen nicht.");

  AddDetail( ({"orientierung","zeit"}),
	    "Die Orientierung, wo Du Dich im Tempel befindest, hast Du schon "
            "vor langer Zeit verloren."); 
  
  AddDetail( ({"umgebung"}), 
            "Es ist zwar dunkel, aber immerhin hat Dich noch nichts "
            "angegriffen.");

  AddDetail( ({"gaengen","gaenge"}),
	    "Du warst schon in vielen Gaengen.");

  AddDetail( ({"wand","waende","waenden"}),
	    "An den Waenden haengen ein paar Fackeln in den Halterungen, "
            "jedoch sind sie aus. Du fluchst.");

  AddDetail( ({"boden"}), 
            "Der Boden besteht aus grossen Steinplatten.");

  AddDetail( ({"steinplatten","platten"}),
	    "Die Steinplatten bestehen aus Granit und sind sorgfaeltig "
            "verfugt.");

  AddDetail( ({"decke","himmel"}),
	    "An der Decke sind Muster zu erkennen."); 
  
  AddDetail( ({"muster"}), 
            "Die Muster bilden einen Drachen.");

  AddDetail( ({"drachen","drache"}),
	    "Der Drache scheint sich zu bewegen. Er ist sicher magisch. "
            "Du gehst besser schnell weiter, bevor er richtig lebendig wird.");

  AddDetail( ({"fugen","fuge"}),
	    "Die Fugen sind sauber und es ist keine Luecke zu erkennen.");

  AddDetail( ({"granit","stein"}), 
            "Granit ist ein sehr harter Stein.");

  AddDetail( ({"luecke","mal"}),
	    "Ok, ich erklaere es zum x-ten Mal. Keine Luecke heisst, dass hier "
            "wirklich keine Luecke vorhanden ist.");

  AddDetail( ({"nase"}),
	    "Du hast eine ziemlich grosse Nase."); 
  
  AddDetail( ({"halterungen"}), 
            "Die Halterungen bestehen eigentlich mehr aus Rost als aus Eisen, "
            "trotzdem scheinen sie die Fackeln noch halten zu koennen.");

  AddDetail( ({"rost"}),
	    "Der Rost war mal Eisen.");

  AddDetail( ({"eisen"}),
	    "Viel Eisen ist an den Halterungen nicht mehr zu erkennen.");
  
  AddSmell(DEFAULT_SMELL, "Du riechst gar nichts und bist sehr froh darueber "
                          "mal nichts Ekeliges in der Nase zu haben.");  
 
  AddSmell( ({"ekeliges"}),
	   "So etwas gibt es hier nicht, sei froh.");

  AddSound(DEFAULT_SOUND, "Es herrscht absolute Stille.");

  AddSound( ({"stille","brennen","geraeusch"}),
	   "Du hoerst nicht einmal das Brennen von Fackeln. Du hattest Dich "
           "schon so an das Geraeusch gewoehnt.");
  
//-----Details Ende-----
  
AddExit("sueden", ROOM "tem43");

}

