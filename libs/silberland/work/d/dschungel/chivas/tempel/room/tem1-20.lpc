// von Chivas
inherit "std/room";

#include "../def.h"

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einem Tempel im Dschungel");
  SetProp( P_INT_LONG,
        "An dieser Stelle des Tempels sieht der magische Schimmer der sonst "
        "auf den Fenstern liegt viel schwaecher aus. Auch einige Pflanzen "
        "scheinen es gemerkt zu haben und haben sich ins Innere des Tempels "
        "vorgewagt." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 30, ENV_TERRAIN: TT_JUNGLE]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----

  AddDetail( ({"stelle","stellen"}), 
            "Der magische Schimmer, der die Fenster schuetzt, sieht hier viel "
            "schwaecher aus als an anderen Stellen.");

  AddDetail( ({"tempel","tempels"}),
	    "Dies ist ein riesiger Tempel im Dschungel.");

  AddDetail( ({"schimmer","schutz"}),
	    "Der Schimmer ist viel schwaecher. Vielleicht kann man ja in den "
            "Tempel klettern, schliesslich haben es ein paar Schlingpflanzen "
            "ja auch geschafft.");

  AddDetail( ({"fenster","fenstern"}), 
            "Die Fenster sind mit einem magischen Schimmer ueberzogen, der "
            "jedoch viel schwaecher aussieht als an anderen Stellen.");

  AddDetail( ({"pflanzen"}),
	    "Ein paar Schlingpflanzen haben den schwaecheren Schutz genutzt "
            "und haben sich in den Tempel vorgewagt.");

  AddDetail( ({"innere"}),
	    "Du kannst das Innere des Tempels nur erahnen. Der Schutz ist "
            "zwar eindeutig schwaecher, aber immer noch vorhanden."); 
  
  AddDetail( ({"aussenmauer","mauer"}),
	    "An der Aussenmauer haengen einige Schlingpflanzen und man sieht "
            "die ueblichen Fenster.");

  AddDetail( ({"boden"}),
	    "Am Boden sind einige Moose und Schlingpflanzen zu sehen.");

  AddDetail( ({"himmel"}), 
            "Der Himmel ist schoen blau.");

  AddDetail( ({"moose","moos"}),
	    "Das Moos ist angenehm weich.");

  AddDetail( ({"schlingpflanzen"}),
	    "Einige Schlingpflanzen haben sich von der Aussenmauer in das "
            "Innere des Tempels vorgewagt."); 
  
  AddDetail( ({"dschungel"}), 
            "Du befindest Dich mitten im Dschungel auf einem Tempel.");

  AddDetail( ({"ohr","ohren"}),
            (["elf": "Du hast spitze Ohren.",
              0: "Du hast grosse Ohren."]) );

  AddSmell(DEFAULT_SMELL, "Es riecht ein wenig nach Schimmel.");  
 
  AddSmell( ({"schimmel","geruch","tempel"}),
	   "Der Geruch dringt aus dem Tempel, da der magische Schimmer hier "
           "schwaecher zu sein scheint.");

  AddSound(DEFAULT_SOUND, "Du hoerst ein paar merkwuerdige Geraeusche.");

  AddSound( ({"geraeusche"}),
	   "Die Geraeusche dringen aus dem Tempel an Dein Ohr.");
  
  AddSound( ({"tempel"}),
		"Du kannst nicht genau definieren was Du hoerst. Es klingt "
                "auf jedenfall nicht gut.");

//-----Details Ende-----
  
AddExit("sueden", ROOM "tem1-19");
AddExit("norden", ROOM "tem1-21");

AddCmd( ({"kletter" }), "klettern" );

}
int klettern(string str)
{
   notify_fail("Wo moechtest Du reinklettern?\n");
   if ( member( ({ "tempel","in tempel","durch fenster in tempel","durch fenster" }),str) != -1) 
  {
    write(BS ( "Du probierst durch das Fenster in den Tempel zu klettern, aber "
               "ein schmerzender Blitz von der magischen Barriere durchfaehrt "
               "Dich. Anscheinend ist der magische Schutz noch zu gross, um "
               "von aussen nach innen vorzudringen. Der einzige Weg in den "
               "Tempel scheint der Eingang zu sein.\n"));
    say( CAP_TPN+" wird von einem kleinen Blitz getroffen und schreit vor "
             "Schmerzen.\n");
    TP->AddHp(-30);
    return 1;
  }
}

