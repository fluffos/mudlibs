// von Chivas
inherit "std/room";

#include "../def.h"

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Tempel");
  SetProp( P_INT_LONG,
        "Du fuehlst irgendwie, dass sich das Labyrinth im Erdgeschoss des "
        "Tempels dem Ende zuneigt. Die Waende sind ein wenig blutbefleckt "
	"und einige Knochen und Schaedel liegen herum. Aber das beunruhigt "
        "Dich nicht mehr, Du hast Dich an diesen Anblick gewoehnt.");
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );
  
//-----Details Anfang-----
  
  AddDetail( ({"labyrinth"}), 
            "Falls das Labyrinth wirklich bald zu Ende ist, bist Du traurig, "
            "da es Dir sehr gefallen hat.");

  AddDetail( ({"erdgeschoss"}),
	    "Das Erdgeschoss ist wirklich riesig.");

  AddDetail( ({"tempels","tempel"}),
	    "Du bist schon sehr weit in diesem Tempel vorgedrungen.");

  AddDetail( ({"ende"}), 
            "Das Ende kommt manchmal zu schnell. Vor allem hier im Silberland "
            "ereilt einen das Ende schon mal ganz ploetzlich.");

  AddDetail( ({"waende","waenden","wand"}),
	    "An den Waenden haengen die ueblichen Halterungen und es sind "
            "einige grosse und kleine schwarze Flecken zu erkennen.");

  AddDetail( ({"blut","flecken"}),
	    "Die schwarzen grossen Flecken an den Waenden sind getrocknetes "
            "Blut."); 
  
  AddDetail( ({"knochen"}), 
            "An den Knochen kann man einige Spuren erkennen.");

  AddDetail( ({"schaedel"}),
	    "Die Schaedel sehen aus wie die von Menschen oder Elfen.");

  AddDetail( ({"anblick","normalitaet"}),
	    "Dieser Anblick ist fuer Dich schon Normalitaet.");

  AddDetail( ({"boden"}), 
            "Am Boden liegen einige Knochen und Schaedel herum. Sie sehen ein "
            "wenig abgenagt aus.");

  AddDetail( ({"decke","himmel"}),
	    "Die Decke ist schmucklos.");

  AddDetail( ({"silberland"}),
	    "Du befindest Dich im Silberland und findest es hier toll."); 
  
  AddDetail( ({"spuren"}), 
            "Du erkennst Spuren von Zaehnen auf den Knochen.");

  AddDetail( ({"menschen","elfen"}),
	    "Dies sind zwei Rassen im Silberland.");

  AddDetail( ({"rassen"}),
	    "Es gibt auch noch andere Rassen, aber die Schaedel die hier "
            "liegen gehoeren nur Menschen oder Elfen.");

  AddDetail( ({"zaehnen","zaehne"}), 
            "Die Zaehne, die die Knochen abgenagt haben muessen sehr spitz "
            "gewesen sein. Du entdeckst ploetzlich einen grossen Zahn, der "
            "noch in einem der Knochen steckt.");

  AddDetail( ({"zahn"}),
	    "Der Zahn ist sehr gross, das Tier oder die Kreatur, die diesen "
            "Zahn verloren hat, muss groesser als Du gewesen sein.");

  AddDetail( ({"tier","kreatur"}),
	    "Du willst der Kreatur nicht begegnen."); 
  
  AddDetail( ({"fleisch"}), 
            "Es ist kein Fleisch mehr an den Knochen.");

  AddDetail( ({"halterungen"}),
	    "In den Halterungen stecken die Fackeln, die die Kammer erhellen.");

  AddDetail( ({"fackeln","fackel"}),
	    "Die Fackeln brennen in ihren magischen gruenen Licht.");

  AddDetail( ({"licht"}), 
            "Es ist zwar immer noch duester, aber Du kannst genug sehen.");

  AddDetail( ({"kammer","kammern"}),
	    "Die Kammer ist genau wie die anderen Kammern im Tempel. Ein "
            "paar Fackeln, Knochen und Schaedel, also alles ganz normal.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht ein bisschen nach alten Knochen.");  
 
  AddSmell( ({"knochen"}),
	   "Die Knochen wurden sicher schlimmer riechen, wenn noch etwas "
           "Fleisch an ihnen waere.");

  AddSound(DEFAULT_SOUND, "Du hoerst einen leichten Windzug durch die Kammer "
                          "wehen.");

  AddSound( ({"windzug"}),
	   "Du kannst nicht genau herausfinden, woher der Windzug kommt.");
  
//-----Details Ende-----
  
AddExit("norden", ROOM "tem52");
AddExit("nordosten", ROOM "tem47");
AddExit("nordwesten", ROOM "tem47");
AddExit("osten", ROOM "tem47");
AddExit("westen", ROOM "tem50");
AddExit("suedosten", ROOM "tem47");
AddExit("suedwesten", ROOM "tem47");
AddExit("sueden", ROOM "tem47");

}

