// von Chivas
inherit "std/room";

#include "../def.h"

int loeweda;

void create()
	
{
  ::create();

  loeweda=1; 

  SetProp( P_INT_SHORT, "Vor einem unheimlichen Tempel");
  SetProp( P_INT_LONG,
        "Mitten im Sonnenlicht vor Dir steht ein grosser verfallener Tempel. "
        "Zu seiner Bluetezeit muss er furchteinfloessend gewirkt haben, da man "
	"immer noch die schaurigen Fresken und Malereien am Eingangstor "
        "erkennen kann. Auch die Statuen, die auf den verschiedenen Ebenen "
        "des Tempels stehen, verstaerken den Eindruck, dass hier in der "
        "Vergangenheit schlimme Sachen geschehen sein muessen. \n"
        "Nach Westen und Osten kann man anscheinend um den Tempel herum gehen. "
        "In Richtung Sueden besteht die Moeglichkeit den unheimlichen Tempel "
        "durch ein Tor zu betreten, dass von zwei riesigen Steinloewen "
        "flankiert wird. Ausserdem steht dort ein verwittertes Schild. Es "
        "scheint ein Warnhinweis zu sein." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 30, ENV_TERRAIN: TT_JUNGLE]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  
  AddDetail( ({"boden"}), 
            "Der Boden ist mit Blaettern der Baeume bedeckt. Ab und zu sieht "
            "man auch ein paar Graeser und Blumen. Ausserdem steht vor dem "
            "Tempel ein grosses Schild.");

  AddDetail( ({"graeser","gras"}),
	    "Die Graeser stehen selbst auf dem Pfad recht hoch und hier "
            "vor dem Tempel auch. Aber wer sollte hier schon darauf achten, "
            "dass der Pfad oder der Tempel nicht zuwaechst.");

  AddDetail( ({"himmel","firmament"}),
	    "Der Himmel ist schoen blau und die Sonne steht senkrecht am "
            "Firmament.");

  AddDetail( ({"sonnenlicht","licht"}),
	    "Das Sonnenlicht strahlt Dich an, da Du den Dschungel nun hinter "
            "Dir gelassen hast.");

  AddDetail( ({"sonne"}), 
            "Die Sonne steht senkrecht am Himmel und waermt Dich.");

  AddDetail( ({"tempel","tempels","angst"}),
	    "Der Tempel ist uralt und besteht aus riesengrossen Quadern, die "
            "anscheinend von weit her herangebracht wurden. Der Tempel floesst "
            "Dir ein wenig Angst ein. Vor "
            "allem die grossen boesartig aussehenden Statuen auf den "
            "verschiedenen Ebenen schauen Dich grimmig an. Vor dem Tor des "
            "Tempels stehen zwei grosse Steinloewen, die das Eingangstor zu "
            "bewachen scheinen");

  AddDetail( ({"bluetezeit","zeit"}),
	    "Die Bluetezeit des Tempels ist schon laengere Zeit vorbei. "
            "Ueberall haben sich Schlingpflanzen auf dem Tempel niedergelassen."); 
  
  AddDetail( ({"bluete","blueten"}), 
            "Die verschiedenen Blumen des Dschungels haben Blueten.");

  AddDetail( ({"blumen","rand"}),
	    "Es wachsen verschiedene Blumenarten am Rand des Dschungels und auf "
            "dem Boden.");

  AddDetail( ({"dschungel","wand"}),
	    "Der Dschungel ist undurchdringlich hinter Dir, der einzige Weg "
            "ist der Pfad ueber den Du hier her gekommen bist. Die Baeume und "
            "und andere Pflanzen bilden geradezu eine gruene Wand.");

  AddDetail( ({"fresken"}), 
            "Die Fresken am Tor stellen furchtbare Greueltaten da. Es ist "
            "nicht gerade aufmunternd den Tempel zu betreten.");

  AddDetail( ({"malereien"}),
	    "Die Malereien stellen Opferungen im Tempel dar. Du bist froh, "
            "dass die Malereien schon recht stark verblasst sind.");

  AddDetail( ({"opferungen","greueltaten"}), 
            "Beim Beschreiben dieses Details wurde dem Magier so uebel, dass "
            "er seine Beschreibung wieder loeschte. *wuerg*");

  AddDetail( ({"eingangstor","tor","eingang"}),
	    "Das Eingangstor ist riesengross. An ihm erkennst Du lauter "
            "Fresken und Malereien, die Dich ein wenig beunruhigen. Vor dem "
            "Tor sitzen zwei Steinloewen, die das Tor zu bewachen scheinen."); 
  
  AddDetail( ({"statue","statuen"}), 
            "Ueberall auf den verschiedenen Ebenen des Tempels stehen grosse "
            "Statuen, die fast lebensecht aussehen.");

  AddDetail( ({"ebenen"}),
	    "Der Tempel hat verschiedene Ebenen. Insgesamt scheinen es neben "
            "dem Erdgeschoss weitere drei Ebenen mit einer Spitze zu sein. "
            "Draussen auf den Ebenen stehen grosse Statuen.");

  AddDetail( ({"erdgeschoss","innere"}),
	    "Das Erdgeschoss scheint keinerlei Fenster zu haben. Es ist "
            "sicher recht duester im Erdgeschoss. Auf den anderen Ebenen "
            "scheinen jedenfalls grosse Oeffnungen zu sein, durch die die "
            "Sonne das Innere erhellen kann.");

  AddDetail( ({"oeffnungen","fenster"}),
	    "Auf den oberen Ebenen scheinen Oeffnungen zu sein, die Fenstern "
            "recht aehnlich sind.");

  AddDetail( ({"westen","osten"}),
	    "Nach Westen und Osten kannst Du anscheinend um den Tempel herum "
            "gehen.");

  AddDetail( ({"pfad","weg"}), 
            "Der Pfad fuehrt entweder zurueck in den Dschungel oder um den "
            "Tempel herum.");

  AddDetail( ({"richtung"}), 
            "Du kannst in vier Richtungen zu gehen.");

  AddDetail( ({"sueden"}),
	    "Nach Sueden kannst Du den Tempel betreten. Ob Du es wirklich "
            "machen solltest, sollte gut ueberlegt sein.");

  AddDetail( ({"moeglichkeit","idee"}),
	    "Es besteht die Moeglichkeit den Tempel im Sueden zu betreten. "
            "Du weisst jedoch nicht, ob diese Moeglichkeit die richtige "
            "Idee ist."); 
  
  AddDetail( ({"steinloewen","loewen"}), 
            "Die Steinloewen sitzen neben dem Tor. Es macht den Anschein, "
            "dass die Loewen den Eingang bewachen und jeden Deiner Schritte "
            "genau beobachten, was ja nicht moeglich ist, da sie ja aus Stein "
            "bestehen. Es sieht fast so aus, als ob sie von den Dschungelelfen "
            "plaziert wurden um den Tempel zu bewachen.");

  AddDetail( ({"schild","warnhinweis","hinweis"}),
	    "Du kannst das Schild lesen.");

  AddDetail( ({"eindruck","vergangenheit","sachen"}),
	    "Das willst Du eigentlich gar nicht so genau wissen.");

  AddDetail( ({"pflanzen"}), 
            "Im Dschungel um den Tempel herum gibt es tausende von "
            "verschiedenen Pflanzen.");

  AddDetail( ({"baeume","blick"}),
	    "Die grossen Baeume des Dschungels liegen hinter Dir und Du hast "
            "nun einen freien Blick auf den Tempel.");

  AddDetail( ({"blaetter"}),
	    "Einige Blaetter, die von den Baeumen abgefallen sind, liegen auf "
            "dem Boden und verrotten langsam."); 
  
  AddDetail( ({"quadern","arbeit","brocken"}), 
            "Der Tempel ist aus riesengrossen Quadern erbaut worden. Es muss "
            "eine schwere Arbeit gewesen sein, die grossen Brocken hier her "
            "zu bringen.");

  AddDetail( ({"spitze"}),
	    "Die Spitze funkelt in der Sonne. Es scheint als ob sie vergoldet "
            "ist. Komischerweise dringt Qualm aus der Spitze, als ob dort "
            "oben ein Feuer brennt.");

  AddDetail( ({"qualm","feuer","anschein"}),
	    "Anscheinend ist der Tempel doch nicht so verlassen, wie Du auf "
            "den ersten Anschein gedacht hast. Da oben muss Irgendetwas sein.");

  AddDetail( ({"irgendetwas","etwas"}), 
            "Das musst Du wohl rausfinden, wenn Du Dich traust.");

  AddDetail( ({"dschungelelfen","elfen","boese"}), 
            "Die Dschungelelfen haben damals das Boese aus dem Tempel "
            "vertrieben. Ob es wieder da ist, weisst Du nicht.");

  AddDetail( ({"blumenarten","arten","orchideen"}), 
            "Verschiedene Arten von Orchideen. Sie sehen sehr huebsch aus.");

  AddDetail( ({"schlingpflanzen","beweis"}),
	    "Die Schlingpflanzen haengen von den Baeumen herunter und auch "
            "vom Tempel. Es ist der Beweis, dass der Dschungel langsam den "
            "Tempel ueberwuchert.");

  AddDetail( ({"schritte","stein","detail","silberbank","ihnen","beschreiben","details","magier","beschreibung"}),
	    "Dieses Detail wird Ihnen von der Silberbank praesentiert."); 
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Dschungel.");  
 
  AddSmell( ({"dschungel","pflanzen"}),
	   "Du riechst die verschiedenen Pflanzen im Dschungel.");

  AddSound(DEFAULT_SOUND, "Du hoerst lauter Voegel im Dschungel zwitschern.");

  AddSound( ({"voegel"}),
	   "*tschip*triller*grugru*");
  
  AddReadDetail( ({"schild","warnhinweis","hinweis","warnung"}),
		"I-------------------------------------------------------I\n"
                "I                                                       I\n"
                "I                  W A R N U N G                        I\n"
                "I                                                       I\n"
                "I     Dies ist der unheilige Tempel 'Iaun en Sereg',    I\n"
                "I     der vor Dekaden den Dienern des Blutes als        I\n"
                "I     Opferstaette diente.                              I\n"
                "I                                                       I\n"
                "I     Wir, die Dschungelelfen vertrieben das Boese      I\n"
                "I     aus dem Tempel, jedoch herrscht immer noch        I\n"
                "I     blutige und boesartige Magie im Tempel.           I\n"
                "I     Also Abenteurer sei gewarnt, wenn Du den Schritt  I\n"
                "I     wagst, keiner mag zu erahnen, was Dir begegnet.   I\n"
                "I                                                       I\n"
                "I-------------------------------------------------------I\n");

//-----Details Ende-----
  
AddExit("norden", ROOM "tem7");
AddExit("westen", ROOM "tem10");
AddExit("osten", ROOM "tem11");
AddExit( "sueden", ([
   EX_TESTFUNC: "testfunc1",
   EX_DEST  : ROOM "tem28",
   EXG_ID   : "steinloewe",
   EXG_PLMSG: "Ein Steinloewe laesst Dich nicht vorbei!\n",
   EXG_RMMSG: "Ein Steinloewe laesst @wen@ nicht in den Tempel.\n" ]) );

}
void reset()
{
  ::reset();
  loeweda=1;
}


int testfunc1() {
    if (TP->QueryProp(P_LEVEL) < 20) {
    write("Du traust Dich noch nicht weiter.\n");
    return 0;
    }
    else if (loeweda == 0)
      return 1;
      
  loeweda=0;
  clone_object(NPC "steinloewe")->move(TO,M_GO|M_NOCHECK,"", "", "springt herein");
  clone_object(NPC "steinloewe2")->move(TO,M_GO|M_NOCHECK,"", "", "springt herein");
  return 0;    
}

