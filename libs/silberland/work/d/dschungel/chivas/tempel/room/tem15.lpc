// von Chivas
inherit "std/room";

#include "../def.h"

void create()
	
{
  ::create();


  SetProp( P_INT_SHORT, "An einem Tempel im Dschungel");
  SetProp( P_INT_LONG,
        "Der Pfad fuehrt weiter um den Tempel herum. Es gibt keine Moeglichkeit "
        "den Weg zu verlassen, da im Westen der Tempel ist und der Dschungel "
	"im Osten undurchdringlich. Auch der Pfad ist teilweise schon "
        "zugewachsen und man kommt nur mit Muehe voran. " );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 30, ENV_TERRAIN: TT_JUNGLE]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  
  AddDetail( ({"pfad","weg"}), 
            "Der Pfad fuehrt weiter um den Tempel, jedoch ist der Weg schon "
            "in einem schlechten Zustand und kaum noch zu sehen.");

  AddDetail( ({"tempel","westen","tempels"}),
	    "Der Tempel ist zugewachsen, was Dich ueberhaupt nicht stoert, da "
            "Du ansonsten wieder nur scheussliche Sachen sehen wuerdest.");

  AddDetail( ({"moeglichkeit"}),
	    "Du kannst nur auf dem Pfad bleiben.");

  AddDetail( ({"dschungel","osten"}), 
            "Der Dschungel ist dicht. Es gibt keine Moeglichkeit den Pfad zu "
            "verlassen.");

  AddDetail( ({"muehe","vorankommen"}),
	    "Das Vorankommen ist schwer, da der Pfad schon sehr zugewachsen "
            "ist.");

  AddDetail( ({"rande","rand","blumen"}),
	    "Am Rand wachsen einige Orchideen."); 
  
  AddDetail( ({"orchideen"}), 
            "Die Orchideen strahlen in verschiedenen Farben.");

  AddDetail( ({"farben"}),
	    "Sie strahlen in allen Farben des Regenbogens.");

  AddDetail( ({"regenbogens","regenbogen","naehe"}),
	    "Es ist schoen so viele Farben in der Naehe eines so schrecklichen "
            "Tempels zu sehen.");

  AddDetail( ({"sachen"}), 
            "Du kannst ja nichts sehen, da er zugewachsen ist.");

  AddDetail( ({"zustand"}),
	    "Es ist sicher schon lange keiner mehr hier gewesen.");

  AddDetail( ({"wind","brise"}),
	    "Ein leichter Wind weht."); 
  
  AddDetail( ({"boden"}), 
            "Der Boden ist mit vielen Pflanzen zugewachsen.");

  AddDetail( ({"pflanzen"}),
	    "Durch die Pflanzen am Boden ist der Pfad kaum noch zu erkennen.");

  AddDetail( ({"himmel"}),
	    "Der Himmel ist blau, aber durch das dichte Blaetterdach kaum zu "
            "sehen.");

  AddDetail( ({"blaetterdach"}), 
            "Das dichte Blaetterdach bildet fast schon eine Art Decke.");

  AddDetail( ({"art","decke"}),
	    "Dies war nur ein Beispiel, um es zu veranschaulichen.");

  AddDetail( ({"beispiel"}),
	    "Du untersuchst auch wirklich alles."); 
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Blumen.");  
 
  AddSmell( ({"blumen","orchideen"}),
	   "Die Orchideen am Rande des Dschungels duften herrlich.");

  AddSound(DEFAULT_SOUND, "Du hoerst einen leichten Windzug.");

  AddSound( ({"windzug"}),
	   "Eine leichte Brise weht durch die Aeste und bringt sie zum "
           "Knarren.");
  
  AddSound( ({"knarren","aeste"}),
		"Die Aeste bewegen sich leicht im Wind.");

//-----Details Ende-----
  
AddExit("norden", ROOM "tem14");
AddExit("sueden", ROOM "tem16");

}

