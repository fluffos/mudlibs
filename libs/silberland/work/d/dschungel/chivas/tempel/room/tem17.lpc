// von Chivas
inherit "std/room";

#include "../def.h"

int anzahl;

void create()
	
{
  ::create();

  anzahl = 5;

  SetProp( P_INT_SHORT, "An einem Tempel im Dschungel");
  SetProp( P_INT_LONG,
        "Dies ist die suedoestliche Ecke des Tempels. Auch hier sind "
        "graessliche Statuen zu erkennen, die jedoch teilweise schon von "
	"Pflanzen zugewachsen sind. Der Weg fuehrt nach Norden und "
        "Suedwesten weiter um den unheimlichen Tempel herum. " );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 30, ENV_TERRAIN: TT_JUNGLE]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----

  AddDetail( ({"ecke","norden","suedwesten"}), 
            "Du stehst an der suedoestlichen Ecke des Tempels. Du kannst "
            "jetzt nach Norden Richtung Eingang gehen oder der Tempel "
            "umrunden.");

  AddDetail( ({"tempel","tempels"}),
	    "Der Tempel ragt neben Dir in die Hoehe.");

  AddDetail( ({"statuen","vorbild"}),
	    "Direkt an der Ecke an die Mauer des Tempels gelehnt stehen "
            "zwei grosse graessliche Statuen. Als Vorbild dienten anscheinend "
            "Orks.");

  AddDetail( ({"pflanzen"}), 
            "Einige Flechten und Moose haben sich auf den Mauern und Statuen "
            "nieder gelassen. Ansonsten siehst Du sehr viele andere Pflanzen "
            "im Dschungel. Einige grosse Baeume und Straeucher wachsen direkt "
            "am Pfad und zwaengen Dir die Richtung auf.");

  AddDetail( ({"norden","suedwesten"}),
	    "Dies sind zwei Richtungen in die Du gehen kannst.");

  AddDetail( ({"weg","pfad"}),
	    "Der Pfad ist gut zu erkennen und Du kommst gut voran."); 
  
  AddDetail( ({"boden"}), 
            "Am Boden liegen ein paar Steine und Blaetter und einige kleinere "
            "Pflanzen wachsen auf ihm.");

  AddDetail( ({"himmel"}),
	    "Der Himmel ist blau aber durch das Blaetterdach kaum zu sehen.");

  AddDetail( ({"wegrand","rand"}),
	    "Am Wegrand stehen einige kleine Buesche.");

  AddDetail( ({"buesche"}),
	    "Einer der Buesche faellt Dir besonders auf. Es ist ein kleiner "
            "rundlicher Busch.");

  AddDetail( ({"busch"}),
	    "An dem kleinen Busch haengen saftige rote Beeren."); 
  
  AddDetail( ({"beeren"}), 
            "Ob man die Beeren pfluecken und essen kann?");

  AddDetail( ({"eingang"}),
	    "Der Eingang ist nordwestlich von hier.");

  AddDetail( ({"hoehe"}),
	    "Der Tempel hat mehrere Ebenen.");

  AddDetail( ({"ebenen"}), 
            "Es sind genau drei Ebenen und eine Tempelspitze zu erkennen.");

  AddDetail( ({"tempelspitze","spitze"}),
	    "Aus der Tempelspitze dringt Qualm.");

  AddDetail( ({"qualm"}),
	    "Du bist sehr neugierig und willst wissen, was da oben los ist."); 
  
  AddDetail( ({"orks"}), 
            "Die Statuen der beiden Orks sind schon ein wenig von den "
            "Pflanzen des Dschungels zugewachsen. Sie sehen finster aus, als "
            "ob sie leben wuerden.");

  AddDetail( ({"mauer","mauern"}),
	    "Die Mauern sind wie die Statuen von Pflanzen bewachsen.");

  AddDetail( ({"baeume","baeumen"}),
	    "Die Baeume stehen sehr dicht und sind mit Schlingpflanzen "
            "zugewachsen.");

  AddDetail( ({"straeucher","straeuchern"}), 
            "Neben den Straeuchern stehen noch andere Pflanzen am Wegrand.");

  AddDetail( ({"richtung","richtungen"}),
	    "Es gibt nur zwei Richtungen, in die Du gehen kannst.");

  AddDetail( ({"schlingpflanzen"}),
	    "Die Schlingpflanzen haengen von den Baeumen."); 
  
  AddDetail( ({"steine"}), 
            "Die Steine sind sehr uninteressant.");

  AddDetail( ({"blaetter"}),
	    "Die Blaetter sind sicher von den Baeumen herunter gefallen. Sie "
            "sind angenehm weich, um darauf zu gehen.");

  AddDetail( ({"blaetterdach","dach"}),
	    "Das Blaetterdach ist sehr dicht.");

  AddDetail( ({"flechten","moose"}), 
            "Einige Flechten und Moose haben sich an der Mauer und an den "
            "Statuen festgesetzt.");

  AddDetail( ({"dschungel"}),
	    "Der Dschungel ist voll von Pflanzen. Unglaublich.");

  AddSmell(DEFAULT_SMELL, "Es riecht nach Dschungel.");  
 
  AddSmell( ({"dschungel","pflanzen"}),
	   "Es riecht dschungelig, also nach Pflanzen.");

  AddSound(DEFAULT_SOUND, "Du hoerst wie der Wind durch die Baeume weht.");

  AddSound( ({"wind"}),
	   "*rausch*rausch*rausch*");
  
//-----Details Ende-----
  
AddExit("norden", ROOM "tem16");
AddExit("suedwesten", ROOM "tem18");

AddCmd( ({"pflueck", "pfluecke" }), "pfluecken" );

}
void reset()
{
  ::reset();
  anzahl=5;
}
int pfluecken(string str)
{
   notify_fail("Was moechtest Du pfluecken?\n");
   if ( member( ({ "beere", "beeren" }),str) != -1) 
  { 
    write(BS( "Du pflueckst eine Beere und sie schmeckt gut."));
    say(BS( TPN+" pflueckt eine Beere und schlingt sie schnell herunter."));
    if ( anzahl )
    {
      TP -> eat_food(2);
      TP -> heal_self(5+random(5));
      anzahl--;
    }
    return 1;
  }
}

