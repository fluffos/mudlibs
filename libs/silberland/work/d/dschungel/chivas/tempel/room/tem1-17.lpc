// von Chivas
inherit "std/room";

#include "../def.h"

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einem Tempel im Dschungel");
  SetProp( P_INT_LONG,
        "Die Aussenwand des Tempels ist zugewachsen. Auf dem Boden "
        "wachsen Moose und einige Blumen. Verschiedene Ranken sind am Tempel "
        "weiter hochgewachsen und erobern den Tempel zurueck. Ansonsten kannst "
        "Du von hier oben den unten liegenden Pfad erkennen." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 30, ENV_TERRAIN: TT_JUNGLE]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----

  AddDetail( ({"aussenwand","wand"}), 
            "Die Aussenwand des Tempels ist zugewachsen. Lauter Ranken "
            "haengen an der Wand. Nur ab und zu kann man noch die Mauer "
            "erkennen.");

  AddDetail( ({"tempels","tempel"}),
	    "Du befindest Dich ausserhalb des Tempels auf der ersten Ebene.");

  AddDetail( ({"boden"}),
	    "Am Boden wachsen verschiedene Pflanzen. Du erkennst einige "
            "Blumen und auch verschiedene Arten von Moos.");

  AddDetail( ({"moose","moos","arten","moosen"}), 
            "Verschiedene Arten von gelben und gruenen Moosen wachsen auf dem "
            "Boden.");

  AddDetail( ({"blumen"}),
	    "Du erkennst einige Orchideen und andere Blumen, die Du nicht "
            "kennst.");

  AddDetail( ({"ranken"}),
	    "Die Ranken bedecken fasst die ganze Aussenwand. Nur zwischen den "
            "Blaettern erkennt man die Mauer des Tempels."); 
  
  AddDetail( ({"pfad"}), 
            "Weiter unten siehst Du den Pfad, auf dem man den ganzen Tempel "
            "umrunden kann.");

  AddDetail( ({"himmel"}),
	    "Der Himmel ist wunderschoen blau. Fast keine Wolken sind zu "
            "sehen.");

  AddDetail( ({"ebene","ebenen"}),
	    "Du bist auf der ersten Ebene ausserhalb des Tempels. Weiter "
            "hinauf auf andere Ebenen kommt man wohl nur innerhalb des "
            "Tempels.");

  AddDetail( ({"pflanzen"}), 
            "Es sind Moose und Blumen.");

  AddDetail( ({"orchideen"}),
	    "Die Orchideen bluehen und sehen herrlich aus. Normalerweise "
            "wuerdest Du gerne welche pfluecken, aber sie sehen so schoen "
            "aus, dass Du es sein laesst.");

  AddDetail( ({"mauer","stellen"}),
	    "Du erkennst an den freien Stellen die Quader der Mauer."); 
  
  AddDetail( ({"blaettern","blaetter"}), 
            "Zwischen den Blaettern der Ranken erkennt man die Mauer.");

  AddDetail( ({"wolken","horizont","gefahr","regen"}),
	    "Am Horizont sind ein paar weisse Wolken zu sehen, aber es besteht "
            "keine Gefahr von Regen.");

  AddDetail( ({"quader"}),
	    "Die Quader bestehen aus harten Granit.");

  AddDetail( ({"granit","gestein"}), 
            "Granit ist ein sehr hartes Gestein.");

  AddDetail( ({"dschungels","dschungel"}),
	    "Der Dschungel ist ringsum den Tempel herum.");

  AddSmell(DEFAULT_SMELL, "Du riechst die Blumen auf dem Boden.");  
 
  AddSmell( ({"blumen"}),
	   "Die Blumen duften herrlich.");

  AddSound(DEFAULT_SOUND, "Du hoerst die Geraeusche des Dschungels.");

  AddSound( ({"geraeusche","dschungel","tiere"}),
	   "Du hoerst ein paar Tiere, kannst sie aber nicht zuordnen.");
  
//-----Details Ende-----
  
AddExit("osten", ROOM "tem1-16");
AddExit("westen", ROOM "tem1-18");

}

