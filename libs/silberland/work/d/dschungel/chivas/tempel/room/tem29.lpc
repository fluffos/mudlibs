// von Chivas
inherit "std/room";

#include "../def.h"

void create()
	
{
  ::create();


  SetProp( P_INT_SHORT, "In einem Tempel");
  SetProp( P_INT_LONG,
        "Die Waende wirken kalt und lassen Dich erschauern. Lauter Fratzen "
        "starren Dich an und scheinen Deinem Weg genau zu verfolgen. Der Boden "
	"ist feucht und schleimig. Du fuehlst Dich sehr unwohl in diesem "
        "Tempel. \n"
        "Die Richtungen in die Du gehen kannst kommen Dir nicht geheuer vor, "
        "irgendwie wirst Du das Gefuehl nicht los, dass so mancher Ausgang "
        "nicht das ist, was er vorgibt. " );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  
  AddDetail( ({"waende","wand"}), 
            "Die Waende sind feucht und Du erkennst schreckliche Fratzen. "
            "In regelmaessigen Abstaenden haengen Fackeln, die "
            "in einem gruenlichen Licht den Gang erhellen.");

  AddDetail( ({"fratzen","fratze"}),
	    "Die Fratzen starren Dich an und Du merkst wie bei jedem Deiner "
            "Schritte Dir kalte Augen folgen. Eins der entstellten Gesichter "
            "faellt Dir besonders auf.");

  AddDetail( ({"fackeln","abstaenden"}),
	    "Die Fackeln an den Waenden erhellen den Gang, in dem Du Dich "
            "befindest. Sie stecken in schmucklosen Halterungen.");

  AddDetail( ({"decke","himmel"}), 
            "Die Decke ist kahl und uninteressant.");

  AddDetail( ({"weg"}),
	    "Die Fratzen scheinen Dich zu verfolgen. Du fuehlst Dich unwohl.");

  AddDetail( ({"boden"}),
	    "Der Boden besteht aus grossen quadratischen Steinplatten."); 
  
  AddDetail( ({"tempel"}), 
            "Du bist nun mitten im Tempel. Eigentlich willst Du wieder raus "
            "an die Sonne.");

  AddDetail( ({"richtungen"}),
	    "Irgend ein Gefuehl sagt Dir, dass nur eine Richtung die richtige "
            "weiter in den Tempel ist.");

  AddDetail( ({"gefuehl"}),
	    "Dein Gefuehl taeuscht Dich eigentlich nie.");

  AddDetail( ({"ausgang","ausgaengen","ausgaenge"}), 
            "Probieren geht ueber studieren.");

  AddDetail( ({"halterungen"}),
	    "An einer Halterung faellt Dir etwas auf.");

  AddDetail( ({"halterung"}),
	    "Es ist ein kleines Zeichen."); 
  
  AddDetail( ({"zeichen"}), 
            "Das Zeichen wurde kaum erkennbar in die Halterung geritzt und "
            "scheint Dir die Wegrichtung anzuzeigen.");

  AddDetail( ({"wegrichtung"}),
	    "            *            \n"
            "           ***           \n"
            "          *****          \n"
            "         *******         \n"
            "            *            \n"
            "            *            \n"
            "            *            \n");

  AddDetail( ({"gang"}),
	    "Die ist ein Gang mit mehreren Ausgaengen.");

  AddDetail( ({"augen"}), 
            "Die Augen scheinen sich zu bewegen und Dir zu folgen.");

  AddDetail( ({"gesichter","gesicht"}),
	    "Die Fratze hat einen fuerchterlich verzerrten Mund, aus dem eine "
            "Fluessigkeit tropft.");

  AddDetail( ({"mund"}),
	    "Der Mund sieht schmerzverzerrt aus."); 
  
  AddDetail( ({"fluessigkeit"}), 
            "Die Fluessigkeit tropft auf den Boden. Was das wohl ist? Du "
            "koenntest sie ja mal probieren, wenn Du Dich traust. Aber "
            "bedenke: Tempel, Fratze, schmerzverzerrt,....");

  AddDetail( ({"sonne"}),
	    "Hier gibt es nur Fackeln.");

  AddDetail( ({"steinplatten","platten"}),
	    "Die Steinplatten sind leicht angeraut. Man erkennt schmale Fugen "
            "zwischen den Platten.");

  AddDetail( ({"fugen"}), 
            "Die Fugen sind sehr klein und man erkennt keine Luecke.");

  AddDetail( ({"luecke"}),
	    "Keine Luecke bedeutet, dass so etwas nicht existent ist.");

  AddDetail( ({"licht"}),
	    "Das Licht der Fackeln taucht den Gang in eine "
            "beunruhigendes Gruen. "); 
  
  AddDetail( ({"gruen"}), 
            "Das Gruen muss einfach magisch sein.");

  AddDetail( ({"schritte"}),
	    "Deine Schritte klingen hohl auf dem Boden.");
  
  AddSmell(DEFAULT_SMELL, "Es stinkt nach Tod.");  
 
  AddSmell( ({"tod"}),
	   "Der Tod kann Dich hier im Tempel sicher schnell ereilen.");

  AddSound(DEFAULT_SOUND, "Man hoert ein leises Roecheln und Deine eigenen "
                          "Schritte.");

  AddSound( ({"roecheln","fratzen"}),
	   "Das Roecheln scheint von den Fratzen zu stammen. Gruselig.");

  AddSound( ({"schritte"}),
	   "Deine Schritte sind recht laut, man hoert sie sicher durch den "
           "ganzen Tempel.");
  
//-----Details Ende-----
  
AddExit("norden", ROOM "tem30");
AddExit("nordosten", ROOM "tem28");
AddExit("nordwesten", ROOM "tem8");
AddExit("osten", ROOM "tem8");
AddExit("westen", ROOM "tem8");
AddExit("suedosten", ROOM "tem8");
AddExit("suedwesten", ROOM "tem8");
AddExit("sueden", ROOM "tem8");


AddCmd( ({"probier", "probiere" }), "probieren" );

}
int probieren(string str)
{
   notify_fail("Worein moechtest Du probieren?\n");
   if ( member( ({ "fluessigkeit" }),str) != -1) 
  {
    write(BS( "Du faengst ein paar Tropfen auf, die aus dem Mund tropfen und "
           "kostest. Es ist Blut und Dir wird schlecht und musst Dich "
           "fast uebergeben.\n"
           "Als Du ganz gruen und bleich im Gesicht wirst hoerst Du wie die "
           "Fratzen an den Waenden Dich kraechzend auslachen. Du bist nun "
           "wirklich beunruhigt. \n"));
    say( TPN+" wird ganz gruen und bleich im Gesicht und Du hoerst die "
             "die Fratzen an den Waenden laut lachen.\n");
    TP->AddHp(-15);
    this_player()->AddPoison(2);
    return 1;
  }
}

