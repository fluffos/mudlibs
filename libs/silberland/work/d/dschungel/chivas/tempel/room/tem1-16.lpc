// von Chivas
inherit "std/room";

#include "../def.h"

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einem Tempel im Dschungel");
  SetProp( P_INT_LONG,
        "Du stehst auf der ersten Ebene des Tempels. Vor Dir liegt ein "
        "umgefallener Baumstamm, der umgekippt ist und vom Pfad bis auf die "
        "Ebene reicht. Ansonsten haben sich die Pflanzen hier recht weit "
        "vorgekaempft. Die Fenster des Tempels, die Du hier siehst, kommen Dir "
        "komisch vor." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 30, ENV_TERRAIN: TT_JUNGLE]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );
  
//-----Details Anfang-----
  
  AddDetail( ({"ebene"}), 
            "Dies ist die erste Ebene des Tempels. Zwar bist Du ausserhalb "
            "des Tempels, aber immerhin kannst Du behaupten Du warst schon "
            "auf der ersten Ebene.");

  AddDetail( ({"tempel","tempels"}),
	    "Du bist ausserhalb eines dunklen Tempels, der mitten im tiefen "
            "Dschungel steht.");

  AddDetail( ({"baumstamm","stamm","baum"}),
	    "Der Baum ist umgefallen und ist auf die erste Ebene gefallen. Du "
            "kannst sicher ohne Probleme an dem Stamm runter auf den Pfad "
            "klettern.");

  AddDetail( ({"boden"}), 
            "Du siehst einige Pflanzen auf dem Boden.");

  AddDetail( ({"pfad"}),
	    "Den Pfad kannst Du von hier oben gut erkennen. Er fuehrt um den "
            "ganzen Tempel herum.");

  AddDetail( ({"pflanzen"}),
	    "Es sind einige Graeser, Moose und Blumen."); 
  
  AddDetail( ({"fenster"}), 
            "Die Fenster an der Aussenwand des Tempels sind mit einer "
            "magischen Energie ueberzogen, so dass Du nicht durch sie "
            "in das Innere des Tempels schauen kannst.");

  AddDetail( ({"dschungel","zeiten","boese","bluete","werk"}),
	    "Der Dschungel ist schon wieder recht nahe am Tempel. Zu den "
            "Zeiten, wo hier das Boese in voller Bluete am Werk war, war der "
            "Dschungel viel weiter weg.");

  AddDetail( ({"graeser"}),
	    "Die Graeser sind recht uninteressant. Was Dir aber auffaellt, sind "
            "ein paar kleine Baeumchen, die angefangen haben hier auf dem "
            "Tempel zu wachsen.");

  AddDetail( ({"moose","wasser"}), 
            "Die Moose wachsen auf dem Boden und saugen sofort das Wasser auf, "
            "wenn es regnet.");

  AddDetail( ({"blumen"}),
	    "Die Blumen bluehen in verschiedenen Farben.");

  AddDetail( ({"baeumchen","zentimeter","riesen"}),
	    "Sie sind erst einige Zentimeter gross, aber aus ihnen koennen "
            "auch solche Riesen wie sonst im Dschungel werden."); 
  
  AddDetail( ({"farben"}), 
            "Du siehst alle Farben des Regenbogens.");

  AddDetail( ({"innere","inneren"}),
	    "Um das Innere zu sehen, musst Du wohl durch den Eingang im Norden "
            "gehen und Dich im Inneren nach oben vorarbeiten.");

  AddDetail( ({"energie"}),
	    "Die magische Energie ist so stark, dass Du sie knistern hoerst.");

  AddDetail( ({"eingang","norden"}), 
            "Der Eingang des Tempels liegt im Norden.");

  AddDetail( ({"regenbogens","regenbogen"}),
	    "Sehr nett, aber nicht sehr interessant.");

  AddDetail( ({"probleme","runterklettern"}),
	    "Beim Runterklettern wirst Du sicher keine Probleme haben."); 
  
  AddDetail( ({"aussenwand","wand"}), 
            "An der Aussenwand des Tempels erkennst Du die Fenster und ein "
            "paar grosse Steinquader an Stellen, die nicht von Ranken "
            "zugewachsen sind.");

  AddDetail( ({"himmel"}),
	    "Der Himmel ist schoen blau.");

  AddDetail( ({"steinquader","quader","stellen","tonnen"}),
	    "Die Steinquader sind riesig und wiegen sicher mehrere Tonnen.");

  AddDetail( ({"ranken"}), 
            "Viele Ranken haben sich an der Aussenwand festgesetzt.");

  AddSmell(DEFAULT_SMELL, "Du riechst die Blumen und Graeser.");  
 
  AddSmell( ({"graeser","blumen"}),
	   "Sie duften nach Dschungel.");

  AddSmell( ({"dschungel"}),
	   "Der Dschungel riecht unglaublich dschungelig.");

  AddSound(DEFAULT_SOUND, "Du hoerst die magische Energie der Fenster "
                          "knistern.");

  AddSound( ({"energie"}),
	   "*knister*knister*knister*");
  
//-----Details Ende-----
  
AddExit("osten", ROOM "tem1-15");
AddExit("westen", ROOM "tem1-17");

AddCmd( ({"kletter" }), "klettern" );

}
int klettern(string str)
{
   notify_fail("Wo moechtest Du runter klettern?\n");
   if ( member( ({ "baum","baum runter","baumstamm runter","baumstamm","stamm runter","stamm","an stamm runter","an baum runter","an baumstamm runter" }),str) != -1) 
  {
    write(BS ( "Du kletterst mit Muehe den umgekippten Baumstamm runter und "
               "erreichst wieder den Fuss des Tempels.\n"));
     TP->move(ROOM "tem20", M_GO, 
     "den umgefallenen Baumstamm runter und verschwindet", "klettert",
     "kommt auf dem Baumstamm heruntergeklettert");

    return 1;
  }
}

