// von Chivas
inherit "std/room";

#include "../def.h"

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "An einem Tempel im Dschungel");
  SetProp( P_INT_LONG,
        "Der Pfad ist nur leicht mit Pflanzen bewachsen, so dass ein "
        "Vorankommen einfach ist. Der tiefe Dschungel ist einige Meter "
	"entfernt, macht dann aber einen undurchdringlichen Eindruck. Am "
        "Tempel erkennst Du einige Malereien, die jedoch schon sehr verblasst "
        "sind." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 30, ENV_TERRAIN: TT_JUNGLE]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"pflanzen","vorankommen"}), 
            "Verschiedene kleine Pflanzen wachsen auf dem Boden des Pfades. "
            "Sie behindern nicht Dein Vorankommen auf Deinem Weg um dem Tempel "
            "herum.");

  AddDetail( ({"dschungel","meter"}),
	    "Der Dschungel gleich neben dem Pfad ist undurchdringlich. Die "
            "Baeume und Straeucher lassen Dich nicht durch. Du musst wohl "
            "auf dem Pfad bleiben.");

  AddDetail( ({"pfad","pfades","weg"}), 
            "Der Pfad ist gut sichtbar und Du kommst gut auf ihm voran.");

  AddDetail( ({"eindruck"}),
	    "Es macht nicht nur den Eindruck. Es ist auch so.");

  AddDetail( ({"tempel","tempels"}),
	    "Der Tempel ragt neben Dir in den Himmel und er sieht "
            "furchteinfloessend aus."); 
  
  AddDetail( ({"malereien"}), 
            "Die Malereien sind aus verschiedenen Zeiten.");

  AddDetail( ({"boden"}),
	    "Am Boden wachsen ein paar junge Baeume und Graeser.");

  AddDetail( ({"himmel","sonne"}),
	    "Der Himmel ist blau und die Sonne steht fast senkrecht am Himmel.");

  AddDetail( ({"baeume"}), 
            "Die Baeume im Dschungel stehen dicht zusammen. Die Baeume auf "
            "dem Pfad sind noch sehr klein und jung.");

  AddDetail( ({"graeser"}),
	    "Die Graeser wachsen zwar recht hoch, aber es behindert Dich "
            "nicht.");

  AddDetail( ({"straeucher"}),
	    "Die Straeucher und Baeume lassen ein Vordringen in den Dschungel "
            "scheitern. Sie stehen sehr dicht zusammen und haben auch noch "
            "grosse spitze Dornen."); 
  
  AddDetail( ({"zeiten"}), 
            "Die Malereien zeigen den Bau des Tempels.");

  AddDetail( ({"dornen","wahl"}),
	    "Die Dornen sehen richtig gefaehrlich aus. Da faellt die Wahl "
            "nicht schwer, auf dem Pfad zu bleiben.");

  AddDetail( ({"bau","justavius","anmerkung","chivas"}),
	    "Es werden versklavte Elfen, Menschen, Trolle und Oger gezeigt, "
            "die Steine schleppen und zu Tode gequaelt werden. Du wendest "
            "Deinen Blick von der Abscheulichkeit ab.");

  AddDetail( ({"blick"}), 
            "Du kannst so etwas nicht sehen. Du bist sehr sensibel.");

  AddDetail( ({"elfen","menschen","hobbits","feen","rassen","trolle","oger"}),
	    "Eine der Rassen im Silberland.");

  AddDetail( ({"silberland"}),
	    "Du bist mittendrin."); 
  
  AddDetail( ({"steine"}), 
            "Die Steine sehen sehr schwer aus.");

  AddDetail( ({"tode","tod"}),
	    "Du willst momentan nicht Tod besuchen.");

  AddDetail( ({"vordringen"}),
	    "Es ist unmoeglich, glaub es endlich.");

  AddDetail( ({"abscheulichkeit","abscheulichkeiten"}), 
            "Du hast leider schon viele Abscheulichkeiten gesehen.");

  AddSmell(DEFAULT_SMELL, "Du riechst nichts interessantes.");  
 
  AddSound(DEFAULT_SOUND, "Es gibt auch nicht viel zu hoeren.");

//-----Details Ende-----
  
AddExit("sueden", ROOM "tem25");
AddExit("norden", ROOM "tem27");

}

