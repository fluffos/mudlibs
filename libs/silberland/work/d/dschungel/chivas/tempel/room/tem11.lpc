// von Chivas
inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();


  SetProp( P_INT_SHORT, "An einem Tempel im Dschungel");
  SetProp( P_INT_LONG,
        "Der Pfad fuehrt vom Eingang des Tempels um den Tempel herum. Es gibt "
        "keine Moeglichkeit den Pfad zu verlassen, da im Norden der Urwald "
	"undurchdringlich ist. Die Baeume und Pflanzen stehen so dicht, so dass "
        "Du keinen Meter in den Dschungel schauen kannst. Der Tempel macht "
        "hier einen verwitterten Eindruck. " );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 30, ENV_TERRAIN: TT_JUNGLE]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  
  AddDetail( ({"pfad"}), 
            "Der Pfad fuehrt vom Eingang anscheinend um den ganzen Tempel "
            "herum. So kann man sich erst einmal von aussen einen Ueberblick "
            "ueber den Tempel verschaffen.");

  AddDetail( ({"eingang","westen"}),
	    "Der Eingang zum Tempel befindet sich im Westen.");

  AddDetail( ({"tempel"}),
	    "Der Tempel scheint riesig zu sein. An dieser Stelle macht die "
            "Mauer einen recht verwitterten Eindruck.");

  AddDetail( ({"moeglichkeit"}), 
            "Der Dschungel im Norden ist so dicht, so dass Du kaum etwas "
            "dort sehen kannst. Es gibt definitiv keine Moeglichkeit, dort "
            "den Pfad zu verlassen.");

  AddDetail( ({"norden","urwald","dschungel"}),
	    "Der Dschungel ist durch die vielen Baeume und anderen Pflanzen "
            "undurchdringlich. Es ist eigentlich nur eine grosse gruene Wand.");

  AddDetail( ({"baeume","baeumen","teil"}),
	    "Die Baeume sind riesengross und das Blaetterdach verdeckt in "
            "diesem Teil fast den gesamten Himmel."); 
  
  AddDetail( ({"pflanzen"}), 
            "Zwischen den Baeumen stehen einige Buesche und an den Aesten "
            "haengen lange grosse Schlingpflanzen.");

  AddDetail( ({"meter","masseinheit"}),
	    "Dies ist eine Masseinheit.");

  AddDetail( ({"eindruck","zeiten"}),
	    "Der Tempel hat schon mal bessere Zeiten gesehen.");

  AddDetail( ({"boden"}), 
            "Auf dem Boden liegen ein paar kleine Steine und Blaetter.");

  AddDetail( ({"mauer","stelle"}),
	    "Die Mauer ist ein wenig verwittert und gelbliches Moos klebt an "
            "ihr.");

  AddDetail( ({"steinquader","quader","quadern"}),
	    "Die grossen Steinquader bilden eine massive und stabile Mauer. "
            "Es sind kaum Fugen zwischen den Quadern zu erkennen."); 
  
  AddDetail( ({"fugen"}), 
            "Die Fugen sind nur sehr klein und sehr sehr uninteressant.");

  AddDetail( ({"steine"}),
	    "Einige kleine Steine liegen auf dem Boden.");

  AddDetail( ({"blaetter"}),
	    "Die Blaetter sind sicher von den Baeumen herunter gefallen. "
            "Sie verfaulen hier am Boden.");

  AddDetail( ({"aeste","aesten","schlingpflanze","schlingpflanzen"}), 
            "An den Aesten haengen grosse Schlingpflanzen bis auf den Pfad "
            "herunter. Du willst ihnen nicht zu nahe kommen, da es so aussieht "
            "als ob sie nach Dir greifen und Dich erwuergen wollen. ");

  AddDetail( ({"ueberblick"}),
	    "Einen Ueberblick zu haben ist immer gut.");

  AddDetail( ({"wand"}),
	    "Das ist nur im uebertragenen Sinn eine Wand."); 
  
  AddDetail( ({"sinn","verstand","p"}), 
            "Was Du manchmal untersuchst hat weder Sinn, noch Verstand, da "
            "stimmt Dir jeder zu. ;P");

  AddDetail( ({"blaetterdach","himmel","lichtverhaeltnissen","lichtverhaeltnisse"}),
	    "Das Blaetterdach verdeckt fast den gesamten Himmel. Von den "
            "Lichtverhaeltnissen ist es ein wenig schummrig.");

  AddDetail( ({"moos"}),
	    "Das Moos sieht mit der gelblichen Farbe nicht gerade sehr gesund "
            "aus. Unter dem Moos kann man die grossen Steinquader erkennen.");

  AddDetail( ({"farbe","faerbung"}), 
            "Waere das Moos gesund, haette es sicher eine saftig gruene "
            "Faerbung. Es liegt sicher an dem Tempel, dass es nicht gut "
            "gedeiht.");

  AddDetail( ({"buesche"}),
	    "Die Buesche bilden zusammen mit den Baeumen eine unueberwindliche "
            "Wand.");

  AddSmell(DEFAULT_SMELL, "Es riecht nach Dschungel.");  
 
  AddSmell( ({"dschungel"}),
	   "Eigentlich genau so wie bisher auch, Du befindest Dich ja schon "
           "laenger im Dschungel.");

  AddSound(DEFAULT_SOUND, "Es ist totenstill. Irgendwie nicht normal fuer "
                          "einen Dschungel.");

  AddSound( ({"dschungel"}),
	   "Du hoerst nichts.");
  
//-----Details Ende-----
  
AddExit("westen", ROOM "tem8");
AddExit("osten", ROOM "tem12");

}

