// von Chivas
inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();


  SetProp( P_INT_SHORT, "In einem Tempel");
  SetProp( P_INT_LONG,
        "Du hast es bis zu einem weiteren Portal geschafft. Das helle "
        "Leuchten des gelb schimmernden Portal blendet Dich. Die ganze Kammer "
	"ist in Licht getaucht und Du bist sehr erstaunt, dass es in dem "
        "sonst so dunklen und duesteren Tempel auch eine Quelle des Lichts "
        "gibt." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 2 );

  
//-----Details Anfang-----

  
  AddDetail( ({"portal","portale","portals"}), 
            "Das Portal schimmert in einem sehr hellen Gelb.");

  AddDetail( ({"leuchten"}),
	    "Das Leuchten blendet Dich.");

  AddDetail( ({"kammer","kammern"}),
	    "Diese Kammer beinhaltet mal wieder eins dieser verfluchten "
            "Portale.");

  AddDetail( ({"licht","lichts","helligkeit"}), 
            "Die Kammer ist ausnahmnsweise richtig hell, man wird sogar "
            "geblendet von der Helligkeit.");

  AddDetail( ({"tempel","ende","tempels"}),
	    "Das Erdgeschoss des Tempels muss riesig sein. Du warst schon "
            "in so vielen Raeumen und ein Ende scheint nicht nahe zu sein.");

  AddDetail( ({"quelle"}),
	    "Die Quelle des Lichts ist das grosse runde Portal in der Mitte "
            "der Kammer."); 
  
  AddDetail( ({"boden"}), 
            "Am Boden sind einige Steinplatten zu sehen.");

  AddDetail( ({"decke","himmel"}),
	    "Die Decke ist nicht sehr interessant.");

  AddDetail( ({"wand","waende","waenden"}),
	    "An den Waenden ist nicht viel zu erkennen.");

  AddDetail( ({"gelb"}), 
            "Das Gelb ist grell.");

  AddDetail( ({"raeume","raeumen","hallen","gaenge"}),
	    "Der Tempel hat sehr viele Kammern, Hallen, Gaenge und normale "
            "Raeume.");

  AddDetail( ({"erdgeschoss"}),
	    "Du befindest Dich immer noch im Erdgeschoss. Was auf den anderen "
            "Ebenen auf Dich wartet, kannst Du noch nicht erahnen."); 
  
  AddDetail( ({"ebenen","ebene"}), 
            "Der Tempel scheint noch 4 weitere Ebenen ueber dem Erdgeschoss "
            "zu haben.");

  AddDetail( ({"mitte"}),
	    "Genau in der Mitte der Kammer steht das Portal.");

  AddDetail( ({"steinplatten","platten"}),
	    "Die Steinplatten sind quadratisch, aber total langweilig.");

  AddSmell(DEFAULT_SMELL, "Es riecht nach absolut nichts.");  
 
  AddSound(DEFAULT_SOUND, "Du hoerst das magische Knistern des Portals.");

  AddSound( ({"knistern","portal","energie"}),
	   "Die magische Energie des Portals knistert ganz laut.");

//-----Details Ende-----

AddItem(OBJ "portalge", REFRESH_DESTRUCT);
AddItem( "/d/unterwelt/basics/central/npc/skelett", REFRESH_DESTRUCT,
        ([P_MNPC_DEFAULTROOM: "tem47",
          P_MNPC_AREA:({ROOM "tem47"}),
          P_MNPC_FLAGS: MOV_INDOORS + MOV_MAYLOAD + MOV_MOVES
        ]) );
AddItem( "/d/unterwelt/basics/central/npc/skelett", REFRESH_DESTRUCT,
        ([P_MNPC_DEFAULTROOM: "tem47",
          P_MNPC_AREA:({ROOM "tem47"}),
          P_MNPC_FLAGS: MOV_INDOORS + MOV_MAYLOAD + MOV_MOVES
        ]) );
  
AddExit("suedwesten", ROOM "tem46");


AddCmd( ({"betrete" }), "betreten" );

}
int betreten(string str)
{
   notify_fail("Was moechtest Du betreten?\n");
   if ( member( ({ "portal","gelbes portal" }),str) != -1) 
  {
    write(BS ( "Du betrittst das schimmernde Portal und die Umgebung "
               "verschwimmt. Mal sehen wo Dich das Portal hinbringt.\n"));
    say( TPN+" betritt das Portal und verschwindet.\n");
    TP->AddSp(-50);
    this_player()->move(ROOM "tem48", M_TPORT);
    return 1;
  }
}

