// von Chivas
inherit "std/room";

#include "../def.h"

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Tempel");
  SetProp( P_INT_LONG,
        "Der Gang geht weiter nach Osten. An den Waenden sind ein paar "
        "verrostete Ketten und Halterungen zu erkennen. Durch die Fenster "
        "kommt nur sehr wenig Licht, da die erzeugte Magie an den Fenstern "
        "die Sonnenstrahlen nicht rein laesst. Der Boden ist mit Steinplatten "
        "ausgelegt und von der Decke fallen Tropfen. " );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  
  AddDetail( ({"gang"}), 
            "Der Gang fuehrt weiter nach Osten.");

  AddDetail( ({"osten"}),
	    "Im Osten ist ein weiterer Raum. Du kannst aber von hier nicht "
            "viel erkennen.");

  AddDetail( ({"waende","waenden"}),
	    "An den Waenden sind Fenster und ansonsten ist nur die blanke "
            "Mauer zu sehen, an der ein paar Ketten und Halterungen zu "
            "sehen sind.");

  AddDetail( ({"ketten","personen"}), 
            "Die Ketten sind total verrostet. Sie dienten wohl einmal dazu "
            "Personen hier festzuketten.");

  AddDetail( ({"halterungen","fackeln"}),
	    "Die Halterungen dienen dazu Fackeln, zu halten. Sie sind jedoch "
            "leer.");

  AddDetail( ({"fenster","fenstern"}),
	    "Die Fenster lassen ein wenig Licht herein, jedoch nur soviel, "
            "dass Du ein wenig sehen kannst. Ein magischer Schimmer liegt auf "
            "den Fenstern und verdunkelt sie."); 
  
  AddDetail( ({"licht"}), 
            "Es gibt nur wenig Licht, aber es reicht, um ein wenig zu sehen.");

  AddDetail( ({"magie","schimmer"}),
	    "Die Magie ist stark und verdunkelt den sonst hellen Gang.");

  AddDetail( ({"sonnenstrahlen","strahlen"}),
	    "Die Sonnenstrahlen dringen kaum durch die Fenster.");

  AddDetail( ({"boden"}), 
            "Am Boden sind ganz normale Steinplatten zu sehen und der Boden "
            "ist feucht.");

  AddDetail( ({"steinplatten","platten"}),
	    "Die Steinplatten bestehen aus hartem Granit.");

  AddDetail( ({"decke","himmel"}),
	    "Die Decke ist schmucklos und ein paar Tropfen fallen von ihr "
            "auf den Boden."); 
  
  AddDetail( ({"tropfen"}), 
            "Die Tropfen fallen von der Decke auf den Boden. *Platsch*");

  AddDetail( ({"raum"}),
	    "Geh doch einfach hin und schau ihn Dir an.");

  AddDetail( ({"mauer"}),
	    "Die Mauer ist kahl, ausser ein paar Ketten und Halterungen.");

  AddDetail( ({"Granit","gestein"}), 
            "Der Granit ist ein hartes Gestein.");

  AddDetail( ({"tempel"}),
	    "Du bist noch immer auf der ersten Ebene im Tempel.");

  AddDetail( ({"ebene"}),
	    "Es gibt verschiedene Ebenen."); 
  
  AddDetail( ({"ebenen"}), 
            "Es gibt vier Ebenen, wie Du von draussen gesehen hast.");

  AddDetail( ({"platsch"}),
	    "Das ist ein Geraeusch, lausche doch den Tropfen.");

  AddDetail( ({"geraeusch","geraeusche"}),
	    "Geraeusche kann man hoeren.");

  AddSmell(DEFAULT_SMELL, "Es riecht nach Faeulnis.");  
 
  AddSmell( ({"faeulnis"}),
	   "Das ist wohl normal in einem alten Tempel, der ueberall feucht "
           "ist.");

  AddSound(DEFAULT_SOUND, "Du hoerst, wie die Tropfen auf den Boden fallen.");

  AddSound( ({"tropfen","geraeusche","geraeusch"}),
	   "*platsch*");
  
//-----Details Ende-----
  
AddExit("westen", ROOM "tem1-5");
AddExit("osten", ROOM "tem1-3");

}

