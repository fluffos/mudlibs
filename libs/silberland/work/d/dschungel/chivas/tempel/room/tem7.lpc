// von Chivas
inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

int umhang_zahl; 

void create()
	
{
  ::create();

   umhang_zahl=1;

  SetProp( P_INT_SHORT, "Auf einem Dschungelpfad");
  SetProp( P_INT_LONG,
        "Das Blaetterdach laesst vom Sueden her ein wenig mehr Licht auf den "
        "Pfad scheinen, anscheinend ist dort der Dschungel nicht ganz so dicht "
        "wie im Norden. Auch hier ergibt sich das uebliche Bild des Dschungels, "
	"ueberall grosse Baeume, Schlingpflanzen, Blumen verschiedenster Art "
        "und lauter Geraeusche von Tieren, die hier im Urwald leben." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_JUNGLE]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  
  AddDetail( ({"blaetterdach","dach"}), 
            "Das Blaetterdach scheint im Sueden lichter zu werden, da ein "
            "paar mehr Lichtstrahlen durch die Blaetter dringen. Anscheinend "
            "sind dort weniger Baeume als hier.");

  AddDetail( ({"boden"}),
	    "Der Boden ist mit verschiedenen Pflanzen und Blumen bedeckt.");

  AddDetail( ({"sueden"}),
	    "Im Sueden scheinen die Baeume weniger zu werden.");

  AddDetail( ({"licht"}), 
            "Das Licht nimmt zu, da einige Lichtstrahlen aus dem Sueden bis "
            "hier her vordringen.");

  AddDetail( ({"pfad","pfades"}),
	    "Der Pfad fuehrt durch den Dschungel weiter nach Sueden, oder "
            "wieder zurueck nach Norden.");

  AddDetail( ({"dschungel","dschungels"}),
	    "Der Dschungel mit all seinen Pflanzen zwingt Dir die Richtung "
            "auf. Es gibt keine Moeglichkeit vom Pfad abzuweichen."); 
  
  AddDetail( ({"norden"}), 
            "Im Norden ist der Dschungel dichter und dunkler als hier.");

  AddDetail( ({"bild"}),
	    "Ueberall sind Pflanzen, Pflanzen und Pflanzen zu sehen.");

  AddDetail( ({"baeume"}),
	    "Die Baeume sind gross und mit Schlingpflanzen bewachsen. Ihr "
            "Blaetterdach ueber Dir laesst kaum Licht durch. Ausser im Sueden, "
            "wo es anscheinend weniger Baeume gibt.");

  AddDetail( ({"schlingpflanzen","weg"}), 
            "Die Schlingpflanzen haengen von den grossen Baeumen herunter und "
            "haengen staendig im Weg herum.");

  AddDetail( ({"pflanzen"}),
	    "Es gibt hier verschiedenste Pflanzen, die Du noch nie gesehen "
            "hast.");

  AddDetail( ({"blumen"}),
	    "Viele verschiedene Arten von Blumen wachsen hier auf dem Boden."); 
  
  AddDetail( ({"art"}), 
            "Es sind ein paar Orchideen und andere Blumen, die Du aber bisher "
            "noch nie gesehen hast.");

  AddDetail( ({"geraeusche"}),
	    "Du solltest schon lauschen.");

  AddDetail( ({"tiere","tieren"}),
	    "Hier im Dschungel gibt es viele Tiere. Manche Tiere sind Dir "
            "wohlgesonnen und andere solltest Du lieber meiden.");

  AddDetail( ({"himmel"}), 
            "Den Himmel und die Sonne kannst Du nur erahnen.");

  AddDetail( ({"sonne"}),
	    "Die Sonne ist nicht zu sehen, nur ein paar Lichtstrahlen, die "
            "vom Sueden hier her durchdringen.");

  AddDetail( ({"lichtstrahlen","strahlen"}),
	    "Vom Sueden dringen einige Lichtstrahlen bis hier durch. Dort "
            "scheinen die Baeume nicht so dicht zu stehen."); 
  
  AddDetail( ({"blaetter"}), 
            "Die Blaetter im Dschungel haben alle moeglichen Formen, Groessen "
            "und Farben.");

  AddDetail( ({"formen","groessen"}),
	    "Die Formen gehen von rundlich bis eckig und die Groessen von "
            "winzigklein bis riesengross, so dass Du Dich komplett mit "
            "einwickeln koenntest. Ein solches riesengrosses Blatt liegt am "
            "Rand des Pfades.");

  AddDetail( ({"farben","farbpalette","palette","gruen","froschgruen"}),
	    "Es sind primaer gruene Farben. Die Farbpalette reicht von "
            "gruen-gelblich ueber Froschgruen bis zu einem Gruen, dass dem "
            "Gesichtsausdruck nahe kommt, wenn man bei Max zu viel gegessen "
            "hat.");

  AddDetail( ({"max","wirt"}), 
            "Max ist der Wirt in Midas.");

  AddDetail( ({"midas","hauptstadt","stadt"}),
	    "Midas ist die Hauptstadt im Silberland.");

  AddDetail( ({"silberland"}),
	    "Du befindest Dich im Silberland."); 
  
  AddDetail( ({"gesichtsausdruck","ausdruck"}), 
            "So wie Dein Gesichtsausdruck, nur nicht so dumm und etwas "
            "gruenlicher.");

  AddDetail( ({"blatt","rand"}),
	    "Am Rand des Pfades liegt ein riesengrosses Blatt, in das man sich "
            "einwickeln koennte.");

  AddDetail( ({"richtung","moeglichkeit"}),
	    "Es geht nur nach Sueden oder Norden.");

  AddDetail( ({"orchideen"}), 
            "Die Orchideen gefallen Dir. Sie sind aber zu schoen, um sie zu "
            "pfluecken.");

  AddDetail( ({"wort"}),
	    "Du untersuchst wirklich alles. Gratuliere.");

  AddDetail( ({"urwald"}),
	    "Der Urwald sieht genau so aus wie der Dschungel.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Pflanzen und Blumen.");  
 
  AddSmell( ({"pflanzen"}),
	   "Die Pflanzen riechen irgendwie durchwachsen.");

  AddSmell( ({"blumen"}),
	   "Die Blumen duften suesslich. Du riechst gerne an ihnen.");

  AddSound(DEFAULT_SOUND, "Du hoerst einige Tiere im Dschungel.");

  AddSound( ({"tiere"}),
	   "Du hoerst ihre Laute, willst aber ihnen nicht zu nahe kommen.");

  AddSound( ({"laute"}),
	   "Du hoerst Knurren von Raubtieren und das Zwitschern von Voegeln.");

  AddSound( ({"zwitschern","voegel","voegeln"}),
	   "Die Voegel, die Du hoerst scheinen oben in den Baeumen zu sitzen.");
  
  AddSound( ({"knurren","raubtieren","raubtiere"}),
		"Es scheinen grosse Tiere zu sein. Mehr willst Du nicht wissen.");

//-----Details Ende-----
  
AddExit("norden", ROOM "tem6");
AddExit("sueden", ROOM "tem8");

AddCmd( ({"wickel","wickele" }), "wickeln" );

}
void reset()
{
  ::reset();
  umhang_zahl=1;
}
int wickeln(string str)
{
   object umhang;
   notify_fail("Worein moechtest Du Dich wickeln?\n");
   if ( member( ({ "in blatt", "in blatt ein" }),str) != -1) 
   {
     if( umhang_zahl < 1 )
     {
        write(BS("Du hast keine Lust, Dich in das Blatt zu wickeln.\n"));
        say(sprintf("%s ist ein wenig lustlos.\n", TP->Name(WER)));
        return -1;
     }
      if ( present("umhang",TP) )
      {
      write(BS("Da Du bereits einen Umhang hast, brauchst Du es nicht mehr "
            "zu tun.\n" ));
      say(sprintf("%s sucht krankhaft nach weiteren grossen Blaettern.\n", TP->Name(WER)));
      return -1;
      }
      else
      {
        {umhang = clone_object( ARMOUR "umhang");
        if ( ME_TOO_HEAVY == umhang->move(TP,M_GET|M_SILENT) )
 
          {
          write(BS(
          "Der Umhang wuerde Dir zu schwer werden.\n" ));
          say(BS(sprintf("%s wickelt sich in das grosse Blatt, scheint aber "
          "von seinem Gepaeck behindert zu werden.\n", TP->Name(WER))));
          umhang -> remove();
          return 1;
          }
          else
          {
          write(BS("Du wickelst Dich in das Blatt und findest das es ein "
                "toller Umhang ist.\n"));
          say(sprintf("%s wickelt sich in ein Blatt.\n",
          TP->Name(WER)));
          umhang_zahl--;
          return 1;
          }
        }
     }
    return 0;
   }
  return 0;
}
