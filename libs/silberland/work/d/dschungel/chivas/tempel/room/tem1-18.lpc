// von Chivas
inherit "std/room";

#include "../def.h"

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einem Tempel im Dschungel");
  SetProp( P_INT_LONG,
        "Du stehst genau an der suedwestlichen Ecke auf dem Tempel. Genau in "
        "der dieser Hoehe siehst Du die Hinterkoepfe der drei Statuen, die am "
        "Fuss des Tempels stehen. Um Dich herum sind lauter Pflanzen, die "
        "im Laufe der Zeit hier oben auf dem Tempel Wurzeln geschlagen "
        "haben." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 30, ENV_TERRAIN: TT_JUNGLE]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----

  AddDetail( ({"ecke"}), 
            "Du stehst an der suedwestlichen Ecke auf der ersten Ebene "
            "ausserhalb der Tempels.");

  AddDetail( ({"tempel","tempels"}),
	    "Du befindest Dich ausserhalb auf einem Tempel im Dschungel.");

  AddDetail( ({"hoehe"}),
	    "In dieser Hoehe siehst Du die Hinterkoepfe der grossen Statuen.");

  AddDetail( ({"hinterkoepfe","koepfe","kopf","hinterkopf","koepfen"}), 
            "Du findest, dass die Koepfe nicht mehr so schlimm aussehen, wenn "
            "man nur die Rueckseite sieht.");

  AddDetail( ({"statuen"}),
	    "Die riesigen Statuen reichen bis zu dieser Ebene hoch.");

  AddDetail( ({"fuss"}),
	    "Am Fuss der Statuen fuehrt ein Pfad entlang."); 
  
  AddDetail( ({"pflanzen","wurzeln","laufe","zeit"}), 
            "Es sind hauptsaechlich Graeser und ein paar Schlingpflanzen.");

  AddDetail( ({"boden"}),
	    "Am Boden siehst Du einige kleine Pflanzen, die hier Wurzeln "
            "geschlagen haben.");

  AddDetail( ({"himmel"}),
	    "Der Himmel ist blau.");

  AddDetail( ({"ebene"}), 
            "Du bist auf diese Ebene geklettert und so hier her gekommen.");

  AddDetail( ({"dschungel"}),
	    "Der Dschungel ist rings um Dich herum.");

  AddDetail( ({"graeser"}),
	    "Die Graeser sind ein wenig niedergetrampelt. Anscheinend war "
            "schon Etwas vor Dir an diesem Ort."); 
  
  AddDetail( ({"schlingpflanzen"}), 
            "Die Schlingpflanzen wachsen vom Boden an den Aussenmauern hoch.");

  AddDetail( ({"pfad"}),
	    "Der Pfad fuehrt um den ganzen Tempel.");

  AddDetail( ({"rueckseite"}),
	    "Dies kann man uebrigens bei vielen Koepfen sagen.");

  AddDetail( ({"ort"}), 
            "Der Tempel ist ein verfluchter Ort.");

  AddDetail( ({"etwas"}),
	    "Das Etwas muss sehr gross gewesen sein, da die Fussabdruecke "
            "riesig sind.");

  AddDetail( ({"aussenmauern","aussenmauer","mauer"}),
	    "An der Aussenmauer haengen einige Schlingpflanzen. Ausserdem "
            "siehst Du einige Fenster."); 
  
  AddDetail( ({"fussabdruecke","abdruecke","wesen","person"}), 
            "Die Fussabdruecke sind tief und gross. Die Person oder das Wesen, "
            "das diese Abdruecke hinterlassen hat, ist sicher gefaehrlich.");

  AddDetail( ({"fenster"}),
	    "Die Fenster sind mit einem magischen Schleier ueberzogen.");

  AddDetail( ({"schleier","innere"}),
	    "Der magische Schleier ist undurchdringlich. Du kannst nicht ins "
            "Innere des Tempels schauen.");

  AddSmell(DEFAULT_SMELL, "Es riecht nach nichts.");  
 
  AddSound(DEFAULT_SOUND, "Du hoerst ein paar Tiere und Voegel im Dschungel.");

  AddSound( ({"tiere","voegel","dschungel","geraeusche"}),
	   "Dies sind ganz normale Geraeusche im Dschungel.");
  
//-----Details Ende-----
AddItem(NPC "delf", REFRESH_DESTRUCT);
  
AddExit("osten", ROOM "tem1-17");
AddExit("norden", ROOM "tem1-19");

}

