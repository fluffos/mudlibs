// von Chivas
inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

int spinneda;

void create()
	
{
  ::create();

  spinneda=1; 

  SetProp( P_INT_SHORT, "In einem Tempel");
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  
  AddDetail( ({"gang"}), 
            "Der Gang is duester und eng. Das einzige Licht faellt vom Norden "
            "in den Gang herein.");

  AddDetail( ({"fenster"}),
	    "Fenster gibt es in diesem engen Gang keine.");

  AddDetail( ({"licht"}),
	    "Das Licht faellt vom Norden in den Gang. Ansonsten gibt es hier "
            "keine Lichtquelle.");

  AddDetail( ({"norden"}), 
            "Im Norden ist es viel heller als hier im Gang.");

  AddDetail( ({"boden"}),
	    "Der Boden ist schmucklos. Es sind nur die ueblichen Steinplatten "
            "zu sehen."); 
  
  AddDetail( ({"wand","waende"}),
	    "An der Wand sind ein paar Halterungen fuer Fackeln zu sehen.");

  AddDetail( ({"steinplatten","platten"}), 
            "Die Steinplatten bestehen aus mattem Granit. Ansonsten sind sie "
            "uninteressant.");

  AddDetail( ({"spinnweben"}),
	    "Die Spinnweben sind klein und sehen verlassen aus.");

  AddDetail( ({"halterungen","grund"}),
	    "Die Halterungen sind ein wenig verrostet und keine Fackel "
            "haengt in ihnen. Dies ist wohl auch der Grund wieso es hier so "
            "duester ist."); 
  
  AddDetail( ({"fackeln","fackel"}), 
            "Die Halterungen sind leer, dadurch sind auch keine Fackeln zu "
            "sehen.");

  AddDetail( ({"granit"}),
	    "An dem Granit ist nichts interessantes zu erkennen.");

  AddDetail( ({"lichtquelle"}),
	    "Die einzige Lichtquelle ist im Norden.");

  AddSpecialDetail( ({ "decke","himmel" }), "decke" );
  AddSpecialDetail( ({ "spinnennetz","netz" }), "netz" );
  AddSpecialDetail( ({ "richtung","osten","weg" }), "osten" );

  AddSmell(DEFAULT_SMELL, "Es riecht recht steril, also nach gar nichts.");  
 
  AddSound(DEFAULT_SOUND, "Du hoerst ein Kratzen.");

  AddSound( ({"kratzen"}),
	   "Das Kratzen kommt aus dem Netz, aber mehr kannst Du nicht "
           "herausfinden.");
  
//-----Details Ende-----
  
AddExit("norden", ROOM "tem1-6");

AddCmd( ({"zerschneide", "zerschneid" }), "zerschneiden" );
AddCmd( ({"beruehr", "beruehre" }), "beruehren" );

}
void reset()
{
  ::reset();
  spinneda=1;

}

int zerschneiden(string str)
{
  object spinne;
  notify_fail ("Was moechtes Du zerschneiden?\n");

   if ( member( ({ "netz", "spinnennetz" }),str) != -1) 
   {
  if (present("riesenspinne",TO) || !spinneda)

  {
    write(BS("Du hast es doch schon zerschnitten."));
    return -1;
  }
  write(BS("Du zerschneidest das Spinnennetz und der Gang nach Osten oeffnet "
           "sich fuer Dich. Leider hast Du auch den Besitzer des Netzes "
           "aufgeweckt.\n"));
  spinneda=0;
  spinne = clone_object (NPC "riesenspinne.lpc" );
  spinne->move(TO,M_GO|M_NOCHECK,"krabbelt herein.");
  AddExit( "osten", ([
           EX_DEST  : ROOM "tem1-4",
           EXG_ID   : "riesenspinne",
           EXG_FUNC : "Kill",
           EXG_PLMSG: "Die Riesenspinne laesst Dich nicht vorbei!\n",
           EXG_RMMSG: "Die Riesenspinne laesst @wen@ nicht durch.\n" ]) );
  return 1;
}}

int beruehren(string str)
{
   notify_fail("Was moechtest Du beruehren?\n");
   if ( member( ({ "netz","spinnennetz" }),str) != -1) 
  {
    write(BS( "Du beruehrst das Netz und merkst das es klebrig und stabil ist. Du "
           "wirst es wohl zerschneiden muessen.\n"));
    say( TPN+" beruehrt das Spinnennetz.\n");
    return 1;
  }
}
string _query_int_long()
{
  string txt;

    if ( spinneda )
    {
      txt = "Es ist hier dunkler als im Gang weiter noerdlich. Hier gibt es "
        "keinerlei Fenster und nur das Licht von Norden erhellt den Gang ein "
        "wenig. Ein riesiges Spinnennetz haengt quer ueber den Gang in "
        "Richtung Osten. Es sieht recht neu aus.";
    }
    else
    {
      txt = "Es ist hier dunkler als im Gang weiter noerdlich. Hier gibt es "
        "keinerlei Fenster und nur das Licht von Norden erhellt den Gang ein "
        "wenig. Ein riesiges Spinnennetz haengt zerschnitten im Gang in "
        "Richtung Osten. Es sieht so aus, als ob es erst gerade zerstoert "
        "wurde.";
    }
  return BS(txt);
}
string decke(string key)
{
    if ( spinneda )
    {
    return(BS("An der Decke haengen ein paar kleinere Spinnweben, sie sind bei "
            "weitem nicht so gross wie das Spinnennetz, welches den Weg "
            "nach Osten versperrt."));
    }
    else
    {
    return(BS("An der Decke haengen ein paar kleinere Spinnweben, sie sind bei "
            "weitem nicht so gross wie das Spinnennetz, welches den Weg "
            "nach Osten versperrt haben muss. Es ist jedoch zerschnitten "
            "worden."));
    }
}
string netz(string key)
{
    if ( spinneda )
    {
    return(BS("Das Spinnennetz sieht intakt und recht neu aus. Es versperrt den "
            "Weg in Richtung Osten."));
    }
    else
    {
    return(BS("Das Spinnennetz wurde anscheined von jemandem zerschnitten, der "
              "vor Dir diesen Weg genommen hat."));
    }
}
string osten(string key)
{
    if ( spinneda )
    {
    return(BS("Der Weg nach Osten ist durch ein grosses Spinnennetz versperrt. "
            "Du kannst das Netz ja mal beruehren, um zu sehen, wie stabil es "
            "ist."));
    }
    else
    {
    return(BS("Der Weg nach Osten ist ist frei und wird nicht mehr durch ein "
              "Netz versperrt."));
    }
}


