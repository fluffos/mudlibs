// von Chivas
inherit "std/room";

#include "../def.h"

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einem Tempel im Dschungel");
  SetProp( P_INT_LONG,
        "Der Boden ist mit Pflanzen bewachsen. Die Aussenmauern des Tempels "
        "haben einige kleiner Loecher, durch die ein paar Pflanzen wohl ins "
        "Innere vorgedrungen sind. Auch ein paar Zeichen sind an der Mauer zu "
        "erkennen." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 30, ENV_TERRAIN: TT_JUNGLE]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"boden"}), 
            "Am Boden wachsen lauter kleine Pflanzen.");

  AddDetail( ({"pflanzen"}),
	    "Es sind ein paar Graeser und Moose.");

  AddDetail( ({"aussenmauern","mauern","mauer","aussenmauer","wand"}),
	    "An der Aussenmauer des Tempels sind kleine Loecher zu erkennen. "
            "Weiterhin sind lauter Ranken an der Wand zu sehen, die sich durch "
            "die Loecher in den Tempel vorgewagt haben. Auch ein paar Fenster "
            "sind vorhanden.");

  AddDetail( ({"tempels","tempel"}), 
            "Du bist an einem Tempel im Dschungel.");

  AddDetail( ({"loecher"}),
	    "Woher die kleinen Loecher stammen, kannst Du nicht heraus finden. "
            "Ein paar Ranken haben sich durch die Loecher in das Innere des "
            "Tempels vorgewagt.");

  AddDetail( ({"zeichen"}),
	    "Die Zeichen stellen eine Warnung dar."); 
  
  AddDetail( ({"himmel"}), 
            "Der Himmel ist herrlich blau.");

  AddDetail( ({"graeser"}),
	    "Die Graeser wachsen am Boden. Sie sind noch nicht sehr hoch "
            "gewachsen.");

  AddDetail( ({"moose","moos"}),
	    "Das Moos ist weich und gruen.");

  AddDetail( ({"ranken"}), 
            "Die Ranken sind an der Aussenmauer raufgewachsen und einige von "
            "den Ranken haben sich anscheinend in das Innere des Tempels "
            "vorgewagt.");

  AddDetail( ({"dschungel"}),
	    "Du bist mitten im Dschungel auf einem Tempel.");

  AddDetail( ({"innere"}),
	    "Was im Inneren des Tempels ist, kannst Du von hier nicht "
            "erkennen, da die vorhandenen Fenster mit einem magischen "
            "Schleier ueberzogen sind."); 
  
  AddDetail( ({"fenster","fenstern","moeglichkeit","sicht"}), 
            "Die grossen Fenster geben Dir nicht die Moeglichkeit in den "
            "Tempel zu schauen, da ein magischer Schleier ueber den Fenstern "
            "Dir die Sicht versperrt.");

  AddDetail( ({"schleier","magie","chance"}),
	    "Der magische Schleier verbirgt das Innere des Tempels vor Dir. "
            "Du kannst Dir vorstellen, dass es von innen auch nicht die "
            "Chance gibt nach draussen zu schauen.");

  AddDetail( ({"warnung"}),
	    "Die Warnung besagt, dass Du den Tempel besser nie betreten "
            "solltest. Ob die Person schlechte Erfahrungen im Tempel gemacht "
            "hat?");

  AddDetail( ({"person","erfahrungen","muehe"}), 
            "Die Erfahrungen muessen sehr schlecht gewesen sein, ansonsten "
            "haette die Person sich sicher nicht die Muehe gemacht, die "
            "Warnung hier in die Mauer zu ritzen.");

  AddSmell(DEFAULT_SMELL, "Es riecht nach Dschungel.");  
 
  AddSmell( ({"dschungel","geruch"}),
	   "Der Geruch ist nicht richtig beschreibbar.");

  AddSound(DEFAULT_SOUND, "Du hoerst den Wind wehen.");

  AddSound( ({"wind","lueftchen"}),
	   "Es ist eigentlich kein Wind sonder eher ein Lueftchen.");
  
//-----Details Ende-----
  
AddExit("osten", ROOM "tem1-14");
AddExit("westen", ROOM "tem1-16");

}

