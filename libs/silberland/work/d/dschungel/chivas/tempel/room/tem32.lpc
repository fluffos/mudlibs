// von Chivas
inherit "std/room";

#include "../def.h"

void create()
	
{
  ::create();


  SetProp( P_INT_SHORT, "In einem Tempel");
  SetProp( P_INT_LONG,
        "Du befindest Dich in einer Kammer irgendwo im Tempel, wo Dich das "
        "blaue Portal hinbefoerdert hat. Die Waende sind mit Fresken und "
        "Malereien verziert und an der Suedwand steht ein kleiner Altar, auf "
        "dem hunderte von blutroten Kerzen brennen. Anscheinend ist der Tempel "
	"noch immer bewohnt und es werden greuliche Rituale vollfuehrt. " );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  
  AddDetail( ({"kammer"}), 
            "Die Kammer ist eckig und Du hast keine Ahnung, wo sie sich im "
            "Tempel befindet.");

  AddDetail( ({"tempel","ort","orientierung"}),
	    "Du bist irgendwo im Tempel. Dass Du keinerlei Orientierung mehr "
            "hast, beunruhigt Dich ein wenig.");

  AddDetail( ({"portal"}),
	    "Das blaue Portal hat Dich an diesen Ort gebracht. Wo er sich "
            "im Tempel befindet weisst Du nicht.");

  AddDetail( ({"waende"}), 
            "Du siehst Fresken und Malereien an den Waenden. An der Suedwand "
            "steht ausserdem ein kleiner dunkler Altar.");

  AddDetail( ({"fresken"}),
	    "Die Fresken sind scheusslich und sehen ekelig aus. Aber an sowas "
            "hast Du Dich ja schon gewoehnt.");

  AddDetail( ({"malereien","farbe"}),
	    "Die Malereien sind am verblassen und die Farbe blaettert von den "
            "Waenden. Die Malereien, die Du noch erkennen kannst, zeigen "
            "Reiter."); 
  
  AddDetail( ({"suedwand"}), 
            "An der Suedwand steht ein Altar.");

  AddDetail( ({"altar"}),
	    "Auf dem Altar brennen hunderte von Kerzen. Ausserdem erkennt man "
            "ein paar Gefaesse auf dem Altar.");

  AddDetail( ({"kerzen","schlussfolgerung"}),
	    "Die Kerzen brennen, was Dich ein wenig beunruhigt, da ja jemand "
            "sie angezuendet haben muss. Woraus man die Schlussfolgerung "
            "ziehen kann, dass der Tempel immer noch bewohnt wird.");

  AddDetail( ({"rituale"}), 
            "Es wurden in der Vergangenheit boesartige Rituale in diesem "
            "Tempel durchgefuehrt. Da die Kerzen auf dem Altar frisch "
            "angezuendet aussehen, scheint es wohl immer noch so zu sein. "
            "Deine Nackenhaare stellen sich auf.");

  AddDetail( ({"boden"}),
	    "Am Boden ist nichts interessantes zu erkennen, ausser ein wenig "
            "Wachs, dass von den Kerzen auf den Boden getropft ist.");

  AddDetail( ({"decke","himmel"}),
	    "An der Decke gibt es nicht viel zu sehen, ausser ein paar kleinen "
            "Spinnweben."); 
  
  AddDetail( ({"ahnung"}), 
            "Du weisst nicht sehr viel.");

  AddDetail( ({"reiter","apokalypse"}),
	    "Es sind die drei Reiter der Apokalypse. Du willst ihnen nie "
            "begegnen.");

  AddDetail( ({"gefaesse"}),
	    "Die Gefaesse werden wohl fuer irgendwelche Rituale gebraucht.");

  AddDetail( ({"vergangenheit"}), 
            "Von Vergangenheit kann man eigentlich nicht sprechen, da der "
            "Tempel ja anscheinend immer noch benutzt wird.");

  AddDetail( ({"nackenhaare","nacken"}),
	    "Du besitzt sehr viele Nackenhaare. Rasier Dir den Nacken mal.");

  AddDetail( ({"spinnweben"}),
	    "Die Spinnweben sind sehr alt und sehen verlassen aus."); 
  
  AddDetail( ({"wachs"}), 
            "Das Wachs ist von den Kerzen herunter getropft und am Boden "
            "erstarrt.");
  AddSmell(DEFAULT_SMELL, "Es riecht nach Kerzen.");  
 
  AddSmell( ({"kerzen"}),
	   "Die Kerzen riechen ein wenig nach Weihrauch.");

  AddSmell( ({"weihrauch","geruch"}),
	   "Du magst diesen Geruch nicht.");

  AddSound(DEFAULT_SOUND, "Du hoerst das Flackern der Kerzen.");

  AddSound( ({"flackern","kerzen"}),
	   "*flacker**flacker**flacker**flacker*");
  
//-----Details Ende-----
  
AddExit("norden", ROOM "tem33");

}

