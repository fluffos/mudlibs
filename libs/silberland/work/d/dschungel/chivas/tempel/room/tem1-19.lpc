// von Chivas
inherit "std/room";

#include "../def.h"

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "Auf einem Tempel im Dschungel");
  SetProp( P_INT_LONG,
        "Der Tempel zeigt von aussen sein uebliches Bild. Durch die Fenster "
        "kann man nichts erkennen, da ein magischer Schutz auf ihnen zu "
        "liegen scheint. Zwischen den Fenstern und den Pflanzen, die am Tempel "
        "hochwachsen, sind ein paar Symbole zu sehen." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 30, ENV_TERRAIN: TT_JUNGLE]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----

  AddDetail( ({"tempel"}), 
            "Du bist auf einem Tempel.");

  AddDetail( ({"bild"}),
	    "Die ueblichen Pflanzen sind zu sehen.");

  AddDetail( ({"fenster","fenstern","moeglichkeit"}),
	    "Es besteht nicht die Moeglichkeit durch die Fenster in den "
            "Tempel zu schauen, da mit Magie ein Schutz ueber die Fenster "
            "gelegt wurde.");

  AddDetail( ({"schutz","magie","innere"}), 
            "Der magische Schutz auf den Fenstern ermoeglicht es Dir nicht, in "
            "das Innere des Tempels zu schauen.");

  AddDetail( ({"pflanzen"}),
	    "Du siehst ein paar Graeser, Blumen und Moose am Boden und einige "
            "Schlingpflanzen an der Aussenmauer des Tempels.");

  AddDetail( ({"symbole"}),
	    "Die Symbole sind eine uralte Sprache."); 
  
  AddDetail( ({"boden"}), 
            "Am Boden siehst Du einige Graeser, Blumen und Moose.");

  AddDetail( ({"himmel"}),
	    "Der Himmel ist schoen blau und die Sonne steht fast senkrecht.");

  AddDetail( ({"schlingpflanzen"}),
	    "Ein paar Schlingpflanzen haengen an der Aussenmauer des Tempels.");

  AddDetail( ({"blumen","pracht"}), 
            "Die kleinen Blumen am Boden bluehen in aller Pracht.");

  AddDetail( ({"moos","moose"}),
	    "Die Moose sind sehr weich und es ist angenehm weich.");

  AddDetail( ({"graeser"}),
	    "Die Graeser sind noch nicht sehr hoch gewachsen."); 
  
  AddDetail( ({"sprache"}), 
            "Du kennst diese Sprache nicht und weisst auch nicht, was die "
            "Symbole bedeuten. Jedoch kannst Du es Dir bei dem Anblick eines "
            "Totenkopfes und eines Kreuzes auch vorstellen.");

  AddDetail( ({"totenkopfes","totenkopf"}),
	    "Der Totenkopf hat sicher nichts gutes zu bedeuten.");

  AddDetail( ({"kreuz","kreuzes"}),
	    "Das Kreuz beruhigt Dich auch nicht gerade.");

  AddDetail( ({"anblick"}), 
            "Der Anblick einiger Symbole erschreckt Dich.");

  AddDetail( ({"sonne"}),
	    "Die Sonne waermt Dich angenehm.");

  AddDetail( ({"aussenmauer","mauer"}),
	    "An der Aussenmauer haengen ein paar Schlingpflanzen und die "
            "magisch geschuetzten Fenstern sind zu sehen."); 
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Blumen.");  
 
  AddSmell( ({"blumen"}),
	   "Die Blumen am Boden duften herrlich.");

  AddSound(DEFAULT_SOUND, "Du hoerst den magischen Schutz der Fenster "
                          "knistern.");

  AddSound( ({"schutz","magie","fenster"}),
	   "**knister*knister*knister**");
  
//-----Details Ende-----
  
AddExit("sueden", ROOM "tem1-18");
AddExit("norden", ROOM "tem1-20");

}

