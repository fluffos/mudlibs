// von Chivas
inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

int daemonda;

void create()
	
{
  ::create();

   daemonda=1; 

  SetProp( P_INT_SHORT, "In einem Tempel");
  SetProp( P_INT_LONG,
        "Diese Kammer wurde anscheinend in der Vergangenheit oder vielleicht "
        "auch immer noch als Folterkammer benutzt. An den Waenden haengen "
        "lauter Ketten und Halterungen, in denen Personen festgeschnallt werden "
        "koennen. Ausserdem sind im ganzen Raum alle moeglichen Geraete "
        "verteilt. Eingige sehen so aus, als ob sie immer noch gewartet "
        "werden und die letzte Benutzung nicht lange her ist." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----
  
  AddDetail( ({"kammer","folterkammer","raum"}), 
            "Diese Kammer wurde oder wird vielleicht immer noch als "
            "Folterkammer benutzt. Du hoffst, dass Du hier nie angekettet "
            "wirst.");

  AddDetail( ({"vergangenheit"}),
	    "In der Vergangenheit waren die Ketten und Halterungen sicher "
            "immer voll besetzt. Momentan siehst Du keine Person, die hier "
            "festgehalten wird.");

  AddDetail( ({"waenden","waende","wand"}),
	    "An den Waenden haengen schwere Ketten und eiserne Halterungen. "
            "Ausserdem siehst Du die ueblichen Fackeln mit ihren roetlichen "
            "Schein.");

  AddDetail( ({"ketten"}), 
            "Die schweren Ketten halten jeden an der Wand fest, der damit "
            "einmal festgebunden ist. Auf ihnen liegt auch ein magischer "
            "Schimmer.");

  AddDetail( ({"halterungen","griff"}),
	    "Die eisernen Halterungen an den Waenden lassen niemanden aus "
            "ihrem eisernen Griff. Auf ihnen liegt ein magischer Schimmer.");

  AddDetail( ({"personen","person"}),
	    "Momentan siehst Du hier keine Person, die festgeschnallt an den "
            "Waenden haengt."); 
  
  AddDetail( ({"geraete","sachen"}), 
            "Verschiedene Geraete stehen in der Kammer rum. Du siehst eine "
            "grosse Streckbank und andere Sachen, die Du nicht zuordnen "
            "kannst. In der einen Ecke siehst Du noch etwas sehr "
            "interessantes.");

  AddDetail( ({"benutzung","zustand"}),
	    "Die Streckbank und auch die anderen Geraete sind in einem sehr "
            "guten Zustand. Es sieht so aus als ob sie von irgend jemanden "
            "immer noch gewartet werden, da sie wohl immer noch in Benutzung "
            "sind.");

  AddDetail( ({"boden"}),
	    "Ehemals weisse Marmorplatten sind am Boden zu erkennen. Sie sind "
            "jedoch sehr schmutzig.");

  AddDetail( ({"decke","himmel"}), 
            "Auch von der Decke haengen einige Ketten herunter.");

  AddDetail( ({"schein","fackeln"}),
	    "Der roetliche Schein der Fackeln erhellt die Kammer.");

  AddDetail( ({"schimmer","ausbrechen"}),
	    "Der magische Schimmer auf den Ketten und Halterungen scheint "
            "sie noch zu verstaerken und ein Ausbrechen unmoeglich zu "
            "machen."); 
  
  AddDetail( ({"streckbank","bank"}), 
            "Die Streckbank ist in einem tadelosen Zustand. Sie wurde "
            "anscheinend erst vor kurzem benutzt.");

  AddDetail( ({"ecke"}),
	    "In der Ecke steht eine Eiserne Jungfrau.");

  AddDetail( ({"marmorplatten","platten","marmor"}),
	    "Die Platten aus ehemals weissen Marmor sind mit getrocknetem "
            "Blut beschmutzt.");

  AddDetail( ({"blut","farbe"}), 
            "Das Blut ist getrocknet und hat eine schwarze Farbe.");

  AddDetail( ({"eiserne","jungfrau","eiserne jungfrau"}),
	    "Die Eiserne Jungfrau ist geschlossen. Aber irgendetwas scheint "
            "darin gefangen zu sein. Du koenntest ja probieren die 'Eiserne "
            "Jungfrau' zu oeffnen.");

  AddDetail( ({"windzug"}),
	    "Ein kleiner Windzug ist durch die Kammer gezogen."); 
  
  AddSmell(DEFAULT_SMELL, "Du riechst einen uebelen Geruch.");  
 
  AddSmell( ({"geruch","ecke"}),
	   "Der Geruch kommt aus der Ecke.");

  AddSound(DEFAULT_SOUND, "Du hoerst wie die Ketten an den Waenden "
                          "ein wenig rasseln.");

  AddSound( ({"ketten"}),
	   "Anscheinend hat ein kleiner Windzug die Ketten bewegt.");
  
//-----Details Ende-----
  
AddExit("osten", ROOM "tem3-5");
AddExit("westen", ROOM "tem3-3");
AddExit("sueden", ROOM "tem3-1");

AddCmd( ({"oeffne" }), "oeffnen" );

}
void reset()
{
  ::reset();
  daemonda=1;
}
int oeffnen(string str)
{
  object daemon;
  notify_fail ("Was moechtest Du oeffnen?\n");

  if(!(str == "jungfrau","eiserne jungfrau" )) return 0;
  if (present("CHIVASDDAEMON",TO) || !daemonda)

  {
    write(BS("Du kannst die Eiserne Jungfrau momentan nicht oeffnen, sie "
             "klemmt."));
    return -1;
  }
  write(BS("Du probierst die Eiserne Jungfrau zu oeffnen und brichst sie auf. "
           "Ein grosser Daemon erscheint aus der Jungfrau.\n"));
  daemonda=0;
  daemon = clone_object (NPC "daemong" );
  daemon->move(TO,M_GO|M_NOCHECK,"kommt an");
  return 1;
}

