// von Chivas
inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  AddRoomMessage( ({ "Ein paar Schlingpflanzen probieren nach Dir zu greifen.\n"}),
                     30, "sound" );


  SetProp( P_INT_SHORT, "In einem Tempel");
  SetProp( P_INT_LONG,
        "Ploetzlich stehst Du im prallen Sonnenlicht, ein Fenster in diesem "
        "Gang laesst das ganze Sonnenlicht herein scheinen. Einige Pflanzen "
        "haben sich durch die Oeffnung in den Tempel vorgewagt und hier "
        "Wurzeln geschlagen. Es sieht fast so aus, als ob man hier ein wenig "
        "verschnaufen kann." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  
  AddDetail( ({"sonnenlicht","licht"}), 
            "Das Sonnenlicht blendet Dich fast ein wenig, Deine Augen muessen "
            "sich erst einmal an die Helligkeit gewoehnen.");

  AddDetail( ({"fenster","fenstern"}),
	    "Der magische Schimmer, der sonst auf dieser Ebene auf den "
            "Fenstern liegt, ist beinahe verschwunden. Das Sonnenlicht kann "
            "fast ungehindert eindringen und Du kannst sogar den Himmel ein "
            "wenig sehen.");

  AddDetail( ({"gang"}),
	    "Der Gang erstrahlt in hellem Licht. Er ist zwar nicht sehr "
            "schoen, trotzdem fuehlst Du Dich hier besser als in den anderen "
            "Gaengen.");

  AddDetail( ({"pflanzen"}), 
            "Die Pflanzen haben sich bis in den Tempel vorgekaempft und hier "
            "Wurzeln geschlagen. Es sieht fast so aus, als ob das Boese auf "
            "sie abfaerbt und probieren nach Dir zu greifen.");

  AddDetail( ({"oeffnung"}),
	    "Die Oeffnung sind die Fenster, wo der magische Schutz nicht mehr "
            "aktiv zu sein scheint. Jedenfalls ist er nicht mehr so stark wie "
            "an anderen Stellen im Tempel.");

  AddDetail( ({"tempel"}),
	    "Der Tempel ist ausnahmsweise mal nicht so schaurig. Dies liegt "
            "sicher an dem vielen Licht, dass durch die Fenster herein "
            "scheint."); 
  
  AddDetail( ({"wurzeln"}), 
            "Die Pflanzen wachsen an dieser Stelle auch im Tempel. Sie sind "
            "durch die Oeffnung in den Tempel vorgedrungen.");

  AddDetail( ({"wand","waende","waenden"}),
	    "An den Waenden sind die Fenster und ansonsten kahle Mauern.");

  AddDetail( ({"boden"}),
	    "Der Boden ist mit den ueblichen Steinplatten ausgelegt.");

  AddDetail( ({"decke"}), 
            "Die Decke ist schmucklos.");

  AddDetail( ({"augen"}),
	    "Deine Augen muessen sich erst an das helle Licht gewoehnen.");

  AddDetail( ({"helligkeit"}),
	    "Die Helligkeit ueberrascht Dich sehr. Da bisher alle Fenster "
            "mit einem magischen Schimmer ueberzogen waren und das Licht "
            "groesstenteils ausgeschlossen hat."); 
  
  AddDetail( ({"schimmer"}), 
            "Der magische Schimmer ist auf diesen Fenstern fast verschwunden. "
            "Du koenntest vielleicht sogar aus dem Fenster klettern.");

  AddDetail( ({"himmel"}),
	    "Der Himmel scheint blau zu sein und einige weisse Wolken sind "
            "wohl zu sehen.");

  AddDetail( ({"wolken"}),
	    "Du bist Dir nicht sicher, aber Du kannst es ja ueberpruefen, Du "
            "musst nur durch das Fenster klettern.");

  AddDetail( ({"gaenge","gaengen"}), 
            "Die anderen Gaenge sind dunkel und duester und ueberall lauert "
            "das Boese.");

  AddDetail( ({"boese"}),
	    "Das Boese ist eindeutig in den Tempel zurueckgekehrt.");

  AddDetail( ({"schlingpflanzen"}),
	    "Die Schlingpflanzen probieren nach Dir zu greifen, aber Du "
            "entkommst ihnen leicht."); 
  
  AddDetail( ({"stellen"}), 
            "An anderen Stellen ist die Magie noch intensiver als hier.");

  AddDetail( ({"schutz"}),
	    "Der Schutz wurde hier anscheinend gebrochen. Der magische "
            "Schimmer ist fast verschwunden.");

  AddDetail( ({"stelle"}),
	    "Es gibt hier viel Licht und das ist gut so.");

  AddDetail( ({"mauern","mauer"}), 
            "Du siehst die kahlen Steinbloecke.");

  AddDetail( ({"steinbloecke","bloecke","tonnen"}),
	    "Sie wiegen sicher mehrere Tonnen und sind grob behauen.");

  AddDetail( ({"steinplatten","platten"}),
	    "Die Steinplatten sind mit ein wenig Staub und vielen Blaettern "
            "bedeckt."); 
  
  AddDetail( ({"staub"}), 
            "Im Staub erkennst Du Spuren.");

  AddDetail( ({"spuren"}),
	    "Die Spuren stammen nicht nur von Dir, was Dich schon wieder ein "
            "wenig beunruhigt.");

  AddDetail( ({"blaettern","blaetter"}),
	    "Die Blaetter stammen von den Pflanzen.");

  AddDetail( ({"ebene"}), 
            "Du bist auf der ersten Ebene im Tempel. Es liegen noch einige "
            "vor Dir.");

  AddDetail( ({"magie"}),
	    "Die Magie im Tempel ist normalerweise noch sehr stark.");

  AddSmell(DEFAULT_SMELL, "Du riechst die Pflanzen.");  
 
  AddSmell( ({"pflanzen"}),
	   "Die Pflanzen riechen gut, viel besser als die abgestandene Luft, "
           "die Du sonst hier im Tempel riechst.");

  AddSmell( ({"luft"}),
	   "Hier ist die Luft einigermassen angenehm.");


  AddSound(DEFAULT_SOUND, "Du hoerst ein paar Laute von aussen.");

  AddSound( ({"laute","dschungel"}),
	   "Die Laute kommen aus dem Dschungel.");
  
//-----Details Ende-----
  
AddExit("norden", ROOM "tem1-7");
AddExit("sueden", ROOM "tem1-5");

AddCmd( ({"kletter", "klettere" }), "klettern" );

}
int klettern(string str)
{
   notify_fail("Wo raus moechtest Du klettern?\n");
   if ( member( ({ "aus fenster","durch fenster" }),str) != -1) 
  {
    write(BS( "Du kletterst aus dem Fenster und merkst, dass Dich nur ein "
           "kleiner Widerstand zurueck zu halten scheint. Du erreichst "
           "die erste Ebene ausserhalb des Tempels und die Sonne waermt "
           "Dich.\n"));
     TP->move(ROOM "tem1-20", M_GO, 
     "aus einem Fenster und verschwindet",  "klettert");
    return 1;
  }
}

