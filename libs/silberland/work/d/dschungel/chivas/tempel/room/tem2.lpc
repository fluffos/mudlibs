// von Chivas
inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();


  SetProp( P_INT_SHORT, "Auf einem Dschungelpfad");
  SetProp( P_INT_LONG,
        "Ueberall sind Baeume und Pflanzen dicht um Dich herum. Man kann den "
        "Pfad der weiter Richtung Sueden fuehrt kaum noch erkennen, da die "
	"Pflanzen kaum Licht durchlassen. Man kann jedoch ueberall Blumen in "
        "den verschiedensten Farben erkennen, die den Pfad saeumen. Trotz der "
        "Lichtverhaeltnisse ist es recht idyllisch." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 30, ENV_TERRAIN: TT_JUNGLE]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  
  AddDetail( ({"baeume"}), 
            "Die Baeume stehen sehr dicht und sind sehr gross. Sie sind mit "
            "Ranken zugewachsen.");

  AddDetail( ({"pflanzen"}),
	    "Alle moeglichen Pflanzen sind hier zu sehen. Du erkennst Gras und "
            "Blumen am Boden, Straeucher und Schlingpflanzen am Rand des "
            "Pfades und natuerlich die grossen Baeume.");

  AddDetail( ({"pfad","pfades"}),
	    "Der Pfad fuehrt immer weiter in den Dschungel herein.");

  AddDetail( ({"richtung","richtungen"}), 
            "Es geht nach Suedwesten weiter in den Dschungel oder nach Norden "
            "aus dem Dschungel wieder raus.");

  AddDetail( ({"sueden"}),
	    "Nach Sueden bzw. nach Suedwesten geht es weiter in den "
            "Dschungel hinein.");

  AddDetail( ({"licht","lichtverhaeltnisse","lichtes"}), 
            "Die Lichtverhaeltnisse sind nicht sehr gut, da das Blaetterdach "
            "sehr dicht ist. Trotz des wenigen Lichtes ist es sehr idyllisch.");

  AddDetail( ({"blumen","blumenmeer","meer","farbenmeer"}),
	    "Viele Blumen wachsen am Boden und einige an den Baeumen. "
            "Sie leuchten in den unterschiedlichsten Farben. Du erkennst "
            "Orchideen und andere Arten am Boden und einige Epiphyten an den "
            "Baeumen.");

  AddDetail( ({"farben","farbe"}),
	    "Die Blumen leuchten in Gelb, Rot, Blau und noch anderen Farben. "
            "Die Hauptfarbe aber im Dschungel ist Gruen.");

  AddDetail( ({"boden"}), 
            "Am Boden sind ein paar Graeser und viele Blumen zu sehen.");

  AddDetail( ({"himmel"}),
	    "Der Himmel ist nicht zu sehen.");

  AddDetail( ({"rand","durchkommen"}),
	    "Am Rand des Pfades ist alles dicht zugewachsen, so dass ein "
            "Durchkommen nicht moeglich ist."); 
  
  AddDetail( ({"schlingpflanzen"}), 
            "Grosse Schlingpflanzen haengen von den Baeumen herunter.");

  AddDetail( ({"ranken","unterart","efeu","efeus","botanikwissen"}),
	    "Die Ranken an den Baeumen scheinen eine Unterart des Efeus zu "
            "sein. Du bist stolz auf den Botanikwissen.");

  AddDetail( ({"straeucher","straeuchern"}),
	    "Einige Straeucher stehen am Rand des Pfades und zwingen dem Pfad "
            "die Richtung auf.");

  AddDetail( ({"gras","graeser"}), 
            "Einige Graeser wachsen am Boden und unterbrechen das Farbenmeer "
            "der Blumen.");

  AddDetail( ({"suedwesten","norden"}),
	    "Das sind die Richtungen in die Du gehen kannst.");

  AddDetail( ({"arten"}),
	    "Die anderen Blumen kennst Du nicht."); 
  
  AddDetail( ({"orchideen","familien","pflanzenreich","rueckkehr","thema"}), 
            "Orchideen, eine der groessten, weltweit verbreiteten Familien im "
            "Pflanzenreich. Du beschliesst Dich nach Deiner Rueckkehr mehr "
            "mit dem Thema zu beschaeftigen.");

  AddDetail( ({"epiphyten","aerophyten","luftpflanzen"}),
	    "Epiphyten, auch Aerophyten oder Luftpflanzen sind Pflanzen, die "
            "nicht im Boden wurzeln, sondern sich an Baeume oder andere hohe "
            "Objekte heften.");

  AddDetail( ({"objekte","mauern","sachen"}),
	    "Damit sind Mauern oder andere Sachen gemeint.");

  AddDetail( ({"hauptfarbe","gruen"}), 
            "Die ueberwiegende Farbe hier im Dschungel ist das Gruen der "
            "Blaetter an den Baeumen und Straeuchern.");

  AddDetail( ({"gelb"}),
	    "Einige der Orchideen bluehen in einem strahlenden Gelb.");

  AddDetail( ({"blau"}),
	    "Durch die blauen Orchideen am Boden wirkt alles farblich gut "
            "aufeinander abgestimmt."); 
  
  AddDetail( ({"rot"}), 
            "Die roten Blumen kennst Du nicht, findest aber, dass sie sehr "
            "gut hier her passen.");

  AddDetail( ({"blaetter","blaetterdach","dach","wipfeln","wipfel"}),
	    "Die Blaetter bilden oben in den Wipfeln ein dichtes Dach, dass "
            "kaum Licht durchlaesst.");

  AddDetail( ({"dschungel"}),
	    "Du befindest Dich mitten drin. Unglaublich!");

  AddDetail( ({""}), 
            "");

  AddDetail( ({""}),
	    "");

  AddDetail( ({""}),
	    ""); 
  
  AddSmell(DEFAULT_SMELL, "Die Blumen duften herrlich.");  
 
  AddSmell( ({"blumen","duft"}),
	   "Die Blumen stroemen einen suesslichen Duft aus.");

  AddSound(DEFAULT_SOUND, "Du hoerst ein paar Insekten durch die Luft "
                          "schwirren und andere Tiere im Dschungel.");

  AddSound( ({"insekten","luft"}),
	   "summ, summ, summ");
  
  AddSound( ({"tiere"}),
	   "Einige Voegel sind zu hoeren. Du kannst sie aber nicht sehen.");

  AddSound( ({"voegel"}),
	   "zwitscher, zwitscher");

//-----Details Ende-----
  
AddExit("norden", ROOM "tem1");
AddExit("suedwesten", ROOM "tem3");

}

