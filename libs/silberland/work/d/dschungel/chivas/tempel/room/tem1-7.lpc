// von Chivas
inherit "std/room";

#include "../def.h"

void create()
	
{
  ::create();

  SetProp( P_INT_SHORT, "In einem Tempel");
  SetProp( P_INT_LONG,
        "Die Waende machen einen bedrueckenden Eindruck, da die vermoderten "
        "Teppiche hier noch herunter gekommener aussehen als zuvor. Ausserdem "
        "scheinen die Waende dahinter sich zu bewegen und zu pulsieren, "
        "als ob Etwas durch die Waende kriecht. Der Boden ist feucht und "
        "weist einige Risse auf.");
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  
  AddDetail( ({"waende","wand"}), 
            "Die Waende scheinen zu pulsieren, was Dich sogar von den "
            "Fenstern und den vermoderten Teppichen ablenkt.");

  AddDetail( ({"eindruck"}),
	    "Die Teppiche an der Wand machen nicht gerade einen neuwertigen "
            "Eindruck auf Dich.");

  AddDetail( ({"teppiche","teppichen"}),
	    "Die Teppiche sind vermodert und die Muster verblasst.");

  AddDetail( ({"etwas"}), 
            "Du fragst Dich, was da durch die dicken Waende kriechen koennte. "
            "Du hoffst nur, dass es nicht irgendwo einen Ausgang findet und "
            "sich auf Dich stuerzt.");

  AddDetail( ({"boden"}),
	    "Der Boden ist feucht und einige Pfuetzen haben sich gebildet. "
            "Ausserdem kann man einige Risse sehen.");

  AddDetail( ({"risse"}),
	    "Die Risse im Boden sind tief. Aber es scheint nichts in ihnen "
            "zu sein. Aber Du kannst ja mal mit der Hand in einen Riss "
            "greifen. Aber sei gewarnt."); 
  
  AddDetail( ({"decke"}), 
            "Die Decke ist hoch ueber Dir und recht schmucklos. Das einzig "
            "interessante ist ein alter Kronleuchter.");

  AddDetail( ({"fenster","fenstern"}),
	    "Die Fenster lassen ein wenig Licht herein und sind mit dem "
            "ueblichen magischen Schimmer ueberzogen.");

  AddDetail( ({"muster"}),
	    "Du kannst die Muster nur noch erahnen. Es handelte sich wohl um "
            "ein paar Kreise und Linien als Muster.");

  AddDetail( ({"kreise","linien"}), 
            "Du bist Dir nicht sicher, aber es koennten welche sein. Es ist "
            "aber auch egal, da die Teppiche langweilig sind.");

  AddDetail( ({"ausgang"}),
	    "Du siehst zwei und hoffst, dass das Etwas in der Wand keinen "
            "findet.");

  AddDetail( ({"kronleuchter","leuchter","jahren"}),
	    "Der Kronleuchter wurde seit Jahren nicht benutzt. Er sieht ein "
            "wenig herunter gekommen aus."); 
  
  AddDetail( ({"licht","lichtes"}), 
            "Es ist nicht viel Licht, aber es reicht um etwas zu erkennen.");

  AddDetail( ({"schimmer","eindringen"}),
	    "Der Schimmer verhindert das Eindringen des Lichtes.");

  AddDetail( ({"himmel"}),
	    "Um den Himmel zu sehen, musst Du den Tempel verlassen.");

  AddDetail( ({"tempel"}), 
            "Du bist auf der ersten Ebene im Tempel.");

  AddDetail( ({"ebene","ebenen"}),
	    "Du hast noch einige Ebenen vor Dir bis zur Tempelspitze.");

  AddDetail( ({"spitze","tempelspitze"}),
	    "Es ist noch ein weiter Weg."); 
  
  AddDetail( ({"weg"}), 
            "Du wirst es sicher schaffen.");

  AddDetail( ({"riss","hand"}),
	    "Wenn Du mutig bist, greifst Du mit der Hand in den Riss.");

  AddDetail( ({"pfuetzen"}),
	    "Einige Pfuetzen haben sich durch die Feuchtigkeit am Boden "
            "gebildet. Du schaust in eine der Pfuetzen und siehst Dein "
            "Spiegelbild.");

  AddDetail( ({"feuchtigkeit"}), 
            "Es ist halt nicht trocken hier im Tempel.");

  AddDetail( ({"spiegelbild"}),
	    "Du hast schon einmal besser ausgesehen.");
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach vermoderten Teppichen.");  
  
  AddSmell( ({"teppiche"}),
	   "Die Teppiche stinken. Du wendest Dich angewidert ab.");

  AddSound(DEFAULT_SOUND, "Du hoerst ein Kraechzen aus der Wand.");

  AddSound( ({"kraechzen","wand"}),
	   "Das Kraechzen stammt von dem Etwas aus der Wand. Du erschauderst.");
  
//-----Details Ende-----
AddItem(NPC "fee", REFRESH_DESTRUCT);
  
AddExit("osten", ROOM "tem1-8");
AddExit("sueden", ROOM "tem1-6");

AddCmd( ({"greif", "greife" }), "greifen" );

}
int greifen(string str)
{
   notify_fail("In was moechtest Du greifen ?\n");
   if ( member( ({ "in riss" }),str) != -1) 
  {
    write(BS( "Du greifst in den Riss und fuehlst etwas am Ende des Risses. Als "
           "Du noch tiefer greifst merkst Du wie sich der Riss ploetzlich "
           "verengt und der Boden nach Dir schnappt. Du kannst gerade so eben "
           "noch Deine Finger rausziehen und nur einer wurde kurz eingeklemmt, "
           "was jedoch auch reicht, da es sehr weh tut.\n"));
    say( TPN+" greift in einen Riss und tut sich weh.\n");
    TP->AddHp(-30);
    return 1;
  }
}
