// von Chivas
inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

int stein_zahl; 

void create()
	
{
  ::create();

   stein_zahl=1;

  SetProp( P_INT_SHORT, "An einem Tempel im Dschungel");
  SetProp( P_INT_LONG,
        "Der Dschungel verdeckt hier fast ganz den Pfad, so dass er nur noch "
        "schemenhaft zu erkennen ist. Der Tempel geht fast komplett in den "
	"Dschungel ueber. Nur an einigen Stellen kann man die Mauern erkennen, "
        "was Dich nicht gerade erfreut, da Dich eklige Fratzen anstarren. " );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_JUNGLE]) );
  SetProp(P_INDOORS, 0);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  
  AddDetail( ({"dschungel"}), 
            "Der Dschungel hat den Pfad fast verdeckt. Er ist kaum noch zu "
            "erkennen.");

  AddDetail( ({"pfad"}),
	    "Der Pfad ist nur noch schlecht zu erkennen. Alle moeglichen "
            "Pflanzen wachsen auf dem Pfad.");

  AddDetail( ({"tempel"}),
	    "Der Tempel ist an dieser Stelle fast komplett zugewachsen. "
            "Ueberall an der Mauer sind Moose und Flechten zu sehen.");

  AddDetail( ({"stellen","stelle"}), 
            "An einigen Stellen, wo keine Moose oder Flechten sind, erkennt "
            "man ein paar eingemeisselte Fratzen im Stein.");

  AddDetail( ({"mauern","mauer"}),
	    "Die Mauern sind fast komplett zugewachsen.");

  AddDetail( ({"fratzen"}),
	    "Die Fratzen stecken Dir die Zunge raus."); 
  
  AddDetail( ({"moose","flechten","moos"}), 
            "Die Moose und Flechten wachsen fast an der ganzen Mauer. Das "
            "Moos hat verschiedene Faerbungen.");

  AddDetail( ({"pflanzen"}),
	    "Die Pflanzen haben hier fast alles ueberwuchert. Ein paar Buesche "
            "wachsen sogar schon auf dem Pfad.");

  AddDetail( ({"stein","steinquadern","steinquader","quader"}),
	    "Die Mauer besteht aus grossen Steinquadern.");

  AddDetail( ({"zunge"}), 
            "Das ist eine Frechheit.");

  AddDetail( ({"frechheit"}),
	    "Auf eine solche Frechheit muss eine Strafe folgen.");

  AddDetail( ({"strafe"}),
	    "Streck den Fratzen doch auch einfach die Zunge raus."); 
  
  AddDetail( ({"buesche"}), 
            "Die Buesche sind zwar noch klein, aber in ein paar Jahren sieht "
            "man sicher von dem Pfad nichts mehr.");

  AddDetail( ({"jahren","jahre","weile"}),
	    "Es dauert noch ein Weile.");

  AddDetail( ({"faerbung","faerbungen"}),
	    "Die Faerbung reicht von Gruen bis Gelb.");

  AddDetail( ({"gruen"}), 
            "Das gruene Moos sieht recht gesund aus.");

  AddDetail( ({"gelb","farbe"}),
	    "Die gelbliche Farbe sieht ein wenig merkwuerdig aus. Als Du "
            "naeher hinschaust, entdeckst Du eine kleine Woelbung unter dem "
            "gelben Moos.");

  AddDetail( ({"woelbung"}),
	    "Hinter dem Moos scheint etwas zu sein. Vielleicht kann man das "
            "Moos abkratzen und nachschauen, was sich dahinter befindet."); 
  
  AddDetail( ({"himmel"}), 
            "Der Himmel ist durch die Blaetter der Baeume kaum zu erkennen.");

  AddDetail( ({"baeume","erscheinungsbild","baeumen"}),
	    "Baeume sind in einem Dschungel ein uebliches Erscheinungsbild.");

  AddDetail( ({"boden"}),
	    "Am Boden wachsen ein paar kleinere Straeucher und junge Baeume.");

  AddDetail( ({"straeucher"}), 
            "Die Straeucher sind auch noch sehr jung. In ein paar Jahren kann "
            "man den Pfad sicher nicht mehr erkennen.");

  AddDetail( ({"jahre","jahren"}),
	    "Es dauert noch Jahre bis es soweit ist.");

  AddDetail( ({"blaetter"}),
	    "Die Blaetter an den hohen Baeumen verbergen den dahinter "
            "liegenden Himmel."); 
  
  AddSmell(DEFAULT_SMELL, "Es riecht nach Dschungel.");  
 
  AddSmell( ({"dschungel","pflanzen"}),
	   "Es riecht nach Pflanzen im Dschungel.");

  AddSound(DEFAULT_SOUND, "Du hoerst momentan ueberhaupt nichts. Sehr "
                          "verdaechtig.");

//-----Details Ende-----
AddItem( "/d/dschungel/dante/weg/npc/dstechmuecke", REFRESH_DESTRUCT,
        ([P_MNPC_DEFAULTROOM: "tem14",
          P_MNPC_AREA:({ROOM "tem14"}),
          P_MNPC_FLAGS: MOV_OUTDOORS + MOV_MAYLOAD + MOV_MOVES
        ]) );
  
AddExit("norden", ROOM "tem13");
AddExit("sueden", ROOM "tem15");

AddCmd( ({"streck", "strecke" }), "strecken" );
AddCmd( ({"kratz", "kratze" }), "kratzen" );

}
void reset()
{
  ::reset();
  stein_zahl=1;
}
int strecken(string str)
{
   notify_fail("Wem moechtest Du was rausstecken?\n");
   if ( member( ({ "fratze zunge raus", "zunge raus" }),str) != -1) 
  {
    write(BS( "Du streckst den Fratzen die Zunge raus. Daraufhin fauchen die "
           "Fratzen Dich an und Du weichst ein wenig zurueck.\n"));
    say( TPN+" wird von der Mauer angefaucht.\n");
    return 1;
  }
}

int kratzen(string str)
{
 object stein;
 if( str != "moos ab"     &&
     str != "gelbes moos ab"              )
 {
  notify_fail("Was moechtest Du abkratzen?\n");
  return 0;
 }
 else
 {
  if(stein_zahl <1)
  {
   write(BS("Irgendwer hat wohl schon das Moos entfernt, Du kommst "
            "anscheinend zu spaet. Vielleicht warst Du es ja auch "
            "selbst!"));
   say(TPN + " sieht enttaeuscht aus.\n");
   return 1;
  }
  else
  {
   write(BS("Du entfernst das Moos mit Deinen Fingernaegeln und hast "
            "ploetzlich einen Edelstein in Deinen Haenden, den Du sofort "
            "einsteckst."));
      switch(random(12))
          {
          case 0: stein = clone_object( "/obj/gems/rubin.lpc");
          break;
          case 1: stein = clone_object( "/obj/gems/diaspor.lpc");
          break;
          case 2: stein = clone_object( "/obj/gems/citrin.lpc");
          break;
          case 3: stein = clone_object( "/obj/gems/amethyst.lpc");
          break;
          case 4: stein = clone_object( "/obj/gems/lapislazuli.lpc");
          break;
          case 5: stein = clone_object( "/obj/gems/saphir.lpc");
          break;
          case 6: stein = clone_object( "/obj/gems/tuerkis.lpc");
          break;
          case 7: stein = clone_object( "/obj/gems/onyx.lpc");
          break;
          case 8: stein = clone_object( "/obj/gems/bergkristall.lpc");
          break;
          case 9: stein = clone_object( "/obj/gems/achat.lpc");
          break;
          case 10: stein = clone_object( "/obj/gems/bernstein.lpc");
          break;
          case 11: stein = clone_object( "/obj/gems/diamant.lpc");
          break;
          } 
   if(stein->move(this_player(), M_GET) != 1)
   {
    tell_object(this_player(), "Du kannst nichts mehr tragen. Du Seicherl!\n");
    stein->move(this_object(), M_NOCHECK);
   }
   stein_zahl--;
   say(TPN+ " tut geheimnisvoll.\n");
   return 1;
  }
 }
}


