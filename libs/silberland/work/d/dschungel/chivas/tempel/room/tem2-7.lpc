// von Chivas
inherit "std/room";

#include "../def.h"

#include <properties.h>

#include  <moving.h>

void create()
	
{
  ::create();

  AddRoomMessage( ({ "Mit lautem Platschen faellt ein Tropfen von der Decke "
                     "vor Dir auf den Boden.\n"}),
                     30, "sound" );

  SetProp( P_INT_SHORT, "In einem Tempel");
  SetProp( P_INT_LONG,
        "Dies ist ein weiterer Verbindungsgang auf der zweiten Ebene. Deine "
        "Schritte hallen auf den Steinplatten am Boden. Man kann sie sicher "
        "ueberall auf der Ebene hoeren. Einige Tropfen fallen von der Decke "
        "und verursachen ein lautes Platschen. Deine Nerven sind zum "
        "Zerreissen gespannt." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

//-----Details Anfang-----

  AddDetail( ({"verbindungsgang","gang"}), 
            "Es ist ein ganz normaler Gang mit den ueblichen Fackeln an den "
            "Waenden.");

  AddDetail( ({"ebene","blutes","blut"}),
	    "Du befindest Dich auf der zweiten Ebene im Tempel des Blutes.");

  AddDetail( ({"schritte"}),
	    "Deine Schritte hallen durch den ganzen Tempel. Falls jemand "
            "hinter der naechsten Ecke ist, so weiss er schon, dass Du kommst.");

  AddDetail( ({"steinplatten","platten"}), 
            "Die Steinplatten bedecken den Boden. Sie sind vom Wasser ganz "
            "nass.");

  AddDetail( ({"boden"}),
	    "Der Boden besteht aus den ueblichen Steinplatten. Am Boden bilden "
            "sich kleine Pfuetzen.");

  AddDetail( ({"tropfen"}),
	    "Kleine und grosse Tropfen fallen von der Decke auf den Boden."); 
  
  AddDetail( ({"decke","himmel"}), 
            "Die Decke ist duester und Du kannst nicht viel erkennen.");

  AddDetail( ({"platschen"}),
	    "Das Platschen der Tropfen auf den Boden kommt Dir sehr laut vor.");

  AddDetail( ({"nerven","zerreissen","hallen"}),
	    "Durch das laute Hallen Deiner Schritte sind Deine Nerven zum "
            "Zerreissen gespannt.");

  AddDetail( ({"wand","waenden","waende"}), 
            "An den Waenden erkennst Du nur die ueblichen Fackeln. Ansonsten "
            "siehst Du die rohen Mauern des Tempels.");

  AddDetail( ({"fackeln"}),
	    "Die Flammen der Fackeln zischeln ein wenig vor sich hin.");

  AddDetail( ({"flammen"}),
	    "Die Flammen leuchten in dem fuer diese Ebene typischen eiskalten "
            "Blau."); 
  
  AddDetail( ({"blau","eis"}), 
            "Das Blau der Flammen sieht fast aus wie Eis.");

  AddDetail( ({"tempel","tempels"}),
	    "Du bist schon recht weit im Tempel voran gekommen.");

  AddDetail( ({"mauern"}),
	    "Die Mauern sind glatt und kalt. Es sind keinerlei Fugen zu "
            "erkennen.");

  AddDetail( ({"fugen"}), 
            "Es scheinen grosse Steinquader zu sein, so dass keine Fugen "
            "da sein koennen.");

  AddDetail( ({"steinquader","quader","tonnen","arbeit"}),
	    "Sie muessen mehrere Tonnen wiegen. Es muss eine harte Arbeit "
            "gewesen sein, den Tempel zu erbauen.");

  AddDetail( ({"ecke","sueden"}),
	    "Es geht nach Sueden."); 
  
  AddDetail( ({"wasser","pfuetzen"}), 
            "Das Wasser stammt von den Tropfen, die von der Decke tropfen.");

  AddSmell(DEFAULT_SMELL, "Es riecht nach dreckigem Wasser.");  
 
  AddSmell( ({"wasser"}),
	   "Das Wasser am Boden riecht ein wenig uebel.");

  AddSound(DEFAULT_SOUND, "Du hoerst Deine eigenen Schritte und das Platschen "
                          "der Tropfen auf den Boden.");

  AddSound( ({"schritte"}),
	   "Deine Schritte hallen sehr laut durch den Tempel.");
  
  AddSound( ({"platschen","tropfen","boden"}),
		"**platsch**plitsch**platsch**plitsch**platsch**");

//-----Details Ende-----
AddItem(NPC "krieg", REFRESH_DESTRUCT);
  
AddExit("sueden", ROOM "tem2-8");
AddExit("osten", ROOM "tem2-6");

}

