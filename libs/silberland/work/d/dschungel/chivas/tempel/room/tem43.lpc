// von Chivas
inherit "std/room";

#include "../def.h"

int werwolfda;

void create()
	
{
  ::create();

  werwolfda=1; 

  SetProp( P_INT_SHORT, "In einem Tempel");
  SetProp( P_INT_LONG,
        "Die Waende dieser Kammer sind mit ein paar Schlingpflanzen "
        "zugewachsen, die wohl einen Weg durch die dicke Aussenmauer gefunden "
        "haben. Das Einzige, was Dich jedoch ein wenig beunruhigt, sind nicht "
        "die Schlingpflanzen, sondern die Kratzspuren am Boden. Es sieht fast "
        "so aus, als ob jemand versucht hat sich festzuhalten. Trotzdem wurde "
        "die Person wohl in die Dunkelheit der Ecken geschleift. " );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  
  AddDetail( ({"waende","wand","waenden"}), 
            "Die Waende sind mit Schlingpflanzen zugewachsen und Du kannst "
            "die Mauer kaum erkennen. Nur an ein paar Stellen, wo die Fackeln "
            "haengen, ist sie zu sehen. ");

  AddDetail( ({"kammer","raum"}),
	    "Die Kammer ist eckig und der Lichtschein der Fackeln dringt nicht "
            "bis in die Ecken vor, was Dich ein wenig beunruhigt.");

  AddDetail( ({"schlingpflanzen","schlingpflanze"}),
	    "Die Schlingpflanzen haben wohl einen Weg durch die Aussenmauer "
            "des Tempels gefunden und sich hier ausgebreitet.");

  AddDetail( ({"aussenmauer","mauer"}), 
            "Eine der Waende scheint eine Aussenmauer zu sein, ansonsten "
            "haette ja keine Schlingpflanze hier eindringen koennen.");

  AddDetail( ({"einzige","kratzspuren","spuren","kratz-","schleifspuren","kratz"}),
	    "Die Spuren fuehren in eine dunkele Ecke. Dies ist sehr "
            "beunruhigend. Du kannst nicht genau erkennen, was in der Ecke "
            "ist.");

  AddDetail( ({"boden"}),
	    "Am Boden sieht man die ueblichen Steinplatten, die mit einer "
            "Schicht Staub belegt sind. Ausserdem erkennt man ganz deutliche "
            "Kratz- und Schleifspuren, die in eine der dunkelen Ecken "
            "fuehren."); 
  
  AddDetail( ({"person","wahrscheinlichkeit"}), 
            "Die Wahrscheinlichkeit ist ziemlich gross, dass die Person, die "
            "in die Ecke geschleift wurde, dort nicht zu Kaffee und Kuchen "
            "eingeladen wurde.");

  AddDetail( ({"dunkelheit"}),
	    "Das Licht der Fackeln reicht nicht bis in die Dunkelheit der "
            "Ecken.");

  AddDetail( ({"ecken","ecke"}),
	    "In der Ecke scheint sich Etwas zu bewegen, aber Du kannst es "
            "nicht genau erkennen.");

  AddDetail( ({"decke","himmel"}), 
            "Die Decke ist schmucklos und uninteressant.");

  AddDetail( ({"stellen","fackeln","halterungen"}),
	    "An den Stellen, wo die Schlingpflanzen nicht die Mauern bedecken, "
            "haengen die Halterungen, in denen die Fackeln stecken, die den "
            "Raum ein wenig erhellen. In die dunklen Ecken dringt jedoch "
            "kein Licht.");

  AddDetail( ({"licht","lichtschein"}),
	    "Das Licht der Fackeln dringt nicht bis in die Ecken vor."); 
  
  AddDetail( ({"weg"}), 
            "Die Schlingpflanzen haben sind durch ein paar Loecher in der "
            "Aussenmauer im Sueden den Weg gebahnt.");

  AddDetail( ({"sueden","orientierung"}),
	    "Die Wand im Sueden ist die Aussenmauer. Es sieht aber nicht so "
            "aus, als ob Dir das sehr bei der Orientierung hilft.");

  AddDetail( ({"kuchen","hunger"}),
	    "Du hast Hunger.");

  AddDetail( ({"kaffee","durst","fragen"}), 
            "Du hast Durst auf Kaffee. Trink aber nicht zu viel, sonst "
            "geht es Dir nicht so gut. Fuer weitere Fragen diesbezueglich "
            "bitte an Rikz wenden.");

  AddDetail( ({"rikz","midas","npc","anfaengerpark"}),
	    "Dies ist ein NPC im Anfaengerpark von Midas.");

  AddDetail( ({"etwas"}),
	    "Du kannst es nicht genau sehen, aber hoeren kannst Du es. "
            "Vielleicht kannst Du es aufscheuchen. Sei aber gewarnt."); 
  
  AddDetail( ({"tempel","tempels"}), 
            "Du kommst immer weiter im Tempel voran.");

  AddDetail( ({"loecher","innere"}),
	    "Durch die Loecher in der Aussenmauer haben sich die "
            "Schlingpflanzen ihren Weg in das Innere des Tempels gebahnt.");

  AddDetail( ({"schicht","staub"}),
	    "In der Schicht aus Staub kann man die Spuren sehr gut erkennen.");

  AddDetail( ({"steinplatten","platten"}), 
            "Die Steinplatten sind mit Staub bedeckt, ansonsten sind sie "
            "uninteressant.");

  AddSmell(DEFAULT_SMELL, "Es riecht nach nassem Fell.");  
 
  AddSmell( ({"fell","geruch"}),
	   "Der Geruch kommt aus einer der dunklen Ecken.");

  AddSound(DEFAULT_SOUND, "Du hoerst ein Knurren aus der Ecke.");

  AddSound( ({"knurren","ecke"}),
	   "Das Knurren klingt boese, Du solltest Dich schnell aus dem Staub "
           "machen.");
  
//-----Details Ende-----
  
AddExit("norden", ROOM "tem42");
AddExit("nordosten", ROOM "tem41");
AddExit("nordwesten", ROOM "tem41");
AddExit("osten", ROOM "tem41");
AddExit("westen", ROOM "tem44");
AddExit("suedosten", ROOM "tem41");
AddExit("suedwesten", ROOM "tem41");
AddExit("sueden", ROOM "tem41");

AddCmd( ({"scheuch", "scheuche" }), "scheuchen" );

}
void reset()
{
  ::reset();
  werwolfda=1;
}

int scheuchen(string str)
{
  object werwolf;
  notify_fail ("Was moechtest Du aufscheuchen?\n");

  if(!(str == "etwas auf" )) return 0;
  if (present("CHIVASWOLF",TO) || !werwolfda)

  {
    write(BS("Es laesst sich momentan nicht aufscheuchen, was wohl auch "
             "besser fuer Dich ist."));
    return -1;
  }
  write(BS("Du nimmst einen Stein, den Du so eben am Boden gefunden hast und "
           "wirfst ihn in die Ecke aus der das Knurren kommt.\n"));
  werwolfda=0;
  werwolf = clone_object (NPC "werwolf.lpc" );
  werwolf->move(TO,M_GO|M_NOCHECK,"springt");
  return 1;
}

