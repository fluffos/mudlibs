// von Chivas
inherit "std/room";

#include "../def.h"

void create()
	
{
  ::create();


  SetProp( P_INT_SHORT, "In einem Tempel");
  SetProp( P_INT_LONG,
        "Du stehst in einer grossen Kammer, die sehr spaerlich eingerichtet "
        "ist. Ein weiteres grosses Portal in der Mitte der Kammer faellt Dir "
        "sofort auf, da es hell schimmert. Andere Lichtquellen gibt es hier "
        "nicht. In den Halterungen an den Waenden stecken keine Fackeln, die "
        "den Raum noch weiter erhellen koennten." );
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp( P_LIGHT, 1 );

  
//-----Details Anfang-----

  
  AddDetail( ({"kammer"}), 
            "Die Kammer ist gross und in der Mitte steht ein Portal.");

  AddDetail( ({"mitte"}),
	    "Genau in der Mitte steht ein grosses, schimmerndes Portal.");

  AddDetail( ({"fackeln"}),
	    "Fackeln sind keine zu sehen, die Halterungen sind leer.");

  AddDetail( ({"lichtquelle"}), 
            "Die einzige Lichtquelle in der Kammer ist das hell schimmernde "
            "Portal.");

  AddDetail( ({"raum"}),
	    "Die Kammer ist gross.");

  AddDetail( ({"waende","waenden","wand"}),
	    "An den Waenden sind die Halterungen fuer Fackeln zu sehen und "
            "einige aeltere Gemaelde haengen an der Wand."); 
  
  AddDetail( ({"decke","himmel"}), 
            "Die Decke ist hoch ueber Dir und man kann nichts interessantes an "
            "ihr entdecken.");

  AddDetail( ({"boden"}),
	    "Der Boden ist feucht und schmutzig. An einigen Stellen sind "
            "ein paar Haufen zu sehen.");

  AddDetail( ({"halterungen"}),
	    "Die Halterungen an den Waenden sind leer.");

  AddDetail( ({"gemaelde"}), 
            "Die Gemaelde sind schon sehr alt und nicht mehr im besten "
            "Zustand. Insgesamt haengen 5 Gemaelde an den Waenden.");

  AddDetail( ({"haufen","stellen"}),
	    "Die Haufen scheinen aus Asche zu sein.");

  AddDetail( ({"asche"}),
	    "Du bist ein wenig verunsichert, was Haufen an Asche zu bedeuten "
            "haben und wie sie hier her kommen. Ob man vielleicht mal einen "
            "der Haufen durchsuchen sollte um heraus zu finden, was das fuer "
            "Haufen sind?"); 
  
  AddDetail( ({"ueberreste"}), 
            "Es ist fast nur Asche uebrig.");

  AddDetail( ({"zaehne"}),
	    "So etwas zu finden ist ekelig.");

  AddDetail( ({"stoff"}),
	    "Von dem Stoff ist nicht viel uebrig. Es ist fast alles verbrannt "
            "und nur noch Asche.");

  AddDetail( ({"metall"}), 
            "Das Metall ist geschmolzen.");

  AddDetail( ({"zustand"}),
	    "Sie sind schon ein wenig verblasst.");

  AddDetail( ({"gemaelde 1","auge","umgebung"}),
	    "Auf dem ersten Gemaelde ist ein grosses Auge in einer schwarzen "
            "Umgebung abgebildet. Das Auge blinzelt sogar. Es ist eindeutig "
            "magisch und veraengstigt Dich ein wenig."); 
  
  AddDetail( ({"gemaelde 2"}), 
            "Auf dem zweiten Gemaelde ist eine brennendes Dorf abgebildet. "
            "Das Dorf scheint das Dorf der Dschungelelfen zu sein.");

  AddDetail( ({"gemaelde 3","loch","paladine","zombies","paladin","zombie"}),
	    "Auf dem dritten Gemaelde ist ein grosses Loch zu sehen, in das "
            "ein paar Paladine von Zombies geschubst werden.");

  AddDetail( ({"gemaelde 4","ecke"}),
	    "Auf dem vierten Gemaelde ist nicht mehr viel zu erkennen, da es "
            "fast komplett verbrannt ist. Nur an der linken unteren Ecke kann "
            "man noch ein schmerzverzerrtes Gesicht erkennen.");

  AddDetail( ({"gemaelde 5"}), 
            "Auf dem letzten Gemaelde ist ein grosser blutroter Drachen "
            "abgebildet. Er sitzt in einer Turm- oder Tempelspitze auf den "
            "Skeletten seiner niedergeschlagenen Feinde.\n"
            "Du fragst Dich ob das ein Hinweis darauf ist, was Dich noch "
            "erwartet.");

  AddDetail( ({"dschungelelfen"}),
	    "Die Dschungelelfen haben das Boese aus dem Tempel vor "
            "Jahrhunderten vertrieben. Es macht jedoch den Anschein, als ob es "
            "zurueck gekehrt ist.");

  AddDetail( ({"anschein"}),
	    "Du bist Dir eigentlich ziemlich sicher."); 

  AddDetail( ({"abenteurer"}),
	    "Du bist auch einer, nur noch nicht Asche."); 
  
  AddDetail( ({"drachen","drache"}), 
            "Der Drache sieht boese und maechtig aus.");

  AddDetail( ({"skelette","skeletten","feinde"}),
	    "Die Feinde des Drachen scheinen primaer die Dschungelelfen zu "
            "sein.");

  AddDetail( ({"turm-","turmspitze","tempelspitze","turm","spitze"}),
	    "Das koennte dieser Tempel sein.");

  AddDetail( ({"tempel"}), 
            "Du befindest Dich in einem.");

  AddDetail( ({"gesicht"}),
	    "Das Gesicht sieht schrecklich aus.");

  AddSmell(DEFAULT_SMELL, "Es riecht eigentlich nach gar nichts.");  
 
  AddSound(DEFAULT_SOUND, "Du hoerst ein magisches Knistern.");

  AddSound( ({"knistern","portal","magie"}),
	   "Das Knistern kommt von der starken Magie, die das Portal "
           "ausstrahlt.");

//-----Details Ende-----

AddItem(OBJ "portalg", REFRESH_DESTRUCT);
  
AddExit("westen", ROOM "tem34");


AddCmd( ({"betrete" }), "betreten" );
AddCmd( ({"durchsuch","durchsuche" }), "durchsuchen" );

}
int betreten(string str)
{
   notify_fail("Was moechtest Du betreten?\n");
   if ( member( ({ "portal","gruenes portal" }),str) != -1) 
  {
    write(BS ( "Du betrittst das schimmernde Portal und die Umgebung "
               "verschwimmt. Mal sehen wo Dich das Portal hinbringt.\n"));
    say( TPN+" betritt das Portal und verschwindet.\n");
    TP->AddSp(-50);
    this_player()->move(ROOM "tem36", M_TPORT);
    return 1;
  }
}
int durchsuchen(string str)
{
   notify_fail("Was moechtest Du durchsuchen?\n");
   if ( member( ({ "haufen","asche" }),str) != -1) 
  {
    write(BS ( "Du durchsuchst die Asche und findest ein paar Zaehne und "
               "Reste von Stoff und Metall. Du wendest Dich angeekelt ab, "
               "da es sich um die Ueberreste eines Abenteurers zu handeln "
               "scheint, der hier sein Ende gefunden hat.\n"));
    say( TPN+" durchsucht einen Haufen mit Asche.\n");
    return 1;
  }
}
