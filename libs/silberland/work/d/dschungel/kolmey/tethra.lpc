inherit "std/room";

#include "../def.h"
#include <properties.h>
#include <language.h>
#include <moving.h>

#define WAHLLOG "/d/dschungel/kolmey/wahl.log"

mapping waehler;
mapping waehler1;
mapping brecher;

create()

{

::create();

   SetProp(P_INT_SHORT, "Eine kleine Insel");
   SetProp(P_INT_LONG,
     "Du befindest Dich auf einer kleinen Insel, die wie es scheint, "
     "jenseits von aller Zivilisation liegt. Rings um Dich herum "
     "stehen einige riesige Palmen. Die Sonne steht hoch oben am "
     "Himmel und brennt auf Dich herab. Gleich neben Dir befindet "
     "sich ein grosser Fluss. Eine kleine Bruecke fuehrt ueber das "
     "Wasser zurueck zu einer anderen Insel.");
   SetProp(P_LIGHT, 1);
   SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_JUNGLE]) );
   SetProp(P_INDOORS, 0);
   
   AddDetail( ({ "boden" }),
     "Der Boden unter Dir besteht aus Sand.");
   AddDetail( ({ "sand" }),
     "Ganz gewoehnlicher, feiner Sand.");
   AddDetail( ({ "insel" }),
     "Du befindest Dich mitten auf einer kleinen Insel.");
   AddDetail( ({ "zivilisation" }),
     "Nunja, hier hat wohl die zivilisierte Welt halt gemacht, ja es "
     "scheint fast so, als waere hier die Zeit stillgestanden. Noch "
     "niemand vor Dir hat wo moeglich diese Insel betreten.");
   AddDetail( ({ "welt" }),
     "Das SilberLand wird hier gemeint.");
   AddDetail( ({ "silberland" }),
     "Du befindest Dich hier.");
   AddDetail( ({ "zeit", "halt" }),
     "Die Zeit hat hier Halt gemacht und die Insel im Naturzustand "
     "gelassen.");
   AddDetail( ({ "naturzustand" }),
     "Diese kleine Insel hat noch nie zuvor einen Eingriff durch Elfenhand "
     "gespuert. Und das soll auch so bleiben!");
   AddDetail( ({ "eingriff", "elf" }),
     "Noch kein Elf hat hier etwas veraendert.");
   AddDetail( "elfenhand", ([ 0: "Du bist kein Elf und hast darum auch "
   				 "keine Elfenhand!",
    			  "elf": "Eine wunderschoene Elfenhand!"]));
   AddDetail( ({ "elf" }),
     "Da ist sicher Tethra gemeint!");
   AddDetail( ({ "tethra" }),
     "Das ist Tethra. Er ist fuer einen Elf mittelgross.\n"
     "Er ist absolut fit.\n"
     "Er hat einen Teddy unter seinen Arm geklemmt.\n"
     "Tethras Finger sind schmutzig.\n"
     "Ueber seinem linken Auge schimmert schwach das Stigma der Gemeinschaft.\n"
     "Er ist Freund von Flash, Supply, Nasenbaer, Yeza, Edi, Lovetah, Turgon,\n"
     "Hellspawn, Fargus, Xorgan, Locke, Xenja, Maya, Juny, Skei, Lim, Tetsuo,\n"
     "Kenawio, Xantas, Esmeralda, Kadiya, Cherub, Cocran, Macalla, Alice, Smurfi,\n"
     "Knuth, Wuz, Failin, Larahl, Kyralein, Utx, Deathmaker, Denti, Chlchmd, Carla,\n"
     "Eldar, Ademion, Merin, Akron, Ceremony, Netter, Levitikus, Godan, Celaine,\n"
     "Dualin, Moorok, Cule, Justavius, Babba, Kthon, Faxe, Xeen, Glakor, July,\n"
     "Kleine, Spazzy, Lluvia, Laila, Graven, Cute, Peirgeiron, Tjodalv, Tessa,\n"
     "Sennah, Tenshinhan, Andruil, Orw, Arkyns, Rikz, Aragon, Nogara, Fenris,\n"
     "Baldur, Tiamat, Cadrim, Torgan, Gimliy, Hotaru, Ras, Conan, Jorinde, Snoopie,\n"
     "Tanessa, Fester, Elena, Dobob, Madras und Karandras.\n"
     "Er ist mit Cute verheiratet!\n"
     "Tethra hat ein Nachtamulett, einen Mithrilhelm, Kampfstiefeln, ein\n"
     "blutrotes Stirnband und einen Drachenpanzer an, eine Holzfaelleraxt\n"
     "gezueckt und traegt einen Sack, einen Lederbeutel, eine Geldboerse und ein\n"
     "Freundschaftsband.\n");
     
     AddDetail( ({ "palmen" }),
       "Rings um Dich herum stehen einige Palmen.");
     AddDetail( ({ "sonne" }),
       "Die Sonne brennt von oben auf Dich herab. Pass bloss auf, dass "
       "Du keinen Sonnenbrand bekommst.");
     AddDetail( ({ "sonnenbrand", "moment" }),
       "Im Moment hast Du noch keinen.");
     AddDetail( ({ "himmel" }),
       "Am Himmel zieht sich nur eine merkwuerdig aussehende Wolke. "
       "Ansonsten ist er strahlend blau.");
     AddDetail( ({ "wolke" }),
       "Die Form der Wolke sieht sehr merkwuerdig aus.");
     AddDetail( ({ "form" }),
       "Ihre Form aehnelt einem Schriftzug.");
     AddDetail( ({ "schriftzug" }),
       "Lies ihn!");
     AddReadDetail( ({ "schriftzug" }),
       "AMNE FOR MUDGOD!!! Da duerfte wohl das Wahlbuero von Amne wieder "
       "eine Kampagne gestartet haben.");
     AddDetail( ({ "amne", "amnenion" }),
       "Es beginnt auf einmal fuerchterlich zu stinken! Ja, Amne ist schon "
       "ein ekelhafter Typ! =8)");
     AddDetail( ({ "typ" }),
       "Amne ist gemeint... Im vollen Namen 'Amnenion the Mudgod'.");
     AddDetail( ({ "name" }),
       "Amnenion the Mudgod.");
     AddDetail( ({ "mudgod" }),
       "Mudgod ist Woody! Du koenntest aber Deine Stimme "
       "fuer Amne abgeben... vielleicht aendert sich das ja mal. "
       "Haha der Amne verliert sowieso!");
     AddDetail( ({ "woody", "waldzwerg" }),
       "Woody, der Waldzwerg -> Mudgod.");
     AddDetail( ({ "stimme" }),
       "Wenn Du Amne waehlen willst tipp <waehle Amne>. Willst Du aber "
       "Woody waehlen, so tipp <stimm fuer woody>. Aber wenn Du ganz "
       "ehrlich bist, willst Du Amne gar nicht als Mudgod, waehl lieber "
       "Woody!");
     AddDetail( ({ "wahlbuero", "buero", "kampagne" }),
       "Ja, es gibt ein offizielles Amne Wahlbuero. Chef davon ist "
       "ein Kolmey.");
     AddDetail( ({ "chef", "ein kolmey" }),
       "Und das entspringt einem Knopf.");
     AddDetail( ({ "knopf" }),
       "Frag Methos danach.");
     AddDetail( ({ "methos" }),
       "Das ist der jenige, dem die Frauen immer in die Zunge beissen.");
     AddDetail( ({ "frauen" }),
       "Recht haben sie! =8)");
     AddDetail( ({ "zunge" }),
       "Deine Zunge beginnt bei dem Gedanken zu schmerzen!");
     AddDetail( ({ "gedanke", "gedanken" }),
       "Na, dass Dir jemand in die Zunge beisst!");
     AddDetail( ({ "kolmey" }),
       "Nein, Kolmey ist nur ein Wurstmagier... Gemeint wurde 'ein Kolmey'");
     AddDetail( ({ "wurstmagier" }),
       "Dante ist der Gruender der Wurstmagier!");
     AddDetail( ({ "dante" }),
       "Er ist der Oberwurstmagier!");
     AddDetail( ({ "oberwurstmagier" }),
       "Das ist Dante!");
     AddDetail( ({ "fluss", "fluesse" }),
       "Der Fluss rauscht neben Dir vorbei.");
     AddDetail( ({ "wasser" }),
       "Ja, Fluesse bestehen meistens aus Wasser!");
     AddDetail( ({ "bruecke" }),
       "Eine kleine Bruecke fuehrt Dich zu einer anderen Insel.");
     AddDetail( ({ "rauschen" }),
       "Lausch ihm!");
     
     AddSound(DEFAULT_SOUND,
       "Du hoerst das Rauschen des Flusses.\n");
     AddSound( ({ "rauschen" }),
       "RAUUUUSCH!!!!");
     AddSmell(DEFAULT_SMELL,
       "Irgendwie stinkt es hier nach Amne.");
     AddSmell( ({ "amne" }),
       "Du kotzt.");
     
     AddItem("/d/dschungel/kolmey/liste", REFRESH_NONE);
     
     AddExit( "westen", "/d/dschungel/dante/weg/room/cherub1");
     
     AddCmd( ({ "waehle", "waehl" }), "cmd_vote");
     AddCmd( ({ "brich", "breche" }), "cmd_break");
     
     waehler=([]);
     brecher=([]);
     
}

reset()
{

  ::reset();
  brecher=([]);
}

int cmd_vote(string str)
{
   string spieler;
   spieler=getuid(TP);
   notify_fail(BS("Wen moechtest Du denn waehlen?"));
   
   if(str == "amne" || str == "amnenion")
   {
   if(!member(waehler, spieler))
   {
      waehler+=([spieler: 0]);
   }
   if(waehler[spieler, 0]>=1)
   {
      write(BS("Aber Deine Stimme wurde doch schon registriert!"));
      return 1;
   }
      waehler[spieler, 0]++;
   
      write(BS("Ok, Du waehlst Amne."));
      tell_room(ENV(TP), TPN+" waehlt Amne.\n", ({TP}));
      write_file(WAHLLOG,
      sprintf("%s  %s stimmt fuer Amne.\n",
      dtime(time()), capitalize(TP->query_real_name())));
      return 1;
   }
   else
   {
   if(str == "woody")
   {
   if(!member(waehler, spieler))
   {
      waehler+=([spieler: 0]);
   }
   if(waehler[spieler, 0]>=1)
   {
      write(BS("Aber Deine Stimme wurde doch schon registriert!"));
      return 1;
   }
      waehler[spieler, 0]++;
   
      write(BS("Ok, Du waehlst Woody."));
      tell_room(ENV(TP), TPN+" waehlt Woody.\n", ({TP}));
      write_file(WAHLLOG,
      sprintf("%s  %s stimmt fuer Woody.\n",
      dtime(time()), capitalize(TP->query_real_name())));
      return 1;
   }
   return 0;
  }
}

int cmd_break(string str)
{
   string spieler;
   spieler=getuid(TP);
   notify_fail(BS("Was moechtest Du denn brechen?"));
   
   if(str == "ast" || str == "ast ab")
   {
   if(!member(brecher, spieler))
   {
      brecher+=([spieler: 0]);
   }
   if(brecher[spieler, 0]>=1)
   {
      write(BS("Du hast doch der Natur schon einen Streich gespielt!"));
      return 1;
   }
      brecher[spieler, 0]++;
   
      write(BS("Du brichst den Ast ab. Du grinst triumphierend."));
      tell_room(ENV(TP), TPN+" grinst triumphierend.", ({TP}));
      return 1;
   }
   return 0;
}


