// dante   
// Ein Wolfshund

inherit "std/npc";
#include "files.h"
#include <properties.h>
#include <language.h>
#include <moving.h>
#include <combat.h>
#include <new_skills.h>
#include <npc.h>

init() 
{
  object defender;
    ::init();
      if (defender = present("Einsiedler")) AddDefender(defender);
         }

create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein sehr grosser, grimmiger Wolfshund");
  SetProp(P_LONG, (
    "Der Wolfshund ist der einzige Freund, den der Einsiedler hat. Er beobachtet"
    " Dich wachsam und laesst seinen Hernn keine Minute aus den Augen, denn schon"
    " oft hat er ihm im Kampf gegen Tier und Mensch beistehn muessen. Seine Rasse"
    " kannst Du nicht genau feststellen, glaubst aber an seinem grauen, dichten"
    " Fell zu erkennen, das es sich dabei um einen Wolfshund handelt."));
  SetProp(P_NAME, "Wolfshund");
  SetProp(P_GENDER, MALE);
  AddId( ({"hund", "Wolfshund","wolfshund"}) );
SetProp(P_NAME_ADJ, ({"gross","grimmig"}));
  create_default_npc(35);
  SetProp(P_HANDS, ({" mit seinen kraeftigen Zaehnen", 365+random(20),({DT_PIERCE, DT_RIP})}));
  SetProp(P_RACE, "Hund");
  SetProp(P_SIZE, 150+random(10));
  SetProp(P_ALIGN, 222);
  SetProp(P_MAX_HANDS, 4);
  
  AddDetail(({"freund","einsiedler","herr","herrn"}),
  ("Der alte Mann lebt schon viele Jahre mit seinem treuen Gefaehrten in"
   " dieser unwirtlichen, gefaehrlichen Gegend.\n"));
  AddDetail(({"kampf","tier","mensch"}),
  ("Schon viele Male haben die beiden gemeinsam Angriffe und Ueberfaelle"
   " von schlecht gessinten Zeitgenossen abgewehrt, und sind im Kampf daher"
   " nicht zu unterschaetzen.\n"));
  AddDetail(({"auge","augen"}),
  ("Der Wolfshund blickt dich wachsam, aber trotzdem freundlich an.\n"));  
  AddDetail(({"fell","rasse"}),
  ("Das dunke, lange Fell , die grosse Aehnlichlkeit mit einem Wolf, lassen"
  " den Schluss nahe, dass es sich hier um einen Wolfshund handelt. Eine "
  "Rasse, die besonders wild und mutig ist.\n"));

  SetProp(P_MSGIN, "laeuft knurrend herein");
  SetProp(P_MMSGIN, "laeuft knurrend herein");
  SetProp(P_MMSGOUT, "laeuft knurrend weit weg");
  SetProp(P_MSGOUT, "laeuft knurrend");

  AddInfo(DEFAULT_INFO, ({
    "bellt laut.\n",
    "sagt: Wau! Wau!\n",
    "sagt: Wuff! Wuff!\n",
    "knurrt\n",
    "klaefft.\n",
    "schleicht um Dich herum.\n",
    "schaut Dich misstrauisch an.\n",
    "wedelt mit seinem Schwanz.\n"}) );
  AddInfo("dante", "Wenn ich den zwischen meine Zaehne kriege...", "knurrt: ");
  SetProp(P_REJECT, ({ REJECT_DROP, 
     "Der Wolfshund schnueffelt nur kurz an @WEM und laesst es dann liegen.\n"}));
  SetProp(P_DIE_MSG, " knurrt das letzte Mal.\n");

  SetChats(10, ({
    "Der Wolfshund bellt laut.\n",
    "Der Wolfshund wedelt mit seinem Schwanz.\n",
    "Der Wolfshund schaut Dich grimmig an.\n",
    "Der Wolfshund schleckt dem Einsiedler das Gesicht.\n",
    "Der Wolfshund schnueffelt an Dir.\n",
    "Der Wolfshund legt sich vor das offenen Feuer.\n",
    "Der Wolfshund pinkelt an Dein Bein.\n",
    "Du weichst erschrocken etwas weiter vom Hund weg.\n",
    "Du hast doch etwas Angst vor dem grossen Hund.\n",
    "Der Einsiedler streichelt dem Hund durchs Fell.\n",
    "Der Einsiedler ruft seinen Hund zu sich.\n",
    "Der Wolfshund packt einen grossen Knochen.\n",
    "Der Wolfshund knurrt Dich an.\n",
    "Der Einsiedler gibt dem Wolfshund Futter.\n",
    "Der Wolfshund verlangt nach mehr Futter.\n",
    "Der Wolfshund schnappt nach nach Deinem Bein.\n",
    "Der Wolfshund scheint etwas im Dschungel zu hoeren.\n",
    "Der Wolfshund spitzt die Ohren.\n",
    "Du versuchst schuechtern den Hund zu streicheln.\n"}) );
 SetAttackChats(40, ({
   "Der Wolfshund springt Dir an die Kehle.\n",
   "Der Wolfshund draengt Dich in die Ecke.\n",
   "Du weichst dem Hund gerade noch aus.\n"
   "Die Zaehne des Hundes bohren sich in Deine Hand.\n"}) );
   
  SetProp(P_SPELLRATE, 70);
  
  AddSpell(3, 500,
  "Der Wolfshund springt Dir an die Gurgel.\n",
  "Der Wolfshund springt @WEM an die Gurgel.\n",
  DT_TERROR, ([SP_SHOW_DAMAGE:1]));
  
  AddSpell(4,333,
    "Der Wolfshund beisst Dich ins Bein.\n",
    "Der Wolfshund beisst @WEN ins Bein.\n",
    DT_RIP, ([SP_SHOW_DAMAGE:1]));
    
  AddSpell(3,500,
    "Der Wolfshund zerfetzt Deinen Arm.\n",
    "Der Wolfshund zerfetzt @WESSEN Arm.\n",
    DT_RIP, ([SP_SHOW_DAMAGE:1]));

}


void InformDefend(object enemy) 
{
  Kill(enemy);
  }
  
die(arg)  {
	heal_self(500);
return 1; }
