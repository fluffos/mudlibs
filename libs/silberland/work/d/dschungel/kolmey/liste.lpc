inherit "std/thing";

#include <properties.h>
#include "../def.h"

create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Eine Wahlliste");
  SetProp(P_LONG, 
    "Das ist die 'Mudgod' Wahlliste. Du kannst sie lesen.");
  SetProp(P_NAME, "Wahlliste");
  SetProp(P_GENDER, FEMALE);
  AddId( ({ "wahlliste", "liste" }) );

  SetProp(P_MATERIAL, MAT_PAPER);
  SetProp(P_NOGET, "Die Liste wurde an eine Palme genagelt.");
  
  AddReadDetail( ({ "liste" }),
    "\n"
    "Sam, 22. Sep 2001, 13:39:11  Kolmey stimmt fuer Woody.\n"
    "Sam, 22. Sep 2001, 14:01:46  Dante stimmt fuer Amne.\n"
    "Sam, 22. Sep 2001, 14:01:58  Dante stimmt fuer Woody.\n"
    "Sam, 22. Sep 2001, 14:26:17  Tethra stimmt fuer Amne.\n"
    "Sam, 22. Sep 2001, 16:55:18  Cherub stimmt fuer Woody.\n"
    "Sam, 22. Sep 2001, 17:19:50  Amnenion stimmt fuer Amne.\n"
    "Sam, 13. Okt 2001, 12:01:28  Gloeckchen stimmt fuer Woody.\n"
    "Mon, 15. Okt 2001, 14:21:58  Cute stimmt fuer Woody.\n"
    "Son, 18. Nov 2001, 15:02:51  Babba stimmt fuer Woody.\n"
    "Die, 20. Nov 2001, 14:33:43  Clementine stimmt fuer Woody.\n"
    "Die, 11. Dez 2001, 09:06:29  Chtarok stimmt fuer Amne.\n"
    "Fre, 25. Jan 2002, 23:20:23  Gimliy stimmt fuer Amne.\n"
    "Son,  3. Feb 2002, 17:25:53  Katarok stimmt fuer Woody.\n"
    "Mon, 15. Apr 2002, 20:30:18  Del stimmt fuer Amne.\n"
    "Son,  2. Jun 2002, 14:42:48  Dings stimmt fuer Amne.\n"
    "Mit,  5. Jun 2002, 15:05:18  Cadrim stimmt fuer Woody.\n"
    "Mit,  5. Jun 2002, 15:49:51  Zorn stimmt fuer Amne.\n"
    "Mit, 12. Jun 2002, 16:33:59  Lim stimmt fuer Amne.\n"
    "Mon, 17. Jun 2002, 16:53:17  Jolina stimmt fuer Woody.\n"
    "Sam, 23. Nov 2002, 22:58:42  Flash stimmt fuer Amne.\n"
    "Don, 28. Nov 2002, 21:49:08  Baradur stimmt fuer Woody.\n"
    "Mon, 17. Feb 2003, 10:35:00  Eidan stimmt fuer Amne.\n"
    "Mit,  2. Apr 2003, 18:40:23  Dune stimmt fuer Amne.\n"
    "Don, 12. Jun 2003, 02:24:31  Hixtine stimmt fuer Woody.\n"
