/*

diese flasche hat sehr viele details underhaelt ne geschichte
wer gut wenn man fps bekommt, wenn man ein speziellse detail untersucht
vorher muss man sie aber erstmal aktivieren

Fuer Zordan: mir is klar, das man sie so nicht lassen kann, denke ich mal
ist wohl ZU gut das ding, daher bitte ich um korrektur bzw anweisungen....
*/

inherit "std/thing";
#include "../global.h"
#include <food.h>
#include <properties.h>
#include <moving.h>
#include <wizlevels.h>A

int leer, ende, statu;


create()
{
if (!is_clone(this_object())) return;

::create();

leer = 5;
ende = 0;
statu=0;

SetProp(P_SHORT, "Eine leere Flasche");
SetProp(P_LONG, BS("Diese Flasche hat sicher der Trinker geleert. Sie hat eine "
                "gruenliche Farbe und liegt recht gut in der Hand. Vielleicht hat "
                "er sie ja als Waffe in so mancher Wirthausschlaegerei verwendet? "
                "Auf dem schmutzigen Etikett glaubst Du etwas zu erkennen."));

AddId("flasche"); 
SetProp(P_NOSELL, 1);
SetProp(P_SMELL, ("Die Flasche stinkt nach billigem Fusel...\n"));
SetProp(P_SOUND, ("Manchmal hoert man ein lautes Glucksen aus dem Inneren der Flasche.\n"));              
SetProp(P_VALUE, 4800);
SetProp(P_WEIGHT, 50);
SetProp(P_SIZE, 40);
SetProp(P_GENDER, FEMALE);
SetProp(P_MATERIAL, ([MAT_GLASS:90,MAT_MAGIC:10]));
SetProp(P_NAME, "Flasche");
SP(P_NAME_ADJ, "leer");

SetProp(P_INFO, BS("Dies ist die magische Sandlerflasche. Wer aus Ihr trinkt, "
             "kann sowohl nuechtern als auch sehr durstig werden. Beanspruche "
             "ihre Dienste nicht zu oft, denn auch die magischen Faehigkeiten "
             "der Flasche sind begrenzt."));
SP(P_NAME_ADJ,"leer");

AddDetail(({"etikett","etikette"}),
           ("Du betrachtest das Etikett genauer und kannst ein Schloss und "
            "Weinberge erkennen. Du kratzt etwas Dreck von der Flasche "
            "und glaubst Chateau Clochard lesen zu koennen."));

AddDetail(("schloss"),
           ("Man kann ein kleines, aber trotzdem imposantes Loire Schloss "
            "erkennen. Du schmunzelst als Du im Schlossgarten den Herrn des "
            "Schlosses bei einem wilden Gelage erblickst. Was ist das? "
            "Ein junges Burgfraeulein scheint sich von einem der Tuerme "
            "herab zu uebergeben. Zeiten sind das...!"));

AddDetail(({"berge","weinberge"}),
          ("Ringsum das Schloss kann man Weinberge erkennen. So weit das "
           "Auge reicht siehst Du die kultivierten Reben mit den suessen "            
           "Fruechten. Dir laeuft das wasser im Munde zusammen..."));
                        
AddDetail(({"clochard","chateau"}),
            ("Tja, Franzoesisch muesste man koennen..."));  

AddDetail(({"gelage","garten","schlossgarten"}),
          ("Inmitten einer grossen Parkanlage tummeln sich illustre Gest- "
           "stalten froehlich lachend. Du siehst eine schoene Elfin, die "
           "auf einem der Brunnenraender einen Schleiertanz darbietet. "
           "Ein edler Ritter wird von jungen, kichernden Hobbitfraeulein "
           "bewundet, waehrend er von seinen Heldentaten in fernen Laendern "
           "berichtet. Der Burgherr, ein fetter, aufgequollener Ork stopft "
           "sich gerade eine Hammelkeule in den Mund. Neben ihm  sitz "
           "an der Tafel ein Zauberer, der immer wenn die Weinfaesser leer "
           "sind, sie mit seiner Magie erneut anfuellt. Selbst trinkt er "
           "keinen Tropfen. Du kannst noch viele Gestalten erkennen, aber "
           "irgendwie wird dir das zu langweilig."));  

AddDetail(({"turm","tuerme","fraeulein","burgfraeulein"}),
          ("Dieses Schloss hat viele hohe Tuerme, manche mit bunten Fahnen "
           "verziert, die im Wind hin und her tanzen. Eine dieser Fahnen "
           "sieht irgendwie besonders interessant aus. Andere Tuerme sind "
           "mit Zinnen bestueckt, zwischen denen du Pechnasen erkennst. "
           "Diese dienen im Kriegsfall zur Verteidigung des Schloss. Durch "
           "sie kann man, wie der Name schon sagt, siedendes Pech auf die "
           "Angreifer schuetten. Auf einem der Tuerme kannst du nun eine "
           "junge Frau, erkennen die nicht Pech, sondern ihren Mageninhalt "
           "von oben herab in den Schlossgraben leert."));  

AddDetail(({"fahne","fahnen"}),
           ("Inmitten der vielen im Wind tanzenden Fahnen gefaellt dir diese "
            "eine besonders gut. Auf ihr siehst du Dante Alighieri, der von "
            "seinem Fuehrer Vergil gerade durch das Inferno geleitet wird. "
            "Es handelt sich hierbei um eine Darstellung aus der goettlichen  "
            "Komoedie. Der Kuenstler war Gustav Dore, der scheinbar nicht nur "
            "Kupferstiche gemacht hat, sondern auch Fahnen bemalt hat. Aber "
            "das ist dir voellig egal."));
AddDetail(({"dante","vergil"}),
           ("Dante ist der Magier, der diese Flasche verbrochen hat!\n"   
           "Vergil ist sein Fuehrer durch die Hoelle!\n"));
  
  ASD("hoelle", "start");
  
  
 AddCmd(({"trinke","trink","trinken"}), "empty");
 }
 
 
  start()  {
   if(statu==0)  {
  statu=1;
     return BS(
     "Ploetzlich schiesst ein Feuerstrahl aus der Flasche heraus. Es stinkt "
  "furchtbar, doch die Flasche scheint nun irgendwie aktiviert worden zu sein!");
     }
     else 
       {
     return BS(
     "Deine Flasche ist schon aktiviert worden!");
          }
      }
 
 
 
 
 int empty (string str)
    {
    notify_fail("Woraus willst du trinken?\n");
    if ( !str ) return 0;
  
  
     
    if (( member( ({"aus flasche","flasche"}),str) !=-1 ) && ( !leer ))         
      {
      
      write("Du trinkst aus der Flasche, doch nichts scheint zu passieren. "
      "Warte lieber noch ein bisschen...\n");
       
      return 1;
      }
      if (( member( ({"aus flasche","flasche"}),str) !=-1 ) && ( leer ))
      {
      
       if(statu==0)  {
      write(BS(
      "Du willst aus der Flasche trinken, doch immer wenn Du sie ansetzen "
      "willst, schiesst eine kleine Flamme heraus. Irgendwie muss man "
      "das doch abstellen koennen. Schau Dir die Flasche doch genauer an!"));
      return 1;
       }
      
     
       if (find_call_out("aufladen") == -1) call_out("aufladen",900);   
  
  //zeile original von Zordan wenn sie buggt also an ihn wenden; dante :-)))      
//      call_out("aufladen", 900);//15 min
      
      write("Du trinkst aus der Flasche und fuehlst Dich "
      "voellig nuechtern und durstig.\n");
      
     TP->SetProp(P_DRINK, 0);
     TP->SetProp(P_ALCOHOL, 0);
      leer--;
      return 1;
      }
      return 0;
      }
      
   aufladen()
     {
     	if(!environment(TO))  return;
     	
     	
     tell_object(environment(TO),
     "Ploetzlich hoerst Du ein lautes Ruelpsen aus der Flasche.\n");
     ende++;
     leer++;
     if( ende>=5+random(5))
     {
       tell_object(environment(TO),
     "Ploetzlich zerbricht Deine magische Flasche in 1000 Einzelstuecke.\n");
     remove(); 
      }
      }
         