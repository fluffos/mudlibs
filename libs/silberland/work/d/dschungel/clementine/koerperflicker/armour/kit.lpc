inherit "std/armour";

#include "../dante.h"

create()
{

  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein gruener Kittel");
  SetProp(P_LONG,
    "Ein huebscher pastellgruener Krankenhauskittel aus 100% "
    "saugfester Baumwolle. Rueckseitig ist er natuerlich nicht "
    "geschlossen, sondern offen, damit man schneller Einlaeufe und "
    "diverse Spritzen geben kann. ");

  SetProp(P_NAME, "Kittel");
  AddId( ({ "kittel", "krankenhauskittel" }) );
  SetProp(P_INFO, "Durch diesen rueckseitig offenen Kittel kommt Dein "
    "Knackarsch sicherlich besonders gut zur Geltung. ");
  SetProp(P_GENDER, MALE);
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 10);
  SetProp(P_ARMOUR_TYPE, AT_ARMOUR);
  SetProp(P_MATERIAL, MAT_CLOTH);
  SetProp(P_ARTICLE, 1);
  SetProp(P_AC, 3);


}

string extra_look() { return (environment()->Name(WESSEN))+" fetter Popo "
  "wird leider nicht von dem gruenen Krankenhauskittel bedeckt. Igitt!!!\n"; } 
									 
			
