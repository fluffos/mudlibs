
inherit "std/armour";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <combat.h>
#include "../dante.h"

create()
{

  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein Paar Schlapfen");
  SetProp(P_LONG,
    "Ein Paar Birkenschlapfen der beruehmten Dschungelmarke <Teueris>. "
    "Durch ihr ergonomisches Fussbett passen sie sich perfekt der Form "
    "Deiner Fuesse an, sodass die Qualitaetsmaengel gar nicht mehr so "
    "auffallen. Naja, Hauptsache die Marke zaehlt. ");
  SetProp(P_NAME, "Paar Schlapfen");
  AddId( ({ "birkenschlapfen", "schlapfen" }) );
  SetProp(P_GENDER, NEUTER);
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 10);
  SetProp(P_ARMOUR_TYPE, AT_BOOT);
  SetProp(P_MATERIAL, MAT_WOOD);
  SetProp(P_ARTICLE, 1);
  SetProp(P_INFO, "Die Schlapfen sind von der beruehmten Dschungelmarke "
                  "<teueris>!!!");

}

