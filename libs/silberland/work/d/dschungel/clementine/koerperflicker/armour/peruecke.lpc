
inherit "std/armour";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <combat.h>
#include "../dante.h"

create()
{

  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Eine Peruecke");
  SetProp(P_LONG,
    "Diese wunderbare Peruecke wurde aus echtem platinblonden Menschenhaar "
    "gefertigt. Manche wuerden morden um so eine umwerfende Haarpracht zu "
    "bekommen. ");
  SetProp(P_NAME, "Peruecke");
  AddId( ({ "peruecke" }) );
  SetProp(P_GENDER, FEMALE);
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 10);
  SetProp(P_ARMOUR_TYPE, AT_HELMET);
  SetProp(P_MATERIAL, MAT_HAIR);
  SetProp(P_ARTICLE, 1);
  SetProp(P_AC, 3);
  SetProp(P_INFO, "Diese Peruecke steht Dir sicherlich einmalig. ");

}

  string extra_look() { return (environment()->Name(WER))+" hat echte "
         "platinblonde Haare.\n"; }


  
