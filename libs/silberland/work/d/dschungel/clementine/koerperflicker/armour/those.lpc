
inherit "std/armour";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <combat.h>
#include "../dante.h"

create()
{

  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Eine Hose");
  SetProp(P_LONG,
    "Eine Hose der beruehmten Dschungelmarke <Teueris>. Ein wirklich "
    "wunderbares Stueck, obwohl es aus einem ziemlich schaebigen Stoff "
    "gefertigt ist. Aber wer achtet schon auf das Material, wenn es von so "
    "einer einmaligen Marke stammt. ");
  SetProp(P_NAME, "Hose");
  AddId( ({ "hose", "teueris" }) );
  SetProp(P_GENDER, FEMALE);
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 10);
  SetProp(P_ARMOUR_TYPE, AT_TROUSERS);
  SetProp(P_MATERIAL, MAT_CLOTH);
  SetProp(P_ARTICLE, 1);
  SetProp(P_AC, 1);

}

