

inherit "std/armour";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <combat.h>
#include <defines.h>
#include <moredef.h>


create()
{

  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein Haeubchen");
  SetProp(P_LONG,
    "Ein klitzekleines weisses Haeubchen, an dessen Vorderseite ein "
    "rotes Kreuz gemalt wurde. Es macht Dich sicherlich zu einer perfekt "
    "aussehenden Krankenschwester. ");
  SetProp(P_NAME, "Haeubchen");
  AddId( ({ "haeubchen", "haube", "krankenschwesternhaeubchen" }) );
  SetProp(P_GENDER, NEUTER);
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 10);
  SetProp(P_ARMOUR_TYPE, AT_HELMET);
  SetProp(P_MATERIAL, MAT_CLOTH);
  SetProp(P_ARTICLE, 1);
  SetProp(P_AC, 1);
  SetProp(P_INFO, "Wenn Du Koerperflicker heissen wuerdest, koenntest Du "
                  "Dich wohl kaum halten. ");

}

string extra_look() { return (environment()->Name(WER))+" hat ein kesses "
       "Krankenschwesternhaeubchen auf dem Kopf.\n"; }
