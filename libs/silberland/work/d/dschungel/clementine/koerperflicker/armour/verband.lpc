
inherit "std/armour";

#include "../dante.h"

create()
{
  if(!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein Verband");
  SetProp(P_LONG,
    "Ein gelber Verband (frueher war er wahrscheinlich  mal weiss, aber "
    "mittlerweile hat er sich mit Eiter vollgesogen). Igitt! Du solltest "
    "ihn lieber schnell wieder loswerden, ansonsten steckst Du Dich "
    "garantiert mit allen moeglichen Krankheiten an! Baeh!!! Ist das "
    "ekelhaft!");
  SetProp(P_NAME, "Verband");
  AddId( "verband");
  SetProp(P_GENDER, MALE);
  SetProp(P_NAME_ADJ, "eitrig");
  AddAdjective( ({ "eitrig" }) );
  SetProp(P_WEIGHT, 20);
  SetProp(P_VALUE, 1);
  SetProp(P_ARMOUR_TYPE, AT_MISC);
  SetProp(P_AC, 0);
  SetProp(P_MATERIAL, MAT_COTTON);
  SetProp(P_VALUE, 10);
  SetProp(P_ARTICLE, 1);
  SetProp(P_NODROP, "So einfach wirst Du das eitrige Etwas nicht mehr los.\n");
  SetProp(P_INFO, "Verbrenn das Teil lieber schnell!");
  SetProp(P_WEAR_FUNC, this_object());
  SetProp(P_REMOVE_FUNC, this_object());

  AddCmd( ({ "verbrenn", "verbrenne" }), "c_verbrennen");

}

int c_verbrennen(string str)
{
 if(str != "verband")
 {
  notify_fail("Was moechtest Du verbrennen?\n");
  return 0;
 }
 else
 {
  write(BS("Magisch wie Du bist laesst Du einen Feuerball entstehen und "
           "verbrennst dieses eitrige Etwas."));
  say(CTPN+ " verbrennt einen eitrigen Verband.\n");
  RemoveCmd( ({ "verbrenn", "verbrenne" }) );
  call_out("remove", 0);
  return 1;
 }
}

int WearFunc(object me)
{
 write(BS("Igitt ist der Verband eklig!!!"));
 TP->AddHp(-20);
 return 1;
}

  
int RemoveFunc(object me)
{
 write(BS("Der eitrige Verband klebt zu fest an Deiner Haut!!! Igitt!!!"));
 return 0;
}

