
inherit "std/armour";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <combat.h>
#include <defines.h>
#include <moredef.h>


create()
{

  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein Paar langschaftige Stiefel");
  SetProp(P_LONG,
    "Supergeile rote Stiefel aus feinstem Bambileder, deren Schaft bis "
    "ueber Dein Knie reicht, und mit denen selbst Deine Mutter Dr. "
    "Koperperflicker wild machen wuerde. ");
  SetProp(P_NAME, "langschaftige Stiefel");
  AddId( ({ "stiefel" }) );
  SetProp(P_GENDER, FEMALE);
  SetProp(P_WEIGHT, 30);
  SetProp(P_VALUE, 100);
  SetProp(P_ARMOUR_TYPE, AT_BOOT);
  SetProp(P_MATERIAL, MAT_LEATHER);
  SetProp(P_AC, 5);
  SetProp(P_ARTICLE, 0);

 
  AddDetail( ({ "leder" }),
    "Das zarte Leder stroemt einen vertraeumten Geruch nach Liebe und "
    "Frieden aus. ");

  AddDetail( ({ "rot" }),
    "Als Du das Rot erblickst, willst Du nur noch diese Stiefel besitzen! "
    "Sie machen Dich wild und gierig. ");

  AddDetail( ({ "knie" }),
    "Selbst Deine fetten grobknoechigen Knie werden durch diese Stiefel "
    "anziehend. ");

  AddDetail( ({ "schaft" }),
    "Der ist sooooo lang, dass man nur noch die Oberschenkel sieht, und sich "
    "in Gedanken verliert, wie das wohlgeformte Knie darunter wohl aussehen "
    "mag. ");

  AddDetail( ({ "bambi" }),
    "Ein zuckersuesses Bambie, das immer vorgab lieb zu sein, bis man "
    "eines Tages herausfand, dass es ein Vampirbambi ist, das in der Nacht "
    "Dein Blut saugt und Dir Albtraeume beschert. ");

}

