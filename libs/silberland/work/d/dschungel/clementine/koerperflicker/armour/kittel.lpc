
inherit "std/armour";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <combat.h>
#include <defines.h>
#include <moredef.h>


create()
{

  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein Kittelchen");
  SetProp(P_LONG, 
    "Ein kurzer weisser Kittel, der das darunterliegende Hoeschen kaum "
    "verdeckt. Rechts und links hat er jeweils eine Tasche, in die man wohl "
    "einige lebensnotwendige Dinge stecken kann. Dezente Reste von Make-Up "
    "sind auf dem weissen Stoff noch erkennbar. ");
  SetProp(P_NAME, "Kittelchen");
  AddId( ({ "kittel", "kittelchen", "krankenschwesterkittelchen" }) );
  SetProp(P_INFO, "Du fragst Dich, was dieser superkurze Kittel eigentlich "
                  "bedecken soll. ");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 10);
  SetProp(P_ARMOUR_TYPE, AT_ARMOUR);
  SetProp(P_MATERIAL, MAT_CLOTH);
  SetProp(P_ARTICLE, 1);
  SetProp(P_AC, 3);
  

}

  string extra_look() { return (environment()->Name(WER))+" sieht durch das "
         "weisse Kittelchen fast so sexy aus wie Gerda.\n"; }
