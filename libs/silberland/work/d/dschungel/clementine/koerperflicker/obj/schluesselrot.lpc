
inherit "std/thing";

#include <properties.h>
#include <rooms.h>
#include <language.h>
#include "../dante.h"

void create()
{
  if (!is_clone(ME)) return;
  ::create();
 
  SetProp(P_SHORT, "Ein roter Schluessel");
  SetProp(P_LONG,
     "Ein roter Schluessel. Welches Schloss mag "
     "er wohl aufsperren?");
  SetProp(P_NAME_ADJ, "rot");
  SetProp(P_NAME, "Schluessel");
  SetProp(P_GENDER, MALE);
  SetProp(P_VALUE, 0);
  SetProp(P_WEIGHT, 20);
  SetProp(P_NOBUY, 1);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_MATERIAL, MAT_MISC_DEAD);
  AddId( ({ "roterschluessel", "schluessel", "\nschluesselrot" }) );

}


