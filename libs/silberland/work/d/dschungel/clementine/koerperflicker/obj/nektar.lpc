inherit "std/food";

#include <food.h>
#include <properties.h>
#include <language.h>
#include "../dante.h"

void create()
{
  if (!is_clone(this_object())) return;
  ::create();
 
  SetProp(P_SHORT, "Nektar" );
  SetProp(P_LONG, 
    "Etwas Nektar. Riecht sehr lecker! Ob man den essen kann?");
  SetProp(P_NAME, "Nektar");
  AddId( ({ "nektar" }) );
  SetProp(P_MATERIAL, MAT_FRUIT);
  SetProp(P_AC, 0);
  SetProp(P_WEIGHT, 20);
  SetProp(P_VALUE, 1);
  SetProp(P_NOBUY, 1);
  SetProp(P_GENDER, MALE);
  SetProp(P_INFO, "Sieht sehr lecker aus!\n"); 
 
  SetProp(P_FOOD_INFO,
     ([ F_HEAL:  ({ 10,10}),
        F_SOAK: 1,
        F_MSG: "Du isst den Nektar.",
        F_MSG_ROOM: "isst etwas Nektar."]) );
}

