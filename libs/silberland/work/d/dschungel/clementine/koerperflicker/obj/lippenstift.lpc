inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <combat.h>
#include <defines.h>
#include <moredef.h>


void reset()
{
 remove();
}


void create()
{

  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, 0);
  AddId( ({ "\nlippen" }));
  SetProp(P_GENDER, NEUTER);
  SetProp(P_WEIGHT, 0);
  SetProp(P_NOSELL, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_AUTOLOADOBJ, 1);

}

  string extra_look() { return (environment()->Name(WER))+" hat sexy "
		"roten Lippenstift auf den Lippen.\n"; }

