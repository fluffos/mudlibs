inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../dante.h"



void create()
{

  if (!is_clone(this_object())) return;
  ::create();


  SetProp(P_SHORT, "Eine rote Bluete");
  SetProp(P_LONG,
    "Die rote Bluete riecht herrlich, wofuer sie wohl gut ist?");
  AddId( ({ "\nrot", "bluete", "rote bluete" }));
  SetProp(P_NAME, "rote Bluete");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 5);
  SetProp(P_MATERIAL, MAT_PLANT);
  SetProp(P_ARTICLE, 1);
  SetProp(P_INFO, "Die Bluete leuchtet in einem sexy rot!\n");
  SetProp(P_SMELL, 
    "Die Bluete riecht irgendwie nach einem Lippenbalsam!\n");

  AddDetail( ({ "lippenbalsam", "lippen", "balsam" }),
    "Ob man die Bluete irgendwie auf die Lippen schmieren kann?");

  AddCmd( ({ "schmier", "schmiere" }), "c_schmieren");

}

int c_schmieren(string str)
{
	object ob;
	if(str != "bluete auf lippen"   &&
	   str != "bluete auf lippe" )
	{
		notify_fail("Was moechtest Du auf die Lippen schmieren?\n");
		return 0;
	}
	else
	{
		write(BS("Du schmierst die Bluete auf Deine Lippen. "
			"Ahh...angenehm!\n" ));
		say(CTPN + " schmiert sich etwas auf die Lippen.\n");
		ob = clone_object(OBJ "lippenstift");
		ob->move(TP, M_NOCHECK);		
        	TO->remove();
		return 1;	
	}
	
}

  

