inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../dante.h"



void create()
{

  if (!is_clone(this_object())) return;
  ::create();


  SetProp(P_SHORT, "Ein seltsames medizinisches Geraet");
  SetProp(P_LONG,
    "Seltsames Ding! Aber fuer irgendetwas muss es ja gut sein. "
    "Das Geraet besteht vollstaendig aus Holz und hat auf einer Seite eine "
    "Art Haken. Was Doktor Koerperflicker damit wohl macht?");
  AddId( ({ "\nhaken", "medizingeraet", "geraet", "haken" }));
  SetProp(P_NAME, "Geraet");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_WEIGHT, 20);
  SetProp(P_VALUE, 15);
  SetProp(P_MATERIAL, MAT_WOOD);
  SetProp(P_ARTICLE, 1);

  AddDetail( ({ "ding" }),
    "Sieht sehr seltsam aus. Unten ist es gerade - oben hat es einen "
    "Haken. ");

  AddDetail( ({ "holz", "teak", "teakholz" }),
    "Scheint aus Teakholz zu sein. ");

  AddDetail( ({ "koerperflicker", "doktor" }),
    "Wofuer Doktor Koerperflicker das wohl hat?");

  AddDetail( ({ "haken" }),
    "Der Haken oben sieht interessant aus. Was man damit wohl alles "
    "machen kann?");

  AddCmd( ({ "kraul", "kraule" }), "c_kraulen");

}

int c_kraulen(string str)
{
	if(str != "ruecken"  )
	{
		notify_fail("Was moechtest Du damit kraulen?\n");
		return 0;
	}
	else
	{
		write(BS("Pfui, wer weiss, wo dieses Geraet bei dem "
	          "Doktor schon war. Du moechtest Dir damit garantiert nicht "
		  "Deinen Ruecken kraulen!"));
		return 1;
	}
}

