
inherit "std/thing";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../dante.h"


create()
{

  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Eine blutige Mullbinde");
  SetProp(P_LONG, 
    "Igitt! Eine gebrauchte Mullbinde, die sich bereits ordentlich mit "
    "Blut vollgesaugt hat.\n"
    "Dir wird schlecht...\n");
  SetProp(P_NAME, "Mullbinde");
  AddId( ({ "mullbinde", "binde" }) );
  SetProp(P_GENDER, FEMALE);
  SetProp(P_NAME_ADJ, "blutig");
  AddAdjective( ({ "blutig" }) );
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 1);
  SetProp(P_MATERIAL, MAT_COTTON);
  SetProp(P_ARTICLE, 1);
  SetProp(P_NODROP, "So wirst Du sie nicht mehr los...\n");
  SetProp(P_INFO, "Lieber schnell vernichten das Teil, bevor Du Dir "
                  "irgendwelche Krankheiten zuziehst.");


  AddCmd( ({ "vernicht", "vernichte" }), "c_vernichten");


}

int c_vernichten(string str)
{
 if( str != "mullbinde" &&
     str != "binde"     )
 {
  notify_fail("Was moechtest Du vernichten?\n");
  return 0;
 }
 else
 {
   write(BS("Mit einem gewaltigen Schlag zerfetzt Du die Mullbinde "
            "zu feinen Staubkoernchen. "));
   say(CTPN+ " zerfetzt mit einem gewaltigen Schlag eine Mullbinde"
             " zu feinen Staubkoernchen.\n");
  RemoveCmd( ({ "vernicht", "vernichte" }) );
  call_out("remove", 0);
  return 1;
 }
}
