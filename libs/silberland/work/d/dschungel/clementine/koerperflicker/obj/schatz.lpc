
inherit "std/thing";

#include <properties.h>
#include "../dante.h"

void create()
{
  ::create();

  SetProp(P_SHORT, "Ein Stueck Mithril");
  SetProp(P_LONG,
    "Ein Stueck Mithril, das ganz hell strahlt! "
    "Es glaenzt und funkelt im Licht, und scheint im Gegensatz zum "
    "normalen Mithril etwas ganz Besonderes zu sein. " );
  SetProp(P_NAME, "Mithril");
  SetProp(P_GENDER, NEUTER);
  AddId(({"stueck", "mithril", "stueck mithril", "leuchtmithril", 
			  "\nleuchtmithril"}));
  SetProp(P_INFO, "Wow, das Mithril leuchtet ganz toll!\n" );

  SetProp(P_MATERIAL, MAT_MITHRIL );
  SetProp(P_LIGHT, 1);
  SetProp(P_WEIGHT, 12);
  SetProp(P_VALUE, 10000);
  SetProp(P_NOBUY, 1);
  SetProp(P_COLOR, "weiss");
}

