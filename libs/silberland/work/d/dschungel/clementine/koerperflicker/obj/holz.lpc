
inherit "std/thing";
#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../dante.h"


create()
{

  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein Holzstueck");
  SetProp(P_LONG,
    "Ein ganz normales Holzstueck. ");
  SetProp(P_NAME, "Holzstueck");
  AddId( ({ "stueck", "holzstueck" }) );
  SetProp(P_GENDER, NEUTER);
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 5);
  SetProp(P_MATERIAL, MAT_WOOD);
  SetProp(P_ARTICLE, 1);
  SetProp(P_INFO, "Dieses Holzstueck koennte man jemanden wunderbar in den "
                  "Mund stecken. ");
  
}

