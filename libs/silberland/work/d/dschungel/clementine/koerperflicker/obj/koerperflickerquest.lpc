
/*********************************

  Questitem fuer Koerperflicker  

**********************************/

inherit "std/thing";

#include "../dante.h"
#include <properties.h>
#include <language.h>

void create()
{
  if (!is_clone(this_object())) return; 

  ::create();

  AddId( QUESTITEM );
  SetProp(P_SHORT, 0);
  SetProp(P_NAME, 0);
  SetProp(P_GENDER, NEUTER);
  SetProp(P_NOSELL, 1);
  SetProp(P_NOBUY, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_WEIGHT, 0);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_VALUE, 0);

  write_file(QUESTLOG "quest.log",

    dtime(time())+": "+TPUID+" beginnt die Quest.\n");

}




