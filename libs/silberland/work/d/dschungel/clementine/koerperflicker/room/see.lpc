inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../dante.h"

void create()

{

  ::create();
  SetProp(P_INT_SHORT, "Unter Wasser");
  SetProp(P_INT_LONG,
     "Du tauchst tief unten, mitten in dem kleinen See. Unter Dir "
     "siehst Du die vielen kleinen verschiedenfoermigen Steinchen, die " 
     "auf dem Grund liegen. Weiter oben, wo der Wasserfall sich mit dem "
     "See vereinigt bemerkst Du ein leichtes Glitzern. Ab und an schwimmen "
     "einige Fische an Dir vorbei. " );
  
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);

  SetProp(P_ENVIRONMENT,
    ([ENV_TEMPERATURE: 15, ENV_TERRAIN:TT_UNDERWATER, ENV_WATER:500]) );
  

//DETAILBEGINN

  AddDetail( ({ "grund" }),
    "Auf dem Grund kannst Du Steine in allen moeglichen Formen und "
    "Farben ausmachen.");

  AddDetail( ({ "steine", "stein" }),
    "Auf dem Grund des Sees liegen ganz viele verschiedene Steine. ");

  AddDetail( ({ "form", "formen" }),
    "Manche sind eckig, manche rund, manche spitz, manche oval, ...");

  AddDetail( ({ "farben", "farbe" }),
    "Du siehst weisse, rote, aber auch schwarze Steine auf dem Grund liegen .");

  AddDetail( ({ "schwarze steine", "schwarzer stein", "schwarz" }),
    "Selten schwarze Steine liegen auf dem Grund. ");

  AddDetail( ({ "boden" }),
    "Du meinst wohl den Grund?!");

  AddDetail( ({ "himmel" }),
    "Sehr verschwommen siehst Du weit ueber Dir das Blau des Himmels. ");

  AddDetail( ({ "blau" }),
    "Du kannst es aufgrund der Spiegelungen an der Wasseroberflaeche wirklich "
    "nicht besonders gut erkennen.");

  AddDetail( ({ "spiegelungen" }),
    "Das Licht spiegelt sich an der Wasseroberflaeche, deswegen kannst Du "
    "kaum etwas erkennen.");

  AddDetail( ({ "licht" }),
    "Das Licht kommt von oben.");

  AddDetail( ({ "wasseroberflaeche", "oberflaeche" }),
    "Die Wasseroberflaeche ist ueber Dir.");

  AddDetail( ({ "wasser" }),
    "Das Wasser ist sehr klar, sodass Du alles gut erkennen kannst. ");

  AddDetail( ({ "fische", "fisch" }),
    "Manchmal schwimmen einige kleine Fische an Dir vorbei. ");

  AddDetail( ({ "see" }),
    "Du tauchst doch gerade in dem See!");

  AddDetail( ({ "wasserfall" }),
    "Dort wo der Wasserfall ins Wasser faellt (Anm. d. Redaktion: Danke "
    "Lisp fuer dieses Verb) siehst Du ein sonderbares Glitzern. ");

  AddDetail( ({ "glitzern" }), 
    "Wow! Das Glitzern glitzert wunderschoen!");

  AddDetail( ({ "steinchen" }),
    "Grosse, kleine, dicke, duenne, runde, eckige, ... ganz viele "
    "verschieden liegen da unter Dir auf dem Grund des Sees.");

  AddDetail( ({ "lisp" }),
    "Lisp ist eine einzigartige blaue Fee!");

  AddDetail( ({ "fee" }),
    "Eine Fee ist eine Art Flugungeheuer!");

  AddDetail( ({ "art" }),
    "Ja so in etwa.");

  AddDetail( ({ "ungeheuer", "flugungeheuer" }),
    "Eine Fee!");

  AddDetail( ({ "anm", "anmerkung" }),
    "Anm. steht fuer Anmerkung.");

  AddDetail( ({ "redaktion" }), 
    "Das Wort Redaktion steht dann wohl fuer mich :)");

  AddDetail( ({ "wort" }),
    "Ein Wort schwimmt schnell an Dir vorbei.");

  AddDetail( ({ "verb" }),
    "Toll, nicht wahr?!");


//SOUNDS


  AddSound(DEFAULT_SOUND,
    "Durch das viele Wasser sind Deine Ohren wie zugestoepselt. ");

  AddSound( ({ "wasser", "ohren", "ohr" }),
    "Du hoerst leider gar nichts.");

//SMELLS

  AddSmell(DEFAULT_SMELL,
    "Leider riechst Du hier vor lauter Wasser gar nichts.");

  AddSmell( ({ "wasser" }),
    "Das Wasser riecht eindeutig wassrig!");


//COMMANDS

  AddCmd( ({ "tauch", "tauche" }), "c_tauchen");
  AddCmd( ({ "wuehl", "wuehle" }), "c_wuehlen");   


}

int c_tauchen(string str)
{
	if(str != "auf"    &&
           str != "zum glitzern"  &&
	   str != "zu glitzern"   &&
	   str != "zum glitzern hin"   &&
	   str != "nach glitzern"    )
	{
		notify_fail("Wohin moechtest Du tauchen? Auf, oder wohin?\n");
		return 0;
	}
	if(str == "auf" )
	{
		write(BS("Du tauchst wieder auf."));
		TP->move(ROOM "schwimm", M_GO, "auf", "taucht", "kommt "
				"hochgetaucht" );
		return 1;
	}
	else
	{
		write(BS("Du tauchst zum Glitzern und findest Dich "
					"auf einmal ganz woanders wieder."));
		TP->move(ROOM "geheim", M_GO, "weg", "taucht", "kommt "
				"hereingetaucht ");
		return 1;
	}
}




int c_wuehlen(string str)
{
	if(str != "in steine"   &&
           str != "grund auf"   &&
           str != "in grund"    )
	{
	  notify_fail("Worin moechtest Du wuehlen?\n");
  	  return 0;
	}
	else
	{
	 write(BS("Du wuehlst etwas den Grund auf, findest aber nichts.\n"));
 	 return 1;
	}
}

