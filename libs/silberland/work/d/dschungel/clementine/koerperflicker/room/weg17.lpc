
inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../dante.h"


create()
{

::create();

  SetProp(P_INT_SHORT, "Im Dschungel");
  SetProp(P_INT_LONG,
	  "Von Sueden kommt ein ekelhafter Geruch, der Dich veranlasst Dir mit "
	  "Deiner Hand die Nase zuzuhalten. So etwas Widerliches hast Du selten "
	  "gerochen. Igitt! Das einzig Schoene hier ist eine kleine klare Quelle, "
	  "die ganz nah am Wegrand vor sich hin plaetschert. Bei den tropischen "
	  "Temperaturen ist eine kleine Abkuehlung sicherlich nicht "
	  "verkehrt. ");
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);

  AddExit( "norden", ROOM "weg16");
  AddExit( "suedwesten", ROOM "klo");

}

