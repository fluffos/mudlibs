
inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../dante.h"

int anz_nektar;

void reset()
{
	::reset();
	anz_nektar = 1;
}

void create()
{

  ::create();

  anz_nektar = 1;
  SetProp(P_INT_SHORT, "Im Dschungel");
  SetProp(P_INT_LONG,
	  "Du stehst auf einer kleinen Lichtung. Ueberall bluehen exotische "
	  "Blumen und Pflanzen, die einen lieblichen Duft verstroemen. "
	  "Im Norden befindet sich eine Felswand, ueber die ein kleiner "
	  "Wasserfall in einen kristallklaren See fliesst. Das Gesang "
	  "einiger Singvoegel laedt zum Verweilen ein. Der Ort wirkt "
	  "irgendwie sehr zerbrechlich und erinnert Dich deswegen an eine "
	  "Seifenblase. Etwas Besonderes muss hier sein, zumindest wuerde das "
	  "den totalen Gegensatz zum uebrigen Dschungel erklaeren. ");
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);


  AddItem(NPC "nix", REFRESH_DESTRUCT);
  

  AddExit("suedwesten", 
    ([ EX_FUNC    : "mithrilcheck" ]) );


// DETAILBEGINN

  AddDetail( "lichtung", QueryProp(P_INT_LONG));

  AddDetail( ({ "himmel" }), 
    "Der Himmel hier erstrahlt in einem schoenen Blau.");

  AddDetail( ({ "blau" }),
    "Toll! Zum ersten Mal verdecken Dir hier im Dschungel keine Pflanzen den "
    "Blick nach oben.");

  AddDetail( ({ "blick" }),
    "Du starrst gebannt in den Himmel.");

  AddDetail( ({ "dschungel" }),
    "Der Dschungel ist ein gefaehrlicher Ort. Nur hier wirkt er irgendwie "
    "ganz zerbrechlich und anders als sonst.");

  AddDetail( ({ "ort" }),
    "Momentan befindest Du Dich auf einer Lichtung mitten im Dschungel.");

  AddDetail( ({ "pflanzen", "pflanze" }),
    "Im Dschungel gibt es ueberall Pflanzen! Meinst Du eine "
    "bestimmte?");

  AddDetail( ({ "bestimmte pflanze", "bestimmte" }),
    "Welche?");

  AddSpecialDetail( ({ "wasser" }), "wasserinfo");

  AddDetail( ({ "see" }),
    "Das Wasser des Sees ist kristallklar. Ob da jemand im Wasser schwimmt?");

  AddDetail( ({ "schwimmen" }),
    "Hoffentlich befinden sich keine Blutegel im See?!");

  AddDetail( ({ "blutegel", "egel" }),
    "Du magst es so gar nicht wenn Blutegel sich an Dir festsaugen.");

  AddDetail( ({ "seifenblase" }),
    "Alles wirkt hier so schillernd und gleichzeitig zerbrechlich. ");

  AddDetail( ({ "wasserfall" }),
    "Ein kleiner Wasserfall fliesst ueber eine Felswand direkt in den See.");

  AddDetail( ({ "felswand" }),
    "Die Felswand ist riesig hoch, ein Raufklettern ist wohl unmoeglich. "
    "Ueber die Felsen hat ein kleiner Wasserfall seinen Weg in den See "
    "gefunden.");

  AddDetail( ({ "raufklettern" }),
    "Der Wasserfall macht durch seine Naesse ein Raufklettern wirklich "
    "unmoeglich. ");

  AddDetail( ({ "naesse" }),
    "Der Felsen ist bestimmt ganz nass und glitschig.");


  AddDetail( ({ "boden" }),
    "Der Boden ist hier mit Gras bewachsen. ");

  AddDetail( ({ "gras" }),
    "Gruenes Gras, nicht sehr hoch - angenehm fuer Deine Fuesse.");

  AddDetail( ({ "fuesse", "fuss" }),
    "Schoen, dass das Gras hier nicht so hoch ist, nicht wahr?");

  AddDetail( ({ "mal" }),
    "Wirklich eine Seltenheit!");

  AddDetail( ({ "seltenheit" }),
    "Man sollte den Blick in den Himmel geniessen. ");

  AddDetail( ({ "felsen", "fels" }), 
    "Die Felsen sehen glitschig aus - definitiv nicht zum Raufklettern "
    "geeignet. ");

  AddDetail( ({ "wand" }),
    "Meinst Du die Felswand? ");

  AddDetail( ({ "voegel", "voegeln" }),
    "Bei den Voegeln handelt es sich um Singvoegel. ");

  AddDetail( ({ "singvogel", "singvoegel", "singvoegeln" }),
    "Viele Singvoegel beschallen Dich hier rundherum mit ihrem "
    "Gesang. ");

  AddDetail( ({ "gesang" }),
    "Lauschen waere angebrachter. ");

  AddDetail( ({ "verweilen" }),
    "Ein netter Platz um sich etwas auszuruhen. ");

  AddDetail( ({ "platz" }),
    "Schoen ist es hier!");

  AddDetail( ({ "norden" }),
    "Im Norden befindet sich eine Felswand. ");

  AddDetail( ({ "duft" }),
    "Probiers lieber mit riechen. ");

  AddDetail( ({ "weg" }),
    "Ein Wasserfall findet seinen Weg ueber die Felsen in den See. ");

  AddDetail( ({ "gegensatz" }),
    "Irgendwie wirkt hier alles anders als im restlichen Dschungel. ");

  AddDetail( ({ "besonderes" }),
    "Was das nur sein kann? Vielleicht liegts am See. ");

  AddDetail( ({ "blumen", "blume" }),
    "Ganz viele exotische Blumen wachsen hier. Sie bluehen in den "
    "unterschiedlichsten Groessen und Formen. Wirklich faszinierend!");

  AddDetail( ({ "groessen", "groesse" }),
    "Es gibt ganz kleine Blueten, aber auch grosse, eckige, ovale, runde, ... "
    "Ein wahres Wunderwerk der Natur. ");

  AddDetail( ({ "wunderwerk", "natur" }),
    "Die grosse Artenvielfalt laesst Dich jedesmal wieder staunen. ");

  AddDetail( ({ "artenvielfalt", "vielfalt" }),
    "Wirklich faszinierend!");

  AddDetail( ({ "blueten", "bluete" }),
    "Die ovale rote Bluete faellt Dir besonders auf. ");

  AddDetail( ({ "ovale rote bluete" }),
    "Du solltest wirklich mal an ihr schnuppern. ");

  AddDetail( ({ "formen" }),
    "Wirklich sehr beeindruckend!");

//Smells

  AddSmell(DEFAULT_SMELL,
    "Es riecht hier alles einfach himmlisch. ");

//Sounds

  AddSound(DEFAULT_SOUND,
    "Du lauscht dem Gesang der Voegel. ");

  AddSound( ({ "gesang" }),
    "*zwiep* *zwiep* *trallala* *trara* *taram* *klirring* *klong*");

  AddSound( ({ "voegel", "voegeln", "singvoegel" }),
    "An den Voegeln kannst Du nicht lauschen, Du kannst nur ihrem "
    "Gesang lauschen. ");

  AddSound( ({ "zwiep", "trallala", "trara", "taram", "klirring" }),
    "Klingt herrlich!");

  AddSound( ({ "klong" }),
    "Das >klong< gehoert irgendwie nicht zu dem sonst so typischem "
    "Vogelgesang. ");

  AddSound( ({ "vogelgesang" }),
    "Sehr seltsam.");

//CMDS

  AddCmd( ({ "steck", "stecke" }), "c_stecken");
  AddCmd( ({ "schnupper", "schnuppre", "schnuppere" }), "c_schnuppern");
  AddCmd( ({ "geniess", "geniesse" }), "c_geniessen");
  AddCmd( ({ "kletter", "klettre", "klettere" }), "c_klettern");
  AddCmd( ({ "schwimm", "schwimme" }), "c_schwimmen");

}

string wasserinfo(string str)
{
	call_other(ROOM "schwimm", "???");
        return ROOM "schwimm"->int_short(TP,TP,0);
}

int c_stecken(string str)
{
	object ob;
	if(str != "finger in ovale rote bluete hinein" &&
           str != "finger in ovale rote bluete" )
	{
		notify_fail("Wo moechtest Du was hineinstecken?\n");	
		return 0;
	}
	if(anz_nektar < 1)
	{
		write(BS("Du steckst Deinen Finger in die Bluete - "
			"es passiert aber rein gar nichts. "));
		return 1;
	}
	else
	{
		write(BS("Du steckst Deinen Finger in die ovale rote "
			"Bluete und holst etwas Nektar heraus. "));
	        say(CTPN + " steckt seinen Finger in eine Bluete.\n");
		ob = clone_object(OBJ "nektar");
         	if(ob->move(TP, M_GET) != 1)

                {
                tell_object(TP, "Das kannst Du nicht mehr tragen!\n");
                ob->move(TO, M_NOCHECK);
                }
         	anz_nektar--;
		return 1;
	}
}


int c_schnuppern(string str)
{
	if(str != "an ovaler roter bluete" )
	{
		notify_fail("Woran moechtest Du schnuppern?\n");
		return 0;
	}
	else
	{
		write(BS("Die riecht sehr lecker nach Honig. Vielleicht "
		 "kannst Du mal Deinen Finger hineinstecken?"));
		say(CTPN + " schnuppert an einer Blume.\n");
		return 1;
	}
}


int c_geniessen(string str)
{
	if(str != "blick in himmel"  &&
	   str != "blick in den himmel" &&
	   str != "blick zum himmel"    )
	{
		notify_fail("Was moechtest Du geniessen?\n");
		return 0;
	}
	else
	{
		write(BS("Du geniesst den wunderbaren Himmel ueber Dir. "));
		say(CTPN + " geniesst den Blick in den Himmel.\n");
		return 1;
	}
}



int c_klettern(string str)
{
	if(str != "auf felsen"   &&
	   str != "auf die felswand rauf"  &&
	   str != "auf felswand rauf" &&
	   str != "auf felsen rauf"   &&
	   str != "auf die felsen rauf" )
	{
		notify_fail("Worauf moechtest Du klettern? Auf die "
				"Felswand?\n");
		return 0;
	}
	else
	{
		write(BS("Geschickt kletterst Du die ersten Meter auf die "
					"Felswand rauf. Doch ploetzlich "
					"verlierst Du den Halt und rutscht "
					"ab."));
		say(CTPN + " versucht die Felswand raufzuklettern, rutscht "
				"aber ab.\n");
		TP->move(ROOM "schwimm", M_GO, "stuerzt", "in den See");
		return 1;
	}
}


int mithrilcheck()
{
 if((present("nix", TO)) && (deep_present("\nleuchtmithril", TP)))	  
  { 
   notify_fail("Der Nix laesst Dich mit Teilen seines Schatzes "
			   "nicht vorbei!\n");
   return 0;
  }
 else
 {
  TP->move(ROOM "weg3", M_GO, "nach Suedwesten");
  return 1;
 }
}


int c_schwimmen(string str)
{
	if(str != "in see" &&
	   str != "im see" )
	{
		notify_fail("Wo moechtest Du schwimmen?\n");
		return 0;
	}
	else
	{
		write(BS("Froehlich huepfst Du in den See um zu Schwimmen."));
		TP->move(ROOM "schwimm", M_GO, "ins Wasser", "hupft", 
		       "hupft herein"	);
		return 1;
	}
}

