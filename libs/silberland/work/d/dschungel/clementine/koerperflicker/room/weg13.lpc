// festern sueden buschfahrrad schlafzi
inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../dante.h"


create()
{

::create();

  SetProp(P_INT_SHORT, "Im Dschungel");
  SetProp(P_INT_LONG, 
	  "Du stehst auf einer kleinen Lichtung, die sicherlich nicht "
	  "natuerlichen Ursprungs ist. Im Sueden siehst Du ein Fenster in der "
      "Hauswand, durch das Du sicherlich einen Blick ins Innere werfen kannst. "
	  "Ein kleines Beet wurde hier angelegt, in dem Du ein paar rote "
	  "Kuegelchen entdecken kannst. Neben ihm wachsen einige grosse "
	  "Blumen mit lustigen gelben Koepfen. ");
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);

  AddExit( "suedwesten", ROOM "weg12");
  AddExit( "osten", ROOM "weg14");

}

