
inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../dante.h"


create()
{

::create();

  SetProp(P_INT_SHORT, "Im Dschungel");
  SetProp(P_INT_LONG, 
	  "Hurra, zur Abwechslung mal wieder gruene Baeume und Pflanzen. "
	  "Das haettest Du jetzt nicht erwartet. Leider hat sich die "
	  "Temperatur hier ebenfalls nicht viel veraendert, und die dichte "
	  "Bepflanzung macht es nicht gerade ertraeglicher. "
	  "Weiter im Sueden scheint etwas zu verwesen, zumindest wuerde "
	  "das den Geruch erklaeren, der aus dieser Richtung kommt. ");
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);

  AddExit( "norden", ROOM "weg15");
  AddExit( "sueden", ROOM "weg17");

}

