
inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../dante.h"


create()
{
    
::create();
    
  SetProp(P_INT_SHORT, "In einem Wartezimmer" );
  SetProp(P_INT_LONG,
    "Du stehst in einem kleinen Wartezimmer, dessen Waende mit den "
    "verschiedensten Diplomen zugepflastert sind. An der Westwand "
    "befindet sich ein Schreibtisch, auf dem alle moeglichen "
    "Journale und Zettel liegen. Dahinter steht ein Sessel. Im Osten "
    "befindet sich eine Tuer, die in den Bettenraum fuehrt. Ein kleines "
    "hoelzernes Baenkchen steht hier, das wohl fuer wartende Patienten gedacht "
    "ist. Nach Westen hingegen kommst Du in den Behandlungsraum. ");
  SetProp(P_LIGHT, 1);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);

  AddExit( "osten", ROOM "betten");
  AddExit( "westen", ROOM "behandlung");
  AddExit( "norden", ROOM "flur");
  AddExit( "sueden", ROOM "veranda");
   

// waende - KITTEL ! 

  AddDetail( ({ "wartezimmer", "zimmer" }), 
	 "Na was glaubst Du denn wo Du Dich befindest? Auf dem Mount Everest? ");

  AddDetail( ({ "mount", "mount everest", "berg",  "everest" }),
	 "Du solltest unbedingt mal den grosse maechtigen Dante aaaeh Axel mein "
	 "ich natuerlich, nach seinen sagenhaften Bergtouren fragen. ");

  AddDetail( ({ "bergtouren", "touren" }), 
	 "Bin ich Dein Laufbursche, oder hast Du selber 2 Fuesse damit Du "
	 "hingehen kannst und nachfragen?! ");

  AddDetail( ({ "fuesse", "laufbursche", "bursche" }),
	 "Also erstens bin ich wenn dann ein Laufmaederl, und zweitens sag ich "
	 "Dir jetzt gar nichts mehr!");

  AddDetail( ({ "laufmaederl", "maederl" }),
	 "Gar nichts mehr sag ich Dir jetzt! ");
// axel info mount everest und co

  AddDetail( ({ "baenkchen" }),
	 "Also unter Luxus stellst Du Dir da echt was anderes vor. Draussen "
	 "noch ein hightech Telefon fuer den Doktor, und hier ein mickriges von "
	 "Wuermern fast zerfressenes Baenkchen fuer seine Patienten. So ein "
	 "Geizhals!");

  AddDetail( ({ "axel" }),
	 "Na der lungert doch sicherlicht draussen bei seiner Gerda rum.");  

  AddDetail( ({ "gerda" }),
	 "Wo Gerda ist, da kann Axel bestimmt nicht weit sein. Schliesslich "
	 "braucht er ja immer wieder was zwischen seinen Haenden.");

  AddDetail( ({ "haende" }),
	 "Pfui. Dich ekelt es allein schon bei der Vorstellung.");

  AddDetail( ({ "vorstellung" }),
	 "Sag mal... hast Du nichts anderes zu tun, als bloed hier rumzuforschen? "
	 "Baldi braucht doch Deine Hilfe!");

  AddDetail( ({ "hilfe" }),
	 "Du wirst gleich Hilfe brauche, wenn Du so weiter machst.");

  AddDetail( ({ "dante" }),
	 "Wo der wohl gerade steckt?");

  AddDetail( ({ "journale" }),
	 "Zwischen all den Freundinnen, Brigittes und Co. sticht Dir sofort eine "
     "Bunte ins Auge.");

  AddDetail( ({ "bunte" }),
	 "Naja irgendwo muss sich Gerda ja ihr Fachwissen aneignen. Oder "
	 "dachtest Du sie liest waehrend dem Naegellackieren in irgendwelchen "
	 "Lexika?!");

  AddDetail( ({ "fachwissen", "wissen" }),
	 "z.B.: wann, wo und wie der Prinz von Midas seinen Blaehungen freien "
	 "Lauf laesst.");

  AddDetail( ({ "lauf" }),
	 "Nerv nicht, sonst gibts von Dr. K. gleich einen Einlauf!");

  AddDetail( ({ "einlauf" }),
	 "Womit Du Dich schon wieder befassen moechtest...");

  AddDetail( ({ "midas" }),
     "Von Midas bist Du hier weit entfernt.");

  AddDetail( ({ "prinz" }),
	 "Man munkelt, dass man den Prinzen mittlerweile aufgrund seiner "
	 "Blaehungen in eine finstere Gruft gesperrt hat.");

  AddDetail( ({ "gruft" }),
	 "Finster sag ich nur!!!");

  AddDetail( ({ "blaehung", "blaehungen" }),
	 "Wenn Du welche hast, dann verzieh Dich bitte richtung Buschklo! Hier "
	 "will ich solche Ausduenstungen nicht sehen!");

  AddDetail( ({ "ausduenstungen", "ausduenstung" }),
     "Das Buschklo ist da wirklich der richtige Ort.");

  AddDetail( ({ "ort", "oertchen" }),
	 "Na das Buschklo Du Ei!");

  AddDetail( ({ "eier", "ei" }),
	 "Wenn Du faule Eier atmen willst, dann wie gesagt: es gibt hier ein "
	 "wunderbares Oertchen fuer sowas!");

  AddDetail( ({ "buschklo", "klo"}),
	 "Zuerst nach S, dann nach O, dann bist Du auf dem Stinkeklo!");

  AddDetail( ({ "stinkeklo" }),
	 "Ein stinkendes Klo!");

  AddDetail( ({ "freundinnen", "brigittes" }),
	 "Wenn Du nach einem supermodernen Outfit suchst, oder einen kotzigen "
	 "neuen Haarschnitt moechtest, dann empfehl ich Dir den Kauf eines solchen "
	 "Magazins.");

  AddDetail( ({ "outfit", "haarschnitt" }),
	 "Naja Du sahst wirklich schon mal besser aus... aber die Zeiten sind "
	 "hart fuer Spieler momentan.");

  AddDetail( ({ "spieler" }),
	 "Fuer Dich.");

  AddDetail( ({ "zeiten", "zeitn" }),
	 "Lang lang sans her die guadn oidn Zeitn!");

  AddDetail( ({ "kauf", "magazin" }),
	 "Kauf Dir halt ein Magazin.");

  AddDetail( ({ "auge", "aug" }),
	 "Stich!");

  AddDetail( ({ "co" }),
	 "So genau willst Du das gar nicht wissen. ");

  AddDetail( ({ "lexika" }),
	 "Die wirst Du hier garantiert vergebens suchen. ");

  AddDetail( ({ "naegellackieren" }),
	 "Ausser dem Lackieren ihrer Naegel hat Gerda ja wohl nicht viel zu tun. ");

  AddDetail( ({ "lackieren", "naegel" }),
	 "Naegel lackieren soll angeblich auch eine Wissenschaft sein, in die "
	 "bis jetzt nur wenigen maennlichen Kreaturen ein Einblick gewaehrt "
	 "wurde. ");

  AddDetail( ({ "wissenschaft" }),
	 "Also ich hab da privat eigentlich keine Ahnung davon. Ich bin zwar "
	 "weiblich, aber meine Naegel bleiben kurz und unlackiert. Schliesslich "
	 "will ich fuer die keinen Waffenschein brauchen. ");

  AddDetail( ({ "waffenschein", "schein" }),
	 "Also mal unter uns: Es gibt doch tatsaechlich Frauen wie unter andrem "
	 "auch Gerda, die da echt so riesen Dinger haben! Ich mein was machen die "
	 "den ganzen Tag? Naja bei mir wird jedenfalls noch taeglich geputzt und "
	 "gewaschen, da kann ich mir so was Sinnloses nicht erlauben.");

  AddDetail( ({ "dinger" }),
	 "Also ich mein jetzt die Naegel!");
	 
  AddDetail( ({ "sinnloses" }),
	 "Naja...wers braucht ;)");

  AddDetail( ({ "frauen" }),
	 "Manche funktionieren glaube ich wirklich nicht so richtig. ");

  AddDetail( ({ "kreaturen" }),
     "Ein netteres Wort fiel mir leider gerade nicht ein. ");

  AddDetail( ({ "tag" }),
	 "Tag oder nicht Tag? Das ist hier die Frage... Geh raus und schau einfach "
	 "nach!");

  AddDetail( ({ "frage", "wort" }),
	 "Ich beschreib doch nicht jedes Wort!");

  AddDetail( ({ "ahnung", "einblick" }),
	  "0");

  AddDetail( ({ "telefon", "kokosnusstelefon" }),
	  "Na hast Du dieses hypermegahochmoderne krasse Teil draussen nicht "
	  "gesehen?");

  AddDetail( ({ "teil" }),
	  "Das muss man gesehen haben!");

  AddDetail( ({ "wuermer" }),
	  "Hmm, lecker! Also hinsetzen moechtest Du Dich garantiert nicht!");

  AddDetail( ({ "luxus" }),
	  "Beim Baenkchen findest Du garantiert keine Spur von Luxus. Billiges "
	  "Holz, und sogar das haben schon Wuermer angenagt. ");

  AddDetail( ({ "holz" }),
	  "Irgendein billiges Holz wurde fuer das Baenkchen benutzt. Sicher so "
	  "ein 0815 Model aus dem Bauhaus. ");

  AddDetail( ({ "bauhaus" }),
	  "Sicher bei Obi!");

  AddDetail( ({ "obi" }),
	  "Kannst ja mal dort nachfragen. ");

  AddDetail( ({ "model", "0815" }),
	  "Ein Model der preiswerteren Sorte, um nicht zu sagen das billigste "
	  "was halt gerade nicht sofort einstuerzt, wenn man sich setzt.. ");

  AddDetail( ({ "spur" }),
	  "Sie ist _NICHT_ vorhanden.");

  AddDetail( ({ "nicht" }),
	  "Hurra! Ein Forscherpunkt.\n"
	  "Gierig versuchst Du ihn zu fangen, aber das Puenktchen ist "
	  "einfach schneller. ");

  AddDetail( ({ "forscherpunkt", "punkt", "puenktchen" }),
	  "Du warst einfach zu langsam!\n"
	  "Jemand lacht Dich aus der Ferne aus.");

  AddDetail( ({ "sorte" }),
      "Garantiert billig!");

  AddDetail( ({ "patienten", "patient" }),
	  "Du solltest aufpassen, dass Du nicht auch einer von ihnen wirst. "
	  "Man erzaehlt sich ja wirklich ueble Dinge ueber den Doktor. ");

  AddDetail( ({ "doktor", "dr" }),
	  "Er muesste immer noch bei Gerda rumlungern. ");

  AddDetail( ({ "dinge" }),
	  "Angeblich hat er mal jemanden anstatt eines Armes ein Bein angenaeht. "
	  "Und von den vielen anderen 'Missgeschicken' ganz zu schweigen. ");

  AddDetail( ({ "missgeschicke" }),
	  "Du solltest wirklich aufpassen, dass sich alle Koerperteile noch an der "
	  "richtigen Stelle befindest, wenn Du die Buschpraxis wieder verlaesst. ");

  AddDetail( ({ "koerperteile", "teile" }),
	  "Noch sind sie hoffentlich am richtigen Fleck.\n"
	  "Geschwind tastest Du alles ab - ja passt noch! ");

  AddDetail( ({ "stelle", "fleck" }),
	  "Noch alles richtig dran. ");

  AddDetail( ({ "arm", "bein" }),
	  "Kaum zu glauben, nicht wahr?!");

  AddDetail( ({ "praxis", "buschpraxis" }),
	  "Du stehst mitten drinnen. ");

  AddDetail( ({ "geizhals" }),
	  "Fuer ihn nur das Beste, und fuer alle anderen den Rest. ");

  AddDetail( ({ "beste", "rest" }),
	  "Tja so ist er halt...der Doktor...");

  AddDetail( ({ "osten" }),
	  "Im Osten befindet sich eine Tuer, die anscheinend in den Bettenraum "
	  "fuehrt. ");

  AddDetail( ({ "raum", "raeume" }),
	  "Hier gibt es viele Raeume...welchen meinst Du denn?");

  AddDetail( ({ "bettenraum" }),
	  "Der Bettenraum befindet sich anscheinend im Osten. Zumindest vernimmst "
	  "Du aus dieser Richtung ein leises Roecheln. ");

  AddDetail( ({ "roecheln" }),
	  "Lauschen!");

  AddDetail( ({ "katze" }),
	  "Klingt viel schlimmer");

  AddDetail( ({ "etwas" }),
	  "Geh lieber nachschauen, was hier so leidet!");

  AddDetail( ({ "westen" }),
	  "Dort befindet sich anscheinend der Behandlungsraum. ");

  AddDetail( ({ "behandlungsraum" }),
	  "Er befindet sich soviel Du sehen kannst im Westen. ");

  AddDetail( ({ "zetteln", "zettel" }),
	  "Einige bekritzelte Zettel liegen auf dem Tisch. Gerda scheint sich "
	  "wohl einiges notiert zu haben. ");

  AddReadDetail( ({ "zettel" }),
	  "+------------+\n"
	  "| 1 + 1 =  2 |\n"
	  "| 2 + 2 =  4 |\n"
	  "| 3 + 3 =  7 |\n"
	  "| 4 + 5 = 12 |\n"
	  "+------------+\n"
	  "\n"
	  "Gerda ist doch tatsaechlich ein richtiges Rechenass...\n");

  AddDetail( ({ "rechenass", "ass" }),
	  "Sieht ganz so aus ;)");

  AddDetail( ({ "notiz" }),
	  "+----------------------------+\n"
	  "|Keine rote Waesche mehr!!!  |\n"
	  "+----------------------------+\n");

  AddDetail( ({ "waesche" }),
	  "Anscheinend hat das den Doktor nicht so angetoernt. ");
 

  AddDetail( ({ "westwand" }),
	  "An der Westwand steht ein Schreibtisch. ");

  AddDetail( ({ "tisch", "schreibtisch" }),
	  "Scheint wohl Gerdas zu sein. Auf ihm herrscht zumindest eindeutig "
	  "das Chaos einer Frau. ");

  AddDetail( ({ "chaos" }),
	  "Journale, Zettel, Nagellack, Feile, Haarbuerste, ... alles was das "
	  "Herz einer Frau so begehrt. Ob sich hier ueberhaupt irgendwelche "
	  "Patientenakten befinden?");

  AddDetail( ({ "nagellack" }),
	  "Die Marke kann man leider nicht mehr erkennen, aber von der Farbe her "
	  "eindeutig rot. ");

  AddDetail( ({ "farbe" }),
	  "Eindeutig tussenrot. ");

  AddDetail( ({ "tussenrot", "rot" }),
	  "Schick, nicht wahr?!");

  AddDetail( ({ "tusse" }),
	  "Gerda gehoert eindeutig zur Gattung Tusse. ");

  AddDetail( ({ "gattung" }),
	  "Die Gattung Tusse ist leider alles andere als vorm Aussterben "
	  "bedroht. Du erkennst sie an unmoeglich lackierten Fingernaegel, "
	  "und einem mehr als knappen Hoeschen bzw. Roeckchen, was den Po "
	  "alles andere als verdeckt. ");

  AddDetail( ({ "hoeschen", "roeckchen", "po" }),
	  "Wenn Du ueber sowas rumplaenkeln willst, dann ab zu Gerda. ");

  AddDetail( ({ "fingernaegel" }),
	  "10cm lang und rot lackiert. ");

  AddDetail( ({ "aussterben" }),
	  "Auf das hoffen wir leider vergebens. ");

  AddDetail( ({ "haarbuerste", "buerste", "feile" }),
	  "Alles was frau waehrend dem Arbeiten so braucht. ");

  AddDetail( ({ "arbeiten", "arbeit" }),
	  "Also eine Feile ist waehrend des arbeitens wirklich ein Muss.");

  AddDetail( ({ "muss" }),
	  "Feile, Buerste, ... ");

  AddDetail( ({ "herz" }),
	  "Wirklich alles vorhanden. ");

  AddDetail( ({ "frau" }),
	  "Wenn Du Gerda meinst, die ist gerade nicht hier. ");

  AddDetail( ({ "marke" }),
	  "Sie ist leider nicht mehr richtig erkennbar. ");

  AddReadDetail( ({ "marke" }),
	  "M__n_rt__um\n"
	  "Mehr ist leider nicht mehr zu erkennen.\n");

  AddDetail( ({ "maennertraum" }),
	  "Du solltest Gerda mal danach fragen. ");

  AddDetail( ({ "decke" }),
	  "Die koennte auch mal wieder einen frischen Anstrich vertragen. ");

  AddDetail( ({ "anstrich" }),
	  "Sieht wirklich schon etwas gelblich aus. Wahr urspruenglich wohl mal "
	  "weiss gestrichen. ");

  AddDetail( ({ "boden", "holzboden" }),
	  "Ein einfacher Holzboden. Etwas staubig. Aber sonst wie jeder andere "
	  "Boden auch. ");

  AddDetail( ({ "sessel" }),
	  "Sieht nicht unbedingt gemuetlich aus, aber zum Sitzen allemal "
	  "geeignet. ");

  AddDetail( ({ "sitzen" }),
	  "Dafuer ist er sicherlich noch gut genug. ");

  AddDetail( ({ "akten", "patientenakten" }),
	  "Huch, da liegt doch taetsaechlich eine. ");

  AddDetail( ({ "patientenkate", "akte" }),
	  "Scheint eine zu sein. Aber Du hast natuerlich zuviel Anstand um sie "
	  "zu lesen. Allerdings blitzt unter der Akte etwas Rosanes hervor. ");

  AddDetail( ({ "rosanes", "rosa" }),
	  "Huch scheint wohl einer von Gerdas Strings zu sein. Schnell wieder die "
	  "Akte drueber. ");

  AddDetail( ({ "strings", "string" }),
	  "Ein huebscher rosa String, den Du ohne Handschuhe und Zange lieber "
	  "nicht beruehren moechtest. ");

  AddDetail( ({ "handschuhe", "zange" }),
	  "Sonst holst Du Dir vielleicht noch irgendeine Krankheit. ");

  AddDetail( ({ "krankheit" }),
	  "So genau kann man das ja nie wissen...");

  AddDetail( ({ "waende", "wand" }),
	  "Ganz normale weisse Waende. Sie sind fast alle mit Diplomen "
	  "zugepflastert. Nur hinter dem Baenkchen haengt stattdessen eine "
	  "Garderobe. ");

  AddDetail( ({ "garderobe" }),
	  "Die Garderobe hat 3 Haken und eignet sich zum Aufhaengen von Jacken "
	  "und anderer Kleidung. Ein weisser Kittel haengt momentan an einem "
	  "der Haken. ");

  // AddCmd aufhaengen

  AddDetail ( ({ "haken" }),
	  "Die Garderobe hat 3 Haken, doch nur einer ist momentan in "
	  "Verwendung. ");

  AddDetail( ({ "verwendung" }),
	  "Ein Kittel ist auf einem Haken aufgehaengt worden. ");

  AddDetail( ({ "kittel" }),
	  "Ein weisser Kittel mit einigen roten Spritzern. Vorne zu knoepfen und "
	  "seitlich je eine Tasche. ");

  AddDetail( ({ "spritzer" }),
	  "Scheint wohl Blut zu sein. ");

  AddDetail( ({ "blut" }),
	  "Nicht gerade appetitanregend. ");

  AddDetail( ({ "knoepfe" }),
	  "Fuenf Knoepfe befinden sich vorne. ");

  AddDetail( ({ "tasche" }),
	  "Welche meinst Du denn genau?");

  AddDetail( ({ "rechte tasche", "linke tasche" }),
	  "Sieht interessant aus!"); //addcmd quest
	  
  AddDetail( ({ "aufhaengen" }),
	  "Das heisst, dass Du dort etwas hinhaengen kannst!");

  AddDetail( ({ "jacken", "kleidung" }),
	  "Momentan haengt nichts der gleichen dort. ");

  AddDetail( ({ "tuer" }),
	  "Zumindest war es mal eine...");
  
  AddDetail( ({ "diplome" }),
	  "Du kannst sie lesen! (Syntax: lies diplom 1, ...)");

  AddReadDetail( ({ "diplom 1" }),
	  "\n"
	  "...........................\n"
	  ".                         .\n"
	  ".      Auszeichnung       .\n"
	  ".          fuer           .\n"
	  ".      Fahrradfahren      .\n"
	  ".   unter 0,9 Promille!   .\n"
	  ".                         .\n"
	  "...........................\n"
	  "\n"
	  "Du denkst. o O (WOW!!!)\n");

  AddReadDetail( ({ "diplom 2" }),
	  "\n"
	  "+-------------------------+\n"
	  "|                         |\n"
	  "|        1. Platz         |\n"
	  "|           im            |\n"
	  "|  Buchstabierwettbewerb  |\n"
	  "|                         |\n"
	  "+-------------------------+\n"
	  "\n"
	  "Dante ist echt ein Held!\n");

  AddReadDetail( ({ "diplom 3" }),
	  "\n"
	  "********************************\n"
	  "*                              *\n"
	  "* Auszeichnung fuer den besten *\n"
	  "*  Tuerengeschlossenhalter ;)  *\n"
	  "*                              *\n"
	  "********************************\n"
	  "\n"
	  "Danach solltest Du den Doktor unbedingt mal fragen!\n");

  AddReadDetail( ({ "diplom 4" }),
	  "\n"
	  "+~~~~~~~~~~~~~~~~~~~~~~~~+\n"
	  "|                        |\n"
	  "|  Jahrgangsbester 1956  |\n"
	  "|                        |\n"
	  "+~~~~~~~~~~~~~~~~~~~~~~~~+\n"
	  "\n"
	  "Du denkst . o O (Gute Arbeit hat halt ihren Preis...)\n");

  AddReadDetail( ({ "diplom 5" }),
	  "\n"
	  "+-----------------------------+\n"
	  "|                             |\n"
	  "|    Teilnahmebestaetigung    |\n"
	  "| am erweiterten Lehrgang zum |\n"
	  "|        Verstaendnis         |\n"
	  "|           und zur           |\n"
	  "|       Interpretation        |\n"
	  "|   diverser literarischer    |\n"
	  "|            Werke            |\n"
	  "|                             |\n"
	  "+-----------------------------+\n"
	  "\n");
  
  
// SOUND


  AddSound( ({ "roecheln" }),
	  "Eigentlich klingt es mehr nach einem Stoehnen. ");

  AddSound( ({ "stoehnen" }),
	  "Also eine rollige Katze ist nichts dagegen...Vielleicht solltest Du "
	  "mal nachschauen was da los ist, und diese arme Etwas erloesen. ");

  


} 
