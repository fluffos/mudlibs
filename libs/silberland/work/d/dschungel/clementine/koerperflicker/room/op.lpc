int c_putzen(string str)
{
 if(str != "fleischreste von mullbinde weg" &&
    str != "fleischreste weg"                )
 {
  notify_fail("Was moechtest Du wegputzen?\n");
  return 0;
 }
 else
 {
  write(BS("Igitt! Lass bloss die Finger weg davon! Oder willst Du Dir "
           "irgendwelche Krankheiten einfangen?"));
  return 1;
 }
}


int c_fassen(string str )
{
 if(str != "verband an"         &&
    str != "verbandszeug an"    &&
    str != "zeug an"            )
 {
  notify_fail("Was moechtest Du anfassen?\n");
  return 0;
 }
 else
 {
  if(anz_gift < 1)
  {
   write(BS("Igitt nein, das willst Du grad nicht anfassen!"));
   return 1;
  }
  else
  {
   write(BS("Igitt!!!! Du fasst einfach das dreckige Verbandszeugs an!!! "
           "Hoffentlich hast Du Dir jetzt keine Blutvergiftung geholt! "));
   TP->AddPoison(3);
   anz_gift--;
   return 1;
  }
 }
}
 
int c_kosten(string str)
{
 if(str != "mischung" )
 {
  notify_fail("Was moechtest Du hier kosten?\n");
  return 0;
 }
 else
 {
  if(anz_heal < 1)
  {
   write(BS("Nein momentan willst Du hier einfach nichts kosten!"));
   return 1;
  }
  else
  {
   write(BS("Du steckst Deinen Finger in die leckere (*kotz*) "
           "Blut-Eiter-Mischung und danach in Deinen Mund. Igitt! Sofort "
           "kotzt Du alles wieder aus."));
   TP->AddHp(-30);
   anz_heal--;
   say(CTPN + " kotzt auf den Boden.\n");
   return 1;
  }
 }
}

 

bravur_func(string str)
