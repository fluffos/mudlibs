
inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../dante.h"


create()
{

::create();

  SetProp(P_INT_SHORT, "In einem Bettenraum");
  SetProp(P_INT_LONG,
    "Du stehst ploetzlich in einem heissen stickigen Raum, der seit "
    "Wochen, wenn nicht sogar Monaten, nicht durchlueftet wurde. Alles "
    "wirkt schmuddelig und ab und an kannst Du auf den Waenden suesse "
    "kleine Schaben ausmachen. Vier Betten mit durchgeschwitztem Bettzeug "
    "stehen hier. In einem von ihnen liegt Baldi, dessen Blaseninhalt gerade "
    "durch ein Bambusrohr in eine Kokosnussschale laeuft. Du kannst diesem "
    "Elend kaum noch laenger zusehen - widerlich! "); 
  SetProp(P_LIGHT, 1);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);

  AddExit( "westen", ROOM "warte");

  AddItem(NPC "baldi", REFRESH_DESTRUCT);

  
// DETAILBEGINN

  AddDetail( ({ "raum" }), QueryProp(P_INT_LONG) );

  AddDetail( ({ "wochen" }),
	  "Das ist bestimmt schon einige Monate her, dass hier mal richtig "
	  "durchgelueftet wurde. In Deine Nase brennt sich ein ekelhafter "
	  "Uringeruch.");

  AddDetail( ({ "uringeruch", "geruch" }),
	  "Probiers mal mit riechen!");

  AddDetail( ({ "monate", "monat" }),
	  "Es ist auf jeden Fall schon ziemlich lange her, dass hier mal "
	  "Frischluft durchkam!");

  AddDetail( ({ "frischluft", "luft" }),
	  "Danach wirst Du hier wirklich vergeblich suchen!");

  AddDetail( ({ "nase" }),
	  "Ekelhaft dieser Geruch!");

  AddDetail( ({ "fall" }),
	  "Fall!");

  AddDetail( ({ "inhalt" }),
	  "Was fuer einen Inhalt meinst Du?");

  AddDetail( ({ "blaseninhalt" }),
	  "Mhmm, lecker! Der laeuft gerade durch ein Bambusrohr, dass sicherlich "
	  "noch nie irgendwie gereinigt wurde. ");

  AddDetail( ({ "bambusrohr", "rohr" }),
	  "So wie Du Dr. Koerperflicker kennst, verwendet er fuer seine "
	  "Patienten natuerlich nur das Beste vom Besten. So wie auch dieses "
	  "Bambusrohr. ");

  AddDetail( ({ "dr.", "dr", "doktor", "koerperflicker" }),
	  "Zum Glueck ist er nicht in der Naehe, sonst wuerde er sicherlich "
	  "versuchen unter Deinen Rock zu glubschen. ");

  AddDetail( ({ "rock" }),
	  "Ich meinte natuerlich das Kittelchen. Wobei viel Unterschied von "
	  "der Groesse her macht das in diesem Fall nicht. ");

  AddDetail( ({ "groesse" }),
      "Das Kittelchen ist garantiert genauso knapp wie ein Rock. ");

  AddDetail( ({ "kittelchen" }),
	  "Du traegst es doch, oder?!");

  AddDetail( ({ "unterschied" }),
	  "Der ist wirklich kaum bemerkbar. ");

  AddDetail( ({ "elend" }),
	  "Es ist wirklich kaum zu ertragen. Vielleicht kannst Du diesem "
	  "Elend hier ja ein Ende bereiten?");

  AddDetail( ({ "ende" }),
	  "Wenn Du nur wuesstest, wie Du dem Elend hier ein Ende bereiten "
	  "koenntest... Vielleicht hilft ja, wenn Du einfach mal ende eintippst. ");

  AddDetail( ({ "glueck" }),
	  "Kannst froh sein!");

  AddDetail( ({ "naehe" }),
	  "Er ist nicht hier. ");

  AddDetail( ({ "beste", "besten", "bestem" }),
	  "Der Doktor ist darauf bedacht nur das Beste vom Besten zu verwenden. "
	  "Selbstverstaendlich gilt das aber hauptsaechlich fuer ihn selbst. ");

  AddDetail( ({ "waende", "wand" }),
	  "Die Waende sind in einem netten pastelligen Rosa gehalten. Manchmal "
	  "kannst Du sogar kleine niedliche Schaben ausmachen, die auf ihnen "
	  "herumkrabbeln. ");

  AddDetail( ({ "rosa" }),
	  "Beim naeheren Betrachten stellst Du fest, dass die Waende "
	  "urspruenglich mal weiss waren... irgendwer hat hier wohl "
	  "scheinbar einmal versucht ein paar Blutsspritzer mit Wasser "
	  "wegzuwischen. ");

  AddDetail( ({ "blutspritzer", "spritzer" }),
	  "Interessante Wischtechnik!");

  AddDetail( ({ "wischtechnik", "technik" }),
	  "Beeindruckend!");

  AddDetail( ({ "wasser" }),
	  "Tja, hat wohl nicht ganz funktioniert das Blut mit dem Wasser "
	  "wegzubekommen. Naja, dafuer erscheint der Raum in dem Rosa wenigstens "
	  "etwas freundlicher. ");

  AddDetail( ({ "blut" }),
	  "Mhmm, lecker!");

  AddDetail( ({ "wasser" }),
	  "Irgendjemand hat sich sogar mal die Muehe gegeben, und wollte mit "
	  "dem Wasser die Waende reinigen. Scheint wohl schon sehr lange "
	  "herzusein. ");

  AddDetail( ({ "rosa" }),
	  "Ein sehr huebscher Farbton. ");

  AddDetail( ({ "farbton", "ton" }),
	  "Einfach toll!");

  AddDetail( ({ "schaben" }),
	  "Sind die nicht suess?! Sie krabbeln an den Waenden entlang und "
	  "ernaehren sich von diversen Patientenresten. ");

  AddDetail( ({ "reste", "patientenreste" }),
	  "Manchmal bleiben hier z.B. auch Hautfetzen ueber, die keine "
	  "Verwendung mehr finden. Die Schaben haben ihre Freude daran!");

  AddDetail( ({ "hautfetzen", "haut", "fetzen" }),
	  "Ein richtiges Festessen fuer die kleinen Mitbewohner hier. ");

  AddDetail( ({ "mitbewohner", "bewohner" }),
	  "Sie scheinen wirklich allesamt wohlgenaehrt zu sein. ");

  AddDetail( ({ "festessen", "essen" }),
	  "*schmatz*");

  AddDetail( ({ "verwendung" }),
	  "Wenn Du soviel Stress haettest wie der Doktor, wuerdest Du auch "
	  "manchmal nicht mehr wissen wo bestimmte Dinge hingehoeren... ");

  AddDetail( ({ "dinge" }),
	  "Dinge wie die uebrig gebliebenen Hautfetzen. ");

  AddDetail( ({ "stress" }),
	  "So wichtige Menschen sind einfach so sehr beschaeftigt. Die "
	  "koennen sich nicht eine Minute ausrasten. ");

  AddDetail( ({ "minute" }),
	  "Der arme Doktor hat nicht mal eine Minute Zeit fuer sich. ");

  AddDetail( ({ "menschen", "mensch" }),
	  "Er ist einfach wichtig! Find Dich damit ab!");

  AddDetail( ({ "zeit" }),
	  "Du bemitleidest Doktor Koerperflicker. ");

  AddDetail( ({ "freude" }),
	  "Die Schaben scheinen voller Gluecksseligkeit zu sein. ");

  AddDetail( ({ "gluecksseligkeit" }),
	  "Tja, die haettest Du auch gerne. ");

  AddDetail( ({ "bettzeug" }),
	  "Schon aus der Ferne sieht das Bettzeug nicht gerade schmackhaft aus. "
	  "Die Laken und Kissen sind vollkommen durchgeschwitzt, und Du kannst "
	  "auch einige Flecken erkennen. ");

  AddDetail( ({ "laken", "kissen" }),
	  "Hoffentlich holst Du Dir hier keine ansteckende Krankheit! "
	  "Einfach ekelhaft! Alles verschwitzt und dreckig! ");

  AddDetail( ({ "krankheit" }),
	  "So eine taffe Schwester, wie Du es bist, haelt viel aus.");

  AddDetail( ({ "schwester" }),
	  "Du bist echt so toll!");

  AddDetail( ({ "ferne" }),
	  "Naeher betrachten willst Du das hier wirklich nicht!");

  AddDetail( ({ "flecken", "flecke", "fleck" }),
	  "Das Bettzeug hat teilweise auch Flecken in verschiedenen "
	  "Farben. ");

  AddDetail( ({ "farben" }),
	  "Du erkennst unterandrem ein huebsches Eitergelb (koennte natuerlich "
	  "auch Gallengelb sein...), ein schmackhaftes Kotzegruen, "
	  "ein leckeres Kackabraun, und ein schon etwas verblasstes "
	  "eingetrocknetes Rot. ");

  AddDetail( ({ "gelb" }),
	  "Welches Gelb meinst Du?");

  AddDetail( ({ "eitergelb" }),
	  "Du hast es hier mit einem besonders kraeftigem Eitergelb zu tun. "
	  "Du solltest Dir das gut einpraegen, so oft sieht man diese "
	  "herrliche Farbe nicht!");

  AddDetail( ({ "farbe" }),
	  "Welche?");

  AddDetail( ({ "gallengelb" }),
	  "Du musterst den Fleck, und stellst fest, dass es sich hier doch mit "
	  "ziemlicher Sicherheit um Eitergelb handelt. ");

  AddDetail( ({ "kotzegruen", "gruen" }),
	  "Sieht aeusserst schmackhaft aus!");

  AddDetail( ({ "rot" }),
	  "Sehr huebsch!");

  AddDetail( ({ "kackabraun", "braun" }),
	  "Wovon dieser Fleck wohl stammt? Oder besser gefragt: von wem?!");

  AddDetail( ({ "fleck" }),
	  "Hier sind soviele! ");

  AddDetail( ({ "brauner fleck" }),
	  "Du willst eigentlich gar nicht wissen, wovon der genau ist!");

  AddDetail( ({ "gelber fleck" }),
	  "Scheint, als haette eine Wunde geeitert. ");

  AddDetail( ({ "eiter" }),
	  "Los probier mal! Sonst weisst Du nicht ob es wirklich Eiter ist!");
  // CMD

  AddDetail( ({ "roter fleck" }),
	  "Das ist sicher eingetrocknetes Blut. Aber Dir macht das als "
	  "ausgebildete Krankenschwester ja nichts aus. ");

  AddDetail( ({ "gruener fleck" }),
	  "Du bist sehr froh, dass Du in keinem der Betten liegen musst!");

  AddDetail( ({ "sicherheit" }),
	  "Du bist Dir ziemlich sicher!");

  AddDetail( ({ "krankenschwester" }),
	  "Toller Beruf, nicht wahr?!");

  AddDetail( ({ "beruf" }),
	  "Du koenntest Dir absolut nichts Schoeneres vorstellen. ");

  AddDetail( ({ "schoeneres", "schoenes" }),
	  "...");

  AddDetail( ({ "kokosnussschale", "schale", "kokosnusschale" }),
	  "Hierbei handelt es sich um eine dieser hightech Schalen, mit "
	  "der man diverse gelbe Fluessigkeiten auffaengt. Irgendwer sollte "
	  "die Schale aber bald mal ausleeren, sonst laeuft sie ueber... ");

  AddDetail( ({ "fluessigkeiten", "fluessigkeit" }),
	  "Durch ein Bambusrohr laeuft immer wieder gelbe Fluessigkeit "
	  "in die Schale. ");

  AddDetail( ({ "urin" }),
	  "Du hast einmal wo gehoert, dass Urin eine heilende Wirkung hat, "
	  "wenn man ihn trinkt. "); //CMD TRINKEN

  AddDetail( ({ "fenster" }),
	  "Wofuer brauchst Du hier ein Fenster? Die Patienten sterben frueher "
	  "oder spaeter doch sowieso!");

  AddDetail( ({ "patienten" }),
	  "Momentan siehst Du nur einen hier!");

// detail holzgestell, schlauchiges etwas (von baldi bei long)

  AddDetail( ({ "betten" }),
	  "Insgesamt stehen hier vier Betten, von denen aber nur eines "
	  "belegt ist. In ihm liegt Baldi Amputant und harrt seinem "
	  "letzten Atemzug entgegen. ");

  AddDetail( ({ "atemzug", "zug" }),
	  "Viele sind es sowieso nicht mehr. ");

  AddDetail( ({ "bett" }),
	  "Einfach ekelerregend und dreckig! Baldi tut Dir wirklich leid! "
	  "Er liegt da voellig hilflos und gefesselt in seinem Bett! ");

  AddDetail( ({ "nachttopf" }),
	  "Den Nachttopf haettest Du beinahe uebersehen! Er steht unter "
	  "Baldis Bett, und ist mit einer seltsamen broeckeligen "
	  "Masse gefuellt. ");

  AddDetail( ({ "masse" }),
	  "Vielleicht kannst Du dort einmal hineingreifen?!"); //cmd schluessel!!

  // fesseln specialdetail

  AddDetail( ({ "decke" }),
	  "Die Decke sollte wirklich mal wieder gestrichen werden!");

  AddDetail( ({ "boden" }),
	  "Auf dem Boden stehen natuerlich die vier Betten, die Kokosnusschale, "
	  "und ein seltsames Holzgestell. Von Sauberkeit ist hier natuerlich "
	  "keine Spur!");

  AddDetail( ({ "sauberkeit" }),
	  "Suchst Du hier vergeblich!");

  AddDetail( ({ "spur" }),
	  "KEINE!");

  AddDetail( ({ "gestell", "holzgestell" }),
	  "Eine sehr eigenartige skurrile Konstruktion. An ihm haengt ein "
	  "Eimer, von dem aus ein Schlauch in Baldis linken Unterarm fuehrt. ");

  AddDetail( ({ "eimer" }),
	  "Na, was wird dort wohl drinnen sein?!");

  AddDetail( ({ "konstruktion" }),
	  "So etwas hast Du wirklich noch nie gesehen!");

  AddDetail( ({ "unterarm" }),
	  "Welcher?");

  AddDetail( ({ "linker unterarm" }),
	  "In Baldis linkem Unterarm steckt ein Schlauch - wozu auch immer!");

  AddDetail( ({ "schlauch" }),
	  "Jetzt erloes ihn doch endlich!");

  AddDetail( ({ "rechter unterarm" }),
	  "Da ist nix!");



  
  
  
	  
}


