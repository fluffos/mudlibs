
inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../dante.h"


int anz_rot;

void reset()
{
	::reset();
	anz_rot = 1;
}


void create()
{

  ::create();

  anz_rot = 1;
  SetProp(P_INT_SHORT, "Im Dschungel");
  SetProp(P_INT_LONG,
    "Im Norden kannst Du von hier aus deutlich eine Huette erkennen, die "
    "aus den verschiedensten Hoelzern und Bambusarten gebaut wurde. Die "
    "hohe Luftfeuchtigkeit macht Dir ziemlich zu schaffen. Rechts und links "
    "von Dir am Weg stehen immernoch riesige Baeume, an denen sich Lianen und "
    "alle moeglichen Kletterpflanzen hochranken. Durch das Dickicht der "
    "Buesche schimmern viele verschiedene Pflanzen, die anscheinend "
    "dahinter wachsen. ");
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);

  AddExit( "suedwesten", ROOM "weg5");
  AddExit( "norden", ROOM "veranda");
  AddExit( "nordwesten", ROOM "weg7");


//DETAILS

  AddDetail( ({ "norden" }),
    "Im Norden kannst Du deutlich eine Huette erkennen. ");

  AddDetail( ({ "huette" }),
    "Die Huette sieht sehr geraeumig aus - um sie naeher zu erforschen "
    "solltest Du aber nach Norden direkt gehen. ");

  AddDetail( ({ "hoelzer", "bambusarten" }),
    "Soweit Du es von hier erkennen kannst wurde beim Bauen der Huette "
    "scheinbar nicht gespart und nur edelste Hoelzer verbaut. ");

  AddDetail( ({ "luftfeuchtigkeit" }),
    "Vielleicht haettest Du lieber in Midas bleiben sollen, das Wetter "
    "hier im Dschungel ist wirklich grausam. Heiss, stickig, schwuel. ");

  AddDetail( ({ "midas" }),
    "Leider bist Du von Midas weit entfernt. ");

  AddDetail( ({ "wetter" }),
    "Das Wetter hier waere ja ansich gar nicht so schlecht, wuerde da "
    "nicht diese extrem hohe Luftfeuchtigkeit sein. ");

  AddDetail( ({ "dschungel" }),
    "Das Leben im Dschungel ist hart!");

  AddDetail( ({ "leben" }),
    "Warum bist Du auch hier her gekommen?");

  AddDetail( ({ "weg" }),
    "Rechts und links vom Weg stehen riesige Baeume. Sie werden von "
    "Lianen und anderen Kletterpflanzen bewachsen. ");

  AddDetail( ({ "baeume" }),
    "Die Baeume sind riesig hier. Sie verlieren sich hoch ueber Dir im "
    "Nirgendwo. ");

  AddDetail( ({ "nirgendwo" }),
    "Die Baeume sind so hoch, dass Du nicht mal erkennen kannst wo sie "
    "wirklich enden. ");

  AddDetail( ({ "lianen", "liane" }),
    "Beim Blick auf die Lianen werden in Dir Kindheitserinnerungen wach. ");

  AddDetail( ({ "blick" }),
    "Dein geschulter Blick uebersieht hier wirklich nichts!");

  AddDetail( ({ "kindheitserinnerungen", "erinnerungen" }),
    "Hach, diese Erinnerungen an Deine Kindheit. ");

  AddDetail( ({ "kindheit" }),
    "Ja damals, da hast auch Du mal Tarzan gespielt. ");

  AddDetail( ({ "tarzan" }),
    "Das waren noch Zeiten...");

  AddDetail( ({ "zeiten", "zeit" }),
    "Schon sehr lange her...");

  AddDetail( ({ "bauen" }),
    "Das Bauen hat vermutlich sehr lange gedauert. Die Huette wirkt irgendwie "
    "aus der Ferne etwas protzig!");

  AddDetail( ({ "boden" }),
    "Auf dem Boden kannst Du eine seltsame Spur ausmachen. ");

  AddDetail( ({ "spur" }),
    "Sieht fast so aus, als haette man jemanden auf den Boden schleifend "
    "nach Norden befoerdert. ");

  AddDetail( ({ "jemand" }),
    "Wer das wohl war?! ");

  AddDetail( ({ "kletterpflanzen", "kletterpflanze" }),
    "Die Baeume werden von den unterschiedlichsten Kletterpflanzen "
    "und Lianen umwachsen. ");

  AddDetail( ({ "buesche" }),
    "Die Buesche sind zwar relativ dicht aneinander, dahinter kannst Du "
    "aber dennoch einige roetlich schimmernde Pflanzen ausmachen. ");

  AddDetail( ({ "dickicht" }),
    "Durch das Dickicht der Buesche schimmern verschiedene Pflanzen. ");

  AddDetail( ({ "pflanzen" }),
    "Pflanzen wachsen hier eindeutig ueberall. Soviele verschiedene! "
    "Fuer einen Biologen sicher wahnsinnig interessant!");

  AddDetail( ({ "biologe" }),
    "Ein Biologe haette seine Freude an sovielen Pflanzen. ");

  AddDetail( ({ "freude" }),
    "Vermutlich wurde er sogar in Jubelschreie ausbrechen. ");

  AddDetail( ({ "jubelschreie", "schreie", "jubel" }),
    "Nichts vergleichbares zu hoeren - ergo kein Biologe anwesend. ");

  AddDetail( ({ "roetlich schimmernde pflanzen", 
		"roetlich schimmernde pflanze"  }),
    "Vielleicht kann man eine pfluecken?");
    

  AddDetail( ({ "ferne" }),
    "Ja, noch bist Du etwas weit entfernt um es genauer erkennen zu "
    "koennen. ");

  AddDetail( ({ "himmel" }),
    "Leider kannst Du ihn vor lauter Baumkronen kaum erkennen. ");

  AddDetail( ({ "baumkronen", "kronen" }),
    "Die Baumkronen sind so dicht, dass man den Himmel nur erahnen kann. ");


//Smells

  AddSmell(DEFAULT_SMELL,
    "Es riecht nach Pflanzen, Pflanzen und nochmals Pflanzen. Nichts "
    "Aussergewoehnliches fuer den Dschungel. ");

  AddSmell( "pflanzen",
    "Riecht interessant.");

  AddSmell( ({ "aussergewoehnliches", "aussergewoehnlich" }), 
    "Es riecht hier einfach nach Dschungel. ");

  AddSmell( ({ "dschungel" }),
    "Soviele unterschiedliche Pflanzen verstroemen ihr Aroma, welches "
    "zusammen diesen typischen Dschungelgeruch ergibt. ");

  AddSmell( ({ "dschungelgeruch", "geruch" }),
    "Mhmm. Angenehmer Geruch. ");

  AddSmell( ({ "aroma" }),
    "Etwas suesslich riechts von den Pflanzen. Einfach angenehm. ");

//Sounds

  AddSound(DEFAULT_SOUND,
    "Von oben aus den Baumkronen kommt Vogelgekreische. ");

  AddSound( ({ "baumkronen", "kronen", "baeume" }),
    "An den Baumkronen kannst Du nicht hoeren. ");

  AddSound( ({ "gekreische", "kreischen", "vogelgekreische", "voegel" }),
    "*Krooooooooooooar* *kroooooooooah*"); 


//CMDS

  AddCmd( ({ "pflueck", "pfluecke" }), "c_pfluecken");
  AddCmd( ({ "zieh", "ziehe" }), "c_ziehen");
  AddCmd( ({ "schwing", "schwinge" }), "c_schwingen" );

}

int c_pfluecken(string str)
{
	if(str != "roetlich schimmernde pflanze"   &&
	   str != "roetlich schimmernde pflanzen"   )
	{
		notify_fail("Was moechtest Du hier pfluecken?\n");
		return 0;
	}
	else
	{
		write(BS("Soweit kommst Du mit Deinem Arm leider nicht durchs "
			"Dickicht. Vielleicht kann man mit einer Art "
			"Haken die Pflanze herausziehen?"));
		say(CTPN + " versucht vergeblich seinen Arm durchs "
			"Dickicht zu stecken.\n");
		return 1;
	}
}

int c_ziehen(string str)
{
	object ob;
	if(str != "roetlich schimmernde pflanze mit haken heraus"   &&
	   str != "roetlich schimmernde pflanzen mit haken heraus"   )
	{
		notify_fail("Welche Pflanze genau moechtest Du mit einem "
				"Haken herausziehen?\n");
		return 0;
	}
	if(!present("\nhaken", TP))
	{
		write(BS("Aber Du hast gar keinen Haken dabei!"));
		return 1;
	}
        else
	{
		if(anz_rot < 1)
		{
	 	 write(BS("Du versuchst mit dem Haken eine roetlich "
			"schimmernde Pflanze herauszuziehen. Leider "
			"vergeblich. Es ist gerade keine in Reichweite. "));
		 return 1;
		}
		if(present ("\nlippen", TP))
		{
			write(BS("Du brauchst doch noch gar keine "
						 "neue Bluete. "));
		 	return 1;
		}
		if(present ("\nrot", TP))
		{
			write(BS("Du hast doch schon eine Bluete!"));
			return 1;
		}
		else
		{
		write(BS("Vorsichtig steckst Du den Haken durch das Dickicht "
			"und ziehst eine roetliche Bluete "
			"heraus. "));
		say(CTPN + " angelt sich etwas aus dem Dickicht.\n");
		ob = clone_object(OBJ "rot");
		if(ob->move(TP, M_GET) != 1)
		{
			tell_object(TP, "Das kannst Du nicht mehr tragen!\n");
			ob->move(TO, M_NOCHECK);
		}
		anz_rot--;
		return 1;
		}
	}
}





int c_schwingen(string str)
{
	if(str != "mit liane" )
	{
		notify_fail("Womit moechtest Du hier schwingen?\n");
		return 0;
	}
	else
	{
		write(BS("Als Du versuchst mit einer Liane zu schwingen "
			"taucht ganz ploetzlich Tarzan auf - klatscht Dir "
			"eine - und verschwindet wieder. "));
		TP->do_damage(14);
		return 1;
	}
}




