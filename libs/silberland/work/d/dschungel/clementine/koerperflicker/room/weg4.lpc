
inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../dante.h"


create()
{

::create();

  SetProp(P_INT_SHORT, "Im Dschungel");
  SetProp(P_INT_LONG,
    "An den dicken Staemmen der Urwaldriesen ranken sich Lianen und andere "
	"Kletterpflanzen empor. Der Boden des Pfades ist mit Schlingpflanzen "
	"ueberwuchert, die ein rasches Vorwaertskommen deutlich erschwaeren. "
	"Zwischen den Pflanzen am Wegrand kannst Du kleine rote Beeren "
	"ausfindig machen. Aus dem Nordwesten kommt ein unheimliches Knurren, "
	"dass nichts Gutes bedeuten kann. ");
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);

  AddExit( "suedosten", ROOM "weg2");
  AddExit( "nordwesten", ROOM "mani");

}

