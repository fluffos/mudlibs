
inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../dante.h"


create()
{

::create();

  SetProp(P_INT_SHORT, "Im Dschungel");
  SetProp(P_INT_LONG,
	"Gruen, gruen, gruen und nochmal Gruen. Wo Du auch hinblickst alles nur "
	"Gruen. Hier gibt es sogar einige Pflanzen die gruen bluehen. "
	"Haettest Du keinen so guten Orientierungssinn, wuerdest Du hier "
	"nicht einmal wissen wo vorne und hinten ist. Irgendwo "
	"aus naechster Naehe dringt ein seltsames Kraechzen durch das "
	"Gruen an Dein Ohr. Anscheinend ein verletztes und stark leidendes "
	"Tier, dass zwischen den Pflanzen Schutz vor Dir gesucht hat. ");
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);

  AddExit( "sueden", ROOM "weg9");
  AddExit( "nordosten", ROOM "weg11");


}

