
inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../dante.h"

int affeda;

void create()
{

  ::create();

  affeda=1;
  SetProp(P_INT_SHORT, "Im Dschungel");
  SetProp(P_INT_LONG,
    "Tapfer schlaegst Du Dich durch das dichte Buschwerk, das der Dschungel "
    "Dir hier bietet. Nordoestlicher Richtung scheinen sich die Baeume und "
    "das Blaetterwerk etwas zu lichten, und Du meinst ein Haus ausfindig "
    "machen zu koennen. Irgendwas scheint hier am Wegrand allerdings Deine "
    "Aufmerksamkeit zu erregen. Etwas Dunkles scheint zwischen einigen "
    "Bueschen und Gewaechsen hervorzulugen, vielleicht solltest Du dem besser "
    "nachgehen. "); 
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);

  AddExit( "sueden", ROOM "weg2");
  AddExit( "nordosten", ROOM "weg6");


//DETAILBEGINN

  AddDetail( ({ "dschungel" }), QueryProp(P_INT_LONG));

  AddDetail( ({ "buschwerk" }),
    "Alles ist hier sehr sehr dicht. In nordoestlicher Richtung wird es "
    "ein wenig heller. ");

  AddDetail( ({ "haus" }),
    "Koennte auch etwas anderes sein. Aber Du meinst ein Haus in "
    "nordoestlicher Richtung ausmachen zu koennen. ");

  AddDetail( ({ "dunkles" }),
    "Das Dunkle am Wegrand schaut fast ein bisschen aus wie Fell. Ob es von "
    "einem Affen stammt? Vielleicht kann man ihn herauslocken?!");

  AddDetail( ({ "richtung", "richtungen" }),
    "Eigentlich geht es hier nur in 2 Richtungen. Entweder nach Sueden oder "
    "nach Nordosten. ");

  AddDetail( ({ "sueden", "nordosten" }),
    "In welche Richtung Du gehen moechtest bleibt einzig und allein Dir "
    "ueberlassen. ");

  AddDetail( ({ "haus" }),
    "Wenn Dich Deine Sinne nicht taeuschen befindet sich in nordoestlicher "
    "Richtung ein Haus. ");

  AddDetail( ({ "sinne" }),
    "Hoffentlich taeuschen Dich Deine Sinne nicht!");

  AddDetail( ({ "irgendetwas", "irgendwas" }),
    "Irgendwas Dunkles lugt zwischen den Bueschen hervor. ");

  AddDetail( ({ "wegrand" }),
    "Zwischen den Bueschen und Gewaechsen erregt irgendetwas Deine "
    "Aufmerksamkeit. ");

  AddDetail( ({ "aufmerksamkeit" }),
    "Na hoffentlich ist es nichts Gefaehrliches!");

  AddDetail( ({ "gefaehrliches" }),
    "Etwas Angst hast Du schon. ");

  AddDetail( ({ "angst" }),
    "So schlimm wird es schon nicht sein. ");

  AddDetail( ({ "baeume" }),
    "Hier stehen ueberall Baeume. Nur nordoestlich werden sie etwas "
    "weniger. ");

  AddDetail( ({ "boden" }),
    "Am Boden hat sich ein kleiner festgetrampelter Pfad gebildet. "
    "Einige Graeser durchwachsen ihn, Du kannst aber auch einige Fussspuren "
    "auf ihm erkennen. ");

  AddDetail( ({ "fussspuren", "spuren" }),
    "Ganz deutlich menschliche Spuren, die Du erkennen kannst. ");

  AddDetail( ({ "menschliche spuren" }),
    "Die Spuren sind vermutlich von einem Menschen. ");

  AddDetail( ({ "mensch", "menschen" }),
    "Welcher Mensch es war kannst Du mit bestem Willen nicht erkennen. ");

  AddDetail( ({ "wille", "willen" }),
    "Vermutlich maennlich, 180cm gross. Hilft Dir das weiter?");

  AddDetail( ({ "graeser", "gras" }),
    "Sowohl am Wegrand als auch auf dem Pfad unter Dir wachsen einige "
    "Graeser. ");

  AddDetail( ({ "pfad", "trampelpfad" }),
    "Scheinbar gehen hier mehr Lebewesen lang, als Du bisher vermutet hast. ");

  AddDetail( ({ "lebewesen" }),
    "Wenn hier niemand langgehen wuerde, dann waere der Weg doch schon "
    "laengst zugewachsen. ");

  AddDetail( ({ "weg" }),
    "Du befindest Dich doch gerade auf ihm!");

  AddDetail( ({ "himmel" }),
    "Der Himmel ist sehr weit ueber Dir. So weit entfernt, dass Du ihn "
    "von hier unten garantiert nicht naeher untersuchen kannst. ");

  AddDetail( ({ "blaetterwerk", "blaetter" }),
    "Nach Nordosten lichtet sich das Blaetterwerk etwas, sonst ist es "
    "aber ueberall ganz dicht. ");

  AddDetail( ({ "buesche", "busch" }), 
    "Irgendetwas scheint zwischen den Bueschen zu sein. ");

  AddDetail( ({ "gewaechse", "gewaechs" }),
    "Hier gibt es bestimmt hunderte verschiedene Arten von Gewaechsen. " 
    "Sie scheinen nur eines gemeinsam zu haben: sie besiedeln jeden noch "
    "so kleinen Raum und fuellen alles aus. ");

  AddDetail( ({ "arten", "art" }),
    "Hier gibt es sicherlich ueber hundert verschiedene Arten. ");

  AddDetail( ({ "raum" }),
    "Jeder noch so kleine Raum im Dschungel wird von Pflanzen vereinnahmt. ");

  AddDetail( ({ "pflanzen" }),
    "Hier gibt es wahnsinnig viele verschiedene Pflanzen. ");

  AddDetail( ({ "affe", "fell" }),
    "Ob das das Fell von einem Affen ist?");

  AddDetail( ({ "dunkle" }),
    "Ob man den Affen herauslocken kann?");

//Smells

  AddSmell(DEFAULT_SMELL,
	"Es riecht eindeutig nach Pflanzen hier. ");

  AddSmell( ({ "pflanze", "pflanzen" }),
	"Es riecht nach gruenen Pflanzen!");

  AddSmell( ({ "gruene pflanzen", "gruene pflanze" }),
	"Ganz eindeutig riecht es nach gruenen Pflanzen!");

//SOUNDS

  AddSound(DEFAULT_SOUND,
    "Neben der typischen Dschungelgeraeusche gesellt sich immer wieder ein "
    "leises Knacken. ");

  AddSound( ({ "geraeusche", "dschungelgeraeusche" }),
    "Du hoerst das typische Insektenbrummen und verschiedene Voegel "
    "kreischen. ");

  AddSound( ({ "insektenbrummen", "brummen" }),
    "Summ.");

  AddSound( ({ "voegel", "kreischen" }),
    "Kreisch.");

  AddSound( ({ "knacken" }),
    "Das Knacken ist leise, wiederholt sich aber immer wieder mal. Scheinbar "
    "kommt es aus den Bueschen. ");

  AddSound( ({ "buesche" }),
    "Da! Schon wieder! *knack*");

//CMDs

  AddCmd( ({ "lock", "locke" }), "c_locken");

}

void reset() 
{
  ::reset();
  if(!present("\naffeoink",TO)) affeda=1; 

}


int c_locken(string str)
{
	object ob;
	if(str != "affe heraus" )
	{
		notify_fail("Wen moechtest Du herauslocken?\n");
		return 0;
	}
	if(affeda < 1)
	{
		write(BS("Leider ist hier momentan kein Affe den Du "
					"herauslocken koennest. Komm doch "
					"spaeter nochmal wieder. "));
		return 1;
	}
	else
	{
		write(BS("Du schaffst es tatsaechlich und lockst einen "
					"Affen aus den Bueschen. "));
		say(CTPN + " lockt einen Affen aus den Bueschen.\n");
		ob=clone_object(NPC "affe");
		ob->move(TO, M_GO);
		affeda--;
		return 1;
	}
}

