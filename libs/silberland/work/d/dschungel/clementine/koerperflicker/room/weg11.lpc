
inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../dante.h"


create()
{

::create();

  SetProp(P_INT_SHORT, "Im Dschungel");
  SetProp(P_INT_LONG, 
	  "Mitten auf dem schmalen Trampelpfad liegt ein riesiger Fleischklotz, "
	  "der noch etwas Behaarung aufweist. Bis vor wenigen Minuten hatte "
	  "er sicherlich auch noch vier Beine, von denen mittlerweile "
	  "allerdings jede Spur fehlt. Das Blaetterdach der Urwaldriesen "
	  "verdeckt hier fast den ganzen Himmel. Alles wirkt ziemlich "
	  "unheimlich - der ideale Ort also fuer ein grosses Raubtier um "
	  "seine Opfer zu zerfleischen und seinen Hunger zu stillen. ");
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);

  AddExit( "suedwesten", ROOM "weg10");
  AddExit( "osten", ROOM "weg12");

}

