
inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../dante.h"


void create()
{

  ::create();

  SetProp(P_INT_SHORT, "Im Dschungel");
  SetProp(P_INT_LONG,
    "Der Trampelpfad teilt sich hier in mehrere Richtungen. Entlang des "
    "Weges wachsen zwar immer noch hohe Baeume, dennoch hast Du das Gefuehl "
    "nicht mehr so eingeengt von ihnen zu werden. Oestlich scheint sich der "
    "Weg im Dickicht zu verlieren. Aus nordwestlicher Richtung vernimmst Du "
    "immer wieder ein seltsames Murren. Anscheinend scheint dort ein "
    "boesartiges Tier zu hausen, dessen Bekanntschaft Du lieber nicht machen "
    "moechtest. ");
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);

  AddExit( "sueden", ROOM "weg1");
  AddExit( "osten", ROOM "weg3");
  AddExit( "nordwesten", ROOM "weg4");
  AddExit( "norden", ROOM "weg5");


//DETAILBEGINN

  AddDetail( ({ "trampelpfad", "pfad" }),
    "Der Pfad teilt sich hier in mehrere Richtungen. ");

  AddDetail( ({ "richtungen", "richtung" }),
    "In welche Richtung Du gehen willst ist Dir ueberlassen. ");

  AddDetail( ({ "nordwesten" }),
    "Aus dem Nordwesten kommt immer wieder ein seltsames Murren. "
    "Scheinbar haust dort ein wildes Tier. ");

  AddDetail( ({ "osten" }),
    "In oestliche Richtung scheint das Dickicht immer dichter zu werden. ");

  AddDetail( ({ "norden" }),
    "Nach Norden wird der Pfad breiter. ");

  AddDetail( ({ "sueden" }),
    "Weiter suedlich kommst Du wieder in belebtere Gebiete. ");

  AddDetail( ({ "gebiete", "gebiet" }),
    "Nach Sueden geht es in belebtere Gebiete zurueck. ");

  AddDetail( ({ "buschpraxis", "koerperflicker", "axel", 
	"praxis", "axel koerperflicker" }),
    "Die Buschpraxis von Dr. Koerperflicker scheint wohl im Norden zu "
    "liegen. ");

  AddDetail( ({ "weg" }),
    "Du stehst auf ihm. ");

  AddDetail( ({ "murren" }),
    "Scheint aus dem Nordwesten zu kommen. ");

  AddDetail( ({ "bekanntschaft" }),
    "Eigentlich moechtest Du gar nicht wissen, welches Tier da im "
    "Nordwesten lebt, aber irgendwie bist Du doch sehr neugierig. ");

  AddDetail( ({ "neugier" }),
    "Unstillbare Neugier will, dass Du nach Nordwesten gehst. ");

  AddDetail( ({ "baeume", "baum" }),
    "Die Baeume hier sind immer noch hoch, dennoch hast Du nicht mehr das "
    "Gefuehl so eingeengt zu sein. ");

  AddDetail( ({ "gefuehl" }),
    "Du hast hier das Gefuehl nicht mehr so eingeengt zu sein. Vermutlich "
    "liegt das daran, dass die Baeume hier nicht ganz so hoch wachsen wie "
    "im uebrigen Teil des Dschungels. ");

  AddDetail( ({ "teil", "dschungel" }),
    "Der Dschungel ist an vielen Stellen relativ undurchdringbar. In diesem "
    "Teil hier geht es allerdings gerade noch. ");

  AddDetail( ({ "stellen" }),
    "Es gibt einige Stellen im Dschungel, da kann man sich den Weg nicht "
    "einmal mit einer Machete durchkaempfen. ");

  AddDetail( ({ "machete" }),
    "Manchmal kann man sich einen Weg mit einer Machete im Dschungel "
    "durchkaempfen. ");

  AddDetail( ({ "himmel" }),
    "Der Himmel ist ueber Dir. Scheint schoenes Wetter zu sein. ");

  AddDetail( ({ "wetter" }),
    "Das Wetter scheint gut sein. Hoffentlich bleibt das auch so. ");

  AddDetail( ({ "tier" }),
    "Vermutlich scheint es nordwestlich zu hausen. Naeheres findest Du aber "
    "erst heraus, wenn Du dorthin gehst. ");

  AddDetail( ({ "boden" }),
    "An dieser Stelle ist der Boden relativ erdig. Liegt wohl daran, dass "
    "Du hier auf einer Kreuzung stehst. ");

  AddDetail( ({ "kreuzung" }),
    "Von hier aus gehen mehrere Wege in unterschiedliche Richtungen weg. ");

  AddDetail( ({ "stelle" }),
    "Na hier, wo Du gerade stehst!");

  AddDetail( ({ "dickicht" }),
    "Im Osten scheint sich der Weg irgendwo im Dickicht zu verlieren. So "
    "dicht scheint dort die Vegetation zu sein. ");

  AddDetail( ({ "vegetation" }),
    "Im Osten scheinen die Pflanzen noch dichter zu wachsen als im "
    "restlichen Teil des Dschungels. ");

  AddDetail( ({ "pflanzen", "pflanze" }),
    "Ja Pflanzen gibt es im Dschungel natuerlich zahlreiche. Viele "
    "davon hast Du davor noch nie zu Gesicht bekommen. ");

  AddDetail( ({ "gesicht" }),
    "Einigen Pflanzen hast Du noch nie zuvor in Deinem Leben gesehen. ");

  AddDetail( ({ "leben" }),
    "Noch bist Du am Leben - gut gemacht!");

//Sounds

  AddSound(DEFAULT_SOUND,
    "Aus dem Nordwesten ist deutlich ein Murren zu vernehmen. Ansonsten "
    "erlauscht Du die typischen Dschungelgeraeusche. ");

  AddSound( ({ "geraeusche", "dschungelgeraeusche" }),
    "Du hoerst ein paar Insekten herumschwirren, einige Voegel pfeifen, ...");

  AddSound( ({ "insekten" }),
    "Suuuuuuuuuuuuuuuuuuuuuuuuuuummmmmmmmmmmmrrrrrrrrrrrrrmmmmm....");

  AddSound( ({ "voegel", "pfeifen" }),
    "Piiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiep.");

  AddSound( ({ "murren" }),
    "Klingt sehr gruselig und bedrohlich. ");

//Smells

  AddSmell(DEFAULT_SMELL,
    "Es duftet herrlich nach Pflanzen und Blumen. ");

  AddSmell( ({ "pflanzen", "blumen" }),
    "Wirklich herrlich!");



}

