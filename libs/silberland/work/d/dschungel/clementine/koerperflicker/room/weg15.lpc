
inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../dante.h"


create()
{

::create();

  SetProp(P_INT_SHORT, "Im Dschungel");
  SetProp(P_INT_LONG, 
	  "Baeume, Pflanzen, Insekten, und hie und da ein paar Steinchen - "
	  "wie ueberall im Dschungel das gleiche Bild. "
	  "Ein Eingeborener waere jetzt mal wirklich eine nette Abwechslung, "
	  "selbst wenn er Kannibale waere, und Du heute auf seinem Speiseplan "
	  "stehen wuerdest. Aber woher nehmen? Vielleicht findest Du hier ja "
	  "doch noch etwas Interessantes, was Deinen Aufenthalt "
	  "angenehmer gestaltet. ");
  // nich tmal kannibalen trauen sich zu axel bla
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);

  AddExit( "nordwesten", ROOM "weg14");
  AddExit( "sueden", ROOM "weg16");

}

