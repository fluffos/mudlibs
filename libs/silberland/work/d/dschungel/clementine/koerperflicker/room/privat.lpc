
inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../dante.h"

#define MAX_PERSONEN 3

string *spieler_bett;

create()
{

::create();

  SetProp(P_INT_SHORT, "Im Dschungel");
  SetProp(P_INT_LONG,
    "Gleich beim Hineinkommen faellt Dir ein Buschfahrrad auf, um das "
    "quer verstreut alle moegliche Ausruestung und Werkzeug herumkugelt. "
    "An der Ostwand steht ein grosses Bett, mit vielen Polster. Daneben "
    "befindet sich ein Nachtkaestchen, auf dem ein Buch liegt. An der Westwand "
    "steht ein Kasten, in dem Dr. Koerperflicker wohl seine Kleidung "
    "aufbewahrt. Durch das geoeffnete Fenster im Norden kommt ein frischer "
    "Wind herein, und viele verschiedene Gerueche kitzeln Dich in der Nase. ");
  SetProp(P_LIGHT, 1);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);

  AddExit( "sueden", ([ EX_DEST: ROOM "flur",
                        EX_TESTFUNC: "exit_test" ]) );


// DETAILBEGINN

  AddDetail( ({ "kaestchen" }),
    "Meinst Du das Nachtkaestchen? ");

  AddDetail( ({ "nachtkaestchen" }),
    "Neben dem Bett steht ein Nachtkaestchen auf dem ein Buch liegt. ");

  AddDetail( ({ "buch" }),
    "Ein duennes Buch liegt auf dem Nachtkaestchen, vielleicht gelingt "
    "es Dir ja seinen Titel zu lesen. ");

  AddDetail( ({ "titel" }),
    "Probier ihn doch zu lesen! ");

  AddReadDetail( ({ "titel" }),
   "\n" 
   "-- Der Kleine Prinz (entschluesselt) -- "
   "\n\n" );
  
  AddDetail( ({ "bett" }),
    "Also Bett kann man dieses monstroese Wasserteil kaum nennen. "
    "Ein riesiges wabbeliges Etwas mit fescher Satinbettwaesche im "
    "Leopardenlook. Darin traeumt der Doktor wohl von wilden "
    "unerfuellten Phantasien.");

  AddDetail( ({ "buschfahrrad", "fahrrad" }),
    "Boah, geil ey! Vor Dir tuermt sich ein riesiges hightech Buschfahrrad "
    "auf. Billig war das garantiert nicht! Und wie das aufgemotzt wurde! "
    "Phantastisch! Der Sitz aus feinstem Bueffelleder (riecht er deswegen "
    "so seltsam?!), der Lenker aus feinstem Silber (natuerlich mit "
    "Ziselierungen und Griffheizung), vergoldeter Motor, Carbon-Kotfluegel "
    "und nicht zu vergessen der huebsche Nerzschwanz der hinten baumelt. ");

  AddDetail( ({ "sitz" }),
    "Er besteht aus feinstem Bueffelleder! Hinten befindet sich natuerlich "
    "auch ein erhoehter Querpolster als kleine Rueckenlehne! Wow!");

  AddDetail( ({ "nerzschwanz", "schwanz" }),
    "Lasst uns noch mehr Tiere abschlachten! Jawoll!");

  AddDetail( ({ "nerz" }),
    "Von diesem hier gibt es mittlerweile nur mehr den Schwanz. ");

  AddDetail( ({ "tiere", "tier" }),
    "Tiere kannst Du draussen sicherlich besser untersuchen, wenn Du naeher "
    "an sie herankommst. ");

  AddDetail( ({ "querpolster", "lehne", "rueckenlehne" }),
    "Boah geil!!!");

  AddDetail( ({ "kotfluegel", "carbonkotfluegel", "carbon", "carbon-kotfluegel",
    "carbonfluegel" }),
    "Na sehr stylisch! Sowas willst Du auch unbedingt haben!");

  AddDetail( ({ "lenker" }),
    "Der Lenker besteht natuerlich aus feinstem Silber und hat "
    "selbstverstaendlich auch eine Griffheizung. Sehr nuetzlich! Vorallem "
    "bei diesen tropischen Temperaturen! ");

  AddDetail( ({ "ziselierung", "gravur" }),
    "Ja, irgendein Muster ist hier in den Lenker auch eingraviert worden. ");

  AddDetail( ({ "muster" }),
    "Irgendein komisches Muster wurde in das Silber des Lenkers eingraviert. "
    "Was es ist kann man nicht erkennen, aber hauptsache teuer wars ;)");

  AddDetail( ({ "bueffelleder", "leder" }),
    "Aussehen tut das Leder ja toll! Aber der Geruch?!!! Oder gehoert das so? "
    "Sicher bist Du Dir da nicht, aber hinterfragen willst Du das lieber auch "
    "nicht. ");

  AddDetail( ({ "silber" }),
    "Das Silber wurde sicherlich erst kuerzlich vom Doktor poliert, denn "
    "es glaenzt so sehr, dass es Dich sogar in den Augen blendet. ");

  AddDetail( ({ "augen" }),
    "Ja, Deine Augen die sind noch da... Aber Du koenntest ja so lustig sein, "
    "und Dir mal in beide Augen fahren?! Da wird man dann sicher "
    "auch ganz toll blind! Probiers halt mal ;) <fahre mir in augen>");

  AddDetail( ({ "doktor", "axel" }),
    "Der begrabbelt draussen sicherlich seine Gerda...");

  AddDetail( ({ "gerda" }),
    "Draussen!");

  AddDetail( ({ "satinbettwaesche", "bettwaesche", "satinwaesche" }),
    "Satinbettwaesche im Leopardenlook liegt im Wasserbett des "
    "Doktors. Sie riecht noch frisch gewaschen und sieht sogar ziemlich "
    "sauber aus (mal abgesehen von den paar weissen Flecken...)");

  AddDetail( ({ "flecken", "fleck", "weisse flecken" }),
    "Da hat wohl wer Milch verschuettet...");

  AddDetail( ({ "milch" }),
    "Na sicher war das Milch! Was glaubst Du denn?! Wir sind doch hier im "
    "Silberland und das muss zumindest bist 24Uhr jugendfrei sein!");

  AddDetail( ({ "silberland" }),
    "Da bist Du grad.");

  AddDetail( ({ "geruch", "gerueche" }),
    "Riech doch mal!");

  AddDetail( ({ "nase" }),
    "Die vielen Gerueche kitzeln Dich in Deiner Nase. ");

  AddDetail( ({ "leopardenlook", "look" }),
    "Fesch!!!  Aber hallo! Wirklich ganz toll! ");

  AddDetail( ({ "griffheizung", "heizung" }),
    "Im Dschungel braucht man natuerlich auch eine Griffheizung! Hier ist "
    "es sonst doch zu kalt!!!");   

  AddDetail( ({ "griff" }),
    "Meinst Du den Lenker oder die Griffheizung?"); 
   
  AddDetail( ({ "hineinkommen", "kommen" }),
    "Beim Hineinkommen faellt einem natuerlich sofort das Buschfahrrad "
    "auf! Ein absolut monstroeses Teil!");

  AddDetail( ({ "teil" }),
    "Absolut monstroes und natuerlich hightech!");

  AddDetail( ({ "etwas" }),
    "Das Bett entspricht einem riesigen wabbeligen Etwas. Ob man darin "
    "gut schlaeft?"); //schlafe in bett liege in bett bla  
  
  AddDetail( ({ "fenster" }),
    "Das Fenster im Norden ist geoeffnet sodass eine angenehme Brise durch "
    "das Zimmer weht. "); //fenster zumachen

  AddDetail( ({ "raum", "zimmer" }), QueryProp(P_INT_LONG));

  AddDetail( ({ "wind", "brise" }),
    "Die leichte Brise erfrischt bei der Hitze angenehm. ");

  AddDetail( ({ "hitze" }),
    "Es ist heiss hier! Ich mein, ... Du stehst im Dschungel, wahrscheinlich "
    "sogar in voller Panier. Glaubst Du Dir ist kalt?! Du schwitzt! "
    "Und Du solltest definitiv mal baden gehen!");

  AddDetail( ({ "panier" }),
    "Ist es nicht so?!");

  AddDetail( ({ "temperaturen", "temperatur" }),
    "Es ist heiss hier. ");

  AddDetail( ({ "dschungel" }),
    "Der umgibt Dich hier. ");

  AddDetail( ({ "boden", "marmorboden" }),
    "Auf dem schoenen Marmorboden liegt allerhand Ausruestung und das "
    "verschiedenste Werkzeug. ");

  AddDetail( ({ "werkzeug" }),
    "Angefangen von Schraubschluessel, Gabelschluessel, Kerzenschluessel, "
    "Hammer, Schraubenzieher bis ueber Kombizange und Wagenheber. Hier liegt "
    "wirklich alles herum. ");

  AddDetail( ({ "schraubschluessel", "gabelschluessel", "kerzenschluessel",
    "schluessel" }),
    "Hallo! Ich hier bin weiblich! Ich find manchmal nicht mal meine "
    "Wohnungsschluessel. Woher sollt ich also wissen, was das fuer Dinger "
    "sind?!");

  AddDetail( ({ "wohnungsschluessel" }),
    "Jau, manchmal, aber wirklich nur manchmal lass ich meine "
    "Wohnungsschluessel sogar in der Wohnungstuer stecken, und hau von "
    "draussen dann zu. Das ist zwar ziemlich bloed, aber mit so nem "
    "Dietrich da geht einiges! ;)");

  AddDetail( ({ "wohnungstuer", "wohnung", "dietrich" }),
    "Wenn Du mehr wissen willst, dann kannst Du mir ja ein Mail schicken ;) "
    "(clementine)");

  AddDetail( ({ "mail", "post" }),
    "In Tijara findest Du die naechste Post."); 

  AddDetail( ({ "tijara" }),
    "In Tijara warst Du doch erst kuerzlich. ");

  AddDetail( ({ "dinger" }),
    "Ja so Dinger halt!");

  AddDetail( ({ "ding" }),
    "So ein Ding!");

  AddDetail( ({ "kombizange", "zange", "hammer", "schraubenzieher", "zieher" }),
    "Auf dem Boden findest Du alles, was ein guter Mediziner aeh Mechaniker "
    "braucht. ");

  AddDetail( ({ "wagenheber" }),
    "Der ist natuerlich ausgesprochen wichtig bei so einem Buschfahrrad!");

  AddDetail( ({ "mediziner", "mechaniker" }),
    "Soviel Unterschied ist da auch nicht mehr...");

  AddDetail( ({ "unterschied" }),
    "Soviel Unterschied ist da nicht mehr! Beide hantieren an Sachen herum!");

  AddDetail( ({ "sachen" }),
    "Manche sind leblos und manche nicht ;)");

  AddDetail( ({ "ostwand" }),
    "Dort steht ein grosses Bett mit vielen Polster. ");

  AddDetail( ({ "nordwand" }),
    "An der Nordwand siehst Du ein Fenster. ");

  AddDetail( ({ "suedwand" }),
    "Da kommst Du wieder in den Flur. ");

  AddDetail( ({ "flur" }),
    "Im Sueden!");

  AddDetail( ({ "sueden" }),
    "Dort ist der Flur!");

  AddDetail( ({ "westwand" }),
    "Da steht ein Kasten. ");

  AddDetail( ({ "waende", "wand" }),
    "Welche meinst Du denn? Nordwand, Ostwand, Suedwand, Westwand?!");

  AddDetail( ({ "decke" }),
    "Von der Decke baumelt 3 Kokosnuesse in denen je eine Kerze zu finden "
    "ist... wie romantisch!");

  AddDetail( ({ "kerze", "kerzen" }),
    "Die Kerzen stecken in den Kokosnuessen. ");

  AddDetail( ({ "kokosnuss", "kokosnuesse" }),
    "Drei natuerliche leere Kokosnuesse baumel von der Decke. In ihnen "
    "steckt je eine Kerze. ");

  AddDetail( ({ "marmor" }),
    "Er fuehlt sich angenehm kuehl an unter Deinen Fuessen. ");

  AddDetail( ({ "fuesse", "fuss" }),
    "Sie stehen beide fest am Boden. ");

  AddDetail( ({ "motor" }),
    "Der Motor wurde vergoldet! Etwas anderes hattest Du nicht erwartet. ");

  AddDetail( ({ "kasten" }),
    "Ein grosser Kasten steht an der Westwand. Er ist zu, aber nicht "
    "verschlossen. Zumindest kannst Du keine Schloesser an seinen Tueren "
    "erkennen. Sicherlich ist dort auch nur Gewand drinnen. ");

  AddDetail( ({ "gewand", "kleidung" }),
    "Das wird wohl im Kasten aufbewahrt. ");

  AddDetail( ({ "ausruestung" }),
    "Das einzige, was _Du_ erkennst ist der Helm ;)");

  AddDetail( ({ "helm" }),
    "Sieht nicht besonders stabil aus, aber dafuer umso cooler. ");

  AddDetail( ({ "schloesser", "schloss" }),
    "Du kannst keine Schloesser an den Tueren erkennen. Nur je einen Knauf, "
    "womit man sie oeffnen und schliessen kann. ");

  AddDetail( ({ "knauf" }),
    "Jede der beiden Tueren hat einen Knauf. ");

  AddDetail( ({ "tueren", "tuer", "tuere" }),
    "Der Kasten hat je zwei Tueren mit je einem Knauf. Schloesser kannst Du "
    "keine erkennen. ");

  AddDetail( ({ "polster" }),
    "Grosse bequemaussehende Polster liegen im Wasserbett des Doktors. Da "
    "koennte man sich sicherlich toll reinkuscheln."); 

  AddDetail( ({ "wasserbett", "wasserteil" }),
    "Ein wirklich riesiges Wasserbett mit allem was dazugehoert - "
    "Satinbettwaesche, Polster - Kitsch wo Du nur hinsiehst. Wie man darin "
    "wohl liegt?");

  AddDetail( ({ "kitsch" }),
    "Ich sag nur Leopardenlook...");

  AddDetail( ({ "phantasie", "phantasien" }),
    "Im grossen Wasserbett traeumt der Doktor wohl von seinen unerfuellten "
    "(und krankhaften?!) Phantasien. "); //phantasien axel fragen?

  AddDetail( ({ "geraet" }),
    "Das kleine Geraet, das am Kasten steht entpuppt sich als Ventilator. ");

  AddDetail( ({ "ventilator" }),
    "Der Ventilator surrt vor sich hin und wirbelt die Luft im Raum herum. ");

  AddDetail( ({ "luft" }),
    "Die ist hier wirklich angenehm kuehl. ");

  AddDetail( ({ "oberseite" }),
    "Auf der Oberseite des Kastens steht ein kleiner Ventilator. ");


// SMELLS

  AddSmell(DEFAULT_SMELL, "Von draussen kommt eine frische Brise und bringt "
    "alle moeglichen 'Dschungelgerueche' mit sich. ");

  AddSmell( ({ "geruch" }),
    "Es riecht hier sehr angenehm frisch. Nicht so heiss wie sonst so im "
    "Dschungel. ");

  AddSmell( ({ "dschungel", "dschungelgerueche" }),
    "Der Dschungel riecht nach den unterschiedlichsten Pflanzen und Blumen, "
    "nach Regen und Dampf, nach wilden Tieren, Hitze und seltsamen Fruechten.");

  AddSmell( ({ "pflanzen", "blumen", "tiere", "regen", "dampf", "hitze", 
    "fruechte" }),
    "Hier herinnen kannst Du nur das Gemisch von den ganzen Sachen riechen. ");

  AddSmell( ({ "gemisch" }),
    "Sehr beeindruckend! Riechtig wohlduftend. ");


// SOUNDS

  AddSound(DEFAULT_SOUND, "Draussen hoerst Du Tiere schreien, von naechster "
    "Naehe kommt auch irgendwie ein Surren. ");

  AddSound( ({ "naehe" }),
    "Kann man doch nicht hoeren!");

  AddSound( ({ "tier", "tiere", "tiergeraeusche", "dschungelgeraeusche",
    "dschungel" }),
    "Die typischen Tier- und Dschungelgeraeusche eben.");

  AddSound( ({ "surren" }),
    "Das Surren kommt von der Oberseite des Kastens. Ein kleines Geraet "
    "scheint dort zu stehen. ");


// COMMANDS
  
  AddCmd( ({ "fahr", "fahre" }), "c_fahren");
  AddCmd( ({ "oeffne" }), "c_oeffnen");
  AddCmd( ({ "lege", "lieg", "leg", "liege" }), "c_liegen");
  AddCmd( ({ "steh", "stehe" }), "c_stehen");
  AddCmd( ({ "schliess", "schliesse" }), "c_schliessen");
  AddCmd( ({ "kuschl", "kuschel", "kuschle", "kuschele" }), "c_kuscheln");


  spieler_bett = ({ });

}

int exit_test(string dir)
{
 if(!TP)             return 1;  
 if(interactive(TP)) return 1;

 if(member(spieler_bett, getuuid(TP)) == -1) return 1;
 write(BS("Aber Du liegst doch noch im Bett!"));
 return 0;
}


int c_kuscheln(string str)
{
 if(str != "in polster"     &&
    str != "in polster rein" )
 {
  notify_fail("Wo moechtest Du Dich reinkuscheln?\n");
  return 0;
 }
 else
 {
  write(BS("Oh, sind die schoen weich. Da bekommt man richtig Lust auf eine "
           "Nacht mit dem Doktor..."));
  say(CTPN + " traeumt vom Doktor.\n");
  return 1;
 }
}

int c_schliessen(string str)
{
 if(str != "fenster" )
 {
  notify_fail("Was moechtest Du hier schliessen?\n");
  return 0;
 }
 else
 {
  write(BS("Du schliesst das Fenster, aber durch einen sanften Windstoss wird "
           "es sofort wieder geoeffnet. "));
  say(CTPN + " schliesst das Fenster, doch es geht wieder auf.\n");
  return 1;
 }
}

int c_fahren(string str)
{
 if(str != "mir in augen")
 {
  notify_fail("Was magst Du genau machen mit Deinen Augen?\n");
  return 0;
 }
 else
 {
  if(TP->QueryProp(P_BLIND))
  {
   tell_object(TP, "So blind wie Du bist finden Deine Fingerl ned mal Deine "
                   "Guckerl!\n");
   return -1;
  } 
  else
  {
   write(BS("AUAAAAAAAAAAAAAAAAAAAAAAAAAAAAA!"));
   TP->SetProp(P_BLIND, -1);
   say(CTPN+ " sticht sich selbst in die Augen!\n");
   return 1;
  }
 }
}

int c_oeffnen(string str)
{
 if( str != "kastentueren"  &&
     str != "kasten"        && 
     str != "tueren"        &&
     str != "tuer"          &&
     str != "tuere"          )
 {
  notify_fail("Was moechtest Du oeffnen?\n");
  return 0;
 }
 else
 {
  write(BS("Du greifst auf den Knauf und bist gerade dabei daran zu ziehen, "
        "als ein ziemlich lautes Alarmgeraeusch ploetzlich angeht: "
        "ALAAAAAAAAAARM! Irgendwer geht an Deine Designersachen Axel!!!"));
  say("ALAAAAAAAAARM! Irgendwer geht an Deine Designersachen Axel!!!\n");
  return 1;
 }
}

int c_liegen( string str)
{
  notify_fail("Worin moechtest Du liegen?\n");

  if(!str || str == "") return 0;
  if(!(str == "in bett" ||
       str == "in wasserbett")) return 0;

  if(member(spieler_bett, getuuid(TP)) != -1)
  {
   tell_object(TP, BS("Aber Du liegst doch schon im Bett!"));
   return -1;
  }
 
  if(sizeof(spieler_bett) >= MAX_PERSONEN)
  {
   write(BS("Leider passt Du da nicht mehr rein."));
   return -1;
  }

  spieler_bett += ({ getuuid(TP) });
  write(BS("Du legst Dich ins Bett, es wackelt etwas, aber fuehlt sich "
           "sonst irgendwie toll an! Da koenntest Du ewig drinnen liegen "
           "bleiben."));
  say(CTPN+ " legt sich in das Wasserbett.\n");
  return 1;
}

int c_stehen(string str)
{
 notify_fail("Moechtest Du aufstehen?\n");

 if(!str || str == "") return 0;
 if(!(str == "auf" )) return 0;

 if(member(spieler_bett, getuuid(TP)) == -1)
 {
  write(BS("Aber Du liegst doch gar nicht!\n"));
  return -1;
 }

 spieler_bett -= ({ getuuid(TP) });
 write(BS("Du stehst wieder auf.\n"));
 say(CTPN+ " steht wieder auf.\n");
 return 1;
}

void BecomesNetDead(object player)
{
 if(member(spieler_bett, getuuid(player)) != -1)
 {
  spieler_bett -= ({ getuuid(player) });
  tell_room(TO, player->Name()+" nickt ein und purzelt aus dem Bett.\n");
 }
}

void NotifyPlayerDeath(object player, object killer, int lost_xp)
{
 spieler_bett -= ({ getuuid(player) });
}

