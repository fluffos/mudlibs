inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../dante.h"

void create()

{

  ::create();
  SetProp(P_INT_SHORT, "Im kristallklaren Wasser");
  SetProp(P_INT_LONG,
     "Du schwimmst in dem kleinen See beim Wasserfall. Das Wasser ist sehr "
     "klar, sodass Du sogar einige Fische unter Dir ausmachen kannst. "
     "Wirklich herrlich entspannend ist es hier! Rund um den See die dichte "
     "Vegetation des Dschungels, exotische Blumen, seltene Pflanzen. "
     "Die Voegel zwitschern und Du fuehlst Dich rundum wohl! " );
  
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);

  SetProp(P_ENVIRONMENT,
    ([ENV_TEMPERATURE: 15, ENV_TERRAIN:TT_WATER]) );

//DETAILS

  AddDetail( ({ "wasser" }), 
    "Das Wasser des Sees ist kristallklar! Herrlich! Endlich wirst Du einmal "
    "so richtig sauber!");

  AddDetail( ({ "see" }),
    "Der See ist ueberall um Dich herum, schliesslich schwimmst Du ja gerade "
    "in ihm.");

  AddDetail( ({ "blumen" }),
    "Die Blumen sehen sehr exotisch aus. Allerdings ist hier wohl nicht "
    "der richtige Ort sie naeher zu erkunden.");

  AddDetail( "ort", QueryProp(P_INT_LONG));

  AddDetail( ({ "pflanzen", "pflanze" }),
    "Die Pflanzen des Dschungels scheinen hier wohl besonders gut zu "
    "gedeihen! Kein Wunder, schliesslich haben sie hier auch genug Wasser.");

  AddDetail( ({ "wunder" }),
    "Dich wundert hier ueberhaupt nichts mehr.");

  AddDetail( ({ "dschungel" }),
    "Der Dschungel umgibt den kleinen See mit seiner einmaligen "
    "Artenvielfalt. ");

  AddDetail( ({ "artenvielfalt", "vielfalt" }),
    "Am besten schaust Du Dir alles an, wenn Du nicht mehr im "
    "Wasser pritschelst.");

  AddDetail( ({ "boden" }),
    "Du hast keinen Boden unter den Beinchen - nur Wasser!");

  AddDetail( ({ "beinchen" }),
    "Mit Beinchen sind Deine Haxen gemeint. ");

  AddDetail( ({ "haxen" }),
    "Na Deine Fuesse!");

  AddDetail( ({ "fuesse" }),
    "King Julien bruellt: Nicht die Fusse, nicht die Fusse anfasse!");

  AddDetail( ({ "fusse", "king", "king julien", "julien" }),
    "*gg*");


  AddDetail( ({ "himmel" }),
    "Der Himmel erstrahlt in einem wunderbaren Blauton.");

  AddDetail( ({ "blauton", "ton", "blau" }),
    "Sehr schoen blau.");

  AddDetail( ({ "fische", "fischschwarm", "schwarm", "fisch" }), 
    "Einige Fische schwimmen immer wieder unter Dir vorbei.");

  AddDetail( ({ "wasserfall" }),
    "Der Wasserfall bettet sich wunderbar in die restliche Landschaft ein. "
    "Dort wo er sich mit dem Wasser verbindet entstehen leichte Wellen.");

  AddDetail( ({ "wellen", "welle" }),
    "Sanfte Wellen enstehen genau dort, wo der Wasserfall in den See faellt.");

  AddDetail( ({ "landschaft" }),
    "Ein wunderbarer Ort zum verweilen.");

  AddDetail( ({ "vegetation" }),
    "Um den See herum kannst Du die dichte Vegetation des Dschungels "
    "ausmachen.");
  
  AddDetail( ({ "voegel", "vogel" }),
    "Sehen kannst Du keine, aber hoeren!");


//SOUNDS

  AddSound(DEFAULT_SOUND, 
    "Vogelgesang dringt an Dein Ohr, und Du fuehlst Dich rundherum wohl. ");

  AddSound( ({ "gesang", "vogelgesang" }),
    "Wundervoll!");

  AddSound( ({ "ohr" }),
    "*KRAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAEH*");

  AddSound( ({ "voegel", "vogel" }),
    "Die Voegel zwitschern munter vor sich her.");

  AddSound( ({ "zwitschern" }),
    "*piep* *piep* *gurr* *gurr* *troe* *troe *grr* grr*");
    
//SMELLS

  AddSmell(DEFAULT_SMELL, "Es riecht wunderbar nach Blumen und nach frischem "
		  "Wasser.");

  AddSmell( ({ "wasser" }),
    "Es riecht nach frischem Wasser. Wundert Dich das? Du schwimmst mitten "
    "in nem See!");

  AddSmell( ({ "see" }),
    "Der See riecht nach Wasser :)");

  AddSmell( ({ "blume", "blumen" }),
    "Sie riechen einfach herrlich!");


//COMMANDS

  AddCmd( ({ "schwimm", "schwimme" }), "c_schwimmen");
  AddCmd( ({ "tauch", "tauche" }), "c_tauchen");
  AddCmd( ({ "pritschel", "pritschl", "pritschle" }), "pritschelfunc");

}

int c_schwimmen(string str)
{
	if(str != "zum ufer"    &&
	   str != "ans ufer"     )
	{
		notify_fail("Wohin moechtest Du schwimmen? Ans Ufer?\n");
		return 0;
	}
	else
	{
		write(BS("Du schwimmst wieder zum Ufer des Sees."));
		TP->move(ROOM "wir", M_GO, "ans Ufer", "schwimmt", 
				"schwimmt herein");
		return 1;
	}
}

int c_tauchen(string str)
{
	if(str != "unter"   &&
	   str != "zum grund"  )
	{
		notify_fail("Wohin moechtest Du tauchen? Unter?\n");
		return 0;
	}
	else
	{
		write(BS("Du tauchst unter. "));
		TP->move(ROOM "see", M_GO, "unter", "taucht", "kommt " 
				"hereingetaucht" );
		return 1;
	}
}

string pritschelfunc(string str)
{ 
 write(BS("Platsch! Platsch! Du pritschelst im Wasser!\n"));
 return "";
}

