
inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../dante.h"


create()
{

::create();

  SetProp(P_INT_SHORT, "Im Dschungel");
  SetProp(P_INT_LONG, 
	  "Rechts und links von Dir nichts als meterhohe Baeume, deren "
	  "Kronen mit ihrem dichten Blaetterwerk fast den ganzen Himmel "
	  "verdecken. Nur sehr spaerlich finden einige Sonnenstrahlen "
	  "den Weg zu Dir. Seltsame Pflanzen ranken sich an den gewaltigen S"
	  "taemmen entlang des Pfades hoch, um noch etwas von dem Licht zu "
	  "erhaschen. Auf dem Boden hat sich eine kleine Pfuetze "
	  "aus den Resten morgentlicher Tautropfen gebildet, die langsam "
	  "in der Erde versickert. ");
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);

  AddExit( "osten", ROOM "weg7");
  AddExit( "nordwesten", ROOM "weg9");

}

