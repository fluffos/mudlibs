// Fertig - Hoehle des Nix - Schatz zum Wuehlen - Leuchtmithril


inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../dante.h"


int anz_schatz;

void reset()
{
 
 ::reset();
 anz_schatz = 1; 

}

void create()

{

  ::create();
  anz_schatz = 1;
  SetProp(P_INT_SHORT, "In der Hoehle des Nix'");
  SetProp(P_INT_LONG,
    "Du findest Dich in einer natuerlichen Hoehle wieder. "
    "An den Waenden fallen Dir sofort unzaehlige Fackeln auf, in der Mitte "
    "steht ein runder Tisch aus Stein, daneben 2 Stuehle. Im hintersten Eck "
    "befindet sich sogar ein Bett, dass mit Fellen ausgelegt ist. "
    "Durch ein Loch beim Eingang dieser Felsbehausung kannst Du wieder "
    "in den See zurueck tauchen. "); 

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);

  SetProp(P_ENVIRONMENT,
    ([ENV_TEMPERATURE: 15, ENV_TERRAIN:TT_CAVE]) );
  

//DETAILBEGINN

  AddDetail( ({ "boden" }),
    "Der Boden ist wie der Rest der Hoehle auch aus Fels. ");

  AddDetail( ({ "fels" }),
    "Der Fels wirkt kalt und nass, aber trotzdem wirkt die Hoehle irgendwie "
    "gemuetlich. ");
  
  AddDetail( ({ "hoehle" }), QueryProp(P_INT_LONG));

  AddDetail( ({ "steine", "stein" }),
    "Fast alles hier ist aus Fels. ");

  AddDetail( ({ "bett" }),
    "Im Bett wurden einige Felle ausgelegt - sieht gemuetlich aus!");

  AddDetail( ({ "fell", "felle" }),
    "Du vermutest es sind Felle des Jura-Schafes. ");

  AddDetail( ({ "jura-schaf", "schaf", "juraschaf" }),
    "Da Du kein wirklicher Experte auf dem Gebiet der Schafzucht bist, "
    "vermutest Du nur, dass die Felle vom Jura-Schaf sind. Zumindest sind "
    "es fast schwarze Felle mit einem leichten Braunton.");

  AddDetail( ({ "braun", "braunton", "ton" }),
    "Der Braunton beim Jura-Schaf entsteht, wenn diese im Sommer der Sonne "
    "ausgesetzt sind. ");

  AddDetail( ({ "sonne" }),
    "So wie wir Menschen werden auch die Schafe im Sommer braun :)");

  AddSpecialDetail( ({ "menschen", "mensch" }), "menschfunc");

  AddDetail( ({ "dunkelelf", "blaesse", "blass", "dunkelelfen" }),
    "Dunkelelfen bevorzugen die noble Blaesse.");

  AddDetail( ({ "hobbit" }),
    "Als Hobbit tut man sich schwer mit dem Braeunen im Sommer.");

  AddDetail( ({ "sommer" }),
    "Ja auch im Silberland scheint die Sonne im Sommer.");

  AddDetail( ({ "silberland" }),
    "Da befindest Du Dich gerade.");

  AddDetail( ({ "braeunen" }),
    ":)");

  AddDetail( ({ "dreck" }),
    "Igitt!");

  AddDetail( ({ "eingang" }),
    "Eigentlich ist das Loch der Eingang und zeitgleich auch der Ausgang.");

  AddDetail( ({ "loch" }),
    "Durch das Loch kannst Du wieder in den See zurueck. ");

  AddDetail( ({ "ausgang" }),
    "Der Ausgang ist rund und nennt sich Loch.");

  AddDetail( ({ "see" }),
    "Der See scheint ueber der Hoehle zu liegen. Seltsam. Durch das Loch "
    "kommst Du wieder in ihn zurueck. ");

  AddDetail( ({ "felsbehausung", "hausung", "behausung" }),
    "Die Hoehle dient wohl irgendjemandem als Haus. ");

  AddDetail( ({ "haus" }),
    "Nett eingerichtet ist es ja, aber irgendwie nicht Dein Stil. ");

  AddDetail( ({ "stil" }),
    "Wie Du ja bereits aus Facebook weisst, ist Stil nicht das Ende des "
    "Besens. ");

  AddDetail( ({ "facebook" }), 
    "Achja. Heute schon alles auf Deiner Farm geerntet, Deine Menues serviert, "
    "Deine Hoteleinnahmen abgeholt, ...?");

  AddDetail( ({ "farm", "menue", "menues", "hoteleinnahmen", "einnahmen" }),
    "Du gehoerst doch nicht etwa zu der Spezies Facebookverweigerer?");

  AddDetail( ({ "spezies", "spezie" }),
    "Es tummeln sich hier die unterschiedlichsten...");

  AddDetail( ({ "facebookverweigerer" }),
    "Soll es auch geben. ");

  AddDetail( ({ "ende" }),
    "Nicht das Ende des Besens meinst Du? ");

  AddDetail( ({ "besen" }),
    "Hier findest Du keinen Besen. Zum Saeubern der Hoehle nimmt der "
    "Besitzer wohl nur Wasser. ");

  AddDetail( ({ "besitzer" }),
    "Wem diese Hoehle wohl gehoert? ");

  AddDetail( ({ "nix" }),
    "Nicht da!");

  AddDetail( ({ "saeubern", "sauber" }),
    "Vermutlich kann man die Hoehle komplett fluten, damit man sie sauber "
    "bekommt. ");

  AddDetail( ({ "fluten", "flut" }),
    "Irgendwo gibt es sicherlich eine spezielle Vorrichtung dafuer. ");

  AddDetail( ({ "vorrichtung" }),
    "Da Du nicht der Besitzer der Hoehle bist, interessiert Dich diese "
    "scheinbar ganz geheime Vorrichtung nicht weiter. ");

  AddDetail( ({ "experte", "schafzucht", "gebiet" }), 
    "Du solltest wirklich einen Experten fragen - vielleicht den Schaefer? ");

  AddDetail( ({ "schaefer" }),
    "Der soll wo auf einer Hochebene wohnen. ");

  AddDetail( ({ "hochebene" }),
    "Sieh Dich dort mal naeher um. Dort findest Du den Schaefer bestimmt. ");

  AddDetail( ({ "wasser" }),
    "Wasser ist hier ja scheinbar ueberall herum um die Hoehle. ");

  AddDetail( ({ "ecke", "eck" }),
    "In einer Ecke befindet sich sogar ein Bett. ");

  AddDetail( ({ "rest" }),
    "Fast alles hier besteht aus Fels. ");

  AddDetail( ({ "fackeln", "fackel" }),
    "Die Fackeln an den Waenden spenden der Hoehle Licht. ");

  AddDetail( ({ "licht" }),
    "Wer kein Licht moechte, der kann hier auch die Fackeln ausmachen. Oder "
    "auch wieder anzuenden. ");

  AddDetail( ({ "jura" }),
    "Jura unter anderem ein Kanton in der Schweiz, daher der Name des "
    "Schafes. ");

  AddDetail( ({ "kanton", "schweiz", "name" }),
    "Alles weit weg :)");

  AddDetail( ({ "decke" }),
    "Die Decke ist aus Fels.");

  AddDetail( ({ "stuehle", "stuhl" }),
    "Die zwei Stuehle am Tisch sind aus Holz. Eigentlich sind sie fuer so "
    "eine Behausung sehr kunstvoll gearbeitet und mit vielen Schnitzereien "
    "verziert. ");

  AddDetail( ({ "holz" }),
    "Das Holz stammt vermutlich irgendwo aus den Tropen. ");

  AddDetail( ({ "tropenholz", "tropen" }),
    "Kein Wunder! Du befindest Dich ja auch im Dschungel. ");

  AddDetail( ({ "wunder" }),
    "Dich wundert einfach gar nichts mehr. ");

  AddDetail( ({ "dschungel" }),
    "Du befindest Dich doch im Dschungel?!");

  AddDetail( ({ "schnitzereien", "schnitzerei" }),
    "Kunstvolle Schnitzereien, fast so, als haette jemand hier ganze Texte "
    "eingraviert. ");

  AddDetail( ({ "texte", "text" }),
    "Vielleicht kann man die Texte lesen?");

  AddReadDetail( ({ "texte", "text" }),
    "\n"
    "Ach wie gut, dass niemand weiss, dass mein Schatz Clementine heisst.\n"
    "\n");

  AddDetail( ({ "clementine" }),
    "Hmm, Clementine siehst Du hier nirgends.");

  AddDetail( ({ "schatz" }),
    "Meinst Du es ist so leicht den Schatz des Nix zu finden? "
    "Vielleicht solltest Du einmal danach suchen. ");

  AddDetail( ({ "waende", "wand" }),
    "Die Waende sind kalt und nass. An ihnen befinden sich einige Fackeln. ");

  AddDetail( ({ "mitte" }),
    "In der Mitte steht ein steinerner Tisch. ");

  AddDetail( ({ "tisch" }),
    "Scheinbar wurde der Tisch direkt aus Stein herausgehauen. Was fuer eine "
    "wunderbare Arbeit. ");

  AddDetail( ({ "arbeit" }),
    "Der Tisch sieht toll aus!");

  AddDetail( ({ "ecken" }),
    "Die Hoehle hat ganz viele Ecken. Richtig verwinkelt. Manche "
    "liegen so sehr im Dunkeln, dass man gar nichts sieht. ");

  AddDetail( ({ "dunkle", "dunkles", "dunkeln" }),
    "Ganz finster ist es in manchen Ecken. ");


//Smells

  AddSmell(DEFAULT_SMELL,
    "Es riecht kuehl und feucht. Das ist bei der Lage der Hoehle ja auch "
    "nicht weiter verwunderlich. ");

  AddSmell( ({ "lage" }),
    "Du erriechst: Die Lage der Hoehle befindet sich unter einem See. ");

  AddSmell( ({ "hoehle" }),
    "Kalt und feucht. ");

  AddSmell( ({ "see" }),
    "Vermutlich riecht der See nach Wasser, genaueres kannst Du aber erst "
    "sagen, wenn Du direkt im See bist. ");

  AddSmell( ({ "wasser" }),
    "Auch das Wasser riecht feucht und vorallem nass ;)");

//Sounds

  AddSound(DEFAULT_SOUND,
    "Hier ist es fast mucksmaeuschenstill. Nur manchmal hoerst Du ein leises "
    "Plaetschern. ");

  AddSound( ({ "plaetschern" }),
    "Es scheint vom See zu kommen. ");

  AddSound( ({ "see" }),
    "Irgendwie ist es sehr sehr angenehm. Genauer kannst Du es nicht "
    "benennen. ");

//COMMANDS

  AddCmd( ({ "setz", "setze", "sitz" }), "c_sitzen");
  AddCmd( ({ "such", "suche" }), "c_suchen");
  AddCmd( ({ "zuend", "zuende" }), "c_zuenden");
  AddCmd( ({ "mach", "mache" }), "c_machen");
  AddCmd( ({ "tauch", "tauche" }), "c_tauchen");
  AddCmd( ({ "wuehl", "wuehle" }), "c_wuehlen");   
  AddCmd( ({ "leg", "lege", "liege", "lieg" }), "c_legen");


}



string menschfunc(string str)
{
 switch (TP->QueryProp(P_RACE))
 {
	case "Mensch":
		write(BS("Jaja, im Sommer sind wir fesch :)"));
	 	break;
	case "Dunkelelf":
		write(BS("Du als Dunkelelf bevorzugst selbstverstaendlich "
			"die noble Blaesse."));
		break;
	case "Hobbit":
	      	write(BS("Du als Hobbit tust Dir sehr schwer mit dem "
				"braun werden :)"));
		break;
	case "Zwerg":
		write(BS("Du als Stinkezwerg bist eh immer braun von dem "
				"ganzen Dreck auf Deinem Koerper."));
		break;

	default :
		write(BS("Natuerlich bist Du kein Mensch. Den Sommer "
				"magst Du aber trotzdem!"));
	break;
 }
 return"";
}

int c_suchen(string str)
{
	if(str != "nach schatz"   &&
	   str != "nach schatz des nix" &&
	   str != "nach schatz von nix"  )
	{
		notify_fail("Wonach moechtest Du suchen?\n");
		return 0;
	}
	else
	{
		write(BS("Du suchst die ganze Behausung nach einem Schatz ab. "
			"Und wirklich - in einer dunklen Ecke findest Du "
			"ihn. Du solltest schnell in ihm wuehlen!"));
		return 1;
	}
}



int c_sitzen(string str)
{
	if(str != "auf stuhl"  &&
	   str != "auf sessel" )
	{
		notify_fail("Worauf moechtest Du Dich setzen?\n");
		return 0;
	}
	else
	{
		write(BS("Man setzt sich nicht auf fremde Stuehle!"));
		return 0;
	}
}


int c_machen(string str)
{
	if(str != "licht aus"   &&
	   str != "fackel aus"  &&
	   str != "fackeln aus"  )
	{
		notify_fail("Was moechtest Du machen?!\n");
		return 0;
	}
	if (QueryProp(P_LIGHT) <= 0)
 	{
  	write( "Aber die Fackeln sind doch schon aus.\n");
  	return 1;
 	}
	
	write(BS("Du loescht die Fackeln. Es wird dunkel. "));
	say(CTPN + " loescht die Fackeln.\n");
	SetProp(P_LIGHT, 0);
	return 1;
}
	
int c_zuenden(string str)
{
	if(str != "fackeln an"   &&
	   str != "fackel an"    )
	{
		notify_fail("Was moechtest Du anzuenden?\n");
		return 0;
	}
	if (QueryProp(P_LIGHT) > 0)
	{
  	write( "Aber die Fackeln sind doch an!\n" );
  	return 1;
 	}
  	write(BS("Nur mit Deinen blossen Gedanken schaffst Du es, die "
				"Fackeln anzuzuenden. "));
        say(CTPN+ " zuendet die Fackeln an.\n"
		"Es wird hell.\n");
        SetProp(P_LIGHT, 1);
        return 1;
	
}

int c_legen(string str)
{
	if(str != "in bett"   &&
	   str != "auf bett"  &&
	   str != "auf felle" &&
	   str != "auf fell"  )
	{
		notify_fail("Worein moechtest Du Dich legen?\n");
		return 0;
	}
	else
	{
		write(BS("Aber das ist doch gar nicht Deines!"));
		say(CTPN+ " will sich in das fremde Bett legen.\n");
		return 1;
	}
}


int c_tauchen(string str)
{
        if(str != "in see"    &&
           str != "in wasser"  &&
           str != "zurueck"   &&
           str != "ins wasser" &&
	   str != "in see zurueck"  )
        {

                notify_fail("Wohin moechtest Du tauchen? Zurueck?\n");
                return 0;
        }
	else
        {
                write(BS("Du springst ins Wasser und tauchst zurueck. "));
                TP->move(ROOM "see", M_GO, "in den See", "springt", "kommt "
                                "hochgetaucht" );
                return 1;
        }
}




int c_wuehlen(string str)
{
	object ob;
        if(str != "schatz"   &&
           str != "in schatz" )
        {
          notify_fail("Worin moechtest Du wuehlen?\n");
          return 0;
        }
        else
        {
	if(anz_schatz < 1)
	{
		write(BS("Du durchwuehlst den Schatz - findest aber leider "
					"nichts. "));
		return 1;
	}
	else
	{
       		write(BS("Du durchwuehlst den Schatz und findest einen kleinen "
		"glitzernden Gegenstand den Du schnell einsteckst. "));
         say(CTPN + " steckt heimlich etwas ein.\n");
	 ob = clone_object(OBJ "schatz");
   	 if(ob->move(TP, M_GET) != 1)
   		{
    		tell_object(TP, "Das kannst Du nicht mehr tragen!\n");
    		ob->move(TO, M_NOCHECK);
   		}
   	 anz_schatz--;
 	 return 1;
        }
	}
}


