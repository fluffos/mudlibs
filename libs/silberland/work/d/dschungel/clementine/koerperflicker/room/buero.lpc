
inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../dante.h"


create()
{

::create();

  SetProp(P_INT_SHORT, "In einem Buero");
  SetProp(P_INT_LONG, 
    "An der Westwand steht ein grosser Schreibtisch, auf dem ein "
    "regelrechtes Chaos herrscht. Gleich daneben befindet sich ein "
    "Abfalleimer. Die Suedwand wird von einem vollgestopften Buecherregal "
    "geschmueckt. Einige Fotos haengen an den restlichen Waenden, und "
    "zeigen die groessten Erfolge des Doktors. Im Norden kannst Du "
    "durch ein Fenster ins Freie blicken. ");
  SetProp(P_LIGHT, 1);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);

  AddExit( "osten", ROOM "flur");


// DETAILBEGINN

  AddDetail( ({ "buecherregal", "regal" }),
    "An der Suedwand steht ein Buecherregal, das mit den verschiedensten "
    "Buechern vollgestopft ist. Vielleicht solltest Du einmal einen "
    "Blick auf die Titel werfen. ");

  AddDetail( ({ "titel", "titeln" }),
    "Mit unt titel <zahl> kannst Du Dir die Titel naeher anschauen. ");

  AddDetail( ({ "titel 1" }),
    "* Lieben lernen * ");
  
  AddDetail( ({ "titel 2" }),
    "* Weibliche Anatomie - wo gehts lang?! * ");

  AddDetail( ({ "titel 3" }),
    "* Mein Buschfahrrad und ich * ");
 
  AddDetail( ({ "titel 4" }),
    "* Muskeln in 30 Tagen * ");

  AddDetail( ({ "titel 5" }),
    "* 30 - Geht das Leben weiter? * ");
 
  AddDetail( ({ "titel 6" }),
    "* Junges Aussehen auch nach 30 * ");

  AddDetail( ({ "titel 7" }),
    "* Die kleine Kletterfibel * ");

  AddDetail( ({ "titel 8" }),
    "* Aufrecht gehen leicht gemacht * ");

  AddDetail( ({ "titel 9" }),
    "* 1001 Wege eine fremde Beziehung zu zerstoeren * ");

  AddDetail( ({ "titel 10" }),
    "* Hobbies fuer den reifen Mann * ");

  AddDetail( ({ "titel 11" }),
    "* Wie ueberliste ich meine Waage * ");

  AddDetail( ({ "titel 12", "titel 13", "titel 14" }),
    "Mehr Titeln kannst Du leider nicht erkennen. ");

  AddDetail( ({ "eimer", "abfalleimer" }),
    "Der Abfalleimer steht direkt neben dem Schreibtisch. Abgesehn von "
    "einer Unmenge von Zetteln findest Du ein kleines Buechlein darin. ");

  AddDetail( ({ "buechlein" }),
    "-- Medizinstudium in Regelstudienzeit -- steht auf dem Einband. "
    "Anscheinend wird es nicht mehr benoetigt. ");

  AddDetail( ({ "unmenge", "unmengen" }),
    "Werden anscheinend nicht mehr benoetigt. ");

  AddDetail( ({ "zetteln", "zettel" }),
    "Steht nur belangloses Zeug drauf!");

  AddDetail( ({ "zeug" }),
    "Wirklich alles uninteressant!");

  AddDetail( ({ "fenster" }),
    "Im Norden befindet sich ein Fenster, durch das man sicherlich "
    "hinaus blicken kann. ");

  AddDetail( ({ "norden" }),
    "Vergiss das mit dem Norden, falls Du das nicht kennst... Das Fenster "
    "ist einfach genau vor Dir!");

  AddDetail( ({ "nordwand" }),
    "Nordwand = Norden = Fenster!");

  AddDetail( ({ "westen", "westwand" }),
    "Ein protziger Schreibtisch aus feinstem Balau gefertigt. Auf ihm "
    "wuetet das Chaos, allerdings ueberrascht Dich das nicht sonderlich. "
    "Linkerhand hat der Tisch 3 Laden, auf der rechten Seite siehst Du "
    "ein Tuerchen. ");

  AddDetail( ({ "suedwand", "sueden" }),
    "An der Suedwand siehst Du ein riesiges Buecherregal. Ob der Doktor "
    "wohl alle diese Buecher gelesen hat?! Bei dem Gedanken musst Du selbst "
    "schon schmunzeln. ");

  AddDetail( ({ "einband" }),
    "Der war wohl genauso unbrauchbar wie der Rest des Buechleins. ");

  AddDetail( ({ "medizinstudium", "medizin", "studium" }),
    "Dachtest Du wirklich, dass der Doktor ausgebildeter Mediziner ist?!");

  AddDetail( ({ "mediziner" }),
    "Kindchen... denk doch mit!");

  AddDetail( ({ "kindchen" }),
    "Ok, ich nenn Dich nie wieder so! Versprochen!");

  AddDetail( ({ "regelstudienzeit" }),
    "WAS SOLL DAS SEIN?! ;)");

  AddDetail( ({ "rest" }),
    "War wohl ein Fehlkauf!");

  AddDetail( ({ "fehlkauf" }),
    "War wohl einer!");

  AddDetail( ({ "blick" }),
    "Du kannst Dir gerne die Titeln ansehen, wenn Du Dich traust!");

  AddDetail( ({ "boden" }),
    "Auf dem Boden wurde edelstes (und sicherlich auch teuerstes) "
    "Mahagoniparkett verlegt, danach mehrfach versiegelt und zum Schluss "
    "noch poliert. Absoluter Luxus!");
  
  AddDetail( ({ "parkett", "mahagoniparkett" }),
    "Das Parkett sieht teuer und sehr edel aus. Was anderes hast Du hier auch "
    "gar nicht erwartet. ");

  AddDetail( ({ "mahagoni" }),
    "Der Boden ist aus feinstem Mahagoniparkett. ");

  AddDetail( ({ "luxus" }),
    "Nur das Teuerste ist fuer den Doktor gut genug!");

  AddDetail( ({ "teuerstes", "teuerste" }),
    "Hauptsache teuer! Der Rest ist doch wirklich Nebensache. Wer "
    "braucht schon Qualitaet?!");

  AddDetail( ({ "nebensache", "rest" }),
    "Ist doch egal - hauptsache es war teuer!");

  AddDetail( ({ "qualitaet" }),
    "Qualitaet wird schon stimmen, solange es teuer war...");

  AddDetail( ({ "schluss" }),
    "Zuerst wird verlegt, dann versiegelt und dann poliert!");

  AddDetail( ({ "balau" }),
    "Der Tisch ist aus feinstem Balau gefertigt worden, und uebertrifft "
    "eigentlich so ziemlich alles, was Du bisher in der Buschklinik "
    "gesehen hast. ");

  AddDetail( ({ "klinik", "buschklinik" }),
    "Wenn Du nicht mal selbst weisst, wo Du bist, kann ich Dir auch nicht "
    "mehr helfen. ");

  AddDetail( ({ "schreibtisch", "tisch" }),
    "Zu dem Schreibtisch an der Westwand faellt Dir echt nur das Wort "
    "protzig (!!!) ein! Er hat auf der linken Seite 3 Laden, auf der "
    "rechten befindet sich ein Tuerchen. ");

  AddDetail( ({ "laden", "lade" }),
    "Du siehst hier sogar 3 Laden. Welche interessiert Dich denn? Die "
    "oberste, mittlerste, unterste? Oder etwa alle drei?!");

  AddDetail( ({ "oberste", "obere" }),
    "Die oberste WAS?! Lade?!");

  AddDetail( ({ "mittlerste", "mittlere" }),
    "Die mittlerste WAS?!");

  AddDetail( ({ "unterste", "untere" }),
    "Die unterste WAS?!");

  AddDetail( ({ "oberste lade", "obere lade", "mittlere lade",
    "untere lade", "unterste lade", "mittlerste lade" }),
    "Wow, die Lade sieht wirklich super interessant aus!");

// oeffnen
  
  AddDetail( ({ "chaos" }),
    "Das Chaos wuetet auf dem Tisch. Irgendwie bist Du davon nicht "
    "ueberrascht...");

  AddDetail( ({ "wort", "protzig" }),
    "PROTZIG!!!");

  AddDetail( ({ "doktor" }),
    "Der ist grad nicht hier!");

  AddDetail( ({ "leben" }),
    "Das Leben des Doktors ist aeh etwas sonderbar manchmal. ");

  AddDetail( ({ "seite" }),
    "Ganz simpel: links: 3 Laden - rechts: 1 Tuerchen!");

  AddDetail( ({ "tuerchen", "tuere" }),
    "Der Schreibtisch hat auf der rechten Seite ein Tuerchen mit einem "
    "Schloss. ");

  AddDetail( ({ "schloss" }),
    "Das Schloss sieht einigermassen stabil aus. Wahrscheinlich gibt es "
    "sogar irgendwo einen Schluessel dazu. ");

  AddDetail( ({ "schluessel" }),
    "Cleme ist sich zu 100% sicher, dass es einen Schluessel fuer dieses "
    "kleine Schloss gibt - aber ob sie Dir verraet wo der ist, ist eine "
    "ganz andre Frage!");

  AddDetail( ({ "frage", "fragen" }),
    "Fragen stellt man, und untersucht sie nicht ;)");
    
  AddDetail( ({ "cleme", "clementine" }),
    "Frag sie doch!");

  AddDetail( ({ "freie" }),
    "Durch das Fenster kannst Du raus schauen!");

  AddDetail( ({ "gedanken", "gedanke" }),
    "Du schmunzelst. ");

  AddDetail( ({ "buecher", "buch" }),
    "Es befinden sich ziemlich viele Buecher in dem Regal. Zumindest quillt "
    "dieses schon fast ueber. Wenn Du neugierig bist, kannst Du ja mal das "
    "eine oder andere anschauen. ");

  AddDetail( ({ "buch 1", "buch eins", "buch 2", "buch zwei", "buch 3",
    "buch drei","buch 4", "buch vier", "buch 5", "buch fuenf", "buch 6", 
    "buch sechs" }),
    "Schau Dir doch einfach mal die Titel genauer an. ");

  AddDetail( ({ "ostwand", "osten" }),
    "Im Osten gehts wieder hinaus. ");

  AddDetail( ({ "wand" }),
    "Das Zimmer hat sogar vier Waende, bitte werd etwas genauer!");

  AddDetail( ({ "zimmer", "raum" }), QueryProp(P_INT_LONG) );

  AddDetail( ({ "waende" }),
    "Hier gibt es vier huebsche Waende. ");

  AddDetail( ({ "decke" }),
    "Die Decke ist in weiss gehalten, und scheint kuerzlich erst wieder neu "
    "gestrichen worden zu sein. In der Mitte baumelt eine komische "
    "Designerkonstruktion. ");

  AddDetail( ({ "mitte" }),
    "Dort haengt ein tolles Designerstueck. ");

  AddDetail( ({ "designerstueck", "stueck", "konstruktion", 
    "designerkonstruktion" }),
    "Was diese Konstruktion darstellen soll, bzw. welchen Zweck sie ueberhaupt "
    "erfuellt ist Dir voellig unklar. Das einzige was Du mit Sicherheit sagen "
    "kannst, ist, dass sie einfach absolut haesslich ist :)");

  AddDetail( ({ "sicherheit" }),
    "Die bist ueberwaeltig von so schlechtem Geschmack. ");

  AddDetail( ({ "zweck" }),
    "Der ist leider alles andere als erkennbar. ");

  AddDetail( ({ "lampe" }),
    "Wenn das eine Lampe waere, koenntest Du sie sicher einschalten. ");

  AddDetail( ({ "geschmack" }),
    "Absolut grauenvoll!");

  AddDetail( ({ "fotos" }),
    "Alle Fotos zeigen mehr oder weniger Axel Koerperflicker "
    "(zumindest seinen Kopf). "
    "Der Koerper sieht meist etwas verformt aus, so als ob er nicht "
    "dazu gehoeren wuerde...");

  AddDetail( ({ "koerper" }),
    "Die Koerper auf den Fotos sehen nicht wirklich aus wie der von "
    "Axel - aber Hauptsache der Kopf stimmt ;)");

  AddDetail( ({ "kopf" }),
    "Axels Kopf eindeutig! Aber jeweils mit anderen Koerpern!"); 

  AddDetail( ({ "axel", "axel koerperflicker", "koerperflicker" }),
    "Du stehst grad in seinem Buero. ");

  AddDetail( ({ "buero" }),
    "Genau da stehst Du gerade. ");

  AddDetail( ({ "foto eins", "foto 1" }),
    "");

  AddDetail( ({ "foto zwei", "foto 2" }),
    "");

  AddDetail( ({ "foto drei", "foto 3" }),
    "");

  AddDetail( ({ "foto vier", "foto 4" }),
    "");

  AddDetail( ({ "foto fuenf", "foto sechs", "foto sieben", "foto acht",
    "foto 5", "foto 6", "foto 7", "foto 8" }),
    "Mehr Fotos moechtest Du Dir wirklich nicht mehr antun geschweige "
    "denn ansehen. ");

  AddDetail( ({ "hauptsache", "wichtigstes", "wichtigste" }),
    "Das ist ja das Wichtigste!");

  AddDetail( ({ "erfolge", "erfolg" }),
    "Auf den Waenden thronen Fotos von den Erfolgen (?!), des Doktors :)");

 

  AddReadDetail( ({ "zettel" }),
    "Du fischt einen Zettel heraus, und versuchst ihn zu entziffern.\n"
    "\n"
    "K  ri  A b it 01/ 07  40 5\n"
    "\n"
    "Du fuehlst Dich nun um einiges schlauer, und wirfst den Zettel wieder "
    "weg.\n");


// SMELLS

  AddSmell(DEFAULT_SMELL, "Es riecht hier nach Papier. ");

  AddSmell( ({ "papier" }),
    "Hier riecht es vorwiegend nach Papier, liegt wohl an den vielen "
    "Buechern... nur manchmal bekommt Deine Nase auche eine "
    "frische Brise Dschungel zugeweht. ");

  AddSmell( ({ "brise", "dschungel" }),
    "Manchmal riechst Du auch den Dschungel, der das Haus einschliesst. ");

  AddSmell( ({ "haus" }),
    "Du stehst hier nur im Buero! Wie willst Du das ganze Haus von hier "
    "riechen?");

  AddSmell( ({ "buero" }),
    "PAPIER! WIE OFT NOCH?! ES RIECHT HIER NACH PAPIER!");

  AddSmell( ({ "nase" }),
    "Das geht nicht! Aber Du kannst mir gerne das Gegenteil beweisen...");

  AddDetail( ({ "gegenteil" }),
    "Beweis es mir doch!"); //beweise gegenteil


// SOUNDS

  AddSound(DEFAULT_SOUND, "Draussen hoerst Du manchmal einige Tiere komische "
    "Laute von sich geben. ");

  AddSound( ({ "laute", "laut" }),
    "*GROAAAAAAAAAAAAAAAR* *BRUEEEEEEEEEEEEEEEEELL* *BRMMMMMMMM*");

  AddSound( ({ "groaaaaaaaaaaaaaaar" }),
    "Du fuerchtest Dich. ");

  AddSound( ({ "tiere", "tier" }),
    "Die Tiere draussen im Dschungel geben komische Laute von sich. ");

  AddSound( ({ "dschungel" }),
    "Du hoerst die Tiere! Und ihre Laute!");

  AddSound( ({ "tiere", "tier" }),
    "Die Tiere draussen im Dschungel geben komische Laute von sich. ");

  AddSound( ({ "dschungel" }),
    "Du hoerst die Tiere! Und ihre Laute!");




//blicken durchs fenster ins freie etc
// schalte lampe ein suche lampe ab (hebel finden) ziehe hebel konstruktion macht was aber ka lampe
// buecher lesen 
}


