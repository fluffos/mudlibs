
inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../dante.h"


create()
{

::create();

  SetProp(P_INT_SHORT, "Im Dschungel");
  SetProp(P_INT_LONG, 
	  "Langsam beginnt Dir das tropische Klima des Dschungels richtig "
	  "zuzusetzen. Die Vegetation wird immer undurchdringlicher, sodass "
	  "Du wahrscheinlich bald eine Machete brauchen wirst, um auch nur "
	  "irgendwie vorwaerts zu kommen. Hoffentlich findest Du hier "
	  "ueberhaupt je wieder raus, schliesslich hast Du weder Kompass noch "
	  "Karte bei Dir, und einen Hilfeschrei hoert hier garantiert niemand. ");
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);

  AddExit( "suedosten", ROOM "weg8");
  AddExit( "norden", ROOM "weg10");

}

