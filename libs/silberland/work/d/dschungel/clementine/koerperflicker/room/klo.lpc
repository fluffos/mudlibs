
inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../dante.h"

void init()
{
  ::init();
  TP->SetProp(P_AWAY, "Bin kacken, also stoer gefaelligst nicht!");
}

create()
{

::create();

  SetProp(P_INT_SHORT, "Auf dem Klo");
  SetProp(P_INT_LONG, 
    "Boah! Wo bist Du denn hier gelandet??? Es stinkt bestialisch nach "
    "Exkrementen, die nichts Gutes ueber die Verdauung der Produzenten "
    "aussagen. Vor Dir befindet sich eine Grube mit einem verkrusteten "
	"Holzbalken, aus der noch Daempfe aufsteigen. Im krassen "
    "Gegensatz zu dieser Kloake steht der Dschungel mit seiner vollen "
    "Artenvielfalt und natuerlichen Aesthetik. ");
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);

  AddExit( "nordosten", ROOM "weg17");
  AddExit( "westen", ROOM "veranda");

}

