
inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../dante.h"


#define MAX_PERSONEN 1

string *spieler_liege;

void create()
{

::create();

  SetProp(P_INT_SHORT, "In einem Behandlungsraum");
  SetProp(P_INT_LONG,
    "Nun stehst Du im sagenumwobenen Behandlungsraum von Dr. Koerperflicker. "
    "Du bist ueberrascht, dass es hier nicht ganz so unprofessionell aussieht "
    "wie sonst ueberall! Hier findet sich tatsaechlich echtes medizinisches "
    "Geraet. Du siehst eine Liege, die mit Bast bespannt ist, und auf der "
    "doch tatsaechlich keine Flecken von anderen Patienten zu finden sind. "
    "An der Wand haengt eine Tafel, auf der gross irgendwelche "
    "Buchstaben aufgemalt sind. Auf einem kleinen Tischchen "
    "liegen einige Spritzen, Kanuelen, und sogar ein Mikroskop. ");
  SetProp(P_LIGHT, 1);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);
  SetProp(P_KILL_NAME, "Ugaugauga");
  SetProp(P_KILL_MSG, "Du seien dummes Spieler!");

  
  AddExit( "osten", ([ EX_DEST : ROOM "warte",
                       EX_TESTFUNC: "exit_test" ]) );


// DETAILBEGINN

  
  AddDetail( ({ "raum", "behandlungsraum", "zimmer" }),
	"Du befindest Dich augenblicklich in Dr. Koerperflickers Behandlungsraum. "
	"Im Vergleich zu den uebrigen Raeumen sieht es hier wirklich recht "
	"gemuetlich und sauber aus. ");

  AddDetail( ({ "raeume" }),
	"Selber forschen macht Freude!");

  AddDetail( ({ "freude" }),
	":))");

  AddDetail( ({ "koerperflicker", "doktor", "dr", "axel" }),
	  "Den siehst Du hier nirgends. ");

  AddDetail( ({ "mikroskop" }),
	  "Boah! Ein richtig krasses Superteil! Woher der Doktor das wohl hat? "
	  "Muss sicher ein Schweinegeld gekostet haben! ");

  AddDetail( ({ "superteil", "teil" }),
      "Ob das echtes Silber ist? Da ist sogar etwas eingraviert! ");

  AddDetail( ({ "silber" }),
	  "Ob echtes oder nicht echtes, auf jeden Fall wuerde man dafuer einen "
	  "Haufen Muenzen bekommen. ");

  AddDetail( ({ "haufen", "muenzen" }),
	  "Es ist sicherlich sehr sehr sehr wertvoll!");

  AddDetail( ({ "gravur" }),
     "Da steht doch tatsaechlich etwas drauf!");

  AddReadDetail( ({ "gravur" }),
	  "\n"
	  "+~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~+\n"
	  "|Dr. dr. dr. dr. dr. dr. A. Koerperflicker|\n"
	  "+~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~+\n"
	  "\n");

  AddDetail( ({ "fall" }),
	  "Fall untersuchen? Wofuer das denn? Der Sinn ergibt sich doch schon aus "
	  "dem Zusammenhang. ");

  AddDetail( ({ "sinn", "zusammenhang" }),
	  "Das ist Sinnlos. ");

  AddDetail( ({ "sinnlos" }),
	  "Das Untersuchen wird bald weh tun!");

  AddDetail( ({ "untersuchen" }),
	  "Wenn Du jetzt noch >Ugaugauga< untersuchst wirst Du Dir weh tun.");

  AddSpecialDetail( ({ "ugaugauga" }), "dummheit" );
	  
	  
  AddDetail( ({ "etwas" }),
	 "Wo ist etwas?");

  AddDetail( ({ "vergleich" }),
    "Wirklich viel sauberer, als in den anderen Raeumen. ");

  AddDetail( ({ "bast" }),
    "Die Liege wurde mit Bast bespannt, und Du findest hier doch tatsaechlich "
    "keine Flecken und Blutspritzer anderer Patienten. ");

  AddDetail( ({ "liege" }),
    "Die Liege wurde mit Bast bespannt. Hier behandelt der Doktor wohl "
    "seine Patienten. Du kannst Dich ja einmal draufsetzen..."); 

  AddDetail( ({ "schweinegeld", "geld" }),
    "Das muss ur teuer gewesen sein! Das glaenzt sogar richtig!");

  AddDetail( ({ "patienten", "patient" }),
    "Momentan sind keine Patienten hier, die behandelt werden koennten. ");

  AddDetail( ({ "boden" }),
    "Steril waere uebertrieben, aber der Boden sieht auf den ersten Blick "
    "wirklich sauber aus. ");

  AddDetail( ({ "blick" }),
    "Auf den ersten Blick wirkt hier alles sauber. Richtig nett!");

  AddDetail( ({ "waende" }),
    "Die Waende wurden weiss gestrichen, auch sie sehen ziemlich sauber aus. "
    "An einer Wand haengt eine grosse Tafel mit aufgekritzelten Buchstaben.");

  AddDetail( ({ "wand" }),
    "An einer Wand haengt eine grosse Tafel mit aufgekrtzelten komischen "
    "Zeichen, oder sollen das Buchstaben sein?! So genau kannst Du das " 
    "nicht erkennen. ");

  AddDetail( ({ "tafel" }),
    "Ui, das ist ja eine grosse Tafel! Und da sind sogar Zeichen "
    "draufgemalt. "); //umdrehen schluessel?

  AddDetail( ({ "zeichen" }),
    "Es handelt sich bei den Zeichen ja wirklich um Buchstaben!");

  AddDetail( ({ "buchstaben" }),
    "Falls Du nicht ganz stark kurzsichtig bist, kannst Du sie sicherlich "
    "lesen. ");

  AddReadDetail( ({ "tafel", "buchstaben" }),
    "+-------------------+\n"
    "| A D U R L E M H A |\n"
    "| D M E I W C S H D |\n"
    "| S D G U X M Z T S |\n"
    "| I O Q F ! Y P V X |\n"
    "| 2 4 7 1 9 3 0 5 8 |\n"
    "+-------------------+\n"
    "\n"
    "Du denkst . o O (Mit so einer Tafel koennte man super toll "
    "Geheimbotschaften uebermitteln...)\n");
  
  AddDetail( ({ "geheimbotschaft", "botschaft", "botschaften", 
    "geheimbotschaften" }),
    "Was soll denn der Text bloss bedeuten?!");

  AddDetail( ({ "flecken", "fleck" }),
    "Kein einziger Fleck zu sehen! ");
  
  AddDetail( ({ "decke" }),
    "Von der weissen Decke baumelt eine Bambuslampe. ");

  AddDetail( ({ "lampe", "bambuslampe" }),
    "Die Lampe ist eher ein geflochtener Korb aus Bambus samt Kerze "
    "drinnen. ");

  AddDetail( ({ "kerze" }),
    "Scheint noch ziemlich neu zu sein. ");

  AddDetail( ({ "bambus" }),
    "Bambus ist ein sehr widerstandsfaehiges und gut zu verarbeitendes "
    "Material. ");

  AddDetail( ({ "material" }),
    "Man kann wirklich sehr viel aus Bambus herstellen, noch dazu sieht "
    "es eigentlich ziemlich nett aus. ");

  AddDetail( ({ "korb" }),
    "Der Korb wurde aus Bambus geflochten und baumelt mitsamt seinem "
    "Inhalt von der Decke. ");

  AddDetail( ({ "inhalt" }),
    "Na die Kerze!");

  AddDetail( ({ "tischchen", "holztischchen" }),
    "Auf dem kleinen Holztischchen liegen Spritzen und Kanuelen. Sogar "
    "ein Mikroskop kannst Du erkennen. Steril sieht das zwar alles nicht aus, "
    "aber wenigstens ist es sauber. ");

  AddDetail( ({ "holz" }),
    "Da hat wohl irgendein Baum im Dschungel dran glauben muessen. ");

  AddDetail( ({ "baum", "dschungel", "baeume" }),
    "Im Dschungel gibt es sowieso genug Baeume - noch.");

  AddDetail( ({ "blut", "blutsspritzer", "blutspritzer", "spritzer" }),
    "Auf der Liege sind doch tatsaechlich keine zu sehen. ");

  AddDetail( ({ "geraet" }),
    "Hier befindet sich doch tatsaechlich medizinisches Geraet! Keine "
    "Attrappen! Boah! Du bist richtig erstaunt!");

  AddDetail( ({ "attrappen", "attrappe" }),
    "Das medizinische Geraet ist wirklich echt! Wow!");

  AddDetail( ({ "kanuelen", "kanuele" }),
    "Die Kanuelen bestehen aus biegsamen Bambusroehren, die passend "
    "zurechtgeschnitten worden sind. In einer von ihnen siehst Du etwas "
    "Schwarzes. ");

  AddDetail( ({ "bambusroehren", "roehren" }),
    "Die sind wirklich wunderbar biegsam! Aber in Deinem Arm willst Du "
    "die trotzdem nicht stecken haben!");

  AddDetail( ({ "arm" }),
    "Zum Glueck bist Du hier nicht Patient sondern Krankenschwester. ");

  AddDetail( ({ "glueck", "krankenschwester", "schwester" }),
    "Sei froh, dass Du hier nur Krankenschwester bist!");

  AddDetail( ({ "bambusroehre", "roehre" }),
    "In einer steckt etwas drinnen. ");

  AddDetail( ({ "etwas" }),
    "Etwas zum Naschen, etwas Spannendes und etwas zum Spielen!");

  AddDetail( ({ "naschen", "spannendes", "spielen" }),
    "Du solltest gleich los gehen und Dir ein Ueberraschungsei besorgen. ");

  AddDetail( ({ "ueberraschungsei", "ei" }),
    "Hier gibt es sowas garantiert nicht!");

  AddDetail( ({ "schwarzes", "schwarze" }),
    "Wuah!!! Das Schwarze entpuppt sich als Schabe, die einige Reste einer "
    "gelblichen Fluessigkeit aufsaugt. ");

  AddDetail( ({ "fluessigkeit" }),
    "Sie ist gelblich und sieht nicht unbedingt appetitlich aus!");

  AddDetail( ({ "eiter" }),
    "Du kannst ja einmal kosten!");

  AddDetail( ({ "schabe" }),
    "Igittigitt!");

  AddDetail( ({ "reste" }),
    "Mjamm, lecker!");

  AddDetail( ({ "spritze", "spritzen" }),
    "Die Spritzen bestehen aus einem zylinderfoermigen Behaeltnis und "
    "einem ausgehoehlten Stachel, der die Spitze bildet. ");

  AddDetail( ({ "stachel" }),
    "Der Stachel wurde ausgehoehlt, damit auch etwas durchfliessen kann. Er "
    "wurde an der Spitze des Behaeltnis angebracht. ");

  AddDetail( ({ "spitze" }),
    "Die ist ganz vorne, und ganz spitz. Draufgreifen tut also sicherlich "
    "weh!"); 

  AddDetail( ({ "behaeltnis" }),
    "Scheint ein ausgehoehlter Ast zu sein?! Sicherlich sehr hygienisch!");

  AddDetail( ({ "ast" }),
    "Er wurde etwas gereinigt, und danach ausgehoehlt. "); 
 

  
  AddCmd( ({ "kost", "koste" }), "c_kosten");   
  AddCmd( ({ "greif", "greife" }), "c_greifen");
  AddCmd( ({ "nimm", "nehme", "nehm" }), "c_nehmen");      
  AddCmd( ({ "setz", "setze", "sitz" }), "c_setzen"); 
  AddCmd( ({ "dreh", "drehe" }), "c_drehen");

  spieler_liege = ({ });
 
}

int exit_test(string dir)
{
 if(!TP) return 1;
 if(!interactive(TP)) return 1;
 if(member(spieler_liege, getuuid(TP)) == -1) return 1;
 write(BS("Du sitzt doch noch auf der Liege!"));
 return 0;
}

 
 
 
int c_setzen(string str)
{
 notify_fail("Worauf moechtest Du Dich setzen?\n");
 if(!str || str == "") return 0;
 if(!(str == "auf liege")) return 0;
 if(member(spieler_liege, getuuid(TP)) != -1)
 {
  tell_object(TP, BS("Aber Du sitzt doch schon!"));
  return -1;
 }
 if(sizeof(spieler_liege) >= MAX_PERSONEN)
 {
  write(BS("Leider ist hier kein Platz mehr."));
  return -1;
 }
 spieler_liege += ({ getuuid(TP) });
 write(BS("Du machst es Dir auf der Liege bequem."));
 write(BS("Auf einmal hoerst Du den Doktor von draussen rufen: "
       "Machen sie sich obenrum schon mal frei, ich komm gleich!"));
 say(CTPN+ " setzt sich auf die Liege. Von draussen bruellt der Doktor "
     "etwas.\n");
 return 1;
} 

int c_greifen(string str)
{
 if( str != "auf spitze drauf"  &&
     str != "auf stachel drauf" )
 {
  notify_fail("Wo moechtest Du draufgreifen?!\n");
  return 0;
 }
 else
 {
  write(BS("AUAAAAAAAAAAAAAAAAAAAA! Das ist ja wirklich spitz!"));
  TP->do_damage(5+random(4)), this_object();
  say(CTPN+ " schreit kurz auf.\n");
  return 1;
 }
}


int c_kosten(string str)
{
 if( str != "fluessigkeit"            &&
     str != "gelbliche fluessigkeit"  &&
     str != "gelbe fluessigkeit"      &&
     str != "eiter"                   )
 {
  notify_fail("Was moechtest Du hier kosten?!");
  return 0;
 }
 else
 {
  write(BS("Du kostest die gelbliche Fluessigkeit...IGITT!!!! EITER!!!"));
  TP->command_me("-allgemein Ich schlecke fuer mein Leben gerne Eiter aus "
                 "Kanuelen ab!");
  return 1;
 }
}

int c_nehmen(string str)
{
 if( str != "mikroskop")
 {
  notify_fail("WAS nehmen?!");
  return 0;
 }
 else
 {
  write(BS("Das ist kein Spielzeug fuer kleine "+TP->QueryProp(P_NAME)+"s!!! "
           "Also Finger weg!"));
  say(CTPN+ " will wie immer alles angreifen.\n");
  return 1;
 }
}
   




int dummheit()
{
	write("Dummheit wird bestraft!\n");
	TP->do_damage(30+random(10), this_object());
  	return 1;
}

   
int c_drehen(string str)
{
	if(str != "tafel um"  &&
	   str != "tafel"      )
	{
		notify_fail("Was moechtest Du hier umdrehen?\n");
		return 0;
	}
	if(!present(QUESTITEM, TP))
	{
		write(BS("Du drehst die Tafel um, findest aber gar nichts. "
			 "Irgendetwas fehlt..."));
		return 1;
	}
	else
	{
		
		write(BS("Du findest einen kleinen Schluessel, den Du sofort "
					"einsteckst."));
		key = clone_object(OBJ "schluesselrot");
                key->move(TP,M_GET); 
		
		return 1;
		
	}
}


