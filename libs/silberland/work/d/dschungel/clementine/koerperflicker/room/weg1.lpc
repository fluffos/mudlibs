// praxisschild hatn zettel - momentan wegen syphillis zu bis es fertig ist..


inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../dante.h"

int anz_wurm;

void reset()
{
   ::reset();
    anz_wurm = 1;
}

void create()
{

::create();

  anz_wurm = 1;
  SetProp(P_INT_SHORT, "Im Dschungel");
  SetProp(P_INT_LONG,
    "Du stehst auf einem kleinen Trampelpfad, der von riesigen Baeumen "
    "und undurchdringlichem Gestruepp gesaeumt wird. Aus der Ferne vernimmst "
    "Du das Tosen eines Wasserfalls. Der Trampelpfad fuehrt Dich anscheinend "
    "weiter nach Norden, da er im Sueden an dichtgedraengten Bueschen "
    "endet, durch die es kein Durchzwaengen gibt. Ein kleines Schild aus Holz "
    "wurde am Wegrand lustlos in den Boden gestampft. "); 
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
  SetProp(P_KILL_NAME, "Ein gravierendes Leseproblem");

 // AddExit( "norden", ROOM "weg2"); Mal ausgeklammert weil nicht fertig



// DETAILBEGINN


  AddDetail( ({ "trampelpfad", "pfad" }), 
    "Du stehst auf einem kleinen Trampelpfad. Er scheint Dich nach Norden "
	"zu fuehren. Rechts und links von ihm wachsen einige Graeser, ansonsten "
	"ist er nur von undurchdringlichem Gestruepp und meterhohen Baeumen "
	"umgeben. ");

  AddDetail( ({ "baeume", "baeumen" }),
    "Meterhohe Urwaldriesen saeumen den kleinen Trampelpfad. Sie sind sicher"
	"schon einige hundert Jahre alt. Ihre Staemme, Aeste und Zweige "
	"sehen aus, als wuerden sie sogar Elefanten stand halten. " );
 
  AddDetail( ({ "urwaldriesen", "riesen" }),
	  "Meterhohe in den Himmel wachsende Baeume haben hier ihre Wurzeln tief "
	  "im Boden verankert. ");
  
  AddDetail( ({ "graeser", "gras" }),
	"Ein paar Graeser wachsen entlang des Pfades. Nichts besonderes dabei. ");

  AddDetail( ({ "besonderes" }),
	  "Wirklich rein gar nichts!");

  AddDetail( ({ "aeste", "stamm", "zweige", "blaetter", "wurzeln", "staemme" }),
	 "\n"
	 "  @@@@\n"
	 " @@@@~@     <-- Blaetter\n"
	 "@@@~@@@@    <-- Zweige\n" 
	 " @@@@@@@    <-- Aeste\n"
	 "  @@_@\n"
	 "   ||       <-- Stamm\n"
	 "  _||_\n"
	 "  /|/       <-- Wurzeln\n"
	 "\n");
	
  AddDetail( ({ "jahre" }),
	  "Sicher schon sehr alt. ");
  
  AddDetail( ({ "nichts" }),
	  "Absolut nichts. ");

  
  AddDetail( ({ "gestruepp" }),
    "Dein Weg wird von undurchdringlichem Gestruepp gesaeumt. Das Geaest "
	"ist so dicht verzweigt, dass hier nicht einmal ein kleines Tier "
	"durchkommen koennte. ");

  AddDetail( ({ "tier" }),
	"Hier kommt garantiert nichts durch. ");
  
  AddDetail( ({ "geaest" }),
	  "Hier kommt man hoechstens durch, wenn man so gross wie eine Ameise "
	  "ist. ");

  AddDetail( ({ "ameise" }),
	  "Augenblicklich siehst Du hier sowas nicht. ");

  AddDetail( ({ "sowas" }),
	  "Na sowas. ");

  AddDetail( ({ "ferne" }),
    "Die Ferne kann manchmal ganz schoen weit weg sein. ");

  AddDetail( ({ "tosen" }),
    "Probiers mal mit lauschen!");

  AddDetail( ({ "wasserfall" }),
    "Sehen kannst Du ihn von hier aus nicht, aber vielleicht hilft es ja, "
	"wenn Du lauscht?");

  AddDetail( ({ "buesche", "bueschen" }),
    "Die Buesche sind gruen und stehen sehr dicht!");
  
  AddDetail( ({ "norden" }),
    "Der Weg fuehrt weiter nach Norden. Vielleicht ist es dort ja auch "
	"etwas Aufregender als hier. ");
  
  AddDetail( ({ "gebuesch" }),
    "Ob man sich einen Weg nach Osten bahnen kann durch das Gebuesch?");

  AddDetail( ({ "sueden" }),
    "Im Sueden endet der Pfad vor undurchdringlichen Bueschen. ");

  AddDetail( ({ "osten" }),
    "Im Osten befindet sich nichts als undurchdringliches Gebuesch. Wer "
	"sich hier versucht einen Weg zu bahnen wird klaeglich scheitern, oder "
	"gleich sterben. "); 

  AddDetail( ({ "westen" }),
    "Nach Westen gibt es absolut kein Durchkommen! ");

  AddDetail( ({ "durchkommen" }),
	  "Absolut nicht moeglich, probier es erst lieber gar nicht. ");

  AddDetail( ({ "schild", "holzschild" }),
    "Ein Schild aus Holz wurde hier in den Boden gesteckt. "
	"Und natuerlich, wie sollte es anders sein, findest Du auf diesem "
	"Schild auch einen Text. ");

  AddDetail( ({ "holz" }),
	  "Wie der Name schon sagt, besteht das Holzschild aus Holz. Auf es "
	  "wurde ein Text eingeritzt. ");

  AddDetail( ({ "name" }),
	  "Der Name des Holzschilds ist Holzschild. ");
  
  AddDetail( ({ "text" }),
	  "Toll, da steht etwas! ");

  AddSpecialDetail( ({ "etwas" }), "c_etwas");

  AddDetail( ({ "wegrand" }),
    "Da ist ein Schild!");
  
  AddDetail( ({ "boden" }),
    "Du kannst beruhigt sein, Du stehst auf ganz normalen Dschungelboden, "
	"wie Du ihn hier fast ueberall findest. Stinknormale Erde, mit "
	"abundzu mal ein paar kleinen Steinchen dazwischen. Am Wegrand "
	"wachsen ein paar Graeser, Buesche und Baeume. "); 

  AddDetail( ({ "dschungelboden" }),
	  "Falls es Dir entgangen ist: DU BEFINDEST DICH HIER IM DSCHUNGEL! "
	  "Also was hast Du erwartet? Einen tiefgefrorenen Boden?");

  AddDetail( ({ "dschungel" }),
	  "Der Dschungel befindet sich rechts und links von Dir, ober und unter "
	  "Dir, vor und hinter Dir... eigentlich ueberall um Dich herum. ");
  
  AddDetail( ({ "erde" }),
	  "Um die haargenaue Zusammensetzung der Erde unter Deinen Fuessen "
	  "festzustellen, muesste man sie schon kosten. "); 

  AddDetail( ({ "zusammensetzung" }),
	  "Vielleicht koenntest Du sie ja 'erschmecken', wenn Du etwas Erde zu "
	  "Dir nimmst. ");

  AddDetail( ({ "steinchen" }),
	  "Einige kleine Steinchen wurden hier mit der Erde platt getrampelt. "
	  "Sie haben die verschiedensten Groessen und Formen, sehen aber "
	  "dennoch alle gleich aus. ");

  AddDetail( ({ "groessen", "groesse" }),
	  "gross, mittel, klein, kleiner als klein, ... ");

  AddDetail( ({ "formen", "form" }),
	  "rund, spitz, eckig, oval, kugelig, ... ");

  AddDetail( ({ "fuesse" }),
	  "Beide noch dran. ");

  AddDetail( ({ "weg" }),
    "Der Trampelpfad ist damit gemeint. ");

  AddDetail( ({ "durchzwaengen" }),
    "Sich im Sueden wo durchzuzwaengen scheint absolut unmoeglich zu sein. "
	"Aber vielleicht sollte man manchmal das Unmoegliche versuchen, um das "
	"Moegliche auszumachen. ");
  
  AddDetail( ({ "moegliche" }),
	  "Das Moegliche erkennst Du nur, wenn Du alles - selbst das Dir "
	  "unmoeglich Erscheinende probiert hast. ");

  AddDetail( ({ "erscheinende" }),
	  "Manchmal sind die Dinge anders, als sie scheinen. ");

  AddDetail( ({ "dinge" }),
	  "Ein Ding, zwei Ding, drei Ding. ");

  AddDetail( ({ "ding" }),
	  "Ding, Dong, flutschdiwutsch ;)");

  AddDetail( ({ "dong" }),
	  "Hey, das ist krank ;)");

  AddDetail( ({ "flutschdiwutsch" }),
	  "Das ist jetzt das letzte Detail hier, weil ich muss mich gleich "
	  "schminken gehen, weil ich noch fortgehe :)\n"
	  "Jemand zwinkert Dich aus der Ferne an. ");

  AddDetail( ({ "detail", "jemand" }),
	  "AFK - SCHMINKEN!");

  AddDetail( ({ "afk", "schminken" }),
	  "Hilft eh nicht mehr viel, aber man sollte doch das Unmoegliche "
	  "probieren :)");

  AddDetail( ({ "unmoegliche" }),
	  "Man sollte nichts unversucht lassen. ");

  AddDetail( ({ "aufregender" }),
	  "Lass Dich ueberraschen...");

  AddDetail( ({ "elefanten", "elefant" }),
	  "Natuerlich war das nur als Metapher gemeint, da hier weit und breit "
	  "keine Elefanten sind. ");

  AddDetail( ({ "metapher" }),
	  "Eine Metapher fuer die Standhaftigkeit. ");

  AddDetail( ({ "standhaftigkeit" }),
	  "Da musst Du mal Wuz danach fragen, die kennt sich da eindeutig "
	  "besser aus. ");

  AddDetail( ({ "wuz" }),
	  "Frag sie!"); 

  AddDetail( ({ "himmel" }),
     "Denn Himmel kannst Du hier kaum erkennen.");

  
  AddReadDetail( ({ "schild", "text" }),
    "+-------------------------------+\n"
    "|                               |\n"
    "|             <<---             |\n"
    "|                               |\n"
    "|          Buschpraxis          |\n"
    "|              von              |\n"
    "|  Dr. Dr. Axel Koerperflicker  |\n"
    "|                               |\n"
    "|             <<---             |\n"
    "|                               |\n"
    "+-------------------------------+\n" 
    "Drunter klebt noch ein Notizzettel!\n");

  AddReadDetail( ({ "zettel", "notiz", "notizzettel" }),
    "+-------------------------+\n"
    "|  Aufgrund von Syphillis |\n"
    "| voruebergehend gesperrt |\n"
    "|             i.V. Cleme  |\n"
    "+-------------------------+\n");

  AddDetail( ({ "notiz", "notizzettel", "zettel" }),
    "Lesen!");

  AddDetail( ({ "vogel", "voegel" }),
    "Sehen kannst Du sie nicht!");

//SOUNDS

  AddSound(DEFAULT_SOUND, "Du vernimmst die typischen Dschungelgeraeusche.");

  AddSound( ({ "dschungel", "dschungelgeraeusche", "geraeusche" }),
    "Krahkrah, raschel raschel.");

  AddSound( ({ "krahkrah" }),
    "Stammt wohl von den Voegeln.");

  AddSound( ({ "voegel", "vogel" }),
    "Du hoerst sie kraechzen.");

  AddSound( ({ "kraechzen" }),
    "*krah* *krah*");

  AddSound( ({ "raschel raschel", "raschel" }),
     "*raschel*");

  AddSound( ({ "tosen", "wasserfall" }),
    "*rausch*");

//SMELLS

  AddSmell(DEFAULT_SMELL, "Es riecht hier nach Pflanzen!");

  AddSmell( ({ "pflanze", "Pflanzen" }),
     "Du atmest tief ein.");  

// COMMANDS   


  AddCmd( ({ "pflueck", "pfluecke" }), "c_pfluecken");
  AddCmd( ({ "kost", "koste" }), "c_kosten"); 
  AddCmd( ({ "zwaeng", "zwaenge" }), "c_zwaengen");
  AddCmd( ({ "bahne", "bahn" }), "c_bahnen");
  AddCmd( ({ "frag", "frage" }), "c_fragen");
  AddCmd( ({ "probier", "probiere" }), "c_probieren");
  AddCmd( ({ "sei" }), "c_seien"); 
}

int c_pfluecken(string str)
{
  if( str != "graeser"  &&
	  str != "gras"     )
  {
	notify_fail("Was moechtest Du pfluecken?\n");
	return 0;
  }
  else
  {
	write(BS("Du kleine Umweltratte! Lass die Graeser gefaelligst dort, "
		  "wo sie hingehoeren!"));
	say(CTPN + " schaemt sich ploetzlich.\n");
	return 1;
  }
}

int c_kosten(string str)
{
  object ob;
  if( str != "erde" )
  {
	notify_fail("Was moechtest Du hier kosten?\n");
    return 0;
  }
  else
  {
	if( anz_wurm < 1 )
	{
	 write(BS("Du nimmst eine halbe Hand voll Erde in den Mund, und spuckst "
		   "sie sofort angewidert wieder aus. Igittigitt! Jetzt willst Du "
		   "gar nichts mehr ueber die Zusammensetzung wissen. "));
	 return 1;
	}
	else
	{
	 write(BS("Du nimmst eine halbe Hand voll Erde in den Mund, und versuchst "
		  "anhand des Geschmackes die Zusammensetzung herauszufinden. "
		  "Igitt, was ist das? Ein Wurm!!! Angewidert spuckst Du alles "
		  "wieder aus. "));
	 say(CTPN + " steckt sich Erde in den Mund, verzieht kurzerhand das "
		"Gesicht und spuckt ploetzlich alles wieder aus.\n");
     ob = clone_object(NPC "wurm");
	 ob->move(this_object(), M_SILENT|M_NOCHECK);
	 anz_wurm--;
	 return 1;
    }
  }
}


string c_etwas(string str)
{
   write(BS("Hurra, Du findest Etwas!"));
   domainshout(CTPN+ " hat soeben Etwas gefunden!\n");
   return "";
}


int c_zwaengen(string str)
{
 if(str != "durch buesche")
 {
  notify_fail("Wodurch moechtest Du Dich zwaengen?\n");
  return 0;
 }
 else
 {
  write(BS("Muehevoll zwaengst Du Dich durch die Buesche. "));
  TP->move("/d/dschungel/clementine/wantan/room/anschluss2", M_GO,
  "irgendwohin", "verschwindet", "zwaengt sich durch einige Buesche herein" );
  return 1;
 }
}

int c_bahnen(string str)
{
  if(str != "weg"                  &&
	 str != "weg nach osten"       &&
	 str != "weg durch gestruepp"  &&
	 str != "weg durch gebuesch"   )
  {
	notify_fail("Was moechtest Du Dir bahnen?\n");
	return 0;
  }
  else
  {
	write(BS("Bei Deinem Versuch Dir einen Weg nach Osten durch das "
		"Gebuesch zu bahnen, ziehst Du Dir einige Schrammen zu. "));
	TP->move("d/dschungel/clementine/schmied/room/schmied", 
	 M_GO, "irgendwohin", "verschwindet",  
	"zwaengt sich durch einige Buesche herein" );
	TP->do_damage(10+random(10), this_object());
	return 1;
  }
}

int c_fragen(string str)
{
  if(str != "wuz"                      &&
	 str != "wuz nach standhaftigkeit" )
  {
   notify_fail("Wen moechtest Du was fragen?\n");
   return 0;
  }
  else
  {
   write(BS("Wuz ist momentan gerade leider out of order. Probier "
		 "es spaeter nochmal ;)"));
   return 1;
  }
}

int c_probieren(string str)
{
  if(str != "durchkommen"             &&
	 str != "durchkommen nach westen" )
  {
	notify_fail("Was moechtest Du probieren?\n");
	return 0;
  }
  else
  {
   	write(BS("Das haettest Du Dir sparen koennen. Ausser einigen Wehwehs "
		  "gibt es hier naemlich nichts. "));
	TP->do_damage(20+random(10), this_object());
	say(CTPN+ " schaut ploetzlich blass aus.\n");
	return 1;
  }
}

int c_seien(string str)
{
  if(str != "beruhigt")
  {
	notify_fail("Was moechtest Du sein?\n");
	return 0;
  }
  else
  {
	write(BS("Du atmest tief ein, und bist jetzt noch beruhigter als "
		  "vorher."));
    say(CTPN+ " ist jetzt total entspannt.\n");
	return 1;
  }
}

