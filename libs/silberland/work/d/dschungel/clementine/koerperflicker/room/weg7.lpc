
inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../dante.h"


void create()
{

  ::create();

  SetProp(P_INT_SHORT, "Im Dschungel");
  SetProp(P_INT_LONG, 
    "Meterhohe Urwaldriesen und dichtestes Buschwerk wuchern hier regelrecht "
    "entlang des schmalen Trampelpfades. Es sieht so aus, als wuerde er "
    "in westlicher Richtung noch tiefer in den Dschungel hineinfuehren. "
    "Die Pflanzenvielfalt an diesem Ort erscheint Dir wirklich einmalig. "
    "Noch nie zuvor hast Du soviel unterschiedlich bluehendes Gruenzeug "
    "gesehen. Die vielen verschiedenen Farben erinnern an einen Regenbogen "
    "aus 1001 Nacht. ");
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);

  AddExit( "suedosten", ROOM "weg6");
  AddExit( "westen", ROOM "weg8");

  AddDetail( ({ "1001 nacht", "nacht", "1001" }),
    "Na jetzt bekomm mal keine Hoehenfluege! Schliesslich steckst Du nicht in "
    "1001 Nacht, sondern im Schlamm. Und dieser hier koennte dem, vom Buschklo "
    "des Doktors wirklich Konkurrenz machen. ");

  AddDetail( ({ "buschklo", "klo" }),
    "Huch! Dort ist ja gar kein Schlamm, sondern etwas anders Braeunliches. "
    "Da kannst Du einmal sehen in welcher Sch***** Du hier stehst. ");

  AddDetail( ({ "doktor", "dr" }),
    "Es ist keiner hier. Oder siehst Du etwa einen? Vielleicht haettest Du "
    "diese gruenen Pillen nicht schlucken sollen. ");

  AddDetail( ({ "pillen" }),
    "Du hast doch Dr. Koerperflicker nicht das Viagra weggenommen und "
    "geschluckt? Wie soll er denn jetzt seine Gerda gluecklich machen? ");

  AddDetail( ({ "koerperflicker", "axel" }),
    "Hoffentlich erwischt er Dich nicht! ");

  AddDetail( ({ "gerda" }),
    "Tja, Gerda ist jung. Die hat noch Ansprueche! Und Axel Koerperflicker "
    "ist ja doch schon etwas betagt. In dem Alter muss man halt einfach "
    "nachhelfen! ");

  AddDetail( ({ "viagra" }),
    "Sei brav und leg es zurueck! "); 
 
  AddDetail( ({ "braeunliches", "braunes", "scheisse", "sch", "sch*****" }),
    "So genau wollen wir auf das doch nicht eingehen! Pfuigacki! ");

  AddDetail( ({ "pfuigacki" }),
    "Geh doch ins Buschklo forschen! Lecker! ");

  AddDetail( ({ "alter" }),
    "Dr. Koerperflicker ist doch schon etwas aelter - ein Greis sozusagen. ");

  AddDetail( ({ "greis" }),
    "Jaja, als er noch jung war, da trug er damals auch so eine tolle "
    "Foehnwelle. ");

  AddDetail( ({ "foehnwelle" }),
    "Schick! Wirklich sehr schick!" );

  AddDetail( ({ "ansprueche" }),
    "GROSSE - SEHR SEHR GROSSE! ");

  AddDetail( ({ "hoehenfluege", "fluege" }),
    "Bei sowas kann man wirklich tief fallen! ");

  AddDetail( ({ "konkurrenz" }),
    "Du hast selten soetwas Widerliches gesehen! Aber anscheinend gedeihen "
    "die Pflanzen hier genau deswegen so gut. ");

  AddDetail( ({ "widerliches" }),
    "Wie wuerdest Du diesen Untergrund nennen, in dem Deine Fuesse irgendwie "
    "festzustecken scheinen? ");


  AddDetail( ({ "regenbogen" }),
	"Schoene kraeftig verschieden leuchtende huebsche einmalig tolle "
	"megamaessig geile einfach geniale Farben findest Du hier in der "
	"Pflanzenwelt vertreten. ");


  AddDetail( ({ "schlamm" }),
    "Boah ist das ekelig. Und Deine Fuesse stecken mittendrin!");

  AddDetail( ({ "fuesse" }),
    "An Deiner Stelle wuerd ich die mal wirklich richtig gut waschen!");

  AddDetail( ({ "stelle" }),
    "Ekelhaft! Und wie das stinkt!");

  AddDetail( ({ "ort" }),
    "Der Ort ansich ist ja sehr schoen, aber dieser Boden!!");

  AddDetail( ({ "boden" }),
    "Boah, wo bist Du denn hier reingeraten?");

  AddDetail( ({ "richtung", "frage" }),
    "Suedosten oder Westen - das ist hier die Frage.");

  AddDetail( ({ "suedosten", "westen" }),
    "Egal welche Richtung, hauptsache weg von hier, oder?!");

  AddDetail( ({ "gruenzeug", "zeug" }),
    "Soviel Gruenzeug! Pflanzenfressende Tiere fuehlen sich hier sicher "
    "wie im Himmel. ");

  AddDetail( ({ "tiere", "tier" }),
    "Ausser einem Schwarm Fliegen kannst Du keine entdecken. ");

  AddDetail( ({ "schwarm" }),
    "Ein Schwarm sind viele von den Viechern auf einmal. ");

  AddDetail( ({ "viecher", "fliegen", "viechern", "fliege" }),
    "Laestige Zeitgenossen. ");

  AddDetail( ({ "zeitgenossen", "zeitgenosse" }),
    "Pass lieber auf, dass sie Dich nicht mit irgendwelchen seltsamen "
    "Krankheiten anstecken. ");

  AddDetail( ({ "krankheiten", "krankheit" }),
    "Malaria, Syphilis, ...");

  AddDetail( ({ "malaria", "syphilis" }),
    "_Noch_ hast Du ja hoffentlich nichts!");

  AddDetail( ({ "pfad", "trampelpfad" }),
    "Trampelpfad ist hier wohl eher ironisch gemeint. Du steckst eher in "
    "der braunen Masse unter Dir, als darauf zu trampeln. ");

  AddDetail( ({ "masse" }),
    "Igitt!");

  AddDetail( ({ "himmel" }),
    "Vor lauter Pflanzen sieht man den Himmel nicht richtig. ");

  AddDetail( ({ "farben" }),
    "Vorallem siehst Du hier eine Farbe - gruen!");

  AddDetail( ({ "gruen" }),
    "Gruen ist gruen!");

  AddDetail( ({ "farbe" }),
    "Gruen gruen gruen ist alles was ich habe! Gruen gruen gruen ist alles "
    "was ich will - darum lieb ich alles was so gruen ist, weil mein "
    "Schatz ein Dschungelbuddler ist. ");

  AddDetail( ({ "schatz", "dschungelbuddler" }),
    "Genauer moechtest Du nicht wissen, was Dein Schatz im Dschungel so "
    "herausbuddelt. ");

  AddDetail( ({ "pflanzenvielfalt", "pflanzen", "pflanzenwelt" }),
    "Die Pflanzenvielfalt hier ist wirklich einmalig. Es scheint wohl ein "
    "ausgesprochen gut geduengter Boden hier zu sein. ");

  AddDetail( ({ "urwaldriesen", "riesen" }),
    "Die Urwaldriesen stehen dicht an dicht hier. ");

  AddDetail( ({ "busch", "buschwerk", "buesche" }),
    "Alles waechst hier ganz dicht aneinander. ");

  AddDetail( ({ "dschungel" }),
    "Du stehst doch gerade im Dschungel! Schau Dich doch um!");

  AddDetail( ({ "untergrund" }),
    "Irgendwie ist der Untergrund von aeusserst weicher Konsistenz. ");

  AddDetail( ({ "konsistenz" }),
    "Genaueres moechtest Du irgendwie gar nicht mehr wissen. ");

//Smells

  AddSmell(DEFAULT_SMELL,
    "Besonders gut riecht es hier nicht. Beim naechsten Mal solltest Du "
    "wohl besser Riechsalz mitnehmen. ");

  AddSmell( ({ "riechsalz" }),
    "Sicherlich ein angenehmerer Duft als das was Du hier so riechst. ");

  AddSmell( ({ "duft" }),
    "Duften tut hier eigentlich gar nichts. Es stinkt einfach!");

  AddSmell( ({ "mal" }),
    "Meinst Du wirklich erriechen zu koennen wann Du das naechste Mal "
    "hier her kommst?");


//Sounds

  AddSound(DEFAULT_SOUND,
    "Ganz deutlich hoerst Du das Surren eines Schwarm Fliegens. Ekelig!");

  AddSound( ({ "surren" }),
    "So richtig nervig!");

  AddSound( ({ "schwarm", "fliegen", "fliege" }),
    "Das Surren der Fliegen nervt Dich hier wirklich schwer. ");

//Cmds

  AddCmd( ({ "wasch", "wasche" }), "c_waschen");

}

int c_waschen(string str)
{
	if(str != "fuesse"  &&
	   str != "fuss"   )
	{
		notify_fail("Was moechtest Du waschen?\n");
		return 0;
	}
	else
	{
		write(BS("Womit denn? Mit dem Schlamm hier?! Geh "
			"gefaelligst wohin, wo Du sauberes Wasser bekommst!"));
		return 1;
	}
}

