
inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../dante.h"


create()
{

::create();

  SetProp(P_INT_SHORT, "Im Dschungel");
  SetProp(P_INT_LONG, 
	  "Zwischen dem eintoenigen Gruen findest Du hier doch tatsaechlich das "
	  "frisches strahlendes Gelb einer Bananenstaude, deren reife Fruechte "
	  "Dich anlachen. Die schmecken sicher total lecker! In nordoestlicher "
	  "Richtung scheint sich die dichte Dschungelvegetation langsam zu "
	  "lichten, zumindest wird der Pfad der dorthin fuehrt wieder etwas "
	  "breiter. Am Wegrand steht eine grosse Blume. " );
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);

  AddExit( "westen", ROOM "weg11");
  AddExit( "nordosten", ROOM "weg13");

}

