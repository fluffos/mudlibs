
inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../dante.h"


create()
{

::create();

  SetProp(P_INT_SHORT, "In einem Flur");
  SetProp(P_INT_LONG,
    "Ein weissgetuenchter Flur, der mal wieder gestrichen werden sollte. An "
    "einigen Stellen kann man Fingerabdruecke erkennen, als wollte sich "
    "jemand festkrallen, um dem Operationssaal zu entkommen. Auf dem "
    "Boden liegt eine alte Bambusmatte, unter die sicherlich schon jede "
    "Menge Staub und Dreck gekehrt wurde. Von Osten dringt ein "
    "ranzig, suesslicher Geruch in Deine Nase. "); 
  SetProp(P_LIGHT, 1);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);

  AddExit( "osten", ROOM "op");
  AddExit( "westen", ROOM "buero");
  AddExit( "norden", ROOM "privat");
  AddExit( "sueden", ROOM "warte");


// DETAILBEGINN

  AddDetail( ({ "flur" }),
    "Der Flur ist in weiss gehalten, zumindest war das einmal so. "
    "Mittlerweile hat sich das Weiss eher in ein Nikotingelb verwandelt, "
    "und lechzt nur so nach einem neuen Anstrich. ");

  AddDetail( ({ "anstrich" }),
    "Der waere wirklich dringendst notwendig. ");

  AddDetail( ({ "op-saal", "operationssaal", "op", "operationsraum" }),
    "Er scheint sich im Osten zu befinden. Zumindest deuten die Kratzspuren "
    "an der Wand darauf hin. ");

  AddDetail( ({ "nikotingelb", "gelb" }),
    "Ein wirklich huebscher Farbton. So muessen die Zaehne eines "
    "Rauchers aussehen, wenn er sich dieselbigen zwei Jahre nicht geputzt hat. "
    "Mjam! Lecker!");

  AddDetail( ({ "raucher" }),
    "So genau wolltest Du das nicht wissen...");

  AddDetail( ({ "jahre", "jahr" }),
    "Der letzte Anstrich ist sicherlich schon Jahre her. Und wann hast "
    "Du eigentlich das letzte mal Zaehne geputzt?!");

  AddDetail( ({ "zaehne", "zahn" }),
    "Allein bei dem Gedanken daran graust Dir.");

  AddDetail( ({ "gedanke", "gedanken" }),
    "Nur nicht dran denken, vielleicht geht das Ekelgefuehl dann wieder "
    "weg. ");

  AddDetail( ({ "ekel", "ekelgefuehl", "gefuehl" }),
    "Brrrr!");

  AddDetail( ({ "farbton", "ton", "farbe" }),
    "Ein total huebsches Nikotingelb. ");

  AddDetail( ({ "osten" }),
    "Scheinbar befindet sich im Osten der Operationssaal. Kannst ja mal "
    "nachschauen gehen. ");

  AddDetail( ({ "sueden" }),
    "Im Sueden kommst Du zurueck in das Wartezimmer. ");

  AddDetail( ({ "wartenzimmer" }),
    "Das ist im Sueden. ");

  AddDetail( ({ "zimmer" }),
    "Welches Zimmer meinst Du?!");

  AddDetail( ({ "norden", "westen" }),
    "Geh halt dorthin, wenn Du wissen moechtest, was dort ist. ");

  AddDetail( ({ "weiss" }),
    "Von dem einstmaligen Weiss des Flurs ist nicht mehr viel uebrig "
    "geblieben. ");

  AddDetail( ({ "dreck", "staub" }),
    "Unter die Bambusmatte wurde im Laufe der Zeit sicherlich schon sehr "
    "viel Dreck und Staub gekehrt. ");

  AddDetail( ({ "laufe", "zeit" }),
    "Wieviele Jahre die Matte hier schon liegt willst Du erst gar nicht "
    "wissen.");

  AddDetail( ({ "stellen", "stelle" }),
    "An einigen Stellen kaannst Du Fingerabdruecke erkennen - oder sollte "
    "man besser sagen Kratzspuren?!");

  AddDetail( ({ "fingerabdruecke", "abdruecke", "abdruck", "fingerabdruck" }),
    "Die Fingerabdruecke gleiche irgendwie eher richtigen Kratzspuren. Als "
    "ob sich hier jemand festkrallen wollte. ");

  AddDetail( ({ "jemand", "jemands" }),
    "Das muessen wohl mehrere Jemands gewesen sein. Denn Du siehst eigentlich "
    "ziemlich viele Kratzspuren. ");

  AddDetail( ({ "kratzspuren", "spuren", "kratzspur", "spur" }),
    "Du siehst hier einige tiefe Kratzspuren in der Wand. Irgendwas "
    "bestialisch Boeses scheint wohl im Osten zu sein. ");

  AddDetail( ({ "boeses", "boese" }),
    "Das Boese heisst Dr. Axel Koerperflicker und uriniert aeh ordiniert "
    "regelmaessig im Osten. ");

  AddDetail( ({ "axel", "doktor", "dr", "dr.", "koerperflicker", 
    "dr. axel koerperflicker", "axel koerperflicker" }),
    "Sueden, sueden. Und Du stehst vor ihm. Willst Du das wirklich?! ");

  AddDetail( ({ "matte", "bambusmatte" }),
    "Eine alte Bambusmatte liegt auf dem Boden. Dient wohl als so eine "
    "Art Teppich. Scheinbar befindet sich schon ziemlich viel Dreck darunter, "
    "denn sie hat bereits seltsame Woelbungen. Aber ob Du wirklich wissen "
    "moechtest, was darunter fuer Leichen begraben sind ist fraglich. ");

  AddDetail( ({ "teppich" }),
    "Statt eines Teppichs liegt eine alte Bambusmatte auf dem Boden und soll "
    "wohl die gleiche Funktion erfuellen. ");

  AddDetail( ({ "funktion" }),
    "Die Funktion eines Teppichs bzw. dieser Matte ist es auf dem Boden zu "
    "liegen, und zertrampelt zu werden. Weil schoen aussehen, ist wirklich "
    "was anderes! ");

  AddDetail( ({ "woelbung", "woelbungen" }),
    "Da scheint wohl wirklich ziemlich viel druntergekehrt worden zu sein. ");

  AddDetail( ({ "leichen", "leiche" }),
    "Na wer weiss, was da drunter liegt!");

  AddDetail( ({ "boden" }),
    "Der Boden befindet sich unter Deinen Fuessen und ist nicht gerade "
    "sauber. Auf ihm liegt eine haessliche Bambusmatte. ");

  AddDetail( ({ "art" }),
    "Sowas in der Art halt. ");

  AddDetail( ({ "fuesse", "fuss" }),
    "Wenn der Boden unter Deinen Fuessen ist, sind Deine Fuesse natuerlich "
    "auch unter Dir :)");

  AddDetail( ({ "menge" }),
    "Sicherlich ziemlich viel!"),

  AddDetail( ({ "nase" }),
    "Deine Nase hast Du zum Riechen! Also tu das bitte auch!");

  AddDetail( ({ "riechen" }),
    "Neeeeeeeeeeeeeeeein, doch nicht 'Riechen' untersuchen! Tu das doch "
    "einfach!");

  AddDetail( ({ "waende", "wand" }),
    "Die Waende sehen fuer Waende ziemlich normal aus. Ein neuer "
    "Anstrich waere mal wieder notwendig, und vielleicht sollte sich auch "
    "mal wer erbarmen, um die unzaehligen Kratzspuren zuzuspachteln. ");

  AddDetail( ({ "geruch" }),
    "Riecht bestialisch!");

  AddDetail( ({ "decke" }),
    "Die Decke ist hoch ueber Dir, und sieht ziemlich deckenartig aus. ");

// DETAILENDE


// SOUNDS

  AddSound(DEFAULT_SOUND, "Aus dem Osten kommt ein leises Wimmern. ");

  AddSound( ({ "wimmern" }),
    "Es kommt aus dem Osten. ");

  AddSound( ({ "osten" }),
    "Ein Wimmern kommt aus dem Osten. ");


// SMELLS

  AddSmell(DEFAULT_SMELL, "Aus dem Osten weht ein leicht ranziger, "
    "suesslicher Geruch. ");

  AddSmell( ({ "geruch" }),
    "Nicht gerade umwerfend was Du da einatmest. ");

  AddSmell( ({ "blut" }),
    "Obs ueberhaupt Blut ist? ");



       

 
 
  AddCmd( ({ "streich", "streiche" }), "c_streichen");  // waende

//  AddCmd( ({ "spachtel", "spachtl", "spachtle" }), "c_spachteln"); //kratzspuren zu

}

int c_streichen(string str)
{
 if(str != "waende"     &&
    str != "waende neu" &&
    str != "waende an"   )
 {
   notify_fail("Was moechtest Du hier anstreichen?\n");
   return 0;
 }
 else
 {
   write(BS("Du hast ja nicht mal die passende Farbe dabei. Also womit "
     "willst Du denn streichen?!"));
   say(BS(CTPN+" solltest Du besser aus dem Weg gehen, "+TP->QueryPronoun(WER)+
     " scheint geistig verwirrt zu sein."));  
   return 1;
 }
}

