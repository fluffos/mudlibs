
inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../dante.h"


void create()
{

  ::create();

  SetProp(P_INT_SHORT, "Im Dschungel");
  SetProp(P_INT_LONG, 
    "Die Vegetation um Dich herum ist ziemlich dicht und artenreich. "
    "Selbst auf dem Boden gedeiht alles so praechtig, dass es Dir "
    "schwer faellt Dich in irgendeine Richtung durchzuschlagen. "
    "Ueberall wachsen bunte Blumen und Pflanzen, die Du nie zuvor in Deinem "
    "Leben erblickt hast. Dutzende von Klettergewaechsen ranken sich an "
    "den riesigen Urwaldriesen hoch, die rundherum stehen. In westlicher "
    "Richtung scheint sich das Dickicht etwas zu lichten, nach Nordosten "
    "hingegen erscheint Dir alles nur noch undurchdringlicher, als es jetzt "
    "schon ist. ");
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);

  AddExit( "westen", ROOM "weg2");
  AddExit( "nordosten", ROOM "wir");



//DETAILBEGINN

  AddDetail( ({ "dschungel", "urwald" }), QueryProp(P_INT_LONG));

  AddDetail( ({ "vegetation" }),
    "Die Vegetation ist dicht und artenreich. Man kann kaum noch den Weg "
    "erkennen. ");

  AddDetail( ({ "weg" }),
    "Obwohl man kaum den Boden unter den Fuessen erkennen kann, schlaegst "
    "Du Dich wacker durch den Dschungel. ");

  AddDetail( ({ "fuesse", "fuss" }),
    "Hohes Gras, viele Schlingpflanzen, Straeucher und sonstige Pflanzen "
    "befinden sich unter, ueber und seitlich Deiner Fuesse. ");

  AddDetail( ({ "gras" }),
    "Das Gras ist sehr hoch in diesem Teil des Dschungels. ");

  AddDetail( ({ "teil" }),
    "Schoen hier, oder etwa nicht?");

  AddDetail( ({ "pflanzen", "pflanze" }),
    "Hier gibt es ueberall Pflanzen. Meinst Du eine bestimmte?");

  AddDetail( ({ "schlingpflanzen", "schlingpflanze" }),
    "Schlingpflanzen ranken sich hier ueberall in die Hoehe um etwas "
    "Licht zu erhaschen. Die Baeume und Straeucher sind ueberwuchert von "
    "ihnen. ");

  AddDetail( ({ "licht" }),
    "Ganz weit oben meinst Du durch das dichte Blaetterdach etwas "
    "Licht ausmachen zu koennen. Sehr spaerlich dringt es bis zu Dir auf den "
    "Boden. ");

  AddDetail( ({ "blaetterdach" }),
    "Ganz hoch oben scheinen die Baeume und Pflanzen ein dichtes "
    "Blaetterdach zu bilden. Es kommt kaum Licht bis zu Dir. ");

  AddDetail( ({ "dach" }),
    "Meinst Du das Blaetterdach?");

  AddDetail( ({ "hoehe" }),
    "Dutzende von Schlingpflanzen und Klettergewaechsen versuchen sich an "
    "den grossen Urwaldriesen in die Hoehe zu ranken. ");

  AddDetail( ({ "urwaldriesen", "riesen", "baeume" }),
    "Riesige Baeume stehen rundherum von Dir. Sie sind dicht mit allen "
    "moeglichen Pflanzen bewachsen. ");

  AddDetail( ({ "westen" }),
    "Im Westen scheint sich die Vegetation etwas zu lichten. ");

  AddDetail( ({ "nordosten" }),
    "Nach Nordosten scheint alles nur noch undurchdringlicher zu werden. ");

  AddDetail( ({ "boden" }),
    "Vor lauter Gewaechsen kannst Du den Boden unter Dir kaum erkennen. ");

  AddDetail( ({ "gewaechse", "gewaechs" }),
    "Unzaehlige Gewaechse gedeihen hier. ");

  AddDetail( ({ "himmel" }),
    "Vor lauter Pflanzen laesst sich der Himmel hoch ueber Dir nur erahnen. "); 

  AddDetail( ({ "straeucher", "strauch" }),
    "Die verschiedensten Straeucher wachsen um Dich herum. Alle gedeihen "
    "praechtig. ");

  AddDetail( ({ "dickicht" }),
    "Nur im Westen scheint sich das Dickicht des Dschungels etwas zu "
    "lichten. Sonst steht hier Pflanze an Pflanze, Strauch an Strauch, "
    "Baum an Baum. ");

  AddDetail( ({ "baum" }),
    "Hier stehen wahnsinnig viele Baeume. Alle mehrere Meter hoch und von "
    "Pflanzen bewachsen. ");

  AddDetail( ({ "meter" }),
    "Wirklich riesenhoch!");

  AddDetail( ({ "leben" }),
    "Du hast ja schon sehr viel in Deinem silberlaendischen Leben gesehen, "
    "aber hier wachsen Pflanzen, die Du davor noch nie erblickt hast. ");

  AddDetail( ({ "klettergewaechse", "klettergewaechs" }),
    "Unzaehlige Kletterpflanzen erkaempfen sich den Weg ueber Baeume, "
    "Straeucher und sonstige Pflanzen. ");

  AddDetail( ({ "kletterpflanze", "kletterpflanzen" }),
    "Es sind soviele, dass es unmoeglich erscheint sie alle zu zaehlen. ");
  
  AddDetail( ({ "blumen" }),
    "Ueberall wachsen bunte Blumen und andere Pflanzen. ");

  AddDetail( ({ "richtung" }),
    "Es ist schwierig hier voranzukommen. ");

  AddDetail( ({ "insekten", "insekt" }),
    "Einige schwirren in der Luft, andere krabbeln am Boden. ");

  AddDetail( ({ "luft" }),
    "Die Luft ist feucht. Unzaehlige Insekten tummeln sich bei den Blueten "
    "der Blumen. ");

  AddDetail( ({ "blueten", "bluete" }),
    "Sie sind alle sehr farbenfroh und locken Insekten an. ");

//Smells

  AddSmell(DEFAULT_SMELL,
    "Es duftet hier herrlich nach Blumen. ");

  AddSmell( ({ "blumen", "blume" }),
    "Mhmm. Lecker! Riecht verfuehrerisch!");

//Sounds

  AddSound(DEFAULT_SOUND,
    "Du bist von einem Summen und einem Kreischen umgeben. ");

  AddSound( ({ "summen" }),
    "Das Summen scheint wohl von den zahlreichen Insekten zu kommen. ");

  AddSound( ({ "insekten", "insekt" }),
    "*summ* *summ* ");

  AddSound( ({ "kreischen" }),
    "Du vermutest, dass das Kreischen aus den Baumkronen kommt. ");

  AddSound( ({ "baumkronen", "baum", "baeume", "kronen" }),
    "Sicherlich sitzen unzaehlige Voegel in den Baumkronen. ");

  AddSound( ({ "voegel" }),
    "*krah* *krah* *kruh* *kruh* ");


//CMDS

  AddCmd( ({ "zaehl", "zaehle" }), "c_zaehlen");
  AddCmd( ({ "kletter", "klettere", "klettre" }), "c_klettern");
  AddCmd( ({ "erahne", "erahn" }), "c_erahnen" );



}

int c_zaehlen(string str)
{
	if(str != "kletterpflanzen" &&
	   str != "klettergewaechse" )
	{
		notify_fail("Was moechtest Du zaehlen? Etwa die "
				"Kletterpflanzen?\n");
		return 0;
	}
	else
	{
		write(BS("1, 2, 3, 4, 5, 6, 7, 7, 8, verdammt schon wieder "
					"verzaehlt... Es scheint "
					"sinnlos zu sein hier alles "
					"zaehlen zu wollen. "));
		return 1;
	}
}


int c_klettern(string str)
{
	if(str != "auf baum"  &&
	   str != "auf baum hinauf"  )
	{
		notify_fail("Moechtest Du etwa auf einen Baum klettern?\n");
		return 0;
	}
	else
	{
		write(BS("Schon nach einigen Zentimetern verlaesst Dich "
			"Deine Kraft und Du plumpst auf den Boden. "));
	        say(CTPN + " klettert ein Stueck auf einen Baum, plumpst "
				"aber relativ schnell wieder auf den "
				"Boden.\n");
		TP->do_damage(10);
		return 1;
	}
}


int c_erahnen(string str)
{
	if(str != "himmel" )
	{
		notify_fail("Was moechtest Du erahnen?\n");
		return 0;
	}
	else
	{
		write(BS("Durch das dichte Blaetterdacht kannst Du wirklich "
					"den Himmel erahnen. "));
		return 1;
	}
}
  

