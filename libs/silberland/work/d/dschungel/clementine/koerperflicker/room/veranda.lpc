
inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../dante.h"


create()
{

::create();

  SetProp(P_INT_SHORT, "Auf einer Veranda");
  SetProp(P_INT_LONG,
    "Hier stehst Du auf Dr. Koerperflickers Veranda. Wie auch er, ist "
    "diese Veranda voller teurer Protzgegenstaende! Ein hightech "
    "Kokosnusstelefon, eine Schaukel aus natuerlich sehr seltenem, "
    "lindgruen, fast ausgerotteten Nebelbambus. Neben einer, aus "
    "feinstem Mahagoni gefertigten Tuer, haengt ein golden glaenzender "
    "Kaefig, in dem ein seltenes Exemplar des Xelapapageis herumflattert. "
    "Auf einem versilberten Tischchen liegt eine hoelzerne Dose. Noch immer "
    "prasselt der Regen, doch unter dem Dach der Veranda kannst Du muehelos "
    "im Freien sitzen, rauchen, reden und gluecklich in die Gegend schauen. ");
  SetProp(P_LIGHT, 1);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 0);

  AddExit( "norden", ROOM "warte");
  AddExit( "osten", ROOM "klo" );
  AddExit( "sueden", ROOM "weg6");

  AddItem(NPC "axel", REFRESH_DESTRUCT);
  AddItem(NPC "gerda", REFRESH_DESTRUCT);

// DETAILBEGINN

  
  AddDetail( ({ "veranda" }), QueryProp(P_INT_LONG) );

  AddDetail( ({ "tuer", "tuere" }),
    "Die Tuer wurde aus dem edelsten Mahagoni gefertigt, das Deine Augen "
    "je erblickt haben. Ein ziemlich grosses Schild wurde an der Tuer "
    "angebracht. ");

  AddDetail( ({ "schild" }),
    "Ein Schild aus Bambus, Du kannst es sicherlich lesen. ");

  AddReadDetail( ({ "schild" }),
    "***********************************\n"
    "*         Buschordination         *\n"
    "*               von               *\n"
    "*      Dr. A. Koerperflicker      *\n"
    "***********************************\n");

  AddDetail( ({ "mahagoni" }),
    "Obwohl es nur mehr sehr wenige Mahagoni-Baeume gibt, haelt dies "
    "Dr. Koerperflicker sicherlich nicht ab, dieses edle und teure Holz "
    "fuer seine Zwecke zu verwenden. ");

  AddDetail( ({ "dose" }),
    "Eine hoelzerne Dose liegt auf dem Tischchen. Ob man sie oeffnen kann? ");

  AddDetail( ({ "protzgegenstaende", "gegenstaende" }),
    "Ziemlich viele protzige Gegenstaende kannst Du hier finden. Abgesehen "
    "von der Schaukel aus Nebelbambus, und dem goldenen Kaefig, erregt das "
    "Kokosnusstelefon Deine Aufmerksamkeit. ");

  AddDetail( ({ "exemplar" }),
    "Eine wirklich seltene Papageienart. Es gibt nur mehr 2 Stueck davon "
    "auf der Welt. ");

  AddDetail( ({ "welt", "silberland" }),
    "Diese Welt heisst Silberland. ");

  AddDetail( ({ "stueck" }),
    "Bald wird es wohl nur mehr einen geben... ");

  AddDetail( ({ "papagei", "xelapapagei" }),
    "Der seltene Xelapapagei fristet sein Dasein in dem Kaefig. ");

  AddDetail( ({ "kaefig" }),
    "Ein goldener Kaefig, in dem der Papagei gefangen ist. ");

  AddDetail( ({ "himmel" }),
    "Den Himmel kannst Du wegen dem Dach nicht sehen. ");

  AddDetail( ({ "dach", "decke" }),
    "Ein stabiles Bambusdach, das Dich, Dr. Koerperflicker und Gerda "
    "vor dem Regen schuetzt. ");

  AddDetail( ({ "bambusdach" }),
    "Das Dach besteht, wie der Name schon sagt, aus Bambus. Dank des Daches "
    "kannst Du wunderbar im Freien sitzen, und wirst dennoch nicht nass. ");

  AddDetail( ({ "dr", "doktor", "koerperflicker", "axel" }),
    "Er ist sicherlich irgendwo in der Naehe. ");

  AddDetail( ({ "telefon", "nusstelefon", "kokosnusstelefon" }),
    "Ein hochmagisches Teil, mit dessen Hilfe Dr. Dante, aehm Koerperflicker "
    "mein ich natuerlich, seine imaginaeren, nach ihm lechzenden Maedchen "
    "anruft. ");

  AddDetail( ({ "maedchen" }),
    "Von denen scheint Dr. Koerperflicker eine ganze Menge zu haben, wenn "
    "auch nur in seinem Kopf?! ");
  
  AddDetail( ({ "dante" }),
    "Das war bloss ein freudscher Verschreiber. ");

  AddDetail( ({ "verschreiber" }),
    "Natuerlich war Dr. Koerperflicker gemeint, Dante ist dem doch nicht "
    "mal im geringsten aehnlich :) ");

  AddDetail( ({ "menge" }),
    "Viele. ");

  AddDetail( ({ "teil" }),
    "Das Telefon ist wirklich auf dem neuesten Stand der Technik. ");

  AddDetail( ({ "technik", "stand der technik", "stand" }),
    "Es ist einfach grossartig technisch. ");

  AddDetail( ({ "naehe" }),
    "Weit kann er nicht sein, da Gerda schliesslich hier ist. ");

  AddDetail( ({ "gerda" }),
    "Huch, wo ist sie? ");

  AddDetail( ({ "schaukel" }),
    "Eine lindgruene Schaukel aus Nebelbambus befindet sich hier. Ein "
    "grossartiges Geraet, und sicherlich nicht billig. Ob Du Dich auf sie "
    "setzen kannst, und schaukeln? ");

  AddDetail( ({ "geraet" }),
    "Naja, ne uebermaessig teure protzige Schaukel halt. ");

  AddDetail( ({ "nebelbambus" }),
    "Der Nebelbambus ist eine seltene Bambusart. Er wurde fast schon "
    "ausgerottet, so findet man nur noch wenige Exemplare davon im "
    "Dschungel. ");

  AddDetail( ({ "dschungel" }),
    "Der Dschungel umgibt Dich! ");

  AddDetail( ({ "bambusart" }),
    "Der Nebelbambus ist wirklich sehr selten. ");

  AddDetail( ({ "bambus" }),
    "Davon wirst Du hier sicherlich viel finden. ");

  AddDetail( ({ "dasein" }),
    "Der Papagei ist in seinem goldenen Kaefig gefangen, und wartet "
    "anscheinend nur auf den Tod. ");

  AddDetail( ({ "tod" }),
    "Der Tod kommt hier schneller, als Du denkst, schliesslich befindest "
    "Du Dich bei Dr. Koerperflicker. ");

  AddDetail( ({ "hilfe" }),
    "Wozu brauchst Du Hilfe? ");

  AddDetail( ({ "papageienart" }),
    "Eine seltene. ");

  AddDetail( ({ "exemplare" }),
    "Es gibt nicht mehr sehr viele davon. ");

  AddDetail( ({ "kopf" }),
    "Glaubst Du denn wirklich, dass der Doktor soviele Maedchen hat?\n"
    "Du bist lustig :)");

  AddDetail( ({ "holz" }),
    "Mahagoni ist wohl eines der edelsten und teuersten Hoelzer, aus "
    "denen man hier Tueren verarbeiten kann. ");

  AddDetail( ({ "hoelzer" }),
    "Seine wunderschoene Farbe verleiht allen Dingen, die aus diesem "
    "Holz verarbeitet wurden, einen strahlenden Glanz und eine "
    "bemerkenswerte Ausstrahlung. ");

  AddDetail( ({ "dingen", "ding" }),
    "Tueren, Fensterrahmen, ... ");

  AddDetail( ({ "fensterrahmen", "rahmen", "tueren" }),
    "Ueberleg doch selbst! ");

  AddDetail( ({ "glanz", "ausstrahlung" }),
    "Wirklich beeindruckend. ");

  AddDetail( ({ "farbe" }),
    "Ein kraeftiges Braun. ");

  AddDetail( ({ "braun" }),
    "Es ist kraeftig. ");

  AddDetail( ({ "zwecke" }),
    "Zum Anfertigen von Tueren.");

  AddDetail( ({ "anfertigen", "anfertigung" }),
    "Vielleicht solltest Du lieber Dr. Axel Koerperflicker danach fragen. ");

  AddDetail( ({ "baeume", "mahagonibaeume", "mahagoni-baeume" }),
    "Es gibt nur noch sehr wenige Baeume des Mahagonis, und dennoch "
    "wird er immer noch verarbeitet. ");

  AddDetail( ({ "aufmerksamkeit" }),
    "Wofuer Dr. K. wohl dieses Telefon benoetigt? Er hat doch sowieso "
    "alles hier, was er benoetigt. ");

  AddDetail( ({ "augen" }),
    "Deine Augen sind freilich wunderschoen, und haben ein beeindruckendes "
    "Strahlen, sodass sich jeder automatisch zu Dir hingezogen fuehlt... "
    "(oh Gott, ich schleim hier herum, bitte erloest mich jemand!) ");

  AddDetail( ({ "gott", "woody" }),
    "Woody ist Gott hier. "); 

  AddDetail( ({ "strahlen" }),
    "Magst Du wirklich, dass ich diese Schleimspur hier fortsetze? ");

  AddDetail( ({ "schleimspur" }),
    "Na gut. Deine Augen sind das Schoenste was ich je auf dieser Welt "
    "erblickt habe, abgesehen natuerlich von meinen, weil die sind "
    "viel viel viel viel viel umwerfender ;)");

  AddDetail( ({ "schoenste" }),
    "Bla bla, etc, sind wir dann fertig?! ");

  AddDetail( ({ "sitzen" }),
    "Unter dem Dach der Veranda kann man wunderbar im Freien sitzen, "
    "rumlabern, rauchen, und einfach nur in die Gegend schauen. Vielleicht "
    "solltest Du einmal hier herkommen, mit jemanden, den Du wirklich gerne "
    "hast. ");

  AddDetail( ({ "rauchen " }),
    "Vielleicht schenkt Dir Axel ja ein eingewickeltes Suchtmittel. ");

  AddDetail( ({ "regen" }),
    "Immer noch prasselt der Regen auf den Boden. "
    "Von allen Seiten dringt ein ruhiges Glucksen und Plaetschern an Dein "
    "Ohr, sodass Du sofort alles um Dich herum vergisst, und Dich auf einmal "
    "wohlig entspannt fuehlst. ");

  AddDetail( ({ "ruhe" }),
    "Die kannst Du nur spueren. ");

  AddDetail( ({ "tropfen" }),
    "Gleichmaessig platschen sie auf den Boden.\n"
    "*platsch* *platsch* ");

  AddDetail( ({ "ohr", "ohren" }),
    "Deine Ohren nehmen beeindruckende Geraeusche war. ");

  AddDetail( ({ "seiten" }),
    "Von ueberall. ");

  AddDetail( ({ "freien" }),
    "Im Regen unter einem Dach im Freien sitzen, rauchen, reden und "
    "gluecklich in die Gegend schauen mit einer Schlampe...\n"
    "Irgendwie kommt Dir der Satz sehr bekannt vor. ");

  AddDetail( ({ "schlampe" }),
    "Ist Gerda nicht hier?! ");

  AddDetail( ({ "satz" }),
    "Irgendwie hat der Satz etwas mit einem Magier zu tun. ");

  AddDetail( ({ "magier" }),
    "Wenn Du nur wuesstest, mit welchem. ");

  AddDetail( ({ "glucksen", "plaetschern", "prasseln", "geraeusch" }),
    "Lausch doch einmal! ");

  AddDetail( ({ "gegend" }),
    "Total friedlich liegt die ganze Gegend hier. Du kannst getrost "
    "gluecklich in die Gegend schauen. ");

  AddDetail( ({ "boden" }),
    "Der ganze Boden ist mit Zigarettenstummeln und Kapseln von "
    "Bierflaschen bedeckt. Gerda koennte ruhig mal etwas sauber machen! ");

  AddDetail( ({ "stummel", "stummeln", "zigarettenstummeln", 
                "zigarettenstummel" }),
    "Ueberall liegen sie auf dem Boden, Gerda sollte sich wirklich einmal "
    "darum kuemmern, und Ordnung machen. Aber anscheinend ist sie viel "
    "zu sehr mit Axel und sich selbst beschaeftigt... ");

  AddDetail( ({ "ordnung" }),
    "Ist hier wirklich einmal bitter noetig! ");
  
  AddDetail( ({ "kapseln" }),
    "Die sind ja wirklich ueberall! ");

  AddDetail( ({ "bierflaschen", "flaschen" }),
    "Keine zu sehen - momentan zumindest nicht. ");

  AddDetail( ({ "tischchen" }),
    "Ein versilbertes Tischchen steht neben der Schaukel; protzig wie alle "
    "anderen Gegenstaende hier. Eine Dose liegt auf ihm. ");


  AddSound( ({ "prasseln", "plaetschern", "glucksen" }),
    "Friedlich dringt das Geraeusch, dass die Tropfen machen, wenn sie "
    "auf den Boden platschen, an Dein Ohr. Du versinkst in eine "
    "wunderbare innere Ruhe und alles um Dich herum wird unwichtig. "
    "Wirklich herrlich hier! ");




  AddSpecialDetail( ({ "name" }), "namefunc");



  AddCmd( ({ "kletter", "klettere", "klettre" }), "c_klettern"); 
  AddCmd( ({ "schaukel", "schaukle", "schaukl" }), "c_schaukeln"); 
  AddCmd( ({ "spuere", "spuer" }), "c_spueren"); 
  AddCmd( ({ "oeffne" }), "c_oeffnen");
  AddCmd( ({ "befreie", "befrei" }), "c_befreien");  


}


namefunc(string str)
{
 return(BS("Dein Name ist "+CTPN +", nicht wahr?\n"));
}

int c_klettern(string str)
{
 if(str != "auf dach" &&
    str != "dach"     )
 {
  notify_fail("Worauf moechtest Du klettern?\n");
  return 0;
 }
 else
 {
  write(BS("Mit Hilfe einer imaginaeren Liane kletterst Du auf das Dach." ));
  return 1;
 }
}

int c_schaukeln(string str)
{
 if(str != "mit schaukel" )
 {
  notify_fail("Womit moechtest Du schaukeln?\n");
  return 0;
 }
 else
 {
  write("Du versuchst verfuehrerisch und anmutig auf dieser Edelschaukel zu "
        "schaukeln.\n" 
        "Leider rutscht Du fast runter, rammst das Tischchen "
        "und musst Dich krampfhaft\nan den Seilen festhalten.\n"
        "Waahhh! Lass die Zunge doch nicht so angestrengt raushaengen!\n"
        "Das ist so gar nicht sexy!!!\n"
        "Genervt stehst Du wieder auf.\n");
  say(CTPN+" schwingt sich anmutig auf die Schaukel und rammt erstmal "
             "das Tischen um!\n"
             "Grummelnd steht "+CTPN+" wieder auf.\n"
             "Du denkst Dir . o O (Komisch, Gerda scheint doch noch "
             "andere, ausser gewissen\n"
             "Qualitaeten zu haben, da das "
             "Schaukeln bei ihr so geil aussieht.)\n"); 
  return 1;
 }
}

int c_befreien(string str)
{
 if(str != "papagei"            &&
    str != "papagei aus kaefig" )
 {
  notify_fail("Wen willst Du befreien?\n");
  return 0;
 }
 else
 {
  write(BS("Du oeffnest die Kaefigtuer des Papageis. Er freut sich, und "
           "sieht die langersehnte Freiheit vor sich liegen. Dennoch fliegt "
           "er nicht davon. Er wird wohl immer im goldenen Kaefig "
           "sitzen bleiben - warum auch immer... "));
  return 1;
 }
}

int c_spueren(string str)
{
 if(str != "ruhe")
 {
  notify_fail("Was moechtest Du spueren?\n");
  return 0;
 }
 else
 {
  write(BS("Du spuerst tief in Dir ganz viel Ruhe und Geborgenheit aufkommen. "
           "Schade dass Du Dir normalerweise zu wenig Zeit fuer so etwas "
           "nimmst. "));
  return 1;
 }
}

int c_oeffnen(string str)
{
 if(str != "dose")
 {
  notify_fail("Was moechtest Du oeffnen?\n");
  return 0;
 }
 else
 {
  write(BS("Neugierig oeffnest Du die Dose, die Du allerdings sofort grummelnd "
           "wieder schliesst... Nichts als unbrauchbare Kruemeln eines Joints "
           "darinnen, dabei haette Dich Axel wenigstens mitrauchen lassen "
           "koennen. "));
  return 1;
 }
}

