// MANI - Ein von Dante aeh Axel verstuemmeltes Etwas

inherit "std/room";

#include "../dante.h"


void create()
{

  ::create();

  SetProp(P_INT_SHORT, "Im Dschungel");
  SetProp(P_INT_LONG, 
    "Das Knurren ist hier ueberdeutlich zu hoeren, ausserdem ist es "
    "in diesem Abschnitt des Dschungels um einiges dunkler als anderswo, "
    "richtig unheimlich. Die Luft ist stickig, es ist heiss und feucht. Nicht " 
    "gerade ein schoener Ort um eine Rast einzulegen. "
    "Im Norden stehen die Pflanzen zu dicht um weiter vorwaertszukommen - "
    "bleibt als einziger Ausweg wohl der Weg nach Suedosten. ");
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);

  AddExit( "suedosten", ROOM "weg4");


// DETAILBEGINN

  AddDetail( ({ "knurren", "geraeusch", "geraeusche" }),
    "Langsam solltest Du wissen, dass man Geraeusche wie das Knurren von "
    "Tieren, ... erlauschen sollte, und nicht untersuchen. ");

  AddDetail( ({ "norden" }),
    "Dichtes Pflanzenwerk steht im Norden, sodass man hier wirklich nicht "
    "mehr weiterkommt. ");

  AddDetail( ({ "ausweg" }),
    "Merk Dir schon mal den Weg nach Suedosten, wenns hart auf hart kommt, "
    "solltest Du hier naemlich schnell verschwinden. ");

  AddDetail( ({ "abschnitt" }),
    "Hier ist es deutlich duenkler, als im restlichen Dschungel. Die Baeume "
    "sind hoeher, ihr Blaetterwerk dichter, und irgendetwas wirft "
    "zusaetzlich noch einen grossen unheimlichen Schatten auf den Weg. ");

  AddDetail( ({ "dschungel" }),
    "Da stehst Du grad. ");

  AddDetail( ({ "tier" }),
    "Du kannst keines erkennen! Dafuer hoerst Du immer wieder ein "
    "unheimliches Knurren. ");

  AddDetail( ({ "suedosten" }),
    "Da kommst Du wieder auf einen breiteren Trampelpfad zurueck. ");

  AddDetail( ({ "etwas" }),
    "Du kannst nicht genau erkennen, was es ist.");

  AddDetail( ({ "pflanzen", "pflanzenwerk" }),
    "Die Pflanzen stehen hier dichter als anderswo. Ausserdem blueht hier "
    "irgendwie gar nichts? Ob es hier nur zu dunkel ist? Oder gibt es "
    "einen anderen Grund? ");

  AddDetail( ({ "grund" }),
    "Ersichtlich ist er irgendwie nicht. ");

  AddDetail( ({ "baeume", "baum" }),
    "Meterhohe Baeume stehen hier dicht gedraengt. Ihre Baumkronen und ihr "
    "Geaest verdecken fast den ganzen Himmel. Kaum ein Sonnenstrahl dringt "
    "zu Dir nach unten durch. ");

  AddDetail( ({ "sonnenstrahl", "strahl" }),
    "Kaum ein Sonnenstrahl dringt durch das dichte Blaetterwerk der "
    "Baeume bis zu Dir durch. Vielleicht solltest Du einfach mal hochhuepfen, "
    "damit Du mehr Sonne erhaschen kannst? "); 

  AddDetail( ({ "sonne" }),
    "Sie ist kaum zu sehen. ");

  AddDetail( ({ "schatten" }),
    "Irgendetwas ueber Dir wirft einen riesigen schwarzen Schatten auf den "
    "Dschungelboden. Ganz geheuer ist Dir das nicht. Vielleicht solltest Du "
    "einfach von hier verschwinden. Oder traust Du Dich nach oben zu "
    "blicken?");

  AddDetail( ({ "vorwaertskommen" }),
    "Wo willst Du denn vorwaertskommen?");

  AddDetail( ({ "kaefig" }), 
    "Der Kaefig ist halb provesorisch mit irgendwelchen Dschungelhoelzern "
    "zusammengeschustert. In ihm befindet sich ein in Lumpen gehuelltes "
    "Etwas, von dem auch das seltsame Knurren ausgeht. "
    "Er haengt weit ueber Dir in der Luft. Ob man ihn irgendwie "
    "herunterbekommt? ");

  AddDetail( ({ "seltsames" }),
    "Sieht fast so aus wie ein Seil. ");

  AddDetail( ({ "seil" }),
    "Ob man das Seil loesen kann?"); 

  AddDetail( ({ "boden", "dschungelboden" }),
    "Der Boden unter Dir ist relativ fest getrampelt. Nicht gerade hell hier, "
    "denn etwas wirft von oben einen grossen Schatten auf den Boden. ");

  

  AddCmd( ({ "huepf", "huepfe" }), "c_huepfen");
  AddCmd( ({ "blick", "blicke" }), "c_blicken");
  AddCmd( ({ "loese", "loes" }), "c_loesen");
  AddCmd( ({ "kletter", "kletter" }), "c_klettern");

}

int c_huepfen(string str)
{
	if(str != "hoch" )
	{
		notify_fail("Was moechtest Du machen? Hochhuepfen?\n");
		return 0;
	}
	else
	{
		write(BS("Beim Huepfen faellt Dir etwas Seltsames auf. "));
		return 1;
	}
}

int c_blicken(string str)
{
	if(str != "nach oben"   &&
	   str != "hoch"        )
	{
		notify_fail("Moechtest Du nach oben blicken?\n");
		return 0;
	}
	else
	{
		write(BS("Als Du nach oben blickst siehst Du einen "
			"seltsamen Kaefig ueber Dir baumeln. "));
		say(CTPN + " schaut irritiert nach oben.\n");
		return 1;
	}
}

int c_loesen(string str)
{

	if(str != "seil" )
	{
		notify_fail("Was moechtest Du hier loesen?\n");
		return 0;
	}
	else
	{
		write(BS("Lieber nicht! Oder willst Du, dass der Kaefig "
		"auf Deinen Kopf knallt? Man kann sicher noch etwas "
		"anderes mit dem Seil machen. "));
                say(CTPN + " fummelt an einem Seil herum.\n");
		return 1;
	}
}


int c_klettern(string str)
{
	if(str != "mit seil nach oben")
	{
		notify_fail("Was moechtest Du tun? Womit und wohin "
				"magst Du denn klettern?\n");
		return 0;
	}
	else
	{
		write(BS("Du kletterst an dem Seil nach oben. "));
		TP->move(ROOM "kaefig", M_GO, "klettert hoch", "klettert", 
			"klettert herein");
		return 1;
	}
}

