
inherit "std/obj";

#include "../marisol.h"


void create()
{
    
	if (!is_clone(this_object())) return;
	::create();
	
	SetProp(P_GEMDER, NEUTER);
	SetProp(P_SHORT, 0);
	SetProp(P_NEVERDROP, 1);
	SetProp(P_NODROP, 1);
	AddId (({"\nblut" }) );
	AddClass(CL_DISEASE);
	call_out("blut1", 50);
	SetProp(P_WEIGHT, 0);

}

blut1()
{
  if(!player) remove();
  write(BS("Du fuehlst Dich auf einmal ziemlich muede...\n"));
  say(CTPN+ " sieht ploetzlich ziemlich blass aus.\n");
  TP->do_damage(15);
  call_out("blut2", 10);
}

blut2()
{
  if(!player) remove();
  write(BS("Dein Arm blutet ziemlich stark, und gehoert versorgt!"));
  say(CTPN+ " blutet ziemlich stark.\n");	
  TP->do_damage(20);
  call_out("blut3", 13);
}

blut3()
{
  if(!player) remove();
  write(BS("Du presst Deine Finger auf die Wunde... AUA!!!\n"));
  TP->do_damage(10);
  call_out("blut4", 15);
}

blut4()
{
  if(!player) remove();
  write(BS("Puuh, nochmal Glueck gehabt!!! Die Wunde scheint sich zu "
		"schliessen.\n"));
  ME->remove();
  return 1;
}




