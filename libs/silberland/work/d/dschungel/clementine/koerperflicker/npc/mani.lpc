
inherit "std/npc";
inherit "std/npc/spells";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../dante.h"

create()
{
 if (!is_clone(this_object()))
 return;

  ::create();

  SetProp(P_SHORT, "Mani");
  SetProp(P_LONG,
    "Ein, in Fetzen und Lumpen gehuellter Mann, befindet sich in einem "
    "Kaefig vor Dir. Seine Arme und Beine wurden gefesselt, in seinem "
    "Mund befindet sich etwas Stoff, der anscheinend als Knebel dient. ");
  SetProp(P_NAME, "Mani");
  set_living_name("mani");
  AddId( ({ "mani", "mann" }) );
  SetProp(P_ARTICLE, 0);
  SetProp(P_GENDER, MALE);
  
  create_default_npc(10);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_SIZE, 185);
  SetProp(P_RACE, "Mensch");
  SetProp(P_NOATTACK, "versucht verzweifelt sinnvolle Worte aus seinem Mund "
                      "zu bekommen.");



}
 
