/****  DER NIX  ****

Lebt in einem Tropfen! Und kommt erst beim Forschen raus.
Versucht Wesen ins Wasser zu ziehen -> Kampf
*/

inherit "std/npc";
inherit "std/npc/spells";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include <class.h>
#include "../dante.h"


void create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Nix");
  SetProp(P_LONG,
    "Vor Dir steht ein Nix. Seine langen blonden Locken wallen ueber seine "
    "muskuloesen Schultern. Seine braungebrannte Haut schimmert magisch und "
    "fasziniert Dich. Er traegt eine Art Zipfelhose, die in den "
    "verschiedensten Blautoenen leuchtet. Seine stechenden gruenen Augen "
    "mustern Dich gespannt. Was fuer eine Erscheinung! ");

  SetProp(P_NAME, "Nix");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:30]));

  AddId(({"nix", "wassermann", "flussmann", "neck"}));
  AddClass(CL_FAIRY); // siehe /sys/class.h

  SetProp(P_RACE, "Wassermann");
  SetProp(P_SIZE, 180);
  SetProp(P_WEIGHT, 76000);

  SetProp(P_ALIGN, 350);
  SetProp(P_MAX_HANDS, 2);

  SetProp(P_INFO, "Man sollte sich hueten, schliesslich soll der Nix "
    "manchmal so launisch und wechselhaft wie sein Element das Wasser sein!\n");
 
  AddDetail( ({ "haut" }),
    "Die Haut des Nix schimmert magisch. ");

  SetProp(P_DIE_MSG,  " verschwindet in den Tiefen des Sees.\n");
  SetProp(P_NOCORPSE, 1 );

  AddInfo(DEFAULT_INFO, "singt nur leise vor sich hin.\n");

  SetProp(P_REJECT, ({ REJECT_DESTRUCT,
    "Der Nix versenkt Deine Sachen im See.\n" }) );

  create_default_npc(35);
  SetProp(P_HANDS, ({" mit Gesang an",QueryProp(P_HANDS)[1],DT_SOUND}));
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_RESISTANCE_STRENGTHS ,
    ([DT_FIRE:     -1.0, DT_COLD:     -1.0, DT_WATER: -1.0, DT_AIR:   -1.0,
      DT_LIGHTNING: 0.0, DT_EXPLOSION: 0.0, DT_SOUND:  0.0, DT_LIGHT:  0.0,
      DT_ELECTRIC: -0.5, DT_ACID:      0.0, DT_POISON: 0.0, DT_TERROR: 0.0,
      DT_HOLY:     -1.0, DT_UNHOLY:   -1.0, DT_MAGIC: -1.0 ]) );

  SetProp(P_SPELLRATE,25);

  AddDefaultSpell(1, 1, DS_MASS_DAMAGE,
    "Der Nix schlaegt wild um sich!\n",
    "Der Nix schlaegt wild um sich!\n");
    
  
  AddSpell(9, 320,
     "Der Nix versucht Dich mit einem Haken ins Wasser zu zerren.\n",
     "Der Nix versucht @WEM ins Wasser zu zerren.\n",
     DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]) );

  AddSpell(6, 240,
     "Der Nix spritzt Dir Wasser ins Gesicht.\n",
     "Der Nix spritzt @WEM Wasser ins Gesicht.\n",
     ({DT_WATER,DT_MAGIC}), "blind", ([SP_SHOW_DAMAGE:1]) );
		 

  AddSpell(4, 150,
    "Der Nix versenkt einen Teil Deiner Ausruestung im See.\n",
    "Der Nix versenkt einen Teil @WESSEN Ausruestung im See.\n",
    DT_MAGIC , "wegnehmen",  ([SP_SHOW_DAMAGE:1]) );

  AddSpell(1,1,
    Name(WER,1)+" beschwoert eine riesige Wasserwoge aus der Quelle.\n",
    Name(WER,1)+" beschwoert eine riesige Wasserwoge aus der Quelle.\n",
    DT_WATER, "spell_water"
  );

  SUID;
}

int ruestung_darf_weg(object ob)
{
  if( ob->QueryProp(P_CURSED))    return 0;
  if( ob->QueryProp(P_NEVERDROP)) return 0;
  if( ob->id("QUESTOBJ"))         return 0;
  if( ob->QueryProp(P_NODROP))    return 0;
  if(!ob->QueryProp(P_SHORT))     return 0;
  if( ob->QueryProp(P_INVIS))     return 0;
  if(!ob->QueryProp(P_NAME))      return 0;
 
/*  if(ob->QueryProp(P_ARMOUR_TYPE) == AT_ARMOUR) return 1;
  if(ob->QueryProp(P_ARMOUR_TYPE) == AT_CLOAK)  return 1;

  return 0;
*/
  return 1;
}

void wegnehmen(object enemy, int damage, mixed dam_type)
{
  object *ruestung;

  if(!interactive(enemy))                  return;
  if(ENV(TO) != ENV(enemy))                return;

  ruestung = filter_array(enemy->QueryProp(P_ARMOURS),"ruestung_darf_weg");

  if(sizeof(ruestung))
  {
    ruestung[0]->DoUnwear(1);
    if(ruestung[0]->move(ROOM "see", M_NOCHECK|M_SILENT));
    {
      	WLOG(LOG "nix.nimmt", "Nix nimmt sich "+ruestung[0]->name(WEN)+
                      " von "+TP->name(WEM));
    }
  }

  return;
}

  

void blind(object enemy, int damage, mixed dam_type)
{
 enemy->SetProp(P_BLIND, 1+random(3));
}


void spell_water(object enemy, int damage, mixed dam_type)
{

  enemy->ModifySkillAttribute(TO, SA_SPEED, 10, 10);
  enemy->Defend(300, dam_type, 0, TO);
}

int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  if(interactive(enemy) &&
     ((enemy->QueryProp(P_LEVEL)+10) < TO->QueryProp(P_LEVEL)))
  {
    write(BS("Werd' erst einmal gross!"));
    say(Name(WER,1)+" laechelt "+TPN+" freundlich an.\n");
    enemy->StopHuntFor(TO,1);
    StopHuntFor(enemy,1);
    return 0;
  }

  return ::Defend(dam,dam_type,spell,enemy);
}

die(int poisondeath)
{
	write_file(LOG "nix.kills", 
        dtime(time())+": "+CAP(getuid(TP))+" toetet Nix.\n");
	::die(poisondeath);
}


void NotifyPlayerDeath(object player, object killer, int lostexp)
{
	if( killer == TO )
    	write_file(LOG "nix.kills",
       	sprintf( ctime()+": Nix hat gerade  "+CAP(getuid(player))
       	+" umgebracht - %d EP!\n", lostexp));
 	return ;
}

