
inherit "std/npc";
inherit "std/npc/spells";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../dante.h"

create()
{
 if (!is_clone(this_object()))
 return;

  ::create();

  SetProp(P_SHORT, "Baldi Amputant (roechelnd)");
  SetProp(P_LONG,
    "Baldi Amputant liegt, eingewickelt in 100te Verbaende, vor Dir "
    "auf einem Bett. Von seinem rechten Arm geht ein seltsames "
    "schlauchartiges Etwas aus, dass zu einem Eimer, der an einem wackeligen "
    "Holzgestell baumelt, fuehrt. Anscheinend wurde er bereits mehrmals "
    "Opfer von Doktor Koerperflicker - da kommt wirklich jede Hilfe zu "
    "spaet. ");
  SetProp(P_NAME, "Baldi");
  set_living_name("baldi"); 
  SetProp(P_GENDER, MALE);
  AddId( ({ "baldi", "amputant", "baldi amputant" }) );
  SetProp(P_LOG_INFO, "/clementine/baldi");
  
  create_default_npc(10);
  SetProp(P_ARTICLE, 0);
  SetProp(P_ALIGN, 200);
  SetProp(P_RACE, "Mensch");
  SetProp(P_HEAL, -8);
  SetProp(P_HANDS, ({ " mit seinen Stummeln", QueryProp(P_HANDS)[1],
                      DT_BLUDGEON }) );
  SetProp(P_MAX_HANDS, 1);
  SetProp(P_RESISTANCE_STRENGTHS,
    ([ DT_MAGIC:0.5,
       DT_POISON:-1, DT_TERROR: -1,     DT_FIRE:0,         DT_WATER:0,
       DT_AIR:0,     DT_LIGHTNING:-0.5, DT_EXPLOSION:-0.4, DT_COLD:0,
       DT_SOUND:0,   DT_LIGHT:0,        DT_ELECTRIC:-0.5,
       DT_HOLY:0,    DT_UNHOLY:0, ]) );

  // SUID
  // CLONEME(ARMOUR "kittel");
  // CLONEME(ARMOUR "verband");
  // command("trage alles");

  SetProp(P_MURDER_MSG, "Danke!\n");
  SetProp(P_KILL_NAME, "Baldi Amputant");
  SetProp(P_KILL_MSG, "Erloest mich doch einmal jemand!\n");
  SetProp(P_DIE_MSG, " hickst ein letztes Mal.\n");

  SetProp(P_SPELLRATE, 60);
 
  AddSpell(1, 10,
     "Baldi versucht Dich mit seinem Stummel zu Boden zu werfen.\n",
     "Baldi versucht @WEM mit seinem Stummel zu Boden zu werfen.\n", 
     DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]) );

  AddSpell(1, 8,
     "Baldi Amputant kotzt Dir ueber die Fuesse.\n",
     "Baldi Amputant kotzt @WEM ueber die Fuesse.\n",
     DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]) );

  AddSpell(1, 12,
     "Baldi Amputant tritt Dir gegen Dein Schienbein.\n",
     "Baldi tritt @WEM gegen das Schienbein.\n",
     DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]) );

  SetChats(5, ({
     "Baldi Amputant roechelt mitleidserregend.\n",
     "Baldi roechelt wie ein Magier, wenn er bemitleidet werden moechte.\n",
     "Baldi Amuptant schreit vor lauter Schmerzen auf.\n",
     "Baldi hickst.\n",
     "Baldi Amputant erbricht in einen Nachttopf.\n",
     "Baldi zerfliesst in Selbstmitleid ueber seinen Schluckauf.\n",
     "Baldi Amputant schaut zu seinem Stummel und schluchzt.\n",
     "Baldi schimpft ueber Dr. Koerperflicker.\n",
     "Baldi Amputat verflucht Axel.\n",
     "Baldi jammert: Ach waere ich doch nie hergekommen...\n" }) );

  SetProp(P_DEFAULT_INFO, ({ "roechelt.\n",
                             "winselt mitleidig.\n",
                             "weint sich bei Dir aus.\n",
                             "verflucht Dr. Koerperflicker.\n",
                             "sabbert in seinen Kittel.\n",
                             "kratzt sich seinen Stummel blutig.\n" }) );


// INFOS !!!

  AddInfo( ({ "dante" }),
    "Dieser miese Halsabschneider!!! Nichts als Karriere im Kopf, und "
    "dann bei seinen Arbeitern die Gehaelter kuerzen, und sie versklaven!!!", 
    "sagt: ");

  AddInfo( ({ "axel", "dr", "doktor", "koerperflicker", 
              "axel koerperflicker", "doktor koerperflicker", 
              "dr koerperflicker", "dr. koerperflicker" }),
    "Dieser Moechtegernpseudoarzt!!!! Glaubt er ist der Beste auf der Welt, "
    "obwohl er noch nicht einmal einen Abschluss hat. Ich hab ihm vertraut! "
    "Ich kam lediglich wegen meines Schluckaufs her, und jetzt?! Sieh mich an! "
    "Ich hab nur mehr einen Arm, und verrecke hier vor mich hin, weil "
    "er lieber seiner Gerda auf den Po grapscht. ", "sagt: ");

  AddInfo( ({ "moppy", "clementine", "cleme", "tessa" }),
    "Tja, da hats der gute Dr. auch versaut. ", "sagt: ");

  AddInfo( ({ "gerda" }),
    "Frueher oder spaeter wird die ihm sicherlich auch davonlaufen!", "sagt: ");

  AddInfo( ({ "mani" }),
    "Mani ist eine gute Seele, leider redet er eindeutig zuviel. ", "sagt: ");

  AddInfo( ({ "titi", "titti", "titie", "tittie", "titania", "titipopsch" }),
    "grapscht Dir gierig auf Deinen Po. ");

  AddInfo( ({ "baldi" }),
    "Ja das bin ich. ", "sagt: ");

  AddInfo( ({ "sex" }),
    "Ja, da bist Du bei Dr. Koerperflicker an der richtigen Adresse. ", 
    "sagt: ");



}

