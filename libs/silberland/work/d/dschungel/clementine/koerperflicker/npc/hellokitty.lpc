inherit "std/npc";
inherit "std/npc/spells";

#include <class.h>
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../dante.h"




create()
{
 if (!is_clone(this_object()))
 return;

  ::create();
  SetProp(P_SHORT, "Eine Hello Kitty");
  SetProp(P_LONG,
    "Was zur Hoelle ist eine Hello Kitty?\n"
    "Ein absolutes Verbrechen an der Menschheit! Ein nervtoetendes "
    "miauendes weisses Etwas, in dessen Fell ein knallrosa Mascherl ist - "
    "genauso geschmacklos wie das Viech selbst. Man sollte ihm den Arsch "
    "versohlen, es blutig schlagen und ihm danach den Hals umdrehen.");
  SetProp(P_NAME, "Hello Kitty");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_ARTICLE, 1);
  create_default_npc(7);
  SetProp (P_SIZE, 30);
  SetProp (P_WEIGHT, 2000);

  SetProp(P_HANDS, ({ " mit ihren Krallen", QueryProp(P_HANDS)[1],
          DT_BLUDGEON }) );
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_ALIGN, 0);
  SetProp(P_RACE, "Katze");
  SetProp(P_XP, 0);
  SetProp(P_DIE_MSG, " verreckt endlich.\n");
  SetProp(P_MURDER_MSG, "Ich kehre samt rosa Schleife zurueck!\n");
		        

  AddId( ({ "katze", "hellokitty", "kitty" }) );
  AddId( ({ "FELL_WUSCHEL" }) );

  SetProp(P_MSGIN, "schleicht herein");

 SetProp(P_DEFAULT_INFO, "miaut Dich an.\n");
 SetProp(P_REJECT, ({ REJECT_DROP,
   "Eine Hello Kitty weicht Dir aus.\n" }) );

 AddDetail( ({ "mascherl"}),
   "\n"
   "                __                             ___            _aaaa \n"
