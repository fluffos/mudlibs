
inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>


create()
{
 if (!is_clone(this_object()))
 return;

  ::create();

  SetProp(P_SHORT, "Gerda, die Krankenschwester");
  SetProp(P_LONG,
    "Gerda, die vollbusige Krankenschwester steht vor Dir. Sie scheint "
    "Dr. Koerperflickers Assistentin zu sein, wobei Dich ihr Aussehen "
    "erkennen laesst, dass sie ihm nicht nur bei Operationen behilflich "
    "ist... Ihre ganze Aufmerksamkeit gilt neben Dr. Axel, nur ihrem "
    "Kittelchen, das sie immer wieder gekonnt einige Zentimeter nach oben "
    "schiebt. ");
  SetProp(P_NAME, "Gerda");
  AddId( ({ "gerda", "krankenschwester" }) );
  SetProp(P_GENDER, FEMALE);
  
  create_default_npc(20);
  SetProp(P_HANDS, ({ " mit ihren rot lackierten Fingernaegeln", 
          QueryProp(P_HANDS)[1], DT_BLUDGEON }) );
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_ALIGN, 0);
  SetProp(P_RACE, "Tussi");
  SetProp(P_ARTICLE, 0);
  SetProp(P_SIZE, 165);
  SetProp(P_NOATTACK, "ist doch ne Tusse! Und die schlaegt man "
     "bekanntlich nicht!");
  SetProp(P_REJECT, ({ REJECT_DROP,
    "Gerda ist viel zu sehr damit beschaeftigt, sich ihr Kittelchen "
    "zurechtzuzupfen.\n" }) );


// DETAILS

  AddDetail( ({ "kittelchen", "kittel" }),
    "Gekonnt schiebt Gerda es immer ein Stueckchen nach oben, damit man "
    "ihre Beine besser sehen kann... Oben ist es ausserdem ziemlich "
    "ausgeschnitten. ");

  AddDetail( ({ "titten", "brueste" }),
    "Riesiges Gebirgsmassiv tuermt sich vor Dir auf! Du verspuerst einen "
    "gewissen Kletterdrang... ");

  AddDetail( ({ "beine" }),
    "Mit ihren rasierten langen Beinen koennte sie muehelos den Koerper von "
    "Dr. Koerperflicker umschlingen. ");


// INFOS

  AddInfo( ({ "axel" }),
    "schiebt sich ihren Bh zurecht. ");

  AddInfo( ({ "doktor", "dr" }),
    "himmelt Dr. Koerperflicker an. ");

  AddInfo( ({ "koerperflicker" }),
    "Er ist ein so grossartiger Arzt. Er kann Dich von all Deinen Krankheiten "
    "und selbst Deinen Sehnsuechten befreien. ", "schwaermt: ");

  AddInfo( ({ "dante" }),
    "wackelt mit ihrem Popsch. ");

  AddInfo( ({ "tessa", "clementine" }),
    "Diese Trutsche wollte mir meinen Axel wegschnappen...", "sagt: ");

  AddInfo( ({ "liebe" }),
    "Ich weiss ganz genau, was wahre Liebe ist. ", "sagt: ");

}
