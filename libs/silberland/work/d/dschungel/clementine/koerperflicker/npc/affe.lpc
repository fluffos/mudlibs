inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include "../dante.h"

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein kleiner Affe");
  SetProp(P_LONG, 
    "Du siehst einen kleinen, froehlichen Affen vor Dir, der Dich "
    "freundlich und intelligent angrinst. Scheinbar gehoert das "
    "Exemplar vor Dir zu den Schimpansen. ");
  SetProp(P_NAME, "Schimpanse");
  SetProp(P_GENDER, MALE);
  AddId(({ "affe", "schimpanse", "\naffeoink" }));

  create_default_npc(12);
  SetProp(P_HANDS, ({" mit seinen kleinen Armen",120, DT_BLUDGEON}));
  SetProp(P_RACE, "Affe");
  SetProp(P_SIZE, 90);
  SetProp(P_ALIGN, 300);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_AGGRESSIVE,0);

  SetProp(P_MSGIN, "springt herein");

  SetProp(P_DIE_MSG,  " faellt tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0);
  SetProp( P_REJECT, ({ REJECT_KEEP,
    "Der Schimpanse laechelt freundlich.\n" }) );


  SetChats(4, ({
  "Der Schimpanse springt froehlich auf und ab.\n",
  "Der Schimpanse kratzt sich am Kopf.\n",
  "Der Schimpanse zieht an Deiner Kleidung.\n",
  "Der Schimpanse zieht an Deinen Haaren.\n",
  "Der Schimpanse furzt.\n",
  "Der Schimpanse macht einen Salto.\n",
  "Der Schimpanse grunzt laut.\n",
  "Der Schimpanse macht einen Purzelbaum.\n",
  "Der Schimpanse will mit Dir spielen.\n",
  "Der Schimpanse schubst Dich.\n",
  "Der Schimpanse macht einen Handstand.\n"}) );
  
  SetAttackChats(20, ({
  "Der Schimpanse beisst Dich..\n",
  "Der Schimpanse kratz Dich.\n",
  "Der Schimpanse beisst Dir in den Arm.\n",
  "Der Schimpanse schlaegt Dich zu Boden.\n",
  "Der Schimpanse spuckt Dich an.\n",
  "Der Schimpanse schreit: UGGA UGGA !!!\n"}) );
  
  SUID;
  CLONEME(ARMOUR "haube");
}

