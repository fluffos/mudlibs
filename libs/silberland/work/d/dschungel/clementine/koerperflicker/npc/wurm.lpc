
inherit "std/npc";
inherit "std/npc/spells";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>


create()
{
   if (!is_clone(this_object()))
	  return;

     ::create();

	   SetProp(P_SHORT, "Ein Wurm");
	   SetProp(P_LONG,
		   "Igitt! Ein kleiner glitschiger ekelhafter Wurm. ");
	   SetProp(P_NAME, "Wurm" );
	   set_living_name( "Wurm" );
	   SetProp(P_GENDER, MALE);
	   AddId( ({ "wurm" }) );

	   create_default_npc(5);
	   SetProp(P_RACE, "Insekt" );
	   SetProp(P_SIZE, 4);
	   SetProp(P_ALIGN, 200);
	   SetProp(P_HANDS, ({ " mit seinem glitschigen Koerper", 
			 QueryProp(P_HANDS)[1],	DT_BLUDGEON }) );

}

