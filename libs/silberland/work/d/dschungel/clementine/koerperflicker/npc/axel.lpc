
inherit "std/npc";

#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../dante.h"

create()
{
 if (!is_clone(this_object()))
 return;

  ::create();

  SetProp(P_SHORT, "Dr. Axel Koerperflicker");
  SetProp(P_LONG,
    "Vor Dir sitzt Dr. Axel Koerperflicker, der hiesige Arzt. Seine "
    "gruenen Augen mustern Dich von oben bis unten. Um seinen Hals baumelt "
    "ein Stetoskop, das beim Schaukeln gegen seinen nackten Oberkoerper "
    "schlaegt. Seine rechte Hand trommelt abwesend auf Gerdas Gesaess, "
    "waehrend er gelangweilt mit der linken sein eingewickeltes Rauchmittel "
    "zum Mund fuehrt. ");
  SetProp(P_NAME, "Axel");
  AddId( ({ "axel", "doktor", "dr", "koerperflicker", "dr.", "arzt",
            "axel koerperflicker", "dr. koerperflicker" }) );
  SetProp(P_GENDER, MALE);
  create_default_npc(20);
  SetProp(P_HANDS, ({ " mit seinen Oekoschlapfen",
          QueryProp(P_HANDS)[1], DT_BLUDGEON }) );
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_ALIGN, 0);
  SetProp(P_RACE, "Mediziner");
  SetProp(P_ARTICLE, 0);
  SetProp(P_SIZE, 178);
  SetProp(P_REJECT, ({ REJECT_DROP,
    "Dr. Koerperflicker haelt nicht viel von Geschenken.\n" }) );
  SetProp(P_NOATTACK, "lacht Dich aus.");
  
  SUID;
  CLONEME(ARMOUR "tschlapfen");
  CLONEME(ARMOUR "those");
  command("trage alles");
 
  
  AddDetail( ({ "augen" }),
    "");

  AddDetail( ({ "stetoskop" }),
    "");

  AddDetail( ({ "hand" }),
    "");

  AddDetail( ({ "rauchmittel" }),
    "");

  AddDetail( ({ "mund" }),
    "");

  AddDetail( ({ "hals" }),
    "");

  AddDetail( ({ "oberkoerper" }),
    "");

 
// INFOS !!!

  AddInfo( ({ "gerda" }),
    "");

  AddInfo( ({ "clementine", "cleme", "kleine" }),
    "");

  AddInfo( ({ "axel", "koerperflicker", "axel koerperflicker" }),
    "");

  AddInfo( ({ "doktor", "arzt", "dr.", "dr" }),
    "");

  AddInfo( ({ "tessa", "moppy" }),
    "");

  AddInfo( ({ "zarku" }),
    "");

  AddInfo( ({ "maenner" }),
    "");

  AddInfo( ({ "frauen" }),
    "");


}


// spells: Du denkst   . o O (axel versucht sich zu ducken, aber deine faust trifft ihn
//mitten ins gesicht)
//Du sagst: immer mitten in die fresse rein
//Du denkst   . o O (du bruellst)
//Du sagst: immer mitten in die fresse rein Du grinst.

