inherit "std/npc";
inherit "std/npc/spells";

hilfe();


#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../dante.h"

void create()
{
 if (!is_clone(TO))
 return;

  ::create();

  SetProp(P_SHORT, "Ina");
  SetProp(P_LONG, 
     "Das ist Ina.\n"
     "Ina ist buschig und hat definitiv Aehnlichkeit mit einem Hobbit.\n"
     "Sonderlich gepflegt sieht sie wirklich nicht aus und selbst beim "
     "Anblick schreit alles >BUERSTE MICH!<.\n" 
     "Sie scheint hart vom "
     "Schicksal getroffen worden zu sein. Vielleicht solltest Du Dich einfach "
     "naeher mit ihr unterhalten.\n");
  SetProp(P_NAME, "Ina");
  set_living_name( "ina");
  SetProp(P_ARTICLE, 0);

  SetProp(P_GENDER, FEMALE);
  SetProp(P_RACE, "Buschwerk" );
  AddId( ({ "ina", "busch" }) );
 
  create_default_npc(35);
  SetProp(P_ALIGN, 0);
  SetProp(P_BODY, 400);
  SetProp(P_FRIEND, 1);
  SetProp(P_SIZE, 163);
  SetProp(P_NOATTACK, "sagt: Du verfaengst Dich sonst im Busch!\n");
  SetProp(P_REJECT, ({ REJECT_KEEP, 
     "Ina sagt: Ich nehme alles!\n" }) );

  SetProp(P_LOG_INFO, "/clementine/ina");

  SetProp(P_DEFAULT_INFO, "sucht nach Essen.\n");

  AddInfo( ({ "hilfe" }), #'hilfe);


  

  AddCmd( ({ "biet", "biete" }), "c_bieten"); 
}

hilfe()
{
        if(!present(QUESTITEM, TP))
        {
                write("Ina sagt: Mein armer Mann...Baldi...*schluchz*...\n"
		      "Ina sagt: Er wurde von furchtbaren Schluckauf "
		      "gequaelt und hat sich deswegen\n" 
		      "Ina sagt: auf den Weg zu "
		      "Doktor Koerperflicker gemacht.\n" 
		      "Ina sagt: Aber anstatt meinem "
		      "Mann vom Schluckauf zu heilen,\n" 
		      "Ina sagt: moechte dieser ihm nun "
		      "beide Arme und Beine amputieren!\n"
		      "Ina schluchzt.\n"
		      "Ina fleht: Hilf mir bitte! Befreie meinen Baldi!\n");
		      
                return 1;

        }
        else
        {
                write("Ina fragt: Hast Du meinen Mann schon befreit?\n");
                return 0;
        }
}




void give_notify(object was)
{
 object qitem, seq;

 if(!was->id(QUESTMEMO)) return ::give_notify(was);
 
 if(!qitem=present(QUESTITEM,TP))
 {
         write(BS("Ina sagt: Du hilfst mir doch gar nicht!"));
         return ::give_notify(was);
 }

 if(qitem=present(QUESTITEM, TP))
 {
         write(BS("Ina sagt: Oh, herzlichen Dank!"));
         was->remove();
 qitem->remove();
 seq = clone_object(OBJ "seq");
 seq->move(TP,M_GET|M_NOCHECK);

 write_file(QUESTLOG "quest.log",
                 dtime(time())+": "+TPUID+" Fertisch!\n");
 return; 
}
}
int c_bieten(string str)
{
        object ob, koerperflickerquestitem;

        notify_fail("Moechtest Du jemandem Deine Hilfe anbieten?\n");

        if(str != "hilfe an" &&
           str != "ina hilfe an" &&
           str != "buschwerk hilfe an"  &&
           str != "busch hilfe an" )
        return 0;

        if(present(QUESTITEM,TP))
        {
                write(BS("Ina sagt: "
                         "Aber Du hilfst mir doch schon!" ));
                return 1;
        }
        if(TP->QueryQuest(QUESTNAME))
        {
                write(BS("Ina sagt: Du hast mir bereits geholfen. "
                         "Danke Dir vielmals! "));
                return 1;
        }

        koerperflickerquestitem = clone_object(OBJ "koerperflickerquest");
        if(!koerperflickerquestitem)
        {
                write(BS("Ina sagt: Gewitter im Busch! "
                         "Nerv Clementine bitte damit! " ));
                write_file(QUESTLOG "quest.log",
                dtime(time())+": "+TPUID+ " Clonen des QItems gescheitert.\n");
                return 1;
        }
        koerperflickerquestitem->move(TP,M_GET|M_SILENT);

        write("Ina sagt: Danke "+TP->Name()+"!\n"
              "Ina sagt: Bitte beeil Dich!\n" );
        return 1;
}

