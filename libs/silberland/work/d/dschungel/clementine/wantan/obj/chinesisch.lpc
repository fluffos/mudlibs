
inherit "std/thing";

#include <moredef.h>
#include <properties.h>

object owner;

void reset()
{
 remove();
}


create()
{
    if (!is_clone(this_object())) return;
	  ::create();

	SetProp(P_GENDER, NEUTER);
        SetProp(P_SHORT, 0);
        SetProp(P_NODROP, 1);
	SetProp(P_WEIGHT, 0);
	SetProp(P_AUTOLOADOBJ, 1);
	AddId( ({ "\nsprachfluch" }) );
        owner = 0;

}

init()
{
    ::init();
	if (owner && interactive(owner))
	{
		owner->SetProp(P_PERM_STRING, 0);
		owner=0;
	}
	if (environment()==TP)
	{
		owner=TP;
		owner->SetProp(P_PERM_STRING, this_object());
	}
}

string permutate_string (string str)
{
    string s;
	int i;
	s=str;
    for (i=strlen(s)-1; i>=0; i--)
	{
	if (s[i]=='R') s[i]='L';
	else if (s[i]=='r') s[i]='l';
	}
	return s;
    

}





