
inherit "std/food";

#include <properties.h>
#include <food.h>
#include "../dante.h"

#define NR_MELDUNGEN 20 
#define MELDUNGEN \
  ({ \
     "Clementine hat immel Lecht!", \
	 "Zum Reisen braucht man Schuhe, zum Scheissen braucht man Ruhe!", \
	 "Phantasie ist wichtiger als Wissen.", \
	 "Jedem das Seine, aber mir das Meiste!", \
	 "Was haeltst Du als Unbeteiligter vom Thema Intelligenz?", \
	 "Wer anderen eine Grube graebt...ist auf der Baustelle angestellt.", \
	 "Rettet den Wald - esst Biberfleisch!", \
	 "Bescheidenheit ist eine Zier, doch reicher wirst Du nur mit Gier.", \
	 "Wer zuletzt lacht, hat es einfach nicht frueher begriffen.", \
	 "Achte auf Deine Gedanken, sie sind der Anfang Deiner Taten.", \
	 "Strebe niemals nach den Dingen, die auch Duemmeren gelingen.", \
	 "Manchmal muss man verstummen, um gehoert zu werden.", \
	 "Was Du in anderen Menschen entzuenden willst, muss erst in Dir selbst "\
	 "brennen.",\
	 "Versuchungen sollte man nachgeben. Wer weiss, ob sie wiederkommen...", \
	 "Wenn Dummheit rollen wuerde, muesste man Dich den Berg hoch bremsen.", \
	 "Kuessen ist die schoenste Art, einer Frau das Maul zu stopfen.", \
	 "In der Nase bohren ist bei manchen die einzige Art, in sich zu gehen.", \
	 "Nieder mit der Schwerkraft - es lebe der Leichtsinn.", \
         "Kleine Bosheiten erhalten die Feindschaft.", \
         "Gluecklich ist, wer verfrisst, was nicht zu versaufen ist.", \
   })




create()
{
  if (!is_clone(ME)) return;
    ::create();

	AddId( ({ "glueckskeks", "keks" }) );
	SetProp(P_SHORT, "Ein Glueckskeks");
	SetProp(P_LONG, "Ein super toller Glueckskeks! Los iss ihn!");
	SetProp(P_NAME, "Glueckskeks");
	SetProp(P_VALUE, 10);
	SetProp(P_WEIGHT, 80);
	SetProp(P_NOBUY, 0);
	SetProp(P_MATERIAL, ({ MAT_MISC_FOOD }) );
    SetProp(P_GENDER, MALE);

    SetProp (P_FOOD_INFO, 
		([ F_HEAL     : 4,
		   F_SOAK     : 4, 
		   F_MSG      : "Du mampfst einen Glueckskeks. Mhmm! Lecker!",
		   F_MSG_ROOM : "mampft einen Glueckskeks."
		 ]) );

}

void BeimEssen()
{
    if (!TP) return;
	if (TP->QueryProp(P_BLIND))
		write(BS("Iirks, warum siehst Du bloss keinen Spruch?"));
	    
	else 
	{
	    write("\n");
		write("Huch, da ist ja auch ein Spruch drinnen!\n");
		write("\n");
		write("Du liest: "+MELDUNGEN[random(NR_MELDUNGEN-1)]+"\n");
	}
	return;
}


