void fluch(object enemy, int damage, mixed dam_type)
{
    object ob;
    if(!present("\nchina", enemy))
    {
     ob = clone_object(OBJ "chinesisch");
     ob->move(enemy, M_NOCHECK);
    }
}


int c_kaufen(string str)
{
  object ob;
  if ( str != "keks von wan ling"         &&
       str != "glueckskeks von wan ling"  &&
       str != "keks von wan"              &&
       str != "glueckskeks von wan"        )
  {
    notify_fail("Was moechtest Du kaufen?\n");
    return 0;
  }
  else
  {
    if(anz_keks < 1)
    {
      write(BS("Wan Ling sagt: Tut mil leid, abel ich habe keine Kekse "
      "mehl."));
      return 1;
    }
else
{
  write(BS("Du kaufst einen Glueckskeks.\n"));
  ob = clone_object(OBJ "keks");
  if(ob->move(this_player(), M_GET) != 1)
  {
    tell_object(this_player(), "Das kannst Du nicht mehr tragen!\n");
    ob->move(this_object(), M_NOCHECK);
   }
  anz_keks--;
  return 1;
  } 
 }
}

void init()
{
  if(!is_clone(TO)) return;
  ::init();
  if(!TP) return;
  if(!TP->QueryProp("pet_owner_name")) return;
  if(find_call_out("schnetzel1") != -1) return;

  call_out("schnetzel1", 0);


}

void schnetzel1()
{
 ENV(TO)->Message("\n"), MSGFLAG_VISUAL;
 ENV(TO)->Message(BS("Wan Lings Augen werden auf einmal riesiggross, als er "
      +TP->Name()+
      " sieht. "
      "Schnell holt er das grosse Kuechenmesser."), MSGFLAG_VISUAL);
 call_out("schnetzel2", 3);
}

void schnetzel2()
{
 ENV(TO)->Message("\n"), MSGFLAG_VISUAL;
 ENV(TO)->Message(BS("Das Haustier von "+CAP(TP->QueryProp("pet_owner_name"))
      + " kreischt panisch auf! Es will nur noch weg von hier!"), MSGFLAG_VISUAL);
 call_out("schnetzel3", 3); 
}

void schnetzel3()
{
 if(ENV(TP) != ENV(TO))
 {
  ENV(TO)->Message(BS("Wan steckt enttaeuscht sein Messer zurueck."), 
      MSGFLAG_VISUAL); return; 
 }
 ENV(TO)->Message("\n"), MSGFLAG_VISUAL;
 ENV(TO)->Message(BS("Das Blut spritzt als Wan Lings riesiges Kuechenmesser "
       "in das "
       "Haustier von "+CAP(TP->QueryProp("pet_owner_name"))+ " eindringt. "), 
       MSGFLAG_VISUAL);
 write_file(LOG "haustiere.log", ctime()+": Haustier "+TP->Name(WER)+" von "
       +CAP(TP->QueryProp("pet_owner_name"))+" geschnetzelt.\n");
 TP->die();
 call_out("schnetzel4", 3);

}

void schnetzel4()
{
 ENV(TO)->Message("\n"), MSGFLAG_VISUAL;
 ENV(TO)->Message(BS("Immer und immer wieder sticht Wan Ling in "
       +TP->Name(WER)+" ein."), MSGFLAG_VISUAL);
 call_out("schnetzel5", 3);
}

void schnetzel5()
{
 ENV(TO)->Message("\n"), MSGFLAG_VISUAL;
 ENV(TO)->Message(BS("Gedaerme und Blut spritzen durch die Luft."),
     MSGFLAG_VISUAL);
 ENV(TO)->Message(BS("Huch, war das nicht grad ein Paar Augen?!"),
     MSGFLAG_VISUAL);
 call_out("schnetzel6", 3);

}

void schnetzel6()
{
 ENV(TO)->Message("\n"), MSGFLAG_VISUAL;
 ENV(TO)->Message(BS("Viel ist von "+TP->Name()+ " nicht uebrig geblieben. "
       "Aber alles "
       "Brauchbare wirft Wan Ling jetzt in den Wok und braet und "
       "frittiert alles. "), MSGFLAG_VISUAL);
 call_out("schnetzel7", 3);

}

void schnetzel7()
{
 ENV(TO)->Message("\n"), MSGFLAG_VISUAL;
 ENV(TO)->Message(BS("Mhmm, lecker! Morgen gibt es sicher gebratenes "
       "Haustierschnitzel!"), MSGFLAG_VISUAL);
}

die(int poisondeath)
{
 write_file(LOG "dschungel.kills",
 dtime(time())+" : "+CAP(getuid(TP))+" toetet Wan Ling.\n");
 ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
 if(killer == TO )
 write_file(LOG "dschungel.kills",
 sprintf(ctime()+": Wan Ling hat gerade "+CAP(getuid(player))+
     "umgebracht - %d EP!\n", lostexp));
 return;
}


