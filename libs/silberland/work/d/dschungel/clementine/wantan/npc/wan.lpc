inherit "std/npc";
inherit "std/npc/spells";

#include "/p/service/angel/haustiere/std_pet.h"
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <moving.h>
#include <new_skills.h>
#include "../dante.h"


int anz_keks;

reset()
{
  ::reset();
  anz_keks = 10;
  
}


create()
{

   anz_keks = 10;
   if (!is_clone(this_object()))
   return;

   ::create();

   SetProp(P_SHORT, "Wan Ling, der Chinamann");
   SetProp(P_LONG, 
     "Vol Dil steht Wan Ling, del Chinamann. El glinst Dich flech mit "
     "seinen gebleckten Pfeldezaehnen an. Sein magelel Oebelkoelpel wild "
     "von einem gelben Leinenhemd veldeckt, das auch schon einige "
     "Splitzel mit blaunel Sosse hat. Ausseldem tlaegt del Chinamann eine "
     "supel stylische schwalze Satinhose, und passend dazu natuelich "
     "ultlacoole Sandalen mit Holzbaenkchen dalunter. Sein Haupt wild "
     "von dem tladitionellen gelben Hut velsteckt, nur ein schwalzes "
     "geflochtenes Zoepfchen baumelt helvol. ");
   SetProp(P_NAME, "Wan Ling");
   SetProp(P_GENDER, MALE);
   SetProp(P_ARTICLE, 0);
   SetProp(P_INFO, "Wan Ling glillt alles fuel Geld und ist absolut "
	   "immun gegen das Gesundheitsamt!\n");
   
   create_default_npc(30);
   SetProp(P_HANDS, ({ " mit seinem Kuechenmessel", QueryProp(P_HANDS)[1],
          DT_BLUDGEON }) );
   SetProp(P_MAX_HANDS, 2);
   SetProp(P_ALIGN, 1);
   SetProp(P_RACE, "Haustielschlitzel");
   SetProp(P_SIZE, 156);
			  
   SetProp(P_RESISTANCE_STRENGTHS,
    ([DT_FIRE:   -0.6, DT_COLD:   0.6, DT_WATER:  0.3, DT_AIR:    0.2,
    DT_LIGHTNING: 1.0, DT_EXPLOSION: -1.0, DT_SOUND:  -1.0, DT_LIGHT: -1.0,
    DT_ELECTRIC:  -1.0, DT_ACID:     -1.0, DT_POISON: -1.0, DT_TERROR: 0.0,
    DT_HOLY:      -0.5, DT_UNHOLY:   -0.5, DT_MAGIC:  0.0 ]) );

   SetProp (P_REJECT,
     ({ REJECT_KEEP, "Wan Ling fleut sich.\n" }));


   AddId( ({ "wan ling", "wan", "ling", "mann", "chinamann", "chinese" }) );

   SetProp(P_MURDER_MSG, "Du kliegst nie wiedel Fluehlingslollen von mil!\n");
   SetProp(P_KILL_NAME, "Wan Ling" );
   SetProp(P_KILL_MSG, "Zelschnetzeln macht Spass!\n");


   SetProp(P_SPELLRATE, 60);

   AddDefaultSpell(1, 600, DS_POISON, 
     "Wan Ling steckt Dil ein Stueck Kugelfisch in den Mund.\n",
     "Wan Ling stopft @WEM ein Stueck Kugelfisch in den Mund.\n");

   AddSpell(1, 600,
     "Wan Ling mulmelt etwas sehl Seltsames.\n",
     "Wan Ling mulmelt etwas sehl Seltsames.\n", 
      DT_MAGIC, "fluch", ([SP_SHOW_DAMAGE:1]) ); 

   AddSpell(1, 850,
     "Wan Ling zelschnetzelt Dich mit seinem Kuechenmessel.\n",
     "Wan Ling zelschnetzelt @WEM mit seinem Kuechenmessel.\n",
     DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]) );

   AddSpell(1, 760,
     "Wan Ling schuettet Dil heisse Suppe uebel Deine Fuesse.\n",
     "Wan Ling schuettet @WEM heisse Suppe uebel die Fuesse.\n",
     DT_FIRE, ([SP_SHOW_DAMAGE:1]) );

   AddSpell(1, 680,
     "Wan Ling schiebt Dil einen Glueckskeks ins Nasenloch.\n",
     "Wan Ling schiebt @WEM einen Glueckskeks ins Nasenloch.\n",
     DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]) );

   AddSpell(1, 730,
     "Wan Ling bluellt: Volsicht! Entenfuesse suess-sauel.\n",
     "Wan Ling schmeisst ein paal Entenfuesse nach @WEM.\n",
     DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]) );

   AddSpell(1, 790,
     "Wan Ling dlueckt Dil das Plofil seinel Geta in die Flesse.\n",
     "Wan Ling dlueckt @WEM das Plofil seinel Geta in die Flesse.\n",
     DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]) );


   SetChats(10, 
    ({
       "Wan Ling glillt alles fuel Geld.\n",
       "Wan Ling mulmelt: Lecka Fluehlingslolle!!!\n",
       "Wan Ling hackt einem Lehpinschel die Pfoten ab und flittielt ihn "
       "fachgelecht.\n",
       "Wan Ling flagt: Moechtest Du Eielleis?\n",
       "Wan Ling sagt: Einmal Koi-Bulgel zum Mitnehmen!\n",
       "Wan Ling flagt: Einpacken odel hiel essen?\n",
       "Wan Ling wilft ein paal Fleischblocken in den Schlank: Hiel fuel "
       "euch meine lieben Kakellaken.\n",
       "Wan Ling sagt: Heute im Angebot: flische Schneehundzunge!\n",
       "Wan Ling flagt Dich: Moechtest Du mal meine "
       "Spezialitaet plobielen?\n",
       "Wan Ling bluellt: Leckel heiss und fettig!\n",
       "Wan Ling bluellt: Ich blauche neue flische Katze!!!\n" }) );


// INFOS!!!


   AddInfo(DEFAULT_INFO, 
     ({ "glillt liebel ein paal Haustiele.\n",
        "nix velstehen wovon Du splechen.\n",
        "klatzt sich an Luebe.\n",
        "flagt: Liefelst Du mil Fleisch fuel Wan Tan?\n",
        "popelt genussvoll.\n",
        "klatzt sich mit del Leiskelle am Hintelkopf!\n",
        "sagt: Nelv mich nicht!\n",
        "sagt: Flag doch jemand andelen!\n",
        "singt ein altes chinesisches Volkslied.\n",
        "putzt sein Kuechenmessel.\n",
        "sagt: Du splichst wie laetselhaftes Olakel.\n",
        "sagt: Lede doch nolmal mit mil!\n",
        "sagt: Flag mich molgen nochmal!\n",
        "sagt: Flag weisen Konfuzius, del hat mehl Zeit!\n",
        "sagt: Luhe! Sonst spuelst Du gleich meine Geta!\n", 
        "flagt: Walum hast Du mil kein Haustiel mitgeblacht?!\n",
        "kleischt: Stoel mich nicht beim Flittielen!\n" }) );

