
inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../dante.h"

int anz_heilung;

reset()
{
 ::reset();
 anz_heilung = 3;
}

create()
{

::create();

  anz_heilung=3;

  SetProp(P_INT_SHORT, "Im Dschungel");
  SetProp(P_INT_LONG, 
    "Du befindest Dich auf einem kleinen Trampelpfad mitten im Dschungel. "
    "Im Osten scheint der Weg wieder etwas breiter zu werden, waehrend Du "
    "im Westen tiefer in das undurchdringliche Gruen vordingen kannst. "
    "Rechts und links von Dir stehen riesige Baeume gepaart mit wucherndem "
    "Gestruepp. Sogar einige bunte Blueten kannst Du erkennen. Aus der "
    "Ferne hoerst Du ein Rauschen. ");
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 35, ENV_TERRAIN: TT_JUNGLE ]) );
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);

  AddExit( "osten", "/d/dschungel/dante/weg/room/weg7");
  AddExit( "westen", ROOM "anschluss2");


// DETAILBEGINN

  AddDetail( ({ "osten", "westen" }),
    "Im Osten wird der Weg deutlich bereiter, waehrend der hingegen im Westen "
    "noch tiefer in den Dschungel dringt. ");

  AddDetail( ({ "boden" }),
    "Der Boden ist ziemlich weich, sodass Du manchmal auch etwas einsinkst. ");
 
  AddDetail( ({ "weg" }),
    "Der Weg fuehrt entweder nach Osten oder nach Westen. ");

  AddDetail( ({ "gruen" }),
    "Fast alles hier ist gruen, das ist einfach so im Dschungel. Zwischen "
    "den verschiedenen Gruentoenen der Pflanzenwelt kannst Du allerdings "
    "auch ein paar bunte Kleckse entdecken. ");

  AddDetail( ({ "pflanzenwelt", "welt" }),
    "Hier wachsen hunderte verschiedene Pflanzen, deren Namen Du gar nicht "
    "wirklich wissen moechtest. ");

  AddDetail( ({ "pflanzen" }),
    "Hier wachsen sehr viele!");

  AddDetail( ({ "kleckse", "farbkleckse" }),
    "Die bunten Farbkleckse entpuppen sich als Blueten, bei denen sogar "
    "einige Tierchen ihren Nektar sammeln. ");

  AddDetail( ({ "tierchen", "tiere" }),
    "Einige von ihnen sammeln Nektar aus den Blueten. ");

  AddDetail( ({ "blueten", "bluete" }),
    "Die bunten Blueten bieten eine nette Abwechslung zum sonst so "
    "eintoenigem Gruen des Dschungels. ");

  AddDetail( ({ "dschungel" }),
    "Der umgibt Dich doch!");

  AddDetail( ({ "nektar" }),
    "Der schmeckt sicher sehr lecker!"); //koste plus paar hp

  AddDetail( ({ "abwechslung" }),
    "Die bunten Blueten sehen nett aus. ");

  AddDetail( ({ "ferne" }),
    "Also von hier aus kannst Du sicherlich keine Ferne untersuchen!");

  AddDetail( ({ "namen" }),
    "Du siehst unter andrem Helikonien, die Dich wirklich beeindrucken. ");  

  AddDetail( ({ "helikonien" }),
    "Sie sehen wirklich so farbenpraechtig aus!");

  AddDetail( ({ "himmel" }),
    "Die Sonne brennt vom Himmel herunter. ");

  AddDetail( ({ "sonne" }),
    "Sie steht hoch oben am Himmel und brennt von dort herunter. ");


  AddDetail( ({ "gruentoene", "toene" }),
    "Hier gibt es wirklich ganz viele verschiedene."); 


  AddDetail( ({ "baeume", "baum" }),
    "Die Baeume sind riesig. So richtige Urwaldriesen, die sicherlich "
    "schon seit etlichen Jahren hier stehen. Zwischen ihnen draengt sich "
    "dichtes Gestruepp, vermischt mit Schlingpflanzen und Farnen. ");

  AddDetail( ({ "schlingpflanzen", "farne" }),
    "Sie gedeihen hier wirklich hervorragend. ");

  AddDetail( ({ "jahre" }),
    "Die Baeume wachsen hier sicherlich schon sehr lange. ");

  AddDetail( ({ "gestruepp" }),
    "Dichtes Gestruepp waechst zwischen den Baeumen. Die Aeste haben "
    "feste Dornen, sodass Du lieber nicht zu nahe kommen solltest. ");

  AddDetail( ({ "dornen" }),
    "Nur nicht angreifen!"); //angreifen

  AddDetail( ({ "urwaldriesen" }),
    "Die Baeume hier sind wirklich riiiiiiiiiiiiiiiiiiesig hoch. ");

  AddDetail( ({ "aeste", "blaetter" }),
    "Aeste, Blaetter, ... bei diesen tropischen Temperaturen und der "
    "hohen Luftfeuchtigkeit gedeiht ja wirklich alles. ");

  AddDetail( ({ "temperatur" }),
    "Hier hat es bestimmt ueber 30 Grad!");

  AddDetail( ({ "grad" }),
    "Viel zu heiss um hier Wurzeln zu schlagen!");

  AddDetail( ({ "wurzeln" }),
    "Noch hast Du keine ;), aber wenn Du noch lange wartest, bist Du "
    "vielleicht festgepflanzt. ");

  AddDetail( ({ "luftfeuchtigkeit" }),
    "Die hohe Luftfeuchtigkeit ist ideal fuer das Wachstum der Pflanzen. ");

  AddDetail( ({ "wachstum", "wachsen" }),
    "Man kann den Pflanzen beim Wachsen foermlich zusehen. "); // seh zu

  AddDetail( ({ "pfad", "trampelpfad" }),
    "Du stehst doch grad auf ihm drauf!");

  AddDetail( ({ "rauschen" }),
    "Lausch doch mal!");

 
// SOUNDS

  AddSound(DEFAULT_SOUND, "Aus der Ferne vernimmst Du immer wieder ein "
    "Rauschen und Tosen. ");

  AddSound( ({ "rauschen", "tosen" }),
    "In der Naehe scheint sich ein Wasserfall zu befinden. ");

  AddSound( ({ "wasserfall" }),
    "Er scheint sich weiter suedoestlich zu befinden. ");

  AddSound( ({ "naehe" }),
    "Also 'Naehe' kannst Du wirklich nicht lauschen!");


// SMELLS
   
  AddSmell(DEFAULT_SMELL, "Hier riecht es nach Dschungel!");

  AddSmell( ({ "dschungel" }),
    "Genauso hast Du Dir den Geruch des Dschungels vorgestellt - herrlich!");

  AddSmell( ({ "geruch" }),
    "Du schnupperst an einigen Pflanzen und saugst den Geruch tief in Dich "
    "hinein. ");

  AddSmell( ({ "pflanzen" }),
    "Die riechen herrlich!");


// COMMANDS

  AddCmd( ({ "kost", "koste" }), "c_kosten");
  AddCmd( ({ "greif", "greife" }), "c_greifen");
  AddCmd( ({ "seh", "sehe" }), "c_sehen");


}

int c_sehen(string str)
{
 if( str != "pflanzen beim wachsen zu" )
 {
  notify_fail("Wem moechtest Du wobei zusehen?!\n");
  return 0;
 }
 else
 {
  write(BS("Du fixierst eine Pflanze mit Deinem Blick und tatsaechlich! "
     "Sie waechst! Das war mindestens ein Viertel Millimeter!"));
  say(CTPN+ " starrt eine Pflanze an.\n");
  return 1;
 }
}
 


int c_greifen(string str)
{
 if( str != "dornen an")
 {
  notify_fail("Was moechtest Du hier angreifen?!\n");
  return 0;
 }
 else
 {
  write(BS("AUAAAAAAAAAAAAAAAAAA! Das tut doch weh!"));
  say(CTPN + " schreit auf.\n");
  TP->do_damage(10+random(5), this_object());
  return 1;
 }
}


int c_kosten(string str)
{
 if( str != "nektar" )
 {
  notify_fail("Was moechtest Du hier kosten?!\n");
  return 0;
 }
 else
 {
  if(anz_heilung < 1)
  {
   write(BS("Och, schade... Kein Nektar mehr da... :( "));
   return 1;
  }
  else
  {
   write(BS("Du nippst etwas an dem Nektar. Mhmm... Lecker!"));
   say(CTPN+ " beugt sich ueber eine Blume.\n");
   TP->AddHp(5); 
   anz_heilung--;
   return 1;
  }
 }
}


