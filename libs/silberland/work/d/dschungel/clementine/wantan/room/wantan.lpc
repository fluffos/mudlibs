inherit "std/pub";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include <pub.h>
#include "../dante.h"

#define MAX_PERSONEN 2

string *spieler_sessel;

create()
{

  ::create();

  SetProp(P_INT_SHORT, "Im FFF");
  SetProp(P_INT_LONG,
	  "Willkommen in Wan Lings Flittielelei!\n"//fliedhof del kuscheltiele
	  "An der Nordwand faellt Dir sofort eine lange Theke auf, die ueber "
	  "und ueber mit Bierdeckel vollgerammelt ist. Dahinter haelt sich "
	  "normalerweise Wan Ling auf, und versucht seine Gaeste gluecklich "
	  "zu machen. Natuerlich befinden sich dort auch ein riesiger Reiskocher, "
	  "ein Wok, und andere Kuechenutensilien. Hinter "
	  "der Bar haengt ein ganz toller Plastikfaecher mit Pandamotiven. "
	  "Neben dem Eingang steht ein Aquarium mit suessen Fischchen "
	  "drinnen, an der Westwand kannst Du das Bild eines Wasserfalls "
	  "bestaunen. An der Decke baumelt ein grosser roter Lampion mit Quasten, "
	  "zwei kleine Tische mit Bambusplatzdecken laden zum "
	  "Hinsetzen ein. Lies doch mal die Speisekarte!");
	  
	  //haustierschnetzal bei detail
  SetProp(P_LIGHT, 1);
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_HOUSE]) );
  SetProp(P_INDOORS, 1);

  AddExit( "sueden", ([ EX_DEST: ROOM "anschluss3",
                        EX_TESTFUNC: "exit_test" ]) );

  AddItem(NPC "wan", REFRESH_DESTRUCT);
  
  SetProp(P_PUB_FLAGS, PUB_HASKEEPER | PUB_NEEDSKEEPER );
  SetProp(P_PUBKEEPER_ID, "wan" );
  SetProp(P_PUBKEEPER_NAME, "Wan Ling" );
  SetProp(P_PUBKEEPER_GENDER, MALE );
  SetProp(P_PUBMSG_NOINVITE, "Wan Ling ist doch nicht dumm!\n");
  SetProp(P_PUBMSG_FIGHTING, " zelschnetzelt doch gelade seinen Gegnel!\n");
  SetProp(P_PUBMSG_NOENEMY, "Wan Ling schleit: Dich bedien ich nie wiedel!\n");


  
  
// SPEISEN

  AddFood( " 1. Fruehlingsrolle", ({ "rolle", "fruehlingsrolle", "1" }),
           95, 23, 7,
             ({ "Wan Ling luft: Einmal Fluehlingslolle!\n",
                "Wan Ling serviert && eine Fruehlingsrolle.\n" }) );

  AddFood( " 2. Wantan-Suppe", ({ "2", "wantan-suppe", "suppe" }),
           140, 35, 13,
              ({ "Wan Ling gibt Dil einen Tellel Suppe.\n",
                 "&& schluerft einen Teller Suppe.\n" }) );

  AddFood( " 3. Koi-Burger", ({ "koi", "burger", "koi-burger", "3" }),
	    180, 37, 12,
	      ({ "Wan Ling gleift ins Aqualium, holt einen total suessen "
		     "Fisch helaus...*hack* *hack*...und selviert Dil Deinen "
			 "Bulgel.\n",
		     "&& isst etwas, dass noch nicht wirklich tot aussieht.\n" }));

  AddFood( " 4. Rehpinscher", ({ "pinscher", "reh", "rehpinscher", "4" }),
	    500, 103, 30,
	      ({ "Wan Ling flittielt einen Lehpinschel und selvielt ihn Dil.\n",
		     "&& isst Speise Nummer 4.\n" }));

  AddFood( " 5. Schneehundzunge", ({ "zunge", "schneehundzunge", 
		"schneehund", "5" }), 720, 33, 12,
	      ({ "Mhmmm...lecker Schneehundzunge!\n",
		     "&& isst ein Schneehundebabyzunge.\n" }) );

  AddFood( " 6. Neun Schaetze", ({ "schaetze", "neun schaetze", "6" }),
	    380, 60, 18,
	      ({ "Wan Ling bluellt: Ich blauch Whiskas-Nachschub!\n",
		     "&& isst Neun Schaetze.\n" }));

  AddFood( " 7. Eierreis mit Schinken", ({ "eierreis", "eierreis mit schinken", 
		"reis", "7" }), 167, 33, 12,
	      ({ "Wan Ling sagt: Einmal Eielleis mit Schinken!\n",
		     "&& isst etwas mit Reis.\n" }));

  AddFood( " 8. Babibantang", ({ "8", "babibantang", "ferkel", "spanferkel" }),
	    560, 53, 17,
	      ({ "Wan Ling bluellt: Einmal Nummel 8!\n",
		     "&& isst etwas, das frueher mal ein Ferkelchen war.\n" }));

  AddFood( " 9. Gebratene Nudeln mit Ei", ({ "nudeln", "gebratene nudeln", 
		"ei", "9" }),
	    100, 30, 9,
	     ({ "Wan Ling sagt: Einmal geblatene Nudeln!\n",
		    "&& isst gebratene Nudeln.\n" }));
  
  AddFood( "10. Waldi Goreng", ({ "waldi goreng", "waldi", "goreng", "10" }),
           390, 43, 15,
             ({ "Wan Ling bluellt: Einmal Nummel 10! Hiel!\n",
                "&& schlingt ein Gemisch mit Wauwau hinunter.\n" }) );

  AddFood( "11. Wan Tan", ({ "wan", "wantan", "tan", "11" }),
	    80, 18, 6,
	      ({ "Mhmm, leckel Wan Tan!\n",
		     "&& bestellt sich Wan Tan.\n" }));

  AddFood( "12. Frittierte Katze", ({ "12", "frittierte katze", "katze" }), 
	    270, 43, 15,
	      ({ "Du isst eine leckele flittielte Katze.\n",
		     "&& schmatzt, als &! eine Katze isst.\n" }));

  AddFood( "13. Gebratene Krabben", ({ "13", "gebratene krabben", "krabben" }),
	    160, 34, 12,
	      ({ "Wan Ling flagt: Wel hat die Klabben bestellt?!\n",
		     "Mhmm, lecker! && isst Krabben.\n" }));

  AddFood( "14. Kakaduwings", ({ "14", "kakadu", "wings", "kakaduwings" }),
	    110, 33, 12,
	      ({ "Wan Ling selvielt Dil das Bestellte.\n",
		     "Wan Ling hackt einem Kakadu die Fluegel ab.\n" }));

  AddFood( "15. Gebackener Tigerhaxen", ({ "15", "haxen", "tigerhaxen", 
		"tiger" }), 550, 60, 20,
	      ({ "Wan Ling sagt: Gebackenel Tigel!\n",
		     "&& ist einen gebackenen Tigerhaxen.\n" }));

  AddFood( "16. Geroestete Adleraugen", ({ "16", "augen", "adleraugen" }), 
	    230, 33, 12,
	      ({ "Wan Ling bluellt: Einmal Nummel 16!\n",
		     "&& isst ein paar Adleraugen genuesslich auf.\n" }));

  AddFood( "17. Schlangenallerlei", ({ "17", "allerlei", "schlange", 
		"schlangenallerlei" }), 430, 0, 0,
	      ({ "Igitt, ist die Schlange zaeh...\n",
		     "&& sieht nicht sehr gluecklich aus.\n" }));

  AddFood( "18. Ente suess-sauer", ({ "ente", "18" }), 130, 40, 15,
	      ({ "Du stopfst eine Ente in Dich hinein.\n",
		     "Wan Ling sagt: Ente suess-sauel!\n" }));

  
  
// GETRAENKE
			  

  AddDrink( "Pflaumenwein", ({ "pflaumenwein" }),
	    60, 23, 2, 6,
		  ({ "Wan Ling schenkt Dil ein Glas Pflaumenwein ein.\n",
		     "&& leert ein Glas Pflaumenwein in einem Zug.\n" }) );
  
  AddDrink( "Jasmintee", ({ "jasmintee" }),
	    20, 10, 0, 3,
		  ({ "Du schluerfst eine Tasse Tee.\n",
		     "&& trinkt eine Tasse Tee.\n" }) );

  AddDrink( "Reiswein", ({ "reiswein" }),
	    50, 19, 3, 5,
		  ({ "Wan Ling blingt Dil eine Schale Leiswein.\n",
		     "&& trinkt eine Schale Reiswein.\n" }) );

  AddDrink( "Lycheewein", ({ "lycheewein" }),
        123, 23, 6, 2,
		  ({ "Wan Ling sagt: Hiel del Lycheewein!\n",
		     "&& bekommt Lycheewein.\n" }) );
			
  AddDrink( "Mandarinenwein", ({ "mandarinenwein" }),
        100, 20, 7, 3,
		  ({ "Wan Ling bluellt: Hiel Dein Mandalinenwein!\n",
		     "Wan Ling serviert && Mandarinenwein.\n" }) );
	
  AddDrink( "Gruener Tee", ({ "gruener", "gruener tee" }),
	    33, 19, 0, 11,
		  ({ "Wan Ling selvielt Dil Gluenen Tee.\n",
		     "&& bekommt Gruenen Tee serviert.\n" }) );

  AddDrink( "Ginseng", ({ "ginseng" }), 
        460, 35, 10, 3,
		  ({ "Du schuettest den Schnaps hinunter.\n", 
		     "&& schuettet sich etwas in den Mund.\n" }) );
  
  AddDrink( "Zhu Ye Quing Chiew", ({ "bambusschnaps", "zhu ye ching chiew" }),
	    960, ({ 110,0,10 }), 17, 4,
		  ({ "Schnell schuettest Du den Bambusschnaps in Deinen Mund. "
		     "Brennend zieht er sich die Kehle hinunter.\n",
			 "&& besaeuft sich mit Bambusschnaps.\n" }) );

  AddDrink( "Mai Kui Lu Chiew", ({ "rosenschnaps", "mai kui lu chiew" }),
	    788, 88, 23, 4,
		  ({ "Du leerst den Rosenschnaps in einem Zug.\n",
		     "&& leert den Schnaps in einem Zug.\n" }) );

  AddDrink( "Kokosmilch", ({ "milch", "kokosmilch" }), 
	    15, 3, 0, 7,
		  ({ "Das schmeckt nicht unbedingt sehr berrauschend.\n",
		     "&& ist nicht gerade begeistert von seinem Getraenk.\n" }) );

  AddDrink( "Mangosaft", ({ "mangosaft" }), 
	    134, 26, 0, 9,
		  ({ "Mhmm, leckel Mangosaft!\n",
		     "&& kippt ein Glas runter, und reibt sich &! Bauch.\n" }) );

  AddDrink( "Calpis", ({ "calpis" }), 
	    637, 53, 0, 14,
		  ({ "Du trinkst Calpis - was auch immer...\n",
		     "&& bestellt Calpis.\n" }) );

  AddDrink( "Lycheesaft", ({ "lycheesaft" }),
        10, 5, 0, 2,
		  ({ "Leckel Lycheesaft!\n",
		     "&& trinkt Saft.\n" }) );
  
  AddDrink( "Longjing Tee", ({ "longjing tee", "longjing" }), 
        30, 10, 0, 5,
		  ({ "Wan Ling sagt: Hiel, Dein Tee - abel ohne Zuckel! Zuckel "
		     "kostet naemlich extla!\n",
			 "&& trinkt eine Tasse Tee.\n" }) );
		
  AddDrink( "Louhanguo Tee", ({ "louhanguo", "louhanguo tee" }), 
        50, 20, 0, 5,
		  ({ "Das tut Deinem Hals aber gut...!\n",
		     "&& fuehlt sich erfrischt.\n" }) );
 
  AddDrink( "Cola", ({ "cola" }),
	    200, 5, 0, 5,
		  ({ "Du kannst doch nicht Cola beim Chinamann bestellen?!\n",
		     "&& bestellt sich _ein_ Cola.\n" }) );

  AddDrink( "Wasser", ({ "wasser" }),
	    10, 1, 0, 1,
		  ({ "Wan Ling gibt Dil ein Glas Wassel.\n",
		     "&& trinkt ein Glas Wasser.\n" }) );

  AddDrink( "Bier", ({ "bier" }),
	    130, 15, 3, 5,
		  ({ "Wan Ling blingt Dil ein Glas abgestandenes Biel. Igitt!\n",
		     "&& verdreht &! Augen.\n" }) );
  
  
  
// DETAILBEGINN

  
  AddDetail( ({ "raum", "lokal" }), QueryProp(P_INT_LONG) );

  AddDetail( ({ "speisekarte", "karte" }),
    "Eine lange Speisekarte haengt an der Ostwand. "
    "Du kannst sie problemlos mit >menue< lesen. ");

  AddReadDetail( ({ "karte", "speisekarte" }),
    "Tipp: >menue< !!!");

  AddDetail( ({ "wan ling", "wan", "ling" }),
    "Ist er nicht hier?! Er kommt sicher bald wieder!");

  AddDetail( ({ "plastikfaecher", "faecher" }),
    "Ein hochexklusiver Faecher aus reinstem Plastik haengt hinter der "
    "Bar. Auf ihn wurden tolle Pandamotive gedruckt. ");

  AddDetail( ({ "motive", "pandamotive" }),
    "Auf dem wunderschoenen Faecher wurden einige Pandas aufgedruckt, die "
    "sich genuesslich ihrem Bambus widmen. ");

  AddDetail( ({ "pandas", "panda" }),
    "Wirklich ein total exquisiter Faecher mit diesen huebschen Pandas!");

  AddDetail( ({ "plastik" }),
    "Sicherlich wurde nur das reinste und edelste Plastik fuer die "
    "Herstellung des Faechers genutzt. ");

  AddDetail( ({ "herstellung" }),
    "Du kannst hier nichts ueber die Herstellung lernen! Bewundere den tollen "
    "Faecher doch einfach!"); 

  AddDetail( ({ "gaeste", "gast" }),
    "So etwas wie Du!");

  AddDetail( ({ "eingang" }),
    "Dort bist Du doch hinein gekommen! Da kann man uebrigens auch wieder "
    "hinaus gehen!");
 
  AddDetail( ({ "ausgang" }),
    "Rechts, links, oben, unten, ...");

  AddDetail( ({ "waende" }),
    "Die Waende sind in rot gehalten. An der Nordwand siehst Du "
    "die Theke, an der Westwand haengt ein wundervolles Bild. ");

  AddDetail( ({ "wand" }),
    "Welche Wand meinst Du?!");

  AddDetail( ({ "ostwand" }),
    "An der Ostwand haengt eine laaaaaaaaaaange Speisekarte. ");

  AddDetail( ({ "nordwand" }),
    "Dort befindet sich die grosse Theke, die mit Bierdeckeln uebersaeht ist. "
    "Hinter ihr haengt ein toller Faecher. ");

  AddDetail( ({ "suedwand" }),
    "Durch dieses seltsame Loch in der Suedwand bist Du doch herein "
    "gekommen!");

  AddDetail( ({ "loch" }),
    "Manche nennen sowas auch Eingang!");

  AddDetail( ({ "westwand" }),
    "An der Westwand haengt ein tolles Bild.");

  AddDetail( ({ "decke" }),
    "Die Decke wurde mit kunstvoll verzierten goldenen Holzornamenten "
    "verkleidet. In der Mitte haengt ein grosser roter Lampion mit Quasten. ");

  AddDetail( ({ "holzornamente", "ornamente" }),
    "Als Du genauer hinsiehst, faellt Dir auf, dass die kunstvollen "
    "Ornamente nicht aus Holz sondern Plastik bestehen. Naja hauptsache "
    "golden, und vielleicht sogar lesbar?!");

  AddReadDetail( ({ "ornamente" }),
    "Ornamente kann man nicht lesen, nur eventuell versteckte geheime "
    "Botschaften...");

  AddDetail( ({ "botschaften", "botschaft" }),
    "Du siehst hier definitiv keine Botschaft!");

  AddDetail( ({ "zeichen", "schriftzeichen" }),
    "Die Ornamente zeigen Schriftzeichen. Mit etwas Muehe kannst Du sie "
    "sicher auch lesen!");

  AddDetail( ({ "muehe" }),
    "Na streng Dich halt mal an, Du bist sonst eh nur faul!");

  AddReadDetail( ({ "zeichen", "schriftzeichen" }),
    "Du liest: Liegt ein Auge auf dem Tresen, ist ein Haustier dagewesen.");

  AddDetail( ({ "bild", "wasserfallbild" }),
    "Das Bild an der Westwand zeigt einen tollen Wasserfall in einem "
    "Bambuswaeldchen. Es scheint sogar, als koenntest Du das Tosen bis "
    "hier her hoeren. ");

  AddDetail( ({ "tosen" }),
    "Es scheint, als wuerde der Wasserfall sogar als Bild noch rauschen...");

  AddDetail( ({ "bambuswaeldchen", "waeldchen" }),
    "Der Wasserfall ist eingebettet in einem kleinen Waeldchen.");

  AddDetail( ({ "wasserfall" }),
    "Du spuerst foermlich seine reissende Kraft, die Dich in ihren Bann "
    "zieht. ");

  AddDetail( ({ "bann" }),
    "Ein absolut tolles Bild!");

  AddDetail( ({ "kraft" }),
    "Wirklich phantastisch!");

  AddDetail( ({ "batterien" }),
    "Du musst das Bild schon umdrehen, um die Batterien sehen zu koennen. ");

  AddDetail( ({ "kakerlakenfamilie", "familie" }),
    "Nochmal magst Du die garantiert nicht sehen!");

  AddDetail( ({ "flittielelei" }),
    "Willkommen bei Wan Ling! Er grillt fuer Geld garantiert alles, und hat "
    "Haustiere zum Fressen gerne ;)");

  AddDetail( ({ "haustiere", "haustier" }),
    "Kein einziges zu sehen... warum wohl?! :) ");

  AddDetail( ({ "geld" }),
    "Fuer Geld macht Wan Ling alles!");

  AddDetail( ({ "fressen" }),
    "Mhmm...lecker! Gebratenes Haustier!");

  AddDetail( ({ "tische", "tisch" }),
    "Zwei kleinere Tische stehen hier, auf jedem von ihnen liegt ein "
    "Bambusplatzdeckchen sowie zwei seltsame Behaeltnisse. Davor steht "
    "je ein Sessel. ");

  AddDetail( ({ "bambusplatzdeckchen", "bambusplatzdecken", "platzdecken", 
    "platzdeckchen", "bambusdecken", "bambusdeckchen", "deckchen", "decken" }),
    "Huebsche Bambusdeckchen liegen auf den Tischen, beim naeheren Hinsehen "
    "fallen Dir allerdings ein paar komische braune Spritzer auf... Eines der "
    "Deckchen woelbt sich etwas...");

  AddDetail( ({ "spritzer" }),
    "Seltsame braune Spritzer siehst Du auf den Deckchen. Was das wohl ist?!");

  AddDetail( ({ "hinsehen" }),
    "Du hast wirklich ganz genau hingesehen!");

  AddDetail( ({ "woelbung" }),
    "Anscheinend liegt da etwas drunter! Du koenntest das Deckchen ja mal "
    "aufheben. ");

  AddDetail( ({ "etwas" }),
    "Ich seh etwas, was Du nicht siehst, und das lautet: FORSCH!");

  AddDetail( ({ "behaeltnisse" }), 
    "Zwei Behaeltnisse stehen auf jedem Tisch. Das eine sieht aus wie eine "
    "Flasche waehrend das andere eher so eine Art Dose ist. ");

  AddDetail( ({ "art" }),
    "Sieht so aehnlich aus!");

  AddDetail( ({ "flasche" }),
    "In der Flasche befindet sich eine braune Fluessigkeit. ");

  AddDetail( ({ "fluessigkeit" }),
    "Eine braune Fluessigkeit befindet sich in der Flasche. ");

  AddDetail( ({ "sojasauce", "sojasosse" }),
    "Mhmm, leckere Sojasauce befindet sich in der Flasche. Das wuerde auch die "
    "Spritzer auf den Deckchen erklaeren. ");

  AddDetail( ({ "dose" }),
    "Die Dose ist offen, etwas Rotes befindet sich in ihr. Los kosten!");

  AddDetail( ({ "sambal oelek", "sambal olek" }),
    "Wui, dass ist sicher verdammt scharf!");

  AddDetail( ({ "rotes" }),
    "Was das wohl ist...");

  AddDetail( ({ "fischchen" }),
    "\n"
    "Suuuuuuuuuess! Die sind total niedlich und schillern in allen "
    "erdenklichen Farben! Lieb!!!\n"
    "\n"
    "Ploetzlich hoerst Du: Einmal Koi-Burger!\n"
    "Wan Ling eilt herbei, greift nach einem total putzigen Fischchen, und "
    "zieht es heraus.\n"
    "\n"
    "BUMM! ZACK!\n" 
    "Hinter der Theke wird der Fisch gegen etwas Hartes gedonnert. "
    "Die zwei suessen Kulleraugen springen heraus, und werden sogleich von "
    "einigen Kakerlaken verspeist.\n"
    "Einige Gedaerme fliegen durch die Luft.\n"
    "\n"
    "Wuaaaaaaaaaaaaaaaaaaaaaaaah!\n");

  AddDetail( ({ "gedaerme" }),
    "Lecker! ");

  AddDetail( ({ "kulleraugen", "augen" }),
    "Kaum zwei Sekunden auf dem Boden schon stuerzen sich einige Kakerlaken "
    "auf die einstmals suessen Kulleraugen. ");

  AddDetail( ({ "bar" }),
    "Sie befindet sich an der Nordwand. ");

  AddDetail( ({ "koi-burger", "burger" }),
    "Bestell Dir doch einfach einen!");

  AddDetail( ({ "hartes" }),
    "Der Fisch wurde gegen irgendetwas Hartes gedonnert, damit er nicht mehr "
    "aus dem Burger flutschen kann. ");

  AddDetail( ({ "kakerlaken" }),
    "Jedes Mal wenn Essen auf den Boden faellt, stuerzen sie aus ihren "
    "Verstecken und verschlingen ihre Beute. ");

  AddDetail( ({ "verstecken" }),
    "Sie sind ueberall und nirgendwo. ");

  AddDetail( ({ "beute" }),
    "Fischaugen, Hundeleber, ...");

  AddDetail( ({ "fischaugen", "hundeleber", "leber" }),
    "Alles was Wan Ling nicht verarbeiten kann wird an die Kakerlaken "
    "verfuettert. ");

  AddDetail( ({ "koi", "kois" }),
    "Auch sowas schwimmt im Aquarium. ");

  AddDetail( ({ "fisch" }),
    "Der haengt jetzt irgendwo leblos aus einem Burger. ");

  AddDetail( ({ "holz" }),
    "Das meiste hier besteht eben nicht aus Holz!");

  AddDetail( ({ "farben" }),
    "Alle erdenklichen!");

  AddDetail( ({ "hinsetzen" }),
    "Wenn Du noch einen Platz findest, dann setz Dich doch! ");

  AddDetail( ({ "platz" }),
    "Ist noch einer frei?!");

  AddDetail( ({ "mitte" }),
    "Von der Mitte der Decke baumelt ein grosser roter Lampion, der den "
    "Raum in roetliches Licht huellt. ");

  AddDetail( ({ "licht" }),
    "Es kommt von dem roten Lampion. ");

  AddDetail( ({ "mal" }),
    "...");

  AddDetail( ({ "essen" }),
    "Leider passieren Wan Ling wohl oefteres kleinere Missgeschicke. "
    "Zumindest scheinen die Kakerlaken wohl genaehrt zu sein, und sobald "
    "sicherlich leider nicht vom Aussterben bedroht...");

  AddDetail( ({ "missgeschicke", "missgeschick" }),
    "Manchmal laesst Wan Ling leider etwas fallen. ");

  AddDetail( ({ "sl" }),
    "Du befindest Dich bei Wan Ling im Silberland. ");

  AddDetail( ({ "silberland" }),
    "Wenn Du jetzt >ende< tippst, bekommst Du einen Forscherpunkt!");

  AddDetail( ({ "forscherpunkt" }),
	    "Hrhr :)");

  AddDetail( ({ "aussterben" }),
    "Man braeuchte eindeutig mehr Kammerjaeger im SL!");

  AddDetail( ({ "kammerjaeger", "jaeger" }),
    "Wenn Du nichts zu tun hast, koenntest Du ja einmal einen Verein von "
    "Freiwilligen um Dich scharen, die sich dem Problem annehmen. ");

  AddDetail( ({ "problem" }),
    "Na wenn Du in den Viechern kein Problem siehst, dann...");

  AddDetail( ({ "viecher" }),
    "KAKERLAKEN! Wobei... Haustiere sind noch ein viel groesseres Problem!");

  AddDetail( ({ "freiwillige" }),
    "Ich seh keinen hier! Du etwa?!");

  AddDetail( ({ "verein" }),
    "Gruende einen!");

  AddDetail( ({ "sekunden" }),
    "Spaetestens nach 2 Sekunden sind die Reste weggefuttert...");

  AddDetail( ({ "reste" }),
    "Keine mehr zu sehen...");

  AddDetail( ({ "luft" }),
    "Luft kann man nicht sehen!");

  AddDetail( ({ "aquarium" }),
    "Im Aquarium tummeln sich alle moeglichen Fische. Am Grund liegen "
    "Kieselsteine und eine Schatztruhe. Auch einige Wasserpflanzen "
    "wurden in dem Glaskasten angesiedelt. ");

  AddDetail( ({ "glaskasten" }),
    "Damit ist das Aquarium gemeint. ");

  AddDetail( ({ "schatztruhe", "truhe" }),
    "Das ist natuerlich keine echte Schatztruhe, sondern nur ein kleines "
    "billiges Plastikteil. ");

  AddDetail( ({ "plastikteil", "teil" }),
    "Es wurde dunkelbraun gestrichen. ");

  AddDetail( ({ "fische" }),
    "Alles moegliche schwimmt in dem Aquarium. ");

  AddDetail( ({ "kieselsteine", "steine" }),
    "Sie bedecken den Grund des Aquariums. ");

  AddDetail( ({ "grund" }),
    "Er ist mit Steinen bedeckt. Einige Wasserpflanzen spriessen aus ihm "
    "hervor. ");

  AddDetail( ({ "pflanzen", "wasserpflanzen" }),
    "Nichts besonderes! Einfach nur gruene Wasserpflanzen. ");

  AddDetail( ({ "schatz" }),
    "Wo siehst Du hier einen Schatz?!");

  AddDetail( ({ "bierdeckel", "deckel", "deckeln" }),
    "Sie liegen ueberall auf der Theke herum. Damit haben sicherlich schon "
    "einige Kunden Pyramiden, Haeuser, ... gebaut, waehrend sie auf ihre "
    "Speisen gewartet haben. ");

  AddDetail( ({ "kunden" }),
    "Soetwas wie Du!");

  AddDetail( ({ "speisen" }),
    "Tja, hier gibt es doch tatsaechlich Speisen zu kaufen!");

  AddDetail( ({ "pyramiden", "haeuser" }),
    "Was man halt so mit Bierdeckel anstellen kann...");

  AddDetail( ({ "bambus" }),
    "Bambus laesst sich toll verarbeiten, und schmeckt vorallem Pandas gut. ");

  AddDetail( ({ "quasten" }),
    "Diese baumelnden Quasten am Lampion sind wirklich absolut der Hit. "
    "Das gefaellt Dir sogar so gut, dass Du soetwas gern in Dein Seherhaus "
    "haengen wuerdest. ");

  AddDetail( ({ "seherhaus" }),
    "Schnell eins besorgen, falls Du noch keins hast. Die sind garantiert "
    "sicher ;)");

  AddDetail( ({ "hit" }),
    "Das ist so kitschig, dass es schon wieder toll ist!");

  AddDetail( ({ "lampion" }),
    "Der rote Lampion aus Reispapier erhellt den Raum etwas. Er baumelt "
    "von der Mitte der Decke herunter, und ist wirklich ein besonders "
    "huebsches Exemplar. ");

  AddDetail( ({ "exemplar" }),
    "Wirklich eine huebsche Lampe. ");

  AddDetail( ({ "lampe" }),
    "Sehr sehr huebsch!");

  AddDetail( ({ "reispapier", "papier" }),
    "Der Lampion wurde aus rotem Reispapier hergestellt. ");

  AddDetail( ({ "theke" }),
    "Die Theke ist wirklich lang. Auf ihr befinden sich abgesehn von "
    "unzaehligen Bierdeckel auch ein Reiskocher, ein Wok sowie andere "
    "brauchbare Kuechenutensilien. ");

  AddDetail( ({ "reiskocher", "kocher" }),
    "Dieser Reiskocher ist ein absolutes hightech Ding, er wurde "
    "wahrscheinlich extra aus einem fernen Land eingeflogen. ");

  AddDetail( ({ "land" }),
    "Es muss sehr weit weg liegen. ");

  AddDetail( ({ "ding" }),
    "Absolut praktisch und fuer Wan Ling unverzichtbar. Einfach den "
    "Reis reinstecken, Wasser hinein, und einen komischen Hebel druecken. ");

  AddDetail( ({ "reis" }),
    "Reis kannst Du hier sicherlich auch essen. ");

  AddDetail( ({ "wasser" }),
    "Ob das Wasser im Aquarium auch fuer den Reiskocher verwendet wird?!");

  AddDetail( ({ "hebel" }),
    "Faszinierend!");

  AddDetail( ({ "wok" }),
    "Der Wok ist schon etwas verkrustet, aber sicherlich noch gut "
    "einsetzbar. ");

  AddDetail( ({ "kuechenutensilien", "utensilien" }),
    "Abgesehen von riesigen Kuechenmessern, siehst Du auch noch ein "
    "paar Staebchen, Schoepfer, und anderes Dir fremdes Zeug. ");

  AddDetail( ({ "staebchen" }),
    "Damit ruehrt Wan Ling im Wok herum. ");

  AddDetail( ({ "schoepfer" }),
    "Tja, sowas braucht man halt in nem Lokal. ");

  AddDetail( ({ "kuechenmesser", "messer" }),
    "Igitt, auf einem klebt sogar noch Blut!");

  AddDetail( ({ "blut" }),
    "Von wem das wohl stammt?! Kannst das Messer ja mal abschlecken, wenn "
    "Du so grauslich bist!"); 
 
  AddDetail( ({ "zeug" }),
    "Schneidbretter, Siebe, Flaschenoeffner, ...");

  AddDetail( ({ "schneidbretter", "bretter", "siebe", "oeffner", 
    "flaschenoeffner" }),
    "Alles was man halt so braucht!");

  AddDetail( ({ "boden" }),
    "Auf den ersten Blick erscheint hier alles sauber...");

  AddDetail( ({ "blick" }),
    "Einen zweiten wuerde ich gar nicht werfen wollen :)");

  AddDetail( ({ "schweres" }),
