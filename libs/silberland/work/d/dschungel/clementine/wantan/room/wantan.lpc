  AddDetail( ({ "sessel" }),
    "Setz Dich doch mal!");

// SMELLS

  AddSmell(DEFAULT_SMELL, "Es riecht nach frisch gebratenem leckeren Essen!");
  
  AddSmell( ({ "essen" }),
    "Lecker! Du bekommst Lust auf mehr!");

// SOUNDS

  AddSound(DEFAULT_SOUND, "Immer wieder vernimmst Du ein Rascheln, manchmal "
    "auch seltsame Laute und Schreie...");

  AddSound( ({ "rascheln" }),
    "*raschel* *raschel*");

  AddSound( ({ "laute", "schreie" }),
    "Irgendwer moechte anscheinend nicht zu Essen verarbeitet werden. ");

  AddSound( ({ "tosen", "rauschen" }),
    "Du haeltst Dein Ohr ganz nah an das Bild. Wirklich! Es rauscht! "
    "Scheint wohl batteriebetrieben zu sein!"); 

 
    


// COMMANDS

  AddCmd( ({ "schleck", "schlecke" }), "c_schlecken");
  AddCmd( ({ "zieh", "ziehe" }), "c_ziehen"); //ziehe hebel reiskocher
  AddCmd( ({ "bau", "baue" }), "c_bauen"); //bierdeckelhaus 
  AddCmd( ({ "greif", "greife" }), "c_greifen"); //in schatzkiste im aquarium
  AddCmd( ({ "kost", "koste" }), "c_kosten");
  AddCmd( ({ "heb", "hebe" }), "c_heben");
  AddCmd( ({ "dreh", "drehe" }), "c_drehen");
  AddCmd( ({ "bestaun", "bestaune" }), "c_bestaunen");
  AddCmd( ({ "setz", "setze", "sitz" }), "c_setzen");
  AddCmd( ({ "steh", "stehe" }), "c_stehen");
  AddCmd( ({ "bewunder", "bewundere" }), "c_bewundern");

  
  spieler_sessel = ({ });

}

int exit_test(string dir)
{
 if(!TP)              return 1;
 if(!interactive(TP)) return 1;

 if(member(spieler_sessel, getuuid(TP)) == -1) return 1;
 write(BS("Du sitzt doch noch auf einem Sessel!"));
 return 0;
}

int c_schlecken(string str)
{
 if(str != "messer ab"     &&
    str != "kuechenmesser ab" )
 {
  notify_fail("Was moechtest Du abschlecken?!\n");
  return 0;
 }
 else
 {
  write(BS("Du schleckst etwas Blut vom Kuechenmesser. Mhjam! Schmeckt nach "
    "Hund!"));
  say(CTPN+ " schleckt begeistert Hundeblut von einem Messer.\n");
  return 1;
 }
}



int c_greifen(string str)
{
 if( str != "in schatztruhe" &&
     str != "in truhe"       )
 {
  notify_fail("Wohin moechtest Du greifen?\n");
  return 0;
 }
 else
 {
  write(BS("Du steckst Deine Hand ins Aquarium, vorbei an den glitschigen "
    "Fischen direkt in die Schatztruhe. Du ertastest etwas Schweres... Aua! "
    "Ein Fisch hat Dich gebissen, und Du ziehst die Hand wieder raus. "));
  TP->do_damage(20+random(10), this_object());
  say(CTPN+ " plantscht im Kinderbecken.\n");
  return 1;
 }
}


int c_ziehen(string str)
{
 if( str != "hebel"    &&
     str != "an hebel" )
 {
  notify_fail("Woran moechtest Du ziehen?\n");
  return 0;
 }
 else
 {
  write(BS("Heimlich still und leise ziehst Du schnell an dem Hebel. Auf "
    "einmal beginnt der Reiskocher laut zu blubbern und zu schaeumen. "
    "Schnell schiebst Du den Hebel wieder in seine Ausgangsposition "
    "zurueck. "));
  say(CTPN+ " sieht sich seltsam um.\n");
  return 1;
 }
}

int c_bauen(string str)
{
 if( str != "haus aus deckel"   &&
     str != "bierdeckelhaus"    &&
     str != "haus aus bierdeckel" )
 {
  notify_fail("Was moechtest Du woraus bauen?!\n");
  return 0;
 }
 else
 {
  write(BS("Froehlich stapelst Du die Deckel uebereinander. Jetzt nur "
     "nicht zittern. Grrr! Jetzt hast Du Dein tolles Haus doch glatt "
     "selbst zerstoert. "));
  say(CTPN+ " wuenscht sich zum Geburtstag Bierdeckel!\n");
  return 1;
 }
}


int c_kosten(string str)
{
 if( str != "rotes etwas" &&
     str != "rotes"       )
 {
  notify_fail("Was moechtest Du kosten?\n");
  return 0;
 }
 else
 {
  write(BS("Du kostest das rote Etwas! Scheint "
        "wohl Sambal Oelek zu sein. "));
  TP->command_me("-allgemein WUAH SCHAAAAAAAAAAAAAAAAAAAAAAAAAAAAARF!!!");
  return 1;
 }
}
 

int c_heben(string str)
{
 if(str != "deckchen auf"            &&
    str != "bambusdeckchen auf"      &&
    str != "platzdeckchen auf"       &&
    str != "bambusplatzdeckchen auf" &&
    str != "platzdecke auf"          &&
    str != "decke auf"               &&
    str != "bambusdecke auf"         &&
    str != "bambusplatzdecke auf"    )
 {
  notify_fail("Was moechtest Du aufheben?\n");
  return 0;
 }
 else
 {
  write(BS("Du hebst das Deckchen auf, und siehst darunter einen kleinen "
       "Zettel: Made in China!"));
  say(CTPN+ " macht sich am Tisch zu schaffen.\n");
  return 1;
 }
}



int c_drehen(string str)
{
 if( str != "bild um" )
 {
  notify_fail("Was moechtest Du umdrehen?\n");
  return 0;
 }
 else
 {
  write(BS("Du drehst das tolle Bild um, und stellst mit Entsetzen fest, dass "
        "das Tosen und Rauschen nicht von Batterien stammt, sondern von einer "
        "kleinen Kakerlakenfamilie, die sich dort ihr Nest gebaut hat. "));
  say(CTPN + " fummelt an der Westwand rum, und schuettelt sich danach.\n");
  return 1;
 }
}


int c_bestaunen(string str)
{
 if(str != "bild"                &&
    str != "wasserfall"          &&
    str != "bild von wasserfall" &&
    str != "wasserfallbild"       )
 {
  notify_fail("Was moechtest Du bestaunen?\n");
  return 0;
 }
 else
 {
  write(BS("Voller Bewunderung musterst Du das Bild des Wasserfalls. "
           "Wirklich absolut toll!"));
  say(CTPN+ " bewundert das tolle Wasserfallbild.\n");
  return 1;
 }
}


int c_setzen(string str)
{
 notify_fail("Worauf moechtet Du Dich setzen?\n");

 if(!str || str == "") return 0;
 if(!(str == "auf sessel" )) return 0;

 if(member(spieler_sessel, getuuid(TP)) != -1)
 {
  tell_object(TP, BS("Aber Du sitzt doch schon!"));
  return -1;
 }

 if(sizeof(spieler_sessel) >= MAX_PERSONEN)
 {
  write(BS("Leider ist hier kein Platz mehr."));
  return -1;
 } 

 spieler_sessel += ({ getuuid(TP) });
 write(BS("Du setzt Dich auf einen Sessel."));
 say(CTPN+ " setzt sich auf einen Sessel.\n");
 return 1;
 }

int c_stehen(string str)
{
 notify_fail("Wovon moechtest Du aufstehen?\n");

 if(!str || str == "") return 0;
 if(!(str == "auf"            ||
      str == "von sessel auf" )) return 0;

 if(member(spieler_sessel, getuuid(TP)) == -1)
 {
  write(BS("Aber Du sitzt doch gar nirgends!\n"));
  return -1;
 }
 
 spieler_sessel -= ({ getuuid(TP) });
 write(BS("Du stehst wieder auf.\n"));
 say(CTPN+ " steht wieder auf.\n");
 return 1;
}
 
void BecomesNetDead(object player)
{
 if(member(spieler_sessel, getuuid(player)) != -1)
 {
  spieler_sessel -= ({ getuuid(player) });
  tell_room(TO, player->Name()+" nickt ein und purzelt vom Sessel.\n");      
 }
}

void NotifyPlayerDeath(object player, object killer, int lost_xp)
{
 spieler_sessel -= ({ getuuid(player) });
}



int c_bewundern(string str)
{
 if( str != "faecher"        &&
     str != "plastikfaecher"  )
 {
  notify_fail("Was moechtest Du hier Tolles bewundern?\n");
  return 0;
 }
 else
 {
  write(BS("Du schaust gebannt auf den Faecher und bewunderst ihn. So etwas "
           "Schoenes moechtest Du auch besitzen!"));
  return 1;
 }
}


