

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../dante.h"

create()
{

::create();

  SetProp(P_INT_SHORT, "Im Dschungel");
  SetProp(P_INT_LONG,
    "Die hohe Luftfeuchtigkeit ist unertraeglich. Die dichte Vegetation "
    "macht hier ein Durchkommen kaum moeglich. Der Boden ist aeusserst "
    "schlammig, vereinzelt siehst Du aber auch Steine. Im Norden steht eine "
    "kleine Huette, ueber deren Eingang ein Schild haengt. "
    "Fenster hat sie zwar keine, aber vielleicht kannst Du Dich dort ein "
    "wenig ausruhen, bevor Du zu neuen Taten aufbrichst. ");
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 42, ENV_TERRAIN: TT_JUNGLE ]));
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);
 
  AddExit( "osten", ROOM "anschluss2");
  AddExit( "norden", ROOM "wantan");


// DETAILBEGINN

  AddDetail( ({ "steine" }),
    "Ob das wirklich Steine sind, die da im schlammigen Boden stecken?! "
    "Du solltest sie Dir wirklich mal genauer ansehen. ");

  AddDetail( ({ "boden" }),
    "Der Boden ist ekelhaft schlammig, sodass Du deutliche Fusspuren "
    "hinterlaesst. Nur vereinzelt stecken auch ein paar Steine in ihm. ");

  AddDetail( ({ "fussspuren", "fusspuren", "spuren" }),
    "Du erkennst ganz deutlich die Spuren Deines Fusses. ");

  AddDetail( ({ "fuss" }),
    ([ 0: "Jaja, Du hast wirklich einen tollen Fuss.",
       "zwerg" : "Jaja, ein toller Zwergenfuss.",
       "elf" : "Ein phantastisch schoener Elfenfuss.",
       "hobbit" : "Ein huebsch behaarter Hobbitfuss.",
       "dunkelelf" : "Ein schmutzig schwarzer Dunkelelfenfuss.", 
       "troll" : "Ein behaarter Trollfuss.",
       "oger" : "Ein stinkender Ogerfuss.",
       "mensch" : "Ein wohlgeformter Menschenfuss." ]) );
 
  AddDetail( ({ "menschenfuss", "ogerfuss", "dunkelelfenfuss", "trollfuss",
    "zwergenfuss", "elfenfuss", "hobbitfuss" }),
    "Sieht ja wirklich praechtig aus!");

  AddDetail( ({ "spuren" }),
    "Welche meinst Du?!");

  AddDetail( ({ "weg" }),
    "Der Weg endet hier. Weiter geht es einfach nicht nach Westen. Du "
    "koenntest allerdings die Huette im Norden betreten. ");

  AddDetail( ({ "durchkommen" }),
    "Hier gehts einfach nicht mehr weiter. Die Vegetation ist viel zu dicht, "
    "nicht einmal mit Machete wuerdest Du hier weiterkommen. ");

  AddDetail( ({ "machete" }),
    "Du koenntest es natuerlich probieren mit einer Machete alles "
    "frei zu schlagen, aber ob das Sinn macht...");

  AddDetail( ({ "sinn" }),
    "Den wuerdest Du dabei vergeblich suchen. ");

  AddDetail( ({ "himmel" }),
    "Dichtes Blaetterwerk befindet sich hoch ueber Dir, sodass man das "
    "Blau des Himmels nur erahnen kann. ");

  AddDetail( ({ "blau" }),
    "Da Du kein Prasseln hoeren kannst, muss der Himmel ja blau sein. ");

  AddDetail( ({ "prasseln" }),
    "Du hoerst keines, was heisst, dass es nicht regnet, was wiederum heisst, "     "das der Himmel ueber Dir klar sein muesste. ");

  AddDetail( ({ "regen" }),
    "Keiner vorhanden. ");

  AddDetail( ({ "taten" }),
    "Der Dschungel schreit foermlich danach von Dir erkundet zu werden. ");

  AddDetail( ({ "dschungel" }),
    "Der umgibt Dich - oder dachtest Du, Du stehst im Polar?!");

  AddDetail( ({ "polar" }),
    "Dort waer Dir aber mit Sicherheit kalt. ");

  AddDetail( ({ "sicherheit" }),
    "Garantiert!");

  AddDetail( ({ "eingang" }),
    "Ueber dem Eingang der Huette befindet sich ein grosses Schild. ");

  AddDetail( ({ "schild" }),
    "Es ist ziemlich riesig, und falls Du des Lesens maechtig bist, dann "
    "wuerde ich es an Deiner Stelle damit probieren. Unter dem Schild "
    "haengt ausserdem noch ein kleines unscheinbares Plakat. ");

  AddDetail( ({ "plakat" }),
    "Lies doch mal!");

  AddDetail( ({ "stelle" }),
    "Probiers doch einfach!");

  AddDetail( ({ "lesen" }),
    "Das waere von Vorteil!");

  AddDetail( ({ "vorteil" }),
    "Ich weiss, dass Du lesen kannst! Sonst koenntest Du nicht so sinnlose "
    "Details untersuchen. ");

  AddDetail( ({ "details" }),
    "Hey, alles was Du untersuchen koenntest, sollte ich eigentlich "
    "beschreiben - also tu mir den Gefallen, und lass das!");

  AddDetail( ({ "gefallen" }),
    "Also gut abgerichtet bist Du nicht. Und deshalb beenden wir dieses "
    "Untersuchespiel jetzt. ");

  AddDetail( ({ "untersuchespiel", "spiel" }),
    "Wie koennte man dieses Spiel schoener beenden, als mit einer huebschen "
    "kleinen niedlichen Scriptfalle. ");

  AddDetail( ({ "scriptfalle" }),
    "Ich koennte jetzt ein ganz tolles Wort aufschreiben, und Du wuerdest "
    "beim Untersuchen Lebenspunkte abgezogen bekommen. ");

  AddDetail( ({ "lebenspunkte" }),
    "Naja, Du hast eh soviele...");

  AddDetail( ({ "untersuchen" }),
    "Na was glaubst Du machst Du grad? Daeumchen drehen?!");

  AddDetail( ({ "daeumchen" }),
    "Du hast gar keine Daeumchen sondern fette Pranken!");

  AddDetail( ({ "pranken" }),
    "Haesslich fett und grausam!");

  AddDetail( ({ "wort" }),
    "Dashieristjetzteinganztolleswort, wenn Du es untersuchst dann tret ich "
    "Dich!");

  AddDetail( ({ "dashieristjetzteinganztolleswort" }),
    "Clementine tritt Dich aus der Ferne. ");

  AddDetail( ({ "clementine" }),
    "Die beste Magierin der Welt!");

  AddDetail( ({  "magierin" }),
    "Sie ist aeusserst inkompetent und doof ;)");

  AddDetail( ({ "ferne" }),
    "Clementine tritt Dich auch gerne aus der Naehe!");

  AddDetail( ({ "naehe" }),
    "Haha, das ist ja alles so lustig, ich sterb gleich vor lauter Lachen!");

  AddDetail( ({ "lachen" }),
    "Du bekommst fuer das Forschen hier weder einen Forscherpunkt noch sonst "
    "etwas, also gib auf!");

  AddDetail( ({ "forschen", "forscherpunkt", "punkt" }),
    "Nix gibts!");

  AddDetail( ({ "welt" }),
    "Die Welt die Welt ist kunterbunt, sie hat zwei Augen, Nas und Mund...");

  AddDetail( ({ "augen", "nas", "nase", "mund" }),
    "Dir wird langweilig. ");
 
  AddReadDetail( ({ "schild" }),
    "+---------------------------------------+\n"
    "| Willkommen in Wan Lings Frittiererei! |\n"
    "+---------------------------------------+\n");

  AddReadDetail( ({ "plakat" }),
    "+------------------+\n"
    "|   AMIGO ANIMAL   |\n"
    "|    TIERFREUND    |\n"
    "|    AMI ANIMAL    |\n"
    "|  AMICO ANIMALE   |\n"
    "| DIERLIJKE VRIEND |\n"
    "|  ANIMAL FRIEND   |\n"
    "+------------------+\n");

  AddDetail( ({ "luftfeuchtigkeit" }),
    "Hier ist es wahnsinnig stickig, und bald hast Du sicherlich auch alles "
    "nass geschwitzt. ");

  AddDetail( ({ "blaetterwerk", "blaetter" }),
    "Durch das dichte Blaetterwerk laesst sich der Himmel nur erahnen. ");

  AddDetail( ({ "fenster" }),
    "Die Huette hat definitiv keine Fenster. ");

  AddDetail( ({ "norden" }),
    "Dort steht eine Huette. ");

  AddDetail( ({ "westen", "sueden" }),
    "Da gehts nicht weiter.");

  AddDetail( ({ "osten" }),
    "Da kommst Du zurueck in bewohntere Gegenden. ");

  AddDetail( ({ "gegenden", "gegend" }),
    "Hier moechtest Du nicht unbedingt Dein restliches Leben verbringen...");

  AddDetail( ({ "leben" }),
    "Du bist schon lange nicht gestorben...");

  AddDetail( ({ "huette" }),
    "Im Norden steht eine Huette, die zwar keine Fenster aufweist, dafuer "
    "kommen ziemlich leckere Gerueche aus dieser Richtung. Vielleicht "
    "bekommst Du dort ja einen kleinen Happen zu essen. ");

  AddDetail( ({ "happen" }),
    "Der wuerde Dir jetzt wirklich gut tun!");

  AddDetail( ({ "gerueche" }),
    "Es riecht wirklich herrlich. Schnell husch husch in die Huette hinein. ");

  AddDetail( ({ "richtung" }),
    "Aus nordlicher Richtung dringen wunderbare Gerueche an Deine Nase. Mjamm, "
    "lecker!");

  AddDetail( ({ "nase" }),
    "Welch herrliche Koestlichkeiten Du doch mit Deiner Nase riechen kannst. ");

  AddDetail( ({ "koestlichkeiten" }),
    "Riecht alles wunderbar, und schmeckt hoffentlich auch ebenso. ");

  AddDetail( ({ "vegetation" }),
    "Dicht aneinander gereiht stehen hier die Baeume und Pflanzen des "
    "Dschungels. Hier kommt man wirklich nicht mehr weiter. ");

  AddDetail( ({ "baeume", "pflanzen" }),
    "Meterhohe Urwaldriesen umgeben Dich, umwachsen von Schlingpflanzen, und "
    "anderen Gewaechsen. Dazwischen siehst Du immer wieder kleinere Pflanzen, "
    "allerdings haben diese spitze Dornen. ");

  AddDetail( ({ "dornen" }),
    "Deren Bekanntschaft moechtest Du nicht machen!");

  AddDetail( ({ "bekanntschaft" }),
    "Die von den Dornen moechtest Du nicht machen. ");

  AddDetail( ({ "schlingpflanzen", "lianen" }),
    "Einige Schlingpflanzen und Lianen umwachsen die Baeume und Pflanzen "
    "hier. ");

  AddDetail( ({ "gewaechse" }),
    "Alles hier ist gruen und undurchdringlich. ");

  AddDetail( ({ "urwaldriesen" }),
    "Die Baeume hier sind sicherlich schon steinalt und wirklich ziemlich "
    "riesig. ");


// SMELLS

  AddSmell(DEFAULT_SMELL, "Aus dem Norden kommt ein total leckerer "
    "Geruch. Es riecht nach frittiertem Fleisch. Mjamm!!!");

  AddSmell( ({ "geruch" }),
    "Koestlich!");

  AddSmell( ({ "koestlichkeiten" }),
    "Riecht phantastisch!");

  AddSmell( ({ "fleisch" }),
    "Auf sowas haettest Du jetzt richtig Lust!");

  AddSmell( ({ "norden" }),
    "Dort riecht es toll!");



// SOUNDS  

  AddSound(DEFAULT_SOUND, "Zwischen dem Rascheln der Pflanzen vernimmst Du "
    "immer wieder Schreie von Tieren. ");

  AddSound( ({ "rascheln" }),
    "Manchmal rascheln die Pflanzen. ");

  AddSound( ({ "schreie" }),
    "Hier scheinen wohl mehrere Tiere in der Naehe zu sein. Zumindest hoerst "
    "Du alle moeglichen Tierlaute.");

  AddSound( ({ "tierlaute", "tiere", "laute" }),
    "Du vernimmst Kraechzen, Surren und wildes Gebruelle. ");

  AddSound( ({ "kraechzen", "surren" }),
    "Es kommt aus den Baeumen. Anscheinend leben dort einige Voegel. ");

  AddSound( ({ "voegel" }),
    "*krakrakra*");
 
  AddSound( ({ "gebruelle" }),
    "Es kommt aus dem Norden, und klingt so als haette ein Tier fuerchterliche "
    "Schmerzen. ");

  AddSound( ({ "schmerzen", "tier", "norden" }),
    "Das Tier wird sicherlich bald von seinen Schmerzen erloest sein ;)");
 

// COMMANDS

  AddCmd( ({ "zieh", "ziehe" }), "c_ziehen");


}  

int c_ziehen(string str)
{
 if( str != "stein aus schlamm" )
 {
  notify_fail("Was moechtest Du woraus ziehen?\n");
  return 0;
 }
 else
 {
  write(BS("Du ziehst etwas an dem Stein, und stellst mit Entsetzen fest, "
    "dass sich der sogenannte Stein als kleiner Knochen erweist, der "
    "einstmals einem Haustier gehoerte. Angewidert wirfst Du ihn weg!"));
  say(CTPN+ " ekelt sich.\n");
  return 1;
 }
}


