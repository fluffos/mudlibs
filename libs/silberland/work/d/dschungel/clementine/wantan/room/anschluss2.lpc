
inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../dante.h"


create()
{

::create();

  SetProp(P_INT_SHORT, "Im Dschungel");
  SetProp(P_INT_LONG,
    "Du befindest Dich mitten im Dschungel. Wo Du auch hinsiehst, ueberall "
    "dichte Vegetation. Riesige Mammutbaeume, die schon etliche Jahre alt "
    "sind wechseln sich mit unzaehligen Bueschen, Blumen und anderem "
    "Wucherzeug ab. Ein Kraechzen und Surren dringt an Dein Ohr. "
    "Nach Osten hin scheint sich der schlammige Pfad zu lichten, im "
    "Westen scheinen die Pflanzen sogar noch dichter zu stehen. ");
   
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 37, ENV_TERRAIN: TT_JUNGLE ]) );
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 0);

  AddExit( "osten", ROOM "anschluss");
  AddExit( "westen", ROOM "anschluss3");

  AddCmd( ({ "zwaeng", "zwaenge" }), "c_zwaengen");


// DETAILBEGINN

  AddDetail( ({ "dschungel" }),
    "Ueberall wo Du hinschaust nur Dschungel! Und Du stehst mitten drinnen!");

  AddDetail( ({ "boden", "pfad" }),
    "Der Boden unter Dir ist ziemlich weich, und bietet somit aber auch die "
    "ideale Unterlage fuer die hier angesiedelten Pflanzen. ");

  AddDetail( ({ "pflanzen" }),
    "Selten zuvor hast Du so eine Vielfalt an verschieden wachsenden "
    "Pflanzen gesehen. Keine gleicht der anderen, jede ist anders. Hier "
    "ist noch die Natur Herrin der Lage. ");

  AddDetail( ({ "natur" }),
    "Die Natur ist die einzige, die hier etwas veraendert. ");

  AddDetail( ({ "herrin", "lage" }),
    "Weit und breit nichts 'zivilisiert' Abgerodetes zu sehen. ");

  AddDetail( ({ "abgerodetes" }),
    "Nichts davon ist hier zu sehen. Hier herrscht nur die Natur. ");

  AddDetail( ({ "vielfalt", "pflanzenvielfalt" }),
    "Die Pflanzenvielfalt ist wirklich enorm!");

  AddDetail( ({ "himmel" }),
    "Der Himmel ist hoch ueber Dir, und wird teilweise von dem dichten "
    "Geaest der Baeume verdeckt. ");

  AddDetail( ({ "geaest" }),
    "Dichtes Blaetterwerk thront in den Kronen der Baeume. In einer siehst "
    "Du etwas Seltsames.");

  AddDetail( ({ "seltsames" }),
    "Wirklich sehr seltsam...");

  AddDetail( ({ "baumkronen", "kronen", "baumkrone", "krone" }),
    "Sie sind hoch ueber Dir, und beherbergen sicherlich auch viele "
    "Voegel. ");

  AddDetail( ({ "voegel" }),
    "Von hier unten kannst Du leider keinen erkennen. ");

  AddDetail( ({ "unterlage" }),
    "Die ist genau richtig!");

  AddDetail( ({ "kraechzen", "surren" }),
    "Sehen kann man das nicht. Aber lausch einmal!"); //lauschen surren & co.

  AddDetail( ({ "pfad" }),
    "Er fuehrt nach Osten und nach Westen. Fuer die Richtung musst Du Dich "
    "schon allein entscheiden. ");

  AddDetail( ({ "richtung" }),
    "Waehle entweder A fuer Osten, oder B fuer Westen.");

  AddDetail( ({ "wucherzeug" }),
    "Du siehst Kletterpflanzen, Schlingpflanzen, Farne und anderes "
    "komisches Zeug mit Blaettern. ");

  AddDetail( ({ "blaetter" }),
    "Hier gibt es ganz viele verschiedene Blaetter.");

  AddDetail( ({ "zeug" }),
    "Ganz ganz viel komisches Zeug, dass Du noch nie zuvor gesehen hast. ");

  AddDetail( ({ "kletterpflanzen" }),
    "Die Kletterpflanzen ranken sich an den breiten Staemmen der Baeume "
    "hoch. ");

  AddDetail( ({ "farne" }),
    "Die Farne bedecken den Boden seitlich des Pfades. ");

  AddDetail( ({ "schlingpflanzen" }),
    "Davon gibt es hier etliche!");

  AddDetail( ({ "ohr" }),
    "Noch dran! Du koenntest es zum Lauschen benutzen!");

  AddDetail( ({ "lauschen" }),
    "Probier das doch mal!");

  AddDetail( ({ "jahre" }),
    "Die Baeume sind sicherlich uralt :)");

  AddDetail( ({ "vegetation" }),
    "Du bist von dichter Vegetation foermlich umgeben. ");

  AddDetail( ({ "staemme", "stamm" }),
    "Die Staemme der Baeume sind ziemlich breit und von einigen "
    "Kletterpflanzen umrankt. ");

  AddDetail( ({ "blaetterwerk" }),
    "Das Blaetterwerk in den Baumkronen ist sehr dicht, sodass Du dort oben "
    "kaum etwas erkennen kannst. ");

  AddDetail( ({ "etwas" }),
    "Wo ist etwas?!");

  AddDetail( ({ "buesche", "busch" }),
    "Im Norden stehen die Buesche besonders dicht, und man wurde sich beim "
    "Durchzwaengen sicherlich nur verletzen. ");

  AddDetail( ({ "durchzwaengen" }),
    "Du wuerdest Dir hoechstens ein paar Schrammen holen, wenn Du das "
    "versuchen wuerdest. ");

  AddDetail( ({ "schrammen" }),
    "Wird sicherlich weh tun!");

  AddDetail( ({ "norden" }),
    "Dort stehen die Buesche besonders dicht gedraengt. ");

  AddDetail( ({ "sueden" }),
    "Ueberall Dschungel!");

  AddDetail( ({ "osten", "westen" }),
    "Entweder gehst Du weiter nach Osten, oder nach Westen. Mehr "
    "Moeglichkeiten hast Du hier nicht. ");

  AddDetail( ({ "moeglichkeiten" }),
    "Oder gibt es vielleicht doch eine?!");

  AddDetail( ({ "blumen", "blume" }),
    "Hier wachsen viele verschiedene Blumen: rote, gelbe, gruene, blaue, "
    "weisse, schwarze, orange, rosane, ...");

  AddDetail( ({ "rote blumen", "gelbe blumen" }),
    "Die sind wirklich huebsch!");

  AddDetail( ({ "weisse blumen" }),
    "Ob das eine fleischfressende ist?!");

  AddDetail( ({ "fleischfressende" }),
    "Nein, ist keine...");

  AddDetail( ({ "schwarze blumen", "orange blumen" }),
    "Die sehen wirklich alle toll aus!");

  AddDetail( ({ "gruene blumen" }),
    "Die gruenen Blumen kann man fast nicht von den Farnen unterscheiden. ");

  AddDetail( ({ "blaue blumen" }),
    "Die sind aber ausserordentlich schoen. ");

  AddDetail( ({ "rosane blumen" }),
    "Huch, eine rosane Blume hat ja einen schwarzen Punkt!");

  AddDetail( ({ "punkt" }),
    "Eine der Blumen hat einen schwarzen Punkt!");

  AddDetail( ({ "rosane blume" }),
    "Die hat wirklich einen schwarzen Punkt. Wie man den wohl wegbekommt?!");

  AddDetail( ({ "baum", "mammutbaum", "baeume", "mammutbaeume" }),
    "Riesige Baeume thronen vor Dir in den Himmel. Ihre dicken Staemme halten "
    "die schweren Kronen. ");
     
  AddDetail( ({ "sommersprosse" }),
    "Die ist ja suuuuuuuuuuuuuuuuess!"); 

  AddDetail( ({ "fliegen" }),
    "Sehen kannst Du keine, aber hoeren!");


// SMELLS

  AddSmell(DEFAULT_SMELL, "Es riecht nach vielen verschiedenen Blumen "
    "und Pflanzen... Herrlich!");

  AddSmell( ({ "blumen" }),
    "Wie die duften!!!");

  AddSmell( ({ "duft" }),
    "Toll!");

  AddSmell( ({ "pflanzen" }),
    "Die Pflanzen riechen gruen?!");

  AddSmell( ({ "gruen" }),
    "Riecht halt nach Dschungel.");

  AddSmell( ({ "dschungel" }),
    "Eine wahre Fundgrube fuer 'Riecher' ");

  AddSmell( ({ "riecher" }),
    "Du riechst an Dir selbst, und stellst fest, dass Du Dich mal wieder "
    "waschen solltest. ");

  AddSmell( ({ "fundgrube", "grube" }),
    "Na also das geht garantiert nicht. ");

// SOUNDS

  AddSound(DEFAULT_SOUND, "Du hoerst ein Surren und Kraechzen. ");

  AddSound( ({ "surren" }),
    "Das Surren kommt aus dem Norden. ");

  AddSound( ({ "buesche" }),
    "Da scheinen wohl ein paar Fliegen hier Unwesen zu treiben...");

  AddSound( ({ "fliegen", "fliege" }),
    "*ssssssssss*");

  AddSound( ({ "norden" }),
    "Da kommt das Surren her. ");

  AddSound( ({ "kraechzen" }),
    "Das Kraechzen kommt aus einer Baumkrone. ");

  AddSound( ({ "baumkrone", "krone" }),
    "Die ist leider viel zu hoch oben, als das Du sie erlauschen koenntest. ");

    
// COMMANDS

  AddCmd( ({ "putz", "putze" }), "c_putzen");
  AddCmd( ({ "waehl", "waehle" }), "c_waehlen");
  AddCmd( ({ "kletter", "klettere", "klettre" }), "c_klettern");

}

int c_klettern(string str)
{
 if( str != "auf baum"          &&
     str != "baum hoch"         &&
     str != "auf baum hoch"     &&
     str != "in baumkrone"      &&
     str != "in krone"          &&
     str != "hoch"              )
 {
  notify_fail("Wohin moechtest Du klettern?\n");
  return 0;
 }
 else
 {
  write(BS("Du beginnst zu klettern, faellst aber kurze Zeit spaeter wieder "
    "runter. Tja, einfach zu ungeschickt!"));
  say(CTPN+ " will unbedingt einen Baum hochklettern.\n");
  return 1;
 }
}



int c_waehlen(string str)
{
 if( str != "a"  &&
     str != "b"  )
 {
  notify_fail("Was moechtest Du hier waehlen?!\n");
  return 0;
 }
 if( str == "a")
 {
  write(BS("Du waehlst den Weg nach Osten!"));
  TP->move(ROOM "anschluss", M_GO,
    "weg", "purzelt", "purzelt herein");
  return 1;
 }
 if( str == "b")
 {
  write(BS("Du waehlst den Weg nach Westen!"));
  TP->move(ROOM "anschluss3", M_GO,
    "weg", "purzelt", "purzelt herein");
  return 1;
 }
}



int c_putzen(string str)
{
 if( str != "rosane blume" )
 {
  notify_fail("Was moechtest Du hier putzen?!\n");
  return 0;
 }
 else
 {
  write(BS("Na geh! Lass doch der Blume ihre Sommersprosse!"));
  return 1;
 }
} 


int c_zwaengen(string str)
{
 if(str != "durch buesche")
 {
  notify_fail("Wodurch moechtest Du Dich zwaengen?\n");
  return 0;
 }
 else
 {
  write(BS("Muehevoll zwaengst Du Dich durch die Buesche. "));
  TP->move("/d/dschungel/clementine/koerperflicker/room/weg1", M_GO,
  "irgendwohin", "verschwindet", "zwaengt sich durch ein paar Buesche herein" );
  return 1;
 }
}

