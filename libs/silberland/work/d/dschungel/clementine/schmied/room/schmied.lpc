
//SCHMIEDE VON TUCI - eigentlich ne Buschhuette :) 

inherit "std/room";

#include <properties.h>
#include <language.h>
#include <moving.h>
#include "../dante.h"



void create()
{

  	::create();

	SetProp(P_INT_SHORT, "In einer Buschhuette");
	SetProp(P_INT_LONG, 
		"Du stehst mitten in Tucis kleiner Buschhuette. Sie ist "
	  	"recht spaerlich eingerichtet. Waende und Decke "
		"sind aus Buschmaterial gefertigt, ein kleines "
		"Fenster laesst das Tageslicht herein. Auf dem Boden "
		"siehst Du ein Fell liegen, das wohl als Schlafstaette "
		"dient. Ueber einer Feuerstelle baumelt ein geflickter "
		"Kessel, aus dem ein graesslicher Geruch kommt. Quer unter "
		"der Decke wurde eine Liane gespannt auf "
	        "der einige Knochen baumeln. Im Westen siehst Du "
		"das dichte Buschwerk durch das Du hereingekommen bist. ");
	SetProp(P_LIGHT, 1);
	SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 45, ENV_TERRAIN: TT_JUNGLE]) );
	SetProp(P_INDOORS, 1);
	SetProp(P_KILL_NAME, "Dichtes Buschwerk" );
 	SetProp(P_KILL_MSG, "Busch oder nicht Busch, das ist hier die Frage.");

	AddItem(NPC "tuci", REFRESH_DESTRUCT);
	

//DETAILS

	AddDetail( ({ "knochen in fluessigkeit", "knochen in bruehe" }),
	  "Igitt!!!!");

	AddDetail( ({ "feuerstelle", "stelle" }),
	  "Ueber der Feuerstelle baumelt ein geflickter Kessel.");

	AddDetail( ({ "feuer" }),
	  "Das Feuer lodert unter dem Kessel.");

	AddDetail( ({ "kessel" }),
	  "Der Kessel wurde zweifelsohne schon mehrmals geflickt. In ihm "
	  "koechelt eine stinkende Bruehe.");

	AddDetail( ({ "bruehe" }),
	  "Eine sehr undefinierbare Fluessigkeit. Sie stinkt bestialisch!");

	AddDetail( ({ "fluessigkeit", "fluessigkeiten" }),
	  "Was macht man mit Fluessigkeiten so?!");

	AddDetail( ({ "boden" }),
	  "Auf dem Boden liegt ein Fell.");

	AddDetail( ({ "fell" }),
	  "Vermutlich schlaeft Tuci auf dem Fell.");

	AddDetail( ({ "schlafstaette" }),
	  "Du vermutest, dass das Fell als Schlafstaette dient. Du "
	  "kannst Dich sicher auch mal drauf ausruhen.");

	AddDetail( ({ "geruch" }),
	  "Es stinkt!!!!!!");

	AddDetail( ({ "tageslicht", "licht" }),
          "Das etwas magere Tageslicht kommt durch das kleine Fenster.");

	AddDetail( ({ "fenster" }),
          "Das Fenster ist klein und eigentlich nicht mehr als ein Loch "
	  "in der Wand.");

	AddDetail( ({ "loch" }),
	  "Ein rundes Loch in der Wand - nennen wir es Fenster!");

	AddDetail( ({ "knochen" }),
	  "Mjamm...sehen ja sehr appetitlich aus! Du willst lieber "
	  "gar nicht wissen ob sie humanoiden Ursprungs sind. ");

	AddDetail( ({ "ursprung", "humanoider ursprung" }),
	  "Seltsam, dass Du nirgendwo passende Koepfe zu den Knochen "
	  "finden kannst.");

	AddDetail( ({ "koepfe", "kopf" }),
	  "Vielleicht solltest Du Tuci danach fragen.");

	AddDetail( ({ "versteck", "geheimversteck" }),
          "Wo ist eines?");

	AddDetail( ({ "dach", "decke" }),
	  "Das Dach ist aus diversen Einzelteilen aus dem Dschungel.");

	AddDetail( ({ "waende", "wand" }),
	  "Die Waende sind aus irgendwelchen Pflanzengemischen. ");

	AddDetail( ({ "gemische", "pflanzengemische" }),
	  "Die Waende sind aus typischen Dschungelsachen gefertigt.");

	AddDetail( ({ "dschungelsachen" }),
	  "Du tastet die Wand ab und fuehlst Dich genauso unwissend wie "
	  "zuvor.");

	AddDetail( ({ "buschhuette", "huette" }),
	  QueryProp(P_INT_LONG));

	AddDetail( ({ "buschwerk" }),
	  "Durch das Buschwerk im Westen bist Du irgendwie "
	  "hier hergekommen. Du kannst Dir sicherlich einen Weg "
	  "durchbahnen.");

	AddDetail( ({ "weg" }),
	  "Im Westen gehts irgendwie wieder durch.");

	AddDetail( ({ "westen" }),
	  "Im Westen siehst Du dichtes Buschwerk.");

	AddDetail( ({ "liane" }),
	   "Auf der Liane die unter die Decke gespannt wurde haengen "
	   "ein paar Knochen.");

	AddDetail( ({ "sachen" }),
	  "Welche Sachen?!");

	AddDetail( ({ "pflanzen", "pflanze" }),
          "Hier sind ueberall Pflanzen! Du stehst ja schliesslich mitten "
	  "im Dschungel!");

	AddDetail( ({ "einzelteile", "teile" }),
	  "Busch, Ast, Blatt, ...");

	AddDetail( ({ "ast", "blatt", "busch" }),
	  "Was erwartest Du im Dschungel?!");

	AddDetail( ({ "dschungel" }),
	  "Du stehst im Dschungel und Dir ist heiss. Eigentlich haettest "
	  "Du wirklich Lust auf ein Eis. ");

	AddDetail( ({ "eis" }),
	  "Waere jetzt wirklich lecker.");

	AddDetail( ({ "hitze" }),
	  "Grauslig heiss ist es hier. ");

	AddDetail( ({ "lust" }),
	  "Du hast jetzt Lust auf ein Eis. Worauf Du sonst noch Lust hast "
	  "will hier definitiv niemand wissen :)");

	AddDetail( ({ "tuci" }),
	  "Ist er nicht hier?");

	AddDetail( ({ "fleisch" }),
	  "An einigen Knochen haengt noch etwas Fleisch. Es verwest "
	  "sicherlich nicht erst seit einem Tag.");

	AddDetail( ({ "tag", "tage" }),
	  "Das Fleisch verwest sicherlich nicht nur seit einem Tag...");

	AddDetail( ({ "material", "buschmaterial" }),
	  "Die Huette wurde aus Blaettern, Aesten und anderen gefundenen "
	  "Dingen gebaut.");

	AddDetail( ({ "dinge", "ding" }),
	  "Naja irgendwelche Dinge braucht es schliesslich um alles zu "
	  "verputzen... Sonst haetten die Waende ja Loecher!!!");

	AddDetail( ({ "loecher" }),
	  "Es sind keine Loecher da - abgesehen vom Fenster. Die "
	  "Waende wurden fein saeuberlichst mit irgendeiner braunen "
	  "Masse verputzt.");

	AddDetail( ({ "braune masse", "masse" }),
	  "Willst Du wirklich wissen woher die braune Masse kommt? ;)");

	AddDetail( ({ "scheisse" }),
	  "Pass einfach auf, dass Du nicht an der Wand ankommst *gg*");
	
	AddDetail( ({ "blaetter", "aeste" }),
	  "Jaja, die sind ueberall!");

//SOUNDS

	AddSound(DEFAULT_SOUND,
	  "Du hoerst das Feuer knistertn und die komische Bruehe blubbern.");

	AddSound( ({ "feuer" }),
	  "Knisterdidum.");

	AddSound( ({ "knisterdidum", "knister", "knistern" }),
	  "*knister*");

	AddSound( ({ "bruehe" }),
	  "+blubb+ +blubb+");

	AddSound( ({ "blubbern", "blubb" }),
	  "BLUUUUUUUUUUUUUUUUUUUBB!");


//SMELLS

	AddSmell(DEFAULT_SMELL,
	  "Also irgendetwas stinkt hier echt gewaltig!");

	AddSmell( ({ "irgendetwas", "etwas" }),
	  "Igitt!!!!");

	AddSmell( ({ "geruch" }),
	  "Es stinkt wirklich ekelhaft. Fast so wie eine Mischung aus "
	  "Moschus mit Patchouli, Vanille und Rose!");

	AddSmell( ({ "mischung" }),
	  "Eine Mischung aus Moschus, Patchouli, Vanille und Rose wuerde "
	  "mindestens genauso stinken!!!");

	AddSmell( ({ "vanille", "rose", "patchouli", "moschus" }),
	  "Waeh, waeh, waeh!!!");

	AddSmell( ({ "knochen" }),
	  "Pfui!!! Die riechen nach verwesendem Fleisch!!!");

	AddSmell( ({ "fleisch" }),
	  "Wuah! Stinkig, grauslich, waehig!");


//COMMANDS


	AddCmd( ({ "beruehr", "beruehre", "komm", "komme" }), "c_ankommen");
	AddCmd( ({ "koste", "kost" }), "c_kosten");
        AddCmd( ({ "bahn", "bahne" }), "c_bahnen");
	AddCmd( ({ "ruh", "ruhe" }), "c_ausruhen");

}

int c_ankommen(string str)
{
	object ob;
	if(str != "an wand an"   &&
	   str != "an waenden an" )
	{
		notify_fail("Woran moechtest Du ankommen?\n");
		return 0;
	}
        if(present("\nstinki", this_player()))
        {
  		write(BS("Aber Deine Finger stinken doch eh schon!"));
  		return 1;
 	}
	else
	{
		write(BS("Mjamm lecker, immer mitten in die Scheisse "
			"rein, nicht wahr?!"));
		ob=clone_object(OBJ "stinki");
                ob->move(TP, M_NOCHECK);
		WLOG(LOG "stinki.log", " STINKI STINKI!");
		say(CTPN + " stinkt auf einmal.\n");
		return 1;
	}
}




int c_kosten(string str)
{
	if(str != "bruehe"    &&
	   str != "fluessigkeit" )
	{
		notify_fail("Was moechtest Du kosten?\n");
		return 0;
	}
	else
	{
		write(BS("Igitt!!! Gerade als Du versuchst ein "
			"wenig von der Fluessigkeit zu kosten siehst "
			"Du die schwimmenden Knochen darin."));
		say(CTPN + " schaut angewidert.\n");
		return 1;
	}
}



int c_ausruhen(string str)
{
	if(str != "auf fell aus")
	{
		notify_fail("Worauf moechtest Du Dich ausruhen?\n");
		return 0;
	}
	else
	{
		write(BS("Du bist ja nicht zum Faulenzen hier!!!!"
			"Forsch lieber!!"));
		return 1;
	}
}


int c_bahnen(string str)
{
	if(str != "weg"    &&
	   str != "weg nach westen"  &&
	   str != "weg durch gebuesch" &&
	   str != "weg durch buesche"  &&
	   str != "weg durch buschwerk" )
        {
		notify_fail("Was moechtest Du Dir bahnen?\n");
		return 0;
	}
	else
	{
		write(BS("Du bahnst Dir den Weg nach Westen. Allerdings "
			"ziehst Du Dir dabei einige Schrammen zu!"));

	
		TP->move("d/dschungel/clementine/koerperflicker/room/weg1", 
		 M_GO, "irgendwohin", "verschwindet",  
		"zwaengt sich durch einige Buesche herein" );
		TP->do_damage(20+random(10), this_object());
  		return 1;
		
	}
}

		

