//wir reparieren Keulen und Peitschen WHIP, CLUB, 

inherit "std/repair";
#include "../dante.h"



string remove_finger();

void create()
{
  if (!is_clone(TO)) return;


  repair::create();
  

  SetProp(P_SHORT, "Tuci");
  SetProp(P_LONG,
    "Vor Dir steht ein kleiner Einheimischer mit einem feschen Bastroeckchen. "
    "Um seinen Hals baumelt eine Knochenkette, an der Du sogar noch einige "
    "Fleischreste ausmachen kannst. Igitt! Seltsame Braeuche haben die im "
    "Dschungel! In Tucis Haenden siehst Du zudem noch eine riesige Keule, die "
    "Du definitiv nicht ueber den Kopf gezogen bekommen magst. Und trotzdem "
    "sieht Tuci eigentlich sehr freundlich aus! Er kann im Uebrigen auch "
    "so manches reparieren. " );

  SetProp(P_NAME, "Tuci");
  SetProp(P_GENDER, MALE);
  SetProp(P_ARTICLE, 0);

  AddId( ({ "tuci", "schmied","NOWIMPY" }) );
  set_living_name("tuci");

  create_default_npc(37);

  SetProp(P_HANDS, ({" mit seinen schmutzigen Haenden", 300, DT_BLUDGEON }));

  SetProp(P_SIZE, 210+random(20));
  SetProp(P_ALIGN, -160-random(50));
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 0);
  SetProp(P_WIMPY, 0);
  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:     -0.2, DT_COLD:      0.5, DT_WATER:       0.2
     , DT_AIR:      -0.2, DT_LIGHTNING: 0.0, DT_EXPLOSION:   0.0
     , DT_SOUND:    -0.2, DT_LIGHT:     0.1, DT_ELECTRIC:    0.0
     , DT_ACID:      0.0, DT_POISON:    0.0, DT_TERROR:     -0.5
     , DT_HOLY:      0.0, DT_UNHOLY:   -0.5, DT_MAGIC:      -0.5
     , DT_MIND:      0.0, DT_SLASH:    -1.0, DT_BLUDGEON:    0.0
     , DT_PIERCE:    0.0, DT_SQUEEZE:   0.0, DT_WHIP:       -1.0
     , DT_RIP:       0.0
     ])
  );

  SetProp(P_NOMAGIC,30);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:25,T_RANGE_MAX:55]));

  SetProp(P_MSGIN, "ist wieder da");
  SetProp(P_MSGOUT, "geht");

  SetProp(P_DIE_MSG,  " sackt tot zu Boden.\n");
  SetProp(P_MURDER_MSG, "Wirst Du kriegen Watsche mit Fuss!\n");
  SetProp(P_KILL_NAME, "Tuci" );
  SetProp(P_KILL_MSG, "Wumbala dunga dung!!!\n");

  AddDetail( ({ "bastrock", "bastroeckchen", "rock", "roeckchen" }), 
    "Sieht sehr fesch aus!!!");

  AddDetail( ({ "keule", "knochenkeule" }),
    "Ob sie wohl gut in der Hand liegt?");

  AddDetail( ({ "kette", "knochenkette" }),
    "So nah kommst Du einfach nicht ran!");
 
  AddInfo(DEFAULT_INFO, "fragt: Was Du wollen von mir?\n");

  
  AddInfo( ({ "finger" }),
    "Du haben Stinkefinger?", "fragt: ");

  AddInfo( ({ "brauch", "braeuche" }),
    "Essen gerne Fleisch von Knochen!", "sagt: ");

  AddInfo( ({ "dschungel" }),
    "Da Du seien gerade!", "sagt: ");

  AddInfo( ({ "hunger" }),
    "Fleisch seien gesund!", "sagt: ");

  AddInfo( ({ "stinkende finger", "stinkefinger" }), #'remove_finger, "sagt: ");

  AddInfo( ({ "clementine" }),
   "Clementine seien Fruechtchen.", "sagt: ");

  AddInfo( ({ "justavius" }),
    "Justavius immer kommen und fragen viel Klumpat!", "sagt: ");

  AddInfo( ({ "klumpat" }),
    "Ich nix wollen Klumpat!", "sagt: ");

  AddInfo( ({ "kopf", "koepfe" }),
    "Koepfe seien in Geheimversteck auf Dach!", "fluestert: ");

  AddInfo( ({ "geheimversteck", "versteck" }),
    "Ich Dir nix sagen!", "sagt: ");

  AddInfo( ({ "dach" }),
    "Dach seien aus Busch.", "sagt: ");

  AddInfo( ({ "busch" }),
    "Du ja sehen! Ueberall seinen Busch!", "sagt: ");

  AddInfo( ({ "arnold" }),
    "kratzt sich am Hintern.");

  AddInfo( ({ "carla" }),
    "Grosse Metzlarin seien!", "sagt: ");

  AddInfo( ({ "metzlarin", "metzlerin" }),
    "Magst Du auch schetzeln?!", "fragt: ");

  AddInfo( ({ "schnetzeln", "schnetzel" }),
    "grinst irre.");

  AddInfo( ({ "peitscha", "peitsche" }),  
    "Du brauchen heile machen?", "fragt: ");

  AddInfo( ({ "keule", "keula" }),
    "Ich repariera auch Keula!", "sagt: ");

  AddInfo( ({ "herschel" }),
    "Herschel immer trinken zuviel!", "sagt: ");

  AddInfo( ({ "reparatur", "reparieren", "repariere "}),
    "Wenn Du wollen ich machen heile Dein Keula oder Peitscha. Musst "
    "Du tippen 'repariere <name>'. Aber ich auch haben wollen Muenza!", 
    "sagt: ");

  AddInfo( ({ "rock", "bastrock", "bastroeckchen", "roeckchen" }),
    "Ich haben schoenste Rock von alle!", "sagt: ");

  AddInfo( ({ "muenza", "kohle", "geld", "muenzen", "muenze" }),
    "Ich haben wolla viel Geld!", "sagt: ");

  AddInfo( ({ "schmied", "tuci" }),
    "Was Du wolla von mir?",
    "grinst: ");

  AddInfo( ({ "schmiede" }),
    "Ich hier arbeiten. Ich bin Repariera!",
    "sagt: ");

  AddInfo( ({ "waren", "ware"}),
    "Ich nix Ware ich Arbeita!",
    "sagt: ");

  AddInfo( ({ "preis","preise"}),
    "Bitte Du lesen das Schild.",
    "sagt: ");

  AddInfo( ({ "wuahanga gugatat" }),
    "Ich Dir nix verraten geheima Formel!", "sagt: ");

  AddInfo( ({ "vergleichen", "vergleiche" }),
    "Ich Dir vergleicha zwei Sachen und sagen was anders.",
    "sagt: ");

  AddInfo( ({ "repariera", "spezialista" }),
    "Ich bin beste Repariera von Peitscha und Keula!",
    "sagt: ");

  AddInfo( ({ "name" }),
    "Ich heissen Tuci!",
    "sagt: ");

  AddInfo( ({ "knochen" }),
    "Ich brauchen fuer Rituale.", "sagt: ");

  AddInfo( ({ "ritual", "rituale" }),
    "Um zu Besaenftigen grossen Gott!", "sagt: ");

  AddInfo( ({ "gott" }),
    "Psssst!", "sagt: ");

  AddInfo( ({ "fell" }),
    "Seien mein Bett. ", "sagt: ");

  AddInfo( ({ "bett" }),
    "Fell!", "sagt: ");

  AddInfo( ({ "kessel" }),
    "Ist fuer Auskochen Knochen!", "grinst: ");

  AddInfo( ({ "auskochen" }),
    "Du mir schenken Dein Knochen?!", "grinst: ");

  AddInfo( ({ "kette", "knochenkette" }),
    "Ist noch Fleisch dran. Ist lecker!", "sagt: ");

  AddInfo( ({ "fleisch" }),
    "Du auch haben Hunger?", "fragt: ");

  AddInfo( ({ "wombala daka dung" }),
    "Was Du Komisches wollen?", "fragt: ");

  AddInfo( ({ "komisches", "komisch" }),
    "Ich nix haben Komisches!", "sagt: ");

  AddInfo( ({ "heft", "bilderheft" }),
    "Hat mir gegeben Razzi. Sind drinnen grosse Baelle!", "grinst: ");

  AddInfo( ({ "baelle" }),
    "Ich Dir nix zeigen!", "sagt: ");

  AddInfo( ({ "nackig", "nackige" }),
    "Tuci nicht seien nackig. Tuci haben Rock!", "sagt: ");

  AddInfo( ({ "razzi" }),
    "Razzi mir gegeben Bilderheft mit Nackige!", "grinst: ");

  AddInfo( ({ "zehe", "zehen" }),
    "Haben zwei Zehen!", "sagt: ");


  SetProp( P_REJECT, ({ REJECT_DROP,
    "Tuci will Dein Klumpert nicht.\n" }) );

  SetProp(P_SPELLRATE,30);

  AddSpell(5,300,
    "Tuci braet Dir mit seiner Keule eins ueber.\n",
    "Tuci braet @WEN mit seiner Keule eins ueber.\n",
     DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

  AddSpell(5,350,
    "Tuci versucht Dich unwillig zu machen.\n",
    "Tuci versucht @WEN unwillig zu machen.\n",
     DT_TERROR,([SP_SHOW_DAMAGE:1]));

  AddSpell(5,400,
    "Tuci gibt Dir einen Fusstritt zwischen die Beine.\n",
    "Tuci gibt @WEN einen Fusstritt zwischen die Beine.\n",
     DT_UNHOLY,([SP_SHOW_DAMAGE:1]));

  AddSpell(1,200,
    "Tuci springt Dich an und wuergt Dich.\n",
    "Tuci springt @WEN an.\n",
     DT_SQUEEZE,([SP_SHOW_DAMAGE:1]));

  AddSpell(1, 350,
    "Tuci murmelt: WUAHANGA GUGATAT!\n",
    "Tuci murmelt: WUAHANGA GUGATAT!\n",
    DT_MIND, ([SP_SHOW_DAMAGE:1]) );
  


  SetChats(1,
    ({"Tuci fragt Dich: Was Du wollen?\n",
      "Tuci schwingt seine Keule.\n",
      "Tuci sagt: Ich bin Repariera.\n",
      "Tuci kaut an seiner Knochenkette.\n",
      "Tuci sagt: Wombala daka dung!\n",
      "Tuci blaettert in einem Heft.\n",
      "Tuci spielt mit seinen Zehen.\n"
     })
  );

  SetAttackChats(10,
    ({"Tuci: Ich Dich nicht mag mehr!\n"
     ,"Tuci braet Dir mit der Keule eine ueber.\n"
     ,"Tuci tritt Dir gegen das Schienbein.\n"
     ,"Tuci murmelt seltsame Geheimformeln.\n"
     })
  );

  AddCmd( ({ "repariere", "reparatur" }), "reparatur");

  SUID;
  CLONEME(WEAPON "keule" );
  command("zuecke keule");
  CLONEME( ARMOUR "knochenamu" );
  CLONEME( ARMOUR "bastrock" );
  command("trage alles");

}

string remove_finger()
{
  object ob;
  if(ob=present("\nstinki",this_player()))
  {
   tell_object(TP,
        "Tuci waescht Dir Deine Haende.\n");
   ob->remove(1);
   return("Seien jetzt wieder sauber! ");
  }
  else
  {
   return("Du gar nicht haben Stinkefinger! ");
  }
}



varargs void die(int poisondeath)
{
  object enemy;

  if(enemy = QueryProp(P_KILLER))
  {
    write_file(LOG "spieler.kills",
      ctime()+": "+CAP(getuid(enemy))+" killt Tuci.\n");

  }

  ::die(poisondeath);
}




void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "spieler.deads", ctime()+": "+CAP(getuid(player))+
      " wurde von Tuci getoetet ("+lostexp+").\n");
  }
}


int rep_auswahl(object ob)
{
  if(ob->QueryProp(P_ARMOUR_TYPE))
  {
    write("Tuci sagt: Ich repariera nur Peitscha und Keula!\n");
    return 0;
  }
	
  if(ob->QueryProp(P_WEAPON_TYPE)!=WT_WHIP &&
     ob->QueryProp(P_WEAPON_TYPE)!= WT_CLUB )
  {
    write(BS("Tuci sagt: Ich nur repariera Peitscha und Keula!"));
    return 0;
  }
  return 1;
}


