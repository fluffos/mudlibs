inherit "std/weapon";

#include <properties.h>
#include <combat.h>

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Tucis Knochenkeule");
  SetProp(P_LONG, 
    "Diese Keule wurde aus einem ziemlich grossen Knochen gefertigt. "
    "Ihr Griff wurde mit Leder umwickelt. Da sie recht "
    "gross ist, kann man sie sicherlich nur mit zwei Haenden zuecken. ");
  SetProp(P_NAME, "Knochenkeule");
  SetProp(P_GENDER, FEMALE);
  AddId( ({ "keule", "knochenkeule" }) );

  SetProp(P_WEAPON_TYPE, WT_CLUB);
  SetProp(P_WC, 175);
  SetProp(P_WC_FIX, 40);
  SetProp(P_WC_BONUS,
    (["Keulenkaempfer":50, "Keulenexperte":150, "Keulenmeister":250]));
  SetProp(P_DAM_TYPE, DT_BLUDGEON );
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL, ([MAT_BONE:90, MAT_LEATHER:10]) );
  SetProp(P_WEIGHT, 3200);
  SetProp(P_VALUE, 1240);
  SetProp(P_SIZE, 90);
  SetProp(P_WIELD_RESTRICTIONS, ([A_STR:7]) );

  AddDetail( ({ "knochen" }),
    "Der ist ja riesig und wirklich massiv!");

  AddDetail( ({ "leder", "griff" }),
    "Der Griff ist mit Leder umwickelt, damit man nicht so leicht abrutscht.");

}

