inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include <language.h>
#include <new_skills.h>   
#include <mnpc.h>    
#include "../dante.h"

int anz_heil;

void reset()
{
	::reset();

	// balance fix Gwenshara 13.09.2020: nur mehr +1 heilung pro reset
	if(objectp(QueryProp(P_WORN)) && anz_heil < 3) {
		anz_heil = 3;
		tell_object(QueryProp(P_WORN), BS("Die Fleischreste auf der Knochenkette sehen wieder schmackhaft aus..."));
	} 

}


void create()
{
  	if (!is_clone(this_object()))
     	return;
  	::create();
  	anz_heil = 3;
	AddId (({ "knochenkette", "kette", "knochenamulett",}));
  	SetProp(P_SHORT, "Eine Knochenkette");
  	SetProp(P_LONG, 
  	"Diese Knochenkette wurde aus den Knochen mehrerer humanoider "
  	"Lebewesen angefertigt. Einst baumelte sie um Tucis Hals.");
  
 	AddDetail( ({ "knochen" }),
  	  "Igitt. An einigen Knochen haengen noch Fleischreste. ");

  	AddDetail( ({ "fleisch", "fleischreste", "reste" }),
  	  "Ob man an dem Fleisch noch nagen kann?");
      
  SetProp (P_NAME, "Knochenkette");
  SetProp (P_GENDER, FEMALE);
  SetProp (P_WEIGHT, 150);
  SetProp (P_VALUE, 5000+random(400));
  SetProp (P_NOBUY, 1);
  SetProp(P_NOSELL, 0);
  
  SetProp (P_ARMOUR_TYPE, AT_AMULET);
  SetProp (P_AC, 4);
  SetProp(P_INFO, 
   "Die Knochenkette kann einiges...\n");
  SetProp(P_MATERIAL, MAT_BONE);

  AddCmd( ({"nage", "nag" }), "c_nagen");
}

int c_nagen(string str)
{
	if(str != "an fleisch"      &&
	   str != "fleisch"         &&
	   str != "fleischreste"    &&
	   str != "an fleischresten" )
	{
		notify_fail("An was moechtest Du nagen?\n");
		return 0;
	}

	// balance fix 13.09.2020 - Gwenshara
	if(QueryProp(P_WORN) != this_player()) {
		write(BS("Dazu musst du die Kette tragen!"));
		return -1;
	}

	if(anz_heil<1)
	{
		write(BS("Du findest kein Fleisch mehr zum Nagen!"));
		return 1;
	}
	else
	{
		write(BS("Mjamm...lecker! Du nagst etwas Fleisch vom "
			"Knochen!"));
		TP->heal_self(10);
		anz_heil--;
		return 1;
	}
}

