
inherit "std/armour";

#include <properties.h>
#include <combat.h>
#include "../dante.h"

void create()
{
  if (!is_clone(this_object())) return;
  ::create();

  SetProp(P_SHORT, "Ein fesches Bastroeckchen");
  SetProp(P_LONG,
     "Ein total fesches Bastroeckchen. Es wurde aus diversen Pflanzen "
     "des Dschungels gefertigt und haengt ganz locker auf der Huefte. ");
  SetProp(P_NAME, "Bastroeckchen");
  SetProp(P_GENDER, NEUTER);
  AddId( ({ "bastrock", "bastroeckchen", "rock", "roeckchen" }));
  
  SetProp(P_ARMOUR_TYPE, AT_TROUSERS);
  SetProp(P_AC, 4);
  SetProp(P_MATERIAL, ([MAT_MISC_PLANT]) );
  SetProp(P_WEIGHT, 250);
  SetProp(P_VALUE, 90);
  SetProp(P_TEMPERATURE_PROTECTION, ([T_COLD_PROT: -2, T_HEAT_PROT:2]) );

  AddDetail( ({ "huefte" }),
    "Das Roeckchen sieht getragen sicher super aus!");

  AddDetail( ({ "pflanzen", "dschungel", "dschungelpflanzen" }),
    "Das Bastroeckchen wurde aus den unterschiedlichsten Pflanzen des "
    "Dschungels gefertigt! Schoen luftig!!");
}

