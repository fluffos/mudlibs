/*
  Zugang zu ArdulVhier, bewacht von K'yorl Okh Chak'ar
*/

// 07.07.2012 08:24:49 Anatol - long und detail "huette",
//     Seherhaeuser sollen nicht vollstaendig verborgen sein.

#pragma strong_types;

#include "../def.h"

inherit MOST "std_room";

#define MAXNUSS 3

#define TIJARA "/d/dschungel/feyaria/tijara/room/weg_a5"

nosave int kokosnuss;

void create() 
{
  ::create();
  
  SetProp(P_INT_SHORT, "Ein enger Durchgang");
  SetProp(P_INT_LONG,
          BS("Ein gewaltiger Felsen steht hier inmitten von riesigen Palmen "
	     "herum. Zusaetzlich ragen hinter Dir majestaetisch die "
	     "Stadtmauern von Tijara empor und lassen keine grossen "
	     "Bewegungsmoeglichkeiten offen. Eine angenehme Kuehle scheint "
	     "aus dem Loch in dem Felsen zu kommen. Was wohl da drin ist? "
	     "Vielleicht eine Hoehle? Ob die wohl bewacht wird? Zwischen "
         "Fels und Palmen steht ausserdem eine kleine Huette, die "
         "du in suedlicher Richtung betreten kannst."));

  AddDetail(({"huette","haus"}),
        "Das scheint Fausts alte Behausung zu sein - Du kannst "
        "sie nach Sueden sicher betreten.");
  AddDetail(({"boden","dschungelboden"}),
	    "Der feuchte Dschungelboden gibt bei jedem Schritt den Du machst "
	    "komische Geraeusche von sich.");

  AddDetail(({"gegend","dschungel"}),
	    "Der Dschungel und seine Geraeusche umgeben Dich.");

  AddDetail("himmel",
	    "Vom Himmel ist hier unten nicht sonderlich viel zu sehen, da "
	    "ihn die vielen Palmen verdecken.");

  AddDetail("palmen",
	    "Riesige Palmen stehen hier herum und verdecken groesstenteils "
	    "den Himmel. Hie und da haengen sogar Kokosnuesse daran.");

  AddDetail("palme",
	    "Welche meinst Du denn? Etwa die mit den vielen Kokosnuessen?");

  AddDetail(({"nuesse","kokosnuesse"}),
	    "Grosse Kokosnuesse haengen in den Palmen, ganz weit oben. "
	    "Ob man die vielleicht runterbekommen koennte?");

  AddDetail(({"papageien","papagei","vogel","voegel"}),
	    "Hier im Dschungel leben viele verschiedene Voegel.");

  AddDetail(({"tier","tiere"}),
	    "Der Dschungel wird von vielen, mehr oder weniger wilden "
	    "Tieren bevoelkert.");

  AddDetail(({"granitfelsen","felsen"}),
	    "Ein gewaltiger, moosbewachsener Granitfelsen steht hier in der "
	    "Gegend herum. Das Loch an seiner Seite koennte den Zugang zu "
	    "einer Hoehle darstellen...");

  AddDetail(({"moos","moose"}),
	    "Hie und da wachsen Moose auf dem grossen Granitfelsen, doch "
	    "sie haben eine seltsame gelbe Farbe...");

  AddDetail(({"kuehle"}),
	    "Dort in dem Loch scheint es recht kuehl zu sein.");

  AddDetail(({"loch","zugang","hoehle"}),
	    "Was Dich dort wohl erwartet?");

  AddDetail(({"seite"}),
	    "An der Seite des Granitfelsen ist ein ziemlich grosses, "
	    "dunkles Loch.");

  AddDetail(({"bewegungsmoeglichkeiten","bewegung","moeglichkeiten",
		"bewegungsmoeglichkeit","moeglichkeit"}),
	    "Die Bewegungsmoeglichkeiten hier sind extrem eingeschraenkt.");

  AddDetail(({"mauer","mauern","stadtmauer","stadtmauern"}),
	    "Gewaltig ragen sie vor Dir auf. Von hier wirken sie sogar "
	    "noch groesser als von innerhalb Tijaras. Der Spalt, durch den "
	    "Du gekrochen bist, scheint hier auch etwas breiter.");

  AddDetail(({"spalt","spalte"}),
	    "Sie scheint der einzige Ausweg zu sein, oder?");
  
  AddDetail(({"ausweg"}),
	    "Und was ist mit dem Loch in dem Felsen?");
  
  AddDetail(({"tijara","stadt"}),
	    "Tijara befindet sich innerhalb der Stadtmauern.");

  AddSound(DEFAULT_SOUND,
	   "Der gesamte Dschungel ist voll mit allerlei Geraeuschen...");

  AddSound(({"geraeusche"}),
	   "Hier hoerst Du einen Papagei rufen, dort hoerst Du irgendein "
	   "Tier bruellen und unter Dir vernimmst Du hin und wieder ein "
	   "schmatzendes Geraeusch, wenn Du einen Schritt machst.");

  AddSound(({"papageien","papagei"}),
	   "Da, wieder hat ein Papagei gerufen, hier scheinen wohl viele "
	   "zu leben.");

  AddSound(({"tiere","tier"}),
	   "Es gibt so viele verschiedene Tiere im Dschungel und deren "
	   "Geraeusche mischen sich andauernd, so kannst Du kein "
	   "bestimmtes Tier heraushoeren.");

  AddSound(({"schritt"}),
	   "*schmatz* *matsch*");

  AddSound("geraeusch",
	   "Welches genau meinst Du denn?");
  
  AddSmell(({"geruch",DEFAULT_SMELL}),
	   "Es riecht verfuehrerisch nach Kokosnuessen.");

  AddSmell(({"nuesse","nuss","kokosnuesse","kokosnuss"}),
	   "Hoch in den Palmen haengen reife Kokosnuesse und verbreiten "
	   "einen angenehmen Geruch. Einige ueberreife Kokosnuesse gammeln "
	   "bereits am Boden herum.");
  
  Licht("hell");
  Umgebung("heiss", TT_JUNGLE, 0);
  
  AddCmd(({"schuettel","schuettele","schuettle"}), "schuetteln");
  AddCmd(({"betritt","betrete"}), "betreten");
  AddCmd(CMD_KLETTERN, "klettern");
  AddCmd(CMD_KRIECHEN, "kriechen");
  
  kokosnuss=MAXNUSS;
  
  AddItem(NPC "drowdruid" , REFRESH_DESTRUCT);
}

void reset()
{
  ::reset();
  
  kokosnuss=MAXNUSS;
}

nosave int kriechen(string str)
{
  notify_fail(BS("Wo hinein willst Du kriechen?!"));
  if(!str) return 0;
  
  if(strstr(str, "in spalt")!=-1)
    {
      TP->do_exhaust(200);
      
      write(BS("Du bueckst Dich und kriechst in die dunkle Spalte zurueck. "
	       "Schnell erblickst Du auf der anderen Seite die Stadt "
	       "Tijara."));

      TP->move(TIJARA, M_GO|M_NO_SHOW, "ploetzlich direkt in der Stadtmauer",
	       "verschwindet", "kommt ploetzlich hereingekrochen");

      return 1;
    }
  
  return 0;
}

nosave int schuetteln(string str)
{
  notify_fail(BS("Was oder wen willst Du denn schuetteln?"));
  if(!str) return 0;
  
  if(str=="palme"||str=="palmen"||str=="riesige palme"||str=="riesige palmen")
    {
      write(BS("Du schuettelst einmal kraeftig an einer Palme..."));

      if(!random(3))
        {
          write("Durch Dein Geschuettle loest sich ploetzlich eine Kokosnuss "
		"von oben\nund kommt Dir entgegen!!!\n\n"
		"In letzter Sekunde springst Du auf die Seite und die "
		"Kokosnuss\nschlaegt hart am Boden auf"+
		(kokosnuss? "":" und zerspringt")+".\n");

          say(BS(TP->Name()+"  moechte eine Palme hochklettern, doch die "
		 "wehrt sich mit einer herabfallenden Kokosnuss!"), ({TP}));
	  
          if(kokosnuss)
            {
              CLONEME(OBJ "kokosnuss");
              kokosnuss--;
            }
        }
      else
        write(BS("Doch nichts passiert, wahrscheinlich bist Du einfach zu "
		 "schwach!"));
      
      return 1;
    }

  return 0; 
}

nosave int klettern(string str)
{
  notify_fail("Wohin willst Du denn klettern?\n");
  if(!str) return 0;
  
  if(str=="hoehle"||str=="in hoehle"||str=="felsen"||str=="in felsen"||
     str=="loch"||str=="in loch")
    return write(BS("In eine Hoehle klettert man nicht! Man betritt sie!")), 1;
  
  if(str=="palme"||str=="auf palme"||str=="auf riesige palme")
    {
      write("Du suchst Dir eine Palme aus und beginnst sie hochzuklettern..."
	    "\n\nDurch Dein Geschuettle loest sich ploetzlich eine Kokosnuss "
	    "von oben\nund kommt Dir entgegen!!!\n\n"
            "In letzter Sekunde springst Du auf die Seite und die Kokosnuss\n"
            "schlaegt hart am Boden auf"+
	    (kokosnuss? "":" und zerspringt")+".\n");

      say(BS(TP->Name()+"  moechte eine Palme hochklettern, doch die wehrt "
	     "sich mit einer herabfallenden Kokosnuss!"), ({TP}));
      
      if(kokosnuss)
        {
          CLONEME(OBJ "kokosnuss");
          kokosnuss--;
        }
      
      return 1;
    }

  return 0;
}

nosave int betreten(string str)
{
  notify_fail("Was willst Du denn betreten?\n");
  if(!str) return 0;
  
  if(str=="hoehle"||str=="felsen"||str=="granitfelsen"||str=="loch")
    {
      if((TP->QueryProp(P_RACE)!="Dunkelelf") && present("kyorl"))
	if((HZM->Vorbereitungen()) && (HZM->Eingeladen(getuid(TP))))
	  write("K'yorl Okh Chak'ar meint: Ihr duerft passieren!");
	else
	  return write("K'yorl Okh Chak'ar laesst Dich nicht passieren!\n"), 1;
      
      write(BS("Du betrittst die kuehle Hoehle."));
      
      say(BS(TP->Name()+" betritt die Hoehle."), ({TP}));
      
      tell_room(ROOM "hoehlenportal", BS(TP->Name()+" betritt die Hoehle."));
      
      TP->move(ROOM "hoehlenportal", M_NOCHECK|M_SILENT);
      
      return 1;
    }
  
  return 0;
}

varargs string GetExits(object viewer)
{
  return "Du kannst jederzeit wieder in den Spalt kriechen.\n";
}
