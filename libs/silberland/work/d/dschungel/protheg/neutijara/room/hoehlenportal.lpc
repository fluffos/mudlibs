/*
  Zugang zu ArdulVhier, Hoehlenportal fuer Delfen billiger
*/

#pragma strong_types;

#include "../def.h"

inherit MOST "std_room";

#define ANSCHLUSS "/d/unterwelt/protheg/avmitte/room/portal"
#define DHRKION "/d/unterwelt/zordan/dhrkion/master/dhrkion"

nosave int next;

string zeichen(string str);

void create() 
{
  ::create();

  SetProp(P_INT_SHORT, "Vor einem antiken Portal");
  SetProp(P_INT_LONG,
          BS("Du findest Dich in einer kleinen Hoehle wieder, deren "
	     "Rueckwand gaenzlich von einem runden Portal eingenommen "
	     "wird. Der Rest der Hoehle besteht aus massivem, kalten "
	     "Granit. Einige Moose haben sich an den Waenden festgesetzt "
	     "und kleine Wasserpfuetzen sind am Boden verstreut."));

  AddDetail(({"hoehle","raum"}),
    QueryProp(P_INT_LONG));

  AddDetail(({"steinboden","boden"}),
    "Der steinerne Boden ist uebersaet mit kleinen Wasserpfuetzen.");

  AddDetail(({"decke","steindecke"}),
    "Die steinerne Decke ist mit kleinen Stalagtiten uebersaet, an denen "
    "das Wasser entlang rinnt und dann auf den Boden tropft.");

  AddDetail("stalagmiten",
    "Stalagmiten scheint es hier nicht zu geben, nur Stalagtiten an der "
    "Decke.");

  AddDetail("stalagtiten",
    "Kleine Stalagtiten haengen von der Decke herab. Wasser tropft von ihnen "
    "herunter.");

  AddDetail(({"pfuetzen","wasser","wasserpfuetzen"}),
    "Das Wasser der Decke sammelt sich am Boden in kleinen Wasserpfuetzen.");

  AddDetail(({"steinwaende","waende"}),
    "Die steinernen Waende sind teilweise mit Moosen uebersaet. Die "
    "Nordwand wird von einem gewaltigen Portal eingenommen, in der Suedwand "
    "befindet sich das Loch, durch das Du hereingekommen bist.");

  AddDetail(({"suedwand","loch","ausgang"}),
    "In der Suedwand befindet sich ein Loch, durch das Du wieder "
    "herausgelangen kannst.");

  AddDetail(({"nordwand","rueckwand"}),
    "Die Rueckwand der Hoehle wird von einem gewaltigen Portal eingenommen.");

  AddDetail("wand",
    "Welche Wand meinst Du denn?");

  AddDetail(({"moos","moose"}),
    "Einige Moose wachsen hier an den Waenden.");

  AddDetail(({"rest","granit"}),
    "Die gesamte Hoehle besteht aus hartem Granit.");

  AddDetail("ecke",
    "Du kannst nichts genaues entdecken.");

  AddDetail(({"kreis","obsidiankreis","portal"}),
    "Ein uralter, mit Schriftzeichen ueberzogener Kreis aus purem Obsidian "
    "steht an der Rueckwand der Hoehle. Du siehst keinerlei Mechanismus, "
    "vielleicht muss man ihn einfach nur betreten...");

  AddDetail(({"obsidian"}),
    "Das Portal scheint aus purem Obsidian zu bestehen.");

  AddDetail(({"magie","mechanismus"}),
    "Du kannst keinen offensichtlichen Mechanismus erkennen, da muss wohl "
    "Magie im Spiel sein...");

  AddDetail("spiel",
    "Ist doch nur ein Spiel!");

  AddDetail(({"zeichen","schriftzeichen"}),
    "Vielleicht kannst Du sie ja lesen...");
  
  AddReadDetail(({"zeichen","schriftzeichen"}),
		CLOSURE(zeichen));

  AddDetail(({"ardulvhier"}),
    "Diese Portal scheint nach ArdulVhier zu fuehren.");

  AddSound(DEFAULT_SOUND,
    "Du hoerst das Wasser von der Decke tropfen.");

  AddSound(({"wasser","tropfen"}),
    "*tropf* *platsch* *tropf* *platsch*");

  AddSmell(DEFAULT_SMELL,
    "Es riecht irgendwie nach Moder und frischem Moos.");

  AddSmell(({"moos","frisches moos","frischem moos"}),
    "Es riecht wie... frisches Moos!");

  AddSmell(({"moder","kadaver"}),
    "Es riecht hier nach Moder... wahrscheinlich ein Kadaver irgendwo in "
    "einer Ecke.");

  AddCmd(({"betrete","betritt"}), "portal");
  AddCmd(({"trink","trinke"}), "trinken");
  AddCmd(({"reiss","reisse"}), "ausreissen");
  AddCmd(({"iss","esse","friss"}), "essen");

  AddExit("raus", "aus der Hoehle raus#"+ROOM "zugang");

  Licht("duester");
  Umgebung("kuehl", TT_CAVE, 1);
  
  next=0;
}

nosave int essen(string str)
{
  notify_fail(BS("Was willst Du denn essen?"));
  if(!str) return 0;
  
  if(str=="moos"||str=="moose")
    return notify_fail("Moos essen? Direkt von der Wand?\n"
		       "Nana, das muss anders gehen!\n"), 0;

  return 0;
}

nosave int ausreissen(string str)
{
  notify_fail(BS("Was willst Du denn ausreissen?"));
  if(!str) return 0;
  
  if(str=="moos aus"||str=="moose aus")
     return write(BS("Das Moos ist ziemlich festgewachsen, so wirst Du es "
		     "nicht bekommen!")), 1;

  return 0;
}

nosave int portal(string str)
{
  notify_fail(BS("Was willst Du denn betreten?"));
  if(!str) return 0;
  
  if(str=="portal"||str=="antikes portal")
    {
      if(TP->InFight())
	return write(BS("Darauf kannst Du Dich jetzt nicht konzentrieren")), 1;
      
      if(TP->QueryProp(P_SP)<=20)
        return write(BS("Du naeherst Dich dem Portal, doch es passiert "
			"nichts...")+
                     BS("Du bist wohl nicht maechtig genug!")),1;
      
      if(next>time())
	return write(BS("Das Portal ist vor kurzem benutzt worden.")+
		     BS("Du musst Dich kurz gedulden, bis sich die Magie "
			"erholt hat!")), 1;
      
      if(TP->QueryProp(P_ALIGN)>500)
        {
          write(BS("Du naeherst Dich dem Portal, als es ploetzlich zu "
		   "pulsieren beginnt!")+
		BS("Dann hoerst Du einen Knall und spuerst nur noch, wie "
		   "Dich die Druckwelle hinauskatapultiert..."));

          say(BS(TP->Name()+" will das Portal betreten, doch eine gewaltige "
		 "Druckwelle befoerdert "+TP->QueryPronoun(WEN)+
		 " aus der Hoehle hinaus..."), ({TP}));

          TP->SetProp(P_HP, 5+random(5));

          tell_room(ROOM "zugang", 
		    BS(TP->Name()+" kommt aus dem Felsen geflogen und bleibt "
		       "liegen..."));
	  
          TP->SetProp(P_DEAF, 
		      ([DEAF_TIME: 5, 
			DEAF_MSG: "%s ist etwas benommen...\n"]));
	  
          TP->move(ROOM "zugang", M_NOCHECK|M_SILENT|M_NO_SHOW);
	  
	  next=time()+4+random(3);
	  
	  return 1;                 
        }

      if(DHRKION->getfeindkills(TP) >= 500)
	return write(BS("Du naeherst Dich dem Portal, doch es passiert "
			"nichts...")+
		     BS("Rein instinktiv weisst Du, dass Du als ewiger "
			"Feind von Dhrkion auch in ArdulVhier nicht "
			"willkommen bist!")), 1;
      
      if(TP->QueryProp(P_RACE)=="Dunkelelf")
        TP->AddSp(-5);
      else
        TP->AddSp(-20);

      write(BS("Du naeherst Dich dem Portal, als es ploetzlich aufleuchtet. "
	       "In der Mitte bildet sich ein waberndes Etwas, doch das "
	       "kuemmert Dich nicht mehr, denn Du betrittst gerade das "
	       "Portal und laesst Dich von ihm in eine andere Dimension "
	       "saugen..."));

      say(BS(TP->Name()+" durchschreitet das Portal..."), ({TP}));

      TP->move(ANSCHLUSS, M_NOCHECK|M_TPORT|M_NO_ATTACK);
      
      next=time()+4;;
      
      return 1;
    }

  return 0;       
}

nosave int trinken(string str)
{
  notify_fail(BS("Was willst Du trinken?"));
  if(!str) return 0;
  
  if(str=="wasser"||str=="wasser aus pfuetze"||str=="wasser aus pfuetzen")
     return notify_fail(BS("Wasser aus der Pfuetze? Bist Du ein Hund? "
			   "*waeh*")), 0;

  return 0;
}

string zeichen(string str)
{
  if((TP) && TP->QueryProp(P_RACE)=="Dunkelelf")
    return "Die Schriftzeichen sind uralt, dennoch erkennst Du ein Wort: "
      "ArdulVhier!\n";
  
  return "Sie sind zu alt, Du kannst sie leider nicht entziffern.\n";
}
