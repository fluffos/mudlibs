string _query_int_long()
{
  string ret;
  
  ret=Query(P_INT_LONG);
  
  if(TP && (member(ALLOWED, getuid(TP))!=-1))
    return ret+"Fuer Dich als Magier gibts Extrabefehle: neuesitem   <pfadname>\n"
               "                                         loescheitem <tafelnummer>\n";
  else return ret;
}

void reset()
{
  ::reset();
  
  if(open)
    {
      open=0;
      tell_room(TO, 
		BS("Du hoerst ploetzlich ein leises Quietschen, als ob gerade "
		   "eine Tuer zugegangen ist."));
    }
  
  call_out("restoreamounts",10);
}

int ResetItemAmount(int i)
{
  if(member(ALLOWED, getuid(PO))==-1) return -1;
  
  i--;
  
  if(i<0 || i>=sizeof(angebot)) return -1;
  
  angebot=sort_array(angebot, CLOSURE(wertvoller));
  
  angebot[i][3]=MAX_AMOUNT;
  
  save_object(SAVEFILE);
  
  return angebot[i][0];
}

void restoreamounts()
{
  int i;
  
  for(i=sizeof(angebot);i>0;i--)
    if(random(2)) ResetItemAmount(i);

  if(present("\nguido"))
    tell_room(TO, 
	      "Ein Gnom kommt herein und uebergibt Guido einen Sack.\n"
	      "Guido oeffnet den Sack und fuellt seine Vorraete auf.\n"
	      "Guido gibt dem Gnom den Sack zurueck.\n"
	      "Der Gnom winkt und verlaesst die Huette.\n");
}

nosave int tauschen(string str)
{
  object buy, trade;
  string a, b, f, s, s2;
  int what, i;
  
  notify_fail("Was willst Du denn tauschen?\n"
	      "Syntax: tausche <was> gegen <nummer>\n");
  if(!str) return 0;

  if(!present("\nguido")) 
    return write(BS("Ohne Guido laeuft hier nichts!")), 1;

  if(sscanf(str, "%s gegen %s", a, b)!=2) return 0;

  if(!what=to_int(b)) 
    return write(BS("Guido meint: So etwas haben wir nicht im Angebot.")), 1;

  if(what<1 || what>sizeof(angebot)) 
    return write(BS("Guido meint: So etwas haben wir nicht im Angebot.")), 1;

  what--;

  if(!trade=present(a, TP))
    return write(BS("Guido kratzt sich am Kopf.")+
		 BS("Guido meint: Was willst Du uns denn da aufschwatzen?")),1;
  
  if(trade->QueryProp(P_VALUE)<(angebot[what][1]*FAKTOR))
    return write(BS("Guido meint: Das ist uns zu billig!")), 1;
  
  if(trade->QueryProp(P_NOSELL)   || trade->QueryProp(P_NODROP)     || 
     trade->QueryProp(P_NEVERDROP)|| trade->QueryProp(P_AUTOLOADOBJ)|| 
     trade->QueryProp(P_CURSED))
    return write(BS("Guido meint: Geh weg mit diesem Zeug, das nehmen wir "
		    "sicher nicht!")), 1;
  
  if(trade==TP->QueryProp(P_WEAPON))
    return write(BS("Guido schimpft: Willst Du uns damit umbringen?")), 1;
  
  if(trade->QueryProp(P_WORN))
    return write(BS("Guido meint: Ausziehen! Wir koennen das sonst nicht "
		    "beurteilen.")), 1;

  f=explode(file_name(trade), "#")[0];
  
  for(i=sizeof(angebot)-1;i>=0;i--)
    if(to_string(angebot[i][2])==f)
      return write(BS("Guido schimpft: Aber das haben wir doch selber!")), 1;
    
  if(angebot[what][3] < 0) angebot[what][3]=0;

  if(!objectp(buy=clone_object(to_string(angebot[what][2]))) ||
     (!angebot[what][3]))
    return write(BS("Guido meint: Das koennen wir im Moment nicht finden, "
		    "willst Du nicht")+
		 BS("Guido meint: lieber etwas Anderes?")), 1;

  s=trade->name(WER);
  s2=trade->name(WEN);

  geld+=trade->QueryProp(P_VALUE);

  trade->remove(1);

  if(trade) 
    return write(BS("Guido schaut schief und schimpft: "
		    "Damit wollen wir nichts zu tun haben!")), 1;
  
  write(BS("Guido laechelt: Oh, "+s+" wie schoen.")+
	BS("Hier hast Du dafuer "+buy->name(WEN)+"."));

  say(BS(TPN+" tauscht "+s2+" gegen "+buy->name(WEN)+" ein."), ({TP}));
  
  write_file(LOGFILE, 
	     dtime()+" :\n"+
	     TPN+" tauscht "+s2+" gegen "+buy->name(WEN)+" ein.\n");
  
  if(buy->move(TP, M_GET)==ME_TOO_HEAVY)
    {
      write(BS("Guido kichert: Du bist aber ein Schwaechling, kannst "
	       "nichtmal das tragen!")+
	    BS(buy->Name()+" faellt auf den Boden vor Deine Fuesse."));

      buy->move(ME, M_NOCHECK);
    }
  
  angebot[what][3]--;
  
  save_object(SAVEFILE);
  
  return 1;
}

nosave int oeffnen(string str)
{
  notify_fail(BS("Was willst Du denn oeffnen?"));
  if(!str) return 0;
  
  if(str=="schrank"||str=="kleinen schrank")
    {
      if(open) 
	return write(BS("Der Schrank ist doch bereits offen?!")), 1;

      write(BS("Vorsichtig oeffnest Du den Schrank.")+
	    BS("Darin sitzt doch tatsaechlich ein kleiner Gnom, der Dich "
	       "angrinst."));

      say(BS(TPN+" oeffnet den Schrank."), ({TP}));

      open=1;

      return 1;
    }
  return 0;
}

nosave int kaufen(string str)
{
  notify_fail(BS("Was willst Du denn kaufen?"));
  if(!str) return 0;

  if(!present("\nguido")) 
    return write(BS("Ohne Guido laeuft hier nichts!")),1;

  return write(BS("Guido meint: Wir verkaufen hier nichts! Wir tauschen.")), 1;
}

nosave int verkaufen(string str)
{
  notify_fail(BS("Was willst Du denn verkaufen?"));
  if(!str) return 0;

  if(!present("\nguido")) 
    return write(BS("Ohne Guido laeuft hier nichts!")),1;

  return write(BS("Guido meint: Wir kaufen hier nichts an!")), 1;
}

nosave int abholen(string str)
{
  object priv, old;
  string *inv;
  int i, co;

  notify_fail(BS("Was willst Du denn abholen?"));
  if(!str) return 0;
  
  if(str=="objekt"  ||str=="objekt ab"||
     str=="objekte" ||str=="objekte ab")
    {
      if(!open) 
	return write(BS("Objekt? Was fuer ein Objekt? Und von wem?")), 1;

      if(last>=time()) 
        return write(BS("Der Gnom grummelt: Hetz mich nicht so!")), 1;

      if(deep_present("PRIVATE_OBJ", TP))
	{
	  write(BS("Der Gnom meint: Ah, Du hast bereits ein Objekt.")+
		BS("Der Gnom meint: Dann werden wir es mal ein wenig "
		   "reparieren..."));

	  co=-1;

          while(old=deep_present("PRIVATE_OBJ", TP))
            {
	      old->SetProp(P_CURSED, 0);
	      old->DoUnwear(1);
	      old->DoUnwield(1);
	      old->remove(1);
	      if(old) old->destruct();
	      co++;
            }
	  
          if(!co) 
	    write("\n");
          else 
	    write(BS("Der Gnom nimmt Dir alle privaten Objekte weg!")+"\n");
	}
      
      inv=get_dir(PRIVDIR+"pobj_"+getuid(TP)+"*");
      
      if(!sizeof(inv))
	return write(BS("Der Gnom schmollt: Fuer Dich habe ich ja gar kein "
			"Objekt!")), 1;
      
      if(sizeof(inv)>1)
        {
          write("Der Gnom blickt Dich an und gruebelt.\n"
		"Der Gnom meint: Ah, Du bekommst ein paar Sachen.\n"
		"Danach macht er sich ans Werk und haemmert an etwas herum.\n"
		"Kurze Zeit spaeter uebergibt Dir der Gnom einiges.\n");
	  
          for(i=sizeof(inv)-1;i>=0;i--)
            {
              priv=clone_object(PRIVDIR+inv[i]);
	      
              if(priv->move(TP, M_GET)==ME_TOO_HEAVY)
                {
                  write(BS("Der Gnom meint: "+priv->Name()+" ist Dir zu "
			   "schwer."));
                  priv->remove();
                }
            }
	  
          write(BS("Der Gnom laechelt und winkt Dir zu."));
	  
          say(BS(TPN+" holt sich "+TP->QueryPossPronoun(NEUTER, WEN, PLURAL)+
		 " Objekte ab."),({TP}));
        }
      else
        {
          priv=clone_object(PRIVDIR+inv[0]);

          write("Der Gnom blickt Dich an und gruebelt.\n"+
		"Der Gnom meint: Ah Du bekommst "+priv->name()+".\n"+
		"Danach macht er sich ans Werk und haemmert an etwas herum.\n"+
		"Kurze Zeit spaeter uebergibt Dir der Gnom etwas.\n");
	  
          if(priv->move(TP, M_GET)==ME_TOO_HEAVY)
            {
	      write(BS("Der Gnom meint: "+priv->Name()+" ist Dir zu "
		       "schwer."));
	      priv->remove();
	    }	      

          write(BS("Der Gnom laechelt und winkt Dir zu."));

          say(BS(TPN+" holt sich "+TP->QueryPossPronoun(NEUTER, WEN)+
	      " Objekt ab."), ({TP}));
        }

      last=time()+15+random(10);

      return 1;
    }
  return 0;
}

nosave string gnom()
{
  if(open)
    return "Der Gnom blickt Dich froehlich an und sagt:\n"
      " 'Endlich mal wer, der mich besucht! Ich sitze hier nur den\n"
      "  ganzen Tag und bastle an den privaten Spielerobjekten herum.\n"
      "  Hast Du auch eines? Hast Du Deines vielleicht verloren?\n"
      "  Du kannst Dir Dein Objekt hier abholen mit:\n"
      "  <hole objekt[e] ab>'\n";
  else
    return "Gnom? Was fuer ein Gnom? Wo siehst Du hier einen Gnom?\n";
}

nosave string schrank()
{
  if(open)
    return "Der Schrank ist offen.\nDrinnen sitzt ein kleiner Gnom der Dich "
      "frech angrinst.\n";
  else
    return "Der Schrank ist leicht angelehnt, was wohl da drinnen ist?\n";
}

nosave muecke()
{
  return "Autsch! Schon hat Dich eine Muecke in "+
    ({"den Hintern","den Hals","den linken Arm","den rechten Arm",
	"den Hintern","die Nase"})[random(5)]+" gestochen *grummel*.\n";
}

nosave string showme()
{
  string ret;
  int i, s;
  
  ret=sprintf("%60|s\n","Guidos Ramschladen praesentiert:")+
    sprintf("%60|s\n \n","================================");

  if(!sizeof(angebot))
    return make_document(ret+"* Zurzeit bin ich leider total ausverkauft!\n");
  
  ret+=sprintf("\n%4|s %30-s %13|s    %|s\n", "Nr", "Name/Art", "Wert", "Lager");
  ret+=sprintf("%60|'-'s\n","");
  
  s=sizeof(angebot);
  
  for(i=0;i<s;i++)
    ret+=sprintf("(%2d) %30-'.'s %4d Muenzen.    (%3d)\n", 
		 i+1, angebot[i][0], angebot[i][1], angebot[i][3]);
  
  TP->More(make_dokument(ret+" \n"));
  return "";
}

nosave string pre(object what)
{
  if(what)
    if(what->QueryProp(P_ARTICLE))
      if(what->QueryProp(P_GENDER)==FEMALE)
	return "Eine ";
      else
	return "Ein ";
    else
      return "";

  return "";
}

nosave int NewItem2Sell(string fname)
{
  object dummy;
  string s;
  int i;
  
  if(!TP) return 0;
  if(member(ALLOWED, getuid(TP))==-1) return -1;
  
  if(!fname) 
    return write(BS("Syntax: neuesitem <pfadname>")), 1;
  
  fname=explode(fname,".lpc")[0];
  
  if(file_size(fname+".lpc")<0)
    return write(BS("Pfad existiert nicht oder falsch angegeben!")),1;

  if(sizeof(angebot))
    for(i=sizeof(angebot)-1;i>=0;i--)
      if(fname==to_string(angebot[i][2]))
	return write(BS("Item befindet sich bereits im Angebot!")), 1;

  if(!objectp(dummy=clone_object(fname)))
    return write(BS("Item konnte nicht geladen werden!")), 1;

  if(strlen(s=extract_colors(dummy->QueryProp(P_SHORT)))>30)
    if(strlen(s=extract_colors(dummy->Name()))>30)
      if(strlen(s=extract_colors(pre(dummy)+dummy->Name(RAW)))>30)
	return write(BS("Der Name ist viel zu lang, bitte kuerzen!")), 1;

  angebot+=({({s,dummy->QueryProp(P_VALUE),fname,MAX_AMOUNT})});

  angebot=sort_array(angebot, CLOSURE(wertvoller));

  dummy->remove();

  save_object(SAVEFILE);
  
  write_file(LOGFILE,
    dtime()+" :\n- "+
    fname+" hinzugefuegt ("+CAP(getuid(TP))+")\n");
  
  write(BS("Item \""+fname+"\" erfolgreich hinzugefuegt."));

  return 1;
}

nosave int RemoveItem(string str)
{
  int i;
  string fname;
  
  if(!TP) return 0;
  if(member(ALLOWED, getuid(TP))==-1) return -1;

  i=to_int(str);
  
  i--;

  if((i<1) || (i>sizeof(angebot)))
    return write(BS("Item "+str+" gibts nicht.")), 1;
  
  fname=to_string(angebot[i][2]);
  
  angebot-=({angebot[i]});
  
  angebot=sort_array(angebot, CLOSURE(wertvoller));
  
  write_file(LOGFILE,
    dtime()+" :\n- "+
    fname+" geloescht ("+CAP(getuid(TP))+")\n");
  
  write(BS("Item ("+str+") \""+fname+"\" geloescht."));

  save_object(SAVEFILE);

  return 1;
}

int Schatzgroesse()
{
  return geld;
}

nosave int Schatzentnahme(int i)
{
  if(i>geld) return -1;
  
  geld=geld-i;
  
  save_object(SAVEFILE);
  
  return geld;
}

string *QueryAngebot()
{
  string *bot;
  int i;
  
  bot=({});

  for(i=sizeof(angebot)-1;i>=0;i--)
    bot+=({lower_case(explode(angebot[i][0]," ")[<1])});

  return bot;
}
