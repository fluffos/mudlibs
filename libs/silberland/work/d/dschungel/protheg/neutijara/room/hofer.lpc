/*
  Kleiner Laden wo man alles moegliche kriegt...
  Der Besitzer Guido Gigel ist leicht schizophren
  Ge- und Verkauft wird nichts, nur gehandelt
  Die Tauschobjekte muessen dabei x FAKTOR wert sein
  
  angebot: Short, Value, fname, amount

  Weiters kann man sich beim Gnom sein privates Objekt abholen.
  Dafuer muessen die jedoch so einen file_name haben: pobj_spielername.c

  14-01-2000  Mitloggen der Summe der Einnamen

  26-12-2000  Ab nun werden mehrere Priv-objs vergeben: pobj_spielername_nummer.c
  27-03-2002  Pragma
  
*/

#pragma strong_types;

#include "../def.h"

inherit MOST "std_room";

#define SAVEFILE LOG "hofersave"
#define MAX_AMOUNT 5
#define FAKTOR 3
#define ALLOWED ({"dante","protheg","d.dschungel.protheg"})
#define PRIVDIR "/d/dschungel/dante/private_obj/std_items/"
#define ANSCHLUSS "/d/dschungel/dante/tijaraneu/room/ti_pfad7"
#define LOGFILE LOG "tauschboerse"

string *angebot;

int geld;

nosave int open,last;

nosave showme();

nosave int wertvoller(string *a, string *b)
{
  if(a[1]>=b[1]) return 1;
  else return 0;
}

nosave string lang()
{
  return QueryProp(P_INT_LONG);  
}

