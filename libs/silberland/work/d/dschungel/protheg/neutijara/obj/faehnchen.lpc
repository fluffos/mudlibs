/*

  Ein Faehnchen zum Beschriften

*/

inherit "std/thing";

#include "../def.h"
#include <properties.h>
#include <language.h>
#include <ansi.h>

#define COLORS ([1:"rot";ANSI_BOLD+ANSI_RED, \
                 2:"gruen";ANSI_BOLD+ANSI_GREEN, \
                 3:"blau";ANSI_BOLD+ANSI_BLUE, \
                 4:"gelb";ANSI_BOLD+ANSI_YELLOW, \
                 5:"violett";ANSI_BOLD+ANSI_PURPLE, \
                 6:"tuerkis";ANSI_BOLD+ANSI_CYAN])

nosave int col,last;
nosave string inschrift="";

nosave string worte()
{
  if(strlen(inschrift))
    return "Auf dem Faehnchen steht: \""+inschrift+"\"\n";
  else
    return "Das Faehnchen ist noch unbeschriftet!\n";
}

create()
{
  if(!is_clone(TO)) return;
  ::create();

  col=random(6)+1;
  
  SetProp(P_SHORT, "Ein unbeschriftetes, "+COLORS[col]+"es Faehnchen");
  SetProp(P_LONG, 
	  BS("Ein unbeschriftetes "+COLORS[col]+"es Faehnchen aus Stoff und einem "+
	     "kurzen Holzstaebchen.\n"));
  SetProp(P_INFO,
	  BS("Ein suesse Faehnchen! Du kannst es beschriften und anschliessend "+
	     "damit in der Gegend herumwedeln.\n"));
  SetProp(P_NAME, "Faehnchen");
  SetProp(P_NAME_ADJ, COLORS[col]);
  SetProp(P_GENDER, NEUTER);
  AddId(({"faehnchen",COLORS[col]+"es faehnchen","\nfaehnchen"}));
  SetProp(P_MATERIAL, ([MAT_MISC_WOOD:40, MAT_CLOTH:60]));
  SetProp(P_WEIGHT, 200); 
  SetProp(P_VALUE, 349);
  SetProp(P_NOBUY, 1);
/*
  SetProp(P_NODROP, "Das willst Du doch gar nicht!\n");
  SetProp(P_NEVERDROP, 1);
*/
  AddDetail(({"holz","staebchen","stab","holzstab","holzstaebchen"}),
	    "Das kleine Holzstaebchen haelt man in der Hand und wedelt "+
	    "damit herum.\n");
  AddDetail(({"stoff"}),
	    "Das Faehnchen ist aus "+COLORS[col]+"em Stoff gemacht.\n");
  AddDetail(({"wort","worte","schrift","inschrift","aufschrift"}),
	    CLOSURE(worte));
  AddReadDetail(({"wort","worte","schrift","inschrift","aufschrift"}),
		CLOSURE(worte));

  AddCmd(({"wedel", "wedle"}), "wedeln");
  AddCmd(({"beschrifte"}), "beschriften");
}

reset()
{
  if(!is_clone(TO)) return;
  ::reset();

  if(!ENV(ME)) remove(1);
  if(!query_once_interactive(ENV(ME))) remove(1);
}

init()
{
  ::init();

  call_out("check_faehnchen",1);
}

check_faehnchen()
{
  object pl;

  if(present("\nfaehnchen 2", pl=environment(TO))) 
    {
      if(interactive(pl))
	tell_object(pl, 
		    "Ein Jojogeist kommt Dich nervend und tretend herein.\n"+
		    "Der Jojogeist blickt Dich boese an.\n"+
		    "Der Jojogeist schreit 'Mein Faehnchen!' und nimmt es Dir weg.\n"+
		    "Der Jojogeist loest sich in einer Rauchwolke auf.\n");
      else
        tell_room(pl,
		  "Ein Jojogeist kommt Dich nervend und tretend herein.\n"+
		  "Der Jojogeist bruellt 'Ein Faehnchen!' und freut sich.\n"+
		  "Der Jojogeist nimmt "+ME->name(WEN)+".\n"+
		  "Der Jojogeist loest sich in einer Rauchwolke auf.\n");
      call_out("remove",0);
    }
}

varargs string name(int c, int d)
{
  string ret;
  
  ret=::name(c,d);
  
  if(TP)
    if(TP->QueryProp(P_TTY)=="ansi")
      return COLORS[col,1]+ret+ANSI_NORMAL;
  return ret;
  
}

short()
{
  string ret;
  
  ret=::short();
  ret=implode(explode(ret, "\n"),"\n");

  if(TP)
    if(TP->QueryProp(P_TTY)=="ansi")
      return COLORS[col,1]+ret+ANSI_NORMAL+"\n";
  return ret+"\n";
}

nosave int wedeln(string str)
{
  notify_fail("Womit willst Du denn wedeln?\n");
  if(!str) return 0;

  if(str=="faehnchen"||str=="mit faehnchen"||
     str==COLORS[col]+"em faehnchen"||str=="mit "+COLORS[col]+"em faehnchen")
    {
      if(ENV(TP))
	if(strlen(inschrift))
	  tell_room(ENV(TP), 
		    BS(TPN+" wedelt Dir mit einem "+COLORS[col]+"en Faehnchen vor "+
		       "Deinem Gesicht herum und springt dabei vergnuegt durch die "+
		       "Gegend. Du kannst gerade noch die Aufschrift erkennen: \""+
		       inschrift+"\"."), ({TP}));
	else
	  tell_room(ENV(TP), 
		    BS(TPN+" wedelt Dir mit einem unbeschrifteten "+COLORS[col]+
		       "en Faehnchen vor Deinem Gesicht herum und springt dabei "+
		       "vergnuegt durch die Gegend."), ({TP}));
      
      tell_object(TP, BS("Du wedelst mit Deinem Faehnchen vor jedermanns Gesicht "+
			 "herum und huepfst dabei grinsend durch die Gegend! "));
      return 1;
    }
  return 0;
}

nosave int beschriften(string str)
{
  notify_fail("Was willst Du denn beschriften?\n");
  if(!str) return 0;

  if(str=="faehnchen"||str==COLORS[col]+"es faehnchen")
    {
      if(last>=time()) 
	return write("Aber Du hast doch erst vor kurzem die Beschriftung "+
		     "geaendert!\n"),1;

      write("Was soll denn auf dem Faehnchen stehen?\n'q' fuer Abbrechen: ");

      input_to("schrift");

      return 1;
    }
  return 0;
}

schrift(string str)
{
  if(!str)
    {
      write("Was soll denn auf dem Faehnchen stehen?\n'q' fuer Abbrechen: ");
      input_to("schrift");
      return;
    }
  
  if(lower_case(str)=="q") 
    return write("Ok, keine Beschriftung!\n");

  if(strlen(str)>50)
    return write("Die Beschriftung ist zu lang!\n");

  inschrift=str;

  SetProp(P_SHORT, "Ein \""+str+"\" Faehnchen");
  SetProp(P_LONG, 
	  BS("Ein "+COLORS[col]+"es Faehnchen aus Stoff auf einem "+
	     "kurzen Holzstaebchen. Darauf kannst Du die Worte \""+
	     inschrift+"\" lesen.\n"));

  write(BS("Du denkst an die Worte \""+str+"\" und ploetzlich erscheinen "+
	   "sie auf dem "+COLORS[col]+"en Faehnchen.\n"));
  
  last=time()+200+random(20);
}
