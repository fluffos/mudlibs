/*
  Eine saftige Kokosnuss
*/

#pragma strong_types;

inherit "std/food";

#include <properties.h>
#include <food.h>
#include <language.h>
#include "../def.h"

#define ZUALT 5

nosave int alter;

void create()
{
  if (!is_clone(ME)) return;
  ::create();
  
  SetProp(P_SHORT, "Eine grosse runde Kokosnuss");
  SetProp(P_LONG,
	  BS("In Deinen Haenden haelst Du eine grosse Kokosnuss, die nur "
	     "darauf wartet verspeist zu werden... Warte bloss nicht zu "
	     "lange damit!"));

  SetProp(P_NAME, "Kokosnuss");
  AddId(({"nuss","kokosnuss"}));

  SetProp(P_NAME_ADJ, ({"gross","rund"}));
  AddAdjective(({"grosse","grossen","runde","runden","grosse runde",
		   "grossen runden"}));

  SetProp(P_WEIGHT, 600+random(100));
  SetProp(P_VALUE, 100);
  SetProp(P_GENDER, FEMALE);
  
  SetProp(P_FOOD_INFO, ([F_HEAL : ({20+random(10), 0}), F_SOAK : 10]));
  
  SetProp(P_MATERIAL, ([MAT_FRUIT:90,MAT_MISC_PLANT:10]));
  
  alter=0;
}

void BeimEssen()
{
  write(BS("Du wirfst Die Kokosnuss auf den Boden und zerlegst sie "
	   "fachgerecht. ")+
	BS("Dann isst Du das ganze Innere auf... *mjam* lecker!"));

  say(BS(TPN+" knackt eine Kokosnuss und isst schmatzend das Innere auf."));
}

void reset()
{
  ::reset();
  
  alter++;

  if(alter==ZUALT)
    call_out("wegdamit",10);
}

void wegdamit()
{
  object pl;
  
  if((pl=MENV) && (interactive(pl)))
    tell_object(pl, 
		"Die Kokosnuss riecht auf einmal so komisch!\n"+
		"Sie ist wohl schon zu alt, deswegen wirfst Du sie weg.\n");
  
  remove();
}
      
