/*
  blutige Elfenohren kriegt man mit Haan, dem Elfentoeter
  werden mit der Zeit trocken
*/

#pragma strong_types;

inherit "std/food";

#include <properties.h>
#include <food.h>
#include <language.h>
#include "../def.h"

#define GENUG 3
#define ZUALT 6

nosave int alter, fertig;

void create()
{
  if(!is_clone(ME)) return;
  ::create();
  
  SetProp(P_SHORT, "Ein blutiges Elfenohr");
  SetProp(P_LONG,
	  BS("Ein fahles, spitz zulaufendes Elfenohr, an dem man noch die "
	     "einzelnen Blutgefaesse erkennen kann. Wahrscheinlich ist es "
	     "erst vor kurzem einem dieser hochmuetigen Elfen abgeschnitten "
	     "worden. Die Schnittwunde blutet noch etwas und das Blut tropft "
	     "auf den Boden..."));

  SetProp(P_NAME, "Elfenohr");
  SetProp(P_NAME_ADJ, ({"blutig"}));
  AddId(({"ohr","elfenohr"}));

  SetProp(P_WEIGHT, 3);
  SetProp(P_VALUE, 10);

  SetProp(P_GENDER, NEUTER);

  SetProp(P_FOOD_INFO, ([F_HEAL : ({15, 10}), F_SOAK : 5]));

  SetProp(P_MATERIAL, ([MAT_BLOOD:20,MAT_FLESH:75,MAT_HAIR:2,MAT_SKIN:3]));

  alter=0;
  fertig=0;
}

void BeimEssen()
{
  if(TP->QueryProp(P_RACE)=="Elf")
    {
      TP->AddHp(-20);

      write(BS("Mit einem gewissen Zoegern beisst Du in das Ohr, doch da "
	       "faehrt Dir der Schmerz auch schon durch den Koerper und "
	       "mit letzter Kraft wirfst Du das Ohr weg..."));
      
      say(BS(TPN+" beisst von einem Elfenohr ab und wirft es dann angewidert "
	     "weg...")+
	  BS("Welch Verschwendung!!"), ({TP}));
    }
  else
    {
      if(fertig)
	{
	  write(BS("Herzhaft beisst Du in das Elfenohr. Es ist schon "
		   "getrocknet und deswegen etwas zaeh, aber es schmeckt "
		   "trotzdem gut."));
	  
	  say(BS(TPN+" knabbert an einem getrockneten Elfenohr herum."));
	}
      else
	{
	  write(BS("Herzhaft beisst Du in die knorpelige Masse und kaust ein "
		   "Weilchen daran herum."));

	  say(BS(TPN+" schiebt sich genuesslich ein blutiges Elfenohr "
		 "in den Mund."), ({TP}));
	}
    }
}

void reset()
{
  ::reset();
  
  alter++;
  
  if((alter==GENUG)&&(!fertig))
    call_out("altern", 10);
  
  if(alter==ZUALT)
    call_out("remove", 10);
}

void altern()
{
  fertig=1;

  SetProp(P_MATERIAL, ([MAT_FLESH:95, MAT_HAIR:2, MAT_SKIN:3]));  

  SetProp(P_SHORT, "Ein getrocknetes Elfenohr");
  SetProp(P_LONG, 
	  BS("Ein fahles, spitz zulaufendes Elfenohr, das mittlerweile schon "
	     "ziemlich eingetrocknet ist, jedoch seine Konsistenz bewahrt "
	     "hat. Es wurde wahrscheinlich schon vor einiger Zeit einem "
	     "dieser hochmuetigen Elfen abgeschnitten."));

  SetProp(P_NAME_ADJ, "getrocknet");
  AddAdjective(({"trockenes", "trockene", "getrocknetes", "getrocknete"}));
  
  SetProp(P_FOOD_INFO, ([F_HEAL : ({25, 15}), F_SOAK : 8]));  
}
