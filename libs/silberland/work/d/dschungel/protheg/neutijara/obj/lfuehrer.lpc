/* 
   Lokalfuehrer

   wertet Food und Drink in Kneipen aus...

*/

#include "../def.h"

inherit "std/thing";
inherit MOST "std_things";

#include <properties.h>
#include <language.h>

create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Lokalfuehrer");
  SetProp(P_LONG,
	  "Ein kleines, in Leder gebundenes Buechlein. Auf dem Etikett steht:\n"
	  "              +----------------------------------+\n"
	  "              |                                  |\n"
	  "              |    Ihr Lokalfuehrer durch das    |\n"
	  "              |            Silberland            |\n"
	  "              |                                  |\n"
	  "              +----------------------------------+\n\n");
  SetProp(P_INFO, 
	  BS("Du blaetterst etwas in dem Buch herum und bemerkst eine "
	     "Fussnote auf der letzten Seite, die besagt, dass man das "
	     "richtige Menue des jeweiligen Lokales erlangt, wenn man "
	     "sich einfach in das Lokal stellt und \"lmenue\" eingibt."));
  
  AddDetail("etikett", ME->QueryProp(P_LONG));
  AddDetail("umschlag",
	    "Der lederne Umschlag scheint kaum abgenutzt.\n");
  AddDetail(({"seite","seiten"}),
	    "Du blaetterst etwas die Seiten durch, doch Du findest nichts "
	    "Interessantes.\n");
  AddReadDetail(({"note","fussnote"}),
		"Um das jeweils richtige Menue zu lesen, stelle man sich "
		"in ein Lokal und gebe 'lmenue' ein.\n");

  SetProp(P_NAME, "Lokalfuehrer");
  SetProp(P_GENDER, MALE);
  AddId(({"lokalfuehrer","fuehrer","buch","buechlein"}));
  
  SetProp(P_MATERIAL, ([MAT_PAPER:90,MAT_LEATHER:10]));
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 999);
  SetProp(P_NOBUY, 1);
  SetProp(P_NODROP, "Der Lokalfuehrer ist zu wertvoll!\n");
  SetProp(P_NEVERDROP, 1);
  
  AddCmd("lmenue", "lmenue");
}

nosave lmenue(string str)
{
  int i,lvl;
  string ret,tmp;
  object tp;
  mixed *food;
  mixed *drink;

  if(!tp=TP) return;
  if(!ENV(tp)) return;

  food=ENV(tp)->QueryFood();
  drink=ENV(tp)->QueryDrink();

  ret=tmp="";
  lvl=query_wiz_level(tp);

  lvl=1;

  if(!str || str=="getraenke" || str=="getraenk" || str=="trinken")
    if(sizeof(drink))
      {
        ret+="\n"+duplicate(" ",25)+"Getraenke:\n"+
          duplicate(" ",24)+"------------\n";
        //mit Alk
	switch(lvl)
	  {
	  case 0:
	    for(i=0;i<sizeof(drink);i++)
	      if(drink[i][4])
		tmp+="  "+
		  sprintf("%-39.39s %5.5d Muenzen\n",
			  drink[i][0], (ENV(tp)->QueryDrink(drink[i][0]))[<1]);
	    break;
	  case 1 .. 5:
	    for(i=0;i<sizeof(drink);i++)
	      if(drink[i][4])
		tmp+="  "+
		  sprintf("%-32.32s %5.5d Muenzen %s\n",
			  drink[i][0], (ENV(tp)->QueryDrink(drink[i][0]))[<1],
			  i2m(drink[i][5]));
	    break;
	  default:
	    for(i=0;i<sizeof(drink);i++)
	      if(drink[i][4])
		tmp+="  "+
		  sprintf("%-29.29'.'s.%5.5'.'d...%2.2|'0's/%2.2'0's/%2.2'0's...%3.3'.'d...%3.3'.'d\n",
			  drink[i][0],(ENV(tp)->QueryDrink(drink[i][0]))[<1],
			  to_string(drink[i][3][0]),
			  to_string(drink[i][3][1]),to_string(drink[i][3][2]),
			  drink[i][5],drink[i][4]);
	  }
	    
        if(strlen(tmp))
          {
            ret+="\nGetraenke mit Alkohol\n";
            ret+=tmp;
          }
        tmp="";
        //ohne Alk
	switch(lvl)
	  {
	  case 0:
	    for(i=0;i<sizeof(drink);i++)
	      if(!drink[i][4])
		tmp+="  "+
		  sprintf("%-39.39s %5.5d Muenzen\n", 
			  drink[i][0], (ENV(tp)->QueryDrink(drink[i][0]))[<1]);
	    break;
	  case 1 .. 5:
	    for(i=0;i<sizeof(drink);i++)
	      if(!drink[i][4])
		tmp+="  "+
		  sprintf("%-32.32s %5.5d Muenzen %s\n", 
			  drink[i][0], (ENV(tp)->QueryDrink(drink[i][0]))[<1],
			  i2m(drink[i][5]));
	    break;
	  default:
	    for(i=0;i<sizeof(drink);i++)
	      if(!drink[i][4])
		tmp+="  "+
		  sprintf("%-29.29'.'s.%5.5'.'d...%2.2|'0's/%2.2'0's/%2.2'0's...%3.3'.'d......\n", 
			  drink[i][0],(ENV(tp)->QueryDrink(drink[i][0]))[<1],
			  to_string(drink[i][3][0]),
			  to_string(drink[i][3][1]),to_string(drink[i][3][2]),
			  drink[i][5]);
	  }

        if(strlen(tmp))
          {
            ret+="\nGetraenke ohne Alkohol\n";
            ret+=tmp;
          }
      }
  
  if(!str || str=="speisen" || str=="essen")
    if(sizeof(food))
      {
      ret+="\n"+duplicate(" ",25)+"Speisen:\n"+
        duplicate(" ",24)+"----------\n\n";

      switch(lvl)
	{
	case 0:
	  for(i=0;i<sizeof(food);i++)
	    ret+="  "+
	      sprintf("%-39.39s %5.5d Muenzen\n", 
		      food[i][0], (ENV(tp)->QueryFood(food[i][0]))[<1]);
	  break;
	case 1 .. 5:
	  for(i=0;i<sizeof(food);i++)
	    ret+="  "+
	      sprintf("%-32.32s %5.5d Muenzen %s\n", 
		      food[i][0], (ENV(tp)->QueryFood(food[i][0]))[<1], 
		      i2m(food[i][4]));
	  break;
	default:
	  for(i=0;i<sizeof(food);i++)
	    ret+="  "+
	      sprintf("%-29.29'.'s.%5.5'.'d...%2.2|'0's/%2.2'0's/%2.2'0's...%3.3'.'d......\n", 
		      food[i][0],(ENV(tp)->QueryFood(food[i][0]))[<1],
		      to_string(food[i][3][0]),
		      to_string(food[i][3][1]),
		      to_string(food[i][3][2]),food[i][4]);
	}
      }
  
  if(!strlen(ret))
    ret="   -  Keine Eintraege gefunden  -";
  
  ENV(tp)->Message(BS(tp->Name()+" blaettert ein wenig in "+
		      tp->QueryPossPronoun(WESSEN,2)+" Lokalfuehrer."), 
		   MSGFLAG_VISUAL + MSGFLAG_NO_TP);

  tp->More(make_dokument(ret));
  return 1;
}

i2m(int size)
{
  string ret;

  switch(size)
    {
    case  3 ..  5:ret="(sehr wenig)";break;
    case  6 .. 10:ret="(wenig)";break;
    case 11 .. 20:ret="(genug)";break;
    case 21 .. 30:ret="(viel)";break;
    case 31 .. 40:ret="(sehr viel)";break;
    case 41 ..200:ret="(gigantisch)";break;
    default    :ret="(fast nichts)";
    }  
  return ret;
}
