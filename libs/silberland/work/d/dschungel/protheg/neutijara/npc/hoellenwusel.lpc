/*
  Kyorls Hoellenwusel
*/

#include "../def.h"

inherit MOST "mynpc";

void create() 
{
  if(!is_clone(TO)) return;
  ::create();
  
  SetProp(P_SHORT, "Ein Hoellenfeuerwusel");
  SetProp(P_LONG,
	  BS("Der Hoellenfeuerwusel ist eine handgrosse "
	     "Feuerkugel, die die Umgebung in Dunkelheit huellt."));

  SetProp(P_NAME, "Hoellenfeuerwusel");
  SetProp(P_GENDER, MALE);
  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:70]));
  AddId(({"wusel", "feuerwusel", "hoellenfeuerwusel"}));

  create_default_npc(1);
  SetProp(P_HANDS, ({" mit kleinen Flammen",
		       QueryProp(P_HANDS)[1], DT_FIRE}));
  SetProp(P_MAX_HP, 100);
  SetProp(P_BODY, 1);
  SetProp(P_XP, 0);
  SetProp(P_RACE, "Elementar");
  SetProp(P_SIZE, 30);
  SetProp(P_WEIGHT, 500);
  SetProp(P_ALIGN, -1000);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL,0);
  SetProp(P_AGGRESSIVE,0);
  SetProp(P_WIMPY, 0);
  SetProp(P_VULNERABILITY, ({DT_WATER}));
  SetProp(P_NOMAGIC,100);

  SetProp(P_MSGIN, "wuselt herein");
  SetProp(P_MSGOUT, "wuselt woandershin");
  SetProp(P_MMSGIN, "erscheint urploetzlich");
  SetProp(P_MMSGOUT, "loest sich auf");

  SetProp(P_NOCORPSE, 1);

  AddInfo(DEFAULT_INFO, "versteht Dich doch gar nicht.\n");

  SetProp(P_REJECT, ({REJECT_DESTRUCT,
    "Der Hoellenfeuerwusel huepft darauf herum, bis es weg ist.\n" }));

  SetProp(P_LIGHT, -1);

  SetProp(P_SPELLRATE, 0);
}

// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch) 
{
  if (find_call_out("reaction") != -1) return;
  if(touch)
    call_out("reaction", 0, TP,
	     "WAAH! Du verbrennst Dich an dem Hoellenfeuerwusel!",
	     TPN+" verbrennt sich an dem Hoellenfeuerwusel!");
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) {
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object ob, string macher, string andere) 
{
  if (present(ob, ENV(TO))) 
  {
    tell_object(ob, BS(macher));
    tell_room(ENV(TO), BS(andere), ({ob}));
    ob->AddHp(-10-random(5));
  }
}

string _query_noattack()
{
  TP->AddHp(-10-random(5));
  return "fliegt um Dich herum und verbrennt Dich.\n"+
    "Danach verharrt er reglos auf dem Boden...\n"; 
}

void gehweg()
{
  if(!MENV) return;

  tell_room(MENV, Name()+" versinkt zischend im Boden!\n");
  remove();
}
