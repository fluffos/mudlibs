/*
  K'yorl Okh Chak'ar, 
  Drowdruid und kaempft mit speziellen Dolchen
*/

#include "../def.h"

inherit DUNKELELF;

#define DHRKION "/d/unterwelt/zordan/dhrkion/master/dhrkion"

nosave object wusel;

void getwusel()
{
  wusel=clone_object(NPC "hoellenwusel");
  wusel->move(ENV(ME), M_NOCHECK);
}

void create() 
{
  if(!is_clone(TO)) return;
  ::create();
  
  SetProp(P_SHORT, 
	  "K'yorl Okh Chak'ar die finstere Druidin bewacht die Hoehle");

  SetProp(P_LONG,
	  BS("Vor Dir hat sich eine gewaltige Dunkelelfe aufgebaut! "
	     "Obwohl sie zu meditieren scheint, hast Du das Gefuehl, dass "
	     "Dich ihre rotleuchtenden Augen unentwegt betrachten. Du "
	     "solltest sie daher lieber nicht in Ihrer Konzentration stoeren! "
	     "Sie bewacht hier den Hoehleneingang."));

  SetProp(P_NAME, "K'yorl Okh Chak'ar");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_ARTICLE, 0);

  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:60]));
  AddId(({"k'yorl","dunkelelf","kyorl","druidin",
	    "NOWIMPY","NOCONTROL","chakar","chak'ar"}));

  create_default_darkelf(35, 0);
  SetProp(P_HANDS, ({" mit ihren frostigen Haenden",
		       QueryProp(P_HANDS)[1]+100,({DT_COLD,DT_UNHOLY})}));

  SetProp(P_BODY, 150);
  SetProp(P_ALIGN, -6);

  SetProp(P_HEAL, 50);
  SetProp(P_WIMPY, 0);
  SetProp(P_FOOD, 0);
  SetProp(P_DRINK, 0);
  SetProp(P_RESISTANCE, 
	  ({DT_FIRE, DT_COLD, DT_MIND, DT_WATER, DT_AIR, DT_BLUDGEON, 
	      DT_UNHOLY, DT_TERROR}));

  SetProp(P_NOMAGIC, 40+random(10));
  
  SetGuardProtection(100, GUARD_LOCATION);

  SetProp(P_MSGIN, "schleicht herein");
  SetProp(P_MSGOUT, "schleicht");
  SetProp(P_MMSGIN, "erscheint aus dem Schatten!");
  SetProp(P_MMSGOUT, "verschwindet ploetzlich");
  
  SetProp(P_DIE_MSG,  " stirbt mit geballten Faeusten.\n");
  SetProp(P_MURDER_MSG, "Dunkelelfen! Raecht mich!\n");
  
  AddInfo(DEFAULT_INFO, "sagt: Mit Dir rede ich nicht!\n");
  
  SetProp(P_REJECT,
	  ({REJECT_KEEP,
	      "K'yorl Okh Chak'ar sagt: Ihr wollt mich bestechen?\n",
	      "K'yorl Okh Chak'ar sagt: Nicht mit mir!\n"}));
  
  SetProp(P_GUILD, "druidenzirkel");
  SetProp(P_GUILD_LEVEL, 15);

/*  
  ModifySkill("laehme",          10000);
  ModifySkill("laehme",          ([SI_PREPARE_TIME:0, SI_SPELLCOST:0,
                                 SI_SKILLRESTR_USE:([SR_FREE_HANDS:0])]));
*/

  ModifySkill("feuerball",       10000);
  ModifySkill("feuerball",       ([SI_PREPARE_TIME:0, SI_SPELLCOST:0,
                                 SI_SKILLRESTR_USE:([SR_FREE_HANDS:0])]));
  ModifySkill("froststrahl",     10000);
  ModifySkill("froststrahl",     ([SI_PREPARE_TIME:0, SI_SPELLCOST:0,
                                 SI_SKILLRESTR_USE:([SR_FREE_HANDS:0])]));
  ModifySkill("wasserstrahl",    10000);
  ModifySkill("wasserstrahl",    ([SI_PREPARE_TIME:0, SI_SPELLCOST:0,
                                 SI_SKILLRESTR_USE:([SR_FREE_HANDS:0])]));
  ModifySkill("erzstrahl",       10000);
  ModifySkill("erzstrahl",       ([SI_PREPARE_TIME:0, SI_SPELLCOST:0,
                                 SI_SKILLRESTR_USE:([SR_FREE_HANDS:0])]));
  ModifySkill("windstoss",       10000);
  ModifySkill("windstoss",       ([SI_PREPARE_TIME:0, SI_SPELLCOST:0,
                                 SI_SKILLRESTR_USE:([SR_FREE_HANDS:0])]));

  SetProp(P_SPELLRATE,70);

  AddSpell(3,1,
	   "","", DT_BLUDGEON, "dspells");   

/*
  AddSpell(2,1,
	   "","", DT_BLUDGEON, "dla");   
*/

  AddSpell(3,1,
     Name()+" taenzelt gekonnt um Dich herum und trifft Dich hart\n"
     "in Deinen Ruecken!\nDu taumelst.\n",
     Name()+" trifft @WEN hart am Ruecken! @WER beginnt zu taumeln.\n",
     DT_BLUDGEON, "blow");

  AddSpell(3,300,
	   Name()+" trifft Dich mit aeusserster Praezision.\n",
	   Name()+" trifft @WEN mit aeusserster Praezision.\n",
	   ({DT_SLASH, DT_COLD}), ([SP_SHOW_DAMAGE:0]));

  AddSpell(2,400,
  	   Name()+" konzentriert sich...\n"
  	   "Du wirst herumgewirbelt...\n",
  	   "@WER wird von einer Windhose herumgeschleudert!\n",
  	   ({DT_AIR}), ([SP_SHOW_DAMAGE:0]));

  AddSpell(2,400,
  	   Name()+" konzentriert sich...\n"
  	   "Der Boden reisst auf und die Stuecke treffen Dich!\n",
  	   "Der Boden reisst auf und die Stuecke treffen @WEN!\n",
  	   ({DT_SLASH, DT_BLUDGEON}), ([SP_SHOW_DAMAGE:0]));

  AddSpell(2,400,
  	   Name()+" konzentriert sich...\n"
  	   "Eine Feuerwelle rast auf Dich zu... und verbrennt Dich!\n",
  	   "Eine Feuerwelle rast auf Dich zu...\n"
	   "@WER sieht nun etwas verkohlt aus!\n",
  	   ({DT_FIRE}), ([SP_SHOW_DAMAGE:0]));

  AddSpell(2,400,
  	   Name()+" konzentriert sich...\n"
  	   "Ein ploetzlicher Eishagel regnet auf Dich herab.\n",
  	   "Ein ploetzlicher Eishagel erfasst @WEN.\n",
  	   ({DT_COLD}), ([SP_SHOW_DAMAGE:0]));

  AddSpell(3, 1,
	   "","", DT_MAGIC, "wusel_spell");
  	   
  SetChats(1, ({
    Name()+" meditiert vor sich hin.\n",
      Name(WESSEN)+" Augen leuchten kurz auf, danach meditiert sie weiter.\n",
      Name()+" scheint irgendwie garnicht anwesend zu sein...\n"}));

  SetAttackChats(5, ({
    Name()+" stuerzt sich erbarmungslos auf Dich.\n",
      Name(WESSEN)+" Augen funkeln Dich boese an.\n",
      Name()+" versetzt Dir einen heftigen Rueckhandschlag!\n",
      Name()+" tritt Dich gemein.\n",
      Name()+" wirbelt um Dich herum...\n",
      Name()+" schliesst kurz Ihre Augen und ist verschwunden!\n"+
      "Nur um sofort hinter Deinem Ruecken wieder aufzutauchen.\n",
      Name()+" versetzt Dir einen schweren Schlag.\n",
      Name()+" tritt Dich gemein.\n"}));
  
  enable_commands();
  
  SUID;

  CLONEME("/gilden/druidenzirkel/armour/d_amulett");
  CLONEME("/gilden/druidenzirkel/armour/e_panzer");
  CLONEME(ARMOUR "drowschienen");
  
  if(!random(3))
    {
      if(!random(10))
        CLONEME(WEAPON "haan");
      else
        CLONEME(WEAPON "obsidiandolch");
    }
  
  command("trage alles");

  SetProp(P_KILL_NAME, Name(RAW));
}

int Defend(int dam, string *dam_type_list, mixed spell, object enemy)
{
  if((QueryProp(P_WEAPON)) && (random(100) < 50 ))
    {
      command("stecke dolch weg");
      return ::Defend(dam, dam_type_list, spell, enemy);
    }
  
  if((!QueryProp(P_WEAPON)) && (present("dolch")) && (random(100) < 50))
    command("zuecke dolch");

  return ::Defend(dam, dam_type_list, spell, enemy);
}

void blow(object enemy,int damage, mixed dam_type)
{
  enemy->SetProp(P_DISABLE_ATTACK, 
		 enemy->QueryProp(P_DISABLE_ATTACK)+1+random(2));
}

/*
void dla(object enemy,int damage, mixed dam_type)
{
  command_me("laehme "+enemy->name(WER,1));
}
*/

void wusel_spell(object enemy,int damage, mixed dam_type)
{
  if(!present("hoellenfeuerwusel")) return;
  
  tell_object(enemy,
	      BS(Name()+" blickt den Hoellenfeuerwusel an...")+
	      BS("Ploetzlich wirbelt der Hoellenfeuerwusel hoch und verbrennt "
		 "Dich."));
  tell_room(MENV,
	    BS(Name()+" blickt den Hoellenfeuerwusel an...")+
	      BS("Ploetzlich wirbelt der Hoellenfeuerwusel hoch und verbrennt "
		 +enemy->name()+"."), ({enemy}));
  
  enemy->Defend(200+random(100), ({DT_FIRE}), 
		([SP_SHOW_DAMAGE:1, SP_NO_ENEMY:1]), 
		present("hoellenfeuerwusel"));
}

void dspells(object enemy,int damage, mixed dam_type)
{
  mapping vuln;

  vuln=enemy->QueryProp(P_RESISTANCE_STRENGTHS);

  if(member(vuln, DT_FIRE))
    if(vuln[DT_FIRE] > 0.0)
    {
      command_me("feuerball");
      return;
    }

  if(member(vuln, DT_COLD)>-1)
  if(member(vuln, DT_COLD))
    if(vuln[DT_COLD] > 0.0)
    {
      command_me("froststrahl");
      return;
    }

  if(member(vuln, DT_WATER)>-1)
  if(member(vuln, DT_WATER))
    if(vuln[DT_WATER] > 0.0)
    {
      command_me("wasserstrahl");
      return;
    }

  if(member(vuln, DT_AIR)>-1)
  if(member(vuln, DT_AIR))
    if(vuln[DT_AIR] > 0.0)
    {
      command_me("windstoss");
      return;
    }
  
  switch(random(5))
    {
    case 0: command_me("erzstrahl"); return;
    case 1: command_me("froststrahl"); return;
    case 2: command_me("windstoss"); return;
    case 3: command_me("wasserstrahl"); return;
    case 4: command_me("feuerball"); return;
    }
}

void die(int poisondeath) 
{
  object inv;

  if(wusel) wusel->gehweg();
  
  if(inv=present("\ndruidenamulett")) 
    {
      inv->SetProp(P_CURSED, 0);
      inv->DoUnWear(1);
      inv->remove(1);
    }

  if(inv=present("\ne_panzer"))
    {
      inv->SetProp(P_CURSED, 0);
      inv->DoUnWear(1);
      inv->remove(1);
    }
  
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lxp) 
{
  object pu;
  
  if(killer==ME)
    {
      command_me("nimm boerse aus leiche");
      command_me("nimm geld aus leiche");
      command_me("nimm geld aus boerse");

      if(pu=present("geldboerse"))
        pu->remove();
      
      heal_self(500);

      tell_room(MENV, 
		BS(Name()+" wird durch dieses Opfer von Lloth belohnt..."));
    }
}

void StartReaction(string verb, string gruppe, string adverb, int touch) 
{
  if(find_call_out("reaction") != -1) return;

  if(verb=="verneig"||verb=="verneige")
    return call_out("reaction", 0, TP,
		 "verneigt sich vor Dir.",
		 "verneigt sich vor "+TP->Name(WEM,1)+".");

  switch (gruppe) 
    {
    case "fies":
      if(TP->QueryProp(P_GENDER)==FEMALE)
	call_out("reaction", 0, TP,
		 "kreischt: Hau bloss ab Du Schlampe!",
		 "kreischt "+TP->Name(WEN,1)+" an.");
      else
	call_out("reaction", 0, TP,
		 "bruellt: Verschwinde, Du niederer Wurm!",
		 "bruellt "+TP->Name(WEN,1)+" an.");
      break;
    case "frech":
      call_out("reaction", 0, TP,
	       "verpasst Dir eine schallende Ohrfeige.",
	       "verpasst "+TP->Name(WEM,1)+" eine schallende Ohrfeige.");
      break;
    case "intim":
      if(TP->QueryProp(P_GENDER)==FEMALE)
	call_out("reaction", 0, TP,
		 "pruegelt Dich windelweich!!",
		 "pruegelt "+TP->Name(WEN,1)+" windelweich.",1);
      else
	call_out("reaction", 0, TP,
		 "faellt Dir um den Hals und kuesst Dich leidenschaftlich."+
		 "Danach rammt Sie Dir ihre Faust in den Bauch!",
		 "faellt "+TP->Name(WEM,1)+" um den Hals."+
		 "Danach rammt Sie "+TP->QueryPronoun(WEM)+" ihre Faust in den Bauch.",1);
      break;
    }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) 
{
  return StartReaction(verb, gruppe, adverb, touch);
}

varargs void reaction(object ob, string macher, string andere,int flag) 
{
  if (present(ob, ENV(TO))) 
    {
      tell_object(ob, BS(Name(WER, 1)+" "+macher));
      tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
      if(flag) ob->AddHp(-20-random(30));
    }
}

void init()
{
  ::init();

  if(interactive(TP)) call_out("hallo", 0, TP);
  
  if(!wusel) getwusel();
}

void hallo(object who)
{
  if(ENV(who)!=MENV) return;

  if(TP->QueryProp(P_RACE)=="Dunkelelf") 
    tell_object(who, BS(Name(WER)+" zwinkert Dir zu."));

  if(DHRKION->getfeindkills(who) >= 500)
    {
      tell_room(MENV, BS(Name(WER)+" bruellt: Ein Feind von Dhrkion!!"));
      Kill(who);
    }

  if(HZM->Vorbereitungen())
    if(HZM->Eingeladen(getuid(who)))
      tell_object(who, 
		  BS(Name(WER)+" meint: Ah, ein Gast fuer die Zeremonie!.")+
		  BS(Name(WER)+" sagt: Ihr duerft passieren!"));
}
