/*
  Guido der schizophrene Besitzer der Bambushuette
  init eingebaut, dante 30.12.00
*/

#include "../def.h"

inherit MOST "mynpc";

#define BSA(x,y) break_string(x,78,y) 

void init()
{
  ::init();
  
  if(interactive(TP)) call_out("hallo", 1);  
}

void hallo()
{
  if((MENV) && (MENV==ENV(TP)))
    write(BSA("Hallo "+TPN+"! Wollen wir ein kleines Tauschgeschaeft machen?!",
	      "Guido sagt: "));
}

void create()
{
  if(!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Guido Gigel");
  SetProp(P_LONG,
	  BS("Vor Dir steht ein etwas seltsam wirkender, aelterer Mann mit "
	     "einem schief aufgesetzten Tellerhelm und einem gezueckten "
	     "Fleischermesser. Wuerde er nicht so freundlich und unschuldig "
	     "laecheln koennte man Angst vor ihm kriegen. Seine grosse Nase "
	     "zuckt andauernd unter den vielen Mueckenstichen, doch das "
	     "scheint ihn nicht sonderlich zu stoeren. Er verbringt die "
	     "meisste Zeit damit, mit sich selber Gespraeche zu fuehren "
	     "und dabei unentwegt zu kichern."));

  SetProp(P_NAME, "Guido Gigel");

  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:0,T_RANGE_MAX:50]));

  AddId(({"besitzer","guido", "\nguido", "gigel","Messerexperte"}));
  set_living_name("guido");

  create_default_mensch(20, MALE);

  SetProp(P_HANDS, ({" mit seinem gesamten Wissen",
		       QueryProp(P_HANDS)[1], DT_MIND}));
  SetProp(P_SIZE, 178);
  SetProp(P_ALIGN, 100+random(99));
  SetProp(P_WIMPY, 2);
  SetProp(P_TRANSPARENT, 0);
  AddProp(P_RESISTANCE_STRENGTHS , 
	  ([
	    DT_FIRE:   -0.2, DT_COLD: -0.1, DT_WATER: -0.2, 
	    DT_AIR:    -0.2, DT_SOUND: 0.1, DT_LIGHT: -0.1,
	    DT_TERROR: -0.2, DT_HOLY: -0.2, DT_MIND:  -1.0]));

  SetProp(P_ARTICLE, 0);
  SetProp(P_NOMAGIC, 10);

  SetProp(P_DIE_MSG,  " seufzt und faellt tot um.\n");

  AddInfo(DEFAULT_INFO, 
    ({"ist in irgendein Buch vertieft.\n",
      "kichert vor sich hin.\n",
      "grinst bloed.\n",
      "meint: Das muessen wir mal nachlesen.\n",
      "gruebelt vor sich hin.\n"}));
  
  AddInfo(({"guido","gigel","guido gigel","name"}),
	  "Wir heissen Guido Gigel, falls Du das meinst.",
	  "sagt: ");
  AddInfo(({"huette","holzhuette","bambushuette"}),
	  "Willkommen in unserer kleinen Huette. Beachte bitte unser grosses "
	  "Schild.",
	  "sagt: ");
  AddInfo("tisch",
	  "Mein Tisch, ist er nicht huebsch?",
	  "fragt: ");
  AddInfo(({"schild"}),
	  "Ja kannst Du denn nicht selber lesen?",
	  "schimpft: ");
  AddInfo(({"boerse","tauschboerse"}),
	  "Ah, hast Du das Schild gelesen. Ja wir betreiben hier eine "
	  "Tauschboerse. Hier kannst Du Deine wertvollen Gegenstaende "
	  "gegen etwas aus unserem Angebot tauschen. Aber damit es sich "
	  "auch fuer uns auszahlt, muss Dein Gegenstand mindestens 3 mal "
	  "so viel wert sein, wie der aus unserem Angebot.",
	  "sagt: ");
  AddInfo(({"angebot","gegenstand","gegenstaende","tauschen","tausch",
	      "geschaeft","tauschgeschaeft","waren","ware"}),
	  "deutet kichernd auf die Tafel.");
  AddInfo(({"zolom","zolome","hoehle"}),
	  "Die Zolome sollen sich westlich von hier in einer grossen Hoehle "
	  "befinden.",
	  "meint: ");
  AddInfo(({"tafel"}),
	  "Da steht unser Angebot drauf!",
	  "verkuendet stolz: ");
  AddInfo(({"dante","syndrom","dantesyndrom"}),
	  "Ueber das Dantesyndrom haben wir schon mal etwas gelesen.",
	  "meint grinsend: ");
  AddInfo(({"regal","regale"}),
	  "Ja! Da befindet sich unser gesamtes Wissen inform von selbst "
	  "verfassten Buechern und selbstgezeichneten Karten. Frueher waren "
	  "wir sehr fleissig und haben unser Wissen niedergeschrieben, bevor "
	  "wir es vergessen haben.",
	  "sagt: ");
  AddInfo(({"wissen"}),
	  "Wir wissen sehr viel. Alles haben wir in Buechern "
	  "niedergeschrieben, dass wir es nicht vergessen.",
	  "sagt: ");
  AddInfo(({"buch","buecher"}),
	  "Die Buecher in den Regalen haben wir selber geschrieben.",
	  "sagt: ");
  AddInfo(({"karte","karten"}),
	  "Wir haben viele Karten des Silberlandes gezeichnet damals.",
	  "sagt: ");
  AddInfo("tijara",
	  "Tijara liegt weiter westlich, Gruess den Gouverneur mal von uns, "
	  "falls Du ihn mal triffst!",
	  "sagt: ");
  AddInfo(({"affe"}),
	  "Der kleine Affe rennt hier andauernd herum und stibitzt unsere "
	  "Buecher.",
	  "grummelt: ");
  AddInfo(({"muecke","stechmuecke","muecken","stechmuecken","moskito",
	      "moskitos","insekten"}),
	  "Exterm laestig diese Insekten, meinst Du nicht?",
	  "grummelt: ");
  AddInfo(({"gnom"}),
	  "Der kleine Gnom sitzt in dem Schrank und bastelt immer an "
	  "Irgendwas herum.",
	  "sagt: ");
  AddInfo(({"irgendwas","irgendetwas","objekte","objekt","private objekte",
	      "privates objekt","persoenlicher gegenstand",
	      "persoenliche gegestaende","persoenliche objekte",
	      "persoenliches objekt"}),
	  "Angeblich irgendwelche spezielle Objekte fuer die Spieler des "
	  "Silberlandes. Der Gnom im Schrank weiss vielleicht mehr darueber.",
	  "sagt: ");
  AddInfo(({"protheg"}),
	  "PROtheG, der alte Dunkelelf! Hat uns schon vor langer Zeit eine "
	  "Klimavorrichtung versprochen!",
	  "schimpft: ");
  AddInfo(({"dunkelelf"}),
	  "Meinst Du PROtheG?",
	  "fragt: ");
  AddInfo(({"klimaanlage","klimavorrichtung"}),
	  "Ohne die Klimavorrichtung verschimmeln alle unsere Buecher und "
	  "Karten!!",
	  "sagt: ");
  AddInfo(({"hilfe"}),
	  "Du willst uns helfen? Wobei?",
	  "fragt: ");
  AddInfo(({"schrank"}),
	  "deutet auf eines der Regale.");
  AddInfo(({"silberland"}),
	  "Wir sind alle nur kleine Punkte im grossen Silberland.",
	  "sagt: ");
  AddInfo(({"punkt","punkte"}),
	  "Wir sind Nichts im Vergleich mit dem Silberland.",
	  "sagt: ");
  AddInfo(({"nichts","vergleich"}),
	  "So klein wie Staubkoerner!",
	  "sagt: ");
  AddInfo(({"staub","korn","koerner","staubkorn","staubkoerner"}),
	  "kniet auf den Boden nieder und winselt: Wir sind Staub! Wir sind "
	  "Nichts!");
  AddInfo(({"damals","zeit"}),
	  "Jaja, damals war alles besser, als wir noch jung waren!",
	  "sagt: ");
  AddInfo(({"spieler"}),
	  "Spieler, die hier ab und zu durchlaufen.",
	  "sagt: ");
  AddInfo(({"schweiss","gestank","stinken"}),
	  "Wir stinken nicht!",
	  "winselt: ");
  AddInfo(({"dschungel"}),
	  "Sehr gefaehrlich ist der Dschungel da draussen! Viele Tiere und "
	  "giftige Pflanzen leben dort!",
	  "warnt: ");
  AddInfo(({"tiere","dschungelbewohner","tier"}),
	  "Viele Tiere leben da draussen! Pass auf, dass Du nicht zerfleischt "
	  "wirst!",
	  "warnt: ");
  AddInfo(({"pflanzen","dschungelpflanzen","giftpflanzen","giftige pflanzen"}),
	  "Viele der Pflanzen im Dschungel sind giftig!",
	  "warnt: ");
  AddInfo(({"klima"}),
	  "Hier herrscht so ein feuchtes Klima, dass alle unsere Buecher und "
	  "Karten schon schimmeln! Wann kommt bloss die Klimavorrichtung?!",
	  "schimpft: ");

  AddInfo(ROOM "hofer"->QueryAngebot(),
	  "Ja, das haben wir im Angebot. Lies doch mal die Tafel!",
	  "sagt: ");

  SetProp(P_LOG_INFO, "protheg/missing");
  
  SetProp(P_REJECT, 
	  ({REJECT_GIVE, "Guido meint: Willst Du es nicht lieber eintauschen?\n" }) );
  
  SetProp(P_SPELLRATE, 99); // ziemlich hektischer typ *gg*
  
  AddSpell(2,332,
	   "Guido Gigel wirft ein Buch nach Dir.\n",
	   "Guido Gigel wirft ein Buch nach @WEM.\n",
	   DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

  AddSpell(3,246,
	   "Guido Gigel tritt nach Dir.\n",
	   "Guido Gigel tritt @WEN.\n",
	   DT_BLUDGEON,([SP_SHOW_DAMAGE:1]));

  AddSpell(2,227,
	   "Guido Gigel spuckt Dich an.\n",
	   "Guido Gigel spuckt @WEN an.\n",
	   DT_WATER,([SP_SHOW_DAMAGE:1]));

  AddSpell(2,335,
	   "Guido Gigel zieht Dir eins mit seinem Helm ueber.\n",
	   "Guido Gigel zieht @WEM eins mit seinem Helm ueber.\n",
	   DT_SLASH,([SP_SHOW_DAMAGE:1]));

  AddSpell(1,484,
	   "Guido Gigel rammt Dir sein Messer rein.\n",
	   "Guido Gigel rammt @WEM sein Messer rein.\n",
	   DT_PIERCE,([SP_SHOW_DAMAGE:1]));
  
  SetChats(5, ({
    "Guido Gigel sabbert kichernd auf den Boden.\n",
      "Guido Gigel grummelt das Klima an.\n",
      "Guido Gigel redet mit sich selbst.\n",
      "Guido Gigel nimmt eine Karte aus dem Regal und legt sie wieder zurueck.\n",
      "Guido Gigel versucht eine Muecke zu toeten, faellt jedoch auf die Nase.\n",
      "Du denkst . o O (Guido Gigel stinkt irgendwie extrem nach Schweiss!)\n",
      "Guido Gigel kratzt sich am Kopf.\n"}));
  
  SetAttackChats(10, ({
    "Guido Gigel huepft aufgeregt um Dich herum.\n",
      "Guido Gigel sabbert Dich an!\n",
      "Guido Gigel schimpft: Nun stirb doch endlich!\n"}) );
  
  SUID;
  
  CLONEME("/p/weapon/knife/fleischermesser");
  command("zuecke messer");

  CLONEME("/p/armour/helm/tellerhelm");
  CLONEME("/p/armour/armour/weste");
  command("trage alles");
}

void reset()
{
  if(!is_clone(TO)) return;

  ::reset();
  
  AddInfo(ROOM "hofer"->QueryAngebot(),
	  "Ja, das haben wir im Angebot. Lies doch mal die Tafel!\n",
	  "sagt: ");
}

void die(int poisondeath) 
{
  KILLMASTER->register_npc_death(QueryProp(P_KILLER)||TP);
  
  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lxp) 
{
  if(killer == ME)
    KILLMASTER->register_player_death(player, lxp);

  ::NotifyPlayerDeath(player, killer, lxp);
}

// Reactions
void StartReaction(string verb, string gruppe, string adverb, int touch) 
{
  if (find_call_out("reaction") != -1) return;
  
  if(touch)
    switch(random(3))
      {
      case 2:call_out("reaction", 0, TP,
		      "tritt Dich und kichert.",
		      "tritt "+TP->name(WEN)+" und kichert.");
      break;
      case 1:call_out("reaction", 0, TP,
		      "sabbert Dich an.",
		      "sabbert "+TP->name(WEN)+" an.");
      break;
      case 0:call_out("reaction", 0, TP,
		      "haut Dir kichernd eine runter.",
		      "haut "+TP->name(WEM)+" kichernd eine runter.",1);
      break;
      }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch) 
{
  return StartReaction(verb, gruppe, adverb, touch);
}

varargs void reaction(object ob, string macher, string andere, int flag) 
{
  if (present(ob, ENV(TO))) 
    {
      tell_object(ob, BS(Name(WER, 1)+" "+macher));
      tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({ob}));
      if(flag) ob->AddHp(-5-random(5));
    }
}

