/*
   Haan, der Elfentoeter - Opfermesser und Elfenkiller
*/

#pragma strong_types;

#include "../def.h"

inherit "std/weapon";

#define MP 5
#define HINNICH "\nverstuemmelte Leiche"

int is_elf_leiche(object ob)
{
  if((ob->id("Leiche")) && (ob->QueryProp(P_RACE)=="Elf"))
    return 1;
  
  return 0;
}

void create() 
{
  if(!is_clone(TO)) return;
  ::create();
  
  SetProp(P_SHORT, "Haan, der Elfentoeter");
  SetProp(P_LONG,
	  BS("In Deinen Haenden haelst Du Haan, den Elfentoeter!"
	     "Eine unheimliche Aura geht von diesem Dolch aus..."
	     "Als ob er von einer Dir unbekannten Macht besessen sei."));

  SetProp(P_INFO, 
	  BS("Der Legende nach wurde den toten Elfen mit diesem Dolch die "
	     "Ohren abgeschnitten und als Trophaee gesammelt..."));
  
  SetProp(P_NAME, "Haan");
  SetProp(P_GENDER, MALE);
  SetProp(P_ARTICLE, 0);
  AddId(({"dolch", "elfentoeter","haan", "opferdolch"}));
  
  AddDetail("aura",
	    "Eine unheimliche Aura umgibt diesen Dolch!");
  
  AddDetail("macht",
	    "Hoffentlich kannst Du sie Dir zunutze machen!");
  
  SetProp(P_WEAPON_TYPE, WT_KNIFE);
  SetProp(P_WC, 100);
  SetProp(P_WC_FIXFACTOR, 0.4);
  SetProp(P_DAM_TYPE, ({DT_PIERCE, DT_UNHOLY}));

  SetProp(P_NR_HANDS, 1);

  SetProp(P_MATERIAL, ([MAT_OCTARINE:80,MAT_MISC_UNHOLY:15,MAT_BLOOD:5]));
  SetProp(P_WEIGHT, 300);
  SetProp(P_VALUE, 900);
  SetProp(P_SIZE, 35);
  SetProp(P_NOBUY, 1);

  SetProp(P_WIELD_RESTRICTIONS, ([A_INT:12,A_DEX:15,A_CON:17,P_LEVEL:15]));

  SetProp(P_MAGIC, 1);
  
  SetProp(P_WC_BONUS, (["kyorl":100]));
  
  SetProp(P_ITEMD, ({"ist boese", "hasst Elfen"}));

  SetProp(P_HIT_FUNC, TO);
  SetProp(P_WIELD_FUNC, TO );

  AddCmd(({"schneide","schneid"}), "sippelsappel");

  SetProp(P_KILL_NAME, "Haan, der Elfentoeter");
}

int WieldFunc(object waffe) 
{
  if(TP->QueryProp(P_ALIGN)>-100)
    {
      write(BS("Haan blitzt kurz auf und Du spuerst einen Stich in Deiner "
	       "Hand!"));
      TP->do_damage(5);
      return 0;
    }
    
  if(TP->QueryProp(P_RACE)=="Elf")
    {
      write(BS("Haan blitzt auf und versetzt Dir einen maechtigen Schlag!"));
      TP->do_damage(150);
      return 0;
    }
  
  return 1;
}

int HitFunc(object enemy)
{
  object who;

  if((who=QueryWielded()) && (enemy->QueryProp(P_RACE)=="Elf"))
    if((!random(3)) && (who->QueryProp(P_SP)))
      {
	who->AddSp(-1);
	
	tell_object(who, 
	    ({"Haan blitzt auf, als er in das Elfenfleisch schneidet!\n",
		"Haan vibriert in Deiner Hand.\n",
		"Haan schlitzt "+enemy->name(WEN)+" muehelos auf.\n"})[random(3)]);
	
	return who->QueryAttribute(A_STR)+random(who->QueryAttribute(A_DEX));
      }
    else
      return 5+random(who->QueryAttribute(A_DEX)/2);

  return 0;
}

nosave int sippelsappel(string str)
{
  object *leichen;
  object leiche, ohr;
  int i, siz, found;
  string what, whom;

  notify_fail(BS("Was willst Du Wem abschneiden?"));
  if(!str) return 0;

  if(sscanf(str, "%s %s ab", whom, what) != 2) return 0;
  
  if(member(({"ohr", "ohren", "elfenohr", "elfenohren"}), what)==-1)
    return 0;

  if(member(({"leiche", "elf", "elfenleiche"}), whom)==-1)
    return notify_fail(BS("Wem willst Du das abschneiden?")), 0;
  
  if(!ME->QueryProp(P_WIELDED))
    return write("Du solltest den Dolch erst einmal zuecken!"), 1;

  if(TP->QueryProp(P_SP) < MP)
    return write(BS("Haan scheint Dir nicht zu gehorchen!")+
		 BS("Du bist wohl nicht maechtig genug!")), 1;

  leichen=filter_array(all_inventory(environment(TP)), CLOSURE(is_elf_leiche));
  
  siz=sizeof(leichen);
  
  if(!siz)
    return write(BS("Hier gibt es keine Elfenleichen zum Verstuemmeln!")), 1;

  for(i=siz-1;i>-1;i--)
    {
      if(found) break;

      leiche=leichen[i];
      if(!leiche->id(HINNICH)) found=1;
    }

  if(!found) 
    return write(BS("Hier scheinen bereits alle Leichen verstuemmelt "
		    "zu sein!")), 1;

  write(BS("Voller Verachtung stuerzt Du Dich auf den Elfenleichnahm und "
	   "schneidest ihm ein Elfenohr ab, um es sogleich triumphierend in "
	   "die Hoehe zu halten..."));

  say(TP->name(WER,1)+" stuerzt sich auf den Elfenleichnahm und schneidet ihm "
      "ein Ohr ab!",TP);

  ohr=clone_object(OBJ "elfenohr");
  ohr->move(TP, M_NOCHECK|M_SILENT);

  if(random(2))
    {
      ohr->SetProp(P_NAME_ADJ, ({"link","blutig"}));
      ohr->SetProp(P_SHORT, ohr->QueryProp(P_SHORT)+" \(links\)");
      ohr->AddAdjective(({"linkes", "linke", "blutige", "blutiges"}));
    }
  else
    {
      ohr->SetProp(P_NAME_ADJ, ({"recht","blutig"}));
      ohr->SetProp(P_SHORT, ohr->QueryProp(P_SHORT)+" \(rechts\)");
      ohr->AddAdjective(({"rechtes", "rechte", "blutige", "blutiges"}));
    }

  TP->AddSp(-MP);
  TP->SetProp(P_ALIGN, TP->QueryProp(P_ALIGN) - 10);

  leiche->AddId(HINNICH);

  leiche->SetProp(P_NAME_ADJ, 
	leiche->QueryProp(P_NAME_ADJ)+({"verstuemmelt"}));

  leiche->SetProp(P_INFO, 
	BS(TP->name(WER)+" hat der Leiche die Ohren abgschnitten."));

  return 1; 
}
