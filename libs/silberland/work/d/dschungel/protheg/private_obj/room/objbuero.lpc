/* ====== Antrag eingeben ===== */

nosave nomask int enter_antr()
{  
	 //if (!IS_WIZARD(TP)) return 0;
   
  if(TP->QueryProp(P_LEVEL)<level)  
    return write("Du hast erst Level "+TP->QueryProp(P_LEVEL)+"! Komm wieder, "
		 "wenn Du Level "+level+" hast!\n"),1;
  
  if(present("PARA_O_EDIT",TP))
    return write("Du schreibst doch schon an einem Antrag.\n"),1;

    write("Du schreibst nun einen Antrag!\n\n");
    write("Titel: ");
    input_to("my_titel");
    return 1;
}

nosave nomask int my_titel(string ti)
{
  string u;
  object ob;
  
  if(!ti) return write("\nAbgebrochen.\n"),1;

  u = UTP;

  if(present("PARA_O_EDIT",TP))
    return write("Du schreibst doch schon an einem Antrag.\n"),1;

  u = CAP(u)+" / "+dtime(time())+"\n     -> "+ti;

  ob = clone_object(MY_EDITOR);
  if(!objectp(ob))
    return write("ERROR!\n"),1;
  ob->move(TP,M_NOCHECK);
  ob->StartEditorA(TP,u);
  return 1;
}

void EditorOutputA(object pl,string titel,string text)
{
  string *data;
  
  if(!PO || !objectp(PO) || explode(FN(PO),"#")[0]!=MY_EDITOR)
    return tell_room(TO,"E-ERROR.\n");

  if(!objectp(pl) || !stringp(titel) || !stringp(text) ||
     strlen(titel)<2 || strlen(text)<1 )
    return tell_room(TO,"E-ERROR 2.\n");
  
  count ++;
  data = ({ titel })+explode(text,"\n");
  antr += ([ count : getuid(pl);time();data ]);
  save_it();
  return;
}

/* ===== Hilfsseite ===== */

nosave nomask int manual(string in)
{
  string re;
    //if (!IS_WIZARD(TP)) return 0;
  if (!in) return 0;
  if (in=="office") 
    {
      re = "\n   Anleitung fuer das 'Buero fuer private Gegenstaende'\n "
	"   Kommando    Funktion\n\n"
	"   help office  Diese Seite anzeigen.\n"
	"   antrag      Aktiviert einen Text-Editor, mit dem man einen Antrag\n"
	"               eingeben kann. Als Titel bitte etwas aussagekraeftiges\n"
	"               eingeben.\n"
	"               Ein einmal beendeter Eintrag kann nicht mehr geloescht\n"
	"               werden!\n\n"
	"   liste       Listet alle vorhandenen Antraege auf.\n\n"
	"   xantr <n>   Zeige Antrag <n> an.\n\n"
	"   cmt   <n>   Kommentar zum Antrag <n> eingeben.\n\n"
	"   dcmt  <n>   Eigenen Kommentar zu Antrag <n> loeschen.\n\n";
      
      if (IS_WIZARD(TP))
	re += "   dantr <n>   Loesche Antrag <n>.\n\n";
      
      /*      re += "Spezielle Funktionen:\n   addmember <uid>     Mit diesen ";
	      re += "Kommandos wird die generelle Raum-\n   removemember <uid>  ";
	      re += "Erlaubnis gegeben/entzogen.\n\n";
	      }
      */
      
      TP->More(re);
      return 1; 
    }
  if (in=="xantr") 
    {
      re = "Kommando 'xantr <nr>':\n"
	"   Mit diesem Kommando wird der Antrag mit der Nummer <nr> angezeigt.\n"
	"   Sofern vorhanden, werden auch bereits eingegebene Kommentare zu\n"
	"   diesem Antrag angezeigt.\n";
      write(re);
      return 1; 
    }
  if (in=="dantr" && !sec_check()) 
    {
      re = "Kommando 'dantr <nr>':\n"
	"   Mit diesem Kommando wird der Antrag mit der Nummer <nr> geloescht.\n"
	"   Das ist nur fuer Magier moeglich.\n";
      write(re);
      return 1; 
    }
  if (in=="cmt") 
    {
      re = "Kommando 'cmt <nr>':\n"
	"   Mit diesem Kommando kann man einen Kommentar zum Antrag mit der\n"
	"   Nummer <nr> eingeben.\n"
	"   Es steht kein Texteditor zur Verfuegung! Hat man bereits einen\n"
	"   Kommentar eingegeben, wird dieser ueberschrieben.\n";
      write(re);
      return 1; 
    }
  if (in=="dcmt") 
    {
      re = "Kommando 'dcmt <nr>':\n"
	"   Mit diesem Kommando loescht man den eigenen Kommentar zum Antrag mit\n"
	"   der Nummer <nr>\n";
      write(re);
      return 1; 
    }
  return 0;
}

/* ===== Antraege anzeigen ===== */

nosave nomask int antr_liste()
{
  string re,*ctrs;
  int i,j;
  int *ind;
  mapping cm;
//    if (sec_check()) return 0;
  
  if (m_sizeof(antr)<1)
    return write("Keine Antraege vorhanden.\n"),1;
  
  ind = m_indices(antr);
  
  if (!intp(ind[0]))
    return write("Oha, ein interner Fehler!\n"),1;

  ind = sort_array(ind,CLOSURE(>));
  
  for(re="",i=sizeof(ind)-1;i>=0;i--) 
    {
      re += sprintf("%4d %s\n",ind[i],antr[ind[i],2][0]);
      if (!member(cmts,ind[i])) continue;
      cm = cmts[ind[i]];
      ctrs = m_indices(cm);
      if (sizeof(ctrs)<1) continue;
      re += "    C:*";
      for (j=sizeof(ctrs)-1;j>=0;j--) 
	{
	  if (member(shorts,ctrs[j])) re += shorts[ctrs[j]];
	  else if (strlen(ctrs[j])<5) re += ctrs[j];
	  else re += ctrs[j][0..3];
	  re += "*"; 
	}
      re += "\n"; 
    }
  re += "<ENDE>\n";
  TP->More(re);
  return 1;
}

/* ===== Antrag lesen ===== */

nosave string make_atext(int n)
{
  string re;
  mapping comments;
  int i;
  int *namen;
  
  if (!n || n<1) return 0;
  re = FLINE;
  re += (antr[n,2][0]+"\n");
  re += FLINE;
  re += implode(antr[n,2][1..],"\n");
  re += "\n"+FLINE;
  if(member(cmts,n)) 
    {
      comments=cmts[n];
      
      if(m_sizeof(comments)>0) 
	{
	  namen = m_indices(comments);
	  for (i=sizeof(namen)-1;i>=0;i--)
	    re += (namen[i]+":\n"+comments[namen[i]]);
	  re += FLINE;
        } 
    }
       
  return re;
}

nosave nomask int xantr(string nr)
{
  int n;
  string re;
  
  //if (sec_check()) return 0;
  notify_fail("Syntax: xantr <nr>\n");
  if (!nr) return 0;
  
  n = to_int(nr);
  if (n<0) return 0;
  if(!member(antr,n) || !stringp(re=make_atext(n)))
    return write("Antrag '"+nr+"' nicht gefunden.\n"),1;
  TP->More(re);
  return 1;
}

nosave nomask int dantr(string nr)
{
  int n;
  string text;
  
  if (sec_check()) return 0;
  notify_fail("FINGER WEG!\n");
  //    if (!is_member(TP)) return 0;
  
  if(member(my_members,getuid(TP))==-1)
    return write(BS("Du darfst diesen Antrag nicht loeschen!")),1;
  
  notify_fail("Syntax: dantr <nr>\n");
  if (!nr) return 0;
  
  n = to_int(nr);
  if (n<0) return 0;
  if(!member(antr,n))
    return write("Antrag wurde '"+nr+"' nicht gefunden.\n"),1;
  text = make_atext(n);
  LOGIT("antraege",sprintf("Antrag %d geloescht von %s:\n%s\n",n,UTP,text));
  antr = m_delete(antr,n);
  if (member(cmts,n)) cmts = m_delete(cmts,n);
  save_it();
  LOGIT("office",getuid(TP)+" loescht Antrag "+n);
  write("Antrag Nummer "+n+" wurde geloescht.\n");
  return 1;
}

nosave nomask int cmt(string nr)
{
  int n;
  mapping c;
  string u,pre;
  object ob;
  
  //if (sec_check()) return 0;
  notify_fail("Syntax: cmt <nr>\n");
  if (!nr) return 0;
  
  n = to_int(nr);
  if (n<0) return 0;
  if (!member(antr,n))
    return write("Antrag wurde leider '"+nr+"' nicht gefunden.\n"),1;
  u = getuid(TP);
  
  if ( !mappingp(c=cmts[n]) || !stringp(pre=c[u]) )
    pre = "";
  ob = clone_object(MY_EDITOR);
  if(!objectp(ob))
    return write("ERROR\n"),1;
  ob->move(TP,M_NOCHECK);
  ob->StartEditorK(TP,pre,n);
  return 1;
}

nomask void EditorOutputK(object pl, string in, int n)
{
  mapping c;
  string u;
  
  if(!PO || !objectp(PO) || explode(FN(PO),"#")[0]!=MY_EDITOR)
    return tell_room(TO,"E-ERROR.\n");
  if(!objectp(pl) || !stringp(in) || !intp(n) ||
      strlen(in)<2 || n<1 )
    return tell_room(TO,"E-ERROR 2.\n");
  u = getuid(pl);
  if (!mappingp(c=cmts[n])) c = ([u:""]);
  c[u]=in;
  cmts[n]=c;
  save_it();
  return;
}

nosave nomask int dcmt(string nr)
{
  int n;
  mapping c;
  string u;

  // if (sec_check()) return 0;
  notify_fail("Syntax: dcmt <nr>\n");
  if(!nr) return 0;
  
  n = to_int(nr);
  if(n<0) return 0;
  if(!member(antr,n))
    return write("Antrag '"+nr+"' nicht gefunden.\n"),1;
  if(!(c=cmts[n]))
    return write("Keine Kommentare zu Antrag '"+nr+"' gefunden.\n"),1;
  u = getuid(TP);
  if(!member(c,u))
    return write("Du hast keinen Kommentar zu diesem Antrag geschrieben.\n"),1;
  c = m_delete(c,u);
  if (m_sizeof(c)<1) cmts = m_delete(cmts,n);
  else cmts[n]=c;
  save_it();
  write("OK. Du hast Dein Kommentar zu Antrag '"+nr+"' geloescht.\n");
  return 1;
}

// Sortier-Funktion

sort_antr()
{
  mapping newa,newc,olda,oldc;
  int *ind,i,m;
  
  if(TIA!=FPL("dante")||
     TIA!=FPL("protheg")) return 0;
  if(m_sizeof(antr)<1) 
    {
      count = 0;
      write("SHORT-CLEAN-UP DONE!\n");
      return 1; 
    }
  olda = copy_mapping(antr);  newa = ([]);
  oldc = copy_mapping(cmts);  newc = ([]);
  ind = m_indices(olda);
  ind = sort_array(ind,CLOSURE(>));
  for (i=sizeof(ind)-1;i>=0;i--) 
    {
      newa[i+1,0] = olda[ind[i],0];
      newa[i+1,1] = olda[ind[i],1];
      newa[i+1,2] = olda[ind[i],2];
      if(member(oldc,ind[i]))
	newc[i+1] = oldc[ind[i]];
      write(ind[i]+"->"+(i+1)+" / "); 
    }
  write("<DO");
  antr = copy_mapping(newa);
  cmts = copy_mapping(newc);
  count = m_sizeof(antr);
  save_it();
  write("NE>\n");
  return 1;
}
