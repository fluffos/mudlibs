#include "../def.h"
#include <wizlevels.h>
#include <properties.h>
#include <moving.h>
#include <language.h>

inherit "/std/room";

#define FLINE "------------------------------------------------------------------------------\n"
#define SAVEFILE LOG "obj_antrag"
#define MY_EDITOR PRIVDIR "editor"
#define ERLAUBT ({ "dante","protheg","moira","ronja" })

#ifdef BS
#undef BS
#endif
#define BS break_string
#define LOGIT(x,y) write_file(LOG "buerolog"+x, \
    sprintf("[%s] %s\n", dtime(time()), y))
#define FPL(x) find_player(x)
#define TIA this_interactive()
#define UTP getuid(this_player())
#define PO previous_object()
#define FN file_name

int     count;
mapping antr,cmts;
string  *my_members;

nosave mapping inputs,shorts;

nosave string mitarbeiter=("Moira, Protheg und Ronja");

nosave int level=20;

nosave string tafel();

void create()
{
   ::create();

    inputs = ([]);
    shorts = ([]);

    if(!restore_object(SAVEFILE)) 
      {
	my_members = ({"dante", "ronja","moira","protheg"});
	antr = ([]);
        cmts = ([]);
        count = 0;
        LOGIT("","create()::RESTORE_ERROR"); 
      }
    
    SetProp(P_INT_SHORT,"Das Buero fuer die Antraege auf private Objekte");
    SetProp(P_INT_LONG,break_string(
        "Hier bist Du nun im Buero fuer die Antraege auf private Objekte. "
        "Hier kannst Du Dir wuenschen, was Du willst, ob Du es bekommst, ist "
        "natuerlich eine andere Frage. "
        "Du stehst in einem einfachen Raum, bei dem es sich offenbar "
        "um ein Buero handelt. In der Mitte des Raumes steht ein "
        "Schreibtisch aus Holz, auf dem eine kleine Saeule aus "
        "Jade steht. Hinter dem Schreibtisch steht ein einfacher "
        "Stuhl. Hinter dem Stuhl siehst Du ein grosses Schild, das an der "
        "Wand haengt.\n"
        "Eine grosse Tafel!",78,0,BS_LEAVE_MY_LFS));


    AddDetail("tafel", CLOSURE(tafel));
    AddReadDetail("tafel", CLOSURE(tafel));


    AddDetail(({"raum","buero","ort"}),
	      "Mach doch mal 'schau'\n");
    AddDetail(({"mitte","tisch","schreibtisch","holztisch"}),
	      BS("In der Mitte des Bueros steht ein Schreibtisch aus Holz. Auf "+
		 "dem Schreibtisch steht eine kleine Saeule aus Jade. Hinter dem "+
		 "Schreibtisch steht ein Stuhl.",78) );
    AddDetail(({"holz","buchenholz"}),
	      "Es handelt sich um ganz normales Buchenholz.\n");
    AddDetail(({"saeule","jade","jadesaeule","kristall","speicher",
		  "speicherkristall"}),
	      BS("Die kleine Saeule aus Jade ist das einzige, was Du auf dem "+
		 "Tisch sehen kannst. Es scheint sich dabei um einen magischen "+
		 "Speicherkristall zu handeln.",78) );
    AddDetail(({"boden","steinboden"}),
	      "Der Boden besteht aus Stein.\n");
    AddDetail(({"stein","gestein"}),
	      "Ganz gewoehnliches hellgraues Gestein.\n");
    AddDetail(({"decke","holzdecke"}),
	      BS("Die Decke besteht aus dem gleichen Holz wie der Schreibtisch "+
		 "und der Stuhl. An der Decke haengt eine Lampe.",78) );
    AddDetail("lampe",
	      "Eine einfache Lampe, die dieses Buero beleuchtet.\n");
    AddDetail(({"wand","steinwand","waende","steinwaende"}),
	      BS("Die Waende bestehen aus hellgrauem Gestein. An der Wand hinter "+
		 "dem Schreibtisch haengt ein grosses Schild.",78) );
    AddDetail("schild",
	      "Probiers mal mit 'lies schild'.\n");
    AddReadDetail("schild",
		  "\n"+
		  "**************************************************\n"+
		  "*                                                *\n"+
		  "*  Offizielles Buero fuer private Gegenstaende   *\n"+
		  "*                                                *\n"+
		  "**************************************************\n"+
		  "\n");
    AddDetail(({"stuhl","holzstuhl"}),
	      "Der Stuhl hinter dem Schreibtisch ist recht einfach gearbeitet "+
	      "und wirkt auch nicht besonders gemuetlich.");
    
    seteuid(getuid(TO));
    
    AddCmd("liste","antr_liste");
    AddCmd("antrag","enter_antr");
    AddCmd("help","manual");
    AddCmd("xantr","xantr");
    AddCmd("dantr","dantr");
    AddCmd("cmt","cmt");
    AddCmd("dcmt","dcmt");
    
    
    AddExit("sueden", "/d/dschungel/dante/tijaraneu/room/ti_pfad6");
    
    AddItem("d/dschungel/dante/stein/npc/waechter2", REFRESH_DESTRUCT);
}

nosave tafel()
{
  return "+----------------------------------------------------------------------+\n"
    "+                                                                      +\n"
    "+  Richtlinien fuer das Antragstellen auf einen privaten Gegenstand!   +\n"
    "+                                                                      +\n"
    "+  1. Du kannst hier den Antrag auf einen persoenlichen Gegenstand     +\n"
    "+     abliefern. Je genauer Antrag ist, desto schneller und unprob-    +\n"
    "+     lematischer wird die Erfuellung Deines Wunsches ablaufen.        +\n"
    "+     Einziges Kriterium ist, dass Du zumindest Stufe "+level+" sein musst.   +\n"
    "+                                                                      +\n"
    "+  2. Wuensche die Dir irgendeinen Vorteil gegenueber den anderen      +\n"
    "+     Spielern bringen werden kommentarlos abgelehnt. Das heist,       +\n"
    "+     keine Waffen, Ruestungen usw, die nur Du besitzen kannst.        +\n"
    "+     Auch keine Wuensche die nur mit extrem grossen Aufwand zu        +\n"
    "+     realisieren sind, also keine Burgen, Schloesser...               +\n"
    "+                                                                      +\n"
    "+  3. Nerve die verantworlichen Magier nicht jeden Tag, was nun mit    +\n"
    "+     Deinem Wunsch sei. Sie kuemmern sich verlaesslich darum!         +\n"
    "+     Ueberlege Dir bevor Du Deinen Antrag stellst was Du genau        +\n"
    "+     willst und aendere Deinen Antrag nicht jeden Tag!                +\n"
    "+                                                                      +\n"
    "+  4. Wenn Dein Antrag erfuellt wurde, wirst Du verstaendigt.          +\n"
    "+     Solltest Du nach einer Woche noch immer nichts gehoert haben,    +\n"
    "+     so sprich die Verantwortlichen ruhig an!                         +\n"
    "+                                                                      +\n"
    "+                                                                      +\n"
    "+            Dante im Namen von "+mitarbeiter+"!              +\n"
    "+                                                                      +\n"
    "+----------------------------------------------------------------------+\n";
}

/* ===== Interne Funktionen ===== */

nosave nomask int sec_check()
{
  string u;
  u = getuid(TP);
  //  if ( u !="dante") return 0;
  if (member(my_members,u)!=-1) return 0;
  return 1;
}

nomask void save_it()
{ 
  save_object(SAVEFILE); 
}

varargs string GetExits( object viewer )
{
  string re;
  re = BS("'help office', 'antrag'",78,"Kommandos: ");
  re += ::GetExits(viewer);
  return re;
}

