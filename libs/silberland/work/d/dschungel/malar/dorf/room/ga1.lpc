inherit "std/room";

#include "../def.h"

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Anfang einer Dorfgasse" );
  SetProp(P_INT_LONG,
    "Eine Gasse mit Haeusern. Im Westen ist eine Tanke. Die Gasse "
    "verlaeuft weiter nach Norden.");  
  SetProp(P_LIGHT,1);
  SetProp(P_INDOORS,0);
  SetProp(P_ENVIRONMENT,([ ENV_TEMPERATURE:22, ENV_TERRAIN:TT_ROAD ]));
 
 
         


 AddExit("sueden",  ROOM "ha5");
 AddExit("westen",  ROOM "tanke");
 AddExit("norden",  ROOM "ga2");

}
  
  
  
