inherit "std/room";

#include "../def.h"

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Eine Partnervermittlungsstelle" );
  SetProp(P_INT_LONG,
    "Du stehst inmitten einer grossen Hallen die sogar zum groessten Teil "
    "aus Marmor besteht. Im Gegensatz zu restlichen Haeusern des Dorfes "
    "scheinen die Besitzer ziemlich reiche Leute zu sein, wenn sie sich "
    "eine solche luxurioese Austattung leisten koennen! An einer Wand "
    "steht ein dicker Eichentisch, hinter dem in einem fetten Sessel "
    "ein dicker Mann sitzt - Er ist wahrscheinlich der Partnervermittler "
    "und kann Dir sicherlich weiterhelfen.");   
  SetProp(P_LIGHT,1);
  SetProp(P_INDOORS,0);
  SetProp(P_ENVIRONMENT,([ ENV_TEMPERATURE:22, ENV_TERRAIN:TT_HOUSE ]));
 
 
         

 AddExit("suedosten",  ROOM "weg");

}
  
  
  
