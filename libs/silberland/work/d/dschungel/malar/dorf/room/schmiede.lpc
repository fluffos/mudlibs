inherit "std/room";

#include "../def.h"

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Eine Schmiede" );
  SetProp(P_INT_LONG,
    "Hier kommt dann eine Standardschmiede hin, damit auch die Spieler "
    "schoen ihre Sachen reparieren koennen.");   
  SetProp(P_LIGHT,1);
  SetProp(P_INDOORS,1);
  SetProp(P_ENVIRONMENT,([ ENV_TEMPERATURE:24, ENV_TERRAIN:TT_HOUSE ]));
 
 
         

 AddExit("westen",   ROOM "weg");

}
  
  
  
