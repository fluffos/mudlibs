inherit "std/room";

#include "../def.h"

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Eine Hauptstrasse" );
  SetProp(P_INT_LONG,
    "Du siehst nur eine Einoede. Im Sueden ist die Post.");   
  SetProp(P_LIGHT,1);
  SetProp(P_INDOORS,0);
  SetProp(P_ENVIRONMENT,([ ENV_TEMPERATURE:22, ENV_TERRAIN:TT_ROAD ]));
 
 
         
 AddItem( "/p/service/thor/postcards/obj/postkasten", REFRESH_REMOVE);

 AddExit("sueden", ROOM "post");
 AddExit("westen", ROOM "ha5");
 AddExit("osten",  ROOM "ha7");

}
  
  
  
