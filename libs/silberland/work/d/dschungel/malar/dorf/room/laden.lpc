inherit "std/laden";

#include "../def.h"
#include <laden.h>

void create()
{
  ::create();

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:20]));
  SetProp(P_INT_SHORT,"In einem kleinen Laden");
  SetProp(P_SHOPKEEPER_ID,   "rikus");
  SetProp(P_SHOPKEEPER_NAME, "Rikus");
  SetProp(P_SHOPKEEPER_GENDER,MALE);
  SetProp(P_SHOP_FLAGS, SHOP_HASKEEPER | SHOP_NEEDSKEEPER);
  SetStorageRoom(ROOM "lagerraum" );

// Hier wuerden die Details stehen ...


  AddExit("osten", ROOM "ga2");
  AddItem(NPC "rikus", REFRESH_DESTRUCT);
}

string _query_int_long()
{
  string txt;

  txt = "Du befindest Dich hier in einem kleinen Laden. Unzaehlige Regale "
        "stehen herum und sind gefuellt mit einigen Waffen und Ruestungen "
        "sowie diversen anderen Dingen. Besonders faellt Dir hier der "
        "Boden auf, denn er scheint aus nichts anderem als Baumstaemmen "
        "zu bestehen! ";
  if(QueryProp(P_SHOPKEEPER_ID))
  {
    if(!present(QueryProp(P_SHOPKEEPER_ID)))
    {
      txt += "Leider ist hier gerade kein Verkaeufer und somit kannst Du "
             "weder etwas kaufen noch verkaufen - Du musst wohl abwarten, "
             "bis Rikus sich wieder mal blicken laesst!";
    }
    else
    {
      txt += "Vor einem besonders grossem Regal steht ein kleiner Tisch, "
             "hinter dem ein kleiner und sicherlich auch habgieriger "
             "Zwerg nervoes auf und ab geht und auf Kundschaft wartet.";
    }
  }

  return BS(txt);
}
