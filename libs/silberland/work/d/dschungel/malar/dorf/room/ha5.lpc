inherit "std/room";

#include "../def.h"

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Der Dorfplatz auf der Hauptstrasse" );
  SetProp(P_INT_LONG,
    "Du siehst nur eine Einoede. "
    "Im Sueden die Schule, im Norden eine Gasse mit Haeusern.");   
  SetProp(P_LIGHT,1);
  SetProp(P_INDOORS,0);
  SetProp(P_ENVIRONMENT,([ ENV_TEMPERATURE:22, ENV_TERRAIN:TT_ROAD ]));
 
 
         

 AddExit("westen",  ROOM "ha4");
 AddExit("osten",   ROOM "ha6");
 AddExit("sueden",  ROOM "schule");
 AddExit("norden",  ROOM "ga1");

}
  
  
  
