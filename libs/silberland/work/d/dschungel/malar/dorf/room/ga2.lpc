inherit "std/room";

#include "../def.h"

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Ende einer Dorfgasse" );
  SetProp(P_INT_LONG,
    "Eine Gasse mit Haeusern. Im Westen ist ein Laden. Im Osten ist dann "
    "noch ein Haus mit einem alten Mann drin.");  
  SetProp(P_LIGHT,1);
  SetProp(P_INDOORS,0);
  SetProp(P_ENVIRONMENT,([ ENV_TEMPERATURE:22, ENV_TERRAIN:TT_ROAD ]));
 
 
         


 AddExit("sueden",  ROOM "ga1");
 AddExit("westen",  ROOM "laden");
 AddExit("osten",   ROOM "haus1");

}
  
  
  
