inherit "std/room";

#include "../def.h"

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Eine Hauptstrasse" );
  SetProp(P_INT_LONG,
    "Du siehst nur eine Einoede. "
    "Im Norden kommt die Scheune mit den Kindern hin.");   
  SetProp(P_LIGHT,1);
  SetProp(P_INDOORS,0);
  SetProp(P_ENVIRONMENT,([ ENV_TEMPERATURE:22, ENV_TERRAIN:TT_ROAD ]));
 
 
         

 AddExit("sueden", ROOM "ha2");

}
  
  
  
