inherit "std/room";

#include "../def.h"

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Im Turm" );
  SetProp(P_INT_LONG,
    "Erdgeschoss vom Turm. Muss mal gucken, wie hoch der gehen soll..");   
  SetProp(P_LIGHT,1);
  SetProp(P_INDOORS,1);
  SetProp(P_ENVIRONMENT,([ ENV_TEMPERATURE:24, ENV_TERRAIN:TT_HOUSE ]));
 
 
         

 AddExit("raus",   ROOM "ha8");

}
  
  
  
