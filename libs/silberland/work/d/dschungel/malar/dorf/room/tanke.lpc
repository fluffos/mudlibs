inherit "std/room";

#include "../def.h"

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Eine Kneipe" );
  SetProp(P_INT_LONG,
    "Hier kommt dann eine Tanke hin.");   
  SetProp(P_LIGHT,1);
  SetProp(P_INDOORS,1);
  SetProp(P_ENVIRONMENT,([ ENV_TEMPERATURE:28, ENV_TERRAIN:TT_HOUSE ]));
 
 
         

 AddExit("sueden",  ROOM "ha4");
 AddExit("osten",   ROOM "ga1");

}
  
  
  
