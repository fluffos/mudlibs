inherit "std/room";

#include "../def.h"

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Eine Hauptstrasse" );
  SetProp(P_INT_LONG,
    "Du siehst nur eine Einoede. Im Norden ist die Dorfkapelle.");   
  SetProp(P_LIGHT,1);
  SetProp(P_INDOORS,0);
  SetProp(P_ENVIRONMENT,([ ENV_TEMPERATURE:22, ENV_TERRAIN:TT_ROAD ]));
 
 
         

 AddExit("norden", ROOM "kirche");
 AddExit("osten",  ROOM "ha8");
 AddExit("westen", ROOM "ha6");

}
  
  
  
