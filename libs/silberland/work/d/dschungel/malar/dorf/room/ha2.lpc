inherit "std/room";

#include "../def.h"

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Eine Hauptstrasse" );
  SetProp(P_INT_LONG,
    "Du siehst nur eine Einoede.");   
  SetProp(P_LIGHT,1);
  SetProp(P_INDOORS,0);
  SetProp(P_ENVIRONMENT,([ ENV_TEMPERATURE:22, ENV_TERRAIN:TT_ROAD ]));
 
 
         

 AddExit("westen",  ROOM "ha1");
 AddExit("osten",   ROOM "ha3");
 AddExit("norden",  ROOM "ki1");

}
  
  
  
