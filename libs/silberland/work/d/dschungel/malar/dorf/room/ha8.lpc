inherit "std/room";

#include "../def.h"

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Das Ende der Hauptstrasse" );
  SetProp(P_INT_LONG,
    "Du stehst vor einem Turm der gewaltig hoch ragt. Im Norden "
    "ist ein kleiner Weg zu erkennen.");   
  SetProp(P_LIGHT,1);
  SetProp(P_INDOORS,0);
  SetProp(P_ENVIRONMENT,([ ENV_TEMPERATURE:22, ENV_TERRAIN:TT_ROAD ]));
 
 
         

 AddExit("westen",  ROOM "ha7");
 AddExit("norden",  ROOM "weg");
 AddExit("turm",    ROOM "turm1.lpc");
 
 

}
  
  
  
