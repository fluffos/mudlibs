inherit "std/room";

#include "../def.h"

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "In der Dorfschule" );
  SetProp(P_INT_LONG,
    "Die Schule.");  
  SetProp(P_LIGHT,1);
  SetProp(P_INDOORS,1);
  SetProp(P_ENVIRONMENT,([ ENV_TEMPERATURE:26, ENV_TERRAIN:TT_HOUSE ]));
 
 
         


 AddExit("norden",  ROOM "ha5");

}
  
  
  
