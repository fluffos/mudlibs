inherit "/std/room";

#include "/mail/post.h"
#include <rooms.h>
#include "../def.h"

create(argh) 
{
  int i;
  (::create());
  SetProp(P_INT_SHORT,"Ein Dorfpostamt");
  SetProp(P_INT_LONG,
    "Du stehst inmitten eines kleinen Dorfpostamtes. Die Waende "
    "bestehen aus einem sehr dunklen Holz, was Dir sofort auffaellt. "
    "Der Boden besteht hier aus einigen hellen Steinplatten, die "
    "scheinbar ziemlich schlecht verlegt wurden, so dass die Erde "
    "zwischen den Ritzen hervorquillt. Trotz dieser etwas duerftigen "
    "Einrichtung kannst Du von hier aus Briefe an Deine Mitspieler "
    "schicken und Briefe von ihnen lesen. Wenn Du das willst, betrete "
    "einfach eine der Postkabinen, um Deine Ruhe dabei zu haben! Nach "
    "Norden geht es wieder auf die Hauptstrasse zurueck.");
  SetProp(P_LIGHT,1);
  SetProp(P_INDOORS,1);
  
  AddDetail( ({"waende", "wand"}),
    "Die bestehen aus einem dunklen Holz, welches waagerecht "
    "uebereinander geschichtet worden ist.");
  AddDetail( ({"holz", "gebilde"}),
    "Es wurde waagerecht uebereinander geschichtet. Warum das ganze "
    "Gebilde jedoch nicht einfach so in sich zusammenklappt, kannst Du "
    "Dir gerade auch nicht erklaeren.");
  AddDetail("boden",
    "Der Boden besteht aus einigen grossen Steinplatten.");
  AddDetail( ({"steinplatten", "stein", "platten"}),
    "Die grossen und hellen Steinplatten wurden scheinbar gar nicht "
    "bearbeitet sondern einfach so auf den Boden gelegt um die "
    "groessten Teile der Erde abzudecken.");
  AddDetail("teile",
    "Die groessten Teile der Erde wurden durch die Steinplatten verdeckt, "
    "jedoch sind an manchen Stellen die Ritzen zwischen den Platten recht "
    "gross.");
  AddDetail( ({"brief", "briefe"}),
    "In den Kabinen kann man sicherlich in Ruhe Briefe schreiben und "
    "natuerlich auch lesen.");
  AddDetail( ({"lesen", "schreiben", "ruhe"}),
    "Beim Lesen und Schreiben der Briefe ist Ruhe ganz wichtig.");
  AddDetail("kabinen",
    "In ihnen kann man sich sicherlich in Ruhe seiner Post zuwenden.");
  AddDetail("post",
    "In diesem kleinen Dorfpostamt kann man Post schreiben und lesen.");
  AddDetail( ({"dorfpostamt", "postamt", "amt"}), QueryProp(P_INT_LONG));
  AddDetail("decke",
    "Die ist hier ziemlich niedrig, jedoch kannst Du noch bestens "
    "stehen und ganz einfach eine Kabine betreten.");
  AddDetail("kabine",
    "Hm, also wenn hier keine ist, wend Dich bitte an einen Magier!");
  AddDetail("einrichtung",
    "Von den beiden Kabinen mal abgesehen ist die Einrichtung recht duerftig.");
  AddDetail("erde",
    "Die quillt aus den Ritzen zwischen den Steinplatten raus!");
  AddDetail("mitspieler",
    "Ja Du kannst an alle Mitspieler Briefe senden! Ausserdem kannst Du "
    "sogar an Individuen aus anderen Welten schreiben.");
  AddDetail("individuen",
    "Seien es Elfen, Zwergen, Oger oder andere Rassen - das ist beim "
    "Versenden der Briefe total egal.");
  AddDetail( ({"elfen", "zwerge", "zwergen", 
               "oger", "rassen", "versenden", "rasse"}),
    "Beim Versenden ist es hier voellig egal, welcher Rasse Du einen "
    "Brief zukommen lassen moechtest!");
  AddDetail("magier",
    "Am besten fragt man einen, der nicht gerade am idlen ist ;-)");
  AddDetail("welten",
    "Es soll nach Geruechten her andere Welten wie z.B. ein gewisses "
    "Morgengrauen geben. Ausserdem gibt es auch eine reale Welt, in "
    "die man Briefe verschicken kann!");
  AddDetail("morgengrauen",
    "Vielleicht ist es ja auch eine Welt, genau wie das Silberland?");
  AddDetail( ({"silberland", "welt"}),
    "Das ist diese Welt, in der Du Dich zur Zeit befindest.");
  AddDetail( ({"geruechten", "geruechte", "geruecht"}),
    "Den Geruechten zufolge sollen wirklich andere Welten neben "
    "der des Silberlandes existieren!");
  AddDetail("postkabinen",
    "In ihnen kann man sich sicherlich in Ruhe seiner Post zuwenden.");
  AddSpecialDetail( ({"zeit", "uhrzeit"}), "zeit");
  AddDetail( ({"stelle", "stellen"}),
    "Nur gelegentlich tritt eine solche Stelle auf.");
  AddDetail("ritzen",
    "Durch die Ritzen quillt Erde hoch und verschmutzt den ganzen 'Boden'.");
  AddDetail( ({"strasse", "hauptstrasse"}),
    "Die liegt im Norden!");
  AddDetail("norden",
    "Dort befindet sich die Hauptstrasse.");
    
  AddSmell(DEFAULT_SMELL,
    "Es riecht hier ein wenig nach Moder. ");
  AddSmell( ({"moder", "modergeruch", "gerueche", "geruechen", "geruch"}),
    "Der Modergeruch setzt sich sicherlich aus den Geruechen von Erde "
    "und Holz zusammen.");
  AddSmell( ({"erde", "erdgeruch"}),
    "Der Erdgeruch kommt aus den Ritzen!");
  AddSmell("ritzen",
    "Aus denen kommt der Erdgeruch.");
  AddSmell( ({"holz", "holzgeruch"}),
    "Die Waende sind aus Holz - daher der Holzgeruch.");
  AddSmell("waende",
    "Sie bestehen aus Holz und verbreiten einen moderigen Holzgeruch. "
    "Einfach ekelhaft!");
  
  AddSound(DEFAULT_SOUND,
    "Du kannst Scharren unter Deinen Fuessen hoeren.");
  AddSound("scharren",
    "Du verursachst es durch das Reiben Deiner Fuesse an den Steinplatten.");
  AddSound( ({"reiben","fuesse","fuessen","platten","steinplatten","geraeusch"}),
    "Bei diesem Geraeusch kann man wirklich eine Gaensehaut bekommen!");
  AddSound("gaensehaut",
    "KCCCCCCCHHH!");
    
  AddItem(NPC "rikoxa", REFRESH_DESTRUCT);
  AddCmd("post","do_mail");
  AddCmd("mail","do_mail");
  AddExit("norden",ROOM "ha6");

    if (!argh) 
    {
      for (i=0;i<NRCABINS;++i) AddItem(MAILCABIN,REFRESH_REMOVE);
    }
}

do_mail(str) 
{
  object mailer;
  if(this_interactive()!=this_player()) return 0;
  mailer=clone_object(MAILER);
  mailer->SetOfficeName(short());
  mailer->do_mail(str);
  return 1;
}

string zeit(string key)
{
  return "Die aktuelle Uhrzeit ist: "+dtime(time())[<8..]+"\n";
}