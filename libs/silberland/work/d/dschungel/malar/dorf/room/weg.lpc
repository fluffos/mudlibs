inherit "std/room";

#include "../def.h"

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Ein kleiner Weg" );
  SetProp(P_INT_LONG,
    "Ein Kleiner Weg, der von der Hauptstrasse abzweigt. Im Osten "
    "hat der Schmied seine Huette und im Westen ist ein abgewracktes "
    "Bordell.");   
  SetProp(P_LIGHT,1);
  SetProp(P_INDOORS,0);
  SetProp(P_ENVIRONMENT,([ ENV_TEMPERATURE:22, ENV_TERRAIN:TT_ROAD ]));
 
 
         
 AddExit("osten",   ROOM "schmiede");
 AddExit("sueden",  ROOM "ha8");

}
  
  
  
