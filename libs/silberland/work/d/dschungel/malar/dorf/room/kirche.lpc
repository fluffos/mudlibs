inherit "std/room";

#include "../def.h"

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Eine kleine Dorfkapelle" );
  SetProp(P_INT_LONG,
    "Hier kommt dann die kleine Dorfkapelle hin.");   
  SetProp(P_LIGHT,1);
  SetProp(P_INDOORS,1);
  SetProp(P_ENVIRONMENT,([ ENV_TEMPERATURE:24, ENV_TERRAIN:TT_HOUSE ]));
 
 
         

 AddExit("sueden",   ROOM "ha7");

}
  
  
  
