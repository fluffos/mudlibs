//15.12.2003 Archon: infos

inherit "std/npc";

#include "../def.h"

void create()
{
  if (!is_clone(this_object())) return;

  ::create();    

  SetProp(P_SHORT, "David");
  SetProp(P_LONG,
    "Der kleine David ist so arm und hat noch keine Long :-(");  
  SetProp(P_NAME, "David");
  SetProp(P_GENDER, FEMALE);
  AddId( ({ "david", "junge", "kind", "psycho", "alien", "wesen" }) );
  SetProp(P_KILL_NAME, "David");
  create_default_npc( 35 );
  SetProp(P_BODY, 200);
  SetProp(P_HANDS, ({" mit koeniglichen Wurzeln", 330, DT_WHIP}));
  SetProp(P_ALIGN, 600);
  SetProp(P_SIZE, 155);
  SetProp(P_HEAL, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_NOMAGIC, 100);
  SetProp(P_RACE, "Mensch");
  AddClass(CL_HUMAN);
  SetProp(P_SPELLRATE, 46);
  SetProp(P_AGGRESSIVE, 0);

  SetProp(P_RESISTANCE_STRENGTHS, ([ 
    DT_SLASH      :0.1,    DT_BLUDGEON    :0.2,      DT_PIERCE     :0.1,
    DT_SQUEEZE    :0,      DT_WHIP        :0.2,      DT_RIP        :0.1,
    DT_FIRE       :0.4,    DT_COLD        :0.1,      DT_WATER      :-0.8,    
    DT_AIR        :-0.2,   DT_LIGHTNING   :-0.5,     DT_EXPLOSION  :0.1, 
    DT_SOUND      :-0.8,   DT_LIGHT       :-0.4,     DT_ELECTRIC   :-0.4,    
    DT_ACID       :0.2,    DT_POISON      :0.3,      DT_TERROR     :0.5,     
    DT_HOLY       :-0.4,   DT_UNHOLY      :0.5,      DT_MAGIC      :0.3]) ); 
  
  SetProp(P_DEFAULT_INFO, "ist voellig schuechtern und blickt nur zu Boden.");





}
     

void Attack(object enemy)
{
  if (random(100)<30) 
  {
    tell_room(environment(TO),BS(
      "Davids Augen fangen an zu leuchten! "
      "Du bist voellig paralysiert! "
      "Deine Lebenskraft schwindet bis zum Nullpunkt und Du sackst "
      "tot zusammmen! Das war ja mal ein Todeszauber!"));
    enemy->do_damage(400);
    TO->StopHuntFor(enemy);
    enemy->StopHuntFor(TO);
  }
  ::Attack(enemy);
}

