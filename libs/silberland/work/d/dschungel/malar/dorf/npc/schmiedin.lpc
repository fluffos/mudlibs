inherit "std/repair";
inherit "std/npc/compare";

#include "../def.h"

void create()
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Xolgrima, die zwergische Schmiedin");
  SetProp(P_LONG,
    "Xolgrima ist eine zwergische Schmiedin, die ihr Geld damit verdient, "
    "indem sie hier hier Ruestungen fuer andere Leute repariert. Sie ist "
    "total verdreckt und bedeckt ihre Bloesse einzig durch abgefetzte "
    "und dreckige Lumpen, die sicherlich auch unter ihrer Arbeit als "
    "Schmiedin leiden und immer mehr zerfallen. ");

  SetProp(P_NAME, "Xolgrima");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"schmied","schmiedin","xolgrima",}) );
 

  create_default_npc(33);
  SetProp(P_HANDS,
    ({" mit ihren dreckigen Zwergenhaenden",230+random(40),DT_BLUDGEON}));
  SetProp(P_RACE, "Zwerg");
  AddClass(CL_DWARF);
  SetProp(P_BODY, 280);
  SetProp(P_SIZE, 120+random(20));
  SetProp(P_ALIGN, 737+random(150));
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_NOMAGIC, 2);
  SetProp(P_ARTICLE, 0);
  SetProp(P_RESISTANCE_STRENGTHS,([ 
    DT_FIRE  : -0.1, DT_POISON: -0.5, 
    DT_MAGIC :  0.6, DT_WATER :  0.3, DT_TERROR: 0.5]) );


  SetProp(P_REJECT,({REJECT_DESTRUCT,
    "Xolgrima wirft @WEN einfach in den heissen Ofen!\n"
    "Natuerlich verbrennt @WER sofort in den heissen Flammen!\n"}) );

  SetChats(2,
    ({"Xolgrima schwitzt stark aufgrund der schweren Arbeit.\n",
      "Xolgrima wischt sich den Scheiss von Stirn.\n",
      "Xolgrima ruempft ihre Nase aufgrund ihres eigenen Geruchs..\n"}));

  SetAttackChats(10,
    ({"Xolgrima schreit: Meine Rache wird Dich treffen!!\n",
      "Xolgrima versucht Dich mit dem Hammer zu erwischen!\n",
      "Xolgrima sagt: Wer soll denn den Leuten die Ruestungen reparieren?\n"}));
      
  AddDetail("geld",
    "Sie verdient ihr Geld durch das Reparieren von Ruestungen.");
  AddDetail( ({"reparieren", "reparatur"}),
    "Um eine Reparatur kannst Du sie per 'repariere ruestung' bitten.");
  AddDetail("leute",
    "Ja die repariert hier allen ihre kaputten Ruestungen, um so Geld "
    "zu verdienen.");
  AddDetail("bloesse",
    "Die wird lediglich durch abgefetzte Lumpen abgedeckt.");
  AddDetail("lumpen",
    "Die sind total zerfetzt und riechen tun sie auch nicht besonders.");
  AddDetail("arbeit",
    "Als Schmiedin geht Xolgrima einer sehr schweren Arbeit nach.");
    
  AddInfo(DEFAULT_INFO,
    "Lass mich in Ruhe! Ich reparier Dir gerne Deine Ruestungen, auf "
    "unsinniges Gequatsche hab ich jedoch keine Lust!!", "schnauzt: ");
  AddInfo("ruhe",
    "Die hab ich mir bitter verdient!", "meint: ");
  AddInfo("ruestungen",
    "Ich reparier Dir alle Deine kaputten Ruestungen fur ein "
    "wenig Geld.", "sagt: ");
  AddInfo( ({"lust", "gequatsche", "quatschen"}),
    "Ich hab keine Lust aufs Quatschen!", "keift: ");
  AddInfo("geld",
    "Naja umsonst mach ich Dirs sicherlich nicht!", "sagt: ");
  AddInfo("lumpen",
    "Was willst Du von mir? Ach Du meinst mein schoenes Hemd. Hm naja, "
    "jedenfalls das, was mal davon uebrig geblieben ist. Durch die staendige "
    "Arbeit sieht es ziemlich mitgenommen aus.", "sagt: ");
  AddInfo("arbeit",
    "Ich schmiede und repariere Ruestungen!", "sagt: ");
  AddInfo("hemd",
    "Leider ist nicht mehr viel von uebrig..", "sagt traurig: ");
  AddInfo("schmiede",
    "In der befinden wir uns doch gerade.", "meint: ");
    
  SetProp(P_SPELLRATE, 8);
  
  //Kraeftiger Hammerschlag auf den Kopf
  AddSpell(1,560,
    "Xolgrima haut Dir ein mal kraeftig den Hammer auf den Kopf! AUA!!!\n",
    "Xolagrima haut @WEM mit dem Hammer auf den Kopf.\n",
    DT_SLASH,([SP_SHOW_DAMAGE:1]) );
  //Funkenflug mitten ins Gesicht des Spielers!
  AddSpell(5,260+random(35),
    "Xolgrima pustet Dir Funken mitten ins Gesicht!\n",
    "Xolgrima pustet eine Menge Funken mitten in @WESSEN Gesicht!\n",
    DT_FIRE,([SP_SHOW_DAMAGE:1]) );

  SUID;
  CLONEME("/d/dschungel/dante/weg/armour/dlumpen");
  CLONEME("/p/weapon/club/schmiedehammer");
  command("zuecke hammer");
  command("trage alles");
}

int rep_auswahl(object ob)
{
  if(!ob->QueryProp(P_ARMOUR_TYPE))
  {
    TP->Message(BS("Xolgrima sagt: Ich repariere nur Ruestungen!"),
        MSGFLAG_SOUND);
    return 0;
  }
  return 1;
}