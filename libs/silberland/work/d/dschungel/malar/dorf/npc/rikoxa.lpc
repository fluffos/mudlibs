inherit "std/npc";

#include "../def.h"
#include "/std/living/put_and_get.lpc"

void create()
{
  if (!is_clone(this_object())) return;

  ::create();    

  SetProp(P_SHORT, "Rikoxa");
  SetProp(P_LONG,
    "Rikoxa scheint die Verwalterin des kleinen Dorfpostamtes zu sein. "
    "Sie achtet darauf, dass hier keiner versucht irgendetwas zu stehlen "
    "oder gar die Kabinen zu zerstoeren. Sie tut das allein aus dem Grund, "
    "weil sie das Briefe lesen und schreiben fuer sehr wichtig haelt. "
    "Sie ist fuer einen Zwerg ziemlich klein, hat aber sehr auffaellige "
    "rote Haare.");  
  SetProp(P_NAME, "Rikoxa");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"verwalterin", "zwergin", "frau", "rikoxa"}) );
  AddClass(CL_DWARF);
  SetProp(P_KILL_NAME, "Rikoxa");
  SetProp(P_KILL_MSG,"Niemand vergreift sich an meinem Postamt!");
  create_default_npc(25);
  SetProp(P_MAX_HP, 700+random(100)); // erhoeht, damits bisschen schwerer ist
  SetProp(P_BODY, 160+random(10));
  SetProp(P_HANDS, ({" mit wuetenden Zwergenhaenden", 180, DT_BLUDGEON}));
  SetProp(P_ALIGN, 850+random(100)); //recht gutmuetig, aber total verwirrt
  SetProp(P_ARTICLE, 0);
  SetProp(P_SIZE, 90);
  SetProp(P_HEAL, 5+random(6));
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_NOMAGIC, 15); 
  SetProp(P_RACE, "Zwerg");
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_RESISTANCE_STRENGTHS,([ 
    DT_FIRE  : -0.2, DT_POISON: -0.2, 
    DT_MAGIC :  0.6, DT_WATER :  0.5, DT_TERROR: 0.6]) ); 
    
  AddDetail("grund",
    "Danach solltest Du sie lieber fragen, anstatt sie danach zu "
    "untersuchen!");
  AddDetail("briefe",
    "Die kann man hier sicherlich schreiben und lesen.");
  AddDetail("haare",
    "Ihre Haare sind total rot! Nur ein Haar sticht besonders heraus.");
  AddDetail( ({"haar", "grau"}),
    "Es ist grau.");
    
  SetChats( 3,({
    "Rikoxa denkt   . o 0 (Wann meldet sich Rikus denn mal?)\n",
    "Rikoxa sagt: Es sollten viel mehr Briefe geschrieben werden!\n",
    "Rikoxa brabbelt etwas von raffgierigen Zwergen und einer zerbrochenen "
    "Liebe.\n"}));
  SetAttackChats( 7, ({
    "Rikoxa schreit: Ich werde dieses Postamt verteidigen!!\n",
    "Rikoxa streicht sich schnell die wuscheligen Haare aus dem Gesicht.\n",
    "Rikoxa gibt Dir eine schallende Ohrfeige!"}));

  
  SUID;
  CLONEME("/p/armour/belt/guertel");
  CLONEME("/p/armour/boots/lederstiefel");
  CLONEME("/p/armour/trousers/rock_kurz");
  command_me("trage alles");
  
  AddInfo(DEFAULT_INFO,
    "Hm auf dem Gebiet bin ich nicht erfahren genug..", "sagt ratlos: ");
  AddInfo("gebiet",
    "Auf welchem Gebiet meinst Du denn?", "fragt verwundert: ");
  AddInfo( ({"post", "postamt"}),
    "Diese Post ist mein ganzer Stolz! Ich habe sie einzig allein aus dem "
    "Grund aufgebaut, weil ich das Briefeschreiben fuer eine wichtige "
    "Taetigkeit halte! Das Geld, welches sich die anderen hier unter "
    "den Nagel reissen wollen, will ich gar nicht.", "erklaert: ");
  AddInfo("grund",
    "Naja.. Ich hatte meine Gruende das Briefeschreiben so zu verehren!",
    "sagt verlegen: ");
  AddInfo("gruende",
    "Das Briefeschreiben hat mir zu meiner ersten Liebe verholfen!", 
    "strahlt: ");
  AddInfo("briefeschreiben",
    "In einer dieser Kabinen kannst Du dieser Taetigkeit nachgehen!", "sagt :");
  AddInfo("liebe",
    "Die war mit einem anderen Zwerg. Vielleicht kennst Du ihn ja sogar: "
    "Es ist Rikus, der Ladenverkaeufer.", "sagt schuechtern: ");
  AddInfo( ({"rikus", "verkaeufer", "ladenverkaeufer"}),
    "Mit ihm hatte ich meine erste Liebe! Sein Laden ist weiter im Norden.",
    "sagt: ");
  AddInfo("laden",
    "Der Laden von Rikus ist weiter im Norden.");
  AddInfo("norden",
    "Nach Norden gehts zurueck auf die Hauptstrasse.", "sagt: ");
  AddInfo("hauptstrasse",
    "Noerdlich von ihr befindet sich Rikus' Laden.", "sagt: ");
  AddInfo("taetigkeit",
    "Extrem wichtig!", "kreischt: ");
  AddInfo("geld",
    "Geld interessiert mich nicht.", "meint: ");
  AddInfo("nagel",
    "Ja die meisten hier sind irgendwelche raffgierigen Zwerge, die sich "
    "alles Geld, was sie nur irgendwie bekommen koennen, unter den Nagel "
    "reissen wollen!", "schnaubt: ");
  AddInfo( ({"kabine", "kabinen"}),
    "Du kannst einfach eine Kabine betreten und in ihr in Ruhe Briefe lesen "
    "und natuerlich auch schreiben. Aber wehe Dir Du willst diese Kabinen "
    "zerstoeren oder einfach nehmen und so alle Leute am Briefeschreiben "
    "hindern!", "erklaert: ");
  AddInfo("ruhe",
    "Die ist beim Briefeschreiben ganz angebracht.", "meint erfahren: ");
  AddInfo("leute",
    "Alle sollten viele Briefe lesen und schreiben!", "hofft: ");
  AddInfo("briefe",
    "Du kannst in diesem Postamt welche lesen und natuerlich auch schreiben.");
  
  SetProp(P_LOG_INFO, "/malar/rikoxa.log");
  
  

  SetProp(P_SPELLRATE, 20);
  
  AddSpell(1,250+random(40),
    "Rikoxa schreit: Meine Post wird bestehen bleiben!\n"
    "Rikoxa tritt Dir ein mal kraeftig in den Hintern!\n",
    "Rikoxa tritt @WEM ein mal kraeftig in den Hintern!\n",
    DT_BLUDGEON,([SP_SHOW_DAMAGE:1]) );
  AddSpell(2,230+random(15),
    "Rikoxa wird zur Furie und zerkratzt Dein Gesicht!\n",
    "Rikoxa wird zur Furie und zerkratzt @WESSEN Gesicht!\n",
    DT_RIP,([SP_SHOW_DAMAGE:1]) );
  AddSpell(3,260+random(35),
    "Rikoxa springt hoch in die Luft und landet auf Deinem Fuss! AUA!\n",
    "Rikoxa springt hoch in die Luft und landet auf @WESSEN Fuss!\n"
    "Das muss doch wehtun!\n",
    DT_SQUEEZE,([SP_SHOW_DAMAGE:1]) );
    
  AddCmd("nimm&kabine|kabinen", "cmd_kabinen",
         "WAS nehmen?");


}

int FrissLeiche(object killer)
{
   killer->command_me("nimm alles aus leiche");
   killer->command_me("sag Seine Ruestung wird mir helfen, diese Post "
                      "zu schuetzen!");
   killer->command_me("trage alles");
   return 0;
}
     
void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  write_file(LOG "rikoxa.kills", 
  sprintf( ctime()+": Rikoxa bringt "+CAP(getuid(player))
  +" um! - Spieler verliert %d EP!\n", lostexp));
  if(killer == TO )
    call_out("FrissLeiche", 3, killer);
  else return 0;
}


int cmd_kabinen(string str)
{
  if(TP->QueryProp(P_GHOST) == 1) return 0; 
  TO->command_me("sag Niemand vergreift sich an dieser Post, wenn ich dabei bin!");
  TO->Kill(TP);
  return 1;
}