inherit "std/npc";
inherit "std/npc/spells";

#include "../def.h"
#include "/std/living/put_and_get.lpc"


void create()
{
  if (!is_clone(this_object())) return;

  ::create();    

  SetProp(P_SHORT, "Rikus");
  SetProp(P_LONG,
    "Rikus ist ein kleiner und habgieriger Zwerg, der durch seinen kleinen "
    "Laden versucht, ein wenig Geld in seine sonst so leere Geldboerse zu "
    "bringen. Er traegt eine heruntergekommene Lederruestung, bis zu deren "
    "Mitte sein langer, brauner Bart gewachsen ist. Er ist schon recht alt, "
    "denn seine wenigen Haaren sind ziemlich farblos und sein faltiges Gesicht "
    "zeugt von seinem bisher wohl rauhen Leben.");  
  SetProp(P_NAME, "Rikus");
  SetProp(P_GENDER, MALE);
  AddId( ({"verkaeufer", "zwerg", "mann", "rikus", "ladenverkaeufer"}) );
  
  create_default_npc(18+random(3));  
  AddClass(CL_DWARF);
  SetProp(P_KILL_NAME, "Rikus");
  SetProp(P_KILL_MSG,"Deine Ruestung kommt mir wie gerufen!");
  SetProp(P_DIE_MSG,  " roechelt noch kraeftig in seinen Bart und faellt "
                      "dann tot zu Boden!\n");
  SetProp(P_BODY, 160+random(20));
  SetProp(P_HANDS, ({" mit wuetenden Zwergenhaenden", 145, DT_BLUDGEON}));
  SetProp(P_ALIGN, 650+random(150)); //Bisschen Abwechslung.
  SetProp(P_ARTICLE, 0);
  SetProp(P_SIZE, 100+random(20));
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_NOMAGIC, 7);
  SetProp(P_RACE, "Zwerg");
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_REJECT, ({ REJECT_KEEP, "Rikus sagt: Oh vielen Dank!\n" }) );
  
  AddDetail("geld",
    "Er braucht sicherlich etwas, um hier ueberleben zu koennen.");
  AddDetail( ({"bart", "zwergenbart"}),
    "Ein richtig typischer Zwergenbart!");
  AddDetail("lederruestung",
    "Total heruntergekommen! Er muss wirklich ganz arm sein.");
  AddDetail("geldboerse",
    "Die ist sicherlich fast leer.");
  AddDetail("mitte",
    "Bis zur Mitte seiner Lederruestung ist ein langer Bart gewachsen!");
  AddDetail("haare",
    "Die sind farblos und Rikus sieht mit ihnen ziemlich alt aus.");
  AddDetail("gesicht",
    "Rikus' Gesicht ist voller Falten.");
  AddDetail("falten",
    "Die zeugen von einem hohen Alter und einem bisher rauhen Leben!");
    
  SetChats(4, ({
    "Rikus raeumt ein paar Dinge in einem Regal um.\n", 
    "Rikus fragt Dich: Willst Du nicht etwas kaufen?\n",
    "Rikus flucht: Diese bloede Rikoxa!\n",
    "Rikus denkt   . o 0 (Hoffentlich kauft mal jemand bald was!)\n",
    "Rikus krault sich den dichten Zwergenbart.\n"}) );
  SetAttackChats(6, ({
    "Rikus bruellt: Die Macht der Zwerge wird Dich treffen!!\n",
    "Rikus schreit: Ich werde Dich toeten und Deine Ausruestung an "
                   "mich reissen!\n"}) );

  
  SUID;
  CLONEME("/p/armour/armour/lederpanzer");
  CLONEME("/p/armour/boots/lederstiefel");
  command_me("trage alles");

  SetProp(P_RESISTANCE_STRENGTHS,([ 
    DT_FIRE  : -0.4, DT_POISON: -0.4, 
    DT_MAGIC :  0.4, DT_WATER :  0.4, DT_TERROR: 0.4]) );
  
  //Ein paar spezielle Informationen fuer den Ladenbesitzer:
  AddInfo(DEFAULT_INFO,
    "Ich kann Dir viel ueber diesen Laden erzaehlen!", "sagt: ");
  AddInfo("laden",
    "Ich habe diesen Laden gegruendet in der Hoffnung auf diese Weise "
    "mehr Geld in meine leere Boerse zu bringen. Ausserdem verstehen sich "
    "die meisten meines Zwergenvolkes mit dem Verkaufen von Sachen, warum "
    "sollte also gerade ich eine Ausnahme sein?", "erklaert: ");
  AddInfo("geld",
    "Mir und vielen anderen Zwergen ist das sehr wichtig!", "meint: ");
  AddInfo( ({"zwerge", "zwergen", "zwergenvolk", "volk", "talent"}),
    "Sie verstehen sich oft aufs Feilschen und haben mit diesem Talent oft "
    "ein paar Muenzen dazuverdienen koennen!", "sagt: ");
  AddInfo("feilschen",
    "Bisher konnte ich nur mit einigen einfaeltigen Elfen feilschen, aber "
    "ich glaube sie hatten eh nur Mitleid mit mir..", "erinnert sich: ");
  AddInfo("elfen",
    "Fremde Elfen kommen nur selten vorbei.", "sagt: ");
  AddInfo("hoffnung",
    "Noch hab ich Hoffnung auf eine dickere Boerse!", "sagt: ");
  AddInfo("boerse",
    "Die hoffe ich mit den Ertraegen dieses Ladens auffuellen zu koennen!",
    "hofft: ");
  AddInfo("verkaufen",
    "Ja verkauf mir Deine Sachen, so dass ich sie viel teurer weiterverkaufen "
    "kann und so ein gutes Geschaeft mache!", "sagt hinterhaeltig: ");
  AddInfo("geschaeft",
    "Bisher laeuft es noch nicht so gut.", "sagt: ");
  AddInfo("sachen",
    "Alles was ich verkaufe, kannst Du Dir per <zeige> anzeigen lassen.",
    "erklaert: ");
  AddInfo("ausnahme",
    "Ich hoffe mal, dass ich keine Ausnahme darstelle!", "sagt: ");
  AddInfo( ({"muenzen", "geld"}),
    "Immer her damit!!", "schreit gierig: ");
  AddInfo("mitleid",
    "Jedenfalls verhilft mir deren Mitleid auch zu Geld!", "sagt: ");
  AddInfo("rikoxa",
    "Mit der war ich mal zusammen, aber seit unserer Trennung hat sie nichts "
    "besseres mehr zu tun, als auf ihre bloede Post aufzupassen, damit auch "
    "ja nichts mit der passiert. Die kann man echt nur noch in den Wind "
    "schiessen!", "sagt veraechtlich: ");
  AddInfo("post",
    "Die ist weiter suedlich, direkt bei der Hauptstrasse!", "erklaert: ");
  AddInfo("hauptstrasse",
    "Die ist weiter suedlich.", "sagt: ");
  AddInfo("trennung",
    "Das ist eine laaange Geschichte!", "sagt: ");
  AddInfo("geschichte",
    "Och noe! Aufs Erzaehlen hab ich nun wirklich keine Lust!", "protestiert: ");
  AddInfo( ({"erzaehlen", "lust"}),
    "Zum Erzaehlen hab ich nun wirklich keine Lust!", "sagt: ");
     
  
  SetProp(P_SPELLRATE, 70); //Wahrscheinlichkeit recht hoch, dafuer Spells schwach
  
  //Kraeftiger Tritt in den allerwertesten :-)
  AddSpell(1,320+random(60),
    "Rikus tritt Dir ein mal kraeftig in den Hintern!\n",
    "Rikus tritt @WEM ein mal kraeftig in den Hintern!\n",
    DT_BLUDGEON,([SP_SHOW_DAMAGE:1]) );
  //Dicker Zwerg huepft auf den Fuss.
  AddSpell(3,260+random(35),
    "Rikus springt hoch in die Luft und landet auf Deinem Fuss! AUA!\n",
    "Rikus springt hoch in die Luft und landet auf @WESSEN Fuss!\n"
    "Das muss doch wehtun!\n",
    DT_SQUEEZE,([SP_SHOW_DAMAGE:1]) );
  //Grimasse macht Spieler Angst, so dass dieser in die Flucht geschlagen wird
  AddDefaultSpell(3,200,DS_FEAR,
    "Rikus schneidet ploetzlich eine fuerchterliche Grimasse, so dass Du vor "
    "Angst das Weite suchst!\n",
    "Rikus schneidet @WEM eine fuerchterliche Grimasse und schlaegt @WEN "
    "somit in die Flucht!\n");
    



}
//Habgieriger Zwerg nimmt natuerlich direkt seine Beute an sich
int Nimm(object killer)
{
   killer->command_me("nimm alles aus leiche");
   killer->command_me("sag Endlich hab ich was zum verkaufen!"); 
   return 0;
}

//Mitloggen der Spielertode;Initialisierung der Funktion "Nimm" 
void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO )
  {
   write_file(LOG "rikus.kills", 
     sprintf( ctime()+": Rikus bringt "+CAP(getuid(player))
     +" um! - Spieler verliert %d EP!\n", lostexp));
   call_out("Nimm", 3, killer);
  }
  return 0;
}

//Fuer die Reaktionen auf Emotes von Spielern wichtig:
void react(string victim, string others)
{
  if (present(TP, ENV(TO))) 
  {
    tell_object(TP, BS(Name(WER, 1) + " "+victim));
    tell_room(ENV(TO), BS(Name(WER, 1)+" "+others), ({TP,TO}));
  }
}



//Reaktionen auf bestimmte Emotes von Seiten der Spieler:
void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if (find_call_out("react")!= -1) return;
  switch(gruppe) 
  {
    case "fies":
      if ( random (2) )
        call_out("react", 0, "sagt: Du spielst mit Deinem Leben, "+TPN+"!");
      else
        call_out("angriff",0);
      break;
    case "aergerlich":
      call_out("react", 0, "sagt: Lass Deinen Aerger bitte an Rikoxa ab, "+TPN+"!");
      break;
    case "traurig":
      call_out("react", 0, "sagt: Kauf am besten was, dann gehts Dir gleich "
                           "besser, "+TPN+"!");
      break;
    case "albern":
      call_out("react", 0, "kichert in seinen langen Bart hinein.");
      break;
    case "neutral":
      call_out("react", 0, "nickt Dir hoeflich zu.", "nickt "+TP->name(WEM)+" zu.");
      break;
    case "intim":
      if ( QueryProp(P_GENDER) != TP->QueryProp(P_GENDER) )
         call_out("react", 0, "fluestert Dir zu: Besser als Rikoxa bist "
                              "Du sicherlich!.", 
                  "flirtet mit "+TP->name(WEM)+".");
      else
         call_out("react", 0, "meint bist irgendwie nicht mein Geschmack, "+TPN+".");
      break;
    case "froh":
      call_out("react", 0, "laechelt Dich an.",
             "laechelt "+TP->name(WEN)+" an.");
      break;
    case "aengstlich":
      call_out("react", 0, "meint: Angst ist dazu da ueberwunden zu werden!");
      break;
    case "frech":
      call_out("react", 0, "schnaubt: Treib es lieber nicht zu weit, "+TPN+"!");
      break;
    case "nett":
      call_out("react", 0, "nickt Dir freundlich zu.", "nickt "+TP->name(WEM)+" freundlich zu.");
      break;
  }
}

//Wird ausgefuehrt, sobald der NPC durch ein "fieses" Emote beleidigt wird
void angriff()
{
  if (present(TP, ENV(TO)) && !IS_LEARNING(TP))
  {
    tell_room(ENV(TO), Name(WER, 1)+" schreit: Das wirst Du buessen muessen!\n");
    Kill(TP);
  }
}

//Fuer die Reaktionen auf Emotes von Spielern wichtig:
void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}