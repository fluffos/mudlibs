// Project: Anxpyramide
// Comments:  Wilde Grabraeuber(Zwerge), die Schaetze der Pyramide klauen
//            wollen, jedoch nicht ein mal ins Innere der Pyramide gelangen.
//=========================================================================

#include "../def.h"

inherit "std/mnpc";

void create()
{
 
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Grabraeuber");
  SetProp(P_LONG, BS(
    "Dieser kleine Zwerg gehoert zu einer Horde von Grabraeubern, welche "
    "der Pyramide alle Schaetze stehlen wollen. Scheinbar gelangen sie "
    "jedoch nicht in das Innere der Pyramide und im Forschen scheinen "
    "sie auch nicht sonderlich begabt zu sein. Trotzdem sollte man ihre "
    "Kampfkraft nicht unterschaetzen!"));
  SetProp(P_NAME, "Grabraeuber");
  SetProp(P_GENDER, MALE);
  AddId(({"grabraeuber", "raeuber", "zwerg"}));

  create_default_npc(22+random(2));
  SetProp(P_HANDS, ({" mit seinen gierigen Zwergenhaenden", 230 ,DT_BLUDGEON}));
  SetProp(P_RACE, "Zwerg");
  SetProp(P_SIZE, 85+random(10));
  SetProp(P_ALIGN, 30+random(30));
  
  AddInfo(DEFAULT_INFO, ({
    "forscht nach einem Eingang in das Innere der Pyramide.\n",
    "schaut Dich mit fragendem Blick an.\n",
    "sucht gierig nach Schaetzen.\n",
    "wundert sich ueber Deine bloeden Fragen.\n"}) );


  AddInfo( ({"grabraeuber"}),
    "Naja, vielleicht moegen wir alle so aussehen, jedoch sind wir doch "
    "in Wirklichkeit normale Forscher, die das Innere der Pyramide "
    "erforschen wollen! Wir wollen wirklich niemandem etwas stehlen!", 
    "beteuert: ");
  AddInfo("pyramide",
    "Wir wissen einfach nicht, wie man in das Innere der Pyramide gelangt!",
    "sagt: ");
  AddInfo("innere",
    "Irgendwo muss es einen Eingang geben!",
    "kreischt: ");
  AddInfo("eingang",
    "Den gilt es zu finden. Such doch einfach selber.",
    "sagt: ");
  AddInfo(({"schatz", "schaetze"}),
    "Oh ja, wir vermuten in der Pyramide gewaltige Schaetze - und wir sind "
    "schliesslich in der Branche taetig und wissen genau Bescheid.",
    "erklaert: ");
  AddInfo(({"forschen", "forscher"}),
    "Wir sind tatsaechlich Forscher, auch wenn es nicht so aussieht.",
    "beteuert: ");

  SetProp( P_REJECT, ({ REJECT_GIVE,
    "Der Grabraeuber sagt: Ich will Schaetze und nicht Deinen Schund!\n"}) );

  SetProp(P_AGGRESSIVE,0);
  SetProp(P_MAX_HANDS, 2);

  SetChats(1, ({
    "Der Grabraeuber sucht nach einem Eingang ins Innere der Pyramide.\n",
    "Der Grabraeuber giert nach gewaltigen Schaetzen.\n",
    "Der Grabraeuber untersucht die Wand.\n"}) );
  SetAttackChats(2, ({
    "Der Grabraeuber tritt Dir gegen das Schienbein!\n",
    "Der Grabraeuber blickt Dich mit gierigen Augen an.\n"}) );

  SetProp(P_MSGIN,   "schlurft herein");
  SetProp(P_MSGOUT,  "schluft weiter");
  SetProp(P_MMSGIN,  "schlurft herein");
  SetProp(P_MMSGOUT, "schlurft weit weg");

  SetProp (P_MNPC_AREA, ({EBENE1}) );
  SetProp (P_MNPC_WAIT, 10);
  SetProp (P_MNPC_DEFAULTROOM, EBENE1 "1");
  SetProp (P_MNPC_FLAGS, MOV_MOVES+MOV_INDOORS+MOV_INFIGHT+MOV_BACKWARDS);

}


varargs void die(int poisondeath)
{
  object enemy;

  if(objectp(enemy=QueryProp(P_KILLER)) && !IS_WIZARD(enemy))
  {
    ANXMASTER->Msg(Name(WER,1)+" wurde von "+CAP(getuid(enemy))+" umgebracht");
  }

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer==TO)
  {
    ANXMASTER->Msg(Name(WER,1)+" hat gerade "+UID(player)+" umgebracht, XP : "+lostexp);
  }
  return;
}

void angriff(object pl)
{
  string shouter;

  if(!ENV(TO))           return;
  if(!ENV(pl))           return;
  if(!interactive(pl))   return;
  if(ENV(TO) != ENV(pl)) return;

  shouter = pl->CannotSee(1) ? "Jemand ruft: "
                             : Name(WER,1)+" ruft: ";

  tell_room(ENV(TO),
     "\n"+break_string(pl->Name(WER)+" ist uns feindlich "
             "gesinnt, auf "+pl->QueryPronoun(WEN)+" mit Gebruell!!!", 78,
             shouter)+"\n");

  Kill(pl);

  return;
}

void init()
{
  ::init();

  if(!TP)                        return;
  if(!interactive(TP))           return;
  if(TP->QueryProp(P_GHOST))     return;
  if(!ANXMASTER->IsEnemy(TP))    return;

  call_out("angriff", 0, TP);
}

int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  ANXMASTER->AddEnemy(enemy);

  return ::Defend(dam, dam_type, spell, enemy);
}

int wandern()
{
   int retour;

   retour = ::wandern();
   command("nimm alles");
   command("trage alles");
   return retour;
}