inherit "std/mnpc";

#include "../def.h"

void create()
{

  if (!is_clone(TO)) return;

  ::create();

  SetProp(P_SHORT, "Eine Spinne");
  SetProp(P_LONG,
    "Diese Spinne ist etwas groesser als die normalen Exemplare, die Dir "
    "bereits haeufiger ueber den Weg gelaufen sind. Die Spinne ist "
    "pechschwarz und hat gluehend rote Augen. In der Mitte der Augen "
    "kannst Du noch so gerade einen gelben Punkt ausmachen. Die Spinne "
    "sieht ungefaehrlich aus, doch manchmal kann solch ein Eindruck "
    "auch gewaltig taeuschen!");
  );

  SetProp(P_NAME, "Spinne");
  SetProp(P_GENDER, FEMALE);
  AddId(({"spinne", "\nspinne"}));

  create_default_npc(2);

  SetProp(P_HANDS, ({" mit ihren kleinen Beinchen",QueryProp(P_HANDS)[1],DT_PIERCE}));
  SetProp(P_RACE, "Spinne");
  SetProp(P_SIZE, 2);
  SetProp(P_ALIGN, -random(50));

  SetProp(P_MAX_HANDS, 8);

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:      0.0, DT_COLD:      0.0, DT_WATER:       0.0
     , DT_AIR:       0.0, DT_LIGHTNING: 0.0, DT_EXPLOSION:   0.0
     , DT_SOUND:     0.0, DT_LIGHT:     0.0, DT_ELECTRIC:    0.0
     , DT_ACID:      0.0, DT_POISON:    0.0, DT_TERROR:      0.0
     , DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:       0.0
     , DT_MIND:      0.0, DT_SLASH:     0.0, DT_BLUDGEON:    0.0
     , DT_PIERCE:    0.0, DT_SQUEEZE:   0.0, DT_WHIP:        0.0
     , DT_RIP:       0.0
     ])
  );

  SetProp(P_MSGIN, "krabbelt herein");
  SetProp(P_MSGOUT, "krabbelt");
  SetProp(P_MMSGIN, "krabbelt herein");
  SetProp(P_MMSGOUT, "krabbelt davon");

  SetProp(P_MNPC_AREA, ROOM "weg-" );
  SetProp(P_MNPC_WAIT, ({ 15, 20, 20 }));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "weg-e7");
  SetProp(P_MNPC_FLAGS, MOV_OUTDOORS + MOV_INDOORS + MOV_MOVES + MOV_BACKWARDS);

  SetProp(P_DIE_MSG,  " verschindet in der Erde.\n");

  AddInfo(DEFAULT_INFO, "kann Dich nicht verstehen.\n");

  SetProp( P_REJECT, ({ REJECT_DROP,
    "Die Spinne kann @WEN nicht tragen.\n" }) );

}

int Defend(int dam, mixed dam_type, mixed spell, object enemy)
{
  DHRKIONMASTER->addfeind(enemy);
  return ::Defend(dam, dam_type, spell, enemy);
}

void die(int poisondeath)
{
  object enemy,room;

  enemy = QueryProp(P_KILLER);
  if(!(enemy && interactive(enemy))) return;

  tell_room(ENV(enemy),BS("Zwanzig Dunkelelfen kommen vorbei und verhaften "
                          +enemy->name()+". Sie bringen "+enemy->name()+
                          " in den Sueden von Dhrkion.\n"),({ enemy }));

  tell_object(enemy,"Die Spinne verschwindet in der Erde.\n"+
                    BS("Diese Spinne zu toeten war ein sehr grosser Fehler. "
                       "Zwanzig Dunkelelfen stuermen in den Raum und "
                       "verhaften Dich. Jeder Widerstand ist einfach "
                       "zwecklos."));

  enemy->move(ROOM "gef-d6", M_GO|M_SILENT|M_NO_SHOW|M_NOCHECK);
  room = ENV(enemy);

  if(room->QueryThisDoor() == D_STATUS_OPEN)
  {
    tell_room(room, BS("Ein paar Dunkelelfen werfen "+enemy->name(WEN)+
                       "herein und schliessen danach die Zellentuer."),
                    ({ enemy }) );
    room->SetThisDoor(D_STATUS_CLOSED);
    tell_room(ROOM "gef-d7", BS("Eine Horde Dunkelelfen stuermt herein und "
                                "wirft "+enemy->name()+" in eine der Zellen "
                                "und schliesst die Zellentuer. Befriedigt "
                                "ziehen die Horde wieder von dannen. "));
  }
  else
  {
    tell_room(room, BS("Ein paar Dunkelelfen stuermen herein, oeffnen eine "
                       "der Zellentuer und werfen "+enemy->name()+" hinein. "
                       "Mit einem *RUMMS* werfen sie die Zellentuer wieder "
                       "ins Schloss. "),({ enemy }) );

    tell_room(ROOM "gef-d7",
                    BS("Ein paar Dunkelelfen stuermen herein, oeffnen eine "
                       "der Zellentuer und werfen "+enemy->name()+" hinein. "
                       "Mit einem *RUMMS* werfen sie die Zellentuer wieder "
                       "ins Schloss. ") );
  }

  if(!present("\npaladintaskitem", enemy)) DHRKIONMASTER->addkiller(PL);

  ::die(poisondeath);
}

