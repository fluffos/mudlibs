//
// File:    fluch.c
// Created by Malar@SL (Juni 2004)
//
// Project: Anxpyramide
// Comments:  Diesen Fluch bekommt man ins Inventar gesteckt, sobald
//            man heilige Figuren der Frogloks zerstoert oder sonst etwas
//            Schlimmes mit irgendwelchen Heiligtuemern anstellt. Durch
//            diesen Fluch wird man dann bestraft und man kann sich nur 
//            durch ein besonderes Gegenmittel dieses Fluches entledigen.
//=========================================================================
inherit "std/thing";

#include "../def.h"


void create() {
  if (!is_clone(TO)) return;
  ::create();


  SetProp(P_SHORT,0 );
  SetProp(P_LONG, 0 );
  SetProp(P_NAME, 0);
  SetProp(P_GENDER, NEUTER);
  AddId( ({"\nanx_fluch", "NODESTRUCT"}) );

  SetProp(P_MATERIAL, MAT_MISC );
  SetProp(P_WEIGHT,   0);
  SetProp(P_VALUE,    0);
  SetProp(P_NOBUY,    1);
  SetProp(P_NOSELL,   1);
  SetProp(P_NODROP,   1);
  SetProp(P_NEVERDROP,1);
  
  set_next_reset(200);
  
  SUID;
  
}

void reset()
{
  if (!is_clone(this_object())) return;
  if (!interactive(ENV(TO))) 
  {
    remove();
    return;
  }  
  set_next_reset(400+random(500)); //Zum Testen!
  ::reset();
  switch(random(100))
  {
//  case 0 .. 8 :
//   	ENV(TO)->Message(BS(
//   	  "Dich ueberkommt ploetzlich eine wahnsinnige Lust, Dir Deine "
//   	  "gesamte Ausruestung vom Leib zu reissen!"));
//   	call_out("weg_mit_der_ausruestung", 2+random(2));
//   	break;
   case 0 .. 17 :
   	ENV(TO)->Message(BS(
   	  "Der Fluch der Anxpyramide lastet schwer auf Deinen Schultern!"));
   	ENV(TO)->do_damage(20+random(20));  //Absichtlich do_damage und kein AddHp
   	ANXMASTER->Msg(ENV(TO)->Name(WER)+" verliert Lebenspunkte(FLUCH!)");
   	break;
   case 18 .. 25 :
   	ENV(TO)->Message(BS(
   	  "Der Fluch der Anxpyramide zehrt an Deinen magischen Reserven."));
   	ENV(TO)->AddSp(-25);
   	ANXMASTER->Msg(ENV(TO)->Name(WER)+" verliert 25 Magiepunkte(FLUCH!)");
   	break;
   case 26 .. 37 :
   	ENV(TO)->Message(BS(
   	  "Du bemerkst die Last Deines Fluchs."));
   	ENV(TO)->command_me("rufe ICH .. BIN .. BESESSEN!!!");
   	ANXMASTER->Msg(ENV(TO)->Name(WER)+" wird zum Rufen gezwungen(FLUCH!)");
   	break;
   case 38 .. 58 :
   	ENV(TO)->Message(BS(
   	  "Du hast Deinen Koerper aufgrund des Fluchs, der auf Dir lastet, "
   	  "nicht mehr unter Deiner Kontrolle!"));
   	ENV(TO)->SetProp(P_PARALYZED, 4+random(4));
   	ANXMASTER->Msg(ENV(TO)->Name(WER)+ " wird paralysiert(FLUCH!)");
   	break;
//   case 46 .. 58 :
//   	ENV(TO)->Message(BS(
//   	  "Der Fluch der Anxpyramide verwandelt Dich in ein "
//   	  "haessliches Monster!"));
//   	ANXMASTER->Msg(ENV(TO)->Name(WER)+ " wird in einigen Sekunden zum Monster(FLUCH!");
//   	call_out("mach_monster", 4);
//   	break;
   case 59 .. 70 :
   	ENV(TO)->Message(BS(
   	  "Der Fluch der Anxpyramide veraendert irgendetwas in Deinem "
   	  "Kopf, so dass Du auf ein mal sehr verstoert und eingeschuechtert "
   	  "wirst."));
   	ENV(TO)->SetProp(P_WIMPY, ENV(TO)->QueryProp(P_MAX_HP));
   	ANXMASTER->Msg(ENV(TO)->Name(WER)+ "bekommt die hoechste Vorsicht gesetzt(FLUCH!)");
   	break;
   case 71 .. 80 :
   	ENV(TO)->Message(BS(
   	  "Ploetzlich hast Du Deine Sprachorgane nicht mehr unter Kontrolle "
   	  "und redest etwas seltsam..."));
   	ANXMASTER->Msg(ENV(TO)->Name(WER)+" redet nun rueckwaerts(FLUCH!)");
   	CLONE(OBJ "backspeech", ENV(TO));
   	break;
   case 81 .. 90 :
   	ENV(TO)->Message(BS(
   	  "Der Fluch der Anxpyramide macht Dich fuer einige Zeit "
   	  "kampfunfaehig."));
   	ENV(TO)->SetProp(P_DISABLE_ATTACK, 7+random(3));
   	ANXMASTER->Msg(ENV(TO)->Name(WER)+" wird eine Zeit lang kampfunfaehig(FLUCH!");
   	break;
   case 91 .. 95 :
   	ENV(TO)->Message(BS(
   	  "Der Fluch der Anxpyramide sorgt dafuer, dass Du nun einige Zeit "
   	  "nicht mehr zaubern kannst!"));
   	ENV(TO)->SetProp(P_DISABLE_SPELLS, 12+random(3));
   	ANXMASTER->Msg(ENV(TO)->Name(WER)+" kann nun einige Zeit nicht zaubern(FLUCH!");
   	break;
   case 96 .. 97 :
   	ENV(TO)->Message(BS("Der Fluch laesst Dich erblinden!"));
   	ENV(TO)->SetProp(P_BLIND, 40);
   	ANXMASTER->Msg(ENV(TO)->Name(WER)+" erblindet(FLUCH!");
   	break;
   case 98:
   	ENV(TO)->Message(BS("Der Fluch laesst Dich ertauben!"));
   	ENV(TO)->SetProp(P_DEAF, 40);
   	ANXMASTER->Msg(ENV(TO)->Name(WER)+" wird taub(FLUCH!)");
   	break;
   default:
   	ENV(TO)->Message(BS("Der Fluch macht Dich ganz klein und gruen."));
   	ENV(TO)->SetProp(P_FROG, 1);
   	ANXMASTER->Msg(ENV(TO)->Name(WER)+" wird zum Frosch(FLUCH!)");
   	break;
   
  }
      
   	
  
}

void weg_mit_der_ausruestung()
{
  ENV(TO)->command_me("zieh alles aus");
  ANXMASTER->Msg(ENV(TO)->Name(WER)+" zieht alles aus(FLUCH!)");
}

