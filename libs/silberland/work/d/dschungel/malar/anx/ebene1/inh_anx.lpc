//
// Project: Anxpyramide
// Comments:  Uebergeordneter inherit-room, der Dinge wie Standarddetails,
//            Smells und Sounds, P_LIGHT, P_INT_SHORT, P_INDOORS und
//            P_ENVIRONMENT vordefiniert.
//=========================================================================

#include "../def.h"

inherit "std/room";

void create()
{
  ::create();
  
  //Properties:
  SetProp(P_INT_SHORT, "Im Erdgeschoss der Anxpyramide");
  SetProp(P_INT_LONG, 
    "Der lange Gang im Erdgeschoss der Anxpyramide zieht sich quadratfoermig "
    "um das Innere der Pyramide herum. Der Gang ist ungefaehr zwei Meter "
    "breit. An den Waenden kannst Du viele Malereien der Erbauer dieses "
    "Bauwerks bestaunen. Der Gang ist sehr hoch, so dass Du kaum die Decke "
    "erkennen kannst. Irgendwo in diesem Gang muss es doch einfach in das "
    "interessante Innere gehen! ");
  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 14, ENV_TERRAIN: TT_HOUSE]) );
  
  //Details:
  AddDetail("decke",
    "Da die Gaenge eine gewaltige Hoehe besitzen, kannst Du die Decke kaum "
    "erkennen; sicher spielt auch die dunkle Farbe der Decke eine Rolle "
    "bei diesem Phaenomen.");
  AddDetail("hoehe",
    "Die Gaenge besitzen tatsaechlich eine gewaltige Hoehe! Die Erbauer haben "
    "wirklich ganze Arbeit geleistet.");
  AddDetail("erbauer",
    "Die Frogloks haben vor einigen Jahrhunderten die Anxpyramide errichtet.");
  AddDetail("frogloks",
    "Die wohnen in dem Dorf in der Naehe des Sumpfs!");
  AddDetail( ({"sumpf", "sumpfs"}),
    "Der Sumpf ist sehr gefaehrlich.");
  AddDetail("dorf",
    "Das Dorf der Frogloks liegt nicht weit vom Sumpf entfernt.");
  AddDetail("phaenomen",
    "Die Decke ist so hoch, dass Du sie kaum erkennen kannst.");
  AddDetail("farbe",
    "Die gesamte Anxpyramide ist aus dunklen Steinen erbaut worden.");
  AddDetail( ({"pyramide", "anxpyramide"}),
    "Die Anxpyramide wurde von den Frogloks gebaut. Du befindest Dich "
    "jedenfalls mittendrin.");
  AddDetail( ({"jahrhundert", "jahrhunderte"}),
    "Auf jeden Fall eine ganz schoen lange Zeit her!");
  AddDetail( ({"zeit", "fall"}),
    "Auf jeden Fall ist die Erbauung der Anxpyramide eine ganz schoen lange "
    "Zeit her!");
  AddDetail("erbauung",
    "Ist wohl einige Jahrhunderte her...");
  AddDetail("arbeit",
    "In diesem Bau steckt eine gewaltige Menge an Arbeit!");
  AddDetail("bau",
    "Bei diesem Bau handelt es sich um eine Pyramide, um die Anxpyramide.");
  AddDetail("menge",
    "Eine gewaltige Menge an Arbeit muessen die Frogloks in diesen Bau "
    "gesteckt haben!");
  AddDetail( ({"steine", "steinen"}),
    "Die Anxpyramide wurde aus sehr vielen dunklen Steinen gebaut.");
  AddDetail("rolle",
    "Dadurch, dass die Decke so hoch ist und die Steine so dunkel sind, kannst "
    "Du kaum etwas von der Decke erkennen.");
  AddDetail("gaenge",
    "Eigentlich ist es ja nur ein sehr langer Gang, der sich durch das gesamte "
    "Geschoss der Pyramide zieht.");
  AddDetail("geschoss",
    "Du befindest Dich im 'Erdgeschoss'.");
  AddDetail("erdgeschoss",
    "In dem befindest Du Dich gerade.");
  AddDetail("gang",
    "Dieser lange Gang zieht sich durch das gesamte Geschoss der Anxpyramide.");
  AddDetail("boden",
    "Auch der Boden besteht aus den Dir schon bekannten dunklen Steinen. "
    "Zwischen den einzelnen Steinen kannst Du ab und an ein paar Flecken "
    "an Sand und Erde erkennen.");
  AddDetail("sand",
    "Zwischen den Steinen ist ein wenig Sand.");
  AddDetail("erde",
    "Die steckt zwischen den Steinen am Boden.");
  AddDetail("naehe", 
    "Nicht weit vom Sumpf entfernt.");
  AddDetail("flecken",
    "Nur ab und zu kann man etwas Sand und Erde wahrnehmen.");
  AddDetail( ({"wand", "waende", "waenden"}),
    "Auch hier sind einige Malereien und Inschriften zu erkennen.");
  AddDetail("inschriften",
    "Die Inschriften sind in einer Dir fremden Sprache geschrieben, so dass "
    "Du kein einzelnes Wort verstehst!");
  AddDetail("wort",
    "Aus lauter Woertern bestehen die Inschriften.");
  AddDetail("woerter",
    "Die Inschriften bestehen aus lauter Woertern.");
  AddDetail("sprache",
    "Wahrscheinlich eine laengst veraltete Sprache der Frogloks.");
  AddDetail( ({"bilder", "malereien"}),
    "Es sind Bilder von Frogloks zu sehen; bei der Jagd, bei der Zuechtung "
    "von Spinnen, mit Froglokfrauen ... ");
  AddDetail("jagd",
    "Es gibt sehr viele Froglokjaeger!");
  AddDetail("zuechtung",
    "Die Frogloks betreiben eine rege Zuechtung von Spinnen.");
  AddDetail("spinne",
    "Du wirst sicherlich noch welche treffen. Sicherlich sehr giftig!");
  AddDetail("froglokjaeger",
    "Sicher hast Du welche im Sumpf getroffen!");
  AddDetail("froglokfrauen",
    "Wie bei den Zwergen erkennt man kaum einen Unterschied zwischen den "
    "einzelnen Geschlechter dieser Rasse.");
  AddDetail("geschlechter",
    "Entweder ist man weiblich oder maennlich; bei manchen weiss man das "
    "leider nie so genau...");
  AddDetail("unterschied",
    "Noch nicht aufgeklaert, was?");
  AddDetail("rasse",
    "Es handelt sich um die Rasse der Frogloks.");
  AddDetail( ({"zwerge", "zwergen"}),
    "Die wohnen doch im Gebirge und nicht im Dschungel!");
  AddDetail("gebirge",
    "Das Gebirge ist nicht mal auf diesem Kontinent, sondern sehr weit weg.");
  AddDetail("kontinent",
    "Der Dschungel liegt auf einem eigenen Kontinent.");
  AddDetail("dschungel",
    "In dieser Region befindest Du Dich.");
  AddDetail("region",
    "Du bist in der Region Dschungel.");
  
  //Smells:  
  AddSmell(DEFAULT_SMELL,
    "Die Luft hier riecht etwas abgestanden und keineswegs frisch. Daher "
    "riecht es hier ueberall ziemlich nach Moder.");
  AddSmell("moder",
    "Hier koennte tatsaechlich mal wieder gelueftet werden!");
  AddSmell("luft",
    "Die Luft riecht total abgestanden.");
  
  //Sounds:  
  AddSound(DEFAULT_SOUND,
    "Es ist absolut still; ab und zu kannst Du jedoch das Scharren Deiner "
    "Fuesse auf den Steinen vernehmen.");
  AddSound( ({"steine", "stein", "steinen"}),
    "Du scharrst mit Deinen Fuessen auf den dunklen Steinen herum.");
  AddSound("scharren", 
    "Na angenehm klingt das nicht gerade!");
  AddSound( ({"fuesse", "fuss", "fuessen"}),
    "Mit Deinen Fuessen scharrst Du auf den dunklen Steinen herum.");
  

}


