#include "../def.h"

inherit EBENE1 "inh_anx";

void create()
{
  ::create();
  
  //Exits
  AddExit("norden", EBENE1 "1" );
  AddExit("sueden", EBENE1 "19");
}

void init()
{
  ::init();
  
  //Player ueberhaupt da?
  if(!TP)                        return;
  //Player = Spieler?
  if(!interactive(TP))           return;
  //Loggen:
//  write_file(LOG "entrance", 
//    "("+ctime(time())+") "+TPN+" betritt die Pyramide.\n");
  //Anx-Report:
//  ANXMASTER->Msg(TPN+" betritt die Pyramide");
  call_out("Warnung", 4);
//  TP->Message(BS(
//    "Mit einer Gaensehaut hast Du soeben die Anxpyramide betreten, die vor "
//    "Jahrhunderten von den Frogloks erbaut worden ist. Da dies ein Kulturerbe "
//    "der Frogloks ist, verhalte Dich bitte dementsprechend, indem Du keine "
//    "Gaenge verunreinigst und auch sonst keine Frevel auf welche Art und "
//    "Weise auch immer begehst!"));
}

Warnung()
{
  //Player ueberhaupt da?
  if(!TP)                        return;
  //Player = Spieler?
  if(!interactive(TP))           return;
  TP->Message(BS(
    "Mit einer Gaensehaut hast Du soeben die Anxpyramide betreten, die vor "
    "Jahrhunderten von den Frogloks erbaut worden ist. Da dies ein Kulturerbe "
    "der Frogloks ist, verhalte Dich bitte dementsprechend, indem Du keine "
    "Gaenge verunreinigst und auch sonst keine Frevel auf welche Art und "
    "Weise auch immer begehst!"));
  call_out("Vorsicht", 4);
  ANXMASTER->Msg(TPN+" wird gewarnt");
  return;  
}

Vorsicht()
{
  //Player ueberhaupt da?
  if(!TP)                        return;
  //Player = Spieler?
  if(!interactive(TP))           return;
  TP->Message(BS(
    "Du fuehlst Dich durch die Warnung etwas verunsichert!"));
  TP->SetProp(P_WIMPY, TP->QueryProp(P_WIMPY)*3);
  ANXMASTER->Msg(TPN+" wird verunsichert");
  return;
}