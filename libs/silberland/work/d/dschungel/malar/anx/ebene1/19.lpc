#include "../def.h"

inherit EBENE1 "inh_anx";

int wand_weg;

void create()
{
  ::create();
  
  wand_weg = 0; //Die Wand ist noch ganz normal da
  
  //Spezielle Long, da geheimer Ausgang ins Innere!
  SetProp(P_INT_LONG, QueryProp(P_INT_LONG) + 
    "Irgendetwas faellt Dir in diesem Raum auf ...");
    
  AddDetail("irgendetwas",
    "Vielleicht kommt es Dir auch nur so vor, aber irgendwie scheint sich "
    "dieser Raum von den anderen zu unterscheiden. Vielleicht hat es "
    "etwas mit der helleren Decke zu tun?");
  AddDetail("raum",
    "Dieser hier kommt dieser anders vor als die uebrigen.");
  AddDetail("decke",
    "Auch hier ist die Decke natuerlich recht hoch, aber da sie an dieser "
    "Stelle heller ist, kann man mehr Einzelheiten erkennen.");
  AddDetail("stelle",
    "In diesem Raum.");
  AddDetail("einzelheiten",
    "Da ist zB dieser kleine Pfeil an der Decke zu sehen.");
  AddDetail("pfeil",
    "Der Pfeil ist recht klein und Du kannst froh sein, ihn ueberhaupt "
    "noch erkennen zu koennen. Er zeigt in eine ganz bestimmte Richtung.");
  AddDetail("richtung",
    "Richtung Ostwand!");
  AddDetail("ostwand",
    "Die Ostwand unterscheidet sich eigentlich gar nicht sonderlich von den "
    "anderen Waenden hier. Nur eine Malerei faellt besonders auf.");
  AddDetail("malerei",
    "Die Malerei ist daher so besonders, weil sie nicht einfach an die Wand "
    "gemalt worden ist, sondern auch Modellierarbeit vonnoeten war: Ein "
    "Froglokjaeger ist zu sehen. ");
  AddDetail("modellierarbeit",
    "Einige Teile schauen aus der Malerei heraus.");
  AddDetail("teile",
    "Einzelne Teile wie der Speer des Froglokjaegers wurden modelliert und "
    "an der Wand befestigt. Sieht einfach klasse aus!");
  AddDetail("froglokjaeger",
    "Er sieht ziemlich wild aus und hat einen roten Speer in der Hand.");
  AddDetail("hand",
    "Kaum zu erkennen.");
  AddDetail("speer",
    "Der Speer wurde modelliert und an der Ostwand befestigt. Jedoch scheint "
    "er noch einen anderen Zweck zu erfuellen..");
  AddDetail("zweck",
    "Der Speer gleicht einem Hebel!");
  AddDetail("hebel",
    "Na drehen tut man Hebel sicher nicht!");
    
  AddCmd("zieh|ziehe&hebel", "cmd_wand",
         "Wen oder was willst Du denn ziehen? :-)");
  
  //Exits
  AddExit("norden", EBENE1 "20" );
  AddExit("sueden", EBENE1 "18");
  //Ausserdem Eingang in das innere Feld!
}

int cmd_wand(string str)
{
  if(!wand_weg)
  {
    TP->Message(BS(
      "Du ziehst den Speer des Froglokjaegers erst zaghaft und dann mit "
      "einem gewaltigen Ruck nach unten!"), MSGFLAG_VISUAL);
    ENV(TP)->Message(BS(
      TPN + " zieht ploetzlich an einem Gegenstand an der Wand und die Wand."),
        MSGFLAG_VISUAL|MSGFLAG_NO_TP);
    call_out("wand_weg_2", 3);
    return 1;
   }
   write(BS(
     "Du ziehst an dem Hebel, es passiert jedoch nichts weiter."));
   return -1;
}

void wand_weg_2()
{
  TO->Message(BS(
    "Ploetzlich rattert die Ostwand auf einer unsichtbaren Schiene nach "
    "Norden, so dass der Ausgang nach Norden nun versperrt ist und der "
    "Ausgang nach nach Osten jedoch frei ist - das Innere der Pyramide "
    "ist nun endlich betretbar!"), MSGFLAG_VISUAL);	
  wand_weg = 1; //Jetzt ist die Wand 'weg' 
  ANXMASTER->Msg(TPN+" oeffnet den Eingang ins Innere");
  AddExit("osten",([
              EX_TESTFUNC: "testfunc1",
              EX_PLMSG   : "Du betrittst das Innere der Pyramide.\n",
              EX_FUNC    : "testfunc2" ]) );//Ausgang nach Osten wird frei
  RemoveExit("norden");           //Ausgang nach Norden wird entfernt
  EBENE1 "i12"->AddExit("westen", EBENE1 "19");
}
//Fuer andere Raeume so zum Aufrufen:
void wand_weg_ein()
{
  wand_weg = 1;
}

void wand_weg_aus()
{
  wand_weg = 0;
}

void reset()
{
  ::reset();
  if(wand_weg) //Falls am Hebel gezogen wurde - rueckgaengig machen!
  {
    ANXMASTER->Msg("Eingang ins Innere wird durch Reset versperrt");
    RemoveExit("osten"); //Ausgang nach Osten ist wieder weg
    AddExit("norden", EBENE1 "20");  //Ausgang nach Norden wieder da
    EBENE1 "i12"->RemoveExit("westen"); //Drinnen natuerlich auch kein Ausgang
    EBENE1 "i12"->Message(BS(
      "Eine Wand blockiert ploetzlich den Ausgang im Westen. Du sitzt fest!"));
    wand_weg = 0; 
    TO->Message(BS(
      "Auf geheimnisvolle schiebt sich die Nordwand wieder in ihre alte "
      "Position zurueck, so dass der Ausgang nach Osten nun wieder versperrt "
      "und der Ausgang nach Norden wieder frei ist."));
    
  }
}

int testfunc1() 
{
 if (TP->QueryProp(P_LEVEL) < 30) 
   {
    write("Du traust Dich noch nicht weiter.\n");
    return 0;
   }
 else return 1;
}

int testfunc2() 
{
  if (interactive(TP))
  {
  ANXMASTER->Msg(TPN+" betritt das Innere der Pyramide");
  TP->move(EBENE1 "i12", M_GO, "ins Innere der Pyramide", "schreitet",
                                 "schreitet herein");
  return 1;
  }
  return 0;
}