inherit "std/room";

#include "../def.h"

#define ANSCHLUSS_SUMPF "/d/dschungel/feyaria/sumpf/room/sumpf16"

void create()
{
  ::create();

  SetProp(P_INT_SHORT, "Ein sumpfiger Weg" );
  SetProp(P_INT_LONG,
    "Du bist nun mehr oder weniger dem schrecklichen Sumpf "
    "entkommen und stehst nun mitten auf einem kleinen "
    "sumpfigen Weg, der etwas vom Sumpf wegfuehrt. Viele "
    "kleine Buesche und Straeucher stehen herum und einige "
    "Wasserloecher sind noch immer erkennbar. Etwas weiter "
    "im Suedosten ragt eine hohe Pyramide aus der Erde!");   
  SetProp(P_LIGHT,1);
  SetProp(P_INDOORS,0);
  SetProp(P_ENVIRONMENT,([ ENV_TEMPERATURE:29, ENV_TERRAIN:TT_SWAMP ]));
  
  AddDetail( ({"sumpf", "sumpfes"}),
    "Der richtige Sumpf liegt zwar zum groessten Teil im Westen, jedoch "
    "ziehen sich einige Auslaeufer nach Osten durch diesen Weg.");
  AddDetail("auslaeufer",
    "Die Auslaeufer des Sumpfes ziehen sich nach Osten durch diesen Weg, "
    "sodass auch hier noch der Boden total durchfeuchtet ist.");
  AddDetail("westen",
    "Im Westen liegt der gefaehrliche Sumpf!");
  AddDetail("osten",
    "Nach Osten zieht sich dieser sumpfige Weg, welcher jedoch wieder rasch "
    "in den Auslaeufern des Sumpfs verschwindet.");
//  AddDetail("dorf",
//    "Es liegt etwas weiter im Osten. Was wohl die Leute hier dazu bewegt "
//    "haben mag, dieses Dorf so nah an den gefaehrlichen Sumpf zu bauen?");
//  AddDetail("leute",
//    "Na die Dorfbewohner.");
//  AddDetail( ({"dorfbewohner", "bewohner"}),
//    "Die muessen verrueckt sein, hier einfach so nah an den gefaehrlichen "
//    "Sumpf ein Dorf zu bauen!");
  AddDetail( ({"buesche", "straeucher", "strauch"}),
    "Auch wenn hier schon ein kleiner Weg entstanden ist, stehen noch immer "
    "eine Menge kleiner Buesche und Straeucher herum, die alle eine leicht "
    "braeunliche Faerbung haben. Neben diesen Pflanzen gibt es natuerlich "
    "auch noch Sumpfgras und ab und an sogar noch Schilf.");
  AddDetail("boden",
    "Der ist hier um einiges befestigter als im Westen, jedoch ist er noch "
    "immer so durchfeuchtet, dass viele Pflanzen hier gedeihen koennen.");
  AddDetail( ({"pflanzen", "pflanze"}),
    "Pflanzen wie Sumpfgras, Buesche, Straeucher und ab und an auch "
    "noch Schilf.");
  AddDetail( ({"gras", "sumpfgras"}),
    "Es hat genau wie die Buesche und Straeucher eine leicht braeunliche "
    "Faerbung und sieht so nicht sehr lebendig aus..");
  AddDetail("faerbung",
    "Leicht braeunlich, sieht nicht sonderlich lebendig aus.");
  AddDetail( ({"strasse", "hauptstrasse"}),
    "Der Weg wird weiter im Osten zu einer richtigen Hauptstrasse!");
  AddDetail("himmel",
    "Am Himmel strahlt die Sonne heiss und erbarmungslos hinunter, so dass "
    "Dir ganz heiss wird.");
  AddDetail("sonne",
    "Die Sonne fuehrt zu einer staendigen Verdunstung der saemtlichen "
    "Wassermassen, so dass es hier nicht nur sehr heiss, sondern richtig "
    "feucht und schwuel ist.");
  AddDetail("menge",
    "Ziemlich viele Pflanzen sind trotz des befestigten Weges vorhanden.");
  AddDetail( ({"weg", "weges", "sumpfweg", "sumpfweges"}),
    QueryProp(P_INT_LONG));
  AddDetail("schilf",
    "Ab und an sind hier sogar noch Schilfpflanzen zu erkennen.");
  AddDetail("schilfpflanzen",
    "Nur in den tieferen Gewaessern kann man ein paar Schilfpflanzen "
    "sehen.");
  AddDetail("teil",
    "Der groesste Teil des Sumpfs liegt im Westen. Jedoch kann man hier "
    "und noch ein wenig im Osten die Auslaeufer erkennen.");
  AddDetail("suedosten",
    "Im Suedosten steht eine Pyramide! Komisch, dass sie Dir noch nicht "
    "frueher aufgefallen ist.");
  AddDetail("pyramide",
    "Es nicht einfach eine sandfarbene Wuestenpyramide, sondern scheint "
    "vielmehr ein Ueberbleibsel einer alten Kultur darzustellen! Sie wurde "
    "aus braunen und schwarzen Steinen vor einer sehr lanzen Zeit erbaut!");
  AddDetail("wuestenpyramide",
    "Keine sandfarbene Wuestenpyramide siehst Du hier, sondern vielmehr "
    "eine alte Kulturstaette.");
  AddDetail( ({"kulturstaette", "ueberbleibsel", "staette"}),
    "Wessen Kultur diese Staette wohl entsprungen sein mag?");
  AddDetail("kultur",
    "Wo soll es denn in dieser Einoede eine Kultur geben? Hier gibt es "
    "doch bloss die Frogloks!");
  AddDetail("einoede",
    "Also wenn das hier keine Einoede ist, dann weiss ich auch nicht..");
  AddDetail("frogloks",
    "Sie haben wohl vor einer sehr langen Zeit diese Pyramide erbaut. "
    "Komisch, dass gar kein Eingang zu erkennen ist.");
  AddDetail("zeit",
    "Sehr lange her.");
  AddDetail("eingang",
    "Hm - irgendwie muss man doch in diese Pyramide kommen! Vielleicht "
    "laesst sich ja ein Durchgang durch das Erdreich schaffen?");
  AddDetail( ({"gang", "durchgang"}),
    "Du koenntest einen Durchgang durch das Erdreich schaffen, so dass "
    "Du unterirdisch in die Pyramide gelangst! Dazu muss man nur eine "
    "Schaufel besitzen, etwas Muskeln haben und einfach im Boden graben "
    "koennen!");
  AddDetail("schaufel",
    "Falls Du keine hast, kauf Dir doch in irgendeinem Laden eine.");
  AddDetail("laden",
    "Der naechste Laden ist in Tijara.");
  AddDetail("tijara",
    "Etwas weiter im Westen.");
  AddDetail("westen",
    "Erst liegt im Westen der Sumpf dann folgt Tijara.");
  AddDetail( ({"erde", "erdreich"}),
    "In der Erde koenntest Du mit einer Schaufel graben und somit einen "
    "unterirdischen Gang zur Pyramide schaffen...");
  AddDetail( ({"steine", "steinen"}),
    "Die Pyramide wurde aus dunklen Steinen von den Frogloks erbaut.");
  AddDetail("verdunstung",
    "Das Wasser wird gasfoermig und schwebt unsichtbar herum!");
  AddDetail("wassermassen",
    "Im Sumpf finden sich gewaltige Wassermassen.");
  AddDetail("wasser",
    "Der gesamte Sumpf ist foermlich getraenkt mit Wasser!");
  AddDetail("wasserloecher",
    "Viele viele mehr wirst Du im richtigen Sumpf im Westen finden.");
  AddDetail( ({"gewaesser", "gewaessern"}),
    "Der gesamte Sumpf ist getraenkt mit Gewaessern."); 
  AddDetail("muskeln",
    "Du spannst Deine Muskeln an."); 
 
  AddCmd("grab|grabe&in|im&sumpf|erde|boden", "cmd_tunnel",
         "Willst Du _in_ etwas graben?",
         "In der Erde bzw im Boden koennte man graben..");
 
         

 AddExit("westen", ANSCHLUSS_SUMPF);
 //AddExit("osten", ROOM "ha2"); --> Kein Dorf mehr 

}
  
int cmd_tunnel(string str)
{
  //Keine Schaufel, kein Tunnel
  if(!present("schaufel", TP))
  {
    write("Besorg Dir doch erstmal eine Schaufel!\n");
    return -1;
  }
  //Schaufel im Inventar des Spieler
  
  //Benutzt der Spieler zZ mehr als eine Hand?
  if(TP->QueryProp(P_USED_HANDS) > 1)
  {
    write("Du musst eine Hand fuers Graben frei haben!\n");
    return -1;
  }
  
  //Spieler hat Schaufel & eine Hand frei; dann mal los!
  write(BS(
    "Du schaffst es tatsaechlich einen kleinen Tunnel durch den Sumpfboden "
    "zu graben! Du kriechst sehr schnell hindurch, denn die feuchte "
    "Sumpferde beginnt schon, den kleinen Tunnel unter sich zu begraben! "
    "Nach dieser anstrengenden Tortur findest Du Dich zum Glueck in der "
    "Pyramide wieder."));
  
  TP->move(EBENE1 "20", 
           M_GO, "sich in die Erde", 
           "graebt",
           "graebt sich herein");
  ANXMASTER->Msg(TPN+" betritt die Pyramide");
  return 1;
}
  
  
  
  