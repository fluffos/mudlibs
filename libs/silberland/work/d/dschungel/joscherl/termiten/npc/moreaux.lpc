
inherit "std/mnpc";
#include "../def.h"

void create()
{
  if (!is_clone(TO)) return;
  ::create();   

  SetProp(P_SHORT, "Dr. Moreaux");
  SetProp(P_LONG, BS(
    "Vor Dir steht ein hagerer und ausgesprochen ungepflegter "
    "Mensch. Er traegt abgewetzte Safarikleidung und hantiert andauernd "
    "mit seltsamen Instrumenten, mit denen er offenbar die Vegetation "
    "untersucht. An seinem Bart kann man seine Speisekarte der letzen "
    "Woche ablesen und an seinen Stiefeln klebt der ehemalige Inhalt "
    "verschiedenster Tiergedaerme.\nEr scheint Deiner Gegenwart keine "
    "Aufmerksamkeit zu schenken, seine blutunterlaufenen und entzuendeten "
    "Augen sind wie gebannt auf die karge Umgebung gerichtet.\n"));
  SetProp(P_NAME, "Dr. Moreaux");
  SetProp(P_GENDER, MALE);
  SetProp(P_SIZE, 182);
  AddId(({"moreaux", "dr.","doktor"}));

  create_default_npc( 20 );
  SetProp(P_BODY, 100);
  SetProp(P_HANDS, ({" mit einem Sezierbesteck", 100}));
  SetProp(P_ALIGN, -400); 
  SetProp(P_RACE, "Mensch");
  
/****************************
***           Spells
****************************/


  SetProp(P_SPELLRATE,40);

  AddSpell(1,200, 
      "Dr. Moreaux entnimmt Dir eine Gewebeprobe!\n",
      "Dr. Moreaux entnimmt @WEM eine Gewebeprobe.\n",
      DT_RIP, ([SP_SHOW_DAMAGE:1]));

/****************************
***           Sprache und Soul
****************************/

  SetChats(5, ({
        "Dr. Moreaux kratzt sich am Kopf.\n",
        "Der Herr Dr. stammelt etwas Unverstaendliches.\n",
        "Dr. Moreaux fluestert: \"Es muss hier irgendwo sein...\"\n",
        "Dr. Moreaux murmelt etwas von \"...so nah am Ziel...\"\n",
        "Du denkst Dir deinen Teil zu dem stinkenden Herrn Dr.\n",
        "Moreaux starrt Dich auf einmal durchdringend an und stoehnt auf.\n",
        "Moreaux packt Dich bei den Schultern und bruellt: \"DAS GEGENMITTEL!\"\n",
        "\"Wir sind alle dem Tod geweiht!!!\"\n",
        "Du bist ueberzeugt, dass dieser Mensch vor Dir durchgeknallt ist.\n",
        "Moreaux kramt verwirrt in seinen Taschen.\n",
        "Dr. Moreaux untersucht einen Dschungelriesen.\n",
        "Du beobachtest den Herrn Dr., wie er verstohlen etwas in seine Tasche steckt.\n",
        "Moreaux prueft eine der Schnittstellen an der Vegetation.\n",
        "Du denkst Dir . o O (Is was, Doc?)\n",
        "Moreaux murmelt etwas von \"Jahr 2000-Termite\". Du hast Dich "
        "wohl verhoert.\n",
        }) );

  AddInfo( DEFAULT_INFO,
      "Das ist doch voellig unwichtig!\n",
      "schuettelt nur unwillig den Kopf: ");
  AddInfo( ({"m'baan","baan", "mbaan"}),
      "Was weisst Du darueber?\n",
      "sieht Dich alarmiert an: ");
  AddInfo("joscherl", 
      "Ja, nur der versteht mich.\n","strahlt: ");
  AddInfo("mittel", 
      "Das arithmetische? Das geometrische?\n","fragt: ");
  AddInfo("gegenmittel", 
      "Es muss ein Gegenmittel geben. Es gab welche, die wieder "
      "rueckverwandelt wurden, ja es gibt Berichte ... Berichte ...\n",
      "wispert: ");
  AddInfo(({"berichte", "berichten"}), 
      "Berichte von Ueberlebenden. Von Ueberlebenden, hoeren Sie? "
      "Von UEBERLEBENDEN!\n","fluestert: ");
  AddInfo(({"ueberlebende", "ueberlebenden"}),
      "Manchmal findet man Ueberreste, manchmal verschwinden sie "
      "einfach. Aber niemand kam zurueck. Bis auf die Ueberlebenden.\n",
      "sagt: ");
  AddInfo(({"arbeit","taetigkeit"}), 
      "Ich bin ein Suchender. Ich muss es vollenden. Mein Lebenswerk.\n",
      "sagt: ");
  AddInfo("suchender", 
      "Sind wir das nicht alle?\n","fragt: ");
  AddInfo("lebenswerk", 
      "Die Arten. Die Entstehung der Arten. Und es gibt seltsame Arten.\n",
      "nickt: ");
  AddInfo("arten", 
      "Menschen. Zwerge. Elfen. Sie wissen schon. Und ...Termiten.\n","meint: ");
  AddInfo("termiten", 
      "Termiten. Welch herrliche, schoene Geschoepfe. Ueberlegen. "
      "Einig. Welch formvollendete Schoepfung der Natur. \n","ereifert sich: ");
  AddInfo("natur", 
      "WIr sind alle Teil der Natur. Wie lange noch?\n","meint: ");
  AddInfo("schoepfung", 
      "Schoepfung und Zerstoerung. Geburt und Tod. Sie wissen was ich "
      "meine?\n","stammelt: ");
  AddInfo("geschoepfe", 
      "Herrliche Geschoepfe. Aber ich bin schon zu alt, um hinter ihr "
      "Geheimnis zu kommen.\n"," ");
  AddInfo("geheimnis", 
      "Sie haben sich veraendert. Und sie werden immer mehr. Etwas steht "
      "hinter ihnen. Etwas leitet sie.\n","fluestert: ");
  AddInfo("hilfe", 
      "Vielleicht koennen wir uns gegenseitig helfen. Sie werden hier nicht "
      "lange ueberleben ohne mein Wissen. Und ich bin zu schwach.\n","sagt: ");
  AddInfo("wissen", 
      "Ich weiss viel ueber sie. Nur nicht ihr Geheimnis. Aber Sie werden "
      "es fuer mich finden. Ich vertraue auf Sie. Wenn Sie mir auch vertrauen, "
      "lassen Sie es mich wissen.\n","sagt: ");

  SetProp (P_DIE_MSG, 
    " stirbt vor Vollendung seines Lebenswerkes.\n");
  SetProp (P_MURDER_MSG, 
    "%s, Du elende Kreatur!");

/****************************
 ***           Movement
 ****************************/

  SetProp (P_MNPC_AREA, ROOM);
  SetProp (P_MNPC_WAIT, ({ 10, 30, 10 }));
  SetProp (P_MNPC_DEFAULTROOM, ROOM "saeule2");
  SetProp (P_MNPC_FLAGS, MOV_OUTDOORS+MOV_INDOORS+MOV_MOVES);
  SetProp (P_MSGIN, "stolpert herein");
  SetProp (P_MSGOUT,"fuehlt sich von Dir gestoert und verschwindet#");
}













