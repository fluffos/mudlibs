inherit "std/mnpc";
#include "../def.h"


void create()
{
  if (!is_clone(TO)) return;
  ::create();   

  SetProp(P_SHORT, "Eine gefluegelte Termite");
  SetProp(P_LONG, BS("Tralala"));
  SetProp(P_NAME, "gefluegelte Termite");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_SIZE, 200);
  AddId(({"gefluegelte termite", "fluegeltermite", "termite"}));

  create_default_npc( 20 );
  SetProp(P_HANDS, ({" gnadenlos", QueryProp(P_HANDS)[1], DT_PIERCE}));
  SetProp(P_ALIGN, -200); 
  SetProp(P_RACE, "Termite");
  
/****************************
***           Spells
****************************/


  SetProp(P_SPELLRATE,25);

  AddSpell(1,200, 
      "Ein beissender Geruch huellt Dich ein...Saeure!!\n",
      "Die Termite sprueht aus einer Druese aetzende "
      "Fluessigkeit auf @WEN.\n",
      DT_ACID, ([SP_SHOW_DAMAGE:1]));
  AddSpell(1,300, 
      "Die Termite umklammert Dich mit ihren Gliedmassen.\n",
      "Die Termite nimmt @WEN in eine toedliche Umarmung.\n",
      DT_SQUEEZE, ([SP_SHOW_DAMAGE:1]));
  AddSpell(1,300, 
      "Das Vieh bohrt Dir ihre mit Klauen bewehrten "
      "Extremitaeten in Deine Weichteile.\n",
      "Die gefluegelte Termite bohrt ihre klauenbewehrten "
      "Extremitaeten in @WEN.\n",
      DT_PIERCE, ([SP_SHOW_DAMAGE:1]));

/****************************
***           Sprache und Soul
****************************/

  SetChats(2, ({
        "Das gefluegelte Monstrum sieht Dich herrisch an.\n",
        "Die Fluegel der Termite verursachen spuerbare Vibrationen.\n",
        "Die gefluegelte Termite schaerft ihre Scheren und Klauen.\n",
        "Die Zangen der Termite bewegen sich auf und zu.\n",
        "Du fuehlst dich in Gegenwart der gefluegelten Termite sehr unwohl.\n",
        "Die Termite stiegt ploetzlich auf und landet hinter Dir..\n",
        "Die Funktionalitaet des Termitenkoerpers beeindruckt Dich.\n",
        "Du spuerst wenig Intelligenz, aber eine zerstoererische Konsequenz "
        "in dem Insekt.\n",
        "Die Insektenfluegel wirbeln Staub auf und verschleiern Dein "
        "Gesichtsfeld.\n",
        }) );

  AddInfo( DEFAULT_INFO,
      "Wir nicht kennen - werden wir vernichten!",
      "zischt: ");
  AddInfo( ({"m'baan","baan", "mbaan"}),
      "Maeeechtig --- seeehr maeeechtig!\n",
      "erschauert: ");
  AddInfo("joscherl", "Joscherl hat kleines m, M'baan "
      "grosses M. M'Baan maechtiger als Joscherl!\n","faucht: ");

  SetProp (P_DIE_MSG, 
      " kollabiert und schlaegt ein letztes Mal mit ihren Fluegeln.\n");

  SetProp (P_MURDER_MSG, 
      "Ueber den Wolken... "+TPN);


  /****************************
   ***           Movement
   ****************************/

  SetProp (P_MNPC_AREA, ROOM );
  SetProp (P_MNPC_WAIT, ({ 10, 15, 10 }));
  SetProp (P_MNPC_DEFAULTROOM, ROOM "saeule2");
  SetProp (P_MNPC_FLAGS, MOV_OUTDOORS+MOV_MOVES);
  SetProp (P_MSGIN,  "schwebt herein");
  SetProp (P_MSGOUT, "schwebt beinahe lautlos" );
}

void init()
{
  ::init();
  if (TP && TP->id("termite")) AddDefender(TP);
}

void InformDefend(object enemy){
  if (!InFight()) 
    tell_room(environment(TO), "\nDie Termiten verstaendigen "
      "mit ihren Extremitaeten und Du hast einen Gegner mehr. Wenn "
      "das so weiter geht, kaempft hier bald der ganze "
      "Insektenstaat...\n");
  Kill(enemy);
}

int Defend(int dam, string dtype, int spell, object enemy) {
  if (present("\ntermitis", enemy))
    {
     write("\nDie gegnerische Termite prallt zurueck und "
        "beendet den Kampf abrupt, als haette sie auf einmal etwas "
        "Entscheidendes bemerkt.\nAuch Dich haelt ploetzlich tief in "
        "Deinem Inneren etwas ab, Deinen Gegner weiter zu bekaempfen.\n"
        "Du vermeinst, die Termite etwas wie \"HALT, "
        +(enemy->QueryProp(P_GENDER)==MALE?"BRUDER!":"SCHWESTER!")+
        " zischen zu hoeren.\n");
     say("\nDie Termite und "+capitalize(enemy->name())+
        " beenden eigenartigerweise sofort den Kampf. Du hast den "
        "Eindruck, als wuerden sie sich auf eine seltsame Weise "
        " verstaendigen.\n", enemy);
     enemy->StopHuntFor(ME);
     StopHuntFor(enemy);
    }
  else return::Defend(dam, dtype, spell, enemy);
}
