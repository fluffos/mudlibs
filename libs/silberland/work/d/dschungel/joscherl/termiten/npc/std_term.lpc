////////////////////////////////////////////////////////
//  Standard Baumschneider-Termite //
///////////////////////////////////////////////////////

inherit "std/mnpc";
#include "../def.h"

#define TERMATTR ({"abstossende", "ekelhafte","unheimliche","bedrohliche","gefaehrliche"})

int attr;

void create()
{
  if (!is_clone(TO)) return;
  ::create();   
  
  attr=random(sizeof(TERMATTR));
  SetProp(P_SHORT, "Eine " + TERMATTR[attr] + " Baumschneidertermite");
  SetProp(P_LONG, BS(
    "Vor Dir steht ein abschreckendes Produkt der Evolution. Diese "
    "Baumschneidertermite ist mannshoch, ihr massiger Leib wird von sechs "
    "nervoes zuckenden Gliedmassen gestuetzt. Ihre gewaltigen Schneidezangen "
    "dienen dazu, selbst die dicken Staemme der Dschungelriesen bearbeiten "
    "zu koennen."));
  SetProp(P_NAME, TERMATTR[attr] + " Baumschneidertermite");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_SIZE, (120+8*attr));
  AddId("termite");
  AddId("baumschneidertermite");

  create_default_npc( 10 );
  SetProp(P_BODY, 100);
  SetProp(P_HANDS, ({" mit ihren messerscharfen Zangen", 50+10*attr, DT_PIERCE}));
  SetProp(P_ALIGN, -100-200*attr); 
  SetProp(P_RACE, "Termite");
  
//////////////////////////////////////
//           Spells             //
/////////////////////////////////////


  SetProp(P_SPELLRATE,15);
  AddSpell(1,200, 
      "Ein beissender Geruch huellt Dich ein...Saeure!!\n",
      "Die Termite sprueht aus einer Druese aetzende "
      "Fluessigkeit auf @WEN.\n",
      DT_ACID, ([SP_SHOW_DAMAGE:1]));

//////////////////////////////////////
//      Sprache/Soul        //
/////////////////////////////////////

  SetChats(1, ({
        "Die Termite spuert Deine Gegenwart.\n",
        "Die Termite prueft einen Baum.\n",
        "Die Extremitaeten der Termite betasten den Lehmboden.\n",
        "Die Zangen der Termite bewegen sich auf und zu.\n",
        "Du denkst Dir o O ( ein abstossendes Lebewesen!)\n",
        "Die Termite gibt ein schabendes Geraeusch von sich.\n",
        "Du spuerst die Beruehrungen der Termitenfuehler.\n",
        "Die Termite zischt: M'baan maechtig!\n"})
      );

  AddInfo( DEFAULT_INFO,
      "Wir nicht kennen - werden wir vernichten!",
      "zischt: ");
  AddInfo( ({"m'baan","baan", "mbaan"}),
      "Maeeechtig --- seeehr maeeechtig!\n",
      "erschauert: ");
  AddInfo("joscherl", "Joscherl hat kleines m, M'baan "
      "grosses M. M'Baan maechtiger als Joscherl!\n","faucht: ");


//////////////////////////////////////
//         Movement         //
/////////////////////////////////////

  SetProp (P_MNPC_AREA, ROOM);
  SetProp (P_MNPC_WAIT, ({ 10, 15, 10 }));
  SetProp (P_MNPC_DEFAULTROOM, ROOM "saeule2");
  SetProp (P_MNPC_FLAGS, MOV_OUTDOORS+MOV_INDOORS+MOV_MOVES);
  SetProp (P_MSGIN, "kriecht herein");
  SetProp (P_MSGOUT, "kriecht");
}

void init()
{
  ::init();
  if (TP && TP->id("termite")) AddDefender(TP);
}

void InformDefend(object enemy){
  if (!InFight()) 
    tell_room(environment(TO), BS("\nDie Termiten verstaendigen "
      "mit ihren Extremitaeten - Du hast einen Gegner mehr. Wenn "
      "das so weiter geht, kaempft hier bald der ganze Insektenstaat...\n"));
  Kill(enemy);
}

