/***********************************
*  Thanatodendron, die Todespflanze
*  Joscherl@Silberland
************************************/

inherit "std/mnpc";
#include "../def.h"
#define CHECK(x) 


varargs int raeume_abtasten(mixed exits, string chosen_exit, string exit_filename, 
  object next_room, mixed next_room_exits);

void create()
{
  if (!is_clone(TO)) return;
  ::create();     

  if (find_living("feyaria")) CHECK("\nDas Thana wird geclont !\n\n");
  SetProp(P_SHORT, "Das Thanatodendron");
  SetProp(P_LONG, 
    "Dein Entsetzen kennt keine Grenzen, als Du erkennst, dass dieses enorme "
    "Gebilde aus Wurzeln, zahllosen astfoermigen Fortsaetzen und baumdicken, "
    "verschlungenen Staemmen weitaus lebendiger als eine gewoehnliche "
    "Pflanze oder Baum ist. Der ganze Raum scheint erfuellt von der nur durch "
    "leises Knacken und Knirschen begleiteten Aktivitaet dieses riesigen "
    "Wesens, das trotz seiner Verbindung mit dem Boden zweifelsohne die "
    "Faehigkeit besitzt, sich mit erstaunlicher Geschwindigkeit "
    "fortzubewegen.\nDu erkennst sofort, dass Du in allerhoechster "
    "Lebensgefahr bist, und fragst Dich panisch, wie weit die wie Fangarme "
    "geformten Wurzeln wohl reichen koennen");
  SetProp(P_NAME, "Thanatodendron");
  SetProp(P_RACE, "Pflanze");
  SetProp(P_GENDER, NEUTER);
  SetProp(P_SIZE, (1000));
  AddId(({"thanatodendron", "todesbaum", "thana"}));

  create_default_npc( 45 );
  SetProp(P_HB, 1); //ja, ich fuerchte das muss sein :)
  SetProp(P_BODY, 100);
  SetProp(P_MAX_HANDS, 10);
  SetProp(P_HANDS, ({" mit der toedlichen Gleichgueltigkeit der Natur", 300}));
  //  SetProp(P_AGGRESSIVE, 1);
  SetProp(P_WIMPY, 0);
  SetProp(P_ALIGN, 0); 
  SetProp( P_RESISTANCE_STRENGTHS,([
    DT_FIRE: 0.7, DT_MAGIC:-0.6, DT_HOLY:-0.8, DT_UNHOLY:-0.8, DT_ACID:0.3,
    DT_TERROR:-1.0
  ]));

  SetProp(P_MSGIN, "waechst herein");
  SetProp(P_MSGOUT, "waechst unheilvoll");
  SetProp(P_MMSGIN, "erwaechst todbringend zum Leben");
  SetProp(P_MMSGOUT, "verfaellt in einen Erstarrungszustand");
   
  SetProp(P_MNPC_AREA, ROOM "ko_");
  SetProp(P_MNPC_FLAGS, 
    MOV_INDOORS + MOV_MOVES + MOV_BACKWARDS + MOV_MAYLOAD );
  SetProp(P_MNPC_WAIT, ({100+random(10), 30, 20}));
  SetProp(P_MNPC_DEFAULTROOM, ROOM "ko_x3y3");

  SetProp(P_DIE_MSG, " scheidet seinen letzten Lebenssaft ab und "
    "verdorrt.\n"); 
  SetProp(P_MURDER_MSG, "Bald werden meine Wurzeln wieder Nahrung finden!");
  SetProp(P_KILL_NAME, "Thanatodendron");
  SetProp(P_KILL_MSG, "Meine Wurzeln werden sich an Deiner Leiche naehren!");
  SetProp(P_MSG_FLAGS, ([P_KILL_MSG:0, P_MURDER_MSG:0 ]));

  SetProp( P_REJECT, ({ REJECT_DESTRUCT,
    "Die Wurzeln der Kreatur zermahlen den Gegenstand zu feinem Humus.\n" }) );

  SetChats(5, ({
    "Das Wesen gibt leise, knarrende Geraeusche von sich.\n",
    "Die Atmosphaere im Raum ist zum Zerreissen gespannt.\n",
    "Du fuehlst eine toedliche Bedrohung...\n!",
    "Die Wurzeln des Wesens tasten den Raum ab.\n",
    "Uuuu...Im letzten Moment weichst Du einer Wurzel aus!\n",
    "Angesichts des unerklaerlichen Wesens denkst du an Flucht..\n",
    "So etwas wie dieses Wesen hast Du noch nie gesehen!\n",
    "Wie das Kaninchen vor der Schlange starrst Du die "
    "Lebensform vor Dir an.\n",
    "Das Thanatodendron knirscht leise.\n",
    "Die fremdartige Lebensform bewegt sich langsam, aber stetig.\n",
    "Vielleicht bist Du schneller als das Thanatodendron, aber "
    "wird Dir das auch helfen?\n" }));

  SetAttackChats(5, ({
    "Die Lebensform greift Dich mit emotionsloser Brutalitaet an!\n",
    "Du siehst Dich einer entfesselten Naturgewalt gegenueber!\n",
    "Dein Abenteurerleben laeuft wie ein Film vor Deinen Augen ab!\n",
    "Warum warst Du nur so neugierig!\n",
    "Du fuehlst die Praesenz von Lars...\n",
    "Welche Todessequenz wirst Du wohl diesmal kriegen?\n",
    "Die Lebensform ist Dir turmhoch ueberlegen!\n",
    "In den Augen des Thanatodendron bist Du nur ein Staubkoernchen!\n",
    "Vielleicht solltest Du das naechste mal Soeldner metzeln?\n" }));

  SetProp(P_SPELLRATE,50);
  AddSpell(4,800,
    "Die Kreatur giesst klebriges Harz in deine Kehle.\n",
    "Das Thanatodendron giesst @WEM klebriges Harz in die  Kehle.\n",
     DT_ACID,([SP_SHOW_DAMAGE:1]));
  AddSpell(4,700,
    "Das Thanatodendron versucht Dich mit einer Luftwurzel zu erwuergen.\n",
    "Das Thanatodendron legt @WEM eine Luftwurzel um die Kehle.\n",
     DT_SQUEEZE,([SP_SHOW_DAMAGE:1]));
  AddSpell(4,600,
    "Das Thanatodendron durchbohrt Deinen Arm mit einem duennen Ast !.\n",
    "Das Thanatodendron durchbohrt @WEN mit einem duennen Ast.\n",
     DT_PIERCE,([SP_SHOW_DAMAGE:1]));
  AddSpell(4,900,
    "Um Gottes Willen! Das Thanatodendron versucht Dich in Stuecke zu "
    "reissen !\n",
    "Das Thanatodendron versucht @WEN in Stuecke zu reissen..\n",
     DT_RIP,([SP_SHOW_DAMAGE:1]));
  AddSpell(4,700,
    "Das Thanatodendron peitscht Dich mit einem elastischen Zweig.\n",
    "Das Thanatodendron peitscht @WEN mit einem elastischen Zweig.\n",
     DT_WHIP,([SP_SHOW_DAMAGE:1]));
  AddSpell(4,700,
    "Aaarghh ... das Thanatodendron schleudert stahlharte Nadeln in Deine Augen !\n",
    "Das Thanatodendron schleudert @WEM stahlharte Nadeln in die Augen.\n",
     DT_PIERCE, "spell_blind");
  AddSpell(3,150,
    "NEIN ! Das Thanatodendron versucht Dich mit Wurzeln zu umschlingen !\n",
    "Das Thanatodendron versucht @WEN mit Wurzeln zu umschlingen.\n",
     DT_BLUDGEON,"spell_sleep");
  AddSpell(20,150,
    "Das toedliche Wesen speit Baeche einer klebrigen Substanz auf Dich !\n",
    "Das toedliche Wesen speit Baeche einer klebrigen Substanz auf Dich !\n",
    DT_MAGIC, "spell_stick");
  AddSpell(3,150,
    "Das Pflanzenmonster versperrt mit hunderten lianenartigen Fortsaetzen "
    "die Ausgaenge ! \n",
    "Das Pflanzenmonster versperrt mit hunderten lianenartigen Fortsaetzen "
    "die Ausgaenge ! \n",   
    DT_MAGIC, "spell_exits");
  AddSpell(0,150,
    "Das Thanatodendron versucht das Zentrum Deiner Faehigkeiten "
    "zu finden !\n",
    "Das Thanatodendron versucht das Zentrum @WESSEN Faehigkeiten "
    "zu finden!\n",
    DT_MAGIC, "spell_noguild");

  set_heart_beat(1);

  enable_commands();

}

void heart_beat() {
  ::heart_beat();
  if (!random(2)&&ENV(TO)) raeume_abtasten();
}

////////////////
// spells
////////////////

void spell_sleep(object enemy, int damage, mixed dam_type) {
   
  switch(random(100)){
    case 0 .. 95:
      tell_object(enemy, "Unzaehlige Wurzeln nehmen Dich in eine toedliche "
        "Umarmung !\n");
      enemy->SetProp(P_PARALYZED,
        ([PARALYZE_TIME: 2+random(3), 
          PARALYZE_MSG: "Du kannst Dich in der Umklammerung der "
            "Wurzeln nicht bewegen!\n",
          PARALYZE_MSG_OTHER: TPN+" haengt hilflos in den Wurzeln!",
          PARALYZE_END: "Endlich kannst Du Dich aus der toedlichen "
            "Umklammerung befreien.\n",
          PARALYZE_END_OTHER: "%s kann sich aus der toedlichen "
            "Umklammerung befreien.\n"]));
      break;
  
    case 96 .. 99:
      enemy->do_damage(5);
      tell_object(enemy,
        "Du schaffst es, den toedlichen Wurzeln auszuweichen.\n");
      break;
    }
  
  }

void spell_blind(object enemy, int damage, mixed dam_type) {
  enemy->SetProp(P_BLIND, ([BLIND_TIME:5+random(10), BLIND_MSG:"Die Nadeln "
    "der Kreatur haben deine Augen verletzt...Du kannst sie vor Schmerzen "
    "nicht oeffnen.\n"]));
}

int exit_test(){
  if (TP->QueryAttribute(A_DEX)<22+random(8))
    {
    write("Du schaffst es angesichts des zugewachsenen Ausgangs nicht, "
      "aus dem Raum zu fluechten !!\n");
    say(TPN+" versucht zu fluechten, der Ausgang ist jedoch "
      "zugewachsen !\n", TP);
     return 0;
    }
  else 
    write("Du schaffst es, dich durch die Lianen nach draussen zu "
      "kaempfen.\n");
    say(TPN+" kaempft sich durch die Lianen einen Weg nach draussen.\n", TP);
   return 1;
}

void spell_exits(object enemy, int damage, mixed dam_type) {
  mixed exits;
  object room;
  int i;
  exits=ENV(TO)->QP(P_EXITS);  
  room=ENV(TO);
  room->RemoveExit(0);
  if(find_call_out("normal_exits")==-1)
    {
    for (i=0;i<=m_sizeof(exits)-1;i++)
      {
       room-> AddExit( m_indices(exits)[i], ([
                          EX_DEST: exits[m_indices(exits)[i]],
                          EX_TESTFUNC: #'exit_test]));
      }
    }
  call_out("normal_exits", 5+random(3), exits, room);
}

normal_exits(mixed exits, object room) {
  int i;
  for (i=0;i<=m_sizeof(exits)-1;i++)
    {
     room-> AddExit(m_indices(exits)[i], exits[m_indices(exits)[i]]);
    }
  say("UFFZ...das Thanatodendron gibt die Ausgaenge wieder frei..."
    "FLUECHTE !!!\n");
}

void spell_noguild(object enemy, int damage, mixed dam_type, object ob) {
  int i;
  if(ob=present("stirnband", enemy)||
      ob=present("druidenamulett", enemy)||
      ob=present("wappenrock", enemy)||
      ob=present("siebzehnerschluessel", enemy))
    {
      CHECK(LOWER(ob->name(RAW))+"\n");
    switch(random(100))
      {
      case 0..9:
        tell_object(enemy, "Das Thanatodendron erkennt in "+ob->Name(WEM, 1)+
          " das Zentrum Deiner Macht und schleudert "+QueryArticle(WEN, 1)+
          "auf den Boden !\n");
        ob->SetProp(P_NOGET, 0);
        ob->SetProp(P_NODROP, 0);
        ob->move(ENV(TO), M_PUT||M_NOCHECK);
        break;
      case 10..39:
        tell_object(enemy, "Das Thanatodendron erkennt in "+ob->Name(WEM, 1)+
          " das Zentrum Deiner Macht und zwingt Dich dazu "+
          QueryArticle(WEN, 1)+" auszuziehen !\n");
        enemy->command_me("ziehe "+LOWER(ob->name(RAW))+" aus");  
        break;
      case 40..99:
        tell_object(enemy, "Das Thanatodendron erkennt "
          "zwar in "+ob->Name(WEM, 1)+" das Zentrum deiner Macht, "
          "Du kannst Dich aber gegen den Raubversuch wehren.\n");
        break;
       }
  }
  else write("Du hast keine Macht, und daher auch kein Zentrum dieser.\n");
}

void spell_stick(object enemy, int damage, mixed dam_type, object ob) {
  object partner;
  object *spieler_in_raum;
  spieler_in_raum=filter_array(all_inventory(ENV(enemy)),
    #'interactive)-({enemy});

  if(sizeof(spieler_in_raum))
    {
    partner=spieler_in_raum[random(sizeof(spieler_in_raum))];
    CHECK(file_name(partner)+"\n");

    switch (random(100))
      {
      case 0..98:
        if (!present("\nstick_spell", enemy)) 
          clone_object(OBJ "stick_spell")->move(enemy);
        else tell_object(enemy, "Du bist schon voellig verklebt. Mehr geht "
          "nicht.\n");
        if (!present("\nstick_spell", partner)) 
          clone_object(OBJ "stick_spell")->move(partner);
        else tell_object(enemy, "Du bist schon voellig verklebt. Mehr geht "
          "nicht.\n");
        break;
      case 99:
        tell_object(partner, "Du kannst dem klebrigen Harz ausweichen -"
          " zum Glueck, sonst wuerdest du wohl an "
          +partner->Name()+", "+(partner->QP(P_GENDER)==1?"der":"die")+ 
          " gerade neben Dir steht, kleben bleiben.\n");
         break;
      }
    }
  else 
    tell_object(enemy, "Zum Glueck kaempfst Du alleine hier, ansonsten "
      "wuerdest du wohl an deinen Mitstreitern kleben bleiben. \n");
}

////////////////////
// Anti_Gladstone :)
////////////////////

void phoenix() {
  if (TO && TP) 
    tell_room(ENV(TO), "Das Thanatodendron vernichtet "+TPN+ 
      " voller Gleichgueltigkeit\n");
  TP->remove();
}

void gladstone() {
  if (TO && TP)
  tell_room(ENV(TO), "Wenn das Thanatodendron nicht so emotionslos "
    "waere, wuerde es Gladstone auslachen.\n");
}

void init()
{
  ::init();
  if (TP && geteuid(TP) == "gladstone" && !IS_WIZARD(TP))
    call_out("phoenix", 2);
  if (TP && getuid(TP) == "gladstone" && IS_WIZARD(TP)) 
    call_out("gladstone",2);
}

/////////////////////
//Die Fangwurzeln
/////////////////////

varargs int raeume_abtasten(mixed exits, string chosen_exit, string exit_filename, 
  object next_room, mixed next_room_exits) {

  exits=ENV(TO)->QueryProp(P_EXITS);
  if (pointerp(ENV(TO)->QueryProp(P_HIDE_EXITS)))
    {
    int i;
    for (i=0;i<=sizeof(ENV(TO)->QueryProp(P_HIDE_EXITS))-1;i++)
      {
       exits-=([(ENV(TO)->QueryProp(P_HIDE_EXITS))[i]]);
      }
    }
  chosen_exit=m_indices(exits)[random(sizeof(m_indices(exits)))];
  exit_filename=exits[chosen_exit];
  next_room=find_object(exit_filename);

  if (next_room==0) {
    /*tell_object(find_living("joscherl"), 
      "Raum "+exit_filename+" nicht geladen!\n");*/
    return 1;
  }
  
  if (next_room!=0)  /*nur wenn der Nachbarraum geladen ist*/
    {
     int j;
     string corresp_exit;
     string corresp_exit_filename;
     object *pot_victims;
     object victim; 
     next_room_exits=next_room->QueryProp(P_EXITS);
     if (pointerp(next_room->QueryProp(P_HIDE_EXITS)))
       {
        int k;
        for (k=0;k<=sizeof(next_room->QueryProp(P_HIDE_EXITS))-1;k++)
          {
           next_room_exits-=([(next_room->QueryProp(P_HIDE_EXITS))[k]]);
          }
       } 

     /*tell_object(find_living("joscherl"),
       "------\nGewaehlter Nachbarraum: "+exit_filename+"\n");*/

     for (j=0;j<=sizeof(m_indices(next_room_exits))-1;j++)
       {
        if (next_room_exits[m_indices(next_room_exits)[j]]==
	    file_name(ENV(TO)))
          {
            corresp_exit_filename=
              next_room_exits[m_indices(next_room_exits)[j]];
            corresp_exit=m_indices(next_room_exits)[j];
          
            /*tell_object(find_living("joscherl"), "Passender Ausgang: "+
              corresp_exit+"\n------\n");*/
 
            if (sizeof(all_inventory(next_room))&&
                sizeof(pot_victims=
                  filter_array(all_inventory(next_room), #'living))) 
              {
              victim=pot_victims[random(sizeof(pot_victims))];
              tell_room(next_room, 
                "Eine lange, stahlharte Fangwurzel tastet sich aus dem "+
                UPPER(corresp_exit)+" in den Raum.\n");
              call_out("wurzelaction", 3, victim, next_room, corresp_exit, 
                chosen_exit);
              }
          }
       } 
    /*if (corresp_exit==0) 
      tell_object(find_living("joscherl"), 
        "Kein Ausgang hierher!\n------\n");*/

    corresp_exit=0;
    corresp_exit_filename=0;
    }
}

wurzelaction(object victim, object next_room, string corresp_exit,
             string chosen_exit ) {
  if (!present("thanatodendron",ENV(victim)))
    {
    if (!random(2)&&
        find_call_out("wurzelaction")!=-1)
      {
       tell_object(victim, 
         "Die Fangwurzel legt sich um deinen Hals und reisst dich "
         "Richtung "+UPPER(corresp_exit)+" !!!\n");
       tell_room(next_room,"Die Fangwurzel wickelt sich mit "+
         "moerderischer Praezision um "+victim->Name(WESSEN)+ 
         " Hals... \n", ({victim}));
       victim->move(ENV(TO),M_GO, "",
         "wird von der enormen Fangwurzel " 
         "nach "+UPPER(corresp_exit)+" gerissen ..",
         "wird von einer der Fangwurzeln des Pflanzenmonsters "
         "aus dem "+UPPER(chosen_exit)+" in den Raum gerissen .."); 
      }

    else
      tell_room(next_room, 
        "Die Fangwurzel tastet den Raum ab und zieht sich "
        "wieder nach "+UPPER(corresp_exit)+" zurueck.\n");
    }
}

kokonfressen() {
  if (present("kokon", MENV)&&
       !InFight()) 
    call_out("kokonfressen1", 2);
}

kokonfressen1() {
  if(!InFight())
    {
    tell_room(MENV, "Das Pflanzenwesen nimmt offenbar das Kokon war - "
      "unzaehlige seiner Fangwurzeln umschliessen es in "
      "Sekundenschnelle.\n");
    call_out("kokonfressen2", 3);
    if ((present("kokon", ENV(TO))->QueryProp(P_LONG))[<3..<1]=="e.\n")
      tell_room(MENV, "Du hast das Gefuehl, das das Wesen bemerkt, das "
        "der Kokon geoeffnet ist. Die Spannung steigt merklich.\n"); 
   }
  else 
    tell_room(MENV, "Das Wesen dreht sich blitzschnell zu Dir und "
      "greift Dich an!\n"); 
}

kokonfressen2() {
  if(!InFight())
    {
    tell_room(MENV, "Die Wurzeln des Wesens zerfetzen die Huelle des "
      "Kokons und bohren sich in sein Inneres.\n");
    call_out("kokonfressen3", 3);
    }
  else 
    tell_room(MENV, "Das Wesen dreht sich blitzschnell zu Dir und "
      "greift Dich an!\n");
}

kokonfressen3() {
  if(!InFight())
    {
    tell_room(MENV, "Du siehst gebannt zu, wie das Lebewesen den Inhalt "
      "des Kokons in Sekundenschnelle absorbiert und nur die leere "
      "Huelle zuruecklaesst.\n");
    present("kokon", MENV)->remove();
    clone_object(OBJ "palmblatt")->move(MENV);
    }
  else 
  tell_room(MENV,"Das Wesen dreht sich blitzschnell zu Dir und "
    "greift Dich an!\n");
}

  
Defend(int dam, mixed dtype, int spell, object enemy)
  {
    if (!pointerp(dtype))
    dtype = ({ dtype });
    
        if (member(dtype, DT_WATER ) != -1)
          {
          tell_room(environment(), "Die Pflanzenkreatur saugt die "
            "Feuchtigkeit gierig auf!\n");
          heal_self(dam);
          return ::Defend(0, dtype, spell, enemy);
          }

        if (member( dtype, DT_FIRE ) != -1)
          {
          tell_room(environment(), "Als die Flammen das Thanatodendron "
             "umzuengeln, vervielfacht es rasend seine Attacken !!!\n");
          if (find_call_out("normalisieren")==-1) 
            {
            SetProp(P_SPELLRATE, 100);
            call_out("normalisieren", 8);
            }
          return ::Defend(dam, dtype, spell, enemy);
          }
 
        if (member( dtype, DT_SLASH ) != -1)
          {
          tell_room(environment(), "Anstelle der Wurzel, die "+enemy->Name()+
             " dem Thanatodendron abschlug, wachsen zwei neue !!\n ");
          heal_self(dam/5);
          return ::Defend(0, dtype, spell, enemy);
          }
   return ::Defend(dam, dtype, spell, enemy);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  write("Das Thanatodendron bohrt seine Wurzeln in " 
    +player->Name(WESSEN)+" sterbliche Ueberreste und nimmt "
    +(player->QueryProp(P_GENDER)==1?"sein":"ihr")+" Blut und "
    "Gewebe in sich auf.\n");
  domainshout("Der grauenhafte Todesschrei von "
    +player->Name()+" hallt durch den Dschungel! Dir schaudert ...\n");
  killer->AddHp((player->QueryProp(P_LEVEL))*10);
  if( killer == TO )
    write_file(LOG"thana.kills",
       sprintf( ctime()+": Das Thanatodendron (%d) hat gerade "
       +UPPER(getuid(player))+" umgebracht - %d EP!\n", 
       QueryProp(P_LEVEL),lostexp));
  return ;
}

normalisieren(){
  SetProp(P_SPELLRATE, 50);
}

void die(int poisondeath)
{
 shout(BS("Ein Aufseufzen wie aus tausenden Kehlen geht durch das "
    "Silberland ..."+TPN+ "hat diese Welt gerade von einer grauenerregenden "
    "Kreatur des Dschungels befreit !!! "));  
  write_file(LOG"thana.kills",
  "Am "+ctime()+" hat "+UPPER(getuid(TP))+" Thana besiegt.\n");
     ::die(poisondeath);
}

verschwinden() {
  if (!sizeof((TO->QueryEnemies())[0]))
    {
     SetProp(P_HB, 0);
     set_heart_beat(0);
     verschwinden_1();
     } 
  else CHECK("Thana hat Feinde\n");
}

verschwinden_1() {
  int i, x, y, d_x, d_y;
  object env;
  env=ENV(TO);
  if (find_call_out("verschwinden_1")==-1&&file_name(env)!=ROOM"ko_x3y3")
    {
    x=to_int(file_name(env)[<3..<3]);
    y=to_int(file_name(env)[<1..<1]); 
    d_x=3-x; d_y=3-y;
    if (d_x>0)
      {
      TO->command_me("osten");
      call_out("verschwinden_1", 2);
      return;
      }
    else if (d_x<0)        
      {
      TO->command_me("westen");
      call_out("verschwinden_1", 2);
      return;
      }
    else if (d_y>0)
      {
      TO->command_me("norden");
      call_out("verschwinden_1", 2);
      return;
      }
    else if (d_y<0)        
      {
      TO->command_me("sueden");
      call_out("verschwinden_1", 2);
      return;
      }
   }
   tell_room(ENV(TO),
     "Das Thanatodendron verfaellt wieder in einen Erstarrungszustand.\n");

   if(find_living("joscherl")) CHECK("\nDas Thana verschwindet.\n\n");
   TO->remove(); 
}

