/*******************************
*  Waechter der Totenhalle
*******************************/

inherit "std/mnpc";
#include "../define.h"
#include <properties.h>
#include <language.h>
#include <combat.h>
#include <new_skills.h>
#include <moving.h>
#include <mnpc.h>
#include <wizlevels.h>

create()
{
  if (!is_clone(TO)) return;

  ::create();   

  SetProp(P_SHORT, "Eine Megalovore");

  SetProp(P_LONG, BS(
    "Wenn die riesigen Termiten unheimlich sind, dann ist dieses gigantische "
    "Insekt ein Alptraum. An die 4 Meter gross, mit unglaublichen "
    "Schneidwerkzeugen ausgeruestet, die bedrohlich aus dem Kiefer ragen, "
    "steht Dir einer der Waechter des Totengewoelbes gegenueber. An diesem "
    "Wesen erinnert nichts mehr an humanoides Leben, nur die nackte "
    "Brutalitaet eines ueberlegenen Evolutionsprodukts starrt Dich aus "
    "kalten Facettenaugen an. Du erkennst, dass ein grosser Fehler war, "
    "Kokons zu oeffnen."));
  AddDetail("alptraum", "Nichts anderes.");
  AddDetail("schneidwerkzeuge", "Vernichtend.");
  AddDetail("kiefer", 
    "Dieses Kiefer zermalmt Ruestungen wie Prinzenrollen.");
  AddDetail("kokon", "Die Megalovoren wachen darueber, dass niemand die "
    "Unversehrtheit der Kokons beeintrachtigt.");
  SetProp(P_NAME, "Megalovore");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_SIZE, (370+random(50)));
  AddId(({"megalovore", "waechter"}));

  create_default_npc(33);

  SetProp(P_HANDS, ({" mit eiskalter Grausamkeit", 150, DT_RIP}));

  SetProp(P_ALIGN, -300); 
  SetProp(P_RACE, "Termite");

  SetProp (P_MNPC_AREA, ROOM("ko"));
  SetProp (P_MNPC_WAIT, ({ 30, 15, 10 }));
  SetProp (P_MNPC_DEFAULTROOM, ROOM("ko_x3y1"));
  SetProp (P_MNPC_FLAGS, MOV_OUTDOORS+MOV_INDOORS+MOV_MOVES);

  SetProp (P_MSGIN,  "schiesst in den Raum");
  SetProp (P_MMSGIN, "waechst aus der Dunkelheit");
  SetProp (P_MSGOUT, "verschwindet" );
  SetProp (P_MMSGOUT, "verschwindet in die Dunkelheit");
}

init()
{
  ::init();
 
  if (TP && TP->id("megalovore")) AddDefender(TP);
}

void InformDefend(object enemy){
  if (!InFight()) 
     tell_room(MENV, "\nDie Megalovoren helfen sich sofort ...\n");
  Kill(enemy);
}

