/*******************************
*  Humanoide Baumschneider-Termite
*******************************/

inherit "std/mnpc";
#include "../def.h"

#define TERMRASSE \
  ({"Zwerg", "Hobbit", "Mensch","Dunkelelf","Elf","Oger","Troll"})
#define TERMNAME \
  ({"Zwergen", "Hobbit", "Menschen","Dunkelelfen","Elfen","Oger","Troll"})
#define TERMMSG ({"kriecht","krabbelt","schiebt sich", "zischt"})

int rasse;
int msg;

void create()
{
  if (!is_clone(TO)) return;
  ::create();   

  msg=random(sizeof(TERMMSG));
  rasse=random(sizeof(TERMRASSE));
  
  SetProp(P_SHORT, "Eine eigenartige " + TERMNAME[rasse] + "termite");
  SetProp(P_LONG, BS(
    "Ja, dieses Lebewesen ist ausgesprochen scheusslich. Was hat sich die "
    "Evolution nur dabei gedacht? Es ist beinahe mannshoch, sein massiger Leib "
    "wird von sechs nervoes zuckenden Gliedmassen gestuetzt. Die gewaltigen "
    "Schneidezangen dienen dazu, selbst die dicken Staemme der Dschungelriesen "
    "wie Papier schneiden zu koennen. Im Gegensatz zu den meisten anderen Termiten "
    "faellt Dir aber etwas Eigenartiges auf - irgendetwas an dem Vieh erinnert Dich an "
    "einen " +TERMRASSE[rasse]+ "?!"));
  SetProp(P_NAME, TERMNAME[rasse] + "termite");
  SetProp(P_NAME_ADJ, "eigenartige");
  SetProp(P_GENDER, FEMALE);
  SetProp(P_SIZE, (120+20*rasse));
  AddId("termite");
  AddId("baumschneidertermite");

  create_default_npc( 10 );
  SetProp(P_BODY, 100);
  SetProp(P_HANDS, ({" mit ihren messerscharfen Zangen", 60}));
  SetProp(P_ALIGN, -100); 
  SetProp(P_RACE, "Termite");
  
/****************************
***           Spells
****************************/


  SetProp(P_SPELLRATE,25);
  AddSpell(1,200, 
      "Ein beissender Geruch huellt Dich ein...Saeure!!\n",
      "Die Termite sprueht aus einer Druese aetzende "
      "Fluessigkeit auf @WEN.\n",
      DT_ACID, ([SP_SHOW_DAMAGE:1]));

/****************************
***           Sprache und Soul
****************************/

  SetChats(2, ({
        "Die Termite spuert Deine Gegenwart.\n",
        "Die Termite prueft einen Baum.\n",
        "Die Extremitaeten der Termite betasten den Lehmboden.\n",
        "Die Zangen der Termite bewegen sich auf und zu.\n",
        "Du denkst Dir o O ( ein abstossendes Lebewesen!)\n",
        "Die Termite gibt ein schabendes Geraeusch von sich.\n",
        "Du fuehlst die Beruehrungen der Termitenfuehler.\n",
        "Die Termite zischt: Frueher war " + TERMRASSE[rasse] 
        + ", jetzt ich gehoere M'baan.\n",
        "Die Termite zischt: M'baan maechtig!\n",
        }) );

  AddInfo( DEFAULT_INFO,
      "Wir nicht kennen - werden wir vernichten!",
      "zischt: ");
  AddInfo( ({"m'baan","baan", "mbaan"}),
      "Maeeechtig --- seeehr maeeechtig!\n",
      "erschauert: ");
  AddInfo("joscherl", "Joscherl hat kleines m, M'baan "
      "grosses M. M'Baan maechtiger als Joscherl!\n","faucht: ");

  SetProp (P_DIE_MSG, 
      " bricht mit einem knirschenden Geraeusch in sich zusammen.\n");

  SetProp (P_MURDER_MSG, 
      "Unter der Erde gibt's ohnehin mehr zu fressen, %s");


/****************************
***           Movement
****************************/

 SetProp (P_MNPC_AREA, ROOM );
 SetProp (P_MNPC_WAIT, ({ 10, 15, 10 }));
 SetProp (P_MNPC_DEFAULTROOM, ROOM "saeule2");
 SetProp (P_MNPC_FLAGS, MOV_OUTDOORS+MOV_INDOORS+MOV_MOVES);
 SetProp (P_MSGIN,  TERMMSG[msg] +" herein");
 SetProp (P_MSGOUT, TERMMSG[msg] );
}

void phoenix() {
  if (TO && TP) 
    tell_room(ENV(TO), "Die Termite sagt: Pfui der "+ TPN + " stammt ja von "
    "dem Wurstmagier Gladstone! Am besten wir entfernen das Ding!\n");
  TP->remove();
}

void gladstone() {
  if (TO && TP)
  tell_room(ENV(TO), "Die Termite lacht auf: Gladstone, der Wurstmagier! \n");
}

void init()
{
  ::init();
  if (TP && geteuid(TP) == "gladstone" && !IS_WIZARD(TP))
    call_out("phoenix", 2);
  if (TP && getuid(TP) == "gladstone" && IS_WIZARD(TP)) 
    call_out("gladstone",2);
  if (TP && TP->id("termite")) AddDefender(TP);
}

void InformDefend(object enemy){
  if (!InFight()) 
    tell_room(environment(TO), "\nDie Termiten verstaendigen "
      "mit ihren Extremitaeten und Du hast einen Gegner mehr. Wenn "
      "das so weiter geht, kaempft hier bald der ganze "
      "Insektenstaat...\n");
  Kill(enemy);
}

int Defend(int dam, string dtype, int spell, object enemy) {
  if (present("\ntermitis", enemy))
    {
     write("\nDie gegnerische Termite prallt zurueck und "
        "beendet den Kampf abrupt, als haette sie auf einmal etwas "
        "Entscheidendes bemerkt.\nAuch Dich haelt ploetzlich tief in "
        "Deinem Inneren etwas ab, Deinen Gegner weiter zu bekaempfen.\n"
        "Du vermeinst, die Termite etwas wie \"HALT, "
        +(enemy->QueryProp(P_GENDER)==MALE?"BRUDER!":"SCHWESTER!")+
        " zischen zu hoeren.\n");
     say("\nDie Termite und "+capitalize(enemy->name())+
        " beenden eigenartigerweise sofort den Kampf. Du hast den "
        "Eindruck, als wuerden sie sich auf eine seltsame Weise "
        " verstaendigen.\n", enemy);
     enemy->StopHuntFor(ME);
     StopHuntFor(enemy);
    }
  else return::Defend(dam, dtype, spell, enemy);
}

