/////////////////////////
//    zwischen Kokons  //
/////////////////////////

inherit "std/room";

#include "../define.h"
#include <properties.h>
#include <language.h>
#include <player.h>
#include <moving.h>



create()
{
  ::create();
  SetProp( P_INT_SHORT, "Zwischen Kokons" );
  SetProp( P_INT_LONG, 
    "Du wandelst in dem dunklen Gewoelbe durch die Reihen der schwarzen "
    "kokonartige Objekte, die in voellig praezisen, geradezu geometrischen "
    "Abstaenden angeordnet wurden. Kein Laut ist zu vernehmen, du kannst auch "
    "keine Bewegungen erkennen, die auf Termiten hindeuten wuerden. Du "
    "glaubst jedoch, an der nachtschwarzen Wand das Glitzern von "
    "Facettenaugen sehen zu koennen.  ");
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({"halbdunkel", "dunkelheit", "dunkel"}), 
    "Nur durch deine Lichtquelle vermagst Du hier etwas zu sehen. Die "
    "Dunkelheit und Totenstille lasten zentnerschwer auf "
    "deiner Psyche.");

  AddDetail( ({"lichtquelle", "dunkelelf", "schlimmeres"}),
    "Falls Du keine Lichtquelle hast, bist Du hier entweder arm dran, "
    "ein Dunkelelf oder etwas noch Schlimmeres.");



  AddDetail( ({"psyche", "druck"}), 
    "Deine Psyche ist eindeutig unter Druck.");

  AddDetail( ({"raum"}), QueryProp(P_INT_LONG));

  AddDetail( ({"gewoelbe", "decke"}), 
    "Du kannst nichts Genaues erkennen, aber Du vermutest, das dieses "
    "Gewoelbe wie die gesamte Saeule durch Baumstaemme getragen wird.");

  AddDetail( ({"genaues"}), 
    "Es ist zu dunkel um etwas Genaues zu erkennen.");

  AddDetail( ({"termiten","insekten", "termite"}), 
    "Du vermagst auf den ersten Blick keine zu entdecken, wuerdest sie "
    "aber hier zwischen den Reihen der Kokons auch nicht sehen koennen. "
    "Hier ist es "
    "beaengstigend still. Dennoch fuehlst Du dich irgendwie beobachtet.");

  AddDetail( ({"saeule", "bau"}), 
    "Die Saeule lastet drueckend schwer auf dem Gewoelbe und Deiner Psyche.");

  AddDetail( ({"boden"}),
    "Ueberall stehen in exakten Abstaenden diese schwarzen kokonartigen "
    "Objekte. Du spuerst ferner keine Unebenheiten. Dieses Gewoelbe wurde "
    "offenbar mit groesster Sorgfalt angelegt.");

  AddDetail( ({"sorgfalt", "bedeutung"}), 
    "Scheinbar hat dieses Gewoelbe fuer seine Erbauer eine besondere "
    "Bedeutung. ");

  AddDetail( ({"erbauer"}),
    "Wohl die Termiten."); 

  AddDetail( ({"kokons", "kokone", "objekte"}), 
    "Wie auf einem Friedhof sind hunderte der laenglichen schwarzen "
    "Objekte in Reihen ausgerichtet. Du weisst noch immer nicht, worum es "
    "sich hier handelt. Du haettest gute Lust, den Kokon neben dir genauer "
    "zu untersuchen, andererseits hast du ein ungutes Gefuehl.");

  AddDetail(({"lust", "zweifel", "neugier", "vorsicht"}),
    "Kein Zweifel, deine Neugier ist staerker als deine Vorsicht." );

  AddDetail(({"friedhof","vergleich"}), 
    "Ja, der Vergleich draengt sich auf. Reihen um Reihen bewegungsloser "
    "laenglicher Objekte.");

  AddDetail(({"kokon", "objekt"}),
    "Du versuchst, das Dir am naechsten liegende Kokon naeher zu untersuchen. "
    "Als du mit deiner Lichtquelle naeher herangehst, kannst Du erkennen, "
    "dass die Huelle offenbar aus grossen, in irgendeine Substanz getauchten "
    "Palmblaettern besteht.");

  AddDetail(({"huelle", "palmblaetter"}),
    "Du wuerdest sie sehr gerne entfernen. Mit einem Werkzeug muesste das "
    "gehen.");

  AddDetail("substanz", 
    "Ja, das ist wohl wieder diese Substanz mit der auch die Waende gehaertet "
    "wurden.");

  AddDetail(({"werkzeug","schneidwerkzeug"}),
    "Am besten wohl mit einem Schneidwerkzeug.");

  AddDetail(({"reihe", "reihen"}),
    "Du wandlest zwischen den Reihen und versuchst instinktiv, moeglichst "
    "leise zu sein.");

  AddDetail( ({"hundert"}), 
    "Einfach sehr viele.");

  AddDetail( ({"abstaende"}),
    "Voellig regelmaessig. Das Ganze hat etwas Unheimliches. ");

  AddDetail( ({"ganze","ganzes","summe"}),
    "Die Summe seiner Teile."); 

  AddDetail( ({"teile"}),
    "Ihre Summe ergibt das Ganze."); 

  AddDetail( ({"werk"}), 
    "Ein erstaunliches Werk, wenn momentan auch nicht ganz verstaendlich.");

  AddDetail( ({"laut"}),
    "Und zu sehen ist er schon gar nicht.");

  AddDetail( ({"bewegungen", "gewuehl"}),
    "Nachdem Dich das Gewuehl der Insekten weiter oben beinahe in Panik "
    "versetzt hat, bist Du gar nicht so ungluecklich, dass hier anscheinend "
    "keine einzige Termite herumkriecht. ");

  AddDetail( ({"panik", "gefuehl"}), 
    "Du fuehlst hier keine Panik, aber alles andere als wohl.");

  AddDetail( ({"wand", "waende"}),
    "Irgendetwas ist da an der Wand und beobachtet Dich. ");

  AddDetail( ({"facettenaugen", "facetten", "augen", "glitzern"}),
    "Es ist dieses reflektierende und doch matte Glitzern, dass Dich, "
    "solltest Du hier jemals wieder rauskommen, noch lange in deinen Traeumen "
    "verfolgen wird. ");

  AddDetail( ({"traeume", "traum", "nacht"}), 
    "Du erinnerst Dich an die Traeume der letzten Nacht und seufzt. "); 

  AddDetail( ({"intelligenz"}),
    "Wusst ichs doch, dass Du mit dem Wort wenig anfangen kannst.");

  AddDetail( ({"wort", "anfang"}),
    "Am Anfang war das Wort. Mit dem Du offenbar wenig anfaengst. \nFalls "
    "Dir dieses einzigartige Wortspiel zusagt, bedanke Dich hoeflich bei "
    "Joscherl mit dem Befehl <idee Joscherl spar Dir solche sinnlosen "
    "Details>. Wenn Du zu den ersten 10 gehoerst, wird Dir Joscherl als "
    "Belohnung ein schoenes magisches Item clonen. ");

  AddDetail( ({"wortspiel", "befehl", "details", "belohnung", "item"}),
    "Schluss jetzt. ");

  AddDetail( ({"staemme", "baumstaemme"}),
    "Du vermutest das nur. Erkennen kannst Du nichts. ");

  AddDetail( ({"blick"}),
    "Ob es ratsam ist, einen zweiten zu riskieren ? ");

  AddDetail( ({"gewuehl"}),
    "Das hat hier voellig aufgehoert.");

  AddSpecialDetail( ({"neugier"}), "nixwimpy");
  
  AddDetail( ({"unebenheiten", "gegenteil"}),
    "Ganz im Gegenteil zum Rest des Baues finden sich hier keine "
    "Unebenheiten.");

  AddDetail( ({"unheimliches"}),
    "Du oeffnest das Unheimliche, kostest davon und merkst, es schmeckt nach "
    "Banane. .... tja, so einfach kann man das nicht untersuchen, das "
    "Unheimliche :9");

  AddSound( ({DEFAULT_SOUND, "stille"}),
   "Voellige, leblose Stille, beinahe greifbar praesent.");

  AddItem(OBJ("kokon"), REFRESH_NONE);
}
 
reset() {
  object kokon_da;
  kokon_da=present("kokon", TO);
  if (!kokon_da) clone_object(OBJ("kokon"));
  if (kokon_da!=0 && (kokon_da->kokon_status())==1)
    {
     kokon_da->remove();  
     clone_object(OBJ("kokon.lpc"))->move(TO);
    }
  ::reset();
}

init() {
  ::init();
  if (TP->id("megalovore")&&random(99)<75) direction_info();
}          

direction_info() {
  object raum, spieler, *alle_spieler;
  int x, y, sp_x, sp_y, this_x, this_y;
  string sound_dir1, sound_dir2, distance;

  for (x=5;x>=1;x--)
    {
     for (y=5;y>=1;y--)
       {
        if (raum=find_object(ROOM("ko_x"+to_string(x)+"y"+to_string(y))))
           {
            if (sizeof(alle_spieler=filter_array(all_inventory(raum), #'interactive)))
              {
               spieler=alle_spieler[random(sizeof(alle_spieler))];
               sp_x=to_int((explode(file_name(ENV(spieler)), "/")[<1])[4..4]);
               sp_y=to_int((explode(file_name(ENV(spieler)), "/")[<1])[6..6]);
               this_x=to_int((explode(file_name(TO), "/")[<1])[4..4]);
               this_y=to_int((explode(file_name(TO), "/")[<1])[6..6]);
  
               if (this_x<sp_x) sound_dir2="west";
               if (this_x>sp_x) sound_dir2="ost";
               if (this_y<sp_y) sound_dir1="sued";
               if (this_y>sp_y) sound_dir1="nord";
               if (ABS(this_x-sp_x)>=3||ABS(this_y-sp_y)>=3) distance="entferntes";
               else 
                  if (ABS(this_x-sp_x)>1||ABS(this_y-sp_y)>1) 
                    distance="relativ nahes";
               if (ABS(this_x-sp_x)<=1&&ABS(this_y-sp_y)<=1) 
                  distance="bedrohlich nahes";
               if (sound_dir1||sound_dir2) 
               tell_object(spieler, "Du hoerst ein "+distance+" Tappen aus dem "+
                 UPPER((sound_dir1?sound_dir1:"")+
                 (sound_dir2?sound_dir2:"en")+
                 (sound_dir2?"en":"")+
                 "...\n"));
               }
            }
       }
    }
}
