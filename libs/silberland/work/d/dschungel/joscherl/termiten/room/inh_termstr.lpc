/*
* Termitenstrasse
*/


#include "../define.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Eine allzu lebendige Strasse" );

  SetProp( P_INT_LONG, bs(
     "Du befindest Dich auf einer Strasse im Territorium riesiger Termiten. "
     "Unzaehlige dieser abstossenden Insekten kriechen neben- "
     "und uebereinander, die abertausenden krabbelnden Gliedmassen "
     "verursachen ein Geraeusch wie sanfter Regen. Manche schleppen "
     "abgeschnittene Pflanzen und Gewaechse, andere offenbar gerade erst "
     "gefaellte Dschungelriesen aus dem Norden Richtung Sueden. Immer neue "
     "Heerscharen von Arbeitern stroemen hingegen aus der Gegenrichtung. "
     "Du musst aufpassen, in dem ekelerregenden Gewirr von Insektenbeinen, "
     "Fuehlern und Zangen nicht zertrampelt zu werden. Den Dschungel "
     "kannst Du in dieser Hoelle kaum noch erkennen."));

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 28, ENV_TERRAIN: TT_ROAD]) );

  AddDetail( "boden", bs(
    "In dem Gewirr weisst du kaum noch wo oben und unten ist. Aber "
    "auch hier ist der Boden unter den unzaehligen Lebewesen und "
    "Lasten steinhart geworden."));

  AddDetail( ({"himmel", "regenwald", "wald"}), bs(
    "Hoch ueber dir verdeckt das Geaest des Regenwaldes den Himmel. "
    "Es ist aber wohl nur eine Frage der Zeit, bis die Insekten den Platz "
    "voellig kahlgefressen haben."));

AddDetail( "Blaetterdach", bs(
    "Ein Blaetterdach ohne Blaetter. Die haben die Termiten "
    "weggeschnitten. "));

  AddDetail( "geaest", bs(
    "Was von den Termiten noch nicht zerstoert wurde, sieht ausgesprochen"
    "krank aus. "));

  AddDetail( ({"zeit","frage"}), bs(
    "Du weisst, dass auch Dir nicht viel Zeit bleiben wird, um hier zu "
    "ueberleben. "));

  AddDetail( ({"territorium", "reich" }), bs(
    "Dieser Teil des Dschungels ist das Reich der Baumschneidertermiten. "
    "Neben einer so perfekt angepassten Lebensform ist kein Platz mehr "
    "fuer andere biologische Arten."));

  AddDetail( ({"dschungel","blick"}), bs(
    "Der Blick auf den Dschungel wird durch das Gewuehl der Insekten "
    "erschwert.")); 
 
  AddDetail( ({"termiten", "baumschneidertermiten", "lebensform", 
               "lebewesen", "insekten"}), bs(
    "Diese Insekten haben nichts mit den winzigen, relativ "
    "harmlosen Tieren gemein, die Du kennst. Die Lebensform der " 
    "Baumschneidertermiten ist perfekt an die Anforderungen des "
    "Dschungels angepasst. Teilweise mannshoch, sind diese "
    "Wesen imstande, im Verband ihres Staates die unglaublichsten "
    "Leistungen zu vollbringen. Was sich ihnen in den Weg stellt, wird "
    "vernichtet. Manche von ihnen kommen dir allerdings sehr "
    "merkwuerdig vor."));

  AddDetail( ({"verband", "staat", "individuum", "funktion" }), bs(
    "Der Staat bedeutet fuer Insekten alles. Das Individuum ist nur soviel wert wie "
    "seine Funktion im Staat."));

  AddDetail( ({"anforderungen", "umwelt", "ueberlebensfaehigkeit",
               "bewohner", "faehigkeit"}), bs(
    "Diese Umwelt stellt hohe Anforderungen an die Ueberlebensfaehigkeit "
    "ihrer Bewohner. Die Termiten haben das aber eindeutig ein bisschen "
    "uebertrieben."));
  
  AddDetail( ({"leistungen"}), bs(
    "Gewaltige, allerdings zweifelhafte Leistungen. Diese Wesen vernichten "
    "ihre Umwelt systematisch."));
 
  AddDetail( ({"weg"}), bs(
    "Besser man stellt sich diesen Tieren nicht in den Weg. "
    "Was allerdings tust Du dann hier? "));
 

  AddDetail( ({"strasse", "termitenstrasse","platz" }), bs(
    "Das hier ist unverkennbar eine Termitenstrasse. Du siehst allerdings "
    "vor lauter Termiten kaum noch die Strasse. Offenbar handelt es "
    "sich um einen Haupttransportweg."));

  AddDetail( ({"haupttransportweg", "transportweg","lasten"}), bs(
    "Diese Wesen transportieren hier unentwegt Stuecke der  "
    "zerfressenen Vegetation nach Sueden. "));
  
  AddDetail( ({"rieseninsekten","wesen"}), bs(
    "Gross - verdammt gross. Aber was noch beunruhigender ist: "
    "es sind tausende. "));

  AddDetail( ({"gliedmassen","gewirr","gewuehl","koerperfortsaetze",
               "fortsaetze","tausende","abertausende"}), bs(
    "Gliedmassen, Extremitaeten, Fuehler, Zangen --- Tausende und "
    "Abertausende der widerlich langen und duennen Koerperfortsaetze "
    "beruehren Dich in einem fort, betasten Deinen Koerper, klettern "
    "ueber Dich hinweg. Es ist schlichtweg grauenhaft. "));

  AddDetail(({"koerper","buckel", "mudden"}), bs(
    "Du kriegst vom Mudden schon einen Buckel...haesslich, "
    "haesslich. Und deine Zehennaegel erst... "));

  AddDetail( ({"zangen" }), bs(
    "Diesen Zangen haelt kaum etwas stand. Hoffentlich bist Du "
    "gut ausgeruestet."));  

  AddDetail( ({ "extremitaeten","zehennaegel", "insektenleiber",
                "leiber"}), bs(
    "Du beutelst Dich vor Ekel. "));

  AddDetail( ({"ekel"}), bs(
    "Dir fallen spontan Deine Zehennaegel ein. "));

  AddDetail( ({"pflanzen", "gewaechse", "vegetation","stuecke",
               "blaetter"}), bs(
    "Dir wird klar, warum die Pflanzen und Gewaechse des Dschungels hier"
    "keine langen Ueberlebenschancen haben. Was auch immer hier gruen "
    "ist, wird abgeschnitten und Richtung Sueden verschleppt."));  

  AddDetail( ({"sueden", "wichtiges"}), bs(
    "Von hier aus kannst Du nichts erkennen; in dem Gewuehl siehst Du "
    "kaum deine Zehennaegel. Gluecklicherweise.")); 

  AddDetail( ({"ueberlebenschancen", "chancen"}), bs(
    "Nein, die Pflanzen haben hier keine. Allerdings bist Dir keineswegs "
    "sicher, dass nur sie allein den Termiten als Nahrung dienen. Langsam, "
    "aber sicher steigt Panik in Dir hoch. "));
 
  AddDetail( ({"nahrung", "baustoff","vegetarier" }), bs(
    "Wahrscheinlich benutzen die Termiten die Pflanzen als Nahrung oder Baustoff. "
    "Du hoffst jedenfalls, dass sie Vegetarier sind. "));

  AddDetail( ({"panik","bauchschmerzen","schweiss", "symptome"}), bs(
    "Bauchschmerzen, kalter Schweiss usw. Die klassischen Symptome..."));

  AddDetail( ({"manche", "merkwuerdig", "grossteil"}), bs(
    "Du wirst Dir immer sicherer: Etwas an ihnen macht "
    "auf dich einen humanoiden Eindruck."));

  AddDetail( ({"tiere", "tier"}), bs(
    "Ja wenns bloss nur Tiere waeren! Manche von ihnen "
    "wirken auf eine seltsame Weise humanoid. "));
  
  AddDetail( ({"weise"}), bs(
    "Schwer zu sagen. Die Art sich zu bewegen, Ueberreste "
    "eines humanoiden Aeusseren ... "));

  AddDetail( ({"aeusseres", "ueberreste", "art"}), bs(
    "Irgendwie menschlich. Aber auch zwergisch, elfenhaft. "
    "Du vermeinst ebenfalls, oger- und trollartige Insekten "
    "zu erkennen. "));

  AddDetail( ({"eindruck", "humanoid"}), bs(
    "Ja - diese Lebewesen sind auf eine seltsame Weise "
    "nur zum Teil Insekten! "));
 
  AddDetail( "teil", bs(
    "Offenbar allerdings zu einem Grossteil. "));
 
  AddDetail( ({"arten"}), bs(
    "Bist jetzt konntest du keine anderen Arten ausmachen. "
    "Es scheint schlichtweg keine zu geben. "));

  AddDetail( ({"dschungelriesen", "riesen"}), bs(
    "Dir ist nicht ganz klar, was sie mit den gefaellten "
    "Dschungelriesen anfangen koennten. Jedenfalls schleppen "
    "die Insekten alles nach Sueden. "));

  AddDetail( ({"gegenrichtung", "heerscharen", "schwall"}), bs(
    "Aus dem Sueden ergiesst sich ein Schwall von Insektenleibern. "
    "Dort muss etwas Wichtiges sein. "));

  AddDetail( ({"arbeiter", "arbeitsplatz"}), bs(
    "Ihr Arbeitsplatz scheint im Norden zu liegen"));

  AddDetail( ({"insektenbeine"}), bs(
    "Duenn und lang, stachelig behaart, nervoes zuckend. Ekelhaft! "));

  AddDetail( ({"fuehler"}), bs(
    "Diese Wesen besitzen Fuehler, mit denen sie unentwegt ihre "
    "Umgebung abtasten. "));

  AddDetail( ({"umgebung", "wald"}), bs(
    "Du siehst den Wald vor lauter Termiten nicht. "));

  AddDetail( ({"hoelle"}), bs(
    "Das ist keine gruene, sondern eine schwarze Hoelle unzaehliger "
    "Insektenleiber. "));

  AddSound( ({"regenguss", "geraeusch"}), bs(
    "Du horchst genau hin... eigentlich eher wie unzaehlige Fuesse, "
    "die sich aeusserst rasch bewegen."));

  AddSound( ({ DEFAULT_SOUND }), bs(
    "Die unzaehligen Insektenbeine klingen wie Regen auf einem "
    "Blaetterdach."));

  AddSound( ({"regen","tropfen"}), bs(
    "Nein, das ist kein Regen. Aber die Extremitaeten der Insekten "
    "verursachen ein Geraeusch wie tausende Tropfen."));

  AddSmell( ({DEFAULT_SMELL, "gerueche"}), bs(
    "Die beissenden Ausduenstungen der Termiten uebertuenchen "
    "alle anderen Gerueche."));

  AddSmell( ({"ausduenstungen", "termiten", "substanz"}), bs(
    "Es stinkt erbaermlich nach einer aetzenden Substanz."));



}
