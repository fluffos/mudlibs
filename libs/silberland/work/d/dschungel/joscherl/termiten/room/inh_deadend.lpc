/*
* Dschungelsackgasse
*/


#include "../define.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Mitten im Dschungel" );

  SetProp( P_INT_LONG, bs(
    "Hier, etwas abseits vom Weg, wird die Vegetation wieder etwas dichter. "
    "Zaghaft versuchen einige Schlingpflanzen und gruenes Blattwerk jenen "
    "Boden zurueckzugewinnen, den sie auf dieser eigenartigen Schneise "
    "offenbar verloren haben. Auch die grossen Dschungelriesen wirken hier "
    "gesuender und weit weniger angegriffen. Die wenigen Schnittstellen und "
    "Baumstuempfe die Du siehst, sind schon ueberwuchert und offenbar "
    "aelter. Ein Weiterkommen scheint Dir hier allerdings relativ aussichts "
    "los zu sein. "));

  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 0 );
  SetProp(P_ENVIRONMENT,
    ([ENV_TEMPERATURE: 30, ENV_TERRAIN: TT_PLAIN]) );

  AddDetail( ({"weg", "schneise"}),
    "Du hast die Schneise verlassen und bist seitwaerts ein Stueck in die "
    "Vegetation eingedrungen, die hier deutlich gesuender aussieht. ");
  
  AddDetail( ({"stueck", "meter"}),
    "Ein paar Meter. ");

  AddDetail( ({"vegetation", "dschungel"}), 
    "Hier abseits vom Weg unterliegt die Vegetation dem "
    "Dir unbekannten schaedlichen Einfluss in deutlich geringerem Masse "
    "als auf der Schneise. Du kannst schon wieder einige Schlingpflanzen, "
    "Farne, Graeser und Blattwerk erkennen.");

  AddDetail( ({"schlingpflanzen", "ranken", "kletterpflanzen"}),
    "Zahlreiche Kletter- und Schlingpflanzen winden sich hier wieder um die "
    "Dschungelriesen. Ein weiteres Fortkommen wird hier wohl schwierig. "); 

  AddDetail( ({"blattwerk", "hoehe"}),
    "Auch in geringerer Hoehe ueber dem Boden ist wieder Blattwerk "
    "auszumachen. ");

  AddDetail( ({"farne"}),
    "Die Farne gehoeren zu den aeltesten Pflanzenarten des Silberlandes. "
    "Auf ihnen wandelten schon die Alten, als die Welt noch jung war." );

  AddDetail( ({"graeser"}),
    "Wo ein Lichtstrahl hinfaellt, wuchern verschiedene Graeser. ");

  AddDetail( ({"boden"}),
    "Der Boden wird hier sehr unwegsam, du stolperst ueber Wurzeln und "
    "verhedderst Dich andauernd in verschiedensten Ranken und "
    "Schlingpflanzen.");

  AddDetail( ({"wurzeln"}),
    "Dicke, uralte Wurzeln.");

  AddDetail( ({"dschungelriesen", "baeume", "riesen"}),
    "Maechtig und respekteinfloessend ragen hier die Dschungelriesen weit "
    "empor und bilden ein hier wieder ein fuer das Auge voellig "
    "undurchdringliches Blaetterdach.");

  AddDetail( ({"blaetterdach", "himmel"}),
    "Durch das undurchdringliche Blaetterdach kannst du hier unmoeglich den "
    "Himmel sehen.");

  AddDetail( ({"baumstuempfe", "schnittstellen", "ueberreste"}),
    "Nur wenige Ueberreste abgeschnittener Baeume deuten darauf hin, dass "
    "auch hier jener unbekannte Einfluss gewuetet hat, der fuer die "
    "Verwuestung auf der Schneise verantwortlich ist.");

  AddDetail( ({"weiterkommen", "fortkommen"}),
    "Hier duerfte es einen erheblichen Aufwand bedeuten, Dich weiter in den "
    "Dschungel vorzukaempfen. ");

  AddDetail( ({"aufwand"}),
    "D.h.: wenns ueberhaupt geht, duerfte es extrem muehsam werden. ");

  AddDetail( ({"alten", "vorgaenger"}),
    "Die Vorgaenger der jetzigen Bewohner des Silberlandes.");

  AddDetail( ({"bewohner", "silberland", "welt"}),
    "Auch du "+UPPER(TP->QueryProp(P_RACE))+ " bist Bewohner dieser Welt, "
    "des Silberlandes.");

  AddDetail( ({"auge"}),
    "Augen, ok. Hast ja zwei ... ");

  AddDetail( ({"augen"}),
    "Du blickst Dir tief in die Augen und flirtest ein wenig.");

  AddDetail( ({"blaetterdach", "himmel"}),
    "Durch das undurchdringliche Blaetterdach kannst du hier unmoeglich den "
    "Himmel sehen. ");

  AddDetail( ({"einfluss", "verwuestung"}),
    "Nur zu gern wuerdest Du wissen, durch welchen oder wessen Einfluss "
    "der Dschungel dermassen mitgenommen wurde.");

  AddDetail( ({"lichtstrahl", "lichstrahlen"}),
    "Durch das undurchdringliche Blaetterdach fallen wenige Lichtstrahlen. ");

  AddDetail( ({"pflanzenarten", "reichtum"}),
    "Der Reichtum an Pflanzenarten ist im Dschungel besonders gross. ");

}







