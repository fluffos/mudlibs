/////////////////////////////////////////////
// Termitenstock Erdgeschoss
////////////////////////////////////////////


#include "../define.h"

inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
  ::create();

  SetProp( P_INT_SHORT, "In einem duesteren Bau" );

  SetProp( P_INT_LONG, 
     "Es ist so duester, dass Du den Raum in dem Du stehst schwer "
     "ueberblicken kannst. Der dumpfe Hall gibt Dir allerdings das Gefuehl, "
     "dass er recht gross sein muss. Im fahlen Schein deiner Lichtquelle "
     "erkennst du, dass Waende, Boden und Decke wie in einer Roehre "
     "rund ineinander uebergehen, aber sehr unregelmaessig geformt "
     "sind. Immer wieder ragen Baumstaemme heraus und alles ist von einer "
     "harten und nachtblau schillernden Substanz ueberzogen. Das Gewuehl "
     "der Insekten ist hier noch unertraeglicher als draussen und "
     "vermittelt Dir das Gefuehl einer brodelnden schwarzen Masse. " 
     "Wenn Dir vorher mulmig war, so hast Du nun wirklich Angst." );
     
  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( "boden",
    "Eigentlich gibt es hier keinen wirklichen Boden. An den Seiten woelbt er sich "
    "nach oben und geht fliessend in die Waende ueber. Einmal musst Du ueber "
    "teilweise huefthohe Hindernisse klettern, dann steigst Du wieder in "
    "tiefe Gruben. Du beschliesst, deine Erkundungen sehr vorsichtig "
    "anzugehen. Ueberall ist diese steinharte Substanz.");

  AddDetail( ({"roehre","seiten", "form"}),
    "Der Raum ist nicht kubisch sondern rund wie eine Roehre.");

  AddDetail( ({"waende", "wand"}),
    "Die runden Waende sind sehr unregelmaessig und weisen zahlreiche Vorspruenge "
    "und Nischen auf. Ueberall ragen verkeilte Baumstaemme heraus. Wo die Waende in "
    "die Decke uebergehen, fuehrt ein beinahe senkrechter Tunnel weiter nach oben und ist "
    "schwarz vom Gewimmel der Insekten. ");

  AddDetail( ({"lichtquelle", "duesternis"}),
    "Mit zitternder Hand haeltst Du Deine Lichtquelle.");

  AddDetail( "hall", 
    "Du solltest nochmal hinhorchen.");

  AddDetail( ({"baumstaemme", "staemme", "holz"}),
    "Die Baumstaemme ragen windschief aus dem Boden und der Wand. "
    "In der Duesternis musst du aufpassen, nicht dagegen zu stossen. Da "
    "ist noch etwas...");

  AddDetail( "substanz",
    "Diese Substanz verbindet die verkeilten Baumstaemme wie Zement. "
    "Sie glitzert nachtblau in Schein deiner Lichtquelle. Abgesehen von "
    "den Staemmen erkennst du noch etwas...");

  AddDetail( "schein",
    "Deine Lichtquelle vermag den Raum nicht auszuleuchten. Du "
    "koenntest aber ohnehin nicht sehr weit sehen, da die zahlreichen "
    "Baumstaemme, Woelbungen und Nischen den Raum wabenfoermig "
    "strukturieren. Ausserdem bist Dir gar nicht sicher, ob die Termiten "
    "das moegen wuerden. "); 

  AddDetail( ({"gewuehl","gewimmel"}),
    "Das ist hier noch schlimmer als draussen. Du kommst nur noch durch "
    "pausenloses Stossen und Schieben weiter. Ausserdem ueberkommt Dich "
    "hier ein Gefuehl der Klaustrophobie. Du moechtest raus. ");

  AddDetail( ({"schieben", "stossen"}),
    "Wie in der Evidenzstelle am letzten Tag der Inskriptionsfrist. ");

  AddDetail( ({"tag", "inskriptionsfrist", "evidenzstelle"}),
    "Frag Joscherl, der weiss wovon er redet :\). ");

  AddDetail( ({"joscherl"}),
    "Ein Forscherpunkt wurde Dir soeben abgezogen. ");

  AddDetail( ({"forscherpunkt"}),
    "Und noch einer. Tja. ");

  AddDetail( ({"insekten","termiten", "bau"}),
    "Hier in ihrem Bau sind die Termiten so zahlreich, dass du den "
    "Eindruck einer brodelnden schwarzen Masse bekommst, die Dich "
    "unweigerlich in sich hineinzieht.");

  AddDetail( ({"eindruck"}),
    "Entsetzlich.... und doch...... ");
 
  AddDetail( ({"masse", "angst", "bahnen", "denken"}),
    "Irgendetwas Unbestimmtes will Dich in diese Masse ziehen und nicht "
    "mehr loslassen. Schweissperlen rinnen ueber deine Stirn, Dein Denken "
    "laeuft in ungeordneten Bahnen ab... ");

  AddDetail( ({"unbestimmtes", "maechtiges", "belastung"}),
    "Etwas sehr maechtiges. Du stoehnst unter dieser Belastung... ");
  
  AddDetail( ({"etwas"}),
    "WUUAAA......Schaedel, Brustkoerbe, Oberschenkelknochen...Die "
    "Termiten verwenden offenbar auch die Ueberreste ihre Opfer als "
    "Baumaterial !!! ");

  AddDetail( ({"baumaterial"}),
    "Holz, Knochen und diese eigenartige Substanz als Moertel. ");

  AddDetail( ({"moertel", "zement", "konglomerat"}),
    "Die nachtblaue Substanz verbindet das Holz und die Staemme zu "
    "einem steinharten Konglomerat. ");

  AddDetail( ({"schaedel", "brustkoerbe", "oberschenkelknochen"}),
    "Du zitterst. Deine Lichtquelle wirft tanzende Schatten an die Wand. "
    "Hier ist's mehr als ungemuetlich. ");

  AddDetail( ({"gefuehl", "klaustrophobie"}),
    "Ein beklemmendes Gefuehl. ");

  AddDetail( ({"raum"}),
    "Der Raum ist sicher groesser, als das was du im Schein deiner "
    "Lichtquelle erkennen kannst. ");

  AddDetail( ({"hindernisse", "gruben"}),
    "Dieser Raum ist abgesehen von seiner runden roehrenartigen Form "
    "durch zahlreiche Woelbungen und Nischen wabenartig strukturiert, der "
    "Boden uneben. Aber das stoert die Insekten mit ihren "
    "sechs Beinen wohl wenig. ");

  AddDetail( ({"beine"}),
    "Du hast nur zwei davon. Pech gehabt. ");

  AddDetail( ({"pech", "glueck"}),
    "Hoffentlich hat Dich dein Glueck nicht voellig verlassen. ");

  AddDetail( ({"erkundungen"}),
    "Falls Du hier sowas ueberhaupt vor hast. ");

  AddDetail( ({"vorspruenge", "nischen", "woelbungen"}),
    "Die Waende sind rund, aber unsymmetrisch und weisen zahlreiche "
    "Vorspruenge und Nischen auf, die dem Raum ein wabenartiges Gepraege "
    "geben. ");

  AddDetail( "gepraege",
    "Wabenfoermig.");
 
 AddDetail( ({"tunnel"}),
    "Vielleicht kommt man da rauf. Du ueberlegst, ob Du dass auch willst. ");

  AddDetail( ({"hand", "haende"}),
    "Deine Haende sind schweissnass und zittern. ");

  AddDetail( ({"decke"}),
    "Auch die Decke glitzernd im Schein deiner Lichtquelle nachtblau. Ein runder "
    "Tunnel fuehrt beinahe senkrecht nach oben. ");

  AddDetail( ({"stirn", "schweiss", "schweissperlen"}),
    "Von Deiner Stirn rinnt kalter Schweiss. ");

  AddSmell(({DEFAULT_SMELL, "geruch"}),
      "Der beissende Geruch wird immer unertraeglicher. Deine Nase laeuft, deine "
      "Augen traenen. ");

  AddSound(({DEFAULT_SOUND, "schritte", "hall"}),
      "Nebem dem zischenden Geraeusch der Insekten hoerst Du, wenn auch gedaempft, "
      "den Hall deiner Schritte. Der Raum hier kann nicht so klein sein.");

  AddSound(({"geraeusch"}),
      "Du wuenschst Dir, es wuerde endlich aufhoeren.");

AddDetail(({"nase", "augen","schleimhaeute"}),
    "Die Substanz greift deine Schleimhaeute an.");

}
