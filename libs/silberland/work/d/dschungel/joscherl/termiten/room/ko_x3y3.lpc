///////////////////////////////
//    Thanatodendrom-Raum    //
///////////////////////////////

inherit "std/room";

#include "../define.h"
#include <properties.h>
#include <language.h>
#include <player.h>
#include <moving.h>

object thana;

string intlang() {
  if (!thana=find_living("thanatodendron"))
    return BS(
    "Angstgefuehle, Verwunderung und atemloses Erstaunen kaempfen "
    "in Dir, als Du in die etwas erhoehte Mitte des Gewoelbes trittst. "
    "Genau in dessen Zentrum, alles andere ueberragend, entspringt "
    "dem Boden ein chaotisches, in gigantischen Ausmassen bis zur "
    "Decke aufragendes, an dieser entlang in alle Richtungen "
    "verlaufendes Wirrwarr von Wurzeln, Aesten, Ranken und undefinierbaren "
    "pflanzlichen Formen, die aus einem gewaltigen Stamm entspringen und "
    "sich um diesen ranken. Du vermeinst an dem riesenhaften Gewaechs "
    "beinahe unmerkliche Bewegungen wahrzunehmen, die dem Anblick etwas "
    "gespenstisch Lebendiges geben. Langsam verstaerkt sich in Dir der "
    "Eindruck einer toedlichen Bedrohung.");
  else return BS(
    "Angstgefuehle und Unsicherheit kaempfen in Deinem Inneren. Hier, "
    "genau im Zentrum des Gewoelbes, siehst Du vor Deinen Augen einen "
    "riesigen Krater, in dem zahlreiche Wurzeln und Pflanzenreste darauf "
    "schliessen lassen, dass hier vor ganz kurzer Zeit ein gigantisches "
    "Gewaechs aus dem Boden wuchs. Es ist Dir unerklaerlich, warum Du "
    "nicht mehr Reste sehen kannst...fast scheint es Dir, als ob das "
    "Ding, was immer es auch war, sich selbst entfernt haette.");
}

string mitte() {
  if (!thana=find_living("thanatodendron"))
    return BS(
    "In der Mitte des Raumes, die auch gleichzeitig das Zentrum des "
    "Gewoelbes bildet, befindet sich dieses eigenartige, gigantische "
    "Gewaechs.");
  else return BS(
    "In der Mitte des Raumes, die auch gleichzeitig das Zentrum des "
    "Gewoelbes bildet, befindet sich am Boden ein grosser Krater, als "
    "ob hier vor ganz kurzem ein gigantisches Gewaechs entwurzelt "
    "worden waere.");
}
 
string pflanze() {
  if (!thana=find_living("thanatodendron"))
    return BS(
    "Das riesige Ding vor Dir besteht aus unzaehligen verschlungenen "
    "Ranken, Wurzeln, Aesten und einem monolithischen Stamm.");   
  else return BS(
    "Die Pflanze gibt es nicht mehr. Zumindest nicht in diesem Teil "
    "des Gewoelbes.");
}

string wurzeln() {
  if (!thana=find_living("thanatodendron"))
    return BS(
    "Die zahllosen - du bist versucht, Gliedmassen zu sagen - umschlingen "
    "nicht nur den Stamm sondern breiten sich auch ueberall in den Raum "
    "hinein aus. Manche der Fasern erscheinen Dir merkwuerdig.");
  else return BS(
    "Die Wurzelreste verleiten Dich zu dem Schluss, dass das Ding, was hier "
    "einmal mit dem Boden verwachsen war, gigantisch war.");
}


string boden() {
  if (!thana=find_living("thanatodendron"))
    return BS(
    "Der Boden ist hier um gut einen Meter hoeher als ringsum, das ganze "
    "Ding steht auf einer Art Podest.");
  else return BS(
    "Der Boden ist hier um gut einen Meter hoeher als ringsherum, dafuer ist "
    "der Krater umso tiefer.");
}

string decke() {
  if (!thana=find_living("thanatodendron"))
    return BS(
    "Das Gewaechs reicht bis an die Decke, seine Fasern verlaufen auch "
    "entlang dieser und breiten sich in alle Richtungen aus.");
  else return BS(
    "Das Gewaechs reichte offenbar bis an die Decke, da Du auch an dieser "
    "pflanzliche Reste erkennen kannst, die entlang dieser verlaufen und "
    "sich in alle Richtungen ausbreiten.");
}

string teil() {
  if (!thana=find_living("thanatodendron"))
    return BS(
    "Das hier ist das Zentrum des Gewoelbes.");
  else return BS(
    "Das Gewaechs ist wohl weg...aber wohin?");
}

create()
{
  ::create();

  SetProp( P_INT_SHORT, "Im Zentrum einer Totenhalle" );
  SetProp( P_INT_LONG, "@@intlang@@");

  SetProp( P_LIGHT, 0 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 15, ENV_TERRAIN: TT_CAVE]) );

  AddDetail(({"angstgefuehle", "gefuehle", "gefuehl","verwunderung",
               "erstaunen", "anblick", "unsicherheit"}), 
    "In Dir kaempfen panische und neugierige Gefuehle. Einerseits ist "
    "das hier faszinierend, andererseits irgendwie bedrohlich.");

  AddDetail(({"zentrum", "mitte"}),#'mitte);

  AddDetail(({"gewirr", "wirrwarr", "gewaechs", "pflanze", "ding", "formen"}),
    #'pflanze);

  AddDetail(({"bewegungen", "lebendiges"}),
    "Vielleicht auch nicht? Du weisst es nicht genau... aber voellig "
    "leblos ist dieses Ding nicht.");

  AddDetail(({"krater"}), 
    "Am Boden befindet sich riesiger Krater, hanz so als ob hier ein "
    "gigantisches Gewaechs entwurzelt wurde.");

  AddDetail(({"eindruck", "bedrohung", "schein"}),
    "Hoffentlich truegt dieser Schein.");

  AddDetail(({"gewoelbe"}),
    "Hier ist eindeutig das Zentrum des Gewoelbes.");

  AddDetail(({"ranken", "wurzeln", "aeste", "pflanzenreste"}), #'wurzeln);

  AddDetail(({"teil"}), #'teil);

  AddDetail(({"fasern"}),
    "Ja, es scheint, als wuerden sich hinter ihren monstroesen Windungen "
    "irgendwelche groesseren Gegenstaende verbergen...");

  AddDetail(({"windungen"}),
    "Du wuerdest die Windungen gerne loesen, aber du bist Dir keineswegs "
    "sicher ob Du das angesichts des unangenehmen Gefuehls, das Du hast, "
    "tun solltest.");

  AddDetail(({"gegenstaende"}),
    "Du kannst nichts bestimmtes sagen, es scheint Dir aber als ob die "
    "Windungen irgendetwas einwickeln wuerden. Du musst sie wohl irgendwie "
    "loesen oder entfernen um Naeheres herauszufinden. Joscherl wuenscht "
    "Dir dabei viel Glueck.");

  AddDetail(({"stamm"}),
    "Der Stamm ist titanenhaft, unterscheidet sich jedoch von einem "
    "gewoehnlichen Baumstamm dadurch, dass er irgendwie beweglich wirkt. "
    "Du hast nicht den Eindruck, dass dieses Ding fest im Boden verwurzelt "
    "waere.");

  AddDetail(({"boden", "podest"}), #'boden);

  AddDetail(({"wand", "waende"}),
    "Die Waende sind hier weiter weg, Du bist genau im Zentrum des "
    "Gewoelbes.");

  AddDetail(({"raum"}), QueryProp(P_INT_LONG));

  AddDetail(({"decke"}),#'decke); 

  AddDetail(({"ausmass", "ausmassen", "groesse"}),
    "Schlichtweg gewaltig. Du hast selten so eine grosse Pflanze gesehen.");

  AddDetail(({"baumstamm", "baum"}),
    "Der Stamm dieser nur entfernt an einen Baum erinnernden Pflanze "
    "erscheint Dir trotz seiner Groesse seltsam flexibel.");

  AddDetail(({"gliedmassen"}),
    "Wenn es nicht offenbar eine riesige Pflanze waere, wuerdest Du sagen, "
    "es handelt sich um Gliedmassen.");

  AddDetail(({"meter", "art"}),
    "Ein bischen erhoeht, ungefaehr ein Meter.");

  AddCmd(({"loese"}), "loesen"); 


  AddExit(({"suedunten","sueden"}), ROOM("ko_x3y2"));
  AddExit(({"nordunten","norden"}), ROOM("ko_x3y4"));
  AddExit(({"westunten","westen"}), ROOM("ko_x2y3"));
  AddExit(({"ostunten","osten"}), ROOM("ko_x4y3"));
  SetProp(P_HIDE_EXITS, ({"sueden", "norden", "osten", "westen"}));

}

reset() {
  ::reset(); 
  call_out("thana_raus", 600+random(600));
  
}

thana_raus(object thana) {
  if (!find_living("thanatodendron"))
    clone_object(NPC("thanatodendron"))->move(TO, M_TPORT);
  call_out("thana_weg", 300+random(300));
}

thana_weg(object thana) {
  if (thana=find_living("thanatodendron"))
    thana->verschwinden();
}


loesen(string str) {
  if (!str)
    { 
     write("Was willst du hier loesen ?\n");
     return 1;
    }
  if (str=="windung" ||
      str=="windungen" ||
      str=="gegenstand" ||
      str=="gegenstaende")
    {
     write("Die Windungen sind extrem hart und eng gewickelt. Ohne einem "
       "scharfen Werkzeug wird auch hier nichts gehen.\n");
     AddCmd(({"schneide","schneid"}), "aufschneiden");
    }
  else 
    write("Das kannst Du hier nicht loesen.\n");
  return 1;
}

aufschneiden(string str) {
  if (!TP->QueryProp(P_WEAPON)||
      (member(({"knife", "sword", "axe"}),
      (TP->QueryProp(P_WEAPON))->QueryProp(P_WEAPON_TYPE))==-1))
    write("Du hast nichts brauchbares zum Schneiden dabei.\n");

  else 
    {
     if (!str) 
       {
        write("Schneiden - was und womit?\n");
        return 1;
       }
     if (sizeof(explode(str, " "))<3)
       {
        write("Du scheiterst 'case 1'. Was willst Du womit aufschneiden?\n");
        return 1;
       }
     if (member(({"windungen", "windung", "fasern"}),
         explode(str, " ")[0])!=-1 &&
         explode(str, " ")[1]=="mit" &&
         (TP->QueryProp(P_WEAPON))->id(explode(str, " ")[2]))
       {
        write("Du schneidest die Windungen mit "+
          (TP->QueryProp(P_WEAPON))->name(WEM, 1)+" auf.\n");
        call_out("thana_combat1", 1);
       }
     else 
       write("Du scheiterst. Was willst Du womit aufschneiden?\n");
    }
  return 1; 
}

thana_combat1() {
  write("\nWuuuuaaaa... als Du die Windungen enfernst, erkennst Du, "
    "dass die verborgenen Gegenstaende offenbar halbverdaute Leichenteile "
    "sind ... Schaedel, Stuecke von Brustkoerben, Torsi, Schenkel, "
    "allesamt in einem grauenerregenden Zustand !\n");
  call_out("thana_combat2", 2);
}

thana_combat2() {
  write("\nVerflucht ... die Bewegungen der Pflanze nehmen deutlich zu ... "
    "Offenbar war es nicht sehr klug, sie mit einem scharfen Gegenstand zu "
    "verletzen. Du erschauerst, als die gigantische Lebensform vor dir "
    "aus ihrem Daemmerzustand erwacht!\n");
  call_out("thana_combat3", 2);
}

thana_combat3(object thana) {
  write("Und _wie_ sie erwacht... du findest keine Zeit mehr sie zu "
    "bewundern...\n");
  if(!find_living("thanatodendron"))
    {
     (thana=clone_object(NPC("thanatodendron")))->SetProp(P_AGGRESSIVE, 1);
     thana->move(TO,M_TPORT);
     thana->Kill(TP);
    }
}








