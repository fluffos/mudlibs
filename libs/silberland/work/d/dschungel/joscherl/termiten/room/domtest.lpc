inherit "std/room";

#include <properties.h>
#include <language.h>

create()
{
	::create();
	
	SetProp( P_INT_SHORT, "Ein Dschungeldom." );
	SetProp( P_INT_LONG,
		"Als Du die laestigen Schlingfasern, die Deinen Kopf umwickeln,\n"
	+	"herunterreisst und befreit aufatmest, siehst Du etwas Unerwartetes.\n"
	+	"Das Dickicht erweitert sich hier zu einer Lichtung. Naja, Lichtung ist wohl \n"
	+	"das falsche Wort; Du siehst zwar in ihrer Mitte keine Gewaechse, aber Himmel\n"
	+	"siehst du auch keinen. Vielmehr wird durch die Fauna des Dschungels eine \n"
	+	"Art Dom gebildet. Blattwerk, Aeste und Pflanzen formen Waende und ein\n"
	+	"Gewoelbe, durch das nur wenig Licht eindringt; der Boden ist auffaellig eben. \n"
	+	"Das ist nicht der Dschungel wie Du ihn kennst.\n"
	);
	
	SetProp( P_LIGHT, 1 );
	SetProp( P_INDOORS, 1 );

	AddDetail( ({ "schlingfasern", "fasern" }),
		"Sie schienen sich beinahe absichtlich um Dich gewickelt zu haben.\n"
	+	"Zum Glueck siehst Du wieder etwas.\n"
	);
	
	AddDetail( "kopf", 
		"Du wischt die klebrige Substanz ab, die die Fasern hinterlassen haben und\n"
	+	"betastest ihn. Ja, alles noch dran. Leider....\n"
	);
	
	AddDetail( "substanz", 
		"Die hast Du jetzt auf den Fingern. Orange und klebrig.\n"
	);

	AddDetail( ({"orange", "zeug"}), 
		"Ob Du das Zeug kosten solltest?.\n"
	);

	AddDetail( "unerwartetes",
		"Ebenso unerwartet wie eigenartig. Ganz anders als die Wildnis, durch\n"
	+	"die Du deinen Weg gebahnt hast.\n"
	);

	AddDetail( ({ "wildnis", "dickicht"}),
		"Du bist voellig zerkratzt und verschwitzt. Deine Haare haengen Dir in nassen\n" 
	+	"Straehnen ins Gesicht. Die Dichte des Regenwaldes hier ist\n"
	+	"unbeschreiblich, Umso seltsamer ist das Gebilde, in dem Du Dich\n"
	+	"befindest.\n"
	);

	AddDetail( "lichtung",
		"Das ist nur insofern eine Lichtung, als in einem Radius von einigen\n"
	+	"Metern keine Gewaechse aus dem Boden wachsen. Mit Licht hat das\n"
	+	"wenig zu tun. Davon gibts hier gerade genug, um etwas zu sehen. Das\n"
	+	"Gewoelbe aus Blattwerk laesst kaum etwas durch; Du hast den Eindruck,\n"
	+	"als ob auf dem Gewoelbe das Blattwerk turmhoher Dschungelriesen wie Blei\n"
	+	"lastet.\n"
	
	);
	
	AddExit( "sueden", "/players/joscherl/workroom" );
}

