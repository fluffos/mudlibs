////////////////////
//     BRUTRAUM      //
////////////////////

inherit "std/room";

#include "../define.h"
#include <properties.h>
#include <language.h>
#include <player.h>
#include <moving.h>



create()
{
  ::create();
  SetProp( P_INT_SHORT, "In einem wabenartigen Raum" );
  SetProp( P_INT_LONG, 
    "Das Roehrensystem erweitert sich hier zu einer weitlaeufigen "
    "Kammer, deren Waende und Boden sich in zahllose wabenartige "
    "Aushoehlungen "
    "gliedern. Ein kalter, blaeulich pulsierender Schimmer, dessen "
    "Ursprung du nicht feststellen kannst, ueberzieht den Raum mit "
    "einem unwirklichen Schattenspiel. Es deutlich stiller als "
    "sonst in der Saeule, nur ein leises, aber unheimliches Knistern und "
    "Kratzen erfuellt den Raum. Du vermeinst, in den Aushoehlungen "
    "unmerklich langsame, aber bestaendige  Bewegungen erkennen zu "
    "koennen. ");
  SetProp( P_LIGHT, 1 );
  SetProp( P_INDOORS, 1 );
  SetProp(P_ENVIRONMENT,([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_CAVE]) );

  AddDetail( ({"roehrensystem", "system", "gaenge", "schaechte"}), 
    "Der Bau besteht aus einem System von zahlreichen roehrenartigen "
    "Gaengen und Schaechten, die die Kammern miteinander verbinden.");

  AddDetail( ({"kammer", "raum"}), QueryProp(P_INT_LONG));

  AddDetail( ({"kammern"}), 
    "Du hoffst, aus den zahlreichen Kammern des Baues wieder "
    "herauszufinden.");

  AddDetail( ({"armeslaenge"}), 
    "Ja, ungefaehr. Eng, aber du wuerdest "
    "hineinpassen. Manche sind auch etwas groesser.");

  AddDetail( ({"waende", "wand"}), 
    "Die Waende bestehen wie der Boden aus zahlreichen wabenartigen "
    "Aushoehlungen "
    "mit einem Durchmesser von ungefaehr einer Armeslaenge. Wie tief "
    "die Aushoehlungen in die Waende fuehren, kannst Du nicht erkennen.");

  AddDetail( ({"schimmer", "licht"}), 
    "Die Kammer wird durch einen fluoriszierenden Schimmer in ein "
    "blaeuliches Licht getaucht.");

  AddDetail( ({"ursprung", "vermutungen"}), 
    "Du kannst darueber nur Vermutungen anstellen. Vielleicht handelt "
    "es sich um irgendeine alchemische Substanz oder Ausscheidung der "
    "Lebewesen ?");

  AddDetail( ({"ausscheidung"}), 
    "Ein Druesensekret moeglicherweise.");

  AddDetail( ({"substanz", "sekret", "druesensekret"}), 
    "Du denkst an die blaeuliche Substanz, die die Staemme "
    "wie Zement verbindet. Auch die ist offenbar nicht natuerlichen "
    "Ursprungs.");

  AddDetail( ({"ausscheidung"}), 
    "Ein Sekret, das die Termiten ausscheiden.");
 
  AddDetail( ({"staemme", "zement", "baumstaemme", "holz"}), 
    "Der gesamte Bau besteht aus verkeilten Baumstaemmen, die von "
    "einer eigenartigen Substanz wie durch Zement verbunden werden.");
 
  AddDetail( ({"schattenspiel", "schatten"}), 
    "Blaeuliche Schatten tanzen ueber die Waende und vereinigen sich "
    "mit der Dunkelheit der Aushoehlungen. ");

  AddDetail( ({"dunkelheit"}), 
    "Hier ist es nicht ganz so dunkel wie sonst im Bau.");
  AddDetail( ({"saeule", "bau"}), 
    "Du bist nun tief in der Saeule. Ein schnelles Zurueck ist hier kaum "
    "noch moeglich.");

  AddDetail( ({"aushoehlungen", "durchmesser"}), 
    "Die Aushoehlungen haben einen Durchmesser von etwa einer "
    "Armeslaenge. Du kannst nicht erkennen wie tief sie in die Wand "
    "reichen, aber irgendetwas scheint sich in ihnen zu bewegen. ");

  AddDetail( ({"bewegungen"}), 
    "Ja, in beinahe jeder dieser Aushoehlungen bewegt sich etwas. Du "
    "kannst die Bewegungen nicht wirklich sehen, aber du nimmst sie "
    "intuitiv war.");

  AddDetail( ({"zurueck"}), 
    "Ja, das waere vielleicht das Beste. ");

  AddDetail( ({"beste"}), 
    "Da faellt Dir ganz spontan wie Du ja bist 'umkehren' ein.");

  AddDetail( ({"boden"}), 
    "Auch im Boden findest Du wabenfoermige Loecher, zwischen denen "
    "Du vorsichtig hindurchbalancieren musst.");

  AddDetail( ({"loecher"}), 
    "Die Loecher im Boden sind ebenso geformt wie die Aushoehlungen "
    "in den Waenden. In den meisten von ihnen kannst du langsame "
    "Bewegungen wahrnehmen.");

  AddDetail( ({"decke"}), 
    "Im dem blaeulich flouriszierenden Licht kannst Du die die Decke "
    "kaum erkennen. Die Kammer duerfte ziemlich hoch sein.");
 
  AddDetail( ({"termiten", "lebewesen"}), 
    "Hier kriechen eigenartig wenig Termiten ein und aus. Du kannst "
    "allerdings nicht behaupten, darueber ungluecklich zu sein. ");

  AddDetail( ({"gemaeuer", "ratten", "milch", "moebel", "metapher"}), 
    "Nur eine Metapher.");
 
  AddSmell( ({DEFAULT_SMELL, "gestank"}), 
    "Der beissende Gestank hat hier etwas nachgelassen, dafuer riecht "
    "es eigenartig suess-saeuerlich, ein wenig wie alte Milch. ");

  AddSound( ({"knistern", "kratzen", "schaben", "geraeusche"}), 
    "Andauernde leise Geraeusche wie das Holz alter Moebel ... oder "
    "Ratten tief in einem Gemaeuer. Dich froestelt.");

  AddSound(DEFAULT_SOUND, 
    "Ein leises Kratzen und Schaben erfuellt den Raum.");

  AddCmd(({"krieche", "kriech"}), "in_wabe");

}

int in_wabe(string str) {
  int welche_wabe; 
  welche_wabe = random(100);
  if (!strlen(str))
    return write("Wenn du weiter ziellos herumkriechst, wirst du "
      "bald Probleme kriegen.\n") ,1;
  if (!member( (["in wabe","in aushoehlung", "in loch",
    "wabe", "aushoehlung"]), str))
    return write("Nein, dorthin zu kriechen bringt wenig.\n") ,1;
  write(bs("Mit dem Kopf voran kriechst du in eine der Waben. Zum Glueck"
    "bist du kein Klaustrophobiker, oder etwa doch ?\n "));
  if (welche_wabe>74) TP->move(ROOM("wabe_leer"), M_GO );
  if (welche_wabe<75) TP->move(ROOM("wabe_belegt"), M_GO );
}



