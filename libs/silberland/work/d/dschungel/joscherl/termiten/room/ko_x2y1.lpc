/////////////////////////
// Kokons/Suedende
/////////////////////////

#include "../define.h"
#include <properties.h>
#include <language.h>

inherit ROOM("inh_kokons.lpc");

create()
{
     ::create();

  SetProp( P_INT_LONG, 
    "Hier ist das Gewoelbe zu Ende und wird im Sueden durch eine Wand "
    "abgeschlossen. In den anderen Richtungen siehst Du Reihen der schwarzen "
    "kokonartige Objekte, die in voellig praezisen, geradezu geometrischen "
    "Abstaenden angeordnet wurden. Kein Laut ist zu vernehmen, du kannst auch "
    "keine Bewegungen erkennen, die auf Termiten hindeuten wuerden. Du "
    "glaubst jedoch, an der nachtschwarzen Wand das Glitzern von "
    "Facettenaugen sehen zu koennen.  ");

  AddDetail(({"sueden", "ende"}),
    "Das Gewoelbe wird hier durch das massive, mit Baumstaemmen "
    "verstaerkte Erdreich begrenzt. ");

  AddDetail( ({"wand", "waende"}),
    "Im Sueden beginnt das massive, durch Baumstaemme verstaerkte Erdreich. "
    "Hier wird das Gefuehl beobachtet zu werden, besonders stark.");

  AddExit("norden", ROOM("ko_x2y2"));
  AddExit("osten", ROOM("ko_x3y1"));
  AddExit("westen", ROOM("ko_x1y1"));


}
