string extra_look() 
{
  if(verw_status>0&&verw_status!=22)
    return BS("Irgendetwas Seltsames geht mit "+TPN+
      " vor. Er scheint grosse Schmerzen zu haben, und hat etwas an sich, "
      "das dich eigenartigerweise an ein Insekt erinnert.\n");
  if(verw_status==22)
    return BS("Du erschrickst, als Du bei naeherem Hinsehen in dem "
      "ebenso haesslichen wie riesigen Insekt "+TPN+
      " wiedererkennst. " +(oldgender==1)?"Er ":"Sie "+
      "besitzt drei Paar lange duenne "
      "Gliedmassen, einen durch irgendeine harte Substanz gepanzerten "
      "Rumpf und einen nach hinten fliehenden Schaedel mit grossen "
      "Facettenaugen. Zwei maechtige scherenfoermige Werkzeuge floessen "
      "Dir nicht nur Ekel, sondern auch Angst ein.\n");
  else return "";
}


