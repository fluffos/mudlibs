//////////////////////////////////////////////////////////////////////
//
// Die durch -debug-scroll allseits bekannte neurotermitis :)
// 
// Verwandelt den Spieler in eine Termite 
//
// Joscherl@Silberland
//
//////////////////////////////////////////////////////////////////////


inherit "std/thing";

#include "../define.h"
#include <living.h>
#include <properties.h>
#include <moving.h>
#include <wizlevels.h>
#include <new_skills.h>

#define termarten ({"zwergentermite", "hobbittermite", "menschentermite", \
  "dunkelelfentermite","elfentermite","ogertermite","trolltermite"})
#define termitenfeind ((find_living(termarten[i])->PresentEnemies())[feind_nr])

object opfer; //fuer TP, damits auch bei heartbeat und abhaengigen funkt.
int zaehler; //Index des kontinuierlichen Attributaenderns
int ertrink_status; //Index fuer das Ertrinken in TT_WATER, TT_UNDERWATER
int verw_status; //Index der Verwandlung
int stopped_at_call_out;//wo stehengeblieben bei NetDead ?
string oldtitle, old_guild_title, oldrace, oldpresay; //
int oldsize, oldmaxhands, oldbody, oldgender;// urspruengliche Properties
mixed oldhands;//
mixed *x_mods; //speichern der X_ATTR_MOD bei "ende" oder Reboot
 
create(string *spielerspells)
{
  ::create();
  if(!is_clone(TO))return;

  x_mods=([]);
  spielerspells=m_indices(TP->QueryProp(P_NEWSKILLS));

  SetProp(P_NAME, 0);
  SetProp(P_SHORT, 0);
  SetProp(P_NEVERDROP, 1);
  SetProp(P_NODROP, 1);
  SetProp(P_AUTOLOADOBJ, 1);
  SetProp(P_WEIGHT, 0);
  SetProp(P_X_ATTR_MOD);


  AddId("\ntermitis");

  AddCmd("retour", "rueckverwandlung");
  AddCmd(spielerspells, "spellfilter");
  AddCmd(({"schau", "schaue", "unt", "untersuche"}), "visual");
  AddCmd(({":",";"}), "emotify", 1);
  AddCmd(({"trage", "ziehe", "zieh", "zuecke", "zueck"}), "neinnein");
  set_heart_beat(1);
  verw_status=0;
}

init() {
  opfer=TP;
  query_old_props();

  if (TO&&!present("\ntermitis 2", MENV)
    && interactive(MENV)
      && !IS_WIZARD(opfer))
    {
     if (member_array("neuro:"+TPN+".o", get_dir(OBJ("*.o")))==-1)
       {
        call_out("verw1", 15+random(15));
        save_object(OBJ("neuro:"+TPN));
       } 
     else
       {
        restore_object(OBJ("neuro:"+TPN));

        if (verw_status!=22) 
          call_out("verw1",15+random(15));
        else 
          verw22();
       }
    }
  else remove();
  ::init();
}

verw1() {
  ++verw_status;
  say(TPN+ " kratzt sich.\n");
  write("\nDu kratzt Dich an Deinen Armen und Beinen.\n"
    "Deine Haut juckt ein wenig. Diese Termitensaeure ist "
    "wirklich laestig.\n");
  TP->SetProp(P_FROG,0);
  TP->SetProp(P_GHOST,0); 
  call_out("verw2", 15+random(15));
}

verw2() {
  ++verw_status;
  say(TPN+ " kratzt sich nervoes an Armen und Beinen.\n");
  TP->command_me("denke Ahh, das Jucken ist laestig!");
  write("\nDu kratzt Dich nervoes.\nDeine Haut fuehlt sich "
    "irgendwie gespannt an..\n");
  call_out("verw3", 15+random(15));
  attraendern();
}

verw3() {
  ++verw_status;
  say(TPN+ " streckt sich knackend.\n");
  write("\nDu streckst Dich.. *knack*.\nDeine Glieder schmerzen "
    "ein wenig. Vielleicht brauchst du "
    "einfach eine Pause nach all den anstrengenden Abenteuern.\n");
  call_out("verw4", 15+random(15));
}

verw4() {
  ++verw_status;
  TP->command_me("argl /schmerzerfuellt");
  TP->command_me("denk Warum tut mir meine verfluchten Glieder "
    "so weh?");
  call_out("verw5", 15+random(15));
  attraendern();
}

verw5() {
  ++verw_status;
  TP->command_me("stoehne");
  write("\nDie Schmerzen werden immer schlimmer und schlimmer.\n"
    "Irgendetwas stimmt ueberhaupt nicht mit Dir.\n");  
  call_out("verw6", 15+random(15));
}

verw6() {
  ++verw_status;
  TP->command_me("stoehne /laut");
  write("\nDu baeumst Dich auf. Die Schmerzen sind unertraeglich.\n"
    "Da ist noch etwas ... DEINE HAENDE ...\n");  
  call_out("verw7", 15+random(15));
  attraendern();
}

verw7() {
  ++verw_status;
  TP->command_me("schreie /vor Schmerz");
  write("\nAls Du auf Deine Haende siehst, merkst Du, dass das Fleisch "
    "in faulenden Fetzen von Deinen Fingern faellt und die Knochen "
    "langsam zusammenwachsen.\n");  
  if(TP->QueryProp(P_WEAPON) != 0) {
    write("Du kannst die Waffe nicht mehr halten !!!\n");
    TP->command_me("lass waffen fallen");} 
  call_out("verw8", 15+random(15));
}

verw8() {
  ++verw_status;
  write("\nAn der Stelle, an der frueher Deine Haende waren, erblickst "
    "Du messerscharfe scherenfoermige Klauen.\n");
  call_out("verw9", 15+random(15));
  call_out("handschuhe_ausziehen", 0);
  attraendern();
}

verw9() {
  ++verw_status;
  TP->command_me("erschrecke");
  write("\nDeine Haut beginnt langsam zu verhornen und verkrusten, "
    "dicke, borstige Haare brechen durch ihre krankhaft "
    "vergroesserten Poren.\n.");
  call_out("verw10", 15+random(15));
}

verw10() {
  ++verw_status;
  TP->command_me("panik");
  write("\nAuch deine B E I N E .... du kannst kaum noch das "
    "Gleichgewicht halten, als sich die Knochen deiner Fuesse "
    "unter grauenvollen Schmerzen zu deformieren beginnen.\n");
  call_out("verw11", 15+random(15));
  call_out("schuhe_ausziehen", 0);
  attraendern();
}

verw11() {
  ++verw_status;
  TP->command_me("taumel");
  write("\nDu wankst taumelnd herum und faellst schliesslich zu "
     "Boden.\n");
  call_out("verw12", 15+random(15));
}

verw12() {
  ++verw_status;
  TP->command_me("stoehne");
  write("\nDu windest Dich unter unsaeglichen Schmerzen am Boden. "
    "Ungefaehr zwischen Deinem dritten und vierten Rippenbogen "
    "sowie etwas ueber Deiner Huefte beginnt sich die verhornte "
    "Haut an beiden Seiten herauszuwoelben.\n");
  call_out("verw13", 15+random(15));
  attraendern();
}

verw13() {
  ++verw_status;
  write("\nDuenne, zittrige Gliedmassen brechen durch das aus "
    "Deiner Haut entstandene Exoskelett. Hilflos und panisch "
    "musst Du zusehen, wie aus deinem Koerper, "
    "der einmal jener eines "+ TP->QueryProp(P_RACE) + 
    "s gewesen war, ein abscheuliches insektoides Etwas wird.\n");
  call_out("verw14", 15+random(15));
}

verw14() {
  ++verw_status;
  call_out("rest_ausziehen", 0);
  write("\nDie Verwandlung tritt in ihr letzes Stadium. Intuitiv "
    "versuchst Du, Deine nunmehr 6 Gliedmassen zu bewegen, "
    "als Du bemerkst, dass Du auf dem Ruecken liegst und es "
    "gar nicht so leicht ist, sich wieder herumzudrehen.\n");
  call_out("verw15", 15+random(15));
  attraendern();
}

verw15() {
  ++verw_status;
  write("\nAls du Dich wieder aufgerichtet hast, erkennst Du das "
    "volle Ausmass der Verwandlung. Anstelle von Haenden besitzt "
    "Du nun zwei furchterregende saebelfoermige Klauen. Dein "
    "Koerper stuetzt sich auf drei Paar lange, duenne, aber "
    "dennoch kraftvolle Gliedmassen.\n");
  call_out("verw16", 15+random(15));
}

verw16() {
  ++verw_status;
  write("\nDeine Haut hat sich endgueltig zu einer extrem harten, "
    "gepanzerten Schicht umgewandelt, die Deinen Rumpf und "
    "Deine sechs Gliedmassen ueberzieht.\nAls du versuchst, "
    "Dir den Schweiss von der Stirn zu wischen, erschrickst Du "
    "ein weiteres Mal. Auch dein Kopf hat sich fast bis zur "
    "Unkenntlichkeit veraendert.\n");
  call_out("verw17", 15+random(15));
  attraendern();
}

verw17() {
  ++verw_status;
  write("\nDein Kopf sitzt nunmehr auf einem extrem duennen "
    "Hals, deine Stirn flieht nach hinten und geht in einen "
    "harten schildfoermigen Nackenschutz ueber. Anstelle "
    "Deines Mundes findest du eine ebenso grosse wie "
    "abstossende Oeffnung, um die sich riesige Kiefer "
    "und Schneidwerkzeuge schliessen.\n");
  call_out("verw18", 15+random(15));
}

verw18() {
  ++verw_status;
  write("\nDeine Sinneswahrnehmungen veraendern sich "
    "zusehends. Du siehst viel schlechter, dafuer scheint Dein "
    "Geruchssinn immer schaerfer zu werden.\nIrgendwie fuehlst "
    "Du dich gar nicht so unwohl in deiner neuen Gestalt "
    "... fast als waerst du nun endlich deiner Berufung gefolgt.\n ");
  call_out("verw19", 15+random(15));
  attraendern();
}

verw19() {
  ++verw_status;
  write("\nDu erkennst, dass es immer schon Dein Wunsch war, zu "
    "dienen ... Dem Termitenstaat zu dienen ... Du erschauerst "
    "vor Ehrfurcht ... eine tiefe Stimme in deinem Kopf ruft "
    "Dich zu sich ...\n  ");
  call_out("verw20", 5+random(15));
}

verw20() {
  ++verw_status;
  write("\n          TERMITE, DIE DU EINST "+TPN+ " WARST!!\n"
    "               KOMM ZU MIR! \n"
    "               KOMM ZU M'BAAN !\n");
  call_out("verw21", 15+random(15));
  attraendern();
}

verw21() {
  ++verw_status;
  write("\nDie Verwandlung ist abgeschlossen. Du fuehlst Dich "
    "gluecklich, geborgen, zufrieden. Du gehoerst dem Staat, der "
    "Gemeinschaft ... Du beschliesst, dich auf die Suche nach "
    "Deinem Herrn, M'Baan, zu machen.\n ");
  call_out("verw22", 15+random(15));
}

verw22(){
  opfer=TP;
  verw_status=22;
  TP->SetProp(P_RACE, "Termite");
  TP->SetProp(P_TITLE, "\b-Termite, Geschoepf des M'baan");
  TP->SetProp(P_GUILD_TITLE, "die Kreatur");
  TP->SetProp(P_SIZE, 150+random(30));
  TP->SetProp(P_MAX_HANDS, 6);
  TP->SetProp(P_HANDS, 
    ({"mit messerscharfen Termitenscheren",20+random(10),DT_RIP }));
  TP->SetProp(P_PRESAY, "Eine");
  TP->SetProp(P_PERM_STRING, TO);
  attraendern();
  if (m_sizeof(x_mods)==0) x_mods=TO->QueryProp(P_X_ATTR_MOD);
  if (m_sizeof(x_mods)!=0) SetProp(P_X_ATTR_MOD, x_mods);
  save_object(OBJ("neuro:"+TPN));  
}

int attraendern (mapping mods) {
  ++zaehler; 
  mods=TO->QueryProp(P_X_ATTR_MOD);
  if ((TP->QueryAttribute(A_INT))>6)
    mods[A_INT]=-zaehler*2;
  if ((TP->QueryAttribute(A_STR))>15)
    mods[A_STR]=-zaehler*2;
  if ((TP->QueryAttribute(A_DEX))>20)
    mods[A_DEX]=-zaehler*2;
  if ((TP->QueryAttribute(A_CON))>15)
    mods[A_CON]=-zaehler*2;
  SetProp(P_X_ATTR_MOD, mods);
}

query_old_props() {

  oldtitle = TP->QueryProp(P_TITLE);
  old_guild_title = TP->QueryProp(P_GUILD_TITLE);
  oldrace = TP->QueryProp(P_RACE);
  oldsize = TP->QueryProp(P_SIZE);
  oldmaxhands = TP->QueryProp(P_MAX_HANDS);
  oldbody = TP->QueryProp(P_BODY);
  oldgender = TP->QueryProp(P_GENDER);
  oldhands = TP->QueryProp(P_HANDS);
  oldpresay = TP->QueryProp(P_PRESAY);
}

void rueckverwandlung(){
  TP->SetProp(P_TITLE, oldtitle);
  TP->SetProp(P_PRESAY, oldpresay);
  TP->SetProp(P_GUILD_TITLE, old_guild_title);
  TP->SetProp(P_RACE, oldrace);
  TP->SetProp(P_SIZE, oldsize);
  TP->SetProp(P_MAX_HANDS, oldmaxhands);
  TP->SetProp(P_GENDER, oldgender);
  TP->SetProp(P_HANDS, oldhands);
  SetProp (P_X_ATTR_MOD, ([ A_INT:0, A_STR:0, A_DEX:0, A_CON:0]) );
}

void schuhe_ausziehen(){
  object *klumpert;
  int i;

  for(i=sizeof(klumpert=all_inventory(TP))-1; i>=0; i--)
  {
    if((klumpert[i]->QueryProp(P_ARMOUR_TYPE) == AT_BOOT) && 
       (klumpert[i]->QueryProp(P_WORN) != 0) )
       {
        write(BS("Die hornigen Gliedmassen, in die sich deine "
          "Fuesse verwandelt haben, lassen "
          +klumpert[i]->name(WEN,1)+" in Fetzen zerbersten. ") );
        klumpert[i]->remove();
       } 
  }     
}

void handschuhe_ausziehen(){
  object *klumpert;
  int i;

  for(i=sizeof(klumpert=all_inventory(TP))-1; i>=0; i--)
  {
    if((klumpert[i]->QueryProp(P_ARMOUR_TYPE) == AT_GLOVE) && 
       (klumpert[i]->QueryProp(P_WORN) != 0) )
       {
        write(BS("Die Klauen, zu denen deinen Haende geworden "
          "sind, bohren sich durch "
          +klumpert[i]->name(WEN,1)+" und zerstoeren diese. ") );
        klumpert[i]->remove();
       } 
  }     
}

void rest_ausziehen(){
  object *klumpert;
  int i;
  for(i=sizeof(klumpert=all_inventory(TP))-1; i>=0; i--)
  {
    if((klumpert[i]->QueryProp(P_ARMOUR_TYPE) != 0) && 
       (klumpert[i]->QueryProp(P_WORN) != 0) )
       {
     	if (i==0) write(BS(
          "Die letzten Reste Deiner Ruestung brechen von "
          "Deinem Insektenkoerper und fallen in Stuecken auf den "
          "Boden.\n"));
        klumpert[i]->remove();
       } 
  }  
}

string kampfmeldungen_feind(int treffer){
  switch (treffer) {
    case 0: return "verfehlt Dich.\n"; break;
    case 1: return "kitzelt Dich.\n"; break;
    case 2..3: return "kratzt Dich.\n"; break;
    case 4..5: return "trifft Dich.\n"; break;
    case 6..10: return "trifft Dich hart.\n"; break;
    case 11..15: return "trifft Dich sehr hart.\n"; break;
  }

}

string kampfmeldungen_opfer1(int treffer){
  switch (treffer) {
    case 0: return "verfehlst "; break;
    case 1: return "kitzelst "; break;
    case 2..3: return "kratzt "; break;
    case 4..15: return "triffst "; break;
  }

}

string kampfmeldungen_opfer2(int treffer){
  switch (treffer) {
    case 0..5: return ".\n"; break;
    case 6..10: return " hart.\n"; break;
    case 11..15: return " sehr hart.\n"; break;
  }

}

heart_beat() {
  termiten_helfen();
  umgebungs_reaktionen();
  //  tell_object(find_living("joscherl"),
  //    "Verw: "+verw_status+"\n"  );
}

termiten_helfen (int i, int feind_nr, int treffer) {
//  tell_object(find_living("joscherl"), "termiten_helfen gestartet!\n");
  for(i=6; i>=0; i--) 
    {
     if (ENV(TO)&&find_living(termarten[i]) &&
        (present(find_living(termarten[i]), ENV(MENV))) && 
        (find_living(termarten[i])->InFight()))
       {
        treffer=random(16);
        feind_nr=random(sizeof(find_living(termarten[i])->PresentEnemies()));

        termitenfeind->AddHp(-treffer);
        tell_object(termitenfeind, 
          "Die "+UPPER(opfer->name())+"-Termite schuetzt die "
          +capitalize(termarten[i])+" und greift mit ihren Scheren an!\n"+
          "Die "+UPPER(opfer->name())+"-Termite "
          +funcall(#'kampfmeldungen_feind, treffer));
        tell_object(opfer, 
          "Irgendetwas zwingt Dich, Deine Artgenossin vor "+
          UPPER(termitenfeind->name())+" zu beschuetzen. Du greifst an.\n"
          "  Du "+funcall(#'kampfmeldungen_opfer1, treffer)+
          UPPER(termitenfeind->name())+
          funcall(#'kampfmeldungen_opfer2, treffer));
       }
    }
}

BecomesNetDead(int i, string verwstadium) {
  set_heart_beat(0);

  for(i=22;i>0;i--)
    {
     verwstadium="verw"+i;
     if (find_call_out(verwstadium)!=-1)
       {
        stopped_at_call_out=verwstadium;       
        remove_call_out(verwstadium);
       }
    }
}
 
BecomesNetAlive(int i, string verwstadium, int gefunden) {
  set_heart_beat(1);

  tell_object(opfer, "Du wachst aus einem Alptraum auf, der von unzaehligen "
    "Insekten handelte. Jedoch wird Dir ziemlich schnell bewusst, dass die "
    "Realitaet nicht viel schoener ist...\n");

  for(i=22;i>0;i--)
    {
     verwstadium="verw"+i;
     if (find_call_out(verwstadium)!=-1)
       return;
     if ((find_call_out(verwstadium)==-1)&&gefunden!=1)
       {
        call_out(stopped_at_call_out, 5);
        gefunden=1;
       }
    }
}


NotifyPlayerDeath(int i, string verwstadium) {
  tell_object(opfer, "Endlich erloest Dich der Tod von Deinen insektoiden "
  "Qualen! Du bist geradezu erleichtert und wartest gluecklich auf Lars...\n");
  set_heart_beat(0);
  for(i=22;i>0;i--)
    {
     verwstadium="verw"+i;
     if (find_call_out(verwstadium)!=-1)    
       remove_call_out(verwstadium);
    }
  rueckverwandlung();
  rm(OBJ("neuro-"+TPN));
  ME->remove();
}
  
int spellfilter() {
  if((TP->QueryProp(P_RACE)=="Termite")&&!random(10)) 
    {
    tell_object(TP, "Mit unendlicher Muehe gelingt es Dir, dich daran zu "
      "erinnern, wie der Spruch funktioniert.\n");
    return 0;
    } 
  tell_object(TP, "Hilflos fuchtelst du mit deinen scherenfoermigen "
      "Extremitaeten ... Du beherrscht den Spell einfach nicht mehr...\n");
  return 1;
}

int visual(string str, int i) {
  if ((TP->QueryProp(P_GUILD_TITLE))!="die Kreatur"){
    tell_object(find_living("joscherl"), "TEST verhaut \n"); return 0;}

  switch (random(100))
  {
    case 0..20:
      tell_object(TP, "\nDeine Facettenaugen koennen sich im Moment nicht "
      "an die Umgebung anpassen.\nDu siehst nur ein rotes Flimmern.\n");
      return 1; 
    case 21..50: 
      tell_object(TP, "\nDurch Deine Facettenaugen erkennst Du Deine "
      "Umgebung nur in einem sehr verschwommenenen roten Licht.\n"/*+
      "\e[41m\e[33m"*/);      
      return 0;
    case 51..99:
      tell_object(TP, "\nDu erkennst durch Deine Facettenaugen folgendes:\n"/*+
      "\e[30m\e[41m"*/); 
      return 0;
  }
}

// void color_normal(){tell_object(TP, "\e[0m");return 0;}


string permutate_string(string str, int i){

  string *zerlegt, *geraeusche, infix, ausgabe;

  geraeusche=({" *schneid* "," *kratz* "," *schab* "," *beiss* ",
    " *schnipp-schnapp* ", " *giftsprueh* "," *gladstone_auslach* " });

  zerlegt=explode(str, " ");
  ausgabe="";

  for (i=0; i<=(sizeof(zerlegt)-1); i++)
    {
    if (!random(2)) infix=geraeusche[random(sizeof(geraeusche))];
    else infix=" ";
    ausgabe=ausgabe+zerlegt[i]+infix;
    }
return ausgabe;
}

int emotify (string str) {
  say(
    "Die "+TPN+"-Termite versucht, irgendwas mit \""+query_verb()[1..]+
    " "+str+"\" zu "+(query_verb()[0..0]==":"?"emoten":"gemoten")+
    ". Absolut ekelhaft!\n");
  tell_object(TP, "Du versuchst, \""+query_verb()[1..]+" "+str+"\" zu "+
    (query_verb()[0..0]==":"?"emoten":"gemoten")+". Hoer lieber auf "+
    "damit, den Leuten hier ekelt vor Deinem Insektengefuchtel!\n");
  return 1;
}


umgebungs_reaktionen(int umgebung) {
  umgebung=(ENV(MENV)->QueryProp(P_ENVIRONMENT))[ENV_TERRAIN];
  if (umgebung==12 || umgebung==13) ertrinken();
  if (umgebung!=12 && umgebung!=13) ertrink_status=0;
  if (!random(50))
    {
    switch (umgebung)
      {
      case 4: //TT_FOREST 
        tell_room(ENV(MENV),
          "Die "+UPPER(opfer->name())+"-Termite sucht in diesem Wald nach "
          "Baeumen zum Umschneiden.\n", ({opfer}));
        tell_object(opfer, 
          "Du fragst Dich, ob Du hier nicht einen Baum umschneiden "
          "solltest.\n"); 
        break;
      case 5: //TT_TOWN
        tell_room(ENV(MENV),
          "Die "+UPPER(opfer->name())+"-Termite sucht in dieser Stadt "
          "verzweifelt nach Baeumen zum umschneiden.\n", ({opfer}));
        tell_object(opfer,"Du denkst . o O(Hoffentlich gibts in dieser "
          "Stadt ein paar Baeume zum umschneiden!)\n"); 
        break;
      case 8: //TT_JUNGLE
        opfer->command_me("sag Ich liebe meine Heimat, den Dschungel!");
        break;
      case 9: //TT_SWAMP
        tell_room(ENV(MENV),
          "Die "+UPPER(opfer->name())+"-Termite stochert im Sumpf nach "
          "kleinen Insekten.\n", ({opfer}));
        tell_object(opfer,
          "Du stocherst im Sumpf nach kleinen Insekten.\n");
        break;
      case 14: //TT_ROAD
        opfer->command_me("sag Bald wird auch diese Strasse eine "
          "Termitenstrasse werden!");
        break;
      case 7: //TT_DESERT
        tell_room(ENV(MENV),
          "Die "+UPPER(opfer->name())+"-Termite graebt im Wuestensand nach "
          "Nahrung.\n", ({opfer}));
        tell_object(opfer,
          "Du versuchst, im Wuestensand nach Nahrung zu "
          "graben. Vielleicht findest du ein paar koestliche "
          "Larven.\n"); 
        break;
      case 2: //TT_HOUSE
        tell_room(ENV(MENV),
          "Die "+UPPER(opfer->name())+"-Termite kratzt mit ihren Scheren "
          "an den Waenden dieser Behausung.\n", ({opfer}));
        tell_object(opfer,
          "Du kratzt mit Deinen Termitenscheren an den "
          "Waenden dieses Hauses herum.\n"); 
        break;
      }
    }      
}

ertrinken() { 
  ++ertrink_status;

  switch(ertrink_status) 
    {
    case 1:
      TO->SetProp(P_KILL_MSG,
        "Ich bin gelungen!");
      TO->SetProp(P_KILL_NAME, "Ein Test");    
      tell_object(opfer, "\nWASSER!!!! Du realisierst sehr schnell, "
        "dass du ungefaehr so gut schwimmst wie ein Stein.\n");
      opfer->do_damage((opfer->QueryProp(P_HP))/7); break;
    case 3:
      tell_object(opfer, "\nSchnell, verschwinde *schluck* von hier!\n");
      opfer->do_damage((opfer->QueryProp(P_HP))/6); break;
    case 5:
      tell_object(opfer, "\nRAUS HIER!! Du stirbst sonst!!!\n");
      opfer->do_damage((opfer->QueryProp(P_HP))/5); break;
    case 7:
      tell_object(opfer, "\nNaja, machs Dir gemuetlich. Was sind schon "
        "die paar XP...\n");
      opfer->do_damage((opfer->QueryProp(P_HP))/4); break;
    case 9: 
      tell_object(opfer, "\nLETZE CHANCE: SUCH EINEN AUSGANG !!!\n");
      opfer->do_damage((opfer->QueryProp(P_HP))/3); break;
    case 11: 
      tell_object(opfer, "\n*gaehn*... du hast noch 4 Sekunden ...\n");
      opfer->do_damage((opfer->QueryProp(P_HP))/2); break;
    case 13:
      tell_object(opfer, "\nDas wars dann. Du ersaeufst.\n");
      opfer->die();
      TO->SetProp(P_KILL_MSG, "");
      TO->SetProp(P_KILL_NAME, "");
      break;
      }
}

int neinnein(string str) {
  string ruestung, waffe;
  if ((query_verb()=="ziehe"||"zieh")&&sscanf(str, "%s an", ruestung)==1)
    {write ("Dein Versuch scheitert klaeglich. Diese Ruestung ist wohl "
      "nicht fuer Termiten gedacht.\n");return 1;}
  if ((query_verb()=="trage")&&sscanf(str, "%s", ruestung)==1)
    {write ("Dein Versuch scheitert klaeglich. Diese Ruestung ist wohl "
      "nicht fuer Termiten gedacht.\n");return 1;}
  if ((query_verb()=="zuecke"||"zueck")&&sscanf(str, "%s", waffe)==1)
    {write ("Mit einer Waffe kaempfen? Dazu bist du im Moment "
      "wohl zu bloed.\n");return 1;}
}
