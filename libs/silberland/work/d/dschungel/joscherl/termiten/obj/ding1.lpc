inherit "std/thing";


#include "../define.h"
#include <living.h>
#include <properties.h>
#include <moving.h>
#include <wizlevels.h>
#include <new_skills.h>



create(string *spielerspells)
{
  ::create();
  if(!is_clone(TO))return;

  SetProp(P_NAME, "Dummyding");
  SetProp(P_SHORT, "Ein Dummygegenstand");
  SetProp(P_NEVERDROP, 0);
  SetProp(P_NODROP, 1);
  SetProp(P_WEIGHT, 1000);

  AddId("dummyding", "gegenstand");


}
