inherit "std/food";

#include "../def.h"
#include <food.h>

#define sorten \
  (["Finger":1, \
    "Zehe":2,\
    "Nase":2,\
    "Ohr":0, \
    "Ripperl":0])


void create(string sorte)
{
  if (!is_clone(this_object())) return;
  ::create();

  sorte=m_indices(sorten)[random(sizeof(m_indices(sorten)))];

  SetProp(P_NAME, sorte);
  SetProp(P_GENDER, sorten[sorte]);
  SetProp(P_SHORT, (sorten[sorte]==2?"Eine ":"Ein ")+sorte+" einer Leiche");
  SetProp(P_INFO, "In der Not frisst der Teufel Fliegen.\n");
  SetProp(P_LONG,
      "Ein"+(sorten[sorte]==2?"e ":" ")+sorte+" einer Leiche. Etwas stinkend, "
      "aber nicht allzu verfault.\n");

  AddId(({LOWER(sorte), "leichenfood"}));
  SetProp(P_WEIGHT, 100+random(200));
  SetProp(P_VALUE, 50);
  SetProp(P_FOOD_INFO, ([
        F_HEAL : ({15, 0}), 
        F_SOAK : 15, 
        F_MSG:"Du beisst herzhaft in "+TO->name(WEN, 1)+". Schmeckt ein "
              "bischen wie beim Chinesen.\n", 
        F_MSG_ROOM:"kaut an "+TO->name(WEM, 0)+". Ekelhaft.\n"]));
}


