
#include "../def.h"

inherit "std/armour";

#include <properties.h>
#include <combat.h>

void create() 
{
  if( !is_clone(TO) ) return;
  ::create();

  SetProp(P_SHORT, "Ein schwarzer Rosenritterschild");
  SetProp(P_LONG,
    "Dieser Stahlschild zeigt das finstere Emblem der schwarzen Rose. Solche "
    "Schild werden normalerweise von den finsteren gefallenen Paladinen der "
    "schwarzen Rose getragen." );
  SetProp(P_INFO, BS("Von diesem Schild geht eine boesartige Aura aus. Er macht seine Traeger boesartiger und gemeiner.") );
  SetProp(P_NAME, "Rosenritterschild");
  SetProp(P_GENDER, MALE);
  AddId( ({"schild", "rosenritterschild", "rosenschild"}) );

  SetProp(P_ARMOUR_TYPE, AT_SHIELD );
  SetProp(P_AC, 26);
  SetProp(P_MATERIAL, ([ MAT_STEEL:80, MAT_MISC_UNHOLY: 20]) );
  SetProp(P_WEIGHT, 3000);
  SetProp(P_VALUE, 2500);
  SetProp(P_NOBUY, 1);
  SetProp(P_QUALITY_DECAY, 110);

  SetProp(P_DEFEND_FUNC, TO );
}

int DefendFunc (mixed dam_type, int spell, object enemy) {
  if(!random(50)) {
    tell_object(QueryProp(P_WORN), BS("Der Rosenritterschild schuert deinen Hass und deine Wut. Du fuehlst dich boesartiger und gemeiner."));
    QueryProp(P_WORN)->SetProp(P_ALIGN, QueryProp(P_WORN)->QueryProp(P_ALIGN) - 5 - random(25));
  }

  if(!random(33)) {
    tell_object(QueryProp(P_WORN), BS("Der Rosenritterschild leuchtet duester auf und laesst "+enemy->name(WEN)+" vor Furcht erstarren!"));
    enemy->SetProp(P_DISABLE_ATTACK, 1);
  }

  return 0;
}
