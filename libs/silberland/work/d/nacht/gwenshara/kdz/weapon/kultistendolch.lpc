
#include "../def.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>

void create() 
{
  if (!is_clone(TO) )  return;
  ::create();

  SetProp(P_SHORT, "Ein Kultistendolch");
  SetProp(P_LONG,
    "Der Kultistendolch hat eine gewellte Klinge, die sich besonders eignet, um damit "
    "Opfern ihr Herz zu durchbohren. So eine Klinge wird normalerweise von finsteren "
    "Priestern und Kultisten genutzt." );
  SetProp(P_NAME, "Kultistendolch");
  SetProp(P_GENDER, MALE);
  AddId( ({"dolch", "kultistendolch"}) );

  SetProp(P_WEAPON_TYPE, WT_KNIFE );
  SetProp(P_WC, 99);
  SetProp(P_WC_FIX, 35 );
  SetProp(P_DAM_TYPE, DT_PIERCE );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, MAT_STEEL );
  SetProp(P_WEIGHT, 200);
  SetProp(P_SIZE, 30);
  SetProp(P_VALUE, 800);
  SetProp(P_NOBUY, 0);
  SetProp(P_QUALITY_DECAY, 100);

  SetProp(P_WC_BONUS, (["\nkdz_cult_npc": 200]) );
}
