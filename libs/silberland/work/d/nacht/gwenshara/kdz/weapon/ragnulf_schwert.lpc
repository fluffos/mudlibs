
#include "../def.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>

void create() 
{
  if (!is_clone(TO) )  return;
  ::create();

  SetProp(P_SHORT, "Ein echnidischer Bihaender");
  SetProp(P_LONG,
    "Dieser Bihaender sieht maechtig und brutal aus. Seine Klinge ist gezackt "
    "und schwarz. Ein schleimig-oeliger scheint auf dieser Waffe zu kleben. Der "
    "Griff ist aus dunklem Leder aus pockiger Menschenhaut. Diese Waffe ist eindeutig "
    "sehr, sehr uebel." );
  SetProp(P_INFO, "Dieser Bihaender ist von der mutierenden Kraft der Monstermutter durchdrungen.");
  SetProp(P_NAME, "Bihaender");
  SetProp(P_GENDER, MALE);
  AddId( ({"bihaender", "schwert", "zweihaender"}) );

  SetProp(P_WEAPON_TYPE, WT_SWORD );
  SetProp(P_WC, 266);
  SetProp(P_WC_FIX, 45 );
  SetProp(P_DAM_TYPE, ({DT_RIP, DT_SLASH, DT_UNHOLY}) );
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL, ([MAT_STEEL: 80, MAT_MISC_UNHOLY: 10, MAT_LEATHER: 10]) );
  SetProp(P_WEIGHT, 3500);
  SetProp(P_SIZE, 220);
  SetProp(P_VALUE, 8000);
  SetProp(P_NOBUY, 1);
  SetProp(P_QUALITY_DECAY, 100);
  
  SetProp(P_WIELD_FUNC, TO );
  SetProp(P_UNWIELD_FUNC, TO );
  SetProp(P_HIT_FUNC, TO );

  SetProp(P_WC_BONUS, (["\nkdz_ragnulf": 100]) );
  SetProp(P_WIELD_RESTRICTIONS, ([A_STR: 24]) );
}

int WieldFunc(object waffe) {
  object mutation;

  if(!random(3)) {
    mutation = clone_object(OBJ "mutation");
    if(mutation->move(TP, M_NOCHECK) != 1) {
      destruct(mutation);
    }
  }

  return 1;
}

int UnwieldFunc(object waffe) {
    object mutation;

    if(!random(3)) {
      mutation = clone_object(OBJ "mutation");
      if(mutation->move(TP, M_NOCHECK) != 1) {
        destruct(mutation);
      }
    }
  
    return 1;
}

int HitFunc( object enemy ) {
  object wielder, mutation;
  int bonusMultiplier;

  wielder = QueryProp(P_WIELDED);
  if(!objectp(wielder)) return 0;

  bonusMultiplier = 1;

  if(!random(10)) {
    mutation = clone_object(OBJ "mutation");
    if(mutation->move(enemy, M_NOCHECK) != 1) {
      destruct(mutation);
    }

    tell_room(environment(enemy), BS("Nach dem Treffer des Bihaenders von "+wielder->Name(WEM)+", spriessen "
      "ploetzlich widerliche Mutationen aus "+enemy->Name(WEM)+" hervor!"), ({wielder, enemy}) );
    tell_object(wielder, BS("Nach deinem Treffer mit dem Bihaender, spriessen ploetzlich widerliche Mutationen "
        "aus "+enemy->Name(WEM)+" hervor!") );
    tell_object(enemy, BS("Nach dem Treffer des Bihaenders von "+wielder->Name(WEM)+", spriessen "
        "ploetzlich widerliche Mutationen aus deinem Koerper hervor!") );

    bonusMultiplier++;
 }

 if(!random(20)) {
    mutation = clone_object(OBJ "mutation");
    if(mutation->move(wielder, M_NOCHECK) != 1) {
      destruct(mutation);
    }

    tell_object(wielder, BS("Der dreckige, oelige Film des Bihaenders scheint in deinen Koerper zu sickern und "
        "du fuehlst dich ploetzlich sehr unwohl!") );

    bonusMultiplier++;
 }

 return bonusMultiplier * random(20);

}
