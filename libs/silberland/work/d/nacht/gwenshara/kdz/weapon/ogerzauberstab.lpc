
#include "../def.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>

void create() 
{
  if (!is_clone(TO) )  return;
  ::create();

  SetProp(P_SHORT, "Ein Ogerzauberstab");
  SetProp(P_LONG,
    "Dieser schwarze Stab besteht aus einem dicken Eichenast. Er ist mit aller Kunst der "
    "Ogerzauberer verziert und mit Runen und Symbolen versehen, die die Macht des Stabes "
    "verstaerken sollen.");
  SetProp(P_INFO, "Ogerzauberstaebe sollen die Magie ihrer Traeger verstaerken.");
  SetProp(P_NAME, "Ogerzauberstab");
  SetProp(P_GENDER, MALE);
  AddId( ({"stab", "zauberstab", "ogerzauberstab"}) );

  SetProp(P_WEAPON_TYPE, WT_SPEAR );
  SetProp(P_WC, 150);
  SetProp(P_WC_FIX, 40 );
  SetProp(P_DAM_TYPE, ({DT_BLUDGEON, DT_MAGIC}) );
  SetProp(P_NR_HANDS, 2);
  SetProp(P_MATERIAL, ([MAT_OAK: 75, MAT_MISC_MAGIC: 25]) );
  SetProp(P_WEIGHT, 2000);
  SetProp(P_SIZE, 200);
  SetProp(P_VALUE, 3333);
  SetProp(P_NOBUY, 1);
  SetProp(P_QUALITY_DECAY, 100);
  
  SetProp(P_WC_BONUS, (["ogerzauberer": 100]) );
  SetProp(P_WIELD_RESTRICTIONS, ([A_INT: 25]) );

  SetProp(P_M_HEALTH_MOD,([P_SP:random(10)]));
}
