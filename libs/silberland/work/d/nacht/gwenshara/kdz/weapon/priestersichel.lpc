
#include "../def.h"

inherit "std/weapon";

#include <properties.h>
#include <combat.h>

public void makeMagic() {
  SetProp(P_SHORT, "Eine finster glimmende Sichel");
  SetProp(P_LONG, QueryProp(P_LONG) + " Ein duesteres Leuchten, fast schwarz, geht von ihr aus.");
  SetProp(P_ITEMD_NO_MAGIC, 1);
  SetProp(P_INFO, "Diese Sichel hasst das Gute! Sie verlangt nach dem Blut der Unschuldigen.");
  SetProp(P_NAME_ADJ, "finster glimmend");
  AddAdjective( ({"glimmende", "glimmender", "glimmenden", "glimmendes", "glimmendem"}));
  SetProp(P_WC, 160);
  SetProp(P_HIT_FUNC, TO);
  SetProp(P_WIELD_RESTRICTIONS, ([A_DEX: 25, SR_SEER: 1]) );
}

void create() 
{
  if (!is_clone(TO) )  return;
  ::create();

  SetProp(P_SHORT, "Ein Kultistensichel");
  SetProp(P_LONG,
    "Diese Sichel ist ein Werkzeug des Todes. Sie ist besonders geeignet, um damit "
    "die Gliedmassen von Opfern abzutrennen. So eine Sichel wird normalerweise von finsteren "
    "Priestern und Kultisten genutzt." );
  SetProp(P_NAME, "Kultistensichel");
  SetProp(P_GENDER, MALE);
  AddId( ({"sichel", "kultistensichel"}) );

  SetProp(P_WEAPON_TYPE, WT_KNIFE );
  SetProp(P_WC, 120);
  SetProp(P_WC_FIX, 30 );
  SetProp(P_DAM_TYPE, DT_SLASH );
  SetProp(P_NR_HANDS, 1);
  SetProp(P_MATERIAL, MAT_STEEL );
  SetProp(P_WEIGHT, 200);
  SetProp(P_SIZE, 30);
  SetProp(P_VALUE, 1200);
  SetProp(P_NOBUY, 1);
  SetProp(P_QUALITY_DECAY, 100);

  SetProp(P_WC_BONUS, (["\nkdz_cult_npc": 200]) );

  if(!random(5)) {
    makeMagic();
  }
}

public int HitFunc(object enemy) {
  object wielder;
  int damMod;

  if(!objectp(wielder=QueryProp(P_WIELDED))) return 0;

  damMod = 0;
  if(enemy->QueryProp(P_ALIGN) > 0) {
    damMod += enemy->QueryProp(P_ALIGN) / 15;
    if(!random(33)) {
      tell_object(wielder, BS("Die Sichel leuchtet finster auf naehrt sich an dem Blut von "+enemy->name(WEM)+"."));
      tell_object(enemy, BS("Die Sichel leuchtet finster auf und naehrt sich an deinem Blut."));
      tell_room(environment(enemy), 
        BS("Die Sichel leuchtet finster auf und naehrt sich an " + enemy->name(WESSEN)+" Blut."),
        ({enemy, wielder}));
      wielder->AddHp(5 + random(16)); 
    }
  }

  return damMod;
}
