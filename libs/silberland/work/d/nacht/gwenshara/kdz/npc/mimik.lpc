#include "../def.h"

inherit NPC "std_cult_npc";

#include <properties.h>
#include <combat.h>
#include <moving.h>

void create()
{
  if (!is_clone(TO)) return;

  ::create();

  //--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Eine unscheinbare Holzkiste");
  SetProp(P_LONG,
    "Eine einfache Holzkiste, die in einer Ecke steht. Sie sieht alt und "
    "leicht beschädigt aus, als wäre sie seit Jahren nicht benutzt worden. "
    "Nichts an dieser Kiste deutet darauf hin, dass sie etwas Besonderes "
    "wäre... aber Vorsicht! Vielleicht steckt mehr dahinter, als es auf "
    "den ersten Blick scheint.\n");
  
  SetProp(P_NAME, "Mimik");
  SetProp(P_GENDER, NEUTER);
  AddId(({"kiste", "holzkiste", "truhe", "mimik", "NOCONTROL"}));
  AddAdjective(({"unscheinbar", "unscheinbare"}));

  SetProp(P_RACE, "Mimik");
  SetProp(P_SIZE, 100);  // Größe einer Kiste
  SetProp(P_WEIGHT, 5000);  // Gewicht in Gramm

  //--Eigenschaften----------------------------------------------------------

  create_default_npc(30); 

  SetProp(P_RESISTANCE_STRENGTHS, 
    ([DT_SLASH: 0.1, DT_BLUDGEON: -0.1, DT_PIERCE: -0.5, DT_RIP: 0.1, 
      DT_POISON: -0.5, DT_ACID: 0.2, DT_FIRE: 0.5, DT_MIND: 1.0])); 

  //--Verhalten--------------------------------------------------------------

  SetProp(P_AGGRESSIVE, 0.5);  // Greift manchmal an, aber nicht immer sofort

  //--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "scheint plötzlich da zu sein, ohne dass du bemerkt hast, wie.");
  SetProp(P_MSGOUT, "bewegt sich auf leisen Sohlen weg.");
  SetProp(P_MMSGIN, "hüpft plötzlich aus dem Schatten.");
  SetProp(P_MMSGOUT, "verwandelt sich zurück in eine harmlose Kiste.");

  //--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO, "Diese unscheinbare Kiste hat sich doch gerade bewegt!\n");

  //--Angriffe---------------------------------------------------------------

  // Angriff: Biss
  AddSpell(3, 250,
    "Die Holzkiste verwandelt sich plötzlich und schnappt nach dir mit einem riesigen Maul voller Zähne!\n",
    "Die Holzkiste verwandelt sich plötzlich und beißt @WEN mit einem riesigen Maul voller Zähne!\n",
    ({DT_RIP}),  // Verursacht Schnitt- und Giftschaden
    ([SP_SHOW_DAMAGE:1])
  );

  // Angriff: Klebrige Zunge
  AddSpell(2, 100,
    "Eine klebrige Zunge schießt aus der Kiste und wickelt sich um dich, und quetscht dich fest!\n",
    "Eine klebrige Zunge schießt aus der Kiste und wickelt sich um @WEN, und quetscht!\n",
    ({DT_SQUEEZE}),
    ([SP_SHOW_DAMAGE:1])
  );

  // Angriff: Giftspucke
  AddDefaultSpell(2, 300, DS_POISON,
    "Die Kiste öffnet sich und spuckt eine giftige Flüssigkeit auf dich!\n",
    "Die Kiste öffnet sich und spuckt eine giftige Flüssigkeit auf @WEN!\n"
  );

  AddSpell(1, 500,
    "Die Kiste oeffnet sich zu einem riesigen Maul und versucht dich zu verschlingen!\n",
    "Die Kiste oeffnet sich zu einem riesigen Maul und versucht @WEN zu verschlingen!\n",
    ({DT_RIP}),
    "swallow",
    ([SP_SHOW_DAMAGE:1])
  );

  CLONEME(OBJ "zellenschluessel");
}

public void swallow(object enemy, int damage, mixed dt) {
    // 20% chance, dass man verschlungen wird, in einen temporaeren raum kommt und dort verdaut
    // wonst hat man glueck gehabt
    if(!random(5)) {
        tell_object(enemy, BS("Die Kiste verschluckt dich und du findest dich in einem dunklen, engen Magen wieder!"));
        tell_room(environment(enemy), BS("Die Kiste verschluckt "+enemy->Name(WEN)+"!"), ({enemy}));
        enemy->move(ROOM "mimik_belly", M_GO|M_NOCHECK|M_SILENT);
        return;
    } else {
        tell_object(enemy, BS("Die Kiste hat nur ein riesiges Stueck aus der herausgebissen!"));
        return;
    }
}
