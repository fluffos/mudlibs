#include "../def.h"

inherit NPC "std_cult_npc";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein mutiertes Fliegenmonster");
  SetProp(P_LONG,
    "Vor dir schwebt ein groteskes Wesen, das eine widerliche Mischung aus Mensch und Fliege darstellt. "
    "Der Körper hat menschliche Züge, aber riesige, durchsichtige Flügel und eine fette, fliegenartige "
    "Fratze. Die Augen sind groß und multifacettiert, und der ganze Körper scheint in einem ständigen "
    "Schwappen zu pulsieren. Es riecht nach verwesendem Fleisch und vergorenem Abfall.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Fliegenmonster");
  SetProp(P_GENDER, MALE);
  AddId(({"fliegenmonster", "monster", "fliegen"}));
  AddClass( ({CL_FLYING}) );
  SetProp(P_ARTICLE, 1);

//--Eigenschaften----------------------------------------------------------

  create_default_npc(30+random(5));

  SetProp(P_HANDS, ({" mit seinen scharfen Flügeln",
                    QueryProp(P_HANDS)[1],
                    ({DT_SLASH})
                    }) );

  SetProp(P_RACE, "Fliegenmonster");
  SetProp(P_SIZE, 150+random(30));
  SetProp(P_WEIGHT, 6000);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 0.7);
  SetProp(P_NOMAGIC,0);

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "schwebt mit einem schwirrenden Geräusch herein");
  SetProp(P_MSGOUT, "fliegt mit einem zischenden Geräusch davon");
  SetProp(P_MMSGIN, "materialisiert sich mit einem Summen aus der Luft");
  SetProp(P_MMSGOUT, "zerfällt in einen Nebel aus Fliegen und verschwindet");

  SetProp(P_MNPC_AREA, ({  ROOM }) );
  SetProp(P_MNPC_DEFAULTROOM, ROOM "1_g9");
  SetProp(P_MNPC_WAIT, ({ 15, 30, 10 }));
  SetProp(P_MNPC_FLAGS, MOV_MOVES+MOV_BACKWARDS);

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO, " summt und brummt unaufhörlich.\n");

  SetProp(P_SPELLRATE, 25);

//--Zauber-----------------------------------------------------------------

  // Zauber 1: Stachelangriff - Ein schmerzhafter Angriff mit scharfen Stacheln
  AddSpell(3, 250,
    "Das Fliegenmonster sticht dich mit seinen scharfen Stacheln. Du spürst einen stechenden Schmerz "
    "und das Gift breitet sich in deinem Körper aus!\n",
    "Das Fliegenmonster sticht @WEN mit seinen scharfen Stacheln. @PWEN wirkt schmerzverzerrt.\n",
    ({DT_PIERCE, DT_POISON}),
    ([SP_SHOW_DAMAGE:1])
  );

  // Zauber 2: Fliegenwolke - Eine Wolke von Fliegen, die dich beißt und schwächt
  AddSpell(2, 200,
    "Das Fliegenmonster entfesselt eine Wolke von Fliegen, die dich unaufhörlich beißen und dich "
    "schwächen. Du fühlst dich matt und ausgezehrt.\n",
    "Das Fliegenmonster entfesselt eine Wolke von Fliegen auf @WEN, die @PWEN beißen und schwächen.\n",
    ({DT_POISON, DT_SLASH}),
    ([SP_SHOW_DAMAGE:1])
  );

  // Zauber 3: Brummende Verwirrung - Ein Summen, das den Gegner desorientiert
  AddSpell(4, 150,
    "Das Fliegenmonster gibt ein ohrenbetäubendes Summen von sich, das deinen Geist vernebelt und dich "
    "kurzzeitig desorientiert.\n",
    "Das Fliegenmonster erzeugt ein ohrenbetäubendes Summen, das @WEN desorientiert.\n",
    DT_MAGIC,
    "buzz_confusion",
    ([SP_SHOW_DAMAGE:1])
  );
}

void buzz_confusion(object enemy, int damage, mixed dam_type)
{
  enemy->SetProp(P_DISABLE_SPELLS, 2);
  tell_object(enemy, "Das Summen des Fliegenmonsters verwirrt dich!\n");
}


void die(int poisondeath)
{
  write_file(LOG "npc.kills",
      dtime() + ": " + (CAP(getuid(QueryProp(P_KILLER) || TP)) || "<Unbekannt>") +
      " hat das Fliegenmonster getoetet.\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
        dtime() + ": " + Name(WER, 1) + " hat " + CAP(getuid(player)) +
        " in einem summenden Angriff getoetet.\n");
  }
}
