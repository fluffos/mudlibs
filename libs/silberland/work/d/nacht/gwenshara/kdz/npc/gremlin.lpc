#include "../def.h"

inherit NPC "std_cult_npc";

void create()
{
  if(!is_clone(TO)) return;

  ::create();
//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein flitzender kleiner Gremlin");
  SetProp(P_LONG,
    "Der Gremlin ist ein kleines, widerliches Wesen, das sich mit "
    "seinen langen, duennen Fingern und Zehen an den Waenden entlang "
    "bewegt. Seine Augen sind gross und schwarz, und es hat einen "
    "breiten Mund voller scharfer Zaehne.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Gremlin");
  SetProp(P_GENDER, MALE);
  AddId(({"gremlin"}));
  AddClass( ({}) );
  SetProp(P_ARTICLE, 1);

//--Eigenschaften----------------------------------------------------------

  create_default_npc(20+random(5));

  SetProp(P_HANDS, ({" mit seinen langen Fingern",
                    QueryProp(P_HANDS)[1],
                    ({DT_RIP, DT_MAGIC})
                    }) );

  SetProp(P_RACE, "Gremlin");
  SetProp(P_SIZE, 80+random(100));
  SetProp(P_WEIGHT, 5000);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 0.5);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" will nichts tragen.\n" }) );

  SetProp(P_LOG_INFO, MAGIERNAME + "/" + explode(ZONE, "/")[<1] + ".log" );

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([DT_POISON: -0.5, DT_HOLY: 0.2, DT_FIRE: 0.2, DT_COLD: -0.3, DT_UNHOLY: -0.6]) );

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "huscht herein");
  SetProp(P_MSGOUT, "huscht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_MNPC_AREA, ({  ROOM }) );
  SetProp(P_MNPC_DEFAULTROOM, ROOM "1_g8");
  SetProp(P_MNPC_WAIT, ({ 40, 50, 10 }));
  SetProp(P_MNPC_FLAGS, MOV_MOVES + MOV_BACKWARDS);

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO, " lacht dich aus.\n");

  SetProp(P_SPELLRATE, 33);

  AddSpell(2, 300,
    "Der Gremlin wirft dir einen Feuerball entgegen.\n",
    "Der Gremlin wirft @WEM einen Feuerball entgegen.\n",
    DT_FIRE, ([SP_SHOW_DAMAGE:1]));

  AddSpell(2, 300,
    "Der Gremlin wirft dir einen Eisstrahl entgegen.\n",
    "Der Gremlin wirft @WEM einen Eisstrahl entgegen.\n",
    DT_COLD, ([SP_SHOW_DAMAGE:1]));

  AddSpell(1, 400,
    "Der Gremlin lacht dich aus und du fuehlst dich schwach.\n",
    "Der Gremlin lacht @WEN aus.\n",
    DT_MIND, ([SP_SHOW_DAMAGE:1]));

  AddDefaultSpell(2, 500, DS_MASS_DEAF,
    "Der Gremlin schreit laut und du wirst taub.\n",
    "Der Gremlin schreit laut und du wirst taub.\n");
} 

void die(int poisondeath)
{
  write_file(LOG "npc.kills",
      dtime() + ": " + (CAP(getuid(QueryProp(P_KILLER) || TP)) || "<Unbekannt>") +
      " killt " + name(WEN, 1) + ".\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
        dtime() + ": " + Name(WER, 1) + "hat gerade " + CAP(getuid(player)) +
        " umgebracht.\n");
  }
}
