#include "../def.h"

inherit NPC "std_cult_npc";

void create()
{
  if(!is_clone(TO)) return;

  ::create();
//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Eine schleimige Gruftassel");
  SetProp(P_LONG,
    "Eine feiste, eztwa hundegrosse Gruftassel steht vor dir. Gruenliches Leichenwachs "
    "klept an ihr.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Gruftassel");
  SetProp(P_GENDER, FEMALE);
  AddId(({"assel", "gruftassel"}));
  AddClass( ({CL_ANIMAL}) );
  SetProp(P_ARTICLE, 1);

//--Eigenschaften----------------------------------------------------------

  create_default_npc(10+random(5));

  SetProp(P_HANDS, ({" mit ihren Mandibeln",
                    QueryProp(P_HANDS)[1],
                    ({DT_RIP})
                    }) );

  SetProp(P_RACE, "Insekt");
  SetProp(P_SIZE, 50+random(50));
  SetProp(P_WEIGHT, 5000);
  SetProp(P_MAX_HANDS, 6);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 0.5);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" kann nichts tragen.\n" }) );

  SetProp(P_LOG_INFO, MAGIERNAME + "/" + explode(ZONE, "/")[<1] + ".log" );

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "krabbelt herein");
  SetProp(P_MSGOUT, "krabbelt");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_MNPC_AREA, ({  ROOM }) );
  SetProp(P_MNPC_DEFAULTROOM, ROOM "1_g8");
  SetProp(P_MNPC_WAIT, ({ 40, 50, 10 }));
  SetProp(P_MNPC_FLAGS, MOV_MOVES + MOV_BACKWARDS);

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO, " quiekt.\n");

  SetProp(P_SPELLRATE, 3);

  AddDefaultSpell(1, 1, DS_POISON,
      "Die Gruftassel spritzt dir eine Ladung Gift ins Gesicht.\n",
      "Die Gruftassel spritzt @WEN eine Ladung Gift ins Gesicht.\n");
}

void die(int poisondeath)
{
  write_file(LOG "npc.kills",
      dtime() + ": " + (CAP(getuid(QueryProp(P_KILLER) || TP)) || "<Unbekannt>") +
      " killt " + name(WEN, 1) + ".\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
        dtime() + ": " + Name(WER, 1) + "hat gerade " + CAP(getuid(player)) +
        " umgebracht.\n");
  }
}
