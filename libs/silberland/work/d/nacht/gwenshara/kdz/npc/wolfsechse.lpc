#include "../def.h"

inherit NPC "std_cult_npc";

void create()
{
  if(!is_clone(TO)) return;

  ::create();
//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Eine schuppige Wolfsechse");
  SetProp(P_LONG,
    "Die Wolfsechse ist eine abscheuliche Mischung aus Wolf und Echse aus. "
    "Ein wolfsartiger Koerperbau, der komplett mit gruenen Schuppen "
    "ueberzogen ist, gelbe Schlitzpuillen und schlangenartige Zaehne.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Wolfsechse");
  SetProp(P_GENDER, FEMALE);
  AddId(({"wolfsechse", "wolf", "echse"}));
  AddClass( ({CL_ANIMAL}) );
  SetProp(P_ARTICLE, 1);

//--Eigenschaften----------------------------------------------------------

  create_default_npc(25+random(5));

  SetProp(P_HANDS, ({" mit ihren Zaehnen und Krallen",
                    QueryProp(P_HANDS)[1],
                    ({DT_RIP, DT_PIERCE})
                    }) );

  SetProp(P_RACE, "Echse");
  SetProp(P_SIZE, 80+random(40));
  SetProp(P_WEIGHT, 55000);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 0.3);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC, 5);

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" kann nichts tragen.\n" }) );

  SetProp(P_LOG_INFO, MAGIERNAME + "/" + explode(ZONE, "/")[<1] + ".log" );

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([DT_POISON: -0.5, DT_SLASH: -0.3, DT_RIP: -0.3, DT_BLUDGEON: -0.3,
      DT_SQUEEZE: -0.3, DT_WHIP: -0.3, DT_ACID: -0.3, DT_HOLY: 0.2,
      DT_FIRE: -0.2, DT_COLD: 0.3
     ]) );

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "laeuft herein");
  SetProp(P_MSGOUT, "laeuft");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_MNPC_AREA, ({  ROOM }) );
  SetProp(P_MNPC_DEFAULTROOM, ROOM "1_g8");
  SetProp(P_MNPC_WAIT, ({ 40, 50, 10 }));
  SetProp(P_MNPC_FLAGS, MOV_MOVES + MOV_BACKWARDS);

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO, " knurrt.\n");
}

void die(int poisondeath)
{
  write_file(LOG "npc.kills",
      dtime() + ": " + (CAP(getuid(QueryProp(P_KILLER) || TP)) || "<Unbekannt>") +
      " killt " + name(WEN, 1) + ".\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
        dtime() + ": " + Name(WER, 1) + "hat gerade " + CAP(getuid(player)) +
        " umgebracht.\n");
  }
}
