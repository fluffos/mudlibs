#include "../def.h"

inherit NPC "std_cult_npc";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein duesterer Rosenritter");
  SetProp(P_LONG,
    "Vor dir steht ein imposanter Ritter in schwarzer, schwerer Ruestung, "
    "die mit dem Symbol einer verbluehten Rose verziert ist. Seine Augen "
    "gluehen in einem unheimlichen Rot hinter dem Visier seines Helms. "
    "Der Rosenritter ist ein duesterer Antipaladin, dessen Praesenz allein "
    "die Luft zum Flimmern bringt. Die Atmosphaere um ihn herum ist von "
    "kaltem Schrecken erfuellt, und ein schwacher Hauch von Rosenblaettern "
    "begleitet jede seiner Bewegungen.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Rosenritter");
  SetProp(P_GENDER, MALE);
  AddId(({"ritter", "rosenritter", "antipaladin", "Schwertkaempfer"}));
  AddClass( ({CL_HUMAN}) );
  SetProp(P_ARTICLE, 1);

//--Eigenschaften----------------------------------------------------------

  create_default_npc(35+random(5));

  SetProp(P_HANDS, ({" mit seiner verfluchten Klinge",
                    QueryProp(P_HANDS)[1],
                    ({DT_SLASH})
                    }) );

  SetProp(P_RACE, "Mensch");
  SetProp(P_SIZE, 185+random(15));
  SetProp(P_WEIGHT, 9000);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 0.8);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([DT_HOLY: -0.5, DT_UNHOLY: 0.3, DT_FIRE: 0.1, DT_COLD: 0.1]) );

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "marschiert herein, begleitet vom Rascheln verwelkter Rosenblaetter");
  SetProp(P_MSGOUT, "marschiert davon, hinterlaesst dabei eine Spur dunkler Blaetter");
  SetProp(P_MMSGIN, "materialisiert sich in einer Wolke aus schwarzen Rosenblaettern");
  SetProp(P_MMSGOUT, "loest sich in eine Wolke aus schwarzen Rosenblaettern auf");

  SetProp(P_MNPC_AREA, ({  ROOM }) );
  SetProp(P_MNPC_DEFAULTROOM, ROOM "1_g8");
  SetProp(P_MNPC_WAIT, ({ 20, 40, 15 }));
  SetProp(P_MNPC_FLAGS, MOV_MOVES + MOV_BACKWARDS);

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO, " seine Ruestung knarzt bedrohlich.\n");

  SetProp(P_SPELLRATE, 50);

//--Zauber-----------------------------------------------------------------

  // Zauber 1: Fluch der schwarzen Rose - Ein toedlicher Debuff, der dem Gegner schadet
  AddSpell(3, 250,
    "Der Rosenritter spricht duestere Worte, und ein schwarzer Nebel legt sich um dich. "
    "Du spuerst, wie die Lebenskraft aus deinem Koerper weicht!\n",
    "Der Rosenritter murmelt unheilvolle Worte und ein schwarzer Nebel legt sich um @WEN, "
    "verringert @PWESSEN Lebenskraft.\n",
    ({DT_UNHOLY, DT_POISON}),
    ([SP_SHOW_DAMAGE:1])
  );

  // Zauber 2: Verfluchte Klinge - Ein maechtiger Angriff mit seiner dunklen Waffe
  AddSpell(3, 300,
    "Der Rosenritter erhebt seine verfluchte Klinge und schlaegt mit unbarmherziger Praezision auf dich ein, "
    "ein dunkler Schein umgibt die Klinge und verstaerkt den Schaden!\n",
    "Der Rosenritter schlaegt mit seiner verfluchten Klinge auf @WEN ein, die Dunkelheit umhuellt die Waffe "
    "und verstaerkt den Angriff.\n",
    ({DT_SLASH, DT_UNHOLY}),
    ([SP_SHOW_DAMAGE:1])
  );

  // Zauber 3: Schild der Verdammnis - Erhoeht kurzfristig die Ruestung und Zauberresistenz
  AddSpell(2, 0,
    "Der Rosenritter erhebt seinen Schild, und eine unsichtbare Barriere umgibt ihn, die "
    "seine Ruestung staerkt und ihn gegen Magie schuetzt.\n",
    "Der Rosenritter erhebt seinen Schild, eine unsichtbare Barriere entsteht, und er scheint "
    "nun noch widerstandsfaehiger gegen Angriffe und Magie.\n",
    DT_MAGIC,
    "damnation_shield",
    ([SP_SHOW_DAMAGE:1])
  );

  // Zauber 4: Todeshauch - Ein Kaelteschaden-Zauber, der den Gegner erstarren laesst
  AddSpell(3, 350,
    "Der Rosenritter blaest einen eisigen Hauch in deine Richtung. Deine Glieder werden steif, "
    "und du fuehlst, wie dein Koerper vor Kaelte zu zerbrechen droht!\n",
    "Ein eisiger Hauch entweicht dem Helm des Rosenritters und trifft @WEN. Die Kaelte "
    "laesst @PWEN zittern und gefrieren.\n",
    ({DT_COLD, DT_MAGIC}),
    ([SP_SHOW_DAMAGE:1])
  );

  // Zauber 5: Zorn der Monstermutter - Eine letzte Verzweiflungstat, bei der der Ritter heftig angreift
  AddSpell(1, 666,
    "Der Rosenritter schreit in den Himmel, und eine dunkle Aura umhuellt ihn, "
    "waehrend er seine gesamte verbleibende Kraft in einen Angriff steckt!\n",
    "Der Rosenritter schreit in den Himmel, und eine dunkle Aura umhuellt ihn, "
    "waehrend er @WEN mit einem verzweifelten Angriff attackiert.\n",
    ({DT_UNHOLY, DT_SLASH}),
    "self_harm",
    ([SP_SHOW_DAMAGE:1])
  );

  if(!random(5)) {
    CLONEME(ARMOUR "rosenritterschild");
    CLONEME("/p/weapon/sword/bastardschwert");
    command_me("zuecke schwert");
  } else {
    CLONEME("/p/armour/armour/kettenhemd");
    CLONEME("/p/weapon/sword/bihaender");
    command_me("zuecke bihaender");
  }

  if(!random(2)) CLONEME("/p/armour/cloak/umhang");
  if(!random(3)) CLONEME("/p/armour/helm/topfhelm");
  if(!random(3)) CLONEME("/p/armour/boots/kampfstiefel");

  command_me("trage alles");

  if(!random(3)) {
    CLONEME(OBJ "heiltrank");
  }
}

void self_harm(object enemy, int d, mixed dt) {
  if(!random(3)) return;

  tell_room(ENV(TO), BS("Der Rosenritter hat sich selbst verletzt!"));
  do_damage(100 + random(100));
  return;
}

void damnation_shield(object enemy, int damage, mixed dam_type)
{
  // Voruebergehendes Erhoehen der Ruestung und Zauberresistenz
  SetProp(P_BODY, QueryProp(P_BODY) + 30); // +20% Ruestung
  SetProp(P_NOMAGIC, QueryProp(P_NOMAGIC) + 20); // +20% Zauberresistenz
  
  tell_object(enemy, "Der Rosenritter scheint durch eine unsichtbare Macht geschuetzt zu sein!\n");
  
  // Ruecksetzen der Zauberresistenz nach 10 Sekunden
  call_out("reset_damnation_shield", 10);
}

public void reset_damnation_shield() {
    SetProp(P_NOMAGIC, QueryProp(P_NOMAGIC)-20); // Zuruecksetzen der Zauberresistenz
    SetProp(P_BODY, QueryProp(P_BODY)-30); // Zuruecksetzen der Ruestung
    tell_object(TO, "Die Wirkung des Schilds der Verdammnis verblasst.\n");
    return;
}

void die(int poisondeath)
{
  write_file(LOG "npc.kills",
      dtime() + ": " + (CAP(getuid(QueryProp(P_KILLER) || TP)) || "<Unbekannt>") +
      " hat den Rosenritter getoetet.\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
        dtime() + ": " + Name(WER, 1) + " hat " + CAP(getuid(player)) +
        " in einem dunklen Ritual getoetet.\n");
  }
}
