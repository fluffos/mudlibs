#include "../def.h"

inherit NPC "std_cult_npc";

void create()
{
  if(!is_clone(TO)) return;

  ::create();
//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein Priester der Monstermutter");
  SetProp(P_LONG,
    "Der Priester ist ein grosser, muskuloeser Mann mit einem langen, "
    "schwarzen Bart. Seine Augen sind tief und dunkel, und er traegt "
    "einen langen, schwarzen Umhang. In seiner Hand haelt er eine "
    "zackige Sichel. Sein ganzer Koerper ist mit Geschwueren und "
    "Narben uebersaet.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Priester");
  SetProp(P_GENDER, MALE);
  AddId(({"priester"}));
  AddClass( ({}) );
  SetProp(P_ARTICLE, 1);

//--Eigenschaften----------------------------------------------------------

  create_default_npc(25+random(5));

  SetProp(P_HANDS, ({" mit seinen haenden",
                    QueryProp(P_HANDS)[1],
                    ({DT_BLUDGEON})
                    }) );

  SetProp(P_RACE, ({"Mensch", "Ork", "Elf", "Zwerg", "Dunkelelf", "Troll"})[random(6)]);
  SetProp(P_SIZE, 80+random(100));
  SetProp(P_WEIGHT, 5000);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 0.5);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" will nichts tragen.\n" }) );

  SetProp(P_LOG_INFO, MAGIERNAME + "/" + explode(ZONE, "/")[<1] + ".log" );

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([DT_POISON: -0.5, DT_HOLY: 0.2, DT_FIRE: 0.2, DT_COLD: -0.3, DT_UNHOLY: -0.6]) );

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "schreitet herein");
  SetProp(P_MSGOUT, "schreitet");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_MNPC_AREA, ({  ROOM }) );
  SetProp(P_MNPC_DEFAULTROOM, ROOM "1_g8");
  SetProp(P_MNPC_WAIT, ({ 40, 50, 10 }));
  SetProp(P_MNPC_FLAGS, MOV_MOVES + MOV_BACKWARDS);

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO, " lacht dich aus.\n");

  SetProp(P_SPELLRATE, 33);

    // Zauber 1: Ruf der Monstermutter - Ruft unheilige Kreaturen zur Hilfe
    AddSpell(3, 400,
      "Der Priester murmelt dunkle Beschwoerungsformeln, und du spuerst, wie die Schatten "
      "sich um dich verdichten, als unheilige Kreaturen auf dich zustuermen!\n",
      "Der Priester murmelt dunkle Beschwoerungsformeln, und aus den Schatten erscheinen "
      "furchterregende Kreaturen, die @WEN angreifen!\n",
      ({DT_UNHOLY, DT_RIP}),
      ([SP_SHOW_DAMAGE:1])
    );
  
    // Zauber 2: Giftige Wolke - Eine giftige Wolke entweicht aus den Geschwueren des Priesters
    AddSpell(5, 200,
      "Die Geschwuere auf dem Koerper des Priesters platzen auf, und eine giftige Wolke "
      "breitet sich in deiner Umgebung aus. Deine Lungen brennen vor Schmerz!\n",
      "Eine giftige Wolke breitet sich von dem Priester aus und huellt @WEN in giftige Daempfe ein.\n",
      DT_POISON,
      ([SP_SHOW_DAMAGE:1])
    );
  
    // Zauber 3: Furcht der Monstermutter - Laesst den Gegner vor Angst erstarren
    AddSpell(2, 100,
      "Die Augen des Priesters leuchten rot auf, und du fuehlst eine ueberwaeltigende Welle "
      "der Angst, die dich erstarren laesst!\n",
      "Der Priester starrt @WEN an, dessen Gesicht ploetzlich von purer Angst verzerrt wird.\n",
      DT_MAGIC,
      "apply_fear_effect",
      ([SP_SHOW_DAMAGE:1])
    );

    // Zauber 4: Blutopfer - Der Priester opfert eigenes Blut, um Kraft zu gewinnen
  AddSpell(4, 0,
    "Der Priester schlitzt seine eigene Haut auf und laesst das Blut auf den Boden tropfen. "
    "Ein dunkles Leuchten umgibt ihn, und du spuerst, wie seine Macht waechst!\n",
    "Der Priester schlitzt seine eigene Haut auf und laesst das Blut auf den Boden tropfen. "
    "Ein dunkles Leuchten umgibt ihn, und @WEN sieht geschwaecht aus, waehrend seine Macht waechst.\n",
    DT_MAGIC,
    "blood_sacrifice",
    ([SP_SHOW_DAMAGE:1])
  );

  // Zauber 5: Schattenketten - Ketten aus purem Schatten binden den Gegner
  AddSpell(3, 250,
    "Der Priester streckt seine Hand aus, und ploetzlich schiessen schwarze Ketten aus den "
    "Schatten, die sich fest um deine Glieder wickeln und dich bewegungsunfaehig machen!\n",
    "Schwarze Ketten schiessen aus den Schatten und wickeln sich um @WEN, die ploetzlich "
    "bewegungsunfaehig wird!\n",
    ({DT_UNHOLY, DT_WHIP}),
    "bind_enemy",
    ([SP_SHOW_DAMAGE:1])
  );

  if(!random(3)) {
    CLONEME(WEAPON "priestersichel");
    command_me("zuecke sichel");
  }
} 

void apply_fear_effect(object enemy, int damage, mixed dam_type)
{
  enemy->SetProp(P_WIMPY, enemy->QueryProp(P_WIMPY)+50);
  tell_object(enemy, "Die Angst durchdringt deinen Geist, und du fuehlst den Drang zu fliehen!\n");
}

void blood_sacrifice(object enemy, int damage, mixed dam_type) 
{
  heal_self(100+random(200));
  tell_object(enemy, "Der Priester scheint gestaerkt und furchterregender als zuvor!\n");
}

void bind_enemy(object enemy, int damage, mixed dam_type)
{
  enemy->SetProp(P_DISABLE_ATTACK, 1+random(3));
  tell_object(enemy, "Die Schattenketten halten dich fest und du kannst dich nicht bewegen!\n");
}

void die(int poisondeath)
{
  write_file(LOG "npc.kills",
      dtime() + ": " + (CAP(getuid(QueryProp(P_KILLER) || TP)) || "<Unbekannt>") +
      " killt " + name(WEN, 1) + ".\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
        dtime() + ": " + Name(WER, 1) + "hat gerade " + CAP(getuid(player)) +
        " umgebracht.\n");
  }
}
