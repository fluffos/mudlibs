#include "../def.h"

inherit NPC "std_cult_npc";

string race;

void create()
{
  if(!is_clone(TO)) return;

  ::create();

  race = ({"Mensch", "Elf", "Zwerg", "Ork", "Goblin", "Oger", "Troll", "Gnom", "Echsenmensch", "Hobbit"})[random(10)];

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein wahnsinniger Kultist");
  SetProp(P_LONG,
    "Dieser Kultist ist ein Anhaenger der Monstermutter. Er traegt eine dunkle Kutte "
    "und einen zackigen Dolch. Wahnsinn sprueht aus seinen Augen und verschiedene "
    "Geschwuere und Mutationen bedecken seine Haut. Er ist ein "+race+".");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Kultist");
  SetProp(P_GENDER, MALE);
  AddId(({"kultist", "\nkdz_kultist"}));
  AddClass( ({}) );
  SetProp(P_ARTICLE, 1);

//--Eigenschaften----------------------------------------------------------

  create_default_npc(23+random(5));

  SetProp(P_HANDS, ({" mit seinen haenden",
                    QueryProp(P_HANDS)[1],
                    ({DT_BLUDGEON})
                    }) );

  SetProp(P_RACE, race);
  SetProp(P_SIZE, 100+random(100));
  SetProp(P_WEIGHT, 75000);
  SetProp(P_ALIGN, -random(1000));
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 0.1);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" will @WEN nicht haben.\n" }) );

  SetProp(P_LOG_INFO, MAGIERNAME + "/" + explode(ZONE, "/")[<1] + ".log" );

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_LIGHT:     0.1, DT_ACID:     -0.2, DT_POISON:   -0.3, 
       DT_TERROR:    0.1, DT_HOLY:      0.1, DT_UNHOLY:   -0.2, 
       DT_MIND:      0.1
     ]) );

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_MNPC_AREA, ({  ROOM }) );
  SetProp(P_MNPC_DEFAULTROOM, ROOM "1_g8");
  SetProp(P_MNPC_WAIT, ({ 40, 50, 10 }));
  SetProp(P_MNPC_FLAGS, MOV_MOVES + MOV_BACKWARDS);

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO, " sagt: Blut fuer die Monstermutter!\n");
  AddInfo(MAGIERNAME, CAP(MAGIERNAME) + " hat mich erschaffen.","sagt: ");

//--Spells-----------------------------------------------------------------

  SetProp(P_SPELLRATE, 10);

  AddSpell(3, 250,
    Name(WER, 1)+" haut dir auf die Nase.\n",
    Name(WER, 1)+" haut @WEM auf die Nase.\n",
     DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));

  AddSpell(2, 300,
      Name(WER, 1)+" schleudert einen Terrorblitz nach dir.\n",
      Name(WER, 1)+" schleudert einen Terrorblitz nach @WEM.\n",
      ({DT_BLUDGEON, DT_LIGHTNING}), ([SP_SHOW_DAMAGE:1]));

  if(!random(2)) {
    CLONEME(WEAPON "kultistendolch");
    command_me("zuecke dolch");
  }

  CLONEME("/p/armour/cloak/robe");
  command_me("trage alles");

  if(!random(5)) {
    CLONEME(OBJ "heiltrank");
  }
}

void die(int poisondeath)
{
  write_file(LOG "npc.kills",
      dtime() + ": " + (CAP(getuid(QueryProp(P_KILLER) || TP)) || "<Unbekannt>") +
      " killt " + name(WEN, 1) + ".\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
        dtime() + ": " + Name(WER, 1) + "hat gerade " + CAP(getuid(player)) +
        " umgebracht.\n");
  }
}
