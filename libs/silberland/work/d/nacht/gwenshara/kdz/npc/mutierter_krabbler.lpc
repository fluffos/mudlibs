#include "../def.h"

inherit NPC "std_cult_npc";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein mutierter Krabbler");
  SetProp(P_LONG,
    "Vor dir windet sich ein groteskes Wesen, das einst ein Mensch war. "
    "Der Koerper des mutierten Krabblers ist in eine verzerrte Form gepresst, "
    "die an eine Mischung aus Mensch und Spinne erinnert. Lange, knorrige Gliedmassen "
    "ragen aus seinem Koerper, waehrend seine Augen in wahnsinnigem Irrsinn "
    "gluehen. Die Haut ist bleich und duenn, fast durchsichtig, und die Bewegungen "
    "des Wesens sind unnatuerlich schnell und ruckartig.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Krabbler");
  SetProp(P_GENDER, MALE);
  AddId(({"krabbler", "mutierter krabbler", "monster"}));
  AddClass( ({CL_HUMAN}) );
  SetProp(P_ARTICLE, 1);

//--Eigenschaften----------------------------------------------------------

  create_default_npc(20+random(5));

  SetProp(P_HANDS, ({" mit seinen klauenartigen Haenden",
                    QueryProp(P_HANDS)[1],
                    ({DT_PIERCE})
                    }) );

  SetProp(P_RACE, "Monster");
  SetProp(P_SIZE, 160+random(20));
  SetProp(P_WEIGHT, 5000);
  SetProp(P_MAX_HANDS, 4);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 0.6);
  SetProp(P_WIMPY, 10);
  SetProp(P_NOMAGIC,0);

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([DT_POISON: 0.2, DT_UNHOLY: 0.1, DT_FIRE: -0.2, DT_COLD: 0.2]) );

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "krabbelt auf unheimliche Weise herein");
  SetProp(P_MSGOUT, "krabbelt geraeuschlos davon");
  SetProp(P_MMSGIN, "materialisiert sich kriechend aus den Schatten");
  SetProp(P_MMSGOUT, "zerfaellt in einen Haufen duerrer Glieder und verschwindet");

  SetProp(P_MNPC_AREA, ({  ROOM }) );
  SetProp(P_MNPC_DEFAULTROOM, ROOM "1_g8");
  SetProp(P_MNPC_WAIT, ({ 15, 30, 10 }));
  SetProp(P_MNPC_FLAGS, MOV_MOVES + MOV_BACKWARDS);

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO, " zischt und faucht unheimlich.\n");

  SetProp(P_SPELLRATE, 20);

//--Zauber-----------------------------------------------------------------

  // Zauber 1: Saeurebiss - Ein Angriff mit aetzendem Speichel
  AddSpell(4, 200,
    "Der mutierte Krabbler schnappt nach dir und beisst in deine Haut. Ein brennender Schmerz "
    "durchzieht deinen Koerper, als die Saeure aus seinen Zaehnen wirkt!\n",
    "Der mutierte Krabbler beisst @WEN, und du siehst, wie sich aetzende Saeure in die Haut frisst!\n",
    ({DT_ACID, DT_PIERCE}),
    ([SP_SHOW_DAMAGE:1])
  );

  // Zauber 2: Netzfalle - Ein Angriff, der den Gegner in ein Netz faengt
  AddSpell(3, 150,
    "Der mutierte Krabbler speit ein klebriges Netz auf dich, das sich um deinen Koerper wickelt und "
    "dich bewegungsunfaehig macht!\n",
    "Der mutierte Krabbler speit ein Netz auf @WEN und faengt @PWEN damit ein, was die Bewegungen stark einschraenkt.\n",
    ({DT_PIERCE, DT_MAGIC}),
    "web_trap",
    ([SP_SHOW_DAMAGE:1])
  );
}

void web_trap(object enemy, int damage, mixed dam_type)
{
  enemy->SetProp(P_DISABLE_ATTACK, 2); // Gegner kann nicht angreifen
  tell_object(enemy, "Das Netz um dich zieht sich fester und fesselt dich vollstaendig!\n");
}


void die(int poisondeath)
{
  write_file(LOG "npc.kills",
      dtime() + ": " + (CAP(getuid(QueryProp(P_KILLER) || TP)) || "<Unbekannt>") +
      " hat den mutierten Krabbler getoetet.\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
        dtime() + ": " + Name(WER, 1) + " hat " + CAP(getuid(player)) +
        " in einem bizarren Akt der Gewalt getoetet.\n");
  }
}
