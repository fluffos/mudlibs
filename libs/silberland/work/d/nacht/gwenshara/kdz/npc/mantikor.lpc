#include "../def.h"

inherit "std/npc";
inherit "/std/npc/spells";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein Mantikor");
  SetProp(P_LONG,
    "Der Mantikor steht fauchend und bruellend vor dir. Sein Kopf ist der eines "
    "Menschen, sein Koerper der eines Loewen und sein Schwanz der eines Skorpions. "
    "Grosse Fledermausschwingen zieren seinen Ruecken. Seine Augen funkeln vor "
    "wahnwitzigem Hass und seine Klauen sind lang und scharf.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Mantikor");
  SetProp(P_GENDER, MALE);
  AddId(({"mantikor", "\nkdz_mantikor", "WUSCHEL_FELL", "NOCONTROL", "NOWIMPY"}));
  AddClass( ({CL_FLYING}) );
  SetProp(P_ARTICLE, 1);

//--Eigenschaften----------------------------------------------------------

  create_default_npc(35);

  SetProp(P_HANDS, ({" mit seinen Krallen und seinem Schwanz",
                    QueryProp(P_HANDS)[1],
                    ({DT_RIP, DT_PIERCE, DT_POISON})
                    }) );

  SetProp(P_RACE, "Bestie");
  SetProp(P_SIZE, 250);
  SetProp(P_WEIGHT, 275000);
  SetProp(P_ALIGN, -800);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 0.33);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" will @WEN nicht haben.\n" }) );

  SetProp(P_LOG_INFO, MAGIERNAME + "/" + explode(ZONE, "/")[<1] + ".log" );

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:     -0.1, DT_COLD:      0.0, DT_WATER:       0.1,
       DT_AIR:      -0.2, DT_LIGHTNING: 0.0, DT_EXPLOSION:  -0.1,
       DT_SOUND:     0.0, DT_LIGHT:     0.1, DT_ELECTRIC:    0.0,
       DT_ACID:     -0.2, DT_POISON:   -0.3, DT_TERROR:     -0.5,
       DT_HOLY:      0.1, DT_UNHOLY:   -0.2, DT_MAGIC:       0.2,
       DT_MIND:      0.0, DT_SLASH:     0.0, DT_BLUDGEON:    0.0,
       DT_PIERCE:    0.0, DT_SQUEEZE:   0.0, DT_WHIP:        0.0,
       DT_RIP:       0.0,
     ]) );

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "kommt an");
  SetProp(P_MSGOUT, "geht");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO, " bruellt nur vor Wahnsinn.\n");
  AddInfo(MAGIERNAME, CAP(MAGIERNAME) + " hat mich erschaffen.","sagt: ");

//--Spells-----------------------------------------------------------------

  SetProp(P_SPELLRATE, 27);

  AddSpell(3, 250,
    "Der Mantikor beisst dich.\n",
    "Der Mantikor beisst @WEN.\n",
     DT_PIERCE, ([SP_SHOW_DAMAGE:1]));

  AddSpell(2, 250,
    "Der Mantikor bruellt dich an.\n",
    "Der Mantikor bruellt @WEN an.\n",
     DT_SOUND, ([SP_SHOW_DAMAGE:1]));

  AddDefaultSpell(1, 1, DS_POISON,
    Name(WER,1) + " sticht dich mit seinem Skorpionschwanz!\n",
    Name(WER,1) + " sticht @WEN mit seinem Skorpionschwanz!\n" );

  AddDefaultSpell(1, 1, DS_MASS_DAMAGE,
    Name(WER,1) + " atmet eine Flammenwolke aus.\n",
    Name(WER,1) + " atment eine Flammenwolke aus.\n", DT_FIRE );

}

void die(int poisondeath)
{
  write_file(LOG "npc.kills",
      dtime() + ": " + (CAP(getuid(QueryProp(P_KILLER) || TP)) || "<Unbekannt>") +
      " killt " + name(WEN, 1) + ".\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
        dtime() + ": " + Name(WER, 1) + "hat gerade " + CAP(getuid(player)) +
        " umgebracht.\n");
  }
}
