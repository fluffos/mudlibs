#include "../def.h"

inherit NPC "std_cult_npc";

void create()
{
  if(!is_clone(TO)) return;

  ::create();
//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein zweikoepfiger Ogerzauberer");
  SetProp(P_LONG,
    "Vor dir steht ein gigantischer Oger mit zwei Koepfen. Beide Koepfe haben "
    "eine steinerne Haut und leuchtende, gloehende Augen. Der Ogerzauberer traegt "
    "einen Umhang aus verwobenen Schatten und haelt einen schweren, knorrigen "
    "Stab in einer seiner grossen Haende. Seine imposante Statur laesst keinen Zweifel "
    "daran, dass er sowohl physisch stark als auch magisch begabt ist.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Ogerzauberer");
  SetProp(P_GENDER, MALE);
  AddId(({"oger", "ogerzauberer"}));
  AddClass( ({}) );
  SetProp(P_ARTICLE, 1);

//--Eigenschaften----------------------------------------------------------

  create_default_npc(30+random(5));

  SetProp(P_HANDS, ({" mit seinen massiven Faeusten",
                    QueryProp(P_HANDS)[1],
                    ({DT_BLUDGEON})
                    }) );

  SetProp(P_RACE, "Oger");
  SetProp(P_SIZE, 200+random(50));
  SetProp(P_WEIGHT, 15000);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 0.7);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" will nichts tragen.\n" }) );

  SetProp(P_LOG_INFO, MAGIERNAME + "/" + explode(ZONE, "/")[<1] + ".log" );

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([DT_POISON: -0.3, DT_HOLY: 0.4, DT_FIRE: -0.2, DT_COLD: 0.2, DT_UNHOLY: -0.5]) );

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "stapft herein");
  SetProp(P_MSGOUT, "stapft davon");
  SetProp(P_MMSGIN, "manifestiert sich mit einem dumpfen Donnerknall");
  SetProp(P_MMSGOUT, "loest sich in einem Blitzgewitter auf");

  SetProp(P_MNPC_AREA, ({  ROOM }) );
  SetProp(P_MNPC_DEFAULTROOM, ROOM "1_g9");
  SetProp(P_MNPC_WAIT, ({ 30, 45, 15 }));
  SetProp(P_MNPC_FLAGS, MOV_MOVES + MOV_BACKWARDS);

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO, " brummt tief und bedrohlich.\n");

  SetProp(P_SPELLRATE, 40);

//--Zauber-----------------------------------------------------------------

  // Zauber 1: Schockwelle - Erzeugt eine maechtige Schockwelle
  AddSpell(4, 350,
    "Der Ogerzauberer schlaegt mit seinem Stab auf den Boden, eine Schockwelle "
    "rollt auf dich zu und reisst dich von den Foessen!\n",
    "Der Ogerzauberer schlaegt mit seinem Stab auf den Boden, eine Schockwelle "
    "rollt durch den Raum und trifft @WEN mit voller Wucht!\n",
    ({DT_SOUND, DT_MAGIC}),
    ([SP_SHOW_DAMAGE:1])
  );

  // Zauber 2: Flammenhauch - Ein feuriger Atemangriff
  AddSpell(3, 400,
    "Einer der Koepfe des Ogerzauberers oeffnet das Maul und speit eine gewaltige Flammenwelle "
    "in deine Richtung. Die Hitze ist unertraeglich!\n",
    "Einer der Koepfe des Ogerzauberers speit eine Flammenwelle auf @WEN. Die Luft "
    "ist erfoellt von sengender Hitze!\n",
    ({DT_FIRE, DT_MAGIC}),
    ([SP_SHOW_DAMAGE:1])
  );

  // Zauber 3: Dunkler Segen - Verstaerkt den Ogerzauberer selbst
  AddSpell(5, 0,
    "Der Ogerzauberer murmelt uralte Worte, und eine dunkle Aura umhoellt ihn, "
    "seine Muskeln schwellen an und seine Augen gloehen noch intensiver.\n",
    "Der Ogerzauberer murmelt uralte Worte und wird von einer dunklen Aura umhoellt. "
    "Er sieht jetzt noch furchterregender aus.\n",
    DT_MAGIC,
    "dark_blessing",
    ([SP_SHOW_DAMAGE:1])
  );

  // Zauber 4: Schattenblitz - Ein blitzartiger Angriff aus dunkler Energie
  AddSpell(6, 300,
    "Der Ogerzauberer hebt seinen Stab und ein Schattenblitz schiesst auf dich zu. "
    "Dein Koerper krampft vor Schmerz!\n",
    "Ein Schattenblitz faehrt aus dem Stab des Ogerzauberers und trifft @WEN. "
    "Die dunkle Energie bringt @PWEN zum Krampfen.\n",
    ({DT_UNHOLY, DT_MAGIC}),
    ([SP_SHOW_DAMAGE:1])
  );

  // Zauber 5: Erdbeben - Laesst den Boden beben und erschoettert alle in der Naehe
  AddDefaultSpell(2, 500, DS_MASS_DAMAGE,
    "Der Ogerzauberer stampft mit voller Wucht auf den Boden und loest ein maechtiges Erdbeben aus, "
    "das dich heftig durchroettelt!\n",
    "Der Ogerzauberer stampft mit voller Wucht auf den Boden und loest ein maechtiges Erdbeben aus, "
    "das dich heftig durchroettelt!\n",
    ({DT_BLUDGEON})
  );

  if(!random(4)) {
    CLONEME(WEAPON "ogerzauberstab");
    command_me("zuecke zauberstab");
  }
}

void dark_blessing(object enemy, int damage, mixed dam_type)
{
  ModifySkillAttribute(TO, SA_DAMAGE, 200, 10);
  tell_object(enemy, "Der Ogerzauberer scheint von einer unheiligen Macht gestaerkt zu sein!\n");
}

void die(int poisondeath)
{
  write_file(LOG "npc.kills",
      dtime() + ": " + (CAP(getuid(QueryProp(P_KILLER) || TP)) || "<Unbekannt>") +
      " killt " + name(WEN, 1) + ".\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
        dtime() + ": " + Name(WER, 1) + "hat gerade " + CAP(getuid(player)) +
        " umgebracht.\n");
  }
}
