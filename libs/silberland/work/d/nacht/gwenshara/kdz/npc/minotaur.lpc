#include "../def.h"

inherit NPC "std_cult_npc";

void create()
{
  if(!is_clone(TO)) return;

  ::create();
//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein Minotaurus");
  SetProp(P_LONG,
    "Die Kreatur vor dir sieht aus wie eine Mischung aus Troll und Kuh. Also eigentlich "
    "grundsaetzlich abscheulich. Maechtige Stierhoerner ragen widernatuerlich aus "
    "dem Kopf eines Trolls mit den Nuestern einer Kuh. Wutschnaubend sieht dich "
    "das Monster an.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Minotaurus");
  SetProp(P_GENDER, MALE);
  AddId(({"minotaurus", "minotaur"}));
  AddClass( ({CL_ANIMAL,CL_TROLL}) );
  SetProp(P_ARTICLE, 1);

//--Eigenschaften----------------------------------------------------------

  create_default_npc(35);

  SetProp(P_HANDS, ({" mit seinen Stierhoernern",
                    QueryProp(P_HANDS)[1],
                    ({DT_PIERCE})
                    }) );

  SetProp(P_RACE, "Bestie");
  SetProp(P_SIZE, 250+random(50));
  SetProp(P_WEIGHT, 355000);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 0.5);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC, 5);

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" kann nichts tragen.\n" }) );

  SetProp(P_LOG_INFO, MAGIERNAME + "/" + explode(ZONE, "/")[<1] + ".log" );

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([DT_POISON: -0.5, DT_SLASH: -0.3, DT_RIP: -0.3, DT_BLUDGEON: -0.3,
      DT_SQUEEZE: -0.3, DT_WHIP: -0.3, DT_ACID: -0.3, DT_HOLY: 0.2,
      DT_FIRE: -0.2, DT_COLD: 0.3
     ]) );

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "stampft herein");
  SetProp(P_MSGOUT, "stampft");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_MNPC_AREA, ({  ROOM }) );
  SetProp(P_MNPC_DEFAULTROOM, ROOM "1_g8");
  SetProp(P_MNPC_WAIT, ({ 40, 50, 10 }));
  SetProp(P_MNPC_FLAGS, MOV_MOVES + MOV_BACKWARDS);

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO, " muht laut.\n");

  SetProp(P_SPELLRATE, 10);

  AddSpell(2, 300,
    "Der Minotaurus bruellt laut und spiesst dich mit seinen Hoernern auf.\n",
    "Der Minotaurus bruellt laut und spiesst @WEN mit seinen Hoernern auf.\n",
    DT_PIERCE, ([SP_SHOW_DAMAGE:1]));

  AddSpell(2, 300,
    "Der Minotaurus tritt dich mit seinen Hufen.\n",
    "Der Minotaurus tritt @WEN mit seinen Hufen.\n",
    DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));

  AddDefaultSpell(2, 500, DS_MASS_DEAF,
    "Der Minotaurus bruell laut und du wirst taub.\n",
    "Der Minotaurus bruell laut und du wirst taub.\n");
}

void die(int poisondeath)
{
  write_file(LOG "npc.kills",
      dtime() + ": " + (CAP(getuid(QueryProp(P_KILLER) || TP)) || "<Unbekannt>") +
      " killt " + name(WEN, 1) + ".\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
        dtime() + ": " + Name(WER, 1) + "hat gerade " + CAP(getuid(player)) +
        " umgebracht.\n");
  }
}
