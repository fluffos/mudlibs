#include "../def.h"

inherit "/std/mnpc";
inherit "/std/npc/spells";

public void create() {
    if(!is_clone(TO)) return;
    ::create();

    AddId("\nkdz_cult_npc");

    SetProp(P_ALIGN, -random(1000));

    if(!random(5)) {
        CLONEME(OBJ "heiltrank");
    }
}

public void init() {
    ::init();
    if (this_player() && this_player()->id("\nkdz_cult_npc")) {
        AddDefender(this_player());
    }
}

public void InformDefend(object enemy) {
  Kill(enemy);
}