#include "../def.h"

inherit NPC "std_cult_npc";

// Globale Variable fuer die Farbe
string color;

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Farbe setzen-----------------------------------------------------------

  // Definiere eine Farbe fuer den Drakonier
  switch (random(5))
  {
    case 0: color = "rot"; break;
    case 1: color = "blau"; break;
    case 2: color = "gruen"; break;
    case 3: color = "schwarz"; break;
    case 4: color = "weiss"; break;
  }

  SetProp(P_COLOR, color);
  SetProp(P_SHORT, "Ein " + color + "er Drakonier");

//--Beschreibungen---------------------------------------------------------

  SetProp(P_LONG,
    "Vor dir steht ein imposanter Drakonier, ein kriegerischer Humanoide mit "
    "drakonischen Zuegen. Sein Koerper ist muskuloes und von dicken Schuppen bedeckt, "
    "die in der Farbe " + color + " leuchten. Er traegt eine maechtige Ruestung, die aus "
    "geschmiedetem Drakonenschuppen besteht, und seine Augen leuchten mit einer intensiven, "
    "bedrohlichen Farbe. Die Anwesenheit dieses Wesens strahlt Macht und Gefahr aus.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Drakonier");
  SetProp(P_GENDER, MALE);
  AddId(({"drakonier", "monster", "drache"}));
  AddClass( ({CL_DRAGON}) );
  SetProp(P_ARTICLE, 1);

//--Eigenschaften----------------------------------------------------------

  create_default_npc(30+random(5));

  SetProp(P_HANDS, ({" mit seinen scharfen Krallen",
                    QueryProp(P_HANDS)[1],
                    ({DT_SLASH})
                    }) );

  SetProp(P_RACE, "Drache");
  SetProp(P_SIZE, 180+random(30));
  SetProp(P_WEIGHT, 8000);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 0.8);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);

  // Resistenz gegen koerperliche Angriffe, anfaellig fuer Magie
  SetProp(P_RESISTANCE_STRENGTHS ,
    ([DT_BLUDGEON: -0.3, DT_PIERCE: -0.3, DT_SLASH: -0.4, DT_SQUEEZE: -0.4, DT_WHIP: -0.4]) );

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "tritt herein");
  SetProp(P_MSGOUT, "tritt");
  SetProp(P_MMSGIN, "taucht aus den Schatten auf, von magischer Energie umgeben");
  SetProp(P_MMSGOUT, "verfaellt in eine massive Explosion, die alles um ihn herum erschuettert");

  SetProp(P_MNPC_AREA, ({  ROOM }) );
  SetProp(P_MNPC_DEFAULTROOM, ROOM "1_g8");
  SetProp(P_MNPC_WAIT, ({ 20, 30, 15 }));
  SetProp(P_MNPC_FLAGS, MOV_MOVES + MOV_BACKWARDS);

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO, " knurrt und bruellt lautstark.\n");

  SetProp(P_SPELLRATE, 20);

//--Zauber-----------------------------------------------------------------

  // Angriffe je nach Farbe des Drakoniers
  switch (color)
  {
    case "rot":
      // Feuersbrunst - Rot
      AddSpell(4, 300,
        "Der " + color + "e Drakonier entfesselt eine gewaltige Feuersbrunst, die dich mit einem heissen, brennenden Schmerz "
        "ueberzieht. Die Flammen tanzen und verzehren alles in ihrer Naehe.\n",
        "Der " + color + "e Drakonier schleudert einen Feuersball auf @WEN, der @PWEN in ein Inferno von Flammen huellt.\n",
        ({DT_FIRE, DT_MAGIC}),
        ([SP_SHOW_DAMAGE:1])
      );
      break;

    case "blau":
      // Blitzschlag - Blau
      AddSpell(4, 300,
        "Der " + color + "e Drakonier entfesselt einen gewaltigen Blitzschlag, der in einem grellen Lichtblitz auf dich zurollt "
        "und elektrische Energie durch deinen Koerper leitet.\n",
        "Der " + color + "e Drakonier schleudert einen Blitzschlag auf @WEN, der @PWEN heftig durchzuckt und elektrisiert.\n",
        ({DT_ELECTRIC, DT_MAGIC}),
        ([SP_SHOW_DAMAGE:1])
      );
      break;

    case "gruen":
      // Terror-Atem - Gruen
      AddSpell(4, 250,
        "Der " + color + " Drakonier atmet einen ekelerregenden, giftigen Dampf aus, der dich mit Angst und Panik erfuellt. "
        "Der Schrecken laehmt dich und du fuehlst dich hilflos.\n",
        "Der " + color + "e Drakonier atmet auf @WEN aus, und @PWEN wird von einem Schauer des Terrors ergriffen, der seine Bewegungen "
        "stark einschraenkt.\n",
        ({DT_POISON, DT_MAGIC}),
        ([SP_SHOW_DAMAGE:1])
      );
      break;

    case "schwarz":
      // Saeure-Atem - Schwarz
      AddSpell(4, 300,
        "Der " + color + "e Drakonier atmet einen aetzenden Saeurestrahl aus, der auf dich trifft und deine Haut mit einem brennenden "
        "Schmerz ueberzieht. Die Saeure frisst sich durch deinen Koerper.\n",
        "Der " + color + "e Drakonier schleudert einen Saeurestrahl auf @WEN, der @PWEN mit einem schmerzhaften aetzenden Effekt beschaedigt.\n",
        ({DT_ACID, DT_MAGIC}),
        ([SP_SHOW_DAMAGE:1])
      );
      break;

    case "weiss":
      // Eisspeer - Weiss
      AddSpell(4, 250,
        "Der " + color + "e Drakonier beschwoert einen scharfkantigen Eisspeer, der auf dich zuschnellt und sich tief in deinen Koerper "
        "bohrt. Die Kaelte durchdringt dein Fleisch und laehmt deine Bewegungen.\n",
        "Der " + color + "e Drakonier schleudert einen Eisspeer auf @WEN, der @PWEN tief verletzt und stark verlangsamt.\n",
        ({DT_COLD, DT_MAGIC}),
        ([SP_SHOW_DAMAGE:1])
      );
      break;

    default:
      // Standardzauber
      AddSpell(4, 250,
        "Der Drakonier entfesselt eine maechtige magische Energie, die dich trifft und dir grossen Schaden zufuegt.\n",
        "Der Drakonier schleudert eine magische Energie auf @WEN, die @PWEN erheblich schaedigt.\n",
        ({DT_MAGIC}),
        ([SP_SHOW_DAMAGE:1])
      );
      break;
  }
}

public int valid_target(object ob) {
    return living(ob) && !ob->QueryProp(P_INVIS) && !ob->QueryProp(P_GHOST) && ob != TO;
}

void die(int poisondeath)
{
  object *targets;
  int i;

  // Alle Objekte in der Umgebung sammeln
  targets = all_inventory(environment(TO));
  // Nur die Objekte auswaehlen, die der Drakonier sehen kann
  targets = filter_array(targets, "valid_target", TO);
  
  // Die Effekte je nach Farbe anwenden
  switch(color)
  {
    case "schwarz":
      for (i = 0; i < sizeof(targets); i++) {
        targets[i]->SetProp(P_WIMPY, targets[i]->QueryProp(P_MAX_HP)); // Erhoeht die Furcht aller Gegner
        tell_object(targets[i], "Der Tod des " + color + "en Drakoniers hat deine Furcht erheblich verstaerkt.\n");
      }
      break;

    case "gruen":
      for (i = 0; i < sizeof(targets); i++) {
        targets[i]->AddPoison(1 + random(4)); // Vergiftet alle Gegner
        tell_object(targets[i], "Der Tod des " + color + "en Drakoniers hat dich mit Gift infiziert.\n");
      }
      break;

    case "blau":
      for (i = 0; i < sizeof(targets); i++) {
        targets[i]->SetProp(P_BLIND, random(10)); // Blendet alle Gegner
        tell_object(targets[i], "Der Tod des " + color + "en Drakoniers hat dich geblendet.\n");
      }
      break;

    case "rot":
      for (i = 0; i < sizeof(targets); i++) {
        targets[i]->Defend(500, DT_FIRE, ([SP_SHOW_DAMAGE: 1]), TO); // Explodiert und schadet allen Anwesenden
        tell_object(targets[i], "Der " + color + "e Drakonier explodiert und verursacht grossen Feuerschaden.\n");
      }
      break;

    case "weiss":
      for (i = 0; i < sizeof(targets); i++) {
        targets[i]->SetProp(P_PARALYZED, random(10)); // Laehmt alle Gegner
        tell_object(targets[i], "Der Tod des " + color + "en Drakoniers hat dich gelaehmt.\n");
      }
      break;

    default:
      tell_room(environment(TO), "Der Drakonier zerfaellt und hinterlaesst nur noch Asche.\n");
      break;
  }

  CLONEME("/p/std/dragons/obj/schuppe");
  present("\nschupp")->AddAmount(random(5));

  // Protokollierung der Toetung
  write_file(LOG "npc.kills",
      dtime() + ": " + (CAP(getuid(QueryProp(P_KILLER) || TP)) || "<Unbekannt>") +
      " hat den maechtigen Drakonier getoetet.\n");

  ::die(poisondeath);
}
