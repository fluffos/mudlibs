#include "../def.h"

inherit NPC "std_cult_npc";

void create()
{
  if(!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein schleimiger Schleim");
  SetProp(P_LONG,
    "Vor dir befindet sich ein schleimiges, amorphes Wesen, das in einem "
    "stetigen, glitschigen Zustand vor sich hin wabert. Die schleimige Masse "
    "ist nahezu durchscheinend und bewegt sich in unregelmaessigen Wellen. "
    "Die Oberflaeche des Schleims scheint staendig zu pulsieren und sich zu "
    "verformen, waehrend du eine unangenehme Feuchtigkeit spuerst, die von ihm ausgeht.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Schleim");
  SetProp(P_GENDER, MALE);
  AddId(({"schleim", "monster"}));
  AddClass( ({}) );
  SetProp(P_ARTICLE, 1);

//--Eigenschaften----------------------------------------------------------

  create_default_npc(20+random(5));

  SetProp(P_HANDS, ({" mit seiner schleimigen Substanz",
                    QueryProp(P_HANDS)[1],
                    ({DT_BLUDGEON})
                    }) );

  SetProp(P_RACE, "Schleim");
  SetProp(P_SIZE, 120+random(30));
  SetProp(P_WEIGHT, 3000);
  SetProp(P_MAX_HANDS, 0); // Kein echtes Hand-Management notwendig
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 0.5);
  SetProp(P_WIMPY, 10);
  SetProp(P_NOMAGIC,0);

  // Resistenz gegen koerperliche Angriffe, anfaellig fuer Feuer und Kaelte
  SetProp(P_RESISTANCE_STRENGTHS ,
    ([DT_BLUDGEON: -0.6, DT_PIERCE: -1.0, DT_SLASH: -0.6, DT_SQUEEZE: -0.4, DT_WHIP: -0.5,
      DT_FIRE: 0.4, DT_COLD: 0.3]) );

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "wabbelt langsam herein");
  SetProp(P_MSGOUT, "schluepft geraeuschlos davon");
  SetProp(P_MMSGIN, "materialisiert sich aus einem feuchten Schleier");
  SetProp(P_MMSGOUT, "zersplittert in eine Pfuetze schleimigen Nebels");

  SetProp(P_MNPC_AREA, ({  ROOM }) );
  SetProp(P_MNPC_DEFAULTROOM, ROOM "1_g9");
  SetProp(P_MNPC_WAIT, ({ 20, 30, 10 }));
  SetProp(P_MNPC_FLAGS, MOV_MOVES + MOV_BACKWARDS);

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO, " wabbert und glibbert unaufhoerlich.\n");
}

//--Defend-----------------------------------------------------------------

int Defend(int dam, string *dam_type, mixed spell, object enemy)
{
  // Heilt sich bei Angriffen durch Magie, Saeure oder Gift
  if (member_array(dam_type, ({DT_MAGIC, DT_ACID, DT_POISON})) != -1) {
    tell_object(TO, "Der Schleim absorbiert deinen Angriff und heilt sich dabei.\n");
    AddHp(dam/10);
    return 0; // Kein Schaden wird zugefuegt, da er sich heilt
  }

  // Rufe die Standard-Verteidigungsfunktion auf
  return ::Defend(dam, dam_type, spell, enemy);
}

void die(int poisondeath)
{
  write_file(LOG "npc.kills",
      dtime() + ": " + (CAP(getuid(QueryProp(P_KILLER) || TP)) || "<Unbekannt>") +
      " hat den schleimigen Schleim getoetet.\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
        dtime() + ": " + Name(WER, 1) + " hat " + CAP(getuid(player)) +
        " in einem schleimigen Angriff getoetet.\n");
  }
}
