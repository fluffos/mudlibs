#include "../def.h"
#include <combat.h>

inherit NPC "std_cult_npc";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

  //--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ragnulf, der Champion der Monstermutter");
  SetProp(P_LONG,
    "Vor dir steht ein grimmiger Zwerg, gehuellt in schwarze Ruestung, die "
    "unter einem unsichtbaren Hauch von Korruption zu atmen scheint. Ragnulf "
    "ist der gefuerchtete Champion der Monstermutter, ein verderbter Antipaladin, "
    "dessen einst edler Geist nun der Dunkelheit anheimgefallen ist. Seine Augen "
    "gluehen in einem unheilvollen Rot, waehrend ein teuflisches Laecheln sein "
    "baertiges Gesicht entstellt.");

  //--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Ragnulf");
  SetProp(P_GENDER, MALE);
  AddId(({"ragnulf", "champion", "antipaladin", "zwerg", "monster", "NOCONTROL", "NOWIMPY", "\nkdz_ragnulf"}));
  SetProp(P_ARTICLE, 0);

  //--Eigenschaften----------------------------------------------------------

  create_default_npc(37);

  SetProp(P_HANDS, ({" mit seinem verfluchten Schwert", 
                    QueryProp(P_HANDS)[1],
                    ({DT_SLASH})
                    }) );

  SetProp(P_RACE, "Zwerg");
  SetProp(P_SIZE, 125);  // Zwergengroesse
  SetProp(P_WEIGHT, 8500);
  SetProp(P_MAX_HANDS, 2);  // Benutzt ein grosses, verfluchtes Schwert
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 0);
  SetProp(P_WIMPY, 0);

  SetProp(P_RESISTANCE_STRENGTHS, 
    ([DT_MAGIC: -0.3, DT_MIND: -0.3, DT_POISON: -0.5, DT_ACID: -0.5, DT_UNHOLY: -0.6,
      DT_WATER: 0.1, DT_HOLY: 0.2, DT_FIRE: -0.1, DT_LIGHT: 0.2 ]) );

  //--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "marschiert mit schweren Schritten herein.");
  SetProp(P_MSGOUT, "maschiert");
  SetProp(P_MMSGIN, "manifestiert sich aus einem Schattenportal.");
  SetProp(P_MMSGOUT, "verschwindet in einem Nebel aus Dunkelheit.");

  SetProp(P_MNPC_AREA, ({ROOM}) );
  SetProp(P_MNPC_DEFAULTROOM, ROOM "1_g6");
  SetProp(P_MNPC_WAIT, ({15, 30, 10}));
  SetProp(P_MNPC_FLAGS, 0);

  //--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO, " lobpreist die Monstermutter mit lauter Stimme.\n");

  //--Angriffe---------------------------------------------------------------

  SetProp(P_SPELLRATE, 33);

  // Angriff: Verfluchter Schlag
  AddSpell(2, 300,
    "Ragnulf schwingt sein verfluchtes Schwert in einem zerstoererischen Bogen und trifft dich mit unheiliger Macht!\n",
    "Ragnulf trifft @WEN mit einem verfluchten Schlag seines Schwertes, und du siehst, wie die unheilige Energie in @WEM1 Koerper eindringt.\n",
    ({DT_SLASH, DT_UNHOLY}),
    ([SP_SHOW_DAMAGE:1])
  );

  // Angriff: Korrupter Blick
  AddSpell(3, 250,
    "Ragnulf richtet seinen verderbten Blick auf dich und du spuerst, wie deine Seele von Dunkelheit durchdrungen wird!\n",
    "Ragnulf schaut @WEN an, und eine Welle der Verderbnis ueberkommt @WEM.\n",
    ({DT_UNHOLY, DT_POISON}),
    ([SP_SHOW_DAMAGE:1])
  );

  //--Aura der Verderbnis----------------------------------------------------

  // Reduziert die Ruestung der Gegner mit dem Effekt der Aura
  AddDefaultSpell(1, 1, DS_REDUCE_AC,
    "Eine Aura der Verderbnis umgibt Ragnulf und schwaecht deine Ruestung.\n",
    "Die Aura der Verderbnis von Ragnulf erfasst @WEN und schwaecht @WESSEN Ruestung.\n",
    5  // Staerkere Reduzierung der Ruestung
  );

  //--Hieb der Furcht--------------------------------------------------------
  AddDefaultSpell(2, 333, DS_FEAR,
    "Ragnulf trifft dich mit seinem Schwert und ungeahnte Furcht ueberkommt dich!\n",
    "Ragnulf trifft @WEN mit seinem Schwert und @PWESSEN Augen weiten sich vor Furcht.\n"
  );


  CLONEME(WEAPON "ragnulf_schwert");
  command_me("zuecke schwert");

  CLONEME("/p/armour/armour/plattenpanzer");
  if(objectp(present("plattenpanzer", ME))) {
    if(!random(3)) {
        present("plattenpanzer", ME)->SetProp(P_CURSED, 1);
        if(!random(2)) present("plattenpanzer", ME)->SetProp(P_M_ATTR_MOD, ([A_STR: -2, A_CON: -2]) );
        else present("plattenpanzer", ME)->SetProp(P_M_ATTR_MOD, ([A_STR: 2, A_CON: 2]) );
        present("plattenpanzer", ME)->SetProp(P_INFO, BS("Dieser Plattenpanzer ist von der verderbten Aura Ragnulfs durchdrungen und "
            "schwaecht die geistigen und koerperlichen Faehigkeiten des Traegers.") );
    }

    present("plattenpanzer", ME)->SetProp(P_SHORT, "Ragnulfs Plattenpanzer");
    command_me("trage alles");
  }

  CLONEME(OBJ "eisenschluessel");
  
}

//--Sterben----------------------------------------------------------------

void die(int poisondeath)
{
write_file(LOG "npc.kills",
    dtime() + ": " + (CAP(getuid(QueryProp(P_KILLER) || TP)) || "<Unbekannt>") +
    " hat Ragnulf, den Champion der Monstermutter, getoetet.\n");

::die(poisondeath);
}
