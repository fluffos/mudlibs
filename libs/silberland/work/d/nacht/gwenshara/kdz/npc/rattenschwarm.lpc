#include "../def.h"

inherit NPC "std_cult_npc";

void create()
{
  if(!is_clone(TO)) return;

  ::create();
//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein Rattenschwarm wuselt zwischen deinen Beinen herum");
  SetProp(P_LONG,
    "Du stehst in Mitten eines widerlichen Schwarms von uebrgrosser Ratten. "
    "Ihre kleinen pelizgen Koerper sind TUmoren und Geschwueren uebersaeaet.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Rattenschwarm");
  SetProp(P_GENDER, MALE);
  AddId(({"schwarm", "rattenschwarm"}));
  AddClass( ({CL_ANIMAL}) );
  SetProp(P_ARTICLE, 1);

//--Eigenschaften----------------------------------------------------------

  create_default_npc(15+random(5));

  SetProp(P_HANDS, ({" mit unzaehligen kleinen Maeulern",
                    QueryProp(P_HANDS)[1],
                    ({DT_PIERCE})
                    }) );

  SetProp(P_RACE, "Ratte");
  SetProp(P_SIZE, 100+random(100));
  SetProp(P_WEIGHT, 25000);
  SetProp(P_MAX_HANDS, 999);
  SetProp(P_HEAL, 0);
  SetProp(P_AGGRESSIVE, 0.2);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC,0);

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" kann nichts tragen.\n" }) );

  SetProp(P_LOG_INFO, MAGIERNAME + "/" + explode(ZONE, "/")[<1] + ".log" );

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([DT_EXPLOSION: 0.2, DT_SLASH: -0.3, DT_RIP: -0.7, DT_BLUDGEON: -0.3,
      DT_SQUEEZE: -0.1, DT_WHIP: 0.2
     ]) );

//--Bewegungen-------------------------------------------------------------

  SetProp(P_MSGIN, "wuselt herein");
  SetProp(P_MSGOUT, "wuselt");
  SetProp(P_MMSGIN, "erscheint in einer Rauchwolke");
  SetProp(P_MMSGOUT, "verschwindet mit Knall und Schwefelduft");

  SetProp(P_MNPC_AREA, ({  ROOM }) );
  SetProp(P_MNPC_DEFAULTROOM, ROOM "1_g8");
  SetProp(P_MNPC_WAIT, ({ 40, 50, 10 }));
  SetProp(P_MNPC_FLAGS, MOV_MOVES + MOV_BACKWARDS);

//--Infos------------------------------------------------------------------

  AddInfo(DEFAULT_INFO, " quiekt.\n");
}

void die(int poisondeath)
{
  write_file(LOG "npc.kills",
      dtime() + ": " + (CAP(getuid(QueryProp(P_KILLER) || TP)) || "<Unbekannt>") +
      " killt " + name(WEN, 1) + ".\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
        dtime() + ": " + Name(WER, 1) + "hat gerade " + CAP(getuid(player)) +
        " umgebracht.\n");
  }
}
