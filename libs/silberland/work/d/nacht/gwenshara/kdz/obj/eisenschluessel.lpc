
#include "../def.h"

inherit "std/thing";

#include <properties.h>

void create() 
{
  if (!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Eisenschluessel");
  SetProp(P_LONG,
    "Dieser Schluessel ist gross und dick. Er ist aus Eisen und schon etwas "
    "angerostet." );
  SetProp(P_NAME, "Eisenschluessel");
  SetProp(P_GENDER, MALE);
  AddId( ({"schluessel", "eisenschluessel", "KEY", "\nkdz_ironkey"}));

  SetProp(P_MATERIAL, MAT_IRON );
  SetProp(P_WEIGHT, 200);
  SetProp(P_VALUE, 50);
  SetProp(P_NOBUY, 1);

}

public string QueryDoorKey() {
    return ROOM "1_f7:"+ROOM "1_g7";
}

