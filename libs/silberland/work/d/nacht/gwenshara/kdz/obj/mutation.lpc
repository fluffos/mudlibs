#include "../def.h"

inherit "/std/thing";

public void create() {
    if(!is_clone(TO)) return;
    
    ::create();

    SetProp(P_NAME, "Mutation");
    SetProp(P_SHORT, "Eine Mutation");
    SetProp(P_INVIS, 1);
    AddId("Krankheit", "\nkdz_mutation");

    call_out("mutate", 30 + random(120));
}

public void mutate() {
    object owner;

    owner = environment(this_object());
    if(!objectp(owner)) {
        remove();
        return;
    }

    if(!living(owner)) {
        remove();
        return;
    }

    switch(random(random(14))) {
        case 0:
            SetProp(P_X_ATTR_MOD, ([A_INT: -1 - random(4)]));
            tell_object(owner, BS("Waaaargh! Dein Kopf tut weh, als sich in deinem Gehirn ein Tumor durch Mutation bildet."));
            break;
        case 1:
            SetProp(P_X_ATTR_MOD, ([A_DEX: -1 - random(4)]));
            tell_object(owner, BS("Du spuerst, wie sich deine Gelenke durch eine Mutation versteifen und du dich immer langsamer bewegen kannst."));
            break;
        case 2:
            SetProp(P_X_ATTR_MOD, ([A_STR: -1 - random(4)]));
            tell_object(owner, BS("Eine Mutation laesst deine Muskeln schwinden und du fuehlst dich immer schwaecher."));
            break;
        case 3:
            SetProp(P_X_ATTR_MOD, ([A_CON: -1 - random(4)]));
            tell_object(owner, BS("Deine inneren Organe mutieren und du fuehlst dich krank und schwach."));
            break;
        case 4:
            SetProp(P_X_HEALTH_MOD, ([P_HP: -1 - random(10)]));
            tell_object(owner, BS("Du fuehlst dich krank und schwach, als sich eine Mutation in deinem Koerper ausbreitet."));
            break;
        case 5:
            SetProp(P_X_HEALTH_MOD, ([P_SP: -1 - random(10)]));
            tell_object(owner, BS("Eine Mutation an deinem Astralkoerper schwaecht deine magischen Kraefte."));
            break;
        case 7:
            owner->AddResistanceModifier(([DT_FIRE: -0.1 - random(5)/10.0]));
            tell_object(owner, BS("Eine Mutation laesst deine Haut trotcken und brennbar werden."));
            break;
        case 8:
            owner->AddResistanceModifier(([DT_COLD: -0.1 - random(5)/10.0]));
            tell_object(owner, BS("Eine Mutation laesst dich frieren und deine Haut wird empfindlich gegen Kaelte."));
            break;
        case 9:
            owner->AddResistanceModifier(([DT_WATER: -0.1 - random(5)/10.0]));
            tell_object(owner, BS("Eine Mutation laesst dich allergisch gegen Wasser werden."));
            break;
        case 10:
            owner->AddResistanceModifier(([DT_SLASH: -0.1 - random(5)/10.0, 
                                           DT_PIERCE: -0.1 - random(5)/10.0, 
                                           DT_BLUDGEON: -0.1 - random(5)/10.0,
                                           DT_SQUEEZE: -0.1 - random(5)/10.0,
                                           DT_WHIP: -0.1 - random(5)/10.0]));
            tell_object(owner, BS("Eine Mutation laesst deine Haut empfindlich und duenn werden."));
            break;
        case 11:
            owner->AddResistanceModifier(([DT_ACID: -0.1 - random(5)/10.0]));
            tell_object(owner, BS("Eine Mutation laesst deine Haut poroes werden wodurch sie Saeure schneller aufnimmt."));
            break;
        case 12:
            owner->AddResistanceModifier(([DT_POISON: -0.1 - random(5)/10.0]));
            tell_object(owner, BS("Dein Blut mutiert und wird anfaelliger gegen Gift."));
            break;
        case 13:
            owner->AddResistanceModifier(([DT_LIGHT: -0.1 - random(5)/10.0]));
            tell_object(owner, BS("Deine Augen mutieren und werden empfindlich gegen Licht."));
            break;
        default:
            owner->AddPoison(5 + random(5));
            tell_object(owner, BS("Du spuehrst eine Mutation durch dein Blut rasen, die dich schwer vergiftet!"));
            break;
    }

    owner->UpdateAttributes();
    owner->UpdateResistanceStrengths();

    set_next_reset(300 + random(600));
    return;
}

public void reset() {
    ::reset();
    if(!is_clone(TO)) return;

    if(objectp(environment(this_object()))) {
        tell_object(environment(this_object()), BS("Eine Mutation in deinem Koerper bildet sich zurueck."));
    }

    remove();
    return;
}