#include "../def.h"

inherit "std/food";     

#include <food.h>

private int spoiled;

void create()
{
  if(!is_clone(this_object())) return; 
  ::create();

  if(!random(5)) spoiled = 1;

  SetProp(P_SHORT, "Ein kleiner Heiltrank");
  SetProp(P_LONG,
    "Ein kleiner Phlakon der einen blauen Heiltrank enthaelt."
  );

  if(spoiled) {
    SetProp(P_INFO, BS("Igitt! Der Heiltrank ist offenbar verdorben!"));
  }

  SetProp(P_GENDER, MALE);
  SetProp(P_NAME, "Heiltrank");
  AddId( ({ "trank", "heiltrank" }) );

  SetProp(P_NAME_ADJ, ({"klein"}) );
  AddAdjective( ({"kleinen","kleiner","kleinem","kleines","kleine"}) );

  SetProp(P_WEIGHT, 100);
  SetProp(P_VALUE, 50); 
  SetProp(P_MATERIAL, ([ MAT_GLASS:20, MAT_WATER:80 ]) );


  SetProp(P_FOOD_INFO,
      ([
         F_HEAL    : ({ 5 + random(30), 5 + random(30) }),
         F_SOAK    : 0,
         F_DRINK   : random(10),
         F_ALCOHOL : 0,
         F_POISON  : spoiled * random(3),
         F_MSG     : "Du kippst den Heiltrank herunter.",
         F_MSG_ROOM: "kippt sich einen Heiltrank rein.",
         F_VERB    : "trinken"      
      ]) );

  AddCmd(({"trink", "trinke"}), "eat");
}
