#include "../def.h"
inherit ROOM "std_room";

public void create() {
    ::create();
    SetProp(P_INT_LONG, 
        "Hier stehst du im suedlichen Teil der Tempelhalle der Monstermutter. Grosse Saeulen "
        "aus schwwarzem Stein ragen links und rechts von dir auf. Im Norden erkennst du "
        "einen grossen Altar, der sich dort erhebt.");
        
    AddExit("norden", ROOM "1_g6");
    AddExit("sueden", ROOM "1_g8");

    NewDoor("westen", ROOM "1_f7", ({"tuer", "eisentuer"}), ({
        D_NAME, "Eisentuer",
        D_GENDER, FEMALE,
        D_SHORT, "Eine %ss Eisentuer fuehrt nach Westen.",
        D_LONG, "Die Eisentuer ist einfach gehalten.",
        D_FLAGS, DOOR_CLOSED+DOOR_NEEDKEY+DOOR_RESET_CL,

    }));

    SetThreatLevel(3);
    AddItem(NPC "kultist", REFRESH_DESTRUCT);
}
