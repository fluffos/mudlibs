#include "../def.h"

inherit ROOM "std_room";

private int doorOpen;

public void create() {
    ::create();
    SetProp(P_INT_SHORT, "In einer Hoehle vor einem Bronzetor");
    SetProp(P_INT_LONG, 
        "Du stehst in einer Hoehle, die aus dem natuerlichen Fels geschlagen wurde. "
        "Finstere Schatten tanzen an den Waenden, und die Luft ist feucht und kalt. "
        "Vor dir erhebt sich ein grosses Bronzetor im Fels, das dir den weiteren Weg "
        "versperrt.\n@@door@@");

    doorOpen = 0;

    AddCmd( ({"setze", "setz", "stecke", "steck"}), "cmd_einsetzen");
    AddCmd( CMD_OEFFNEN, "cmd_oeffnen");

    SetThreatLevel(-1);
}

public string door() {
    if(doorOpen) return "Das Tor steht offen und gibt den Weg frei.";
    return "Das Tor ist geschlossen und versperrt den Weg.";
}

public int cmd_einsetzen(string str) {
    string was, wo;
    object ob;

    notify_fail("Was willst Du wo einsetzen?\n");
    if(!str || str == "") return 0;
    if(sscanf(str, "%s in %s", was, wo) != 2) return 0;

    if(!objectp(ob=present(was, this_player()))) {
        write("Sowas hast du nicht bei dir.\n");
        return -1;
    }

    if(wo != "tor" && wo != "bronzetor" && wo != "herz" && wo != "einbuchtung") {
        write("Das kannst du hier nicht einsetzen.\n");
        return -1;
    }

    if(!ob->id("nachtamulett")) {
        write("Das passt hier nicht hinein.\n");
        return -1;
    }

    write("Du presst das Nachtamulett in die Einbuchtung am Tor. Mit einem Knirschen und Rattern schwenkt es auf.\n");
    tell_room(this_object(), this_player()->Name(WER) + " drueckt etwas ans Tor, das mit einem Knirschen und Rattern aufschwingt.\n");

    doorOpen = 1;

    AddExit("osten", ROOM "eingang_2");
    
    return 1;
}

public int cmd_oeffnen(string str) {
    notify_fail("Was willst Du oeffnen?\n");
    if(str != "tor" && str != "bronzetor") return 0;


    write("Das Tor laesst sich nicht einfach so oeffnen.\n");
    return 1;
}

public void reset() {
    ::reset();
    
    if(doorOpen) {
        doorOpen = 0;
        RemoveExit("osten");
        tell_room(this_object(), "Das Tor schwingt langsam wieder zu.\n");
    }
}
