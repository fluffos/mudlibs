#include "../def.h"
inherit ROOM "std_room";

private object *prayed;

public void create() {
    ::create();
    SetProp(P_INT_LONG, 
        "Dieser Gang fuehrt geradewegs vom Tor im Sueden zu einer grossen Halle im Norden. "
        "An den Waenden stehen, links und rechts, mehrere Ruestungen auf Podesten, die wohl "
        "die vernichteten Feinde des Kults darstellen.");

    AddExit("norden", ROOM "1_g7");
    NewDoor("sueden", ROOM "1_g9", ({"tor", "steintor"}), ({
        D_FLAGS, DOOR_CLOSED|DOOR_RESET_CL,
        D_SHORT, "Ein %ses Steintor versperrt den Weg nach Norden.",
        D_NAME, "Steintor",
    }));

    SetThreatLevel(1);
}
