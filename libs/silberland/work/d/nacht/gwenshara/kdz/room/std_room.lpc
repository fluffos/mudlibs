#include "../def.h"

inherit "/d/nacht/gwenshara/std_twilight_room";

private int roomLevel;

public void create() {
    ::create();
    SetProp(P_INT_SHORT, "Im Heiligtum der Monstermutter");
    SetProp(P_INT_LONG, "Ein Standardraum, der als Vorlage fuer andere Raeume dienen soll.");
    

    SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:20, ENV_TERRAIN: TT_CAVE, ENV_FLAGS: EF_INDOORS]) );
    SetProp(P_INDOORS, 1);
    SetProp(P_LIGHT, 0);
}

public void createThreat() {
    string threatFile;
    int n, i;

    n = 1 + roomLevel/3;
    for(i=0; i<n; i++) {
        switch(random(15)+1) {
            case 1: threatFile = 0; break;
            case 2: threatFile = NPC "gruftassel"; break;  // done
            case 3: threatFile = NPC "rattenschwarm"; break; // done
            case 4: threatFile = NPC "gremlin"; break; // done
            case 5: threatFile = NPC "kultist"; break; // done
            case 6: threatFile = NPC "mutantenfledermaus"; break; // done
            case 7: threatFile = NPC "wolfsechse"; break; // done
            case 8: threatFile = NPC "minotaur"; break; // done
            case 9: threatFile = NPC "priester"; break; // done
            case 10: threatFile = NPC "ogerzauberer"; break; // done
            case 11: threatFile = NPC "rosenritter"; break; // done
            case 12: threatFile = NPC "mutierter_krabbler"; break; // done
            case 13: threatFile = NPC "ooze"; break; // done
            case 14: threatFile = NPC "fliegenmonster"; break;
            case 15: threatFile = NPC "drakonier"; break;
            default: threatFile = 0; break;
        }

        if(threatFile) {
            AddItem(threatFile, REFRESH_DESTRUCT);
        }
    }
}

public void SetThreatLevel(int level) {
    roomLevel = level;
    if(roomLevel < 1) return;

    if(random(10) < level) {
        createThreat();
    }
    return;
}