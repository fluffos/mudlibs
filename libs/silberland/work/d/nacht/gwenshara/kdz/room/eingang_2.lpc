#include "../def.h"

inherit ROOM "std_room";

#define MONOLITH_NORTH 0
#define MONOLITH_NORTHEAST 1
#define MONOLITH_SOUTHEAST 2
#define MONOLITH_SOUTH 3
#define MONOLITH_SOUTHWEST 4
#define MONOLITH_NORTHWEST 6
#define MONOLITH_EAST 5

#define MONOLITH_ORDER ({MONOLITH_NORTH, MONOLITH_EAST, MONOLITH_SOUTH, MONOLITH_NORTHWEST, MONOLITH_NORTHEAST, MONOLITH_SOUTHEAST, MONOLITH_SOUTHWEST})

private int lastMonolith, nextMonolith, touches, mantikor;
private string monolithStatus;

public void create() {
    ::create();
    SetProp(P_INT_SHORT, "An der Tempelpforte der Monstermutter");
    SetProp(P_INT_LONG, 
        "Dieser Innenhof ist mit grosser Muehe aus dem schwarzen Stein "
        "geschlagen. In jeder Himmelsrichtung, ausser im Osten, steht jeweils "
        "ein grosser Monolith. Mittem im Hof steht eine grosse, kreisrunde "
        "Platte, wie ein Tisch. eber dir funkeln Sterne in kaltem Glanz am "
        "Nachthimmel.\n"
        "@@mantikor_long@@\n"
        "Der Boden unter dir besteht aus @@treppe_long@@");

    AddDetail(({"platte", "tisch"}),
        "Die Platte ist aus dem gleichen schwarzen Stein wie der Rest des Hofes. In ihrer Mitte ist ein "
        "kristallenes Prisma eingelassen, dass das spaerliche Licht der Sterne streut. An der Oberseite ist "
        "das Relief einer Landkarte eingraviert. Am Rand der Platte kannst du eine Inschrift erkennen.");
    
    AddDetail( ({"rand", "inschrift" "symbole", "symbolen"}),
        "Die Inschrift ist ein in kantigen Symbolen eingemeisseltes Gedicht. Du kannst es lesen.");
    
    AddDetail( ({"relief", "landkarte"}),
        "Die Landkarte zeigt eine Welt, die du nicht kennst. Die Kontinente sind anders geformt, und die "
        "Meere haben andere Namen. Einige Inseln sind mit seltsamen Symbolen markiert, die du nicht deuten kannst. "
        "Rundherum sind Sterne und ein Mond eingraviert.");

    AddDetail( ({"oberseite"}),
        "Die Oberseite der Steinplatte hat ein Relief eingraviert und ein kristallenes Prisma genau in der Mitte eingelassen.");

    AddDetail( ({"prisma"}),
        "Das Prisma ist aus klarem Bergkristall. Wenn du hindurchschaust erkennst du eine Landkarte, die sich von der an der "
        "Oberseite der Platte unterscheidet. Genau kannst du sie nicht erkennen.");

    AddDetail( ({"durch prisma"}),
       "Du schaust durch das Prisma und erkennst eine Landkarte, die dem Silberland sehr aehnlich sieht. Sie ist zu "
       "verschwommen um sie genau zu erkennen. Wo sie sich wohl befindet?");

    AddDetail( ({"unterseite"}),
       "Wenn du die Platte von unten betrachtest erkennst du ebenfalls eine Landkarte! Sie sieht aus, wie das Silberland und "
       "ist von Sonnen umrahmt. Das Prisma ist auch hier exakt in der Mitte. Du erkennst verschiedene Regionen rund um das "
       "Prisma angeordnet. Du erkennst die Polarregion im Norden, die Wueste im Osten, den Dschungel "
       "im Sueden, das Gebirge im Nordwesten, das Huegelland im Nordosten, den Kristallwald im Suedosten und die Ebene im Suedwesten. "
       "Hm. Ganz korrekt ist die Karte aber nicht.");

    AddReadDetail( ({"inschrift", "schrift", "gedicht"}),
        "Es handelt sich um ein Gedicht, dass in den Stein eingeritzt wurde:\n\n"
        "Sieben uralte Waechter, im Kreis verdingt,\n"
        "Verbergen das Tor, wo die Mutter ihre Kinder verschlingt\n"
        "In geheimer Beruehrung liegt der Pfad,\n"
        "auf dem der Bestien heimkehr naht.\n"
        "\n"
        "Wo ewiger Frost die Erde küsst,\n"
        "Der erste Wächter verborgen ist.\n"
        "Dort, wo Eis die Sterne spiegelt klar,\n"
        "Im Polarkreis findest du ihn, nah.\n"
        "\n"
        "Wo brennend Hitze und endlos weitet\n"
        "Der zweite Waechter dir den Weg bereitet.\n"
        "Wo Sand tanzt im gluehenden Wind\n"
        "Finde ihn, wo Leben kaum beginnt.\n"
        "\n"
        "Nun schreite hin, wo das Leben bebt,\n"
        "Wo grünes Blatt und Echse lebt.\n"
        "Im Dickicht tief, dort ruht der Dritte,\n"
        "Verborg'n im Reich der Wilden Sitte.\n"
        "\n"
        "Wo Gipfel sich zum Himmel recken,\n"
        "Und kalte Felsen das Land bedecken,\n"
        "Dort, im Berge karg und rein,\n"
        "Wartet der vierte Waechter zwergenklein.\n"
        "\n"
        "Dann such im Land der sanften Hügel,\n"
        "Wo Wellen von Gras und Blumen wiegen,\n"
        "Den fünften Waechter, versteckt und still,\n"
        "Wo sanft der Haarfuss schlafen will.\n"
        "\n"
        "Im Wald aus Kristall, wo Licht sich klart,\n"
        "Der sechste Waechter deiner harrt.\n"
        "Von schimmerndem Glas und leuchtendem Baum,\n"
        "In diesem Wald erwacht der Traum.\n"
        "\n"
        "Zuletzt das Land darliegt flach und eben,\n"
        "Wo Gras und Himmel sich verweben.\n"
        "Der Waechter Letzter, im Feld verborgen,\n"
        "Wird dir öffnen das Tor zum letzten Morgen.\n"
        "\n"
        "Mit allen acht, das Tor wird sich zeigen,\n"
        "Und du wirst vor dem ersten Kind der Mutter schweigen.\n");

    AddCmd( ({"beruehre", "beruehr"}), "cmd_beruehren");

    mantikor = 1;
    nextMonolith = MONOLITH_ORDER[0];
    touches = 0;

    AddExit("westen", ROOM "eingang_1");

    SetThreatLevel(-1);
}

public int cmd_beruehren(string was) {
    string welchen;
    object waechter;
    int touchedMonolith;

    notify_fail("Welchen Monolith willst Du beruehren?\n");
    if(!was || was == "") return 0;
    if(sscanf(was, "%s monolith", welchen) != 1) return 0;
    if(welchen != "noerdlichen" && welchen != "nordoestlichen" && welchen != "oestlichen" && 
       welchen != "suedoestlichen" && welchen != "suedlichen" && welchen != "suedwestlichen" && welchen != "nordwestlichen") {
        write("Welchen Monolithen (noerdlichen, oestlichen, ...) willst du beruehren?\n");
        return -1;
    }

    switch(welchen) {
        case "noerdlichen": touchedMonolith = MONOLITH_NORTH; break;
        case "nordoestlichen": touchedMonolith = MONOLITH_NORTHEAST; break;
        case "oestlichen": touchedMonolith = MONOLITH_EAST; break;
        case "suedoestlichen": touchedMonolith = MONOLITH_SOUTHEAST; break;
        case "suedlichen": touchedMonolith = MONOLITH_SOUTH; break;
        case "suedwestlichen": touchedMonolith = MONOLITH_SOUTHWEST; break;
        case "nordwestlichen": touchedMonolith = MONOLITH_NORTHWEST; break;
        default:
            write(BS("Diesen Monolithen gibt es hier nicht."));
            return -1;
    }

    if(touchedMonolith != nextMonolith) {
        write(BS("Du beruehrst den "+welchen+" Monolithen und mit einem Mal erstirbt das leise Summen das von den Monolithen ausgeht. Nichts passiert."));
        say(BS(this_player()->Name(WER) + " beruehrt den "+welchen+" Monolithen und nichts passiert."));
        lastMonolith = -1;
        nextMonolith = MONOLITH_ORDER[0];
        touches = 0;
        return -1;
    }

    touches++;
    if(touches >= sizeof(MONOLITH_ORDER)) {
        write(BS("Du beruehrst den "+welchen+" Monolithen. Ein heller Lichtstrahl verbindet alle Monolithen."));
        say(BS(this_player()->Name(WER) + " beruehrt den "+welchen+" Monolithen. Ein heller Lichtstrahl verbindet alle Monolithen."));
        touches = -1;
        call_out("opening_sequence", 0, 0);
    } else {
        write(BS("Du beruehrst den "+welchen+" Monolithen und spuerst ein leises Summen, das von den Monolithen ausgeht. Es klingt, als ob sich etwas veraendert haette."));
        say(BS(this_player()->Name(WER) + " beruehrt den "+welchen+" Monolithen und du hoerst ein leises Summen, das von den Monolithen ausgeht."));
        lastMonolith = touchedMonolith;
        nextMonolith = MONOLITH_ORDER[touches];
    }

    return 1;
}

public void opening_sequence(int step) {
    object ob;

    if(step > 3) return;

    switch(step) {
        case 0:
            tell_room(this_object(), BS("Ein helles Licht blendet dich und du siehst, wie sich die Monolithen in den Boden senken."));
            break;
        case 1:
            tell_room(this_object(), BS("Die Statue des Mantikors beginnt zu zittern und nach und nach broeckelt eine Schicht Stein von ihm ab."));
            break;
        case 2:
            tell_room(this_object(), BS("Der Mantikor hat sich aus seiner Steinschicht befreit und erwacht fauchend und bruellend zum Leben!"));
            mantikor = 0;
            ob = clone_object(NPC "mantikor");
            ob->move(this_object(), M_NOCHECK);
            break;
        case 3:
            tell_room(this_object(), BS("Die kreisrunde Platte in der Mitte des Hofes senkt sich in den Boden und gibt den Blick auf einen Abgang frei."));
            AddGuardedExit("unten", ROOM "1_c0", "\nkdz_mantikor", "Der Mantikor versperrt dir den Weg nach unten.\n");
            break;
        default:
            raise_error("Invalid step in opening_sequence.\n");
            break;
    }

    call_out("opening_sequence", 4, step+1);
    return;
}

public string mantikor_long() {
    if(mantikor) return "Die lebensgrosse Statue eines Mantikors steht hinter der Platte. ";
    return "";
}

public string treppe_long() {
    if(member(QueryProp(P_EXITS), "unten")) {
        return "aus einer Treppe die nach unten fuehrt. ";
    }

    return "aus dem Mosaik einer vielkoepfigen Bestie.";
}

public void reset() {
    ::reset();

    if(touches == -1) {
        touches = 0;
        nextMonolith = MONOLITH_ORDER[0];
        tell_room(this_object(), "Die Monolithen erheben sich wieder aus dem Boden und leuchten einmal kurz auf.\n");
    }
    
    if(member(QueryProp(P_EXITS), "unten")) {
        RemoveExit("unten");
        tell_room(this_object(), BS("Der Abgang nach unten ist wieder verschlossen."));

    }
    if(!mantikor) {
        tell_room(this_object(), "Die Statue des Mantikors ist wieder da.\n");
        mantikor = 1;
    }
}
