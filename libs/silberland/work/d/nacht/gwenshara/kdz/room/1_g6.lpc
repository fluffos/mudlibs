#include "../def.h"
inherit ROOM "std_room";

private object *prayed;

public void create() {
    ::create();
    SetProp(P_INT_LONG, 
        "Du stehst hier mitten in der Tempelhalle der Monstermutter. Ein paar Stufen fuehren "
        "hier zu einem grossen Altar aus schwarzem Stein, der mit Blutspritzern ueberzogen "
        "ist. Durch eine Glaskuppel faellt diffuses, gruenliches Licht auf dich herab. Die "
        "Halle zieht sich nach Norden und Sueden weiter. Im Osten fuehrt eine kleine Holztuer "
        "in einen kleineren Raum.");

    AddExit("sueden", ROOM "1_g7");
    AddExit("norden", ROOM "1_g5");
    AddExit("osten", ([EX_DEST: ROOM "1_h6", EXG_ID: "\nkdz_ragnulf", EXG_PLMSG: "Ragnulf laesst dich nicht durch!\n"]));

    SetThreatLevel(1);

    AddItem(NPC "ragnulf", REFRESH_REMOVE);

    AddCmd(({"bete", "bet"}), "cmd_beten");

    prayed = ({ });
}

public int cmd_beten(string str) {
    object ob;

    if (!str) {
        write("Wen moechtest du anbeten?\n");
        return 1;
    }

    if (member(prayed, this_player()) != -1) {
        write("Du hast gerade erst gebetet.\n");
        return 1;
    }

    say(this_player()->Name(WER) + " kniet nieder und betet.\n");
    if(str != "zur mutter" && str != "zur monstermutter" && str != "zu echnida") {
        write(BS("Nichts passiert.\n"));
        return -1;
    }

    write("Du kniest nieder und betest zu Echnida, der Monstermutter.\n");

    if (random(100) < 50) {
        write("Dein Gebet wird erhört. Du fuehlst dich von der Mutter aller Monster gesegnet!\n");
        TP->AddHp(25 + random(200));
        ob = clone_object(OBJ "mutation");
        if(ob->move(TP) != 1) {
            destruct(ob);
        }
    } else {
        write("Dein Gebet wird nicht erhört.\n");
    }

    prayed += ({ this_player() });
    return 1;
}

public void reset() {
    ::reset();

    prayed = ({ });

    return;
}
