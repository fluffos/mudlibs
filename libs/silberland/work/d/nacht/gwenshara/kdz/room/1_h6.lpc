#include "../def.h"
inherit ROOM "std_room";

private int mimik, *kisten;

public void create() {
    ::create();
    SetProp(P_INT_LONG, 
        "Hier befindest du dich in einem einfachen Schlafquartier. Drei einfache Hochbetten stehen "
        "unotiviert im Raum. Hier schlafen und ruhen die Kultisten wohl, wenn sie gerade keine ueblen "
        "Taten verrichten. Vor jedem der Hochbetten steht eine Kiste.");

    AddExit("westen", ROOM "1_g6");

    SetThreatLevel(4);

    AddCmd(({"oeffne", "oeffen"}), "cmd_oeffne");
    AddCmd(({"nimm", "nehme", "nehm"}), "cmd_nimm");

    mimik = random(3);
    kisten = ({ 0, 0, 0 });
}

public int cmd_oeffne(string str) {
    object ob;
    int welche;

    // zwei der drei kisten sind leer. in einer findet man einen schluessel (das ist der mimik)
    if(str == "kiste") {
        write(BS("Welche Kiste willst du oeffnen? 1, 2 oder 3?"));
        return -1;
    }

    if(sscanf(str, "kiste %d", welche) != 1) {
        write(BS("Welche Kiste willst du oeffnen? 1, 2 oder 3?"));
        return -1;
    } else {
        notify_fail("Was willst du oeffnen?\n");
        return 0;
    }

    welche--;

    if(kisten[welche] == 1) {
        write(BS("Die Kiste ist bereits geoeffnet."));
        return 1;
    }

    kisten[welche] = 1;

    if(welche == mimik) {
        write(BS("Du oeffnest die Kiste und siehst einen Zellenschuessel darin liegen. Seltsam. Hat die Kiste gerade gekichert?"));
    } else {
        write(BS("Du oeffnest die Kiste und siehst, dass sie leer ist."));
    }

    say(BS(TP->Name(WER) + " oeffnet eine Kiste."));
    return 1;
}

public int cmd_nehmen(string str) {
    object mimik;

    notify_fail("Was willst du nehmen?\n");
    if(!kisten[mimik]) return 0;
    if(!str || str == "") return 0;
    if(str != "zellenschuessel" && str != "schluessel" && str != "zellenschluessel aus kiste" && str != "schluessel aus kiste") return 0;

    if(objectp(present("\nkdz_mimik"))) {
        write(BS("Du willst deine Hand nicht in das Maul eines lebendigen Mimik stecken!!!"));
        return -1;
    }

    write(BS("Gerade als du deine Hand in die Kiste stecken willst, erwacht sie zum Leben. Es ist ein Mimik, der in deine Hand beisst!"));
    say(BS(TP->Name(WER) + " will etwas aus einer Kiste nehmen, als diese zum Leben erwacht und zubeisst!"));
    TP->AddHp(-10 - random(20));

    mimik = clone_object(NPC "mimik");
    if(mimik->move(TO, M_GO|M_SILENT) != 1) {
        destruct(mimik);
    }

    return 1;
}

public void reset() {
    ::reset();

   mimik = random(3);

    return;
}
