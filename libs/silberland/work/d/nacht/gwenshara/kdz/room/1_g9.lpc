#include "../def.h"
inherit ROOM "std_room";

private object *prayed;

public void create() {
    ::create();
    SetProp(P_INT_SHORT, "");
    SetProp(P_INT_LONG, 
        "Du befindest dich einer Eingangshalle. Die Waende und der Boden sind aus galttem, schwarzen "
        "Stein. Die Luft ist feucht und Kalt. Eine breite Treppe fuehrt hier nach oben und ein grosses "
        "Steintor versperrt den Weg nach Norden.");

    AddDetail(({"halle", "eingangshalle"}), "Die Halle ist gross und leer. Die Waende und der Boden sind aus schwarzem Stein.\n");
    AddDetail(({"wand", "waende"}), "Die Waende sind aus schwarzem Stein.\n");
    AddDetail(({"boden"}), "Der Boden ist aus schwarzem Stein.\n");
    AddDetail(({"luft"}), "Die Luft ist feucht und kalt. Sie riecht modrig.\n");
    AddDetail(({"treppe", "rundtreppe"}), "Eine breite Rundtreppe fuehrt hier nach oben, zurueck auf den Platz mit dem Monolithen.\n");
    AddDetail(({"tor", "steintor"}), 
        "Das Tor ist aus massivem Stein und versperrt den weiteren weg. Bei genauerem Hinsehen erkennst du eine Schicht aus zaehmem "
        "Schleim die es bedeckt.");
    AddDetail(({"schleim", "schicht"}), 
        "Der Schleim ist zaeh und klebrig. Er bedeckt das Tor und glaenzt im Licht. Wenn du naeherkommst bemerkst du, dass der "
        "Schleim feine Tentakel ausbildet, die dir folgen. Es scheint, als ob der Schleim lebendig waere!");
    AddDetail(({"tentakel", "tentakeln"}),
        "Die Tentakel sind lang und duenn. Sie bewegen sich langsam und folgen dir, wenn du dich bewegst. Sie gehen von einem kaum "
        "erkennbaren Zeichen auf dem Tor aus.");
    AddDetail(({"zeichen", "symbol"}),
        "Das Zeichen ist ein offenbar das Symbol der Monstermutter. Ein stilisiertes Maul, das von unzaehligen Tentakeln umgeben ist.");
    AddDetail(({"monstermutter"}),
        "Die Monstermutter ist eine Gottheit, die von hier verehrt wird. Sie ist die Quelle aller Monster und Ungeheuer. Eine Kreatur  "
        "aus jenseitigen Sphaeren. Du erinnerst dich daran, dass ihre minderen Diener von standhaften Gebeten an die Goetter zurueckscheuen.");
    AddDetail(({"maul"}), "Das Maul ist weit aufgerissen und scheint dich zu verschlingen.\n");
    AddDetail(({"gebete", "gebeten"}), "Gebete an gute Goetter sind fuer die Diener der Monstermutter unmoeglich. Minder Diener werden von ihnen "
        "zurueckgewiesen.\n");
    AddDetail(({"goetter"}), "Welche Goetter fallen dir denn da ein?");

    AddExit("oben", ROOM "eingang_2");
    NewDoor("norden", ROOM "1_g8", ({"tor", "steintor"}), ({
        D_FLAGS, DOOR_CLOSED|DOOR_RESET_CL,
        D_SHORT, "Ein %ses Steintor versperrt den Weg nach Norden.",
        D_NAME, "Steintor",
        D_OPENTESTFUNC, "open_door_test"
    }));

    SetThreatLevel(-1);
    prayed = ({});

    AddCmd( ({"beten", "sprich", "sag"}), "cmd_beten");
}

public int cmd_beten(string str) {
    object ob;

    notify_fail("Zu wem willst du beten?\n");
    if(!str || str == "") return 0;
    if(str == "zu woody" || str == "zu dusty") {
        write(BS("Du schickst ein kurzes Gebet an die Goetter und fuehlst dich beschuetzt. Der Schleim auf dem Tor scheint sich zu bewegen und "
            "zurueckzuweichen."));
        say(BS(TPN+" murmelt ein kurzes Gebet und scheint sich gestaerkt zu fuehlen."));
        prayed += ({TP});
        return 1;
    } else if(str == "zu monstermutter" || str == "zur monstermutter") {
        write(BS("Du betest zur Monstermutter und fuehlst dich gestaerkt, aber auch irgendwie seltsam. Der Schleim beruhigt sich."));
        say(BS(TPN+" murmelt ein Gebet und sieht irgendwie seltsam aus."));
        prayed += ({TP});
        ob = clone_object(OBJ "mutation");
        if(ob->move(TP) != 1) {
            destruct(ob);
        }
        return 1;
    }
    
    write(BS("Hm. Dieser Gott erwidert deine Gebete nicht. Vielleicht solltest du dich an einen anderen wenden?"));
    say(BS(TPN+" murmelt ein Gebet."));
    return -1;
}

public int open_door_test() {
    object ob;

    if(member(prayed, TP) < 0) {
        tell_object(TP, BS("Als du das Tor beruehrst wickelt sich ein schleimiger Tentakel um dich. Du spuehrst einen Stich und fuehlst dich seltsam..."));
        TP->AddHp(-40);
        TP->AddPoison(2); 
        
        ob = clone_object(OBJ "mutation");
        if(ob->move(TP) != 1) {
            destruct(ob);
        }
    }

    return 0;
}