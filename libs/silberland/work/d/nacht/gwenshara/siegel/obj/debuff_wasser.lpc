#include "../def.h"

inherit "/std/thing";

public void create() {
    if(!is_clone(this_object())) return;
    ::create();

    SetProp(P_SHORT, 0);
    SetProp(P_INVIS, 1);
    SetProp(P_MAGIC, 1);
    SetProp(P_WEIGHT, 0);
    SetProp(P_X_ATTR_MOD, ([A_INT: -3]));

    AddId("\ngwenshara_siegel_mark_water");
}

public void reset() {
    if(!is_clone(this_object())) return;
    ::reset();

    tell_object(ENV(TO), BS("Deine Gedanken klaeren sich wieder. Die Wellenlinien auf deiner Handflaeche verschwinden."));
    remove(1);
}