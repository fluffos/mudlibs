#include "../def.h"
#define CHECK_INTERVAL 100 // alle 100 sekunden pruefen

inherit "/std/thing";

public void create() {
    if(!is_clone(TO)) return;
    ::create();

    SetProp(P_INVIS, 1);
    SetProp(P_NOGET, 1);
    SetProp(P_NOSELL, 1);
    SetProp(P_NODROP, 1);

    AddId("\nadapted_eyes");
}

public int remove(int silent) {
    object pl;
    if(objectp(pl=environment()) && living(pl)) {
        if(!silent) {
            tell_object(pl, BS("Deine Augen sind nun nicht mehr ans Zwielicht gewoehnt."));
            pl->RemoveClass(CL_NIGHTVISION);
        }
    }

    return ::remove(silent);
}

public void init() {
    object pl;
    ::init();

    pl = environment(TO);
    if(!objectp(pl)) {
        write("2\n");
        return;
    }

    if(TP != pl) return;

    if(!living(pl)) {
        remove(1);
        return;
    }

    if(pl->is_class_member(CL_NIGHTVISION) || pl->QuerySkill(SK_NIGHTVISION) != 0) {
        remove(1); // selbst loeschen, wenn der spieler schon nachtsicht hat
        return;
    }
        
    tell_object(pl, BS("Deine Augen gewoehnen sich an das Daemmerlicht."));
    pl->AddClass(CL_NIGHTVISION);
    call_out("check_nightvision", CHECK_INTERVAL);
}

public void check_nightvision() {
    object pl;
    pl = environment(TO);
    if(objectp(pl) && living(pl)) {
        if(objectp(environment(pl)) && environment(pl)->QueryProp(P_TOTAL_LIGHT) > 0) {
            remove(0);
        }
    }
    call_out("check_nightvision", CHECK_INTERVAL);
}
