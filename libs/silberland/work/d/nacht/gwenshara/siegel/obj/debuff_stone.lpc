#include "../def.h"

inherit "/std/thing";

public void create() {
    if(!is_clone(this_object())) return;
    ::create();

    SetProp(P_SHORT, 0);
    SetProp(P_INVIS, 1);
    SetProp(P_MAGIC, 1);
    SetProp(P_WEIGHT, 10000);

    AddId("\ngwenshara_siegel_mark_stone");
}

public void reset() {
    if(!is_clone(this_object())) return;
    ::reset();

    tell_object(ENV(TO), BS("Die unsichtbare Last des Erzes verlaesst dich. Das Viereck auf deiner Handflaeche verschwinden."));
    remove(1);
}