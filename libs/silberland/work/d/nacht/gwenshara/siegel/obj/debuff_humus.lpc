#include "../def.h"

inherit "/std/thing";

public void create() {
    if(!is_clone(this_object())) return;
    ::create();

    SetProp(P_SHORT, 0);
    SetProp(P_INVIS, 1);
    SetProp(P_MAGIC, 1);
    SetProp(P_WEIGHT, 0);
    SetProp(P_X_ATTR_MOD, ([A_CON: -3]));

    AddId("\ngwenshara_siegel_mark_humus");

    call_out("check_poison", 60);
}

public void check_poison() {
    if(!objectp(ENV(TO))) {
        remove(1);
        return;
    }

    if(query_once_interactive(ENV(TO))) {
        if(!ENV(TO)->QueryProp(P_POISON)) {
            ENV(TO)->AddPoison(1);
            tell_object(ENV(TO), BS("Der Dorn in deinem Finger vergiftet dich."));
        }
    }

    call_out("check_poison", 60);
}

public void reset() {
    if(!is_clone(this_object())) return;
    ::reset();

    tell_object(ENV(TO), BS("Der stechende Dorn faellt aus deinem Finger. Die konzentrischen Kreise auf deiner Handflaeche verschwinden."));
    remove(1);
}