#include "../def.h"

inherit "std/thing";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Ein verbrauchtes Druidenamulett");
  SetProp(P_LONG,
    "Dieser Anhaenger sieht aus wie das Amulett eines Druiden. Es ist schwer "
    "vom Kampf gezeichnet und wirkt auf dich irgendwie verbraucht. Fuer "
    "irgendjemanden wird es wohl grossen, sentimentalen Wert haben.");

//--Namen------------------------------------------------------------------

  SetProp(P_INFO, "Bring dieses Amulett zu Orasimandolias!");
  SetProp(P_NAME, "Druidenamulett");
  SetProp(P_GENDER, NEUTER);
  AddId( ({"amulett", "druidenamulett", "\ngwenshara_siegel_amulett"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([MAT_MAGIC: 40, MAT_LEATHER: 10, MAT_OBSIDIAN: 50]) );
  SetProp(P_WEIGHT, 10);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);
  SetProp(P_NOSELL, 1);
  SetProp(P_NEVERDROP, 1);
}
