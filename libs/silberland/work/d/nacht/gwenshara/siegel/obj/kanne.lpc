#include "../def.h"

inherit "std/thing";

void create()
{
  if (!is_clone(TO)) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Eine Giesskanne");
  SetProp(P_LONG,
    "Die Giesskanne ist alt und verbeult, sie kann ihren zweck aber noch "
    "gut erfuellen. Im Moment ist sie @@zustand@@.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Giesskanne");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"kanne", "giesskanne", "\ngwenshara_siegel_giesskanne"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([MAT_METAL: 100]) );
  SetProp(P_WEIGHT, 500);
  SetProp(P_VALUE, 0);
  SetProp(P_NOBUY, 1);

  SetProp("filled", 0);

  AddCmd( ({"fuell", "fuelle"}), "cmd_fuellen");
}

public string zustand() {
  return (QueryProp("filled") ? "mit Wasser gefuellt" : "leer");
}

public int cmd_fuellen(string str) {
  notify_fail("Was willst du fuellen?\n");
  if(str == "" || str == 0) return 0;
  if(str != "kanne" && str != "giesskanne" &&
     str != "kanne auf" && str != "giesskanne auf") return 0;

  if(file_name(environment(TP)) != ROOM "wasser") {
    write(BS("Hier bist du am falschen Ort, um die Kanne zu fuellen."));
    return -1;
  }

  if(QueryProp("filled")) {
    write(BS("Aber die Giesskanne ist doch schon voll?!"));
    return -1;
  }

  SetProp("filled", 1);
  write(BS("Du tauchst die Giesskanne tief ins Wasser und sie fuellt sich gluckernd."));
  say(BS(TPN + " taucht eine Giesskanne tief ins Wasser und sie fuellt sich gluckernd."));

  return 1;
}
