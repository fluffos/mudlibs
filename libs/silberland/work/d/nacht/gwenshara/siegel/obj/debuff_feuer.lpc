#include "../def.h"

inherit "/std/thing";

public void create() {
    if(!is_clone(this_object())) return;
    ::create();

    SetProp(P_SHORT, 0);
    SetProp(P_INVIS, 1);
    SetProp(P_MAGIC, 1);
    SetProp(P_WEIGHT, 0);
    SetProp(P_X_ATTR_MOD, ([A_STR: -3]));

    AddId("\ngwenshara_siegel_mark_fire");
}

public void reset() {
    if(!is_clone(this_object())) return;
    ::reset();

    tell_object(ENV(TO), BS("Das Brennen in deinen Muskeln wird besser. Das Dreieck auf deiner Handflaeche verschwindet."));
    remove(1);
}