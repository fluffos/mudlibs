#include "../def.h"
#include "/gilden/zechpreller/zechpreller_extern.h"

inherit "std/weapon";

void create()
{
  if(!is_clone(TO) ) return;

  ::create();

  SetProp(P_SHORT, "Der Oberschenkelknochen des Nachtwandlers");
  SetProp(P_LONG,
    "Dieser schwere tiefschwarze Oberschenkelknochen gehoerte einst dem Nachtwandler. "
    "Er liegt als Keule gut in der Hand und einige feste Knochenwuelste am oberen "
    "Ende helfen die Schlaege noch heftiger zu setzen. Ausserdem ist er ganz unwuchtig "
    "und bringt dich damit heftig ins Schwanken.");

  SetProp(P_NAME, "Oberschenkelknochen des Nachtwandlers");
  SetProp(P_GENDER, MALE);
  AddId( ({"knochen", "oberschenkelknochen", "nachtwandlerknochen"}) );

  SetProp(P_MATERIAL, ([MAT_BONE: 75, MAT_MISC_UNHOLY: 15, MAT_MISC_MAGIC: 10]) );
  SetProp(P_WEIGHT, 2000);
  SetProp(P_VALUE, 5000);
  SetProp(P_NOBUY, 1);

  SetProp(P_QUALITY_DECAY, 120);
  SetProp(P_WEAPON_TYPE, WT_CLUB );
  SetProp(P_WC, 270);
  SetProp(P_WC_FIX, 30);
  SetProp(P_DAM_TYPE, ({DT_BLUDGEON, DT_UNHOLY}) );
  SetProp(P_NR_HANDS, 2);

  SetProp(P_WIELD_RESTRICTIONS, ([SR_SEER: 1]) );

  SetProp(P_ZECHPRELLER_BONUS, (["torkeln":25]));
  SetProp(P_INFO, BS("Mit dieser Unwucht in der Keule kann ein Zechpreller sicher besser torkeln."));
  SetProp(P_ITEMD_NO_MAGIC, 1);
  SetProp(P_MAGIC, 1);

  SetProp(P_HIT_FUNC, TO);
  SetProp(P_M_HEALTH_MOD,([P_HP:1,P_SP:1]));
}

public int HitFunc(object enemy) {
  if(!objectp(QueryProp(P_WIELDED))) return 0;

  if(objectp(present("\nzechpreller_torkeln", QueryProp(P_WIELDED)))) {
    if(!random(10)) {
      tell_object(QueryProp(P_WIELDED), BS("Den Torkeln verleiht dem Oberschenkelknochen extra Schwung! Huiiii!"));
      return 30+random(30);
    }

    return random(20);
  }

  return 0;
}