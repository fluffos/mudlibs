#include "../def.h"

inherit "std/weapon";

void create()
{
  if(!is_clone(TO) ) return;

  ::create();

  SetProp(P_SHORT, "Eine Kettensichel aus geschmolzenem Metall");
  SetProp(P_LONG,
    "Die Kettensichel hat eine gebogene, einschneidige, sichelfoermige Klinge. "
    "Die Klinge ist an der Schneidenseite gerade und am Klingenruecken konvex "
    "gebogen. Sie ist an einem Schaft aus gluehendem Eisen befestigt. "
    "Am Heftende ist eine Kette befestigt, welche mit einem Metallgewicht "
    "an deren Ende versehen ist. Alles an dieser Waffe besteht aus tropfendem, "
    "geschmolzenen Metall.");

  SetProp(P_NAME, "Kettensichel");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"sichel", "kettensichel"}) );

  SetProp(P_MATERIAL, ([MAT_IRON: 100]) );
  SetProp(P_WEIGHT, 1000);
  SetProp(P_VALUE, 5000);
  SetProp(P_NOBUY, 1);

  SetProp(P_QUALITY_DECAY, 120);
  SetProp(P_WEAPON_TYPE, WT_CHAIN );
  SetProp(P_WC, 160);
  SetProp(P_WC_FIX, 40);
  SetProp(P_DAM_TYPE, ({DT_PIERCE, DT_SLASH, DT_FIRE}) );
  SetProp(P_NR_HANDS, 2);

  SetProp(P_WC_BONUS, (["\ngwenshara_siegel_feuerwache": 150]) );
  SetProp(P_WIELD_RESTRICTIONS, ([A_DEX: 25]) );
}