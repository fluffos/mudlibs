#include "../def.h"
#include "/gilden/waldlaeufer/def_extern.h"

inherit "std/weapon";

void create()
{
  if(!is_clone(TO) ) return;

  ::create();

  SetProp(P_SHORT, "Der Rippenbogen des Nachtwandlers");
  SetProp(P_LONG,
    "Der Rippenbogen des Nachtwandlers ist ein riesiger Knochen, der "
    "aus den Rippen eines Nachtwandlers gefertigt wurde. Er ist sehr "
    "schwer und hat eine ungewoehnliche Form. Die Sehne des Bogens "
    "ist aus einem unheimlichen Material gefertigt, das in der Dunkelheit "
    "leuchtet. Der Bogen ist sehr unhandlich und schwer zu spannen.");

  SetProp(P_NAME, "Rippenbogen des Nachtwandlers");
  SetProp(P_GENDER, MALE);
  AddId( ({"bogen", "rippenbogen", "nachtwandlerbogen"}) );

  SetProp(P_MATERIAL, ([MAT_BONE: 75, MAT_MISC_UNHOLY: 15, MAT_MISC_MAGIC: 10]) );
  SetProp(P_WEIGHT, 2000);
  SetProp(P_VALUE, 5000);
  SetProp(P_NOBUY, 1);

  SetProp(P_QUALITY_DECAY, 120);
  SetProp(P_WEAPON_TYPE, WT_BOW );
  SetProp(P_WC, 280);
  SetProp(P_WC_FIX, 30);
  SetProp(P_DAM_TYPE, ({DT_PIERCE, DT_UNHOLY}) );
  SetProp(P_NR_HANDS, 2);

  SetProp(P_WIELD_RESTRICTIONS, ([SR_SEER: 1]) );

  SetProp(P_RANGER_BONUS, (["zielschuss":25, "panzerbrechender schuss": 25]));
  SetProp(P_RANGER_SPELLCOST, 5);
  SetProp(P_INFO, BS("Pfeile, die mit diesem Bogen verschossen werden, haben eine hohe Durschlagskraft. Das kann "
                     "besonders fuer den Zielschuss und panzerbrechenden Schuss eines Waldlaeufers gut genutzt werden."));
  SetProp(P_ITEMD_NO_MAGIC, 1);
  SetProp(P_MAGIC, 1);

  SetProp(P_M_HEALTH_MOD,([P_HP:1,P_SP:1]));
}
