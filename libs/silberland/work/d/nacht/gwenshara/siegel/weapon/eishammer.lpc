#include "../def.h"

inherit "std/weapon";

void create()
{
  if(!is_clone(TO) ) return;

  ::create();

  SetProp(P_SHORT, "Ein schwerer Hammer aus Eis");
  SetProp(P_LONG,
    "Dieser schwere Kriegshammer besteht im Grunde nur aus einem Holzstiel, der eher "
    "wie der dicke Ast einens verkrueppelten Baumes aussieht und einem grossen Block "
    "Eis, der darauf festgefroren ist.");

  SetProp(P_NAME, "Eishammer");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"hammer", "eishammer"}) );

  SetProp(P_MATERIAL, ([MAT_WOOD: 20, MAT_ICE: 80]) );
  SetProp(P_WEIGHT, 5000);
  SetProp(P_VALUE, 5000);
  SetProp(P_NOBUY, 1);

  SetProp(P_QUALITY_DECAY, 80);
  SetProp(P_WEAPON_TYPE, WT_CLUB );
  SetProp(P_WC, 230);
  SetProp(P_WC_FIX, 30);
  SetProp(P_DAM_TYPE, ({DT_BLUDGEON, DT_COLD}) );
  SetProp(P_NR_HANDS, 2);

  SetProp(P_WC_BONUS, (["\ngwenshara_siegel_frostwache": 100]) );
  SetProp(P_WIELD_RESTRICTIONS, ([A_STR: 25]) );
}