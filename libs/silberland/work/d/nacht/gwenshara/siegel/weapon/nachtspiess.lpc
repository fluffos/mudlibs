#include "../def.h"
#include "/gilden/amazonen/amazonen_extern.h"

inherit "std/weapon";

void create()
{
  if(!is_clone(TO) ) return;

  ::create();

  SetProp(P_SHORT, "Das verdrehte Horn des Nachtwandlers");
  SetProp(P_LONG,
    "Du haeltst das linksgedrehte Horn des Nachtwandlers in den Haenden. Es ist aus "
    "Knochen gefertigt und mit unheiligen und magischen Materialien verziert. "
    "Es ist so geformt, dass es sich gut als Speer eignen wuerde.");

  SetProp(P_NAME, "Horn des Nachtwandlers");
  SetProp(P_GENDER, MALE);
  AddId( ({"speer", "horn", "nachtwandlerhorn"}) );

  SetProp(P_MATERIAL, ([MAT_BONE: 75, MAT_MISC_UNHOLY: 15, MAT_MISC_MAGIC: 10]) );
  SetProp(P_WEIGHT, 2000);
  SetProp(P_VALUE, 5000);
  SetProp(P_NOBUY, 1);

  SetProp(P_QUALITY_DECAY, 120);
  SetProp(P_WEAPON_TYPE, WT_SPEAR );
  SetProp(P_WC, 280);
  SetProp(P_WC_FIX, 30);
  SetProp(P_DAM_TYPE, ({DT_PIERCE, DT_UNHOLY}) );
  SetProp(P_NR_HANDS, 2);

  SetProp(P_WIELD_RESTRICTIONS, ([SR_SEER: 1]) );

  SetProp(P_AMAZONEN_BONUS, (["aufspiessen":25, "speerstoss": 25]));
  SetProp(P_AMAZONEN_SPELLCOST, 5);
  SetProp(P_ITEMD_NO_MAGIC, 1);
  SetProp(P_MAGIC, 1);

  SetProp(P_M_HEALTH_MOD,([P_HP:1,P_SP:1]));
}
