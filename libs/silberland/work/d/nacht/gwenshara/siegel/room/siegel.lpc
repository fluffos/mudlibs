#include "../def.h"

inherit "/std/room";

private int sealed;
private object sprecher;

public void create() {
  ::create();
  sealed = 0;
  sprecher = 0;

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "Auf einem Felsvorsprung unter dem Sternenhimmel");
  SetProp(P_INT_LONG,
    "Ueber dir erstreckt sich ein Nachthimmel voller Sterne. Zu deinen Fuessen "
    "stehst du auf taufeuchtem Gras. Hier befindest du dich auf dem Vorsprung "
    "eines bewaldeten Berges. Um dich herum herrscht das merkwuerdige Zwielicht "
    "der Nacht und der Mond erleuchtet deinen Weg, so dass du ganz gut sehen "
    "kannst. Jenseits des Vorsprungs erstreckt sich ein bewaldetes Tal, das "
    "um schattenhaft Licht der Nacht von tausenden kleiner Funken erhellt wird. "
    "Die Ueberreste eines alten Saeulentempels, die von einem grossen Baum "
    "uberwuchert werden, sind das Einzige, was sich ausser dir hier befindet.");

//--Umgebung---------------------------------------------------------------

  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 25, ENV_TERRAIN: TT_FOREST]) );

//--Details----------------------------------------------------------------

  AddDetail( ({ "weg" }),
    "Dieser Weg ist nur metaphorisch gemeint. Da ist kein echter Weg.");

  AddDetail( ({ "nacht" }),
    "Hier herrscht staendige Nacht, aber keine gruselige, dunkle Nacht, sondern eine angenehme "
    "laue Nacht.");

  AddDetail( ({ "himmel", "nachthimmel" }),
    "Ueber dir erstreckt sich ein dunkler Nachthimmel voller Sterne. Du musst wohl auf "
    "der Nachtseite des Silberland sein!");

  AddDetail( ({ "sterne" }),
    "Hunder, tausende oder sogar noch mehr Sterne funkeln die vom Himmel entgegen.");

  AddDetail( ({ "fuesse", "fuessen", "boden", "fuss" }),
    "Deine Fuesse stehen hier fest auf einem Boden aus taufeuchtem Gras.");

  AddDetail( ({ "gras", "grasbueschel" }),
    "Viele feine Grasbueschel glitzern und glaenzen im Licht der Sterne zu deinen Fuessen.");

  AddDetail( ({ "vorsprung" }),
    "Du stehst auf einer Art Vorsprung eines bewaldeten Berges, der sich hinter der erhebt. "
    "Vor dir erkennst du ein friedlich scheinendes Tal liegen, in dem in der Ferne zwei "
    "helle Baeume leuchten.");

  AddDetail( ({ "berg", "bergs", "berges" }),
    "Der Berg hebt sich als dunke Silhouette hinter dir vom Nachthimmel ab.");

    AddDetail( ({ "silhouette", "schatten" }),
    "Dunkel und drohend hebt sich der Schatten des Berges hinter dir ab.");

  AddDetail( ({ "tal" }),
    "Das Tal zu den Fuessen des Vorsprungs ist von einem dichten Wald bedeckt. Viele kleine "
    "Lichtpunkte schwirren in dem Wald herum und erheben sich mal ueber ihn und fallen mal ab. "
    "Weit hinten im Tal erkennst du zwei helle Baeume deren Licht kuehl darueber hinwegstrahlt.");

  AddDetail( ({ "wald" }),
    "Der Wald liegt am Fuss des Vorsprungs in einem Tal. Von hier aus kannst du nicht viel erkennen, "
    "ausser, dass er sehr dicht scheint. Weiter hinten am Horizont siehst du zwei hell leuchtende "
    "Baeume.");

  AddDetail( ({ "horizont", "rande", "sichtfeld", "sichtfelds", "ferne" }),
    "Am Rande deines Sichtfelds am Horizont erkennst du noch zwei von sich aus leuchtende Baeume.");

  AddDetail( ({ "baeume" }),
    "Die beiden Baeume stehen fast schon am Horizont. Einer erstrahlt in kuehlem silbernen Licht, "
    "der andere in einem sanften goldenen Licht. Erstaunlich, welche Schoenheit es hier auf der "
    "dunklen Seite gibt!");

  AddDetail( ({ "schoenheit" }),
    "Auch, wenn du die Baeume nur aus der Ferne siehst scheinen sie wunderschoen zu sein.");

  AddDetail( ({ "seite", "nachtseite" }),
    "Du bist dir ziemlich sicher, dass du dich hier auf der dunklen Seite des Silberlands befindest. "
    "Die Seite, die Woodys Tischlampe nicht beleuchtet. Ein mysterioueser und unbekannter Ort.");

  AddDetail( ({ "silberland", "silberlands" }),
    "Genau genommen ist das Silberland auf der anderen Seite.");

  AddDetail( ({ "woody", "woodys", "goetter" }),
    "Woody ist einer der Goetter, die das Silberland geschaffen haben.");

  AddDetail( ({ "tischlampe", "lampe" }),
    "Das, was du als Sonne kennst, ist eigentlich Woodys Tischlampe, die das Silberland beleuchtet.");

  AddDetail( ({ "ort" }),
    "Hier ist ein mysterioeser Ort.");

  AddDetail( ({ "sonne" }),
    "Die siehst du hier nicht. Hier herrscht nur Nacht.");

  AddDetail( ({ "funken", "punkte", "lichtpunkte", "lichtfunken" }),
    "Viele kleine Lichtfunken in verschiedenen Farben zischen durch den Wald im Tal. Einer davon "
    "fliegt zu dir hoch und du erkennst, dass es sich um kleine Leuchtkaefer handelt.");

  AddDetail( ({ "farben" }),
    "Die Lichtpunkte haben die verschiedensten Farben und zischen wild hin und her.");

  AddDetail( ({ "kaefer", "leuchtkaefer" }),
    "Bei den kleinen Lichtpunkten handelt es sich um kleine Leuchtkaefer, die efrig ihrer "
    "Arbeit nachgehen.");

  AddDetail( ({ "arbeit" }),
    "Vermutlich sammeln sie irgendwelche Nahrung.");

  AddDetail( ({ "nahrung" }),
    "Du hast keine Ahnung was Leuchtkaefer eigentlich essen.");

  AddDetail( ({ "ahnung" }),
    "Du suchst. Findest aber keine!");

  AddDetail( ({ "licht", "zwielicht" }),
    "Ueberall um dich herum herrscht das merkwuerdige Zwielicht der Nacht. Es ist weder hell, noch "
    "richtig dunkel. Zwar ist um dich herum Nacht, da keine Sonne am Himmel steht, doch scheint dir, "
    "dass die Sterne und der Mond am Himmel dafuer sorgen, dass du gerade genug sehen kannst.");

  AddDetail( ({ "mond" }),
    "Voll und silbern steht hier der Mond am Himmel und erleuchtet dich.");    

  AddDetail( ({ "ueberreste", "ueberresten" }),
    "Wie faule Zaehne erheben sie die Ueberreste eines Saeulentempels auf diesem Vorsprung. Sie "
    "scheinen schon alt und sind vom Brand geschwarzt. Ein grosser Baum thront darueber.");

  AddDetail( ({ "brand", "feuer", "steine" }),
    "Die Steine des Tempels wurden offenbar von Feuer geschwarzt.");    

  AddDetail( ({ "tempel", "tempels", "saeulentempels", "saeulentempel", "bau" }),
    "Der Saeulentempel ist nur noch in Ueberresten vorhanden. Einstmals wohl ein grosser Bau sing heute "
    "nur noch vereinzelte Saeulen vorhanden, sowie ein grosses Siegel in der Mitte. Ueber das Siegel "
    "ist ein grosser Baum gewachsen.");

  AddDetail( ({ "mitte" }),
    "In der Mitte des Saeulentempels wurde ein grosses Siegel in den Boden eingelassen.");

  AddDetail( ({ "saeulen" }),
    "Einzelne Saeulen stehen noch wie faule Zaehne in den Himmel.");

  AddDetail( ({ "zaehne" }),
    "Dieser Tempel gibt dir ein unangenehmes Gefuehl.");

  AddDetail( ({ "gefuehl" }),
    "Irgendwie unheimlich.");

  AddDetail( ({ "einzige" }),
    "Du, der Saeulentempel und der Baum.");

  AddSpecialDetail( ({ "baum" }), "detail_baum");

  AddSpecialDetail( ({ "siegel" }), "detail_siegel");

  AddSpecialDetail( ({ "amulett", "herz", "obsidianamulett" }), "detail_amulett");

  AddSpecialDetail( ({"mosaik"}), "detail_mosaik");

  AddDetail( ({ "runen" }),
    "Jede Rune, die du kennst ist auf diesem Siegel zu finden. Darauf muss ein maechtiger Zauber liegen.");

  AddDetail( ({ "zauber" }),
    "Er soll dieses Siegel wohl verschliessen.");

  AddDetail( ({ "relief" }),
    "Das Relief zeigt sechs Szenen. In jeder Szene beschwoert ein baertiger Mann elementare Kraefte auf eine "
    "finstere Kreatur. Es sieht so aus als wuerden die Szenen der Reihe nach zeigen, wie die Kreatur in "
    "das Siegel gesperrt wird. Ausser man liest die Bilder in entgegengesetzer Reihenfolge. Dann zeigen "
    "sie, wie die Kraeatur befreit wird.");

  AddDetail( ({ "szenen", "szene" }),
    "Du siehst sechs Szenen, welche willst du ansehen? (untersuche erste|zweite|...|sechste szene)");

  AddDetail( ({"erste szene"}),
    "Die erste Szene zeigt einen baertigen Mann, der ein Wort spricht, wodurch sich der Fels unter "
    "einer dunklen, langliedrigen Kreatur auftut, um sie zu verschlingen.");

  AddDetail( ({"zweite szene"}),
    "Die zweite Szene zeigt einen baertigen Mann, der ein Wort spricht, und Flutwellen stuerzen "
    "ueber einer dunklen, sternaeugigen Kreatur zusammen.");

  AddDetail( ({"dritte szene"}),
    "Die dritte Szene zeigt einen baertigen Mann, der ein Wort spricht und damit eine dunkle "
    "Kreatur verbrennt.");

  AddDetail( ({"vierte szene"}),
    "Die vierte Szene zeigt einen baertigen Mann, der ein Wort spricht und damit die riesenhafte "
    "Kreatur mit langen Klauen in einem Eisblock einschliesst.");

  AddDetail( ({"fuenfte szene"}),
    "Die fuenfte Szene zeigt einen baertigen Mann, der ein Wort spricht, worauf hin sich Ranken "
    "um die Kreatur winden.");

  AddDetail( ({"sechste szene"}),
    "Die sechste Szene zeigt einen baertigen Mann, der ein Wort spricht, und einen Wirbelsturm, "
    "der die Kreatur in die Luft hebt oder herabstuerzen laesst.");

  AddDetail( ({"mann", "robe", "druide"}),
    "Der Mann auf den Reliefs traegt eine einfache Robe und ist barfuss. Ein maechtiger Bart "
    "prangt in seinem Gesicht. Es wird wohl ein Druide sein.");

  AddDetail( ({"kreatur", "beine", "klauen", "kopf", "hoerner"}),
    "Die Kreatur auf den Reliefs ist immer die selbe. Im Gegensatz zu dem Mann ist sie riesig "
    "gross. Sie wirkt fremdartig, lang und duenn. Lange Beine und spitze Klauen vervollstaendigen "
    "das Bild mit einem Kopf auf dem widderartig verdrehte Hoerner sitzen.");
  

  AddCmd( ({"sprich", "spreche", "sag", "sage"}), "cmd_zauberwort");

  AddExit("osten", ROOM "humus");
}

public string detail_siegel() {
  string str;

  str = "Das Siegel besteht aus purem Stein. Es ist in den Boden in er Mitte des Saeulentempels eingelassen und "
        "mit einer Vielzahl an Runen beschrieben. Mitten auf dem Siegel erkennst du ein Relief. ";

  if(sealed < 0) {
    str += "Du erkennst tiefe Risse im Siegel. Es scheint bereits gebrochen zu sein.";
  } else if(sealed > 0) {
    str += "Das Siegel ist fest und dicht mit dem Boden verschlossen.";
  } else {
    str += "Immer wieder steigen purpurene Daempfe auf. Das Siegel scheint nicht ganz dicht zu sein.";
  }

  return BS(str);
}

public string detail_amulett() {
  if(sealed == 0) {
    return BS("Etwa auf Herzhoehe erkennst du ein Obsidianamulett, wie das von Druiden, das fest in der Rinde steckt.");
  }
  return BS("Nichts zu sehen. Weder ein Amulett, noch ein Herz. Komm spaeter wieder!");
}

public string detail_baum() {
  if(sealed < 0) {
    return BS("Bei genauerem Hinsehen stellst du fest, dass es nur die zersplitterten Reste eines Baums sind. Schade.");
  } else if(sealed > 0) {
    return BS("Der Baum steht gross und stark verwachsen ueber dem geschlossenen Siegel. Du vermeinst in seiner Rinde "
              "die sanfte Spur eines Gesichts zu erkennen.");
  } 

  return BS("Der Baum ist ueber dem Siegel gewachsen. Wo du genauer hinsiehst erkennst du, dass die Rinde des Baums "
            "ein elfisches Gesicht darstellt, sowie die starken Aeste annaehrend die Form von Haenden haben. Dort, wo "
            "in etwas das Herz waere ist ein Amulett fest mit der Rinde verwachsen.");
}

public int cmd_zauberwort(string str) {
   string zauberwort, antiwort;
   int i, pos;
   notify_fail("Welche Worte willst du sprechen?\n");
   if(!str || str == "") return 0;

   antiwort = implode(({
        call_other(ROOM "luft", "GetWord"),
        call_other(ROOM "humus", "GetWord"),
        call_other(ROOM "eis", "GetWord"),
        call_other(ROOM "feuer", "GetWord"),
        call_other(ROOM "wasser", "GetWord"),
        call_other(ROOM "erz", "GetWord"),
    }), "");

    zauberwort = implode(({
      call_other(ROOM "erz", "GetWord"),
      call_other(ROOM "wasser", "GetWord"),
      call_other(ROOM "feuer", "GetWord"),
      call_other(ROOM "eis", "GetWord"),
      call_other(ROOM "humus", "GetWord"),
      call_other(ROOM "luft", "GetWord"),
    }), "");

    if(objectp(sprecher)) {
      write(BS(sprecher->Name(WER) + " spricht gerade die Worte der Macht! Schweig und lausche!"));
      return -1;
    }

    if(IS_LEARNER(TP) || TP->QueryProp(P_TESTPLAYER)) {
      write("zauberwort: " + zauberwort + "\n");
      write("antiwort: " + antiwort + "\n");
    }


    str = regreplace(str, " ", "", 1);
    if(lower_case(str) == lower_case(zauberwort) || lower_case(str) == lower_case(antiwort)) {

      if(sealed > 0) {
        write(BS("Du sprichst die Worte, doch das Siegel ist fest verschlossen. Im Moment geht das nicht."));
        return -1;
      } else if(sealed < 0) {
        write(BS("Du sprichst die Worte, doch das Siegel ist bereits gebrochen. Im Moment geht das nicht."));
        return -1;
      }

      TP->SetProp(P_PARALYZED, ([
        PARALYZE_TIME: 30,
        PARALYZE_MSG: "Du bist gerade damit beschaeftigt die Worte der Macht zu sprechen.\n",
        PARALYZE_END: "Du beendest die Worte.\n"
      ]));
      sprecher = TP;

      if(lower_case(str) == lower_case(zauberwort)) call_out("sequenz_versiegeln", 0, 0, TP);
      else call_out("sequenz_befreien", 0, 0, TP);

      return 1;
   }
   
   notify_fail("Nichts passiert. Das waren wohl die falschen Worte.");
   return 0;
}

private void giveQuest(object pl) {
  int ret;
  ret = pl->GiveQuest(QUEST_NAME);

  if(pl->QueryProp(P_TESTPLAYER)) tell_object(pl, BS(sprintf("GiveQuest(%s) == %d", QUEST_NAME, ret)));

  call_other(ROOM "luft", "ResetWord");
  call_other(ROOM "humus", "ResetWord");
  call_other(ROOM "eis", "ResetWord");
  call_other(ROOM "feuer", "ResetWord");
  call_other(ROOM "wasser", "ResetWord");
  call_other(ROOM "erz", "ResetWord");
}

public void summon_nightwalker(int step) {
  object nw;
  if(step > 3) {
    nw = clone_object(NPC "nightwalker");
    if(nw->move(TO, M_GO) != 1) {
      tell_room(TO, BS("Nichts passiert... seltsam."));
      destruct(nw);
    }
    return;
  }

  switch(step) {
    case 0: 
      tell_room(TO, BS("Purpurener Nebel beginnt aus dem Siegel aufzusteigen."));
      break;
    case 1:
      tell_room(TO, BS("Ein lautes Kreischen, das immer naeher kommt dringt aus dem Siegel an dein Ohr!"));
      break;
    case 2: 
      tell_room(TO, BS("Rieseige Haende mit langen, duenen Fingern aus schwarzem panzer greifen an den Rand des Lochs!"));
      break;
    case 3:
      tell_room(TO, BS("Eine riesige nachtschwarze Kreatur entsteigt dem gebrochenen Siegel. Der Nachtwandler kommt!"));
      break;
    default:
      raise_error("illegale sequenznummer");
      break;
  }

  call_out("summon_nightwalker", 4, ++step);
}

public void removeMarks(object pl) {
  if(objectp(present("\ngwenshara_siegel_mark_stone", pl))) {
    present("\ngwenshara_siegel_mark_stone", pl)->remove(1);
  }

  if(objectp(present("\ngwenshara_siegel_mark_air", pl))) {
    present("\ngwenshara_siegel_mark_air", pl)->remove(1);
  }

  if(objectp(present("\ngwenshara_siegel_mark_water", pl))) {
    present("\ngwenshara_siegel_mark_water", pl)->remove(1);
  }

  if(objectp(present("\ngwenshara_siegel_mark_fire", pl))) {
    present("\ngwenshara_siegel_mark_fire", pl)->remove(1);
  }

  if(objectp(present("\ngwenshara_siegel_mark_humus", pl))) {
    present("\ngwenshara_siegel_mark_humus", pl)->remove(1);
  }

  if(objectp(present("\ngwenshara_siegel_mark_ice", pl))) {
    present("\ngwenshara_siegel_mark_ice", pl)->remove(1);
  }
}

public void sequenz_versiegeln(int step, object pl) {
  object amulett;

  if(step > 5) {
    if(pl->QueryProp(P_GUILD) == "bardengilde" && TP->QuerySkill("sieben schritte") == 0 && !objectp(present("\ngwenshara_siegel_amulett", pl))) {
      tell_object(pl, BS("Als der Baum endgueltig mit dem Siegel verwaechst faellt das Amulett aus der Rinde in deine Hand."));
      amulett = clone_object(OBJ "amulett");
      amulett->move(pl, M_NOCHECK|M_GET);
    }
    pl->SetProp(P_PARALYZED, 0);
    sealed = 1;
    sprecher = 0;
    giveQuest(pl);
    removeMarks(pl);
    return;
  }

  switch(step) {
    case 0:
      tell_object(pl, BS("Du sprichst das erste Wort und knirschend verdichtet sich der Fels um das Siegel."));
      tell_room(TO, BS(pl->Name(WER) + " spricht ein Wort und knirschend verdichtet sich der Fels um das Siegel."), ({TP}));
      tell_room(TO, BS("Die Wurzeln des grossen Baumes beginnen sich um das Siegel zu winden."));
      break;
    case 1:
      tell_object(pl, BS("Du sprichst das zweite Wort und ein sanfter Regen geht nieder."));
      tell_room(TO, BS(pl->Name(WER) + " spricht ein Wort und ein sanfter Regen geht nieder."), ({TP}));
      tell_room(TO, BS("Ueber seine starken Wurzeln saugt der Baum das Wasser gierig auf."));
      break;
    case 2:
      tell_object(pl, BS("Du sprichst das dritte Wort. Brennende Runen fegen ueber das Siegel und verschmelzen es mit den Wurzeln des Baumes."));
      tell_room(TO, BS(pl->Name(WER) + " spricht ein Wort. Brennende Runen fegen ueber das Siegel und verschmelzen es mit den Wurzeln des Baumes."), ({TP}));
      break;
    case 3:
      tell_object(pl, BS("Du sprichst das vierte Wort und sanfte Kuehle verfestigt den gebrannten Fels."));
      tell_room(TO, BS(pl->Name(WER) + " spricht ein Wort und sanfte Kuehle verfestigt den gebrannten Fels."), ({TP}));
      tell_room(TO, BS("Der Baum wird stark und fest ueber dem Siegel verankert."));
      break;
    case 4:
      tell_object(pl, BS("Du sprichst das fuenfte Wort. Helle Nachtblumen erbluehen ueberall um dich herum."));
      tell_room(TO, BS(pl->Name(WER) + " spricht ein Wort. Helle Nachtblumen erbluehen ueberall um dich herum."), ({TP}));
      tell_room(TO, BS("Der Baum waechst an und erblueht."));
      break;
    case 5:
      tell_object(pl, BS("Du sprichst das sechsete und letzte Wort. Die letzte Luft wird aus dem Siegel herausgesaugt. Es ist nun fest verschlossen."));
      tell_room(TO, BS(pl->Name(WER) + " spricht ein letztes Wort.  Die letzte Luft wird aus dem Siegel herausgesaugt. Es ist nun fest verschlossen."), ({TP}));
      tell_room(TO, BS("Die Blaetter des Baumes rascheln sanft im Wind."));
     
      break;
    default:
      raise_error("ueberzaehlige sequenzeinheit");
      break;
  }

  call_out("sequenz_versiegeln", 4, ++step, pl);
}

public void sequenz_befreien(int step, object pl) {
  object amulett;

  if(step > 5) {
    if(pl->QueryProp(P_GUILD) == "bardengilde" && TP->QuerySkill("sieben schritte") == 0 && !objectp(present("\ngwenshara_siegel_amulett", pl))) {
      tell_object(pl, BS("Du nimmst das Amulett aus der Leiche der Elfe und steckst es ein."));
      amulett = clone_object(OBJ "amulett");
      amulett->move(pl, M_NOCHECK|M_GET);
    }
    pl->SetProp(P_PARALYZED, 0);
    sealed = -1;
    sprecher = 0;
    call_out("summon_nightwalker", 0, 0);
    pl->SetProp(P_ALIGN, pl->QueryProp(P_ALIGN) - 300);
    giveQuest(pl);
    return;
  }

  switch(step) {
    case 0:
      tell_object(pl, BS("Du sprichst das erste Wort und ein wirbelnder Sog aus Luft bildet sich ueber dem Siegel."));
      tell_room(TO, BS(pl->Name(WER) + " spricht ein Wort und ein wirbelnder Sog aus luft bildet sich ueber dem Siegel."), ({TP}));
      tell_room(TO, BS("Die Blaetter des grossen Baums beginnen sachte zu rascheln."));
      break;
    case 1:
      tell_object(pl, BS("Du sprichst das zweite Wort und das Leben weicht aus dem Gras um das Siegel."));
      tell_room(TO, BS(pl->Name(WER) + " spricht ein Wort und das Leben weicht aus dem Gras um das Siegel."), ({TP}));
      tell_room(TO, BS("Die Blaetter des grossen Baums fallen eines nach dem anderen zu Boden."));
      break;
    case 2:
      tell_object(pl, BS("Du sprichst das dritte Wort. Frost und Schnee legen sich ueber die Runen des Siegels."));
      tell_room(TO, BS(pl->Name(WER) + " spricht ein Wort. Frost und Schnee legen sich ueber die Runen des Siegels."), ({TP}));
      tell_room(TO, BS("Knackend beginnt dir Borke des Baums aufzubrechen. Dickes Harz rinnt heraus."));
      break;
    case 3:
      tell_object(pl, BS("Du sprichst das vierte Wort und eine brennende Flammensaeule zischt auf das Siegel herab."));
      tell_room(TO, BS(pl->Name(WER) + " spricht ein Wort und eine brennende Flammensaeule zischt auf das Siegel herab."), ({TP}));
      tell_room(TO, BS("Die Wurzlen des Baumes verkohlen unter der Hitze."));
      break;
    case 4:
      tell_object(pl, BS("Du sprichst das fuenfte Wort. Knackend bekommt das Siegel Risse. Eis und Schnee ergiessen sich in Schmelzbaechen von Siegel weg."));
      tell_room(TO, BS(pl->Name(WER) + " spricht ein Wort. Eis und Schnee ergiessen sich in Schmelzbaechen von Siegel weg."), ({TP}));
      tell_room(TO, BS("Krachend und knirschend faellt der Baum mit dem Elfengesicht um. Entwurzelt und gefaellt."));
      break;
    case 5:
      tell_object(pl, BS("Du sprichst das sechsete und letzte Wort.  Knackend bekommt das Siegel Risse. Das Siegel zerbroeselt zu feinem Staub..."));
      tell_room(TO, BS(pl->Name(WER) + " spricht ein letztes Wort. Das Siegel zerbroeselt zu feinem Staub..."), ({TP}));
      tell_room(TO, BS("Die Reste des gefaellten Baumes zerbroeseln und es bleibt nur die entrkaeftete Leiche einer Elfe zurueck."));
      break;
    default:
      raise_error("ueberzaehlige sequenzeinheit");
      break;
  }

  call_out("sequenz_befreien", 4, ++step, pl);
}

public void enable_nightvision(object pl) {
  object nv;
  nv = clone_object(OBJ "adapted_eyes");
  if(nv->move(pl, M_NOCHECK) != 1) {
    destruct(nv);
  }
}

public void init() {
  ::init();

  if(!objectp(present("\nadapted_eyes", TP))) {
    if(query_once_interactive(TP)) {
      call_out("enable_nightvision", 2, TP);
    }
  }
}

public void reset() {
  ::reset();

  if(sealed > 0) {
    tell_room(TO, BS("Purpurene Blicke zucken ueber das Siegel und es loest sich mit einem Zischen."));
  } else if(sealed < 0) {
    tell_room(TO, BS("Mit einem Knirschen und Krachen erneuert sich das gebrochene Siegel."));
  } 

  sealed = 0;
}
