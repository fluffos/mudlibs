#include "../def.h"

inherit ROOM "std_room";

private int freigelegt;
private object *ertastet;

public void create() {
  ::create();
  freigelegt = 0;
  ertastet = ({ });

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "In einer Hoehle voller Sand");
  SetProp(P_INT_LONG,
    "Diese Hoehle ist mit einer dicken Schicht Sand gefuellt. Von den Waenden und "
    "der Decke rinnt feinder Sand durch kleine Oeffnungen herab. Der Staub in der "
    "Luft laesst das daemmrige Licht von draussen in feinen Strahlen erscheinen. "
    "Zwischen den vielen kleinen Duenen erhebt sich ein einzelner grosser Felsen "
    "mitten in der Hoehle.");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_CAVE]) );

//--Details----------------------------------------------------------------

  AddDetail( ({ "hoehle", "raum" }),
    "Wie auch die anderen, ist diese Hoehle riesig gross. Sie ist mit einer dicken Schicht "
    "Sand befuellt und bestaendig rinnt neuer Sand durch kleine Oeffnungen an Waenden und "
    "Decke herab.");

  AddDetail( ({"waende", "waenden", "wand"}),
    "Die Waende sind aus rohem, unbehauenem Fels. Aus vielen kleinen Oeffnungen rieselt staendig "
    "Sand zu Boden.");

  AddDetail( ({"schicht"}),
    "Der Boden ist mit einer dicken Schicht sand befuellt. an den Waenden ist er hoeher als "
    "zur Mitte hin, da von den Waenden staendig neuer Sand herabrieselt. Deshalb bildet er "
    "schon regelrechte Duenen an der Wand.");

  AddDetail( ({"decke"}),
    "Die Decke der Hoehle ist, so wie die Waende, komplett unbehauen. Auch hier rieselt immer "
    "wieder feiner Sand herab.");

  AddDetail( ({"staub", "luft"}),
    "Durch den vielen Sand ist die ganze Luft dick mit Staub vermengt. Dicke Schwaden aus Staub "
    "tanzen durch die Luft und machen dir das Atmen schwer. Andererseits kannst du dadurch gut "
    "die die Strahlen des daemmrigen Lichts von draussen erkennen.");

  AddDetail( ({"atmen"}),
    "Durch den ganzen Staub in der Luft faellt dir das Atmen schon sehr schwer.");

  AddDetail( ({"schwaden"}),
    "Dicke Schwaden aus Staub ziehen, aufgewirbelt durch das staendige Rieseln des Sandes, durch die Luft.");

  AddDetail( ({"rieseln", "loecher", "risse"}),
    "Staendig rieselt mehr Sand in diese Hoehle. Seltsam, dass es trotzdem nicht mehr zu werden scheint.");

  AddDetail( ({"oeffnungen"}),
    "Durch die kleinen Risse und Loecher rieselt staendig Sand herein. Draussen erkennst du das zarte "
    "rosa-orange der untergehenden Sonne.");

  AddDetail( ({"strahlen"}),
    "Durch die kleinen Oeffnungen faellt gelegentlich Licht, dass durch den Staub in der Luft "
    "in duennen Strahlen sichtbar gemacht wird und so die Hoehle erhellt.");

  AddDetail( ({"licht"}),
    "Das Licht faellt von draussen durch die kleinen Oeffnungen an Wand und Decke herein. Es ist "
    "zartrosa-orange und wirkt daemmrig. So als wuerde die Sonne draussen untergehen. Seltsam.");

  AddDetail( ({"sonne"}),
    "Du kannst sie nicht direkt erkennen, sie scheint jedoch sehr tief zu stehen.");

  AddDetail( ({"duenen"}),
    "Zahlreiche Duenen bedecken den Boden. In der Mitte, um den Monolithen, sind sie eher flach und "
    "am Rand der Hoehle erheben sie sich hoch. Sie verdecken wohl den eigentlichen Boden, den du "
    "wohl nur erkennen koenntest, wenn du zu ihm graebst.");

  AddDetail( ({"oberflaeche"}),
    "Die Oberflaeche des Monolithen besteht aus schroffem Fels, auf dem sich Staub und Sand "
    "abgesetzt haben. Dadurch ist schwer zu er ekennen, wie sie tatsaechlich beschaffen ist. "
    "Aber wo Augen nicht sehen, koennen deine Hande vielleicht helfen?");

  AddDetail( ({"augen"}),
    "Die beiden Augen in deinem Kopf koennen es nicht erkennen.");

  AddDetail( ({"haende", "finger"}),
    "Deine Haende koennten hier hilfreich sein durch ihren Tastsinn.");

  AddDetail( ({"tastsinn", "gabe"}),
    "Die einigartige Gabe mittels deiner Finder und Haende zu spuehren.");

  AddDetail( ({"rand"}),
    "Am Rand dieser Hoehle tuermt sich der Sand hoch auf.");

  AddDetail( ({"mitte"}),
    "In der Mitte scheint der Sand weniger tief zu reichen und dort erhebt sich auch ein "
    "einzelner Felsen.");

  AddDetail( ({"fels", "stein", "erz"}),
    "Der Fels der Hoehle ist grau und dunkel. Wie reiner Stein oder Erz in seiner puren "
    "elementaren Form.");

  AddDetail( ({"form"}),
    "Die reinste Form des Erz.");

  AddDetail( ({"sand"}),
    "Der Sand ist gelb, wie der in der Wueste.");

  AddDetail( ({"wueste"}),
    "Die Wueste ist weit weg von hier und ziemlich heiss.");

  AddSpecialDetail( ({"mosaik"}), "detail_mosaik");
  AddSpecialDetail( ({"boden"}), "detail_boden");
  AddSpecialDetail( ({"felsen", "monolith", "monolithen"}), "detail_monolith");
  AddSpecialDetail( ({"rune", "stelle"}), "detail_rune");

  AddItem(NPC "erzwaechter", REFRESH_DESTRUCT);

  AddCmd(({"grabe", "grab"}), "cmd_graben");
  AddCmd(({"beruehre", "beruehr", "lege", "leg"}), "cmd_beruehren");
  AddCmd("fuehle|fuehl|greife|greif|taste|tast&fels|monolith|felsen|monolithen&ab", "cmd_abtasten", "Was willst du abtasten?");

  AddExit("osten", ROOM "feuer");
  AddExit("westen", ([EX_DEST: ROOM "luft", EX_TESTFUNC: "test_mark"]) );
}

public string detail_monolith() {
  string str;
  str = "Ein einzelner Felsen erhebt sich in der Mitte der Hoehle aus dem Sand. Er ist rau und ueber "
        "und ueber mit Sand und Staub bedeckt, der sich auf seiner schroffen Oberflaeche abgesetzt "
        "hat. ";
        
  if(member(ertastet, TP) < 0 ) str += "Anders als bei den anderen Monolithen kannst du so direkt keine Rune erkennen.";
  else str += "Jetzt, wo du die Rune ertastet hast, kannst du sie eindeutig erkennen.";

  return BS(str);
}

public string detail_rune() {
  if(member(ertastet, TP) < 0 ) 
    return BS("Du kannst keine Rune sehen.");
  return BS("An einer Stelle am Monolithen wurde eine etwa handgrosse Rune in Form eines Viereck "
            "glatt in den Fels gemeisselt.");
}

public void ResetState() {
  ::ResetState();
  if(freigelegt) {
    tell_room(TO, BS("Sand rieselt ueber das Mosaik."));
    freigelegt = 0;
  }

  ertastet = ({ });
}

public int cmd_abtasten() {
   write(BS("Vorsichtig tastest du den Monolithen ab und erspuehrst eine Stelle an der wohl eine "
            "handgrosse Rune in Form eines Vierecks glatt in den Fels gemeisselt wurde."));
   say(BS(TPN + " tastet am Felsen herum."));
   if(member(ertastet, TP) < 0) ertastet += ({TP});
   return 1;
}

public string detail_boden() {
   string str;
   str = "Der Boden ist mit kleinen Duenen aus Sand bedeckt.";
   if(freigelegt) str += " Jemand ein Mosaik im Sand freigelegt.";
   return str + "\n";
}

public int test_mark() {
    if(!objectp(present("\ngwenshara_siegel_mark_stone", TP))) {
        tell_object(TP, BS("Gerade als du weitergehen willst verschliesst sich der Ausgang vor dir."));
        tell_room(TO, BS("Gerade als "+TPN+" verschliesst sich der Ausgang vor "+TP->QueryPronoun(WEN)+"."), ({TP}));
        return 0;
    }
    return 1;
}

public string detail_mosaik() {
   if(freigelegt) {
      return BS(sprintf("An der freigelegten Stelle erblickst du das Mosaik eines baertigen Mannes, der den Boden "
      "beruehrt waehrend sich von ihm Risse und Wellen ausbreiten. Auf seiner Stirn prangt die Rune '%s'.", GetWord()));
   } else {
      return BS("Hier ist doch gar kein Mosaik...");
   }
}

public int cmd_graben(string str) {
    notify_fail("Worin willst du graben?\n");
    if(!str || str == "") return 0;
    if(str != "in sand" && str != "zum boden" && str != "bis zum boden" &&
       str != "im sand" && str != "bis zum boden im sand") return 0;

    if(!objectp(present("schaufel", TP))) {
      write(BS("Du wuehlst mit deinen Haenden im Sand, doch reicht es nicht, um ausreichend viel davon zu bewegen."));
      say(BS(TPN + " wuehlt mit den Haenden im Sand."));
      return -1;
    }

    freigelegt = 1;
    write(BS("Nach ein paar Spatenstichen in den Sand legst du ein Mosaik am Boden frei."));
    say(BS(TPN+" graebt mit der Schaufel im Sand."));

    return 1;
}

public int IsGlove(object ob) {
    return ob->QueryProp(P_ARMOUR_TYPE) == AT_GLOVE;
}

public int cmd_beruehren(string str) {
    object* glove, mark;
    notify_fail("Was willst du beruehren?\n");
    if(!str || str == "") return 0;
    if(str != "rune" && str != "viereck" && str != "hand auf rune" &&
       str != "hand auf viereck") return 0;

   if(member(ertastet, TP) < 0) {
      write(BS("Sowas hast du doch gar nicht gefunden?!"));
      return -1;
   }

    if(objectp(present("\ngwenshara_siegel_mark_stone", TP))) {
        write(BS("Du bist bereits vom Erz markiert. Nochmal brauchst du das nicht."));
        return -1;
    }

    if(objectp(present("\ngwenshara_siegel_erzwache"))) {
        write(BS("Der elementare Waechter bringt den Boden zum Beben, als du dich der Rune naehern willst."));
        return -1;
    }

    glove = filter_array(TP->QueryArmours(), "IsGlove");
    if(sizeof(glove) > 0) {
        write(BS("Du legst deine Hand auf die Rune. Durch den Handschuh spuehrst du die Rune kaum. Sonst geschieht nichts."));
    } else {
        mark = clone_object(OBJ "debuff_stone");
        if(mark->move(TP, M_NOCHECK|M_SILENT) != 1) {
            destruct(mark);
        }
        TP->UpdateAttrbutes();
        write(BS("Du legst deine Hand auf die Rune. Ein unglaublich schweres Gewicht scheint dich zu Boden zu druecken."));
    }
    say(BS(TPN+" beruehrt den Monolithen."));
    return 1;
}
