#include "../def.h"
#include "/p/daemon/itemd/data/itemd_socketed_data.h"

inherit "std/room";

string word;
private int resetCounter;

public string GetWord() {
    return word;
}

public void ResetWord() {
    string *words;
    words = m_indices(REVERSE_RUNE_MIGHT);
    word = words[random(sizeof(words))];
}

public void ResetState() {
    ResetWord();
}

public void create() {
    ::create();
    ResetWord();
    resetCounter = 0;
}

public void reset() {
    ::reset();
    if(resetCounter++ > 2) ResetState();
}
