#include "../def.h"
#include <lightsource.h>

inherit ROOM "std_room";

private int angezuendet;

public void create() {
  ::create();
  angezuendet = 0;

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "In einer Hoehle voll Feuer");
  SetProp(P_INT_LONG,
    "Ein unheimliches rotes Gluehen huellt diese Hoehle in Daemmerlicht. "
    "Schwer drueckt Hitze auf dich. Aus unzaehligen Felsspalten quillt "
    "heisse Lava. Immer wieder oeffnen sich kleine Geysire im Raum und "
    "speien eine Mischung aus heisser Luft und Flammen. Am Boden verlaufen "
    "kreuz und quer Rinnen, die mit schlierigem Oel gefuellt sind. In "
    "der Mitte der Hoehle steht ein einzelner, rot gluehender Monolith.");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 60, ENV_TERRAIN: TT_CAVE]) );

//--Details----------------------------------------------------------------

  AddSpecialDetail( ({"bild", "bildnis"}), "detail_bild");
  AddSpecialDetail( ({"rinnen", "oel"}), "detail_rinnen");

  AddDetail( ({"gluehen"}),
    "Ein unheimliches rotes Gluehen huellt die ganze Hoehle in seltsames "
    "Daemmerlicht");
  
  AddDetail( ({"hoehle", "raum"}),
    QueryProp(P_INT_LONG));

  AddDetail( ({"licht", "daemmerlicht"}),
    "Die gesamte Hoehle ist, durch das rote Gluehen der Lava, in ein duesteres "
    "Daemmerlicht getaucht.");

  AddDetail( ({"hitze"}),
    "Schweissperlen rinnen dein Rueckgrat herab, so heiss ist es.");

  AddDetail( ({"spalten", "felsspalten"}),
    "Gluehende Lava quillt aus einer Vielzahl an Felsspalten aus verschiednene "
    "Rissen an Boden und Waenden.");

  AddDetail( ({"lava"}),
    "In den Felsspalten erkennst du heisse Lava gluehen. Vielleicht auch Magma. Sicher "
    "bist du dir nicht.");

  AddDetail( ({"geysire"}),
    "Wie Pusteln wachsen immer wieder Geysire aus dem Boden und speien eine Mischung aus "
    "kochendem Wasser und gluehender Luft.");

  AddDetail( ({"mischung"}),
    "Die Mischung auf kochendem Wasser und heisser Luft aus den Geysiren laesst die "
    "Luftfeuchtigkeit im Raum ordentlich ansteigen.");

  AddDetail( ({"flammen"}),
    "Ab und zu fauchen heisse Flammen aus den Geysiren. Ganz so, als waren sie mit "
    "brennbarem Gas gefuellt.");

  AddDetail( ({"boden"}),
    "Zwischen den Rissen und Geysiren am Boden verlaufen wirre Linien, in denen Schlieren "
    "von Oel schimmern.");

  AddDetail( ({"mitte"}),
    "Auf einer Steinplatte in der Mitte der Hoehle, scheinbar unberuehrt von der Hitze ringsum, "
    "ragt ein einzelner roter Monolith auf.");

  AddDetail( ({"monolith", "brocken", "felsbrocken"}),
    "Bei naeherer Betrachtung stellst du fest, dass der grosse Felsbrocken nicht einfach rot "
    "gefaerbt ist, sondern vor Hitze glueht. Eine einzelne, handgrosse Rune darauf scheint "
    "nicht zu gluehen.");

  AddDetail( ({"riss", "risse"}),
    "Die Risse spruehen Funken und pulsieren immer wieder. Wie ein Vulkan, der jederzeit ausbrechen koennte.");

  AddDetail( ({"funken"}),
    "Ab und an zischen fauchend Funken aus den Rissen.");

  AddDetail( ({"vielzahl"}),
    "Kaum zaehlbar.");

  AddDetail( ({"waende", "waenden"}),
    "Die Waende sind ueber und ueber mit Rissen bedeckt, aus denen es roetlich hervorglueht.");

  AddDetail( ({"perlen", "schweissperlen"}),
    "Dick rinnt dir der Schweiss herab.");

  AddDetail( ({"rueckgrat"}),
    "Nicht jeder hat eines, du aber schon!");

  AddDetail( ({"magma"}),
    "Ganz so klar ist dir der Unterschied immer noch nicht.");

  AddDetail( ({"pusteln"}),
    "Die Geysire platzen wie eitrige Pusteln auf und spruehen Feuer und Wasser.");

  AddDetail( ({"wasser", "luft"}),
    "Das Wasser und die Luft aus den Geysiren wird zu einer stickigen Mischung aus Wasserdampf.");

  AddDetail( ({"feuchtigkeit", "luftfeuchtigkeit"}),
    "Trotz der drueckenden Hitze ist die Luftfeuchtigkeit ungewoehnlich hoch.");

  AddDetail( ({"gas"}),
    "Dir scheint, die Geysire sind nicht mit reiner Luft, sondern einem Gas, wie etwa "
    "Butan gefuellt.");

  AddDetail( ({"schlieren"}),
    "Regenbogenfarbene Schlieren aus Oel ziehen sich durch die Linien am Boden.");

  AddDetail( ({"platte", "steinplatte"}),
    "Der Monolith steht auf einer einzelnen, unberuehrt wirkenden Steinplatte im Boden verankert.");

  AddDetail( ({"betrachtung"}),
    "Das hier ist praktisch eine Betrachtung dritter Ordnung.");

  AddDetail( ({"ordnung"}),
    "Du betrachtest dich beim Betrachten von etwas. Echt meta.");

  AddDetail( ({"rune", "dreieck", "form", "dreiecks"}),
    "Die handgrosse Rune in Form eines Dreiecks ist das einzige am Monolith, was nicht zu gluehen scheint.");

  AddDetail( ({"Vulkan"}),
    "Du hoffst, dass diese Hoehle nicht wirklich ein Vulkan ist.");

  AddDetail( ({"linien"}),
    "Es handelt sich um feine Rinnen, in denen schlieriges Oel schwimmt.");

  AddDetail( ({"butan"}),
    "Ein brennbares Gas.");

  AddDetail( ({"unterschied"}),
    "Tja, haettest du in Geologie doch aufgepasst!");

  AddDetail( ({"geologie", "fachgebiet"}),
    "Die Geologie waere hier das passende Fachgebiet.");

  AddDetail( ({"dampf", "wasserdampf"}),
    "Die heisse Luft und das kochende Wasser vermischen sich zu kochend heissem Wasserdampf.");

  AddCmd(({"zuende", "zuend"}), "cmd_anzuenden");
  AddCmd("zaehle|zaehl&risse|spalten|felsspalten", "cmd_zaehlen", "Was willst du zaehlen?");
  AddCmd(({"beruehre", "beruehr", "lege", "leg"}), "cmd_beruehren");

  AddExit("osten", ROOM "wasser");
  AddExit("westen", ([EX_DEST: ROOM "erz", EX_TESTFUNC: "test_mark"]) );

  AddItem(NPC "feuerwaechter", REFRESH_DESTRUCT);
}

public int cmd_zaehlen() {
  write(BS("Du zaehlst exakt " + (100 + random(200)) + " Risse und Spalten. Sicher bist du dir aber nicht."));
  say(BS(TPN+ " streckt konzentriert die Zunge zwischen die Lippen und murmelt vor sich hin."));
  return 1;
}

public string detail_rinnen() {
   if(angezuendet) {
      return BS("Das Oel in den Rinnen wurde angezuendet und brennt. Die Flammen erzeugen ein Bildnis.");
   }

   return BS("Mehrere wirre Rinnen, die ab und zu mit Oel gefuellt sind, verlaufen ueber den Boden.");
}

public void ResetState() {
  ::ResetState();
  angezuendet = 0;
}

public int test_mark() {
    if(!objectp(present("\ngwenshara_siegel_mark_fire", TP))) {
        tell_object(TP, BS("Du naeherst dich dem Durchgang und mit einem Mal rinnt heisse, brennende Lava darueber. "
                           "Brandblasen bilden sich auf deinem Gesicht."));
        tell_room(TO, BS(TPN+" naehert sich dem Durchgang, doch verbrennt sich an der heissen Lava!"), ({TP}));
        SetProp(P_KILL_NAME, "Brennende Lava");
        TP->do_damage(20+random(20));
        return 0;
    }

    tell_room(TO, BS("Die Lava teilt sich, als " + TPN + " hindurch geht."));
    return 1;
}

public string detail_bild() {
   if(angezuendet) {
      return BS(sprintf("Die wabernden Flammen erzeugen gemeinsam ein Bildnis. Es zeigt, aus "
      "dem richtigen Winkel betrachtet, einen baertigen Mann, der seine Haende gebieterisch "
      "vor einem Feuersturm erhebt. Auf seiner Stirn prangt die Rune '%s'.", GetWord()));
   }
   return BS("Welches Bildnis? Hier ist keines.");
}

public int cmd_anzuenden(string str) {
    object fackel;
    notify_fail("Was willst du anzuenden?\n");
    if(!str || str == "") return 0;
    if(str != "oel an" && str != "rinnen an") return 0;

    if(angezuendet) {
      write(BS("Das Oel brennt bereits lichterloh."));
      return -1;
    }

    if(!objectp(fackel=present("fackel", TP))) {
      write(BS("Du brauchst eine Fackel, um das Oel anzuzuenden. Sonst verbrennst du dich noch."));
      return -1;
    }

    if(!fackel->QueryProp(P_LIGHTED)) {
      write(BS("Du solltest die Fackel erstmal anzuenden!"));
      return -1;
    }

    write(BS("Vorsichtig beruehrst du das Oel mit der Fackel und es geht in Flammen auf. Aus dem richtigen "
             "Winkel betrachtet zeigen die flackernden Flammen ein Bildnis."));
    say(BS(TPN+" beruehrt die Rinnen mit dem Oel mit einer Fackel und es geht in Flammen auf. Aus dem richtigen "
    "Winkel betrachtet zeigen die flackernden Flammen ein Bildnis."));

    angezuendet = 1;
    return 1;
}

public int IsGlove(object ob) {
    return ob->QueryProp(P_ARMOUR_TYPE) == AT_GLOVE;
}

public int cmd_beruehren(string str) {
    object* glove, mark;
    notify_fail("Was willst du beruehren?\n");
    if(!str || str == "") return 0;
    if(str != "rune" && str != "dreieck" && str != "hand auf rune" &&
       str != "hand auf dreieck") return 0;

    if(objectp(present("\ngwenshara_siegel_mark_fire", TP))) {
        write(BS("Du bist bereits vom Feuer gezeichnet. Nochmal brauchst du das nicht."));
        return -1;
    }

    if(objectp(present("\ngwenshara_siegel_feuerwache"))) {
        write(BS("Gerade als du nahe an den Monolithen heran willst bruellt dir der elementare Waechter "
                 "seinen Flammenatem entgegen!"));
        say(BS("Gerade als " + TPN + " auf den Monolithen zugehen will, bruellt der elementare Waechter " +
               TP->QueryPronoun(WEM)+" seinen Flammenatem entgegen."));
        return -1;
    }

    glove = filter_array(TP->QueryArmours(), "IsGlove");
    if(sizeof(glove) > 0) {
        write(BS("Du legst deine Hand auf die Rune. Durch den Handschuh fuehlt sie sich warm an. Sonst geschieht nichts."));
    } else {
        mark = clone_object(OBJ "debuff_feuer");
        if(mark->move(TP, M_NOCHECK|M_SILENT) != 1) {
            destruct(mark);
        }
        TP->UpdateAttrbutes();
        write(BS("Du legst deine Hand auf die Rune. Gluehender Schmerz durchfaehrt dich, als die Macht des Feuers "
                 "in dich eindringt. Deine Muskeln beginnen wie unter heissem Feuer dahinzuschmelzen."));
    }
    say(BS(TPN+" beruehrt den Monolithen."));
    return 1;
}
