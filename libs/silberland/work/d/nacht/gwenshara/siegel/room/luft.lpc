#include "../def.h"

inherit ROOM "std_room";

private int seil;

public void create() {
  ::create();
  seil = 0;

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "In einer stuermischen Hoehle");
  SetProp(P_INT_LONG,
    "In dieser Hoehle zieht sich ein schmaler Sims um ein tiefes Loch in der Mitte. "
    "Ein stetiger Sturm scheint hier zu wehen, wobei du nicht sagen kannst woher er "
    "kommt. Mitten über dem Loch schwebt, von den Winden getragen, ein grosser, "
    "durscheinender Monolith.");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 0);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_CAVE]) );

//--Details----------------------------------------------------------------

  AddDetail( ({ "hoehle" }),
    "Diese Hoehle ist im Grunde ein grosser Trichter aus Fels, der von einem schmalen "
    "Sims umgeben wird.");

  AddDetail( ({ "sims" }),
    "Ein schmaler, vielleicht zwei Schritte breiter, Sims laeuft um ein tiefes Loch "
    "herum.");

  AddDetail( ({ "loch" }),
    "Das Loch in der Mitte der Hoehle ist sehr breit und so tief, dass du seinen Boden "
    "nicht erkennen kannst.");

  AddDetail( ({ "mitte" }),
    "In der Mitte der Hoehle befindet sich ein grosses Loch. Ein stetiger Sturm scheint "
    "darin zu wehen und einen durscheinenden Monolithen zu tragen.");

  AddDetail( ({ "sturm" }),
    "Die ganze Hoehle ist von einem maechtigen Sturm erfuellt, der an allem zerrt und "
    "ruettelt. Du kannst nicht genau sagen woher er kommt.");

  AddDetail( ({ "winde", "winden", "wind" }),
    "Die Winde, die aus dem Loch nach oben rasen sind so stark, dass sie den ganzen "
    "Monolithen bestaendig in die Hoehe tragen.");

  AddDetail( ({ "boden" }),
    "Der Boden des schmalen Sims, auf dem du stehst ist vom Wind glatt geschliffen. Den "
    "Boden des Lochs kannst du von hier nicht erkennen. Um den zu sehen muesstest du "
    "schon selbstmoerderisch sein und hinein springen.");

  AddDetail( ({ "trichter", "form" }),
    "Die ganze Hoehle hat die Form eines Trichters, der zum grossen Loch in der Mitte fuehrt.");

  AddDetail( ({ "fels" }),
    "Aller Fels, den du hier siehst ist vom staendigen Wind komplett glatt geschliffen.");

  AddDetail( ({ "hoehe" }),
    "Du kannst nicht sagen wie tief das Loch ist. Vielleicht sogar bodenlos?");

  AddDetail( ({ "rune", "spirale", "seite" }),
    "Auf einer Seite des Monolithen erkennst du die Rune in Form einer Spirale. Sie ist etwa "
    "handgross und das einzige am Monolithen, das nicht komplett glatt ist.");

  AddDetail( ({ "bergkristall", "kristall" }),
    "Der Monolith duerfte aus besonders klarem Bergkristall geschnitten sein.");

  AddSpecialDetail( ({"monolith"}), "detail_monolith");

  AddItem(NPC "luftwaechter", REFRESH_DESTRUCT);

  AddCmd(({"beruehre", "beruehr", "lege", "leg"}), "cmd_beruehren");
  AddCmd("bind|binde&seil|strick|schnur&an|um&monolith|monolithen", "cmd_binden", "Was willst du woran binden?");
  AddCmd("spring|springe&in|ins&loch", "cmd_spring", "Wohin willst du springen?");

  AddExit("osten", ROOM "erz");
  AddExit("westen", ([EX_DEST: ROOM "humus", EX_TESTFUNC: "test_mark"]) );
}

public void ResetState() {
  ::ResetState();
  if(seil) {
    tell_room(TO, BS("Das Seil loest sich vom Monolithen und faellt ins Loch."));
    seil = 0;
  }
}

public int cmd_spring() {
  write(BS(sprintf("Du springst mit einem grossen Satz in ins Loch. Einen Moment faellst du, doch dann packen "
           "dich die Luftstroeme und tragen dich wieder nach oben. Am Weg hoch erkennst du das Mosaik "
           "eines baertigen Mannes, der mit seinen Haenden einen Sturm dirigiert. Auf seiner Stirn prangt "
           "die Rune '%s'.", GetWord())));

  say(BS(TPN+" springt ins Loch und wird im naechsten Moment wieder hoch geweht."));
  return 1;
}

public int cmd_binden() {
  object s;
  if(!objectp(s=present("seil", TP))) {
    write(BS("Leider hast du kein Seil dabei..."));
    return -1;
  }

  write(BS("Mit einem Schwung wirfst du das Seil um den Monolithen und bindest es fest."));
  say(BS(TPN + " schlingt mit einem eleganten Schwung ein Seil um den Monolithen und bindet es fest."));
  seil = 1;
  s->remove(1);
  return 1;
}

public string detail_monolith() {
   string str;
   str = "Ein Monolith aus durscheinendem Bergkristall schwebt, von den Winden getragen, ueber dem "
         "Loch. Auf einer Seite erkennst du eine etwa handgrosse Rune in Form eine Spirale. ";
   if(seil) str += "Jemand ein Seil darum gebunden, sodass du hingelangen kannst.";
   else str += "Wenn du etwas haettest, um es daran zu binden, koenntest du hingelangen.";
   return str + "\n";
}

public int test_mark() {
    if(!objectp(present("\ngwenshara_siegel_mark_air", TP))) {
        tell_object(TP, BS("Ein kraeftiger Windstoss verhindert, dass du weitergehen kannst"));
        return 0;
    }
    return 1;
}

public int IsGlove(object ob) {
    return ob->QueryProp(P_ARMOUR_TYPE) == AT_GLOVE;
}

public int cmd_beruehren(string str) {
    object* glove, mark;
    notify_fail("Was willst du beruehren?\n");
    if(!str || str == "") return 0;
    if(str != "rune" && str != "spirale" && str != "hand auf rune" &&
       str != "hand auf spirale") return 0;

    if(!seil) {
      write(BS("Der Monolith ist zu weit weg. Wenn du nur sowas wie ein Seil haettest, um es an ihn "
               "zu binden, dann koenntest du da hin gelangen..."));
      return -1;
    }

    if(objectp(present("\ngwenshara_siegel_mark_air", TP))) {
        write(BS("Du bist bereits von der Luft markiert. Nochmal brauchst du das nicht."));
        return -1;
    }

    if(objectp(present("\ngwenshara_siegel_luftwache"))) {
        write(BS("Der elementare Waechter schleudert dich mit einem Windstoss vom Monolithen fort."));
        return -1;
    }

    glove = filter_array(TP->QueryArmours(), "IsGlove");
    if(sizeof(glove) > 0) {
        write(BS("Du legst deine Hand auf die Rune. Durch den Handschuh spuehrst du die Rune kaum. Sonst geschieht nichts."));
    } else {
        mark = clone_object(OBJ "debuff_air");
        if(mark->move(TP, M_NOCHECK|M_SILENT) != 1) {
            destruct(mark);
        }
        TP->UpdateAttrbutes();
        write(BS("Du legst deine Hand auf die Rune. Ein kraftiger Windstoss saugt dir die Luft aus den Lungen. Dir fehlt die Kraft zu atmen."));
    }
    say(BS(TPN+" beruehrt den Monolithen."));
    return 1;
}
