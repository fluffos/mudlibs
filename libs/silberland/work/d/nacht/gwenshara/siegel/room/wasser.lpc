#include "../def.h"

inherit ROOM "std_room";

private int moosEntfernt;

public void create() {
  ::create();
  moosEntfernt = 0;

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "In einer Hoehle voll Wasser");
  SetProp(P_INT_LONG,
    "Die Hoehle hier gleicht einem grossen Becken. In der Mitte erhebt sich "
    "direkt aus dem Wasser ein einsamer Monolith. An den Waenden rinnen unzaehlige "
    "Rinnsale und sprudelnde Quellen herab. Dir gegenueber rauscht "
    "ein maechtiger Wasserfall durch ein Loch an der Decke hinunter.");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_CAVE]) );

//--Details----------------------------------------------------------------

  AddSpecialDetail( ({"mosaik"}), "detail_mosaik");
  AddSpecialDetail( ({"stellen"}), "detail_stellen");
  AddSpecialDetail( ({"algen"}), "detail_algen");

  AddDetail( ({"hoehle"}),
    "Eigentlich ist diese Hoehle nichts anderes, als ein grosses Becken, in das sich "
    "unzaehlige Rinnsale und ein grosser Wasserfall ergiessen. Durch ein Loch in "
    "der Decke faellt das rosafarbene Licht der untergehenden Sonne.");

  AddDetail( ({"becken"}),
    "Die Hoehle ist ein grosses Becken. Am Rand stehst du etwa knoecheltief im Wasser. "
    "Je weiter du hinein gehst, desto tiefer wird es.");

  AddDetail( ({"mitte"}),
    "In der Mitte der Hoehle duerfte es am tiefsten sein. Dort erhebt sich auch ein "
    "Monolith aus dem Wasser und ragt in die Hoehe.");

  AddDetail( ({"monolith"}),
    "Der Monolith ist riesig. Aus blauem Fels gehauen erhebt er sich. Staendig rinnt "
    "Wasser von ihm herab. Nur eine einzelne, etwa handgrosse Flaeche ist trocken.");

  AddDetail( ({"waende", "waenden", "wand"}),
    "An den Waenden rinnen bestaendig Rinnsale aus Wasser herab. Ein Wand ist sogar "
    "vollstaendig mit glitschigen gruenen Algen bedeckt.");

  AddDetail( ({"rinnsale", "quellen"}),
    "Von den Waenden rinnen eine Unzahl kleiner Rinnsaale hinab. Manche scheinen weiter "
    "oben zu beginnen und andere sind offenbar Quellen, die direkt hier entspringen.");

  AddDetail( ({"wasserfall"}),
    "Ein maechtiger Wasserfall rauscht dir gegenueber in dieses Becken. Sprudelnd schaeumt "
    "das Wasser dort wo er aufschlaegt. Durch die rauschenden Wassermassen erkennst du "
    "schemenhaft einen weiteren Durchgang.");

  AddDetail( ({"loch", "decke"}),
    "Ueber dir prangt ein grosses Loch in der Decke, durch der Wasserfall hinab rauscht. "
    "Dahinter erkennst du den zartrosafarbenen Himmel.");

  AddDetail( ({"licht", "sonne"}),
    "Das Licht der Sonne faerbt den Himmel in ein zartes Rosa.");

  AddDetail( ({"rand"}),
    "Am Rand des Beckens stehst du etwa knoecheltief im Wasser, waehrend du in der Mitte "
    "sicher schon schwimmen musst.");

  AddDetail( ({"wasser"}),
    "Ueberall um dich herum ist Wasser. Es scheint ganz so, als wuerde es von dem "
    "Monolithen angezogen werden und dann darunter abrinnen.");

  AddDetail( ({"hoehe", "schritt"}),
    "Der Monolith ragt mehrere Schritt in die Hoehe.");

  AddDetail( ({"fels"}),
    "Der Fels des Monolithen ist von tiefem Blau, waehrend der Fels der Hoehle "
    "ganz fad grau ist.");

  AddDetail( ({"flaeche"}),
    "Nur eine etwa handgrosse Flaeche am Monolithen ist trocken. Sie "
    "zeigt eine Rune aus zwei uebereinanderliegenden Wellenlinien.");

  AddDetail( ({"wassermassen", "massen", "menge"}),
    "Eine unglaubliche Menge von Wasser rinnt den Wasserfall hier hinab.");

  AddDetail( ({"durchgang"}),
    "Der Durchgang im Westen liegt hinter dem rauschenden Wasserfall. So "
    "einfach wirst du da nicht durchkommen.");

  AddDetail( ({"himmel"}),
    "Der Himmel hat sich vom Licht der untergehenden Sonne bereits ins erste Abendrot verfaerbt.");

  AddDetail( ({"rosa", "abendrot"}),
    "Abendrot? Moment mal! Die Sonne geht im Silberland doch niemals unter?! Was hat das zu bedeuten?");

  AddDetail( ({"blau"}),
    "Das saftige, tiefe Blau des Wassers.");

  AddDetail( ({"rune", "wellenlinien", "symbol"}),
    "Die Rune zeigt wohl das elementare Symbol des Wassers.");

  AddDetail( ({"silberland"}),
    "Du bist dir sicher, dass du im Silberland bist. Da, wo die Sonne nie untergeht.");

  AddItem(NPC "wasserwaechter", REFRESH_DESTRUCT);

  AddCmd(({"entferne", "entfern"}), "cmd_entfernen");
  AddCmd(({"beruehre", "beruehr", "lege", "leg"}), "cmd_beruehren");

  AddExit("osten", ROOM "eis");
  AddExit("westen", ([EX_DEST: ROOM "feuer", EX_TESTFUNC: "test_mark"]) );
}

public string detail_stellen() {
  if(moosEntfernt) {
     return BS("Die blauen Stellen entpuppen sich als Teil eines Mosaiks.");
  }

  return BS("Unter den Algen schimmert es an einigen Stellen blaeulich hindurch. Was wohl unter den Algen ist?");
}

public string detail_algen() {
   if(moosEntfernt) {
      return BS("Die Algen wurden bereits ausreichend entfernt, sodass du ein Mosaik aus blauen Steinen erkennen kannst.");
   }

   return BS("Schleimige Algen bedecken die Wand, sodass du nicht erkennen kannst, was darunter ist, doch "
             "an einigen Stellen schimmert es blaeulich hindurch.");
}

public void reset() {
   ::reset();
   moosEntfernt = 0;
}

public int test_mark() {
    if(!objectp(present("\ngwenshara_siegel_mark_water", TP))) {
        tell_object(TP, BS("Mit Anlauf versuchst du durch den Wasserfall zu springen. Die "
                   "gigantischen Flutmassen druecken dich unter Wasser und du kommst prustend wieder zu dir.."));
        tell_room(TO, BS(TPN+" versucht mit Anlauf durch den Wasserfall zu springen, doch die Wassermassen sind zu stark!"), ({TP}));
        SetProp(P_KILL_NAME, "Die donnernde Masse eines Wasserfalls");
        TP->do_damage(20+random(20));
        return 0;
    }

    tell_room(TO, BS("Der Wasserfall teilt sich, als " + TPN + " hindurch geht."));
    return 1;
}

public string detail_mosaik() {
   if(moosEntfernt) {
      return BS(sprintf("Das Mosaik an der Wand zeigt einen baertigen Mann, der mit seinen Haenden "
      "einen maechtigen Strudel aus Wasser formt. Auf seiner Stirn prangt die Rune '%s'.", GetWord()));
   }
   return BS("Welche Mosaik? Hier ist keines.");
}

public int cmd_entfernen(string str) {
    notify_fail("Was willst du entfernen?\n");
    if(!str || str == "") return 0;
    if(str != "algen" && str != "algen von wand") return 0;

    if(moosEntfernt) {
      write(BS("Das hat bereits gemacht und du kannst ein Mosaik aus blauen Steinen erkennen."));
      return -1;
    }

    write(BS("Ruppig rupfst du die Algen vom Fels und legst darunter ein Mosaik aus blauen Steinen frei."));
    say(BS(TPN+" reisst Pflanzen von der Wand."));

    moosEntfernt = 1;
    return 1;
}

public int IsGlove(object ob) {
    return ob->QueryProp(P_ARMOUR_TYPE) == AT_GLOVE;
}

public int cmd_beruehren(string str) {
    object* glove, mark;
    notify_fail("Was willst du beruehren?\n");
    if(!str || str == "") return 0;
    if(str != "rune" && str != "linien" && str != "wellenlinien" && str != "hand auf rune" &&
       str != "hand auf linien" && str != "hand auf wellenlinien") return 0;

    if(objectp(present("\ngwenshara_siegel_mark_water", TP))) {
        write(BS("Du bist bereits vom Wasser gezeichnet. Nochmal brauchst du das nicht."));
        return -1;
    }

    if(objectp(present("\ngwenshara_siegel_wasserwache"))) {
        write(BS("Gerade als du nahe an den Monolithen heran willst laesst der elementare Waechter "
                 "einen gigantischen Strudel davor entstehen, der dich zurueckweichen laesst."));
        say(BS("Gerade als " + TPN + " auf den Monolithen zugehen will, laesst der elementare Waechter "
               "einen riesigen Strudel entstehen. " + TPN + " weicht erschrocken zurueck."));
        return -1;
    }

    glove = filter_array(TP->QueryArmours(), "IsGlove");
    if(sizeof(glove) > 0) {
        write(BS("Du legst deine Hand auf die Rune. Durch den Handschuh fuehlt sie sich kuehl an. Sonst geschieht nichts."));
    } else {
        mark = clone_object(OBJ "debuff_wasser");
        if(mark->move(TP, M_NOCHECK|M_SILENT) != 1) {
            destruct(mark);
        }
        TP->UpdateAttrbutes();
        write(BS("Du legst deine Hand auf die Rune. Die reine Kraft des Wasser durchstroemt dich und spuelt deine "
                 "Gedanken hinfort."));
    }
    say(BS(TPN+" beruehrt den Monolithen."));
    return 1;
}
