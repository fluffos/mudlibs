#include "../def.h"

inherit ROOM "std_room";

private int ueberwuchert, gegossen, kanneDa;

public void create() {
  ::create();
  ueberwuchert = 1;
  gegossen = 0;
  kanneDa = 1;

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "Auf einer Lichtung unter dem Sternenhimmel");
  SetProp(P_INT_LONG,
    "Mit einem Mal stehst du auf einer dicht bewachsenen Lichtung. Ueber "
    "dir funkeln und glitzern unzaehlige Sterne am Himmel. Dichte Ranken "
    "und Unterholz formen aus der Lichtung einen praezisen Kreis. Im hohen "
    "Gras, umgeben von einer ebenso runden Hecke, steht in der Mitte der "
    "Lichtung ein ueberwucherter Monolith.");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 0);
  SetProp(P_INDOORS, 0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: 20, ENV_TERRAIN: TT_FOREST]) );

//--Details----------------------------------------------------------------

  AddDetail( ({"mitte", "mittelpunkt"}),
    "In der Mitte der Lichtung steht ein grosser, mit Ranken ueberwucherter Monolith.");

  AddDetail( ({"boden"}),
    "Der gesamte Boden der Lichtung ist meinem hohem, wild gewachsenem Gras bedeckt.");

  AddDetail( ({ "lichtung" }),
    "Du findest dich auf einer dicht bewachsenen Lichtung wieder. Es ist merkwuerdig "
    "dunkel, und doch so, dass du gerade noch etwas sehen kannst. Uebreall wachsen "
    "dichte Ranken und Unterholz um dich herum.");

  AddDetail( ({ "sterne" }),
    "Seltsam... so etwas hast du hier im Silberland noch nie wirklich gesehen. Echte Sterne!");

  AddDetail( ({ "himmel", "nachthimmel" }),
    "Du findest es schon recht seltsam, dass hier keine Sonne am Himmel steht. Unzaehlige "
    "funkelnde Sterne blinken dir vom dunklen Himmel entgegen.");

  AddDetail( ({ "ranken" }),
    "Dichte Ranken wachsen hier ueberall. Nur der Kreis aus Gras, auf dem du stehst, bliebt "
    "frei von ihnen.");

  AddDetail( ({ "unterholz" }),
    "Diese kreiserunde Lichtung ist von dichtem Unterholz umgeben, sodass sie einen perfekten "
    "Kreis bildet. An einer Stelle ist das Unterholz besonders licht.");

  AddDetail( ({"stelle"}),
    "An dieser Stelle waechst nicht wirklich Gras oder Unterholz. Es sieht eher so aus, als haette "
    "da jemand ein Blumenbeet angelegt.");

  AddDetail( ({ "kreis", "kreise" }),
    "Die Lichtung formt einen perfekten Kreis. In der Lichtung selbst formt eine Hecke "
    "einen weiteren perfekten Kreis in dessen Mitte sich ein Monolith erhebt. So gesehen sind "
    "beide Kreise konzentrisch, wobei der Monolith eben den Mittelpunkt bildet.");

  AddDetail( ({ "gras" }),
    "Das Gras hier ist wild und waechst wohl ungehemmt. Leichte Tautropfen haben sich darauf "
    "gebildet und mit jedem deiner Schritte wogt es auseinanden.");

  AddDetail( ({ "hecke" }),
    "Die Hecke besteht aus verschiedenen Pflanzen, die mit dichten Blaettern bewachsen sind.");

  AddDetail( ({"pflanzen"}),
    "Verschiedene Pflanzen wachsen hier wild durcheinander.");

  AddDetail( ({"blaetter", "blaettern"}),
    "Die Blaetter der Hecke sind so dicht, dass sie sich vermutlich besonders gut eignen, um "
    "darin irgendwelche Dinge zu verstecken.");

  AddDetail( ({"dinge"}),
    "Nur vom hinsehen wirst du nicht erkennen, was sich da vielleicht versteckt.");

  AddDetail( ({"sonne"}),
    "Das ueber dir ist ein Nachthimmel. Da ist keine Sonne zu sehen.");

  AddDetail( ({"schritte"}),
    "Jeder deiner Schritte laesst das saftige Gras wogen.");

  AddDetail( ({"tautropfen"}),
    "Kleine, blasse Tautropfen reflektieren das Sternenlicht auf dem Gras.");

  AddDetail( ({"sternenlicht"}),
    "Das reflektierte Sternenlicht sieht aus wie tausende kleiner Diamanten, die hier herabgeregnet sind.");

  AddDetail( ({"diamanten"}),
    "Natuerlich ist das nur sinnbildlich gemeint.");

  AddDetail( ({"silberland"}),
    "Du bist hier im Silberland. Denkst du zumindest.");

  AddSpecialDetail( ({"monolith", "stein"}), "detail_monolith");
  AddSpecialDetail( ({"rune", "kreise"}), "detail_rune");
  AddSpecialDetail( ({"beet", "blumenbeet"}), "detail_beet");
  AddSpecialDetail( ({"bild"}), "detail_bild");

  AddItem(NPC "humuswaechter", REFRESH_DESTRUCT);

  AddCmd(({"beruehre", "beruehr", "lege", "leg"}), "cmd_beruehren");
  AddCmd( ({"entfern", "entferne", "reiss", "reisse"}), "cmd_entfernen");
  AddCmd("suche|such|durchsuche|durchsuch&hecke|hecken", "cmd_durchsuchen", "Was willst du durchsuchen?");
  AddCmd("giesse|giess&blumen|beet|blumenbeet", "cmd_giessen", "Was willst du giessen?");

  AddExit("osten", ROOM "luft");
  AddExit("westen", ([EX_DEST: ROOM "siegel", EX_TESTFUNC: "test_mark"]) );
}

public int cmd_giessen() {
  object kanne;
  kanne = present("\ngwenshara_siegel_giesskanne", TP);
  if(!objectp(kanne)) {
    write(BS("Wenn du nur eine Kanne mit Wasser haettest..."));
    return -1;
  }

  if(!kanne->QueryProp("filled")) {
    write(BS("Hm. Deine Giesskanne ist doch leer?"));
    return -1;
  }

  gegossen = 1;

  write(BS("Du giesst das Beet und die Blumen beginnen sofort rasant zu wachsen. Jetzt erkennst du auch, dass sie "
           "geschickt gepflanzt wurden und ein Bild darstellen."));
  say(BS(TPN+" giesst das Beet und die Blumen beginnen sofort rasant zu wachsen."));
  kanne->remove(1);
  return 1;
}

public int cmd_durchsuchen() {
  object kanne;

  write(BS("Rasch durchsuchst du die Hecke."));
  say(BS(TPN+" wuehlt in der Hecke herum."));

  if(kanneDa && !objectp(present("\ngwenshara_siegel_giesskanne"))) {
    kanne = clone_object(OBJ "kanne");
    kanne->move(TO, M_NOCHECK);
    kanneDa = 0;
    write(BS("Du findest eine alte Giesskanne, die du aus der Hecke hervor holst."));
    say(BS(TPN+" zerrt eine alte Giesskanne aus der Hecke hervor."));
  } else {
    write(BS("Leider findest du nichts darin."));
  }

  return 1;
}

public void ResetState() {
  ::ResetState();
  if(!ueberwuchert) {
    tell_room(TO, BS("Dicke Ranken ueberwuchern den Monolithen."));
    ueberwuchert = 1;
  }

  if(gegossen) {
    tell_room(TO, BS("Die Blumen im Beet verdorren."));
    gegossen = 0;
  }

  kanneDa = 1;
}

public string detail_bild() {
  if(!gegossen) {
    return BS("Sowas siehst du hier nicht.");
  } else {
    return BS(sprintf("Die Blumen ergeben das Bild eines alten Mannes mit Bart, "
           "Der seine Haende ausgestreckt hat. Unter seinen Haenden waechst ein "
           "Baum zur Reife heran. Auf seiner Stirn traegt er die Rune '%s'.", GetWord()));
  }
}

public string detail_beet() {
  if(!gegossen) {
    return BS("Das Blumenbeet liegt trocken und verstaubt vor dir.");
  } else {
    return BS("Im Blumenbeet sind hochgewachsene bunte Blumen verschiedener Farben. Bei "
              "genauerem Hinsehen erkennst du, dass sie geschickt gepflanzt wurden und ein "
              "Bild ergeben.");
  }
}

public string detail_monolith() {
   string str;
   str = "Ein Monolith steht mitten auf dieser Lichtung. Es scheint so, als wuerde er aus gruenem, "
         "moosbewachsenem Stein bestehen. ";
   if(!ueberwuchert) str += "Mitten auf dem Monolithen prangt eine etwa handgrosse Rune.";
   else str += "Er ist so mit Ranken ueberwuchert, dass du nicht genau erkennen kannst wie er aussieht.";
   return str + "\n";
}

public string detail_rune() {
 if(ueberwuchert) {
  return BS("Du kannst hier keine Rune erkennen. Vielleicht unter den Ranken?");
 }

 return BS("Die Rune, die am Monolithen prangt, sieht aus wie zwei konzentrische Kreise. Sie ist "
           "etwa so gross wie deine Hand und mit flauschigem Moos bewachsen.");
}


public int test_mark() {
    if(!objectp(present("\ngwenshara_siegel_mark_humus", TP))) {
        tell_object(TP, BS("Als du den Weg weitergehen willst wachsen dornige Ranken darueber."));
        return 0;
    }
    return 1;
}

public int IsGlove(object ob) {
    return ob->QueryProp(P_ARMOUR_TYPE) == AT_GLOVE;
}

public int cmd_entfernen(string str) {
  notify_fail("Was willst du wovon entfernen?\n");
  if(str == "" || !str) return 0;
  if(str != "ranken von monolith" && str != "ranken am monolith" &&
     str != "ranken von monolithen" && str != "ranken vom monolithen" &&
     str != "ranken am monolithen" && str != "ranken an monolith" && 
     str != "ranken an monolithen") return 0;

  if(!ueberwuchert) {
    write(BS("Jemand hat die Ranken bereits entfernt."));
    return -1;
  }

  write(BS("Grob reisst du Ranken vom Monolithen herunter. Darunter kommt eine Rune aus konzentrischen "
           "Kreisen zum vorschein."));
  say(BS(TPN+" reisst einige Dornenranken vom Monolithen."));

  ueberwuchert = 0;
  return 1;
}


public int cmd_beruehren(string str) {
    object* glove, mark;
    notify_fail("Was willst du beruehren?\n");
    if(!str || str == "") return 0;
    if(str != "rune" && str != "kreise" && str != "hand auf rune" &&
       str != "hand auf kreise") return 0;

    if(ueberwuchert) {
      write(BS("Du kannst an dem Monolithen keine Rune erkennen. Dazu ist er viel zu sehr mit "
               "Ranken ueberwuchert."));
      return -1;
    }

    if(objectp(present("\ngwenshara_siegel_mark_humus", TP))) {
        write(BS("Du bist bereits vom Humus gezeichnet. Nochmal brauchst du das nicht."));
        return -1;
    }

    if(objectp(present("\ngwenshara_siegel_humuswache"))) {
        write(BS("Der elementare Waechter laesst eine Wand dorniger Ranken vor dir entstehen, bevor du dich dem Monolithen naehern kannst."));
        return -1;
    }

    glove = filter_array(TP->QueryArmours(), "IsGlove");
    if(sizeof(glove) > 0) {
        write(BS("Du legst deine Hand auf die Rune. Durch den Handschuh spuehrst du die Rune kaum. Sonst geschieht nichts."));
    } else {
        mark = clone_object(OBJ "debuff_humus");
        if(mark->move(TP, M_NOCHECK|M_SILENT) != 1) {
            destruct(mark);
        }
        TP->UpdateAttrbutes();
        write(BS("Du legst deine Hand auf die Rune. Mit einem schmerzhaften Stich bohrt sich ein Dorn in deinen Finger "
             "und zwei konzentrische Kreise bilden sich auf deiner Handflaeche."));
    }
    say(BS(TPN+" beruehrt den Monolithen."));
    return 1;
}

public void enable_nightvision(object pl) {
  object nv;
  nv = clone_object(OBJ "adapted_eyes");
  if(nv->move(pl, M_NOCHECK) != 1) {
    destruct(nv);
  }
}

public void init() {
  ::init();

  if(!objectp(present("\nadapted_eyes", TP))) {
    if(query_once_interactive(TP)) {
      call_out("enable_nightvision", 2, TP);
    }
  }
}

