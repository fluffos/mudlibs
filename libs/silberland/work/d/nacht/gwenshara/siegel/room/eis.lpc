#include "../def.h"

inherit ROOM "std_room";

public void create() {
  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_INT_SHORT, "In einer Hoehle aus Eis");
  SetProp(P_INT_LONG,
    "Du stehst hier in einer grossen Hoehle, deren Waende, Decke und Boden "
    "vollstaendig mit glattem Eis ueberzogen sind. Ueberall glaenzt und "
    "blitzt es. Bei jedem Schritt bleibst du an dem kalten Boden haften. "
    "In der Mitte der Hoehle erhebt sich ein einzelner Monolith.");

//--Umgebung---------------------------------------------------------------

  SetProp(P_LIGHT, 0);
  SetProp(P_INDOORS, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE: -30, ENV_TERRAIN: TT_CAVE]) );

//--Details----------------------------------------------------------------

  AddDetail( ({ "hoehle", "raum" }),
    "Die Hoehle ist riesig und ueberall mit Eis bedeckt.");

  AddDetail( ({ "waende", "wand" }),
    "Die Waende er Hoehle sind von einer glatten Schicht aus blaeulich-weissem "
    "Eis ueberzogen.");

  AddDetail( ({"decke"}),
     "Die Decke, hoch ueber dir, ist mit hunderten scharfkantiger Eiszapfen ubersaeaet.");

  AddDetail( ({"boden"}),
     "Der ganze Boden ist eine einzige Eisflaeche, so glatt, dass du darauf herumrutschen "
     "kannst.");

  AddDetail( ({"eis"}),
     "Glattes Eis funkelt in der ganzen Hoehle.");

  AddDetail( ({"schritt"}),
     "Deine Fuesse bleiben bei jedem Schritt durch die schiere Kaelte ein wenig kleben.");

  AddDetail( ({"mitte"}),
     "Ein mehrere Meter hoher Monolith erhebt sich einsam in der Mitte der Hoehle.");

  AddDetail( ({"monolith"}),
     "Der Monolith ist ebenfalls von einer dicken Eisschicht eingehuellt. Einzig eine "
     "Rune, etwa so gross wie deine Hand, ist frei von dem Frost.");

  AddDetail( ({"schicht", "eisschicht"}),
     "Die Eisschicht ist mehrere Finger dick.");

  AddDetail( ({"zapfen", "eiszapfen"}),
     "Hunderte messerscharfer Eiszapfen hangen von der Decke herab. Hoffentlich fallen "
     "sie nicht auf dich herunter!");

  AddDetail( ({"flaeche", "eisflaeche"}),
     "Der ganze Boden ist eine mit leichtem Schnee bedeckte Eisflaeche, auf der man "
     "sicher prima rutschen kann.");

  AddDetail( ({"kaelte"}),
     "Die Kaelte faehrt dir in alle Glieder und Knochen.");

  AddDetail( ({"meter"}),
     "Der Monolith ist mehrere Meter hoch.");

  AddDetail( ({"rune"}),
     "Die Rune ist etwa so gross wie deine Hand und zeigt eine Raute.");

  AddDetail( ({"frost", "reif"}),
     "Frost und Reif bedecken den ganzen Raum.");

  AddDetail( ({"finger"}),
     "Etwa so dick, wie vier deiner Finger.");

  AddDetail( ({"glieder", "knochen"}),
     "Dir ist kalt, bis in die Knochen.");

  AddDetail( ({"raute"}),
     "Die Rune zeigt eine Raute.");

  AddDetail( ({"schnee"}),
     "Feiner Schnee bedeckt die Eisflaeche.");     

  AddDetail( ({"hand"}),
     "Du hast zwei davon.");

  AddDetail( ({"fuesse"}),
     "Deine Fuesse haften immer wieder am Eis, wenn du zu lange nur herumstehst.");

  AddSpecialDetail( ({"mosaik"}), "detail_mosaik");

  AddItem(NPC "eiswaechter", REFRESH_DESTRUCT);

  AddCmd(({"rutsch", "rutsche"}), "cmd_rutschen");
  AddCmd(({"beruehre", "beruehr", "lege", "leg"}), "cmd_beruehren");

  AddExit("osten", ANSCHLUSS_GEBIRGE);
  AddExit("westen", ([EX_DEST: ROOM "wasser", EX_TESTFUNC: "test_mark"]) );
}

public int test_mark() {
    if(!objectp(present("\ngwenshara_siegel_mark_ice", TP))) {
        tell_object(TP, BS("Gerade als du weitergehen willst, stuerzt ein Eiszapfen von der Decke und durchbohrt dich. "
                           "Angeschlagen stolperst du zurueck."));
        tell_room(TO, BS("Gerade als "+TPN+" weitergehen will, stuerzt ein Eiszapfen von der Decke und durchbohrt "
                         +TP->QueryPronoun(WEN)+"."), ({TP}));
        SetProp(P_KILL_NAME, "Ein Eiszapfen");
        TP->do_damage(20+random(20));
        return 0;
    }
    return 1;
}

public string detail_mosaik() {
    return BS(sprintf("Das Mosaik unter dem Eis kannst du kaum erkennen. Es zeigt einen baertigen Mann, der "
    "von Eis und Schnee umgeben ist. Auf seiner Stirn prangt die Rune '%s'.", GetWord()));
}

public int cmd_rutschen(string str) {
    notify_fail("Worauf willst du rutschen?\n");
    if(!str || str == "") return 0;
    if(str != "auf boden" && str != "auf boden herum" &&
       str != "auf eis" && str != "auf eis herum" &&
       str != "auf eisflaeche" && str != "auf eisflaeche herum") return 0;

    write(BS("Mit ein paar eleganten Schwuengen gleitest du auf der Eisflaeche herum. Als du deine "
             "Spuren ansiehst, stellst du ueberrascht fest, dass sich unter dem Eis ein Mosaik befindet."));
    say(BS(TPN+" gleitet mit ein paar eleganten Schwuengen am Eisboden herum."));

    return 1;
}

public int IsGlove(object ob) {
    return ob->QueryProp(P_ARMOUR_TYPE) == AT_GLOVE;
}

public int cmd_beruehren(string str) {
    object* glove, mark;
    notify_fail("Was willst du beruehren?\n");
    if(!str || str == "") return 0;
    if(str != "rune" && str != "raute" && str != "hand auf rune" &&
       str != "hand auf raute") return 0;

    if(objectp(present("\ngwenshara_siegel_mark_ice", TP))) {
        write(BS("Du bist bereits vom Eis markiert. Nochmal brauchst du das nicht."));
        return -1;
    }

    if(objectp(present("\ngwenshara_siegel_frostwache"))) {
        write(BS("Der elementare Waechter baut sich vor dir auf und laesst dich nicht nach genug an "
              "den Monolithen herankommen."));
        return -1;
    }

    glove = filter_array(TP->QueryArmours(), "IsGlove");
    if(sizeof(glove) > 0) {
        write(BS("Du legst deine Hand auf die Rune. Durch den Handschuh fuehlt sie sich kuehl an. Sonst geschieht nichts."));
    } else {
        mark = clone_object(OBJ "debuff_eis");
        if(mark->move(TP, M_NOCHECK|M_SILENT) != 1) {
            destruct(mark);
        }
        TP->UpdateAttrbutes();
        write(BS("Du legst deine Hand auf die Rune. Eine scharfe Kaelte faehrt in deine Finger und laehmt sie. "
                 "Brennend bleibt eine Raute, wie eine Verbrennung, auf deiner Hand zurueck."));
    }
    say(BS(TPN+" beruehrt den Monolithen."));

    call_out("waechter_kill", 0);
    return 1;
}
