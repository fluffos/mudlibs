#include "../def.h"
#include "/gilden/paladine/paladin_extern.h"
#include "/p/daemon/itemd/itemd.h"

inherit "std/armour";

void create()
{
  if( !is_clone(TO) ) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Die Rueckenplatte des Nachtwandlers");
  SetProp(P_LONG,
    "Diese Rueckenplatte schuetzte einst das empfindliche Rueckgrat des "
    "Nachtwandlers. Jetzt haeltst du sie in den Haenden. Sie ist grob wie ein "
    "Spitzschild geformt und laesst sich ganz gut als Schild halten.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Rueckenplatte des Nachtwandlers");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"rueckenplatte", "platte", "nachtwandlerplatte"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([MAT_CHITIN: 70, MAT_MISC_UNHOLY: 15, MAT_MISC_MAGIC: 15]) );
  SetProp(P_WEIGHT, 1000);
  SetProp(P_VALUE, 5000);
  SetProp(P_NOBUY, 1);
  
//--Ruestungseigenschaften-------------------------------------------------

  SetProp(P_ARMOUR_TYPE, AT_SHIELD );
  SetProp(P_AC, 27);
  SetProp(P_QUALITY_DECAY, 120);

  AddProp(P_DAM_PROTECTION, PHYSICAL_DAMAGE_TYPES + ([DT_UNHOLY: 1, DT_LIGHT: 1]) );
  SetProp(P_WEAR_RESTRICTIONS, ([SR_SEER: 1]) );

  SetProp(P_INFO, BS("Die Rueckenplatte des Nachtwandlers eignet sich besonders gut fuer Schildparaden."
                     "Ausserdem ist sie der Sitz des Magieschutzes des Nachtwandlers."));
  SetProp(P_ITEMD_NO_MAGIC, 1);
  SetProp(P_MAGIC, 1);

  SetProp(P_PALADIN_SCHILDPARADE_AC, 20);

  SetProp(P_DEFEND_FUNC, TO);

  SetProp(P_M_HEALTH_MOD,([P_HP:1,P_SP:1]));
}

public int DefendFunc(string *dtyp, mixed spell, object enemy) {
  if(!random(20)) {
    tell_object(QueryProp(P_WORN), "Die Antimagische Wirkung der Rueckenplatte strahlt auf " + enemy->name(WEN) + " aus.");
    enemy->SetProp(P_DISABLE_SPELLS, 1+random(3));
  }

  return 0;
}
