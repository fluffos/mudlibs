inherit "/gilden/bardengilde/instrument/base_floete";


#include "../def.h"
#include "/gilden/bardengilde/barden_extern.h"

create()
{
  if( !is_clone(TO) ) return;
  ::create();
  
  SetProp(P_SHORT, "Eine Nachthorn");
  SetProp(P_LONG, 
	  BS("Dieses Horn des Nachtwandlers ist hohl und mit Loechern versehen. In sein spitzes "
       "Ende laesst sich hineinblasen, was durch die verdrehten Windungen interessante "
       "Toene erzeugt. Mit im lassen sich wahrlich meisterhafte Lieder spielen.")); 
  SetProp(P_NAME, "Nachthorn");
  SetProp(P_GENDER, NEUTER);
  AddId(({"horn", "nachthorn"}));
  SetProp(P_MATERIAL, ([MAT_BONE: 70, MAT_MISC_UNHOLY: 15, MAT_MISC_MAGIC: 15]) );
  SetProp(P_WEIGHT, 500);
  SetProp(P_INSTRUMENT_LEVEL, 7);

  SetProp(P_MATERIAL, ([MAT_CHITIN: 70, MAT_MISC_UNHOLY: 15, MAT_MISC_MAGIC: 15]) );
  SetProp(P_WEIGHT, 1000);
  SetProp(P_VALUE, 5000);
  SetProp(P_NOBUY, 1);
  SetProp(P_NR_HANDS, 2);

  SetProp(P_AC, 15);

  AddProp(P_DAM_PROTECTION, PHYSICAL_DAMAGE_TYPES + ([DT_UNHOLY: 1, DT_LIGHT: 1]) );
  SetProp(P_WEAR_RESTRICTIONS, ([SR_SEER: 1]) );

  SetProp(P_INFO, BS("Dieses Horn ist ein formidables Instrument fuer alle Barden, die Blasinstrumente bevorzugen."));
  SetProp(P_ITEMD_NO_MAGIC, 1);
  SetProp(P_MAGIC, 1);

  SetProp(P_BARDEN_BONUS, (["all": 5]));
  SetProp(P_BARDEN_SPELLCOST, 10);

  SetProp(P_M_HEALTH_MOD,([P_HP:1,P_SP:1]));
}














