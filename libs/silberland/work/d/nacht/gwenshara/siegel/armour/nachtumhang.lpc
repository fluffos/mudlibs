#include "../def.h"
#include "/gilden/nekromanten/nekro_properties.h"
#include "/p/daemon/itemd/itemd.h"

inherit "std/armour";

void create()
{
  if( !is_clone(TO) ) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Die ledrigen Hautfetzen des Nachtwandlers");
  SetProp(P_LONG,
    "In deinen Haenden haeltst du die blutigen Hautfetzen des Nachtwandlers. "
    "Sie sind, wie sein ganzer Koerper, von schwarzer Farbe und verstroemen "
    "einen purpurenen Nebel. Schleimiger Eiter und dickes Blut tropfen immer "
    "noch daran herab. Man koennte sie sich sicher als Umhang umlegen. Aber "
    "wer wuerde das schon wollen?");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Hautfetzen des Nachtwandlers");
  SetProp(P_PLURAL, 1);
  SetProp(P_GENDER, FEMALE);
  AddId( ({"fetzen", "hautfetzen"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([MAT_CHITIN: 70, MAT_MISC_UNHOLY: 15, MAT_MISC_MAGIC: 15]) );
  SetProp(P_WEIGHT, 1000);
  SetProp(P_VALUE, 5000);
  SetProp(P_NOBUY, 1);
  
//--Ruestungseigenschaften-------------------------------------------------

  SetProp(P_ARMOUR_TYPE, AT_CLOAK );
  SetProp(P_AC, 8);
  SetProp(P_QUALITY_DECAY, 120);

  AddProp(P_DAM_PROTECTION, PHYSICAL_DAMAGE_TYPES + ([DT_UNHOLY: 1, DT_LIGHT: 1]) );
  SetProp(P_WEAR_RESTRICTIONS, ([SR_SEER: 1]) );

  SetProp(P_INFO, BS("Diese Hautfetzen verleihen dir ein furchteinfloessendes Aussehen. "
                     "Eigentlich muessten sie genau das Richtige fuer Nekromanten sein."));
  SetProp(P_ITEMD_NO_MAGIC, 1);
  SetProp(P_MAGIC, 1);

  SetProp(P_NEKRO_BONUS, (["schleier des val-tkro-tthar":10, "schrecken der finsternis": 10]) );

  SetProp(P_DEFEND_FUNC, TO);

  SetProp(P_M_HEALTH_MOD,([P_HP:1,P_SP:1]));
}

public int DefendFunc(string *dtyp, mixed spell, object enemy) {
  if(!objectp(QueryProp(P_WORN))) return 0;

  if(!random(20)) {
       tell_object(QueryProp(P_WORN), BS("Die Dunkelheit der Hautfetzen zieht sich um dich zusammen und jagt " + enemy->name(WEM) + " Angst ein!"));
       tell_object(enemy, 
                     BS("Die Dunkelheit der Hautfetzen um " + QueryProp(P_WORN)->name(WEN) + "zieht sich um dich zusammen und jagt dir Angst ein!"));
       tell_room(environment(enemy), 
              BS("Dunkelheit zieht sich um " + QueryProp(P_WORN)->name(WEN) + " zusammen und jagt " + enemy->name(WEM) + " Angst ein!"), 
              ({enemy, QueryProp(P_WORN)}));
       enemy->SetProp(P_DISABLE_ATTACK, 1 + random(3));
  }

  return 0;
}
