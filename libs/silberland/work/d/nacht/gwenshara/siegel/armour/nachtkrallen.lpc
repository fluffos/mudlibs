#include "../def.h"
#include "/gilden/druidenzirkel/druiden_extern.h"
#include "/p/daemon/itemd/itemd.h"

inherit "std/armour";

void create()
{
  if( !is_clone(TO) ) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Die Krallen des Nachtwandlers");
  SetProp(P_LONG,
    "Diese langen violett-schwarzen Gebilde sind die Krallen des Nachtwandlers. "
    "Sie sind lang und spitz, jedoch innen hohl, sodass du sie dir ueberstuelpen "
    "kannst. Eine magische Aura geht von ihnen aus.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Krallen des Nachtwandlers");
  SetProp(P_GENDER, FEMALE);
  AddId( ({"krallen", "nachtwandlerkrallen"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([MAT_CHITIN: 70, MAT_MISC_UNHOLY: 15, MAT_MISC_MAGIC: 15]) );
  SetProp(P_WEIGHT, 300);
  SetProp(P_VALUE, 5000);
  SetProp(P_NOBUY, 1);
  
//--Ruestungseigenschaften-------------------------------------------------

  SetProp(P_ARMOUR_TYPE, AT_GLOVE );
  SetProp(P_AC, 9);
  SetProp(P_QUALITY_DECAY, 120);

  AddProp(P_DAM_PROTECTION, PHYSICAL_DAMAGE_TYPES + ([DT_UNHOLY: 1]) );
  SetProp(P_WEAR_RESTRICTIONS, ([SR_SEER: 1]) );

  SetProp(P_INFO, BS("Die Krallen des Nachtwandlers sind von besonderer Elementarkraft durchdrungen."));
  SetProp(P_ITEMD_NO_MAGIC, 1);
  SetProp(P_MAGIC, 1);

  SetProp(P_DRUID_ADD_HAND_DAMAGE, 20);
  SetProp(P_DRUID_HAND_DAMAGE_TYPE, GEIST);

  SetProp(P_DEFEND_FUNC, TO);

  SetProp(P_M_HEALTH_MOD,([P_HP:1,P_SP:1]));
}

public int DefendFunc(string *dtyp, mixed spell, object enemy) {
  if(!random(20)) {
    tell_object(QueryProp(P_WORN), "Die Krallen des Nachtwandlers packen ploetzlich zu und halten " + enemy->Name(WEN) + " fest.");
    enemy->SetProp(P_DISABLE_ATTACK, 1+random(3));
  }

  return 0;
}
