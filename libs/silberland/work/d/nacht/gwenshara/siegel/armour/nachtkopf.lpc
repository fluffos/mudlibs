#include "../def.h"
#include "/gilden/berserker/berserker_extern.h"
#include "/p/daemon/itemd/itemd.h"

inherit "std/armour";

void create()
{
  if( !is_clone(TO) ) return;

  ::create();

//--Beschreibungen---------------------------------------------------------

  SetProp(P_SHORT, "Der abgetrennte Kopf des Nachtwandlers");
  SetProp(P_LONG,
    "Siegreich haeltst du den abgetrennten Kopf des Nachtwandlers in den Haenden. "
    "Du stellst fest, dass er innen Hohl ist und er sich damit ganz gut als gehoernter "
    "Helm tragen laesst. Zwei gewunden Hoerner ranken sich dann von deinem Kopf in die "
    "Hoehe und du kannst durch die ausdruckslosen Augen des Nachtwandlers blicken.");

//--Namen------------------------------------------------------------------

  SetProp(P_NAME, "Kopf des Nachtwandlers");
  SetProp(P_GENDER, MALE);
  AddId( ({"kopf", "nachtwandlerkopf"}) );

//--Eigenschaften----------------------------------------------------------

  SetProp(P_MATERIAL, ([MAT_CHITIN: 70, MAT_MISC_UNHOLY: 15, MAT_MISC_MAGIC: 15]) );
  SetProp(P_WEIGHT, 1000);
  SetProp(P_VALUE, 5000);
  SetProp(P_NOBUY, 1);
  
//--Ruestungseigenschaften-------------------------------------------------

  SetProp(P_ARMOUR_TYPE, AT_HELMET );
  SetProp(P_AC, 12);
  SetProp(P_QUALITY_DECAY, 120);

  AddProp(P_DAM_PROTECTION, PHYSICAL_DAMAGE_TYPES + ([DT_UNHOLY: 1, DT_LIGHT: 1]) );
  SetProp(P_WEAR_RESTRICTIONS, ([SR_SEER: 1]) );

  SetProp(P_INFO, BS("Wer diesen Kopf als Helm traegt muss wirklich ein blutwuetiger Berserker sein."
                     "Vermutlich kann man damit auch gute Kopfstoesse austeilen."));
  SetProp(P_ITEMD_NO_MAGIC, 1);
  SetProp(P_MAGIC, 1);

  SetProp(P_EFFECTIVE_WC, 220);
  SetProp(P_BERSERKER_BONUS, (["blutrausch":15]) );

  SetProp(P_DEFEND_FUNC, TO);

  SetProp(P_M_HEALTH_MOD,([P_HP:1,P_SP:1]));
}

public int DefendFunc(string *dtyp, mixed spell, object enemy) {
  if(!objectp(QueryProp(P_WORN))) return 0;
  if(present("\nberserker_blutrausch", QueryProp(P_WORN)) && !random(10)) {
    tell_object(QueryProp(P_WORN), BS("In wildem Blutrausch rammst du " + enemy->name(WEM) + " deinen Kopf ins Gesicht."));
    enemy->Defend(200 + random(100), ({DT_PIERCE, DT_BLUDGEON}), ([SP_SHOW_DAMAGE:({
      ({ -1, "@WESSEN2 Kopf trifft nur Luft.",
             "Dein Kopf trifft nur Luft.",
             "@WESSEN2 Kopf trifft nur Luft."}),
      ({  0, "@WER2 streift Dich.",
             "Du streifst @WEN1.",
             "@WER2 streift @WEN1." }),
      ({  5, "@WER2 verletzt Dich.",
             "Du verletzt @WEN1.",
             "@WER2 verletzt @WEN1." }),
      ({ 10, "@WER2 verletzt Dich schwer.",
             "Du verletzt @WEN1 schwer.",
             "@WER2 verletzt @WEN1 schwer." }),
      ({ 15, "@WER2 verletzt Dich sehr schwer.",
             "Du verletzt @WEN1 sehr schwer.",
             "@WER2 verletzt @WEN1 sehr schwer." }),
      ({ 20, "@WER2 bricht Dir die Nase.",
             "Du brichst @WEM1 die Nase.",
             "@WER2 bricht @WEM1 die Nase." }),
      ({ 30, "@WER2 zerschmettert Dein Gesicht.",
             "Du zerschmetterst @WESSEN1 Gesicht.",
             "@WER2 zerschmettert @WESSEN1 Gesicht." }),
      ({ 40, "@WER2 schlaegt Dein Gesicht zu Brei.",
             "Du schlaegst @WESSEN1 Gesicht zu Brei.",
             "@WER2 schlaegt @WESSEN1 Gesicht zu Brei." }),
      ({ 50, "@WER2 schlaegt Dein Gesicht zu Klump.",
             "Du schlaegst @WESSEN1 Gesicht zu Klump.",
             "@WER2 schlaegt @WESSEN1 Gesicht zu Klump." }),
      ({ 75, "@WER2 zertruemmert Dein Gesicht zu feinem Staub.",
             "Du zertruemmerst @WESSEN1 Gesicht zu feinem Staub.",
             "@WER2 zertruemmert @WESSEN1 Gesicht zu feinem Staub." }),
      ({ 100,"@WER2 zerstoert Dein Gesicht.",
             "Du zerstoerst @WESSEN1 Gesicht.",
             "@WER2 zerstoert @WESSEN1 Gesicht." }),
      ({ 150,"@WER2 vernichtet Dein Gesicht.",
             "Du vernichtest @WESSEN1 Gesicht.",
             "@WER2 vernichtet @WESSEN1 Gesicht." }),
      })]), QueryProp(P_WORN));
  }

  return 0;
}
