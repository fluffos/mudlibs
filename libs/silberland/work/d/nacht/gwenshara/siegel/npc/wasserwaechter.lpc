#include "../def.h"

inherit "std/npc";
inherit "/std/npc/spells";

public void create() {
  if(!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein elementarer Waechter des Wassers schwimmt hier");
  SetProp(P_LONG,
    "Dieser elementare Waechter ist ausschliesslich aus Wasser geformt. "
    "Sein koerper bleicht einer sprudelnden Fontaeine, die sich ueber "
    "die Wasseroberflaeche bewegt und schaeumende Gischt hinterlaesst.");

  SetProp(P_NAME, "Waechter des Wassers");
  SetProp(P_GENDER, MALE);
  AddId(({"waechter", "wasserwaechter", "\ngwenshara_siegel_wasserwache"}));
  SetProp(P_ARTICLE, 1);

  create_default_npc(33);

  SetProp(P_HANDS, ({" mit schneidenden Wasserstrahlen",
                    QueryProp(P_HANDS)[1],
                    ({DT_SLASH, DT_WATER})
                    }) );

  SetProp(P_RACE, "Elementar");
  SetProp(P_SIZE, 450);
  SetProp(P_WEIGHT, 575000);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC, 0);

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" will @WEN nicht haben.\n" }) );

  SetProp(P_LOG_INFO, MAGIERNAME + "/" + explode(ZONE, "/")[<1] + ".log" );

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:     -0.1, DT_COLD:      0.3, DT_WATER:      -1.0,
       DT_AIR:       0.0, DT_LIGHTNING: 0.0, DT_EXPLOSION:   0.0,
       DT_SOUND:     0.0, DT_LIGHT:     0.0, DT_ELECTRIC:    0.1,
       DT_ACID:      0.0, DT_POISON:    0.0, DT_TERROR:      0.0,
       DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:       0.0,
       DT_MIND:      0.0, DT_SLASH:    -0.1, DT_BLUDGEON:   -0.1,
       DT_PIERCE:   -0.3, DT_SQUEEZE:  -0.3, DT_WHIP:       -0.1,
       DT_RIP:      -0.1,
     ]) );

  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-100,T_RANGE_MAX:100]));
  SetProp(P_MSGIN, "schwimmt heran");
  SetProp(P_MSGOUT, "schwimmt");
  SetProp(P_MMSGIN, "sprudelt aus dem Boden");
  SetProp(P_MMSGOUT, "versickert");

  SetProp(P_DIE_MSG,  " zerplatzt in feine Wassertropfen.\n");
  SetProp(P_NOCORPSE, 1 );

  AddInfo(DEFAULT_INFO, "bleibt stumm.\n");
  
  SetProp(P_SPELLRATE, 25);

  AddSpell(2, 200,
    Name(WER, 1)+" drueckt dich unter Wasser.\n",
    Name(WER, 1)+" drueckt @WEN unter Wasser.\n",
     DT_AIR, ([SP_SHOW_DAMAGE:1]));

  AddSpell(2, 280,
    Name(WER, 1)+" schleudert einen Wasserstrahl auf dich.\n",
    Name(WER, 1)+" schleudert einen Wasserstrahl auf @WEN.\n",
      DT_WATER, ([SP_SHOW_DAMAGE:1]));

  AddDefaultSpell(1, 350, DS_MASS_DAMAGE, 
    Name(WER,1) + " stemmt eine gewaltige Flutwelle gegen euch alle!\n",
    Name(WER,1) + " stemmt eine gewaltige Flutwelle gegen euch alle!\n", DT_WATER );

  SUID;
}

void die(int poisondeath)
{
  write_file(LOG "npc.kills",
      dtime() + ": " + (CAP(getuid(QueryProp(P_KILLER) || TP)) || "<Unbekannt>") +
      " killt " + name(WEN, 1) + ".\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
        dtime() + ": " + Name(WER, 1) + "hat gerade " + CAP(getuid(player)) +
        " umgebracht.\n");
  }
}
