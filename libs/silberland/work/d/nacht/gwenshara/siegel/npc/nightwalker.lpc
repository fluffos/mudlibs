#include "../def.h"
#include "/gilden/bardengilde/barden_extern.h"

inherit "std/npc";
inherit "/std/npc/spells";

public void create() {
  if(!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Der Nachtwandler");
  SetProp(P_LONG,
    "Der Nachtwandler erhebt sich als riesenhafte Kreatur vor dir. Seine Arme und Beine "
    "sind uebermaessig lang und enden in scharfen, gebogenen Klauen. Auf seinem Kopf "
    "thronen zwei Hoerner, gedreht wie die von Widdern. Seine Augen leuchten wie "
    "helle Sterne am Nachthimmel. Bei jedem Schritt hinterlaesst er eine Spur aus "
    "violett wabernder Dunkelheit. In seinem Gesicht ist keine Regung zu erkennen, sowas "
    "ist ihm fremd. Du erkennst, dass sein einziger Zweck das Verbreiten von "
    "endloser Dunkelheit und Nacht ist. Eine wahre Kreatur der Finsternis.");

  SetProp(P_NAME, "Nachtwandler");
  SetProp(P_GENDER, MALE);
  AddId(({"nachtwandler", "wandler", "\ngwenshara_nachtwandler"}));
  SetProp(P_ARTICLE, 1);

  create_default_npc(55);

  SetProp(P_HANDS, ({" mit seinen langen Klauen aus Finsternis",
                    (int) (QueryProp(P_HANDS)[1] * 1.2),
                    ({DT_RIP, DT_UNHOLY})
                    }) );

  SetProp(P_RACE, "Daemon");
  SetProp(P_SIZE, 750);
  SetProp(P_WEIGHT, 575000);
  SetProp(P_ALIGN, -10000);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC, 40);

  SetProp( P_REJECT, ({ REJECT_DESTRUCT,
    Name(WER,1)+" zerbroeselt @WEN.\n" }) );

  SetProp(P_LOG_INFO, MAGIERNAME + "/" + explode(ZONE, "/")[<1] + ".log" );

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:      0.1, DT_COLD:     -0.3, DT_WATER:       0.0,
       DT_AIR:       0.0, DT_LIGHTNING: 0.1, DT_EXPLOSION:   0.1,
       DT_SOUND:     0.0, DT_LIGHT:     0.5, DT_ELECTRIC:    0.0,
       DT_ACID:      0.0, DT_POISON:   -0.1, DT_TERROR:     -0.5,
       DT_HOLY:      0.2, DT_UNHOLY:   -0.5, DT_MAGIC:      -0.2,
       DT_MIND:      0.0, DT_SLASH:    -0.2, DT_BLUDGEON:   -0.2,
       DT_PIERCE:   -0.2, DT_SQUEEZE:  -0.2, DT_WHIP:       -0.2,
       DT_RIP:      -0.2,
     ]) );

  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-100,T_RANGE_MAX:100]));
  SetProp(P_MSGIN, "stakst langbeinig herein");
  SetProp(P_MSGOUT, "stakst");
  SetProp(P_MMSGIN, "entsteht kreischend aus den Schatten um dich");
  SetProp(P_MMSGOUT, "verschmilzt mit den Schatten");

  SetProp(P_DIE_MSG,  " faellt krachend auf ein Knie und dann tot zu Boden.\n");
  SetProp(P_NOCORPSE, 0 );

  AddInfo(DEFAULT_INFO, " bleibt stumm.\n");
  
  SetProp(P_SPELLRATE, 75);

  AddSpell(3, 350,
    Name(WER, 1)+" zerreisst dich mit seinen Klauen.\n",
    Name(WER, 1)+" zerreisst @WEN mit seinen Klauen.\n",
     DT_RIP, ([SP_SHOW_DAMAGE:1]));

  AddSpell(3, 350,
    Name(WER, 1)+" zerquetscht dich mit seiner Hand.\n",
    Name(WER, 1)+" zerquetscht @WEN mit seiner Hand.\n",
    DT_SQUEEZE, ([SP_SHOW_DAMAGE:1]));

  AddSpell(3, 350,
    Name(WER, 1)+" spiesst doch mit seinen Hoernern auf.\n",
    Name(WER, 1)+" spiesst @WEN mit seinen Hoernern.\n",
      DT_PIERCE, ([SP_SHOW_DAMAGE:1]));

    AddSpell(3, 350,
      Name(WER, 1)+" zerquetscht dich mit seiner Hand.\n",
      Name(WER, 1)+" zerquetscht @WEN mit seiner Hand.\n",
      DT_SQUEEZE, ([SP_SHOW_DAMAGE:1]));

  AddSpell(3, 350,
    Name(WER, 1)+" haucht den Schatten der Nacht auf dich.\n",
    Name(WER, 1)+" haucht den Schatten der Nacht auf @WEN.\n",
      DT_UNHOLY, ([SP_SHOW_DAMAGE:1]));

  AddSpell(1, 1,
    Name(WER, 1)+" faehrt mit seinem schattenhaften Finger direkt in dein Herz!!!\n",
    Name(WER, 1)+" faehrt mit seinem schattenhaften Finger direkt in @WESSEN Herz!!!\n",
    DT_UNHOLY, "death_finger", ([SP_SHOW_DAMAGE:0]));

  AddDefaultSpell(2, 350, DS_BLIND,
    Name(WER,1) + " blickt dich mit seinen strahlenden Augen an und blendet dich!\n",
    Name(WER,1) + " blickt @WEN mit seinen strahlenden Augen an!\n" );

  AddDefaultSpell(2, 400, DS_MASS_DAMAGE,
    Name(WER,1) + " explodiert in unzaehlige Schatten.\n",
    Name(WER,1) + " explodiert in unzaehlige Schatten.\n", ({DT_UNHOLY, DT_EXPLOSION}));

  AddDefaultSpell(2, 400, DS_MASS_DAMAGE,
    "Die Aura " + Name(WESSEN,1) + " laesst auf deiner Haut nekrotische Geschwuere und Blasen entstehen.\n",
    "Die Aura " + Name(WESSEN,1) + " laesst auf deiner Haut nekrotische Geschwuere und Blasen entstehen.\n",
    ({DT_UNHOLY, DT_POISON}));

  AddDefaultSpell(2, 0, DS_MASS_BLIND,
    Name(WER,1) + " huellt alles um dich in Dunkelheit!\n",
    Name(WER,1) + " huellt alles um dich in Dunkelheit!\n" );

  AddDefaultSpell(2, 300, DS_MASS_FEAR,
      Name(WER,1) + " laesst ein markerschuetterndes Kreischen ertoenen!\n",
      Name(WER,1) + " laesst ein markerschuetterndes Kreischen ertoenen!\n" );

  AddSpell(2, 250, 
    Name(WER, 1) + " verschlingt einen Teil deiner Lebenskraft!\n",
    Name(WER, 1) + " verschlingt einen Teil @WESSEN Lebenskraft!\n",
    DT_MIND, "life_debuff", ([SP_SHOW_DAMAGE: 1]));
  

  SUID;
}

public void death_finger(object enemy) {
  enemy->do_damage(50 + random(50)); // direkter schaden
}

public void life_debuff(object enemy) {
  object ob;
  ob = clone_object(OBJ "life_debuff");
  ob->move(enemy, M_NOCHECK);
  ob->startRemove();
  enemy->UpdateAttrbutes();
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
        dtime() + ": " + Name(WER, 1) + "hat gerade " + CAP(getuid(player)) +
        " umgebracht.\n");
  }
}

public int Defend(int dam, string *dam_type_list, mixed spell, object enemy) {
  int r, light;
  object helper;

  r = ::Defend(dam, dam_type_list, spell, enemy);
  if(!objectp(TO)) return r;

  if(r > 50 && !random(3)) {
    tell_room(environment(TO), BS("Ein Teil des Nachtwandlers wird abgeschlagen und fuehrt als Schatten sein eigenes Leben!"));
    helper = clone_object(NPC "nachtschatten");
    helper->move(ENV(TO), M_NOCHECK);
    helper->Kill(enemy);
  }

  if(!random(5)) {
    helper = environment(TO);
    if(!objectp(helper)) return r;

    light = helper->QueryProp(P_TOTAL_LIGHT);

    if(light > 0) {
      tell_room(helper, BS(Name(WESSEN) + " Haut wirft Blasen in dieser Helligkeit!"));
      TO->AddHp(-(light*5));
    } else if(light < 1) {
      tell_room(environment(TO), BS(Name(WER) + " saugt die Dunkelheit der Umgebung in sich auf!"));
      TO->AddHp(10 + (light*10) );
    }
  }

  return r;
}

public void reset() {
  if(!is_clone(TO)) return;
  ::reset();

  if(sizeof(QueryEnemies()[0]) < 1) {
    tell_room(environment(TO), BS(Name(WER) + " verschwindet in der Dunkelheit der Nacht."));
    remove(1);
  }
}

public string get_guild(object ob) {
  if(ob->QueryProp(P_GUILD) != "bardengilde") return ob->QueryProp(P_GUILD);

  return sprintf("%s_%s", ob->QueryProp(P_GUILD), BARD_GROUP(ob));
}

public varargs void die( int poisondeath ) {  
  int i;
  string guild;
  object temp, killer;

  write_file(LOG "npc.kills",
  dtime() + ": " + (CAP(getuid(QueryProp(P_KILLER) || TP)) || "<Unbekannt>") +
  " killt " + name(WEN, 1) + ".\n");

  if(poisondeath) {
    ::die();
    return;
  }

  killer = QueryProp(P_KILLER);
  if(objectp(killer) && query_once_interactive(killer)) {
    guild = get_guild(killer);
    if(IS_LEARNER(killer) || killer->QueryProp(P_TESTPLAYER)) tell_object(killer, sprintf("gilde = %s\n", guild));
      switch(guild) {
        case "nekromanten":
          if(!random(2)) CLONEME(OBJ "nekro_elixir");
          else CLONEME(ARMOUR "nachtumhang");
          break;
        case "dunkelelfen":
          temp = clone_object("/p/armour/helm/mithrilhelm");
          "/p/daemon/itemd/itemd"->identify(temp, -1);
          temp->move(TO, M_NOCHECK);
          break;
        case "paladine":
          CLONEME(ARMOUR "nachtschild");
          break;
        case "berserker":
          CLONEME(ARMOUR "nachtkopf");
          break;
        case "druidenzirkel":
          CLONEME(ARMOUR "nachtkrallen");
          break;
        case "zechpreller":
          CLONEME(WEAPON "nachtkeule");
          break;
        case "bardengilde_alestra":
          CLONEME(ARMOUR "nachtvioline");
          break;
        case "bardengilde_tirena":
          CLONEME(ARMOUR "nachthorn");
          break;
        case "bardengilde_korriax":
          CLONEME(ARMOUR "nachtpauke");
          break;
        case "bardengilde_sarrian":
          CLONEME(ARMOUR "nachtblutpfeife");
          break;
        case "waldlaeufer":
          if(killer->QuerySkillAbility(FIGHT(WT_KNIFE)) > killer->QuerySkillAbility(FIGHT(WT_BOW))) {
           CLONEME(ARMOUR "nachtarmschienen");
          } else if (killer->QuerySkillAbility(FIGHT(WT_KNIFE)) < killer->QuerySkillAbility(FIGHT(WT_BOW))) {
            CLONEME(WEAPON "nachtbogen");
          } else {
            if(!random(2)) CLONEME(ARMOUR "nachtarmschienen");
            else CLONEME(WEAPON "nachtbogen");
          }
          break;
        case "amazonen":
          CLONEME(WEAPON "nachtspiess");
          break;
        default:
          temp = clone_object("/p/armour/bracers/mithrilarmschienen");
          "/p/daemon/itemd/itemd"->identify(temp, -1); 
          temp->move(TO, M_NOCHECK);
          break;
    }
  }

  return ::die(poisondeath);
}
