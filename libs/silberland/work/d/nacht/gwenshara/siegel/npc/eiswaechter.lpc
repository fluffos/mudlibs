#include "../def.h"

inherit "std/npc";
inherit "/std/npc/spells";

public void create() {
  if(!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein elementarer Waechter des Frosts beobachtet dich genau");
  SetProp(P_LONG,
    "Vor dir erhebt sich ein golemartiger Huene aus Eisbloecken. "
    "Gross, wie ein Troll und mit Armen und beinen aus dicken, schneeig glitzernden "
    "Brocken blankes Eises. Seine Augen laeuchten in violett.");

  SetProp(P_NAME, "Frostwaechter");
  SetProp(P_GENDER, MALE);
  AddId(({"waechter", "frostwaechter", "\ngwenshara_siegel_frostwache"}));
  SetProp(P_ARTICLE, 1);

  create_default_npc(33);

  SetProp(P_HANDS, ({" mit seinen Haenden",
                    QueryProp(P_HANDS)[1],
                    ({DT_BLUDGEON, DT_COLD})
                    }) );

  SetProp(P_RACE, "Elementar");
  SetProp(P_SIZE, 450);
  SetProp(P_WEIGHT, 575000);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC, 0);

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" will @WEN nicht haben.\n" }) );

  SetProp(P_LOG_INFO, MAGIERNAME + "/" + explode(ZONE, "/")[<1] + ".log" );

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:      0.3, DT_COLD:      -1.0, DT_WATER:       0.0,
       DT_AIR:       0.0, DT_LIGHTNING: 0.0, DT_EXPLOSION:   0.0,
       DT_SOUND:     0.0, DT_LIGHT:     0.0, DT_ELECTRIC:    0.0,
       DT_ACID:      0.0, DT_POISON:    0.0, DT_TERROR:      0.0,
       DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:       0.0,
       DT_MIND:      0.0, DT_SLASH:    -0.1, DT_BLUDGEON:   -0.1,
       DT_PIERCE:   -0.3, DT_SQUEEZE:  -0.3, DT_WHIP:       -0.1,
       DT_RIP:      -0.1,
     ]) );

  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-100,T_RANGE_MAX:5]));
  SetProp(P_MSGIN, "stampft heran");
  SetProp(P_MSGOUT, "stampft");
  SetProp(P_MMSGIN, "formt sich aus Eisbloecken");
  SetProp(P_MMSGOUT, "schmilzt");

  SetProp(P_DIE_MSG,  " zerfaefllt zu einzelnen Eisbloecken.\n");
  SetProp(P_NOCORPSE, 0 );

  AddInfo(DEFAULT_INFO, "bleibt stumm.\n");
  
  SetProp(P_SPELLRATE, 25);

  AddSpell(2, 200,
    Name(WER, 1)+" laesst seinen Hammer auf dich niedersausen.\n",
    Name(WER, 1)+" laesst seinen Hammer auf @WEN niedersausen.\n",
     DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));

  AddSpell(2, 280,
    Name(WER, 1)+" bruellt dir seinen kalten Atem entgegen.\n",
    Name(WER, 1)+" bruellt @WEM seinen kalten Atem entgegen.\n",
      DT_COLD, ([SP_SHOW_DAMAGE:1]));

  AddDefaultSpell(1, 300, DS_SLOW,
    Name(WER,1) + "friert dich ein!\n",
    Name(WER,1) + " friert @WEN ein!\n" );

  SUID;
  CLONEME(WEAPON "eishammer" );
  command("zuecke hammer");
}

void die(int poisondeath)
{
  write_file(LOG "npc.kills",
      dtime() + ": " + (CAP(getuid(QueryProp(P_KILLER) || TP)) || "<Unbekannt>") +
      " killt " + name(WEN, 1) + ".\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
        dtime() + ": " + Name(WER, 1) + "hat gerade " + CAP(getuid(player)) +
        " umgebracht.\n");
  }
}

//--Reactions--------------------------------------------------------------

void StartReaction(string verb, string gruppe, string adverb, int touch)
{
  if(find_call_out("reaction") != -1) return;

  switch (gruppe)
  {
    case "aengstlich":
      call_out("reaction", 0, TP,
        "",
        "");
      break;

    case "aergerlich":
      call_out("reaction", 0, TP,
        "",
        "");
      break;

    case "albern":
      call_out("reaction", 0, TP,
        "",
        "");
      break;

    case "fies":
      call_out("reaction", 0, TP,
        "",
        "");
      break;

    case "frech":
      call_out("reaction", 0, TP,
        "",
        "");
      break;

    case "froh":
      call_out("reaction", 0, TP,
        "",
        "");
      break;

    case "intim":
      call_out("reaction", 0, TP,
        "",
        "");
      break;

    case "nett":
      call_out("reaction", 0, TP,
        "",
        "");
      break;

    case "neutral":
      call_out("reaction", 0, TP,
        "",
        "");
      break;

    case "traurig":
      call_out("reaction", 0, TP,
        "",
        "");
      break;
  }
}

void StartReactionAll(string verb, string gruppe, string adverb, int touch)
{
  return StartReaction(verb, gruppe, adverb, touch);
}

void reaction(object pl, string macher, string andere)
{
  if(!ENV(TO))           return;
  if(!objectp(pl))       return;
  if(!ENV(pl))           return;
  if(ENV(TO) != ENV(pl)) return;

  tell_object(pl, BS(Name(WER, 1)+" "+macher));
  tell_room(ENV(TO), BS(Name(WER, 1)+" "+andere), ({pl}) );
}
