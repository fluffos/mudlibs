#include "../def.h"

inherit "std/npc";
inherit "/std/npc/spells";

public void create() {
  if(!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein elementarer Waechter des Humus setzt hier neue Baeume");
  SetProp(P_LONG,
    "Dieser elementare Waechter besteht durch und durch aus Dornenranken. Gemeinsam "
    "ergeben die dornigen Aeste eine hochgewachsene und muskuloese Gestalt mit gruenen "
    "gluehenden Augen. Gelegentlich steckt der Waechter einer seine Ranken in den "
    "Boden und laesst einen neuen Baum entstehen.");

  SetProp(P_NAME, "Waechter des Humus");
  SetProp(P_GENDER, MALE);
  AddId(({"waechter", "humuswaechter", "\ngwenshara_siegel_humuswache"}));
  SetProp(P_ARTICLE, 1);

  create_default_npc(34);

  SetProp(P_HANDS, ({" mit seinen Dornenranken",
                    QueryProp(P_HANDS)[1],
                    ({DT_WHIP, DT_POISON})
                    }) );

  SetProp(P_RACE, "Elementar");
  SetProp(P_SIZE, 450);
  SetProp(P_WEIGHT, 575000);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC, 0);

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" will @WEN nicht haben.\n" }) );

  SetProp(P_LOG_INFO, MAGIERNAME + "/" + explode(ZONE, "/")[<1] + ".log" );

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:      0.2, DT_COLD:      0.3, DT_WATER:       0.0,
       DT_AIR:       0.0, DT_LIGHTNING: 0.0, DT_EXPLOSION:   0.1,
       DT_SOUND:     0.0, DT_LIGHT:    -0.2, DT_ELECTRIC:    0.0,
       DT_ACID:     -0.1, DT_POISON:   -1.0, DT_TERROR:      0.0,
       DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:       0.0,
       DT_MIND:      0.0, DT_SLASH:     0.1, DT_BLUDGEON:   -0.3,
       DT_PIERCE:    0.0, DT_SQUEEZE:    0.0, DT_WHIP:       0.0,
       DT_RIP:       0.0,
     ]) );

  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-100,T_RANGE_MAX:100]));
  SetProp(P_MSGIN, "stampft heran");
  SetProp(P_MSGOUT, "stapft");
  SetProp(P_MMSGIN, "formt sich aus Ranken");
  SetProp(P_MMSGOUT, "verrottet");

  SetProp(P_DIE_MSG,  " faellt in sich zusammen.\n");
  SetProp(P_NOCORPSE, 0 );

  AddInfo(DEFAULT_INFO, "bleibt stumm.\n");
  
  SetProp(P_SPELLRATE, 25);

  AddSpell(2, 250,
    Name(WER, 1)+" peitscht dich mit einer Ranke.\n",
    Name(WER, 1)+" peitscht @WEN mit einer Ranke.\n",
     DT_WHIP, ([SP_SHOW_DAMAGE:1]));

  AddSpell(2, 300,
    Name(WER, 1)+" umwickelt dich mit einer stachligen Liane.\n",
    Name(WER, 1)+" umwickelt @WEN mit einer stachligen Liane.\n",
      DT_PIERCE, ([SP_SHOW_DAMAGE:1]));

  AddDefaultSpell(1, 350, DS_POISON, 
    Name(WER,1) + " sticht dich mit einem giftigen Dorn!\n",
    Name(WER,1) + " sticht @WEN mit einem giftigen Dorn!\n" );

  SUID;
}

void die(int poisondeath)
{
  write_file(LOG "npc.kills",
      dtime() + ": " + (CAP(getuid(QueryProp(P_KILLER) || TP)) || "<Unbekannt>") +
      " killt " + name(WEN, 1) + ".\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
        dtime() + ": " + Name(WER, 1) + "hat gerade " + CAP(getuid(player)) +
        " umgebracht.\n");
  }
}
