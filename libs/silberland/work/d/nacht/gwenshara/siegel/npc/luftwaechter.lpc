#include "../def.h"

inherit "std/npc";
inherit "/std/npc/spells";

public void create() {
  if(!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein elementarer Waechter der Luft reitet den Sturm");
  SetProp(P_LONG,
    "Dieser elementare Waechter besteht aus durchscheinenden Luftstroemen. "
    "Du erkennst ihn einzig an seinen hellblau gluehenden Augen. Wie zuckende "
    "Blitze.");

  SetProp(P_NAME, "Waechter der Luft");
  SetProp(P_GENDER, MALE);
  AddId(({"waechter", "luftwaechter", "\ngwenshara_siegel_luftwache"}));
  SetProp(P_ARTICLE, 1);

  create_default_npc(33);

  SetProp(P_HANDS, ({" mit heftigen Luftstoessen",
                    QueryProp(P_HANDS)[1],
                    ({DT_AIR})
                    }) );

  SetProp(P_RACE, "Elementar");
  SetProp(P_SIZE, 450);
  SetProp(P_WEIGHT, 575000);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC, 0);

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" will @WEN nicht haben.\n" }) );

  SetProp(P_LOG_INFO, MAGIERNAME + "/" + explode(ZONE, "/")[<1] + ".log" );

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:      0.0, DT_COLD:      0.3, DT_WATER:       0.0,
       DT_AIR:      -1.0, DT_LIGHTNING: 0.0, DT_EXPLOSION:   0.0,
       DT_SOUND:     0.0, DT_LIGHT:     0.0, DT_ELECTRIC:    0.0,
       DT_ACID:      0.0, DT_POISON:    0.0, DT_TERROR:      0.0,
       DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:       0.0,
       DT_MIND:      0.0, DT_SLASH:    -0.1, DT_BLUDGEON:    0.3,
       DT_PIERCE:   -0.3, DT_SQUEEZE:  -0.3, DT_WHIP:       -0.1,
       DT_RIP:      -0.1,
     ]) );

  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-100,T_RANGE_MAX:100]));
  SetProp(P_MSGIN, "weht heran");
  SetProp(P_MSGOUT, "weht");
  SetProp(P_MMSGIN, "entsteht aus Luft");
  SetProp(P_MMSGOUT, "loest sich in Luft auf");

  SetProp(P_DIE_MSG,  " verschwindet.\n");
  SetProp(P_NOCORPSE, 1 );

  AddInfo(DEFAULT_INFO, "bleibt stumm.\n");
  
  SetProp(P_SPELLRATE, 25);

  AddSpell(2, 200,
    Name(WER, 1)+" schleudert einen Windstoss gegen dich.\n",
    Name(WER, 1)+" schleudert einen Windstoss gegen @WEN.\n",
     DT_AIR, ([SP_SHOW_DAMAGE:1]));

  AddSpell(2, 280,
    Name(WER, 1)+" laesst einen Blitz nach dir zucken.\n",
    Name(WER, 1)+" laesst einen Blitz nach @WEM zucken.\n",
      DT_LIGHTNING, ([SP_SHOW_DAMAGE:1]));

  AddDefaultSpell(1, 350, DS_DEAF, 
    Name(WER,1) + " erzeugt knallenden Donner um dich!\n",
    Name(WER,1) + " erzeugt knallenden Donner um @WEN\n" );

  SUID;
}

void die(int poisondeath)
{
  write_file(LOG "npc.kills",
      dtime() + ": " + (CAP(getuid(QueryProp(P_KILLER) || TP)) || "<Unbekannt>") +
      " killt " + name(WEN, 1) + ".\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
        dtime() + ": " + Name(WER, 1) + "hat gerade " + CAP(getuid(player)) +
        " umgebracht.\n");
  }
}
