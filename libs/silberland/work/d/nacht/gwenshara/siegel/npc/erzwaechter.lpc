#include "../def.h"

inherit "std/npc";
inherit "/std/npc/spells";

public void create() {
  if(!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein elementarer Waechter des Erzes fegt als Sandsturm durch den Raum");
  SetProp(P_LONG,
    "Dieser elementare Waechter ist aus Milliarden kleiner Sandkoerner geformt, die "
    "wirbelnd durcheinander rasen. Er sieht aus wie ein personifizierter Sandsturm mit "
    "gluehenden glben Augen, der sich hoch ueber dich erhebt.");

  SetProp(P_NAME, "Waechter des Erzes");
  SetProp(P_GENDER, MALE);
  AddId(({"waechter", "erzwaechter", "\ngwenshara_siegel_erzwache"}));
  SetProp(P_ARTICLE, 1);

  create_default_npc(34);

  SetProp(P_HANDS, ({" mit einem Sandstrahl",
                    QueryProp(P_HANDS)[1],
                    ({DT_SLASH})
                    }) );

  SetProp(P_RACE, "Elementar");
  SetProp(P_SIZE, 450);
  SetProp(P_WEIGHT, 575000);
  SetProp(P_ALIGN, 0);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC, 0);

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" will @WEN nicht haben.\n" }) );

  SetProp(P_LOG_INFO, MAGIERNAME + "/" + explode(ZONE, "/")[<1] + ".log" );

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:     -0.3, DT_COLD:      0.0, DT_WATER:       0.1,
       DT_AIR:       0.3, DT_LIGHTNING: 0.1, DT_EXPLOSION:   0.0,
       DT_SOUND:     0.2, DT_LIGHT:     0.0, DT_ELECTRIC:   -0.1,
       DT_ACID:      0.0, DT_POISON:    0.0, DT_TERROR:      0.0,
       DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:       0.0,
       DT_MIND:      0.0, DT_SLASH:    -0.3, DT_BLUDGEON:   -0.3,
       DT_PIERCE:   -0.3, DT_SQUEEZE:  -0.3, DT_WHIP:       -0.3,
       DT_RIP:      -0.3,
     ]) );

  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-100,T_RANGE_MAX:100]));
  SetProp(P_MSGIN, "stuermt herein");
  SetProp(P_MSGOUT, "stuermt");
  SetProp(P_MMSGIN, "formt sich aus Staub und Erde");
  SetProp(P_MMSGOUT, "zerfaellt zu einem Sandhaufen");

  SetProp(P_DIE_MSG,  " zerfaellt zu einem Sandhaufen.\n");
  SetProp(P_NOCORPSE, 1);

  AddInfo(DEFAULT_INFO, "bleibt stumm.\n");
  
  SetProp(P_SPELLRATE, 25);

  AddSpell(2, 200,
    Name(WER, 1)+" zerschneidet dich mit einem feinen Sandstrahl.\n",
    Name(WER, 1)+" zerschneidete @WEN mit einem feinen Sandstrahl.\n",
     DT_SLASH, ([SP_SHOW_DAMAGE:1]));

  AddSpell(2, 350,
    Name(WER, 1)+" schleudert einen grossen Felsbrocken auf dich.\n",
    Name(WER, 1)+" schleudert einen grossen Felsbrocken auf @WEN.\n",
      DT_BLUDGEON, ([SP_SHOW_DAMAGE:1]));

  AddDefaultSpell(1, 200, DS_PARALYZE, 
    Name(WER,1) + " laesst dich zu Stein erstarren!\n",
    Name(WER,1) + " laesst @WEN zu Stein erstarren!\n");

  SUID;
}

void die(int poisondeath)
{
  write_file(LOG "npc.kills",
      dtime() + ": " + (CAP(getuid(QueryProp(P_KILLER) || TP)) || "<Unbekannt>") +
      " killt " + name(WEN, 1) + ".\n");

  ::die(poisondeath);
}

void NotifyPlayerDeath(object player, object killer, int lostexp)
{
  if(killer == TO)
  {
    write_file(LOG "npc.deads",
        dtime() + ": " + Name(WER, 1) + "hat gerade " + CAP(getuid(player)) +
        " umgebracht.\n");
  }
}
