#include "../def.h"

inherit "std/npc";
inherit "/std/npc/spells";

public void create() {
  if(!is_clone(TO)) return;
  ::create();

  SetProp(P_SHORT, "Ein Nachtschatten");
  SetProp(P_LONG,
    "Der Nachtschatten ist eine undefinierbare substanz finsterer Materie der Nacht, "
    "die kuenstlich belebt wurde.");

  SetProp(P_NAME, "Nachtschatten");
  SetProp(P_GENDER, MALE);
  AddId(({"schatten", "nschtschatten", "\ngwenshara_nachtschatten"}));
  SetProp(P_ARTICLE, 1);

  create_default_npc(10 + random(10));

  SetProp(P_HANDS, ({" mit seiner Finsternis",
                    QueryProp(P_HANDS)[1],
                    ({DT_BLUDGEON, DT_COLD})
                    }) );

  SetProp(P_RACE, "Elementar");
  SetProp(P_SIZE, 450);
  SetProp(P_WEIGHT, 200);
  SetProp(P_ALIGN, -500);
  SetProp(P_MAX_HANDS, 2);
  SetProp(P_WIMPY, 0);
  SetProp(P_NOMAGIC, 0);
  SetProp(P_AGGRESSIVE, 1);

  SetProp( P_REJECT, ({ REJECT_DROP,
    Name(WER,1)+" will @WEN nicht haben.\n" }) );

  SetProp(P_LOG_INFO, MAGIERNAME + "/" + explode(ZONE, "/")[<1] + ".log" );

  SetProp(P_RESISTANCE_STRENGTHS ,
    ([ DT_FIRE:      0.1, DT_COLD:      0.0, DT_WATER:       0.0,
       DT_AIR:       0.0, DT_LIGHTNING: 0.0, DT_EXPLOSION:   0.0,
       DT_SOUND:     0.0, DT_LIGHT:     1.0, DT_ELECTRIC:    0.0,
       DT_ACID:      0.0, DT_POISON:    0.0, DT_TERROR:      0.0,
       DT_HOLY:      0.0, DT_UNHOLY:    0.0, DT_MAGIC:       0.0,
       DT_MIND:      0.0, DT_SLASH:    -0.1, DT_BLUDGEON:   -0.1,
       DT_PIERCE:   -0.1, DT_SQUEEZE:  -0.1, DT_WHIP:       -0.1,
       DT_RIP:      -0.1,
     ]) );

  SetProp(P_TEMPERATURE_RANGE, ([T_RANGE_MIN:-100,T_RANGE_MAX:5]));
  SetProp(P_MSGIN, "flattert herein");
  SetProp(P_MSGOUT, "flattert");
  SetProp(P_MMSGIN, "entsteht aus Schatten");
  SetProp(P_MMSGOUT, "verblasst");

  SetProp(P_DIE_MSG,  " loest sich auf.\n");
  SetProp(P_NOCORPSE, 1 );

  AddInfo(DEFAULT_INFO, "bleibt stumm.\n");
}
