#include "def.h"
inherit "/std/room";

#define ADAPTED_EYES "/d/nacht/gwenshara/siegel/obj/adapted_eyes"

// TODO make adapted eyes generally available

private void enable_nightvision(object pl) {
    object nv;
    nv = clone_object(ADAPTED_EYES);
    if(nv->move(pl, M_NOCHECK) != 1) {
      destruct(nv);
    }
  }
  
  public void init() {
    ::init();
  
    if(!objectp(present("\nadapted_eyes", TP)) && interactive(TP)) {
      call_out("enable_nightvision", 2, TP);
    }
  }
  