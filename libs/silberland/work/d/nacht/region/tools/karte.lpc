#pragma strict_types

#include <ansi.h>
#include <properties.h>
#include <wizlevels.h>
#include "../defines.h"

#define RANGE_SMALL 1
#define RANGE_DEFAULT 2
#define RANGE_LARGE 4
#define RANGE_XXL 6
#define RANGE_MAX 10

inherit "/std/thing";

#define DBG(x) if (find_player("anatol") && (find_player("anatol")->QueryProp("debug_map"))) tell_object(find_player("anatol"),x)
private nosave string current_zone;
private nosave int * current_pos;
private nosave int current_set;
private nosave mixed * current_zonelist;
private nosave string * raw;
private int activated;

// The Wizard's edition allows viewing any player's position.

nosave int isWizardEdition() 
{
    return ((this_player()==this_interactive())
         &&(!process_call())
         &&(IS_WIZARD(this_interactive()))
         &&(environment(this_object())==this_player()));
}

// The Limited Edition ... just for the show :-)

nosave int isLimitedEdition() 
{
    return ((isWizardEdition()) && (getuid(this_player()) == "anatol"));
}

public string 
_query_short() 
{
    return (living(environment())?"De":"E")+"ine magische Karte"+
      (isWizardEdition()
          ?(isLimitedEdition()
              ?" (Streng limitierte Ausgabe)"
              :" (Sonderdruck fuer Kuenstler)")
          :"");
}

public string
_query_long() 
{
    if (!environment()||(!query_once_interactive(environment())))
        return "Eine geografische Karte. Mehr siehst Du von hier aus nicht.\n";
    if (!activated)
        return break_string("Eine uebersichtliche geografische Karte. Sie "
        "glitzert und funkelt geradezu vor williger Magie. Du kannst "
        "davon ausgehen, dass sie Dir, wo immer sie es vermag, treue "
        "Dienste leistet. Syntax: karte [klein|gross]",77,0,1)+
        (isWizardEdition()
            ?"(und extra fuer Kreative 'karte kreativ-modus')\n"
            :"");
    else
       return 
        sprintf("Befehlsuebersicht:\n"
        ".-----------------------------------------------------------.\n"
        "| karte kreativ-modus                                       |\n"
        "| karte [<x> <y> [<z>]] [set|xset <s>] [klein|gross|riesig] |\n"
        "+-----------------------------+-----------------------------+\n"
        "| zone                        | segment                     |\n"
        "| zone liste [<filter>]       | segment laden [<koords>]    |\n"
        "| zone <zone>|<index>         | segment sichern [<koords>]  |\n"
        "| zone neu <zone>             | segment tilgen [<koords>]   |\n"
        "| zone umbenennen <zone_neu>  | segment 0|1|2 <inhalt>      |\n"
        "| zone tilgen <zone>          +-----------------------------+\n"
        "| zone +kuenstler <uid>       | karte hilfe                 |\n"
        "| zone -kuenstler <uid>       +-----------------------------'\n"
        "| zone steuerung <objekt>     |                              \n"
        "'-----------------------------' %s\n",dtime(file_time(
          explode(file_name(this_object()),"#")[0]+".lpc")));
}

public int
_query_autoloadobj()
{
    return isWizardEdition();
}

nosave int
wizMap(string zone, int * coords, int range, int set, int flags)
{
    if (!coords)
        coords=({0,0,0});
    else if (sizeof(coords)==2) 
        coords+=({0});
    if ((!zone) && (!(zone=current_zone)))
        return 0;
    printf("Zone %s\nKarte %d/%d/%d set %d (r=%d)\n",
        current_zone, coords[0],coords[1],coords[2],0, range);
    printf(GEMA_SERVER->Map(zone,coords,range,set,flags));
    return 1;
}

nosave string getSetList(string zone)
{
  int * sets;
  int i;
  string res;

  sets=(int*)GEMA_SERVER->QuerySets(zone);
  if (!sizeof(sets)) 
      return 0;
  res=" - ";
  for (i=0;i<sizeof(sets);i++)
     res+=to_string(i)+":"+
       to_string((int)(GEMA_SERVER->QueryGraticuleCountPerSet(zone,sets[i])))
       +" ";
  return res;
}
/*
.-----------------------------------------------------------------------------.
| Zone: 12345678901234567890123456789012345678901234567890123456789012345678  |
| Kartenfragmente: 32                                                         |
| Steuerobjekt: /....................................................... [FL] |
|                                                               .-------.     |
| Eingetragene Kartographierer:                   Leersegment:  | .---. |     |
|       - Anatol                                                | | ? | |     |
|       - ....                                                  | '---' |     |
|       - ....                                                  '-------'     |
'-----------------------------------------------------------------------------'
*/

nosave int
showZone()
{
    string handler;
    string * defaultsegment;
    string * maintainer;
    int i;

    printf(ANSI_BOLD+ANSI_BLACK+".-----------------------------"+
        "------------------------------------------------."+
        ANSI_NORMAL+"\n");
    printf(ANSI_BOLD+ANSI_BLACK+"| Zone: "+ANSI_NORMAL+
        sprintf("%-68s ",(current_zone?current_zone:"(keine)"))+
        ANSI_BOLD+ANSI_BLACK+" |"+ANSI_NORMAL+"\n");
    if (current_zone)
    {
        printf(ANSI_BOLD+ANSI_BLACK+"| Sets/Fragmente: "+ANSI_NORMAL+
        sprintf("%-50s      ",
           to_string((int)(GEMA_SERVER->QueryGraticuleCount(current_zone)))+
           getSetList(current_zone))+
        ANSI_BOLD+ANSI_BLACK+
        "    |"+
        ANSI_NORMAL+"\n");
        handler=(string)GEMA_SERVER->QueryHandler(current_zone);
        defaultsegment=(string*)GEMA_SERVER->QueryDefaultGraticule(current_zone);
        maintainer=(string*)GEMA_SERVER->QueryArtists(current_zone);

        printf(ANSI_BOLD+ANSI_BLACK+"| Steuerobjekt: " +ANSI_NORMAL+
            sprintf("%-61s ", (handler?handler+" ["+
            (file_size(handler+".lpc")?"F":"?")+
            (find_object(handler)?"L":"/")+"]":"(keines)"))+
            ANSI_BOLD+ANSI_BLACK+"|"+ANSI_NORMAL+"\n");
        printf(ANSI_BOLD+ANSI_BLACK+"|                            "
               "                                   .-------.     |"
            +ANSI_NORMAL+"\n");

        printf(ANSI_BOLD+ANSI_BLACK+"| Eingetragene Kartographierer:     "
               "              Leersegment:  | "+ANSI_NORMAL+
               ((sizeof(defaultsegment)==3)?
               (string)(GEMA_SERVER->ProcessToAnsi((defaultsegment[0]))):
               "     ")+ANSI_BOLD+ANSI_BLACK+" |     |"+ANSI_NORMAL+"\n");

        printf(ANSI_BOLD+ANSI_BLACK+"|       "+ANSI_NORMAL+
            ((sizeof(maintainer)>0)?"- "+ANSI_NORMAL+sprintf("%-19s ",
            capitalize(maintainer[0])):
            " (keine)              ")+ANSI_BOLD+ANSI_BLACK+"                                  "
            "| "+ANSI_NORMAL+
               ((sizeof(defaultsegment)==3)?
               (string)(GEMA_SERVER->ProcessToAnsi((defaultsegment[1]))):
               "keins")+ANSI_BOLD+ANSI_BLACK+" |     |"+ANSI_NORMAL+"\n");

        printf(ANSI_BOLD+ANSI_BLACK+"|       "+
            ((sizeof(maintainer)>1)?"- "+ANSI_NORMAL+sprintf("%-19s ",
            capitalize(maintainer[1])):
            "                      ")+ANSI_BOLD+ANSI_BLACK+"                                  "
            "| "+ANSI_NORMAL+
               ((sizeof(defaultsegment)==3)?
               (string)(GEMA_SERVER->ProcessToAnsi((defaultsegment[2]))):
               "     ")+ANSI_BOLD+ANSI_BLACK+" |     |"+ANSI_NORMAL+"\n");

        printf(ANSI_BOLD+ANSI_BLACK+"|       "+
            ((sizeof(maintainer)>2)?"- "+ANSI_NORMAL+sprintf("%-19s ",
            capitalize(maintainer[2])):
            "                      ")+ANSI_BOLD+ANSI_BLACK+"                                  "
             "'-------'     |"+ANSI_NORMAL+"\n");
        for (i=3;i<sizeof(maintainer);i++)
        {
            printf(ANSI_BOLD+ANSI_BLACK+"|       "+"- "+ANSI_NORMAL+
                sprintf("%-19s ",capitalize(maintainer[i]))
                +ANSI_BOLD+ANSI_BLACK+"                  "
                 "                              |"+ANSI_NORMAL+"\n");
        }
    }
    printf(ANSI_BOLD+ANSI_BLACK+"'-----------------------------"+
        "------------------------------------------------'"+
        ANSI_NORMAL+"\n");

    return 1;
}

nosave int 
showZoneList(string zonefilter)
{
  int i;

  current_zonelist=(string*)(GEMA_SERVER->GetZones(zonefilter));

  if (!sizeof(current_zonelist))
       printf(break_string(sprintf(
          "Fuer Dich sind %sleider keine der vorhandenen Zonen relevant.\n",
          (stringp(zonefilter)&&strlen(zonefilter)?"(Filter: '"+zonefilter+
            "') ":"")),77));
  else
  {
      printf(break_string(sprintf(
          "Liste der vorhandenen und fuer Dich relevanten Zonen%s:\n",
          (stringp(zonefilter)&&strlen(zonefilter)?" (Filter: '"+zonefilter+
            "')":"")),77));
      for (i=0;i<sizeof(current_zonelist);i++)
          printf("%4d : %s\n",i,current_zonelist[i]);
  }
  return 1;
}

