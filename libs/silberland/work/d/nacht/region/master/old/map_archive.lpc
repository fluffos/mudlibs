/* map archive for the dovenya island - holds the raw data only 
 * __________________________________________(i) Anatol@Silberland (2012) */

#pragma strict_types

#include "../defines.h"
#include <ansi.h>
#include <wizlevels.h>

#define SAVEFILE SAVEDIR "map_archive"

public mapping archive;


nosave int 
authorized() 
{
    return ((this_player())
         && (this_player()==this_interactive()) 
         && (!process_call())
         && (IS_WIZARD(this_player())) 
         && (member((string*)(((mixed)("/secure/master"->get_userinfo(
	       getuid(this_player()))))[3]),"nacht")>=0));
}

nosave void
save()
{
    save_object(SAVEFILE);
}


nosave string 
key(int x, int y, int z) 
{
    return sprintf("%d|%d|%d",x,y,z);
}


public int 
Store(int x, int y, int z, string * g) 
{
    if (!authorized()) 
        return -1;
    if ((!pointerp(g))||(sizeof(g)!=3)||
       (!stringp(g[0]))||(strlen(g[0])<5)||
       (!stringp(g[1]))||(strlen(g[1])<5)||
       (!stringp(g[2]))||(strlen(g[2])<5))
        return 0;
    archive[key(x,y,z)]=({})+g;
    save();
    return 1;
}

public string *
Retrieve(int x, int y, int z)
{
   if (member(archive, key(x,y,z)))
       return ({})+archive[key(x,y,z)];
   else return 0;
}

public int
Delete(int x, int y, int z)
{
    if (!authorized()) return -1;
    if (!member(archive, key(x,y,z)))
       return 0;
    archive-=([key(x,y,z)]);
    return 1;
}


public int
query_prevent_shadow()
{
    return 1;
}

public void 
create()
{
    seteuid(getuid(this_object()));
    if (!restore_object(SAVEFILE))
        archive=([]);

    if ((this_player()) && (IS_WIZARD(this_player())))
        printf("*** %s loaded with %d archives ***\n",
            file_name(this_object()), sizeof(archive));
          
}
