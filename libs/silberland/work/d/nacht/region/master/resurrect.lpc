/* reloader object.
 * Andere Objekte koennen in ihrem remove() diesem Objekt mitteilen
 * dass sie neu geladen werden moechten (und ggf. den Move in das 
 * alte Environment anfordern). Es wird mit file_names gearbeitet,
 * keine Objektverweise ueber den call_out.
 * __________________________________________(i) Anatol@Silberland (2012) */

#pragma strict_types

#include <properties.h>
#include <ansi.h>
#include <wizlevels.h>
#include "../defines.h"


varargs void
create()
{
    if (is_clone(this_object()))
        destruct(this_object());
}

varargs public void 
Resurrect(int and_move)
{
    string fn;
    int blue;
    fn=file_name(previous_object());
    if (sizeof(explode(fn,"#"))>1)
        fn=explode(fn,"#")[0];
    else
        blue=1;

    if ((find_call_out("do_resurrect")==-1) ||
        (!sizeof(filter_array(call_out_info(),lambda( ({'x, 'to, 'fnpo}), 
            ({#'& , 
                ({#'== , ({#'[ , 'x , 0 }), 'to }),
                ({#'== , ({#'[ , 'x , 1 }), "do_resurrect" }),
                ({#'== , ({#'[ , 'x , 2 }), 'fnpo })
            })), this_object(), file_name(previous_object())))))
        call_out("do_resurrect",0,file_name(previous_object()),blue,
            (and_move&&(environment(previous_object()))
                ?file_name(environment(previous_object()))
                :0));
}


varargs nosave void
do_resurrect(string fn, int blue, string env)
{
    object ob;
    if ((previous_object()==this_object()) && 
         (!catch(call_other(fn,"???"))) &&
         ((!catch(ob=(blue
                ?find_object(fn)
                :clone_object(fn)
            ))) && (objectp(ob)) & (stringp(env))))
            catch(ob->move(env,M_NOCHECK|M_SILENT));
            
}

