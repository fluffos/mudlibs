/* Ein _bisschen_ vorsichtig sind wir schon, wer weiss, was kaputt geht,
 * wenn irgendwo ein falscher Typ in ein Mapping geraet...  */

nomask nosave int insecure() {
  return ((!this_player()) || (this_player()!=this_interactive()) 
      || ((getuid(this_player())!="anatol") &&
                           (!IS_ARCH(this_player())) )) ;
}

public void Save() {
  return (void) save_object(SAVEFILE);
}

/* Zuerst die Supportfunktion: */

nosave int existsPlanet(string planet) {
  if ((!stringp(planet))||(!planet)) return 0;
  return (member(planets,planet)?1:0);
}

/* Die noetigen Queries fuer die einzelnen Eigenschaften, was weiss ich,   */
/* wozu das die Leute brauchen... man muss es halt zur Verfuegung stellen. */

public int queryPlanetGender(string planet) {
  if ((!stringp(planet))||(!planet)) return 0;
  if (!existsPlanet(planet)) return 0;
  return (planets[planet,PL_GENDER]);
}

public int queryPlanetOrbitPeriod(string planet) {
  if ((!stringp(planet))||(!planet)) return 0;
  if (!existsPlanet(planet)) return 0;
  return (planets[planet,PL_ORBIT_PERIOD]);
}

public int queryPlanetVisibility(string planet) {
  if ((!stringp(planet))||(!planet)) return 0;
  if (!existsPlanet(planet)) return 0;
  return (planets[planet,PL_VISIBLE]);
}
        
public int queryPlanetOrbitOffset(string planet) {
  if ((!stringp(planet))||(!planet)) return 0;
  if (!existsPlanet(planet)) return 0;
  return (planets[planet,PL_ORBIT_OFFSET]);
}

public string queryPlanetDescription(string planet) {
  if ((!stringp(planet))||(!planet)) return 0;
  if (!existsPlanet(planet)) return 0;
  return (planets[planet,PL_DESCRIPTION]);
}

public string queryPlanetInfo(string planet) {
  if ((!stringp(planet))||(!planet)) return 0;
  if (!existsPlanet(planet)) return 0;
  return (planets[planet,PL_INFO]);
}

/* Das Setzen von Planeteneigenschaften muss auch von Ausserhalb moeglich  */
/* sein, aber nicht fuer jeden Magier, da koennte ja sonst jeder kommen... */

public int setPlanetOrbitPeriod(string planet, int orbitperiod) {  
  if (insecure()) return 0;
  if ((!planet) || (!stringp(planet)) || 
      (!member(planets, (planet=lowerstring(planet)))) ||
      ((!intp(orbitperiod))) || (!orbitperiod)) return 0;
  planets[planet,PL_ORBIT_PERIOD]=orbitperiod;
  if (planets[planet,PL_VISIBLE]>orbitperiod)
    planets[planet,PL_VISIBLE]=orbitperiod;
  if (planets[planet,PL_ORBIT_OFFSET]>orbitperiod)
    planets[planet,PL_ORBIT_OFFSET]=
      planets[planet,PL_ORBIT_OFFSET]%orbitperiod;
  Save();
  return 1;
}

public int setPlanetOrbitOffset(string planet, int orbitoffset) {  
  if (insecure()) return 0;
  if ((!planet) || (!stringp(planet)) || 
      (!member(planets, (planet=lowerstring(planet)))) ||
      (!intp(orbitoffset))) return 0;
  planets[planet,PL_ORBIT_OFFSET]=
     (orbitoffset%planets[planet,PL_ORBIT_PERIOD]);
  Save();
  return 1;
}

public int setPlanetGender(string planet, int gender) {  
  if (insecure()) return 0;
  if ((!planet) || (!stringp(planet)) || 
      (!member(planets, (planet=lowerstring(planet)))) ||
      (!intp(gender))) return 0;
  planets[planet,PL_GENDER]=(gender==1?1:2);
  Save();
  return 1;
}

public int setPlanetVisibility(string planet, int vis) {  
  if (insecure()) return 0;
  if ((!planet) || (!stringp(planet)) || 
      (!member(planets, (planet=lowerstring(planet)))) ||
      (!intp(vis))) return 0;
  if (vis>planets[planet,PL_ORBIT_PERIOD]) 
    vis=planets[planet,PL_ORBIT_PERIOD];
  planets[planet,PL_VISIBLE]=vis;
  Save();
  return 1;
}

public int setPlanetDescription(string planet, string description) {
  if (insecure()) return 0;
  if ((!planet) || (!stringp(planet)) || 
      (!member(planets, (planet=lowerstring(planet)))) ||
      (!stringp(description))) return 0;
  planets[planet,PL_DESCRIPTION]=description;
  Save();
  return 1;
}    

public int setPlanetInfo(string planet, string info) {
  if (insecure()) return 0;
  if ((!planet) || (!stringp(planet)) || 
      (!member(planets, (planet=lowerstring(planet)))) ||
      (!stringp(info))) return 0;
  planets[planet,PL_INFO]=info;
  Save();
  return 1;
}    

/* Der ganze Kram macht nur Sinn, wenn man dem Himmel einfach einen Planeten
 * hinzufuegen oder wegnehmen kann. Hier sind die entsprechenden Funktionen */

public varargs int AddPlanet(string planet, int gender, int orbit, int offset,
    int sicht, string desc, string info ) {
  if ((!this_player()) || (!stringp(planet)) || (!planet) || (insecure()) ||
      (member(planets,(planet=lowerstring(planet)))))
    return 0;
  planets+=([planet:
      (((gender>=0)&&(gender<3))?gender:MALE);
      ((orbit)&&intp(orbit)?orbit:100);
       (intp(offset)?offset:0);((sicht)&&intp(sicht)?sicht:100);
       (((stringp(desc))&&(desc))?desc:capitalize(planet)+" ist ein Planet.");
      (((stringp(info))&&(info))?info:"Nichts besonderes zu >>"+
       capitalize(planet)+"<<.")]);
  Save();
  return 1;
}

public int RemovePlanet(string planet) {
  if ((!this_player()) || (!stringp(planet)) || (insecure()) || (!planet) ||
      (!member(planets,(planet=lowerstring(planet)))))
    return 0;
  planets-=([planet]);
  Save();
  return 1;
}

/* Dito auch fuer die Sternbilder! */

public int AddStar(string star, string desc) {
  if ((!this_player()) || (!stringp(star)) || (!star) || 
      (!stringp(desc)) || (!desc) || (insecure()) ||
      (member(stars,(star=lowerstring(star)))))
    return 0;
  stars+=([star:desc]);
  Save();
  return 1;
}

public int RemoveStar(string star) {
  if ((!this_player()) || (!stringp(star)) || (insecure()) || (!star) ||
      (!member(stars,(star=lowerstring(star)))))
    return 0;
  stars-=([star]);
  Save();
  return 1;
}

/* Ein paar kleine Hilfsfunktionen... */

public string * getPlanetList() {
  return (m_indices(planets));
}

nosave string caps_me(string in) {return capitalize((in?in:""));}

nosave string wordList(string * list) {
  string result;
  switch (sizeof(list)) {
    case 0: return 0; break;
    case 1: return capitalize(list[0]);break;
    default: return implode(map_array(list[0..<2],"caps_me",this_object()),", ")
                    +" und "+capitalize(list[<1]);
  }
  return "";
}

varargs nosave int isVisible(string planet, int when) {
  if ( (!stringp(planet)) || (!planet) ||
       (!member(planets,(planet=lowerstring(planet)))) ||
      ( ( ((when?when:time())+planets[planet,PL_ORBIT_OFFSET]) 
        % planets[planet,PL_ORBIT_PERIOD])>planets[planet,PL_VISIBLE]))
    return 0;
  else return 1;
}

nosave string * getVisiblePlanets() {
   return filter_array(sort_array(m_indices(planets),#'<),"isVisible");
}

nosave string getStarDetail(string det) {
  string res;
  if (!det) return 0;
  if (res=stars[det])
    if (res[0..2]=="@@@")
      return getStarDetail(res[3..]);
  return res;
}

nosave string getSkymiscDetail(string det) {
  string res;
  if (!det) return 0;
  if (res=skymisc[det])
    if (res[0..2]=="@@@")
      return getSkymiscDetail(res[3..]);
  return res;
}

/* Dies wird aufgerufen, wenn "planet" oder "planeten" untersucht werden. */

nosave string detailPlaneten() {
  string * pl;
  pl=getVisiblePlanets();
  if (QNACHT(this_player(),KNOWLEDGE_SKY))
    switch (sizeof(pl)) {
      case 0:
        return "Komisch, Du kannst keinen einzigen Planeten entdecken...\n";
        break;
      case 1: 
        return "Im Moment kannst Du nur "+capitalize(pl[0])+" ausmachen.\n";
        break;
      default:
        return break_string("Du erkennst "+wordList(pl)+
            " am Sternenhimmel.",77);
        break;
    }
  else return break_string(
      "Du bist bezueglich Planeten nicht gerade sehr gelehrt und "
      "kannst nichts weiter erkennen und benennen. Nichtsdestotrotz "
      "laesst Du Dich gerne vom Glanz des Firmaments verzaubern."
      ,77);
}
    

/* Diese Funktionen werden eigentlich nur von Sternenwarten oder 
 * Tools benoetigt, man sieht dem Stern nicht an, wann er aufgeht ;) */

varargs public int secondsToVisibility(string planet, int when) {
  if ( (!stringp(planet)) || (!planet) ||
       (!member(planets,(planet=lowerstring(planet)))) ||
       (isVisible(planet))) return 0;
  else return (planets[planet,PL_ORBIT_PERIOD]- 
                 (((when?when:time())+planets[planet,PL_ORBIT_OFFSET])
                     %planets[planet,PL_ORBIT_PERIOD]));
}

varargs public int secondsToInvisibility(string planet, int when) {
  if ( (!stringp(planet)) || (!planet) ||
       (!member(planets,(planet=lowerstring(planet)))) ||
       (!isVisible(planet))) return 0;
  else return (planets[planet,PL_VISIBLE]-
             (((when?when:time())+planets[planet,PL_ORBIT_OFFSET])
                     %planets[planet,PL_ORBIT_PERIOD]));
}

/* So, jetzt noch der Krempel fuer die Kontrolle und das Debuggen! */

public string ShowRooms() {
  string * entry;
  string result;

  if (!entry=sort_array(m_indices(rooms),#'>))
    return sprintf("Seit %s kein Raum angemeldet.\n",dtime(createtime));
  result=sprintf("Seit %s griffen %d Raeume auf den Sky zu:\n",
      dtime(createtime), sizeof(entry));
  for (;sizeof(entry);entry=entry[1..])
    result+=sprintf("%s:%50s\n",dtime(rooms[entry[0]])[5..],entry[0]);
  return result;
}

public string ShowSkymiscs() {
  string * result;

  if ((!this_player()) || (!IS_WIZARD(this_player()))) return 0;
  if(result=sort_array(m_indices(skymisc),#'>))
    return break_string(sprintf(
      "Folgende Details hat der Sternenhimmel per Default:\n%s\n",
      implode(result,", ")),70,"    ",1)[4..];
  else return "Keine Details am Sternenhimmel... :(\n";
}

public string ShowSkymisc(string star) {
  if ( (!star) || (!this_player()) || (!IS_WIZARD(this_player()))) return 0;
  if (member(skymisc,star))
    return sprintf("Sternenhimmeldetail '%s':\n%s",
        star,break_string(getSkymiscDetail(star),77));
  else return "Kein solches Detail am Sternenhimmel vorgesehen.\n";
}

public string ShowStars() {
  string * result;

  if ((!this_player()) || (!IS_WIZARD(this_player()))) return 0;
  if (result=sort_array(m_indices(stars),#'>))
    return break_string(sprintf(
      "Folgende Sterne oder Sternbilder sind beschrieben:\n%s\n",
      implode(result,", ")),70,"    ",1)[4..];
  else return "Keine Sterne *schnief*... :(\n";
}

public string ShowStar(string star) {
  if ( (!star) || (!this_player()) || (!IS_WIZARD(this_player()))) return 0;
  if (member(stars,star))
    return sprintf("Stern oder Sternbild '%s':\n%s",
        star,break_string(getStarDetail(star),77));
  else return "Kein Stern oder Sternbild mit dieser Bezeichnung vorhanden.\n";
}

public string ShowPlanets() {
  string result;
  string *planetlist;
  int i;

  if ((!this_player()) || (!IS_WIZARD(this_player()))) return 0;
  result="        Planet    Umlaufzeit    momentane Pos.   Sichtbarkeit  "+
         " %  vis\n";
  for (i=sizeof(planetlist=sort_array(m_indices(planets),#'<));i;i--) {
    result+=sprintf("%14s  %s   %s   %s  %2d %s\n",
      capitalize(planetlist[i-1]),
      time2string("%3dd %02h:%02m:%02s",
         planets[planetlist[i-1],PL_ORBIT_PERIOD]),
      time2string("%3dd %02h:%02m:%02s",
         time()%planets[planetlist[i-1],PL_ORBIT_PERIOD]),
      time2string("%3dd %02h:%02m:%02s",
         planets[planetlist[i-1],PL_VISIBLE]),
      (planets[planetlist[i-1],PL_VISIBLE])/
         (planets[planetlist[i-1],PL_ORBIT_PERIOD]/100),
      (isVisible(planetlist[i-1])?" ja ":"nein"));
  }
  return result;
}

public string ShowPlanet(string planet) {
  string result;

  if ((!this_player()) || (!IS_WIZARD(this_player()))) return 0;
  if ((!stringp(planet))||(!planet) ||
     (!member(planets, (planet=lowerstring(planet))))) 
       return "Planet nicht vorhanden.\n";
  result="Planeteninformation `"+capitalize(planet)+"` ("+
    (planets[planet,PL_GENDER]==1?"maennlich":"weiblich")+", "+
     (isVisible(planet)?"":"nicht ")+"sichtbar)\n"+
         "=================================================================\n";
  result+=sprintf("Umlaufzeit  : %s\n",
                        time2string("%3d Tage  %2h Std  %2m Min  %2s Sek",
                        planets[planet,PL_ORBIT_PERIOD]));
  result+=sprintf("Derzeit bei : %s (%2d%%)\n",
                        time2string("%3d Tage  %2h Std  %2m Min  %2s Sek",
                        time()%planets[planet,PL_ORBIT_PERIOD]),
                        ((time()%planets[planet,PL_ORBIT_PERIOD])*100)/
                           planets[planet,PL_ORBIT_PERIOD]);
  result+=sprintf("Umlaufoffset: %s\n",
                        time2string("%3d Tage  %2h Std  %2m Min  %2s Sek",
                        planets[planet,PL_ORBIT_OFFSET]));
  result+=sprintf("Sichtbarkeit: %s (%2d%%)\n",
                        time2string("%3d Tage  %2h Std  %2m Min  %2s Sek",
                        planets[planet,PL_VISIBLE]),
                        (planets[planet,PL_VISIBLE])/
                          (planets[planet,PL_ORBIT_PERIOD]/100));
  if (isVisible(planet))
    result+="Verschwinden: "+
      time2string("%3d Tage  %2h Std  %2m Min  %2s Sek",
       secondsToInvisibility(planet));
  else 
    result+="Auftauchen  : "+
     time2string("%3d Tage  %2h Std  %2m Min  %2s Sek",
       secondsToVisibility(planet));
  result+="\nAussehen:\n"+break_string(planets[planet,PL_DESCRIPTION],77,0,1)+
          "Lexikon:\n"+break_string(planets[planet,PL_INFO],77,0,1);
  return result;
}

/* ***************************************************************** * 
 *                                                                   * 
 * Von den Raeumen werden eigentlich nur diese Funktionen aufgerufen * 
 *                                                                   * 
 * ***************************************************************** */


/* Zunaechst muss sich der Raum mit den Details, die der Skymaster
 * zur Verfuegung stellt, (re)initialisieren koennen. Er braucht dazu 
 * eine Liste aller Details. Da der Skymaster eine Liste der betreuten
 * Raeume fuehrt, wird auch eine Cancel-Funktion benoetigt, die ein Raum
 * in remove() aufrufen sollte... */

public void CancelSky() {
  if (previous_object())
    rooms-=([file_name(previous_object())]);
}

public string * QuerySkyDetails() {
  if ((previous_object()) && (previous_object()->QueryProp(P_ENVIRONMENT))
      && (previous_object()->id("Raum")))
    rooms+=([file_name(previous_object()):time()]);
  return m_indices(planets)+m_indices(stars)+
    m_indices(skymisc)+({"planet","planeten"});
}

/* Wenn ein Spieler ein Detail untersucht, das an den Skymaster "gebunden"
 * ist, kommt er in dieser Funktion heraus. Zunaechst wird nachgesehen, ob
 * ein Planet "matcht", dann, ob es ein Sternbild gibt und zuletzt, ob es 
 * ein normales Himmelsdetail ist. Diese Reihenfolge ermoeglicht z.B., dass
 * die Beschreibung von Rilghad vom Kenntnisstand des Spielers abhaengig ist.
 * Ein wenig kniffelig ist die Geschichte mit den "Links": Faengt die 
 * Beschreibung eines Sternbilds oder Misc-Details mit @@@ an, ist es nur
 * ein Zeiger auf einen anderen Key, hinter dem sich dann (hoffentlich) der
 * wahre Inhalt verbirgt.  */

public string QuerySkyDetail(string det) {
  if ((!this_player())||(!det)||(det=="")) return 0; 
  if ((det=="planet")||(det=="planeten"))
    return detailPlaneten();
  if (QNACHT(this_player(),KNOWLEDGE_SKY))
    if ((member(planets,det)) && (isVisible(det)))
      return break_string(queryPlanetDescription(det),77);
    else if (member(stars,det))
      return break_string(getStarDetail(det),77);
  if (member(skymisc,det))
    return break_string(getSkymiscDetail(det),77); 
  else return 0; /* Hups */
}

