/* Firmament-Handling fuer standardraeume in /d/nacht
 * _____________________________________(i) Anatol@Silberland (1998-2012) */

#include "../defines.h"

#define SAVEFILE SAVEDIR "sky"

#define PL_GENDER 0
#define PL_ORBIT_PERIOD 1
#define PL_ORBIT_OFFSET 2
#define PL_VISIBLE 3
#define PL_DESCRIPTION 4
#define PL_INFO 5

/* Keinen Shadow bitte */

nomask int query_prevent_shadow() { return 1; }

/* Das Planetenmapping enthaelt Eintraege der Art "planet:...", wobei die
 * Values den PL_*-Defines entsprechen. Zugriff von aussen gibts natuerlich
 * nicht direkt, dazu dienen die Queryfunktionen... */

mapping planets;

/* Im Sternenmapping ist lediglich die Beschreibung enthalten */

mapping stars;

/* Und hier haben wir noch die normalen Details, die nicht ueber Tools
 * modifiziert werden koennen bzw. muessen. Sie sind nicht in den Raeumen,
 * sondern hier definiert - ist zwar je Detailaufruf ein call_other mehr,
 * spart dafuer aber Speicher in den Objekten.         */

nosave mapping skymisc;

/* Raeume, die sich angemeldet haben, werden hier "aufbewahrt" */

nosave mapping rooms;

/* create() besitzt keine Superklasse und sorgt eigentlich nur dafuer,
 * dass auch bei verlorengegangenem Savefile etwas am Himmel zu sehen ist.  
 * Ausserdem merkt der Skymaster sich in createtime sein Ladedatum */

nosave int createtime;

public void create() {
  if (createtime) return;
  seteuid(getuid(this_object()));
