
#include <wizlevels.h>

#define CARETAKER (["anatol"])

nomask public int access_rights(string euid, string file, int readflag, int def, string fun) {

  string *path;

  path=explode(file,"/");
  
  /* Lesen duerfen prinzipiell alle Magier mit [M] oder aufwaerts.
   * (Drunter fraegt der Master derzeit auch gar nicht erst nach.)  */

  if (readflag)
     return IS_DOMAINMEMBER(euid);

  /* Die Betreuung des Regionshauptverzeichnisses obliegt 
   * allein den Regionsmagiern. */

  if (sizeof(path) < 2) 
    return 0;

  /* In den Verzeichnissen, die nicht direkt einem Mitarbeiter 
   * zugeordnet sind, duerfen die CARETAKER schreiben. */

  switch (path[0]) {
    case "std":
    case "sys":
    case "doc":
    case "region":
      return  member(CARETAKER,euid);
      break;
    default:   /* Ansonsten: Der Master wird's schon wissen. */
      return def;
  }
  return 0;  /* never happens */
}
