/* 
 * Spieler moegen das vielleicht anders sehen (hehe), aber das wirklich 
 * Schlimme an den Dunklen ist die Differenzierung beim Nominativ. Deshalb
 * muss hierfuer ein Standard-Dunkler herhalten...
 * (c) 1/97 Anatol                                                  
 */

#pragma strong_types
#include <properties.h>
#include "../defines.h"
#include <combat.h>
inherit NACHT "std/npc";

void create() {
  if (!is_clone(this_object())) return;
  ::create();
  create_default_npc(1);
  SetProp(P_SHORT,"Ein Dunkler");
  SetProp(P_LONG,break_string("Mehr ein Schemen als ein Lebewesen, "
    "besteht ein Dunkler hauptsaechlich aus Intelligenz und einer Dir "
    "fremden Magie. Nichtsdestotrotz machst Du in dem schwarzen Schemen "
    "ein mit triefenden Tentakeln bestuecktes Maul, insekten- artige Beine "
    "und einen stachelbewehrten und bestimmt giftigen Schwanz aus.",77));
  SetProp(P_GENDER,MALE);
  SetProp(P_NAME,({"Dunkle","Dunklen","Dunklen","Dunklen"}));
  AddId(({"DUNKLER","dunkler","dunklen","dunkle"}));
  SetProp(P_RACE,"Dunkler");
  SetProp(P_SIZE,70+random(300));
  SetProp(P_INFO,"Verschwinde lieber.\n");
  SetProp(P_HANDS,({" mit stachelbewehrtem Schwanz",30,DT_RIP}));
  SetProp(P_ALIGN,0); /* Niemand ist boese, nur weil er Dich nicht mag */
  SetProp(P_RESISTANCE,({DT_MAGIC, DT_ACID, DT_COLD, DT_POISON}));
  SetProp(P_VULNERABILITY,({DT_FIRE, DT_FIRE}));
  SetProp(P_MMSGIN,"gleitet lautlos wie aus dem Nichts herein");
  SetProp(P_MSGIN,"gleitet lautlos herein");
  SetProp(P_MSGOUT,"gleitet lautlos");
  SetProp(P_MMSGOUT,"gleitet lautlos davon");
  SetProp(P_NOCORPSE,1);
  SetProp(P_DIE_MSG," zerfaellt zu Blut und Schleim.\n");
}

 /* Der Name eines Dunklen unterscheidet sich im Nominativ nach 
    bestimmten (der Dunkle) und unbestimmten (ein Dunkler) Artikel.  */

varargs string name(int casus, int demon) {
  return ::name(casus,demon)+((((casus==0)||(casus==99))&&(!demon))?"r":"");
}

