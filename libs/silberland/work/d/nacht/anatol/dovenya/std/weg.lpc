#pragma strict_types

#include "../defines.h"
#include <combat.h>

inherit DOVENYA "std/room";


void create() {
  ::create();

  SetProp(P_INDOORS,0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:22,
                           ENV_TERRAIN:TT_TOWN,
                           ])); 
  SetProp(P_INT_SHORT,"In Dovenya");
  SetProp(P_INT_LONG,
    "Ts, da hat einer die Weg-P_INT_LONG nicht gesetzt...");
}
