 * _____________________________________(i) Anatol@Silberland (1998-2012) */

#include "../defines.h"

inherit NACHT "std/room";

void create() {
  ::create();

    /* Default fuer Dovenya ist: Keine Teleports hin, keine Teleports 
     * raus. Falls irgendein Magier Teleporte oder sonstige Abkuerzungen 
     * von oder nach Dovenya einrichten will, hat er das mit mir 
     * abzusprechen. :) */
   
  SetProp(P_NO_TPORT,NO_TPORT);
 
    /* Solange es kein differenzierteren Lichtlevel gibt, ist vorerst
     * ueberall Lichtlevel 1 gegeben - fuer Dunkelelfen wohl zu hell,
     * aber dass soll deren Problem bleiben. */

  SetProp(P_LIGHT,1);

  SetFailMessages( ({
           "Sowas siehst Du da nicht!\n",
           "Das Detail huepft geschickt aus Deiner Reichweite.\n",
           "Das Detail ignoriert Dich oder diesen Befehl.\n",
           "Die freiwillige Selbstkontrolle loeschte dieses Detail.\n",
           "Das sanfte Saeuseln des Nachtwinds hat Dir die Sinne verwirrt.\n",
           "Da war ... nein, da ist doch nichts.\n",
           "Dein Untersuche-Versuch ist gescheitert.\n",
           "Dein Koerper gehorcht Dir nicht!\nAergerlich.\n",
           "Der Gamedriver teilt Dir mit: Dein Blutdruck ist zu hoch!\n",
	   "Mmmh, eben hast Du es noch gesehen, glaubst Du.\n"
        }));

}


nomask nosave int
roomNotYetImplemented()
{
   if (!this_player()) 
       return 0;
   notify_fail("Der Eingang ist leider verrammelt.\n");
   return 0;
}
