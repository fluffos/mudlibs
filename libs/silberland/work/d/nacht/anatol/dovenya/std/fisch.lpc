#pragma strict_types

#include "../../defines.h"
#include <properties.h>
#include <language.h>
#include <moving.h>
#include <combat.h>

inherit "/std/npc";

public void 
create() 
{
    ::create(); 
    SetProp(P_LONG, "Ein nicht naeher bekannter Fisch.");
    SetProp(P_SHORT, "Ein Fisch");
    SetProp(P_NAME, "Fisch");
    SetProp(P_GENDER, MALE);
    AddId(({"fisch","\a\n\a\tol_fisch"}));
    create_default_npc( 1 );

    SetProp(P_MSGIN,"schwimmt zwischen den Pflanzen hervor");
    SetProp(P_MMSGIN,"schwimmt zwischen den Pflanzen hervor");
    SetProp(P_MSGOUT,"verschwindet zwischen den Pfanzen");
    SetProp(P_MMSGOUT,"verschwindet zwischen den Pfanzen");
    
    SetProp(P_BODY, 0);
    SetProp(P_HANDS, ({" mit erschrockenem Geblubber",0,DT_WATER}));
    SetProp(P_RACE, "Fisch");
    SetProp(P_XP,0);
    SetProp(P_NOATTACK,"schwimmt geschickt aus Deiner Reichweite.");
    SetProp(P_NOCORPSE,1);
    SetProp(P_DIE_MSG, " blubbert als Luftblase in den Himmel der Fische.\n");
    SetProp (P_REJECT,
      ({ REJECT_DROP, 
        "Ungluecklicherweise hat ein Fisch nun gerade keine Haende...\n" }) );

}


// Entscheidung, Objekt vor Ort zu zerstoeren, um kein evtl. doch 
// vorhandenes Inventar spielerunzugaenglich abzulegen.

public void 
SchwimmDavon() 
{
    environment()->Message(break_string(sprintf(
     "%s verschwindet irgendwo in den Pflanzen.\n",Name(WER)),77),
        MSGFLAG_VISUAL,([MSGFLAG_EXCLUDE:({this_object()})]));
    remove();
}

