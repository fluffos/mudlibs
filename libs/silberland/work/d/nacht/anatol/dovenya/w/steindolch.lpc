/* Ein alter, kaputter, Steindolch...
 * _____________________________________(i) Anatol@Silberland (1998-2012) */

#pragma strict_types

#include "../defines.h"
#include <combat.h>

inherit "/std/weapon";

public void 
create() 
{
    if (!is_clone(this_object())) 
        return;
    ::create();

    SetProp(P_NAME,"Steindolch");
    AddId(({"dolch","steindolch","\a\n\a\tol_steindolch"}));
    SetProp(P_SHORT,"Ein alter Steindolch");
    SetProp(P_LONG,
        "Sonderlich scharf sind diese Steindolche ja nicht, aber besser "
        "den Dolch in der Hand als das Schwert in der Schmiede, nicht wahr? "
        "Der Steindolch hat eine gerade etwa eine Spanne lange Klinge, "
        "die ausserdem durch ihre etwas ungewoehnliche Breite besticht. "
        "Das Heft ist aus dem selben Stueck Stein wie die Klinge, also echte "
        "all-in-one Arbeit.");
    AddDetail("klinge",
        "Die Klinge ist etwa eine Spanne lang, schartig und nicht sonderlich "
        "scharf, aber spitz. Ihre Breite wird wohl durch das Material - "
        "Stein - begruendet.");
    AddDetail("heft",
        "Das Heft ist eigentlich nur rund, passt sich Deiner Hand irgendwie "
        "ueberhaupt nicht an. Schlichte Handwerkskunst irgendwie. Aber "
        "immerhin halbwegs ausbalanciert.");
    SetProp(P_WC,65+random(3));
    SetProp(P_VALUE,random(200)+200);
    SetProp(P_NR_HANDS,1);
    SetProp(P_DAMAGED,11);
    SetProp(P_WEAPON_TYPE,WT_KNIFE);
    SetProp(P_MATERIAL,({MAT_STONE}));
    SetProp(P_WEIGHT,800+random(20));
    SetProp(P_GENDER,MALE);
}
