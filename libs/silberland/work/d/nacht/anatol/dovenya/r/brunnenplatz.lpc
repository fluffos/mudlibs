/* Dovenya, Brunnenplatz
 * _____________________________________(i) Anatol@Silberland (1998-2012) */


#pragma strict_types

#include "../defines.h"

inherit DOVENYA "std/room";


public void 
create() 
{
    ::create();

    SetProp(P_INDOORS,0);
    
    SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:23,
                            ENV_TERRAIN:TT_TOWN,
                            ])); 

    SetProp(P_INT_SHORT,"Dovenya, Brunnenplatz");
    SetProp(P_INT_LONG,
        "Den Brunnenplatz ziert, oh Wunder, ein kleiner Brunnen. Ansonsten "
        "ist noch nicht viel los hier. Im Nordosten hat sich offenbar der "
        "Dorfaelteste niedergelassen, in suedwestlicher Richtung kann man "
        "offenbar zum Dorfschreiber, der auch Postdienste anbietet. Im "
        "Norden habituiert ein Heiler. Die "
        "Tueren im Westen "
        "sind verrammelt - die Bewohner ziehen wohl erst noch ein."
        );
    
    SetProp(P_GEMA,({0,5,0}));
    
    AddDetail(({"xxx"}),"");

    seteuid(getuid(this_object()));
    Sky();
  
    AddExit("osten",
        ([ EX_DEST: "./dorfweg_nw",
           EX_PLMSG: "Du verlaesst den Brunnenplatz und folgst dem Dorfweg.\n",
           EX_MSG: "auf dem Dorfweg nach Osten"]));
    AddExit("westen",
        ([ EX_DEST: "irgendwohin", 
           EX_FUNC: "roomNotYetImplemented" ]));
    AddExit("norden",
        ([ EX_DEST: "./heiler", 
           EX_PLMSG: "Du betrittst die Raeumlichkeiten der Genesung.\n",
           EX_MSG: "nach Norden zum Dorfheiler"]));
    AddExit("nordosten",
        ([ EX_DEST: "./senat", 
           EX_PLMSG: "Du betrittst das Domizil des Aeltesten.\n",
           EX_MSG: "nach Nordosten in das Domizil des Aeltesten"]));
    AddExit("suedwesten",
        ([ EX_DEST: "./post", 
           EX_PLMSG: "Du betrittst die Stube des Schreibers.\n",
           EX_MSG: "nach Suedwesten in die Stube des Schreibers"]));
    AddExit("suedosten",
        ([ EX_DEST: "./campanile_eg",
           EX_PLMSG: "Du trittst in die Arkaden des Campanile.\n",
           EX_MSG: "in das Campanile nach Suedosten"]));
    
  
    SetProp(P_HIDE_EXITS,({"norden","westen","nordosten","suedwesten"}));

}
