/* Dovenya, Hauptwache
 * _____________________________________(i) Anatol@Silberland (1998-2012) */


#pragma strict_types

#include "../defines.h"

inherit DOVENYA "std/room";


public void 
create() 
{
    ::create();

    SetProp(P_INDOORS,1);
    
    SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:23,
                            ENV_TERRAIN:TT_HOUSE,
                            ])); 

    SetProp(P_INT_SHORT,"Dovenya, Wache");
    SetProp(P_INT_LONG,
        "Die Hauptwa... nein, es gibt nur eine. Die Nachtwache hat ihr "
        "kleines Haeuschen ein wenig ausserhalb. Vor dem Hintergrund, "
        "dass man im Ernstfall (schon laenger nicht mehr eingetreten) "
        "das Dorf schuetzen muss. Laecherlich."
        );
    
    SetProp(P_GEMA,({6,5,0}));
    
    AddDetail(({"xxx"}),"");

    seteuid(getuid(this_object()));
  
    AddExit("westen",
        ([ EX_DEST: "./klippenweg_2", 
           EX_PLMSG: "Du verlaesst die Wache und gehst auf den Klippenweg.\n",
           EX_MSG: "raus auf den Klippenweg"]));
 
    SetProp(P_HIDE_EXITS,({""}));

}
