#pragma strict_types
#include "../defines.h"
#define MAX_ZWINDCHEN  4

inherit DOVENYA "std/garten";

string * healed;
string * picker;
int zwindchen;
int flag;


public void
init()
{
    ::init();
    if (this_player())
        picker-=({file_name(this_player())});
}

public void 
create() 
{
    ::create();
    healed=({});
    picker=({});
    zwindchen=MAX_ZWINDCHEN;
    flag=0;

    SetProp(P_INT_SHORT,"Dovenya, Gaerten");
    SetProp(P_INT_LONG,
        "Du bist im entlegensten Winkel der Gaerten und von fast allen Seiten "
        "entweder von Baeumen, von Wasser (im Norden befindet sich der kleine "
        "See) oder von Fels umgeben. Wider Erwarten haengt etwas verdeckt "
        "dann doch ein kleines Hexenlicht, da Lhjana, die sich gern in diesem "
        "Teil der Gaerten aufhaelt, auch Nicht-Nachtelfen eine Chance beim "
        "Kartenspiel lassen moechte.");
    Sky();
    SetProp(P_GEMA,({0,-1}));

    AddDetail("erwarten",
        "Eigentlich haettest Du nicht geglaubt, dass in den Gaerten "
        "irgendjemand ein Hexenlicht aufhaengt. Aber Ausnahmen...");
    AddDetail("hexenlicht",
        "Genau erkennen kannst Du nicht, was in dem kleinen Kasten nun "
        "wirklich ist, aber es strahlt ein daemmriges, leicht gruenes, "
        "Licht ab. Hell genug aber, um sich eines gewissen Kartenspiels "
        "anzunehmen...");
    AddDetail("kasten",
        "Der Kasten haengt sehr hoch und strahlt daemmrig-"
        "geheimnisvolles Licht nach unten.");
    AddDetail("chance","Ist Lhjana nicht nett?");
    AddDetail("lhjana","HUCH, warum ist Lhjana nicht hier?!");
    AddDetail("nicht-nachtelfen",
        "Solche Leute soll es auch geben.");
    AddDetail(({"kartenspiel","set-spiel","set!-spiel","spiel","set"}),
        "Frag' Lhjana! :)");
    AddDetail(({"ausnahme","ausnahmen"}),
        "... bestaetigen offenbar die Regel.");
    AddDetail("regel","Keine Regel ohne Ausnahmen.");

    AddDetail("winkel",
        "Irgendwie ist das hier ein recht geschuetztes Plaetzchen, man kann "
        "vielleicht vom See aus sehen, wer oder was hier los ist, doch damit "
        "hat es sich auch schon...");
    AddDetail("plaetzchen",
        "Ideal eigentlich, um ein wenig zu paudern oder Karten zu spielen.");
    AddDetail("karten","Frag doch mal Lhjana, sie weiss dazu "
        "vielleicht etwas!");
    AddDetail(({"baeume","baum","buesche","busch"}),
        "Die Baeume und Buesche grenzen die Gaerten nach Sueden hin "
        "ab. Dahinter wird es vermutlich sehr steil und sehr weit nach unten "
        "gehen, daher ist es eigentlich nicht weiter wichtig, dass es keine "
        "Moeglichkeit gibt, sich durch diese natuerliche Mauer zu quetschen "
        "oder durchzuschlagen. Auch vor der Felswand und in noerdlicher "
        "Richtung stehen einige Baeume, doch nicht allzu dicht und auch "
        "nicht ganz an den See heran, so dass Du dich nach Nordosten hin "
        "in einen anderen Teil der Gaerten begeben koenntest.");
    AddDetail("moeglichkeit",
        "Du siehst keine Moeglichkeit, weiter nach Sueden vorzudringen.");
    AddDetail(({"felswand","wand","fels"}),
        "Die Felswand ist hier ziemlich glatt, an manchen Stellen sogar... "
        "abgegriffen?");
    AddDetail(({"stellen","stelle"}),
        "Diese Stellen an der Felswand glaenzen ein wenig, es sieht fast so "
        "aus, als ob hier sehr oft Leute dagegenpatschen. Aber Du kannst "
        "ansonsten nichts Besonderes erkennen...");
    AddDetail("leute","Irgendwelche Leute halt.");
    AddDetail("teil",
        "Du bist hier wohl im abgelegensten Teil Dovenyas, der "
        "Nachtelfensiedlung.");
    AddDetail(({"nachtelfensiedlung","siedlung","dovenya"}),
        "Ja, die Gaerten gehoeren zur Siedlung, was dachtest DU denn?");
    AddDetail(({"gaerten","garten","seiten"}),
        "Du befindest Dich im suedlichsten Teil der Gaerten, "
        "noerdlich von Dir ist der See, im Westen siehst Du die Felswand, die "
        "die natuerliche und ebenso unerbittliche Ost-Begrenzung Dovenyas "
        "ausmacht. Ansonsten siehst Du viel Baum um Dich herum.");
    AddDetail(({"ost-begrenzung","begrenzung"}),
        "Diese Felswand ist unerbittlich und duerfte eine Osterweiterung in "
        "den naechsten viertausend Jahren verhindern. Besser als jede Mauer.");
    AddDetail(({"jahr","jahre"}),"Das wuerde Jahre dauern - Du laesst es.");
    AddDetail(({"witze","witz","osterweiterung","mauer"}),
        "Auf schlechte Witze geht man besser nicht ein, sondern "
        "ignoriert sie.");
    AddDetail("boden",
        "Hier waechst, wie ein wenig weiter noerdlich, vor allem Gras, die "
        "vereinzelten Blumen haettest Du fast uebersehen.");
    AddDetail(({"wiese","merkmale"}),
        "Viel Gras und vereinzelte Blumen bestimmen die charakteristischen "
        "Merkmale dieser Wiese. Irgendwie sieht die Wiese wie ein graesernes "
        "Abbild des Sternenhimmels aus... ");
    AddDetail("abbild","Kleine leuchtende Punkte in einem Meer aus "
        "Dunkelheit, die Wiese erinnert wirklich an das Firmament ueber Dir!");
    AddDetail("punkte","Wenn sie oben waeren, waeren es Sterne...");
    AddDetail("gras",
        "Das Gras ist weich und scheint durch das (immerhin auch leicht "
        "gruene) Hexenlicht dann doch nicht ganz so dunkel wie die "
        "unendlichen Weiten des Sternenhimmels.");
    AddDetail("weiten", "Das wuerde entschieden zu weit fuehren.");
    AddDetail("meer","Ein Meer aus Gras.");
    AddDetail(({"blumen","blume"}),
        "Die Blumen hier gehoeren allesamt zu einer einzigen Art - es sind "
        "Wiesenzwindchen - und stehen wirklich nur vereinzelt in der Wiese.");
    AddDetail("art","Ja, es scheint sich um Wiesenzwindchen zu handeln");
    AddDetail(({"zwindchen","wiesenzwindchen"}),
        "Wiesenzwindchen sind recht kleine Blumen, welche dem gemeinen "
        "Loewenmaul recht aehnlich sehen: Gelb bis goldgelbe Blueten, die "
        "an Loewenmaeuler erinnern. Wiesenzwindchen sind jedoch zusaetzlich "
        "von leicht magischer Natur, sagt man ihnen doch nach, dass "
        "aus einer Bluete ein \"Trank fuer eine gesegnete Nacht\" gebraut "
        "werden kann. Warum die Frau, die ihrem Gatten einen solchen Trank "
        "in den Salat mengt, leichte Kleidung tragen sollte, bleibt "
        "Deiner Fantasie ueberlassen.");
    AddDetail("kleidung","Schau doch mit \"i +r\" nach, was Du bei Dir "
        "traegst.");
    AddDetail("maeuler","Die Blueten der Wiesenzwindchen sehen aus wie kleine "
        "Loewenmaeuler.");
    AddDetail("fantasie","Es ist hier irgendwie fantastisch!");
    AddDetail(({"blueten","bluete"}),
        "Die Blueten sehen aus wie die Maeuler kleiner vorwitziger Loewen.");
    AddDetail("dunkelheit","Hier ist es eigentlich nicht dunkel, oder?");
    AddDetail("nachtelfen",
        "Da dies hier eine Nachtelfensiedlung ist, koennten "
        "hier schon auch Nachtelfen herumlaufen...");
    AddDetail(({"loewenmaul","loewenmaeuler"}),
        "Es handelt sich hier um Wiesenzwindchen, das ist nicht wirklich "
        "dasselbe.");
    AddSpecialDetail(({"loewe","loewen"}),"detailLoewen");
    AddDetail("natur","Irgendwie stehst Du mitten in der Natur herum.");
    AddDetail(({"trank","trank fuer eine gesegnete nacht"}),
        "Aaaeeeh, sowas brauchst Du doch nicht!");
    AddDetail("viagra","\"Trank\", nicht \"Pille\". Pass mal besser auf.");
    AddDetail("pille", "Ja die nu grade nicht!");
    AddDetail("nacht", "Die Nacht ist lau und angenehm, das "
        "Sternenlicht scheint"
        " auf Dich herab, auch wenn es hier nicht ganz so wichtig ist.");
    AddDetail("frau","Sei froh, dass Du jetzt nicht gezwungen wirst, an einer "
        "hier eventuell anwesenden Frau herumzugrabbeln. Aber das kommt "
        "vielleicht noch, probiere es spaeter wieder...");
    AddDetail(({"gatter","gatte","gatten"}),
        ">> Gatte, der [m], von (dtsch) \"Gatter\". << Oh je. :)");
    AddDetail("salat","Du bekommst Hunger.");
    AddDetail("hunger","... grossen Hunger!");
    AddSpecialDetail("grossen hunger","detailHunger");
    AddDetail("magen","Hoerst Du ihn knurren?");

    AddCmd(({"patsche","patsch"}),"cmdPatsche");
    AddCmd(({"pfluecke","pflueck"}),"cmdPfluecke");
    AddCmd(({"ignorier","ignoriere"}),"cmdIgnoriere");
  
    seteuid(getuid(this_object()));
    SetStupids(({"nicht"}));
    AddExit("nordosten","./garten_o");
    AddExit("norden",([EX_FUNC:#'seeExitTestfunc]));
    SetProp(P_HIDE_EXITS,({"norden"}));

    AddItem( NPC "lhjana", REFRESH_DESTRUCT, 1);


}

nosave int
cmdIgnoriere(string was) 
{
    if ( (!this_player())
        || ( (was!="schlechter witz")
            && (was!="schlechten witz"))
        || (find_call_out("CA_SchlechterWitz")!=-1))
        return 0;
    call_out("CA_SchlechterWitz",3);
    return 0; // fall through, soll er ruhig seine Ignoriereliste bearbeiten...
}

public void 
CA_SchlechterWitz()
{
    if (!this_player()) return;
    this_player()->Message("(Netter Versuch...)\n");
    return;
}

nosave int  
cmdPfluecke(string was) 
{
    if (!this_player()) return 0;
    notify_fail("Was moechtest Du pfluecken?\n");
    if ((!was)||(was=="")) return 0;
    notify_fail("Das kannst Du (hier) nicht pfluecken.\n");
    if (member(({"blume","loewenmaul","wiesenzwindchen","zwindchen","blumen"}),
        was)==-1) return 0;
    if (member(picker,file_name(this_player()))==-1)
    {
        write(break_string(
            "Diese Wiesenzwindchen sind SELTEN und auf der Insel ist das "
            "Pfluecken dieser Pflanzen nur bestimmten Personen gestattet. "
            "Jemand koennte irgendwann diese Blumen wirklich brauchen, also "
            "geh' Gaensebluemchen pfluecken, aber lass die Zwindchen "
            "bitte stehen.",77));
        picker+=({file_name(this_player())});
    }
    else
    {
        write(break_string(
            "Alle Bitten und Warnungen Deiner inneren Stimme zum Trotz: "
            "Du willst so ein Wiesenzwindchen haben! Genau jetzt!",77));
        if (!zwindchen)
        {
            write(break_string(
               "Bedauerlicherweise hat ein schaebiger Egoist bereits alle "
               "Wiesenwindchen, die es sich zu pfluecken lohnen wuerde, "
               "mitgenommen. Du bekommst leider nix. Zum Glueck auch kein "
               "schlechtes Gewissen.",77));
        }
        else
        {
            zwindchen--;
            write(break_string(
                "Du pflueckst ein Wiesenzwindchen. "
                "Hoffentlich hat das niemand gesehen...",77));
            Message(break_string(
                   sprintf("Mit kaum zu verbergender Gier pflueckt %s "
                "irgendeine Blume. Verstohlen sieht %s sich um, in der "
                "Hoffnung, dass %s Tat unbemerkt blieb.",
                (string)this_player()->Name(WER),
                (string)this_player()->QueryPronoun(WER),
                (string)this_player()->QueryPossPronoun(FEMALE,WER,SINGULAR)
                ),77), MSGFLAG_VISUAL|MSGFLAG_NO_TP);
            picker-=({file_name(this_player())});
            clone_object(OBJ "irr/gewissen_zwindchen")->move(
                this_player(),M_NOCHECK);
            clone_object(OBJ "kraut/zwindchen")->move(
                this_player(),M_NOCHECK);

            call_out("CA_cmdPfluecke",2);

        }
    }
    return 1;
}

nosave void
CA_cmdPfluecke()
{
    object lhj;
    if (lhj=present("\a\n\a\tol_lhjana"))
        catch(call_other(lhj,"NotifyPflueck"));
}

nosave int 
cmdPatsche(string wo) 
{
    if ((!this_player()) || (!this_interactive()) 
        || (this_player()!=this_interactive()))
        return 0;

    notify_fail("Wogegen moechtest Du patschen?\n");
    if ((!wo) || (wo=="")) return 0;
    if ((wo=="gegen fels") ||
        (wo=="gegen felswand") ||
        (wo=="gegen stelle") ||
        (wo=="gegen wand") ||
        (wo=="gegen stellen")) 
    {
        if ( (int)this_player()->QueryProp(P_SIZE)<40)
            write("Du bist leider zu klein dafuer...\n");
        else {
            say(break_string(sprintf(
                "%s patscht mit der flachen Hand kraeftig gegen die "
                "Felswand.\n",this_player()->Name(WER)),77));
        write("Du patschst mit der flachen Hand kraeftig "
            "gegen die Felswand.\nAua.");
        call_out("CA_cmdPatsche",2);
        }
    return 1;
    }
    if ((wo=="gegen baum")) 
    {
        if (member(healed,file_name(this_player()))!=-1) {
            write("Tja, so oft scheint das nicht zu klappen...\n");
        }
        else 
        {
            healed+=({file_name(this_player())});
            write("Bevor Du Deine Gedanken in die Tat "
                "umsetzen kannst, wirst Du auf magische\n"
                "Weise ein kleinwenig geheilt. "
                "WOW, Du bist begeistert!\n");
            this_player()->heal_self(30+random(40));
            DO_LOG(LOG "garten.log",
                sprintf("%s patscht!\n",
                capitalize((getuid(this_player())))));
        }
        return 1;
    }
    notify_fail("Das klappt leider nicht.\n");
    return 0;
}

nosave void 
CA_cmdPatsche() 
{
    object lhj;
    while (remove_call_out("CA_cmdPatsche")!=-1);
    if (!this_player()) return;
    if (environment(this_player())!=this_object()) return;
    write("Nichts geschieht.\n");
    if (lhj=present("\a\n\a\tol_lhjana"))
        catch(call_other(lhj,"NotifyPatsch"));
    return;
}

nosave string 
detailLoewen() 
{
    if (!this_player()) return "";
    Message(break_string(sprintf(
        "%s schaut sich ploetzlich gehetzt um. Als %s offensichtlich nicht "
        "entdeckt, wonach %s suchte, erroetet %s leicht verlegen.",
            this_player()->Name(WER),
            this_player()->QueryPronoun(WER),
            this_player()->QueryPronoun(WER), 
            this_player()->QueryPronoun(WER)),77)
            ,MSGFLAG_VISUAL|MSGFLAG_NO_TP);
    return break_string("Du blickst gehetzt um Dich - Hilfe, Loewen!!!! "
        "Hm, sieht nicht so aus, als ob es hier Loewen gaebe... Du "
        "kommst Dir, gelinde gesagt, etwas laecherlich vor.",77);
}

nosave string 
detailHunger() 
{     // Soak setzen wir nicht runter, soweit kommt es grade noch... :)
    if (!this_player()) return "";   
    Message(break_string(sprintf(
          "%s Magen beginnt ploetzlich zu knurren.",
          this_player()->Name(WESSEN)),77),MSGFLAG_NO_TP); 
    return "Dein Magen faengt zu knurren an.\n";
}

public void 
reset() 
{
    ::reset();
    zwindchen=(zwindchen+1>MAX_ZWINDCHEN?MAX_ZWINDCHEN:zwindchen+1);
    if ((flag++)%2) 
        healed=({});
}
