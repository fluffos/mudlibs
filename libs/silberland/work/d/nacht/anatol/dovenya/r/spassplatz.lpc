#pragma strict_types

#include "../defines.h"
#define AINE DOVENYA_NPC "aine"

inherit DOVENYA "std/room";


public void 
create() 
{
    ::create();

    SetProp(P_INDOORS,0);
    
    SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:23,
                            ENV_TERRAIN:TT_TOWN,
                            ])); 

    SetProp(P_INT_SHORT,"Dovenya, das Vergnuegungsviertel");
    SetProp(P_INT_LONG,
        "Das Vergnuegungsviertel ist eigentlich auch nur ein kleiner Platz "
        "mit ein paar kleinen Gebaeuden herum. Immerhin: Die Dorfkneipe ist "
        "hier im Suedwesten verortet, direkt links daneben scheint ein "
        "Casino zu sein. Die restlichen Etablissements scheinen "
        "noch nicht geoeffnet."
        );
    
    SetProp(P_GEMA,({0,3,0}));
    
    AddDetail(({"xxx"}),"");

    seteuid(getuid(this_object()));
    Sky();
  
    AddExit("nordosten",
        ([ EX_DEST: "./campanile_eg",
           EX_PLMSG: "Du verlaesst das Vergnuegungsviertel und trittst "
           "zwischen die Arkaden des Campanile.\n",
           EX_MSG: "in die Arkaden des Campanile"]));
    AddExit("westen",
        ([ EX_DEST: "irgendwohin", 
           EX_FUNC: "roomNotYetImplemented" ]));
    AddExit("sueden",
        ([ EX_DEST: "./comet", 
           EX_TESTFUNC: "prepareGuest",
           EX_PLMSG: "Du betrittst das 'Comet'.\n",
           EX_MSG: "in das 'Comet' im Sueden"]));
    AddExit("suedosten",
        ([ EX_DEST: "irgendwohin", 
           EX_FUNC: "roomNotYetImplemented" ]));
    AddExit("suedwesten",
        ([ EX_DEST: "./kneipe", 
           EX_PLMSG: "Du betrittst die Dorfschenke.\n",
           EX_MSG: "in die Dorfschenke nach Suedwesten"]));
    
  
    SetProp(P_HIDE_EXITS,({"sueden","westen","suedosten","suedwesten"}));

}


nosave int 
prepareGuest()
{
    object aine;

    if (!this_player())
    {
        return 1;
    }
    call_other(DOVENYA_ROOM  "comet","???");

    if (!aine=find_object(DOVENYA_NPC "aine")) 
    {
        write("das Casino 'Comet' ist zur Zeit geschlossen.\n");
        return 0;
    }
    else
    {
        aine->PrepareGreet(this_player());
        return 1;
    }
}
    
