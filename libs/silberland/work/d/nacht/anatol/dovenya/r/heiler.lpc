/* Dovenya, beim Heiler
 * _____________________________________(i) Anatol@Silberland (1998-2012) */


#pragma strict_types

#include "../defines.h"

inherit DOVENYA "std/room";


public void 
create() 
{
    ::create();

    SetProp(P_INDOORS,1);
    
    SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:23,
                            ENV_TERRAIN:TT_HOUSE,
                            ])); 

    SetProp(P_INT_SHORT,"Dovenya, 'Wunder-Heilung & Rejuvenation'");
    SetProp(P_INT_LONG,
        "Der Heiler sollte die wichtigsten Krankheiten kurieren koennen, "
        "entflugen, entgiften und - gegen ein gewisses Entgelt und in "
        "gewissem Rahmen - auch Lebenspunkte wiederherstellen. Der Rahmen "
        "koennte sein: Nur wenn die LPs unter 30 sind und nur auf 50. Das "
        "ist fuer kleine Spieler toll, fuer grosse nicht der Reisser."
        );
    
    SetProp(P_GEMA,({0,6,0}));
    
    AddDetail(({"xxx"}),"");

    seteuid(getuid(this_object()));
  
    AddExit("sueden",
        ([ EX_DEST: "./brunnenplatz", 
           EX_PLMSG: "Du verlaesst den Ort der Gesung und gehst raus "
               "auf den Brunnenplatz.\n",
           EX_MSG: "raus auf den Brunnenplatz"]));
 
    SetProp(P_HIDE_EXITS,({""}));

}
