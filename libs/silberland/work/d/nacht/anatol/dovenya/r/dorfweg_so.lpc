/* Dovenya, Dorfweg
 * _____________________________________(i) Anatol@Silberland (1998-2012) */


#pragma strict_types

#include "../defines.h"

inherit DOVENYA "std/room";


public void 
create() 
{
    ::create();

    SetProp(P_INDOORS,0);
    
    SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:23,
                            ENV_TERRAIN:TT_TOWN,
                            ])); 

    SetProp(P_INT_SHORT,"Dovenya, Dorfweg");
    SetProp(P_INT_LONG,
        "Der Dorfweg ist eher unspektakulaer und fuehrt vom Markt (im "
        "Suedosten gelegen in nordwestlicher Richtung weiter."
        "Im Westen steht "
        "ein Campanile - ein frei stehender Glockenturm. Dieser ist zu "
        "ebener Erde offen, man kann also unter ihm hindurch. In "
        "nordoestlicher Richtung fuehrt ein kleiner "
        "Weg zu einem weiteren kleinen Platz weiter, im Suedosten liegt "
        "der Marktplatz. "
        );
    
    SetProp(P_GEMA,({2,4,0}));
    
    AddDetail(({"xxx"}),"");

    seteuid(getuid(this_object()));
    Sky();
  
  
    AddExit("suedosten",
        ([ EX_DEST: "./markt_n", 
           EX_PLMSG: "Du gehst auf den Marktplatz.\n",
           EX_MSG: "auf den Marktplatz"]));
 
    AddExit("westen",
        ([ EX_DEST: "./campanile_eg", 
           EX_PLMSG: "Du trittst zwischen die Arkaden des Campanile.\n",
           EX_MSG: "in die Arkaden des Campanile im Westen"
               ]));

    AddExit("nordwesten",
        ([ EX_DEST: "./dorfweg_nw", 
           EX_PLMSG: "Du folgst dem Dorfweg nach Nordwesten.\n",
           EX_MSG: "dem Dorfweg folgend nach Nordwesten"
               ]));
    AddExit("nordosten",
        ([ EX_DEST: "./wohngebiet", 
           EX_PLMSG: "Du verlaesst den Dorfweg in Richtung Wohngebiet.\n",
           EX_MSG: "ins Wohngebiet im Nordosten"
               ]));

    SetProp(P_HIDE_EXITS,({""}));

}
