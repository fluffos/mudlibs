/* Dovenya, im Freien
 * _____________________________________(i) Anatol@Silberland (1998-2012) */


#pragma strict_types

#include "../defines.h"

inherit DOVENYA "std/room";


public void 
create() 
{
    ::create();

    SetProp(P_INDOORS,0);
    
    SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:23,
                            ENV_TERRAIN:TT_TOWN,
                            ])); 

    SetProp(P_INT_SHORT,"Dovenya, im Freien");
    SetProp(P_INT_LONG,
        "Ruhig ist es hier, das Treiben auf dem Marktplatz nordoestlich "
        "von hier scheint weit weg. In suedlicher Richtung wird es sehr "
        "wahrscheinlich noch ruhiger - Dort liegt der kleine Park der "
        "Siedlung, zu dem nichtmal ein richtiger Pfad zu fuehren scheint. "
        "Es sieht zumindest bei oberflaechlicher Betrachtung so aus, als "
        "ob der Weg hier in einer von Baeumen und "
        "Dickicht umgebenen Sackgasse endet (aber das taeuscht ganz sicher).");
    
    SetProp(P_GEMA,({2,1,0}));
    
    AddDetail(({"boden"}),"");
    AddDetail(({"wand","felswand","fels"}),"");
    AddDetail(({"markt","marktplatz"}),"");
    AddDetail(({"treiben"}),"");
    AddDetail(({"park","gaerten","garten"}),"");
    AddDetail(({"pfad","weg"}),"");
    AddDetail(({"baum","baeume"}),"");
    AddDetail(({"sackgasse"}),"");
    AddDetail(({"dickicht"}),"");

    seteuid(getuid(this_object()));
    Sky();
  
      
    AddExit("nordosten",
        ([ EX_DEST: "./markt_s", 
           EX_PLMSG: "Du gehst auf den Marktplatz.\n",
           EX_MSG: "auf den Marktplatz"]));
     
    AddExit("westen", 
        ([ EX_DEST: "./garten_no",
           EX_PLMSG: "Tapfer quetschst Du Dich in "
            "westliche Richtung durch das Dickicht.\n",
           EX_MSG: "durch das Dickicht in den Park" ]));

    AddExit("suedwesten", 
        ([ EX_DEST: "./garten_o",
           EX_PLMSG: "Tapfer quetschst Du Dich in "
            "suedwestliche Richtung durch das Dickicht.\n",
           EX_MSG: "durch das Dickicht in den Park" ]));

    SetProp(P_HIDE_EXITS,({"westen","suedwesten"}));

}
