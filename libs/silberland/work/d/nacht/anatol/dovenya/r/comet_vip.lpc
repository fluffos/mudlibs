#pragma strict_types

#include "../defines.h"
#include "../sys/comet.h"
#include <pub.h>
#define ROULETTE DOVENYA_ROOM "comet_roulette"

inherit "std/pub";
inherit DOVENYA "std/room";

nosave string
readSomething(string func, mixed param)
{
    if (!this_player())
    {
        return "";
    }
    if (!(this_player()->QueryProp("casino_comet_lounge_sessel")))
    {
        return "Ja... Setz' Dich doch erstmal hin.\n";
    }
    else
    {
        return (string)call_other(ROULETTE, func, param);
    }
}

public string 
ReadListe1()
{
    return readSomething("Toplist",0);
}

public string 
ReadListe2()
{
    return readSomething("Toplist",1);
}

public string
readBuch()
{
    if (!this_player())
    {
        return "";
    }
    return (readSomething("PlayerStats",this_player())
       || "Sowas... es gibt keine Auszeichnungen ueber Dich.\n" );
}


public void 
