{
    DOVENYA "std/room"::create();
    pub::create();  // Reihenfolge fuer die Topliste wichtig...

    seteuid(getuid(this_object()));

    SetProp(P_INDOORS,1);
    
    SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:23,
                            ENV_TERRAIN:TT_HOUSE,
                            ])); 

    SetProp(P_INT_SHORT,"Dovenya, VIP-Lounge des Casino 'Comet'");
    SetProp(P_INT_LONG,
        "Die VIP-Lounge ist stilvoll eingerichtet. Roter Samt, goldene "
