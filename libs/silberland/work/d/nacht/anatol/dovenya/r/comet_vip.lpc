        "Die Creme de la Creme des Kapitals verkehrt hier.. - und nur "
        "diese. Ein kleines rundes Regal steht zwischen den Sesseln und "
        "dient als Stehtisch.");
    
    SetProp(P_GEMA,({0,2,0}));
    
    AddSound(DEFAULT_SOUND,"Es ist hier sehr leise.\n");
    AddSmell(DEFAULT_SMELL,"Es riecht nach Wohlstand.\n");

    AddDetail(({"verzierung","verzierungen"}),
        "Die Verzierungen an... allem ... sind vergoldet (oder gar "
        "massiv golden) und wirken schon fast zu pompoes.");
    AddDetail("vip","Du bist offenbar ein VIP, sonst waerst Du nicht hier.");
    AddDetail("samt","Die Sessel sind mit Samt ueberzogen, rotem Samt. ");
    AddDetail(({"spieler","roulettespieler"}),
        "Du scheinst ein solcher zu sein.");
    AddDetail(({"stehtisch","tisch"}),
        "Es gibt hier keinen Tisch, das, was hier als "
        "Stehtisch herhaelt, ist eigentlich nur ein Regal.");
    AddDetail("kapital","Wieviel Kapital Du besitzst, weisst Du selbst am "
        "besten.");
    AddDetail("creme","Aaah, die Creme de la Creme...");
    AddDetail(({"sessel","ohrensessel"}),
        "Die Ohrensessel sehen weich und sehr bequem aus. Du koenntest "
        "versuchen, Dich in einen zu setzen.");

    AddDetail("wohlstand","Hier oben tummeln sich nur solche, die sich "
        "erlauben koennen, mit Kapital zu spielen. Das ist nur wohlhabenden "
        "Leuten erlaubt. Und Bankern. Banker haben allerdings im Casino "
        "'Comet' per se Hausverbot, seit ein paar von ihnen versucht haben, "
        "Leerverkaeufe auf Zero zu platzieren.");
     AddDetail("leute","Hier tummeln sich wahrscheinlich nur "
        "wohlhabende Leute. Oder, je nach Spielverhalten, Leute, die "
        "wohlhabend waren.");
    AddDetail(({"leerverkauf","leerverkaeufe"}),
        "Ein Leerverkauf ist, wenn Du etwas verkaufst, das Du gar nicht "
        "hast und versprichst zu einem bestimmten Zeitpunkt nachzuliefern. "
        "Du machst Gewinn, wenn Du die Ware spaeter guenstiger kaufen kannst "
        "als Du sie zuvor verkauftest. "
        "Allerdings - Du musst (!) sie kaufen (weil Du sie jemandem anderem "
        "schuldest), und wenn Du sie dann nur viel viel teurer bekommst, "
        "sitzt Du richtig dick in der Tinte. Es sei denn, natuerlich, Du hast "
        "nicht Dein Geld genommen, sondern das Geld anderer Leute. "
        "Deshalb haben Banker kein Problem mit Leerverkaeufen.");
    AddDetail("problem","Du hast kein Problem.");
    AddDetail("geld","Du hast hoffentlich ein wenig bei Dir.");
    AddDetail("zeitpunkt","Zu erkennen, wann ein Zeitpunkt guenstig ist, "
        "ist alles, was man koennen muss. Egal ob es um Geld, Kinder oder "
        "Frauen geht.");
    AddDetail("kinder","Kinder haben hier bedauerlicherweise keinen Zutritt. "
        "Banker ja auch nicht. Ah... deshalb!");
    AddDetail(({"frau", "maennerclub","frauen"}),
        "Die Lounge ist, ausdruecklich, kein Maennerclub. Erfolgreiche Frauen "
        "erhalten selbstverstaendlich ebenso Zutritt - obacht also mit "
        "frauenfeindlichen Zoten.");
    AddDetail(({"gaeste","zutritt"}),
        "Zutritt zur Lounge erhalten alle VIP-Gaeste des Casino 'Comet'.");
    AddDetail(({"vip-lounge","lounge","casino","comet"}),
        "Du befindest Dich hier in der VIP-Lounge des Casino 'Comet'.");
    AddDetail(({"zote","zoten"}),"Oh nein, vergiss es.");
    AddDetail("gewinn",
        "Das kannst Du sicher irgenwo nachlesen...");
    AddDetail("ware","Das war nur bildlich besprochen. Banker handeln selten "
        "mit Ware. Das ist viel zu konkret und durchschaubar.");
    AddDetail("tinte","Du sitzst offensichtlich nicht darin.");
    AddDetail("hausverbot","Haettest Du Hausverbot, waerest Du nicht hier.");
    AddDetail("zero","Das ist die gruene Null am Roulette-Tisch");
    AddDetail("null","Die Null wird auch Zero genannt (betont wird "
            "dabei das 'o').");
    AddDetail(({"spielbank","bank"}),
        "Eine Spielbank wie das Casino 'Comet' hat nichts mit "
        "der kriminellen Finanzwirtschaft zu tun. Ihre Quoten sind "
        "transparent.");
    AddDetail("quote","Das Casino 'Comet' erwirtschaftet durchschnittlich "
        "etwa 2.7% der Einsaetze");
    AddDetail(({"einsatz","einsaetze"}),
        "Wenn Du Einsaetze taetigen moechtest, begib dich nach unten.");
    AddDetail("banker","'Wir muessen leider draussen bleiben!'");
    AddDetail("boden","Der Boden ist mit rotem weichem Teppich bedeckt.");
    AddDetail("teppich","Der rote weiche Teppich ist rot und weich.");
    AddDetail(({"wand","waende"}),
        "Die Waende sind in dunklem gelb gehalten und mit Fresken verziert.");
    AddDetail(({"freske","fresken"}),
        "Diese Fresken hast Du moeglicherweise unten schonmal gesehen...");
    AddDetail("finanzwirtschaft","So etwas willst Du hier nicht sehen.");
    AddDetail("decke","An der Decke haengt ein grosser Kronleuchter.");
    AddDetail(({"leuchter","kronleuchter"}),
        "Der Kronleuchter erinnert stark an jenen ueber dem Roulette-Tisch.");
    AddDetail(({"roulette","roulette-tisch"}),
        "Ah... dafuer gehst Du besser runter.");
    
    AddDetail(({"regal","buecherregal"}),
        "Das Regal ist rund, etwa zwergenhoch und etwa "
        "eindrittelzwergenbreit. Es stehen nicht viele Buecher in ihm, aber "
        "es gibt sie. Obenauf liegen zwei Schriftrollen.");

    AddDetail(({"buch","muehe","buecher"}),
        "Irgendjemand hat sich die Muehe gemacht, Dein Spielverhalten zu "
        "protokollieren und hier in ein Buch zu schreiben. Du kannst das "
        "Buch lesen.");
    AddDetail("spielverhalten","Mh, schau dir mal die Buecher an...");

    AddDetail(({"schriftrolle","schriftrollen"}),
        "Schau an - man ist nirgendwo vor ihnen sicher. Das sind Ranglisten "
        "der Roulettespieler, und zwar eine Bilanzrangliste und eine "
        "Wettrangliste, Du koenntest beide lesen.");

    AddDetail(({"schriftrolle 1", "schriftrolle 2", 
        "rangliste","ranglisten","wettrangliste","bilanzrangliste"}),
        "Du kannst sie lesen.");
    AddReadDetail(({"listen","ranglisten","toplisten"}),
        "Jjjaaaa. Bitte lies sie einzeln.\n");
    
    AddReadDetail(({"liste 1","liste","schriftrolle",
            "schriftrolle 1", "bilanzrangliste"}),#'ReadListe1);
    AddReadDetail(({"liste 2","schriftrolle 2", "wettrangliste"}),#'ReadListe2);
    AddReadDetail("buch",#'readBuch);

    AddCmd(({"setz","sitze","sitz","setze"}),"cmdSitz");
    AddCmd(({"steh","stehe"}),"cmdSteh");
    AddExit("unten",
        ([ EX_DEST: "./comet", 
           EX_PLMSG: "Du steigst die Treppe hinunter und begibst "
                "Dich in die Lobby.\n",
           EX_MSG: "die VIP-Lounge nach unten",
           EX_TESTFUNC:"checkSessel"
           ]));

    SetProp(P_HIDE_EXITS,({}));

    AddDrink("'Perlende Entzueckung' (Schaumwein)", 
        ({"entzueckung", "perlende entzueckung"}),
        100, 0, 1, 1,
        ({
        "Angenehm prickelnd benetzt der Schaumwein Dein Zunge. Sehr lecker.\n",
        "&& sueffelt entzueckt einen Spitzer Schaumwein."}));
    AddDrink("'Rausch der Sinne' (Schaumwein)", 
        ({"rausch", "Rausch der Sinne"}),
        1500, 0, 1, 1,
        ({
        "Oh wow,...  alles beginnt zu schwanken. Dieser edle Tropfen hat "
            "seinen\n"
        "Namen wirklich verdient. Du bist einen Moment wie benebelt.\n",
        "&& ist nach dem Genuss eines 'Rausch der Sinne' "
            "kurz weggetreten"}));
    AddDrink("'Pour le Prestige' (Schaumwein)", 
        ({"pour le prestige", "prestige", "pour"}),
        1999, 0, 5, 5,"drinkPrestige");

    reset();
}


nosave int
checkSessel()
{
    if ((!this_player()) || 
         (this_player()->QueryProp("casino_comet_lounge_sessel")))
    {
        write("Steh' erstmal auf.\n");
        return 0;
    }
    else
    {
        return 1;
    }
}

nosave int
cmdSitz(string wohin)
{
    if (!this_player()) 
    {
        return 0;
    }
    notify_fail("Wohin willst Du Dich setzen?\n");

    if ((!wohin)||(!stringp(wohin)))
    {
        return 0;
    }

    notify_fail("Dorthin kannst Du Dich hier nicht setzen.\n");

    if (!member((["sessel","ohrensessel","auf sessel", 
        "auf ohrensessel","in ohrensessel", "in sessel"]),
        wohin))
    {
        return 0;
    }
    
    notify_fail("Aber... Du sitzst doch schon?!\n");

    if (this_player()->QueryProp("casino_comet_lounge_sessel"))
    {
        return 0;
    }

    this_player()->SetProp("casino_comet_lounge_sessel",1);

    write("Du setzst Dich in einen der bequemen Ohrensessel.\n");
    Message(break_string(sprintf(
        "%s setzt sich in einen der Ohrensessel und kuckt zufrieden.",
        this_player()->Name(WER)),
        77),MSGFLAG_VISUAL|MSGFLAG_NO_TP);
    return 1;
}

nosave int
cmdSteh()
{
    notify_fail("Aber Du stehst doch ...\n");

    if (!(this_player()->QueryProp("casino_comet_lounge_sessel")))
    {
        return 0;
    }

    // Hommage an Dancer@Morgengrauen! :)
    write("Du stehst auf und vermissst den weichen Sessel schon jetzt.\n");
    Message(break_string(sprintf(
        "%s steht aus einem der Ohrensessel auf und blickt etwas "
        "wehmuetig auf den Sessel zurueck.",this_player()->Name(WER)),
        77),MSGFLAG_VISUAL|MSGFLAG_NO_TP);
    this_player()->SetProp("casino_comet_lounge_sessel",0);
    return 1;
}


nosave int
drinkPrestige(object payer, object gulp)
{
    if (previous_object()!=this_object())
    {
      write("HEY!\nNetter Versuch.\n");
      return 0;
    }
    if (!this_player()) return 0;
    if (!objectp(payer) || (payer!=gulp) || (gulp!=this_player()))
    {
        gulp->Message(break_string("Bedauerlicherweise ist dieses Getraenk"
           "von der Dovenyaschen Verordnung zur Bekaempfung der "
           "Geldwaesche betroffen - wenn die 'Pour le Prestige' wirklich "
           "prickeln soll, muss man sie sich selbst bestellen.",
           77));
        payer->Message("Leider vergebens, schade um das Geld.\n");
        return 1;
    }
    gulp->Message(break_string(
        "Aaah, 'Pour le Prestige'! Moment... sooo gut schmeckt das ja "
        "ja gar nicht. Argh, und was haengt Dir da im Hals?",77));
    if (present(VIPID,this_player()))
    {   // gulp == this_player()
        gulp->Message(break_string(
            "Du erinnerst Dich wieder. Es waere ja wohl "
            "peinlich, wenn rauskaeme, dass Du das Zeug tatsaechlich "
            "ohne Not (haha) zweimal trinkst. Tapfer schluckst Du "
            "hinunter, was Dir in die Kehle rann. Und das, was "
            "im Hals steckte, auch.",77));
        Message(break_string(sprintf("%s schaut, als ob %s sich an "
            "etwas wichtiges und... peinliches erinnert, schluckt "
            "tapfer und tut so, als ob nichts gewesen sei.",
            gulp->Name(WER),gulp->QueryPronoun(WER)),77),
            MSGFLAG_NO_TP|MSGFLAG_VISUAL); 
    }
    else
    {
        gulp->Message(break_string(
            "Du wuergst kurz und unauffaellig und zupfst Dir mit "
            "spitzen Fingern einen ... Jeton?! ... aus dem Mund. "
            "Okay, als ob Du das mit den Cometen nicht schon... ach, "
            "halt, das ist ja kein gewoehnlicher Jeton. Du verbirgst "
            "Deine Ueberraschung gekonnt, flippst den Jeton laessig "
            "in die Luft und steckst ihn in die Tasche. Laessig grinsen! "
            "Hah, hat keiner gemerkt, dass Du Dir die Tasche "
            "angesabbert hast."));
        Message(break_string(sprintf("%s wuergt sehr auffaellig und "
            "zupft sich nach verhaltenem Husten einen Jeton aus dem "
            "Mund und starrt ihn sekundenlang fassungslos an. Im "
            "aussichtslosen Versuch, den Zwischenfall zu ueberspielen, "
            "gibt sich %s betont laessig und schnippt %s Jeton in die "
            "Luft, faengt ihn so grade wieder und steckt ihn fix in die "
            "Tasche... so angesabbert wie er war. %s grinst laessig. "
            "VIPs. Haben alle irgendwo einen leichten Hau (und da bist "
            "DU Dir sehr sicher).",
            gulp->Name(WER),
            gulp->name(WER),
            gulp->QueryPossPronoun(MALE,WEN,SINGULAR),
            gulp->Name(WER)),77),
            MSGFLAG_NO_TP|MSGFLAG_VISUAL); 
        clone_object(DOVENYA_OBJ "vip")->move(gulp,M_NOCHECK);
    }
    return 1;
}

public void
reset()
{
    int i;
    mixed item;

    ::reset();

    for (i=sizeof(QueryProp(P_ITEMS));i-->0;)
    {
        item=QueryProp(P_ITEMS)[i];
        if (item[2]=="/obj/topliste")
           item[0]->remove();
    }
}

