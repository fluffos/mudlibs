/* Dovenya, Wohnviertel
 * _____________________________________(i) Anatol@Silberland (1998-2012) */


#pragma strict_types

#include "../defines.h"

inherit DOVENYA "std/room";


public void 
create() 
{
    ::create();

    SetProp(P_INDOORS,0);
    
    SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:23,
                            ENV_TERRAIN:TT_TOWN,
                            ])); 

    SetProp(P_INT_SHORT,"Dovenya, Wohngebiet");
    SetProp(P_INT_LONG,
        "Mittem im Wohngebiet. Hier stehen einige eher private Huetten,  "
        "ein Teil davon, bedingt durch die Touristik (sogar TROLLE koennten "
        "hier herumlaufen), verriegelt."
        );
    
    SetProp(P_GEMA,({3,5,0}));
    
    AddDetail(({"xxx"}),"");

    seteuid(getuid(this_object()));
    Sky();
  
    AddExit("suedwesten",
        ([ EX_DEST: "./dorfweg_so",
           EX_PLMSG: "Du verlaesst das Wohngebiet und gehst zum Dorfweg.\n",
           EX_MSG: "zum Dorfweg nach Suedwesten"]));
    AddExit("suedosten",
        ([ EX_DEST: "./klippenweg_1",
           EX_PLMSG: "Du verlaesst das Wohngebiet und gehst zum Klippenweg.\n",
           EX_MSG: "zum Klippenweg nach Suedosten"]));
    AddExit("westen",
        ([ EX_DEST: "irgendwohin", 
           EX_FUNC: "roomNotYetImplemented" ]));
    AddExit("osten",
        ([ EX_DEST: "irgendwohin", 
           EX_FUNC: "roomNotYetImplemented" ]));
    AddExit("norden",
        ([ EX_DEST: "irgendwohin", 
           EX_FUNC: "roomNotYetImplemented" ]));
    AddExit("nordosten",
        ([ EX_DEST: "irgendwohin", 
           EX_FUNC: "roomNotYetImplemented" ]));
    
  
    SetProp(P_HIDE_EXITS,({"norden","westen","osten","nordosten"}));

}
