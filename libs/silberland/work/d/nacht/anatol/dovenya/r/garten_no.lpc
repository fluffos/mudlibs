/* Dovenya, Gaerten der Ruhe
 * _____________________________________(i) Anatol@Silberland (1998-2012) */


#pragma strict_types

#include "../defines.h"

inherit DOVENYA "std/garten";

private int rauchkraut, gaensebluemchen;
private int * aepfel;    


public void 
create() 
{
    ::create();

    rauchkraut=5;
    gaensebluemchen=8;
    aepfel=({random(5),random(7),random(6),random(5)});
    SetProp(P_INT_SHORT,"Dovenya, Gaerten");
    SetProp(P_INT_LONG,
        "Der Trubel Dovenyas scheint hier weit entfernt, denn die Gaerten "
        "dienen als Ort der Ruhe und Besinnung, und nur die Sterne tauchen "
        "Gaerten und See - er ist suedwestlich von hier - in ihr "
        "geheimisvolles und doch vertrautes Licht. Waehrend Du in "
        "oestlicher Richtung zwischen Gebuesch und Baeumen "
        "durch auf den Weg gelangst, erstrecken sich die Gaerten der Ruhe "
        "weiter in westlicher und suedlicher Richtung.");
    Sky();
    AddSmell(DEFAULT_SMELL,"Es duftet ziemlich stark nach Blumen.");
    AddSound(DEFAULT_SOUND,"Irgendwie ungewohnt ruhig hier...");

    AddSmell(({"blumen","duft","duftkomposition"}),
        "Die Duftkomposition der hier wachsenden Blumen ist beeindruckend. "
        "Gaebe davon ein Parfum, Du wuerdest es glatt haben wollen");
    AddDetail(({"parfum","parfuem"}),
        "Parfum waechst hier leider nicht.");
    AddDetail("trubel",
        "Hier in den Gaerten scheint es ruhig und friedlich zu sein, der "
        "Trubel der Siedlung liegt hinter den Bueschen und Baeumen, die den "
        "Jubel spielender Kinder und den Laerm des Marktplatzes nicht in "
        "die Gaerten dringen lassen.");
    AddSound("trubel","Trubel? Wo? Du hoerst nix.");
    AddDetail(({"ort","gaerten","garten"}),
        "Obwohl hier keine besondere Beleuchtung wie Fackeln, Hexenlichter "
        "oder aehnliches vorhanden ist, gedeiht die Flora praechtig. Die "
        "Gaerten sind eigentlich nur eine sehr grosse Wiese, auf der eine "
        "Vielzahl an Blumen und einige Baeume und Buesche waechst. Zum "
        "Rand hin allerdings stehen die Baeume dichter, teilweise ist "
        "durch das verwildert wirkende Gehoelz kein Durchkommen moeglich.");
    AddDetail(({"ruhe"}),
      ([0:"Den Nachtelfen ist dieser Ort in gewisser Weise heilig, nie wuerde "
          "ein Nachtelf die Ruhe und den Frieden dieses Ortes stoeren.",
        "nachtelf":"Die Ruhe und der Frieden der Gaerten ist Dir heilig."]));
    AddDetail(({"besinnung"}),
        "Nur zu oft muss sich der gestresste Nachtelf von der "
        "Unfreundlichkeit der Welt erholen, die Gaerten sind der ideale "
        "Ort fuer einen Nachtelfen, "
        "wieder etwas zur Ruhe zu kommen und sich auf das Wesentliche zu "
        "besinnen.");
    AddDetail("welt","Leider ist die Welt nicht sehr friedlich...");
    AddDetail("wesentliche","Ja, schau Dir lieber das Wesentliche an.");
    AddDetail("rand","Am Rand der Gaerten stehen die Baeume ziemlich dicht "
        "beisammen.");
    AddDetail(({"beleuchtung","licht"}),
        "In den Gaerten wurde ganz bewusst auf zusaetzliche Beleuchtung "
        "verzichtet, die bezaubernde Atmosphaere des Sternenlichts bleibt "
        "hier erhalten.");
    AddDetail(({"gebuesch","gehoelz"}),
        "In noerdlicher bis suedoestlicher Richtung siehst Du eine sehr "
        "dichtes Gebuesch, das augenscheinlich die Gaerten einfasst "
        "(und wohl voreilige Anfaenger davor bewahrt, die Klippen "
        "hinunterzustolpern). "
        "Ostlich allerdings kannst Du wohl durch das Gehoelz "
        "hindurch und wuerdest auf einen Weg der Siedlung gelangen.");
    AddDetail("klippen",
        "Die Klippen sind etwas weiter westlich beziehungsweise suedlich von "
        "hier, jedoch kann man sie des undurchdringlichen Gehoelzes wegen "
        "nicht erreichen.");
    AddDetail(({"baeumchen","baeume","abgrenzung"}),
        "Vereinzelt stehen in den Gaerten Baeume herum, direkt westlich "
        "waechst ein kleiner Zwirbelapfelbaum, unmittelbar vor Deiner Nase "
        "faellt Dir ein Blaubirke auf. Etwas im Sueden siehst Du ... eine "
        "Nachtzypresse? Deutlich mehr Baeume siehst Du noerdlich und "
        "oestlich, schliesslich besteht die Abgrenzung der Gaerten zur "
        "Siedlung aus Gebuesch und Baeumen.");
    AddDetail(({"apfelbaum","zwirbelapfelbaum"}),
        "Na schnuckelig! Ein kleiner zwirbeliger Apfelbaum, vielleicht "
        "waechst auf dem edlen Gewaechs noch der eine oder andere Apfel?");
    AddDetail("gewaechs","Wuah, welches?");
    AddSpecialDetail(({"apfel","aepfel"}),"detailApfel");
    AddDetail("nachtzypresse","Geh da mal naeher ran, dann kannst Du sie "
        "besser erkennen.");
    AddDetail(({"birke","blaubirke"}),
        "Du stehst fast unter einer Blaubirke. Diese Baeume heissen wohl so, "
        "weil ihr Stamm ein wenig blaeulich schimmert. Im Geaest der Birke "
        "siehst Du - natuuueerlich, irgendwo gibt es sowas IMMER - ein Nest.");
    AddDetail(({"stamm","staemme"}),
        "Hier gibt es viele Baeume und viele Staemme.");
    AddDetail("geaest","Im Geaest der Blaubirke scheint ein altes Vogelnest "
        "zu sein.");
    AddSpecialDetail(({"vogelnest","nest"}),"detailNest");
    AddDetail("weg",
        "Du kannst den Weg von hier aus nicht sehen, die Baeume und viel "
        "Gebuesch versperren Dir, obwohl Du Dir sicher bist, Dich nach "
        "Norden und Osten zum Weg durchschlagen zu koennen, die Sicht.");
    AddSpecialDetail(({"richtungen","richtung"}),"detailRichtung");
    AddDetail("sicht","Die Sicht auf den Weg wird Dir von Baeumen versperrt.");
    AddDetail("siedlung",
        "Die Gaerten der Ruhe gehoert zu Dovenya, der nachtelfischen "
        "Siedlung.");
    AddDetail("jubel","Gesunde Kinder sind laut, das scheint "
        "eine alte Weisheit zu sein...");
    AddDetail(({"weisheit","weisheiten"}),
        "Solche Weisheiten kommen nie von Leuten, die eigene "
        "Nervensae^H^H^H^H^H^H^H^H^H^HKinder haben.");
    AddDetail(({"kids","kinder"}),
        "Die vergnuegten Kids toben gluecklicherweise "
        "nicht hier in den Gaerten herum, die Ruhe hier ist "
        "sogar ihnen etwas wert.");
    AddDetail("laerm","Auf einem Markt gibt es immer etwas, das laut "
        "herumgeschrien werden muss, zumindest hoert es sich dort so an...");
    AddDetail("marktplatz",
        "Den Marktplatz siehst Du von hier aus nicht. Wirklich nicht.");
    AddDetail(({"fackel","fackeln","hexenlicht","hexenlichter"}),
        "Nein, sowas siehst Du hier wirklich nicht!");
    AddDetail("flora","Hier gibt es Gras und Graeser, Blumen, Buesche, "
        "Baeume und Baeumchen, und alles gedeiht praechtig!");
    AddDetail("wiese",
        "Die Wiese ist sehr weich, die Halme der Graeser sind recht lang und "
        "bewegen sich in dem gelegentlich aufkommendem leichten Wind "
        "sacht hin und her.");
    AddDetail("gras","Das Gras fuehlt sich weich und angenehm an. "
        "Stellenweise ist es mit bunten Blumen und "
        "besonders auffaelligen Graesern durchsetzt.");
    AddDetail(({"vielzahl","vielfalt"}),"Ui, sind das viele verschiedene!");
    AddDetail("blume","Schoen. WELCHE Blume? :)");
    AddDetail(({"wiesenblumen","blumen"}),
        "Kaum zu glauben, was hier so alles waechst... Du siehst "
        "bueschelweise blaubluehende Wiesenamrynen, "
        "einzelne gelbe Minostazien, "
        "viele Gaenseschnaebel, eine richtige Insel aus Gaensebluemchen, und, "
        "und, und...! Sogar rote Flammenspeerlilien wachsen am "
        "Rand der Wiese, fantastisch....");
    AddDetail(({"gaenseschnabel","gaenseschnaebel"}),
        "Diese Blumen haben ihren witzigen Namen natuerlich wegen der "
        "auffallenden Bluetenform... Wenn hier jemals eine Gans auf die "
        "Wiese kommen sollte, wird sie sich wohl halbverrueckt im See "
        "ertraenken.");
    AddDetail(({"form","bluetenform"}),
        "Die Form der Blueten des Gaenseschnabels ist... "
        "... unschwer zu erraten. :)");
    AddSmell(({"gaenseschnabel","gaenseschnaebel"}),"Hm, Du riechst nix.");
    AddSpecialDetail("namen","detailNamen");
    AddDetail(({"minostazie","minostazien"}),
        "Die knallgelben Flecken in der Wiese sind hauptsaechlich "
        "Minostazien, "
        "quasi immerbluehende, kamilleaehnlich duftende Blumen, die "
        "ausschliesslich aus einem blattlosen Stiel und "
        "einer Bluete bestehen.");
    AddDetail("stil",
        "Das schreibt man doch da mit 'ie', faellt Dir auf. Ja, es "
        "muesste in dem Zusammenhang 'Stiel' heissen!");
    AddDetail("stiel",
        "SO ists richtig!!");
    AddDetail(({"zusammenhang","zusammenhaenge"}),
        "Du bekommst so langsam einen Blick fuer Zusammenhaenge");
    AddDetail("duft",
        "Das siehst Du hier nicht, was Dich nicht weiter ueberrascht.");
    AddDetail("blick",
        "    <O>  <O>         (Da macht jemand grosse Augen)");
    AddDetail("augen",
        "    <O>  --<         (Jetzt zwinkert er Dir zu!)");
    AddDetail(({"wiesenamryne","wiesenamrynen","amrynen"}),
        "Wiesenamrynen sind recht ungewoehnliche Wiesenblumen, deren blaue "
        "Blueten immer neunblaettrig sind und einen leicht herben Geruch "
        "verbreiten. Trotz dass Wiesenamrynen fast nur in groesseren Bueschel "
        "auftreten, vermehren sie sich leider nur sehr langsam.");
    AddDetail("bueschel",
        "Hey, das sind doch Wiesenamrynen!");
    AddSmell(({"wiesenamrynen","wiesenamryne"}),
        "Der Geruch ist irgendwie ... herb, richtig beschreiben kannst Du "
        "ihn nicht.");
    AddDetail("gaensebluemchen",
        "Ui, wie s\"u/3! Wieviele Gaensebluemchen das wohl sein moegen?!");
    AddSmell("gaensebluemchen",
        "Die Gaensebluemchen riechen nach... Gaensebluemchen!");
    AddDetail(({"flammenspeerlilie","flammenspeerlilien"}),
        "Ueber einen Meter lange und fingerdicke Stengel sind ebenso "
        "charakteristisch wie der lange Bluetenkorb, der mit etwa zwei "
        "Dutzend einzelner feuerroten Blueten besetzt ist. Der Duft dieser "
        "seltenen Pflanzen erinnert ein wenig an Honig.");
    AddDetail("pflanzen",
        "Oh, Du siehst hier wirklich viele Pflanzen!");
    AddDetail("dutzend","Es sind eigentlich zwei Dutzend.");
    AddDetail("zwei dutzend", "So schaut's aus!");
    AddDetail("stengel","Du kommst zu dem Schluss, dass Flammenspeerlilien "
        "den laengsten Stengel ueberhaupt haben.");
    AddSmell(({"flammenspeerlilie","flammenspeerlilien"}),
        "Hmmm, riecht irgendwie nach Honig.");
    AddDetail("honig","HONIG? Wo??");
    AddDetail(({"bluete","blueten","bluetenkorb"}),
        "Hier blueht es fast ueberall, Du weisst gar nicht, wo Du hinschauen "
        "sollst.");
    AddDetail("baum","Jo, welchen?");
    AddDetail("anfaenger","Gluecklicherweise gibt es sie noch.");
    AddDetail("wind","Gelegentlich streicht ein leichter Wind durch die "
        "Gaerten.");
    AddDetail("nase","Selber Nase!");
    AddDetail("atmosphaere","Hach, diese Ruhe... es ist wirklich wunderschoen "
        "hier...");
    AddDetail("boden",
        "Der Boden ist in erster Linie mit Gras bedeckt, die Gaerten bestehen "
        "ja hauptsaechlich aus Wiese und Blumen.");
    AddDetail("frieden", "Wer wuerde ihn stoeren wollen...?");
    AddDetail("durchkommen","Da ist ein Durchkommen, zum Glueck!");
    AddDetail("glueck","Da hast Du aber Glueck, gell?");
    AddDetail("markt","Den Markt kannst Du von hier aus nicht sehen.");
    AddDetail("linie","_____________________________________________\n\n");
    AddDetail("leute","\"Eltern\" waeren das dann.");
    AddDetail("eltern","Du hast vermutlich auch welche.");
    AddDetail("nacht","Es ist Nacht.");
    AddDetail(({"nachtelf","nachtelfen"}),
        "Du befindest Dich in Dovenya, der Siedlung der Nachtelfen.");
    AddDetail("kinder","Die Kinder spielen irgendwo in der Siedlung, jedoch "
        "nicht hier in den Gaerten.");
    AddDetail("dovenya","So heisst die Siedlung der Nachtelfen.");
    AddDetail("unfreundlichkeit",
        "Damit sind natuerlich nicht Nachtelfen gemeint.");
    AddDetail(({"busch","buesche"}),
        "Die Vielfalt an Bueschen ist auch faszinierend, faellt aber nicht "
        "so sehr auf, da die meisten Buesche nahe des (oder gleich im) "
        "Gehoelz wachsen. Dir faellt allenfalls ein kleiner Rauchkrautbusch "
        "auf, das ist aber auch alles. In oestlicher Richtung scheint "
        "das Buschwerk etwas lichter.");
    AddDetail("buschwerk",
        "Tatsaechlich - an einer Stelle ist koennte man sich auf einem "
        "mehr oder minder imaginaeren Pfad nach Osten durchquetschen. Dort "
        "wird wohl ein Weg zur Siedlung fuehren.");
    AddDetail("pfad",
        "Also ein Pfad ist da nicht, alles andere als das. Aber die Stelle "
        "ist licht genug, um nach Osten durchzukommen.");
    AddDetail("stelle",
        "Ja, Du bist Dir zunehmend sicher - nach Osten wird man die Gaerten "
        "verlassen koennen.");
    AddDetail(({"graeser","halme","halm"}),
        "Die Halme der Graeser sind ziemlich lang und machen einen recht "
        "stabilen Eindruck, vermutlich werden sie Anderorts zur Herstellung "
        "von Kleidung oder aehnlichem gepflanzt....");
    AddDetail("herstellung", "Andererorts.");
    AddDetail("eindruck","Der Eindruck taeuscht vermutlich nichtmal.");
    AddDetail("anderorts",
        "Nicht hier - hier scheinen diese Graeser einfach wild zu wachsen.");
    AddDetail("kleidung","Naja, solche Dinger zum Anziehen halt."),
    AddDetail("dinger","Welche Dinger?");
    AddDetail(({"flecke","fleck","flecken"}),
        "Die bunten Flecken in der naechtlichen Wiese sind Blueten.");
    AddDetail("insel","Das war nur eine Metapher.");
    AddDetail("metapher","Nein, und auch DAFUER gab es keinen Forscherpunkt.");
    AddDetail("forscherpunkt","Ne, so auch nicht.");
    AddDetail("geruch","Den siehst Du nicht.");
    AddDetail(({"zwerge","zwerg"}),"Tja, WIE sehen Zwerge wohl aus...");
    AddDetail("gewissheit","Regmichnichtauf.");
    AddDetail("regmichnichtauf","Jadichmeinich!");
    AddDetail("bluetenblatt",
        "Du kannst es nicht so recht ausmachen.");
    AddDetail("schmetterling", 
        "Oh, er ... er ist schon weg.");
    AddDetail("dunkelheit",
        "Es ist nicht gerade sprichwoertlich taghell, aber dunkel ist es "
        "auch nicht.");
    AddDetail("jadichmeinich",
        "Loeschen und Banishen waer noch zu gut fuer Dich.");
    AddSpecialDetail(({"rauchkraut","rauchkrautbusch"}),"detailRauchkraut");
    SetStupids(({"h","da","hkinder","dafuer","anziehen", "jetzt","nervensae"}));
    seteuid(getuid(this_object()));
    AddExit("westen","./garten_n");
    AddExit("sueden","./garten_o");
    AddExit("osten",
       ([ EX_DEST: "./sackgasse", 
        EX_PLMSG: "Du quetschst Dich durch das Dickicht in die Siedlung.\n",
        EX_MSG: "durch das Dickicht nach Osten in die Siedlung"]));
    AddExit("suedwesten",([EX_FUNC:#'seeExitTestfunc]));
    SetProp(P_GEMA,({1,1}));
    SetProp(P_HIDE_EXITS,({"osten","suedwesten"}));
    AddCmd(({"zaehle","zaehl"}),"cmdZaehle");
    AddCmd(({"pfluecke","pflueck"}),"cmdPfluecke");
    AddRoomMessage( ({ 
        "Leise faellt ein Bluetenblatt und verschmilzt mit der Dunkelheit.\n",
        "Ein verirrter Schmetterling flattert eilig durch die Nacht.\n",
        "Irgendetwas raschelt irgendwo.\n" }),1200);
}
    
nosave int 
cmdZaehle(string was) 
{
    string ret;

    if (!this_player()) 
        return 0;

    notify_fail("Und was moechtest Du zaehlen?\n");
    if ((!was)||(was=="")) 
        return 0;

    notify_fail("Hm, das kannst Du nicht zaehlen.\n"
        "Und wenn doch, dann wuerdest Du Dich bestimmt _ver_zaehlen.\n");
    if (was!="gaensebluemchen") 
        return 0;
    Message(break_string(this_player()->Name(WER)+" beugt sich ueber das Meer "
        "aus Gaensebluemchen und macht einige Momente einen voellig "
        "abwesenden Eindruck.",77),MSGFLAG_VISUAL|MSGFLAG_NO_TP);

    switch (this_player()->QueryProp(P_RACE)) 
    {
        case "Troll": 
            ret="Du starrst die Gaensebluemchen an und kommst zu einem "
                  "Ergebnis jenseits von viele-viele-viele-viele. Bah.";
            break;
        case "Zwerg": 
            ret="Du zaehlst die Gaensebluemchen und stellst fest: Es "
                  "sind etwas mehr als drei."; 
            break;
        case "Nachtelf":
        case "Elf":
            ret=sprintf(
                  "Du schaust kurz auf die vielen Gaensebluemchen, zaehlst"
                  " alle Bluetenblaetter und teilst durch die Anzahl "
                  "Bluetenblaetter je Gaensebluemchen. Du kommst auf "
                  "%d.",1093+gaensebluemchen);
            break;
        default: 
            ret="Du faengst an, die Gaensebluemchen zu zaehlen, aber irgendwo"
                 " zwischen 1054 und 1074 kommst Du durcheinander.";
            break;
    }
    this_player()->Message(break_string(ret));
    return 1;
}

                 
nosave int 
cmdPfluecke(string was) 
{
    string ret;
    object ob;
    int i,sum,ind;

    ob=0;
    sum=0;

    if (!this_player()) 
        return 0;

    notify_fail("Was moechtest Du pfluecken?\n");
    if ((!was) || (was=="")) 
        return 0;

    switch (was) 
    {
        case "gaensebluemchen":
            if (gaensebluemchen) 
            {
                gaensebluemchen--;
                ob=clone_object(OBJ "kraut/gaense");
                ret="Du pflueckst eines der Gaensebluemchen.";
                Message(break_string(this_player()->Name(WER)+ 
                    " pflueckt ein kleines Gaensebluemchen.",77),
                    MSGFLAG_VISUAL|MSGFLAG_NO_TP);
            }
            else
                ret="Irgendwie hast Du das unbestimmte Gefuehl, "
                    "dass es zuwenig Gaensebluemchen waeren, wenn Du "
                    "noch eines wegpfluecken wuerdest."; 
            break;
        
        case "gras":
        case "graeser":
            ret="Lass' das Gruenzeug ruhig stehen, das ist soooo huebsch nun "
                    "doch nicht.";
            break;
        case "wiesenamrynen":
        case "wiesenamryne":
        case "amrynen":
        case "amryne":
            ret="Mmmhmhmm! Wiesenamrynen wachsen nicht gerade ueberall "
            "und wachsen doch eh' so selten nach! Mit dem Gedanken an die "
            "Natur laesst Du die blaubluehenden Wiesenamrynen stehen.";
            break;
        case "lilie":
        case "lilien":
        case "speerlilie":
        case "speerlilien":
        case "flammenspeerlilie":
        case "flammenspeerlilien":
            ret="Du erinnerst Dich ploetzlich daran, dass "
            "Flammenspeerlilien schon "
            "als ausgestorben galten und im gepflueckten Zustand eh sehr "
            "rasch verwelken. Du laesst das Pfluecken und erfreust Dich ihrer "
            "Schoenheit lieber vor Ort.";
            break;
        case "bluete":
        case "blueten":
            ret="Man pflueckt keine Blueten, hoechstens Blumen.";
            break;
        case "blume":
        case "blumen":
            ret="Hier hat es viele verschiedene Blumen, welche meinst Du?";
            break;
        case "minostazie":
        case "minostazien":
            ret="Du kuckst die verschiedenen Minostazien an, kannst Dich dann "
                "aber nicht entscheiden und laesst einfach alle stehen.";
            break;
        case "aepfel": ret="Aepfel? Auch gleich noch MEHRERE?";
            break;
        case "apfel":
            ind=(int)this_player()->QueryProp(P_SIZE)/70;
            for (i=0;(i<sizeof(aepfel))&&(i<=ind);i++)
                sum+=aepfel[i];
            if (!sum) 
                ret="Leider haengen keine Aepfel in Deiner Reichweite...";
            else 
            {
                ret="Du pflueckst einen der kleinen Zwirbelaepfel.";
                Message(break_string(this_player()->Name(WER)+
                   " pflueckt einen kleinen Zwirbelapfel.",77),
                   MSGFLAG_VISUAL|MSGFLAG_NO_TP);
                i=sizeof(aepfel)-1;
                while (i>=0) 
                {
                    if ((i<=ind) && aepfel[i]) 
                    {
                        aepfel[i]--;
                        break;
                    }
                    i--;
                }
                ob=clone_object(OBJ "food/apfel");
            }
            break;
        case "rauchkraut":
        case "blatt":
        case "rauchkrautblatt":
        case "krautblatt":
            if (--rauchkraut<0) 
                ret="Der kleine Rauchkrautbusch traegt im Moment leider keine "
                "erntereifen Blaetter.\n";
            else    
            {
                ob=clone_object(OBJ "kraut/rauchkraut");
                ret="Vorsichtig pflueckst Du ein Rauchkrautblatt vom Busch.";
                Message(break_string(this_player()->Name(WER)+ 
                    " pflueckt etwas von dem kleinen Rauchkrautbusch.",77),
                    MSGFLAG_VISUAL|MSGFLAG_NO_TP);
            }
            break;
        default: 
            ret="Das kannst Du nicht pfluecken.";
            break;
    }
    this_player()->Message(break_string(ret,77));
    if (ob) 
    {
        ob->move(environment(this_player()),M_NOCHECK);
        ob->move(this_player(),M_GET);
    }
    return 1;
}

nosave string 
detailNest() 
{ 
    if (!this_player()) 
        return "";
    if ( (int)(this_player()->QueryProp(P_SIZE))<150)
        return break_string("Du bist leider zu klein, um in das Vogelnest "
            "hineinsehen zu koennen, es macht aber - von unten betrachtet - "
            "einen verlassenen Eindruck.",77);
    else 
        return break_string("Du streckst Dich und schaust in das Vogelnest. "
            "Es ist verlassen und leer. Schade, aber wenigstens hast Du "
            "die Gewissheit, die ein Zwerg (*grins*) nicht haben wird.",77);
}

nosave string 
detailRichtung() 
{ 
    return GetExits(); 
}

nosave string 
detailNamen() 
{ 
    string nm;

    if (!this_player()) 
        return "";
    nm=(string)this_player()->Name(WER);
    call_out("CA_detailNamen2",2);
    return break_string(
        sprintf("Pah, glaubst Du, \"%s\" ist einfallsreicher?!",
        (nm?nm:"?")),77);
}

nosave void 
CA_detailNamen2() 
{

    while (remove_call_out("CA_detailNamen2")!=-1);
    this_player()->Message("Traeum' weiter.\n");
}

nosave string 
detailRauchkraut() 
{ 
    string res;
    res="Von kundiger Hand getrocknet und zermahlen, haben die Blaetter (oder "
        "das, was davon noch uebrig ist) des Rauchkrautbusches heilende "
        "Wirkung. Der Busch vor Dir ist nicht gerade sehr gross, ist aber "
        "schon fast ausgewachsen, wird also auch nicht mehr groesser. ";
    if (!rauchkraut) 
        res+="Reife Blaetter traegt er allerdings nicht."; 
    else if (rauchkraut==1)
        res+="Du kannst anhand der roetlichen Faerbung sogar ein erntereifes "
        "Blatt ausmachen.";
    else
        res+="Sehr vereinzelt schimmern roetlich gefaerbten erntereifen "
        "Blaetter, die Du einzeln pfluecken koenntest.";
    return break_string(res,77);
}

nosave string 
detailApfel() 
{
    int i,ind, sum;

    sum=0; 
    ind=(int)this_player()->QueryProp(P_SIZE)%50;
    for (i=0;(i<sizeof(aepfel))&&(i<=ind);i++)
        sum+=aepfel[i];
    if (!sum)
        return break_string(
        "Es haengen einige kleine Zwirbelaepfel am Baum, aber in Deiner "
        "Reichweite befindet sich leider kein einziger. :-(",77);
    else if (sum==1) 
        return break_string(
            "Der Baum traegt einige Zwirbelaepfel, wovon Du einen sogar "
            "pfluecken koenntest, denn er haengt tief genug.",77);
    else 
        return break_string(
      "Der Baum traegt einige Zwirbelaepfel und es haengen auch mehrere "
      "in Deiner Reichweite, Du koenntest also schon mal einen der suessen "
      "Aepfelchen pfluecken.",77);
}


public void 
reset() 
{
    int i;

    ::reset();
    gaensebluemchen=8;
    rauchkraut=5;
    for (i=0;i<sizeof(aepfel);i++)
        if (aepfel[i]<4) 
            aepfel[i]+=random(3);
}
