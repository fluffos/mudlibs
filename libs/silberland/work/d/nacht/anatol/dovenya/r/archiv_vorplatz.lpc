/* Dovenya, vor dem Archiv
 * _____________________________________(i) Anatol@Silberland (1998-2012) */


#pragma strict_types

#include "../defines.h"

inherit DOVENYA "std/room";


public void 
create() 
{
    ::create();

    SetProp(P_INDOORS,0);
    
    SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:23,
                            ENV_TERRAIN:TT_TOWN,
                            ])); 

    SetProp(P_INT_SHORT,"Dovenya, vor dem Archiv");
    SetProp(P_INT_LONG,
        "Die Tore des Archivs sehen massiv aus. Wenn die Welt untergeht "
        "und jeder Nachtelf aus dem Silberland getilgt wird... das Archiv "
        "wuerde das ueberleben. Nach Suedosten geht es ins Archiv, nach "
        "Westen auf den Klippenweg."
        );
    
    SetProp(P_GEMA,({5,4,0}));
    
    AddDetail(({"xxx"}),"");

    seteuid(getuid(this_object()));
    Sky();
  
    AddExit("westen",
        ([ EX_DEST: "./klippenweg_1", 
           EX_PLMSG: "Du gehst zum Klippenweg.\n",
           EX_MSG: "nach Westen zum Klippenweg"]));
 
    AddExit("suedosten",
        ([ EX_DEST: "./archiv", 
           EX_PLMSG: "Du trittst durch die Tore ins Archiv.\n",
           EX_MSG: "nach Suedosten ins Archiv"
               ]));

    SetProp(P_HIDE_EXITS,({""}));

}
