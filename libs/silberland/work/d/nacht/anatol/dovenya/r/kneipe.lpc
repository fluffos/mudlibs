/*
 * Bietet Heiltrank an, wirkt alle 28'800 Sekunden (8 Stunden), kann nicht 
 * spendiert werden.
 */

#pragma strict_types

#include "../defines.h"
#include <pub.h>

#define SCHUHWERKID "\a\n\a\tol_heels"
inherit DOVENYA "std/room";
inherit "std/pub";

nosave mapping sternschnuppe;

public void 
create() 
{
    mixed item;
    int i;

    DOVENYA "std/room"::create();
    pub::create();

    sternschnuppe=([]);
    SetProp(P_INDOORS,1);
    
    SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:23,
                            ENV_TERRAIN:TT_HOUSE,
                            ])); 

    SetProp(P_INT_SHORT,"Dovenya, die Dorfschenke");
    SetProp(P_INT_LONG,
        "Der Ausschank alkoholischer Getraenke sollte ausgelassenes Klima "
        "zur Folge haben - hier geht es jedoch erstaunlich gesittet zu. "
        "Sechs oder sieben Tische stehen in der vorderen Haelfte des "
        "Raumes verstreut, waehrend an der hinteren Wand eine augenscheinlich "
        "komfortabel ausgeruestete Bar mit Theke eingerichtet ist. Die "
        "Gemaelde-behangenen Waende sind nicht verputzt, das Licht der "
        "flackernden Kerzen wirft geheimnisvolle Muster auf das raue "
        "Mauerwerk. Links neben der Theke fuehrt ein mit schweren "
        "Vorhaengen abgeschirmter Durchgang in ein Hinterzimmer."
        );
    
    SetProp(P_GEMA,({-1,2,0}));
    
    AddDetail(({"boden"}),
        "Du stehst auf hoelzernen dunklen Bohlen, die schwer vom Alter "
        "gezeichnet sind. Flecken, Kratzer und Dellen bezeugen, dass es "
        "hier das eine oder andere mal auch nicht gesittet zugegangen "
        "sein muss.");
    AddDetail(({"bohlen"}),
        "Den siehst Du hier nicht (und bist sehr froh darueber!).");
    AddDetail(({"dieter bohlen","dieter"}), 
        "Du wirst Dich erst wieder am Mon, 29. Dez 2023 einloggen koennen!\n"
        "Wenn Du das wirklich willst, gib jetzt 'ja' ein.\n"
        "] ja\n"
        "Ok, die Spielpause wird mit dem naechsten Ausloggen wirksam.\n"
        "Solltest Du es Dir bis dahin noch einmal ueberlegt haben, so kannst\n"
        "Du den Vorgang mit 'spielpause 0 tage' wieder rueckgaengig machen.\n"
        );
    AddDetail("kratzer",
        "Der Boden ist ziemlich zerkratzt. Der ist bestimmt aelter als Du.");
    AddDetail("dellen",
        "Der Boden weist einige bemerkenswerte Dellen auf. Da hat jemand "
        "sehr eindrucksvolles Schuhwerk getragen. Mutmasslich weiblich mit "
        "dem Drang, groesser zu wirken.");
    AddSpecialDetail("drang","detailDrang");

    seteuid(getuid(this_object()));
  
  
    AddExit("nordosten",
        ([ EX_DEST: "./spassplatz", 
           EX_PLMSG: "Du verlaesst die Schenke und gehst nach draussen.\n",
           EX_MSG: "nach draussen"]));
  
    AddExit("hinten",
        ([ EX_DEST: "./schach", 
           EX_PLMSG: "Du schlaegst Dich zum Hinterzimmer durch.\n",
           EX_MSG: "ins Hinterzimmer"]));
  
    SetProp(P_HIDE_EXITS,({""}));

    AddCmd(({"spuer","spuere"}),"cmdSpuere");

    AddDrink("Wasser 'Stille Quelle'", ({"stille quelle", "wasser"}),
        10, 0, 0, 1,
        ({
        "Ein Glas Wasser... na gut. Das geht quasi so raus wie rein.\n",
        "&& kippt schweigend ein Glas Wasser."}));

    AddDrink("Heiltrank 'Sternschnuppe''", 
        ({"schnuppe", "sternschnuppe", "heiltrank", "grosser heiltrank",
           "heiltrank sternschnuppe"}),
        1999, 0, 5, 5,"drinkSternschnuppe");


    AddFood("Leerer Glueckskeks",
        ({"keks","glueckskeks","leerer glueckskeks","leerer keks"}),
        59,0,2,
        ({
            break_string("Wie man auch immer auf die Idee kommt, "
            "Glueckskekse zu verkaufen, die leer sind (und ja, vorsichtig "
            "abgebissen), ... immerhin schmeckt er einigermassen. Das war "
            "aber auch schon alles.",77),
            "&& knabbert - vorsichtig - einen Glueckskeks."}));

    for (i=sizeof(QueryProp(P_ITEMS));i-->0;)
    {
        item=QueryProp(P_ITEMS)[i];
        if (item[2]=="/obj/topliste")
           item[0]->SetProp(P_INVIS,1);
    }

}


nosave int 
drinkSternschnuppe(object payer, object gulp)
{
    if (previous_object()!=this_object())
    {
      write("HEY!\nNetter Versuch.\n");
      return 0;
    }
    if (!this_player()) return 0;
    if (!objectp(payer) || (payer!=gulp) || (gulp!=this_player()))
    {
        gulp->Message(break_string("Bedauerlicherweise ist diese Art von "
           "Trank von der Dovenyaschen Verordnung zur Bekaempfung der "
           "Geldwaesche betroffen - wenn die 'Sternschnuppe' wirklich "
           "wirken soll, muss man sie sich selbst bestellen.",
           77));
        payer->Message("Leider vergebens, schade um das Geld.\n");
        return 1;
    }
    gulp->Message(break_string(
        "Aaah, die 'Sternschnuppe'. Fruchtig. Und eine Wohltat.",77));
    if (member(sternschnuppe,file_name(gulp))
       && ((sternschnuppe[file_name(gulp)]+28800)>time()))
    {   // gulp == this_player()
        gulp->Message("Bedauerlicherweise zeigt das edle Getraenk keine "
            "Wirkung.\n");
        Message("Indes, vergebens.\n",MSGFLAG_NO_TP|MSGFLAG_VISUAL); 
    }
    else
    {
        if ((int)(gulp->QueryProp(P_MAX_HP)) >
               (int)(gulp->QueryProp(P_HP)))
            gulp->Message("Aaaaah, viel besser.\n");
        gulp->heal_self(10000);
        if (gulp->QueryProp(P_POISON))
        {
            if (!(int)(gulp->SetProp(P_POISON,0)))
                 gulp->Message("Chique, Deine Vergiftung ist abgeklungen.\n");
        }
        if (gulp->QueryProp(P_BLIND))
        {
            if (!(int)(gulp->SetProp(P_BLIND,0)))
                 gulp->Message("Dein Augenlicht kehrt wieder, fein.\n");
        }
        if (gulp->QueryProp(P_DEAF))
        {
            if (!(int)(gulp->SetProp(P_DEAF,0)))
                 gulp->Message("Deine Ohren vermoegen wieder zu hoeren.\n");
        }
    sternschnuppe+=([file_name(gulp):time()]);
    }
    return 1;
}

nosave string 
detailDrang()
{
    if ((!this_player())
        || (((int)(this_player()->QueryProp(P_GENDER))) != FEMALE))
    {
        return break_string("Du spuerst einen solchen Drang nicht, was "
            "Dich jetzt irgendwie nicht weiter wundert.",77);
    }
    else
    {
        return "Ooooh, dieser Drang, ... spuerst Du ihn nicht auch?!\n";
    }
}


nosave int 
cmdSpuere(string what)
{
    object schuhe;

    if ((!what) || (!stringp(what)) || (!strlen(what))
        || (!this_player()))
    {
        return fail("Was willst Du spueren?");
    }
    if (((int)(this_player()->QueryProp(P_GENDER)))!=FEMALE)
    {
        return fail("Du spuerst hier keinen Drang.");
    }
    notify_fail("Du spuertest hier schon genug.\n");
    if (present(SCHUHWERKID,this_player()))
    {
        return fail("Du spuertest hier hier schon genug.");
    }
    if (!objectp(schuhe=clone_object(ARMOUR "heels")))
    {
        return fail("Du haettest eigentlich etwas spueren sollen, "
            "spuerst aber erstaunlicherweise nichts aussergewoehnliches.");

    }
    if (((int)(schuhe->move(this_player(),M_GET|M_SILENT)))!=1)
    {
        schuhe->remove();
        return fail("Das liest sich jetzt ueberaus seltsam, aber "
            "Du solltest das mit dem Drang spueren nochmal versuchen, "
            "wenn Du nicht so viel unnuetzes Zeugs mit Dir herumschleppst.");
    }
    write(break_string(sprintf(
        "Du starrst diese Dellen an und UUUUAAAAAAAAAAAAAGH! "
        "Du spuerst einen geradezu unglaublichen Drang, auch zu den "
        "Verursacherinnen solcher Dellen gehoeren zu koennen. Und siehe, "
        "eine wohlwollende hoehere Macht ist auch Dir wohlgesonnen.\n"
        "%s materialisiert sich zwischen Deinen Besitztuemern.",
        schuhe->Name(WER)),77,0,1));
    Message(break_string(sprintf(
        "%s starrt intensiv den Fussboden an, kneift die Beine zusammen, "
        "gibt Grunzlaute von sich, hibbelt herum, dreht sich im Kreis... "
        "um mit einem 'AAaaaaaaah.....' ploetzlich viel erleichtert zu "
        "wirken. Aehm.",this_player()->Name(WER)),77),MSGFLAG_NO_TP);
    return 1;

}
