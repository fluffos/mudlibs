/* Dovenya, Campanile
 * _____________________________________(i) Anatol@Silberland (1998-2013) */


#pragma strict_types

#include "../defines.h"

inherit DOVENYA "std/room";


public void 
create() 
{
    ::create();

    SetProp(P_INDOORS,1);
    
    SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:23,
                            ENV_TERRAIN:TT_TOWN,
                            ])); 

    SetProp(P_INT_SHORT,"Dovenya, Campanile (ebenerdig)");
    SetProp(P_INT_LONG,
        "Das Erdgeschoss des Campanile. Dieser frei stehende Glockenturm "
        "wird charakterisiert... dadurch, dass er zu ebener Erde auf "
        "Arkaden ruht, unter welchen genug Raum fuer den einen oder "
        "anderen Schnack ist. In die noerdlichen Boegen ist eine Treppe "
        "eingearbeitet, man kann also auch nach oben."
        );
    
    SetProp(P_GEMA,({1,4,0}));
    
    AddDetail(({"xxx"}),"");

    seteuid(getuid(this_object()));
    Sky();
  
  
    AddExit("sueden",
        ([ EX_DEST: "./abgilde", 
           EX_PLMSG: "Du betrittst den kleinen Platz der Abenteurer.\n",
           EX_MSG: "nach Sueden zu den Abenteurern"]));
    AddExit("osten",
        ([ EX_DEST: "./dorfweg_so", 
           EX_PLMSG: "Du trittst auf den Dorfweg.\n",
           EX_MSG: "nach Osten auf den Dorfweg"]));
    AddExit("nordwesten",
        ([ EX_DEST: "./brunnenplatz", 
           EX_PLMSG: "Du trittst auf den Brunnenplatz.\n",
           EX_MSG: "nach Nordwesten auf den Brunnenplatz"]));
    AddExit("suedwesten",
        ([ EX_DEST: "./spassplatz", 
           EX_PLMSG: "Du gehst ins Vergnuegungsviertel.\n",
           EX_MSG: "nach Suedwesten ins Vergnuegungsviertel"]));
    AddExit("oben",
        ([ EX_DEST: "./campanile_og", 
           EX_PLMSG: "Du steigt die Stufen zum Gelaeute hinauf.\n",
           EX_MSG: "nach oben in unter das Gelaeute des Glockenturms"]));
 
    SetProp(P_HIDE_EXITS,({"oben"}));

}
