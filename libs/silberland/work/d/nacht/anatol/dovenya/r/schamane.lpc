/* Dovenya, beim Dorfaeltesten (Plural? Vielleicht spaeter)
 * _____________________________________(i) Anatol@Silberland (1998-2012) */


#pragma strict_types

#include "../defines.h"

inherit DOVENYA "std/room";


public void 
create() 
{
    ::create();

    SetProp(P_INDOORS,1);
    
    SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:23,
                            ENV_TERRAIN:TT_HOUSE,
                            ])); 

    SetProp(P_INT_SHORT,"Dovenya, Schamanenhuette");
    SetProp(P_INT_LONG,
        "Dorfschamane, Zauberer, Hexe... was auch immer. Diejenige "
        "Entitaet, die sich aus der oeffentlichen Machtausuebung heraushaelt "
        "und ein gewisses Haendchen fuer das Mystische hat, wird gemeinhin "
        "zur Dorfhexe... oder Zauberer. Oder Schamane."
        );
    
    SetProp(P_GEMA,({2,7,0}));
    
    AddDetail(({"xxx"}),"");

    seteuid(getuid(this_object()));
  
    AddExit("osten",
        ([ EX_DEST: "./verborgenerweg_w", 
           EX_PLMSG: "Du verlaesst die Schamanenhuette und gehst raus.\n",
           EX_MSG: "raus auf den Weg"
           ]));
 
    SetProp(P_HIDE_EXITS,({""}));

}
