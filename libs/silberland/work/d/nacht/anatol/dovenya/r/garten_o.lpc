/* Dovenya, Gaerten der Ruhe
 * _____________________________________(i) Anatol@Silberland (1998-2012) */

#pragma strict_types

#include "../defines.h"

inherit DOVENYA "std/garten";


public void 
create() 
{
    ::create();

    SetProp(P_INT_SHORT,"Dovenya, Gaerten");
    SetProp(P_INT_LONG,
        "Hier sieht es in etwa so aus wie ueberall in den Gaerten, nur "
        "dass hier keine Buesche und - mit Ausnahme einer Nachtzypresse - "
        "auch keine Baeume wachsen, sondern einfach nur sternenbeschienene "
        "Wiese. Westlich von Dir liegt der kleine See, oestlich ragt die "
        "schroffe Felswand nach oben und in nordoestlicher Richtung gelangst "
        "Du nach einige Metern dann doch zu einigen Baeumen und zwischen "
        "ihnen durch in das Leben der Siedlung zurueck.");
    Sky();
    SetProp(P_GEMA,({1,0}));
    AddDetail(({"wiese","boden","platz","umgebung"}),
        "Du stehst auf einer kleinen Wiese, wie ein grosser und weicher "
        "Teppich erstreckt sich die graeserne Pracht von der Felswand bis "
        "an den See. Noerdlich von Dir scheinen einige Blumen und Buesche "
        "zu wachsen, sued- bis suedwestlich geht es noch ein kleines "
        "Stueckchen weiter.");
    AddDetail(({"gaerten","garten"}), "Schau Dich ruhig um, Du stehst drin...");
    AddDetail(({"blumen","blume"}),
        "Hm, keine Blumen hier, schau mal weiter noerdlich nach.");
    AddDetail(({"stueckchen","stueck"}),
        "Sieht ganz danach aus, als ob dort hinten jemand etwas sein koennte, "
        "jedenfalls nimmst Du einen schwachen Lichtschein wahr, der durch ein "
        "paar in die Wiese hineinreichende Baeume durchschimmert.");
    AddDetail(({"schimmern","licht","lichtschein"}),
        "Sieht irgendwie geheimnisvoll aus. Ob sich nicht doch etwas... Boeses"
        "... in den Gaerten der Ruhe aufhalten koennte...?");
    AddDetail("boeses","Du glaubst eigentlich nicht dran.");
    AddDetail(({"buesche"}),
        "Direkt in Deiner naeheren Umgebung siehst Du eigentlich keine "
        "Buesche, doch im Norden wird die Wiese von einigen Bueschen "
        "gesprenkelt, und auch weiter suedlich scheint die Wiese von "
        "Dickicht und Bueschen " "abgegrenzt zu werden.");
    AddDetail("dickicht",
        "Von hier aus kannst Du keine Details ausmachen, Du glaubst aber, "
        "dass das Dickicht die Wiese davon abhaelt, die Klippen "
        "hinunterzufallen.");
    AddDetail(({"klippe","klippen"}), "Nichts zu sehen.");
    AddDetail("nichts","");
    AddDetail("details","Ja, haettest Du gerne :-)");
    AddDetail("baeume", "Hier steht nur ein einziger Baum. Weitere Baeume "
        "wachsen weiter suedlich oder noerdlich von hier.");
    AddDetail(({"baum","ausnahme"}),
        "Es handelt sich eindeutig um eine Nachtzypresse.");
    AddDetail(({"zypresse","nachtzypresse"}),
        "Uijeh, wie alt dieser Baum wohl sein mag? Mitten auf der Wiese "
        "steht eine grosse Nachtzypresse, ihr Stamm ist ziemlich verdreht und "
        "duerfte wohl an die zwanzig Fuss Umfang besitzen. Die Baumkrone, "
        "soweit Du das erkennen kannst, ist ziemlich dicht und "
        "undurchschaubar, dort oben koennten sich wohl zwei ausgewachsene "
        "Elefanten verstecken...");
    AddDetail("fuss","Du schaust unauffaellig an Dir hinunter.");
    AddDetail("umfang",
        "Oh wow, ob drei ausgewachsene Elfen diesen Baum umspannen "
        "koennten? Wird knapp.");
    AddDetail("elfen","Du bist in den Gaerten Dovenyas, rechne mal damit, dass "
        "es hier irgendwelche Elfen geben koennte...");
    AddDetail("baumkrone",
        "Die Baumkrone besitzt gewaltige Ausmasse, diese Nachtzypresse muss "
        "sehr viel Zeit gehabt haben, um so gross zu werden!");
    AddDetail("zeit", "Jemand wispert: Was ist Zeit?");
    AddDetail("ausmasse",
        "Riesig, dort oben koennte jemand ziemlich gut leben, ohne von hier "
        "unten bemerkt zu werden - und ohne sich um Platz sorgen zu muessen.");
    AddDetail(({"stamm","baumstamm","zypressenstamm"}),
        "Der Stamm der Zypresse ist ziemlich dick, was wirklich nicht weiter "
        "verwunderlich ist, schliesslich ist die Nachtzypresse selbst auch "
        "sehr gross, nicht zuletzt daran zu erkennen, dass man auf dem Teil "
        "der Wiese, der wegen der grossen Baumkrone im Schatten liegt, fuer "
        "ein Grossfamilienpicknick Platz finden koennte. Die Rinde ist "
        "ansonsten ziemlich zerfurcht und rissig - und sieht SEHR alt aus.");
    AddDetail(({"elefant","elefanten"}),
        "Ok, wenn da noch 'rosa' hinzukommt,...");
    AddSpecialDetail(({"rosa elefant","rosa elefanten"}),"detailElefant");
    AddDetail("rinde",
        "Die Rinde sieht - fuer eine uralte Nachtzypresse eben - normal aus, "
        "furchtbar zerfurcht und rissig.");
    AddDetail(({"picknick","grossfamilie","grossfamilienpicknick"}),
        "...Zur Zeit gibt es hier nichts zu picknicken.");
    AddDetail(({"riss","risse"}),
        "An den Rissen im Stamm der Zypresse kannst Du nichts besonderes ent"
        "decken, sie sind zwar zahlreichst, aber nicht tief oder breit genug, "
        "um etwas versteckt halten zu koennen.");
    AddDetail(({"furche","furchen"}),
        "Die Furchen in der Rinde des Zypressenstamms sind ziemlich tief und "
        "lang, und koennte fuer eine ganze Horde Kleingetier Behausungen "
        "bieten. Du koenntest ja mal in eine der Furchen greifen, solange Du "
        "Dich nicht beschwehrst, wenn Dich etwas beisst.");
    AddDetail(({"meter"}),
        "Ein Meter ist etwas mehr als ein halber Elfendoppelschritts.");
    
    AddDetail("elfendoppelschritt",
        "Das sind etwa zwei Meter.");
    AddDetail(({"horde","kleingetier"}),
        "Hm, nichts zu sehen, aber... was heisst das schon?");
    AddDetail("behausungen","Naja, die Furchen sind so tief, da kann alles "
        "moegliche darin hausen. Nein, Du willst es nicht wissen, was genau "
        "das sein koennte...");
    AddDetail("alles moegliche","DU WILLST ES NICHT WISSEN. WIRKLICH NICHT.\n"
        "(Anmerkung: Magier haben immer recht.)\n");
    AddDetail("magier","Die Gaerten wurden von einem Magier erschaffen. "
        "Ist aber schon laenger her.");
    AddDetail("wort","Argh.");
    AddDetail(({"fels","wand","felswand"}),
        "Die Felswand erstreckt sich ins Unendliche nach oben und zu den "
        "Seiten."
        " Zumindest kommt es Dir im ersten Moment so vor, Du kannst naemlich "
        "von hier aus nicht erkennen, ob und wo der Fels endet. Die Felswand "
        "ist alles andere als aalglatt, doch reichen die Spalten und Fugen an "
        "dieser Stelle vermutlich nicht aus, um ein Hochklettern moeglich zu "
            "machen.");
    AddDetail("stelle",
        "Hier? Hochklettern? Selbst der Versuch duerfte schmerzhaft sein...");
    AddDetail(({"spalte","spalten","fuge","fugen"}),
        "Hm, diese Fugen und Spalten sehen nicht gerade vertrauenserweckend "
        "aus."
        " Du kannst natuerlich versuchen, an der Felswand hochzuklettern, aber "
        "selbst wenn Du sehr vorsichtig bist, wirst Du vermutlich nur wieder "
        "herunterpurzeln und Dich verletzen.");
    AddDetail("hochklettern",
        "Versuch's besser nicht.");
    AddDetail("meldung","124 312 122 314 212 111 123 321 123 333 124 413 123");
    AddDetail("moment", "Vorbei.");
    AddDetail(({"stille","laut","ruhe"}),
        "Die Ruhe der Gaerten ist heilig, kein unnuetzer Laut stoert die "
        "Stille.");
    AddDetail(({"unendliche","unendlichkeit"}),
        "Das wuerde den hier ueblichen Rahmen sprengen.");
    AddDetail(({"richtung","richtungen"}),
        "In noerdlicher und nordwestlicher Richtung gelangst Du in den... "
        "\"bunteren\" Teil der Gaerten. Irgendwo dort fuehrt bestimmt auch "
        "ein Weg in die Siedlung. "
        "Westlich von Dir liegt der See, oestlich weist Dich eine schroffe "
        "Felswand in Deine Schranken. In suedwestlicher Richtung geht es noch "
        "ein kleines Stueck weiter.");
    AddDetail("weg",
        "Hier ist kein Weg zu sehen - eventuell weiter noerdlich.");
    AddSpecialDetail(({"rahmen","schranke","schranken"}),"detailSchranke");
    AddDetail("teil","Du bist anscheinend im schlichteren Teil der Gaerten."
        "Wobei man sagen muss, dass die Nachtzypresse natuerlich schon "
        "imponiert.");
    AddDetail(({"leben"}),
        "Das Leben ist schoen, und hier ist es ausserdem recht ruhig...");
    AddDetail(({"trubel","siedlung","dovenya","nachtelfensiedlung"}),
        "Die Gaerten gehoeren rein theoretisch noch zur Siedlung, doch vom "
        "Trubel "
        "ist hier ueberhaupt nichts mehr zu spueren, dies ist einfach ein "
        "ruhiger Garten, der dazu einlaed, Gedanken treiben zu lassen - oder "
        "sich selbst, im See naemlich.");
    AddDetail(({"gras","teppich","grasteppich"}),
        "Das Gras waechst hier dicht und blumenlos, wenn hier die Sonne "
        "scheinen wuerde, waere es die ideale Liegewiese am See.");
    AddDetail("liegewiese",
        "Macht irgendwie nicht viel Sinn, so ohne Sonne, oder?");
    AddSpecialDetail("sonne","detailSonne");
    AddDetail("beunruhigung","Beunruhigend, nicht?");
    AddDetail("sinn","Wirklich, Du siehst darin keinen Sinn.");
    AddDetail("seiten","Die schroffe Felswand scheint sich schier unendlich "
        "nach Suedwesten und Nordosten zu erstrecken.");
    AddDetail("pracht",
        "Das Gras scheint hier ziemlich gut zu gedeihen, geradezu prachtvoll.");
    AddDetail("metapher","Sowas kann man nicht untersuchen");
    AddDetail("untersuchen","Du untersuchst Dich beim Untersuchen. Super.");
    AddDetail("gedanken","Du solltest mal auf andere kommen.");
    AddDetail("versuch","Ueberlege es Dir gut...");
    AddDetail("magierwillkuer",
        "Ach komm, sowas gibt es doch nur im Maerchen! :)");
    AddDetail("maerchen",
        ">> Es war einmal, vor langer, langer Zeit, da lebte ein verzauberter "
        "Karpfen in den wilden Wuestenwaeldern des Silberlands, doch sein Herz"
        " war von Kummer erfuellt: Seine einzige Tochter, eine langstilige "
        "Sumpfwadenwickelkroete, war schon seit Stunden im Alter einer Witwe, "
        "doch ihr angetrauter Ehemann, Z'nkr'k, der siebeneinhalbaeugige Herr"
        "scher ueber alle gruenen Sandkoerner, weigerte sich, zu sterben. "
        "So blieb dem Karpfen nichts anderes uebrig, als seine Tochter, die "
        "langstilige Sumpfwadenwickelkroete, durch eigene Flosse zur Witwe zu "
        "machen und so vergiftete der verzauberte "
        "Karpfen sein Schwiegeretwas, "
        "Z'nkr'k, mit einem vergifteten Krapfen. Als der siebeneinhalbaeugige "
        "Herrscher mit dem vergifteten Krapfen des Karpfen im Kropf kritische "
        "Blicke seiner angetrauten langstiligen Sumpfwadenwickelkroete zuwarf "
        "und ein grausames und schwer "
        "verletzendes \"Du!\" kraechzte, beschloss "
        "der Maerchenerzaehler, sich in seine Feder zu stuerzen und ertrank "
        "in der gelbblauen Tinte seines Tintenbeutels. Wie durch ein Wunder "
        "wurde der Bann ueber den verzauberten Karpfen geloest und er ward "
        "ploetzlich kein verzauberter Karpfen mehr! Doch in den wilden "
        "Wuestenwaeldern ist kein Platz fuer unverzauberte Karpfen und so "
        "haute die langstilige Sumpfwadenwickelkroete ihren karpfigen Vater "
        "mit einem PLATSCH in die Pfanne und verspeiste ihn mit sichtlichem "
        "Genuss. Und wenn sie nicht an einem zu heissen Wadenwickel gestorben "
        "waere, so wuerde sie heute noch leben. <<\nDir "
        "wird ploetzlich uebel.");
    AddSound("lachen",
        "Ja, da hat doch jemand gelacht. Es klang ganz nach einem Maedchen "
        "oder einer jungen Frau nachtelfischer Abstammung... irgendwo "
        "aus suedwestlicher Richtung.");
    AddDetail("aufblitzen",
        "Das Aufblitzen war nur ganz kurz (sonst waer es ja ... eben). "
        "Koennte aber aus suedwestlicher Richtung gekommen sein.");
    AddDetail("maedchen", "Humm... Du siehst hier kein Maedchen.");
    AddDetail("frau", "Ja, wenn's so einfach waer!");
    AddDetail("abstammung","Abstammung wird allgemein ueberbewertet.");
    AddDetail(({"karpfen","wuestenwald","wuestenwaelder","silberland","herz",
        "kummer","tochter","sumpfwadenwickelkroete", "kroete", "witwe",
        "ehemann","z'nkr'k","herrscher","sandkorn","sandkoerner","flosse",
        "schwiegeretwas","krapfen","kropf","maerchenerzaehler","feder","tinte",
        "wunder","bann","pfanne","alter","blicke","es","genuss", "nicht",
        "platsch","sehr","stunden","tintenbeutel","vater","wadenwickel"
        }),

        "Du hast quasi sofort vergessen, warum Du Dir das naeher ansehen "
        "wolltest.");
    AddSpecialDetail("schatten","detailSchatten");
    seteuid(getuid(this_object()));
    AddExit("nordwesten","./garten_n");
    AddExit("norden","./garten_no");
    AddExit("suedwesten","./garten_s");
    AddExit("westen",([EX_FUNC:#'seeExitTestfunc]));
    AddExit("nordosten",
            ([ EX_DEST: "./sackgasse", 
            EX_PLMSG: "Du quetschst Dich durch das Dickicht in die Siedlung.\n",
            EX_MSG: "auf einem kleinen Pfad nach Nordosten in die Siedlung"]));
    SetStupids(({"willst","wissen"}));
    SetProp(P_HIDE_EXITS,({"nordosten","westen"}));
    SetProp(P_ARTICLE,0);
    SetProp(P_KILL_NAME,"Ein Kletterversuch");
    AddCmd(({"kletter","klettere"}),"cmdKlettere");
    AddCmd(({"greif","greife"}),"cmdGreife");
    AddRoomMessage( ({
      "Ein froehliches Lachen dringt leise zu Dir.\n",
      "War da nicht ein kurzes Aufblitzen eines Lichts?\n"}),1200);
}

nosave int 
cmdGreife(string str) 
{
    string * msg;
    
    if (!this_player())
        return 0;
    notify_fail("Willst Du wo hineingreifen?\n");
    if ( (!str) || (str=="")) 
        return 0;

    if (str=="in furche") 
    { /* Explizite Syntax */
        msg=({
            "Nichts geschieht.",
            "Dich kitzelt etwas an den Fingerspitzen.",
            "Da hat doch was geknabbert?",
            "Du hoerst ein Rascheln und ziehst schnell die Hand zurueck.",
            "Du greifst in die Furche - leer.",
            "Du... hast keine Lust mehr.",
            "Mutig greifst Du in eine Furche und mutig beisst Dich "
            "irgendetwas tapfer in die Fingerspitzen. Naja, tat ja fast "
            "nicht weh..."});
        this_player()->Message(break_string(msg[(random(sizeof(msg)))],77));
        Message((break_string(sprintf(
            "%s fummelt unmotiviert am Stamm der Zypresse herum.",
            this_player()->Name(WER)),77)),MSGFLAG_NO_TP|MSGFLAG_VISUAL);
        return 1;
    }
    else 
        return 0;
}

nosave int 
cmdKlettere(string str) 
{
    string s1, s2, s3;
    int mlp, vs;

    notify_fail("Was wie woran wohin willst Du klettern?\nVielleicht... "
       "\"klettere an felswand hoch\"?\nBist Du Dir da auch sicher?\n");

    if (((!str)||(str==""))||(!this_player())) 
        return 0;

    if (sizeof(regexp(({str}),
        "(an |)(felswand|wand|fels)( hoch| rauf| hinauf|)")))
    {
        mlp=(int)this_player()->QueryProp(P_MAX_HP);
        vs=(int)this_player()->QueryProp(P_WIMPY);
        if ((!vs) || (((vs*100)/mlp)<80)) 
        {
            this_player()->Message("Du bist nicht vorsichtig genug und "
                "rutschst sofort wieder ab.\n");
            Message(break_string(this_player()->Name()+" versucht, "
                "an der Felswand hochzuklettern, rutscht aber sofort wieder "
                "ab. Da geht es nicht hoch, das faellt Dir sofort auf.", 77),
                MSGFLAG_NO_TP);
            this_player()->reduce_hit_point(random(5)+2);
        }
        else 
        {
            this_player()->Message(break_string("Du beginnst sehr vorsichtig, "
                "an der Felswand hochzuklettern, hast jedoch keine Chance, "
                "weiter als zwei Meter nach oben zu gelangen und schlaegst, "
                "durch das Gras gedaempft aber dennoch schmerzhaft, auf der "
                "Wiese auf. Da geht es nicht weiter, dessen bist Du Dir jetzt "
                "sicher.",77));
            Message(break_string(this_player()->Name(WER)+" versucht, "
                "an der Felswand hochzuklettern, kommt auch ein ganzes Stueck "
                "nach oben - nur um dann mit einem schmerzlichen Pardauz "
                "wieder auf der Wiese aufzuschlagen. Au, au, au...",77),
                MSGFLAG_NO_TP);
            this_player()->do_damage(1);
            this_player()->reduce_hit_point(random(10)+5);
        }
        return 1;
    }
    else if (sizeof(regexp(({str}),
    "(an|auf|)(baum|zypresse|nachtzypresse)( nach oben| hoch| rauf| hinauf|)"
        )))
    {

        if ((catch(vs=(int)call_other(ROOM "zypresse",
            "PreventInsert",this_player())))||
            (vs) || (!interactive(this_player())))
            this_player()->Message("Du traust Dich nicht.\n");
        else 
        { 
            write(
                "Mutig kletterst Du am Stamm der Nachtzypresse nach oben.\n");
            this_player()->move(ROOM "zypresse",M_GO,0,
                "ist ploetzlich nicht mehr da","kommt raufgeklettert");
        }
        return 1;
    }
    else 
        return 0;
}

nosave string 
detailSchranke() 
{
    if (this_player()) 
        this_player()->reduce_hit_point(5);
    return 
        break_string("Urploetzliche Magierwillkuer bestraft Dich mit dem "
            "Abzug von 5 (in Worten: fuenf) Lebenspunkten fuer das "
            "Untersuchen einer Metapher.",77);
}

nosave string 
detailSonne() 
{
    if (!this_player()) return "";
        Message(break_string(sprintf(
            "%s schaut angestrengt in den Himmel und murmelt "
            "leise 'Sonne, wo ist die "
            "Sonne, irgendwo muss die Sonne doch sein...' vor sich hin.\n",
        this_player()->Name(WER)),77),MSGFLAG_VISUAL|MSGFLAG_NO_TP);
    return
        "Du suchst mit steigender Beunruhigung den Himmel ab, findest aber "
        "irgendwie\nkeine Sonne. Das kann nicht sein, irgendwo "
        "muss sie doch...!\n";
}

nosave string 
detailElefant() 
{
    if (!this_player()) return "";
    Message(break_string(sprintf(
        "Ploetzlich beginnt %s, wie vom wilden Affen gebissen im Kreis "
        "herumzuspringen und zu grunzen wie ein Stachelschwein beim "
        "Almabtrieb. "
        "Du wirst das Gefuehl nicht los, dass %s ein ernsthaftes Problem mit "
        "gewissen Substanzen hat - oder zumindest mit %s Verstand.",
        this_player()->name(WER),this_player()->QueryPronoun(WER),
        this_player()->QueryPossPronoun(MALE,WEM,SINGULAR)),77),
        MSGFLAG_VISUAL|MSGFLAG_NO_TP);
    return  
        "\nBalla balla dongelong?\n"
        "                              Hoddeldoddel?\n"
        "      Noddelbuddel hugadaga?\n\n     Somawanga diddelbanga?     "
        "Glibber jibber\n                                  Dibber libber!!\n"
        "\nAga.\n";
}

nosave string 
detailSchatten() 
{
    int i;

    if (!this_player()) 
        return "";
    if (catch(i=(int)call_other(ROOM "zypresse","PreventInsert",
        this_player())))
    return 
        "Der Schatten sieht wie ein ziemlich grosser B U G aus.\n";
    if (!i) return 
        "Der Schatten der Zypresse sieht wie ein gewoehnlicher Schatten "
        "eines\ngewoehnlichen Baumes aus. Nur groesser.\n";
    else return 
        "Der Schatten der Zypresse sieht geheimnisvoll und hochmagisch aus.\n";
}
