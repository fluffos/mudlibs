/* Dovenya, vor dem Archiv
 * _____________________________________(i) Anatol@Silberland (1998-2012) */


#pragma strict_types

#include "../defines.h"

inherit DOVENYA "std/room";


public void 
create() 
{
    ::create();

    SetProp(P_INDOORS,1);
    
    SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:23,
                            ENV_TERRAIN:TT_CAVE,
                            ])); 

    SetProp(P_INT_SHORT,"Dovenya, Archiv");
    SetProp(P_INT_LONG,
        "Das Archiv. Wie es hier aussieht, ist noch nicht ganz klar. "
        );
    
    SetProp(P_GEMA,({6,3,0}));
    
    AddDetail(({"xxx"}),"");

    seteuid(getuid(this_object()));
  
    AddExit("nordwesten",
        ([ EX_DEST: "./archiv_vorplatz", 
           EX_PLMSG: "Du verlaesst das Archiv.\n",
           EX_MSG: "nach Nordwesten raus"]));
 
    AddExit("suedwesten",
        ([ EX_DEST: "./archiv_hinten", 
           EX_FUNC: "roomNotYetImplemented",
           EX_PLMSG: "Du betrittst den Hauptraum des Archivs.\n",
           EX_MSG: "nach Suedwesten in den Hauptraum"
               ]));

    SetProp(P_HIDE_EXITS,({""}));

}
