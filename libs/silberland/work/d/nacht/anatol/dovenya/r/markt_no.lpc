/* Dovenya, Marktplatz
 * _____________________________________(i) Anatol@Silberland (1998-2012) */


#pragma strict_types

#include "../defines.h"

inherit DOVENYA "std/room";


public void 
create() 
{
    ::create();

    SetProp(P_INDOORS,0);
    
    SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:23,
                            ENV_TERRAIN:TT_TOWN,
                            ])); 

    SetProp(P_INT_SHORT,"Dovenya, Marktplatz");
    SetProp(P_INT_LONG,
        "Die nordoestliche Ecke des Marktplatzes. Nach Norden geht es den "
        "Klippenweg entlang, der Marktplatz selbst erstreckt sich nach "
        "Westen und Suedwesten."
        );
    
    SetProp(P_GEMA,({4,3,0}));
    
    AddDetail(({"xxx"}),"");

    seteuid(getuid(this_object()));
    Sky();
  
    AddExit("suedwesten",
        ([ EX_DEST: "./markt_s", 
           EX_PLMSG: "Du begibst Dich in die suedliche "
           "Ecke des Marktplatzes.\n",
           EX_MSG: "in die suedliche Ecke des Marktplatzes"]));
    AddExit("westen",
        ([ EX_DEST: "./markt_n", 
           EX_PLMSG: "Du begibst Dich in die nordwestliche "
           "Ecke des Marktplatzes.\n",
           EX_MSG: "in die oestliche Ecke des Marktplatzes"]));
    AddExit("norden",
        ([ EX_DEST: "./klippenweg_1",
           EX_PLMSG: "Du verlaesst den Markt und gehst "
           "den Klippenweg entlang.\n",
           EX_MSG: "ueber den Klippenweg nach Norden"]));
    SetProp(P_HIDE_EXITS,({""}));

}
