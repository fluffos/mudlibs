/* Dovenya, Klippenweg 
 * _____________________________________(i) Anatol@Silberland (1998-2012) */


#pragma strict_types

#include "../defines.h"

inherit DOVENYA "std/room";


public void 
create() 
{
    ::create();

    SetProp(P_INDOORS,0);
    
    SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:23,
                            ENV_TERRAIN:TT_TOWN,
                            ])); 

    SetProp(P_INT_SHORT,"Dovenya, Klippenweg");
    SetProp(P_INT_LONG,
        "Der Klippenweg vollzieht einen deutlichen Knick. In oestlicher "
        "Richtung geht es zur Kante des Sattels, im Sueden liegt das Dorf. "
        "Das Gebuesch im Nordwesten steht zumindest an einer Stelle licht "
        "genug, um dazwischen durchzugehen."
        );
    
    SetProp(P_GEMA,({5,6,0}));
    
    AddDetail(({"xxx"}),"");

    seteuid(getuid(this_object()));
    Sky();
  
  
    AddExit("nordwesten",
        ([ EX_DEST: "./verborgenerweg_o", 
           EX_PLMSG: "Du trittst durch das Gebuesch.\n",
           EX_MSG: "durch das Gebuesch auf einen offenbar verborgenen Weg"]));
 
    AddExit("osten",
        ([ EX_DEST: "./klippenweg_4", 
           EX_PLMSG: "Du folgst dem Klippenweg nach Osten.\n",
           EX_MSG: "den Klippenweg entlang nach Osten"
               ]));

    AddExit("sueden",
        ([ EX_DEST: "./klippenweg_2", 
           EX_PLMSG: "Du folgst dem Klippenweg nach Sueden.\n",
           EX_MSG: "den Klippenweg entlang nach Sueden"
               ]));

    SetProp(P_HIDE_EXITS,({"nordwesten"}));

}
