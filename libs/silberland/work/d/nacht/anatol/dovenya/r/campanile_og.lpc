#pragma strict_types

#include "../defines.h"

inherit DOVENYA "std/room";


public void 
create() 
{
    ::create();

    SetProp(P_INDOORS,1);
    
    SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:23,
                            ENV_TERRAIN:TT_TOWN,
                            ])); 

    SetProp(P_INT_SHORT,"Dovenya, Campanile (oben)");
    SetProp(P_INT_LONG,
        "Direkt unter dem Gelaeute (noch, mal sehen)."
        " Man kann wieder runter. Immerhin."
        );
    
    SetProp(P_GEMA,({1,4,0}));
    
    AddDetail(({"xxx"}),"");

    seteuid(getuid(this_object()));
    Sky();
  
  
    AddExit("unten",
        ([ EX_DEST: "./campanile_eg", 
           EX_PLMSG: "Du steigt die Stufen zu ebener Erde hinunter.\n",
           EX_MSG: "hinunter"]));
 
    SetProp(P_HIDE_EXITS,({""}));

}
