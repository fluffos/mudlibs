/* Dovenya, Klippenweg 
 * _____________________________________(i) Anatol@Silberland (1998-2012) */


#pragma strict_types

#include "../defines.h"

inherit DOVENYA "std/room";


public void 
create() 
{
    ::create();

    SetProp(P_INDOORS,0);
    
    SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:23,
                            ENV_TERRAIN:TT_TOWN,
                            ])); 

    SetProp(P_INT_SHORT,"Dovenya, ein verborgener Weg");
    SetProp(P_INT_LONG,
        "Dieser Weg hat keinen Namen und ist etwas verborgen (aber immerhin "
        "auf der Karte eingezeichnet). Im Suedosten liegt der Klippenweg, "
        "der durch das Gebuesch sicher gut zu erreichen ist - von hier ist "
        "der Durchgang gut zu erkennen. Weiter im "
        "Westen fuehrt der Weg zu einer Huette."
        );
    
    SetProp(P_GEMA,({4,7,0}));
    
    AddDetail(({"xxx"}),"");

    seteuid(getuid(this_object()));
    Sky();
  
  
    AddExit("suedosten",
        ([ EX_DEST: "./klippenweg_3", 
           EX_PLMSG: "Du trittst durch das Gebuesch auf den Klippenweg.\n",
           EX_MSG: "durch das Gebuesch auf einen den Klippenweg"]));
 
    AddExit("westen",
        ([ EX_DEST: "./verborgenerweg_w",
           EX_PLMSG: "Du folgst dem Weg zu einer Huette.\n",
           EX_MSG: "nach Westen zur Huette"
               ]));

    SetProp(P_HIDE_EXITS,({""}));

}
