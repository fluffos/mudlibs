/* Dovenya, Klippenweg 
 * _____________________________________(i) Anatol@Silberland (1998-2012) */


#pragma strict_types

#include "../defines.h"

inherit DOVENYA "std/room";


public void 
create() 
{
    ::create();

    SetProp(P_INDOORS,0);
    
    SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:23,
                            ENV_TERRAIN:TT_TOWN,
                            ])); 

    SetProp(P_INT_SHORT,"Dovenya, ein verborgener Weg");
    SetProp(P_INT_LONG,
        "Dieser Weg hat keinen Namen und endet hier vor einer Huette."
        );
    
    SetProp(P_GEMA,({3,7,0}));
    
    AddDetail(({"xxx"}),"");

    seteuid(getuid(this_object()));
    Sky();
  
  
    AddExit("osten",
        ([ EX_DEST: "./verborgenerweg_o", 
           EX_PLMSG: "Du trittst durch das Gebuesch auf den Klippenweg.\n",
           EX_MSG: "durch das Gebuesch auf einen den Klippenweg"]));
 
    AddExit("westen",
        ([ EX_DEST: "./schamane",
           EX_PLMSG: "Du betrittst die Huette.\n",
           EX_MSG: "nach Westen in die Huette"
               ]));

    SetProp(P_HIDE_EXITS,({"westen"}));

}
