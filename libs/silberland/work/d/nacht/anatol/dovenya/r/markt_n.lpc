/* Dovenya, Marktplatz
 * _____________________________________(i) Anatol@Silberland (1998-2012) */

#pragma strict_types
#include "../defines.h"

inherit DOVENYA "std/room";


public void 
create() 
{
    ::create();

    SetProp(P_INDOORS,0);
    
    SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:23,
                            ENV_TERRAIN:TT_TOWN,
                            ])); 

    SetProp(P_INT_SHORT,"Dovenya, Marktplatz");
    SetProp(P_INT_LONG,
        "Die noerdliche Ecke des Marktplatzes. Nach Norden geht es in die "
        "Schmiede, im Westen ist ein verrammelter Eingang. Der Marktplatz "
        "erstreckt sich in suedlicher und oestlicher Richtung und nach "
        "Nordwesten fuehrt der Dorfweg ab."
        );
    
    SetProp(P_GEMA,({3,3,0}));
    
    AddDetail(({"xxx"}),"");

    seteuid(getuid(this_object()));
    Sky();
  
     
    AddExit("sueden",
        ([ EX_DEST: "./markt_s", 
           EX_PLMSG: "Du begibst Dich in die suedliche "
           "Ecke des Marktplatzes.\n",
           EX_MSG: "in die suedliche Ecke des Marktplatzes"]));
    AddExit("osten",
        ([ EX_DEST: "./markt_no", 
           EX_PLMSG: "Du begibst Dich in die nordoestliche "
           "Ecke des Marktplatzes.\n",
           EX_MSG: "in die oestliche Ecke des Marktplatzes"]));
    AddExit("nordwesten",
        ([ EX_DEST: "./dorfweg_so", 
           EX_PLMSG: "Du verlaesst den Markt und gehst den Dorfweg entlang.\n",
           EX_MSG: "ueber den Dorfweg nach Nordwesten"]));
    AddExit("norden",
        ([ EX_DEST: "./schmiede", 
           EX_FUNC: "roomNotYetImplemented" ,  // NYA
           EX_PLMSG: "Du betrittst die Schmiede.\n",
           EX_MSG: "in die Schmiede"]));
    AddExit("westen",
        ([ EX_DEST: "irgendwohin", 
           EX_FUNC: "roomNotYetImplemented" ]));
    
    SetProp(P_HIDE_EXITS,({"westen","norden"}));

}


