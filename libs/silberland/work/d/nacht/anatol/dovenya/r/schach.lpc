#pragma strict_types

#include "../defines.h"

inherit DOVENYA "std/room";


public void 
create() 
{
    ::create();

    SetProp(P_INDOORS,1);
    
    SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:23,
                            ENV_TERRAIN:TT_HOUSE,
                            ])); 

    SetProp(P_INT_SHORT,"Dovenya, Hinterzimmer der Schenke");
    SetProp(P_INT_LONG,
        "Das Hinterzimmer der Dorfschenke ist... erstaunlich ruhig. Passt."
        );
    
    SetProp(P_GEMA,({-1,2,0}));
    
    AddDetail(({"xxx"}),"");

    seteuid(getuid(this_object()));
  
    AddExit("vorne",
        ([ EX_DEST: "./kneipe", 
           EX_PLMSG: "Du verlaesst das Hinterzimmer und gehst in "
           "den Schankraum.\n",
           EX_MSG: "nach vorn in den Schankraum"]));

    SetProp(P_HIDE_EXITS,({""}));

    AddItem("/d/ebene/anatol/p/chess/chess",REFRESH_DESTRUCT);

}
