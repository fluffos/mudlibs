/* Dovenya, Marktplatz
 * _____________________________________(i) Anatol@Silberland (1998-2012) */

#pragma strict_types
#include "../defines.h"

inherit DOVENYA "std/room";


public void 
create() 
{
    ::create();

    SetProp(P_INDOORS,0);
    
    SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:23,
                            ENV_TERRAIN:TT_TOWN,
                            ])); 

    SetProp(P_INT_SHORT,"Dovenya, Marktplatz");
    SetProp(P_INT_LONG,
        "Die suedliche Ecke des Marktplatzes. Nach Suedwesten fuehrt ein "
        "kleiner Weg ab, der eigentlich in die Gaerten leiten sollte, aber "
        "augenscheinlich in einer Sackgasse endet. Ein Gemischtwarenladen "
        "ist in westlicher Richtung betretbar, der Marktplatz erstreckt sich "
        "indes in noerdlicher bzw. nordoestlicher Richtung."
        );
    
    SetProp(P_GEMA,({3,2,0}));
    
    AddDetail(({"xxx"}),"");

    seteuid(getuid(this_object()));
    Sky();
  
     
    AddExit("norden",
        ([ EX_DEST: "./markt_n", 
           EX_PLMSG: "Du begibst Dich in die nordwestliche "
           "Ecke des Marktplatzes.\n",
           EX_MSG: "in die nordwestliche Ecke des Marktplatzes"]));
    AddExit("nordosten",
        ([ EX_DEST: "./markt_no", 
           EX_PLMSG: "Du begibst Dich in die nordoestliche "
           "Ecke des Marktplatzes.\n",
           EX_MSG: "in die nordoestliche Ecke des Marktplatzes"]));
    AddExit("suedwesten",
        ([ EX_DEST: "./sackgasse", 
           EX_PLMSG: "Du verlaesst den Marktplatz in Richtung Gaerten.\n",
           EX_MSG: "zu den Gaerten Dovenyas"]));
    AddExit("westen",
        ([ EX_DEST: "./gemischtwaren", 
           EX_FUNC: "roomNotYetImplemented" ,  // NYA
           EX_PLMSG: "Du betrittst den Gemischtwarenladen.\n",
           EX_MSG: "nach Westen in den Gemischtwarenladen"]));
    
    SetProp(P_HIDE_EXITS,({"westen"}));

}

