/* Dovenya, beim Dorfaeltesten (Plural? Vielleicht spaeter)
 * _____________________________________(i) Anatol@Silberland (1998-2012) */


#pragma strict_types

#include "../defines.h"

inherit DOVENYA "std/room";


public void 
create() 
{
    ::create();

    SetProp(P_INDOORS,1);
    
    SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:23,
                            ENV_TERRAIN:TT_HOUSE,
                            ])); 

    SetProp(P_INT_SHORT,"Dovenya, beim Dorfaeltesten");
    SetProp(P_INT_LONG,
        "Ein Skelettraum, irgendwie sollte sich mal jemand darum kuemmern "
        "und reinschreiben, was hier sein soll..."
        );
    
    SetProp(P_GEMA,({1,6,0}));
    
    AddDetail(({"xxx"}),"");

    seteuid(getuid(this_object()));
  
    AddExit("suedwesten",
        ([ EX_DEST: "./brunnenplatz", 
           EX_PLMSG: "Du verlaesst das Domizil und gehst raus "
               "auf den Brunnenplatz.\n",
           EX_MSG: "raus auf den Brunnenplatz"]));
 
    SetProp(P_HIDE_EXITS,({""}));

}
