#pragma strict_types

#include "../defines.h"

inherit DOVENYA "std/room";


public void 
create() 
{
    ::create();

    SetProp(P_INDOORS,0);
    
    SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:23,
                            ENV_TERRAIN:TT_TOWN,
                            ])); 

    SetProp(P_INT_SHORT,"Dovenya, <fehlt>");
    SetProp(P_INT_LONG,
        "Ein Skelettraum, irgendwie sollte sich mal jemand darum kuemmern "
        "und reinschreiben, was hier sein soll..."
        );
    
    SetProp(P_GEMA,({2,1,0}));
    
    AddDetail(({"xxx"}),"");

    seteuid(getuid(this_object()));
    Sky();
  
  /*
    AddExit("nordosten",
        ([ EX_DEST: "./markt_s", 
           EX_PLMSG: "Du gehst auf den Marktplatz.\n",
           EX_MSG: "auf den Marktplatz"]));
  */
    SetProp(P_HIDE_EXITS,({""}));

}
