/* Dovenya, Klippenweg (suedliches Ende)
 * _____________________________________(i) Anatol@Silberland (1998-2012) */


#pragma strict_types

#include "../defines.h"

inherit DOVENYA "std/room";


public void 
create() 
{
    ::create();

    SetProp(P_INDOORS,0);
    
    SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:23,
                            ENV_TERRAIN:TT_TOWN,
                            ])); 

    SetProp(P_INT_SHORT,"Dovenya, Klippenweg");
    SetProp(P_INT_LONG,
        "Der Klippenweg muendet suedlich von hier in den Markt. Im "
        "Nordwesten liegt das Wohngebiet. Richtung Norden fuehrt der "
        "Weg von der Siedlung weg. Oestlich von hier liegen die "
        "Tore des Archivs."
        );
    
    SetProp(P_GEMA,({4,4,0}));
    
    AddDetail(({"xxx"}),"");

    seteuid(getuid(this_object()));
    Sky();
  
  
    AddExit("sueden",
        ([ EX_DEST: "./markt_n", 
           EX_PLMSG: "Du gehst den Weg entlang auf den Marktplatz.\n",
           EX_MSG: "den Weg entlang auf den Marktplatz"]));
 
    AddExit("osten",
        ([ EX_DEST: "./archiv_vorplatz", 
           EX_PLMSG: "Du trittst nach Osten vor die Tore des Archivs.\n",
           EX_MSG: "nach Osten vor die Tore des Archivs"
               ]));

    AddExit("nordwesten",
        ([ EX_DEST: "./wohngebiet", 
           EX_PLMSG: "Du verlaesst den Kippenweg und begibst "
              "Dich ins Wohngebiet.\n",
           EX_MSG: "nach Nordwesten ins Wohngebiet"
               ]));

    AddExit("nordosten",
        ([ EX_DEST: "./klippenweg_2", 
           EX_PLMSG: "Du folgst dem Klippenweg nach Nordosten.\n",
           EX_MSG: "den Klippenweg entlang nach Nordosten"
               ]));

    SetProp(P_HIDE_EXITS,({""}));

}
