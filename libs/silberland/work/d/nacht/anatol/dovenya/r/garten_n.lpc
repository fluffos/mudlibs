#pragma strict_types

#include "../defines.h"

inherit DOVENYA "std/garten";

#define KUCKUCKLOG   LOG "kuckuck.log"
private nosave int rosen;
private nosave int schluckse;

public void 
create() 
{
    ::create();
    rosen=1;
    schluckse=4;
    SetProp(P_INT_SHORT,"Dovenya, Gaerten");
    SetProp(P_INT_LONG,
        "Im noerdlichen Teil der Gaerten dominieren zunehmend "
        "kleine Straeucher und Buesche das Bild. Die Ruhe der "
        "Gaerten ist auch hier gegenwaertig; die nahe Siedlung "
        "dringt in Licht und Laut nicht in den Park. Im Sueden "
        "liegt der kleine See, nebenverhangen und still, links "
        "und rechts davon reichen die Gaerten noch etwas weiter, wobei "
        "zu letzterer Seite - also gen Westen - die nahen Klippen "
        "eine weitere Ausdehnung der Gaerten begrenzen.");
    AddSmell(DEFAULT_SMELL,
        "Es riecht geheimnissvoll und herb, moeglicherweise liegt "
        "das an den seltsamen Bueschen.");
    AddSmell(({"buesche","goldblatttabakkuckuckskraut","busch"}),
        "Huh, das riecht aber seltsam.");

    AddSound(DEFAULT_SOUND,
        "Es ist sehr still hier.");


    AddDetail("seite",
        "Wenn Du auf den See schaust, ist die westliche Seite rechts.");
    AddDetail(({"ruhe","laut"}),
        "Es ist sehr still hier...");
    AddDetail("ausdehnung",
        "Die Gaerten sind gar nicht mal so klein, gemessen an der "
        "Groesse der Siedlung. Es scheint, als ob Nachtelfen "
        "Ruhe und innere Einkehr sehr wertschaetzen.");
    AddDetail(({"nachtelf","nachtelfen"}),
        "Du bist in den Gaerten einer Siedlung der Nachtelfen.");
    AddDetail("einkehr",
        "Nachtelfen scheinen die innere Einkehr sehr zu schaetzen.");
    AddDetail(({"teil","park"}),
        "Du bist im noerdlichen Teil der Gaerten. Der See wird "
        "Deiner Einschaetzung nach in der Mitte sein, moeglicherweise "
        "fuehrt aber kein Weg um ihn herum.");
    AddDetail("mitte",
        "In der Mitte der Gaerten liegt ein See.");
    AddDetail("einschaetzung",
        "Du kannst nicht viel von hier aus erkennen.");
    AddDetail("bild",
        "Dieser Teil der Gaerten ist mit Bueschen und Straeuchern "
        "bewachsen. In noerdlicher Richtung werden sie dichter und gehen "
        "nahtlos in das Gestruepp aus Dickicht und Baeume ueber, das die "
        "Gaerten effektiv von der Siedlung trennt, und je weiter Du nach "
        "Westen schaust, desto groesser werden die Buesche. In Richtung "
        "des Sees ist der Bewuchs duenner, in der unmittelbaren Uferzone "
        "wachsen ueberhaupt keine Buesche.");
    AddDetail("bewuchs",
        "Der Bewuchs der Wiese wird von West nach Ost niedriger und von "
        "Nord nach Sued lichter. Nur bedingt spannend.");
    AddDetail(({"baum","baeume"}),
        "Die hier wachsenden Baeume sind recht unauffaellig und gehen im "
        "Dickicht auf, das in noerdlicher Richtung jedes Durchkommen "
        "verhindert. Das Gestruepp verhindert sehr effektiv die naehere "
        "Inaugenscheinnahme der Baeume - Du kommst nicht nah genug heran.");
    AddDetail("inaugenscheinnahme", "Inau... was?");
    AddDetail(({"gestruepp","dickicht"}),
        "Das Gestruepp im Norden verhindert jegliches Durchkommen. Es duerfte "
        "aus Goldblatttabakkuckuckskraut oder sonstigem dichten Buschwerk "
        "bestehen.");
    AddDetail(({"klippe","klippen"}),
        "Weiter westlich sind die Klippen - Du koenntest naeher ran, wenn "
        "Du sie Dir genauer ansehen moechtest.");
    AddDetail(({"busch","buesche","straeucher",
            "kraut","buschwerk","strauchwerk"}),
        "Busch- und Strauchwerk duerften weitgehend derselben Pflanze "
        "entstammen - Goldblatttabakkuckuckskraut. Nur sehr "
        "vereinzelt kannst Du eine Ausnahme erkennen.");
    AddDetail("pflanze",
        "Oh, hier gibt es viele Pflanzen.");
    AddDetail("goldblatttabakkuckuckskraut",
        "Oh, wow. Goldblatttabakkuckuckskraut gilt in der Wildnis als "
        "ausgestorben, hier wachsen noch etliche Buesche davon. Woher die "
        "Pflanze ihren Namen hat, ist bis dato unbekannt. Das Kraut wird bis "
        "zu zwei Meter hoch und ist dank seines dichten Wuchses auch als "
        "Blickschutz geeignet. Hier stehen die Buesche in verschiedenen "
        "Groessen frei.");
    AddDetail("wildnis",
        "Du bist in den Gaerten Dovenyas. Wenngleich die sorgsame Hand des "
        "Pflegers hier keine offenkundigen Spuren hinterliess, ist die "
        "Wildnis doch gebaendigt.");
    AddDetail(({"spur","spuren"}),
        "Du siehst keine Spuren.");
    AddDetail("hand",
        "Du siehst eine Hand. Deine Hand.");
    AddDetail("pfleger",
        "Der ist gerade nicht da.");
    AddDetail("wuchs",
        "Das Goldblatttabakkuckuckskraut hat einen sehr dichten Wuchs.");
    AddDetail(({"ufer","uferzone"}),
        "Das Ufer des Sees ist durchgaengig grasbewachsen, die Buesche "
        "reichen nicht an den See heran.");
    AddDetail("meter",
        "Ein Meter sind etwa drei Fuenftel eines wirklich grossen Zwergs.");
    AddDetail("weg",
        "Mmmh, nein, hier ist kein Weg. Auf der Wiese haben sich noch "
        "keine Schritte festgetrampelt.");
    AddDetail(({"blickschutz","wand","gruene wand"}),
        "Nordlich stehen Buesche und Baeume so echt beieinander, dass kein "
        "Durchkommen moeglich ist. Diese gruene Wand dient offenkundig auch "
        "als Blickschutz.");
    AddDetail("durchkommen",
        "Du kannst dich in westlicher und oestlicher Richtung in den Gaerten "
        "bewegen. Nach Norden ist kein Durchkommen.");
    AddDetail(({"erklaerung","namen"}),
        "Tja, woher hat das Goldblatttabakkuckuckskraut seinen Namen? Wenn Du "
        "irgendeine Erklaerung dafuer hast: "
        "'erklaere name <deine Erklaerung>'");
    AddDetail("boden",
        "Der Boden ist gluecklicherweise unter Dir. Er ist mit Gras "
        "bewachsen, das Deine Schritte weich abfedert.");
    AddSpecialDetail(({"schritte","schritt"}),"detailSchritt");
       
    AddDetail("wiese",
        "Die Wiese ist mit Gras bewachsen und mit zahlreichen Bueschen "
        "durchsetzt.");
    AddDetail("gras",
        "Gruenes Gras von mittlerer Laenge. Sehr weich, sehr angenehm. Etwas "
        "noerdlich schaut unter den Bueschen vereinzelt ein eher seltsames "
        "Gewaechs aus dem Gras heraus.");
    AddDetail("gewaechs",
        "Tatsaechlich sehr seltsam. Das Gewaechs, das vereinzelt unter den "
        "Bueschen waechst, sieht aus wie ein kleiner purpurfarbener "
        "Kaktus mit ganz vielen duennen Stacheln, auch wenn das natuerlich "
        "nicht zutrifft - es sind Purpursaftschlucksen. Man pflueckt sie "
        "besser nicht.");
    AddDetail(({"schluckse","saftschluckse","purpursaftschluckse"}),
        "Uh-oh, hier wachsen Purpursaftschlucksen. Diese purpurfarbenen "
        "etwa 20 cm langen Staengel mit den ewig vielen duennen Seitentrieben "
        "sollen giftig sein. Ignoriere sie besser.");
    AddDetail(({"stacheln","stachel"}),
        "Ah, Purpursaftschlucksen haben keine Stacheln, es handelt sich "
        "offenbar um duenne Triebe.");
    AddDetail(({"trieb","triebe"}),
        "Hier treibt alles irgendwie.");
    AddDetail(({"kaktus","kakteen"}),
        "Kakteen wachsen hier nicht.");
    AddDetail(({"kaktusse"}),
        "Nicht alles, was auf -us endet, wird in der Mehrzahl zu -usse.");
    AddDetail("mehrzahl",
        "Mehr als eines.");
    AddSpecialDetail("laenge","detailLaenge");
    AddDetail("ausnahme",
        "Du kannst genau eine Ausnahme ausmachen. Da steht, schon "
        "etwas naeher am noerdlichen Buschwerk, ein einzelner Stock "
        "Nachtsturmrosen." );
    AddDetail("gedeihen",
        "Hier gedeiht irgendwie alles.");
    AddDetail(({"nachtsturmrose","nachtsturmrosen",
        "stock","rosenstock","nachtsturmrosenstock"}),
        "Ah, Nachtsturmrosen. Eine Pflanze, die sich waehrend "
        "ihres langsamen "
        "Gedeihens sehr wandelt. In den ersten zehn Jahren ist die "
        "Nachtsturmrose in der Landschaft unauffaellig: Ein kleiner "
        "dunkelgruener Rosenstock in Buschform, stachel- und bluetenlos, "
        "waechst und gedeiht vor sich hin, wird jedoch zunaechst nicht "
        "groesser, nur dichter. Erst im zehnten Jahr nimmt er an Groesse "
        "zu und ueberragt dann die meisten Zwerge. Erst im elften Jahr "
        "treibt der Stock Blueten. Er verliert zeitgleich auch jegliche "
        "Farbe, unter dem Sternenhimmel Dovenyas glitzern und funkeln "
        "die Blueten aber so sehr, dass man den Rosenstock nicht "
        "uebersehen kann. Dieser Stock ist mindestens elf Jahre alt - "
        "Kein Wunder fiel er Dir auf.");
    AddDetail("landschaft","Ist es nicht schoen hier?");
    AddDetail("wunder",
        "Du bist Dir sicher, Wunder gibt es immer wieder.");
    AddSpecialDetail(({"jahre","jahr"}),"detailJahr");
    AddDetail("groesse","Viele Dinge sind von gewisser Groesse.");
    AddDetail("ding","Welches Ding willst Du Dir naeher ansehen?");
    AddDetail("farbe",
        "Die vorherrschende Farbe in den Gaerten Dovenyas ist, trotz "
        "der spaerlichen Beleuchtung - gruen.");
    AddDetail(({"beleuchtung","licht"}),
        "Die Sterne am Himmel sorgen fuer ausreichend Licht.");
    AddSpecialDetail(({"sechsfache","vierfache","zehntel","fuenftel",
        "sechstel","siebtel","viertel","drittel"}), "detailFuenftel");
    AddDetail(({"garten","gaerten"}),
        "Du bist im noerdlichen Teil der Gaerten Dovenyas.");
    AddDetail(({"dovenya","siedlung"}),
        "Die Siedlung liegt noerdlich von hier.");
    AddDetail("blueten",
        "Hier blueht fast nichts - einzig der Nachtsturmrosenstock "
        "traegt Rosenblueten.");
    AddDetail("zwerg",
            ([0:"Zwerge sind nicht wirklich gross, dafuer stinken "
                    "sie grossartig.",
              "zwerg": "Zwerge sind grossartig. Und riechen gut."]));
    AddDetail("dunkelheit",
        "Naja, so dunkel ist es hier dann doch nicht");
    AddDetail(({"augenpaar","augen"}),
        "Oh... schon wieder verschwunden.");
    AddDetail("buschform",
        "Etwas, das die Form eines Busches hat, hat eine Buschform.");
    AddDetail("form",
        "Suchst Du ein Foermchen?");
    AddDetail("foermchen",
        "Suche ein Foermchen!");
    AddSpecialDetail(({"rosenbluete","rosenblueten"}),"detailRosenblueten");
    AddDetail("seevogel",
        "Der Seevogel scheint schon voruebergezogen zu sein.");
    AddDetail("schrei",
        "Du kannst hier keinen Schrei sehen.");
    AddSound(({"schrei","seevogel"}),
        "Welcher Seevogel wohl einen solch heiseren Schrei von sich gibt...");
    SetProp(P_GEMA,({0,1}));

    seteuid(getuid(this_object()));
    Sky();
  
    AddExit("westen","./garten_nw");
    AddExit("osten","./garten_no");
    AddExit("suedosten","./garten_o");
    AddExit("sueden",([EX_FUNC:#'seeExitTestfunc]));
    SetProp(P_HIDE_EXITS,({"sueden"}));
    SetProp(P_KILL_NAME,"Eine Purpursaftschluckse");

    AddCmd(({"pfluecke","pflueck"}),"cmdPfluecke"); // rose, nicht tabak
    AddCmd(({"suche","such"}),"cmdSuche");  // foermchen
    AddCmd(({"erklaere","erklaer"}),"cmdErklaere");  // Name erklaeren


    AddRoomMessage(({
       "Der heisere Schrei eines vorueberziehenden "
                "Seevogels dringt an Dein Ohr.\n",
       "Aus der Dunkelheit unter einem Busch funkelt kurz ein Augenpaar.\n",
       "Irgendetwas raschelt im Gras.\n",
            }),1200);

    SetStupids(({"kein"}));
    
}


nosave string
detailJahr()
{
    return dtime(time())[13..16]+".\n";
}

nosave string
detailLaenge()
{
    if ((this_player()) && (! (this_player()->QueryProp(P_INVIS))))
        Message(break_string(
            this_player()->Name(WER)+" faellt beim etwas fragwuerdigen Versuch, 'Laenge' "
            "naeher zu betrachten, der Laenge nach hin. Aua.",77),
                MSGFLAG_VISUAL|MSGFLAG_NO_TP);
    return "Beim Versuch, Laenge naeher zu untersuchen, faellst Du hin.\n"
        "Natuerlich der Laenge nach.\n";
}

nosave string
detailSchritt()
{
    if ((this_player()) && (! (this_player()->QueryProp(P_INVIS))))
        Message(break_string(
            this_player()->Name(WER)+
            " laeuft herum und sieht immer wieder pruefend hinter "
            "sich. Was ist denn in "+
                this_player()->QueryPronoun(WEN)+" gefahren?",77),
                MSGFLAG_VISUAL|MSGFLAG_NO_TP);
    return break_string(
        "Du laeufst etwas herum und kuckst Dir dabei zu. Das sieht "
        "seltsam aus, aber mit Deinen Schritten scheint soweit alles okay "
        "zu sein.",77);
}

nosave string
detailFuenftel()
{
    if ((this_player()) && (! (this_player()->QueryProp(P_INVIS))))
        Message(break_string(
            this_player()->Name(WER)+
                " schaut ploetzlich wirklich SEHR nachdenklich drein."
                ,77),
                MSGFLAG_VISUAL|MSGFLAG_NO_TP);
    return break_string(
        "Wenn ein Fuenftel der fuenfte Teil von etwas ist, dann ist ist ein "
        "Drittel des Sechsfachen eines Fuenftels... Aeh... Ein Zehntel des "
        "Vierfachen?",77);
}

nosave string
detailRosenblueten()
{
    return (rosen
        ?"Du siehst eine besonders schoene Rosenbluete.\n"
        :"Leider sind gerade keine schoenen Rosenblueten erkennbar.\n");
}


public void 
reset()
{
    ::reset();
    if (rosen<2)
        rosen++;
    if (schluckse<4)
        schluckse+=2;
}


nosave int
cmdPfluecke(string was)
{
    object ob;
    notify_fail("Was willst Du pfluecken?\n");
    if ((!this_player()) || (!was) || (!stringp(was)))
        return 0;

    notify_fail("Neee, das kann man nicht pfluecken.\n"
        "Du wuerdest ja auch keine Buchen pfluecken.\n");
    if (was=="goldblatttabakkuckuckskraut")
        return 0;

    notify_fail("Lass das Gras mal stehen. Das ist so schoen weich.\n");
    if (was=="gras")
        return 0;

    if (member((["schluckse","saftschluckse","purpursaftschluckse"]),was))
    {
        notify_fail(break_string(
            "Leider (oder gluecklicherweise) sind gerade keine "
            "Purpursaftschlucksen gross genug, um gepflueckt zu werden.",77));
        if (!schluckse)
            return 0;

        if ( (int)(ob=clone_object(OBJ "kraut/schluckse"))->move(
            this_player(),M_GET) !=1)
        {
            notify_fail("Du koenntest die Purpursaftschluckse "
            "nicht mehr tragen.\n");
            ob->remove();
            return 0;
        }
        this_player()->Message("Du suchst Dir eine pflueckbare "
            "Purpursaftschluckse und pflueckst sie. Ohje.\n");
        schluckse--;
        return 1;
    }


    notify_fail("Das kann man nicht pfluecken.\n");

    if (was!="nachtsturmrose")
        return 0;

    notify_fail("Aber Du hast doch schon eine Nachtsturmrose.\n");
    if (present("\a\n\a\tol_nachtsturmrose",this_player()))
        return 0;

    notify_fail("Leider ist gerade keine schoene Bluete zu finden.\n");
    if (!rosen)
        return 0;

    if ( (int)(ob=clone_object(OBJ "kraut/rose"))->move(this_player(),M_GET) 
        !=1)
    {
        notify_fail("Du koenntest die Rose nicht mehr tragen.\n");
        ob->remove();
        return 0;
    }
    this_player()->Message("Du suchst Dir eine schoene Nachtsturmrosenbluete "
            "und pflueckst sie.\n");
    rosen--;
    return 1;
}
    


nosave int
cmdErklaere(string was)
{
    string *args;

    notify_fail("Was moechtest Du erklaeren?\n");
    if ((!this_player()) || (!was) || (!stringp(was)))
        return 0;

    args=explode(was," ");

    notify_fail("Das kannst Du hier nicht erklaeren.\n");
    if (args[0]!="name")
        return 0;

    notify_fail("Und wie willst Du DEN Namen erklaeren? "
        "(erklaere name <text>)\n");

    if (was=="name")
        return 0;

    was=(string)(this_player()->_unparsed_args());

    if (strlen(was)<6)
        return 0;

    was=was[5..];

    this_player()->Message(break_string(
        "Okay, Du erklaerst Dir den Namen Goldblatttabakkuckuckskraut "
        "wie folgt:\n"+was+"\nFuehlst Du Dich jetzt besser?\n",77,0,1));
    write_file(KUCKUCKLOG,sprintf("%s %s erklaert: %s\n",
            dtime(time())[5..],capitalize(getuid(this_player())),
                was));
    return 1;
}


nosave int
cmdSuche(string was)
{
    object o;
    notify_fail("Was willst Du suchen?\n");
    if ((!this_player()) || (!was) || (!stringp(was)))
        return 0;

    notify_fail("Du suchst, findest aber nichts.\n");
    if (was!="foermchen")
        return 0;

    notify_fail("Aber Du hast doch schon ein Foermchen.\n");
    if (present("\a\n\a\tol_foermchen",this_player()))
        return 0;

   this_player()->Message("Na kuck, ein Foermchen.\n");
   
   if ((int)((o=clone_object(OBJ "foermchen"))->move(this_player(),M_GET))!=1)
   {
        this_player()->Message("Leider kannst Du das Foermchen nicht "
        "mehr tragen.\n");
        o->remove();
   }
   return 1;
}
