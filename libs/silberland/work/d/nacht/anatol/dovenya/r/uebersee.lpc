    AddDetail(({"zeitlupentempo"}),
        "Diese Ruhe in der Bewegung koennte viele philosophische "
        "Diskussionen anregen.");
    AddDetail(({"diskussion","diskussionen"}),"Nicht hier, ok?");
    AddDetail("romantik",
        "Hier ist es herrlich ruhig... das Licht der Sterne macht es sooo "
        "romantisch...");
    AddDetail("geisterhand",
        "Genaugenommen ist auch DEINE Hand eine Geisterhand.");
    AddDetail(({"bewegung","nebelschwade"}),
        "Die Nebelschwaden (oder doch nur Dunst?) bewegen sich nur sehr "
        "langsam, geben dem See etwas geheimnisvolles Unbekanntes...");
    AddDetail(({"unbekanntes","geheimnisvolles"}),
        "Zu geheimnisvoll, zu unbekannt...");
    AddDetail(({"werte","wert"}),"So als Geist denkt man in ganz anderen "
        "Wertmassstaeben... vielleicht ist dieser Zustand der "
        "Koerperlosigkeit doch nicht so falsch.");
    AddDetail(({"wertmassstaebe","wertmassstab"}),
        "Naja, was wuerde Dir ein Schwert nutzen - Du "
        "koenntest es nichteinmal festhalten. Was bedeutet Dir "
        "Reichtum, Du kannst ihn nicht tragen...");
    AddDetail("reichtum","Vorerst ist das Leben sehr erstrebenswert, andere "
