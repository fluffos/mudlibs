#pragma strict_types

#include "../defines.h"

#define ENVROOMLIST   ({ ROOM "garten_o", ROOM "garten_no", ROOM "garten_n",\
             ROOM "garten_nw", ROOM "garten_s" })


inherit DOVENYA "std/room";

/* Die gerade meditierenden Geister */

nosave string * meditation;

/* Vorwaertsdeklaration */

nosave string soundDefault();
nosave void tell_environment(string msg);


public void 
create() 
{
    ::create();

    meditation=({});
    SetProp(P_INDOORS,0);
    SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:22,
                           ENV_TERRAIN:TT_OTHER]));
    SetProp(P_INT_SHORT,"Dovenya, ueber dem See des Lebens");
    SetProp(P_INT_LONG,break_string(
