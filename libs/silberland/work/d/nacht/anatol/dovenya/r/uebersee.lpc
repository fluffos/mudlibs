    AddSmell("duft","Es riecht nach einer angenehm lauen Fruehlingsnacht.");
    AddSmell("garten","Du kannst nichts genaueres erschnuppern, Du bist zu "
        "weit weg dafuer.");
    AddSmell(({"nacht","fruehlingsnacht"}),
        "Naja, wie so eine Fruehlingsnacht halt duftet...");
    AddSound(DEFAULT_SOUND,#'soundDefault);
    AddSound(({"plaetschern","see"}),#'soundDefault);
    
    AddRoomMessage( ({
        "Wie von Geisterhand bewegen sich die zarten Dunstschwaden.\n",
        "Die Nebel um Dich scheinen sich kurz zu verdichten.\n",
        "Zwei treibende Dunstschwaden schliessen sich zu einer Figur "
           "zusammen,\nloesen sich dann aber ganz langsam vollstaendig auf.\n",
        "Der hauchzarte Nachtwind verquirlt eine kleine Nebelschwade zu "
           "einem Wirbel.\n",
        "","","","",""  /* Auch ne Art von Random :) */
        }),120);

    seteuid(getuid(this_object()));

    AddCmd("","parseCommands",1);

