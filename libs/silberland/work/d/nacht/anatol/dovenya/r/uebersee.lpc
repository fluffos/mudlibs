/* Nicht-Geister haben hier eigentlich nichts verloren, daher werden sie, 
 * sofern sie keine Magier sind, umgehend in den See weiterbefoerdert. 
 * Ausserdem werden Geister, die aus /room/death/death_room zurueckkehren,
 * mit einer kleinen Meldung an den Raum und sein Umfeld versehen. Macht
 * sich einfach schoener. */

public void 
init() 
{
    if ((this_player()) && (environment(this_player())==this_object()))
        if ((!IS_WIZARD(this_player())) 
            && (!this_player()->QueryProp(P_GHOST))) 
        {
            write("Huch, wie kommst denn DU hier her?\n");
            DO_LOG(LOG "strange.log",
            sprintf("%s als Nichtgeist ueber dem See?!\n"
                "TI=%O, csd=%d, PO(0)=%O, PO(1)=%O, PO(2)=%O, PO(3)=%O, " 
	            "PO(4)=%O, PO(5)=%O, PO(6)=%O, PO(7)=%O",
                capitalize(getuid(this_player())),
                this_interactive(), caller_stack_depth(),
                previous_object(), previous_object(1), previous_object(2),
                previous_object(3), previous_object(4), previous_object(5),
                previous_object(6), previous_object(7)
	        ));
            if ((this_player()->move(ROOM "see",M_GO|M_SILENT|M_NO_SHOW))<0)
                DO_LOG(LOG "strange.log",
                    sprintf("ARGH! %s KONNTE NICHT WEGBEWEGT WERDEN!\n",
                    capitalize(getuid(this_player()))));
            return;
        }    
    if ((caller_stack_depth()==5) 
        && (file_name(previous_object(4))=="/room/death/death_room")) 
    {
        Message(break_string(sprintf(
          "Ploetzlich scheint ein Teil des hauchzarten Dunstes Form "
          "anzunehmen, und Du erkennst langsam die seufzenden Konturen %s "
          "koerperloser Gestalt.",this_player()->name(WESSEN)),77),
            MSGFLAG_VISUAL,([MSGFLAG_EXCLUDE: ({this_player()})]));
        tell_environment(break_string(sprintf(
          "Ueber dem See scheint ein Teil der hauchzarten Dunstschwaden "
          "an Form zu gewinnen, und Du erkennst langsam die niedergeschlagenen"
          " Konturen %s koerperloser Gestalt.",
          this_player()->name(WESSEN)),77));
        call_other(ROOM "see","Message",break_string(sprintf(
          "Ueber Dir formen einige Dunstschwaden langsam die ziemlich "
          "niedergeschlagenen Konturen %s koerperloser Gestalt.\n",
          this_player()->name(WESSEN)),77),MSGFLAG_VISUAL);
    }
    ::init();
}

/* Eine kleine Hilfsfunktion dazu: Sie gibt Meldungen an die umliegenden
 * Gartenraeume aus - z.B. wenn ein "neuer" Geist auf dem See ankommt oder
 * die Schwerkraft (voellig ueberraschend) zuschlaegt. Nur noetig fuer
 * geladene Raeume (was nicht geladen ist, kann nix enthalten, was an
 * irgendwelchen Neuigkeiten interessiert waere). */
 
nosave void 
tell_environment(string msg) 
{
    int i;
    object o;

    for (i=sizeof(ENVROOMLIST)-1;i>=0;i--)
        if (o=find_object(ENVROOMLIST[i]))
            call_other(ENVROOMLIST[i],"Message",msg,MSGFLAG_VISUAL);
    return;
}


/* Filterfunktion, um sichtbare Lebewesen zu klassifizieren */

nosave int 
isVisLiving(object ob) 
{
    return (living(ob) && (!ob->QueryProp(P_INVIS)));
}

public object * 
GetVis() 
{
    return filter_array(all_inventory(this_object()), 
            "isVisLiving",this_object());
}


/* Wegen der Meditation konsequent erstmal alle Befehle abfangen und dann
 * bearbeiten, falls der Spieler nicht bereits meditiert... das wuerde mit
 * einem Standard-darf-nix-tun-Objekt zwar auch gehen, aber... naja.   */

nosave int 
parseCommands(string cmdstring) 
{
    string cmd;

    if (!this_player()) 
        return 0;
    if (member(meditation, file_name(this_player()))!=-1) 
    {
        write("Du bist zu sehr in die Meditation vertieft.\n");
        return 1;
    }
   
    cmd=query_verb()+(cmdstring?cmdstring:"");

    if ((((query_verb()=="meditier") 
            || (query_verb()=="meditiere")) 
            && (cmdstring==0)) 
            || (((query_verb()=="versink") 
            || (query_verb()=="versinke")) 
            && (cmdstring=="in meditation"))) 
    {
        if (this_player()->QueryProp(P_GHOST)) 
        {
            meditation+=({file_name(this_player())});
            write(break_string("Du sammelst Deinen Geist, laesst die ruhige "
                "Atmosphaere des Sternenlichts tief in Dir wirken und hoffst, "
                "dass irgendetwas mit Dir geschieht.",77));
            Message(break_string(sprintf("Der Dunst um %s Geist scheint sich "
              "zu verdichten.\n",this_player()->name(WESSEN)),77),
                MSGFLAG_VISUAL,([MSGFLAG_EXCLUDE:({this_player()})]));
            call_out("processMeditation",5);
            return 1;
        }
        else 
        {  /* grummel :) wie kommst DU denn hier her? Magier... */
            write("Du schliesst fuer einen Moment "
                "die Augen und atmest tief durch.\n");
            Message(break_string(sprintf(
              "%s schliesst kurz die Augen und atmet tief durch.\n",
              this_player()->Name(WER))),
                MSGFLAG_VISUAL,([MSGFLAG_EXCLUDE:({this_player()})]));
            return 1;
        }
    }
    else if (((query_verb()=="schwebe") || (query_verb()=="schweb"))
            && ((cmdstring=="in garten") || (cmdstring=="zum garten")
            || (cmdstring=="an ufer") || (cmdstring=="ans ufer") 
            || (cmdstring=="zum ufer")) || (query_verb()=="garten")) 
        {
        if (this_player()->QueryProp(P_GHOST)) 
        {
            write("Du schwebst ans Ufer des Sees in den Garten.\n");
            this_player()->move(ENVROOMLIST[random(sizeof(ENVROOMLIST))],
                M_GO,0, "schwebt ans Ufer des Sees in den Garten",
                    "schwebt vom See herein");
        }
        else 
        { 
            write("Wird aber auch Zeit, hmpf.\n");
            this_player()->move(ENVROOMLIST[random(sizeof(ENVROOMLIST))],
                M_GO,0, "hechtet ueberraschend ans Ufer des Sees",
                "kommt endlich ans Ufer");
        }
        return 1;
    }
    else 
        return 0;  /* keine weiteren Befehle */
}

/* Das "meditieren" ist nicht ganz so rasch wie ein zuegiges "bete", dauert
 * aber nicht zu lange - die armen Nachtelfen kommen ja meist eben erst aus
 * einer Sequenz, die relativ... unangenehm ist. Spieleraergern ist zwar 
 * einfach, macht aber nicht gluecklich :) */

nosave void 
cleanupMeditation() 
{
    if (!this_player()) 
        return;
    meditation-=({file_name(this_player())});
    return;
}

nosave void 
processMeditation() 
{
    if (!this_player()) 
        return;
    if (environment(this_player())!=this_object()) 
        return (void) cleanupMeditation();
    write(break_string("Eine tiefe Ruhe umarmt Dich, sanft wie der Hauch des "
        "warmen Nachtwinds, der um die Baumwipfel streicht. Dein Geist "
        "enspannt sich.",77));
    call_out("processMeditation2",4);
    return;
}

nosave void 
processMeditation2() 
{
    if (!this_player()) 
        return;
    if (environment(this_player())!=this_object()) 
        return (void) cleanupMeditation();
    write(break_string("Von irgendwoher vernimmst Du ein leises Summen.",77));
    Message(break_string(sprintf("Ein Schauer faehrt durch %s Geist.",
          this_player()->name(WESSEN)),77),MSGFLAG_VISUAL,
            ([MSGFLAG_EXCLUDE:({this_player()})]));
    call_out("processMeditation3",6);
    return;
}

nosave void 
processMeditation3() 
{
    if (!this_player()) 
        return;
    if (environment(this_player())!=this_object()) 
        return (void) cleanupMeditation();
    write(break_string("Ein wilder Strudel erfasst Dich und ehe Du weisst, "
        "wie Dir geschieht, faehrt Dein Geist in eine wohlgeformte Huelle... "
        "Die Schwerkraft scheint dies auch gemerkt zu haben, jedenfalls "
        "widerfaehrt Dir sofort das Phaenomen des freien Falls: Du "
        "platschst in das kuehle Nass unter Dir.",76));
    Message(break_string(sprintf("Mit einem Lichtblitz und dem 'WHOPP!' "
          "verdraengter Luft erscheint %s in koerperlicher Form und faellt "
          "sofort gemaess geltendem Gesetz der Schwerkraft ins Wasser."
          ,this_player()->name()),77),MSGFLAG_VISUAL,
            ([MSGFLAG_EXCLUDE:({this_player()})]));
    tell_environment(break_string(sprintf("Ueber dem See erscheint mit einem "
        "Lichtblitz %s in koerperlicher Form und platscht sofort ins Wasser.",
        this_player()->name()),76));
    call_other(ROOM "see","Message",
        "Ueber Dir blitzt es kurz auf, und Du hoerst ein "
        "deutliches 'WHOPP'.\n",
        MSGFLAG_VISUAL);

    this_player()->SetProp(P_GHOST,0);
    this_player()->SetProp(P_POISON,0);
    this_player()->SetProp(P_HP, (int)(this_player()->QueryProp(P_MAX_HP)));
    this_player()->SetProp(P_SP, (int)(this_player()->QueryProp(P_MAX_SP)));
    this_player()->move(ROOM "see",M_GO,0,"platscht ins Wasser",
        "platscht ueberrascht ins Wasser");
    return (void) cleanupMeditation();
}

/* SpecialDetails, Sounds, etc... */

nosave string 
detailFigur() 
{
    string * str;

    str= ({
        "Das da koennte ein kleines Haeschen sein...\n",
        "Hey, war das nicht gerade eine Karte von Dovenya?\n",
        "Hmmm, das da hinten koennte eine huebsche Elfin sein...\n",
        "Oh, das sieht ganz so aus wie ein Schmied bei der Arbeit!\n",
        "Das koennte... nein... oder? Vielleicht... Hm, nein, eher nicht.\n",
        "Hey, das sieht aus wie der Kopf einer Reisserbestie!\n"
        });
    return str[random(sizeof(str))];
}

nosave string 
detailAbenteuerpunkte() 
{
    if (!this_player()) return 0;
    if (this_player()->QueryProp(P_QP)) 
        return sprintf("Du hast %d Abenteuerpunkte.\n",
            (int)(this_player()->QueryProp(P_QP)));
    else 
        return "Du hast nicht einen einzigen Abenteuerpunkt!\n";
}

nosave string 
detailSee() 
{
    object * o;
    string res;
    string * s;
    string err;

    o=0;
    if (err=catch(o=(object *)call_other(ROOM "see","GetVis")))
        write_file(LOG "errors.log",sprintf("%s: (uebersee) %s: %s\n",
                dtime(time()), ROOM "see", err));
    if (!sizeof(o)) return break_string(
        "Die Wasseroberflaeche des Sees unter Dir (Du kannst Dich "
        "nicht recht an den Gedanken gewoehnen, dass Du *ueber* dem See "
        "schwebst) liegt ruhig und nahezu unbewegt... nur der Nachtwind "
        "haucht zart kleine Kraeuselchen in die Oberflaeche des Sees.",77);
    else return break_string(
        "Da gerade jemand im See herumplaetschert, ist die Wasseroberflaeche "
        "etwas aufgewuehlt, was die Romantik ein wenig truebt - zumindest aus "
        "Deiner Sicht.",77);
}

nosave string 
soundDefault() 
{
    object * o;
    string res;
    string * s;
    string err;

    o=0;
    if (err=catch(o=(object *)call_other(ROOM "see","GetVis")))
        write_file(LOG "errors.log",sprintf("%s: (uebersee) %s: %s\n",
            dtime(time()), ROOM "see", err));
    if (!sizeof(o)) 
        return "Der See unter Dir scheint andaechtige Stille abzustrahlen.\n";
    else 
        return "Unter Dir plaetschert irgendwer im See.\n";
}

 /* NICHT int_long(), da make_invlist() etc. nicht von Hand aufgerufen,
  * sondern lediglich die Raumlangbeschreibung je nach Umgebung angepasst 
  * werden soll */

public string 
_query_int_long() 
{
    int i;
    object * o1, * o2;
    string err;
    string res;
    string * s;
    o2=o1=({});
                          
    res=Query(P_INT_LONG);
    if (!interactive(this_player())) 
        return res;
    for (i=sizeof(ENVROOMLIST)-1;i>=0;i--) 
        if (err=catch(call_other(ENVROOMLIST[i],"???"))) // TODO
            write_file(LOG "errors.log",sprintf("%s: (uebersee) %s: %s\n",
                dtime(time()), ENVROOMLIST[i], err));
        else
            o1+=filter_array(all_inventory(find_object(ENVROOMLIST[i])),
                "isVisLiving",this_object());
    if (err=catch(o2=(object *)call_other(ROOM "see","GetVis")))
        write_file(LOG "errors.log",sprintf("%s: (uebersee) %s: %s\n",
            dtime(time()), ROOM "see", err));
    if (!sizeof(o2))  
        res+="Die Wasseroberflaeche des Sees kraeuselt sich "
            "im Hauch des Nachtwinds, ist ansonsten aber ruhig, ";
    else if (sizeof(o2)==1)
        res+=sprintf("Aus dem Wasser schaut %s Kopf heraus, doch scheint %s "
            "der einzige zu sein, der sich im See vergnuegt, ", 
            o2[0]->name(WESSEN), o2[0]->QueryPronoun(WER));
    else 
    {
        s=map_objects(o2,"name",WEN);
        res+=sprintf("Du kannst %s und %s planschend im Wasser des "
            "Sees ausmachen, " ,implode(s[0..<2],", "),s[<1]);
    }
    if (!sizeof(o1)) 
        res+="der Garten der Ruhe scheint "+(sizeof(o2)?"jedoch":"ebenfalls")
        +" verlassen.";
    else if (sizeof(o1)==1) 
        res+=sprintf("im Garten der Ruhe haelt sich "+
            "%s%s auf.",(sizeof(o2)?"":"wenigstens "), o1[0]->name(WER));
    else 
    {
        s=map_objects(o1,"name",WER);
        res+=sprintf(
            "im Garten der Ruhe halten sich %s%s und %s auf.",
            (sizeof(o2)?"":"jedoch "),implode(s[0..<2],", "),s[<1]);
    }  
    return break_string(res,77,0,1);
}

/* Keine Ausgaenge anzeigen: Es wird schliesslich rausgeschwebt. */

varargs string 
GetExits() 
{ 
    return ""; 
}
