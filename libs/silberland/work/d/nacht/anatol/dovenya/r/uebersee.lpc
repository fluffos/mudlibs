        "Ort, um in Meditation zu versinken, Sammlung und Ruhe in den eigenen "
        "Geist einkehren zu lassen.",77));
    SetProp(P_GEMA,({0,0}));

    Sky();

    AddDetail("boden","Den gibt es hier NICHT.");
    AddDetail("sicht","Dort ist immer schoenes Wetter.");
    AddDetail("wetter","Hier auch.");
    AddDetail("meditation",
        "Vielleicht solltest Du es mal mit Meditation versuchen...?");
