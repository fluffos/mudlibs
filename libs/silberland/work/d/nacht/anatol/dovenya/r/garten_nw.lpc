/* Dovenya, Garten der Ruhe
 * _____________________________________(i) Anatol@Silberland (1998-2012) */

#pragma strict_types

#include "../defines.h"

inherit DOVENYA "std/garten";

private nosave object cabin;
mapping cabin_found;
mapping honored;

public void 
create() 
{
    ::create();

    if (!cabin) 
    {
        cabin=clone_object("/p/service/std/mailcabin");
        cabin->move(this_object(),M_NOCHECK);
        cabin->SetProp(P_SHORT,"Eine gut versteckte Schreibkabine");
        cabin->SetProp(P_NOGET,
            "Die Schreibkabine ist mit dem Boden... verwachsen?!\n"
            "Du kannst die Schreibkabine nicht mehr tragen.\n"
            "Die Schreibkabine hat keinen materiellen Wert.\n"
            "Lass mal, vielleicht kann die noch jemand brauchen.\n"
            "Die Schreibkabine ist nicht leer (sie enthaelt mindestens Luft)\n"
            "Die Schreibkabine gehoert Dir nicht!\n"
            "... wow. So genau wolltest Du's nicht wissen.\n");
        cabin->Set(P_INVIS, 
            symbol_function("cabin_invis",this_object()),F_QUERY_METHOD);
    }

    cabin_found=([]);
    honored=([]);

    SetProp(P_INT_SHORT,"Dovenya, Gaerten");
    SetProp(P_INT_LONG,
        "Dieser Teil der Gaerten wird durch das dominiert, was sie begrenzt. "
        "Du bist in der Nordwestecke, und auf einer kleinen Lichtung - denn "
        "um Dich herum stehen Baeume, dicht an dicht, mit undurchdringlichem "
        "Unterholz. Der See im Suedosten ist frei zugaenglich, und wenn Du "
        "Dich zwischen den Bueschen durchschlaengelst kommst Du in oestlicher "
        "Richtung in den groesseren Teil der Gaerten.");

    SetProp(P_GEMA,({-1,1}));

    Sky();

    AddSmell(DEFAULT_SMELL,
        "Der herbe Duft von Purpureschen liegt in der Luft.");
    AddSound(DEFAULT_SOUND,
        "Leise saeuselt in den Baumwipfeln der Wind.");

    AddDetail(({"purpuresche","esche","eschen","purpureschen"}),
        "Ja, es sind Purpureschen. Stamm und gelockerte Baumkrone "
        "sprechen zwar keine eindeutige Sprache, aber das Blattwerk laesst "
        "keinen anderen Schluss zu - die Blaetter der Baeume sind "
        "vielgliedrig, mit jeweils zwei Blaettern gegenueberliegend am "
        "Staengel. Und ausserdem weisen sie eine roetliche bis blauroetliche "
        "Farbe vor, was dann schon recht eindeutig ist.");
    AddDetail("farbe",
        "Die Farbe des Blattwerks der Purpureschen ist, wenig ueberraschend, "
        "irgendwo zwischen rot und blaurot anzusiedeln.");
    AddDetail(({"sprache","schluss"}),
        "Das Blattwerk ist schon eindeutig - es sind Purpureschen.");
    AddDetail(({"stamm","staemme"}),
        "Der Stamm einer Purpuresche ist unauffaellig, das Holz aber recht "
        "hochwertig und weist eine hohe Bruchfestigkeit vor - es biegt sich "
        "eher als dass es bricht.");
    AddDetail(({"holz","nutzholz"}),
        "Hier in den Gaerten wird sicher kein Nutzholz geschlagen. Das "
        "waere wirklich nicht opportun.");
    AddDetail(({"baumkrone","wipfel","baumwipfel","baumkronen"}),
        "Die Baumkronen der Purpureschen sind typischerweise recht licht und "
        "offen, als da die normale adulte Esche viel des Lichts bedarf. "
        "Purpureschen sind in dieser Hinsicht offenbar eine sehr "
        "ungewoehnliche Unterart, immerhin stellt der Sternenhimmel nicht "
        "gerade viel Licht. Der Wind bewegt sie sacht hin und her.");
    AddDetail(({"klippe","klippen"}),
        "Die Klippen sind westlich von Dir, erkennbar vor allem an der "
        "Abwesenheit des Erdbodens: Der Himmel 'scheint' durch die "
        "westlichen Baeume. Der eine oder andere Felsen ragt ueber "
        "die Kante nach oben.");
    AddDetail("kante",
        "Du kannst die Kante von hier aus nicht sehen. Und naeher ran "
        "kannst Du auch nicht. Schade.");
    AddDetail("abwesenheit",
        "Weiter westlich wuerde der Boden durch Abwesenheit glaenzen. "
        "Stuendest Du dort, stuendest Du dort nicht lange.");
    AddDetail("erdboden",
        "Du stehst drauf. Freundlicherweise ist er mit Gras bewachsen.");
    AddDetail("felsen",
        "Die Felsen sind fuer Dich unerreichbar - die Baeume und das "
        "Gestruepp verhindern jegliches Durchkommen.");
    AddDetail("durchkommen",
        "Anbetrachtlich der gefaehrlichen Klippen ist es sehr praktisch "
        "dass man nicht bis zu ihnen vordringen kann.");
    AddDetail("wind",
        "Sacht bewegt er die Baumwipfel hin und her. Hier unten ist er nicht "
        "spuerbar.");
    AddSound("wind", "Leise rauscht der Wind in den Wipfeln.");
    AddDetail("hinsicht",
        "In dieser Hinsicht ungewoehnlich.");
    AddDetail("unterart",
        "Die Purpuresche ist offenbar eine Unterart der gewoehnlichen Esche.");
    AddDetail("bruchfestigkeit",
        "Eine gewisse Bruchfestigkeit kann sich auch fuer den lebenden Baum "
        "lohnen, zum Beispiel wenn es so richtig stuermt.");
    AddDetail("beispiel",
        "Zum Beispiel.");
    AddDetail("dovenya",
        "Die Siedlung liegt noerdlich von hier, Du wirst die Gaerten "
        "allerdings nur weiter oestlich verlassen koennen.");
    AddDetail("siedlung",
        "Die Siedlung wird irgendwo weiter noerdlich sein. Hinter der "
        "gruenen Wand aus Gestruepp und Baeumen.");
    AddDetail(({"mauer","wand"}),
        "Wie eine gruene Mauer wirkt das Gestruepp - wenn Du in die Siedlung "
        "moechtest, wirst Du Dich weiter oestlich nach einem Weg umsehen "
        "muessen.");
    AddDetail("weg",
        "Hier gibt es, definitiv, keinen Weg.");
    
    AddDetail(({"blatt","blaetter","blattwerk"}),
        "Die Blaetter der Purpureschen sind einzigartig. Sie sind "
        "vielgliedrig, wobei jeweils zwei Blaetter einander gegenueber "
        "am Staengel sind. Die einzelnen Blattteile sind lang und oval ... "
        "und roetlich... fast blauroetlich, was der Purpuresche zu ihrem "
        "Namen verhalf.");
    AddDetail(({"name","namen"}),
        "Fraxinus purpurea Oleaceae.");
    AddDetail(({"fraxinus"}),
        "Fraxinus duerfte der botanische Name der Esche sein... huch, woher "
        "weisst Du das?!");
    AddDetail("oleaceae","Ach, dass diese Purpureschen irgendwo auch "
         "Oelbaumgewaechse sind, weiss doch jeder.");
    AddDetail("fraxinus purpurea",
        "Das ist der botanische Name der Purpuresche - so koennen Zwerg und "
        "Elf vom selben Baum sprechen und beugen Missverstaendnissen vor. "
        "Deine umfangreichen Kenntnisse in der Botanik erstaunen dich. ");
    AddDetail(({"kenntnisse","kenntnis"}),
        "Du bist erstaunt.");
    AddDetail("botanik",
        "Du stehst gewissermassen in ihr.");
    AddDetail(({"missverstaendnis","missverstaendnisse"}),
        "Ah, Missverstaendnisse sind selten witzig.");
    AddDetail(({"oelbaumgewaechs","oelbaumgewaechse"}),
        "Zu den Oelbaumgewaechsen gehoeren viele Pflanzen. Olivenbaeume "
        "(gibt's hier nicht), Forsythien (oh je, koennen die kriechen und "
        "beissen? Egal, gibts hier nicht), eben die Eschen, ...");
    AddDetail(({"olivenbaum","olivenbaeume"}),
        "Hier waechst nicht auch nur ein Olivenbaum. Schade.");
    AddDetail(({"Forsythie","forsythien"}),
        "Du bist Dir nicht sicher, ob das wirklich eine Pflanze ist. Es "
        "klingt mehr nach etwas mit ledrigen Fluegeln, einem sabbernden "
        "bluttriefenden Schnabel und maechtigem Gekreische.");
    AddDetail(({"pflanze","pflanzen"}),
        "In den Gaerten Dovenyas gibt es viele Pflanzen.");
    AddDetail("fluegel",
        "Zwischen zwei Purpureschen an den Klippen steht ein Steinway & Sons "
        "Konzertfluegel, gestimmt und bereit, bespielt zu werden.");
    AddDetail(({"sons","steinway","konzertfluegel"}),
        "Ah, Du hast Dich offenbar getaeuscht.");
    AddSpecialDetail("schnabel","detailSchnabel");
    AddDetail("gekreische",
        "Es ist hier tatsaechlich eher ruhig.");
    AddDetail(({"blattteil","blattteile"}),
        "So ein Blatt besteht aus vielleicht zehn oder zwoelf Blattteilen.");
    AddDetail("staengel",
        "So eine Purpuresche hat ganz schoen viele Staengel - fuer jedes "
        "Blatt einen.");
    AddDetail("stengel",
        "(Versuch es mal mit 'staengel'. Von 'Stange'. Ja das ist neu.)");
    AddDetail("versuch", "Versuch es halt.");
      
    AddDetail("stange",
        "Du siehst hier keine Stange.");
    AddDetail(({"unterholz","gestruepp","buesche","busch","buschwerk"}),
        "Das Gestruepp, teilweise von groesseren und kleinen Baeumen "
        "unterstuetzt, umrahmt hier die Lichtung und verhindert, dass jemand "
        "versehentlich eine unangenehme Bekanntschaft mit den Klippen der "
        "Insel macht. Im Norden bildet das Buschwerk ebenfalls eine "
        "ebenso undurchdringliche wie undurchschaubare gruene Mauer, so dass "
        "hier wirklich kein Stueck der (ohnehin spaerlichen) Zivilisation der "
        "Siedlung zu sehen ist. Das Sueddickicht verhindert, dass Du westlich "
        "am See vorbeigehen kannst.");
    AddDetail("stueck",
        "Viel kannst Du hier nicht sehen von der Zivilisation. Eigentlich "
        "gar nichts.");
    AddDetail("zivilisation",
        "Ah, die Zivilisation. Gerne ueberschaetzt. Etwas kultiviertes und "
        "gesellschaftlich entwickeltes Leben sollte in Dovenya aber schon "
        "zu finden sein.");
    AddDetail("insel",
        "Gemaess vorherrschenden Betrachtungsweise befindest Du Dich hier "
        "auf einer grossen Insel.");
    AddDetail("betrachtungsweise",
        "Einzelmeinungen wuerden darauf bestehen, dass Du Dich auf einem "
        "Kontinent befindest.");
    AddDetail("kontinent",
        "Kontinent, grosse Insel... ist egal. Egal in welche Richtung Du "
        "'laufen' wuerdest, irgendwann hoert das Land auf und das Wasser "
        "faengt an. Das ist das, was wichtig ist.");
    AddDetail("wasser",
        "Etwas weiter suedlich, genauer genommen suedoestlich, liegt ein "
        "kleiner See.");
    AddDetail(({"land","trockenes","trockenen"}),
        "Du stehst auf dem Trockenen.");
    AddDetail(({"einzelmeinungen","einzelmeinung"}),
        "Diese Einzelmeinungen sind sicher politisch motiviert.");
    AddDetail("bekanntschaft",
        "Die Metapher ist, wo Du drueber nachdenkst, schlecht gewaehlt. Du "
        "wuerdest ausdruecklich keine Bekanntschaft mit den Klippen machen, "
        "zumindest nicht sofort. Zunaechst wuerdest Du den freien Fall "
        "kennenlernen.");
    AddDetail(({"freier fall", "fall"}),
        "... dann aber kaemen die Klippen!");
    AddDetail("metapher",
        "Die Metapher entzieht sich deinen Blicken gleich einem scheuen "
        "Reh, das die unsittliche Aufmerksamkeit des Wolfs spuert.");
    AddDetail(({"reh","rehe"}),
        "Und selbstverstaendlich siehst Du hier kein Reh.");
    AddDetail("wolf",
        "Du siehst hier keinen Wolf. Was woellte er hier, hier gibt es ja "
        "auch keine Rehe.");
    AddDetail("aufmerksamkeit",
        "Du bist sehr aufmerksam, da Du das alles bemerkst.");
    AddDetail(({"dickicht","sueddickicht"}),
        "Ein wenig ueberraschend, dass die Umrundung des Sees nicht moeglich "
        "ist. Aber der Platz haette vermutlich nicht gereicht.");
    AddDetail("platz",
        "Zwischen See und den Klippen ist offenbar nicht genuegend Platz, "
        "als dass sich dort die Pflege der Gaerten gelohnt haette.");
    AddDetail("pflege",
        "Also viel offenkundige Pflege wird hier nicht geleistet.");
    AddDetail("leben",
        "Spuerst Du es in Dir? Na los! Fuehle es!");
    AddDetail("umrundung",
        "Der See laesst sich bedauerlicherweise nicht vollstaendig umrunden.");
    AddDetail("teil",
        "Mh, dieser Teil des Gartens sieht etwas verwildert aus.");
    AddDetail("gebaeude",
        "Du siehst von hier aus keine Gebaeude - was offenkundig auch "
        "so beabsichtigt ist, die gruene Wand in noerdlicher Richtung mag "
        "genau deshalb so angelegt sein.");
    AddDetail("boden",
        "Im Gegensatz zu den Wiesen im oestlichen Teil des Gartens scheint "
        "hier ein wenig Verwilderung angesagt zu sein. Jedenfalls waechst hier "
        "neben dem gaengigen Gras auch etwas Moos. Am westlichen Rand "
        "des ungepflegten Allerleis faellt Dir ein Haufen Geaest auf, weiss "
        "der Kuckuck, was sich darunter alles verbirgt.");
    AddDetail(({"anlage","rest","gegensatz"}),
        "Der Gegensatz dieser Ecke der Gaerten gegenueber dem Rest der "
        "gepflegten Anlage koennte nicht groesser sein.");
    AddDetail("kuckuck",
        "Du siehst hier keinen Kuckuck.");
    AddDetail(({"allerlei","verwilderung"}),
        "Die Gaerten sehen hier eher ungepflegt und verwildert aus. Das "
        "ist sicherlich so gewollt, die Hintergruende erschliessen sich Dir "
        "aber nicht.");
    AddSpecialDetail(({"haufen","geaest"}),"detailGeaest");
    AddDetail(({"hintergruende","hintergrund"}),
        "Mmmhmm... erschliesst sich Dir nicht.");
    AddDetail(({"gras","graeser"}),
        "Die Graeser sind typisch fuer diese Art von Garten - duenn und "
        "langhalmig, so dass sie problemlos auch aus einer dickeren Moos"
        "schicht herausragen wuerden.");
    AddDetail("art",
        "Die Verwilderung nimmt natuerlich auch etwas Einfluss auf die "
        "dominierende Art der Graeser.");
    AddDetail("einfluss",
        "Etwas Einfluss.");
    AddDetail(({"blick","moos","moosschicht"}),
        "Es ist dann doch nicht so viel Moos wie auf den ersten Blick "
        "vermutet... Dennoch: die Wiese ist mit weichem Moos unterfuettert, "
        "so dass sich der Boden besonders weich anfuehlt.");
    AddDetail("rand",
        "Am westlichen Rand stehen vornehmlich Baeume, die den Zugang zu "
        "den Klippen verhindern.");
    AddDetail("zugang",
        "Es gibt von hier aus keinen Zugang zu den Klippen. Waere ja auch "
        "viel zu gefaehrlich!");
    AddDetail(({"wiese"}),
        "Naja, 'Wiese' waere zuviel gesagt, dieser Teil der Gaerten ist "
        "recht verwildert, so dass neben allerlei Graesern auch Moos den "
        "Boden bedeckt. ");
    AddDetail(({"baum","baeume"}),
        "Die Lichtung wird vor allem noerd- und westlich von Baeumen "
        "gesaeumt. Es scheinen Purpureschen zu sein, wie Du anhand der "
        "vielgliedrigen roetlichen Blaetter gut erkennen kannst.");
    AddDetail(({"garten","gaerten","freiheit","freiheiten"}),
        "Der Natur wurden hier einige Freiheiten mehr eingeraeumt, jedenfalls "
        "sieht es hier nicht allzu gepflegt aus. Dein Sinn fuer Gruenes (Du "
        "stellst fest: Du hast einen!) meint aber, dass das ganz ok so ist. "
        "Westlich von Dir liegt ein Haufen Geaest herum.");
    AddDetail("sinn fuer gruenes",
        "Du hast zu Deiner Ueberraschung einen Sinn fuer Gruenes.");
    AddDetail("gruenes", "Hier ist ziemlich viel ziemlich gruen. Bis auf "
        "die Purpureschen.");
    AddDetail("ueberraschung", "Woah.");
    AddDetail("sinn",
        "Der Sinn des Lebens oder der Sinn allgemein ist von einem jeden "
        "Lebewesen selbst zu ermitteln ... oder zu ignorieren. "
        "Das funktioniert schon sehr lange sehr gut.");
    AddDetail("lebewesen",
    (["Untoter":"Du bist eines. Ja, sogar Du!",
             0:"Du bist eines." ]));

    AddDetail(({"richtung","richtungen"}),
        "Naja, Du bist in der eher entlegenen Nordwestecke des Gartens. "
        "Der See des Lebens liegt im Suedosten, der Garten erstreckt sich "
        "oestlich um ihn herum. Irgendwo im Norden waehnst Du einige "
        "Gebaeude, die Du aber nicht sehen kannst, waehrend es westlich "
        "von Dir vermutlich steil nach unten geht.");
    AddDetail(({"ecke","nordwestecke"}),
        "Naja, 'Ecke' ist eigentlich zuviel gesagt, aber es ist hier schon "
        "etwas abgelegen. Fuer gewoehnlich scheint hier, von kleinen "
        "Stelldicheins abgesehen, nichts zu passieren.");
    AddDetail("stelldichein",
        "Also wenn eine Nachtelfin... aeh, kann natuerlich auch ein Nachtelf "
        "sein... also wenn ein Nachtelf... irgendein Elf... oder Zwerg... oder "
        "Mensch... also wenn irgendein Wesen irgendein anderes Wesen vom "
        "anderen... aeh... oder gleichen? ... egal welchen Geschlechtes (es "
        "sei denn, es sind neutrale Wesen...) trifft, dann... aeh... also "
        "Du weisst bestimmt, was gemeint ist.");
    AddDetail("geschlecht","Hier, in der Oeffentlichkeit? Such' Dir dazu "
        "besser eine Postkabine...");
    AddDetail("oeffentlichkeit",
        "Hier kann ja jeder vorbeischauen!");
    AddDetail(({"postkabine","kabine"}),
        "Such' doch, hier wirst Du keine finden.");
    AddDetail(({"wesen","zwerg","elf","nachtelf","nachtelfin","mensch"}),
        "Kann natuerlich auch ein Hobbit sein.");
    AddDetail("hobbit",
        "Oder ein Brrrrrrrrrrtflllt.");
    AddDetail("brrrrrrrrrrtflllt",
        "Hae? Was bitte ist ein 'brrrrrrrrrrtflllt'?\n"
        "Soetwas siehst Du hier bestimmt nicht!\n"
        "Ausserdem hat das so wenig Vokale...\n");
    AddDetail(({"vokale","vokal"}),
        "Sind das nicht diese Trinkgefaesse?");
        AddDetail(({"trinkgefaess","trinkgefaesse"}),
        "Na, dingens, wie hiessen sie noch?");
    AddDetail(({"pokale","pokal"}),
        "Das ist ja unglaublich - dort hinten liegt tatsaechlich "
        "eine versteckte Ehrung. Unfassbar, und Du hast sie gesehen!");
    AddSpecialDetail("ehrung","detailEhrung");
    AddDetail("lichtung",
        "Du stehst auf einer Lichtung, sie ist ringsum von Bueschen und "
        "Baeumen gesaeumt und oeffnet sich nur zum See hin. Ein netttes "
        "und abgeschiedenes Plaetzchen.");
    AddDetail("plaetzchen",
        "Ein sehr nettes und abgeschiedenes Plaetzchen. Und der Boden ist "
        "auch sehr weich!");
    AddDetail("duft",
        "Oh, Purpureschen haben tatsaechlich einen besonderen "
        "Duft.");

    AddSmell(({"luft","purpuresche","duftquelle","purpureschen"}),
        "Muehelos machst Du die Purpureschen als Duftquelle fuer den herben "
        "Duft aus, der hier in der Luft liegt.");
    AddDetail("luft",
        "Du siehst die Luft nicht, aber zweifellos ist sie da.");
    AddDetail("duftquelle",
        "Das duerften dann wohl die Purpureschen sein.");
    AddDetail(({"natur","portion"}),
        "Du stehst hier inmitten einer Portion Natur. Und da "
        "die Pflege der Gaerten diesen Teil offenbar etwas naturnaeher "
        "gestaltet, ist die Portion gewaltig.");

    AddCmd(({"suche","such"}),"cmdSuche");  /* Postkabine */
    AddCmd(({"fuehl","fuehle"}),"cmdFuehle");
    seteuid(getuid(this_object()));
    AddExit("osten","./garten_n");
    AddExit("suedosten",([EX_FUNC:#'seeExitTestfunc]));
    SetProp(P_HIDE_EXITS,({"suedosten"}));


    AddItem(NPC "critter/zwergkaninchen",REFRESH_DESTRUCT);

}



nosave string
detailSchnabel()
{
    if (!this_player()) 
        return "";

    Message(break_string(this_player()->Name(WER)+
        " fasst sich ins Gesicht und gibt probehalber ein paar "
        "Quaklaute von sich.\n"+this_player()->Name(WER)+
        " quakt: QUAK QUAK!",77,0,1),MSGFLAG_NO_TP);
    return break_string("Du fasst Dir ins Gesicht und gibst probehalber "
        "ein paar Quaklaute von Dir. Okay, hoert sich seltsam an, aber "
        "es ist noch alles dran.",77);
}


nosave string
detailGeaest()
{
    if (!this_player())
        return "";
    return "TODO\n";
}



nosave string
detailEhrung()
{
    if (!this_player())
        return "";
    if (!member(honored,file_name(this_player())))
    {
        honored+=([file_name(this_player())]);
        clone_object(OBJ "ehrung")->move(this_player(),M_NOCHECK);
        return 
            "Du siehst eine zweifelhafte Ehrung.\n"
            "Sie wird Dir prompt verliehen.\n";
    }
    else
        return "Oh ja, die Ehrung.\n";
}

nosave int
cmdFuehle(string was)
{
    notify_fail("Was willst Du fuehlen?\n");
    if ((!this_player()) || (!was) || (!stringp(was)) 
            || (was!="leben"))
        return 0;
    this_player()->Message(break_string(
        "Du horchst tief in Dich hinein, goennst Dir den Augenblick "
        "der Mediation, konzentrierst Dich auf den Moment. Den Atemzug. "
        "Du spuerst das Blut durch Deine Adern fliessen, die Luft durch "
        "Deine Nase ziehen. Du fuehlst Dein Herz schlagen. Du lebst.",77));
    Message(break_string(this_player()->Name(WER)+" versinkt fuer einen "
        "Augenblick in tiefer Meditation.",77),MSGFLAG_NO_TP|MSGFLAG_VISUAL);

    if ( ((string)this_player()->QueryProp(P_RACE))=="Untoter")
        this_player()->Message(break_string("Also dass Du als Untoter noch "
            "einen Herzschlag hoerst... es ueberrascht Dich selbst.",77));
    return 1;
}


nosave int
cmdSuche(string was)
{
    notify_fail("Du suchst, findest aber nichts.\n");
    if ((!this_player()) || (!was) || (!stringp(was))
        || (member((string*)cabin->QueryProp(P_IDS),was))<0)
        return 0;

    if (!member(cabin_found,file_name(this_player())))
    {
        cabin_found+=([file_name(this_player())]);
        this_player()->Message("Huch... Da hast Du doch eine gefunden!\n");
        call_out("CA_naToll",3);
        Message(break_string(
            this_player()->Name(WER)+" schaut ueberrascht.",77),
                MSGFLAG_VISUAL|MSGFLAG_NO_TP);
        return 1;
    }
    else
    {   
        notify_fail("Langweilig. Einmal gefunden siehst Du sie sofort...\n");
        return 0;
    }
}



public void
CA_naToll()
{
    if ((this_player()) && environment(this_player())==this_object())
        this_player()->Message("Na das ist ja grossartig.\n");
}

public int 
cabin_invis()
{
    return ( (!this_player()) 
            || (!member(cabin_found,file_name(this_player()))));
}

public void 
reset()
{
    ::reset();
    honored=([]);  // damit Geldquelle 1x/Reset/Nase
}

