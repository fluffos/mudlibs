inherit DOVENYA "std/room";


mapping taucher;   // Wer ist hier und muss irgendwann auftauchen?
string * zufluss;  // Wer hat den Zufluss gefunden?
int spalte;        // Ist noch was in der Spalte?

nosave void checkFishes();
varargs nosave void newFishes(int m_silent);

public void 
create() 
{
    ::create();
    taucher=([]);
    zufluss=({});
    spalte=1;
    SetProp(P_GEMA,({0,0}));
    SetProp(P_INDOORS,0);
    SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:22,
                             ENV_TERRAIN:TT_UNDERWATER,
                             ENV_WATER:4])); 
    SetProp(P_INT_SHORT,"Dovenya, unter Wasser *blubber* ");
    SetProp(P_INT_LONG,
        "Ui, der See ist ja tatsaechlich ein paar Meter tief... Du tauchst "
        "ein Stueckchen ueber dem felsigen Grund des See des Lebens "
        "herum.");
    AddDetail("see",
        "Du befindest Dich unter Wasser im See des Lebens. Du fuehlst Dich "
        "in der Tat lebendig, wirst aber wohl irgendwann wieder auftauchen "
        "muessen, um es auch zu bleiben. Richtig gross ist der See auch aus "
        "der Fischperspektive nicht, er ist etwa drei bis vier Meter tief "
        "und duerfte an seiner tiefsten Stelle auch nur knapp vier Meter "
        "im Durchmesser ausmachen.");
    AddDetail("wasser",
        "Das Wasser ist so klar, dass das Licht der Sterne ausreicht, "
        "um den Grund des Sees gut auszuleuchten. Du spuerst eine leichte "
        "Stroemung von irgendwoher, kannst sie aber nicht "
        "naeher lokalisieren.");
    AddDetail("leben","Spuerst Du es in Dir?");
    AddDetail("tat", "In der Tat.");
    AddDetail("meter","Waeren Dir Ellen lieber?");
    AddDetail("ellen","Wer ist Ellen? Ist sie huebsch?");
    AddDetail(({"stueck","stueckchen"}),"Naja, Du schrammst nicht "
        "schmerzhaft auf dem felsigen Grund herum, es ist also schon "
        "ein wenig Wasser zwischen Dir und dem Fels.");
    AddDetail(({"grund","boden"}),
        "Der Grund des Sees ist ziemlich felsig, ueberall Ritzen und Spalten, "
        "aus denen zum Teil irgendwelche Pflanzen hervorspriessen.");
    AddDetail("fischperspektive","*blubb* *blubb*, jedenfalls ist das hier "
        "nicht Deine normale Umgebung.");
    AddDetail("durchmesser",
        "Naja, der See hat mehr oder weniger eine Schuesselform, misst also "
        "an der Wasseroberflaeche einen deutlich groesseren Durchmesser als "
        "hier unten, an der tiefsten Stelle.");
    AddDetail(({"punkte","stern","sterne"}), 
        "Du kannst von hier unten nur ganz schwach vereinzelte (und "
        "verschwommene helle Punkte ausmachen. Falls Du Dich fuer die "
        "Astronomie interessierst, solltest Du besser wieder auftauchen.");
    AddDetail("licht","Licht ist etwas, das man zum Sehen braucht. Naja, "
        "zumindest fuer normale Leute trifft das zu. Aber - Dunkelelfen "
        "sind ja auch nicht normal, oder?");
    AddDetail("stroemung",
        "Hm, von irgendwoher fliesst hier Wasser rein, nur von wo?");
    AddSpecialDetail(({"oeffnung","zufluss"}),"detailZufluss");
    AddDetail("stelle",
        "Du befindest Dich in etwa an der tiefsten Stelle des Sees, in knapp "
        "vier Metern Tiefe. Du wusstest gar nicht, dass Du so locker so tief "
        "tauchen kannst. :)");
    AddDetail("fels","Der Grund des Sees ist in erster Linie felsig, die "
        "Pflanzen scheinen das, was sie zum Leben brauchen, durch das Licht "
        "(es scheint wirklich zu reichen) und aus dem Wasser zu gewinnen, "
        "beneidenswert eigentlich. Ansonsten siehst du an dem rissigen Fels "
        "nichts auffaelliges - er ist nass, aber das ist hier nun wirklich "
        "nicht verwunderlich.");
    AddDetail(({"ritze","ritzen"}), 
        "Die Ritzen sind sehr klein, sie reichen gerade aus, um dem zarten "
        "Wurzelwerk der Pflanzen ein wenig Halt zu bieten.");
    AddDetail(({"spalte","spalten"}),
        "Aus einigen Spalten scheinen die Pflanzen nur so zu quellen. Eine "
        "Spalte scheint sogar so gross zu sein, dass Du hineingreifen "
        "koenntest... ob es hier Muraenen gibt?");
    AddDetail("teil","Du denkst ihr Dir.");
    AddDetail("pflanzen",
        "Ui, wer haette gedacht, dass bei so wenig Licht noch etwas gedeihen "
        "koennte? Den Pflanzen hier unten scheint es aber praechtig zu gehen, "
        "was wohl an dem sehr reichhaltigen Wasser "
        "liegen muss. Eine besonders "
        "grosse Pflanze faellt Dir auf - sie sieht sehr alt aus, hier muss "
        "schon sehr lange etwas wachsen.");
    AddDetail("umgebung","Deine Umgebung besteht hauptsaechlich aus Wasser.");
    AddDetail("schuesselform","Der See ist in der Mitte am tiefsten.");
    AddDetail(({"wasseroberflaeche","oberflaeche"}),
        "Die Oberflaeche glitzert im Licht der Sterne, solche Dinge sehen von "
        "unten immer ganz geheimnisvoll und unheimlich ungewohnt aus.");
    AddDetail("dinge",
        "Naja, solche... Dinge halt.");
    AddDetail("linie","Auf Deine musst Du achten!");
    AddDetail("astronomie","Tip: \"tauche auf\".");
    AddDetail("dunkelelfen","Die sollte man besser nicht mit Nachtelfen "
        "verwechseln.");
    AddDetail("nachtelfen","Die sollte man besser nicht mit Dunkelelfen "
        "verwechseln.");
    AddDetail(({"wurzeln","wurzelwerk","wurzel"}),
        "Die Pflanzen halten sich mit ihren Wurzeln am Grund fest, um nicht "
        "nach oben oder sonstwie frei herum zu treiben.");
    AddDetail("halt","Stop.");
    AddDetail("stop","Bis Hierher und nicht weiter.");
    AddDetail("hierher","Aus jetzt.");
    AddDetail("aus","AUS!");
    AddDetail(({"muraene","muraenen"}),
        "Nein, hier gibt es keine Muraenen.\n... Bis jetzt noch nicht.\n");
    AddDetail("pflanze","Hier hat es viele Pflanzen!");
    AddSpecialDetail(({"grosse pflanze","besonders grosse pflanze"}),
        "detailPflanze");
    AddDetail("mitte",
        "Du treibst (Dich) unter Wasser in der Mitte des Sees herum.");
    AddDetail("etwas","Hmmmm, doch nicht.");
    AddDetail("luftblasen","Sie blubbern sich zur Wasseroberflaeche hoch.");
    
    AddSpecialDetail(({"bein","beine"}),"detailBeine");
    AddRoomMessage( ({
        "Neben Dir blubbern kleine Luftblasen nach oben.\n",
        "Huch, hat da hinten nicht irgendwas zwischen den "
        "Pflanzen herausgeschaut?\n","","",""
            }),200);
    
    seteuid(getuid(this_object()));

    AddCmd(({"greif","greife"}),"cmdGreife");
    AddCmd(({"suche","such"}),"cmdSuche");
    AddCmd(({"tauch","tauche"}),"cmdTauche");
    AddCmd(({"zerre","zerr"}),"cmdZerre");
    AddCmd(({"schwimm","schwimme"}),"cmdSchwimme");
    AddCmd(({"trinke","trink"}),"cmdTrinke"); // Huhu Woody :)
    AddCmd(({"kitzl","kitzele","kitzel","kitzle"}),"cmdKitzle");// Huhu Thor :)

    SetStupids(({"sehen","tiefe"}));
    checkFishes();
}

    /* Geister haben Unterwasser nix verloren. Oh, und Unterwasser
     * wird natuerlich geblubbert. :) */

public void 
init() 
{
    if ((this_player()) && (environment(this_player())==this_object()))
        if ((!IS_WIZARD(this_player())) 
            && (this_player()->QueryProp(P_GHOST))) 
        {
            write("Huch, wie kommst denn DU hier her?\n");
            if ((this_player()->move(DOVENYA_ROOM "uebersee",
                M_GO|M_SILENT|M_NO_SHOW))<0)
                DO_LOG(LOG "strange.log",
                    sprintf("ARGH! %s konnte nicht von Unterwasser "
                        "wegbewegt werden!\n",
                    capitalize(getuid(this_player()))));
            return;
        }    

    ::init();

    if ((this_player()) && (!this_player()->id("\a\n\a\tol_fisch"))) 
    {
        taucher+=([file_name(this_player()):time()]);
        if (!this_player()->QueryProp(P_PERM_STRING))
            this_player()->SetProp(P_PERM_STRING,this_object());
    }
    if (find_call_out("checkLoop")==-1)
        call_out("checkLoop",0);
    if (!present("\a\n\a\tol_fisch"))
        newFishes(M_SILENT);
}


 /* NICHT int_long(), da make_invlist() etc. nicht von Hand aufgerufen,
  * sondern lediglich die Raumlangbeschreibung je nach Umgebung angepasst 
  * werden soll */

public string 
_query_int_long() 
{

    int i;
    object * o;
    string err;
    string res;
    string * s;
    o=({});
                          
    res=Query(P_INT_LONG);
    if (!interactive(this_player())) 
        return res;
    o=(object *)call_other(DOVENYA_ROOM "see","GetVis");
    if (!sizeof(o)) 
        res+="Ueber Dir glitzert die sternenbeschienene Wasseroberflaeche.";
    else if (sizeof(o)==1)
        res+=sprintf("Ueber Dir strampeln einsam %s Beine herum.",
            o[0]->name(WESSEN));
    else 
    {
        s=map_objects(o,"name",WEN);
        res+=sprintf("Du kannst %s und %s "
            "als Silouetten gegen die glitzernde Wasseroberflaeche ausmachen." 
            ,implode(s[0..<2],", "),s[<1]);
    }
    return break_string(res,77);
}

varargs public string GetExits() {
  return "";
}

public void 
checkLoop() 
{
    object * p;
    object *li, * lv;

    /* wenn das jemand von Hand aufruft, gibt es sonst Traenen ... */
    while (remove_call_out("checkLoop")!=-1);

    li=({});
    lv=({});

    p=all_inventory(this_object());

    if (!sizeof(lv=filter_array(p,
        lambda( ({ 'x }),
                ({#'&& , ({ #'living, 'x }),
                         ({#'! , ({#'id , "\a\n\a\tol_fisch" }) })
                      }))))) /* Loop ohne Nichtfisch-Livings beenden! */
        return;

    while (sizeof(p)) 
    {  
        p+=all_inventory(p[0]);
        if (p[0]->id("Lichtquelle") || p[0]->isOpenFire())
        li+=({p[0]}); 
        p=p[1..];
    }
    for(;sizeof(li);li=li[1..]) 
        li[0]->extinguishByWater();
    
    for(;sizeof(lv);lv=lv[1..])
    {
        if (!member(taucher,file_name(lv[0])))
      ; // No more Logging here... :)
        else if ((time()-36)>(taucher[file_name(lv[0])])) 
        {
            lv[0]->Message("Hilft alles nichts, Du musst auftauchen.\n");
            li=(object *)lv[0]->QueryProp(P_ARMOURS);
            for (;sizeof(li);li=li[1..]) 
            {
                if (member(({AT_ARMOUR, AT_TROUSERS, AT_BOOT, AT_CLOAK}),
                    li[0]->QueryProp(P_ARMOUR_TYPE))!=-1)
                        li[0]->move(this_object(),M_PUT);
            } 
            catch( lv[0]->move(ROOM "see",M_GO,0,
                "taucht schwer nach Luft ringend nach oben an die Oberflaeche",
                "taucht neben Dir auf und schnappt heftig nach Luft"));
            taucher-=([file_name(lv[0])]);
        }
        else if ((time()-32) > (taucher[file_name(lv[0])]))
            lv[0]->Message("Dir geht langsam die Luft aus.\n");
    }
    if (sizeof(taucher))
            call_out("checkLoop",4);
} 

nosave int 
cmdTauche(string str) 
{
    if (!this_player()) 
        return 0;

    notify_fail("Moechtest Du auftauchen?\n");
    if ((!str)||((str!="auf")&&(str!="hoch")&&(str!="nach oben"))) 
        return 0;
    this_player()->Message("Du tauchst zur Wasseroberflaeche zurueck.\n");
    this_player()->move(ROOM "see",M_GO,0,
      "taucht wieder an die Oberflaeche",
      "taucht ploetzlich neben Dir auf");
    taucher-=([file_name(this_player())]);
    return 1;
}

nosave int 
cmdKitzle(string str) 
{
    object o;
    if (((!str)||(str=="")) || (!this_player()) 
            || (catch(call_other(ROOM "see","???"))) 
            || (!(o=present(str,find_object(ROOM "see")))) 
            || (!living(o))) 
        return 0;
    else 
    {
        this_player()->Message(break_string(sprintf(
            "Hihi, Du kitzelst einen von %s Fuessen an der Sohle und kannst "
            "%s erschrockenen Schrei sogar unter Wasser hoeren. Schnell "
            "ziehst Du Dich ein Stueckchen von %s heftigst strampelnden "
            "Beinen zurueck.",o->name(WESSEN), o->name(WESSEN),
            o->QueryPronoun(WESSEN)),77));
        Message(this_object(),break_string(sprintf(
            "%s laesst sich zu %s Beinen treiben und kitzelt dann die Sohle "
            "von einem der Fuesse, Du vernimmst sogar hier unter Wasser %s "
            "erschrockenen Schrei. Die Beine fangen wild zu "
            "strampeln an und schnell zieht sich %s von ihnen zurueck.",
            this_player()->Name(WER),o->name(WESSEN),o->name(WESSEN),
            this_player()->name(WER)),77),({this_player()}),
            MSGFLAG_VISUAL|MSGFLAG_NO_TP);
        o->Message(break_string(sprintf(
            "\aWAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAH!!!!!!!!!!!!! WAS WAR DAS? "
            "Irgendwas hat Dich eben an einer Fusssohle gekitzelt, und das "
            "wo Du da so furchtbar KITZELIG bist! Iiiiiiiiiiiiiiiks! Du "
            "strampelst wie %s und hoffst, dass das aufhoert.",
            ((int)o->QueryProp(P_GENDER)==FEMALE?
                "eine Wilde":"ein Wilder")),77));
        call_other(ROOM "see","Message",break_string(sprintf(
            "Ploetzlich schreit %s LAUT auf und faengt wie %s an, panisch mit "
            "den Beinen zu strampeln. Vielleicht solltest Du %s mal fragen, "
            "ob %s kitzelig ist...",o->name(WER),
            ((int)o->QueryProp(P_GENDER)==FEMALE?"eine Wilde":"ein Wilder"),
            o->QueryPronoun(WEN),o->QueryPronoun(WER)),77),({o}));
        return 1;
    }
}

nosave int 
cmdZerre(string str) 
{
    string target;
    object o;
    if (!this_player()) 
        return 0;
    if ((!str)||(str=="")) 
        return 0;
    if ((sscanf(str,"an beinen von %s",target)==1) 
            || (sscanf(str,"an beine von %s",target)==1) 
            || (sscanf(str,"an %s",target)==1)) 
    {
        notify_fail("Hm, schwimmt sojemand ueberhaupt daoben?\n");
        if (catch(call_other(ROOM "see","???"))) 
            return 0;
        if (!(o=present(target,find_object(ROOM "see")))) 
            return 0;
        notify_fail("Hat das Ding ueberhaupt Beine?!?\n");
        if (!living(o)) 
            return 0;
        this_player()->Message(break_string(sprintf(
            "Du packst %s Beine und zerrst einmal "
            "so richtig kraeftig daran. Du musst zwar hoellisch aufpassen, "
            "dass %s strampelnden Beine nicht versehentlich Deine Nase "
            "treffen, hast aber Erfolg, hehehe!",o->name(WESSEN),
            o->QueryPossPronoun(NEUTER,WEN,PLURAL)),77));
        Message(break_string(sprintf(
            "%s packt %s Beine und zerrt %s zu euch unter Wasser. ",
            this_player()->Name(WER), o->name(WESSEN),o->QueryPronoun(WEN)),
            77),MSGFLAG_VISUAL|MSGFLAG_NO_TP);
        o->Message(break_string(sprintf(
            "ARGH! Irgendwer hat Dich an den Beinen gepackt und zieht wie "
            "bloede nach unten! Du strampelst reflexartig wild herum, kannst "
            "aber gerade noch nach Luft schnappen, bevor %s Zerren Erfolg "
            "hat und Du unter Wasser verschwindest.",
                this_player()->name(WESSEN)),77));
        o->move(this_object(),M_GO,0,
            "schnappt ueberrascht nach Luft und verschwindet ruckartig "
            "und bestimmt nicht freiwillig unter Wasser",
            "taucht ein wenig unfreiwillig hier herunter");
        return 1;
    }
    notify_fail("An den Beinen von WEM moechtest Du zerren?\n");
    return 0;
}

/* Der "Fluch" des Unterwasserlebens: *blubb*  */

public string 
permutate_string(string str) 
{
    string * xx;
  
    if(!this_player()) 
        return str;
    if (environment(this_player()) != this_object()) 
    {
        this_player()->SetProp(P_PERM_STRING,0);
        return str;
    }
    if ((stringp(str)) && (str) && (strlen(str)<1000))
        return implode(explode(str," ")," *blubb* ");
    else 
        return str;
}

nosave object 
doClone() 
{
    string * s;
    object o;

    s=({ WEAPON "steindolch" });
    return clone_object(s[(random(sizeof(s)))]);
}

nosave void 
cmdGreife2() 
{
    write("Naja, da haette ja auch eine Muraene drin sein koennen.\n");
    return;
}

nosave int 
cmdGreife(string was) 
{ 
    object o;

    notify_fail("Wo willst Du hingreifen oder wo willst Du reingreifen?\n");
    if (!was) 
        return 0;
    if ((was=="in spalte") || (was=="in spalt")) 
    {
        Message(break_string(sprintf(
            "%s fummelt am Boden herum.\n",
            this_player()->Name(WER)),77),MSGFLAG_VISUAL|MSGFLAG_NO_TP);
        write("Du greifst, mutig, wie Du bist, gaaaanz "
            "vorsichtig in die Spalte.\n");
        if ((spalte)&&(o=doClone())) 
        {
            spalte=0;
            o->move(this_object(),M_NOCHECK);
            write("Hey, da lag ja etwas drin!\n");
            if (o->move(this_player(),M_GET)<0) 
                write("Leider kannst Du es nicht mehr tragen.\n");
        }
        else 
        {
            write("Och, die Spalte ist leer.\n");
            call_out("cmdGreife2",2); 
        }
        return 1; 
    }
    if ( (was=="in oeffnung") || (was=="in zufluss")) 
    {
        write ("Du schaffst es nicht, gegen die Stroemung "
            "in den kleinen Zufluss zu greifen.\n");
        return 1;
    }
    notify_fail("Hm, das klappt nicht.\n");
    return 0; 
}


