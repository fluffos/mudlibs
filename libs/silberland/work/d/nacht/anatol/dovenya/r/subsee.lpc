}

nosave int 
cmdSchwimme() 
{
    if (!this_player()) return 0;
    write(break_string("Aeh, unter Wasser? Ausserdem ist hier nicht so "
        "furchtbar viel Platz fuer Aquajogging. Aber bitte: Du ruderst "
        "ein wenig mit den Armen herum und haengst kurzfristig verkehrtherum "
        "im Wasser. Ueberaus laecherlich sieht das aus.",77));
    Message(
        break_string(sprintf("%s rudert ein wenig unbeholfen mit den Armen, "
          "erreicht damit aber nur, dass %s fuer einen Moment mit dem Kopf "
          "nach unten im Wasser haengt. Sieht wirklich laecherlich aus... :)",
          this_player()->Name(WER),this_player()->QueryPronoun(WER)),77),
          MSGFLAG_VISUAL|MSGFLAG_NO_TP);
    return 1;
}

nosave int 
cmdSuche(string was) 
{ 
    if (!this_player()) 
        return 0;
    if (!was) 
        return 0;
    Message(break_string(sprintf(
            "%s taucht ein wenig herum.\n",this_player()->Name(WER)),77),
                MSGFLAG_VISUAL|MSGFLAG_NO_TP);
    if (was=="zufluss") 
    {
        write("Du tauchst ein wenig hin und her und tatsaechlich!\nDu findest "
            "die Oeffnung, aus der Wasser in den See zu stroemen scheint!\n");
        zufluss+=({file_name(this_player())});
    }
    else if (was=="abfluss") 
        write("Seltsam, aber Du kannst den Abfluss - oder was auch immer "
        "- nicht finden.\n");
    else return 0;
    return 1; 
}



nosave string 
detailBeine() 
{
    object * o;

    if (!this_player()) 
        return 0;
    if (catch(o=(object *)call_other(ROOM "see", "getOthers")))
        return "Hm, Du siehst einen Fehler, aber keine Beine...\n";
    else if (!sizeof(o))
        return "Ueber Dir sind leider keine Beine, an denen "
            "man zerren koennte.\n";
    else if (sizeof(o)==1)
        return break_string(sprintf(
            "Ueber Dir siehst Du nur %s strampelnde Beine.\n",
            o[0]->name(WESSEN)),77);
    else
        return break_string(sprintf(
            "Ueber Dir siehst Du die Beine von %s und %s strampeln. Viel "
            "Auswahl... >:)",
                implode(map_array(o[0..<1],"name",WEM),", "),
            o[<1]->name(WEM)),77);
}

public void 
BecomesNetDead(object who) 
{
    taucher-=([file_name(who)]);
    who->move(ROOM "see",M_GO,0,
        "treibt netztot nach oben",
        "treibt netztot an die Oberflaeche");
    call_other(ROOM "see", "BecomesNetDead",who);
    return;
}

public void 
reset() 
{
    ::reset();
    checkFishes();
    spalte=1;
}

nosave void 
checkFishes() 
{
    object * o;

    o=all_inventory(this_object());
    for (;sizeof(o);o=o[1..])
        if (living(o[0]) && o[0]->id("\a\n\a\tol_fisch"))
            o[0]->SchwimmDavon();
   
    // Neue Fische nur, wenn jemand *da* ist, der nicht hergehoert.

    if (!sizeof(filter_array(all_inventory(this_object()),
        #'living )))
        return;
    else
        newFishes();
}


varargs nosave void
newFishes(int m_silent)
{

    string * s;
    object ob;

    s=get_dir(NPC "fisch/*.lpc");
    if (sizeof(s)) 
    {
        if (catch(ob=clone_object(NPC "fisch/"+s[(random(sizeof(s)))][0..<3])))
            return;
        if (objectp(ob) && (ob))
            ob->move(this_object(),M_GO|M_NOCHECK|m_silent);
        if (catch(ob=clone_object(NPC "fisch/"+s[(random(sizeof(s)))][0..<3])))
            return;
        if (objectp(ob) && (ob))
            ob->move(this_object(),M_GO|M_NOCHECK|m_silent);
    }
    return;
}

 

