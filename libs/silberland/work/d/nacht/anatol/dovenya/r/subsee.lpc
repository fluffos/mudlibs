nosave int 
cmdTrinke() 
{  // Fuer Woody :)
    write(break_string("Was auch immer Du trinken willst... vergiss es! "
      "Falls Du es auf das (gesunde) Wasser abgesehen hast, geh' doch "
      "in die 'Sternschnuppe', wie jeder andere auch...",77));
