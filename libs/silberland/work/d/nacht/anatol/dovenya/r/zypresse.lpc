#pragma strict_types
#define WIZARD "anatol"

#define SAVEFILE   DOVENYA_SAVE "zypresse"
#include "../defines.h"

inherit DOVENYA "std/garten";

public int closed;
public mapping banned;

object delilah;

nosave void save()
{
    save_object(SAVEFILE);
}

nosave string
smellOdeur()
{
    if (!this_player()) 
        return "";
    this_player()->Message(break_string(
        "Du bist hin und weg... dieser Duft "
        "verwirrt Dir Deine Sinne. Du kommst ins straucheln und "
        "faellst, oh jeh, vom Baum.",77));
    Message(break_string(
        this_player()->Name(WER)+" schnueffelt herum, torkelt dann "
        "wie von Sinnen herum und faellt - gluecklicherweise in "
        "westlicher Richtung - vom Baum. Platsch.",77),MSGFLAG_NO_TP);

    seeExitTestfunc();
    return "(Wenigstens weich gefallen...)\n";
}


nosave string 
readDetailZettel()
{
    string * texts;
    texts= ({
        "Ken sent me.",
        "Beschwerde von Lhjana ('Woody mogelt') nachgehen.",
        "({#'call_other, ({ #'this_player }), \"die\" })",
        "<irgendetwas dahingekritzeltes>",
        "Oh, das ist eine Bleistiftzeichnung einer unbekleideten "
        "Nachtelfe. Sehr talentiert. Der Zeichner. Aeh... und die "
        "Nachtelfe auch. Sie kommt Dir vage bekannt vor.",
        "Par. 4 Abs 2:\nLegitim ist das sofortige unverhinderbare "
        "Toeten eines hochstufigen Spielers als Ausnahme zu Par. 3 "
        "dann, wenn der Spieler durch mindestens eine der "
        "folgenden Aktionen eine negative Wirkung haette ableiten "
        "koennen\n"
        "- fluechtiges Untersuchen,\n"
        "- Identifikation,\n"
        "- Gespraech mit einem NPC,\n"
        "- Beachten einer expliziten Warnung\n"
        "Mit Spielerbeschwerden sind in einem solchen Fall gemaess "
        "Par. 7 zu verfahren.",
        "Zen-Frage des Monats: ''Wenn ein Mann etwas sagt, und kein "
        "Frau da ist, die ihm zuhoert - hat er dann trotzdem Unrecht?''",
        "Sehr geehrter Herr,\n\n"
        "Ihr Antrag zur Bewilligung eines Patents auf einen unsichtbaren "
        "magischen Reissverschluss gem. Anlagen 1 und 2 wurde zur "
        "weiteren Pruefung an unsere Fachabteilung weitergegeben.\n"
        "Wir bitten Sie um etwas Geduld.\n\n"
        "\nMit freundlichen Gruessen,\n"
        "    i.A. Grimmick, Verwaltungsgoblin\n"
        "\n(aeh ja hallo hier Nadija von der fachabteilung textilpruefung "
        "II, also das ist ja schon schick Ihre erfindung, keine druckstellen "
        "alles schoen glatt enganliegend voll erotisch mir gefaellt das und "
        "meinem mann auch. ... ... aber wenn man vergessen hat ob der "
        "reissverschluss vorn hinten oder an der seite war ist man voll "
        "geleimt echt!!!!!)",
        "''... Doch da ich im Lichte Deines dicht auf mich gerichteten "
        "neugierig-erwartungsvollen Blicks das alles weder klar noch vage "
        "Dir zu sagen wage, sage ich auf Deine Frage: Och, nix.''\n\n"
        "Schau an, ein Bodo-Wartke-Fan."
        });

        return break_string("\n"+texts[random(sizeof(texts))]+"\n\n",77,0,1);
}


public void 
create() 
{
    ::create();
    seteuid(getuid(this_object()));
    if (!restore_object(SAVEFILE))
    {
        closed=0;
        banned=([]);
    }

    SetProp(P_INT_SHORT,"Dovenya, eine Nachtzypresse");
    SetProp(P_INT_LONG,
        "Oh...wow. Du befindest Dich in der Krone einer alten Nachtzypresse "
        "in Dovenyas Gaerten der Ruhe. Obwohl der Baum nicht sehr hoch ist, "
        "ist die Aussicht beeindruckend, Du hast einen tollen Blick auf den "
        "nebelverhangenen See, die Siedlung und, da das 'Blattwerk' der "
        "Zypresse altersbedingt licht ist, auf den Himmel. Hier oben hat es "
        "sich jemand gemuetlich eingerichtet: Die Krone der Zypresse "
        "beherbergt eine von unten nicht sichtbare (geschweige "
        "denn einsehbare) Plattform von etwa drei Metern Durchmesser, an "
        "deren Rand eine kleine Holzkiste steht und ansonsten allerlei "
        "Kissen und Decken herumliegen.");

    Sky();

    AddSound(({DEFAULT_SOUND, "lufthauch", "hauch"}),
        "Leise wispert ein Lufthauch durch das Blattwerk der Zypresse.");

    AddSmell(({DEFAULT_SMELL}),
        "Es riecht nach Graesern, Holz, nach rauer See... und "
        "entfernt nach dem aufregenden Odeur einer aufregenden Frau.");

    AddSmell("odeur",#'smellOdeur);
    AddDetail("odeur",#'smellOdeur);

    AddDetail(({"holz"}),
        "Du bist in einem Baum. Hier ist quasi ueberall Holz.");
    AddDetail(({"graeser","wiese","gras"}),
        "Die Wiese ist weit unter Dir.");
    AddDetail("ruhe",
        "Jetzt wo Du es sagst... sogar hier oben ist es erstaunlich "
        "ruhig.");
    AddDetail("baeume",
        "Du bist auf einem Baum. Andere Baeume siehst Du von hier aus "
        "nicht.");
    AddDetail("details",
        "Details kannst Du von hier aus keine ausmachen.");
    AddDetail("dovenya",
        "Die Siedlung und ihre Gaerten liegen in der Nacht vor Dir. "
        "Details sind von hier aus nicht auszumachen, auf den See, "
        "immerhin, hast Du einen recht guten Blick.");
    AddDetail("nacht",
        "Es ist dunkel.");
    AddDetail(({"sicht","blick","aussicht","wunder"}),
        "Die Aussicht ist wirklich beeindruckend. Der Himmel... der See... "
        "Wow. Kein Wunder hat es sich hier oben jemand gemuetlich gemacht.");
    AddDetail("siedlung",
        "Die Siedlung liegt im Norden. Leider ein kleinwenig zu weit "
        "weg, als dass noch Details auszumachen waeren.");
    AddDetail("rand",
        "Der Rand der Plattform ist ungesichert, wirklich herunterfallen "
        "kann man aber wegen der vielen Aeste eigentlich nicht, es gibt "
        "nur eine passende Luecke.");
    AddDetail("pinzette",
        "Ab und zu gibt es offenbar auch sehr kleine Probleme, die "
        "geloest werden muessen...");
    AddDetail(({"problem","probleme"}),
        "Magier haben Probleme in allen Groessen.");

    AddDetail(({"krone","baumkrone"}),
        "Das seltsame Gestruepp der Zypresse ist nach unten hin recht dicht, "
        "oben aber altersbedingt schon sehr gelichtet. Der Baum ist sehr "
        "wahrscheinlich aelter als die Siedlung der Nachtelfen. Und die ist "
