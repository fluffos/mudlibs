public int
PreventInsert(object ob)
{
    if ( (interactive(ob) && (getuid(ob) == WIZARD) )
        || (file_name(ob)[0..23]==file_name(this_object())[0..23])
        || (file_name(ob)[0..(strlen("/players/"+WIZARD))]==
            "/players/"+WIZARD+"/")) return 0;
   return ((living(ob)) && ((closed) || (member(banned,getuid(ob)))));
}


public void init()
{
    ::init();

    if ((this_player()))
    {
        if (PreventInsert(this_player()))
        {
            write("Bitte respektiere das 'nicht stoeren!'-Schild.\n");
            this_player()->move(QueryProp(P_EXITS)["unten"],
                M_SILENT|M_GO|M_NOCHECK);
        }
        else if ((this_player()->QueryProp(P_INVIS))
                && (environment(this_player())==this_object() ))
        {
            this_player()->Message(
            "OBACHT - in der Nachtzypresse bist Du fuer Spieler sichtbar!\n");
            Message(break_string("("+
                capitalize(getuid(this_player()))+") betritt unsichtbar "+
                "den Raum.",77),MSGFLAG_NO_TP);
        }
    }
}

private nosave int
legit()
{
    return  ((this_player()) 
        && (this_interactive())
        && (this_player()==this_interactive())
        && (!process_call())
        && getuid(this_player())==WIZARD);
}
    
nosave int
cmdBann(string who)
{
    if (!legit()) 
        return 0;
   
    if ((!stringp(who)) || who=="")
    {   
        write(break_string("Derzeit enthaelt die 'wir muessen leider "
           "draussenbleiben'-Liste: "+implode(m_indices(banned),", ")+".",77));
     }
     else if (member(banned,(who=lower_case(who))))
     {
        write("'"+who+"' von der Liste genommen.\n");
        banned-=([who]);
     }
     else
     {
        write("'"+who+"' auf die Liste genommen.\n");
        if ((find_player(who))
           && (environment(find_player(who)) == this_object()))
            find_player(who)->move(QueryProp(P_EXITS)["unten"], 
                M_GO|M_NOCHECK);
            
            
        banned+=([who]);
     }
     save();
     return 1;
}

nosave int
cmdTuer(string what)
{

    if (!legit()) 
        return 0;
   
    if (!stringp(what))
        what="";

    switch (what)
    {
    case 0:
    case "":
        write("Die virtuelle Tuer ist zur Zeit "+
                (closed?"geschlossen":"offen")+".\n");
        break;
    case "auf":
    case "oeffnen":
        write("Die virtuelle Tuer ist "+
            (closed?"jetzt":"doch schon")+" offen.\n");
        closed=0;
        break;
    case "zu":
    case "schliessen":
        write("Die virtuelle Tuer ist "+
            (closed?"doch schon":"jetzt")+" geschlossen.\n");
        closed=1;
        break;
    default:
        return 0;
    }
    save();
    return 1;
}


/* von std/container/description: */

#define MI_ARRAY        0x0001          // return as array
#define MI_NO_GROUP     0x0002          // do not group identical items
#define MI_TAG_KEPT     0x0004          // tag items marked as kept

private void 
stringenize(mixed obj, int wiz, int flags, mixed objs, mixed info)
{
    string id, tmp;
    int idx, nogroup;

    // Kein Gruppieren, wenn: wiz (mit Pfaden), via Option sowie bei Livings
    nogroup = wiz || (flags & MI_NO_GROUP) || living(obj);

    /* ANFANG SONDERLOCKE */
    if (obj->QueryProp(P_INVIS))
    {
        tmp = "(" + capitalize( 
            (query_once_interactive(obj)
                ?(interactive(obj)
                    ?getuid(obj)
                    :getuid(obj)+" (netztot)")
                :process_string((string)(obj->QueryProp(P_SHORT))) || "" )
                +").");
    }
    else  /* ENDE SONDERLOCKE */
        tmp = capitalize(obj->short() || "")[0..<2];
             
    if (wiz)
        tmp += " [" + wiz_hdr(obj) + "]";

    if ( (flags & MI_TAG_KEPT) &&
            objectp(vwr) &&
            (string)(obj->QueryProp(P_KEEP_ON_SELL)) == getuid(vwr) )
        tmp = "+" + tmp;

    if (nogroup)
        id = file_name(obj);
    else 
        id = explode(file_name(obj), "#")[0] + tmp;

    if((idx = member(objs, id)) == -1)
    {
        objs += ({ id });
        info += ({ ({ tmp, 1, obj, obj->QueryProp(P_TOTAL_WEIGHT) }) });
    }
    else
    {
        info[idx][1]++;
        info[idx][3] += (int)(obj->QueryProp(P_TOTAL_WEIGHT));
    }
}


public void 
heart_beat()
{
    if (!objectp(delilah))
    {
        catch(call_other(NPC "delilah","???"));
        delilah=find_object(NPC "delilah");
    }
}
