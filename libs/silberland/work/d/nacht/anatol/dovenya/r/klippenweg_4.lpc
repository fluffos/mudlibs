/* Dovenya, Klippenweg 
 * _____________________________________(i) Anatol@Silberland (1998-2012) */


#pragma strict_types

#include "../defines.h"

inherit DOVENYA "std/room";


public void 
create() 
{
    ::create();

    SetProp(P_INDOORS,0);
    
    SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:23,
                            ENV_TERRAIN:TT_TOWN,
                            ])); 

    SetProp(P_INT_SHORT,"Dovenya, Klippenweg");
    SetProp(P_INT_LONG,
        "Westlich von hier vollzieht der Klippenweg einen Knick. Hier "
        "fuehrt er in oestlicher Richtung naeher an die Klippen "
        "heran, waehrend der Bewuchs um ihn herum im Westen staerker wird."
        );
    
    SetProp(P_GEMA,({6,6,0}));
    
    AddDetail(({"xxx"}),"");

    seteuid(getuid(this_object()));
    Sky();
  
  
    AddExit("westen",
        ([ EX_DEST: "./klippenweg_3", 
           EX_PLMSG: "Du folgst dem Klippenweg nach Westen.\n",
           EX_MSG: "den Klippenweg entlang nach Westen"
               ]));
 
    AddExit("osten",
        ([ EX_DEST: "./klippenweg_5", 
           EX_PLMSG: "Du folgst dem Klippenweg in Richtung der Klippen\n",
           EX_MSG: "den Klippenweg entlang nach Osten"
               ]));

    SetProp(P_HIDE_EXITS,({""}));

}
