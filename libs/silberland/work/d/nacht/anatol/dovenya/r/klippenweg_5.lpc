/* Dovenya, Klippenweg 
 * _____________________________________(i) Anatol@Silberland (1998-2012) */


#pragma strict_types

#include "../defines.h"

inherit DOVENYA "std/room";


public void 
create() 
{
    ::create();

    SetProp(P_INDOORS,0);
    
    SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:23,
                            ENV_TERRAIN:TT_TOWN,
                            ])); 

    SetProp(P_INT_SHORT,"Dovenya, Klippenweg");
    SetProp(P_INT_LONG,
        "Im Nordosten kann man offenbar so etwas wie einen Aufzug ausmachen, "
        "waehrend der Klippenweg in westlicher Richtung wohl zum Dorf fuehrt. "
        );
    
    SetProp(P_GEMA,({7,6,0}));
    
    AddDetail(({"xxx"}),"");

    seteuid(getuid(this_object()));
    Sky();
  
  
    AddExit("westen",
        ([ EX_DEST: "./klippenweg_4", 
           EX_PLMSG: "Du folgst dem Klippenweg nach Westen.\n",
           EX_MSG: "den Klippenweg entlang nach Westen"
               ]));
 
    AddExit("nordosten",
        ([ EX_DEST: "./plattform", 
           EX_PLMSG: "Du folgst dem Klippenweg nach Nordosten "
           "und trittst auf eine Plattform.\n",
           EX_MSG: "nach Nordosten auf eine Plattform"
               ]));

    SetProp(P_HIDE_EXITS,({""}));

}
