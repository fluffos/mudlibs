/* Dovenya, Klippenweg 
 * _____________________________________(i) Anatol@Silberland (1998-2012) */


#pragma strict_types

#include "../defines.h"

inherit DOVENYA "std/room";


public void 
create() 
{
    ::create();

    SetProp(P_INDOORS,0);
    
    SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:23,
                            ENV_TERRAIN:TT_TOWN,
                            ])); 

    SetProp(P_INT_SHORT,"Dovenya, Klippenweg");
    SetProp(P_INT_LONG,
        "Oestlich des Klippenwegs - direkt an der Felswand - steht ein "
        "kleines Wachhaeuschen. Vermutlich wird da nicht viel gewacht. "
        "Im Sueden scheint es zum Kern der Siedlung zu gehen."
        );
    
    SetProp(P_GEMA,({5,5,0}));
    
    AddDetail(({"xxx"}),"");

    seteuid(getuid(this_object()));
    Sky();
  
  
    AddExit("suedwesten",
        ([ EX_DEST: "./klippenweg_1", 
           EX_PLMSG: "Du gehst den Weg entlang Richtung Marktplatz.\n",
           EX_MSG: "nach Suedwesten Richtung Marktplatz"]));
 
    AddExit("osten",
        ([ EX_DEST: "./wache", 
           EX_PLMSG: "Du trittst in das Wachhaus.\n",
           EX_MSG: "in das Wachhaus"
               ]));

    AddExit("norden",
        ([ EX_DEST: "./klippenweg_3", 
           EX_PLMSG: "Du folgst dem Klippenweg nach Norden.\n",
           EX_MSG: "den Klippenweg entlang nach Norden"
               ]));

    SetProp(P_HIDE_EXITS,({"osten"}));

}
