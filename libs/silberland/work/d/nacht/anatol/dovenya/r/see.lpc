 /* NICHT int_long(), da make_invlist() etc. nicht von Hand aufgerufen,
  * sondern lediglich die Raumlangbeschreibung je nach Umgebung angepasst 
  * werden soll */

public string 
_query_int_long() 
{
    int i;
    object * o1, * o2;
    string err;
    string res;
    string * s;
    o2=o1=({});
                          
    res=Query(P_INT_LONG);
    if (!interactive(this_player())) 
        return res;
    for (i=sizeof(ENVROOMLIST)-1;i>=0;i--) 
    {
        if (err=catch(call_other(ENVROOMLIST[i],"???")))
            write_file(LOG "errors.log",sprintf("%s: (see) %s: %s\n",
                dtime(time()), ENVROOMLIST[i], err));
        else
            o1+=filter_array(all_inventory(find_object(ENVROOMLIST[i])),
            "isVisLiving",this_object());
    }

    if (err=catch(call_other(DOVENYA_ROOM "uebersee","???")))
        write_file(LOG "errors.log",sprintf("%s: (see) %s: %s\n",
            dtime(time()), DOVENYA_ROOM "uebersee", err));
    else o2=filter_array(all_inventory(find_object(DOVENYA_ROOM "uebersee")),
          "isVisLiving",this_object());

    if (!sizeof(o2)) res+="Ueber Dir ist nur das Sternenmeer, ";
    else if (sizeof(o2)==1)
        res+=sprintf("Ueber dem See kannst Du %s Geist ausmachen, ",
            o2[0]->name(WESSEN));
    else 
    {
        s=map_objects(o2,"name",WEN);
        res+=sprintf("Du kannst die Geister von %s und %s ueber dem See "
            "schweben sehen, " ,implode(s[0..<2],", "),s[<1]);
    }
    if (!sizeof(o1)) 
        res+="der Garten der Ruhe scheint "+(sizeof(o2)?"jedoch":"ebenfalls")
            +" verlassen.";
    else if (sizeof(o1)==1) 
        res+=sprintf("im Garten der Ruhe haelt sich "+
            "%s%s auf.",(sizeof(o2)?"":"wenigstens "), o1[0]->name(WER));
    else 
    {
        s=map_objects(o1,"name",WER);
        res+=sprintf(
          "im Garten der Ruhe halten sich %s%s und %s auf.",
          (sizeof(o2)?"":"jedoch "),implode(s[0..<2],", "),s[<1]);
    }  
    return break_string(res,77);
}


varargs public string 
GetExits() 
{
    return "";
}


/* Der Loop knipst bei Bedarf das Licht aus, zieht Spieler unter Wasser und
 * laesst Gegenstaende untergehen...           */

public void 
checkLoop() 
{
    object * p;
    object * li, * lv;
    mixed res1, res2;

    while (remove_call_out("checkLoop")!=-1);
    li=({});
    lv=({});
    p=all_inventory(this_object());

    if (!sizeof(filter_array(p,#'living))) /* Loop ohne Livings beenden! */
        return;
    while (sizeof(p)) 
    {  
        p+=all_inventory(p[0]);
        catch(res1=(string)p[0]->QueryProp(P_ARMOUR_TYPE));
        catch(res2=(string)p[0]->QueryProp(P_WORN));
        if ((res1) && 
            (member(({AT_ARMOUR, AT_TROUSERS, AT_BOOT, AT_CLOAK}),res1)!=-1)
            && (res2))
            lv+=({res2});             
        res1=res2=0;
        catch(res1=(int)p[0]->id("Lichtquelle"));
        catch(res2=(int)p[0]->isOpenFire());
        if ((res1) && (res2))
            li+=({p[0]}); 
        p=p[1..];
    }
    for(;sizeof(li);li=li[1..]) 
        catch(li[0]->extinguishByWater());
    for(;sizeof(lv);lv=lv[1..])
        if ((random(5)==3) && (environment(lv[0])==this_object())) 
        {
            lv[0]->Message("Das Gewicht Deiner sich vollsaugenden "
                "Kleidung zieht Dich unter Wasser.\n");
            catch( lv[0]->move(ROOM "subsee",M_GO|M_NOCHECK,0,
                "wird von der Schwere nasser Kleidung nach unten "
                "gezogen und verschwindet gluckernd im See",
                "taucht vergeblich nach Luft schnappend neben Dir auf... "
                "aeh unter"));
        }
    p=all_inventory(this_object());
    for (p-=filter_array(p,#'living);sizeof(p);p=p[1..]) 
    {
        Message(this_object(),break_string(sprintf(
            "%s sinkt leise blubbernd auf den Grund des Sees.\n",
            p[0]->Name(WER)),77));
        call_other(ROOM "subsee","Message",break_string(sprintf(
            "%s sinkt leise blubbernd von oben herab.\n",
            p[0]->Name(WER)),77));
        catch(p[0]->move(ROOM "subsee",M_NOCHECK));
    } 
    call_out("checkLoop",4);
} 


nosave string 
detailKopf() 
{
    if (!this_player()) return "";
    Message(
        break_string(sprintf("Besorgt fasst sich %s ploetzlich an den Kopf. "
          "Als %s aber merkt, dass %s Kopf noch dran ist, hellt sich %s Miene "
          "schlagartig wieder auf.",this_player()->name(WER),
          this_player()->QueryPronoun(WER),
          this_player()->QueryPossPronoun(MALE,WER,SINGULAR),
          this_player()->QueryPossPronoun(FEMALE,WER,SINGULAR)),77),
          MSGFLAG_NO_TP);
    return "Du fasst Dir an den Kopf. Jawoll, noch da! Puh! :)\n";
}

nosave string detailGebuesch() {
  return "QUESTFUNDSTELLE SEE (C)\n";
}

public void 
BecomesNetDead(object who) 
{
    catch(who->move(ENVROOMLIST[random(sizeof(ENVROOMLIST))],M_GO,0,
        "wird von den Nebelschwaden ans Ufer und aus dem Wasser gehoben",
        "wird von Nebelschwaden aus dem Wasser hereingetragen und abgelegt"));
    return;
}

