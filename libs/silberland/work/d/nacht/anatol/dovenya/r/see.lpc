/* Dovenya, Garten der Ruhe - See des Lebens (how pathetic)
 * _____________________________________(i) Anatol@Silberland (1998-2012) */

#pragma strict_types

#include "../defines.h"
#include <combat.h>

#define ENVROOMLIST   ({ ROOM "garten_o", ROOM "garten_no", ROOM "garten_n",\
             ROOM "garten_nw", ROOM "garten_s" })

inherit DOVENYA "std/room";


public void 
create() 
{
    ::create();

    SetProp(P_INDOORS,0);
    SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:23,
                             ENV_TERRAIN:TT_UNDERWATER,
                             ENV_WATER:0])); /* Wassertiefe 0, wir schwimmen */
    SetProp(P_INT_SHORT,"Dovenya, im See des Lebens");
    SetProp(P_INT_LONG,
        "Du schwimmst im See des Lebens und geniesst seine erfrischende "
        "Kuehle. Stundenlang koenntest Du Deine Kreise ziehen, "
        "herumplantschen und Dich "
        "entspannen, bevor Du ans Ufer zurueckschwimmen moechtest.");
    SetProp(P_GEMA,({0,0}));
    Sky();

    AddDetail("kuehle",
        "Das Wasser des Sees ist nicht wirklich kalt, weckt aber doch die "
        "Lebensgeister, Du koenntest Purzelbaeume schlagen.");
    AddDetail(({"kreis","kreise"}),
        "Um Dich plantschendes Etwas bilden sich kleine Kreise, die sich "
        "langsam ausbreiten und undeutlicher werden, wie man das auf jedem "
        "See beobachten kann.");
    AddDetail("etwas","Und was genau moechtest Du naeher betrachten? :)");
    AddDetail("nachtwind",
        "Der Nachtwind weht hier oben sacht und warm ueber die Siedlung, ist "
        "wohl auch fuer das gute Klima (und die geheimnisvollen Nebel) "
        "verantwortlich.");
    AddDetail("klima","Keine Klimakatastrophe bisher hier.");
    AddDetail("klimakatastrophe","Wenn dieser Raum von Dante waere, wuerde "
        "es jetzt zu regnen anfangen. Ist er aber nicht! :)");
    AddDetail("muster","Du kannst von Deiner Position nichts genaues "
        "erkennen, Du steckst ja quasi mitten im Geschehen...");
    AddDetail("position","Du befindest Dich im See des Lebens und bist nass.");
    AddDetail("geschehen","Du kannst ja ein wenig herumplantschen oder "
        "irgendwen nassspritzen, wenn Du willst...");
    AddDetail("dante","Der ist gluecklicherweise nicht hier :)");
    AddDetail(({"bad","leben","lebensgeister"}),
        "Das Bad im See wirkt richtig erfrischend, "
        "Du fuehlst Dich putzmunter!");
    AddDetail(({"purzelbaum","purzelbaeume"}),"Na, ob Du...? :)");
    AddDetail(({"boden","grund"}),
        "Der Grund des Sees duerfte etwa drei bis vier Meter unter Dir sein, "
        "so genau kannst Du ihn nicht erkennen - ob Du "
        "hinuntertauchen kannst?");
    AddDetail("geisterhand","Also Du warst es nicht, das weisst Du!");
    AddDetail("sternenmeer",
        "Fantastisch, wie die Sterne vom Himmel herabblitzen, Dich in ein "
        "zauberhaftes Licht tauchen...");
    AddDetail("zeit","Hach ja, Zeit... man haette gerne mehr davon, "
        "nicht wahr?");
    AddDetail("wasseroberflaeche",
        "Die Wasseroberflaeche ist alles andere als unbewegt, warum wohl?");
    AddDetail("raum","Siehe auch 'schau'.");
    AddDetail(({"siedlung","dovenya"}),
        "Du befindest Dich in Dovenya!");
    AddDetail("licht","Du siehst es nicht.");
    AddDetail(({"dunstschwaden","schwaden","dunst","nebel","nebelschwade",
            "figur"}),
        "Irgendwie ist die Wasseroberflaeche immer von einem leichten Nebel "
        "bedeckt... nur ein duenner Dunst, in dem sich hin und wieder Formen "
        "bilden, Wirbel drehen... und wieder zerfliessen.");
    AddDetail("wirbel",
        "Die Nebelschwaden bilden hin und wieder kleine Wirbel, weiss der "
        "Himmel, warum sie das tun. Es sieht jedenfalls irgendwie... "
        "geheimnisvoll aus.");
    AddDetail(({"formen","form"}),
        "Irgendwie kannst Du mal dies, mal jenes in "
        "ihnen sehen, aber genaueres "
        "waere wohl nur zu sehen, wenn man ueber dem See stuende... oder "
        "schweben wuerde...");
    AddDetail(({"gewaechs","gewaechse","pflanzen","pflanze"}),
        "Die Pflanzen sehen wirklich sehr interessant aus! "
        "Vielleicht solltest Du dem Garten auch ein wenig Zeit widmen "
        "statt nur hier im See herum zuplantschen.");
    AddDetail("wasser",
        "Das Wasser des Sees ist klar und kuehl, da hier aber "
        "gelegentlich Leute darin baden, vermutest Du irgendwo einen "
        "Zu- und einen Abfluss, sonst "
        "koennte man das Wasser wohl nicht trinken. Hach, man koennte hier "
        "richtig herumtollen und planschen und ueberhaupt!");
    AddDetail("zufluss",
        "Du wirst vermutlich mal abtauchen und suchen muessen, um feststellen "
        "zu koennen, ob es einen Zufluss gibt, jedenfalls siehst Du "
        "oberirdisch nichts in den See hineinfliessen.");
    AddDetail("abfluss",
        "Aus dem See fliesst, oberflaechlich betrachtet, nichts ab.");
    AddDetail("meter","Ein Meter ist knapp einen Meter lang.");
    AddDetail("see",
        "Du schwimmst in einem kleinen See, der ziemlich genau in "
        "der Mitte des "
        "Gartens liegt. Ueber Dir ist der wolkenlose Sternenhimmel, um Dich "
        "herum und unter Dir ist in erster Linie viel klares und "
        "erfrischendes Wasser.");
    AddDetail("mitte",
        "Der See des Lebens bildet die Mitte des Gartens der Ruhe. (Es "
        "lebe der Genitiv!)");
    AddSpecialDetail("kopf","detailKopf");
    AddDetail("genitiv",
        "Genitiv ins Wasser, weils Dativ ist.");
    AddDetail("dativ", "Frueher wusstest Du einmal, was 'Dativ' bedeutet.");
    AddDetail("frueher","Daran kannst Du Dich nicht mehr erinnern.");
    AddDetail("wolken","Der Himmel ist wolkenlos, es scheint nicht "
        "ein einziger Stern verdeckt zu werden!");
    AddDetail("garten",
        "Der naechtliche Garten der Ruhe erstreckt sich einige Meter in "
        "alle Richtungen um den See, wobei das Gebuesch im Westen ziemlich "
        "undurchdringlich zu sein scheint, dieser Teil des Gartens wird wohl "
        "nicht zugaenglich sein.");
    AddDetail("ufer",
        "Der See ist nicht sehr gross, Du kannst ueber das Ufer hinaus sogar "
        "den Garten noch ueberblicken (zumindest da, wo er begehbar ist) "
        "und solltest auch keine Probleme haben, zum Ufer zu schwimmen und "
        "den See verlassen zu koennen.");
    AddDetail(({"probleme","problem"}), 
        "Hach, hier ist es so friedlich, hier gibt es eher weniger Probleme.");
    AddSpecialDetail("gebuesch","detailGebuesch");
    AddDetail("teil","Dieser Teil des Gartens ist wirklich unzugaenglich, "
        "das Gebuesch ist einfach nicht zu durchdringen.");
    AddSmell(DEFAULT_SMELL,"Die vielen Gewaechse im Garten der Ruhe "
        "verstroemen einen betoerenden Duft, den Du selbst hier noch "
        "wahrnehmen kannst.");
    AddSmell("duft","Es riecht nach einer angenehm lauen Fruehlingsnacht.");
    AddSmell("garten","Du kannst nichts genaueres erschnuppern, Du bist zu "
        "weit weg dafuer.");
    AddSmell(({"nacht","fruehlingsnacht"}),
        "Naja, wie so eine Fruehlingsnacht halt duftet...");
    AddSound(DEFAULT_SOUND,"Es plaetschert um Dich herum.");
    AddSound(({"plaetschern","see"}),"Es plaetschert um Dich herum.");
  
    AddRoomMessage( ({
        "Wie von Geisterhand bewegen sich die zarten Dunstschwaden.\n",
        "Die Nebel um Dich scheinen sich kurz zu verdichten.\n",
        "Zwei treibende Dunstschwaden schliessen sich zu einer Figur "
            "zusammen,\nloesen sich dann aber vollstaendig auf.\n",
        "Der hauchzarte Nachtwind verquirlt eine kleine Nebelschwade zu "
                "einem Wirbel.\n",
        "Eine Nebelschwade umstreicht Deinen Kopf.\n",
        "Geheimnisvolle Muster bilden sich im duennen Nebel.\n",
        "Irgendwas streicht an Deinen Fuessen vorbei.\n"
        }),160);

    seteuid(getuid(this_object()));

    AddCmd(({"zieh","ziehe"}),"cmdZiehe");
    AddCmd(({"tauch","tauche"}),"cmdTauche");
    AddCmd(({"schwimme","schwimm"}),"cmdSchwimme");
    AddCmd(({"spritz","spritze"}),"cmdSpritze");
    AddCmd(({"plantsch","plantsche"}),"cmdPlantsche");
    AddCmd(({"schlag","schlage"}), "cmdSchlage");
    AddCmd(({"entspanne","entspann"}), "cmdEntspanne");
    AddCmd(({"tunke","tunk"}), "cmdTunke");
}


public void 
init() 
{
    if ((this_player()) && (environment(this_player())==this_object()))
        if ((!IS_WIZARD(this_player())) && 
            (this_player()->QueryProp(P_GHOST))) 
        {
            write("Huch, wie kommst denn DU hier her?\n");
            DO_LOG(LOG "strange.log",
                sprintf("%s als Geist im See?! -"
                "TI=%O,PO(0)=%O, PO(1)=%O, PO(2)=%O, PO(3)=%O, PO(4)=%O",
                capitalize(getuid( this_player())),
                this_interactive(), caller_stack_depth(),
                previous_object(), previous_object(1), previous_object(2),
                previous_object(3), previous_object(4)
                ));
            if ((this_player()->move(ROOM "uebersee",
                M_GO|M_SILENT|M_NO_SHOW))<0)
                DO_LOG(LOG "strange.log",
                sprintf("ARGH! %s KONNTE NICHT WEGBEWEGT WERDEN!\n",
                capitalize(getuid(this_player()))));
            return;
        }    
    ::init();
    call_out("checkLoop",0);
}

/* Filterfunktion, um sichtbare Lebewesen zu klassifizieren */

nosave int 
isVisLiving(object ob) 
{
    return (living(ob) && (!ob->QueryProp(P_INVIS)));
}

public object * 
GetVis() 
{
    return filter_array(all_inventory(this_object()),
       "isVisLiving",this_object());
}

nosave int 
cmdSchwimme(string str) 
{
    if (!this_player()) 
        return 0;
    notify_fail("Wohin moechtest Du schwimmen? Ans Ufer?\n");
        if ((!str)||((str!="an ufer")&&(str!="ans ufer"))) 
            return 0;
    write("Du schwimmst zum Ufer des Sees und kletterst aus dem Wasser.\n");
    this_player()->move(ENVROOMLIST[random(sizeof(ENVROOMLIST))],M_GO,0,
        "schwimmt zum Ufer und verlaesst das Wasser",
        "schwimmt ans Ufer und steigt tropfnass aus dem Wasser");
    return 1;
}

nosave int 
cmdTauche(string str) 
{
    if (!this_player()) 
        return 0;
    notify_fail("Moechtest Du abtauchen?\n");
    if ((!str)||((str!="ab")&&(str!="unter")&&(str!="nach unten"))) 
        return 0;
    write("Du holst tief Luft und tauchst unter.\n");
    this_player()->move(ROOM "subsee",M_GO,0,
        "holt noch einmal tief Luft und taucht ab",
        "taucht zu Dir herunter");
    return 1;
}

nosave int 
cmdZiehe(string str) 
{
    if (!this_player()) 
        return 0;
    if (!str) 
        return 0;
    if ((str!="kreis") && (str!="kreise")) 
        return 0;
    write("Du schwimmst plaetschernd im Kreis.\n");
    Message(break_string(sprintf(
        "Mit wildem Geplaetscher zieht %s einen kleinen Kreis.",
        this_player()->name(WER)),77),MSGFLAG_NO_TP);
    return 1;
}

nosave int 
cmdDrinke(string str) 
{
    if (!this_player()) 
        return 0;
    if (!str) 
        return 0;
    if (str!="wasser") 
        return 0;
    notify_fail("Neee, lass mal, plantsche lieber weiter drin rum :).\n");
    return 0;
}
  
  
nosave int 
cmdPlantsche() 
{
    string res, reso;
    object *o;
    if (!this_player()) return 0;
    switch (random(4)) 
    {
        case 1:
            res="Du johlst und patschst mit den Haenden volle Kanne auf die "
                "Wasseroberflaeche! Jaaaaaaa, wie das spritzt! :)";
            reso="Wie vom wilden Affen gebissen patscht "+
                this_player()->name(WER)+
                " auf das Wasser und spritzt johlend herum. Es scheint "+
                this_player()->QueryPronoun(WEM)+" richtig Spass zu machen!";
            break;
        case 2:
            res="Du streckst die Beine aus dem Wasser und strampelst "
                "wild spritzend mit ihnen herum. Das macht Spaaaass!";
            reso="Ploetzlich streckt "+this_player()->name(WER)+
                " die Beine aus dem Wasser und strampelt wild mit ihnen "
                "herum. Es spritzt wie ein mittelpraechtiger Wasserfall "
                "und "+this_player()->name(WESSEN)+
                " erheiterndes Kichern ist fast nicht dabei zu hoeren!";
            break;
        case 3:
            res="Du legst Deine Haende zusammen flach auf die "
                "Wasseroberflaeche und drueckst sie ploetzlich rasch nach "
                "unten. Mit einem lauten *FUMP!* spritzt eine Wasserfontaine "
                "nach oben! Ha! Das muss man koennen! Du grinst stolz!";
            reso=this_player()->Name(WER)+" legt "+
                this_player()->QueryPossPronoun(
                FEMALE,WEN,PLURAL)+
                " Haende auf die Wasseroberflaeche und drueckt "
                "sie dann kraeftig nach unten. Mit einem lauten "
                "*FUMP!* spritzt eine riesige Wasserfontaine hoch! "+
                this_player()->Name(WESSEN)+" Grinsen spricht Baende.";
            break;
        default:
            res="Du strampelst Dich mit den Beinen fast bis zur "
                "Huefte aus dem Wasser heraus und laesst Dich nach hinten "
                "plumpsen. *PLATSCH*!";
            reso="Wie von Geisterhand geschoben hebt sich "+
                this_player()->name(WER) +
                " fast bis zur Huefte aus dem Wasser. Dann laesst "+
                this_player()->QueryPronoun(WER)+
                " sie sich mit einem *PLATSCH!* nach hinten fallen.";
            break;
    }
    Message(break_string(reso,77),MSGFLAG_NO_TP);
    this_player()->Message(break_string(res,77));
    if (sizeof(o=GetVis()-({this_player()})))
        for (;sizeof(o);o=o[1..]) 
        {  
            if ((!(o[0]->QueryProp(P_INVIS)))&&(random(3)==2)) 
            {
                o[0]->Message(break_string(sprintf("Du grinst %s an.\n",
                        this_player()->name(WEN)),77));
                if (this_player()->QueryProp(P_INVIS))
                    o[0]->Message("Huch ;)\n");
                Message(this_object(),break_string(sprintf("%s grinst %s an.\n",
                    o[0]->Name(WER),this_player()->name(WEN)),77),
                0,([MSGFLAG_EXCLUDE:({o[0],this_player()})]));
                this_player()->Message(break_string(
                        sprintf("%s grinst Dich an.\n",
                        o[0]->Name(WER)),77));
            }
        }
    return 1;
}

nosave int 
cmdEntspanne() 
{
    if (!this_player()) 
        return 0;
    this_player()->Message(break_string(
        "Du legst Dich lang auf das Wasser und laesst Dich fuer einen "
        "Moment treiben. Nein, das entspannt dann doch nicht, denn Du kannst "
        "Dich nicht sehr lange im 'toten Mann' halten und schnappst prustend "
        "nach Luft.",77));
    Message(break_string("Ploetzlich legt sich "+this_player()->name(WER)+
        " lang aufs Wasser und laesst sich treiben. Das geht allerdings "
        "nicht sehr lange gut und wie erwartet schnappt "+
        this_player()->QueryPronoun(WER)+" prustend nach Luft.",77),
        MSGFLAG_VISUAL|MSGFLAG_NO_TP);
    return 1;
}

nosave int 
cmdSpritze(string was) 
{
    object o, *os;
    string dummy, x;
    string res,reso,rest;
    int i;

    notify_fail("Wen willst Du nassspritzen? (Tip: \"spritze <wen> nass\")\n");
    if (!this_player()) 
        return 0;
    if (!was) 
    {
        if (!sizeof(os=GetVis()-({this_player()}))) 
        {
            this_player()->Message("Spass, Spass, Spass! "
                    "Du spritzt wie besessen in alle Richtungen.\n");
            Message(break_string(sprintf("%s spritzt wie besessen "
                    "in alle Richtungen. Naja, %s weiss ja auch gar "
                    "nicht, dass Du da bist, Du bist ja "
                    "unsichtbar...",this_player()->Name(WER),
                    this_player()->QueryPronoun(WER)),77),MSGFLAG_NO_TP);
        }
        else 
        {
            o=os[random(sizeof(os))];
            this_player()->Message(break_string(sprintf(
                "%s! Du spritzt wild wie ein Berserker im Blutrausch um Dich "
                "und siehst vor lauter Wasser um Dich keinen anderen mehr. "
                "Aber immerhin bist nicht nur Du total nass im Gesicht "
                "geworden, es hat auch %s %s erwischt! :)", 
                (((int)this_player()->QueryProp(P_GENDER))==FEMALE?
                "YESMA'AM":"YESSIR"),o->name(WEN),
                ((i=random(2))?"voll":"ein wenig")),77));
            Message(break_string(sprintf(
                "%s spritzt wie im Blutrausch wild und unkontrolliert um "
                "sich, dass Du Dich fast genoetigt fuehlst, einen Arzt zu "
                "rufen. Als %s endlich aufhoert, siehst Du, dass nicht "
                "nur %s, sondern auch %s %s nass geworden ist. Hihi :-)",
                this_player()->Name(WER),this_player()->QueryPronoun(WER),
                this_player()->QueryPronoun(WER), o->name(WER),
                (i?"ziemlich":"ein bisschen")),77),0,
                    ([MSGFLAG_EXCLUDE:({this_player(),o})]));
            o->Message(break_string(sprintf(
                "Wild wie ein Berserker im Blutrausch spritzt %s um sich, "
                "dass Du beinahe laut nach einem Arzt rufen woelltest. "
                "Bevor %s wieder zu sich kommt und zu spritzen aufhoert, "
                "hat %s Dich allerdings %s nass gemacht :).",
                this_player()->name(WER),
                this_player()->QueryPronoun(WER), 
                this_player()->QueryPronoun(WER), 
                    (i?"ziemlich":"dann doch")),77));
        }
        return 1;
    }
    if ((sscanf(was,"%s nass%s",x,dummy)!=2)||(dummy!="")) 
        return 0;
    if (o=present(x)) 
    {
        if (o==this_player()) 
        {
            write(break_string(
                "Na wenn Du es brauchst - Du spritzt Dir ein paar Liter "
                "Wasser ins Gesicht und schaust wie ein begossener Pudel aus "
                "der Waesche."
                ,77));
            Message(break_string(sprintf(
                "%s spritzt sich ploetzlich wie wild Wasser ins Gesicht. Na, "
                "wenn %s es unbedingt braucht, Du hinderst %s bestimmt nicht.",
                this_player()->Name(WER),this_player()->QueryPronoun(WER),
                this_player()->QueryPronoun(WEN)),77),MSGFLAG_NO_TP);
            return 1;
        }
        if (living(o)) 
        {
            switch (random(4)) 
            {
                case 1:
                    res=sprintf("JAAAAAAAAAAAAAAA! "
                        "Du spritzt mit ganzer Kraft, und das ist nicht "
                        "gerade wenig, in %s Richtung und erwischt %s voll! "
                        "Macht das Spaaaaaaaaaass! =:) "
                        "Wenn %s das auf sich sitzen laesst, ist %s ein "
                        "echter Warmduscher, Marmeladefruehstuecker, "
                        "Yoghurtschuettler! :o) ",
                        o->name(WESSEN),o->QueryPronoun(WEN),
                        o->name(WER), o->QueryPronoun(WER));
                    reso=sprintf("Wild jauchzend spritzt %s ploetzlich volle "
                        "Kanne in %s Richtung und macht %s nasser denn je, "
                        "denn fuer %s kam der Wasserschwall wohl voellig "
                        "ueberraschend! Das scheint %s "
                        "wirklich Spass zu machen! :o)",
                        this_player()->name(WER),
                        o->name(WESSEN),o->QueryPronoun(WEN), 
                        o->QueryPronoun(WEN),this_player()->name(WEM));
                    rest=sprintf("Mit einem wilden Jauchzer spritzt %s "
                        "ploetzlich "
                        "in Deine Richtung. Du vergisst voellig, Deckung zu "
                        "nehmen (wo auch!) und wirst voll erwischt! %s "
                        "scheint es Spass zu machen, he, lass' "
                        "Dir das nicht gefallen, spritz' sofort zurueck! :)",
                        this_player()->name(WER),
                        capitalize((string)this_player()->QueryPronoun(WEM)));
                    break;
                default:
                    res=sprintf("Du schreist voller Begeisterung und "
                        "versuchst, %s nasszuspritzen. Aber %s hat "
                        "schnell %s Arme vor %s Gesicht "
                        "gehalten und fast nichts abbekommen.",
                        o->name(WEN),o->QueryPronoun(WER), 
                        o->QueryPossPronoun(MALE,WEN,PLURAL),
                        o->QueryPossPronoun(NEUTER,WEN,SINGULAR));
                    rest=sprintf("%s schreit ploetzlich begeistert und "
                        "spritzt dann wild in Deine Richtung. Du hast es "
                        "aber geahnt und "
                        "kannst %s nassen Attacke einfach entgehen, in dem Du "
                        "Deine Arme vor Dein Gesicht haeltst. Ha, fast nix "
                        "abbekommen!",
                        this_player()->Name(WER),
                        this_player()->QueryPossPronoun(
                                FEMALE,WESSEN,SINGULAR));
                    reso=sprintf("Mit einem Begeisterungsschrei spritzt %s "
                        "wild in %s Richtung. Aber %s war vorgewarnt und hat "
                        "schnell %s Arme vor %s Gesicht gehalten, so dass "
                        "%s (%s) nasse Attacke fast nicht getroffen hat.",
                        this_player()->name(WER),o->name(WESSEN),
                        o->QueryPronoun(WER),o->QueryPossPronoun(
                            MALE,WEN,PLURAL),
                        o->QueryPossPronoun(NEUTER,WEN,SINGULAR),
                        this_player()->QueryPossPronoun(FEMALE,WER,SINGULAR),
                        this_player()->name(WESSEN));
                    break;
            }
            write(break_string(res,77));
            o->Message(break_string(rest,77));
            Message(break_string(reso,77),0,
                ([MSGFLAG_EXCLUDE:({this_player(),o})]));
            return 1;
        }
        else 
        {
            write(break_string(sprintf(
                "Du spritzt mit einem Jubelschrei %s nass.",o->name(WEN)),77));
            Message(break_string(sprintf(
                "Sowas, %s gibt einen Jubelschrei von sich und "
                "spritzt %s nass. Na, wenn %s es braucht... :).",
            this_player()->name(WER),
            o->name(WEN),this_player()->QueryPronoun(WER)),77),MSGFLAG_NO_TP);
        }
        return 1;
    }
    return 0;
}
    
nosave int 
cmdTunke(string was) 
{   
    object o;
    notify_fail("Wen willst Du tunken, Du Schelm? :)\n");
    if (((!was) || (was=="")) || (!this_player())) 
        return 0;
    if (o=present(was)) 
    {
        if (o==this_player()) 
        {
            write(break_string(
                "Du legst Dir die Haende auf den Kopf und laesst blubbernd "
                "soviel Luft ab, bis Du wie eine ausrangierte Taucherglocke "
                "davonsinkst.",77));
            Message(break_string(sprintf(
                "*blubb* %s legt sich %s Haende auf den Kopf und geht wie "
                "eine blubbernde ausrangierte Taucherglocke unter. "
                "Cooooooool!",
                this_player()->Name(WER),
                this_player()->QueryPossPronoun(FEMALE,WEN,PLURAL)),77),
                MSGFLAG_NO_TP);
            this_player()->move(ROOM "subsee",M_GO,0,"gluckert runter",
                "gluckert herein");
            return 1;
        }
        if (living(o)) 
        {
            switch (random(3)) 
            {
                case 1:
                    write(break_string(sprintf(
                        "Du stemmst Dich ueberraschend auf %s Schultern, und "
                        "da %s wohl tatsaechlich nicht mit Deiner Aktion "
                        "gerechnet hat, kann %s sich nicht ueber Wasser "
                        "halten. Na, Du bist ja %s, "
                        "pass nur auf, dass %s nicht Rache nimmt... :o)",
                        o->name(WESSEN), o->QueryPronoun(WER), 
                        o->QueryPronoun(WER),
                        (((int)this_player()->QueryProp(P_GENDER))==FEMALE
                            ?"eine freche Maus"
                            :"ein frecher Lump"), 
                            o->QueryPronoun(WER)),77));
                    Message(break_string(sprintf(
                        "Voellig ueberraschend und kraeftig stemmt sich %s "
                        "auf %s Schultern, und da %s wohl tatsaechlich nicht "
                        "mit %s Aktion gerechnet hat, kann %s sich nicht mehr "
                        "ueber Wasser halten... Ts, nicht nett von %s... ]:-)",
                        this_player()->name(WER),o->name(WESSEN),
                        o->name(WER),this_player()->name(WESSEN), 
                        o->QueryPronoun(WER),
                        this_player()->name(WEM)),77),0,
                            ([MSGFLAG_EXCLUDE:({this_player(),o})]));
                    o->Message(break_string(sprintf(
                        "Aaaargh, %s stemmt sich voellig ueberraschend und "
                        "ziemlich kraeftig auf Deine Schultern und bevor Du "
                        "Dich gefasst hast, ist es auch schon zu spaet und "
                        "%s hat Dich getunkt. *gloubb* Du hast gerade noch "
                        "schnell Luft holen koennen... am besten gleich die "
                        "Gelegenheit am Schopfe packen (besser: an den Beinen "
                        "zerren, hehe) und ein wenig Rache an %s ueben - hier "
                        "darf man das ja auch ohne Gewissensbisse :o)",
                        this_player()->name(WER),
                        this_player()->QueryPronoun(WER),
                        this_player()->name(WER)),77));
                    o->move(ROOM "subsee",M_GO|M_NOCHECK|M_SILENT,0,
                        "verschwindet bubbernd und rudernd nach unten, hehe",
                        sprintf("wurde von %s unter Wasser gedrueckt",
                            this_player()->name(WEM)));
                    break;
                default:
                    write(break_string(sprintf(
                        "Du stemmst Dich auf %s Schultern, aber %s hat es "
                        "irgendwie geahnt und sich zu sehr auf Deine Aktion "
                        "vorbereitet. Mit einem kraeftigen Schubser "
                        "befoerdert %s Dich wieder auf Abstand. Japsend (und "
                        "grinsend) schnappst Du nach Luft.",
                        o->name(WESSEN),o->QueryPronoun(WER), 
                        o->name(WER)),77));
                    o->Message(break_string(sprintf(
                        "Ha, Du hast es genau gesehen! Da zuckt %s vor, "
                        "stemmt sich auf Deine Schultern und glaubt, Dich so "
                        "unter Wasser zu kriegen. Von wegen, Du schubst %s "
                        "kraeftig davon und %s schluckt ganz schoen Wasser. "
                        "Aber %s grinst noch, war also nicht tragisch.",
                        this_player()->name(WER),
                        this_player()->QueryPronoun(WEN),
                        this_player()->name(WER),
                        this_player()->QueryPronoun(WER)),77));
                    Message(break_string(sprintf(
                        "%s stemmt sich auf %s Schultern, war aber wohl "
                        "nicht fix genug, denn statt %s unter Wasser zu "
                        "tunken, wird %s selbst mit einem kraeftigen Schubser "
                        "wegbefoerdert und schnappt "
                        "maechtig nach Luft. Aber %s grinst noch, %s gibt "
                        "bestimmt nicht so schnell auf.",
                        this_player()->Name(WER),
                        o->name(WESSEN),o->QueryPronoun(WEN), 
                        this_player()->QueryPronoun(WER),
                        this_player()->QueryPronoun(WER), 
                        (((int)this_player()->QueryProp(P_GENDER))==FEMALE?
                        "die freche Nudel, die": "der Frechdachs, der" )),77),
                        0,([MSGFLAG_EXCLUDE:({this_player(),o})]));
                    break;
            }
        }
        else 
        {
            write(break_string(sprintf(
                "Du willst %s gerade anspringen, da bemerkst Du Deinen "
                "Irrtum. Hups." ,o->name(WEN)),77));
            Message(break_string(sprintf(
                "Was hatte %s denn vor? %s zucke so komisch "
                "in %s Richtung...",
                this_player()->name(WER),
                capitalize((string)this_player()->QueryPronoun(WER)),
                o->name(WESSEN)),77),MSGFLAG_NO_TP);
        }
        return 1;
    }
    return 0;
}

nosave int 
cmdSchlage(string was) 
{
    object o;
    notify_fail("Was willst Du schlagen?\n");
    if (((!was) || (was=="")) || (!this_player()))
        return 0;
    if (o=present(was)) 
    {
        if (o==this_player()) 
            write("Masochistisch veranlagt? Nein, Du laesst es.\n");
        else if (living(o)) 
        {
            write(break_string(
                "Du schlaegst nach "+o->name(WEM)+", triffst aber nicht und "
                "spritzt "+o->QueryPronoun(WEN)+
                " nur ein bisschen nass. Magere Vorstellung...",77));
            Message(break_string(sprintf("%s versucht, %s zu "
                "schlagen, spritzt %s aber nur ein bisschen nass. Na, das "
                "kannste wohl knicken, das war nix!",this_player()->Name(WER),
                o->name(WEN),o->QueryPronoun(WEN)),77),
                0,([MSGFLAG_EXCLUDE:({this_player(),o})]));

            o->Message(break_string(sprintf(
                "%s schlaegt wild nach Dir, spritzt Dich aber nur ein "
                "bisschen nass. Du verkneifst Dir taktvoll das Lachen.",
                this_player()->Name(WER)),77));
        }
        else 
        {
            write(break_string(sprintf(
                "Du schlaegst wie besessen auf %s herum, %s wehrt sich auch "
                "gar nicht. Sowas!",o->name(WEM),o->QueryPronoun(WER)),77));
            Message(break_string(sprintf(
                "Na, da hat es %s wohl gepackt. Jedenfalls schlaegt %s wild "
                 " auf %s ein und wundert sich, warum %s sich nicht wehrt "
                 "oder ausweicht.", 
                 this_player()->name(WEN),this_player()->QueryPronoun(WER),
                o->name(WEN),o->QueryPronoun(WER)),77),MSGFLAG_NO_TP);
        }
        return 1;
    }
    notify_fail("Nee, schlage besser nur EINEN Purzelbaum, das "
        "ist schon genug fuer Dich!\n");
    if (was=="purzelbaeume") 
        return 0;

    notify_fail("Das kannst Du nicht schlagen.\n");
    if (was=="purzelbaum") 
    {
        write(break_string(
            "Du holst kurz Luft und ruderst schnell mit den Haenden nach "
            "hinten. *Glucker* Dir laeuft zwar Wasser in die Nase, aber Du "
            "hast tatsaechlich einen Unterwasserpurzelbaum geschlagen!",77));
        Message(break_string(sprintf(
            "%s holt tief Luft und taucht ab. Nein, doch "
            "nicht! Kurz siehst Du %s Beine aus dem Wasser schauen, da taucht "
            "auch wieder der Kopf auf, prustend, nach Luft schnappend und "
            "offensichtlich hat %s auch ein wenig Wasser in die Nase "
            "bekommen... aber %s scheint der Unterwasserpurzelbaum Spass "
            "gemacht zu haben!",this_player()->Name(WER), 
            this_player()->QueryPronoun(WESSEN),this_player()->name(WER),
            this_player()->QueryPronoun(WEM)),77),
            MSGFLAG_VISUAL|MSGFLAG_NO_TP);
        return 1;
    }
    else if (was=="rad") 
    {
        write(break_string(
            "Du versuchst verzweifelt, ein Rad zu schlagen, machst Dich dabei "
            "aber nur ziemlich laecherlich. Naja, irgendwie klappt das nicht "
            "ohne Boden.",77));
        Message(break_string(
            this_player()->Name(WER)+" versucht, ein Rad zu schlagen. Nur "
            "soviel: Nein, es hat absolut nicht geklappt! :o)",77),
            MSGFLAG_VISUAL|MSGFLAG_NO_TP);
        return 1;
    }
    return 0;
}

          
