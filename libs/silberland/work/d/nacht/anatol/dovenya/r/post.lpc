#pragma strict_types

#include "/mail/post.h"
#include "../defines.h"

inherit DOVENYA "std/room";

// Eigentlich sollte ja /std/post beerbt werden, andererseits
// waere das ein klassischer Fall von sinnvoller Doppelvererbung.
// Wiederum andererseits steht in /std/post - bzw. /p/service...
// nicht so weltbewegend viel drin. Machen wir es halt erstmal
// so, bevor wir ein /d/nacht/std/post bauen.

nosave int 
cmdPost(string str)
{
    object mailer;
    if (this_interactive()!=this_player()) return 0;
    if (!objectp(mailer=clone_object(MAILER)))
    {
       write("Die Kommunikationsdienstleistungen sind zur Zeit "
          "nicht verfuegbar.\nWie schade.\n");
       return 1;
    }
    mailer->SetOfficeName(short());
    mailer->do_mail(str);
    return 1;
}

public void 
create() 
{
    ::create();

    SetProp(P_INDOORS,1);
    
    SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:23,
                            ENV_TERRAIN:TT_HOUSE,
                            ])); 

    SetProp(P_INT_SHORT,"Dovenya, beim Schreiber");
    SetProp(P_INT_LONG,
        "Ein Skelettraum, irgendwie sollte sich mal jemand darum kuemmern "
        "und reinschreiben, was hier sein soll..."
        );
    
    SetProp(P_GEMA,({-1,4,0}));
    
    AddDetail(({"xxx"}),"");
    AddCmd("post","cmdPost");
    AddCmd("mail","cmdPost");
    // oane racht
    AddItem(MAILCABIN,REFRESH_REMOVE);

    seteuid(getuid(this_object()));
  
    AddExit("nordosten",
        ([ EX_DEST: "./brunnenplatz", 
           EX_PLMSG: "Du verlaesst die Stube und gehst auf "
              "den Brunnenplatz.\n",
           EX_MSG: "raus auf den Brunnenplatz"]));
  
}


