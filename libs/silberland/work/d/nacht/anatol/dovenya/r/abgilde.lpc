#pragma strict_types

#include "../defines.h"

inherit DOVENYA "std/room";
inherit "/std/gilden_room";

public void 
create() 
{
    ::create();

    SetProp(P_INDOORS,1);
    
    SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:23,
                            ENV_TERRAIN:TT_HOUSE,
                            ])); 

    SetProp(P_INT_SHORT,"Dovenya, die Abenteurer");
    SetProp(P_INT_LONG,
        "Die lokale Niederlassung der Abenteurergilde."
        );
    
    SetProp(P_GEMA,({1,3,0}));
    
    AddDetail(({"xxx"}),"");

    seteuid(getuid(this_object()));
  
    AddExit("norden",
        ([ EX_DEST: "./campanile_eg", 
           EX_PLMSG: "Du verlaesst den Platz der Abenteurer und "
               "trittst in den Campanile.\n",
           EX_MSG: "nach Norden in den Campanile"]));
 
    SetProp(P_HIDE_EXITS,({""}));

}
