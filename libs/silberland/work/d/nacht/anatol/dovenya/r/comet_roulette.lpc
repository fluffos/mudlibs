       ]);
    return;
}

varargs public int * WheelLayout()
{
    return ({})+table_wheel;
}



// Muss public sein, wird in lambdas ge-call_other-t.

varargs public string
GetChanceName(mixed chance, int lang)
{

    if (stringp(chance))
    {
        chance=getChance(chance);
    }
    if ((!chance) || (!pointerp(chance)))
    {
        return 0;
    }

    if (member(vocabulary,chance[0]))
    {
        return vocabulary[chance[0],lang];
    }
    else if (member(chance[1],XANN))
    {
        return vocabulary[chance[1][XANN],lang] +" "+
            (chance[1][XANN]=="ch"
                ?implode(explode(chance[0]," "),"/")
                :implode(explode(chance[0]," "),"-"));
    }
    else 
    {
        return "Schmeeeeerz!";
    }
}

// Public, kann nicht schaden...

varargs public string
GetChanceDescription(string ch, int lang)
{
    mixed chance;
    string fullname;
    if (!chance=getChance(ch))
    {
        return 0;
    }

    return break_string(sprintf("Beim Gewinn einer Wette auf die Chance '%s' "
      "erhaeltst Du zu Deinem Einsatz das %d-fache dessen hinzu. Die Wette "
      "gewinnt, wenn %s faellt: %s.",
       GetChanceName(chance,lang),
       chance[1][XRET],
       (sizeof(chance[1][XNUM])>1
           ?"eine der folgenden "+ sizeof(chance[1][XNUM])+ " Zahlen"
           :"folgende Zahl"),
       implode(
           map_array(
               sort_array(
                   m_indices(chance[1][XNUM]),
                   #'>),
               #'to_string),
          ", ")),77);
}


nosave string
getBetsOverview(int filtered)
{
    string * betlist;
    int i;
    string result;
    if (!this_player())
    {
        return "";
    }
    betlist=getBetList(playerSettings(this_player())[COMET_LANG],
        this_player(),filtered);

    if (!sizeof(betlist))
    {
        return sprintf("Zur Zeit %s keine Wetten auf dem Tableau platziert.\n",
            (filtered?"hast Du":"sind"));
    }
    else
    {
        result=sprintf("Zur Zeit %s %d Wette%s auf dem Tableau platziert:\n",
            (filtered?"hast Du":(sizeof(betlist)<2?"ist":"sind")),
            sizeof(betlist),
            (sizeof(betlist)>1?"n":""));
        for (i=0;i<sizeof(betlist);i++)
        {
            result+=sprintf("%s%s\n",
                (filtered
                    ?sprintf("#%-2d ",i+1)
                    :"    "),
                betlist[i]);
        }
        return result;
    }
}

nosave string
detailKugel()
{
    switch (table_status)
    {
        case STAT_FREI:
            return "Die Kugel befindet sich gerade nicht auf dem Tisch.\n";
            break;
        case STAT_KUGELROLLT:
        case STAT_ABGESAGT:
            return "Die Kugel ist gerade in Bewegung... "
                    "wo wird sie liegenbleiben?\n";
            break;
        default:
            return sprintf("Die Kugel liegt im Fach der Nummer %d.\n",
                table_rolled);
    }
}

nosave string
detailEigeneWetten()
{
    return getBetsOverview(1);
}


nosave string
detailWetten()
{
    return getBetsOverview(0);
}


nosave string 
detailKessel()
{
    mapping conf;
    string cr, cg, cb, cm, bb;
    string * gfx;
    
    if ((!this_player()) || (!mappingp(conf=playerSettings(this_player()))))
    {
        return "Du siehst ein Tableau.\n";
    }
    if (conf[COMET_GFX]<1)
    {
        return break_string(
            "[Anmerkung der Casino-Betreiber: Hier waere eigentlich eine "
            "kleine Ascii-Grafik, anhand der man erkennen kann, welche "
            "Zahl neben welcher im Kessel vorkommt. Das ist natuerlich "
            "Schnickschnack - gut, dass Du dir keine Ascii-Grafiken hier "
            "anzeigen laesst. Schau Dir stattdessen das 'Karussell' an, da "
            "ist alles Wichtige textuell beschrieben.]",77);
    }
    else
    {
        if (conf[COMET_GFX]>1)
        {
            cr=ANSI_BG_BLACK+ANSI_RED+ANSI_BOLD;
            cm=ANSI_BG_BLACK+ANSI_BOLD+ANSI_BLUE;
            cb=ANSI_BG_BLACK+ANSI_WHITE+ANSI_BOLD;
            cg=ANSI_BG_BLACK+ANSI_GREEN+ANSI_BOLD;
            bb=ANSI_BG_BLACK+ANSI_BOLD+ANSI_BLACK;
        }
        else
        {
            cr=cb=cg=bb="";
        }
    }

    gfx=({
  
        bb+"           "+cb+"26"+bb+" "+cg+"0"+bb+" "+cr+"32"+bb+" "+
            cb+"15"+bb+" "+cr+"19"+bb+" "+cb+"4"+bb+"          ",
        bb+"        "+cb+"35"+bb+" "+cr+"3"+bb+"    ____     "+cr+"21"+
            bb+" "+cb+"2"+bb+"       ",
        bb+"       "+cr+"12"+bb+"    .-'     '-.    "+cr+"25"+bb+"      ",
        bb+"      "+cb+"28"+bb+"   .'     |     '.   "+cb+"17"+bb+"     ",
        bb+"      "+cr+"7"+bb+"   /       |       \\   "+cr+"34"+bb+"    ",
        bb+"     "+cb+"29"+bb+"  ;       O.O       ;  "+cb+"6"+bb+"     ",
        bb+"     "+cr+"19"+bb+"  |  -----(O)-----  |  "+cr+"27"+bb+"    ",
        bb+"     "+cb+"22"+bb+"  ;       O|O       ;  "+cb+"13"+bb+"    ",
        bb+"      "+cr+"9"+bb+"   \\       |       /  "+cr+"36"+bb+"     ",
        bb+"      "+cb+"31"+bb+"   '.     |     .'  "+cb+"11"+bb+"      ",
        bb+"       "+cr+"14"+bb+"    '-._____.-'   "+cr+"30"+bb+"       ",
        bb+"        "+cb+"20"+bb+" "+cr+"1"+bb+"            "+cr+"23"+bb+" "+
            cb+"8"+bb+"        ",
        bb+"            "+cb+"33"+bb+" "+cr+"16"+bb+" "+cb+"24"+bb+" "+
            cr+"5"+bb+" "+cb+"10"+bb+"           " });
    return implode(gfx,"\n")+"\n";

}
nosave string 
detailFilz()
{
    mapping conf;
    if ((!this_player()) || (!mappingp(conf=playerSettings(this_player()))))
    {
        return "Du siehst ein Tableau.\n";
    }
    
    return break_string(sprintf(
            "Auf dem Filz des Tableau sind viele Felder aufgezeichnet, "
            "die meisten "
            "enthalten Zahlen, einige aber auch anderen Text. In der Mitte "
            "sind es zunaechst tatsaechlich Zahlen, und zwar in einem "
            "Rechteck mit drei auf zwoelf Feldern angeordnet, links unten "
            "beginnend mit der 3, rechts oben mit der 36 endend, so dass etwa "
            "in der ersten langen Kolonne die Zahlen 1, 4, 7, 10, 13, ... "
            "stehen. Die Felder sind rot und schwarz, wobei die Musterung "
            "nicht direkt regelmaessig zu sein scheint. An der Stirnseite, "
            "also an die 1, 2 und 3 angrenzend, ist ein gruenes Feld mit "
            "einer Null. Die Laengssseiten werden gesaeumt von grossen "
            "Textfeldern: %s, %s, %s, %s, %s und %s, die anscheinend gern "
            "genutzt werden (sonst waeren sie sicher kleiner!). Die andere "
            "Stirnseite wird von drei Feldern begrenzt, in denen die "
            "roemischen Ziffern I bis III geschrieben sind - diese gelten "
            "dann fuer die gesamte Kolonne. Ganz am Rand siehst "
            "Du noch drei weitere Felder, die sehr klein mit %s, %s und %s "
            "beschrieben sind.",
            vocabulary["rouge",conf[COMET_LANG]],
            vocabulary["noir",conf[COMET_LANG]],
            vocabulary["pair",conf[COMET_LANG]],
            vocabulary["impair",conf[COMET_LANG]],
            vocabulary["manque",conf[COMET_LANG]],
            vocabulary["passe",conf[COMET_LANG]],
            vocabulary["12p",conf[COMET_LANG]],
            vocabulary["12m",conf[COMET_LANG]],
            vocabulary["12d",conf[COMET_LANG]]
            ),77);
}

nosave string 
detailTableau()
{
    mapping conf;
    string cr, cg, cb, cm, bb;
    string * gfx;
    int i;

    if ((!this_player()) || (!mappingp(conf=playerSettings(this_player()))))
    {
        return "Du siehst ein Tableau.\n";
    }
    
    if (conf[COMET_GFX]<1)
    {
        return break_string(
            "[Anmerkung der Casino-Betreiber: Hier waere eigentlich eine "
            "kleine Ascii-Grafik mit dem Tableau zu finden und eine Liste "
            "der aktuellen Wetten. Ungluecklicherweise hast Du die grafische "
            "Darstellung abgeschaltet. Wenn Du das Aussehen des Tableaus in "
            "Textform erfassen moechtest, schau Dir den 'Filz' an.]",77);

    }
    else
    {
        if (conf[COMET_GFX]>1)
        {
            cr=ANSI_BG_BLACK+ANSI_RED+ANSI_BOLD;
            cm=ANSI_BG_BLACK+ANSI_BOLD+ANSI_BLUE;
            cb=ANSI_BG_BLACK+ANSI_WHITE+ANSI_BOLD;
            cg=ANSI_BG_BLACK+ANSI_GREEN+ANSI_BOLD;
            bb=ANSI_BG_BLACK+ANSI_BOLD+ANSI_BLACK;
        }
        else
        {
            cr=cb=cg=bb="";
        }
    }
    
    gfx=({
    bb+"       +-----------+-----------+-----------+       ",
    bb+"       | "+cm+sprintf("%|9s",vocabulary["manque",conf[COMET_LANG]])+bb+
       " | "+cm+sprintf("%|9s",vocabulary["impair",conf[COMET_LANG]])+bb+
       " | "+cm+sprintf("%|9s",vocabulary["rouge",conf[COMET_LANG]])+bb+
       " |       ",
    bb+"    +--+--+--+--+--+--+--+--+--+--+--+--+--+---+   ",
    bb+"    |"+cg+"  "+bb+"|"+cr+" 3"+bb+"|"+cb+" 6"+bb+"|"+cr+" 9"+bb+"|"+cr+
        "12"+bb+"|"+cb+"15"+bb+"|"+cr+"18"+bb+"|"+cr+"21"+bb+"|"+cb+"24"+bb+
        "|"+cr+"27"+bb+"|"+cr+"30"+bb+"|"+cb+"33"+bb+"|"+cr+"36"+bb+"|"+cm+
        "III"+bb+"|   ",
    bb+"    |"+cg+"  "+bb+"|--+--+--+--+--+--+--+--+--+--+--+--+---+   " ,
    bb+"    |"+cg+" 0"+bb+"|"+cb+" 2"+bb+"|"+cr+" 5"+bb+"|"+cb+" 8"+bb+"|"+cb+
        "11"+bb+"|"+cr+"14"+bb+"|"+cb+"17"+bb+"|"+cb+"20"+bb+"|"+cr+"23"+bb+
        "|"+cb+"26"+bb+"|"+cb+"29"+bb+"|"+cr+"32"+bb+"|"+cb+"35"+bb+"|"+cm+
        " II"+bb+"|   ",
    bb+"    |"+cg+"  "+bb+"|--+--+--+--+--+--+--+--+--+--+--+--+---+   ",
    bb+"    |"+cg+"  "+bb+"|"+cr+" 1"+bb+"|"+cb+" 4"+bb+"|"+cr+" 7"+bb+"|"+cb+
        "10"+bb+"|"+cb+"13"+bb+"|"+cr+"16"+bb+"|"+cr+"19"+bb+"|"+cb+"22"+bb+
        "|"+cr+"25"+bb+"|"+cb+"28"+bb+"|"+cb+"31"+bb+"|"+cr+"34"+bb+"|"+cm+
        "  I"+bb+"|   ",
    bb+"    +--+--+--+--+--+--+--+--+--+--+--+--+--+---+-- ",
    bb+"       | "+cm+sprintf("%|9s",vocabulary["passe",conf[COMET_LANG]])+bb+
       " | "+cm+sprintf("%|9s",vocabulary["pair",conf[COMET_LANG]])+bb+
       " | "+cm+sprintf("%|9s",vocabulary["noir",conf[COMET_LANG]])+bb+
       " |/"+cm+"12d"+bb+"/  ",
    bb+"       +-----------+-----------+-----------/"+cm+"12m"+bb+"/   ",
    bb+"                                          /"+cm+"12p"+bb+"/    "
    });
    return implode(gfx,"\n")+"\n";
}


nosave int
ihBah(object pl)
{
    return  (
        (!query_once_interactive(pl)) 
        || (IS_LEARNER(pl))
        || (pl->QueryProp(P_TESTPLAYER))
        );
}


// Das Verarbeiten einer Wette ist ausgelagert, so dass ein
// Croupier beispielsweise eine angesagte Wette verarbeiten kann.
// Knifflig allerdings: Er muss vorher wissen, was der gesamte
// Spass kosten wird (eine Maximum-Wette kann bis zum 40fachen
// dessen, was auf eine einzelne Zahl gesetzt werden darf,
// kosten).

// Hier sollte evtl. noch eine Abfrage auf previous_object() rein.


// Die Funktion gibt zurueck...
// 
//      0 - wenn irgendwas gar nicht ging
// string - eine Fehlermeldung, die an den Spieler ausgegeben werden soll

varargs public string 
ProcessBet(object player, string input, int place_and_lock)
{
    mixed bet;   // Pointer auf die Wette
    mapping ret;
    int stake;     // Einsatz
    int num1,rum2;
    string rest;   // Rest-String
    string rest2;
    string * matches;
    int lang;
    int limit;

    bet=0;
    if ((!objectp(player))||(!living(player)))
    {
        return 0;
    }
    lang=(playerSettings(player))[COMET_LANG];

    if (table_status==STAT_ABGESAGT)
    {
        return "Aaah, zu spaet, die Kugel wird gleich fallen!";
    }

    if ((table_status!=STAT_FREI) && (table_status!=STAT_KUGELROLLT))
    {
        return "Du kannst jetzt leider keine Wetten platzieren.";
    }
    
    // Erst pruefen, ob der Einsatz prinzipiell passt. Table Limits koennen 
    // erst spaeter geprueft werden, diese haengen von der Quote der Wette ab.

    if ((!stringp(input)) ||  (!strlen(input))
        || ((sscanf(input,"%d%s",stake,rest)==2) && (rest=="")) // Nur Einsatz
        || (input=="limit"))
    {
        return "Auf was moechtest Du Deinen Einsatz abgeben?";
    }

    if (sscanf(input,"%d %s",stake,rest)!=2)  // Fehlzeichen... oder Limit
    {
        if (sscanf(input,"limit %s",rest)!=1)  // Fehlzeichen!
        {
            return "Das mit Deinem Einsatz hat so gar nicht geklappt.";
        }
        else
        {   
            stake=1;
            limit=1; // Spaeter muessen wir das noch hochsetzen, koennen
                     // wir erst, wenn wir wissen, auf was gesetzt wird.
        }
    }

    if (!stake) // Guter Witz...
    {
        return "Wenn Du nichts setzen moechtest, brauchst Du nicht setzen.";
    }

    if (stake<0)  // Bei DEN Chancen wuerde jeder Leerverkaeufe wollen
    {
        return "Negative Betraege kannst Du an der Boerse setzen, hier nicht.";
    }
    if ((!place_and_lock) && (!HasJetons(player,stake))) // Nicht ubernehmen...
    {
        return "So viele Cometen hast Du leider nicht.";
    }

    // Okay. Der Einsatz ist in Ordnung. Wie sieht es mit der Chance aus?

    if (sscanf(rest,"auf %s",rest2)==1) // Weglesen von "auf"
    {
        rest=rest2;
    }

    // Wenn aus dem Text keine eindeutige Chance ermittelt werden kann
    // wird das mit dem Setzen leider auch nix.
    
    if (!bet=getChance(rest)) 
    {
        return "Darauf kannst Du keine Wette platzieren.";
    }

    // Abschliessend Limit pruefen. 100'000 auf Rot tun nicht wirklich
    // weh, aber 100'000 auf eine Zahl... bei Gewinn wuerden 3.5 Millionen
    // ausgeschuettet werden. Ob da die Bankaufsicht mitmacht?
    if (limit)
    {
        stake=(TABLE_LIMIT/bet[1][XRET]);
        if ((!place_and_lock)&& (!HasJetons(player,stake))) 
                // Nicht ubernehmen...
        {
            return "Du hast nicht genug Cometen, um bei dieser Wette das "
                "Tischlimit zu setzen.";
        }
    }

    if ((stake * bet[1][XRET])>TABLE_LIMIT)
    {
        return "Fuer diese Wette ist Dein Einsatz zu hoch und "
            "wuerde das Tischlimit sprengen.";
    }

    if (sizeof(filter_array(table_bets,
        lambda( ({ 'x , 'y, 'z }), 
        ({#'&& ,
           ({#'== , ({#'[ ,  'x , BET_CHANCE }) , 'y }),
           ({#'== , ({#'[ ,  'x , BET_OWNER }),   'z })
           })), bet[1], file_name(player))))
    {
        return sprintf("Du hast bereits einen Einsatz auf '%s' "
            "gewettet.",GetChanceName(bet,lang));
    }
    if (place_and_lock>1) 
    {
        return 0;
    }
    table_bets+=({ ret=([ BET_CHANCE:bet[1],
                BET_TIME:time(),
                BET_OWNER:file_name(player),
                BET_STATUS:0,
                BET_STAKE:stake,
                BET_CHANCE_NAME:bet[0],
                BET_OWNER_UUID:(query_once_interactive(player)
                    ?getuuid(player)
                    :(string)(player->name(WER))+"!"),
                BET_TEST_ONLY:ihBah(player),
                BET_LOCKED:place_and_lock
               ]) });

    AddJetons(player, (-1) * stake);

    announce(ret); 

    return 0; // SUCCESS!
}

// Masse mitnehmen. Haha! Alles meins!
// (Ich sollte einen Zweitie spielen... den Casino-Besitzer)

nosave void
cleanMasse()
{
    mixed masse;
    object player;
    int i;
    int cash;

    // Gesamtzaehler nullen:
    table_results=([]);

    if (!sizeof(table_bets))
    {
        Message("Es wurden keine Einsaetze getaetigt.\n");
        return;
    }
    masse = filter_array(table_bets,lambda(({ 'x, 'y }), 
        ({#'! , ({#'member , 
            ({#'[ , ({#'[ , 'x , BET_CHANCE }) , XNUM }) , 'y })})
        
        ), table_rolled);
    if (!sizeof(masse))
    {
        Message("In dieser Runde gibt es keine Masse.\n");
    }
    else
    {
        cash=0;

        while (sizeof(masse))
        {
            updateStatisticsForPlayer(masse[0][BET_OWNER_UUID],
                masse[0][BET_STAKE], masse[0][BET_CHANCE][XRET], LOST,
                    masse[0][BET_TEST_ONLY]);
            DO_LOG(LOG_BETS,sprintf("Verloren: [%s] %d auf %s",
                masse[0][BET_OWNER],
                masse[0][BET_STAKE],
                GetChanceName(masse[0][BET_CHANCE_NAME],0)));

            // Verluste summieren...

            if (!member(table_results,masse[0][BET_OWNER_UUID]))
            {
                table_results+=
                    ([masse[0][BET_OWNER_UUID]:(-1)*masse[0][BET_STAKE]]);
            }
            else
            {
                table_results[masse[0][BET_OWNER_UUID]]-=masse[0][BET_STAKE];
            }

            if ((player=find_object(masse[0][BET_OWNER]))&& (present(player)))
            {
                player->Message(sprintf(
                    "Deine Wette mit %d Cometen auf '%s' verlor.\n",
                        masse[0][BET_STAKE],
                        GetChanceName(masse[0][BET_CHANCE_NAME],
                            playerSettings(player)[COMET_LANG])));
            }
            cash+=masse[0][BET_STAKE];
            table_bets-=({masse[0]});
            masse=masse[1..];
        }
        Message(sprintf("Eine Masse von %d Cometen wird eingezogen.\n",cash));
    }
}

// Gewinne verarbeiten.

nosave void
processWinnings()
{
    mixed winners;
    object player;
    mapping conf;

    int winc,win,i; // Iterieren, evtl bleibt ja was stehen...

    if (!sizeof(table_bets))
    {
        return;
    }
    for (winc=i=sizeof(table_bets);i-->0;)
    {
        
        table_bets[i][BET_LOCKED]=0;
        updateStatisticsForPlayer(table_bets[i][BET_OWNER_UUID],
            table_bets[i][BET_STAKE],
            table_bets[i][BET_CHANCE][XRET],WON,
            table_bets[i][BET_TEST_ONLY]);
        DO_LOG(LOG_BETS,sprintf("Gewonnen: [%s] %d auf %s",
            table_bets[i][BET_OWNER],
            table_bets[i][BET_STAKE],
            GetChanceName(table_bets[i][BET_CHANCE_NAME],0)));
        win=table_bets[i][BET_STAKE]*(1+table_bets[i][BET_CHANCE][XRET]);
         // Fuer die Maximumgewinn-Auswertung
        if (!member(table_results, table_bets[i][BET_OWNER_UUID]))
        {
            table_results+=
                ([table_bets[i][BET_OWNER_UUID]:win-table_bets[i][BET_STAKE]]);
        }
        else
        {
            table_results[table_bets[i][BET_OWNER_UUID]]+=
                    win-table_bets[i][BET_STAKE];
        }
        if ((player=find_object(table_bets[i][BET_OWNER])) 
            && (present(player)))
        {
            conf=playerSettings(player);
            player->Message(sprintf(
                "Deine Wette mit %d Cometen auf '%s' war erfolgreich.\n",
                    table_bets[i][BET_STAKE],
                    GetChanceName(table_bets[i][BET_CHANCE_NAME],
                        conf[COMET_LANG])));
        }
        if ((!player) || (!present(player)) || (!conf[COMET_AUTOCOLLECT]))
        {
            if (win > (TABLE_LIMIT/table_bets[i][BET_CHANCE][XRET]))
            { 
                if ((player) && (present(player)))
                {
                    DO_LOG(LOG_IRRS,
                        sprintf("Stehengebliebene %s von [%s] "
                                "mit %d ueber Limit %d/%d.",
                        GetChanceName(table_bets[i][BET_CHANCE_NAME],0),
                        table_bets[i][BET_OWNER],win, TABLE_LIMIT,
                        (table_bets[i][BET_CHANCE][XRET])));
                        
                    player->Message(break_string(sprintf(
                        "Du kannst die Wette nicht stehen lassen, da sie "
                        "das Limit fuer diese Wette sprengen wuerde, Du "
                        "nimmst daher Gewinn und Einsatz - "
                        "%d Cometen - auf.",win),
                        77));
                    AddJetons(player,win);

                    table_bets[i]=0;
                }
                else
                {
                    DO_LOG(LOG_IRRS,
                        sprintf("Uneingeforderte %s von [%s] "
                                "mit %d ueber Limit %d/%d (reduziert um %d).",
                        GetChanceName(table_bets[i][BET_CHANCE_NAME],0),
                        table_bets[i][BET_OWNER],win, TABLE_LIMIT,
                        (table_bets[i][BET_CHANCE][XRET]),
                        win-(TABLE_LIMIT/table_bets[i][BET_CHANCE][XRET])));
                        
                    Message(break_string(
                        "Die Wette, dessen Eigentuemer nicht mehr "
                        "auffindbar ist, wuerde das Tischlimit sprengen! "
                        "Der Einsatz wird auf das Tischlimit begrenzt - mit "
                        "der Differenz machen die Croupiers sich einen "
                        "wirklich schoenen Abend.",77));
                    table_bets[i][BET_STAKE]=
                        TABLE_LIMIT/table_bets[i][BET_CHANCE][XRET];
                }
            }
            else
            {
                table_bets[i][BET_STAKE]=win;
            }
        }
        else
        {

            player->Message(sprintf( 
                "Du erhaeltst %d Cometen auf die Hand.\n", win));
            AddJetons(player,win);
            table_bets[i]=0;
        }
    }


    // Maximalgewinne eintragen...

    for (i=sizeof(winners=m_indices(table_results));i-->0;)
    {
        if ((table_results[winners[i]] > 0 ) &&
            (table_results[winners[i]] > 
            table_stats[STATISTICS_PLAYERS][winners[i]][0][STC_TOP]))
        {
            if ((player=find_player(explode(winners[i],"_")[0]))
                && (present(player)))
            {
                player->Message(break_string(sprintf(
                    "Du hast Deine Bestmarke fuer "
                    "die Gewinnsumme eines Coups %d auf %d verbessert!\n",
                    table_stats[STATISTICS_PLAYERS][winners[i]][0][STC_TOP],
                    table_results[winners[i]]),77));
            table_stats[STATISTICS_PLAYERS][winners[i]][0][STC_TOP]=
                table_results[winners[i]];
            }
        }   
        else
        {
            if ((player=find_player(explode(winners[i],"_")[0]))
                && (present(player)))
            {
                player->Message(break_string(sprintf(
                    "In diesem Coup hast Du %d Cometen %s.\n",
                    abs(table_results[winners[i]]),
                    table_results[winners[i]]<0?"verloren":"gewonnen"),77));
                        }
        }
    }
    table_results=([]);


    // Eingeholte/Ausgezahlte Wetten tilgen.
    table_bets-=({0});
    Message(sprintf("Es %s %s %s. Die Kugel wird wieder aufgenommen.\n",
        (winc>1?"gewannen":"gewann"),
        (winc==1
            ?"eine"
            :(winc>0
                ?to_string(winc)
                :"keine")),
        (winc>1?"Wetten":"Wette")));

    return;
}

// **********************************************************************
// Das Scheduling... eigentlich uebersichtlich. 
// Ausloeser ist das Setzen einer Wette. Bleibt am Ende einer Runde
// eine Wette stehen (z.B. weil der Setzer weg ist oder derjenige
// das so moechte), geht es automatisch weiter.

public void
Schedule()
{
    if (previous_object()!=this_object())
    {
        return;
    }
    while (remove_call_out("Schedule")!=-1);

    switch (table_status)
    {

        case STAT_FREI:
            if ((!sizeof(table_bets)) || (time()-(table_bets[<1][BET_TIME]))<6)
            {
                return call_out("Schedule",2);
            }
            else
            {
                Message("Die Kugel wird in den Kessel gesetzt "
                    "und dreht jetzt ihre Kreise.\n");
                table_status=STAT_KUGELROLLT;
                return call_out("Schedule",8);
            }
            break;
        case STAT_KUGELROLLT:
            announce("rnvp");
            table_status=STAT_ABGESAGT;
            return call_out("Schedule",6);
            break;
        case STAT_ABGESAGT:
            Message("Die Kugel springt ein wenig ueber die "
                "Faecher und bleibt dann liegen.\n");
            announce(table_rolled=random(37));
            table_stats[STATISTICS_NUMBERS][table_rolled]++;
            table_status=STAT_GEFALLEN;
            return call_out("Schedule",4);
            break;
        case STAT_GEFALLEN:
            cleanMasse();
            table_status=STAT_AUSWERTUNG_M;
            return call_out("Schedule",2);
            break;
        case STAT_AUSWERTUNG_M:
            processWinnings();
            table_status=STAT_AUSWERTUNG_G;
            return call_out("Schedule",4);
            break;
        case STAT_AUSWERTUNG_G:
            if  (table_prepare_maintenance)
            {
                table_status=STAT_WARTUNG;
                table_prepare_maintenance=0;
                announce("Wartungsmodus aktiv. Viel Glueck, Jim.");
            }
            else
            {
                table_status=STAT_FREI;
                announce("fvj");
                // Koennte ja was stehen geblieben sein:
                return call_out("Schedule",8); 
            }
            break;
        default:
            return;

    }
}

