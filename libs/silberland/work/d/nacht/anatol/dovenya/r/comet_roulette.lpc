nosave int
cmdSpuere(string was)
{
    notify_fail("Was willst Du spueren?\n");
    if (!was)
    {   
        return 0;
    }
    notify_fail("Das scheint so pauschal nicht zu funktionieren.\n");
    if (was!="spannung")
    {
        return 0;
    }
    write("Oh... ja...\n");
}



nosave int 
cmdSet(string txt)
{
    string err;

    if (!this_player())
    {
        return 0;
    }
    if (err=ProcessBet(this_player(),txt))
    {
        this_player()->Message(break_string(err,77));
    }
    else
    {
        if (find_call_out("Schedule")<0)
        {
            call_out("Schedule",6);
        }
    }
    return 1;
}

nosave int
fetchBet(object player, int thisbet)
{
    mixed playerbets;
    int betc,i,win;

    playerbets=filter_array(table_bets,lambda( ({ 'x, 'y }) ,
                ({#'== , 
                    ({#'file_name, 'y  }), 
                    ({#'[ , 'x , BET_OWNER})})),player);
    if (!sizeof(playerbets))
    {
        player->Message("Du hast zur Zeit keine Wetten platziert.\n");
    }
    else if (thisbet>sizeof(playerbets))
    {
        player->Message("Du hast nicht so viele Wetten platziert.\n");
    }
    else if (thisbet==-1)
    {
        win=0;
        for (betc=i=sizeof(playerbets);i-->0;)
        {
            if (playerbets[i][BET_LOCKED])
            {
                player->Message(sprintf(
                    "Die Wette Nr. #%d darfst Du noch nicht einholen.\n",i+1));
                    betc--;
            }
            else
            {
                win+=playerbets[i][BET_STAKE];
                table_bets-=({playerbets[i]});
            }
        }
        if (betc)
        {
            player->Message(break_string(sprintf(
                 "Du holst die platzierten Einsaetze "
                "von %s ein, insgesamt %d Cometen.\n",
                (betc==1?"Deiner Wette":sprintf("Deinen %d Wetten",betc)),
                win),77));
            Message(break_string(sprintf(
                "%s nimmt %d Comete%s von %d Wette%s zu sich.\n",
                player->Name(WER),win,(win==1?"":"n"), 
                betc,(betc==1?"":"n")),77),MSGFLAG_VISUAL|MSGFLAG_NO_TP);
            AddJetons(player,win);
        }
        else
        { 
            player->Message("Hm - das war wohl nix.\n");
        }
    }
    else 
    {
        if (playerbets[i][BET_LOCKED])
        {
            player->Message("Diese Wette darfst Du noch nicht einholen.\n");
        }   
        else
        {
            player->Message(sprintf("Du holst den Einsatz von %d Cometen der "
                "Wette '%s' ein.\n",
                    playerbets[thisbet-1][BET_STAKE],
                    GetChanceName(playerbets[thisbet-1][BET_CHANCE_NAME],
                        playerSettings(player)[COMET_LANG])));
            Message(break_string(sprintf(
            "%s nimmt die %d Comete%s einer Wette wieder auf.\n",
                player->Name(WER),
                    playerbets[thisbet-1][BET_STAKE]),77),
                    MSGFLAG_VISUAL|MSGFLAG_NO_TP);
            AddJetons(player,playerbets[thisbet-1][BET_STAKE]);
            table_bets-=({playerbets[thisbet-1]});
        }
    }
    return 1;
}

nosave int 
cmdHole(string txt)
{
    string what,dummy;
    int getbet;

    if (!this_player())
    {
        return 0;
    }
    notify_fail("Was moechtest Du (ein)sammeln?\n");
    if (!txt)
    {
        return 0;
    }

    if ((sscanf(txt,"alle%s",dummy)==1) &&
            (member(([" wetten ein","s"," ein","s ein",""]),dummy)))
    {
        return fetchBet(this_player(),-1);
    }
    else if ((sscanf(txt,"%d%s",getbet,dummy)==2) &&
            (member(([""," ein"]),dummy)))
    {
        return fetchBet(this_player(),getbet);
    }
    notify_fail("Welche Wetten moechtest du einholen?(Tip: 'alle' oder eine\n"
    "Nummer, die Du beim Untersuchen der eigenen Wetten siehst...)\n");
    return 0;
}


// Den Hilfebefehl fuer ausgewaehlte Parameter ueberschreiben.

nosave int 
cmdHelp(string txt)
{
    string * avails;
    if ( (!this_player())
        || (!txt)
        || (!stringp(txt))
        || (!strlen(txt)) 
        || (sizeof(explode(txt,"/"))>1))
    {
        return 0; // Lassen wir mal die Standardhilfe ran.
    }
    avails=map_array(get_dir(HELPDIR "*.txt"),
        lambda( ({ 'x }), ({#'[..<] ,  'x, 0, 5 })));

    if (member(avails, txt)<0)
    {
        return 0;
    }
    else
    {
        this_player()->More(read_file(HELPDIR + txt + ".txt"));
    }
    return 1;
}

// Ziemlich krudes Interface, aber da muessen die Spieler jetzt
// erstmal durch... :)

nosave int
cmdSettings(string arg)
{
    mapping conf;
    string * arglist;
    int num;
    string dummy;

    if ((!this_player()) 
        || (!(conf=playerSettings(this_player()))))
    {
        return 0;
    }
    
    if ((!arg) || (arg=="") || (!stringp(arg)))
    {
        printf("Deine Einstellungen am Roulette-Tisch:\n");
        walk_mapping(playerconf, 
            lambda( 
                ({ 'x, 'y ,'z}), 
                ({#'printf , 
                    "%10s: %d (%s)\n", 'x, 
                    ({ #'[,  'z, ({ #'[, 'y, 0 })}),
                    ({#'[ , 
                        ({ #'[ , 'y , 1 }) , 
                        ({ #'[,  'z, ({ #'[, 'y, 0 }) })
                    })
                })),conf);
        printf("(Mit '"+query_verb()+" <option>' mehr anzeigen.)\n");
    }
    else
    {
        arglist=explode(arg," ");
  
        if (!member(playerconf,arglist[0]))
        {
            printf("Die Option '%s' ist nicht bekannt.\n",arglist[0]);
        }
        else
        {
            if (sizeof(arglist)==1)
            {
                printf("Die Option '%s' kennt folgende Einstellungen:\n",arg);
                walk_mapping(playerconf[arg][1],
                    lambda(
                        ({ 'x, 'y }),
                        ({#'printf  ,  
                            "%3d : %s\n",
                            'x,'y})));
            }
            else
            {
                if (sizeof(arglist)>2)
                {
                    printf("Zu viele Argumente...\n"
                            "Syntax: %s <option> <zahl>\n",
                        query_verb());
                }
                else
                {
                    if ((sscanf(arglist[1],"%d%s",num,dummy)!=2) ||
                        (dummy!=""))
                    {
                        printf("Als Werte bitte nur ganze Zahlen.\n");
                    }
                    else if (!member(playerconf[arglist[0]][1],num))
                    {
                        printf("Die Option '%s' kennt den Wert %d nicht.\n",
                            arglist[0],num);
                    }
                    else
                    {
                        this_player()->SetProp(P_COMET,
                            (mapping)this_player()->QueryProp(P_COMET)
                            +([playerconf[arglist[0]][0] : num]));
                        printf("Option '%s' auf %d (%s) gesetzt.\n",
                            arglist[0],num,playerconf[arglist[0]][1][num]);
                    }
                } 
    
            }
        }
    }
    return 1;
}


