// Damit bei einem versehentlichen "here make" die Wetten gesichert
// werden... Statistikfanatiker koennen ja sonstwas haben wollen.

varargs public int 
remove()
{
    Save();
    return ::remove();
}

    // Welche Kriterien koennen als Anhalt genommen werden, um einen VIP
    // auszumachen?

    // 1. Grosser Spiele, d.h. Wetten, die am Tischlimit gesetzt wurden.
    //    Minimum-Rating:0 , Maximum-Rating: Je Gewinnklasse je mind.
    //    ein gewonnenes und ein verlorenes Limit. Linear. Je erreichtem
    //    Limit gibt's 900 Punkte, insgesamt also knapp ueber 10000.
    //    *** Obacht, das Table Limit kann geaendert werden.. Was bedeutet
    //    dass nach einer Evaluierungsphase das Limit nicht mehr geaendert
    //    werden sollte.  
    //
    // 2. Anzahl aller Wetten.
    //    nicht-linear, Grenzwert sollte im realistischen Bereich bei der 
    //    Haelfte dessen liegen, was die grossen Spiele ausmachen. 
    //    Logarithmisch.
    //    rating := 
    //        n <= 2 : 0
    //               : to_int(1000.0*log(to_float(n)/2.0)))
    //        gedeckelt bei 9999
    //       10 := 1609
    //       50 := 3219
    //      200 := 4605
    //     1000 := 6215
    //    44002 := 9999
    //
    // 3. Gesamtes Spielvolumen.
    //    Wechselkurs Geld in C ist 1:100. Insgesamt muss man natuerlich
    //    festhalten, dass man den gesamten Tisch bespielen kann und von
    //    seinen Einsaetzen nur 2.7% verliert. Man kann dieses Rating also
    //    monetaer ausformulieren: Wer im Schnitt x Muenzen verloren hat,
    //    bekommt Y Ratingpunkte. Darf man natuerlich nicht so annehmen, 
    //    da es bestimmt auch Glueckspilze gibt.
    //    Sagen wir: Jemand, der 2.7 Millionen Muenzen reingepumpt hat, hat
    //    sich die Ratingstufe redlich verdient. Das entspricht einem 
    //    durchschnittlichen Gesamteinsatz von 1.000.000 C.
    //    log(1.0+i/100000.0)*10000
    //
    //          100 :=     4
    //         1000 :=    43
    //        10000 :=   413
    //       100000 :=  3010
    //      1000000 := 10413
    //     10000000 := 20043 (Harter Deckel bei 20000)

    // Fuer den Platinum-Status muss es dann das sein: 
    // Rating fuer Gold Rang plus eine "komplett bis zum 
    // maximum" announcierte Wette auf einer der mittleren Zahlen 
    // (2, 5, 8, 11, 14, 17, 20, 23, 26, 29, 32) ... Teurer Spass
    // und die Gewinnchancen sind auch nicht so furchtbar gut. ;)
    // Oktarin? Vorlaeufig nur als Betreiber oder dessen Gefolge :-P


#define RATING_LIMIT   900    // 900 * 12 = 10800

// Interactives only. 

varargs public int 
RecalcVip(mixed uuid, int debug)
{
    mapping stats;
    int rating;
    int i, sum;
    int * ind;

    if (objectp(uuid))
    {
        if (!query_once_interactive(uuid))
        {
            return -1;
        }
        else
        {
            uuid=getuuid(uuid);
        }
    }
    if (!stringp(uuid))
    {
        return -2;
    }
    if (!member(table_stats[STATISTICS_PLAYERS], uuid))
    {
        return 0; // Kein Eintrag - kein VIP. Das war einfach.
    }
   
    if (!this_player()) 
    {
        debug=0;  // Debugmodus nur, wenn jemand liest.
    }

    stats=table_stats[STATISTICS_PLAYERS][uuid];

    if (debug)
    {
        printf("Ratings fuer Spieler-UUID %s:\n"
               "---------------------------------------------\n"
               "Rating fuer maximale Einsaetze\n",uuid);

    }
    
    for (i=(sizeof(ind=m_indices(stats)-({0})));i-->0;) 
    {
            // in der 0 ist die summary...
    
        sum=(RATING_LIMIT*stats[ind[i]][STC_MAX][WON]*ind[i])/TABLE_LIMIT;
        if (debug)
        {
            printf("%2d:1 (gewonnen) %6d -> Rating %3d\n",
               ind[i], stats[ind[i]][STC_MAX][WON],sum);
        }
        rating+=(sum>RATING_LIMIT?RATING_LIMIT:sum); 
        sum=(RATING_LIMIT*stats[ind[i]][STC_MAX][LOST]*ind[i])/TABLE_LIMIT;
        if (debug)
        {
            printf("%2d:1 (verloren) %6d -> Rating %3d\n",
               ind[i], stats[ind[i]][STC_MAX][LOST],sum);
        }
        rating+=(sum>RATING_LIMIT?RATING_LIMIT:sum);
    }
    i = stats[0][STC_COUNTS][WON]+stats[0][STC_COUNTS][LOST];
    switch (i)
    {
        case 0..2: 
           sum=0;
           break;
        case 3..44000:
           sum=to_int(1000.0 * log(to_float(i)/2.0));
           break;
        default:
            sum=9999;
    }
    if (debug)
    {
        printf("Zwischensumme: %d\n"
               "---------------------------------------------\n"
                "Rating fuer die Anzahl von Wetten:\n"
                "Wetten insgesamt: %d --> Rating %d\n"
                "Zwischensumme: %d\n"
               "---------------------------------------------\n",
                rating, i, sum, rating+sum);
    }
    rating+=sum;
    i = ( stats[0][STC_AVERAGE][WON] * stats[0][STC_COUNTS][WON]
       + stats[0][STC_AVERAGE][LOST] * stats[0][STC_COUNTS][LOST]) ;
    sum=to_int(log(1.0+i/100000.0)*10000.0);
    if (debug)
    {
        printf("Rating fuer die Summe aller Wetteinsaetze:\n"
            "Insgesamt eingesetzt: %f --> Rating %d\n"
            "---------------------------------------------\n"
            "Rating:  >> %d << \n",
                i, sum, rating+sum);
    }

    // TODO - Specials wie zB. Announcen bewerten.

    rating =((explode(getuid(this_object()),".")[<1]==explode(uuid,"_")[0])
        ?5:(sum+rating)/10000);
    if ((!debug) && (rating))
    {
        if (!member(table_stats[STATISTICS_SPECIAL], uuid))
        {
            table_stats[STATISTICS_SPECIAL]+=([uuid: ([SPECIAL_VIP:0])]);
        }
        else if (!member(table_stats[STATISTICS_SPECIAL][uuid],SPECIAL_VIP))
        {
            table_stats[STATISTICS_SPECIAL][uuid]+=([SPECIAL_VIP:0]);
        }

        if (table_stats[STATISTICS_SPECIAL][uuid][SPECIAL_VIP] != rating)
        {
            DO_LOG(LOG_VIP,sprintf("VIP-Status von %s geaendert (%d -> %d)",
                uuid,
                table_stats[STATISTICS_SPECIAL][uuid][SPECIAL_VIP],
                rating));
            table_stats[STATISTICS_SPECIAL][uuid][SPECIAL_VIP]=rating;
            if ((this_player()) && (getuuid(this_player())==uuid))
            {
                 this_player()->Message("Dein Status als VIP-Gast des "
                 "Casino 'Comet' hat sich soeben geaendert.\n");
            }
        }
    }

    return rating;
}




// Ansagen muessen, leider, ziemlich hardcoded werden, die sind 
// einfach zu verschieden.

// <nummer> komplett [mit] <einsatz>
//    - Besetzt alle inneren Wetten, die <nummer> enthalten, d.h.
//      Auf die Zahl, die Doppelfelder, alle Reihen und Gevierte.
//      NICHT dabei sind aeussere Wetten. Wer also wirklich alles
//      abdecken will, muss Farbe, Paritaet, Haelfte, Dutzend und
//      Kolonne "von Hand" nachtragen. 
//      <einsatz> ist die Hoehe auf das Plein, die anderen Felder
//      werden mit einem Einsatz entsprechend den Quoten besetzt.
//      Wer mit "maximum" setzt, setzt ueberall das Tischlimit.
//      Gewinn und Einsatz haengt von der gewaehlten Zahl ab und 
//      ist in der Regel HOCH.
//
// <nummer> und nachbarn [mit] <einsatz>
//      Je ein Einsatz auf die gewaehlte Zahl und die vier
//      Nachbarn im Kessel. 5x plein.
//
// finale <nummer> [mit] <einsatz>
//      Platziert je einmal <einsatz> auf alle Zahlen mit der 
//      Endziffer <nummer>, entsprechend bewegt sich <nummer> 
//      zwischen incl. 0 und 9. Bei Wetten auf 0 .. 6 wird der
//      vierfache, bei Wetten auf 7..9 der dreifache <einsatz>
//      faellig.
//      
// voisins du zero [mit] <einsatz]
//      Benannte Wette auf 17 Zahlen, werden gesetzt als
//      (2x) 023, 4/7, 12/15, 18/21, 19/22, (2x) 25-29, 32/35
//      ... d.h. der neunfache <einsatz>
// 
// Nullspiel [mit] <einsatz>
//      Benannte Wette, wird gesetzt als
//      0/3, 12/15, 26, 32/35, deckt die Null und ihre direkten
//      Nachbarn ab: 12, 35, 3, 26, 0 32, 15.
//
// Le tiers du cylindre (Thirds of the wheel)
//     Benannte Wette auf die Zahlenserie gegenueber der Null, 
//     und enthaelt 27,13,36,11,30,8,23,10,5,24,16,33.
//     Gesetzt werden 6 Splits:5/8; 10/11; 13/16; 23/24; 27/30; 33/36
//
// orphelins/orphans/waisen
//     Der Rest, der nach Voisins und Tiers uebrig bleibt, naemlich
//     17,34,6 und 1,20,14,31,9. Gesetzt wird 6/9, 14/17, 17/20, 31/34.
//
//



nosave int
fail(string message)
{
    object croupier;

    if (this_player()) 
    {
        croupier=present(CROUPIERID);
        this_player()->Message(break_string(message, 77,
            (croupier
                ?croupier->Name(WER)+" fluestert Dir zu: "
                :"Eine geheimnissvolle Stimme fluestert Dir zu: "),1));
    }
    return 1;
}

public int
IsVip(mixed player)
{
    if (objectp(player))
    {
        player=getuuid(player);
    }
    if ( (!stringp(player))
            || (!member(table_stats[STATISTICS_SPECIAL],player))
            || (!member(table_stats[STATISTICS_SPECIAL][player],SPECIAL_VIP)))
    {
        return 0;
    }
    return table_stats[STATISTICS_SPECIAL][player][SPECIAL_VIP];
}

nosave int
cmdAnn(string ann)
{
    object croupier;
    string rest,dummy;
    int i,j,errors,no,bet,limit,total;
    mapping chancelist;
    mapping todo;
    string * idx;

    if (!this_player())
    {
        return 0;
    }   
    if (!croupier=present(CROUPIERID))
    {
        notify_fail(break_string(
            "Du kannst nur dann Wetten ansagen, wenn ein Croupier anwesend "
            "ist, der Ansagen entgegen nimmt. Laut Statuten des Casinos "
            "wird jedem VIP mit Mitgliedsstatus Silber oder hoeher die "
            "Praesenz eines Croupiers zugesichert, andere Spieler haben "
            "keinen garantierten Anspruch.",77));
        return 0;
    }

    if (!IsVip(this_player()))
    {
        return fail("Die Platzierung kombinierter Wetten darf ich "
                "bedauerlicherweise nur fuer VIPs des Casino 'Comet' "
                "uebernehmen. Sammel' doch erst einmal selbst Erfahrung "
                "am Tisch.");
    }
    if ((table_status!=STAT_FREI) && (table_status!=STAT_KUGELROLLT))
    {
        return fail("Zur Zeit werden keine Ansagen entgegen genommen.");
    }
    if ((!ann)||(!stringp(ann))||(!strlen(ann)))
    {
        return fail("Und welche Wette mit welchem Einsatz willst "
            "Du platzieren?");
    }
    if ( ((sscanf(ann,"%s mit %d%s",rest,bet,dummy)==3) &&
        (dummy=="")) ||
          ((sscanf(ann,"%s %d%s",rest,bet,dummy)==3) && (dummy=="")))
    {
        if (bet<=0)
        {   
            return fail("Auch bei announcierten Wetten gilt: "
            "Keine Leerverkaeufe.");
        }
        else if (bet > TABLE_LIMIT/35)
        {
            return fail("Dein einfacher Einsatz darf das Limit fuer "
                "eine Zahl nicht ueberschreiten. Die Wette wird "
                "teuer genug.");
        }
    }
    else if ((sscanf(ann,"%s mit limit",rest)==1)
          || (sscanf(ann,"%s limit",rest)==1)
          || (sscanf(ann,"%s mit max",rest)==1)
          || (sscanf(ann,"%s max",rest)==1)
          || (sscanf(ann,"%s mit maximum",rest)==1)
          || (sscanf(ann,"%s maximum",rest)==1))
    {
        bet=TABLE_LIMIT/35;
        limit=1;
    }
    else
    {
        return fail("Du solltest sagen, wieviel Du setzen moechtest.");
    }

    total=0;
    errors=0;
    todo=([]);

    // <nummer> komplett

    if ((sscanf(rest, "%d komplett%s",no, dummy)==2)&&(dummy==""))
    {
        if ((no>36)||(no<0))
        {
            return fail(sprintf("Du kannst nur auf die Zahlen setzen, die der "
                "Tisch fuehrt. %d ist nicht dabei.\n",no));
        }
        if (limit)
        {
            limit=2;
        }
        dummy=sprintf("%d komplett mit %s",no,(limit?"Maximum":to_string(bet)));

                    // Dann suchen wir mal alle Wetten zusammen, 
                    // die wir setzen wollen. Das sind laut Konvention alle 
                    // inneren Wetten, die diese Zahl beruehren.

        // Schleife, damit man schoener summieren kann.
        for (i=sizeof(idx=m_indices(chances));i-->0;)
        {
            if ( (chances[idx[i]][XRET]>2) 
                && member(chances[idx[i]][XNUM], no))
            {
                todo+=([idx[i]:(bet*36)/(1+chances[idx[i]][XRET])]);
            }
        }
    }

    // <nummer> und nachbarn

    else if ((sscanf(rest, "%d und nachbarn%s",no, dummy)==2)&&(dummy==""))
    {
        if ((no>36)||(no<0))
        {
            return fail(sprintf("Du kannst nur auf die Zahlen setzen, die der "
                "Tisch fuehrt. %d ist nicht dabei.\n",no));
        }
        dummy=sprintf("%d und Nachbarn mit %d", no, bet);
        i=member(table_wheel,no);
        todo=([to_string(no):bet,
            to_string(table_wheel[((i+36)%36)-1]):bet,
            to_string(table_wheel[((i+36)%36)-2]):bet,
            to_string(table_wheel[((i+37)%36)]):bet,
            to_string(table_wheel[((i+38)%36)]):bet,
            ]);
    }

    // finale <nummer> 

    else if (((sscanf(rest, "finale %d%s",no, dummy)==2)
          || (sscanf(rest, "fin %d%s",no, dummy)==2)
          || (sscanf(rest, "finalen %d%s",no, dummy)==2))
               &&(dummy==""))
    {
        if ((no>9)||(no<0))
        {
            return fail("Finalen als Endziffern koennen "
                "nur im Bereich von 0 bis 9 liegen.");
        }
        dummy=sprintf("Finalen %d mit %d", no, bet);
        todo=([ to_string(no):bet,
                to_string(no+10):bet,
                to_string(no+20):bet]);
        if (no<7)
        {
            todo+=([ to_string(no+30):bet]);
        }       
    }

    // voisins du zero - kein deutscher Titel

    else if ((rest=="voisins du zero")
        ||   (rest=="vdz")
        ||   (rest=="voisins"))
    {
        dummy=sprintf("'Voisins du Zero' mit %d", bet);
        todo=([ "023":2*bet,
                "4 7":bet,
                "12 15":bet,
                "18 21":bet,
                "19 22":bet,
                "25 29":bet*2,
                "32 35":bet
                ]);
    }

    // Nullspiel

    else if ((rest=="nullspiel")
        ||   (rest=="ns")
        ||   (rest=="zero spiel"))
    {
        dummy=sprintf("Nullspiel mit %d", bet);
        todo=([ "0 3":bet,
                "12 15":bet,
                "26":bet,
                "32 35":bet ]);
    }
    // Le tiers du cylindre (Thirds of the wheel)
    else if ((rest=="les tiers du cylindre")
        ||   (rest=="tdc")
        ||   (rest=="thirds of the wheel")
        ||   (rest=="tiers")
        ||   (rest=="third"))
    {
        dummy=sprintf("'Les Tiers du Cylindre' mit %d", bet);
        todo=([ "5 8":bet,
                "10 11":bet,
                "13 16":bet,
                "27 30":bet,
                "33 36":bet,
                "23 24":bet ]);
    }
    // orphelins/orphans/waisen
    else if ((rest=="orphelins")
        ||   (rest=="waisen")
        ||   (rest=="orph")
        ||   (rest=="waise")
        ||   (rest=="orphans"))
    {
        dummy=sprintf("'Orphelins' mit %d", bet);
        todo=([ "6 9":bet,
                "14 17":bet,
                "17 20":bet,
                "31 34":bet ]);
    }
    else
    {
        return fail("Diese Ansage kenne ich nicht.");
    }

    for (i=sizeof(idx=m_indices(todo));i-->0;)
    {     
        if (limit) 
        {
            todo[idx[i]]=TABLE_LIMIT/chances[idx[i]][XRET];
        }
        total+=todo[idx[i]];
        if (rest=ProcessBet(this_player(),"1 "+idx[i],2))
        {
            printf("%s\n",rest);
            errors++;
        }
    }

    if (errors)
    {
        return fail(sprintf("Da waeren %d Probleme mit Deiner Ansage...",
                errors));
    }
    if (!HasJetons(this_player(),total))
    {
        return fail(sprintf("Die Wette wuerde Dich insgesamt %d kosten, "
            "so viel hast Du aber nicht.",total));
    }

    this_player()->Message(sprintf("Du sagst '%s' an.\n", dummy));
    Message(sprintf("%s sagt: Ansage %s: \"%s\"!\n", 
        croupier->Name(WER),
        this_player()->name(WESSEN),
        dummy,this_player()));
        
    for (i=sizeof(idx=m_indices(todo));i-->0;)
    {
        ProcessBet(this_player(),todo[idx[i]]+" "+idx[i],1);
    }
    DO_LOG(LOG_BETS,sprintf("Announce: %s (%d)", dummy,total));
    this_player()->Message(break_string(sprintf("Fuer Deine Ansage '%s' "
        "wurden insgesamt %d Cometen platziert.\n",dummy,total),77));


    if (find_call_out("Schedule")<0)
    {
        call_out("Schedule",6);
    }
    return 1;
}


nosave int
startCAForCroupier()
{
    if (!this_player())
    {
        return 1;
    }   
    if (sizeof(getBetList(0, this_player(), 1)))
    {
        write("Du hast noch Wetten auf dem Tableau, Du kannst doch jetzt "
            "nicht weg!\n");
        return 0;
    }
    while (remove_call_out("checkForCroupier")>=0);
    call_out("checkForCroupier",4);
    return 1;
}

nosave void
checkForCroupier()
{
    object cr;
    object * livings;
    int vipda;
    if (!this_player())
    {
        return;
    }   

    livings=filter_array(all_inventory(this_object()),#'living);

    while ((!vipda) && sizeof(livings))
    {
        if (IsVip(livings[0])<VIP_SILVER)
        {
            livings=livings[1..];
        }
        else
        {
            vipda=1;
        }
    }
    if ((cr=present(CROUPIERID)) && (!vipda))
    {
        cr->OffDuty();
    }
    else
    {
        if ((!cr) && (vipda))
        {
            call_other(DOVENYA_NPC "donal","OnDuty");
        }
    }
    return;
}

public void
init()
{
    ::init();
    if (this_player() && ((IsVip(this_player()))>=VIP_SILVER))
    {
        startCAForCroupier();
    }
}

