/* Dovenya, Dorfweg
 * _____________________________________(i) Anatol@Silberland (1998-2012) */


#pragma strict_types

#include "../defines.h"

inherit DOVENYA "std/room";


public void 
create() 
{
    ::create();

    SetProp(P_INDOORS,0);
    
    SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:23,
                            ENV_TERRAIN:TT_TOWN,
                            ])); 

    SetProp(P_INT_SHORT,"Dovenya, Dorfweg");
    SetProp(P_INT_LONG,
        "Der Dorfweg fuehrt in westlicher Richtung zum Brunnenplatz. "
        "Ein kleines Stueck weiter im Suedosten liegt der Markt. "
        "Unmittelbar suedlich steht ein Glockenturm, der ist von hier aus "
        "aber nicht betretbar."
        );
    
    SetProp(P_GEMA,({1,5,0}));
    
    AddDetail(({"xxx"}),"");

    seteuid(getuid(this_object()));
    Sky();
  
  
    AddExit("westen",
        ([ EX_DEST: "./brunnenplatz", 
           EX_PLMSG: "Du betrittst den Brunnenplatz.\n",
           EX_MSG: "auf den Brunnenplatz"]));
 
    AddExit("suedosten",
        ([ EX_DEST: "./dorfweg_so", 
           EX_PLMSG: "Du folgst dem Dorfweg nach Suedosten.\n",
           EX_MSG: "dem Dorfweg folgend nach Suedosten"
               ]));

    SetProp(P_HIDE_EXITS,({""}));

}
