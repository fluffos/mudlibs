        return fetchBet(this_player(),getbet);
    }
    notify_fail("Welche Wetten moechtest du einholen?(Tip: 'alle' oder eine\n"
    "Nummer, die Du beim Untersuchen der eigenen Wetten siehst...)\n");
    return 0;
}


// Den Hilfebefehl fuer ausgewaehlte Parameter ueberschreiben.

static int 
cmdHelp(string txt)
{
    string * avails;
    if ( (!this_player())
        || (!txt)
        || (!stringp(txt))
        || (!strlen(txt)) 
        || (sizeof(explode(txt,"/"))>1))
    {
        return 0; // Lassen wir mal die Standardhilfe ran.
    }
    avails=map_array(get_dir(HELPDIR "*.txt"),
        lambda( ({ 'x }), ({#'[..<] ,  'x, 0, 5 })));

    if (member(avails, txt)<0)
    {
        return 0;
    }
    else
    {
        this_player()->More(read_file(HELPDIR + txt + ".txt"));
    }
    return 1;
}

// Ziemlich krudes Interface, aber da muessen die Spieler jetzt
// erstmal durch... :)

static int
cmdSettings(string arg)
{
    mapping conf;
    string * arglist;
    int num;
    string dummy;

    if ((!this_player()) 
        || (!(conf=PlayerSettings(this_player()))))
    {
        return 0;
    }
    
    if ((!arg) || (arg=="") || (!stringp(arg)))
    {
        printf("Deine Einstellungen am Roulette-Tisch:\n");
        walk_mapping(playerconf, 
            lambda( 
                ({ 'x, 'y ,'z}), 
                ({#'printf , 
                    "%10s: %d (%s)\n", 'x, 
                    ({ #'[,  'z, ({ #'[, 'y, 0 })}),
                    ({#'[ , 
                        ({ #'[ , 'y , 1 }) , 
                        ({ #'[,  'z, ({ #'[, 'y, 0 }) })
                    })
                })),conf);
        printf("(Mit '"+query_verb()+" <option>' mehr anzeigen.)\n");
    }
    else
    {
        arglist=explode(arg," ");
  
        if (!member(playerconf,arglist[0]))
        {
            printf("Die Option '%s' ist nicht bekannt.\n",arglist[0]);
        }
        else
        {
            if (sizeof(arglist)==1)
            {
                printf("Die Option '%s' kennt folgende Einstellungen:\n",arg);
                walk_mapping(playerconf[arg][1],
                    lambda(
                        ({ 'x, 'y }),
                        ({#'printf  ,  
                            "%3d : %s\n",
                            'x,'y})));
            }
            else
            {
                if (sizeof(arglist)>2)
                {
                    printf("Zu viele Argumente...\n"
                            "Syntax: %s <option> <zahl>\n",
                        query_verb());
                }
                else
                {
                    if ((sscanf(arglist[1],"%d%s",num,dummy)!=2) ||
                        (dummy!=""))
                    {
                        printf("Als Werte bitte nur ganze Zahlen.\n");
                    }
                    else if (!member(playerconf[arglist[0]][1],num))
                    {
                        printf("Die Option '%s' kennt den Wert %d nicht.\n",
                            arglist[0],num);
                    }
                    else
                    {
                        this_player()->SetProp(P_COMET,
                            (mapping)this_player()->QueryProp(P_COMET)
                            +([playerconf[arglist[0]][0] : num]));
                        printf("Option '%s' auf %d gesetzt.\n",
                            arglist[0],num);
                    }
                } 
    
            }
        }
    }
    return 1;
}


