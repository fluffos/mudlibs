nomask static int 
manager_security()
{
    return  (  (this_interactive())
        && (this_player()==this_interactive())
        &&  (( IS_ARCH(this_interactive())) 
            || (getuid(this_interactive())=="anatol")));
}


static mapping
initializePlayerSettings(object player)
{
   if ((!objectp(player))||(!living(player)))
   {
       return 0;
   }
   player->SetProp(P_COMET,
        ([COMET_LANG:0,
          COMET_GFX:0,
          COMET_AUTOCOLLECT:1]));
   player->Set(P_COMET,SAVE,F_MODE_AS);
   return ([])+(mapping)(player->QueryProp(P_COMET));
}

public mapping 
PlayerSettings(object player)
{
   if ((!objectp(player))||(!living(player)))
   {
       return 0;
   }
   if (!(player->QueryProp(P_COMET)))
   {
       return initializePlayerSettings(player);
   }
   else
   {
       return ([])+(mapping)(player->QueryProp(P_COMET));
   }
}

