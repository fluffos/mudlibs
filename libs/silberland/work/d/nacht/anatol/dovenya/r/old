public string 
processBet(object player, string input)
{
    mixed bet;   // Pointer auf die Wette
    mapping ret;
    int stake;     // Einsatz
    int num1,rum2;
    string rest;   // Rest-String
    string rest2;
    string * matches;
    int lang;

    bet=0;

    if ((!objectp(player))||(!living(player)))
    {
        return 0;
    }
    lang=(PlayerSettings(player))[COMET_LANG];

    if (table_status==STAT_ABGESAGT)
    {
        return "Aaah, zu spaet, die Kugel wird gleich fallen!";
    }
    else if ((table_status!=STAT_FREI) && (table_status!=STAT_KUGELROLLT))
    {
        return "Du kannst jetzt leider keine Wetten platzieren.";
    }
    

    // Erst pruefen, ob der Einsatz prinzipiell passt. Table Limits koennen 
    // erst spaeter geprueft werden, diese haengen von der Quote der Wette ab.

    else if ((sscanf(input,"%d%s",stake,rest)==2) && (rest=="")) // Nur Einsatz
    {
        return "Auf was moechtest Du Deinen Einsatz abgeben?";
    }
    else if (sscanf(input,"%d %s",stake,rest)!=2)  // Fehlzeichen
    {
        return "Das mit Deinem Einsatz hat so gar nicht geklappt.";
    }
    else if (!stake) // Guter Witz...
    {
        return "Wenn Du nichts setzen moechtest, brauchst Du nicht setzen.";
    }
    else if (stake<0)  // Bei DEN Chancen wuerde jeder Leerverkaeufe wollen
    {
        return "Negative Betraege kannst Du an der Boerse setzen, hier nicht.";
    }
    else if (!hasJetons(player,stake)) // Nicht ubernehmen...
    {
        return "So viele Jetons hast Du leider nicht.";
    }

    // Okay. Der Einsatz ist in Ordnung. Wie sieht es mit der Chance aus?

    if (sscanf(rest,"auf %s",rest2)==1) // Weglesen von "auf"
    {
        rest=rest2;
    }

    // Wenn aus dem Text keine eindeutige Chance ermittelt werden kann
    // wird das mit dem Setzen leider auch nix.
    
    if (!bet=getChance(rest)) 
    {
        return "Darauf kannst Du keine Wette platzieren.";
    }

    // Abschliessend Limit pruefen. 100'000 auf Rot tun nicht wirklich
    // weh, aber 100'000 auf eine Zahl... bei Gewinn wuerden 3.5 Millionen
    // ausgeschuettet werden. Ob da die Bankaufsicht mitmacht?

    else if ((stake * chances[bet[1][XRET]])>table_limit)
    {
        return "Fuer diese Wette ist Dein Einsatz zu hoch und "
            "wuerde das Tischlimit sprengen.";
    }

    table_bets+=({ ([ BET_CHANCE:bet[1],
                BET_TIME:time(),
                BET_OWNER:file_name(player),
                BET_STATUS:0,
                BET_STAKE:stake,
                BET_CHANCE_NAME:bet[0] ]) });

    addJetons(player, (-1) * stake);
   
    player->Message(sprintf("Du platzierst %d Jetons auf '%s'.\n",
        stake,GetChanceName(bet[0],lang)));
    Message(sprintf("%s setzt %d Jetons.\n",
        player->Name(WER), stake),
        MSGFLAG_VISUAL,([MSGFLAG_EXCLUDE:({player})]));
    return 0; // SUCCESS!
}



static void
cleanMasse()
{
    mixed masse;
    object player;
    int i;
    int cash;

    if (!sizeof(table_bets))
    {
        Message("Es wurden keine Einsaetze getaetigt.\n");
        return;
    }
    masse = filter_array(table_bets,lambda(({ 'x, 'y }), 
        ({#'! , ({#'member , 
            ({#'[ , ({#'[ , 'x , BET_CHANCE }) , XNUM }) , 'y })})
        
        ), table_rolled);
    if (!sizeof(masse))
    {
        Message("In dieser Runde gibt es keine Masse.\n");
    }
    else
    {
        cash=0;

        while (sizeof(masse))
        {
            // TODO: Verlorene Wette Archivieren
            // TODO: Statistik fuehren
            if (player=find_object(masse[0][BET_OWNER]))
            {
                player->Message(sprintf(
                    "Deine Wette mit %d auf '%s' verlor.\n",
                        masse[0][BET_STAKE],
                        GetChanceName(masse[0][BET_CHANCE_NAME],
                            PlayerSettings(player)[COMET_LANG])));
            }
            cash+=masse[0][BET_STAKE];
            table_bets-=({masse[0]});
            masse=masse[1..];
        }
        Message(sprintf("Eine Masse von %d wird eingezogen.\n",cash));
    }
}

public void
processWinnings()
{
    mixed winnings;
    object player;
    mapping conf;

    int winc,win,i; // Iterieren, evtl bleibt ja was stehen...

    if (!sizeof(table_bets))
    {
        return;
    }
    for (winc=i=sizeof(table_bets);i-->0;)
    {
        win=table_bets[i][BET_STAKE]*(1+table_bets[i][BET_CHANCE][XRET]);
        if (player=find_object(table_bets[i][BET_OWNER]))
        {
            conf=PlayerSettings(player);
            player->Message(sprintf(
                "Deine Wette mit %d auf '%s' war erfolgreich.\n",
                    table_bets[i][BET_STAKE],
                    GetChanceName(table_bets[i][BET_CHANCE_NAME],
                        conf[COMET_LANG])));
        }
        if (!conf[COMET_AUTOCOLLECT])
        {
            if (win > (table_limit/table_bets[i][BET_CHANCE][XRET]))
            { 
                if (player)
                {
                    player->Message(break_string(sprintf(
                        "Du kannst die Wette nicht stehen lassen, da sie "
                        "das Limit fuer diese Wette sprengen wuerde - Du "
                        "nimmst Gewinn und Einsatz - %d Jetons - auf.",win),
                        77));
                    addJetons(player,win);
                    table_bets[i]=0;
                }
                else
                {
                    Message(break_string(
                        "Die Wette, dessen Eigentuemer nicht mehr "
                        "auffindbar ist, wuerde das Tischlimit sprengen! "
                        "Der Einsatz wird auf das Tischlimit begrenzt - mit "
                        "der Differenz machen die Croupiers sich einen "
                        "wirklich schoenen Abend.",77));
                    table_bets[i][BET_STAKE]=
                        table_limit/table_bets[i][BET_CHANCE][XRET];
                }
            }
            else
            {
                table_bets[i][BET_STAKE]=win;
            }
        }
        else
        {

            player->Message(sprintf( 
                "Du erhaeltst %d Jetons auf die Hand.\n", win));
            addJetons(player,win);
            table_bets[i]=0;
        }
    }
    // Eingeholte Wetten tilgen.
    table_bets-=({0});
    Message(sprintf("Es %s %s %s. Die Kugel wird wieder aufgenommen.\n",
        (winc>1?"gewannen":"gewann"),
        (winc==1
            ?"eine"
            :(winc>0
                ?to_string(winc)
                :"keine")),
        (winc>1?"Wetten":"Wette")));
    return;
}

public void
Schedule()
{
    if (previous_object()!=this_object())
    {
        return;
    }
    while (remove_call_out("Schedule")!=-1);

    switch (table_status)
    {

        case STAT_FREI:
            if ((!sizeof(table_bets)) || (time()-(table_bets[<1][BET_TIME]))<6)
            {
                return call_out("Schedule",2);
            }
            else
            {
                Message("Die Kugel wird in den Kessel gesetzt "
                    "und dreht jetzt ihre Kreise.\n");
                table_status=STAT_KUGELROLLT;
                return call_out("Schedule",6);
            }
            break;
        case STAT_KUGELROLLT:
            Announce("rnvp");
            table_status=STAT_ABGESAGT;
            return call_out("Schedule",6);
            break;
        case STAT_ABGESAGT:
            Message("Die Kugel springt ein wenig ueber die "
                "Faecher und bleibt dann liegen.\n");
            Announce(table_rolled=random(37));
            table_status=STAT_GEFALLEN;
            return call_out("Schedule",4);
            break;
        case STAT_GEFALLEN:
            cleanMasse();
            table_status=STAT_AUSWERTUNG_M;
            return call_out("Schedule",2);
            break;
        case STAT_AUSWERTUNG_M:
            processWinnings();
            table_status=STAT_AUSWERTUNG_G;
            return call_out("Schedule",4);
            break;
        case STAT_AUSWERTUNG_G:
            table_status=STAT_FREI;
            Announce("fvj");
            // Koennte ja was stehen geblieben sein:
            return call_out("Schedule",8); 
            break;
        default:
            return;

    }
}


