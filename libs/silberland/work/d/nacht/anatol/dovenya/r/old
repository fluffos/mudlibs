varargs public void 
Announce(mixed message, object pl)
{
    object * rcpt;
    mapping conf;
    string output;
    string lead_in,lead_out;
    string * msgparts;
    
    lead_in="  |>  ";
    lead_out="  <|  ";
    if (pl)
    {
        if ((!objectp(pl)) 
            || (!living(pl)) 
            || (this_object()!=environment(pl)))
        {
            return;
        }
        rcpt=({pl});
    }
    else
    {
        rcpt=filter_array(all_inventory(this_object()),#'living);
    }

    if ((!sizeof(rcpt)) || ( (!intp(message)) && (!stringp(message))))
    {
        return;
    }

    while (sizeof(rcpt))
    {
        conf=PlayerSettings(rcpt[0]);
        
        // Nachrichtentypen...
        //   - String. Einfach. Oder auch nicht. Wenn es den String genau
        //     *so* im Vokabular gibt, wird er uebersetzt.
        //   - Zahlen. Das sind dann wohl Rolls. Gibts ne Funktion fuer.


        if (intp(message))
        {
            output=getFullAnnouncement((int)message, (conf[COMET_LANG]));
        }
        else if (member(vocabulary,message))
        {
            output=vocabulary[message,conf[COMET_LANG]];
        }
        else
        {  
            output=message;
        }
        output="\n"+(conf[COMET_GFX]>1?ANSI_BOLD:"")+
        break_string(output,60,"               ",1)+
                (conf[COMET_GFX]>1?ANSI_NORMAL:"")+"\n";

        rcpt[0]->Message(output);
        rcpt=rcpt[1..];
    }
    return;
}

varargs public string
GetChanceName(mixed chance, int lang)
{

    if (stringp(chance))
    {
        chance=getChance(chance);
    }
    if ((!chance) || (!pointerp(chance)))
    {
        return 0;
    }

    if (member(vocabulary,chance[0]))
    {
        return vocabulary[chance[0],lang];
    }
    else if (member(chance[1],XANN))
    {
        return vocabulary[chance[1][XANN],lang] +" "+
            (chance[1][XANN]=="ch"
                ?implode(explode(chance[0]," "),"/")
                :implode(explode(chance[0]," "),"-"));
    }
    else 
    {
        return "Schmeeeeerz!";
    }
}


