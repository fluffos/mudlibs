public object
hasJetons(object player, int jetons)
{
    object jet;
    if (objectp(player))
    {
        if  ((jet=present(JETONID,player)) && objectp(jet)
            && ((int)(jet->QueryProp(P_AMOUNT)))>=jetons)
        {
            return jet;
        }
    }
    else 
    {
        return 0;
    }
}

static void 
addJetons(object player, int jetons)
{
   object jet;
   if (!jet=hasJetons(player,1))
   {
        if (jetons < 1)
        {
            write("Da ging etwas schief. :(\n");
        }
        else
        {
            jet=clone_object(OBJ "jeton");
            jet->SetProp(P_AMOUNT,jetons);
            jet->move(player,M_NOCHECK);
        }
   }
   else
   {
        if ((jetons<0) && ((int)(jet->QueryProp(P_AMOUNT))<jetons))
        {
            write("Da ging etwas seltsam schief.\n");
        }
        else
        {
            jet->AddAmount(jetons);
            if ((int)(jet->QueryProp(P_AMOUNT))<0)
            {
                write("Super... Du hast einen Ganzzahlueberlauf geschafft.\n"
                    "Jetzt sieh zu, wie du diese... Schulden... loswirst.");
            }
        }
   }
}
static mixed
getChance(string ch)
{
    string * matches;

    if ((!ch) || (!stringp(ch)) ||(!strlen(ch))) 
    {
        return 0;
    }

    // Erstmal moegliche Fuellzeichen ("-" und "/") herausnehmen.
    // Die tauchen in der Chance auf und duerfen angegeben werden,
    // sind aber optional.

    ch=implode(explode(implode(explode(ch,"-")," "),"/")," ");

    // Idealfall: Die Platzierung ist genau so eingetragen.

    if (member(chances,ch))
    {
       return ({ch,chances[ch]});
    }

    // Vielleicht ist es als Alias eingetragen?

    else if (member(chances_aliases,ch))
    {
       return ({chances_aliases[ch],chances[chances_aliases[ch]]});
    }

    // Jetzt koennten wir eigentlich aufgeben. Schauen wir mal, ob mit
    // dieser Zeichenfolge zufaellig eine - genau eine - Chance beginnt. 

    else
    {
        matches=regexp(m_indices(chances),"^"+ch) + 
                 regexp(m_indices(chances_aliases),"^"+ch);
        if (sizeof(matches)==1)
        {
            return getChance(matches[0]);
        }

    }
    return 0;
}

varargs public string * 
getBetList(int lang, object player, int filtered)
{
    if (!objectp(player)) 
    {
        player=this_player(); // Kann immernoch 0 sein...
    }

    return map_array(
        ((filtered&&objectp(player))
            ?filter_array(table_bets,lambda( ({ 'x, 'y }) ,
                ({#'== , 
                    ({#'file_name, 'y  }), 
                    ({#'[ , 'x , BET_OWNER})})),player)
            :table_bets),
         lambda( ({ 'x , 'y, 'z, 'w}) ,
        ({ #'sprintf , "   %6d auf %-30s (%s)" ,
            ({#'[ , 'x , BET_STAKE }) ,
            ({#'sprintf , "'%s'" , 
                ({#'call_other , 'w , "GetChanceName" , 
                    ({#'[ , 'x ,  BET_CHANCE_NAME }), 'z})}) ,
            ({#'? , ({#'== , ({#'file_name , 'y }) ,
                            ({#'[ , 'x , BET_OWNER })}) ,
                "Du" ,
                ({#'? , ({#'find_object , ({#'[ , 'x , BET_OWNER })}) ,
                    ({#'call_other , ({#'[ , 'x, BET_OWNER}), "Name"}),
                    "Unbekannt"})})})), player, lang, this_object());
