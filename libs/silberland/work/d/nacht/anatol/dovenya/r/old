// Das Tischlimit begrenzt den Auszahlungswert.
// Ein Limit von 50'000 wuerde damit bedeuten, dass 
// 50'000 auf Schwarz gesetzt werden koennte, aber auf 
// eine Zahl maximal 1428. 

public int
SetTableLimit(int new_limit)
{
    if (!manager_security())
    {
        return 0;
    }
    if (new_limit < 10000 )
    { 
        return 0;
    }
    return table_limit=new_limit;
    Save();
    return table_limit;
}

