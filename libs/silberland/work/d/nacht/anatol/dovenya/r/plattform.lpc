#pragma strict_types

#include "../defines.h"

inherit DOVENYA "std/room";


public void 
create() 
{
    ::create();

    SetProp(P_INDOORS,0);
    
    SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:23,
                            ENV_TERRAIN:TT_TOWN,
                            ])); 

    SetProp(P_INT_SHORT,"Dovenya, am Aufzug");
    SetProp(P_INT_LONG,
        "Hier wird man mal vom Dorf nach unten kommen. Beziehungsweise von "
        "unten hierher ans Dorf. Irgendwoher muessen sie ja herkommen..."
        );
    
    SetProp(P_GEMA,({8,7,0}));
    
    AddDetail(({"xxx"}),"");

    seteuid(getuid(this_object()));
    Sky();
  
  
    AddExit("suedwesten",
        ([ EX_DEST: "./klippenweg_5", 
           EX_PLMSG: "Du verlaesst die Plattform und trittst "
               "auf den Klippenweg.\n",
           EX_MSG: "von der Plattform"
            ]));
    SetProp(P_HIDE_EXITS,({""}));

}
