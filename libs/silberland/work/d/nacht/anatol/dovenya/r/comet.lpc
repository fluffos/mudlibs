#pragma strict_types

#include "../defines.h"
#include <moving.h>
#include "../sys/comet.h"

#define EMPFANG DOVENYA_NPC "aine"

inherit DOVENYA "std/room";


public void 
create() 
{
    ::create();

    seteuid(getuid(this_object()));


    SetProp(P_INDOORS,1);
    
    SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:23,
                            ENV_TERRAIN:TT_HOUSE,
                            ])); 

    SetProp(P_INT_SHORT,"Dovenya, Casino 'Comet'");
    SetProp(P_INT_LONG,
        "Du stehst in der Lobby des Casinos 'Comet'. Es sieht geradezu "
        "luxurioes geraeumig aus und ist farblich in rot und golden "
        "gehalten. Rechts von Dir ist eine kleine Rezeption, direkt "
        "daneben fuehrt eine kleine mit einer goldenen Kette abgesperrte "
        "Wendeltreppe nach oben.");
    
    SetProp(P_GEMA,({0,2,0}));
    
    AddDetail("aine", "Oh... ja wo ist sie denn?");
    AddDetail(({"comet","casino"}),"Du stehst offenbar im Casino 'Comet'.");
    AddDetail(({"freske","fresken"}),
        "Diese Fresken sind offenkundig das verzierende Thema des Casinos, "
        "kein Raum ohne sie. Da hat sich jemand sehr viel Muehe gegeben.");
    AddDetail("raum","Da wo Du drin stehen tust.");
    AddDetail("muehe","Diese Fresken entstanden nicht von allein.");
    AddDetail("thema","Genaugenommen scheint Pomp und Luxus das Thema des "
        "Casinos zu sein. Das waere ja auch nicht voellig ueberraschend.");
    AddDetail("kette",
        "Die goldene Kette sperrt die nach oben fuehrende Wendeltreppe und "
        "ist offenbar unueberwindbar.");
    AddDetail(({"wendeltreppe","treppe"}),
        "Die kleine Wendeltreppe fuehrt nach oben. Von hier aus kannst "
        "Du nicht sehen, was da oben ist. Solange die Treppe abgesperrt ist, "
        "wirst Du es vermutlich auch nicht selbst herausfinden.");
    AddDetail(({"samt"}),
        "Alles ist mit rotem Samt ausgelegt... die Rezeption ist so "
        "verkleidet, die Ecken mit Samt behangen, das Gelaender der "
        "Treppe... unglaublich.");
    AddDetail(({"ecken","ecke"}),
        "Hier scheint jemand keine Ecken zu moegen - die Ecken des Lobby "
        "wurden mit Samt behangen.");
    AddDetail("gelaender",
        "Die Wendeltreppe ist so eng angelegt, da ist ein Gelaender "
        "tataechlich wichtig. Dieses hier hat sogar einen samtenen Handlauf, "
        "der die haltende Hand der nach oben Gehenden sanft umschmeichelt.");
    AddDetail("handlauf",
        "Der Handlauf des Gelaenders ist mit rotem Samt verkleidet.");
    AddDetail("hand","Du siehst eine Hand.");
    AddDetail("rezeption",
        "Die Rezeption ist rechts von Dir und reicht den Nachtelfen " 
        "bis zur Brust. Sie ist mit rotem Samt verkleidet, der Tresen "
        "selbst ist vergoldet und glaenzt im Licht des Kronleuchters. Ein "
        "magischer Schimmer geht der Rezeption aus: Hinter ihr ist der "
        "Tresor mit Wechselgeld und Jetons - da wird jemand keine Kosten "
        "gescheut haben, um ein unbotmaessiges Abhandenkommen der "
        "monetaeren Einlagen zu verhindern.");
    AddDetail("abhandenkommen",
        "Oh, das ist abhanden gekommen.");
    AddDetail("einlagen","Immerhin muss das Casino die Gewinne auszahlen "
        "koennen...");
    AddDetail(({"gewinn","gewinne"}),"Gewinne koennen "
        "beim Roulette recht hoch ausfallen.");
    AddDetail("kosten",
        "Vielleicht kommst Du hier auch auf Deine Kosten.");
    AddSpecialDetail("brust","detailBrust");
    AddDetail("schimmer","Der Schimmer ist magisch und wird verhindern, "
        "dass Rezeptionistinnen in Scharmuetzel verwickelt werden.");
    AddDetail("wechselgeld",
        "Das kannst Du von hier aus nicht einsehen.");
    AddDetail("tresor",
        "Dafuer kommst Du nicht nah genug heran.");
    AddDetail("jetons","Besorg Dir doch mal welche...");
    AddDetail("tresen","Der Tresen glaenzt und funkelt im Licht der Kerzen.");

    AddDetail("decke",
        "Die Decke ist reich an Fresken und in einem goldgelben Farbton "
        "gehalten. Von ihrer Mitte haengt ein prunkvoller Kronleuchter "
        "herab.");
    AddDetail(({"leuchter","kronleuchter","kristallkronleuchter"}),
        "Der Kronleuchter ist mit etlichen Kerzen bestueckt und viel "
        "Kristall behangen, so dass sich das Licht tausendfach bricht "
        "und die ganze Lobby erhellt.");
    AddDetail(({"kerze","kerzen"}),
        "Es sind tatsaechlich sehr viele Kerzen, immerhin ist die gesamte "
        "Lobby lichtdurchflutet.");
    AddDetail("lobby", "Du stehst in der Lobby des Casinos 'Comet'");
    AddDetail("kristall","Oh, so ein Kristallkronleuchter macht einiges her, "
        "das Ambiente hier strahlt Luxus und Pomp aus wie es fuer diese "
        "Siedlung einmalig ist.");
    AddDetail("ambiente",
        "Es irritiert Dich, aber trotz des Luxus und des Pomps fuehlst Du "
        "Dich hier nicht gaenzlich unwohl, es geht Dir eigentlich sogar "
        "recht gut.");
    AddDetail("siedlung",
        "Wenn Du die Siedlung sehen moechtest - geh wieder raus.");
    AddDetail(({"pomp","luxus"}),
        "Gold, roter Samt, alles hier riecht geradezu nach "
        "Verschwendung!");
    AddDetail("verschwendung","Wieviele Schwerter haetten geschmiedet werden "
        "koennen! Andererseits... mit Schwertern hat man vielleicht nicht "
        "so viel Spass.");
    AddDetail(({"schwert","schwerter"}),"Du siehst hier keine solchen.");
    AddDetail("spass", "Ja, um das Spass haben geht es hier.");
    AddDetail("farbton","Hier ist alles in goldgelb und rot gehalten. Selbst "
        "die Kleidung des Empfangs ist darauf abgestimmt");
    AddDetail("kleidung","Na, kuck Dir Aine doch mal an....");
    AddDetail(({"empfang","rezeptionistinnen","rezeptionistin"}),
        "Der Empfang wird fuer gewoehnlich von Aine besetzt. "
        "Sehr nett, freundlich, hilfsbereit.");
    AddDetail(({"wand","waende"}), 
        "Die Waende sind mit Fresken verziert und recht uninteressant. "
        "In der hinteren Wand ist ein Durchgang, der offenbar ein paar mal "
        "abknickt - jedenfalls dringt von dort kein Laut in die Lobby.");
    AddDetail(({"nachtelfen","nachtelf"}),
        "Erinnere Dich kurz daran, wo Du bist.");
    AddDetail("licht","Hier glaenzt und funkelt alles - fast nicht zu "
        "glauben, dass das alles nur von diesem einen Kronleuchter kommt.");
    AddDetail("durchgang","Der Durchgang wird zum Roulette-Tisch fuehren."
        " Besorge Dir ein paar Cometen und leg los!");
    AddDetail(({"tisch","roulette-tisch","roulette"}),
        "Wenn Du Dir den Roulette-Tisch ansehen moechtest, solltest Du "
        "nach hinten gehen.");
    AddDetail("cometen",
        "Uh... frag' mal Aine. Die kann da vielleicht helfen.");
    AddDetail(({"boden","teppich"}),
        "Der Boden ist vollstaendig mit rotem Teppich bedeckt, Deine "
        "Schritte erzeugen keinen Laut, es fuehlt sich an als gingest "
        "Du auf Wolken.");
    AddDetail("wolken","... woher auch immer Du zu wissen glaubst, wie "
        "sich das anfuehlt.");
    AddDetail(({"schritte","schritt"}), "Du bist eigenfuessig hier herein"
        "gekommen.");
    AddDetail("mitte",
        "In der Mitte der Decke haengt ein Leuchter, in der Mitte der Lobby "
        "stehst Du. Hoffen wir, dass der Leuchter haelt.");
    AddDetail("scharmuetzel",
        "Hier sollte es doch recht friedlich zugehen.");

    SetStupids(({"gehenden"}));

    AddSmell(DEFAULT_SMELL,"Hier ist wenig zu riechen.\n");
    AddSmell("pomp","Pomp riecht nach nichts.\n");
    AddSound(DEFAULT_SOUND,"Es ist sehr ruhig hier...\n");
    AddSound("laut","Kein Laut dringt von hinten in die Lobby.\n");

    AddExit("norden",
        ([ EX_DEST: "./spassplatz", 
           EX_PLMSG: "Du verlaesst das Casino.\n",
           EX_MSG: "aus dem Casino",
           EX_TESTFUNC: "checkJetons"]));

    AddExit("hinten",
        ([ EX_DEST: "./comet_roulette", 
           EX_PLMSG: "Du gehst nach hinten.\n",
           EX_MSG: "nach hinten zum Spielbereich"]));

    AddExit("oben",
        ([ EX_DEST: "./comet_vip", 
           EX_TESTFUNC:"checkVip",
           EX_PLMSG: "Du steigst die Treppe hoch in die VIP-Lounge.\n",
           EX_MSG: "nach oben in die VIP-Lounge"]));



    SetProp(P_HIDE_EXITS,({"oben"}));

    AddItem(DOVENYA_NPC "aine",REFRESH_DESTRUCT,1);

}

nosave int 
checkJetons(string verb)
{
    if (!this_player()) 
    {
        return 0;
    }
    if (deep_present(JETONID,this_player()))
    {
        write("Tausch' erstmal Deine Cometen in richtiges Geld, "
            "bevor Du gehst.\n");
        return 0;
    }
    return 1;
}


// Den Ausgang nach oben fuer Nicht-VIPs nicht anzeigen.

string * 
_query_hide_exits()
{
    object aine;
    if ((this_player()) && (present(VIPID,this_player()))
        &&  (aine=find_object(EMPFANG)) && (present(aine)))
    {   
        return ({});
    }
    else
    {
        return ({"oben"});
    }

}


nosave int 
checkVip(string direction)
{
    object aine;

    if ((!sizeof(_query_hide_exits())) && (aine=find_object(EMPFANG))
        && (present(aine)))
    {
        this_player()->Message(sprintf("%s entfernt "
            "die Absperrkette und laesst Dich nach oben.\n", aine->Name(WER)));
        return 1;
    }
    else
    {
        this_player()->Message("Der Zugang in die VIP-Lobby ist "
            "Dir mit einer goldenen Kette verwehrt.\n");
        return 0;
    }
}

nosave string
detailBrust()
{
    object aine;
    if(this_player() &&
        (aine=find_object(EMPFANG))&&present(aine))
    {
        this_player()->Message(break_string(sprintf(
                "Aeh, okay... alles da.\n"
                "%s sagt: He!\n%s gibt Dir eine schallende Ohrfeige.\n",
                aine->Name(WER), aine->Name(WER)),77,0,1));
        Message(break_string(sprintf(
                "%s sagt: He!\n%s gibt %s eine schallende Ohrfeige.\n",
                aine->Name(WER), aine->Name(WER),
                this_player()->name(WEM)),77,0,1),MSGFLAG_NO_TP);
    }
    return "";
}

