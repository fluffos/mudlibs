/* Ein Kraut - Roter Konkubinenfarn
 * __________________________________________(i) Anatol@Silberland (2012) */

#include <properties.h>
#include "../../defines.h"

inherit "/d/nacht/std/kraut" ;


public void
create()
{
    if (!is_clone(this_object())) return;
    ::create();
    seteuid(getuid(this_object()));
  
    AddId(({"\a\n\a\tol_kraut","\a\n\a\tol_konkubinenfarn",
          "farn","konkubinenfarn"}));

    SetProp(P_SHORT,"Roter Konkubinenfarn");

    SetProp(P_LONG,"Er sieht eigentlich ganz harmlos aus, der rote "
        "Konkubinenfarn. Warum er diesen Namen traegt, erschiesst sich "
        "auch nicht sofort. Es ist ein typischer Farn - lange duenne "
        "Blaetter - in einer sehr unttypischen Farbe: Rot. Aber es ist "
        "ein schoenes leuchtendes Rot. Und Du siehst eine sehr "
        "ordentliche Menge davon.");
  
    AddDetail(({"menge","zeugs","zeug"}),
        "Wer auch immer den Farn 'gepflueckt' hat, er hat sich nicht "
        "lumpen lassen. Das ist eine ganze Menge Farn, damit laesst "
        "sich schon etwas anfangen. (Hoffentlich waechst das Zeugs "
        "schnell nach)");

    AddDetail(({"blatt","blaetter","blattwerk"}),
        "Die Blaetter des Farns sind ausgesprochen lang und duenn. "
        "Sie machen darueber hinaus einen ueberaus stabilen Eindruck. "
        "Solange der Farn noch halbwegs frisch ist, wird man sicher "
        "etwas ... Schickes daraus basteln koennen.");

    AddDetail("rot",
        "In einer gedanklichen Exkursion in die Botanik erscheint Dir "
        "das Synthetisieren eines so kraeftigen Rottons in Blattwerk "
        "als eher unvorteilhaft; benoetigt wird schlussendlich "
        "Chlorophyll (Photosynthese... Energiegewinnung...), was fuer "
        "einen gruenen Farbton spraeche. Ein so deutliches Rot ist doch, "
        "so Deine Laienmeinung, mehr dem Fruchtstaender vorbehalten, "
        "immerhin ist die Synthese eines solchen Farbstoffs in der "
        "Energie- und Rohstoffbilanz des Gewaechses teuer - und das "
        "Blattwerk profitiert von angelockten Bestaeubern ja nun eher "
        "nicht.\n"
        "Ohje, besser keine weiteren Exkursionen.");

    AddDetail(({"synthese","synthetisieren"}),
        "Farbstoffe fallen nicht einfach so vom Himmel, sie muessen "
        "geschaffen werden. Der Vorgang ist teuer und die Notwendigkeit "
        "dafuer will sich Dir nicht erschliessen - die Natur verschwendet "
        "nichts, heisst es schliesslich.");

    AddSpecialDetail("exkursion","detailExkursion");

    AddDetail(({"energiegewinnung","bestaeuber","vorgang","chlorophyll",
        "gruen","fruchtstaender"}),
        "Davon kannst Du ausdruecklich nichts am roten Kokubinenfarn erkennen.");
        
    AddDetail(({"etwas","etwas schickes","schickes","schick","chique"}),
        "Der Farn wuerde fuer ein schickes Farn-Roeckchen sicher ausreichen."
        " Und rot waere es dann auch schon.");

    SetProp(P_INFO, "Am roten Konkubinenfarn ist nichts magisch.");

    SetProp(P_SMELL, "Wow, das haut Dich um, was fuer ein Duft! Du stehst in einer Wolke!\n");
    SetProp(P_SOUND,"Nichts zu hoeren.\n");

    SetProp(P_KILL_NAME,"Roter Konkubinenfarn");
    SetProp(P_KILL_MSG,"...?");

    SetProp(P_NAME,"Konkubinenfarn");
    SetProp(P_NAME_ADJ,"rot");
    SetProp(P_GENDER,MALE);
    SetProp(P_VALUE,10000);

    SetProp(P_WEIGHT,10); 
    SetProp(P_MATERIAL,([MAT_PLANT:100]));

    SetProp(P_KRAUT_DRYING_FACTOR,30);
    SetProp(P_KRAUT_RESETS_UNTIL_DECOMPOSE,100); 


    AddCmd(({"bastel","bastle"}),"cmdBastel");
}


public string
extra_look()
{
    string ret;
    switch ((int)environment()->QueryProp(P_GENDER))
    {
        case MALE: ret="Er";
            break;
        case FEMALE: ret="Sie";
            break;
        default:
            ret="Es";
    }
    ret+=" wird von einer Wolke aus ";
    if (isFresh()) 
        ret+="lieblichem Duft nach Wildgraesern umgeben.\n";
    else if (isDry()) 
        ret+="verfuehrerischem Duft nach Moschus umgeben.\n";
    else
        ret+="herbem Duft nach Gras und Steppe umgeben.\n";
    return ret;
}

nosave int
cmdBastel(string what)
{
    string ziel;
    string quelle;
    object ding;

    if ((!this_player()) || (environment()!=this_player())) return 0;

    notify_fail("Was willst Du aus was basteln?\n");
    if (!what || (!stringp(what)) || (!strlen(what)))
        return 0;
    if (sscanf(what,"%s aus %s",ziel, quelle)!=2)
        return 0;

    notify_fail("Das kannst Du zum Basteln nun gerade nicht verwenden.\n");
    if (!id(quelle)) 
        return 0;

    notify_fail("Das wird nicht klappen, versuch was anderes.\n");
    if ((ziel!="farn-roeckchen") && (ziel!="roeckchen") && (ziel!="rock"))
        return 0;

    notify_fail("Dafuer ist der Konkubinenfarn nicht mehr frisch genug.\n");
    if (!isFresh()) 
        return 0;

    if (catch(ding=clone_object(DOVENYA "a/farnroeckchen"))) 
    {
        // Bug.
        write("Das war ein guter Versuch, leider hat es nicht geklappt.\n");
    }
    else
    {
        this_player()->Message(break_string(
            "Mit viel handwerklichem Geschick (und ein "
            "paar weniger ruehmlichen Fehlversuchen) bastelst Du aus dem "
            "roten Konkubinenfarn ein ebenso rotes Farn-Roeckchen. "
            "Kritisch bewunderst Du Deine Arbeit und kommst zum Schluss: "
            "Ja wie suess!",77));
        if ((int)(this_player()->QueryProp(P_GENDER)) == MALE)
            this_player()->Message(break_string(
                "Jetzt braucht's ja noch wen, der das "
                "anziehen kann.\nDIR steht das naemlich nicht.",77,0,1));

        environment(environment())->Message(
            break_string(sprintf(
                "Sorgfaeltig packt %s ein grosses Buendel roten "
                "Konkubinenfarn aus und beginnt, daraus etwas zu flechten. "
                "%s muss mehrmals neu ansetzen, Farn ist kein sehr dankbarer "
                "Rohstoff, doch am Ende mustert %s voller Bewunderung %s "
                "Arbeitsprodukt: Ein Farn-Roeckchen. In rot. Wie... schick.",
            (string)this_player()->name(WER), 
            capitalize((string)this_player()->QueryPronoun(WER)),
            (string)this_player()->name(WER),
            (string)this_player()->QueryPossPronoun(NEUTER,WER,SINGULAR)
            ),77),
            MSGFLAG_VISUAL,
            ([MSGFLAG_EXCLUDE:({this_player()})]));
        ding->Bastler(this_player());
        ding->move(environment(environment()),M_NOCHECK);
        if ((ding->move(environment()))<0)
            write("(Du laesst Dein Arbeitsprodukt zunaechst vor Dir liegen.)\n");
        remove();
    }
  return 1;
}


nosave string
detailExkursion()
{
    if (!this_player()) 
        return 0;
    write(break_string(
        "(Es erfolgt eine willkuerlich angesetzte disziplinarische Massnahme "
        "fuer das Untersuchen eines offenkundig nicht untersuchenswuerdigen "
        "Details. Es ergeht aus rechtlichen Gruenden der Hinweis, dass diese "
        "Massnahme toedlich enden kann.)",77,"      ",1));
    this_player()->do_damage(5+random(5));
    return "Aua!\n";
}
