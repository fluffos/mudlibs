/* Ein Kraut - Purpursaftschluckse
 * __________________________________________(i) Anatol@Silberland (2012) */

#include <properties.h>
#include "../../defines.h"

inherit "/d/nacht/std/kraut" ;



public void
create()
{
    if (!is_clone(this_object())) return;
    ::create();
    seteuid(getuid(this_object()));
  
    AddId(({"\a\n\a\tol_kraut","\a\n\a\tol_purpursaftschluckse",
          "schluckse","ppss","purpursaftschluckse"}));

    SetProp(P_SHORT,"Eine Purpursaftschluckse");

    SetProp(P_LONG,"Die Purpursaftschluckse ist in Fachkreisen als "
        "der einzige Vertreter der asynchronen Nimmerblueher bekannt. "
        "Kein Lebender hat die Purpursaftschluckse je bluehen sehen, doch "
        "werden regelmaessig verdorrte Fruchtstaender gefunden. Das "
        "Gewaechs besteht aus einem dicken purpurfarbenen Staengel, von "
        "welchem viele duenne Seitentriebe abgehen. Die Oberflaeche scheint "
        "versiegelt, jedenfalls haelt die etwa 20 cm hohe Pflanzenstruktur "
        "Fluessigkeit sehr lang - solange man sie nicht pflueckt.");
 
    SetProp(P_INFO, "Von der Purpursaftschluckse weiss man eigentlich fast "
        "nichts. Eines sagt Dir die Magie aber: Das Ding ist hochgiftig. "
        "Werde es besser rasch wieder los.");

    AddDetail("nimmerblueher",
        "Nimmerblueher bluehen wohl nimmer.");
    AddDetail("fruchtstaender",
        "Mh, diese Purpursaftschluckse hat keinen Fruchtstaender, auch "
        "keinen verdorrten.");
    AddDetail(({"staengel","stengel"}),
        "Der Staengel der Purpursaftschluckse ist, quasi, die "
        "Purpursaftschluckse. Er ist etwa elfenfingerdick und "
        "verjuengt sich nach oben hin nicht, sondern endet mit einem "
        "glatten runden Stumpf. Und natuerlich, der Staengel ist von "
        "einem richtig satten leuchtenden Purpur.");
    AddDetail(({"stumpf","ende"}),
        "Am oberen Ende der Purpursaftschluckse ist nichts spitz.");
    AddDetail(({"triebe","seitentriebe","trieb","triebbewuchs","seitentrieb"}),
        "Die Seitentriebe der Purpursaftschluckse sind sehr duenn, dafuer "
        "aber sehr zahlreich. Sie sind etwa eine elfenhandbreit lang, "
        "so dass der Staengel nur ganz unten zu greifen ist - wo etwa "
        "ein fingerbreit ohne Triebbewuchs auskommt. Die Triebe scheinen "
        "keine durchlaessige Oberflaeche zu besitzen. Unwahrscheinlich also, "
        "dass die Pflanze hier Fluessigkeit verlieren wuerde.");
    AddDetail(({"fluessigkeit","wasser"}),
        "Wer auch immer eine Purpursaftschluckse pflueckt, sollte wissen, "
        "dass sie kraeftig im Saft steht ... und der durch den Bruch "
        "abfliesst und die Pflanze rasch austrocknet. Ansonsten aber haette "
        "eine Purpursaftschluckse selbst bei staerkster Sonneneinstrahlung "
        "keinen Fluessigkeitsverlust zu befuerchten.");
    AddDetail("bruch",
        "Irgendwer hat diese Purpursaftschluckse gepflueckt.");
    AddDetail("oberflaeche",
        "Die Oberflaeche der Seitentriebe und des Staengels scheint "
        "wachsartig versiegelt.");

    AddDetail("purpur",
        "Was fuer ein kraeftiges Purpur!");

    SetProp(P_SMELL, "Die Saftschluckse riecht nach gar nichts.\n");
    SetProp(P_SOUND,"Nichts zu hoeren.\n");

    SetProp(P_NAME,"Purpursaftschluckse");
    SetProp(P_GENDER,FEMALE);
    SetProp(P_VALUE,0);

    SetProp(P_WEIGHT,10); 
    SetProp(P_MATERIAL,([MAT_PLANT:100]));

    SetProp(P_KRAUT_DRYING_FACTOR,1);
    SetProp(P_KRAUT_RESETS_UNTIL_DECOMPOSE,0); 
}


public int 
remove() 
{
   if (!this_player())
   {
       if ((environment()) && living(environment()) &&
          interactive(environment()))
       {
          tell_object(environment(),break_string(
             "Uh... das ist ist jetzt aber gar nicht gut. Die "
             "giftigen Ueberreste broeseln durch Deine Kleidung und dort, "
             "wo das Zeugs Deine Haut beruehrt, setzt sofort ein heftiges "
             "Brennen ein. Hoffentlich kennst Du Dich mit Giften aus.",77));
          environment()->AddPoison(5+random(5));
       }
   }
   ::remove();
}


public void
init()
{
    ::init();
    if (this_player() && (query_verb()) && 
        ((query_verb()=="pflueck") || (query_verb()=="pfluecke")) &&
        (environment()==this_player()))
    {
        if (!sizeof(filter_array((object *)(this_player()->QueryProp(P_ARMOURS)),
                           lambda(({'x}),({ #'== , AT_GLOVE, ({ #'call_other, 'x,
        "QueryProp", P_ARMOUR_TYPE })})))))
        {
            tell_object(environment(),break_string(
               "AaaaAAAH, das brennt! Wie unvorsichtig... Purpursaftschlucksen pflueckt "
               "man besser nicht mit blossen Haenden, der auslaufende Saft brennt "
               "wie Saeure.",77));
            this_player()->do_damage(10+random(10));
            this_player()->AddPoison(1+random(2));
        }

    }

}


// don't give away things that may kill on reset();

varargs public int 
move(mixed dest, int method)
{
    if (method==M_GIVE)
        return ME_CANT_LEAVE_ENV;
    else
        return (int)::move(dest,method);

}

