/* Das Schlechte Gewissen des Zwindchenpflueckers
 * _____________________________________(i) Anatol@Silberland (1998-2012) */

#pragma strict_types
#include <properties.h>
#include "../../defines.h"

inherit "/std/thing";

public void 
create() {
    if (!is_clone(this_object())) return 0;
    ::create();

    SetProp(P_SHORT,0);
    SetProp(P_LONG,0);
    SetProp(P_INVIS,0);
    SetProp(P_NAME,"Gewissen");
    SetProp(P_GENDER,NEUTER);
    SetProp(P_WEIGHT,0);
    SetProp(P_NAME_ADJ,"schlecht");
    SetProp(P_NODROP,1);
    SetProp(P_NEVERDROP,1);
    AddAdjective("schlecht");
    AddId(({"\a\n\a\tol_gewissen"}));
    call_out("CA_Gewissen",60,0);
}

nosave void
ponder(string what)
{
    if (!living(environment()))
        remove();
    else
        environment()->Message(break_string("("+what+")",77));
}

nosave void
CA_Gewissen(int seq) 
{
    ponder( ({
        "Wieso hast Du unbedingt das Wiesenzwindchen pfluecken muessen...?",
        "Du haettest das Zwindchen stehen lassen sollen...",
        "Das arme Wiesenzwindchen... es wird jetzt vertrocknen.",
        "Du weisst nicht, was Du mit dem Wiesenzwindchen anstellen solltest.",
        "Verflixt, wieso nur musstest Du das Wiesenzwindchen pfluecken!?",
        "Es war bestimmt keine gute Idee, das Wiesenzwindchen zu pfluecken.",
        "Ein Wiesenzwindchen ist auch ein Lebewesen. Und es stirbt jetzt "
                    "so sinnlos..."
    })[random(7)]);
    if ((seq)<6)
    {
        call_out("CA_Gewissen",120,seq+1);
    }
    else 
        remove();
}
