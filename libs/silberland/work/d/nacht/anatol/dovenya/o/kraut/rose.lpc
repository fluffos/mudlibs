/* Ein Kraut - Naja, nein, eine Nachtsturmrose
 * _____________________________________(i) Anatol@Silberland (1998-2012) */

#pragma strict_types
#include <properties.h>
#include "../../defines.h"

inherit "/d/nacht/std/kraut" ;

public void 
create() {

    if (!is_clone(this_object())) 
        return 0;
    ::create();

    SetProp(P_SHORT,"Eine wunderschoene Bluete der Nachtsturmrose");
    SetProp(P_LONG,
      "Die Bluete der Nachtsturmrose ist vollkommen transparent, nur "
      "unter dem Sternenlicht der Insel glitzert und funkelt sie, so dass "
      "Du sie nur dort ueberhaupt erkennen kannst.");

    SetProp(P_SMELL,"Die Rose riecht ... magisch?\n");
    SetProp(P_SOUND,"Nichts zu hoeren.\n");

    AddDetail("sternenlicht",
        "Unbeschreiblich, wie sich das Sternenlicht in den Bluetenblaettern "
        "bricht. Der Vergleich mit einem geschliffenen Diamanten draengt sich "
        "auf, doch selbst dieser wird dem Funkeln der Rose nicht gerecht.");
    AddDetail(({"blaetter","bluetenblaetter"}),
        "Du kannst die Bluetenblaetter nicht sehen, aber das Licht, das "
        "bricht sich in ihnen...");
    AddDetail("diamant","Ein Diamant wuerde blass und fahl neben dieser "
        "Bluete der Nachtsturmrose wirken.");
    AddDetail("funkeln","Du bist wie verzaubert.");

    SetProp(P_NAME,"Bluete einer Nachtsturmrose");
    SetProp(P_GENDER,FEMALE);

    AddId(({"rose","bluete", "nachtsturmrose","\a\n\a\tol_nachtsturmrose"}));

    SetProp(P_INFO,
      "Die Nachsturmrose ist nicht magisch\n");

    SetProp(P_WEIGHT,0);
    SetProp(P_KRAUT_DRYING_FACTOR,-1);
    SetProp(P_KRAUT_RESETS_UNTIL_DECOMPOSE,-1); 

}


public void
reset()
{
    ::reset();
    if ((is_clone(this_object())) 
            && ((environment()))
            && (!living(environment())))
        remove();
}

public int 
_query_invis()
{
    return (environment() && living(environment()) &&
        (environment(environment())) &&
        (file_name(environment(environment()))[0..8] != "/d/nacht/"));
}

public string 
short()
{
    if (_query_invis())
        return 0;
    else
        return ::short();
}


public int 
id(string s, int lvl)
{
    if (_query_invis()) 
        return 0;
    else 
        return ::id(s,lvl);
}


// Information bereits im Spiel - Rathaus in Midas.

public mixed 
_query_info()
{
    object * o;
    string * s;
    o=filter_array(users(),lambda(({'x }),
        ({ #'&& , 
            ({ #'! , ({ #'call_other , 'x , "QueryProp", P_INVIS })}),
            ({ #'> , ({ #'member , 
                        ({ #'?, ({ #'pointerp , 
                            ({ #'call_other , 'x , "QueryProp", P_WAITFOR })}),
                        ({ #'call_other , 'x , "QueryProp", P_WAITFOR }), 
                        '({}) }), 
                        ({ #'capitalize ,({ #'getuid , 'x })})}), 
                    -1 })})));
    if (!sizeof(o))
        return "Die Rose ist vermutlich magisch.\n";
    else if (sizeof(o)==1)
        return "Dir wird gewahr, dass "+capitalize(getuid(o[0]))+" dich "
            "'erwartet'.\n";
    else
    {
        s=map_array(o,lambda(({ 'x }),({ #'capitalize, ({ #'getuid, 'x })})));
        return break_string("Dir wird gewahr, dass "+
        implode(s[0..<2],", ")+" und "+s[<1]+" Dich 'erwarten'.",77);
    }
}

