#pragma strict_types
#include "../defines.h"
#include <properties.h>
#include DOVENYA "sys/comet.h"

nosave int vip;

inherit "/std/thing";

varargs public void 
create() 
{ 
    if (!is_clone(this_object())) 
        return; 
    ::create();

    AddId(({"vip-ausweis",
            "vip","jeton","vip-jeton","\a\n\a\tol_vip_jeton",VIPID}));

    SetProp(P_LONG,
        "Ein VIP-Ausweis. Du solltest diesen Text niemals lesen.");
    SetProp(P_SHORT,"Ein VIP-Ausweis");
    SetProp(P_WEIGHT,0); 
    SetProp(P_NODROP,SetProp(P_NEVERDROP,1));
    SetProp(P_NAME,"Jeton");
    SetProp(P_GENDER,MALE);
    SetProp(P_VALUE,0);
    SetProp(P_MATERIAL, ([ MAT_GOLD:15,
                           MAT_MAGIC:30,
                           MAT_SNOW:1,
                           MAT_PEARL:4,
                           MAT_PLUTONIUM:1,
                           MAT_ELM_WOOD:2,
                           MAT_IRIDIUM:2,
                           MAT_OCTARINE:15,
                           MAT_IVORY:15,
                           MAT_BLOOD:5,
                           MAT_INK:10 ]) );

    reset();
    AddCmd(({"prahle","prahl"}),"cmdPrahle");
    AddCmd(({"vip"}),"cmdVip");
}



// ToDo: VIP-Check. Upgrades und so.

varargs void
reset()
{
    ::reset();
}


public int
QueryVip()
{
    return (environment()?(int)IS_VIP(environment()):0);
}


public string *
_query_adjectives()
{
    return ({  
        ({ "unscheinbar","gruen","silber",
            "golden","platin","oktarin" })[QueryVip()]
        });
}

public string * 
_query_name_adj()
{
    return _query_adjectives();
}

public string
short()
{
    if ((!this_player())
        || (!environment())
        || (!query_once_interactive(environment())) )
    {
        return "Ein unscheinbarer Jeton.";
    }
    return sprintf("%s des Casino 'Comet'",Name(WER,0));
}


public string 
long()
{
    if ((!this_player())
        || (!environment())
        || (!query_once_interactive(environment())) )
    {
        return "Ein unscheinbarer Jeton.\n";
    }
    return break_string(sprintf(
        "%s ist ein im Design eines '1 Comete'-Jetons gehaltenes edles "
        "Kleinod. Es erlaubt Dir den Zutritt in die VIP-Lounge des Casinos "
        "'Comet' in Dovenya ... und auch ein wenig Prahlerei.\n",
        Name(WER,1)),77);

}

nosave int
cmdPrahle(string ehrwhat)
{
    string was;
    if (!this_player() || (!stringp(ehrwhat)) || (!ehrwhat))
    {
        notify_fail("Mit was willst Du prahlen?\n");
        return 0;
    }
    else if ((sscanf(ehrwhat,"mit %s",was)!=1)||
            (!id(was)))
    {
        notify_fail("Damit kannst Du (so) nicht prahlen.\n");
        return 0;
    }
    environment(this_player())->Message(break_string(sprintf(
        "%s verlagert das Gewicht auf %s rechtes Bein, laesst die Arme "
        "laessig haengen und reckt das Kinn und schaut extrem entspannt.\n",
            this_player()->Name(WER),
            this_player()->QueryPossPronoun(NEUTER, WEN,SINGULAR)
            ),77,0,1)+
        break_string(sprintf(
            "Ach weisst Du, .... VIP im Casino 'Comet' ... war eigentlich "
            "ein Klacks. Ich hab %s schon Ewigkeiten.",
                name(WEN,1)),77,this_player()->Name(WER)+" sagt: ",0)+
        break_string(sprintf(
            "%s gibt ein leicht abfaelliges Schnauben von sich.\n",
                this_player()->Name(WER)),77),MSGFLAG_NO_TP);
    this_player()->Message(sprintf("Du prahlst laessig mit %s.\n",
        name(WEM,1)));
    return 1;
}

nosave int
cmdVip(string what)
{
    string uuid;

    if (   (!environment()) 
        || (!this_player()) 
        || (this_player()!=environment()) 
        || (IS_VIP(environment())<VIP_PLATINUM)
        || (!IS_LEARNER(this_player())))
    {
        return 0;
    }

    if (stringp(what) && (sizeof(explode(what," "))>1))
    {
        uuid=implode(explode(what," ")[1..]," ");
        what=explode(what, " ")[0];
        if (find_player(uuid))
        {
            uuid=getuuid(find_player(uuid));
        }
        else if (find_netdead(uuid))
        {
            uuid=getuuid(find_netdead(uuid));
        }
        else if (find_living(uuid))
        {
            uuid=file_name(find_living(uuid));
        }
    }
    else
    {
        uuid=getuuid(this_player());
    }

    switch (what)
    {
        case "s":
        case "stats":
            printf(((string)call_other(DOVENYA_ROOM "comet_roulette",
                "PlayerStats",uuid)||"Keine Daten vorhanden.\n"));
            break;
        case "1":
            printf((string)call_other(DOVENYA_ROOM "comet_roulette", 
                "Toplist",0));
            break;
        case "2":
            printf((string)call_other(DOVENYA_ROOM "comet_roulette", 
                "Toplist",1));
            break;
        case "r":
        case "rating":
            printf("Gesamt-Rating fuer VIP: %d\n",(int)
                call_other(DOVENYA_ROOM "comet_roulette",
                "RecalcVip",uuid,1));
            break;
        default:
            printf(
                "... stats      - Spielerstatistik.\n"
                "... rating     - Rating\n"
                "... 1/2        - Topliste 1/2\n");
            break;
    }
    return 1;
}
