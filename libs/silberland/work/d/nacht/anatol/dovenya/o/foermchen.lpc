/* Foermchen. Unspektakulaerst.
 * __________________________________________(i) Anatol@Silberland (2012) */

#pragma strict_types
#include <properties.h>

inherit "/std/thing";
varargs public void 
create() 
{ 
    if (!is_clone(this_object())) 
        return; 
    ::create();

    AddId(({"foermchen","\a\n\a\tol_foermchen"}));
    SetProp(P_LONG,SetProp(P_SHORT,"Ein Foermchen")+". Spiel damit.");
    SetProp(P_WEIGHT,SetProp(P_NODROP,SetProp(P_NEVERDROP,1)));
    SetProp(P_NAME,"Foermchen");SetProp(P_GENDER,NEUTER);
    AddCmd(({"spiel","spiele"}),"cS");
}

nosave int cS(string s) 
{ 
    string d;
    if ((!this_player())||(environment()!=this_player())||(!s)
            ||(sscanf(s,"mit %s",d)!=1)||(!id(d))) 
        return 0;

    this_player()->Message("Du spielst ein wenig mit DEINEM Foermchen.\n");
    environment(this_player())->Message(break_string(
        this_player()->Name(WER)+" spielt ein wenig mit "+
        upperstring(this_player()->QueryPossPronoun(NEUTER,WEM,SINGULAR))+
        " Foermchen.\nSuch' Dir selbst eins!\n",77,0,1),
            MSGFLAG_VISUAL|MSGFLAG_NO_TP);
    return 1; 
}
