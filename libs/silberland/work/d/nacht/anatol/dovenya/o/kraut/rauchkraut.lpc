/* Ein Kraut - Das Rauchkraut
 * _____________________________________(i) Anatol@Silberland (1998-2012) */
/* Ein Rauchkrautblatt - hat absolut nichts besonderes, kann aber fuer
 * diverse Heiler als Zutat verwendet werden. Loest sich nach 3 Resets auf.
 */

#pragma strict_types

#include <properties.h>
#include "../../defines.h"

inherit "/d/nacht/std/kraut";


public void 
create() 
{
    if (!is_clone(this_object())) 
        return;
  ::create();
  

    SetProp(P_SHORT,"Das Blatt eines Rauchkrautbusches");
    SetProp(P_LONG,
        "Das ist das Blatt eines Rauchkrautbusches, was leicht an dem saeuerlich"
        "-herben Duft zu erkennen ist, den es verstroemt. Es schimmert leicht "
        "roetlich, was ein relativ sicheres Zeichen dafuer ist, dass es in "
        "erntereifem Zustand gepflueckt wurde.");
    SetProp(P_SMELL,"Der Duft des Rauchkrauts erinnert Dich an Wald und Wiesen, "
        "ist\njedoch eher herb und sauer statt suesslich.\n");
    SetProp(P_SOUND,"Das Rauchkrautblatt schweigt Dich an.\n"); 
    SetProp(P_NAME,"Rauchkrautblatt");
    SetProp(P_GENDER,NEUTER);
    AddId(({"blatt","krautblatt","rauchkrautblatt","\a\n\a\tol_rauchkrautblatt"}));

    SetProp(P_INFO,  
        "Roh ungeniessbar, koennen die fachkundigen Haende eines "
        "Heilers\noder Zauberers aus Rauchkraut bestimmt nuetzliche Traenke "
        "brauen...\n");

    SetProp(P_WEIGHT,100);
    SetProp(P_VALUE,10);
    SetProp(P_NOBUY,1);
    SetProp(P_MATERIAL,MAT_MISC_PLANT);
    SetProp(P_KRAUT_DRYING_FACTOR,15);
    SetProp(P_KRAUT_RESETS_UNTIL_DECOMPOSE,3);
}

