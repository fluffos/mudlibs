/* Ein Kraut - Das Bleichblatt
 * __________________________________________(i) Anatol@Silberland (2012) */

#pragma strict_types

#include <properties.h>
#include "../../defines.h"

inherit "/d/nacht/std/kraut" ;



public void
create()
{
    if (!is_clone(this_object())) 
        return;
    ::create();
  
    AddId(({"\a\n\a\tol_kraut","\a\n\a\tol_bleichblatt",
         "bleichblatt","bleiblatt"}));
    AddAdjective(({"blassgruengrau"}));

    SetProp(P_SHORT,"Ein Bund Bleichblatt");

    SetProp(P_LONG,"Das 'ch' in 'Bleichblatt' wurde im Laufe der letzten "
        "Jahrzehnte in den Namen gefuegt, urspruenglich hiess dieses Gewaechs "
        "ganz bestimmt anders. "
        "Und es ist unschwer erkennbar, warum: Das Aussehen ist "
        "zwar recht unspektakulaer blassgraugruen und bluetenlos, jedoch "
        "ist der Schwermetallgehalt offenkundig: Mit zwei ordentlichen "
        "Buendeln dieses Krauts liesse sich Hanteltraining treiben.");

    SetProp(P_INFO, "Zur Wuerze oder Zubereitung taugt das Gewaechs nicht. "
        "Aber professionell (d.h.: Du kannst das sicher nicht) zu einer "
        "Paste verarbeitet und dick aufgetragen bietet es "
        "wahrscheinlich Schutz gegen allerlei unsichtbaren Unbill.");


    AddDetail(({"aussehen"}),
        "Das Bleichblatt an sich ist eher unscheinbar und ueberhaupt nicht "
        "ansehnlich. Das Gewaechs blueht nicht und die grossen, "
        "blassblaugruenen Blaetter weisen keine Struktur auf.");
    AddDetail(({"blatt","blaetter"}),
        "Die Blaetter des Bleichblatts sind sehr gross und nach aussen breiter "
        "werdend. Sie schliessen mit einer Rundung ab. Die Blaetter haengen "
        "aufgrund ihres Gewichts grundsaetzlich nach unten.");
    AddDetail(({"rundung","rundungen"}),
        "Die grossen Blaetter des Bleichblatts sind grosszuegig abgerundet.");
    AddDetail(({"gewicht"}),
        "Tja, das isses dann wohl. Dieses Kraus ist schwer, wirklich SCHWER. "
        "Irgendwie muss der Schoepfer dieser Pflanze mit auf den Weg gegeben "
        "haben, Schwermetalle aus dem Boden aufzunehmen und einzulagern.");
    AddDetail(({"schwermetallgehalt","schwermetall",
             "metall","metalle","schwermetalle"}),
        "Du siehst keine Schwermetalle, aber das Gewicht des Bleichblatts "
        "laesst einiges erahnen.");

    SetProp(P_SMELL,
       "Das Bleichblatt verstroehmt einen suesslich-schweren Duft.\n");
    SetProp(P_SOUND,"Nichts zu hoeren.\n");

    SetProp(P_NAME,"Bund Bleichblatt");
    SetProp(P_GENDER,MALE);
    SetProp(P_VALUE,100);

    SetProp(P_WEIGHT,2000); 
    SetProp(P_MATERIAL,([MAT_PLANT:20,MAT_LEAD:80]));

    SetProp(P_KRAUT_DRYING_FACTOR,10);
    SetProp(P_KRAUT_RESETS_UNTIL_DECOMPOSE,1000); 
}

