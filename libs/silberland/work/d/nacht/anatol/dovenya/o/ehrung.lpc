/* Ehrung. Trashloot.
 * __________________________________________(i) Anatol@Silberland (2012) */

#pragma strict_types
#include <properties.h>

inherit "/std/thing";
varargs public void 
create() 
{ 
    if (!is_clone(this_object())) 
        return; 
    ::create();

    AddId(({"ehrung","\a\n\a\tol_ehrung"}));
    SetProp(P_LONG,
        "Eine Ehrung, erhalten fuer das naehere Betrachten nur assoziativ "
        "verknuepfter Detailketten. Sie ist haesslich, glaenzt nicht, kann "
        "nix. Irgendwie weiss man Forschervermoegen nicht hinreichend zu "
        "wuerdigen.");
    AddDetail("detailketten",
        "Na Du weisst schon, wenn man vom einen zum anderen kommt und gar "
        "nicht weiss, was man noch alles genauer anschauen soll.");
    AddSpecialDetail("betrachten","detailBetrachten");
    AddDetail("forschervermoegen",
        "Nicht hinreichend gewuerdigt. Spassigerweise ist dieses "
        "pseudo-immaterielle Dings immerhin ein paar Muenzen wert.");
    AddDetail(({"dings","ehrung"}),
        "Ein sehr seltsames Dings, diese Ehrung.");

    SetProp(P_SHORT,"Eine unnuetze Ehrung");
    SetProp(P_WEIGHT,0); // nocheck-Move.
    SetProp(P_NODROP,SetProp(P_NEVERDROP,1));
    SetProp(P_NAME,"Ehrung");
    SetProp(P_GENDER,FEMALE);
    SetProp(P_VALUE,300+random(200));
    SetProp(P_MATERIAL,MAT_MAGIC);
}

nosave string
detailBetrachten()
{
    if (!this_player()) 
        return "";
    call_out("remove",0);
    return break_string("Fuer das Untersuchen eines substantivierten Verbs "
        "wird Dir diese - ohnehin zweifelhafte - Ehrung umgehend wieder "
        "aberkannt.",77);
}
