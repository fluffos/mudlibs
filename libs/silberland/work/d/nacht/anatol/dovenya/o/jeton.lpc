#pragma strict_types
#include "../defines.h"
#include "../sys/comet.h"
#include <properties.h>
#include <unit.h>

inherit "/std/unit";

varargs public void 
create() 
{ 
    if (!is_clone(this_object()))
    {
        return;
    }
    ::create();
    SetProp(P_NAME,({"Comete","Cometen"}));
    SetProp(P_SHORT,"Cometen");
    SetProp(P_LONG,"Die Jetons glitzern und funkeln in allen Farben, aber "
        "vornehmlich in Gold. Sie sind als 'Cometen' Waehrung - und im "
        "Casino 'Comet' "
        "sprichwoertlich ihr Geld wert. Es ist entsprechend im Interesse der "
        "Betreiber, diese Kleinodien faelschungssicher zu gestalten. Und "
        "sehr, sehr leicht.");
    SetProp(P_INFO,break_string(
        "Diese Jetons sind ausschliesslich fuer den geldwerten "
        "Gebrauch im Casino 'Comet' in Dovenya bestimmt. Das Mitfuehren der "
        "Jetons ausserhalb der Casino-Mauern kann zur Konfiszierung oder zum "
        "magischen Zerfall derselben fuehren.",77));
    SetProp(P_MATERIAL, ([ MAT_GOLD:15,
                           MAT_MAGIC:30,
                           MAT_SNOW:1,
                           MAT_PEARL:4,
                           MAT_PLUTONIUM:1,
                           MAT_ELM_WOOD:2,
                           MAT_IRIDIUM:2,
                           MAT_OCTARINE:15,
                           MAT_IVORY:15,
                           MAT_BLOOD:5,
                           MAT_INK:10 ]) );
    AddId(({"\a\n\a\tol_jeton",JETONID}));
    AddSingularId(({"jeton","comete"}));
    AddPluralId(({"jetons","cometen"}));
    SetProp(P_GENDER,FEMALE);
    SetCoinsPerUnits(10);
    SetProp(P_NEVERDROP,1);
    SetProp(P_NOSELL,1);
    SetProp(P_NODROP,1); 
    // Ein guter Grund, niemanden mit Jetons aus dem Casino zu lassen.
    SetGramsPerUnits(1,0); 
}


public string long()
{
    int * stueckelung;
    string * jetons;
    int z;
    int i;
    string result;

    stueckelung=({1000000000,100000000,20000000,1111111,500000,
            100000,50000,10000,5000,1000,50,1});

    z=QueryProp(P_AMOUNT);
    jetons=({});

    for (i=0;i<sizeof(stueckelung);i++)
    {
        if (z/stueckelung[i])
        {
            jetons+=({sprintf("%d Jeton%s zu %d Comete%s",
                z/stueckelung[i],(z/stueckelung[i]>1?"s":""),
                stueckelung[i],(stueckelung[i]>1?"n":""))});
            z=z%stueckelung[i];
        }
    }
    return break_string(
        "Die Jetons glitzern und funkeln in allen Farben, aber "
        "vornehmlich in Gold. Sie sind als 'Cometen' Waehrung - und im "
        "Casino 'Comet' sprichwoertlich ihr Geld wert. Es ist entsprechend "
        "im Interesse der Betreiber, diese Kleinodien faelschungssicher zu "
        "gestalten. Und sehr, sehr leicht. Und ortsgebunden.\n"
        "Du siehst "+(sizeof(jetons)>1
            ?implode(jetons[0..<2],", ")+" und " + jetons[<1]
            :jetons[0])+".",77,0,1);
}

public void 
reset()
{
    ::reset();
    if (!is_clone(this_object()))
    {
        return;
    }
    if ( 
          (!environment())
       || ((!living(environment())) &&
          (file_name(environment())[0..30]!=DOVENYA_ROOM "comet"))
       || ((environment(environment())) &&
          (file_name(environment(environment()))[0..30]!=DOVENYA_ROOM "comet"))
       )
    {
        environment()->Message(break_string(
            "Ein Stapel Jetons im Gegenwert von "+
            to_string((int)QueryProp(P_AMOUNT))+" Cometen zerfaellt zu "
            "Staub und verweht in einer magischen Brise.\n",77));
        remove();
    }
    return;
}
