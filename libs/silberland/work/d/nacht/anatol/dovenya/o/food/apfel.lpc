/* Zwrbelaeepfelchen. 
 * _____________________________________(i) Anatol@Silberland (1998-2012) */
/* 
 * - heilt 1-3 Lebenspunkte, saettigt 2.
 * - loest sich im Reset() auf
 * - frei (aber nicht unbegrenzt) erhaeltlich
 */

#pragma strict_types

#include "../../defines.h"
#include <properties.h>
#include <moving.h>
#include <food.h>

inherit "/std/food";

public void 
create() 
{
    if (!is_clone(this_object())) return 0;
    ::create();

    SetProp(P_SHORT,"Ein Zwirbelaepfelchen");
    SetProp(P_LONG,
        "Das ist ein schnuckeliges kleines Zwirbelaepfelchen, dass Dich "
        "rot-pausbaeckig anlaechelt und ueberhaupt lecker aussieht.");
    SetProp(P_SMELL,"Hmmmmmmjammm! Welch' suesslich, verlockender Duft, "
        "am liebsten\nwuerdest Du das kleine Zwirbelaepfelchen gleich "
        "aufessen (Tu's doch!)...\n");
    SetProp(P_SOUND,"Du glaubst, ein 'Iss mich!' zu hoeren.\n"); 
    SetProp(P_NAME,"Zwirbelaepfelchen");
    SetProp(P_GENDER,NEUTER);
    SetProp(P_FOOD_INFO,
        ([ F_HEAL:({random(3)+1,0}),         /* Heilung 1-3 LPs */
            F_SOAK: 2,
            F_DRINK: 0,
            F_ALCOHOL: 0,
            F_POISON: 0,
            F_MSG:
      "Du verspeist genuesslich ein kleines Zwirbelaepfelchen. Die himmlisch\n"
      "schwere Suesse des kleinen Apfels raubt Dir fast die Sinne und Du \n"
      "schliesst fuer einen kurzen Moment die Augen, einfach nur geniessend..."
      "\n",
            F_MSG_ROOM:
           "verspeist mit grossem Genuss ein kleines Zwirbelaepfelchen.\n",
            F_VERB:"essen"]));

    AddId(({"apfel","aepfelchen","zwirbelapfel","zwirbelaepfelchen",
            "\a\n\a\tol_zwirbelaepfelchen"}));

    SetProp(P_INFO,
        "Manche Leute koennen den leckeren Zwirbelaepfelchen mehr als nur\n"
        "Schmackhaftigkeit abgewinnen....\n");

    SetProp(P_WEIGHT,100);
    SetProp(P_VALUE,10);
    SetProp(P_NOBUY,1);
    SetProp(P_MATERIAL,MAT_MISC_PLANT);
}

public void 
reset() 
{
    ::reset();
    if ((is_clone(this_object())) && (environment()))
    {
        environment()->Message(
            "Ups, da hat sich glatt ein Zwirbelaepfelchen aufgeloest...\n");
        remove();
    }
    return;
}

