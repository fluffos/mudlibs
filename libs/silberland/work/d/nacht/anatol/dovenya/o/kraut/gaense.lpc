/* Ein Kraut - Naja, nein, ein Gaensebluemchen
 * _____________________________________(i) Anatol@Silberland (1998-2012) */

#pragma strict_types
#include <properties.h>
#include "../../defines.h"

inherit "/d/nacht/std/kraut" ;

public void 
create() {
    if (!is_clone(this_object())) return 0;
    ::create();

    SetProp(P_SHORT,"Ein Gaensebluemchen");
    SetProp(P_LONG,
      "Ah, das ist ein huebsches kleines Gaensebluemchen der Nacht, wohl "
      "aus den Gaerten Dovenyas. Die kleinen Bluetenblaetter schimmern "
      "silbrig, das unwirkliche Glitzern, das ueber sie zu huschen scheint, "
      "erinnert Dich an das sternenuebersaete Firmament ueber Dovenya.");
    AddDetail(({"blaetter","bluetenblaetter"}),
      "Der silberne Glanz, das unwirkliche Glitzern auf den Bluetenblaettern "
      "bedeutet wohl, dass dieses Gaensebluemchen mehr ist als nur ein "
      "normales kleines Gaensebluemchen.");
    AddDetail("glanz","Irgendwie liegt ein silbernes Glitzern auf den "
      "Bluetenblaettern.");
    AddDetail("glitzern","Es sieht irgendwie wunderschoen aus, mehr "
      "kannst Du dazu nicht sagen.");
    AddDetail("firmament","Ein Gaensebluemchen hat bestimmt kein Firmament.");
    AddDetail(({"dovenya","gaerten"}),"Das ist wohl der Herkunftsort des "
      "Gaensebluemchens.");
    AddDetail("herkunftsort","Hm, Dovenya?");
    SetProp(P_SMELL,"Der Duft eines Gaensebluemchens, mit einem Hauch "
      "Geheimnis.\n");
  
    SetProp(P_NAME,"Gaensebluemchen");
    SetProp(P_GENDER,NEUTER);

    AddId(({"bluemchen","gaensebluemchen","\a\n\a\tol_gaensebluemchen","blume"}));

    SetProp(P_INFO,
      "Manche Leute koennen solche Gaensebluemchen der Nacht fuer "
      "irgendwelche\nmedizinischen (Heil-)Zwecke nutzen.\n");

    SetProp(P_WEIGHT,10);
    SetProp(P_KRAUT_DRYING_FACTOR,-1);
    SetProp(P_KRAUT_RESETS_UNTIL_DECOMPOSE,-1); 

}
