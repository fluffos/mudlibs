/* Ein Kraut - Das Wiesenzwindchen
 * __________________________________________(i) Anatol@Silberland (2012) */

#include <properties.h>
#include "../../defines.h"

inherit "/d/nacht/std/kraut" ;



public void
create()
{
    if (!is_clone(this_object())) return;
    ::create();
    seteuid(getuid(this_object()));
  
    AddId(({"\a\n\a\tol_kraut","\a\n\a\tol_wiesenzwindchen",
         "zwindchen","wiesenzwindchen"}));
    AddAdjective(({"selten"}));

    SetProp(P_SHORT,"Ein seltenes Wiesenzwindchen");

    SetProp(P_LONG,
        "Das Wiesenzwindchen sieht fast so aus wie das gemeine Loewenmaul, "
        "die sonnengelbe Farbe scheint sogar im Daemmerlicht noch zu "
        "strahlen. Man sagt dem zarten Pflaenzlein allerlei 'Heilkraefte' "
        "zu, die freizusetzen es aber sehr spezialisierte und begabe "
        "Alchemisten braeuchte. Wiesenzwindchen sind allgemein selten, "
        "wachsen nur sehr langsam und verderben schnell - deshalb ist es "
        "allgemein nicht gestattet, sie zu pfluecken.");

    SetProp(P_INFO, "Es ist ziemlich uncool, Wiesenzwindchen zu "
        "pfluecken. Etwaige weitere Eigenschaften sind da nicht von "
        "Belang. Lass sie zukuenftig einfach stehen.");

    AddDetail(({"heilkraft","heilkraefte"}),
        "Es geht hier dem Hoerensagen nach um ganz spezielle ... aeh ... "
        "Heilkraefte.");
    AddDetail("farbe",
        "Das ganz besondere Gelb des Wiesenzwindchens scheint auch im "
        "Dunkeln zu strahlen. Wow.");
    AddDetail(({"blatt","blaetter"}),
        "Irritierenderweise hast Du nur eine Bluete in der Hand.");
    AddDetail("bluete",
        "Die Bluete des Wiesenzwindchens sieht der eines Loewenmauls "
        "sehr aehnlich.");

    SetProp(P_SMELL, "Der Duft des Wiesenzwindchens weckt ein... "
        "Verlangen... in Dir. Uh-oh...\n");
    SetProp(P_SOUND,"Nichts zu hoeren.\n");

    SetProp(P_NAME,"Wiesenzwindchen");
    SetProp(P_GENDER,NEUTER);
    SetProp(P_VALUE,10000);
    SetProp(P_NODROP,"Du hast es gepflueckt - Du behaeltst es.\n");
    SetProp(P_NEVERDROP,"Du hast es gepflueckt - Du behaeltst es.\n");
    SetProp(P_WEIGHT,0); 
    SetProp(P_MATERIAL,([MAT_PLANT:99,MAT_MAGIC:1]));

    SetProp(P_KRAUT_DRYING_FACTOR,1);
    SetProp(P_KRAUT_RESETS_UNTIL_DECOMPOSE,0); 
    set_next_reset(20);
}

