/* High Heels. Oder so aehnlich.
 * __________________________________________(i) Anatol@Silberland (2012) */

#pragma strict_types

inherit "/std/armour";

#include "../defines.h"

public void 
create()  
{
    if (!is_clone(this_object())) 
        return;
    ::create();

    SetProp(P_SHORT, "Ein Paar roter hoher Schuhe");
    SetProp(P_LONG,break_string(
        "Uh... das ist ein paar hoher roter Schuhe. Sie bestehen offenbar aus "
        "ueberwiegend pflanzlichem Material, scheinen aber stabil genug "
        "zu sein, um sie zu nutzen. Ihre Sohle ist unter den Zehen eine "
        "halbe Handbreit hoch, unter der Ferse eher eineinhalb bis zwei "
        "Handbreit. Die Nutzung dieses Schuhwerks durch eine hinreichend "
        "geuebte Frau faellt mit Sicherheit unter den Oberbegriff 'Balzen'.",
        77));
    AddDetail(({"farn","konkubinenfarn"}),
        "Offenbar kann das Konkubinenfarn vielseitig verwendet werden. "
        "Es ist ja auch sehr reissfest und stabil.");
    AddDetail("material",
        "Diese Schuhe bestehen aus ueberwiegend pflanzlichem Material, "
        "wenn sie nicht sogar ausschliesslich. Die Farbe des Obermaterials "
        "laesst den Schluss auf Konkubinenfarn zu.");
    AddDetail("obermaterial",
        "Das Obermaterial scheint duenn und eng geflochtenes Farn zu sein. ");
    AddDetail("sohle",
        "Die Sohle ist definitiv nicht aus Leder oder Kork, sondern aus "
        "einem gepressten pflanzlichen Material. Sie ist relativ stabil "
        "- und das muss so sein, sie ist naemlich auch ziemlich dick und "
        "hebt die Ferse knapp zwei Handbreit ueber den Boden. Da der "
        "vordere Teil des Fusses nicht so hoch gehoben wird, hat das "
        "natuerlich einen gewissen Einfluss auf die Koerperhaltung.");
    AddDetail(({"oberkoerper","hohlkreuz","haltung","koerperhaltung"}),
        "Wer hochhackige Schuhe traegt, sollte sich im Klaren darueber "
        "sein, dass die hauptsaechliche Wirkung nicht darin besteht, "
        "groesser zu wirken, sondern dass sich Koerperhaltung "
        "und Proportionen aendern. Die Beine wirken laenger, das Po "
        "betont, der Oberkoerper geht fast automatisch in ein leichtes "
        "Hohlkreuz, was alles, was Frau so vorne traegt, ebenfalls etwas "
        "betonen kann. Insofern sind hochhackige Schuhe ein Aufruesten "
        "der passiven femininen Offensivbewaffnung durch Verstaerkung "
        "der Wirkung des Signales 'reproduktionsbereit'.");
    AddDetail(({"offensivbewaffnung","hohlkreuz","aufruestung","bewaffnung"}),
        "... bildlich gesprochen.");

    AddDetail(({"farbe","rot"}),
        "Offenbar sind diese Schuhe aus Konkubinenfarn gebastelt worden. "
        "Das ist in seiner verbreitesten Form rot. Und so "
        "rot ist auch dieses Paar Schuhe. Eine tolle Farbe, tres chique.");
        
    SetProp(P_AC,0); 
    SetProp(P_TEMPERATURE_PROTECTION,([ T_COLD_PROT: 0, T_HEAT_PROT: 0 ]));
    SetProp(P_ARMOUR_TYPE,AT_BOOT); 
    SetProp(P_NAME, "Schuhe");
    SetProp(P_GENDER, FEMALE);
    SetProp(P_NEVERDROP,1);
    SetProp(P_NODROP,1);
    SetProp(P_PLURAL,1);
    SetProp(P_NAME_ADJ,({"rot","hoh"}));
    SetProp(P_INFO, break_string("Diese wunderschoenen hochhackigen roten "
        "Schuhe sind mal wieder nicht fuer jeden geeignet. Sie passen "
        "nur weiblichen Zweibeinern, die ein gewisses Mindestmass an Grazie "
        "vorweisen koennen.",77));
    AddAdjective(({"rot","hoh"}));
    SetProp(P_WEIGHT, 40); 
    SetProp(P_VALUE, 0);  // Die Schuhe koennen unlimitiert geholt werden.
    SetProp(P_MATERIAL,([MAT_PLANT:100]));
    SetProp(P_SMELL,"Die Schuhe riechen leicht nach Graesern, ansonsten aber "
     "nicht unangenehm.\n");
    SetProp(P_SOUND,"Kein Laut zu hoeren.\n");
    AddId(({"\a\n\a\tol_heels","schuhe","schuh"})); 
    SetProp(P_WEAR_RESTRICTIONS,
        ([   P_GENDER:FEMALE,
             SR_EXCLUDE_RACE:({"troll","oger"}),
        ]));
}



public string
extra_look() 
{
    if (!environment() || (!(living(environment()))))
        return "";
    else
        return break_string(
            capitalize((string)(environment()->QueryPronoun(WER)))+
            " haelt ihren Koerper figurbetont besonders aufrecht. Sexy.\n",
            77);
}
