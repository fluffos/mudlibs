/* Farn-Roeckchen
 * __________________________________________(i) Anatol@Silberland (2012) */

#pragma strong_types

inherit "/std/armour";

#include "../defines.h"

public void 
create()  
{
    if (!is_clone(this_object())) 
        return;
    ::create();

    SetProp(P_SHORT, "Ein rotes Farn-Roeckchen");
    SetProp(P_LONG,break_string(
        "Okaaay, .... irgendjemand hat aus rotem Konkubinenfarn ein "
        "Roeckchen gebastelt. Es hat eine wirklich schoene Farbe, doch "
        "das 'Gewebe' ist alles andere als blickdicht - sehr sexy, aber "
        "man braucht schon einen passenden Anlass (und Koerperbau), um "
        "diesen Blickfang tragen zu koennen.",77));

    AddDetail(({"konkubinenfarn","farn"}),
        "Dieses Roeckchen ist offenkundig aus Konkubinenfarn gebastelt.");
    AddDetail(({"farbe","rot"}),
        "Konkubinenfarn ist in seiner verbreitesten Form rot. Und so "
        "rot ist auch dieses Roeckchen. Eine tolle Farbe, tres chique.");
    AddDetail("gewebe",
        "Naja, Gewebe ist irrefuehrend. Ein paar lange Halme dienen als "
        "Bund, der Rest ist irgendwie daran befestigt und haengt locker "
        "nach unten. Junge Damen, die sich in dieses Roeckchen gewanden, "
        "sollten besser nicht huepfen.");
    AddDetail(({"halm","halme"}),
        "Die Blaetter des Konkubinenfarms sind im Prinzip lange flache "
        "Halme, die direkt aus dem Boden wachsen. Wer kam wohl auf die "
        "Idee, daraus einen Rock zu basteln?");
        
    SetProp(P_AC,0); 
    SetProp(P_TEMPERATURE_PROTECTION,([ T_COLD_PROT: 0, T_HEAT_PROT: 0 ]));
    SetProp(P_ARMOUR_TYPE,AT_TROUSERS); 
    SetProp(P_NAME, "Farnroeckchen");
    SetProp(P_GENDER, NEUTER);
    SetProp(P_NAME_ADJ,"rot");
    AddAdjective("rot");
    SetProp(P_WEIGHT, 40); 
    SetProp(P_VALUE, 100);  // Farn darf nicht unlimitiert wachsen
    SetProp(P_MATERIAL,([MAT_PLANT:100]));
    SetProp(P_SMELL,"Ein leichter Moschus-Duft geht von dem Farn-Roeckchen aus.\n");
    SetProp(P_SOUND,"Das Farn-Roeckchen knistert leise.\n");
    AddId(({"\a\n\a\tol_farnroeckchen","rock","roeckchen","farn-roeckchen","farn-rock"})); 
    SetProp(P_WEAR_RESTRICTIONS,
        ([   P_GENDER:FEMALE,
             SR_EXCLUDE_RACE:({"troll","oger","zwerg"}),
        ]));
}



public void 
Bastler(object pl) 
{
    if ((!pl) || (!objectp(pl)) || (!living(pl))) 
        return 0;

    if ((int)(pl->QueryProp(P_GENDER))==MALE)
    {
        AddAdjective("sehr knapp");
        SetProp(P_NAME_ADJ,({"rot","sehr knapp"}));
        SetProp(P_INFO,break_string(
           "So knapp wie das Roeckchen geschnitten ist, "
           "stammt es sicher nicht aus Frauenhand. Du hast das Gefuehl, "
           "dass "+pl->name(WER)+" damit etwas zu tun hat.",77));
    }
    else
    {
        AddAdjective("knielang");
        SetProp(P_NAME_ADJ,({"rot","knielang"}));
        SetProp(P_INFO,break_string(
           "Die komfortable Rocklaenge laesst durchaus den "
           "Schluss zu, dass patriachalischer Voyeurismus "
           "seine Finger gerade nicht im Spiel hatte. Vermutlich "
           "hat "+pl->name(WER)+" mit der Herstellung zu tun.",77));
    }
}

public string
extra_look() 
{
    if (!environment() || (!(living(environment()))))
        return "";
    else
        return capitalize(environment()->QueryPronoun(WER))+
            " wird von einem Hauch von Moschus umgeben.\n";
}
