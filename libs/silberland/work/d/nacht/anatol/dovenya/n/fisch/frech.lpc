/* Ein kleiner Fisch - wie frech!
 * _____________________________________(i) Anatol@Silberland (1998-2012) */

#pragma strict_types

#include "../../defines.h"
#include <properties.h>
#include <language.h>
#include <moving.h>
#include <combat.h>

inherit DOVENYA "std/fisch";

public void 
create() 
{
    string col;
    if (!is_clone(this_object())) 
        return;
    ::create(); 
    col=({"gepunktet","gestreift","gefleckt","gescheckt",
     "gestreift","gezackt","kariert"})[(random(7))]; 

    SetProp(P_LONG, break_string(
        "Das ist aber ein Schlingel... der Fisch guggt schon so frech, und "
        "fuer Fische ist das gar nicht so einfach!. Er glitzert "+col+
        " in allen Farbtoenen und schwimmt munter umher.",77));

    AddAdjective(({"frech",col}));
    SetProp(P_NAME_ADJ,({"frech",col}));
    SetProp(P_SHORT,Name(WER));
    SetProp(P_NAME_ADJ,({col}));
    AddId(({"\nfrech"}));
    SetProp(P_ALIGN, -200);
    SetChats(20, ({ "@@scrollMeUpPlease@@", }) );
}

nosave string 
scrollMeUpPlease() 
{
    object *os;
    object o;
    string s1, s0;
    os=filter_array(all_inventory(environment(this_object()))-
        ({this_object()}), #'living);
    if (sizeof(os)) 
    {
        o=os[(random(sizeof(os)))];
        if (o->id("\a\n\a\tol_fisch")) 
        {
            if (o->id("\nputzig")) 
            {
                environment()->Message(break_string(
                    sprintf("%s versucht, %s spielerisch aufzufressen.\n",
                    this_object()->Name(WER),o->name(WEN)),77),MSGFLAG_VISUAL);
                if (random(500)==3) 
                {
                    o->SchwimmDavon();
                }
            }
            else 
                environment()->Message(break_string(
                    sprintf("%s stupst %s reichlich frech an.\n",
                    this_object()->Name(WER),o->name(WEN)),77),MSGFLAG_VISUAL);
        }  
        else 
        {
            switch(random(6)) 
            {
                case 0:
                    s0=sprintf("%s stupst %s auf dem Kopf herum.",
                        this_object()->Name(WER),o->name(WEM));
                    s1=sprintf("%s stupst Dir auf dem Kopf herum.",
                        this_object()->Name(WER));
                    break;
                case 1:
                    s0=sprintf("%s schwimmt %s voll gegen den Hintern.",
                        this_object()->Name(WER),o->name(WEM));
                    s1=sprintf("Huch, irgendwas hat Dich gerade gestossen!");
                    break; 
                case 2:
                    s0=sprintf("%s schwimmt zwischen %s Beinen durch.",
                        this_object()->Name(WER),o->name(WESSEN)),
                    s1=sprintf("%s schwimmt Dir zwischen den Beinen durch.",
                        this_object()->Name(WER));
                    break; 
                case 3:
                    s0=sprintf("%s starrt %s tief in die Augen.",
                        this_object()->Name(WER),o->name(WEM));
                    s1=sprintf("%s starrt Dir ploetzlich tief in die Augen.",
                        this_object()->Name(WER));
                    break; 
                case 4:
                s0=sprintf("%s beisst %s 'zaertlich' in den grossen Zehe.",
                        this_object()->Name(WER),o->name(WEM));
                s1=sprintf("%s beisst Dir 'zaertlich' in den grossen "
                        "Zehe. AUAAA!", this_object()->Name(WER));
                    break; 
                default:
                    s0=sprintf("%s rammt %s in den Bauch.\n"
                        "Naja, aber es war ein Versuch.",
                        this_object()->Name(WER),o->name(WEN));
                    s1=sprintf("%s rammt Dich voll in den Bauch.\n"
                        "Es tat zwar nicht weh, aber was bildet dieser "
                        "Fisch sich ein?", this_object()->Name(WER));
                    break; 
            }
            environment()->Message(break_string(s0,77,0,1),
                MSGFLAG_VISUAL,([MSGFLAG_EXCLUDE:({o})]));
            o->Message(break_string(s1,77,0,1));
        }
    }
    return "";
} 
