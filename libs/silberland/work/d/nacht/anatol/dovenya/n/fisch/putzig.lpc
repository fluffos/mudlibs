/* Ein kleiner Fisch, putzig...
 * ______________________________________(i) Anatol@Silberland (1998-2012) */


#pragma strict_types

#include "../../defines.h"
#include <properties.h>
#include <language.h>
#include <moving.h>
#include <combat.h>

inherit DOVENYA "std/fisch";

public void 
create() 
{
    string col;
    if (!is_clone(this_object())) 
        return;
    ::create(); 

    col=({"rot","gelb","gruen","blau",
        "tuerkis","schwarz","purpur"})[(random(7))]; 
    
    SetProp(P_LONG, break_string(
        "Hach, ist der nicht wirklich suess? Dem schnuckeligen kleinen "
        "Fisch scheint es hier recht gut zu gehen, er schillert vergnuegt "
        "in allen "+capitalize(col)+"toenen und schwimmt munter umher.",77));
    
    AddAdjective(({"putzig","klein",col}));
    SetProp(P_NAME_ADJ,({"putzig","klein",col}));
    SetProp(P_SHORT,Name(WER));
    SetProp(P_NAME_ADJ,({col}));
    AddId(({"\nputzig"}));
    SetProp(P_ALIGN, 200);
    
    SetChats(20, ({ "@@scrollMeUpPlease@@", }) );
}


public string 
scrollMeUpPlease() 
{
    object *os;
    object o;
    string s1, s0;

    os=filter_array(all_inventory(
        environment(this_object()))-({this_object()}), #'living);

    if (sizeof(os)) 
    {
        o=os[(random(sizeof(os)))];
        if (o->id("\a\n\a\tol_fisch")) 
        {
            if (o->id("\nputzig")) 
            {
                environment()->Message(
                (break_string(sprintf("%s und %s unkreisen sich verspielt.\n",
                    this_object()->Name(WER),o->name(WER)),77)),MSGFLAG_VISUAL);
                if (random(500)==3) 
                {
                    o=clone_object(explode(file_name(this_object()),"#")[0]);
                    o->move(environment(this_object()),M_GO,0,"schwimmt davon",
                        "kam jetzt von irgendwoher ;o)");
                }
            }
            else 
                environment()->Message(
                    break_string(sprintf("%s stupst %s verspielt an.\n",
                    this_object()->Name(WER),o->name(WEN)),77),MSGFLAG_VISUAL);
        }  
        else 
        {
            switch(random(6)) 
            {
                case 0:
                    s0=sprintf("%s schwimmt %s um den Kopf herum.",
                        this_object()->Name(WER),o->name(WEM));
                    s1=sprintf("%s schwimmt um Deinen Kopf herum.",
                        this_object()->Name(WER));
                    break;
                case 1:
                    s0=sprintf("%s knabbert an %2 Ohr herum.",
                        this_object()->Name(WER),o->name(WESSEN));
                    s1=sprintf("%s knabbert an Deinem Ohr herum.",
                        this_object()->Name(WER));
                    break; 
                case 2:
                    s0=sprintf("%s schwimmt zwischen %s Beinen durch.",
                        this_object()->Name(WER),o->name(WESSEN)),
                    s1=sprintf("%s schwimmt Dir zwischen den Beinen durch.",
                        this_object()->Name(WER));
                    break; 
                case 3:
                    s0=sprintf("%s stupst %s frech auf die Nase.",
                        this_object()->Name(WER),o->name(WEM));
                    s1=sprintf("%s stupst Dir frech auf die Nase.",
                        this_object()->Name(WER));
                    break; 
                case 4:
                    s0=sprintf("%s zieht eine Spirale um %s.",
                        this_object()->Name(WER),o->name(WEN));
                    s1=sprintf("%s zieht eine Spirale um Dich.",
                        this_object()->Name(WER));
                    break; 
                default:
                    s0=sprintf("%s kitzelt %s am Kinn\n%s versucht, sich zu "
                        "beherrschen, muss aber doch blubbern.",
                        this_object()->Name(WER),o->name(WEN),o->Name(WER));
                    s1=sprintf("%s kitzelt Dich am Kinn.\n"
                        "Du versuchst, Dich zu "
                        "beherrschen, musst aber doch blubbern.",
                        this_object()->Name(WER));
                    break; 
            }
            environment()->Message(break_string(s0,77,0,1),
                MSGFLAG_VISUAL, ([MSGFLAG_EXCLUDE:({o})]));
            o->Message(break_string(s1,77,0,1));
        }
    }
    return "";
} 

