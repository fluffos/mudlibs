/* Donal Sternfall
 * Croupier. Lebendiges Modul fuer Wettansagen.
 * __________________________________________(i) Anatol@Silberland (2013) */

#pragma strict_types
#include "../defines.h"
#include <moving.h>
#include "../sys/comet.h"

#define DB(x)   printf( x )
#define DONAL_LOG DOVENYA_LOG "casino/aine.log"
inherit DOVENYA "std/npc";

public void 
create() 
{
    seteuid(getuid(this_object()));

    if (is_clone(this_object())) 
    {
        destruct(this_object());
        return;
    }
    ::create();

    SetProp(P_SHORT,"Donal Sternfall, Croupier");
    SetProp(P_LONG,
        "Ein absolut makellos gepflegtes Aeusseres zeichnet Donal Sternsang "
        "aus: Er traegt einen dunklen Anzug eines Bediensteten und "
        "steht mit unbewegter Miene und perfekter aufrechter Koerperhaltung "
        "hochkonzentriert am Roulette-Tisch. Jener muesste eigentlich von "
        "bis zu vier seines Standes versorgt werden - deshalb ist Donal als "
        "Croupier voll ausgelastet und fuer Fragen der Clientel nicht allzu "
        "zugaenglich... Immerhin ist er geneigt, die Ansagen, die er "
        "annimmt, zu erlaeutern.");
     
     AddDetail(({"ansage","ansagen"}),
        "Donal wird Dir dazu vielleicht etwas verraten - Aber Du koenntest "
        "auch 'hilfe ansagen' versuchen.");
    AddDetail(({"haltung","koerperhaltung"}),
        "Der Croupier steht aufrecht und beobachtet Tisch und Jetons "
        "sehr aufmerksam.");
    AddDetail(({"anzug"}),
        "Der Anzug ist dunkel und von unauffaelligem Schnitti. Er "
        "sitzt Donal wie angegossen.");

    SetProp(P_GENDER, MALE);
    SetProp(P_INFO, break_string(
        "Donal ist Croupier, schon immer Croupier gewesen und "
        "wird es hoffentlich auch lange bleiben. Er ist eher der "
        "schweigsame Typ und spricht nur, wenn seine Aufgaben es verlangen. "
        "Seine Aufgaben sind sehr klar umrissen: Die 'Ansagen' sind sein "
        "Spezialgebiet: Er nimmt Ansagen von kombinierten Wetten auf und "
        "platiert die Cometen des Spielers fuer ihn." ,77));

    SetProp(P_NAME,"Donal Sternfall");
    AddId(({"donal", 
            CROUPIERID,
            "donal sternfall", 
            "sternfall", 
            "\a\n\a\tol_donal_sternfall"}));
  
    SetProp(P_ARTICLE,0);
    set_living_name("donal"); 
    create_default_npc(1);
    SetProp(P_MAX_HP,300);
    SetProp(P_MAX_SP,300);
    SetProp(P_BODY,30);
    SetProp(P_NOATTACK,"tut hier nur seine Arbeit"); 
    SetProp(P_HANDS,({" bestimmt nicht",150,DT_SQUEEZE}));
    SetProp(P_XP,0);
    SetProp(P_SIZE,172);
    SetProp(P_ALIGN,730);
    SetProp(P_RACE,"Nachtelf");
    SetProp(P_REJECT, REJECT_DROP);
    SetProp(P_MMSGIN,"faellt verdutzt aus einem Funkenwirbel");
    SetProp(P_MSGIN,"stellt sich schweigend an den Roulette-Tisch");
    SetProp(P_MSGOUT,"verlaesst den Tisch und geht anderen Aufgaben nach");
    SetProp(P_MMSGOUT,"wird verdutzt in einen Funkenwirbel gezogen");
    SetProp(P_AWAY,"Bitte stoere mich nicht ich muss hier aufpassen!");
    SetProp(P_MURDER_MSG,"Huch!");

    AddInfo(DEFAULT_INFO,"beantwortet die Frage nicht.",
        0,0,0);

    AddInfo(({"einsatz"}),
        "Dein Einsatz fuer angesagte Kombinationswetten darf das "
        "Tischlimit fuer Chancen auf einfache Zahlen nicht ueberschreiten. "
        "Wenn du als Einsatz 'maximum' angibst, werde ich allerdings auf "
        "jedes Chance der Wette, auch wenn das entgegen der Gepflogenheiten "
        "der Wette sein sollte, das erlaubte Maximum platzieren.",
        "erlaeutert: ", "@@processStringAnswer@@",
        "Wie hoch darf mein angesagter Einsatz sein?");
    
    AddInfo(({"kessel","limit","tableau"}),
        "Schau' Dir bitte den Tisch mal genauer an.",
        "seufzt: ", "@@processStringAnswer@@",
        "Bla bla ... (ohje) ... Blubb?");
    
    AddInfo(({"kesselwette","kesselwetten"}),
        "Eine Kesselwette ist eine kombinierte Wette, die sich an "
        "der Position der Zahlen im Kessel orientiert. Fuer gewoehnlich "
        "decken Kesselwetten einen bestimmten Bereich im Kessel ab. "
        "Nullspiel, Voisins, Tier und Nachbarn sind Kesselwetten.",
        "erklaert: ", "@@processStringAnswer@@",
        "Was sind Kesselwetten?"
        );

    AddInfo(({"kombinierte wetten","kombinationswetten","kombinationswette"}),
        "Kombinationswetten sind der Grund, warum ich Ansagen entgegen nehme. "
        "Sie bestehen aus mehreren einzelnen Wetten, gegebenfalls von "
        "verschiedener Hoehe. Prinzipiell koennen solche Wetten auch ohne "
        "meine Hilfe platziert werden; ich nehme aber VIP-Gaesten unseres "
        "Hauses diese Muehen gerne ab.",
        "erklaert: ", "@@processStringAnswer@@",
        "Was sind kombinierte Wetten?");

    AddInfo(({"vip","vip-gaeste","vip-gast"}),
        "Selbstverstaendlich werden regelmaessige und risikofreudige "
        "Gaeste des Hauses mit besonderer Aufmerksamkeit bedacht.",
        "schmunzelt: ", "@@processStringAnswer@@",
        "... VIPs?");

    AddInfo(({"ansage","ansagen","announce","announcen"}),
        "Ansagen sind kombinierte Wetten. Der Croupier - also ich - "
        "uebernimmt fuer die VIP-Gaeste des Hauses das Platzieren der "
        "Einsaetze. "
        "Zur Zeit sind im Casino 'Comet' folgende Ansagen zugelassen: "
        "Komplett, Nachbarn, Finale, Voisins, Nullspiel, Tiers und "
        "Orphelins. Im Unterschied zu normalen Wetten werden mehr "
        "Cometen platziert als in der Ansage angegeben, manchmal "
        "viel mehr - informiere Dich besser vorher genau ueber sie.",
        "fuehrt aus: ", "@@processStringAnswer@@",
        "Koenntest Du das mit den Ansagen etwas ausfuehren?");

    // ansage <zahl> komplett mit <einsatz>      ans <zahl> k mit <einsatz>

    AddInfo(({"komplett"}),
        "Die Ansage wird getaetigt als '<zahl> komplett mit <einsatz>'. "
        "Ich werde dann alle inneren Chancen - also alle Chancen, die auf "
        "oder an die Zahlen selbst gesetzt werden - zu der gewuenschten "
        "Zahl setzen, und zwar jeweils mit dem passenden Vielfachen des "
        "von Dir gewuenschten Einsatzes: Ein einfacher Einsatz geht auf "
        "die Zahl selbst, der doppelte Einsatz auf alle passenden Paare, "
        "der dreifache auf die einfache Reihe, der vierfache auf die "
        "passenden Gevierte und der sechsfache auf die passenden doppelten "
        "Reihen. Insgesamt haengt die Zahl der Wetten und die Hoehe des "
        "gesamten Einsatzes also auch davon ab, welche Zahl Du Dir ausgesucht "
        "hast - bei der 34 platziere ich fuer Dich beispielsweise das 18fache "
        "Deines angesagten Einsatzes, bei der 5 das 40fache.",
        "erklaert: ", "@@processStringAnswer@@",
        "Was ist die Ansage 'Komplett'?");

    // ansage <zahl> und nachbarn mit <einsatz>  ans <zahl> un mit <einsatz>

    AddInfo(({"nachbar","nachbarn", "und nachbarn","un"}),
        "Die Ansage wird getaetigt als '<zahl> und nachbarn mit <einsatz>', "
        "es ist eine Kessel-Wette. Ich werde auf die Chancen der Zahl selbst "
        "und die ihrer vier naechsten Nachbarn - zwei links, zwei rechts - "
        "im Kessel jeweils den von Dir angesagten Einsatz platzieren.",
        "erklaert: ", "@@processStringAnswer@@",
        "Was ist die Ansage 'Und Nachbarn'?");

    // ansage finale <ziffer> mit <einsatz>      ans fin <ziffer> mit <einsatz>

    AddInfo(({"finale","finalen", "endziffern","fin"}),
        "Die Ansage wird getaetigt als 'finale <ziffer> mit <einsatz>'. "
        "Ich werde auf die Chance jeder Zahl mit der von Dir angesagten "
        "Endziffer den von Dir angesagten Einsatz platzieren, also insgesamt "
        "das drei- oder vierfache Deiner Ansage auf das Tableau bringen.",
        "erklaert: ", "@@processStringAnswer@@",
        "Was ist die Ansage 'Finale'?");

    // ansage voisins du zero mit <einsatz>      ans vdz mit <einsatz>

    AddInfo(({"voisins","voisins du zero", "vdz","voisin"}),
        "Die Ansage wird getaetigt als 'voisins du zero mit <einsatz>', "
        "bedeutet etwas frei uebersetzt 'die Nachbarschaft der Null' und "
        "ist eine beliebte Kesselwette: Es werden Chancen besetzt, "
        "so dass Zahlen, die in der Haelfte des Kessels um Zero liegen, "
        "gewinnen. Der Gewinn ist insgesamt nicht sehr hoch, aber natuerlich "
        "auch nicht so unfahrscheinlich. Ich werde das Neunfache Deines "
        "angesagten Einsatzes platzieren, und zwar immer wie folgt: "
        "Auf die Paare 4/7, 12/15, 18/21, 19/22 und 32/35 einfach und "
        "doppelt auf die Reihe 023 und das Geviert 25-29.",
        "erklaert: ", "@@processStringAnswer@@",
        "Was ist die Ansage 'Voisins du Zero'?");

    // ansage nullspiel mit <einsatz>            ans ns mit <einsatz>

    AddInfo(({"nullspiel","ns"}),
        "Das Nullspiel wird angesagt als 'nullspiel mit <einsatz>', und "
        "ist eine sehr beliebte Kesselwette - vermutlich von einem Spieler "
        "etabliert, der den Eindruck hatte, die Null wuerde "
        "ueberdurchschnittlich haeufig fallen. Was natuerlich nicht so "
        "ist. Ich werde das vierfache Deines angesagten Einsatzes platzieren, "
        "und zwar auf die Paare 0/3, 12/15 und 32/35, sowie auf die Chance "
        "der Zahl 26.",
        "erklaert: ", "@@processStringAnswer@@",
        "Was ist die Ansage 'Nullspiel'?");

    // ansage le tiers du cylindre mit <einsatz> ans tdc mit <einsatz>

    AddInfo(({"le tiers du cylindre","tiers","tiers du cylindre","tdc"}),
        "Die 'Tiers' werden angesagt als 'tiers du cylindre mit <einsatz>', "
        "und ist eine Kesselwette. Ich werde fuer Dich mit sechs Paarwetten "
        "jeweils in Hoehe des von Dir genannten Einsatzes das der Null "
        "gegenueber liegende Drittel des Kessels besetzen. Die Paare sind "
        "also 5/8, 10/11, 13/16, 23/24, 27/30 und 33/36.",
        "erklaert: ", "@@processStringAnswer@@",
        "Was ist die Ansage 'Le Tiers Du Cylindre'?");

    // ansage orphelins mit <einsatz>            ans orph mit <einsatz>

    AddInfo(({"orphelins","orphelin","orph","waisen","orphans","orphan"}),
        "Die 'Orphelins' werden angesagt als 'orphelins mit <einsatz>', "
        "und sind eine Kesselwette. Uebersetzt heisst sie 'Waisen' und "
        "meint jene Zahlen, die weder in den Voisins du Zero - also etwa "
        "der Haelfte um die Null - und den Tiers du Cylindre - dem Drittel "
        "gegenueber der Null - enthalten sind. Ich werde das insgesamt "
        "das Vierfache des von Dir angesagten Einsatzes setzen, und zwar "
        "auf die Paare 6/9, 14/17, 17/20 und 31/34.",
        "erklaert: ", "@@processStringAnswer@@",
        "Was ist die Ansage 'Orphelins'?");
}

nosave string 
processStringAnswer()
{
    return sprintf("%s antwortet %s.\n",
        Name(WER),
        this_player()->name(WEM));
}

public void 
OffDuty()
{
    if (environment())
    {
        environment()->Message(sprintf("%s raeuspert sich.\n",Name(WER))+
            break_string("Erlaubt, dass ich mich zurueckziehe.",77,
                Name(WER)+" sagt: "));
        move("/room/void",M_GO|M_NOCHECK);
        remove();
    }
}

public void
OnDuty()
{
    move(previous_object(),M_GO|M_NOCHECK);
}

