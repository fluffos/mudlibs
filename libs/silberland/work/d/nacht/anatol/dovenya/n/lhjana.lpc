}

nomask string getShortHelp() {
  return break_string("\n\
            SET!  -  Die ultimative Herausforderung\n\
     \n\
     mitspielen                  ins Spiel einsteigen / mitspielen\n\
     aussteigen                  aussteigen / doch nicht mitspielen\n\
     anfangen                    das Spiel beginnen lassen\n\
     karten                      ausliegende Karten anschauen\n\
     runde oeffnen|schliessen    'geschlossene Gesellschaft' ja/nein\n\
     stand                       Spielzustand anzeigen\n\
     set keines|<a> <b> <c>      'sehe kein Set' / Set melden\n\
     hilfe set [lang]            Hilfeseite [/ Spielregeln]\n\
\n"
  ,76,0,1);
}  

nomask string getLongHelp() {
  string res;
  if (!this_player()) return "";
  res=break_string("\n\
             SET!  -  Die ultimative Herausforderung\n\
\n\
  SET! ist ein Kartenspiel fuer (nahezu) beliebig viele Spieler. \n\
\n\
  Das Spiel  besteht aus 81 verschiedenen Karten, von denen zu Beginn\n\
  zwoelf aufgedeckt und ausgelegt werden. Jede dieser Karten zeichnet\n\
  sich durch vier Eigenschaften aus:\n"
"\n\
   - Symbolart      (Es gibt /, * und O)\n\
   - Symbolanzahl   (Ein Symbol kommt ein- bis dreimal auf eine Karte)\n\
   - Rahmenart      (Etwa wie ------, ======= oder ooooooo)\n\
   - Farbe          (Hiervon rot, tuerkis und gruen)\n\
\n\
     *****************************************************\n\
     *  Ein SET bilden drei Karten, bei welchen fuer     *\n\
     *  jedes ihrer vier Merkmale jeweils gilt:          *\n\
     *  entweder bei allen drei Karten GENAU GLEICH,     *\n\
     *  oder bei allen drei Karten VOELLIG VERSCHIEDEN.  *\n\
     *****************************************************\n"
"\n\
Am Ende der Spielregeln sind noch einige Beispiele aufgefuehrt.\n\
\n\
ZIEL DES SPIELS:\n\
\n\
  Ganz einfach: Moeglichst viele Sets finden!\n\
\n"
"SPIELABLAUF: \n\
\n\
  Normalerweise melden sich die Mitspieler an ('mitspielen'),  bevor\n\
  ein Spieler mit 'anfangen' das Spiel beginnen laesst. Es ist aber,\n\
  sofern  die Runde  nicht von  einem Mitspieler  zur  geschlossenen\n\
  Gesellschaft  erklaert  worden  ist ('runde schliessen',  kann mit\n\
  'runde oeffnen' wieder zurueckgenommen werden), auch der (Wieder-)\n\
  Einstieg  in eine laufende Runde moeglich.  Aussteigen kann man zu \n\
  (fast) jedem beliebigen Zeitpunkt.\n\
\n\
  Wenn man ein Set in der Auslage sieht und meldet (z.B. 'set a b c'\n\
  oder 'set abc'),  bekommt man  einen  Punkt gutgeschrieben und die \n\
  drei  Karten  werden entfernt und  (sofern nicht bereits 15 Karten \n\
  auslagen) durch drei neue vom Stapel ersetzt. Hat man sich vertan, \n\
  da die drei Karten  KEIN  Set bilden,  so darf man erst wieder ein \n\
  Set melden,  wenn ein  anderer Spieler ein  Set gefunden  hat oder \n\
  neue Karten hinzukamen.\n\
\n\
  Glaubt man, dass in der Auslage kein  Set vorhanden ist,  kann man\n\
  dies  auch kund tun  ('set keines'),  darf aber weiterhin  ein Set\n\
  melden,  falls man doch  noch eines sieht!  Wenn alle Spieler, die\n\
  ein Set melden duerfen  (die, die nicht wegen einer  Falschmeldung \n\
  vom  Spielleiter gesperrt sind), den Glauben an die Existenz eines \n\
  Sets in der  Auslage  verloren haben,  prueft der Spielleiter,  ob \n\
  tatsaechlich  keines mehr  vorhanden ist und  ergaenzt die Auslage\n\
  gegebenenfalls um drei weitere Karten auf 15.  War dennoch ein Set\n\
  zu finden,  punktet der Spielleiter und ersetzt das Set durch drei\n\
  neue Karten. Ach ja: Der Spielleiter ist Lhjana! :o)\n\
  \n\
  Um die ausliegenden Karten zu betrachten, muss man nicht unbedingt\n\
  selbst  mitspielen,  das Kommando  'karten' ist,  wie auch 'stand'\n\
  (Informationen ueber das laufende Spiel), auch fuer Zuschauer aus-\n\
  fuehrbar.\n\
\n"
"SPIELENDE:\n\
\n\
  Wenn  der Kartenstapel  verbraucht ist und  kein Set mehr gefunden\n\
  werden kann, ist das Spiel beendet und es wird ausgewertet.\n\
  \n\
  Das Spiel wird  vorzeitig beendet,  wenn alle Spieler ausgestiegen\n\
  ('aussteigen') sind oder vom Spielleiter als ''ausgestiegen'' ver-\n\
  merkt (z.B. nach Verlassen des Raumes) wurden.  \n\
  \n\
  Falls in einer erweiterten Auslage  (15 Karten) kein Set zu finden\n\
  sein sollte, fuehrt dies auch zum vorzeitigen Spielende.\n\
\n\
          21.04.98, Anatol\n",77,0,1);
  if ((string)this_player()->QueryProp(P_TTY)!="ansi") 
    res+="\n"
      "Da Du keine ansi-Terminalemulation eingestellt hast, bleiben Dir die\n"
      "Set-Beispiele leider vorenthalten! Besorg' Dir doch mal ein besseres\n"
      "Terminal!\n\n";
  else {
    res+="\n Einige Beispiele:\n\n";
    res+=getThree(28,1,55)+
         "Farbe: verschieden, Rahmen: gleich,\n"
         "Symbole: gleich, Anzahl: gleich...              Also: SET!\n\n";
    res+=getThree(0,40,80)+
         "Farbe: verschieden, Rahmen: verschieden,\n"
         "Symbole: verschieden, Anzahl: verschieden...    Also: SET!\n\n";
    res+=getThree(33,26,66)+
         "Farbe: verschieden, Rahmen: verschieden,\n"
         "Symbole: WEDER NOCH, Anzahl: verschieden...     Also: KEIN SET!\n\n";
  }

  res+="\
    SET! - Die ultimative Herausforderung!  ist keine Erfindung\n\
     von mir, sondern von SET Enterprises, Inc. (c) 1988, 1990\n\n";

  return res;
}

nomask nosave int cmdHilfe(string str) {
  if (!this_player()) return 0;
  if (str=="set") {
    printf(getShortHelp());
    return 1;
  }
  else if (str=="set lang") {
    this_player()->More(getLongHelp());
    return 1;
  }
  else return 0;
}

varargs int move(mixed dest, int method, string dir, string textout,
     string textin) {
  if ((game!=STAT_NO_GAME)||(sizeof(players))) {
    if (this_player()) tell_object(this_player(), 
        "Lhjana ist gerade beschaeftigt, tut mir leid.\n");
    return 0;
  }
  else return ::move(dest, method, dir, textout, textin);
}

nomask public void NotifyPatsch() {
  if (!this_player()) return;
  if (previous_object()!=environment()) return;
  if (getuid(previous_object())!=getuid(this_object())) return;
  tell_room(environment(),"Lhjana gibt ein albernes Kichern von sich.\n");
  return;
}

nomask public void
NotifyPflueck() 
{
    object ob;
    if (!ob=this_player()) return;
    if (previous_object()!=environment()) return;
    if (getuid(previous_object())!=getuid(this_object())) return;
    if (environment(ob) == environment())
    {
        command_me("sag Sag mal - spinnst Du?!");
        environment()->Message(Name(WER)+" gibt "+
            ob->Name(WEM)+ " eine schallende Ohrfeige.\n",MSGFLAG_NO_TP);
        ob->Message(Name(WER)+" gibt Dir eine schallende Ohrfeige.\n");
        environment()->Message(Name(WER)+" kuckt zornig.\n");
    }
    return;
}
