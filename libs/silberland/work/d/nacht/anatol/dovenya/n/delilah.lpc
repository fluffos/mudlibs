public void
heart_beat()
{
    string * s;
    string * pp;
    object o;

    ::heart_beat();

    if (sizeof(s=m_indices(services["follow"])))
    {
        while (sizeof(s))
        {
            if ((o=find_player(s[0])) && 
                (member((object*)(o->QueryPursuers()),this_object())<0))
            {
                o->AddPursuer(this_object());
                if (objectp(o) && (environment(o)) &&
                    ((environment(this_object()))!= (environment(o))))
                    move(environment(o),M_GO);
            }
            s=s[1..];
        }
    }
    if (sizeof(s=m_indices(filter_mapping(waitforlist,lambda(({'x}),
          ({#'|| , ({#'!, ({#'find_player , 'x }) }),
                  ({#'< , ({#'query_idle , ({#'find_player , 'x})}), 4 })}))))))
    {
        while (sizeof(s))
        {
            pp=m_indices(services["waitfor"]);
            while (sizeof(pp))
            {
                if (member(services["waitfor"][pp[0]],s[0]))
                {
                    services["waitfor"][pp[0]]-=([s[0]]);
                    if (!sizeof(services["waitfor"][pp[0]]))
                        services["waitfor"]-=([pp[0]]);

                    if ( (!find_player(s[0]))
                        || ( (find_player(s[0])->QueryProp(P_INVIS))
                            && (!IS_LEARNER(pp[0]))))
                    {
                         issue(pp[0], "Oh, "+capitalize(s[0])+" ist "
                         "leider verschwunden, aus Deinem Gespraech wird "
                         "dann wohl nichts.");
                    }
                    else
                    {
                         issue(pp[0], capitalize(s[0])+" scheint "
                         "gerade wieder aktiv geworden zu sein. Darf ich Dich "
                         "an Deinen Gespraechswunsch erinnern?\a");
                    }  
                }
                pp=pp[1..];
            }
            s=s[1..];
        }
        recalc_waitforlist();
        save();
    }

    while ((o=present("\nobj_misc_furz",
                environment(this_object())))&& (!living(o))
            && (explode(file_name(o),"#")[0]=="/obj/misc/furz"))
    {       
        environment()->Message(break_string(
           Name(WER)+" huestelt pikiert und wedelt den Gestank weg.",77),
           MSGFLAG_VISUAL);
        o->remove();
    }


}

nosave int
is_ignored_verb(string str)
{
    if ((!str) || ( GEBIETER_SECURITY))
        return 0;
    if ( (str[<2..<1] == "le") || (str[<2..<1] == "el"))
        str=str[0..<3];
    if (str[<1..<1] == "e")
        str=str[0..<2];
    return (member(completely_ignored_verbs,str));
}

public int 
die(int poisondeath) 
{
    if(this_player())
      tell_room(environment(this_player()),
        "Delilah hat noch zu viel vor.\n");
    return 1;
}

/* ankucken */

public void caDetailAugen()
{
    if ( !this_player()  ||
         (this_object()!=previous_object()) ||
         (!environment(this_object())) ||
         (environment(this_object()) != environment(this_player())) )
         return;

    impressed+=([file_name(this_player()):time()]);

    this_player()->Message(
            break_string("Delilah hebt ihren Blick und fuer einen "
            "Moment schaut ihr euch in die Augen.",77),MSGFLAG_VISUAL);

    if (this_player()->QueryProp(P_INVIS))
    {
        environment()->Message("Delilah hebt kurz ihren Blick.\n",
            MSGFLAG_VISUAL|MSGFLAG_NO_TP);
        this_player()->Message("Sie... kann Dich sehen.\n",MSGFLAG_VISUAL);
    }
    else
    {
        environment()->Message(break_string(
            "Delilah hebt ihren Blick und schaut " + 
            (string)this_player()->name(WEM)  + 
            " fuer einen kurzen Moment in die Augen.",77), 
                 MSGFLAG_VISUAL|MSGFLAG_NO_TP);
    }
    this_player()->Message(break_string(
        "Fuer einen kurzen Augenblick entgleitet Dir die "
        "Wirklichkeit, und Du spuerst, dass Du vor ... "
        "diesem hoeheren Wesen ... nichts verbergen kannst. "
        "Obwohl Du Deiner eigenen Hilflosigkeit sehr gewahr bist, "
        "ist es kein unangenehmens Gefuehl, im Gegenteil, aber... "
        "sehr fremd.",77),MSGFLAG_VISUAL);

}

nosave string
detailKnopf()
{
    if ((!this_player()) || 
       ((int)(this_player()->QueryProp(P_GENDER))==FEMALE))
         return break_string("Das voellige Fehlen von Knoepfen oder "
          "aehnlichem irritiert Dich sehr. Wie will man ein solches "
          "Kleid an- oder ausziehen? Es sieht aus wie auf den Leib "
          "gezaubert.",77);
    else
         return break_string("Das voellige Fehlen von Knoepfen oder "
         "aehnlichem irritiert Dich etwas. Wie will man einer so "
         "schoenen Frau das Kleid ausziehen, wenn es keine Knoepfe "
         "hat? Es sieht aus wie auf den Leib gezaubert. Vermutlich "
         "ist auch genau das passiert.",77);
}

nosave string
detailAugen()
{
    // wenn zwei gleichzeitig kucken, kriegt nur einer was mit. Aber
    // wir wollen die call_out-Table ja nicht volllaufen lassen...

    if ((this_player()) && (find_call_out("caDetailAugen")<0) && 
       ((!member(impressed,file_name(this_player())) || 
       (time()-impressed[file_name(this_player())]>60))))
        call_out("caDetailAugen",4);

    return break_string(
      "Die apfelgruenen Augen verleihen Delilah ein ueberaus exotisches "
      "Aussehen. Obschon sie ihren Blick devot gesenkt haelt, entgeht ihr "
      "kein Wunsch ihres Gebieters - und auch sonst recht wenig.",77);
}


