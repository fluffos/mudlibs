    AddDetail("kind", "Diese junge Frau ist gewiss kein Kind mehr. Oh nein.");
    
    AddDetail("rasse",
      "Diese junge Dame ist ganz sicher nachtelfischer Herkunft.");

    AddDetail(({"ohr","ohren"}),
      "Die Ohren der jungen Dame sind, das ist jetzt nicht ueberraschend, "
