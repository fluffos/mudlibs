public string
_query_away()
{
    if (!random(1000))
        return ({
            "Gerade schwer mit Aufraeumen beschaeftigt...",
            "Protokoll in Reinschrift schreiben, Moment bitte.",
            "Augenblick, gleich fertig...",
            "Veuillez attendre un moment je vous prie."})[random(4)];
}

varargs int 
Message(string message, int flags, mixed extra)
{
    if (query_verb() &&
      is_ignored_verb(query_verb()))
      return -1;
    return "/std/player/comm"::Message(message,flags,extra);
}

public varargs int id(string str, int lvl)
{
    return ((query_verb() && (is_ignored_verb(query_verb())))
        ?0
        :(::id(str,lvl)));
}


public void 
StartReaction(string verb, string gruppe, string adverb, int touch) 
{
    if (is_ignored_verb(verb)) return;
    if (!this_player()) return;
    if (!environment(this_player()) || 
      (environment() != environment(this_player()))) return;

    switch (gruppe)
    {
        case "fies":
        case "aergerlich":
        case "frech":
            call_out("command_me",0,"muster "+lower_case((string)
                 this_player())->query_real_name()+" /irritiert");
            break;
        case "intim":
           if (GEBIETER_SECURITY)
              call_out("command_me",0, "laechel "+lower_case((string)
                 this_player())->query_real_name()+ " zaer");
           else
              call_out("command_me",0,"muster "+lower_case((string)
                 this_player())->query_real_name()+ " /pikiert");
            break;
        default:
   }
}

public void 
StartReactionAll(string verb, string gruppe, string adverb, int touch) 
{
    // StartReaction(verb, gruppe, adverb, touch);
}

// ----------------------------------------------------------------------------
// tell
// ----------------------------------------------------------------------------

nosave void
issue(mixed target, string message)
{
    if (objectp(target))
        target=lower_case((string)(target->query_real_name()));
    if (!stringp(target))
        return;
    command_me("my_erzaehle "+target+" "+message);
}

// ----------------------------------------------------------------------------
// command handling
// ----------------------------------------------------------------------------

nosave void
executeCommand(string cmd,string mufti)
{
    string * args,ccmd,answer;
    object ob;
    ccmd=lower_case(cmd);
    ccmd=regreplace(ccmd,"[!?,:.-]","",1);
    ccmd=regreplace(ccmd,"  *"," ",1);
    args=explode(ccmd," ");


    switch(args[0])
    {
        case "status":
            if (mufti!=GEBIETER_UID)
                break;;
            issue(mufti,"Ich zeige Dir mal eben meinen Notizblock...");
            if (ob=find_player(mufti))
                tell_object(ob,sprintf("%O\n",services));
            return;
            break;
        case "hilfe":
            if (mufti!=GEBIETER_UID)
                return issue(mufti,"Hilfe?! Meine Dienste moechte ich nicht "
                "jedem anbieten. Was ich nebenbei tun kann - ich kann mir "
                "anwesende idelnde Mitspieler fuer dich merken und dich daran "
                "erinnern, dass Du mit ihnen sprechen moechtest, sobald sie "
                "wieder aktiv sind. Teile mir dafuer 'merke <name>' mit. "
                "Oh, und mein Gebieter hat mir ausserdem "
                "gestattet, ueber ihn selbst auf Nachfrage zu berichten. "
                "Teile mir dazu 'gebieter' mit.");
            else
               return issue(mufti,"Ich verstehe: hilfe, folge, bleib, komm, "
               "heim, vis, invis, schau, log [ein|aus], snoop [ein|aus], "
               "merke [wen], "
               "tu [irgendwas] und status.");
            break;
        case "schau":
            command_me("schau");
            return;
            break;
        case "log":
            if (mufti!=GEBIETER_UID)
                break;
            if (sizeof(args)<2)
                return issue(mufti,"Derzeit schreibe ich "+
                  (sizeof(services["protocol"])
                  ?"nach '"+services["protocol"][0]+"' mit. "
                   +(file_size(DELILAH_LOG_DIR+services["protocol"][0])
                        ?"Meine Aufzeichnungen umfassen bereits "+
                        to_string(
                           file_size(DELILAH_LOG_DIR+services["protocol"][0]))
                           +" Zeichen."
                        :"")
                  :"nicht mit."));
            if (member((["ein","an","start","los"]),args[1]))
            {
                if (sizeof(services["protocol"]))
                    return issue(mufti,"Aber ich schreibe doch schon "
                      "nach '"+services["protocol"][0]+"' mit!");
                services["protocol"]+=([0:"delilah_"+to_string(time())+".log"]);
                command_me("sag Ich schreibe jetzt Protokoll.");
                save();
                return issue(mufti,"Okay, ich schreibe jetzt nach "
                      "'"+services["protocol"][0]+"' mit!");

            }
            if (member((["aus","stop","ende"]),args[1]))
            {
                if (sizeof(services["protocol"]))
                {
                    issue(mufti,"Okay, ich habe nach "
                      "'"+services["protocol"][0]+"' mitgeschrieben "
                      "und hoere jetzt auf.");
                    command_me("sag Ich hoere mit dem Protokollschreiben auf.");
                    services["protocol"]-=([0]);
                    save();
                    return;
                }
                return issue(mufti,"Aber... ich hab doch gar nicht "
                      "mitgschrieben?");
            }
            break;

        case "erwarte":
        case "erw":
        case "melde":
        case "merke":
            if (sizeof(args)<2)
            {
                if ((!member(services["waitfor"],mufti)) ||
                   (!sizeof(services["waitfor"][mufti])))
                   return issue(mufti,"Zur Zeit habe ich "
                        "dir niemanden fuer ein Gespraech vorgemerkt.");
                else
                   return issue(mufti,"Folgende Eintraege hat "
                   "meine Liste derer, die Du sprechen moechtest: " +
                   implode(map_array(m_indices(
                        services["waitfor"][mufti]),#'capitalize),", ")
                        +".");
            }
            args=args[1..];
            if (!member(services["waitfor"],mufti))
                services["waitfor"]+=([mufti:([])]);
            while (sizeof(args))
            {
                if (!member(services["waitfor"][mufti],args[0])) 
                {
                    if ( (!find_player(args[0])) ||
                            (!IS_LEARNER(mufti) && 
                            (find_player(args[0])->QueryProp(P_INVIS))))
                    {
                        issue(mufti,"Aber "+
                             capitalize(args[0])+" ist doch gar nicht da, "
                             "nutze da doch besser 'erwarte', mh?");
                    }
                    else
                    {
                        if (query_idle(find_player(args[0]))<10)
                            issue(mufti,"Aber "+
                                capitalize(args[0])+" ist doch gar nicht "
                                "idle - los, selbst ansprechen!");
                        else
                        {
                            issue(mufti,"Okay, "+
                                capitalize(args[0])+" wird vorgemerkt.");
                            services["waitfor"][mufti]+=([args[0]]);
                        }
                    }
                }
                else
                {
                    issue(mufti,"Okay, "+capitalize(args[0])+
                       " wird nicht mehr vorgemerkt.");
                    services["waitfor"][mufti]-=([args[0]]);
                    if (!sizeof(services["waitfor"][mufti]))
                        services["waitfor"]-=([mufti]);
                }
                args=args[1..];
                recalc_waitforlist();
                save();
            }
            return;
            break;

        case "snoop":
            if (mufti!=GEBIETER_UID)
                break;
            if (sizeof(args)<2)
                return issue(mufti,(member(services["snoop"],mufti)
                   ?"Derzeit lasse ich Dich an allem teilhaben, "
                     "was ich erlebe."
                   :"Was ich erlebe, das behalte ich derzeit fuer mich."));
            else
            {
                if (member((["ein","an","start","los"]),args[1]))
                {
                    if (member(services["snoop"],mufti))
                        return issue(mufti,
                           "Du bist doch schon live mit "
                            "dabei, was willst Du noch?");
                    services["snoop"]+=([mufti]);
                    save();
                    return issue(mufti,
                      "Okay, ich lasse Dich an meinen Erlebnissen teilhaben.");
                }
                if (member((["aus","stop","ende"]),args[1]))
                {
                    if (!member(services["snoop"],mufti))
                        return issue(mufti,
                           "Du wirst doch ohnehin nicht mit Details "
                            "aus meinem Leben beglueckt, oder?");
                    services["snoop"]-=([mufti]);
                    save();
                    return issue(mufti,
                       "Okay, ich behalte meine Erlebnisse wieder fuer mich.");
                }
            }
            return;
            break;
        case "vis":
        case "sichtbar":
            if (mufti!=GEBIETER_UID)
                break;
            if (!(QueryProp(P_INVIS)))
                return issue(mufti,
                    "Aber ich bin doch schon sichtbar.");
            else
            {
                SetProp(P_INVIS,0);
                environment()->Message(break_string(
                    Name(WER)+" wird sichtbar und tritt unauffaellig hinzu.\n",
                        77),
                    MSGFLAG_VISUAL,([MSGFLAG_EXCLUDE:({this_object()})]));
                return issue(mufti,
                    "Ich bin jetzt wieder sichtbar.");
            }
            break;
        case "invis":
        case "unsichtbar":
            if (mufti!=GEBIETER_UID)
                break;
            if (QueryProp(P_INVIS))
                return issue(mufti,
                    "Aber ich bin doch schon unsichtbar.");
            else
            {
                environment()->Message(break_string(
                    Name(WER)+" entfernt sich unauffaellig "
                    "und wird unsichtbar.\n",77),
                    MSGFLAG_VISUAL,([MSGFLAG_EXCLUDE:({this_object()})]));
                SetProp(P_INVIS,time());
                return issue(mufti,
                    "Ich bin jetzt unsichtbar.");
            }
            break;
        case "tu":
        case "tue":
        case "mach":
        case "x":
            if (mufti!=GEBIETER_UID)
                break;
            if (!command_me(regreplace(cmd,"^[^ ]* ","",1)))
                return issue(mufti, "Was? Das hat leider nicht geklappt.");
            return;
            break;
        case "gebieter":
        case GEBIETER_UID:
            if (!ob=find_player(GEBIETER_UID))
                return issue(mufti, "Mein Gebieter "+capitalize(GEBIETER_UID)+ 
                 " ist leider nicht da. Ich vermisse ihn auch... sehr.");
            answer="Mein Gebieter "+capitalize(GEBIETER_UID)+" ist ";
            if (ob->QueryProp(P_INVIS))
                answer+="gerade unsichtbar und ";
            if (query_idle(ob)<60)
                answer+="nicht idle, was mich persoenlich sehr freut. ";
            else
                answer+="ueber "+time2string("%x %X",query_idle(ob))+
                  " idle, schade. ";
            if (environment(ob) && (environment(ob)->QueryProp(P_INT_SHORT)))
            {
              answer+=
                capitalize((string)ob->QueryPossPronoun(MALE,WER,SINGULAR))+
                " Aufenthaltsort ist '"+
                (string)environment(ob)->QueryProp(P_INT_SHORT)+"'";
              if (environment()!=environment(ob))
                answer+=".";
              else
                answer+=", ich bin an "+
                ((string)ob->QueryPossPronoun(FEMALE,WEM,SINGULAR))
                   +" Seite.";
            }
            return issue(mufti, answer);
            break;
        case "folge":
            if (mufti!=GEBIETER_UID)
                break;
            if (!ob=find_player(mufti))
                break;
            if ((member((object*)(ob->QueryPursuers()),this_object())>=0) 
              || (member(services["follow"],mufti)))
                return issue(mufti, 
                   "Aber ich folge Dir doch schon ... ueberallhin.");
            ob->AddPursuer(this_object());
            services["follow"]+=([mufti]);
            save();
                return issue(mufti,
                   "Wo Du hingehst, werde auch ich hingehen.");
            break;
        case "warte":
        case "bleibe":
            if (mufti!=GEBIETER_UID)
                return;
            if (!ob=find_player(mufti))
                return;
            if ((member((object*)(ob->QueryPursuers()),this_object())<0)
                  && (!member(services["follow"],mufti)))
                return issue(mufti, 
                   "Aber ich folge Dir doch gar nicht...?");
            ob->RemovePursuer(this_object());
            services["follow"]-=([mufti]);
            save();
            return issue(mufti,
                   "Ich werde hier auf Dich warten...");
            break;
        case "komm":
        case "hier":
            if (mufti!=GEBIETER_UID)
                break;
            if (!ob=find_player(mufti))
                return;
            if (!environment(ob))
                return issue(mufti, "Erklaer mir mal, "
                    "wie Du Deine Umgebung losgeworden bist...");
            if ((move(environment(ob),M_TPORT)==1) ||
                (move(environment(ob),M_GO|M_NOCHECK)==1))
                return issue(mufti,"Hier bin ich, "
                    "zu Deinen treusten Diensten.");
            else
                return issue(mufti,"Ich... kann nicht zu Dir kommen.");
            break;
        case "geh":
        case "heim":
            if (mufti!=GEBIETER_UID)
                break;
            move(HOME_SWEET_HOME,M_GO|M_NOCHECK);
            issue(mufti, "Okay, ich bin nach Hause.");
            if (!ob=find_player(mufti))
                return;
            if (member((object*)(ob->QueryPursuers()),this_object())<0)
                return;
            ob->RemovePursuer(this_object());
            services["follow"]-=([mufti]);
            return issue(mufti, "Ich warte dort auf Dich.");
            break;
        default: break;
    }
    return issue(mufti,
       ({"Dunkel ist der Sinn Eurer Rede.",
         capitalize(mufti)+", bitte lenkt mich nicht ab.",
         "Darauf darf ich nicht eingehen.",
         "Ist das fuer Euch wichtig?",
         "Das ist ja hochinteressant!",
         "Ist das kompatibel?",
         "Ach... ja?",
         "Habt Ihr das auch ueberprueft?",
         "Das bekommt Ihr doch sicher alleine hin, oder?"
         })[random(9)]);

}

nosave string
validateMufti(string str)
{
    if (!this_player()) return 0;
    if (!interactive(this_player()))
    {
        if (this_player()!=this_object())
            issue(this_player(), "Meine Dienste stehen nur interaktiven "
                "Mitgliedern der Gesellschaft zur Verfuegung, tut mir leid. "
                "Wende Dich bitte an Deinen Regionsmagier, er wird sich um "
                "Dein Anliegen sicher gern kuemmern.");
        return 0;
    } 
    if (this_player()==this_interactive()) 
        return getuid(this_player());

    return 0;
}

nosave string
extractCommand(string raw)
{
    if ((!raw) || (!stringp(raw)) || (!strlen(raw))) 
        return 0;
    if (!sizeof(regexp(({raw}),"^[^:]* teilt Dir mit: ")))
        return 0;
    return regreplace(
        regreplace("\n"+raw[0..<2],"\n[^:]* teilt Dir mit: "," ",1)[1..],
            " \\[[0-9][0-9]:[0-9][0-9]\\]$","",1);

} 

public void 
catch_tell(string str)
{
    string cmd,mufti;

    string *snoopies;
    if (sizeof(services["protocol"]))
        write_file(DELILAH_LOG_DIR + services["protocol"][0],
           dtime(time())[6..] + " | "+str);

    snoopies=m_indices(services["snoop"]);

    while (sizeof(snoopies))
    {
        if (find_player(snoopies[0]))
            find_player(snoopies[0])->Message(ANSI_BOLD+ANSI_BLACK+"~"+
                regreplace(str,"\n","\n~",1)[0..<2]+ANSI_NORMAL);
        snoopies=snoopies[1..];
    }


    // command evaluation.

    if ((cmd=extractCommand(str)) && (mufti=validateMufti(str)))
        call_out("executeCommand",2,cmd,mufti);
}


public void 
More(string what)
{
    tell_object(this_object(),what);
}

public void 
Debug()
{
    printf("%O\n", _query_localcmds());
}

