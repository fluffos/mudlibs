#define HOME_SWEET_HOME ROOM "zypresse"
#define DELILAH_LOG_DIR DOVENYA "log/delilah/"
#define DELILAH_SAVE_FILE DOVENYA "save/delilah"

#define GEBIETER_UID "anatol"
#define GEBIETER "/magier:anatol"
#define GEBIETER_SECURITY   \
    (this_player() && this_player()==this_interactive() && \
    file_name(this_player())==GEBIETER)
#define DB(x)   if (find_player("anatol")) tell_object(find_player("anatol"),break_string(x,77,"Debug: ",1))


#define PERM_ALL 0
#define PERM_SEER 1
#define PERM_WIZARD 2
#define PERM_GEBIETER 3

mapping services;

private nosave string unparsed_args;
private nosave mapping impressed;
private nosave mapping waitforlist;
private nosave string env;
private nosave mapping completely_ignored_verbs;

nosave void issue(mixed target, string message);


nosave int 
cmdUnt(string what) 
{
    if (this_player()!=this_object()) return 0;
    unparsed_args=what;
    return _examine(what);
}

nosave int
cmdInv(string what)
{
    if (this_player()!=this_object()) return 0;
    unparsed_args=what;
    return _inventory(what);
}


nosave int 
cmdTell(string what) 
{
    int vis,res;
    string n;

    if (this_player()!=this_object()) return 0;
    unparsed_args=what;
    if (!QueryProp(P_INVIS))
        return _tell(what);
    else
    {
        vis=(int)QueryProp(P_INVIS);
        n=(string)QueryProp(P_NAME);
        SetProp(P_NAME,"("+n+")");
        SetProp(P_INVIS,0);
        res=_tell(what);
        SetProp(P_INVIS,vis);
        SetProp(P_NAME,n);
        return res;
    }
}

nosave int 
cmdSchau(string what) 
{
    if (this_player()!=this_object()) return 0;
    unparsed_args=what;
    return _look(what);
}

nosave int
cmdChannelParser(string what)
{
    if (this_player()!=this_object()) return 0;
    unparsed_args=what;
    return ChannelParser(what);
}

nosave int
cmdShoutToAll(string what)
{
    if (this_player()!=this_object()) return 0;
    unparsed_args=what;
    return _shout_to_all(what);
}

nosave int
cmdChannelAdmin(string what)
{
    if (this_player()!=this_object()) return 0;
    unparsed_args=what;
    return ChannelAdmin(what);
}

public string
_unparsed_args()
{
    return unparsed_args;
}

public void
save()
{
    save_object(DELILAH_SAVE_FILE);
}


nosave void
recalc_waitforlist()
{
    string * ind;
    waitforlist=([]);
    ind=m_indices(services["waitfor"]);
    while(sizeof(ind)) 
    {
        waitforlist+=services["waitfor"][ind[0]];
        ind=ind[1..];
    }
    return;
}

public void
init()
{
    ::init();
    if ((environment()) && (file_name(environment())!=env))
    {
            env=file_name(environment());
            catch_tell(sprintf("* '%s' [%s] *\n",
                (string)(environment()->QueryProp(P_INT_SHORT)), env));
    }
}

public void 
create() 
{
    seteuid(getuid(this_object()));

    if (is_clone(this_object())) 
    {
        destruct(this_object());
        return;
    }
    npc::create();
    "/std/player/comm"::create();

    impressed=([]);
    if (!restore_object(DELILAH_SAVE_FILE))
    {
        services=(["waitfor":([]),
                     "snoop":([]),
                  "protocol":([]),
                    "follow":([])
                ]);
