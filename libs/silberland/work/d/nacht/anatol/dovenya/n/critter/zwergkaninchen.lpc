/* Ein Zwergkaninchen.
 * ___________________________________________(i) Anatol@Silberland (2012) */


#pragma strict_types

#include "../../defines.h"
#include <properties.h>
#include <language.h>
#include <moving.h>
#include <combat.h>

inherit "std/npc";

public void 
create() 
{
    string col;
    if (!is_clone(this_object())) 
        return;
    ::create(); 

    col=({"hellbraun","braun","dunkelbraun","schwarz","gescheckt","dreifarbig",
            "weiss","quietschrosa"})[(random(2)+random(2)+random(2)+
                random(2)+random(2)+random(2)+(random(1000)?0:1))];
       
    
    SetProp(P_LONG, break_string(
        "Ist das nicht niedlich, ein Zwergkaninchen! Ja wo kommt das denn "
        "her? Es ist "+col+" und muemmelt, von Deiner Anwesenheit voellig "
        "unbeeindruckt, am Gras herum.",77));
    
    create_default_npc(1);
    set_living_name("kaninchen");

    AddAdjective(({"klein",col}));
    SetProp(P_SOUND,"Du vernimmst ein leises Muemmeln.\n");
    SetProp(P_SMELL,"Das Zwergkaninchen riecht ein wenig nach Kaninchen.\n");
    SetProp(P_NAME,"Zwergkaninchen");
    SetProp(P_NAME_ADJ,({"klein",col}));
    SetProp(P_SHORT,Name(WER));
    SetProp(P_REJECT,REJECT_DROP);
    SetProp(P_NAME_ADJ,({col}));
    AddId(({"FELL_WUSCHEL","kaninchen",
        "zwergkaninchen","\a\n\a\tol_zwergkaninchen"}));
    SetProp(P_ALIGN, 200);
    SetProp(P_RACE,"Kaninchen");
    SetProp(P_GENDER,NEUTER);
    AddInfo(DEFAULT_INFO,"haelt kurz inne, muemmelt dann aber weiter.\n");
    SetProp(P_HANDS,({" mit winzigen Kaninchenpfoten",5,DT_BLUDGEON}));
    SetProp(P_MAX_HANDS,0);
    SetProp(P_MURDER_MSG,"*muemmel!?*");
    SetProp(P_KILL_MSG,"*muemmel!?*");
    SetProp(P_DIE_MSG," faellt tot zu Boden.\nArmes Zwergkaninchen.\n");
    SetProp(P_MSGIN,"hoppelt herein");
    SetProp(P_MMSGIN,"hoppelt herein");
    SetChats(1, ({ "@@scrollMeUpPlease@@", }) );
}


public string 
scrollMeUpPlease() 
{
    object *os;
    object o;
    string s1, s0;

    os=filter_array(all_inventory(
        environment(this_object()))-({this_object()}), #'living);

    // Ja, das trifft auch "Jemands". Finde ich gut ;-)

    if (sizeof(os)) 
    {
        o=os[(random(sizeof(os)))];
        switch(random(5)) 
        {
            case 0:
                s0=sprintf("%s hoppelt auf der Suche nach einem besonders "
                "langen Grashalm um %s herum.",
                    this_object()->Name(WER),o->name(WEN));
                s1=sprintf("%s hoppelt um Dich herum, wohl auf der Suche "
                    "nach einem besonders langen Grashalm.",
                    this_object()->Name(WER));
                break;
            case 1:
                s0=sprintf("%s knabbert versehentlich an %s Zeh, bemerkt "
                "den Irrtum aber sofort und sucht stattdessen "
                "einen besonders langen Grashalm.",
                    this_object()->Name(WER),o->name(WESSEN));
                s1=sprintf("%s knabbert an Deinem Zeh. Scheint nicht zu "
                "schmecken, %s laesst naemlich recht schnell davon ab.",
                    this_object()->Name(WER),
                    this_object()->QueryPronoun(WER));
                break; 
            case 2:
                s0=sprintf("%s hoppelt %s ueber die Fuesse. Traut sich "
                "ganz schoen was!",
                    this_object()->Name(WER),o->name(WEM)),
                s1=sprintf("%s hoppelt Dir mutig ueber die Fuesse.",
                    this_object()->Name(WER));
                break; 
            case 3:
                s0=sprintf("%s muemmelt %s an.",
                    this_object()->Name(WER),o->name(WEM));
                s1=sprintf("%s muemmelt Dich an.",
                    this_object()->Name(WER));
                break; 
            default:
                s0=sprintf("%s hoppelt zweimal um %s herum.\n"
                        "%s bekommt fast einen Drehwurm.",
                    this_object()->Name(WER),o->name(WEN),o->Name(WER));
                s1=sprintf("%s hoppelt zweimal um Dich herum.\n"
                    "Beim Versuch, %s nicht aus den Augen zu verlieren, "
                    "wird Dir fast schwindelig.",
                    this_object()->Name(WER),
                    this_object()->name(WEN));
                break; 
        }
        environment()->Message(break_string(s0,77,0,1),
            MSGFLAG_VISUAL, ([MSGFLAG_EXCLUDE:({o})]));
        o->Message(break_string(s1,77,0,1));
    }
    return "";
} 

