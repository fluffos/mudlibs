  hat_geatmet=({});
  call_other(ROOM "susagep","???"); // Pegasus pingen
  ::reset();
  return;
}

void init() {
  ::init();
  call_other(ROOM "susagep","???"); // Pegasus pingen
}


varargs public string GetExits(object viewer) { return ""; }

nosave int cmdBetrete(string str) {
  string in,out;
  notify_fail("Ja, und was bitte moechtest Du betreten?\n");
  if ((!str)||(str=="")) return 0;
  notify_fail("Das kannst Du hier irgendwie nicht betreten.\n");
  if (member(({"hoehle","hoehleneingang","eingang"}),str)==-1) return 0;
  if (this_player()->QueryProp(P_FROG)) {
    in="huepft durch den Hoehleneingang herein";
    out="huepft in die Hoehle hinein. QUAK";
  }
  else {
    switch ((string)this_player()->QueryProp(P_RACE)) {
      case "Nachtelf":   
      case "Elf":   
      case "Ork":   
        in="kommt gebueckt von draussen herein";
        out="betritt gebueckt die Hoehle";
        write("Du bueckst Dich und betrittst die Hoehle.\n");break;
      case "Zwerg": 
        in="zwaengt sich leise grummelnd durch den Hoehleneingang herein";
        out="grummelt leise und zwaengt sich durch den Hoehleneingang";
        write("Du wirfst dem viel zu engen Eingang einen finsteren Blick zu "
           "und zwaengst\nDich dann doch (leise grummelnd) in die Hoehle.\n");
        break;
      case "Troll":
      case "Oger":
      case "Mensch":
        in="kommt, sich den Kopf haltend, von draussen herein";
        out="betritt die Hoehle, nicht ohne sich vorher den Kopf am niedrigen "
            "Hoehleneingang angeschlagen zu haben. Aua....";
        write("Du betrittst die Hoehle.\nAU! Das war dein Kopf. Naja, wird "
              "schon nicht so\nfurchtbar schlimm gewesen sein...\n");
        this_player()->reduce_hit_point(random(5));break;
      case "Goblin":
      case "Hobbit":
      case "Fee":
        in="spaziert aufrecht und grinsend herein";
        out="laechelt ein wenig spoettisch den Eingang an und betritt die "
            "Hoehle aufrecht und ein kleinwenig stolz. Der Eingang scheint "
            "fuer so kleines Volk wie geschaffen.";
        write("Hehe, ein Eingang, wie fuer Dich geschaffen.\nGrinsend "
            "betrittst Du die Hoehle.\n");break;
      default: 
        in="kommt von draussen herein";
        out="betritt die Hoehle";
        write("Du denkst Dir nicht viel und betrittst die Hoehle.\n");
    }
  }
  this_player()->move(ROOM "gang",M_GO,"",out, in);

  return 1;
}

nosave int cmdBeuge(string str) {
  notify_fail("Was genau willst Du tun?\n");
  if (str=="vor")  {
    write("Du lehnst Dich etwas vor und wirfst einen Blick nach unten.\n"
          "Wuah, Dir wird schwindelig, schnell trittst Du wieder zurueck.\n");
    say(break_string((string)this_player()->Name(WER)+
          " lehnt sich todesmutig vor, um einen Blick nach unten zu werfen. "
          "Kreidebleich ob der schwindelnden Hoehe tritt " +
          (string)this_player()->QueryPronoun(WER)+ 
          " wieder von der Kante zurueck.\n",77));
    return 1;
  }
  return 0;
}


nosave int cmdKletter(string str) {
  write("Urploetzlich siehst Du ein, dass Du hier nirgendwohin klettern "
   "kannst,\nes ist ganz einfach viel zu gefaehrlich.\n");
  return 1; 
}

nosave string detailZeit() {
  return (dtime(time())+"\n");
}

nosave int cmdSuche(string was) {
  if ((!was) || (was=="")) return 0;
  if (!this_player()) return 0;
  switch (was) {
    case "weg":
    case "wege":      
      write("Du suchst, findest aber nichts.\nHast Du tatsaechlich erwartet," 
       " Du wuerdest hier soetwas wie\neinen WEG finden?!\n");return 1;break;
    case "nichts":
      if (IS_WIZARD(this_player())) return 1; // Unterschied muss sein (:o)
      this_player()->command_me("finger nichts"); return 1;break;
    default: return 0;
  }
} 

public int NotifyNewPlayerInRoom(object player) {
  object * interactives;
  object loser;
  if ((!player) || (!objectp(player)) || (!query_once_interactive(player)))
    return 0; 
  if ((getuid(this_object()))!=(getuid(previous_object()))) return 0;
  interactives= filter_array(all_inventory(this_object()), #'interactive);
  if (sizeof(interactives)>MAX_PLAYER_CONTENT) {
    loser=interactives[(random(time())%sizeof(interactives))];
    tell_object(loser,break_string("Mist, Dich hat es natuerlich erwischt!\n"+
      (string)player->Name(WESSEN)+
      " heftiger Kegler schubst Dich halb stolpernd, "
      "halb fallend, in die Hoehle hinein.",77));
    loser->move(ROOM "gang",M_GO,"","wird von "+
      (string)player->name(WESSEN)+" Stoss in die Hoehle geschubst",
      "stolpert - nein faellt - mit einem unterdrueckten Aufschrei durch "
      "den Hoehleneingang herein");   
  }
  return 1;
}

nosave int specialNorden() {
  return cmdBetrete("hoehle");
}
