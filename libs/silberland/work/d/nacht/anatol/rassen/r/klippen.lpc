
/* Rassenwechsel: In den Klippen. 
 * Geographischer Anschluss fuer den Rassenwechsel.
 * ____________________________________(i) Anatol@Silberland (1999-2012) */

#pragma strict_types

#define MAX_PLAYER_CONTENT   3


#include <wizlevels.h>
#include <properties.h>
#include <moving.h>
#include "../defines.h"

inherit STD "room";

string * hat_geatmet;


// closured, benoetigt Vorwaertsdeklaration

nosave string detailBart();
nosave string soundGeschichte();

public int prevent_shadow(object o) { return 1; }

public void create() {

  ::create();

  hat_geatmet=({});

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS,0);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:22,ENV_TERRAIN:TT_MOUNTAIN]));
  SetProp(P_INT_SHORT, "In den Klippen");
  SetProp(P_INT_LONG,
   "Du stehst auf einem kleinen Absatz in einer rauhen und unueberschaubaren "
   "Felswand, unter Dir hoerst Du die nie aufgebende Brandung der See gegen "
   "die naechtlichen Klippen rollen. Sacht spielt der Wind traeumend mit "
   "Deinen Haaren, weht angenehm kuehle Meeresluft behutsam in Dein Gesicht, "
   "verschafft Dir eine milde Erfrischung. Eine Hoehle, aus der warmes Licht "
   "heraus in die Nacht leuchtet, fuehrt in die Felswand hinein.");
  
  AddSpecialExit("norden","specialNorden");

  Sky();
  
  AddSmell(DEFAULT_SMELL,
      "Der Wind traegt den Geruch des Meeres mit sich.");
  AddSmell(({"geruch","sehnsucht"}),
      "Der feine Wuerze des Meeres weckt in Dir die Sehnsucht nach dessen "
      "unendlichen Weite, nichts moechtest Du lieber als hinaus auf das "
      "Meer...");
  AddDetail(({"felsabsatz","absatz","platz"}),
    "Du befindest Dich auf einem kleinen unebenen Absatz in der Felswand. "
    "Sehr viele Leute werden hier vermutlich nicht Platz finden, aber es "
    "scheint fuer Dich ja momentan zu reichen. Umrandet wird der Platz von "
    "einem (ziemlich niedrigen) Grat, so dass nicht alles, was nicht mehr "
    "aufrecht stehen kann, in die Tiefe stuerzt.");
  AddDetail("boden",
    "Der Boden ist trocken und staubfrei, der stete Wind laesst wohl kein "
    "bisschen Dreck liegen, in dem Saat kleiner Pflaenzchen haette aufgehen "
    "koennen. Kleine Unebenheiten sind zwar noch vorhanden, aber alles in "
    "allem ist der Boden sehr glatt.");
  AddDetail(({"unebenheit","unebenheiten"}),
    "Der Boden ist hier ziemlich "
    "uneben, niemand scheint ihn glatt gehauen zu haben... nur der Wind "
    "schliff stetig ueber die Felsen und polierte den unebenen Boden.");
  AddDetail(({"felsenkueste","felswand","wand"}),
    "Oh-oh... so weit Du schauen kannst - Fels, Fels, Fels. Auch wenn das "
    "Licht der Sterne nicht reichlich ist, so kannst Du doch noch erkennen, "
    "dass sich die rauhe Felswand sowohl nach links als auch nach rechts "
    "kilometerweit auszudehnen scheint. Du meinst auch, eine leichte "
    "Kruemmung erkennen zu koennen - weswegen Dein Auge auch nach wenigen "
    "Kilometern nichts mehr ausmachen kann - und der Gedanke, dass Du Dich "
    "auf einer Insel befinden koenntest, setzt sich langsam in Dir fest.");
  AddDetail("kilometer","Naja, verhaeltnismaessig weit eben...");
  AddDetail("kruemmung",
    "Sie ist wohl daran schuld, dass Dein Auge nicht "
    "noch weiter blicken, noch mehr Felsenkueste sehen kann...");
  AddDetail("dreck","Nichts, aber auch gar nichts. Der Boden ist hier "
    "vom Wind blitzeblank geweht, kein Staeubchen liegt hier herum. Das ist "
    "vielleicht ganz gut, wer weiss, wieviel Dreck dieser Vogel, der hier "
    "wohl ab und zu herumsitzt, verursacht...");
  AddDetail("staeubchen","Nichtmal das.");
  AddDetail("pflaenzchen",
    "Hier gibt es nichtmal Saat, aus der ein "
    "Pflaenzchen wachsen koennte... wie soll es dann ein Pflaenzchen geben");
  AddDetail("saat",
    "Hier ist keine Saat, was sollte sie auch hier?");
  AddDetail("gedanke",
    "Hm, grade hattest Du noch einen Gedanken gefasst,"
    "doch er scheint Dir wieder entglitten zu sein...");
  AddDetail(({"insel","gegend"}),
    "Hmmmm, also richtig ueberzeugend wirkt "
    "die 'Gegend'  nicht - zum einen, weil Du nicht viel davon siehst, zum "
    "anderen, weil die Insel, wenn sie eine ist, dann doch recht gross "
    "waere...");
  AddDetail("brandung",
    "Du kannst die Brandung von hier oben nicht sehen - Du muesstest Dich "
    "sehr weit ueber den Rand lehnen, und das waere nicht ganz "
    "ungefaehrlich.");
  AddDetail("klippen",
    "Die Klippen sind irgendwo weit unter Dir, Du hoerst die See gegen sie "
    "branden, siehst sie jedoch nicht. Du muesstest Dich gefaehrlich weit "
    "ueber den Rand des Absatzes vorbeugen, um nach unten sehen zu koennen.");
  AddDetail("wind",
    "Sacht, fast zaertlich, streicht der Wind liebevoll ueber Dein Gesicht, "
    "kuehlt Dir die erhitzten Wangen, erfrischt Deinen von Abenteuern "
    "ermuedeten Geist.");
  AddDetail("geist","Ein wirklich SEHR geistreiches Detail.");
  AddDetail("detail","Du untersuchst auch die groesste Sinnlosigkeit...");
  AddDetail("sinnlosigkeit","Argl.");
  AddDetail("argl","ERROR: (line 1093) detail overflow error ");
  AddDetail("wangen","Warum sind Deine Wangen nur so rot...?");
  AddDetail(({"abenteuer"}),"Na, schon alleine hierher zu kommen, war ein "
    "Abenteuer...");
  AddSpecialDetail(({"schopf","haar","haare"}),"detailHaare");
  AddSpecialDetail(({"luft","meeresluft"}),"detailLuft");
  AddSpecialDetail("gesicht","detailGesicht");
  AddDetail(({"frische","erfrischung"}),
    "Das ist der kuehle Wind, der hier oben stetig und doch nicht zu heftig "
    "um die Felsen streicht. Seine kuehle Frische tut Dir bestimmt gut.");
  AddDetail("hoehle",
    "Wie diese Hoehle wohl entstanden ist? Du vermagst es nicht zu sagen..."
    "ihr Eingang ist verhaeltnismaessig niedrig und schmal und sieht so aus, "
    "als ob die Naturgewalten ihn schufen - ein Lebewesen legte nicht Hand "
    "an ihn. Du koenntest die Hoehle vermutlich betreten (dann gaebe es hier "
    "draussen auch etwas mehr Platz).");
  AddDetail("hand",
    "Das ist Deine Hand.");
  AddSmell("wuerze",
    "Hmmmmmmmm..... das Meer....");
  AddDetail("lebewesen","Nein, eben nicht.");
  AddDetail(({"naturgewalt","naturgewalten"}),
    "Wie muss die See hier getobt haben, als sich diese Insel aus den nassen "
    "Stuermen gen Himmel hob, wie sehr muss der Wind um die Felsen "
    "gepeitscht haben...");
  AddDetail(({"sturm","stuerme"}),
    "Also das bisschen Wind gerade kann man bestimmt nicht 'Sturm' nennen, "
    "bei einem richtigen Sturm waerst Du vermutlich schon auf den Klippen "
    "zerschmettert und ins Meer gespuelt worden.");
  AddDetail("eingang",
    "Der Eingang zur Hoehle ist nicht gerade sehr hoch und auch nicht "
    "sonderlich breit. Falls sie bewohnt ist (liegt zumindest irgendwie "
    "nahe), wird der oder die Bewohner bestimmt nicht grosswuechsig sein.");
  AddDetail("bewohner",
    "Du machst irgendetwas falsch, vielleicht solltest Du Deine "
    "Forscherstrategie aendern...");
  AddDetail("forscherstrategie","Eben.");
  AddDetail("prinzessin",
    "Es ist leider keine hier, um irgendwelche Vergleiche machen zu "
    "koennen, schade...");
  AddDetail(({"vergleiche","vergleich"}),
    "Lies mal _genauer_, es ist KEINE Prinzessin hier, also gibt es auch "
    "KEINE VERGLEICHE.");
  AddDetail(({"keine vergleiche","kein vergleich"}),
    "Du bist wirklich unvergleichlich...");
  AddDetail(({"fels","felsen"}),
    "Leicht roetlich schimmern die Felsen der Wand im Licht des vollen "
    "Mondes und der funkelnden Sterne. Ein geuebter Kletterer vermag "
    "vielleicht, auf und ueber sie zu klettern, auf der Suche nach neuen "
    "Wegen, doch die Weite der Felswand verurteilt dieses Unterfangen "
    "erbarmungslos zum Scheitern.");
  AddDetail(({"scheitern","versuch"}),
      "Du wuerdest den Versuch, ueber die Felswand zu klettern, nicht "
      "ueberleben.");
  AddDetail("weite",
    "Weit, so weit Dein Auge sehen kann, zieht sich die naechtliche "
    "Felswand nach links und rechts, ein bisschen verloren kommst Du Dir "
    "hier schon vor, denn ebenso weit zieht sich der funkelnde "
    "Sternenhimmel von Horizont zu Horizont...");
  AddDetail("auge","Huch, das siehst Du nicht!");
  AddDetail("kletterer",
    "Da ist kein Kletterer, so lebensmuede ist wohl "
    "keiner. Nicht einmal ein irrer Magier wuerde sich das trauen.");
  AddDetail("magier","Nein, auch solche nicht.");
  AddDetail(({"weg","wege"}),
    "Hier kannst Du lange Wege suchen, finden "
    "wirst Du bestimmt keine, Du befindest Dich ja auf einem Felsabsatz in "
    "einer ziemlich grossen Felswand ueber dem Meer.");
  AddDetail("suche","Du wirst nichts finden.");
  AddDetail("glanz",
    "Er ruht auf auf den Felsen wie eine magische Aura "
    "einen Zauberer zu umgeben scheint, geheimnisvoll und unwirklich.");
  AddDetail("aura",
    "Aber es ist keine Aura. Es ist nur das Sternenlicht, welches auf "
    "den Felsen wiederspiegelt.");
  AddDetail("zauberer",
    "Es ist wohl grade kein Zauberer hier, also was willst Du!?");
  AddDetail("leute",
    "Damit sind die Personen gemeint, die sich hier aufhalten. Viele "
    "haben hier naemlich nicht Platz...");
  AddDetail("personen","Ja, genau die.");
  AddDetail(({"gelaender","grat","rand"}),
    "Etwa einen Fuss ist der Rand, das rettende Gelaender, welches Tier und "
    "Frosch vor dem sicheren Tod schuetzen soll. Es macht einen ziemlich "
    "zerkratzen Eindruck.");
  AddDetail(({"fuss"}),"Damit stehst Du auf dem Boden.");
  AddDetail("frosch","QUAK, keiner da.");
  AddDetail("tod","Sei froh, wenn Du ihn noch nicht kennengelernt hast...");
  AddDetail("eindruck","Der Rand macht einen zerkratzen Eindruck.");
  AddDetail("kratzer",
    "Die Kratzer koennten von sehr grossen Krallen eines ebenso sehr "
    "grossen Vogels (oder so) stammen.");
  AddDetail("tiefe",
    "Du wirfst vorsichtig einen Blick nach unten und siehst weit weit unten "
    "die glitzernden Reflexionen des Mond- und Sternenlichts auf der etwas "
    "unruhigen See.");
  AddDetail("krallen","Krallen? Welche Krallen?");
  AddDetail(({"voegel","vogel"}),"Hmmm, Du siehst hier keine Voegel...");
  AddDetail("tier","Tier? Kann schon sein.");
  AddDetail(({"reflexionen","reflexion"}),
    "Bezaubernd und einfach maerchenhaft schoen spiegelt die weite See die "
    "Sterne und den Mond wieder, glitzernd und funkelnd wie ein Meer aus "
    "geschliffenen Diamanten, ewige Ruhe und Unendlichkeit ausstrahlend, "
    "fast so wie das Original, am Himmel.");
  AddDetail("original",
    "Das Meer kann nur wiedergeben, was der Himmel von sich zeigt.");
  AddDetail(({"sinnbild","unendlichkeit"}),
    "Du koenntest die Unendlichkeit nicht in endlicher Zeit untersuchen, "
    "daher laesst Du dieses hoffnungslose Unterfangen dann doch "
    "lieber bleiben.");
  AddSpecialDetail("zeit","detailZeit");
  AddDetail("unterfangen","Erbarmungslos. Hoffnungslos.");
  AddDetail(({"diamant","diamanten"}),
    "Diamantengleich funkeln die Sterne vom Firmament herab, wie ein Meer "
    "aus Diamanten spiegeln sie sich auf der unsteten Wasseroberflaeche "
    "des Meeres.");
  AddDetail(({"see","meeresoberflaeche","wasseroberflaeche","meer"}),
    "Du blickst hinaus auf das Meer, welches in der scheinbaren Dunkelheit "
    "der Nacht blitzt und funkelt, den Himmel wiedergibt in seiner "
    "bezaubernden Art, von Horizont zu Horizont erstreckt sich das "
    "Grosse Wasser.");
  AddDetail("horizont",
    "Dort, wo sich Himmel und Wasser vereinen, dort, wo das Firmament das "
    "Meer liebkost, beruehrt, dort, wo Dein Blick endet, dort ist der "
    "Horizont.");
  AddDetail("wasser",
    "Das Wasser ist ziemlich weit unter Dir, das Rauschen der Brandung "
    "dringt gerade noch an Dein Ohr.");
  AddDetail("ohr",
    ([ 0:"Das ist Dein Ohr.\n",
       "elf":"Das ist Dein Ohr, es ist ein wenig spitz geformt, aber das "
             "steht Dir\nwirklich ausgezeichnet.\n",
       "zwerg":"Du suchst ein wenig unter Deinem zerzausten Schopf, kneifst "
             "auf Verdacht\neinfach mal in... JAAAA, da ist Dein Ohr!\n",
       "mensch":"Kurzer Griff - Jawoll, Ohr ist noch da!\n",
       "hobbit":"Du tastest eben nach Deinem Ohr... ungewaschen zwar, aber"
             " es ist\nnoch dran.\n" ]) );
  AddDetail("verdacht", "Jetzt bloss keinen Verdacht erregen...\n");
  AddDetail("rauschen","Rauschen? Lauschen!\n");
  AddDetail("blick","Du blickst es nicht...\n");
  AddDetail("griff","Einen Griff siehst Du hier nicht.\n");
  AddDetail("reize","Du sollst mit Deinen Reizen nicht geizen.\n");
  AddDetail("dunkelheit",
    "Es ist nicht wirklich dunkel, es ist Nacht... doch die Sterne leuchten, "
    "tauchen Dich und alles andere in ein unwirklich wirkendes Licht, so "
    "dass auch Du hier genug sehen kannst.");
  AddDetail("alles andere","Du hast wohl ein Triller unter'm Pony?");
  AddDetail("pony", "WO SIEHST DU HIER EIN PONY?");
  AddDetail("triller", "Du hast. Ganz sicher. Du hast.");
  AddDetail(({"leuchten","licht","mondlicht","sternenlicht"}),
    "Das Licht hier kommt hauptsaechlich vom Mond, der bleich vom Himmel "
    "auf Dich herabstrahlt, von den Sternen, welche ... hach, ist das "
    "schoen ...");
  AddDetail(({"vollmond","mond"}),
    "Vollkommen rund strahlt er vom Himmel herab, sein Gesicht zernarbt vom "
    "unendlichen Alter erweckt in Dir den Eindruck eines schon immer "
    "existierenden Wesens, welches von oben dem hastigen Treiben der Welt "
    "zusieht.");
  AddSpecialDetail("alter","detailAlter");
  AddDetail("wesen",
    "Du entscheidest Dich dafuer, dass der Mond doch nicht lebendig ist. "
    "Auch wenn er schon sehr lange existiert. Oder gerade weil?");
  AddDetail("treiben",
    "Wie ist die Welt doch hektisch, niemand geniesst mehr die Ruhe, die "
    "Stille, den inneren Frieden, den man nur durch Ruhe finden kann...");
  AddDetail(({"frieden"}),
    "Herrlich, warum kann es nicht ueberall so friedlich sein...?\n");
  AddDetail("welt","error 341: global stack overflow.\n");
  AddDetail(({"ruhe","stille"}),
    "Bis auf das leise und ferne Rauschen der Brandung ist es hier oben in "
    "der Regel sehr still.");
  AddDetail("regel","... aber jetzt bist ja Du da.");
  AddDetail(({"nacht","beweis"}),
    "Es ist Nacht hier, der Sternenhimmel und die glitzernde See sind "
    "Beweis genug, solche Naturschoenheiten sieht man nur des Nachts...");
  AddDetail(({"natuerschoenheit","naturschoenheiten"}),
    "HMPF, _Du_ bist jedenfalls keine. Naturschoenheiten untersuchen nicht "
    "jeden Mist.");
  AddDetail("mist","q.e.d.");
  AddDetail("art",
    "Nein, auf die Art kommst Du hier nicht weiter. Warst Du inzwischen "
    "schonmal in der Hoehle? Nein? Dann mach' mal etwas sinnvolles und "
    "schau rein, es wird Dich schon niemand beissen...");
  AddSound(DEFAULT_SOUND,
    "Du vernimmst leise das Rauschen der Brandung, die irgendwo tief unter "
    "Dir den ewigen Kampf mit dem Festland ficht. Du hoerst auch den "
    "sanften Wind, der hier oben stetig um die Felsen weht, vertraeumt "
    "saeuseln.");
  AddSound(({"brandung","rauschen"}),
    ([0:"Du hoerst leise die Brandung rauschen.",
      "elf":"Das Tosen und Beben der Brandung erfuellt Dich mit Sehnsucht "
          "nach dem Meer, den unendlichen Weiten der See. Auch als echtes "
          "Waldwesen kann man von den Reizen der Wasser gefangen werden...",
      "zwerg":"Ganz, ganz leise, rauscht da unten irgendwas.",
      "hobbit":
           "Hm, da unten muss wohl Wasser sein. Bier waer' Dir lieber."]));
  AddSound(({"tosen","beben"}),
    ([0:"Du musst Dich verhoert haben...",
     "elf":"Maechtig muss die Brandung sein, wenn sie so die Klippen "
           "beben laesst."]));
  AddSound("see","Die See ist zwar unruhig, aber sie ist doch leise.");
  AddSound(({"wind","saeuseln"}),
    ([0:"Der Wind saeuselt Dir etwas ins Ohr.",
     "elf":"Leise fluestert Dir der Wind Geschichten von Deiner fernen "
           "Heimat zu, bestaendig, nie enden wollend...",
     "hobbit":"Der Wind saeuselt um Deinen Wuschelkopf.",
     "zwerg":"Frech verfaengt sich der Wind mit einem zagen Rauschen in "
           "Deinem Bart, schadenfroh zu kichern scheinend."]));
  AddSound(({"heimat","geschichte","geschichten"}),
    ([0:"Du musst Dich verhoert haben.",
    "elf":#'soundGeschichte]));
  AddDetail("bart",
    ([0:"Hm, DAS soll ein Bart sein?",
     "elf":"Schonmal einen Elf mit Bart gesehen? Na guuuut, aber es ist "
           "nicht gerade typisch, oder?",
     "hobbit":"Naja, ein bisschen Bart vielleicht..",
     "zwerg":#'detailBart]));
  AddDetail(({"elf","waldwesen"}),
     ([0:"Du nicht.",
       "elf": "Du."]));
  AddDetail("wuschelkopf","Das sind Deine Haare.");
  AddDetail("geroell",
      "Du kannst von hier aus leider nichts erkennen. Aber vielleicht "
      "ist das auch ganz gut so...");
  AddDetail("nachtvogel",
      "Du kannst ihn nirgendwo entdecken.");
  AddDetail("festland","Du befindest Dich offenbar auf irgendeinem Festland, "
      "oder zumindest auf einer sehr grossen Insel.");
  AddSound("scharren",
      "Hm, es hat wieder aufgehoert.");
  AddDetail("schlangenlinien",
      "Ob das Gluehwuermchen etwas getrunken hatte? Oder war es "
      "liebestrunken? Oder fliegen Gluehwuermchen immer so?");
  AddDetail("thema","Vergiss es.");
  AddDetail("liebe",
      "Argh. Ok, Du hast es nicht anders gewollt, warum untersuchst Du "
      "auch sowas. Was erwartest Du jetzt eigentlich? Irgendetwas sinnvolles "
      "zum Thema Liebe? Tut mir leid, da faellt mir selbst eigentlich nichts "
      "dazu ein. Aber ich kann ja mal aus einem etwas aelteren Buch zitieren, "
      "in der Hoffnung, dass es Deine wilden Forschereskapaden befriedigt.\n"
      "\"Liebe ist geduldig und freundlich. Sie kennt keinen Neid, keine "
      "Selbstsucht, sie prahlt nicht unt ist nicht ueberheblich. Liebe ist "
      "weder verletzend noch auf sich selbst bedacht, weder reizbar noch "
      "nachtragend. Sie freut sich nicht am Unrecht, sondern freut sich, wenn "
      "die Wahrheit siegt. Diese Liebe ertraegt alles, sie glaubt alles, sie "
      "hofft alles und haelt allem stand.\"");
  AddDetail("buch","Ein wirklich altes Buch.");
  AddDetail(({"forschereskapade","forschereskapaden"}),
      "Und, war es Dir genug?");
  AddDetail(({"neid","selbstsucht","unrecht","wahrheit"}),
      "Du bist nicht intelligent genug.");
  AddDetail("hoffnung",
      "Noch hast Du sie nicht aufgegeben.");
  AddSound("trommelschlagen",
      "Es hoerte sich zumindest so an, doch inzwischen ist es wieder ruhig.");
  AddDetail("schatten",
      "Hm, Du kannst nichts erkennen.");
  AddDetail("ecke","Hier hat es viele Ecken, Du moechtest eigentlich gar "
      "nicht nachsehen.");
  AddSound("kampf",
      "Der Kampf braust und tost, gewaltige Kraefte scheinen am Werk.");
  AddDetail(({"werk","kraft","kraefte"}),
      "Von hier oben? Ist nicht.");
  AddSound("piepsen",
      "Da war doch was! Aber Du hast keine Ahnung, was es gewesen sein "
      "koennte...");
  AddDetail("ahnung","Keine.");
  AddDetail("gluehwuermchen",
      "Es ist inzwischen wieder weg.");
  AddSound("schrei",
      "Der Schrei des Nachtvogels verhallte inzwischen wieder.");


  AddCmd(({"kletter","klettere"}),"cmdKletter");
  AddCmd(({"betret","betrete","betritt"}),"cmdBetrete");
  AddCmd(({"such","suche"}),"cmdSuche");
  AddCmd(({"beug","lehne","beuge","lehn"}),"cmdBeuge");

  AddRoomMessage(({
 "Von fern dringt der heisere Schrei eines einsamen Nachtvogels "
     "an Dein Ohr.\n",
 "Irgendetwas huscht irgendwo rechts ueber die Felsen.\n",
 "Ein Schatten huscht, begleitet von leisem Piepsen, in irgendeine Ecke.\n",
 "Von irgendwoher vernimmst Du ein kurzes Scharren.\n",
 "Ein Gluehwuermchen fliegt, wohl auf der Suche nach seiner grossen Liebe,\n"
 "in ausschweifenden Schlangenlinien an Dir vorbei und verschwindet "
     "wieder.\n",
 "Da, war das nicht fernes Trommelschlagen? Nein, es koennte auch \n"
 "rutschendes Geroell gewesen sein... oder?\n"
  }),700,0);
   
  SetStupids(({"grosse","jawoll","das","sehr"}));
  SetFailMessages(({"Nichts zu finden.\n",
                    "Du bist Dir sicher... nein.\n",
		    "Das siehst Du hier, leider, nicht.\n"}));
  SetProp(P_GEMA,({0,-3,0}));
  call_other(ROOM "susagep","???"); // Pegasus pingen
}

nosave int atmeMal(string player) {
  if (member(hat_geatmet,player)==-1) {
    hat_geatmet+=({player});
    return 1;
  }
  else
    return 0;
}

nosave string detailAlter() {
  if (!this_player()) return "";
  return sprintf("Dir schwebt ploetzlich ein hohes Alter vor Augen:\n%s!\n"
    "Wer wohl so alt sein mag...?\n",
    (time2string("%d %D, %h %H, %m %M, %s %S",time()-825634800)));
}

nosave string detailHaare() {
  if (!this_player()) return "";
  say(break_string((string)this_player()->Name(WER)+
     " greift sich ploetzlich in die "
     "Haare, macht dann aber einen beruhigten Eindruck.",77));
  return "Du greifst Dir in die Haare und stellst fest, dass sie noch in "
     "groesserer\nZahl vorhanden zu sein scheinen.\n";
}

nosave string detailBart() {
  if (!this_player()) return "";
  say((string)this_player()->Name(WER)+" streicht sich andaechtig durch "+
     (string)QueryPossPronoun(this_player())+" Bart.\n"
     "Welch Alter, welch Weisheit strahlt "+(string)this_player()->Name(WER)+
     " nur aus...!\n");
  return "Du streichst Dir andaechtig durch deinen verfil... aeh, "
     "samtweichen Bart.\nEs sieht wirklich sehr souveraen und weise aus, "
     "Du solltest diese Geste\nwirklich weiter ueben!\n";
}


nosave string soundGeschichte() {
  if (!this_player()) return "";
  say((string)this_player()->Name(WER)+
      " macht ein andaechtiges Gesicht und seufzt dann wehmuetig.\n");
  return break_string("Der Wind erzaehlt von Baeumen, gruen und edel in "
      "einem grossen Forst, von Blumen und Graesern... er fluestert Dir "
      "ferne Gesaenge und Weisheiten zu... Du geraetst wehmuetig ins "
      "Traeumen.",77);
}

nosave string detailGesicht() {
  if (!this_player()) return "";
  say(break_string((string)this_player()->Name(WER)+
     " hat wohl Angst, das Gesicht "
     "zu verlieren... jedenfalls kannst Du Dir "+
     (string)this_player()->QueryPossPronoun(NEUTER,WEN,SINGULAR)+
     " unauffaelliges Gesicht-abtasten nicht anders erklaeren.\n",77));
  return "Unauffaellig tastest Du Dein Gesicht ab - es ist noch da.\n";
}

nosave string detailLuft() {
  if (!this_player()) return "";
  if (!atmeMal(file_name(this_player())))
    write("Du atmest tief ein und geniesst die frische Luft.\n");
  else {
    write("Du atmest tief ein und spuerst, wie die frische Luft Deine "
      "Lungen fuellt,\nDeine Lebenskraft regeneriert, Deinen Geist schaerft. "
      "Aaaaah...\n");
    this_player()->heal_self(random(40)+40);
  }
  return "";
}

