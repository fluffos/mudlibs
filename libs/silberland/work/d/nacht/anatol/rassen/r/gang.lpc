
/* Ein Gang.
 * ____________________________________(i) Anatol@Silberland (1999-2012) */

#pragma strict_types

#include <wizlevels.h>
#include <properties.h>
#include <moving.h>
#include "../defines.h"

inherit STD "room";

public void create() {

  ::create();

  SetProp(P_LIGHT, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:24,ENV_TERRAIN:TT_CAVE]));
  SetProp(P_INDOORS,1);
  SetProp(P_INT_SHORT, "In einem kleinen Gang");
  SetProp(P_INT_LONG,
   "Das kleine Gangstueck hier hat, Dank sei Dusty, tatsaechlich zwei "
   "Ausgaenge und endet nicht in einer Sackgasse. Waehrend es nach "
   "Sueden offenbar in absolute Finsternis geht, fuehrt der Weg nach "
   "Norden durch ein Portal in Licht und Waerme. Links neben dem Portal "
   "fuehrt eine kleine und unscheinbare Stiege in eine kleine Kammer.");

  AddDetail("waerme",
      "Dort, in diesem warmen Lichte, dort scheint es auch waermer zu "
      "sein.");
  AddDetail("sackgasse",
      "Entgegen weniger optimistischer Erwartungen bist Du hier "
      "nicht in einer Sackgasse gelangt.");
  AddDetail(({"erwartungen","erwartung"}),
      "Hier eine Sackgasse zu erwarten, kann nicht gerade optimistisch "
      "genannt werden.");
  AddDetail("meter",
      "Ein ganzes Stueck eben.");
  AddDetail("stueck",
      "So genau kannst Du es nicht abschaetzen.");
  AddDetail(({"eile","zeit"}),
      "Du hast zwar nicht alle Zeit der Welt, aber in Eile bist Du "
      "auch nicht.");
  AddDetail("welt",
      "Die Welt ist gross, ziehe aus in sie und erforsche sie!");
  AddSpecialDetail(({"herrin","dusty","dank"}),"detailDusty");
  AddDetail("gangstueck",
      "Der Gang ist nicht gerade sehr lang. Wie Dir erst jetzt auffaellt, "
      "macht er genau dort, wo Du stehst, einen kleinen Doppelknick, so "
      "dass man wirklich nur hier sowohl den Ausgang ins Licht als auch "
      "den in die Finsternis erkennen kann.");
  AddDetail(({"handwerk","arbeit"}),
      "Was auch immer, es sieht nach guter Arbeit aus.");
  AddDetail("doppelknick",
      "Eventuell moechte jemand verhindern, dass von aussen zugeschaut "
      "werden kann, was dort drinnen passiert.");
  AddDetail("finsternis", "Im Sueden ist es ziemlich dunkel.");
  AddDetail(({"ausgang","ausgaenge"}),
      "Du koenntest nach Sueden in die Finsternis gehen - oder nach "
      "Norden in die helle Halle.");
  AddDetail("decke",
   "Die Decke besteht aus dunklem Fels und ist hier einige Meter ueber Dir.");
  AddDetail("boden",
      "Glatt von Tausenden und Abertausenden Schritten, die gegangen wurden, "
      "ein hohes Ziel vor Augen, liegt der dunkle Fels unter Dir, wie er "
      "schon seit langer, langer Zeit dort verweilt hat." );
  AddDetail("ziel",
      "Der Weg ist das Ziel, doch am Ende des Weges wartet der Lohn fuer "
      "die Muehen.");
  AddDetail("ende",
      "Dein Ende droht hier nicht.");
  AddDetail("lohn","Warte es ab?");
  AddDetail(({"muehe","muehen"}),
      "Ist der Lohn diese Muehen wert?");
  AddDetail(({"tausende","abertausende"}),
      "Unzaehlbar viele Schritte wurden hier schon getan.");
  AddDetail(({"schritt","schritte"}),
      "Glatt von vielen, vielen Schritten liegt der Fels unter Dir.");
  AddSpecialDetail("augen","detailAugen");
  AddDetail(({"wand","waende"}),
      "Die Waende wirken makellos sauber, obschon sie aus dunklem Fels "
      "bestehen. Wer auch immer diesen Gang angelegt hat, er verstand "
      "sein Handwerk.");
  AddDetail("fels",
      "Der Fels ist matt und dunkel, seine Geheimnisse und Geschichten "
      "fuer sich behaltend gibt er den Weg nach Norden und Sueden frei.");
  AddDetail(({"geheimnis","geheimnisse"}),
      "So sehr Du Dich auch bemuehst, die Waende bleiben Dir verschlossen.");
  AddDetail("geschichten",
      "Diese Waende zeichnen sich durch Abwesenheit von Hoehlenmalereien "
      "aus, erzaehlen ihre Geschichten also weder auf offensichtlicher "
      "Art - noch Dir.");
  AddDetail("art","Eine Dir nicht bekannte Art, wenn ueberhaupt.");
  AddDetail(({"abwesenheit","hoehlenmalerei","hoehlenmalereien"}),
      "Leere Waende starren Dich an, als Du sie anstarrst.");
  AddDetail("gang",
      "Der kurze Gang fuehrt von Norden nach Sueden und umgekehrt. Der "
      "Weg nach Norden fuehrt ins Licht, der nach Sueden in die totale "
      "Finsternis.");
  AddDetail(({"weg","gefuehl"}),
      "Du hast das Gefuehl, dass Du ziemlich genau weisst, wo Du hinwillst.");
  AddDetail("licht",
      "Noerdlich von Dir scheint eine groessere Halle zu sein, sie ist "
      "offenbar hell erleuchtet.");
  AddDetail("halle",
      "Du kannst nichts naeheres erkennen, Du wirst schon durch das "
      "Portal gehen muessen...");
  AddDetail("portal",
      "Das Portal ist eigentlich nur ein schlichter Bogen, ganz ohne Tuer "
      "und Tor.");
  AddDetail("tor", "Kein Tor da.");
  AddDetail("tuer", "Keine Tuer da.");
  AddDetail(({"bogen","torbogen"}),
      "Selbst der Torbogen ist schlicht und verzierungslos.");
  AddDetail(({"paladine","paladin"}), "Oh ja, die Paladine! Edel und gut!");
  AddDetail("segen","Dafuer bist Du hier einfach falsch.");
  AddDetail("macht","Die Macht Dustys ist unvorstellbar gross.");
  AddDetail("gutes","Aeh?");
  AddDetail("maul","Schwaebisch.");
  AddSound(DEFAULT_SOUND,
      "Aus dem Norden glaubst Du leise Gesaenge zu hoeren.");
  AddSound(({"gesang","gesaenge"}),
      "Du strengst Dich an, kannst aber nichts genaues verstehen.");
  AddSmell(DEFAULT_SMELL,
      "Die frische Luft aus dem Sueden scheint hier sacht hereinzuziehen.");
  AddSmell("luft",
      "Sie riecht ok, kein bisschen muffig!");
  AddDetail("schatten",
      "Vielleicht hast Du Dich auch getaeuscht.");

  AddDetail("stiege",
      "Die Stiege fuehrt schraeg nach unten und endet, soweit das von "
      "hier genau erkennbar ist, offenbar in einer kleinen spartanisch "
      "eingerichteten Kammer.");
  AddDetail("kammer",
      "Du kannst sie von hier aus nicht genau erkennen, jedenfalls scheint "
      "sie nicht (oder so gut wie nicht) eingerichtet zu sein. Irgendwas "
      "erhellt sie, mehr erkennst Du nicht.");
  // Wir sind auch GAR nicht polarisierend, gell? :o)
  AddExit("sueden", 
      ([EX_DEST:ROOM "klippen",
        EX_PLMSG:"Mutig gehst Du nach draussen in die Dunkelheit.\n",
        EX_MSG:"in die Finsternis"]));
  AddExit("norden", 
      ([EX_DEST:ROOM "halle",
        EX_PLMSG:"Ehrfurchtsvoll durchschreitest Du das Portal.\n",
        EX_MSG:"in das Licht"]));
  AddExit("nordwestunten", 
      ([EX_DEST:ROOM "kammer",
        EX_PLMSG:"Vorsichtig kletterst Du in die kleine Kammer.\n",
        EX_MSG:"nach unten in die kleine Kammer"]));
  AddExit("nwu", 
      ([EX_DEST:ROOM "kammer",
        EX_PLMSG:"Vorsichtig kletterst Du in die kleine Kammer.\n",
        EX_MSG:"nach unten in die kleine Kammer"]));
  AddExit("raus", 
      ([EX_DEST:ROOM "klippen",
        EX_PLMSG:"Mutig gehst Du nach draussen in die Dunkelheit.\n",
        EX_MSG:"in die Finsternis"]));

  SetProp(P_HIDE_EXITS,({"nwu","raus"}));

  SetStupids(({"guten"}));
  SetFailMessages(({"Sowas siehst Du hier nicht. Ist sicher nicht wichtig.\n",
                    "Nicht zu entdecken.\n",
		    "Eben ... nein, das siehst Du hier nicht.\n"}));


  SetProp(P_GEMA,({0,-2,0}));

}

nosave string detailAugen() {
  if (!this_player()) return "";
  write("Tu' Dir nicht weh dabei.\n");
  this_player()->reduce_hit_point(random(5)+2);
  return "Graaaad mach I's Maul zu.\n";
}

nosave string detailDusty() {
  if (!this_player()) return "";
  if ((string)this_player()->QueryProp(P_GUILD)=="paladine")
    return break_string(
        "Ja, lobet und preiset Herrin Dusty! Moege IHR Segen auf "
        "allem Guten liegen und IHRE Macht vernichten, was boese ist!",77);
  else
    return "So richtig begreifen werden das wohl nur Paladine.\n";
}
