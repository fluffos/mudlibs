/* Eine Kammer. Hier werden Spieler gequittet. :)
 * ____________________________________(i) Anatol@Silberland (1999-2012) */

#pragma strict_types

#include <wizlevels.h>
#include <properties.h>
#include <moving.h>
#include "../defines.h"

inherit STD "room";

public void create() {

  ::create();

  SetProp(P_LIGHT, 1);
  SetProp(P_ENVIRONMENT, ([ENV_TEMPERATURE:24,ENV_TERRAIN:TT_CAVE]));
  SetProp(P_INDOORS,1);
  SetProp(P_INT_SHORT, "Eine kleine Kammer");
  SetProp(P_INT_LONG,
   "Diese Kammer ist ueberaus spartanisch eingerichtet. Waende, "
   "Decke und Boden sind zwar sorgfaeltig behauen, aber ungestrichen. "
   "Keinerlei Einrichtung - abgesehen von einer trueben Kerze rechts "
   "neben der Stiege, die in einen Gang fuehrt, ist hier tatsaechlich "
   "nichts. Oed und leer: Welchen Zweck diese Kammer auch haben mag, "
   "wohnen will hier niemand.");
  AddDetail("einrichtung",
    "Es gibt hier keine Einrichtung. Nix, der Raum ist karg, oede, leer "
    "nackich, trist, spartanisch, unmoebliert, ...");
  AddDetail(({"fels","felsen"}),
    "Du siehst tatsaechlich ueberall Fels. Hier ist keine Wand gestrichen, "
    "auch Boden und Decke sind unbehandelt und nur behauener Fels. Das "
    "allerdings geschah offenbar mit Sorgfalt - die Flaechen sind schoen "
    "eben.");
  AddDetail(({"sorgfalt","flaechen"}),
    "Alle Flaechen wurden sehr sorgfaeltig behauen und sind schoen eben.");
  AddDetail("zweck",
    "Also wohnen will hier sicher niemand.");
  AddSound(DEFAULT_SOUND,
      "Totenstille.");
  AddSmell(DEFAULT_SMELL,
      "Die Luft ist trocken und nicht besonders frisch.");
  AddDetail("luft",
      "Du kannst die Luft nicht sehen, aber sie richt nicht frisch.");
  AddSmell("luft",
      "Die Luft riecht nicht frisch.");
  AddSound("totenstille",
      "Du hoerst rein gar nichts.");
  AddDetail(({"kammer","raum"}),
      "Der Raum ist nicht sonderlich gross, vielleicht drei auf drei "
      "Schritte. Wozu auch immer diese Kammer dienen mag, geraeumig "
      "ist sie so wenig wie einladend.");
   AddDetail(({"licht","kerze","stueck"}),
      "Die Kerze brennt truebe vor sich hin. Sie ist (vermutlich) zur "
      "Haelfte abgebrannt... ist aber, seit Du hier bist, nicht auch "
      "nur ein winziges Stueck kleiner geworden. Seltsam...");
   AddDetail("haelfte", "D  s e s  n r  i  H l t .");
   AddDetail("gang",
   	"Du kannst den Gang von hier aus nicht erkennen, das truebe "
	"Licht der Kerze genuegt leider, um Deine Augen zu blenden.");
   AddDetail("stiege",
        "Die Stiege ermoeglicht Dir, in den Gang zu gelangen. Ansonsten "
	"ist sie ziemlich trist und lieblos in den Fels gehauen.");
   AddDetail("boden",
        "Die Kammer ist offenbar aus dem Fels gehauen. Der Boden ist "
	"recht eben, aber nicht poliert. Es gibt keine Fugen, Ritzen, "
	"Loecher - nichts, worin etwas verloren gehen kann.");
   AddDetail(({"fuge","fugen","ritze","ritzen","loch","loecher"}),
        "Wuerde jemand Wasser in diese Kammer giessen, es waere in "
	"dreitausend Jahren noch hier. Keine Fugen, Ritzen, Loecher, "
	"gar nix.");
   AddDetail("wasser","Soetwas siehst Du hier nicht.\n(Welch ein Glueck!)\n");
   AddDetail("decke",
       "Die Decke ist die unscheinbarste Decke ueberhaupt. Glatt, "
       "ungestrichen, ... unscheinbar.");
  AddDetail(({"wand","waende"}),
       "Abgesehen von dem bestueckten Kerzenhalter rechts neben dem "
       "Ausgang sind die Waende oed und leer.");
  AddSpecialDetail("ausgang","GetExits");
  AddDetail("kerzenhalter",
       "Der Kerzenhalter ist eigentlich mehr eine kleine Felsnase, "
       "auf welcher eine Kerze steht.");
  AddDetail(({"nase","felsnase"}),
       "Die Felsnase steht gerade genug aus der Wand hervor, um einer "
       "Kerze Platz zu bieten.");
  AddDetail("schritte","Du siehst keine Schritte.");
  AddSound("schritte","Du hoerst keine Schritte.");
  AddSmell("schritte","Du riechst keine... sach ma, gehts noch?!");

  AddDetail("platz","Du hast hier nicht viel Platz.");
  AddDetail("glueck","Du waerst echt nicht gluecklich, waere "
       "hier alles voller Wasser. Das koennte naemlich nirgendwohin "
       "abfliessen und wuerde der Luft, die Du so gerne atmest, "
       "den Platz streitig machen.");

  // Wir sind auch GAR nicht polarisierend, gell? :o)
  AddExit("raus", 
      ([EX_DEST:ROOM "gang",
        EX_PLMSG:"Du steigst die Stiege hoch in den Gang.\n",
        EX_MSG:"in den Gang"]));
  AddExit("suedostoben", 
      ([EX_DEST:ROOM "gang",
        EX_PLMSG:"Du steigst die Stiege hoch in den Gang.\n",
        EX_MSG:"in den Gang"]));
  AddExit("soob", 
      ([EX_DEST:ROOM "gang",
        EX_PLMSG:"Du steigst die Stiege hoch in den Gang.\n",
        EX_MSG:"in den Gang"]));

  SetProp(P_HIDE_EXITS,({"raus","soob"}));

  SetStupids(({"jahren"}));
  SetFailMessages(({"Zu trist hier, um das zu untersuchen.\n",
                    "Das siehst Du hier leider nicht.\n",
                    "Nicht zu entdecken.\n",
		    "Eben ... nein, das siehst Du hier nicht.\n"}));
  SetProp(P_GEMA,({-2,-1,0}));
}

public void init() {
  ::init();
  if ( (this_player()) 
     &&  (environment(this_player()) == this_object())) {
     if (file_name(this_object())==((string)this_player()->QueryProp(P_START_HOME)))  {
       printf("\n\nWillkommen zurueck... %s\n",
          (strlen((string)(this_player()->QueryProp(P_RACE)))
	    ?(string)(this_player()->QueryProp(P_RACE))
	    :"Wesen"));
       this_player()->SetProp(P_START_HOME,0);
     }
  }
}

