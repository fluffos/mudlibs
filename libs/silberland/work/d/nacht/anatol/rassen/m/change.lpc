/* proxy fuer privilegierte Aufrufe, daher paranoia-Style
 * - /secure/master->set_player_object(player,shell)
 * - /obj/infomaster->InfoMsg(message)
 * ____________________________________(i) Anatol@Silberland (1999-2012) */


#define STATIC_PATH_FRAGMENT "/d/nacht/anatol/rassen/r/vc/wechsel"

nomask public int set_player_object(string pl, string sh) {
  string* fn;
  return
    ( 
      (  (process_call()) 
      || (sh[0..11]!="/std/shells/")
      || (file_size(sh+".lpc")<=0)
      || (!stringp(pl)) 
      || (!objectp(this_player()))
      || (find_player(pl)!=this_player())
      || (!objectp(previous_object())) 
      || (sizeof(fn=explode(file_name(previous_object()),":"))!=2)
      || (fn[0] != STATIC_PATH_FRAGMENT)
      || (fn[1] != pl)
      ) 
      ?  0
      : (int)call_other("/secure/master","set_player_object",pl,sh) 
   );
}


nomask public void send_notification_to_guild(string guild, string race, string pl) {
  string* fn;
  if  (!(  (process_call()) 
      || (!stringp(pl)) 
      || (!stringp(guild)) 
      || (!stringp(race)) 
      || (!objectp(previous_object())) 
      || (sizeof(fn=explode(file_name(previous_object()),":"))!=2)
      || (fn[0] != STATIC_PATH_FRAGMENT)
      || (fn[1] != pl)
      ))
    catch(call_other(guild,"NotifyPlayerRaceChange",pl,race));
}

nomask public void send_notification_to_info_channel(string message) {
  string* fn;
  if  (!(  (process_call()) 
      || (!stringp(message)) 
      || (!objectp(previous_object())) 
      || (sizeof(fn=explode(file_name(previous_object()),":"))!=2)
      || (fn[0] != STATIC_PATH_FRAGMENT)
      ))
    catch(call_other("/obj/infomaster","InfoMsg",message));
}

nomask public void send_notification_to_newspaper(mixed posting) {
  string* fn;
  if  (!(  (process_call()) 
      || (!pointerp(posting)) 
      || (sizeof(posting)!=6) 
      || (!objectp(previous_object())) 
      || (sizeof(fn=explode(file_name(previous_object()),":"))!=2)
      || (fn[0] != STATIC_PATH_FRAGMENT)
      ))
    catch(call_other("/secure/news","WriteNote",posting,1));
}

