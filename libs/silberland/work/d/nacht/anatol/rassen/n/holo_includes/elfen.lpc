/*
 * Die Beschreibungen der Feen ist noch unvollstaendig.
 */

#include <properties.h>
inherit "std/thing/description";

void customize_elfen() {

  AddId(({"elf","elfen",}));
  SetProp(P_NAME,"Abbild zweier Elfen");
  SetProp(P_SHORT,"Das Abbild zweier Elfen");
  SetProp(P_LONG,
      "Das sollten wohl zwei Elfen werden, aber ausser (durchaus "
      "verheissungsvoll-ahnsehnlichen) Konturen ist nichts zu erkennen. "
      "Offenbar ist dieser Eintrag in der Datenmatrix des Tempels der "
      "Magie der Wandlung schon etwas aelter... und wurde zu oft "
      "veraendert.");
  
  AddDetail(({"kontur","konturen"}),
      "Man erkennt die Proportionen des weiblichen Elfs sehr deutlich.");

}
