/*
 * Die Beschreibungen der Feen ist noch unvollstaendig.
 */

#include <properties.h>
inherit "std/thing/description";

void customize_dunkelelfen() {

  AddId(({"dunkelelf","dunkelelfe","dunkelelfen",}));
  SetProp(P_NAME,"Abbild zweier Dunkelelfen");
  SetProp(P_SHORT,"Das Abbild zweier Dunkelelfen");
  SetProp(P_LONG,
      "Woha, offenbar hatte jemand 'emotionale' Vorbehalte gegenueber "
      "den Dunkelelfen. Das Hologramm stellt jedenfalls kein Dunkelelfen-"
      "Paerchen dar, sondern... mh, eine Ziege?");
  
  AddDetail(({"ziege","zicke"}),
      "Tatsaechlich. Eine Ziege. Was hinreichend schade ist, eine "
      "spaerlich bekleidete Dunkelelfe waer sicher ein exotischer "
      "Blickfang gewesen.");

}
