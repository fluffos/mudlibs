/* hologramm, customizable
 * ____________________________________(i) Anatol@Silberland (1999-2012) */


#pragma strict_types

#include "../defines.h"
#include "properties.h"
#include "new_skills.h"
#include "moving.h"
#include "combat.h"
#include SYS "npc.h"

inherit STD "npc";

inherit NPC "holo_includes/nachtelfen";
inherit NPC "holo_includes/oger";
inherit NPC "holo_includes/hobbits";
inherit NPC "holo_includes/menschen";
inherit NPC "holo_includes/zwerge";
inherit NPC "holo_includes/feen";
inherit NPC "holo_includes/trolle";
inherit NPC "holo_includes/elfen";
inherit NPC "holo_includes/dunkelelfen";


private nosave int customized;

void create() {
  customized=0;
  if (!is_clone(this_object()))
    return;
  ::create();
  create_default_npc(1);
  SetProp(P_NAME,"Abbild zweier Gestalten");
  SetProp(P_SHORT,"Das Abbild zweier Gestalten");
  SetProp(P_LONG,break_string(
    "Irgendwie sehen diese materielose Gestalten nach gar nichts aus. Grossartig.",77));
  AddId(({"\a\n\a\tol_hologramm","abbild","abbilder","gestalten","projektion",
      "gestalt","hologramme","hologramm","paerchen"}));

  SetProp(P_ARTICLE,1);
  SetProp(P_GENDER,NEUTER);
  SetProp(P_NPC_QUIET,([
        QUIET_MSG:"Diese substanzlosen Abbilder antworten nicht.",
        QUIET_FLAG:1]));
  SetProp(P_XP,0);
  SetProp(P_NOATTACK,"kann mangels Substanz bedauerlicherweise nicht angegriffen werden.\n");
  SetProp(P_MSGIN,"erscheint lautlos");
  SetProp(P_MSGOUT,"verschwindet lautlos");
  SetProp(P_MAX_HP,SetProp(P_HP,1));
}


int Customize(string str) {
  if (!str) 
    return 0;

  switch (str) {
    case "feen": 
      customize_feen();
      break;
    case "oger": 
      customize_oger();
      break;
    case "nachtelfen": 
      customize_nachtelfen();
      break;
    case "hobbits": 
      customize_hobbits();
      break;
    case "menschen": 
      customize_menschen();
      break;
    case "zwerge": 
      customize_zwerge();
      break;
    case "trolle": 
      customize_trolle();
      break;
    case "elfen": 
      customize_elfen();
      break;
    case "dunkelelfen": 
      customize_dunkelelfen();
      break;
    default:
      return 0;
  }
  return customized=1;
}

string long() {
  return QueryProp(P_LONG);
}


void give_notify(object given) {
  write("Genauso gut koenntest Du versuchen, Rauch in "
     "einen Schraubstock zu spannen.\n");
  given->move(environment(this_object()),M_PUT|M_NOCHECK);
}
