/*
 * Die Beschreibungen der Zwerge.
 */

#include <properties.h>
inherit "std/thing/description";

void customize_zwerge() {

  AddId(({"zwerge"}));
  SetProp(P_NAME,"Abbild zweier Zwerge");
  SetProp(P_SHORT,"Das Abbild zweier Zwerge");
  SetProp(P_LONG,
      "Zwei Zwerge, auf den ersten Blick nicht anhand Geschlecht, sondern "
      "anhand des Schmutzes voneinander zu unterscheiden. Beide Zwerge "
      "sind etwa vier Fuss hoch, von sehr kraeftiger Gestalt und verbergen "
      "ihr Gesicht in einem langen Bart. Waehrend der linke Zwerg - rote "
      "Haare und graue Augen - homogen verdreckt ist, ja von einer richtigen "
      "Schmutzwolke umgeben zu sein scheint, ist der rechte Zwerg - schwarze "
      "Haare, gruene Augen - mit Blut und Matsch verspritzt. Beide Kameraden "
      "sind bewaffnet.");

  AddDetail("blut",
      "Das Blut an einem Zwerg ist, das ist gaengige Faustregel, nur "
      "sehr selten sein eigenes.");

  AddDetail("matsch",
      "Der Matsch an einem Zwerg ist, das ist gaengige Faustregel, nur "
      "sehr selten sein eigener. Vielmehr entstanden die Spritzer beim "
      "Aufschlagen der Gegner auf dem Boden.");

  AddDetail(({"augen","augenfarbe"}),
      "Der linke Zwerg hat Augen von grauer Farbe, der Augen des rechten Zwergs "
      "funkeln gruen unt dessen schwarzen Haare hervor.");

  AddDetail(({"haarpracht","haarfarbe","haare","haar"}),
      "Die Haar- und Bartfarbe der Zwerge ist trotz der Verschmutzung  klar "
      "identifizierbar. Der Zwerg links hat rote, fast feuerrote Haare, der "
      "rechte Zwerg eine matt-schwarze Haarpracht. Beide sehen eher "
      "ungekaemmt aus.");

  AddDetail(({"bart","bartpflege","baerte"}),
      "Beide Baerte sind konstvoll geflochten, der linke Zwerg hat kleine "
      "Knochen in seinen Bart geflochten - kulturell vielleicht nicht "
      "unumstritten - waehrend der Bart des rechten Zwergs ohne Schmuck "
      "ist, dafuer bedeutend feiner Flechtungen aufweist. Jener Bart "
      "scheint unter den Matsch- und Blutspritzern einen seidigen Glanz "
      "zu haben - eine besondere Bartpflege, die vornehmlich bei weiblichen "
      "Zwergen zum Einsatz kommt.");

  AddDetail("glanz",
     "Boese Zungen behaupten, dass der Glanz eines Zwergenbarts ein direktes "
     "Mass fuer die Weiblichkeit eines Zwergs ist. Je glaenzender der Bart, "
     "desto eher ist der Zwerg weiblich.");

   AddDetail("weiblichkeit",
     "Die Zugehoerigkeit zu einem bestimmten Geschlecht besitzt fuer einen "
     "Zwerg untergeordnete Bedeutung. Clan, Freundschaft und nicht zuletzt "
     "gewisser Status steht klar im Vordergrund.");

   AddDetail(({"waffe","waffen"}),
     "Ah - das erklaert es. Die Bewaffnung des linken Zwergs ist eine "
     "Spitzhacke, als Vorlage fuer dieses Abbild diente offenbar ein Kamerad, "
     "der eben von Bergwerksarbeiten zurueckkehrte - das erklaert auch den "
     "mineralen Schmutz, in welchen der Zwerg gehuellt ist. Der rechte "
     "Zwerg stuetzt sich auf eine riesige Streitaxt, die ebenso "
     "blutverspritzt ist wie der Zwerg selbst.");

   AddDetail(({"schmutz","schmutzwolke","staub"}),
     "Der linke Zwerg ist voller mineralem Schmutz, der rechte zeigt "
     "deutliche Spuren des Kampfes. Wenn sich daraus etwas schliessen "
     "laesst - dann vermutlich, dass die sprichwoertliche Unsauberkeit "
     "von Zwergen weniger in einem Mangel an Hygiene begruendet sind, "
     "sondern an besonderem Engagement, gleich wo und wie: Unter Tage "
     "und auf dem Felde gleichermassen bringt ein Zwerg von Stand und "
     "eher immer vollen Einsatz.");

   AddDetail(({"kleidung"}),
     "Beide Zwerge tragen traditionelle Farben, der rechte Zwerg ist "
     "jedoch traegt einen verschrammten Panzer ueber einem leichten "
     "Kettenhemd, waehrend der linke in gehaertetem Leder gekleidet ist. "
     "Dass sie beide baren Hauptes sind, ist vermutlich dem Anlass "
     "geschuldet.");

}
