/*
 * Die Beschreibung der Hobbits kommt von Feyaria, Februar 1999
 */

#include <properties.h>
inherit "std/thing/description";

void customize_hobbits() {
  AddId(({"hobbits"}));
  SetProp(P_NAME,"Abbild zweier Hobbits");
  SetProp(P_SHORT,"Das Abbild zweier Hobbits");
  SetProp(P_LONG,
      "Ganz offensichtlich handelt es sich bei den beiden Gestalten "
      "um Halblinge. Wie ihr Name schon sagt, sind sie halb so gross wie "
      "Menschen, also ca. 1 Meter. Beide haben krauses, braunes Haar, "
      "freundliche blaue Augen und eine leicht gebraeunte Haut. "
      "Ihre Figur ist eher rundlich.");
  SetProp(P_SIZE,100);

  AddDetail("augen",
      "Die Augen dieser beiden Hobbits sind dunkelblau, aber auch braune "
      "Augen sind bei Halblingen realtiv haeufig.");
  AddDetail(({"haare","kopfhaar", "locken"}),
      "Beide Hobbits haben krauses, braunes Haar, welches bei ihr in "
      "zierlichen Locken offen bis zu den Schultern herabhaengt, bei ihm "
      "dagegen wesentliche kuerzer und ziemlich zerzaust ist.");
  AddDetail(({"ohr","ohren"}),
      "Die Ohren kann man unter den Haaren nur erahnen.");
  AddDetail( ({"figur"}),
      "Beide Hobbits haben schmale Schultern und duenne Arme, dafuer sind "
      "die nackten Fuessen und der rundliche Bauch umso groesser.");
  AddDetail( ({"schultern", "schulter"}),
      "Hobbits haben meist sehr schmale Schultern; sie gehoeren ja nicht "
      "gerade zu den Kraftprotzen.");
  AddDetail( ({"arme", "arm"}),
      "Hobbits haben meist sehr duenne Arme; sie gehoeren ja nicht "
      "gerade zu den Kraftprotzen.");
  AddDetail( ({"fuesse", "fuss"}),
      "Die Fuesse von Hobbits sind immer sehr dicht behaart und mit einer "
      "dicken Hornschicht auf der Sohle ausgestattet, sodass sie bei "
      "normalem Wetter keine Schuhe tragen. Das ist auch einer der Gruende, "
      "warum sich Halblinge so lautlos bewegen koennen. Verglichen mit ihrer "
      "Koerpergroesse sind ihre Fuesse riesig gross, sie erreichen "
      "benahe die Groesse der doppelt so grossen Menschen.");
  AddDetail( ({"bauch"}),
     "Fast alle Hobbits haben einen rundlichen Bauch, der von ihrer Liebe "
     "zu gutem Essen zeugt. Es gilt als Wohlstandsmerkmal, wenn der Bauch so "
     "dick ist, dass man im Stehen die eigenen Fuesse nicht mehr sehen kann.");
  AddDetail(({"gesicht","gesichter"}),
      "Das Gesicht eines Hobbit wird von dem runden, meist freundlich "
      "laechelden Mund dominiert. Zwischen den ausmerksamen Augen befindet "
      "sich die meist sehr kleine Nase. Obwohl Halblinge eine starke "
      "Koeperbehaarung haben, findet sich kein einziges Haar im Gesicht, nur  "
      "der Hobbitmann hat einen leichten Flaum auf den Schlaefen.");
  AddDetail( ({"bart", "flaum"}),
      "Der leichte Flaum auf den Schlaefen des Hobbits is der einzige "
      "Hinweiss auf einen Bart. Erstaunlich, dass die sonst so stark "
      "behaarten Halblinge im Gesicht ueberhaupt keine Haare haben.");
  AddDetail(({"nase","nasen"}),
      "Die meisten Hobbits haben fuer ihr breites Gesicht eine sehr kleine "
      "Nase.");
  AddDetail(({"mann", "hobbitmann", "ihn"}),
      "Der Hobbitmann unterscheidet sich vor allem durch die kurzen, eher "
      "ungepflegten Haare und den leichten Flaum auf dem Schlaefen von ihr. "
      "Er traegt wie sie die typische Kleidung eines Hobbits.");
  AddDetail(({"frau", "hobbitfrau", "sie"}),
      "Die Hobbitfrau hat zierliche Locken und ist nur unwesentlich "
      "schmaeler als er. Sie traegt die typische Kleidung einer Hobbitfrau.");
  AddDetail(({"kleidung"}),
      "Beide Hobbits tragen die typische Kleidung ihres Volkes, die vor "
      "allem Bequemlichkeit bieten soll. Er traegt ein blau-weiss "
      "gestreiftes Hemd und sie eine weisse, mit vielen Spitzen verzierte "
      "Bluse. Er treagt eine Pluderhose aus dunkelgruenem Stoff und sie "
      "einen langen, braunen Rock. Die dichtbehaarten Fuesse sind "
      "unbedeckt. Der Hobbitmann hat einen dicken Schafspelzmantel "
      "umgehaengt und einen Wanderstab in der Hand. Die Hobbitfrau ist "
      "wohl mit einem Dolch bewaffnet, denn ein kleiner Griff ragt aus dem "
      "bund ihres Rockes heraus.");
  AddDetail( ({"hemd", "bluse"}),
      "Hobbits tragen meist ein Hemd oder eine Bluse aus weichem Stoff. "
      "An Farben findet man fast jede moegliche Kobination, hauptsaechlich "
      "aber helle, freundliche Toene. Waehrend die Hemden der Maenner oft "
      "sehr schlicht sind, sind die Blusen der Frauen oft mit Spitzen oder "
      "anderem Tand verziert.");
  AddDetail( ({"hose", "hosen", "pluderhose", "pluderhosen"}),
      "Hobbitmaenner tragen meist weite Hosen, die ihren Bauch nicht "
      "einschnueren. Vor allem Pluderhosen sind sehr beliebt.");
  AddDetail( ({"rock"}),
      "Fast alle Hobbitfrauen tragen lange Roecke. Es wurden zwar schon "
      "Frauen in Hosen erblickt, aber dies gilt bei den Halblingen "
      "nach wie vor als unschicklich.");
  AddDetail( ({"mantel", "schafspelzmantel", "pelzmantel"}),
      "Fuer die kuehleren Tage besitzen fast alle Halblinge einen dicken "
      "Pelzmantel. Auch bei warmen Wetter wird er oft mit herumgetragen um "
      "als Decke bei einem improvisierten Picknick zu dienen.");
  AddDetail( ({"schuhe"}),
      "Schuhe tragen Halblinge nur, wenn es draussen sehr kalt ist oder "
      "bei Regen.");
  AddDetail( ({"stab", "wanderstab"}),
      "Da Hobbits gerne Wandern (vor allem bis zum naechsten Wirtshaus), "
      "besitzen viele von ihnen einen Wanderstab.");
  AddDetail( ({"dolch"}),
      "Dolche sind die bevorzugte Waffe von Halblingen.");
}
