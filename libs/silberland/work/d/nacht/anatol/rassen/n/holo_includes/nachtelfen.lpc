
#include <properties.h>
inherit "std/thing/description";

void customize_nachtelfen() {

  AddId("nachtelfen");
  SetProp(P_NAME,"Abbild zweier Nachtelfen");
  SetProp(P_SHORT,"Das Abbild zweier Nachtelfen");
  SetProp(P_LONG,
      "Ganz offensichtlich handelt es sich bei den beiden Gestalten "
      "um Nachtelfen. Der Nachtelf ist mit etwa 1.65 etwa eine Spanne "
      "groesser als die weibliche Gestalt neben ihm und wirkt auch ein "
      "bisschen kraeftiger, beide jedoch haben die charakteristische "
      "zierliche Figur, spitzen Ohren, kirschrote Haare und gruen bis "
      "golden funkelnde Augen.");

  AddDetail("augen",
      "Die Augen der Nachtelfen funkeln gruen bis goldgelb unter "
      "der wildkirschroten Haarpracht hervor. Sie wirken mal sanft, "
      "mal verspielt, passend zur kleinen, fast stupsigen Nase.");
  AddDetail(({"haare","haarpracht"}),
      "Die Haare haben eine etwas eigenwillige Farbe - wildkirschrot, "
      "wuerdest Du sagen. Fuer gewoehnlich traegt eine Nachtelfin die "
      "Haare sehr lang, der Nachtelf die seinen nicht ueber Schulterlaenge, "
      "was aber nichts heissen mag.");
  AddDetail(({"ohr","ohren"}),
      "Wie bei jeder Elfenart sind auch die Ohren der Nachtelfen spitz. "
      "S\"u/3!");
  AddDetail("figur",
      "Die Figur der Nachtelfin ist zierlich, dennoch aber durchaus... "
      "wohlgeformt, durchaus mit Rundungen versehen. Der Nachtelf wirkt "
      "entgegen allen Geruechten tatsaechlich durchaus maennlich, macht "
      "aber keinen ueberdurchschnittlich kraeftigen Eindruck, besitzt also "
      "wie auch seine weibliche Gefaehrtin mehr zierliche Anmut als "
      "Koerperkraft.");
  AddDetail(({"gesicht","gesichter"}),
      "Die nachtelfischen Gesichtszuege wirken im Allgemeinen sanft und "
      "erwecken im Betrachter den Eindruck, ein sehr einfuehlsames Wesen "
      "vor sich zu haben, was normalerweise auch durchaus der Wahrheit "
      "entspricht.");
  AddDetail(({"nase","nasen"}),
      "Die nachtelfischen Nasen passen hervorragend in die Gesichter, "
      "das fast stupsnasige Aussehen laesst die Augen bisweilen noch "
      "frecher funkeln.");
  AddDetail(({"mann","elf","nachtelf","gefaehrte","ihn"}),
      "Der Nachtelf wirkt nur im Vergleich zu seiner Gefaehrtin gross und "
      "kraeftiger, fuer sich betrachtet macht er einen eher zierlichen "
      "Eindruck. Er traegt eine typisch-nachtelfische Kleidung.");
  AddDetail(({"frau","elfin","nachtelfin","gefaehrtin","sie"}),
      "Die Nachtelfin macht einen zierlichen und sehr geschickten Eindruck. "
      "Sie ist etwas kleiner als ihr Gefaehrte und traegt wie er eine fuer "
      "Nachtelfen typische Kleidung.");
  AddDetail(({"rundungen","rundung"}),
      "Die - aeh - Rundungen der Nachtelfen koennen sich sehen lassen. Um "
      "genau zu sein: Man kann sie nicht uebersehen.");
  AddDetail(({"kleidung","kombination"}),
      "Die traditionelle Kleidung eines Nachtelfen besteht ueberwiegend aus "
      "duennem schwarzem Wildleder. Die Kombination des Mannes besteht aus "
      "einem geschnuerten und aermellosen Hemd und einer dazu passenden "
      "Hose, sowie halbhohem Schuhwerk, das ein wenig wie eine "
      "Mischung aus Stiefel und Mokassin anmutet. Ueber dem Hemd ist eine "
      "halboffene Tunika geworfen, die farblich der Augenfarbe des Traegers "
      "entspricht und von einem (allerdings wieder schwarzen) Guertel "
      "zusammengehalten wird. Der uebliche Umhang, welcher auf einer Seite "
      "schwarz, auf der anderen (augen-)farbig ist und mit beliebiger "
      "Seite nach aussen getragen werden kann, fehlt allerdings. Sowohl bei "
      "ihm als auch bei ihr - auch sie traegt keinen Umhang und zeigt sich "
      "ueberhaupt eher sommerlich eingestellt: Statt Stiefel und Hose, die "
      "sonst auch frau traegt, werden die Beine nur von hochgeschnuerten "
      "Sandalen verziert. Die Tunika der Frau ist die einzige sichtbare "
      "Oberbekleidung und statt schwarz bereits farblich den Augen der "
      "Nachtelfin angepasst, ist allerdings nicht allzutief ausgeschnitten "
      "und vorn dementsprechend nicht zweigeteilt. Der Guertel fehlt aber "
      "auch hier nicht. Schmuck ist sowohl bei Nachtelf als auch bei "
      "Nachtelfin nicht vorhanden.");
  AddDetail("umhang",
      "Keine der Nachtelfen traegt einen Umhang. Aber Du weisst, dass der "
      "mit einer Kapuze versehene Umhang wind- und wetterdicht waere und "
      "mit beliebiger Seite nach aussen getragen werden koennte - einmal "
      "in schwarz und einmal in leuchtendem gruen, oder gelb, oder ... je "
      "nach Augenfarbe des Traegers. Eigenartiges Volk, diese Nachtelfen.");
  AddDetail(({"mokassin","schuhwerk","mokassins","stiefel"}),
      "Es handelt sich um sehr weiche Stiefel, deren Sohle nicht fest, "
      "sondern allenfalls etwas verstaerkt ist.");
  AddDetail("promoter","Kein Kommentar!");
  AddDetail("sandalen",
      "Fuer Nachtelfen dann doch eine eher untypische Kleidung, doch wollte "
      "der Promoter dieser Elfenart vermutlich unter Beweis stellen, dass "
      "Nachtelfen auch weltoffen sind.");
  AddDetail(({"tunika","tuniken","kleid"}),
      "Die Tuniken der Nachtelfen sind farblich zumeist auf die Augenfarbe "
      "des jeweiligen Traegers abgestimmt (hm, warum?). Die des maennlichen "
      "Elfen ist vorn zweigeteilt, die der Nachtelfin wirkt fast wie ein "
      "sommerliches Kleid.");
  AddDetail(({"hose","hosen"}),
      "Schwarze duenne Wildlederhosen, diese Ausgaben haben weder "
      "Verzierungen noch anderen Schnickschnack.");
  AddDetail(({"oberbekleidung","hemd"}),
      "Diese Art Hemd kann von beiderlei nachtelfischem Geschlecht "
      "getragen werden, hier jedoch nur am Manne vorhanden.");
  AddDetail("schmuck",
      "Einige Nachtelfen tragen wohl Schmuck - diese hier nicht.");
  AddDetail("guertel", "Schlichte, nicht allzuduenne Guertel.");
}
