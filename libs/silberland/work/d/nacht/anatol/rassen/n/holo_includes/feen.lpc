/*
 * Die Beschreibungen der Feen ist noch unvollstaendig.
 */

#include <properties.h>
inherit "std/thing/description";

void customize_feen() {

  AddId(({"fee","feen","feenwesen"}));
  SetProp(P_NAME,"Abbild zweier Feenwesen");
  SetProp(P_SHORT,"Das Abbild zweier Feenwesen");
  SetProp(P_LONG,
      "Fuer die Darstellung der Gestalt der Feenwesen haette vielleicht "
      "schon ein Feenwesen genuegt, denn die beiden Gestalten unterscheiden "
      "sich nicht wesentlich. Beides sind, erkennbar, weibliche Geschoepfe "
      "von ungefaehr zwei Fuss Koerpergroesse. Zwei kleine "
      "Fluegelpaerchen auf ihrem Ruecken bezeugen ihre Herkunft, und beide "
      "haben einen recht blassen Teint. Augen- und Haarfarbe ist bei "
      "den beiden Feenwesen alledings verschieden: Die linke Gestalt " 
      "traegt zu violetten Augen eine Haarpracht gleicher Farbe, die "
      "rechte Gestalt wirkt mit orangenen Haaren ueber silberfarbenen "
      "Augen noch etwas exotischer.");

  AddDetail(({"augen","augenfarbe"}),
      "Die Augen des linken Feenwesens sind violett, die des rechten "
      "eher silbern. Angeblich treten auch blaue und gruene Farbvarianten auf.");

  AddDetail(({"haarpracht","haarfarbe","haare","haar"}),
      "Die Haarfarbe der Feenweesn variiert aehnlich wie das ihrer Augen, was "
      "sicher sehr exotisch anmutende Kombinationen hervorbringt. Diese "
      "hier tragen das Haar in violett und orange. Beide tragen das kurze "
      "Haar offen, was aber moeglicherweise nur Zufall ist..");

  AddDetail(({"ruecken","fluegel","fluegelchen","libelle"}),
      "Auf dem Ruecken tragen beide Feenwesen kleine Fluegelchen, die stark "
      "an die einer Libelle erinnern. Fruehere Generationen der Feenwesen "
      "konnten hoechst wahrscheinlich fliegen, inzwischen sind die Fluegel "
      "jedoch zu klein, um den noetigen Auftrieb zu erzeugen. Aber ein "
      "charmantes Flattern bekommen die Feen von heute noch hin.");

  AddDetail(({"gesicht","gesichter", "gesichtsausdruck","gesichtszuege"}),
      "Die kleinen Gesichter der Feenwesen passen zu ihrer zierlichen "
      "Gestalt: Die Abstammung von hochmagischen Geschoepfen ist aus den "
      "feinen Zuegen durchaus abzulesen. Ein vorwitziger Gesichtsausdruck "
      "laesst sich nicht leugnen.");

  AddDetail(({"haut","hautfarbe","teint"}),
      "Diese beiden Feenwesen sind recht blass, was wohl ein Merkmal dieser "
      "Rasse ist.");

}
