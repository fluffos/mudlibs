/*
 * Die Beschreibungen der Feen ist noch unvollstaendig.
 */

#include <properties.h>
inherit "std/thing/description";

void customize_trolle() {

  AddId(({"troll","trolle"}));
  SetProp(P_NAME,"Abbild zweier Trolle");
  SetProp(P_SHORT,"Das Abbild zweier Trolle");
  SetProp(P_LONG,
      "Du siehst eine Wolke aus Flimmern und farbigen Staubpartikel.");
  
  AddDetail(({"flimmern","wolke","staubpartikel","staub"}),
      "Offenbar existiert kein visueller Eintrag zu den Trollen.");

}
