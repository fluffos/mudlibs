/*
 * Die Beschreibungen der Oger stammen von Feyaria, Februar 1999
 */

#include <properties.h>
inherit "std/thing/description";

void customize_oger() {

  AddId("oger");
  SetProp(P_NAME,"Abbild zweier Oger");
  SetProp(P_SHORT,"Das Abbild zweier Oger");
  SetProp(P_LONG,
      "Ganz offensichtlich handelt es sich bei den beiden Gestalten "
      "um Oger. Beide sind etwa 2.5 Meter gross, haben breite Schultern und "
      "einen gewaltigen, dicken Bauch. Beide haben hellbraune Haare und "
      "kleine, roetliche Augen. Sie tragen die typische Kleidung aus "
      "Fellen und Leder.");

  AddDetail("augen",
      "Die Augen der Oger sind fuer das grosse Gesicht relativ klein und "
      "leicht roetlich.");
  AddDetail(({"haare","haar"}),
      "Das Haar der Oger schwankt zwischen hellbraun und dunkelblond. "
      "Es ist bei beiden straenig und ziemlich fettig. Der Oger traegt es "
      "schulterlang und offen, die Ogerin zu einem langen Zopf an Ruecken "
      "zusammengebunden. Ansonsten sind beide Oger am ganzen Koerper "
      "haarlos.");
  AddDetail(({"bauch"}),
      "Beide Oger haben eine gewaltigen, runden Bauch. Bei den riesigen "
      "Mengen an Fleisch, das Oger im allgemeinen verzehren, ist das auch "
      "kein Wunder.");
  AddDetail( ({"schulter", "schultern"}),
      "Die Schultern beider Oger sind sehr breit. Die Schultern der Ogerin "
      "sind eher rundlich, die des Ogermannes dagegen noch breiter und "
      "muskuloes.");
  AddDetail(({"gesicht","gesichter", "gesichtszuege"}),
      "Die Gesichter der Oger sind rundlich, mit zwei kleinen roetlichen "
      "Augen in der Mitte. Die grosse Nase deutet auf einen guten Geruchsinn "
      "hin. Der riesige Mund ist mit spitzen Schneidezaehnen gefuellt.");
  AddDetail(({"nase","nasen", "geruchsinn"}),
      "Oger haben eine grosse, flachgedrueckte Nase, mit der sie auch den "
      "schnwaechsten Geruch von Fleisch aufspueren koennen.");
  AddDetail( ({"mund", "zaehne", "schneidezaehne"}),
      "Oger haben einen grossen Mund voll spitzer Zaehne. Den brauchen sie "
      "auch, um ihre riesigen Mahlzeiten verschlingen zu koennen.");
  AddDetail( ({"sie", "ogerin", "ogerfrau"}),
    "Die Ogerin unterscheidet sich nur durch die zusaetzlichen Rundungen "
    "auf ihrem Oberkoerper, die etwas runderen Gesichtszuege und den etwas "
    "schmaeleren Schultern von dem Ogermann.");
  AddDetail( ({"er", "ihn", "ogermann"}),
    "Der Ogermann unterscheidet sich nur durch die fehlenden Rundungen "
    "auf seinem Oberkoerper, die etwas haerteren Gesichtszuege und den etwas "
    "breiteren und muskuloeseren Schultern von der Ogerfrau.");
  AddDetail( ({"rundung", "rundungen"}),
    "Die Ogerfrau hat zwei gewaltige Rundungen auf ihrem Oberkoerper, die "
    "gut zu ihrem nicht weniger gewaltigen Bauch passen.");
  AddDetail(({"kleidung"}),
    "Die Kleidung beider Oger besteht vor allem aus Leder und Fell. "
    "Er traegt Stiefel aus dunklem Fell, einen Lendenschurz aus grobem "
    "Leder und einen weiten Fellumhang. Der Oberkoerper ist nackt und mit "
    "Schmalz eingefettet. Um Oberarme und Handgelenke hat er breite "
    "Lederbaender gewickelt und in der Hand haelt der Oger eine gewaltige "
    "Keule aus Holz, die mit vielen Stacheln bewehrt ist. "
    "Die Ogerin hat feste Lederstiefel an, eine Fellhose und ein kurzes, "
    "aermelloses Hemd aus weichem Leder. Ihr einziger Schmuck ist ein "
    "kupferner Reif auf ihrem linken Oberarm. Als Waffe traegt sie einen "
    "eisernen Spiess, bei dem es schwer zu entscheiden ist, ob es sich um "
    "einen Speer oder einen Bratspiess handelt." );
  AddDetail( ({"fell", "leder", "stiefel", "fellstiefel", "lederstiefel",
      "fellhose", "lendenschurz", "fellumhang", "lederhemd", "hemd",
      "hose"}),
    "Oger tragen hauptsaechlich Kleidung aus Leder und Fell.");
  AddDetail( ({"schmuck", "baender", "lederbaender", "reif", "kupferreif"}),
    "Der Oger traegt als Schmuck Lederbaender um Oberarme und Handgelenke, "
    "Die Ogerfrau dagegen einen Kupferreif um einen Oberarm.");
  AddDetail( ({"waffe", "waffen", "keule", "spiess", "speer", "bratspiess"}),
    "Die bevorzugten Waffen der Oger sind Keulen und Speere.");

}
