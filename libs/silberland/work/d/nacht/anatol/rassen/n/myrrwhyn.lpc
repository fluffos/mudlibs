      "der Wandlung bin dazu berufen, Euch, die Ihr Eure Gestalt aendern "
      "wollt, Auskunft und Rat zu geben, wie Euch ein Stern die Richtung "
      "weisen kann.","erklaert laechelnd: ",0,
      "Wieso Sterne? Sternenpriester? Ich verstehe das nicht...");
  AddInfo(({"daemmersang","namen"}),
      "Meinen Nachnamen fuehre ich nur bei offiziellen Anlaessen.",
      "sagt: ");
  AddInfo("tageslicht",
      "Warum heissen die Dunkelelfen wohl Dunkelelfen?","fragt: ");
  AddInfo("angelegenheit",
      "Ueberleget gut, was Ihr wollt, bedenket der Konsequenzen und der "
      "Erholungsphase Eurer Gestaltsauren!","warnt: ");
  AddInfo(({"gestaltsaura","gestaltsauren","gestaltauren","gestaltaura"}),
      "Das ist ein wenig komplex, ich darf es Euch auch nicht genau "
      "erkaeren, denn Ihr seid kein Sternenpriester. Doch wisst, dass "
      "jede Gestalt Auren besitzt und dass jenen Auren Gewalt angetan, "
      "wenn die Gestalt geaendert wird. Wiederholt man dies zu schnell, "
      "wuerde man den Geist gefaehrden. So bestehen wir Sternenpriester "
      "der Wandlung auf neun Monate Pause, selbst die Magie der Wandlung "
      "selbst wuerde euch ihren Dienst verweigern. Glaubet mir, man "
      "sieht Euren Auren nicht an, wielange sie schon um diese Gestalt "
      "liegen.","spricht: ",0, "Gestaltsauren? Hae?");
  AddInfo(({"eigenschaften","eigenschaft"}),
      "Ja, ich weiss ueber die Eigenschaften der Rassen schon ein wenig "
      "Bescheid!","nickt: ");
  AddInfo(({"aura","auren"}),
      "Welche Art von Auren meint Ihr? Es gibt deren viele!","fragt: ",0,
      "Hae, Auren?");
  AddInfo("geist",
      "Jedes hoehere Lebewesen besitzt einen Geist. Die Gestalt eines "
      "niederen Geschoepfes zu aendern, das ist keine Kunst - auch wenn "
      "Sternenpriester dies nicht tun.","erklaert: ");
  AddInfo("gewalt",
      "Gestaltsauren tut es gar nicht gut, wenn die Gestalt, um die sie "
      "liegen und angeordnet sind, veraendert wird!","erkaert: ");
  AddInfo("unterstuetzung",
      "Nun, ich kann Euch beispielsweise einiges zu den verschiedenen "
      "Rassen erzaehlen und Euch erklaeren, wie Ihr vorzugehen habt, "
      "wenn Ihr Eure Rasse wechseln wollt.","spricht: ",0,
      "Hm, wie sieht es mit Unterstuetzung aus?");
  AddInfo(({"familie","kommune","kommunen","gemeinschaft"}),
      "Einer Rasse anzugehoeren bedeutet mehr als nur bestimmte Eigenschaften "
      "mit anderen zu teilen. Es ist mehr, man gehoert dazu, ist ein "
      "Bestandteil einer Gemeinschaft oder Familie, darf oder muss sich "
      "an Regeln dieser Kommunen halten.","spricht: ");
  AddInfo(({"wort","geheimwort","worte","magischen worte", "magische worte",
            "magische worten","worten","woerter","worte"}),
      "Die Heiligen Hallen sind von Magie erfuellt. Die Worte werden im "
      "rechten Augenblick zu Euch finden. Wenn Ihr Euch zu einem Wechsel "
      "Eurer Rassenzugehoerigkeit entschlossen habt, gebt einfach "
      "''muto corpus'' ein, das weitere ueberlasst uns. Bedenket aber "
      "die Konsequenzen!", "spricht: ",0,
      "Oh, magische Worte, klingt ja interessant! Wie lauten sie denn?");
  AddInfo(({"erholung","konsequenz","konsequenzen","gefahr","gefahren"}),
      "Wenn Ihr Eure Gestalt wandelt, wird vieles nicht mehr so sein wie "
      "jetzt und vieles wird verloren gehen. Besondere Fertigkeiten, "
      "die Ihr nicht in einer Gilde gelernt habt, werden vielleicht "
      "verschwinden oder sich veraendern. Ebenso werden Fertigkeiten, "
      "Faehigkeiten und Magie, "
      "die Euch mit Eurer Rasse gegeben wurden, unwiderbringlich verloren "
      "gehen - die Eurer neuen Rasse jedoch muesst Ihr erst neu lernen. "
      "Vielleicht werden Euch auch solche Fertigkeiten, jene Ihr in einer "
      "Gilde erworben habt, verloren gehen, wenn sie zu sehr von Eurer "
      "Rasse abhaengig sein sollten, doch kann ich dazu nichts genaues "
      "sagen. "
      "Auch, und das ist sehr wichtig, koennt Ihr Eure Gestalt nicht "
      "beliebig oft wechseln: Die Gestaltsauren Eures Koerpers benoetigen "
      "mindestens neun Monate, um sich von der Umgestaltung so weit zu "
      "erholen, dass ein neuerlicher Wechsel der Gestalt moeglich waere. "
      "Und schlussendlich wird Eure alte Huelle am Ende der Wandlung "
      "aus dieser Welt getilgt, Ihr solltet Euer wertvolles Gut zuvor "
      "vielleicht einem Freund anvertrauen.",
      "warnt: ",0,"Oh... es gibt auch Konsequenzen?");
  AddInfo(({"wandeln","wandlung","wechsel","wechseln"}),
      "Die Wandlung ist einer der vielen Kreise der Sternenpriester "
      "und hat sich ganz der Unterstuetzung der Spieler verschrieben, "
      "die mit ihrer sterblichen Huelle unzufrieden sind und einer "
      "anderen Rasse angehoeren wollen. Wenn Ihr also Hilfe braucht "
      "oder Eure Moeglichkeiten erfahren wollt, so fraget!","erklaert: ");
  AddInfo(({"priester","sternenpriester"}),
      "Ja, ich bin ein Sternenpriester. Genauer gesagt ein Sternenpriester "
      "aus dem Kreis der Wandlung.","nickt laechelnd: ",0,
      "Bist Du wirklich ein Sternenpriester?");
  AddInfo("name",#'infoName,"gruebelt: ",0,"Wie kommst Du eigentlich zu diesem "
      "komischen Namen?");
  AddInfo("podest",
      "Oh, das Podest dient eigentlich nur zur Theatralik. Die Magien der "
      "Wandlung kann hier ueberall wirken. Einzig fuer meine Erlaeuterungen "
      "zu den verschiedenen Rassen nutze ich das Podest wirklich.",
      "fluestert: ",0,"Ist das Podest magisch?");
  AddInfo(({"gilde","gilden","reihen"}),
      "Wisset, dass manche Gilden die Angehoerigen ausgewaehlter Rassen "
      "nicht in ihren Reihen dulden. Versteht bitte, dass Ihr, wenn ihr "
      "in einer solchen Gilde seid, nicht alle Rassen erwaehlen koennt. "
      "Habt auch Verstaendnis dafuer, falls Euch Faehigkeiten in Eurer "
      "Gilde verlorengehen... wenn jene zu sehr von Eurer Rasse abhaengig "
      "sind, ist dies unvermeidlich.","erklaert: ",
      "Aehm... wie ist das mit meiner Gilde?");
  AddInfo(({"chor","gesang","chorbeitritt","gesaenge","gesang"}),
      "Aehm... Verzeiht. Ich bin nicht so musikalisch, als dass ich "
      "Euch diese Frage angemessen beantworten koennte.");
  AddInfo("verstaendnis",
      "Gefahren warten auf jenen, der sich in die Magie "
      "der Wandlung begibt, doch schreckt es jene, die sich nach anderen "
      "Auren sehnen, sicher nicht ab.");
  AddInfo(({"kreis","kreise"}),
      "Es derer vielerei. Ich habe den Kreis der Wandlung gewaehlt.",
      "spricht: ");
  AddInfo(({"faehigkeiten","fertigkeiten"}),
      "Die Faehigkeiten und Fertigkeiten einer Rasse sind verschieden, "
      "jedoch sind viele davon noch nicht in die Lebewesen uebergegangen "
      "- es ist anzunehmen, dass sich dort noch viel tun wird!","spricht: ");
  AddInfo(({"lebewesen","koerper","kampf","macht","oberflaeche",
        "silberland","teil","huelle","dinge","eigenschaften","regeln",
        "bestandteil","getier","baum","leben","geschoepf",
        "grundkenntnisse","grundkenntnis"}),
      "Es ist nicht meine Berufung, Grundkenntnisse zu vermitteln - ich "
      "diene nur, um Lebewesen wie Euch die Moeglichkeiten und Gefahren eines "
      "Wechsels der Rasse zu vermitteln.","wehrt sacht ab: ");
  AddInfo(({"wechsel","rasse","gestalt"}),
      "Hier in den Heiligen Hallen der Sternenpriester des Kreises der "
      "Wandlung vermagt Ihr mit Hilfe der Magie Deine Rassenzugehoerigkeit "
      "zu wechseln!", "fluestert ehrfuerchtig: ",0,
      "Wechsel? Wieso Wechsel?");
  AddInfo("magie",
      "Verzeiht, aber mir ist nicht gestattet, ueber Magie zu reden, "
      "denn schon in Worten liegt Macht, die nicht leichtfertig entfesselt "
      "werden darf.","bedauert: ");
  AddInfo("zeit",
      "Fuer gewoehnlich muss etwas Zeit vergehen, bevor Ihr Eure "
      "Gestaltsauren veraendern lassen koennt. Der Vorgang setzt "
      "jenen doch etwas zu, eine Pause ist einfach notwendig.","sagt: ");
  AddInfo("vorgang",
      "Ach nein, keine Details!","winkt ab: ");
  AddInfo("details",
      "Viele sind an Details nicht interessiert.","bescheidet: ");
  AddInfo(({"pause","warten","wuensche","frist","zeitspanne","wartezeit",
        "wahl","moeglichkeiten","moeglichkeit","austausch","angehoerige"}),
      #'infoMoeglichkeiten,"erklaert: ");
  AddInfo("anatol",
      "Ah, ein Nachtelf... ja, er schaut gelegentlich hier vorbei, doch wird "
      "er vermutlich nie hier seine Rasse wechseln. Er ist als Nachtelf "
      "ganz gluecklich, scheint mir.", "schmunzelt: ",
      0,"Anatol kennst _DU_ ja bestimmt, oder?");
  AddInfo(({"werke","alte werke"}),
     "Ach, wir verfuegen selbstverstaendlich ueber eine grosse "
     "Bibliothek. Diese koennen wir Fremden aber leider nicht "
     "zugaenglich machen, zu wertvoll sind die Schaetze in ihr. "
     "Vertraut darauf, dass meine persoenliche Hilfe euch mehr "
     "Hilfe als genug sein wird.", "nickt: ");
  AddInfo(({"bibliothek","schaetze","schatz"}),
     "Unsere Bibliothek ist voller Schaetze, ja. So koennen wir "
     "Sternenpriester anderen mit Rat zur Seite stehen.","weiss: ");
  AddInfo("mund",
     "Koennt Ihr den Euren auch so schwer halten? Ich kenne "
     "das - versucht, Euch auf das Wesentliche zu konzentrieren!",
     "seufzt: ");
   AddInfo(({"wesentliche","wesentlich","das wesentliche"}),
     "Na warum seid Ihr hier? Und weshalb koenntet Ihr gerade "
     "meinen Rat benoetigen?","schmunzelt: ");
   AddInfo("susagep",
     "Ah, Ihr habt die Bekanntschaft des Pegas... aeh... Susageps gemacht? "
     "Ein praechtiges Geschoepf, aber... ein eigenwilliger Flugstil. "
     "Ich sehe von weiteren Reisen mit ihm ab.","meint: ");
   AddInfo("pferd",
     "Pferd? Welches Pferd? Hier drin? Hier war noch nie ein Pferd, "
     "wenn ich mich recht erinnere. "
     "Allerdings soll draussen der Susagep verkehren, das ist etwas anderes.",
     "beteuert: ",0,"Kennst Du das Pferd?");
   AddInfo("geruch","Ja? Nach was riecht es denn hier...?","gruebelt: ");
   AddInfo("weihrauch","Oh, ich habe derzeit keinen Weihrauch verfuegbar.",
     "bedauert: ");
   AddInfo("pegasus",
     "Ich weiss nicht, wer das sein soll.","grinst: ");
   AddInfo("geschoepf",
     "Wir sind alle Geschoepfe!","sagt: ");
   AddInfo(({"untote","untot","untoter"}),
     "Mit Auren der Gestalt hat der ... Zustand von Untoten rein "
     "gar nichts zu tun. Wenn ihr untot werden wollt, geht, fragt einen "
     "Nekromanten.","winkt ab: ",0,"Kann ich auch ein Untoter werden?");
   AddInfo(({"nekromanten","nekromant"}),
     "Kein Kommentar.","schaut weg und sagt: ");
   AddInfo(({"grundkenntnisse", "grundkenntnis"}),
     "Selbst Grundkenntnisse in der Wandlung vermag ich nicht "
     "zu vermitteln - aber ich unterstuetze Euch in der Entscheidungs"
     "findung selbstverstaendlich gern.","sagt: ");
   AddInfo(({"entscheidung","entscheidungsfindung"}),
     "Schon einmal habt Ihr euch entscheiden muessen, welchem Volk "
     "Ihr angehoeren moegt. Ihr koennte diese Entscheidung von "
     "Zeit zu Zeit umaendern, aber... es koennte auch Konsequenzen "
     "haben, die Euch nicht gelegen kommen. Ueberlegt also gut.",
     "sagt: ");

   AddInfo(({"helligkeit","licht"}),"Ja, schoen hier, nicht wahr?");
  seteuid(getuid(this_object()));

  return;
}

public void Greet(object pl) {
  if ((!pl) || (!objectp(pl)) || (!living(pl)) || 
      (environment(pl)!=environment(this_object()))) {
    tell_room(environment(this_object()),
        "Myrrwhyn kuckt etwas erstaunt und zieht die Augenbrauen hoch.\n"
        "Myrrwhyn fragt: Ich vernahm den Ruf, "
        "doch wohin eilte der Rufende?\n");
  }
  else {
    tell_room(environment(this_object()),break_string(
        "Seid gegruesst, "+(string)this_player()->name(WER)+"! Wann immer "
        "ein Diener aus den Reihen der Sternenpriester aus dem Kreis der "
        "Wandlung vonnoeten ist, so soll einer erscheinen "
        "und mit Rat und Tat dem Beduerftigen zur Seite stehen. Denn so wird "
        "es ueberliefert, von Mund zu Mund, so stand es geschrieben in den "
        "alten Werken. Also denn, hier bin ich, was ist Euer Begehr?",77,
        "Myrrwhyn spricht: ",0));
  }
  return;
}

public int SequenceStarted() {

  if (HALL!=file_name(previous_object())) return 0;
  if (QueryProp(P_NOATTACK))
    return 0;
  else SetProp(P_NOATTACK,"ist in den Haenden der Magie unverwundbar.");
  if (QueryProp(P_NPC_QUIET))
    return 0;
  else SetProp(P_NPC_QUIET,([
        QUIET_MSG:"Jetzt?! Myrrwhyn wuerde eh nicht antworten koennen...",
        QUIET_FLAG:1]));
  return 1;
}

public int SequenceEnded() {
  SetProp(P_NOATTACK,SetProp(P_NPC_QUIET,0));
  tell_room(HALL,"Myrrwhyn entsteigt langsam wieder den "
      "Tiefen seiner Trance.\n");
  return 1;
}

public int _query_wimpy() { return 0; }
public void Attack(object enemy) { return; }
public void do_damage(int dam, mixed e) { return; }    

public void reset() {
  ::reset();
  if (environment(this_object()) && (!QueryProp(P_NPC_QUIET))) {
    SetProp(P_NPC_QUIET,([QUIET_MSG:"Zu spaet...",QUIET_FLAG:1]));
    tell_room(environment(this_object()),break_string(
       "Ich werde mich fuer einige Zeit wieder meinen eigenen "
       "Angelegenheiten widmen. Falls es Fragen geben sollte, Ihr "
       "wisst ja, wie Ihr mich rufen koennt...",77,
       "Myrrwhyn verabschiedet sich: ",1));
    HALL->LeavePriest(0);
  }
  return;
}


public void Defend(int dam, string dt, mixed sp, object e) {
  if ((!e) || (!objectp(e)) || (!living(e)) || 
      (environment(e)!=environment(this_object()))) return 0;
  tell_room(environment(this_object()),break_string(
      "Was soll das, "+(string)e->name(WER)+"? Haltet Ihr mich fuer so "
      "unfaehig, und glaubet, dass ich mich nicht zu wehren wuesste? "
      "Lasset ab, Ihr koenntet es bereuen!",77,"Myrrwhyn spricht: ",0)+
      "Eine blaue Schutzaura blitzt fuer einen Augenblick um Myrrwhyn auf.\n");
  e->SetProp(P_SP,0);
  e->do_damage(5,this_object());
  e->reduce_hit_point(100+random(100));
  e->StopHuntFor(this_object(),1);
  StopHuntFor(e,1);
  return;
}
