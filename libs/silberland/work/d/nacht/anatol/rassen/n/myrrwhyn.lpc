#pragma strict_types

#include "../defines.h"
#include "properties.h"
#include "new_skills.h"
#include "moving.h"
#include "combat.h"
#include SYS "npc.h"

#define HALL ROOM "halle"

inherit STD "npc";

nomask public int prevent_shadow(object o) { return 1; }

private varargs nosave string getPlayerGuild(object pl) {
  mixed ret;

  if ((!pl) || (!objectp(pl)) || (!query_once_interactive(pl))
      || (pl->QueryGuest()))
    return 0;
  switch((string)this_player()->QueryProp(P_GUILD)) {
    case 0:
      ret="den gildenlosen Geschoepfen";
      break;
    case "paladine":
      ret="den edlen Helden aus Aylas Reihen";
      break;
    case "druidenzirkel":
      ret="den magiebewanderten Druiden";
      break;
    case "berserker":
      ret="den wuetenden Axtschwingern";
      break;
    case "zechpreller":
      ret="den Berufsalkoholikern";
      break;
    case "abenteurer":
      ret="der Gilde der mutigen Abenteurer";
      break;
    case "dunkelelfen":
      ret="der fiesen Dunkelelfengilde";
      break;
    case "nekromanten":
      ret="den Kriegern der Dammnis";
      break;
    default:
      ret="einer mir nicht bekannten Gilde";
      break;
  }
  return ret;
}

nosave string infoRasse() {
  return 
      "Die Magie der Wandlung koennen Euch einen eingeschraenkten Teil "
      "der hoeheren Lebensformen als Familie zur Verfuegung stellen. Dies sind "
      +(string)call_other(HALL,"GetChoices",0,1)+
      ". Die Wahl der eigenen Zugehoerigkeit ist keine "
      "leichtzunehmende Angelegenheit und vor allem bei einem solchen "
      "Wechsel zumeist mit Konsequenzen verbunden, deshalb bittet mich "
      "ruhig, ueber die "
      "Eigenschaften einer Rasse zu referieren (z.B. ''sag Myrrwhyn, bitte "
      "referiere ueber die Elfen''), ich werde Euren Wuenschen, "
      "soweit mir moeglich, nachkommen. Habt Ihr euch entschieden, so sprecht "
      "die magischen Worte, steigt auf das Podest und harret der Dinge, die "
      "da geschehen.";
}

nosave string infoName() {
  if (this_player()) 
    return "Glaubt Ihr wirklich, dass \""+(string)this_player()->name(RAW)+
      "\" ein so viel schoenerer Name ist? Ohne Euch kraenken zu wollen, "
      "ich bin mit meinem Namen zufrieden.";
  else
    return "Was ist mit meinem Namen?";
}

nosave string infoMoeglichkeiten() {
  string choices;
  int i;

  if (!this_player()) return "Dazu kann ich leider nichts sagen.";
  choices=(string)call_other(HALL,"GetChoices",this_player(),1);
  if (choices) 
    return "Fuer Euch, "+(string)this_player()->name(WER)+
      ", Vertreter"+(((int)this_player()->QueryProp(P_GENDER)==MALE)?" ":"in ")
      +(string)call_other(HALL,"GetPlayerRace",this_player(),2)+
      ", zugehoerig zu "+(string)getPlayerGuild(this_player())+
      ", kommen folgende Rassen in Frage: "+choices+"."+
     ((i=(int)call_other(HALL,"GetInterval",this_player()))?
       time2string(" Doch leider werdet Ihr Euch noch etwa "
         "%x %X gedulden muessen...",i):(string)" Ihr muesstet "
	 "nicht warten und koenntet noch heute Eure Auren aendern lassen.");
  else return "Ich kann diese Frage nicht beantworten... Oh!";
}


nosave void sorryNoRace(string who) {
  tell_room(environment(this_object()),
    break_string("Vergebt, "+who+", aber ueber diese Rasse vermag ich "
      "nichts zu sagen - die Magie der Wandlung vernahm noch keinen Ruf vom "
      "Bewahrer jenes Volkes.", 77,"Myrrwhyn bedauert: ",0));
  return;
}

nosave void referAboutRace(string race) {
  tell_room(environment(this_object()),
    break_string("So vernehmet nun, was ueber "
      +capitalize(race)+" zu erfahren ist!", 77,"Myrrwhyn verkuendet: ",0));
  catch(HALL->StartReferSequence(race));
  return;
}
  
public void catch_tell(string s) {
  string * seq;
  string who, race;
  
  if ((!this_player())||(!interactive(this_player()))||(!s)||(!stringp(s))
       ||QueryProp(P_NPC_QUIET))
    return;
  s=lowerstring(s); 
  if
     (((sscanf(s,"%s sagt: myrrwhyn, bitte referiere ueber die %s\n",
        who, race)!=2)
     && (sscanf(s,"%s sagt: myrrwhyn, bitte erlaeutere die %s\n",
        who, race)!=2)
     && (sscanf(s,"%s sagt: myrrwhyn, referiere ueber die %s\n",
        who, race)!=2)
     && (sscanf(s,"%s sagt: myrrwhyn, referiere ueber %s\n",
        who, race)!=2)
     && (sscanf(s,"%s sagt: myrrwhyn, erlaeutere die %s\n",
        who, race)!=2)   
     && (sscanf(s,"%s sagt: myrrwhyn, erlaeutere %s\n",
        who, race)!=2))   
     || ((who!=lowerstring((string)this_player()->Name(WER)))
     || (find_call_out("referAboutRace")!=-1) 
     || (find_call_out("sorryNoRace")!=-1))) return;

  if (member(get_dir(SEQUENCES_DIR "*.seq"),(race=lowerstring(race))+".seq")
      ==-1)
    call_out("sorryNoRace",2,who);
  else {
    call_out("referAboutRace",4,race);
  }
  return;
}

nomask void create() {
  int i,j;
  object o;

  //if ((is_clone(this_object()))||(!previous_object())||
  //   (file_name(previous_object())!=HALL)) 
  // return (void) destruct(this_object());
  ::create();

  SetProp(P_NAME,"Myrrwhyn");
  SetProp(P_SHORT,"Sternenpriester Myrrwhyn");
  SetProp(P_LONG,break_string(
    "Myrrwhyn ist die nachtelfische Abstammung durchaus anzusehen. Er ist "
    "nicht gerade sehr gross und unter der weit geschnittenen schneeweissen "
    "Kutte siehst Du rote Haare hervorschauen. Sein guetiges Gesicht strahlt "
    "Wuerde aus, obschon seine fast kristallgruenen Augen ziemlich vergnuegt "
    "zu strahlen scheinen. Als Sternenpriester der Wandlung sollte er ueber "
    "den Austausch der sterblichen Huelle und den damit verbundenen "
    "Konsequenzen gut informiert sein.",77));
  AddDetail("kutte",
    "Die schneeweisse Kutte des Priesters ist sehr weit geschnitten und "
    "reicht locker bis zum Boden. Die Kapuze haengt ein wenig vornueber, "
    "doch verdeckt sie nicht das guetige Gesicht.");
  AddDetail("haare",
    "Die Haare sind trotz des hohen Alters des Priesters noch echt "
    "wildkirschrot.");
  AddDetail("gesicht",
    "Das Gesicht des Priesters laechelt meist und strahlt eine gewisse "
    "guetige Wuerde aus. Frech strahlt Dich ein Paar fast kristallgruener "
    "Augen an.");
  AddDetail("kapuze",
    "Die Kapuze ist fest mit der Kutte verbunden.");
  AddDetail("augen",
    "Eine sogar fuer Nachtelfen recht ungewoehnliche Augenfarbe -"
    " kristallgruen.");
  SetProp(P_SMELL,"Du traust Dich nicht.\n");
  SetProp(P_SOUND,"Du traust Dich nicht.\n");
  SetProp(P_RACE,"Nachtelf");
  SetProp(P_ALIGN,1000);
  // Nicht mehr mitloggen, dankeschoen.
  // SetProp(P_LOG_INFO,"anatol/myrrwhyn.info");
  SetProp(P_KILL_NAME,"Sternenpriester Myrrwhyn");
  create_default_npc(17);
  SetProp(P_XP,0); 
  SetProp(P_NOCORPSE,1);
  SetProp(P_GENDER, MALE);
  SetProp(P_DIE_MSG, " verschwindet in einer blauweissen Sternenwolke.\n");
  SetProp(P_SIZE,175);
  SetProp(P_WEIGHT,54000);
  SetProp(P_ARTICLE,0);
  SetProp(P_MSGIN,"schreitet wuerdevoll herein");
  SetProp(P_MSGOUT,"schreitet wuerdevoll");
  SetProp(P_MMSGOUT,"verschwindet in einer blau-weissen Sternenwolke");
  SetProp(P_MMSGIN,"tritt aus einer blau-weissen Sternenwolke");
  SetProp(P_HANDS,({" gar nicht",0,DT_BLUDGEON}));
  AddId(({"myrrwhyn","daemmersang", "myrrwhyn daemmersang",
          "\nmyrrwhyn","ANATOL_NPC", "priester","sternenpriester"}));

  AddInfo ( DEFAULT_INFO,
        ({"schaut ratlos.\n",
          "ist mit der Frage offenbar ueberfordert.\n",
          "weiss mit der Frage nichts anzufangen.\n",
          "hat darauf anscheinend noch keine Antwort.\n",
          "hat ganz offensichtlich die Frage nicht verstanden.\n",
          "laechelt verschmitzt und zuckt mit den Schultern.\n",
          "zuckt verlegen mit den Schultern.\n"}));
  AddInfo(({"aufgabe","abenteuer","abenteuerpunkte","abenteuerpunkt"}),
      "Nein.","antwortet: ",
      "Sag' mal, Myrrwhyn, hast Du eine dieser tollen Aufgaben fuer mich? "
      "So etwas mit Abenteuer und Abenteuerpunkten und so?");
  AddInfo(({"bewahrer","beschuetzer","magier"}),
      "Die Beschuetzer und Bewahrer aller Lebewesen und unbelebten "
      "Dingen werden hier faelschlicherweise oft als Magier bezeichnet. "
      "Dabei hat das, was sie tun, doch so wenig mit Magie zu tun, vielmehr "
      "mit harter Arbeit...","sagt: ");
  AddInfo("augen","Zwei.","sagt: ",0,
      "Also sag mal, ich bin mir ja nicht so ganz sicher, aber wenn Du "
      "das jetzt sagen muesstes, also falls ich Dich fragen wuerde, was "
      "ich nie taete, immerhin geht es mich ja vielleicht auch gar nichts "
      "an, nicht wahr... aber wieviele Augen hast Du da eigentlich genau?");
  AddInfo("beruf",
      "Jeder braucht einen Beruf, und sei es nur eine Berufung. Und ich bin "
      "ein Sternenpriester, der Euch, wenn Euch nach einer neuen Gestalt "
      "duerstet, vielleicht helfen kann.","laechelt: ");
  AddInfo("berserker","Oh, ich persoenlich bin da nicht so begeistert, "
      "da geht immer so viel kaputt, wenn die Berserker mal loslegen...",
       "verneint: ");
  AddInfo("abstammung",
      "Es ist geradezu offensichtlich, dass ich nachtelfischer Abstammung "
      "bin, oder?","grinst: ");
  AddInfo("hoehle", "Ich gestehe, ich spreche vom Tempel ungern als 'Hoehle'. "
      "dafuer ist es hier doch viel zu... sauber?","wiegelt ab: ");
  AddInfo("tempel", "Willkommen!","breitet die Arme aus und sagt: ");
  AddInfo("arbeit", "Oh, habet Ihr eine Ahnung... ich muss mir so oft das "
      "Gejammer Anatols anhoeren...","seufzt: ",0,
      "Arbeit? Wer arbeitet hier?");
  AddInfo("haare",
      "Ich weiss auch nicht, meine Haare werden und werden nicht "
      "weiss...","laechelt verschmitzt: ");
  AddInfo(({"formloser","formlose","formlosen"}),
      "Nein. Hin und wieder erscheinen hier zwar auch Formlose, um ihren "
      "Geist und ihre Seele in einer wirklichen Gestalt eine Heimat zu "
      "geben. Man kann sich natuerlich nicht die Gestalt eines Formlosen "
      "geben lassen - nur anfangs kann der, der noch nachdenken moechte, "
      "bevor er sich fuer eine Familie entscheidet, die Formlosen waehlen.",
      "verneint erklaerend: ",0,"Kann man auch ein Formloser werden?");
  AddInfo(({"kutte","kapuze","kleidung"}),
      "Gefaellt Euch meine Kleidung nicht?","stutzt: ");
  AddInfo(({"halle","hallen","saal"}),
      "Dies hier sind die Heiligen Hallen der Sternenpriester des Kreises "
      "der Wandlung - der Tempel der Magie der Wandlung. Fuer gewoehnlich "
      "werden hier Bittsteller eingewiesen "
      "und belehrt, hin und wieder aber auch eine Wandlung durchgefuehrt.",
      "erzaehlt: ",0,"Was fuer eine Halle ist denn das hier?");
  AddInfo(({"erlaeuterungen","erlaeuterung","referat","referieren",
        "sequenz"}),
      "Ich kann euch etwas ueber die verschiedenen Rassen erzaehlen, wenn "
      "Ihr mich darum bittet - zum Beispiel: ''sag Myrrwhyn, bitte referiere "
      "ueber die <rasse>'' oder ''sag Myrrwhyn, bitte erlaeutere die <rasse>''"
      ".","nickt: ",0,"Wie ist das mit den Erlaeuterungen, sind die "
      "informativ?");
  AddInfo(({"saeule","saeulen"}),
      "Die Saeulen sind eigentlich schon immer dagewesen...","gruebelt: ");
  AddInfo("portal",
      "Durch dieses Portal kommen die Bittsteller zu uns.","sagt: ");
  AddInfo("bittsteller",
      "Nun, so jemand wie Ihr beispielsweise.","zuckt mit den Schultern: ");
  AddInfo("syntax","Oh, also mit ''sag Myrrwhyn, bitte referiere ueber die "
      "<rasse>'' werde ich Euch zu jeder Rasse einen kleinen Vortrag halten. "
      "Habt Ihr Euch fuer einen Wechsel Eurer Rasse entschieden, nutzet "
      "''muto corpus'' und die Magie der Wandlung wird euch "
      "weiterhelfen.","erklaert laechelnd: ",1,"So ganz im Vertrauen, ich "
      "habe das mit der Syntax nicht ganz begriffen...");
  AddInfo("oger",
      "Oh, die Oger, ein ziemlich verfressenes Volk und nicht gerade "
      "sehr helle. Ich weiss nicht viel ueber sie, aber immerhin ein "
      "paar Kleinigkeiten.","gruebelt: ",0,"Weisst Du etwas ueber "
      "die Oger?");
  AddInfo("kleinigkeiten","Es lohnt sich schon, ein wenig darueber zu "
      "referieren, keine Sorge.","grinst: ");
  AddInfo("marmor",
      "Ja, schoen, nicht wahr? Allerdings kommt er mir manchmal als "
      "etwas zu pompoes vor.", "waegt ab: ");
  AddInfo("sorge",
      "Ich habe keine Sorge, danke!","laechelt: ");
  AddInfo(({"troll","trolle","kloetze"}),
      "Trolle? Diese hirnlosen Kloetze? Oh... nun, auch ueber sie gibt es "
      "natuerlich einiges zu sagen, ich referiere gerne ein wenig ueber "
      "sie - auch wenn sie mir nicht gerade gefallen (''sag Myrrwhyn, bitte "
      "referiere ueber die Trolle'').","meint: ",0,"Wie ist das mit den "
      "Trollen, weisst Du etwas ueber sie?");
  AddInfo(({"elf","elfen"}),
      "Ach ja, die Spitzohren aus dem Kristallwald. Sie sind ein wenig "
      "weltfremd und wirken dadurch etwas hochnaesig, aber wenn man ihren "
      "Gesaengen lauscht, sieht man gerne darueber hinweg.","spricht: ",0,
      "Ich interessiere mich fuer die Elfen, koenntest Du mir etwas dazu "
      "sagen?");
  AddInfo(({"ohren"}),
      "Wie meinen?","fragt: ");
  AddInfo(({"gesang","gesaenge"}),
      "Ja, singen tun wir hier auch, warum fragt Ihr?","fragt: ");
  AddInfo(({"spitzohr","spitzohren"}),
      "Nah, von denen gibt es aber verschiedene - Dunkelelfen, Nachtelfen und "
      "natuerlich die Elfen aus dem Kristallwald. Sie unterscheiden sich "
      "sehr, verwechselt sie nur nicht!","erlaeutert: ",0,
      "Kennst Du diese Spitzohren? :o)");
  AddInfo("kristallwald",
      "Ich persoenlich war noch nie im Kristallwald, aber es soll dort "
      "sehr schoen sein.", "bedauert: ",0,"Kennst Du den Kristallwald?");
  AddInfo(({"dunkelelf","dunkelelfen"}),
      "Das sind die schwarzen Schafe in der elfischen Familie. Sie sind "
      "boshaft und scheuen das Tageslicht. Ich kann Euch da so einiges "
      "erzaehlen...","meint: ",0,"Hmmm, was weisst Du denn von den "
      "Dunkelelfen?");
  AddInfo(({"nachtelf","nachtelfen"}),
      "Hey, ich bin auch einer! Wenn ich Euch etwas ueber die Nachtelfen "
      "erzaehlen soll, werde ich das gerne tun. Nur richtige "
      "Nachtelfen-Spieler "
      "wird es so bald nicht geben.","nickt: ",0,
      "Kennst Du schon die Nachtelfen? Die soll es doch irgendwann einmal "
      "geben...");
  AddInfo(({"hobbit","hobbits"}),
      "Selbstverstaendlich kenne ich die Hobbits, das kleine Schlemmervolk! "
      "Ueber sie gibt es so einiges zu berichten.","nickt: ",0,"Kennst Du "
      "die kleinen Pelzfuesse? Die Hobbits, meine ich!");
  AddInfo(({"volk","voelker"}),
      "Oh, es gibt viele Voelker, welches meint Ihr?","fragt zurueck: ");
  AddInfo("schlemmervolk",
      "Oh ja, sie wissen zu schlemmen, die Hobbits","grinst: ");
  AddInfo(({"menschen","mensch"}),
      "Nun, Menschen gibt es ueberall. Es gibt nicht viel besonderes "
