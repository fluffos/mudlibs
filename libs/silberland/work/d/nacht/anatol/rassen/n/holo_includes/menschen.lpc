/*
 * Die Beschreibungen der Menschen 
 */

#include <properties.h>
inherit "std/thing/description";

void customize_menschen() {

  AddId(({"mensch","menschen"}));
  SetProp(P_NAME,"Abbild zweier Menschen");
  SetProp(P_SHORT,"Das Abbild zweier Menschen");
  SetProp(P_LONG,
      "Zur Darstellung der menschlichen Gattung wurden offenbar zwei "
      "praechtige Vertreter der Rasse gewaehlt. Beide sind fuenf, fast "
      "sechs Fuss gross und wirken recht sportlich. Die Menschenfrau "
      "ist klar als solche zu erkennen und traegt das lange rote Haar zu "
      "einem straffen Zopf geflochten, waehrend der Mann seine dunkelbraunen "
      "Haare sehr kurz schneiden liess. Beide tragen eine Art Bewaffnung, "
      "er einen Speer, sie ein Schwert. Aufmerksam scheinen sie die Umgebung "
      "im Auge zu behalten - doch von substanzlosen Abbildern droht Dir hier "
      "keine Gefahr.");


  AddDetail(({"frau","menschenfrau","menschin","weibchen"}),
      "Zur Repraesentation der Menschenfrau wurde ein eher exotisches "
      "Modell gewaehlt: Rote Haare und blaue Augen zeichnen, hier gemeinsam "
      "mit einem eher blassen Teint, einen Menschenstamm aus eher noerdlicheren "
      "Gefilden, ohne allzu rauhes Klima, aus. Der Blick der Frau ist nicht "
      "ohne Stolz, in ihrer Linken haelt sie ein Schwert in der Scheide, "
      "jederzeit bereit, den Stahl blank zu ziehen."
      "Sie ist in eine Tunika gewandet - ein klassischer Brustpanzer haette *hier* "
      "und *hier* deutlich ausgebeult werden muessen.");

  AddDetail(({"mann","menschenmann","mensch","maennchen"}),
      "Der Mann stellt offenber den Archetyp des Menschenmanns dar: "
      "Dunkle braune Augen, dunkles braunes Haar, sonnengebraeunte "
      "Haut, kraeftige Statur. Wie die Frau neben ihm ist auch dem "
      "Mann eine Waffe gegeben - locker steckt das stumpfe Endes eines "
      "Kampfspeeres in der Erde, ebenso locker haelt die rechte Hand "
      "des Mannes den Schaft. Der wachsame Blick laesst Dich jedoch "
      "im Glauben, dass der Speer sofort kampfbereit angelegt ist, "
      "wenn sich auch nur die kleinste Gefahr zeigt. Der Mann traegt "
      "ein leichtes Kettenhemd und Lederhosen mit dickem Besatz. "
      "Offenbar hat er heute noch was vor.");

  AddDetail(({"hemd","kettenhemd"}),
      "Das Kettenhemd sieht aus wie ein gewoehnliches 4-in-1-Kettenhemd.");

  AddDetail(({"tunika","gewand"}),
      "Die Kleidung der Frau ist eher locker und leicht - was im Gegensatz "
      "zu ihrem Aeusseren zu sein scheint, stammt sie doch, mutmasslich, aus "
      "einer kaelteren Gegend. Dies mag hier ein Signal dafuer sein, dass "
      "Menschen ueberall zurecht kommen und sich, tatsaechlich, selten ueber "
      "mehrere Generationen in einer Ecke niederlassen.");

  AddDetail(({"stiefel","schuhe","schuh","schuhwerk"}),
      "Beide Menschen tragen festes Schuhwerk, witzigerweise scheinen die "
      "Absaetze der Schuhe der Frau um einige Zentimeter erhoeht zu sein. "
      "Die Gruende hierfuer sind nicht klar ersichtlich - moeglicherweise "
      "eine Erfindung der Maenner und Ausgangspunkt fuer Diskussionen, "
      "die ueber viele Generationen gefuehrt werden duerften.");

  AddDetail(({"augen","augenfarbe"}),
      "Die Frau hat blaue Augen, was mit ihren roten perfekt harmoniert und "
      "ihr eine exotische Aura zu verleihen scheint. "
      "Der maennliche Vertreter des Menschenvolks wirkt durch das klassische "
      "braun-in-braun weniger auffaellig, doch bedeutend robuster.");

  AddDetail(({"haar","haare","haarpracht"}),
     "Der Mann traegt seine dunkelbraunen Haare eindeutig funktional "
     "orientiert: Kurz geschnittene Haare koennen ihm auch bei raschen "
     "Bewegungen nicht ins Gesicht fallen. Das Weibchen - pardon, die "
     "Frau - wird ihre Haare aus aehnlichen Gruenden zu einem festen "
     "Zopf geflochten haben. Die Verteilung ist sicher ein Cliche, "
     "es wurden auch schon Maenner mit Zoepfen gesehen. ");

  AddDetail(({"zopf","zoepfe"}),
    "Ein Zopf ist eindeutig kein Zeichen von Schwaeche oder Eitelkeit. "
    "Vielmehr wuerden offene Haare im Kampfgetuemmel hinderlich sein. ");

  AddDetail(({"speer","schwert","waffen","waffe","bewaffnung"}),
    "Die Wahl von Speer und Schwert wird eher zufaellig gewaehlt sein. "
    "Man sagt dem Menschenvolk zwar ein gewisses Geschick in eben jenen "
    "Gattungen nach, doch duerfte ein Mensch auch mit Keulen, Dolchen "
    "oder Stoecken recht gut klar kommen. Die hier dargestellten Waffen "
    "sehen recht abgenutzt aus.");

  AddDetail(({"helm","kopfbedeckung","muetze","hut"}),
    "Auf Kopfbedeckungen wurde, scheint's,  bewusst verzichtet.");

}
