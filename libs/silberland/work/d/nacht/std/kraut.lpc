/* std/kraut.c  - irgendwas, das man pfluecken kann.
 * __________________________________________(i) Anatol@Silberland (2012) */

#include <properties.h>
#include "/d/nacht/sys/kraut.h"

inherit "/std/thing";

nosave int clone_time;



// if factor == 0, then always fresh.
// if factor < 0, then something negative. Would suppress any status string.

nosave int 
numericDryness()
{
    return (
            ((int)QueryProp(P_KRAUT_DRYING_FACTOR)!=0)
            ?(time()-clone_time)/(int)QueryProp(P_KRAUT_DRYING_FACTOR)
            :0
           );
}

public string 
DrynessStatus() 
{
    switch (numericDryness())
    {
        case 0:         return "frisch gepfueckt und saftend";
        case 1:         return "frisch gepflueckt";
        case 2..3:      return "nahezu pflueckfrisch";
        case 4..5:      return "frisch";
        case 6..8:      return "recht frisch";
        case 9..13:     return "nicht mehr ganz frisch";
        case 14..20:    return "schon leicht lapprig";
        case 21..29:    return "welk";
        case 30..40:    return "welk und etwas ausgetrocknet";
        case 41..59:    return "recht trocken";
        case 60..119:   return "getrocket";
        case 120..209:  return "trocken";
        case 210..299:  return "staubtrocken";
        default:    return "wirklich absolut trocken";
    }
}

void 
create()
{
    if ((clone_time) || (!is_clone(this_object())) )
        return;
    ::create();
    clone_time=time();
    AddId(({"kraut","kraeuter","\n\ach\t_kraeuter"}));
   
    // Default Property Values
    SetProp(P_NAME,"Kraut");
    SetProp(P_WEIGHT,10);
    SetProp(P_GENDER,NEUTER);
    SetProp(P_SHORT,"Ein nicht naeher spezifiziertes Kraut");
    SetProp(P_LONG,"Ein nicht naeher spezifiziertes Kraut.");
    SetProp(P_VALUE,0);
    
    SetProp(P_KRAUT_DRYING_FACTOR,20);
    SetProp(P_KRAUT_RESETS_UNTIL_DECOMPOSE,0);
}

/* overloaded for a status string */

public string
short()
{
    if ((::short()) && (strlen(::short())>2))
    {
        if (numericDryness()>=0)
            return  break_string((::short()[<2..]==".\n"?::short()[0..<3]:(::short()))+ 
                        " ("+DrynessStatus()+").\n",77,0,1);
        else 
            return ::short();
    }
    else 
       return 0;
}


public string
long()
{
    if (::long())
    {
        if (numericDryness()>=0)
            return ::long() + break_string(Name(WER,1)+" ist "+DrynessStatus()+".",77);
        else 
            return ::long();
    }
   else
       return 0;
}

/* public interface */

public int
isKraut()
{
    return 1;
}

public int 
isDry() 
{
    return (numericDryness()>=60);
}

public int 
isFresh() 
{
    return (numericDryness()<=8);
}


public void
reset()
{
    ::reset();
    if ((numericDryness()>=300) && is_clone(this_object()))
    {
        if (!(QueryProp(P_KRAUT_RESETS_UNTIL_DECOMPOSE)))
        {
            if (environment())
                environment()->Message(break_string("Leise raschelnd zerfaellt " +
                   name(WER,1) + " zu Staub.",77));
            remove();
        }
        else SetProp(P_KRAUT_RESETS_UNTIL_DECOMPOSE,
                  (int)(QueryProp(P_KRAUT_RESETS_UNTIL_DECOMPOSE)) -1);

    }

}

