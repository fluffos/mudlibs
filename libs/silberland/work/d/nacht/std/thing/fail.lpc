
#pragma strict_types


/**
  *
  * Fuer die Nutzung in Methoden, die auf eine Spieleraktion hin
  * aufgerufen werden und fehlschlagen koennen. Zu nutzen als:
  *
  * ... return fail("Das kannst Du hier nicht druecken.");
  * 
  * Das "gewoehnliche" Konstrukt ...
  *
  * notify_fail("Das kannst Du hier nicht druecken\n");
  * if (what!="knopf")
  * { 
  *     return 0;
  * }
  *
  * ... ist einfach zu lang und - da zwischen notify_fail() und return 0
  * auch mal viel Code stehen kann, unuebersichtlich.
  */

varargs public int 
fail(string message)
{ 
    notify_fail( (((!message)||(!stringp(message))|| (!strlen(message)))
                   ?0
                   :( (message[<1]=='\n')
                      ?message
                      :break_string(message,77)
                     )
                  ));
    return 0;
}

