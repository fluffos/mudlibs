/* Loggt Spielertode in /d/<region>/<verzeichnis>/log/kills.log, 
 * falls das Verzeichnis vorhanden ist und das Objekt in entsprechender
 * Dateistruktur liegt.
 * __________________________________________(i) Anatol@Silberland (2012) */

#define NEED_PROTOTYPES
#include <properties.h>
#include <thing/properties.h>

public varargs string Name(int casus, int demon);

nomask public void NotifyPlayerDeath(object victim, object killer, int lxp) {
  string s;
  string *path;
  if ((killer!=this_object())||(!objectp(victim))) return;
  if ((!s=(string)QueryProp(P_KILL_NAME))&&(!s=(string)Name(WER)))
    s=file_name(this_object());
  path = explode(file_name(this_object()),"/");

  if ((sizeof(path)>3) && (path[0]=="d") &&
      (sizeof(get_dir(path[0]=("/d/" +path[1]+"/"+path[2]+"/log")))))
  write_file(path[0]+"/kills.log",
      sprintf("%s | %s bringt %s (%d/%d) um.\n",
        dtime(time())[5..], s, (string)capitalize(getuid(victim)), 
        victim->QueryProp(P_LEVEL),lxp));
  return;
}
