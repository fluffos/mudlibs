#include "../defines.h"
#include SYS "npc.h"

inherit STD "thing/log_deaths";
inherit STD "thing/fail";
inherit STD "npc/info";
inherit "/std/npc";


public void create() {
  npc::create();
  info::create();
}

public void init() {
  npc::init();
  info::init();
}

void DoChat() {
  if (!QueryProp(P_NPC_QUIET))
    ::DoChat();
  return;
}
