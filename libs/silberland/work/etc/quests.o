#0:0
max_QP 1334
all_QP 1426
seer_QP 777
wiz_QP 999
quests (["Alriks Wette":({15,1000,({"/d/wasser/angrox/insel/npc/alrik",}),"Der Fischer Alrik muss eine Wette gewinnen... sei ihm dabei behilflich!",3,0,1,({"angrox","angrox",}),3598,}),"Umpfs Aufgabe":({45,25000,({"/d/huegelland/andyl/soundquest/obj/give_quest",}),"Der kleine Gnom Umpf hat ein Problem mit einem Kobold. Vielleicht kannst Du ihm helfen? Er soll irgendwo im Huegelland wohnen, sagt man.",15,0,1,({"andyl","andyl",}),1546,}),"Keine Gnade":({35,20000,({"/d/dschungel/dante/kinder/gou",}),"Im Kindergarten von Tijara gehen sehr merkwuerdige Dinge vor sich. Angeblich sind die Kinder dort von einem boesen Daemon befallen. Geh zur Gouvernante und hilf ihr diesen Daemon und seine Gesellen zu verbannen!",20,0,1,({"dante","dante",}),679,}),"Tithons Fluch":({12,1000,({"/d/dschungel/dante/ratmanquest/npc/ratman",}),"In Tijara laeuft verzeifelter Junge umher. Tithon, der Pflanzentrollmagier hat ihn verflucht! Hilf ihm normal zu werden und erloese ihn damit.",23,0,1,({"dante","dante",}),553,}),"Cailleac'h's Harfe":({50,25000,({"/d/gebirge/angrox/4elem/room/wald/wald_g2",}),"Anvar sucht einige Artefakte, die Harfe ist eines davon.",25,0,1,({"angrox","angrox",}),674,}),"Eesthils Befreiung":({30,5000,({"/d/kristallwald/sargola/see/obj/floete",}),"Geh in den Kristallwald und hilf Salina, ihren Mann Eesthil aus seiner kristallinen Gefangenschaft zu befreien!",15,0,1,({"sargola","protheg",}),1141,}),"Runen der Priesterin":({50,20000,({"/d/unterwelt/zordan/dhrkion/room/tempel2",}),"Dumpfe Dunkelheit! Die Dunkelelfen in Dhrkion haben ein Problem mit Sonnenlicht. Geh doch mal zu ihrer Hohenpriesterin und frag sie danach.",18,0,1,({"zordan","torian",}),970,}),"Verkupple Isabella":({25,5000,({"/d/kristallwald/sargola/insel/room/wasserfall",}),"Auf einer einsamen Insel mitten im Rhondonitsee lebt eine Nymphe. Vielleicht koenntest Du ihre Einsamkeit beenden?",12,0,1,({"sargola","protheg",}),1391,}),"Im Edelsteingeschaeft":({15,2000,({"/d/dschungel/dante/gemquest/gi",}),"Man munkelt, dass Gihr ein Problem hat... Vielleicht kannst Du ihm helfen?",25,0,1,({"dante","dante",}),906,}),"Die Gesellenpruefung":({30,5000,({"/d/huegelland/xorgan/koehler/npc/lehrling",}),"Viel Kohle stellen die Koehler her. Noch mehr mit einem Gesellen mehr. Der Lehrling steht vor seiner Pruefung und die ist schwer, also hilf ihm doch dabei!",25,0,1,({"xorgan","xorgan",}),1071,}),"Die verlorene Seele":({25,5000,({"/d/gebirge/dante/friedhof/npc/humfrey",}),"Am Gebirgsfriedhof gehen merkwuerdige Dinge vor sich. Der Magier Humfrey versucht, einem seelenlosen Maedchen zu helfen. Doch er benoetigt dringend Deine Unterstuetzung.",13,0,1,({"dante","dante",}),999,}),"Artox' Lebenswerk":({70,25000,({"/d/gebirge/thor/hoehlenquest/npc/artox",}),"In der Naehe des Gebirgsplateaus leb ein alter Zwergenschmied in einer Hoehle. Er benoetigt dringend Deine Hilfe!",20,0,1,({"thor","thor",}),763,}),"Fuetter Grimow":({10,10000,({"/d/ebene/zordan/ogerhoehle/npc/grimow",}),"Der Anfuehrer der Oger, Grimow, hat mal wieder grossen Hunger. Geh doch mal in die Ogerhoehle und versuche ihm zu helfen. Aber ACHTUNG, Oger sind sehr aggressiv und greifen alle anderen Rassen, selbst wenn sie in friedlichen Absichten kommen, sofort an.",25,0,1,({"zordan","zordan",}),879,}),"Die alte Zeder":({15,1000,({"/d/kristallwald/sargola/dorf/obj/quest",}),"Auf der Lichtung in der Naehe vom Elessar gehen in letzte Zeit seltsame Dinge vor sich. Du koennest Dich dort mal umschauen. Der weise Aerendil weiss sicher etwas darueber zu berichten.",8,0,1,({"sargola","protheg",}),1576,}),"Die Liebessalbe":({20,1000,({"/d/wasser/stahldorn/quest/questnpc",}),"Der Alchemist in Derlim will mit einer Liebessalbe seine verlorene Ehefrau wieder fuer sich gewinnen. Du musst ihm die Zutaten, die er dafuer braucht, besorgen.",6,0,1,({"stahldorn","stahldorn",}),1611,}),"Tod dem Riesen":({50,100000,({"/d/unterwelt/zordan/riese/npc/sica",}),"Sica hat Probleme mit einem Riesen in der Untwelt. Drei tapfere Recken werden benoetigt, um der Plage des Riesens ein fuer allemal Herr zu werden. ",40,2,1,({"zordan","torian",}),261,}),"Buckel vor Mini":({1,500,({"/d/dschungel/dante/weg/obj/miniquest",}),"Die Schnecke Mini ist zu schwach um eine muehevolle Aufgabe zu erledigen. Vielleicht kannst Du ihr helfen?",1,2,1,({"dante","dante",}),1320,}),"Rette Xatanas Ehe":({25,3000,({"/d/unterwelt/zaknafein/eheringquest/npc/xatana",}),"Tief unten in der ewigen Dunkelheit sucht eine Frau, ihr Name soll Xatana sein, Deine Hilfe...",18,0,1,({"zaknafein","torian",}),745,}),"Hilf dem Mueller":({20,3000,({"/d/huegelland/iwo/muehle/npc/master",}),"Der arme Mueller ist zu verletzt um seiner Arbeit nachgehen zu koennen. Vielleicht kannst Du ihm helfen?",10,0,1,({"iwo","iwo",}),1825,}),"Finde das Juwel":({5,1000,({"/d/unterwelt/zordan/dhrkion/npc/odania",}),"Odania hat im Anfaengerpark von Dhrkion, der Stadt der Dunkelelfen, etwas Wertvolles verloren. Vielleicht kannst Du ihr ja Deinen Mut im Kampf beweisen und ein winziges Abenteuer bestehen! Solltest Du allerdings einer anderen Rasse angehoeren, so sei unter einer eigenen Stufe von 20 gewarnt!!!",1,0,1,({"zordan","torian",}),1287,}),"Amaltheas Ring":({55,28000,({"/d/ebene/ronja/feenquest/npc/feek",}),"Der Ring der Fee Amalthea ging bei dem letzten Kampf gegen die Hexen verloren. Seitdem ist er verschollen. Mit dem Ring koennten die Feen besser gegen das Boese in der Welt kaempfen.",15,0,1,({"ronja","clementine",}),572,}),"Auf Grosswildjagd":({20,10000,({"/d/dschungel/feyaria/tijara/npc/jaeger",}),"Der Grosswildjaeger in Tijara hat einen Grossauftrag vom Trophaeensammler bekommen. Du koenntest ihm bei der Jagd nach seltenen Tieren helfen.",35,0,1,({"feyaria","feyaria",}),303,}),"Befreie Hildgunde":({15,5000,({"/d/andracia/yondala/wasser/pirateninsel/npc/sklavin_hildgunde",}),"Hilf Hildgunde, sich von ihrer schweren Eisenkette zu befreien. Besuch sie auf der Pirateninsel und sie wird dir Naeheres erzaehlen!",10,0,1,({"yondala","yondala",}),71,}),"Hilf der kranken Elfe":({8,3000,({"/d/andracia/yondala/tal/aboriville/npc/mensch_peter",}),"Hilf der kranken Elfe in Aboriville, ein paar Dinge zu erledigen.",5,0,1,({"yondala","yondala",}),76,}),"Der fliegende Silberlaender":({40,7000,({"/d/ebene/carador/ridu/room/pier",}),"Jaaa, also man erzaehlt sich, dass am Pier im Fischerdorf seit kurzem einer sitzt, der behauptet, jemand waere mit seinem Schiff davongeflogen. Wenn Du mich fragst, ist das ein riesengrossser Schmarrn.",10,0,1,({"carador","carador",}),677,}),"Vanataurs dunkle Bedrohung":({20,7500,({"/d/wasser/malar/vanataur/npc/geist",}),"Die auf Vanataur lebenden Bluetenwesen muessen sich einer dunklen Bedrohung entgegenstellen! Sie sind nur noch sehr schwach und benoetigen daher dringend Deine Hilfe. Auf die Insel kommst Du vielleicht von einem Schiff aus...",9,0,1,({"malar","malar",}),649,}),"Hilf dem Schwammerlsucher":({5,1000,({"/d/ebene/woody/q/pilz/schwammerlsucher",}),"Suche den verzweifelten Schwammerlsucher im Silberwald auf und unterstuetze ihn bei seiner Suche.",1,0,1,({"woody","woody",}),4238,}),"Futter fuer die Spinne":({15,3000,({"/d/huegelland/raballion/hobbits/npc/troedler",}),"Dodo Stolzfuss, der Troedler aus Derlim, sucht dringend jemanden, der ihm Futter fuer seine Lieblingsspinne besorgt.",8,0,1,({"feyaria","feyaria",}),1515,}),"Das Schweigen der Rumpelwichte":({8,2500,({"/d/unterwelt/zordan/dhrkion/npc/plexu",}),"Plexus Rumpelwichtvorrat schwindet. Wenn er nicht bald Nachschub bekommt, wird es in seiner Kneipe keinen delikaten Braten mehr geben, und das waere doch jammerschade, oder?",8,0,1,({"ronja","torian",}),682,}),"Eierfaerben fuer den Osterhasen":({20,1000,({"/d/huegelland/feyaria/osterhase/osterhase",}),"Der Osterhase hat zuwenig Zeit zum Eierfaerben. Hilf ihm, genug Eier zu Faerben, damit zu Ostern jeder seine Ostereier bekommen kann.",7,0,1,({"feyaria","feyaria",}),1562,}),"Das Raetsel des Elefantenfriedhofes":({20,10000,({"/d/wueste/verdandi/puzzle/obj/puzzleitem",}),"Auf dem Elefantenfriedhof soll es ein Raetsel geben. Wenn Du schlau und mutig genug bist, dann geh auf den Friedhof und loese das Raetsel!",15,0,1,({"verdandi","gwenshara",}),749,}),"Beende die Rattenplage in Tijara":({25,3000,({"/d/dschungel/feyaria/tijara/npc/gouverneur",}),"Hilf dem Gouverneur in Tijara bei der Beendigung der Rattenplage.",4,0,1,({"feyaria","feyaria",}),2022,}),"Der verzweifelte Gaertner":({15,3000,({"/d/gebirge/rage/quest/npc/blu",}),"Der Zwergengaertner ist soo verzweifelt, dass er sogar Deine Hilfe braucht.",10,0,1,({"rage","rage",}),1611,}),"Mitternachtstanz der Feen":({50,30000,({"/d/ebene/ronja/feenquest/npc/obdiener",}),"Jeden Monat vollfuehren die Feen ihren Tanz bei Vollmond, der sehr wichtig fuer ihre Existenz ist. Doch leider ist ein sehr wichtiger Gegenstand abhanden gekommen.",15,0,1,({"ronja","woody",}),862,}),"Das namenlose Nftahgrab":({15,1000,({"/d/wueste/protheg/kraterrand/npc/barlogor",}),"Bei Quaul in der Wueste lebt ein alter Nftah, der fuer die anderen Nftahfamilien Auftraege erledigt, doch seinen letzten Auftrag, naemlich ein Grab zu renovieren, gelang ihm aus irgendwelchen unheimlichen Gruenden nicht... Vielleicht kannst Du ihm ja helfen, aber vergiss nicht, dass es dort recht heiss ist!",8,0,1,({"protheg","protheg",}),536,}),"Kampf in der Unterwelt":({35,18000,({"/d/unterwelt/archon/turm/tunnel/npc/caroll",}),"Caroll hat ein Problem mit den Lebenden, insbesondere mit den Dunkelelfen, den widerlichen Elfen und Paladinen. Finde ihn, denn vielleicht kannst Du ihm ja bei der Problemloesung behilflich sein.",20,0,1,({"archon","clementine",}),428,}),"Der Fluch des Einhorns":({25,8000,({"/d/unterwelt/torian/haus/room/wohnzimmer",}),"Der Fluch des Einhorns? Ich habe mal von einem Einsiedler im Sternenwald gehoert, der dringend etwas aus seinem Keller benoetigt, um das letzte Geheimnis des Goldenen Einhorns zu loesen.                              ",12,0,1,({"torian","torian",}),435,}),"Finde den Piratenschatz":({15,10000,({"/d/andracia/yondala/wasser/pirateninsel/obj/piratenschatzkarte",}),"Angeblich ist auf der Pirateninsel vor Andracia ein riesiger Schatz versteckt! ",10,2,1,({"yondala","yondala",}),233,}),"Hustensaft fuer Wassertroepfchen":({25,15000,({"/d/kristallwald/clementine/wassertroepfchen/obj/seq",}),"Hilf dem armen hustenden Wassertroepfchen im Kristallwald nahe der grossen Lichtung!",8,0,1,({"clementine","clementine",}),244,}),"Beschaffe das Ankh des Priesters":({10,3000,({"/d/kristallwald/muaddib/weg/npc/priester",}),"Auf dem Weg nach Elessar wartet ein alter Mann auf Deine Hilfe.",5,0,1,({"muaddib","protheg",}),2839,}),"Der hungrige Dschungelwaechter":({25,24000,({"/d/dschungel/dante/weg/npc/nein",}),"Der Dschungelwaechter hat Hunger vom vielen Wache halten. Vielleicht kannst Du ihm helfen?",10,0,1,({"dante","dante",}),1301,}),"Fippsi, die verwirrte Maus":({6,2000,({"/d/dschungel/dante/weg/npc/qmaus",}),"Fippsi, die Dschungelmaus glaubt ein boeser Drache zu sein. Hilf ihm, sein wahres Ich zu erkennen, wenn Du kannst.",10,0,1,({"dante","dante",}),1484,}),"1000 Qualen im Dorf der Kannibalen":({30,15000,({"/d/dschungel/charon/kannibalendorf/npc/kai",}),"Kannibalendorf... wie blutruenstig! Ein Vater will seine Tochter zurueck, oder doch etwas anderes? Er selbst ist krank - 'Morbus Degeneratus'.",25,0,1,({"charon","dante",}),616,}),"Der Wettkampf der Bogenschuetzen":({25,2000,({"/d/dschungel/feyaria/dorf/room/dorf-017",}),"Im Dorf der Dschungelelfen gibt es ein grosses Turnier, an dem die besten Bogenschuetzen des SilberLandes teilnehmen. Ein Sieg in diesem Turnier waere sicher ein huebsches Abenteuer. Suche einfach den beruehmten Bogenmacher Tenobaal auf, der kann Dir weiterhelfen. Den Weg zu den Dschungelelfen kannst Du in Tijara erfahren.",10,0,1,({"feyaria","feyaria",}),1286,}),"Schrat kann nicht aufwachen":({1,1,({"/d/ebene/fidget/schrat/room/s_zimmer",}),"Der Schrat schlaeft in seiner Huette im Anfaengerpark. Aendere das!",1,2,1,({"fidget","woody",}),4350,}),"Der verschollene Hoehlenforscher":({20,5000,({"/d/gebirge/orw/quest/npc/halron",}),"Halron, der Hoehlenforscher, ist in den Grotten unter Felonia verschollen. Er wollte dort die Tierwelt der Grotte erforschen. Suche ihn und hilf ihm, seine Aufgabe zu vollenden, damit er wieder zu den anderen Zwergen zurueckkehren kann.",25,0,1,({"orw","feyaria",}),625,}),"Finde die verlorene Schriftrolle":({50,15000,({"/d/gebirge/speedy/laby/npc/saruman",}),"Hilf Saruman, der in der Naehe der Zwergensiedlung wohnt, eine geheimnisvolle Schriftrolle aus dem Labyrinth zu retten.",18,0,1,({"speedy","woody",}),916,}),"Hilf Gjordil bei seiner Suche":({10,8000,({"/d/gebirge/speedy/trollager/npc/gjordil",}),"Dem alten Troll Gjordil wurde eines seiner liebsten Gegenstaende entwendet. Jetzt braucht er bei seiner Suche Deine Hilfe.",15,0,1,({"zordan","zordan",}),914,}),"Hilf dem weisen Schriftgelehrten":({45,25000,({"/d/gebirge/angrox/quest/tschubax",}),"Dem Schriftgelehrten Tschubax im Bergwerk bei Felonia fehlt noch eine Steintafel fuer seine Arbeiten. Hilf ihm, sie zu finden!",20,0,1,({"angrox","angrox",}),986,}),"Die rasenden Dschungelreporter":({60,60000,({"/d/dschungel/dante/news/obj/pu",}),"Pu Litza wuerde so gerne die erste Ausgabe der Dschungelpost herausgeben. Aber leider sind seine Reporter unfaehig. Vielleicht kannst Du ihm helfen?",35,0,1,({"dante","dante",}),596,}),"Bedrohung aus einer anderen Dimension":({30,15000,({"/d/kristallwald/chivas/weg/npc/aranor",}),"Aranor, der Zauberer, benoetigt Hilfe bei der Aufgabe, Risse zwischen den Dimensionen zu schliessen, die sich im ganzen Silberland auftun.",35,0,1,({"chivas","chivas",}),218,}),"Renoviere das verwahrloste Haus":({20,2000,({"/d/wasser/woody/hausquest/verian",}),"Renoviere das alte, verwahrloste Haus des Fischers Verian und seiner Frau Lena im Fischerdorf, damit die beiden dort wieder einziehen koennen.",5,0,1,({"woody","woody",}),3044,}),"Das geheimnisvolle Amulett":({20,5000,({"/d/wasser/cirion/riff/obj/questobj",}),"Tabar aus Tijara hat ein Amulett verloren, finde es!",15,0,1,({"cirion","cirion",}),608,}),"Der einsame Elfenpirat":({20,10000,({"/d/andracia/yondala/wasser/pirateninsel/npc/pirat_endoriel",}),"Endoriel, der verstossene Elfenpirat moechte seine Frau zurueck - hilf ihm dabei!",5,0,1,({"yondala","yondala",}),64,}),"Das Vermaechtnis der Tigergilde":({30,30000,({"/d/ebene/creative/ivory_tiger/npc/moench",}),"Vannor sucht das Vermaechtnis der Tigergilde. Alleine wird er es nicht schaffen. Kannst Du ihm dabei Hilfe leisten?",30,2,0,({"creative","angrox",}),2,}),"Aristocals Floete":({30,30000,({"/d/andracia/yondala/gebirge/labyrinth/npc/aristocal",}),"Dem Faun Aristocal im Gebirge in Andracia ist seine Floete entwendet worden, macht euch zu zweit auf die Suche danach!",10,0,1,({"yondala","yondala",}),28,}),"Das Siegel der Elemente":({20,50000,({"/d/nacht/gwenshara/siegel/room/siegel",}),"In der Klamm der Seelen liegt einer der wenigen Zugaenge zur dunklen Seite des Silberlands. Vor langer Zeit hat dort ein Druide eine finstere Kreatur der Nacht hinter einem Siegel eingesperrt. Dieses Siegel scheint nun bruechig. Kannst du es staerken oder willst du die Kreatur gar selbst befreien? Der Barde Orasimandolias hat sich bereits aufgemacht. Hilf ihm!",35,2,1,({"gwenshara","gwenshara",}),29,}),"Der entlaufene Hund":({5,5000,({"/d/kristallwald/gwenshara/suedwald/npc/edila",}),"Dem Hobbitmaedchen Edila ist auf ihrer Wanderung im Kristallwald ihr Hund Oli entlaufen. Kannst du ihn ihr wiederbringen?",5,2,1,({"gwenshara","gwenshara",}),15,}),"Das Experiment des Wiedererweckers":({20,20000,({"/d/gebirge/gwenshara/geisterhaus/room/doktor",}),"Tief in der gruseligen Villa beim Friedhof lebt der Doktor Frank N. Stein, ein Meister der Wissenschaft und des Okkulten. Er verfolgt einen ungewöhnlichen, aber faszinierenden Plan: die Wiederbelebung von Geistern in zusammengesetzten Körpern. Kannst du ihm helfen sein Werk zu vervollstaendigen?",20,0,1,({"gwenshara","gwenshara",}),28,}),])
