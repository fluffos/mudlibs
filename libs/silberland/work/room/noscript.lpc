inherit "/std/room";
#include <properties.h>
#include <moving.h>

nosave string x;
nosave string *xx;

void create() {
  ::create();
  x="----------";
  xx=({
    "/d/wasser/room/nordufer/weg04",
    "/d/wasser/room/ostufer/weg04",
    "/d/wasser/room/gildeninsel/bruecke2",
    "/d/wald/room/waldweg/oweg04",
    "/d/wald/room/waldweg/wweg04"
  });
  SetProp(P_LIGHT,1);
  SetProp(P_INT_LONG,
"Dieser Raum ist fuer Leute, die TF spielen lassen.\n\
Es gibt nur einen Weg heraus...\n");
  AddCmd("","raus",1);
}

void init() {
  int i;
  
  ::init();
  for (i=0;i<10;i++)
    x[i]='a'+random(26);
}

varargs string GetExits(object viewer) {
  return sprintf("Es gibt einen sichtbaren Ausgang: %s.\n",x);
}

varargs int raus(string s) {
  if (query_verb()!=x)
    return 0;
  notify_fail("Etwas hat nicht funktioniert. Bitte verstaendige einen Magier.\n");
  return ((this_player()->move(xx[random(sizeof(xx))],M_GO))>0);
}
