#pragma strong_types

inherit "std/store";

#include <properties.h>

void create()
{
  ::create();
}

void _register_shop(object ob)
{
  ::_register_shop(ob);
  log_file("room/STORAGEROOM_MISSING",
      sprintf("[%s] %O\n", dtime(time()), ob));
}

