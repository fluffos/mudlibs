/*
 * SilberLand MUDlib (LDMud -> FluffOS Strategy A room).
 * Original LDMud room preserved as /room/void_ldmud.lpc.
 */

inherit "/catalog/room";

void create() {
  ::create();
  set_short("Das Nichts");
  set_long(
    "Du schwebst im absoluten, ewigen und leeren Nichts umher. Hier kommen "
    "all die hin, deren Welt, in der sie sich befanden, zerstoert worden ist. "
    "Mit 'welt' gelangst Du wieder in die Abenteurergilde zurueck.\n"
  );
  set_exits(([
    "welt": "/gilden/abenteurer",
    "raus": "/gilden/abenteurer",
  ]));
  set_items(([
    "nichts":
    "Du kannst es kaum fassen, wie wenig das Nichts nach etwas aussieht.\n",
  ]));
}
