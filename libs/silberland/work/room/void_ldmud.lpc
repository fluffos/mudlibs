/*
 * room/void.c
 * ---
 * Das Nichts. Auslagerungsraum fuer den absoluten Notfall.
 *
 */

inherit "std/room";

#include <properties.h>
#include <moving.h>
#include <wizlevels.h>

create()
{
  ::create();
  SetProp(P_LIGHT, 1 );
  SetProp(P_INT_SHORT, "Das Nichts" );
  SetProp(P_INT_LONG,
    "Du schwebst im absoluten, ewigen und leerem Nichts umher. Hier kommen\n"
   +"all die hin, deren Welt, in der sie sich befanden, zerstoert worden ist.\n"
   +"Wenn Du das magische Kommando 'welt' gibst, wirst Du wieder in Deine Welt\n"
   +"zurueckversetzt werden.\n"
  );
  AddDetail( ({ "nichts", "leere" }),
    "Du kannst es kaum fassen, wie wenig das Nichts nach etwas aussieht.\n" );
  AddCmd( "welt", "welt" ); /* im Nichts gibt es keine 'exits' */
}

welt()
{
  this_player()->move("/gilden/abenteurer", M_TPORT);
  return 1;
}

