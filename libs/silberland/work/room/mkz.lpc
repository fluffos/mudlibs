inherit "std/room";
inherit "std/more";

#define wrs(s,str) s+=str

#include <properties.h>
#include <wizlevels.h>
#include <language.h>
#include <rooms.h>
#include <moving.h>

create()
{
  room::create();
  SetProp(P_LIGHT,1);
  SetProp(P_INT_LONG,
	"Du befindest Dich in einem halbfertigen Kontrollraum. Aus riesigen Schalt-\n"
  "kaesten und -tafeln schaut ein Gewirr aus bunten Kabeln hervor. Wenn\n"+
  "dem alle Faeden zusammenlaufen und von dem aus das Mud gesteuert wird.\n"+
  "An einer Wand haengt eine Kontrolltafel, die halbwegs fertig aussieht,\n"+
	"daneben befindet sich ein Pult mit ein paar leuchtenden Schaltern.\n"+
	"Du kannst von hier aus in den Arbeitsraum eines jeden Magiers kommen,\n"+
	"indem Du einfach nur seinen Namen tippst.\n");
  SetProp(P_INT_SHORT,"Mud-Kontollzentrum");
  SetProp(P_INDOORS, 1);
  AddSpecialDetail(({"tafel","kontrolltafel"}),"tafel");
  AddDetail(({"pult","schaltpult","kontrollpult"}),
            "Die Knoepfe sind wie folgt beschriftet:\n"+
            "1. Reparatur (preloading wird wiederholt, birgt KEINE Risiken)\n"+
            "4. Armageddon (Zeitspanne 10 Minuten)\n");
  AddExit("ebene","/d/ebene/hadra/dorf/rooms/w_dorf_5_4");
  AddExit("gebirge","/d/gebirge/room/zkapelle");
  AddExit("nordland","/d/nordland/hadra/raetsel/rooms/main");
  AddExit("tundra","/d/tundra/kaig/workroom");
  AddExit("unterwelt","/d/unterwelt/death/katakomben/rooms/katakomben_eingang_1");
  AddExit("wald","/d/wald/room/elfendorf/kapelle");
  AddExit("wasser","/d/wasser/room/gildeninsel/insel24");
  AddExit("wolken","/d/wolken/mupfel/room/wolkenbank");
  AddExit("wueste","/d/wueste/room/wueste/wuestein");
  AddCmd(({"drueck","druecke"}),"druecke");
  AddCmd("","workroom",1);
}

workroom() {
  string pln,plw;
  if (query_verb()[0] < 'a' || query_verb()[0] > 'z')
    return 0;
  if (file_size("/players/"+query_verb()) != -2)
    return 0;
  plw="/players/"+query_verb()+"/workroom";
  pln=capitalize(query_verb());
  this_player()->move(plw,130,"in den Arbeitsraum von "+pln,"teleportiert","kommt herein");
  return 1;
}

secure()
{
  object po, ti;
  
  //  if (!(po=previous_object())) return 0;
  //  if (!(ti=this_interactive())) return 0;
  //  if (getuid(po) != getuid(ti)) return 0;
  //  if (geteuid(po)!=geteuid(ti)) return 0;
  return 1;
}


tafel()
{
  string s, *tmp;
  int t,t2,idle_1,idle_5,magier,osnabrueck,i;
  
  osnabrueck=0;
  idle_5=0;
  idle_1=0;
  magier=0;
  s="";
  for (i=0;i<sizeof(users());i++)
  {
    tmp=query_ip_number(users()[i]);
    tmp=explode(tmp,".");
    if (sizeof(tmp)==4 && 
        ((tmp[0]=="131" && tmp[1]=="173") || (tmp[0]=="127" && tmp[1]="0")))
      osnabrueck++;
    tmp=query_idle(users()[i]);
    if (tmp>300)
      idle_5++;
    else
      if (tmp>60) 
        idle_1++;
    if (IS_WIZARD(users()[i]))
      magier++;
  }
  wrs(s,"Diese Kontrolltafel gibt Auskunft ueber ein paar wichtige Daten des Muds.\n");
  wrs(s,sprintf(
  "Es %s sich zur Zeit %d Person%s im Mud auf. %d davon %s Magier. Von den\n"+
  "Teilnehmern %s %d zwischen 1 und 5 Minuten, %d ueber 5 Minuten inaktiv. %d der\n"+
  "Mitspieler komm%s aus Osnabrueck.\n",
  (sizeof(users())==1 ? "haelt" : "halten"), sizeof(users()),
  (sizeof(users())==1 ? "" : "en"), magier,
  (magier==1 ? "ist" : "sind"), 
  (idle_1==1 ? "ist":"sind"), idle_1, idle_5, osnabrueck,
  (osnabrueck==1 ? "t":"en")));
  t=time()-last_reboot_time();
  wrs(s,"Anderland ist "+dtime(last_reboot_time())+" zuletzt neu gebooted worden.\n"+
        "Damit ist es seit "+t+" Sekunden aktiv, das entspricht\n");
  t2=t;
  if (t>=86400)
  {
    wrs(s,t/86400+" Tag");
    if (t>=86400*2) 
    wrs(s,"en");
    wrs(s,", ");
    t2=t2%86400;
  }
  if (t>=3600)
  {
    wrs(s,t2/3600+" Stunde");
    if (t2/3600!=1) 
      wrs(s,"n");
    wrs(s,", ");
    t2=t2%3600;
  }
  if (t>=60)
  {
    wrs(s,t2/60+" Minute");
    if (t2/60!=1)
      wrs(s,"n");
    wrs(s," und ");
    t2=t2%60;
  }
  wrs(s,t2+" Sekunde");
  if (t2!=1)
    wrs(s,"n");
  wrs(s,".\n");
	wrs(s,"Anderland existiert seit ca. "+exist_days()+" Tagen.\n");
  More(s,0);
  return "";
}

druecke(str)
{
  object ti;

  if (!secure()) return;
  if (!str) return;
  ti=this_interactive();
  if (!IS_WIZARD(ti))
  {
    write("Du versuchst, einen der Knoepfe am Pult zu beruehren, doch dabei wird Dir ent-\n"+
          "setzlich schwindlig ... Du beschliesst, dass das wohl keine sehr gute Idee war.\n");
    return 1;
  }
  switch (str)
  {
    case "1":
    case "reparatur":
      write("Ok.\n");
      say(ti->name(WER)+" startet den Reparaturmechanismus.\n");
      "secure/master"->redo_preload();
      return 1;
    case "4":
    case "armageddon":
      write("Armageddon ausgeloest.\n");
      shout(ti->name(WER)+" hat Armageddon ins Spiel geholt !\n");
      "obj/shut"->shut(10);
      return 1;
  }
}

exit() // War schon oefter so, das Magier hier walking monsters erzeugt
  // haben, die dann in die Gilde gehopst sind ... die exits
  // zu sperren hat auch keinen Sinn - Sirs MNPC moved sich dann
  // doch an seinen Startpunkt. Naja, machen wir es eben SO - Monster
  // haben hier eh nix verloren.
{
  object tp;
  
  tp=previous_object();
  if (!query_once_interactive(tp))
    call_out("do_destruct",1,tp);
}

do_destruct(ob)
{
  if (ob)
    ob->remove();
  if (ob)
    destruct(ob);
}
