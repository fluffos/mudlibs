/*
 * SilberLand MUDlib (LDMud -> FluffOS Strategy A room).
 * Original LDMud room preserved as /room/treff_ldmud.lpc.
 */

inherit "/catalog/room";

void create() {
  ::create();
  set_short("Das juengste Geruecht");
  set_long(
    "Dies ist ein Raum, den die Spieler gerne und oft als 'das juengste "
    "Geruecht' bezeichnen. Hier werden naemlich wichtige Entscheidungen im "
    "Morgengrauen diskutiert und beschlossen. Demzufolge ist dies ein reiner "
    "Magierraum. Man kann sich hier treffen, reden oder einfach herumidlen.\n"
  );
  set_exits(([
    "unten": "/gilden/abenteurer",
  ]));
}
