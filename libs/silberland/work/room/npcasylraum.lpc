#include <properties.h>
#include <moving.h>
#include <defines.h>
#include <moredef.h>
#include <wizlevels.h>

inherit "/std/room.lpc";

void create()
{
  ::create();
  SetProp(P_INT_SHORT, "Asylraum fuer NPCs");
  SetProp(P_INT_LONG, 
    "Ein Asylraum fuer geplagte, verfolgte und sichversteckenwollende NPCs.");
}

void init()
{
  ::init();
  if( TP && query_once_interactive(TP) && !IS_LEARNER(TP) )
    TP->move(TP->QueryProp(P_LAST_COMMAND_ENV), M_NO_SHOW|M_SILENT);
}
