/*
 * /room/jail.c
 * ---
 * Das Gefaengnis, fuer weniger erfreuliche Zwischenfaelle
 *
 */

/*
 * Bug gefixt: Man befindet sich nun nicht mehr im ed wenn man im Jail war.
 * Hier wurde input_to im init aufgerufen->darf nicht gemacht werden!!
 * 13.11.96 Eros
 *
 * Mitloggen, wer einen Spieler ins jail transt
 * Eigenes sage kommando.
 * 20.05.97 Feyaria
 */

/*
 * Eigentlich gehoert das Jail ja unter Denkmalschutz. *brrr*
 * Bisschen aufgeraeumt. 12. Nov 2000, Woody.
 *
 * JAIL log nach /log/room/ verlegt.
 * 16.2.2001, Woody.
 *
 */


#pragma strong_types

inherit "std/room";

#include <properties.h>
#include <wizlevels.h>
#include <moving.h>

#define ALLOWED ({ "sag", "sage", "ja", "nein", "nick", "nicke" })
#define LOOKVERB ({ "unt", "untersuch", "untersuche", \
                    "betracht", "betrachte", "betr", "schau", "schaue" })


void create()
{
  ::create();

  SetProp(P_LIGHT, 1);
  SetProp(P_INDOORS, 1);
  SetProp(P_INT_SHORT, "Eine Gefaengniszelle");
  SetProp(P_INT_LONG,
    "Du stehst (ja klar, dachtest Du etwa, hier koenntest Du sitzen?) in "
    "einer Gefaengniszelle, deren absolute Eintoenigkeit nur noch durch die "
    "beklemmende Stille uebertroffen wird. Fenster gibts hier keine, eine "
    "schwach flackernde Fackel erhellt den Raum auf sehr notduerftige Weise.\n"
    "Ausser sag, ja und nein kannst Du hier nichts machen. Schade!\n");

  SetProp (P_ENVIRONMENT,
      ([ ENV_TERRAIN:TT_HOUSE, ENV_TEMPERATURE:16 ]) );

  SetProp(P_NO_TPORT, NO_TPORT | NO_TPORT_OUT);
  AddCmd("", "abc", 1);
}


void init()
{
  ::init();

  if (this_player() != this_interactive())
    write_file("/log/room/JAIL",
        sprintf("[%s] %O steckt %O (%O) ins Jail\n", dtime(time()),
            this_interactive(), this_player(),
            this_player()->QueryProp(P_LAST_COMMAND_ENV)));
}


int abc(string str)
{
  if (IS_ELDER(this_player()))
    return 0;

  if (query_verb()[0] == '\'')
    return 0;

  if (member(ALLOWED, query_verb()) != -1)
    return 0;

  if (member(LOOKVERB, query_verb()) != -1)
    if (str)
      write("Also mit Details solltest Du Dich hier echt nicht befassen!\n");
    else
      return 0;
  else
    write("Du kannst nur schau, sag, ja und nein machen!\n");

  return 1;
}

