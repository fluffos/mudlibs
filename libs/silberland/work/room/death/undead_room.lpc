// Todesraum fuer undead-shell
// 27.2.2004 Feyaria

#pragma strong_types

#include <properties.h>
#include <moving.h>
#include <language.h>
#include <wizlevels.h>
#include <combat.h>
#include <new_skills.h>

inherit "/std/room";

void init()
{
  string prayroom;
  int res;

  ::init();

  if (!this_player())
    return;
  if (!query_once_interactive(this_player()))
    this_player()->remove();
  if (this_player()->QueryProp(P_RACE) == "Untoter" && 
     this_player()->QueryProp(P_GHOST)) 
    call_out("move_to_guild", 6 + random(5));
}

void reset()
{
  ::reset();
}

void create()
{
  ::create();

  SetProp(P_NAME, "Lars");
  SetProp(P_GENDER, MALE);
  SetProp(P_ARTICLE, 0);
  SetProp(P_LIGHT, 0);
  SetProp(P_INT_SHORT,"Die ewige Verdammnis");
  SetProp(P_INT_LONG,
    "Dein Koerper wurde vernichtet, aber die unheilige Magie, die Deine "
    "untote Existent aufrecht erhaelt, ist immer noch stark. Neue Lebenskraft "
    "fliesst Dir aus der Seelenmuehle zu und bald wird Dein Koerper zu neuem "
    "untoten Leben auferstehen.");
}

void move_to_guild()
{
  if (!this_player())
    return;
  this_player()->SetProp(P_GHOST, 0);
  this_player()->SetProp(P_HP, this_player()->QueryProp(P_MAX_HP) / 2);
  this_player()->SetProp(P_SP, 1);
  this_player()->SetProp(P_NEXT_SPELL_TIME, time() + 30);
  this_player()->move("/gilden/nekromanten", M_NOCHECK|M_SILENT);
}
