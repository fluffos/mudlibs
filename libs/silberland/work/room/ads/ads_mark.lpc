#include <moving.h>
#include <properties.h>
#include <language.h>

inherit "std/thing";

string wherehaveibeen;
mixed oldhooks;

void start_ads();

void create()
{
  ::create();
  AddId("\nads_mark");
  SetProp(P_NAME, "Stempel der Werbung");
  SetProp(P_GENDER, MALE);
  SetProp(P_SHORT, 0);
  SetProp(P_INVIS, 1);
}

void reset()
{
  ::reset();
  if (environment() && !query_once_interactive(environment()))
    remove();
}

void init()
{
  ::init();
  start_ads();
}

/*
 * Function name: start_ads
 * Description:   Start the ads sequence.
 */
void start_ads()
{
  object my_host;

  my_host = environment();
  if (!my_host||!living(my_host)) return;
  say("Du siehst eine Lichtgestalt, die etwas Dunst einsammelt... "
      "oder vielleicht\nbildest Du Dir das auch nur ein...\n");
  wherehaveibeen = file_name(environment(my_host));
  oldhooks = my_host->QueryProp(P_HP_HOOKS);
  my_host->SetProp(P_HP_HOOKS, 0);
  my_host->move("/room/ads/ads_room",
                M_GO | M_NOCHECK | M_SILENT | M_NO_SHOW);
}

int move(mixed dest, int method)
{
  if (!method & M_NOCHECK) return 0;
  return ::move(dest,method);
}

int _query_autoloadobj() { return 1; }

string original_env()
{
  return wherehaveibeen;
}

string original_hooks()
{
  return oldhooks;
}
