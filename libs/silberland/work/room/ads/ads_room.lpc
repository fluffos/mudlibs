#pragma strong_types

#include <properties.h>
#include <moving.h>
#include <language.h>
#include <wizlevels.h>
#include <combat.h>

#define P_LAST_ADS_SEQUENCE "last_ads_sequence"
#undef DEBUG

inherit "/std/room";

mixed *players;
mapping msgCache;


void add_player(object pl);
varargs void flush(int unusedOnly);
void do_remove();
void remove_player(int num);


void init()
{
  string origroom;
  int res;
  object ob;

  ::init();

  if(!query_once_interactive(this_player()))
  {
    this_player()->move("/room/npcasylraum", M_GO);
    return;
  }
  if (!IS_WIZARD(this_player())) add_action("filter", "", 1);
  if (!(origroom=this_player()->QueryProp(P_TMP_PRAY_ROOM)) &&
      !(origroom=this_player()->QueryPrayRoom())) 
  {
    origroom="/room/pray_room";
  }
  if (this_player()->QueryProp(P_GHOST))
  {
    if (IS_WIZARD(this_player()) && this_player()->QueryProp(P_WANTS_TO_LEARN))
    {
      if (!this_player()->QueryProp(P_INVIS))
        call_out("room_msg",1,"Der Kapitalismus sagt: WAS WILLST DU HIER, "+
            upperstring(this_player()->name())+"?\n"+
            "DU BIST UNSTERBLICH, DU HAST HIER NICHTS ZU SUCHEN!\n\n");
    }
    else
    {
      write("Der Kapitalismus sagt: WAS TUST DU HIER? "+
          "DEINE ZEIT IST NOCH NICHT REIF!\n\n");
      if (catch(res=this_player()->move(origroom,M_GO|M_NOCHECK|M_SILENT)) ||
          (res != 1) && (environment(this_player())==this_object()))
        this_player()->move("/room/pray_room",M_GO|M_NOCHECK|M_SILENT);
    }
    return;
  }
  add_player(this_player());
  set_heart_beat(1);
}

void reset()
{
  ::reset();
  flush(1);
}

void create()
{
  ::create();
  players= ({});
  flush();

  SetProp(P_LIGHT, 0);
  SetProp(P_INT_SHORT,"Werbezentrale");
  SetProp(P_INT_LONG,
    "Ein heller Raum, erleuchtet von flimmerndem Licht, das in allen Farben "
    "des Spektrums froehlich vor sich hinflackert. Im bunten "
    "Licht erkennst Du einen zentral aufgestellten Schreibtisch, der mit "
    "Diagrammen und Buechern bedeckt ist. Die Waende sind mit Werbeplakaten "
    "verhaengt, die alle verschiedenste Dinge anpreisen.");
}

varargs void flush(int unusedOnly)
{
  string *mi;
  int i;

  if (!unusedOnly)
    msgCache = ([]);
  else if (i=sizeof(mi=m_indices(msgCache))) {
    for (i-=1; i>=0; i--) {
      if (msgCache[mi[i],1])
        msgCache[mi[i],1] = 0;
      else
        msgCache = m_delete(msgCache, mi[i]);
    }
  }
}


private nosave
string expand(string table, int value)
{
  int sz, wert, i;
  string *texte;

  sz = sizeof(texte = explode(table, "##"));
  wert=0;
  for (i = 0; i < sz; i++)
    if (i%2) {
      sscanf(texte[i],"%d",wert);
      if (value < wert) break;
    } else
      table=texte[i];

  return table;
}

#define TOS(s) s[<1]
#define STOS(s) s[<2]
#define PUSH(x,s) (s+= ({ x }))
#define POP(s)	(s=s[0..<2])

private nosave
string parseText(string msg, object pl)  /* ziemlich vom htmld abgekupfert ;) */
{
  string *words, *texte, *todo, *done, tmp, cmd;
  int i,k, sz;
  int endFlag;

  sz = sizeof(words = regexplode(msg, "[<][^<]*[>]"));
  todo = ({ });
  done = ({""});

  for (i=1; i<sz; i+=2) {
    cmd = words[i][1..<2];
    TOS(done) += words[i-1];

    if (cmd[0]=='/') {
      endFlag = 1;
      cmd = cmd[1..];
    }
    else
      endFlag = 0;

    switch(cmd[0]) {
      case 'A': /*** Alignment ersetzen ***/
      if (!endFlag) {
        PUSH(cmd, todo); PUSH("",done);
      }
      else
        if (todo[<1] == "A") {
          STOS(done) += expand(TOS(done), pl->QueryProp(P_ALIGN));
          done = done[0..<2];
          todo = todo[0..<2];
        }
      break;

      case 'D': /*** Tode ersetzen ***/
      if (!endFlag) {
        PUSH(cmd, todo); PUSH("",done);
      }
      else
        if (todo[<1] == "D") {
          STOS(done) += expand(TOS(done), pl->QueryProp(P_DEADS));
          POP(done); POP(todo);
        }
      break;

      case 'L': /*** Level ersetzen ***/
      if (!endFlag) {
        PUSH(cmd, todo); PUSH("",done);
      }
      else
        if (todo[<1] == "L") {
          STOS(done) += expand(TOS(done), pl->QueryProp(P_LEVEL));
          POP(done); POP(todo);
        }
      break;

      case 'S': /*** Seher ersetzen ***/
      if (!endFlag) {
        PUSH(cmd, todo); PUSH("",done);
      }
      else {
        if(sizeof(texte=efun::explode(TOS(done),":"))==2)
          STOS(done) += texte[query_wiz_level(pl) > 0];
        POP(done); POP(todo);
      }
      break;

      case 'Z': /*** Zufall ersetzen ***/
      if (!endFlag) {
        PUSH(cmd, todo); PUSH("",done);
      }
      else {
        if (todo[<1][0] == 'Z') {
          int cnt, rnd, wert, sz2;

          if (!sscanf(todo[<1], "Z=%d", rnd))
            STOS(done) += "\n###\n### Syntax Error in <Z>!\n###\n\n";
          else {
            rnd=random(rnd);
            sz2=sizeof(texte=efun::explode(TOS(done),"##"));wert=0;cnt=0;
            for (k=1;k<sz2;k+=2) {
              sscanf(texte[k],"%d",wert);
              cnt+=wert;
              if (rnd<cnt) {
                STOS(done)+=texte[k+1];
                break;
              }
            }
          }
          POP(done); POP(todo);
        }
      }
      break;

      case 'G': /*** Gender ersetzen ***/
      if (!endFlag) {
        PUSH(cmd, todo); PUSH("",done);
      }
      else {
        if(sizeof(texte=efun::explode(TOS(done),":"))==2)
          STOS(done) += texte[pl->QueryProp(P_GENDER)==FEMALE];
        POP(done); POP(todo);
      }
      break;

      case 'R': /*** Rasse ersetzen ***/
      if (!endFlag) {
        PUSH(cmd, todo); PUSH("",done);
      }
      else
      {
        int race;

        texte = efun::explode(TOS(done), "|");
        race = member( ({ "Mensch","Elf","Zwerg","Hobbit","Dunkelelf","Troll",
                          "Oger","Fee" }), pl->QueryProp(P_RACE)) + 1;

        STOS(done) += texte[race < sizeof(texte) ? race : 0];
        POP(done); POP(todo);
      }
      break;

      case 'n': /*** Name, normal geschrieben ***/
      TOS(done) += (string) pl->name(RAW);
      break;

      case 'N': /*** Name, in Grossbuchstaben ***/
      TOS(done) += (string) upperstring(pl->name(RAW));
      break;
    }
  }
  PUSH(words[<1], done);
  return implode(done, "");
}


void heart_beat()
{
  int j,nr;
  string msg;

  j=0;
  while (j<sizeof(players))
    if (!objectp(players[j][0]) || environment(players[j][0])!=this_object())
      players=players[0..j-1]+players[j+1..];
    else
      j++;

  if (!sizeof(players)) {
    set_heart_beat(0);
    return;
  }

  for (j=sizeof(players)-1;j>=0;j--)
  {
    nr=players[j][1]++;

    if (mappingp(players[j][2]))
      msg=players[j][2][nr];
    else
      msg=0;
    if (!msg)
      msg=players[j][3][1][nr];
    if (msg)
      tell_object(players[j][0],parseText(msg,players[j][0]));

#ifdef DEBUG
    tell_object(players[j][0], "Sequenzbonus +1 LP\n");
#endif
    players[j][0]->heal_self(1);        // Bonus: +1 LP/MP pro HB :)
  }
  do_remove();
}


void do_remove()
{
  int j, nr, res;
  string origroom;
  object plobj, pl;

  nr=sizeof(players);
  for (j=0;j<nr;j++) {
    if (players[j][1]>=players[j][3][0]) {
      pl = players[j][0];

      while (plobj = present("\nads_mark", pl))
      {
        pl->SetProp(P_HP_HOOKS, plobj->original_hooks());
        origroom = plobj->original_env();
        plobj->remove();
      }
      if (!origroom) {
        origroom="/room/pray_room";
      }
      // Jetzt wird der Spieler in die Kapelle gebracht
      if (catch(res=pl->move(origroom,M_GO|M_NOCHECK|M_SILENT)) || !res)
        pl->move("/room/pray_room",M_GO|M_NOCHECK);
      remove_player(j);
      do_remove();
      pl->SetProp(P_TMP_PRAY_ROOM, 0); // temporaeren origroom ruecksetzen
      return;
    }
  }
}

int nodot(string str) { return (str[0] != '.'); }

varargs mixed get_sequence(object pl, string str)
{
  string *sequences, *selected, seq, txt, *pl_seq;
  int i,len,cacheable,tmark,ofs;
  mapping m;

  if (!stringp(str) || file_size(str) <= 0)
  {
    sequences = filter_array( get_dir("/room/ads/sequences/*"), "nodot" );
#ifdef DEBUG
    tell_object(pl, sprintf("Es gibt: %O\n",sequences));
#endif
    selected = sequences + ({});        // copy
    i = sizeof(sequences);
    if (pointerp(pl_seq = pl->QueryProp(P_LAST_ADS_SEQUENCE)))
      selected -= pl_seq;  // bereits gesehene Sequenzen abziehen
    else
      pl_seq = ({});  // Erste Werbung -> neues Array

#ifdef DEBUG
    tell_object(pl, sprintf("Ungesehen: %O\n",selected));
#endif
    if (!sizeof(selected))
      seq = sequences[random(sizeof(sequences))];
    else
      seq = selected[random(sizeof(selected))];

    pl_seq += ({ seq });
    if (sizeof(pl_seq) > i/2)           // Spieler hat Haelfte schon gesehen
      pl_seq -= ({ pl_seq[0] });        // aelteste wieder freigeben
    pl->SetProp(P_LAST_ADS_SEQUENCE, pl_seq);
#ifdef DEBUG
    tell_object(pl, sprintf("Sie sehen %s\n",seq));
#endif
    log_file("interactive/ADS",
        sprintf("[%s] %s sieht %s\n",
          ctime(), capitalize(getuid(pl)), seq));

    str = "/room/ads/sequences/" + seq;
  }

  if (cacheable=((strlen(str)>21) && (str[0..21]=="/room/ads/sequences/"))) {
    if (member(msgCache, str)) {
      msgCache[str,1] = 1;  // Touch it!
      return msgCache[str];
    }
  }
  sequences=efun::explode(read_file(str),"\n");
  sscanf(sequences[0],"%d",len);
  seq=implode(sequences[1..],"\n");
  sequences=regexplode(seq,"\\+*[0-9][0-9]*:");
  m=([]);
  tmark=0;
  for (i=1;i<sizeof(sequences)-1;i+=2) {
    if (sequences[i][0]=='+') tmark+=to_int(sequences[i][1..]); // relativer/
    else tmark=to_int(sequences[i]);                 // absoluter Zeitmarker
    m[tmark]=sequences[i+1];
  }
  if (cacheable)
    msgCache += ([ str: ({ len, m }); 1 ]);
  return ({len,m});
}


void add_player(object pl)
{
  // Description:   Adds a player to the list
  int i, kart, kgen;
  int escaped;
  object pre,kill_liv,kill_ob;
  mixed dseq,act_seq,msg_flags;
  string fn;
  mixed killer_name, killer_msg;
  string channel;

  kill_liv=0; kill_ob=0; dseq=0; kart=0; kgen=MALE;
  if (objectp(pre=pl->QueryProp(P_LAST_COMMAND_ENV)))
  {

  }
  for (i=0;pre=previous_object(i);i++) {
    if (!objectp(pre)) continue;
    if (pre==pl) continue;
    fn=file_name(pre);
    if (fn[0..12]=="/secure/login" && !kill_liv)
      escaped=1;
    if (fn[0..7]=="/secure/"&&fn[0..13]!="/secure/merlin") continue;
    if (fn[0..21]=="/room/ads/ads_mark") continue;
    if (living(pre)) {
      kill_liv=pre; // Killer
      break;
    }
    kill_ob=pre; // killendes Objekt
  }
  if (objectp(pre = pl->QueryProp(P_KILLER) || pl->QueryProp(P_LAST_KILLER)))
  {
    dseq = pre->QueryProp(P_ENEMY_DEATH_SEQUENCE);
  }
  if (!dseq && kill_liv && function_exists("QueryProp",kill_liv))
  {
    dseq=kill_liv->QueryProp(P_ENEMY_DEATH_SEQUENCE);
  }
  if (!dseq && kill_ob && function_exists("QueryProp",kill_ob))
  {
    dseq=kill_ob->QueryProp(P_ENEMY_DEATH_SEQUENCE);
  }
  act_seq=0;
  if (mappingp(dseq))
    act_seq=get_sequence(pl, "/room/ads/sequences/lars");
  else if (pointerp(dseq))  // ganze Todessequenz...
    act_seq=dseq;
  else
    if (stringp(dseq))
      act_seq=get_sequence(pl, dseq);
  if (!act_seq) act_seq=get_sequence(pl);
  if (!mappingp(dseq)) dseq=0;

  for (i=sizeof(players)-1;i>=0;i--)
    if (players[i][0] == pl)
      break;

  if (i==-1)
    players+=({({pl,0,dseq,act_seq})});

  i=pl->QueryProp(P_DEADS);
}


void remove_player(int num)
{
  // Description:   Removes a player from the list
  int i, j, x, oldlist;

  players=players[0..num-1]+players[num+1..];
  if (!sizeof(players)) set_heart_beat(0);
}


int filter(string str)
{
  // Description:   Filter out relevant commands.
  string verb;
  object pl;

  pl=this_player();
  verb=query_verb();
  if (verb=="quit" || verb=="ende") {
    write("DU KANNST DEM KAPITALISMUS NICHT ENTRINNEN!\n");
    return 0;
  }
  if (verb=="typo" || verb=="fehler" || verb=="bug" || verb=="idee")
    return 0;
  write("Dein Koerper gehorcht Dir nicht!\n");
  return 1;
}

