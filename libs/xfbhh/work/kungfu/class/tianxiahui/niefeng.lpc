#include <ansi.h>
#include "tianxiahui.h"

#define BLADE       "/clone/obj/blade"

inherit NPC;
inherit F_MASTER;
inherit F_QUESTER;
inherit F_COAGENT;

mixed ask_skill1();
mixed ask_skill2();
mixed ask_skill3();
mixed ask_skill4();
mixed ask_skill5();
mixed ask_skill6();
mixed ask_gou();
mixed ask_suo();
mixed ask_she();
mixed ask_jing();
int ask_me();
string ask_ling();
void create() {
  object ob, ob2;
  set_name("聂风", ({ "nie feng", "nie", "feng" }));
  set("nickname", HIR "神风堂堂主" NOR);
  set("long", @LONG
你对面的是一个一身青衫白布笑如微风的美男子,神风堂堂主聂风
LONG);
  set("title", "神风堂堂主");
  set("gender", "男性");
  set("age", 25);
  set("attitude", "friendly");
  set("shen_type", -1);
  set("str", 300);
  set("int", 300);
  set("con", 300);
  set("dex", 300);
  set("per", 300);

  set("max_qi", 50000000);
  set("max_jing", 4000000);
  set("neili", 55000000);
  set("max_neili", 55000000);
  set("jiali", 2000000);
  set("combat_exp", 250000000);
  set("score", 100000);

  set_skill("force", 2500);
  set_skill("aohanliujue", 2500);
  set_skill("fengshentui", 2500);
  set_skill("bingxinjue", 2500);
  set_skill("dodge", 2500);
  set_skill("unarmed", 2500);
  set_skill("parry", 2500);
  set_skill("blade", 2500);
  set_skill("literate", 2500); ;
  set_skill("martial-cognize", 2500);

  map_skill("force", "bingxinjue");
  map_skill("dodge", "fengshentui");
  map_skill("unarmed", "fengshentui");
  map_skill("parry", "aohanliujue");
  map_skill("blade", "aohanliujue");

  prepare_skill("claw", "wusheng-zhao");
  prepare_skill("strike", "tianchan-zhang");

  create_family("天下会", 11, "堂主");

  set("chat_chance_combat", 120);
  set("chat_msg_combat", ({
    (: perform_action, "unarmed.sui" :),
    (: perform_action, "unarmed.shen" :),
    (: perform_action, "unarmed.feng" :),
    (: perform_action, "blade.feng" :),
    (: perform_action, "blade.fengxue" :),
    (: perform_action, "blade.bing" :),
    (: exert_function, "freeze" :),
    (: exert_function, "powerup" :),
  }));

  set_temp("apply/damage", 100);
  set_temp("apply/unarmed_damage", 100);
  set_temp("apply/armor", 200);

  setup();

  set("inquiry", ([
    "雄霸": "那是家师",
    "聂人王": "那是家父",
    "冷刃冰心": (: ask_skill1 :),
    "疯魔十三刀": (: ask_skill2 :),
    "疯血": (: ask_skill3 :),
    "风行天下": (: ask_skill4 :),
    "随风行": (: ask_skill5 :),
    "神风动": (: ask_skill6 :),
  ]));

  if (clonep()) {
    ob = find_object(BLADE);
    ob2 = find_object(BLADE);

    if (!ob) ob = load_object(BLADE);
    if (!environment(ob)) {
      ob->move(this_object());
      ob->wield();
    } else {
      ob = find_object(BLADE);
      if (!ob) ob = load_object(BLADE);
      if (!environment(ob)) {
        ob->move(this_object());
        ob->wield();
      } else {
        ob = new("/clone/obj/blade");
        ob->move(this_object());
        ob->wield();
      }
    }
    if (!ob2) ob2 = load_object(BLADE);
    if (!environment(ob2)) {
      ob2->move(this_object());
      ob2->wear();
    }
  }
  carry_object("/clone/cloth/bai")->wear();
}

void init() {
  add_action("do_show", "show");
}

void attempt_apprentice(object ob) {
  if (!permit_recruit(ob))
    return;

  if (query("shen", ob) > -100000) {
    command("say 我天下会不收心慈手软之辈");
    return;
  }

  if (query("shen", ob) > -50000) {
    command("say 像你这样心慈手软的人是干不成大事的！");
    return;
  }

  if (query("combat_exp", ob) < 350000) {
    command("say 你现在经验尚浅，不能领会高深的武功，还是先去增长点经验吧。");
    return;
  }

  command("say 好吧，既然如此本堂主就收下你这个徒弟。");
  command("recruit " + query("id", ob));
  set("title", "天下会副堂主", ob);
  return;
}

mixed ask_skill1() {
  object me;

  me = this_player();

  if (query("can_perform/aohanliujue/bing", me))
    return "你不是已经会了吗？";

  if (query("family/family_name", me) != query("family/family_name"))
    return RANK_D->query_respect(me) + "和本教素无瓜葛，何出此言？";

  if (me->query_skill("aohanliujue", 1) < 1)
    return "你连软红蛛索都没学，何谈此言？";

  /*if( query("family/gongji", me)<300 )
                return "你在教中所作的贡献还不够，这招我不忙传你。";*/

  /*if( query("shen", me)>-30000 )
                return "心慈手软的人永远成不了大器，这招你不学也罢！";*/

  if (me->query_skill("aohanliujue", 1) < 500)
    return "你的傲寒六诀还练得不到家，自己下去练练再来吧！";

  message_sort(HIY "\n$n" HIY "点了点头，从腰间取下长刀，手腕轻轻一抖，顿"
    "时刀影重重，风雪交加,完全笼罩$N" HIY "的四周，直看得$N" HIY "目瞪口"
    "呆。\n\n" NOR, me, this_object());

  command("nod");
  command("say 这一招便是傲寒六诀绝技冷刃冰心，你可看明白了？");
  tell_object(me, HIC "你学会了「冷刃冰心」。\n" NOR);

  if (me->can_improve_skill("blade"))
    me->improve_skill("blade", 1500000);
  if (me->can_improve_skill("aohanliujue"))
    me->improve_skill("aohanliujue", 1500000);
  me->improve_skill("martial-cognize", 1500000);
  set("can_perform/aohanliujue/bing", 1, me);

  return 1;
}

mixed ask_skill2() {
  object me;

  me = this_player();

  if (query("can_perform/aohanliujue/feng", me))
    return "你不是已经会了吗？";

  if (query("family/family_name", me) != query("family/family_name"))
    return RANK_D->query_respect(me) + "和本会素无瓜葛，何出此言？";

  if (me->query_skill("aohanliujue", 1) < 1)
    return "你连傲寒六诀都没学，何谈此言？";

  /*if( query("family/gongji", me)<1300 )
                return "你在教中所作的贡献还不够，这招我不忙传你。";*/

  if (query("shen", me) > -50000)
    return "心慈手软的人永远成不了大器，这招你不学也罢！";

  if (me->query_skill("aohanliujue", 1) < 360)
    return "你的傲寒六诀还练得不到家，自己下去练练再来吧！";

  message_sort(HIY "\n$n" HIY "点了点头，道：“本堂主今天便传你这招，你可"
    "看好了！”$n" HIY "说罢，从腰间取下雪饮狂刀，一声怒喝，双眼一红,手中长"
    "刀狂舞，漫天刀影顿时幻作无数小圈，铺天盖地罩向$N" HIY "。"
    "\n\n" NOR, me, this_object());

  command("nod");
  command("say 这一招便是傲寒六诀绝技疯魔十三刀，你可看明白了？");
  tell_object(me, HIC "你学会了「疯魔十三刀」。\n" NOR);

  if (me->can_improve_skill("blade"))
    me->improve_skill("blade", 1500000);
  if (me->can_improve_skill("aohanliujue"))
    me->improve_skill("aohanliujue", 1500000);
  me->improve_skill("martial-cognize", 1500000);
  set("can_perform/aohanliujue/feng", 1, me);

  return 1;
}

mixed ask_skill3() {
  object me;

  me = this_player();

  if (query("can_perform/aohanliujue/fengxue", me))
    return "你不是已经会了吗？";

  if (query("family/family_name", me) != query("family/family_name"))
    return RANK_D->query_respect(me) + "和本人素无瓜葛，何出此言？";

  if (me->query_skill("aohanliujue", 1) < 1)
    return "你连傲寒六诀都没学，何谈此言？";

  if (query("shen", me) > -80000)
    return "心慈手软的人永远成不了大器，这招你不学也罢！";

  /*if( query("family/gongji", me)<1500 )
                return "你在教中所作的贡献还不够，这招我不忙传你。";*/

  if (me->query_skill("aohanliujue", 1) < 160)
    return "你的傲寒六诀还练得不到家，自己下去练练再来吧！";

  message_sort(HIY "\n$n" HIY "对$N" HIY "赞许地点了点头，道：“既然你如"
    "此有心，为师就再传你这招！”说完$n" HIY "招了招手，$N"
    HIY "连忙凑上前去，只见$n" HIY "轻声在$N" HIY "说了些话，"
    "接着手中长刀一抖，登时双眼一红全身颤抖起来杀气四放!\n" NOR, me, this_object());

  command("sweat");
  command("nod");
  command("say 这一招便是傲寒六诀绝技疯血，你下去需勤加练习！");
  tell_object(me, HIC "你学会了「疯血」。\n" NOR);

  if (me->can_improve_skill("blade"))
    me->improve_skill("blade", 1500000);
  if (me->can_improve_skill("aohanliujue"))
    me->improve_skill("aohanliujue", 1500000);
  me->improve_skill("martial-cognize", 1500000);
  set("can_perform/aohanliujue/fengxue", 1, me);

  return 1;
}

mixed ask_skill4() {
  object me;

  me = this_player();
  if (query("can_perform/fengshentui/feng", me))
    return "这招我已经教过你了，还是自己下去多多练习吧！";

  if (query("family/family_name", me) != query("family/family_name"))
    return RANK_D->query_respect(me) + "和本会素无瓜葛，何出此言？";

  if (me->query_skill("fengshentui", 1) < 1)
    return "你连金风神腿都没学，何谈此言？";

  if (query("shen", me) > -80000)
    return "哼！你这样心慈手软能干成什么事？这招你不学也罢！";

  if (me->query_skill("fengshentui", 1) < 360)
    return "你的风神腿还练得不到家，自己下去练练再来吧！";

  message_sort(HIY "\n$n" HIY "微微点了点头，在$N" HIY "耳边轻声说了些话"
    "，一边说还一边用腿比划着些什么。如此这般，过了良久……\n\n"
    NOR, me, this_object());

  command("say 刚才那些便是这招的口诀和练功的要领，你可要记牢了。");
  command("nod");
  command("say 这招风行天下比较难练，你自己下来后要多加研究。");
  tell_object(me, HIC "你学会了「风行天下」。\n" NOR);
  if (me->can_improve_skill("unarmed"))
    me->improve_skill("unarmed", 1500000);
  if (me->can_improve_skill("fengshentui"))
    me->improve_skill("fengshentui", 1500000);
  me->improve_skill("martial-cognize", 1500000);
  set("can_perform/fengshentui/feng", 1, me);

  return 1;
}

