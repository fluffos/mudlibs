mixed ask_skill6() {
  object me;

  me = this_player();
  if (query("can_perform/fengshentui/chuan", me))
    return "这招我不是已经教过你了吗？";

  if (query("family/family_name", me) != query("family/family_name"))
    return RANK_D->query_respect(me) + "和本会素无瓜葛，何出此言？";

  if (query("shen", me) > -100000)
    return "哼！你这样心慈手软能干成什么事？这招你不学也罢！";

  if (me->query_skill("fengshentui", 1) < 600)
    return "你的风神腿还练得不到家，自己下去练练再来吧！";

  message_sort(HIY "\n$n" HIY "微微一笑，伸手将$N" HIY "招到面前，在$N"
    HIY "耳边轻声嘀咕了些话。$N" HIY "听了半天，突然间不由会"
    "心的一笑，看来大有所悟。\n\n" NOR, me, this_object());

  command("nod");
  command("say 这招可是为师秘传，观天地所领悟,极为博大精深，你下去后可得多练习练习！");
  tell_object(me, HIC "你学会了「神风动」。\n" NOR);
  if (me->can_improve_skill("fengshentui"))
    me->improve_skill("fengshentui", 1500000);
  if (me->can_improve_skill("unarmed"))
    me->improve_skill("fengshentui", 1500000);
  me->improve_skill("martial-cognize", 1500000);
  set("can_perform/fengshentui/shen", 1, me);
  return 1;
}

int accept_object(object me, object ob) {
  int r;
  if (r = ::accept_object(me, ob))
    return r;

  if (base_name(ob) != BLADE
    && base_name(ob) != BLADE) {
    command("say 你给我这种东西干什么？");
    return 0;
  }

  if (query("family/master_id", me) != query("id"))
    command("say 多谢这位" + RANK_D->query_respect(me) + "将本门宝物交回。");
  else
    command("say 很好，很好！");
  destruct(ob);
  return 1;
}

void unconcious() {
  die();
}
