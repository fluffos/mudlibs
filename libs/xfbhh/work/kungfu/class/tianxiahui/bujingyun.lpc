#include <ansi.h>
#include "tianxiahui.h"

#define sword       "/clone/obj/sword"

inherit NPC;
inherit F_MASTER;
inherit F_QUESTER;
inherit F_COAGENT;

mixed ask_skill1();
mixed ask_skill2();
mixed ask_skill3();
mixed ask_skill4();
mixed ask_skill5();
mixed ask_skill6();
mixed ask_gou();
mixed ask_suo();
mixed ask_she();
mixed ask_jing();
int ask_me();
string ask_ling();
void create() {
  object ob, ob2;
  set_name("步惊云", ({ "bu jingyun", "bu", "jingyun" }));
  set("nickname", HIR "不哭死神" NOR);
  set("long", @LONG
你对面的是一个身披斗篷，面如死灰，冷漠如冰的惊云堂堂主步惊云
LONG);
  set("title", "惊云堂堂主");
  set("gender", "男性");
  set("age", 25);
  set("attitude", "friendly");
  set("shen_type", -1);
  set("str", 300);
  set("int", 300);
  set("con", 300);
  set("dex", 300);
  set("per", 300);

  set("max_qi", 50000000);
  set("max_jing", 4000000);
  set("neili", 55000000);
  set("max_neili", 55000000);
  set("jiali", 2000000);
  set("combat_exp", 250000000);
  set("score", 100000);

  set_skill("force", 2500);
  set_skill("paiyunzhang", 2500);
  set_skill("shengling", 2500);
  set_skill("yunshijue", 2500);
  set_skill("dodge", 2500);
  set_skill("strike", 2500);
  set_skill("parry", 2500);
  set_skill("sword", 2500);
  set_skill("literate", 2500); ;
  set_skill("martial-cognize", 2500);

  map_skill("force", "yunshijue");
  //map_skill("dodge", "shengling");
  map_skill("strike", "paiyunzhang");
  map_skill("parry", "paiyunzhang");
  map_skill("sword", "shengling");


  create_family("天下会", 11, "堂主");

  set("chat_chance_combat", 120);
  set("chat_msg_combat", ({
    (: perform_action, "strike.tian" :),
    (: perform_action, "strike.fuhu" :),
    (: perform_action, "strike.yinyang" :),
    (: perform_action, "sword.erer" :),
    (: perform_action, "sword.jianba" :),
    (: perform_action, "sword.jianshiba" :),
    (: exert_function, "freeze" :),
    (: exert_function, "powerup" :),
  }));

  set_temp("apply/damage", 100);
  set_temp("apply/sword_damage", 100);
  set_temp("apply/armor", 200);

  setup();

  set("inquiry", ([
    "雄霸": "那是家师",
    "聂风": "风师弟？你找他有事吗?",
    "剑八": (: ask_skill1 :),
    "剑十八": (: ask_skill2 :),
    "剑二二": (: ask_skill3 :),
    "伏虎": (: ask_skill4 :),
    "殃云天降": (: ask_skill5 :),
    "燮云无定": (: ask_skill6 :),
  ]));

  if (clonep()) {
    ob = find_object(sword);
    ob2 = find_object(sword);

    if (!ob) ob = load_object(sword);
    if (!environment(ob)) {
      ob->move(this_object());
      ob->wield();
    } else {
      ob = find_object(sword);
      if (!ob) ob = load_object(sword);
      if (!environment(ob)) {
        ob->move(this_object());
        ob->wield();
      } else {
        ob = new("/clone/obj/sword");
        ob->move(this_object());
        ob->wield();
      }
    }
    if (!ob2) ob2 = load_object(sword);
    if (!environment(ob2)) {
      ob2->move(this_object());
      ob2->wear();
    }
  }
  carry_object("/clone/cloth/bai")->wear();
}

void init() {
  add_action("do_show", "show");
}

void attempt_apprentice(object ob) {
  if (!permit_recruit(ob))
    return;

  if (query("shen", ob) > -100000) {
    command("say 哼 ！我天下会不收心慈手软之辈");
    return;
  }

  if (query("shen", ob) > -50000) {
    command("say 像你这样心慈手软的人是干不成大事的！");
    return;
  }

  if (query("combat_exp", ob) < 3500000) {
    command("say 你现在经验尚浅，不能领会高深的武功，还是先去增长点经验吧。");
    return;
  }

  command("say 好吧，既然如此本堂主就收下你这个徒弟。");
  command("recruit " + query("id", ob));
  set("title", "惊云堂副堂主", ob);
  return;
}

mixed ask_skill1() {
  object me;

  me = this_player();

  if (query("can_perform/shengling/jianba", me))
    return "你不是已经会了吗？";

  if (query("family/family_name", me) != query("family/family_name"))
    return RANK_D->query_respect(me) + "和本教素无瓜葛，何出此言？";

  if (me->query_skill("shengling", 1) < 1)
    return "你连圣灵剑法都没学，何谈此言？";

  /*if( query("family/gongji", me)<300 )
                return "你在教中所作的贡献还不够，这招我不忙传你。";*/

  /*if( query("shen", me)>-30000 )
                return "心慈手软的人永远成不了大器，这招你不学也罢！";*/

  if (me->query_skill("shengling", 1) < 500)
    return "你的圣灵剑法还练得不到家，自己下去练练再来吧！";

  message_sort(HIY "\n$n" HIY "点了点头，从腰间取下绝世好剑，手腕轻轻一抖，顿"
    "时剑影重重，剑气交加,完全笼罩$N" HIY "的四周，直看得$N" HIY "目瞪口"
    "呆。\n\n" NOR, me, this_object());

  command("nod");
  command("say 这一招便是圣灵剑法绝技剑八，你可看明白了？");
  tell_object(me, HIC "你学会了「剑八」。\n" NOR);

  if (me->can_improve_skill("sword"))
    me->improve_skill("sword", 1500000);
  if (me->can_improve_skill("shengling"))
    me->improve_skill("shengling", 1500000);
  me->improve_skill("martial-cognize", 1500000);
  set("can_perform/shengling/jianba", 1, me);

  return 1;
}

mixed ask_skill2() {
  object me;

  me = this_player();

  if (query("can_perform/shengling/jianshiba", me))
    return "你不是已经会了吗？";

  if (query("family/family_name", me) != query("family/family_name"))
    return RANK_D->query_respect(me) + "和本会素无瓜葛，何出此言？";

  if (me->query_skill("shengling", 1) < 1)
    return "你连圣灵剑法都没学，何谈此言？";

  /*if( query("family/gongji", me)<1300 )
                return "你在教中所作的贡献还不够，这招我不忙传你。";*/

  if (query("shen", me) > -50000)
    return "心慈手软的人永远成不了大器，这招你不学也罢！";

  if (me->query_skill("shengling", 1) < 360)
    return "你的圣灵剑法还练得不到家，自己下去练练再来吧！";

  message_sort(HIY "\n$n" HIY "点了点头，道：“本堂主今天便传你这招，你可"
    "看好了！”$n" HIY "说罢，从腰间取下绝世好剑，一声怒喝，双眼一红,手中绝世"
    "好剑狂舞，漫天剑气顿时幻作无数小圈，铺天盖地罩向$N" HIY "。"
    "\n\n" NOR, me, this_object());

  command("nod");
  command("say 这一招便是圣灵剑法绝技剑十八，你可看明白了？");
  tell_object(me, HIC "你学会了「剑十八」。\n" NOR);

  if (me->can_improve_skill("sword"))
    me->improve_skill("sword", 1500000);
  if (me->can_improve_skill("shengling"))
    me->improve_skill("shengling", 1500000);
  me->improve_skill("martial-cognize", 1500000);
  set("can_perform/shengling/jianshiba", 1, me);

  return 1;
}

mixed ask_skill3() {
  object me;

  me = this_player();

  if (query("can_perform/shengling/erer", me))
    return "你不是已经会了吗？";

  if (query("family/family_name", me) != query("family/family_name"))
    return RANK_D->query_respect(me) + "和本人素无瓜葛，何出此言？";

  if (me->query_skill("shengling", 1) < 1)
    return "你连圣灵剑法都没学，何谈此言？";

  if (query("shen", me) > -80000)
    return "心慈手软的人永远成不了大器，这招你不学也罢！";

  /*if( query("family/gongji", me)<1500 )
                return "你在教中所作的贡献还不够，这招我不忙传你。";*/

  if (me->query_skill("shengling", 1) < 160)
    return "你的圣灵剑法还练得不到家，自己下去练练再来吧！";

  message_sort(HIY "\n$n" HIY "对$N" HIY "赞许地点了点头，道：“既然你如"
    "此有心，为师就再传你这招！”说完$n" HIY "招了招手，$N"
    HIY "连忙凑上前去，只见$n" HIY "轻声在$N" HIY "说了些话，"
    "接着手中绝世好剑一抖，登时二十一道剑气散发开来!\n" NOR, me, this_object());

  command("sweat");
  command("nod");
  command("say 这一招便是圣灵剑法绝技剑二二，你下去需勤加练习！");
  tell_object(me, HIC "你学会了「剑二二」。\n" NOR);

  if (me->can_improve_skill("sword"))
    me->improve_skill("sword", 1500000);
  if (me->can_improve_skill("shengling"))
    me->improve_skill("shengling", 1500000);
  me->improve_skill("martial-cognize", 1500000);
  set("can_perform/shengling/erer", 1, me);

  return 1;
}

mixed ask_skill4() {
  object me;

  me = this_player();
  if (query("can_perform/paiyunzhang/fuhu", me))
    return "这招我已经教过你了，还是自己下去多多练习吧！";

  if (query("family/family_name", me) != query("family/family_name"))
    return RANK_D->query_respect(me) + "和本会素无瓜葛，何出此言？";

  if (me->query_skill("paiyunzhang", 1) < 1)
    return "你连排云掌都没学，何谈此言？";

  if (query("shen", me) > -80000)
    return "哼！你这样心慈手软能干成什么事？这招你不学也罢！";

  if (me->query_skill("paiyunzhang", 1) < 360)
    return "你的排云掌还练得不到家，自己下去练练再来吧！";

  message_sort(HIY "\n$n" HIY "微微点了点头，在$N" HIY "耳边轻声说了些话"
    "，一边说还一边用腿比划着些什么。如此这般，过了良久……\n\n"
    NOR, me, this_object());

  command("say 刚才那些便是这招的口诀和练功的要领，你可要记牢了。");
  command("nod");
  command("say 这招伏虎比较难练，你自己下来后要多加研究。");
  tell_object(me, HIC "你学会了「伏虎」。\n" NOR);
  if (me->can_improve_skill("strike"))
    me->improve_skill("strike", 1500000);
  if (me->can_improve_skill("paiyunzhang"))
    me->improve_skill("paiyunzhang", 1500000);
  me->improve_skill("martial-cognize", 1500000);
  set("can_perform/paiyunzhang/fuhu", 1, me);

  return 1;
}

mixed ask_skill5() {
  object me;

  me = this_player();
  if (query("can_perform/paiyunzhang/tian", me))
    return "这招我不是已经教过你了吗？";

  if (query("family/family_name", me) != query("family/family_name"))
