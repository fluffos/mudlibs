#include <ansi.h>;
#include <combat.h>

inherit SKILL;

int is_pbsk() { return 1; }

string type() { return "martial"; }
string martialtype() { return "skill"; }

mapping *action = ({
  ([ "action": "$N手中$w分散为三,而后分化为九，一招" HIC "「九天十色」" NOR "，手中$w更犹如天外流星，一剑剑飞向$n的$l。",
    "lvl": 0,
    "skill_name": "九天十色"
  ]),
  ([ "action": "$N退了两步，$w围绕住$N,快速的旋转密不透风,犹如人剑合一，一招" HIB "「完美无瑕」" NOR "直冲$n的$l",
    "lvl": 10,
    "skill_name": "完美无瑕"
  ]),
  ([ "action": "突然间嗤嗤嗤三声，$N向$n连刺无数的幻影，一式" HIG "「幻影」" NOR "，剑刃在$n的$l边堪堪擦过，$n只觉$l呼呼的风声，大吃一惊，急忙倒退。",
    "lvl": 20,
    "skill_name": "幻影"
  ]),
  ([ "action": "$N手中$w递出，一个虚招指向$n的左肩，反手却以气引剑发出无数的剑气,天空密密麻麻的,一式" HIY "「无边无际」" NOR "，由下而上$w疾刺$n的$l",
    "lvl": 30,
    "skill_name": "无边无际"
  ]),
  ([ "action": "$N一招" HIW "「暗无天日」" NOR "，身子前倾，忽地回剑斜削，手中$w平平地向$n的$l挥去",
    "lvl": 40,
    "skill_name": "暗无天日"
  ]),
  ([ "action": "$N上身往左侧一拧，一招" BLU "「探剑色变」" NOR "，右手$w反手向$n的$l挥去",
    "lvl": 50,
    "skill_name": "探剑色变"
  ]),
  ([ "action": "$N左一招" MAG "「万剑」" NOR "，右一招" HIM "「归宗」" NOR "，剑锋平指，身体四周密密麻麻出现数万柄剑对准$n的$l",
    "lvl": 60,
    "skill_name": "万剑 归宗"
  ]),
});

int valid_enable(string usage) { return usage == "sword" || usage == "parry"; }
int valid_learn(object me) {
  if (query("max_neili", me) < 100000)
    return notify_fail("你的内力不够。\n");
  if (me->query_skill("literate", 1) < 600)
    return notify_fail("你的读书写字不够。\n");
  if (me->query_skill("sword-cognize", 1) < 3000)
    return notify_fail("你的剑道修养不够。\n");
  return 1;
}
int practice_skill(object me) {
  object weapon;

  if (!objectp(weapon = query_temp("weapon", me))
    || query("skill_type", weapon) != "sword")
    return notify_fail("你使用的武器不对。\n");
  if (query("qi", me) < 30 || query("neili", me) < 10)
    return notify_fail("你的内力或气不够练万剑典。\n");
  me->receive_damage("qi", 30);
  addn("neili", -10, me);
  return 1;
}
string query_skill_name(int level) {
  int i;
  for (i = sizeof(action); i > 0; i--)
    if (level >= action[i - 1]["lvl"])
      return action[i - 1]["skill_name"];
}
mapping query_action(object me, object weapon) {
  /* d_e=dodge_effect p_e=parry_effect f_e=force_effect m_e=damage_effect */
  int d_e1 = 40;
  int d_e2 = 60;
  int p_e1 = 10;
  int p_e2 = 30;
  int f_e1 = 50;
  int f_e2 = 100;
  int m_e1 = 10;
  int m_e2 = 110;
  int i, lvl, seq, ttl = sizeof(action);

  lvl = (int)me->query_skill("wanjiandian", 1);
  for (i = ttl; i > 0; i--)
    if (lvl > action[i - 1]["lvl"]) {
      seq = i; /* 获得招数序号上限 */ break;
    }
  seq = random(seq); /* 选择出手招数序号 */ return ([
    "action": action[seq]["action"],
    "dodge": d_e1 + (d_e2 - d_e1) * seq / ttl,
    "parry": p_e1 + (p_e2 - p_e1) * seq / ttl,
    "force": f_e1 + (f_e2 - f_e1) * seq / ttl,
    "damage": m_e1 + (m_e2 - m_e1) * seq / ttl,
    "damage_type": random(2) ? "割伤" : "刺伤",
  ]);
}
int learn_bonus() { return 30; }
int practice_bonus() { return 30; }
int success() { return 20; }
int power_point(object me) { return 1.0; }

string *shi = ({ HIG "「百剑齐鸣」" HIW, HIG "「无穷无尽」" HIW, HIG "「遮天蔽日」" HIW, HIG "「暗无天际」" HIW,
  HIG "「完美无瑕。」" HIW, HIG "「万剑齐出。」" HIW, HIG "「万剑------->归宗。」" HIW });
string *ship = ({ HIW "\n$N仗剑沉吟道," BLK "太" HIW "极，霎时一股" BLK "黑" HIW "白剑气，一分二化作丝线袭向$n" HIW "。\n" NOR,
  HIW "\n$N身法陡快，忽念到" HIC "剑气，突然间剑势宛如不受控制，缠向$n" HIW "。\n" NOR,
  HIW "\n$N清吟" HIY "辟邪，手里剑气犹如魅影般，遍布夜空将$n" HIW "笼罩。\n" NOR,
  HIW "\n$N黯然低吟" HIR "万" HIC "剑" HIG "决，猛然挥剑发出万道剑气，$n" HIW "大惊失色。\n" NOR });

mixed hit_ob(object me, object victim, int damage_bonus, int factor) {
  mixed result;
  string msg;
  int lvl, flagli = 0;
  int idx, idx2, ap, dp, damage, damage2;
  int num = 200;
  object weapon = query_temp("weapon", me);
  object *obs;

  if ((userp(me) && query("jianqi", me) < 1) ||
    me->query_skill("literate", 1) < 600 ||
    me->query_skill("sword-cognize", 1) < 200
  )
    return 0;

  if (!objectp(weapon) || query("skill_type", weapon) != "sword"
    || me->query_skill_mapped("sword") != "wanjiandian")
    return 0;
  if (query("id", me) == "li bai")
    flagli = 1;
  if (!flagli) {
    if (query_temp("tsj_cd_time", me) >= time())
      return 0;
    set_temp("tsj_cd_time", time() + 2, me);
  }

  ap = attack_power(me, "sword") + me->query_int() * 50 + me->query_skill("sword-cognize", 1);
  ap += ap * (query("jianqi", me) / 50);
  damage = damage_power(me, "sword");
  damage += damage * query("jiali", me) / 1000;
  damage += damage * (me->query_skill("literate", 1)) / 3500;
  damage += damage * (me->query_skill("sword-cognize", 1)) / 2500;
  damage += damage * (query("jianqi", me) / 25);

  lvl = me->query_skill(
    "wanjiandian",
    1
  ) + me->query_skill("literate", 1) + me->query_skill("sword-cognize", 1);
  lvl = lvl / 6000;
  if ((!flagli) && lvl > query("jianqi", me)) lvl = query("jianqi", me);
  if (lvl < 1) lvl = 1;
  if (lvl > 6) lvl = 6;
  idx2 = lvl + 1;
  while (lvl--) {
    num--;
    if (!num) break;
    if (flagli && random(5)) lvl++;
    obs = me->query_enemy();
    if (!obs || !arrayp(obs) || !sizeof(obs))
      break;
    else
      victim = obs[random(sizeof(obs))];
    if (!me->is_fighting(victim)) continue;
    idx = random(idx2);
    damage2 = damage + damage * idx / 2;
    message_combatd((replace_string(ship[random(sizeof(ship))], "万剑决", shi[idx])), me, victim);
    dp = defense_power(
      victim,
      "parry"
    ) + victim->query_int() * 50 + victim->query_skill("sword-cognize", 1);
    if (ap / 2 + random(ap) > dp) {
      msg = COMBAT_D->do_damage(me, victim, ((!random(3)) ? REMOTE_ATTACK : WEAPON_ATTACK), damage2, 60 + random(query(
        "int",
        me
      ) * 2),
        HIY "只闻「噗噗噗」！几声过后，" + weapon->name() + HIY "已穿透$n" HIY "的胸膛，多了无数个透明的剑眼,数都数不过来。\n" NOR, me, victim);
    } else {
      msg = HIC "$n" HIC "会心一笑，看出$N" HIC "这招中的破绽，随意施招竟将这招化去。\n" NOR;
    }
    message_combatd(sort_msg(msg), me, victim);
  }
  return 1;

}

int difficult_level() {
  return 30000;
}

