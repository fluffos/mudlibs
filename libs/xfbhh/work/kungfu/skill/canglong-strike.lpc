// This is player's own skill (Write by Lonely@nt2)
// Create by 青丘魅儿(Ouyanwenjei) at Sat Aug 11 16:54:04 2018
// 苍龙七宿掌(canglong-strike.c)

#include <ansi.h>
inherit SKILL;

int is_invent_skill() { return 1; }

mapping *action = ({
  // ZHAOSHI : 0
  ([ "action": "$N两掌变换，快速结印，一式「青龙出水」，一股强大的青龙真气猛然将$n轰飞，尸骨无存",
    "attack": 260,
    "damage": 260,
    "force": 260,
    "dodge": 260,
    "parry": 260,
    "lvl": 100,
    "damage_type": "内伤",
    "skill_name": "青龙真气"
  ]),
  // ZHAOSHI : 1
});

int valid_learn(object me) {
  if (query_temp("weapon", me) || query_temp("secondary_weapon", me))
    return notify_fail("练" + "苍龙七宿掌" + "必须空手。\n");
  if (query("max_neili", me) < 50)
    return notify_fail("你的内力太弱，无法练" + "苍龙七宿掌" + "。\n");
  return 1;
}

int valid_enable(string usage) {
  return usage == "strike" || usage == "parry";
}

string query_skill_name(int level) {
  int i;
  for (i = sizeof(action) - 1; i >= 0; i--)
    if (level >= action[i]["lvl"])
      return action[i]["skill_name"];
}

mapping query_action(object me, object weapon) {
  int i, level;
  level = (int)me->query_skill("canglong-strike", 1);
  for (i = sizeof(action); i > 0; i--)
    if (level > action[i - 1]["lvl"])
      return action[NewRandom(i, 20, level / 5)];
}

mixed *query_actions() { return action; }

int query_effect_parry(object attacker, object me) {
  int lvl;

  if (query_temp("weapon", me))
    return 0;

  lvl = me->query_skill("canglong-strike", 1);
  if (lvl < 80) return 0;
  if (lvl < 200) return 50;
  if (lvl < 280) return 80;
  if (lvl < 350) return 100;
  return 120;
}

int practice_skill(object me) {
  if (query("qi", me) < 25)
    return notify_fail("你的体力不够了，休息一下再练吧。\n");
  if (query("neili", me) < 3)
    return notify_fail("你的内力不够了，休息一下再练吧。\n");
  me->receive_damage("qi", 25);
  addn("neili", -3, me);
  return 1;
}

mixed hit_ob(object me, object victim, int damage) {
  mixed result;
  if (damage < 100) return 0;

  if (random(damage) > victim->query_str()) {
    result = ([ "damage": damage ]);
    result += ([ "msg": HIW "你听到「喀嚓」一声轻响，已被$N所发杀气挫伤，$n顿时血冒三丈！！！\n" NOR ]);

    return result;
  }
}

string perform_action_file(string action) {
  return __DIR__ + "canglong-strike" + "/" + action;
}
string query_description() {
  return "我国古代传说中的灵异神物，亦乃万兽之首。传说虎须鬣尾，身长若蛇，
有鳞似鱼，有角仿鹿，有爪似鹰，能走，亦能飞，能倒水，能大能小，能
隐能现，能翻江倒海，吞风吐雾，兴云降雨。强大的青龙战斗之姿便是这
套掌法的灵感";
}
