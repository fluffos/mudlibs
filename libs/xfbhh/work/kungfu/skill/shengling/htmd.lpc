#include <ansi.h>
#include <combat.h>

inherit F_SSERVER;
string name() { return "毁天灭地二十三"; }

#include "/kungfu/skill/eff_msg.h";
string final(object me, object target, int lvl);
int do_setamount(string arg)  
{
        if (! arg || arg == "") return notify_fail(NOR + "需要输入数值参数！\n" + NOR); 
        set("amount",to_int(arg)); 
        return 1;
}

int perform(object me, object victim)
{
	    //object where = environment(victim);
        string msg,str;
		object head, corpse;
        int lvl;
        int damage, time;
        int ap, dp;
		mapping buff;
        object *bugs;

        //if (! victim) victim = offensive_target(me);
        /*if (!where || !objectp(where)) {
                tell_object(me, NOR + "这个目标大概还没有出生！\n" + NOR); 
                return 0;
        }*/

        if (! victim || ! victim->is_character())
                return notify_fail("你要对谁施展毁天灭地二十三？\n");
		/*if (!victim || (victim == me || !living(victim) || !objectp(victim) )) 
			    return notify_fail(NOR + "整个世界也没有合适的目标！\n" + NOR);*/   


        if ((int)me->query_skill("shengling", 1) < 3000)
                return notify_fail("你的毁天灭地二十三修为不够，现在还无法施展。\n");

        if( query("max_neili", me)<500000000 )
                return notify_fail("你的真气不够，现在无法施展毁天灭地二十三。\n");
			
		if( query("max_jingli", me)<500000000 )
                return notify_fail("你的真气不够，现在无法施展毁天灭地二十三。\n");


        msg = HIB "$N" HIB "元神离体而出，散发出毁天灭地之势，手捏剑指"
              "飞向$n" HIB "剑指正对$n的眉心！\n" NOR;
        message_combatd(msg, me, victim);
        ap = attack_power(me,"sward");
        dp = defense_power(victim, "force");

        if (ap / 2 + random(ap) > dp)
        {
                damage = damage_power(me, "sward");
                damage+= query("jiali", me);
                damage*=3;
                msg += COMBAT_D->do_damage(me, victim, UNARMED_ATTACK, damage, 150,
					   (: final, me, victim, lvl :));
                addn("max_neili", -500000000, me);
				addn("max_jingli", -500000000, me);
				me->improve_skill("shengling", -500000000);
				
                me->start_busy(2);
        } else
        {
                msg += CYN "$p" CYN "毫无感应站在哪里一动不动"
                       "眼中瞳孔涣散，已然是气绝身亡。\n" NOR;
                victim->die(me);
                me->die(victim);
				msg = query("name", victim);
                        //set("last_opponent", me, victim);//                     victim->kill_ob(me);
                        set_temp("die_reason", "被"+query("name",me)+"放出毁天灭地二十三杀了", victim);
                        victim->die();
        }



        return 1;
    }

string final(object me, object victim, int lvl) 
{ 
          victim->die(me);
                me->die(victim);
				
				
          return HIR "$n" HIR "只觉得一股毁天灭地的气势"
                 "攻过来，只觉得全身不受控制，“哇”的一声"
                 "身体化作碎片消失在天地间！\n" NOR;

} 
