});


int valid_enable(string usage) { return usage == "cuff" || usage == "parry"; }

int valid_learn(object me) {
  if (query("str", me) < 35)
    return notify_fail("你先天臂力不足，无法修炼天霜拳。\n");

  if (query("con", me) < 35)
    return notify_fail("你先天根古不足，无法修炼天霜拳。\n");

  if (query("max_neili", me) < 20000)
    return notify_fail("你的内力修为不足。\n");

  if ((int)me->query_skill("force", 1) < 500)
    return notify_fail("你的内功火候太浅。\n");

  if ((int)me->query_skill("martial-cognize", 1) < 500)
    return notify_fail("你的武学修养不足。\n");

  if ((int)me->query_skill("cuff", 1) < (int)me->query_skill("tianshuangquan", 1))
    return notify_fail("你的基本拳法火候不够，无法领会更高深的天霜拳。\n");

  if ((int)me->query_skill("parry", 1) < (int)me->query_skill("tianshuangquan", 1))
    return notify_fail("你的基本招架水平有限，无法领会更高深的天霜拳。\n");

  if ((int)me->query_skill("force", 1) < (int)me->query_skill("tianshuangquan", 1))
    return notify_fail("你的基本内功水平有限，无法领会更高深的天霜拳。\n");

  return 1;
}

string query_skill_name(int level) {
  int i;
  for (i = sizeof(action) - 1; i >= 0; i--)
    if (level >= action[i]["lvl"])
      return action[i]["skill_name"];
}
mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}


int double_attack() {
  return 1;
}


mixed hit_ob(object me, object victim, int damage_bonus) {
  string *desc;
  object weapon;

  weapon = query_temp("weapon", me);

  if (!objectp(weapon)) return damage_bonus;

  desc = ({
    HIY "$N" HIY "全身聚集天霜气，使得$n无从下手" HIY "。\n" NOR,
    HIC "$N" HIC "冰封千里，寸草不生\n" NOR,
    HIR "$N" HIR "汇聚天霜气遮挡身形，周围的气劲化作冰霜纷纷掉落。\n" NOR,
  });

  if (me->is_busy()
    || random(4) >= 1
    || !living(victim)
    || damage_bonus < 150
    || query("neili", me) < 500
    || me->query_skill("tianshuangquan", 1) < 500)
    return 0;

  // 追加特效
  victim->receive_wound("qi", damage_bonus / 4, me);

  if (random(6) == 1) victim->start_busy(3 + random(5));

  return desc[random(sizeof(desc))];
}

mixed valid_damage(object ob, object me, int damage, object weapon) {
  mapping result;
  int ap, dp, cost;

  if ((int)me->query_skill("tianshuangquan", 1) < 350
    || me->query_skill_mapped("parry") != "tianshuangquan"
    || query("neili", me) < 200
    || !living(me) || random(5) > 2)
    return;

  cost = damage / 2;
  if (cost > 100) cost = 100;

  ap = ob->query_skill("force", 1) * 4 + ob->query_skill("martial-cognize", 1);
  dp = me->query_skill("tianshuangquan", 1) * 5 + me->query_skill("martial-cognize", 1) + 100;

  if (dp / 2 + random(dp / 2) >= ap) {
    addn("neili", -cost, me);
    result = ([ "damage": -damage ]);

    switch (random(3)) {
      case 0:
        result += ([ "msg": HIW "$n" HIW "吸收天地之寒霜之气。$N" HIW "被冻得走不得,攻击不得,也动不得。\n" NOR ]);
        break;
      case 1:
        result += ([ "msg": HIW "只见$n" HIW "双拳凝结深蓝色的寒气,团团围绕。$N" HIW "眼花缭乱，无从攻击。\n" NOR ]);
        break;
      default:
        result += ([ "msg": HIG HIW "$n" HIW "化作一团霜气，使周围迷雾重生将$N" HIW "团团围住，不知身在何处。\n" NOR ]);
        break;
    }
    return result;
  }
}

string perform_action_file(string action) {
  return __DIR__ "tianshuangquan/" + action;
}

int difficult_level() {
  return 30000;
}
