#include <ansi.h>
#include <combat.h>

string name() { return HIR "破灭" NOR; }

inherit F_SSERVER;

int perform(object me, object target) {
  object weapon;
  int ap, dp, damage;
  string msg;
  int fmsk;

  if (!target) target = offensive_target(me);

  if (query("id", me) != "saber520")
    return notify_fail(name() + "你不知道这一招该如何使用。\n");

  if (!target || !me->is_fighting(target))
    return notify_fail(name() + "只能对战斗中的对手使用。\n");


  if ((int)me->query_skill("six-finger", 1) < 220)
    return notify_fail("你的六脉神剑不够娴熟，难以施展" + name() + "。\n");

  if ((int)me->query_skill("qimai-liuzhuan", 1) < 200)
    return notify_fail("你的气脉流转修为不够，难以施展" + name() + "。\n");

  if (me->query_skill_mapped("finger") != "six-finger")
    return notify_fail("你没有激发六脉神剑，难以施展" + name() + "。\n");


  if (query("max_neili", me) < 3500)
    return notify_fail("你的内力修为不足，难以施展" + name() + "。\n");

  if (query("neili", me) < 800)
    return notify_fail("你现在的真气不够，难以施展" + name() + "。\n");

  if (!living(target))
    return notify_fail("对方都已经这样了，用不着这么费力吧？\n");

  msg = HIC "$N" HIC "身法陡然一变，忽然伸出一指，向$n眉心点去"
    "正是泥潭失传绝学「" HIR "破灭" HIC "」绝技。\n" NOR;

  ap = attack_power(me, "finger") + me->query_skill("qimai-liuzhuan", 1) * 8;
  dp = defense_power(target, "dodge") + target->query_skill("count", 1);
  fmsk = me->query_skill("count", 1) * 8;

  // delta = ABILITY_D->check_ability(me, "ap_power-tzst-zhuan"); // 门派ab
  // if( delta ) ap += ap*delta/100;

  if (ap * 8 + random(ap) + fmsk > dp) {
    damage = 0;
    if (me->query_skill("six-finger", 1) + me->query_skill("qimai-liuzhuan", 1) > 8888) {
      msg += HIR "$n" HIR "变幻了好几种上乘身法，但$N" HIR "食指"
        "紧随其后，刹那间已然击中$n" HIR "头部。\n"
        HIW "$N一击得手，天罡地煞玄元劲顿时破脑而入"
        "\n" NOR "( $n" RED "受伤过重，已经有如风中残烛"
        "，随时都可能断气。" NOR ")\n";
      message_combatd(msg, me, target);
      damage = -1;
    } else {
      damage = damage_power(me, "force") * 88;
      damage += query("jiali", me) * 88;
      damage *= 88;
      // delta = ABILITY_D->check_ability(me, "da_power-tzst-zhuan"); // 门派ab
      // if( delta ) damage += damage*delta/100;
      addn("neili", -500, me);
      msg += COMBAT_D->do_damage(me, target, UNARMED_ATTACK, damage, 175 + fmsk / 10,
        HIW "$n见状" HIR "急忙提起全身向$N点出一指"
        HIR "刹那间两指相交，只听得“嗤”的一声，$n" HIR "顿时呕出数口鲜血"
        "显然已是命不久矣\n$N一击得手，"
        "天罡地煞玄元劲顿时破体而入！\n" NOR);
      message_combatd(msg, me, target);
    }
  }

  if (damage < 0) {
    target->die(me);
  }

  return 1;
}
