#include <ansi.h>
inherit NPC;

void create() {
  set_name("夺命书生", ({ "duoming", "shusheng" }));
  set("title", HIW "阴险毒辣" NOR);
  set("gender", "男性");
  set("age", 33);
  set("long",
    "宁王的心腹大将，为人阴险毒辣，且武功高强。年轻时曾与唐伯虎之父唐天豪比武，最后重创唐天豪获胜，因而与唐伯虎结下杀父之仇。。\n");

  set("int", 50);
  set("str", 55);
  set("con", 55);
  set("dex", 55);
  set("attitude", "aggressive");
  set("shen_type", -1);

  set("qi", 20000000);
  set("max_qi", 20000000);
  set("jing", 100000000);
  set("max_jing", 80000000);
  set("neili", 8000000);
  set("max_neili", 1000000);
  set("jiali", 20000);
  set("combat_exp", 50000000);
  set("score", 150000);
  set_temp("apply/attack", 3000);
  set_temp("apply/defense", 3000);
  set_temp("apply/damage", 30000);

  set_skill("unarmed", 3000 + random(100));
  set_skill("force", 3000 + random(100));
  set_skill("dodge", 3000 + random(100));
  set_skill("parry", 3000 + random(100));

  set_skill("zhuangzi-wu", 3000 + random(100));
  set_skill("zhanshen-xinjing", 3000 + random(100));
  set_skill("mianmu-quanfei", 3000 + random(100));

  map_skill("force", "zhanshen-xinjing");
  map_skill("unarmed", "mianmu-quanfei");
  map_skill("dodge", "zhuangzi-wu");
  map_skill("parry", "mianmu-quanfei");
  set("chat_chance_combat", 120);
  set("chat_msg_combat", ({
    (: command("perform juan") :),
    (: command("exert shield") :),
    (: command("exert powerup") :),
  }));
  set("chat_chance", 20);
  set("chat_msg", ({
    "书生说道: 想要学会我的武功，你也得付出代价。\n",
    (: random_move :),
  }));

  setup();
}


void die() {
  object me, ob, jmem, item;
  mapping team;
  int i, size, level, exp, rand, pot;
  string file;

  ob = this_object();
  me = ob->query_temp("last_damage_from");

  rand = random(100);
  if (rand >= 5) {
    item = new("/clone/money/silver");
    if (item) {
      item->set_amount(10);
      item->move(environment(ob));
    }
  }

  else if (rand < 5) {
    item = new("/clone/book/mianmuquanfei");
    if (item) {
      item->move(environment(ob));
    }
  }

  destruct(ob);
}
