void unconcious() {
  object ob, me = this_object();
  if (!objectp(ob)) ob = me->query_last_damage_from();
  if (!objectp(ob)) ob = query_temp("last_damage_from", me);
  die(ob);
}

void start_move() {
  set("can_move", 1);
}
