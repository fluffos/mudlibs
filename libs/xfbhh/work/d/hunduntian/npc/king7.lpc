void init() {
  object me;

  ::init();
  if (!interactive(me = this_player()) ||
    this_object()->is_fighting())
    return;

  remove_call_out("kill_ob");
  call_out("kill_ob", 0.5, me);
}

void sp_attack() {
  object *enemies, enemy, ob;
  object *obs;
  string msg;
  int i;

  enemies = query_enemy();
  if (!enemies || sizeof(enemies) == 0)
    return;
  enemy = enemies[random(sizeof(enemies))];
  obs = filter_array(
    all_inventory(environment(this_object())),
    (: query("id", $1) == "skeleton fighter1" :)
  );
  if (sizeof(obs) < 7 && !random(5)) {
    msg = HIY "$N喊道,白虎何在?，\n" NOR;
    message_vision(append_color(msg, HIY), this_object(), enemy);
    for (i = 0; i < 1; i++) {
      ob = new(__DIR__ "king8");
      ob->set_from_me(enemy);
      ob->move(environment(enemy));
      ob->kill_ob(enemy);
    }
    return;
  }
  if (!enemy->is_busy() && sizeof(ob) > 3 && !random(5)) {
    msg = HIY "$N盘旋在空中双爪好像在做一些奇怪的动作。\n"
      "$n四周的树木活了过来无数绿色树枝盘旋开来\n"
      "！\n" NOR;
    message_vision(append_color(msg, HIY), this_object(), enemy);
    enemy->start_busy(5);
    return;
  }
  /*
        秦皇僵尸久攻不下，感到十分不耐烦，于是把河图虎符都仍在一旁，从身边的剑鞘中
        拔出一把青光闪闪的宝剑，虽然在棺中历经千年岁月，这把宝剑仍然光可鉴人，锋利
        无匹。烛光跳动间你赫然看见，剑鞘上刻着两个篆字：鹿卢。
        */
  switch (random(5)) {
    case 4: msg = HIG "$N" HIY "胡须一甩，一道道青绿色的气体从$n" HIY "身边围绕住！\n" NOR; break;
    case 3: msg = GRN "$N" HIW "张开大口，一道绿色光团迅猛而至，$n" HIW "只觉自己生命在缓慢的流失。\n" NOR; break;
    case 2: msg = HIY "$N" HIR "全身卷缩盘旋而立顿时化出几十个幻影冲向$n" HIR "，$n" HIR "犹如晕头鸭子不知如何是好。\n" NOR; break;
    case 1: msg = HBGRN "$N" MAG "一声怒吼，顿时周围带有生命气息的人纷纷身冒绿光...\n"
      "$n" MAG "全身缓慢的冒出绿光，慢慢变成一个绿人。\n" NOR; break;
    default: msg = HIG "$N" HIG "盘旋而上，只见$n" HIG "天空顿时一片盈盈绿色宛如春风拂过$n" HIG "，$n" HIG "只感觉全身生命力被着春风带走。\n" NOR; break;
  }
  message_vision(msg, this_object(), enemy);
  if (!random(20)) enemy->unconcious();
  enemy->receive_damage("qi", 500000 + random(50000), this_object());
  COMBAT_D->report_status(enemy);
  if (!enemy->is_busy())
    enemy->start_busy(2);
  return;
}

varargs void start_busy(mixed new_busy, mixed new_interrupt) {
  return;
}

mixed hit_ob(object me, object ob, int damage_bouns) {
  int damage;
  int reduce;

  damage = 10000 + random(10000);
  reduce = query_temp("apply/reduce_fire", ob);
  damage -= damage * reduce / 100;
  if (damage < 0) damage = 0;
  ob->receive_damage("qi", damage, me);
  ob->receive_wound("qi", damage, me);
  set("neili", query("max_neili", me), me);
  addn("age", 10, me);
  return HIG "$N" HIY "全身闪出耀眼的青绿色，登时令$n"
    HIY "全身正在快速衰老。\n" NOR;
}
