// Room: /xiakedao/shidong2.c

inherit ROOM;

#include <ansi.h>
#define BOOK "/clone/book/jianba"
string look_bi();

void create()
{
        set("short", "冰洞");
        set("long", @LONG
这是一个冰洞，四周冰寒无比你貌似被困在这里了，该怎么出去那。
LONG );
        set("exits", ([
                //"east" : __DIR__"dong9",
                "west" : __FILE__,
                "south" : __FILE__,
                //"north" : __DIR__"yingbin",
        ]));
        set("objects", ([
				CLASS_D("tianxiahui") + "/bujingyun" : 1,
        ]));	

        set("item_desc",([
                "冰柱"  : (: look_bi :),
        ]));
        set("coor/x", -3080);
        set("coor/y", -22090);
        set("coor/z", 0);
        setup();
}

void init()
{
        add_action("do_ba", "ba");

}
string look_bi()
{
        object me = this_player();
        string msg;
                msg = HIW "\n一根很是特别的冰柱，寒气逼人，好像b有什么特别之处啊a，\n" NOR;

        return msg;
}

int do_ba()
{
        object me = this_player();
        object ob;

        if (! ob = find_object(BOOK))
                ob = load_object(BOOK);

        if (me->is_busy() || me->is_fighting())
                return notify_fail("等你忙完了再说吧！\n");

        message_vision(HIC "$N" HIC "你朝冰柱扒拉一下，冰柱散塌开来。\n", me);

        if (environment(ob))
        {                
                if (query("book_count") > 0)
                ob = new(BOOK);
                else
                return 1;
        }

        tell_object(me, HIG "你发现伴随冰柱掉落下一个卷轴。连忙伸手接住。\n");

        ob->move(me, 1);
        ob = new("/clone/book/jianba");
        add("book_count", -1);
        me->start_busy(2);

        return 1;
}