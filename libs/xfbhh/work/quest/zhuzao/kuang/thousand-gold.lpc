// thousand.c

#include <ansi.h>

inherit MONEY;

void create() {
  set_name(YEL "高级灵石" NOR, ({ "thousand-gold", "thousand-gold_money" }));
  /*if( clonep() )
                set_default_object(__FILE__);
        else*/ {
    set("money_id", "thousand-gold");
    set("long", "一块充满能力的高级灵石。\n");
    set("unit", "堆");
    set("base_value", 10000000);
    set("base_unit", "块");
    set("base_weight", 6);
    set("only_do_effect", 1);
  }
  set_amount(1);
}
int do_effect(object me) {

  message_vision("$N慢慢吸收灵石里的灵力，感觉功力有所增长。\n" NOR, me);
  addn("max_neili", 1000, me);
  addn("max_jingli", 50, me);
  add_amount(-1);

  if (query_amount() < 1)
    destruct(this_object());

  return 1;
}
