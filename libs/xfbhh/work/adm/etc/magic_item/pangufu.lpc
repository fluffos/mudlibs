// 上古十大神器之 加特林M134 
// Create by Rcwiz for Hero.cn 2003/08

#include <ansi.h>

#include <weapon.h>
inherit HAMMER;

int is_magic_item() { return 1; }

void create()
{
        set_name(NOR + WHT + "加特林M134" NOR, ({ "jiate lin", "pangu", "fu" }) );
        set_weight(800);
        if (clonep())
                set_default_object(__FILE__);
        else
        {
                set("unit", "把");
                set("long", NOR + WHT "这是世界上射速最快的机枪，人称“火神炮”\n"
                                      "此枪在穿越无尽时光后，吸收了盘古斧的一丝威能。\n"
                                      "可射(she)穿无尽虚空，进入太虚。\n" NOR);
                set("material", "steel");
                set("wield_msg", NOR + WHT "$N" NOR + WHT "将加特林M134握在手中，犹如"
                                           "军神再现，威风凛凛。\n" NOR);
                set("unwield_msg", NOR + WHT "$N" NOR + WHT "将手中加特林M134收回。\n" NOR);
                set("gongde", 9999);

        }
        init_hammer(210000000);//彰显无上神器
        setup();
}

void init()
{
        add_action("do_she", "she");       
}

int do_she(string arg)
{
        object me;
        
        me = this_player();
        
        if(! objectp(present("jiate lin", me)))return 0;
        
        if (me->is_fighting() || me->is_busy())
                 return notify_fail("你正忙呢！\n");
        
        if (! environment(me)->query("outdoors"))
                 return notify_fail("你得先到户外去。\n");
                 
        message_sort(NOR + WHT + "\n$N" NOR + WHT "手中的加特林M134喷吐着一阵阵火舌，"
                     "刹那间天空中露出一道裂痕，加特林M134化做一道奇异的光芒将$N" NOR + WHT +
                     "卷进太虚之中。\n" NOR, me);
                
        me->move("/kungfu/class/sky/taixu");
        destruct(this_object());

        return 1;
}
