void create() {
  set_name(HIM "大佬" NOR, ({ "gift angel", "tianshi", "gift", "angel", "liwu" }));
  set("long", @LONG
礼物天使，负责泥潭节庆期间礼物发放的天使。
LONG);
  set("gender", "女性");
  set("age", 18);
  set("attitude", "friendly");
  set("max_jing", 50000);
  set("max_qi", 50000);
  set("max_jingli", 50000);
  set("jingli", 50000);
  set("max_neili", 50000);
  set("neili", 50000);
  set("jiali", 350);
  set("str", 50);
  set("int", 50);
  set("con", 50);
  set("dex", 50);
  set("combat_exp", 1200000);

  set("inquiry", ([
    "师门次数奖励": (: ask_chushi :),
    "重开补偿奖励": (: ask_gift1 :),

  ]));

  setup();
  carry_object("/clone/misc/cloth")->wear();

}

int get_reward() {
  object me;
  string ret;

  me = this_player();
  ret = FESTIVAL_D->get_reward(me);
  tell_object(me, ret);
  return 1;
}


mixed ask_gift() {
  object ob, me = this_player();
  string *lines;
  string file, gift;
  int time1, time2;

  file = read_file(CONFIG_DIR + "gift");
  if (!stringp(file)) {
    command("say 可惜，天神还没有打算做任务礼物呢！");
    return 1;
  }

  lines = explode(file, "\n");
  file = lines[sizeof(lines) - 1];

  if (sscanf(file, "%s %d to %d", gift, time1, time2) != 3) {
    command("say 奇怪，礼物怎么不见了，难道是天神在作怪？！");
    return 1;
  }

  if (query("gifter/" + time1, me)) {
    command("say 呵呵～这就是您的不是了！我已经给过您礼物了啊！");
    return 1;
  }

  if (time() < time1 || time() > time2) {
    command("say 对不起，你来的不是时候，现在送你礼物，天神会惩罚我的！");
    return 1;
  }

  if (!ob = new(gift)) {
    command("say 奇怪，礼物有大问题，你赶快和天神报告吧！");
    return 1;
  } else {
    set("gifter/" + time1, 1, me);
    ob->move(me, 1);

    message_vision(HIW "$N" HIW "凌空一指，突然天空中一道" HIM "七" HIY "彩" HIR "霞" HIC "光" HIW "笼罩$n，转瞬即逝！\n" NOR,
      this_object(), me);

    tell_object(me, HIG "你身上好象多了一个礼物（gift），你快看看是什么礼物吧。\n" NOR);
    return 1;
  }
}

mixed ask_chushi(object obj) {
  object me = this_player();

  if (!query("smjl6", me)) {
    if (query("quest_count", me) >= 100)

      addn("yuanbao", 5000000, me);
    addn("cz", 1, me);
    addn("gongde", 5000000, me);
    addn("hhd", 500, me);
    addn("smjl6", 1, me);
    return "获得五十万元宝、功德，五千洪荒点，两充值点。\n";
  }




  else if (!query("smjl5", me)) {
    if (query("quest_count", me) >= 300)

      addn("yuanbao", 10000000, me);
    //  addn("cz",2,me);
    addn("gongde", 10000000, me);
    addn("hhd", 2000, me);
    addn("smjl5", 1, me);
    return "获得一百万元宝、功德，五千洪荒点。\n";
  }

  else

  if (!query("smjl4", me)) {
    if (query("quest_count", me) >= 500)

      addn("yuanbao", 50000000, me);
    addn("cz", 2, me);
    addn("gongde", 50000000, me);
    addn("hhd", 5000, me);
    addn("smjl4", 1, me);
    return "获得五百万元宝、功德，五千洪荒点，两充值点。\n";
  } else

  if (!query("smjl3", me)) {
    if (query("quest_count", me) >= 1000)

      addn("yuanbao", 100000000, me);
    addn("cz", 3, me);
    addn("gongde", 100000000, me);
    addn("hhd", 15000, me);
    addn("smjl3", 1, me);
    return "获得一千万元宝、功德，一万五千洪荒点，三充值点。\n";
  } else



  if (!query("smjl2", me)) {
    if (query("quest_count", me) >= 2000)

      addn("yuanbao", 200000000, me);
    addn("cz", 5, me);
    addn("gongde", 200000000, me);
    addn("hhd", 30000, me);
    addn("smjl2", 1, me);
    return "获得两千万元宝、功德，三万洪荒点，五充值点。\n";
  } else

  if (!query("smjl1", me)) {
    if (query("quest_count", me) >= 2999)

      addn("yuanbao", 500000000, me);
    addn("cz", 10, me);
    addn("gongde", 500000000, me);
    addn("hhd", 50000, me);
    addn("smjl1", 1, me);
    return "获得五千万元宝、功德，五万洪荒点，十充值点。\n";
  }


}



mixed ask_gift1() {
  int td;
  object me = this_player();
  td = time() / 86400;
  if (query("online_time", me) < 86400 * 2) {
    tell_object(me, CYN + query("name") + CYN + "说道：你在线年龄都没有超过2天，是小号吧？\n" + NOR);
    return 1;
  }
  if (query("gifter/wsj", me))
    return "你已经领过奖励了。";

  tell_object(me, HIY "\n获得十亿内力，五十亿经验，十亿精力，十亿精气，十亿黄金，十充值点\n" NOR);
  addn("max_neili", 1000000000, me);
  addn("combat_exp", 5000000000, me);
  addn("max_jing", 1000000000, me);
  addn("max_jingli", 1000000000, me);
  addn("balance", 10000000000000, me);
  addn("cz", 10, me);


  //set("bindable", 3, ob);
  // set("bind_owner",query("id",  me), ob);
  //set("autoload", 1, ob);
  //set("setdbase", 1, ob);
  set("gifter/wsj", 1, me);
  // set("gifter/which_day", td, me);
  return 1;
}


mixed ask_gift2() {
  //int td;
  object ob;
  object me = this_player();

  //td = time() / 86400;
  if (query("online_time", me) < 86400 * 3) {
    tell_object(me, CYN + query("name") + CYN + "说道：你在线年龄都没有超过3天，是小号吧？\n" + NOR);
    return 1;
  }

  if (query("gifter/2018655", me))
    return "你已经领过礼物了。";

  tell_object(me, HIY "\n你领取了一个今天的礼物(" HIM "器魂" NOR + HIY ")，祝你在王者归来里玩的愉快！\n" NOR);

  ob = new("/clone/qihun3");
  ob->move(me, 1);
  set("bindable", 3, ob);
  set("bind_owner", query("id", me), ob);
  set("autoload", 1, ob);
  set("setdbase", 1, ob);
  set("gifter/2018655", 1, me);
  return 1;
}

mixed ask_gift7() {
  int td;
  object ob;
  object me = this_player();

  td = time() / 86400;
  if (query("online_time", me) < 86400 * 3) {
    tell_object(me, CYN + query("name") + CYN + "说道：你在线年龄都没有超过3天，是小号吧？\n" + NOR);
    return 1;
  }

  //td = time() / 86400;
  if (query("gq", me) < 10) {
    tell_object(me, CYN + query("name") + CYN + "说道：你活动点不足10点,不能领取\n" + NOR);
    return 1;
  }

  if (query("gifter/20181011", me))
    return "你已经领过礼物了。";

  tell_object(me, HIY "\n你领取了(" HIM "洪荒属性" NOR + HIY ")！\n" NOR);

  ob = new("/clone/hhsx");
  ob->move(me, 1);
  addn("gq", -10, me);
  set("gifter/20181011", 1, me);
  return 1;
}

