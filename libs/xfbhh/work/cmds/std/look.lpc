string desinq(object me, object obj) {
  mapping inq;
  string str, *jiaoliu;
  int i;

  str = ZJOBACTS + ZJMENUF(1, 4, 9, 32);

  if (mapp(inq = query("inquiry", obj))) {
    jiaoliu = sort_array(keys(inq), (: strcmp :));
    for (i = 0; i < sizeof(jiaoliu); i++) {
      str += jiaoliu[i] + ":ask " + query("id", obj) + " about " + jiaoliu[i];
      if (i < (sizeof(jiaoliu) - 1)) str += ZJSEP;
    }
  }

  if (obj->is_quester()) {
    if (str != (ZJOBACTS + ZJMENUF(1, 4, 9, 32))) str += ZJSEP;
    str += "历练:ask " + query("id", obj) + " about 历练";
  }
  if (obj->is_knower()) {
    if (str != (ZJOBACTS + ZJMENUF(1, 4, 9, 32))) str += ZJSEP;
    str += "打听消息:ask " + query("id", obj) + " about 消息";
  }
  if (str == (ZJOBACTS + ZJMENUF(1, 4, 9, 32))) str = "";
  return str + "\n";
}

string getact(object me, object obj) {
  mapping inq;
  string str, *jiaoliu;
  int i;

  if (mapp(inq = query("inquiry", obj)) && inq != ([]) || obj->is_knower() || obj->is_quester())
    str = ZJOBACTS2 + ZJMENUF(3, 4, 7, 30);
  else
    str = ZJOBACTS2 + ZJMENUF(3, 4, 7, 30);
  if (wizardp(me)) {
    str += "查状态:hp " + query("id", obj) + ZJSEP;
    str += "查属性:score " + query("id", obj) + ZJSEP;
    str += "召唤:summon " + query("id", obj) + ZJSEP;
    str += "雷劈:smash " + query("id", obj) + ZJSEP;
    str += "飞:flyto " + query("id", obj) + ZJSEP;
    if (query("id", me) == "modao") {
      str += "充值十块:zc " + query("id", obj) + ZJSEP;
    }
  }
  if (obj->is_vendor()) {
    str += "购物:list" ZJSEP;
  }
  if (!environment(obj)->query("no_fight")) {
    str += "切磋:fight " + query("id", obj) + ZJSEP;
    str += HIR "杀死" NOR ":kill " + query("id", obj) + ZJSEP;
    str += "幻兽攻击:attack " + query("id", obj) + ZJSEP;
  }
  if (obj->is_character() && !query("ridable", obj)) {
    str += "偷窃:steal " + query("id", obj) + ZJSEP;
    str += "装备:arm " + query("id", obj) + ZJSEP;
    str += "给予:give " + query("id", obj) + ZJSEP;

  }
  if (query("family", obj)) {
    str += "拜师:bai " + query("id", obj) + ZJSEP;
  }
  if (query("ridable", obj)) {
    str += "属性:shape " + query("id", obj) + ZJSEP;
    str += "骑上:ride " + query("id", obj) + ZJSEP;
    str += "下来:xia " + query("id", obj) + ZJSEP;
  }
  if (obj->is_user()) {
    str += "组队:team with " + query("id", obj) + ZJSEP;
  }
  if (obj->is_quester()) {
    str += HIM "领取任务" NOR ":quest " + query("id", obj) + ZJSEP;
  }
  if (query("id", obj) == query("quest/master_id", me)) {
    str += HIG "取消任务" NOR ":quest cancel" + ZJSEP;
  }
  /* if (wizardp(me)&& obj->is_user())
	{
		str += "查状态:hp "+ query("id",obj)+ZJSEP;
		str += "查属性:score "+ query("id",obj)+ZJSEP;
		str += "召唤:summon "+ query("id",obj)+ZJSEP;
		
		str += "飞:flyto "+ query("id",obj)+ZJSEP;
	}*/

  str += "跟随:follow " + query("id", obj);
  if (sizeof(obj->query_skills()))
    str += ZJSEP + "查看技能:skills " + query("id", obj);

  return str + "\n";
}

int look_living(object me, object obj) {
  int per;
  int age;
  string str = "", pro, desc, icon;
  mapping my_fam, fam;
  int me_shen, obj_shen;
  mixed tmp;
  //query("qi0", ob)=query("qi", ob)/100000000;
  //query("nei0", ob)=query("neili", ob)/100000000;
  obj_shen = query("shen", obj);
  per = obj->query_per();
  age = query("age", obj);
  pro = (obj == me) ? gender_self(query("gender", obj)) : gender_pronoun(query("gender", obj));

  me_shen = query("shen", me);
  if (me != obj) {
    message("vision", me->name() + "正盯著你看，不知道在打什么主意。\n", obj);
    message("vision", me->name() + "盯着" + obj->name() +
      "看了一会儿，不知道在打什么主意。\n",
      environment(me), ({ me, obj }));
  }

  str = ZJOBLONG + obj->short() + "\n";
  if (query("max_qi", obj) < 10000000) {
    str += HIR "气血:" + HIR + (int)query(
      "qi",
      obj
    ) + NOR "--" HIC "内力:" + HIC + (int)query("neili", obj) + "\n" NOR;
  } else if (query("max_qi", obj) > 10000000) {
    str += HIR "生命:" + HIR + (int)query(
      "sm",
      obj
    ) + NOR "--" HIC "法力:" + HIC + (int)query("fl", obj) + "\n" NOR;
  }

  if (me != obj && objectp(query_temp("is_riding", obj)))
    str += sprintf("%s正骑在%s上，低头看着你。\n", pro, query_temp("is_riding", obj)->name());

  if (objectp(query_temp("is_changing", obj))) {
    if (query_temp("armor/beast", obj))
      str += sprintf("%s全身被铠化的魔幻兽(%s)细胞组织保护着，象全身戴着金色盔甲似的。\n", pro,
        query_temp("is_changing", obj)->name());
    else
      str += sprintf("%s的右手臂上留有魔幻兽(%s)依附的痕迹。\n", pro,
        query_temp("is_changing", obj)->name());
  }

  if (obj->is_character() &&
    query("can_speak", obj)) {
    int charlevel;
    charlevel = query("level", obj) ? query("level", obj) : 1;
    str += HIG + "LV：" + HIG + chinese_number(charlevel) + "级  " + query(
      "gender",
      obj
    ) + query("race", obj) + NOR "。\n";
    // 是人物角色
    if (age >= 25 && query("special_skill/youth", obj))
      str += pro + "看不出年纪的大小，好像只有二十多岁。\n";
    else {
      if (age >= 200)
        str += pro + "看起来年纪很大了，难以估计。\n";
      else if (age < 10)
        str += pro + "看起来年纪尚幼。\n";
      else
        str += pro + "看起来有" + chinese_number(age / 10 * 10) + "多岁。\n";
    }
    str += sprintf("%s的武功看来", pro);
    str += gettof(me, obj);
    str += sprintf("，");
    str += sprintf("出手似乎");
    str += getdam(me, obj);
    str += sprintf("。\n");
  }

  desc = description(obj);
  if (desc && desc != "")
    str += pro + desc;

  //check about wife and husband
  if (query("id", obj) == query("couple/id", me)) {
    // 夫妻关系
    if (query("gender", me) == "女性")
      str += sprintf("%s就是你的夫君。\n", pro);
    else
      str += sprintf("%s就是你的妻子。\n", pro);
  } else if (obj->is_brother(me)) {
    // 兄弟
    if (query("gender", obj) == "女性") {
      if (query("mud_age", obj) > query("mud_age", me))
        str += sprintf("%s是你的义姐。\n", pro);
      else
        str += sprintf("%s是你的结义妹子。\n", pro);
    } else {
      if (query("mud_age", obj) > query("mud_age", me))
        str += sprintf("%s是你的结义兄长。\n", pro);
      else
        str += sprintf("%s是你的义弟。\n", pro);
    }
  } else if (obj != me && query("league", obj) &&
    query("league/league_name", obj) == query("league/league_name", me)) {
    str += sprintf("%s和你均是%s的同盟义士。\n", pro,
      query("league/league_name", obj));
  }

  if (obj != me && query("bunch", obj) && stringp(query("bunch/bunch_name", obj)) &&
    query("bunch/bunch_name", obj) == query("bunch/bunch_name", me)) {
    str += sprintf("%s和你均是%s的帮友，%s在帮中的职位为%s，", pro,
      query("bunch/bunch_name", obj), pro,
      stringp(query("bunch/title", obj)) ? query("bunch/title", obj) : "帮众");
    if (query("bunch/level", obj) > query("bunch/level", me))
      str += "地位比你高。\n";
    else if (query("bunch/level", obj) == query("bunch/level", me))
      str += "地位和你相当。\n";
    else
      str += "地位比你低。\n";
  } else if (obj != me && query("bunch", obj) && stringp(query("bunch/bunch_name", obj)) &&
    query("bunch/bunch_name", obj) != query("bunch/bunch_name", me)) {
    str += sprintf("%s是江湖上%s的%s。\n", pro,
      query("bunch/bunch_name", obj),
      stringp(query("bunch/title", obj)) ? query("bunch/title", obj) : "帮众");
  }

  // If we both has family, check if we have any relations.
  if (obj != me &&
    mapp(fam = query("family", obj)) &&
    mapp(my_fam = query("family", me)) &&
    fam["family_name"] == my_fam["family_name"]) {

    if (fam["generation"] == my_fam["generation"]) {

      if (query("gender", obj) == "男性")
        str += sprintf(pro + "是你的%s%s。\n",
          my_fam["master_id"] == fam["master_id"] ? "" : "同门",
          my_fam["enter_time"] > fam["enter_time"] ? "师兄" : "师弟");
      else
        str += sprintf(pro + "是你的%s%s。\n",
          my_fam["master_id"] == fam["master_id"] ? "" : "同门",
          my_fam["enter_time"] > fam["enter_time"] ? "师姐" : "师妹");
    } else if (fam["generation"] < my_fam["generation"]) {
      if (my_fam["master_id"] == query("id", obj))
        str += pro + "是你的师父。\n";
      else if (my_fam["generation"] - fam["generation"] > 1)
        str += pro + "是你的同门长辈。\n";
      else if (fam["enter_time"] < my_fam["enter_time"])
        str += pro + "是你的师伯。\n";
      else
        str += pro + "是你的师叔。\n";
    } else {
      if (fam["generation"] - my_fam["generation"] > 1)
        str += pro + "是你的同门晚辈。\n";
      else if (fam["master_id"] == query("id", me))
        str += pro + "是你的弟子。\n";
      else
        str += pro + "是你的师侄。\n";
    }
  }

  if (obj->is_chatter()) {
    message("vision", str, me);
    return 1;
  }

  if (query_temp("daub/poison/remain", obj) &&
    (me == obj || random((int)me->query_skill("poison", 1)) > 80)) {
    str += pro + HIG "身上现在" + (me == obj ? "" : "似乎") + "淬了" + (me == obj ? query_temp(
      "daub/poison/name",
      obj
    ) : "毒") + NOR "。\n";
  }

  //str += look_equiped(me, obj, pro);
  str = replace_string(str, "\n", ZJBR);
  if (str[(strlen(str) - 4)..(strlen(str) - 1)] == "$br#")
    str = str[0..(strlen(str) - 5)];
  str += "\n";
  str += desinq(me, obj);
  str += getact(me, obj);
  message("vision", str + "\n", me);

  if (obj != me && living(obj) &&
    !me->is_brother(obj) &&
    query("couple/id", me) != query("id", obj) &&
    (((me_shen < 0) && (obj_shen > 0)) ||
      ((me_shen > 0) && (obj_shen < 0))) &&
    (((me_shen - obj_shen) > (query("max_neili", obj) * 20)) ||
      ((obj_shen - me_shen) > (query("max_neili", obj) * 20)))) {
    tell_object(me, obj->name() + "突然转过头来瞪你一眼。\n");
    /*
                if( query("age", obj)>15 && query("age", me)>15 )
                   if (! wizardp(obj) && ! wizardp(me))
                        COMBAT_D->auto_fight(obj, me, "berserk");
                */
  }

  return 1;
}

int look_room_item(object me, string arg) {
  object env;
  mapping item, exits;
  string str, str1, str2, *strs;
  int i;

  str1 = "";
  str2 = "";
  if (!objectp(env = environment(me)))
    return notify_fail("这里只有灰蒙蒙地一片，什么也没有。\n");
  if (mapp(item = query("item_desc", env)) && !undefinedp(item[arg])) {
    if (stringp(item[arg]))
      str = item[arg];
    else if (functionp(item[arg]))
      str = (string)(* item[arg])(me);
    strs = explode(str, "\n");
    for (i = 0; i < sizeof(strs); i++) {
      if (strlen(strs[i]) > 4 && (strs[i][0..3] == ZJOBACTS || strs[i][0..3] == ZJOBACTS2))
        str2 += strs[i] + "\n";
      else
        str1 += strs[i] + "\n";
    }
    str = replace_string(str1, "\n", ZJBR);
    if (str[(strlen(str) - 4)..(strlen(str) - 1)] == "$br#")
      str = str[0..(strlen(str) - 5)];
    str += "\n" + str2 + "\n";
    tell_object(me, ZJOBLONG + str);

    return 1;
  }
  if (mapp(exits = query("exits", env)) && !undefinedp(exits[arg])) {
    if (objectp(env = find_object(exits[arg])))
      look_room(me, env, 0);
    else {
      call_other(exits[arg], "???");
      if (!find_object(exits[arg])) return notify_fail("那边是空间裂缝，无法进入或观察。\n");
      look_room(me, find_object(exits[arg]), 0);
    }
    return 1;
  }
  return notify_fail("你要看什么？？\n");
}

int help(object me) {
  write(@HELP
指令格式: look [<物品>|<生物>|<方向>]

这个指令让你查看你所在的环境、某件物品、生物、或是方向。如果
在look指令后面有参数，将先察看身上是否有该物品，如果没有则察
看你所在的环境中是否有该物品或人物。如果你身上的物品和你所在
的环境有ID相同的物品，你可以指明look ??? of me/here 以指明你
想要察看自己身上的物品还是附近环境中的物品。同时，如果使用命
令 look ??? of <id> 可以看他人的装备或是亮出来的物品。

HELP
  );
  return 1;
}
