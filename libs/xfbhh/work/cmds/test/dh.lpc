#include <ansi.h>
inherit F_CLEAN_UP;

void create() { seteuid(getuid()); }

int main(object me, string arg)
{
	string str,txt,*line;
	int last,times,pot;
	int i,k,sum;

		str = ZJOBLONG""HIC"玩家·"+me->query("name")+""HIW"["+me->query("id")+"]"ZJBR
			HIC"目前拥有软妹币："+me->query("RMB")+ZJBR
			"———————闭关兑换系统———————\n"NOR;
		str += ZJOBACTS2+ZJMENUF(1,3,10,30);
		str += HIW"软妹币兑换元宝"NOR":dh 元宝"ZJSEP
		        "十连抽:choujiang 2";
		write(str + "\n");

        if(arg=="元宝")
	{
			sum = me->query("RMB");
			write(INPUTTXT("您目前有" + sum +"软妹币，【100元宝/软妹币】，请输入兑换值","dh $txt#")+"\n");
	    	if(sscanf(arg,"%d",k)!=1)
				return 1;
			if(k<1)
				return notify_fail("你想干什么！\n");
			if(k > sum)
				return notify_fail("你没有那么多软妹币了！\n");
	VIP_D->save();
	me->add("RMB",-k);
	me->add("yuanbao",k*100);
	log_ufile(me,"dh","消耗 "+k+" 软妹币，元宝增加 "+(k)+" 。\n");
	write("你消耗 "+k+" 软妹币，元宝增加 "+(k*100)+" 。\n");
	return 1;
	}
}

int help(object me)
{
     write(@HELP
指令格式: online

这个指令让你获得各种福利。

HELP
    );
    return 1;
}
