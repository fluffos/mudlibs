#include <ansi.h>
inherit F_CLEAN_UP;

int main(object me, string arg)
{
        string target;
        int    yuanbao;
        int flower;
        object ob;
        
        if (! SECURITY_D->valid_grant(me, "(boss)"))
                return 0;

        if (! me->is_admin()) return 0;

        if (! arg || sscanf(arg, "%s %d", target, yuanbao) != 2)
                return notify_fail("指令格式：jifen <id> <amount>。\n");
        
        if (! objectp(ob = UPDATE_D->global_find_player(target)))
                return notify_fail("没有这个人！\n");
                
        if (MEMBER_D->is_member(target))
                MEMBER_D->yuanbao(target, yuanbao);
        else
               MEMBER_D->check_yuanbao(target, yuanbao);

        flower = yuanbao / 100;
        addn("flowers/amount", flower, ob);
        tell_object(ob, HIC "你获得了 " + flower + " 张新手导师评价票。\n" NOR);

        log_file("static/jifen",sprintf("%s %s have jifen %s %d $NT\n",TIME_D->replace_ctime(time()),query("id", me),target,yuanbao));
        
        addn("vip/score", yuanbao/10, ob); // jifen成长值
        tell_object(ob, HIY "你获得了 " + yuanbao/10 + " 点jifen成长值。\n" NOR);

        UPDATE_D->global_destruct_player(ob, 1);
        write("ok.\n");
        return 1;
}
