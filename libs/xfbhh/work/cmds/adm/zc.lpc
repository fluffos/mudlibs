		 addn("yuanbao", yuanbao*100000000, ob);
		tell_object(ob, HIY "你获得了 " + yuanbao*100000000		+ " 元宝。\n" NOR);
		tell_object(ob, HIY "你获得了 " + yuanbao*100000000		+ " 元宝。\n" NOR);
		tell_object(ob, HIY "你获得了 " + yuanbao*100000000		+ " 元宝。\n" NOR);
