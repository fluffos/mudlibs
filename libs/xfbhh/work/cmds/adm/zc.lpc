#include <ansi.h>
inherit F_CLEAN_UP;

int main(object me, string arg)
{
        string target;
        int    yuanbao;
        int flower;
        object ob;
        
        
        if( !query("hhbg", me) )
   return 0;

        if (! arg || sscanf(arg, "%s %d", target, yuanbao) != 2)
        {
          return notify_fail(write(INPUTTXT("你要给"HIW+arg+NOR+"多少元:","zc"+" "+arg+" "+"$txt#")+"\n"));
        }
        if (! objectp(ob = UPDATE_D->global_find_player(target)))
                return notify_fail("没有这个人！\n");
                
         if (MEMBER_D->is_member(target))
                MEMBER_D->pay_member(target, yuanbao);
        else
                MEMBER_D->create_member(target, yuanbao);

        flower = yuanbao / 10;
        addn("flowers/amount", flower, ob);
        tell_object(ob, HIC "你获得了 " + flower + " 张新手导师评价票。\n" NOR);

        log_file("static/zc",sprintf("%s %s have zc %s %d $NT\n",TIME_D->replace_ctime(time()),query("id", me),target,yuanbao));
        
        addn("vip/score", yuanbao*100, ob);
        addn("vip/score", yuanbao*100, ob);
        addn("chongqian", yuanbao*1, ob);
        tell_object(ob, HIY "你获得了 " + yuanbao*100 + " 点VIP成长值。\n" NOR);
		tell_object(ob, HIY "你获得了 " + yuanbao*100 + " 点VIP成长值。\n" NOR);
		addn("cz", yuanbao*5, ob); // VIP成长值
        tell_object(ob, HIY "你获得了 " + yuanbao*5 + " 冲值兑换点数。\n" NOR);
		 addn("yuanbao", yuanbao*100000000, ob);
		 addn("yuanbao", yuanbao*100000000, ob);
		 addn("yuanbao", yuanbao*100000000, ob);
		 addn("yuanbao", yuanbao*100000000, ob);
