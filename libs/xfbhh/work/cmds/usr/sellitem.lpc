#include <ansi.h>
inherit F_CLEAN_UP;

int main(object me, string arg) {
  object ob;
  object nob;
  string my_id;
  int amount;
  int value;
  int res;
  int max_count;
  mixed ns;

  if (!arg)
    return notify_fail("你要卖什么？\n");

  if (sscanf(arg, "%d %s", amount, arg) != 2)
    amount = 1;

  if (amount < 1)
    return notify_fail("你想干啥？\n");

  if (!(ob = present(arg, me))) {
    write("你身上没有这种东西啊！\n");
    return 1;
  }

  max_count = ob->query_amount();
  if (!max_count) {
    if (amount > 1) {
      write(ob->name() + "这种东西不能拆开来卖。\n");
      return 1;
    }
    max_count = 1;
  } else {
    if (amount > max_count) {
      write("你身上没有这么多" + ob->name() + "。\n");
      return 1;
    }
  }

  if (query("money_id", ob)) {
    write(CYN + "你想卖「钱」？？" NOR "\n");
    return 1;
  }

  if (ob->is_character()) {
    write(CYN + "这你也要卖？？" NOR "\n");
    return 1;
  }

  if (ns = query("no_sell", ob)) {
    if (stringp(ns)) {
      write(CYN + "系统大神无奈道：" + ns + NOR "\n");
      return 1;
    }
    write(CYN + "这东西不能卖！！" NOR "\n");
    return 1;
  }

  if (query("food_supply", ob)) {
    write(CYN + "剩菜剩饭还是留着自己用吧！！" NOR "\n");
    return 1;
  }

  if (max_count > 1)
    value = query("base_value", ob) * amount;
  else
    value = query("value", ob);

  if (query("consistence", ob))
    value = value * query("consistence", ob) / 100;

  if (value < 2)
    write(CYN + query("name", ob) + "一文不值，直接丢掉吧！！" NOR "\n");
  else {
    write("你卖掉了一" + query(
      "unit",
      ob
    ) + query("name", ob) + "得到" + MONEY_D->money_str(value * 50 / 100) + "。\n");
    if (max_count == amount)
      destruct(ob);
    else
      ob->add_amount(-amount);
    //	MONEY_D->pay_player(me, value * 50 / 100);
    addn("balance", value * 50 / 100, me);
  }
  return 1;
}
