#include <ansi.h>

inherit F_CLEAN_UP;

string status_color(int current, int max);

int main(object me, string arg) {
  object ob, *tar;
  mapping my, yours;
  string sp;
  string *sss, str;
  int i, max;
  int lv, level, exp;
  int qi1, qi2, qi3;
  int jing1, jing2, jing3;
  int jingli1, jingli2;
  int neili1, neili2, myexp;
  int neili3;
  seteuid(getuid(me));
  if (!arg)
    ob = me;
  else
    ob = present(arg, environment(me));

  my = ob->query_entire_dbase();

  tar = me->query_enemy();
  if (sizeof(tar) == 1 && objectp(tar[0]))
    yours = tar[0]->query_entire_dbase();
  if (query("env/sign1", me) != 0 && query("env/sign5", me) != 0) {
    str = query("env/sign5", me);
    sss = explode(str, ";");
    max = sizeof(sss);
    if (max > 5) max = 5;
    for (i = 0; i < max; i++) {
      tell_object(me, ZJFORCECMD(sss[i]));
    }

  }

  if (userp(ob) && (!stringp(my["born"]) || !my["born"]))
    return notify_fail("还没有出生呐，察看什么？\n");

  if (my["max_jing"] < 1 || my["max_qi"] < 1)
    return notify_fail("无法察看" + ob->name(1) + "的状态。\n");


  lv = query("level", ob);

  sp = "\n";


  my["qi"] > 1000000000 ? qi1 = my["qi"] / 100000000 : qi1 = my["qi"];
  my["eff_qi"] > 1000000000 ? qi2 = my["eff_qi"] / 100000000 : qi2 = my["qi"];
  my["max_qi"] > 1000000000 ? qi3 = my["max_qi"] / 100000000 : qi3 = my["max_qi"] / 100000000;
  my["jing"] > 1000000000 ? jing1 = my["jing"] / 100000000 : jing1 = my["jing"];
  my["eff_jing"] > 1000000000 ? jing2 = my["eff_jing"] / 100000000 : jing2 = my["eff_jing"];
  my["max_jing"] > 1000000000 ? jing3 = my["max_jing"] / 100000000 : jing3 = my["max_jing"];
  my["jingli"] > 1000000000 ? jingli1 = my["jingli"] / 100000000 : jingli1 = my["jingli"];
  my["max_jingli"] > 1000000000 ? jingli2 = my["max_jingli"] / 100000000 : jingli2 = my["max_jingli"];
  my["neili"] > 1000000000 ? neili1 = my["neili"] / 100000000 : neili1 = my["neili"];
  my["neili"] < 10 ? neili3 = 0 : neili3 = my["neili"];
  my["max_neili"] > 1000000000 ? neili2 = my["max_neili"] / 100000000 : neili2 = my["max_neili"];
  my["combat_exp"] > 1000000000 ? myexp = my["combat_exp"] / 100000000 : myexp = my["combat_exp"];


  if (my["qi"] > 1000000000)
    sp += ZJHPTXT + sprintf("气血(亿)：%d:%d/%d/%d:%s", qi1, qi1, qi2, qi3, "#BBFF0011");
  else
    sp += ZJHPTXT + sprintf("气血：%d:%d/%d/%d:%s", qi1, qi1, qi2, qi3, "#BBFF0011");

  if (my["max_jing"] > 1000000000) {
    sp += "║" + sprintf("精气(亿)：%d:%d/%d/%d:%s", jing1, jing1, jing2, jing1, "#BB990000");
    sp += "║" + sprintf("等级：%d:%d/%d:%s", lv, lv, lv, "#BB0EE0EB");
  } else {
    sp += "║" + sprintf("精气：%d:%d/%d/%d:%s", jing1, jing1, jing2, jing1, "#BB990000");
    sp += "║" + sprintf("等级：%d:%d/%d:%s", lv, lv, lv, "#BBEFCC00");
  }
  if (my["max_neili"] > 1000000000)
    sp += "║" + sprintf("内力(亿)：%d:%d/%d:%s", neili1, neili1, neili2, "#BB0E49EB");
  else if (my["neili"] < 0)
    sp += "║" + sprintf("内力：%d:%d/%d:%s", neili3, neili3, neili2, "#BB0E49EB");
  else
    sp += "║" + sprintf("内力：%d:%d/%d:%s", neili1, neili1, neili2, "#BB0E49EB");

  if (my["jingli"] > 1000000000)
    sp += "║" + sprintf("精力(亿)：%d:%d/%d:%s", jingli1, jingli1, jingli2, "#BBAD03EB");
  else
    sp += "║" + sprintf("精力：%d:%d/%d:%s", jingli1, jingli1, jingli2, "#BBAD03EB");


  if (my["combat_exp"] > 100000000)
    sp += "║" + sprintf("经验(亿)：%d::%s", myexp, "#BB3FFF00");
  else
    sp += "║" + sprintf("经验：%d::%s", myexp, "#BB3FFF00");



  sp += "\n";
  tell_object(me, sp);
  return 1;
}
