//inventory.c

#include <ansi.h>

inherit F_CLEAN_UP;

int main(object me, string arg)
{
	int i;
	object *inv, ob;
	mapping count;
	mapping equiped;
	mapping unit;
	mapping ids;
	mapping itype;
	string pops,short_name;
	int    total_item;

	string str;
	string *dk;
	if (wizardp(me) && arg)
	{
		ob = find_player(arg);
		if (! ob) ob = find_living(arg);
		if (! ob) ob = present(arg, environment(me));
		if (! ob) return notify_fail("没有这个玩家。\n");
	}

	if (! ob) ob = me; 
	total_item = 0;
	inv = all_inventory(ob);
	if (! sizeof(inv))
	{
		write(ZJOBLONG+((ob == me) ? "目前你身上没有任何东西。\n"
				 : ob->name() + "身上没有携带任何东西。\n"));
		return 1;
	}
	str = ZJOBLONG+sprintf("%s身上带著下列这些东西(负重 %d%%)：\n",
		      (ob == me)? "你" : ob->name(),
		      (int)ob->query_encumbrance() * 100 / (int)ob->query_max_encumbrance());

	count   = ([]);
	unit    = ([]);
	equiped = ([]);
	ids = ([]);
	itype = ([]);

	for (i = 0; i < sizeof(inv); i++)
	{
		short_name = inv[i]->name(1);
		if(inv[i]->query_amount())
			short_name = inv[i]->query_amount() + query("base_unit",inv[i]) + short_name;
		if (undefinedp(count[short_name]))
		{
			count += ([ short_name : 1 ]);
			unit += ([ short_name : query("unit",inv[i]) ]);
			ids += ([ short_name : query("id",inv[i])]);
		}
		else
			count[short_name] += 1;

		if (query("food_remaining",inv[i]))
			itype[short_name] = 1;//食物
		else if (query("liquid/remaining",inv[i]))
			itype[short_name] = 2;//水容器
		else if (query("skill",inv[i]))
			itype[short_name] = 3;//可研读
		else if (query("mod_name",inv[i]))
			itype[short_name] = 4;//可研读

		if (query("equipped",inv[i])&&query("weapon_prop",inv[i]))
			equiped[short_name] = 3;
		else if (query("equipped",inv[i])&&query("armor_prop",inv[i]))
			equiped[short_name] = 4;
		else if (query("weapon_prop/damage",inv[i]))
			equiped[short_name] = 1;
		else if (query("armor_prop/armor",inv[i]))
			equiped[short_name] = 2;
		else if (inv[i]==query_temp("is_riding",me))
			equiped[short_name] = 5;
		else
			total_item++;
	}

	if (objectp(ob = query_temp("handing",ob)))
		short_name = query("name",ob);
	else
		short_name = 0;

	dk = keys(count);
	dk = sort_array(dk, 1);
	str += ZJOBACTS2+ZJMENUF(2,2,8,30);
	for (i = 0; i < sizeof(dk); i++) 
	{
		if (equiped[dk[i]]>2)
			str += HIC "㊣" NOR;
		else
			str += "  ";

		if (count[dk[i]] > 1)
			str += chinese_number(count[dk[i]]) + unit[dk[i]];
		pops = ZJPOPMENU;
		pops += "查看 "+dk[i]+"|look "+ids[dk[i]]+ZJSP2;
        pops += "打开 "+dk[i]+"|open "+ids[dk[i]]+ZJSP2;
		pops += "研读 "+dk[i]+"|du "+ids[dk[i]]+ZJSP2;
		pops += "手持 "+dk[i]+"|hand "+ids[dk[i]]+ZJSP2;
		pops += "吃 "+dk[i]+"|eat "+ids[dk[i]]+ZJSP2;
		if(equiped[dk[i]]==3)
			pops += "放下 "+dk[i]+"|unwield "+ids[dk[i]]+ZJSP2;
		else if(equiped[dk[i]]==4)
			pops += "脱掉 "+dk[i]+"|remove "+ids[dk[i]]+ZJSP2;
		else if(equiped[dk[i]]==1)
			pops += "装备 "+dk[i]+"|wield "+ids[dk[i]]+ZJSP2;
		else if(equiped[dk[i]]==2)
			pops += "穿戴 "+dk[i]+"|wear "+ids[dk[i]]+ZJSP2;
		else if(equiped[dk[i]]==5)
			pops += "下来 "+dk[i]+"|unride "+ids[dk[i]]+ZJSP2;
		else if(itype[dk[i]]==2)
		{
			pops += "喝 "+dk[i]+"|drink "+ids[dk[i]]+ZJSP2;
		}
		else if(itype[dk[i]]==3)
		{
			pops += "研读 "+dk[i]+"|study "+ids[dk[i]]+ZJSP2;
		}
		pops += "出售 "+dk[i]+"|sellitem "+ids[dk[i]]+ZJSP2;
		pops += "丢弃 "+dk[i]+"|drop "+ids[dk[i]];
		str += dk[i]+ZJBR"  "+ids[dk[i]]+ ":" + pops + ZJSEP;
	}

	write(str+"\n");
	return 1;
}

int help (object me)
{
	write(@HELP
指令格式: inventory
 
可列出你(你)目前身上所携带的所有物品。
 
注 : 此指令可以 " i " 代替。

HELP );
	return 1;
}
