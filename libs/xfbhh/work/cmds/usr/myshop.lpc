#include <ansi.h>
#include <command.h>

inherit F_SAVE;
inherit F_DBASE;

#define NAME            0
#define ID              1
#define VALUE           2
#define TYPE            3
#define FILE            4
#define DESC            5

#define VIP1_RATE       95
#define VIP2_RATE       88
#define VIP3_RATE       80
#define ACTS_RATE       80
#define GOODS_FILE      CONFIG_DIR "goods_list"
#define MYSHOP_DIR	  "/clone/vip/"


inherit F_CLEAN_UP;

int main(object me, string arg)
{
	string str,*all_file,file,price;
	int i,yuanbao,value;
	object ob;
	object ob1;
	int amount;

	all_file = list_dirs(MYSHOP_DIR);

        MYGIFT_D->check_mygift(me, "newbie_mygift/ybstore");  

	if(!sizeof(all_file))
		return notify_fail("商城中暂无商品出售。\n");

	if (! arg)
	{
		str = ZJOBLONG"你目前有"+HIY+query("yuanbao",me)+NOR+"元宝，请选择您想购买的道具：\n"ZJOBACTS2+ZJMENUF(4,4,10,36);
		for(i=0;i<sizeof(all_file);i++)
		{
			file = MYSHOP_DIR+all_file[i];
			yuanbao = query("yuanbao",load_object(file));
			price = yuanbao?(yuanbao+"元宝"):(MONEY_D->money_str(query("value",load_object(file))));
			str += sprintf("%s"ZJBR"%s:myshop look %s"ZJSEP,file->name(1),price,file);
		}
		write(str+"\n");
		return 1;
	}
	else if (sscanf(arg,"look %s",file)==1)
	{
		yuanbao = query("yuanbao",load_object(file));
		price = yuanbao?(yuanbao+"元宝"):(MONEY_D->money_str(file->query("value")));
		str = ZJOBLONG+"【"+file->name(1)+"】　　价格："+price+NOR+ZJBR"一一一一一一一一一一一一一一一一一一一一一一一"ZJBR;
		str += file->long();
		str += ZJOBACTS2+ZJMENUF(2,2,10,28);
		str += "购买1个:myshop buy 1 "+file+ZJSEP"批量购买:myshop buy "+file+"\n";
		write(str+"\n");
		return 1;
	}
	else if (sscanf(arg,"buy %s",file)==1)
	{
		if (sscanf(file, "%d %s", amount, file) != 2)
		{
			write(INPUTTXT("你想买多少个"+file->name(1)+"？"ZJBR"请确认你的背包空间足够。","myshop buy $txt# "+file)+"\n");
			return 1;
		}

		if(file_size(file)<0||strsrch(file,MYSHOP_DIR)!=0)
			return notify_fail(HIM"没有这个道具！！"NOR"\n");


		//if(amount<1)
			//return notify_fail(HIM"你要买多少个？？"NOR"\n");
		if( !query("hhbg", me) )
    {
		if(!file->query_amount()&&amount>100)
			return notify_fail(HIM"不可叠加物品一次最多买100个！！"NOR"\n");
}

		yuanbao = query("yuanbao",load_object(file));
		if(!value=query("base_value",load_object(file)))
			value = query("value",load_object(file));
		if(!yuanbao&&!value)
			return notify_fail(HIM"购买失败！！"NOR"\n");

		
if( !query("hhbg", me) )
{
		if(yuanbao)
		{
		if(amount<1)
			return notify_fail(HIM"小伙子，你都没有还想卖？"NOR"\n");
			        if(yuanbao*amount<1)
        return notify_fail(HIM"想卡bug啊，小伙汁？"NOR"\n");
			if(query("yuanbao",me)<(yuanbao*amount))
				return notify_fail(HIM"你的元宝不够啦，找巫师充值吧！！"NOR"\n");
				}
				}
				if(yuanbao)
{
			addn("yuanbao",-yuanbao*amount,me);
			log_file("pay/myyuanbao", sprintf("%s:%s(%s)消费%d元宝，从随身商城购买%d个%s(%s)。\n",
				ctime(time()),me->name(1),query("id",me),yuanbao*amount,amount,file->name(1),file->query("id")));
				
			addn("zjvip/yuanbao_used",yuanbao*amount,me);
		
		
		}
		else if(value)
		{
		
			if(!query("balance",me)||query("balance",me)<(value*amount))
				return notify_fail(HIM"你的钱没那么多了！！"NOR"\n");
			addn("balance",-value*amount,me);
			log_file("pay/myshop2", sprintf("%s:%s(%s)消费%s，从随身商城购买%d个%s。\n",
				ctime(time()),me->name(1),query("id",me),MONEY_D->money_str(value*amount),amount,file->name(1)));
		}
		if(file->query_amount())
		{
			ob = new(file);
			ob->set_amount(amount);
			write("你从商城中成功购买到"+ob->short()+"。"NOR"\n");
			ob->move(me,1);
		}
		else
		{
			for(i=0;i<amount;i++)
			{
				ob = new(file);
				
				ob->move(me,1);
			}
			write("你从商城中成功购买到"+amount+"个"+ob->short()+"。"NOR"\n");
		}
		return 1;
	}
	else
		return notify_fail(HIM"你想干什么？？"NOR"\n");

	return 1;
}

int help(object me)
{
     write(@HELP

随身商城。

HELP
    );
    return 1;
}

