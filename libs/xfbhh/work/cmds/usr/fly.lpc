int main(object me, string arg)
{
	object flying, room;
	string where;

	if (! arg) return help(me);

	if (me->over_encumbranced())
		return notify_fail("你的负荷过重，动弹不得。\n");

	if (me->query_encumbrance() < 0)
		return notify_fail("你的负荷出现故障，动弹不得。\n");

	if (me->query_temp("sleeped"))
		return notify_fail("你现在正躺着呢。\n");

	if (me->is_in_prison())
		return notify_fail("你正在做牢呢，你想干什么？！\n");

	if (me->is_fighting())
		return notify_fail("你现在正在战斗！\n");

	if (me->is_busy() || me->query("doing"))
		return notify_fail("你的动作还没有完成，不能移动。\n");

	/*if (me->query_skill("fly", 0) > 5000 )
		return notify_fail("你的御剑术不足以长途跋涉。\n");*/

	if (! environment(me)->query("outdoors"))
		return notify_fail("在房间里打碎空间？！\n");

	if (environment(me)->query("no_magic") || environment(me)->query("no_fly"))
		return notify_fail("你发现这里有点古怪，你破不开这里的虚空！\n");

	if (member_array(arg, keys(places)) == -1 && arg != "home")
		return notify_fail("这里的空间太坚硬你破不开虚空\n");

	if (arg == "home" && ! me->query("private_room/position"))
		return notify_fail("你还没有住房呢！\n");

	if (arg == "home" && stringp(me->query("private_room/position")) &&
	    file_size(me->query("private_room/position") + ".lpc") > 0)
		room = get_object(me->query("private_room/position"));
	else
	room = get_object(places[arg]);
	if (! room) return notify_fail("你感觉到似乎那个地方有点不对劲。\n");

	message("vision", me->name() + "打碎空间，踏入了虚空\n",
		environment(me), ({me}));

	where = room->query("short");

	call_out("fly_fin",1,where,flying,me,room);
	tell_object(me, HIG"\n\n你使出吃奶的力气一拳打在了空气上，空间破碎露出了一个恐怖的黑洞～ '"NOR"\n");
	tell_object(me, "\n\n顿时化为一道流光，飞进了虚空乱流~~~"NOR"\n");
	return 1;
}
void fly_fin(string where,object flying,object me,object room)
{
	me->move(room);	
	tell_object(me, HIG"\n你感到附近有虚空薄弱的地方" + where + "。"NOR"\n");
	tell_object(me, HIM"\n你一拳轰向虚空，从虚空乱流飞了出来。"NOR"\n");
	message("vision", me->name() + "虚空突然破碎。\n",
		environment(me), ({me}));
	//me->receive_damage("qi", 10);

	me->delete_temp("is_flying");
}
