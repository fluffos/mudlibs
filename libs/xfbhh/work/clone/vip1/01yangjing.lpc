#include <ansi.h>

inherit ITEM;

void create() {
  set_name(HIG "养精丹" NOR, ({ "yangj dan" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "粒");
    set("value", 500);
    set("only_do_effect", 1);
  }
  setup();
}

int do_effect(object me) {
  message_vision("$N吃下一粒" + name() + "。\n", me);

  if (query("eff_jing", me) < query("max_jing", me)) {
    me->receive_curing("jing", query("max_jing", me) / 25);
  }
  me->start_busy(1);
  destruct(this_object());
  return 1;
}
