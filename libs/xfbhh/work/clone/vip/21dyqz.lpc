#include <ansi.h>

inherit ITEM;

void create() {
  set_name(HIR "遁影擒踪" NOR, ({ "capture" }));
  set_weight(200);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "元神技能\n" ZJURL("cmds:eat capture") ZJSIZE(15) "使用" NOR "看看!\n");
    set("yuanbao", 100);
    set("value", 10000);
    set("unit", "粒");
    set("only_do_effect", 1);
  }
}

int do_effect(object me) {

  if (!query("yuanshen_level", me))
    return notify_fail("你尚未到达元神！\n");


  if (!query("special_skill/capture", me)) {
    set("special_skill/capture", 1, me);
    message_vision("$N学会了" + this_object()->name() +
      "。\n", me);
    destruct(this_object());
  } else {
    message_vision("$N一仰脖，吞下了一粒" + this_object()->name() +
      "发现原来已经学过这个技能了。\n", me);
  }
  return 1;
}
