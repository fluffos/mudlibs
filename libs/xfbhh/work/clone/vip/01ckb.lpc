#include <ansi.h>
inherit ITEM;

void create() {
  set_name(HIC "仓库扩容包" NOR, ({ "ckbao" }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "仓库存储上限增加10格\n" ZJURL("cmds:kai ckbao") ZJSIZE(15) "增加！\n");
    set("unit", "个");
    set("no_put", 1);
    set("no_sell", 1);
    set("yuanbao", 10);
    set("value", 10000);
  }
  setup();
}
void init() {
  if (environment() == this_player())
    add_action("do_tilian", "kai");
}
int do_tilian(string arg) {
  object me;
  me = this_player();
  if (!id(arg)) return 0;
  if (me->is_busy()) return notify_fail("你上一个动作还没有完成。\n");

  message_vision("$N打开了仓库备用包,爽!\n", me);

  addn("cangku", 10, me);

  tell_object(me, HIY "恭喜你的仓库增加了10格。\n" NOR);

  destruct(this_object());
  return 1;

}
int query_autoload() {
  return 1;
}
