#include <ansi.h>

inherit ITEM;

void create() {
  set_name(HIR "朱雀重生" NOR, ({ "zhuque" }));
  set_weight(200);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "图腾技能只可购买1个，多个无效。\n" ZJURL("cmds:eat zhuque") ZJSIZE(15) "使用" NOR "看看!\n");
    set("yuanbao", 300);
    set("value", 10000);
    set("unit", "粒");
    set("only_do_effect", 1);
  }
}

int do_effect(object me) {
  if (query("quest_tuteng/end2", me)) {
    write("你已经拥有图腾技能了，无法使用。\n");
    return 1;
  } else if (!query("special_skill/zhuque", me)) {
    set("special_skill/zhuque", 1, me);
    set("quest_tuteng/end2", 1, me);
    message_vision("$N学会了" + this_object()->name() +
      "。\n", me);
    destruct(this_object());
  } else {
    message_vision("$N一仰脖，吞下了一粒" + this_object()->name() +
      "发现原来已经学过这个技能了。\n", me);
  }
  return 1;
}
