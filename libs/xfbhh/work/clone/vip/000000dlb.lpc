        set_name(HIM"三千大礼包"NOR,({"xiang"}));
        //这个一定要设置：
        set("BAOXIANG_LIST",([
		        "/clone/goods/taixu":60000,
				"/clone/goods/hupo":60000,
				"/clone/goods/xuanyu":60000,
				"/clone/goods/shihun":60000,
				"/clone/goods/hantie":60000,
				"/clone/goods/shenmo":60000,
                "/clone/goods/noname2":60000,   //物品文件名:概率
                "/clone/gift/jiuzhuan":69900,   //物品文件名:概率
                "/clone/fam/item/tntn_fu":50000,   //物品文件名:概率
                "/clone/goods/hongmeng-lingqi":50000,   //物品文件名:概率
                "/clone/goods/qianghua_crystal":50000,   //物品文件名:概率
                "/clone/goods/shengling_crystal":50000,
                "/clone/goods/dragon_soul2":50000,
                "/clone/vip/jinzhu":30000,
                "/d/dongtian/obj/wanxiangbook":80000,
                "/clone/fam/enchase/tiandiriyue-zhu2":15000,
                "/clone/fam/enchase/xuedi-shengyin2":15000,
                "/clone/fam/enchase/xuanwu-shengshi2":15000,
                "/clone/fam/enchase/qilin-shenghuo2":15000,
