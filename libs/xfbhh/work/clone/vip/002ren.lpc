#include <ansi.h>

inherit ITEM;

void create() {
  set_name(HIR "血脉人体" NOR, ({ "wisdom" }));
  set_weight(200);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "血脉技能。\n" ZJURL("cmds:eat wisdom") ZJSIZE(15) "使用" NOR "看看!\n");
    set("yuanbao", 2222);
    set("value", 10000);
    set("unit", "粒");
    set("only_do_effect", 1);
  }
}

int do_effect(object me) {
  /* if( query("quest_tuteng/end22", me))
        {
                write("你已经拥有血脉技能了，无法使用。\n");
                return 1;
        } else*/
  if (!query("special_skill/wisdom", me)) {
    delete("special_skill/stealth", me);
    set("special_skill/wisdom", 1, me);
    delete("special_skill/demon", me);
    delete("special_skill/nopoison", me);
    delete("special_skill/ghost", me);
    delete("special_skill/monster", me);
    set("xuemai_level", 10, me);
    //set("quest_tuteng/end22", 1, me);
    /*addn("str", 2, me);
		addn("dex", 2, me);
		addn("int", 2, me);
		addn("con", 2, me);*/
    message_vision("$N学会了" + this_object()->name() +
      "。\n", me);
    destruct(this_object());
  } else {
    message_vision("$N一仰脖，吞下了一粒" + this_object()->name() +
      "发现原来已经学过这个技能了。\n", me);
  }
  return 1;
}
