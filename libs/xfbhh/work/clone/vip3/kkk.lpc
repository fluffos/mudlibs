#include <ansi.h>
inherit COMBINED_ITEM;

void create()
{
        set_name(NOR + HIR "玉石俱焚" NOR, ({ "gan liang", "gan", "liang" }));
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("long", NOR + WHT "\n" NOR);
                set("base_unit", "块");
                set("base_value", 50);
				set("family/gongji", 8000);
                set("base_weight", 10);
                set("only_do_effect", 1);
        }
        setup();
        set_amount(1);
}

int do_effect(object me)
{
        /*if( query("food", me) >= me->max_food_capacity() )
        {
                write("你已经吃太饱了，再也塞不下任何东西了。\n");
                return 1;
        }*/

     message_vision("你学会了玉石俱焚。\n" NOR, me);
         me->set("can_perform/tonggui-jian/fen", 1);
  add_amount(-1);

        if (query_amount() < 1)
                destruct(this_object());

        return 1;
}
