#include <ansi.h>

inherit ITEM;

void create() {
  set_name(HBMAG "虚无本源" NOR, ({ "xuwu benyuan", "xuwu", "benyuan" }));
  set_weight(10000);
  /*if (clonep())
                set_default_object(__FILE__);
        else*/
  {
    set("long", sort_msg(HBMAG "无尽虚无中的一道本源"
      "其内似乎含有着无可匹敌之威能"
      "这种物品本应在时间长河中消逝"
      "却不知为何出现在此时。\n" NOR));
    set("unit", "块");
    set("family/gongji", 150000);
    set("item_origin", 1);
    set("material_attrib", "xuwu benyuan");
    set("material_name", HBMAG "虚无本源" NOR);
    set("can_make", "all");
    set("power_point", 88888888 + random(11111111));
  }
}
