inherit BAOXIANG_ITEM;

void create()
{
        set_name(HIM"高爆三千大礼包"NOR,({"xiang"}));
        //这个一定要设置：
        set("BAOXIANG_LIST",([
		        "/clone/goods/taixu":600,
				"/clone/goods/hupo":600,
				"/clone/goods/xuanyu":600,
				"/clone/goods/shihun":600,
				"/clone/goods/hantie":600,
				"/clone/goods/shenmo":600,
                "/clone/goods/noname2":600,   //物品文件名:概率
                "/clone/gift/jiuzhuan":699,   //物品文件名:概率
                "/clone/fam/item/tntn_fu":500,   //物品文件名:概率
                "/clone/goods/hongmeng-lingqi":500,   //物品文件名:概率
                "/clone/goods/qianghua_crystal":500,   //物品文件名:概率
                "/clone/goods/shengling_crystal":500,
                "/clone/goods/dragon_soul2":500,
                "/clone/vip/jinzhu":300,
                "/d/dongtian/obj/wanxiangbook":800,
                "/clone/fam/enchase/tiandiriyue-zhu2":150,
                "/clone/fam/enchase/xuedi-shengyin2":150,
                "/clone/fam/enchase/xuanwu-shengshi2":150,
                "/clone/fam/enchase/qilin-shenghuo2":150,
