#include <ansi.h>

inherit TESSERA;

void create() {
  set_name(HBRED "神魔残念" NOR, ({ "jing po", "jing" }));
  set_weight(1);
  /*if (clonep())
                set_default_object(__FILE__);
        else*/
  {
    set("long", HBRED "三千神魔死亡后凝结而成的残念。\n" NOR);
    set("value", 50000);
    set("unit", "块");
    set("can_enchant", "all");
    set("can_be_enchased", 1);
    set("magic/type", "magic");
    set("magic/power", 500);
    set("auto_load", 1);
  }

  set("enchase", ([ /* sizeof() == 5 */
    "armor_prop": ([ /* sizeof() == 3 */
      "str": random(500),
      "int": random(500),
      "con": random(500),
      "dex": random(500),
      "ker": random(500),
      "par": random(500),
      "avoid_poison": 5,
      "counter_damage": 5,
      "add_skill": random(666),
    ]),
    "type": "all",
    //"SN" : 1 + random(9),
  ]));

  set("enchant", 1);
  set("set_data", 1);
  setup();
}
