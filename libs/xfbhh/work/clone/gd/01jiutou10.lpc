// xiandan.c 仙丹

#include <ansi.h>

inherit ITEM;

void create() {
  set_name(HIY "九头蛇10" NOR, ({ "she dan" }));
  set_weight(200);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一天九头蛇领地练级时间,重复使用不累计\n" ZJURL("cmds:eat she dan") ZJSIZE(15) "使用" NOR "看看!\n");
    set("gongde", 300);
    set("value", 10000);
    set("unit", "粒");
    set("only_do_effect", 1);
  }
}

int do_effect(object me) {
  message_vision("$N一仰脖，吞下了一粒" + this_object()->name() +
    "。\n", me);
  me->set_srv("enter_jtshe", 86400 * 1);

  destruct(this_object());
  return 1;
}
