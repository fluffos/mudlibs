#include <ansi.h>

inherit ITEM;

void create() {
  set_name(HIR "元神丹" NOR, ({ "y s" }));
  set_weight(200);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "降低元神等级的神丹。\n" ZJURL("cmds:eat y s") ZJSIZE(15) "使用" NOR "看看!\n");
    set("gongde", 500);
    set("value", 1000);
    set("unit", "粒");
    set("only_do_effect", 1);
  }
}

int do_effect(object ob) {
  message_vision("$N一仰脖，吞下了一粒" + this_object()->name() + "。\n", ob);
  if (query("yuanshen_level", ob) < 101) {
    write("你元神等级不够101级！\n");
    return 1;
  }
  /* if (query("gender", ob) == "女性") {
                                write("你已经是女人了，不信你抠抠..\n"); 
                                return 1;
                             }*/
  CHANNEL_D->channel_broadcast("rumor", "听说" + query("name", ob) + "吞了元神丹？\n" + NOR);
  set("yuanshen_level", 90, ob);
  set("yuanshen_exp", 5000000000, ob);
  //delete("couple/couple_id", ob);  
  // delete("couple/child_id", ob);  
  destruct(this_object());
  return 1;
}
