#include <ansi.h>
inherit BAOXIANG_ITEM;

void create() {
  set_name(HIM "运气大礼包" NOR, ({ "xiang" }));
  //这个一定要设置：
  set("BAOXIANG_LIST", ([
    "/clone/goods/taixu": 45,
    "/clone/goods/hupo": 45,
    "/clone/goods/xuanyu": 45,
    "/clone/goods/shihun": 45,
    "/clone/goods/hantie": 44,
    "/clone/goods/shenmo": 50,
    "/clone/goods/noname2": 60,   //物品文件名:概率
    "/clone/gift/jiuzhuan": 95,   //物品文件名:概率
    "/clone/fam/item/tntn_fu": 90,   //物品文件名:概率
    "/clone/goods/hongmeng-lingqi": 85,   //物品文件名:概率
    "/clone/goods/qianghua_crystal": 80,   //物品文件名:概率
    "/clone/goods/shengling_crystal": 75,
    "/clone/goods/dragon_soul2": 70,
    "/clone/vip/jinzhu": 20,
    "/d/dongtian/obj/wanxiangbook": 100,
    "/clone/fam/enchase/tiandiriyue-zhu2": 5,
    "/clone/fam/enchase/xuedi-shengyin2": 5,
    "/clone/fam/enchase/xuanwu-shengshi2": 5,
    "/clone/fam/enchase/qilin-shenghuo2": 5,
    "/clone/fam/enchase/liuxing-ganyue2": 5,
    "/clone/fam/enchase/bihai-canjue2": 5,
    "/clone/fam/enchase/kongque-shengshi2": 5,
    "/clone/fam/enchase/shenglong-zhihun2": 5,
    "/clone/fam/enchase/chilian-hudan2": 5,
    "/clone/fam/enchase/zhenwu-baoshi2": 5,
    "/clone/v1/honghuang": 1,
  ]));  //概率是以1000作为总数，且几项的概率总和为1000，概率大的出现几率高。。。

  set("long", HIY "这是一只金色的宝箱，装饰的珠光宝气，你或许可以打开（open）它。\n" NOR);
  set("unit", "些");
  set("base_unit", "个");
  set("no_give", 1);
  set("no_drop", 1);
  set("base_weight", 1);
  set("base_value", 1);
  set_amount(1);  //因为是个combined物品 所以这个一定要设置，不然报错的

}
void init() {
  add_action("do_open", "open");  //玩家使用的接口 具体内容在std里
  //add_action("do_test","test"); //用于巫师测试用 测试ok请注释此行
}
