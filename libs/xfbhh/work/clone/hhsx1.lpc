#include <ansi.h>

inherit TESSERA;

void create() {
  set_name(RED "洪荒属性" NOR, ({ "jing po", "jing" }));
  set_weight(1);
  /*if (clonep())
                set_default_object(__FILE__);
        else*/
  {
    set("long", RED "\n" NOR);
    set("value", 50000);
    set("unit", "块");
    set("can_enchant", "weapon");
    set("can_be_enchased", 1);
    set("magic/type", "magic");
    set("magic/power", 500);
    set("auto_load", 1);
  }

  set("enchase", ([ /* sizeof() == 5 */
    "weapon_prop": ([ /* sizeof() == 3 */
      "str": 700,
      "int": 700,
      "con": 700,
      "dex": 700,
      "ker": 700,
      "par": 700,
      //"avoid_poison" : 5,
      //"counter_damage" : 5,
      "add_skill": 700,
    ]),
    "type": "all",
    //"SN" : 1 + random(9),
  ]));

  set("enchant", 1);
  set("set_data", 1);
  setup();
}
