#include <localtime.h>
#include <ansi.h>
inherit ITEM;

//函数生命
int GiveVipItem(object me);

//结构函数
void create() {
  set_name(HIY "贵宾卡-年·" NOR, ({ "vip card" }));
  set("long", "365天VIP贵宾会员卡。" ZJURL("cmds:upvip") ZJSIZE(12) "我要升级" NOR "！\n"
  );
  set("unit", "张");
  set("yuanbao", 700);
  set("value", 10000);
}

void init() {
  add_action("do_vip", "upvip");
}

int do_vip(string arg) {
  object me, ob;
  me = this_player();
  ob = this_object();


  if (GiveVipItem(me)) {
    destruct(ob);
    return 1;
  } else {
    tell_object(me, HIR "升级贵宾权限失败，请联系Wiz。\n" NOR);
    return 1;
  }
  return 1;
}

//函数：赠送道具
int GiveVipItem(object me) {
  int time;
  mixed localtime;


  if (!me) return 0;

  if (!query("gift_zshuiyuan", me)) time = time() + 24 * 3600 * 365;
  else time = query("gift_zshuiyuan", me) + 24 * 3600 * 365;
  localtime = localtime(time);

  message_vision(HIR "$N成为了VIP贵宾!恭喜恭喜\n" NOR, me);
  tell_object(
    me,
    sprintf(
      HIG "贵宾权限到期时间%d年%d月%d日%d时%d分%d秒。\n" NOR,
      localtime[LT_YEAR],
      1 + localtime[LT_MON],
      localtime[LT_MDAY],
      localtime[LT_HOUR],
      localtime[LT_MIN],
      localtime[LT_SEC]
    )
  );
  set("vip", 1, me);
  set("gift_zshuiyuan", time, me);
  set("title", HIY "VIP贵宾" NOR, me);
  addn("srv/quit_save", 86400 * 365);

  me->save();
  return 1;
}
int query_autoload() {
  return 1;
}
