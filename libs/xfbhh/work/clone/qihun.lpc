// 玄兵圣水用于开孔兵器

#include <ansi.h>

inherit ITEM;

void create() {
  set_name(HIM "器魂" NOR, ({ "qi hun", "hun" }));
  set_weight(30);

  /*if (clonep())
                set_default_object(__FILE__);
        else*/
  {
    set("long", HIW "一个法宝的残破器魂，。\n"
      "他可以用来直接激活(jihuo)法宝最大孔数。\n" NOR);
    set("yuanbao", 300);
    set("no_sell", 1);
    set("unit", "块");
    set("type", "fabao");
    set("status", 1);
    set("auto_load", 1);

  }

  setup();
}

void init() {
  add_action("do_kuokong", "jihuo");
}

int do_kuokong(string arg) {
  object me;
  object ob;
  object item;

  if (!arg)
    return notify_fail("你要往什么道具上使用器魂？\n");

  me = this_player();
  if (!objectp(ob = present(arg, me)) &&
    !objectp(ob = present(arg, environment(me))))
    return notify_fail("你身上和附近没有这样道具啊。\n");

  if (ob == this_object() || ob->is_character())
    return notify_fail("你想要干什么?\n");

  if (!ob->is_item_make())
    return notify_fail(ob->name() + "无法用器魂来扩展凹槽。\n");

  if (ob->is_armor())
    return notify_fail("你只能在法宝上使用该器魂。\n" NOR);

  /*if (ob->is_weapon("fabao"))
		       return notify_fail("你只能在法宝上使用该器魂。\n"NOR);*/


  /*if( !query("enchase/flute", ob) )
                return notify_fail("你还是先去开孔后再考虑扩展凹槽吧。\n");
                
        set("ultimate/37", 1, ob);
        set("ultimate/39", 1, ob);*/

  /* if( set("type : fabao", ob )*/
  addn("enchase/flute", 1, ob);


  ob->save();
  tell_object(me, "你把器魂" + name() + "激活在" + ob->name() + "上，"
    "只见" + ob->name() + "通体红光爆闪，豁然发生了不小的变化！\n");

  destruct(this_object());
  return 1;
}
