#include <ansi.h>

inherit EQUIP_SOUL;

void create() {
  set_name(HIM "项链之魂" NOR, ({ "neck soul6" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", HIM "完美的项链之魂，可用来改造项链。\n" NOR);
    set("unit", "个");
    set("gongde", 100);
    set("value", 10000);
    set("no_sell", 1);
  }
  set("type", "neck");
  set("status", 6);
  set("auto_load", 1);

  setup();
}
