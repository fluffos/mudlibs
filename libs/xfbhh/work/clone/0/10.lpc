#include <ansi.h>
#include <armor.h>
inherit FINGER;
 
void create()
{
        set_name(HBCYN "洪荒魔指" NOR, ({ "honghuang finger", "finger" }) );
        set_weight(500);
        /*if (clonep())
                set_default_object(__FILE__);
        else*/
        {
                set("unit", "副");
                set("long", HIY "这便是洪荒使用过的指套，通体血光滔天。\n"
                            HIY + name() + HIY "的等级：远古神品  LV10\n" NOR);
                 set("yuanbao", 5); 
                set("no_sell", "这样东西不能卖。\n");
                set("rigidity",8000);   
                set("material", "hong huang");
                
                set("armor_prop/armor", 10);
                set("armor_prop/unarmed_damage", 50000);
        }
        
        set("mod_mark", "T9");
        set("mod_level", "T8");
        set("mod_name", HBRED "洪荒套装" NOR);
        set("quality_level", 5);

        setup();
}



int query_autoload() { return 0; }
