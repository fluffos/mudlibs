#include <ansi.h>

inherit ITEM;

int is_tongren() { return 1; }
void create() {
  set_name("足厥阴脉·阴廉穴" NOR, ({ "tongren u14" }));
  set_weight(50);

  set("unit", "个");
  set("long", NOR + YEL "这是一个冲穴铜人\n" ZJURL("cmds:chongxue tongren u14") ZJSIZE(10) "冲穴" NOR "\n");
  set("value", 10000);
  set("material", "steal");

  set("jingmai_name", "足厥阴脉");
  set("xuewei_name", "阴廉穴");
  set("chongxue_xiaoguo", "NEI:40:_STR:2");
  set("neili_cost", "8000");
  setup();
}
