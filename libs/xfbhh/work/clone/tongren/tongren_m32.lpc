#include <ansi.h>

inherit ITEM;

int is_tongren() { return 1; }
void create() {
  set_name("足太阳脉·气海俞穴" NOR, ({ "tongren m32" }));
  set_weight(50);

  set("unit", "个");
  set("long", NOR + YEL "这是一个冲穴铜人\n" ZJURL("cmds:chongxue tongren m32") ZJSIZE(10) "冲穴" NOR "\n");
  set("value", 10000);
  set("material", "steal");

  set("jingmai_name", "足太阳脉");
  set("xuewei_name", "气海俞穴");
  set("chongxue_xiaoguo", "JING:20");
  set("neili_cost", "2000");
  setup();
}
