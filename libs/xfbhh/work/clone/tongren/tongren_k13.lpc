#include <ansi.h>

inherit ITEM;

int is_tongren() { return 1; }
void create() {
  set_name("手太阳脉·养老穴" NOR, ({ "tongren k13" }));
  set_weight(50);

  set("unit", "个");
  set("long", NOR + YEL "这是一个冲穴铜人\n" ZJURL("cmds:chongxue tongren k13") ZJSIZE(10) "冲穴" NOR "\n");
  set("value", 10000);
  set("material", "steal");

  set("jingmai_name", "手太阳脉");
  set("xuewei_name", "养老穴");
  set("chongxue_xiaoguo", "JING:40:NEI:30");
  set("neili_cost", "300");
  setup();
}
