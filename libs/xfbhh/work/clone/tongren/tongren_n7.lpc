
#include <ansi.h>

inherit ITEM;

int is_tongren() { return 1; }
void create()
{
        set_name( "手少阴脉·青灵穴" NOR, ({ "tongren n7" }));
        set_weight(50);
        
        set("unit", "个");
        set("long", NOR + YEL "这是一个冲穴铜人\n"ZJURL("cmds:chongxue tongren n7")ZJSIZE(10)"冲穴"NOR"\n");
        set("value", 10000);
        set("material", "steal");

        set("jingmai_name", "手少阴脉");
        set("xuewei_name", "青灵穴");
        set("chongxue_xiaoguo", "NEI:30:_INT:2");
        set("neili_cost", "1000");
        setup();
}


