#include <ansi.h>

inherit ITEM;

int is_tongren() { return 1; }
void create() {
  set_name("阳跷脉·肩髃穴" NOR, ({ "tongren b6" }));
  set_weight(50);

  set("unit", "个");
  set("long", NOR + YEL "这是一个冲穴铜人\n" ZJURL("cmds:chongxue tongren b6") ZJSIZE(10) "冲穴" NOR "\n");
  set("value", 10000);
  set("material", "steal");

  set("jingmai_name", "阳跷脉");
  set("xuewei_name", "肩髃穴");
  set("chongxue_xiaoguo", "QI:300");
  set("neili_cost", "300");
  setup();
}
