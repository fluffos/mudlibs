#include <ansi.h>

inherit ITEM;

int is_tongren() { return 1; }
void create() {
  set_name("足少阳脉·目窗穴" NOR, ({ "tongren q10" }));
  set_weight(50);

  set("unit", "个");
  set("long", NOR + YEL "这是一个冲穴铜人\n" ZJURL("cmds:chongxue tongren q10") ZJSIZE(10) "冲穴" NOR "\n");
  set("value", 10000);
  set("material", "steal");

  set("jingmai_name", "足少阳脉");
  set("xuewei_name", "目窗穴");
  set("chongxue_xiaoguo", "NEI:130");
  set("neili_cost", "6000");
  setup();
}
