#include <ansi.h>

inherit ITEM;

int is_tongren() { return 1; }
void create() {
  set_name("阴维脉·灵道穴" NOR, ({ "tongren c10" }));
  set_weight(50);

  set("unit", "个");
  set("long", NOR + YEL "这是一个冲穴铜人\n" ZJURL("cmds:chongxue tongren c10") ZJSIZE(10) "冲穴" NOR "\n");
  set("value", 10000);
  set("material", "steal");

  set("jingmai_name", "阴维脉");
  set("xuewei_name", "灵道穴");
  set("chongxue_xiaoguo", "NEI:100:QI:100");
  set("neili_cost", "800");
  setup();
}
