#include <ansi.h>

inherit ITEM;

int is_tongren() { return 1; }
void create() {
  set_name("阴维脉·阴郄穴" NOR, ({ "tongren c12" }));
  set_weight(50);

  set("unit", "个");
  set("long", NOR + YEL "这是一个冲穴铜人\n" ZJURL("cmds:chongxue tongren c12") ZJSIZE(10) "冲穴" NOR "\n");
  set("value", 10000);
  set("material", "steal");

  set("jingmai_name", "阴维脉");
  set("xuewei_name", "阴郄穴");
  set("chongxue_xiaoguo", "NEI:700");
  set("neili_cost", "1500");
  setup();
}
