#include <ansi.h>

inherit ITEM;

int is_tongren() { return 1; }
void create() {
  set_name("手少阳脉·中泽穴" NOR, ({ "tongren o19" }));
  set_weight(50);

  set("unit", "个");
  set("long", NOR + YEL "这是一个冲穴铜人\n" ZJURL("cmds:chongxue tongren o19") ZJSIZE(10) "冲穴" NOR "\n");
  set("value", 10000);
  set("material", "steal");

  set("jingmai_name", "手少阳脉");
  set("xuewei_name", "中泽穴");
  set("chongxue_xiaoguo", "QI:30:DMG:10");
  set("neili_cost", "10000");
  setup();
}
