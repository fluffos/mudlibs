#include <ansi.h>

inherit ITEM;

int is_tongren() { return 1; }
void create() {
  set_name("足阳明脉·屋翳穴" NOR, ({ "tongren s14" }));
  set_weight(50);

  set("unit", "个");
  set("long", NOR + YEL "这是一个冲穴铜人\n" ZJURL("cmds:chongxue tongren s14") ZJSIZE(10) "冲穴" NOR "\n");
  set("value", 10000);
  set("material", "steal");

  set("jingmai_name", "足阳明脉");
  set("xuewei_name", "屋翳穴");
  set("chongxue_xiaoguo", "JING:30:WATER:100");
  set("neili_cost", "8000");
  setup();
}
