#include <ansi.h>

inherit ITEM;

int is_tongren() { return 1; }
void create() {
  set_name("手少阳脉·消泺穴" NOR, ({ "tongren o16" }));
  set_weight(50);

  set("unit", "个");
  set("long", NOR + YEL "这是一个冲穴铜人\n" ZJURL("cmds:chongxue tongren o16") ZJSIZE(10) "冲穴" NOR "\n");
  set("value", 10000);
  set("material", "steal");

  set("jingmai_name", "手少阳脉");
  set("xuewei_name", "消泺穴");
  set("chongxue_xiaoguo", "QI:50:_STR:1");
  set("neili_cost", "1000");
  setup();
}
