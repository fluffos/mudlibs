#include <ansi.h>

inherit ITEM;

int is_tongren() { return 1; }
void create() {
  set_name("阴跷脉·盆缺穴" NOR, ({ "tongren a8" }));
  set_weight(50);

  set("unit", "个");
  set("long", NOR + YEL "这是一个冲穴铜人\n" ZJURL("cmds:chongxue tongren a8") ZJSIZE(10) "冲穴" NOR "\n");
  set("value", 10000);
  set("material", "steal");

  set("jingmai_name", "阴跷脉");
  set("xuewei_name", "盆缺穴");
  set("chongxue_xiaoguo", "JING:20");
  set("neili_cost", "200");
  setup();
}
