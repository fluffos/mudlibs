#include <ansi.h>

inherit ITEM;

int is_tongren() { return 1; }
void create() {
  set_name("阳维脉·臑俞穴" NOR, ({ "tongren d2" }));
  set_weight(50);

  set("unit", "个");
  set("long", NOR + YEL "这是一个冲穴铜人\n" ZJURL("cmds:chongxue tongren d2") ZJSIZE(10) "冲穴" NOR "\n");
  set("value", 10000);
  set("material", "steal");

  set("jingmai_name", "阳维脉");
  set("xuewei_name", "臑俞穴");
  set("chongxue_xiaoguo", "POT:100");
  set("neili_cost", "600");
  setup();
}
