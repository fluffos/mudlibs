
#include <ansi.h>

inherit ITEM;

int is_tongren() { return 1; }
void create()
{
        set_name( "阴维脉·青灵穴" NOR, ({ "tongren c8" }));
        set_weight(50);
        
        set("unit", "个");
        set("long", NOR + YEL "这是一个冲穴铜人\n"ZJURL("cmds:chongxue tongren c8")ZJSIZE(10)"冲穴"NOR"\n");
        set("value", 10000);
        set("material", "steal");

        set("jingmai_name", "阴维脉");
        set("xuewei_name", "青灵穴");
        set("chongxue_xiaoguo", "NEI:800:ATK:20");
        set("neili_cost", "4000");
        setup();
}


