#include <ansi.h>

inherit ITEM;

int is_tongren() { return 1; }
void create() {
  set_name("手厥阴脉·劳宫穴" NOR, ({ "tongren t5" }));
  set_weight(50);

  set("unit", "个");
  set("long", NOR + YEL "这是一个冲穴铜人\n" ZJURL("cmds:chongxue tongren t5") ZJSIZE(10) "冲穴" NOR "\n");
  set("value", 10000);
  set("material", "steal");

  set("jingmai_name", "手厥阴脉");
  set("xuewei_name", "劳宫穴");
  set("chongxue_xiaoguo", "JING:50:_DEX:1");
  set("neili_cost", "8000");
  setup();
}
