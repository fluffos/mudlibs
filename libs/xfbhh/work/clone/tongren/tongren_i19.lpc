#include <ansi.h>

inherit ITEM;

int is_tongren() { return 1; }
void create() {
  set_name("经外奇脉·百虫窝穴" NOR, ({ "tongren i19" }));
  set_weight(50);

  set("unit", "个");
  set("long", NOR + YEL "这是一个冲穴铜人\n" ZJURL("cmds:chongxue tongren i19") ZJSIZE(10) "冲穴" NOR "\n");
  set("value", 10000);
  set("material", "steal");

  set("jingmai_name", "经外奇脉");
  set("xuewei_name", "百虫窝穴");
  set("chongxue_xiaoguo", "MAR:30");
  set("neili_cost", "8000");
  setup();
}
