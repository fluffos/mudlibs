#include <ansi.h>

inherit ITEM;

int is_tongren() { return 1; }
void create() {
  set_name("足厥阴脉·中封穴" NOR, ({ "tongren u6" }));
  set_weight(50);

  set("unit", "个");
  set("long", NOR + YEL "这是一个冲穴铜人\n" ZJURL("cmds:chongxue tongren u6") ZJSIZE(10) "冲穴" NOR "\n");
  set("value", 10000);
  set("material", "steal");

  set("jingmai_name", "足厥阴脉");
  set("xuewei_name", "中封穴");
  set("chongxue_xiaoguo", "JING:40");
  set("neili_cost", "8000");
  setup();
}
