#include <ansi.h>

inherit ITEM;

int is_tongren() { return 1; }
void create() {
  set_name("阳跷脉·臑俞穴" NOR, ({ "tongren b5" }));
  set_weight(50);

  set("unit", "个");
  set("long", NOR + YEL "这是一个冲穴铜人\n" ZJURL("cmds:chongxue tongren b5") ZJSIZE(10) "冲穴" NOR "\n");
  set("value", 10000);
  set("material", "steal");

  set("jingmai_name", "阳跷脉");
  set("xuewei_name", "臑俞穴");
  set("chongxue_xiaoguo", "QI:500:MAR:50");
  set("neili_cost", "800");
  setup();
}
