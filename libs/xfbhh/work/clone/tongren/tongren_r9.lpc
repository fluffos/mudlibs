
#include <ansi.h>

inherit ITEM;

int is_tongren() { return 1; }
void create()
{
        set_name( "手阳明脉·口禾髎穴" NOR, ({ "tongren r9" }));
        set_weight(50);
        
        set("unit", "个");
        set("long", NOR + YEL "这是一个冲穴铜人\n"ZJURL("cmds:chongxue tongren r9")ZJSIZE(10)"冲穴"NOR"\n");
        set("value", 10000);
        set("material", "steal");

        set("jingmai_name", "手阳明脉");
        set("xuewei_name", "口禾髎穴");
        set("chongxue_xiaoguo", "QI:30:ADDPOT:1000000");
        set("neili_cost", "8000");
        setup();
}


