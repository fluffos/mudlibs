#include <ansi.h>

inherit ITEM;

int is_tongren() { return 1; }
void create() {
  set_name("足太阳脉·玉枕穴" NOR, ({ "tongren m22" }));
  set_weight(50);

  set("unit", "个");
  set("long", NOR + YEL "这是一个冲穴铜人\n" ZJURL("cmds:chongxue tongren m22") ZJSIZE(10) "冲穴" NOR "\n");
  set("value", 10000);
  set("material", "steal");

  set("jingmai_name", "足太阳脉");
  set("xuewei_name", "玉枕穴");
  set("chongxue_xiaoguo", "POT:20");
  set("neili_cost", "12000");
  setup();
}
