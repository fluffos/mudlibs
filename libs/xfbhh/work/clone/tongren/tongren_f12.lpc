#include <ansi.h>

inherit ITEM;

int is_tongren() { return 1; }
void create() {
  set_name("冲脉·阴都穴" NOR, ({ "tongren f12" }));
  set_weight(50);

  set("unit", "个");
  set("long", NOR + YEL "这是一个冲穴铜人\n" ZJURL("cmds:chongxue tongren f12") ZJSIZE(10) "冲穴" NOR "\n");
  set("value", 10000);
  set("material", "steal");

  set("jingmai_name", "冲脉");
  set("xuewei_name", "阴都穴");
  set("chongxue_xiaoguo", "QI:100");
  set("neili_cost", "1000");
  setup();
}
