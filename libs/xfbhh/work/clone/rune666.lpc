
//rune33.c

// Zod薩德

#include <ansi.h>

inherit TESSERA;

int is_rune() { return 1; }

void create()
{
        set_name(HIW "天下第一" NOR, ({"rune666"}));
        set_weight(10);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("long", "符文：天下第一，可以放入凹槽物品。\n");
                set("unit", "个");
                set("enchase/SN", 36);
				set("yuanbao", 888);
                set("enchase/type", "all");
                set("enchase/consistence", 100);
                set("enchase/weapon_prop", ([
                        "derive_effect" : 30,
                        "research_times" : 1000,
                        "research_effect" : 30,
						"practice_effect" : 30,
						"study_times"   : 1000,
						"learn_times"     : 30,
						"derive_times"  : 1000,
						"practice_times"       : 1000,
						"max_experience":5000000,
                ]));
                set("enchase/armor_prop", ([
                        "derive_effect" : 30,
						"practice_effect" : 30,
                        "research_times" : 1000,
                        "research_effect" : 30,
						"study_times"   : 1000,
						"learn_times"     : 30,
						"derive_times"  : 1000,
						"practice_times"       : 1000,
						"max_experience":5000000,
                ]));
                set("value", 20000);
        }
        setup();
}

int query_autoload() { return 1; }

