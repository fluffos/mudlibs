#include <armor.h>
#include <ansi.h>

inherit RINGS;


void init() {
  object me = this_player();
  //add_action("do_drink","drink"); 
  //add_action("do_ding","ding"); 
  add_action("do_zhan", "natou");
}

int can_force(object me, object victim) {
  object where = environment(victim);

  if (!where || !objectp(where)) {
    tell_object(me, NOR + "这个目标大概还没有出生！\n" + NOR);
    return 0;
  }

  return 1;
}

int do_zhan(string arg) {
  object victim, head, corpse, where;
  object *obs;
  int i;
  string msg;
  object me = this_player();

  if (me->is_busy()) {
    return notify_fail(NOR + "你还是忙完再说吧！\n" + NOR);
  }


  if ((!arg || arg == "") && (!query_temp("target_obj")))
    arg = query("quest/id", me);

  if ((!arg || arg == "") && (query_temp("target_obj"))) {
    victim = query_temp("target_obj");
    if (!victim || (victim == me || !living(victim) || !objectp(victim))) return notify_fail(NOR + "你选择的目标不对劲！\n" + NOR);
    if (can_force(me, victim)) {
      message_vision(CYN + "$N举起" + query("name") + CYN + "对准天空\n" + NOR, me, victim);
      where = environment(victim);
      msg = query("name", victim);
      set("last_opponent", me, victim); victim->kill_ob(me);
      set_temp("die_reason", "被" + query("name", me) + "射出的化血神针击中化为一摊血水", victim);
      victim->die();
      corpse = present("corpse", where);
      if (base_name(corpse) == "/clone/misc/corpse") {
        message_vision(
          CYN + "只见一根" + HIW + "血红色的针" + NOR + CYN + "射到了" + msg + NOR + CYN + "的胸口处，随即化为一摊血水。\n" + NOR,
          me
        );
        set("defeated_by", query("id", me), corpse);
        set("defeated_by_who", query("id", me), corpse);
        set("killed_by", query("id", me), corpse);
        head = new("/clone/misc/head");
        head->set_from(corpse);
        set("defeated_by", query("id", me), corpse);
        set("defeated_by_who", query("id", me), corpse);
        set("killed_by", query("id", me), corpse);
        head = new("/clone/misc/head");
        head->set_from(corpse);
        head->move(environment(me));
      } else {
        message_vision(
          HIW + "只见一根" + NOR + CYN + "血红色的针" + msg + NOR + CYN + "身边三尺的地方掉了下来。\n" + NOR,
          me
        );
      }
      this_object()->add("amount", -40);
    }
    me->start_busy(2 + random(2));
    return 1;
  } else {
    victim = present(arg, environment(me));
    if (!victim || (victim == me || !living(victim) || !objectp(victim))) {  //return notify_fail(NOR + "你选择的目标不对劲！\n" + NOR);    
      foreach (object tob in objects()) {
        if (tob->id(arg)) {
          victim = tob;
          break;
        }
      }
    }
    if (!victim || (victim == me || !living(victim) || !objectp(victim))) return notify_fail(NOR + "整个世界也没有合适的目标！\n" + NOR);
    if (can_force(me, victim)) {
      where = environment(victim);
      msg = query("name", victim);
      message_vision(CYN + "$N面露凶光" + query("name") + CYN + "捏了几个手印：“古曼童”。\n" + NOR, me);
      message_vision(
        CYN + query("name") + CYN + "散发出邪恶的气息只见" + HIR + "古" + HIG + "曼" + HIY + "童" + HIC + "罐" + NOR + CYN + "，的古曼童，化作" + HIW + "流光" + NOR + CYN + "穿透虚空盯住" + (stringp(where->short()) ? where->short() : "遥远处") + NOR + CYN + "的" + NOR + CYN + msg + NOR + CYN + "...\n" + NOR,
        me
      );
      message_vision(
        CYN + "天外突然飞来小鬼孩" + HIW + "血红色的附有邪恶气息" + NOR + CYN + "，上有两个血红色的双眼，对$N说道" + NOR + CYN + "头留下\n" + NOR,
        victim
      );
      msg = query("name", victim);
      set("last_opponent", me, victim);  //                     victim->kill_ob(me);
      set_temp("die_reason", "被" + query("name", me) + "用邪恶的古曼童把头带走,身体化作一摊血水", victim);
      victim->die();
      corpse = present("corpse", where);
      if (base_name(corpse) == "/clone/misc/corpse") {
        message_vision(
          CYN + "只见" + HIW + "血红色流光一闪" + NOR + CYN + "在" + msg + NOR + CYN + "脖子上一扎，转眼身首异处，无头尸体化作一摊血水。\n" + NOR,
          where
        );
        message_vision(
          CYN + "只见" + HIW + "血红色流光" + NOR + CYN + "倏地消失，忽然间" + HIW + "一道残影" + NOR + CYN + "急射而回，空中掉下一血淋淋颗头颅，" + HIW + "古曼童" + NOR + CYN + "回到" + query("name") + NOR + CYN + "。\n" + NOR,
          me
        );
        set("defeated_by", query("id", me), corpse);
        set("defeated_by_who", query("id", me), corpse);
        set("killed_by", query("id", me), corpse);
        head = new("/clone/misc/head");
        head->set_from(corpse);
        head->move(environment(me));
      } else {
        message_vision(
          CYN + "只见" + HIW + "红光化作刀状" + NOR + CYN + "在" + msg + NOR + CYN + "脖子上一闪，然而，并无什么用处。\n" + NOR,
          where
        );
        message_vision(
          CYN + "只见那" + HIW + "红光" + NOR + CYN + "倏地消失，须臾间" + HIW + "化血神针" + NOR + CYN + "疾射而回，灰溜溜回到" + query("name") + NOR + CYN + "。\n" + NOR,
          me
        );
      }
      this_object()->add("amount", -100);
      me->start_busy(2 + random(2));
    }
    return 1;
  }

  return notify_fail(NOR + "你还没有领悟这项神通。\n" + NOR);
}

void create() {
  set_name(HIR "古" HIC "曼" HIY "童" HIM "戒" NOR, ({ "guman tong", "guman", "tong" }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
    set("long", HIG "这里面是一个被巫族秘术炼制而成的小鬼,过多使用会引起邪恶念头,会有业火缠身(natou)可以驱使小鬼给你带回师门怪的头。\n" NOR);
    set("value", 50000000);
    set("no_give", 1);
    set("no_drop", 1);
    set("no_sell", 1);
    set("cz", 1000);
    set("material", "gold");
    set("armor_prop/str", 100);
    set("armor_prop/int", 100);
    set("armor_prop/con", 100);
    set("armor_prop/dex", 300);
    set("armor_prop/armor", 50000);
    set("armor_prop/armor1", 50000);
    set("armor_prop/damage", 25000);
    set("armor_prop/damage1", 25000);
    set("armor_prop/unarmed_damage", 25000);
    set("armor_prop/attack", 2000);
    set("armor_prop/defense", 2000);
    set("armor_prop/research_times", 3000);
    set("armor_prop/research_effect", 800);
    set("armor_prop/practice_times", 3000);
    set("armor_prop/practice_effect", 800);
    set("armor_prop/learn_times", 3000);
    set("armor_prop/learn_effect", 800);
    set("armor_prop/derive_times", 1500);
    set("armor_prop/derive_effect", 800);
    set("armor_prop/full_self", 20);
    set("armor_prop/reduce_poison", 40);
    //set("armor_prop/add_locked", 10);
    //set("armor_prop/avoid_locked", 20);
    set("armor_prop/fatal_blow", 20);
    set("armor_prop/add_skill", 380);
    set("armor_prop/avoid_die", 35);
    set("armor_prop/avoid_blind", 90);
    set("armor_prop/ap_power", 100);
    set("armor_prop/dp_power", 150);
    set("armor_prop/da_power", 50);
    set("armor_prop/avoid_busy", 30);
    set("armor_prop/reduce_busy", 30);
    //set("guozi_step", BONUS_DELAY);
  }
  setup();
  //call_out("jieguozi", TIME_INTERVAL);
}

int query_autoload() {
  return 1;
}


int wear() {
  object me = this_player();
  if (query("hxszsm", me) < 0) {
    tell_object(me, NOR + "特殊物品，你戴不上这枚叶子...\n" + NOR);  //不许普通玩家非法穿戴变态属性的物品
    return -1;
  }
  if (::wear()) {
    message_vision(YEL + "$N轻轻捻起一枚" + NOR + query("name") + NOR + YEL + "插在头发上。\n" + NOR, me);
    return 1;
  }
}
