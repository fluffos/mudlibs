#include <ansi.h>

inherit ITEM;

void create() {
  set_name(HIW "风" HIR "火" BLK "轮" NOR, ({ "fenghuo lun" }));
  set_weight(100);

  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", HIG "(fhl)即可立刻飞到师门怪身边。\n" NOR);
    set("value", 1);
    set("cz", 300);
    set("no_sell", 1);
    set("no_give", 1);
    set("no_drop", 1);
    set("unit", "辆");

  }

  setup();
}

void init() {
  add_action("do_changing", "fhl");
}

int do_changing(string arg) {
  object me;
  object who;
  object env;


  me = this_player();
  if (!arg)
    arg = query("quest/id", me);

  who = find_player(arg);
  if (!objectp(who)) who = find_living(arg);
  if (!objectp(who))
    return notify_fail("没有这个人啊！\n");

  if (!objectp(env = environment(who)))
    return notify_fail("这个人不知道在那里耶！\n");

  if (!query("qkill", who))
    return notify_fail("师门任务NPC专属道具。\n");


  if (env == environment(me))
    return notify_fail("你在原地乱蹦哒的啥？\n");

  //if (me->is_busy())
  //return notify_fail("等你忙完了再说。\n");

  //if (query("doing",me))
  //return notify_fail("等你计划完了再说。\n");

  message_vision(HIM "$N" HIM "丢下一辆风火轮，跳上去，"
    "喝道：“打工人，打工魂！疾！”\n"
    "只听“呼”的一下，$N" HIM "不见了！" NOR "\n",
    me);
  message("vision", HIM "忽见一辆风火轮缓缓飘下，" + me->name() + HIM
    "慢慢的踱了下来。" NOR "\n", env);
  tell_object(me, HIM "你把风火轮收到背包..." NOR "\n");
  me->move(env);
  me->kill_ob(who);

  return 1;
}
