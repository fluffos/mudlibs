//rune33.c

// Zod薩德

#include <ansi.h>

inherit TESSERA;

int is_rune() { return 1; }

void create() {
  set_name(HIW "道德五" NOR, ({ "rune000" }));
  set_weight(10);
  set("cz", 6);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "符文：造化符，可以放入凹槽物品。\n");
    set("unit", "个");
    set("enchase/SN", 1);
    set("yuanbao", 888);
    set("enchase/type", "all");
    set("enchase/consistence", 100);
    set("enchase/weapon_prop", ([
      "damage": 1000000,
      "derive_effect": 6000,
      "research_times": 6000,
      "research_effect": 6000,
      "practice_effect": 6000,
      "study_times": 6000,
      "learn_times": 6000,
      "derive_times": 6000,
      "practice_times": 6000,
    ]));
    set("enchase/armor_prop", ([
      "derive_effect": 6000,
      "practice_effect": 6000,
      "research_times": 6000,
      "research_effect": 6000,
      "study_times": 6000,
      "learn_times": 6000,
      "derive_times": 6000,
      "practice_times": 6000,
    ]));
    set("value", 20000);
  }
  setup();
}

int query_autoload() { return 1; }
