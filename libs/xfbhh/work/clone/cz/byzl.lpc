#include <ansi.h>

inherit TESSERA;

void create()
{
        set_name(HIY "神"HIC"魔"HIM"之"HIW"恋" NOR, ({ "shenmo", "lian" }) );
        set_weight(1);
        /*if (clonep())
                set_default_object(__FILE__);
        else*/
        {
                set("long", RED "这是八云之恋制作的虚假物品\n" NOR);
                set("value", 50000);

set("cz",88888);
   set("unit", "块");
                set("can_enchant", "weapon");
                set("can_be_enchased", 1);
                set("magic/type", "magic");
                set("magic/power", 500);
                set("auto_load", 1);
        }

        set("enchase",  ([ /* sizeof() == 5 */
                "weapon_prop" : ([ /* sizeof() == 3 */

						//"consistence"   : "耐久度",     // 基本属性
        "damage"        : 88888, // 基本属性
        "unarmed_damage": 88888, // 基本属性
        "armor"         : 88888,     // 基本属性 

        "max_neili"     : 88888, // weapon/armor/rings \user.c
        "max_qi"        : 88888, // weapon/armor/rings \user.c
        "max_jingli"    : 88888, // weapon/armor/rings \user.c
        "max_jing"      : 88888, // weapon/armor/rings \user.c
        "max_potential" : 88888,   // weapon/armor/rings \user.c
        "max_experience": 88888,   // weapon/armor/rings \user.c

        "attack"        : 88888,       // weapon \combatd.c
        "parry"         : 88888,       // armor  \combatd.c
        "dodge"         : 88888,       // armor  \combatd.c
        "defense"       : 88888,       // armor  \combatd.c

        "neili_recover" : 88888,   // armor/rings 战斗中每秒恢复 \char.c/damage.c
        "qi_recover"    : 88888,   // armor/rings 战斗中每秒恢复 \char.c/damage.c
        "jing_recover"  : 88888,   // armor/rings 战斗中每秒恢复 \char.c/damage.c

        // 火焰伤害，冷冻伤害，闪电伤害，毒素伤害，抗火，抗寒，抗闪电，抗毒
        "add_poison"    : 88888,     // weapon \itemd.c
        "add_magic"     : 88888,     // weapon \itemd.c
        "add_metal"     : 88888,     // weapon \itemd.c
        "add_wood"      : 88888,     // weapon \itemd.c
        "add_water"     : 88888,     // weapon \itemd.c
        "add_fire"      : 88888,     // weapon \itemd.c
        "add_earth"     : 88888,     // weapon \itemd.c
        "reduce_magic"  : 88888,       // armor  \itemd.c
        "reduce_metal"  : 88888,       // armor  \itemd.c
        "reduce_wood"   : 88888,       // armor  \itemd.c
        "reduce_water"  : 88888,       // armor  \itemd.c
        "reduce_fire"   : 88888,       // armor  \itemd.c
        "reduce_earth"  : 88888,       // armor  \itemd.c
        "reduce_poison" : 88888,       // armor  \itemd.c/condition.c
        "avoid_poison"  : 88888,   // armor/rings \itemd.c/condition.c

        "research_effect"       : 88888,   // weapon/armor/rings \cmds
        "practice_effect"       : 88888,   // weapon/armor/rings \cmds
        "study_effect"          : 88888,   // weapon/armor/rings \cmds
        "learn_effect"          : 88888,   // weapon/armor/rings \cmds
        "derive_effect"         : 88888,   // weapon/armor/rings \cmds
        "research_times"        : 88888,   // weapon/armor/rings \cmds
        "learn_times"           : 88888,   // weapon/armor/rings \cmds
        "practice_times"        : 88888,   // weapon/armor/rings \cmds
        "study_times"           : 88888,   // weapon/armor/rings \cmds
        "derive_times"          : 88888,   // weapon/armor/rings \cmds
        // 以上都是基本属性

        "magic_find"    : 88888,       // weapon/rings \equipmentd.c

        "leech_neili"   : 88888,           // weapon 命中偷取内力几率：命中敌人时按伤害值的10%比率回复内力 \damage.c/itemd.c
        "leech_qi"      : 88888,           // weapon 命中偷取生命几率：命中敌人时按伤害值的10%比率回复生命 \damage.c/itemd.c

        "ap_power"      : 88888,         // weapon/rings  \skillsd.c
        "dp_power"      : 88888,         // armor         \skillsd.c
        "da_power"      : 88888,         // weapon/rings  \skillsd.c

        //"ignores_parry":
        "avoid_parry"   : 88888,       // rune \combatd.c
        "avoid_dodge"   : 88888,       // rune \combatd.c
        "avoid_force"   : 88888,       // rune \combatd.c
        "avoid_attack"  : 88888,       // rune \combatd.c

        //"critcal"       : "暴击",               // weapon/rings \combatd.c 增加杀气：加一点杀气，暴击（双倍伤害）的概率增加1%
        "through_armor" : 88888,           // weapon       \combatd.c 穿透破甲-攻击时无视目标防具的保护力through_armor

        "double_damage" : 88888,           // weapon/rings \combatd.c

        "qi_abs_neili"  : 88888,           // rings 30%的机会受损的生命x%转换为内力 \damage.c

        "add_reward"    : 88888,       // weapon/rings \giftd.c
        /*
        "add_exp"       : "获取额外经验",       // weapon/rings \giftd.c
        "add_pot"       : "获取额外潜能",       // weapon/rings \giftd.c
        "add_mar"       : "获取额外体会",       // weapon/rings \giftd.c
        */

        "add_blind"     : 88888,                       // weapon 终极兵器 致盲-让对手失明 \damage.c/itemd.c
        "add_freeze"    : 88888,                       // weapon 终极兵器 冰冻-迟缓，减缓对方攻击，攻击pfm速度降低，无任何防御，无躲闪，无招架，就是挨打 \damage/itemd.c/combatd.c/cmds
        "add_forget"    : 88888,                       // weapon 终极防具 遗忘-使对方忘记所有技能的绝招add_oblivion
        "add_weak"      : 88888,                       // weapon 终极兵器
        "add_busy"      : 88888,                       // weapon 终极兵器


        "avoid_blind"   : 88888,                   // armor/rings 终极防具
        "avoid_freeze"  : 88888,                   // armor/rings 终极防具
        "avoid_forget"  : 88888,                   // armor/rings 终极兵器
        //add_oblivion

        "avoid_weak"    : 88888,                   // armor/rings 终极防具
        "avoid_busy"    : 88888,                   // armor/rings 终极防具
        "reduce_busy"   : 88888,                   // armor/rings 终极防具
        "avoid_fear"    : 88888,                   // armor/rings 终极防具

        "fatal_blow"    : 88888,                   // weapon 终极兵器 必杀率-拥有20%的几率损伤目标的生命x%

        "add_damage"    : 88888,                   // weapon 终极兵器
        "reduce_damage" : 88888,                   // armor 终极防具
        "full_self"     : 88888,                   // armor 终极防具 战神附体-气血内力自动恢复  远古装备
        "avoid_die"     : 88888,                   // armor/ring 凤凰涅槃，浴血重生，忽视死亡   远古装备
        "counter_damage": 88888,                   // armor 终极防具 伤害反射，受到伤害时30%几率的伤害x%反射给对方
        "consistence"   : 88888,     // 基本属性           a
        "damage"        : 88888, // 基本属性           a
        "unarmed_damage": 88888, // 基本属性           a
        "armor"         : 88888,     // 基本属性           a
          
                ]),
                "type" : "all",
                //"SN" : 9,
        ])) ;

        set("enchant", 1);
        set("set_data", 1);
        setup();
}
