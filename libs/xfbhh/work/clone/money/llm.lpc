// gold.c

#include <ansi.h>

inherit MONEY;
void create() {
  set_name(YEL "龙脉" NOR, ({ "ll", "m", "linglmai" }));
  set_weight(400);
  /*if( clonep() )
                set_default_object(__FILE__);
        else*/ {
    set("money_id", "llm");
    set("long", "一条龙脉可以吸收里面的灵力修炼，也可以用来换一些东西！\n");
    set("unit", "条");
    set("base_value", 1000000000000);
    set("base_unit", "条");
    set("base_weight", 80);
    set("only_do_effect", 1);
  }
  set_amount(1);
}

int do_effect(object me) {

  message_vision("$N掏出一条龙脉顿时周围响起阵阵龙吟，只见$N用鼻子狠狠一吸脸色通红。\n" NOR, me);
  addn("max_neili", 100000000, me);
  addn("max_jingli", 50000000, me);
  add_amount(-1);

  if (query_amount() < 1)
    destruct(this_object());

  return 1;
}
