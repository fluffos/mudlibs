#include <ansi.h>

inherit EQUIP_SOUL;

void create() {
  set_name(HIM "装备之魂" NOR, ({ "zb soul6" }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", HIM "完美的装备之魂，可用来改造所有装备。\n" NOR);
    set("unit", "个");
    set("yuanbao", 10);
    set("value", 10000);
    set("no_sell", 1);
  }
  set("type", "all");
  set("status", 6);
  set("auto_load", 1);

  setup();
}
