// This program is a part of NITAN MudLIB

#include <ansi.h>

inherit VRM_SERVER;

#define ENTER_ROOM_X  10000
#define ENTER_ROOM_Y  10000
#define ENTER_ROOM_Z  10000

void create() {
  // 迷宫房间所继承的物件的档案名称。 
  set_inherit_room(ROOM);

  //唯一房间
  set_unique_room(({
    "/maze/hunduntian/unique_room/qinglong_room",
    "/maze/hunduntian/unique_room/zhuque_room",
    "/maze/hunduntian/unique_room/xuanwu_room",
    "/maze/hunduntian/unique_room/baihu_room",
    "/maze/hunduntian/unique_room/luohou_room",
  }));

  //迷宫房间里的怪物。 
  set_maze_npcs(([
    "/maze/hunduntian/npc/king9": !random(10),

  ]));
  //不算死亡                
  //set_maze_nodeath(1);

  set_lonely_create(1);

  set_maze_boxs(10);
  //迷宫的单边长 
  set_maze_long(10);

  //入口方向(出口在对面) 
  set_entry_dir("north");

  //入口与区域的连接方向 
  set_link_entry_dir("north");

  //入口与区域的连接档案名 
  set_link_entry_room(__DIR__ "enter");

  //出口与区域的连接方向 
  set_link_exit_dir("south");

  //出口与区域的连接档案名 
  set_link_exit_room(__DIR__ "leave");

  //以下是入口坐标
  set_link_entry_room_x(ENTER_ROOM_X);
  set_link_entry_room_y(ENTER_ROOM_Y);
  set_link_entry_room_z(ENTER_ROOM_Z);

  //普通房间描述
  set_maze_room_short(RED "混沌天" NOR);

  set_maze_room_desc(@LONG
混混沌沌自在天,听说里面封印了一头强大的怪物
LONG);

  //入口房间短描述 
  set_entry_short(HIR "混沌入口" NOR);

  //入口房间描述 
  set_entry_desc(@LONG
混混沌沌自在天,听说里面封印了一头强大的怪物
LONG);

  //出口房间短描述 
  set_exit_short(HIW "混沌天出口" NOR);

  //出口房间描述 
  set_exit_desc(@LONG
混混沌沌自在天,听说里面封印了一头强大的怪物
LONG);

  // 迷宫房间是否为户外房间？ 
  set_outdoors(1);

  set_maze_refresh(600);
  set_remove_time(1800);

}
