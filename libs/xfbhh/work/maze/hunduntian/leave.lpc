inherit ROOM;

void create() {
  set("short", "混沌天出口");
  set("long", @LONG 
混混沌沌自在天,听说里面封印了一头强大的怪物
LONG
  );

  set("outdoors", "hunduntian");
  set("virtual_room", 1);
  set("no_magic", 1);
  set("exits", ([ /* sizeof() == 3 */
    "north": __DIR__ "maze/exit",
    "out": "/d/city/wumiao",
  ]));

  setup();

}
int valid_leave(object me, string dir) {
  object *inv, obj;
  int ret;
  if (dir == "out") {
    me->check_team();
    tell_object(me, "check!\n");
    inv = deep_inventory(me);
    if (inv && sizeof(inv) > 0)
      foreach (obj in inv) {
        if (obj && query("maze_item", obj))
          destruct(obj);
      }
    /*
                if( ret=query_temp("fuben_event", me) )
                {
                        SCHEDULE_D->delete_event(ret);
                        FUBEN_D->clear_fuben("necropolis",query("id", me));
                }
*/

  }
  return 1;
}
