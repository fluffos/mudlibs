// Efuns of the driver this mudlib was written for that this driver does not have (KB 06 7.323).  Each is built only where the driver lacks it.

#if !efun_defined(actions_defined)
/**
 * @ignore yes
 * The original driver listed the actions a living had added; the creator commands `which`, `comment` and `loc_alcmd` ask for it.  The stub that came with the
 * add_action emulation (secure/simul_efun/add_action.lpc) answered an empty list but is only inherited where the driver has no add_action: this driver has
 * add_action and no actions_defined, so those three commands never compiled.  Same answer here, and `varargs` because loc_alcmd calls it with one argument.
 */
varargs mixed actions_defined(mixed ob, mixed verb, mixed flags) { return ({}); }
#endif

#if !efun_defined(generate_source)
/**
 * @ignore yes
 * The LPC-to-C compiler of the original driver; the creator command `compile` calls it inside a catch() and prints the message.
 */
varargs void generate_source(mixed files) { error("LPC to C compilation is not available on this driver.\n"); }
#endif

#if !efun_defined(lpc_info)
/** @ignore yes */
string lpc_info() { return "lpc_info() is not available on this driver.\n"; }
#endif

#if !efun_defined(function_profile)
/**
 * @ignore yes
 * Per-function profiling is a build option of the driver; this build lacks it and the creator command `prof` only totals what it gets.
 */
mixed function_profile(object ob) { return ({}); }
#endif
