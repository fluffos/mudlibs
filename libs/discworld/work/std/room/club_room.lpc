/* -*- LPC -*- */
/**
 * Club-owned room: basic_room plus club ownership (archive never shipped
 * /std/room/club_room; reconstructed from we_care users + owned_room API).
 * set_leave_exit mirrors set_front_door for throwout/allow.
 */
inherit "/std/room/basic_room";
inherit "/std/room/inherit/club_owned_room";

void create() {
   do_setup++;
   basic_room::create();
   club_owned_room::create();
   do_setup--;

   if ( !do_setup ) {
      this_object()->setup();
      this_object()->reset();
   }
} /* create() */

void init() {
   basic_room::init();
   club_owned_room::init();
} /* init() */

void set_leave_exit(string exit) {
   set_front_door(exit);
} /* set_leave_exit() */
