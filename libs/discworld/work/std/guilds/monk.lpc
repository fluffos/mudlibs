/**
 * Monks' Guild guild object. Restored for race.lpc guild map (§6.15).
 */
#include <config.h>

inherit "/std/guilds/standard";

void setup() {
  set_name("monks");
  set_short("Monks' Guild");
  set_long("The Monks Guild trains unarmed combat and discipline.\n");
  set_gp_skill("fighting.points");
  set_start_pos(CONFIG_START_LOCATION);
  set_skills(({
      "fighting.points",
      "fighting.combat.melee.unarmed",
      "fighting.combat.parry.melee",
      "fighting.combat.dodging.melee",
      "fighting.combat.special.unarmed",
      "other.health",
      "other.perception"

  }));
} /* setup() */

varargs int query_skill_cost(string skill) {
  string *bits;
  if(member_array(skill, skills) != -1)
    return 3;
  bits = explode(skill, ".");
  switch(bits[0]) {
    case "fighting" :
      return 5;
    case "fighting" :
      return 15;
    case "covert" :
      return 20;
    case "magic" :
      return 50;
    case "faith" :
      return 20;
    default :
      return 10;
  }
} /* query_skill_cost() */

varargs int query_skill_max_level( string skill ) {
  string *bits;
  if ( member_array( skill, skills ) != -1 )
    return 400;
  bits = explode( skill, "." );
  switch( bits[ 0 ] ) {
    case "fighting" :
      return 50;
    default:
      return 40;
  }
} /* query_skill_max_level() */
