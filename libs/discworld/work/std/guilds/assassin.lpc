/**
 * Assassins' Guild guild object. Restored for race.lpc guild map (§6.15).
 */
#include <config.h>

inherit "/std/guilds/standard";

void setup() {
  set_name("assassins");
  set_short("Assassins' Guild");
  set_long("The Assassins Guild specialises in stealth and killing.\n");
  set_gp_skill("covert.points");
  set_start_pos(CONFIG_START_LOCATION);
  set_skills(({
      "covert.stealth.inside",
      "covert.stealth.outside",
      "covert.hiding.person",
      "covert.manipulation.stealing",
      "fighting.combat.melee.pierce",
      "fighting.combat.special.weapon",
      "covert.points",
      "fighting.points"

  }));
} /* setup() */

varargs int query_skill_cost(string skill) {
  string *bits;
  if(member_array(skill, skills) != -1)
    return 3;
  bits = explode(skill, ".");
  switch(bits[0]) {
    case "covert" :
      return 5;
    case "fighting" :
      return 15;
    case "covert" :
      return 20;
    case "magic" :
      return 50;
    case "faith" :
      return 20;
    default :
      return 10;
  }
} /* query_skill_cost() */

varargs int query_skill_max_level( string skill ) {
  string *bits;
  if ( member_array( skill, skills ) != -1 )
    return 400;
  bits = explode( skill, "." );
  switch( bits[ 0 ] ) {
    case "covert" :
      return 50;
    default:
      return 40;
  }
} /* query_skill_max_level() */
