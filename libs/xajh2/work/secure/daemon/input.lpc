// input object

object link_to = 0;

int auth = 0;

string id = 0;

void create() {
  seteuid(getuid());
}

string process_input(buffer data) {
  string inp = read_buffer(data);
  if (!inp)
    return "";
  if (inp[<1] == '\n')
    inp = inp[0..<2];
  if (!id) {
    id = inp;
    return "";
  }
  if (!auth) {
    auth = 1;
    receive("Success\n");
    link_to = find_player(id);
    if (link_to)
      link_to->set_input_ob(this_object());
    return "";
  }
  if (!link_to) {
    link_to = find_player(id);
    if (link_to)
      link_to->set_input_ob(this_object());
  }
  if (link_to) {
    log_file("input", "1 :" + inp + "\n");
    inp = link_to->process_input(inp);
    log_file("input", "2 :" + inp + "\n");
    if (inp && inp != "")
      link_to->force_me(inp);
  }
  receive(">\n");
  return "";
}

void net_dead() {
  if (this_object())
    destruct(this_object());
}

void player_net_dead() {
  receive("<\n");
  destruct(this_object());
}
