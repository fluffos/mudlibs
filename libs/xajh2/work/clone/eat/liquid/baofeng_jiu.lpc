// baofeng_jiu.c 宝丰酒 writen by tea 12.10.98

#include <ansi.h>

inherit ITEM;
inherit F_LIQUID;



void create() {
  set_name(HIM "宝丰酒" NOR, ({ "baofeng jiu", "jiu" }));
  set_weight(300);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一壶宝丰酒，无色透明，绵软纯净，甘润爽口。\n");
    set("unit", "壶");
    set("value", 3000);
    set("max_liquid", 10);
  }
  set("liquid", ([
    "type": "alcohol",
    "name": HIM "宝丰酒" NOR,
    "remaining": 10,
    "drunk_apply": 5,
    "drink_apply": 30,
  ]));
}
