// shuijing.c

inherit ITEM;
inherit F_FOOD;



void create() {
  set_name("水晶包子", ({ "shuijing baozi", "baozi" }));
  set_weight(50);  //一两
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
    set("value", 420);
    set("food_remaining", 2);
    set("food_supply", 30);
    set("gifts", ([
      "per": 2,
      "int": 1,
    ]));
  }
  setup();
}
