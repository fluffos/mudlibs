#include <ansi.h>
inherit ITEM;
inherit F_FOOD;



void create() {
  set_name(RED "玉珍烤鸭" NOR, ({ "kao ya", "ya" }));
  set_weight(1000);
  set("long", @LONG
这是京城名菜玉珍烤鸭，肥而不腻，滑嫩香脆，香气四溢，味道妙极。
LONG
  );
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "盘");
    set("value", 8500);
    set("food_remaining", 8);
    set("food_supply", 30);
  }
  setup();
}
