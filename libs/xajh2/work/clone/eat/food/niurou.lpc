#include <ansi.h>
inherit ITEM;
inherit F_FOOD;



void create() {
  set_name(YEL "五香酱牛肉" NOR, ({ "niu rou", "rou" }));
  set_weight(1000);
  set("long", @LONG
这是用五种香料酱制的牛肉，香气诱人，看的流口水了。
LONG
  );
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "盘");
    set("value", 5000);
    set("food_remaining", 8);
    set("food_supply", 50);
  }
  setup();
}
