#include <armor.h>
#include <ansi.h>
inherit CLOTH;


void create() {
  set_name(HIK "西服" NOR, ({ "xifu", "cloth" }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long",
      "一件专为新郎定做的" + HIK "西服" NOR + "，既笔挺又舒适，新郎倌穿上后尽显飒爽英姿！\n");
    set("unit", "件");
    set("value", 50000);
    set("material", "cloth");
    set("cant_sell", "这是结婚用的西服，你怎么能随便拿来卖掉呢？\n");
    set("armor_prop/armor", 2);
    set("armor_prop/personality", 10);
    set("wear_msg", "$N穿上一件$n，想着自己不久就可以拥娇妻入怀，不禁心中一片甜蜜。\n");
    set("unequip_msg", "$N将$n轻轻脱下，仔细地掸了掸灰尘，叠好收藏了起来。\n");
    set("male_only", 1);
  }
  setup();
}
