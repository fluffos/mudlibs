#include <ansi.h>
inherit ITEM;
inherit F_LIQUID;


void create() {
  set_name(RED "冰" NOR, ({ "cocacola" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一听可乐。\n");
    set("unit", "听");
    set("value", 0);
    set("max_liquid", 4);
  }
  // because a container can contain different liquid
  // we set it to contain wine at the beginning
  set("liquid", ([
    "type": "water",
    "name": "可口可乐",
    "remaining": 4,
    "drink_apply": 10,
  ]));
}
