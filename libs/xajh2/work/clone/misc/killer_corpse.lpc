// killer_corpse.c

inherit ITEM;

int decayed;



void create() {
  set_name("无名尸体", ({ "corpse" }));
  set("long", "这是一具无名尸体。\n");
  set("unit", "具");
  decayed = 0;
  if (clonep(this_object())) call_out("decay", 5, 1);
}

int is_corpse() { return decayed < 2; }
int is_character() { return decayed < 1; }
int is_container() { return 1; }

string short() { return name() + "(" + capitalize(query("id")) + ")"; }

void decay(int phase) {
  decayed = phase;
  switch (phase) {
    case 1:
      message_vision("突然，" + query("name") + "开始渗出一些黄水，越来越多....\n"
        "所到之处，尸体亦即化为黄水... \n", this_object());
      call_out("decay", 5, phase + 1);
      break;
    case 2:
      message_vision("瞬息之间，" + query("name") + "已经化成了一滩黄水....\n", this_object());
      if (environment()) {
        object *inv;
        int i;

        inv = all_inventory(this_object());
        for (i = 0; i < sizeof(inv); i++) inv[i]->move(environment());
      }
      destruct(this_object());
      break;
  }
}
