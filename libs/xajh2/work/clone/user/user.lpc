private nosave int last_age_set;

// Last command execute time
private nosave int last_time;

// Last interval execute commands count
private nosave int last_count;

// Death warning
private int DeadWarning = 0;
private nosave object input_ob;  // www mud support

//private nosave int * Screen;


void create() {
  seteuid("Mudlib");
  character::create();
  //    task::create();
  //    Screen = ({ 80,24 });
  interface::create();
  USER_D->add_user(this_object());
  set_name("使用者物件", ({ "user object", "user", "object" }));
}

void reset() {
  if ((int)query("thief") > 0)
    add("thief", -1);
}

// This is used by F_SAVE to determine the filename to save our data.
string query_save_file() {
  string id;

  id = geteuid();
  if (!id)
    id = getuid();
  if (!stringp(id))
    return 0;
  return sprintf(DATA_DIR "user/%c/%s", id[0], id);
}

int save() {
  int res;
  object env, me = this_object();

  save_autoload();
  res = ::save();
  clean_up_autoload();        // To save memory
  if (objectp(env = environment(me)) &&
    !env->query("not_startroom") && env->IsRoom()) {
    set("startroom", base_name(environment(me)));
  }
  return res;
}

// This function updates player's age, called by heart_beat()
void update_age() {
  mapping gifts;
  int i, temp, sign, sign_mark, temp1;
  int mud_age;
  int age, max_age;
  string *list;
  //    object env;
  //    int mud_age_modify;
  int willdie;

  sign_mark = 0;
  // Update the time we spend on mudding, using method from TMI-2 mudlib.
  // fuck, really rubbish.
  if (!last_age_set)
    last_age_set = time();
  add("mud_age", time() - last_age_set);
  //    if(objectp(env=environment(this_object())) && intp(env->query("mud_age_modify")) && (mud_age_modify=env->query("mud_age_modify")))
  //    if(query("age")>20)
  //       add("locker/mudagemodify",mud_age_modify*(time()-last_age_set));
  last_age_set = time();
  temp = query("age");
  willdie = query("willdie");
  {
    //        if((int) query("locker/mudagemodify"))
    //	mud_age = (int) query("mud_age")+(int) query("locker/mudagemodify"); //added by zhaoke 调整mud_age,我推荐mud_age就是用来记录玩家玩了多长时间得，不直接修改mud_age,具体年龄再调整
    //	else
    mud_age = (int)query("mud_age");
    age = (int)query("age_modify");
    if (mud_age < 259200) {
      age += 14 + mud_age / BASE_TIME_1;
    } else if (mud_age < 1123200) {
      age += 20 + (mud_age - 259200) / BASE_TIME_2;
    } else if (mud_age < 2419200) {
      age += 30 + (mud_age - 1123200) / BASE_TIME_3;
    } else {
      temp1 = (mud_age - 2419200) / BASE_TIME_4;
      age = 40 + temp1 * 120 / (temp1 + 120);
    }
  }
  if (age != temp)
    set("age", age);
  if (age > temp && temp)     // birthday :)
  {
    message("vision", YEL "恭喜！你又长大了一岁了！" NOR "\n",
      this_object());
    if (age == 18)
      message("vision",
        "从今天起，你不再是新手，不再受到保护了，自己保重！\n",
        this_object());
    max_age = query("max_age");
    if (max_age) {
      if (age > max_age && !wizardp(this_object())) {
        add("willdie", 1);
        if (query("willdie") == 1)
          write(HIY "你心头有些不详的预感，似乎大限将至。\n" NOR);
        else if (query("willdie") >= 2) {
          write(HIY "你阳寿将近，命不久矣。\n" NOR);
          //            		SUICIDE_CMD->laosi(this_object());
          //                        return;
        }
      }
      /*                // 应该死了...嘿嘿
                // user.c 权限不够不能destruct player...
                // 只好借助一个指令来完成了。
                if (DeadWarning > 5)
                {
                // wizard不应该死，要不被别人把他登了就惨了。 by lnwm 980922
                    if (wizardp(this_object()))
                    {
                        message("vision",
                                "你是巫师，所以就不老死，不过还是把你的岁数改回去好。\n",
                                this_object());
                        return;
                    }
                    SUICIDE_CMD->laosi(this_object());
                    return;
                }
            }
            if ((age + 10) > max_age + query("max_force") / 1000)
            {
                // 出些提示信息， 你该死了..
                write("你心头有些不详的预感，似乎大限将至。\n");
                DeadWarning++;
            }
*/
    }
    save();
    gifts = query("gifts_jilei");
    if (!gifts)
      return;
    list = keys(gifts);
    for (i = 0; i < sizeof(list); i++) {
      temp = gifts[list[i]];
      sign = (temp > 0) ? 1 : -1;
      temp *= sign;
      if (temp >= 2000) {
        set("gifts_jilei/" + list[i], 0);
        if (query("age") > 20) {
          if (sign > 0 && query("gifts_modify/" + list[i]) > 9)
            sign = 0;
          if (sign < 0 && query("gifts_modify/" + list[i]) < -8)
            sign = 0;
          add("gifts_modify/" + list[i], sign);
        } else {
          if (sign > 0 && query(list[i]) > 34)
            sign = 0;
          if (sign < 0 && query(list[i]) < 11)
            sign = 0;
          add(list[i], sign);
        }
        sign_mark += sign;
      }
    }
    if (sign_mark)
      write("你的体内似乎发生一些奇妙的变化。\n");
  }
}
void heart_beat() {
  character::heart_beat();
  if (!random(20))            // 不需要一直update_age
    update_age();
  autosave();
  if (query_idle(this_object()) > IDLE_TIMEOUT)
    user_dump(DUMP_IDLE);
}

void setup() {
  // We want set age first before new player got initialized with
  // random age.
  update_age();
  ::setup();
  restore_autoload();
}

void eventLogin() {}
void eventQuit() {}

void get_verb_error(string cmd) {
  string err;
  string *p = explode(cmd, " ");
  err = "/system/daemon/verbd"->get_error_msg(p[0]);
  if (err)
    write(err + "\n");
  else
    write("You can't do that!!!! -- by nerd\n");
}

// process-input
mixed process_input(string cmd) {
  object this;
  mixed s;
  int _debug;
  string ret;

  if (cmd[0] == '@') {
    _debug = 1;
    cmd = cmd[1..];
  }
  ret = editor::process_input(cmd);

  if (ret == "")
    return "";
  this = this_object();

  if (!wizardp(this))         //sure be a user.
  {
    // nerd: 2000. 11. 9: removed start_busy if cmd count too many.
    if (time() - last_time == 0) {
      last_count++;
      if (last_count > MIN_COMMAND_LIMIT)
        return "";
    } else {
      last_time = time();
      last_count = 0;
    }
  }
  ret = alias::process_input(cmd);

  if (wizardp(this)) {
    if (_debug) {
      s = parse_sentence(ret, 2);
    } else
      s = parse_sentence(ret);
    if (stringp(s)) {
      if (strsrch(s, "You can't") == 0)
        get_verb_error(ret);
      else
        write(s + "\n");
      return 1;
    }
    if (s < 0) {
      get_verb_error(ret);
      return 1;
    } else if (s > 0)
      return 1;
    else
      return ret;
  } else  // !wizarp this
    return ret;
}

int visible(object ob) {
  int lvl, invis;

  if (!ob)
    return 0;
  lvl = wiz_level(this_object());
  if (lvl >= wiz_level(ob))
    return 1;
  invis = ob->query("env/invisibility");
  if (intp(invis) && (invis > lvl))
    return 0;
  if (ob->is_ghost() && !wizardp(ob)) {
    if (is_ghost())
      return 1;
    return 0;
  }
  return ::visible(ob);        // ::visiable must return 1:)
}

varargs int move(mixed dest, int silent) {
  if (::move(dest, silent)) {
    if (living(this_object()) && interactive(this_object()) && !silent) {
      eventDescribeEnv(environment(), (int)query("env/brief"));
      environment()->welcome_visitor(this_object());
    }
    return 1;
  }
  return 0;
}

// -- www mud support
void remove(string euid) {
  if (input_ob) {
    input_ob->player_net_dead();
  }
  USER_D->remove_user(this_object());
  ::remove(euid);
}

void net_dead() {
  if (input_ob) {
    input_ob->player_net_dead();
  }
  ::net_dead();
}

void start_more(string content) {
  //   if (is_html_user())
  //       receive(translate(content));
  //  else
  ::start_more(content);
}

void set_input_ob(object ob) {
  input_ob = ob;
}

object get_input_ob() {
  return input_ob;
}
