#include <ansi.h>
#include <weapon.h>
inherit PLATE;


void create() {
  //实际玩家买到应该是个茶壶。一开始是满的。
  set_name(WHT "体温计" NOR, ({ "tiwen ji", "ji" }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", @LONG
一支普普通通的体温计，可以用它来量体温。
LONG
    );
    set("cant_sell", "伙计疑惑的看着你：“什么破东西。”\n");
    set("unit", "支");
    set("value", 50000);

  }
  init_plate(40);
  set("wield_msg", HIC "$N从怀里摸出一根$n。\n" NOR);
  set("unwield_msg", HIC "$N将$n收了起来。\n" NOR);
  setup();

}
