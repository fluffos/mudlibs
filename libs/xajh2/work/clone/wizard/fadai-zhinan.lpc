//fadai-zhinan.c
inherit ITEM;



void create() {
  set_name("「发呆指南」", ({ "fadai zhinan", "book", "zhinan" }));
  set_weight(300);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "本");
    set("long", "这是一本介绍如何发呆的书，不知为何人所作。\n");
    set("value", 10000);
    set("material", "paper");
    set("skill", ([
      "name": "fadai-shengong",
      "xiuwei_required": 0,
      "jibie_required": 1,
      "literate_required": 0,  //嘿嘿，发呆的书不要literate就能读
      "gin_cost": 10,
      "max_jibie": 500,
      "bonus_jilei": 0,
      "bonus_combat_exp": 10,
      "max_combat_exp": 10000,
    ]));
  }
}
