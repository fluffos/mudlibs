#include <ansi.h>
inherit ITEM;
inherit F_LIQUID;



void create() {
  //实际玩家买到应该是个茶壶。一开始是满的。
  set_name(HIY "鲜橙多" NOR, ({ "xiancheng duo", "yinliao" }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", @LONG
好大的一瓶啊鲜橙多，看的人垂涎欲滴。
LONG
    );
    set("unit", "瓶");
    set("value", 40);

  }
  set("liquid", ([
    "type": "water",
    "name": "鲜橙多",
    "remaining": 40,
    "drunk_apply": 10,
  ]));
  set("max_liquid", 40);
  setup();

}
