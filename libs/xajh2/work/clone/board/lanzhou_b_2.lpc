#include <ansi.h>
inherit BULLETIN_BOARD;


void create() {
  set_name(HIW "白粉墙" NOR, ({ "wall", "board" }));
  set("location", "/d/city/lanzhou/kezhan");
  set("board_id", "lanzhou_b_2");
  set("long", @LONG
    这是客栈的一堵白粉墙，上面有不少客人留下的墨迹，其中有些很不错的文
章，你可以读读(read)看。
LONG
  );
  setup();
  set("capacity", 100);
}
