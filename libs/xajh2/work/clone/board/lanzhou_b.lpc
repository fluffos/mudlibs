#include <ansi.h>
inherit BULLETIN_BOARD;


void create() {
  set_name(HIW "石板" NOR, ({ "board" }));
  set("location", "/d/city/lanzhou/zhoufu_men");
  set("board_id", "lanzhou_b");
  set("long", HIW @LONG

        本府处处为黎民着想，特设此板以为百姓开言：凡有告状诉
      冤者如本府一时不能受理，即可将其所诉之状张贴于此。待本
      府一并受理。皇恩浩荡，永锡太平。
                                        熙河路    兰州府
                                      大宋景德三年六月壬午
LONG NOR);
  setup();
  set("capacity", 100);
  replace_program(BULLETIN_BOARD);
}
