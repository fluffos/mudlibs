#include <armor.h>
inherit CLOTH;


void create() {
  set_name("灰布僧衣", ({ "huibu sengyi", "sengyi", "cloth" }));
  set("long", "一件洗得发白的僧袍，只能隐隐看出原先的底色，\n"
    "显然已追随它的主人多年了。");
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("material", "cloth");
    set("value", 400);
    set("armor_prop/armor", 1);
  }
  setup();
}
