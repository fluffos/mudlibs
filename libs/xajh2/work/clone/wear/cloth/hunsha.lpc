#include <ansi.h>
#include <armor.h>
inherit CLOTH;


void create() {
  set_name(HBWHT "白色婚纱" NOR, ({ "hunsha", "sha" }));
  set_weight(800);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一件雪白的婚纱，从头顶直垂到身后，益发显得新娘美丽端庄.");
    set("unit", "件");
    set("value", 600);
    set("armor_prop/armor", 1);
    set("material", "cloth");
    set("armor_prop/personality", 10);
    set("female_only", 1);
  }
  setup();
}
