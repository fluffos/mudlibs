#include <armor.h>

inherit BOOTS;



void create() {
  set_name("白缎鞋", ({ "baiduan xie", "xie", "shoes" }));
  set_weight(500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一双纤细小巧的白缎面绣花鞋");
    set("unit", "双");
    set("value", 1500);
    set("material", "silk");
    set("armor_prop/personality", 2);
    set("femaly_only", 1);
  }
  setup();
}
