#include <armor.h>

inherit BOOTS;



void create() {
  set_name("皮靴", ({ "pu xue", "xie", "shoes" }));
  set_weight(2000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一双笨重的皮靴。\n");
    set("unit", "双");
    set("value", 1400);
    set("material", "");
    set("armor_prop/armor", 3);
  }
  setup();
}
