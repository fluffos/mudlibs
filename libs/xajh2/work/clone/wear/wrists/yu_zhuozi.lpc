#include <ansi.h>
#include <armor.h>

inherit WRISTS;



void create() {
  set_name(GRN "玉镯子" NOR, ({ "zhuo zi", "zhuozi" }));
  set_weight(50);                       //一市两；
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "这是一件制作精美的翠玉镯子。\n");
    set("unit", "件");
    set("value", 5300);               //价格：(1*100)防御力价格
    //+(100*50)珠翠价格
    //+(2*50)附加价格=总价格；
    set("material", "jade");          //质地：珠翠（单价
    //１００，０００文／千克）
    set("armor_prop/armor", 1);
    set("armor_prop/personality", 2);
    set("female_only", 1);
  }

  setup();
}
