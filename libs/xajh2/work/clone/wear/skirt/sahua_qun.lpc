//hong lingqun.c
#include <armor.h>
#include <ansi.h>
inherit SKIRT;


void create() {
  set_name(GRN "绿绸撒花裙" NOR, ({ "sahua qun", "qunzi", "skirt" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一件漂亮的撒花绸裙。\n");
    set("unit", "条");
    set("value", 600);
    set("material", "cloth");
    set("armor_prop/armor", 1);
    set("armor_prop/dodge", 1);
    set("female_only", 1);
  }
  setup();
}
