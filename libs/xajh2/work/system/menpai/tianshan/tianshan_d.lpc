// 判断给定的武功是否是天山的武功
int is_benmen_wugong(string skill) {
  switch (skill) {
    case "jingyan-quan":
    case "jueqing-zhang":
    case "chuanyun-tui":
    case "paiyun-zhang":
    case "chixin-jian":
    case "wenrou-jian":
    case "wuzhan-mei":
    case "tianyu-qijian":
    case "zhuifeng-wuying":
    case "yan-shuangfei":
    case "yufeng-xiang":
    case "yueying-wu":
    case "mingyu-gong":
      return 1;

    default:
      return 0;
  }
}
