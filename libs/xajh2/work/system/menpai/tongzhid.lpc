#include <ansi.h>
#include <localtime.h>

inherit F_DBASE;

void KnockBell();
void eventKnock();
int filter_listener(object);

void before_lecture();
void eventLecture(object);
void afterlecture();
public int tongzhied = 0;


void create() {
  seteuid(ROOT_UID);
  set("name", "通告使者");
  set("id", "xo");
  eventKnock();
}

void eventKnock() {
  int time;
  time = NATURE_D->QueryShiChen();
  if (time == 8 && !tongzhied && random(2) == 1) {
    tongzhied = 1;
    KnockBell();
  } else {
    tongzhied = 0;
  }
  call_out("eventKnock", 60);
}

//执行通知的过程，所有在XO里面的人能听到
void KnockBell() {
  object *listener;
  //   int i;
  listener = filter_array(users(), "filter_listener", this_object());
  message("tongzhi", HIR "\n【通告】" NOR + YEL "     Xomud论坛:	http://www.27net.net\n" NOR, listener);
  message("tongzhi", WHT "             欢迎访问主站 xo.27net.ent 4000       \n" NOR, listener);
  message("tongzhi", HIC "\n           请抬头环顾四周，做个深呼吸，放松一下。。。。。。\n\n" NOR, listener);

}


//ppl在整个XO这个区域里面，return 1，else return 0;
int filter_listener(object ppl) {
  string filename, *dir;
  if (!environment(ppl)) return 0;
  filename = file_name(environment(ppl));
  dir = explode(filename, "/");
  if (dir[2] != "pig")
    return 1;
  else
    return 0;
}
