#include <ansi.h>
#include <localtime.h>

inherit F_DBASE;

void KnockBell();
void eventKnock();
int filter_listener(object);

void before_lecture();
void eventLecture(object);
void afterlecture();
public int blnKnocked = 0;    //记录今天是否敲过钟的布尔型变量
//呵呵,VB用多了,变量的前缀用了bln:PPP
//Hydra modified at 99/3/31

void create() {
  seteuid(ROOT_UID);
  set("name", "晚钟使者");
  set("id", "knocker");
  eventKnock();
}

void eventKnock() {
  int time;
  time = NATURE_D->QueryShiChen();
  if (time == 10 && !blnKnocked) {
    blnKnocked = 1;
    KnockBell();
  } else {
    blnKnocked = 0;
  }
  call_out("eventKnock", 60);
}


//执行敲钟的过程，所有在杭州里面的人能听到
void KnockBell() {
  object *listener;
  int i;
  listener = filter_array(users(), "filter_listener", this_object());
  message("qiaozhong", WHT "咚。。。咚。。。咚。。。咚。。。\n\n" NOR, listener);
  message("qiaozhong", YEL "你听到远处净慈寺钟楼的钟声响了起来。。。\n" NOR, listener);
  message("qiaozhong", HIY "钟声在苍烟暮霭中回荡，抑扬动听。。。\n" NOR, listener);

  for (i = 0; i < sizeof(listener); i++) {
    tell_object(listener[i], CYN "这正是西湖十景之一的“南屏晚钟”。\n\n" NOR);
  }
}


//ppl在杭州这个区域里面，return 1，else return 0;
int filter_listener(object ppl) {
  string filename, *dir;
  if (!environment(ppl)) return 0;
  filename = file_name(environment(ppl));
  dir = explode(filename, "/");
  if (dir[2] == "hangzhou")
    return 1;
  else
    return 0;
}
