void create() {
  seteuid(getuid());
  set("channel_id", "连线精灵");
  //read_config_file();
  //read_multi_config_file();
  //read_revise_file();
  startup_time = time();
}

void StartLogon(object ob) {
  int hour, users;

  cat(WELCOME);  //"/system/etc/title");
  write("\n");
  hour = (time() % 86400) / 3600 + 8;  // 东八区
  if (hour > 5 && hour <= 11)
    write(YEL "早上好！欢迎在学习工作之余光临笑傲江湖！\n" NOR);
  else if (hour > 11 && hour <= 13)
    write(YEL "中午好！欢迎在学习工作之余光临笑傲江湖！\n" NOR);
  else if (hour > 13 && hour <= 18)
    write(YEL "下午好！欢迎在学习工作之余光临笑傲江湖！\n" NOR);
  else if (hour > 18 && hour <= 24)
    write(YEL "晚上好！欢迎在学习工作之余光临笑傲江湖！\n" NOR);
  else
    write(YEL "你好！感谢你在深夜光临笑傲江湖，不过请注意休息。\n" NOR);

#ifdef LOGIN_DELAY
  if (time() - startup_time < LOGIN_DELAY_TIME) {
    write(YEL "对不起，为了系统稳定，请在系统起动 %d 秒后再登录。\n" NOR,
      LOGIN_DELAY_TIME);
    destruct(ob);
    return;
  }
#endif

  if (BAN_D->IsBannedSite(query_ip_number(ob))) {
    write(YEL "对不起，你的 IP 在ＸＯ不受欢迎。如果有任何疑问，\n"
      "请用电子邮件联系%s\n", ADMIN_EMAIL);
    destruct(ob);
    return;
  }

  if (wiz_lock_level > 0)
    write(RED "           >>> 本ＭＵＤ暂时关闭，只有巫师等级" +
      chinese_number(wiz_lock_level) + "的用户可以连线。 <<<\n" NOR);

  write("笑傲江湖从九八年十一月二十九日以来已经有" GRN "%s" NOR "人次登录。\n",
    STATIC_D->GetLoginStatus());
  if (uptime() < 10)
    write(YEL + mud_name() + "刚启动");
  else
    write(YEL + mud_name() + "已经运行了" + UPTIME_CMD->main());

  if (users = sizeof(filter(users(), (: environment($1) :))))
    write("，目前共有%s位玩家在这个世界中。" NOR "\n",
      chinese_number(users));
  else
    write("，目前没有玩家连线。\n");

  write(CYN "您好，请输入您的英文名字。(如果要新建一个人物，请输入new)\n" NOR);
  write(CYN "您的英文名字：" NOR);
  input_to((: get_id :), ob);
}

protected void get_id(string arg, object ob) {
  if (arg == "") {
    write("那么好吧，欢迎下次再来。\n");
    destruct(ob);
    return;
  }
  arg = lower_case(arg);

#ifdef MAX_USERS
  if (!wiz_level(arg) && sizeof(users()) >= MAX_USERS) {
    object ppl = find_body(arg);

    // Only allow reconnect an interactive player when MAX_USERS exceeded.
    if (!ppl || !interactive(ppl) || !wizardp(ob)) {
      write(YEL "对不起，" + MUD_NAME + "的使用者已经太多了，请待会再来。\n" NOR);
      destruct(ob);
      return;
    }
  }
#endif

  if (wiz_level(arg) < wiz_lock_level)  //&& !ALLOW_D->is_allowed(arg) )
  {
    write(RED "对不起，" + MUD_NAME + "目前限制神仙等级 " +
      wiz_lock_level + " 以上的人才能连线。\n" NOR);
    destruct(ob);
    return;
  }
  switch (arg) {
    case "quit":
      write("记得下次再来！\n");
      destruct(ob);
      return;
    case "new":
      //            if ( BAN_D->IsTimeAllowed(ob) )//5 min 才准有一个。
      //            {
      if (!BAN_D->CheckDupIp(arg, ob)) {
        write("欢迎光临" + mud_name() + "\n");
        write("请选择你的英文名字：");
        input_to((: GetNewId :), ob);
      }
      //            }
      return;
    case "guest":    // we should check dup ip ah?
      ob->set("id", "guest");
      if (!BAN_D->CheckDupIp(arg, ob))
        confirm_id("Yes", ob);
      return;
    default:
      if ((string)ob->set("id", arg) != arg) {
        write(RED "Failed setting user name.\n" NOR);
        destruct(ob);
        return;
      }
      if (file_size(ob->query_save_file() + __SAVE_EXTENSION__) <= 0)
        write("对不起，这个id还没有登录过，请用new来起用这个id.\n");
      else {
        BeginLogin(arg, ob);
        return;
      }
  }
  write(CYN "您的英文名字；" NOR);
  input_to((: get_id :), ob);
}

void BeginLogin(string arg, object ob) {
  if (BAN_D->CheckDupIp(arg, ob))
    return;

  if (ob->restore()) {
    write(BLU "请输入您的密码：" NOR);
    input_to("get_passwd", 1, ob, 1);
  } else {
    write(YEL "您的角色存盘数据出了问题，请利用 guest 通知神仙处理。\n" NOR);
    write(YEL "或者emailto: " + ADMIN_EMAIL + "陈述。\n" NOR);
    destruct(ob);
  }
}

protected nomask void get_passwd(string pass, object ob, int repeat) {
  string my_pass, msg;
  object user;

  write("\n");
  my_pass = ob->query("password");
  if (crypt(pass, my_pass) != my_pass) {
    if (repeat >= 3) {
      write("还是不对。。。\n如果真的忘了或者被改，请emailto: "
        +ADMIN_EMAIL "\n\n");
      message("debug", "[ " GRN "Login" NOR " ] " + ob->query("id") +
        " 在 " + query_ip_name(ob) + "登录时输入密码错误达三次。\n",
        filter(users(), (: wizardp :)));
      if (wiz_level(ob->query("id"))) {
        msg = sprintf("%s error login at %s from %s\n",
          ob->query("id"), ctime(time()), query_ip_name(ob));
        log_file(WIZ_LOGIN_ERR_LOG, msg);
      }
      destruct(ob);
      return;
    }
    write("嗯，我再给你一次机会。\n请输入密码：");
    input_to((: get_passwd :), 1, ob, repeat + 1);
    return;
  }

  if (BAN_D->CheckDupIp(ob->query("id"), ob))
    return;
  user = find_body(ob->query("id"));
  if (user) {
    if (user->query_temp("netdead")) {
      reconnect(ob, user);
      return;
    }
    write(YEL "您要将另一个连线中的相同人物赶出去，取而代之吗？(y/n)" NOR);
    input_to("confirm_relogin", ob, user);
    return;
  }

  user = make_body(ob);
  if (objectp(user)) {
    if (user->restore()) {
      log_login(ob, user, "%s(%s) loggined from %s (%s)\n");
      enter_world(ob, user);
      //revise_illegal_data( user );
      return;
    } else {
      write(YEL "您的角色存盘数据出了问题，请利用 guest 通知神仙处理。\n" NOR);
      write(YEL "或者emailto: " + ADMIN_EMAIL + "陈述。\n" NOR);
      destruct(user);
    }
  }
  write(HIW "请您重新创造这个人物。\n" NOR);
  confirm_id("y", ob);
}

protected void confirm_relogin(string yn, object ob, object user) {
  object old_link;

  if (yn == "") {
    write(YEL "您要将另一个连线中的相同人物赶出去，取而代之吗？(y/n)" NOR);
    input_to("confirm_relogin", ob, user);
    return;
  }

  if (yn[0] != 'y' && yn[0] != 'Y') {
    write("好吧，欢迎下次再来。\n");
    destruct(ob);
    return;
  } else if (user) {
    message("system", HIW "有人从别处( " + query_ip_name(ob)
      + " )连线取代你所控制的人物。\n" NOR, user);
    log_login(ob, user, "%s(%s) replaced by %s (%s)\n");
  }

  if (BAN_D->CheckDupIp(ob->query("id"), ob))
    return;

  // Kick out tho old player.
  old_link = user->query_temp("link_ob");
  if (old_link) {
    exec(old_link, user);
    destruct(old_link);
  }

  reconnect(ob, user);
}

// begin new player section.
protected void GetNewId(string id, object ob) {
  if (!id || id == "quit") {
    write("欢迎下次再来。\n");
    destruct(ob);
    return;
  }
  if (!BAN_D->IsLegalId(id)) {
    write(CYN "您的英文名字：" NOR);
    input_to((: GetNewId :), ob);
    return;
  }
  if ((string)ob->set("id", id) != id) {
    write("Fail to set user id...\n");
    destruct(ob);
    return;
  }
  if (file_size(ob->query_save_file() + __SAVE_EXTENSION__) > 0) {
    write("这个名字已经有人使用了，请换一个别的：");
    input_to((: GetNewId :), ob);
    return;
  }
  write(YEL "使用%s这个名字将会在笑傲江湖中创造一个新的生命，您确定吗(y/n)？" NOR,
    capitalize(lower_case(id)));
  input_to((: confirm_id :), ob);
}

protected void confirm_id(string yn, object ob) {
  if (yn == "") {
    write(YEL "使用这个名字将会在笑傲江湖中创造一个新的生命，您确定吗(y/n)？" NOR);
    input_to("confirm_id", ob);
    return;
  }

  if (yn[0] != 'y' && yn[0] != 'Y') {
    write(HIW "好吧，那么请给您的角色重新起个英文名字：" NOR);
    input_to("GetNewId", ob);
    return;
  }

  write(@TEXT

    那么请您为您即将在XO MUD里使用的新生命起一个中文名字吧!!您
可以用这个名字赋予他（她）与众不同的个性和气质。要注意，您起的
名字不要太古怪，不要金庸小说里人物的名字，更不要取一些不雅或容
易造成他人困惑的名字，否则XO将视情况要求你修改你的名字。
TEXT);
  write(HIR "    名字一旦输入就终生不能再自行修改，请务必慎重。\n\n" NOR);
  write(HIW "您的中文名字：" NOR);
  input_to("get_name", ob);
}

protected void get_name(string arg, object ob) {
  if (!BAN_D->IsLegalName(arg)) {
    write("您的中文名字：");
    input_to("get_name", ob);
    return;
  }

  ob->set("name", arg);
  write("请设定您的密码：");
  input_to("new_password", 1, ob);
}


protected void new_password(string pass, object ob) {
  write("\n");
  if (strlen(pass) < 6) {
    write("密码的长度至少要六个字符，请重设您的密码：");
    input_to("new_password", 1, ob);
    return;
  }
  ob->set("password", crypt(pass, 0));
  write("请再输入一次您的密码，以确认您没记错：");
  input_to("confirm_password", 1, ob);
}

protected void confirm_password(string pass, object ob) {
  string old_pass;

  write("\n");
  old_pass = ob->query("password");
  if (crypt(pass, old_pass) != old_pass) {
    write("您两次输入的密码并不一样，请重新设定一次密码：");
    input_to("new_password", 1, ob);
    return;
  }

  write("您的电子邮件地址：");
  input_to("get_email", ob);
}

protected void get_email(string email, object ob) {
  object user;

  if (email == "" || !strsrch(email, "@") || !strsrch(email, ".") || strlen(email) < 8) {
    write("您的电子邮件地址是不正确的，请重新输入：");
    input_to("get_email", ob);
    return;
  }
  ob->set("email", email);

  // If you want do race stuff, ask player to choose one here, then you can
  // set the user's body after the question is answered. The following are
  // options for player's body, so we clone a body here.
  ob->set("body", USER_OB);
  user = make_body(ob);
  if (!objectp(user))
    return;

  write(HIW "您要扮演男性(m)的角色或女性(f)的角色？" NOR);
  input_to("get_gender", ob, user);
}

protected void get_gender(string gender, object ob, object user) {
  if (gender == "") {
    write(YEL "您要扮演男性(m)的角色或女性(f)的角色？" NOR);
    input_to("get_gender", ob, user);
    return;
  }

  if (gender[0] == 'm' || gender[0] == 'M')
    user->set("gender", "男性");
  else if (gender[0] == 'f' || gender[0] == 'F')
    user->set("gender", "女性");
  else {
    write("好主意，不过目前你只能选择做男的或者女的。\n");
    write("你到底要那一种呢？(f/m):");
    input_to("get_gender", ob, user);
    return;
  }

  log_login(ob, user, "%s(%s) was created from %s (%s)\n");
  init_new_player(user);
  enter_world(ob, user);
}

object make_body(object ob) {
  string err;
  object user;
  //int n;

  user = new(ob->query("body"));
  if (!user) {
    write("现在可能有人正在修改使用者对象的程序，无法进行复制。\n");
    write(err + "\n");
    return 0;
  }
  seteuid(ob->query("id"));
  export_uid(user);
  export_uid(ob);
  seteuid(getuid());
  user->set("id", ob->query("id"));
  user->set_name(ob->query("name"), ({ ob->query("id") }));
  return user;
}

protected void init_new_player(object user) {
  user->set("title", "普通百姓");
  user->set("birthday", time());

  user->set("str", 10 + new_random());
  user->set("cps", 10 + new_random());
  user->set("int", 10 + new_random());
  user->set("cor", 10 + new_random());
  user->set("con", 10 + new_random());
  user->set("spi", 10 + new_random());
  user->set("per", 10 + new_random());
  user->set("kar", 10 + new_random());
  user->set("dex", 10 + new_random());

  user->set("food", ((int)user->query("str") + 10) * 10);
  user->set("water", ((int)user->query("str") + 10) * 10);

  user->set("channels", ({ "new", "chat", "rumor", "family" }));
  user->set("max_age", select_max_age(user));
  //  user->set("social_exp", 50);
  //  user->set("combat_exp", 100);
}

// required function: to press enter.
void do_nothing() {}

varargs void enter_world(object ob, object user, int silent) {
  object cloth;
  string startroom;
  int *screen;

  user->set_temp("link_ob", ob);
  ob->set_temp("body_ob", user);
  exec(user, ob);
  //    write("目前权限：" + wizhood(user) + "\n");
  user->setup();

  // In case of new player, we save them here right after setup
  // compeleted.
  user->save();
  ob->save();
  user->set("last_save_time", time());  // autosave requires.
  screen = (int *)ob->GetScreen();
  user->SetScreen(screen[0], screen[1]);

  // add by xli to solve the class of shaolin
  if (user->query("class") == "bonze1")
    user->set("class", "bonze");
  //end add
  //lin:here needs modify:add more kind of cloth.
  if (!user->is_ghost()) {
    switch (user->query("family/family_name")) {
      case "少林派":
        cloth = new(CLOTH_DIR + "sengyi1");
        break;
      default:
        cloth = new(CLOTH_DIR + "cloth1");
        break;
    }
    cloth->move(user);
    cloth->wear();
  }
  if (!silent) {
    cat(MOTD);
    if (wizardp(user)) {
      cat(SYSTEM_CONFIG_DIR "wizmotd");
    }
    write("请按ＥＮＴＥＲ继续————");
    input_to((: do_nothing :));
    // 这里程序继续运行, 但输出信息被屏蔽..暂时缓存
    if (user->is_ghost() && !wizardp(user))
      startroom = DEATH_ROOM;
    else if (!stringp(startroom = user->query("startroom"))) {
      startroom = select_start_room(user);
      rm(LOG_D->query_log_file(user->query("id")));
      LOG_D->do_log(user, sprintf("你充满传奇色彩的一生就从%s开始。",
        load_object(startroom)->query("short")));
      //            user->set("xli_marks/is_newbie",1);
      //            user->set("xli_marks/enter_room",startroom);
      //            user->move("/d/place/newbie/start");
    }
    if (catch(load_object(startroom))) {
      startroom = select_start_room(user);
      user->set("startroom", startroom);
    }
    //        if(!user->query("xli_marks/is_newbie"))
    user->move(startroom);

    //user->eventLogin();
    //replace_some_mark( user );
    MARRY_D->check_will_marry(user);
    MARRY_D->check_marriage(user);
    tell_room(startroom, user->query("name") +
      "连线进入这个世界。\n", ({ user }));
  }

  CHANNEL_D->do_channel(this_object(), "sys",
    sprintf("%s(%s)由%s连线进入。", user->name(), geteuid(user), query_ip_name(user)));

  // 一些扫尾工作。
  UPDATE_D->check_user(user);
  USER_D->CheckUserLevel(user);  // check for high level  ppls
  STATIC_D->AddNewLogin();
}

varargs void reconnect(object ob, object user, int silent) {
  user->set_temp("link_ob", ob);
  ob->set_temp("body_ob", user);
  exec(user, ob);

  user->reconnect();
  if (!silent) {
    tell_room(environment(user), user->query("name") +
      "重新连线回到这个世界。\n", ({ user }));
  }
  CHANNEL_D->do_channel(this_object(), "sys",
    sprintf("%s(%s)由%s重新连线进入。", user->query("name"),
      geteuid(user), query_ip_name(user)));
  UPDATE_D->check_user(user);
}

object find_body(string name) {
  object ob, *body;

  ob = find_player(name);
  if (objectp(ob)) return ob;
  body = children(USER_OB);
  for (int i = 0; i < sizeof(body); i++)
    if (clonep(body[i]) && getuid(body[i]) == name)
      return body[i];

  return 0;
}

int set_wizlock(int level) {
  if (wiz_level(this_player(1)) <= level)
    return 0;
  if (geteuid(previous_object()) != ROOT_UID)
    return 0;
  wiz_lock_level = level;
  return 1;
}

//Modified hydra 1998/10/05
//给新出生的人加上标记，注明是中原还是西域人
string select_start_room(object user) {
  string start_room;
  start_room = start_rooms[random(sizeof(start_rooms))];
  if (start_room == "/d/city/gaochang/center") {
    user->set("hydra/desert/from", "西域");
  } else {
    user->set("hydra/desert/from", "中原");
  }
  return start_room;
}

void log_login(object ob, object user, string format) {
  if (wiz_level(user->query("id")))
    log_file(WIZ_USAGE_LOG, sprintf(format,
      user->query("id"), user->query("name"),
      query_ip_name(ob), ctime(time())));
  else
    log_file(PPL_USAGE_LOG, sprintf(format,
      user->query("id"), user->query("name"),
      query_ip_name(ob), ctime(time())));
}

int select_max_age(object user) {
  int max_age;
  int per, Int, spi, con;

  per = user->query("per");
  Int = user->query("int");
  spi = user->query("spi");
  con = user->query("con");
  max_age = BASE_MAX_AGE + new_random();
  max_age -= (per - 20) / 3 + (Int - 20) / 3 + (spi - 20) / 3;
  max_age += con / 6;
  return max_age;
}

