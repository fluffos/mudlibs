#include <ansi.h>

inherit F_DBASE;

//Variables
private int TotalWager = 0;         //下注金额统计
private int Bet1Wager = 0;
private int Bet2Wager = 0;
private int Bet3Wager = 0;
private int ThisWager = 0;

private int AllowBet1 = 0;            //是否允许下注变量
private int AllowBet2 = 0;

//Function prototypes
float QueryPeilv(int, int);           //计算赔率
void AddTotalWager(int);           //增加和计算总赌注
int QueryTotalWager();
void AddBet1Wager(int);
int QueryBet1Wager();
void AddBet2Wager(int);
int QueryBet2Wager();
void AddBet3Wager(int);
int QueryBet3Wager();
void AddThisWager(int);
int QueryThisWager();
void ResetWager();
void ResetThisWager();

void StartBet1();                      //设置和查询是否允许下注的函数
void StartBet2();
void EndBet1();
void EndBet2();
int QueryBet1();
int QueryBet2();

void create() {
  seteuid(getuid());
  set("name", "博彩精灵");
}

//Interface

//计算赔率函数
float QueryPeilv(float myvalue, float oppvalue) {
  float peilv;
  float diff = myvalue - oppvalue;
  float small;

  if (diff < 0) diff = -diff;
  small = myvalue > oppvalue ? oppvalue : myvalue;

  if (small > 15000) {
    if (diff > 15000) {
      if (myvalue < oppvalue) {
        peilv = 10 + (oppvalue - 10000) / (myvalue - 10000);
        return peilv;
      } else {
        peilv = 1 + (oppvalue - 10000) / (myvalue - 10000);
        return peilv;
      }
    } else if (diff > 6000) {
      if (myvalue < oppvalue) {
        peilv = 5 + (oppvalue - 6000) / (myvalue - 6000);     //赔率5++
        return peilv;
      } else {
        peilv = 1.5 + (oppvalue - 6000) / (myvalue - 6000);
        return peilv;
      }
    } else {
      if (myvalue < oppvalue) {
        peilv = 1.5 + oppvalue / myvalue;
        return peilv;
      } else {
        peilv = 1.5 + oppvalue / myvalue;
        return peilv;
      }
    }
  } else if (small > 6500) {
    if (diff > 15000) {
      if (myvalue < oppvalue) {
        peilv = 20 + (oppvalue - 6000) / (myvalue - 6000);
        return peilv;
      } else {
        peilv = 1 + (oppvalue - 6000) / (myvalue - 6000);
        return peilv;
      }
    } else if (diff > 6000) {
      if (myvalue < oppvalue) {
        peilv = 7 + (oppvalue - 3000) / (myvalue - 3000);
        return peilv;
      } else {
        peilv = 2 + (oppvalue - 3000) / (myvalue - 3000);
        return peilv;
      }
    } else {
      if (myvalue < oppvalue) {
        peilv = 2 + oppvalue / myvalue;
        return peilv;
      } else {
        peilv = 1.2 + oppvalue / myvalue;
        return peilv;
      }
    }
  } else {
    if (diff > 15000) {
      if (myvalue < oppvalue) {
        peilv = 25 + oppvalue / (myvalue + 1);
        return peilv;
      } else {
        peilv = 1 + oppvalue / (myvalue + 1);
        return peilv;
      }
    } else if (diff > 6000) {
      if (myvalue < oppvalue) {
        peilv = 7 + oppvalue / (myvalue + 1);
        return peilv;
      } else {
        peilv = 1.5 + oppvalue / (myvalue + 1);
        return peilv;
      }
    } else {
      if (myvalue < oppvalue) {
        peilv = 1.5 + oppvalue / (myvalue + 1);
        return peilv;
      } else {
        peilv = 1.5 + oppvalue / (myvalue + 1);
        return peilv;
      }
    }
  }
}

//清空所有下注金额
void ResetWager() {
  TotalWager = 0;
  Bet1Wager = 0;
  Bet2Wager = 0;
  Bet3Wager = 0;
  ThisWager = 0;
}

//计算总下注金额
void AddTotalWager(int amount) {
  TotalWager += amount;
}

int QueryTotalWager() {
  return TotalWager;
}

//计算一号博彩下注金额
void AddBet1Wager(int amount) {
  TotalWager += amount;
  Bet1Wager += amount;
}

int QueryBet1Wager() {
  return Bet1Wager;
}

//计算二号博彩下注金额
void AddBet2Wager(int amount) {
  TotalWager += amount;
  Bet2Wager += amount;
}

int QueryBet2Wager() {
  return Bet2Wager;
}

//计算三号博彩下注金额
void AddBet3Wager(int amount) {
  TotalWager += amount;
  Bet3Wager += amount;
}

int QueryBet3Wager() {
  return Bet3Wager;
}

//计算本场比武的下注金额
void AddThisWager(int amount) {
  ThisWager += amount;
}

void ResetThisWager() {
  ThisWager = 0;
}

int QueryThisWager() {
  return ThisWager;
}


void StartBet1() {
  message("bet", GRN "\n现在下一场比试开始下注，请大家抓紧时间。\n一分"
    "钟后停止下注。\n\n" NOR, users());
  AllowBet1 = 1;
  ResetThisWager();
  remove_call_out("EndBet1");
  call_out("EndBet1", 60);
}

void StartBet2() {
  message("bet", GRN "\n现在二号、三号博彩开始下注，请大家抓紧时间。\n十分"
    "钟后停止下注。\n\n" NOR, users());
  AllowBet2 = 1;
  ResetWager();
  remove_call_out("EndBet2");
  call_out("EndBet2", 600);
}

void EndBet1() {
  AllowBet1 = 0;
  message("bet", RED "\n下一场比试下注结束！！\n" NOR, users());
  message(
    "bet",
    sprintf(GRN "本场比试的下注总额为：%s\n" NOR, QueryThisWager() ? PriceString(QueryThisWager()) : "零"),
    users()
  );
}

void EndBet2() {
  AllowBet2 = 0;
  message("bet", RED "\n二号、三号博彩下注结束！！\n" NOR, users());
  message(
    "bet",
    sprintf(GRN "二号博彩下注总额为：%s\n" NOR, QueryBet2Wager() ? PriceString(QueryBet2Wager()) : "零"),
    users()
  );
  message(
    "bet",
    sprintf(GRN "三号博彩下注总额为：%s\n\n" NOR, QueryBet3Wager() ? PriceString(QueryBet3Wager()) : "零"),
    users()
  );
}

int QueryBet1() {
  return AllowBet1;
}

int QueryBet2() {
  return AllowBet2;
}
