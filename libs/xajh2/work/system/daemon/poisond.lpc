// poisond.c
// by lnwm on 98/03/31

// 用来处理毒药的发作。

// 基本想法：毒药有阳性，阴性和中性之分
//           体内同时种两种类型的毒药，当有互相克制的现象
//           但毕竟是毒药，当同时中两种类型的毒时，阴阳相消转为毒性相对较低的中性毒药。
//           中性毒药可看作是体内毒素的存留，不能解消，除非借助其他手段。

//           另外，毒药分对精气神不同的伤害。(gin,kee,sen)
//           同时还分硬伤和软伤。(receive_wound和recieve_damage)

//           中毒方式则应分为1。涂在兵器上，砍中后引发。(涉及combatd）
//                           2。放在食物，饮水里。(涉及put,eat,drink等cmds或标准饮食)
//                           3。散布在空气中，人走进去后引发。(涉及标准房间) 
//                           4。其他方式。(用add_action使用)

//           考虑毒药的慢发作特性，所有效果都作为condition存在在人身上。
//           由每次update_condition时判断发作状况。

#include <dbase.h>
#include <ansi.h>

// Genuine pre-existing content bug (not this pipeline's fault): this file
// calls set()/restore() (F_SAVE's save/restore-to-disk pair) but never
// actually inherited F_SAVE, unlike every sibling daemon in this codebase
// (e.g. emoted.lpc) that follows the same set()+restore() shape. Not
// reached by preload or the registration/post-login test (poisond isn't
// in etc/preload), so this was a dormant compile failure -- fixed anyway
// since it's a one-line, obviously-correct match to the established
// sibling pattern.
inherit F_SAVE;

void create() {
  seteuid(getuid());
  set("name", "毒药精灵");
  set("id", "poision");
  restore();
}

void FaZuo(object ob) {
  int *get_gin_wound, *get_kee_wound, *get_sen_wound;
  int *get_gin_damage, *get_kee_damage, *get_sen_damage;
  int gin_wound, kee_wound, sen_wound;
  int gin_damage, kee_damage, sen_damage;

  mapping gin_yang_wound, kee_yang_wound, sen_yang_wound;
  mapping gin_yin_wound, kee_yin_wound, sen_yin_wound;
  mapping gin_yang_damage, kee_yang_damage, sen_yang_damage;
  mapping gin_yin_damage, kee_yin_damage, sen_yin_damage;

  gin_yang_wound = ob->query_marks("poison/gin/yang/wound");
  kee_yang_wound = ob->query_marks("poison/kee/yang/wound");
  sen_yang_wound = ob->query_marks("poison/sen/yang/wound");
  gin_yin_wound = ob->query_marks("poison/gin/yin/wound");
  kee_yin_wound = ob->query_marks("poison/kee/yin/wound");
  sen_yin_wound = ob->query_marks("poison/sen/yin/wound");
  gin_yang_damage = ob->query_marks("poison/gin/yang/damage");
  kee_yang_damage = ob->query_marks("poison/kee/yang/damage");
  sen_yang_damage = ob->query_marks("poison/sen/yang/damage");
  gin_yin_damage = ob->query_marks("poison/gin/yin/damage");
  kee_yin_damage = ob->query_marks("poison/kee/yin/damage");
  sen_yin_damage = ob->query_marks("poison/sen/yin/damage");


}
