// system/daemon/advertd.c
// written by akuma 1999/8/23
// 广告精灵，用来发布广告信息 :)

#define DELAY_TIME 600
#define ADVERT_TEXT "/advert.txt"
inherit F_DBASE;

int announce(int);



void create() {
  seteuid(getuid());
  set("channel_id", "广告");
  call_out("announce", DELAY_TIME, 1);
}

int announce(int start_line) {
  string info;
  remove_call_out("announce");
  // 从广告文件中随机读出（？或者顺序读出？）广告信息
  // 放进来：

  info = read_file(ADVERT_TEXT, start_line, 1);
  if (!stringp(info)) {
    start_line = 1;
    info = read_file("/advert.txt", start_line, 1);
  }
  CHANNEL_D->do_channel(this_object(), "sysinfo", info);
  call_out("announce", DELAY_TIME, start_line + 1);
  return 1;
}
