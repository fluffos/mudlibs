#define SERVICE_ERROR
void eventReceiveError(string mud, string from, string to, mixed *packet) {
  object ob;
  string error_code, msg;

  if (to && !(ob = find_player(to)))
    return;
  NBUG(packet);
  error_code = packet[0];
  msg = packet[1];
  switch (error_code) {
    case "unk-dst": case "not-imp": case "unk-type": case "unk-src":
      log_file("intermud/erros", error_code + ": " + msg + "\n");
      return;
    case "unk-type":
      log_file("intermud/errors", error_code + ": " + msg + "\n");
      return;
    case "unk-user":
      if (!ob)
        return;
      message("system", (msg ? "来自" + mud + "的答复：" + msg : "来自" + mud + "的未知错误：" +
        error_code + "."), ob);
  }
}
