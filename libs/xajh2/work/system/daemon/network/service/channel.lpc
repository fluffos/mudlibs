#include <net/daemons.h>
#include "mudlib.h"

#define SERVICE_CHANNEL

void eventReceiveChannelMessage(string mud, string from, string to, mixed *packet) {
  /*    if( file_name(previous_object()) != INTERMUD_D )
        return;
*/
  NBUG(packet);
  CHANNEL_D->eventReceiveRMsg(from, packet[1], mud, packet[0], packet[2]);
}

void eventSendRMsg(string name, string channel, string msg) {
  SendToAll("channel-m", ({ channel, name, msg }));
}
