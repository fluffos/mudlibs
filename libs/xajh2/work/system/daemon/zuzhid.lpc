//  groupd.c (?) or orgd.c or zuzhid.c 
//  first edit at 97-08-14 00:41
//  by Lin
//  说明：
//    每个组织有一个自己的文件"zuzhi".c，放在/system/feature/zuzhi/下面，
//  用来记载每个组织的一些数据库和单独的函数。每个人应该允许参加多个组织
//  正因为如此，一般上不应该让别人看到这个人的组织归属情况。
//  现在最大的问题就是：组织应该是可以重叠参与的，所以，怎么决定表现出来的是哪个
//  组织的数据呢？
//      首先，可以是最后进入的组织。
//  现在还是决定不让其它人看到组织属性，如果另一个人是你所在的组织中的上级，那么
//  他可以看到你是这个组织的什么人。（这个交给look.c去完成）
//  由于有TRILL 原来用的"zuzhi"数据存在，现在的组织数据改用"group"这个mapping.
inherit F_CLEAN_UP;
inherit F_DBASE;
inherit F_SAVE;

mixed SetupZuzhi(object who, string zuzhiname, string touxian, string zhiwu, mixed group);
//  初始化
mixed DeleteZuzhi(object who, string zuzhiname, mixed group);
//  离开组织的数据删除工作
//  同时应该另置标以记录曾经参加过的组织情况。
int SetZuzhi(string title, object who, string zuzhiname, mixed what);
int Save(object saveobj);
mixed GetDbase(object saveobj);
string *GetSameZuzhi(object ob1, object ob2);

////////////////////////////////////////////////////////////////////////////////
mapping ToId = ([
  "一品堂": "yipin",
  "一品堂「玄阳堂」": "yipin",
  "一品堂「玄才堂」": "yipin",
  "大宋禁军": "jinjun",
  "丐帮": "gaibang",
  "禁军": "jinjun",
  "西夏一品堂": "yipin",
]);

void create() {
  seteuid(ROOT_UID);
  set("name", "组织精灵");
  set("id", "groupd");
}

mixed SetupZuzhi(object who, string zuzhiname, string touxian, string zhiwu, mixed data) {
  mapping zuzhi;
  string *all_touxian, *all_zhiwu, f_zuzhi, id;

  //    tell_object( who, "daemon ok1\n");
  if (ToId[zuzhiname])
    id = ToId[zuzhiname];
  else
    id = zuzhiname;
  //ToId是汉字的转换mapping，有了它就可以随便用英文或中文给zuzhiname赋值了。
  f_zuzhi = ZUZHI_DIR + id;
  /*
    if ( f_zuzhi->RecruitMember( who, touxian, zhiwu, this_zuzhi[ "entertime" ] ) )
        return;
         给f_zuzhi一个记录的机会。 
         应该是用来将这个成员的信息记录在一个.o文件中以便作全局设定。  
         但是返回1等于是接管了SetupZuzhi这个函数的功能，（重载） 
     这个以后再说吧，先不给这个接口。 
*/
  //    tell_object( who,"daemon ok2\n");
  if (file_size(f_zuzhi + ".lpc") < 0)
    return notify_fail("<<Error>>: zuzhiname wrong!\n");
  //    tell_object( who,"daemon ok3\n");
  if (!mapp(data))
    data = ([]);
  zuzhi = ([]);
  if (zuzhiname != id)
    zuzhi["name"] = zuzhiname;
  else
    zuzhi["name"] = f_zuzhi->QueryName(who);
  //    tell_object( who,"daemon report: name " + zuzhi["name"] + "\n");
  //  这里是为了方便巫师可以用一个组织的id来调用函数以便简单明了，让组织的
  //  文件中的函数QueryName()自己去判断该给什么；也可以用直接的name（中文）
  //  来设定，以增加越过QueryName()的灵活性。
  zuzhi["id"] = f_zuzhi->QueryId(who);
  all_touxian = f_zuzhi->QueryTouxian(who);
  all_zhiwu = f_zuzhi->QueryZhiwu(who);
  zuzhi["entertime"] = who->query("mud_age");
  if (!zuzhi["touxian"] = touxian)
    zuzhi["touxian"] = all_touxian[0];
  if (!zuzhi["zhiwu"] = zhiwu)
    zuzhi["zhiwu"] = all_zhiwu[0];
  zuzhi["lastcontacttime"] = who->query("mud_age");
  zuzhi["score"] = 0;
  //  组织信任度清零。
  data[zuzhiname] = zuzhi;
  //    tell_object( who,"daemon ok4\n");
  if (userp(who))
    LOG_D->do_log(who, sprintf("你加入%s，成为一名%s。", zuzhi["name"],
      zuzhi["touxian"]));
  f_zuzhi->RecruitMember(who, touxian, zhiwu, zuzhi["entertime"]);
  // 给f_zuzhi一个记录的机会。 
  // 应该是用来将这个成员的信息记录在一个.o文件中以便作全局设定。  
  // zuzhid.c也应该自己有一个存盘文件
  return data;
}
mixed DeleteZuzhi(object who, string zuzhiname, mixed data) {
  string f_zuzhi;
  if (ToId[zuzhiname])
    zuzhiname = ToId[zuzhiname];
  f_zuzhi = ZUZHI_DIR + zuzhiname;
  if (!who->GetZuzhi(zuzhiname))
    return notify_fail("wrong: no such zuzhi in this account!!\n");
  if (userp(who))
    LOG_D->do_log(who, sprintf("你退出了%s.", who->ZuzhiName(zuzhiname)));
  if (!f_zuzhi->FireMember(who))
    map_delete(data, zuzhiname);
  //  一般FireMember()和RecruitMember()都不返回1.
  //  接口以便zuzhi进行什么追杀啦，通缉啦。。。。。。
  if (who->IsMemberOf(zuzhiname))
    data[zuzhiname]["deleted"] = 1;
  return data;
}

string *GetSameZuzhi(object ob1, object ob2) {
  string *ob1_id;
  int i;
  mapping zuzhi = ([]);

  ob1_id = ob1->GetZuzhiId();
  if (!sizeof(ob1_id))
    return 0;
  for (i = 0; i < sizeof(ob1_id); i++) {
    //        tell_object( ob1, "daemon say: " + ob1_id[ i ] + "\n" );
    if (ob2->IsMemberOf(ob1_id[i]))
      zuzhi[ob1_id[i]] = 1;
  }
  if (!sizeof(keys(zuzhi)))
    return 0;
  return keys(zuzhi);
}
