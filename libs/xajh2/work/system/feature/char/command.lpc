#include <command.h>
#include <dbase.h>
#include <origin.h>
#include <options.h>
//#include <Action.h>

inherit F_ACTION;

// Functions prototype
int force_me(string);
nomask void disable_player(string type);
nomask void enable_player();
nomask int valid_command(object this, string file);
varargs nomask void disable_command(string path, string reason);
nomask void enable_path();
int can_act();

private int EnvEffect(object this, string verb, string arg);

// Let command path be private, thus we can make sure no one can get command
// path directly from restore_object().
private nosave string *path;

// Leave this to allow other objects can search your commands such as
// help, which...
string find_command(string verb) {
  return (string)COMMAND_D->find_command(verb, path);
}

// This is the add_action hook handling movement, commands, emotes and
// channels. Optimization is needed.
nomask int command_hook(string arg) {
  string verb, file;
  object env, this;

#ifdef PROFILE_COMMANDS
  int mem, utime, stime;
  mapping info;

  mem = memory_info();
  info = rusage();
  utime = info["utime"];
  stime = info["stime"];
#endif

  this = this_object();
  // 这里本来是指令限制，move to user.c

  verb = query_verb();
  // LALA add to detected riding limit.( Amber 1998-04-25 08:18 )
  // 蠢人也不留个说明。
  file = find_command(verb);

  /*    if ( stringp( file ) && BIWU_D->query_biwu() )
       //  && !environment( this_object() )->query("biwu") )
       {
            string * file_name = explode( file, "/" );
            if ( file_name[ 1 ] == "verb" )
            {
                switch ( file_name[ 2 ] ) 
                {
                    case "fight"    : 
                    case "bihua"    : 
                    case "guard"    :
                    case "kill"     :
                    case "duilian"  :  
                    return notify_fail("现在是笑傲江湖比武大会时间，禁止所有其他战斗。\n");
                }
            }
        };//by lnwm for biwu 990621
*/
  if (stringp(file) && query_temp_marks("is_riding") != 0) {
    string *enable_cmds = ({  // 骑在马上允许的动作.
    "drink", "drop", "eat", "follow",
      "give", "go", "look", "nod",
      "remove", "ride", "shake", "stop",
      "talk", "unwield", "wear", "wield", });
    string *file_name = explode(file, "/");
    if (file_name[1] == "verb" &&
      member_array(file_name[2], enable_cmds) < 0)
      return notify_fail("你现在骑着一" + query_temp_marks("is_riding")
        + "呢，无法做出这个动作！\n");
  }
  env = environment();
  //printf( "Enter command_hook with %s, me is %O, verb is %s\n",
  //    arg, this, verb );
  //////////////////////////////////////////////////////////////////
  // FIXME: this action will cause 'too long evaluation' error frequently
  // remarked by nerd 1999/12/20
  /*FilterAction();
    if (eventAct(verb, arg))
    {
		// Do nothing.
    }
    else */
  if (!arg && (env && stringp(env->query("exits/" + verb))) &&
    stringp(file = find_command("go")) &&
    valid_command(this, file) &&
    call_other(file, "main", this, verb))  // go directions
  {} else if (stringp(file = find_command(verb)) &&
    valid_command(this, file) &&
    call_other(file, "main", this, arg))  // cmds
  {} else if (EMOTE_D->do_emote(this, verb, arg))  // emotes
  {} else if (CHANNEL_D->do_channel(this, verb, arg))  // chat
  {} else {
    //Qyz  假如被disable后，给出一个为什么会disable的说明。
    if (!this_object())  // 这是一个很奇怪的现象，可能npc已被destruct..
      return 1;
    if (query_temp("disable_status") && find_command(verb))
      return notify_fail(this->query_temp("disable_status") + "\n");
    else
      return 0;
  }

#ifdef PROFILE_COMMANDS
  info = rusage();
  PROFILE_D->log_command(verb, memory_info() - mem,
    info["stime"] - stime, info["utime"] - utime);
#endif
  return 1;
}

nomask void set_path(string *p) {
  if (origin() != ORIGIN_LOCAL &&
    geteuid(previous_object()) != ROOT_UID) {
    error("Security violidation. Must be root to set_path.\n");
  }
  path = p;
}

string *query_path() { return path; }

mixed *query_commands() { return commands(); }

int force_me(string cmd) {
  if (geteuid(previous_object()) != ROOT_UID)
    return 0;
  return command(cmd);
}

nomask void enable_player() {
  //干什么用的?
  //string disable_path;
  //disable_path = query_temp("disable_path");
  mixed *m_paths = ({ NPC_PATH, PLAYER_PATH, IMM_PATH, APP_PATH,
    WIZ_PATH, ARCH_PATH, ADMIN_PATH });

  if (stringp(query("id")))
    set_living_name(query("id"));
  else
    set_living_name(query("name"));

  enable_commands();
  efun::add_action("command_hook", "", 1);
  //last_time = time();
  //last_count = 0;

  if (!userp(this_object()))
    set_path(NPC_PATH);
  else {
    int i;
    string *p = NPC_PATH;
    int level = wiz_level(this_object());
    for (i = 1; i <= level + 1; i++)
      p += ({ m_paths[i] });
    set_path(p);
    if (level)  // wizard
      enable_wizard();
  }
}

nomask void disable_player(string type) {
  object prev, this;

  prev = previous_object();
  this = this_object();
  if (geteuid(prev) != ROOT_UID && prev != this)
    return;

  set("disable_type", type);
  disable_commands();
}

nomask int valid_command(object this, string file) {
  mapping path_level = ([
    "comm": 1,
    "verb": 2,
    "skill": 3,
  ]);
  string path, cmd, disable_path;

  if (wizardp(this))
    return 1;
  if (sscanf(file, "/cmds/%s/%s", path, cmd) != 2)
    return 0;
  disable_path = this->query_temp("disable_path");
  if (disable_path && path_level[path] >= path_level[disable_path])
    return 0;
  else
    return 1;
}

varargs nomask void disable_command(string path, string reason) {
  object this;
  this = this_object();
  this->set_temp("disable_path", path);
  if (reason)
    this->set_temp("disable_status", reason);
}

nomask void enable_path() {
  object this;
  this = this_object();
  this->delete_temp("disable_path");
  this->delete_temp("disable_status");
}

int can_act() {
  object this;
  this = this_object();
  if (!living(this)) return 0;
  if (this->is_busy() ||
    this->is_lianing() ||
    this->is_duilianing() ||
    this->is_fighting())
    return notify_fail("你现在正忙于其他的事情，不可能分心。\n");
  if (this->query_temp("disable_path") == "verb") {
    if (this->query_temp("disable_status"))
      return notify_fail(this->query_temp("disable_status"));
    else return 0;
  } else return 1;
}
