#include <ansi.h>
#include <condition.h>

inherit F_CLEAN_UP;

int update_condition(object me, int duration) {

  me->disable_command("verb", "你正在开门呢。\n");
  me->apply_condition("room", duration - 1);
  message_vision(HIW "你急得满头大汗！\n" NOR, me);
  if (duration < 1) return 0;
  return CND_CONTINUE;
}
