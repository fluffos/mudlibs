#include <ansi.h>
inherit ITEM;
void create() {
  set_name(MAG "解药" NOR, ({ "jie yao", "jieyao" }));
  set_weight(30);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "这是一包解药，不知道没中毒的人吃了会怎样。\n");
    set("unit", "包");
    set("value", 100);
  }
}

void init() {
  add_action("do_feed", "feed");
}

int do_feed(string arg) {
  object me = this_player(), ob;

  if (!arg)
    return notify_fail("你怎么喂东西?\n");
  ob = present(arg, environment(me));
  if (!ob) ob = present(arg, me);
  if (!ob) ob = find_player(arg);
  if (!ob || ob == me || !userp(ob)) return notify_fail("你能够么?\n");
  if (ob->query_condition("miyao") > 0) {
    message_vision("$N小心翼翼的给$n喂解药。\n" + HIR "好有爱心哦!\n" NOR, me, ob);
    tell_object(ob, HIG "你觉得体内的毒性好象被控制住了。\n" NOR);
    ob->clear_condition("miyao");
    ob->apply_condition("yipin_drup", 3);
    tell_object(ob, HIG "你清醒了许多，但是现在几乎不记得自己是谁东西放在哪里了。\n" NOR);
  } else if (!living(ob)) {
    ob->apply_condition("miyao", 10);
    message_vision(HIR "$N给$n喂了些药，感觉很不对劲。\n" NOR, me, ob);
  } else return notify_fail("你想害人么？\n");
  call_out("dest_me", 1, this_object());
  return 1;

}

void dest_me(object ob) {
  destruct(ob);
}
