// deity.c

inherit F_CLEAN_UP;

int update_condition(object me, int duration) {
  int temp_age;
  if (!wizardp(me)) {
    me->apply_condition("deity", duration - 1);
    if (random(3) == 0) {
      message_vision("一道奇异的白色光芒笼罩着$N。\n", me);
      write("天上的神祗特别眷宠你，特降福于你。^_*\n");
      me->set("eff_gin", (int)me->query("max_gin"));
      me->set("gin", (int)me->query("max_gin"));
      me->set("eff_kee", (int)me->query("max_kee"));
      me->set("kee", (int)me->query("max_kee"));
      me->set("eff_sen", (int)me->query("max_sen"));
      me->set("sen", (int)me->query("max_sen"));
      remove_call_out("deity1");
      call_out("deity1", 1, me);
    }
  } else {
    me->set("eff_gin", (int)me->query("max_gin"));
    me->set("gin", (int)me->query("max_gin"));
    me->set("eff_kee", (int)me->query("max_kee"));
    me->set("kee", (int)me->query("max_kee"));
    me->set("eff_sen", (int)me->query("max_sen"));
    me->set("sen", (int)me->query("max_sen"));
    remove_call_out("deity1");
    call_out("deity1", 1, me);
  }
  if (!duration) return 0;
  return 1;
}


void deity1(object me) {
  me->set("food", (int)me->max_food_capacity());
  me->set("water", (int)me->max_water_capacity());
  me->enable_player();
  if (!wizardp(me))
    message_vision("白色光芒渐渐消散了。\n", me);
  else {
    me->set("force", (int)me->query("max_force") * 2);
    me->set("mud_age", 12400);
  }
}
