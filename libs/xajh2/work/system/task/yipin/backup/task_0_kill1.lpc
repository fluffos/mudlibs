// test task 1.

inherit GROUP_TASK;

void create() {
  group_task::create();
  SetExistenceTime(5);  //完成时间
  //    SetTermType( "long" ); //短期或长期
  SetKeyName("kill trill");  //索引
  SetGroupName("yipin");  //隶属组织
  SetLevel(0);   //task等级(申请的等级)
  SetAct("BeginningAct", ([
    "time": 0,  //开始时间条件 if 0 no 条件
    //否则是X月X日被触发
    "site": "yangzhou",  //地点
    "character": "/d/city/lanzhou/npc/monk",  //若没有则newNPC，房间则是player的当前环境
    "message": "你给我杀了trill，发你一把刀先。",  //message
    "bonus": "/clone/weapon/blade/bidao",  //开始物品(string)
    //或zuzhi_score(int)
    "follow": 0,  // 0 || 1 是否是开始   
  ]));
  SetAct("SuccessAct", ([
    "message": "你杀了trill变成的和尚。好！\n\n",  //message
    "bonus": 1024,                  //也可以是string
    "follow": "kill trill next 1",   //可以给出下一个的keyname
  ]));
  SetAct("FailAct", ([
    "message": "连trill都杀不了。呵呵。苯.\n",
    "bonus": -39,
  ]));
  SetTaskEvent(([
    "verb": "kill",
    "event": "kill monk",  //give kill 
    //send buy learn
  ]));
}

void heart_beat() {
  group_task::heart_beat();
  // 如果需要可以扩展heart_beat()，也可以完全重载。
}

int CanBegin(object ppl) {
  // 自己扩展。                        // 
  return group_task::CanBegin(ppl);  //只对本task有效
}

int CanEnd(object ppl) {
  // 可以自己扩展。                    //return 0 则不结束
  return group_task::CanEnd(ppl);
}

void PerformBegin(object ppl) {}  //在message完了以后结束

void PerformSuccess(object ppl) {}

void PerformFail(object ppl) {}
