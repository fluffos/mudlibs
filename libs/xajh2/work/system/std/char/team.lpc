inherit NPC;
void group_fight(object ob) {
  mapping member;
  object team_member;
  int i;
  string *id;
  member = query("team_member");
  for (i = 0; i < sizeof(member); i++) {
    if (team_member = present(member[i], environment()) &&
      living(team_member))
      team_member->kill_ob(ob);
  }
}
int team_random_move() {
  mapping exits, member;
  string *dirs, dir;
  int i;
  object team_member;
  member = query("team_member");
  exits = environment()->query("exits");
  if (!mapp(member)) return 0;
  if (!mapp(exits)) return 0;
  dirs = keys(exits);
  dir = dirs[random(sizeof(dirs))];
  command("go " + dir);
  for (i = 0; i < sizeof(member); i++) {
    if (team_member = present(member[i], environment()) &&
      team_member->is_living() && !team_member->is_fighting())
      team_member->command("go " + dir);
  }
}
void set_team(string team_name, mapping team_member) {
  set("team_name", team_name);
  set("team_member", team_member);
}
