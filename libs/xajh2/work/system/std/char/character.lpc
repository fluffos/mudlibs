// Use a tick with longer period than heart beat to save cpu's work
private nosave int tick;

// 用做布尔量, 指示角色是不是在练
private nosave int lianing;

// 要练习的武功
private nosave string lian_skill;

// 练习的招数索引
private nosave int zhao_index;

// Function prototype
int is_lianing();
void do_lian();
int query_char_ratio(string type);
int query_char_eff_ratio(string type);
int query_lingwu_ratio(string skill);
int query_jilei_ratio(string skill);
int query_gongfang();
int query_shili();
int query_lian_limit();
int query_combat_brief();

////////////////////////////////////////////////////////////////////

void create() {
  // so LOGIN_D can export uid to us
  seteuid(0);

  lianing = 0;
}

// Use this function to identify if an object is a character.
int is_character() {
  return 1;
}

// setup: used to configure attributes that aren't known by this_object()
// at create() time such as living_name (and so can't be done in create()).
void setup() {
  //parse_init();
  seteuid(getuid(this_object()));

  set_heart_beat(1);
  tick = 5 + random(10);
  enable_player();

  CHAR_D->setup_char(this_object());
}

void heart_beat() {
  int wimpy_ratio, cnd_flag, chazhi;
  mapping my;
  object ob, this, me;

  my = query_entire_dbase();
  this = this_object();
  me = this_player();
  /*    room = environment( me );

    if ( room -> query("type") == 1 )
    {
     discrease = (-1) * ( room -> query("discrease"));
     message_vision("你感觉很难受, 有些受不了...\n",me);
     me -> add("gin",discrease);
     me -> add("kee",discrease);
     me -> add("sen",discrease);
    }    */
  // If we are dying because of mortal wounds?
  if (my["eff_kee"] < 0 || my["eff_sen"] < 0 || my["eff_gin"] < 0) {
    remove_all_enemy();
    die();
    return;
  }
  // If we're dying or falling unconcious?
  if (my["kee"] < 0 || my["sen"] < 0 || my["gin"] < 0) {
    remove_all_enemy();
    if (!living(this))
      die();
    else
      unconcious();
    return;
  }

  // 执行一个走火入魔的函数,check_force()在damage.c里。。
  chazhi = my["yin"] - my["yang"];
  if (chazhi < 0)
    chazhi *= -1;
  if (chazhi < 200 && my["yang"] > 400 && my["yang"] < 1000
    && random(100) > 101)
    check_force();

  // Do attack if we are fighting.
  if (is_busy()) {
    continue_action();

    // lian 应该在忙状态
    if (lianing && environment() && random(100) > 30)
      do_lian();

    // We don't want heart beat be halt eventually, so return here.
    return;
  } else {
    // Is it time to flee?
    wimpy_ratio = (int)query("env/wimpy");
    if (is_fighting() && intp(wimpy_ratio) && wimpy_ratio > 0 &&
      (query_char_ratio("kee") <= wimpy_ratio ||
        query_char_ratio("sen") <= wimpy_ratio ||
        query_char_ratio("gin") <= wimpy_ratio)) {
      GO_CMD->do_flee(this);
    }
    // Do attack or clean up enemy if we have fleed.
    attack();
  }

  //我们把这一段给 NPC 的程序移到 npc.c 里面，重入 heart_beat()
  /*
    if ( !userp( this ) )
    {
        this->chat();
        // chat() may do anything -- include destruct(this_object())
        if ( !this ) return;
    }
*/

  //      if ( lianing && environment() && random( 100 ) > 30 )
  //          do_lian();

  if (tick--)
    return;
  else
    tick = 5 + random(10);

  cnd_flag = update_condition();

  // If we are compeletely in peace, turn off heart beat.
  // heal_up() must be called prior to other two to make sure it is called
  // because the && operator is lazy :P
  if (((cnd_flag & CND_NO_HEAL_UP) || !heal_up()) &&
    !is_fighting() && !interactive(this)) {
    if (environment()) {
      ob = first_inventory(environment());
      while (ob && !interactive(ob))
        ob = next_inventory(ob);
    }
    if (!ob)
      set_heart_beat(0);
  }

  // NPC 就不老？真是不可思意
  if (!interactive(this))
    return;

  // Make us a bit older. Only player's update_age is defined.
  // Note: update_age() is no need to be called every heart_beat, it
  //       remember how much time has passed since last call.
  // this_object()->update_age();
  // moved to user.c -- nerd

}

int visible(object ob) {
  return 1;
}

int query_char_ratio(string type) {
  if (type != "gin" && type != "kee" && type != "sen")
    error("STD_CHAR: 种类只能是 gin, kee, sen 其中之一。\n");
  return query(type) * 100 / query("max_" + type);
}

int query_char_eff_ratio(string type) {
  if (type != "gin" && type != "kee" && type != "sen")
    error("STD_CHAR: 种类只能是 gin, kee, sen 其中之一。\n");
  return query(type) * 100 / query("eff_" + type);
}

int query_lingwu_ratio(string skill) {
  int lingwu, jibie;

  lingwu = query_lingwu(skill);
  jibie = query_jibie(skill);
  if (!jibie)
    return 0;
  return lingwu * 100 / jibie;
}

int query_jilei_ratio(string skill) {
  int jilei, temp;

  jilei = query_jilei(skill);
  if (!jilei)
    return 0;
  temp = jilei * 100 / lingwu_limit(skill);
  if (temp > 100)
    temp = 100;
  return temp;
}

int query_gongfang() {
  int attack;

  if (undefinedp(query("env/attack")) || !intp(query("env/attack")))
    attack = 50;
  else {
    attack = query("env/attack");
    if (attack < 0)
      attack = 0;
    else if (attack > 100)
      attack = 100;
  }
  return attack;
}

int query_shili() {
  int shili;

  if (undefinedp(query("env/shili")) || !intp(query("env/shili")))
    shili = 100;
  else {
    shili = query("env/shili");
    if (shili < 1)
      shili = 1;
    else if (shili > 100)
      shili = 100;
  }
  return shili;
}

int query_lian_limit() {
  int lian_limit;

  if (undefinedp(query("env/lian_limit")) || !intp(query("env/lian_limit"))) {
    lian_limit = 10;
  } else {
    lian_limit = query("env/lian_limit");
    if (lian_limit < 10)
      lian_limit = 10;
    else if (lian_limit > 99)
      lian_limit = 99;
  }
  return lian_limit;
}

int query_combat_brief() {
  int combat_brief;

  if (!userp(this_object()))
    return 1;
  if (undefinedp(query("env/combat_brief")) ||
    !intp(query("env/combat_brief"))) {
    combat_brief = 0;
  } else {
    combat_brief = query("env/combat_brief");
  }
  return combat_brief;
}

////////////////////////////////////////////////////////////////////
// Lian interface

int is_lianing() {
  return lianing;
}

void start_lian(string skill) {
  zhao_index = 0;
  lianing = 1;
  lian_skill = skill;
  start_busy((: is_lianing :));
}

void stop_lian() {
  lianing = 0;
  if (is_busy()) {
    this_object()->interrupt_me();
  }
}

void do_lian() {
  string msg;
  object this, weapon, skill;
  object room;
  mapping action;
  int jibie, sen_cost, ratio, limit;
  int bonus;
  int SnowRain = 0;

  this = this_object();
  // 如果角色的体能值已经在 10% 或设定的限度下, 就停止练习
  ratio = query_char_ratio("sen");
  limit = query_lian_limit();
  if (limit < 10)
    limit = 10;
  else if (limit > 99)
    limit = 99;
  if ((ratio < limit) || !SKILL_D(lian_skill)->valid_lian(this)) {
    msg = sprintf("$N停手收势，气沉丹田, 练完了%s.\n",
      to_chinese(lian_skill));
    message_vision(msg, this);
    lianing = 0;
    return;
  }
  jibie = this->query_jibie(lian_skill);
  action = SKILL_D(lian_skill)->query_action(jibie);
  msg = action["lian"] + "\n";
  weapon = query_temp("weapon");
  if (objectp(weapon))
    msg = replace_string(msg, "$w", weapon->name());
  message_vision(msg, this);

  // 消耗体能, 如果这一次动作领悟了, 还要消耗精神
  room = environment(this);
  if (objectp(room)
    && NATURE_D->GetWeather(PLACE_D->Contain(room),
      NATURE_D->GetSeason()) >= 3) {
    SnowRain = 1;
    if (!action["sen"])
      sen_cost = 8;
    else
      sen_cost = 2 * (int)action["sen"];
  } else {
    if (!action["sen"])
      sen_cost = 3;
    else
      sen_cost = (int)action["sen"];
  }
  this->receive_damage("sen", sen_cost);

  //      chance = 2000 / jibie;
  //      if ( chance > 100 ) chance = 100;

  if (random(100) > 70 || random(100) < this->query_int()) {
    skill = load_object(SKILL_D(lian_skill));
    if (SnowRain) {
      bonus = this->query_xiuwei_dengji(skill->query_xiuwei_type()) - skill->query_dengji() + 6;
    } else {
      bonus = this->query_xiuwei_dengji(skill->query_xiuwei_type()) - skill->query_dengji() + 2;
    }
    if (bonus <= 0 && !random(100 * (1 - bonus)))
      bonus = 1;
    if (bonus <= 0)
      bonus = 0;
    // TODO : 考虑已经会了高等级武功的情况
    this->improve_jilei(lian_skill, bonus);
  }
}

// set_force ( force, max_force, force_factor )
// nerd 98-10-02
varargs int set_force(int force, int max_force, int factor) {
  set("force", force);
  set("max_force", max_force);
  set("force_factor", factor);
}

// -- overrides ------------
string short(int raw) {
  string str = name::short(raw);
  string mask = query_temp_marks("apply/short");

  if (sizeof(mask))
    str = (string)mask[sizeof(mask) - 1];
  else if (!raw) {
    string nick = query("nickname");

    if (stringp(nick))
      str = sprintf("「%s」%s", nick, str);
  }

  if (!raw) {
    if (is_ghost())
      str = HIB "(鬼气) " NOR + str;
    if (query_temp_marks("is_riding"))
      str += "骑着一" + query_temp_marks("is_riding");
    if (query_temp("netdead"))
      str += "断线了。";
    else if (in_input())
      str += "正在输入文字。";
    else if (query_temp("mask_exercising"))
      str += "正在修炼内力。";
    else if (query_temp("mask/dazuo"))
      str += "正在修炼内力。";
    else if (in_edit())
      str += "在编辑什么东西。";
    else if (interactive(this_object())
      && query_idle(this_object()) > 120)
      str += "在这里发呆。";
    if (!living(this_object()))
      str += HIR + query("disable_type") + NOR;
    // if NPC is not human, no title for it
    if (query("race") == "人类" && !sizeof(mask)) {
      string title = query("title");

      // if NPC has title, don't display zhiye
      if ((!userp(this_object())) && stringp(title)) {
        str = sprintf("%s %s", title, str);
      } else
        str = sprintf("%s %s", RANK_D->query_zhiye(this_object()), str);
    }
  }
  return str;
}

int skill_death_penalty() {
  if (userp(this_object())) {
    skill::skill_death_penalty();
    art::skill_death_penalty();
  }
  return 1;
}

