// twohands_axe.c

#include <weapon.h>

inherit WEAPON;

varargs void init_twohands_axe(int damage, int wound, int flag) {
  init_weapon(damage, wound, flag | TWO_HANDED);
  set_weapon_type("twohands_axe");
  set("skill_type", "blade");
  set("verbs", ({ "chop", "slice", "hack" }));
}

void init() {
  add_action("do_kan", ({ "kan", "cut" }));
}

int do_kan(string arg) {
  object me;
  me = this_player();
  if (!me->can_act()) return 0;
  if (!arg || (arg != "柴" && arg != "chai"))
    return notify_fail("你想砍什么?\n");
  if (arg == "柴" || arg == "chai") {
    if (!this_object()->is_equipped())
      return notify_fail(this_object()->query("name") + "
插在腰里就想砍柴吗？\n");
    if (!environment(me)->query("woods"))
      return notify_fail("这里无法砍柴.\n");
    if ((int)me->query("sen") < 65)
      return notify_fail("你现在累得不行，怎么能再去砍柴呢？\n");
    message_vision("$N拿起手中的" + this_object()->query("name") + "，在林子里砍起柴来....\n"
      , me);
    me->disable_command("verb", "你正在砍柴\n");
    me->set_temp("kan_chai", 0);
    call_out("doing_kan", 1, me);
    return 1;
  }
}

int doing_kan(object me) {
  if (me->query_temp("kan_chai") < 3) {
    message_vision("$N不断地砍着，手边的柴越来越多...\n", me);
    me->receive_damage("sen", 20);
    me->add_temp("kan_chai", 1);
    call_out("doing_kan", 5, me);
    return 1;
  } else {
    message_vision("终于，$N砍了一大捆柴，扛到了肩上。\n", me);
    new("/clone/misc/chai")->move(me);
    me->delete_temp("kan_chai");
    me->enable_path();
    return 1;
  }
}
