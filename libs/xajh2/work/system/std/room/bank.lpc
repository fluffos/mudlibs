#include <ansi.h>

inherit SHOP;

void init() {
  seteuid(getuid());
  seteuid(geteuid());

  add_action("DoConvert", "convert");  //换钱的函数。
  add_action("DoSave", "cun");     //存钱的函数。
  add_action("DoLoad", "qu");       //取钱的函数。
  add_action("DoCheck", "check");    //查帐的函数。
}
