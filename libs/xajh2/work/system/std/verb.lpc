// standard verb.

inherit F_CLEAN_UP;

private string error_msg, verb;
private string *rules, *synonyms;

void create() {
  set_no_clean(1);
  parse_init();
}

protected string set_error_msg(string msg) {
  return (error_msg = msg);
}

string get_error_msg() {
  return error_msg;
}

varargs protected string *set_rules(mixed args...) {
  if (sizeof(rules))
    error("cannot reset rules list.");  // why?
    foreach (mixed arg in args) {
      if (stringp(arg))
        rules = ({ arg });
      else
        rules = arg;  // arg is string array?
    }
  if (verb) {
    foreach (string rule in rules)
      parse_add_rule(verb, rule);
    if (sizeof(synonyms))
      foreach (string cmd in synonyms)
        parse_add_synonym(cmd, verb);
  }
  return rules;
}

string *get_rules() {
  return rules;
}

varargs protected string *set_synonym(mixed *args...) {
  if (sizeof(synonyms))
    error("Cannot reset synonym list.\n");
  foreach (mixed arg in args) {
    if (stringp(arg))
      synonyms += ({ arg });
    else
      synonyms += arg;
  }
  if (verb && sizeof(rules))
    foreach (string cmd in synonyms) parse_add_synonym(cmd, verb);
  return synonyms;
}

string *get_synonyms() {
  return synonyms;
}

protected string set_verb(string str) {
  if (!stringp(str))
    error("Bad argument 1 to SetVerb().\n");
  verb = str;
  if (sizeof(rules))
    foreach (string rule in rules) parse_add_rule(verb, rule);
  if (sizeof(synonyms))
    foreach (string cmd in synonyms) parse_add_synonym(cmd, verb);
  return verb;
}

string get_verb() {
  return verb;
}

// apply
int can_verb_rule() {
  return 1;
}
