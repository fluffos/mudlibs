// Filename : /system/skill/yeshou.c
// 野兽的基本战斗动作，由 verb 来确定



inherit SKILL;

mapping action = ([
  "hoof": ([
    "action": "$N用后腿往$n的$l用力一蹬",
    "damage": 100,
    "damage_type": "瘀伤",
  ]),
  "bite": ([
    "action": "$N扑上来张嘴往$n的$l狠狠地一咬",
    "damage": 20,
    "damage_type": "咬伤",
  ]),
  "claw": ([
    "action": "$N用爪子往$n的$l一抓",
    "damage_type": "抓伤",
  ]),
  "poke": ([
    "action": "$N用嘴往$n的$l一啄",
    "damage": 30,
    "damage_type": "刺伤",
  ]),
  "ding": ([
    "action": "$N用角朝$n的$l使劲一顶",
    "damage": 40,
    "damage_type": "挫伤",
  ]),
]);

int valid_learn(object me) {
  return 0;
}

int valid_lian(object me) {
  return 0;
}

int is_native_skill() {
  return 1;
}
string query_xiuwei_type() { return "unarmed"; }
int query_dengji() { return 1; }
mapping query_action(object weapon) {
  string verb, *verbs;
  object this;

  this = this_object();
  verbs = this->query("verbs");
  //printf( "verbs is %O\n", verbs );

  if (!pointerp(verbs))
    return action["bite"];
  else {
    verb = verbs[random(sizeof(verbs))];
    if (!undefinedp(action[verb]))
      return action[verb];
    else
      return action["bite"];
  }
}
