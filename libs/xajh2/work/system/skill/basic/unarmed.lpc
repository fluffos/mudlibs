string *parry_msg = ({
  "$n挥拳挡开了$N的进攻。\n",
  "$n一手护住上盘，一手护住档部，双掌掌心向外，化解了$N的攻势.\n",
  "$n双手护住要害，右脚反踢$N....\n",
});

string *unarmed_parry_msg = ({
  "$n挥臂一格，架住$P的这招。\n",
  "$n双拳与$N一对，双方全身均是一震。\n",
});

int valid_learn(object me) {
  return 1;
}

int valid_lian(object me) {
  object weapon;

  weapon = me->query_temp("weapon");
  if (weapon)
    return notify_fail("你必须空手练习\n");

  return 1;
}

mapping query_action(int jibie) {
  int i, size;

  size = sizeof(action);
  for (i = 0; i < sizeof(action); i++)
    if (action[i]["jibie"] > jibie) {
      size = i;
      break;
    }
  return action[random(size)];
}

string query_xiuwei_type() { return "unarmed"; }

// 返回这路武功的等级, 第一等返回 1, 第十等返回 10.
int query_dengji() { return 1; }

string query_parry_msg(object weapon) {
  if (!objectp(weapon))
    return parry_msg[random(sizeof(parry_msg))];
  else
    return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}

// 拳法, 给些优待
int query_parry_ratio() { return 10; }
