//飘行自在,有如御风,翩若惊鸿,矫若游龙,沛然而行,云霞舒卷,轻云蔽月
//流风回雪,神光离合,体迅飞凫,飘乎若神,动无常则,若危若安,进止难期
//若往若还,乍阴乍阳,轻趣鹤立

#include <ansi.h>
inherit SKILL;

mapping *action = ({
  ([
    "action": "但见$n脚不着地，一招「步步生莲」，身形早在数丈之外。",
    "lian": "$N脚不着地，一招「步步生莲」，轻轻一滑，绕了一个大圈又回到原地。",
    "jibie": 8,
    "sen": 3,
    "damage_type": "瘀伤"
  ]),
  ([
    "action": "$n身形飘忽，轻轻一纵，使出一式「有无相生」，早已避开。\n",
    "lian": "$N身形飘忽，轻轻一纵，使出一式「有无相生」，横跃出很远\n",
    "jibie": 16,
    "sen": 3,
    "damage_type": "瘀伤"
  ]),
  ([
    "action": "$n一式「无所着相」，身形不变，轻轻滑出丈余。\n",
    "lian": "$N一式「无所着相」，身形不变，平平滑出丈余，差点没摔了一跤。\n",
    "jibie": 32,
    "sen": 3,
    "damage_type": "瘀伤"
  ]),
  ([
    "action": "$n一招「应云何住」，$N眼前一花，已失去$n的踪影。\n",
    "lian": "$N一招「应云何住」，双膝不动，脚尖轻轻一点，弹起一丈。\n",
    "jibie": 64,
    "sen": 2,
    "damage_type": "瘀伤"
  ]),
  ([
    "action": "$n身形急转，一招「流风回雪」，轻飘飘地升在空中，然后一个转折，已在数丈之外。\n",
    "lian": "$N身形急转，一招「流风回雪」，轻飘飘地升在空中，然后一个转折，已在数丈之外。\n",
    "jibie": 96,
    "sen": 4,
    "damage_type": "瘀伤"
  ]),
  ([
    "action": "$n身形未动，一招「梦幻泡影」，飘乎若神,动无常则，$N无论如何出招，就是差之毫厘，不能击中。\n",
    "lian": "$N身形未动，一招「梦幻泡影」，飘乎若神,动无常则。\n",
    "jibie": 128,
    "sen": 4,
    "damage_type": "瘀伤"
  ]),
  ([
    "action": "$n双袖飘飘，一式「凌波微步」，身形鼓荡，有若临风，御风而行，须臾不见。\n",
    "lian": "$N双袖飘飘，一式「凌波微步」，身形鼓荡，有若临风。\n",
    "jibie": 142,
    "sen": 4,
    "damage_type": "瘀伤"
  ]),
});

mapping query_action(int jibie) {
  int i, size;

  size = sizeof(action);
  for (i = 0; i < sizeof(action); i++)
    if (action[i]["jibie"] > jibie) {
      size = i;
      break;
    }
  return action[random(size)];
}

string query_xiuwei_type() {
  return "dodge";
}

int query_dengji() {
  return 7;
}

string *query_lian() {
  string *lian_msg;
  mapping lian_act;

  lian_msg = allocate(sizeof(action));
  for (int i = 0; i < sizeof(action); i++) {
    lian_act = action[i];
    lian_msg[i] = (string)lian_act["lian"];
  }
  return lian_msg;
}

int valid_learn(object me) {
  if (me->query_lingwu("literate") < (100 + me->query_jibie("lingbo-weibu") / 2))
    return notify_fail("你的书念得太少了，领悟不了其中的奥秘。\n");
  return 1;
}

int valid_lian(object me) {
  return 1;
}

int query_youxiao_jibie() { return 15; }
