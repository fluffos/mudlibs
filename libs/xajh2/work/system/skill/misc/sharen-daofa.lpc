// sharen-daofa ...trill 官兵、巡捕的武功
// by trill



inherit SKILL;

mapping *action = ({
  ([ "action": "$N大喝一声，奋力向$n劈下。",
    "lian": "$N大喝一声，双手握刀，全力劈下。",
    "sen": 10,
    "jibie": 100,
    "damage": 110,
    "wound": 55,
    "damage_type": "劈伤"
  ]),
  ([ "action": "$N蓦的发力迅速斜削向$n的$l。",
    "lian": "$N双手持刀，发力迅速向下斜削下去。",
    "sen": 10,
    "jibie": 175,
    "damage": 140,
    "wound": 65,
    "damage_type": "劈伤"
  ]),
  ([ "action": "$N挥刀从一个诡异的角度砍向$n。",
    "lian": "$N刀交左手，反手从一个诡异的角度砍出。",
    "sen": 10,
    "jibie": 250,
    "damage": 230,
    "wound": 85,
    "damage_type": "劈伤"
  ]),

});

string *parry_msg = ({
  "$n手中的$v舞成一团刀花，护住了全身。\n",
  "$n用手中的$v架开$N的攻势。\n",
});

int valid_learn(object me) {
  if (me->query("bellicosity") < 5000)
    return notify_fail("你杀气不够，领悟不了杀人刀法。\n");
  if (me->query_xiuwei("blade") < 5300)
    return notify_fail("你的修为，领悟不了杀人刀法。\n");
  return 1;
}

int valid_lian(object me) {
  object ob;
  ob = me->query_temp("weapon");
  if (!ob || (string)ob->query("weapon_type") != "blade")
    return notify_fail("你不拿刀就想练杀人刀法？不太可能吧。\n");
  return valid_learn(me);
}

string query_xiuwei_type() { return "blade"; }
string query_weapon_type() { return "blade"; }

int query_dengji() { return 4; }

mapping query_action(int jibie) {
  int i, size;

  size = sizeof(action);
  for (i = 0; i < sizeof(action); i++)
    if (action[i]["jibie"] > jibie) {
      size = i;
      break;
    }
  return action[random(size)];
}

string query_parry_msg(object weapon) {
  return parry_msg[random(sizeof(parry_msg))];
}

int query_youxiao_jibie() { return 25; }

int query_parry_ratio() { return 15; }
