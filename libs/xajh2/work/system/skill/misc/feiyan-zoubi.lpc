inherit SKILL;

mapping *action = ({
  ([
    "action": "$N提气纵身，一个箭步，向后急越.......",
    "lian": "$N提气纵身，一个箭步，向后急越.......",
    "jibie": 8,
    "sen": 4,
  ]),
  ([
    "action": "$N猛的一闪身，身形急转，滴溜溜地兜了一个圈子.....",
    "lian": "$N猛的一闪身，身形急转，滴溜溜地兜了一个圈子",
    "jibie": 15,
    "sen": 3,
  ]),
  ([
    "action": "$N轻飘飘地提气上蹿，仿佛升天一样",
    "lian": "$N轻飘飘地提气上蹿，仿佛升天一样",
    "jibie": 25,
    "sen": 4,
  ]),
  ([ "zhaoshi": "「踏雪无痕」",
    "action": "$N一招「踏雪无痕」，飘然转下身来，落到$N身后。",
    "lian": "$N一招「踏雪无痕」，飘然转下身来，落到$N身后。",
    "jibie": 33,
    "sen": 5,
  ]),
  ([ "zhaoshi": "「水上飘」",
    "action":
    "$N向上一纵，一式「水上飘」在空中转了两个大圈，躲了过去。",
    "lian":
    "$N低头侧身，昂头向上一纵，一式「巫山云雨」，在空中转了两个大圈。。",
    "jibie": 40,
    "sen": 4,
  ]),
  ([ "zhaoshi": "「飞天鬼影」",
    "action": "$N一式「飞天鬼影」,形如鬼魅，身子急拔而起。",
    "lian": "$N一式「飞天鬼影」,形如鬼魅，身子急拔而起。",
    "jibie": 50,
    "sen": 4,
  ]),
  ([ "zhaoshi": "「粱上君子」",
    "action":
    "$N一式「粱上君子」飘到空中，两腿一蹬，身子借力而起。",
    "lian":
    "$N一式「粱上君子」飘到空中，两腿一蹬，身子借力而起。",
    "jibie": 60,
    "sen": 6,
  ]),
});

int valid_learn(object me) {
  return 1;
}

int valid_lian(object me) {
  int encu;
  encu = me->query_encumbrance() * 100 / me->query_max_encumbrance();
  if (encu < 10)
    return notify_fail("轻功必须负重练习。\n");

  return 1;
}

mapping query_action(int jibie) {
  int i, size;

  size = sizeof(action);
  for (i = 0; i < sizeof(action); i++)
    if (action[i]["jibie"] > jibie) {
      size = i;
      break;
    }
  return action[random(size)];
}

string query_xiuwei_type() {
  return "dodge";
}

int query_dengji() {
  return 2;
}

string *query_lian() {
  string *lian_msg;
  mapping lian_act;

  lian_msg = allocate(sizeof(action));
  for (int i = 0; i < sizeof(action); i++) {
    lian_act = action[i];
    lian_msg[i] = (string)lian_act["lian"];
  }
  return lian_msg;
}
