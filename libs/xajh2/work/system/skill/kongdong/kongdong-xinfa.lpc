// kongdong xinfa.c
#include <ansi.h>
inherit FORCE;

string query_xiuwei_type() { return "force"; }

int valid_xiulian(object me) {
  if (me->query("max_force") > 5999 && !random(10))
    message_vision(YEL "这么弱的内功，这么深厚的内力，这样修练下去莫不会走火入魔？你不禁有些担心，陷入思考。\n" NOR, me);
  me->start_busy(5);
  return 1;
}

int query_level() { return 3; }
string query_type() { return "yin"; }

string exert_function_file(string func) {
  return EXERT_DIR + "kongdong-xinfa/" + func;
}
