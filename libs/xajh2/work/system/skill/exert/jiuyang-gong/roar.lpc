/* roar.c
 * 少林九阳功的Exert--roar(狮子吼)
 * for xo lib @1.0
 * Created by Hydra at 1999/4/11
 */

#include <ansi.h>

void KillLiving(object, int);
int FindNewbie(object);

int exert(object me, object target, int amount) {
  //    if( me->is_fighting() )
  //        return notify_fail("战斗中运功逼毒？找死吗？\n");
  if (environment(me)->query("no_fight"))
    return notify_fail("这里不准战斗，也不准使用伤害人的绝技！\n");
  if (environment(me)->query("no_kill") == 1)
    return notify_fail("这里不准杀人，也不准使用伤害人的绝技！\n");
  if (environment(me)->query("safeplace"))
    return notify_fail("这里不准使用伤害人的绝技！\n");
  if (!amount) amount = 500;
  if (amount < 500) {
    return notify_fail("狮子吼至少需要用500点内力！\n");
  }
  if (me->query("force") < amount) {
    return notify_fail("你的真气不够。\n");
  }
  if (me->query("peaceful")) {
    return notify_fail("和平居民不能使用这种攻击性技能。\n");
  }
  if (me->query("max_force") < 2 * amount) {
    return notify_fail("你的内功不够深厚，恐怕无法使用狮子吼。\n");
  }

  if (time() - me->query_temp("lnwm/done_roar") <
    100 - me->query_jibie("jiuyang-gong") / 5)
    return notify_fail("你刚刚使用了狮子吼绝技，现在真气尚未凝聚。\n");  //lnwm

    if (me->query_jibie("jiuyang-gong") < 100)
      return notify_fail("你的少林九阳功等级不够，不能使用狮子吼。\n");

  if (me->query("eff_kee") < me->query("max_kee") / 2)
    return notify_fail("你已经受伤过重，再运真气只怕有生命危险！\n");
  //    if( FindNewbie(me) )
  //   	return notify_fail("你发现这里有新手在场，不忍使用狮子吼神功。\n");
  message_vision(RED "$N突然两臂张开，张开大口，纵声长啸。\n" NOR, me);

  KillLiving(me, amount);
  me->add("force", -amount);
  if (amount / 10 >= me->query("gin"))
    me->set("gin", 1);
  else
    me->add("gin", -amount / 10);
  if (amount / 10 >= me->query("sen"))
    me->set("sen", 1);
  else
    me->add("sen", -amount / 10);

  me->set_temp("lnwm/done_roar", time());  //两次疗伤间必须有时间距离。lnwm990406

  return 1;
}

int FindNewbie(object me) {
  foreach (object ob in all_inventory(environment(me))) {
    if (newbiep(ob))
      return 1;
  }
  return 0;
}

void KillLiving(object me, int amount) {
  int my_force_jibie, your_force_jibie;
  string your_force_name;
  int my_force, your_force;
  int damage, wound;

  my_force_jibie = me->query_jibie("jiuyang-gong");
  my_force = me->query("max_force");

  if (!environment(me)) return;
  foreach (object ob in all_inventory(environment(me))) {

    if (ob->is_character() && ob != me && living(ob) && !newbiep(ob) && !ob->query("peaceful")) {
      ob->fight_ob(me);
      your_force = ob->query("max_force");
      your_force_name = ob->query("using_force");
      your_force_jibie = ob->query_jibie(your_force_name);
      if (!your_force_jibie) your_force_jibie = 90;
      if (my_force > your_force && random(4)) {
        //				damage = (amount*(my_force - your_force) * my_force_jibie /2000/your_force_jibie);
        damage = (amount * (my_force - your_force) / 300 * my_force_jibie / my_force);
        if (damage < 0)
          damage = 0;
        wound = (int)(damage / 2);
        if (wound > ob->query("max_kee"))
          wound = ob->query("max_kee");
        message_vision(YEL "只见$N张口结舌，脸现错愕之色；跟着脸色变成痛苦"
          "难当，宛似全身\n在遭受苦刑。\n" NOR, ob);
        ob->receive_damage("kee", damage);
        ob->receive_wound("kee", wound, me);
      } else if (my_force > your_force * ob->query("con") / 15) {
        message_vision(YEL "$N凝神聚气，运功抵抗。\n" NOR, ob);
      } else {
        damage = (amount * (your_force - my_force) * my_force_jibie / 200 / my_force);
        if (damage < 0)
          damage = 500;
        wound = (int)damage / 2;
        message_vision(GRN "$N双手手心相贴，放于胸前，于$n啸声渐消之时，反啸"
          "一声，$n脸色骤变，\n看来受伤不轻。\n" NOR, ob, me);
        me->receive_damage("kee", damage);
        me->receive_wound("kee", wound, ob);
        if (ob->query("force") >= amount)
          ob->add("force", -amount);
        else
          ob->set("force", 0);
      }
    }
  }
}
