string *parry_msg = ({
  "$n一杖直趋他喉下七突穴，那是致命死穴，$N只得全力反击。\n",
  "蓦地里一股劲风已无声无息的袭到，振开了$N的$w。\n",
});
string *unarmed_parry_msg = ({
  "$n不敢怠慢，$v一翘，捺了过去，将$N逼退。\n",
  "$n急运真气，$v迎了上去，双方身子都是一幌。\n",
});

int valid_learn(object me) {
  if (me->query("max_force") < 2500 || me->query("force") < 2500)
    return notify_fail("你内力不够，无法学习一阳杖。\n");
  return 1;
}

int valid_lian(object me) {
  object weapon = me->query_temp("weapon");


  if (!weapon || weapon->query("weapon_type") != "staff")
    return notify_fail("你想练一阳杖？太可笑了吧。\n");
  return valid_learn(me);
}

string query_xiuwei_type() { return "long"; }

string query_weapon_type() { return "staff"; }

int query_dengji() { return 6; }

mapping query_action(int jibie) {
  int i;

  for (i = 0; i < sizeof(action); i++)
    if (jibie < action[i]["jibie"]) {
      i++;
      break;
    }
  return action[random(i)];
}

string query_parry_msg(object weapon) {
  if (weapon)
    return parry_msg[random(sizeof(parry_msg))];
  else
    return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}

string query_zhaoshi(int jibie) {
  int i;

  for (i = 0; i < sizeof(action); i++)
    if (action[i]["jibie"] >= jibie)
      return action[i]["zhaoshi"];
  return "";
}

int query_youxiao_jibie() { return 15; }

int query_parry_ratio() { return 8; }

string perform_action_file(string action) {
  return PERFORM_DIR + "yiyang-zhang/" + action;
}
