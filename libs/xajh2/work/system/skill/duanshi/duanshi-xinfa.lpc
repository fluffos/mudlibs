// duanshi-xinfa.c 段氏心法

inherit FORCE;
#include <ansi.h>

string query_xiuwei_type() { return "force"; }

int valid_learn(object me) {
  if ((int)me->query_jibie("duanshi-neigong") > 59)
    return 1;
  else
    return notify_fail("你的段氏基本内功火候还不够，不能学习段氏心法。\n");
}

int valid_lian(object me) {
  return notify_fail("内功只能通过修炼来增加领悟度。\n");
}

int query_level() {
  return 4;
}

string query_type() {
  return "yang";
}

int valid_xiulian(object me) {
  if ((int)me->query("bellicosity") > 200)
    return notify_fail("你尝试着静思入定，可不知为什么，总是觉得很烦躁。\n");
  if (me->query("force") > me->query("max_force") * 1.5 && me->query("max_force") > 5599 + me->query("rendumai") * 10) {

    return notify_fail(HIY "你的内功修为已经到了你根骨经脉的最高限制。" NOR "
" HIC "你需要用静修的方法打通任督二脉后，才能获得更高的内功修为。\n" NOR);

  }
  return 1;
}

int query_zhuyan() { return 0; }

string exert_function_file(string func) {
  return EXERT_DIR + "duanshi-xinfa/" + func;
}
