// penglai-xinfa.c
// 蓬莱心法 

inherit FORCE;

string query_xiuwei_type() { return "force"; }
int valid_enable(string usage) { return usage == "force"; }

int valid_learn(object me) {
  if ((int)me->query("PKS") > 20 && (int)me->query_lingwu("penglai-xinfa") >= 60)
    return notify_fail("你杀人过多，心中恶念过盛，无法领悟更高深的蓬莱心法。\n");
  return 1;
}

string query_type() {
  return "yang";
}

string exert_function_file(string func) {
  return EXERT_DIR + "penglai-xinfa/" + func;
}

int query_level() {
  return 2;
}

int valid_xiulian(object me) {
  if ((int)me->query("bellicosity") < 200)
    return 1;
  else
    return notify_fail("你尝试着静思入定，可不知为什么，总是觉得很烦躁。\n");
}
