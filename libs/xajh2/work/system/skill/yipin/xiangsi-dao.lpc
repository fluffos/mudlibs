    "lian": "$N刀光一闪再闪三闪，刹那间已劈出三刀",
    "zhaoshi": "「冤家路窄」",
    "jibie": 30,
    "sen": 3,
    "damage": 100,
    "wound": 65,
    "limb": "肩头",
    "damage_type": "割伤"
  ]),
  ([ "action": "$N陡然一折腰，脚下倏进倏退，身形打开时手中$w划出一条诡异的光影",
    "lian": "$N折腰旋身，踏着一种曼妙的节律，手中$w沿着一条诡异的轨迹划出",
    "zhaoshi": "「我为卿狂」",
    "jibie": 10,
    "sen": 1,
    "damage": 115,
    "wound": 75,
    "damage_type": "割伤"
  ]),
  ([ "action": "$N右足独立，上身俯折，左足朝天反踢，一招「碧江洗剑」，$w斜斩$n的下盘",
    "lian": "$N俯身独立，左足反踢朝天，左手反手拂向左足尖，右手$w斜斩$n的下盘",
    "zhaoshi": "「碧江洗剑」",
    "jibie": 40,
    "sen": 3,
    "damage": 120,
    "wound": 80,
    "limb": "肋间",
    "damage_type": "割伤"
  ]),
  ([ "action": "$N漫步旋身，一招「窃玉偷香」，手中$w如惊鸿一闪，转瞬又消失得无影无踪",
    "lian": "$N手中刀光倏隐倏现，脚下漫步旋身，意态潇洒不羁",
    "zhaoshi": "「窃玉偷香」",
    "jibie": 50,
    "sen": 4,
    "damage": 125,
    "damage_type": "割伤"
  ]),
  ([ "action": "$N目光中流露出千种温柔，又夹杂着万分凄苦，一招「郎情妾意」，刀光若有若无",
    "lian": "$N神色一变，仿佛落入无边的回忆中去，刀光也变得淡淡的，反而让人觉得无从抵当",
    "zhaoshi": "「郎情妾意」",
    "jibie": 87,
    "sen": 4,
    "damage": 135,
    "wound": 85,
    "damage_type": "割伤"
  ]),
  ([ "action": "$N一提真气向$n直掠过去，一招「雨暴风狂」化作满天刀影向$n挥去",
    "lian": "$N使一招「雨暴风狂」，一时间满耳都是凄厉的刀声",
    "zhaoshi": "「雨暴风狂」",
    "jibie": 100,
    "sen": 4,
    "damage": 145,
    "wound": 90,
    "damage_type": "割伤"
  ]),
});

string *parry_msg = ({
  "$n错步沉腰，一招「春色无边」，$v平挥而出，“当”的一声将$w荡了开去。\n",
  "$n使一招「我为卿狂」，身形扭转，脚下踏着一种曼妙的步法进退如风。\n"
  "$N生怕一击不中，招式用老，只得收回$w再觅良机。\n",
  "忽听得“当”的一声，$N只觉得手心一震，手中的$w已经弹了开去！\n"
  "回眼望来，只来得及撇见一抹刀光消失在$n的肘后。\n",
  "$n使出一招「针锋相对」，挥动手中$v迎向$w，硬打硬劈，寸步不让！\n",
});
string *unarmed_parry_msg = ({
  "$n错步沉腰，一招「春色无边」，$v平挥而出，截向$N的小臂。\n",
  "$n使一招「我为卿狂」，身形扭转，脚下踏着一种曼妙的步法进退如风。\n"
  "$N只觉得怎么也把握不住$n下一刻的位置，这一招是无论如何也攻不下去了。\n",
  "$n一招「道左相逢」，$v斜斩$N右腕，将$N逼出五尺开外。\n",
  "$n忽然疯了一般地举刀乱砍，全然看不出什么章法，哪有什么高手风范！\n"
  "$N正在大惑不解时，猛地发现这看似胡劈乱砍的刀势竟交织成一张刀网！\n"
  "急忙收手时，方才想起，相传「相思刀法」中最是神秘莫测的一招：「死缠烂打」。\n",
});

int valid_learn(object me) {
  return 1;
}

int valid_lian(object me) {
  object ob;
  ob = me->query_temp("weapon");
  if (!ob || (string)ob->query("weapon_type") != "blade")
    return notify_fail("练刀法还是用刀来练比较容易见效，你说呢?\n");
  return valid_learn(me);
}

string query_xiuwei_type() { return "blade"; }

string query_weapon_type() { return "blade"; }

int query_dengji() { return 6; }

