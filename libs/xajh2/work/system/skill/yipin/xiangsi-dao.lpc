// xiangsi-daofa.c 相思刀法



inherit SKILL;

mapping *action = ({
  ([ "action": "$N虚步提腰，一招「彩蝶展翅」，刀锋反卷$n咽喉",
    "lian": "$N虚步提腰，刀势倒卷而上，恰如「彩蝶展翅」",
    "zhaoshi": "「彩蝶展翅」",
    "jibie": 20,
    "sen": 2,
    "damage": 80,
    "wound": 60,
    "limb": "脸上",
    "damage_type": "割伤"
  ]),
  ([ "action": "$N使一招「翠袖凝芳」，大袖一甩，向$n劈面一拂，$w藏于袖下，向$n咽喉划去",
    "lian": "$N一抖袍袖，$w乘势一划，刀光在袖影中若隐若现",
    "zhaoshi": "「翠袖凝芳」",
    "jibie": 2,
    "sen": 1,
    "damage": 95,
