string *parry_msg = ({
  "$n轻叹一声，手中$w怀中一抱，一时「落花无意」，$w锵然跃出倏的化作几点带露"
  "的桃花，飘然飞向$N的$l",
  "$n横箫一架，顺手用另一只手反扣$N手臂。\n",
});
string *unarmed_parry_msg = ({
  "$n大喝一声，右手$w一封，左拳反击而出。\n",
  "$n横箫一架，顺手用另一只手反扣$N手臂。\n",
});

mapping query_action(int jibie) {
  int i, size;

  size = sizeof(action);
  for (i = 0; i < sizeof(action); i++)
    if (action[i]["jibie"] > jibie) {
      size = i;
      break;
    }
  return action[random(size)];
}

string query_xiuwei_type() {
  return "short";
}

string query_weapon_type() { return "dagger"; }

int query_dengji() { return 6; }

string query_parry_msg(object weapon) {
  if (objectp(weapon))
    return parry_msg[random(sizeof(parry_msg))];
  else
    return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}

int query_youxiao_jibie() { return 10; }

int query_parry_ratio() { return 15; }

int valid_lian(object me) {
  object weapon;

  weapon = me->query_temp("weapon");
  if (!weapon || weapon->query("weapon_type") != "dagger")
    return notify_fail("你必须先找一把匕首才能练。\n");

  return 0;
}

int valid_learn(object me) {
  if (me->query_jibie("literate") < 150)
    return notify_fail("你的文化太低，无法练这门武功。\n");
  return 1;
}
