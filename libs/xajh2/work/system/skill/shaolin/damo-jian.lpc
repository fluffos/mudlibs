inherit SKILL;

mapping *action = ({
  ([ "action": "$N使一式「世事多纷扰」，手中$w微微一颤，幻作千万道流光，向$n的$l汇去",
    "lian": "$N使一式「世事多纷扰」，手中$w嗡嗡作响，化作满天剑影挥洒而出",
    "sen": 6,
    "jibie": 0,
    "dodge": 0,
    "parry": 15,
    "zhaoshi": "「世事多纷扰」",
    "damage": 55,
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N使出一式「如梦幻泡影」，手中$w欲进还退，欲抑还扬，有意无意间向$n捺去",
    "lian": "$N剑势飘忽，剑意不定，仿佛沉浸在一片如诗如梦的幻境中，丝毫不见杀气",
    "sen": 6,
    "jibie": 10,
    "dodge": 20,
    "parry": 30,
    "zhaoshi": "「如梦幻泡影」",
    "damage": 60,
    "damage_type": "割伤"
  ]),
  ([ "action": "$N一式「如露亦如电」，飘身直进，趁势挥出一剑，截向$n的$l",
    "lian": "$N一式「如露亦如电」，飘身直进，趁势挥出一剑",
    "sen": 7,
    "jibie": 20,
    "dodge": 10,
    "parry": 0,
    "zhaoshi": "「如露亦如电」",
    "damage": 100,
    "damage_type": "割伤"
  ]),
  ([ "action": "$N剑光疾转，身形飘飘，手中$w向$n斩去，正是一招「法舟入空冥」",
    "lian": "$N剑光流动，身随剑走，仿佛不是人御剑，反是剑御人",
    "sen": 7,
    "jibie": 30,
    "dodge": 20,
    "parry": 20,
    "zhaoshi": "「法舟入空冥」",
    "damage": 70,
    "damage_type": "割伤"
  ]),
});

string *parry_msg = ({
  "$n一式「如露亦如电」，飘身而退，顺势挥出一剑，铮的一声将$w荡了开去\n",
  "$N之觉得手中$w一滞，不自主的向$v贴了上去，却无半丝声响发出\n"
  "$N猛提一口真气，震腕一挣，方得以吧$w收了回来\n",
});


string *unarmed_parry_msg = ({
  "$n手中$v微微一颤，幻作千万道流光，布下层层剑幕\n",
  "$n手中$v欲进还退，欲抑还扬，有意无意间向$N手腕截去\n",
  "$n飘身而退，顺势一剑抹向$N的小臂\n",
});
int valid_learn(object me) {
  if (me->query_jibie("buddhism") < 110)
    return notify_fail("你的佛学修为不够，强练绝技会伤及身体。\n");
  if ((int)me->query("max_force") < 150)
    return notify_fail("你的内力不够，强练达摩剑法有损无益。\n");

  return 1;
}

int valid_lian(object me) {
  object weapon;

  weapon = me->query_temp("weapon");
  if (!weapon || (string)weapon->query("weapon_type") != "sword")
    return notify_fail("你必须先找一把剑才能练剑法。\n");

  return valid_learn(me);
}

mapping query_action(int jibie) {
  int i, size;

  size = sizeof(action);
  for (i = 0; i < sizeof(action); i++)
    if (action[i]["jibie"] > jibie) {
      size = i;
      break;
    }
  return action[random(size)];
}

string query_parry_msg(object weapon) {
  if (weapon)
    return parry_msg[random(sizeof(parry_msg))];
  else
    return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}

string query_xiuwei_type() { return "sword"; }
string query_weapon_type() { return "sword"; }

int query_dengji() { return 5; }

int query_youxiao_jibie() { return 8; }

int query_parry_ratio() { return 7; }
