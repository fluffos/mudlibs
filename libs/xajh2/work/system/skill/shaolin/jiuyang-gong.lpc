#include <ansi.h>
inherit FORCE;

string query_xiuwei_type() {
  return "force";
}

string *parry_msg = ({
  "$n双臂一震，内力游走全身，$N根本不可近身。\n",
  "$n长袖一甩，一股大力将$N送出丈外。\n",
  "$n凝聚内力，轻描淡写地化解了$N的攻势。 ÷n",
});

string *absorb_msg = ({
  "$n身体微蹲，双臂一张，浑厚的九阳神功游走全身。\n",
  "$n施展出九阳神功，浑身坚如寒铁。\n",
  "$n身型微展，九阳神功充斥了丈许空间。\n",
});

int valid_learn(object me) {
  if (me->query("gender") != "男性"
    || me->query("have_married"))
    return notify_fail("你非童男之体，不能练习少林九阳神功。\n");

  if (me->query_jibie("banruo-xinfa") <
    me->query_jibie("jiuyang-gong") / 2)
    return notify_fail("你的般若心法还没有练好呢！\n");
  if (me->query("force") > me->query("max_force") * 1.5 && me->query("max_force") > 4849 + me->query("con") * 10 / 3 + me->query("rendumai") * 10) {

    return notify_fail(HIY "你的内功修为已经到了你根骨经脉的最高限制。" NOR "
" HIC "你需要用静修的方法打通任督二脉后，才能获得更高的内功修为。\n" NOR);

  }
  return 1;
}

int valid_lian(object me) {
  return notify_fail("少林九阳功只能通过修炼或者是使用来增加领悟度。\n");
}

int query_level() {
  return 5;
}
string query_type() {
  return "yang";
}

int valid_xiulian(object me) {
  if (me->query("shaolin/announced"))
    return notify_fail("你尝试着静思入定，可不知为什么，总是觉得很烦躁。\n");
  if ((int)me->query("bellicosity") > 100)
    return notify_fail("你尝试着静思入定，可不知为什么，总是觉得很烦躁。\n");
  if (me->query("force") > me->query("max_force") * 1.5 && me->query("max_force") > 4849 + me->query("rendumai") * 10) {

    return notify_fail(HIY "你的内功修为已经到了你根骨经脉的最高限制。" NOR "
" HIC "你需要用静修的方法打通任督二脉后，才能获得更高的内功修为。\n" NOR);

  }
  return 1;
}

string query_parry_msg(object weapon) {
  return parry_msg[random(sizeof(parry_msg))];
}

string query_absorb_msg() {
  return absorb_msg[random(sizeof(absorb_msg))];
}

string exert_function_file(string func)

{

  return EXERT_DIR + "jiuyang-gong/" + func;

}
