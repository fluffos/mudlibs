// buddhism.c

#include <ansi.h>



inherit SKILL;

string type() { return "knowledge"; }

int valid_learn(object me) {
  if (me->query("bellicosity") > 100)
    return notify_fail("你杀气过高，无法静下心来学习佛法");
  //    if( !me->query( "shaolin/can_read_jing" ) )
  //        return notify_fail( "你发现佛法过于艰深，难于理解，看来什么时候要去听"
  //            "听玄寂大师讲经了。");
  if (me->query("shaolin/announced"))
    return notify_fail("你由于违反戒律，感觉心中愧对佛祖，佛法难于有所长进。");
  return 1;
}

int is_knowledge() {
  return 1;
}

string query_xiuwei_type() {
  return "buddhism";
}
