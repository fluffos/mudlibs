inherit SKILL;

mapping *action = ({
  ([
    "action": "但见$n脚尖轻轻一点，一招「杯弓蛇影」，飞身从$N头顶越过。",
    "lian": "$N脚尖轻轻一点，一招「杯弓蛇影」，飞身跃起。",
    "jibie": 8,
    "sen": 3,
  ]),
  ([
    "action": "$n身形飘忽，使出一式「斗折蛇行」，忽左忽右。\n",
    "lian": "$N身形飘忽，使出一式「斗折蛇行」，忽左忽右。\n",
    "jibie": 16,
    "sen": 3,
  ]),
  ([
    "action": "$n一式「浮光掠影」，身形犹如闪电，前后左右飘浮不定。\n",
    "lian": "$N一式「浮光掠影」，身形犹如闪电，前后左右飘浮不定。\n",
    "jibie": 25,
    "sen": 3,
  ]),
  ([
    "action": "$n一招「形影不离」，斜跨出去，身形紧贴$N身后。\n",
    "lian": "$N一招「形影不离」，斜跨出去，左闪又避。\n",
    "jibie": 32,
    "sen": 2,
  ]),
  ([
    "action": "$n一招「虚无缥缈」，身形飞转，突然由一变百，难辨真假。\n",
    "lian": "$N一招「虚无缥缈」，身形飞转，突然由一变百，难辨真假。\n",
    "jibie": 42,
    "sen": 4,
  ]),
});

mapping query_action(int jibie) {
  int i, size;
  size = sizeof(action);
  for (i = 0; i < sizeof(action); i++)
    if (action[i]["jibie"] > jibie) {
      size = i;
      break;
    }
  return action[random(size)];
}

string query_xiuwei_type() {
  return "dodge";
}

int query_dengji() {
  return 5;
}

