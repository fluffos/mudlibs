inherit SKILL;

mapping *action = ({
  ([ "action": "$N手中$w斜指，一招「停车问路」，反身一顿，一刀向$n的$l撩去",
    "lian": "$N手中$w斜指，一招「停车问路」，反身一顿，一刀撩去",
    "zhaoshi": "「停车问路」",
    "jibie": 2,
    "sen": 1,
    "damage_type": "割伤"
  ]),
  ([ "action": "$N一招「童子挂画」，左右腿虚点，$w一提一收，平刃挥向$n的颈部",
    "lian": "$N一招「童子挂画」，左右腿虚点，$w一提一收，平刃挥出",
    "zhaoshi": "「童子挂画」",
    "jibie": 10,
    "sen": 1,
    "limb": "颈项",
    "damage_type": "割伤"
  ]),
  ([ "action": "$N展身虚步，提腰跃落，一招「推窗望月」，刀锋一卷，拦腰斩向$n",
    "lian": "$N展身虚步，提腰跃落，一招「推窗望月」，刀锋一卷，拦腰斩出",
    "zhaoshi": "「推窗望月」",
    "jibie": 20,
    "sen": 2,
    "limb": "腰间",
    "damage_type": "割伤"
  ]),
  ([ "action": "$N一招「开门见山」，$w大开大阖，自上而下划出一个大弧，笔直劈向$n",
    "lian": "$N一招「开门见山」，$w大开大阖，自上而下划出一个大弧，笔直劈下",
    "zhaoshi": "「开门见山」",
    "jibie": 30,
    "sen": 3,
    "limb": "肩头",
    "damage_type": "割伤"
  ]),
  ([ "action": "$N手中$w一沉，一招「临溪观鱼」，双手持刃拦腰反切，砍向$n的胸口",
    "lian": "$N手中$w一沉，一招「临溪观鱼」，双手持刃拦腰反切",
    "zhaoshi": "「临溪观鱼」",
    "jibie": 40,
    "sen": 3,
    "limb": "肋间",
    "damage_type": "割伤"
  ]),
  ([ "action": "$N挥舞$w，使出一招「张弓望的」，上劈下撩，左挡右开，齐齐罩向$n",
    "lian": "$N挥舞$w，使出一招「张弓望的」，上劈下撩，左挡右开",
    "zhaoshi": "「张弓望的」",
    "jibie": 50,
    "sen": 4,
    "damage_type": "割伤"
  ]),
  ([ "action": "$N一招「风送轻舟」，左脚跃步落地，$w顺势往前，挟风声劈向$n的$l",
    "lian": "$N一招「风送轻舟」，左脚跃步落地，$w顺势往前，挟风声劈出",
    "zhaoshi": "「风送轻舟」",
    "jibie": 87,
    "sen": 4,
    "damage_type": "割伤"
  ]),
  ([ "action": "$N盘身驻地，一招「川流不息」，挥出一片流光般的刀影，向$n的全身涌去",
    "lian": "$N盘身驻地，一招「川流不息」，挥出一片流光般的刀影",
    "zhaoshi": "「川流不息」",
    "jibie": 100,
    "sen": 4,
    "damage_type": "割伤"
  ]),
});

string *parry_msg = ({
  "$n虚步提腰，一招「推窗望月」，$v拦腰一卷，当的一声将$w荡了开去。\n",
  "$n挥舞$v，使出一招「张弓望的」，上劈下撩，左挡右开，挡了个风雨不透。\n",
  "$n手中$v一沉，一招「临溪观鱼」，双手持刃拦腰反切，刀势直取$N的手腕。\n",
  "$n使出一招「风送轻舟」，人随刀走,将$N手中$w抛在身后。\n",
});
string *unarmed_parry_msg = ({
  "$n虚步提腰，一招「推窗望月」，$v拦腰一卷，将$N逼出两丈开外。\n",
  "$n挥舞$v，使出一招「张弓望的」，上劈下撩，左挡右开，挡了个风雨不透。\n",
  "$n一招「开门见山」，$v大开大阖，当头劈下，\n$N不想两败俱伤，只得抽招换势，先求自保。\n",
  "$n盘身驻地，一招「川流不息」，挥出一片流光般的刀影，将身前封了个严严实实。\n",
});

int valid_learn(object me) {
  return 1;
}

int valid_lian(object me) {
  object ob;
  ob = me->query_temp("weapon");
  if (!ob || (string)ob->query("weapon_type") != "blade")
    return notify_fail("练刀法还是用刀来练比较容易见效，你说呢?\n");
  return valid_learn(me);
}

string query_xiuwei_type() { return "blade"; }

string query_weapon_type() { return "blade"; }

int query_dengji() { return 2; }

mapping query_action(int jibie) {
  int i, size;

  size = sizeof(action);
  for (i = 0; i < sizeof(action); i++)
    if (action[i]["jibie"] > jibie) {
      size = i;
      break;
    }
  return action[random(size)];
}

string query_parry_msg(object weapon) {
  if (weapon)
    return parry_msg[random(sizeof(parry_msg))];
  else
    return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}

string query_zhaoshi(int jibie) {
  int i;
  for (i = 0; i < sizeof(action); i++) {
    if (action[i]["jibie"] >= jibie)
      return action[i]["zhaoshi"];
  }
  return "";
}

int query_youxiao_jibie() { return 6; }

int query_parry_ratio() { return 5; }
