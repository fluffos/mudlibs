// xuanzhu-jian.c
//  玄珠剑法



inherit SKILL;
mapping *action = ({
  ([ "action":
    "$N身体立得笔直，使出一招「鸿渐于干」，手中的$w突然向$n的右肩刺了过去。",
    "lian":
    "$N身体立得笔直，使出一招「鸿渐于干」，手中的$w突然向前下方刺去。",
    "sen": 4,
    "jibie": 10,
    "dodge": 20,
    "parry": 30,
    "zhaoshi": "「鸿渐于干」",
    "damage": 80,
    "damage_type": "割伤" ]),
  ([ "action":
    "$N将身形顿住，使出一招「鸿渐于磬」，将手中$w慢慢向前递出，逼得$n直倒退。",
    "lian":
    "$N将身形顿住，使出一招「鸿渐于磬」，将手中$w慢慢向前递出。",
    "sen": 8,
    "jibie": 25,
    "dodge": 30,
    "parry": 20,
    "zhaoshi": "「鸿渐于磬」",
    "damage": 90,
    "damage_type": "割伤" ]),
  ([ "action":
    "$N身体凝住不动，使出一招「鸿渐于陆」，$w缓缓向前，直销$n的右肩。",
    "lian":
    "$N身体凝住不动，使出一招「鸿渐于陆」，$w缓缓向前销了过去。",
    "sen": 12,
    "jibie": 40,
    "dodge": 10,
    "parry": 50,
    "zhaoshi": "「鸿渐于陆」",
    "damage": 120,
    "damage_type": "割伤" ]),
  ([ "action":
    "$N身形一动不动，使出一招「鸿渐于木」，$w向上挑出，一道白光向$n头顶霹了过去。",
    "lian":
    "$N身形一动不动，使出一招「鸿渐于木」，$w向上挑出，闪出一道白光。",
    "sen": 16,
    "jibie": 55,
    "dodge": 30,
    "parry": 10,
    "zhaoshi": "「鸿渐于木」",
    "damage": 130,
    "damage_type": "割伤" ]),
  ([ "action":
    "$N身体似若虚无，使出一招「鸿渐于陵」，手中$w象是重若千钧，向$n当头压下。",
    "lian":
    "$N身体似若虚无，使出一招「鸿渐于陵」，手中$w象是重若千钧，缓缓砍下。",
    "zhaoshi": "「鸿渐于陵」",
    "sen": 20,
    "jibie": 70,
    "dodge": 40,
    "parry": 10,
    "damage": 140,
    "damage_type": "割伤"
  ]),
});

string *parry_msg = ({
  "$n似乎没有任何动作，但$N只觉得眼前一花，$n已经向旁边轻轻跃开。。\n",
  "$n手中$w往上一抬，将$N的各路尽皆封死。。\n",
  "$n往右侧一个滑步，$N的这一招落空。。\n",
  "$n将$w一抖，以攻对攻，$N顿时被逼了回去。。 \n",
});

string *unarmed_parry_msg = ({
  "$n似乎没有任何动作，但$N只觉得眼前一花，$n已经向旁边轻轻跃开。。\n",
  "$n手中$w往上一抬，将$N的各路尽皆封死。。\n",
  "$n往右侧一个滑步，$N的这一招落空。。\n",
  "$n将手腕一摔，以攻对攻，$N顿时被逼了回去。。 \n",
});

int valid_learn(object me) {
  //    object ob;
  if ((int)me->query("max_force") < 800)
    return notify_fail("你的内力不够，没有办法练玄珠剑法。\n");
  return 1;
}

int valid_lian(object me) {
  object weapon;
  weapon = me->query_temp("weapon");
  if (!weapon || weapon->query("weapon_type") != "sword")
    return notify_fail("你必须先找一把剑才能练习剑法。\n");
  return 1;
}
string query_xiuwei_type() { return "sword"; }
string query_weapon_type() { return "sword"; }

int query_dengji() { return 5; }

mapping query_action(int jibie) {
  int i, size;

  size = sizeof(action);
  for (i = 0; i < sizeof(action); i++)
    if (action[i]["jibie"] > jibie) {
      size = i;
      break;
    }
  return action[random(size)];
}

string query_parry_msg(object weapon) {
  if (weapon)
    return parry_msg[random(sizeof(parry_msg))];
  else
    return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}

string query_zhaoshi(int jibie) {
  int i;
  for (i = 0; i < sizeof(action); i++) {
    if (action[i]["jibie"] >= jibie)
      return action[i]["zhaoshi"];
  }
  return "";
}

int query_youxiao_jibie() { return 10; }

int query_parry_ratio() { return 9; }
