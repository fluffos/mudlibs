// file   :  jiujin-ci.c
// attrib :  skill
// name   :  青蜂九进刺(青城派武功，short 1)
// write  :  xli
// date   :  1998.10
// 无招无式 上、中、下各三路
#include <ansi.h>


inherit SKILL;

mapping *action = ({ /*size = 9*/
  ([ "action": "$N右手锤向$n左臂敲去，趁其抵挡之时，左手锥急刺其面门",
    "lian": "$N右手锤斜斜敲出，作势一挡，左手锥同时急刺向前",
    "jibie": 10,
    "limb": "脸部",
    "sen": 1,
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N右手锤在左手锥尾一敲，小锥顿时破空刺出，只听「哧」的一声，$n只觉一物迅急飞向面门",
    "lian": "$N右手锤在左手锥尾一敲，小锥顿时破空刺出，只听「哧」的一声，迅急无比",
    "jibie": 20,
    "limb": "眼睛",
    "sen": 1,
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N左踏一步，闪至$n侧面，左手锥向其右耳刺出，右手锤则敲其面门",
    "lian": "$N左踏一步，一个侧身，左手锥向右上方，右手锤则敲向正面",
    "jibie": 30,
    "limb": "鼻梁",
    "sen": 1,
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N身形一转，躲过$n来势，左手锥趁势刺向其肩头，右手锤跟进敲出",
    "lian": "$N身形一转，左手锥急急向斜上刺向，右手锤跟进敲出",
    "jibie": 40,
    "limb": "肩头",
    "sen": 1,
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N锥前锤后，作势向$n当胸刺去，$n挥手急挡，却不防被一锤敲中",
    "lian": "$N锥前锤后，向前刺去，全身真力却贯注于锤上敲出",
    "jibie": 50,
    "limb": "左臂",
    "sen": 1,
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N欺身至$n面前，左手锥直刺其腹部，右手锤则发力敲向其前胸",
    "lian": "$N踏步上前，左手锥直刺而出，右手锤也同时发力敲出",
    "jibie": 60,
    "limb": "小腹",
    "sen": 1,
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N右手锤作势向$n小腹敲去，趁其挡架之时，欺身至前，左手锥刺向$n大腿",
    "lian": "$N右手锤作势向中路敲去，身形则滑步上前，左手锥刺向斜下方",
    "jibie": 70,
    "limb": "大腿",
    "sen": 1,
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N就地一滚至$n腿边，左手锥直刺其右膝，右手锤发力敲向其左小腿",
    "lian": "$N就地向前一滚，左手锥向左上方刺去，右手锤发力敲向右前方",
    "jibie": 78,
    "limb": "小腿",
    "sen": 1,
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N突然一个矮身，向前冲去，右手锥直刺$n左脚，逼其跳起，左手锤则敲向$n左大腿",
    "lian": "$N突然一个矮身，向前冲去，右手锥直刺前面地面，左手锤则敲向稍上方",
    "jibie": 85,
    "limb": "大腿",
    "sen": 1,
    "damage_type": "瘀伤"
  ]),
});
string *parry_msg = ({
  "$n以锤急敲$N左臂，逼其不得不中途变招。\n",
  "$n左手锥直刺$N右手掌心，使其不得不防。\n",
});

string *unarmed_parry_msg = ({
  "$n不退不让，双臂一横，硬接$N的来势。\n",
  "$n马步一横，开声吐气，一双手将$N的来势尽数封住。\n",
});

int valid_learn(object me) {
  return 1;
}

int valid_lian(object me) {
  object ob;
  ob = me->query_temp("weapon");
  if (!ob || (string)ob->query("weapon_type") != "short" ||
    (string)ob->query("name") != BLU "雷公轰" NOR)
    return notify_fail("你必须先找一套雷公轰才能练习青蜂九进刺这门武功。\n");

  return valid_learn(me);

}

string query_xiuwei_type() { return "short"; }

string query_weapon_type() { return "short"; }

mapping query_action(int jibie) {
  int i, size;

  size = sizeof(action);
  for (i = 0; i < sizeof(action); i++)
    if (action[i]["jibie"] > jibie) {
      size = i;
      break;
    }
  return action[random(size)];
}

string query_parry_msg(object weapon) {
  if (weapon)
    return parry_msg[random(sizeof(parry_msg))];
  else
    return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}

string query_zhaoshi(int jibie) {
  int i;
  for (i = 0; i < sizeof(action); i++) {
    if (action[i]["jibie"] >= jibie)
      return action[i]["zhaoshi"];
  }
  return "";
}

int query_dengji() { return 1; }

int query_youxiao_jibie() { return 7; }

int query_parry_ratio() { return 5; }
