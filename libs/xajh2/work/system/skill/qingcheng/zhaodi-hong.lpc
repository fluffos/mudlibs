// file   :  zhaodi-hong.c
// attrib :  skill
// name   :  雷公着地轰(青城派武功，short 2)
// write  :  xli
// date   :  1998.10
// include:
// 天乾锤 地坤锥 泽兑锤 山艮锥 日离锤 月坎锥 雷震锤 风巽锥
#include <ansi.h>


inherit SKILL;

mapping *action = ({ /*size = 8*/
  ([ "action": "$N提气纵身，一式「天乾锤」，左手锤从上至下发力敲向$n的头顶",
    "lian": "$N提气纵身，一式「天乾锤」，左手锤从上至下发力敲出",
    "zhaoshi": "「天乾锤」",
    "jibie": 10,
    "sen": 3,
    "damage": 15,
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N就地一滚，右手紧握锥尾，翻腕向下，一招「地坤锥」，直刺$n脚面",
    "lian": "$N就地一滚，右手紧握锥尾，翻腕向下，一招「地坤锥」，向下直刺",
    "zhaoshi": "「地坤锥」",
    "jibie": 20,
    "sen": 3,
    "damage": 20,
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N左手上扬，平平前冲，一式「泽兑锤」，小锤直敲$n人中",
    "lian": "$N左手上扬，平平前冲，一式「泽兑锤」，小锤直敲前方",
    "zhaoshi": "「泽兑锤」",
    "jibie": 30,
    "sen": 3,
    "damage": 25,
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N移步换形，从$n身侧迅疾绕过，一招「山艮锥」，右手锥回刺$n背部",
    "lian": "$N移步换形，迅疾绕出一道弧圈，一招「山艮锥」，右手锥闪电般回刺而出",
    "zhaoshi": "「山艮锥」",
    "jibie": 40,
    "sen": 3,
    "damage": 30,
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N一式「日离锤」，右手锥在$n眼前一阵虚晃，左手锤则迅速敲向$n右眼",
    "lian": "$N一式「日离锤」，右手锥在身前一阵虚晃，左手锤则迅速向右斜上敲出",
    "zhaoshi": "「日离锤」",
    "jibie": 50,
    "sen": 3,
    "damage": 35,
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N左手锤作势敲向$n前胸，右手锥则使出一式「月坎锥」，从侧面刺向$n左耳",
    "lian": "$N左手锤作势当胸敲出，右手锥则使出一式「月坎锥」，从侧面刺出",
    "zhaoshi": "「月坎锥」",
    "jibie": 60,
    "sen": 3,
    "damage": 40,
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N身形突然一矮，内力汇聚于握锤的左手，一式「雷震锤」，敲向$n小腹",
    "lian": "$N身形突然一矮，内力汇聚于握锤的左手，一式「雷震锤」，向上敲出",
    "zhaoshi": "「雷震锤」",
    "jibie": 70,
    "sen": 4,
    "damage": 55,
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N使一式「风巽锥」，脸现飘逸神色，右手锥幻出无数锥影，刺向$n",
    "lian": "$N使一式「风巽锥」，脸现飘逸神色，右手锥幻出无数锥影，漫天刺出",
    "zhaoshi": "「风巽锥」",
    "jibie": 80,
    "sen": 5,
    "damage": 65,
    "damage_type": "刺伤"
  ]),
});

string *parry_msg = ({
  "$n看准$N来势，右手锤敲向$N的$w，硬接$N的来势。\n",
  "$n左脚向后退出一步，以卸去$N的来势，同时左手锥刺向$N的掌心，正是以攻为守。\n",
});

string *unarmed_parry_msg = ({
  "$n不退不让，双臂一横，硬接$N的来势。\n",
  "$n左脚向后退出一步，以卸去$N的来势，同时双掌发力击出。\n",
  "$n脚下扎稳马步，双手置于胸前，缓缓推出，似要将$N攻势包围于两掌之间。\n",
  "$n袍袖一挥，闪身至二尺开外，堪堪躲过$n的进攻。\n",
});

int valid_learn(object me) {
  return 1;
}

int valid_lian(object me) {
  object ob;
  ob = me->query_temp("weapon");
  if (!ob || (string)ob->query("weapon_type") != "short" ||
    (string)ob->query("name") != BLU "雷公轰" NOR)
    return notify_fail("你必须先找一套雷公轰才能练习雷公着地轰这门武功。\n");

  if (me->query("max_force") < 120)
    return notify_fail("雷公着地轰要配合一定的内力来练，你内力不足，强练会伤害身体的！\n");
  if (me->query_xiuwei_by_type("dodge") < 60)
    return notify_fail("练雷公着地轰需要一定的轻功修为，你轻功修为不够，不足以领悟其中奥妙！\n");
  if (me->query_jibie("jiujin-ci") < 60)
    return notify_fail("青城武功讲究根基扎实，你青蜂九进刺的功夫还未到一定火候，不能练习雷公着地轰！\n");
  return valid_learn(me);
}

string query_xiuwei_type() { return "short"; }

string query_weapon_type() { return "short"; }

mapping query_action(int jibie) {
  int i, size;

  size = sizeof(action);
  for (i = 0; i < sizeof(action); i++)
    if (action[i]["jibie"] > jibie) {
      size = i;
      break;
    }
  return action[random(size)];
}

string query_parry_msg(object weapon) {
  if (weapon)
    return parry_msg[random(sizeof(parry_msg))];
  else
    return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}

string query_zhaoshi(int jibie) {
  int i;
  for (i = 0; i < sizeof(action); i++) {
    if (action[i]["jibie"] >= jibie)
      return action[i]["zhaoshi"];
  }
  return "";
}

int query_dengji() { return 2; }

int query_youxiao_jibie() { return 8; }

int query_parry_ratio() { return 6; }
