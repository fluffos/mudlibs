// file   :  songfeng-quan.c
// attrib :  skill
// name   :  松风拳(青城派武功，unarmed 2)
// write  :  xli
// date   :  1998.10
// include:
// 黎明入松林  山色尚乍青  草木随风摆  狐兔皆遁形  沉思人随意  身轻心自明  抚柳有顿悟  归去研古今
// 自己写的诗，见笑见笑


inherit SKILL;

mapping *action = ({ /*size = 8*/
  ([ "action": "$N身形一闪，一式松风拳起手势「黎明入松林」，欺身至$n的面前，左手握拳击出",
    "lian": "$N身形一闪，一式松风拳起手势「黎明入松林」，踏前一步，左手握拳击出",
    "zhaoshi": "「黎明入松林」",
    "jibie": 10,
    "limb": "前胸",
    "sen": 3,
    "damage": 10,
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N左掌护胸，右手握拳，使出「山色尚乍青」，拳势似有凝涩，攻向$n",
    "lian": "$N左掌护胸，右手握拳，使出「山色尚乍青」，拳势似有凝涩，前冲而出",
    "zhaoshi": "「山色尚乍青」",
    "jibie": 20,
    "limb": "小腹",
    "sen": 3,
    "damage": 20,
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N使出「草木随风摆」，脚下扎稳马步，上身一晃，斜斜攻向$n腰部",
    "lian": "$N使出「草木随风摆」，脚下扎稳马步，上身一晃，斜斜攻出双拳",
    "zhaoshi": "「草木随风摆」",
    "jibie": 30,
    "limb": "腰部",
    "sen": 1,
    "damage": 25,
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N身形转动，使出「狐兔皆遁形」，左脚向前一步，再右脚上前，右拳顺势推向$n胸前",
    "lian": "$N身形转动，使出「狐兔皆遁形」，左脚向前一步，再右脚上前，右拳顺势推出",
    "zhaoshi": "「狐兔皆遁形」",
    "jibie": 40,
    "limb": "前胸",
    "sen": 3,
    "damage": 30,
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N使出「沉思人随意」，低头拗步，竟看也不看，掌势向$n身上随意推出",
    "lian": "$N使出「沉思人随意」，低头拗步，竟看也不看，掌势随意飘出",
    "zhaoshi": "「沉思人随意」",
    "jibie": 50,
    "sen": 3,
    "damage": 35,
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N纵身一跃，一式「身轻心自明」，左拳握紧，从上至下击向$n头部",
    "lian": "$N纵身一跃，一式「身轻心自明」，左拳握紧，从上至下击出",
    "zhaoshi": "「身轻心自明」",
    "jibie": 60,
    "limb": "头部",
    "sen": 4,
    "damage": 40,
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N欺身向前，左掌向$n肩头一搭，一式「抚柳有顿悟」，顺势一转身，右拳击向$n后心",
    "lian": "$N欺身向前，左掌作势轻搭，一式「抚柳有顿悟」，顺势一转身，右拳向来路击出",
    "zhaoshi": "「抚柳有顿悟」",
    "jibie": 70,
    "limb": "后心",
    "sen": 5,
    "damage": 45,
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N使一式「归去研古今」，袍袖一挥，闪身至$n二尺开外，双拳却运力攻向$n",
    "lian": "$N使一式「归去研古今」，袍袖一挥，闪身至二尺开外，双拳却运力攻向前方",
    "zhaoshi": "「归去研古今」",
    "jibie": 76,
    "limb": "前胸",
    "sen": 5,
    "damage": 50,
    "damage_type": "瘀伤"
  ]),
});

string *parry_msg = ({
  "$n不退不让，双臂一横，硬接$N的来势。\n",
  "$n左脚向后退出一步，以卸去$N的来势，同时发力击出。\n",
  "$n脚下扎稳马步，双手置于胸前，缓缓推出，似要将$N攻势包围于两掌之间。\n",
  "$n袍袖一挥，闪身至二尺开外，堪堪躲过$n的进攻。\n",
});

string *unarmed_parry_msg = ({
  "$n不退不让，双臂一横，硬接$N的来势。\n",
  "$n左脚向后退出一步，以卸去$N的来势，同时发力击出。\n",
  "$n脚下扎稳马步，双手置于胸前，缓缓推出，似要将$N攻势包围于两掌之间。\n",
  "$n袍袖一挥，闪身至二尺开外，堪堪躲过$n的进攻。\n",
});

int valid_learn(object me) {
  return 1;
}

int valid_lian(object me) {
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("拿着兵器怎么能练拳法呢？\n");
  if (me->query("max_force") < 120)
    return notify_fail("松风拳要配合一定的内力来练，你内力不足，强练会伤害身体的！\n");
  if (me->query_xiuwei_by_type("dodge") < 60)
    return notify_fail("练松风拳需要一定的轻功修为，你轻功修为不够，不足以领悟其中奥妙！\n");
  if (me->query_jibie("jiben-quanfa") < 40)
    return notify_fail("青城武功讲究根基扎实，你基本拳法还未到一定火候，不能练习松风拳！\n");

  return 1;
}

string query_xiuwei_type() { return "unarmed"; }

string query_weapon_type() { return "unarmed"; }

mapping query_action(int jibie) {
  int i, size;

  size = sizeof(action);
  for (i = 0; i < sizeof(action); i++)
    if (action[i]["jibie"] > jibie) {
      size = i;
      break;
    }
  return action[random(size)];
}

string query_parry_msg(object weapon) {
  if (weapon)
    return parry_msg[random(sizeof(parry_msg))];
  else
    return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}

string query_zhaoshi(int jibie) {
  int i;
  for (i = 0; i < sizeof(action); i++) {
    if (action[i]["jibie"] >= jibie)
      return action[i]["zhaoshi"];
  }
  return "";
}

int query_dengji() { return 2; }

int query_youxiao_jibie() { return 9; }

int query_parry_ratio() { return 8; }
