// filename : /cmds/imm/ls.c

#include <ansi.h>


inherit F_CLEAN_UP;
#define DIR_COLOR YEL
#define EXEC_COLOR GRN

int main(object me, string arg) {
  int i, j, w, col, width;
  string dir, ret;
  mixed *file;

  seteuid(geteuid(this_player(1)));
  dir = resolve_path(me->query("cwd"), arg);
  if (file_size(dir) == -2 && dir[strlen(dir) - 1] != '/')
    dir += "/";
  file = get_dir(dir, -1);
  if (!sizeof(file)) {
    if (file_size(dir) == -2)
      return notify_fail("目录是空的。\n");
    else
      return notify_fail("没有这个目录。\n");
  }

  i = sizeof(file);
  w = 0;
  while (i--) {
    if (strlen(file[i][0]) > w)
      w = strlen(file[i][0]) + 1;
  }
  write("目录：" + dir + "\n");
  width = (int *)me->GetScreen()[0] || 79;
  col = width / (w + 6);
  if (!col)
    col = 1;
  ret = "";
  if (sizeof(file)) {
    for (i = 0, j = sizeof(file); i < j; i++) {
      int size = file[i][1];
      ret += sprintf("%4d ", size / 1024 + 1);
      if (size == -2) {
        ret += DIR_COLOR;
        file[i][0] += "/";
      } else if (find_object(dir + file[i][0])) {
        ret += EXEC_COLOR;
        file[i][0] += "*";
      }
      ret += sprintf("%-*s", w + 1, file[i][0]);
      ret += ESC "[0m";
      if ((i + 1) % col == 0)
        ret += "\n";
    }
  } else
    write("    没有任何档案。\n");
  write(ret);
  write("\n");

  return 1;
}

int help(object me) {
  write(@HELP
指令格式: ls [<路径名>]
 
列出目录下所有的子目录及档案, 如果没有指定目录, 则列出所在目录
的内容，所列出的档案中前面标示 * 号的是已经载入的物件。
 
例如:
'ls /' 会列出所有位於根目录下的档案及子目录.
 
HELP
  );
  return 1;
}
