// kickout.c

#include <ansi.h>
#include <command.h>



inherit F_CLEAN_UP;

int main(object me, string arg) {
  object ob;
  //      string tmpstr;

  if (me != this_player(1))
    return 0;

  if (!arg || sscanf(arg, "%s", arg) != 1)
    return notify_fail("指令格式 : kickouter <某人>\n");


  // if (!wizardp (me));
  // return 0;

  ob = get_object(arg);  //LOGIN_D->find_body (arg);
  if (!ob || !userp(ob))
    return notify_fail("咦... 没有这个人?\n");

  /*if (//!living (ob)
    || !ob->is_character ()
    || ob == me)*/
  if (!userp(ob))
    return notify_fail("搞错了吧，这个怎么能踢呢？\n");

  if (wizardp(ob) && wiz_level(me) < wiz_level(ob) || ob->query("id") == "moray")
    return notify_fail("不能踢wiz的。\n");

  message_vision("\n$N被一个大脚踢出了笑傲江湖...\n", ob);
  log_file("acct/kickout", sprintf("[%s] %s(%s) kickout %s(%s).\n",
    ctime(time())[4..15], me->name(1), geteuid(me), ob->name(1),
    geteuid(ob)));

  seteuid(ROOT_UID);
  ob->save();
  destruct(ob);
  return 1;
}

int help(object me) {
  write(@HELP
指令格式:kickout < 某人>
将某人直接剔出线外.

HELP
  );
  return 1;
}
