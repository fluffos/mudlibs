// enforce.c
// qyz
// change describe and help by akuma 1999/09/09
#include <ansi.h>


inherit F_CLEAN_UP;

int main(object me, string arg) {
  int pts, factor;
  //    mapping enable_map;
  string using_force;
  string msg;

  if (!arg || (arg != "none" && !sscanf(arg, "%d", pts)))
    return notify_fail("指令格式：enforce <使出几成内力伤敌(1-10)> | <none>\n");

  if (!using_force = me->query("using_force"))
    return notify_fail("您必须先修炼（xiulian）一种特殊内功。\n");

  if (arg == "none" || pts == 0) {
    me->delete("force_factor");
    write("以后您在对战中将" RED "不使用" NOR "内力来伤敌。\n");
    return 1;
  } else {
    if (pts < 1 || pts > 10)
      return notify_fail("您只能用 none 表示不运内力，或数字表示每一击用几成内力。\n");
    factor = me->query("max_force") * pts / 100;
    me->set("force_factor", factor);
    msg = sprintf("以后您在对战中将使用" + RED + chinese_number(pts) + NOR + "成内力伤敌。\n");
    write(msg);
  }
  return 1;
}

int help(object me) {
  write(@HELP    
指令格式: enforce <使出几成内力伤敌>|<none> 

这个指令让你指定每次击中敌人时，要发出几成内力伤敌。

enforce none 则表示你不使用内力。 
HELP
  );
  return 1;
}
