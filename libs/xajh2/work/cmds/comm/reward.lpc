// reward.c
// 开奖的指令
// write by xli
// 1999.12.30
#include <ansi.h>


inherit F_CLEAN_UP;

void reward(int, object);
void create() {
  seteuid(ROOT_UID);
}

int main(object me, string arg) {
  int reward_number;
  int your_number;
  int n1, n2, n3, n4, n5, n6;
  int m1, m2, m3, m4, m5, m6;
  int reward_level = 6;  //奖的级别 0是特等奖，1是一等奖，依此类推，最低5等奖，所以预设为6

  if (me != this_player(1)) return 0;
  if (arg)
    tell_object(me, "请直接使用reward指令即可。\n");

  //这里需要有一个函数从/log/find_pig/reward_number文件中读取数字
  //先预设用以测试
  reward_number = PIG_D->do_read_number();
  if (!reward_number) {
    tell_object(me, "抽奖还没有开始呢，急什么啊？\n");
    return 1;
  }

  your_number = (int)me->query("xli/find_zhu/ticket_number");  //得到你填的号码
  if (your_number == 0) {
    tell_object(me, "你并没有填写彩票啊！\n");
    return 1;
  }

  if (me->query("xli/find_zhu/have_reward")) {
    tell_object(me, "你已经对过奖了，还想再来一次是不可能的哦！\n");
    return 1;
  }
  tell_object(me, "宝宝贝贝拍着宝贝猪迅速地赶到了你的面前。\n");
  tell_object(me, "宝宝贝贝说道：稍候，这就给你对奖。\n");
  n1 = reward_number / 100000; reward_number = reward_number - n1 * 100000;
  n2 = reward_number / 10000; reward_number = reward_number - n2 * 10000;
  n3 = reward_number / 1000; reward_number = reward_number - n3 * 1000;
  n4 = reward_number / 100; reward_number = reward_number - n4 * 100;
  n5 = reward_number / 10; reward_number = reward_number - n5 * 10;
  n6 = reward_number;

  m1 = your_number / 100000; your_number = your_number - m1 * 100000;
  m2 = your_number / 10000; your_number = your_number - m2 * 10000;
  m3 = your_number / 1000; your_number = your_number - m3 * 1000;
  m4 = your_number / 100; your_number = your_number - m4 * 100;
  m5 = your_number / 10; your_number = your_number - m5 * 10;
  m6 = your_number;

  tell_object(me, "本次中奖的号码是：" + sprintf("  %d  %d  %d  %d  %d  %d\n", n1, n2, n3, n4, n5, n6));
  tell_object(me, "你填彩票的号码是：" + sprintf("  %d  %d  %d  %d  %d  %d\n", m1, m2, m3, m4, m5, m6));

  if (n1 == m1)
    reward_level--;
  if (n2 == m2)
    reward_level--;
  if (n3 == m3)
    reward_level--;
  if (n4 == m4)
    reward_level--;
  if (n5 == m5)
    reward_level--;
  if (n6 == m6)
    reward_level--;

  reward(reward_level, me);
  me->set("xli/find_zhu/have_reward", 1);  // 做个已经得到奖励的标记
  tell_object(me, "宝宝贝贝一拍猪背，宝贝猪撒开四条腿，立刻跑的没有踪影了。\n");
  return 1;

}

void reward(int reward_level, object who) {
  int highest_xiuwei, reward_xiuwei_number, now_neili, reward_neili_number;
  int now_jingyan, reward_jingyan;
  string reward_xiuwei_type;
  int before_jibie, end_jibie, level;
  string use_force;
  object money;
  object thing;
  string logstr;

  if (reward_level > 5) {
    tell_object(who, "很遗憾，你所填写的号码没有一个对上了我们的中奖号码。\n");
    if (random(10) > 4) {
      tell_object(who, "不过为了奖励你参加我们的活动，特赠送5两银子作为对你的感谢。\n");
      money = new("/clone/money/silver");
      money->set_amount(5);
      money->move(who);
    }
    return;
  }

  switch (reward_level) {
    case 0:  //特等奖
      //加最高修为
      highest_xiuwei = who->query_xiuwei_by_type("unarmed");
      reward_xiuwei_type = "unarmed";
      if (highest_xiuwei < who->query_xiuwei_by_type("sword")) {
        highest_xiuwei = who->query_xiuwei_by_type("sword");
        reward_xiuwei_type = "sword";
      }
      if (highest_xiuwei < who->query_xiuwei_by_type("blade")) {
        highest_xiuwei = who->query_xiuwei_by_type("blade");
        reward_xiuwei_type = "blade";
      }
      if (highest_xiuwei < who->query_xiuwei_by_type("whip")) {
        highest_xiuwei = who->query_xiuwei_by_type("whip");
        reward_xiuwei_type = "blade";
      }
      if (highest_xiuwei == 0)  //纯新手
      {
        switch (random(4)) {
          case 0: reward_xiuwei_type = "unarmed"; break;
          case 1: reward_xiuwei_type = "sword"; break;
          case 2: reward_xiuwei_type = "blade"; break;
          case 3: reward_xiuwei_type = "whip"; break;
        }
      }
      reward_xiuwei_number = highest_xiuwei / 2;
      if (reward_xiuwei_number < 2000)
        reward_xiuwei_number = 2000;
      who->set_xiuwei_by_type(reward_xiuwei_type, highest_xiuwei + reward_xiuwei_number);

      //加内力
      now_neili = who->query("max_force");
      reward_neili_number = now_neili / 2;
      if (reward_neili_number < 1000)
        reward_neili_number = 1000;
      who->set("max_force", now_neili + reward_neili_number);

      //提升内功等级
      use_force = who->query("using_force");
      if (!use_force)  //纯新手，没有内功
        use_force = "haoran-zhengqi";  //最常见的那种
        before_jibie = who->query_jibie(use_force);
      level = (int)SKILL_D(use_force)->query_level();
      end_jibie = who->query("max_force") / 10;
      end_jibie = end_jibie - who->query("con") / 3;
      end_jibie = end_jibie * 2 / level;
      // end_jibie=end_jibie*10/9;
      who->set_wugong(use_force, end_jibie, end_jibie * 9 / 10, 1);

      //提升实战经验
      now_jingyan = who->query("combat_exp");
      reward_jingyan = now_jingyan / 2;
      if (reward_jingyan < 50000)
        reward_jingyan = 50000;
      who->set("combat_exp", now_jingyan + reward_jingyan);

      //提升资质
      who->add("str", 10); who->add("cor", 10); who->add("int", 10);
      who->add("per", 10); who->add("spi", 10); who->add("cps", 10);
      who->add("dex", 10); who->add("con", 10); who->add("kar", 10);

      logstr = "特等奖\n" + who->query("name") + "获得特等奖。";
      logstr += "奖励如下：\n";
      logstr += reward_xiuwei_type + "修为： 由";
      logstr += sprintf("%d  改为  %d。\n", highest_xiuwei, reward_xiuwei_number + highest_xiuwei);
      logstr += "内力：  由";
      logstr += sprintf("%d  改为  %d\n", now_neili, now_neili + reward_neili_number);
      logstr += use_force + "内功等级： 修改为";
      logstr += sprintf("%d级\n", end_jibie);
      logstr += "实战经验：  由";
      logstr += sprintf("%d  改为  %d\n", now_jingyan, now_jingyan + reward_jingyan);
      logstr += "各项资质提升10点。\n";
      log_file("find_pig/pig_reward", sprintf("[%s] \n%s\n", ctime(time())[0..15], logstr));
      LOG_D->do_log(who, "你在千禧寻“猪”活动中得到了特等奖！");

      logstr = "        *************************************************\n";
      logstr += "        宝宝贝贝大声向大家宣布：\n";
      logstr += RED "                      " + who->query("name") + "（" + who->query("id") + "）" NOR + "\n";
      logstr += "        在" + "《畅游笑傲  千禧寻“" + MAG + "猪" NOR + "”大派送》活动中\n";
      logstr += "        一举夺魁，获得了" + BLU "特等奖" NOR + "！！！！！！！\n";
      logstr += "        按照本次活动规定，特给予" + who->query("name") + "应得之各项奖励。\n";
      logstr += "        同时" + who->query("name") + "也可以得到笑傲江湖现任巫师签名合影玉照一张。*_^\n";
      logstr += "        请找LNWM索要。\n";
      logstr += "        *************************************************\n";
      message("shout", logstr, users());

      break;

    case 1:  //一等奖
      //加最高修为
      highest_xiuwei = who->query_xiuwei_by_type("unarmed");
      reward_xiuwei_type = "unarmed";
      if (highest_xiuwei < who->query_xiuwei_by_type("sword")) {
        highest_xiuwei = who->query_xiuwei_by_type("sword");
        reward_xiuwei_type = "sword";
      }
      if (highest_xiuwei < who->query_xiuwei_by_type("blade")) {
        highest_xiuwei = who->query_xiuwei_by_type("blade");
        reward_xiuwei_type = "blade";
      }
      if (highest_xiuwei < who->query_xiuwei_by_type("whip")) {
        highest_xiuwei = who->query_xiuwei_by_type("whip");
        reward_xiuwei_type = "blade";
      }
      if (highest_xiuwei == 0)  //纯新手
      {
        switch (random(4)) {
          case 0: reward_xiuwei_type = "unarmed"; break;
          case 1: reward_xiuwei_type = "sword"; break;
          case 2: reward_xiuwei_type = "blade"; break;
          case 3: reward_xiuwei_type = "whip"; break;
        }
      }
      reward_xiuwei_number = highest_xiuwei * 3 / 10;
      if (reward_xiuwei_number < 1200)
        reward_xiuwei_number = 1200;
      who->set_xiuwei_by_type(reward_xiuwei_type, highest_xiuwei + reward_xiuwei_number);

      //加内力
      now_neili = who->query("max_force");
      reward_neili_number = now_neili * 3 / 10;
      if (reward_neili_number < 600)
        reward_neili_number = 600;
      who->set("max_force", now_neili + reward_neili_number);

      //提升内功等级
      use_force = who->query("using_force");
      if (!use_force)  //纯新手，没有内功
        use_force = "haoran-zhengqi";  //最常见的那种

        before_jibie = who->query_jibie(use_force);
      level = (int)SKILL_D(use_force)->query_level();
      end_jibie = who->query("max_force") / 10;
      end_jibie = end_jibie - who->query("con") / 3;
      end_jibie = end_jibie * 2 / level;
      // end_jibie=end_jibie*10/9;
      who->set_wugong(use_force, end_jibie, end_jibie * 9 / 10, 1);

      //提升实战经验
      now_jingyan = who->query("combat_exp");
      reward_jingyan = now_jingyan * 3 / 10;
      if (reward_jingyan < 30000)
        reward_jingyan = 30000;
      who->set("combat_exp", now_jingyan + reward_jingyan);

      //提升资质
      who->add("str", 6); who->add("cor", 6); who->add("int", 6);
      who->add("per", 6); who->add("spi", 6); who->add("cps", 6);
      who->add("dex", 6); who->add("con", 6); who->add("kar", 6);

      logstr = "一等奖\n" + who->query("name") + "获得一等奖。";
      logstr += "奖励如下：\n";
      logstr += reward_xiuwei_type + "修为： 由";
      logstr += sprintf("%d  改为  %d。\n", highest_xiuwei, reward_xiuwei_number + highest_xiuwei);
      logstr += "内力：  由";
      logstr += sprintf("%d  改为  %d\n", now_neili, now_neili + reward_neili_number);
      logstr += use_force + "内功等级： 修改为";
      logstr += sprintf("%d级\n", end_jibie);
      logstr += "实战经验：  由";
      logstr += sprintf("%d  改为  %d\n", now_jingyan, now_jingyan + reward_jingyan);
      logstr += "各项资质提升6点。\n";

      log_file("find_pig/pig_reward", sprintf("[%s] \n%s\n", ctime(time())[0..15], logstr));
      LOG_D->do_log(who, "你在千禧寻“猪”活动中得到了一等奖！");
      logstr = "        *************************************************\n";
      logstr += "        宝宝贝贝大声向大家宣布：\n";
      logstr += RED "                      " + who->query("name") + "（" + who->query("id") + "）" NOR + "\n";
      logstr += "        在" + "《畅游笑傲  千禧寻“" + MAG + "猪" NOR + "”大派送》活动中\n";
      logstr += "        一举夺魁，获得了" + BLU "一等奖" NOR + "！！！！！！！\n";
      logstr += "        按照本次活动规定，特给予" + who->query("name") + "应得之各项奖励。\n";
      logstr += "        同时" + who->query("name") + "也可以得到笑傲江湖现任巫师签名合影玉照一张。*_^\n";
      logstr += "        请找LNWM索要。\n";
      logstr += "        *************************************************\n";
      message("shout", logstr, users());
      break;

    case 2:  //二等奖  得到修改rank_info中信息的机会
      tell_object(who, "恭喜你啊，你得到了二等奖，可以找巫师要求修改某些特定的信息！\n");
      LOG_D->do_log(who, "你得到了千禧寻猪活动的二等奖，可以找巫师要求修改某些特定信息。");
      break;

    case 3:  //三等奖      得到一件可以autoload的物品，靴子。
      thing = new("/d/place/game/npc/obj/boot");
      thing->move(who);
      tell_object(who, "你得到了三等奖，宝宝贝贝特意送给你一双皮靴，可是为你度身定做的哦！\n");
      LOG_D->do_log(who, "你得到了千禧寻猪活动的三等奖，可以拥有一双自己的皮靴。");
      break;

    case 4:  //四等奖      得到小礼物，喜饼。
      thing = new("/d/place/game/npc/obj/xibing");
      thing->move(who);
      tell_object(who, "你得到了四等奖，宝宝贝贝送给你一个喜饼，你可以用write来写祝福的话来给你想送的人。\n");
      LOG_D->do_log(who, "你得到了千禧寻猪活动的四等奖，得到了一个可以送给别人的喜饼。");
      break;

    case 5:  //五等奖      表示一下，如让小猪kiss一口。
      if (who->query("gender") == "女性") {
        tell_object(who, "宝宝贝贝凑到你面前，“叭”的一声亲了你一下。\n");
        tell_object(who, "宝宝贝贝抹着嘴说道：味道好极了！\n");
      } else
        tell_object(who, "宝宝贝贝用力拍了你两下，说道：“虽然是个五等奖，也很不容易了！”\n");
      if (random(5) > 0) {
        money = new("/clone/money/silver");
        money->set_amount(10);
        money->move(who);
        tell_object(who, "宝宝贝贝从宝贝猪身上拔下一根猪毛，迎风一晃，变成了一锭十两的银子，递给了你。\n");
      }
      if (random(10) == 3) {
        thing = new("/d/place/game/npc/obj/xibing");
        thing->move(who);
        tell_object(who, "宝宝贝贝送给你一个喜饼，你可以用write来写祝福的话来给你想送的人。\n");
        LOG_D->do_log(who, "你额外得到了千禧寻猪活动的四等奖，有一个可以送给别人的喜饼。");
      }
      break;

  }
}




int help(object me) {
  write(@HELP
指令格式 : reward
 
这个指令用来在《畅游笑傲  千禧寻“猪”大派送》活动中进行开奖。
 
HELP
  );
  return 1;
}
