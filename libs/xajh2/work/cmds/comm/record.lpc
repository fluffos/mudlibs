// record.c
// by qyz
// modified by trill

#include <ansi.h>



inherit F_CLEAN_UP;

void create() {
  seteuid(getuid());
}

int main(object me, string arg) {
  if ((int)me->query("last_record") == (int)me->query("age"))
    return notify_fail("这一年的记录你已经写了。\n");

  if (!arg) return notify_fail("你要记录什么？\n");

  if (strlen(arg) > 50)
    return notify_fail("你的记录太长了.\n");

  if (LOG_D->do_record(me, arg)) {
    write("OK.\n");
    if (!wizardp(me))
      me->set("last_record", (int)me->query("age"));
  } else
    write("record fail\n");
  return 1;
}

int help(object me) {
  write(@HELP
指令格式 : record < 记录内容 >

用途 : 你能通过这个命令来记录你辉煌的一生，但是请记住，你每长一岁
       只能记录一次，所以在记录的时候请你慎重。

相关指令：log
HELP
  );
  return 1;
}
