inherit F_CLEAN_UP;
void create() {
  seteuid(getuid());
}

int main(object me) {
  string msg;
  string *names;
  mapping pker;
  int i;
  pker = me->query("pks");
  msg = "";
  if (mapp(pker)) {
    names = keys(pker);
    for (i = 0; i < sizeof(names); i++) {
      msg += names[i] + "，" + pker[names[i]] + "\n";
    }
    me->start_more(msg);
    return 1;
  }
}

int help(object me) {
  write(@HELP
指令格式 : pkers 
 
muchlove，-1
teste，4

-1 说明杀了 muchlove 一次
 4 说明被 teste 杀了四次
 
查看总共玩游戏的时间。
HELP
  );
  return 1;
}
