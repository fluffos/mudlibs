// hide.c
// by Qyz
//last change by akuma 1999/9/16

#include <ansi.h>



inherit F_CLEAN_UP;

int main(object me, string arg) {
  string skill;
  string *sname;
  int i;
  mapping m_jibie;
  seteuid(getuid());

  if (!arg) {
    return notify_fail("指令格式：hide <武功名称>\n");
  }

  if (sscanf(arg, "%s", skill) != 1)
    return notify_fail("指令格式：hide <技能名称>\n");

  if (skill == "all") {
    m_jibie = me->query_jibie_map();
    if (!sizeof(m_jibie)) {
      write("对你来说用不用这个命令都没关系吧。\n");
      return 1;
    }
    sname = sort_array(keys(m_jibie), (: strcmp :));
    for (i = 0; i < sizeof(sname); i++)
      me->hide_skill(sname[i]);
    write("OK.\n");
    return 1;
  }

  if (!me->valid_skill(skill))
    return notify_fail("您不会这门武功。\n");

  if (!me->hide_skill(skill))
    return notify_fail("您无法隐藏这门武功。\n");

  write("以后将把 " + GRN + to_chinese(skill) + "(" + skill + ")" + NOR + " 隐藏起来不再显示。\n");
  return 1;
}

int help(object me) {
  write(@HELP
指令格式 : hide <技能名称>
或者 hide all

这个指令让您在使用 skills 指令来显示武功信息的时候隐藏起那些不重
要的功夫，当然，该功夫对您而言并不是不存在了。无论何时，您都可以
用skills -a来显示所有武功，或者用 display <技能名称> 来解除。
 
see also : display, skills

HELP
  );
  return 1;
}
