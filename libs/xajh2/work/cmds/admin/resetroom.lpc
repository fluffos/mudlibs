// Filename : /cmds/admin/resetroom.c



inherit F_CLEAN_UP;

int main(object me, string file) {
  object obj;

  seteuid(geteuid(me));
  file = resolve_path(me->query("cwd"), file);
  if (!sscanf(file, "%*s.lpc")) file += ".lpc";
  if (file_size(file) == -1)
    return notify_fail("没有这个文件。\n");
  obj = find_object(file);
  if (!obj)
    obj = load_object(file);
  obj->reset();
  write("OK.\n");
  return 1;
}

int help(object me) {
  write(@HELP
指令格式 : resetroom <档名>

测试指令用来调用object->reset()指令. 若目标为
'here' 则reset当前环境.
HELP
  );
  return 1;
}
