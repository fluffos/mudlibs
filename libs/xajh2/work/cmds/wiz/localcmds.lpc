// localcmds.c



inherit F_CLEAN_UP;

int main(object me, string arg) {
  mixed *cmds;

  cmds = me->query_commands();
  write("你身上及四周的物品与所在的环境提供以下指令：\n");
  foreach (mixed cmd in cmds)
    printf("%-15s  %2d %-20O %O\n", cmd[0], cmd[1], cmd[2], cmd[3]);

  return 1;
}

int help() {
  write(@TEXT
指令格式：localcmds

列出你身上及四周的物品与所在的环境提供的所有指令。
TEXT
  );
  return 1;
}
