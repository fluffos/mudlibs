void create() { seteuid(getuid()); }

mixed main(object me, string arg) {
  object obj;
  mixed result;

  if (!arg)
    result = look_room(environment(me));
  else if ((obj = present(arg, me)) ||
    (obj = present(arg, environment(me)))) {
    if (obj->is_character())
      result = look_living(me, obj);
    else
      result = look_item(me, obj);
  } else
    result = look_room_item(me, arg);

  return result;
}

mixed look_room(object env) {
  return this_player()->eventDescribeEnv(env, 0);
}

int look_item(object me, object obj) {
  mixed *inv;

  this_player()->start_more(obj->long());
  inv = all_inventory(obj);
  if (sizeof(inv)) {
    inv = map_array(inv, "inventory_look", this_object());
    message("vision", sprintf("里面有：\n  %s\n",
      implode(inv, "\n  ")), me);
  }
  return 1;
}

string per_status_msg(int per, string gender, string race, int age) {
  if (race == "人类") {
    if (gender == "男性") {
      if (age > 60)
        if (per > 20)
          return (per_msg_male61[random(sizeof(per_msg_male61))]);
        else
          return (per_msg_male62[random(sizeof(per_msg_male62))]);
      if (age < 16)
        return (per_msg_male0[random(sizeof(per_msg_male0))]);
      if (per >= 40)
        return (per_msg_male7[random(sizeof(per_msg_male7))]);
      else if (per >= 35)
        return (per_msg_male6[random(sizeof(per_msg_male6))]);
      else if (per >= 30)
        return (per_msg_male4[random(sizeof(per_msg_male4))]);
      else if (per >= 25)
        return (per_msg_male1[random(sizeof(per_msg_male1))]);
      else if (per >= 20)
        return (per_msg_male2[random(sizeof(per_msg_male2))]);
      else if (per >= 15)
        return (per_msg_male3[random(sizeof(per_msg_male3))]);
      else if (per < 15)
        return (per_msg_male5[random(sizeof(per_msg_male5))]);
    }
    if (gender == "无性") {
      if (age > 65)
        if (per > 20)
          return (per_msg_nmale61[random(sizeof(per_msg_nmale61))]);
        else
          return (per_msg_nmale62[random(sizeof(per_msg_nmale62))]);
      if (age < 16)
        return (per_msg_nmale0[random(sizeof(per_msg_nmale0))]);
      if (per >= 40)
        return (per_msg_nmale7[random(sizeof(per_msg_nmale7))]);
      else if (per >= 35)
        return (per_msg_nmale6[random(sizeof(per_msg_nmale6))]);
      else if (per >= 30)
        return (per_msg_nmale4[random(sizeof(per_msg_nmale4))]);
      else if (per >= 25)
        return (per_msg_nmale1[random(sizeof(per_msg_nmale1))]);
      else if (per >= 20)
        return (per_msg_nmale2[random(sizeof(per_msg_nmale2))]);
      else if (per >= 15)
        return (per_msg_nmale3[random(sizeof(per_msg_nmale3))]);
      else if (per < 15)
        return (per_msg_nmale5[random(sizeof(per_msg_nmale5))]);
    }
    if (gender == "女性") {
      if (age > 65)
        if (per > 20)
          return (per_msg_female61[random(sizeof(per_msg_female61))]);
        else
          return (per_msg_female62[random(sizeof(per_msg_female62))]);
      if (age < 16)
        return (per_msg_female0[random(sizeof(per_msg_female0))]);
      if (per >= 45)
        return (per_msg_female7[random(sizeof(per_msg_female7))]);
      else if (per >= 40)
        return (per_msg_female6[random(sizeof(per_msg_female6))]);
      else if (per >= 35)
        return (per_msg_female4[random(sizeof(per_msg_female4))]);
      else if (per >= 30)
        return (per_msg_female1[random(sizeof(per_msg_female1))]);
      else if (per >= 25)
        return (per_msg_female2[random(sizeof(per_msg_female2))]);
      else if (per >= 20)
        return (per_msg_female3[random(sizeof(per_msg_female3))]);
      else if (per < 20)
        return (per_msg_female5[random(sizeof(per_msg_female5))]);
    }
  } else if (race == "野兽") {
    if (per >= 25)
      return (per_msg_beast1[random(sizeof(per_msg_beast1))]);
    else if (per >= 20)
      return (per_msg_beast2[random(sizeof(per_msg_beast2))]);
    else if (per < 20)
      return (per_msg_beast3[random(sizeof(per_msg_beast3))]);
  }
}

string gettof(object ob) {
  object me;
  int attack_points, me_attack_points;
  ob->select_attack_action();
  ob->select_parry_action();
  ob->select_dodge_action();
  me = this_player();

  attack_points = COMBAT_D->wugong_power(ob, ob->query_temp("attack_skill"), TYPE_ATTACK);
  attack_points += COMBAT_D->wugong_power(ob, ob->query_temp("parry_skill"), TYPE_PARRY);
  attack_points += COMBAT_D->wugong_power(ob, ob->query_temp("dodge_skill"), TYPE_DODGE);

  me_attack_points = COMBAT_D->power(me, me->query_temp("attack_skill"), TYPE_ATTACK);
  me_attack_points += COMBAT_D->power(me, me->query_temp("parry_skill"), TYPE_PARRY);
  me_attack_points += COMBAT_D->power(me, me->query_temp("dodge_skill"), TYPE_DODGE);
  return tough_level(attack_points, 0);
}

int look_living(object me, object obj) {
  string str, pro, gender, race;
  string *zuzhi_id;
  int i, age;
  mixed *inv;
  mapping my_fam, fam;

  if (me != obj)
    message("vision", HIG "" + me->name() +
      "正盯著你看，不知道打些什么主意。\n" NOR, obj);
  str = obj->long();
  if (obj->query_temp_marks("apply/age")) {
    gender = obj->query_temp_marks("apply/gender");
    age = obj->query_temp_marks("apply/age");
    race = obj->query_temp_marks("apply/race");
  } else {
    gender = obj->query("gender");
    age = obj->query_age();
    //   age = obj->query("age");
    race = obj->query("race");
  }
  pro = (obj == me) ? gender_self(gender) : gender_pronoun(gender);
  if (me->query("have_married/id") == obj->query("id"))
    str += sprintf("%s是你的伴侣。\n", pro);
  if ((string)race == "人类" && intp(age)) {
    str += sprintf("%s看起来约%s多岁。\n", pro,
      chinese_number(age / 10 * 10));
    str += sprintf("%s的武功看上去似乎是", pro);
    str += gettof(obj);
    str += "，";
    str += sprintf("出手好象");
    str += getdam(obj);
    str += sprintf("。\n");
  }

  // If we both has family, check if we have any relations.
  if (obj != me && !obj->query_temp_marks("apply/age") &&
    mapp(fam = obj->query("family")) &&
    mapp(my_fam = me->query("family")) &&
    fam["family_name"] == my_fam["family_name"]) {
    if (fam["generation"] == my_fam["generation"]) {
      if ((string)gender == "男性" ||
        (string)gender == "无性") {
        str += sprintf(pro + "是你的%s%s。\n",
          my_fam["master_id"] == fam["master_id"] ? "" : "同门",
          (my_fam["enter_time"] > fam["enter_time"] || !userp(obj)) ? "师兄" : "师弟");
      } else
        str += sprintf(pro + "是你的%s%s。\n",
          my_fam["master_id"] == fam["master_id"] ? "" : "同门",
          (my_fam["enter_time"] > fam["enter_time"] || !userp(obj)) ? "师姐" : "师妹");
    } else if (fam["generation"] < my_fam["generation"]) {
      if (my_fam["master_id"] == obj->query("id"))
        str += pro + "是你的师父。\n";
      else if (my_fam["generation"] - fam["generation"] > 1)
        str += pro + "是你的同门长辈。\n";
      else if (fam["enter_time"] < my_fam["enter_time"])
        str += pro + "是你的师伯。\n";
      else
        str += pro + "是你的师叔。\n";
    } else {
      if (fam["generation"] - my_fam["generation"] > 1)
        str += pro + "是你的同门晚辈。\n";
      else if (fam["master_id"] == me->query("id"))
        str += pro + "是你的弟子。\n";
      else
        str += pro + "是你的师侄。\n";
    }
  }
  // Lin add zuzhilook.
  if (obj != me && obj->JoinedZuzhiNumber() && me->JoinedZuzhiNumber()) {
    zuzhi_id = obj->GetZuzhiId();
    for (i = 0; i < sizeof(zuzhi_id); i++)
      if (me->IsBossOf(obj, zuzhi_id[i]))
        str += pro + "是你在" + obj->ZuzhiName(zuzhi_id[i]) + "中的下级，现在是一名" + obj->ZuzhiTouxian(zuzhi_id[i]) + "。\n";
  }

  if (obj->query("max_kee")) {
    int eff_kee, max_kee;
    eff_kee = obj->query("eff_kee");
    max_kee = obj->query("max_kee");
    str += pro + COMBAT_D->eff_status_msg(eff_kee * 100 / max_kee) + "\n";
  }

  // 如果是野兽，就没有相貌。 尸体也没有相貌的啦.     
  if ((race != "野兽") && !obj->is_corpse())
    str += pro + per_status_msg((int)obj->query_per(),
      gender, race, age);

  inv = all_inventory(obj);

  if (sizeof(inv)) {
    inv = map_array(inv, "inventory_look", this_object(),
      obj->is_corpse() ? 0 : 1);
    inv -= ({ 0 });
    if (sizeof(inv))
      str += sprintf(obj->is_corpse() ?
        "%s的遗物有：\n%s\n" : "%s身上带着：\n%s\n",
        pro, implode(inv, "\n"));
  }

  //判断这个人是否骑了马
  if (obj->query_temp_marks("is_riding") != 0)
    str += pro + "正骑着一" + obj->query_temp_marks("is_riding") + "。\n";

  message("vision", str, me);

  if (obj != me &&
    living(obj) &&
    random((int)obj->query("bellicosity") / 10) > (int)me->query("per")) {
    write(obj->name() + "突然转过头来瞪你一眼。\n");
    COMBAT_D->auto_fight(obj, me, "berserk");
  }

  if (obj != me && living(obj) && obj->query("positive_score") > 5000)
    write(CYN "" + obj->name() + "「哈哈哈．．．．」地干笑了几声。\n" NOR);
  else if (obj != me && living(obj) && obj->query("negative_score") > 5000)
    write(CYN "" + obj->name() + "「嘿嘿嘿．．．．」地奸笑了几声。\n" NOR);
  if (me->query("have_married/id") == obj->query("id") && obj->query("gender") == "男性")
    message_vision(CYN "$N喜不自禁，将$n深深拥在怀里,只原天地宇宙,万世不变。\n" NOR, obj, me);
  else if (me->query("have_married/id") == obj->query("id") && obj->query("gender") == "女性")
    message_vision(CYN "$N轻轻的偎依在$n的怀里，容颜里笑容淡淡，眼波处柔情流转。\n$N轻声地吟道：“但愿君心似我心，定不负相思意!”\n" NOR, obj, me);
  else {
    if (userp(obj) && living(obj)) {
      if (gender == "女性" && obj != me)
        if (age <= 40)
          message_vision(CYN "$N羞涩地一低头，非常小声地哼道：“你不要这样的看着我，我的脸会变成红苹果。”\n" NOR, obj);
        else
          message_vision(CYN "$N看了$n一眼，疑惑的问道：“请问有何贵干？”\n" NOR, obj, me);
      if (obj->query("id") == "glad")
        message_vision(CYN "$N憋红了小脸，对$n说道：再看，再看，再看我就吃了你！\n" NOR, obj, me);
      if (gender != "女性" && obj != me)
        if (obj->query("per") < 10 && age < 30)
          message_vision(CYN "$N正言道：“男子汉大丈夫，第一论人品心肠，第二论才干事业，第三论文学武功。脸\n蛋儿俊不俊，有什么相干?\n" NOR, obj);
        else if (age <= 40)
          message_vision(CYN "$N白了$n一眼，嚷道：“看什么看？！没见过帅哥啊？？！！”\n" NOR, obj, me);
        else
          message_vision(CYN "$N看了$n一眼，疑惑的问道：“请问有何贵干？”\n" NOR, obj, me);
    }
  }
  return 1;
}

string inventory_look(object obj, int flag) {
  string str;

  str = obj->short();
  if (obj->is_equipped())
    str = HIC "  ☆" NOR + str;
  else if (!flag)
    str = "    " + str;
  else
    return 0;

  return str;
}

int look_room_item(object me, string arg) {
  object env;
  mapping item, exits;

  if (!objectp(env = environment(me)))
    return notify_fail("这里只有灰蒙蒙地一片，什么也没有。找巫师把你带出来吧。\n");
  item = env->query("item_desc");
  if (mapp(item) && !undefinedp(item[arg])) {
    if (stringp(item[arg]))
      write(item[arg]);
    else if (functionp(item[arg])) {
      write((string)(* item[arg])(me));
    }
    return 1;
  }
  exits = env->query("exits");
  if (mapp(exits) && !undefinedp(exits[arg])) {
    if (objectp(env = find_object(exits[arg])))
      look_room(env);
    else {
      if (file_size(sscanf(exits[arg], "%*s.lpc") ? exits[arg] : exits[arg] + ".lpc") == -1)
        return notify_fail("那边什么都没有，还是不要看了。\n");
      if (!exits[arg])
        return notify_fail("找不到此方向\n");
      call_other(exits[arg], "???");
      look_room(find_object(exits[arg]));
    }
    return 1;
  }
  // Look specific object in the room
  if (arg) {
    string detail;
    detail = env->query("detail/" + arg, 1);
    if (stringp(detail)) {
      write(detail);
      return 1;
    } else if (functionp(detail)) {
      mixed result;
      result = evaluate(detail, me);
      if (stringp(result))
        write(result);
      return result;
    }
    if (stringp(env->query("long")))
      if (strsrch(env->query("long"), arg) >= 0)
        return notify_fail("你看不出这里的" + arg + "有什么特别之处\n");
  }
  return notify_fail("你要看什么？\n");
}

string tough_level(int power, int hide_level) {

  //      int lvl, rawlvl;
  string *tough_level_desc = ({
    BLU "不堪一击" NOR, BLU "毫不足虑" NOR, HIB "初出茅庐" NOR, HIB "粗通皮毛" NOR,
    MAG "马马虎虎" NOR, MAG "略有小成" NOR, HIM "融会贯通" NOR, HIM "炉火纯青" NOR,
    YEL "已有大成" NOR, YEL "出类拔萃" NOR, HIY "技冠群雄" NOR, HIY "出神入化" NOR,
    CYN "傲视群雄" NOR, CYN "登峰造极" NOR, HIC "神功盖世" NOR, HIC "举世无双" NOR,
    HIG "空前绝后" NOR, HIR "天人合一" NOR, HIW "深藏不露" NOR, HIW "笑傲江湖" NOR
  });

  int lvl;
  int rawlvl;
  int grade = 1;
  if (power < 0) power = 0;
  rawlvl = (int)pow(power, 0.2);
  lvl = to_int(rawlvl / grade);
  if (lvl >= sizeof(tough_level_desc))
    lvl = sizeof(tough_level_desc) - 1;
  return tough_level_desc[((int)lvl)];
}

string getdam(object obj) {
  object weapon;
  int level, ff;
  string *heavy_level_desc = ({
    WHT "极轻" NOR,
    YEL "较轻" NOR,
    CYN "不轻" NOR,
    HIC "较重" NOR,
    HIY "很重" NOR,
    HIW "极重" NOR,
  });

  ff = obj->query("force_factor") * 101 / (obj->query("max_force") + 1) / 2;

  weapon = obj->query_temp("weapon");
  if (weapon)
    ff++;

  level = ff;

  if (level >= sizeof(heavy_level_desc))
    level = sizeof(heavy_level_desc) - 1;
  return heavy_level_desc[((int)level)];
}

int help(object me) {
  write(@HELP
指令格式: look [<物品>|<生物>|<方向>]
 
这个指令让你查看你所在的环境、某件物品、生物、或是方向。
符号说明：ヵ　转世，す　和平，ズ　仇杀，ヲ　女性，*　修炼

不堪一击	毫不足虑	初出茅庐	粗通皮毛
马马虎虎	略有小成	融会贯通	炉火纯青
已有大成	出类拔萃	技冠群雄	出神入化
傲视群雄	登峰造极	神功盖世	举世无双
空前绝后	天人合一	深藏不露	笑傲江湖

HELP
  );
  return 1;
}
