// /cmds/std/fight.c

#include <ansi.h>



inherit F_CLEAN_UP;

int main(object me, string arg) {
  object obj, old_target;

  if (environment(me)->query("wiz"))
    return notify_fail(HIR "这是属于神的房间，不能用来练功\n" NOR);

  if (!wizardp(me) && environment(me)->query("no_fight"))
    return notify_fail("这里禁止战斗。\n");

  if (!arg || !objectp(obj = present(arg, environment(me))))
    return notify_fail("你想攻击谁？\n");

  if (!obj->is_character())
    return notify_fail("看清楚一点，那并不是生物。\n");

  if (obj->is_fighting(me))
    return notify_fail("加油！加油！加油！\n");

  if (!living(obj))
    return notify_fail(obj->name() + "已经无法战斗了。\n");

  if (obj == me)
    return notify_fail("你不能攻击自己。\n");

  if (obj->query_temp("exercise_cost"))
    return notify_fail("他正在修炼呢。\n");

  if (me->query_temp("exercise_cost"))
    return notify_fail("你正在修炼呢。\n");

  if (me->is_lianing())
    return notify_fail("练习时请专心，别惦记着战斗。\n");

  if (me->is_duanling())
    return notify_fail("你最好等对练结束再进行战斗。\n");

  if (userp(obj) && (object)obj->query_temp("pending/fight") != me) {
    message_vision("\n$N对着$n说道："
      +RANK_D->query_self(me)
      +me->name() + "，领教"
      +RANK_D->query_respect(obj) + "的高招！\n\n", me, obj);
    old_target = me->query_temp("pending/fight");
    if (objectp(old_target) && old_target != obj)
      tell_object(old_target,
        YEL + me->name() + "取消了和你切磋的念头。\n" NOR);
    me->set_temp("pending/fight", obj);
    tell_object(obj, YEL "如果你愿意和对方进行切磋，请你也对"
      +me->name() + "(" + (string)me->query("id") + ")"
      + "下一次 fight 指令。\n" NOR);
    //write(YEL "对方是由玩家控制的人物，你必须等对方同意才能进行比试。\n" NOR);
    return 1;
  }

  if (obj->query("can_speak")) {
    message_vision("\n$N对着$n说道："
      +RANK_D->query_self(me)
      +me->name() + "，领教"
      +RANK_D->query_respect(obj) + "的高招！\n\n", me, obj);

    notify_fail("看起来" + obj->name() + "并不想跟你较量。\n");
    if (!userp(obj) && !obj->accept_fight(me)) return 0;

    me->fight_ob(obj);
    obj->fight_ob(me);
  } else {
    message_vision("\n$N大喝一声，开始对$n发动攻击！\n\n", me, obj);
    me->fight_ob(obj);
    obj->kill_ob(me);
  }

  return 1;
}

int help(object me) {
  write(@HELP
指令格式 : qiecuo <某人> | fight <某人> 

这个命令可以让你向某个玩家或是 NPC 进行挑战，这种挑战又称为点到即止，
只要其中的一方打中另外一方，战斗就会自然停止，双方并不以将对方杀死为
目的，但有负伤的可能。
 
其他相关指令: bihua( tiaozhan ), duilian, kill( sha )

HELP
  );
  return 1;
}
