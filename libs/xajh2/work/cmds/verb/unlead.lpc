// unlead.c
//by lnwm
#include <ansi.h>


inherit F_CLEAN_UP;

int main(object me, string arg) {
  object ob;

  if (environment(me)->query("wiz"))
    return notify_fail(HIR "这是属于神的房间，不能用来练功\n" NOR);

  if (!arg) return notify_fail("指令格式：unlead <某人>。\n");

  if (!objectp(ob = present(arg, environment(me))))
    return notify_fail("这里没有 " + arg + "。\n");

  if (!ob->is_character())
    return notify_fail("什麽？不带领...." + ob->name() + "。\n");

  if (ob == me)
    return notify_fail("不带领自己？\n");

  if (userp(ob) && !newbiep(ob))
    return notify_fail("人家可不是小孩，不是你想甩就甩得掉的。\n");
  else
    me->delete_temp("lead_newbie/" + arg);

  message_vision("$N决定停止让$n跟着自己一起行动。\n", me, ob);

  if (userp(ob) && ob->query_leader() == me) {
    ob->set_leader(0);
  }

  return 1;
}

int help(object me) {
  write(@HELP
指令格式 : unlead [<生物>]
 
只让某个新手不跟着你行动。
如果你想不带领任何人，请使用lead指令。
 
HELP
  );
  return 1;
}
