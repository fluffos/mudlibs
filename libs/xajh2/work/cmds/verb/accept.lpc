/* /cmds/verb/accept.c
 * 接收观看比武邀请指令,为比武大会用
 * from XO lib
 * created by hydra@xo 19990624
 * version: @(#) 1.0@(#)
 * last modified by hydra@xo 19990624
 */

#include <ansi.h>
#include <biwu.h>
#include <family.h>


inherit F_CLEAN_UP;

int main(object me, string arg) {
  //    string my_family = me -> query( "family/family_name" );
  string room;
  object tai = load_object("/d/place/biwu/biwutai");
  object *all;
  int i;
  if (!tai->query_temp("biwu/biwu"))
    return notify_fail("现在不是比武时间，你不能接收邀请。\n");

  //    if ( strsrch( read_file("/log/baoming"), me->query("id")+"|")==-1)
  //   if ( !me->query("high_mortal")&&environment(me)->query("short")==YEL"月老祠"NOR) 
  if (!me->query_temp("biwu/baoming"))
    return notify_fail("你并没有报名参加此次比武大会。\n");
  if (me->is_busy())
    return notify_fail("你现在正忙着呢！\n");

  if (me->is_fighting())
    return notify_fail("你先停下战斗再说。\n");

  if (me->is_duilianing())
    return notify_fail("你还是先停止对练吧。\n");

  if (me->is_ghost())
    return notify_fail("你现在是鬼耶！还是等还阳了再去吧:-)\n");

  if (objectp(environment(me))) {
    if (!environment(me)->query("not_startroom"))
      room = file_name(environment(me));
    else
      return notify_fail("你还是换个地方再去吧，现在这里人烟稀少:-)\n");
  } else
    room = "/clone/misc/void";

  me->set("startroom", room);
  all = all_inventory(me);
  for (i = 0; i < sizeof(all); i++)
    if (userp(all[i])) {
      message_vision("$N把$n往地下一摔，独自去参加比武大会了。\n", me, all[i]);
      all[i]->move("/clone/misc/void");
    }
  write(YEL "你决定参加这次比武大会。\n\n" NOR);
  message_vision(GRN "只见空中伸出一只大手把$N抓了起来。。。\n" NOR, me);
  me->move("/d/place/biwu/biwu_dating");
  me->set_temp("report", 1);
  write(GRN "那只大手“啪”的一声把你扔了下来。\n" NOR);
  message("vision", GRN "只听“啪”的一声，" + me->name() + "从空中摔了下来。\n" NOR, environment(me), me);
  return 1;
}
