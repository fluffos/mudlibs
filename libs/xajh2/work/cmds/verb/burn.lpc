#include <ansi.h>



inherit F_CLEAN_UP;

int main(object me, string arg) {
  object obj;
  mixed ret;

  if (!arg)
    return notify_fail("你要点燃什么东西？\n");
  obj = present(arg, me);
  if (!obj && environment(me)) {
    obj = present(arg, environment(me));
  }
  if (!obj)
    return notify_fail("你想烧什么？\n");

  if (!obj->can_burn())
    return notify_fail("这个东西不能烧也...\n");

  if (obj->is_burning())
    return notify_fail(obj->name() + "已经在烧了，没看见么？\n");

  ret = obj->burn();
  if (ret && stringp(ret)) {
    write(ret);
    return 1;
  } else if (ret) {
    return 1;
  } else {
    return notify_fail("无法点燃这个东西。\n");
  }
}

