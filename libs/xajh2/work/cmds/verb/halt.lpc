// Filename : /cmds/std/stop.c
#include <ansi.h>
int main(object me, string arg) {
  // 顺序还是比较重要的
  // add by xli 1999.7.21
  // to let a ppl can't stop when he/she is killing somebody
  /*        if ( me->is_killing() )
       {
       tell_object(me,"你正在生死拼杀中，怎么能随便退出呢？\n");
       return 1;
       }
       //end
     */

  if (me->is_duilianing()) {
    message_vision("$N猛地一收招，向后跳开半步，停手不练了。\n", me);
    me->remove_all_duishou();
  } else if ((me->is_fighting() || me->is_bihuaing()) && !me->is_killing()) {
    me->remove_all_bihua();
    me->remove_all_enemy();
    message_vision("$N向后一跃，跳出战圈不打了。\n", me);
  } else if (me->is_lianing()) {
    message_vision("$N气收丹田，停止了练习。\n", me);
    me->stop_lian();
  } else if (me->is_killing()) {
    me->remove_all_enemy();
    me->remove_all_killer();
    me->add("kee", (int) - 1 * me->query("kee") / 2);
    me->add("force", -1 * me->query("force") + 1);
    message_vision(HIR "$N强抑胸中的杀意,只觉气血一阵翻涌。\n" NOR, me);
    return 1;
  } else if (!me->is_busy())
    return notify_fail("你现在不忙。\n");
  me->interrupt_me();
  return 1;
}

int help(object me) {
  write(@HELP
指令格式 : halt

这个指令用来把你从一个持续的动作中解放出来。

相关指令 : lian, duilian, bihua

HELP
  );
  return 1;
}
