// quest.c
#include <ansi.h>

inherit F_CLEAN_UP;
int time_period(int timep, object me);
int main(object me, string arg) {
  int nowtime = time();
  mapping quest;

  nowtime = (int)me->query("task_time") - time();
  if (nowtime > 86400) {
    me->delete("quest");
    me->delete("task_time");
    return notify_fail("你现在没有任何任务。\n");
  }
  if (!(quest = me->query("quest")))
    return notify_fail("你现在没有任何任务！\n");

  write("你的任务是去" + quest["quest"] + "。\n");
  if (nowtime > 0)
    time_period(nowtime, me);
  else
    write("但是你花在这个任务上的时间太多了。\n");
  return 1;
}
int time_period(int timep, object me) {
  int t, d, h, m, s;
  string time;
  t = timep;
  s = t % 60; t /= 60;
  m = t % 60; t /= 60;
  h = t % 24; t /= 24;
  d = t;

  if (d) time = chinese_number(d) + "天";
  else time = "";

  if (h) time += chinese_number(h) + "小时";
  if (m) time += chinese_number(m) + "分";
  time += chinese_number(s) + "秒";
  tell_object(me, "你还有" + time + "的时间去完成这个任务。\n");
  return 1;
}

int help(object me) {
  write(@HELP
指令格式 : quest
 
这个指令可以显示出你当前的任务。
HELP
  );
  return 1;
}
