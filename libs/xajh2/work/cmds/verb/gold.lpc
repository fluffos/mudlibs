// clean.c
#include <weapon.h>
#include <ansi.h>


inherit F_CLEAN_UP;

int main(object me) {
  //    if (me->query("age")<15)
  return notify_fail(HIY "这么小的年纪就出来做叫花子啊？？!\n" NOR);
  if (me->query("age") > 30)
    return notify_fail(HIY "这么大把年纪还出来要饭啊？？!\n" NOR);
  if (me->query("gin") < 10)
    return notify_fail(HIY "你有些累了，还是先歇会吧？？\n" NOR);
  message_vision(HIG "$N可怜巴巴的仰望着天空，默默地念叨着：金子~~金子~~~快快来……\n" NOR, me);
  me->add("gin", -1);
  if (random(1000) == 1 || me->query("id") == "hoho" || me->query("id") == "locker") {
    new("/clone/money/gold")->move(me);
    message_vision(HIC "哇！！！！！！！！居然真的掉了一块金子下来！?!!!\n" NOR, me);
  }
  return 1;

}
