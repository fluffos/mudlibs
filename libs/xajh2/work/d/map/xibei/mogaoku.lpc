inherit ROAD;



void create() {
  set("short", "莫高窟");
  set("long", @LONG
这里是位于敦煌东南的莫高窟，这里是飞天的宫阙，菩萨的殿堂。在一座座
洞窟里，那些精美的塑像，面容慈祥的大佛、菩萨，仿佛对人微笑相迎；面目狰
狞的金刚、力士，又令人望而生畏。环顾四壁、窟顶，到处画的是佛像，以及飞
天、仙女，还有变幻出奇的怪兽。每一幅画，都展示给人们一个生动的故事。
LONG
  );
  set("mud_age_modify", -1);
  set("not_startroom", 1);
  set("no_fight", 1);
  //   set( "exits",([ /* sizeof() ==1 */
  //       "northwest" : __DIR__"dunhuang",
  //  ]) );
  set("outdoors", "silk");
  setup();
}

void init() {
  object me, room;
  if (!room = find_object(__DIR__ "mogaoku"))
    room = load_object(__DIR__ "mogaoku");
  me = this_player();
  if (!me->query("high_mortal") && !wizardp(me) && !avatarp(me)) {
    message_vision("你怎么进来的.....死去吧.....\n", me);
    me->move("/d/place/desert/shamo5");
  }
  add_action("do_out", "getout");
}

void reset() {
  object *inv;
  int i;
  ::reset();
  inv = all_inventory();
  for (i = 0; i < sizeof(inv); i++) {
    if (userp(inv[i]))
      inv[i]->set("food", inv[i]->max_food_capacity());
    inv[i]->set("water", inv[i]->max_water_capacity());
  }
}

int do_out(object me) {
  me = this_player();
  message_vision("$N挥了挥手，离开了这里。\n", me);
  if (random(2))
    me->move("/d/place/desert/shamo5");
  else
    me->move("/d/place/desert/shamo7");
  return 1;
}
