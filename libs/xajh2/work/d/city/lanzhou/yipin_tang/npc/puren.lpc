// /d/city/lanzhou/yipin_tang/npc/puren.c 一品堂的情报站的仆人
// By lala 1997/09/12

inherit NPC;

void create() {
  set_name("仆人", ({ "pu ren", "pu", "ren" }));
  set("long", "这是名看起来很是老成的仆人。\n");
  set("gender", "男性");
  set("age", 33);
  set("attitude", "friendly");
  setup();
  carry_object(CLONE_DIR "wear/cloth/cloth1");
}

int accept_object(object me, object obj) {
  object ob = this_object();
  object here;
  here = environment();
  if (obj->query("id") != "pa zi")
    return 0;
  remove_call_out("run_away");
  call_out("run_away", 1, ob, obj, me, here);
  return 1;
}

void run_away(object ob, object obj, object me, object here) {
  message_vision(@LONG
$N见了帕子，微微一点头，说道：“既然如此，请稍待，我去请示家主人。”
说完，转身开门进院，然后又关上了门，而且还细心地把门插上。
LONG, ob);
  destruct(obj);
  ob->move("/d/city/lanzhou/yipin_tang/temp");
  here->set_temp("is_waiting", 1);
  remove_call_out("come_back_again");
  call_out("come_back_again", 30, me, here);
}

void come_back_again(object me, object here) {
  object ob = this_object();
  ob->move(here);
  here->delete_temp("is_waiting");
  if (!me
    || environment(me) != environment()) {
    message_vision(
      "$N开门出来，见$n已经不在，便什么也没有说，转身回院关门了。\n", ob, me);
    return;
  }
  command("sorry " + me->query("id"));
  command("say 劳您久候了，家主人有请！");
  message_vision(
    "$N把$n让进门去，然后又插上了门。\n", ob, me);
  me->move("/d/city/lanzhou/yipin_tang/keting");
  destruct(ob);
}

int refuse_killing(object me) {
  object here = environment();
  here->remove_call_out("go_back");
  message_vision(
    "$N摇头道：“我家主人不许我和人动手……”说完，转身入院关门上锁。\n" +
    "举手投足飘逸灵动，显然在轻功上有着极深的造诣。\n\n", this_object());
  destruct(this_object());
  return 1;
}
