#include <mudlib.h>
inherit ROOM;

#include "men.h"

void create() {
  set("short", "西门");
  set("long", @LONG
西门外是一片官军的屯田，少有农家居住，西去也没有道路，因此这里冷清
的很，只有几个孩子在城门内的空场上玩耍。虽然是白天，城门却关着，门洞边
的墙上贴着榜文(bang wen)；东边是一条大街。北面不远处城墙跟下是个大垃圾
堆，人们都把废物往那里倒。一阵阵恶臭气味不时袭来。
LONG
  );
  set("outdoors", "lanzhou");
  set("item_desc", ([
    "榜文": (: look_bangwen :),
    "bang wen": (: look_bangwen :),
    "bangwen": (: look_bangwen :),
    "north": "北面有一个很大的垃圾堆，臭哄哄的，很多苍蝇在附近飞着。\n",
  ]));
  set("exits", ([
    "east": __DIR__ "xijie2",    //西大街
  ]));
  set("objects", ([
    NPC_DIR "boy": 1,          //标准男孩
    NPC_DIR "girl": 1,          //标准女孩
  ]));

  setup();
}
