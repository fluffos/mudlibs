//  烧酒：佛光阁和尚之物，完成任务用。  /d/city/lanzhou/obj/jiu.c
//  By lin
//  Changed by lala, 1998-03-16

#include <ansi.h>

inherit ITEM;
inherit F_LIQUID;

void create() {
  set_name(HIG "烧酒" NOR, ({ "shao jiu", "shaojiu", "jiu", "arrack" }));
  set_weight(2000);                     //四市斤；
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一个专门用来装烧酒的酒坛子。\n");
    set("unit", "坛");
    set("value", 100);                //价格100文；
    set("max_liquid", 20);            //容积：20；
  }
  set("liquid", ([
    "type": "alcohol",              //类别：酒类；
    "name": "烧酒",                 //名称：烧酒；
    "remaining": 30,                 //容量：30；
    "drunk_apply": 10,             //饮水：10。
  ]));
}
