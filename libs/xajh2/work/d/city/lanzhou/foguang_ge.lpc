#include <room.h>

inherit DOOR_ROOM;


void create() {
  set("short", "佛光阁");
  set("long", @LONG
这是本城居民捐资盖起的一间寺院，供奉观世音菩萨，求菩萨保佑众生。殿
上金匾大书“佛光普照”，两边有一副对联(dui lian)，下面供奉着观音菩萨，
金童玉女。殿里香烟缭绕，令人浮想连篇；供桌上散着祭食，铜钱。外边是城煌
殿；殿后是禅房。
LONG
  );
  set("exits", ([
    "out": __DIR__ "chenghuang_dian",       //兰州城隍殿
    "in": __DIR__ "chanfang",              //禅房
  ]));
  set("objects", ([
    __DIR__ "npc/monk": 2,                  //和尚 
  ]));
  create_door("in", "木门", "out", DOOR_CLOSED);    //通向禅房

  setup();
}
