//  书坊    /d/city/lanzhou/shufang.c
//  By Lin
//  Changed by Lala, 1998-03-20

inherit ROOM;

int read_book(string arg);                //读书的函数。在这里可以看本小说。

void create() {
  set("short", "博雅斋");
  set("long", @LONG
这里专卖市坊中流行的各种小说，演义，因为这些书通俗易懂，情节又十分
吸引人，大合百姓口味，所以每天买书，看书的人络绎不绝。老板也兼而卖些诗
集，收集买卖古董字画等等。四周墙上到处挂着字画，有些已经很古旧了，有些
却是墨迹尚新。柜台后边是一个书架(shu jia)，上面堆满了书。
LONG
  );
  set("item_desc", ([
    "书架": "书架上堆满了书(book)，有些已经翻得破破烂烂。\n",
    "shu jia": "书架上堆满了书(book)，有些已经翻得破破烂烂。\n",
    "shujia": "书架上堆满了书(book)，有些已经翻得破破烂烂。\n",
    "书": @TEXT
这里有如下书籍：
        《白马啸西风》（一）(baima_1)
        《白马啸西风》（二）(baima_2)
        《白马啸西风》（三）(baima_3)
        《白马啸西风》（四）(baima_4)
        《白马啸西风》（五）(baima_5)
        《白马啸西风》（六）(baima_6)
    你可以用 read 命令来阅读。
TEXT
    ,
    "book": @TEXT
这里有如下书籍：
        《白马啸西风》（一）(baima_1)
        《白马啸西风》（二）(baima_2)
        《白马啸西风》（三）(baima_3)
        《白马啸西风》（四）(baima_4)
        《白马啸西风》（五）(baima_5)
        《白马啸西风》（六）(baima_6)
    你可以用 du 命令来阅读。
TEXT
    ,
  ]));
  set("exits", ([
    "north": __DIR__ "xijie2",    //西街
  ]));
  set("objects", ([
    __DIR__ "npc/bookboss": 1,      //书店老板
  ]));

  setup();
}

void init() {
  add_action("read_book", "du");     //读书的动作函数。
}

int read_book(string arg)                 //读书的动作函数。
{                                           //arg：读书的书名。
  string file;
  object ppl = this_player();

  if (!arg)
    return notify_fail("指令格式：du <书名> （英文）\n");
  file = __DIR__ "obj/" + arg + ".book";
  if (file_size(file) < 0)            //文件长度为返回值为-1。
    return notify_fail("没有这本书。\n");

  ppl->start_more(read_file(file));   //开始more这个文件。
  return 1;
}
