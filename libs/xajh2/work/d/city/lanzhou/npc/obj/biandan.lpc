//biandan.c

#include <weapon.h>
#include <armor.h>

inherit STAFF;


void create() {
  set_name("扁担", ({ "bian dan" }));

  set_weight(1500);

  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", @LONG
        挑水用的扁担。
LONG);
    set("unit", "根");
    set("value", 100);
    set("cant_sell", "你没搞错吧？这玩意也拿来卖？\n");
    set("material", "wood");
    set("armor_prop/armor", 10);
  }

  init_staff(5);
  set("wield_msg", "$N将一根$n紧握在胸前，准备自卫。\n");
  set("unwield_msg", "$N将手中的$n放下。\n");
  setup();
}
