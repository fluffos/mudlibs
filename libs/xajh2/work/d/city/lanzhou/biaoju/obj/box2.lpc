inherit ITEM;
void create() {
  object money;
  seteuid(getuid());
  seteuid(geteuid());
  set_name("泥金铁箱", ({ "gold tiexiang", "tiexiang", "box" }));
  set_weight(40000);
  set_max_encumbrance(50000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "只");
    set("long", "一只坚固的铁箱子，表面涂着金粉，刻着各种花纹.\n");
    set("value", 10000);
  }
  money = new(MONEY_DIR "coin");
  money->move(this_object());
  money->set_amount(200);
}

int is_container() { return 1; }
