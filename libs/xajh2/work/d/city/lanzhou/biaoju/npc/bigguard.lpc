#include <ansi.h>

inherit NPC;
inherit F_MASTER;
string leave_biaoju(object);

void create() {
  set_name("秦天彪",
    ({ "qin tianbiao", "qin", "qintianbiao", "tianbiao", "master" }));
  set("title", HIW "龙门镖局总镖头" NOR);
  create_family("龙门镖局", 3, "总镖头");
  set("nickname", CYN "关西第一刀" NOR);
  set("gender", "男性");                //性别：男
  set("age", 52);                       //年龄：52
  set("str", 30);                       //臂力：30
  set("cor", 30);                       //胆识：30
  set("dex", 30);                       //身法：30
  set("per", 22);                       //容貌：22
  set("int", 29);
  set("rank_info/respect", "老英雄");   //敬称：老英雄
  set("positive_score", 1000);
  set("long", @LONG
    秦天彪少年时就生得异常魁梧，早年曾在少林寺当了很多年的俗家弟子，后
来又得高人相授，刀法和铁砂掌功夫都是相当了得。现在是龙门镖局的大当家。
LONG
  );

  set_wugong("blade", 120, 120, 0);    //横刀六式：    一级
  set_wugong("wuhu-dao", 100, 100, 0);    //五虎断门刀：  三级

  set_wugong("fenglei-dao", 150, 150, 1);    //风雷刀：      五级

  set_wugong("unarmed", 120, 120, 0);    //基本拳法：    一级

  set_wugong("qinggong", 120, 120, 0);    //基本轻功：    一级
  set_wugong("caiyun-gong", 90, 90, 1);    //彩云功：      四级

  set_wugong("banruo-xinfa", 120, 120, 1);

  set_xiuwei_by_type("blade", 3000);  //刀法修为：    五级
  set_xiuwei_by_type("unarmed", 1800);  //拳脚修为：    三级
  set_xiuwei_by_type("dodge", 1800);  //轻功修为：    三级
  set_xiuwei_by_type("zonggang", 3201);  //总纲修为：    一级

  set("max_force", 2700);             //内力：    2700
  set("force", 2700);
  set("force_factor", 135);             //加力：    135 (5%)

  set_hp("kee", 875);              //生命、体能：  875
  set_hp("sen", 875);

  set("combat_exp", 1000000);          //战斗经验：100万
  set("social_exp", 170000);          //江湖阅历：17万
  set("talk_msg", ({
    "“这位英雄来我镖局有何贵干？”",
  }));

  set("inquiry", ([
    "出师": (: leave_biaoju :),
  ]));

  setup();

  carry_object(CLOTH_DIR + "cloth5")->wear();       //紫绸长衫
  add_money("silver", 5);               //有银子五两

}

void init() {
  object ppl;

  ::init();

  if (!userp(ppl = this_player())
    || !can_act())
    return;

  remove_call_out("Greeting");
  call_out("Greeting", 1, ppl);
}

void Greeting(object ppl) {
  if (!ppl
    || environment(ppl) != environment())
    return;
  command("say “这位英雄来我镖局有何贵干？”");
  command("look " + ppl->query("id"));
}

int refuse_killing(object ppl)            //被杀时的反应
{
  object npc = this_object();

  if (!living(npc)
    || query_temp("weapon"))
    return 0;
  message_vision("$N看了$n一眼，冷笑道：“居然有你这么不知天高地厚的狂妄之"
    "徒，哼哼，待老夫今天好好收拾你！！\n", npc, ppl);
  if (!npc->query("blade")) {
    new(__DIR__ "obj/fenglei-dao")->move(npc);  //拿一把单刀
    command("wield blade");
    npc->set("blade", 1);
  }
  return 0;
}

int attempt_apprentice(object me) {
  object this;
  mapping family;
  this = this_object();
  if (!me->query("marks/lin/送官"))      //如果没有学功夫的标记
  {
    command("say 武林中人，要多为朝廷办事。\n");
    return 0;
  }
  if (me->query("locker/镖局出师")) {
    command("say 你不是已经出师了吗？");
    return 0;
  }
  command("dao " + me->query("id"));
  message_vision("秦天彪高兴对$N笑了笑，说：很好很好。\n", me);
  message_vision("\n$n决定收$N为弟子。\n\n"
    "$N跪了下来向$N恭恭敬敬地磕了三个响头，叫道：「师父！」\n",
    me, this);
  recruit_apprentice(me);
  family = me->query("family");
  me->set("title", "镖师");
  tell_object(me,
    sprintf("恭喜您成为%s的第%s代弟子。\n\n", family["family_name"],
      chinese_number(family["generation"])));
  return 1;
}

string leave_biaoju(object me) {
  object this;
  me = this_player();
  this = this_object();

  if (me->query("locker/镖局出师")) {
    return "你不是已经出师了吗？";
  }
  if (me->query("family/family_name") != "龙门镖局") {
    command("? " + me->query("id"));
    return "你又不是我龙门镖局之人，何来出师之说。";
  }

  if (me->query("class_score/龙门镖局") < 1000) {
    message_vision(CYN "$N对$n道：“你在我门下多年，却不尽心为镖局"
      "效力，怎么就想离开了呢？”\n" NOR, this, me);
    me->add("class_score/龙门镖局", -10);
    return "你还是先为发扬镖局多干点事吧！\n";
  }

  if (me->query_jibie("fenglei-dao") < 100) {
    me->add("class_score/龙门镖局", -10);
    return "你功夫未成，还是在我手下多学几年吧。\n";
  }
  command("snow " + me->query("id"));
  message_vision(CYN "$N看看了$n，道：“既然这样，我也知道留你不住了。"
    "出去了可不要忘了为师和你的师兄弟们啊。\n" NOR, this, me);
  me->set("title", "普通百姓");
  me->delete("family");
  me->delete("class");
  me->set("locker/镖局出师", 1);
  command("chat " + me->query("name") + "从今往后不再是我龙门镖局的镖师。\n");
  LOG_D->do_log(me, sprintf("你获得了秦天彪的允许，从龙门镖局出师。\n"));
  log_file("chushi", sprintf("%s(%s)于%s顺利从龙门镖局出师。\n", me->query("name"),
    getuid(me), ctime(time())));
  message_vision("$N恭恭敬敬地跪了下来，向$n磕了四个响头。\n", me, this);
  return "罢了，罢了。。。";
}
