inherit ROOM;

void create() {
  set("short", "镖局大门");
  set("long", @LONG
这是西北地区第一大镖局，赫赫有名的龙门镖局。大门前立着两根三丈高的
旗斗，左面旗上绣着鲤鱼跃龙门的图案，右面旗上写着“龙门镖局”四个龙飞凤
舞的大字。大门上挂着匾额(bian)，门框左侧一块木牌上写着“总号”二字。门
口两边摆着两条长凳，六名劲装大汉相对而坐。门里是一块高大的红漆影背，院
里传来练武之声。
LONG
  );
  set("outdoors", "lanzhou");
  set("item_desc", ([
    "匾额": "匾上写着：    龙门镖局。\n",
    "匾": "匾上写着：    龙门镖局。\n",
    "bian": "匾上写着：    龙门镖局。\n",
  ]));
  set("exits", ([
    "north": "/d/city/lanzhou/xijie1",    //兰州西街
    "south": __DIR__ "dayuan",    //镖局大院
  ]));
  set("objects", ([
    __DIR__ "npc/fighter1": 6,      //趟子手
  ]));

  setup();
}
