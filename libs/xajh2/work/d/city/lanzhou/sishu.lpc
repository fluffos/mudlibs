#include <room.h>

inherit DOOR_ROOM;


void create() {
  set("short", "私塾");
  set("long", @LONG
这是一家专供有钱人家的子弟读书的学校。小小一间教室，放着四五张方桌，
十几个凳子。其中一张桌子上堆着满满一桌子的书，其他桌子上则放着笔墨纸砚
等物。虽然并非正月学假之时，这里却静悄悄的没有学生；桌子上都落了薄薄的
一层土，四壁上的书画也大部分残破了。
LONG
  );
  set("exits", ([
    "north": __DIR__ "xiaoxiang",  //小巷
  ]));
  set("objects", ([
    __DIR__ "npc/teacher": 1,      //范积古
  ]));
  set("search_things", ([
    "桌子": BOOK_DIR + "guwen",  //可搜寻的物品：古文志  
  ]));
  create_door("north", "木门", "south", DOOR_CLOSED);   //北面有一木门

  setup();
}
