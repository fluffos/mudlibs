//  changed by cry 9.25.98

inherit ROOM;

#include "men.h"

void look_sign();
void create() {
  set("short", "北门");
  set("long", @LONG
兰州城是大宋西北边防要塞，城高三丈有余，用黄土调糯米汁夯成，雄伟坚
固，城外还有深一丈宽数丈的护城河和高塔了望台。城门楼有三层，顶层挂着一
块金字横匾，两边悬挂两排巨大的灯笼。城门洞正面一块有白底石匾，上书“兰
州”两个大字。几名全副武装的士兵站在高高悬起的千斤闸下，盘查过往行人。
LONG
  );
  set("outdoors", "lanzhou");
  set("item_desc", ([
    "匾": (: look_sign :),
    "横匾": (: look_sign :),
    "bian": (: look_sign :),
    "sign": (: look_sign :),
  ]));
  set("exits", ([
    "north": __DIR__ "chengwai",    //兰州城外
    "south": __DIR__ "beijie",      //兰州北街
  ]));
  set("objects", ([
    __DIR__ "npc/shibing": 2,      //士兵
    __DIR__ "npc/xiaowei": 1,      //将虞侯
  ]));

  setup();
}

void look_sign() {
  tell_object(this_player(), "匾上写着“固若金汤”四个大字，据说是经略使范仲淹的手笔。\n");
}

void welcome_visitor(object me) {
  int hour = NATURE_D->QueryShiChen() * 2;
  //   object me;
  //   me=this_player();

  if (hour < 5 || hour > 24) {  //当地时间在晨五点以前，在晚七时以
    //后关闭城门。
    if (query("exits/north"))       //如果此刻城门是开放状态的话，
      delete("exits/north");        //关闭城门。
      tell_object(me, "现在是" + CHINESE_D->chinese_time() + "，城门正关着。\n");
    return;
  }
  if (!query("exits/north"))            //在晨五时到晚七时的时间开放城门。
    set("exits/north", __DIR__ "chengwai");        //通向城外的出口
    tell_object(me, "现在是" + CHINESE_D->chinese_time() + "，城门正开着。\n");
}
