inherit ROOM;
void create() {
  set("short", "厨房");
  set("long", @LONG
这里是负责供应柯府上上下下一百多人一日三餐的大厨房；不过，老爷夫人
和小姐的饭菜并不在这里做。厨房里整天都是乱哄哄的：有时开灶煮饭，有时烧
水烹茶；不动火时，厨娘们也要忙着择菜，和面。靠外墙根有两张桌子，是供府
里的徒弟，食客们用餐的。
LONG);
  set("item_desc", ([
    "桌子": "一张干干净净的长条木板桌，两个人正在你身边坐(zuo)着吃饭。\n",
  ]));
  set("exits", ([
    "north": __DIR__ "qianyuan",
  ]));
  set("objects", ([
    __DIR__ "npc/chuniang": 1,
  ]));
  setup();
}
void init() {
  add_action("do_eat", "zuo");
}
int do_eat(object me) {
  int max;
  me = this_player();
  if (!me->can_act()) return 0;
  if (!objectp(present("chu niang", environment(me))))
    return notify_fail("可是厨娘已经死了。\n");
  if (me->query("family/family_name") != "伏牛派" && !me->query_temp("lin_marks/暂住"))
    return notify_fail("哪儿来的饿死鬼？想白吃吗？！\n\n");
  if (me->query("food") > me->max_food_capacity() / 2 &&
    me->query("water") > me->max_water_capacity() / 2)
    return notify_fail("你已经够饱的了，该干什么就去干什么吧！\n");
  message_vision("$N坐了下来，向厨娘要了些夹肉馒头和大碗茶，吃了个饱.\n", me);
  max = (me->max_food_capacity() + me->max_water_capacity()) / 2;
  me->set("food", max);
  me->set("water", max);
  return 1;
}
