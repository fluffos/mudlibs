#include <room.h>
#include <ansi.h> 
#include "bianjing.h"
inherit SROOM;
void create()
{
	set("short",MAG "闺房" NOR);
	set("long", @LONG
一间精心设计的小小阁儿。临院开三扇雕窗，窗外碧柳红花，鸟鸣溪流；窗
下设着紫檀镂空玲珑小案，案上香鼎浮烟，几个白定小碟，盛的皆是市面上未见
之奇珍异味。远窗之处摆着香楠雕花大床，上挂着彩绣绿绸的帐子，轻纱幕帘儿。
墙上两幅工笔花鸟，甚是喜人；一架古琴挂在一边。
LONG
	);
	set("objects", ([ 
         ]));
	set("exits", ([  
	    "down" : __DIR__"lss_xiaolu_ge", 
         ]));     
    set("detail",([  
        "窗外" : "小小花园中景色秀丽，花香熏人。",
    ]));          
	setup(); 
}
