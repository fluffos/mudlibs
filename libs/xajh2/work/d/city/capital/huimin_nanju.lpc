#include "bianjing.h"
inherit BROOM;

#include <room.h>
#include <ansi.h>    

void create()
{
    set("short","熟药惠民南局");
    set("long", @LONG
惠民药局是官设的大药铺；负责采买药品以备进上并各大王公贵族，大臣学
士府上使用。这里的药以药丸为主，故曰“熟药”，药铺共设有六个分局，分散
于京师各处。
    一进门来，便觉得药气冲鼻，地下停着辆卖药材的小车。老板似乎出门谈生
意去了，只有掌柜的在门边招呼。
    北面有个偏门通太学巷，西边门外就是御街。
LONG);
    set("exits", ([ 
        "west"      : __DIR__"yujie7", 
        "north"     : __DIR__"taixue",
    ]));
//    set("detail",([
//    ]));
    setup();
}