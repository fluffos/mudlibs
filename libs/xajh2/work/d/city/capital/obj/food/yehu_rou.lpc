// 汴京 FOOD：    yehu_rou.c
inherit ITEM;
inherit F_FOOD;
#include <ansi.h>
void create() {
  set_name(RED "野狐肉" NOR, ({ "yehu rou", "rou", "meat" }));
  set_weight(150);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", @LONG
    一块用油炸得焦脆可口的野狐肉，香气四溢，令人垂涎欲滴。
LONG
    );
    set("unit", "块");
    set("value", 4000);
    set("over_value", 0);
    set("food_remaining", 2);
    set("food_supply", 15);  //正常饭量的人一顿吃二斤。
    set("gifts", ([
      "str": 3,
      "cor": 3,
    ]));
    set("eat_msg", "$N贪婪地将一块$n放进嘴里大嚼起来.\n");
    //                set("end_msg","$N将纸包里的最后一个$n放进嘴里，颇有些舍不得。.\n");
  }
}
int eat_effect(object me, object this) {
  me->add("water", -3);
  return 0;
}
