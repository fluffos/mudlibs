//汴京： FOODs :   shuifan.c 

inherit ITEM;
inherit F_FOOD;

#include <ansi.h>

void create() {
  set_name("水饭", ({ "shui fan", "fan", "food" }));
  set_weight(300);
  set("long", @LONG    
    一碗热气腾腾的稀饭，还撒了些肉末，青菜和盐。
LONG);
  set("unit", "碗");
  set("value", 600);
  set("over_value", 1);
  set("food_remaining", 3);
  set("food_supply", 50);
  set("eat_msg", "$N拿起筷子使劲往嘴里扒拉着$n....\n");
  set("end_msg", "$N将剩下的$n吃的干干净净.\n");
}
int eat_effect(object me, object this) {
  if (me->query("water") < me->max_water_capacity())
    me->add("water", 10);
  return 0;
}
int finish_eat(object me, object this) {
  this->set_name(WHT "粗磁大碗" NOR, ({ "cuci wan", "wan" }));
  this->set("long", @LONG          
    一个加工很不精致的大碗，口上还破了点边。
LONG);
  this->set("unit", "个");
  this->set("value", 1);
  this->set_weight(30);
  return 1;
}
