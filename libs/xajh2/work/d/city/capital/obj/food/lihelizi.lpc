//汴京 FOODs:  lihelizi.c

inherit ITEM;
inherit F_FOOD;

#include <ansi.h>

void create() {
  set_name(YEL "李和栗子" NOR, ({ "lihe lizi", "lizi", "food" }));
  set_weight(100);
  set("long", @LONG    
    栗子又称鸡头，是汴京城里人们都非常喜爱的一种食品，上自皇帝，下
  至平民都很爱吃。梁门内的李和栗子最负盛名，金盒包装的栗子经常被达
  官贵人甚至宫廷成批的买去。
LONG);
  set("unit", "盒");
  set("value", 1200);
  set("over_value", 1);
  set("food_remaining", 10);
  set("gifts", ([
    "per": 2,
    "spi": 2,
  ]));
  set("food_supply", 5);
  set("eat_msg", "$N从金盒里面拿出一个$n贪婪地放进嘴里--" CYN "麝香的气味沁透肺腑，好爽耶！！\n" NOR);
  set("end_msg", "$N从金盒里面拿出最后一个$n放进嘴里.\n");
}
int eat_effect(object me, object this) {
  if (me->query("water") > 0)
    return 0;
}
int finish_eat(object me, object this) {
  this->set_name(YEL "金盒" NOR, ({ "jin he", "he", "box" }));
  this->set("long", @LONG  
    一个用来装食品的纸盒子，外面涂着金粉。
LONG);
  this->set("unit", "个");
  this->set("value", 0);
  this->set_weight(10);
  return 1;
}
