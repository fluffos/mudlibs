// 汴京 FOOD：   zacai_geng.c
#include <ansi.h>
inherit ITEM;
inherit F_FOOD;
void create() {
  set_name("杂菜羹", ({ "zacai geng", "geng", "food" }));
  set_weight(500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一碗热气腾腾的杂菜羹，里面点着各样干菜。\n");
    set("unit", "碗");
    set("value", 800);
    set("over_value", 0);
    set("food_remaining", 5);
    set("food_supply", 30);  //正常饭量的人一顿吃二斤。 
    set("eat_msg", "$N吃了一大$n----好烫！\n");
  }
}
int eat_effect(object me) {
  me->add("water", 10);
  return 0;
}

int finish_eat(object me, object this) {
  this->set_name("粗瓷大碗", ({ "wan" }));
  this->set("unit", "只");
  this->set("value", 0);
  this->set_weight(5);
  return 1;
}
