//汴京 FRUITs :   longyan.c

inherit ITEM;
inherit F_FRUIT;

#include <ansi.h>

void init() {
  add_action("do_eat", "eat");
}

void create() {
  set_name(HIM "龙眼" NOR, ({ "long yan", "guiyuan", "yan", "fruit" }));
  set_weight(100);
  set("long", @LONG       
    龙眼又叫桂圆，长得和荔枝差不多，味道却要更甜一些。
LONG);
  set("unit", "把");
  set("value", 10000);
  set("fruit_remaining", 10);
  set("food_supply", 5);
  set("water_supply", 5);
  set("eat_msg", "$N摘下一个$n，放进嘴里。\n");
  set("gifts", ([
    "per": 1,
    "int": 1,
    "spi": 1,
  ]));
  set("core", "龙眼枝");
  set("core_id", ({ "long yan zhi", "zhi" }));
  set("core_unit", "把");
  set("core_long", "一把细细的树枝。\n");

  setup();
}
