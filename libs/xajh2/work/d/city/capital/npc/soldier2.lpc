//汴京 Npc : soldier2.c  duilianing......
// xiuwei: unarmed 200, dodge 150  
// taizu-quan 70 and qinggong 120  (1080/570)

inherit SOLDIER;

#include "bianjing.h"
#include <ansi.h>

string call_others(object who);
void create() {
  set_name(comm_man_name(), ({ "shi bing", "bing", "soldier" }));
  set("title", CYN "殿前司" + RED "天武第七军" YEL "第" + chinese_number(random(8)
    +1) + "营" NOR "士兵");
  set("age", 18 + random(30));
  set("gender", "男性");
  set("long", "    一名殿前司的禁军士兵，驻守京师。但见他全副武装；\n" +
    "脸上左颊刺有黑色纹记「天武」二字。\n");
  set("combat_exp", 8000);
  set("talk_msg", ({
    "当今之世，蕃戎内侵，边事不断，不知道哪一天我就会被派到西北前线去送了性命，唉！\n",
    "一个月才发四百文，够干什么的呢？\n",
  }));
  set("chat_chance_combat", 10);
  set("chat_msg_combat", ({
    (: call_others :),
  }));
  SetPower("shibing", 1);
  setup();
  SetEquipment("soldier");
}
