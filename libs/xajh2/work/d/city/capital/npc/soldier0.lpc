//标准士兵参数设定：
inherit NPC;
#include "soldier.h"

void setup() {
  ::setup();

  set("class", "soldier");
  set("gender", "男性");
  set("str", 40);
  set("con", 40);
  set("cor", 40);
  set("bellicosity", 500);
  if (query("gin") < 800)
    set_hp("gin", 800);
  if (query("kee") < 1000)
    set_hp("kee", 1000);
  if (query("sen") < 1000)
    set_hp("sen", 1000);

  if (!query("max_force")) {
    set("max_force", 200);
    set("force", 200);
    set("force_factor", 20);
  }
}
void SetPower(string rank, int step) {
  if (rank == "soldier" && step == 1)  //标准士兵：战斗类  3
  {
    set_wugong("qiang", 90, 90, 1);
    set_wugong("jinjun-qiangfa", 80, random(40) + 40, 1);
    set_xiuwei_by_type("long", 900 + random(400));
    set_wugong("unarmed", 100, random(20) + 75);
    set_wugong("taizu-quan", 90, 40 + random(50), 1);
    set_xiuwei_by_type("unarmed", 600 + random(300));
    set_wugong("qinggong", 100, random(30) + 65, 1);
    set_xiuwei_by_type("dodge", 1000 + random(500));
    return;
  }
  if (rank == "yuhou")  // 4
  {
    set_wugong("blade", 100, 100);
    set_wugong("ditang-dao", 90, 90, 1);
    set_xiuwei_by_type("blade", 1500 + random(800));
    set_wugong("unarmed", 100, 100, 1);
    set_xiuwei_by_type("unarmed", 1000 + random(600));
    set_wugong("qinggong", 100, 100, 1);
    set_xiuwei_by_type("dodge", 1000 + random(600));
    if (step == 2) {
      set_wugong("taizu-quan", 50, 50, 1);
      set_wugong("feiyan-zoubi", 50, 50, 1);
      return;
    } else if (step == 1) {
      set_wugong("taizu-quan", 100, 100, 1);
      set_wugong("feiyan-zoubi", 100, 100, 1);
      set_xiuwei_by_type("unarmed", 1700 + random(800));
      set_xiuwei_by_type("dodge", 1700 + random(800));
      return;
    }
  }
  if (rank == "jieji")  //使枪的 4~5
  {
    set_wugong("qiang", 100, 100);
    set_wugong("jinjun-qiangfa", 60, 60, 1);
    set_xiuwei_by_type("long", 1500 + random(1000));
    set_wugong("unarmed", 100, 100, 1);
    set_xiuwei_by_type("unarmed", 1500 + random(1500));
    set_wugong("qinggong", 100, 100, 1);
    set_xiuwei_by_type("dodge", 1500 + random(1500));
    if (step == 2)  //教官
    {
      set_wugong("jinjun-qiangfa", 95, 95, 1);
      set_xiuwei_by_type("long", 2500 + random(1700));
      return;
    } else if (step == 1)  //标准节级：战斗类
    { return; } else {
      return;
    }
  }
  if (rank == "dutou")  //使棒的  6
  {
    set_wugong("staff", 100, 100);
    set_wugong("qimei-gun", 95, 95, 1);
    set_xiuwei_by_type("long", 3000 + random(1600));
    set_wugong("unarmed", 100, 100, 1);
    set_xiuwei_by_type("unarmed", 3200 + random(1600));
    set_wugong("qinggong", 100, 100, 1);
    set_xiuwei_by_type("dodge", 3200 + random(1600));
    if (step == 2) {
      set_wugong("taizu-quan", 150, 150, 1);
      set_wugong("feiyan-zoubi", 150, 150, 1);
      return;
    } else if (step == 1)  //标准都头：战斗类
    {
      set_xiuwei_by_type("long", 3600);
      set_wugong("taizu-quan", 90, 90, 1);
      set_xiuwei_by_type("unarmed", 3800 + random(800));
      set_wugong("feiyan-zoubi", 90, 90, 1);
      set_xiuwei_by_type("dodge", 3800 + random(800));
      return;
    } else {
      return;
    }
  }
  if (rank == "zhihui shi") {
    set_wugong("yang-qiang", 50, 50, 1);
    set_xiuwei_by_type("long", 5000 + random(1800));
    set_wugong("tiesha-zhang", 60, 60, 1);
    set_xiuwei_by_type("unarmed", 5600 + random(1800));
    set_wugong("meihua-bu", 60, 60, 1);
    set_xiuwei_by_type("dodge", 5800 + random(1800));
    return;
  }
}
void SetEquipment(string rank) {
  if (rank == "soldier") {
    carry_object(__DIR__ "obj/tieqiang")->wield();
    carry_object(__DIR__ "obj/junfu")->wear();
    carry_object(__DIR__ "obj/guangming_jia")->wear();
    carry_object(__DIR__ "obj/junxue")->wear();
    carry_object(__DIR__ "obj/shutie_toukui")->wear();
    return;
  } else if (rank == "yuhou") {
    carry_object(__DIR__ "obj/jundao")->wield();
    carry_object(__DIR__ "obj/zhan_pao")->wear();
    carry_object(__DIR__ "obj/lianhuan_jia")->wear();
    carry_object(__DIR__ "obj/zhuying_toukui")->wear();
    carry_object(__DIR__ "obj/wuyun_xue")->wear();
    carry_object(__DIR__ "obj/yaopai")->wear();
    return;
  } else if (rank == "jieji") {
    carry_object(__DIR__ "obj/tieqiang")->wield();
    carry_object(__DIR__ "obj/zhan_pao")->wear();
    carry_object(__DIR__ "obj/guangming_jia")->wear();
    carry_object(__DIR__ "obj/zhuying_toukui")->wear();
    carry_object(__DIR__ "obj/wuyun_xue")->wear();
    return;
  } else if (rank == "dutou") {
    carry_object(__DIR__ "obj/wolfstick")->wield();
    carry_object(__DIR__ "obj/zhan_pao")->wear();
    carry_object(__DIR__ "obj/lianhuan_jia")->wear();
    carry_object(__DIR__ "obj/zhuying_toukui")->wear();
    carry_object(__DIR__ "obj/wuyun_xue")->wear();
    carry_object(__DIR__ "obj/yaopai")->wear();
    return;
  } else if (rank == "zhihui shi") {

    carry_object(__DIR__ "obj/wuyin_qiang")->wield();
    carry_object(__DIR__ "obj/zhan_pao")->wear();
    carry_object(__DIR__ "obj/lianhuan_jia")->wear();
    carry_object(__DIR__ "obj/zhuying_toukui")->wear();
    carry_object(__DIR__ "obj/wuyun_xue")->wear();
    carry_object(__DIR__ "obj/yaopai")->wear();
    return;
  } else
    return;
}
