inherit BROOM;
void create() {
  set("short", HIR "府衙大门" NOR);
  set("long", @LONG
开封府管辖东京及四周州县，因为是京师王廷之所在，故而地位高于一般府
衙，十分特殊；大门前仪仗甚众，执事彩旗纷天，好一条软绣天街。百姓俗称其
为“南衙”。东廊下有一块石碑，刻有历任知府之名；北面经过一个牌楼是一个
大院，尽处一座高大的正堂，正面全不设门，关户大开，衙役捕快甚众。
LONG);
  set("exits", ([
    "south": __DIR__ "xinz_dajie1",
    "north": __DIR__ "fuya_pailou",
  ]));
  set("objects", ([
  ]));
  set("detail", ([
  ]));
  set("outdoors", "capital");
  setup();
}
