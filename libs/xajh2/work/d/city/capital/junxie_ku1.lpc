// 汴京 junxie_ku1.c
#include <room.h>
#include <ansi.h> 
#include "bianjing.h"
inherit SROOM;
void create()
{
	set("short",RED"军械库房"NOR);
	set("long", @LONG    
这里是天武军的一间军械库房。里面放着禁军士兵使用的刀枪斧戟，弓
箭铁弩，以及铠甲，头盔，鞋帽等物，摆放得整整齐齐。有条有理。平时这
里都有专门的士兵把守，由于没有军情，平时也很少使用，有的兵器上面都
生锈了。 
LONG
	);
	set("objects", ([ 
        __DIR__"npc/obj/tieqiang" : 2,
        __DIR__"npc/obj/guangming_jia" : 2,
        __DIR__"npc/obj/junxue" : 2,
    ]));
	set("exits", ([    
	    "south" : __DIR__"caolian_chang2",
    ]));
    set("detail",([
    ]));     
	setup();
}
