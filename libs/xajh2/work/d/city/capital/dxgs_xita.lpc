// 汴京     /d/city/capital/dxgs_xita.c
#include <room.h>
#include <ansi.h>
#include "bianjing.h"

inherit SROOM;

string look_jing();

void create() {
  set("short", HIY "广愿塔" NOR);
  set("long", @LONG
广愿塔俗称西塔，在相国寺三门之前，与东塔相对。均是大唐天宝年间建造
的。风格古朴明快，带有天竺特色。塔身上面雕有各种如来，观音，罗汉，力士
的形象，塔中供奉着佛龛，四周满是信徒贡献的手抄经文。
LONG);
  set("exits", ([
    "east": __DIR__ "dxgs_dayuan1",
    "west": __DIR__ "dxgs_xilang2",
  ]));
  set("detail", ([
    "经文": "众多的经文中，有一卷" YEL "般若心经" NOR "，特别引人注目。\n",
    "般若心经": (: look_jing :),
  ]));
  set("objects", ([
  ]));
  setup();
}

void init() {
  ::init();
}

string look_jing() {
  return (@TEXT
    这本般若心经字体清秀美观，纸质白皙光滑。首页上写着一行
  小字：
  
    故李氏国主宫人乔氏，伏遇故主百日，谨舍昔时赐妾手书般若
  心经一卷于相国寺西塔院。伏愿弥勒尊前，持一花而见佛......
  ..............................
TEXT);
}
