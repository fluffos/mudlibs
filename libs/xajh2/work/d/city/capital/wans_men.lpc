#include <room.h>
#include <ansi.h> 
#include "bianjing.h"
inherit GATE;
void create()
{
	set("short",HIW "万胜门" NOR);
	set("long", @LONG
万胜门又叫作开远门，通远门。城门外建有巨大的椭圆型瓮城，纵横各百步，
城门有三重，三道城门屈曲而开，不在同一条直线上，以便增加防御能力。城门
上建有高大的门楼，登上门楼，城外数十里尽收眼底。
LONG
	);
	set("objects", ([ 
                  __DIR__"npc/gate_shibing" : 2,
                  __DIR__"npc/dutou2" : 1,
         ]));
	set("exits", ([ 
                  "north" : __DIR__"guzi_men",
                  "south" : __DIR__"xinz_men",
         ]));
        set("detail",([
        ]));
        set("outdoors", "capital");
	setup();
}
