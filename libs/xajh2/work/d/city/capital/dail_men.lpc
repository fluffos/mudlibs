#include "bianjing.h"
inherit GATE;
void create()
{
	set("short", HIW "戴楼门" NOR);
	set("long", @LONG
环绕汴京的外城城墙是用从郑州虎牢关取来的土筑成，城墙多曲折，顺着地
势而走，形似卧牛。城门除了南熏，新郑，朝阳和通天四正门设直门两重以通御
路外，其余的都是翁城相套，三重城墙，城门都不在一条直线上。
LONG
	);  
	set("objects", ([ 
                  __DIR__"npc/gate_shibing" : 2,   
                  __DIR__"npc/gate_yuhou" : 1,
         ]));    
	set("exits", ([ 
                  "east" : __DIR__"nanx_men",
                  "northwest" : __DIR__"xinz_men",
         ]));
        set("detail",([
        ]));
        set("outdoors", "capital");
	setup();
}
