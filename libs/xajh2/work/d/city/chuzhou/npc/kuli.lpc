inherit NPC;

void create() {
  set_name("苦力", ({ "ku li", "coolie", }));
  set("gender", "男性");
  set("age", random(18) + 18);
  set("long", @LONG
这是个满头大汗地在码头上搬运东西的苦力。
LONG
  );
  set("chat_chance", 5);
  set("chat_msg", ({
    "苦力扛着麻袋一步一步的沿着跳板小心的走上船。\n",
    "苦力喘了口气，又搬起一个大木箱。\n",
    "苦力刚想偷偷休息一下，就被士兵发现了，士兵开始凶狠的咒骂起来。\n",
  }));
  set("combat_exp", 1000);
  set("social_exp", 2000);
  set("positive_score", 50);
  set("negative_score", 10);
  set("kee", 400);
  set("max_kee", 400);
  set("eff_kee", 400);
  set("sen", 400);
  set("max_sen", 400);
  set("eff_sen", 400);
  setup();

  carry_object(CLOTH_DIR "cloth2")->wear();
  add_money("coin", 1 + random(5));
}
