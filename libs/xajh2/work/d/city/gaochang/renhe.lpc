// dali_renhe.c

inherit ROOM;

void create() {
  set("short", "仁和车行高昌分号");
  set("long", @LONG
    这里就是有名的仁和车行的高昌分号。由于高昌远处西北，交通
不便，所以有此车行。但是这个分店只运送小孩子，不知道是什么道理。
这里周围有很多人在转悠，不知道都在打着什么鬼主意。
LONG
  );
  set("exits", ([
    "north": __DIR__ "dongmen",
  ]));
  set("objects", ([
    __DIR__ "npc/asan": 1,
  ]));
  setup();
}

int valid_leave(object me, string dir) {
  if (me->query_temp_marks("booked_mache"))
    return notify_fail("你应该快上马车了，不要再随便跑开。\n");

  else if (me->query_temp_marks("waiting_mache"))
    return notify_fail("你正在等马车呢，不要随便走开。\n");
  else return ::valid_leave(me, dir);
}
