inherit RENHE;
void create() {
  set_name("阿三", ({ "ah san", "san", "waiter" }));
  set("title", "仁和车行伙计");
  set("gender", "男性");
  set("location", "高昌");
  set("age", 18);
  set_hp("gin", 500);
  set_hp("kee", 700);
  set("max_force", 6000);
  set_hp("sen", 700);
  set_wugong("haofeng-quan", 70);
  set_wugong("tianhong", 70);
  set_xiuwei_by_type("unarmed", 1000);
  set_xiuwei_by_type("dodge", 1000);
  set("combat_exp", 50000);
  set("long", "阿三看起来就是一付很是精明的样子，难怪仁和车行会把\n"
    "高昌分号交给他管。\n");
  set("attitude", "friendly");
  setup();
  carry_object(CLOTH_DIR "cloth1")->wear();
}
