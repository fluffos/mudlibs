inherit NPC;



void create() {
  set_name("镖局弟子", ({ "biaoju dizi", "dizi" }));
  set("gender", "男性");
  set("long", @LONG
这个是凤翔镖局的一个趟子手，长的膀大腰圆，是个汉子。
LONG
  );
  set("str", 18);
  set("con", 22);
  set("age", 24);
  set("combat_exp", 2000);
  set("social_exp", 200);
  set_wugong("jiben-quanfa", 50, 50, 1);
  set_wugong("changquan", 10, 10, 1);
  set_wugong("jiben-qinggong", 60, 60, 1);
  set_wugong("xingyun-shenfa", 5, 5, 1);
  set_xiuwei_by_type("unarmed", 150);
  set_xiuwei_by_type("dodge", 140);
  create_zuzhi("凤翔镖局", 4, "趟子手");
  setup();
  carry_object(CLOTH_DIR "cloth6")->wear();
}
