inherit NPC;
#include "biaoju_master.h"
#include "biaoju_npc.h"



void create() {
  set_name("李天成", ({ "li tiancheng", "biaotou", "li" }));
  set("gender", "男性");
  create_zuzhi("凤翔镖局", 2, "镖头");
  set("long", @LONG
这是凤翔镖局的一个镖头，在镖局干了十几年了，江湖阅历很丰富。
据说李镖头原是无量派的弟子，使的一手好剑。
LONG
  );
  set("str", 21);
  set("con", 22);
  set("age", 32);
  set("can_teach", 1);
  set("combat_exp", 10000);
  set("social_exp", 3000);

  set_wugong("haoran-zhengqi", 30, 30, 1);

  set_wugong("jiben-qinggong", 80, 80, 1);
  set_wugong("wuliang-shenfa", 60, 60, 1);
  set_wugong("yanxing", 40, 40, 1);

  set_wugong("sword", 80, 80, 1);
  set_wugong("wuliang-jian", 80, 80, 1);

  set_xiuwei_by_type("sword", 400);
  set_xiuwei_by_type("dodge", 350);

  create_family("无量剑派北宗", 7, "弟子");
  setup();
  carry_object(CLOTH_DIR "mabu_kuanshan")->wear();
  carry_object(BOOTS_DIR "baodi_kuaixue")->wear();
  carry_object(SWORD_DIR "changjian")->wield();

}
