inherit ROOM;

#include <ansi.h>



void create() {
  set("short", RED "鸳鸯酒楼" NOR);
  set("long", @LONG
精美豪华的鸳鸯酒楼，红粉柱，蓝玉瓦，醉娇娘，四处人声鼎沸，划拳喝彩声不断。
这里是扬州最大的酒楼，供应着五湖四海的名菜，也会聚着五湖四海的朋友英雄，
美酒飘香，佳人摇曳，真是人间酒仙何处去...唯有鸳鸯可解忧！
LONG
  );
  set("no_fight", 1);
