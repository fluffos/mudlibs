inherit ROOM;
#include <ansi.h>



void create() {
  set("short", YEL "至止堂" NOR);
  set("long", @LONG
堂屋正中悬一幅青松图，墨沉淋漓，未同凡响。两边挂一幅对联。西壁贴一
孔子像，下一红木方桌，左右各一红木雕花太师椅。边上立一书架，架上贴一张
学规，摆着几匣书籍。此处就是增先生授课之处。
LONG
  );
  set("no_kill", "yangzhou");
  set("no_clean_up", 0);

  set("exits", ([ /* sizeof() ==  */
    "south": __DIR__ "chongya_shuyuan",
  ]));
  set("detail", ([ /* sizeof() == */
    "对联": @LONG

               花      读 
               鸟      书
               怡      养
               情      性
LONG,
  ]));
  set("objects", ([ /* sizeof() == */
    __DIR__ "npc/zeng_chengzhan": 1,
  ]));
  setup();
  //place_program(ROOM);
}
