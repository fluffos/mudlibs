#include <weapon.h>
#include <ansi.h>
#include <mudlib.h>
#include <command.h>
inherit SWORD;

inherit F_SAVE;
inherit F_AUTOLOAD;
void create() {
  set_name(WHT "春子" NOR + RED "剑" NOR, ({ "chunzi jian" }));
  set_weight(500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long", @LONG           
            一把千年寒玄铁打造的古剑，宝石剑鞘上刻着子鼠的图纹。
        剑身长约三尺，剑柄上用金铜嵌丝盘成四个篆字
LONG
      YEL "                         春   泽   子   鼠  \n" NOR);
    set("value", 600000);
    set("cant_sell", "千年的古物小的怎么敢收，你还是还给神仙好了。\n");
    set("material", "steel");
    set("wield_msg", "$N将剑从宝石剑鞘中抽出来," RED "只见血光四射,顿时杀气逼人！！！\n" NOR);
    set("unwield_msg", "$N将手中的$n插入腰间的宝石剑鞘。\n");
  }
  init_sword(50);
  setup();
}
