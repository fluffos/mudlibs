#include <weapon.h>
#include <ansi.h>

inherit BLADE;



void create() {
  set_name("长刀", ({ "chang dao", "dao", "blade" }));
  set_weight(2500);
  set("long", "一把木鞘的刀，长约三尺，看上去很普通。\n");
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("value", 1000);
    set("material", "iron");
  }
  init_blade(35);
  set("wield_msg", "$N「唰」的一声抽出一把$n，握在手中，寒气逼人。。\n");
  set("unwield_msg", "$N将手中的$n插入腰间。\n");
  setup();
}
