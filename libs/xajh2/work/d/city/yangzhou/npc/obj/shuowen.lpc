// jianshu.c

inherit ITEM;



void create() {
  set_name("「说文解字」", ({ "shuowen jiezi", "book", "shu" }));
  set_weight(300);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "本");
    set("long", "这本书封皮有点旧，上面写着「说文解字」几个字。\n");
    set("value", 1000);
    set("material", "paper");
    set("skill", ([
      "name": "literate",
      "xiuwei_required": 0,
      "literate_required": 0,
      "gin_cost": 15 + random(10),
      "max_lingwu": 50,
      "bonus_jilei": 6,
      "bonus_social_exp": 2,
      "max_social_exp": 1000,
    ]));
  }
}
