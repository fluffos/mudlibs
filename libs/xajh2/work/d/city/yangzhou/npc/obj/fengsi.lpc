#include <ansi.h>
#include <armor.h>
inherit WAIST;
void create() {
  set_name(YEL "凤銮金丝带" NOR, ({ "fengsi dai", "dai", "waistband" }));
  set_weight(50);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一根用百种鸟的羽毛编制成的金丝腰带。\n");
    set("unit", "根");
    set("value", 350000);
    set("material", "silk");
    set("armor_prop/armor", 10);
  }
  setup();
}
