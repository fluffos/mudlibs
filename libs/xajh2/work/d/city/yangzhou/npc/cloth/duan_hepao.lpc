#include <armor.h>

inherit CLOTH;



void create() {
  set_name("短褐袍", ({ "duan hepao", "cloth" }));
  set_weight(1500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "套");
    set("value", 1400);
    set("material", "cloth");
    set("armor_prop/armor", 2);
  }
  setup();
}
