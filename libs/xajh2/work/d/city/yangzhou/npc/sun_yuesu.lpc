inherit NPC;

int ask_riddle();



void create() {
  set_name("孙月素", ({ "sun yuesu", "sun", "yuesu" }));
  set("gender", "女性");
  set("nickname", "探春使者");
  set("age", 18);
  set("long", @LONG
晕雨桃花为貌，惊风杨柳成腰。轻盈细步别生娇，更喜双弯纤小。云鬓乌连云鬏，
眉尖青到眉梢。漫言当面美难描，便是影儿也好。
LONG);

  set("per", 28);
  set("int", 28);

  set_temp("apply/attack", 25);
  set_temp("apply/defense", 25);
  set("combat_exp", 5000);

  set("attitude", "peaceful");
  /*	set("inquiry", ([
		"猜谜" : (: ask_riddle :),
		"谜语" : (: ask_riddle :),
	]) );
*/
  setup();
  set("chat_chance", 10);
  set("chat_msg", ({
  }));
  //	carry_object(__DIR__"obj/wcloth")->wear();
  //	carry_object(__DIR__"obj/dongbula");
}

void init() {
  ::init();
  //	add_action("do_answer","answer");
  add_action("do_enjoy", "enjoy");
}


int do_enjoy() {
  string msg;

  msg = "孙月素一面命小婢添香，一面携琴敛容，屏气抚之，极目送手挥之妙，清韵悠扬，\n" +
    "弦音嘹亮，既而宫为徽，渐觉激昂慷慨，悲壮淋漓，其声宏以远，其调高以亢，\n" +
    "细听之，盖如《胡笳十八拍》也。\n";

  message_vision(msg, this_player());
  message_vision("$N大赞道：“高山流水，不亚伯牙！\n", this_player());

  return 1;
}
