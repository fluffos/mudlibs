//Npc : shusheng.c
//by trill 05/07/97

inherit NPC;

string talk_me();



void create() {
  set_name("书生", ({ "shu sheng", "sheng" }));
  set("title", "崇雅书院学生");
  set("gender", "男性");
  set("age", 21);
  set("long", @LONG
一个温文尔雅的年轻男子，正抱着一本书在读，却也不知道是什么书。
LONG
  );
  set("attitude", "peaceful");
  set("combat_exp", 12000);
  set("social_exp", 10000);
  set("positive_score", 1000);
  set("str", 20);
  set("cor", 18);
  set("cps", 20);
  set("per", 24);
  set_wugong("literate", 50, 50, 0);
  set("talk_msg", ({
    (: talk_me :)
  }));
  setup();
  carry_object(CLOTH_DIR "baiduan_shan")->wear();
  carry_object(HEAD_DIR "qingsha_jin")->wear();
  carry_object(WAIST_DIR "yaqing_tao1")->wear();
  carry_object(BOOTS_DIR "sixie")->wear();
}

string talk_me() {
  object me = this_player();
  command("shake " + me->query("id"));
  message_vision("书生对$N说道：增先生说做学问的当要专心致志，不可荒废时光。\n", me);
  return "不要再整天闲聊了.\n";
}
