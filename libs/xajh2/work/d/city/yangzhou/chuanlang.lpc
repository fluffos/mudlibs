//Yangzhou : chuanlang.c 穿廊
inherit ROOM;


void create() {
  set("short", "穿廊");
  set("long", @LONG
左右院内略略有几点山石，山下为洞室，山前有池水。隔水望去，有一种无
限幽深的感觉。池水深莫可测，偶然有鱼来游，倏忽而没。穿廊上吊着一些个笼
子，笼着各色禽鸟。穿廊的西壁，嵌有《颜鲁公三表》，随读随行，碑尽而身转，
只见尽头有厅，颜以额「梅船轩」。
LONG
  );
  set("no_clean_up", 0);
  set("exits", ([ /* sizeof() == 2 */
    "south": __DIR__ "mengting",
    "north": __DIR__ "meichuan_xuan"
  ]));
  set("objects", ([ /* sizeof() == 1 */
    __DIR__ "npc/yahuan": 1
  ]));
  setup();
  //place_program(ROOM);
}
