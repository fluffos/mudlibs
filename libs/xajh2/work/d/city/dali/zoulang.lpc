#include <room.h>
#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "中走廊");
  set("long", @LONG
这是条连接大厅和内宅的走廊，呈“T ”字型，飞檐红柱，大理石铺就的地
面一尘不染，两个衣着光鲜的小丫鬟认真正在擦洗两边的栏杆和柱子，走廊向北
通向内宅。不时见丫鬟们匆匆走过。偶尔传来银铃般的笑声。
LONG
  );
  set("exits", ([
    "southeast": __DIR__ "donglang",
    "north": __DIR__ "beilang",
    "southwest": __DIR__ "xilang",
  ]));

  setup();
  //place_program(ROOM);
}
