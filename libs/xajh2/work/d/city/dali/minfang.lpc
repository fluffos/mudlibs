// rooms:/d/dali/dongxiang.c

#include <room.h>

inherit ROOM;

void create() {
  set("short", "民宅");
  set("long", @LONG
一进门便是一个小天井，天井里方了许多盆茶花，虽不是什么名种，却也千
姿百态，万紫千红。院旁还放了一个大鱼缸，里面好象养了好多金鱼。天井往里
便是堂屋，到处粉刷一新，布置得颇是雅致，显见这户人家还颇为殷实。两旁有
几间厢房，不过门都是紧闭着。
LONG
  );
  set("exits", ([
    "north": __DIR__ "xiangdao",
  ]));
  set("objects", ([
    __DIR__ "npc/popo": 1,
  ]));
  setup();
}

void init() {
  add_action("do_open", "open");
}

int do_open(string arg) {
  if (!arg || arg != "door") return notify_fail("你要开什么？\n");
  if (arg == "door")
    return notify_fail("这是人家的内屋，怎么能随便闯进去呢？\n");
}
