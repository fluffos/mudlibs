// /d/city/dali/npc/obj/yuchang.c changed by cry 9.18.98

#include <weapon.h>
#include <ansi.h>
#include <mudlib.h>
#include <command.h>
inherit SWORD;

inherit F_SAVE;
inherit F_AUTOLOAD;
void create() {
  set_name(BLU "鱼肠剑" NOR, ({ "yuchang jian", "jian", "yuchang" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long", @LONG           
            一把样式奇特的古剑，青铜剑鞘上刻着古朴的花纹。
        剑身长约二尺，柄长却有将近一尺；剑柄上用赤铜嵌丝
        盘成两个篆字
LONG
      RED "                         鱼   肠\n" NOR);
    set("value", 400000);
    set("cant_sell", "这可是宝贝，不过小的听说武林中人都在想法搞到这柄剑。小的要是\n"
      "收下，这条命可就......\n");
    set("material", "steel");
    set("wield_msg", "$N将剑从剑鞘中抽出来," BLU "只见青光一闪,顿时寒气逼人！\n" NOR);
    set("unwield_msg", "$N将手中的$n插入腰间的剑鞘。\n");
  }
  init_sword(45);
  setup();
}
