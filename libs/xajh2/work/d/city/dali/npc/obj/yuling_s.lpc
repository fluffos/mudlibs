inherit ITEM;
void create() {
  set_name("玉灵散", ({ "yuling san", "san" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "付");
    set("long", "这是一种能起死回生的伤药。\n");
    set("value", 1000);
  }
  setup();
}

void init() {
  add_action("do_drink", "tun");
}


int do_drink() {
  object me;
  me = this_player();
  message_vision("$N将玉灵散放入口中，随即盘坐在地。..\n\n\n\n", me);
  me->disable_player("「打坐」");
  remove_call_out("effect");
  call_out("effect", 5, me);
  return 1;
}
int effect(object me) {
  me->set("eff_kee", (int)me->query("max_kee"));
  me->set("kee", (int)me->query("max_kee"));
  me->set("eff_gin", (int)me->query("max_gin"));
  me->set("gin", (int)me->query("max_gin"));
  me->set("eff_sen", (int)me->query("max_sen"));
  me->set("sen", (int)me->query("max_sen"));
  message_vision("$N站了起来\n\n\n", me);
  tell_object(me, "你觉得精神焕发\n");
  me->enable_player();
  destruct(this_object());
  return 1;
}
