// banfu.c  
#include <weapon.h>

inherit AXE;

void create() {
  set_name("板斧", ({ "ban fu", "axe" }));
  set_weight(18000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long", "这是一把沉重的板斧，是古笃诚的看家兵器。\n");
    set("value", 2000);
    set("material", "iron");
    set("wield_msg", "$N抽出一把$n握在手中。\n");
    set("unwield_msg", "$N放下手中的$n。\n");
  }
  init_axe(30);
  set("flag", SECONDARY);
  setup();
}
