inherit NPC;
void create() {
  set_name("皇宫侍卫", ({ "shi wei", "wei" }));
  set("title", "");
  set("age", 22);
  set("gender", "男性");
  //        set("long", "这是一名京中调来的禁军士兵。他身穿轻甲，头戴铁盔\n"
  //                    "手里拿着一杆长矛。\n");
  set("str", 40);
  set("per", 25);
  set("combat_exp", 100000);
  set_wugong("lingxiao-shou", 100, 100, 1);
  set_xiuwei("unarmed", 1200);
  set_xiuwei("dodge", 1200);
  set("force_factor", 10);
  set("chat_chance_combat", 10);
  set("chat_msg_combat", ({
    "皇宫侍卫喝道：何方奸贼，竟敢硬闯皇宫？\n",
    "皇宫侍卫喝道：来人哪，有反贼！\n",
  }));
  setup();
  carry_object(__DIR__ "obj/junfu")->wear();
  carry_object(__DIR__ "obj/kaijia")->wear();
  carry_object(__DIR__ "obj/toukui")->wear();
  carry_object(__DIR__ "obj/yaopai")->wear();
}
int accept_fight(object me) {
  command("say 我看你今天是活得不耐烦了," + RANK_D->query_rude(me) + ",去死吧！\n");
  //        me->apply_condition("killer", 100);
  kill_ob(me);
  return 1;
}
