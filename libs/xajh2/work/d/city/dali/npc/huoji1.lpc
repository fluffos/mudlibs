inherit NPC;
inherit F_VENDOR;

void create() {
  set_name("伙计", ({ "huo ji", "waiter" }));
  set("title", "药铺");
  set("gender", "男性");
  set("age", 17);
  set("long", "一个看起来很勤快的年轻人，正忙忙碌碌地走来走去。\n");
  set("str", 29);
  set("int", 14);
  set("combat_exp", 25000);
  set("attitude", "friendly");
  set_xiuwei_by_type("unarmed", 300);
  set("vendor_goods", ([
    "云南白药": MED_DIR "baiyao",
    "蛇毒药": MED_DIR "sheyao",
  ]));

  setup();
  add_money("coin", 500);
  carry_object(CLOTH_DIR "cloth2")->wear();

}

void init() {
  object ob;

  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
  add_action("do_vendor_list", "list");
}

void greeting(object ob) {
  if (!ob || environment(ob) != environment()) return;
  switch (random(4)) {
    case 2:
      say("伙计问道：请问客官是要看病还是买药？\n");
      break;
  }
}
