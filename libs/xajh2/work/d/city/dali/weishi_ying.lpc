#include <room.h>
#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "卫士营");
  set("long", @LONG
这里是王府卫士们的住处，整整齐齐的一排平房。镇南王府的卫士都是由四
大护卫严格考核后录用的，个个身手不凡，大理段氏虽是皇族却很尊敬武林人氏
段王爷更是善待自己的部下，所以江湖上有不少豪杰投身王府甘做卫士，当然每
月的俸禄也极为丰厚。只是四大护卫的要求十分严格，录用的只是前来应聘者中
极少数。王府卫士也分金、银、铜、铁四等，以金衣卫士为尊，铁衣卫士最次。
LONG
  );
  set("exits", ([
    "southwest": __DIR__ "wuchang",
    "west": __DIR__ "xiaoxiang",
  ]));

  setup();
  //place_program(ROOM);
}
