inherit NPC;



void create() {
  set_name("小园工", ({ "xiao yuangong", "yuangong" }));
  set("gender", "男性");
  set("age", 15);
  set("long", "一位年轻的小园工\n");
  set("str", 12);
  set("int", 24);
  set("combat_exp", 500);
  set("attitude", "friendly");
  set_wugong("sword", 30, 29, 1);
  set_wugong("unarmed", 30, 28, 1);
  set_xiuwei("unarmed", 200);
  set_xiuwei("dodge", 200);
  set_xiuwei("sword", 200);

  setup();
  add_money("coin", 15);
  carry_object(__DIR__ "obj/cloth")->wear();
  //	carry_object(__DIR__"obj/scissors")->wield();  pig qyz
}
