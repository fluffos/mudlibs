//qyz & falcon
//let player can change a master when he becomes strong...
string change_master(object who)
{
    string msg;
    object me;

    me = this_player();
    if ( me->query("family/family_name") != "无量剑派东宗" )
        return "这位" + RANK_D->query_respect(me) + "说笑了, 老朽无德无能, 何言指点.\n";
    // 如果还没有 master, 就先指定商余庆. 不过怎么可能没有呢!!!
    if ( !me->query("master") )
    {
        me->set( "master", "shang yuqing" );
        msg = "从今天起，你就去跟商余庆师兄学习本门基本武功吧。\n";
    }
    else if ( me->query("defeat_master")!=me->query("master") )
    {
        if ( !me->query_temp("fight_master") )
        {
            me->set_temp("fight_master", me->query("master"));
            printf( "左子穆沉思了一会...\n" );
            msg = sprintf( "好，你去跟%s比试一下，再做决定吧。\n",
                master_name(me) );
        }
        else
        {
            printf( "左子穆有些发怒。\n" );
            msg = sprintf( "好高骛远，是学不好功夫的，你还是先跟%s多学点东西再说。\n",
                master_name(me));
            me->add("class_score/无量剑派东宗", -1);
        }
    }
    else
    {
        me->delete("defeat_master");
        me->delete_temp("fight_master");
        switch ( me->query("master") )
        {
            case "shang yuqing":
                me->set( "master", "qu lianxing" );
                msg = "好，你现在可以去跟曲连兴师兄学习了。\n";
                LOG_D->do_log(me, "你击败了商余庆而获准向曲连兴学习更高深的武功。");
                break;

            case "qu lianxing":
                me->set( "master", "rong ziju" );
                msg = "嗯，不错，现在就让你容师叔来指导你吧。\n";
                LOG_D->do_log(me, "你击败了曲连兴，并获准向容子矩请教更高深的武功。");
                break;

            case "rong ziju":
                me->set( "master", "zuo zimu" );
                msg = "好徒儿，从今天开始，为师亲自指点于你！\n";
                LOG_D->do_log(me, "在你击败容子矩后，左子穆对你特别赏识，并决定全心培养你。");
                break;

            // 我认为 zuo 在这儿应该是给一个令牌什么的
            case "zuo zimu":
                me->set("marks/悟剑居", 1);
                msg = "你武功已至如此境界，看来足以领悟悟剑居中本派的武学精华。\n";
                LOG_D->do_log(me, "你武功终于大成，你被左子穆获准去参修无量剑最高深的武功－－石壁绝学。");
                //"你可以到\n悟剑居去参修本派的至高武学。\n";
        }
    }
    return msg;
}

string master_name( object me )
{
    string master_id;
    master_id = me->query("master");
    switch ( master_id )
    {
        case "shang yuqing" : return "你商师兄";
        case "qu lianxing" : return "你曲师兄";
        case "rong ziju" : return "你容师叔";
        case "zuo zimu" : return "为师我";
        default : error( "master_name" );
    }
}

//lnwm:here is for 四川的无名老人

string about_yubi( object me )
{
	string msg;

	me = this_player();

	if ( me->query("family/family_name") != "无量剑派东宗" )
	{
		message_vision(CYN"\n左子穆冷冷地看了$P一眼：这是我无量的地方，关你什么事？！\n"NOR, me );
		msg = "以后请不要再问这个问题。";
		return msg;
	}

	if ( me->query("lnwm/maowu/问左子穆") == 1 )
	{
		if ( me->query("class_score/无量剑派东宗") >= 500 )
		{
			if ( !random(20) )
			{
				tell_object( me, CYN"\n左子穆稍稍犹豫了一下：你最好不要再问这个问题。\n"NOR);
				tell_object( me, CYN"左子穆深深地看了你一眼：当年你的一位师叔就是在参看玉壁的秘密后突然失踪的。\n"NOR);
				me->delete("lnwm/maowu/问左子穆");
				me->set("lnwm/maowu/师叔" , 1 );
				msg = "玉壁是我无量的秘密，你现在还是不知道的好些，去吧。\n";
				return msg;
			}
			else
			{
				msg = "玉壁是我无量的秘密，你现在还是不知道的好些，去吧。\n";
				return msg;
			}
		}
		else
		{
			tell_object( me, CYN"\n左子穆略微有些不快：你问这个问题做什么？\n"NOR);
			msg = "你还是想想如何为师门多做些贡献吧。";
			return msg;
		}
	}
	else
	{
		tell_object( me , CYN"\n左子穆一脸茫然。\n"NOR);
		msg = "你怎么想起来问这个问题呢？";
		return msg;
	}
}


//Hydra:add for 出师 19980507
string leave_east( object me )
{
    object this;
    me = this_player();
    this = this_object();

    if( me->query("hydra/出师/无量剑派东宗"))
    {
        return "你不是已经出师了吗？";
    }
    if( me->query("family/family_name") != "无量剑派东宗" )
    {
        command( "? "+me->query("id") );
        return "你又不是我无量东宗之人，何来出师之说。";
    }

    if( me->query( "class_score/无量剑派东宗" ) < 1000 )
    {
        message_vision(CYN"$N对$n道：“你在我门下多年，却不尽心为师门"
"效力，怎么就想离开了呢？”\n"NOR,this,me );
        me -> add( "class_score/无量剑派东宗",-10);
        return "你还是先为光大师门多干点事吧！\n";
    }

    if( me->query_jibie("liuyun-jian") > 90 )
    {
        if(!me->query("marks/悟剑居") )
        {
            me -> add( "class_score/无量剑派东宗",-10);
            return "你功夫未成，还是在我手下多学几年吧。\n";
        }
        else if( me->query("age") < 20 )
        {
            message_vision(CYN"$N对$n说道：“你年纪轻轻就出去，人家会以为我无量"
"无人的。”\n"NOR,this,me);
            me -> add( "class_score/无量剑派东宗",-10);            
            return "过两年再说吧。\n";
        }
        else
        {
             command( "snow "+me->query("id"));
             message_vision(CYN"$N看看了$n，道：“既然这样，我也知道留你不住了。"
"出去了可不要忘了为师和你的师兄弟们啊。\n"NOR,this,me);
             me -> delete("marks/悟剑居");
             me -> delete("master");
             me -> set("title","普通百姓");
             me -> delete("family");
             me -> delete("class");
             me -> set("hydra/出师/无量剑派东宗",1);
             get_sword(me);
             LOG_D->do_log(me,sprintf("你获得了左子穆的允许，从无量东宗出师。\n"));
             log_file("chushi",sprintf("%s(%s)于%s顺利从无量东宗出师。\n",me->query("name"),
                getuid(me),ctime(time()) ) );
             message_vision("$N恭恭敬敬地跪了下来，向$n磕了四个响头。\n",me,this);
             return "罢了，罢了。。。";
         }
    }
    else
    {
        return "学艺未精，出去岂非给我无量东宗丢脸！";
    }
    return "";
}        

void get_sword( object me )
{
    object *inv;
    inv = all_inventory( me );
    foreach( object ob in inv )
    {
        if( ob->query("id")=="chang jian" 
            && ob->query("name")==HIY"长剑"NOR )
        {
            say(CYN"左子穆说道，“你身上的剑就不要带着了吧。\n"
            "说着把你身上的长剑拿走了。\n"NOR );
            ob -> move(environment(me));
            destruct(ob);
         }
    }
}
