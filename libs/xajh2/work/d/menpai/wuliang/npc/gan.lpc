// gan_ghao.c
#include <ansi.h>
inherit NPC;



void create() {
  set_name("干光豪", ({ "gan ghao", "gan" }));
  set("title", "无量剑派东宗第六代弟子");
  set("long", "干光豪长相俊逸，但眉目之间透着一股奸诈之色。\n");
  set("gender", "男性");
  set("age", 25);  //gifts
  set("str", 25);
  set("int", 25);
  set("per", 24);
  set("combat_exp", 200000);  //other 参数
  set("social_exp", 100000);
  set("positive_score", 2000);
  set("class_score", 700);
  set("attitude", "herosim");
  set("force", 600);
  set("max_force", 600);
  set("force_factor", 5);
  set("kee", 500);
  set("max_kee", 500);
  //skills
  set_wugong("unarmed", 70, 70, 0);
  set_wugong("nanshan-liushi", 60);
  set_wugong("haoran-zhengqi", 40, 30, 1);
  set_wugong("sword", 70);
  set_wugong("wuliang-jian", 50, 40, 1);
  //set_wugong("parry",50,30,1);
  set_xiuwei("sword", 100);
  set_xiuwei("dodge", 100);
  set_xiuwei("unarmed", 100);
  create_family("无量剑派东宗", 6, "弟子");
  setup();
  carry_object(__DIR__ "obj/cloth")->wear();
  carry_object(__DIR__ "obj/jian2")->wield();
  add_money("silver", 1);
}

void init() {
  object ob;
  ::init();
  if (interactive(ob = this_player()) && !is_fighting()
    && !ob->query("hydra/出师/无量剑派东宗")) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
}

void greeting(object ob) {
  if (!ob || ob->query("family/family_name") == "无量剑派东宗") return;
  say("干光豪微笑着说：“这位" + RANK_D->query_respect(ob) +
    "，家师便在此地，有事请说吧。”\n" NOR);
}

int recognize_apprentice(object who) {
  if (who->query("marks/gan_礼物")
    && who->query("family/family_name") == "无量剑派东宗")
    return 1;
  return 0;
}

int accept_object(object who, object what) {
  if (who->query("family/family_name") != "无量剑派东宗") return 1;
  if (what->value() < 100000)  //  this is 10 gold
  {
    command("tell " + who->query("id") + " 嘿嘿，就这么点东西来打发我？");
    return 0;
  } else if (!who->query("marks/gan_礼物")) {
    // so we can learn from him
    who->set("marks/gan_礼物", 1);
    command("tell " + who->query("id") + " 嗯，算你小子聪明，以后你就可以来让我指点你了。");
  } else
    command("tell " + who->query("id") + " 呵呵，我就不好意思了。");
  call_out("dest", 1, what);
  return 1;
}

int dest(object what) {
  destruct(what);
  return 1;
}
