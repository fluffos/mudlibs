// shang_yuqing.c

inherit NPC;

#include "east_master.h"

string *wugong = ({
  "基本拳法", "基本剑法", "基本轻功", "凌霄拿云手", "南山六式"
});

string ask_qingjiao(object who);
string ask_wugong(object who);



void create() {
  set_name("商余庆", ({ "shang yuqing", "shang", "yuqing" }));
  create_family("无量剑派东宗", 6, "弟子");
  set("gender", "男性");
  set("age", 36);

  set_wugong("unarmed", 70, 70, 1);
  set_wugong("taizu-quan", 30, 30, 1);
  set_wugong("wuliang-shenfa", 30, 30, 1);
  set_wugong("jiben-qinggong", 70, 70, 1);
  set_wugong("sword", 70, 70, 1);
  set_wugong("wuliang-jian", 30, 30, 1);
  set_wugong("haoran-zhengqi", 30);
  set_xiuwei("unarmed", 600);
  set_xiuwei("sword", 600);
  set_xiuwei_by_type("dodge", 600);

  set("max_force", 500);
  set("force", 500);
  set("force_factor", 5);
  set("combat_exp", 20000);

  set("inquiry", ([
    "请教": (: ask_qingjiao :),
    "学习": (: ask_qingjiao :),
    "职责": "我同曲连兴负责看守通往后山的要道, 同时我们也传授刚入门的"
    "师弟们本门的基本武功.",
    "后山": "后山是本门禁地, 未得掌门人同意, 不能进入.",
    "功夫": (: ask_wugong :),
    "武功": (: ask_wugong :),
  ]));

  setup();
  carry_object(__DIR__ "obj/cloth")->wear();
}

void init() {
  add_action("do_leave", "go");
}

int do_leave(string arg) {
  if (arg == "eastup") {
    object me;

    me = this_player();
    message_vision("商余庆拦住了$N，说：'后山是本派重地，你请回吧。'\n", me);
    return 1;
  }
}

string ask_qingjiao(object who) {
  return "如果掌门人让你来向我请教, 那么你可以向我学习本门基本武功了.";
}

string ask_wugong(object who) {
  return "你可以向我学..." + wugong[random(sizeof(wugong))] + "...";
}
