// gong_gjie.c
#include <ansi.h>
inherit NPC;



void create() {
  set_name("龚光杰", ({ "gong gjie", "gong" }));
  set("long", "龚光杰长得五大三粗，但不知为什么，极得掌门的信任。\n");
  set("gender", "男性");
  create_family("无量剑派东宗", 6, "弟子");
  set("age", 28);
  set("str", 25);
  set("int", 25);
  set("per", 19);
  set("combat_exp", 150000);
  set("social_exp", 60000);
  set("class_score", 1000);
  set("positive_score", 3000);
  set("attitude", "herosim");

  set("force", 600);
  set("max_force", 600);
  set("force_factor", 3);

  set_wugong("unarmed", 70);
  set_wugong("nanshan-liushi", 60, 60, 1);
  set_wugong("jiben-qinggong", 60, 60, 1);
  set_wugong("haoran-zhengqi", 50);
  set_wugong("sword", 70, 60, 1);
  set_wugong("wuliang-jian", 50);
  set_wugong("liuyun-jian", 40, 40, 1);
  set_xiuwei_by_type("sword", 1000);
  set_xiuwei_by_type("dodge", 1100);
  set_xiuwei_by_type("unarmed", 1200);
  setup();
  carry_object(__DIR__ "obj/cloth")->wear();
  carry_object(__DIR__ "obj/jian2")->wield();
  add_money("silver", 1);
}

void init() {
  object ob;
  ::init();
  ob = this_player();

  if (interactive(ob) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
    if (ob->query("class_score/无量剑派东宗") < -50 && ob->query("family/family_name") == "无量剑派东宗") {
      message_vision("龚光杰对$N大喝一声：“小子！你竟然背着师门干出如此多坏事。\n"
        "今日我要为师门清理门户！”", ob);
      set_leader(ob);
      command("kill " + ob->query("id"));
      ob->fight_ob(this_object());
    }
  }
}

void greeting(object ob) {
  if (!ob || ob->query("family/family_name") == "无量剑派东宗") return;
  if (ob->query("hydra/出师/无量剑派东宗")) {
    message_vision("龚光杰拉着$N的手，“原来是$N啊，不忘师恩，又回来拉！”\n", ob);
    return;
  }
  say("龚光杰瞪着你：“你是要拜师的吧？还不快快见过掌门。”\n");
}

int recoginize_apprentice(object who) {
  if (who->query("family/family_name") != "无量剑派东宗") return 0;
  else if (who->query("class_score") < 1000) {
    tell_object(who, "龚光杰说：“你再为师门做些好事再来吧。”");
    return 0;
  } else return 1;
}

int accept_object(object ppl, object obj) {
  object gold;

  if (obj->query("id") != "tie xia")
    return 0;
  if (query("box")) {
    message_vision("龚光杰冲着$N大喝道：“周老太爷怎么会让你送两个礼盒？！"
      +RANK_D->query_rude(ppl) + "竟敢欺骗老夫！”\n", ppl);
    kill_ob(ppl);
    ppl->fight_ob(this_object());
    remove_call_out("Dest");
    call_out("Dest", 1, obj);
    return 1;
  }

  if (ppl->query("mud_age") < 3600 * 24 * 2        //如果玩家年龄在十六以下
  && ppl->query("combat_exp") < 50000           //或经验不足一万，
  && ppl->query("max_force") < 1000)            //或内力不足三百，则否认
  {
    message_vision("龚光杰上下打量了$N许久，突然嘿嘿冷笑道：“哼！就凭你\n"
      + "这么点道行，也能走镖？你是怎么来的，还不老实交代！！”\n",
      ppl);
    kill_ob(ppl);
    ppl->fight_ob(this_object());
    remove_call_out("Dest");
    call_out("Dest", 1, obj);
    return 1;
  }

  message_vision("龚光杰拍拍$N肩头，笑了笑道：“很好，不愧是周老太爷的镖师。\n"
    + "这些是你走镖的报酬，拿好哦。”\n", ppl);
  call_out("Dest", 1, obj);
  set("box", 1);
  gold = new(MONEY_DIR + "gold");
  gold->set_amount(10);
  gold->move(ppl);
  command("chat 恭喜，" + ppl->query("name") + "(" + ppl->query("id") + ")" + "走镖成功，获得十两金子的报酬。");
  return 1;
}

void Dest(object obj) {
  destruct(obj);
}
