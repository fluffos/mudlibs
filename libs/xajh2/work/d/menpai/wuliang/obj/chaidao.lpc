// chaidao.c

#include <weapon.h>

inherit DAGGER;



void create() {
  set_name("砍柴刀", ({ "chai dao", "dao" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long", "这是一把锋利的砍柴刀。");
    set("value", 20);
    set("material", "steel");
  }
  init_dagger(10);

  set("wield_msg", "$N从腰间抽出一把锋利的$n握在手中。\n");
  set("unwield_msg", "$N将手中的$n别在腰间。\n");

  setup();
}

void init() {
  add_action("do_kan", "kan");
}

int do_kan(string arg) {
  object me;
  me = this_player();
  if (!arg || (arg != "柴" && arg != "chai")) return 0;
  if (arg == "柴" || arg == "chai") {
    if (!environment(me)->query("woods"))
      return notify_fail("这里怎么能砍柴呢？\n");

    if (me->query_temp("kan_chai"))
      return notify_fail("你已经在砍柴了呀！\n");
    if ((int)me->query("sen") < 60)
      return notify_fail("你现在累得不行，怎么能再去砍柴呢？\n");
    message_vision("$N拿起手中的砍柴刀，在林子里砍起柴来....\n"
      , me);
    me->start_busy(15);
    me->set_temp("kan_chai", 1);
    call_out("doing_kan", 1, me);
    return 1;
  }
}

int doing_kan(object me) {
  if (me->query_temp("kan_chai") < 4) {
    message_vision("$N不断地砍着，手边的柴越来越多...\n", me);
    me->receive_damage("sen", 20);
    me->add_temp("kan_chai", 1);
    call_out("doing_kan", 5, me);
    return 1;
  } else {
    message_vision("终于，$N砍了一大捆柴，扛到了肩上。\n", me);
    new(MISC_DIR "chai")->move(me);
    me->delete_temp("kan_chai");
    return 1;
  }
}
