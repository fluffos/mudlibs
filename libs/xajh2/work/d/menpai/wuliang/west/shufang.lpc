inherit ROOM;

string *book = ({
  "guwen",
  "taigong",
  "xiangshu",
  "shuowen",
});



void create() {
  set("short", "书房");
  set("long", @LONG
这是西宗掌门的书房。右边是书架，上面陈列着道家和儒家的一些典籍，却
没有一本与武学有关的书。左边靠窗的地方摆着一张木桌，上面放着笔墨纸砚，
边上放着几本书，摆放的整整齐齐搽，拭的一尘不染，看来天天有人收拾的。只
是砚台里的墨却干涸已久，不知何时能再用一会。
LONG
  );
  set("no_clean_up", 0);
  set("exits", ([ /* sizeof() == 1 */
    "west": __DIR__ "xishi_lu2",
  ]));

  //set("no_fight",1);
  set("search_things", ([
    "书架": CLONE_DIR + "book/" + book[random(sizeof(book))],
    "木桌": CLONE_DIR + "book/" + book[random(sizeof(book))],
  ]));
  set("objects", ([
    CLONE_DIR + "book/shu": 1,
  ]));
  setup();
}

//操!
void init() {
  add_action("do_yi", "yi");
}

int do_yi(string arg) {
  return notify_fail("移你个头啊.\n");
}
