// daogu.c

inherit NPC;
#include "west.h"



void create() {
  set_name("西宗弟子", ({ "dizi" }));
  set("title", "");

  set("gender", "男性");
  set("age", 18);
  set("no_kill", "west_wuliang");

  set("str", 20);
  set("cor", 20);
  set("cps", 20);
  set("per", 20);
  set("int", 24);

  set("attitude", "heroism");

  set("max_force", 100);
  set("force", 100);
  set("force_factor", 1);

  set("long", @LONG
他是一位无量剑派西宗的弟子。正在练习无量剑法中的无边落木这一招。
LONG
  );

  set("combat_exp", 3000);
  create_family("无量剑派西宗", 6, "弟子");

  //	set("chat_chance_combat", 25);
  //	set("chat_msg_combat", ({
  //	}) );

  setup();

  carry_object(__DIR__ "obj/sword")->wield();
  carry_object(CLOTH_DIR + "cloth2")->wear();
}
