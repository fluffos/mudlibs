#include <room.h>

inherit ROOM;


void create()
{
	set("short","绝崖");
	set("long",@LONG
这里已没有出路，前面是一道深渊，隐隐能听到从下面传来隆隆的响声。
西北角上一条大瀑布从高崖直泻而下，便如潮水大至一般。这里已到了山路的
尽头，再也无法往前走了。
LONG);
	set("exits", ([
		"south" : __DIR__"milin1",
	]));
	setup();
}

void init()
{
    add_action("do_tiao","tiao");
}

int do_tiao(string arg)
{
    object me;
    int kar;

    me = this_player();
    kar = me->query("kar");
    if ( !arg || arg == "" ) return 0;
    if ( arg == "jueya" )
    {
   		message( "vision",
			me->name()+"咬了咬牙，纵身跃下旁边深不见底的绝崖。\n",
//     		environment(me), ({me}) );
      		me );
        if ( ( kar + random( 25 ) ) > 30 )
        {
      		message_vision(
				"$P挺身一跃，朝着深渊跳下去，只觉耳旁风声呼呼，你的\n"
      			"身体不住地下飞坠......\n",me);       
      		message_vision(
				"突然，你撞到一棵大松树上，被弹出丈许，落到一处崖缝\n"
      			"之间，摔了个半死。\n",me);
            me->move(__DIR__"yafeng");
			printf( "here, u should be unconcious\n" );
            //me->unconcious();
        }
        else
        {
      		message_vision(
				"你挺身一跃，朝着深渊跳下去，只觉耳旁风声呼呼，你的\n"
      			"身体不住往下坠......\n",me);
      		message_vision("慢慢地，你失去了知觉......\n", me);
			printf( "here, u should be dead\n" );
            //me->die();
        }
		return 1;
    }
}
