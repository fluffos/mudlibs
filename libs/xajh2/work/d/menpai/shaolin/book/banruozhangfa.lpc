//banrozhangfa.c般若掌法
//dou
inherit ITEM;

//Added hydra 98/10/7
int invalid_study(object me) {
  if (me->query("shaolin/can_read_miji") <= 0) {
    tell_object(me, "你发现你现在的佛法难于化解你习武带来的戾气，结果什么"
      + "都没有学习进去\n");
    return 1;
  } else {
    me->add("shaolin/can_read_miji", -4);
    return 0;
  }
}




void create() {
  set_name("般若掌法", ({ "banruo zhangfa", "zhang fa", "shu" }));
  set_weight(400);
  set("cant_sell", "这么一本破书，你还拿来卖！\n");
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "本");
    set("long", "少林的般若掌法,封面用黄色绸锻包裹着。 \n");
    set("value", 10000);
    set("material", "paper");
    set("skill", ([
      //提高技能的名字
      "name": "banruo-zhang",
      "max_jibie": 120,
      //如果这本书是长级别的，那麽不再判断领悟比
      //是否小于<90,否则就当领悟比小于<90,必须去练了。
      "bonus_jibie": 0,
      "gin_cost": 6 + random(3),
      "literate_required": 80,
      "xiuwei_required": 1000,
      //每次获得的修为
      "bonus_xiuwei": 0,
      //最高可获得的修为，即当player修为大于
      //max_xiuwei就不能再长修为了。
      "max_xiuwei": 1200,
      //以下是长combat_exp和social_exp,和修为类似
    ]));
  }
}
