//mohezhijue.c摩诃指诀
//dou
inherit ITEM;

//Added hydra 98/10/7
int invalid_study(object me) {
  if (me->query("shaolin/can_read_miji") <= 0) {
    tell_object(me, "你发现你现在的佛法难于化解你习武带来的戾气，结果什么"
      + "都没有学习进去\n");
    return 1;
  } else {
    me->add("shaolin/can_read_miji", -4);
    return 0;
  }
}



void create() {
  set_name("摩诃指诀", ({ "mohe zhijue", "zhi jue", "shu" }));
  set_weight(600);
  set("cant_sell", "这么一本破书，你还拿来卖！\n");
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "本");
    set("long", "浅兰色的封面上印着一双手，右手的中指斜向下点出，这就是“摩诃指诀” \n");
    set("value", 10000);
    set("material", "paper");
    set("skill", ([
      //提高技能的名字
      "name": "mohe-zhi",
      //该player的修为必须大于xiuwei_required
      "xiuwei_required": 1000,
      //该player的literate必须大于literate_required,否则读不懂。
      "literate_required": 90,
      //每次耗的经神
      "gin_cost": 15 + random(10),
      //能读到的最高级别。
      "max_jibie": 150,
      //如果这本书是长级别的，那麽不再判断领悟比
      //是否小于<90,否则就当领悟比小于<90,必须去练了。
      "bonus_jibie": 0,
      //每次获得的修为
      "bonus_xiuwei": 0,
      //最高可获得的修为，即当player修为大于
      //max_xiuwei就不能再长修为了。
      "max_xiuwei": 1100,
      //以下是长combat_exp和social_exp,和修为类似
      "bonus_combat_exp": 25,
      "max_combat_exp": 30000,
      "bonus_social_exp": 25,
      "max_social_exp": 30000,
    ]));
  }
}
