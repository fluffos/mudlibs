inherit ROOM;



void create() {
  set("short", "山涧");
  set("long", @LONG
你来到一条山涧旁，山涧里的水很清澈，乃是少林寺的饮水之源，所有的用
水大多是从这里挑过去的。水从五乳峰的某个泉里流出来，到这里已经有相当规
模了。水在你身旁缓缓流过，发出淙淙的声响。水里还不停的有几条不知名的鱼
游来游去。
LONG);
  set("exits", ([
    "southeast": __DIR__ "xiaolu3",
  ]));
  if (random(10) > 5)
    set("objects", ([ __DIR__ "npc/heshang5": 1, ]));
  set("outdoors", "shaolin");
  set("resource/water", 1);
  set("fillplace", "山涧");
  setup();
}

