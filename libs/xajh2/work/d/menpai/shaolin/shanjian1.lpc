void init() {
  add_action("da_shui", "fill");
  add_action("da_shui", "da");
}

int da_shui(string arg) {
  object me, tong;
  me = this_player();
  if (!arg || (arg != "水" && arg != "shui" && arg != "tong"))
    return notify_fail("你要打什么？\n");

  if (!me->can_act()) return notify_fail("你现在无法打水。\n");

  if (!tong = present("tie tong", me))
    return notify_fail("你没带桶，怎么打水呀？\n");

  if (arg == "水" || arg == "shui") {
    tell_object(me, "你用铁桶在山涧里打了满满的一桶水。\n");
    tong->set("full_water", 1);
    tong->set("name", "打满了水的铁桶");
    return 1;
  }
  return 1;
}
