inherit NPC;

string ask_for_join();
string ask_for_shaolin();

void setup() {
  mapping my = this_object()->query_entire_dbase();

  if (!my["gender"]) set("gender", "男性");
  if (!my["class"]) set("class", "bonze");
  if (!my["age"]) set("age", 14 + random(30));

  if (!my["inquiry"])
    set("inquiry", ([
      "少林寺": (: ask_for_shaolin :),
      "剃度": (: ask_for_join :),
      "出家": (: ask_for_join :),
    ]));

  if (!my["combat_exp"]) set("combat_exp", 1000);
  if (!my["social_exp"]) set("social_exp", 5000);
  ::setup();
}

string ask_for_shaolin() {
  object me, ob;

  me = this_player();
  ob = this_object();
  message_vision("$N惊讶地望着$n，一脸的不能置信。\n", ob, me);
  return ("你从外星来的吧？连少林寺都没听说过！\n");
}

string ask_for_join() {
  object me;

  me = this_player();

  if ((string)me->query("class") == "bonze")
    return "师弟，别闹了，我正忙着呢。\n";
  if ((string)me->query("gender") != "男性")
    return "阿弥陀佛！女施主，这里是寺庙，请你到尼庵去剃度吧。\n";
  return "阿弥陀佛！善哉！善哉！\n"
    "施主若真心皈依我佛，不妨找慧绝师叔剃度。\n";
}

int valid_teach(object you, string skill) {
  object me = this_object();

  if (you->query("family/family_name") != "少林派")
    return ::valid_teach(you, skill);

  if (random(2)) {
    say(me->query("name") + "微一皱眉，说：哎呀，我现在很忙呀。\n");
    return 0;
  } else {
    say(me->query("name") + "呵呵一笑道：我这点三脚猫的功夫，见不得人的。\n");
    return 0;
  }
}
