#include <ansi.h>

inherit __DIR__ "xu";



void create() {
  seteuid(getuid());
  set_name("虚闲", ({ "xu xian", "xu", "xian", "he shang",
    "seng ren", "bonze" }));
  set("long", @LONG
    虚闲人如其名，是罗汉堂里出名的懒人，练功既不勤奋，也不认真。方丈多
次劝他，他都表面答应回头却依然我行我素。其实他的天资很好，十分聪明。长
辈们常常在背后叹惜这么好的天资可惜浪费了。
LONG
  );
  set("age", 26);

  set("max_force", 200 + random(50));
  set("force", 200 + random(50));
  set("force_factor", 1);

  set_wugong("luohan-quan", 60, 60, 1);
  set_wugong("weituo-zhang", 40, 40, 1);
  set_wugong("jiben-gunfa", 40, 40, 1);
  set_wugong("shaolin-shenfa", 20, 20, 1);
  set_wugong("shaolin-neigong", 20, 20, 0);
  set_xiuwei_by_type("unarmed", 250);
  set_xiuwei_by_type("dodge", 250);
  set_xiuwei_by_type("long", 250);

  set("socail_exp", 12000);

  setup();
  carry_object(CLOTH_DIR "sengyi1")->wear();
}
