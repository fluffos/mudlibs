inherit __DIR__ "seng.lpc";



void create() {
  set_name("种菜和尚", ({ "zhongcai heshang", "heshang", "monk" }));
  set("chat_chance", 6);
  set("chat_msg", ({
    "种菜和尚拿了一个大瓢，慢慢地一瓢一瓢将清水浇到菜地上。\n",
    "种菜和尚蹲到菜园边，拔去园里的杂草。\n",
  }));
  set_wugong("unarmed", 70, 70, 1);
  set_wugong("jiben-qinggong", 70, 70, 1);
  set_xiuwei("dodge", 100);
  set_xiuwei("unarmed", 100);
  setup();
  //    carry_object(__DIR__"obj/cloth4")->wear();
}
