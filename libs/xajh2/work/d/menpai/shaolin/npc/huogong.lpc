// qyz
inherit NPC;


void create() {
  set_name("火工头陀", ({ "huogong toutuo", "toutuo", "monk" }));
  set("gender", "男性");
  set("class", "bonze");
  set("age", 40);
  set("chat_chance", 10);
  set("chat_msg", ({
    "火工头陀拿起一把巨大的铲子，在一口冒着热气的大锅里搅着。\n",
    "火工头陀费力地拉着风箱，并不时偏头看看灶里的火势。\n",
    "火工头陀抽空拿起搭在肩上的毛巾，擦了擦汗，喘了口气又继续干起来。\n",
  }));
  set_wugong("unarmed", 70);
  set_wugong("jiben-qinggong", 100 + random(50));
  set_xiuwei("dodge", 60);
  set_xiuwei("unarmed", 60);
  set("social_exp", 2000);
  set("combat_exp", 10000);
  setup();
}
