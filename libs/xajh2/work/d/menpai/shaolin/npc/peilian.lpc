#include <ansi.h>

inherit NPC;



void create() {
  set_name("武僧", ({ "wu seng", "wu", "seng" }));
  set("gender", "男性");
  set("title", "罗汉堂陪练僧人");
  set("age", 20 + random(30));
  set("long", "一位罗汉堂的僧人，少林武僧。\n");
  set("combat_exp", 8000000);
  set("class", "bonze");
  set("attitude", "peaceful");
  set_wugong("luohan-quan", 160, 160, 1);
  set_wugong("shaolin-shenfa", 160, 160, 1);
  create_family("少林派", 38, "弟子");
  set("no_get", 1);
  set("set", 1);
  set_xiuwei("unarmed", 5000 + random(1000));
  //	set_xiuwei("dodge",2000+random(1000));
  set("max_kee", 4000);
  set("max_sen", 4000);
  set("max_force", 3000);
  setup();
  carry_object(CLOTH_DIR "sengyi3")->wear();
}

void init() {
  ::init();
  if (interactive(this_player()) && this_player()->query_temp("peilian") >= 1) {
    remove_call_out("greeting");
    call_out("greeting", 0);
  }
}

void power_up() {
  object me = this_player();
  int mx = 0;
  mapping xiuwei = me->query_xiuwei_map();
  if (sizeof(xiuwei))
    foreach (string x, int v in xiuwei) {
      if (v > mx) mx = v;
    }
  set_xiuwei_by_type("unarmed", mx * 105 / 100);
  set("combat_exp", me->query("combat_exp") * 5 / 4);
  setup();

}

void greeting() {
  object me = this_player();
  power_up();
  kill_ob(me);
}
