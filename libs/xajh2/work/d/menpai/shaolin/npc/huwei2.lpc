inherit __DIR__ "guard.lpc";



void create() {
  set("max_force", 1000);
  set("force", 1000);
  set("force_factor", 20);

  create_family("少林派", 38, "弟子");
  delete("title");
  set_wugong("luohan-quan", 100, 100, 1);
  set_wugong("weituo-zhang", 80, 80, 1);
  set_wugong("fuhu-quan", 60, 60, 1);
  set_wugong("shaolin-shenfa", 60, 60, 1);
  set_wugong("shaolin-neigong", 40, 40, 1);
  set_xiuwei("dodge", 1000);
  set_xiuwei("unarmed", 1000);

  setup();
  carry_object(CLOTH_DIR "sengyi1")->wear();
}

void init() {
  object ob;

  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
}

void greeting(object ob) {
  int i, j = 0;
  object *inv;

  inv = all_inventory();
  for (i = 0; i < sizeof(inv); i++)
    if (inv[i]->name() == name()) j++;

  if (!ob || !userp(ob) || !present(ob, environment(this_object()))) return;
  if (ob->query("family/family_name") == "少林派") return;
  say(name() + "说道：里面是少林重地，不得擅闯。\n"
    "这位" + RANK_D->query_respect(ob) + "请回吧。\n");
}
