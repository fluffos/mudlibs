#include <ansi.h>

inherit NPC;

string ask_for_join();
string ask_for_shaolin();

void setup() {
  mapping my = this_object()->query_entire_dbase();

  if (!my["name"])
    set_name("青衣护卫僧", ({ "huwei seng", "huwei", "seng", "monk guard", "monk", "guard" }));
  if (!my["attitude"]) set("attitude", "friendly");
  if (!my["gender"]) set("gender", "男性");
  if (!my["age"]) set("age", 20 + random(30));

  if (!my["class"]) set("class", "bonze");
  if (!my["family"]) create_family("少林派", 38, "弟子");
  if (!my["inquiry"])
    set("inquiry", ([
      "少林寺": (: ask_for_shaolin :),
      "剃度": (: ask_for_join :),
      "出家": (: ask_for_join :),
    ]));


  if (!my["max_force"]) set("max_force", 600);
  if (!my["force"]) set("force", 600);
  if (!my["force_factor"]) set("force_factor", 15);

  if (!my["social_exp"]) set("social_exp", 10000);
  if (!my["combat_exp"]) set("combat_exp", 10000);
  if (!my["positive_score"]) set("positive_score", 800);
  ::setup();
}

void init() {
  object ppl;

  ::init();

  if (!userp(ppl = this_player())
    || !can_act())
    return;

  remove_call_out("Greeting");
  call_out("Greeting", 1, ppl);
}

void Greeting(object ppl) {

  if (!ppl
    || environment(ppl) != environment())
    return;

}
string ask_for_shaolin() {
  object me, ob;

  me = this_player();
  ob = this_object();
  message_vision("$N惊讶地望着$n，一抬手，仿佛想试试$n的额头，但想了想又放了下来。\n", ob, me);
  return "你……没事吧？";
}

string ask_for_join() {
  object me;

  me = this_player();

  if ((string)me->query("class") == "bonze")
    return "师弟，别闹了，我正忙着呢。\n";
  if ((string)me->query("gender") != "男性")
    return "阿弥陀佛！女施主，这里是寺庙，请你到尼庵去剃度吧。\n";
  return "阿弥陀佛！善哉！善哉！\n"
    "施主若真心皈依我佛，不妨前去法堂剃度。\n";
}

int valid_teach(object you, string skill) {
  object me = this_object();

  if (you->query("family/family_name") != "少林派")
    return ::valid_teach(you, skill);

  say(me->query("name") + "微一皱眉，说：哎呀，你看，我现在实在是抽不开身呀。\n");
  return 0;
}

int refuse_killing(object who) {
  int i;
  object *inv;

  inv = all_inventory(environment());
  for (i = 1; i < sizeof(inv); i++)
    if (inv[i] != this_object() && !inv[i]->weigong(who))
      continue;
  message_vision(YEL "$N大叫一声：大胆狂徒，居然敢到少林寺来撒野！\n" NOR,
    this_object());
  return 0;
}

int weigong(object who) {
  kill_ob(who);
  return 1;
}
