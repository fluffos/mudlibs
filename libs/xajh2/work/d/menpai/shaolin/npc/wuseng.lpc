#include <ansi.h>
inherit NPC;

string ask_for_join();
string ask_for_shaolin();

void setup() {
  mapping my = query_entire_dbase();

  if (!my["name"]) set_name("武僧", ({ "wuseng", "seng", "monk" }));
  if (!my["gender"]) set("gender", "男性");
  if (!my["age"]) set("age", 18);
  if (!my["class"]) set("class", "bonze");
  if (!my["family"]) create_family("少林派", 38, "弟子");

  if (!my["max_force"]) set("max_force", 500 + random(40));
  if (!my["force"]) set("force", 500 + random(40));
  if (!my["force_factor"]) set("force_factor", 10);

  if (!my["inquiry"])
    set("inquiry", ([
      "少林寺": (: ask_for_shaolin :),
      "剃度": (: ask_for_join :),
      "出家": (: ask_for_join :),
    ]));

  if (!my["social_exp"]) set("social_exp", 2000);
  if (!my["combat_exp"]) set("combat_exp", 10000);
  ::setup();
}

string ask_for_shaolin() {
  object me, ob;

  me = this_player();
  ob = this_object();
  message_vision("$N惊讶地望着$n，一脸的不能置信。\n", ob, me);
  return ("什么？你连少林寺都没听说过吗？\n");
}

string ask_for_join() {
  object me;

  me = this_player();

  if ((string)me->query("class") == "bonze")
    return "阿弥陀佛！师弟何苦开这种玩笑？\n";
  if ((string)me->query("gender") != "男性")
    return "阿弥陀佛！女施主，这里是寺庙，请你到尼庵去剃度吧。\n";
  return "阿弥陀佛！善哉！善哉！\n"
    "施主若真心皈依我佛，不妨找慧绝师叔剃度。\n";
}

void attempt_apprentice(object ob) {
  object me = this_object();

  if ((string)ob->query("gender") != "男性")
    message_vision(CYN "$N脸一红，低头道：“女施主不要跟贫僧开这种玩笑。”\n" NOR, me, ob);
  else if (ob->query("class") != "bonze")
    message_vision(CYN "$N合什道：“小僧武功见识皆不足道，施主取笑了。”\n" NOR, me, ob);
  else
    message_vision(CYN "$N怫然道：“师弟何苦开这种玩笑？”\n" NOR, me, ob);
  return;
}

int valid_teach(object you, string skill) {
  object me = this_object();

  if (you->query("family/family_name") != "少林派")
    return ::valid_teach(you, skill);

  say(me->query("name") + "脸色微红，说：我嘴笨，说不明白，你还是问别人吧。\n");
  return 0;
}

void tell_skills_to_apprenticed(object me) {
  message_vision(
    "$N脸一红道：愚兄姿质愚鲁，武学上的进境反到不如师弟你快捷，真是惭愧。\n"
    "不过我听得师父曾言到，少林武学最高的有七十二门绝技，施展起来威力无穷，\n"
    "直逼天人之境。江湖上多有人窥视。我这辈子大概是没指望了，但愿师弟你能有\n"
    "机会研习。\n", this_object());
  return;
}

int tell_skills(object me) {
  object ob = this_object();

  if (me->query("family/family_name") != "少林派")
    message_vision("$N警觉地望着$n，问道：“你问这个干什么？”\n", ob, me);
  else if (me->query("family/master_id"))
    tell_skills_to_apprenticed(me);
  else message_vision(
    "$N脸色一正道：本门武功以拳脚为主。你过木人巷前能学的，\n"
    "有罗汉拳，韦陀掌，伏虎拳三门拳脚。也能练少许内力。另外轻\n"
    "身健体的功夫也可以抽空练练。\n", ob);
  return 1;
}

int refuse_killing(object who) {
  int i;
  object *inv;

  inv = all_inventory(environment());
  for (i = 1; i < sizeof(inv); i++)
    if (inv[i] != this_object() && !inv[i]->weigong(who))
      continue;
  message_vision(YEL "$N大叫一声：大胆狂徒，居然敢到少林寺来撒野！\n" NOR,
    this_object());
  return 0;
}

int weigong(object who) {
  if (who->query("family/family_name") != "少林派")
    kill_ob(who);
  return 1;
}

// add by xli 1999.3.24
int accept_fight(object who) {
  if ((string)who->query("class") == "bonze") {
    command("say 阿弥陀佛！既然你有意与我切磋切磋，贫僧就奉陪了。");
    //    	this_object()->bihua_ob(who);
    //    	who->bihua_ob(this_object());
    return 1;
  } else
    command("say 施主既然身负绝艺，贫僧佩服便是，也不必较量了。");
  return 0;
}

int accept_bihua(object who) {
  return accept_fight(who);
}
// end
