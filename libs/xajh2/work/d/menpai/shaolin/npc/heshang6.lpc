/*
这个人身上可以设个秘密。比如他当年是个黑道巨擎。 
但千万别象刘安禄一样，一问就杀人。 
*/

inherit __DIR__ "seng.lpc";



void create() {
  set_name("青衣僧人", ({ "qingyi sengren", "sengren", "monk" }));
  set("age", 30);
  set("per", 17 + random(10));
  set("chat_chance", 6);
  set("chat_msg", ({
    "青衣僧人抬头看了会儿佛像，低头嘀咕了几句。\n",
  }));
  set_wugong("unarmed", 120, 120, 1);
  set_wugong("jiben-qinggong", 150, 150, 1);
  set_xiuwei("dodge", 400);
  set_xiuwei("unarmed", 400);
  setup();
  carry_object(CLOTH_DIR "sengyi1")->wear();
}
