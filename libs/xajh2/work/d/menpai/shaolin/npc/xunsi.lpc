#include <ansi.h>
inherit __DIR__ "guard";


void create() {
  set_name("巡寺武僧", ({ "xunsi wuseng", "wuseng", "seng", "monk" }));
  set("gender", "男性");
  set("class", "bonze");
  set("age", 40);
  create_family("少林派", 38, "弟子");
  set("chat_chance", 10);
  set("chat_msg", ({
    "巡寺武僧警惕地审视着周围。\n",
    "巡寺武僧看了你一眼，又转头到另一边。\n",
    (: random_move :),
  }));
  set_wugong("yingzhua-gong", 80 + random(50), 80 + random(50), 1);
  set_wugong("banruo-shenfa", 80 + random(50), 80 + random(50), 1);
  set_wugong("cibei-dao", 100, 100, 1);
  set_xiuwei("dodge", 800 + random(200));
  set_xiuwei("blade", 1000 + random(100));
  set_xiuwei("unarmed", 1000 + random(500));
  set("max_force", 1000 + random(500));
  set("force", query("max_force"));
  set("force_factor", query("max_force") / 11);
  set("social_exp", 20000);
  set("combat_exp", 100000);
  setup();
  carry_object(CLOTH_DIR "jiasha1")->wear();
}
// add by xli 1999.3.26
void init() {
  call_out("greeting", 1, this_player());
}

void greeting(object ob) {
  if (!ob || !present(ob, environment(this_object())) || !userp(ob))
    return;
  if (environment(ob)->query("short") == CYN "法堂" NOR)
    return;
  if (ob->query("family/family_name") != "少林派") {
    message_vision("巡寺武僧盯着$N看了一会，说道：\n", ob);
    message_vision("这位$N施主非我少林弟子，如是来投入我佛门的，自当礼待。\n", ob);

    if (ob->query("xli_marks/meet") >= 6 && !wizardp(ob))  // 碰见六次就请回了，主要是总是两个巡寺武僧一起来。:(
    {
      message_vision("但如果只是来随便看看，我少林向来是清净之地，$N施主这就请回吧！\n", ob);
      message_vision("$N一拱手，呵呵干笑了两下，看见巡寺武僧还是那么面无表情地看着自己，\n", ob);
      message_vision("只好转身离开了...\n", ob);
      ob->move("/d/menpai/shaolin/shanmen");
      ob->delete("xli_marks/meet");
      return;
    }
    message_vision("但如果只是来随便看看，我少林向来是清净之地，$N施主四处走走，也就请回吧！\n", ob);
    ob->set("xli_marks/meet", ob->query("xli_marks/meet") + 1);
    return;
  }

}
