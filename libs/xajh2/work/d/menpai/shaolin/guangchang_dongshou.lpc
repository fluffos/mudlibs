#include <room.h>

inherit ROOM;



void create() {
  set("short", "广场东首");
  set("long", @LONG
广场东首是操习兵器的地方，北首放着一个武器架，架上整齐地摆放着竹木
制成的刀剑棍棒之类的兵器。一位罗汉堂的师傅正在教授一个年轻的武僧一套刀
法。你忽然发现那个武僧很笨，连你都已经看懂了，他却还不明白。东边是罗汉
堂，北边有一座亭子孤零零地竖在那里。
LONG
  );
  set("exits", ([
    "east": __DIR__ "luohan_tang1",
    "west": __DIR__ "guangchang",
    "north": __DIR__ "lixue_ting",
  ]));
  set("outdoors", "shaolin");
  setup();
  //place_program(ROOM);
}
