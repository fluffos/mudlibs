#include <ansi.h>

inherit __DIR__ "xuan.lpc";
inherit F_MASTER;



void create() {
  seteuid(getuid());
  set_name("玄痛", ({ "xuan tong", "xuantong", "xuan", "tong" }));
  set("long", @LONG
他是一位须眉皆白的老僧，当他抬头扫视四周时，眼光无比威严。
在他的目光下，你不禁心里打起了小鼓，不知自己什么时候就会犯
过失，撞在老僧的手里。这位威严的老僧便是少林寺戒律院的首座。
LONG);
  set("title", RED "少林寺" CYN "戒律院" HIM "首座" NOR);
  set("rank_info/respect", "玄痛大师");
  set("gender", "男性");
  set("attitude", "friendly");
  set("class", "bonze1");
  set("family", ([
    "title": "少林寺戒律堂首座",
    "generation": 36,
    "family_name": "少林派",
    "master_name": "灵门",
    "master_id": "ling men",
    "belong": CYN "戒律院" NOR,
  ]));

  set("age", 67);
  set("str", 30);
  set("int", 26);
  set("con", 30);
  set("spi", 30);
  set("kar", 30);

  set("max_kee", 1500);
  set("kee", 1500);

  set("max_force", 4800);
  set("force", 4800);
  set("force_factor", 150);

  set("combat_exp", 700000);
  set("social_exp", 200000);
  set("class_score", 400000);
  set("positive_score", 500000);

  //玄痛功夫以刀法见长 
  set_wugong("xiuluo-dao", 250, 250, 1);          //修罗刀
  set_wugong("wuxiangjie-zhi", 120, 120, 1);   //无相劫指 6
  set_wugong("sanhua-zhang", 130, 130, 0);       //散花掌 5
  set_wugong("qianye-shou", 150, 150, 1);        //大慈大悲千叶手 5
  set_wugong("ruying-suixing", 150, 150, 1);     //如影随形 5
  set_wugong("lixue-bufa", 150, 150, 1);         //立雪步法 4
  set_wugong("banruo-xinfa", 100, 100, 1);    //般若心法
  set_wugong("jiuyang-gong", 200, 200, 1);       //少林九阳功


  set_xiuwei_by_type("unarmed", 4100);
  set_xiuwei_by_type("blade", 4200);
  set_xiuwei_by_type("dodge", 3600);
  set_xiuwei_by_type("zonggang", 2100);

  set("inquiry", ([
    "武功": "少林僧人习武只为健体强身，可不是为了逞强好胜。",
  ]));

  set("no_kill", "shaolin");
  setup();
  carry_object(CLOTH_DIR "jiasha2")->wear();
  carry_object(BLADE_DIR "jiedao");
}

int refuse_killing(object me) {
  command("wield blade");
  return ::refuse_killing(me);
}
