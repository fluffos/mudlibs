#include <ansi.h>

inherit "/d/menpai/shaolin/npc/xu";



void create() {
  set_name("虚缘", ({ "xu yuan", "xu", "yuan", "he shang",
    "seng ren", "bonze" }));
  set("long", @LONG
一个精干的青年僧人，你很容易就注意到，他的手掌似乎比常人
的要大一圈。看来他在掌法方面的造诣一定不低。
LONG
  );

  set("age", 24);

  set_wugong("luohan-quan", 100, 100, 1);
  set_wugong("weituo-zhang", 100, 100, 1);
  set_wugong("fuhu-quan", 80, 80, 1);
  set_wugong("shaolin-shenfa", 60, 60, 1);
  set_wugong("shaolin-neigong", 60);
  set_xiuwei_by_type("unarmed", 440);
  set_xiuwei_by_type("dodge", 370);

  setup();
  carry_object(CLOTH_DIR "sengyi1")->wear();
}
