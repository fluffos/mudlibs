// fang zhang jing she hou yuan shi wu : /d/shaolin/fangzhang_shiwu.c

inherit ROOM;

void init();
int do_strike(string);



void create() {
  set("short", "方丈石屋");
  set("long", @LONG
这是一间既没有门，也没有窗的石屋。历代方丈都曾来过这里闭关静修。石
屋中除了一些必要的饮食之外，可以说一无所有。这里没有明显的出口。四周都
是巨大的石块堆砌而成。
LONG
  );

  setup();
}

void init() {
  add_action("do_strike", "strike");
}

int do_strike(string arg) {
  object me = this_player();
  int frc = this_player()->query("force");
  int sfrc = this_player()->query_skill("force", 1);

  if (arg != "wall") return command("climb " + arg);

  message_vision("$N运足内力，向石屋的墙上猛击过去。\n", me);
  me->set("force", 0);

  if (frc < 200) {
    message_vision("结果掌力尽数反击到身上，石墙纹丝不动。\n", me);
    me->receive_damage("kee", 40, me);
  } else {
    message_vision("你眼前石屑纷飞，一股巨大的力量把你冲了出去。\n", me);
    if (sfrc < 101) {
      message_vision("你的基本内功有所增强。\n", me);
      me->improve_skill("force", random(me->query("con") + me->query("int")));
    }
    message_vision("你醒来的时候，发现自己躺在方丈精舍的后院里。\n", me);

    me->move(__DIR__ "fangzhang_houyuan");
  }

  return 1;
}
