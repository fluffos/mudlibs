inherit ROOM;



void create() {
  set("short", "心禅堂");
  set("long", @LONG
这是一座幽静的禅堂，里面除了几樽佛像和几张旧蒲团外，没有什么多余的
东西。这里是历代长老修禅之处。禅堂外是茫茫的竹林，把这里和外面的世界隔
离开来。
LONG
  );
  set("exits", ([
    "south": __DIR__ "houshan_zhulin3",
    "north": __DIR__ "houshan_zhulin7",
  ]));

  setup();
}
