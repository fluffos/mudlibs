// 素火腿
//suhuotui.c
//by leonhart

inherit ITEM;
inherit F_FOOD;



void create() {
  set_name("素火腿", ({ "su huotui", "huotui" }));
  set_weight(100);  //一两
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "份");
    set("value", 200);
    set("food_remaining", 3);
    set("food_supply", 40);
    set("gifts", ([
      "int": 2,
    ]));
  }
  setup();
}
