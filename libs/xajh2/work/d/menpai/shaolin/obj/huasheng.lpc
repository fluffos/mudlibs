// long 有待改进
inherit ITEM;
inherit F_FOOD;



void create() {
  set_name("花生", ({ "hua sheng" }));
  set_weight(100 + random(100));
  set("cant_sell", "少林的庙产，小的可不敢收。\n");
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一碟葱翠的花生。\n");
    set("unit", "碟");
    set("value", 10);
    set("food_remaining", 4);
    set("food_supply", 15);
  }
}
