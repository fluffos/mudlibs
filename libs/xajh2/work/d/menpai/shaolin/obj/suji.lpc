// 素鸡
//suji.c
//by leonhart

inherit ITEM;
inherit F_FOOD;



void create() {
  set_name("素鸡", ({ "su ji" }));
  set_weight(100);  //一两
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "份");
    set("value", 200);
    set("food_remaining", 4);
    set("food_supply", 35);
    set("gifts", ([
      "cps": 2,
    ]));
  }
  setup();
}
