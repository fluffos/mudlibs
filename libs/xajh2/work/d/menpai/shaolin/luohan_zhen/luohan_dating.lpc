#include <ansi.h>

#define OUT "/d/menpai/shaolin/luohan_tang2"

inherit ROOM;



void create() {

  set("short", "罗汉大厅");
  set("long", @LONG
这是一间非常宽敞的大厅。红砖铺地，四根柱子撑起足有三丈来高的屋顶。
大厅四四方方，横竖大概皆有好几十丈，少林闻名天下的十八罗汉在此处布下的
十八罗汉大阵，数百年来，武林中尚无几人可以破解。相传自少林派前辈神僧自
创一套‘罗汉伏魔神功’并用之以十八罗汉的阵法中后，此阵遂成为艺绝天下的
奇阵之一。同时也成为少林弟子师从玄字辈高僧所必须经历的考验之处。
LONG);
  set("objects", ([
    __DIR__ "npc/huisi": 1,    //  降龙伏虎在此
    __DIR__ "npc/huitong": 1,
  ]));

  set("not_startroom", 1);
  setup();

}

void welcome_visitor(object me) {
  object npc1, npc2;
  //    object *things;
  //    int i;

  if (environment(me) != this_object()) return;

  if (!me->query("hydra/shaolin/闯罗汉阵")) return;

  if (!objectp(npc1 = present("hui si", this_object())))
    if (!objectp(npc1 = find_living("hui si")))
      npc1 = new(__DIR__ "npc/huisi");
  if (!objectp(npc2 = present("hui tong", this_object())))
    if (!objectp(npc2 = find_living("hui tong")))
      npc2 = new(__DIR__ "npc/huitong");
  npc1->move(this_object());
  npc2->move(this_object());

  if (me->query("xli_marks/闯阵失败")) {
    message_vision("\n慧思伸手在$N肩上轻轻拍了一下。\n", me);
    message_vision(BLU "慧思对$N说道：“罗汉大阵乃我少林绝学，未能闯过也只是武学造诣未能达到！”\n" NOR, me);
    message_vision("慧通手挽兰花，指向$N。\n", me);
    message_vision(GRN "慧通对$N说道：“勤学苦练而不辍，假以时日，想来你并不是不能通过此阵的！”\n" NOR, me);
    message_vision(HIY "慧思道：如此，我送你出去吧。\n说着打开了暗门，"
      "$n昂首走了出去。\n\n" NOR, me);
    me->delete("xli_marks/闯阵失败");
    me->delete("xli_marks/闯罗汉阵");
    me->delete("xli_marks/defeat_huisi");
    me->delete("xli_marks/defeat_huitong");
    me->set("hydra/shaolin/闯阵失败", 1);
    me->move(OUT);
  } else {
    if (me->query("xli_marks/闯阵成功")) {
      message_vision("\n慧思对$N微一颔首。\n", me);
      message_vision(BLU "慧思对$N说道：“你闯过少林第一大阵，也算是本派登峰造极的几人之一！”\n" NOR, me);
      message_vision("慧通对$N打量了几眼。\n", me);
      message_vision(GRN "慧通对$N说道：“少林武学，博大精深，虽闯过罗汉大阵，仍须努力修炼！”\n\n" NOR, me);
      message_vision(HIY "慧思道：如此，我送你出去吧。\n说着打开了暗门，"
        "$N昂首走了出去。\n\n" NOR, me);
      me->delete("xli_marks/闯阵成功");
      me->delete("xli_marks/闯罗汉阵");
      me->delete("xli_marks/defeat_huisi");
      me->delete("xli_marks/defeat_huitong");
      me->set("hydra/shaolin/闯阵成功", 1);
      me->move(OUT);
    } else {
      message_vision(BLU "\n慧思对$N说道：“有勇气闯我罗汉大阵，不愧为少林弟子！”\n" NOR, me);
      message_vision(GRN "慧通对$N说道：“武学精进之道，在思而不在斗，你好自为之吧！”\n\n" NOR, me);
      /*        message_vision("慧思对$N说道：“我少林规矩，闯罗汉大阵必须赤手空拳，你的随身物品就暂时放在这里吧！\n",me);
        things=all_inventory(me);
        for(i=0;i<sizeof(things);i++)
            things[i]->move(this_object());
*/
      message_vision(HIY "只见慧思扯动阵形，向$N攻来。\n\n" NOR, me);
      me->set("xli_marks/闯罗汉阵", 1);
      me->delete("xli_marks/defeat_huisi");
      me->delete("xli_marks/defeat_huitong");
      me->move(__DIR__ + sprintf("neiting%d", random(8) + 1));
    }
  }
}
