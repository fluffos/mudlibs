// huiran.c 十八罗汉之智慧罗汉
#include <ansi.h>

inherit NPC;



void create() {
  set_name("慧然", ({ "hui ran", "hui", "monk" }));
  set("long", @LONG
他是一位须发花白的老僧，身穿一袭金边红色袈裟。他身材瘦高，
太阳穴高高鼓起，似乎身怀绝世武功。
LONG);

  set("title", YEL "智慧罗汉" NOR);
  set("gender", "男性");
  set("attitude", "friendly");
  set("class", "bonze");

  set("age", 54);
  set("str", 25);
  set("int", 32);
  set("con", 25);
  set("dex", 25);
  set("per", 30);
  set_hp("kee", 1000);
  set_hp("sen", 500);
  set("force", 2500);
  set("max_force", 2500);
  set("force_factor", 80);
  set("combat_exp", 3500000);
  set("class_score", 5000);
  set("positive_score", 4000);
  set("social_exp", 5000);
  set("env/attack", 75);

  set_wugong("banruo-shenfa", 150, 140, 1);
  set_wugong("shaolin-xinfa", 120, 100, 1);
  set_wugong("duoluoye-zhi", 100, 100, 1);
  set_wugong("fuhu-quan", 100);

  set_xiuwei_by_type("unarmed", 2000);
  set_xiuwei_by_type("dodge", 2000);
  set_xiuwei_by_type("zonggang", 500);

  create_family("少林派", 37, "弟子");

  setup();

  carry_object(CLOTH_DIR "hong-jiasha")->wear();
}

#include "xli_hui.h"
