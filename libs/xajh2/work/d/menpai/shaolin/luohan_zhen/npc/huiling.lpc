//huisi.c 十八罗汉之须弥罗汉
#include <ansi.h>
inherit NPC;



void create() {
  set_name("慧灵", ({ "hui ling", "hui", "monk" }));
  set("long", @LONG
他是一位须发花白的老僧，身穿一袭金边红色袈裟。他身材瘦高，
太阳穴高高鼓起，似乎身怀绝世武功。
LONG);


  set("title", YEL "须弥罗汉" NOR);
  set("gender", "男性");
  set("attitude", "friendly");
  set("class", "bonze");

  set("age", 40);
  set("str", 25);
  set("int", 25);
  set("con", 25);
  set("dex", 25);
  set_hp("kee", 1000);
  set_hp("sen", 700);
  set_force(3000, 3000, 300);

  set("combat_exp", 4000000);
  set("class_score", 5000);
  set("positive_score", 3000);
  set("social_exp", 5000);
  set("env/attack", 75);

  set_wugong("banruo-shenfa", 185, 160, 1);
  set_wugong("shaolin-xinfa", 120, 100, 1);
  set_wugong("longzhua-shou", 100, 100, 1);
  set_wugong("fuhu-quan", 60);

  set_xiuwei_by_type("unarmed", 5301 + random(10000));
  set_xiuwei_by_type("dodge", 5301);
  set_xiuwei_by_type("zonggang", 300);

  create_family("少林派", 37, "弟子");

  setup();

  carry_object(CLOTH_DIR "hong-jiasha")->wear();
}


#include "xli_hui.h"
