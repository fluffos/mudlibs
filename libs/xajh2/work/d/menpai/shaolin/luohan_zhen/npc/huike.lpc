// huiran.c 十八罗汉之旃檀罗汉
#include <ansi.h>
inherit NPC;



void create() {
  set_name("慧可", ({ "hui ke", "hui", "monk" }));
  set("long", @LONG
他是一位须发花白的老僧，身穿一袭金边红色袈裟。他身材瘦高，
太阳穴高高鼓起，似乎身怀绝世武功。
LONG);

  set("title", YEL "旃檀罗汉" NOR);
  set("gender", "男性");
  set("attitude", "friendly");
  set("class", "bonze");

  set("age", 44);
  set("str", 25);
  set("int", 22);
  set("con", 25);
  set("dex", 25);
  set("per", 20);
  set_hp("kee", 1000);
  set_hp("sen", 500);
  set_force(4000, 4000, 400);
  set("combat_exp", 3000000);
  set("class_score", 5000);
  set("positive_score", 4000);
  set("social_exp", 5000);
  set("env/attack", 75);

  set_wugong("banruo-shenfa", 150, 140, 1);
  set_wugong("shaolin-xinfa", 120, 100, 1);
  set_wugong("ranmu-daofa", 100, 100, 1);
  set_wugong("fuhu-quan", 100);

  set_xiuwei_by_type("blade", 8701);
  set_xiuwei_by_type("dodge", 2500);
  set_xiuwei_by_type("zonggang", 3000);

  create_family("少林派", 37, "弟子");

  setup();

  carry_object(CLOTH_DIR "hong-jiasha")->wear();
  carry_object(BLADE_DIR "jiedao")->wield();
}


#include "xli_hui.h"
