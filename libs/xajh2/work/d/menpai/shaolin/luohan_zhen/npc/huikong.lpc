// huikong.c 十八罗汉之精进罗汉
#include <ansi.h>
inherit NPC;



void create() {
  set_name("慧空", ({ "hui kong", "hui", "monk" }));
  set("long", @LONG
他是一位须发花白的老僧，身穿一袭金边红色袈裟。他身材瘦高，
太阳穴高高鼓起，似乎身怀绝世武功。
LONG);

  set("title", YEL "精进罗汉" NOR);
  set("gender", "男性");
  set("attitude", "friendly");
  set("class", "bonze");

  set("age", 44);
  set("str", 25);
  set("int", 32);
  set("con", 25);
  set("dex", 25);
  set("per", 30);
  set_hp("kee", 1000);
  set_hp("sen", 600);
  set_force(3000, 3000, 300);
  set("combat_exp", 36000000);
  set("class_score", 5000);
  set("positive_score", 4000);
  set("social_exp", 5000);
  set("env/attack", 75);

  set_wugong("banruo-shenfa", 150, 140, 1);
  set_wugong("shaolin-xinfa", 120, 100, 1);
  set_wugong("duoluoye-zhi", 100, 100, 1);
  set_wugong("fuhu-quan", 100);

  set_xiuwei_by_type("unarmed", 7000 + random(10000));
  set_xiuwei_by_type("dodge", 2000);
  set_xiuwei_by_type("zonggang", 500);

  create_family("少林派", 37, "弟子");

  setup();

  carry_object(CLOTH_DIR "hong-jiasha")->wear();
}


#include "xli_hui.h"
