// hou shan she lin : /d/shaolin/houshan_shelin.c

inherit ROOM;



void create() {
  set("short", "后山竹林");
  set("long", @LONG
你走在一片茂密的竹林丛中，脚下踩着软软的碎叶，忽然你脚下一滑，低头
一看，踩着的竟然是一条死蛇！耳旁传来沙沙之声，竹叶间伸出一条条青绿色的
蛇影，向你吐出鲜红的舌头。
LONG
  );
  set("exits", ([
    "northwest": __DIR__ "houshan_shelin",
    "north": __DIR__ "houshan_zhulin" + (random(4) + 1),
    "northeast": __DIR__ "houshan_shelin",
    "south": __DIR__ "houshan_shelin",
  ]));

  setup();
}
