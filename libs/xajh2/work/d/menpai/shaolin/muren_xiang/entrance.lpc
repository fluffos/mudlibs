// muren_xiang/entrance
#include <room.h>

inherit ROOM;



void create() {
  set("short", "木人巷入口");
  set("long", @LONG
少林寺的木人巷，在武林之中享有盛名。据说巷中木人，各个做得是栩栩如
生，内中更有强力机簧牵动木人的关节，进身退步颇有法度，无一不合招式。这
里正是木人巷的入口。一进入这里，你身上的所有物品都被拿走，当然在出口处
这些东西都会还给你的。然后你就可以作好准备，拿出全部本领，试试(test)单
凭一双拳头，在一炷香的时间内打出木人巷。木人巷只有八关，但是一关强过一
关。只有连闯八关，你才能正式成为少林弟子。每到一关都有两个机簧牵动的木
人和你交手。只有打败木人，或者是在木人的攻击下支持了一定时辰，才算过了
一关。
LONG);
  set("exits", ([]));
  set("not_startroom", 1);
  setup();
}

void init() {
  object me, *inv, obj;
  int i;
  me = this_player();
  inv = all_inventory(me);

  add_action("do_test", "test");
  add_action("do_quit", "quit");

  for (i = 0; i < sizeof(inv); i++) {
    inv[i]->move(__DIR__ "exit");
  }
  obj = new(CLOTH_DIR "sengyi2");
  obj->move(me);
  obj->wear();

  call_out("do_test", 5, "");
}

int do_quit(string arg) {
  write("临阵脱逃？逃不掉啦，打吧！\n");
  return 1;
}

int do_test(string arg) {
  object me;
  //    int i;

  remove_call_out("do_test");
  me = this_player();
  me->delete_temp("be_defeated");
  CHANNEL_D->do_channel(me, "chat", "少林寺第" +
    CHINESE_D->chinese_number(me->query("family/generation")) +
    "代弟子" + me->name() + "请闯木人巷！\n");
  message_vision("墙上暗门打开，$N凝神屏气，举步向木人巷走去。\n",
    me);
  me->move(__DIR__ "testroom1");
  return 1;
}
