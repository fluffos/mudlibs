inherit ROOM;



void create() {
  set("short", "菜园");
  set("long", @LONG
这里是少林寺的菜园，种着各种的蔬菜，五颜六色，应有尽有。少林的这么
多僧人每天的斋饭所用的蔬菜，全靠这里供给，因此这个菜园很大。几位小沙弥
正在辛勤的劳动着，这也是少林寺弟子刚入门后所必修的功课之一。一位年纪比
较大的僧人正在这里监工。再往西是一条下山的小路，弯弯曲曲的通向山下。
LONG
  );

  set("exits", ([ /* sizeof() == 4 */
    "east": __DIR__ "caiyuan1",
    "west": __DIR__ "xiaolu1",     //这个小路通向小溪另一头，用来挑水的quest
  ]));
  set("objects", ([
    __DIR__ "npc/heshang4": 1,
  ]));
  setup();
  //place_program(ROOM);
}
