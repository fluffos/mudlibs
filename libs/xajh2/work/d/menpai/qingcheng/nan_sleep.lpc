inherit ROOM;



void create() {
  set("short", "男弟子睡房");
  set("long", @LONG
这里是青城派男弟子睡房，供门下弟子休憩之用。睡房被打扫得非常干净，
门后整齐地摆放着许多床铺，被子叠放得井然有序，除此之外并无甚摆设，看来
青城弟子的生活是很简朴的。
LONG);
  set("sleep_room", "青城派");
  set("no_fight", 1);
  set("exits", ([ /* sizeof() == 1 */
    "east": __DIR__ "linyin_dao3",
  ]));
  //	set("no_clean_up", 0);

  setup();
}

void init() {
  object me = this_player();

  if (me->query("gender") != "男性" && !wizardp(me)) {
    write("你跑到男弟子睡房做什么？这里可不是你来的地方...\n");
    me->move(__DIR__ "linyin_dao3");
  }
}
