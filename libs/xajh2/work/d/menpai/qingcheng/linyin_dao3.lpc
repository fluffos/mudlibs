inherit ROAD;



void create() {
  set("short", "林荫道");
  set("long", @LONG
一条碎石铺成的小道，两边种植了许多柳树，微风拂柳之时，树影婆娑，让
人顿觉心底一片空明，格外舒畅。青城弟子常于闲时来此处休憩散心，以稍解一
身的疲劳。道旁有些石椅石凳，几个弟子正在坐着闲聊。
LONG);
  set("exits", ([
    "north": __DIR__ "linyin_dao2",
    "west": __DIR__ "nan_sleep",
    "south": __DIR__ "nv_sleep",
  ]));

  setup();

}
int valid_leave(object me, string dir) {
  if (dir == "west" && (
    me->query("family/family_name") != "青城派"
    || me->query("gender") != "男性"))
    return notify_fail("那是青城派的男弟子睡房，你进去有所不妥吧！\n");
  if (dir == "south" && (
    me->query("family/family_name") != "青城派"
    || me->query("gender") != "女性"))
    return notify_fail("那是青城派的女弟子睡房，你进去有所不妥吧！\n");
  return ::valid_leave(me, dir);
}
