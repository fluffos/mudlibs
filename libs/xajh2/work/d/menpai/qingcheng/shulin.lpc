//   name  :   树林
//   writer:   xli
//   date  :   1998.10
//   Last Modified:xli 1999.9

inherit ROAD;



void create() {
  set("short", "树林");
  set("long", @LONG
一片繁茂的树林，参天大树比比皆是，松柏常青，杨柳迎风，将太阳光遮挡
住了许多，因此树底下非常荫凉。绿油油的小草丛到处都是，野花遍地，看起来
生机勃勃，让你在行走其间时不禁要注意脚下，以免踩着了这花花草草。
LONG);
  set("exits", ([
    "north": __DIR__ "shandao5",
  ]));

  setup();

}

void init() {
  add_action("do_xiudao", "xiudao");
  add_action("do_liangong", ({ "xiulian", "ask", "lian", "fight", "qiecuo", "bihua" }));
}

int do_liangong(string arg) {
  tell_object(this_player(), "你正在修道，还是专心一点吧。\n");
  return 1;
}

int do_xiudao(string arg) {
  object me;
  me = this_player();
  if (!arg) {
    tell_object(me, "你环顾四周，想找一个修道的地方静心修炼。\n");
    tell_object(me, "可是找来找去，觉得没有什么地方可以的。\n");
    tell_object(me, "不禁怅然若失。\n");
    return 1;
  }
  if (arg == "树林") {
    if (me->query("xiudao_time")) {
      tell_object(me, "你已经在修道了，还是专心一点吧。\n");
      return 1;
    }
    me->set_temp("xli_marks/xiudaoing", 1);
    tell_object(me, "你在树林中找了一块平整的地方坐了下来。\n");
    tell_object(me, "你守元归心，开始默默地领会道法中的精妙...\n");
    me->start_busy(40);
    me->set("xiudao_time", 1);
    call_out("do_mosong", 3, me);
    return 1;
  }
}

int do_mosong(object me) {
  int mcps, mkar, mpks, now_daohang, add_point;

  if (me->query("xiudao_time") == 10) {
    tell_object(me, "你略一凝眉，将驰骋天外的心神收了回来，慢慢站起了身。\n");
    tell_object(me, "你细细回味着刚才领悟的要领，只觉确实有着许多不甚明白之处。\n");
    me->delete("xiudao_time");
    mcps = me->query("cps");
    mkar = me->query("kar");
    mpks = me->query("PKS");
    now_daohang = me->query("xli_marks/daohang");
    if (mpks * 10 + 0.5 * (mcps + mkar) + random(150) + 100 - sqrt(now_daohang) < 200) {
      if (now_daohang - 1000 * (int)(now_daohang / 1000) < 100)
        add_point = 1 + random(10 - sqrt(sqrt(now_daohang))) + mcps / 25 + mkar / 25;
      else
        add_point = 3 + random(10 - sqrt(sqrt(now_daohang))) + mcps / 20 + mkar / 20;
      me->set("xli_marks/daohang", now_daohang + add_point);
    }
    return 1;
  }
  if (random(5) > 1) {
    tell_object(me, "你静静地小声诵读着道法的要诀，只觉心神已不为己控，一直飞散开去...\n");
    me->add("xiudao_time", 1);
  } else
    tell_object(me, "你感觉总不得要领，忍不住站了起来，踱了几步，却又只好再坐了下来...\n");
  call_out("do_mosong", 3, me);
  return 1;
}
