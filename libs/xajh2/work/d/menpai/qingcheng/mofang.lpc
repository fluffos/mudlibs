inherit ROOM;



void create() {
  set("short", "磨房");
  set("long", @LONG
青城派向来以素食为主，磨房里每天负责磨制面粉、豆腐等，再送到厨房做
成菜肴，供众人食用。磨房里有一盘很大的石磨，两个磨房弟子正在驱使着一只
驴子磨着面粉，一人赶驴，一人负责加麦子和收拾磨盘。
LONG);
  set("exits", ([
    "south": __DIR__ "xiaodao1",
  ]));
  set("objects", ([
    __DIR__ "npc/bai_laotou": 1,
    __DIR__ "npc/mofang_dizi": 2,
  ]));
  setup();

}
