inherit ROAD;



void create() {
  set("short", "山腰");
  set("long", @LONG
这就是川西青城山的山腰，绿草荫荫，林木繁茂，片片白云围绕头顶，因此
这里常年湿润，不时下雨，路面比较湿滑，行人在此往往放慢脚步，一来是怕走
路跌倒，二来也是欣赏一下这里的山色。
LONG);
  set("exits", ([
    "northdown": __DIR__ "shandao1",
    "eastup": __DIR__ "banshan_ting",
  ]));

  setup();

}
