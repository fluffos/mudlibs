inherit ROOM;
#include "/d/menpai/qingcheng/qc_room.h"


void create() {
  set("short", "练武厅");
  set("long", @LONG
这里是青城派的练武厅，方砖铺地，上面有许多脚印，青城弟子每日清晨就
来此练武，所谓「曲不离口，拳不离手」。旁边是几个兵器架子，上面十八般兵
刃，样样俱全，青城门下虽然都使用趁手的短兵刃，但是为了研究其它门派的武
功，也时而练一练其它的兵刃。
LONG);
  set("exits", ([
    "west": __DIR__ "houdian",
    "east": __DIR__ "stone_xiaojing",
    "north": __DIR__ "xiaodao1",
    "south": __DIR__ "xiaodao2",
  ]));

  set("objects", ([
    __DIR__ "npc/fang_jin": 1,
    __DIR__ "npc/lianwu_dizi": 1 + random(3),
  ]));
  setup();

}
