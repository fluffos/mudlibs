// file   : yu_qiang.c
// attrib : NPC
// name   : 于强   三师兄，负责在观主卧室外看守
// writer : xli
// date   : 1998.10

#include <ansi.h>

inherit NPC;



void create() {
  set_name("于强", ({ "yu qiang", "yu" }));
  set("gender", "男性");
  set("age", 25);
  set("title", HIM "青城派三师兄" NOR);
  set("long", @LONG
他是青城派现任二师兄，名列青城四秀之三，武功虽不甚好，却知书达理。
LONG);
  create_family("青城派", 9, "弟子");
  set("class", "qingcheng");
  set("combat_exp", 100000);
  set("social_exp", 25000);

  set_wugong("songfeng-quan", 65, 65, 0);
  set_wugong("cuixin-zhang", 75, 75, 0);

  set_wugong("songfeng-xinfa", 28, 28, 0);

  set_wugong("jiujin-ci", 70, 70, 0);
  set_wugong("zhaodi-hong", 65, 65, 0);
  set_wugong("shier-po", 65, 65, 0);
  set_wugong("yunv-zhen", 75, 75, 1);

  set_xiuwei_by_type("unarmed", 400);
  set_xiuwei_by_type("short", 820);
  set_xiuwei_by_type("dodge", 200);

  set("force", 300);
  set("max_force", 300);
  set("force_factor", 20);

  setup();
  carry_object("/d/menpai/qingcheng/obj/leigong_hong")->wield();
  carry_object("/d/menpai/qingcheng/obj/qingbu_daopao")->wear();
}

void init() {
  add_action("do_qingjiao", "qingjiao");
  add_action("do_duilian", "duilian");
}

int do_duilian(string arg) {
  object me;
  me = this_player();
  if (me->query("class") != "qingcheng") {
    tell_object(me, "你不是青城弟子，怎能和他对练呢？\n");
    return 1;
  }
  if (arg == "yu qiang" || arg == "yu") {
    message_vision("$N向于强一恭身，说道：师弟" + me->query("name") + "恭请师兄指教。\n", me);
    command("say 师父命我看守卧室，现在没有时间和你对练。");
    return 1;
  }

}
int do_qingjiao(string arg) {
  object me;
  string skill, who;
  me = this_player();
  if (me->query("class") != "qingcheng") {
    tell_object(me, "你不是青城弟子，怎能向他请教武功呢？\n");
    return 1;
  }
  if (arg) {
    if ((sscanf(arg, "%s from %s", skill, who) == 2) ||
      (sscanf(arg, "%s %s", who, skill) == 2))

    {
      if (who == "yu") {
        message_vision("$N向于强一恭身道：" + me->query("name") + "对于本门武学有些疑问，想请教一下师兄。\n", me);
        command("say 我与你同为司马掌门弟子，武学上有何不懂的，应该问师父才是。");
        return 1;
      }
    }
  }

}
