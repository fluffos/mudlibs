// file   : fang_jin.c
// attrib : NPC
// name   : 方晋   二师兄，负责在练武厅指导其它弟子
// writer : xli
// date   : 1998.10

#include <ansi.h>

inherit NPC;



void create() {
  set_name("方晋", ({ "fang jin", "fang" }));
  set("gender", "男性");
  set("age", 25);
  set("title", HIY "青城派二师兄" NOR);
  set("long", @LONG
他是青城派二师兄，名列青城四秀之二，武功却是四人中最好的。
LONG);
  create_family("青城派", 9, "弟子");
  set("class", "qingcheng");
  set("combat_exp", 100000);
  set("social_exp", 25000);

  set_wugong("jiben-quanfa", 80, 80, 0);
  set_wugong("songfeng-quan", 75, 75, 1);
  set_wugong("cuixin-zhang", 75, 75, 1);

  set_wugong("songfeng-xinfa", 34, 34, 0);

  set_wugong("jiujin-ci", 80, 80, 0);
  set_wugong("zhaodi-hong", 75, 75, 0);
  set_wugong("shier-po", 75, 75, 0);
  set_wugong("yunv-zhen", 85, 85, 1);

  set_xiuwei_by_type("unarmed", 480);
  set_xiuwei_by_type("short", 910);
  set_xiuwei_by_type("dodge", 300);

  set("force", 350);
  set("max_force", 350);
  set("force_factor", 30);

  setup();
  carry_object("/d/menpai/qingcheng/obj/leigong_hong")->wield();
  carry_object("/d/menpai/qingcheng/obj/qingbu_daopao")->wear();
}
void init() {
  add_action("do_qingjiao", "qingjiao");
}

int do_qingjiao(string arg) {
  object me;
  string skill, who;
  me = this_player();
  if (me->query("class") != "qingcheng") {
    tell_object(me, "你不是青城弟子，怎能向他请教武功呢？\n");
    return 1;
  }
  if (arg) {
    if ((sscanf(arg, "%s from %s", skill, who) == 2) ||
      (sscanf(arg, "%s %s", who, skill) == 2))

    {
      if (who == "fang") {
        message_vision("$N向方晋一恭身道：" + me->query("name") + "对于本门武学有些疑问，想请教一下师兄。\n", me);
        command("say 我与你同为司马掌门弟子，武学上有何不懂的，应该问师父才是。");
        return 1;
      }
    }
  }

}
