// file    :    mofang_dizi.c
// attrib  :    npc
// name    :    青城磨房弟子
// use     :    青城派在磨房干活的弟子
// write   :    xli
// date    :    1998.10

#include <ansi.h>
inherit NPC;



void create() {
  set_name("磨房弟子", ({ "mofang dizi", "dizi" }));
  set("long", @LONG
一位年轻的青城弟子，正忙着赶驴拉磨。
LONG);
  if (random(4) > 0)
    set("gender", "男性");
  else
    set("gender", "女性");
  set("age", 22);
  create_family("青城派", 9, "弟子");
  set("class", "qingcheng");
  setup();
}

void init() {
  add_action("do_duilian", "duilian");
  add_action("do_qingjiao", "qingjiao");
}

int do_duilian(string arg) {
  object me;
  me = this_player();
  if (me->query("class") != "qingcheng") {
    tell_object(me, "你不是青城弟子，怎能和他对练呢？\n");
    return 1;
  }
  if (arg == "mofang dizi" || arg == "dizi") {
    message_vision("$N向磨房弟子一恭身，说道：" + me->query("name") + "恭请指教。\n", me);
    command("say 没看见我正忙着呢？和你对练，开什么玩笑？");
    return 1;
  }

}

int do_qingjiao(string arg) {
  object me;
  string skill, who;
  me = this_player();

  if (arg) {
    if ((sscanf(arg, "%s from %s", skill, who) == 2) ||
      (sscanf(arg, "%s %s", who, skill) == 2))

    {
      if (who == "mofang" || who == "dizi") {
        message_vision("$N向磨房弟子一恭身道：" + me->query("name") + "对于本门武学有些疑问，想请教一下。\n", me);
        command("say 我武功甚为低微，岂敢妄加指点，真是折杀我了！");
        return 1;
      }
    }
  }

}
