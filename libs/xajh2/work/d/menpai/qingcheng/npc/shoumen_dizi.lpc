// file    :    shoumen_dizi
// attrib  :    npc
// name    :    守门弟子  
// use     :    青城派看守山门的弟子  1 short,2 unarmed,1 dodge
// write   :    xli
// date    :    1998.10
#include <ansi.h>

inherit NPC;



void create() {
  set_name("守门弟子", ({ "shoumen dizi", "dizi" }));
  set("long", @LONG
一位年轻的青城弟子，正站在大门旁，恭恭敬敬地迎接来访客人。
LONG);
  create_family("青城派", 9, "弟子");
  set("class", "qingcheng");
  set_wugong("jiben-quanfa", 80, 80, 0);
  set_wugong("songfeng-quan", 60, 60, 1);
  set_wugong("cuixin-zhang", 60, 60, 1);
  set_xiuwei_by_type("unarmed", 300 + random(300));

  set_wugong("jiujin-ci", 80, 80, 1);
  set_xiuwei_by_type("short", 100 + random(200));

  set_wugong("jiben-qinggong", 60, 60, 1);
  set_xiuwei_by_type("dodge", 100 + random(50));

  setup();
}
void init() {
  add_action("do_qingjiao", "qingjiao");
  add_action("do_duilian", "duilian");
}

int do_duilian(string arg) {
  object me;
  me = this_player();
  if (me->query("class") != "qingcheng") {
    tell_object(me, "你不是青城弟子，怎能和他对练呢？\n");
    return 1;
  }
  if (arg == "shoumen dizi" || arg == "dizi") {
    message_vision("$N向守门弟子一恭身，说道：" + me->query("name") + "恭请指教。\n", me);
    command("say 我只负责看守大门，现在没有时间和你对练。");
    return 1;
  }

}

int do_qingjiao(string arg) {
  object me;
  string skill, who;
  me = this_player();

  if (arg) {
    if ((sscanf(arg, "%s from %s", skill, who) == 2) ||
      (sscanf(arg, "%s %s", who, skill) == 2))

    {
      if (who == "shoumen" || who == "dizi") {
        message_vision("$N向守门弟子一恭身道：" + me->query("name") + "对于本门武学有些疑问，想请教一下。\n", me);
        command("say 我的职责是负责看守大门，教人武功之事是万万不可为之的！");
        return 1;
      }
    }
  }

}
