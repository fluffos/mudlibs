// file    :    lianwu_dizi
// attrib  :    npc
// name    :    青城练武弟子
// use     :    青城派普通练武弟子
// wugong  :    2 short,1 unarmed,1 dodge
// write   :    xli
// date    :    1998.10

inherit NPC;



void create() {
  set_name("练武弟子", ({ "lianwu dizi", "dizi" }));
  set("long", @LONG
一位年轻的青城弟子，正在二师兄洪人雄的指导下练习武艺。
LONG);
  if (random(3) > 0)
    set("gender", "男性");
  else
    set("gender", "女性");
  set("age", 22);
  create_family("青城派", 9, "弟子");
  set("class", "qingcheng");
  set("combat_exp", 2000 + random(5000));
  set("social_exp", 2000 + random(5000));
  set_wugong("jiben-qinggong", 60, 60, 1);
  set_xiuwei_by_type("dodge", 100 + random(50));  // 1 dodge
  if (random(2) == 0) {
    if (random(2) == 0)   // 1 short,1 unarmed
    {
      set_wugong("jiben-quanfa", 90, 90, 1);
      set_wugong("jiujin-ci", 70, 70, 1);
      set_xiuwei_by_type("unarmed", 100 + random(100));
      set_xiuwei_by_type("short", 100 + random(200));
    } else {
      set_wugong("jiben-quanfa", 60, 60, 0);  // 2 short, 1 unarmed
      set_wugong("songfeng-quan", 70, 70, 1);
      set_wugong("shier-po", 70, 70, 1);
      set_wugong("jiujin-ci", 80, 80, 0);
      set_wugong("zhaodi-hong", 70, 70, 1);
      set_xiuwei_by_type("unarmed", 100 + random(200));
      set_xiuwei_by_type("short", 300 + random(300));
    }
  } else {
    if (random(2) == 0)  // 1 short,2 unarmed
    {
      set_wugong("jiben-quanfa", 80, 80, 0);
      set_wugong("songfeng-quan", 60, 60, 1);
      set_wugong("cuixin-zhang", 60, 60, 1);
      set_wugong("jiujin-ci", 70, 70, 1);
      set_xiuwei_by_type("unarmed", 300 + random(300));
      set_xiuwei_by_type("short", 100 + random(200));
    } else    // 2 short, 2 unarmed 
    {
      set_wugong("jiben-quanfa", 80, 80, 0);
      set_wugong("songfeng-quan", 60, 60, 1);
      set_wugong("cuixin-zhang", 60, 60, 1);
      set_wugong("jiujin-ci", 80, 80, 0);
      set_wugong("shier-po", 70, 70, 1);
      set_wugong("zhaodi-hong", 70, 70, 1);
      set_xiuwei_by_type("unarmed", 300 + random(300));
      set_xiuwei_by_type("short", 300 + random(300));
    }
  }
  setup();
  carry_object("/d/menpai/qingcheng/obj/qingbu_daopao")->wear();
  if (random(2) == 0)
    carry_object("/d/menpai/qingcheng/obj/leigong_hong")->wield();

}

void init() {
  add_action("do_qingjiao", "qingjiao");
}

int do_qingjiao(string arg) {
  object me;
  string skill, who;
  me = this_player();
  if (me->query("class") != "qingcheng") {
    tell_object(me, "你不是青城弟子，怎能向他请教武功呢？\n");
    return 1;
  }
  if (arg) {
    if ((sscanf(arg, "%s from %s", skill, who) == 2) ||
      (sscanf(arg, "%s %s", who, skill) == 2))

    {
      if (who == "lianwu" || who == "dizi") {
        message_vision("$N向练武弟子一恭身道：" + me->query("name") + "对于本门武学有些疑问，想请教一下。\n", me);
        command("say 我初窥本门武功精妙，武功微不足道，又怎敢妄自指点你，真是惭愧惭愧！");
        return 1;
      }
    }
  }

}
