inherit ROAD;



void create() {
  set("short", "观景台");
  set("long", @LONG
立于此地，极目四望，只见青山翠柏，闲云野鹤，还能隐约听见不远处瀑布
的哗哗声，仿佛自己是置身于一幅美妙的山水画中，如沐春风。等到夕阳西下，
在此处更是能揽尽四周山色，颇有“停车坐爱枫林晚”的感觉。
LONG);
  set("exits", ([
    "northdown": __DIR__ "banshan_ting",
    "westup": __DIR__ "shandao2",
  ]));

  set("objects", ([
    __DIR__ "npc/youke": 1,
  ]));
  setup();

}
