// file   :  dilao.c
// attrib :  room of QingCheng
// name   :  地牢，青城派关杀害本门弟子的人地方
// especial : 这里不能练功，不能退出，不能自杀，嘿嘿!
// write  :  xli
// date   :  1998.11
// 一个复杂的地方，出去不太容易的说！
//   Last Modified:xli 1999.9

#include <ansi.h>
inherit ROOM;


void create() {
  set("short", "地牢");
  set("long", @LONG
这里是青城派的地牢，黑黑的，阴暗无比。地上铺着方砖，严丝合缝。房里
除了四面墙壁什么都没有，墙角扔着一堆烂稻草，已经发霉了，盖着厚厚的一层
灰。呆在这里可不是什么好事，还是赶紧想办法出去吧！
LONG);
  set("not_startroom", 1);
  set("no_fight", 1);
  setup();
}
void init() {
  add_action("do_search", "search");
  add_action("do_fire", "burn");
  add_action("do_qiurao", "qiurao");

  add_action("do_liangong", ({ "lian", "xiulian", "dazuo", "fight", "bihua", "kill", "sha" }));
  add_action("do_quit", "quit");
  add_action("do_zisha", "suicide");
}

int do_liangong(string arg) {
  write("这里空气中一股霉味，练功可是对身体不好哦！\n");
  return 1;
}
int do_quit(string arg) {
  write("这里一个出口都没有，你怎么出去啊？\n");
  return 1;
}
int do_zisha(string arg) {
  write("不会吧，被关起来就自杀，也太受不了挫折了！\n");
  return 1;
}
int do_search(string arg) {
  object me;
  me = this_player();
  if (!arg || arg != "稻草")
    return notify_fail("你要搜什么？\n");
  if (me->query("xli_marks/have_search"))
    return notify_fail("你已经搜出东西了，还要搜啊？\n");
  message_vision("$N翻开那一堆烂稻草，顿时一股霉气冲了出来。\n", me);
  message_vision("$N掩鼻强忍，在草堆中翻着...\n", me);
  message_vision("果然翻出来了一个小小的火折子。\n", me);
  me->set("xli_marks/have_search", 1);
  message_vision("看来可以用它点火(burn)了。\n", me);
  return 1;
}

int do_fire(string arg) {
  object me;
  me = this_player();
  if (!me->query("xli_marks/have_search"))
    return notify_fail("你要拿什么点火啊？\n");
  if (!arg || arg != "稻草")
    return notify_fail("火折子得来不易，要点就点能烧半天的东西啊！\n");
  me->delete("xli_marks/have_search");
  message_vision("$N点亮火折子，把它丢到了稻草堆里，顿时一片亮堂。\n", me);
  message_vision("火光之中，$N隐约看见墙上用黑炭写了几个字：\n", me);
  message_vision(BLK "只要求饶(qiurao)，尚可酌情考虑放出。\n" NOR, me);
  me->set("xli_marks/can_out", 1);
  return 1;
}

int do_qiurao(string what) {
  object me;
  me = this_player();
  if (!me->query("xli_marks/can_out"))
    return notify_fail("你没问题吧，好好的求什么饶啊！\n");
  message_vision("$N跪在地上，双手合十，痛哭流涕地说道：\n", me);
  message_vision("就请饶了我吧，我以后再也不敢在青城派造次了。\n", me);
  message_vision("$N突然听得一个声音响起：\n", me);
  message_vision("念你并不是罪不可赦，就饶你这一回吧！\n", me);
  message_vision("只是还是要关你一段时间，好好反思。\n", me);
  me->delete("xli_marks/can_out");
  call_out("do_fang", 30, me);
  return 1;
}

int do_fang(object who) {
  message_vision("一个声音说道：好了，你可以出去了，以后不许在青城造次！\n", who);
  message_vision("墙上突然出现了一个黑洞，$N忙不迭地从中钻了出去。\n", who);
  who->move("/d/menpai/qingcheng/shanjiao");
  return 1;
}
