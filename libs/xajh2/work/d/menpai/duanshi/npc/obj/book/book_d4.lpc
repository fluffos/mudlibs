inherit ITEM;

void create() {
  set_name("「提纵之术」", ({ "tizong zhishu", "book", "shu" }));
  set_weight(300);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "本");
    set("num", "d4");
    set("long", "这是一本讲述轻功的书。\n");
    set("value", 200);
    set("material", "paper");
    set("skill", ([
      "name": "jiben-qinggong",
      "xiuwei_required": 20,
      "literate_required": 20,
      "gin_cost": 10 + random(10),
      "max_jibie": 70,
      "max_lingwu": 70,
      "bonus_xiuwei": 2,
      "max_xiuwei": 70,
    ]));
  }
}

#include "duan_book.h"
