//xiaoniu_pixue.c cry

#include <ansi.h>
#include <armor.h>

inherit BOOTS;

void create() {
  set_name(HIY "小牛皮靴" NOR, ({ "xiaoniu pixue", "pixue", "xue" }));
  set_weight(1200);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一双用小牛皮做的靴子，十分舒适。\n");
    set("unit", "双");
    set("value", 10000);
    set("material", "leather");
    set("armor_prop/armor", 6);
    set("armor_prop/dex", 2);

  }
  setup();
}
