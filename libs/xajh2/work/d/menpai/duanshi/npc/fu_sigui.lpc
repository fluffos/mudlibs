// By lala on July 12, 97
inherit NPC;
inherit F_MASTER;

#include <ansi.h>

string *chat_msg = ({
  "傅思归在侍卫当中走来走去，不时纠正动作有错误的侍卫。\n",
  "傅思归舞动熟铜齐眉棍，呼呼有风，不一会竟成了一团金光，把人罩在当中。\n",
  "“棍扫扫一片，枪挑一条线……”傅思归大声地对练习的侍卫解说要领。\n",
});

void create() {
  set_name("傅思归", ({ "fu sigui", "fu", "sigui" }));
  set("title", CYN "大理国" GRN "四大卫护" NOR);
  set("gender", "男性");
  set("age", 38);
  set("attitude", "peaceful");
  set("class", "duanshi");
  set("long", @LONG
傅思归身为大理国四大卫护之一，一身功夫颇为了得，但是他这个人看起来
却是普普通通，就象任何一个乡下的农夫一样平和朴实。
LONG);
  set("str", 24);
  set("int", 24);
  set("spi", 24);
  set("con", 24);
  set("cps", 24);
  set("cor", 24);
  set("per", 20);
  set("force", 1600);
  set("max_force", 1600);
  set("force_factor", 15);
  set("max_kee", 600);
  set("kee", 600);
  set("max_sen", 700);
  set("sen", 700);

  set("class_score/镇南王府", 800);
  set("combat_exp", 45000);
  set("social_exp", 300000);
  set("positive_score", 9000);

  set_wugong("jiben-qinggong", 150, 150, 0);
  set_wugong("unarmed", 150, 150, 0);
  set_wugong("duanshi-neigong", 160, 160, 1);
  set_wugong("blade", 150, 150, 0);
  set_wugong("kuaige-dao", 130, 130, 0);
  set_wugong("zuiliu-dao", 110, 110, 1);
  set_wugong("haofeng-quan", 110, 110, 0);
  set_wugong("zhuifeng-quan", 90, 90, 1);
  set_wugong("tianhong", 130, 130, 0);
  set_wugong("shenxing", 110, 110, 1);
  set_wugong("luanpifeng", 100, 100, 1);

  set_xiuwei_by_type("blade", 660);
  set_xiuwei_by_type("unarmed", 660);
  set_xiuwei_by_type("dodge", 660);
  set_xiuwei_by_type("zonggang", 660);
  set_xiuwei_by_type("long", 1900);

  set("env/attack", 60);

  create_family("镇南王府", 1, "卫护");

  setup();

  carry_object(CLONE_DIR "wear/boots/wuyun_xue")->wear();
  carry_object(CLONE_DIR "wear/waist/chahe_luandai")->wear();
  carry_object(CLONE_DIR "wear/cloth/baizhu_sipao")->wear();
  carry_object(CLONE_DIR "wear/head/qingsha_jin")->wear();
  carry_object(__DIR__ "obj/shutong_gun")->wield();
}
#include "weihu.h";
#include "teach.h";
