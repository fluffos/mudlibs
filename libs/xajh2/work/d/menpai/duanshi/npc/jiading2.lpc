// By lala on July 19, 1997

#include <ansi.h>
#include "guard.h"

void create() {
  string name, id;
  int i, j;
  i = random(sizeof(second_name));
  j = random(sizeof(last_name));
  name = "段";
  name += second_name[i];
  name += last_name[j];
  id = second_id[i];
  id += last_id[j];
  set_name(name, ({ "duan " + id, id }));
  set("title", BLU "镇南王府家丁" NOR);
  set("gender", "男性");
  set("age", 20 + random(20));
  set("combat_exp", 2000 + random(10) * 100);
  set("class", "duanshi");
  set("max_force", 300);
  set("force", 300);
  set("force_factor", 10);

  set_wugong("duanshi-neigong", 30, 30, 1);
  set_wugong("tianhong", 60, 60, 1);
  set_wugong("kuaige-dao", 60, 60, 1);
  set_wugong("unarmed", 60, 60, 1);

  set_xiuwei_by_type("blade", 150);
  set_xiuwei_by_type("unarmed", 60);
  set_xiuwei_by_type("dodge", 150);

  set("env/attack", 55);

  create_family("镇南王府", 2, "家丁");

  setup();

  carry_object(__DIR__ "obj/boots")->wear();
  carry_object(__DIR__ "obj/waist")->wear();
  carry_object(__DIR__ "obj/armor")->wear();
  carry_object(CLONE_DIR "wear/cloth/cloth6")->wear();
  switch (random(2)) {
    case 0:
      break;
    case 1:
      carry_object(__DIR__ "obj/blade")->wield();
      break;
  }
}

void init() {
  object ob, me;
  ob = this_object();
  me = this_player();

  if (ob->can_act()
    && me->query_condition("kill_dali")) {
    remove_call_out("kill_him");
    call_out("kill_him", 1, me);
  }
}

void kill_him(object me) {
  message_vision("$N对着$n大喝一声：“杀人放火的强盗，快快受死吧！！！” \n",
    this_object(), me);
  kill_ob(me);
}

#include "greeting.h"
