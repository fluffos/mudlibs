// NPC: /d/city/dali/npc/wuwei.c
// Changed by lala on July 12, 97
inherit NPC;
inherit F_MASTER;

#include <ansi.h>

string *drink_msg = ({
  "段无畏慢慢地品味着手中的女儿红，显得非常陶醉……\n",
  "段无畏叹道：“人生难得几回醉呀……”\n",
  "段无畏向你瞥了一眼：“这位朋友，过来喝一杯怎么样？”\n",
  "段无畏拍拍酒保的肩膀：“不错，这酒确实不错……”\n",
});

string ask_for_join();
string change_master();

void create() {
  set_name("段无畏", ({ "duan wuwei", "duan", "wuwei" }));
  set("title", "镇南王府大管事");
  set("gender", "男性");
  set("age", 30);
  set("attitude", "peaceful");
  set("class", "duanshi");
  set("apprentice_available", 10);
  set("long", @LONG
段无畏是大理镇南王府的大管事，三十多岁，以前是王爷的书童,精明能干，主管
王府杂务，兼教家丁们习武，听说手下很有点功夫，家丁们多是他的记名弟子。
当年王爷曾指点过他一二。他经常到太白楼来喝酒。
LONG);
  set("str", 28);
  set("int", 30);
  set("spi", 30);
  set("con", 30);
  set("cps", 30);
  set("cor", 20);

  set("force", 1000);
  set("max_force", 1000);
  set("force_factor", 10);
  set("max_kee", 400);
  set("kee", 400);
  set("max_sen", 500);
  set("sen", 500);

  set("combat_exp", 10000);
  set("score", 2000);

  set("inquiry", ([
    "入府": (: ask_for_join :),
    "生计": (: ask_for_join :),
    "指点武功": (: change_master :),
  ]));

  set_wugong("jiben-qinggong", 110, 110, 0);
  set_wugong("unarmed", 110, 110, 0);
  set_wugong("duanshi-neigong", 100, 100, 1);
  set_wugong("blade", 130, 130, 0);
  set_wugong("kuaige-dao", 100, 100, 0);
  set_wugong("zuiliu-dao", 40, 40, 1);
  set_wugong("haofeng-quan", 50, 50, 1);
  set_wugong("tianhong", 90, 90, 0);
  set_wugong("shenxing", 40, 40, 1);
  set_wugong("qiang", 100, 100, 1);

  set_xiuwei_by_type("blade", 350);
  set_xiuwei_by_type("unarmed", 150);
  set_xiuwei_by_type("dodge", 350);
  set_xiuwei_by_type("long", 1000);

  create_family("镇南王府", 1, "管事");

  setup();
  carry_object(CLONE_DIR "wear/cloth/baiduan_shan")->wear();
  carry_object(__DIR__ "obj/finger")->wear();
  carry_object(CLONE_DIR "weapon/blade/blade1");
}

void init() {
  object me = this_player(), ob = this_object();
  //      ::init();
  if (ob->can_act() && !ob->is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 5, me);
  }
  add_action("do_yuanyi", "yuanyi");
  if (me->query("class_score/镇南王府") < 4500)
    add_action("give_quest", "quest");
  else
    add_action("do_say", "quest");
}

int do_say() {
  object me = this_player();

  if (me->query("class") == "duanshi")
    tell_object(me, "段无畏说道：“我这里现在没什么事，你去侍奉王爷吧。”\n");
  else
    tell_object(me, "段无畏疑惑地看着你：“这位" + RANK_D->query_respect(me)
      + "有何贵干？”\n");
  return 1;
}


string ask_for_join() {
  object me;

  me = this_player();

  if ((string)me->query("class") == "duanshi")
    return "开什么玩笑！没见我正忙着！我可没空和你逗着玩！";
  if (me->query("family") != 0)
    return "哈，对不起，咱们镇南王府只收良家百姓做家人! 您请回吧！";

  me->set_temp("pending/join_duanshi", 1);
  return "好吧，入了王府要改姓“段”你可愿意(yuanyi)？";
}

int do_yuanyi() {
  string *prename = ({ "段" });
  string name, new_name;
  int len;
  if (!this_player()->query_temp("pending/join_duanshi")) return 0;
  message_vision(
    HIC "$N恭恭敬敬地给段无畏鞠了个躬。\n\n"
    "$n点点头，对$N说：从今天起，你就是我们段家的人了。\n\n" NOR,
    this_player(), this_object());
  name = this_player()->query("name");
  len = strlen(name);
  new_name = prename[random(sizeof(prename))] + name[2..(len - 1)];
  command("say 从今以後你的名字叫做" + new_name + "。");
  command("smile");
  this_player()->delete_temp("pending/join_duanshi");
  this_player()->set("name", new_name);
  this_player()->set("title", "镇南王府见习家丁");
  this_player()->set("class", "duanshi");
  return 1;
}

void attempt_apprentice(object me) {
  if (me->query("class") == "duanshi"
    && me->query("family/master_id") != "duan wuwei"
    && me->query("family/master_id") != 0) {
    message_vision("段无畏看着$N觉得很奇怪：“你起什么哄啊？”\n", me);
    me->delete_temp("pending/apprentice");
    return;
  }
  if (query("apprentice_available")) {
    if (find_call_out("do_recruit") != -1)
      command("say 慢著，一个一个来。");
    else
      call_out("do_recruit", 2, me);
  } else {
    command("say 本府今天已经收了十个家丁，不想再收人了。");
  }
}

void do_recruit(object ob) {
  if ((string)ob->query("class") != "duanshi")
    command("say 我只收咱们王府的人作弟子，好吧，你既然如此诚心，就先入府为奴吧？");
  else {
    command("say 好啦！ 从今天起你就是王府正式的家人啦！别给咱们王爷丢脸！好好干，别偷懒啊！");
    command("recruit " + ob->query("id"));
    this_player()->set("title", "镇南王府见习家丁");
  }
}

int recruit_apprentice(object ob) {
  if ( ::recruit_apprentice(ob)) {
    add("apprentice_availavble", -1);
    ob->set("class", "duanshi");
    return 1;
  }
}

int accept_fight(object me) {
  if ((string)me->query("class") == "duanshi") {
    if (!me->query_temp("fight_master/段"))
      command("say 自家人还比划什么，如果你非要试试就对练好了。");
    else {
      command("wield blade");
      return 1;
    }
  } else
    command("say 镇南王府的人从来不和外人较量！你请回吧！。");
  return 0;
}

void greeting(object ob) {
  if (!ob || environment(ob) != environment()) return;
  if (can_act()
    && !is_fighting()
    && environment(this_object())->query("short") == "太白楼") {
    tell_object(ob, drink_msg[random(sizeof(drink_msg))]);
    call_out("greeting", 20, ob);
  }
}

int refuse_killing(object me) {
  command("wield blade");
  me->apply_condition("kill_dali", 200);
  return 0;
}

string change_master() {
  string msg;
  object me;

  me = this_player();
  if (me->query("family/master_id") == "duan wuwei") {
    if (!me->query_temp("fight_master/段")) {
      if (!me->query_temp("lost_fight/段")) {
        if (!me->query_temp("can_apprentice/段")) {
          me->set_temp("fight_master/段", 1);
          printf("段无畏沉思了一会……\n");
          msg = sprintf("好，我们比试一下，再做决定吧。\n");
        } else {
          printf("段无畏露出迷惑的表情。\n");
          msg = sprintf("你拿了我的推荐信不去学功夫，老缠着我干什么？\n");
        }
      } else {
        printf("段无畏摇摇头，似乎有些不耐烦。\n");
        msg = sprintf("人啊，一定要有自知之明。你还是先跟我多学点东西再说吧。\n");
        if (me->query("class_score/镇南王府") > -50)
          me->add("class_score/镇南王府", -1);
        else {
          tell_object(me, "你对于本门的忠诚度太低了，看样子是个奸细！\n");
          kill_ob(me);
        }
      }
    } else {
      msg = sprintf("我不是让你和我比划一下吗？你怎么问个没完？！\n");
    }
  } else {
    msg = "见笑，见笑。在下的雕虫小技怎能指点您什么呢？\n";
  }
  return msg;
}

int win_bihua(object me) {
  object ob;
  int max;

  ob = this_object();
  me->delete_temp("fight_master/段");

  max = ob->query("max_kee");
  ob->set("eff_kee", max);
  ob->set("kee", max);
  max = ob->query("max_gin");
  ob->set("eff_gin", max);
  ob->set("gin", max);
  max = ob->query("max_sen");
  ob->set("eff_sen", max);
  ob->set("sen", max);
  max = ob->max_food_capacity();
  ob->set("food", max);
  max = ob->max_water_capacity();
  ob->set("water", max);
  ob->set("force", 1000);

  me->set_temp("lost_fight/段", 1);
  command("say 你才会这几下子就想不跟我学了，没门！！！");
  return 1;
}

int lose_bihua(object me) {
  string msg;
  object ob;
  int max;

  ob = this_object();
  me->delete_temp("fight_master/段");

  max = ob->query("max_kee");
  ob->set("eff_kee", max);
  ob->set("kee", max);
  max = ob->query("max_gin");
  ob->set("eff_gin", max);
  ob->set("gin", max);
  max = ob->query("max_sen");
  ob->set("eff_sen", max);
  ob->set("sen", max);
  max = ob->max_food_capacity();
  ob->set("food", max);
  max = ob->max_water_capacity();
  ob->set("water", max);
  ob->set("force", 1000);

  msg = "好，我也不耽误你的前程，我介绍你去向四大卫护大人学功夫吧，\n" +
    "          如果他们收了你，那你从今往后就是王府的侍卫了。不过呢，我还\n" +
    "          算是你的师傅。好好干吧。拿着这是我的推荐信，收好了！\n";
  me->set_temp("can_apprentice/段", 1);
  command("say " + msg);
  ob = new(__DIR__ "obj/letter0");
  ob->move(me);
  message_vision("段无畏交给$N一封推荐信。\n", me);
  return 1;
}

int valid_teach(object you, string skill) {
  object me = this_object();

  if (!::valid_teach(you, skill))
    return 0;

  if ((!you->query("family/master_id")) || (you->query("family/master_id") != me->query("id"))) {
    command("? " + you->query("id"));
    command("say 你怎么不去找自己师傅请教功夫啊？本府上最忌讳自己偷学武功。");
    return 0;
  }

  if ((you->query("family/master_id") == "duan wuwei") && (you->query("age") < 16)) {
    command("shake" + you->query("id"));
    command("say “你年纪太小了，练武的事，过两年再说吧。”");
    return 0;
  }
  return 1;
}
