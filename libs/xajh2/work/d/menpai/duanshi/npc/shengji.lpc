// NPC: 升级使 writen by cry 9.10.98

#include <ansi.h>

inherit NPC;

int change_color();
void create() {
  set_name("哭梦", ({ "shengji shi", "shi" }));
  set("title", CYN "大理国" RED "升" YEL "级" GRN "使" NOR);
  set("gender", "女性");
  set("age", 19);
  set("attitude", "friendly");
  set("long",
    " 大理国武官 请找这个NPC升级为 " + CYN "大理国" + RED "武官" NOR + "才可在段府继续学习武功。"
    + "\n"
    + "升级方法为：ask shi about 升级。	玩家请不要杀她，否则后果自负。\n");

  set("str", 30); set("cor", 30); set("int", 30);
  set("per", 30); set("spi", 30); set("cps", 30);
  set("dex", 30); set("con", 30); set("kar", 30);

  set("max_force", 2500);
  set("force", 2500);
  set("force_factor", 250);
  set("combat_exp", 10000000);
  set("social_exp", 100000);

  set_wugong("liangyi-xinfa", 150, 150, 1);
  set_wugong("liangyi-jian", 150, 150, 1);
  set_wugong("shenxing", 150, 150, 1);
  set_wugong("yiyang-zhi", 150, 150, 1);
  set_xiuwei("sword", 5301);
  set_xiuwei("unarmed", 5301);
  set_xiuwei("dodge", 5301);
  set("rank_info/respect", "仙子");
  set("chat_chance", 10);
  set("chat_msg", ({
    command("jump"),
    command("snicker"),
  }));
  set("env/immortal", 1);
  set("env/attack", 50);
  set("inquiry", ([
    "升级": (: change_color :),
  ]));
  setup();
  carry_object(__DIR__ "obj/zirong_sipao")->wear();
}

void welcome_visitor() {
  object me = this_player();

  command("pat " + me->query("id"));
}

int change_color() {
  object me = this_player();

  if (me->query("title") == "大理国武官") {
    me->set("title", CYN "大理国" RED "武官" NOR);
    command("addoil " + me->query("id"));
  } else
    command("waggle " + me->query("id"));
  return 1;
}

