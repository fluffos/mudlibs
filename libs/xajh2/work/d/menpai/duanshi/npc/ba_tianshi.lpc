inherit NPC;
inherit F_MASTER;

#include <ansi.h>

void create()
{
    set_name("巴天石", ({ "ba tianshi", "ba", "tianshi" }) );
    set("title",CYN"大理国"RED"司空"NOR);
    set("gender", "男性");
    set("age", 41);
    set("attitude", "peaceful");
    set("class",     "duanshi");
    set("long", @LONG
巴天石官居大理三公之一的司空之位，深得保定帝的信任，视之如左膀右
臂。与华赫艮、范骅可以说是生死之交。虽然他又黑又瘦貌不惊人，但他
的轻功在三人中为最高，甚至在整个大理都无出其右者，就天下而言，也
是屈指可数。
LONG);
    set("str", 25);
    set("int", 26);
    set("spi", 27);
    set("con", 28);
    set("cps", 29);
    set("cor", 30);
    set("per", 15);
    set("force",     1600);
    set("max_force", 1600);
    set("force_factor", 15);
    set("max_kee",700);
    set("kee",    700);
    set("max_sen",700);
    set("sen",    700);
    set("rank_info/respect", "司空大人");

    set("class_score/镇南王府", 2000);
    set("combat_exp",    100000);
    set("social_exp",    500000);
    set("positive_score", 50000);

    set_wugong("jiben-qinggong", 200,200,0);
     set_wugong("tianhong",       200,200,0);
    set_wugong("shenxing",       200,200,1);
    set_wugong("unarmed",        160,160,0);
    set_wugong("haofeng-quan",   130,130,0);
    set_wugong("zhuifeng-quan",  100,100,0);
    set_wugong("wuluo-qingyan",   60, 60,1);
    set_wugong("duanshi-neigong",160,160,0);
    set_wugong("duanshi-xinfa",   70, 70,1);
    set_wugong("blade",          150,150,0);       
    set_wugong("kuaige-dao",     130,130,0);
    set_wugong("zuiliu-dao",     110,110,0);
    set_wugong("dingnan-dao",      80,80,1);

    set_xiuwei_by_type("blade",   1100);
    set_xiuwei_by_type("unarmed", 1100);
    set_xiuwei_by_type("dodge",   2200);
    set_xiuwei_by_type("zonggang",1000);

    create_family("镇南王府", 1, "司空");

    setup();

    carry_object(CLONE_DIR"wear/boots/wuyun_xue")->wear();
    carry_object(CLONE_DIR"wear/waist/chahe_luandai")->wear();
    carry_object(CLONE_DIR"wear/cloth/baizhu_sipao")->wear();
    carry_object(CLONE_DIR"wear/head/qingsha_jin")->wear();
    carry_object(CLONE_DIR"weapon/blade/blade1");
}

#include "sangong.h";
#include "teach.h";