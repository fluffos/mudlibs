// huangtian.c cry
inherit ROOM;

void create() {
  set("short", "幌天门");
  set("long", @LONG
向北望去可见后寺中亭台楼阁规模宏大，构筑精丽，加之金砖玉瓦，碧光掩
映天空好不气派。幌天门的西面是清都瑶台，微风吹送，可闻到阵阵清香。置身
于此，如沐清风。
LONG
  );
  set("outdoors", "tianlongsi");
  set("exits", ([
    "south": __DIR__ "ruihe",
    "north": __DIR__ "wuwu",
    "west": __DIR__ "yaotai",
  ]));
  setup();
}
