// gate.c writen by cry 9.10.98

#include <ansi.h>
#include <room.h>
inherit ROOM;

void create() {
  set("short", YEL "大门" NOR);
  set("long", @LONG
你眼前猛然一亮，见到一座金砖玉瓦、气势恢弘的寺院。大门紧闭，门楣上
一块黑木大匾，上题“崇圣寺”三个金字，笔意苍松。大门柱上刻有一付对联，
红漆覆字，金丝镶边，颇有点拨众生之意（duilian）。
LONG
  );
  set("outdoors", "tianlongsi");
  set("exits", ([
    "eastup": __DIR__ "xiaolu8",
    "north": __DIR__ "square",
  ]));

  set("detail", ([
    "duilian": RED @TEXT
			心		但
			性		离
			无		妄
			染		缘
			本		即
			自		如
			圆		如
			成		佛
TEXT NOR
  ]));
  setup();
}

void init() {
  add_action("do_say", "say");
}

int do_say(string arg) {
  if (arg == "心性无染本自圆成，但离妄缘即如如佛") {
    tell_object(this_player(), CYN "你说道：心性无染本自圆成，但离妄缘即如如佛\n" NOR);
    if (!this_player()->query("xli_marks/have_enter_tianlong")) {
      tell_room(this_object(), "一个小沙弥说道：“看来施主与我佛颇有渊源。快快请进！”\n");
      this_player()->move(__DIR__ "square");
      this_player()->set("xli_marks/have_enter_tianlong", 1);
      return 1;
    } else {
      tell_object(this_player(), "施主已经领悟过我佛之意了！\n");
      return 1;
    }
  }
  return 0;
}

int valid_leave(object me, string dir) {
  object ob = this_object(), obj, *all;
  int i;

  call_out("dest_fengseng", 2, ob);
  if (dir != "north") return 1;
  if (me->query("title") == CYN "大理国" WHT "武官" NOR
    || me->query_temp_marks("cry/can_enter")) {
    all = all_inventory(me);
    for (i = 0; i < sizeof(all); i++)
      if (userp(all[i])) {
        message_vision("$N把$n往地下一摔，独自走了进去。\n", me, all[i]);
        all[i]->move(ob);
      }
    return 1;
  }
  all = all_inventory(ob);
  for (i = 0; i < sizeof(all); i++) {
    if (all[i]->query("id") == "feng seng" && all[i]->is_fighting(me))
      return notify_fail("你还是先打赢他吧！\n");
  }
  obj = new(__DIR__ "npc/fengseng");
  obj->move(ob);
  message_vision(
    HIY "突然从门后跳出一个疯僧，挡住$N的去路，对$N喝到：“是不是你把\n"
    + "舍利子偷走的？快把它交出来！”\n" NOR, me);
  me->set_temp("pending/bihua", obj);
  obj->bihua_ob(me);
  me->bihua_ob(obj);
  return notify_fail("你还是先打赢他吧！\n");
}

void dest_fengseng(object ob) {
  object *all;
  int i;
  all = all_inventory(ob);

  for (i = 0; i < sizeof(all); i++) {
    if (all[i]->query("id") == "feng seng" && !all[i]->is_fighting())
      destruct(all[i]);
  }
}
