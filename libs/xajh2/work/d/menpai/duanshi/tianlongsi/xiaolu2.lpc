inherit ROAD;

void create() {
  set("short", "青石小路");
  set("long", @LONG
一条青石铺成的小路，从这里向东北便能观赏到洱海风光，并可通向边域名
城——大理。西面就是点苍山的中岳峰，因为路旁并没有什么赏心悦目的风景，
所以来往的人并不多。
LONG
  );
  set("outdoors", "tianlongsi");

  set("exits", ([
    "westup": __DIR__ "xiaolu3",
    "northeast": __DIR__ "xiaolu1",
  ]));

  setup();
}
