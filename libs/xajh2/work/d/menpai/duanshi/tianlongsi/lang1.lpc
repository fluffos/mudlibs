// lang1.c cry
inherit ROOM;

void create() {
  set("short", "长廊");
  set("long", @LONG
一条长廊向西延伸，廊柱全为红色，地面清洁无尘，廊顶则画有历代有名的
佛家典故，纹路清晰，著笔洒脱，显为名家作为。两旁绿树成荫，芳草遍地，使
人忍不住要坐下来，欣赏一下这里的景致。
LONG
  );
  set("outdoors", "tianlongsi");
  set("exits", ([
    "west": __DIR__ "muni_men",
    "east": __DIR__ "banruo",
  ]));
  setup();
}
