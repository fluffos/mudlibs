// benyin.c 本因 writen by tea 9.20.98
#include <ansi.h>
inherit NPC;

void create() {
  set_name("本因", ({ "ben yin", "yin" }));
  set("gender", "男性");
  set("age", 69);
  set("long", @LONG
他是天龙寺的主持方丈。除了关系到天龙寺或大理皇氏生死存亡的大事外，
都由他一手操办。
LONG);

  set("force", 2700);
  set("max_force", 2700);
  set("force_factor", 170);

  set_wugong("shenxing", 150, 150, 1);
  set_wugong("duanjia-shenfa", 150, 150, 1);
  set_wugong("duanshi-xinfa", 150, 150, 1);
  set_wugong("wolong-zhang", 150, 150, 0);
  set_wugong("huzhua-gong", 150, 150, 0);
  set_wugong("yiyang-zhi", 100, 100, 1);
  set_xiuwei_by_type("dodge", 3400);
  set_xiuwei_by_type("unarmed", 3800);
  set("combat_exp", 17000000);
  set("social_exp", 70000);
  set("max_kee", 2000);
  set("title", "天龙寺方丈");

  setup();

  carry_object(__DIR__ "obj/cloth4")->wear();
}

void welcome_visitor() {
  object me = this_player();

  tell_object(me, "本因对你道：施主来本寺有何贵干？\n");
}

int refuse_killing() {
  set_wugong("liumai-shenjian", 30, 30, 1);
  add("force_factor", 100);
  command("say 施主仍然如此无礼，就休怪老僧了。");
  return 0;
}

int valid_teach(object me, string skill) {
  if (me->query("title") != CYN "大理国" WHT "武官" NOR) return 0;
  if (skill == "liumai-shenjian") {
    message_vision(
      "本因对$N肃然道：“六脉神剑是本门绝学，不可轻传外人，不到生死存亡
之际也是万万不会使的。”\n", me);
    return 0;
  }
  return 1;
}
