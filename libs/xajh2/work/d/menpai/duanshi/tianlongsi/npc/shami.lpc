// shami.c 沙弥 cry

inherit NPC;

void create() {
  set_name("沙弥", ({ "shami" }));
  set("gender", "男性");
  set("age", 18 + random(6));
  set("long", @LONG
一个沙弥，每天负责侍奉寺内的几名高僧和来寺内敬香还愿的皇族。
LONG);

  set("force", 600);
  set("max_force", 600);
  set("force_factor", 60);

  set_wugong("dodge", 120, 120, 1);
  set_wugong("unarmed", 120, 120, 1);
  set_wugong("duanshi-xinfa", 40, 40, 1);
  set_xiuwei_by_type("dodge", 600);
  set_xiuwei_by_type("unarmed", 600);
  set("combat_exp", 6000);
  set("social_exp", 6000);
  set("title", "天龙寺");

  setup();

  carry_object(__DIR__ "obj/cloth2")->wear();
}

void welcome_visitor() {
  tell_object(this_player(), "沙弥注意到有人进来，抬起头看了一眼。\n");
}
