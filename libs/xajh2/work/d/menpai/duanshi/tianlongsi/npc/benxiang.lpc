// benxiang.c 本相 writen by tea 9.20.98

inherit NPC;

void create() {
  set_name("本相", ({ "ben xiang", "xiang" }));
  set("gender", "男性");
  set("age", 72);
  set("long", @LONG
这枯黄精瘦的僧人法名本相，是本因方丈的师兄，仍天龙寺牟尼堂的一位高僧。
LONG);

  set("force", 2900);
  set("max_force", 2900);
  set("force_factor", 190);

  set_wugong("duanjia-shenfa", 150, 150, 1);
  set_wugong("duanshi-xinfa", 140, 140, 1);
  set_wugong("yiyang-zhi", 120, 120, 1);
  set_xiuwei("dodge", 3700);
  set_xiuwei("unarmed", 4100);
  set("combat_exp", 16500000);
  set("social_exp", 70000);
  set("max_kee", 2000);
  set("title", "天龙寺神僧");

  setup();

  carry_object(__DIR__ "obj/cloth4")->wear();
}

int refuse_killing() {
  set_wugong("liumai-shenjian", 45, 45, 1);
  add("force_factor", 100);
  command("say 施主仍然如此无礼，就休怪老僧了。");
  return 0;
}
