// cloth4.c cry

#include <armor.h>
inherit CLOTH;
void create() {
  set_name("洗得发白的蓝布僧袍", ({ "seng pao", "cloth" }));
  set_weight(400);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一件僧人常穿的袍子，只是穿的太久，蓝色都已褪去。\n");
    set("unit", "件");
    set("material", "cloth");
    set("armor_prop/armor", 1);
  }
  setup();
}
