//taseng.c 护塔僧 cry
#include <ansi.h>

inherit NPC;

void create() {
  set_name("护塔僧", ({ "huta seng", "seng" }));
  set("gender", "男性");
  set("age", 30 + random(20));
  set("long", @LONG
由于天龙寺塔对于天龙寺有特殊的意思，所以每个塔都有人负责守护和打扫，
他就是其中一个。
LONG);

  set("vendetta_mark", "tianlongsi");

  set("str", 30); set("cor", 23); set("int", 29);
  set("per", 22); set("spi", 25); set("cps", 27);
  set("dex", 28); set("con", 26); set("kar", 24);

  set("force", 1500);
  set("max_force", 1500);
  set("force_factor", 150);

  set_wugong("dodge", 100);
  set_wugong("unarmed", 100);
  set_wugong("shenxing", 100, 100, 1);
  set_wugong("duanshi-xinfa", 100, 100, 1);
  set_wugong("wolong-zhang", 100, 100, 1);
  set_xiuwei_by_type("dodge", 1800);
  set_xiuwei_by_type("unarmed", 1800);
  set("combat_exp", 7000000);
  set("social_exp", 20000);
  set("title", "天龙寺");

  setup();

  carry_object(__DIR__ "obj/cloth3")->wear();
}

void welcome_visitor() {
  tell_object(this_player(), "护塔僧说道：此地仍本寺重地，请施主切勿久留！\n");
}

int accept_fight(object me) {
  command("say 贫僧护寺重任在身，请施主见谅。");
  return 0;
}
