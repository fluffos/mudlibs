// tading2.c writen by cry 10.1.98

#include <ansi.h>
inherit ROOM;

void pray_help();
void create() {
  set("short", "塔顶");
  set("long", @LONG
这是天龙寺塔塔顶，室中空无一物，只有正对面摆有一座小小的金身佛像。
四面是严丝合缝的砖墙，没有一扇窗户，只有几座青色的古灯发出昏暗的光照亮
着室内。一个老年僧人正坐在一个蒲团上打坐修炼。
LONG
  );
  set("exits", ([
    "down": __DIR__ "ta2",
  ]));
  set("objects", ([
    __DIR__ "npc/taseng2": 1,
  ]));
  set("detail", ([
    "佛像": "传说每年的某个月圆之夜，在此祈祷，就会出现圣光，助你达成心愿。\n",
  ]));
  setup();
}

void init() {
  add_action("do_pray", "pray");
}

int do_pray() {
  object me = this_player();
  message_vision(HIR "$N跪在蒲团上开始祈祷。\n" NOR, me);
  me->start_busy(60);
  call_out("wakeup", 60, me);
  return 1;


}

void wakeup(object me) {
  me = this_player();
  message_vision(HIG "$N慢慢地抬起了头，发觉自己飞起来了。\n" NOR, me);
  me->move("/d/place/wiz/inn");
  me->unconcious();
}
