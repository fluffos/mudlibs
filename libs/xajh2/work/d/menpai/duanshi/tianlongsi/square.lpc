// square.c writen by cry 9.20.98

#include <room.h>
inherit ROOM;

void create() {
  set("short", "大道");
  set("long", @LONG
走入寺门，眼前青石铺地，一条宽阔的大道，直通正殿。远远便射出道道金
光，其势可与中原五台、普陀、九华、峨嵋诸处佛门胜地的名山大寺媲美，只是
僻处南疆，其名不显而已。 
LONG
  );
  set("outdoors", "tianlongsi");
  set("exits", ([
    "south": __DIR__ "gate",
    "west": __DIR__ "ruihe",
    "east": __DIR__ "linggui",
    "north": __DIR__ "square1",
  ]));
  set("objects", ([
    __DIR__ "npc/siseng": 2,
  ]));
  setup();
}

int valid_leave(object me, string dir) {
  object obj, ob = this_object();

  if (objectp(obj = present("husi seng", ob))
    && me->query("vendetta/tianlongsi") && dir == "south") {
    message_vision("$N对$n喝道：“想跑！没门！”\n", obj, me);
    return -1;
  }
  return 1;
}
