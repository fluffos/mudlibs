inherit ROOM;

void create() {
  set("short", "斗母宫");
  set("long", @LONG
这是给进香客们休息的地方。靠墙有几张木床，床上干干净净的铺着草席。
屋内另一边放一些檀木红漆的桌椅，几个进香客正坐在哪里休息。有的在静静地
整理行装，有的在喝水解乏。
LONG
  );
  set("sleep_room", "inn");
  set("exits", ([
    "south": __DIR__ "lang2",
  ]));
  set("objects", ([
    __DIR__ "npc/guest1": 1,
  ]));
  setup();
