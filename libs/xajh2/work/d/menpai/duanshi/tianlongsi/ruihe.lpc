// ruihe.c cry
inherit ROOM;

void create() {
  set("short", "瑞鹤门");
  set("long", @LONG
这是通往天龙寺练功之处的门户。泛出金辉的门楼上豁然立着一只玉鹤。低
头再看铜门槛早已被踩踏得锃亮，可知人们经常从这里进进出出。抬头向南还可
望见点苍山耸立云天。
LONG
  );
  set("outdoors", "tianlongsi");
  set("exits", ([
    "east": __DIR__ "square",
    "north": __DIR__ "huangtian",
  ]));
  setup();
}
