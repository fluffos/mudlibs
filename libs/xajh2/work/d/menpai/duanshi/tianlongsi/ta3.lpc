// ta3.c cry
inherit ROOM;

void create() {
  set("short", "天龙寺塔");
  set("long", @LONG
这是天龙三塔之一，建于唐初。高约一百余尺，四周大约十数尺见方，气势
宏伟。塔共有十级，塔身耸立挺拔，棱角分明，俨然是天龙寺百年威名的象征。
置身于此，心中豪气陡生。
LONG
  );
  set("exits", ([
    "west": __DIR__ "talin",
    "up": __DIR__ "tading3",
  ]));
  set("objects", ([
    __DIR__ "npc/taseng": 1,
  ]));
  setup();
}

#include "ta.h"
