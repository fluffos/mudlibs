inherit ITEM;

void create() {
  set_name("四十二章经", ({ "sishierzhang jing", "jing" }));
  set_weight(500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一本非常奇怪的经书，不知道记载着什么。\n");
    set("unit", "本");
    set("value", 20);
    set("material", "paper");
    set("skill", ([
      "name": "enigma",
      "gin_cost": 0,
      "xiuwei_required": 0,
      "literate_required": 150,
      "max_lingwu": 150,
      "bonus_jilei": 60,
    ]));
  }
}

#include "study_jing.h"
