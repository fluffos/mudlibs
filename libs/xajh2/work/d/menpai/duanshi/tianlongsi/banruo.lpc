// banruo.c
inherit ROOM;

void create() {
  set("short", "般若台");
  set("long", @LONG
面前一个石迹斑驳的石台，相传当年佛祖曾降临此台传法。再往西去就是本
寺重地——牟尼堂。天龙寺的镇寺之宝——六脉神剑经就置于此中，但却从未有
人敢越雷池一步擅自去取。
LONG
  );
  set("outdoors", "tianlongsi");
  set("exits", ([
    "south": __DIR__ "yuhua",
    "west": __DIR__ "lang1",
  ]));
  setup();
}
