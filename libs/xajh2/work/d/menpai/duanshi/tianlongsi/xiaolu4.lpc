inherit ROAD;

void create() {
  set("short", "山中小路");
  set("long", @LONG
一条十分清静的山中小路，向上通往点苍山的中岳峰。向下不知通往何处。
这里人烟更加稀少，两旁树高林密，绿色的小草和缤纷的小花遍地都是，莺鹊声
声，令人乐而忘忧。
LONG
  );
  set("outdoors", "tianlongsi");

  set("exits", ([
    "eastdown": __DIR__ "xiaolu3",
    "northup": __DIR__ "xiaolu5",
  ]));

  setup();
}
