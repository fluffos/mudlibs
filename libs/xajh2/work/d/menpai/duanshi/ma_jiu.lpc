#include <room.h>
#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "马厩");
  set("long", @LONG
这儿是王府的马厩。一排拴着几十匹高头大马，一看就明显不是本地的品种，
大理、四川的马都比较矮小，善走比较长的山路，但是并不长于快速冲刺，所以
王府里特地到西夏和口外选购了这些良马。几个家丁正在忙着给马添草添料，刷
洗马匹，一个身份高些的家丁走来走去地监督他们。
LONG
  );
  set("exits", ([
    "south": __DIR__ "dongkuayuan",
  ]));
  set("objects", ([
    __DIR__ "npc/jiading3": 2,
    __DIR__ "npc/jiading1": 1,
  ]));
  setup();
}
