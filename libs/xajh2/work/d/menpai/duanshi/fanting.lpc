// room:/d/menpai/duanshi/fanting.c  writen by lala July-25-97

#include <room.h>
#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "饭厅");
  set("long", @LONG
这里是王府下人们用饭的地方。宽大的厅堂里放着十几张圆桌，周围散放着
几十张凳子，几个家丁、卫士正在鼓着腮帮大嚼。南面是厨房，飘来了一阵阵香
气，令人垂涎。如果你饿了就赶快找个地方坐(zuo) 下来吧。
LONG
  );
  set("exits", ([
    "south": __DIR__ "huofang",
    "east": __DIR__ "qianyuan",
  ]));
  set("objects", ([
    __DIR__ "npc/weishi1": random(2),
    __DIR__ "npc/weishi2": random(3),
    __DIR__ "npc/weishi3": random(3),
    __DIR__ "npc/jiading1": random(2),
    __DIR__ "npc/jiading2": random(3),
    __DIR__ "npc/jiading3": random(4),
  ]));
  setup();
}

void init() {
  add_action("do_zuo", "zuo");
}

int do_zuo() {
  object me = this_player();
  if (!me->can_act()) return 0;
  message_vision("$N一屁股坐了下去，大喊一声：“上菜！”\n", me);
  if (me->query("class") != "duanshi") {
    message_vision("过了好一会儿，也没人搭理$N，$N讪讪的站了起来。\n" +
      "周围用饭的家丁卫士们哄笑起来。\n", me);
    return 1;
  } else {
    message_vision("“来啦！”厨子给$N送上一些美味的饭菜，$N开始狼吞虎咽起来。\n", me);
    me->start_busy(3);
    remove_call_out("eating");
    call_out("eating", 3, me);
    return 1;
  }
}
int eating(object me) {
  message_vision("$N吃饱喝足，站了起来。\n", me);
  me->set("food", (int)me->max_food_capacity());
  me->set("water", (int)me->max_water_capacity());
}
