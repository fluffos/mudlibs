// room:/d/dali/wangfu_pailou.c   writen by lala July-25-97

#include <room.h>
#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "王府牌楼");
  set("long", @LONG
这里是镇南王府前的一座牌楼，高达二丈，由黄玉制成，和西北面皇宫屋顶
的琉璃瓦在阳光的照耀下黄白掩映，金碧辉煌，令人目为之眩，感觉分外巍峨庄
严。你抬头望去，但见牌楼上四个大金字“镇南王府”。东面就是王府大院了。
西面是是一条幽静的大街。
LONG
  );
  set("item_desc", ([
    "east": "只见一座雕刻着二龙抢珠的绿琉璃瓦朱红影壁墙严严实实地挡住了你的视线。\n",
  ]));
  set("exits", ([
    "west": __DIR__ "wangfu_jie",
    "east": __DIR__ "wangfu_dayuan",
  ]));
  set("objects", ([
    __DIR__ "npc/weishi2": 4,
  ]));

  setup();
}

int valid_leave(object me, string dir) {
  object *inv;
  string name, firstname;
  int i;
  inv = all_inventory(this_object());

  if (dir == "east") {
    for (i = 0; i < sizeof(inv); i++) {
      if (inv[i]->query("title") == MAG "镇南王府卫士" NOR
        && !inv[i]->is_killing()
        && living(inv[i])
        && !userp(inv[i])) {
        if (me->query("class") != "duanshi") {
          if (me->query("positive_score") <= 2000)
            return notify_fail(
              inv[i]->query("name") + "走上前恭声说道：“王爷身体不适，不便见外客。请改日再来！”\n"
            );
          else {
            name = me->query("name");
            firstname = name[0..1];
            message_vision(HIY "$N朗声说道：“原来是" +
              name + firstname + RANK_D->query_respect(me) + "来访。请进请进！”\n" NOR, inv[i]);
          }
        }
        i = sizeof(inv);
      }
    }
  }
  if (dir == "west"
    && !userp(me)
    && !me->query("can_pass_1")) {
    destruct(me);
    return 0;
  }
  return ::valid_leave(me, dir);
}
