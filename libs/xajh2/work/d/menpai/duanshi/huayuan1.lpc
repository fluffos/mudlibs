#include <room.h>
#include <ansi.h>

inherit ROOM;

void create() {
  set("short", GRN "后花园" NOR);
  set("long", @LONG
这里就是镇南王府的后花园，到处是奇花异草，大理盛产茶花，王府里的花
匠是个老头，平时话不多，却把个后花园的茶花侍弄的千姿百态，“十八学士”、
“抓破美人脸”、“落第秀才”等名花应有尽有。很得小王爷的器重。常来此跟
他探讨花经。花园北面是个小湖，湖中央有座水榭，通过一座曲桥连到这里。
LONG
  );
  set("exits", ([
    "enter": __DIR__ "shuixie",
    "south": __DIR__ "huayuan4",
    "east": __DIR__ "huayuan2",
  ]));
  set("objects", ([
    __DIR__ "npc/yuanding": 1,
  ]));
  set("outdoors", "dali");
  setup();
}
