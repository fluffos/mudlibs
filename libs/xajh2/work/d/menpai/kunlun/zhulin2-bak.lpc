#include "kl_r.h"
string do_dir();
string *leave = ({
  "west", "north", "northwest", "southwest",
  "northeast", "southeast", "south", "east", });



void create() {
  set("short", GRN "竹林" NOR);
  set("long", @LONG
一片茂密的竹林，其势足有三四人高，走来走去，俱是成簇成垄的青竹，置
身其间，只感到散漫清朗，纤巧清秀，竹荫浓郁，使得幽谷更加清幽。
LONG);
  set("no_clean_up", 0);
  set("exits", ([
    "southeast": __DIR__ "zhulin2",
    "south": __DIR__ "zhulin2",
    "north": __DIR__ "zhulin2",
    "southwest": __DIR__ "zhulin2",
    "northeast": __DIR__ "zhulin2",
    "west": __DIR__ "zhulin2",
    "northwest": __DIR__ "zhulin2",
    "east": __DIR__ "zhulin2",
  ]));
  /*
    set("item_desc", ([
    "east" : (:do_dir:),
    "west" : (:do_dir:),
    "north" : (:do_dir:),
    "south" : (:do_dir:),
    "southeast" : (:do_dir:),
    "northwest" : (:do_dir:),
    "northeast" : (:do_dir:),
    "southwest" : (:do_dir:),
]) );
*/
  set("not_startroom", 1);
  setup();
}

void init() {
  object me = this_player(), room, *inv;
  int j;
  if (!kl_mark("query", me, "zhulin", 0, 0)) {
    add_action("ba_zhusun", ({ "ba", "dig" }));
    add_action("do_chase", "chase");
  }
  kl_mark("set", me, "zhulin/rec", -1, 0);
  kl_mark("set", me, "zhulin/noleave", 1, 0);
  if (!room = find_object(__DIR__ "zhulin2"))
    room = load_object(__DIR__ "zhulin2");
  inv = all_inventory(room);
  for (j = 0; j < sizeof(inv); j++) {
    if (!living(inv[j]))
      destruct(inv[j]);
  }
  remove_call_out("wait");
  call_out("wait", 1, me);
}

string do_dir() {
  return (WHT "一片清新幽静的竹林，怎么也看不够！\n" NOR);
}
int valid_leave(object me, string dir) {
  int i;
  object zhulin1, zhulin2;
  if (kl_mark("query", me, "zhulin/noleave", 0, 0)) return notify_fail("\n");
  i = kl_mark("query", me, "zhulin/rec", 0, 0);
  if (dir == leave[i]) {
    kl_mark("add", me, "zhulin/northwest", 1, 0);
  } else if (dir == leave[7 - i]) {
    kl_mark("add", me, "zhulin/southeast", 1, 0);
  } else {
    if (kl_mark("query", me, "zhulin/northwest", 0, 0) > -4)
      kl_mark("add", me, "zhulin/northwest", -1, 0);
    if (kl_mark("query", me, "zhulin/southeast", 0, 0) > -4)
      kl_mark("add", me, "zhulin/southeast", -1, 0);
  }
  if (kl_mark("query", me, "zhulin/northwest", 0, 0) >= 4 && dir == "northwest") {
    zhulin2 = environment(me);
    zhulin1 = new(__DIR__ "zhulin1");
    kl_mark("delete", me, "zhulin", 0, 0);
    message_vision("$N向西北方向离开了这里！\n", me);
    me->move(zhulin1);
    foreach (object ob in all_inventory(zhulin2)) {
      if (userp(ob)) continue;
      destruct(ob);
    }
    destruct(zhulin2);
    return notify_fail("你走来走去，还是在竹林里。\n");
  }
  if (kl_mark("query", me, "zhulin/southeast", 0, 0) >= 4 && dir == "southeast") {
    message_vision("$N向东南方向离开了这里！\n", me);
    zhulin2 = environment(me);
    me->move(__DIR__ "xiaojing");
    foreach (object ob in all_inventory(zhulin2)) {
      if (userp(ob)) continue;
      destruct(ob);
    }
    destruct(zhulin2);
    kl_mark("delete", me, "zhulin", 0, 0);
    return notify_fail("你终于走出了这片竹林！\n");
  } else {
    zhulin2 = environment(me);
    me->move(zhulin2);
    return notify_fail("\n");
  }
}

int wait(object me) {
  int i;
  i = random(8);
  switch (i) {
    case 0:
      write(WHT "一阵轻风吹过……\n"
        GRN "刮得竹叶发出哗啦啦的响声！\n" NOR);
      break;
    case 1:
      write(WHT "一个小小的、青色的嫩" GRN "竹笋" WHT "从一丛竹子下面露出了头！\n"
        WHT "	是那样的清脆可爱！\n" NOR);
      break;
    case 2:
      write(WHT "竹林沙沙的响动了一下。\n"
        WHT "一只" YEL "云雀" WHT "被惊了起来，振翅高飞而去。\n" NOR);
      break;
    case 3:
      write(HIR "簌簌地，脚下突然串过一条小" HIY "蛇" HIR "……\n"
        HIR "幸好没有被它给咬一口，好险啊！\n" NOR);
      break;
    case 4:
      write(WHT "远处不知道是一种什么鸟儿，传来了一阵清脆的叫声：\n"
        BLU "        唧－－咕－－\n" NOR);
      break;
    case 5:
      write(WHT "不知道从什么地方突然跑出一只小" HIW "松鼠" NOR "。\n"
        WHT "只见它欢快的串进了竹林中，眨眼就不见了。\n" NOR);
      break;
    default:
      break;
  }
  kl_mark("set", me, "zhulin/rec", i, 0);
  if (wizardp(me) || kl_dizi(me)) {
    //  write("按照你的经验：\n");
    //write( "出山谷下山方向是："+leave[i]+"\n" );
    //write( "进入山谷的方向是："+leave[7-i]+"\n" );
    if (kl_mark("query", me, "zhulin/southeast", 0, 0) >= 5)
      write("向东南可以离开这里，到达一条小径。\n");
    if (kl_mark("query", me, "zhulin/northwest", 0, 0) >= 5)
      write("向西北方向可以离开这里，到达另外一片竹林。\n");
  }
  kl_mark("delete", me, "zhulin/noleave", 0, 0);
  return 1;
}

int ba_zhusun(string str) {
  object me = this_player();
  if (!str) return 0;
  if (str != "竹笋" && str != "zhusun" && str != "zhu sun") return 0;
  if (kl_mark("query", me, "zhulin/zhusun", 0, 0)) return 0;
  if (kl_mark("query", me, "zhulin/rec", 0, 0) != 1) return 0;
  new(__DIR__ "obj/zhusun")->move(this_player());
  message_vision("$N从竹叶下面拔出一棵竹笋！\n", this_player());
  kl_mark("set", me, "zhulin/zhusun", 1, 0);
  return 1;
}

int do_chase(string str) {
  object me = this_player();
  if (!str) return 0;
  if (str != "白花蛇" && str != "bai she" && str != "baishe") return 0;
  if (kl_mark("query", me, "zhulin/snake", 0, 0)) return 0;
  if (kl_mark("query", me, "zhulin/rec", 0, 0) != 3) return 0;
  message_vision("$N向小" HIY "蛇" NOR "串去的方向追逐过去———\n", this_player());
  new(__DIR__ "npc/baishe")->move(environment(this_player()));
  message_vision("突然一条白花蛇从竹叶下面串了出来——\n", this_player());
  kl_mark("set", me, "zhulin/snake", 1, 0);
  return 1;
}
