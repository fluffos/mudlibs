#include <ansi.h>
inherit ROAD;

void CloneCorpse();



void create() {
  set("short", "山道");
  set("long", @LONG
    这里是穿行于喀拉昆仑山的一条山道。路边丛林漫漫。到处是一片阴森的景
色。据说此处经常有强盗出没，过往的商人们一般都是结伴而行，单人从不敢从
此路过。这些年，强盗猖獗。人人都是岌岌可危。一直往南边去就是天竺的道路
了。据说到了天竺可以学到些奇怪的功夫呢。
LONG
  );

  set("exits", ([ /* sizeof() ==2 */
    "southwest": __FILE__,
    "northeast": __DIR__ "outroad4",
  ]));
  set("outdoors", "silk");
  setup();
}

void init() {
  object me = this_player();
  if (!random(5)) {
    if (!me->query_temp("xli/desert/have_meet")) {
      CloneCorpse();
      me->set_temp("xli/desert/have_meet", 1);
    }
  }

}

void CloneCorpse() {
  object ob, corpse;
  ob = new(MISC_DIR "compass");
  corpse = new(CLONE_DIR "user/corpse");
  corpse->set("name", "腐烂的尸体");
  corpse->set("long", @LONG
一具腐烂的尸体，显然是被这一带的强贼残害了的过路商人的。
LONG
  );
  corpse->set_max_encumbrance(1000);
  corpse->move(this_object());
  ob->move(corpse);
}
