#include "kl_r.h"

mapping *ba_things = ({                             //拔的菜的一个列表。
([
  "name": ({ "baicai", "bai cai", "白菜" }),
  "id": "bai cai",
  "chinese_name": "一棵白菜",
  "file_name": __DIR__ "obj/baicai",
]),
  ([
    "name": ({ "luobu", "luo bu", "萝卜" }),
    "id": "luo bu",
    "chinese_name": "一个萝卜",
    "file_name": __DIR__ "obj/luobu",
  ]),
  ([
    "name": ({ "suan", "蒜" }),
    "id": "suan",
    "chinese_name": "一把大蒜",
    "file_name": __DIR__ "obj/suan",
  ]),
  ([
    "name": ({ "bo he", "bohe", "薄荷" }),
    "id": "bo he",
    "chinese_name": "一把薄荷",
    "file_name": __DIR__ "obj/bohe",
  ]),


});
mapping *zhai_things = ({                           //摘的菜的一个列表。
([
  "name": ({ "doujiao", "dou jiao", "豆角" }),
  "id": "doujiao",
  "chinese_name": "一串豆角",
  "file_name": __DIR__ "obj/doujiao",
]),
  ([
    "name": ({ "qiezi", "qie zi", "茄子" }),
    "id": "qiezi",
    "chinese_name": "一个茄子",
    "file_name": __DIR__ "obj/qiezi",
  ]),
});


mapping query_ba_thing(string shucai_name) {
  int i, j;
  mapping ba_thing;
  string *name;
  for (i = 0; i < sizeof(ba_things); i++) {
    ba_thing = ba_things[i];
    name = ba_thing["name"];
    for (j = 0; j < sizeof(name); j++) {
      if (shucai_name == name[j]) return (ba_thing);
    }
  }
  return 0;
}

mapping query_zhai_thing(string shucai_name) {
  int i, j;
  mapping zhai_thing;
  string *name;
  for (i = 0; i < sizeof(zhai_things); i++) {
    zhai_thing = zhai_things[i];
    name = zhai_thing["name"];
    for (j = 0; j < sizeof(name); j++) {
      if (shucai_name == name[j]) return (zhai_thing);
    }
  }
  return 0;
}



void create() {
  set("short", "蔬圃");
  set("long", @LONG
不管人生活在什么地方，菜，总是要吃的。所以昆仑派，也有其自己的蔬圃
。蔬圃者，种植蔬菜之所在也。这里的蔬圃有十亩见方，在这样一个山坳里，已
经算是很大的一块地了，在这样的一块地里，有各色的蔬菜瓜果。不论什么季节
都可以有新鲜的蔬菜端上饭桌，这里的日子也算不错。在蔬圃里，平时总可以看
见一个种菜的老头，这里的蔬菜就是多亏了他才有得好的收成。
LONG);
  set("exits", ([ /* sizeof() == 1 */
    "northwest": __DIR__ "garden",
  ]));
  set("objects", ([
    __DIR__ "npc/laotou": 1,
    __DIR__ "npc/shudizi": 2,
  ]));
  set("greengrocer", "昆仑派");
  set("outdoors", "kunlun");
  //    set( "no_fight",1 );
  setup();
}

void init() {
  if (kl_dizi(this_player())) {
    add_action("ba_shucai", "ba");
    add_action("zhai_shucai", "zhai");
    add_action("guan_shui", ({ "guan", "jiao" }));
    add_action("do_grow", ({ "grow", "zhong" }));
  }
}

int ba_shucai(string shu_name) {
  object me = this_player();
  mapping shucai;
  shucai = query_ba_thing(shu_name);
  if (!kl_mark("query", me, "shupu/shucai", 0, 0))
    return notify_fail("你怎么敢随便到蔬圃里来撒野？\n");
  if (!shucai) return notify_fail("真不凑巧，这里找不到这样的菜。\n");
  if (present(shucai["id"], me) || present(shucai["id"], environment(me)))
    return notify_fail("老头对你吆喝道：蔬菜一次要少带一点啦！ \n");
  new(shucai["file_name"])->move(me);
  kl_mark("delete", me, "shupu/shucai", 0, 0);
  message_vision("$N从地里费劲的拔起" + shucai["chinese_name"] + "。\n", me);
  return 1;
}

int zhai_shucai(string shu_name) {
  object me = this_player();
  mapping shucai;
  shucai = query_zhai_thing(shu_name);
  if (!kl_mark("query", me, "shupu/shucai", 0, 0))
    return notify_fail("你怎么敢随便到蔬圃里来撒野？\n");
  if (!shucai) return notify_fail("真不凑巧，这里找不到这样的菜。\n");
  if (present(shucai["id"], me) || present(shucai["id"], environment(me)))
    return notify_fail("老头对你吆喝道：蔬菜一次要少带一点啦！ \n");
  new(shucai["file_name"])->move(me);
  kl_mark("delete", me, "shupu/shucai", 0, 0);
  message_vision("$N从架子上轻巧地摘下" + shucai["chinese_name"] + "。\n", me);
  return 1;
}

int guan_shui(string arg) {
  object me, tong;
  me = this_player();
  if (arg != "水" && arg != "shui")
    return 0;
  if (!me->can_act()) return notify_fail("你现在无法浇水。\n");
  if (!tong = present("mu tong", me))
    return notify_fail("你没有桶，浇什么水呀？\n");
  if (!tong->query("full_water"))
    return notify_fail("这桶是空的，里面没有水。\n");
  if (arg == "水" || arg == "shui") {
    message_vision("$N把木桶里的水一瓢一瓢浇进地里面——\n", me);
    tong->delete("full_water");
    tong->set("name", "木桶");
    tong->set("liquid/remaining", 10);
    me->start_busy(15);
    call_out("doing_guan", 1, me);
    if (kl_mark("query", me, "kunlun_work/name", 1, 1) == "浇水")
      kl_mark("set", me, "kunlun_task/done", "浇水", 1);
  }
  return 1;
}

int doing_guan(object me) {
  if (kl_mark("query", me, "shupu/guan_shui", 0, 0) < 5) {
    message_vision("$N将桶里的水向菜地里面不断的灌——\n", me);
    me->receive_damage("sen", 10);
    kl_mark("add", me, "shupu/guan_shui", 1, 0);
    call_out("doing_guan", 5, me);
    return 1;
  } else {
    if (me->query("gender") == "男性")
      message_vision("终于，$N灌水完毕，哈哈笑了几声...\n", me);
    if (me->query("gender") == "女性")
      message_vision("终于，$N灌水完毕，嫣然一笑...\n", me);
    kl_mark("delete", me, "shupu/guan_shui", 0, 0);
    return 1;
  }
}

int do_grow(string str) {
  object me = this_player(), tong, seed;
  int key = 0;
  if (str != "白菜" && str != "蒜" && str != "薄荷")
    return 0;
  if (!me->can_act()) return notify_fail("你现在无法种地。\n");
  if (!tong = present("mu tong", me))
    return notify_fail("你没有水啊，就让菜干死？\n");
  if (!tong->query("full_water"))
    return notify_fail("桶里没有水啦————\n");
  if (!present("chu tou", me))
    return notify_fail("不要锄头你也能种地？真佩服你了。\n");
  switch (str) {
    case "白菜":
      if (seed = present("baicai zi", me)) key = 1;
      break;
    case "蒜":
      if (seed = present("suan zi", me)) key = 1;
      break;
    case "薄荷":
      if (seed = present("bohe zi", me)) key = 1;
      break;
    default:
      break;
  }
  if (!key) return notify_fail("连菜子都没有种什么菜啊！\n");
  message_vision("$N开始埋头在地里种起了" + str + "。\n", me);
  tong->delete("full_water");
  tong->set("name", "木桶");
  tong->set("liquid/remaining", 10);
  destruct(seed);
  me->start_busy(20);
  call_out("doing_grow", 1, me);
  if (kl_mark("query", me, "kunlun_work/name", 1, 1) == "种" + str)
    kl_mark("set", me, "kunlun_task/done", "种" + str, 1);
  return 1;
}

int doing_grow(object me) {
  if (kl_mark("query", me, "shupu/zhong_di", 0, 0) < 3) {
    message_vision("$N高举手中的锄头，挖出一些小坑——\n", me);
    message_vision("$N将手里的菜子撒向小坑里，又将土覆盖住——\n", me);
    message_vision("$N将桶里的水向菜地里撒了一些——\n", me);
    me->receive_damage("sen", 10);
    kl_mark("add", me, "shupu/zhong_di", 1, 0);
    call_out("doing_grow", 10, me);
    return 1;
  } else {
    message_vision("终于，$N种完了菜，直起身来...\n", me);
    kl_mark("delete", me, "shupu/zhong_di", 0, 0);
    return 1;
  }
}
