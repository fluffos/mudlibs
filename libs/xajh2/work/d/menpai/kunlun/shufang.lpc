// shufang.c
// Ffox 98-4-13 20:21
#include <ansi.h>
#include "kl_r.h"
string *b_name = ({
  "jingwen",
  "xiangshu",
  "baijia_xing",
  "shuowen",
  "tiesha-zhang",
  "qishang-quan",
  "sanzi_jing",
  "shuolv", });
string g_name() {
  int i;
  i = random(sizeof(b_name));
  return ("/clone/book/" + b_name[i]);
}
string list_order();




void create() {
  string what;
  set("short", HIG "书房" NOR);
  set("long", @LONG
这是掌门的书房，室仅方丈，可容二三人，南边一扇窗子，窗外杂植些兰桂
竹木。东西靠墙立着两个书架，书籍满架，一张书案，摆设笔墨纸砚，冥然兀坐
，万籁有声。掌门经常到此处翻阅，派遣了一名小书童在此伺候。
    书案上放置了一张掌门人的手谕：〖order〗
LONG);
  set("exits", ([ /* sizeof() == 1 */
    "north": __DIR__ "langdao03",
  ]));
  set("item_desc", ([
    "order": (: list_order :),
  ]));
  what = g_name();
  set("objects", ([
    __DIR__ "npc/shutong": 1,
  ]));
  setup();
  add("search_things", ([
    "书架": what,
  ]));
}

string list_order() {
  object me = this_player();
  int l1, l2, l3, l4;
  if (!kl_dizi(me))
    return ("这是一张四方的纸，纸上写着些字。\n");
  l1 = kl_mark("query", me, "canyue/level1", 1, 1);
  l2 = kl_mark("query", me, "canyue/level2", 1, 1);
  l3 = kl_mark("query", me, "canyue/level3", 1, 1);
  l4 = kl_mark("query", me, "canyue/level4", 1, 1);
  if (l1 <= 0 && l2 <= 0 && l3 <= 0 && l4 <= 0)
    return ("你现在不能参阅任何典籍。还是多去干点活再来啦！\n");
  write(YEL "手谕：\n" NOR);
  write(WHT "┏━━━━━━━━━━━━━━━━━━┓\n" NOR);
  write(WHT "┃┄┄┄" YEL "典籍名称" WHT "┄┄┄┄┄" YEL "武功名称" WHT "┄┄┃\n" NOR);
  write(WHT "┣━━━━━━━━━━━━━━━━━━┫\n" NOR);
  if (l4 > 0) {
    write(WHT "┃┄┄" YEL "「抱朴子内篇」" WHT "┄┄┄" YEL "两仪心法" WHT "┄┄┃\n" NOR);
    write(WHT "┃┄┄" YEL "「玄珠诀」" WHT "┄┄┄┄┄" YEL "玄珠剑法" WHT "┄┄┃\n" NOR);
    write(WHT "┃┄┄" YEL "「阴骘文」" WHT "┄┄┄┄┄" YEL "阴骘步法" WHT "┄┄┃\n" NOR);
    write(WHT "┃┄┄" YEL "「磐恒掌录」" WHT "┄┄┄┄┄" YEL "磐恒掌" WHT "┄┄┃\n" NOR);
  }
  if (l3 > 0 || l4 > 0) {
    write(WHT "┃┄┄" YEL "「昆吾剑谱」" WHT "┄┄┄┄┄" YEL "昆吾剑" WHT "┄┄┃\n" NOR);
    write(WHT "┃┄┄" YEL "「残破无量剑谱」" WHT "┄┄" YEL "无量剑法" WHT "┄┄┃\n" NOR);
    write(WHT "┃┄┄" YEL "「瑶台飞仙图」" WHT "┄┄┄┄" YEL "昆仑步" WHT "┄┄┃\n" NOR);
    write(WHT "┃┄┄" YEL "「白鹤拳谱」" WHT "┄┄┄┄┄" YEL "白鹤拳" WHT "┄┄┃\n" NOR);
  }
  if (l2 > 0 || l3 > 0 || l4 > 0) {
    write(WHT "┃┄┄" YEL "「无量剑谱」" WHT "┄┄┄┄" YEL "无量剑法" WHT "┄┄┃\n" NOR);
    write(WHT "┃┄┄" YEL "「雨后霓虹图」" WHT "┄┄┄" YEL "天虹步法" WHT "┄┄┃\n" NOR);
    write(WHT "┃┄┄" YEL "「铁砂掌谱」" WHT "┄┄┄┄┄" YEL "铁砂掌" WHT "┄┄┃\n" NOR);
    write(WHT "┃┄┄" YEL "「大风歌」" WHT "┄┄┄┄┄┄" YEL "追风拳" WHT "┄┄┃\n" NOR);
  }
  write(WHT "┃┄┄" YEL "「说剑」" WHT "┄┄┄┄┄┄" YEL "基本剑术" WHT "┄┄┃\n" NOR);
  write(WHT "┃┄┄" YEL "「剑术入门」" WHT "┄┄┄┄" YEL "基本剑法" WHT "┄┄┃\n" NOR);
  write(WHT "┃┄┄" YEL "「轻功秘奥」" WHT "┄┄┄┄" YEL "基本轻功" WHT "┄┄┃\n" NOR);
  write(WHT "┃┄┄" YEL "「拳脚入门」" WHT "┄┄┄┄" YEL "基本拳法" WHT "┄┄┃\n" NOR);
  write(WHT "┣━━━━━━━━━━━━━━━━━━┫\n" NOR);
  write(WHT "┃┄┄┄┄┄┄┄┄" YEL "昆仑掌门人：白鹿子" WHT "┄┃\n" NOR);
  write(WHT "┗━━━━━━━━━━━━━━━━━━┛\n" NOR);
  return ("你慢慢地参阅啦！\n");
}
