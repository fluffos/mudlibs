// yeguo
// Ffox 98-5-17 15:42
#include "kl_o.h"
inherit F_FRUIT;

void init() {
  add_action("do_eat", "eat");
}



void create() {
  set_name(MAG "野果" NOR, ({ "ye guo", "guo", "fruit" }));
  set_weight(40);
  set("long", "圆溜溜的野果，不知道可不可以吃。\n");
  set("unit", "枚");
  set("value", 20);
  set("fruit_remaining", 5);  //可以吃6口
  set("food_supply", 10);   //每口加10的food
  set("water_supply", 10);  //每口可以加10的water
  //每次吃的msg,没有也可以的。
  set("eat_msg", "$N拿起$n，大大的啃了一口。\n");
  //最后一口的msg，没有亦可
  set("end_msg", "$N仔细的啃完了这个$n。\n");
  //吃饱了的msg, 没有亦可，但不能有代词。
  set("over_msg", "吃这么多？小心撑破肚皮！！！！\n");
  // 水果吃完剩下的东西 :-)
  set("core", "野果核");     //name
  set("core_id", ({ "guo hu", "core", "hu" }));  //id
  set("core_unit", "个");    //unit
  set("core_long", "一个啃得干干净净的野果核。\n");  //long
  setup();
}
