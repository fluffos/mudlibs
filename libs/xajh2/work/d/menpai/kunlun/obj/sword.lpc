#include <weapon.h>
#include <ansi.h>
#include <mudlib.h>
inherit SWORD;
string not_sell();



void create() {
  set_name(WHT "钢剑" NOR, ({ "gang jian", "gang jian", "sword", "jian" }));
  set_weight(1500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("no_drop", 1);
    set("value", 1000);
    set("material", "steel");
  }
  init_sword(25);
  set("cant_sell", (: not_sell :));
  set("wield_msg", "$N「唰」地一声抽出一把$n握在手中。\n");
  set("unwield_msg", "$N将手中的$n插入腰间的剑鞘。\n");
  setup();
}

string not_sell() {
  object me = this_player();
  if (me->query("family/family_name") == "昆仑派")
    return ("你穷疯了么，拿师门的东西来换钱？\n");
  return ("你是哪儿弄来的这样东西，也到这里来卖？\n");
}

int query_autoload() {
  if (!this_player()) return 0;
  if (this_player()->query("family/family_name") == "昆仑派") {
    this_object()->set("long", "这是一柄" WHT "昆仑派" NOR "特制的精钢剑，只有"
      +WHT "昆仑派" + this_player()->query("name") + "" NOR + "才能使用。\n");
    return 1;
  } else { return 0; }
}

varargs int move(mixed dest, int silent) {
  //  object env = environment();

  //   if ( this_player()->is_ghost() )
  //      return 0;
  if (userp(dest) && query("owner")) {
    if (dest->query("family/family_name") != "昆仑派") return 0;
    if (dest->query("id") != query("owner"))
      return 0;
  }
  if (!stringp(query("owner")) &&
    (dest->query("family/family_name") == "昆仑派")) {
    set("owner", dest->query("id"));
    set("long", "这是一柄" WHT "昆仑派" NOR "特制的精钢剑，只有" +
      WHT "昆仑派" YEL + this_player()->query("name") + "" NOR + "才能使用。\n");
  }

  return ::move(dest, silent);
}

int IsAutoLoad() {
  if (this_player()->query("family/family_name") == "昆仑派") return 1;
  return 0;
}

mapping GetItemInfo() {
  return ([
    "owner": query("owner"),
    "long": query("long"),
  ]);
}

int SetItemInfo(mapping info) {
  if (mapp(info)) {
    set("owner", info["owner"]);
    set("long", info["long"]);
    return 1;
  } else if (!info) {
    return 1;
  } else return 0;
}
