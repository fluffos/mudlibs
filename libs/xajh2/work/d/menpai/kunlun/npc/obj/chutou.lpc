// chutou.c 锄头
// Ffox 98-4-25 14:46

#include <weapon.h>
#include "kunlun.h"

inherit HAMMER;



void create() {
  set_name("锄头", ({ "chu tou", "chutou" }));
  set_weight(4000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long", "这是一把用于挖地锄草的锄头。\n");
    set("value", 100);
    set("material", "wood");
    set("wield_msg", "$N从身边举起一把$n握在手中。\n");
    set("unwield_msg", "$N放下了手中的$n。\n");
  }

  init_hammer(12);
  setup();
}

void init() {
  add_action("do_dig", ({ "dig", "chu" }));
}

int do_dig(string arg) {
  object me;
  me = this_player();
  if (arg != "草" && arg != "cao") return 0;
  if (!environment(me)->query("greengrocer"))
    return notify_fail("这里不需要你来锄草挖地的。\n");
  if (environment(me)->query("greengrocer") !=
    me->query("family/family_name"))
    return notify_fail("这里是别人的地盘，你来凑什么热闹？\n");

  if (me->query_temp("pig/in_chudi"))
    return notify_fail("你已经在锄地了呀！\n");

  if ((int)me->query("sen") < 60)
    return notify_fail("你现在累得不行，怎么能再去干这种活计呢？\n");

  message_vision("$N挥舞手中的锄头，在地里挖起来来....\n", me);
  me->set_temp("pig/in_chudi", 1);
  me->start_busy(15);
  kl_mark("set", me, "wa_di", 0, 0);
  remove_call_out("doing_wa");
  call_out("doing_wa", 1, me);

  if (kl_mark("query", me, "kunlun_work/name", 1, 1) == "锄草")
    kl_mark("set", me, "kunlun_task/done", 1, 1);
  return 1;
}

int doing_wa(object me) {
  if (kl_mark("query", me, "wa_di", 0, 0) < 5) {
    message_vision("$N不断地挥舞手中的锄头...\n", me);
    me->receive_damage("sen", 20);
    kl_mark("add", me, "wa_di", 1, 0);
    call_out("doing_wa", 5, me);
    return 1;
  } else {
    message_vision("终于，$N挖完了，自己满意地笑了笑。\n", me);
    kl_mark("delete", me, "wa_di", 0, 0);
    me->delete_temp("pig/in_chudi");
    return 1;
  }
}
