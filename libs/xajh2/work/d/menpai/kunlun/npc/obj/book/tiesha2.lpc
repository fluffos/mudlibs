// force_book.c

inherit ITEM;



void create() {
  set_name("铁砂掌谱", ({ "tiesha zhang", "shu", "book" }));
  set_weight(600);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "本");
    set("long", "这本书的纸张都已经泛黄了，看上去相当破旧。\n");
    set("value", 10000);
    set("material", "paper");
    set("skill", ([
      "name": "tiesha-zhang",
      "xiuwei_required": 100,
      "literate_required": 20,
      "gin_cost": 10 + random(10),
      "max_jibie": 70,
      "bonus_jilei": 0,
      "bonus_xiuwei": 2,
      "max_xiuwei": 400,
      "bonus_combat_exp": 10,
      "max_combat_exp": 10000,
      "bonus_social_exp": 10,
      "max_social_exp": 10000,
    ]));
  }
}
