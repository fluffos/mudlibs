inherit ITEM;



void create() {
  set_name("「昆吾剑谱」", ({ "kunwu jianpu", "jianpu", "book", "shu", }));
  set_weight(150);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "本");
    set("long", "昆仑派之武功典籍。\n");
    set("value", 10000);
    set("material", "paper");
    set("skill", ([
      "name": "kunwu-jian",
      "xiuwei_required": 330,
      "literate_required": 80,
      "gin_cost": 10 + random(10),
      "max_jibie": 80,
      "max_lingwu": 80,
      "bonus_xiuwei": 4,
      "max_xiuwei": 850,
    ]));
  }
}
