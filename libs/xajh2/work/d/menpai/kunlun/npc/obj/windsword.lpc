// windsword 清风宝剑
// Ffox 98-4-25 21:08

#include <weapon.h>
#include <ansi.h>
inherit SWORD;


void create() {
  set_name("清风宝剑", ({ "qingfeng jian", "sword" }));
  set_weight(1500);
  set("long", CYN "清风" NOR "宝剑，昆仑派之一宝。\n");
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("value", 20000);
    set("material", "iron");
  }
  init_sword(60);
  set("cant_sell", "这是昆仑派之宝，小店如何敢当。\n");
  set("wield_msg", "$N抽出一把$n握在手中。\n");
  set("unwield_msg", "$N将手中的$n插入腰间的剑鞘。\n");
  setup();
}
