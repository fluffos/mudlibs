#include "kl_p.h"
#include "cookwork.h"
#include "work.h"

string do_give_work();



void create() {
  set_name("大厨师", ({ "chu shi", "chu", }));
  set("gender", "男性");
  set("title", "厨房大师傅");
  set("attitude", "peaceful");
  set("age", 51);
  set("per", 25);
  set("long", @LONG
一个胖胖的大师傅，虽然整天在厨房里，但身上衣服还是很清洁。他在这里至少
已经呆了二十年的功夫，昆仑派上下的伙食全靠他了。
LONG);
  set("inquiry", ([
    "干活": (: do_give_work :),
    "帮什么忙": (: do_give_work :),
    "此地": (: about_here :),
  ]));
  set("chat_chance", 25);
  set("chat_msg", ({
    "大厨师高兴地自言自语道：“这菜味道真不错。”\n",
    "大厨师从篮子里面拿出几个茄子，开始洗了起来。\n",
    "大厨师抹了抹头上的汗：“真不容易啊！”\n",
    "大厨师看了看你，说道：“现在还没有正式开饭呢。”\n",
  }));
  setup();
  carry_object("/clone/wear/cloth/cloth2")->wear();
}

string do_give_work() {
  return (give_work("厨房", "大厨师"));
}
