#include <ansi.h>

inherit NPC;



void create() {
  set_name("侍女", ({ "shi nv", "shi", "nv" }));
  set("gender", "女性");
  set("title", "昆仑派第四代弟子");
  set("age", 18 + random(20));
  set("long", "一位美丽的昆仑派陪练侍女。\n");
  set("combat_exp", 6000000);
  set("per", 35);
  set("attitude", "peaceful");
  set_wugong("wuliang-jian", 150, 150, 1);

  set_wugong("jiben-qinggong", 150, 150, 1);
  create_family("昆仑派", 4, "弟子");
  set("class", "kunlun");
  set("no_get", 1);
  set("set", 1);
  set_xiuwei("sword", 5000 + random(1000));
  //	set_xiuwei("dodge",2000+random(1000));
  set("max_kee", 4000);
  set("max_sen", 4000);
  set("max_force", 3000);
  setup();
  carry_object("/clone/wear/cloth/cloth1")->wear();

  carry_object("/clone/weapon/sword/zhujian")->wield();
}

void init() {
  ::init();
  if (interactive(this_player()) && this_player()->query_temp("peilian") >= 1) {
    remove_call_out("greeting");
    call_out("greeting", 0);
  }
}

void power_up() {
  object me = this_player();
  int mx = 0;
  mapping xiuwei = me->query_xiuwei_map();
  if (sizeof(xiuwei))
    foreach (string x, int v in xiuwei) {
      if (v > mx) mx = v;
    }
  set_xiuwei_by_type("sword", mx * 105 / 100);
  set("combat_exp", me->query("combat_exp") * 5 / 4);
  setup();

}

void greeting() {
  object me = this_player();
  power_up();
  kill_ob(me);
}
