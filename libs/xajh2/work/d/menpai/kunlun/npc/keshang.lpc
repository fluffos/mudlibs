// keshang.c 天竺客商 来自兰州客栈的商人
// Ffox 98-4-25 17:22

inherit NPC;



void create() {
  set_name("天竺客商", ({ "ke shang", "keshang", "shang", "trader" }));
  set("gender", "男性");                //性别：男
  set("age", 28 + random(20));        //年龄：28～47
  set("positive_score", 600);           //正声望：600
  set("negative_score", 300);           //负声望：300
  set("long", @LONG
这是一名从天竺长途跋涉来到中原的客商。
LONG);
  set_wugong("xueying-jian", 60, 60, 1);    //天山雪影剑：  三级
  set_wugong("unarmed", 100, 100, 1);    //基本拳法：    一级
  set_xiuwei("sword", 450);  //剑术修为：    二级
  set_xiuwei("unarmed", 130);  //拳脚修为：    一级
  set("combat_exp", 80000);            //战斗经验：80000
  set("max_force", 600);              //内力：    600
  set("force", 600);
  set("force_factor", 30);              //加力：    30(5%)
  set_hp("kee", 350);              //生命、体能：  350
  set_hp("sen", 350);
  set("chat_chance", 5);
  set("chat_msg", ({
    "客商高兴地自言自语道：“东方的路途真遥远啊。”\n",
    "客商感叹万分：“真不容易呀！”\n",
    "客商舔了舔干裂的嘴唇。\n",
  }));
  setup();
  if (random(100) > 80)
    carry_object(SWORD_DIR + "sword1")->wield();  //长剑
    carry_object(CLOTH_DIR + "mancloth2")->wear();    //高级服装
    add_money("coin", 500 + random(1001));          //五百至一千五百文铜钱
}
