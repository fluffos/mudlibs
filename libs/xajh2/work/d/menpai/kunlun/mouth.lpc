inherit ROAD;



void create() {
  set("short", "山口");
  set("long", @LONG
这里是穿行喀拉昆仑山的山口，处在群峰之间，西侧是那著名的帕米尔高原
，往东看去，那浑身缟素的公格尔峰与二百多里外的慕士塔格峰--那位须发皆白
的“冰山之父”，南北遥遥相对，远超出高原的所有雪峰之上。
LONG);
  set("exits", ([ /* sizeof() == 4 */
    "northeast": __DIR__ "edge",
    "southeast": __DIR__ "outroad2",
    "south": __DIR__ "outroad3",
    "northup": __FILE__,
  ]));
  set("item_desc", ([
    "northup": "往上看去，是帕米尔高原的西缘，人迹罕至的地方。\n",
  ]));
  setup();
}

int valid_leave(object me, string dir) {
  if (dir == "northup")
    return notify_fail("一道难以逾越的天险！\n");
  return ::valid_leave(me, dir);
}
