// jiefei.c
#include <ansi.h>

inherit NPC;

void create() {
  set_name("劫匪", ({ "jie fei", "fei" }));
  set("gender", "男性");
  set("title", "青城山");
  set("str", 25);
  set("age", random(10) + 25);
  set("max_force", 800);
  set("force", 800);
  set("force_factor", 20);
  set("max_kee", 380 + random(100));
  set("max_sen", 580 + random(100));
  set_wugong("unarmed", 80 + random(30), 80 + random(30), 1);
  set_xiuwei_by_type("unarmed", 380 + random(100));
  set_wugong("jiben-qinggong", 90 + random(10), 90 + random(10), 1);
  set_xiuwei_by_type("dodge", 280 + random(100));
  set_wugong("blade", 90 + random(30), 90 + random(30), 1);
  set_xiuwei_by_type("blade", 380 + random(100));
  set("attitude", "aggressive");
  set("combat_exp", 50000);

  setup();
  carry_object(CLOTH_DIR "cloth1")->wear();
  carry_object(BLADE_DIR "blade1")->wield();
}
