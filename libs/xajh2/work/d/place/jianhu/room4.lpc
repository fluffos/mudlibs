// room4.c  cry

#include <ansi.h>
inherit ROOM;

void create() {
  set("short", WHT "石室" NOR);
  set("long", @LONG
穿过一个月亮门，来到另一间石室，有张石床，床前摆着一张小小的木制
摇篮，壁上悬了一张七弦琴，弦线俱已断绝。又见床左有张石几，几上刻了
十九道棋盘，棋局上布着两百余枚棋子，然黑白对峙，这一局并未下毕。
LONG
  );
  set("valid_startroom", 1);
  set("no_fight", 1);
  set("exits", ([
    "south": __DIR__ "room3",
    "up": __DIR__ "road11",
  ]));
  setup();
}
