// door1.c  cry

#include <ansi.h>
#include <room.h>
inherit DOOR_ROOM;


void create() {
  set("short", "洞中");
  set("long", @LONG
洞中漆黑一片。你双手伸出，摸索著一步一步向前走着，脚下地面平整光滑，
便似走在石板路上一般，料想洞中道路必是经过人工修整。
LONG
  );
  set("valid_startroom", 1);
  set("exits", ([
    "northup": __DIR__ "road10",
    "south": __DIR__ "door2",
  ]));
  create_door("south", "两扇紫铜门", "north", DOOR_CLOSED);
  setup();
}
