// gu.c  cry

#include <ansi.h>

inherit ROOM;
int do_eat(string arg);
void create() {
  set("short", GRN "山谷" NOR);
  set("long", @LONG
但见谷中静悄悄地，别说人迹，连兽踪也无半点，唯闻鸟语间关，遥相
和呼。四周花草茂盛，崖边还有一大丛小树上生满了青红色的野果。远望瀑
布，只见瀑布之右一片石壁光润如玉，不知经过了多少年的冲激磨洗。
LONG
  );
  set("valid_startroom", 1);
  set("no_fight", 1);
  set("outdoors", "wuliang");
  set("exits", ([
    "south": __DIR__ "lake",
  ]));
  set("detail", ([
    "花草": "你身旁有一大片空草地，草地周围开满了娇艳的茶花。\n",
  ]));
  set("search_things", ([
    "花木山石": __DIR__ "obj/shibi",
  ]));
  setup();
}

void init() {
  add_action("do_eat", "eat");
  add_action("do_sleep", "sleep");
  add_action("do_push", "push");
  add_action("do_clean", "clean");
}

int do_eat(string arg) {
  object me = this_player();

  if (arg && arg != "野果") return 0;
  if (me->query("food") < (int)me->max_food_capacity() * 8 / 10) {
    me->add("food", 30);
    tell_object(me, "你从小树上摘了几枚野果，入口甚是酸涩，饥饿之下，也不加理会。\n");
  } else
    tell_object(me, "你拿起一枚野果，咬了一口，甚是酸涩，赶紧扔到了一边。\n");
  return 1;
}

int do_sleep() {
  object me = this_player(), obj = this_object();

  tell_object(me, "你只觉混身筋骨酸痛，躺在草地上便即沉沉睡去。\n");
  me->set_temp("block_msg/all", 1);
  message_vision("$N一歪身，倒在草地上，立刻鼾声大作，进入了梦乡。\n", me);

  obj->add_temp("sleeping_person", 1);
  me->set("no_get", 1);
  me->set("no_get_from", 1);
  me->disable_player("<睡梦中>");
  call_out("wakeup", random(90 - me->query("con")), me, obj);
  return 1;
}

void wakeup(object me, object obj) {
  me->set("kee", me->query("eff_kee"));
  me->add("gin", (me->query("eff_gin") - me->query("gin")) * 2 / 3);
  me->add("sen", (me->query("eff_sen") - me->query("sen")) * 2 / 3);
  if ((int)me->query("force") < (int)me->query("max_force"))
    me->add("force", (me->query("max_force") - me->query("force")) / 2);
  me->enable_player();
  me->apply_condition("sleeped", 12);

  message_vision("$N一觉醒来，精力充沛地活动了一下筋骨。\n", me);
  me->set_temp("block_msg/all", 0);
  write("你一觉醒来，精神大振，心想：“说不定山谷有个出口，隐在花木山石之后。”\n");
  obj->add_temp("sleeping_person", -1);
  me->delete("no_get");
  me->delete("no_get_from");
}

int do_push(string arg) {
  object me = this_player();

  if (!arg || arg != "岩石")
    return notify_fail("你要推什么？\n");
  if (!me->query_temp("lingbo"))
    return notify_fail("你要推哪的岩石？\n");
  switch (me->query_temp("lingbo")) {
    case 1:
      return notify_fail("你要推哪的岩石？\n");
    case 2:
    case 3:
      if (me->query("force") < 1000) {
        me->set("force", 0);
        tell_object(me, "你双手齐推岩石右侧，但岩石晃也没晃一下。\n");
      } else {
        me->set_temp("lingbo", 3);
        me->add("force", -1000);
        tell_object(me,
          "你双手齐推岩石右侧，岩石晃了一下，但一晃即回，石底发出藤萝之类断绝声音。\n");
      }
      break;
    case 4:
      if (me->query("force") < 1000) {
        me->set("force", 0);
        tell_object(me,
          "你双手齐推岩石右侧，但岩石晃也没晃一下。\n");
      } else {
        me->add("force", -1000);
        tell_object(me,
          HIY "你伸手再推，那岩石缓缓转动，便如一扇大门相似，只转到一半，\n"
          + "便见岩后露出一个三尺来高的洞穴。\n" NOR
          HIC + "大喜之下，你也没去多想洞中有无危险，便弯腰走进洞去。\n\n" NOR);
        me->move(__DIR__ "road1");
        tell_object(me,
          HIY "只听得“喀啦啦”地一阵轻响，岩石又转了回去。\n" NOR);
      }
      break;
    default:
      return notify_fail("BUG!快报告巫师吧！\n");
  }
  return 1;
}

int do_clean(string arg) {
  object me = this_player();

  if (!arg || arg != "藤萝")
    return notify_fail("你要清理什么？");
  if (me->query_temp("lingbo") < 4) {
    message_vision(CYN "$N俯身将大小岩石之间的蔓草葛藤尽数拉去，拨净了泥沙。\n" NOR, me);
    me->start_busy(1);
    me->set_temp("lingbo", 4);
  } else
    tell_object(me, "你已经把那里清理的很干净了！\n");
  return 1;
}
