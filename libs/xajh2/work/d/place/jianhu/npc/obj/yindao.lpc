// yindao.c 短柄银刀 for yun zhonghe
// writen by tea 11.15.98

#include <weapon.h>
#include <ansi.h>

inherit DAGGER;

void create() {
  set_name(YEL "短柄" HIW "银刀" NOR, ({ "yin dao", "dao", "dagger" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long", "这是一把锋利的短刀，握柄银制，花纹乱舞，寒光环绕。");
    set("value", 20000);
    set("material", "silver");
  }
  init_dagger(55);
  set("wield_msg", "$N从腰间亮出$n握在手中。\n");
  set("unwield_msg", "$N将手中的$n别回腰间。\n");
  setup();
}
