// bush.c  cry

#include <ansi.h>
inherit ROOM;

void create() {
  set("short", GRN "草丛" NOR);
  set("long", @LONG
你走过近五百级石阶，眼前骤然一亮，已来到一片草丛之中，心中激动无比。
眼前淘淘水声，原来已到金沙江畔。
LONG
  );
  set("valid_startroom", 1);
  set("outdoors", "wuliang");
  set("exits", ([
    "out": "/d/map/xinan/dukou1",
    "down": __DIR__ "road14",
  ]));
  set("objects", ([
    __DIR__ "npc/mang": 1
  ]));
  setup();
}
void init() {
  add_action("do_update", "update");
}

int do_update(string arg) {
  return 1;
}
