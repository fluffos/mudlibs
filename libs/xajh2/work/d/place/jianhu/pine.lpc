int do_climb(string arg) {
  object me = this_player();

  if (!arg && arg != "up" && arg != "down")
    return notify_fail("你要往哪看爬？\n");
  else {
    if (arg == "up")
      if (random(4)) {
        tell_object(me, HIY "你用尽全身的力量的向上爬去，但一不小心又掉了下来。\n" NOR);
        me->unconcious();
      } else {
        tell_object(me, HIY "你用尽全身的力量的向上爬去，终于成功了！\n" NOR);
        me->move("/d/menpai/wuliang/jueya");
        me->unconcious();
      }
    if (arg == "down") {
      tell_object(me, HIY "你身子一晃，已靠到了崖壁，手脚并用的忿力向下爬，爬，爬。。。\n\n");

      me->unconcious();
      me->move(__DIR__ "lake");
    }
  }
  return 1;
}
