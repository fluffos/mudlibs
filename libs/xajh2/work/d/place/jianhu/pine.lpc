// pine.c  cry

#include <ansi.h>

inherit ROOM;

void create() {
  set("short", GRN "古松" NOR);
  set("long", @LONG
这是崖边伸出的一株古松，你双臂牢牢抱住了它的一根树枝，悬在半空
不住摇晃。向下望去，只见深谷中云雾弥漫，兀自不见尽头。你还是赶紧爬
上去吧。
LONG
  );
  set("valid_startroom", 0);
  set("outdoors", "wuliang");
  set("exits", ([
    "down": __DIR__ "lake",
  ]));
  setup();
}

void init() {
  add_action("do_climb", "climb");
}

