// road1.c  writen by cry 9.30.98

#include <ansi.h>
inherit ROOM;

void create() {
  set("short", "洞中");
  set("long", @LONG
石门处微微有亮光透入，向内走得十余步，就已无丝毫光亮。你双手伸出，
每一步跨出都先行试过虚实，但觉脚下平整，便似走在石板路上一般，料
想洞中道路必是经过人工修整。
LONG
  );
  set("valid_startroom", 1);
  set("exits", ([
    "westdown": __DIR__ "road2",
  ]));
  setup();
}

void init() {
  add_action("do_push", "push");
  remove_call_out("dest_road");
}

int valid_leave(object me, string dir) {
  call_out("dest_road", 2, dir);
  return 1;
}

void dest_road(string dir) {
  if (query("exits/" + dir))
    destruct(this_object());
}
int do_push(string arg) {
  object me = this_player();

  if (!arg || arg != "石门")
    return notify_fail("你要推什么？\n");
  if (me->query("force") < 1000) {
    me->set("force", 0);
    tell_object(me,
      "你双手齐推石门左侧，但石门晃也没晃一下。\n");
  } else {
    me->add("force", -1000);
    tell_object(me,
      HIY "你双手齐推石门左侧，石门缓缓打开，你一个箭步走了出去。\n\n" NOR);
    me->move(__DIR__ "gu");
    tell_object(me,
      HIY "只听得“喀啦啦”地一阵轻响，石门又转了回去。\n" NOR);
  }
  return 1;
}
