// shibi.c writen by cry 10.1.98

#include <ansi.h>

inherit ITEM;
int look_item(string arg);
void create() {
  set_name(HIC "石壁" NOR, ({ "shibi" }));
  set_weight(200000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "这是一块石壁，表面光亮如镜，只是比瀑布旁的石壁小一点儿. \n");
    set("unit", "块");
    set("value", 1000);
    set("material", "stone");
  }
  setup();
}

void init() {
  add_action("look_item", "look");
}

int look_item(string arg) {
  object me = this_player();
  string long = query("long");
  int hour = query_shichen() * 2;

  if (hour > 21 && arg == "shibi" && me->query_temp("lingbo")) {
    set("long", long
      + "一束月光透过远处峭壁的洞孔，将那剑影映到小石壁上。\n只见壁上的剑影"
      + "斜指向北，剑尖对准了一块岩石。\n");
    if (me->query_temp("lingbo") < 2)
      me->set_temp("lingbo", 2);
  } else
    set("long", "这是一块石壁，表面光亮如镜，只是比瀑布旁的石壁小一点儿. \n");
  return 0;
}
