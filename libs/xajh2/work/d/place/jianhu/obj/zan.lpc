#include <ansi.h>
#include <armor.h>

inherit HEAD;

void create() {
  set_name(HIC "水晶簪" NOR, ({ "shuijing zan", "zan" }));
  set_weight(50);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "这是一支用水晶雕成的首饰。\n");
    set("unit", "支");
    set("value", 12500);
    set("material", "iron");
    set("armor_prop/armor", 10);     //护具

    //				set("gifts_modify/per",1)	//改变天赋
    set("armor_prop/strength", 1);    //力量
    set("armor_prop/courage", 1);    //胆识
    set("armor_prop/intelligence", 1);   //悟性
    set("armor_prop/personality", 1);   //容貌
    set("armor_prop/composure", 1);   //定力
    set("armor_prop/spirituality", 1);   //灵性
    set("armor_prop/dex", 1);      //机敏
    set("armor_prop/constitution", 1);      //根骨
    set("armor_prop/karma", 1);      //运气
    set("female_only", 1);
  }
  setup();
}
