#include "hami.h"

void create() {
  set_name("驿长", ({ "yi zhang", "yizhang", "zhang" }));
  set("gender", "男性");                //性别：男
  set("age", 35);
  set("long", @LONG
本地人……艺人………
LONG);
  set_wugong("wuyu-quan", 150, 150, 1);
  set_wugong("sata-shenfa", 200, 200, 1);
  set_wugong("taixuan-xinjing", 140, 140, 1);
  set("max_force", 4000);
  set("force", 4000);
  set("force_factor", 400);
  set("attack", 60);
  set_xiuwei("unarmed", 6000 + random(2000));
  set_xiuwei("dodge", 5000 + random(2000));
  set("combat_exp", 50000000);
  set("wimpy", 60);
  set("attitude", "friendly");
  set("inquiry", ([
    "此地": (: ask_where :),
  ]));
  setup();
  carry_object("/d/menpai/kunlun/npc/obj/diaoqiu")->wear();       //粗布衣
}
