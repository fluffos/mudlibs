// $Id: tantu1.c,v 1.2 2001/02/05 06:24:12 nerd Exp $

inherit ROOM;

void create() {
  set("short", "滩涂");
  set("long", @LONG
一片荒凉的滩涂横亘在你的面前，除了天空中一两只孤零零飞翔的鸥鸟以外
这里没有任何生气。前面是一大片芦苇丛，看起来里面可能有个小湖，但是被芦
苇所环绕而无法被人所看到。大片的芦苇在风中摇曳，发出沙沙的响声，更使你
显得孤寂无助。
LONG
  );
  set("exits", ([
    "west": "/d/map/zhongyuan/tulu",
  ]));
  set("outdoors", "xkdao");
  set("not_startroom", 1);
  setup();
}

void set_exits() {
  object room;
  int i, j;
  string str;
  if (random(10) == 0) {
    set("exits", ([
      "west": "/d/map/zhongyuan/tulu",
      "southeast": __DIR__ "luwei_dang",
    ]));
    return;
  } else {
    j = 0;
    for (i = 1; i <= 8; i++) {
      str = "/d/place/xkdao/luwei_cong_";
      str += (string)i;
      if (!room = find_object(str))
        room = load_object(str);
      if (!room)
        continue;
      if (sizeof(all_inventory(room)) == 0) {
        j = i;
        break;
      }
    }
    if (j == 0)  // can't find empty room.
      return;
    str = "d/place/xkdao/luwei_cong_" + (string)j;
    set("exits", ([
      "west": "/d/map/zhongyuan/tulu",
      "southeast": str,
    ]));
    return;
  }
}

void init() {
  set_exits();
}

int valid_leave(object ob, string dir) {
  if (dir == "southeast")
    set_exits();
  return 1;
}
