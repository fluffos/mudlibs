#include <ansi.h>

inherit ROOM;

private string long1 = @LONG
面前是一片无边无际的芦苇荡，万籁俱寂，只听见你自己的脚步声和风吹芦
苇丛发出的哗哗声，偶尔还有几声鸥鸟的叫声。极目望去，风吹芦苇丛，似波浪
起伏，时而好象还有一些人影露出，不知是干什么的.....
LONG;

private string long2 = @LONG
面前是一片无边无际的芦苇荡，万籁俱寂，只听见你自己的脚步声和风吹芦
苇丛发出的哗哗声，偶尔还有几声鸥鸟的叫声。极目望去，风吹芦苇丛，似波浪
起伏，几只鸥鸟在上空徘徊，似乎在觅食.....
LONG;

private string long3 = @LONG
面前是一片无边无际的芦苇荡，万籁俱寂，只听见你自己的脚步声和风吹芦
苇丛发出的哗哗声，偶尔还有几声鸥鸟的叫声。极目望去，风吹芦苇丛，似波浪
起伏，突然远处惊起一群鸥鸟.....
LONG;

void create() {
  set("short", BLU "芦苇荡" NOR);
  set("not_startroom", 1);
  set("outdoors", "xkdao");
  set("exits", ([
    "south": __FILE__,
    "north": __FILE__,
    "west": __FILE__,
    "east": __FILE__,
    "southeast": __FILE__,
    "southwest": __FILE__,
    "northeast": __FILE__,
    "northwest": __FILE__,
  ]));
  set("item_desc", ([
    "south": "从这里望去，远处还是一片无边无际的芦苇荡.....\n",
    "north": "从这里望去，远处还是一片无边无际的芦苇荡.....\n",
    "west": "从这里望去，远处还是一片无边无际的芦苇荡.....\n",
    "east": "从这里望去，远处还是一片无边无际的芦苇荡.....\n",
    "southeast": "从这里望去，远处还是一片无边无际的芦苇荡.....\n",
    "southwest": "从这里望去，远处还是一片无边无际的芦苇荡.....\n",
    "northeast": "从这里望去，远处还是一片无边无际的芦苇荡.....\n",
    "northwest": "从这里望去，远处还是一片无边无际的芦苇荡.....\n",
  ]));
  setup();
}

void init() {
  if (random(10) > 4)
    set("long", long1);
  else {
    if (random(2))
      set("long", long2);
    else
      set("long", long3);
  }
  foreach (object ob in all_inventory(this_object())) {
    if (!userp(ob))
      destruct(ob);
  }
}
