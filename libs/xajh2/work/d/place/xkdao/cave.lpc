void init() {
  object me, room;
  if (!room = find_object(__DIR__ "cave"))
    room = load_object(__DIR__ "cave");
  //不同的人可以再加入一些秘密
  me = this_player();
  if (!me->query_temp("dan/正常")) {
    message_vision("你怎么进来的.....死去吧.....\n", me);
    me->die();
  }
  add_action("do_mosuo", "mosuo");
  add_action("do_linmo", "linmo");
  //add by xli 
  /*    remove_call_out("do_waterrise");
    call_out("do_waterrise",10,me);
*/
  //add end
}
//add by xli
int do_waterrise(object me)  //涨水
{
  object *inv;
  int i;
  inv = all_inventory(this_object());
  message_vision(RED "石洞的地下隐隐有水“汩汩”的声音......\n" NOR, me);
  delayawhile(1);
  message_vision(YEL "不到一会，就见地上渗入的水越来越多......\n" NOR, me);
  delayawhile(1);
  message_vision(BLU "石洞中慢慢渗入了大量的海水，水位在上升......\n" NOR, me);
  delayawhile(1);
  for (i = 0; i < sizeof(inv); i++) {
    if (!userp(inv[i]) || wizardp(inv[i]))
      continue;
    if (inv[i]->query_temp("netdead"))  //断线的直接移走
    {
      inv[i]->move("/clone/misc/void");
      continue;
    }

    if (newbiep(inv[i]) || inv[i]->query_temp("dan/正常") != 1)   //新手直接死亡
    {
      message_vision(RED "$N被渐渐淹没在水中，手脚不停地挥舞着。\n" NOR, inv[i]);
      delayawhile(1);
      message_vision(RED "$N渐渐窒息，脑袋在水面以下，只见几个水泡慢慢浮了上来。\n" NOR, inv[i]);
      inv[i]->die();
      continue;
    }
    //其他人
    message_vision(YEL "$N奋力向上游着，脑袋在水中一沉一浮，煞是危险！\n" NOR, inv[i]);
    delayawhile(1);
    message_vision(YEL "水面越涨越高，$N只好憋住了呼吸，希望能逃过这一劫......\n" NOR, inv[i]);
    delayawhile(5);
    message_vision(BLU "不知过了多久，水终于退了，$N缓缓睁开了眼睛。\n" NOR, inv[i]);
    delayawhile(1);
    message_vision(BLU "地上还有残留的海水，$N只觉得身体非常空虚，肚子却因喝饱了海水涨的作痛。\n", inv[i]);
    inv[i]->set("water", inv[i]->max_water_capacity());
    inv[i]->set("kee", inv[i]->query("kee") / 2);
  }

  return 1;
}

// damn.
void delayawhile(int xixi) {
  int i, j, k;
  k = 2;
  for (i = 0; i < 1000 * xixi; i++) {
    for (j = 0; j < 1000; j++) {
      k = k * k - k;
    }
  }
}
//add end
int do_mosuo() {
  object me;
  me = this_player();
  message_vision("石壁上的文字的书写和壁画似乎和武功有关，你可以用手临摹.....\n", me);
  return 1;
}

int do_linmo(string arg) {
  object me, room;
  mapping book;
  string skill;
  int cost;
  int nowforce;
  me = this_player();
  if (!room = find_object(__DIR__ "cave"))
    room = load_object(__DIR__ "cave");
  if (!arg)
    return notify_fail("你瞎摸什么啊......?\n");
  if (!me->query_temp("dan/正常")) {
    message_vision("你怎么进来的.....死去吧.....\n", me);
    nowforce = me->query("max_force");
    me->set("max_force", nowforce / 2);
    me->die();
  }
  if (arg == "吴钩霜雪明") {
    skill = "huanhe-dao";
    room->set("huanhe-dao/max_jibie", 20);
  }
  if (arg == "将炙啖朱亥") {
    skill = "huanhe-dao";
    room->set("huanhe-dao/max_jibie", 40);
  }
  if (arg == "三杯吐然诺") {
    skill = "huanhe-dao";
    room->set("huanhe-dao/max_jibie", 60);
  }
  if (arg == "救赵挥金锤") {
    skill = "huanhe-dao";
    room->set("huanhe-dao/max_jibie", 80);
  }
  if (arg == "不惭世上英") {
    skill = "huanhe-dao";
    room->set("huanhe-dao/max_jibie", 100);
  }
  if (arg == "谁能书阁下") {
    skill = "huanhe-dao";
    room->set("huanhe-dao/max_jibie", 200);
  }
  if (arg == "银鞍照白马") {
    skill = "sata-shenfa";
    room->set("sata-shenfa/max_jibie", 20);
  }
  if (arg == "飒沓如流星") {
    skill = "sata-shenfa";
    room->set("sata-shenfa/max_jibie", 50);
  }
  if (arg == "千里不留行") {
    skill = "sata-shenfa";
    room->set("sata-shenfa/max_jibie", 80);
  }
  if (arg == "事了拂衣去") {
    skill = "sata-shenfa";
    room->set("sata-shenfa/max_jibie", 120);
  }
  if (arg == "深藏身与名") {
    skill = "sata-shenfa";
    room->set("sata-shenfa/max_jibie", 200);
  }
  if (arg == "赵客缦胡缨") {
    skill = "sumi-jian";
    room->set("sumi-jian/max_jibie", 20);
  }
  if (arg == "十步杀一人") {
    skill = "sumi-jian";
    room->set("sumi-jian/max_jibie", 40);
  }
  if (arg == "脱剑膝前横") {
    skill = "sumi-jian";
    room->set("sumi-jian/max_jibie", 60);
  }
  if (arg == "邯郸先震惊") {
    skill = "sumi-jian";
    room->set("sumi-jian/max_jibie", 80);
  }
  if (arg == "不惭世上英") {
    skill = "sumi-jian";
    room->set("sumi-jian/max_jibie", 200);
  }
  if (arg == "闲过信陵饮") {
    skill = "wuyu-quan";
    room->set("wuyu-quan/max_jibie", 20);
  }
  if (arg == "五狱倒为轻") {
    skill = "wuyu-quan";
    room->set("wuyu-quan/max_jibie", 40);
  }
  if (arg == "眼花耳热后") {
    skill = "wuyu-quan";
    room->set("wuyu-quan/max_jibie", 60);
  }
  if (arg == "千秋二壮士") {
    skill = "wuyu-quan";
    room->set("wuyu-quan/max_jibie", 80);
  }
  if (arg == "纵死侠骨香") {
    skill = "wuyu-quan";
    room->set("wuyu-quan/max_jibie", 100);
  }
  if (arg == "持觞劝侯嬴") {
    skill = "wuyu-quan";
    room->set("wuyu-quan/max_jibie", 200);
  }
  if (arg == "白首太玄经") {
    skill = "taixuan-xinjing";
    room->set("taixuan-xinjing/max_jibie", 100 + (int)me->query("justice") / 30);
  }
  if (!skill)
    return notify_fail("你瞎摸什么啊......?\n");

  book = room->query(skill);
  cost = book["gin_cost"] * ((40 - (int)me->query_int()) / 10);
  if (cost <= 0) cost = 1;
  if ((int)me->query("gin") < cost) {
    write("你现在过于疲倦，无法专心下来研读新知。\n");
    return 1;
  }
  write(YEL "你正在专心摸索，领悟着些什么....\n" NOR);
  me->receive_damage("gin", cost);
  get_gain(me, room, book);
  return 1;
}

int get_gain(object me, object room, mapping book) {
  string type;
  int bonus;

  if (!book["leixing"] && book["name"] != "taixuan-xinjing") {
    type = SKILL_D(book["name"])->query_xiuwei_type();

    if (type && (int)me->query_xiuwei(type) < book["xiuwei_required"]) {
      write("你仔细摸索，却发现上面所刻的一切什么也不是.....\n");
      return 1;
    }
  }
  if (book["limit_literate_max"]) {
    if (me->query_jibie("literate") > book["limit_literate_max"]) {
      write(RED "怎么回事，你仔细摸索，却感觉不出什么特别的!\n" NOR);
      return 1;
    }
  }
  if (book["limit_literate_min"]) {
    if (me->query_jibie("literate") < book["limit_literate_max"]) {
      write(RED "怎么回事，你仔细摸索，却感觉不出什么特别的!\n" NOR);
      return 1;
    }
  }
  if (book["limit_other_name"]) {
    if (me->query(book["limit_other_name"]) > book["limit_other_number"]) {
      write(RED "怎么回事，你仔细摸索，却感觉不出什么特别的!\n" NOR);
      return 1;
    }
  }
  if (!me->query_jibie(book["name"]))
    me->set_jibie(book["name"], 0);
  if (book["bonus_jilei"]) {
    if (!book["max_lingwu"]
      || me->query_lingwu(book["name"]) > book["max_lingwu"]) {
      write("这里的一切都都已尽被你须知，你已经无法从中领悟到新东西了。");
      return 1;
    }
    if (!me->query_jibie(book["name"])) {
      write("这里只能从中领悟到熟练度。你还不会这门技能。\n");
      return 1;
    }
    bonus = book["bonus_jilei"];
    if (bonus <= 0)
      me->improve_jilei(book["name"], (int)me->query("int") / 3 + 1);
    else
      me->improve_jilei(book["name"], bonus);
    if (book["bonus_social_exp"] &&
      (int)me->query("social_exp") < book["max_social_exp"]) {
      bonus = book["bonus_social_exp"];
      me->add("social_exp", bonus);
    }
    if (book["combat_exp"] &&
      (int)me->query("combat_exp") < book["max_combat_exp"]) {
      bonus = book["bonus_combat_exp"];
      me->add("combat_exp", bonus);
    }
  } else {
    if (me->query_jibie(book["name"])
      && me->query_lingwu_ratio(book["name"]) < 90) {
      write("功夫需要多加练习，才能真正掌握。\n");
      return 1;
    } else {
      if (me->query_jibie(book["name"]) >= book["max_jibie"]) {
        write("这里的一切都都已尽被你须知，你已经无法从中学到新东西了。");
        return 1;
      }
      if (bonus = book["bonus_jibie"] > 0)
        me->improve_jibie(book["name"], bonus);
      else if (bonus <= 0)
        me->improve_jibie(book["name"], random((int)me->query("int") / 10 + random(2)));

      if (book["leixing"]) {
        if (book["bonus_xiuwei"] &&
          (int)me->query_xiuwei(type) < book["max_xiuwei"]) {
          bonus = book["bonus_xiuwei"];
          me->improve_xiuwei(type, bonus);
        }
      }
    }
  }
  write(YEL "你领悟有关" + to_chinese(book["name"]) + "的技巧，从中悟出了一些心得。\n" NOR);
  return 1;
}
