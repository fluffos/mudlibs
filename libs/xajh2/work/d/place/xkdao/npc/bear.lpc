//bruin.c.熊
//date:1997.10.26
// by dan

inherit NPC;

void create() {
  set_name("熊", ({ "xiong" }));
  set("race", "野兽");
  set("age", 20);
  set("long",
    "这是一种神仙们养的熊，也是这里唯一的猛兽...\n");
  set("attitude", "aggressive");
  set("str", 300);
  set("cor", 50);
  set("max_kee", 5000);
  set("eff_kee", 5000);
  set_xiuwei("dodge", 5300);
  set("kee", 5000);
  set("limbs", ({ "头部", "身体", "前脚", "後脚", "尾巴" }));
  set("verbs", ({ "bite", "claw" }));
  set("combat_exp", 1000000000);

  setup();
}

void init() {
  object me = this_player();

  if (wizardp(me))
    return;
  kill_ob(me);
}
