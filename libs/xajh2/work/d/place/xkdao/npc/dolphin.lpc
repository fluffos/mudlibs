//dolphin.c. 海豚
//date:1997.11.24
// by dan

#include <ansi.h>

inherit NPC;

void create() {
  set_name(BLU "海豚" NOR, ({ "hai tun" }));
  set("race", "野兽");
  set_weight(25000);
  set("age", 1);
  set("long", "一条在水中自由游动的海豚，似乎很友好.....\n");
  set("verbs", ({ "bite" }));
  set("combat_exp", 3000000000000);
  setup();
}

void init() {
  object me;
  me = this_player();
  if (!me->query("dolphin"))
    me->set("dolphin", 50);
  if (me->query("dolphin") < 20)
    kill_ob(me);
  if (me->query("dolphin") > 100)
    message_vision("海豚向你摆摆尾巴，叫着，好像要和你玩(playwith ).......\n", me);
  add_action("do_playwith", "playwith");
  return;
}

int do_playwith() {
  object me, obj;
  me = this_player();
  obj = this_object();
  if (me->query("dolphin") < 100) {
    message_vision("海豚好象不理$N....\n", me);
    return 1;
  }
  message_vision("海豚和一起玩耍起来....\n", me);
  obj->set("combat_exp", me->query("combat_exp"));
  me->duilian_ob(obj);
  obj->duilian_ob(me);
  return 1;
}

int accept_object(object me, object obj) {
  if ((obj->query("id") != "yu rou")) {
    message_vision("海豚摆摆尾巴，似乎不喜欢$n......\n", me, obj);
    return 0;
  }
  if (obj->query("id") == "yu rou") {
    message_vision("海豚欢快地叫了起来，似乎很喜欢$n.....\n", me, obj);
    me->set("dolphin", me->query("dolphin") + 1);
    return 1;
  }
}
