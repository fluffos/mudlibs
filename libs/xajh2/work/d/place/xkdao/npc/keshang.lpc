//keshang.c.客商
//date:1997.10.26
// by dan

#include <ansi.h>

inherit NPC;

int about_xkdao(object me);

void create() {
  set_name("商人", ({ "shang ren", "trader", "ren" }));
  set("gender", "男性");
  set("age", 45);
  set("long", "这是一名往来于海外和中原的客商。\n");
  set("chat_chance", 25);
  set("chat_msg", ({
    "商人高兴地道：'终于得救了太谢谢你了'。\n",
    "商人感叹万分：'真不容易呀！'\n",
    "商人舔了舔干裂的嘴唇。\n",
  }));
  setup();
  set("inquiry", ([
    "侠客岛": (: about_xkdao :),
  ]));
}

int about_xkdao(object me) {
  object here = environment(), ob;
  me = this_player();
  if (objectp(ob = present("hai dao", environment(me)))
    && living(ob)) {
    message_vision("$N被海盗拦住了。\n", me);
    return 0;
  }

  if (me->query_temp("ask_keshang")) {
    message_vision("商人说:我好好想想......\n", me);
    return 1;
  }

  me->add("locker_ask", 1);
  me->set_temp("ask_keshang", 1);
  message_vision("客商对$N说:我对这一带很熟，让我仔细想想....\n", me);
  delete("inquiry");  // bye nerd :)
  if (here->query("short") != HIC "海盗船" NOR) {
    me->die();
    command("chat 大家注意了，" + me->query("name") + "(" + me->query("id") + ")" + "被巫师背上侠客岛了。");
    return 1;
  }
  command("chat 大家注意了，" + me->query("name") + "(" + me->query("id") + ")" + "向我打听侠客岛的消息。");
  remove_call_out("think");
  call_out("think", 10, me);
  return 1;
}

int think(object me) {
  me = this_player();
  if (random(5) > 3) {
    message_vision("客商说：上次我遇风暴曾在一无名小岛上躲避，我可以带你去碰碰运气.\n", me);
    remove_call_out("move1");
    call_out("move1", 30, me);
    return 1;
  }

  remove_call_out("move2");
  me->add("locker_askok", 1);
  call_out("move2", 10, me);
  return 1;
}

int move1(object me) {
  message_vision("一会客商把船开到一个海图上也找不着的小岛边，大船不能靠近了...\n", me);
  message_vision("客商用绳子把$N坠入浅海，然后开船走了.....\n", me);
  me->move("/d/place/xkdao/sea");
  me->set_temp("dan/正常", 1);
  me->delete_temp("ask_keshang");
  destruct(this_object());
  return 1;
}

int move2(object me) {
  message_vision("一会客商把船开回大陆，把你送回岸上...\n", me);
  me->move("/d/place/xkdao/shore1");
  me->delete_temp("ask_keshang");
  me->add("locker_askfailed", 1);
  destruct(this_object());
  return 1;
}
