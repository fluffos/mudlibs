//  edit by lin on March 3,  97
// 这是练习用的木刀，为了防治有人用它骗钱，我们设定它不能卖。
#include <weapon.h>
#include <ansi.h>
inherit BLADE;
//inherit F_SAVE;
//inherit F_AUTOLOAD;
void create() {
  set_name("木刀", ({ "mu dao", "dao", "blade" }));
  set_weight(500);
  set("long", "一把木头削成的刀，象是小孩的玩意儿。\n");
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("value", 50);
    set("can_fire", 1);
    set("material", "bamboo");
    set("cant_sell", "小孩玩具也要卖？本店不收这种东西。\n");
  }
  init_blade(5, 0);
  set("wield_msg", "$N拿出一把好象小孩玩具的木刀，握在手中。\n");
  set("unwield_msg", "$N将手中的$n插入腰间。\n");
  setup();
}
