//bolei_shu.c.坡垒树
//date:1997.10.23
//by dan

#include <ansi.h>

inherit ITEM;

void create() {
  set_name(GRN "坡垒树" NOR, ({ "polei shu", "shu" }));
  set_weight(30000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一棵南方特有的坡垒树，可以用做木料...\n");
    set("unit", "棵");
    set("value", 20);
    set("can_fire", 1);
    set("can_cut", 1);
    set("no_get", 1);
  }
}

void init() {
  add_action("do_zhen", "zhen");
}

int do_zhen() {
  object me, ob, room, obj;
  me = this_player();
  ob = this_object();
  room = environment(me);
  if (me->query("force") < 200)
    return notify_fail("你的内力不足.....\n");
  me->add("force", -50);
  message_vision("$N用尽全力震断一棵$n......\n", me, ob);
  if (random(2) > 0) {
    obj = new(__DIR__ "wood1");
  } else {
    obj = new(__DIR__ "wood2");
  }
  obj->move(room);
  destruct(ob);
  return 1;
}
