//fuzi.c.斧子
//date:1997.10.23
//by dan

#include <ansi.h>

inherit ITEM;

void create() {
  set_name(YEL "斧子" NOR, ({ "fu zi", "fu" }));
  set_weight(300);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一把锈迹斑斑的斧子，好像不怎么好用的....\n");
    set("unit", "把");
    set("value", 20);
  }
}

void init() {
  add_action("do_cut", "cut");
}

int do_cut(string arg) {
  object me, ob, obj, obb, evn, *inv;
  int i;
  me = this_player();
  evn = environment(me);
  inv = all_inventory(evn);
  for (i = 0; i < sizeof(inv); i++) {
    if (inv[i]->query("can_cut")) {
      ob = inv[i];
    }
  }
  if (!ob)
    return notify_fail("似乎没有什么可砍的.....\n");
  message_vision("$N举起斧子砍倒一棵$n......\n", me, ob);
  if (random(2) > 0) {
    obj = new(__DIR__ "wood1");
  } else {
    obj = new(__DIR__ "wood2");
  }
  obj->move(evn);
  destruct(ob);
  this_object()->add("cut", 1);
  if (this_object()->query("cut") >= 10) {
    message_vision("斧子一下子断了....\n", me);
    obb = new(__DIR__ "duanfu");
    obb->move(me);
    destruct(this_object());
  }
  return 1;
}
