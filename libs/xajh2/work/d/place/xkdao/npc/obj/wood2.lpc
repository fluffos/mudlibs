//wood2.c.好木材
//date:1997.10.23
//by dan

#include <ansi.h>

inherit ITEM;

void create() {
  set_name(GRN "木材" NOR, ({ "mu cai", "mu" }));
  set_weight(30000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一根未加工的木材,纹理清晰，是一好材料...\n");
    set("unit", "根");
    set("value", 20);
    set("can_fire", 1);
    set("can_refine", 1);
    set("refine_name", "muliao");
    set("refine_msg", "$N拿起木头加工，一会就加工成$n...\n");
  }
}
