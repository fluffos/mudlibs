#include <ansi.h>

inherit ITEM;

void create() {
  set_name(YEL "磨刀石" NOR, ({ "modao shi", "shi" }));
  set_weight(300);
  if (clonep()) {
    set_default_object(__FILE__);
  } else {
    set("long", "一块好象磨刀石似的石头，不知干什么用的......\n");
    set("unit", "块");
    set("value", 20);
  }
}
