#include <ansi.h>
#include <room.h>
#include <ansi.h>
inherit ROOM;

void create() {
  set("short", YEL "海滩" NOR);
  set("long", @LONG
这是东南沿海的沙滩，眼前是一望无际的大海，身后有一小渔村. 这时候的
大海非常平静. 海水缓缓地涌来, 又缓缓地退去. 留下一条弯弯曲曲的潮痕通向
前方. 海面上几乎看不见什么船影，大概渔民们都出海打鱼去了，也没有什么来
往的船只.    
        岸边停靠着一条海船。
LONG);
  set("long1", @LONG
这是东南沿海的沙滩，眼前是一望无际的大海，身后有一小渔村. 这时候的
大海非常平静. 海水缓缓地涌来, 又缓缓地退去. 留下一条弯弯曲曲的潮痕通向
前方. 海面上几乎看不见什么船影，大概渔民们都出海打鱼去了，也没有什么来
往的船只.     
LONG);
  set("long2", @LONG
这是东南沿海的沙滩，眼前是一望无际的大海，身后有一小渔村. 这时候的
大海非常平静. 海水缓缓地涌来, 又缓缓地退去. 留下一条弯弯曲曲的潮痕通向
前方. 海面上几乎看不见什么船影，大概渔民们都出海打鱼去了，也没有什么来
往的船只.    
        岸边停靠着一条海船。
LONG);
  set("exits", ([ /* sizeof() == 2 */
    "north": __DIR__ "village",
    "enter": __DIR__ "boat1",
  ]));
  set("not_startroom", 1);
  set("xk_shore", 0);
  set("outdoor", "zhongyuan");
  setup();
}
