  ([ "quest": "杀" RED "斑斓猛虎" NOR,
    "time": 900,
    "bonus": 8 + random(12),
    "quest_msg":
    "段无畏对你点点头说：“不知道你现在功夫怎么样？听说山区有猛虎\n"
