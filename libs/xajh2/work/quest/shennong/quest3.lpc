#include <ansi.h>

inherit SKILL;

string *medicine1 = ({
  "无量剑谱", "青道袍", "悬泉剑", "残破无量剑谱",
});

string *npc1 = ({
  "龚光杰", "干光豪", "吴光胜", "葛光佩", "商余庆",
  "曲连兴", "褚光泉", "道姑", "怪老头", "郁光标",
});

string *npc2 = ({
  "陈光席", "容子矩", "左子穆", "辛双清", "林双秀",
  "张双翌",
});

mapping query_quest() {
  string name;
  if (random(4) == 0) {
    name = medicine1[random(sizeof(medicine1))];
    return ([ "quest": "取" + name,
      "time": 500 + random(300),
      "bonus": 3 + random(3),
      "quest_msg":
      "司空玄神秘地一笑，说：“知己知彼才能百战百胜，我们得对无量派的\n" +
      "各种东西研究研究。听说无量派的" + name + "有些古怪，你去弄回来看看。”\n",
      "reward_msg":
      "司空玄仔细看看" + name + "笑道：“" + name + "原来就是这么个东西，没什么古怪。\n”",
    ]);
  }
  if (random(4) == 1) {
    name = npc1[random(sizeof(npc1))];
    return ([ "quest": "杀" + name,
      "time": 400 + random(400),
      "bonus": 4 + random(3),
      "quest_msg":
      "司空玄傲慢地说：“无量派的家伙狂妄自大，老夫有好生之德，\n" +
      "你就杀了" + name + "给他们个警告，如果他们自断右臂退出剑湖宫，\n" +
      "老夫可以放他们一条生路。”\n",
      "reward_msg":
      "司空玄嘿嘿冷笑：“无量派的狗东西们现在该慌了手脚了罢！～”\n",
    ]);
  }
  if (random(4) == 2) {
    name = npc2[random(sizeof(npc2))];
    return ([ "quest": "取" + name,
      "time": 500 + random(300),
      "bonus": 6 + random(5),
      "quest_msg":
      "司空玄得意地说：“咱们要抓个无量派的重要人物来拷问拷问，你去\n" +
      "把那个叫做" + name + "的家伙抓来。”\n",
      "reward_msg":
      "司空玄手叉着腰，看着" + name = "冷笑道：“"
      +name + "，想不到你也有落到我手里的一天！”\n",
    ]);
  }
  if (random(4) == 3) {
    name = npc2[random(sizeof(npc2))];
    return ([ "quest": "杀" + name,
      "time": 400 + random(400),
      "bonus": 8 + random(6),
      "quest_msg":
      "司空玄傲慢地说：“无量派的家伙狂妄自大，不肯答应老夫的要求，那\n" +
      "老夫就不客气了，要大开杀戒，杀他个鸡犬不留。你现在就去杀了" + name + "。\n",
      "reward_msg":
      "司空玄大喜：“好，好，你真是我帮的后起之秀啊！\n",
    ]);
  }
}
