dbase (["long":"这是一个用来寄信、收信的信箱，你可以用以下指令来处理你的邮件：mail <某人>               寄信给别人。forward <信件编号> <某人> 将某封信转寄给别人。from                      查看信箱中的信件。read <信件编号>           阅读一封信件。discard <信件编号>        丢弃一封信件。","no_insert":1,"name":"慕容飞雪的信箱","no_get":1,"unit":"个","id":"mailbox","no_drop":1,"owner_id":"xzha",])
mails ({(["time":946788836,"title":"给我点钱","from":"慕容飞雪(xzha)","text":"我要钱买寻呼机，给我点钱。我傍定你了。嘿嘿。","to":"xiaok 哪有钱啊?",]),})
