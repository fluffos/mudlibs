#include <dbase.h>

int is_apprentice_of(object ob) {
  mapping family;

  if (!mapp(family = query("family"))) return 0;

  if (ob->id(family["master_id"])  //modify by jackyboy
  && family["master_name"] == (string)ob->query("name"))
    return 1;

  return 0;
}

void assign_apprentice(string title, int privs) {
  mapping family;

  if (!mapp(family = query("family"))) return;

  family["title"] = title;
  family["privs"] = privs;

  if (userp(this_object()) || !query("title")) {
    if (family["generation"] == 1)
      set("title", family["family_name"] + "开山祖师");
    else
      set("title", sprintf("%s第%s代%s", family["family_name"],
        chinese_number(family["generation"]), family["title"]));
  }
}

// This is used for NPC, or start a new family for a player.
void create_family(string family_name, int generation, string title) {
  mapping family;

  family = allocate_mapping(6);

  family["family_name"] = family_name;
  family["generation"] = generation;

  set("family", family);

  // priv = -1 for ALL privileges.
  assign_apprentice(title, -1);
}

int recruit_apprentice(object ob) {
  mapping my_family, family;
  string familyname;
  if (ob->is_apprentice_of(this_object()))
    return 0;
  if (!mapp(my_family = query("family")))
    return 0;

  family = allocate_mapping(sizeof(my_family));
  family["master_id"] = query("id");
  family["master_name"] = query("name");
  family["family_name"] = my_family["family_name"];
  family["generation"] = my_family["generation"] + 1;
  family["enter_time"] = time();
  ob->set("family", family);
  if (ob->query("family/family_name") == "特种部队") {
    if (family["generation"] == 1) familyname = "开山祖师";
    else if (family["generation"] == 2) familyname = "大队长";
    else if (family["generation"] == 3) familyname = "中队长";
    else if (family["generation"] == 4) familyname = "小队长";
    else familyname = "队员";
  } else if (ob->query("family/family_name") == "皇族") {
    if (family["generation"] == 1) familyname = "开山祖师";
    else if (family["generation"] == 2) familyname = "大统领";
    else if (family["generation"] == 3) familyname = "小统领";
    else if (family["generation"] == 4) familyname = "武士";
    else familyname = "队员";
  } else if (ob->query("family/family_name") == "凤凰星") {
    if (family["generation"] == 1) familyname = "开山祖师";
    else if (family["generation"] == 2) familyname = "大将";
    else if (family["generation"] == 3) familyname = "副将";
    else if (family["generation"] == 4) familyname = "战士";
    else familyname = "队员";
  } else if (ob->query("family/family_name") == "圣殿") {
    if (family["generation"] == 1) familyname = "开山祖师";
    else if (family["generation"] == 2) familyname = "教官总管";
    else if (family["generation"] == 3) familyname = "教官";
    else if (family["generation"] == 4) familyname = "学员";
    else familyname = "队员";
  } else
    familyname = "大哈哈";
  ob->assign_apprentice(familyname, 0);
  return 1;
}
