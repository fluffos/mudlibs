// banker.c 银行家

#include <dbase.h>
#include <ansi.h>

int do_zhuanzhang(string arg) {
  object ob, me;
  string str;
  int num;
  me = this_player();
  if (!arg) return notify_fail("你要干什么？\n");
  if (sscanf(arg, "%s %d", str, num) == 2);
  else return notify_fail("你要转给谁？\n");
  ob = find_player(str);
  if (num < 0) return notify_fail("别想些歪门邪道来骗钱！\n");
  if (num > me->query("money")) return notify_fail("你没有这么多电子货币了！\n");
  if (!ob) return notify_fail("现在没这个人.\n");
  me->add("money", -num);
  ob->add("money", num);
  tell_object(me, sprintf(HIR "你转了%d电子货币给%s！\n" NOR, num, ob->query("name")));
  tell_object(ob, sprintf(HIR "%s转了%d电子货币给你！\n" NOR, me->query("name"), num));
  return 1;
}
