// Room: /u/seaking/kulishi.c

inherit ROOM;
int do_work(string arg);
void create() {
  set("short", "苦力室");
  set("long", @LONG
看什么看,赶快干(work)吧,时间就是金钱!快快快快!!!!!
LONG
  );
  set("sleep_room", 1);
  set("no_steal", "1");
  set("no_beg", "1");
  set("no_clean_up", 0);
  set("exits", ([ /* sizeof() == 1 */
    "up": "/d/city/guangchang",
  ]));
  set("valid_startroom", 1);

  setup();
}
void init() {
  add_action("do_work", "work");
}
int do_work(string arg) {
  object me = this_player();
  object ob;
  ob = new("/clone/money/silver");
  ob->set_amount(10);
  if (me->is_busy()) return notify_fail("你太贪了点吧!\n");
  if ((int)me->query("qi") < 20)
    return notify_fail("你的气力不够了，休息一会儿再做吧。\n");
  message_vision("$N正在埋头赚外快。\n", me);
  me->receive_damage("qi", 10 + random(10));
  me->start_busy(5);
  if (random(2) == 1) {
    ob->move(me);
    tell_object(me, "\n钱来啦,爽啊！\n\n");
  }
  return 1;
}
