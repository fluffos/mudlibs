#include <ansi.h>
inherit NPC;
string ask_me();

void create()
{
        set_name("大师傅", ({ "da shifu", "shifu" }));
        set("long", "
他是凤凰军校的大师傅，专门做饭的的，可以问他食物的事情。\n");
        set("gender", "男性");
        set("age", 41);
        set("attitude", "peaceful");
        set("class", "fighter");
        set("shen_type", 1);
        set("per", 26);
        set("str", 100);
        set("int", 28);
        set("con", 28);
        set("dex", 50);
        
        set("max_qi", 600);
        set("max_jing", 500);
        set("neili", 1000);
        set("max_neili", 1000);
        set("jiali", 20);
        set("combat_exp", 1500000);
        set("score", 6000);
        set("inquiry", ([
                "用餐" : (: ask_me :),
        ]));

        setup();
        carry_object("/clone/weapon/gangdao")->wield();
        carry_object("/clone/misc/cloth")->wear();
}
string ask_me()
{
        object me = this_player();
     me->set("food", 300);
     me->set("water", 300);
         message_vision(        "大师傅给$N一份自助餐，说道：慢慢吃吧! \n",me);
}

