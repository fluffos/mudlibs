inherit ROOM;

void create()
{
  set("short","走廊");
  set("long",
"这里是一条不长的走廊，向前可以看到圣岛宽大的广场，\n向南可到达检验殿。但是似乎看不到门，墙壁的不显眼处挂\n着一个微型的语言接收器，你恍然大悟，原来这里是用声音\n控制的。(如果你想出去，请使用(shuo gate)\n"
     );
  set("exits",([
      "north" : __DIR__"guangchang",
  //    "south" : __DIR__"jianyian",
     ]));

 set("outdoors","shendian");
 setup();
}

void init()
{
        add_action("do_shuo", "shuo");
}

void close_gate()
{
        object room;

        if(!( room = find_object(__DIR__"jianyian")) )
                room = load_object(__DIR__"jianyian");
        if(objectp(room))
        {
                delete("exits/south");
                        message("vision", "监控电脑把门关上了。\n", this_object());
                room->delete("exits/north");
                message("vision", "吱的几声轻响，监控电脑把门关上了。\n", room);
        }
}

int do_shuo(string arg)
{
        object room;

        if (query("exits/south"))
                return notify_fail("监控电脑回答你：门已经打开。\n");

        if (!arg || (arg != "gate" && arg != "south"))
                return notify_fail("你要说什么？\n");

        if(!( room = find_object(__DIR__"jianyian")) )
                room = load_object(__DIR__"jianyian");
        if(objectp(room))
        {
                set("exits/south", __DIR__"jianyian");
                message_vision("$N轻轻说到：请打开大门。\n", this_player());
                room->set("exits/north", __FILE__);
                message("vision", "只听吱的一声轻响，$N的面前出现一道门。\n", room);
                remove_call_out("close_open");
                call_out("close_open", 10);
        }

        return 1;
}

int valid_leave(object me, string dir)
{
        if(query("exits/south") && dir == "south")
        me->delete_temp("mask/agree");        
        return ::valid_leave(me, dir);
}

