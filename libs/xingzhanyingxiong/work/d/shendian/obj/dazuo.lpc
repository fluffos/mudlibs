// exercise.c

#include <skill.h>
#include <ansi.h>
inherit F_CLEAN_UP;

int exercising(object me);
//int halt_exercise(object me, object who, string why);
int halt_exercise(object me);

int main(object me, string arg) {
  int exercise_cost;
  object where;

  seteuid(getuid());
  where = environment(me);

  if (me->is_busy() || me->query_temp("pending/exercising"))
    return notify_fail("你现在正忙着呢。\n");

  if (me->is_fighting())
    return notify_fail("战斗中不能练内功，会走火入魔。\n");

  if (me->query("food") < 50)
    return notify_fail("空腹不能练内功，会走火入魔。\n");

  if (!stringp(me->query_skill_mapped("force")))
    return notify_fail("你必须先用 enable 选择你要用的内功心法。\n");

  if (!arg || !sscanf(arg, "%d", exercise_cost))
    return notify_fail("你要花多少生命力运行周天？？\n");
  if (exercise_cost < 20)
    return notify_fail("你的内功还没有达到那个境界！\n");

  if ((int)me->query("qi") < exercise_cost)
    return notify_fail("你现在的生命值太少了，无法产生气息走满七十二周天。\n");

  if ((int)me->query("jing") * 100 / (int)me->query("max_jing") < 70)
    return notify_fail("你现在持久力不够，无法控制气息的流动！\n");

  write("你闭目坐下，开始运行七十二周天。\n");

  me->set_temp("pending/exercise", 1);
  me->set_temp("exercise_cost", exercise_cost);
  message_vision(HIW "$N开始运行七十二周天。\n" NOR, me);
  me->start_busy((: exercising :), (: halt_exercise :));
  return 1;
}

int exercising(object me) {
  int exercise_cost = (int)me->query_temp("exercise_cost");
  int neili_gain = 1 + (int)me->query_skill("force") / 10;
  if (exercise_cost < 1)
    return 0;
  me->add("neili", neili_gain);
  me->set_temp("exercise_cost", exercise_cost -= neili_gain);
  if (neili_gain < (int)me->query("qi")) {
    me->add("qi", -neili_gain);
  }
  if (exercise_cost > 0)
    return 1;

  me->set_temp("pending/exercise", 0);
  message_vision(HIY "$N气息走满七十二周天，站了起来，感到自己的气息又进了一步。\n" NOR, me);
  if ((int)me->query("neili") < (int)me->query("max_neili") * 2)
    return 0;
  else {
    if ((int)me->query("max_neili") > (int)me->query_skill("force") * 7) {
      write(HIR "你的气息似乎已经填充不了你的气海了。\n" NOR);
      me->set("neili", (int)me->query("max_neili"));
      return 0;
    } else {
      me->add("max_neili", 1);
      me->set("neili", (int)me->query("max_neili"));
      write(HIG "你的气息增强了！！\n" NOR);
      return 0;
    }
  }
}

int halt_exercise(object me) {
  if ((int)me->query("neili") > (int)me->query("max_neili") * 2)
    me->set("neili", (int)me->query("max_neili") * 2);
  me->set_temp("pending/exercise", 0);
  return 1;
}

int help(object me) {
  write(@HELP
指令格式 : exercise|dazuo [<耗费「气」的量> 必须多于 10]

运气七十二周天，以提升自己的气息。

HELP
  );
  return 1;
}
