inherit NPC;
inherit F_MASTER;
#include <ansi.h>

void create()
{
        set_name(HIC"史太龙"NOR, ({"shitailong", "master"}));
	set("nickname", HIB"胸肌男子"NOR);
	set("gender", "男性");
	set("age", 30);
	set("long", 
		"他就是特种部队的黑暗首领，号称胸肌男子的史太龙。\n");
	set("attitude", "peaceful");
	
	set("str", 50);
	set("int", 50);
	set("con", 50);
	set("dex", 50);
        set("qi", 9000);
	set("max_qi", 9000);
	set("jing", 5000);
	set("max_jing", 5000);
	set("neili", 9000);
	set("max_neili", 9000);
	set("jiali", 300);
	
	set("combat_exp", 5000000);
	set("score", -200000);
	 
	set_skill("force", 200);            
	set_skill("duanqing-xinfa", 200);    
	set_skill("blade", 200);          
	set_skill("lengxue-dao", 200);   
	set_skill("dodge", 200);      	    
	set_skill("jiqi-qudong", 200);     
	set_skill("parry", 200);             
	set_skill("unarmed", 200);           
	set_skill("yinyang-zhang", 200);        
	
	
	map_skill("force", "duanqing-xinfa");
	map_skill("unarmed", "yinyang-zhang");
	map_skill("dodge", "jiqi-qudong");
	map_skill("parry", "lengxue-dao");
	map_skill("blade", "lengxue-dao");
	
     create_family("特种部队",1,"黑暗首领");

	setup();
	
}

void attempt_apprentice(object ob)
{
	
	command("say 天星还没有批准我收徒弟！");
		return;
   call_out("mantuo", 10 , ob );

}
int mantuo( object me )
{
  me = this_player();
  if (! ( me->query_temp("大任务"))){
   write("史太龙恶狠狠的对你说：“谁准你进来啦！！！ ”\n");
  command("kick" + me->query("id"));
  me->move("/d/budui/mimijidi");

me->set_temp("大傻",1);
       return 1;
}