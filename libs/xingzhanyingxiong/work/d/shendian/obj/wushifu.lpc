                set("no_get", "1");
                set("no_put", "1");
                set("no_beg", "1");
                set("no_drop", "1");
                set("no_steal", "1");
*/
         set("value", 5000);
                set("material", "leather");
     set("armor_prop/armor", 70);
        }
        setup();
}

