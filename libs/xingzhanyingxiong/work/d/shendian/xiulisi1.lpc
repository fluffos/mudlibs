#include <ansi.h>;
inherit ROOM;

void create()
{
        set("short", "第二修理室");
        set("long", @LONG
卓卡是圣殿与外界来往的主要飞行器，而这里就是一间卓
卡的修理室，房子当中停车几架小型的客用卓卡(zhuka)，几
位年轻的工程师正在忙得团团转，你不由得想过去帮(xiu)他
们一把。
LONG
        );
        set("no_fight",1);
        set("no_steal",1);
        set("no_beg",1);

        set("exits", ([
     "north" : __DIR__"shanpo",
                
]));
        setup();
}

void init()
{
        add_action("do_xiu","xiu");
        add_action("do_ban","dazuo");
        add_action("do_ban","du");
        add_action("do_ban","study");

}

int do_ban()
{
        write ("请不要打扰别人做事！\n");
        return 1;
}
int do_xiu(string arg)
{
        object me = this_player();
        int bonus,exp,pot;
        object mon;

        if((int)(me->query("combat_exp")) > 60000)
           return notify_fail("对不起，这里人手已经够了，十分感谢你的好意。\n");
        if (!arg)
              return notify_fail("你要做什么？\n");
        if (arg != "zhuka")
              return notify_fail("看来这里只能修理卓卡。\n");
        if( (int)me->query_temp("zhuka") ) 
              return notify_fail("你正在修理卓卡中。\n");
        if ((int)(me->query("qi")) < 16)        
              return notify_fail(RED"你感到有些累了，想想还是坐下来休息一会吧。\n");
        message_vision("
$N连忙走过去，从工程师中接过一把钳子，准备开始修理卓卡。\n\n",me);
        me->set_temp("zhuka",1);
        me->add("qi",-10);

        call_out("del_zhuka", 6, me, mon, bonus, exp, pot);
        return 1;
}

void del_zhuka(object me, object mon, int bonus, int exp, int pot)
{
        me->delete_temp("zhuka");
        if (random (10) < 2)
{
       message_vision(HIR"
$N一边修理着卓卡，一边和几个工程师有说有笑着,\n
突然，卓卡主电脑冒出一阵青烟，原来是你不小心触动了主电脑的电源，这时你发现四周的工程师都向你围了过来。\n"NOR,me);
            me->start_busy(3);
        return ;
}
        else
{
 exp=random(100);
 pot=random(100);
        message_vision(HIY"
   $N仔细修理着卓卡，并不时拿起卓卡的结构图看几眼，还和几位工程师低声交流几句。\n
 大约" + chinese_number(exp) + "小时，$N终于把卓卡修好了。\n\n"NOR
    HBBLU"在场工程师们纷纷的围着$N说:今天你可帮了我们大忙呀,这有一点小意思请收下。工程师给$N一些电子货币”。\n"NOR,me);
        bonus = (int) me->query("combat_exp");
        bonus += exp;
        me->set("combat_exp", bonus);
        bonus = (int) me->query("potential");
        bonus += exp;
        me->set("potential", bonus);
me->add("money",random(110));
          me->start_busy(3);
        return;
}
}
