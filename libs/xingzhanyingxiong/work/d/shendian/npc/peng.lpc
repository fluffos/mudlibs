#include <command.h>
#include <ansi.h>
inherit NPC;                                                                    
inherit F_MASTER;                                                               
void create()
{
        set_name( "彭长老" ,({ "peng zhanglao", "peng" }));
        set("gender", "男性");
        set("age", 48);
        set("attitude", "friendly");
        set("str", 30);
        set("int", 28);
        set("con", 30);
        set("dex", 30);
        set("per", 30);
        set("chat_chance", 1);
        set("max_qi",2500);
        set("max_jing",1500);
        set("neili", 2500);
        set("max_neili", 2500);
        set("jiali", 100);
        set("shen_type",1);

      set("combat_exp", 2500000);
        set_skill("force", 150);
        set_skill("sword", 150);
        set_skill("parry", 150);
        set_skill("dodge", 150);
        set_skill("literate", 150);
        set_skill("guang-jian",150);
        set_skill("wuzhu-xinfa",150);
        set_skill("shunjian-yidong",200);
        map_skill("sword", "guang-jian");      
        map_skill("force", "wuzhu-xinfa");      
        map_skill("dodge", "shunjian-yidong");   


        create_family("圣殿", 1, "弟子");
      set("title",HIR"圣殿长老团"NOR);
        setup();
        carry_object("/clone/misc/cloth")->wear();
        carry_object("/clone/weapon/changjian")->wield();
}

