#include <ansi.h>
inherit NPC;
inherit F_MASTER;

void create()
{
        set_name("阿古哒", ({"a guda","guda",}));
        set("long",
                "他是特种部队的一位小卒，心高气盛，极爱杀人。\n"
        );

      set("title","特种部队");
      set("nickname",HIB"杀人如麻"NOR);
        set("gender", "男性");
        set("attitude", "aggressive");

        set("age", 99);
        set("per", 30);
        set("str", 10);

        set("int", 30);
        set("con", 30);
        set("dex", 30);
        set("jing", 400);
        set("max_jing", 400);
        set("neili", 400);
        set("max_neili", 400);
        set("jiali", 400);
   set("combat_exp", 640000);

        set_skill("force", 200);            
     set_skill("duanqing-xinfa", 150);    
        set_skill("blade", 200);          
    set_skill("lengxue-dao", 100); 
        set_skill("dodge", 200);            
      set_skill("jiqi-qudong", 90);     
        set_skill("parry", 200);             
        set_skill("unarmed", 200);           
  set_skill("yinyang-zhang", 100);        
        set_skill("rennai",200);
        set_skill("jianti-shu",200);
        map_skill("force", "duanqing-xinfa");
        map_skill("rennai","jianti-shu");
        map_skill("unarmed", "yinyang-zhang");
        map_skill("dodge", "jiqi-qudong");
        map_skill("parry", "lengxue-dao");
        map_skill("blade", "lengxue-dao");

       set("chat_chance_combat", 100);
        setup();
 carry_object("/clone/cloth/cloth")->wear();
 carry_object("/d/shendian/obj/longrou");

}



void die()
{
        object me, corpse;
        me = query_temp("last_damage_from");

        if( me->query("tmarks4/杀") == 1 ){
            message_vision(HIR"\n$N口吐鲜血栽倒在地断气了。\n"NOR, this_object());
        message_vision(CYN"恭喜，" + me->name() + "，你帮助小泪报了杀父之仇！\n"
                           "这是给你的奖励。\n"
      HIR"250点战斗值,100点学习值\n"NOR,me);
            me->set("mojie_quest4", 1);
  me->add("combat_exp",250);
 me->add("potential",100);
            me->delete("tmarks4");
            corpse = new("/clone/misc/corpse");
            corpse->set("name","阿古哒的死尸");
            corpse->move(environment(this_object()));
            destruct(this_object());
            return;
        }
        else{
            message_vision(HIR"\n$N口吐鲜血栽倒在地断气了。\n"NOR, this_object());
            corpse = new("/clone/misc/corpse");
            corpse->set("name","阿古哒的死尸");

            corpse->move(environment(this_object()));
            destruct(this_object());
            return;
        }
}

