inherit ROOM;
int do_da(string);

void create ()
{
        set ("short", "练武场");
        set ("long", @LONG
这是一个极宽敞的练武场，练武场上有许多人在汗流浃背的练着功。
在场子中央挂着几个沙袋，几位年轻人正在用力的击打着，如果你想你
也可以加入队伍。
LONG);
        set("valid_startroom", 1);

        set("exits", 
        ([
                "east" : "/d/shendian/ruxi",
//               "south" : __DIR__"wuchang3",
        ]));

        set("outdoors", "shendian");

        setup();
}

void init()
{
        add_action("do_da", "da");
}

int do_da(string arg)
{
        object me;
        int a, b;

        me = this_player();

        if ( !arg || ( arg != "sha" ) )
                return notify_fail("你想打什么？要打就打沙袋(sha)吧。\n");
        if ((string)me->query("family/family_name") != "圣殿")
             {
             write("你不是圣殿武士不能在此练功！\n");
                return 1;
 }

        a = random(20)+20;
        b = random(20)+20;

        if((int)me->query("jing") < a)
        {
                return notify_fail("你现在精神无法集中，别再练功了吧！\n");
                return 1;
        }
        if((int)me->query("qi") < a)
        {
                return notify_fail("你都快累死了，快歇歇吧！\n");
                return 1;
        }

        me->add("jing", -10);
        me->add("qi", -10);

        message_vision("$N清喝一声，学着拳王“太森”的模样，摆好架势，一拳打在沙袋上。\n", me);

        if ( (int)me->query_skill("unarmed", 1) < 101)
        {
                me->improve_skill("unarmed", ((me->query("int"))+ random(me->query("int"))));
                tell_object(me, "你觉得你的手有些疼，不过为了面子，你还是忍着没叫了！\n你的拳法进步了！\n");
        }
        else
        { 
                tell_object(me, "你一拳差不多把沙袋打烂了，看来这样练功对你没什么帮助了。\n");
        }
        return 1;
}
