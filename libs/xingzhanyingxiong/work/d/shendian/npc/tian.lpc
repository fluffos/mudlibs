#include <ansi.h>

inherit NPC;

int do_look(string var);
int ask_me();

void create()
{
	set_name("田执事", ({ "tian zhishi", "tian", "zhishi" }));
	set("long", "个白发白须、脸庞幼嫩的白袍人，看不出实际的岁数，\n"+
            "脸上笑容满面。\n");
	set("nickname",HIY"一剑"+HIC "西来" NOR);
	set("gender", "男性");
	set("age", 103);
        set("attitude", "peaceful");
	set("str", 50);
	set("dex", 72);
	set("con", 47);
	set("int", 65);

        set_skill("force", 200);
     set_skill("unarmed", 200);
        set_skill("parry", 200);
        set_skill("dodge", 200);
        set_skill("literate", 200);
        set_skill("guang-jian",200);
        set_skill("wuzhu-xinfa",200);
        set_skill("shunjian-yidong",200);
    set_skill("sheshen-zhang",200);
  set_skill("flying-shu",200);
        set_skill("rennai",200);
        map_skill("sword", "guang-jian");      
        map_skill("force", "wuzhu-xinfa");      
        map_skill("dodge", "shunjian-yidong");   
        map_skill("rennai", "flying-shu");   

          
	set("jiali",250);

	set("combat_exp", 2000000);

	set("max_qi", 4000);
	set("max_jing", 1000);
	set("neili", 8000);
	set("max_neili", 8000);

	set("chat_chance_combat", 40);
	set("chat_msg_combat", ({
		(: perform_action, "guangmang" :),
            }) );
	setup();
        carry_object("/clone/misc/cloth")->wear();
  carry_object("/d/shendian/obj/duzhenjian")->wield();
        create_family("圣殿", 1, "");
      set("title",HIW"圣殿长老团"NOR);
}


void attempt_apprentice(object ob)
{
    if (ob->query_int() < 20) {
        command("say 我不收资质差的弟子，您请回吧！");
		return;
    }
    if ((int)ob->query_skill("wuzhu-xinfa",1) < 150 ) {
        command("say 你的本门心法太低了,还是努努力先提高一下吧!");
		return;
    }
//    if ((int)ob->query ("shen") > 50000 ) {
//        command("say 你正义值不够，你还是到江湖上多历练吧！");
//		return;
//	}
    command("say 好吧，今后你要群奋练功，光大圣殿。");
    command("recruit " + ob->query("id"));
}
