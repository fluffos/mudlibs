#include <command.h>
#include <ansi.h>
inherit NPC;                                                                    
inherit F_MASTER;                                                               
void create()
{
        set_name( "刘敏" ,({ "liu ming", "liu" }));
        set("gender", "男性");
        set("age", 88);
        set("attitude", "friendly");
        set("str", 30);
        set("int", 28);
        set("con", 30);
        set("dex", 30);
        set("per", 10);
        set("chat_chance", 1);
        set("max_qi",3500);
        set("max_jing",3500);
        set("neili", 4500);
        set("max_neili", 4500);
        set("jiali", 120);
        set("shen_type",1);

    set("combat_exp", 1300000);
        set_skill("force", 180);
        set_skill("sword", 180);
        set_skill("parry", 180);
        set_skill("dodge", 180);
        set_skill("literate", 180);
        set_skill("guang-jian",180);
        set_skill("wuzhu-xinfa",180);
        set_skill("shunjian-yidong",180);
        map_skill("sword", "guang-jian");      
        map_skill("force", "wuzhu-xinfa");      
        map_skill("dodge", "shunjian-yidong");   


        create_family("圣殿", 2, "弟子");
      set("title",HIM"圣殿高阶武士"NOR);
        setup();
  carry_object("/d/shendian/obj/wushifu")->wear();
  carry_object("/d/shendian/obj/duzhenjian")->wield();
}
void die()
{
        object corpse, killer;
        int i;
        string skill;
        object ling;

        if( !living(this_object()) ) revive(1);
        if( wizardp(this_object()) && query("env/immortal") ) return;

        this_object()->clear_condition();

        COMBAT_D->announce(this_object(), "dead");
        if( objectp(killer = query_temp("last_damage_from")) ) {
                set_temp("my_killer", killer->query("id"));
                COMBAT_D->killer_reward(killer, this_object());
        }

        if( objectp(corpse = CHAR_D->make_corpse(this_object(), killer)) )
                corpse->move(environment());

        if (userp(killer))
        {
             message_vision(HIC"$N从刘敏身上搜出一把光剑。\n",killer);
             ling=new("/d/shendian/quest/obj/guangjian");
             ling->move(killer);
        }

        this_object()->remove_all_killer();
        all_inventory(environment())->remove_killer(this_object());

        this_object()->dismiss_team();
        destruct(this_object());
}


