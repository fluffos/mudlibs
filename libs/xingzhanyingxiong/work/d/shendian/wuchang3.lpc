inherit ROOM;
int do_da(string);
int clone_challenger(object me);
void create ()
{
        set ("short", "练武场");
        set ("long", @LONG
这里是圣殿特意为各武士专门建立的休练室，不过这间房子似有
如怪，据说是无祖留有感应在这里，房子四周都没有窗口，黑漆漆的，
看不透切，似乎有几个在坐在地上修练(xiu lian)。
LONG);
        set("valid_startroom", 1);

        set("exits", 
        ([
                "east" : "/d/shendian/ruxi",
//               "south" : __DIR__"wuchang3",
        ]));

        set("outdoors", "shendian");

        setup();
}

void init()
{
        add_action("do_xiu", "xiu");
}

int do_xiu(string arg)
{
        object me;
        int a, b;

        me = this_player();

        if ( !arg || ( arg != "lian" ) )
                return notify_fail("你想干什么，这里只可以修练(xiu lian)。\n");
        if ((string)me->query("family/family_name") != "圣殿")
             {
             write("你不是圣殿武士不能用！\n");
                return 1;
 }

        a = random(20)+20;
        b = random(20)+20;

        if((int)me->query("jing") < a)
        {
                return notify_fail("你现在精神无法集中，无法进行修练！\n");
                return 1;
        }
        if((int)me->query("qi") < b)
        {
                return notify_fail("你都快累死了，快歇歇吧！\n");
                return 1;
        }

        me->add("jing", -a);
        me->add("qi", -b);

        message_vision("$N找了个空地坐了下来，慢慢的感应无祖的精能。\n", me);
        if (me->is_busy(2+random(400))) {
                write("你现在正忙着呢。\n");
                return 1;
        }

        if ( (int)me->query_skill("force", 1) < 101)
        {
                me->improve_skill("force", ((me->query("int"))+ random(me->query("int"))));
                tell_object(me, "你似乎真得感应到了无祖的精能，恍然中觉得自己对基础内功有了一定的了解！\n你的基础内功进步了！\n");
        }
        else
        { 
                tell_object(me, "你慢慢地坐了下来，可以你似乎发现感觉不到什么。\n");
        }
        return 1;
}
