#include <room.h>

inherit ROOM;

void create() {
  set("short", "练武场");
  set("long", @LONG
这里是圣岛武士练功的场所，面积还是十分的大，几位身着灰白色劲装
的圣岛武士正在练士长的指导下，学习各种武功，其中有几位身法分外的
的轻盈，显然武功已有大成。
LONG);
  set("exits", ([
    "south": __DIR__ "ruxi",
    "east": __DIR__ "wuqiku",
    "enter": __DIR__ "mapanluo1",
  ]));
  set("objects", ([
    "/d/shendian/npc/zhuqie": 1,
  ]));
  set("outdoors", "shendian");
  setup();
}
int valid_leave(object me, string dir) {
  if (me->query("family/family_name") != "圣殿" && dir == "enter")
    return notify_fail("你不是圣殿的，快点出去！！\n");
  return ::valid_leave(me, dir);
}
