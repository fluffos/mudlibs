#include <ansi.h>
inherit ITEM;
void setup() {}
void init() {
  add_action("do_eat", "eat");
  add_action("do_quit", "give");
  add_action("do_quit", "put");
  add_action("do_quit", "beg");
  add_action("do_quit", "steal");

}
void create() {
  set_name(HIW "二等奖" NOR, ({ "dan", }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "颗");
    set("long", "《星战英雄》全体巫师表示歉意。\n");
  }
  setup();
}
int do_quit(string arg) {
  write(this_player()->query("name") + "，这是星战英雄全体巫师的一点小心意，留着自己用吧！\n");
  return 1;
}
int do_eat(string arg) {
  object me = this_player();
  if (!id(arg))
    return notify_fail("你要吃什么？\n");
  if (me->query_temp("buduili") != 1 && me->query("family/family_name") == "特种部队") {
    me->add("combat_exp", 10000);
    me->add("potential", 5000);
    me->set_temp("buduili", 1);
    message_vision(HIC "$N吃下一粒丹，觉得浑身是劲，真爽。！\n" NOR, me);
    destruct(this_object());
  } else message_vision(HIC "$N吃下一粒丹，觉得浑身是痛，原来是吃多了。！\n" NOR, me);
  return 1;
}
