inherit ROOM;
#include <ansi.h>
void create()
{
	set("short", HIY"机器人修理厂"NOR);
	set("long", @LONG
你走到这里，发现这是一个机器人的修理厂，虽然设备简陋，但地盘却大得不得了。
你正在到处观看时，从你后面传来一个声音：“怎么？你又偷懒，还不快去工作！”
你向后看了看，却什么都没发现，只是看到了一块木牌(mupai)立在那儿！
LONG
	);

	set("exits", ([
		
                "southeast"  : __DIR__"xiaodao3",
	]));
	
	
        set("item_desc",(["mupai": "你还不快去工作(work)！！！！\n",
                             
                         ]));
	setup();
	
}
void init()
{
	add_action("do_work", "work");
}
int do_work()
{
        object me;
        int exp;
	me = this_player();
if (me->query("combat_exp")>10000) return notify_fail("您还是走吧，这里已经没您发展的余地了！\n");

  
if ( me->query("qi") < 20 ) return notify_fail("你的生命力不够，休息一下再来吧！\n");
if ( me->is_busy()) return notify_fail("你正忙着呢！\n");
me->add("qi",-random(20));
        if ( random((int)me->query("kar")) < 5 )
	{
		message_vision("$N小心的帮忙修理着机器人。结果没搞好，反倒把机器人弄坏了！\n", me);
me->start_busy(random(10));
       
       }

	else
	{
		message_vision("$N手中拿着电起子，小心的拆卸着机器人。\n", me);
write("你一边拼命的修着，冥冥之中感到自己的MONEY增加了，心中暗叫到：“爽呀！”\n");
me->add("money",random(20));
me->add("combat_exp",random(20));
me->add("potential",random(20));
me->start_busy(random(10));
	}

   
return 1;
}

