inherit ROOM;
#include <ansi.h>
void on_board();
void arrive();
void close_passage();

void reset();

void create() {
  set("short", "特种部队飞机场");
  set("long", @LONG
这就是特种部队的飞机场了，如果想离开特种部队联盟镇，就必须坐飞机离开。
你看了看机场上，只见上面停着一架星际宇宙飞船(feichuan)。旁边立了一块
牌子(paizi)。
LONG
  );

  set("exits", ([
    "south": __DIR__ "bdguangchang",
  ]));
  set("objects", ([
    "/d/npc/daoshen": 1,
  ]));

  set("item_desc", ([
    "paizi": "暂不营业。\n",
    "feichuan": "这是一艘巨大无比的飞船，看上去可以载很多人，你也可以试着坐(zuo)上去。\n",

  ]));

  set("outdoors", "budui");
  setup();
}



void init() {
  //  add_action("do_zuo", "zuo");
}

int do_zuo(string arg) {
  object room;
  if (!arg || (arg != "feichuan")) return notify_fail("你想坐什么？\n");
  if (!query("exits/enter")) {
    if (!(room = find_object(__DIR__ "feichuan")))
      room = load_object(__DIR__ "feichuan");
    if (room = find_object(__DIR__ "feichuan")) {
      if ((int)room->query("zuo_trigger") == 0) {
        room->set("zuo_trigger", 1);
        set("exits/enter", __DIR__ "feichuan");
        room->set("exits/out", __FILE__);
        message("vision", "只见空中落下一架巨大的宇宙飞船，你看得惊呆了！"
          "只见飞船上缓缓的伸出一快钢板，供人们上下！\n", this_object());

        remove_call_out("on_board");
        call_out("on_board", 15);
      } else
        message_vision("你等呀等。。。等了好久好久，飞船还是没来！"
          "看来已经有人在做坐飞船了！\n", this_object());
    } else
      message_vision("ERROR: boat not found\n", this_object());
  } else
    message_vision("岸边一只渡船上的老艄公说道：正等着你呢，上来吧。\n",
      this_object());

}

void on_board() {
  object room;

  if (!query("exits/enter")) return;

  message("vision", "你只听见[轰]的一声，飞船已经没了踪影。\n",
    this_object());

  if (room = find_object(__DIR__ "feichuan")) {
    room->delete("exits/out");
    message("vision", "飞船摇了摇，然后[嗖]的一声响，你感到飞船向前飞了出去。"
      "你高兴得差点叫了出来，你显然是个从没坐过飞船的人。\n", room);
  }
  delete("exits/enter");

  remove_call_out("arrive");
  call_out("arrive", 20);
}

void arrive() {
  object room;
  if (room = find_object(__DIR__ "feichuan")) {
    room->set("exits/out", "/d/city/guangchang");
    message("vision", "飞船震了震，然后平稳的停了下来，向外伸出了一块铁钢板，"
      "供人们上下。\n", room);
  }
  remove_call_out("close_passage");
  call_out("close_passage", 20);
}

void close_passage() {
  object room;
  if (room = find_object(__DIR__ "feichuan")) {
    room->delete("exits/out");
    message("vision", "你只见飞船向后，狂喷火焰，然后[唰]的一声，就以不知去向。\n", room);
    room->delete("zuo_trigger");
  }
}
