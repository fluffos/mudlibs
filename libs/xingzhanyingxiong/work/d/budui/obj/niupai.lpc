// binggan.c 新世纪牛排

inherit ITEM;
inherit F_FOOD;

#include <ansi.h>

void create()
{
	set_name(HIG"新世纪牛排"NOR, ({"niu pai", "pai"}));
	set_weight(80);
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("long", "一块香喷喷的牛排。\n");
		set("unit", "块");
              set("value",50);
		set("food_remaining", 7);
		set("food_supply", 50);
	}
}
