#include <weapon.h>
#include <ansi.h>
inherit "/inherit/weapon/gun";

void create()
{
set_name(HIR"巨能激光枪"NOR, ({"juneng gun" }) );
        set_weight(4000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
  set("unit", "把");
    set("long", "这是一把巨能激光枪，威力巨大。\n");
                set("value", 1000);
                set("material", "iron");
       set("wield_msg", "$N拿出一把$n，握在手中。\n");
                set("unwield_msg", "$N放下手中的$n。\n");
        }

  init_gun(80);
        setup();
}
