inherit ITEM;
inherit F_LIQUID;

#include <ansi.h>
void create() {
  set_name(HIM "眉心酒" NOR, ({ "meixin jiu", "jiu" }));
  set_weight(700);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", HIB "这是一瓶上等的眉心酒！\n" NOR);
    set("unit", "瓶");
    set("value", 1000);
    set("max_liquid", 20);
  }


  set("liquid", ([
    "type": "alcohol",
    "name": "眉心酒",
    "remaining": 10,
    "drunk_supply": 30,
  ]));
}
