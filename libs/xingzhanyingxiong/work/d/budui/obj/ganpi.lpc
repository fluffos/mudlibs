inherit ITEM;
inherit F_LIQUID;

#include <ansi.h>
void create()
{
	set_name(HIG"骄阳干啤"NOR, ({"pi jiu", "jiu"}));
	set_weight(700);
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("long", "一瓶老少皆益的“骄阳干啤”\n");
		set("unit", "个");
		set("value", 100);
		set("max_liquid", 10);
	}

	
	set("liquid", ([
		"type": "alcohol",
		"name": "啤酒",
		"remaining": 3,
		"drunk_supply": 10,
	]));
}

