inherit ITEM;
inherit F_LIQUID;

#include <ansi.h>
void create() {
  set_name(HIM "碳素汽水瓶" NOR, ({ "qishui", "ping" }));
  set_weight(700);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一个装水的碳素汽水瓶。\n");
    set("unit", "个");
    set("value", 50);
    set("max_liquid", 10);
  }


  set("liquid", ([
    "type": "alcohol",
    "name": "汽水",
    "remaining": 10,
    "drunk_supply": 10,
  ]));
}
