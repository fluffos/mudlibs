inherit ROOM;

void create()
{
	set("short", "厨房");
	set("long", @LONG
这里就是特种部队的厨房，四周都是湿漉漉的黑墙，给人一种神秘感，
让人觉得这里似乎隐藏着一个什么大秘密似的。厨房里有一张大桌子
(desk)，一把椅子(chair)，和一个大锅子(guo)。
LONG);
        set("exits", (["east" : "/d/budui/didao3",]));
        set("objects", ([__DIR__"npc/longyaren" : 1,]));
        setup();
}
void init()
{
	add_action("do_search", "search");
}
int do_search(string arg)
{
        object me;
       int i;
       object zhen;
       zhen = new(__DIR__"obj/xiuhuazhen"); 
	me = this_player();
       if ( !arg ||  (arg != "desk" ) &&
                     (arg != "chair") &&
                     (arg != "guo" ))  return notify_fail("你要找什么地方什麽？\n");
       if (arg=="guo")
       if (!(me->query_temp("任务1")))
       return notify_fail("你找呀找……，结果什么也没找到！\n"); 
       else {message_vision("你找呀找……，结果找到了一根绣花针\n",me);
       zhen->move(me);}
      else 
       return notify_fail("你找呀找……，结果什么也没找到！\n");
       return 1;
}

