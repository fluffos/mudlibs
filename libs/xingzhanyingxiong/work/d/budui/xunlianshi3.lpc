inherit ROOM;
#include <ansi.h>
void create()
{
        set("short", HIY"敏捷训练室"NOR);
        set("long", @LONG
这里就是特种部队的敏捷训练室，领了任务的
可以到这里(xunlian minjie)来增强自己的敏
捷度。
LONG
        );
        set("no_fight",1);

        set("exits", ([
         
                "west"  : __DIR__"xunlianshi2",
        ]));
        setup();
        
}
void init()
{
        add_action("do_xunlian", "xunlian");
}
int do_xunlian(string arg)
{
        object me;
        int exp;
        me = this_player();
  if (!arg || arg!="minjie") return notify_fail("你要训练什么？\n");
  if (me->query_temp("gunfin")!=1) return notify_fail("你还是先去做枪法训练吧！\n");
  if ( me->query("jing") < 10 || me->query("qi")<10) return notify_fail("你休息一下再来吧！\n");
  if ( me->is_busy()) return notify_fail("你正忙着呢！\n");
  me->add("jing", -5);
  me->add("qi",-5);
        if ( random(8) < 2 )
        {
                message_vision("$N望了望正在远处抽烟的教官，坐下来休息了一会儿！\n", me);
                me->start_busy(1);
       
       }

        else
        {
                message_vision("$N开始跳起沙坑来。\n", me);
                me->add_temp("minjie",1);
                me->start_busy(1);
                if (me->query_temp("minjie")>10)
                   {me->set_temp("gunfin",0);
                    me->set_temp("minjiefin",1);
                    me->improve_skill("dodge",random(me->query_int()));
                    me->set_temp("minjie",0);
                write("你的敏捷训练已经结束！\n");  
                }
        }
return 1;
}

