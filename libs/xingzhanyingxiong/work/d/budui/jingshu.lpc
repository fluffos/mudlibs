inherit ROOM;

#include <ansi.h>


void create()
{
	set("short", HIR"特种警署"NOR);
	set("long", @LONG
这里就是特种警署，你一走进这里就感到一股威严的气氛，两边站着的一位位威猛的
警察，你向他们看去，却发现他们正在注视着你。这里是特种部队联盟镇上唯一一个
维持治安的机构。
LONG
	);
        set("exits",(["north" : __DIR__"renminglu1",
                    
                      ]));
        set("objects",([__DIR__"npc/jingcha" : 3,]));
                                            
       
       
	setup();
	replace_program(ROOM);
}

void init()
{
 object me;
 me=this_player();
 if ( (int)me->query_condition("killer")) 
 {
  me->start_busy(5);
  write(HIW"你发现周围有点不对劲，原来他们已经发现你是杀人犯了！！\n"
           "四周的警察瞪着一副铁亮的眼睛，似乎要把你看穿似的！！！\n\n\n"NOR);
  }
}
void beating(object ob)
{
    message_vision(HIR"\n\n只听见一声大叫，四周的警察都向你扑了过来，他们手里都拿着电棒！\n"
                     "$N只觉得眼前一黑……\n"
                     "口中鲜血狂喷……\n"NOR,ob);
    ob->move(__DIR__"jingshu2");
    ob->unconcious();
}
