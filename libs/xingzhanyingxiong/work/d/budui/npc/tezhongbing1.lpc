inherit NPC;
void create()
{
 set_name("金刚特种兵", ({ "jingang bing", "bing" }));
        set("long", 
                "他是一名特种部队的精兵。\n"
                "他刚刚二十，身材高大，混身冒出一股杀气。\n");
        set("gender", "男性");
        set("age", 21);
        set("attitude", "peaceful");
        set("shen_type", 1);
        set("str", 20);
        set("int", 20);
        set("con", 20);
        set("dex", 20);
        
        set("max_qi", 800);
        set("max_jing", 150);
        set("neili", 600);
        set("max_neili", 600);
        set("jiali", 30);
        set("combat_exp", 300000);
        set("score", -7000);
      
        set_skill("force", 150);
        set_skill("jiqi-gaizao", 100);
        set_skill("dodge", 100);
        set_skill("jiqi-qudong", 100);
        set_skill("gun", 120);
        set_skill("jiguang-gun", 110);
        set_skill("parry", 100);
        set_skill("literate", 80);
        map_skill("force", "jiqi-gaizao");
        map_skill("dodge", "jiqi-qudong");
        map_skill("parry", "jiguang-gun");
        map_skill("gun", "jiguang-gun");
        create_family("特种", 5, "");
        setup();
       carry_object("/clone/weapon/gun")->wield();
}


