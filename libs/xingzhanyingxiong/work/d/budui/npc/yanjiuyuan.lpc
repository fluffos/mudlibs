inherit NPC;
#include <ansi.h>

void create()
{
        set_name("研究人员", ({ "yanjiu ren", "ren","yanjiu"}));
	set("title",HIM"特种研究室"NOR);
	set("shen_type", 0);

	set("gender", "男性");
	set_max_encumbrance(100000000);
	set("age", 40);
	set("long",
		"他是特种研究室的研究人员，虽然已经四十出头了，但仍然鞠躬尽瘁的为特种部队服务！\n"
                );
	set("no_get_from", 1);

        set_skill("unarmed", 100);
        set_skill("dodge", 100);
	set_temp("apply/attack", 30);
	set_temp("apply/attack", 30);
	set_temp("apply/damage", 15);

        set("combat_exp", 50);
	set("attitude", "friendly");
        set("chat_msg",({"研究人员叹了口气：“S博士什么时候才能回呀！唉~~~！\n"}));
       

	
	setup();
}

