inherit F_DEALER;
inherit NPC;
#include <ansi.h>

void create() {
  set_name(HIY "机器人[KJ]" NOR, ({ "robot", "kj" }));
  set("title", "光能武器店老板");
  set("shen_type", 0);

  set("gender", "男性");
  set_max_encumbrance(100000000);
  set("age", 10);
  set("long",
    "听说机器人KJ是由S博士做的。\n");
  set("no_get_from", 1);

  set_skill("unarmed", 100);
  set_skill("dodge", 100);
  set_temp("apply/attack", 30);
  set_temp("apply/attack", 30);
  set_temp("apply/damage", 15);

  set("combat_exp", 100000);
  set("attitude", "friendly");
  set("vendor_goods", ({

    "/d/budui/obj/junengqiang",
    "/d/budui/obj/jiguangqiang",

  }));
  setup();
}

void init() {
  add_action("do_list", "list");
  add_action("do_buy", "buy");

}

void die() {
  message_vision("\n$N死了。\n", this_object());
  destruct(this_object());
}
