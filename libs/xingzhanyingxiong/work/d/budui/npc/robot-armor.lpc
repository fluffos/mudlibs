inherit F_DEALER;
inherit NPC;
#include <ansi.h>
void create()
{
        set_name(HIY"机器人-阿呆"NOR, ({ "robot"}));
	set("title","特种防具店老板");
	set("shen_type", 0);

	set("gender", "男性");
	set_max_encumbrance(100000000);
	set("age", 10);
	set("long",
		"听说机器人-阿呆是特种部队从地球上买回来的。\n");
	set("no_get_from", 1);

        set_skill("unarmed", 150);
        set_skill("dodge", 150);
        set_temp("apply/attack", 60);
        set_temp("apply/attack", 60);
        set_temp("apply/damage", 30);

        set("combat_exp", 200000);
	set("attitude", "friendly");
        set("vendor_goods",({
              "/d/budui/obj/taikong-shoes",
              "/d/budui/obj/taikong-cloth",
              "/d/budui/obj/taikong-shoutao",
              "/d/budui/obj/armor",
              "/d/budui/obj/gaofen-jia",
          }));
	
	setup();
}

void init()
{
        add_action("do_list", "list");
        add_action("do_buy", "buy");
	
}

void die()
{
	message_vision("\n$N死了。\n", this_object());
	destruct(this_object());
}
