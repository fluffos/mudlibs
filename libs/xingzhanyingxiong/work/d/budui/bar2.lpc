inherit ROOM;

void create()
{
	set("short", "大酒窖");
	set("long", @LONG
这里是一个黑不笼统的地窖，你放眼看去，只是黑蒙蒙的一片，隐隐约约可以看到
几个大酒筒(tong)。你四周都弥漫着酒香。
LONG
	);

	set("item_desc", ([
		"tong": "这是一筒陈年的葡萄酒，香气四溢。\n",
	]));
	set("exits", ([
		"up" : __DIR__"bar",
                "down" : __DIR__"job1",
	]));
	

	setup();
	replace_program(ROOM);
}
