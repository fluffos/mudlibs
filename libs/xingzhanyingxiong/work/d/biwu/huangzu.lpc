inherit ROOM;
void create() {
  set("short", "皇族入场区");
  set("long", @LONG
这里就是皇族的入场区，从这里可以进到有名的
杀人刑场。
LONG);
  set("exits", ([
    "down": __DIR__ "xingchang8",
  ]));
  set("objects", ([
    "/d/biwu/npc/kuge3": 1,
  ]));
  set("no_die", 1);
  set("no_fight", 1);
  setup();
}

int valid_leave(object me, string dir) {
  object obj, ob;
  obj = this_object();
  ob = present("ku ge", obj);
  if (ob)
    return notify_fail("你现在还不能下去！\n");
  return ::valid_leave(me, dir);
}
