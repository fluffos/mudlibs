#include <ansi.h>
inherit NPC;
int jueding(string nn);
string ask_me();
void create() {
  set_name("小猪哥", ({ "xiao zhuge", "xiao" }));
  set("long", "他就是太空总暑署长。\n");
  set("title", HIW "太空总署署长" NOR);
  set("gender", "男性");
  set("age", 30);
  set("attitude", "friendly");
  set("shen_type", -1);
  set("per", 30);
  set("str", 30);
  set("int", 30);
  set("con", 30);
  set("dex", 30);
  set("qi", 1500);
  set("max_qi", 1500);
  set("jing", 1300);
  set("max_jing", 1400);
  set("neili", 1700);
  set("max_neili", 1700);
  set("combat_exp", 2000000);

  set_skill("unarmed", 180);
  set_skill("dodge", 180);
  set_skill("parry", 180);
  set("inquiry", ([
    "任务": (: ask_me :),
  ]));
  setup();
  carry_object("/d/city/obj/cloth1")->wear();
}

string ask_me() {
  int i, j;
  string difang, myname;
  object obj, me = this_player();
  if (me->query("combat_exp") < 500000)
    return "你的战斗力太低，出去恐怕会牺牲！\n";
  if (!me->query_skill("jiashi-shu"))
    return "你又不会驾驶战舰，出去不是送死吗！\n";
  if ((me->query_temp("finlish") == 1) || (me->query("fini") == 1))
    return "你还有任务在身吧？\n";
  if (!me->query_temp("wancheng")) me->set_temp("wancheng", 1);
  i = random(4) + 1;
  j = random(9) + 1;
  if (i == 1) {
    difang = "/d/taikong/shuiping/shuiping";
    myname = "水瓶星系";
  }
  if (i == 2) {
    difang = "/d/taikong/sheshou/sheshou";
    myname = "射手星系";
  }
  if (i == 3) {
    myname = "狮子星系";
    difang = "/d/taikong/shizhi/shizhi";
  }
  if (i == 4) {
    difang = "/d/taikong/tiancheng/tiancheng";
    myname = "天秤星系";
  }
  if (i == 5) {
    difang = "/d/taikong/jinniu/jinniu";
    myname = "金牛星系";
  }
  me->set_temp("finlish", 1);
  me->set("fini", 1);
  obj = new(__DIR__ "haidaoship");
  obj->move(difang + sprintf("%d", j));
  tell_object(me, HIW "现有海盗战舰在" + myname + "出没，请速去增援！\n" NOR);
  me->apply_condition("renwu", 20);
  remove_call_out("gogogo");
  call_out("gogogo", 1000, obj);
  return "快去快回！GO，GO，LET'S GO!";
}
int gogogo(object obj) {
  object me = this_player();
  if (me->query_temp("finlish") == 1) {
    me->set_temp("wancheng", 1);
    me->set_temp("finlish", 2);
    destruct(obj);
    tell_object(me, HIR "任务时间已过，太可怜了！\n" NOR);
  }
  return 1;
}
