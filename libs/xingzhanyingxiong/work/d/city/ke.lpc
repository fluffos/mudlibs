#include <ansi.h>
inherit ITEM;
void setup() {}
void init() {
  add_action("do_eat", "eat");
}
void create() {
  set_name(HIG "丹" NOR, ({ "dan", }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "颗");
  }
  setup();
}
int do_eat(string arg) {
  object me = this_player();
  if (!id(arg))
    return notify_fail("你要吃什么？\n");
  me->add("combat_exp", 20000);
  //   me->add("money",30000);
  // me->add("max_jingli",415);
  //  me->add("potential",100000)
  message_vision(HIC "$N拿起一颗丹吃下，看看HP.！\n" NOR, me);
  destruct(this_object());
  return 1;
}
