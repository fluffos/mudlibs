// nvlang.c

#include <ansi.h>
inherit NPC;

void create()
{
        set_name("年青女郎", ({ "nv lang", "nv", "lang" }) );
        set("title", HIR "花枝招展" NOR);
        set("gender", "女性" );
        set("age", 20);
        set("per", 29);
        set("str", 16);
        set("con", 24);
        set("dex", 30);
        set("int", 27);

        set("attitude", "friendly");

        set("max_qi",100);
        set("max_jing",100);
        set("neili", 20);
        set("max_neili", 20);
        set("jiali", 0);
        set("combat_exp", 1000);

        set("long",     "这是个在乱世中堕落的女子。\n");
        set("chat_chance", 1);
    set("chat_msg", ({
        "年青女郎叹了口气道：“唉 …… 看来今天又没有生意了 ……”\n",
        "年青女郎淫荡的对你说：春宵一刻值千金啊！\n",
    }));

        setup();

     carry_object("/d/city/obj/qun")->wear();

}

int accept_fight(object me)
{
        command("say 小女子怎会是你的对手?");
        return 0;
}

