#include <ansi.h>
inherit NPC;
void greeting(object ob);
void create()
{
        set_name("打工妹", ({ "dagong sister", "dagong", "sister" }));
        set("long", "她是从乡下来的在麦当劳打工的小姑娘。\n");
            set ("title", RED  "麦当劳服务员" NOR);
        set("gender", "女性");
        set("age", 16);
        set("attitude", "friendly");
        set("shen_type", 1);

        set("per", 15);
        set("str", 15);
        set("int", 14);
        set("con", 15);
        set("dex", 16);
        set("qi", 200);
        set("max_qi", 200);
        set("jing", 200);
        set("max_jing", 100);
        set("neili", 300);
        set("max_neili", 300);
        set("combat_exp", 20000);

        set_skill("dodge", 90);
        set_skill("unarmed", 90);
        set_skill("parry", 90);

        set("chat_chance", 1);
        set("chat_msg", ({
                "打工妹笑着说道：欢迎您光临麦当劳！\n",
                        "接待小姐说道：您想要点什么？\n",
        }) );

        setup();
        carry_object("/d/city/obj/qun")->wear();
}
