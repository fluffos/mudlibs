// liu.c 刘老板 
#include <ansi.h>

inherit NPC;
inherit F_VENDOR;
//inherit F_DEALER;

void create()
{
        set_name("刘德花", ({ "liu defa", "liu" }));
        set("title", MAG"玩具店老板" NOR);
        set("shen_type", 1);

        set("gender", "男性");
        set("age", 45);
        set("long",
                "刘老板是土生土长的地球人，做了几十年的小买卖。\n");
        set_skill("unarmed", 50);
        set_skill("dodge", 50);
        set_temp("apply/damage", 15);

        set("combat_exp", 40000);
        set("attitude", "friendly");
        set("vendor_goods", ({
"/d/city/npc/wawa",
"/u/seaking/headjia",
"/u/seaking/handjia",
"/u/seaking/legjia",
"/u/seaking/bodyjia",
"/u/seaking/footjia",
        }));
        
        setup();
        carry_object("/d/city/obj/cloth")->wear();
}

void init()
{
        add_action("do_list", "list");
add_action("do_sell","sell");
        add_action("do_buy", "buy");
}

