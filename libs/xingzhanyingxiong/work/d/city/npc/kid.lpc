// kid.c
inherit NPC;

void create()
{
        set_name("顽童", ({ "wan tong", "kid", "tong" }));
        set("gender", "男性");
        set("age", 12);

        set("long", "一个十来岁的小孩，胖嘟嘟的很可爱。\n");
        set("combat_exp", 30);
        set("shen_type", 2);
        set_skill("unarmed", 2);
        set_skill("dodge", 2);
        set("chat_msg", ({
             "顽童檫了檫鼻涕...。",
             "顽童说道：都没人陪我玩，你陪我玩好吗？",
             "顽童嘻嘻笑了起来。",
        }) );
        setup();
             carry_object("/d/city/obj/tongzhuang")->wear();
}

