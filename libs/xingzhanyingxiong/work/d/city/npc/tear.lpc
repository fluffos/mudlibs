#include <ansi.h>
inherit NPC;
inherit F_VENDOR;
void greeting(object ob);
void create()
{
        set_name("泪儿", ({ "tear" }));
        set("long", "她就是这个城市最美丽的泪儿，也是这里的老板，看着她
你禁不住后悔起来自己结婚太早了！\n");
            set ("title", HIM  "美丽天使" NOR);
        set("gender", "女性");
        set("age", 23);
        set("attitude", "friendly");
        set("shen_type", 1);

        set("per", 35);
        set("str", 15);
        set("int", 14);
        set("con", 15);
        set("dex", 16);
        set("qi", 200);
        set("max_qi", 200);
        set("jing", 200);
        set("max_jing", 100);
        set("neili", 300);
        set("max_neili", 300);
        set("combat_exp", 20000);

        set_skill("dodge", 90);
        set_skill("unarmed", 90);
        set_skill("parry", 90);

        set("chat_chance", 1);
set("vendor_goods", ({
"/d/city/food/banana-ice",
"/d/city/food/chengzi",
  }));
        set("chat_msg", ({
                "泪儿浅浅一笑，道：来了，还是老位置吗？\n",
        }) );

        setup();
        carry_object("/d/city/obj/qun")->wear();
}
void init()
{
 add_action("do_list", "list");
 add_action("do_buy", "buy");
}
