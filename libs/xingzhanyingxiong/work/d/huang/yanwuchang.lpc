inherit ROOM;

void create() {
  set("short", "演武场");
  set("long", @LONG
这里就是皇族的演武场了，全部都是汉白玉砌成的高台是用来
比武的。东面是皇族子民的食物供应站，北面是一个小屋，西
边是一条走廊。
LONG);
  set("exits", ([
    "west": __DIR__ "zoulang",
    "east": __DIR__ "chufang",
    "north": __DIR__ "shijie",
    "south": __DIR__ "road2",
    "northwest": __DIR__ "wuqipu",
  ]));
  set("objects", ([ "/kungfu/class/huang/weishi": 1,
    "/kungfu/class/huang/yongshi": 1,
    "/kungfu/class/huang/jiaoguan": 1,
  ]));

  set("outdoors", "huang");
  setup();
  replace_program(ROOM);
}
