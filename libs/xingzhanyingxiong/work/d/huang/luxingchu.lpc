inherit ROOM;
void create()
{
        set("short", "宇航局旅行处");
        set("long", @LONG 
这里就是宇航局的旅行处。只见边上到处都是匆匆忙忙的提
着行李的旅客准备上飞船。在旅行处的液晶显示屏(ping)上写
着旅行的路线、价格。
LONG);
       set("exits", ([
    "west"  : __DIR__"road1",
        ]));
       set("item_desc", ([
       "ping":"皇族-中心城(100电子货币) 指令：shang chuan \n"
  ]) );
      setup();
}
int init()
{ add_action("do_shang","shang");
 }

void do_shang(string arg)
{
  object me,ob;
  me=this_player();
  if (!arg || arg!="chuan") return notify_fail("你要进哪里去？\n");
  if (me->query("combat_exp")<100000 && me->query("family/family_name")!="皇族") return notify_fail("你不是皇族的，不能出去！\n");
  if (me->query("money")<200) return notify_fail("你没钱还想坐船？\n");
  me->add("money",-100);
  tell_object(me,"你连忙挤上飞船，一下子就飞到了中心城。\n");
  me->move("/d/taikong/gangkou");
  return;
}

