
inherit ROOM;

void check_trigger();
void on_board();
void arrive();
void close_passage();
int do_yell(string arg);
void reset();

void create()
{
    set("short", "沙滩");
    set("long", @LONG
这是一个荒芜的沙滩，沙滩是那么光滑，看来是很久没人来过
了，你忽然发现在沙滩边竟然停了一艘快艇(boat)。
LONG);
    set("exits", ([
        "east" : __DIR__"xiaolu2",
    ]));
    set("item_desc", ([
        "boat" : "一艘快艇，叫(yell)一声看看。\n",
    ]));
    set("no_clean_up", 0);
    set("outdoors", "huang");
    setup();
}

void init()
{
    add_action("do_yell", "yell");
}

void check_trigger()
{
    object room;

    if(!query("exits/enter") ) {
        if( !(room = find_object(__DIR__"kuaiti")) )
            room = load_object(__DIR__"kuaiti");
        if( room = find_object(__DIR__"kuaiti") ) {
            if((int)room->query("yell_trigger")==0 ) {
                room->set("yell_trigger", 1);
                set("exits/enter", __DIR__"kuaiti");
                room->set("exits/out", __FILE__);
                message("vision", "那艘快艇飞快的驶了过来，一个黑衣人\n"
                    "对你招了招手，可能是要你上去吧。\n", this_object() );
                message("vision", "黑衣人得意的吹起了口哨，真是"
                    "很难听。\n", room);
                remove_call_out("on_board");
                call_out("on_board", 15);
            }
            else
                message("vision", "只听得黑一人说：“别急嘛，"
                    "等我吹完这首曲子……”\n",this_object() );
        }
        else
            message("vision", "ERROR: boat not found\n", this_object() );
    }
    else 
        message("vision", "快艇上的黑衣人不耐烦的说道：你上不上来？不上来我走了。\n",
            this_object() );
}


void on_board()
{
    object room;

    if( !query("exits/enter") ) return;

    message("vision", "黑衣人发动引擎，把档一挂，快艇向前飞了出去。\n",
        this_object() );

    if( room = find_object(__DIR__"kuaiti") )
    {
        room->delete("exits/out");
        message("vision", "黑衣人，说了一声“拽紧”，"
            "，快艇如离玄之箭一样行驶了起来。\n", room );
    }
    delete("exits/enter");

    remove_call_out("arrive");
    call_out("arrive", 20);
}

void arrive()
{
    object room;
    if( room = find_object(__DIR__"kuaiti") )
    {
        room->set("exits/out", __DIR__"shatan");
        message("vision", "黑衣人说“到啦，下去吧”，随即不再理你了，"
            "真是怪人。\n",room );
    }
    remove_call_out("close_passage");
    call_out("close_passage", 20);
}

void close_passage()
{
    object room;
    if( room = find_object(__DIR__"kuaiti") ) {
        room->delete("exits/out");
        message("vision","黑衣人减慢速度，把快艇撑开向岸边。\n", room);
        room->delete("yell_trigger"); 
    }
}

int do_yell(string arg)
{
    string dir;

    if( !arg || arg=="" ) return 0;

    if( arg=="boat" ) arg = "兄弟";
    if( (int)this_player()->query("age") < 16 )
        message_vision("$N使出吃奶的力气喊了一声：“" + arg + "”\n",
            this_player());
    else if( (int)this_player()->query("neili") > 500 )
        message_vision("$N吸了口气，一声“" + arg + "”，声音中正平和地远远传"
            "了出去。\n", this_player());
    else
        message_vision("$N鼓足中气，长啸一声：“" + arg + "！”\n",
            this_player());
    if( arg=="兄弟")
    {
        check_trigger();
        return 1;
    }
    else
        message_vision("风浪中远远传来一阵回声：“" + arg +
            "～～～”\n", this_player());
    return 1;
}

void reset()
{
    object room;

    ::reset();
    if( room = find_object(__DIR__"duchuan1") )
        room->delete("yell_trigger"); 
}

