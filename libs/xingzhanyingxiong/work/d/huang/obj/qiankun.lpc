// qiankun.c 乾坤

#include <weapon.h>
#include <ansi.h>
inherit SWORD;

void create()
{
        set_name(BLU "乾坤宝剑" NOR, ({ "qiankun","sword" }));
        set_weight(3000);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "柄");
                set("long", "细看那宝剑，剑身如镜，光泽透明。\n");
                set("value", 50000);
                set("material", "steel");
                set("no_drop", "这样东西不能离开你。\n");
                set("wield_msg", HIR "$N「唰」的一声抽出一柄$n"HIR"握在手中，刹那间天地为之变色！\n");
                set("unwield_msg", YEL "$N将手中的$n"YEL"插回剑鞘，只听嗤的一声轻响。\n");
        }
   init_sword(70);
        setup();
}

