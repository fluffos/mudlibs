inherit ITEM;
inherit F_LIQUID;

void create()
{
        set_name("人血", ({ "ren xue","xue" }));
        set_weight(1000);
        if( clonep() )
            set_default_object(__FILE__);
        else {
        set("long",
"这是一杯颜色深红的上等好人血哦。是招待皇族来客的。!\n");
                set("unit", "杯");
                set("value", 20);
                set("max_liquid", 10);
        }
        set("liquid", ([
            "name" : "人血",
            "remaining" : 8,
                "type" : "water"
        ]) );
        set("liquid_type", "water");
        setup();
}

