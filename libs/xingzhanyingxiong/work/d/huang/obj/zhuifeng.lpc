// zhuifeng.c 追风刀

#include <weapon.h>
#include <ansi.h>

inherit BLADE;

void create()
{
        set_name( HIC "追风刀", ({ "zhuifeng", "dao" }));
        set_weight(10000);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "把");
                set("long", HIR "这是一把曾饮千人血的魔刀。\n");
        set("value", 100000);
                set("material", "steel");
                set("wield_msg", HIW "只听「铮」的一声，追风宝刀脱鞘飞出，自行跃入$N掌中。
$N心中充满了杀意。\n" NOR);
                set("unwield_msg", BLU "追风刀自$N掌中飞起，在半空中一转，「唰」地跃入刀鞘。\n" NOR);
        }
    init_blade(100);
        setup();
}

