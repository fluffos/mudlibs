// liedi.c 裂地宝刀

#include <weapon.h>
#include <ansi.h>

inherit BLADE;

void create() {
  set_name(WHT "裂地宝刀", ({ "liedi", "dao" }));
  set_weight(10000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long", HIR "这是一把银光雪亮的裂地宝刀，刀刃间隐隐有血光流动，锋利无匹，
映面生寒。\n");
    set("value", 10000);
    set("material", "steel");
    set("wield_msg", HIR "只听「铮」的一声，裂地宝刀脱鞘飞出，自行跃入$N掌中。
瞬时天际间风云变色，电闪雷鸣，弥漫着一片无边杀意。\n" NOR);
    set("unwield_msg", YEL "裂地宝刀自$N掌中飞起，在半空中一转，「唰」地跃入刀鞘。\n" NOR);
  }
  init_blade(80);
  setup();
}
