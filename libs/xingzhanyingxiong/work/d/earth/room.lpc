inherit ROOM;

void create()
{
    set("short","玫瑰客房");
    set("long",@LONG
这里是天宾馆里专门为富翁所准备的玫瑰客房，要是
没有一定的钱财，讲去可能就会出不来了。
LONG);

    set("exits",([
        "out":__DIR__"floor1",
        "north":__DIR__"room2",
        "south":__DIR__"room1",
        "east":__DIR__"room3",
        "west":__DIR__"room4",
    ]));

    setup();
    replace_program(ROOM);
}
