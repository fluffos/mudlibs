inherit ROOM;

void create()
{
    set("short","长老殿");
    set("long",@LONG
这是圣殿的长老殿，从这里你可以向四周走动，就可以
到圣殿四大长老，北面是连长老的房间，南面是董长老的房间，
东面是张长老的房间。
LONG);
    set("exits",([
        "north":__DIR__"lianlao",
        "south":__DIR__"donglao",
        "west":__DIR__"houtang",
        "east":__DIR__"zhanglao",
    ]));
    
    setup();
    replace_program(ROOM);
}
