#include <ansi.h>

int update_condition(object me, int duration)
{
        if (duration < 1) {
         tell_object(me, HIG "你的任务时间到了！\n" NOR);
         me->set_temp("finlish",2);
         me->set("fini",2);
         return 0;
        }
        if (me->query_temp("finlish")==2)
         me->apply_condition("renwu",duration-5);
        else
        me->apply_condition("renwu", duration - 1);
        return 1;
}

