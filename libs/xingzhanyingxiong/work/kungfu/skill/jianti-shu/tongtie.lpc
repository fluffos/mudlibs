inherit F_CLEAN_UP;
#include <ansi.h>
int baofa(object me, object target)
{  
      int skill;
  object room;
  me = this_player();
  if (me->query_temp("防御")) return notify_fail("你刚刚已经使用过了铜墙铁壁！\n");
  if (me->query("jingli")<100) return notify_fail("你的精力不够！\n");
  if (me->query_skill("jianti-shu")<40) return notify_fail("你的坚体术的级别不够！\n");
  if (me->query_skill("rennai") < 30) return notify_fail("你的忍耐不够！\n");
  message_vision("$N口中阵阵有词，顿时一阵白烟笼罩了$N，久久不散！\n",room);
  message_vision("你觉得自己的防御力增加了！\n",me);
  me->start_busy(3);
  me->set_temp("防御",1);
  me->add_temp("apply/armor", me->query("jianti-shu")/3+random(50));
  me->add_temp("apply/dodge", me->query("jianti-shu")/3+random(50));
  me->start_call_out( (: call_other, __FILE__, "remove_effect", me, skill/3 :), skill);
return 1;
}
void remove_effect(object me, int amount)
{
	me->add_temp("apply/attack", - amount);
	me->add_temp("apply/dodge", - amount);
	me->delete_temp("防御");
	tell_object(me, "你的坚体术运行完毕，将气息收回丹田。\n");
} 
