// juezhao.c  绝招

#include <ansi.h>
#include <skill.h>
#include <combat.h>

inherit F_SSERVER;
 
int perform(object me, object target)
{
        object weapon, ob;
        string msg, string1;
        int count;
 
        if( !me->is_fighting() )
                return notify_fail("「绝招」只能在战斗中使用。\n");
 
        if( (int)me->query("neili") < 100 )
                return notify_fail("你的真气不够！\n");

        if( (int)me->query_skill("baqi-jue",1) < 50 )
                return notify_fail("你的霸气诀修为还不到家！\n");

        if( (int)me->query_skill("strike",1) < 50 ||
            me->query_skill_mapped("strike") != "bashan-zhang")
                return notify_fail("你的拔山掌法还不到家，无法使用绝招！\n");

        msg = HIY "$N使霸山掌绝招「"HIR"力"BLU"拔"MAG"山"YEL"兮"HIM"气"HIB"盖"HIW"世"NOR"」，一股罡风席卷四周！\n" NOR;
message_vision(msg, me, target);

        me->clean_up_enemy();
        ob = me->select_opponent();

        COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
        COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
        COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
        COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);
        COMBAT_D->do_attack(me, ob, me->query_temp("weapon"), 0);

        me->add("neili", -100);
        me->start_busy(random(5));

        if(!ob->is_fighting(me)) ob->fight_ob(me);
        return 1;
}

