// yinyang-zhang.c 阴阳回旋掌

inherit SKILL;
#include <ansi.h>

mapping *action = ({
  ([ "action": HIM "$N两手外伸，双掌运出八成刚劲由外向内一合，漫天气劲将空气一压一放，立即带出了隐隐雷声，气劲随着$N的手，霎时往$n前方三公尺内集中。" NOR,
    "force": 100,
    "dodge": 10,
    "parry": 10,
    "damage": 100,
    "lvl": 0,
    "damage_type": "内伤"
  ]),
  ([ "action": HIW "$N两掌一扬，一掌刚、一掌柔，阴阳两股力道向着$n直放了出去。。" NOR,
    "force": 140,
    "dodge": 10,
    "parry": 5,
    "damage": 140,
    "lvl": 10,
    "damage_type": "内伤"
  ]),
  ([ "action": HIG "$N两掌一出，阴阳两劲随掌向外而冲，两种劲力居然未能融合为一，正巧让敌人由劲力中间的缝隙穿入，却见$n在半空中急旋了起来。" NOR,
    "force": 180,
    "dodge": -5,
    "parry": 10,
    "damage": 180,
    "lvl": 20,
    "damage_type": "内伤"
  ]),
  ([ "action": HIC "$N双掌一圈，刚柔分流，阴阳两劲由左右双掌奔腾而出；$n懵然不知，双掌聚力迎了过来，与阴阳两劲一接，当场一掌击空，不受控制的旋转起来。" NOR,
    "force": 200,
    "dodge": 5,
    "parry": 5,
    "damage": 200,
    "lvl": 30,
    "damage_type": "内伤"
  ]),
  ([ "action": HIY "$N双掌一凝，全力向上一送，四阴六阳，两股掌力破空而上，这时两股气劲已经急旋了起来，轰然一声爆响，炸向$n。" NOR,
    "force": 220,
    "dodge": 10,
    "parry": 10,
    "damage": 220,
    "lvl": 40,
    "damage_type": "内伤"
  ]),
  ([ "action": HIB "$N体内阴阳劲力忽然分流，各循一掌奔腾而出，同时将双手往内一折，两劲一接触，随即开始交缠起来，攻向$n" NOR,
    "force": 230,
    "dodge": 15,
    "parry": 15,
    "damage": 230,
    "lvl": 60,
    "damage_type": "内伤"
  ]),
  ([ "action": HIR "$N心念电转，一面抽身往后飞退，一面两掌全力推出劲力，光影散发成罩，牢牢的罩住$n。" NOR,
    "force": 250,
    "dodge": 5,
    "parry": 15,
    "damage": 290,
    "lvl": 80,
    "damage_type": "内伤"
  ]),
});


int valid_enable(string usage) { return usage == "unarmed" || usage == "parry"; }

int valid_learn(object me) {
  if ((int)me->query("max_neili") < 100)
    return notify_fail("你的气息不够。\n");
  if ((int)me->query_skill("wuzu-xinfa", 1) > 20 || (int)me->query_skill("duanqing-xinfa", 1) > 20)
    return 1;
  else
    return notify_fail("你的无祖心法火候太浅。\n");
}

string query_skill_name(int level) {
  int i;
  for (i = sizeof(action) - 1; i >= 0; i--)
    if (level >= action[i]["lvl"])
      return action[i]["skill_name"];
}

mapping query_action(object me, object weapon) {
  int i, level;
  level = (int)me->query_skill("yinyang-zhang", 1);
  for (i = sizeof(action); i > 0; i--)
    if (level > action[i - 1]["lvl"])
      return action[NewRandom(i, 20, level / 5)];
}

int practice_skill(object me) {
  object weapon;

  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("学阴阳回旋掌不能用武器。\n");
  if (((int)me->query("qi") < 50) || (int)me->query("jing") < 20)
    return notify_fail("你的体力不够练阴阳回旋掌。\n");
  me->receive_damage("qi", random(40));
  me->receive_damage("jing", random(20));
  return 1;
}
string perform_action_file(string action) {
  return __DIR__ "yinyang-zhang/" + action;
}
