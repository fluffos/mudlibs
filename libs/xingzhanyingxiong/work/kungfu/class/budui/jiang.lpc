// jiang.c 蒋维安中队长
#include <ansi.h>
inherit NPC;
inherit F_MASTER;

string ask_me();

void create()
{
 set_name("蒋师庞", ({ "jiang jipang", "jiang" }));
        set("long", 
                "他就是特种部队里负责训练新人的教官。\n"
                "他已年过三十，身材高大，混身冒出一股杀气。\n");
        set("gender", "男性");
        set("age", 61);
        set("attitude", "peaceful");
        set("shen_type", 1);
        set("str", 30);
        set("int", 25);
        set("con", 30);
        set("dex", 30);
        
        set("max_qi", 500);
        set("max_jing", 500);
        set("neili", 500);
        set("max_neili", 500);
        set("jiali", 50);
        set("combat_exp", 200000);
        set("score", -7000);

      set_skill("jianti-shu",60);
       set_skill("rennai",60);
        set_skill("force", 60);
        set_skill("unarmed",60);
      set_skill("jiqi-gaizao", 60);
        set_skill("dodge", 80);
        set_skill("jiqi-qudong", 60);
        set_skill("gun", 80);
        set_skill("jiguang-gun", 70);
        set_skill("parry", 90);
        set_skill("literate", 100);
     map_skill("rennai","jianti-shu");
     map_skill("force", "jiqi-gaizao");
        map_skill("dodge", "jiqi-qudong");
        map_skill("parry", "jiguang-gun");
        map_skill("gun", "jiguang-gun");

        create_family("特种部队", 3, "中队长");
        setup();
        carry_object("/clone/weapon/gun")->wield();
}

void attempt_apprentice(object ob)
{
        command("say 好吧，我就收下你了。");
        command("say 希望你杀人无数,发扬我特种部队!");
        command("recruit " + ob->query("id"));
        if( (string)ob->query("class") != "killer")
                ob->set("class", "killer");
}
void die()
{
        object corpse, killer;
        int i;
        string skill;
        object ling;

        if( !living(this_object()) ) revive(1);
        if( wizardp(this_object()) && query("env/immortal") ) return;

        this_object()->clear_condition();

        COMBAT_D->announce(this_object(), "dead");
        if( objectp(killer = query_temp("last_damage_from")) ) {
                set_temp("my_killer", killer->query("id"));
                COMBAT_D->killer_reward(killer, this_object());
        }

        if( objectp(corpse = CHAR_D->make_corpse(this_object(), killer)) )
                corpse->move(environment());

        if (userp(killer))
        {
             message_vision(HIC"$N从蒋师庞身上取下一顶教官帽。\n",killer);
             ling=new("/d/shendian/quest/obj/mao");
             ling->move(killer);
        }

        this_object()->remove_all_killer();
        all_inventory(environment())->remove_killer(this_object());

        this_object()->dismiss_team();
        destruct(this_object());
}




