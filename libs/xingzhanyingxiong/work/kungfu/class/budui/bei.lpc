// bei.c

inherit NPC;
inherit F_MASTER;
string ask_me();
void create()
{
        set_name("贝斯威", ({ "bei shiwei", "bei" }));
        set("long", 
                "他就是特种部队里的大队长。\n"
                "他已年过三十。\n");
        set("gender", "男性");
        set("age", 31);
        set("attitude", "peaceful");
        set("shen_type", 1);
        set("str", 30);
        set("int", 25);
        set("con", 30);
        set("dex", 30);
        
        set("max_qi", 2000);
        set("max_jing", 2000);
        set("neili", 2000);
        set("max_neili", 2000);
        set("jiali", 200);
        set("combat_exp", 1500000);
        set("score", -7000);

        set_skill("force", 200);
        set_skill("jiqi-gaizao", 220);
        set_skill("dodge", 220);
        set_skill("jiqi-qudong", 220);
        set_skill("gun", 220);
        set_skill("jiguang-gun", 220);
        set_skill("parry", 220);
        set_skill("literate", 200);
        set_skill("duanqing-xinfa",200);
        set_skill("lengxue-dao",180);
        set_skill("yinyang-zhang",170);
        set_skill("unarmed",220);
        set_skill("blade",200);
        map_skill("force", "duanqing-xinfa");
        map_skill("dodge", "jiqi-qudong");
        map_skill("parry", "jiguang-gun");
        map_skill("gun", "jiguang-gun");
        map_skill("unarmed","yinyang-zhang");
        map_skill("blade","lengxue-dao");
        create_family("特种部队", 2, "大队长");
        set("inquiry", ([
                "加入" : (: ask_me :),
        ]));

        setup();
}

void attempt_apprentice(object ob)
{       if ((int)ob->query_skill("jiqi-gaizao",1) < 100)
 {
        command("say 你的机器改造还没到家");
        return;
} 
        command("say 好吧，我就收下你了。");
        command("say 希望你杀人无数,发扬我特种部队!");
        command("recruit " + ob->query("id"));
        if( (string)ob->query("class") != "killer")
                ob->set("class", "killer");
}

string ask_me()
{ object obj=this_player();
  if (obj->query("budui")==1) return "你已经完成任务了！\n";
  if ((int)obj->query_skill("force",1)>100 && (int)obj->query("combat_exp")>300000)
  {
  command("chat "+obj->query("name")+"加入特种部队敢死队！\n");
  command("say 我军正在进攻凤凰星，快去增援！\n");
  obj->set_temp("dobudui",1);
  obj->move("/d/miti/budui/start");
  return "快去快回！\n";
  }
  return "你的战斗力太低，这时候去恐怕是送死！\n";
}
void die()
{
        object corpse, killer;
        int i;
        string skill;
        object ling;

        if( !living(this_object()) ) revive(1);
        if( wizardp(this_object()) && query("env/immortal") ) return;

        this_object()->clear_condition();

        COMBAT_D->announce(this_object(), "dead");
        if( objectp(killer = query_temp("last_damage_from")) ) {
                set_temp("my_killer", killer->query("id"));
                COMBAT_D->killer_reward(killer, this_object());
        }

        if( objectp(corpse = CHAR_D->make_corpse(this_object(), killer)) )
                corpse->move(environment());

        if (userp(killer))
        {
          message_vision("$N从贝斯威身上搜出一块饼干。\n",killer);
             ling=new("/d/shendian/quest/obj/bingjang");
             ling->move(killer);
        }

        this_object()->remove_all_killer();
        all_inventory(environment())->remove_killer(this_object());

        this_object()->dismiss_team();
        destruct(this_object());
}


