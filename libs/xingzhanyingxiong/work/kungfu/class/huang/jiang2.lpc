// jiang2.c

inherit NPC;
#include <ansi.h>
inherit F_MASTER;

void create() {
  set_name("赤炎龙将", ({ "long jiang", "jiang" }));
  set("nickname", RED "烈火焚身" NOR);
  set("long",
    "他就是皇族的头号猛将。\n"
    "他已年过半百。\n");
  set("gender", "男性");
  set("age", 50);
  set("attitude", "peaceful");
  set("shen_type", 1);
  set("str", 30);
  set("int", 25);
  set("con", 30);
  set("dex", 30);

  set("max_qi", 50000);
  set("max_jing", 3000);
  set("neili", 150000);
  set("max_neili", 150000);
  set("jiali", 250);
  set("combat_exp", 3000000);
  set("score", -7000);

  set_skill("force", 150);
  set_skill("baqi-jue", 180);
  set_skill("sword", 120);
  set_skill("parry", 140);
  set_skill("dingbang-jian", 130);
  set_skill("dodge", 170);
  set_skill("weizhen-steps", 160);
  set_skill("literate", 170);
  set_skill("cuff", 180);
  set_skill("chiyan-quan", 180);
  map_skill("force", "baqi-jue");
  map_skill("dodge", "weizhen-steps");
  map_skill("sword", "dingbang-jian");
  map_skill("cuff", "chiyan-quan");
  create_family("皇族", 3, "大统领");
  set("chat_chance", 1);
  set("chat_msg", ({
    "赤炎龙将说道：我的赤炎拳可是皇族一门不可多得的绝技！\n",
    "赤炎龙将'呼'的一拳击了过来，把你吓了一大跳，赤炎龙将哈哈大笑了起来。\n",
    "赤炎龙将仰天发出一声长啸.......。\n",
  }));

  setup();
  carry_object("/d/huang/obj/qiankun")->wield();
  carry_object("/d/huang/obj/shoujia")->wear();

}

void attempt_apprentice(object ob) {
  if ((int)ob->query_skill("baqi-jue", 1) < 100) {
    command("say 你的霸气诀还太差了");
    return;
  }
  command("say 好吧，我就收下你了。");
  command("say 希望你它日能助我族一统天下！");
  command("recruit " + ob->query("id"));
  if ((string)ob->query("class") != "killer")
    ob->set("class", "killer");
}
void die() {
  object corpse, killer;
  int i;
  string skill;
  object ling;

  if (!living(this_object())) revive(1);
  if (wizardp(this_object()) && query("env/immortal")) return;


  this_object()->clear_condition();

  COMBAT_D->announce(this_object(), "dead");
  if (objectp(killer = query_temp("last_damage_from"))) {
    set_temp("my_killer", killer->query("id"));
    COMBAT_D->killer_reward(killer, this_object());
  }

  if (objectp(corpse = CHAR_D->make_corpse(this_object(), killer)))
    corpse->move(environment());

  if (userp(killer)) {
    message_vision(HIC "$N从赤炎龙将身上搜出一张美女图。\n", killer);
    ling = new("/d/shendian/quest/obj/mnv");
    ling->move(killer);
  }

  this_object()->remove_all_killer();
  all_inventory(environment())->remove_killer(this_object());

  this_object()->dismiss_team();
  destruct(this_object());
}
