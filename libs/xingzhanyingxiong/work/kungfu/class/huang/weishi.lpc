// weishi.c

inherit NPC;
inherit F_MASTER;

void create()
{
        set_name("皇族卫士", ({ "wei shi", "wei shi" }));
        set("long", 
                "他就是皇族卫士。\n"
                "他看起来二十多岁了。\n");
        set("gender", "男性");
        set("age", 22);
        set("attitude", "peaceful");
        set("shen_type", 1);
        set("str", 30);
        set("int", 25);
        set("con", 30);
        set("dex", 30);
        
        set("max_qi", 3000);
        set("max_jing", 1000);
        set("neili", 3000);
        set("max_neili", 3000);
        set("jiali", 100);
        set("combat_exp", 100000);
        set("score", -7000);

        set_skill("force", 100);
        set_skill("baqi-jue", 120);
        set_skill("dodge", 150);
        set_skill("weizhen-steps", 120);
        set_skill("unarmed", 120);
        set_skill("bashan-zhang", 120);
        set_skill("parry", 120);
        set_skill("literate", 50);
        set_skill("strike", 120);
        map_skill("force", "baqi-jue");
        map_skill("dodge", "weizhen-steps");
        map_skill("parry", "bashan-zhang");
        map_skill("strike", "bashan-zhang");

        set("chat_chance", 1);
        set("chat_msg", ({
        "皇族卫士说道：能成为皇族的一员，是我毕生的荣幸！\n",
        }) );
        setup();
              carry_object("/d/huang/obj/shoupi")->wear();

}
