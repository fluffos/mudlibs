// /clone/board/xuedao_b.c
#include <ansi.h>
inherit BULLETIN_BOARD;


void create()
{
	set_name(HIR"血刀门"NOR+"弟子留言板", ({ "board" }) );
	set("location", "/d/xuedao/damen");
	set("board_id", "xuedao_b");
	set("long", "这是一个"+HIR"血刀门"NOR+"下交留的留言板。\n" );
	setup();
	set("capacity", 30);
	replace_program(BULLETIN_BOARD);
}

