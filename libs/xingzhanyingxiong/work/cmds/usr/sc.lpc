#include <ansi.h>
#include <combat.h>

inherit F_CLEAN_UP;

string display_attr(int gift, int value);
string status_color(int current, int max);
string date_string(int date);
string tribar_graph(int val, int eff, int max, string bcolor, string fcolor, string dcolor);

void create() { seteuid(ROOT_UID); }

int main(object me, string arg) {
  object ob;
  mapping my;
  string line, str, skill_type, *marks;
  object weapon;
  int i, attack_points, dodge_points, parry_points;

  seteuid(getuid(me));
  if (!arg)
    ob = me;
  else if (wizardp(me)) {
    ob = present(arg, environment(me));
    if (!ob) ob = find_player(arg);
    if (!ob) ob = find_living(arg);
    if (!ob) return notify_fail("你要察看谁的状态？\n");
  } else
    return notify_fail("只有巫师能察看别人的状态。\n");

  my = ob->query_entire_dbase();

  line = sprintf(BOLD "%s" NOR "%s\n\n", RANK_D->query_rank(ob), ob->short(1));

  str = "";
  if (mapp(my["family"])) {
    if (my["family"]["master_name"]) str = my["family"]["master_name"];
  }
  if (mapp(my["marks"])) {
    marks = keys(my["marks"]);
    for (i = 0; i < sizeof(marks); i++) {
      if (str != "") str += "、";
      str += marks[i];
    }
  }

  line += sprintf(" 年龄：[%s%-6s%s]  生日：[%s%-42s%s]\n",
    BCYN HIC, chinese_number(ob->query("age")), NOR,
    BCYN HIC, CHINESE_D->chinese_date(((int)ob->query("birthday") - 14 * 365 * 24 * 60) * 60), NOR);

  line += sprintf(" 性别：[%s%-6s%s]  伴侣：[%s%-10s%s]  种族：[%s%-6s%s]  职业：[%s%-6s%s]\n\n",
    BCYN HIC, ob->query("gender"), NOR,
    BCYN HIC, ob->query("marry"), NOR,
    BCYN HIC, ob->query("race"), NOR,
    BCYN HIC, " ── ", NOR);

  if (str != "") line += sprintf(" 师承：[%s%-58s%s]\n\n", BCYN HIC, str, NOR);

  if (objectp(weapon = ob->query_temp("weapon")))
    skill_type = weapon->query("skill_type");
  else
    skill_type = "unarmed";

  attack_points = COMBAT_D->skill_power(ob, skill_type, SKILL_USAGE_ATTACK);
  parry_points = COMBAT_D->skill_power(ob, skill_type, SKILL_USAGE_DEFENSE);
  dodge_points = COMBAT_D->skill_power(ob, "dodge", SKILL_USAGE_DEFENSE);

  line += sprintf(" 魅力：[%s %4s %s]  ",
    BBLU, display_attr(my["str"], ob->query_per()), NOR);
  line += "<精>  " + tribar_graph(
    my["jing"],
    my["eff_jing"],
    my["max_jing"],
    BMAG,
    HIW,
    HIR
  ) + sprintf("  [%s%4d%s / %s%4d%s , %s%4d%s]\n", BBLU HIW, my["jing"], HIG,
    HIM, my["max_jing"], HIG, HIR, my["max_jing"] - my["eff_jing"], NOR);

  line += sprintf(" 灵性：[%s %4s %s]  ",
    BBLU, display_attr(my["str"], ob->query_spi()), NOR);
  line += "<气>  " + tribar_graph(
    my["qi"],
    my["eff_qi"],
    my["max_qi"],
    BMAG,
    HIW,
    HIR
  ) + sprintf("  [%s%4d%s / %s%4d%s , %s%4d%s]\n", BBLU HIW, my["qi"], HIG,
    HIM, my["max_qi"], HIG, HIR, my["max_qi"] - my["eff_qi"], NOR);

  line += sprintf(" 才智：[%s %4s %s]  ",
    BBLU, display_attr(my["str"], ob->query_int()), NOR);
  line += "<神>  " + tribar_graph(
    my["shen"],
    my["eff_shen"],
    my["max_shen"],
    BMAG,
    HIW,
    HIR
  ) + sprintf("  [%s%4d%s / %s%4d%s , %s%4d%s]\n", BBLU HIW, my["shen"], HIG,
    HIM, my["max_shen"], HIG, HIR, my["max_shen"] - my["eff_shen"], NOR);

  if (my["food"] * 100 / ob->max_food_capacity() > 10) str = HIC + "正常";
  else str = HIR + "缺食";
  line += sprintf(" 力量：[%s %4s %s]  ",
    BBLU, display_attr(my["str"], ob->query_str()), NOR);
  line += "食物：" + tribar_graph(my["food"], ob->max_food_capacity(),
    ob->max_food_capacity(), BCYN, HIC, HIR) + sprintf("  [%s%4d%s / %s%4d%s , %4s%s]\n", BBLU HIC, my["food"], HIG,
    HIC, ob->max_food_capacity(), HIG, str, NOR);

  if (my["water"] * 100 / ob->max_water_capacity() > 10) str = HIC + "正常";
  else str = HIR + "缺水";
  line += sprintf(" 根骨：[%s %4s %s]  ",
    BBLU, display_attr(my["str"], ob->query_con()), NOR);
  line += "饮水：" + tribar_graph(my["water"], ob->max_water_capacity(),
    ob->max_water_capacity(), BCYN, HIC, HIR) + sprintf("  [%s%4d%s / %s%4d%s , %4s%s]\n", BBLU HIC, my["water"], HIG,
    HIC, ob->max_water_capacity(), HIG, str, NOR);

  line += sprintf(" 定力：[%s %4s %s]  ",
    BBLU, display_attr(my["str"], ob->query_cps()), NOR);
  line += "无常：" + tribar_graph(my["PKS"], my["MKS"] + my["PKS"],
    my["MKS"] + my["PKS"], BRED, HIR, HIR) + sprintf("  [%s%4d%s +%s%5d%s =%s%5d%s]\n", BBLU HIR, my["PKS"], HIR,
    HIM, my["MKS"], HIR, RED, my["MKS"] + my["PKS"], NOR);

  line += sprintf(" 勇气：[%s %4s %s]  ",
    BBLU, display_attr(my["str"], ob->query_cor()), NOR);
  line += sprintf("攻击：[%s%12d%s (%s+%4d%s)%s]  躲闪：[%s%12d%s]%s\n" NOR,
    BGRN HIC, attack_points + 1, HIG, HIW, ob->query_temp("apply/damage"), HIG, NOR,
    BBLU HIC, dodge_points + 1, HIG, NOR);

  line += sprintf(" 福缘：[%s %4s %s]  ",
    BBLU, display_attr(my["str"], ob->query_kar()), NOR);
  line += sprintf("防御：[%s%12d%s (%s+%4d%s)%s]  招架：[%s%12d%s]%s\n\n" NOR,
    BGRN HIC, (dodge_points + (weapon ? parry_points : (parry_points / 10))) + 1, HIG,
    HIW, ob->query_temp("apply/armor"), HIG, NOR,
    BBLU HIC, parry_points + 1, HIG, NOR);

  line += sprintf(" 正气：[%s%12d%s]  杀气：[%s%14d%s]  潜能：[%s%12d%s]\n",
    BCYN HIC, ob->query("SEN"), NOR, BCYN RED, ob->query("bellicosity"), NOR,
    BCYN HIY, (int)ob->query("potential") - (int)ob->query("learned_points"), NOR);
  line += sprintf(" 评价：[%s%12d%s]  中毒：[%s%14d%s]  经验：[%s%12d%s]\n",
    BCYN HIR, ob->query("score"), NOR, BCYN HIG, ob->query("poison"), NOR,
    BCYN HIM, ob->query("combat_exp"), NOR);

  write(line + BBLK);
  return 1;
}

string display_attr(int gift, int value) {
  if (value > gift) return sprintf(HIY "%4d", value);
  else if (value < gift) return sprintf(HIC "%4d", value);
  else return sprintf("%3d", value);
}

string status_color(int current, int max) {
  int percent;

  if (max) percent = current * 100 / max;
  else percent = 100;

  if (percent > 100) return HIC;
  if (percent >= 90) return HIG;
  if (percent >= 60) return HIY;
  if (percent >= 30) return YEL;
  if (percent >= 10) return HIR;
  return RED;
}

string tribar_graph(int val, int eff, int max, string bcolor, string fcolor, string dcolor) {
  string ret;
  int i, n, eff_n, max_n = 20;

  if (max == 0) max = 1;
  n = val * 100 / max / 5;
  eff_n = eff * 100 / max / 5;

  if (n < 0) n = 0;
  if (eff_n < 0) eff_n = 0;
  if (n > max_n) n = max_n;
  if (eff_n > max_n) eff_n = max_n;

  ret = NOR "[" + bcolor + fcolor;
  for (i = 0; i < max_n; i++) {
    if (i > eff_n) ret += dcolor;
    if (i < n) ret += "O";
    else ret += "-";
  }
  ret += fcolor + NOR "]";
  return ret;
}
int help(object me) {
  write(@HELP
指令格式：score
          score <对象名称>      （巫师专用）

显示自己或者指定对象（含怪物）的基本资料。此指令可以“sc”代替。

相关讯息：hp
HELP
  );

  return 1;
}
