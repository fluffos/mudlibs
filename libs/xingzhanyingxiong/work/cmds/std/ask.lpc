inherit F_CLEAN_UP;

int help();

int main(object me, string arg) {
  string targ, key;
  object target;

  if (!arg || arg == "") return notify_fail("问什么？\n");

  if (sscanf(arg, "%s about %s", targ, key) == 2) {
    target = present(targ, environment(me));
    if (!target || !target->is_character())
      return notify_fail("这里没有这个人。\n");
    // add by dragoon
    if (objectp(target) && target->query("no_fight"))
      return notify_fail("什么??\n");
    message_vision("$N向$n打听有关「" + key + "」的消息。\n", me, target);
    target->accept_inquiry(me, key);
    return 1;
  } else if (sscanf(arg, "%s for %s", targ, key) == 2) {
    target = present(targ, environment(me));
    if (!target || !target->is_character())
      return notify_fail("这里没有这个人。\n");

    // add by dragoon
    if (objectp(target) && target->query("no_fight"))
      return notify_fail("什么??\n");

    switch (key) {
      case "help":
        message_vision("$N对着$n大叫：" + target->rank("respectful")
          + "救命！\n", me, target);
        break;
      case "peace":
        if (!target->is_fighting(me)) {
          write(target->name() + "和你并没有结仇。\n");
          return 1;
        }
        message_vision("$N向$n拱手一揖，说道：这位"
          +target->rank("respectful")
          + "武艺高强，在下佩服得紧，不如化敌为友如何？\n", me, target);
        break;
      case "mercy":
        if (target->is_killing(me->query("id")))
          message_vision("$N向$n双膝跪倒，哀求道：" + target->rank("respectful")
            + "饶命！小的下次再也不敢了！\n", me, target);
        break;
      default:
    }
    target->accept_negotiation(me, key);
    return 1;
  } else
    return notify_fail("请用 help ask 参考说明。\n");
}

int help() {
  write(@TEXT
指令格式：ask <某人> about <关键字>
          ask <某人> for <交涉目标>

这个指令让你和 npc 进行一些简单的互动，用第一种格式的时候表示向 npc 打听
有关某关键字的消息，第二种格式则是和 npc 进行交涉，目前大多数 npc 能够了
解的交涉目标有：

help     向对方求助。
peace    向跟你有仇恨的人要求和解。
mercy    向正在攻击你的敌人求饶。

TEXT
  );
  return 1;
}
