// tell.c

#include <ansi.h>
#include <net/dns.h>

inherit F_CLEAN_UP;

int help(object me);

        void create() {seteuid(getuid());}

int main(object me, string arg)
{
        string target, msg, mud,gen;
        object obj;
        if (!present("shou ji",me)) return notify_fail("你还是先去电信公司买手机吧！\n");
        if( !arg || sscanf(arg, "%s %s", target, msg)!=2 ) return help(me);

        if( sscanf(target, "%s@%s", target, mud)==2 ) {
                GTELL->send_gtell(mud, target, me, msg);
                write("网路讯息已送出，可能要稍候才能得到回应。\n");
                return 1;
        }

        obj = find_player(target);
        if(!obj || !me->visible(obj)) return notify_fail("没有这个人....。\n");
        if (!wizardp(me) && obj->query_temp("pigging_seat"))
                return notify_fail("正在拱猪的人听不到悄悄话……。\n");
        
        if (!wizardp(me) && (obj->query_temp("notell/"+me->query("id")) 
             || obj->query_temp("notell_all")))
        return notify_fail(obj->query("name")+"不接受你的悄悄话。\n");  
        if (me->query("gender")=="女性") gen="你好坏哟！";
        else gen="";
        if (me->query("per")<10)
        {
        write( HIM "你挂通" + obj->name(1) + "的手机，说道："+gen+"他奶奶的" + msg + "\n" NOR);
        tell_object(obj, sprintf( HIM "BEEP，%s的手机到啦！\n 只听见一个声音传来:%s他奶奶的，%s\n" NOR,
                me->name(1)+"("+me->query("id")+")", gen,msg));
        }
        if (me->query("per")>=10 && me->query("per")<20)
        { write( HIM "你挂通" + obj->name(1) + "的手机，粗鲁的喊道："+gen + msg + "\n" NOR);
        tell_object(obj, sprintf( HIM "BEEP，%s的手机到啦！\n 只听见一个粗鲁的声音震得你耳朵发麻:%s%s\n" NOR,
                me->name(1)+"("+me->query("id")+")", gen,msg));
        }
        if (me->query("per")>=20 && me->query("per")<30) { 
          write( HIM "你挂通" + obj->name(1) + "的手机，甜蜜的说道：" +gen+ msg + "\n" NOR);
        tell_object(obj, sprintf( HIM "BEEP，%s的手机到啦！\n 只听见一个甜蜜的声音传来:%s%s\n" NOR,
                me->name(1)+"("+me->query("id")+")", gen,msg)); 
       }
       if (me->query("per")>=30) { 
          write( HIM "你挂通" + obj->name(1) + "的手机，令人销魂的说道：" +gen+ msg + "\n" NOR);
        tell_object(obj, sprintf( HIM "BEEP，%s的手机到啦！\n 只听见一个令人销魂的声音传来:%s%s\n" NOR,
                me->name(1)+"("+me->query("id")+")", gen,msg)); 
       }        

obj->set_temp("reply", me->query("id"));
        return 1;
}

int remote_tell(string cname, string from, string mud, string to, string msg)
{
        object ob;

        if( ob = find_player(to) ) {
                if( cname )
                        tell_object(ob, sprintf(HIG "%s(%s@%s)告诉你：%s\n" NOR,
                                cname, capitalize(from), mud, msg ));
                else
                        tell_object(ob, sprintf(HIG "%s@%s 告诉你：%s\n" NOR,
                                capitalize(from), mud, msg ));
                ob->set_temp("reply", from + "@" + mud);
                return 1;
        } else
                return 0;
}

int help(object me)
{
        write(@HELP
指令格式：tell <某人> <讯息>

你可以用这个指令和其他地方的使用者说话。

其他相关指令：reply
HELP
        );
        return 1;
}

