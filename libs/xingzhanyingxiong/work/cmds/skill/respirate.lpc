// respirate.c

#include <skill.h>
#include <ansi.h>
inherit F_CLEAN_UP;

int respirate_cost;
int respirating(object me);
int halt_respirate(object me);

int main(object me, string arg)
{
        object where = environment(me);

        seteuid(getuid());
      
        if (me->is_busy()) 
                return notify_fail("你现在正忙着呢！\n");

        if( me->is_fighting() )
                return notify_fail("战斗中运功，不象话吧。\n");

        if( !arg || !sscanf(arg, "%d", respirate_cost))
                return notify_fail("你要花多少持久力修行？\n");
if( !stringp(me->query_skill_mapped("rennai")) )
 	return notify_fail("你必须先用 enable 选择你要用的忍耐技能。\n");

        if (respirate_cost <= 0)
                return notify_fail("你别调胃口啦！\n");

        if( (int)me->query("jing") < respirate_cost )
                return notify_fail("你现在持久力不足，无法修行耐力！\n");

        if( (int)me->query("qi") * 100 / (int)me->query("max_qi") < 70 )
                return notify_fail("你现在身体状况太差了！\n");

        write("你开始闭目养神。\n");
        me->set_temp("pending/respirate", 1);
        me->set_temp("respirate_cost", respirate_cost);
        message_vision(HIR"$N双脚朝天，两手撑地，开始瑜迦修行。\n"NOR, me);
        me->start_busy((: respirating :), (: halt_respirate :));
        return 1;
}

int respirating(object me)
{
        int temp,jingli_gain;
        object where;
        temp=(int)me->query_skill("rennai");
        jingli_gain = 1 + temp / 5;
        where=environment(me);

        if (respirate_cost < jingli_gain)
                jingli_gain = respirate_cost;

        me->add("jingli", jingli_gain);
        respirate_cost -= jingli_gain;
        me->add("jing", -jingli_gain);

        if (respirate_cost > 0)
                return 1;

        me->set_temp("pending/respirate", 0);
        respirate_cost = 0;
        message_vision(HIW"$N修行完毕，放下双脚，站了起来。\n"NOR, me);
        if((int)me->query("jingli") < (int)me->query("max_jingli") * 2)
                return 0;
        else {
                if ((int)me->query("max_jingli") > temp * 10)
                {
                        write(HIR"你的耐力修为似乎达到极限了。\n"NOR);
                        me->set("jingli", (int)me->query("max_jingli"));
                        return 0;
                }
                else
                {
                        me->add("max_jingli", 1);
                        me->set("jingli", (int)me->query("max_jingli"));
                        write("你的耐力又增强了一层！！\n");
                        return 0;
                }
        }
}

int halt_respirate(object me)
{
        respirate_cost = 0;
        if ((int)me->query("jingli") > (int)me->query("max_jingli") * 2)
                me->set("jingli", (int)me->query("max_jingli") * 2);
        me->set_temp("pending/respirate", 0);
        return 1;
}

int help(object me)
{
        write(@HELP
指令格式 : respirate|tuna [<耗费「持久力」的量>]
 
修行印度瑜迦功，使自己的状态达到极限

See also: exercise
HELP
        );
        return 1;
}

