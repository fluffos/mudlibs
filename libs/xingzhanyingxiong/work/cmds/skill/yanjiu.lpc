// yanjiu.c

#include <skill.h>

inherit F_CLEAN_UP;

void create() { seteuid(getuid()); }

int main(object me, string arg)
{
        string skill, teacher, master, skill_name;
        int my_skill, gin_cost, grade, my_combat_exp;
        int betrayer;

        if (me->is_busy())
                return notify_fail("你现在正忙着呢。\n");

        if(!arg || (sscanf(arg, "%s", skill)!=1 ))
                return notify_fail("指令格式：yanjiu <技能>\n");

        if( me->is_fighting() )
                return notify_fail("临阵磨枪？来不及啦。\n");

        if( !my_skill = me->query_skill(skill, 1) )
                return notify_fail("你不会这项技能。\n");
        if (my_skill<100)
                return notify_fail("你的基本功还不扎实！\n");

        if( !SKILL_D(skill)->valid_learn(me) ) return SKILL_D(skill)->valid_learn(me);

        gin_cost = 150 / (int)me->query("int") + 1;

        if( !my_skill ) {
                gin_cost *= 2;
                me->set_skill(skill,0);
        }

        if( (int)me->query("learned_points") >= (int)me->query("potential") )
                return notify_fail("你的潜能已经发挥到极限了，没有办法再成长了。\n");
        printf("你自己研究了一下「%s」。\n", to_chinese(skill));

             
        my_combat_exp = (int)me->query("combat_exp");
        if(my_combat_exp < 10000)
                grade = 1;
        else if(my_combat_exp < 80000)
                grade = 3;
        else if(my_combat_exp < 500000)
                grade = 7;
        else
                grade = 13;
        if ( grade < 1 )
                grade = 1;

        if((int)me->query("jing") > gin_cost )
        {
                if( (string)SKILL_D(skill)->type()=="martial"
                &&      my_skill * my_skill * my_skill / 10 > (int)me->query("combat_exp") ) {
                        printf("也许是缺乏实战经验，你自己总是无法领会。\n");
                }
                else
                {
                        printf("你似乎有点心得。\n");
                        me->add("learned_points", 4);
                        me->improve_skill(skill, grade * (10 + random((int)me->query("int") - 9)));
                }
        }
        else
        {
                gin_cost = me->query("jing");
                write("你今天太累了，结果什么也没有学到。\n");
        }

        me->receive_damage("jing", gin_cost*4 );

        return 1;
}

int help(object me)
{
        write(@HELP
指令格式 : yanjiu <技能>
 
这个指令可以让你自己钻研武功。

HELP
        );
        return 1;
}

