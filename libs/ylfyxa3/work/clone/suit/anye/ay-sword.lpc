//第3版装备系统

#include <weapon.h>
#include <ansi.h>

inherit SWORD;
inherit F_ITEM_MAKE;

void create() {
  int pj, lvl, damage, item_type;
  pj = random((int)sizeof(weapon_shuxing));  //由于动态装备的属性只有7种了所以这里要改
  lvl = random(get_system_config(DATA_CONFIG_DIR "weapon.h", "ITEM_WEAPON_MAX_LEVEL")) + 1;
  damage = lvl * 100 / 2;
  damage = damage + random(damage);
  if (!damage || damage < 100) damage = 1 + random(99);
  //	item_type = 1 + random(2);//单双手随机
  item_type = 2;  //指定为单手

  set_name(HIW "暗夜剑" NOR, ({ "anye jian", "jian", "sword" }));
  set_weight(3000 + (random(pj) * 100) + (random(lvl) * 100));
  set("value", 6000000);
  //	set("weapon_prop/level", lvl);	//初始设定为0级
  set("weapon_prop/level", 0);
  get_item_shuxing("weapon", pj, lvl, 1);
  set("unit", "柄");
  set("icon", "10068");
  set("material", "steel");
  set("owner_id", 1);
  set("dtzb", 1);  //添加判定,非副本装备无法强化
  set("xyzx_save_item", 1);
  set("xyzx_sys/bind_type", 0);
  set("xyzx_item/pinji", 1);
  set("taozhuang", 11);
  set("max_level", 30);
  set("long", "一柄通体乌黑,极细的剑刃无形中直抵咽喉,如暗夜中引魂之手。\n");
  set("wield_msg", HIR "一声脆响,$N手里无声无息的多了把乌黑长剑.\n" NOR);
  set("unwield_msg", HIC "$N手中黑光一闪，将手中的$n插回剑鞘。\n");

  init_sword(damage, item_type, 1);
  setup();
}
int query_autoload() { return 1; }
