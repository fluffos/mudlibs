// 相思染套装：腰带

#include <armor.h>
#include <ansi.h>

inherit WAIST;
inherit F_ITEM_MAKE;

void create() {
  int pj, lvl, armor;

  pj = random((int)sizeof(armor_shuxing));  //由于动态装备的属性只有7种了所以这里要改		
  lvl = random(get_system_config(DATA_CONFIG_DIR "armor/cloth.h", "ITEM_CLOTH_MAX_LEVEL")) + 1;
  armor = lvl * 100 / 2;
  armor = armor + random(armor);
  if (!armor || armor < 100) armor = 1 + random(99);

  set_name(HIM "相思染腰带" NOR, ({ "xiangsiran yaodai", "yaodai", "waist" }));
  set("long", "一寸相思一寸灰，牛郎织女分离之时滴落相思血泪，遇相思灰而化为鸳鸯之形，故名为“相思染”，属于传说中的相思染套装中的一件。\n");
  set_weight(300 + (random(pj) * 100) + (random(lvl) * 100));
  set("value", 6000000);
  //	set("armor_prop/level", lvl);	//初始设定为0级
  set("armor_prop/level", 0);
  get_item_shuxing("armor", pj, lvl, 1);
  set("armor_prop/armor", armor);
  set("unit", "件");
  set("icon", "10077");
  set("material", "gem");
  set("owner_id", 1);
  set("dtzb", 1);  //添加判定,非副本装备无法强化
  set("xyzx_save_item", 1);
  set("xyzx_sys/bind_type", 0);
  set("xyzx_item/pinji", 4);
  set("taozhuang", 24);
  set("max_level", 45);
  //---------------------------------------------------------------
  //套装参数
  set("suit", HIM "相思染套装" NOR);  //套装名称
  set("suit_lvl", 4);             //套装等级
  set("suit_count", 10);           //套装部件数量
  //套装各部件
  set("suit_mod/armor", "相思染铠甲");
  set("suit_mod/boots", "相思染长靴");
  set("suit_mod/pants", "相思染长裤");
  set("suit_mod/hand", "相思染护手");
  set("suit_mod/head", "相思染头盔");
  set("suit_mod/neck", "相思染项链");
  set("suit_mod/cloth", "相思染长衫");
  set("suit_mod/ring", "相思染戒指");
  set("suit_mod/shield", "相思染盾牌");
  set("suit_mod/surcoat", "相思染披风");
  set("suit_mod/waist", "相思染腰带");
  set("suit_mod/wrists", "相思染护腕");
  //套装全部附加天赋效果  
  set("suit_eff/dexerity", 40000);
  set("suit_eff/intelligence", 40000);
  set("suit_eff/constitution", 40000);
  set("suit_eff/strength", 40000);
  set("suit_eff/armor", 40000);
  //	set("suit_eff/karma", 40000); 	
  //	set("suit_eff/personality", 40000); 
  //套装全部附加技能效果     
  //	set("suit_eff_skill/huagong-dafa", 1000);
  //	set("suit_eff_skill/beiming-shengong", 1000);
  //	set("suit_eff_skill/xixing-dafa", 1000);

  //---------------------------------------------------------------
  setup(1);
}
