// 莲音套装：项链

#include <armor.h>
#include <ansi.h>

inherit NECK;
inherit F_ITEM_MAKE;

void create() {
  int pj, lvl, armor;

  pj = random((int)sizeof(armor_shuxing));  //由于动态装备的属性只有7种了所以这里要改		
  lvl = random(get_system_config(DATA_CONFIG_DIR "armor/cloth.h", "ITEM_CLOTH_MAX_LEVEL")) + 1;
  armor = lvl * 100 / 2;
  armor = armor + random(armor);
  if (!armor || armor < 100) armor = 1 + random(99);

  set_name(HIB "莲音项链" NOR, ({ "lianyin xianglian", "xianglian", "neck" }));
  set("long", "仙池清莲所化的宝物，隐隐可闻其中仙音缭绕，有助修行，属于传说中的莲音套装中的一件。\n");
  set_weight(300 + (random(pj) * 100) + (random(lvl) * 100));
  set("value", 7000000);
  //	set("armor_prop/level", lvl);	//初始设定为0级
  set("armor_prop/level", 0);
  get_item_shuxing("armor", pj, lvl, 1);
  set("armor_prop/armor", armor);
  set("unit", "件");
  set("icon", "10077");
  set("material", "gem");
  set("owner_id", 1);
  set("dtzb", 1);  //添加判定,非副本装备无法强化
  set("xyzx_save_item", 1);
  set("xyzx_sys/bind_type", 0);
  set("xyzx_item/pinji", 3);
  set("taozhuang", 23);
  set("max_level", 40);
  //---------------------------------------------------------------
  //套装参数
  set("suit", HIB "莲音套装" NOR);  //套装名称
  set("suit_lvl", 3);             //套装等级
  set("suit_count", 10);           //套装部件数量
  //套装各部件
  set("suit_mod/armor", "莲音铠甲");
  set("suit_mod/boots", "莲音长靴");
  set("suit_mod/pants", "莲音长裤");
  set("suit_mod/hand", "莲音护手");
  set("suit_mod/head", "莲音头盔");
  set("suit_mod/neck", "莲音项链");
  set("suit_mod/cloth", "莲音长衫");
  set("suit_mod/ring", "莲音戒指");
  set("suit_mod/shield", "莲音盾牌");
  set("suit_mod/surcoat", "莲音披风");
  set("suit_mod/waist", "莲音腰带");
  set("suit_mod/wrists", "莲音护腕");
  //套装全部附加天赋效果  
  set("suit_eff/dexerity", 30000);
  set("suit_eff/intelligence", 30000);
  set("suit_eff/constitution", 30000);
  set("suit_eff/strength", 30000);
  set("suit_eff/armor", 30000);
  //	set("suit_eff/karma", 30000); 	
  //	set("suit_eff/personality", 30000); 
  //套装全部附加技能效果     
  //	set("suit_eff_skill/huagong-dafa", 1000);
  //	set("suit_eff_skill/beiming-shengong", 1000);
  //	set("suit_eff_skill/xixing-dafa", 1000);

  //---------------------------------------------------------------
  setup(1);
}
