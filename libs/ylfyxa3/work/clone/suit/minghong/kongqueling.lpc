// tielianzi.c
#include <weapon.h>
#include <ansi.h>

inherit THROWING;

void create() {
  set_name(HIB "孔雀翎" NOR, ({ "kongque ling", "throwing" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("xyzx_item/pinji", 3);
    set("owner_id", 1);
    set("taozhuang", 13);
    set("max_level", 1);
    set("xyzx_save_item", 1);
    set("xyzx_sys/bind_type", 0);
    set("weapon_prop/strength", 20000);
    set("weapon_prop/intelligence", 20000);
    set("weapon_prop/constitution", 20000);
    set("weapon_prop/dexerity", 20000);
    set("weapon_prop/karma", 20000);
    set("weapon_prop/personality", 20000);
    set("no_tie", 1);  //添加判定,暗器不能贴符
    set("unit", "些");
    set("value", 0);
    set("base_unit", "颗");
    set("base_weight", 10);
    set("base_value", 20);
    set("material", "iron");
    set("long", HIW "传说中的暗器，据说伤人例不虚发。\n" NOR);
    set("wield_msg", HIC "$N微微一抖，孔雀翎出现在手中，宛如孔雀开屏！\n" NOR);
    set("unwield_msg", HIC "$N无声无息，手中的孔雀翎笼入袖里。\n" NOR);
  }
  set_amount(10000);
  init_throwing(20000);
  setup();
}
int hit_ob(object me, object victim, int damage_bonus) {
  victim->apply_condition("wuxing_poison", 20);
  victim->apply_condition("emerald_poison", 20);
  victim->apply_condition("feng_poison", 20);
  //if( !victim->is_busy() ) victim->start_busy(1);
  return damage_bonus;
}
int query_autoload() { return 1; }
