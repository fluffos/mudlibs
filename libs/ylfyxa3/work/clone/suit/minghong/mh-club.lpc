//第3版装备系统

#include <weapon.h>
#include <ansi.h>

inherit CLUB;
inherit F_ITEM_MAKE;

void create() {
  int pj, lvl, damage, item_type;
  pj = random((int)sizeof(weapon_shuxing));  //由于动态装备的属性只有7种了所以这里要改
  lvl = random(get_system_config(DATA_CONFIG_DIR "weapon.h", "ITEM_WEAPON_MAX_LEVEL")) + 1;
  damage = lvl * 100 / 2;
  damage = damage + random(damage);
  if (!damage || damage < 100) damage = 1 + random(99);
  //	item_type = 1 + random(2);//单双手随机
  item_type = 2;  //指定为单手

  set_name(HIB "鸣鸿棍" NOR, ({ "minghong gun", "gun", "club" }));
  set_weight(3000 + (random(pj) * 100) + (random(lvl) * 100));
  set("value", 8000000);
  //	set("weapon_prop/level", lvl);	//初始设定为0级
  set("weapon_prop/level", 0);
  get_item_shuxing("weapon", pj, lvl, 1);
  set("unit", "柄");
  set("icon", "10068");
  set("material", "steel");
  set("owner_id", 1);
  set("dtzb", 1);  //添加判定,非副本装备无法强化
  set("xyzx_save_item", 1);
  set("xyzx_sys/bind_type", 0);
  set("xyzx_item/pinji", 3);
  set("taozhuang", 13);
  set("max_level", 40);
  set("long", "身长三尺，与轩辕同炉而成。黄帝见其杀意过盛，恐反噬其主，欲以轩辕毁之；乃化玄红云鹊，穿霞而逝。\n");
  set("wield_msg", HIR "一声脆响,$N手里无声无息的多了把青幽长棍.\n" NOR);
  set("unwield_msg", HIC "$N手中青光一闪，将手中的$n插回后背。\n");

  init_club(damage, item_type, 1);
  setup();
}
int query_autoload() { return 1; }
