// tielianzi.c
#include <weapon.h>
#include <ansi.h>

inherit THROWING;

void create() {
  set_name(HIM "暴雨梨花针" NOR, ({ "baoyulihua zhen", "throwing" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("xyzx_item/pinji", 4);
    set("owner_id", 1);
    set("taozhuang", 14);
    set("max_level", 1);
    set("xyzx_save_item", 1);
    set("xyzx_sys/bind_type", 0);
    set("weapon_prop/strength", 25000);
    set("weapon_prop/intelligence", 25000);
    set("weapon_prop/constitution", 25000);
    set("weapon_prop/dexerity", 25000);
    set("weapon_prop/karma", 25000);
    set("weapon_prop/personality", 25000);
    set("no_tie", 1);  //添加判定,暗器不能贴符
    set("unit", "些");
    set("value", 0);
    set("base_unit", "颗");
    set("base_weight", 10);
    set("base_value", 25);
    set("material", "iron");
    set("long", HIW "此暗器，一旦被伤害，神针无法取出，极为厉害。\n" NOR);
    set("wield_msg", HIC "$N微微一抖，一筒暴雨梨花针夹出现在手上，如梨花般洁白！\n" NOR);
    set("unwield_msg", HIC "$N无声无息，手里的针筒笼入袖里。\n" NOR);
  }
  set_amount(10000);
  init_throwing(25000);
  setup();
}
int hit_ob(object me, object victim, int damage_bonus) {
  victim->apply_condition("wuxing_poison", 20);
  victim->apply_condition("emerald_poison", 20);
  victim->apply_condition("feng_poison", 20);
  victim->apply_condition("fire_poison", 20);
  victim->apply_condition("hedinghong_poison", 20);
  //if( !victim->is_busy() ) victim->start_busy(1);
  return damage_bonus;
}
int query_autoload() { return 1; }
