inherit ITEM;
inherit F_UNIQUE;

void init() {
  add_action("do_canwu", "canwu");
}
void create() {
  set_name("降龙秘籍", ({ "xianglong miji", "miji", }));
  set_weight(500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "页");
    set("long",
      "这是一页用薄绢写成的经文。上书：“降龙十式”。\n"
      "书页泛黄，看来已经保存很久了，据说可以参悟（canwu）。\n",
    );
    set("no_drop", "武功秘籍可不能随便丢弃！\n");
    set("no_give", "这样东西不能随便给人。\n");
    set("value", 0);
    set("material", "silk");
    set("skill", ([
      "name": "xianglong-zhang",
      "exp_required": 100000,
      "jing_cost": 40,
      "difficulty": 20,
      "max_skill": 200
    ]));
  }
}

int do_canwu(string arg) {
  object me = this_player();
  object where = environment(me);
  object ob, weapon;
  string msg;
  int dagouxianglong, lvl;
  int cost;
  ob = this_object();

  if (arg != "xianglong miji")
    return notify_fail("你要参悟什么？\n");
  if (where->query("no_fight"))
    return notify_fail("大庭广众之下参悟绝世武学不怕被人打劫吗？。\n");
  if (where->query("pigging"))
    return notify_fail("你还是专心拱猪吧！\n");
  if (me->is_busy())
    return notify_fail("你现在正忙着呢。\n");
  if (me->is_fighting())
    return notify_fail("你无法在战斗中专心下来参悟真经！\n");
  if (!id(arg) || !objectp(ob = present(arg, me)))
    return notify_fail("你要参悟什么？\n");
  if (me->query("id") != ob->query("owner"))
    return notify_fail("这本武林秘籍是你的吗？\n");
  if ((string)me->query("gender") == "无性")
    return notify_fail("你无根无性不足，再参悟下去恐怕经脉俱断！\n");
  if ((int)me->query_skill("literate", 1) < 1000)
    return notify_fail("你是个文盲，先学点文化(literate)吧。\n");
  if ((int)me->query_skill("huntian-qigong", 1) < 1000)
    return notify_fail("你没有混天气功做根坻，恐怕有走火入魔之危！\n");
  if ((int)me->query_skill("xianglong-zhang", 1) < 2000)
    return notify_fail("你的降龙十八掌都未练到娴熟，又如何能参悟降龙十式呢！\n");
  if ((int)me->query_skill("dagou-bang", 1) < 2000)
    return notify_fail("你的打狗棒法练的不到家，没法参悟玉竹杖的秘密！\n");
  if ((int)me->query_skill("force", 1) < 2000)
    return notify_fail("就这么点内功基础，恐怕会受到掌力反噬！\n");
  if (me->query_skill_mapped("unarmed") != "xianglong-zhang")
    return notify_fail("你没准备好降龙掌法吧，这如何参悟呢。\n");
  if (me->query_skill_mapped("club") != "dagou-bang")
    return notify_fail("你没准备好打狗棍法吧，这如何参悟呢。\n");
  if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("id") != "yuzhu zhang")
    return notify_fail("你手里似乎没有玉竹杖啊，这如何能参悟打狗降龙呢！\n");
  if ((int)me->query("max_neili", 1) < 100000)
    return notify_fail("你内力修为太差了，无法催动内力进入奇经八脉。\n");
  if ((int)me->query("max_jingli", 1) < 100000)
    return notify_fail("你精力修为太差了，无法进入顿悟状态。\n");
  if (!me->query_temp("jm_gaibang1"))
    return notify_fail("你似乎未获得打狗棍法的传承啊！\n");
  if (!me->query_temp("jm_gaibang2"))
    return notify_fail("你似乎未获得降龙掌法的传承啊！\n");
  if (!me->query_temp("jm_gaibang3"))
    return notify_fail("你似乎得到洪七公的指点啊！\n");
  if (me->query("jm/gaibang"))
    return notify_fail("你已经完全领悟了打狗棍法与降龙掌法的不传之秘了，不需要再参悟了！\n");

  if ((int)me->query("neili") < 1000 || (int)me->query("jingli") < 1000) {
    write(CYN "忽然，你觉得内息一乱，知道不好！顿时内力不受控制，全身经脉紊乱，眼前一黑！！！\n" NOR);
    //				me->add("xyzx_sys/level",-1);
    me->unconcious();
    return 1;
  }

  dagouxianglong = me->query_skill("xianglong-zhang", 1) + me->query_skill("dagou-bang", 1);
  cost = dagouxianglong / 10;
  if (cost < 100) cost = 100;
  lvl = dagouxianglong / 100;
  if (lvl < 1) lvl = 1;

  message_vision("你辗转腾挪，十八掌接连使出，空中幻化出" + lvl + "道掌影。\n", me);
  message_vision("手持玉竹杖，三十六路打狗棒随心使出，空中残留" + lvl + "道棒影。\n", me);
  me->start_busy(1);
  me->add("jingli", -cost);
  me->add("neili", -cost);
  if (random(100000) < ((int)me->query(
    "kar",
    1
  ) + (int)me->query("int", 1) - (int)me->query("per", 1))) {
    message_vision(HIC "突然你灵光一闪，十八掌合一，一式降龙无悔击出，掌力排山倒海。不待这一掌使完，又是一招天下无狗，漫天都是青色棒影。\n" NOR, me);
    message_vision(HIC "。恭喜你贯通了打狗棒与降龙掌的传承，领悟了丐帮的镇帮绝技！\n" NOR, me);
    message(
      "channel:chat",
      HIM "【天降奇才】" HIM + "听说" + me->query("name") + "天纵奇才，参悟降龙秘籍与玉竹杖，居然领悟了丐帮的镇帮绝技！\n" NOR,
      users()
    );
    me->set("jm/gaibang", 1);
    me->add("family_score", 1);
  } else {
    switch (random(11)) {
      case 0: msg = RED "初临敌阵，探听虚实，一阳在下，遯世无闷，隐而未见，潜龙勿用。。\n" NOR;
      break;
      case 1: msg = GRN "乾元者，始而亨者也。。。。时乘六龙，以御天也。云行雨施，天下平也。。\n" NOR;
      break;
      case 2: msg = YEL "团而缩，小也，伸而发，大也；施力发劲、由小而大，现也；出潜离隐，故曰见龙，处于地上，故曰在田。\n" NOR;
      break;
      case 3: msg = BLU "飞龙在天，伸也、升也，如英雄得志，而飞腾宇宙；降而击之，屈也、下也，挟雷霆之威，有河决之势。\n" NOR;
      break;
      case 4: msg = MAG "物极必反，亢必有悔。以极阳之势，待强弩之末，有悔得吉，彼吝得凶。\n" NOR;
      break;
      case 5: msg = CYN "地势坤，君子以厚的载物，龙战于野，阴接于地。\n" NOR;
      break;
      case 6: msg = WHT "《彖》曰：“履，柔履刚也，说而应乎乾”，敌刚猛而来，必随其而动。“武人为于大君”，用武之时也。\n" NOR;
      break;
      case 7: msg = HIR "损，损下益上之象。其道上行，损而有孚。“将欲取之，必先与之，将欲擒之，必先纵之”，自损者益；二簋可用享，分掌也；九三上于六，脚踹也。\n" NOR;
      break;
      case 8: msg = HIG "阴阳不测，侵掠如火。《易》曰“突如其来，焚如，死如，弃如”。战必胜，攻必克。兵法有言：“其疾如风，其徐如林，侵掠如火，不动如山”。\n" NOR;
      break;
      case 9: msg = HIY "涉大川必借助于舟楫，治洪水必因势而利导。侧身引化，避其锋芒；侧身击发，避实就虚、借力打力，力道倍增。\n" NOR;
      break;
      case 10: msg = HIC "上六为防守，九三为进攻，“羝羊触藩，羸其角，不能退，不能遂”，守中正，防冒进。\n" NOR;
      break;
    }
    message_vision(msg, me);
  }

  return 1;
}


int query_autoload() { return 1; }
