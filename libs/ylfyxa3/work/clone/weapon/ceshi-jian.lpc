// longsword.c 长剑

#include <weapon.h>
inherit SWORD;

void create() {
  set_name("测试专用剑", ({ "ceshi jian" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "柄");
    set("long", "这是一柄普通的玄铁剑，一般的剑客都配带此剑。\n");
    set("value", 0);
    set("material", "steel");
    set("wield_msg", "$N「唰」的一声抽出一柄$n握在手中。\n");
    set("unwield_msg", "$N将手中的$n插回剑鞘。\n");
    set("weapon_prop/strength", 200000);
    set("weapon_prop/dexerity", 200000);
  }
  init_sword(20000);
  setup();
}
