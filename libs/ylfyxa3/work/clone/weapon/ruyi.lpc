// qimeigun.c 齐眉棍
// added bye host nov,24

#include <weapon.h>
inherit CLUB;

void create() {
  set_name("如意金箍棒", ({ "ruyi", "jinfubang", "club" }));
  set_weight(5000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "根");
    set("icon", "10045");
    set("long", "这是一根公门中的一种武器。\n");
    set("value", 1500);
    set("rigidity", 100);
    set("material", "steel");
    set("wield_msg", "$N抽出一根$n握在手中。\n");
    set("unwield_msg", "$N将手中的$n插回腰间。\n");
  }
  init_club(500, 2);
  setup();
}
int query_autoload() { return 1; }
