// cloth.c
#include <armor.h>
#include <ansi.h>
inherit CLOTH;
void create() {
  set_name("巡捕服", ({ "xunbu fu", "fu", "cloth" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一件捕快专用的紧身军服。\n");
    set("icon", "10001");
    set("unit", "件");
    set("material", "cloth");
    set("value", 1000);
    set("armor_prop/armor", 10);
  }
  setup();
}
int query_autoload() { return 1; }
