//yitianjian.c
#include <weapon.h>

inherit SPEAR;

void create() {
  set_name("方天画戟", ({ "fangtian huaji", "spear", "huaji" }));
  set_weight(20000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "柄");
    set("icon", "10016");
    set("value", 50000);
    //        	set("no_drop", "1");
    set("material", "iron");
    set("long", "这是天下第一兵器，持有之人皆有“万夫不当之勇”之说。\n");
    set("wield_msg", "直如矫龙吞水，长虹冠日一般，$n已在$N手中，天地为之变色。\n");
    set("unwield_msg", "$N将$n插回身侧，华光顿敛，天地间只闻龙鸣。\n");
  }
  init_spear(600);
  setup();
}
