// respirate.c	//吐纳

#include <skill.h>
inherit F_CLEAN_UP;
private int respirate_cost;
int respirating(object me);
int halt_respirate(object me);
string *order = ({
  "" HIY "",
  "" HIG "",
  "" RED "",
  "" MAG "",
  "" YEL "",
  "" HIC "",
  "" HIW "",
  "" HIR "",
  "" HIB "",
  "" CYN "",
  "" WHT "",
  "" HIM "",
  "" BLU ""
});

int main(object me, string arg) {
  mapping msg;
  string force_skill = me->query_skill_mapped("force");
  object where = environment(me);

  seteuid(getuid());

  if (where->query("pigging"))
    return notify_fail("你还是专心拱猪吧！\n");
  if (me->is_busy() || me->set_temp("pending/respirate"))
    return notify_fail("你现在正忙着呢！\n");
  if (me->query_temp("cooldown"))  //CD写法	2017.9.7添加
    return notify_fail("你处于技能冷却状态中，休息一会吧。\n");
  if (me->is_fighting())
    return notify_fail("战斗也是一种修行，但不能和精力的修行同时进行。\n");
  if (me->query_skill("taoism", 1) < 100)
    return notify_fail("你必须先学些道学心法。\n");
  if ((int)me->query_skill("force", 1) < 100)
    return notify_fail("你还是先学些呼吸心法的技巧！\n");
  if (!arg || !sscanf(arg, "%d", respirate_cost))
    return notify_fail("你要花多少精修行？\n");
  if (respirate_cost < 10)
    return notify_fail("你最少要花 10 点精力才能进行修行。\n");
  if ((int)me->query("jing") < respirate_cost)
    return notify_fail("你现在精不足，无法修行精力！\n");
  if ((int)me->query("qi") * 100 / (int)me->query("max_qi") < 70)
    return notify_fail("你现在身体状况太差了，无法集中精神！\n");

  //2018.2.6阿飞改，换成那种花样打坐方式	
  if (force_skill && msg = SKILL_D(force_skill)->exercise_msg(me)) {
    write((order[random(13)]) + ("\n你" + msg["status_msg"]) + NOR);
    write((order[random(13)]) + ("\n你" + msg["heal_my_msg"]) + NOR);
    message_vision((order[random(13)]) + (msg["heal_other_msg"]) + NOR, environment(me), ({ me }));
  } else {
    write("你闭上眼睛开始打坐。\n");
    message("vision", me->name() + "盘膝坐下，开始吐纳炼精。\n", environment(me), ({ me }));
  }
  //	write("你闭上眼睛开始打坐。\n");	//换成那种花样吐纳方式
  //	message("vision",me->name()+"盘膝坐下，开始吐纳炼精。\n", environment(me),({me}));	
  me->set_temp("pending/respirate", 1);
  me->set_temp("respirate_cost", respirate_cost);
  me->start_busy((: respirating :), (: halt_respirate :));
  return 1;
}
int respirating(object me) {
  mapping msg;
  string force_skill = me->query_skill_mapped("force");
  int respirate_cost = (int)me->query_temp("respirate_cost");
  int jingli_gain = (int)me->query_skill("taoism", 1) + (int)me->query_skill("force", 1);
  int level, jibenforce, teshuforce, flag, addtime;
  int huiyuan;
  flag = (int)me->query_skill("taoism", 1) / 1000;
  if (flag < 1) flag = 1;
  if (flag > 5) flag = 5;
  if (me->query("xyhy_type") == 2) huiyuan = 5 / 4;  //黄金会员打坐增加技能熟练度1.25倍
  else huiyuan = 1;
  if (me->query_exp_times() > 1) addtime = 2;
  else addtime = 1;
  if (respirate_cost < 1) return 0;
  if (respirate_cost < jingli_gain) jingli_gain = respirate_cost;
  if (respirate_cost > 2 * jingli_gain) jingli_gain = respirate_cost / 2;
  me->add("jingli", jingli_gain);
  me->set_temp("respirate_cost", respirate_cost -= jingli_gain);
  me->add("jing", -jingli_gain);
  if (respirate_cost > 0) return 1;

  level = (int)me->query("xyzx_sys/level");
  jibenforce = (int)me->query_skill("force", 1);
  teshuforce = (int)me->query_skill("taoism", 1);
  me->set_temp("pending/respirate", 0);
  //	respirate_cost = 0;
  //2018.2.6阿飞改，换成那种花样打坐方式	
  if (force_skill && msg = SKILL_D(force_skill)->exercise_msg(me)) {
    write((order[random(13)]) + ("\n你" + msg["hover_my_msg"]) + NOR);
    if (!me->query("env/no_fight_msg")) {
      message_vision((order[random(13)]) + (msg["hover_other_msg"]) + NOR, environment(me), me);
      tell_object(me, HIY "你吐纳完毕，睁开双眼，站了起来。\n" NOR);
    } else {
      tell_object(me, HIY "你吐纳完毕，睁开双眼，站了起来。\n" NOR);
    }
  } else {
    if (!me->query("env/no_fight_msg")) message_vision(HIY "$N吐纳完毕，睁开双眼，站了起来。\n" NOR, me);
    else tell_object(me, HIY "你吐纳完毕，睁开双眼，站了起来。\n" NOR);
  }
  //	message_vision("$N吐纳完毕，睁开双眼，站了起来。\n", me);	//2018.2.6阿飞改，换成那种花样打坐方式
  if (teshuforce < jibenforce && teshuforce < (level + 300) * 2)
    me->improve_skill(
      "taoism",
      me->query_con() * addtime * flag * huiyuan * me->query("con", 1) / 500 + 10,
      0
    );
  if (jibenforce < (level + 300) * 4)
    me->improve_skill(
      "force",
      me->query_con() * addtime * flag * huiyuan * me->query("con", 1) / 500 + 10,
      0
    );
  if ((int)me->query("jingli") < (int)me->query("max_jingli") * 2)
    return 0;
  else {
    if ((int)me->query("max_jingli") > ((int)me->query_skill(
      "taoism",
      1
    ) + (int)me->query_skill("force", 1) + 100) * 2000) {
      write("你的精力修为似乎已经达到了瓶颈。\n");
      me->set("jingli", (int)me->query("max_jingli") * 2);
      return 0;
    } else {
      me->add(
        "max_jingli",
        100 + random(me->query("con", 1)) * 50 + random(me->query_skill("force") / 20)
      );
      me->set("jingli", (int)me->query("max_jingli"));
      write("你的精力增加了！！\n");
      return 0;
    }
  }
}
int halt_respirate(object me) {
  if ((int)me->query("jingli") > (int)me->query("max_jingli") * 2)
    me->set("jingli", (int)me->query("max_jingli") * 2);
  me->set_temp("pending/respirate", 0);
  return 1;
}
int help(object me) {
  write(@HELP
指令格式 : respirate [<耗费「精」的量>]
 
打坐修行，利用「炼精化气，炼气化神，炼神还虚」的方法将你的精
转变成精力。
See also: exercise
HELP
  );
  return 1;
}
