int do_betray() {
  int i, ob_levl, sublvl, level;
  //	int subsxd;	//玩家属性点都没了，要这个没意义
  object me;
  mapping skill_status;
  string *sname;

  me = this_player();

  if (!(int)me->query("betrayer"))
    return notify_fail("赵六说道：你已经没有判师记录了呀！\n");

  if (!me->query_temp("fee_paid"))
    return notify_fail("赵六冷冷地说道：不管叫我做什麽，您可得先付钱哪！\n");

  me->add("betrayer", -1);
  if (skill_status = me->query_skills()) {
    sname = keys(skill_status);
    for (i = 0; i < sizeof(skill_status); i++) {
      level = skill_status[sname[i]] - 5;
      if (level <= 0)
        me->delete_skill(sname[i]);
      else
        me->set_skill(sname[i], level);
    }
  }

  ob_levl = me->query("xyzx_sys/level");
  me->set("xyzx_sys/levup_exp", 0);

  /*    //等级损失
    if ( ob_levl >= LEVEL_UP_NUM )
    {
		if ( ob_levl < (20*LEVEL_UP_NUM) )
		{
			sublvl=LEVEL_UP_NUM;
		}
		else
			sublvl = LEVEL_UP_NUM*ob_levl/20;
		subsxd=0;
		for(i=0;i<sublvl;i+=LEVEL_UP_NUM)
		{
			subsxd+=LEVUP_SHUXD_NUM_ONE;
			if ( (ob_levl-i) % 1000 == 0 ) subsxd += 1000;
			else if ( (ob_levl-i) % 100 == 0 ) subsxd += 200;
			else if ( (ob_levl-i) % 10 == 0 ) subsxd += 50;		    
		}
		me->set("xyzx_sys/level",ob_levl-sublvl);
		del_shuxingdian(me,subsxd);
    }
*/
  //等级损失		2017.3.18阿飞重写，属性点都没了，简单点
  sublvl = ob_levl * 5 / 100;
  if (sublvl < 1) sublvl = 1;
  if (ob_levl > 1) me->set("xyzx_sys/level", ob_levl - sublvl);

  me->delete_temp("fee_paid");
  tell_object(me, "赵六笑眯眯地说到：好啦，判师记录清除了一次。\n");
  me->unconcious();
  return 1;
}
