inherit NPC;
void create() {
  int jibie;
  jibie = 1000;
  set("xyzx_sys/level", jibie);  //2016.5.22阿飞调整NPC属性
  set_name("朱聪", ({ "zhu cong" }));
  set("gender", "男性");
  set("long", "江南七怪老二,手上功夫了得!\n");
  set("shen", 80000);
  set("combat_exp", 170000);
  set("title", "妙手书生");

  set("per", 30);
  set("age", 34);
  set("kee", 1700);
  set("max_kee", 1700);
  set("food", 250);
  set("water", 250);
  set("neili", 1700);
  set("max_neili", 1700);
  set("force_factor", 20);

  set_skill("dodge", 500 + jibie / 3 + random(jibie / 5));
  set_skill("force", 500 + jibie / 3 + random(jibie / 5));
  set_skill("parry", 500 + jibie / 3 + random(jibie / 5));
  set_skill("unarmed", 500 + jibie / 3 + random(jibie / 5));
  set_skill("sword", 500 + jibie / 3 + random(jibie / 5));

  setup();
  add_money("silver", 70);
  carry_object("clone/cloth/cloth")->wear();
  carry_object(__DIR__ "obj/zheshan")->wield();
}
