// yuxudong.c 玉虚洞 

#include <room.h>
inherit ROOM;

void create() {
  set("short", "玉虚洞");
  set("long", @LONG
眼前是一个半天然，半人工的山洞，四周点着几盏长命灯，正中放着一张桌子，上
面放这几本书。地上零乱的放着七个供人打坐用的蒲团。如果仔细的观察一下，仿
佛感到洞中的摆设藏着什么玄机。洞壁布满剑痕，你可以试着练习(lianxi)看看，
或许能领悟到什么。
LONG
  );

  set("exits", ([
    "out": __DIR__ "yadi",
  ]));
  set("objects", ([
    __DIR__ "npc/chongyang": 1,
  ]));
  setup();
  replace_program(ROOM);
}


void init() {
  add_action("do_lianxi", "lianxi");
}

int do_lianxi(string arg) {
  object me = this_player();

  string *poem = ({
    "使出一招「" HIM "紫电穿云" NOR "」，如同一道闪电，穿云裂帛...",
    "使出一招「" HIG "浪迹天涯" NOR "」，辗转七步，连绵不绝...",
    "使出一招「" HIB "浩气长舒" NOR "」，剑气激荡，如同紫气东来...",
    "使出一招「" HIY "定阳针" NOR "」，他强由他强，我自一剑定乾坤...",
    "使出一招「" HIB "七星耀月" NOR "」，天驱，天璇，天玑，天权，玉衡，开阳，摇光。一剑落七星，七星耀明月。",
  });

  if (me->is_busy())
    return notify_fail("你现在忙着呢，哪有功夫练剑......\n");
  if (me->query("family/family_name") != "全真教")
    return notify_fail("不是全真教的弟子，竟敢在重阳真人跟前练剑？\n");
  if (!me->query_temp("jm_quanzhen_dongxie"))
    return notify_fail("你未替重阳真人与东邪黄药师比武，如何能得到重阳真人指点武学！\n");
  if (!me->query_temp("jm_quanzhen_xidu"))
    return notify_fail("你未替重阳真人与西毒欧阳锋比武，如何能得到重阳真人指点武学！\n");
  if (!me->query_temp("jm_quanzhen_nandi"))
    return notify_fail("你未替重阳真人与南帝一灯大师比武，如何能得到重阳真人指点武学！\n");
  if (!me->query_temp("jm_quanzhen_beigai"))
    return notify_fail("你未替重阳真人与北丐洪七公比武，如何能得到重阳真人指点武学！\n");
  if (me->query("jm/quanzhen"))
    return notify_fail("你已经完全领悟了浣花剑派的精髓，不需要在这领悟了。\n");

  if (me->query_skill(
    "tiangang-zhengqi",
    1
  ) < 1000 && me->query_skill("xiantian-qigong", 1) < 1000) {
    tell_object(me, "你的内功似乎差了点.......\n");
    return 1;
  }
  if (me->query_skill("quanzhen-jianfa", 1) < 2000) {
    tell_object(me, "你的剑法似乎差了点.......\n");
    return 1;
  }
  if (me->query_skill("qixing-huanwei", 1) < 2000 || me->query_skill("jinyan-gong", 1) < 2000) {
    tell_object(me, "你的轻功似乎差了不少.......\n");
    return 1;
  }
  if (me->query("jingli") < 1000) {
    tell_object(me, "你还是先休息一会儿吧。\n");
    return 1;
  }

  tell_object(me, HIW "你在玉虚洞中，听从重阳真人的指点，你尝试着练习了下......\n" NOR);
  message_vision("$N" + poem[random(sizeof(poem))] + "\n", me);
  me->add("jingli", -500);
  me->start_busy(1);

  if (random(100000) < me->query("kar", 1)) {
    me->set("jm/quanzhen", 1);
    me->add("family_score", 1);
    tell_object(me, HIB "你突然醒悟道：" HIY "原来全真剑法可以有此等威力" HIR "！\n" NOR);
    tell_object(me, HIB "恭喜你融汇贯通了全真教武功的精髓！\n" NOR);
    message(
      "channel:chat",
      HIM "【天降奇才】" HIM + "听说" + me->query("name") + "天纵奇才，在全真教玉虚洞居然领悟了全真剑法的至高奥义！\n" NOR,
      users()
    );
  }
  return 1;
}
