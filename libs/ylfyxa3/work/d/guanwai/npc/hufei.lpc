// hufei.c
#include <ansi.h>;
inherit NPC;
string ask_me();
string ask_book();
int ask_yuan();
void do_kill(object ob);

void create() {
  int jibie;
  jibie = 3000;
  set("xyzx_sys/level", jibie);  //2016.5.22阿飞调整NPC属性	
  set_name("胡斐", ({ "hu fei", "hu", "fei" }));
  set("gender", "男性");
  set("nickname", "雪山飞" HIG "狐" NOR);
  set("title", "关外胡家");
  set("age", 25);
  set("long",
    "他就是胡一刀之子，因其武功高强神出鬼没。\n"
    "在江湖上人送外号「雪山飞狐」。\n"
    "他身穿一件白色长衫，腰间别着一把看起来很旧的刀。\n"
    "他满腮虬髯，根根如铁，一头浓发，却不结辫。\n");
  set("attitude", "peaceful");
  set("str", 45);
  set("int", 30);
  set("con", 30);
  set("dex", 30);
  set("chat_chance", 20);

  set("chat_msg", ({
    "胡斐叹了口气道：“不知什么时候还能再见到若兰姑娘。\n",
    "胡斐恨恨道：“苗人凤是我杀父仇人，我必报此仇！”\n",
    "胡斐切齿恨道：“阎基老贼暗中下毒，我必手刃此獠！”\n",
    //		(: random_move :),
  }));
  //	create_family("关外胡家", 3, "传人");
  //	create_family("中原苗家", 3, "友人"); 	
  create_family("胡苗世家", 3, "胡家传人");
  set("max_qi", 350000);
  set("max_jing", 150000);
  set("neili", 3000000);
  set("max_neili", 3000);
  set("jiali", 500);
  set("combat_exp", 190000000);
  set("score", 20000);

  set_skill("force", 500 + jibie / 3 + random(jibie / 5));             // 基本内功	
  set_skill("hujia-dao", 500 + jibie / 3 + random(jibie / 5));       // 胡家刀法          	
  set_skill("blade", 500 + jibie / 3 + random(jibie / 5));             // 基本刀法	
  set_skill("lengyue-shengong", 500 + jibie / 3 + random(jibie / 5));      // 冷月神功	
  set_skill("dodge", 500 + jibie / 3 + random(jibie / 5));             // 基本躲闪	
  set_skill("sixiang-bufa", 500 + jibie / 3 + random(jibie / 5));    // 四象步法	
  set_skill("parry", 500 + jibie / 3 + random(jibie / 5));             // 基本招架	
  set_skill("unarmed", 500 + jibie / 3 + random(jibie / 5));
  set_skill("tianchang-zhang", 500 + jibie / 3 + random(jibie / 5));
  map_skill("force", "lengyue-shengong");
  map_skill("blade", "hujia-dao");
  map_skill("dodge", "sixiang-bufa");
  map_skill("parry", "hujia-dao");
  map_skill("unarmed", "tianchang-zhang");
  set("inquiry", ([
    "宝刀": (: ask_me :),
    "刀谱": (: ask_book :),
    "胡家刀谱": (: ask_book :),
    "阎基": "阎基这个狗贼我非杀了他不可。\n",
    "胡一刀": "辽东大侠胡一刀是我爹。不过我从没见过他。\n",
    "苗人凤": "苗人凤虽和家父齐名，家父却死在他的剑下。\n",
    "苗若兰": "不知什么时候还能再见到若兰姑娘。\n",
    "程灵素": "二妹是为我而死的。\n",
    "赵半山": "你见我赵三哥了? \n",
    "袁紫衣": (: ask_yuan :),
  ]));
  set("baodao_count", 1);
  set("book_count", 1);

  setup();
  carry_object(__DIR__ "obj/cwbdao")->wield();
  carry_object("/clone/cloth/cloth")->wear();
}

string ask_me() {
  object ob, me;

  me = this_player();
  if ((int)me->query("shen") < 0) {
    me->set_leader(ob);
    call_out("do_kill", 1, this_player());
  } else if ((int)(me->query("shen") < 30000000)) {
    return "以你目前的作为是不能拿这把刀的。\n";
  } else if ((int)(me->query("shen") > 30000000)) {
    if (query("baodao_count") > 0) {
      call_out("waiting", 0, me, ob);
      add("baodao_count", -1);
      ob = new(__DIR__ "obj/cwbdao");
      ob->set("owner", me->query("id"));  //设定识别
      ob->move(me);
      command("rumor " + me->query("name") + "拿到闯王军刀啦。\n");
      return " 好吧，这把闯王宝刀就赠与你，希望你好好利用它。\n";
    } else return "你来晚了，现在这把刀已不在此处。\n";
  }

}

void do_kill(object ob) {
  object me, room1;
  me = this_object();
  room1 = environment(me);

  if (room1->query("no_fight"))
    room1->set("no_fight", 0);

  if (interactive(ob)) {
    command("say 你这恶贼竟敢打我宝刀的主意，给我纳命来！\n");
    me->set_leader(ob);
    remove_call_out("kill_ob");
    call_out("kill_ob", 1, ob);
  }

}

int accept_object(object me, object ob) {
  if (!me || environment(me) != environment()) return 0;
  if (!objectp(ob)) return 0;
  if (!present(ob, me)) return notify_fail("你没有这件东西。");
  if ((string)ob->query("id") == "yan ji") {
    write(HIC "\n胡斐说道：这位" + RANK_D->query_respect(me) + "，如此大恩大德，在下实不知何以为报。\n");
    write(HIC "\n胡斐大喜道：狗贼！想不到你也有今天！！手起刀落，将阎基剁为两段。\n");
    ob->die();
    me->set_temp("marks/hujiadaopu", 1);
    return 1;
  }
  command("?");
  return 0;
}

string ask_book() {
  object ob, me;

  me = this_player();

  if (!objectp(me)) return "";
  if (!me->query_temp("marks/hujiadaopu", 1)) return "你说什么? \n";
  if ((int)(me->query("shen") < 5000000))
    return "刀谱落入宵小之手，难免是阎基第二。\n";
  else if ((int)(me->query("shen") > 5000000)) {
    if (query("book_count") > 0) {
      write(HIC "胡斐说着转身从阎基尸身上搜出一本破旧书本，递了给你。\n");
      call_out("waiting", 0, me, ob);
      add("book_count", -1);
      ob = new("/clone/book/blade_book");
      ob->move(this_player());
      me->set_temp("hufei_baishi", 1);
      message("chat", HIY "【镜花水月】" + HIM "" + me->query("name") + "拿到胡家刀谱啦。\n" NOR, users());
      command("say 好吧，如果你想拜我为师就磕头吧。\n");
      //			command("recruit "+me->query("id"));	//2017.11.27阿飞改，胡斐拜师条件修改
      return "这本刀谱被这狗贼霸占多时了，现在就赠与你吧。\n";
    } else return "你来晚了，现在刀谱已不在此处。\n";
  }

}

void attempt_apprentice(object ob) {
  if (!ob->query_temp("hufei_baishi")) {
    command("say 你未替我夺回胡家刀谱残页，我无法信任你。\n");
    return;
  }
  if ((int)ob->query("str", 1) < 25) {
    command("say 这位" + RANK_D->query_respect(ob) + "臂力太差了，恐怕学不了我胡家刀法。");
    return;
  }
  if ((int)ob->query("int", 1) < 25) {
    command("say 这位" + RANK_D->query_respect(ob) + "悟性太差了。");
    return;
  }
  command("say 好吧，我收下你。\n");
  command("recruit " + ob->query("id"));
  return;
}

int ask_yuan() {
  object me, ob;
  me = this_player();
  ob = this_object();

  if ((string)me->query("family/family_name") == "胡苗世家" && me->query("family/master_id") == "hu fei") {
    message_vision(HIB "胡斐叹了一口气道：袁姑娘乃女中豪杰，我不如也！” \n" NOR, me);
    message_vision(HIB "胡斐说道：我负袁姑娘甚多，今生恐怕难以为报！” \n" NOR, me);
    message_vision(HIB "胡斐说道：吾徒可替我将传家宝送于袁掌门。\n" NOR, me);
    me->set_temp("jm_hu1", 1);
  } else {
    message_vision(YEL "胡斐说道：那是我红颜知己，别提这伤心事了！” \n" NOR, me);
  }

  return 1;
}
