inherit NPC;

void create() {
  int jibie;
  jibie = 100;
  set("xyzx_sys/level", jibie * 8 / 10 + random(jibie * 4 / 10));  //2016.5.22阿飞调整NPC属性	
  set_name("采参人", ({ "man" }));
  set("gender", "男性");
  set("age", 42);
  set("long", "这是一个长白山采参的人。\n");

  set("combat_exp", 5000);
  set("str", 10);
  set("attitude", "peaceful");
  set("inquiry", ([
    "人参": "你要采参吗？挖就可以了！\n",
  ]));
  setup();
  carry_object("clone/cloth/cloth")->wear();

}
