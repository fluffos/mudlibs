// xiaoqu.c

inherit NPC;

void create() {
  int jibie;
  jibie = 100;
  set("xyzx_sys/level", jibie * 8 / 10 + random(jibie * 4 / 10));  //2016.5.22阿飞调整NPC属性
  set_name("曲非烟", ({ "qu feiyan", "qu" }));
  set("gender", "女性");
  set("age", 12);
  set("long",
    "她是日月神教曲长老的宝贝孙女儿，有十二、三岁了吧。\n");
  set_temp("apply/defense", 5);
  set("combat_exp", 70);
  //        set("shen", 100);
  set("shen_type", 1);
  set("per", 26);
  set("str", 30);
  set("dex", 30);
  set("con", 30);
  set("int", 30);
  set("attitude", "friendly");
  setup();
  carry_object("/clone/cloth/cloth")->wear();
}
