// 地图源文件

#define SHORT_NAME "蛮荒大陆"
#define LONG_NAME "这里就是传说中的蛮荒之地，距离中原繁华之地不知几万里，各种猛兽横行。\n不少蒙面黑衣之徒来这里捕猎，听说能获得不少稀世之宝。\n这里也是江湖败类的放逐之地，由于远离中原，缺少法律制约，\n杀人越货之事时有发生，在这片大陆行走，杀机重重.....\n"


inherit ROOM;

void create() {
  set("outdoors", "automap4");
  set("short", SHORT_NAME);
  set("long", LONG_NAME);
  set("exits", ([
    "east": __DIR__ "fuben" + (1 + random(300)),
    "west": __DIR__ "fuben" + (1 + random(300)),
    "south": __DIR__ "fuben" + (1 + random(300)),
    "north": __DIR__ "fuben" + (1 + random(300)),
  ]));
  set("objects", ([
    "/d/automap4/npc/guai2": 1,
  ]));
  setup();
}

int valid_leave(object me, string dir) {
  mapping exits;
  string file_name;

  exits = this_object()->query("exits");

  if (mapp(exits) && sizeof(exits)) {
    if (!stringp(file_name = exits[dir]))
      return notify_fail("地图连接错误，请用 sos 通知管理员修改。\n");
    if (strlen(file_name) < 10)
      return notify_fail("连接的区域不正确，请用 sos 通知管理员修改。\n");
    if (!playerp(me) && base_name(this_object())[0..9] != file_name[0..9])
      return 0;
  }

  return ::valid_leave(me, dir);
}
