#include <ansi.h>
inherit NPC;
inherit F_MASTER;

void create() {
  int jibie;
  jibie = 8000;
  set("xyzx_sys/level", jibie);  //2016.5.22阿飞调整NPC属性
  set_name("刀锋冷", ({ "dao fengleng", "dao", "fengleng" }));
  set("nickname", HIW "刀剑笑" NOR);
  set("long",
    "他就是杀手楼的楼主，这是个杀性深不可测的人物。\n"
    "他正值壮年，身材瘦长，沉默寡言。\n");
  set("gender", "男性");
  set("age", 45);
  set("attitude", "heroism");
  set("shen_type", 1);
  set("str", 28);
  set("int", 28);
  set("con", 28);
  set("dex", 28);

  set("max_qi", 3000000);
  set("max_jing", 500000);
  set("neili", 15000000);
  set("max_neili", 5000);
  set("jiali", 30000);
  set("combat_exp", 1500000000);
  set("score", 300000);

  set_skill("force", 500 + jibie / 3 + random(jibie / 5));
  set_skill("wuji-shengong", 500 + jibie / 3 + random(jibie / 5));
  set_skill("dodge", 500 + jibie / 3 + random(jibie / 5));
  set_skill("bugui-bufa", 500 + jibie / 3 + random(jibie / 5));
  set_skill("strike", 500 + jibie / 3 + random(jibie / 5));
  set_skill("fanyun-zhang", 500 + jibie / 3 + random(jibie / 5));
  set_skill("parry", 500 + jibie / 3 + random(jibie / 5));
  set_skill("unarmed", 500 + jibie / 3 + random(jibie / 5));
  set_skill("blade", 500 + jibie / 3 + random(jibie / 5));
  set_skill("qishen-dao", 500 + jibie / 3 + random(jibie / 5));
  set_skill("literate", 500 + jibie / 3 + random(jibie / 5));

  map_skill("force", "wuji-shengong");
  map_skill("dodge", "bugui-bufa");
  map_skill("strike", "fanyun-zhang");
  map_skill("unarmed", "fanyun-zhang");
  map_skill("parry", "qishen-dao");
  map_skill("blade", "qishen-dao");

  create_family("杀手楼", 1, "楼主");
  set("book_count", 1);

  set("chat_chance_combat", 300);
  set("chat_msg_combat", ({
    (: perform_action, "blade.shaqi" :),
    (: perform_action, "unarmed.yunkai" :),
    (: exert_function, "recover" :),
  }));
  set("no_get", 1);
  setup();
  carry_object("/d/shashou/obj/wuqing")->wield();
  carry_object("/d/wudang/obj/greyrobe")->wear();

}

void attempt_apprentice(object ob) {
  if ((int)ob->query("combat_exp") < 150000000) {
    command("say 杀手是提着脑袋过日子的事，所以江湖经验一定要丰富。");
    return;
  }
  if ((int)ob->query("str", 1) < 30) {
    command("say 杀手楼的功夫都是一击毙命，所以招式势大力沉，你这体格明显使不出来。");
    return;
  }
  if ((int)ob->query("xyzx_sys/level") < 1000) {
    command("say 这位" + RANK_D->query_respect(ob) + "实战能力太差了，如何杀的了江湖高手。");
    return;
  }
  if (ob->query_skill("wuji-shengong", 1) < 1000) {
    command("say 这位" + RANK_D->query_respect(ob) + "对我杀手楼的内功掌握不够精通。");
    command("say 是否应该多在这上面下点功夫。");
    return;
  }
  command("say 好吧，我就收下你了。");
  command("recruit " + ob->query("id"));
  if ((string)ob->query("class") != "shashou") ob->set("class", "shashou");
  return;
}
