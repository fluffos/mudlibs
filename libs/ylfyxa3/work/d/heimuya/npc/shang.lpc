//shang.c
inherit NPC;
inherit F_MASTER;
inherit F_UNIQUE;
void greeting(object);
void init();
void create() {
  int jibie;
  jibie = 1000;
  set("xyzx_sys/level", jibie);  //2016.5.22阿飞调整NPC属性
  set_name("桑三娘", ({ "shang", "sanniang" }));
  set("gender", "女性");
  set("age", 45);
  set("long", "神情古怪，面无丝毫微笑，由胜似母夜叉。 \n"
  );
  set("attitude", "peaceful");
  set("shen_type", 1);
  set("str", 23);
  set("int", 23);
  set("con", 22);
  set("dex", 29);
  set("max_qi", 1000);
  set("max_jing", 1000);
  set("neili", 300);
  set("max_neili", 300);
  set("combat_exp", 350000);
  set("score", 30000);
  set("jiali", 50);
  set_skill("force", 500 + jibie / 3 + random(jibie / 5));
  set_skill("dodge", 500 + jibie / 3 + random(jibie / 5));
  set_skill("unarmed", 500 + jibie / 3 + random(jibie / 5));
  set_skill("parry", 500 + jibie / 3 + random(jibie / 5));
  set_skill("sword", 500 + jibie / 3 + random(jibie / 5));
  set_skill("tianmo-shengong", 500 + jibie / 3 + random(jibie / 5));
  set_skill("wuxue-shenfa", 500 + jibie / 3 + random(jibie / 5));
  set_skill("tianmo-quan", 500 + jibie / 3 + random(jibie / 5));
  set_skill("tianmo-jian", 500 + jibie / 3 + random(jibie / 5));
  map_skill("force", "tianmo-shengong");
  map_skill("dodge", "wuxue-shenfa");
  map_skill("parry", "tianmo-jian");
  map_skill("unarmed", "tianmo-quan");
  map_skill("sword", "tianmo-jian");
  create_family("日月神教", 5, "弟子 天香堂长老");
  set("chat_chance", 3);
  set("chat_msg", ({
    "桑三娘叹道: “教主已经很久没出来了，杨莲亭越来越不像话。”\n"
  }));
  setup();
  carry_object("/clone/weapon/changjian")->wield();
  carry_object("clone/cloth/cloth")->wear();

}

void attempt_apprentice(object ob) {

  if ((int)ob->query("shen") > 100000 || (int)ob->query("shen") < -100000) {
    command("say 我黑木崖与世隔绝，向来不与您这种成名人物打交道，您请回吧！;\n");
    return;
  }
  command("nod");
  command("say 很好，很好，望你能将我日月神教发扬光大！。\n");
  command("recruit " + ob->query("id"));
}
