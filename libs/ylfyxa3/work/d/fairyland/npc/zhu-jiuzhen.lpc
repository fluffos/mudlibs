// zhu-jiuzhen.c 朱九真

#include <ansi.h>
inherit NPC;

void create() {
  int jibie;
  jibie = 500;
  set("xyzx_sys/level", jibie);  //2016.5.22阿飞调整NPC属性
  set_name("朱九真", ({ "zhu jiuzhen", "zhu" }));
  set("long", "她长得极美，容貌娇媚，又白又腻。\n");
  set("title", HIW "雪岭双姝" NOR);
  set("gender", "女性");
  set("age", 17);
  set("per", 27);
  set("unique", 1);
  set_skill("unarmed", 500 + jibie / 3 + random(jibie / 5));
  set_skill("force", 500 + jibie / 3 + random(jibie / 5));
  set_skill("dodge", 500 + jibie / 3 + random(jibie / 5));
  set_skill("parry", 500 + jibie / 3 + random(jibie / 5));
  set_temp("apply/attack", 25);
  set_temp("apply/defense", 25);
  set_temp("apply/damage", 5);

  set("combat_exp", 25000);
  set("shen_type", 1);
  setup();
  carry_object("/clone/cloth/baihu-qiu")->wear();
  carry_object("/clone/cloth/necklace")->wear();
}
