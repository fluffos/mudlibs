// Room: /d/taishan/.c
// Date: CSWORD 96/03/25
inherit ROOM;
void create() {
  set("short", "西天门");
  set("long", @LONG
这里有两块巨石壁立，有如给人斩削过似的，正是岱顶的西面出口。
极目远眺，似乎有一条山麓横卧在云雾之中，不时的有霞光闪烁，
似有宝物出世。只需轻轻一跃(jump down)......
LONG
  );
  set("exits", ([
    "southdown": __DIR__ "yueguan",
  ]));
  set("outdoors", "taishan");
  setup();
}




void init() {
  add_action("do_jump", "jump");
}


int do_jump(string arg) {

  object who = this_player();

  if (!arg || arg == "") return 0;
  if (arg != "down")
    return notify_fail("你想要跳崖自杀？这么想不开啊？\n");

  if (who->query("family/family_name") == "泰山派" && (int)who->query_skill(
    "taishan-jianfa",
    1
  ) > 2000 && (int)who->query_skill(
    "dodge",
    1
  ) > 2000 && (int)who->query("xyzx_sys/level") > 2000) {
    message_vision("$N浑身颤抖着，向前一跃……\n", who);
    message_vision("$N从悬崖上跳了下来，双手乱抓，总算是抓到一根藤蔓，差一点吓死。\n", who);
    who->unconcious();
    who->move("/d/taishan/baozang");
  } else {
    message(
      "rumor",
      HIR "【谣言四起】某人：" HIW "听说" + who->query("name") + "万念俱灰，纵身跳入了悬崖之中。。。。\n" NOR,
      users()
    );
    who->die();
    return 1;
  }

  return 1;
}
