// Room: /d/taishan/.c
// Date: CSWORD 96/03/25
inherit ROOM;
void create() {
  set("short", "试心石");
  set("long", @LONG
    这里便是莲花峰的峰顶，由两块巨石勾连在一起，据说若果你
心存诚意，登上试心石时石快便不会动摇，反之则摇动不止。
    八部龙女曾在此祭拜天地，演绎仙家舞蹈(jianwu)，光影交错，
由于此石具备映照人心的作用，故能烙印部分仙家舞姿。
LONG
  );
  set("exits", ([
    "southdown": __DIR__ "lianhua",
  ]));
  set("outdoors", "taishan");
  setup();
}


//第2处解密
void init() {
  add_action("do_jianwu", "jianwu");
}

int do_jianwu(string arg) {
  object me = this_player();
  int ap;

  string *poem = ({
    "这道剑痕，似乎是「" HIM "阿修罗灭世" NOR "」，为什么会有这么大威力？",
    "这道剑痕，似乎是八部龙女剑其中一招「" HIG "龙女成佛" NOR "」所造成的，似乎又有些不同。",
    "这道剑痕，「" HIB "夜叉渡佛" NOR "」为什么.....？？难道因为某种内功？？？？？？",
    "这道剑痕「" HIY "天王朝圣" NOR "」，怎样逆天的内力，如此可怕....",
    "「" HIB "迦楼罗飞天" NOR "」么？？？？似乎又有些不同。为什么？",
  });

  if (me->is_busy())
    return notify_fail("你现在忙着呢，哪有功夫舞剑哦.....\n");

  if ((int)me->query_skill("literate", 1) < 2000)
    return notify_fail("你按照试心石的剑痕起舞，一脸茫然，脑袋一片浆糊，始终无法领悟。\n");

  if ((int)me->query_skill("taishan-jianfa", 1) < 2000)
    return notify_fail("你按照试心石的剑痕起舞，或许本门剑法太低，完全不得要领。\n");

  if (me->query("family/family_name") != "泰山派")
    return notify_fail("你看了试心石的剑痕，这似乎是某个门派高手舞剑时留下的，到底是哪个门派呢？？？\n");

  //	if (me->query_skill("zixia-shengong",1) < 2000)
  //        return notify_fail("似乎......内功......也许.......紫气......\n"); 

  if (me->query("neili") < 1000)
    return notify_fail("你累的不轻，还是先休息一会儿吧。\n");

  if (me->query_skill("babulongnv-jian", 1) >= 1)
    return notify_fail("你已经完全领悟了八部龙女剑了，没必要再舞剑了。\n");

  if (me->query("jm/babu"))
    return notify_fail("你已经完全领悟八部龙女剑的精髓。\n");

  if (me->query("jm_babu/taishan"))
    return notify_fail("你领悟了八部龙女留在泰山的精髓，不需要在这领悟了，去其他地方看看。\n");


  ap = me->query("per", 1) + me->query("kar", 1);
  message_vision("$N仔细的研究着试心石的剑痕：" + poem[random(sizeof(poem))] + "\n", me);
  me->add("neili", -100);
  tell_object(me, HIW "你仔细研究了试心石上的剑痕，尝试着练习了下......\n" NOR);
  me->improve_skill("literate", 50 + random(10));
  //	me->improve_skill("taishan-jianfa", 50+random(10));
  me->start_busy(1);

  if (random(100000) < ap) {
    me->set("jm_babu/taishan", 1);
    tell_object(me, HIG "你突然醒悟道：" HIY "原来八部龙女剑可以有此等威力" HIR "！\n" NOR);
    tell_object(me, HIG "你对八部龙女剑的精髓有所领悟\n" NOR);
  }
  return 1;
}
