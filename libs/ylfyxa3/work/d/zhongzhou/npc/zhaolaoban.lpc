inherit NPC;
inherit F_DEALER;

void create() {
  int jibie;
  jibie = 100;
  set("xyzx_sys/level", jibie * 8 / 10 + random(jibie * 4 / 10));  //2016.5.22阿飞调整NPC属性
  set_name("赵德言", ({ "zhao deyan", "zhao", "deyan" }));
  set("title", "杂货铺老板");
  set("shen_type", 1);

  set("gender", "男性");
  set("age", 45);
  set("long", "赵德言是土生土长的中州人，做了几十年的小买卖。\n");
  set_skill("unarmed", 50);
  set_skill("dodge", 50);
  set_temp("apply/damage", 15);

  set("combat_exp", 40000);
  set("attitude", "friendly");
  set("vendor_goods", ({
    "/d/xingxiu/obj/fire",
    "/d/zhongzhou/obj/cuttonp",
    "/d/zhongzhou/obj/chanhs",
    "/d/zhongzhou/obj/wood",
    "/d/zhongzhou/obj/shoeshine",
    "/d/zhongzhou/obj/brush",
  }));

  setup();
  carry_object("/clone/cloth/cloth")->wear();
}

void init() {
  add_action("do_list", "list");
  add_action("do_buy", "buy");
}
