inherit NPC;

void create() {
  int jibie;
  jibie = 5;
  set("xyzx_sys/level", jibie * 8 / 10 + random(jibie * 4 / 10));  //2016.5.22阿飞调整NPC属性
  set_name("弃婴", ({ "qi ying", "qi", "ying", "baby" }));
  set("gender", "男性");
  set("age", 3);
  set("long", "不知是谁家小姐的私生子，不要了丢在街上。\n");
  set("combat_exp", 0);
  set("attitude", "friendly");
  setup();
}
