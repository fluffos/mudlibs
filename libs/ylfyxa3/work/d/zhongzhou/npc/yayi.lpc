inherit NPC;

void create() {
  int jibie;
  jibie = 100;
  set("xyzx_sys/level", jibie * 8 / 10 + random(jibie * 4 / 10));  //2016.5.22阿飞调整NPC属性
  set_name("衙役", ({ "ya yi", "ya" }));
  set("gender", "男性");
  set("age", 25);
  set("long", "一个高大威猛的汉子，因为久在官府做事，脸\n"
    "上已经磨炼得毫无表情。\n");
  set("combat_exp", 7500);
  set("shen_type", 1);
  set_skill("unarmed", 30);
  set_skill("dodge", 30);

  setup();
  carry_object("/clone/cloth/yayifu")->wear();
}
