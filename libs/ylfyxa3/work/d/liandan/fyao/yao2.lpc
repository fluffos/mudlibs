inherit ITEM;

mapping *ansi = ({
  ([ "yanse": HIC ]),
  ([ "yanse": HIG ]),
  ([ "yanse": HIR ]),
  ([ "yanse": HIB ]),
  ([ "yanse": HIM, ]),
  ([ "yanse": HIY, ]),
  ([ "yanse": RED, ]),
  ([ "yanse": YEL, ]),
  ([ "yanse": MAG, ]),
  ([ "yanse": CYN, ]),
});

mapping *yao = ({
  ([ "name": "当归",
    "id": "dang gui",
    "shoubi": 3,
    "random": 11,
    "tui": 22,
  ]),
  ([ "name": "川椒",
