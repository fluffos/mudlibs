    "random": 18,
    "all": 11,
    "tui": 21,
  ]),
  ([ "name": "泽兰",
    "id": "ze lan",
    "shoubi": 5,
    "random": 12,
    "all": 17,
    "tui": 24,
  ]),
  ([ "name": "玉竹",
    "id": "yu zhu",
    "shoubi": 5,
    "random": 13,
    "all": 25,
    "tui": 15,
  ]),
  ([ "name": "无名异",
    "id": "wuming yi",
    "shoubi": 6,
