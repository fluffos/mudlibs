  ]),

});

void create() {
  string name, id;
  int shoubi, tui, all, yaoo, yanse, all2;

  yanse = random(sizeof(ansi));
  yaoo = random(sizeof(yao));
  name = yao[yaoo]["name"];
  id = yao[yaoo]["id"];
  shoubi = yao[yaoo]["shoubi"];
  tui = yao[yaoo]["tui"];
  all = yao[yaoo]["all"];
  all2 = yao[yaoo]["random"];

  set_name(ansi[yanse]["yanse"] + name + NOR, ({ id }));
  set_weight(100);
  set("unit", "个");
  set("shoubi", shoubi);
  set("all", all);
  set("tui", tui);
  set("yao", 1);
  set("random", all2);
  setup();
}
