inherit NPC;

void create() {
  int jibie;
  jibie = 3000;
  set("xyzx_sys/level", jibie * 8 / 10 + random(jibie * 4 / 10));  //2016.5.22阿飞调整NPC属性
  set_name("守柱巨龙", ({ "dragon", "long" }));
  set("title", HIB "李龙的飞天坐骑" + NOR);
  set("race", "野兽");
  set("age", 999);
  set("attitude", "aggressive");
  set("str", 40);
  set("int", 25);
  set("con", 40);
  set("cor", 40);

  set("end_boss", 1);
  set("no_suck", 1);

  set("max_qi", 5000000);
  set("max_jing", 5000000);
  set("neili", 15000000);
  set("jingli", 15000000);
  set("max_neili", 3000);
  set("max_jingli", 3000);
  set("jiali", 3000);
  set("combat_exp", 2100000000);
  set("limbs", ({ "头部", "身体", "前爪", "尾巴", "肚皮", "后爪" }));
  set("verbs", ({ "bite", "claw" }));

  set_temp("apply/attack", 900);
  set_temp("apply/damage", 900);
  set_temp("apply/armor", 900);
  set_temp("apply/defence", 900);
  set_skill("dodge", 500 + jibie / 3 + random(jibie / 5));
  set_skill("unarmed", 500 + jibie / 3 + random(jibie / 5));
  set_skill("dragon", 500 + jibie / 3 + random(jibie / 5));
  set_skill("spells", 500 + jibie / 3 + random(jibie / 5));

  map_skill("unarmed", "dragon");
  map_skill("dodge", "dragon");
  prepare_skill("unarmed", "dragon");

  setup();
}
