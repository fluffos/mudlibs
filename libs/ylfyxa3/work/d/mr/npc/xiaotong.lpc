inherit NPC;
void create() {
  int jibie;
  jibie = 100;
  set("xyzx_sys/level", jibie * 8 / 10 + random(jibie * 4 / 10));  //2016.5.22闃块璋冩暣NPC灞炴
  set_name("小童", ({ "xiao tong", "tong" }));
  set("gender", "男性");
  set("age", 14);
  set("str", 15);
  set("int", 26);
  set("con", 26);
  set("dex", 26);
  set("combat_exp", 100);
  set("shen_type", 0);
  set("attitude", "peaceful");
  set("max_qi", 400);
  set("max_jing", 1000);

  set_temp("apply/attack", 10);
  set_temp("apply/defense", 10);

  setup();
  carry_object("clone/cloth/cloth")->wear();

}
