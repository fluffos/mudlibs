// 地图源文件

#define SHORT_NAME "眠龙洞"
#define LONG_NAME "这里就是眠龙洞尽头，岩浆似乎冷却下来，周围有一些黄褐色岩石。\n左边的岩石上有些从来见过的植物（zhiwu），一个庞然大物正蹲在路中央，口中散发着阵阵火焰.....\n"

inherit ROOM;

void create() {
  set("outdoors", "automap6");
  set("short", SHORT_NAME);
  set("long", LONG_NAME);
  set("exits", ([
    "east": __DIR__ "fuben" + (1 + random(100)),
    "west": __DIR__ "fuben" + (1 + random(100)),
    "south": __DIR__ "fuben" + (1 + random(100)),
    "north": __DIR__ "fuben" + (1 + random(100)),
  ]));
  set("item_desc", ([
    "zhiwu": "有点象海棠的植物，可以摘(pick)下来看看。\n"
  ]));
  set("objects", ([
    "/d/automap6/npc/guai6": 1,
  ]));
  set("no_clean_up", 0);
  set("caocount", 1);
  setup();
}

void init() {
  add_action("do_pick", "pick");
}

int do_pick(string arg) {
  object me = this_player();
  object obn;
  if (!arg || arg != "zhiwu") {
    write("你要拿什么呀!\n");
    return 1;
  }
  message_vision("$N在岩石前站定，深呼一口气，突然跃起。\n", this_player());
  if (query("caocount") > 0) {
    message_vision("$N伸手一摘，手中多了一物。\n", this_player());
    obn = new("/d/automap6/obj/haitang");
    obn->move(me);
    add("caocount", -1);
    me->set_temp("steal/haitang", 1);
  } else
    message_vision("$N定睛一看，发现植物以被人拿走了。\n", this_player());
  return 1;
}

int valid_leave(object me, string dir) {
  mapping exits;
  string file_name;
  object ob;

  ob = this_object();
  exits = this_object()->query("exits");

  if (mapp(exits) && sizeof(exits)) {
    if (!stringp(file_name = exits[dir]))
      return notify_fail("地图连接错误，请用 sos 通知管理员修改。\n");
    if (strlen(file_name) < 10)
      return notify_fail("连接的区域不正确，请用 sos 通知管理员修改。\n");
    if (!playerp(me) && base_name(this_object())[0..9] != file_name[0..9])
      return 0;
  }

  if (dir && objectp(ob) && me->query_temp("steal/haitang"))
    return notify_fail(HIY "千年火龙王" NOR "喝道：“敢盗取我的宝物，给我乖乖的留下吧！！！\n");

  return ::valid_leave(me, dir);
}
