//      chanshi.c 禅室
//      Designed by secret (秘密)
//      97/04/09
inherit ROOM;
void create() {
  set("short", "禅室");
  set("long", @LONG
这里是僧人门参禅打坐的地方，据说可以领悟雪山寺的终极奥义（canchan）。
LONG
  );
  set("no_fight", 1);
  set("sleep_room", 1);
  set("no_steal", 1);
  set("exits", ([
    "southwest": __DIR__ "dating",
  ]));
  setup();
}


void init() {
  add_action("do_canchan", "canchan");
}

int do_canchan(string arg) {
  object me = this_player();
  int ap;

  string *poem = ({
    "这道掌痕，似乎是「" HIM "火焰刀" NOR "」，为什么似刀非刀，似掌非掌，居然有这么大威力？",
    "这道刀痕，似乎是火焰刀其中一招「" HIG "刀山火海" NOR "」所造成的，似乎又有些不同。",
    "这道残痕，「" HIB "大圆满光明式" NOR "」为什么.....？？难道因为某种内功？？？？？？",
    "这道割痕「" HIY "日月轮" NOR "」，怎样逆天的内力，如此可怕....",
    "「" HIB "佛轮转" NOR "」么？？？？似乎又有些不同。为什么？",
  });

  if (me->is_busy())
    return notify_fail("你现在忙着呢，哪有功夫看墙上的东西...\n");
  if ((int)me->query_skill("longxiang", 1) < 1000 && (int)me->query_skill("xiaowuxiang", 1) < 1000)
    return notify_fail("你看了墙上的刀痕，似乎。。。。内功。。。。\n");
  if ((int)me->query_skill("mizong-xinfa", 1) < 1000)
    return notify_fail("你默运心法，对密宗教义不是很了解。\n");
  if ((int)me->query_skill("huoyan-dao", 1) < 2000)
    return notify_fail("你运聚内力与掌缘，然而一丝火焰都没有。\n");
  if ((int)me->query_skill("riyue-lun", 1) < 2000)
    return notify_fail("你将五轮耍的飞起，可惜手忙脚乱。\n");
  if (me->query("family/family_name") != "雪山寺")
    return notify_fail("这是雪山寺禅室，你如何进来的！\n");
  if (!me->query_temp("jm_xueshan6"))
    return notify_fail("你未得到法王传授日月轮的精髓，恐怕难以领悟！\n");
  if (!me->query_temp("jm_xueshan4"))
    return notify_fail("你未得到明王传授火焰刀的精髓，恐怕难以领悟！\n");
  if (me->query("jm/xueshan"))
    return notify_fail("你已经参悟了雪山寺的奥义了，再参悟下去也没什么用！\n");
  ap = me->query_skill("literate", 1) / 100;

  if (me->query("jing") < 1000) {
    tell_object(me, "你还是先休息一会儿吧。\n");
    return 1;
  }
  tell_object(me, HIW "你凝神静气参悟密宗禅经，尝试着练习了下......\n" NOR);
  message_vision("$N仔细的研究着墙上的伤痕：" + poem[random(sizeof(poem))] + "\n", me);
  me->add("jing", -1000);
  me->start_busy(1);
  if (me->query("jm/xueshan")) {
    tell_object(me, "你已经完全领悟了雪山寺的精髓，不需要在这领悟了。\n");
    return 1;
  }
  if (random(100000) < me->query("kar", 1) + ap) {
    me->set("jm/xueshan", 1);
    me->add("family_score", 1);
    tell_object(me, HIY "你突然醒悟道：" HIY "原来雪山寺的秘密是这样的" HIR "！\n" NOR);
    tell_object(me, HIY "恭喜你融汇贯通了雪山寺武功的精髓！\n" NOR);
    message(
      "channel:chat",
      HIM "【天降奇才】" HIM + "听说" + me->query("name") + "天纵奇才，在雪山寺禅室居然领悟了雪山寺的终极奥义！\n" NOR,
      users()
    );
  }
  return 1;
}
