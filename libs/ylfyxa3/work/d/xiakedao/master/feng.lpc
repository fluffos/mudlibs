// feng.c 风清扬

inherit NPC;
inherit F_MASTER;

void create() {
  int jibie;
  jibie = 5000;
  set("xyzx_sys/level", jibie);  //2016.5.22阿飞调整NPC属性
  set_name("风清扬", ({ "feng-qingyang", "feng", "qingyang" }));
  set("title", "华山第十二代剑宗长老");
  set("long",
    "这便是当年名震江湖的华山名宿风清扬。他身著青袍，神气抑郁脸如金纸。
身材瘦长，眉宇间一直笼罩着一股淡淡的忧伤神色，显然对当年的剑宗气宗
之争一直难以忘怀。\n");
  set("gender", "男性");
  set("age", 68);
  set("attitude", "peaceful");
  set("shen_type", 1);
  set("str", 30);
  set("int", 40);
  set("con", 30);
  set("dex", 30);

  set("qi", 4800);
  set("max_qi", 4800);
  set("jing", 3600);
  set("max_jing", 3600);
  set("neili", 4400);
  set("max_neili", 4400);
  set("jiali", 200);

  set("combat_exp", 1750000);
  set("score", 200000);

  set_skill("cuff", 500 + jibie / 3 + random(jibie / 5));
  set_skill("force", 500 + jibie / 3 + random(jibie / 5));
  set_skill("blade", 500 + jibie / 3 + random(jibie / 5));
  set_skill("dodge", 500 + jibie / 3 + random(jibie / 5));
  set_skill("parry", 500 + jibie / 3 + random(jibie / 5));
  set_skill("sword", 500 + jibie / 3 + random(jibie / 5));
  set_skill("strike", 500 + jibie / 3 + random(jibie / 5));
  set_skill("zixia-shengong", 500 + jibie / 3 + random(jibie / 5));
  set_skill("poyu-quan", 500 + jibie / 3 + random(jibie / 5));
  set_skill("fanliangyi-dao", 500 + jibie / 3 + random(jibie / 5));
  set_skill("huashan-jianfa", 500 + jibie / 3 + random(jibie / 5));
  set_skill("hunyuan-zhang", 500 + jibie / 3 + random(jibie / 5));
  set_skill("dugu-jiujian", 500 + jibie / 3 + random(jibie / 5));
  set_skill("feiyan-huixiang", 500 + jibie / 3 + random(jibie / 5));
  set_skill("literate", 500 + jibie / 3 + random(jibie / 5));

  map_skill("cuff", "poyu-quan");
  map_skill("force", "zixia-shengong");
  map_skill("dodge", "feiyan-huixiang");
  map_skill("parry", "dugu-jiujian");
  map_skill("sword", "dugu-jiujian");
  map_skill("blade", "fanliangyi-dao");
  map_skill("strike", "hunyuan-zhang");

  //	create_family("华山派", 12, "弟子");



  setup();
  carry_object("/clone/cloth/cloth")->wear();
  carry_object("/clone/weapon/changjian")->wield();
}

void init() {
  object ob;

  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 2, ob);
  }
}

void greeting(object ob) {
  object *obj, me = this_object();
  int i;

  obj = all_inventory(environment(me));
  command("say 非也，非也，这招应该剑意曲而剑势直。");
  for (i = 0; i < sizeof(obj); i++) {
    if (obj[i]->query("id") == "zhang-sanfeng") {
      COMBAT_D->do_attack(me, obj[i], me->query_temp("weapon"), 0);
      COMBAT_D->do_attack(me, obj[i], me->query_temp("weapon"), 0);
    }
  }
  return;
}
