//wuchangdan.c
#include <ansi.h>

inherit ITEM;

void init() {
  add_action("do_eat", "eat");
}

void create() {
  set_name(HIC "散功丹" NOR, ({ "sangong dan", "dan" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "颗");
    set("long", "这是一颗幽蓝色的散功丹丹，一看就是害人之物!\n");
    set("value", 10000000);
  }
  setup();
}

int do_eat(string arg) {
  object me = this_player();

  if (!id(arg))
    return notify_fail("你要吃什么？\n");
  /*if (me->query("age") > 14)
		return notify_fail("这么大了还想吃这个不好吧？\n");*/
  if (me->query("max_neili") < 11000)
    message_vision(HIR "$N吃下一颗散功丹半天没有反应，似乎没有起到任何作用。\n" NOR, me);
  else {
    me->add("max_neili", -10000);
    message_vision(HIR "$N吃下一颗散功丹，顿时全身内力大损！\n" NOR, me);
  }
  destruct(this_object());
  return 1;
}
