#define MAX_GOODS       1
void create_goods() {
  int ran, n, i, lvl, price;
  string name, tmp;
  string *names;
  object obj;
  names = keys(goods);
  n = sizeof(goods);
  for (i = 0; i < MAX_GOODS; i++) {
    ran = random(n);
    name = names[ran];
    if (name[0..0] == "/") {
      obj = carry_object(name);
      if (!obj || !objectp(obj))
        log_file("shenmixiaofan.log", "物件" + name + "创建失败。\n");
      obj->set("sell_price", goods[name] * 10000);
    } else {
      obj = carry_object("/clone/book/randombook");
      lvl = goods[name] / 10000;
      ran = random(3);
      if (ran == 1)  //上篇
      {
        obj->set("skill/max_skill", lvl / 3);
        tmp = "上篇";
        price = goods[name] % 10000 / 3 * 10000;
      } else if (ran == 2)   //中篇
      {
        obj->set("skill/min_skill", lvl / 3);
        obj->set("skill/max_skill", lvl * 2 / 3);
        tmp = "中篇";
        price = goods[name] % 10000 * 2 / 3 * 10000;
      } else        //下篇
      {
        obj->set("skill/min_skill", lvl * 2 / 3);
        obj->set("skill/max_skill", lvl);
        tmp = "下篇";
        price = goods[name] % 10000 * 10000;
      }
      obj->set("sell_price", price);
      obj->set("long", "一本又破又旧的琴谱，你读着读着，似乎可以从里面发现一些其它东西。\n"
        "原来是一本藏着" HIW + to_chinese(name) + tmp + NOR "的琴谱。\n");
      obj->set("skill/name", name);
      obj->set("create_time", time());
    }
  }
}
void create() {
  object *objs;
  int i;
  set_name(HIW "神秘小贩" NOR, ({ "shenmi xiaofan", "xiaofan" }));
  set("gender", "男性");
  set("age", 30);
  set("str", 10000);
  set("per", 100);
  set("dex", 100);
  set("con", 100);
  set("long", "一位穿着朴素的小商贩，整天神神秘秘的样子。\n");
  set("max_jing", 50000000);
  set("max_qi", 50000000);
  set("inquiry", ([
    "好东西": (: ask_goods :),
  ]));
  set("no_get", 1);
  set("last_update_time", time());
  set_temp("doing_baitan", 1);
  set_temp("shop_name", HIG "嘿，来瞧瞧，有好东西！" NOR);
  setup();
  carry_object("/clone/misc/cloth")->wear();
  objs = deep_inventory(this_object());
  for (i = 0; i < sizeof(objs); i++) {
    if (objectp(objs[i]) && !objs[i]->query("equipped"))
      destruct(objs[i]);
  }
  create_goods();
}

void die() {
  int i;
  object *objs;
  objs = deep_inventory(this_object());
  for (i = 0; i < sizeof(objs); i++)
    destruct(objs[i]);
  ::die();
}

void unconcious() {
  int i;
  object *objs;
  objs = deep_inventory(this_object());
  for (i = 0; i < sizeof(objs); i++)
    destruct(objs[i]);
  ::unconcious();
}

int ask_goods() {
  int i, total;
  object *objs;
  object me = this_player();
  object xiaofan = this_object();
  string tmp;
  if (!wizardp(me)) {
    tell_object(me, "神秘小贩的功能已被巫师查封。\n");
    return 1;
  }
  if (me->query_temp("xiaofan_ask_goods")) {
    tell_object(me, "你这人烦不烦，老来问，自己看不就行了。\n");
    return 1;
  }
  message_vision(HIW "$N神色慌张地左右看了看，然后把$n拉到边上。\n", xiaofan, me);
  xiaofan->command(sprintf("whisper %s 嘿嘿，找我算找对人了。\n", me->query("id")));
  me->set_temp("xiaofan_ask_goods", 1);
  objs = deep_inventory(xiaofan);
  tmp = "";
  total = 0;
  for (i = 0; i < sizeof(objs); i++) {
    if (objs[i]->query("equipped"))
      continue;
    total++;
    tmp += sprintf("    %s(%s)\n", objs[i]->query("name"), objs[i]->query("id"));
  }
  if (total == 0) {
    tell_object(me, HIW "小贩小声跟你说：不过！真不好意思，本来是有几件好东西的，但刚刚被人买走了，下次吧。\n" NOR);
  } else {
    tell_object(me, HIW "小贩小声对你说：我现在还真有几个好东西，你瞧瞧\n" NOR);
    tell_object(me, tmp);
  }
  return 1;
}
