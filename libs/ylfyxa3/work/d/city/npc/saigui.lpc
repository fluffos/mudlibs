inherit NPC;

int random2(int i) {
  return (random(i) + uptime()) % i;
}

void create() {
  int jibie;
  jibie = 10;
  set("xyzx_sys/level", jibie * 8 / 10 + random(jibie * 4 / 10));  //2016.5.22阿飞调整NPC属性	
  set_name("赛龟", ({ "sai gui", "gui" }));
  set("race", "野兽");
  set("gender", "雄性");
  set("age", 2);
  set("long", "一只慢腾腾的赛龟。\n");
  set("attitude", "friendly");
  set("str", 20 + random2(2));
  set("int", 20 + random2(2));

  set("dex", 20);

  set("per", 20);
  set("limbs", ({ "头部", "爪子", "尾巴" }));
  set("verbs", ({ "bite" }));

  setup();
}
