// zhuziliu.c

#include <ansi.h>
inherit NPC;
void create() {
  int jibie;
  jibie = 1000;
  set("xyzx_sys/level", jibie);  //2016.5.22阿飞调整NPC属性	
  set_name("朱子柳", ({ "zhu ziliu", "zhu", "ziliu" }));
  set("gender", "男性");
  set("age", 55);
  set("long", "一灯大师的四大弟子之一。\n");
  set("attitude", "peaceful");

  set("per", 17);
  set("str", 40);
  set("int", 20);
  set("con", 30);
  set("dex", 25);

  set("qi", 3500);
  set("max_qi", 3500);
  set("eff_jingli", 4000);
  set("max_jing", 3500);
  set("neili", 45000);
  set("max_neili", 4500);
  set("inquiry", ([
    //                   "守城": (:give_job:),	
    //                   "完成": (:task_ok:),	
  ]));

  set("combat_exp", 9000000);
  set_skill("force", 500 + jibie / 3 + random(jibie / 5));
  set_skill("yiyang-zhi", 500 + jibie / 3 + random(jibie / 5));
  set_skill("jinyu-quan", 500 + jibie / 3 + random(jibie / 5));
  set_skill("dodge", 500 + jibie / 3 + random(jibie / 5));
  set_skill("parry", 500 + jibie / 3 + random(jibie / 5));
  set_skill("unarmed", 500 + jibie / 3 + random(jibie / 5));
  set_skill("kumu-shengong", 500 + jibie / 3 + random(jibie / 5));

  map_skill("unarmed", "yiyang-zhi");
  map_skill("parry", "yiyang-zhi");
  map_skill("force", "kumu-shengong");
  reincarnate();
  setup();
  carry_object("clone/weapon/gangjian")->wield();
  carry_object("clone/armor/tiejia")->wear();

}
