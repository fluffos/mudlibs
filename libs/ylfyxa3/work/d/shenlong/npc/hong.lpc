void attempt_apprentice(object ob) {
  if ((int)ob->query("xyzx_sys/level") < 500) {
    message_vision("洪安通对$N笑道：你这点本事加入我教还不够敌人塞牙缝的！\n", ob);
    return;
  }
  if ((int)ob->query("str", 1) < 30) {
    message_vision("洪安通对$N笑道：这位" + RANK_D->query_respect(ob) + "长得太清瘦了，以你的资质恐怕难以学得我教神功！\n", ob);
    return;
  }
  if (!ob->query("shenlongjiao")) {
    message_vision("洪安通望着你充满疑惑，你不是我教弟子，是不是满清派来的奸细！\n", ob);
    return;
  }
  if ((int)ob->query_skill("shenlong-xinfa", 1) < 500) {
    message_vision("洪安通对$N笑道：我教最基础的内功心法你都没掌握，还是先去打好基础再来吧！\n", ob);
    return;
  }
  if (!ob->query_temp("pending/flatter")) {
    command("say 我洪安通比起古往今来的圣人怎么样啊？");
    message_vision("洪安通微闭双眼，手捻长须，一付等人拍马(flatter)的样子。\n", this_player());
    //		ob->set_temp("pending/flatter", 0);
    return;
  }
  message_vision("洪安通拍拍$N的头，微微点了点头，看你骨骼清奇，就收下你吧。\n", ob);
  command("recruit " + ob->query("id"));
  return;
}
/*
