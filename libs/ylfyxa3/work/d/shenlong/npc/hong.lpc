{
	return 0;
}
*/
int ask_kangqing() {
  object me, ob;
  me = this_player();
  ob = this_object();

  if ((string)me->query("family/family_name") == "神龙教" && me->query_temp("jm_shenlong2") && me->query_temp("jm_shenlong3") && me->query_temp("jm_shenlong4")) {
    message_vision(HIB "洪安通说道：这位" + RANK_D->query_respect(me) + "为我教铲除叛逆，可表忠心。\n" NOR, me);
    message_vision(HIC "洪安通仰天大笑：这天地会多次坏我好事，总算报应不爽” \n" NOR, me);
    message_vision(
      HIW "洪安通说道：这位" + RANK_D->query_respect(me) + "为我神龙教立下大功，可去神龙岛内屋看看，或许能领悟到什么。” \n" NOR,
      me
    );
    me->set_temp("jm_shenlong5", 1);
  } else if ((string)me->query("family/family_name") == "神龙教") {
    message_vision(HIB "洪安通说道：天地会的前后两位总舵主多次派门下弟子与我教作对，忍无可忍！！！\n"
      + "这位" + RANK_D->query_respect(me) + "若能替我铲除天地会，我必有厚报。\n" NOR, me);
    message_vision(YEL "洪安通冷哼一声：我教赤龙使奉我之命潜伏皇宫，久未有消息传回......\n", me);
    me->set_temp("jm_shenlong1", 1);
  } else {
    message_vision(HIB "洪安通说道：这位" + RANK_D->query_respect(me) + "不是我教中人。\n" NOR, me);
  }

  return 1;
}
