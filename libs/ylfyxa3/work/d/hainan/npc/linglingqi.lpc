//叶孤城
#include <ansi.h>
inherit NPC;

void create() {
  int jibie;
  jibie = 500;
  //	set("xyzx_sys/level", jibie*8/10+random(jibie*4/10));	//2016.5.22阿飞调整NPC属性	
  set("xyzx_sys/level", jibie);  //2017.9.1阿飞调整NPC等级为固定值，取消20%的浮动设定	
  set_name(HIB "零零柒" NOR, ({ "lingling qi" }));
  set("long", "皇家大内密探之一，紫禁之巅大战时偶然得到天外飞仙秘籍，为叶孤城记名弟子。\n");
  set("title", HIC "大内密探" NOR);
  set("gender", "男性");
  set("age", 34);
  set("attitude", "peaceful");
  set("per", 30);
  set("int", 30);
  set("max_qi", 1000000);
  set("max_jing", 1000000);
  set("max_jingli", 1000000);
  set("neili", 1000000);
  set("max_neili", 1000000);
  set("combat_exp", 20000000);

  set_skill("literate", 500 + jibie / 3 + random(jibie / 5));
  set_skill("unarmed", 500 + jibie / 3 + random(jibie / 5));
  set_skill("dodge", 500 + jibie / 3 + random(jibie / 5));
  set_skill("force", 500 + jibie / 3 + random(jibie / 5));
  set_skill("parry", 500 + jibie / 3 + random(jibie / 5));
  set_skill("sword", 500 + jibie / 3 + random(jibie / 5));
  set_skill("feixian-jian", 500 + jibie / 3 + random(jibie / 5));
  set_skill("bitao-shengong", 500 + jibie / 3 + random(jibie / 5));
  set_skill("baihua-zhang", 500 + jibie / 3 + random(jibie / 5));
  set_skill("qiongya-bufa", 500 + jibie / 3 + random(jibie / 5));
  map_skill("unarmed", "baihua-zhang");
  map_skill("force", "bitao-shengong");
  map_skill("sword", "feixian-jian");
  map_skill("parry", "feixian-jian");
  map_skill("dodge", "qiongya-bufa");

  create_family("南海派", 5, "弟子");

  setup();
  carry_object("/d/hainan/obj/shuoyi")->wear();
  carry_object("/d/hainan/obj/yuruyi")->wield();
  add_money("gold.lpc", 500);
}

void attempt_apprentice(object ob) {
  /*	if ( (int)ob->query("int",1)<25 )  
	{
        command("shake");
        command("say 以我看这位" + RANK_D->query_respect(ob) + "的资质不适合学我这一派武功.\n");
        return;
	}
	if ((int)ob->query("xyzx_sys/level")<800)
    {
        command("say 这位"+RANK_D->query_respect(ob)+"实战能力太差了，还是去江湖上历练吧。");
		return ;
    }	*/
  if (!((string)ob->query("gender") == "男性")) {
    command("shake");
    command("say 我们大内密探只收男性，这位" + RANK_D->query_respect(ob) + "还是另请高就吧。\n");
    return;
  }
  if ((int)ob->query_skill("sword", 1) < 100) {
    command("shake");
    command("say 以我看这位" + RANK_D->query_respect(ob) + "连基础剑法都不会。\n");
    return;
  }
  command("pat " + ob->query("id"));
  command("say 好，希望" + RANK_D->query_respect(ob) + "多加努力，把我们海南一派发扬光大。\n");
  command("recruit " + ob->query("id"));
  return;
}
