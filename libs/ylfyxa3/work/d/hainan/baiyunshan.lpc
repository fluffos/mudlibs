// Room: /d/hainan/baiyuncheng

inherit ROOM;

void create() {
  set("short", "白云山");
  set("long", @LONG
    白云山位于南海之宾，为九连山的支脉，常年白云缭绕，故名白云山。
山有三十二峰，于波涛汹涌之间，丹崖石柱耸立，松香阵阵。千华胜境脉
相连，路转峰回别有天。身在浮岚空翠里，尘心清绝半生仙。 
LONG);
  set("outdoors", "hainan");
  set("no_clean_up", 0);
  set("objects", ([
    __DIR__ "npc/yeqingrou.lpc": 1,
  ]));

  set("exits", ([
    "south": __DIR__ "shatan" + (1 + random(10)),
    "north": __DIR__ "baiyuncheng",
  ]));

  setup();
  replace_program(ROOM);
}
