// by victori
inherit NPC;
#include "duchong.h"
#include <ansi.h>

void create() {
  int jibie = 3000;
  set_name("三足金蟾", ({ "chan chu" }));
  set("race", "野兽");
  set("long", "一只拳头大小通身金黄的小蟾蜍，据说只有月宫才有。\n");
  set("age", 10000);
  set("attitude", "peaceful");
  set("xyzx_sys/level", jibie);  //2016.5.22阿飞调整NPC属性
  set("max_jing", 1500);
  set("max_qi", 2500);
  set("neili", 2000);
  set("max_neili", 4000);
  set("jiali", 200);

  set_skill("force", 500 + jibie * 2 + random(jibie / 5));
  set_skill("dodge", 500 + jibie * 2 + random(jibie / 5));
  set_skill("unarmed", 500 + jibie * 2 + random(jibie / 5));
  set_skill("parry", 500 + jibie * 2 + random(jibie / 5));
  set_skill("hamagong", 500 + jibie / 2 + random(jibie / 5));
  set_skill("chanchu-bufa", 500 + jibie / 2 + random(jibie / 5));
  set_skill("shexing-diaoshou", 500 + jibie / 2 + random(jibie / 5));
  map_skill("force", "hamagong");
  map_skill("dodge", "chanchu-bufa");
  map_skill("parry", "shexing-diaoshou");
  map_skill("unarmed", "shexing-diaoshou");

  set("limbs", ({ "头部", "身体", "尾巴" }));
  set("verbs", ({ "bite" }));

  set_temp("apply/attack", 200);
  set_temp("apply/defense", 200);
  set_temp("apply/armor", 200);
  add_temp("apply/damage", 100);

  set("combat_exp", 5000000 + random(100) * 100000);

  set_weight(5000);
  setup();
}
