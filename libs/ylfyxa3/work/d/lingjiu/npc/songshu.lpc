//songshu.c
inherit NPC;
void create() {
  int jibie;
  jibie = 10;
  set("xyzx_sys/level", jibie * 8 / 10 + random(jibie * 4 / 10));  //2016.5.22阿飞调整NPC属性
  set_name("松鼠", ({ "song shu", "shu" }));
  set("race", "野兽");
  set("age", 2);
  set("long", "一只可爱的松鼠。\n");
  set("attitude", "peaceful");

  set("str", 15);
  set("cor", 16);
  set("limbs", ({ "头部", "身体", "爪子", "尾巴" }));
  set("verbs", ({ "bite" }));

  set("combat_exp", 300);
  set_temp("apply/attack", 5);
  set_temp("apply/damage", 3);
  set_temp("apply/defence", 5);
  set_temp("apply/armor", 3);
  setup();
}
