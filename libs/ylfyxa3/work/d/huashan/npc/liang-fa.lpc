// liang-fa.c

inherit NPC;


void create() {
  int jibie;
  jibie = 1000;
  set("xyzx_sys/level", jibie);  //2016.5.22阿飞调整NPC属性
  set_name("梁发", ({ "liang fa", "liang", "fa" }));
  set("nickname", "闭嘴佛");
  set("gender", "男性");
  set("age", 30);
  set("long",
    "梁发是岳不群的第三弟子。\n");
  set("attitude", "peaceful");

  set("str", 26);
  set("con", 30);
  set("int", 24);
  set("dex", 30);

  set("neili", 500);
  set("max_neili", 500);

  set("combat_exp", 50000);
  set("shen_type", 1);
  set("score", 2000);

  set("chat_chance_combat", 80);
  set("chat_msg_combat", ({
    (: exert_function, "powerup" :),
    (: exert_function, "recover" :)
  }));

  set_skill("unarmed", 500 + jibie / 3 + random(jibie / 5));
  set_skill("sword", 500 + jibie / 3 + random(jibie / 5));
  set_skill("force", 500 + jibie / 3 + random(jibie / 5));
  set_skill("parry", 500 + jibie / 3 + random(jibie / 5));
  set_skill("dodge", 500 + jibie / 3 + random(jibie / 5));
  set_skill("literate", 500 + jibie / 3 + random(jibie / 5));


  set_skill("huashan-jianfa", 500 + jibie / 3 + random(jibie / 5));
  set_skill("zixia-shengong", 500 + jibie / 3 + random(jibie / 5));
  set_skill("huashan-zhangfa", 500 + jibie / 3 + random(jibie / 5));
  set_skill("feiyan-huixiang", 500 + jibie / 3 + random(jibie / 5));

  map_skill("sword", "huashan-jianfa");
  map_skill("parry", "huashan-jianfa");
  map_skill("force", "zixia-shengong");
  map_skill("unarmed", "huashan-zhangfa");
  map_skill("dodge", "feiyan-huixiang");

  create_family("华山派", 14, "弟子");
  setup();

  carry_object("/clone/weapon/changjian")->wield();
  carry_object("/clone/cloth/cloth")->wear();
}
