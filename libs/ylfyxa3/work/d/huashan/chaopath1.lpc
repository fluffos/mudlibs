// Roon: chaoyangpath1.c 朝阳峰小路
//Date: Oct. 2 1997 by Venus
inherit ROOM;

void create() {
  set("short", "朝阳峰小路");
  set("long", @LONG
这里是朝阳峰小路，山势陡峭，两边下临深谷，一不小心都会掉
了下去。此处似乎已到了尽头，但雾气迷漫处，隐隐约约的能看见
一块裂开的巨石，你试图跳过去一探究竟(jump down)......
LONG);
  set("outdoors", "xx");
  set("no_clean_up", 0);
  set("exits", ([ /* sizeof() == 1 */
    "northeast": __DIR__ "chaopath2",
    //             "southeast": __DIR__"square",	
  ]));
  setup();
  replace_program(ROOM);
}

void init() {
  add_action("do_jump", "jump");
}


int do_jump(string arg) {

  object who = this_player();
  if (!arg || arg == "") return 0;
  if (arg != "down")
    return notify_fail("你想要跳崖自杀？这么想不开啊？\n");

  if (who->query("family/family_name") == "华山派" && (int)who->query_skill(
    "huashan-jianfa",
    1
  ) > 2000 && (int)who->query_skill(
    "dodge",
    1
  ) > 2000 && (int)who->query("xyzx_sys/level") > 2000) {
    message_vision("$N浑身颤抖着，向前一跃……\n", who);
    message_vision("$N从悬崖上跳了下来，双手乱抓，总算是抓到一块尖石，差一点吓死。\n", who);
    who->unconcious();
    who->move(__DIR__ "chengxiang");
  } else {
    message(
      "rumor",
      HIR "【谣言四起】某人：" HIW "听说" + who->query("name") + "万念俱灰，纵身跳入了悬崖之中。。。。\n" NOR,
      users()
    );
    who->die();
    return 1;
  }

  return 1;
}


