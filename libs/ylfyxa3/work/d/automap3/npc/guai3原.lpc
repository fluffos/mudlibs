void create() {
  object me, obj;
  mapping skill_status;
  string *sname;
  int i, temp;
  string weapon = "null";
  int jibie;
  int k;
  jibie = 10000;
  k = random(80);
  me = this_object();

  seteuid(getuid());
  set_name(HIM "贼盗王" NOR, ({ "zeidao wang", "wang", "boss" }));
  set("title", HIC "绿林霸主" NOR);
  set("gender", "男性");
  set("icon", "30005");
  set("age", random(30) + 20);
  set("long", "迷雾森林的贼盗首领，有着一身不凡的武艺，穷凶恶极手下罕有十合之将。\n");
  set("attitude", "aggressive");
  set("class", "lvlin");
  set("no_suck", 1);
  //	set("no_zhineng", 1);
  //	set("end_boss", 1);
  set("env/wimpy", 40);
  set("shen_type", 0);
  set("xyzx_sys/level", jibie * 8 / 10 + random(jibie * 4 / 10));  //2016.5.22阿飞调整NPC属性	
  create_family("绿林暴风盟", 3, "首领");
  set("chat_chance", 15);
  set("chat_msg", ({
    (: random_move :)
  }));

  if (mapp(skill_status = me->query_skills())) {
    obj = me->query_temp("weapon");
    skill_status = me->query_skills();
    sname = keys(skill_status);
    temp = sizeof(skill_status);
    for (i = 0; i < temp; i++) {
      me->delete_skill(sname[i]);
    }
    destruct(obj);
  }

  set_skill("force", 500 + jibie * 2 + random(jibie / 5));
  set_skill("unarmed", 500 + jibie * 2 + random(jibie / 5));
  set_skill("dodge", 500 + jibie * 2 + random(jibie / 5));
  set_skill("parry", 500 + jibie * 2 + random(jibie / 5));
  if (k == 0) {  //白驼山
    set_skill("hamagong", 500 + jibie / 2 + random(jibie / 5));
    set_skill("shexing-diaoshou", 500 + jibie / 2 + random(jibie / 5));
    set_skill("chanchu-bufa", 500 + jibie / 2 + random(jibie / 5));
    set_skill("lingshe-zhangfa", 500 + jibie / 2 + random(jibie / 5));
    set_skill("staff", 500 + jibie * 2 + random(jibie / 5));
    map_skill("force", "hamagong");
    map_skill("unarmed", "shexing-diaoshou");
    map_skill("parry", "lingshe-zhangfa");
    map_skill("staff", "lingshe-zhangfa");
    map_skill("dodge", "chanchu-bufa");
    weapon = "/clone/weapon/hanbing-zhang";
  } else if (k == 1) {  //痴心门
