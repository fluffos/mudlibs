    map_skill("force", "biyun-xinfa");
    map_skill("dodge", "qiulinshiye");
    map_skill("parry", "zimu-zhen");
    map_skill("unarmed", "biye-wu");
    map_skill("throwing", "zimu-zhen");
    weapon = "/clone/weapon/hanbing-shi";
  } else if (k == 78) {  //唐门
    set_skill("biyun-xinfa", 500 + jibie / 2 + random(jibie / 5));
    set_skill("zhuihun-biao", 500 + jibie / 2 + random(jibie / 5));
    set_skill("biye-wu", 500 + jibie / 2 + random(jibie / 5));
    set_skill("qiulinshiye", 500 + jibie / 2 + random(jibie / 5));
    set_skill("throwing", 500 + jibie * 2 + random(jibie / 5));
    map_skill("force", "biyun-xinfa");
    map_skill("dodge", "qiulinshiye");
    map_skill("parry", "biye-wu");
    map_skill("unarmed", "biye-wu");
    map_skill("throwing", "zhuihun-biao");
    weapon = "/clone/weapon/hanbing-shi";
  } else if (k == 79) {  //金蛇系
    set_skill("taixuan-gong", 500 + jibie / 2 + random(jibie / 5));
    set_skill("jinshe-zhui", 500 + jibie / 2 + random(jibie / 5));
    set_skill("shenxing-baibian", 500 + jibie / 2 + random(jibie / 5));
    set_skill("jinshe-zhang", 500 + jibie / 2 + random(jibie / 5));
    set_skill("throwing", 500 + jibie * 2 + random(jibie / 5));
    map_skill("force", "taixuan-gong");
    map_skill("dodge", "shenxing-baibian");
    map_skill("parry", "qingmang-jian");
    map_skill("unarmed", "jinshe-zhang");
    map_skill("throwing", "jinshe-zhui");
    weapon = "/clone/weapon/hanbing-shi";
  } else {  //五岳派
    set_skill("hanbing-zhenqi", 500 + jibie / 2 + random(jibie / 5));
    set_skill("babulongnv-jian", 500 + jibie / 2 + random(jibie / 5));
    set_skill("ningxue-shenzhua", 500 + jibie / 2 + random(jibie / 5));
    set_skill("lingxu-bu", 500 + jibie / 2 + random(jibie / 5));
    set_skill("sword", 500 + jibie * 2 + random(jibie / 5));
    map_skill("force", "hanbing-zhenqi");
    map_skill("dodge", "lingxu-bu");
    map_skill("parry", "babulongnv-jian");
    map_skill("unarmed", "ningxue-shenzhua");
    map_skill("sword", "babulongnv-jian");
    weapon = "/clone/weapon/hanbing-jian";
  }
  set("weapon", weapon);
  setup();
  if (weapon != "null") carry_object(weapon)->wield();
  carry_object("/clone/cloth/hanbing-jia")->wear();
  add_money("gold", 10 + random(jibie / 10));
}

void just_kill(object guai, object player) {
  if (!objectp(guai) || !objectp(player)) return;
  if (environment(guai) != environment(player)) return;
  if (environment(player)->query("no_fight")) return;
  if (random(2) == 1) {
    guai->command("haha");
    guai->command("say 你运气不错，老子现在心情不错，赶紧滚吧！！！");
  } else {
    guai->command("say 算你小子倒霉，老子现在心情不好，正想找个人砍，你就送上门了！");
    guai->kill_ob(player);
    player->fight_ob(guai);
  }

  return;
}

void init() {
  object ob, me;
  //	object get_ob;
  //	int level,is_time;

  me = this_object();
  ob = this_player();

  // 怪物必须是可以动作的，并只针对玩家
  if (!objectp(ob) || !living(me) || !playerp(ob)) return;
  // 见面就杀
  call_out("just_kill", 1, me, ob);
  // 拦路
  //	add_action("do_go", "go");
  // 跟随
  //	command("follow "+ob->query("id"));
  /*
	// 战斗中不复制
	if ( sizeof(me->query_enemy()) > 1 
		&& (is_time=me->query_temp("copy_ob_time")) 
		&& is_time < time() )
		return;
    // 只复制>5000级玩家状态
	if ( ob->query("xyzx_sys/level") < 1000000 ) return;//2016.5.27阿飞改，以后怪不再复制玩家了	
	// 获得玩家总等级
	level = ob->query("xyzx_sys/level");
	// 只复制最高等级玩家
	if ( me->query_temp("kill_ob_lvl") >= level ) return;
	// 防止重复复制同一人
	if ( objectp(get_ob=me->query_temp("fight_killer_id")) && get_ob==ob ) return;
	//__________________标记目前复制状况___________________
	me->set_temp("fight_killer_id", ob);
	me->set_temp("kill_ob_lvl", level);
	//______________________标记结束_______________________
	//__________________________等级相关参数拷贝_____________________________
	me->set("xyzx_sys/level", me->query("xyzx_sys/level") + ob->query("xyzx_sys/level"));
	me->set("xyzx_sys/jingzhun", me->query("xyzx_sys/level") + ob->query("xyzx_sys/jingzhun"));
	me->set("xyzx_sys/minjie", me->query("xyzx_sys/level") + ob->query("xyzx_sys/minjie"));
	me->set("xyzx_sys/lingxing", me->query("xyzx_sys/level") + ob->query("xyzx_sys/lingxing"));
	me->set("xyzx_sys/fanying", me->query("xyzx_sys/level") + ob->query("xyzx_sys/fanying"));
	//______________________________拷贝完成_________________________________
*/
}

void die() {
  object ob, me, corpse, baoshi, env;
  string room, name;
  int m, k1, k2, k3;
  int flag;
  flag = 1;
  ob = this_object();

  // 先绑定到打晕的对象上
  if (!objectp(me = ob->query_temp("last_unconcious_from")))
    me = ob->query_temp("last_damage_from");  // 绑定到最后伤害对象

    if (!objectp(me)  // 未成功绑定
    || !objectp(env = environment(ob))
      || !stringp(room = env->query("short"))) {
      ::die();
      return;
    }

  if (me) {
    m = 10000000 + random(10000000);

    if (interactive(me)) {
      message_vision(
        HIG "\n你杀死了 " + ob->name(1) + HIG " ，奖励了 " HIM + (m * me->query_exp_times()) + HIG " 点经验和 " HIY + (m / 10) + HIG " 潜能。\n" NOR,
        me
      );
      message(
        "party",
        HIW "【" + room + "】" + HIG + me->name(1) + HIM " 杀死了 " + ob->name(1) + HIM " ，奖励了 " HIC + (me->query_exp_times() * m) + HIM " 点经验和 " HIY + (m / 10) + HIM " 潜能。\n" NOR,
        users()
      );
      me->add("combat_exp", m);
      me->add("potential", m / 10);
      if (me->query("xyhy_type") == 2) flag = 5 / 4;
    }
  }

  if (objectp(corpse = CHAR_D->make_corpse(ob, me)))
    corpse->move(environment(ob));
  // 绑定到对象，冷冻一分钟
  corpse->set("valid_get_from", me->query("id"));

  k1 = 300 * flag;  //装备爆率
  k2 = 300 * flag;  //装备爆率
  k3 = 300 * flag;  //宝石爆率

  if (objectp(me) && objectp(ob) && random(1000) < k1) {
    if (random(2) == 0) {
      baoshi = new("/clone/tzbox/three-box");
    } else {
      baoshi = new("/clone/tzbox/wp3-box");
    }
    name = baoshi->name(1);
    message_vision(
      HIG "\n$N在 " HIY + ob->name(1) + " 的尸体上发现了 " HIW + baoshi->name(1) + "(" + baoshi->query("id") + ")。\n" NOR,
      me
    );  //2016.6.15阿飞改，增加显示物品的id		
    message(
      "party",
      HIW "【" + room + "】" + HIM "听说 " HIG + me->name(1) + HIM " 在 " + ob->name(1) + HIM " 尸体上发现了 " HIM + baoshi->name(1) + "(" + baoshi->query("id") + ")。\n" NOR,
      users()
    );  //2016.6.15阿飞改，增加显示物品的id
    baoshi->move(corpse);
  }
  if (objectp(me) && objectp(ob) && random(1000) < k2) {
    baoshi = new("/clone/map/obj/fumo-fu");
    name = baoshi->name(1);
    message_vision(
      HIG "\n$N在 " HIY + ob->name(1) + " 的尸体上发现了 " HIW + baoshi->name(1) + "(" + baoshi->query("id") + ")。\n" NOR,
      me
    );  //2016.6.15阿飞改，增加显示物品的id		
    //		    message("party", HIW"【"+room+"】"+HIM"听说 "HIG+me->name(1)+HIM" 在 "+ob->name(1)+HIM" 尸体上发现了 "HIM+baoshi->name(1)+"("+baoshi->query("id")+")。\n"NOR,users() );  //2016.6.15阿飞改，增加显示物品的id
    baoshi->move(corpse);
  }
  if (objectp(me) && objectp(ob) && random(1000) < k3) {
    baoshi = new(random_item2[random(sizeof(random_item2))]);
    name = baoshi->name(1);
    message_vision(
      HIG "\n$N在 " HIY + ob->name(1) + " 的尸体上发现了 " HIW + baoshi->name(1) + "(" + baoshi->query("id") + ")。\n" NOR,
      me
    );  //2016.6.15阿飞改，增加显示物品的id		
    //		    message("party", HIW"【"+room+"】"+HIM"听说 "HIG+me->name(1)+HIM" 在 "+ob->name(1)+HIM" 尸体上发现了 "HIM+baoshi->name(1)+"("+baoshi->query("id")+")。\n"NOR,users() );  //2016.6.15阿飞改，增加显示物品的id
    baoshi->move(corpse);
  }


  COMBAT_D->announce(ob, "dead");
  destruct(ob);
  return;
}

