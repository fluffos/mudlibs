// m_jia.c

#include <ansi.h>
#include <armor.h>
inherit S_ROBE;

int do_duanlian1(object armor);
int do_hui(object armor);
int do_jianame(string arg);


//   string query_autoload() { return 1 + ""; }      //autoload armor	:	

void init() {
  add_action("do_duanlian1", "duanlian1");
  add_action("do_hui", "hui");
  add_action("do_jianame", "jianame");
}


void create() {
  object me;
  string w_name, w_id, w_or;
  string result1, result2, result3, result4, result;
  int w_lv;
  me = this_player();
  //读入数据
  if (objectp(me)) {
    //		if ( !stringp(w_name=me->query("jia/name")) ) w_name="自制的甲衣";
    //		if ( !stringp(w_id=me->query("jia/id")) ) w_id="my jia";
    //		else w_id = "my "+me->query("jia/id");
    //		if ( !stringp(w_or=me->query("jia/or")) ) w_or="千年神木";
    //		if ( !(w_lv=me->query("jia/lv")) ) w_lv=1;
    w_name = me->query("jia/name");
    w_id = me->query("jia/id");
    w_or = me->query("jia/or");
    w_lv = me->query("jia/lv");
    set_name(w_name, ({ w_id, "my jia" }));
    //	set("long", "这是一件用特殊材料精制的铠甲,其上似乎蕴藏着某种神奇的力量。\n");	
    set("unit", "件");
    //	set("value",0);
    set("no_get", 1);
    set("no_give", 1);
    set("no_drop", 1);
    set("no_put", 1);
    set("no_beg", 1);
    set("no_jie", 1);
    set("no_steal", 1);
    set("no_tie", 1);
    set("no_sell", 1);
    //	set("xyzx_sys/bind_type", 1);
    set("no_zm", 1);    //2015.8 添加 限制自练武器不可以镶嵌动态宝石和优化符提升	
    set("bianren", w_lv);         //  龙云梦增加于2003年12月17日		
    set("ownmake", 1);
    set("material", "fur");
    //	set_desc(w_lv,w_or,w_name);
    result1 = "\t 这是一件用" + w_or + "打造而成的" + w_name + "。\n";
    switch (w_or) {
      case "千年神木":
        set_weight(500);
        set("armor_prop/constitution", 100 + w_lv * 10);
        result2 = "看起来紫澄澄的，似乎朴实无华。";
        break;
      case "海底金母":
        set_weight(1000);
        set("armor_prop/strength", 100 + w_lv * 10);
        result2 = "看起来黑中透红，似乎十分坚硬。";
        break;
      case "寒丝羽竹":
        set_weight(10);
        set("armor_prop/dexerity", 100 + w_lv * 10);
        result2 = "看起来晶莹碧绿，透着丝丝的寒意。";
        break;
      default:
    }
    if (w_lv < 100) result3 = "但似乎威力还没有开发出来，是习武之人常用的护身衣甲。\n";
    else if (w_lv < 200) result3 = "但似乎威力并不很大，象是江湖人常用的护身衣甲。\n";
    else if (w_lv < 300) result3 = "隐隐的散发着一丝令人不安的气息。\n";
    else if (w_lv < 400) result3 = "看起来锋利无比, 显然普通衣甲已不能和他相比了。\n";
    else if (w_lv < 500) result3 = "向外散发着一丝迷蒙的雾气，竟有一种霸气散发了出来。\n";
    else if (w_lv < 600) result3 = "一股霸气直冲霄汉，直叫神惊鬼泣。基本上已脱离凡俗之物了。\n";
    else if (w_lv < 700) result3 = "霸气似乎有所收敛，但更多的是有了一股骇人的戾气。\n";
    else if (w_lv < 800) result3 = "冲天的戾气叫人看了不由心惊胆战，不愿再看第二眼。\n";
    else if (w_lv < 900) result3 = "戾气似乎削减了不少，一股温和的王者之气透了出来。\n";
    else if (w_lv < 1000) result3 = "一股温和的王者之气悠悠的散发了出来，隐隐的展现仙甲气息。\n";
    else result3 = "一种庄严，温和，凛然而不可侵犯的气息，\n让人不敢有一丝亵渎之意, 它已经返朴归真，成为真正的上古仙甲。 \n";
    result4 = "上面用小篆刻着一行小字：" + me->query("name") + "造于" + me->query("weapon/time") + "\n";
    result = result1 + result2 + result3 + result4;
    set("long", result);
    set("wear_msg", "$N穿上" + w_name + "在身上,顿展王者霸气。\n");
    set("remove_msg", "$N身上的" + w_name + "脱了下来，眨眼间已然不见影踪。\n");
    if (w_lv >= 500) { set("armor_prop/armor", w_lv * 50); } else {
      set("armor_prop/armor", w_lv * 20);
    }
    set("armor_type", "cloth");
    if (w_lv >= 500) { set("armor_prop/armor_vs_force", w_lv * 10); }  //2017.4.5阿飞增加，自练甲500级后具备真气护体
  }
  setup();
}



int do_duanlian1(string arg) {  //2016.8.12阿飞改，使用新的自练甲升级方法
  object me;
  object armor;
  int w_level;

  me = this_player();
  armor = this_object();
  w_level = (int)me->query("jia/lv");

  if (!arg || !id(arg))
    return notify_fail("你要锻炼什么?\n");
  if (this_object()->query("equipped"))
    return notify_fail("甲你正穿着呢!\n");
  if (!(me->query("jia/make")))
    return notify_fail("你造过衣服吗?\n");  //添加判定，无法duanlian 别人的武器
    if (!wizardp(me) && me->is_busy())
      return notify_fail("你现在正忙着呢，休息会吧。\n");
  if ((int)me->query("neili") < 100 * w_level + 100)
    return notify_fail("你的内力不够，无法锻炼甲气！\n");
  if ((int)me->query("qi") < 100 * w_level + 100)
    return notify_fail("你的气不够，无法锻炼甲气！\n");
  if ((int)me->query("eff_qi") < 100 * w_level + 100)
    return notify_fail("你现在的体力太弱，无法锻炼甲气！\n");
  if ((int)me->query("jing") < 100 * w_level + 100)
    return notify_fail("你现在的精神状态太差，不能锻炼甲气！\n");
  if ((int)me->query("eff_jing") < 100 * w_level + 100)
    return notify_fail("你现在的精力无法集中，不能锻炼甲气！\n");
  if (((int)me->query("potential")) < 10000 * w_level + 10000)
    return notify_fail("你的潜能不够，无法锻炼甲气！\n");
  if ((int)me->query("score") < 100 * w_level + 100)
    return notify_fail("你现在的江湖阅历不够，不能锻炼甲气！\n");

  message_vision(HIR "$N手指甲脊，一股内力丝丝的传了进去。\n" NOR, me);

  me->add("qi", -100 * w_level);
  me->add("eff_qi", -100 * w_level);
  me->add("jing", -100 * w_level);
  me->add("eff_jing", -100 * w_level);
  me->add("neili", -100 * w_level);
  me->add("potential", -10000 * w_level);
  me->add("score", -100 * w_level);
  me->set("jia/lv", w_level + 1);
  message_vision(CYN "甲身忽的一闪，一道银光隐入$N的甲中，不见了！\n" NOR, me);
  message_vision(HIG "$N的甲的等级提高了！\n" NOR, me);
  reload_object(armor);
  me->start_busy(3);
  return 1;
}



