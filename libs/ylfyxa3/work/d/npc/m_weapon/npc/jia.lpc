int do_hui(object armor) {
  string w_name;
  object me;
  me = this_player();
  w_name = me->query("jia/name");
  if (!armor)
    return notify_fail("你要摧毁什么?\n");
  message_vision(HIR "$N大喝一声，一掌擎甲，一掌猛力击下。结果轰隆一声巨响"
    +w_name + HIR "断为两截!\n" NOR, me);
  me->set("jia/make", 0);
  destruct(this_object());
  me->delete("jia");
  me->delete("diablo/cloth");
  me->save();

  return 1;
}


