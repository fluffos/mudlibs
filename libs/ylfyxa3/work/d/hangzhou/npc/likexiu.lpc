// likexiu.c

#include <ansi.h>

inherit NPC;

void create() {
  int jibie;
  jibie = 300;
  set("xyzx_sys/level", jibie * 8 / 10 + random(jibie * 4 / 10));  //2016.5.22阿飞调整NPC属性
  set_name("李可秀", ({ "li kexiu", "li", "kexiu" }));
  set("title", "杭州提督");
  set("gender", "男性");
  set("age", 54);
  set("long", "李可秀一身军功而成封疆大吏，一身武功自然不容轻视。\n");
  set("combat_exp", 150000);
  set("shen_type", -1);
  set("attitude", "heroism");

  set_skill("unarmed", 500 + jibie / 3 + random(jibie / 5));
  set_skill("blade", 500 + jibie / 3 + random(jibie / 5));
  set_skill("parry", 500 + jibie / 3 + random(jibie / 5));
  set_skill("dodge", 500 + jibie / 3 + random(jibie / 5));

  setup();
  carry_object("/clone/weapon/gangdao")->wield();
  carry_object("/clone/armor/tiejia")->wear();
  add_money("silver", 30);
}
