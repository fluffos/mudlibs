// luo.c 骆冰

#include <ansi.h>

inherit NPC;
inherit F_MASTER;

void create() {
  int jibie;
  jibie = 1000;
  set("xyzx_sys/level", jibie);  //2016.5.22阿飞调整NPC属性
  set_name("骆冰", ({ "luo bing", "luo", "bing" }));
  set("title", HIR "红花会" HIG "十一当家" NOR);
  set("nickname", HIG "鸳鸯刀" NOR);
  set("long",
    "她是一个秀美的少妇。一手短刀，一手握着一柄长刀。\n");
  set("gender", "女性");
  set("class", "fighter");
  set("age", 24);
  set("attitude", "friendly");
  set("shen_type", 1);
  set("per", 28);
  set("str", 30);
  set("int", 30);
  set("con", 30);
  set("dex", 30);

  set("max_qi", 8400);
  set("max_jing", 700);
  set("neili", 10000);
  set("max_neili", 10000);
  set("jiali", 100);
  set("combat_exp", 950000);

  set_skill("literate", 500 + jibie / 3 + random(jibie / 5));
  set_skill("force", 500 + jibie / 3 + random(jibie / 5));
  set_skill("dodge", 500 + jibie / 3 + random(jibie / 5));
  set_skill("parry", 500 + jibie / 3 + random(jibie / 5));
  set_skill("blade", 500 + jibie / 3 + random(jibie / 5));
  set_skill("hand", 500 + jibie / 3 + random(jibie / 5));
  set_skill("claw", 500 + jibie / 3 + random(jibie / 5));
  set_skill("yunlong-shengong", 500 + jibie / 3 + random(jibie / 5));
  set_skill("wuhu-duanmendao", 500 + jibie / 3 + random(jibie / 5));
  set_skill("yunlong-shenfa", 500 + jibie / 3 + random(jibie / 5));
  set_skill("yunlong-shou", 500 + jibie / 3 + random(jibie / 5));
  set_skill("yunlong-zhua", 500 + jibie / 3 + random(jibie / 5));

  map_skill("dodge", "yunlong-shenfa");
  map_skill("force", "yunlong-shengong");
  map_skill("blade", "wuhu-duanmendao");
  map_skill("hand", "yunlong-shou");
  map_skill("parry", "yunlong-shou");
  map_skill("claw", "yunlong-zhua");

  prepare_skill("hand", "yunlong-shou");
  prepare_skill("claw", "yunlong-zhua");
  set("env/wimpy", 20);

  setup();
  carry_object("/clone/cloth/jinduan")->wear();
  carry_object("/clone/weapon/gangdao")->wield();
}
