// zuo.c

inherit NPC;
inherit F_MASTER;
#include <ansi.h>

string ask_book();
string ask_book1();
int ask_songyang();

void create() {
  int jibie;
  jibie = 5000;
  set("xyzx_sys/level", jibie);  //2016.5.22阿飞调整NPC属性
  set_name("左冷禅", ({ "zuo lengchan", "zuo" }));
  set("title", HIR "五岳剑派盟主" HIY "嵩山派第十二代掌门" NOR);
  set("gender", "男性");
  set("class", "swordsman");
  set("age", 55);
  set("attitude", "peaceful");
  set("str", 30);
  set("con", 30);
  set("dex", 30);
  set("int", 28);

  set("neili", 2240000);
  set("max_neili", 224000);
  set("jiali", 11230);
  set("max_qi", 1200000);
  set("max_jing", 521200);

  set("combat_exp", 8000000);
  set("shen_type", -1);
  set("book_count", 1);
  set("book_count1", 1);

  set_skill("literate", 500 + jibie / 3 + random(jibie / 5));
  set_skill("sword", 500 + jibie / 3 + random(jibie / 5));
  set_skill("unarmed", 500 + jibie / 3 + random(jibie / 5));
  set_skill("force", 500 + jibie / 3 + random(jibie / 5));
  set_skill("parry", 500 + jibie / 3 + random(jibie / 5));
  set_skill("dodge", 500 + jibie / 3 + random(jibie / 5));
  set_skill("songshan-jian", 500 + jibie / 3 + random(jibie / 5));
  set_skill("songyang-zhang", 500 + jibie / 3 + random(jibie / 5));
  set_skill("hanbing-zhenqi", 500 + jibie / 3 + random(jibie / 5));
  set_skill("lingxu-bu", 500 + jibie / 3 + random(jibie / 5));
  map_skill("unarmed", "songyang-zhang");
  map_skill("sword", "songshan-jian");
  map_skill("parry", "songshan-jian");
  map_skill("dodge", "lingxu-bu");
  map_skill("force", "hanbing-zhenqi");


  set("inquiry", ([
    "大嵩阳掌谱": (: ask_book :),
    "嵩山剑谱": (: ask_book1 :),
    "嵩阳诀": (: ask_songyang :),
  ]));

  create_family("嵩山派", 12, "掌门");
  setup();

  carry_object("d/songshan/obj/kuojian")->wield();
  carry_object("d/songshan/obj/yellow-cloth")->wear();
}

void attempt_apprentice(object ob) {
  if ((int)ob->query("xyzx_sys/level") < 1000) {
    command("say 这位" + RANK_D->query_respect(ob) + "实战能力太差了，老子可是五岳派盟主。");
    command("say 是否应该去江湖中多加磨炼。");
    return;
  }
  if ((int)ob->query("con", 1) < 25) {
    command("say 这位" + RANK_D->query_respect(ob) + "的根骨太差了，不适合学我的独门内功。");
    return;
  }
  if ((int)ob->query("str", 1) < 25) {
    command("say 这位" + RANK_D->query_respect(ob) + "的体质看起来虚弱无力，难以修习我派拳脚。");
    return;
  }
  if ((int)ob->query_skill("songshan-jian", 1) < 1000) {
    command("say 这位" + RANK_D->query_respect(ob) + "对我派剑法似乎不够娴熟。");
    return;
  }
  if ((int)ob->query_skill("hanbing-zhenqi", 1) < 1000) {
    command("say 这位" + RANK_D->query_respect(ob) + "对我派内功似乎不够娴熟。");
    return;
  }
  command("say 我派为五岳盟主！入我门来，定须光大我嵩山一派。");
  command("recruit " + ob->query("id"));
}

string ask_book() {
  object ob;

  if (this_player()->query("family/family_name") != "嵩山派")
    return RANK_D->query_respect(this_player()) + "与本派毫无瓜葛，我派的武功典籍可不能交给你。";
  if (query("book_count") < 1) return "你来晚了，本派的秘籍不在此处。";
  add("book_count", -1);
  ob = new("d/songshan/obj/songyang-zhangpu");
  ob->move(this_player());
  command("rumor " + this_player()->query("name") + "拿到大嵩阳掌谱啦。\n");
  return "好吧，这本「大嵩阳掌谱」你拿回去好好钻研。";
}

string ask_book1() {
  object ob;

  if (this_player()->query("family/family_name") != "嵩山派")
    return RANK_D->query_respect(this_player()) + "与本派毫无瓜葛，我派的武功典籍可不能交给你。";
  if (query("book_count1") < 1) return "你来晚了，本派的秘籍不在此处。";
  add("book_count1", -1);
  ob = new("d/songshan/obj/sword_book4");
  ob->move(this_player());
  command("rumor " + this_player()->query("name") + "拿到嵩山剑谱啦。\n");
  return "好吧，这本「嵩山剑谱」你拿回去好好钻研。";
}

int accept_object(object me, object ob) {

  if ((string)ob->query("id") == "kuihua baodian1") {
    if ((string)me->query("family/family_name") == "嵩山派" && me->query("id") == ob->query("owner")) {
      message_vision("$N对$n说道：原来这就是岳不群练的辟邪剑法啊！\n", this_object(), me);
      message_vision(
        "$N对$n说道：不错不错，这位" + RANK_D->query_respect(me) + "解我一段心结......\n",
        this_object(),
        me
      );
      message_vision("$N对$n说道：若我练成此辟邪剑法剑法，必能铲除岳不群伪君子！！！\n", this_object(), me);
      message_vision(
        "$N对$n说道：我嵩山派一统五岳必将统领江湖铲除魔教！！！\n" + "这位" + RANK_D->query_respect(me) + "若能为我铲除魔教任我行，我将允许你去法王塔参悟嵩阳铁剑流传的绝学。\n",
        this_object(),
        me
      );
      me->set_temp("jm_songshan1", 1);
      return 1;
    } else {
      message_vision(
        "$N对$n说道：多谢这位" + RANK_D->query_respect(me) + "，这本剑谱我就笑纳了。\n",
        this_object(),
        me
      );
      return 1;
    }
  }
  return 0;
}

int ask_songyang() {
  object me, ob;
  me = this_player();
  ob = this_object();

  if (me->query_temp("jm_songshan1") && me->query_temp("jm_songshan2") && (string)me->query("family/family_name") == "嵩山派") {
    message_vision(HIB "左冷禅说道：很好！这位" + RANK_D->query_respect(me) + "为我派立下大功。\n" NOR, me);
    message_vision(HIB "左冷禅大笑道：这次五岳会盟必能夺得五岳盟主，我派一统江湖指日可待！” \n" NOR, me);
    message_vision(
      HIC "左冷禅说道：看在" + RANK_D->query_respect(me) + "的忠心下，告诉你一点【嵩阳诀】的秘密，剩下的我就不清楚了。。。。。。” \n" NOR,
      me
    );
    message_vision(HIC "左冷禅说道：这位" + RANK_D->query_respect(me) + "去我派法王塔观日出，或许能领悟到什么。” \n" NOR, me);
    me->set_temp("jm_songshan3", 1);
  } else {
    message_vision(YEL "左冷禅冷哼一声！！！昔日岳不群用假辟邪剑谱谋害我等众人，此乃深仇大恨，若你能为我取得完整的辟邪剑谱，或许......\n", me);
    message_vision(YEL "左冷禅摇头道：这位" + RANK_D->query_respect(me) + "并未为我派立功啊！” \n" NOR, me);
    message_vision(YEL "左冷禅说道：我派五岳独尊，一统江湖！若你能为我派立下大功，或许能告诉你本派不传之秘” \n" NOR, me);
    return 1;
  }

  return 1;
}


void die() {
  object me;
  me = query_temp("last_damage_from");
  if (me && (string)me->query("family/family_name") == "华山派" && me->query_temp("jm_huashan1")) {
    tell_room(environment(this_player()), "左冷禅临终之前，方才醒悟，仰天一怒：好一个伪君子，竟然隐藏如此之深！！！\n");
    tell_room(environment(this_player()), "左冷禅骂道：堂堂君子剑，只敢背后暗算，小人！！！\n");
    tell_room(environment(this_player()), "左冷禅惨嚎一声，倒在地上，抽搐了几下，两腿一蹬，死了.....．\n");
    me->set_temp("jm_huashan2", 1);
  }
  ::die();
}
