// Room: /d/songshan/yuetai.c
// Last Modified by Winder on Jul. 15 2001

inherit ROOM;

void create() {
  set("short", "观月台");
  set("long", @LONG
    这里是太室山的观月台。从观月台东望，太室山峦高耸入云，寺东有
双峰插云，嶙峋崛突，相峙对立，中间阙如，其壮如门，故称“嵩门”。
良夜长宵，正是饱览嵩山八景之“嵩门待月”(jing)和回味嵩门来历传
说(story) 的好地方。晴天白日里，远眺少室山有时能看到同列嵩山
八景的“少室晴雪”(jing1)。
    八部龙女曾在此观月，每逢月圆之夜，月光投射处，林影婆娑，
光影交错，昔日龙女剑舞(jianwu)仿佛重现。
LONG);
  set("exits", ([
    "east": __DIR__ "fawangsi",
  ]));
  set("item_desc", ([
    "jing": "
    每逢中秋佳节夜晚，一轮银盘似的皎月，从这半圆形的门洞中，徐
徐升起，不偏不倚，月满嵩门，好似玉镜，嵌于架中，皎洁的月光，犹
如水银泻满山头，使碧绿的群山披上一层银装。景色美妙，引人入胜。
自古以来，每逢中秋佳节赏月之夜，人们从四面八方，手提花灯彩龙，
携带名洒佳菜，邀朋会友，云集嵩山腹地。坐在月台上，高谈阔论，饮
酒欢歌，直待月出嵩门，饱览“嵩门待月”胜景(jing)。时过半夜三更，
银月西斜，游人犹留恋不舍。故传树崇作诗日：“嵩门待月不忍归”。
    明朝洪武年间，上堂郑大原游觉中岳，赏罢此景后，挥毫疾书，赋
诗赞颂：
                  嵩门胜迹冠中州，幸此登临值仲秋。
                  皓魄县挂苍谷口，清光满射碧山头。
                  抵圆暂息卢劳梦，民社宁忘国计忧。
                  徒倚欲归情不厌，松涛钟韵两悠悠。
\n",
    "story": "
    传说很早以前，嵩门待月胜景东边的山谷大石洞中，住着一位姑娘，
名叫“毛妮”。石洞南相隔一个山峰，有个山坡，那里住着一个青年小
伙子，名叫“好汉”。当初他们两个都是给财主当奴隶，后来被财主剥
削得没有辨法，两个人半夜里逃了出来。途中产生了爱情，两个人发誓
再也不回财主家。为了怕财主发现，他们一个住南坡，一个住北洞，白
天两人上山育“参苗”，夜里二人来峰不相会。日复一日，年复一年，
他们勤劳恩爱的行动感动了天神，天神在八月十五日晚上，一剑把山峰
辟成个门。月亮就藏在圆门的山后边，等毛妮与好汉相会的时候，银盘
似的明月，就从圆门洞里徐徐升起，给他二人照明引路。从那时候起，
人们称毛妮住的地方为“毛妮洞”。称好汉住的地方为“好汉坡”。二
人会面那个辟山处叫“嵩门待月”。毛妮与好汉育的“参苗”称为“嵩
参”。\n",
    "jing1": "
    少室山险，多有石板，特别是少林寺正南的剑峰上，有一块巨大的
卧石，平整如案。每逢夏季雨后初晴，山水顺石而下，阳光直射其上，
色变银白，精莹明亮，游人站在月台上，举目南眺，可观白云朵朵，在
蔚蓝的天幕下，阳普照的山恋中，亲烁出银白一片，好似皑皑白雪，犹
如严寒隆冬，美妙景色，十分喜人，故称“少室晴雪”。
    唐朝诗人李颀有诗赞日：
                  少室众峰几峰别，一峰晴见一峰雪
                  隔城半山连青松，素色娥娥千万重。
                  过景斜驱不可道，白云欲尽难为容。
                  行人与我玩幽境，北风切切吹衣冷。
                  惜别浮桥驻马时，举目试望南山岭。
\n",
  ]));
  /*	
	set("objects", ([
		__DIR__"npc/zhong": 1,
		__DIR__"npc/dizi" : 1,
                //"/clone/medicine/vegetable/gancao" : random(2),
	]));
*/

  set("no_clean_up", 0);
  set("outdoors", "songshan");
  set("coor/x", -40);
  set("coor/y", 810);
  set("coor/z", 50);
  setup();
}


//第4处解密
void init() {
  add_action("do_jianwu", "jianwu");
}

int do_jianwu(string arg) {
  object me = this_player();
  int ap;

  string *poem = ({
    "这道剑痕，似乎是「" HIM "阿修罗灭世" NOR "」，为什么会有这么大威力？",
    "这道剑痕，似乎是八部龙女剑其中一招「" HIG "龙女成佛" NOR "」所造成的，似乎又有些不同。",
    "这道剑痕，「" HIB "夜叉渡佛" NOR "」为什么.....？？难道因为某种内功？？？？？？",
    "这道剑痕「" HIY "天王朝圣" NOR "」，怎样逆天的内力，如此可怕....",
    "「" HIB "迦楼罗飞天" NOR "」么？？？？似乎又有些不同。为什么？",
  });

  if (me->is_busy())
    return notify_fail("你现在忙着呢，哪有功夫舞剑哦.....\n");

  if ((int)me->query_skill("literate", 1) < 2000)
    return notify_fail("月圆之夜，你试着伴月起舞，然一脸茫然，脑袋一片浆糊，始终无法领悟。\n");

  if ((int)me->query_skill("songshan-jian", 1) < 2000)
    return notify_fail("月圆之夜，你试着伴月起舞，或许本门剑法太低，完全不得要领。\n");
  if ((int)me->query_skill("lingxu-bu", 1) < 2000)
    return notify_fail("月圆之夜，你试着伴月起舞，或许本门身法太低，脚步之间生涩无比。\n");

  if (me->query("family/family_name") != "嵩山派")
    return notify_fail("月圆之夜，你试着伴月起舞，这似乎是某个门派高手舞剑时留下的，到底是哪个门派呢？？？\n");

  if (me->query_skill("hanbing-zhenqi", 1) < 1000)
    return notify_fail("似乎......内功......也许.......寒气......\n");

  if (me->query("neili") < 1000)
    return notify_fail("你累的不轻，还是先休息一会儿吧。\n");

  if (me->query_skill("babulongnv-jian", 1) >= 1)
    return notify_fail("你已经完全领悟了八部龙女剑了，没必要再舞剑了。\n");

  if (me->query("jm/babu"))
    return notify_fail("你已经完全领悟八部龙女剑的精髓。\n");

  if (me->query("jm_babu/songshan"))
    return notify_fail("你领悟了八部龙女留在嵩山的精髓，不需要在这领悟了，去其他地方看看。\n");


  ap = me->query("per", 1) + me->query("kar", 1);
  message_vision("$N月圆之夜，你试着伴月起舞：" + poem[random(sizeof(poem))] + "\n", me);
  me->add("neili", -100);
  tell_object(me, HIW "你仔细研究了观月台上的剑痕，尝试着练习了下......\n" NOR);
  me->improve_skill("literate", 50 + random(10));
  //	me->improve_skill("songshan-jian", 50+random(10));
  me->start_busy(1);

  if (random(100000) < ap) {
    me->set("jm_babu/songshan", 1);
    tell_object(me, HIG "你突然醒悟道：" HIY "原来八部龙女剑可以有此等威力" HIR "！\n" NOR);
    tell_object(me, HIG "你对八部龙女剑的精髓有所领悟\n" NOR);
  }
  return 1;
}
