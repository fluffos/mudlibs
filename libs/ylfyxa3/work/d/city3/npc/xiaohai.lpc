// xiao-hai.c

inherit NPC;

void create() {
  int jibie;
  jibie = 10;
  set("xyzx_sys/level", jibie * 8 / 10 + random(jibie * 4 / 10));  //2016.5.22阿飞调整NPC属性
  set_name("小孩", ({ "xiao hai", "hai" }));
  set("gender", "男性");
  set("age", 11);
  set("long", "小孩子有什么好看的。\n");
  //	set("shen_type", 1);
  set("combat_exp", 50);
  set("shen", 50);
  set("str", 11);
  set("dex", 11);
  set("con", 11);
  set("int", 11);
  set("attitude", "heroism");
  setup();
  carry_object("clone/cloth/cloth")->wear();
}
