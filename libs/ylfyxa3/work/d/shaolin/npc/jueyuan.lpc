// masteryue.c
inherit NPC;
int ask_jing();

void create() {
  int jibie;
  jibie = 7000;
  set("xyzx_sys/level", jibie);  //2016.5.22阿飞调整NPC属性	
  set("shen_type", 0);
  set_name("觉远禅师", ({ "jueyuan chanshi", "jueyuan" }));
  set("title", "少林僧人");
  set("gender", "男性");
  set("age", 90);
  set("long", "这是一个面颊深陷，瘦骨零丁的老僧，他脸色惨白，象一张纸一样。\n");
  set("attitude", "peaceful");
  set("combat_exp", 55000000);
  set("score", 200000);
  set("str", 30);
  set("int", 30);
  set("class", "bonze");
  set("cor", 30);
  set("cps", 30);
  set("con", 50);
  set("dex", 130);
  set("qi", 4000);
  set("max_qi", 2000);
  set("neili", 4000);
  set("max_neili", 2000);
  set("jiali", 90);
  create_family("少林派", 30, "弟子");

  set_skill("force", 500 + jibie / 3 + random(jibie / 5));
  set_skill("blade", 500 + jibie / 3 + random(jibie / 5));
  set_skill("unarmed", 500 + jibie / 3 + random(jibie / 5));
  set_skill("parry", 500 + jibie / 3 + random(jibie / 5));
  set_skill("dodge", 500 + jibie / 3 + random(jibie / 5));
  set_skill("hunyuan-yiqi", 500 + jibie / 3 + random(jibie / 5));
  set_skill("jiuyang-shengong", 500 + jibie / 3 + random(jibie / 5));
  set_skill("qianye-shou", 500 + jibie / 3 + random(jibie / 5));
  set_skill("sanhua-zhang", 500 + jibie / 3 + random(jibie / 5));
  set_skill("cibei-dao", 500 + jibie / 3 + random(jibie / 5));
  set_skill("shaolin-shenfa", 500 + jibie / 3 + random(jibie / 5));
  map_skill("force", "hunyuan-yiqi");
  map_skill("unarmed", "qianye-shou");
  map_skill("parry", "sanhua-zhang");
  map_skill("dodge", "shaolin-shenfa");
  map_skill("blade", "cibei-dao");
  set("inquiry", ([
    "楞伽经": (: ask_jing :),
  ]));

  setup();
  carry_object("/d/shaolin/obj/jingang-zhao")->wear();
}

int ask_jing() {
  object me, ob;
  me = this_player();
  ob = this_object();

  message_vision(HIB "觉远禅师说道：上个月有两贼子从本寺盗走了数本经书！” \n" NOR, me);
  message_vision(HIB "觉远禅师一脸愁容说道：达摩祖师传下来的楞伽经不慎丢失了，这可如何是好。。。。\n" NOR, me);
  if (me->query_temp("jm_kunlun1")) me->set_temp("jm_kunlun2", 1);

  return 1;
}

int accept_object() {
  object me, ob, obj;
  me = this_player();
  ob = this_object();
  if ((string)obj->query("id") == "jiuyang zhenjing1") {
    if (me->query_temp("jm_kunlun4") && (string)me->query("family/family_name") == "昆仑派" && me->query("family/master_id") == "he zudao" && me->query("id") == obj->query("owner")) {
      message_vision(HIC "觉远禅师说道：这本经书似乎并不是藏经阁丢失的那本啊！\n", this_object(), me);
      message_vision(HIC "你对觉远禅师说道：尹克西临终之前，托我给大师带句话......“经在油中”......\n", this_object(), me);
      message_vision(HIC "觉远禅师说道：“经在油中...经在油中...经在油中”？？？\n", this_object(), me);
      message_vision(HIC "觉远禅师百思不得其解，疑惑的看了你几眼。。。\n", this_object(), me);
      message_vision(HIC "觉远禅师越想越不对劲，你越解释越说不清楚，一时与觉远禅师打了起来......\n", this_object(), me);
      me->set_temp("jm_kunlun5", 1);
      ob->hit_ob(me);
      me->hit_ob(ob);
      remove_call_out("checking");
      call_out("checking", 1, me, ob);
      return 1;
    } else {
      message_vision(
        "觉远禅师说道：多谢这位" + RANK_D->query_respect(me) + "，这本经书我就收纳在藏经阁了。\n",
        this_object(),
        me
      );
      return 1;
    }
  }

  return 0;
}

int checking(object me, object ob) {
  int my_max_qi, his_max_qi;
  my_max_qi = me->query("max_qi");
  his_max_qi = ob->query("max_qi");
  if (me->is_fighting()) {
    call_out("checking", 3, me, ob);
    return 1;
  }
  if (!present(ob, environment())) return 1;
  /*	if (me->is_busy() && me->query_busy()>5)
	{
		message_vision("觉远禅师说道：这位" + RANK_D->query_respect(ob) + "，我们只是切磋武艺而已，没必要使用这种点穴功夫吧。\n", ob);
		return 1;
	}*/
  if (((int)ob->query("qi") * 100 / his_max_qi) < 50 && ob->query("family/master_id") == "he zudao" && ob->query_temp("jm_kunlun5")) {
    message_vision("觉远禅师说道：这位" + RANK_D->query_respect(ob) + "的本领还需要在历练几年吧......\n", ob);
    ob->delete_temp("jm_kunlun5");
    return 1;
  }
  if (((int)me->query("eff_qi") * 100 / my_max_qi) < 50 && ob->query("family/master_id") == "he zudao" && ob->query_temp("jm_kunlun5")) {
    command("say 孽障，如此恶毒，我看你就是盗取经书的贼人！\n");
    message_vision("觉远禅师大喝一声，将你抓进了少林寺监狱！\n", ob);
    ob->delete_temp("jm_kunlun5");
    ob->move("/d/shaolin/jianyu");
    return 1;
  }
  if (((int)me->query("qi") * 100 / my_max_qi) <= 50 && ((int)me->query("eff_qi") * 100 / my_max_qi) >= 50 && ob->query("family/master_id") == "he zudao" && ob->query_temp("jm_kunlun5")) {
    command("say 昆仑三圣的弟子，果然了得！\n");
    message_vision("觉远禅师说道：看来是我误解了这位" + RANK_D->query_respect(ob) + "，他日上昆仑山道谢。\n", ob);
    ob->delete_temp("jm_kunlun5");
    ob->set_temp("jm_kunlun6", 1);
    return 1;
  }

  return 1;
}
