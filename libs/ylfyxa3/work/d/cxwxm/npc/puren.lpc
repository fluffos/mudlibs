// marry 8,14

inherit NPC;

void create() {
  int jibie;
  jibie = 80;
  set("xyzx_sys/level", jibie * 8 / 10 + random(jibie * 4 / 10));  //2016.5.22阿飞调整NPC属性	
  set_name("仆人", ({ "pu ren", "ren", "pu" }));
  set("gender", "男性");
  set("age", 30);
  set("jihao", 1);
  set("long", "一个表情呆板的仆人,正在大院中打扫落叶。\n");
  set("combat_exp", 3000);
  set("str", 17);
  set("dex", 16);
  set("con", 18);
  set("int", 20);
  set("attitude", "peaceful");
  set("max_qi", 150);
  set("max_jing", 150);

  set_skill("force", 500 + jibie / 3 + random(jibie / 5));
  set_skill("dodge", 500 + jibie / 3 + random(jibie / 5));
  set_skill("unarmed", 500 + jibie / 3 + random(jibie / 5));
  set_skill("parry", 500 + jibie / 3 + random(jibie / 5));


  setup();
  carry_object("/d/cxwxm/obj/cloth2.lpc")->wear();

}
