// Room: /d/cxwxm/longfeng.c
// marry 8,14
inherit ROOM;
#include <ansi.h>

void delete_hexiu(object me, object arg);

void create() {
  set("short", HIY "龙" HIC "飞" HIG "凤" HIM "舞" HIB "楼" NOR);
  set("long",
    "这里就是痴心妄想门的密室，非嫡系弟子是无法来到这里的，地上\n"
    "的灰尘足有寸余厚，看来很久都未来过人了。在密室四周的墙上刻着的\n"
    +YEL "龙" + HIC "飞" + HIM "凤" + HIB "舞" + HIR "图" NOR + "想必这就是本门的究极奥义！\n"
    "地上有一蒲团(tuan)，似乎是用来练功的。\n" NOR,
  );
  set("item_desc", ([ /* sizeof() == 1 */
    "tuan": HIW "图案上画的是一男一女在练武，到底是什么意思呢？似乎要两人合修（hexiu）。\n" NOR,
  ]));

  set("exits", ([ /* sizeof() == 1 */
    "down": __DIR__ "fanting",
  ]));
  set("no_fight", 1);
  set("objects", ([
    __DIR__ "npc/xiaoxian": 1
  ]));
  setup();
}
void init() {
  add_action("do_hexiu", "hexiu");
}
int do_hexiu(string arg) {
  object me = this_player();
  object ob;

  if (me->is_busy() || me->is_fighting())
    return notify_fail("你正忙着呢。\n");
  if (!arg)
    return notify_fail("你要与谁合修龙飞凤舞？\n");
  if (me->query("family/family_name") != "痴心妄想门" || me->query("family/master_id") != "shangguan xiaoxian")
    return notify_fail("你不是掌门嫡传弟子，无法领悟痴心门终极奥义。\n");
  if (!(ob = present(arg, this_object())))
    return notify_fail("这人现在不在这里！\n");
  if (me == ob)
    return notify_fail("你想玩双手互搏吗？\n");
  if (!living(ob))
    return notify_fail("你必须先把" + ob->name() + "弄醒。\n");
  if (!userp(ob))
    return notify_fail("你只能与玩家合修龙飞凤舞！\n");
  if (ob->query("family/family_name") != "痴心妄想门")
    return notify_fail("这人不是痴心门人，无法与你共同合修龙飞凤舞。\n");
  if (me->query("couple/couple_id") != ob->query("id") || ob->query("couple/couple_id") != me->query("id"))
    return notify_fail("你们二人不是夫妻关系，无法做到心意相通。\n");
  if (me->query_skill("wangran-xinfa", 1) < 1000)
    return notify_fail("你本门内功似乎学的不到家！\n");
  if (ob->query_skill("wangran-xinfa", 1) < 1000)
    return notify_fail("这人痴心门的内功貌似不够娴熟！\n");
  if (me->query_skill("shuiyue", 1) < 2000)
    return notify_fail("你脚步虚浮，姿势东倒西歪的！\n");
  if (ob->query_skill("shuiyue", 1) < 2000)
    return notify_fail("这人脚步错乱，无法配合你合修！\n");
  /*	if ( me->query_skill("chixin-bianfa",1) < 2000 )
		return notify_fail("你的痴心鞭法舞的把自己都缠住了！\n"); 
	if (ob->query_skill("chixin-bianfa", 1) < 2000)
		return notify_fail("这人是在抽鞭子吗？我看是在抽疯吧！\n");
	if ( me->query_skill("art",1) < 1000 )
		return notify_fail("这种精美图案恐怕没有一定的美术基础是看不懂的！\n"); 
	if (ob->query_skill("art", 1) < 1000)
		return notify_fail("这人绘画基础太差了，是在胡乱涂鸦吧！\n");*/
  if (me->query("jm/chixin"))
    return notify_fail("你已经领悟了痴心门的最高绝学了，没必要再与人合修了！\n");
  if (me->query_temp("chixin_hexiu") >= 1)
    return notify_fail("你现在正在与别人合修龙凤图呢！\n");
  me->set_temp("chixin_hexiu", 1);
  tell_object(ob, me->name() + "翩翩起舞，欲与你合修龙飞凤舞。\n");
  if (ob->query_temp("chixin_hexiu") < 1)
    return notify_fail("对方还没有要与你合修的意思！\n");
  message_vision(HIY "$N脚踏镜花水月步，伸展腰肢，与$n在龙飞凤舞楼翩翩起舞，煞是美艳动人。\n" NOR, me, ob);
  me->start_busy(5);
  ob->start_busy(5);
  call_out("delete_hexiu", 5, me, ob);
  return 1;
}

void delete_hexiu(object me, object ob) {
  mapping my;
  if (!me || !ob) return;
  my = me->query_entire_dbase();

  me->delete_temp("chixin_hexiu");
  ob->delete_temp("chixin_hexiu");
  if (my["potential"] < 1) {
    tell_object(me, "你的潜能消耗光了，还合修个什么劲。\n");
    return;
  }
  my["potential"]--;
  message_vision(HIR "$N受到感应，立时运功为助，全身洋溢着热情舞姿，似乎领悟到什么。\n" NOR, me);
  me->add("jingli", -100);
  if (me->query_skill(
    "chixin-bianfa",
    1
  ) < me->query_skill(
    "whip",
    1
  ) && me->query_skill("chixin-bianfa", 1) < me->query("xyzx_sys/level") * 2)
    me->improve_skill("chixin-bianfa", me->query_int(1) * (2 + random(2)));
  if ((int)me->query("jingli") < 100) me->unconcious();

  if (random(100000) < me->query(
    "per",
    1
  ) && me->query("gender") == "女性" && me->query("family/master_id") == "shangguan xiaoxian" && !me->query("jm/chixin")) {
    me->set("jm/chixin", 1);
    me->add("family_score", 1);
    tell_object(me, HIG "你突然醒悟道：" HIY "原来痴心门的终极奥义" HIR "凤舞九天" HIY "是这般使用！\n" NOR);
    tell_object(me, HIG "恭喜你融汇贯通了痴心妄想门武功的精髓！\n" NOR);
    message(
      "channel:chat",
      HIM "【天降奇才】" HIM + "听说" + me->query("name") + "天纵奇才，在痴心妄想门的龙飞凤舞楼居然领悟了痴心门的终极奥义！\n" NOR,
      users()
    );
    me->add("jingli", -100);
  }

  return;
}
