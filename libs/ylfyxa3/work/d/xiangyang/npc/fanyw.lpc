// yiweng.c 樊一翁

inherit NPC;


void consider();

void create() {
  int jibie;
  jibie = 500;
  set("xyzx_sys/level", jibie);  //2016.5.22阿飞调整NPC属性
  set_name("樊一翁", ({ "fan yiweng", "fan", "yiweng" }));
  set("gender", "男性");
  set("age", 68);
  set("long", "额下长须飘洒，身材稍微矮小。\n");
  set("attitude", "peaceful");
  set("nickname", "长须鬼");
  set("str", 28);
  set("con", 21);
  set("int", 20);
  set("dex", 25);


  set("max_qi", 1500);
  set("max_jing", 1800);
  set("neili", 1800);
  set("max_neili", 1800);
  set("jiali", 100);
  set("shen", 5000);
  set("startroom", "/d/xiangyang/cross2");


  set("combat_exp", 550000);

  set_skill("force", 500 + jibie / 3 + random(jibie / 5));
  set_skill("finger", 500 + jibie / 3 + random(jibie / 5));
  set_skill("dodge", 500 + jibie / 3 + random(jibie / 5));
  set_skill("parry", 500 + jibie / 3 + random(jibie / 5));
  set_skill("shenyuan-gong", 500 + jibie / 3 + random(jibie / 5));
  set_skill("literate", 500 + jibie / 3 + random(jibie / 5));
  set_skill("murong-daofa", 500 + jibie / 3 + random(jibie / 5));
  set_skill("yanling-shenfa", 500 + jibie / 3 + random(jibie / 5));
  set_skill("canhe-zhi", 500 + jibie / 3 + random(jibie / 5));
  set_skill("blade", 500 + jibie / 3 + random(jibie / 5));

  map_skill("blade", "murong-daofa");
  map_skill("finger", "canhe-zhi");
  map_skill("force", "shenyuan-gong");
  map_skill("dodge", "yanling-shenfa");
  map_skill("parry", "murong-daofa");

  prepare_skill("finger", "canhe-zhi");

  set("chat_chance", 20);
  set("chat_msg", ({
    "长须老翁冷笑道:“西山一窟鬼都是天不怕地不怕的人物，名头再响，也吓不到咱们 \n",
    (: random_move :)
  }));

  setup();
  carry_object("/clone/weapon/gangdao")->wield();
  carry_object("/clone/cloth/cloth")->wear();
  //        add_money("gold", 3);
}
