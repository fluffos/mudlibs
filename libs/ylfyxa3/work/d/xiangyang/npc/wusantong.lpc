// wusantong.c

#include <ansi.h>

inherit NPC;
void create() {
  int jibie;
  jibie = 1000;
  set("xyzx_sys/level", jibie);  //2016.5.22阿飞调整NPC属性
  set_name("武三通", ({ "wu santong", "wu", "santong" }));
  set("gender", "男性");
  set("age", 55);
  set("long", "一灯大师的四大弟子之一，现在襄阳协助郭靖、黄蓉守城。\n");
  set("attitude", "peaceful");

  set("per", 17);
  set("str", 40);
  set("int", 20);
  set("con", 30);
  set("dex", 25);

  set("qi", 1500);
  set("max_qi", 1500);
  set("jing", 500);
  set("max_jing", 500);
  set("neili", 1500);
  set("max_neili", 1500);

  set("combat_exp", 300000);
  set("score", 20000);

  set_skill("force", 500 + jibie / 3 + random(jibie / 5));
  set_skill("kumu-shengong", 500 + jibie / 3 + random(jibie / 5));
  set_skill("finger", 500 + jibie / 3 + random(jibie / 5));
  set_skill("yiyang-zhi", 500 + jibie / 3 + random(jibie / 5));
  set_skill("cuff", 500 + jibie / 3 + random(jibie / 5));
  set_skill("jinyu-quan", 500 + jibie / 3 + random(jibie / 5));
  set_skill("dodge", 500 + jibie / 3 + random(jibie / 5));
  set_skill("tiannan-step", 500 + jibie / 3 + random(jibie / 5));
  set_skill("parry", 500 + jibie / 3 + random(jibie / 5));

  map_skill("force", "kumu-shengong");
  map_skill("finger", "yiyang-zhi");
  map_skill("cuff", "jinyu-quan");
  map_skill("dodge", "tiannan-step");
  map_skill("parry", "yiyang-zhi");
  prepare_skill("cuff", "jinyu-quan");

  setup();

  carry_object("/clone/cloth/cloth")->wear();
}
