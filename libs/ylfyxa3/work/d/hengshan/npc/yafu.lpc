// yafu.c

inherit NPC;

void create() {
  int jibie;
  jibie = 70;
  set("xyzx_sys/level", jibie * 8 / 10 + random(jibie * 4 / 10));  //2016.5.22阿飞调整NPC属性	
  set_name("哑妇", ({ "yafu" }));
  set("gender", "女性");
  set("age", 37);
  set("long", "这是个终年不开口的哑妇\n");
  set("combat_exp", 50000);
  set("shen_type", 0);
  set("str", 21);
  set("per", 20);
  set("dex", 21);
  set("con", 21);
  set("int", 21);
  set("attitude", "friendly");
  setup();
  carry_object("/clone/cloth/cloth")->wear();
}
