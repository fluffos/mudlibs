// Room: /d/huashan/lianhua.c

inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "桃花洞");
  set("long", @LONG
    桃花洞古已有之，属恒山“七宫八洞十五庙”之一，位于真武
大殿后的恒宗峰上。洞口坐北朝南，高有丈余，宽近八尺，入深数丈。
传说，这里是桃花仙女修行的所在。玉女原在王母娘娘蟠桃园值守，
后下凡投胎到北岳富户人家，因素喜桃花，人称桃花女。桃花女
善禳镇之术，常为百姓破解疑难杂症，故得百姓爱戴。
    八部龙女游历至此，正值桃花灿烂，于是在桃花林中翩翩
起舞(jianwu)，桃花沾染龙女仙气，随风而起时似乎蕴含着某种剑意。
LONG
  );
  set("exits", ([ /* sizeof() == 4 */
    "out": __DIR__ "cuipinggu2",
  ]));
  set("no_clean_up", 0);
  set("outdoors", "hengshan");

  setup();
  replace_program(ROOM);
}


//第3处解密
void init() {
  add_action("do_jianwu", "jianwu");
}

int do_jianwu(string arg) {
  object me = this_player();
  int ap;

  string *poem = ({
    "这道剑痕，似乎是「" HIM "阿修罗灭世" NOR "」，为什么会有这么大威力？",
    "这道剑痕，似乎是八部龙女剑其中一招「" HIG "龙女成佛" NOR "」所造成的，似乎又有些不同。",
    "这道剑痕，「" HIB "夜叉渡佛" NOR "」为什么.....？？难道因为某种内功？？？？？？",
    "这道剑痕「" HIY "天王朝圣" NOR "」，怎样逆天的内力，如此可怕....",
    "「" HIB "迦楼罗飞天" NOR "」么？？？？似乎又有些不同。为什么？",
  });

  if (me->is_busy())
    return notify_fail("你现在忙着呢，哪有功夫舞剑哦.....\n");

  if ((int)me->query_skill("literate", 1) < 2000)
    return notify_fail("桃花灿烂时，你试着随风起舞，然一脸茫然，脑袋一片浆糊，始终无法领悟。\n");

  if ((int)me->query_skill("hengshan-jian", 1) < 2000)
    return notify_fail("桃花灿烂时，你试着随风起舞，或许本门剑法太低，完全不得要领。\n");

  if (me->query("family/family_name") != "恒山派")
    return notify_fail("桃花灿烂时，你试着随风起舞，这似乎是某个门派高手舞剑时留下的，到底是哪个门派呢？？？\n");

  //	if (me->query_skill("zixia-shengong",1) < 2000)
  //        return notify_fail("似乎......内功......也许.......紫气......\n"); 

  if (me->query("neili") < 1000)
    return notify_fail("你累的不轻，还是先休息一会儿吧。\n");

  if (me->query_skill("babulongnv-jian", 1) >= 1)
    return notify_fail("你已经完全领悟了八部龙女剑了，没必要再舞剑了。\n");

  if (me->query("jm/babu"))
    return notify_fail("你已经完全领悟八部龙女剑的精髓。\n");

  if (me->query("jm_babu/hengshan"))
    return notify_fail("你领悟了八部龙女留在恒山的精髓，不需要在这领悟了，去其他地方看看。\n");


  ap = me->query("per", 1) + me->query("kar", 1);
  message_vision("$N桃花灿烂时，你试着随风起舞：" + poem[random(sizeof(poem))] + "\n", me);
  me->add("neili", -100);
  tell_object(me, HIW "你仔细研究了桃花飘落的轨迹，尝试着练习了下......\n" NOR);
  me->improve_skill("literate", 50 + random(10));
  //	me->improve_skill("hengshan-jian", 50+random(10));
  me->start_busy(1);

  if (random(100000) < ap) {
    me->set("jm_babu/hengshan", 1);
    tell_object(me, HIG "你突然醒悟道：" HIY "原来八部龙女剑可以有此等威力" HIR "！\n" NOR);
    tell_object(me, HIG "你对八部龙女剑的精髓有所领悟\n" NOR);
  }
  return 1;
}
