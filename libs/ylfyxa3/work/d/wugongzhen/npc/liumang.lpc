// liumang.c 流氓

inherit NPC;

void create() {
  int jibie;
  jibie = 100;
  set("xyzx_sys/level", jibie * 8 / 10 + random(jibie * 4 / 10));  //2016.5.22阿飞调整NPC属性
  set_name("流氓", ({ "liu mang", "liu" }));
  set("gender", "男性");
  set("age", 19);
  set("long", "他是一个成天游手好闲的流氓，长得倒是白白胖胖的，也许以前有过钱。\n");

  set("combat_exp", 1000);
  set("shen_type", -1);
  set("shen", -30);
  set("attitude", "peaceful");

  set_skill("unarmed", 20);
  set_skill("dodge", 20);
  set_temp("apply/attack", 10);
  set_temp("apply/defense", 10);

  setup();
  carry_object("/clone/cloth/cloth")->wear();
  add_money("silver", 2);
}
