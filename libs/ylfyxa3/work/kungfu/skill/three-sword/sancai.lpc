//sancai.c「三才剑阵」

#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
#include <condition.h>
inherit F_SSERVER;

int perform(object me, object target) {
  /*      mapping prepare_status;	//配合下面的写法进行更改
        string weapon, op_weapon, op_skill, *pname, msg;
        int my_power, op_power;
		int damage;*/

  string weapon, op_weapon, op_skill, msg;
  int my_power, op_power;
  int damage, extra, expadd;

  if (!target) target = offensive_target(me);
  if (!target || !target->is_character() || !me->is_fighting(target))
    return notify_fail("「三才剑阵」只能对战斗中的对手使用。\n");
  if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "sword")
    return notify_fail("你没用剑，不能使用「三才剑阵」！\n");
  //	if (target && target->query_temp("apply/shade_vision")) 
  //		return notify_fail("对方隐身了，你看不到"+target->query("name")+"。\n"); 				
  if (me->is_busy())
    return notify_fail("你现在正忙着呢！\n");
  if (me->query_skill("zhenfeng-xinfa", 1) < 1000)
    return notify_fail("你的震风心法火候未到，无法施展三才剑阵！\n");
  if (me->query_skill("three-sword", 1) < 1000)
    return notify_fail("你的三才剑法修为不足，还不会使用三才剑阵！\n");
  if (me->query_skill_mapped("force") != "zhenfeng-xinfa")
    return notify_fail("你所用的并非震风心法，使不了「三才剑阵」！\n");
  if (me->query_skill("piaoyibu", 1) < 1000)
    return notify_fail("你的飘逸步修为不足，还不会使用三才剑阵！\n");
  if (me->query_skill("qimen-wuxing", 1) < 1000)
    return notify_fail("你的奇门五行修为不足，难以摆出三才剑阵！\n");
  if (me->query_skill_mapped("dodge") != "piaoyibu")
    return notify_fail("「三才剑阵」需要飘逸步配合才能使用！\n");
  if (me->query_skill_mapped("sword") != "three-sword")
    return notify_fail("只有使用三才剑法，才能使用「三才剑阵」！\n");
  //	if (!(int)me->query("breakup"))
  //		return notify_fail("你任督二脉未通,无法使用[" HIR "三才剑阵" NOR "]\n"); 
  if (me->query("max_neili") <= 500000)
    return notify_fail("你的内力修为不够使用「三才剑阵」！\n");
  if (me->query("max_jingli") <= 500000)
    return notify_fail("你的精力修为不够使用「三才剑阵」！\n");
  if (me->query("neili") <= 10000)
    return notify_fail("你的内力不够使用「三才剑阵」！\n");
  if (me->query("jingli") <= 10000)
    return notify_fail("你的精力不够使用「三才剑阵」！\n");
  if (me->query_temp("autolian"))
    return notify_fail("你正在发动自动连招！\n");
  if (me->query_temp("cooldown"))  //CD写法	2017.9.7添加
    return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");

  weapon = me->query_temp("weapon");
  /*	//2017.4.20阿飞改，这段代码有点问题，先换个简单的写法
        if ( !objectp(op_weapon = target->query_temp("weapon")) ) {
                if ( mapp(prepare_status = target->query_skill_prepare()) ) 
        {
                        pname  = keys(prepare_status);
                        op_skill = pname[0];
        }
                else op_skill = "unarmed";
        }
        else {
                op_skill = op_weapon->query("skill_type");
	         }
*/
  if (!objectp(op_weapon = target->query_temp("weapon"))) {
    op_skill = "unarmed";
  } else {
    op_skill = op_weapon->query("skill_type");
  }

  message_vision(HBWHT "$N贯通圣剑魔宫武学，使出了圣剑魔宫的绝学之精髓！\n" NOR, me, target);
  me->set_temp("cooldown", 1);  //CD写法	2017.9.7添加
  call_out("del_cooldown", 5, me);  //CD写法1	
  damage = me->query_skill(
    "three-sword",
    1
  ) + me->query_skill("sword", 1) + me->query_skill("piaoyibu", 1) + target->query("qi") / 500;
  my_power = me->query_skill(
    "three-sword",
    1
  ) + me->query_skill(
    "zhenfeng-xinfa",
    1
  ) + me->query_skill(
    "piaoyibu",
    1
  ) + me->query_skill("dodge") + me->query_skill("sword") + me->query("xyzx_sys/level");
  op_power = target->query_skill(
    op_skill,
    1
  ) + target->query_skill("dodge") + target->query_skill("parry") + target->query("xyzx_sys/level");
  extra = me->query_skill("three-sword", 1) + me->query_skill("piaoyibu", 1);
  expadd = 1;  //2018.3.7阿飞改，三才剑法可以降低对方等级
  msg = HIY "\n$N脚踏三星，身形变幻莫测，使出三才剑法的绝技「三才归一」！\n" NOR;
  message_vision(msg, me, target);
  msg = HIR "「天字诀」！\n" NOR;
  message_vision(msg, me, target);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0);
  msg = HIY "「地字诀」！\n" NOR;
  message_vision(msg, me, target);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0);
  msg = HIC "「人字诀」！\n" NOR;
  message_vision(msg, me, target);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0);

  message_vision(CYN "\n$N说道：让你见识一下三才剑法真正的秘密！\n" NOR, me, target);
  message_vision(HIY "$N将剑朝天一扔，漫天剑气飞舞，好似梦幻一般绚烂，最后汇聚成一个大大的【天】剑冲向$n！\n" NOR, me, target);
  me->add_temp("apply/attack", extra * 2);
  me->add_temp("apply/damage", extra * 2);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
  me->add_temp("apply/attack", -extra * 2);
  me->add_temp("apply/damage", -extra * 2);
  message_vision(HIB
    "\n             天天天天天天天天天天天天天天天天天天                        \n"
    "\n                               天                                        \n"
    "\n                              天                                         \n"
    "\n         天天天天天天天天天天天天天天天天天天天天天天                    \n"
    "\n                            天  天                                       \n"
    "\n                           天    天                                      \n"
    "\n                          天      天                                     \n"
    "\n                         天        天                                    \n"
    "\n                        天          天                                   \n"
    "\n                       天            天                                  \n"
    "\n                      天              天                                 \n"
    "\n                     天                天                                \n"
    "\n                    天                  天                               \n"
    "\n                   天                    天                              \n" NOR, me, target);

  damage = damage + random(damage);
  target->receive_wound("qi", damage, me);
  target->receive_damage("qi", damage, me);
  target->receive_wound("jing", damage, me);
  target->receive_damage("jing", damage, me);
  target->add("neili", -damage);
  me->add("neili", -1000);
  me->add("jingli", -1000);
  message_vision(HIR "\n$n一声惨嚎，被无数剑气穿身而过！\n" NOR, me, target);
  if (userp(me) && me->query("env/no_combat_msg") < 4) tell_object(
    me,
    HIW "该绝招对敌人气血的外伤为" + damage + "，内伤为" + damage + "，精神的外伤为" + damage + "，内伤为" + damage + "，杀内力" + damage + "。\n" NOR
  );

  if (me->query_skill("three-sword", 1) > 2000 && me->query_skill("piaoyibu", 1) > 2000) {
    message_vision(HIY "$N将剑插入大地，地面无数小剑升起，最后组成成一个大大的【地】剑困住$n！\n" NOR, me, target);
    message_vision(HIB
      "\n           地                    地                    \n"
      "\n           地           地       地                    \n"
      "\n           地           地       地                    \n"
      "\n           地           地       地                    \n"
      "\n           地      地地地地地地地地地地地地            \n"
      "\n     地地地地地地地     地       地      地            \n"
      "\n           地           地       地      地            \n"
      "\n           地           地       地      地            \n"
      "\n           地           地       地      地            \n"
      "\n           地           地       地      地            \n"
      "\n           地           地       地      地            \n"
      "\n           地           地           地  地            \n"
      "\n    地地地地地地地地    地             地地   地       \n"
      "\n                        地地地地地地地地地地地地       \n" NOR, me, target);

    me->add_temp("apply/attack", extra * 3);
    me->add_temp("apply/damage", extra * 3);
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
    me->add_temp("apply/attack", -extra * 3);
    me->add_temp("apply/damage", -extra * 3);
    damage = me->query_skill(
      "three-sword",
      1
    ) + me->query_skill(
      "piaoyibu",
      1
    ) + me->query_skill("dodge") + me->query_skill("sword") + me->query("xyzx_sys/level") + target->query("qi") / 500;
    damage = damage + random(damage);

    if (random(my_power) > op_power / 3) {
      if (objectp(op_weapon)) {
        message_vision(HIB "\n$N被困阵中，只好舞动" + op_weapon->name() + "企图阻挡周围小剑。\n" NOR, me, target);
        message_vision(
          WHT "$N发现小剑实在是太多了，无法抵挡，只好将" + op_weapon->name() + WHT "扔在地上。\n" NOR,
          me,
          target
        );
        //				op_weapon->add_amount(-1);	//这个代码什么作用？
        op_weapon->move(environment(me));
        message_vision(HIR "\n$n一声惨嚎，被无数小剑穿身而过！\n" NOR, me, target);
        target->receive_damage("qi", damage, me);
        target->receive_wound("qi", damage, me);
        if (userp(me) && me->query("env/no_combat_msg") < 4) tell_object(
          me,
          HIW "该绝招对敌人气血的外伤为" + damage + "，内伤为" + damage + "。\n" NOR
        );
      } else if (random(me->query_str(1)) > (target->query_str(1)) * 3 / 5) {
        message_vision(HIR "\n$n奋力闪躲，结果被三才剑法戳了几个血洞。\n" NOR, me, target);
        target->receive_damage("qi", damage / 2, me);
        target->receive_wound("qi", damage / 2, me);
        if (userp(me) && me->query("env/no_combat_msg") < 4) tell_object(
          me,
          HIW "该绝招对敌人气血的外伤为" + damage / 2 + "，内伤为" + damage / 2 + "。\n" NOR
        );
      } else {
        message_vision(HIR "\n$n奋力闪躲，结果被三才剑法划了几道血痕。\n" NOR, me, target);
        target->receive_damage("qi", damage / 4, me);
        target->receive_wound("qi", damage / 4, me);
        if (userp(me) && me->query("env/no_combat_msg") < 4) tell_object(
          me,
          HIW "该绝招对敌人气血的外伤为" + damage / 4 + "，内伤为" + damage / 4 + "。\n" NOR
        );
      }
      me->add("neili", -2000);
      me->add("jingli", -2000);
    } else {
      me->add("neili", -500);
      message_vision(HIG "\n$N身形连闪，好不容易将此招避过，已吓得浑身冰冷！\n" NOR, me, target);
    }
  }
  if (me->query_skill("three-sword", 1) > 3000 && me->query_skill("piaoyibu", 1) > 3000) {
    msg = HIY "\n$N三才剑法反转轻舞，使出人道绝巅的【人】剑，去势尽时一把" + weapon->name() + HIY "汇聚而生，这一剑无形无迹，似乎他就在该在的地方。\n" NOR;
    message_vision(msg, me, target);
    if (me->query("jm/shengjian")) damage = me->query_skill(
      "three-sword",
      1
    ) * me->query(
      "int",
      1
    ) * 3 / 60 + me->query_skill(
      "sword",
      1
    ) + me->query_skill(
      "piaoyibu",
      1
    ) * me->query(
      "dex",
      1
    ) * 3 / 60 + me->query_skill(
      "zhenfeng-xinfa",
      1
    ) * me->query(
      "int",
      1
    ) * 3 / 60 + me->query_skill(
      "dodge",
      1
    ) + me->query_skill("force", 1) + target->query("qi") / 500;
    else damage = me->query_skill(
      "three-sword",
      1
    ) * me->query(
      "int",
      1
    ) / 30 + me->query_skill(
      "sword",
      1
    ) + me->query_skill(
      "piaoyibu",
      1
    ) * me->query(
      "dex",
      1
    ) / 30 + me->query_skill(
      "zhenfeng-xinfa",
      1
    ) * me->query(
      "int",
      1
    ) / 30 + me->query_skill("dodge", 1) + me->query_skill("force", 1) + target->query("qi") / 500;
    damage = damage + random(damage);
    message_vision(HIB
      "\n                       人                        \n"
      "\n                       人                        \n"
      "\n                       人                        \n"
      "\n                       人                        \n"
      "\n                      人人                       \n"
      "\n                     人  人                      \n"
      "\n                    人    人                     \n"
      "\n                   人      人                    \n"
      "\n                 人          人                  \n"
      "\n               人              人                \n"
      "\n             人                  人              \n"
      "\n           人                      人            \n"
      "\n         人                          人          \n"
      "\n       人                              人        \n" NOR, me, target);

    me->add_temp("apply/attack", extra * 5);
    me->add_temp("apply/damage", extra * 5);
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
    me->add_temp("apply/attack", -extra * 5);
    me->add_temp("apply/damage", -extra * 5);
    if (random(my_power) > op_power / 3) {
      message_vision(HIG "\n$N手中无剑，心中有剑！\n" NOR, me, target);
      message_vision(HIM "\n$N默念：一生二，二生三，三生万物！\n" NOR, me, target);
      target->receive_wound("qi", damage, me);
      target->receive_damage("qi", damage, me);
      target->receive_wound("jing", damage, me);
      target->receive_damage("jing", damage, me);
      target->apply_condition("no_enforce", 20);
      me->add("neili", -3000);
      me->add("jingli", -3000);
      message_vision(HIC "\n$n根本就看不见这一剑，这一剑仿佛从未动过，但他就在他该在的地方！\n" NOR, me, target);
      message_vision(HIB "\n$n好像未感觉到疼痛，但是低头一看，胸口一柄剑！\n" NOR, me, target);
      if (userp(me) && me->query("env/no_combat_msg") < 4) tell_object(
        me,
        HIW "该绝招对敌人气血的外伤为" + damage + "，内伤为" + damage + "，精神的外伤为" + damage + "，内伤为" + damage + "。\n" NOR
      );
      if (!userp(target)) expadd = 100;
      if (target->query("xyzx_sys/level", 1) > 100 && random(2) == 0) {
        message_vision(HIC "\n一剑化三元，三元重归一！\n$n似乎觉得浑身哇凉哇凉的，感觉实战能力有所下降......" NOR, me, target);
        target->add("xyzx_sys/level", -expadd);  //2018.3.7阿飞改  三才剑法可以降低对方等级
      }
    } else {
      weapon->move(environment(me));
      message_vision(HIG "\n$n凝神注目，窥破$N这一招心剑，伸出双指夹住了" + weapon->name() + "！\n" NOR, me, target);
      message_vision(HIY "\n“当”的一声，$N手中的" + weapon->name() + "掉在了地上！\n" NOR, me, target);
      me->add("neili", -500);
    }
  }
  me->start_busy(1);
  return 1;
}
void del_cooldown(object me)  //CD写法1
{
  if (!objectp(me)) return;
  if (me->query_temp("cooldown")) {
    me->delete_temp("cooldown");
    tell_object(me, HIM "你呼出一口气，缓缓的将内力收回丹田。\n" NOR);
  }
}
