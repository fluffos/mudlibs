// wugou.c 「普渡众生」
// shang 97/6

#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>

inherit F_SSERVER;

int perform(object me, object target) {
  object *ob, weapon;
  int i, skill, damage1, damage;

  if (!target) target = offensive_target(me);
  if (!target || !target->is_character() || !me->is_fighting(target))
    return notify_fail("「普渡众生」只能在战斗中使用。\n");
  if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "staff")
    return notify_fail("你使用的武器不对。\n");
  if (target && target->query_temp("apply/shade_vision"))
    return notify_fail("对方隐身了，你看不到" + target->query("name") + "。\n");
  if (me->is_busy())
    return notify_fail("你现在正忙着呢！\n");
  if ((int)me->query("neili") < 1000)
    return notify_fail("你内力不够不能使用「普渡众生」。\n");
  if ((int)me->query("jing") < 1000)
    return notify_fail("你的精神太差，无法使用「普渡众生」。\n");
  if ((int)me->query("max_neili") < 100000)
    return notify_fail("你的内力修为还不够高。\n");
  if ((int)me->query_skill("pudu-zhang", 1) < 300)
    return notify_fail("你的普渡杖法火侯还没到，「普渡众生」使不出来。\n");
  if ((int)me->query_skill(
    "hunyuan-yiqi",
    1
  ) < 300 && (int)me->query_skill(
    "yijing-force",
    1
  ) < 300 && (int)me->query_skill(
    "yijinjing",
    1
  ) < 300 && (int)me->query_skill("damo-force", 1) < 300)
    return notify_fail("你佛门内功修为不够，不能使用这一绝技!\n");
  if (me->query_skill_mapped("force") != "yijinjing" && me->query_skill_mapped("force") != "hunyuan-yiqi" && me->query_skill_mapped("force") != "yijing-force" && me->query_skill_mapped("force") != "damo-force")
    return notify_fail("你未使用佛门内功, 不能使用这一绝技 !\n");
  if (me->query_skill_mapped("unarmed") != "pudu-zhang")
    return notify_fail("你没正确激发该技能 。\n");
  if (me->query_temp("autolian"))
    return notify_fail("你正在发动自动连招！\n");
  if (me->query_temp("cooldown"))  //CD写法	2017.9.7添加
    return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");

  skill = me->query_skill("pudu-zhang", 1);
  message_vision(HIY "佛曰：众生皆苦，何人可渡众生？$N使出「普渡众生」，刹时满天都是佛杖。\n" NOR, me);
  me->add("neili", -300);
  me->add("jingli", -300);
  me->set_temp("cooldown", 1);  //CD写法	2017.9.7添加
  call_out("del_cooldown", 3, me);  //CD写法1
  damage1 = me->query_skill("pudu-zhang", 1) * 3 + me->query_skill("staff", 1);
  ob = all_inventory(environment(me));
  for (i = 0; i < sizeof(ob); i++) {
    if (!living(ob[i]) || ob[i] == me) continue;
    if (!ob[i]->is_fighting(me)) continue;
    if (ob[i] == me) continue;
    if (!ob[i]->is_character() || ob[i]->is_corpse()) continue;
    damage = random(damage1 * 3) + damage1 * 3;
    //if( damage > 5000 ) damage = 5001;
    ob[i]->receive_damage("qi", damage, me);
    ob[i]->receive_damage("jing", damage, me);
    tell_object(ob[i], "你觉得眼前一阵杖影，挨了不少下。\n");
    if (userp(me) && me->query("env/no_combat_msg") < 4) tell_object(
      me,
      HIW "该绝招对" + i + "敌人精神的外伤为" + damage + "，内伤为" + damage + "。\n" NOR
    );
    if (!me->is_killing(ob[i])) me->fight_ob(ob[i]);
    if (!ob[i]->is_killing(me)) ob[i]->fight_ob(me);
  }
  me->start_busy(1);
  return 1;
}

void del_cooldown(object me)  //CD写法1
{
  if (!objectp(me)) return;
  if (me->query_temp("cooldown")) {
    me->delete_temp("cooldown");
    tell_object(me, HIM "你呼出一口气，缓缓的将内力收回丹田。\n" NOR);
  }
}
