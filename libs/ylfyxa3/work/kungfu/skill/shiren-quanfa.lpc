string query_skill_name(int level) {
  int i;
  for (i = sizeof(action) - 1; i >= 0; i--)
    if (level >= action[i]["lvl"])
      return action[i]["skill_name"];
}

mapping query_action(object me, object weapon) {
  int level = (int)me->query_skill("shiren-quanfa", 1);

  if (random(6) == 2 && random(level) > 300 && me->query("jiali") > 100) {
    return ([
      "action": HIG "「二重劲!」" + HIW "$N以极快速的连击,在第一击后,$n没产生抵抗力时给予第二击! 。" NOR,
      "attack": 600,
      "parry": 600,
      "dodge": 600,
      "damage": 600,
      "force": 600,
      "skill_name": "二重劲",
      "damage_type": random(2) ? "瘀伤" : "内伤" ]);
  }

  return action[random(sizeof(action))];  //2017.9.4阿飞改，将招式简单点

}

string perform_action_file(string action) {
  return __DIR__ "shiren-quanfa/" + action;
}

mixed hit_ob(object me, object victim, int damage_bonus, int factor, string limb) {
  int ap, dp, damage2;

  dp = (int)victim->query_skill("parry", 1);
  ap = (int)me->query_skill("shiren-quanfa", 1);
  damage2 = (int)me->query_skill("shiren-quanfa", 1);

  if (damage_bonus < 100) return 0;
  if (me->query_skill("shayi-xinfa", 1) < 100) return 0;
  if (me->query("jiali") < 1 || me->query("neili") < 100 || me->query_skill_mapped("force") != "shayi-xinfa") return 0;
  if (damage2 < 10) damage2 = 10;

  if (random(ap) > dp / 10 && me->query("jiali") > 0 && random(5) == 0) {
    victim->receive_wound("qi", damage2 + damage_bonus / 2, me);
    me->add("neili", -100);
    return RED "只见$n$l上鲜血狂奔，已被无形气劲切了开来!\n" NOR;
  }
}


//2017.3.25阿飞封掉ob_hit特效，怀疑与伤害为0的死亡有关      
int ob_hit(object ob, object me, int damage) {
  string msg, *limbs;
  int ap, dp;

  limbs = ob->query("limbs");
  ap = me->query_skill("shiren-quanfa", 1);
  dp = ob->query_skill("dodge", 1);

  if (me->is_busy()) return 1;
  if (damage < 10) return 1;
  if ((int)me->query_skill("shayi-xinfa", 1) < 10 && userp(me)) return 1;
  if (random(ap) > dp / 10
    && me->query_skill_mapped("parry") == "shiren-quanfa"
    && me->query_skill("unarmed") > 150
    && random(me->query_skill("unarmed", 1)) > 150
    && me->query("jiali") > 0) {
    msg = HIG "$N面对$n的攻势。身形一闪，突出狠招!!!。\n" NOR;
    message_vision(msg, me, ob);
    if (random(3) == 0 && ob->query("qi") > 50
      && ob->query("jing") > 50
      && ob->query("eff_qi") > 50
      && ob->query("eff_jing") > 50) {
      msg = HIR "「 隔空击物! 」。$N将二重劲的威力传至远方攻击的$n,用以弥补远距离攻击的不足 。\n" NOR;
      if (!ob->is_busy()) ob->start_busy(2);
      if ((int)ob->query("qi") < 60000) {
        if (ob->query("qi") > ob->query("max_qi") / 5)
          ob->receive_damage("qi", ob->query("qi") / 15, me);
        if (ob->query("eff_qi") > ob->query("max_qi") / 5)
          ob->receive_wound("qi", ob->query("eff_qi") / 15, me);
      } else {
        ob->receive_damage("qi", 5000, me);
        ob->receive_wound("qi", 5000, me);
      }
      msg += damage_msg(damage, "瘀伤");



    } else if (random(3) == 1 && ob->query("qi") > 50
      && ob->query("jing") > 50
      && ob->query("eff_qi") > 50
      && ob->query("eff_jing") > 50) {
      msg = HIR "「仙鹤飞腿!」。$N使出丑鬼直接传授的拳法之一踢向$n! 这踢法已独创一格!!\n" NOR;
      if (!ob->is_busy()) ob->start_busy(2);
      if ((int)ob->query("qi") < 60000) {
        if (ob->query("qi") > ob->query("max_qi") / 5)
          ob->receive_damage("qi", ob->query("qi") / 20, me);
        if (ob->query("eff_qi") > ob->query("max_qi") / 5)
          ob->receive_wound("qi", ob->query("eff_qi") / 20, me);
      } else {
        ob->receive_damage("qi", 4000, me);
        ob->receive_wound("qi", 4000, me);
      }

      msg += damage_msg(damage, "瘀伤");
    } else if (random(3) == 2 && ob->query("qi") > 50
      && ob->query("jing") > 50
      && ob->query("eff_qi") > 50
      && ob->query("eff_jing") > 50) {
      msg = HIR "「喷射火焰!」。$N胃装油袋,用火石制的假牙点火喷出火焰,$n被极大的火焰打中!! \n" NOR;
      if (!ob->is_busy()) ob->start_busy(2);
      if ((int)ob->query("qi") < 60000) {
        if (ob->query("qi") > ob->query("max_qi") / 5)
          ob->receive_damage("qi", ob->query("qi") / 30, me);
        if (ob->query("eff_qi") > ob->query("max_qi") / 5)
          ob->receive_wound("qi", ob->query("eff_qi") / 30, me);
      } else {
        ob->receive_damage("qi", 3500, me);
        ob->receive_wound("qi", 3500, me);
      }
      msg += damage_msg(damage, "瘀伤");
    } else
      msg = HIG "$n认得这招历害,逃了开来，还好无事!。\n" NOR;
    message_vision(msg, me, ob);
    return damage;
  }
}
