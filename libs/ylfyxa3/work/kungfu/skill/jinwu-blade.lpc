int valid_learn(object me) {
  object ob;
  //		if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if ((int)me->query("max_neili") < 50000)
    return notify_fail("你的内力不够，没有办法练金乌刀法。\n");
  if ((int)me->query_skill("xueshan-jianfa", 1) < 300)
    return notify_fail("金乌刀法必须有雪山剑法为根底才能练习。\n");
  if ((int)me->query_skill("bingxue-xinfa", 1) < 300)
    return notify_fail("金乌刀法必须要有冰雪心法才能学习。\n");
  if (me->query("family/family_name") != "凌霄城")
    return notify_fail("你不加入凌霄城，无法学习金乌刀法。\n");
  if (!(ob = me->query_temp("weapon")) || (string)ob->query("skill_type") != "blade")
    return notify_fail("你必须先找一把刀才能练刀法。\n");

  return 1;
}

int valid_enable(string usage) { return usage == "blade" || usage == "parry"; }

string query_skill_name(int level) {
  int i;
  for (i = sizeof(action) - 1; i >= 0; i--)
    if (level >= action[i]["lvl"])
      return action[i]["skill_name"];
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];  //2017.9.4阿飞改，将招式简单点
}

int practice_skill(object me) {
  //		if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if ((int)me->query("qi") < 20
    || (int)me->query("neili") < 10)
    return notify_fail("你的内力或气不够，没有办法练习金乌刀法。\n");
  if (me->query("family/family_name") != "凌霄城")
    return notify_fail("你不加入凌霄城，无法练习金乌刀法。\n");
  me->receive_damage("qi", 10);
  me->add("neili", -5);
  write("你按著所学练了一遍金乌刀法。\n");
  return 1;
}

string perform_action_file(string action) {
  return __DIR__ "jinwu-blade/" + action;
}


mixed hit_ob(object me, object victim, int damage_bonus, int factor, string limb) {
  int level, skill, ap, dp, damage2;
  string msg;
  object weapon;
  weapon = me->query_temp("weapon");
  level = (int)me->query_skill("xueshan-jianfa", 1);
  skill = (int)me->query_skill("bingxue-xinfa", 1);
  ap = (int)me->query_skill("jinwu-blade", 1);
  dp = (int)victim->query_skill("force", 1);
  damage2 = (int)me->query_skill("jinwu-blade", 1);

  if (damage_bonus < 100) return 0;
  if (me->query_skill("bingxue-xinfa", 1) < 100) return 0;
  if (me->query("jiali") < 1 || me->query("neili") < 100 || me->query_skill_mapped("force") != "bingxue-xinfa") return 0;
  if (damage2 < 10) damage2 = 10;

  if (random(6) == 1 && random(ap) > dp / 10 && me->query("jiali") > 0) {
    message_vision(WHT "$N一刀过后，招式突变，竞用刀使出了雪花剑法的招式攻向$n的周身要害！\n" NOR, me, victim);
    if (random(level) > 300 && random(skill) > 300) {
      msg = HIR "看刀．．．．\n" NOR;
      COMBAT_D->do_attack(me, victim, me->query_temp("weapon"), TYPE_REGULAR, msg);
      victim->receive_wound("qi", damage2 * 2 + damage_bonus / 2, me);
      me->add("neili", -100);
      return HIR "$N狂出数刀，手中" + weapon->name() + HIR "竟化为一片" + HIW "雪花。\n" NOR;
    } else {
      victim->receive_wound("qi", damage2 + damage_bonus / 2, me);
      me->add("neili", -100);
      return HIW "只见$n$l上鲜血渗出，六点刀痕布成六角，已被" + weapon->name() + HIW "整整齐齐的刺了六点。\n" NOR;
    }
  }
}
