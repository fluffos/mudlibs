// staff.c
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit SKILL;
int valid_selflearn(object me) {
  return 1;
}

int selflearn_skill(object me) {
  if ((int)me->query("jing") < 10) return 0;
  me->receive_damage("jing", 10);
  me->receive_wound("jing", 10);
  return 1;
}
