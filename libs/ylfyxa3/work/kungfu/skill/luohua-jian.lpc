int valid_enable(string usage) { return (usage == "sword") || (usage == "parry"); }
int valid_learn(object me) {
  //		if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if ((int)me->query("max_neili") < 10000)
    return notify_fail("你的内力不够。\n");
  if ((int)me->query("int", 1) < 30)
    return notify_fail("红花十三剑最早传自燕十三的夺命十三剑，可惜后辈悟性不足，只学到了其皮毛。\n");
  if (me->query("family/family_name") != "红花会")
    return notify_fail("你不是红花会弟子，无法学习本门技能。\n");
  if ((int)me->query_skill("honghua-shengong", 1) < 300)
    return notify_fail("你的红花神功火候太浅。\n");
  if ((int)me->query("score", 1) < 5000)
    return notify_fail("你对我派毫无贡献而言，怎么可能传授你武功呢。\n");
  if (random(100) == 1) me->add("score", -5);
  return 1;
}
mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];  //2017.9.4阿飞改，将招式简单点
}
int practice_skill(object me) {
  object weapon;
  //		if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "sword")
    return notify_fail("你使用的武器不对。\n");
  if (me->query("family/family_name") != "红花会")
    return notify_fail("你不是红花会弟子，无法练习本门技能。\n");
  if ((int)me->query("qi") < 50)
    return notify_fail("你的体力不够练落花十三剑。\n");
  me->receive_damage("qi", 30);
  return 1;
}
string perform_action_file(string action) {
  return __DIR__ "luohua-jian/" + action;
}

mixed hit_ob(object me, object victim, int damage_bonus) {
  int ap, dp, damage2;
  damage2 = (int)me->query_skill("luohua-jian", 1);
  ap = me->query_skill("luohua-jian", 1);
  dp = victim->query_skill("dodge", 1);
  if (damage_bonus < 100) return 0;
  if (me->query_skill("honghua-shengong", 1) < 100) return 0;
  if (me->query("jiali") < 1 || me->query("neili") < 100 || me->query_skill_mapped("force") != "honghua-shengong") return 0;
  if (damage2 < 10) damage2 = 10;

  if (me->query("jiali") > 0
    && me->query_skill_mapped("force") == "honghua-shengong"
    && random(ap) > dp / 10
    && random(5) == 0) {
    victim->receive_wound("qi", damage2 + damage_bonus / 2, me);
    //	if (!victim->is_busy()) victim->start_busy(1);
    me->add("neili", -100);
    return HIW "只听一声惨叫，一股鲜血从$n被割裂的伤口喷出！\n" NOR;
  }
}
