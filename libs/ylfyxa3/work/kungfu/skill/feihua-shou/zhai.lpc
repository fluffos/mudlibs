// zhai.c 飞花摘叶

#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>

inherit F_SSERVER;

int perform(object me, object target) {
  object weapon, weapon2;
  int damage;
  int comb1, comb2;
  int skill1, skill2, neili1, neili2, str1, str2;
  int ap, dp;

  if (!target) target = offensive_target(me);
  if (!target || !target->is_character() || !me->is_fighting(target))
    return notify_fail("「飞花摘叶」只能对战斗中的对手使用。\n");
  if (!objectp(weapon2 = me->query_temp("weapon")) || (string)weapon2->query("skill_type") != "throwing")
    return notify_fail("你没有使用暗器啊。\n");
  if (me->is_busy())
    return notify_fail("你现在正忙着呢！\n");
  if (target && !objectp(weapon = target->query_temp("weapon")))
    return notify_fail("对方没有兵刃，你不用担心。\n");
  if (target && target->query_temp("apply/shade_vision"))
    return notify_fail("对方隐身了，你看不到" + target->query("name") + "。\n");
  if (me->query_skill("feihua-shou", 1) < 300)
    return notify_fail("你的飞花摘叶手等级不够, 不能使用「飞花摘叶」！\n");
  if ((int)me->query_skill("shenghuo-shengong", 1) < 300)
    return notify_fail("你的圣火神功火候不够。\n");
  if (!wizardp(me) && me->query_skill_mapped("force") != "shenghuo-shengong")
    return notify_fail("不使用本门内功，如何使用本门绝学!\n");
  if (me->query("neili") < 1000)
    return notify_fail("你的内力不够，无法使用「飞花摘叶」！\n");
  if ((int)me->query("jingli") < 1000)
    return notify_fail("你的精力不够。\n");
  if (me->query_skill_mapped("throwing") != "feihua-shou")
    return notify_fail("你没正确激发该技能 。\n");
  if (!living(target))
    return notify_fail("对方都已经这样了，还夺什么，去捡好了！\n");
  if (me->query_temp("autolian"))
    return notify_fail("你正在发动自动连招！\n");
  if (me->query_temp("cooldown"))  //CD写法	2017.9.7添加
    return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");

  message_vision(
    CYN "\n$N闪电般伸出右手，瞅准$n武功破绽之处，抓向$n手中的" + weapon->query("name") + CYN "。\n\n" NOR,
    me,
    target
  );
  me->set_temp("cooldown", 1);  //CD写法	2017.9.7添加
  call_out("del_cooldown", 3, me);  //CD写法1
  ap = me->query("xyzx_sys/level") + me->query_skill(
    "feihua-shou",
    1
  ) + me->query_skill("unarmed") + me->query_skill("force");
  dp = target->query("xyzx_sys/level") + target->query_skill("dodge") + target->query_skill("parry");
  skill1 = me->query_skill("feihua-shou");
  skill2 = target->query_skill("parry");
  neili1 = me->query("neili") / 10000;
  neili2 = target->query("neili") / 10000;
  str1 = me->query_str();
  str2 = target->query_str();

  if (random(ap) > dp / 3) {
    message_vision(HIR "$n眼睛一花，手中" + weapon->query("name") + HIR "已被$N反手抓到。\n\n" NOR, me, target);
    comb1 = str1 * neili1 * skill1;
    comb2 = str2 * neili2 * skill2;

    if (comb1 > comb2) {
      message_vision(
        HIW "$n只觉一股寒气自" + weapon->query("name") + HIW "传了过来，整个手臂一阵冰凉，手中" + weapon->query("name") + HIW "脱手而出！\n" NOR,
        me,
        target
      );
      weapon->move(environment(me));
      me->add("neili", -200);
    } else {
      damage = me->query_skill("feihua-shou", 1) * 4 + me->query_skill("throwing", 1);
      damage = damage + random(damage);
      target->receive_damage("qi", damage, me);
      target->receive_wound("qi", damage, me);
      message_vision(
        HIW "$N默运冷月寒气，催动寒冷真气注入" + weapon->query("name") + HIW "，$n见状赶紧催动体内真气与其相抗。\n\n" NOR,
        me,
        target
      );
      message_vision(
        HIG "$N只觉$n手中的" + weapon->query("name") + HIG "传来一阵炎热的气劲，将自己的冷月寒气消弭于无形，只好放手，飘身退开。\n" NOR,
        me,
        target
      );
      me->add("neili", -200);
      if (userp(me) && me->query("env/no_combat_msg") < 4) tell_object(
        me,
        HIW "该绝招对敌人气血的外伤为" + damage + "，内伤为" + damage + "。\n" NOR
      );
    }

  } else {
    message_vision("可是$n的看破了$N的企图，立刻采取守势，飘身躲开$N的攻击。\n", me, target);
    message_vision("谁知$n露出此破绽乃是诱敌，一个变招反而向$N猛攻而至。\n", me, target);
    me->add("neili", -200);
    COMBAT_D->do_attack(target, me, me->query_temp("weapon"));
  }

  me->start_busy(1);
  return 1;
}

void del_cooldown(object me)  //CD写法1
{
  if (!objectp(me)) return;
  if (me->query_temp("cooldown")) {
    me->delete_temp("cooldown");
    tell_object(me, HIM "你呼出一口气，缓缓的将内力收回丹田。\n" NOR);
  }
}
