// qiankundanuoyi.c 乾坤大挪移
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit SKILL;

string *parry_msg = ({
  "$N一招击在$n身上，却被$n暗运乾坤大挪移，将内力尽数移入地下。\n",
  "$n轻轻一带，$N发现自己招数回击过来，吓得往后倒退几步。\n",
  "$n手臂回转，在$N手肘下轻轻一推，$N招数落空。\n",
  "$n右手伸出，在$N手腕上轻轻一拉，$N收势不住，直往前扑去。\n",
  "$n身形不动，$N一招击下，有如石沉大海，不觉呆住了。\n",
  "$n左牵右引，$N如身处漩流，连续转了好几个圈。\n",
  "$n双手回圈，$N只觉得前面好象有一堵墙，再也攻不进去。\n",
  "$n轻轻一转，$N一招击在地上，只打得尘土飞扬。\n",
});

string *dodge_msg = ({
  "$N一招击在$n身上，却被$n暗运乾坤大挪移，将内力尽数移入地下。\n",
  "$n轻轻一带，$N发现自己招数回击过来，吓得往后倒退几步。\n",
  "$n手臂回转，在$N手肘下轻轻一推，$N招数落空。\n",
  "$n右手伸出，在$N手腕上轻轻一拉，$N收势不住，直往前扑去。\n",
  "$n身形不动，$N一招击下，有如石沉大海，不觉呆住了。\n",
  "$n左牵右引，$N如身处漩流，连续转了好几个圈。\n",
  "$n双手回圈，$N只觉得前面好象有一堵墙，再也攻不进去。\n",
  "$n轻轻一转，$N一招击在地上，只打得尘土飞扬。\n",
});

int valid_enable(string usage) {
  return (usage == "parry") || (usage == "dodge");
}

string query_parry_msg(string limb) {
  return parry_msg[random(sizeof(parry_msg))];
}

string query_dodge_msg(string limb) {
  return dodge_msg[random(sizeof(dodge_msg))];
}

int valid_learn(object me) {
  return notify_fail("乾坤大挪移只能通过读 <乾坤大挪移心法>提高。\n");
}

int practice_skill(object me) {
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if (me->query("family/family_name") != "明教")
    return notify_fail("凡练成乾坤大挪移第七层心法必然是我明教中人。。。。\n");
  if ((int)me->query_skill("qiankundanuoyi", 1) < 250)
    return notify_fail("乾坤大挪移只能通过读<<乾坤大挪移>>心法提高。\n");
  return 1;
}


string perform_action_file(string action) {
  return __DIR__ "qiankundanuoyi/" + action;
}

//2017.3.25阿飞封掉ob_hit特效，怀疑与伤害为0的死亡有关
int ob_hit(object ob, object me, int damage) {

  int j, ap, dp, damage1;
  ap = me->query_skill(
    "qiankundanuoyi",
    1
  ) * me->query("dex", 1) + me->query_skill("force") * me->query("con", 1);
  dp = ob->query_skill("dodge", 1) * ob->query("str", 1);

  if (damage < 10) damage = 10;

  if (me->is_busy()
    && random(6) == 0
    && me->query_skill_mapped("force") == "jiuyang-shengong"
    && me->query_skill("qiankundanuoyi", 1) > 500
    && me->query_skill("jiuyang-shengong", 1) > 500
    && me->query("neili") > 1000
    && me->query("family/family_name") == "明教") {
    me->start_busy(1);
    me->add("neili", -100);
    message_vision(HIY "$N同时运转九阳神功和乾坤大挪移心法，似乎淤塞的穴道被挪开了！\n" NOR, me, ob);
  }

  if (random(ap) > dp / 10
    && random(10) == 0
    && me->query("eff_qi") < me->query("max_qi")
    && me->query_skill("qiankundanuoyi", 1) > 500
    && (me->query_skill_mapped("force") == "jiuyang-shengong" || me->query_skill_mapped("force") == "shenghuo-shengong")
    && me->query("neili") > 1000
    && me->query("family/family_name") == "明教") {
    tell_object(me, HIM "\n你运转乾坤大挪移，将之前受到的伤势积累起来！\n" NOR);
    message_vision(HIC "$N突然间大喝一声，将所积蓄的十余掌的力道归并成为一掌迅急拍向$n。" +
      HIC "便如一座大湖在山洪爆发时储满了洪水，猛地里湖堤崩决，洪水急冲而出！\n" +
      HIR "世上原无如此大力，$n倘若受实了，势须立时腕骨、臂骨、肩骨、肋骨一齐折断，连" +
      HIR "血也喷不出来，当场成为一团血肉模糊，死得惨不可言！\n" NOR, me, ob);
    damage1 = 100 + me->query("max_qi") - me->query("eff_qi");
    if (damage1 < 100) damage1 = 100;
    ob->receive_damage("qi", damage1 / 5, me);
    ob->receive_wound("qi", damage1 / 20, me);

  }
  if (random(ap) > dp / 10
    && random(10) == 1
    && me->query("eff_jing") < me->query("max_jing")
    && me->query_skill("qiankundanuoyi", 1) > 500
    && (me->query_skill_mapped("force") == "jiuyang-shengong" || me->query_skill_mapped("force") == "shenghuo-shengong")
    && me->query("neili") > 1000
    && me->query("family/family_name") == "明教") {
    tell_object(me, HIM "\n你运转乾坤大挪移，将之前受到的伤势积累起来！\n" NOR);
    message_vision(HIB "\n$N将乾坤大挪移第七层心法施展出来，顿将先前所积蓄" +
      HIB "的十余道力量归并为一掌，朝$n" HIM "疾拍而出，这便如一座大湖" +
      HIB "在山洪爆发时储满了洪水却突然崩决，洪水急冲而出一般。\n" +
      HIR "只听$n一声惨叫，将$N返回的力道受了个十足，全身喀嚓" +
      HIR "喀嚓一阵脆响，腕骨、臂骨、肩骨、肋骨竟然一齐折断！\n" NOR, me, ob);
    damage1 = 100 + me->query("max_jing") - me->query("eff_jing");
    if (damage1 < 100) damage1 = 100;
    ob->receive_damage("jing", damage1 / 5, me);
    ob->receive_wound("jing", damage1 / 20, me);

  }

  if (random(ap) > dp / 10
    && me->query_skill("qiankundanuoyi", 1) > 200
    && (me->query_skill_mapped("force") == "jiuyang-shengong" || me->query_skill_mapped("force") == "shenghuo-shengong")
    && me->query("neili") > 1000
    && random(6) == 2) {
    message_vision(HIB "$N运起乾坤大挪移心法，周身内劲流转，将$n的真气转移到地下了。\n" NOR, me, ob);
    if (!ob->is_busy()) ob->start_busy(random(2));
    me->add("neili", -100);
    ob->add("neili", -(me->query("jiali") + 100) * 2);
    if (me->query_skill_mapped("force") == "jiuyang-shengong") {
      message_vision(HIR "$N运起九阳神功，内力浑然一体，将$n的内劲反弹回去！\n" NOR, me, ob);
      j = -(damage * 2 + random(damage * 2));
      ob->receive_wound("qi", damage / 100, me);
    }
    if (me->query_skill_mapped("force") == "shenghuo-shengong") {
      message_vision(HIC "$N运起圣火神功，全身真气激发，将$n的内劲削弱了不少！\n" NOR, me, ob);
      j = -(damage + random(damage));
    }
    return j;
  }
}
