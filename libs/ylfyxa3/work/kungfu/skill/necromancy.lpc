#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>

inherit SKILL;

int valid_learn(object me) {
  //		if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if ((int)me->query_skill("longxiang", 1) < (int)me->query_skill("necromancy", 1))
    return notify_fail("你的龙相般若功太低了，无法修炼更高深的降伏法。\n");
  if (me->query("family/family_name") != "雪山寺")
    return notify_fail("你不是雪山寺弟子，无法学习本门技能。\n");
  return 1;
}

int practice_skill(object me) {
  return notify_fail("降伏法只能靠学(learn)来提高。\n");
}
