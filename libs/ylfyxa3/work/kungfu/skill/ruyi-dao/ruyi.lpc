//ruyi.c 如意连环刀

#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>

void remove_effect(object me, int a_amount, int d_amount);

inherit F_SSERVER;
int perform(object me, object target) {
  object weapon, weapon2;
  int extra, i, max, ap, dp, damage, damage1;
  string msg;

  if (!target) target = offensive_target(me);
  if (!target || !target->is_character() || !me->is_fighting(target))
    return notify_fail("「如意连环刀」只能在战斗中使用。\n");
  if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "blade")
    return notify_fail("「如意连环刀」必须用刀才能施展。\n");
  if (me->is_busy())
    return notify_fail("你现在正忙着！\n");
  if (target && target->query_temp("apply/shade_vision"))
    return notify_fail("对方隐身了，你看不到" + target->query("name") + "。\n");
  if ((int)me->query_skill("ruyi-dao", 1) < 300)
    return notify_fail("你的「如意刀法」不够娴熟，不会使用「如意连环刀」。\n");
  if ((int)me->query_skill("beiming-shengong", 1) < 300)
    return notify_fail("你的「北冥神功」不够娴熟，不会使用「如意连环刀」。\n");
  if (!wizardp(me) && me->query_skill_mapped("force") != "beiming-shengong")
    return notify_fail(HIC "不使用本门内功，如何使用本门绝学!\n" NOR);
  if (me->query_skill_mapped("blade") != "ruyi-dao")
    return notify_fail("你没正确激发该技能 。\n");
  if ((int)me->query("max_neili") < 200000)
    return notify_fail("你的内力修为还不够高。\n");
  if ((int)me->query("jingli") < 1000)
    return notify_fail("你的精力不够了。\n");
  if ((int)me->query("neili") < (int)me->query_skill("ruyi-dao", 1) * 4)
    return notify_fail("你的内力不够。\n");
  if (me->query_temp("autolian"))
    return notify_fail("你正在发动自动连招！\n");
  if (me->query_temp("cooldown"))  //CD写法	2017.9.7添加
    return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");

  ap = me->query("xyzx_sys/level") + me->query_skill(
    "ruyi-dao",
    1
  ) + me->query_skill("blade") + me->query_skill("force");
  dp = target->query("xyzx_sys/level") + target->query_skill("dodge") + target->query_skill("parry");
  extra = me->query_skill("ruyi-dao", 1);

  message_vision(HIR "$N豪情比天高，凌波微步嘘空去，哈哈大笑一声，万事如我任逍遥，使出「如意连环刀」！\n" NOR, me, target);
  me->set_temp("cooldown", 1);  //CD写法	2017.9.7添加
  call_out("del_cooldown", 3, me);  //CD写法1		

  max = me->query_skill("ruyi-dao", 1) / 600;
  if (max < 1) max = 1;
  if (me->query("jm/xiaoyao")) {
    if (max > 100) max = 100;
  } else {
    if (max > 50) max = 50;
  }

  me->add_temp("apply/attack", -extra);
  me->add_temp("apply/damage", -extra);
  me->add_temp("apply/strength", -extra);
  msg = HIY "$N一声长笑，只觉世事如意，豪气满胸，哪管什么是非荣辱，反手一刀砍出！\n" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);

  //	me->add_temp("lianzhao", max);	 //2016.6.1阿飞改，增加连招标记，用于削弱连招伤害	
  for (i = 0; i < max; i++) {
    msg = HIR "$N身随刀转，顺手又是一刀！\n" NOR;
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  }
  //	me->delete_temp("lianzhao");  //2016.6.1阿飞改，连招结束取消连招标记
  me->add("neili", -max * 100);
  me->add_temp("apply/attack", extra);
  me->add_temp("apply/damage", extra);
  me->add_temp("apply/strength", extra);
  if (objectp(weapon2 = target->query_temp("weapon"))) {
    if (random(ap) > dp / 3) {
      msg = HIM "\n$p只觉得浑身一热，手掌虎口巨痛，手中" + weapon2->name() + "脱手而出。\n" NOR;
      message_vision(msg, me, target);
      weapon2->move(environment(target));
    } else {
      msg = HIY "\n$p危急中突然伏地翻滚而出，避过了这致命一击，已吓得脸色苍白！\n" NOR;
      message_vision(msg, me, target);
    }
  } else {
    if (random(ap) > dp / 3) {
      damage1 = me->query_skill("ruyi-dao", 1) * 3 + me->query_skill("blade");
      damage = damage1 * 3 + random(damage1 * 3);
      target->add("neili", -damage);
      msg = HIR "\n结果只听见几声喀喀轻响，刀气拂中$n胸口大穴，$n只觉得真气一滞！！！\n" NOR;
      message_vision(msg, me, target);
      if (userp(me) && me->query("env/no_combat_msg") < 4) tell_object(
        me,
        HIW "该绝招杀敌人内力" + damage + "。\n" NOR
      );
    } else {
      msg = HIY "\n$p危急中突然伏地翻滚而出，避过了这致命一击，已吓得脸色苍白！\n" NOR;
      message_vision(msg, me, target);
    }
  }


  me->start_busy(1);
  return 1;
}

void del_cooldown(object me)  //CD写法1
{
  if (!objectp(me)) return;
  if (me->query_temp("cooldown")) {
    me->delete_temp("cooldown");
    tell_object(me, HIM "你呼出一口气，缓缓的将内力收回丹田。\n" NOR);
  }
}
