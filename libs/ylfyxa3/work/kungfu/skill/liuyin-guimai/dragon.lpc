// This is player's own perform (Write by Lonely@nt2)
// Create by 段左助(Rare) at Sat Apr  8 14:47:07 2006
// 六脉龙气(dragon)

#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
#include <condition.h>

#define PFM "「" HIW "六脉龙气" NOR "」"

inherit F_SSERVER;


string *xue_name = ({
  "劳宫穴", "膻中穴", "曲池穴", "关元穴", "曲骨穴", "中极穴",
  "承浆穴", "天突穴", "百会穴", "幽门穴", "章门穴", "大横穴",
  "紫宫穴", "冷渊穴", "天井穴", "极泉穴", "清灵穴", "至阳穴", });
string *weapon_sk = ({
  "sword", "blade", "staff", "whip", "club", "hammer", "axe"
});

int perform(object me, object target) {
  object weapon;
  string msg, wp;
  int ap, dp, i;
  int damage;

  if (!target) target = offensive_target(me);
  if (!target || !target->is_character() || !me->is_fighting(target))
    return notify_fail(PFM "只能对战斗中的对手使用。\n");
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail(PFM "只能空手使用。\n");
  //	if (target && target->query_temp("apply/shade_vision")) 
  //		return notify_fail("对方隐身了，你看不到"+target->query("name")+"。\n"); 		
  if ((int)me->query_skill("kumu-shengong", 1) < 1000)
    return notify_fail("你的枯木神功太低。\n");
  if (me->query_skill_mapped("force") != "kumu-shengong")
    return notify_fail("你所用的内功不对啊！\n");
  if (me->query_skill_mapped("unarmed") != "liuyin-guimai")
    return notify_fail("你没正确激发该技能 。\n");
  if ((int)me->query_skill("liuyin-guimai", 1) < 1000)
    return notify_fail("你六阴鬼脉不够娴熟，难以施展" PFM "。\n");
  if ((int)me->query_skill("liumai-shenjian", 1) < 1000)
    return notify_fail("你六脉神剑不够娴熟，难以施展" PFM "。\n");
  if ((int)me->query_skill("yiyang-zhi", 1) < 1000)
    return notify_fail("你一阳指不够娴熟，难以施展" PFM "。\n");
  if (me->is_busy())
    return notify_fail("你现在正忙着呢！\n");
  if (me->query("neili") < 10000)
    return notify_fail("你现在的真气不够，难以施展" PFM "。\n");
  if (me->query("jingli") < 10000)
    return notify_fail("你现在的精力不够，难以施展" PFM "。\n");
  if (me->query("max_neili") < 1000000)
    return notify_fail("你现在的内力修为不够，难以施展" PFM "。\n");
  if (me->query("max_jingli") < 1000000)
    return notify_fail("你现在的精力修为不够，难以施展" PFM "。\n");
  if (!(int)me->query("breakup"))
    return notify_fail("你任督二脉未通,无法使用「六脉龙气」。\n" NOR);
  if (target && !living(target))
    return notify_fail("对方都已经这样了，用不着这么费力吧？\n");
  if (me->query_temp("autolian"))
    return notify_fail("你正在发动自动连招！\n");
  if (me->query_temp("cooldown"))  //CD写法	2017.9.7添加
    return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");

  message_vision(HBWHT "$N贯通大理武学，使出了大理皇宫的绝学之精髓！\n" NOR, me, target);

  msg = HIW "$N眼中神光湛湛，双手平伸，六大穴之中各自涌出一束剑气，随即$N双手一合，将六束剑气困于掌中，剑气激荡冲撞不止。至气势最盛之时$N双手再分，六道剑气之合竟如狂龙，狂冲$n而去！\n" NOR;
  message_vision(msg, me, target);
  me->set_temp("cooldown", 1);  //CD写法	2017.9.7添加
  call_out("del_cooldown", 5, me);  //CD写法1
  ap = me->query("xyzx_sys/level") + me->query_skill(
    "liuyin-guimai",
    1
  ) + me->query_skill("liumai-shenjian", 1) + me->query_skill("unarmed") + me->query_skill("force");
  dp = target->query("xyzx_sys/level") + target->query_skill("dodge") + target->query_skill("parry");
  damage = me->query_skill(
    "unarmed",
    1
  ) + me->query_skill("liuyin-guimai", 1) + me->query_skill("force");
  if (random(ap) > dp / 3) {
    damage = damage + random(damage);
    target->receive_damage("jing", damage, me);
    target->receive_wound("jing", damage / 2, me);
    msg = HIM "$n眼见狂龙袭来，避无可避，躲无可躲，只得闭目受死。刹那间被龙气吞没，软瘫在地。\n" NOR;
    message_vision(msg, me, target);
    me->add("neili", -200);
    if (userp(me) && me->query("env/no_combat_msg") < 4) tell_object(
      me,
      HIW "该绝招对敌人精神的外伤为" + damage + "，内伤为" + damage / 2 + "。\n" NOR
    );
    //				if (! target->is_busy()) target->start_busy(2);
  } else {
    msg = NOR + CYN "$p见狂龙袭来，竟无畏惧，侧身间，一把抓住龙颈，掌中使力之下，那龙气竟就此散碎了。\n" NOR;
    message_vision(msg, me, target);
    me->add("neili", -100);
  }




  if (objectp(weapon = target->query_temp("weapon"))) {
    wp = weapon->name();
    msg = HIW "突然间";
    msg += "$N" HIW "单指一扬，径点$n" HIW "持着" + wp + NOR + HIW
      "的手腕上「" HIY "腕骨" HIW "」、「" HIY "阳谷" HIW "」"
      "、「" HIY "养老" HIW "」三穴。\n" NOR;
    message_vision(msg, me, target);
    if (random(ap) > dp / 3) {
      msg = HIR "霎时间$n" HIR "只觉得手腕一麻，手中" + wp + HIR "再也拿持不住，脱手掉在地上。\n\n" HIW "紧"
        "接着";
      message_vision(msg, me, target);
      me->add("neili", -300);
      weapon->move(environment(target));
    } else {
      msg = CYN "可是$n" CYN "将手中" + wp + NOR + CYN "转"
        "动如轮，终于化解了这一招。\n\n" HIW "紧接着";
      message_vision(msg, me, target);
      me->add("neili", -100);
    }
  }
  message_vision(msg, me, target);

  if ((int)me->query_skill("liuyin-guimai", 1) > 2000 && me->query_skill("yiyang-zhi", 1) > 2000) {
    damage = me->query_skill(
      "unarmed",
      1
    ) + me->query_skill(
      "liuyin-guimai",
      1
    ) * 5 + me->query_skill("force") + me->query_skill("liumai-shenjian", 1) * 3;
    damage = damage + random(damage);
    msg = HIW "突然间";
    msg += "$N" HIW "凝气于指，一式「" HIR "阳关三叠" HIW "」点出，顿时一股"
      "纯阳的内力直袭$n" HIW "胸口！\n" NOR;
    message_vision(msg, me, target);
    if (random(ap) > dp / 4) {
      target->receive_damage("jing", damage, me);
      target->receive_wound("jing", damage / 2, me);
      if (userp(me) && me->query("env/no_combat_msg") < 4) tell_object(
        me,
        HIW "该绝招对敌人精神的外伤为" + damage + "，内伤为" + damage / 2 + "。\n" NOR
      );

      msg = HIR "结果$n" HIR "被$N" HIR "一指点中"
        HIY + xue_name[random(sizeof(xue_name))] +
        HIR "，全身真气逆流而上，登时呕出一大"
        "口鲜血。\n" NOR;
      message_vision(msg, me, target);
      target->add_temp("liumai-shenjian/die", 1);
    } else {
      msg = CYN "可是$p" CYN "镇定自如，全力化解了$P"
        CYN "这精妙的一指。\n" NOR;
      message_vision(msg, me, target);
    }


    msg = "\n" HIW "接着$N" HIW "踏前一步，体内真气迸发，隔空一指劲点$n" HIW
      "而去，指气纵横，嗤然作响！\n" NOR;
    message_vision(msg, me, target);
    if (random(ap) > dp / 3) {
      target->receive_damage("jing", damage, me);
      target->receive_wound("jing", damage / 2, me);
      if (userp(me) && me->query("env/no_combat_msg") < 4) tell_object(
        me,
        HIW "该绝招对敌人精神的外伤为" + damage + "，内伤为" + damage / 2 + "。\n" NOR
      );

      msg = HIR "结果$n" HIR "被$N" HIR "一指点中"
        HIY + xue_name[random(sizeof(xue_name))] +
        HIR "，全身真气逆流而上，登时呕出一大"
        "口鲜血。\n" NOR;
      message_vision(msg, me, target);
      target->add_temp("liumai-shenjian/die", 1);
    } else {
      msg = CYN "可是$p" CYN "镇定自如，全力化解了$P"
        CYN "这精妙的一指。\n" NOR;
      message_vision(msg, me, target);
    }


    msg = "\n" HIW "最后$N" HIW "一声猛喝，单指“嗤”的一声点出，纯阳指力同"
      "时笼罩$n" HIW "全身诸多要穴！\n" NOR;
    message_vision(msg, me, target);
    if (random(ap) > dp / 2) {
      target->receive_damage("jing", damage, me);
      target->receive_wound("jing", damage / 2, me);
      if (userp(me) && me->query("env/no_combat_msg") < 4) tell_object(
        me,
        HIW "该绝招对敌人精神的外伤为" + damage + "，内伤为" + damage / 2 + "。\n" NOR
      );

      msg = HIR "结果$n" HIR "被$N" HIR "一指点中"
        HIY + xue_name[random(sizeof(xue_name))] +
        HIR "，全身真气逆流而上，登时呕出一大"
        "口鲜血。\n" NOR;
      message_vision(msg, me, target);
      target->add_temp("liumai-shenjian/die", 1);
    } else {
      msg = CYN "可是$p" CYN "镇定自如，全力化解了$P"
        CYN "这精妙的一指。\n" NOR;
      message_vision(msg, me, target);
    }


    if (target->query_temp("liumai-shenjian/die") == 3 && target->query("neili")) {
      msg = HIY "\n$n" HIY "被$N" HIY "三指连中，全身真气涣"
        "散，宛如黄河决堤，内力登时狂泻而出。\n\n" NOR;
      message_vision(msg, me, target);
      if (userp(target)) {
        target->add("neili", -damage);
        target->apply_condition("no_enforce", 10);
        if (userp(me) && me->query("env/no_combat_msg") < 4) tell_object(
          me,
          HIW "该绝招杀敌人内力" + damage + "。\n" NOR
        );
      } else {
        target->add("neili", -2000);
        //	        if (!target->is_busy()) target->start_busy(4);
      }
    }
    target->delete_temp("liumai-shenjian/die");

  }
  if ((int)me->query_skill("liuyin-guimai", 1) > 3000 && me->query_skill("yiyang-zhi", 1) > 3000) {
    if (!target->query("neili")) tell_object(target, HIC "你只觉丹田内竟似空空如也，一时说不出的难受。\n" NOR);
    msg = HIR "紧接着$N" HIR "十指纷飞，接连弹出数道无形剑气，$n" HIR "四面八方皆被剑气所笼罩。\n" NOR;
    message_vision(msg, me, target);
    if (me->query("jm/dali")) damage = me->query_skill(
      "unarmed",
      1
    ) + me->query_skill(
      "kumu-shengong",
      1
    ) * me->query(
      "int",
      1
    ) / 2 + me->query_skill(
      "yiyang-zhi",
      1
    ) * me->query(
      "con",
      1
    ) / 2 + me->query_skill(
      "liuyin-guimai",
      1
    ) * me->query(
      "dex",
      1
    ) / 2 + me->query_skill(
      "liumai-shenjian",
      1
    ) * me->query("con", 1) / 2 + me->query_skill("force", 1) + me->query("qi") / 200;
    else damage = me->query_skill(
      "unarmed",
      1
    ) + me->query_skill(
      "kumu-shengong",
      1
    ) * me->query(
      "int",
      1
    ) / 3 + me->query_skill(
      "yiyang-zhi",
      1
    ) * me->query(
      "con",
      1
    ) / 3 + me->query_skill(
      "liuyin-guimai",
      1
    ) * me->query(
      "dex",
      1
    ) / 3 + me->query_skill(
      "liumai-shenjian",
      1
    ) * me->query("con", 1) / 3 + me->query_skill("force", 1) + me->query("qi") / 320;

    for (i = 0; i < 6; i++) {
      msg = HIR "$N第" + chinese_number(i + 1) + "指点向━━━━$n的" HIY + xue_name[random(sizeof(xue_name))] + HIR "\n" NOR;
      COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
      damage = damage + random(damage);
      target->receive_damage("jing", damage, me);
      target->receive_wound("jing", damage / 2, me);
      if (userp(me) && me->query("env/no_combat_msg") < 4) tell_object(
        me,
        HIW "该绝招对敌人气血的外伤为" + damage + "，内伤为" + damage / 2 + "。\n" NOR
      );
    }
    me->add("neili", -1000);
  }
  me->start_busy(1);
  return 1;
}

void del_cooldown(object me)  //CD写法1
{
  if (!objectp(me)) return;
  if (me->query_temp("cooldown")) {
    me->delete_temp("cooldown");
    tell_object(me, HIM "你呼出一口气，缓缓的将内力收回丹田。\n" NOR);
  }
}
