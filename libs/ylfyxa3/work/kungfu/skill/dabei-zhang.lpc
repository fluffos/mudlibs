//大悲掌 中乘武学200~600
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit SKILL;
mapping *action = ({
  ([ "action": "$N连续上步，一式「" + YEL + "大慈大悲" + NOR + "」，左右手分靠，变拳为掌，击向$n的$l",
    "attack": 200,
    "parry": 200,
    "dodge": 200,
    "damage": 200,
    "force": 200,
    "lvl": 0,
    "skill_name": YEL "大慈大悲" NOR,
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N左脚虚踏，全身右转，一招「" + RED + "悲从心生" + NOR + "」，右掌猛地插向$n的$l",
    "attack": 300,
    "parry": 300,
    "dodge": 300,
    "damage": 300,
    "force": 300,
    "lvl": 8,
    "skill_name": RED "悲从心生" NOR,
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N使一招「" + HIB + "苦海回头" + NOR + "」，上身前探，双手划了个半圈，击向$n的$l",
    "attack": 400,
    "parry": 400,
    "dodge": 400,
    "damage": 400,
    "force": 400,
    "lvl": 33,
    "skill_name": HIB "苦海回头" NOR,
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N双掌划弧，一记「" + HIY + "回头是岸" + NOR + "」，掌出如电，一下子切到$n的手上",
    "attack": 500,
    "parry": 500,
    "dodge": 500,
    "damage": 500,
    "force": 500,
    "lvl": 42,
    "skill_name": GRN "回头是岸" NOR,
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N施出「" + WHT + "苦海无边" + NOR + "」，双拳拳出如风，同时打向$n头，胸，腹三处要害",
    "attack": 600,
    "parry": 600,
    "dodge": 600,
    "damage": 600,
    "force": 600,
    "lvl": 50,
    "skill_name": WHT "苦海无边" NOR,
    "damage_type": "瘀伤"
  ]),
});
int valid_enable(string usage) {
  return usage == "parry" || usage == "unarmed" || usage == "strike";
}
int practice_level() { return 58; }
int valid_learn(object me) {
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");		
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("学大悲掌必须空手。\n");
  if (me->query("family/family_name") != "通吃帮")
    return notify_fail("你未加入通吃帮，无法领悟本门技能的精髓。\n");
  if ((int)me->query("max_neili") < 10000)
    return notify_fail("你的内力太弱，无法练大悲掌。\n");
  if (me->query_skill("unarmed", 1) <= me->query_skill("dabei-zhang", 1))
    return notify_fail("你的掌法基础不够，无法领会更高深的技巧。\n");
  if ((int)me->query_skill("fanyun-force", 1) < 100 && (int)me->query_skill("damo-force", 1) < 100)
    return notify_fail("你的本门内功太低，无法钻研更高深的大悲掌。\n");
  if ((int)me->query("score", 1) < 5000)
    return notify_fail("你对我派毫无贡献而言，怎么可能传授你武功呢。\n");
  if (random(100) == 1) me->add("score", -5);
  return 1;
}
string query_skill_name(int level) {
  int i;
  for (i = sizeof(action) - 1; i >= 0; i--)
    if (level >= action[i]["lvl"])
      return action[i]["skill_name"];
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];  //2017.9.4阿飞改，将招式简单点
}

int practice_skill(object me) {
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");		
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练大悲掌必须空手。\n");
  if (me->query("family/family_name") != "通吃帮")
    return notify_fail("你未加入通吃帮，无法练习大悲掌。\n");
  if ((int)me->query("qi") < 30)
    return notify_fail("你的体力太低了。\n");
  if ((int)me->query("neili") < 20)
    return notify_fail("你的内力不够练大悲掌。\n");
  me->receive_damage("qi", 25);
  me->add("neili", -5);
  return 1;
}

string perform_action_file(string action) {
  return __DIR__ "dabei-zhang/" + action;
}

mixed hit_ob(object me, object victim, int damage_bonus) {
  int flag, damage2, ap, dp;
  flag = 1;
  damage2 = (int)me->query_skill("dabei-zhang", 1);
  ap = me->query_skill("dabei-zhang", 1);
  dp = victim->query_skill("force", 1);
  if (damage_bonus < 100) return 0;
  if (me->query_skill("fanyun-force", 1) < 100 && me->query_skill("damo-force", 1) < 100) return 0;
  if (me->query("jiali") < 1 || me->query("neili") < 100 || (me->query_skill_mapped("force") != "fanyun-force" && me->query_skill_mapped("force") != "damo-force")) return 0;
  if (damage2 < 10) damage2 = 10;
  if (me->query_skill_mapped("force") == "damo-force") flag = 2;
  if (me->query("jiali") > 0
    && random(ap) > dp / 10
    && random(6) == 2) {
    victim->receive_wound("qi", damage2 * flag + damage_bonus / 2, me);
    victim->receive_damage("qi", damage2 * flag + damage_bonus / 2, me);
    me->add("neili", -100);
    return HIW "$N神情悲苦，愁容满面！$n被$N的悲伤之气感染，顿时吐出一口淤血！\n" NOR;
    //		if (!victim->is_busy()) victim->start_busy(2);
  }
}
