// jiuyin-zhenjing.c 九阴真经	上乘武学400~1000
// By Hop
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
#include <condition.h>
inherit FORCE;

int valid_enable(string usage) { return usage == "force"; }
int valid_learn(object me) {
  mapping skl;
  string *sname;
  int i;
  int lvl = (int)me->query_skill("jiuyin-zhenjing", 1);
  //		if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if (me->query("gender") == "无性")
    return notify_fail("你无根无性，阴阳不调，难以领会高深的九阴真经。\n");
  if (me->query("gender") != "女性")
    return notify_fail("九阴真经需要阴柔体质，不适合你学。\n");
  if (me->query("couple"))
    return notify_fail("你元气已失，不能领悟九阴真经的奥妙之处。\n");
  if (me->query("make_loves"))
    return notify_fail("你元气已失，不能领悟九阴真经的奥妙之处。\n");
  if (me->query_skill("force", 1) <= lvl)
    return notify_fail("你的基本内功基础不够，再学下去会走火入魔的。\n");
  if (me->query_skill("force", 1) < 500)
    return notify_fail("你的基本内功基础不够，怎能学九阴真经。\n");
  if ((int)me->query("score", 1) < 10000)
    return notify_fail("你对我派毫无贡献而言，怎么可能传授你武功呢。\n");

  skl = this_player()->query_skills();
  sname = keys(skl);
  for (i = 0; i < sizeof(skl); i++) {
    if (sname[i] == "jiuyin-zhenjing") continue;
    if (sname[i] == "yijing-force") continue;
    if (sname[i] == "xixing-dafa") continue;
    if (SKILL_D(sname[i])->valid_enable("force"))
      return notify_fail("你不先散了别派内功，怎能学九阴真经？！\n");
  }
  if (random(10) == 1) me->add("score", -10);
  return 1;
}
mixed hit_ob(object me, object victim, int damage_bonus, int factor) {
  object ob = victim->query_temp("armor/finger");
  int ap, dp, damage2;
  ap = me->query("jingli");
  dp = victim->query("jingli");
  damage2 = (int)me->query_skill("jiuyin-zhenjing", 1);
  if (me->query("couple") || me->query("make_loves")) return 0;
  if (damage_bonus < 100) return 0;
  if (me->query_skill("jiuyin-zhenjing", 1) < 100) return 0;
  if (me->query("jiali") < 1 || me->query("neili") < 100 || me->query_skill_mapped("force") != "jiuyin-zhenjing") return 0;
  if (damage2 < 10) damage2 = 10;
  if (random(ap) > dp / 15 && random(6) == 0 && me->query_skill_mapped("force") == "jiuyin-zhenjing") {
    message_vision(HIR "$N阴阴地笑了几声，$n忽然感觉到$N一股阴柔的内力侵入体内！$n面容扭曲吐出一口鲜血！\n" NOR, me, victim);
    if (objectp(ob)) {
      if (ob->query("id") == "tianmo ring") {
        damage2 = damage2 / 5;
        message_vision(HIR "$n的天魔戒削弱了$N九阴真经的伤害！！！！\n" NOR, me, victim);
      }
    }
    victim->apply_condition("no_perform", 10);
    victim->apply_condition("no_enforce", 10);
    victim->receive_wound("jing", damage2 * 2 + damage_bonus / 2, me);
    victim->receive_wound("qi", (int)me->query("jiali"), me);
    victim->add("neili", -(int)me->query("jiali"));
    me->add("neili", -100);
  }
}
int practice_skill(object me) {
  return notify_fail("九阴真经只能用学(learn)的来增加熟练度。\n");
}
string exert_function_file(string func) {
  return __DIR__ "jiuyin-zhenjing/" + func;
}

