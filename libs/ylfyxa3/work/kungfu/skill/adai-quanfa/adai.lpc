//参考maessage.c 要想显示出伤害数值，必须要满足5个条件  采用这种方式可以显示伤害数值
//msg  me target damage typedef

#include <ansi.h>

inherit F_SSERVER;
int perform(object me, object target) {
  int damage;
  string msg;
  object weapon;

  if (!target) target = offensive_target(me);
  if (objectp(weapon = me->query_temp("weapon")))
    return notify_fail(RED "开什么玩笑，拿着武器还想使「阿呆」？\n" NOR);
  if (!target || !target->is_character() || !me->is_fighting(target))
    return notify_fail("「阿呆」只能对战斗中的对手使用。\n");
  if ((int)me->query_skill("adai-quanfa", 1) < 100)
    return notify_fail(WHT "你的回风拂柳剑法不够娴熟，还使不出「阿呆」。\n" NOR);
  if ((int)me->query("max_neili") < 10000)
    return notify_fail(RED "你的内力修为不足，无法运足「阿呆」的内力。\n" NOR);
  if ((int)me->query("neili") < 1000) {
    return notify_fail(HIC "你现在内力不够，没能将「阿呆」使完！\n" NOR);
  }
  msg = HIC "$N手中长剑剑芒跃动，剑光暴长，幻出死亡的色彩，剑尖渐\n" NOR;
  msg += HIC "渐逼近$n，$n看到漫天剑光，抽身后跃，只这一刹，漫天剑\n" NOR;
  msg += HIC "影化为一剑直刺$n前胸，快捷无伦，只有一剑！\n" NOR;
  if (random(me->query_skill("unarmed")) > target->query_skill("force") / 2 || random(me->query("xyzx_sys/level")) > (int)target->query("xyzx_sys/level") / 3) {
    me->start_busy(2);
    target->start_busy(2 + random(3));
    damage = (int)me->query_skill("adai-quanfa", 1);
    damage = damage + random(damage);
    target->receive_damage("qi", damage / 2, me);
    target->receive_wound("qi", damage, me);
    target->receive_damage("jing", damage, me);
    target->receive_wound("jing", damage / 2, me);
    msg += HIC "$n根本没法躲避，一式「回风拂柳剑」的绝招「灭剑」端端正\n" NOR;
    msg += HIC "正扎进在$n胸口！$n一低头，看长剑自胸口拔出！\n" NOR;
    me->add("neili", -200);
  } else {
    me->start_busy(2);
    msg += HIY "可是$p轻轻一笑，侧身右转，伸出两指，正弹在$P的剑上，长\n" NOR;
    msg += HIY "剑在$p身侧划过，毫发无伤。\n" NOR;
    me->add("neili", -200);
  }
  //	message_vision(msg, me, target);
  message_vision(msg, me, target, damage, "剑伤");  //这样就满足了
  //当然 "剑伤" 也不是必须的，可以在maessage.c里去定义if (!type) type = "伤害";
  //这样如果没有伤害类型或者没写伤害类型，就自动填补为 "伤害" 
  //平招有，是因为在战斗精灵里，已经填写了这些
  if (!target->is_fighting(me)) target->fight_ob(me);
  //	if(userp(target)) target->fight_ob(me);
  //	else if( !target->is_killing(me) ) target->kill_ob(me);
  return 1;
}
