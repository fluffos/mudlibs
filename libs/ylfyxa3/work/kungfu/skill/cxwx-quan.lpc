// 痴心妄想拳 下乘武学100~300
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit SKILL;

mapping *action = ({
  ([ "action": "$N使一招「" HIM "痴心一片" NOR "」，双拳飘移不定击向$n$l",
    "attack": 100,
    "parry": 100,
    "dodge": 100,
    "damage": 100,
    "force": 100,
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N倏忽欺至$n身前，一招「" HIB "妄想成狂" NOR "」直拍$n的$l",
    "attack": 200,
    "parry": 200,
    "dodge": 200,
    "damage": 200,
    "force": 200,
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N身形绕$n一转，一招「" HIY "临渊羡鱼" NOR "」向$n$l接连出拳",
    "attack": 200,
    "parry": 200,
    "dodge": 200,
    "damage": 200,
    "force": 200,
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N身形拔起，在半空一招「" MAG "难言之隐" NOR "」右掌猛击$n的$l",
    "attack": 300,
    "parry": 300,
    "dodge": 300,
    "damage": 300,
    "force": 300,
    "damage_type": "瘀伤"
  ]),
});


int valid_enable(string usage) { return usage == "unarmed" || usage == "parry"; }

int valid_learn(object me) {
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");		
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练痴心妄想拳必须空手。\n");
  if (me->query("family/family_name") != "痴心妄想门")
    return notify_fail("你不是本门中人，无法领悟本门技能的精髓。\n");
  if ((int)me->query_skill("wangran-xinfa", 1) < 100)
    return notify_fail("你的枉然心法不够，无法学习痴心妄想拳。\n");
  if ((int)me->query("max_neili") < 10000)
    return notify_fail("你的内力太弱，无法练痴心妄想拳。\n");
  return 1;
}

mixed hit_ob(object me, object victim, int damage_bonus) {
  int ap, dp, damage2;
  ap = me->query("str", 1) * me->query_skill("cxwx-quan", 1);
  dp = victim->query("int", 1) * victim->query_skill("dodge", 1);
  damage2 = (int)me->query_skill("cxwx-quan", 1);
  if (damage_bonus < 100) return 0;
  if (me->query_skill("wangran-xinfa", 1) < 100) return 0;
  if (me->query("jiali") < 1 || me->query("neili") < 100 || me->query_skill_mapped("force") != "wangran-xinfa") return 0;
  if (damage2 < 10) damage2 = 10;
  if (random(ap) > dp / 10 && me->query_skill_mapped("force") == "wangran-xinfa" && random(6) == 0 && me->query("jiali") > 0) {
    victim->receive_wound("qi", damage2 + damage_bonus / 2, me);
    me->add("neili", -100);
    return HIR "只听到「" HIY "" BLINK "轰" NOR "" HIR "」的一声巨响，$n" HIR "胸口深深的凹陷下去！\n" NOR;
  }
}

mapping query_action(object me, object target, object weapon) {
  if (random(me->query_skill("cxwx-quan", 1)) > 399 && me->query("neili") > 300 && random(5) == 0) {
    me->add("neili", -150);
    return ([
      "action": "" HIG "忽然$N灵光闪现，双拳交叉乱舞，每一拳都出现在不可思议的位置。\n"
      "$n" HIG "顿时手忙脚乱，无数拳点落在身上，让$N一顿乱拳打的找不着北。\n" NOR "",
      "attack": 300,
      "parry": 300,
      "dodge": 300,
      "damage": 3200,
      "force": 300,
      "damage_type": "内伤" ]);

    if (!target->is_busy()) target->start_busy(2);
  }

  return action[random(sizeof(action))];
}

int practice_skill(object me) {
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");		
  if (me->query("family/family_name") != "痴心妄想门")
    return notify_fail("你不是本门中人，无法练习本门技能的精髓。\n");
  if ((int)me->query("qi") < 40)
    return notify_fail("你的体力太低了。\n");
  if ((int)me->query("neili") < 10)
    return notify_fail("你的内力不够了！休息一下再练吧。\n");
  me->receive_damage("qi", 30);
  me->add("neili", -5);
  return 1;
}
string perform_action_file(string action) {
  return __DIR__ "cxwx-quan/" + action;
}
