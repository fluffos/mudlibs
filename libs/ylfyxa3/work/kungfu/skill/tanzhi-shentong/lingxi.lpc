#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
#include <condition.h>
#include "/kungfu/skill/eff_msg.h";
#define ZHUAN "「" HIR "灵犀一指" NOR "」"

inherit F_SSERVER;
string *xue_name1 = ({
  "大锥穴",
  "百会穴",
  "志室穴",
  "肩井穴",
  "劳宫穴",
  "内关穴",
  "外关穴",
  "会宗穴",
});
string *xue_name2 = ({
  "曲池穴",
  "冲阳穴",
  "臂儒穴",
  "白海穴",
  "灵台穴",
  "风府穴",
  "神风穴",
  "玉书穴",
});
string *xue_name3 = ({
  "青门穴",
  "商阳穴",
  "丝空竹穴",
  "气海穴",
  "冲门穴",
  "大椎穴",
  "百里穴",
  "槐阳穴",
});
string *xuedao = ({
  "巨骨穴",
  "地仓穴",
  "肩井穴",
  "颊车穴",
  "承泣穴",
  "风池穴",
  "章门穴",
  "风府穴",
  "精促穴",
  "陶道穴",
  "强间穴",
  "少海穴",
  "犊鼻穴",
  "神门穴",
  "华盖穴",
  "大椎穴",
  "凤尾穴",
  "至阳穴",
  "劳宫穴",
  "百会穴",
  "灵台穴",
  "太阳穴",
  "膻中穴",
  "命门穴",
  "鸠尾穴",
  "三阴交",
  "天柱穴"
});
int perform(object me, object target) {
  object weapon;
  int ap, dp, damage, skill;
  string msg;

  if (!target) target = offensive_target(me);
  if (!target || !target->is_character() || !me->is_fighting(target))
    return notify_fail(ZHUAN "只能对战斗中的对手使用。\n");
  if (objectp(weapon = me->query_temp("weapon")) || objectp(weapon = me->query_temp("secondary_weapon")))
    return notify_fail(ZHUAN "只能空手施展。\n");
  //	if (target && target->query_temp("apply/shade_vision")) 
  //		return notify_fail("对方隐身了，你看不到"+target->query("name")+"。\n"); 		
  if (me->is_busy())
    return notify_fail("你现在正忙着呢，哪有空运功？\n");
  if ((int)me->query_skill("tanzhi-shentong", 1) < 1000)
    return notify_fail("你的弹指神通不够娴熟，难以施展" ZHUAN "。\n");
  if ((int)me->query_skill("yuxiao-jianfa", 1) < 1000)
    return notify_fail("你的玉箫剑法不够娴熟，难以施展" ZHUAN "。\n");
  if ((int)me->query_skill("qimen-wuxing", 1) < 1000)
    return notify_fail("你的奇门五行修为不够，难以施展" ZHUAN "。\n");
  if (me->query_skill_mapped("unarmed") != "tanzhi-shentong")
    return notify_fail("你没有激发弹指神通，难以施展" ZHUAN "。\n");
  if (me->query_skill_mapped("force") != "bibo-shengong")
    return notify_fail("你没有激发碧波神功，难以施展" ZHUAN "。\n");
  if ((int)me->query_skill("bibo-shengong", 1) < 1000)
    return notify_fail("你的碧波神功火候太浅。\n");
  if ((int)me->query_skill("count", 1) < 1000)
    return notify_fail("你的阴阳八卦火候太浅。\n");
  if (me->query("max_neili") < 500000)
    return notify_fail("你的内力修为不足，难以施展" ZHUAN "。\n");
  if ((int)me->query("max_jingli") < 500000)
    return notify_fail("你的精力修为不够。\n");
  if ((int)me->query("jingli") < 10000)
    return notify_fail("你的精力不够。\n");
  if (me->query("neili") < 10000)
    return notify_fail("你现在的真气不够，难以施展" ZHUAN "。\n");
  //	if (!(int)me->query("breakup"))
  //       return notify_fail("你任督二脉未通,无法使用「灵犀一指」！\n"NOR); 
  if (target && !living(target))
    return notify_fail("对方都已经这样了，用不着这么费力吧？\n");
  if (me->query_temp("autolian"))
    return notify_fail("你正在发动自动连招！\n");
  if (me->query_temp("cooldown"))  //CD写法	2017.9.7添加
    return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");

  //	message_vision(HBWHT "$N贯通桃花岛武学，使出了桃花岛的绝学之精髓！\n" NOR, me, target);
  me->set_temp("cooldown", 1);  //CD写法	2017.9.7添加
  call_out("del_cooldown", 5, me);  //CD写法1	 
  message_vision(HIR "\n$N长啸一声，强运真气冲丹田，贯百会，倾刻间气走百穴，一连打通十二道生死玄关，面色殷红如血，嘴脚隐然有血丝沁出，\n", me, target);
  msg = HIC "$N" HIC "将全身功力聚于一指，指劲按照二十八宿方位云贯而出，正是桃花岛「" HIR "灵犀一指" HIC "」绝技。\n" NOR;
  message_vision(msg, me, target);
  skill = (int)me->query_skill("tanzhi-shentong", 1);
  ap = me->query("xyzx_sys/level") + me->query_skill(
    "tanzhi-shentong",
    1
  ) + me->query_skill("yuxiao-jianfa", 1) + me->query_skill("unarmed") + me->query_skill("force");
  dp = target->query("xyzx_sys/level") + target->query_skill("dodge") + target->query_skill("parry");
  damage = me->query_skill(
    "yuxiao-jianfa",
    1
  ) + me->query_skill("tanzhi-shentong", 1) + me->query_skill("force");
  damage = damage + random(damage);
  if (random(ap) > dp / 3) {
    if (me->query("max_neili") > target->query("max_neili") * 2) {
      msg = HIR "霎那间$n" HIR "只见寒芒一闪，$N" HIR "食指"
        "已钻入$n" HIR "印堂半尺，指劲顿时破脑而入。\n"
        HIW "你听到“噗”的一声，身上竟然溅到几滴脑浆！"
        "\n" NOR "( $n" RED "受伤过重，已经有如风中残烛"
        "，随时都可能断气。\n" NOR;
      message_vision(msg, me, target);
      me->add("neili", -1000);
      me->add("jingli", -1000);
      target->receive_damage("qi", damage * 3, me);
      target->receive_wound("qi", damage * 2, me);
      if (userp(me) && me->query("env/no_combat_msg") < 4) tell_object(
        me,
        HIW "该绝招对敌人气血的外伤为" + damage * 3 + "，内伤为" + damage * 2 + "。\n" NOR
      );
    } else {
      msg = HIR "霎那间$n" HIR "只见寒芒一闪，$N"
        HIR "食指已钻入$n" HIR "胸堂半尺，指劲"
        "顿时破体而入。\n你听到“嗤”的一声，"
        "身上竟然溅到几滴鲜血！\n" NOR;
      message_vision(msg, me, target);
      me->add("neili", -1000);
      me->add("jingli", -1000);
      target->receive_damage("qi", damage, me);
      target->receive_wound("qi", damage, me);
      if (userp(me) && me->query("env/no_combat_msg") < 4) tell_object(
        me,
        HIW "该绝招对敌人气血的外伤为" + damage + "，内伤为" + damage + "。\n" NOR
      );
    }
  } else {
    me->add("neili", -300);
    msg = CYN "$n" CYN "见$N" CYN "招式奇特，不感大意，顿时向后跃数丈，躲闪开来。\n" NOR;
    message_vision(msg, me, target);
  }



  if (me->query_skill("tanzhi-shentong", 1) > 2000 && me->query_skill("yuxiao-jianfa", 1) > 2000) {
    msg = CYN "$N双手一前一后，缓缓伸出，中指突地一弹，两道劲风汇成一股，“咝咝”有声，直袭$n前胸。\n";
    msg += HIG "\n紧跟着 突然间$N" HIG "指锋一转，力聚指尖“嗤”的弹出一道紫芒，直袭$n"
      HIG "的" + xue_name2[random(sizeof(xue_name2))] + "。\n" NOR;
    message_vision(msg, me, target);
    damage = me->query_skill(
      "yuxiao-jianfa",
      1
    ) + me->query_skill(
      "tanzhi-shentong",
      1
    ) + me->query_skill("force") + me->query_skill(
      "sword",
      1
    ) + me->query_skill(
      "unarmed",
      1
    ) + me->query("jiali") + target->query_skill("force") + target->query_skill("parry") + target->query("jiali");
    damage = damage + random(damage) + 1000;
    if (random(ap) > dp / 3) {
      msg = "$n向旁边一闪，让过了劲风，没想到这股指劲竟然有回力，从$n背后倒转回来，正刺中$p的后背。\n";
      msg += HIR "$n" HIR "只觉$N" HIR "指风袭体，随即上体一阵冰凉，顿感真气涣散几欲晕厥。\n" NOR;
      message_vision(msg, me, target);
      target->receive_damage("jing", damage, me);
      target->receive_wound("jing", damage / 2, me);
      target->add("neili", -damage);
      if (target->query("neili") < 0) target->set("neili", 0);
      me->add("neili", -2000);
      me->add("jingli", -2000);
      if (userp(me) && me->query("env/no_combat_msg") < 4) tell_object(
        me,
        HIW "该绝招对敌人精神的外伤为" + damage + "，内伤为" + damage + "，杀内力" + damage + "。\n" NOR
      );

    } else {
      me->add("neili", -500);
      msg += CYN "可是$n" CYN "防守严密，紧守门户，顿时令$N"
        CYN "的攻势化为乌有。\n" NOR;
      message_vision(msg, me, target);
    }

  }

  if (me->query_skill("tanzhi-shentong", 1) > 3000 && me->query_skill("yuxiao-jianfa", 1) > 3000) {
    message_vision(
      HIG "$N四周劲风四射，身行冲天而起，犹如凤舞九天，十指连弹，响起阵阵龙吟，攻势凌厉刚猛，无所不至，已全然不顾自身安危！\n" NOR,
      me,
      target
    );
    msg = HIC "\n最后$N" HIC "合指轻弹，只听破空声大作，一枚石子疾速飞出，打向$n的" + xue_name3[random(sizeof(xue_name3))] + "。\n" NOR;
    message_vision(msg, me, target);
    if (me->query("jm/taohua")) damage = me->query_skill(
      "yuxiao-jianfa",
      1
    ) * me->query(
      "int",
      1
    ) * 3 / 60 + me->query_skill(
      "qimen-wuxing",
      1
    ) * me->query(
      "int",
      1
    ) * 3 / 60 + me->query_skill(
      "tanzhi-shentong",
      1
    ) * me->query(
      "con",
      1
    ) * 3 / 60 + me->query_skill(
      "bibo-shengong",
      1
    ) * me->query(
      "con",
      1
    ) * 3 / 60 + me->query_skill(
      "force",
      1
    ) + me->query_skill("sword", 1) + me->query_skill("unarmed", 1) + me->query("jiali");
    else damage = me->query_skill(
      "yuxiao-jianfa",
      1
    ) * me->query(
      "int",
      1
    ) / 30 + me->query_skill(
      "qimen-wuxing",
      1
    ) * me->query(
      "int",
      1
    ) / 30 + me->query_skill(
      "tanzhi-shentong",
      1
    ) * me->query(
      "con",
      1
    ) / 30 + me->query_skill(
      "bibo-shengong",
      1
    ) * me->query(
      "con",
      1
    ) / 30 + me->query_skill(
      "force",
      1
    ) + me->query_skill("sword", 1) + me->query_skill("unarmed", 1) + me->query("jiali");
    damage = damage + random(damage);
    if (random(ap) > dp / 3) {
      msg = HIR "石子来得好快，$n" HIR + "一个闪避不及，被打了个正中，浑身一阵剧痛，整个人几乎都要散架了。\n" NOR;
      message_vision(msg, me, target);
      target->apply_condition("no_exert", 20);
      target->receive_damage("qi", damage, me);
      target->receive_wound("qi", damage, me);
      me->add("neili", -3000);
      me->add("jingli", -3000);
      if (userp(me) && me->query("env/no_combat_msg") < 4) tell_object(
        me,
        HIW "该绝招对敌人气血的外伤为" + damage + "，内伤为" + damage + "。\n" NOR
      );

    } else {
      me->add("neili", -1000);
      msg = CYN "可是$n" CYN "轻轻一闪，躲过了$N" HIG "发出的石子。\n" NOR;
      message_vision(msg, me, target);
    }

    me->add_temp("apply/attack", skill * 2);
    me->add_temp("apply/damage", skill);
    msg = CYN "$N双手一前一后，缓缓伸出，中指突地一弹，两道劲风汇成一股，“咝咝”有声，直袭$n前胸。\n";
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
    msg = HIY "$N扣住中指，哧哧哧连弹三下，三缕指风锋锐若剑，风驰电挚般射向$n的" + xuedao[random(sizeof(xuedao))] + "、" + xuedao[random(sizeof(xuedao))] + "、" + xuedao[random(sizeof(xuedao))];
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
    msg = HIC "$N扣起中指、无名指，一齐弹出，中指指劲激射$n的" + xuedao[random(sizeof(xuedao))] + "，无名指上暗劲则已悄无声息的掩至" + xuedao[random(sizeof(xuedao))];
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
    msg = HIR "$N双足不丁不八，踏着东方乙木之位，食中二指反扣住拇指，一声长啸，反手弹出，但见一股凌厉无极的指劲激射向$n的" + xuedao[random(sizeof(xuedao))];
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
    msg = HIB "$N冷哼一声，双手笼入袖中，脸上青气一闪即逝，几缕指风已无声无息的袭向$n的" + xuedao[random(sizeof(xuedao))] + "、" + xuedao[random(sizeof(xuedao))] + "、" + xuedao[random(sizeof(xuedao))] + "数处要穴";
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
    msg = HIG "$N身子滴溜溜的打了半个圈子，丹田中提一口真气，青芒犹似长蛇般伸缩不定，蓦地真气突盛，刺向$n的" + xuedao[random(sizeof(xuedao))];
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
    me->add_temp("apply/attack", -skill * 2);
    me->add_temp("apply/damage", -skill);
    me->add("neili", -1000);
    me->add("jingli", -1000);
  }
  me->start_busy(1);
  return 1;
}

void del_cooldown(object me)  //CD写法1
{
  if (!objectp(me)) return;
  if (me->query_temp("cooldown")) {
    me->delete_temp("cooldown");
    tell_object(me, HIM "你呼出一口气，缓缓的将内力收回丹田。\n" NOR);
  }
}
