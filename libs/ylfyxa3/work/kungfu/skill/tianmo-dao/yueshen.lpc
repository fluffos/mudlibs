// counterattack.c
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit F_SSERVER;
int perform(object me, object target) {
  string msg;
  int extra, damage, i, count, ap, dp;
  object weapon, weapon2;

  if (!target) target = offensive_target(me);
  if (!target || !target->is_character() || !me->is_fighting(target))
    return notify_fail("『" HIG "月神一刀" NOR "』只能对战斗中的对手使用。\n");
  if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "blade")
    return notify_fail("你手中没有装备刀类武器！\n");
  //	if (target && target->query_temp("apply/shade_vision")) 
  //		return notify_fail("对方隐身了，你看不到"+target->query("name")+"。\n"); 		
  if ((int)me->query_skill("tianmo-dao", 1) < 1000)
    return notify_fail("你的天魔刀还不够精纯，不能发出『" HIG "月神一刀" NOR "』。\n");
  if (me->query_skill_mapped("force") != "tianmo-shengong")
    return notify_fail("不使用本门内功，如何能使用本门绝技。\n");
  if ((int)me->query_skill("blade", 1) < 1000 || me->query_skill_mapped("blade") != "tianmo-dao")
    return notify_fail("不激发该技能，你是在开玩笑吗！\n");
  if ((int)me->query_skill("tianmo-shengong", 1) < 1000)
    return notify_fail("你的天魔神功不够娴熟！\n");
  if ((int)me->query("max_neili") < 500000)
    return notify_fail("你的内力修为不够。\n");
  if ((int)me->query("max_jingli") < 500000)
    return notify_fail("你的精力修为不够。\n");
  if ((int)me->query("jingli") < 10000)
    return notify_fail("你的精力不够。\n");
  if ((int)me->query("neili") < 10000)
    return notify_fail("你的真气不够。\n");
  if (me->is_busy())
    return notify_fail("你现在正忙着呢！\n");
  if (me->query_temp("autolian"))
    return notify_fail("你正在发动自动连招！\n");
  if (me->query_temp("cooldown"))  //CD写法	2017.9.7添加
    return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");

  message_vision(
    HIC "突然间天地昏暗，$N手中的刀锋幻花出淡淡月光，绚烂的光芒中，美丽的月神\n翩翩起舞，美妙的舞姿让人忘却了世间所有的恩恩怨怨。\n" NOR,
    me,
    target
  );
  me->set_temp("cooldown", 1);  //CD写法	2017.9.7添加
  call_out("del_cooldown", 3, me);  //CD写法1
  ap = me->query("xyzx_sys/level") + me->query_skill(
    "tianmo-dao",
    1
  ) + me->query_skill("blade") + me->query_skill("force");
  dp = target->query("xyzx_sys/level") + target->query_skill("dodge") + target->query_skill("parry");
  extra = (int)me->query_skill("tianmo-dao", 1);
  count = (int)me->query_skill("tianmo-dao", 1) / 600;
  if (count < 1) count = 1;
  if (count > 8) count = 8;
  msg = HIY "$N神气贯通，将天地人魔连环八式一气呵成！\n" NOR;
  message_vision(msg, me, target);
  me->add_temp("apply/attack", extra);
  me->add_temp("apply/damage", extra);
  msg = HIY "万魔初醒！" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = HIY "魔焰万丈！" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = HIY "魔光乍现！" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = HIY "天魔独尊！" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = HIY "万刃天魔！" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = HIY "天魔回天！" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = HIY "天魔七现！" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = HIY "万魔归宗！" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  me->add("neili", -1000);
  me->add("jingli", -1000);
  me->add_temp("apply/attack", -extra);
  me->add_temp("apply/damage", -extra);

  if ((int)me->query_skill("tianmo-dao", 1) > 2000) {
    msg = HIR "\n$N" + HIR "将刀横于胸前，左手中指在刀背上一弹，右手借力挥刀。。。\n" NOR;
    message_vision(msg, me, target);
    for (i = 0; i < count; i++) {
      if (random(ap) > dp / 3) {
        message_vision(HIW "只见一道亮光从$N" + HIW "身前划过！！\n" NOR, me, target);
        damage = extra + random(extra * 2);
        target->receive_wound("qi", damage, me);
        target->receive_damage("qi", damage, me);
        if (userp(me) && me->query("env/no_combat_msg") < 4) tell_object(
          me,
          HIW "该绝招对敌人气血的外伤为" + damage + "，内伤为" + damage + "。\n" NOR
        );
        //                COMBAT_D->report_status(target);	//这代码什么作用？
      }
    }
    me->add("neili", -1000);
    me->add("jingli", -1000);
  }
  if ((int)me->query_skill("tianmo-dao", 1) > 3000) {
    message_vision(
      HIC "突然间天地昏暗，$N手中的刀锋幻花出淡淡月光，绚烂的光芒中，美丽的月神\n翩翩起舞，美妙的舞姿让人忘却了世间所有的恩恩怨怨。\n" NOR,
      me,
      target
    );

    if (random(ap) > dp / 3) {
      msg = HIW "$n只觉一道眩光刺得双眼什么都看不见了，$N见状大喜连续五刀，从五个不同的方向砍来！\n" NOR;
      message_vision(msg, target, me);
      damage = extra * 2 + random(extra * 5);
      if (objectp(weapon2 = target->query_temp("weapon"))) {
        message_vision(
          HIG "$n被眼前的景象迷惑，呆呆的放下手中的" NOR + weapon2->query("name") + HIG "。\n" NOR,
          me,
          target
        );
        weapon2->unequip();

      } else {
        message_vision(HIG "$N被眼前的景象迷惑，竟然放慢了进攻速度。\n" NOR, target);
        message_vision(HIG "突然之间，美丽的月神随着$N手中的光芒散去，漫漫月光凝成一道刀锋刺入$n喉咙！！\n" NOR, me, target);
        target->receive_damage("qi", damage, me);
        target->receive_wound("qi", damage, me);
        if (userp(me) && me->query("env/no_combat_msg") < 4) tell_object(
          me,
          HIW "该绝招对敌人气血的外伤为" + damage + "，内伤为" + damage + "。\n" NOR
        );
      }
      me->add("neili", -1000);
      me->add("jingli", -1000);
    } else {
      message_vision(YEL + "\n$n" + RED + "阴侧侧长笑数声，竟然在月光下翩翩起舞。\n" NOR, me);
      message_vision(HIR "$N收心凝神，突然发现茫茫的月光中$n的刀锋竟向自己的咽喉刺来！！\n" NOR, target, me);
      damage = extra + random(extra * 2);
      if (objectp(weapon = me->query_temp("weapon"))) {
        weapon->unequip();
        message_vision(HIR "千钧一发之疾，$N放下手中兵器，飞纵急退，$n的刀锋擦身而过！！！茫茫刀光让人心神荡漾！！！！\n" NOR, target, me);
      } else {
        message_vision(HIR "千钧一发之疾，$N飞纵急退，$n的刀锋擦身而过！！！茫茫刀光让人心神荡漾！！！！\n" NOR, target, me);
        me->receive_damage("qi", damage, target);
        me->receive_wound("qi", damage, target);
        if (userp(me) && me->query("env/no_combat_msg") < 4) tell_object(
          me,
          HIW "该绝招对自己气血的外伤为" + damage + "，内伤为" + damage + "。\n" NOR
        );
      }
      me->add("neili", -1000);
      me->add("jingli", -1000);
    }
  }


  me->start_busy(1);
  return 1;
}


void del_cooldown(object me)  //CD写法1
{
  if (!objectp(me)) return;
  if (me->query_temp("cooldown")) {
    me->delete_temp("cooldown");
    tell_object(me, HIM "你呼出一口气，缓缓的将内力收回丹田。\n" NOR);
  }
}
