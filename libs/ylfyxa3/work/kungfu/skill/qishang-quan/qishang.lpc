#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
#include <condition.h>
inherit F_SSERVER;

string *songs = ({ "五行之气调阴阳", "损心伤肺摧肝肠", "藏离精失意恍惚", "三焦齐逆兮魂魄飞扬" });

int perform(object me, object target) {
  string msg, song;
  int extra, damage, damage1, ap, dp;

  if (!target) target = offensive_target(me);
  if (!target || !target->is_character() || !me->is_fighting(target))
    return notify_fail("「七伤」只能在战斗中使用。\n");
  if (me->is_busy())
    return notify_fail("你现在正忙着呢！\n");
  if (objectp(me->query_temp("weapon")))
    return notify_fail("「七伤」只能空手使用。\n");
  if (me->query_skill_mapped("unarmed") != "qishang-quan")
    return notify_fail("你没有使用七伤拳法。\n");
  if (target && target->query_temp("apply/shade_vision"))
    return notify_fail("对方隐身了，你看不到" + target->query("name") + "。\n");
  if ((int)me->query("max_neili") < 500000)
    return notify_fail("没有深厚的内力，使用七伤拳会反伤自己。\n");
  if ((int)me->query("neili") < 1000)
    return notify_fail("你的真气不够！\n");
  if ((int)me->query("jingli") < 1000)
    return notify_fail("你的精力不够！\n");
  if (me->query_skill("qishang-quan", 1) < 500)
    return notify_fail("你的七伤拳火候不够，无法使用「七伤」！\n");
  if ((int)me->query_skill("jiuyang-shengong", 1) < 500)
    return notify_fail("你的九阳神功修为不够，无法使用「七伤」！\n");
  if (me->query_skill_mapped("force") != "jiuyang-shengong")
    return notify_fail("你必须激发九阳神功才能使用「七伤」！\n");
  if (me->query_temp("autolian"))
    return notify_fail("你正在发动自动连招！\n");
  if (me->query_temp("cooldown"))  //CD写法	2017.9.7添加
    return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");

  song = songs[random(sizeof(songs))];
  ap = me->query("xyzx_sys/level") + me->query_skill(
    "qishang-quan",
    1
  ) + me->query_skill("unarmed") + me->query_skill("force");
  dp = target->query("xyzx_sys/level") + target->query_skill("dodge") + target->query_skill("parry");
  extra = me->query_skill("qishang-quan", 1) + me->query_skill("jiuyang-shengong", 1);

  message_vision(
    HIR "\n突然$N眼射精光，朗声念出句似歌非歌、似诗非诗的拳诀：“" + song + "”，接着走上前去，接连七拳击向$n！\n" NOR,
    me,
    target
  );

  me->set_temp("cooldown", 1);  //CD写法	2017.9.7添加
  call_out("del_cooldown", 3, me);  //CD写法1	
  msg = HIW "藏离诀！" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = HIW "摧肠诀！" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = HIW "精失诀！" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = HIW "三焦诀！" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = HIW "伤肺诀！" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = HIW "损心诀！" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = HIW "意恍惚诀！" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  me->add("neili", -500);

  me->add_temp("apply/attack", extra);
  me->add_temp("apply/damage", extra);
  msg = HIY "$N大喝一声，使出七伤拳的绝技「魂魄飞扬」，双拳势如雷霆，向$n击去。\n" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  me->add_temp("apply/attack", -extra);
  me->add_temp("apply/damage", -extra);

  msg = HIW "$N身形回转，怒吼一声，同时使出七伤拳中的精髓，一招[幽幽魂断]连续攻向$n！" NOR;
  message_vision(msg, me, target);
  damage = me->query_skill("unarmed") + me->query_skill(
    "qishang-quan",
    1
  ) * me->query("con", 1) / 5 + me->query_skill("force") + me->query("jiali") * 5;
  damage = damage + random(damage);
  damage1 = me->query_skill("qishang-quan", 1) + me->query_skill("unarmed");
  damage1 = damage1 + random(damage1);
  if (random(ap) > dp / 3) {
    target->receive_damage("qi", damage, me);
    target->receive_wound("qi", damage, me);
    me->receive_damage("qi", damage1, target);
    me->receive_wound("qi", damage1, target);
    me->add("neili", -300);
    me->add("jingli", -300);
    if (userp(me) && me->query("env/no_combat_msg") < 4) tell_object(
      me,
      HIW "该绝招对敌人气血的外伤为" + damage + "，内伤为" + damage + "，对自己气血的外伤为" + damage + "，内伤为" + damage + "。\n" NOR
    );
    if (me->query("neili") * 2 < target->query("neili")) {
      tell_object(me, HIR "你只觉" + target->name() + "体内内力极强，你暗藏在拳内的各种力道根本送不出去，结果反噬己身！\n" NOR);
      me->apply_condition("qishang_poison", 30);
    } else {
      tell_object(me, HIW "在刚一触到" + target->name() + "的身体时，你便暗暗发力，将隐藏在在拳内的七种力道送了过去！\n" NOR);
      tell_object(target, HIW "你一晃眼，只见" + me->name() + "的拳已经打在你的身上，跟着几股说不出的暗劲顺势传了过来！\n" NOR);
      target->apply_condition("qishang_poison", 10 + target->query_condition("qishang_poison"));
    }
  } else {
    me->add("neili", -100);
    msg = "只见$n轻轻一转身，已经绕到了$N身后。而$N却因劲力打空不受控制，头脑眩晕！\n";
    message_vision(msg, me, target);
  }

  me->start_busy(1);
  return 1;
}

void del_cooldown(object me)  //CD写法1
{
  if (!objectp(me)) return;
  if (me->query_temp("cooldown")) {
    me->delete_temp("cooldown");
    tell_object(me, HIM "你呼出一口气，缓缓的将内力收回丹田。\n" NOR);
  }
}
