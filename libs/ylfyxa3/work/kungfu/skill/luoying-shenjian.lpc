int valid_learn(object me) {
  object ob;
  //			if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if ((int)me->query_skill("bibo-shengong", 1) < 100)
    return notify_fail("你的碧波神功火候还不够。\n");
  if (me->query("family/family_name") != "桃花岛")
    return notify_fail("你不是桃花岛门人，无法学习本门技能。\n");
  if ((int)me->query("max_neili") < 10000)
    return notify_fail("你的内力不够，不能练落英神剑。\n");
  if (!objectp(ob = me->query_temp("weapon"))
    || (string)ob->query("skill_type") != "sword")
    return notify_fail("你必须先找一把剑。\n");
  return 1;
}
int valid_enable(string usage) {
  return usage == "sword" || usage == "parry";
}
mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}
int practice_skill(object me) {
  object ob;
  //			if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if ((int)me->query("qi") < 30
    || (int)me->query("neili") < 5)
    return notify_fail("你的内力或气不够，没有办法练习落英神剑。\n");
  if (me->query("family/family_name") != "桃花岛")
    return notify_fail("你不是桃花岛门人，无法练习本门技能。\n");
  if (!objectp(ob = me->query_temp("weapon"))
    || (string)ob->query("skill_type") != "sword")
    return notify_fail("你必须先找一把剑才能习练剑法。\n");
  me->receive_damage("qi", 30);
  me->add("neili", -5);
  write("你按著所学练了一遍落英神剑。\n");
  return 1;
}
string perform_action_file(string action) {
  return __DIR__ "luoying-shenjian/" + action;
}


mixed hit_ob(object me, object victim, int damage_bonus, int factor, string limb) {
  int level, ap, dp, damage2;

  level = (int)me->query_skill("luoying-shenjian", 1);
  ap = me->query_skill(
    "bibo-shengong",
    1
  ) + me->query_skill(
    "luoying-zhang",
    1
  ) + me->query_skill("qimen-wuxing", 1) + me->query_skill("luoying-shenjian", 1);
  dp = victim->query_skill("force", 1) / 2 + victim->query_skill("dodge", 1) / 2;
  damage2 = (int)me->query_skill("luoying-shenjian", 1);

  if (damage_bonus < 100) return 0;
  if (me->query_skill("bibo-shengong", 1) < 100) return 0;
  if (me->query("jiali") < 1 || me->query("neili") < 100 || me->query_skill_mapped("force") != "bibo-shengong") return 0;
  if (damage2 < 10) damage2 = 10;
  if (random(6) == 2 && level >= 300 && me->query("jiali") > 0 && random(ap) > dp / 10) {
    victim->receive_wound("qi", damage2 + 150 + damage_bonus / 2, me);
    me->add("neili", -100);
    //		if (!victim->is_busy()) victim->start_busy(2);
    return HIB "$N剑走五行，$n二眼一花不知所错！被一剑击中$l要害，顿时痛不欲生！！\n" NOR;
  }
}
