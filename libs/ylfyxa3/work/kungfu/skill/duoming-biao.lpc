int valid_enable(string usage) { return usage == "throwing" || usage == "parry"; }

int valid_learn(object me) {
  //		if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if ((int)me->query("max_neili") < 10000)
    return notify_fail("你的内力不够。\n");
  if ((int)me->query_skill("biyun-xinfa", 1) < 100)
    return notify_fail("你的碧云心法火候太浅。\n");
  if (me->query("family/family_name") != "唐门")
    return notify_fail("你不是唐门中人，无法领悟本门技能的精髓。\n");
  return 1;

}

string query_skill_name(int level) {
  int i;
  for (i = sizeof(action) - 1; i >= 0; i--)
    if (level >= action[i]["lvl"])
      return action[i]["skill_name"];
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];  //2017.9.4阿飞改，将招式简单点
}

int practice_skill(object me) {
  object weapon;
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "throwing")
    return notify_fail("你使用的武器不对。\n");
  if (me->query("family/family_name") != "唐门")
    return notify_fail("你不是唐门中人，玩不了暗器。\n");
  if ((int)me->query("qi") < 50)
    return notify_fail("你的体力不够，练不了夺命镖。\n");
  me->receive_damage("qi", 30);
  return 1;
}

string perform_action_file(string action) {
  return __DIR__ "duoming-biao/" + action;
}


mixed hit_ob(object me, object victim, int damage_bonus, int factor) {

  int ap, dp, damage2;

  ap = (int)me->query_skill("duoming-biao", 1);
  dp = (int)victim->query_skill("dodge", 1);

  damage2 = (int)me->query_skill("duoming-biao", 1);

  if (damage_bonus < 100) return 0;
  if (me->query_skill("biyun-xinfa", 1) < 100) return 0;
  if (me->query("jiali") < 1 || me->query("neili") < 100 || me->query_skill_mapped("force") != "biyun-xinfa") return 0;
  if (damage2 < 10) damage2 = 10;

  if (random(6) == 0 && me->query_skill_mapped("force") == "biyun-xinfa" && me->query("jiali") > 0 && random(ap) > dp / 10) {
    me->add("neili", -100);
    victim->receive_damage("qi", damage2 + damage_bonus / 2, me);
    victim->receive_wound("qi", damage2 + damage_bonus / 2, me);
    victim->apply_condition(du[random(sizeof(du))], 25);
    //	if (!victim->is_busy()) victim->start_busy(2);	
    return HIR "$N手上绿光一闪，无声无息的一支钢镖飞出！$n没想到躲过了一只飞镖，居然还有一只暗镖！！\n";
  }

}
