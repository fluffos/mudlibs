// snow-zhang.c		飞雪映梅掌	下乘武学100~300
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
#include <condition.h>
inherit SKILL;
string *order = ({
  "" HIY "",
  "" HIG "",
  "" RED "",
  "" MAG "",
  "" YEL "",
  "" HIC "",
  "" HIW "",
  "" HIR "",
  "" HIB "",
  "" CYN "",
  "" WHT "",
  "" HIM "",
  "" BLU ""
});


mapping *action = ({
  ([ "action": "$N一招" + (order[random(13)]) + "「梅林小酌」" NOR "，双手挥洒自如,轻飘飘地点向$n$l",
    "attack": 100,
    "parry": 100,
    "dodge": 100,
    "damage": 100,
    "force": 100,
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N左拳平削,右拳自下划了个半弧,一招" + (order[random(13)]) + "「梅妻鹤子」" NOR ",疾取$n的$l",
    "attack": 100,
    "parry": 100,
    "dodge": 100,
    "damage": 100,
    "force": 100,
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N一招" + (order[random(13)]) + "「急雪落梅」" NOR ",双掌如风中劲草,疾如流星般拍向$n$l",
    "attack": 200,
    "parry": 200,
    "dodge": 200,
    "damage": 200,
    "force": 200,
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N信手一招" + (order[random(13)]) + "「霜雪漫天」" NOR ",散出森森寒气,罩向$n的$l",
    "attack": 200,
    "parry": 200,
    "dodge": 200,
    "damage": 200,
    "force": 200,
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N使一招" + (order[random(13)]) + "「余雪残梅」" NOR "，身随意转,随手拍向$n$l",
    "attack": 200,
    "parry": 200,
    "dodge": 200,
    "damage": 200,
    "force": 200,
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N长身一笑,纵身而起,一式" + (order[random(13)]) + "「寒江飘梅」" NOR "，围绕$n的$l轻飘飘接连出掌",
    "attack": 300,
    "parry": 300,
    "dodge": 300,
    "damage": 300,
    "force": 300,
    "damage_type": "瘀伤"
  ]),
});

int valid_enable(string usage) { return usage == "unarmed" || usage == "parry"; }

int valid_learn(object me) {
  //		if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练飞雪映梅掌必须空手。\n");
  if (me->query("family/family_name") != "凌霄城")
    return notify_fail("你未加入凌霄城，学不了。\n");
  if ((int)me->query_skill("bingxue-xinfa", 1) < 100)
    return notify_fail("你的冰雪心法不够。\n");
  if ((int)me->query("max_neili") < 10000)
    return notify_fail("你的内力太弱，无法练习。\n");
  return 1;
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

int practice_skill(object me) {
  //		if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if ((int)me->query("qi") < 40)
    return notify_fail("你的体力太低了。\n");
  if (me->query("family/family_name") != "凌霄城")
    return notify_fail("你未加入凌霄城，还敢练习城主独门技能！。\n");
  if ((int)me->query("neili") < 10)
    return notify_fail("你的内力不够了！休息一下再练吧。\n");
  me->receive_damage("qi", 10);
  me->add("neili", -5);
  return 1;
}

string perform_action_file(string action) {
  return __DIR__ "snow-zhang/" + action;
}

mixed hit_ob(object me, object victim, int damage_bonus, int factor) {
  int ap, dp, damage2;
  damage2 = (int)me->query_skill("snow-zhang", 1);
  ap = me->query_skill("snow-zhang", 1);
  dp = victim->query_skill("force", 1);
  if (damage_bonus < 100) return 0;
  if (me->query_skill("bingxue-xinfa", 1) < 100) return 0;
  if (me->query("jiali") < 1 || me->query("neili") < 100 || me->query_skill_mapped("force") != "bingxue-xinfa") return 0;
  if (damage2 < 10) damage2 = 10;

  if (random(5) == 1
    && random(me->query_skill("bingxue-xinfa", 1)) > 100
    && me->query("jiali") > 0
    && me->query_skill_mapped("force") == "bingxue-xinfa"
    && random(ap) > dp / 10) {
    victim->apply_condition(
      "ice_poison",
      (me->query_skill("bingxue-xinfa")) / 300 + victim->query_condition("ice_poison")
    );
    me->add("neili", -100);
    victim->receive_wound("qi", damage2 + damage_bonus / 2, me);
    return HIW "$n只觉得伤口一寒,一股寒气似冰箭一样的串进$n的全身。\n" NOR;
  }

}
