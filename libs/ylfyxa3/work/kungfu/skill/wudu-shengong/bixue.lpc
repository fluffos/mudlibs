// bx_arrow.c 碧血箭

#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
#include <condition.h>
inherit F_SSERVER;

string *du = ({
  "ice_poison",
  "ill_dongshang",
  "ill_fashao",
  "ill_kesou",
  "ill_shanghan",
  "ill_zhongshu",
  "xx_poison",
  "cold_poison",
  "flower_poison",
  "rose_poison",
  "sanpoison",
  "scorpion_poison",
  "qx_snake_poison",
  "anqi_poison",
  "yf_poison",
  "nx_poison",
  "chilian_poison",
  "yufeng_poison",
  "insect_poison",
});

int exert(object me, object target) {
  int ap, dp, damage, damage1;

  if (target == me || !target) {
    me->clean_up_enemy();
    target = me->select_opponent();
  }
  if (!me->is_fighting(target))
    return notify_fail("碧血箭只能在战斗中使用。\n");
  if (me->is_busy())
    return notify_fail("你现在正忙着呢，哪有空运功？\n");
  if (!objectp(target) || environment(me) != environment(target) || target->query("id") == "mu ren" || target->query("id") == "tong ren")
    return notify_fail("你要对谁施展碧血箭？\n");
  if ((int)me->query("max_neili") < 100000)
    return notify_fail("你的内力不够，不能有效施展碧血箭！\n");
  if ((int)me->query("max_jingli") < 100000)
    return notify_fail("你的精力不够，不能有效施展碧血箭！\n");
  if ((int)me->query("jingli") < 1000)
    return notify_fail("你的精力不够。\n");
  if ((int)me->query("neili") < 1000)
    return notify_fail("你的真气不够。\n");
  if ((int)me->query_skill("wudu-shengong", 1) < 1000)
    return notify_fail("你的内功修为不够，不能有效施展碧血箭！\n");
  //	if (target && target->query_temp("apply/shade_vision")) 
  //		return notify_fail("对方隐身了，你看不到"+target->query("name")+"。\n"); 
  if ((int)me->query("combat_exp") < (int)target->query("combat_exp") / 20)
    return notify_fail("对方武功强你几十倍，不会有用的，还是快跑吧！\n");
  if (me->query_temp("autolian"))
    return notify_fail("你正在发动自动连招！\n");
  if (me->query_temp("cooldown"))  //CD写法	2017.9.7添加
    return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");

  message_vision(
    HIC "$N双目血红，披头散发，仰天发出一声悲啸！\n\n$N把心一横，在自己舌尖狠命一咬，将毕生功力化做一道奇毒血箭向$n喷了过去！\n" NOR,
    me,
    target
  );
  me->set_temp("cooldown", 1);  //CD写法	2017.9.7添加
  call_out("del_cooldown", 3, me);  //CD写法1

  ap = me->query_skill("force") + me->query_skill("wudu-shengong", 1) + me->query("xyzx_sys/level");
  dp = target->query_skill("force") + target->query_skill(
    "wudu-shengong",
    1
  ) + target->query("xyzx_sys/level");
  damage = target->query("qi") / 10;
  damage1 = me->query("max_qi") / 10;
  me->add("neili", -1000);
  me->add("jingli", -1000);
  if (random(ap) > dp / 3) {
    message_vision(HIR "结果$n促不及防被血箭射个正着，顿时发出一声惨叫！\n$N见状哈哈大笑一声，眼前一黑倒在地上。\n" NOR, me, target);
    target->receive_damage("qi", damage, me);
    target->receive_wound("qi", damage, me);
    target->apply_condition(du[random(sizeof(du))], 20);
    me->receive_damage("qi", damage1, target);
    me->receive_wound("qi", damage1, target);
    if (userp(me) && me->query("env/no_combat_msg") < 4) tell_object(
      me,
      HIW "该绝招对敌人气血的外伤为" + damage + "，内伤为" + damage + "，自己消耗气血" + damage1 + "。\n" NOR
    );
  } else {
    message_vision(HIR "但是血箭被$n内力反震，化做一蓬血雾四散飘去！\n$N一声惨笑，长叹一声，眼前一黑倒在地上。\n" NOR, me, target);
    me->receive_damage("qi", damage1, target);
    me->receive_wound("qi", damage1, target);
    me->apply_condition(du[random(sizeof(du))], 15);
    if (userp(me) && me->query("env/no_combat_msg") < 4) tell_object(
      me,
      HIW "该绝招对自己气血的外伤为" + damage1 + "，内伤为" + damage1 + "。\n" NOR
    );
  }
  me->start_busy(1);
  return 1;
}

void del_cooldown(object me)  //CD写法1
{
  if (!objectp(me)) return;
  if (me->query_temp("cooldown")) {
    me->delete_temp("cooldown");
    tell_object(me, HIM "你呼出一口气，缓缓的将内力收回丹田。\n" NOR);
  }
}
