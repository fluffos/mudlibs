int valid_learn(object me) {
  object weap;
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if ((int)me->query("max_neili") < 200000)
    return notify_fail("你的内力修为不够，没有办法练飞刀绝技。\n");
  if (!objectp(weap = me->query_temp("weapon")) || (string)weap->query("skill_type") != "throwing" || (string)weap->query("id") != "fei dao")
    return notify_fail("你必须使用飞刀才能练习小李飞刀。\n");
  if ((int)me->query_skill("xiaoli-feidao", 1) > 300)
    return notify_fail("小李飞刀只能传授这么多了，剩下的只能靠自己领悟。\n");
  if ((int)me->query_skill("throwing", 1) < 5000)
    return notify_fail("你的暗器基础不够，无法领悟小李飞刀。\n");
  if ((int)me->query_skill("dodge", 1) < 5000)
    return notify_fail("你的轻功基础不够，无法领悟小李飞刀。\n");
  if ((int)me->query_skill("unarmed", 1) < 5000)
    return notify_fail("你的拳脚基础不够，无法领悟小李飞刀。\n");
  if ((int)me->query_skill("blade", 1) < 5000)
    return notify_fail("你的刀法基础不够，无法领悟小李飞刀。\n");
  if ((int)me->query("score", 1) < 10000)
    return notify_fail("你对我派毫无贡献而言，怎么可能传授你武功呢。\n");
  if (random(10) == 1) me->add("score", -10);
  return 1;
}
//2017.12.31阿飞改，葵花大法自练方式改成类似独孤模式
int practice_skill(object me) {
  return notify_fail("小李飞刀只能通过「" + HIC + "飞刀问情" + NOR + "」来提升。\n");
}
