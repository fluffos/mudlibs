int valid_enable(string usage) {
  return usage == "throwing" || usage == "parry";
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

string perform_action_file(string action) {
  return __DIR__ "xiaoli-feidao/" + action;
}

mixed hit_ob(object me, object victim, int damage_bonus, int factor) {
  int ap, dp, damage2;
  damage2 = (int)me->query_skill("xiaoli-feidao", 1);
  ap = me->query_skill("xiaoli-feidao", 1);
  dp = victim->query_skill("dodge", 1);
  if (damage_bonus < 100) return 0;
  if (me->query_skill("throwing", 1) < 1000) return 0;
  if (me->query("jiali") < 1 || me->query("neili") < 100 || me->query_skill_mapped("throwing") != "xiaoli-feidao") return 0;
  if (damage2 < 10) damage2 = 10;

  if (me->query_skill("xiaoli-feidao", 1) > 300
    && random(ap) > dp / 10
    && me->query_skill_mapped("throwing") == "xiaoli-feidao"
    && random(5) == 0
    && me->query("jiali") > 0) {
    victim->receive_damage("qi", damage2 * 3 + damage_bonus / 2, me);
    victim->receive_wound("qi", damage2 * 3 + damage_bonus / 2, me);
    victim->apply_condition("anqi_poison", random(5) + 1 + victim->query_condition("anqi_poison"));
    me->add("neili", -100);
    return HIR "天上地下，从来没有人知道他的飞刀在哪里，也没有人知道他是怎么发出来的，但是他一定在他该在的地方。\n" NOR;
  }
}

