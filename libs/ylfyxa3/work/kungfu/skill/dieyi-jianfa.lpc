#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit SKILL;


mapping *action = ({
  ([ "action": "$N使出·" HIC "山青" HIG "绿水" HIR "花满地" NOR "·手中$w刺向$n的$l",
    "attack": 200,
    "parry": 200,
    "dodge": 200,
    "damage": 200,
    "force": 200,
    "lvl": 0,
    "damage_type": "刺伤",
  ]),
  ([ "action": "$N使出·" HIM "舞蝶" WHT "群群" BLINK "" HIB "伴君行" NOR "·$w剑尖抖动不定，刺向$n的$l",
    "attack": 300,
    "parry": 300,
    "dodge": 300,
    "damage": 300,
    "force": 300,
    "lvl": 100,
    "damage_type": "刺伤",
  ]),
  ([ "action": "$N使出·" HIB "朝辞" HIW "白帝" BLINK "" HIM "彩云间" NOR "·$w反身旋转舞出数个剑花，刺向$n的$l",
    "attack": 400,
    "parry": 400,
    "dodge": 400,
    "damage": 400,
    "force": 400,
    "lvl": 200,
    "damage_type": "刺伤",
  ]),
  ([ "action": "$N一招·" HIW "遥视" HIR "" BLINK "彩云" NOR "" YEL "落人间" NOR "·，无数$w上下刺出，直向$n逼去",
    "attack": 500,
    "parry": 500,
    "dodge": 500,
    "damage": 500,
    "force": 500,
    "lvl": 300,
    "damage_type": "刺伤",
  ]),
  ([ "action": "$N向前跨上一步一式·" HIR "" BLINK "确" NOR "" YEL "见" BLINK "" HIW "花" NOR "" BLU "蝶" BLINK "" HIG "满" NOR "" HIM "园" CYN "" BLINK "香" NOR "·，手中$w使出直刺$n的喉部",
    "attack": 600,
    "parry": 600,
    "dodge": 600,
    "damage": 600,
    "force": 600,
    "lvl": 400,
    "damage_type": "刺伤",
  ]),
});


int valid_enable(string usage) { return usage == "sword" || usage == "parry"; }

int valid_learn(object me) {
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if (me->query("family/family_name") != "舞蝶仙")
    return notify_fail("你不是舞蝶仙传人，无法领悟舞蝶意境。\n");
  if ((int)me->query_skill("wudie-xinjing", 1) < 100)
    return notify_fail("你的「舞蝶心经」火候不够，无法学「蝶翼剑法」。\n");
  if ((int)me->query("max_neili") < 10000)
    return notify_fail("你的内力太弱，无法练「蝶翼剑法」。\n");
  if ((int)me->query("int") < 25 || (int)me->query("dex", 1) < 25)
    return notify_fail("「蝶翼剑法」轻灵盈动，以你的悟性和身形恐怕学不会。\n");
  if ((int)me->query("score", 1) < 5000)
    return notify_fail("你对我派毫无贡献而言，怎么可能传授你武功呢。\n");
  if (random(100) == 1) me->add("score", -5);
  return 1;
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];  //2017.9.4阿飞改，将招式简单点
}

int practice_skill(object me) {
  object weapon;
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "sword")
    return notify_fail("你使用的武器不对。\n");
  if ((int)me->query("qi") < 50)
    return notify_fail("你的体力不够练「蝶翼剑法」。\n");
  if ((int)me->query("neili") < 30)
    return notify_fail("你的内力不够练「蝶翼剑法」。\n");
  if (me->query("family/family_name") != "舞蝶仙")
    return notify_fail("你不是舞蝶仙传人，无法领悟舞蝶意境。\n");
  me->receive_damage("qi", 30);
  me->add("neili", -15);
  return 1;
}

string perform_action_file(string action) {
  return __DIR__ "dieyi-jianfa/" + action;
}

mixed hit_ob(object me, object victim, int damage_bonus) {
  int ap, dp, damage2;
  ap = me->query_skill("dieyi-jianfa", 1);
  dp = victim->query_skill("parry", 1);
  damage2 = (int)me->query_skill("dieyi-jianfa", 1);

  if (damage_bonus < 100) return 0;
  if (me->query_skill("wudie-xinjing", 1) < 100) return 0;
  if (me->query("jiali") < 1 || me->query("neili") < 100 || me->query_skill_mapped("force") != "wudie-xinjing") return 0;
  if (damage2 < 10) damage2 = 10;
  if (random(ap) > dp / 10 && me->query_skill_mapped("force") == "wudie-xinjing" && random(6) == 1 && me->query("jiali") > 0) {
    victim->receive_wound("qi", damage2 + damage_bonus / 2, me);
    me->add("neili", -100);
    return MAG BLINK "你听到「唰」一声轻响好似凉风吹过，忽然间$n血冒三丈，被剑气所伤！\n" NOR;
  }
}
