int valid_enable(string usage) {
  return usage == "unarmed" || usage == "dodge" || usage == "parry";
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}


int practice_skill(object me) {
  return notify_fail("龙之力量无法通过练习来成长。\n");
}
int valid_learn(object me) {
  return 1;
}

string query_dodge_msg(string limb) {
  return dodge_msg[random(sizeof(dodge_msg))];
}
string perform_action_file(string action) {
  return __DIR__ "dragon/" + action;
}

mixed hit_ob(object me, object victim, int damage_bonus, int factor) {

  int ap, dp, damage2;

  ap = (int)me->query_skill("dragon", 1);
  dp = (int)victim->query_skill("dodge", 1);

  damage2 = (int)me->query_skill("dragon", 1);

  if (damage_bonus < 100) return 0;
  if (me->query_skill("dragon", 1) < 100) return 0;
  if (me->query("jiali") < 1 || me->query("neili") < 100) return 0;
  if (damage2 < 10) damage2 = 10;

  if (random(6) == 0 && me->query_skill_mapped("unarmed") == "dragon" && me->query("jiali") > 0 && random(ap) > dp / 10) {
    me->add("neili", -100);
    victim->receive_damage("qi", damage2 + damage_bonus, me);
    victim->receive_wound("qi", damage2 + damage_bonus, me);
    victim->apply_condition(du[random(sizeof(du))], 25);
    return HIR "$N张口一吐，一股腥臭的气息扑来！！$n躲闪不及，被熏了个七晕八素！！\n";
  }

}

int ob_hit(object ob, object me, int damage) {
  int level, ap, dp, j;

  level = (int)me->query_skill("dragon", 1);
  ap = (int)me->query_skill("dragon", 1);
  dp = (int)ob->query_skill("unarmed", 1);

  if (damage < 10) damage = 10;
  if (random(6) == 0
    && level >= 300
    && random(ap) > dp / 10
    && me->query("neili") > 200
    && me->query("max_neili") > 900) {
    message_vision(HIC "$n一招击中$N，正沾沾自喜，哪知道$N张口吐出龙息，顿时被熏的晕头转向！！\n" NOR, me, ob);
    j = -damage;
    me->add("neili", -100);
    //		ob->apply_condition(du[random(sizeof(du))], 25);	
    return j;
  }
}
