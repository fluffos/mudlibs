// kuihua-xinfa.c 葵花心法
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit FORCE;
int valid_enable(string usage) { return usage == "force"; }

mapping *action = ({
  ([ "action": "$N身形飘忽，有如鬼魅，转了几转，移步向西，一剑刺向$n。出手之奇之快，直是匪夷所思",
    "attack": 200,
    "parry": 200,
    "dodge": 200,
    "damage": 200,
    "force": 200,
    "lvl": 0,
    "skill_name": "猱身而上",
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N潜运内力，忽进忽退，绕着$n身子乱转，手中$w所使剑招也如狂风骤雨一般，越来越快",
    "attack": 300,
    "parry": 300,
    "dodge": 300,
    "damage": 300,
    "force": 300,
    "lvl": 140,
    "skill_name": "反手刺出",
    "damage_type": "刺伤"
  ]),
  ([ "action": "就在$n一呆之际，$N向右跃开两尺，右足刚著地，身子跟著弹起，刷刷两剑，向$n攻去",
    "attack": 400,
    "parry": 400,
    "dodge": 400,
    "damage": 400,
    "force": 400,
    "lvl": 300,
    "skill_name": "直刺右眼",
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N一声尖叫，飞身纵起，在半空中一转，快绝无比的飞落下来，手中$w破空直刺$n$l",
    "attack": 500,
    "parry": 500,
    "dodge": 500,
    "damage": 500,
    "force": 500,
    "lvl": 350,
    "skill_name": "飞身跃起",
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N一声冷笑，蓦地里疾冲上前，当真是动如脱兔，一瞬之间，与$n相距已不到一尺，两人的鼻子几乎要碰在一起",
    "attack": 600,
    "parry": 600,
    "dodge": 600,
    "damage": 600,
    "force": 600,
    "lvl": 400,
    "skill_name": "腰枝一摆",
    "damage_type": "刺伤"
  ]),
});
mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];  //2017.9.4阿飞改，将招式简单点
}

int valid_learn(object me) {

  mapping skl;
  string *sname;

  int i = (int)me->query_skill("kuihua-xinfa", 1);
  int t = 1, j;
  for (j = 1; j < i / 10; j++) t *= 2;
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if ((string)me->query("gender") == "女性") {
    tell_object(me, "自古没有女人可以学葵花心法的。\n");
    return 0;
  }
  if ((string)me->query("gender") == "男性") {
    tell_object(me, "葵花心法第一要诀：欲练神功，必先自宫。\n");
    return 0;
  }
  if ((string)me->query("genderbak") == "男性")
    return notify_fail("你个假太监，赶紧去割了.\n");
  if (me->query("family/family_name") != "日月神教" || me->query("family/master_id") != "dongfang bubai")
    return notify_fail("葵花宝典似乎只听说东方教主练成了。\n");
  if ((int)me->query_skill("force", 1) < 100) {
    tell_object(me, "你的基本内功火候不足，不能学葵花心法。\n");
    return 0;
  }
  if ((int)me->query_skill("kuihua-xinfa", 1) < 100)
    return notify_fail("你都没听说葵花心法，从何学起！\n");
  if (me->query_skill("force", 1) <= i) {
    tell_object(me, "你的基本内功基础不够，再学下去会走火入魔的。\n");
    return 0;
  }
  if (me->query_skill("buddhism", 1)) {
    tell_object(me, "你练了秃驴们的心法，还学葵花心法做什麽！\n");
    return 0;
  }
  if ((int)me->query("score", 1) < 5000)
    return notify_fail("你对我派毫无贡献而言，怎么可能传授你武功呢。\n");

  skl = me->query_skills();
  sname = keys(skl);
  for (i = 0; i < sizeof(skl); i++) {
    if (sname[i] == "kuihua-xinfa") continue;
    if (sname[i] == "xixing-dafa") continue;
    if (sname[i] == "yijing-force") continue;
    if (sname[i] == "kuihua-dafa") continue;
    if (SKILL_D(sname[i])->valid_enable("force")) {
      tell_object(me, "你不先散了别派内功，怎能学葵花心法？！\n"); return 0;
    }
    return notify_fail("葵花心法只能通过研习《葵花宝典》来学习。\n");
  }
  if (random(100) == 1) me->add("score", -5);
  return 1;
}
int practice_skill(object me) {
  return notify_fail("葵花心法只能用学(learn)的来增加熟练度。\n");
}
string exert_function_file(string func) {
  return __DIR__ "kuihua-xinfa/" + func;
}

void skill_improved(object me) {
  int s;
  s = me->query_skill("kuihua-xinfa", 1);
  if (s % 10 == 0) {
    tell_object(
      me,
      HIW "你的葵花神功已经修炼到第" + HIY + CHINESE_D->chinese_number(s / 10) + HIW + "重了。\n" NOR
    );
  }
}


mixed hit_ob(object me, object victim, int damage_bonus, int factor) {
  int damage2, ap, dp;
  damage2 = (int)me->query_skill("kuihua-xinfa", 1);
  ap = me->query_skill("kuihua-xinfa");
  dp = victim->query_skill("force", 1);
  if (damage_bonus < 100) return 0;
  if (me->query_skill("kuihua-xinfa", 1) < 100) return 0;
  if (me->query("jiali") < 1 || me->query("neili") < 100 || me->query_skill_mapped("force") != "kuihua-xinfa") return 0;
  if (damage2 < 10) damage2 = 10;
  if (random(ap) > dp / 20 && random(6) == 0 && me->query("jiali") > 0) {
    victim->receive_wound("qi", damage2 + 100 + damage_bonus / 2, me);
    me->add("neili", -100);
    return HIB "明明一个大男人，却学女人的笑声！$N阴阴的笑了三声，一股阴柔的内劲摧毁了$n的真元！！！！\n" NOR;
  }
}


mapping exercise_msg(object me) {
  return ([
    "status_msg": "脸现娇媚之色，阴阴一笑。\n",
    "start_my_msg": "右手食指作兰花状，左手食指微微翘起，神情专注，周身慢慢变的忽隐忽现。\n",
    "start_other_msg": me->name() + "右手食指作兰花状，左手食指微微翘起，身形忽隐忽现，不一会笼罩在烟雾之中。\n",
    "heal_my_msg": "脸上一会艳若桃李，一会冷若冰霜，双手如西子捧心，眉头轻皱，口吐葵花，不一会身子隐于花丛之中。\n",
    "heal_other_msg": me->name() + "脸上一会艳若桃李，一会冷若冰霜，双手如西子捧心，眉头轻皱，口吐葵花，不一会身子隐于花丛之中。\n",
    "halt_msg": "只听阴阴一笑，虚空中突然闪现了一道身影。\n",
    "end_my_msg": "时而娇羞，时而阴笑，周围阴风四起。待得狂风卷过，你阴阴一笑，缓缓站起。\n",
    "end_other_msg": me->name() + "时而娇羞，时而阴笑，周围阴风四起。待得狂风卷过，你阴阴一笑，缓缓站起。\n",
    "hover_my_msg": "“咯咯”惨笑，声音一会如穿云裂帛，一会娇媚入骨。过了良久，笑声渐渐平息，紧跟着周围阴气也渐渐消散了。\n",
    "hover_other_msg": "只听得" + me->name() + "“咯咯”惨笑，声音一会如穿云裂帛，一会娇媚入骨。过了良久，笑声渐渐平息，紧跟着周围阴气也渐渐消散了。\n",
  ]);
}
