// art.c 琴棋书画  下乘武学100~300
// cck 3/7/97
//cool 10/10/98
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit SKILL;
int do_play(string arg);


int valid_enable(string usage) {
  return (usage == "literate");
}


int valid_learn(object me) {
  if (me->query("int", 1) < 25)
    return notify_fail("琴棋书画乃是极其风雅之事，" + RANK_D->query_respect(me) + " 似乎太过于俗气了些。\n");
  if ((int)me->query_skill("literate", 1) < 1000)
    return notify_fail("就你这点文学修养，还想学琴棋书画，也不掂量掂量！\n");
  if ((int)me->query("shen") < -10000)
    return notify_fail("你杀人如麻，倘若不能先平息了心头魔念，哪里又会有心思弹琴下棋？\n");
  if ((int)me->query("score", 1) < 10000)
    return notify_fail("琴棋书画需要体验人间百态，一看你就知道阅历不丰。\n");
  if (random(100) == 1) me->add("score", -10);
  return 1;
}

int practice_skill(object me) {
  return notify_fail("琴棋书画只能靠学(learn)来提高。\n");
}

void init() {
  add_action("do_play", "play");
}

int do_play(string arg) {
  object me = this_player();

  if (!arg && (arg != "music") && (arg != "zheng") && (arg != "gu zheng") && (arg != "wei qi") && (arg != "qi") && (arg != "go"))
    return notify_fail("你要做什么？\n");
  if (me->is_busy())
    return notify_fail("你现在正忙着呢。\n");
  if ((int)me->query("jingli") < 10000)
    return notify_fail("你的精力不够了。\n");
  if ((int)me->query("neili") < 10000)
    return notify_fail("你的内力不够了。\n");

  if (present(
    "gu zheng",
    this_player()
  ) && ((arg == "music") || (arg == "zheng") || (arg == "gu zheng"))) {
    if (me->query_skill("art", 1) < 50) {
      message_vision("$N摆出一张古筝，铮铮琮琮弹了几声，只听得曲调杂乱无章，宛如鬼哭狼号。\n", me);
      me->add("neili", -1000);
      me->add("jingli", -1000);
      me->start_busy(1);
      return 1;
    }
    if (me->query_skill("art", 1) > 300) {
      message_vision("$N摆出一张古筝，铮铮琮琮弹了几声，只听得曲调平和，洋洋洒洒，颇有佳意。\n", me);
    }
    me->add("neili", -100);
    me->add("jingli", -100);
    if (me->query_skill("art", 1) < (me->query("xyzx_sys/level") + 300) * 2)
      me->improve_skill("art", (int)me->query_int() / 100 + (int)me->query_skill("art", 1));
    tell_object(me, "你摆出一张古筝，调了调弦，弹了起来，你只觉得连日来烦燥的心情好了许多。\n");
    message_vision(
      "只见" + me->query("name") + "雅兴大发，竟弹起曲子来，你只觉得时而金戈铁马、大漠平沙。。。。。。\n" "时而小桥流水、几户人家。。。。。。万般气象，你心情顿时宁静了许多。\n",
      environment(me),
      ({ me })
    );
  }

  if (present("wei qi", this_player()) && ((arg == "wei qi") || (arg == "qi") || (arg == "go"))) {
    if ((me->query_skill("art", 1) < 50)) {
      message_vision("$N摆出一张棋盘，想研究围棋，却总觉得心烦意乱，定不下神来。\n", me);
      me->add("neili", -1000);
      me->add("jingli", -1000);
      me->start_busy(1);
      return 1;
    }
    if (me->query_skill("art", 1) > 300) {
      message_vision("$N摆出一张棋盘，只觉棋面布局尽在筹幄只之中，无密可研。\n", me);
    }

    me->add("neili", -100);
    me->add("jingli", -100);
    if (me->query_skill("art", 1) < (me->query("xyzx_sys/level") + 100) * 2)
      me->improve_skill("art", (int)me->query_int() / 100 + (int)me->query_skill("art", 1));
    tell_object(me, "你摆出一张棋盘，研究起围棋来，只觉得心平气和，很快就仿佛入定了。\n");
    message_vision(
      "只见" + me->query("name") + "雅兴大发，竟打起棋谱来，对外界仿佛不闻不问，一副莫测高深的模样。\n",
      environment(me),
      ({ me })
    );
  }

  me->start_busy(1);
  return 1;
}

string perform_action_file(string action) {
  return __DIR__ "art/" + action;
}
