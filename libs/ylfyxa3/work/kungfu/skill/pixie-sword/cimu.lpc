// cimu.c  辟邪剑法「刺目」

#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>

inherit F_SSERVER;
int perform(object me, object target) {
  int damage, skill, ap, dp;
  string msg;
  object weapon;

  if (!target) target = offensive_target(me);
  if (!target || !target->is_character() || !me->is_fighting(target))
    return notify_fail("「刺目」只能对战斗中的对手使用。\n");
  if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "sword")
    return notify_fail("「刺目」必须用剑才能施展。\n");
  if ((int)me->query_skill("pixie-sword", 1) < 500)
    return notify_fail("你辟邪剑法不够娴熟，使不出「刺目」。\n");
  if (target && target->query_temp("apply/shade_vision"))
    return notify_fail("对方隐身了，你看不到" + target->query("name") + "。\n");
  if ((int)me->query("jingli") < 1000)
    return notify_fail("你精力不足。\n");
  if (me->is_busy())
    return notify_fail("你现在正忙着呢！\n");
  if (target && target->is_busy())
    return notify_fail(target->name() + "目前正自顾不暇，放胆攻击吧。\n");
  if (target && target->query_temp("block_msg"))
    return notify_fail(target->name() + "目前已经啥也看不见了，放胆攻击吧。\n");
  if (target && target->query_temp("busy_mianyi"))  //冲穴成功后免疫busy，2017.9.29阿飞添加
    return notify_fail(target->name() + "奇经八脉浑然一体，真气浩浩荡荡，点穴似乎没什么作用。\n");
  if ((int)me->query_temp("pixie/cimu"))
    return notify_fail("你已经在运功中了。\n");
  if ((int)me->query("neili") < 1000)
    return notify_fail("你现在内力不够，没能将「刺目」使完！\n");
  if ((string)me->query("gender") == "女性")
    return notify_fail("自古就没有女子可以使用.\n");
  if ((string)me->query("gender") == "男性")
    return notify_fail("欲练神功，必先自宫，欲使神功，快快进宫.\n");
  if ((string)me->query("genderbak") == "男性")
    return notify_fail("你个假太监，赶紧去割了.\n");
  if (me->query_skill_mapped("sword") != "pixie-sword")
    return notify_fail("你没正确激发该技能 。\n");
  if (me->query_temp("autolian"))
    return notify_fail("你正在发动自动连招！\n");
  if (me->query_temp("cooldown"))  //CD写法	2017.9.7添加
    return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");

  me->set_temp("cooldown", 1);  //CD写法	2017.9.7添加
  call_out("del_cooldown", 3, me);  //CD写法1
  ap = me->query("xyzx_sys/level") + me->query_skill(
    "pixie-sword",
    1
  ) + me->query_skill("sword") + me->query_skill("force");
  dp = target->query("xyzx_sys/level") + target->query_skill("dodge") + target->query_skill("parry");
  skill = me->query_skill("pixie-sword", 1);

  msg = RED "$N嫣然一笑，诡异之极，身法陡然加快！" NOR;
  msg += RED "$N手中长剑一振，剑尖一点暴长，分刺$n左右双目，\n" NOR;
  message_vision(msg, me, target);

  me->add_temp("apply/attack", skill * 2);
  me->add_temp("apply/damage", skill * 2);
  me->add_temp("apply/dexerity", skill * 2);
  msg = RED "先刺双目！" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = RED "后刺双足！" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = RED "最后刺心！" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  me->add_temp("apply/attack", -skill * 2);
  me->add_temp("apply/damage", -skill * 2);
  me->add_temp("apply/dexerity", -skill * 2);
  me->add("neili", -200);

  if (random(ap) > dp / 3) {
    damage = (int)me->query_skill("pixie-sword", 1) + (int)me->query_skill("sword", 1);
    damage = damage + random(damage);
    target->receive_damage("qi", damage, me);
    target->receive_wound("qi", damage, me);
    msg = WHT "$n只看到寒尖一点，双目一阵剧痛，眼前一黑，就什么也看不见了，顿时长声痛极而呼！\n" NOR;
    message_vision(msg, me, target);
    if (userp(me) && me->query("env/no_combat_msg") < 4) tell_object(
      me,
      HIW "该绝招对敌人气血的外伤为" + damage + "，内伤为" + damage + "。\n" NOR
    );
    target->start_busy((30 * skill) / (skill + 2000) + 5);
    tell_object(target, HIY "你陷入忙乱之中，一时无法动弹。\n" NOR);
    me->add("neili", -200);
    target->set_temp("block_msg/all", 1);
    call_out("tuwu_end", 5 + (30 * skill) / (skill + 3000), me, target);

  } else {
    msg = "$n情急智生，抬手也向$N右眼刺去，迫得$N回剑跃开。\n" NOR;
    message_vision(msg, me, target);
  }
  if (!target->is_fighting(me)) target->fight_ob(me);
  me->start_busy(1);
  return 1;
}

void tuwu_end(object me, object target) {
  if (!objectp(target)) return;
  //if ( environment(me) != environment(target) ) return;
  //target->enable_player();
  target->delete_temp("block_msg/all");
  message_vision("$N抹了抹满脸的" HIR "鲜血" NOR "，终于睁开了眼。\n", target);
  tell_object(target, HIR "你终于抹掉了满脸的鲜血，看到了周围的情景。\n" NOR);
  return;
}

void del_cooldown(object me)  //CD写法1
{
  if (!objectp(me)) return;
  if (me->query_temp("cooldown")) {
    me->delete_temp("cooldown");
    tell_object(me, HIM "你呼出一口气，缓缓的将内力收回丹田。\n" NOR);
  }
}
