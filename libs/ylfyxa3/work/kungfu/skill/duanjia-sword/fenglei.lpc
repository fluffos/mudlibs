//风雷 fenglei.c 

#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>

inherit F_SSERVER;

//#include "/kungfu/skill/eff_msg.h";

int perform(object me, object target) {
  object weapon;
  string msg;
  int damage, skill, ap, dp;

  if (!target) target = offensive_target(me);
  if (!target || !target->is_character() || !me->is_fighting(target))
    return notify_fail("「风雷四击」只能在战斗中使用。\n");
  if (me->is_busy())
    return notify_fail("你现在正忙着呢！\n");
  if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "sword" || me->query_skill_mapped("sword") != "duanjia-sword")
    return notify_fail("手中无剑,你怎么使得出「风雷四击」！\n");
  if (target && target->query_temp("apply/shade_vision"))
    return notify_fail("对方隐身了，你看不到" + target->query("name") + "。\n");
  if (me->query_skill_mapped("force") != "kumu-shengong")
    return notify_fail("你不激发枯木神功，恐怕使用不了「风雷四击」。\n");
  if ((int)me->query_skill("kumu-shengong", 1) < 300)
    return notify_fail("你的枯木神功的火候还不到家, 不能使用这一绝技 !\n");
  if ((int)me->query("neili") < 1000)
    return notify_fail("你的真气不够！\n");
  if ((int)me->query("jingli") < 1000)
    return notify_fail("你的精力不够。\n");
  if ((int)me->query_skill(
    "duanjia-sword",
    1
  ) < 300 || me->query_skill_mapped("sword") != "duanjia-sword")
    return notify_fail("你的段家剑法还不到家，无法使用「风雷四击」绝技！\n");
  if (me->query_temp("autolian"))
    return notify_fail("你正在发动自动连招！\n");
  if (me->query_temp("cooldown"))  //CD写法	2017.9.7添加
    return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");

  ap = me->query("xyzx_sys/level") + me->query_skill(
    "duanjia-sword",
    1
  ) + me->query_skill("sword") + me->query_skill("force");
  dp = target->query("xyzx_sys/level") + target->query_skill("dodge") + target->query_skill("parry");
  message_vision(BLU "\n $N长笑一声，剑交左手，蹂身而上，施展「风雷四击」绝技,试图快速击伤$n \n" NOR, me, target);
  me->set_temp("cooldown", 1);  //CD写法	2017.9.7添加
  call_out("del_cooldown", 3, me);  //CD写法1

  skill = (int)me->query_skill("duanjia-sword", 1);
  me->add_temp("apply/damage", skill * 2);
  me->add_temp("apply/attack", skill * 4);

  msg = HIY "$N跨步冲前，身体旋转，起手一剑攻向$n！\n" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = HIY "$N握剑直上，对着$n就是一剑！\n" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = HIY "$N脚踩流星步，错步而前，恍惚之间已到$n面前！\n" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = HIY "$N立身而起，一鹤冲天，一招[风火雷电]闪电般劈向$n！ \n" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  me->add_temp("apply/damage", -skill * 2);
  me->add_temp("apply/attack", -skill * 4);
  if (random(ap) > dp / 3) {
    damage = (int)me->query_skill(
      "duanjia-sword",
      1
    ) * 2 + (int)me->query_skill("kumu-shengong", 1) + (int)me->query_skill("sword", 1);
    damage = damage + random(damage);
    target->receive_damage("qi", damage, me);
    target->receive_wound("qi", damage / 2, me);
    message_vision(HIC "\n $n还未看到剑尖，就已经连中四剑，四道血箭彪射！$n \n" NOR, me, target);
    if (userp(me) && me->query("env/no_combat_msg") < 4) tell_object(
      me,
      HIW "该绝招对敌人气血的外伤为" + damage + "，内伤为" + damage / 2 + "。\n" NOR
    );
  }
  me->add("neili", -500);
  me->start_busy(1);
  return 1;
}

void del_cooldown(object me)  //CD写法1
{
  if (!objectp(me)) return;
  if (me->query_temp("cooldown")) {
    me->delete_temp("cooldown");
    tell_object(me, HIM "你呼出一口气，缓缓的将内力收回丹田。\n" NOR);
  }
}
