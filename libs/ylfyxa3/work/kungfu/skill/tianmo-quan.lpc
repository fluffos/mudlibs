//tianmo-quan 	天魔拳法	下乘武学100~300
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit SKILL;

mapping *action = ({
  ([ "action": "$N双拳一错，一招“魔火天焚”幻出漫天拳影拢向$n的$l",
    "attack": 100,
    "parry": 100,
    "dodge": 100,
    "damage": 100,
    "force": 100,
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N双拳纷飞，一招“魔王食飧”直取$n的$l",
    "attack": 200,
    "parry": 200,
    "dodge": 200,
    "damage": 200,
    "force": 200,
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N暴喝一声，双拳连环推出，一招“魔吼天地”强劲的拳风直扑$n的$l",
    "attack": 200,
    "parry": 200,
    "dodge": 200,
    "damage": 200,
    "force": 200,
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N使出如意地魔连环八拳中的“魔弑森森”，完全将$n的$l笼罩在双拳之下",
    "attack": 200,
    "parry": 200,
    "dodge": 200,
    "damage": 200,
    "force": 200,
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N化拳为刀，一招“乾坤尽魔”，左右拳分砍$n的两处要害",
    "attack": 200,
    "parry": 200,
    "dodge": 200,
    "damage": 200,
    "force": 200,
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N内气上提，全身拔起，一招“魔高和寡”，双拳凌空拍下",
    "attack": 300,
    "parry": 300,
    "dodge": 300,
    "damage": 300,
    "force": 300,
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N提气游走，一招“魔海漭漭”，森森拳风无孔不入般地击向$n的$l",
    "attack": 300,
    "parry": 300,
    "dodge": 300,
    "damage": 300,
    "force": 300,
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N使出如意地魔连环八拳中的“璞宇浑魔”双拳携天地魔神之威击向$n的$l",
    "attack": 300,
    "parry": 300,
    "dodge": 300,
    "damage": 300,
    "force": 300,
    "damage_type": "瘀伤"
  ]),

});

mapping query_action(object me) {
  if (random(me->query_skill("tianmo-quan", 1)) > 300
    && me->query("jiali") > 50
    && me->query("neili") > 300
    && random(20) > 12) {
    me->add("neili", -100);
    return ([ "action": HIY "只见$N拚尽全力，全身急疾飞旋，双拳豪光暴现，一股骇人的拳力攻向$n的胸前" NOR,
      "attack": 300,
      "parry": 300,
      "dodge": 300,
      "damage": 300,
      "force": 300,
      "damage_type": "瘀伤"
    ]);
  }
  return action[random(sizeof(action))];
}

int valid_enable(string usage) { return usage == "parry" || usage == "cuff" || usage == "unarmed"; }

int valid_learn(object me) {
  //		if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if (me->query("family/family_name") != "日月神教")
    return notify_fail("你不是本门中人，无法学习本门技能。\n");
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练天魔拳必须空手。\n");
  if ((int)me->query_skill("tianmo-shengong", 1) < 100)
    return notify_fail("你的天魔神功火候不够，无法练天魔拳。\n");
  if ((int)me->query_skill("unarmed", 1) < (int)me->query_skill("tianmo-quan", 1))
    return notify_fail("你的拳脚基础太差。\n");
  if ((int)me->query("max_neili") < 10000)
    return notify_fail("你的内力太弱，无法练天魔拳");
  return 1;
}

int practice_skill(object me) {
  //		if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");		
  if ((int)me->query("qi") < 100)
    return notify_fail("你的体力太低了。\n");
  if ((int)me->query("neili") < 100)
    return notify_fail("你的内力不够练天魔拳。\n");
  if (me->query("family/family_name") != "日月神教")
    return notify_fail("你不是日月神教弟子，不能练习本门武功。\n");
  if ((int)me->query_skill("unarmed", 1) < (int)me->query_skill("tianmo-quan", 1))
    return notify_fail("你的拳脚基础太差。\n");
  me->receive_damage("qi", 30);
  me->add("neili", -5);
  return 1;
}

string perform_action_file(string action) {
  return __DIR__ "tianmo-quan/" + action;
}

mixed hit_ob(object me, object victim, int damage_bonus) {
  int ap, dp, damage2, level;
  level = (int)me->query_skill("tianmo-shengong", 1);
  ap = (int)me->query("str", 1) * (int)me->query_skill("tianmo-quan", 1);
  dp = (int)victim->query("dex", 1) * (int)me->query_skill("parry", 1);
  damage2 = (int)me->query_skill("tianmo-quan", 1);
  if (damage_bonus < 100) return 0;
  if (me->query_skill("tianmo-shengong", 1) < 100) return 0;
  if (me->query("jiali") < 1 || me->query("neili") < 100 || me->query_skill_mapped("force") != "tianmo-shengong") return 0;
  if (damage2 < 10) damage2 = 10;
  if (random(5) == 0 && (int)me->query_skill(
    "tianmo-quan",
    1
  ) > 300 && me->query("neili") > 500 && random(ap) > dp / 10 && me->query("jiali") > 0) {
    me->add("neili", -100);
    victim->receive_wound("qi", damage2 * 2 + damage_bonus / 2, me);
    victim->receive_damage("qi", damage2 * 2 + damage_bonus / 2, me);
    me->receive_damage("qi", level, victim);
    return HIY "$N默运天魔解体大法，双拳魔气翻腾，$n一着不慎，被击的血气翻涌。\n" NOR;
  }
}
