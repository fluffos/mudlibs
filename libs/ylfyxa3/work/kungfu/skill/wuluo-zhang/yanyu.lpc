// yanyu.c  烟雨蒙蒙

#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>

#define YANYU "「" HIW "烟雨蒙蒙" NOR "」"

inherit F_SSERVER;


int perform(object me, object target) {
  string msg;
  int ap, dp, damage, damage1, skill;

  if (!target) target = offensive_target(me);
  if (!target || !target->is_character() || !me->is_fighting(target))
    return notify_fail(YANYU "只能对战斗中的对手使用。\n");
  if (me->is_busy())
    return notify_fail("你现在正忙着呢！\n");
  //	if (target && target->query_temp("apply/shade_vision")) 
  //		return notify_fail("对方隐身了，你看不到"+target->query("name")+"。\n"); 	
  if (objectp(me->query_temp("weapon")))
    return notify_fail(YANYU "只能空手施展。\n");
  if (!wizardp(me) && me->query("gender") != "女性")
    return notify_fail("你又不是女人，难以体会「烟雨蒙蒙」的意境！\n");
  if ((int)me->query_skill("kumu-shengong", 1) < 1000)
    return notify_fail("你的枯木神功修为不够，难以施展" YANYU "。\n");
  if ((int)me->query_skill("wuluo-zhang", 1) < 1000)
    return notify_fail("你的五罗轻烟掌修为不够，难以施展" YANYU "。\n");
  if ((int)me->query_skill("feifeng-whip", 1) < 1000)
    return notify_fail("你的飞凤鞭法修为不够，难以施展" YANYU "。\n");
  if (me->query("max_neili") < 1000000)
    return notify_fail("你的内力不够深厚，难以施展" YANYU "。\n");
  if ((int)me->query("max_jingli") < 200000)
    return notify_fail("你的精力修为不够。\n");
  if ((int)me->query("jingli") < 10000)
    return notify_fail("你的精力不够。\n");
  if (me->query_skill_mapped("unarmed") != "wuluo-zhang")
    return notify_fail("你没有激发五罗轻烟掌为拳脚，难以施展" YANYU "。\n");
  if (me->query_skill_mapped("force") != "kumu-shengong")
    return notify_fail("你没有激发枯木神功为内功，难以施展" YANYU "。\n");
  if (!(int)me->query("breakup"))
    return notify_fail("你任督二脉未通,无法使用「烟雨蒙蒙」。\n" NOR);
  if (me->query("neili") < 10000)
    return notify_fail("你现在的真气不足，难以施展" YANYU "。\n");
  if (target && !living(target))
    return notify_fail("对方都已经这样了，用不着这么费力吧？\n");
  if (me->query_temp("autolian"))
    return notify_fail("你正在发动自动连招！\n");
  if (me->query_temp("cooldown"))  //CD写法	2017.9.7添加
    return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");

  message_vision(HBWHT "$N贯通大理武学，使出了大理段家的掌法之精髓！\n" NOR, me, target);
  me->set_temp("cooldown", 1);  //CD写法	2017.9.7添加
  call_out("del_cooldown", 5, me);  //CD写法1	
  msg = HIB "情深深雨濛濛，多少楼台烟雨中。\n"
    HIB "记得当初你侬我侬，车如流水马如龙。\n"
    HIG "尽管狂风平地起，美人如云剑如虹。\n"
    HIC "啊情深深雨濛濛，世界只在你眼中。\n" NOR;
  message_vision(msg, me, target);

  ap = me->query("xyzx_sys/level") + me->query_skill(
    "wuluo-zhang",
    1
  ) + me->query_skill("feifeng-whip", 1) + me->query_skill("unarmed") + me->query_skill("force");
  dp = target->query("xyzx_sys/level") + target->query_skill("dodge") + target->query_skill("parry");
  skill = me->query_skill("wuluo-zhang", 1) + me->query_skill("feifeng-whip", 1);
  if (random(ap) > dp / 3) {
    message_vision(HIR "$n" HIR "见$P" HIR "来势迅猛之极，一时不知该如"
      "何作出抵挡，竟呆立当场。\n" NOR, me, target);
    msg = HIG "情深深，雨蒙蒙 多少楼台烟雨中。\n" NOR;
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
    msg = HIC "记得当初，你侬我侬，车如流水马如龙。\n" NOR;
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
    msg = HIW "尽管狂风平地起，美人如玉剑如红。\n" NOR;
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
    msg = HIM "情深深，雨蒙蒙，世界只在你眼中。\n" NOR;
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
    msg = HIR "相逢不晚，为何匆匆，山山水水几万重。\n" NOR;
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
    msg = HIY "一曲高歌千行泪，情在回肠荡气中。\n" NOR;
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
    msg = HIG "情深深，雨蒙蒙，天也无尽无穷。\n" NOR;
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
    msg = HIC "高楼望断，情有独钟，盼过春夏秋冬。\n" NOR;
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
    msg = HIY "盼来盼去盼不尽，天涯何处是归鸿。\n" NOR;
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);

    me->add("neili", -1000);
    me->add("jingli", -1000);
  } else {
    message_vision(HIY "$n" HIY "见$p" HIY "来势迅猛之极，甚难防备，连"
      "忙振作精神，小心抵挡。\n" NOR, me, target);
  }


  if (me->query_skill("wuluo-zhang", 1) > 2000 && me->query_skill("feifeng-whip", 1) > 2000) {
    skill = me->query_skill("wuluo-zhang", 1) + me->query_skill("feifeng-whip", 1);
    me->add_temp("apply/strength", skill * 2);
    me->add_temp("apply/damage", skill);
    msg = HIY "往事一幕幕伤心一幕幕，你的眼光你的笑伴我今日孤独。\n"
      HIB "烟雨一重重山水一重重，你的叮咛你的泪是我心中最痛。\n"
      HIG "我最怕最怕烟雨蒙蒙，还记得风雨里和你相逢。\n"
      HIC "早知道早知道如此匆匆，又何必又何必和你相逢。\n" NOR;
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
    me->add_temp("apply/strength", -skill * 2);
    me->add_temp("apply/damage", -skill);

    message_vision(HIC
      "\n       情             情            深             深深深深深深深深深深               深             深深深深深深深深深深            \n"
      "\n       情             情               深        深                    深                深        深                    深          \n"
      "\n       情         情情情情情              深   深           深           深                 深   深           深           深        \n"
      "\n       情             情            深                      深                        深                      深                     \n"
      "\n       情         情情情情情           深             深深深深深深深                     深             深深深深深深深               \n"
      "\n     情情情           情                  深                深                              深                深                     \n"
      "\n   情  情  情   情情情情情情情                       深     深     深                                  深     深     深              \n"
      "\n 情    情    情                                    深       深       深	                            深       深       深            \n"
      "\n       情         情情情情情情            深     深         深         深                   深     深         深         深          \n"
      "\n       情         情        情           深    深           深           深                深    深           深           深        \n"
      "\n       情         情  情情  情          深   深             深             深             深   深             深             深      \n"
      "\n       情         情        情         深                   深                           深                   深                     \n"
      "\n       情         情  情情  情        深                    深                          深                    深                     \n"
      "\n       情         情        情       深                     深                         深                     深                     \n"
      "\n       情         情        情                              深                                                深                     \n" NOR, me, target);

    message_vision(HIY "$N" HIY "一道掌力打出，接着便涌出了第二道、第三道掌力，掌势"
      "连绵不绝，如烟如雾！直到$N" HIY "\n第十三道掌力打完，四周所笼罩"
      "着的烟雨方才慢慢消退！而$n" HIY "此时却已是避无可避！\n\n" NOR, me, target);
    if (me->query("jm/dali")) damage1 = me->query("xyzx_sys/level") + me->query_skill(
      "wuluo-zhang",
      1
    ) * me->query(
      "int",
      1
    ) / 2 + me->query_skill(
      "feifeng-whip",
      1
    ) * me->query(
      "dex",
      1
    ) / 2 + me->query_skill("unarmed", 1) + me->query_skill("force") + me->query_skill("whip", 1);
    else damage1 = me->query("xyzx_sys/level") + me->query_skill(
      "wuluo-zhang",
      1
    ) * me->query(
      "int",
      1
    ) / 3 + me->query_skill(
      "feifeng-whip",
      1
    ) * me->query(
      "dex",
      1
    ) / 3 + me->query_skill("unarmed", 1) + me->query_skill("force") + me->query_skill("whip", 1);
    damage = damage1 + random(damage1);
    target->receive_damage("qi", damage, me);
    target->receive_wound("qi", damage / 2, me);
    if (userp(me) && me->query("env/no_combat_msg") < 4) tell_object(
      me,
      HIW "该绝招对敌人气血的外伤为" + damage + "，内伤为" + damage / 2 + "。\n" NOR
    );
    me->add("neili", -2000);
    me->add("jingli", -2000);
  }
  if (me->query_skill("wuluo-zhang", 1) > 3000 && me->query_skill("feifeng-whip", 1) > 3000) {
    if (me->query("jm/dali")) damage1 = 1000 + me->query_skill(
      "wuluo-zhang",
      1
    ) * me->query(
      "int",
      1
    ) * 3 / 2 + me->query_skill(
      "feifeng-whip",
      1
    ) * me->query(
      "dex",
      1
    ) * 3 / 2 + me->query_skill(
      "kumu-shengong",
      1
    ) * me->query(
      "int",
      1
    ) * 3 / 2 + me->query_skill(
      "unarmed",
      1
    ) + me->query_skill("force") + me->query_skill("whip", 1) + me->query("qi") / 50;
    else damage1 = 1000 + me->query_skill(
      "wuluo-zhang",
      1
    ) * me->query(
      "int",
      1
    ) + me->query_skill(
      "feifeng-whip",
      1
    ) * me->query(
      "dex",
      1
    ) + me->query_skill(
      "kumu-shengong",
      1
    ) * me->query(
      "int",
      1
    ) + me->query_skill(
      "unarmed",
      1
    ) + me->query_skill("force") + me->query_skill("whip", 1) + me->query("qi") / 80;

    damage = damage1 + random(damage1);

    if (random(me->query("max_neili")) > target->query("max_neili") / 3) {
      message_vision(HIR "一曲高歌千行泪，情在回肠荡气中。"
        HIC "啊情深深雨濛濛，天也无尽地无穷。\n" NOR, me, target);
      me->add("neili", -3000);
      me->add("jingli", -3000);
      target->receive_damage("qi", damage, me);
      target->receive_wound("qi", damage / 2, me);
      if (userp(me) && me->query("env/no_combat_msg") < 4) tell_object(
        me,
        HIW "该绝招对敌人气血的外伤为" + damage + "，内伤为" + damage / 2 + "。\n" NOR
      );
      if (random(3) == 0) {
        message_vision(HIM
          "\n      雨雨雨雨雨雨雨雨雨                       蒙          蒙                             蒙          蒙                         \n"
          "\n              雨                           蒙蒙蒙蒙蒙蒙蒙蒙蒙蒙蒙                     蒙蒙蒙蒙蒙蒙蒙蒙蒙蒙蒙                     \n"
          "\n  雨雨雨雨雨雨雨雨雨雨雨雨雨                   蒙          蒙                             蒙          蒙                         \n"
          "\n  雨          雨          雨           蒙蒙蒙蒙蒙蒙蒙蒙蒙蒙蒙蒙蒙蒙蒙             蒙蒙蒙蒙蒙蒙蒙蒙蒙蒙蒙蒙蒙蒙蒙                 \n"
          "\n  雨          雨          雨          蒙                            蒙           蒙                            蒙                \n"
          "\n  雨   雨     雨   雨     雨         蒙      蒙蒙蒙蒙蒙蒙蒙蒙蒙      蒙         蒙      蒙蒙蒙蒙蒙蒙蒙蒙蒙      蒙               \n"
          "\n  雨     雨   雨     雨   雨               蒙蒙蒙蒙蒙蒙蒙蒙蒙蒙蒙                     蒙蒙蒙蒙蒙蒙蒙蒙蒙蒙蒙                     \n"
          "\n  雨          雨          雨                     蒙蒙                                       蒙蒙                                 \n"
          "\n  雨          雨          雨                   蒙   蒙       蒙                           蒙   蒙       蒙                       \n"
          "\n  雨  雨      雨   雨     雨                 蒙       蒙   蒙                           蒙       蒙   蒙                         \n"
          "\n  雨    雨    雨     雨   雨                        蒙  蒙 蒙                                  蒙  蒙 蒙                         \n"
          "\n  雨          雨          雨                      蒙    蒙   蒙                              蒙    蒙   蒙                       \n"
          "\n  雨          雨          雨                    蒙      蒙     蒙                          蒙      蒙     蒙                     \n"
          "\n  雨          雨          雨                        蒙  蒙       蒙                            蒙  蒙       蒙                   \n"
          "\n  雨                      雨                          蒙蒙                                       蒙蒙                            \n" NOR, me, target);

        message_vision(HIW "$n完全被你的深情感动，如飞蛾扑火般，张开双臂，拥抱烟雨！然越美丽的女人越是毒药！\n" NOR, me, target);
        target->unconcious(me);
        if (userp(me) && me->query("env/no_combat_msg") < 4) tell_object(
          me,
          HIW "该绝招对敌人造成了昏迷。\n" NOR
        );
        me->add("neili", -2000);
        me->add("jingli", -2000);
      }
    } else {
      target->receive_damage("qi", damage / 3, me);
      target->receive_wound("qi", damage / 5, me);
      me->add("neili", -1000);
      me->add("jingli", -1000);
      message_vision(HIB "$n不知情为何物，大笑道：“你个花痴！！！”" HIM "$N长叹一声：多情自古空余恨！\n" NOR, me, target);
      if (userp(me) && me->query("env/no_combat_msg") < 4) tell_object(
        me,
        HIW "该绝招对敌人气血的外伤为" + damage / 3 + "，内伤为" + damage / 5 + "。\n" NOR
      );
    }
  }
  me->start_busy(1);
  return 1;
}

void del_cooldown(object me)  //CD写法1
{
  if (!objectp(me)) return;
  if (me->query_temp("cooldown")) {
    me->delete_temp("cooldown");
    tell_object(me, HIM "你呼出一口气，缓缓的将内力收回丹田。\n" NOR);
  }
}
