int valid_learn(object me) {
  object ob;
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");		
  if ((int)me->query("max_neili") < 100000)
    return notify_fail("你的内力不够，没有办法练三才剑法。\n");
  if ((int)me->query("dex", 1) < 25)
    return notify_fail("你的身法太差，无法练「三才剑法」。\n");
  if ((int)me->query("int", 1) < 25)
    return notify_fail("你的悟性太差，无法练「三才剑法」。\n");
  if ((int)me->query_skill("zhenfeng-xinfa", 1) < 300)
    return notify_fail("你的「震风心法」火候不够，无法学「三才剑法」。\n");
  if ((int)me->query_skill("piaoyibu", 1) < 300)
    return notify_fail("你的「飘逸步法」火候不够，无法学「三才剑法」。\n");
  if (!(ob = me->query_temp("weapon")) || (string)ob->query("skill_type") != "sword")
    return notify_fail("你必须先找一把剑才能练剑法。\n");
  if (me->query("family/family_name") != "圣剑魔宫")
    return notify_fail("你不是圣剑魔宫传人，无法学习三才剑法。\n");
  if ((int)me->query("score", 1) < 5000)
    return notify_fail("你对我派毫无贡献而言，怎么可能传授你武功呢。\n");
  if (random(100) == 1) me->add("score", -5);
  return 1;
}

int valid_enable(string usage) {
  return usage == "sword" || usage == "parry";
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

int practice_skill(object me) {
  //		if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");		
  if ((int)me->query("jing") < 30
    || (int)me->query("neili") < 300)
    return notify_fail("你的内力或气不够，没有办法练习三才剑法。\n");
  if (me->query("family/family_name") != "圣剑魔宫")
    return notify_fail("你不是圣剑魔宫传人，无法学习三才剑法。\n");
  me->receive_damage("jing", 30);
  me->add("neili", -300);
  write("你按著所学练了一遍三才剑法。\n");
  return 1;
}

string perform_action_file(string action) {
  return __DIR__ "/three-sword/" + action;
}

int effective_level() { return 17; }

string *parry_msg = ({
  "$n使出「天」字诀，以攻为守、身随剑动，将$N迫得连连后退。\n",
  "$n使出一招地字决中的「地动天摇」，手中的$v含着内力震开了$N的$w。\n",
  "$n不顾$N的$w，一招人字决中的「人非人、我非我」，向$N的头上砍去。\n",
});

string *unarmed_parry_msg = ({
  "$n将手中的$v化做三道剑气，迫得$N连连后退。\n",
});

string query_parry_msg(object weapon) {
  if (weapon)
    return parry_msg[random(sizeof(parry_msg))];
  else
    return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}

int learn_bonus() {
  return -20;
}
int practice_bonus() {
  return -30;
}
int black_white_ness() {
  return 30;
}


mixed hit_ob(object me, object victim, int damage_bonus) {
  int ap, dp, damage2;
  damage2 = (int)me->query_skill("three-sword", 1);
  ap = me->query_skill("three-sword", 1);
  dp = victim->query_skill("parry", 1);
  if (damage_bonus < 100) return 0;
  if (me->query_skill("zhenfeng-xinfa", 1) < 100) return 0;
  if (me->query("jiali") < 1 || me->query("neili") < 100 || me->query_skill_mapped("force") != "zhenfeng-xinfa") return 0;
  if (damage2 < 10) damage2 = 10;
  if (me->query("jiali") > 0
    && me->query_skill_mapped("force") == "zhenfeng-xinfa"
    && random(ap) > dp / 10
    && random(5) == 0) {
    victim->receive_wound("qi", damage2 + damage_bonus / 2, me);
    me->add("neili", -100);
    return HIW "$N脚踏三星，忽快忽慢，忽左忽右，高声长歌：三才归一！\n" NOR;
  }
}
