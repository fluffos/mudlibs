    "attack": 200,
    "parry": 200,
    "dodge": 200,
    "damage": 200,
    "force": 200,
    "damage_type": "刺伤"
  ]),
  ([ "action":
    "$N左手握成天字诀，右手中的$w使出一招「风云突起」，斩向$n的$l",
    "attack": 200,
    "parry": 200,
    "dodge": 200,
    "damage": 200,
    "force": 200,
    "damage_type": "割伤"
  ]),
  ([ "action":
    "$N使出一招地字诀中的「山水相连」，身形婉如流水，手中$w有如泰山地斩向$n的$l",
    "attack": 300,
    "parry": 300,
    "dodge": 300,
    "damage": 300,
    "force": 300,
    "damage_type": "割伤"
  ]),
  ([ "action":
    "$N一式地字诀中的「水火无情」对准$n的$l刺出一剑",
    "attack": 400,
    "parry": 400,
    "dodge": 400,
    "damage": 400,
    "force": 400,
    "damage_type": "刺伤"
  ]),
  ([ "action":
    "$N手中$w一招人字诀中的「众生平等」，化出无数剑尖向$n刺出",
    "attack": 500,
    "parry": 500,
    "dodge": 500,
    "damage": 500,
    "force": 500,
