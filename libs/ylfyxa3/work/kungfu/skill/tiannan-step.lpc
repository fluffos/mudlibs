// tiannan-step.c 天南步法
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit SKILL;

string *dodge_msg = ({
  "只见$n一招「旱地拔葱」，身体向上笔直地纵起丈余，躲过了$N这一招。\n",
  "$n一个「雨燕归巢」，向后纵出数丈之远，避开了$N的凌厉攻势。\n",
  "$n使出「破土而出」，向一旁飘然纵出，轻轻着地。\n"
  "但是$n身形飘忽，一招「无中生有」轻轻一纵，早已避开。\n",
  "$n身随意转，一招「乘风而去」倏地往一旁挪开了三尺，避过了这一招。\n",
  "可是$n侧身一让，一招「鲧化大鹏」$N这一招扑了个空。\n",
  "却见$n足不点地，一招「青云直上」往旁窜开数尺，躲了开去。\n",
  "$n身形微晃，一招「凤翔九天」有惊无险地避开了$N这一招。\n"
});

int valid_enable(string usage) { return (usage == "dodge"); }

int valid_learn(object me) {
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");		
  if (me->query("family/family_name") != "大理段家")
    return notify_fail("你不是大理段家弟子，无法学习大理段家技能。\n");
  if (me->query_skill("dodge", 1) <= me->query_skill("tiannan-step", 1))
    return notify_fail("你的基本轻功基础不够，无法领会更高深的技巧。\n");

  return 1;

}

string query_dodge_msg(string limb) {
  return dodge_msg[random(sizeof(dodge_msg))];
}

int practice_skill(object me) {
  //		if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if (me->query("family/family_name") != "大理段家")
    return notify_fail("你不是大理段家弟子，无法练习大理段家技能。\n");
  if ((int)me->query("qi") < 40)
    return notify_fail("你的体力太差了，不能练段氏身法。\n");
  me->receive_damage("qi", 30);
  return 1;
}


string perform_action_file(string action) {
  return __DIR__ "tiannan-step/" + action;
}
//2017.3.25阿飞封掉ob_hit特效，怀疑与伤害为0的死亡bug有关
int ob_hit(object ob, object me, int damage) {

  int j, ap, dp, neili, neili1;

  ap = me->query_skill("tiannan-step", 1);
  dp = ob->query_skill("dodge", 1);
  neili = me->query("neili");
  neili1 = ob->query("neili");

  if (damage < 10) damage = 10;
  if (random(ap) > dp / 10
    && me->query_skill("kumu-shengong", 1) > 100
    && me->query_skill("tiannan-step", 1) > 200
    && me->query_skill_mapped("force") == "kumu-shengong"
    && me->query("neili") > 10000
    && random(5) == 0) {
    message_vision(HIG "$N身子一转，化风而去，轻轻一纵已是数丈远。\n" NOR, me, ob);
    if (neili >= random(neili1) + damage) {
      message_vision(HIC "$n的招式只碰着$N的衣角而已！\n" NOR, me, ob);
      j = -(damage * 2 + random(damage * 2));
      me->add("neili", -100);
    } else {
      message_vision(HIB "$N只躲过了$n的一小半力道！\n" NOR, me, ob);
      j = -(damage + random(damage));
      me->add("neili", -100);
    }
    return j;
  }
}
