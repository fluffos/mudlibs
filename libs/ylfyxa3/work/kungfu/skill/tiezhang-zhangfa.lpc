int valid_enable(string usage) {
  return usage == "strike" || usage == "parry" || usage == "unarmed";
}

mapping query_action(object me, object weapon) {
  int level = (int)me->query_skill("tiezhang-zhangfa", 1);

  if (random(level) > 300 && me->query_temp("powerup") && me->query("neili") > 300 && me->query("jiali") > 100) {
    me->add("neili", -100);
    return ([
      "action": HIR "$N突然大吼一声，身行疾飞而起，猛向$n直扑而下，空气中暴出“呜”的一声刺耳尖啸。" NOR,
      "attack": 600,
      "parry": 600,
      "dodge": 600,
      "damage": 600,
      "force": 600,
      "damage_type": "瘀伤"
    ]);
  }
  return action[random(sizeof(action))];  //2017.9.4阿飞改，将招式简单点
}


int valid_learn(object me) {
  //		if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");		
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练铁掌掌法必须空手。\n");
  if ((int)me->query_skill("guiyuan-tunafa", 1) < 300)
    return notify_fail("你的归元吐呐法火候不够，无法练铁掌掌法。\n");
  if (me->query("family/family_name") != "铁掌帮")
    return notify_fail("你未加入铁掌山，不能传授镇帮绝技。\n");
  if ((int)me->query("max_neili") < 100000)
    return notify_fail("你的内力修为不够，无法练铁掌掌法");
  if ((int)me->query("str", 1) < 30)
    return notify_fail("铁掌掌法乃一等一的刚猛掌法，以你的臂力恐怕难以发挥其威力。");
  if ((int)me->query("score", 1) < 5000)
    return notify_fail("你对我派毫无贡献而言，怎么可能传授你武功呢。\n");
  if (random(100) == 1) me->add("score", -5);
  return 1;
}


int practice_skill(object me) {
  //		if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");		
  if ((int)me->query("jing") < 30)
    return notify_fail("你的体力太低了。\n");
  if ((int)me->query("neili") < 8)
    return notify_fail("你的内力不够练铁掌掌法。\n");
  if (me->query("family/family_name") != "铁掌帮")
    return notify_fail("你未加入铁掌山，怎么能偷练该帮镇帮绝技呢。\n");

  me->receive_damage("jing", 20);
  me->add("neili", -5);
  return 1;
}

string perform_action_file(string action) {
  return __DIR__ "tiezhang-zhangfa/" + action;
}

mixed hit_ob(object me, object victim, int damage_bonus, int factor) {
  int lev, ap, dp, damage2;
  object weap;
  ap = me->query_skill("tiezhang-zhangfa", 1);
  dp = victim->query_skill("unarmed", 1);
  weap = victim->query_temp("weapon");
  lev = me->query_skill("tiezhang-zhangfa", 1);
  damage2 = (int)me->query_skill("tiezhang-zhangfa", 1);

  if (damage_bonus < 100) return 0;
  if (me->query_skill("guiyuan-tunafa", 1) < 100) return 0;
  if (me->query("jiali") < 1 || me->query("neili") < 100 || me->query_skill_mapped("force") != "guiyuan-tunafa") return 0;
  if (damage2 < 10) damage2 = 10;
  if (random(ap) > dp / 10 && me->query("jiali") > 0 && me->query_skill_mapped("force") == "guiyuan-tunafa") {
    if (random(lev) > 300 && random(7) == 2) {
      victim->receive_damage("qi", damage2 + damage_bonus / 2, me);
      victim->receive_wound("qi", damage2 + damage_bonus / 2, me);
      return HIW "碰! " + victim->name() + "被掌风扫中！口角上吐出血丝....\n" NOR;
    }
    if ((me->query("neili") > 1000)
      && (victim->query_temp("weapon"))
      && (random(lev) > 300)
      && (random(me->query_str(1)) > victim->query_str(1) / 2)) {
      //              if (random((int)weap->query("rigidity"))<3 && random(3)==0)	//这个代码不知道啥意思
      if (random(3) == 0) {
        message_vision(
          HIW "$N运掌如刀，连击三十六下，只听见「当」" NOR "地一声，$n手中的" + weap->name() + "被刀气震落到地上！\n" NOR,
          me,
          victim
        );
        weap->move(environment(me));
        victim->reset_action();
        me->add("neili", -200);
      } else if (random(5) == 1) {
        message_vision(HIW "$N运掌如刀，连击三十六下。可是$n稳如泰山，纹丝不动！$N被自己掌力反震的吐了一口血！\n" NOR, me, victim);
        me->add("neili", -(me->query("jiali") + 100));
        me->receive_wound("qi", damage2 + damage_bonus / 2, victim);
        me->receive_damage("qi", damage2 + damage_bonus / 2, victim);
      }
      return 1;
    }

  }


}
