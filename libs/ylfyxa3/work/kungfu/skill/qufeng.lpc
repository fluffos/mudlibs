// qufeng.c 驱蜂之术
// By Lgg,1998.9
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit SKILL;

void create() { seteuid(getuid()); }

string type() { return "knowledge"; }

int valid_learn(object me) {
  //		if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if ((int)me->query_skill("yunv-xinjing", 1) < 100 && (int)me->query_skill("yunv-xinfa", 1) < 100)
    return notify_fail("你的玉女心法火候不够，无法学驱蜂之术。\n");
  if (me->query("family/family_name") != "古墓派")
    return notify_fail("你不是古墓中人，无法学习驱蜂。\n");
  if ((int)me->query("max_neili") < 10000)
    return notify_fail("你的内力太弱，无法学习驱蜂之术。\n");
  if (((int)me->query_skill(
    "qufeng",
    1
  )) * (int)me->query_skill(
    "qufeng",
    1
  ) * (int)me->query_skill("qufeng", 1) >= (int)me->query("combat_exp", 1))
    return notify_fail("你的实战经验不足，无法学习驱蜂之术。\n");
  if ((int)me->query("score", 1) < 5000)
    return notify_fail("你对我派毫无贡献而言，怎么可能传授你武功呢。\n");
  if (random(100) == 1) me->add("score", -5);
  return 1;
}
int practice_skill(object me) {
  return notify_fail("驱蜂之术只能靠学习来提高。\n");
}
