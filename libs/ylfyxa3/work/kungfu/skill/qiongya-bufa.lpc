#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit SKILL;

string *dodge_msg = ({
  "但是$n身形一晃，从$N身边轻轻滑过。\n",
  "只见$n往后一退，隐入一团白雾中，$N这一招顿时没了目标。\n",
  "$n一转身，一团白雾冒起，隔断了$N的攻势。\n",
  "$n左脚轻轻在地上一点，缓缓升上半空，避开了$N的攻势。\n",
  "$n连续几个转身。眼前白光一闪，$n已出现在$N身后。\n",
});

int valid_enable(string usage) { return (usage == "dodge"); }

string query_dodge_msg(string limb) {
  return dodge_msg[random(sizeof(dodge_msg))];
}
int valid_learn(object me) {
  //		if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  //        if (me->query("gender") != "女性")
  //               return notify_fail("这种步法需要纯阴之质才能习练!\n");
  if (me->query("family/family_name") != "白云庵" && me->query("family/family_name") != "南海派")
    return notify_fail("你不是南海传人，无法学习本门技能。\n");
  if ((int)me->query_skill("bitao-shengong", 1) < 100)
    return notify_fail("你的碧涛神功火候不够，无法学习琼崖步法。\n");

  return 1;
}
int practice_skill(object me) {
  //		if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  //        if (me->query("gender") != "女性")
  //               return notify_fail("这种步法需要纯阴之质才能习练!\n");
  if (me->query("family/family_name") != "白云庵" && me->query("family/family_name") != "南海派")
    return notify_fail("你不是南海传人，无法练习本门技能。\n");
  if ((int)me->query("qi") < 30
    || (int)me->query("neili") < 30)
    return notify_fail("你的气或内力不够，不能练琼崖身法。\n");

  me->receive_damage("qi", 30);
  me->add("neili", -10);
  return 1;
}

string perform_action_file(string action) {
  return __DIR__ "qiongya-bufa/" + action;
}
//2017.3.25阿飞封掉ob_hit特效，怀疑与伤害为0的死亡有关
int ob_hit(object ob, object me, int damage) {
  int j, skill, neili, neili1, ap, dp;

  skill = me->query_skill("qiongya-bufa", 1);
  neili = me->query("neili");
  neili1 = ob->query("neili");
  ap = me->query_skill("qiongya-bufa", 1);
  dp = ob->query_skill("dodge", 1);
  if (damage < 10) damage = 10;
  if (random(ap) > dp / 10
    && me->query_skill("bitao-shengong", 1) > 100
    && me->query_skill("qiongya-bufa", 1) > 200
    && me->query_skill_mapped("force") == "bitao-shengong"
    && me->query("neili") > 10000
    && random(5) == 0) {
    if (neili >= random(neili1) + damage) {
      message_vision(HIC "\n$N不见有任何动作，只是身子一晃一转，$n就发现与$N的距离似天涯海角般远，结果$n的力道被躲过了一大半！\n" NOR, me, ob);
      j = -(damage * 2 + random(damage * 2));
      me->add("neili", -100);
    } else {
      message_vision(HIB "\n$n只觉眼前一花，不见了对手的身影！再看对方已与你相距天涯海角！结果$N只躲过了$n的一小半力道！\n" NOR, me, ob);
      j = -(damage + random(damage));
      me->add("neili", -100);
    }

    return j;
  }
}
