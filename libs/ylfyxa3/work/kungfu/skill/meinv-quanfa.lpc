int valid_enable(string usage) { return usage == "unarmed" || usage == "parry"; }

int valid_learn(object me) {
  //		if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("空手方能练习美女拳法。\n");
  if (me->query("gender") != "女性")
    return notify_fail("你不是美女，无法体会美女拳法的精要。\n");
  if (me->query("family/family_name") != "古墓派")
    return notify_fail("你不是古墓中人，无法学习本门技能。\n");
  if ((int)me->query_skill("yunv-xinjing", 1) < 100 && (int)me->query_skill("yunv-xinfa", 1) < 100)
    return notify_fail("玉女心经领悟不够，无法修习美女拳法。\n");
  if ((int)me->query_skill("dodge", 1) < 200)
    return notify_fail("你的轻功太差，无法练美女拳法。\n");
  if ((int)me->query("per", 1) < 25)
    return notify_fail("美女拳法，顾名思义是美女才能练的。\n");
  return 1;
}

string query_skill_name(int level) {
  int i;
  for (i = sizeof(action) - 1; i >= 0; i--)
    if (level >= action[i]["lvl"])
      return action[i]["skill_name"];
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];  //2017.9.4阿飞改，将招式简单点
}

int practice_skill(object me) {
  //		if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if ((int)me->query("qi") < 30)
    return notify_fail("你的体力太低了。\n");
  if ((int)me->query("neili") < 20)
    return notify_fail("你的内力不够练美女拳法了。\n");
  if (me->query("family/family_name") != "古墓派")
    return notify_fail("你不是古墓中人，无法练习本门技能。\n");
  if (me->query("gender") != "女性")
    return notify_fail("你又不是美女，怎么可能练的了美女拳法？\n");
  me->receive_damage("qi", 25);
  me->add("neili", -5);
  return 1;
}

mixed hit_ob(object me, object victim, int damage_bonus) {
  string msg;
  int ap, dp, damage2;
  ap = (int)me->query_skill("meinv-quanfa", 1);
  damage2 = (int)me->query_skill("meinv-quanfa", 1);
  dp = victim->query_skill("dodge", 1);
  if (damage_bonus < 100) return 0;
  if (me->query_skill("yunv-xinfa", 1) < 100 && me->query_skill("yunv-xinjing", 1) < 100) return 0;
  if (me->query("jiali") < 1 || me->query("neili") < 100 || (me->query_skill_mapped("force") != "yunv-xinfa" && me->query_skill_mapped("force") == "yunv-xinjing")) return 0;
  if (damage2 < 10) damage2 = 10;

  if (me->query("per", 1) > 24 && random(10) > 7 && random(ap) > dp / 10) {
    msg = HIY "\n$N悄退数步，右手支颐，左手轻轻挥出，长叹一声，脸现寂寥之意。\n" NOR;
    if (random(me->query("per", 1)) > random(victim->query("per", 1)) / 2) {
      me->add("neili", -100);
      //           if (!victim->is_busy()) victim->start_busy(random(4));
      victim->receive_wound("qi", damage2 + damage_bonus / 2, me);
      victim->receive_damage("qi", damage2 + damage_bonus / 2, me);
      msg += CYN "\n$n受$N的感染，呆在原处，两眼发直，一动不动，不知觉的吐了一口鲜血。\n\n" NOR;
    } else {
      me->add("neili", -100);
      //           if (!me->is_busy()) me->start_busy(random(2));
      msg += CYN "\n结果$n对$N的表情无动于衷。\n\n" NOR;
    }
    message_vision(msg, me, victim);
    return;
  }
}
string perform_action_file(string action) {
  return __DIR__ "meinv-quanfa/" + action;
}
