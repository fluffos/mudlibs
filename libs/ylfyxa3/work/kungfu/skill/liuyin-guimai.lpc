string query_skill_name(int level) {
  int i;
  for (i = sizeof(action); i > 0; i--)
    if (level >= action[i - 1]["lvl"])
      return action[i - 1]["skill_name"];
}

int practice_skill(object me) {
  return notify_fail("六阴鬼脉只能通过研究来提高熟练度。\n");
}

mixed hit_ob(object me, object victim, int damage_bonus, int factor) {
  int i, attack_time;
  int damage2, ap, dp;
  damage2 = (int)me->query_skill("liuyin-guimai", 1);
  ap = me->query_dex(1);
  dp = victim->query_dex(1);
  if (damage_bonus < 100) return 0;
  if (me->query_skill(
    "kumu-shengong",
    1
  ) < 100 || me->query_skill("beiming-shengong", 1) < 100) return 0;
  if (me->query("jiali") < 1 || me->query("neili") < 100 || (me->query_skill_mapped("force") != "kumu-shengong" && me->query_skill_mapped("force") != "beiming-shengong")) return 0;
  if (damage2 < 10) damage2 = 10;

  if (userp(me))
    attack_time = (int)(me->query_skill("liuyin-guimai", 1) / 100);
  else
    attack_time = (int)(me->query_skill("liuyin-guimai", 1) / 100);

  // 放宽NPC的攻击力度
  if (userp(me) && attack_time > 6)
    attack_time = 6;

  if (!me->is_busy()
    && living(victim)
    && damage_bonus > 120
    && me->query("neili") > 400
    && me->query_skill("liuyin-guimai", 1) >= 280
    && me->query("jiali") > 0) {
    if (userp(me) && random(6) != 1)
      return 0;

    // 避免在使用Pfm时讯息重复
    if (userp(me) && !me->query_temp("liuyin-guimai/hit_msg"))
      message_vision(HIW "\n霎时间$N" HIW "只觉思绪狂涌，六阴鬼脉之神力蓄势待发，登"
        "时十指纷弹，此去彼来，连绵无尽。\n" NOR, me, victim);

    if (!me->is_busy()) me->start_busy(1);

    me->add("neili", -attack_time * 100);

    for (i = 0; i < attack_time; i++) {
      if (!me->is_fighting(victim))
        break;
      COMBAT_D->do_attack(me, victim, 0, 0);
    }
  }

  if (random(ap) > dp / 10
    && damage_bonus > 150
    && me->query("neili") > 200
    && me->query_skill("liuyin-guimai", 1) >= 280
    && me->query("jiali") > 0
    && random(6) == 0) {
    me->add("neili", -(me->query("jiali") + 100));

    if (me->query("special_skill/guimai"))
      victim->receive_wound("qi", damage2 + damage_bonus / 2, me);

    else
      victim->receive_wound("qi", damage2 / 2 + damage_bonus / 2, me);

    return random(2) ? HIR "你听到「嗤啦」一声轻响，脸上竟飞溅到了一些血滴"
      "！\n" NOR :

      HIR "你只听「噗嗤」一声轻响，一股血柱至$n" HIR "身上"
      "溅出！\n" NOR;
  }
  return 1;
}

mapping query_action(object me, object weapon) {
  if (!undefinedp(me->query_temp("six-action")))
    return action[me->query_temp("six-action")];

  if (random(20) == 1 && me->query("neili") > 1000) {
    me->add("neili", -300);
    return ([ "action": "$N纵身前扑，双手拇指同时按出一记「" HIR "六阴鬼脉·少商剑" NOR
      "」，两道无形剑气破空而出逼向$n",
      "attack": 1000,
      "parry": 1000,
      "dodge": 1000,
      "damage": 1000,
      "force": 1000,
      "weapon": HIR "六阴鬼脉·无形剑气" NOR,
      "damage_type": "刺伤"
    ]);
  } else if (random(20) == 2 && me->query("neili") > 1000) {
    me->add("neili", -300);
    return ([ "action": "$N双手手指急速弹动，顿时「" HIR "六阴鬼脉·商阳剑" NOR "」和「"
      HIR "六阴鬼脉·中冲剑" NOR "」两路剑法齐施，剑气源源不断涌向$n",
      "attack": 1000,
      "parry": 1000,
      "dodge": 1000,
      "damage": 1000,
      "force": 1000,
      "weapon": HIR "六阴鬼脉·无形剑气" NOR,
      "damage_type": "刺伤"
    ]);
  } else if (random(20) == 3 && me->query("neili") > 1000) {
    me->add("neili", -300);
    return ([ "action": "$N内息急转，不断催动真气，「" HIR "六阴鬼脉" NOR "」"
      "奥妙无方，剑气破空之声骤响，尽数袭向$n",
      "attack": 1000,
      "parry": 1000,
      "dodge": 1000,
      "damage": 1000,
      "force": 1000,
      "weapon": HIR "六阴鬼脉·无形剑气" NOR,
      "damage_type": "刺伤"
    ]);
  }
  if (me->query("special_skill/guimai"))
    return action[random(sizeof(action))];
  else
    return action2[random(sizeof(action))];
}

string query_parry_msg(object victim_weapon) {
  switch (random(4)) {
    case 0:
      return "$n随意挥洒，道道六阴鬼脉剑气纵横交错，宛若天网，$N唯有望洋兴叹，徒呼奈何。\n";
    case 1:
      return "$n不闪不避，一招六阴鬼脉·中冲剑直袭$N的胸前大穴，迫得$N只有回身自救。\n";
    case 2:
      return "$n六剑连出，六阴鬼脉剑气回荡，直割得$N眉毛削落，脸面生通，再也不能前进半分！\n";
    default:
      return "$n一声长笑，六阴鬼脉·无形剑气四处散开，将$N层层裹住，惟有勉强支撑。才约略摆脱了$n的反击。\n";
  }
}

int difficult_level() {
  return 8000;
}

string perform_action_file(string action) {
  return __DIR__ "liuyin-guimai/" + action;
}
