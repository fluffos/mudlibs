//menpai skill
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit SKILL;

mapping *action = ({
  ([ "action": "$N浅浅一笑，一招「自在飞花轻似梦」若有若无地拍向$n的$l",
    "attack": 100,
    "parry": 100,
    "dodge": 100,
    "damage": 100,
    "force": 100,
    "damage_type": "瘀伤",
  ]),
  ([ "action": "$N身形一顿，似有退意。$n正待反攻，\n忽见$N纤纤五指，直拂$n双目。正是“百花掌”之杀手「一枝红杏出墙来」",
    "attack": 100,
    "parry": 100,
    "dodge": 100,
    "damage": 100,
    "force": 100,
    "damage_type": "刺伤",
    "weapon": "右手掌",
  ]),
  ([ "action": "只见$N嫣然一笑，双掌翻飞，一招「人面桃花相映红」当真是妙到毫巅",
    "attack": 200,
    "parry": 200,
    "dodge": 200,
    "damage": 200,
    "force": 200,
    "damage_type": "瘀伤",
  ]),
  ([ "action": "$N纤腰一摆，陡然滑出数尺，右手顺势一招「黄菊枝头生晓寒」往$n的$l拍去",
    "attack": 200,
    "parry": 200,
    "dodge": 200,
    "damage": 200,
    "force": 200,
    "damage_type": "瘀伤",
  ]),
  ([ "action": "只见$N双唇紧闭，面色凝重，一招「此花开尽更无花」全力击向$n的$l",
    "attack": 300,
    "parry": 300,
    "dodge": 300,
    "damage": 300,
    "force": 300,
    "damage_type": "瘀伤",
  ]),
});

int valid_learn(object me) {
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");
  if (me->query("family/family_name") != "白云庵" && me->query("family/family_name") != "南海派")
    return notify_fail("你不是本门中人，无法领悟本门技能的精髓。\n");
  //	if( (string)me->query("gender") != "女性" )
  //		return notify_fail("百花掌是只有女子才能练的武功。\n");
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练百花掌必须空手。\n");
  if ((int)me->query_skill("bitao-shengong", 1) < 100)
    return notify_fail("你的碧涛神功火候不够，无法学习百花掌。\n");

  return 1;
}

int valid_enable(string usage) {
  return usage == "unarmed" || usage == "parry" || usage == "strike";
}

mapping query_action(object me, object target, object weapon) {
  if (random(me->query_skill(
    "baihua-zhang",
    1
  )) > 300 && me->query("neili") > 200 && random(5) == 0) {
    me->add("neili", -150);
    return ([
      "action": "" HIB "忽然$N使出「百花齐放」，瞬息之间无数拳影向$n击来。\n"
      "$n" HIG "只看见眼前很多花朵绽放，顿时明白了花儿为什么那样红。\n" NOR "",
      "attack": 300,
      "parry": 300,
      "dodge": 300,
      "damage": 300,
      "force": 300,
      "damage_type": "内伤" ]);

  }

  return action[random(sizeof(action))];
}
/*
mapping query_action(object me, object weapon)
{
        return action[random(sizeof(action))];
}
*/
int practice_skill(object me) {
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");
  if (me->query("family/family_name") != "白云庵" && me->query("family/family_name") != "南海派")
    return notify_fail("你不是本门中人，如何学到本门高深技能，我要告诉掌门去。\n");
  if ((int)me->query_skill("bitao-shengong", 1) < 100)
    return notify_fail("你的碧涛神功火候不够，无法练习百花掌。\n");
  if ((int)me->query("jing") < 30)
    return notify_fail("你的精神无法集中了，休息一下再练吧。\n");
  if ((int)me->query("qi") < 30)
    return notify_fail("你现在手足酸软，休息一下再练吧。\n");
  if ((int)me->query("neili") < 40)
    return notify_fail("你的内力不够了。\n");
  //	if( (string)me->query("gender") != "女性" )
  //		return notify_fail("百花掌是只有女子才能练的武功。\n");
  me->receive_damage("qi", 30);
  me->add("neili", -10);

  return 1;
}

string perform_action_file(string action) {
  return __DIR__ "baihua-zhang/" + action;
}

mixed hit_ob(object me, object victim, int damage_bonus) {
  int ap, dp, damage2;
  ap = me->query("int", 1) * me->query_skill("baihua-zhang", 1);
  dp = victim->query("int", 1) * victim->query_skill("parry", 1);
  damage2 = (int)me->query_skill("baihua-zhang", 1);
  if (damage_bonus < 100) return 0;
  if (me->query_skill("bitao-shengong", 1) < 100) return 0;
  if (me->query("jiali") < 1 || me->query("neili") < 100 || me->query_skill_mapped("force") != "bitao-shengong") return 0;
  if (damage2 < 10) damage2 = 10;
  if (random(ap) > dp / 10 && random(6) == 0 && me->query("jiali") > 0) {
    victim->receive_wound("qi", damage2 + damage_bonus, me);
    victim->receive_damage("qi", damage2 + damage_bonus, me);
    //		if (!victim->is_busy()) victim->start_busy(3);
    me->add("neili", -100);
    return HIR "$n突然看到一朵娇艳的玫瑰开放，顿时心花怒放的想要去摘！" HIM "然玫瑰虽好，但越好看的花越伤人！\n" NOR;
  }
}
