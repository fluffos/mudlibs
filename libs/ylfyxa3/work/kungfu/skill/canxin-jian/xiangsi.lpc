//xiangxi.c  相思情剑

#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
#include <condition.h>
inherit F_SSERVER;

int perform(object me, object target) {
  int times, i, level;
  object weapon;

  if (!target) target = offensive_target(me);
  if (!target || !target->is_character() || target->is_corpse() || target == me)
    return notify_fail("「相思情剑」只能在战斗中使用！\n");
  if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "sword")
    return notify_fail("「相思情剑」用剑才能使出！\n");
  if (target && target->query_temp("apply/shade_vision"))
    return notify_fail("对方隐身了，你看不到" + target->query("name") + "。\n");
  if (me->query("shushan/xiangsi_perform") != 1)
    return notify_fail("没有伤心的体会，用不了缠绵的「相思情剑」！\n");
  if (me->query_skill_mapped("force") != "shushan-force")
    return notify_fail("「相思情剑」必须以蜀山心法做底子！\n");
  if (me->query_skill_mapped("sword") != "canxin-jian")
    return notify_fail("你没有正确激发该技能！\n");
  if (me->query_skill_mapped("force") != "shushan-force")
    return notify_fail("你不使用本门内功，如何能使用本门绝技！\n");
  if ((int)me->query("max_neili") < 200000)
    return notify_fail("你的内力修为不够！\n");
  if ((int)me->query("max_jingli") < 200000)
    return notify_fail("你的精力修为不够！\n");
  if ((int)me->query("neili") < me->query_skill("canxin-jian", 1) * 4)
    return notify_fail("你的内力不足！\n");
  if ((int)me->query("jingli") < me->query_skill("canxin-jian", 1) * 2)
    return notify_fail("你的精神不足，没法子施用外功！\n");
  if ((int)me->query_skill("shushan-force", 1) < 500)
    return notify_fail("你的蜀山心法修为还不够，使用这一招会有困难！\n");
  if ((int)me->query_skill("canxin-jian", 1) < 1000)
    return notify_fail("你的残心剑修为还不够，使用这一招会有困难！\n");
  if (me->is_busy())
    return notify_fail("你现在正忙着呢！\n");
  if (me->query_temp("autolian"))
    return notify_fail("你正在发动自动连招！\n");
  if (me->query_temp("cooldown"))  //CD写法	2017.9.7添加
    return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");

  times = me->query_skill("canxin-jian", 1) / 600;
  level = me->query_skill("canxin-jian", 1);
  message_vision(MAG "$N集思凝神，猛地施出残心剑的绝招「相思情剑」，向$n连续发动进攻！\n\n" NOR, me, target);
  me->set_temp("cooldown", 1);  //CD写法	2017.9.7添加
  call_out("del_cooldown", 3, me);  //CD写法1	
  me->add_temp("apply/damage", -level);
  me->add_temp("apply/attack", -level);
  me->add_temp("apply/strength", -level);
  if (times < 1) times = 1;
  if (me->query("jm/shushan")) {
    if (times > 100) times = 100;
  } else {
    if (times > 50) times = 50;
  }

  //	me->add_temp("lianzhao", times);	 //2016.6.1阿飞改，增加连招标记，用于削弱连招伤害	
  for (i = 0; i < times; i++) {
    switch (random(4)) {
      case 0:
        message_vision(HIG "$n被剑意中的相思之苦感染，身中情毒！\n" NOR, me, target);
        target->apply_condition("xiangsi", 20);
        break;
      case 1:
        message_vision(HIG "一股酒气冲向$n，$n似乎有了点酒意！\n" NOR, me, target);
        target->apply_condition("drunk", 20);
        break;
      case 2:
        message_vision(HIG "梦无痕，随风逝，仙灵如月长伴君．\n" NOR, me, target);
        target->apply_condition("xiang_air", 20);
        break;
      case 3:
        message_vision(HIG "问世间情为何物？\n" NOR, me, target);
        target->apply_condition("qinghua_poison", 20);
        break;
    }
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
  }
  message_vision(HIG "$N的「相思情剑」用功完毕，气回丹田,缓缓收功.\n" NOR, me, target);
  me->add_temp("apply/damage", level);
  me->add_temp("apply/attack", level);
  me->add_temp("apply/strength", level);
  //	me->delete_temp("lianzhao");  //2016.6.1阿飞改，连招结束取消连招标记	
  me->add("neili", -100 * times);
  me->add("jingli", -level);

  me->start_busy(1);
  return 1;
}

void del_cooldown(object me)  //CD写法1
{
  if (!objectp(me)) return;
  if (me->query_temp("cooldown")) {
    me->delete_temp("cooldown");
    tell_object(me, HIM "你呼出一口气，缓缓的将内力收回丹田。\n" NOR);
  }
}
