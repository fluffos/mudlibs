int valid_enable(string usage) { return usage == "sword" || usage == "parry"; }

int valid_learn(object me) {
  //		if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");		
  if ((int)me->query("max_neili") < 10000)
    return notify_fail("你的内力不够。\n");
  if (me->query("family/family_name") != "血河派")
    return notify_fail("你不是血河派弟子，无法学习。\n");
  if ((int)me->query_skill(
    "huaxue-dafa",
    1
  ) < 100 && (int)me->query_skill(
    "yiriguan-riyue",
    1
  ) < 100 && (int)me->query_skill("longmen-shengong", 1) < 100)
    return notify_fail("你的本门气功火候不够，无法学习天河剑法。\n");
  if ((int)me->query_skill("sword", 1) < 300)
    return notify_fail("你的剑法火候太浅。\n");
  if ((int)me->query("score", 1) < 5000)
    return notify_fail("你对我派毫无贡献而言，怎么可能传授你武功呢。\n");
  if (random(100) == 1) me->add("score", -5);
  return 1;
}

string query_skill_name(int level) {
  int i;
  for (i = sizeof(action) - 1; i >= 0; i--)
    if (level >= action[i]["lvl"])
      return action[i]["skill_name"];
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];  //2017.9.4阿飞改，将招式简单点
}

int practice_skill(object me) {
  object weapon;
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");		
  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "sword")
    return notify_fail("你使用的武器不对。\n");
  if (me->query("family/family_name") != "血河派")
    return notify_fail("你不加入血河派，练习不了。\n");
  if ((int)me->query("qi") < 50)
    return notify_fail("你的体力不够练“天河剑法”。\n");
  me->receive_damage("qi", 30);
  return 1;
}

string perform_action_file(string action) {
  return __DIR__ "tianhe-jian/" + action;
}

mixed hit_ob(object me, object victim, int damage_bonus) {
  string msg;
  int ap, dp, flag, damage2;
  flag = 1;
  ap = me->query_skill("tianhe-jian", 1);
  dp = victim->query_skill("sword", 1);
  damage2 = (int)me->query_skill("tianhe-jian", 1);
  if (damage_bonus < 100) return 0;
  if (me->query_skill(
    "huaxue-dafa",
    1
  ) < 200 && me->query_skill(
    "yiqiguan-riyue",
    1
  ) < 200 && me->query_skill("longmen-shengong", 1) < 100) return 0;
  if (me->query_skill_mapped("force") != "huaxue-dafa" && me->query_skill_mapped("force") != "yiqiguan-riyue" && me->query_skill_mapped("force") != "longmen-shengong") return 0;
  if (me->query("jiali") < 1 || me->query("neili") < 100) return 0;
  if (damage2 < 10) damage2 = 10;
  if (me->query_skill_mapped("force") == "longmen-shengong") flag = 2;
  if (me->query_skill_mapped("force") == "huaxue-dafa") flag = 1;
  if (me->query_skill_mapped("force") == "yiqiguan-riyue") flag = 3;
  if (random(ap) > dp / 10 && me->query_skill(
    "tianhe-jian",
    1
  ) > 300 && random(6) == 2 && me->query("jiali") > 0) {
    if (me->query("yiqiguan-riyue") == 1) {
      victim->receive_wound("qi", (damage2 * flag * 2) / 3 + damage_bonus / 3, me);
      victim->receive_damage("qi", (damage2 * flag * 2) / 3 + damage_bonus / 3, me);
      me->add("neili", -100);
      msg = WHT "$n一个不防，被天河剑气中夹杂的「从心所欲」内劲所伤。\n" NOR;
    }
    if (me->query("yiqiguan-riyue") == 2) {
      victim->receive_wound("qi", damage2 * flag + damage_bonus / 2, me);
      victim->receive_damage("qi", damage2 * flag + damage_bonus / 2, me);
      me->add("neili", -100);
      msg = CYN "$n一个不防，被天河剑气中夹杂的「登峰造极」内劲所伤。\n" NOR;
    }
    return msg;
  }
}
