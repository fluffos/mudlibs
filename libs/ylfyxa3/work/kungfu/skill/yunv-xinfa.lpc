// yunv-xinfa.c 玉女心法
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit FORCE;

int valid_enable(string usage) {
  return usage == "force";
}

int valid_learn(object me) {
  mapping skl;
  string *sname;
  int i;
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if (me->query("gender") == "无性")
    return notify_fail("你无根无性，阴阳难调，不能修习玉女心法。\n");
  if ((int)me->query_skill("force", 1) < 100)
    return notify_fail("你的基本内功火候还不够。\n");
  if (me->query("family/family_name") != "古墓派")
    return notify_fail("你不是古墓派弟子，无法学习玉女心法。\n");
  if ((int)me->query_skill("force", 1) <= (int)me->query_skill("yunv-xinfa", 1))
    return notify_fail("你的基本内功基础不够，再学下去会走火入魔的。\n");

  if (!me->query("jm/quanzhen"))
    return notify_fail(CYN "我古墓派祖师与全真教重阳真人恩怨纠葛，可惜最终未能修成正果。我古墓弟子都得先去全真门下修行一段时间方可入门。\n" NOR);
  if ((int)me->query("family_score") < 6)
    return notify_fail(CYN "这位" + RANK_D->query_respect(me) + CYN "对江湖不够了解啊，我派功夫恐怕不能传授于你。\n" NOR);


  skl = this_player()->query_skills();
  sname = keys(skl);
  for (i = 0; i < sizeof(skl); i++) {
    if (sname[i] == "yijing-force") continue;
    if (sname[i] == "yunv-xinfa") continue;
    if (sname[i] == "yunv-xinjing") continue;
    if (sname[i] == "xixing-dafa") continue;
    if (SKILL_D(sname[i])->valid_enable("force"))
      return notify_fail("你不先散了别派内功，怎能学玉女心经？！\n");
  }
  return 1;
}

int practice_skill(object me) {
  return notify_fail("玉女心法只能用学(learn)来增加熟练度。\n");
}

string exert_function_file(string func) {
  return __DIR__ "yunv-xinfa/" + func;
}

mixed hit_ob(object me, object victim, int damage_bonus, int factor) {
  int ap, dp, damage2;
  damage2 = (int)me->query_skill("yunv-xinfa", 1);
  ap = me->query_skill("yunv-xinfa", 1);
  dp = victim->query_skill("force", 1);
  if (damage_bonus < 100) return 0;
  if (me->query_skill("yunv-xinfa", 1) < 100) return 0;
  if (me->query("jiali") < 1 || me->query("neili") < 100 || me->query_skill_mapped("force") != "yunv-xinfa") return 0;
  if (damage2 < 10) damage2 = 10;

  if (random(ap) > dp / 20 && random(6) == 0 && me->query("jiali") > 0) {
    victim->receive_wound("qi", 100 + damage2 + damage_bonus / 2, me);
    me->add("neili", -100);
    return HIB "$N发挥出" + HIR + "玉女心法" NOR HIB "的精髓，摧毁了$n的真元！！！！\n" NOR;
  }
}

mapping exercise_msg(object me) {
  return ([
    "status_msg": "姿态悠雅，神态清冷。\n",
    "start_my_msg": "轻轻的吸一口气，闭上眼睛，运起玉女心法，内息在脉络中开始运转。\n",
    "start_other_msg": me->name() + "神态突然开始变的清冷无比，可是姿势又变的悠雅异常。\n",
    "heal_my_msg": "轻轻的吸一口气，闭上眼睛，运起玉女心法，内息运转于脉络之中，开始调理内伤。\n",
    "heal_other_msg": me->name() + "神态突然开始变的清冷无比，可是姿势又显得悠雅异常，犹似一朵白莲花盛开。\n",
    "halt_msg": "内息一转，迅速收气，停止了内息的运转。\n",
    "end_my_msg": "慢慢收气，归入丹田，睁开眼睛，轻轻的吐了一口气。\n",
    "end_other_msg": "只见" + me->name() + "睁开眼睛，轻轻的吐出了一口气，神态恢复自然。\n",
    "hover_my_msg": "将玉女心法运转完毕，收功站起，身轻如燕。\n",
    "hover_other_msg": me->name() + "指拈如意，轻轻地吐了口气，收功站起，姿态优雅。\n",
  ]);
}
