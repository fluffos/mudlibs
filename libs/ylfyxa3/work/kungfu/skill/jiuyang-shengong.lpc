// jiuyang-shengong.c	九阳神功 	上乘武学400~1000

#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
#include <condition.h>
inherit FORCE;

mapping *action = ({
  ([ "action": "$N攻势忽缓而不疏，$w变化无常，捉摸不定向$n慢慢卷去",
    "attack": 400,
    "parry": 400,
    "dodge": 400,
    "damage": 400,
    "force": 400,
    "damage_type": "内伤"
  ]),
  ([ "action": "$N手中的$w突焕气象森严，便似千军万马奔驰而来，$w幻作一道红芒贯向$n",
    "attack": 500,
    "parry": 500,
    "dodge": 500,
    "damage": 500,
    "force": 500,
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N卷起手中的$w，霎时剑芒暴涨，宛如骄阳烈火直射向$n而去",
    "attack": 600,
    "parry": 600,
    "dodge": 600,
    "damage": 600,
    "force": 600,
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N使出一招「" CYN "三" HIC "重天地混元" NOR "」，左手聚出一团混元真气击向$n",
    "attack": 700,
    "parry": 700,
    "dodge": 700,
    "damage": 700,
    "force": 700,
    "damage_type": "内伤"
  ]),
  ([ "action": "$N使出一招「" YEL "五" HIC "重天地混元" NOR "」，右手聚出一团混元真气击向$n",
    "attack": 800,
    "parry": 800,
    "dodge": 800,
    "damage": 800,
    "force": 800,
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N使出一招「" HIR "七" HIC "重天地混元" NOR "」，双手由掌变拳，聚出一团混元真气击向$n",
    "attack": 900,
    "parry": 900,
    "dodge": 900,
    "damage": 900,
    "force": 900,
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N使出一招「" HIW "风" HIB "雷" HIY "震" HIC "九州" NOR "」，全身腾空而起，化作一团混元真气击向$n",
    "attack": 1000,
    "parry": 1000,
    "dodge": 1000,
    "damage": 1000,
    "force": 1000,
    "damage_type": "瘀伤"
  ]),
});

mixed hit_ob(object me, object victim, int damage_bonus, int factor)

{
  object ob = victim->query_temp("armor/finger");
  int ap, dp, damage2;
  damage2 = (int)me->query_skill("jiuyang-shengong", 1);
  ap = me->query("neili");
  dp = victim->query("neili");
  if (me->query("couple") || me->query("make_loves")) return 0;
  if (damage_bonus < 100) return 0;
  if (me->query_skill("jiuyang-shengong", 1) < 100) return 0;
  if (me->query("jiali") < 1 || me->query("neili") < 100 || me->query_skill_mapped("force") != "jiuyang-shengong") return 0;
  if (damage2 < 10) damage2 = 10;
  if (random(ap) > dp / 15 && random(6) == 0 && me->query_skill_mapped("force") == "jiuyang-shengong") {
    message_vision(HIR "$N哈哈大笑了几声，$n忽然感觉到$N一股刚猛的内力侵入体内！$n面色潮红吐出一口鲜血！\n" NOR, me, victim);
    if (objectp(ob)) {
      if (ob->query("id") == "tianmo ring") {
        damage2 = damage2 / 5;
        message_vision(HIR "$n的天魔戒削弱了$N九阳神功的伤害！！！！\n" NOR, me, victim);
      }
    }
    victim->apply_condition("no_perform", 10);
    victim->apply_condition("no_enforce", 10);
    victim->receive_wound("qi", damage2 * 2 + damage_bonus / 2, me);
    victim->receive_wound("jing", (int)me->query("jiali"), me);
    victim->add("neili", -(int)me->query("jiali"));
    me->add("neili", -100);
  }

}

int valid_enable(string usage) {
  return usage == "unarmed" || usage == "parry" || usage == "force";

}

int valid_learn(object me) {
  mapping skl;
  string *sname;
  int i;
  int lvl = (int)me->query_skill("jiuyang-shengong", 1);
  //		if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if (me->query("gender") == "无性")
    return notify_fail("你无根无性，阴阳不调，难以领会高深的九阳神功。\n");
  if (me->query("gender") != "男性")
    return notify_fail("九阳神功需要阳刚之气，不适合你学。\n");
  if (me->query("couple"))
    return notify_fail("你精气已散，不能领悟九阳神功的奥妙之处。\n");
  if (me->query("make_loves"))
    return notify_fail("你精气已泄，不能领悟九阳神功的奥妙之处。\n");
  if ((int)me->query_skill("force", 1) < 500)
    return notify_fail("你的基本内功火候还不够，无法领会九阳神功。\n");
  if (me->query_skill("force", 1) <= lvl)
    return notify_fail("你的基本内功基础不够，再学下去会走火入魔的。\n");
  if ((int)me->query("score", 1) < 10000)
    return notify_fail("你对我派毫无贡献而言，怎么可能传授你武功呢。\n");


  skl = me->query_skills();
  sname = keys(skl);
  for (i = 0; i < sizeof(skl); i++) {
    if (sname[i] == "yijing-force") continue;
    if (sname[i] == "jiuyang-shengong") continue;
    if (sname[i] == "xixing-dafa") continue;
    if (SKILL_D(sname[i])->valid_enable("force"))
      return notify_fail("你不先散了别派内功，怎能学九阳神功？！\n");
  }
  if (random(10) == 1) me->add("score", -10);
  return 1;
}

int practice_skill(object me) {
  return notify_fail("九阳神功只能用学的，或是从运用(exert)中增加熟练度。\n");
}

int effective_level() { return 21; }

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

string *parry_msg = ({

  "$n衣衫澎湃，内力汩汩，$N根本不可近身。\n",
  "$n长袖一甩，一股大力将$N送出丈外。\n",
  "$n施展出「九阳无我」，轻描淡写的化解了$N的攻势。\n",
});

string query_parry_msg(object me, object weapon) {
  return parry_msg[random(sizeof(parry_msg))];
}

string exert_function_file(string func) {
  return __DIR__ "jiuyang-shengong/" + func;
}

