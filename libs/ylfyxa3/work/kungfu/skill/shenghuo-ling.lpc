#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit SKILL;

mapping *action = ({
  ([ "action": "$N踏上一步，忽地在地上一坐，已抱住了$n小腿。十指扣住了$n小腿上的‘中都’‘筑宾’两穴，$n只觉下半身酸麻难动，大吃一惊",
    "attack": 400,
    "parry": 400,
    "dodge": 400,
    "damage": 400,
    "force": 400,
    "damage_type": "挫伤"
  ]),
  ([ "action": "突然之间，$N身形晃动，同时欺近，手中$w往$n身上划去。脚下不知如何移动，身形早变。右手同时抓住$n后领，一抖之下，将$n向外远远掷了出去",
    "attack": 400,
    "parry": 400,
    "dodge": 400,
    "damage": 400,
    "force": 400,
    "damage_type": "挫伤"
  ]),
  ([ "action": "$N欺身直进，左手持$w向$n天灵盖上拍落。便在这一瞬之间，$n滚身向左，已然一拳打在$n腿上。$n一个踉跄，$N横过$w戳向$n后心",
    "attack": 500,
    "parry": 500,
    "dodge": 500,
    "damage": 500,
    "force": 500,
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N忽地放手，手中那柄$w尾端向上弹起，拍的一响，正好打中$n手腕。",
    "attack": 600,
    "parry": 600,
    "dodge": 600,
    "damage": 600,
    "force": 600,
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N忽然低头，一个头锤向$n撞来，$n不动声色，向旁又是一让，突觉胸口一痛，已被$N手肘撞中",
    "attack": 700,
    "parry": 700,
    "dodge": 700,
    "damage": 700,
    "force": 700,
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N忽然低头，一个头锤向$n撞来，$n不动声色，向旁又是一让，突觉胸口$N手中$w急挥横扫，突然连翻三个空心筋斗。$n不知对方是何用意，心想还是避之为妙，刚向左踏开一步，眼前白光急闪，$N的$w已到右肩",
    "attack": 800,
    "parry": 800,
    "dodge": 800,
    "damage": 800,
    "force": 800,
    "damage_type": "挫伤"
  ]),
  ([ "action": "$N忽然低头，一个头锤向$n撞来，$n不动声色，向旁又是一让，突觉胸口一痛，已被$N手肘撞中",
    "attack": 900,
    "parry": 900,
    "dodge": 900,
    "damage": 900,
    "force": 900,
    "damage_type": "挫伤"
  ]),
  ([ "action": "$N眼中射出一道青芒，飞身而前，手中圣火令突然飞出，$n手忙脚乱，接连被圣火令击中数次",
    "attack": 1000,
    "parry": 1000,
    "dodge": 1000,
    "damage": 1000,
    "force": 1000,
    "damage_type": "内伤"
  ]),
});

int valid_enable(string usage) { return (usage == "sword") || (usage == "parry"); }

mapping query_action(object me, object weapon) {
  if (random(20) > 15
    && me->query_skill("shenghuo-ling", 1) > 500
    && me->query("neili") > 300
    && (string)weapon->query("id") == "shenghuo ling") {
    me->add("neili", -100);
    return ([
      "action": "$N眼中射出一道青芒，飞身而前，手中圣火令相互一击，铮的一响，$n心神一荡，身子从半空中直堕下来，但觉腰胁中一阵疼痛，已被$N踢中了一脚。砰的一下，$N的圣火令却又击中了$n的$l",
      "attack": 1000,
      "parry": 1000,
      "dodge": 1000,
      "damage": 1000,
      "force": 1000,
      "damage_type": "刺伤" ]);
  }
  return action[random(sizeof(action))];
}

int valid_learn(object me) {
  int lvl = (int)me->query_skill("qiankun-danuoyi", 1);
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if (me->query("gender") == "无性" && lvl > 49)
    return notify_fail("你先天不足，再学下去难免走火入魔。\n");
  if ((int)me->query("str", 1) < 30)
    return notify_fail("圣火令乃玄铁铸造，没有足够的臂力恐怕舞不起来？\n");
  if ((int)me->query("max_neili") < 100000)
    return notify_fail("就这么点内力还想学圣火令法？\n");
  if (me->query("family/family_name") != "明教")
    return notify_fail("你不是明教弟子，无法学习圣火令。\n");
  if (me->query_skill("shenghuo-shengong", 1) < 300)
    return notify_fail("你的圣火神功火候还不够，学不了圣火令法！\n");
  if ((int)me->query("score", 1) < 10000)
    return notify_fail("你对我派毫无贡献而言，怎么可能传授你武功呢。\n");
  if (random(10) == 1) me->add("score", -10);
  return 1;
}

int practice_skill(object me) {
  object weapon;
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "sword")
    return notify_fail("你使用的武器不对。\n");
  if (me->query("family/family_name") != "明教")
    return notify_fail("你不是明教弟子，无法练习圣火令。\n");
  if ((int)me->query("qi") < 50)
    return notify_fail("你的体力不够练圣火令法。\n");
  me->receive_damage("qi", 40);
  return 1;
}



string perform_action_file(string action) {
  return __DIR__ "shenghuo-ling/" + action;
}


mixed hit_ob(object me, object victim, int damage_bonus) {

  int ap, dp, level, damage2;
  level = (int)me->query_skill("shenghuo-ling", 1);
  ap = (int)me->query(
    "dex",
    1
  ) * (int)me->query_skill(
    "shenghuo-ling",
    1
  ) + me->query_skill("shenghuo-shengong", 1) + me->query_skill("jiuyang-shengong", 1);
  dp = (int)victim->query("con", 1) * (int)me->query_skill("parry", 1);
  damage2 = (int)me->query_skill("shenghuo-ling", 1);

  if (damage_bonus < 100) return 0;
  if (me->query_skill(
    "shenghuo-shengong",
    1
  ) < 100 && me->query_skill("jiuyang-shengong", 1) < 100) return 0;
  if (me->query("jiali") < 1 || me->query("neili") < 100) return 0;
  if (me->query_skill_mapped("force") != "shenghuo-shengong" && me->query_skill_mapped("force") != "jiuyang-shengong") return 0;
  if (damage2 < 10) damage2 = 10;

  if (random(5) == 0 && level > 100 && me->query("neili") > 500 && random(ap) > dp / 10 && me->query("jiali") > 0) {
    message_vision(HIY "$N掏出两把圣火令，相互交击，身形突然加快，向$n欺身而上。\n" NOR, me, victim);
    me->add("neili", -100);
    if (me->query_skill_mapped("force") == "jiuyang-shengong") {
      victim->receive_wound("qi", damage2 * 2 + damage_bonus / 2, me);
      victim->receive_damage("qi", damage2 * 2 + damage_bonus / 2, me);
      //			if (!victim->is_busy()) victim->start_busy(random(3));
    } else {
      victim->receive_wound("qi", damage2 + damage_bonus / 2, me);
      victim->receive_damage("qi", damage2 + damage_bonus / 2, me);
    }

    message_vision(CYN "$n发现这招无法招架，只好运起内功硬挨了这一剑！。\n" NOR, me, victim);
  }

  return;
}
