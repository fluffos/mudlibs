// chaos-steps.c
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit SKILL;

string *dodge_msg = ({
  "$n一招「天玑离枢」，身子掣忽一转，$N只觉的眼前一花，失去了目标。\n",
  "只见$n身影一晃，一式「天璇乱步」早已避在七尺之外。\n",
  "$n使出「倒转天权」，身体急转，化为一道白光，虚幻不定的出现在$N的周围。\n",
  "$n左足一点，一招「逐影天枢」腾空而起，避了开去。\n",
  "可是$n使一招「风动玉衡」，身子轻轻向上纵起，飘了开去。\n",
  "$n身影微动，已经藉一招「开阳薄雾」轻轻闪过。\n",
  "但是$n一招「瑶光音迟」使出，早已绕到$N身後！\n"
});

string *parry_msg = ({
  "$n一招「天玑离枢」，身子掣忽一转，$N只觉的眼前一花，失去了目标。\n",
  "只见$n身影一晃，一式「天璇乱步」早已避在七尺之外。\n",
  "$n使出「倒转天权」，身体急转，化为一道白光，虚幻不定的出现在$N的周围。\n",
  "$n左足一点，一招「逐影天枢」腾空而起，避了开去。\n",
  "可是$n使一招「风动玉衡」，身子轻轻向上纵起，飘了开去。\n",
  "$n身影微动，已经藉一招「开阳薄雾」轻轻闪过。\n",
  "但是$n一招「瑶光音迟」使出，早已绕到$N身後！\n"
});

int valid_enable(string usage) {
  return (usage == "parry") || (usage == "dodge");
}

int valid_learn(object me) {
  //		if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if ((int)me->query("max_neili") < 5000)
    return notify_fail("你的内力不够，没有办法练七星换位。\n");
  if (me->query("family/family_name") != "全真教")
    return notify_fail("你不是全真教弟子，无法传授本教技能。\n");
  if ((int)me->query_skill(
    "tiangang-zhengqi",
    1
  ) < 100 && (int)me->query_skill("xiantian-qigong", 1) < 100)
    return notify_fail("你的本门内功火候不够，无法学习。\n");

  return 1;
}

string query_dodge_msg(string limb) {
  return dodge_msg[random(sizeof(dodge_msg))];
}
string query_parry_msg(string limb) {
  return parry_msg[random(sizeof(parry_msg))];
}
int practice_skill(object me) {
  //		if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if ((int)me->query("qi") < 30
    || (int)me->query("neili") < 3)
    return notify_fail("你的气或内力不够，不能练七星换位。\n");
  if (me->query("family/family_name") != "全真教")
    return notify_fail("你不是全真教弟子，无法练习本教技能。\n");
  me->receive_damage("qi", 30);
  me->add("neili", -3);
  return 1;
}

string perform_action_file(string action) {
  return __DIR__ "qixing-huanwei/" + action;
}

//2017.3.25阿飞封掉ob_hit特效，怀疑与伤害为0的死亡有关
int ob_hit(object ob, object me, int damage) {

  int j, ap, dp;
  ap = me->query_skill("qixing-huanwei", 1) * me->query("dex", 1);
  dp = ob->query_skill("dodge", 1) * ob->query("int", 1);

  if (damage < 10) damage = 10;
  if (me->query_skill("qixing-huanwei", 1) > 200
    && (me->query_skill_mapped("force") == "xiantian-qigong" || me->query_skill_mapped("force") == "tiangang-zhengqi")
    && me->query("neili") > 1000
    && random(5) == 0 && random(ap) > dp / 10) {
    //		if (!ob->is_busy()) ob->start_busy(1);
    me->add("neili", -100);
    message_vision(HIC "$N脚踏七星，身法来去自如！$n招式十有八九落空！\n" NOR, me, ob);
    j = -(damage + random(damage));
    return j;
  }
}
