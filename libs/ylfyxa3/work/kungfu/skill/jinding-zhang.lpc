int valid_enable(string usage) {
  return usage == "strike" || usage == "parry" || usage == "unarmed";
}

int valid_combine(string combo) {
  return combo == "tiangang-zhi";
}

int valid_learn(object me) {
  //		if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练金顶绵掌必须空手。\n");
  if ((int)me->query("con", 1) < 25)
    return notify_fail("你的根骨不够。\n");
  if ((int)me->query_skill("linji-zhuang", 1) < 200)
    return notify_fail("你的临济庄心法火候不够，不能练金顶绵掌。\n");
  if (me->query("family/family_name") != "峨嵋派")
    return notify_fail("你未加入峨嵋派，无法学习本门技能。\n");
  if ((int)me->query("max_neili") < 100000)
    return notify_fail("你的内力太弱，无法练金顶绵掌。\n");
  if ((int)me->query("score", 1) < 5000)
    return notify_fail("你对我派毫无贡献而言，怎么可能传授你武功呢。\n");
  if (random(100) == 1) me->add("score", -5);
  return 1;
}

string query_skill_name(int level) {
  int i;
  for (i = sizeof(action) - 1; i >= 0; i--)
    if (level >= action[i - 1]["lvl"])
      return action[i - 1]["skill_name"];
}

mapping query_action(object me, object weapon) {
  int level;
  level = (int)me->query_skill("jinding-zhang", 1);

  if (random(5) == 1 && random(level) > 300 && me->query("jiali") > 100) {
    return ([
      "action": "$N双掌合十，化为点点掌影，一招" + (order[random(13)]) + "「佛光普照」" NOR "铺天盖地的掌影如疾风骤雨般袭向$n" NOR,
      "attack": 600,
      "parry": 600,
      "dodge": 600,
      "damage": 600,
      "force": 600,
      "skill_name": "佛光普照",
      "damage_type": "内伤" ]);
  }

  return action[random(sizeof(action))];  //2017.9.4阿飞改，将招式简单点
}

int practice_skill(object me) {
  //		if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if ((int)me->query("qi") < 30)
    return notify_fail("你的体力太低了。\n");
  if (me->query("family/family_name") != "峨嵋派")
    return notify_fail("偷练峨嵋派绝技，遇到老尼姑会倒大霉。\n");
  if (me->query_skill("jinding-zhang", 1) < 100)
    me->receive_damage("qi", 10);
  else
    me->receive_damage("qi", 20);
  return 1;
}
string perform_action_file(string action) {
  return __DIR__ "jinding-zhang/" + action;
}
//2017.3.25阿飞封掉ob_hit特效，怀疑与伤害为0的死亡有关
int ob_hit(object ob, object me, int damage) {
  string msg;
  int j, ap, dp, damage2;

  dp = (int)ob->query_skill("unarmed", 1);
  ap = (int)me->query_skill("jinding-zhang", 1);
  damage2 = (int)me->query_skill("linji-zhuang", 1);
  if (damage2 > 50000) damage2 = 50000;
  if (damage2 < 10) damage2 = 10;
  if (damage < 10) damage = 10;
  if (random(6) == 3 && random(ap) >= dp / 10 && me->query_skill_mapped("force") == "linji-zhuang") {
    j = -(damage + random(damage));
    if (me->query("eff_qi") < me->query("max_qi")) {
      me->add("eff_qi", damage2 * 10);
    }
    if (me->query("qi") < me->query("eff_qi")) {
      me->add("qi", damage2 * 10);
    }
    me->add("neili", -100);
    msg = HIG "$N 五心向天，运行日月二庄，益气升阳，益阴潜阳，升降反正，天地二气交泰于身，并配合峨嵋九阳功。灭绝之意顿时大起!！\n" NOR;
    msg += "$N神色一变,恢复了些活力！\n",
      message_vision(msg, me, ob);
    return j;
  }
}

mixed hit_ob(object me, object victim, int damage_bonus) {
  int ap, dp, damage2;
  ap = me->query_skill("huifeng-jian", 1) * me->query("con", 1);
  dp = victim->query_skill("parry", 1) * me->query("int", 1);
  damage2 = (int)me->query_skill("jinding-zhang", 1);
  if (damage_bonus < 100) return 0;
  if (me->query_skill("linji-zhuang", 1) < 100) return 0;
  if (me->query("neili") < 100 || me->query_skill_mapped("force") != "linji-zhuang") return 0;
  if (damage2 < 10) damage2 = 10;

  if (random(5) == 0 && random(ap) > dp / 10 && me->query("jiali") > 0) {
    me->add("neili", -100);
    victim->receive_damage("qi", damage2 + damage_bonus / 2, me);
    victim->receive_wound("qi", damage2 + damage_bonus / 2, me);
    return HIR "$n受到金顶绵掌的内劲侵蚀！似乎骨头化为粉末！\n";
  }
}
