// wen.c 「问魂归处」

#include <ansi.h>
inherit F_SSERVER;
int perform(object me) {
  string msg;
  object weapon;
  int jing_cost, xtint, addtime, jineng_exp_add;
  int flag;
  xtint = me->query("int", 1);
  jing_cost = me->query_skill("lonely-sword", 1);

  if (!wizardp(me) && me->query("family/master_id") != "a fei")
    return notify_fail("非剑魔阿飞嫡传弟子，不可练习「问魂归处」。\n");
  if (me->is_fighting())
    return notify_fail("「问魂归处」不能在战斗中演练。\n");
  if (me->is_busy())
    return notify_fail("你现在正忙着呢！\n");
  if (!objectp(weapon = me->query_temp("weapon")) || (string)weapon->query("skill_type") != "sword")
    return notify_fail("你必须先去找一把剑。\n");
  if (me->query_skill_mapped("sword") != "lonely-sword")
    return notify_fail("你没正确激发该技能 。\n");
  //	if (target && target->query_temp("apply/shade_vision")) 
  //		return notify_fail("对方隐身了，你看不到"+target->query("name")+"。\n"); 
  if (me->query_temp("apply/shade_vision"))
    return notify_fail("纳尼！隐身了还问魂？鬼也看不见你啊。\n");
  if ((me->query("int", 1) < 30))
    return notify_fail("独孤九剑需要天资聪慧之人方可练习！\n");
  if ((me->query_skill("lonely-sword", 1) < 100))
    return notify_fail("你的独孤九剑等级不够, 不能演练「问魂归处」！\n");
  if ((me->query_skill("sword", 1) < 100))
    return notify_fail("你的基本剑法等级不够, 不能演练「问魂归处」！\n");
  if (me->query("neili") < jing_cost)
    return notify_fail("你的内力不够，没有力气演练「问魂归处」！\n");
  if (me->query("jingli") < jing_cost)
    return notify_fail("你现在太累了，无法集中精神演练「问魂归处」！\n");
  if (me->query_skill("lonely-sword", 1) > (me->query("xyzx_sys/level") + 300) * 2)
    return notify_fail("你的实战经验不够，无法体会「问魂归处」！\n");
  if (me->query_temp("autolian"))
    return notify_fail("你正在发动自动连招！\n");
  if (me->query_temp("cooldown"))  //CD写法	2017.9.7添加
    return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");

  msg = HIG "$N使出独孤九剑之「问魂归处」，将手中" + weapon->name() + HIG "随意挥舞击刺。\n" NOR;
  message_vision(msg, me);
  if (me->query_exp_times() > 1) addtime = 2;
  else addtime = 1;
  if (me->query("xyhy_type") == 2) flag = 5 / 4;  //2016.6.20阿飞改，黄金会员自练速度为1.25倍
  else flag = 1;
  if (me->query_temp("jineng_exp_add")) jineng_exp_add = (int)me->query_temp("jineng_exp_add", 1);  //处于技能自练提升状态时
  else jineng_exp_add = 0;
  me->add("neili", -jing_cost);
  me->add("jingli", -jing_cost);
  me->improve_skill(
    "lonely-sword",
    100 + (int)me->query_int(1) * (jineng_exp_add + 100) / 100 * xtint * addtime * flag * 1 / 20
  );
  msg = MAG "$P的「独孤九剑」进步了！\n" NOR;
  me->start_busy(1);
  message_vision(msg, me);
  return 1;
}
