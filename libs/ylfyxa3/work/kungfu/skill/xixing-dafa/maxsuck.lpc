#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit F_SSERVER;

int exert(object me, object target) {
  int ap, dp, max_suck, skill;
  skill = (int)me->query_skill("xixing-dafa", 1);

  if (target == me)
    target = offensive_target(me);
  if (!objectp(target) || environment(me) != environment(target) || target->query("id") == "mu ren" || target->query("id") == "tong ren")
    return notify_fail("你要吸谁的内力？\n");
  if (wiz_level(target) > 0 || (int)target->query("max_neili") <= 0 || (int)target->query("no_suck"))
    return notify_fail(target->name() + "没有任何内力！\n");
  //	if (target && target->query_temp("apply/shade_vision")) 
  //		return notify_fail("对方隐身了，你看不到"+target->query("name")+"。\n"); 	
  //	if ( me->query_temp("sucked") )
  //		return notify_fail("你刚刚吸取过内力，真气未能回转。\n");
  if (me->query_temp("apply/shade_vision"))
    return notify_fail("你都隐身了，还想吸取别人内力？这不太合适吧。\n");
  if (target->query("age") < 18)
    return notify_fail("小孩子能有什么内力?\n");
  if (objectp(me->query_temp("weapon")))
    return notify_fail("你必须空手才能施用吸星大法！\n");
  if ((int)me->query_skill("xixing-dafa", 1) < 300 || me->query("max_neili") > skill * 10000)
    return notify_fail("你的吸星大法功力不够，不能吸取对方的内力！n");
  if (me->query_skill_mapped("force") != "xixing-dafa")
    return notify_fail("你没有使用吸星大法。\n");
  if ((int)me->query("neili", 1) < 1000)
    return notify_fail("你的内力不够，不能使用吸星大法。\n");
  if ((int)me->query("jingli", 1) < 1000)
    return notify_fail("你的精力不够，不能使用吸星大法。\n");
  if ((int)target->query("max_neili") < 1000 || (int)target->query("neili") < 1000 || !living(target))
    return notify_fail(target->name() + "已经内力涣散，你已经无法从他体内吸取任何内力了！\n");
  if (me->is_busy())
    return notify_fail("你现在正忙着吸取内力！\n");
  if (me->query_temp("autolian"))
    return notify_fail("你正在发动自动连招！\n");
  if (me->query_temp("cooldown"))  //CD写法	2017.9.7添加
    return notify_fail("你处于技能冷却状态中，过会在使用吧。\n");
  //	if(!me->query("xy_huiyuan") && me->query("max_neili") >=330000)
  //		return notify_fail(HIY"只有会员才能吸取33万以上内力。\n"NOR);
  //	if ( !me->query("xy_huiyuan") && target->query("id") == "nai niu" && domain_file(base_name(environment(me))) == "party" )
  //		return notify_fail(HIY"帮会中奶牛只提供给注册会员使用，你无法吸取。\n"NOR);

  message_vision(HIM "$N手臂猛地长出正抓在$n右手腕上。突然之间，$n猛觉右腕“内关”“外关”两处穴道中内力源源外泄！\n\n" NOR, me, target);
  me->add("neili", -100);
  me->add("jingli", -100);
  me->set_temp("cooldown", 1);  //CD写法	2017.9.7添加
  call_out("del_cooldown", 6, me);  //CD写法1	
  if (living(target)) {
    me->kill_ob(target);
    target->kill_ob(me);
  }

  ap = me->query("xyzx_sys/level") + me->query_skill("xixing-dafa", 1) + me->query_skill("force");
  dp = target->query("xyzx_sys/level") + target->query_skill("force");

  if (random(ap) > dp / 3) {
    tell_object(target, HIY "你只觉得手腕上“内关”“外关”两处穴道便如开了两个大缺口，立时全身内力急泻而出，有如河水决堤，再也难以堵截！\n" NOR);
    tell_object(me, HIG "你觉得" + target->name() + "的内力自手掌源源不绝地流了进来。\n" NOR);
    if ((int)me->query("max_neili") < (int)target->query("max_neili") && (int)me->query("neili") < (int)target->query("neili")) max_suck = (int)me->query_skill(
      "xixing-dafa",
      1
    ) / 12;
    else max_suck = (int)me->query_skill("xixing-dafa", 1) / 18;
    //		if (userp(target)) max_suck/=4;		//吸玩家减少
    if (target->query("max_neili") < max_suck) max_suck = target->query("max_neili");
    target->add("max_neili", -max_suck);
    target->add("neili", -max_suck);
    me->add("max_neili", max_suck);
    me->add("neili", -max_suck);
    if (userp(me) && me->query("env/no_combat_msg") < 4) tell_object(
      me,
      HIW "该绝招吸取敌人上限内力" + max_suck + "。\n" NOR
    );
    if (target->query("max_neili") < 1) target->set("max_neili", 0);
    if (me->query("neili") < 1) me->set("neili", 0);
    //		if (!target->is_busy()) target->start_busy(random(3)+1);		
    if (me->query_skill(
      "xixing-dafa",
      1
    ) < me->query_skill(
      "force",
      1
    ) && me->query_skill("xixing-dafa", 1) < (me->query("xyzx_sys/level") + 300) * 2)
      me->improve_skill("xixing-dafa", me->query("con", 1) * 10 + 10, 0);
  } else {
    message_vision(HIY "可是$p看破了$P的企图，机灵地闪了开去。\n" NOR, me, target);
  }

  me->start_busy(1);
  return 1;
}

void del_cooldown(object me)  //CD写法1
{
  if (!objectp(me)) return;
  if (me->query_temp("cooldown")) {
    me->delete_temp("cooldown");
    tell_object(me, HIM "你呼出一口气，缓缓的将内力收回丹田。\n" NOR);
  }
}
