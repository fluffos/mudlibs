// guiyuan-tunafa.c 铁掌帮 归元吐纳法
// zqb

inherit FORCE;

int valid_enable(string usage) {
  return usage == "force";
}

int valid_learn(object me) {
  mapping skl;
  string *sname;
  int i;
  //	if (!wizardp(me))
  //		return notify_fail("巫师突然从黑暗中冲了出来，对你大吼一声：该门派没开放。\n");	
  if ((int)me->query_skill("force", 1) < 100)
    return notify_fail("你的基本内功火候不足，不能学归元吐纳法。\n");
  if (me->query("gender") == "无性" && me->query_skill("guiyuan-tunafa", 1) > 49)
    return notify_fail("你无根无性，阴阳不调，难以领会高深的归元吐呐法。\n");
  //	if ( me->query_skill("buddhism",1) || me->query_skill("taoism",1) )
  //		return notify_fail("你练了秃驴牛鼻子们的心法，还学归元吐纳法做什麽！\n");
  if (me->query("family/family_name") != "铁掌帮")
    return notify_fail("你未加入铁掌山，无法学习本门技能。\n");
  skl = this_player()->query_skills();
  sname = keys(skl);
  for (i = 0; i < sizeof(skl); i++) {
    if (sname[i] == "yijing-force") continue;
    if (sname[i] == "guiyuan-tunafa") continue;
    if (sname[i] == "xixing-dafa") continue;
    if (SKILL_D(sname[i])->valid_enable("force"))
      return notify_fail("你不先散了别派内功，怎能学归元吐纳法？！\n");
  }
  return 1;
}


int practice_skill(object me) {
  return notify_fail("归元吐呐法只能用学(learn)的来增加熟练度。\n");
}

string exert_function_file(string func) {
  return __DIR__ "guiyuan-tunafa/" + func;
}

mixed hit_ob(object me, object victim, int damage_bonus, int factor) {
  int ap, dp, damage2;
  damage2 = (int)me->query_skill("guiyuan-tunafa", 1);
  ap = me->query_skill("guiyuan-tunafa", 1);
  dp = victim->query_skill("force", 1);
  if (damage_bonus < 100) return 0;
  if (me->query_skill("guiyuan-tunafa", 1) < 100) return 0;
  if (me->query("jiali") < 1 || me->query("neili") < 100 || me->query_skill_mapped("force") != "guiyuan-tunafa") return 0;
  if (damage2 < 10) damage2 = 10;
  if (random(ap) > dp / 20 && random(6) == 0 && me->query("jiali") > 0) {
    victim->receive_wound("qi", damage2 + damage_bonus / 2, me);
    victim->receive_wound("jing", damage2 + damage_bonus / 2, me);
    victim->add("neili", damage2);
    me->add("neili", -100);
    return HIB "$N全身真气提起，发挥" + HIR + "归元吐纳法" NOR HIB "的精髓，摧毁了$n的精气神！！！！\n" NOR;
  }
}


mapping exercise_msg(object me) {
  return ([
    "status_msg": "呼吸急促，双嘴一张一合。\n",
    "start_my_msg": "双腿盘坐，两手相向，呼吸急促起来，一呼一吸间，口中吞吐着白气。\n",
    "start_other_msg": me->name() + "盘膝坐下，两手相向，一呼一吸间，口中白气吞吐。\n",
    "heal_my_msg": "呼吸急促，口一张一合，白气圈圈一个接一个。\n",
    "heal_other_msg": me->name() + "呼吸急促，口一张一合，白气形成圈圈，一个接一个。\n",
    "halt_msg": "倒吸一口长气，似鲸鱼吸水，站了起来。\n",
    "end_my_msg": "倒吸一口长气，白气圈圈如鲸鱼吸水倒吸回来。\n",
    "end_other_msg": me->name() + "深深的吸了一口气，如鲸鱼吸水般将白气圈圈倒吸回来。\n",
    "hover_my_msg": "胸脯一起一伏，口一张一合，白气圈圈一个接一个。过了良久，你倒吸一口气，将白气圈圈吸了回来。\n",
    "hover_other_msg": me->name() + "胸脯一起一伏，口一张一合。过了良久，你倒吸一口长气，白色气圈全部倒吸回来，聚入丹田。\n",
  ]);
}
