inherit NPC;
void create() {
  int jibie;
  jibie = 200;
  set("xyzx_sys/level", jibie * 8 / 10 + random(jibie * 4 / 10));  //2016.5.22阿飞调整NPC属性	
  set("shen_type", 0);
  set_name("虚明", ({
    "xu ming",
    "xu",
    "ming",
  }));
  set("long",
    "他是一位身穿黄布袈裟的青年僧人。脸上稚气未脱，身手却已相\n"
    "当矫捷，看来似乎学过一点武功。\n"
  );
  set("nickname", "知客僧");
  set("gender", "男性");
  set("attitude", "friendly");
  set("class", "bonze");
  set("age", 20);
  set("str", 20);
  set("int", 20);
  set("con", 35);
  set("dex", 40);
  set("max_qi", 350);
  set("max_jing", 200);
  set("neili", 300);
  set("max_neili", 300);
  set("jiali", 20);
  set("combat_exp", 15000);

  set_skill("force", 500 + jibie / 3 + random(jibie / 5));
  set_skill("hunyuan-yiqi", 500 + jibie / 3 + random(jibie / 5));
  set_skill("dodge", 500 + jibie / 3 + random(jibie / 5));
  set_skill("shaolin-shenfa", 500 + jibie / 3 + random(jibie / 5));
  set_skill("unarmed", 500 + jibie / 3 + random(jibie / 5));
  set_skill("banruo-zhang", 500 + jibie / 3 + random(jibie / 5));
  set_skill("parry", 500 + jibie / 3 + random(jibie / 5));
  set_skill("sword", 500 + jibie / 3 + random(jibie / 5));
  set_skill("damo-jian", 500 + jibie / 3 + random(jibie / 5));
  map_skill("force", "hunyuan-yiqi");
  map_skill("dodge", "shaolin-shenfa");
  map_skill("unarmed", "banruo-zhang");
  map_skill("parry", "damo-jian");
  map_skill("sword", "damo-jian");

  create_family("少林派", 41, "弟子");
  setup();
  carry_object("/clone/weapon/changjian")->wield();
  carry_object("/d/shaolin/obj/xu-cloth")->wear();
}
