// gaibang npc code
inherit NPC;
inherit F_MASTER;
void create() {
  int jibie;
  jibie = 500;
  //	set("xyzx_sys/level", jibie*8/10+random(jibie*4/10));	//2016.5.22阿飞调整NPC属性	
  set("xyzx_sys/level", jibie);  //2017.9.1阿飞调整NPC等级为固定值，取消20%的浮动设定	
  set("shen_type", 0);
  set_name("马俱为", ({ "ma juwei", "ma", "juwei" }));
  set("title", "丐帮七袋弟子");
  set("gender", "男性");
  set("age", 35);
  set("long",
    "这是位武艺精强，却沉默寡言的丐帮八袋弟子。\n");
  set("attitude", "peaceful");
  set("str", 23);
  set("int", 22);
  set("con", 18);
  set("dex", 25);
  set("qi", 460);
  set("max_qi", 460);
  set("jing", 300);
  set("max_jing", 300);
  set("neili", 710);
  set("max_neili", 710);
  set("jiali", 36);

  set("combat_exp", 95000);

  set_skill("force", 500 + jibie / 3 + random(jibie / 5));
  set_skill("huntian-qigong", 500 + jibie / 3 + random(jibie / 5));
  set_skill("unarmed", 500 + jibie / 3 + random(jibie / 5));
  //    set_skill("xianglong-zhang", 500+jibie/3+random(jibie/5));
  set_skill("dodge", 500 + jibie / 3 + random(jibie / 5));
  set_skill("xiaoyaoyou", 500 + jibie / 3 + random(jibie / 5));
  set_skill("parry", 500 + jibie / 3 + random(jibie / 5));
  set_skill("club", 500 + jibie / 3 + random(jibie / 5));
  //    set_skill("dagou-bang", 500+jibie/3+random(jibie/5));
  set_skill("begging", 500 + jibie / 3 + random(jibie / 5));
  set_skill("checking", 500 + jibie / 3 + random(jibie / 5));
  set_skill("blade", 500 + jibie / 3 + random(jibie / 5));
  set_skill("liuhe-dao", 500 + jibie / 3 + random(jibie / 5));
  map_skill("force", "huntian-qigong");
  //    map_skill("unarmed", "xianglong-zhang");
  map_skill("dodge", "xiaoyaoyou");
  map_skill("parry", "liuhe-dao");
  //   map_skill("club", "dagou-bang");
  map_skill("blade", "liuhe-dao");

  create_family("丐帮", 20, "弟子");
  setup();
  carry_object("/clone/cloth/pcloth")->wear();
}
void attempt_apprentice(object ob) {
  if (ob->query("str") < 20) return;
  command("say 你拜我为师，可要做好吃苦的准备，好好做个丐帮弟子！");
  command("recruit " + ob->query("id"));
  if ((string)ob->query("class") != "beggar")
    ob->set("class", "beggar");
}
