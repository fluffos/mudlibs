#include <ansi.h>
inherit NPC;
inherit F_MASTER;

void create() {
  int jibie;
  jibie = 2000;
  set("xyzx_sys/level", jibie);  //2016.5.22阿飞调整NPC属性	
  set("shen_type", 1);
  set_name("静真", ({ "jing zhen", "jing", "zhen" }));
  set("long",
    "她是一位中年出家道姑，身穿道袍，正端坐在蒲团上，眉目之间有一股祥和之气。\n");
  set("gender", "女性");
  set("age", 33);
  set("attitude", "friendly");

  set("str", 24);
  set("int", 22);
  set("con", 23);
  set("dex", 21);

  set("qi", 800);
  set("max_qi", 800);
  set("jing", 900);
  set("max_jing", 900);
  set("neili", 600);
  set("max_neili", 600);
  set("jiali", 10);

  set("combat_exp", 800000);
  set("score", 70000);

  set_skill("force", 500 + jibie / 3 + random(jibie / 5));
  set_skill("dodge", 500 + jibie / 3 + random(jibie / 5));
  set_skill("blade", 500 + jibie / 3 + random(jibie / 5));
  set_skill("unarmed", 500 + jibie / 3 + random(jibie / 5));
  set_skill("parry", 500 + jibie / 3 + random(jibie / 5));
  set_skill("sword", 500 + jibie / 3 + random(jibie / 5));
  set_skill("strike", 500 + jibie / 3 + random(jibie / 5));
  set_skill("linji-zhuang", 500 + jibie / 3 + random(jibie / 5));
  set_skill("jinding-zhang", 500 + jibie / 3 + random(jibie / 5));
  set_skill("huifeng-jian", 500 + jibie / 3 + random(jibie / 5));
  set_skill("yanxing-dao", 500 + jibie / 3 + random(jibie / 5));
  set_skill("tiangang-zhi", 500 + jibie / 3 + random(jibie / 5));
  set_skill("zhutian-bu", 500 + jibie / 3 + random(jibie / 5));
  set_skill("yugalism", 500 + jibie / 3 + random(jibie / 5));
  set_skill("dushi-jiren", 500 + jibie / 3 + random(jibie / 5));
  set_skill("literate", 500 + jibie / 3 + random(jibie / 5));
  map_skill("dodge", "zhutian-bu");
  map_skill("parry", "huifeng-jian");
  map_skill("sword", "huifeng-jian");
  map_skill("force", "linji-zhuang");
  map_skill("unarmed", "tiangang-zhi");
  map_skill("blade", "yanxing-dao");
  prepare_skill("strike", "jinding-zhang");
  prepare_skill("unarmed", "tiangang-zhi");

  create_family("峨嵋派", 4, "弟子");
  set("class", "bonze");
  setup();
  carry_object("/clone/cloth/cloth")->wear();
  carry_object("/clone/weapon/gangdao")->wield();
}
