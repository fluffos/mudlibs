// feng.c 风清扬
inherit NPC;
inherit F_MASTER;
void create() {
  int jibie;
  jibie = 9000;
  set("xyzx_sys/level", jibie);  //2016.5.22阿飞调整NPC属性	
  set("shen_type", 1);
  set_name("风清扬", ({ "feng qingyang", "feng", "qingyang" }));
  set("nickname", "剑宗祖师");
  set("long",
    "他就是华山剑宗的长老风清扬。他身材瘦长，眉宇间一直笼罩着一股淡淡的忧伤\n"
    "神色，显然对当年的剑宗气宗之争一直难以忘怀。\n");
  set("gender", "男性");
  set("age", 68);
  set("attitude", "peaceful");

  set("str", 60);
  set("int", 80);
  set("con", 80);
  set("dex", 230);


  set("qi", 4158000);
  set("max_qi", 4158000);
  set("jing", 1560000);
  set("max_jing", 1560000);
  set("neili", 3000000);
  set("max_neili", 600000);
  set("jiali", 13000);
  set("combat_exp", 11059200);
  set_skill("force", 500 + jibie / 3 + random(jibie / 5));
  set_skill("blade", 500 + jibie / 3 + random(jibie / 5));
  set_skill("dodge", 500 + jibie / 3 + random(jibie / 5));
  set_skill("parry", 500 + jibie / 3 + random(jibie / 5));
  set_skill("sword", 500 + jibie / 3 + random(jibie / 5));
  set_skill("unarmed", 500 + jibie / 3 + random(jibie / 5));
  set_skill("strike", 500 + jibie / 3 + random(jibie / 5));
  set_skill("zixia-shengong", 500 + jibie / 3 + random(jibie / 5));
  set_skill("poyu-quan", 500 + jibie / 3 + random(jibie / 5));
  set_skill("fanliangyi-dao", 500 + jibie / 3 + random(jibie / 5));
  set_skill("huashan-jianfa", 500 + jibie / 3 + random(jibie / 5));
  set_skill("hunyuan-zhang", 500 + jibie / 3 + random(jibie / 5));
  set_skill("dugu-jiujian", 500 + jibie / 3 + random(jibie / 5));
  set_skill("huashan-shenfa", 500 + jibie / 3 + random(jibie / 5));
  set_skill("huashan-zhangfa", 500 + jibie / 3 + random(jibie / 5));
  set_skill("literate", 500 + jibie / 3 + random(jibie / 5));
  map_skill("force", "zixia-shengong");
  map_skill("dodge", "huashan-shenfa");
  map_skill("parry", "dugu-jiujian");
  map_skill("sword", "dugu-jiujian");
  map_skill("blade", "fanliangyi-dao");
  map_skill("unarmed", "huashan-zhangfa");
  map_skill("strike", "hunyuan-zhang");
  create_family("华山派", 10, "弟子");
  set("chat_chance_combat", 100);
  set("chat_msg_combat", ({
    (: perform_action, "sword.dugu" :),
    (: perform_action, "sword.poqi" :),
    (: perform_action, "sword.pozhang" :),
    (: perform_action, "sword.pojian" :),
    (: exert_function, "recover" :),
  }));
  setup();
  carry_object("/clone/cloth/cloth")->wear();
  carry_object("/clone/weapon/changjian")->wield();
}
void attempt_apprentice(object ob) {
  if (mapp(ob->query("family")) && (string)ob->query("family/family_name") != "华山派") {
    command("say " + RANK_D->query_respect(ob) + "既然已有名师指点，何必又来拜老朽呢？");
    return;
  }
  if (((int)ob->query_skill(
    "sword",
    1
  ) < 1000) || ((int)ob->query_skill("huashan-jianfa", 1) < 1000)) {
    command("say 我看" + RANK_D->query_respect(ob) + "的华山剑法还没学到家吧。");
    return;
  }
  if (((int)ob->query_skill(
    "force",
    1
  ) < 1000) || ((int)ob->query_skill("zixia-shengong", 1) < 1000)) {
    command("say 我看" + RANK_D->query_respect(ob) + "的紫霞神功还没学到家吧。");
    return;
  }
  if (((int)ob->query_skill(
    "dodge",
    1
  ) < 1000) || ((int)ob->query_skill("huashan-shenfa", 1) < 1000)) {
    command("say 我看" + RANK_D->query_respect(ob) + "的华山身法还没学到家吧。");
    return;
  }
  if (((int)ob->query_skill(
    "dodge",
    1
  ) < 1000) || ((int)ob->query_skill("kuangfeng-jian", 1) < 1000)) {
    command("say 我看" + RANK_D->query_respect(ob) + "对我华山剑宗武功还没学到家吧。");
    return;
  }
  if ((int)ob->query("xyzx_sys/level") < 1000) {
    command("say 这位" + RANK_D->query_respect(ob) + "实战能力太差了，还是去江湖上历练吧。");
    return;
  }
  if ((int)ob->query_skill("literate", 1) < 1000) {
    command("say 我看" + RANK_D->query_respect(ob) + "的读书识字还没学到家吧。");
    return;
  }
  if ((int)ob->query("score", 1) < 200000) {
    message_vision("风清扬笑着说道：你的江湖阅历不够！\n", ob);
    return;
  }
  if ((int)ob->query("shen") < 1000000) {
    command("say 我华山派乃是堂堂名门正派，对弟子要求极严。");
    command("say 在德行方面，" + RANK_D->query_respect(ob) +
      "是否还做得不够？");
    return;
  }
  if ((int)ob->query("con", 1) < 25) {
    command("say 我华山气宗以内功为主，依我看" + RANK_D->query_respect(ob) + "的根骨不适合学我华山内功。");
    return;
  }
  if ((int)ob->query("dex", 1) < 25) {
    command("say 我华山剑宗以剑法为主，依我看" + RANK_D->query_respect(ob) + "的身法似乎不适合学我华山派剑法？");
    return;
  }
  if ((int)ob->query("int", 1) < 30) {
    command("say 依我看" + RANK_D->query_respect(ob) + "的悟性似乎不适合学独孤九剑？");
    return;
  }
  command("say 好吧，我就收下你了。");
  command("recruit " + ob->query("id"));
  //   if((string)ob->query("class") != "swordsman") ob->set("class", "swordsman");
  return;
}
