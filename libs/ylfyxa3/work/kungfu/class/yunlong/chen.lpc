// chen.c 陈近南
#include <ansi.h>
inherit NPC;
inherit F_MASTER;

int ask_fuming();
int ask_weiwang();
string ask_jianpu();

void create() {
  int jibie;
  jibie = 4000;
  set("xyzx_sys/level", jibie);  //2016.5.22阿飞调整NPC属性	
  set("shen_type", 1);
  set_name("陈近南", ({ "chen jinnan", "chen", "jinnan" }));
  set("nickname", HIC "英雄无敌" NOR);
  set("long",
    "\n这是一个文士打扮的中年书生，神色和蔼。\n"
    "他就是天下闻名的天地会总舵主陈近南,\n"
    "据说十八般武艺，样样精通。\n"
    "偶尔向这边看过来，顿觉他目光如电，英气逼人。\n");
  set("gender", "男性");
  set("age", 45);
  set("attitude", "peaceful");

  set("str", 50);
  set("int", 50);
  set("con", 60);
  set("dex", 160);

  set("max_qi", 2115000);
  set("max_jing", 1322000);
  set("neili", 3225000);
  set("max_neili", 525000);
  set("jiali", 13000);
  set("combat_exp", 6400000);
  set("score", 500000);


  set_skill("literate", 500 + jibie / 3 + random(jibie / 5));
  set_skill("force", 500 + jibie / 3 + random(jibie / 5));
  set_skill("dodge", 500 + jibie / 3 + random(jibie / 5));
  set_skill("unarmed", 500 + jibie / 3 + random(jibie / 5));
  set_skill("parry", 500 + jibie / 3 + random(jibie / 5));
  set_skill("whip", 500 + jibie / 3 + random(jibie / 5));
  set_skill("blade", 500 + jibie / 3 + random(jibie / 5));
  set_skill("sword", 500 + jibie / 3 + random(jibie / 5));
  set_skill("houquan", 500 + jibie / 3 + random(jibie / 5));
  set_skill("yunlong-xinfa", 500 + jibie / 3 + random(jibie / 5));
  set_skill("yunlong-shengong", 500 + jibie / 3 + random(jibie / 5));
  set_skill("wuhu-duanmendao", 500 + jibie / 3 + random(jibie / 5));
  set_skill("yunlong-jian", 500 + jibie / 3 + random(jibie / 5));
  set_skill("yunlong-shenfa", 500 + jibie / 3 + random(jibie / 5));
  set_skill("yunlong-bian", 500 + jibie / 3 + random(jibie / 5));
  set_skill("yunlong-shou", 500 + jibie / 3 + random(jibie / 5));
  set_skill("yunlong-zhua", 500 + jibie / 3 + random(jibie / 5));
  map_skill("dodge", "yunlong-shenfa");
  map_skill("force", "yunlong-shengong");
  map_skill("unarmed", "yunlong-zhua");
  map_skill("blade", "wuhu-duanmendao");
  map_skill("parry", "yunlong-zhua");
  map_skill("sword", "yunlong-jian");
  map_skill("whip", "yunlong-bian");
  create_family("云龙门", 1, "开山祖师");
  set("class", "yunlong-xinfa");
  set("book_count", 1);
  set("inquiry", ([
    "天地会": "\n只要是英雄好汉，都可以入我天地会(join tiandihui)。\n",
    "暗号": "敲三下！\n",
    "切口": "敲三下！\n",
    "江湖威望": (: ask_weiwang :),
    "云龙剑谱": (: ask_jianpu :),
    "反清复明": (: ask_fuming :),
  ]));

  set("chat_chance_combat", 20);
  set("chat_msg_combat", ({
    "\n陈近南摇头叹道：螳臂当车，不自量力。唉，你这又是何苦呢?\n",
    (: command("smile") :),
    (: command("poem") :),
    (: command("nomatch") :),
    (: command("haha") :),
    (: command("chat 这位" + RANK_D->query_respect(this_player()) + ",你我无冤无仇，何必如此?\n") :),
    (: command("unwield changjian") :),
    (: command("wield changjian") :),
    (: command("wield bian") :),
    (: command("unwield bian") :),
    (: command("wield blade") :),
    (: command("unwield blade") :),
  }));
  setup();
  carry_object("/clone/cloth/jinduan")->wear();
  carry_object("/d/city2/obj/yaodai")->wear();
  carry_object("/clone/weapon/changjian")->wield();
  carry_object("/d/city2/obj/hlbian")->wield();
  carry_object("/clone/weapon/gangdao")->wield();
}
string ask_jianpu() {
  mapping fam;
  object ob;
  if (!(fam = this_player()->query("family")) || fam["family_name"] != "云龙门")
    return RANK_D->query_respect(this_player()) + "与本派素无来往，不知此话从何谈起？";
  if (query("book_count") < 1)
    return "你来晚了，本派的云龙真经不在此处。";
  add("book_count", -1);
  ob = new("/d/city2/obj/yljianpu");
  ob->move(this_player());
  return "好吧，这本「云龙剑谱」你拿回去好好钻研。";
}

void init() {
  ::init();
  add_action("do_skills", "skills");
  add_action("do_skills", "cha");
  add_action("do_join", "join");
}

void attempt_apprentice(object ob) {
  if ((int)ob->query_skill("yunlong-shengong", 1) < 1000) {
    command("say 我云龙神功乃内家武功，最重视内功心法。");
    command("say " + RANK_D->query_respect(ob) + "是否还应该在云龙神功上多下点功夫？");
    return;
  }
  if ((int)ob->query("xyzx_sys/level") < 1000) {
    command("say 这位" + RANK_D->query_respect(ob) + "实战能力太差了，我的门下不收无用之人。");
    return;
  }
  if ((int)ob->query("int", 1) < 30) {
    command("say 我云龙门需要孔武有力之人，你这样的恐怕难以担负反清复明的任务。");
    return;
  }
  if ((int)ob->query("weiwang") < 60) {
    command("say 我云龙门武功天下无敌，凡入我门，\n必闯荡江湖，行侠仗义，为天下苍生谋福利。\n");
    command("say " + RANK_D->query_respect(ob) + "是否应该先出去闯一闯，做几件惊天动地的大事？");
    return;
  }
  if ((int)ob->query("shen") > 0 && (int)ob->query("shen") < 100000) {
    command("say 学武之人，德义为先，功夫的高低倒还在其次，未练武，要先学做人。");
    command("say 在德行方面，" + RANK_D->query_respect(ob) + "是否还做得不够？");
    return;
  }
  if ((int)ob->query("score", 1) < 100000) {
    message_vision("陈近南疑惑的看着你说道：加入我派先考验忠诚度？\n", ob);
    return;
  }
  if (ob->query("weiwang") < 80) {
    if ((int)ob->query("shen") < 0) command("say " + RANK_D->query_respect(ob) + "虽然是邪派中人，但也还做了些好事。\n");
    command("chat 我天地会所作所为，无一不是前人所未行之事。\n");
    command("chat 万事开创在我，骇人听闻，物议沸然，又何足论？\n");
    command("chat 今天就收了你吧！！\n");
    command("chat 想不到我一身惊人艺业，今日终于有了传人，哈哈哈哈！！！！\n");
    message_vision(HIC "$N的江湖威望提高了！\n" NOR, this_player());
    ob->set("weiwang", 80);
  }
  command("recruit " + ob->query("id"));
  if ((!(string)ob->query("class")) || ((string)ob->query("class") != "fighter")) ob->set(
    "class",
    "fighter"
  );
}

int do_skills(string arg) {
  object ob;
  ob = this_player();
  if (!arg || arg != "chen") return 0;
  if (wizardp(ob)) return 0;
  if (ob->query("weiwang") < 50) {
    message_vision("$N摇了摇头。\n", this_object());
    command("tell " + ob->query("id") + " 不是天地会弟子不能察看。\n");
    return 1;
  }
  tell_object(ob, this_object()->name() + "说：我所有的基本武功如下：\n" +
    "  基本刀法 (blade)                         - 深不可测 500+jibie/3+random(jibie/5)/    0\n" +
    "  基本轻功 (dodge)                         - 深不可测 500+jibie/3+random(jibie/5)/    0\n" +
    "  基本内功 (force)                         - 深不可测 500+jibie/3+random(jibie/5)/    0\n" +
    "  读书写字 (literate)                      - 深不可测 500+jibie/3+random(jibie/5)/    0\n" +
    "  基本招架 (parry)                         - 深不可测 500+jibie/3+random(jibie/5)/    0\n" +
    "  基本剑法 (sword)                         - 深不可测 500+jibie/3+random(jibie/5)/    0\n" +
    "  基本拳脚 (unarmed)                       - 深不可测 500+jibie/3+random(jibie/5)/    0\n" +
    "  基本鞭法 (whip)                          - 深不可测 500+jibie/3+random(jibie/5)/    0\n" +
    "  云龙心法 (yunlong-xinfa)                 - 深不可测 500+jibie/3+random(jibie/5)/    0\n" +
    "  云龙爪 (yunlong-zhua)                    - 深不可测 500+jibie/3+random(jibie/5)/    0\n" +
    "□猴拳 (houquan)                           - 深不可测 500+jibie/3+random(jibie/5)/    0\n" +
    "□五虎断门刀 (wuhu-duanmendao)             - 深不可测 500+jibie/3+random(jibie/5)/    0\n" +
    "□云龙鞭 (yunlong-bian)                    - 深不可测 500+jibie/3+random(jibie/5)/    0\n" +
    "□云龙剑法 (yunlong-jian)                  - 深不可测 500+jibie/3+random(jibie/5)/    0\n" +
    "□云龙身法 (yunlong-shenfa)                - 深不可测 500+jibie/3+random(jibie/5)/    0\n" +
    "□云龙神功 (yunlong-shengong)              - 深不可测 500+jibie/3+random(jibie/5)/    0\n" +
    "□云龙手 (yunlong-shou)                    - 深不可测 500+jibie/3+random(jibie/5)/    0\n");
  return 1;
}
int ask_weiwang() {
  command("tell " + this_player()->query("id") + " 你现在的江湖威望是 " + (string)(this_player()->query("weiwang")));
  say("\n陈近南说道：如果你威望值很高，有些人见了你不但不会杀你，还会教你武功，送你宝贝。\n"
    + "而且你还可以加入帮会，率领会众去攻打目标，就连去钱庄取钱也会有利息 。。。。。\n");
  say("陈近南又说：杀某些坏人或救某些好人可以提高江湖威望。\n");
  return 1;
}
int do_join(string arg) {
  object ob;
  ob = this_player();
  if (!arg || arg != "tiandihui") return notify_fail("你要加入什么组织？\n");
  if (ob->query("weiwang") < 20) {
    command("tell " + this_player()->query("id") + " 你现在的江湖威望是 " + (string)(this_player()->query("weiwang")));
    message_vision(HIC "陈近南对$N摇了摇头说：你的江湖威望值太低。\n" NOR, this_player());
    return 1;
  }
  if (ob->query("weiwang") < 50) {
    ob->set("weiwang", 50);
    message_vision(HIC "$N的江湖威望提高了！\n" NOR, this_player());
    command("tell " + this_player()->query("id") + " 你现在的江湖威望是 " + (string)(this_player()->query("weiwang")));
    return 1;
  } else {
    message_vision(HIC "陈近南对$N摇了摇头说：你已经加入天地会了。\n" NOR, this_player());
  }
  return 1;
}

int ask_fuming() {
  object me, ob;
  me = this_player();
  ob = this_object();

  if ((string)me->query("family/family_name") == "云龙门" && me->query_temp("jm_yunlong2")) {
    message_vision(HIB "陈近南说道：这位" + RANK_D->query_respect(me) + "忠勇可嘉，当为我辈之楷模。\n" NOR, me);
    message_vision(HIC "陈近南仰天大笑：这康熙狗贼，终于有此报应。。。。。。” \n" NOR, me);
    message_vision(
      HIW "陈近南说道：这位" + RANK_D->query_respect(me) + "为天地会立下大功，可去天地会密室看看，或许能领悟到什么。” \n" NOR,
      me
    );
    me->set_temp("jm_yunlong3", 1);
  } else if ((string)me->query("family/family_name") == "云龙门") {
    message_vision(
      HIB "陈近南说道：这位" + RANK_D->query_respect(me) + "若能做一件惊天动地的大事，当为反清义士之表率。\n" NOR,
      me
    );
    message_vision(YEL "陈近南冷哼一声！！！我会弟子反清复明，当前仆后继......若你能取来康熙狗头......\n", me);
    me->set_temp("jm_yunlong1", 1);
  } else {
    message_vision(HIB "陈近南说道：天地会成员去棺材店和回春堂仔细瞧瞧吧，入了天地会，可以向会中高手请教武学。\n" NOR, me);
  }

  return 1;
}

int accept_object(object me, object ob) {
  if ((string)ob->query("id") == "kangxi rentou") {
    if ((int)me->query_temp("jm_yunlong1") && me->query("family/master_id") == "chen jinnan" && me->query("id") == ob->query("owner")) {
      message_vision("$N对$n说道：哈哈哈！这狗皇帝杀我会中之人，总算是死掉了。\n", me);
      message_vision("$N对$n说道：今日铲除了满清皇帝，我汉人当自强。\n", me);
      message_vision("$N对$n说道：吾徒果然有本事，也不枉会中之人苦心教导.........\n", me);
      me->set_temp("jm_yunlong2", 1);
      return 1;
    } else {
      message_vision("$N对$n说道：这康熙狗贼多次屠杀汉人，迟早都是要死的。\n", me);
      return 1;
    }
  }
  return 0;
}

void die() {
  object me;
  me = query_temp("last_damage_from");
  if (me && (string)me->query("family/family_name") == "神龙教" && me->query_temp("jm_shenlong1")) {
    tell_room(environment(this_player()), "洪安通说道：今日剿灭天地会余孽，必能取得小皇帝的信任！！！\n");
    tell_room(environment(this_player()), "陈近南醒悟道：狗贼，你居然投靠了鞑子皇帝！！！\n");
    tell_room(environment(this_player()), "陈近南惨嚎一声，倒在地上，口吐鲜血，死不瞑目.....．\n");
    me->set_temp("jm_shenlong2", 1);
  }
  ::die();
}
