//Cracked by Roath
//xiangsi.c
#include <ansi.h>
#include <condition.h>

inherit F_CLEAN_UP;

int update_condition(object me, int duration) {
  if (duration < 1) return 0;
  if (!living(me)) {
    message("vision", HIR "" + me->name() + "身中相思毒，痛苦的按着胸口．\n" NOR, environment(me), me);
  } else {
    tell_object(me, HIR "相思毒发作了。\n" NOR);
    message("vision", HIR "" + me->name() + "身中相思毒，痛苦的按着胸口．\n" NOR,
      environment(me), me);
  }
  me->receive_damage("qi", 100 + random(me->query("max_qi") / 100));
  me->receive_damage("jing", 100 + random(me->query("max_jing") / 100));
  me->receive_wound("qi", 100 + random(me->query("max_qi") / 100));
  me->receive_wound("jing", 100 + random(me->query("max_jing") / 100));
  me->apply_condition("xiangsi", duration - 1);
  me->set_temp("die_for", "中相思毒毒");
  me->delete_temp("last_damage_from");
  if (duration < 1) return 0;
  return CND_CONTINUE;
}

string query_type(object me) {
  return "poison";
}
