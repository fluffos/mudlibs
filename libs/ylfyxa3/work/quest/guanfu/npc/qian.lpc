//   qian 钱二败

inherit NPC;
string random_name();

void create() {
  int jibie;
  jibie = 500;
  set("xyzx_sys/level", jibie);  //2016.5.22阿飞调整NPC属性
  set_name("钱二败", ({ "qian erbai" }));
  set("nickname", "神箭八雄");
  set("long",
    "原是武林中的巨寇，后来为躲避官府和仇家，随便起了个假名字。\n");
  set("gender", "男性");
  set("age", 36);
  set("attitude", "peaceful");
  set("shen_type", -1);
  set("str", 28);
  set("int", 20);
  set("con", 25);
  set("dex", 27);

  set("max_qi", 1500);
  set("max_jing", 1500);
  set("neili", 1800);
  set("max_neili", 1800);
  set("jiali", 100);
  set("combat_exp", 700000);

  set_skill("force", 500 + jibie / 3 + random(jibie / 5));
  set_skill("hunyuan-yiqi", 500 + jibie / 3 + random(jibie / 5));
  set_skill("dodge", 500 + jibie / 3 + random(jibie / 5));
  set_skill("xiuluo-dao", 500 + jibie / 3 + random(jibie / 5));
  set_skill("blade", 500 + jibie / 3 + random(jibie / 5));
  set_skill("shaolin-shenfa", 500 + jibie / 3 + random(jibie / 5));
  set_skill("unarmed", 500 + jibie / 3 + random(jibie / 5));
  set_skill("changquan", 500 + jibie / 3 + random(jibie / 5));
  set_skill("parry", 500 + jibie / 3 + random(jibie / 5));
  set_skill("literate", 500 + jibie / 3 + random(jibie / 5));
  map_skill("force", "hunyuan-yiqi");
  map_skill("dodge", "shaolin-shnfa");
  map_skill("unarmed", "changquan");
  map_skill("parry", "xiuluo-dao");
  map_skill("blade", "xiuluo-dao");
  prepare_skill("unarmed", "changquan");

  setup();
  carry_object("/clone/cloth/cloth")->wear();
  carry_object(__DIR__ "blade")->wield();
  add_money("silver", 50);
}
#include "/quest/guanfu/npc/npc.h"
