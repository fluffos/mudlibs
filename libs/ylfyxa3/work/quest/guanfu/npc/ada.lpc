//  ada 阿大

#include <ansi.h>
inherit NPC;
string random_name();

void create() {
  int jibie;
  jibie = 500;
  set("xyzx_sys/level", jibie);  //2016.5.22阿飞调整NPC属性
  set_name("阿大", ({ "a da" }));
  set("nickname", "八臂神剑");
  set("long",
    "原丐帮四大长老之首，剑术之精，名动江湖，据说出手极快。\n");
  set("gender", "男性");
  set("age", 66);
  set("attitude", "peaceful");
  set("shen_type", -1);
  set("str", 30);
  set("int", 30);
  set("con", 25);
  set("dex", 27);

  set("max_qi", 2500);
  set("max_jing", 2500);
  set("neili", 3500);
  set("max_neili", 3500);
  set("jiali", 100);
  set("combat_exp", 1800000 + random(900000));
  set("chat_chance_combat", 60);
  set("chat_msg_combat", ({
    (: perform_action, "sword.lianhuan" :),
    (: perform_action, "force.powerup" :)
  }));
  set_skill("force", 500 + jibie / 3 + random(jibie / 5));
  set_skill("canhe-zhi", 500 + jibie / 3 + random(jibie / 5));
  set_skill("dodge", 500 + jibie / 3 + random(jibie / 5));
  set_skill("murong-jianfa", 500 + jibie / 3 + random(jibie / 5));
  set_skill("parry", 500 + jibie / 3 + random(jibie / 5));
  set_skill("shaolin-shenfa", 500 + jibie / 3 + random(jibie / 5));
  set_skill("finger", 500 + jibie / 3 + random(jibie / 5));
  set_skill("shenyuan-gong", 500 + jibie / 3 + random(jibie / 5));
  set_skill("literate", 500 + jibie / 3 + random(jibie / 5));
  set_skill("sword", 500 + jibie / 3 + random(jibie / 5));

  map_skill("force", "shenyuan-gong");
  map_skill("dodge", "shaolin-shenfa");
  map_skill("finger", "canhe-zhi");
  map_skill("sword", "murong-jianfa");
  map_skill("parry", "murong-jianfa");

  prepare_skill("finger", "canhe-zhi");

  setup();
  carry_object("/clone/cloth/cloth")->wear();
  carry_object("/clone/weapon/changjian")->wield();
  add_money("gold", 1);
}
#include "/quest/guanfu/npc/npc.h"
