// jianghu xiaoxiao 江湖宵小
inherit NPC;
string random_name();

void create() {
  int jibie;
  jibie = 500;
  set("xyzx_sys/level", jibie);  //2016.5.22阿飞调整NPC属性
  set_name("江湖宵小", ({ "xiaohu xiaoxiao" }));
  //	set("nickname", "");
  set("long",
    "一个功夫不是很好，但是已经开始作恶江湖的小辈。\n"
    " 神态龌龊，让人讨厌。\n");
  set("gender", "男性");
  set("age", random(10) + 25);
  set("attitude", "peaceful");
  set("shen_type", -1);
  set("str", 25);
  set("int", 20);
  set("con", 25);
  set("dex", 27);

  set("max_qi", 500);
  set("max_jing", 400);
  set("neili", 700);
  set("max_neili", 700);
  set("jiali", 10);
  set("combat_exp", 75000 + random(40000));

  set_skill("force", 500 + jibie / 3 + random(jibie / 5));
  set_skill("xuantian-wuji", 500 + jibie / 3 + random(jibie / 5));
  set_skill("dodge", 500 + jibie / 3 + random(jibie / 5));


  set_skill("kunlun-shenfa", 500 + jibie / 3 + random(jibie / 5));
  set_skill("strike", 500 + jibie / 3 + random(jibie / 5));
  set_skill("parry", 500 + jibie / 3 + random(jibie / 5));
  set_skill("kunlun-zhang", 500 + jibie / 3 + random(jibie / 5));
  set_skill("literate", 500 + jibie / 3 + random(jibie / 5));
  map_skill("force", "xuantian-wuji");
  map_skill("dodge", "kunlun-shnfa");
  map_skill("strike", "kunlun-zhang");
  map_skill("parry", "kunlun-zhang");
  prepare_skill("strike", "kunlun-zhang");

  setup();
  carry_object("/clone/cloth/cloth")->wear();
  add_money("silver", 50);
}
#include "/quest/guanfu/npc/npc.h"
