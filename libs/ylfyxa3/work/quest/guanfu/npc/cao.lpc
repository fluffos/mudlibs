//  cao 曹化淳

inherit NPC;
string random_name();

void create() {
  int jibie;
  jibie = 500;
  set("xyzx_sys/level", jibie);  //2016.5.22阿飞调整NPC属性
  set_name("曹化淳", ({ "cao huachun" }));
  //	set("nickname", "");
  set("long",
    "原是朝廷的宦官，后来由于贪赃枉法，被朝廷查办的时候逃跑了。\n");
  set("gender", "无性");
  set("age", 37);
  set("attitude", "peaceful");
  set("shen_type", -1);
  set("str", 25);
  set("int", 20);
  set("con", 25);
  set("dex", 27);

  set("max_qi", 500);
  set("max_jing", 400);
  set("neili", 700);
  set("max_neili", 700);
  set("jiali", 10);
  set("combat_exp", 75000 + random(40000));

  set_skill("force", 500 + jibie / 3 + random(jibie / 5));
  set_skill("hunyuan-yiqi", 500 + jibie / 3 + random(jibie / 5));
  set_skill("dodge", 500 + jibie / 3 + random(jibie / 5));


  set_skill("shaolin-shenfa", 500 + jibie / 3 + random(jibie / 5));
  set_skill("strike", 500 + jibie / 3 + random(jibie / 5));
  set_skill("sword", 500 + jibie / 3 + random(jibie / 5));
  set_skill("parry", 500 + jibie / 3 + random(jibie / 5));
  set_skill("damo-jian", 500 + jibie / 3 + random(jibie / 5));
  set_skill("kunlun-zhang", 500 + jibie / 3 + random(jibie / 5));
  set_skill("literate", 500 + jibie / 3 + random(jibie / 5));
  map_skill("force", "hunyuan-yiqi");
  map_skill("dodge", "shaolin-shnfa");
  map_skill("strike", "kunlun-zhang");
  map_skill("parry", "damo-jian");
  prepare_skill("strike", "kunlun-zhang");

  setup();
  carry_object("/clone/cloth/cloth")->wear();
  carry_object("/clone/weapon/changjian")->wield();
  add_money("silver", 50);
}
#include "/quest/guanfu/npc/npc.h"
