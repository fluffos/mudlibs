// huangxu daoren 黄须道人
inherit NPC;
string random_name();

void create() {
  int jibie;
  jibie = 500;
  set("xyzx_sys/level", jibie);  //2016.5.22阿飞调整NPC属性
  set_name("黄须道人", ({ "huangxu daoren" }));
  //	set("nickname", "");
  set("long",
    "武当的叛徒，为人奸诈，常常干些坏事。\n");
  set("gender", "男性");
  set("age", 35);
  set("attitude", "peaceful");
  set("shen_type", -1);
  set("str", 25);
  set("int", 20);
  set("con", 25);
  set("dex", 27);

  set("max_qi", 500);
  set("max_jing", 400);
  set("neili", 700);
  set("max_neili", 700);
  set("jiali", 10);
  set("combat_exp", 75000 + random(40000));

  set("chat_chance_combat", 60);
  set("chat_msg_combat", ({
    (: perform_action, "sword.ren" :),
  }));
  set_skill("force", 500 + jibie / 3 + random(jibie / 5));
  set_skill("taiji-shengong", 500 + jibie / 3 + random(jibie / 5));
  set_skill("dodge", 500 + jibie / 3 + random(jibie / 5));
  set_skill("tiyunzong", 500 + jibie / 3 + random(jibie / 5));
  set_skill("unarmed", 500 + jibie / 3 + random(jibie / 5));
  set_skill("taiji-quan", 500 + jibie / 3 + random(jibie / 5));
  set_skill("parry", 500 + jibie / 3 + random(jibie / 5));
  set_skill("sword", 500 + jibie / 3 + random(jibie / 5));
  set_skill("liangyi-jian", 500 + jibie / 3 + random(jibie / 5));
  set_skill("taiji-jian", 500 + jibie / 3 + random(jibie / 5));
  set_skill("literate", 500 + jibie / 3 + random(jibie / 5));

  map_skill("force", "taiji-shengong");
  map_skill("dodge", "tiyunzong");
  map_skill("unarmed", "taiji-quan");
  map_skill("parry", "liangyi-jian");
  map_skill("sword", "liangyi-jian");

  setup();
  carry_object("/clone/cloth/cloth")->wear();
  add_money("silver", 50);
}
#include "/quest/guanfu/npc/npc.h"
