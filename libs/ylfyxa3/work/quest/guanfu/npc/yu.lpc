// yu 玉真子

inherit NPC;
string random_name();

void create() {
  int jibie;
  jibie = 500;
  set("xyzx_sys/level", jibie);  //2016.5.22阿飞调整NPC属性
  set_name("玉真子", ({ "yuzhen zi" }));
  //	set("nickname", "八臂神剑");
  set("long",
    "铁剑门的叛徒，极其好色，虽是武林败类，但是一身功夫早就出神入化。\n");
  set("gender", "男性");
  set("age", 66);
  set("attitude", "peaceful");
  set("shen_type", -1);
  set("str", 35);
  set("int", 30);
  set("con", 25);
  set("dex", 27);
  set("per", 10);
  set("eff_jingli", 2000);
  set("max_qi", 2500);
  set("max_jing", 2500);
  set("neili", 8000);
  set("max_neili", 8000);
  set("jiali", 150);
  set("combat_exp", 1200000 + random(900000));
  set("chat_chance_combat", 60);
  set("chat_msg_combat", ({
    (: exert_function, "recover" :),
    (: perform_action, "strike.ju" :),
    (: perform_action, "strike.ju" :),
    (: perform_action, "sword.ding" :),
    (: perform_action, "sword.sanqing" :),
    (: perform_action, "sword.tonggui" :),
  }));

  set_skill("force", 500 + jibie / 3 + random(jibie / 5));
  set_skill("xiantian-qigong", 500 + jibie / 3 + random(jibie / 5));    //先天气功
  set_skill("sword", 500 + jibie / 3 + random(jibie / 5));
  set_skill("quanzhen-jianfa", 500 + jibie / 3 + random(jibie / 5));  //全真剑
  set_skill("dodge", 500 + jibie / 3 + random(jibie / 5));
  set_skill("jinyan-gong", 500 + jibie / 3 + random(jibie / 5));   //金雁功
  set_skill("parry", 500 + jibie / 3 + random(jibie / 5));
  set_skill("unarmed", 500 + jibie / 3 + random(jibie / 5));
  set_skill("haotian-zhang", 500 + jibie / 3 + random(jibie / 5));    //昊天掌
  set_skill("literate", 500 + jibie / 3 + random(jibie / 5));
  set_skill("strike", 500 + jibie / 3 + random(jibie / 5));
  set_skill("taoism", 500 + jibie / 3 + random(jibie / 5));

  map_skill("force", "xiantian-qigong");
  map_skill("sword", "quanzhen-jianfa");
  map_skill("dodge", "jinyan-gong");
  map_skill("parry", "quanzhen-jianfa");
  map_skill("strike", "haotian-zhang");
  prepare_skill("strike", "haotian-zhang");

  setup();
  carry_object("/clone/cloth/cloth")->wear();


}
#include "/quest/guanfu/npc/npc.h"
