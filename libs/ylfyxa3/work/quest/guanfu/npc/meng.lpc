//  meng 孟正鹏

inherit NPC;
string random_name();

void create() {
  int jibie;
  jibie = 500;
  set("xyzx_sys/level", jibie);  //2016.5.22阿飞调整NPC属性
  set_name("孟正鹏", ({ "meng zhengpeng" }));
  set("nickname", "五凤刀掌门");
  set("long",
    "五凤刀的掌门，一身刀法传说甚为了得。\n");
  set("gender", "男性");
  set("age", 52);
  set("attitude", "peaceful");
  set("shen_type", -1);
  set("str", 25);
  set("int", 20);
  set("con", 25);
  set("dex", 27);

  set("max_qi", 1200);
  set("max_jing", 1200);
  set("neili", 1500);
  set("max_neili", 1500);
  set("jiali", 20);
  set("combat_exp", 480000);

  set_skill("force", 500 + jibie / 3 + random(jibie / 5));
  set_skill("hunyuan-yiqi", 500 + jibie / 3 + random(jibie / 5));
  set_skill("dodge", 500 + jibie / 3 + random(jibie / 5));


  set_skill("shaolin-shenfa", 500 + jibie / 3 + random(jibie / 5));
  set_skill("unarmed", 500 + jibie / 3 + random(jibie / 5));
  set_skill("blade", 500 + jibie / 3 + random(jibie / 5));
  set_skill("changquan", 500 + jibie / 3 + random(jibie / 5));
  set_skill("parry", 500 + jibie / 3 + random(jibie / 5));
  set_skill("xiuluo-dao", 500 + jibie / 3 + random(jibie / 5));
  set_skill("literate", 500 + jibie / 3 + random(jibie / 5));
  map_skill("force", "hunyuan-yiqi");
  map_skill("dodge", "shaolin-shnfa");
  map_skill("unarmed", "changquan");
  map_skill("parry", "xiuluo-dao");
  map_skill("blade", "xiuluo-dao");
  prepare_skill("unarmed", "changquan");

  setup();
  carry_object("/clone/cloth/cloth")->wear();
  carry_object(__DIR__ "blade")->wield();
  add_money("silver", 20);
}
#include "/quest/guanfu/npc/npc.h"
