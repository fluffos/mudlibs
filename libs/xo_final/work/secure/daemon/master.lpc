    return 1;
}

// valid_write: write privileges; called with the file name, the object
//   initiating the call, and the function by which they called it. 
int valid_write(string file, mixed user, string func)
{
    object ob;

    if (objectp(user))
    {
        string base = base_name(user);

        if (base == MASTER_OB || base == SIMUL_EFUN_OB || base == SECURITY_D)
            return 1;
    }
    if (!catch(ob = load_object(SECURITY_D)) && objectp(ob))
        return (int) SECURITY_D->valid_write(file, user, func);

    return 0;
}

// valid_read: read privileges; called exactly the same as valid_write()
int valid_read(string file, mixed user, string func)
{
    object ob;

    if (objectp(user))
    {
        string base = base_name(user);

        if (base == MASTER_OB || base == SIMUL_EFUN_OB || base == SECURITY_D)
            return 1;
    }
    if (!catch(ob = load_object(SECURITY_D)) && objectp(ob))
        return (int) SECURITY_D->valid_read(file, user, func);

    return 1;
}

int valid_bind(object binder, object old_owner, object new_owner)
{
    if (geteuid(binder) == ROOT_UID)
        return 1;
    if (old_owner && geteuid(old_owner) == ROOT_UID)
        return 1;
    if (binder == new_owner)
        return 1;
    if (!userp(new_owner) && clonep(new_owner))
        return 1;

    log_file("bind", sprintf("%O attempts to bind %O's function to %O\n",
                             binder, old_owner, new_owner));
    return 0;
}


// ------------------- Parser package api ------------------
// by nerd 2001
// 介词列表
string *parse_command_prepos_list()
{
    return ({ "in", "with", "without", "into", "for", "on", "under", "against",
           "out", "within", "of", "from", "between", "at", "to", "over", "near",
            "inside", "onto", "off", "through", "across", "up", "down",
            "around", "about"
        });
}

// return a list of nouns (names) that apply to all objects in existence
string* parse_command_id_list()
{
    return ({ "thing" });
}

// what is "all"
string parse_command_all_word()
{
    return "all";
}

// return a list of adjectives that apply to all objects in existence
string *parse_command_adjectiv_id_list()
{
    return ({ "the", "a", "an" });
}

// return a list of plurals that match any object in existence
string* parse_command_plural_id_list()
{
    return ({ "things", "them", "everything" });
}

// return a list of living objects that can be refered to by commands that match remote living objects. 
object *parse_command_users()
{
    return filter( users(), (: environment($1) :) );
}

// error message
string parser_error_message(int type, object ob, mixed arg, int flag)
{
    string err;

    if (ob)
        err = (string) ob->name();
    else
        err = "";
    switch (type)
    {
    case ERR_IS_NOT:
        err = "这里没有" + arg + "。";
        break;
    case ERR_NOT_LIVING:
        err = "看清楚点，" + arg + "不是活的。";
        break;
    case ERR_NOT_ACCESSIBLE:
        err = "你无法做到这件事。。。";
        break;

    case ERR_AMBIG:
        err = "你说得是哪一个" + arg[0]->name() + "？";

    case ERR_ORDINAL:
        // nerd: 这个好像是多个中选一个
        return "你说的是" + chinese_number(sizeof(arg)) + 
            arg[0]->query("unit") + arg[0]->name() +
            "中的哪一个？(比如，1st, 2nd, 3rd, 4th...)";
        /*
        if (sizeof(arg) > 1)
            err = "这里只有" + chinese_number(sizeof(arg)) + "个。";
        else
            err = "There is only one of them.";
        break;
        */

    case ERR_ALLOCATED:
        return arg;

    case ERR_THERE_IS_NO:
        return "这里并没有" + arg + "。";

    case ERR_BAD_MULTIPLE:
        return "You can't do that to more than one at a time.";

    case ERR_MANY_PATHS:
        return "many pathes.";
    }
    return err;
}
