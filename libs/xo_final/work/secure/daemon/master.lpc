varargs string standard_trace(mapping err, int flag)
{
    string ret;
    mapping *trace;
    int i, n;

    ret = err["error"] +
        sprintf("物件: %O，在 %s 的第 %d 行。\n",
                err["object"], err["program"], err["line"]);

    trace = err["trace"];

    ret += "函数调用堆栈：\n";
    for (i = 0, n = sizeof(trace); i < n; i++)
    {
        if (flag)
            ret += sprintf("#%d: ", i);

        ret +=
            sprintf("%-25s%s:%d\n", trace[i]["function"] + "()",
                    trace[i]["program"], trace[i]["line"]);
        /*
           trace_line( trace[i]["object"],
           trace[i]["program"],
           trace[i]["file"],
           trace[i]["line"] ) ); */
    }
    return ret;
}

string error_handler(mapping err, int caught)
{
    string ret, logfile;

    // try to distinguish between different types of errors
    ret = "---\n" + standard_trace(err);
    if (caught)
    {
        logfile = LOG_DIR "catch";
    }
    else
    {
        if (err["object"])
        {
            string *piece = explode(file_name(err["object"]), "/");

            logfile = LOG_DIR "runtime/" + piece[0];
        }
        else
            logfile = LOG_DIR "runtime/runtime";
    }

    write_file(logfile, ret);

    // let the player know an error occurred
    if (this_player())
    {
        message("error",
                sprintf("运行时发生错误：%s错误信息被写到：%s\n",
                        err["error"], logfile), this_player());
        //this_player()->set_error( err );
    }
    if (!caught)                // if caught, don't disturb other wiz.
    {
        string env = "无";
        if (this_player())
            env = sprintf("%O", environment(this_player()));
        CHANNEL_D->do_channel(this_object(), "sys",
                              sprintf("运行时发生错误：%s 物件: %O，在 %s 的第 %d 行。"
                               "当前用户: %O, 所在位置: %O, 函数调用堆栈已写入文件： %s",
                               err["error"][0..<2], err["object"],
                               err["program"], err["line"], this_player(),
                               env, logfile));
    }

    // whatever we return goes to the debug.log (in this case, nothing)
    return 0;
}

// Write an error message into a log file. The error occured in the
// object 'file', giving the error message 'message'.
void log_error(string file, string message)
{
    string name, home;

    if (find_object(SIMUL_EFUN_OB))
        name = file_owner(file);

    if (name)
        home = user_path(name);
    else
        home = LOG_DIR;

    if (this_player(1) && wizardp(this_player(1)))
        efun::write("编译时发生错误: " + message);

    message = "[" + ctime(time())[4..18] + "] " + message;
    efun::write_file(home + "log", message);
}

// valid_shadow: controls whether an object may be shadowed or not
int valid_shadow(object ob)
{
    return 0;
}

// valid_override: controls which simul_efuns may be overridden with
//   efun:: prefix and which may not.  This function is only called at
//   object compile-time
int valid_override(string file, string name)
{
    // simul_efun can override any simul_efun by Annihilator
    if (file == SIMUL_EFUN_OB || file == MASTER_OB)
        return 1;

    // Must use the move() defined in F_MOVE.
    if (((name == "move_object") || (name == "destruct")) && (file != F_MOVE))
    {
        log_error("override",
                  sprintf("%s attempts to override %s(), denied.\n", file,
                          name));
        return 0;
    }

    //  may also wish to protect shutdown, snoop, and exec.
    return 1;
}

