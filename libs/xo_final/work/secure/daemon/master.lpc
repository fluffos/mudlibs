// This is called when there is a driver segmentation fault or a bus error,
// etc.  As it's nosave it can't be called by anything but the driver (and
// master).

private void crash(string err, object cmd_giver, object cur_obj)
{
    log_file("crashes", mud_name() + " CRASHED on: " + ctime(time()) +
             " ERROR: " + err + "\n");
    efun::shout("泥巴精灵发出一声惨叫：哇─哩─咧─\n");
    efun::shout("这个世界要覆灭了，你又要回到现实中了，自己保重吧！\n");

    //  idea from MudOS's testsuite
    if (objectp(cmd_giver))
    {
        if (stringp(cmd_giver->query("id")))
        {
            string temp;

            temp = sprintf("this_player %s\n", cmd_giver->query("id"));
            log_file("crashes", temp);
        }
        else
            log_file("crashes",
                     "this_player: " + file_name(cmd_giver) + "\n");
    }
    if (cur_obj)
        log_file("crashes", "this_object: " + file_name(cur_obj) + "\n");

    //  Added by Inspiral with ideas from Wirehead..hopefully this will 
    //    prevent MudOS to save users if the filesystem is full.
//    write_file( TMP_DIR "MudOS_crash", "abcdefg" );
//    if ( file_size( TMP_DIR "MudOS_crash" ) )
//    {
//        rm( TMP_DIR "MudOS_crash" );
//        SHUTDOWN_D->do_shutdown( 0 );
//    }
}

