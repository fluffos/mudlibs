void cat( string file )
{
    if ( this_player() )
    {
        message("write", read_file(file), this_player());
    }
}

void assure_file(string file)
{
    string path, *dir;
    int i;

    if ( !stringp(file) )
    {
        return;
    }

    if ( file_size( file ) != -1 )
    {
        return;
    }

    seteuid(ROOT_UID);

    dir = explode(file, "/");
    dir = dir[0..sizeof(dir)-2];
    path = "/";

    for ( i = 0; i < sizeof( dir ); i++ )
    {
        path += dir[i];
        mkdir(path);
        path += "/";
    }
}

void log_file(string file, string text)
{
    assure_file(LOG_DIR + file);
    write_file(LOG_DIR + file, text);
}

string base_name(object ob)
{
    string file;

    if ( !ob )
    {
        return 0;
    }

    if ( sscanf(file_name(ob), "%s#%*d", file) == 2 )
    {
        return file;
    }

    return file_name(ob);
}

//用来返回不带目录的文件名--(by lnwm)
string sin_name(object ob)
{
    string file, *dir;

    dir = explode( base_name(ob), "/" );
    file = dir[sizeof(dir)-1];
    return file;
}

int file_exists(string file)
{
    return (file_size(file) > 0) || (file_size(file + ".lpc") > 0);
}

int is_c_file(string arg)
{
    int l;

    l = strlen(arg);

    if ( arg[l - 1] == 'c' && arg[l - 2] == '.' )
    {
        return 1;
    }

    return 0;
}

