//#include <config.h>

//  File    :  /adm/simul_efun/system.c
//
//  This file contains simul_efuns used to account for driver efuns
//  that were made into system defines at MudOS 0.9.16+ release.

#include <mudlib.h>

#ifdef __VERSION__
// new, as of 0.9.17.9

string version() {
  return __VERSION__;
}

string arch() {
  return __ARCH__;
}
#else
#ifdef MUDOS_VERSION
// this stuff appeared until 0.9.17.8 (inclusive)

string version() {
  return MUDOS_VERSION;
}
string arch() {
  return MUDOS_ARCH;
}
#else
#ifdef VERSION
// this stuff appeared briefly in one or two versions

string version() {
  return VERSION;
}
string arch() {
  return ARCH;
}
#endif // VERSION
#endif // MUDOS_VERSION
#endif // __VERSION__

#ifdef MUD_NAME
string mud_name() {
  return MUD_NAME;
}
#endif

#ifdef __PORT__
int mud_port() {
  return __PORT__;
}
#else
#ifdef MUD_PORT
int mud_port() {
  return MUD_PORT;
}
#endif // MUD_PORT
#endif

// These are defined in mudlib.h
string mudlib_name() {
  return (MUDLIB_NAME);
}
string mudlib_version() {
  return (MUDLIB_VERSION_NUMBER);
}

private int system_type = 0;

int system_type() {
  if (0 == system_type) {
    int temp = 2147483648;

    temp++;

    if (0 < temp) {
      system_type = SYSTEM_64BIT;
    } else {
      system_type = SYSTEM_32BIT;
    }
  }

  return system_type;
}

varargs mixed system_call(mixed func_64, mixed func_32, mixed args_64, mixed args_32) {
  switch (system_type()) {
    case SYSTEM_64BIT:
      if (!functionp(func_64)) {
        return args_64;
      }
      return evaluate(func_64, args_64);
      break;

    case SYSTEM_32BIT:
    default:
      if (!functionp(func_32)) {
        return args_32;
      }
      return evaluate(func_32, args_32);
      break;
  }

  return 0;
}

int system_maxint() {
  return (int)system_call(
    0,
    0,
    ATTRIBUTE_D->max_int(SYSTEM_64BIT),
    ATTRIBUTE_D->max_int(SYSTEM_32BIT)
  );
}

int system_maxmoney() {
  return system_maxint();
}

int system_maxexp() {
  return system_maxint();
}
