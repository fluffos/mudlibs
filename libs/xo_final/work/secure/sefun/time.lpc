#include <localtime.h>

int query_year()
{
    return localtime(time())[LT_YEAR] + 1;
}

int query_month()
{
    return localtime(time())[LT_MON] + 1;
}

int query_day()
{
    return localtime(time())[LT_MDAY] * 3 + 1;
}

int query_shichen()
{
    return localtime(time())[LT_HOUR];
}

int query_quarter()
{
    return localtime(time())[LT_MIN] + 1;
}

int query_second()
{
    return localtime(time())[LT_SEC];
}

int query_season()
{
    int mon = query_month();

    if ( mon == 1 || mon == 2 )
    {
        return 4;
    }
    else
    {
        return mon / 3;
    }
}

