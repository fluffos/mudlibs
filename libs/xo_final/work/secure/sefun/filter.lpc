#define USER_DIR    DATA_DIR "user/"
#define TEMP_OB     CLONE_DIR "user/temp"

varargs mixed *filter_candidate(mixed arg1, mixed arg2, int amount)
{
    mixed *TopTen = ({});
    object *candidates = ({});
    function user_cond, comp_cond;

    if (functionp(arg1) && functionp(arg2))
    {
        user_cond = arg1;
        comp_cond = arg2;
        if (!amount)
        {
            amount = 10;
        }
    }
    else
    {
        return 0;
    }

    message("system", "\n 整理玩家存档中，请稍候...\n", users());

    foreach(string id in evaluate(
        function()
        {
            string * all_id;
            all_id = ({ });
            foreach(string dir in get_dir(USER_DIR))
            {
                all_id += get_dir(USER_DIR + dir + "/*" + __SAVE_EXTENSION__);
            }
            return all_id;
        }))
    {
        object user;

        if ( id[<2..] == __SAVE_EXTENSION__ )
        {
            id = id[0.. < 3];
        }
        else
        {
            id = id;
        }

        if (id == "Root")
        {
            continue;
        }

        user = new(TEMP_OB, id);
        user->restore();
        tell_wizard("trill", sprintf("%s", user->query("id")));
        tell_wizard("trill", sprintf("%s", user->query("name")));
        tell_wizard("trill", sprintf("%s", getuid(user)));
        if (evaluate(user_cond, user))
        {
            candidates += ({ user });
        }
        else
        {
            destruct(user);
        }
    }
    printf("candidates : %O", candidates);

    if ( sizeof(candidates) )
    {
        candidates = sort_array(candidates, comp_cond);
    }
    printf("candidates : %O", candidates);

    for (int i = 0; i < sizeof(candidates); i++)
    {
        if (i >= amount)
        {
            destruct(candidates[i]);
        }
        else
        {
            TopTen[i] = candidates[i];
        }
    }
    return TopTen;
}

