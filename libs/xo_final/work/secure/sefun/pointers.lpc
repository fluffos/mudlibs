// prototypes :)
int high_mortalp(mixed);
int avatarp(mixed);

int newbiep(mixed ob)
{
    if ( !objectp(ob) || !userp(ob) || wizardp(ob) )
    {
        return 0;
    }
    if (ob->query("age") < 17)
    {
        return 1;
    }
    if (ob->query("age") < 18 && ob->query("combat_exp") < 1000)
    {
        return 1;
    }

    return 0;
}

int playerp(mixed ob)
{
    if ( stringp(ob) )
    {
        ob = find_player(ob);
    }

    if ( ! ob || ! userp(ob) )
    {
        return 0;
    }

    return ( !wizardp(ob) && !avatarp(ob) && !high_mortalp(ob) );
}

int high_mortalp(mixed ob)
{
    if ( stringp(ob) )
    {
        ob = find_player(ob);
    }

    if ( ! ob || !userp(ob) )
    {
        return 0;
    }

    return ( ob->query("high_mortal") ? 1 : 0 );
}

int avatarp(mixed ob)
{
    return USER_D->is_avatar(ob);
}

int appp(mixed ob)
{
    return SECURITY_D->get_wiz_level(ob) > 0;
}

int archp(mixed ob)
{
    return SECURITY_D->get_wiz_level(ob) > 1;
}

int adminp(mixed ob)
{
    return SECURITY_D->get_wiz_level(ob) > 2; //admin's level is 3
}

