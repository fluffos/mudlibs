#include <ansi.h>

//把价值转化成以金银计量的中文价值的函数。value：要转换的价值数。
string PriceString(int value) {
  int gold_v, silver_v;
  string msg;

  if (!value) {
    return "";
  }

  gold_v = value / 10000;
  value -= gold_v * 10000;
  silver_v = value / 1000;
  value -= silver_v * 1000;

  if (gold_v) {
    msg = chinese_number(gold_v) + "两" + YEL "黄金" NOR;
  }

  if (silver_v) {
    if (msg) {
      msg = msg + chinese_number(silver_v) + "两" + WHT "白银" NOR;
    } else {
      msg = chinese_number(silver_v) + "两" + WHT "白银" NOR;
    }
  }

  if (value) {
    if (msg) {
      msg = msg + chinese_number(value) + "文" + YEL "铜钱" NOR;
    } else {
      msg = chinese_number(value) + "文" + YEL "铜钱" NOR;
    }
  }

  return msg;
}

void PayPlayer(object ppl, int amount)    //这是给player付钱的函数了。
{
  object ob;

  seteuid(getuid());
  seteuid(geteuid());

  if (amount < 1) {
    amount = 1;
  }

  if (amount / 1000000) {
    ob = new(MONEY_DIR "thousand-cash");
    ob->set_amount(amount / 1000000);
    ob->move(ppl);
    amount %= 1000000;
  }

  if (amount / 10000) {
    ob = new(MONEY_DIR "gold");
    ob->set_amount(amount / 10000);
    ob->move(ppl);
    amount %= 10000;
  }

  if (amount / 1000) {
    ob = new(MONEY_DIR "silver");
    ob->set_amount(amount / 1000);
    ob->move(ppl);
    amount %= 1000;
  }

  if (amount) {
    ob = new(MONEY_DIR "coin");
    ob->set_amount(amount);
    ob->move(ppl);
  }
}
