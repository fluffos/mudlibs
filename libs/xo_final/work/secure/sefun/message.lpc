varargs void message_vision2(string msg, object me, object you) {
  string my_gender, your_gender, my_name, your_name;
  string str1, str2, str3;

  my_name = me->name();
  my_gender = me->query("gender");
#ifdef DEBUG
  printf("my name is %O, my_gender is %O\n", my_name, my_gender);
#endif
  str1 = replace_string(msg, "$P", gender_self(my_gender));
  str1 = replace_string(str1, "$N", gender_self(my_gender));
  str1 = replace_string(str1, "$F", RANK_D->query_respect(me));
  str1 = replace_string(str1, "$f", RANK_D->query_rude(me));
  str3 = replace_string(msg, "$P", my_name);
  str3 = replace_string(str3, "$N", my_name);
  str3 = replace_string(str3, "$F", RANK_D->query_respect(me));
  str3 = replace_string(str3, "$f", RANK_D->query_rude(me));

  if (you) {
    your_name = you->name();
    your_gender = you->query("gender");
    str2 = replace_string(msg, "$P", gender_pronoun(my_gender));
    str2 = replace_string(str2, "$p", gender_self(your_gender));
    str2 = replace_string(str2, "$N", my_name);
    str2 = replace_string(str2, "$n", gender_self(your_gender));
    str2 = format_string(str2);
    message("vision", format_string(str2), you);
    str1 = replace_string(str1, "$p", gender_pronoun(your_gender));
    str1 = replace_string(str1, "$n", your_name);
    str3 = replace_string(str3, "$p", your_name);
    str3 = replace_string(str3, "$n", your_name);
  }

  //    str1 = blocked_msg(str1, 60);
  //    str3 = blocked_msg(str3, 60);
  str1 = format_string(str1);
  str2 = format_string(str3);
  message("vision", str1, me);
  message("vision", str3, environment(me), ({ me, you }));
}

string sort_msg(string input) {
  int i;
  int sl;
  int len;
  int esc;
  string result;
  result = "";

  len = 0;
  esc = 0;
  sl = strlen(input);

  for (i = 0; i < sl; i++) {
    if (len >= 64 && input[i] != '\n') {
      switch (input[i..i + 1]) {
        case "：":
        case "”":
        case "。":
        case "，":
        case "、":
        case "；":
        case "）":
        case " )":
        case "！":
        case "？":
          break;

        default:
          len = 0;
          result += "\n";
          break;
      }
    }

    if (input[i] == 27) {
      esc = 1;
    }

    if (!esc) {
      if (input[i] > 160) {
        result += input[i..i + 1];
        i++;
        len += 2;
        continue;
      }

      if (input[i] == '\n') {
        result += "\n";
        len = 0;
        continue;
      }
    }

    result += input[i..i];

    if (!esc) {
      len++;
    }

    if (esc && input[i] == 'm') {
      esc = 0;
    }
  }

  if (i < sl) {
    result += input[i..sl - 1];
  }

  return result;
}

varargs void message_sort(string msg, object me, object you) {
  string my_gender, your_gender, my_name, your_name;
  string str1, str2, str3;

  if (!objectp(me) || !environment(me)) {
    return;
  }

  my_name = me->name();
  my_gender = me->query("gender");
  str1 = replace_string(msg, "$P", gender_self(my_gender));
  str1 = replace_string(str1, "$N", gender_self(my_gender));
  str3 = replace_string(msg, "$P", my_name);
  str3 = replace_string(str3, "$N", my_name);

  if (you) {
    your_name = you->name();
    your_gender = you->query("gender");
    str2 = replace_string(msg, "$P", gender_pronoun(my_gender));
    str2 = replace_string(str2, "$p", gender_self(your_gender));
    str2 = replace_string(str2, "$N", my_name);
    str2 = replace_string(str2, "$n", gender_self(your_gender));
    message("vision", sort_msg(str2), you);
    str1 = replace_string(str1, "$p", gender_pronoun(your_gender));
    str1 = replace_string(str1, "$n", your_name);
    str3 = replace_string(str3, "$p", your_name);
    str3 = replace_string(str3, "$n", your_name);
  }

  message("vision", sort_msg(str1), me);
  message("vision", sort_msg(str3), environment(me), ({ me, you }));
}

void tell_team(object *obs, string str) {
  foreach (object ob in obs) {
    tell_object(ob, str);
  }
}
