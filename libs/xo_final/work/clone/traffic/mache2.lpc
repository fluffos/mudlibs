// mache2.c
// mid-mache
inherit ROOM;

void get_dest(object me);

string *run_msg = ({
  "那马车夫想是有些烦恼，不时的唉声叹气。\n",
  "你临窗望去，只见路旁山壁陡峭，极是险峻。\n",
  "不知怎的，你突然想起了别人说过这条路上强盗很多，不禁有些担心...\n",
  "你静静坐在车厢里，只感觉车身不住向前移动，速度极快。\n",
  "那车夫想是路上寂寞得慌了，轻轻哼起一首曲子来...\n",
});

int times = 10;



void create() {
  set("short", "马车");
  set("long", @LONG
这是一辆普普通通的马车，车内摆设着一张稍稍有些破旧的座椅，铺着一个
青色坐垫，倒还比较舒适，但想要睡觉是不可能了。车夫是个中年汉子，驾驭着
两匹骏马，在驿道上驶的四平八稳。透过车上的帘子可以看到外面的景物在飞速
地向后退。
LONG);
  set("refuse_npc", 1);
  set("no_quit", 1);
  set("no_save", 1);
  set("not_startroom", 1);
  set("no_fight", 1);

  set("exits", ([]));
  setup();
}

void init() {
  object ob;
  if (interactive(ob = this_player()))
    call_out("start_run", 1, ob);
  add_action("do_getoff", "getoff");
}

void start_run(object ob) {
  if (!ob) {
    destruct(this_object());
  } else {
    tell_object(ob, "只听马车夫吆喝了一声，长鞭一甩，马车缓缓地动了起来...\n");
    call_out("is_running", 5, ob);
  }
}

void is_running(object me) {
  if (!me) {
    destruct(this_object());
  } else if (times > 0) {
    if (random(10) > 3)
      tell_object(me, run_msg[random(sizeof(run_msg))]);
    times--;
    call_out("is_running", 5, me, times);
  } else {
    tell_object(me, "马车终于缓缓地停了下来，车夫叫道：" +
      RANK_D->query_respect(me) + "，" + query("dest") +
      "\n已经到了，下车（ｇｅｔｏｆｆ）吧。\n");
    call_out("send_out", 10, me);
  }
}

int do_getoff(string arg) {
  object me;
  me = this_player();

  if (!me->can_act() || times)
    return notify_fail("你现在无法下车。\n");

  tell_object(me, "你从座位上站起来，拉开车门，走了下去。\n");
  get_dest(me);
  return 1;
}

void send_out(object me) {
  if (!me || this_object() != environment(me)) {
    destruct(this_object());
    return;
  } else {
    tell_object(me, "那车夫等得不耐烦了，一把将你推下车，嘴里还咒骂着：\n"
      "这么慢，我还要去作生意呢！\n");
    get_dest(me);
  }
}

void get_dest(object me) {
  string dest, room;
  int i;
  object *things;
  dest = query("dest");

  switch (dest) {
    case "大理": room = "/d/city/dali/renhe";
    break;
    case "兰州": room = "/d/city/lanzhou/renhe";
    break;
    case "扬州": room = "/d/city/yangzhou/renhe";
    break;
    case "汴京": room = "/d/city/capital/renhe";
    break;
    case "杭州": room = "/d/city/hangzhou/renhe";
    break;
    case "高昌": room = "/d/city/gaochang/renhe";
    break;
    case "峨嵋": room = "/d/menpai/emei/renhe";
    break;
  }
  me->move(room);
  tell_room(find_object(room), me->name() + "从马车里走了下来。\n", me);
  // add by xli 1999.4.8
  things = all_inventory(this_object());
  for (i = 0; i < sizeof(things); i++) {
    things[i]->move(room);
  }
  if (sizeof(things) > 0) {
    tell_room(find_object(room), me->name() + "怎么在马车上乱丢东西啊？这样会污染环境的！\n", me);
    tell_object(me, "你怎么在马车上乱丢东西啊？这样会污染环境的！\n");
  }
  // end
  tell_object(me, "只见那车夫又将马车赶着向后面去了....\n");
  destruct(this_object());
}
