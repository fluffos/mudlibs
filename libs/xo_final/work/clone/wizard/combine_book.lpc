#include <ansi.h>

inherit ITEM;

void create() {
  set_name(HIY "《技能" HIM "合成" HIW "卷轴》" NOR, ({ "skill book", "book", "juanzhou" }));
  set_weight(600);

  if (clonep()) {
    set_default_object(__FILE__);
  } else {
    set("unit", "本");
    set("long",
      "这本书的纸张都已经泛黄了，看上去相当破旧。\n可使用look "
      +query("id") + "、write 序号 技能、combine " + query("id") + "。\n");
    set("value", 0);
    set("no_sell", 1);
    set("no_put", 1);
    set("no_give", 1);
    set("no_drop", 1);
    set("no_steal", 1);
    set("material", "silk");
  }
}

void init() {
  object who = this_player();

  add_action("look_book", "look");
  add_action("write_skill", "write");
  add_action("combine_skill", "combine");
}

int look_book(string arg) {
  mapping skill_map;
  int i;
  string index;

  if (arg != query("id")) {
    return 0;
  }

  skill_map = query("skill");
  if (!skill_map || !mapp(skill_map)) {
    write("没有记录任何技能。\n");
    return 1;
  }

  for (i = 1; i < sizeof(skill_map) + 1; i++) {
    index = "" + i;
    write(HIC + i + NOR + "号技能: " + HIY + to_chinese(skill_map[index]) + NOR + "\n");
  }

  return 1;
}

int write_skill(string arg) {
  int index;
  string skill;
  string type1, type2;
  object me = this_player();

  if (sscanf(arg, "%d %s", index, skill) != 2) {
    return 0;
  }

  if (index <= 0 || index > 9) {
    write("用法: write 序号 技能\n");
    return 1;
  }

  if (file_size(SKILL_D(skill) + ".lpc") == -1) {
    write("没有这门武功。\n");
    return 1;
  }

  if (me->query_jibie(skill) < 300) {
    write("300级才能合并。\n");
    return 1;
  }

  if (SKILL_D(skill)->query_dengji() != index) {
    write("必须按照顺序设置。\n");
    return 1;
  }

  if (!query("skill")) {
    if (1 != index) {
      write("必须按照顺序设置。\n");
      return 1;
    }

    set("skill/" + index, skill);
    write("Ok。\n");
    return 1;
  }

  if (1 == index) {
    set("skill/" + index, skill);
    write("Ok。\n");
    return 1;
  }

  if (!query("skill/" + (index - 1))) {
    write("必须按照顺序设置。\n");
    return 1;
  }

  type1 = SKILL_D(query("skill/" + (index - 1)))->query_xiuwei_type();
  type2 = SKILL_D(skill)->query_xiuwei_type();
  if (type1 != type2) {
    write("只能合成同类技能。\n");
    return 1;
  }

  if (query("skill/" + index)) {
    set("skill/" + index, skill);
    write("Ok。\n");
    return 1;
  }

  set("skill/" + index, skill);
  write("Ok。\n");
  return 1;
}

int combine_skill(string arg) {
  object me = this_player();
  mapping skill_map;
  int i;
  string index;
  string type;

  if (arg != query("id")) {
    return 0;
  }

  skill_map = query("skill");
  if (!skill_map || !mapp(skill_map)) {
    write("没有记录任何技能。\n");
    return 1;
  }

  if (9 > sizeof(skill_map)) {
    write("设置技能数量不足。\n");
    return 1;
  }

  type = SKILL_D(skill_map["1"])->query_xiuwei_type();

  for (i = 2; i < sizeof(skill_map) + 1; i++) {
    index = "" + i;
    if (type != SKILL_D(skill_map[index])->query_xiuwei_type()) {
      write(HIC + i + NOR + "号技能: " + HIY + to_chinese(skill_map[index]) + NOR + "修为不符合。\n");
      return 1;
    }

    type = SKILL_D(skill_map[index])->query_xiuwei_type();
  }

  message_vision(HIG "$N暗运内力劲透丝帛，但见" + query("name") + HIG "表面异彩流动，渐渐的$N收回了内力，只觉通体舒泰！\n" NOR, me);

  write(HIW "请为你的自创技能设定英文名:\n" NOR);
  input_to("set_skill_id", me, this_object());

  return 1;
}

void set_skill_id(string id, object me, object ob) {
  ob->set("skill_id", id);
  write(HIW "请为你的自创技能设定中文名:\n" NOR);
  input_to("set_skill_name", me, ob);
}

