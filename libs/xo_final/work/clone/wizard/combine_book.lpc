void set_skill_name(string name, object me, object ob) {
  int i;
  string index;
  mapping skill_map;
  object new_skill;

  ob->set("skill_name", name);

  if (!ob) {
    return;
  }

  new_skill = new("/d/place/player/combine_unarmed");
  if (!new_skill) {
    write("新建技能失败。\n");
    return;
  }

  new_skill->set_owner(me);
  new_skill->set_id(query("skill_id"));
  new_skill->set_name(query("skill_name"));
  new_skill->set_dengji(10);
  new_skill->set_all_action(test_actions);
  new_skill->save();

  me->set_wugong(query("skill_id"), 100);
  message_vision(HIY "$N获得了新的10级技能【" + query("skill_name") + "】！\n" NOR, me);

  skill_map = query("skill");

  for (i = 1; i < sizeof(skill_map) + 1; i++) {
    index = "" + i;
    me->delete_wugong(skill_map[index]);
  }

  destruct(ob);
}
