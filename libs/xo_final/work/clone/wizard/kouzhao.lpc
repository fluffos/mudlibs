#include <ansi.h>
#include <armor.h>
inherit NECK;


void create() {
  set_name(HIW "口罩" NOR, ({ "kou zhao", "kouzhao", "zhao" }));
  set_weight(100);                       //一市两；
  set("long", WHT "这是一副干净的口罩，设计的挺漂亮的。据说它能预防SARS,不知是不是真的。\n" NOR);
  set("unit", "副");
  set("cant_sell", "伙计疑惑的看着你：“什么破东西。”\n");
  set("value", 50000);
  set("armor_prop/armor", 20);
  set("armor_prop/personality", 5);
  set("wear_msg",
    WHT "\n$N小心翼翼地带上一副$n" NOR + WHT "，并探头四处看了看，担心因此不pp了。\n" NOR
    +WHT "$N发现别人都戴了口罩，才安下心来。\n" NOR
    +YEL "$N昂起首，挺起胸，似乎很得意......\n" NOR);
  set("unequip_msg", GRN "$N猫着腰，将$n" NOR + GRN "拉了下来，似乎很不好意思，......\n" NOR);
  setup();
}
