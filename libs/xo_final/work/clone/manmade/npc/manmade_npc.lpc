// BY emotion

#include <ansi.h>
#include <race.h>
#include <armor.h>
#include <weapon.h>
#include <command.h>

inherit NPC;
inherit F_SAVE;
inherit F_AUTOSAVE;
inherit F_AUTOLOAD;

#define JJ_MANMADE_NPCD "/system/daemon/manmade_npcd"

#define MANMADE "manmade/"
#define KILL_OTHER_PROB MANMADE"kill_other_prob"
#define BIRTH MANMADE"birth"
#define DEATH_COUNT MANMADE"death_count"
#define RZR_LEVEL MANMADE"rzr_level"
#define MOVE_PROB MANMADE"random_move"
#define HEAL_PROB MANMADE"auto_heal"
#define QUEST_PROB MANMADE"quest_master"
#define BUY_PROB MANMADE"random_buy"

#define ITEM_TYPE_WEAPON    1
#define ITEM_TYPE_ARMOR        2
#define ITEM_TYPE_UNKNOWN    0

// this is a manmade npc
int is_manmade_npc() {
  return 1;
}

void full_me() {
  NPC_D->full_me(this_object());
}

void clean_quest() {
  delete("newquest");
  delete("oldquest");
  delete("rzr_quest/result");
  delete("rzr_quest/msg");
  delete("rzr_quest/start_time");
  delete("quest_home");
  delete("quest_master");
  delete("quest_master_name");
}

// This is used by F_SAVE to determine the filename to save our data.
string query_save_file() {
  string id = query("id");

  if (!stringp(id) || "rzr0" == id) {
    return 0;
  }

  return sprintf(DATA_DIR "rzr/%s", id);
}

// to allow re-enable this rzr's heart beat
void enable_heart_beat() {
  set_heart_beat(1);
}

// return current rzr level
int rzr_get_my_level() {
  return query(RZR_LEVEL);
}

// update this rzr's status based on its current skill levels
void update_health() {
  int increase_above_level_4;
  int current_level;

  delete("max_gin");
  delete("max_kee");
  delete("max_sen");

  current_level = rzr_get_my_level();

  switch (current_level) {
    case 0:
      set("age", 14);
      set("per", 40);
      set("int", 50);
      set("str", 40);
      set("cor", 40);
      set("spi", 40);
      set("cps", 40);
      set("con", 40);
      set("kar", 40);
      set("dex", 40);
      break;
    case 1:
      set("age", 18);
      set("per", 60);
      set("int", 80);
      set("str", 60);
      set("cor", 60);
      set("spi", 60);
      set("cps", 60);
      set("con", 60);
      set("kar", 60);
      set("dex", 60);
      break;
    case 2:
      set("age", 22);
      set("per", 80);
      set("int", 110);
      set("str", 80);
      set("cor", 80);
      set("spi", 80);
      set("cps", 80);
      set("con", 80);
      set("kar", 80);
      set("dex", 80);
      break;
    case 3:
      set("age", 26);
      set("per", 100);
      set("int", 140);
      set("str", 100);
      set("cor", 100);
      set("spi", 100);
      set("cps", 100);
      set("con", 100);
      set("kar", 100);
      set("dex", 100);
      break;
    case 4:
    default:
      increase_above_level_4 = current_level - 4;
      set("age", 30);
      set("per", 120 + 20 * increase_above_level_4);
      set("int", 170 + 20 * increase_above_level_4);
      set("str", 120 + 20 * increase_above_level_4);
      set("cor", 120 + 20 * increase_above_level_4);
      set("spi", 120 + 20 * increase_above_level_4);
      set("cps", 120 + 20 * increase_above_level_4);
      set("con", 120 + 20 * increase_above_level_4);
      set("kar", 120 + 20 * increase_above_level_4);
      set("dex", 120 + 20 * increase_above_level_4);
      break;
  }

  add_temp("apply/damage", current_level * 15);
  add_temp("apply/armor", current_level * 50);

  set_weight(40000 + (query("str") - 10) * 2000);
}

// detect the type of the object. if weapon return 1, if armor return 2, otherwise return 0
int get_item_type(object ob) {
  if (mapp(ob->query("weapon_prop"))) {
    return ITEM_TYPE_WEAPON;  // weapon
  }

  if (mapp(ob->query("armor_prop"))) {
    return ITEM_TYPE_ARMOR;
  }

  return ITEM_TYPE_UNKNOWN;
}

int heal_myself() {
  int flag = 0;

  if (query_char_eff_ratio("gin") < 100) {
    receive_curing("gin", 50);
    flag = 1;
  }

  if (query_char_eff_ratio("kee") < 100) {
    receive_curing("kee", 50);
    flag = 1;
  }

  if (query_char_eff_ratio("sen") < 100) {
    receive_curing("sen", 50);
    flag = 1;
  }

  if (query_char_ratio("gin") < 100) {
    receive_heal("gin", 50);
    flag = 1;
  }

  if (query_char_ratio("kee") < 100) {
    receive_heal("kee", 50);
    flag = 1;
  }

  if (query_char_ratio("sen") < 100) {
    receive_heal("sen", 50);
    flag = 1;
  }

  if (query("force") < query("max_force") * 2) {
    add("force", 50);
    flag = 1;
  }

  if (flag && !random(5)) {
    message("vision", HIR + name() + "周身泛起一片耀目红光！\n" NOR, environment(), this_object());
  }

  return flag;
}

void check_levelup() {
  int level = query_max_xiuwei_jibie();

  if (level > query(RZR_LEVEL)) {
    run_command("chat* haha");
    run_command("chat " + RANK_D->query_self_respect(this_object()) + "今日终于升级了!");
    set(RZR_LEVEL, level);
    save();
  }
}

varargs int random_place(int force) {
  if (!force && (time() - query_temp("last_random_place") < 300 || query("newquest") || query("oldquest"))) {
    return 0;
  }

  set_temp("last_random_place", time());
  clean_quest();
  return ::random_place();
}

int random_move() {
  int result;
  object *all_master;
  int index;

  result = ::random_move();

  if (!this_object() || this_object()->query("quest_home")) {
    //不要重复接任务
    return result;
  }

  if (!environment()) {
    return result;
  }

  if (environment()->query("sleep_room") && !random(3) && 0 < heal_myself()) {
    CHANNEL_D->do_channel(this_object(), "debug", query_idname() + "在[" + environment()->query("short")
      + "(" + file_name(environment()) + ")" + "]睡了一觉。");
    command("sleep");
    return result;
  }

  if (environment()->query("kitchen_room") && !random(5)) {
    CHANNEL_D->do_channel(this_object(), "debug", query_idname() + "在[" + environment()->query("short")
      + "(" + file_name(environment()) + ")" + "]吃了一顿。");
    command("zuo");
    return result;
  }

  if (random(100) > query(QUEST_PROB)) {
    return result;
  }

  all_master = filter(all_inventory(environment()), function(object inv)
    {
      if (inv->query("new_master"))
        return 1;
      else return 0;
    });

  if (!all_master || !arrayp(all_master) || 0 == sizeof(all_master)) {
    return result;
  }

  index = random(sizeof(all_master));

  set("quest_home", environment());
  set("quest_master", all_master[index]->query("id"));
  set("quest_master_name", all_master[index]->query("name"));

  command("quest " + query("quest_master"));

  return result;
}

void found_something(mapping quest) {
  object item;

  if (query("quest_home")) {
    move(file_name(query("quest_home")));
  }
  if (query("quest_master") && present(
    query("quest_master"),
    environment()
  ) && (item = present("item", this_object()))) {
    item->set("name", quest["target"]);
    command("give item to " + query("quest_master"));
  } else {
    clean_quest();
  }
}

void find_something(mapping quest) {
  object item;

  item = new("/d/menpai/qingcheng/obj/item");
  item->move(this_object());

  remove_call_out("found_something");
  call_out("found_something", 5 + random(10), quest);
}

void finish_something(mapping quest) {
  if (query("quest_home")) {
    move(file_name(query("quest_home")));
  }
  if (query("quest_master") && present(query("quest_master"), environment())) {
    command("done " + query("quest_master"));
  } else {
    clean_quest();
  }
}

void kill_questguai(mapping quest) {
  if (quest["target"] && environment(quest["target"])) {
    move(environment(quest["target"]));
  }
  if (quest["target"] && present(quest["target"], environment())) {
    command("kill " + quest["target"]->query("id"));
  } else {
    clean_quest();
  }
}

void finish_questguai(mapping quest) {
  if (query("quest_home")) {
    move(file_name(query("quest_home")));
  }
  if (query("quest_master") && present(query("quest_master"), environment())) {
    command("done " + query("quest_master"));
  } else {
    clean_quest();
  }
}

void do_quest() {
  mapping quest;
  string type;
  string kind;
  string target;
  object item;
  object env = query("quest_home");
  string master_name = query("quest_master_name");
  string master_id = query("quest_master");
  int flag = 1;

  if (0 < (int)query("rzr_quest/start_time") && time() - query("rzr_quest/start_time") > 900) {
    CHANNEL_D->do_channel(this_object(), "debug", query_idname() + "超时清除任务。");
    clean_quest();
    return;
  }

  if (quest = query("newquest")) {
    kind = quest["kind"];

    if ("杀" == kind) {
      target = query("rzr_quest/msg");
      switch (quest["result"]) {
        case "reward":
          type = "完成";
          clean_quest();
          save();
          break;

        case "delay":
          type = "延迟完成";
          clean_quest();
          break;

        case "fail":
          type = "失败";
          clean_quest();
          break;

        case "cancel":
          type = "放弃";
          clean_quest();
          break;

        case "wait":
          if ("wait" != query("rzr_quest/result")) {
            set("rzr_quest/msg", quest["where"]);
            set("rzr_quest/start_time", time());
            target = query("rzr_quest/msg");
            set("rzr_quest/result", "wait");
            type = "接到";
            remove_call_out("kill_questguai");
            call_out("kill_questguai", 5 + random(10), quest);
          } else {
            flag = 0;
          }
          break;

        case "accomplish":
          if ("accomplish" != query("rzr_quest/result")) {
            set("rzr_quest/result", "accomplish");
            type = "等待交差";
            remove_call_out("finish_questguai");
            call_out("finish_questguai", 5 + random(10), quest);
          } else {
            flag = 0;
          }
          break;

        default:
          clean_quest();
          return;
          break;
      }
    } else if ("找" == kind) {
      target = quest["target"];
      switch (quest["result"]) {
        case "reward":
          type = "完成";
          clean_quest();
          save();
          break;

        case "delay":
          type = "延迟完成";
          clean_quest();
          break;

        case "fail":
          type = "失败";
          clean_quest();
          break;

        case "cancel":
          type = "放弃";
          clean_quest();
          break;

        case "wait":
          if ("wait" != query("rzr_quest/result")) {
            set("rzr_quest/result", "wait");
            set("rzr_quest/start_time", time());
            type = "接到";
            remove_call_out("find_something");
            call_out("find_something", 5 + random(10), quest);
          } else {
            flag = 0;
          }
          break;

        case "accomplish":
          if ("accomplish" != query("rzr_quest/result")) {
            set("rzr_quest/result", "accomplish");
            type = "等待交差";
            remove_call_out("finish_something");
            call_out("finish_something", 5 + random(10), quest);
          } else {
            flag = 0;
          }
          break;

        default:
          clean_quest();
          return;
          break;
      }
    } else {
      flag = 0;
    }

    if (1 == flag && env) {
      CHANNEL_D->do_channel(this_object(), "debug", query_idname() + "在[" + env->query("short")
        + "(" + file_name(env) + ")" + "]从" + master_name + "("
        +master_id + ")处" + type + "任务(" + kind + "【" + target + "】" + ")。");
    }

    return;
  }

  if (query("oldquest")) {
    return;
  }
}

void auto_perform() {
  int count = 2 + sizeof(query("attack_type"));
  int i = random(count);
  string type;
  object wuxian;

  if (!present("huntian jia", this_object())) {
    carry_object(ARMOR_DIR "huntian-armor")->wear();
  }

  if (0 == i) {
    type = "dodge";
  } else if (1 == i) {
    type = "unarmed";
    command("unwield all");
  } else {
    type = query("attack_type")[i - 2];

    if (!(wuxian = present("wuxian shi", this_object()))) {
      carry_object("/clone/weapon/misc/wuxian");
    }

    if (!(wuxian = present("wuxian shi", this_object()))) {
      type = "unarmed";
      command("unwield all");
    } else {
      command("unwield all");
      wuxian->do_huan(type);
      command("wield shi");
    }
  }

  NPC_D->auto_perform(this_object());
}

void auto_exert() {
  NPC_D->auto_exert(this_object());
}

void heart_beat() {
  ::heart_beat();

  if (!query("levelup_time")) {
    set("levelup_time", time());
  } else if (time() - query("levelup_time") > 900) {
    check_levelup();
  }

  if (!in_war()) {
    if (random(100) < query(HEAL_PROB)) {
      heal_myself();
    }

    if (can_act()) {
      if (random(100) < query(MOVE_PROB)) {
        random_move();
      }

      do_quest();
    }
  } else {
    if (!random(3) || 4 < random(rzr_get_my_level())) {
      auto_perform();
    } else if (!random(5) || 4 < random(rzr_get_my_level())) {
      auto_exert();
    }

    if (random(100) < 10 || 5 < random(rzr_get_my_level())) {
      heal_myself();
    }
  }
}

// determine whether this npc can initiate the fight
int can_fight() {
  if (!can_act() || query_temp("no_move")) {
    return 0;
  }

  return 1;
}

void kill_ob(object ob) {
  ::kill_ob(ob);
}

void set_manmade_npc_skills(int level) {
  int xiuwei_dengji = query(RZR_LEVEL);
  int i, j;
  string *my_type = ({ "dodge", "unarmed", "force" });
  string *all_skills;
  string attack_type;
  string *attack_skill = ({});

  for (i = 0; i < 10; i++) {
    if (5 <= sizeof(my_type)) {
      break;
    }

    attack_type = KUNGFU_D->query_random_attack_type();
    if (member_array(attack_type, my_type) < 0) {
      my_type += ({ attack_type });
      attack_skill += ({ attack_type });
    }
  }

  set("attack_type", attack_skill);

  for (j = 0; j < sizeof(my_type); j++) {
    all_skills = KUNGFU_D->query_all_skills(my_type[j], xiuwei_dengji);
    for (i = 0; i < sizeof(all_skills); i++) {
      set_wugong(all_skills[i], level, level, 1);
    }
    set_xiuwei_level_by_type(my_type[j], xiuwei_dengji);
  }

  set_xiuwei_level_by_type("zonggang", xiuwei_dengji);

  return;
}

void create() {
  int rzr_level;

  set(KILL_OTHER_PROB, 30);
  set(HEAL_PROB, 50);
  set(DEATH_COUNT, 6);
  set(QUEST_PROB, 50);
  set(BUY_PROB, 50);
  set("can_improve", 1);

  set_name(
    "人造人 " + JJ_MANMADE_NPCD->generate_name(),
    ({ "rzr" + JJ_MANMADE_NPCD->get_next_rzr_id(), "rzr" })
  );
  set("long", "天生地长, 没爹没娘的人造人\n");
  set("gender", random(2) ? "男性" : "女性");

  set("attitude", "friendly");
  set("env/no_accept", 1);

  if (random(100) >= 60) {
    rzr_level = random(7) + 1;
    set(RZR_LEVEL, rzr_level);
    set(MOVE_PROB, rzr_level * 10);
    set("combat_exp", 300000 * rzr_level);
    set_manmade_npc_skills(100 + (rzr_level - 1) * 50);
  } else {
    rzr_level = 0;
    set(RZR_LEVEL, rzr_level);
    set(MOVE_PROB, 10);
    set("combat_exp", 60000);
    set_manmade_npc_skills(60);
  }

  update_health();  // update own health
  set(BIRTH, time());
  setup();

  clean_quest();
}

void set_living_name(string name) {
  efun::set_living_name(name);
}

void buy_something(object target) {
  mapping goods;
  string ob_file, *name;
  object item;

  if (random(100) > query(BUY_PROB)) {
    return;
  }

  goods = target->query("vendor_goods");
  if (!sizeof(goods)) {
    return;
  }

  name = keys(goods);
  ob_file = name[random(sizeof(name))];
  ob_file = goods[ob_file];

  /*
    while ( !can_afford(ob_file->query("value")) )
    {
        add_money("gold", 1);
    }
*/

  command("buy " + ob_file->query("id") + " from " + target->query("id"));
  CHANNEL_D->do_channel(this_object(), "debug", query_idname() + "在[" + environment()->query("short")
    + "(" + file_name(environment()) + ")" + "]向" + target->query_idname() + "购买了"
    +ob_file->query("name") + "(" + ob_file->query("id") + ")" + "。");

  if (item = present(ob_file->query("id"), this_object())) {
    call_out("dest_ob", 1, item);
  }
}

void dest_ob(object item) {
  if (item) {
    destruct(item);
  }
}

void init() {
  object target;

  if ((query("bellicosity") / 35) > query("cps")) {
    set("bellicosity", query("cps") * 35);
  }
  target = this_player();

  if (target->query("taskguai")) {
    return;
  }

  ::init();

  if (userp(target)) {
    add_action("do_escape", "go");
    add_action("do_spare", "spare");
  } else {
    if (in_war()) {
      return;
    }

    if (query("newquest") || query("oldquest")) {
      return;
    }

    if (target->query("new_master")) {
      return;
    }

    if (target->query("can_teach")) {
      return;
    }

    if (target->query("taskguai") && target->query("owner") != this_object()) {
      return;
    }

    if (target->is_manmade_npc()) {
      return;
    }

    if (target->query("vendor_goods")) {
      buy_something(target);
      return;
    }

    if (random(100) > query(KILL_OTHER_PROB)) {
      return;
    }

    CHANNEL_D->do_channel(this_object(), "debug", query_idname() + "在[" + environment()->query("short")
      + "(" + file_name(environment()) + ")" + "]与" + target->query_idname() + "进入战斗。");
    command("kill " + target->query("id"));
  }
}

string rzr_retain_player_item(object player) {
  int item_count;
  object *inv, item;

  inv = all_inventory(player);

  if (sizeof(inv) > 0) {
    item = inv[random(sizeof(inv))];
    item->move(environment(this_object()));
    if (objectp(item)) {
      return item->query("name");
    } else {
      return "";
    }
  } else {
    return "";
  }
}

int do_spare(string arg) {
  object player, me;
  string msg;

  me = this_object();
  player = this_player();

  if (!objectp(me) || !objectp(player)) {
    return 0;
  }

  msg = player->query("name") + "双膝一软跪倒在地,哭着对" + me->query("name") + "说:俺上有老下有小,您就放过小的这一次吧";
  message_vision(msg + "\n", player);
  player->run_command("chat " + msg);

  if (!player->is_killing(me->query("id")) && !me->is_killing(player->query("id"))) {
    msg = me->query("name") + "见了哈哈大笑, 对" + player->query("name") + "说道: "
      +RANK_D->query_self_rude(me) + "还没有准备杀你你怎么就跪下啦?被吓糊涂了吧?搞笑哪你。";
    message_vision(msg + "\n", me);
    me->run_command("chat " + msg);
    me->run_command("chat " + me->query("name") + "拿着棒子狠狠的敲着" + player->query("name")
      + "的脑袋,又揪揪耳朵,说道: 笨、笨、笨、笨、笨、真笨！");
    return 0;
  } else {
    int level;
    int i, target_eff_kee, target_eff_sen;
    string retained_item;

    msg = query("name") + "对" + player->query("name") + "笑道: 既然你讨饶了" + RANK_D->query_self_rude(me) + "就放过你吧 ";
    level = rzr_get_my_level();
    target_eff_kee = player->query("max_kee") / (level + 1);
    target_eff_sen = player->query("max_gin") / (level + 1);
    player->set("eff_kee", target_eff_kee);
    player->set("max_gin", target_eff_sen);
    player->set("force", 1);
    player->set("kee", 1);
    player->set("gin", 1);
    player->clear_condition();
    retained_item = "";

    for (i = 0; i < level; i++) {
      string temp;
      temp = rzr_retain_player_item(player);
      if (temp != "") {
        retained_item += " " + temp;
      }
    }
    if (retained_item != "") {
      msg += "不过你得留下" + retained_item + " ";
    }
    msg += "滚! 以后别让我再看见你! ";
    message_vision(msg + "\n", me);
    log_file("rzr_spare", msg + "\n");

    me->run_command("chat " + msg);
    msg = me->query("name") + "飞起一脚把" + player->query("name") + "踹到客栈去了, 直把"
      +player->query("name") + "摔得晕了过去! ";
    message_vision(msg + "\n", me);
    me->run_command("rumor " + msg);

    remove_killer(player);
    player->remove_killer(this_object());
    player->add("rzr_spare", 1);
    player->move("/d/city/yangzhou/keyu");
    player->unconcious();
    attack();  // remove enemy
    return 1;
  }
}

int do_escape(string arg) {
  if (environment(this_player()) != environment(this_object())) {
    return 0;
  }

  if (this_player()->is_fighting(this_object())) {
    int my_level;
    my_level = rzr_get_my_level();

    if (my_level > 4) {
      my_level = 4;
    }

    if (random(10) <= my_level) {
      message_vision("$N一伸手挡住了$n的去路，叫道: 架还没有打完就想溜?\n", this_object(), this_player());
      this_player()->start_busy(1 + random(my_level));
      return 1;
    }
  }

  return 0;
}

void die() {
  if (query("die_num") < query(DEATH_COUNT)) {
    add("die_num", 1);
    tell_room(environment(this_object()), query("name") + "(" + query("id")
      + ") 哈哈一笑，对你拱了拱手，转身而去。\n");
    CHANNEL_D->do_channel(this_object(), "debug", query_idname() + "在[" + environment()->query("short")
      + "(" + file_name(environment()) + ")" + "]被杀死，不过又复活了。");
    full_me();
    random_place(1);
    tell_room(environment(this_object()), query("name") + "(" + query("id")
      + ") 忽然出现在一阵烟雾中。\n");
    return;
  }

  CHANNEL_D->do_channel(this_object(), "debug", query_idname() + "在[" + environment()->query("short")
    + "(" + file_name(environment()) + ")" + "]被彻底杀死了。");
  JJ_MANMADE_NPCD->remove_rzr(this_object());
  ::die();
}

void disappear() {
  JJ_MANMADE_NPCD->remove_rzr(this_object());
  destruct(this_object());
}
