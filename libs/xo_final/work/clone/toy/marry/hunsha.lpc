#include <armor.h>
#include <ansi.h>
inherit CLOTH;


void create()
{
    set_name(WHT"婚纱"NOR, ({"hun sha","cloth"}));
    set_weight(500);
    if ( clonep() )
        set_default_object(__FILE__);
    else
    {
        set("long", 
        "一件纯白的"+WHT"婚纱"NOR+"，简单却不失典雅地以几朵淡淡的红玫瑰点缀，长裙下摆直拖到地。\n"
        +"剪裁得非常细致得体，将新娘的"+HIY"娇艳妩媚"NOR+"和"+BLU"婀娜多姿"NOR+"展示得淋漓尽致！\n");
        set("unit", "件");
        set("value", 200000);
        set("female_only", 1);
        set("material", "cloth");
        set("cant_sell","这是一套婚纱啊，你怎么能随便拿来卖掉呢？\n");
        set("armor_prop/armor", 2);
        set("armor_prop/personality", 10);
   		set("wear_msg",
   		"$N轻手轻脚地穿上$n，左手撑起了下巴，情不自禁地唱道：\n"
   		+CYN"明天我要嫁给你了，明天就要嫁给你了......\n"NOR);
   		set("unequip_msg","$N将$n轻轻脱下，回忆起那盛大的婚礼，一朵红云不禁飞上了脸颊......\n");
    }
    setup();
}

