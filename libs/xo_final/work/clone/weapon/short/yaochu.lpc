// /clone/weapon/short/yaochu.c
// By lala, 1998-01-25

#include <weapon.h>

inherit HAMMER;



void create()
{
    set_name("药锄", ({ "yao chu", "yaochu" }) );
    set_weight(4000);
    if( clonep() )
        set_default_object(__FILE__);
    else
    {
        set("unit", "把");
        set("long", "这是一把用来挖药的短把药锄。\n");
        set("value", 100);
        set("material", "wood");
        set("wield_msg", "$N从背后抽出一把$n握在手中。\n");
        set("unwield_msg", "$N放下手中的$n。\n");
    }

    init_hammer(12);
    setup();
}
