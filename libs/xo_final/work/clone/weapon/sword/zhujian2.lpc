// zhujian2.c 竹剑
// 可以卖的竹剑，2两银子
// Write by Xli 1999.11.9
#include <ansi.h>
#include <weapon.h>

inherit SWORD;



void create() {
  set_name(HIR "神秘剑" NOR, ({ "shenmi jian", "jian", "sword" }));
  set_weight(10000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("value", 1000000);
    set("material", "bamboo");
    set("long",
      "这是一把神秘的剑，掂起来很有些沉，剑柄乌黑，剑身稍窄，剑尖处锋芒毕露，似乎充满了一种神秘的力量。\n");
    set("wield_msg", "$N拿出一把剑手用的$n，握在手中。\n");
    set("unequip_msg", "$N放下手中的$n。\n");
  }
  init_sword(10);
  setup();
}

int query_autoload() {
  if (!this_player()) return 0;
  return 1;
}

int IsAutoLoad() {

  return 1;
}
