#include <weapon.h>
#include <ansi.h>
inherit AXE;


void create()
{
	set_name("板斧", ({ "ban fu","axe"}) );
	set_weight(2500);
        set("long",@LONG
        一把很重的斧头，斧头是精铁打就。
LONG);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "把");
		set("value",800);
		set("material", "steel");
	}
	init_axe(25);
	set("wield_msg", "$N紧紧握住手中的$n。\n");
	set("unwield_msg", "$N将手中的$n戳到地上。\n");
	setup();
}
