//standard 长枪.c   edit by lin on March 3,  97
#include <weapon.h>
#include <ansi.h>
inherit QIANG;


void create() {
  set_name("长枪", ({ "chang qiang", "qiang" }));
  set_weight(2500);
  set("long", @LONG
        一根六尺余长的木杆长枪，枪头是精铁打就，上面系着红樱。
LONG);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "杆");
    set("value", 800);
    set("material", "wood");
  }
  init_qiang(25);
  set("wield_msg", "$N紧紧握住手中的$n。\n");
  set("unwield_msg", "$N将手中的$n戳到地上。\n");
  setup();
}
