//   edit by lin on March 3,  97
#include <weapon.h>
#include <ansi.h>
inherit LONG_BLADE;


void create() {
  set_name("长柄大刀", ({ "da dao", "dao", "blade" }));
  set_weight(8000);
  set("long", @LONG
        一根六尺余长的木柄大刀，入手沉重，刀刃锋利。
LONG);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "柄");
    set("value", 3300);
    set("material", "iron");
  }
  init_long_blade(35);
  set("wield_msg", "$N紧紧握住手中的$n举到胸前.\n");
  set("unwield_msg", "$N将手中的$n戳到地上。\n");
  setup();
}
