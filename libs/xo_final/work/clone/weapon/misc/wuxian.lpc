//无限示加强版:)
//Snowtu@Xmxyj2000/2003/10

#include <ansi.h>
#include <weapon.h>

inherit WEAPON;

void init();

void create() {
  set_name(HIM "无限示" NOR, ({ "wuxian shi", "shi", "wuxian" }));

  if (clonep()) {
    set_default_object(__FILE__);
  } else {
    set_weight(1000);
    set("long", HIM "
神匠欧冶子当年参透百家武器奥妙所打造的神兵，用十七块奇形怪状
的玄金属连缀而成。你仔细看看它，发现里面另有玄机：你可以将它
驳(huan)成\n
刀(blade)剑(sword)锤(hammer)斧(axe)鞭(whip)匕首(dagger)笔(pen)
枪(spear)杖(staff)扇(fan)算盘(plate)三节棍(stickwhip)。\n
也可以变换回无限示(shi)。\n" NOR);
    set("unit", "块");
    set("value", 0);
    set("material", "steel");
  }

  set("any_weapon", 1);
  set("verbs", ({ "slash", "slice", "thrust" }));
  set("wield_msg", "$N抽出一块$n握在手中。\n");
  set("unwield_msg", "$N将手中的$n插入腰间的剑鞘。\n");

  setup();
}

void init() {
  if (!query("owner")) {
    set("owner", this_player()->query("id"));
  } else if (query("owner") != this_player()->query("id")) {
    destruct(this_object());
    return notify_fail("你从哪里弄来的?\n");
  }

  set("no_give", HIW "此事还是作罢，不要再想了吧...... \n" NOR);
  set("no_put", HIW "丢不得！丢不得！丢不得！丢不得！丢不得！\n" NOR);
  set("no_drop", HIW "丢不得！丢不得！丢不得！丢不得！丢不得！\n" NOR);
  set("no_get", HIW "好东西你看看就得了，还想拿？小心我打你PP哦...... \n" NOR);
  set("no_sell", HIW "此事还是作罢，不要再想了吧...... \n" NOR);

  add_action("do_huan", "huan");
}

int do_huan(string arg) {
  object me = this_player();
  object ob = this_object();

  if (!ob || !me || !present(ob, me) || !(arg)) {
    return notify_fail("什么？\n");
  }

  if (ob->is_equipped()) {
    return notify_fail("你还是先卸除装备吧。\n");
  }

  switch (arg) {
    case "sword":
      init_weapon(10, 0, EDGED);
      set_weapon_type("sword");
      set("skill_type", "sword");
      set("xiuwei_type", "sword");
      set("verbs", ({ "slash", "slice", "thrust" }));
      break;

    case "hammer":
      init_weapon(10, 0, EDGED);
      set_weapon_type("hammer");
      set("skill_type", "hammer");
      set("xiuwei_type", "short");
      set("verbs", ({ "slash", "slice", "thrust" }));
      break;

    case "stick":
    case "staff":
      init_weapon(10, 0, EDGED);
      set_weapon_type("staff");
      set("skill_type", "staff");
      set("xiuwei_type", "long");
      set("verbs", ({ "bash", "crush", "slam" }));
      break;

    case "axe":
      init_weapon(10, 0, EDGED);
      set_weapon_type("axe");
      set("skill_type", "axe");
      set("xiuwei_type", "long");
      set("verbs", ({ "chop", "slice", "hack" }));
      break;

    case "qiang":
    case "spear":
      init_weapon(10, 0, EDGED);
      set_weapon_type("spear");
      set("skill_type", "spear");
      set("xiuwei_type", "long");
      set("verbs", ({ "thrust" }));
      break;

    case "shi":
      write("Ok.\n");
      return 1;
      break;

    case "whip":
      init_weapon(10, 0, EDGED);
      set_weapon_type("whip");
      set("skill_type", "whip");
      set("xiuwei_type", "long");
      set("verbs", ({ "whip" }));
      break;

    case "stickwhip":
      init_weapon(10, 0, EDGED);
      set_weapon_type("stickwhip");
      set("skill_type", "stickwhip");
      set("xiuwei_type", "long");
      set("verbs", ({ "whip" }));
      break;

    case "blade":
      init_weapon(10, 0, EDGED);
      set_weapon_type("blade");
      set("skill_type", "blade");
      set("xiuwei_type", "blade");
      set("verbs", ({ "slash", "slice", "hack" }));
      break;

    case "dagger":
      init_weapon(10, 0, EDGED);
      set_weapon_type("dagger");
      set("skill_type", "dagger");
      set("xiuwei_type", "short");
      set("verbs", ({ "slice", "pierce", "thrust" }));
      break;

    case "pen":
      init_weapon(10, 0, EDGED);
      set_weapon_type("pen");
      set("skill_type", "pen");
      set("xiuwei_type", "short");
      set("verbs", ({ "impale", "point" }));
      break;

    case "fan":
      init_weapon(10, 0, EDGED);
      set_weapon_type("fan");
      set("skill_type", "fan");
      set("xiuwei_type", "short");
      set("verbs", ({ "impale", "point" }));
      break;

    case "plate":
      init_weapon(10, 0, EDGED);
      set_weapon_type("plate");
      set("skill_type", "plate");
      set("xiuwei_type", "short");
      set("verbs", ({ "impale", "point" }));
      break;

    default:
      return notify_fail("你想要的超出我的想象。。。\n");
      break;
  }

  message_vision("$N口中念念有词，$n一阵光华过后变作了武器！\n", me, ob);

  return 1;
}

int query_autoload() {
  if (!this_player()) {
    return 0;
  }

  return 1;
}
