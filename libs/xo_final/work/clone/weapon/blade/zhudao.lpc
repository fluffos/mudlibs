// zhudao.c 竹刀
// 可以卖的竹刀，2两银子
// Write by Xli 1999.11.9
#include <ansi.h>
#include <weapon.h>

inherit BLADE;



void create()
{
        set_name(HIG"神秘刀"NOR, ({ "shenmi dao", "dao", "blade"}) );
        set_weight(10000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "把");
                set("value", 1000000);
                set("material", "bamboo");
                set("long", 
"这是一把神秘的刀，掂起来很有些沉，刀柄乌黑，刀身稍弯，刀刃处锋芒毕露，似乎充满了一种神秘的力量。\n");
                set("wield_msg", "$N抽出一把刀手用的$n，握在手中。\n");
                set("unequip_msg", "$N放下手中的$n。\n");
        }
        init_blade(10);
        setup();
}
 
int query_autoload()
{
     if( !this_player() ) return 0;
     return 1;
}
int IsAutoLoad() { 
   
    return 1;
}