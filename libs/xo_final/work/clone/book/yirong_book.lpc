// yirong_book.c

inherit BOOK;

int do_study(string arg);



void create() {
  set_name("易容入门", ({ "yirong rumen" }));
  set_weight(300);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "本");
    set("long", "一本已被翻得起皱的小册子。\n");
    set("value", 2000);
    set("material", "paper");
    set("skill", ([
      "name": "yirong-shu",
      "xiuwei_required": 0,
      "literate_required": 100,
      "gin_cost": 3,
      "max_lingwu": 50,
      "bonus_jilei": 3 + random(5),
    ]));
  }
}

void init() {
  add_action("do_study", "study");
}

int do_study(string arg) {
  object me;
  me = this_player();

  if (arg == "yirong rumen") {
    if (me->query("gin") > 50)
      me->add("gin", -50);
    else if (me->query("gin") > 10)
      me->add("gin", -10);
    else if (me->query("gin") > 5)
      me->add("gin", -5);
  }
  return 0;
}
