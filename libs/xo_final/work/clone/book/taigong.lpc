// jianshu.c

inherit BOOK;



void create() {
  set_name("「太公辩」", ({ "taigong bian", "book", "shu" }));
  set_weight(300);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "本");
    set("long", "这本书封皮有点旧，上面写着「太公辩」几个字。\n");
    set("value", 2000);
    set("material", "paper");
    set("skill", ([
      "name": "literate",
      "xiuwei_required": 0,
      "literate_required": 60,
      "gin_cost": 40 + random(10),
      "max_lingwu": 150,
      "bonus_jilei": 40,
      //		        "bonus_xiuwei"     : 2,
      //		        "max_xiuwei"       : 400,
      //	 	        "bonus_combat_exp" : 1,
      //		        "max_combat_exp"   : 100,
      "bonus_social_exp": 10,
      "max_social_exp": 30000,
    ]));
  }
}
