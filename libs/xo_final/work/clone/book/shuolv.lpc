// jianshu.c

inherit BOOK;



void create() {
  set_name("「说律」", ({ "shuo lv", "book", "shu" }));
  set_weight(300);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "本");
    set("long", "这本书封皮有点旧，上面写着「说律」几个字。\n");
    set("value", 2000);
    set("material", "paper");
    set("skill", ([
      "name": "literate",
      "xiuwei_required": 0,
      "literate_required": 40,
      "gin_cost": 20 + random(10),
      "max_lingwu": 100,
      "bonus_jilei": 10,
      "bonus_social_exp": 3,
      "max_social_exp": 10000,
    ]));
  }
}
