// mailbox.c
// none changed send_mail(string rcvr, mapping mail) on 96/10/03;
// mon add query_newmail and mail "status" on 97/1/8;
#include <ansi.h>
inherit ITEM;
inherit F_SAVE;

void create() {
  set_name(HIG "百宝箱" NOR, ({ "box" }));
  set("long",
    "这是一个用来百宝箱，武林中人常用的那种。\n"
  );
  set("unit", "个");
  set("value", 10);
  set_max_encumbrance(20000);
  //	set("no_insert", 1);

  seteuid(getuid());
  setup();
}

int is_container() { return 1; }

//mixed direct_look_obj(object o, string cmd)
mixed direct_look_obj() {
  return 1;
}

int IsAutoLoad() { return 1; }
