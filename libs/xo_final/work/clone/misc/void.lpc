#include <room.h>

inherit ROOM;

void create() {
  set("short", "天涯海角，梦的尽头");
  set("long", @LONG
这儿是 ... 空寂 ... 虚无 ... 幻灭 ... 无声无息 ... 无边无界 ...
无始无终。你可以待在这儿想想你的过去，现在和将来，不过你最好早些离开这
块本不该凡人呆的地方。?
LONG
  );
  set("safeplace", 1);
  set("exits", ([
    "down": "/d/map/zhongyuan/nanmen"
  ]));
  set("IsVoid", 1);
  setup();
}

int valid_leave(object me, string dir) {
  if (me->is_ghost()) {
    me->move("/d/place/death/yellow1");
    return notify_fail("\n");
  } else if (me->query("hydra/desert/from") == "西域") {
    me->move("/d/city/gaochang/center");
    return notify_fail("\n");
  } else {
    return ::valid_leave(me, dir);
  }
}
