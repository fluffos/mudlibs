//  zuzhi.c in /system/std
inherit F_CLEAN_UP;
inherit F_SAVE;
inherit F_DBASE;



void create() {
  seteuid(ROOT_UID);
  restore();
}

string query_save_file() {
  return DATA_DIR + "zuzhi/" + file_name(this_object());
}

int FireMember(object who) {
  set("member/" + who->id() + "/leavetime", time());
  add("number_to_join", 1);
  save();
  return 0;
}

void RecruitMember(object who, string touxian, string zhiwu, int entertime) {
  set("member/" + who->id() + "/entertime", time());
  add("number_to_join", 1);
  save();
  return;
}
