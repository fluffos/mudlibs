inherit ITEM;
mapping map_dirs = ([
  "east": "west",
  "west": "east",
  "north": "south",
  "south": "north",
  "northeast": "southwest",
  "southwest": "northeast",
  "northwest": "southeast",
  "southeast": "northwest",
  "northup": "southdown",
  "southup": "northdown",
  "eastup": "westdown",
  "westup": "eastdown",
  "northdown": "southup",
  "southdown": "northup",
  "eastdown": "westup",
  "westdown": "eastup",
  "up": "down",
  "down": "up",
  "enter": "out",
  "out": "enter",
]);
int room_save(object);  //房间储存 
int do_start(string);  //区域生成开始 
int create_new_room();
int do_stop();  //区域生成结束 
int do_go(string dest);  //走路 
int do_name(string name);
int do_change_id(string);  //这个是简化版本，不进行有效性判断，巫师自己负责吧 
string d_dir = "";  //区域所在目录 
void create() {
  set_name("区域生成器", ({ "domainmaker" }));
  set_weight(100);
  seteuid(ROOT_UID);
  set("no_drop", "这样东西不能离开你。\n");
  set("unit", "个");
  set("channel_id", "区域生成器");
  set("prepared_domain", 0);  //可以进行区域生成标记，0:no 1:yes 
  set("temp_room_id", 1);
  setup();
}
void init() {
  add_action("do_start", "start");
  add_action("do_stop", "stop");
  add_action("do_exit", "exit");
  add_action("do_test", "test");
  add_action("do_name", "name");
  add_action("do_change_id", "file");
}
int do_start(string dir) {
  if (!dir)  //巫师自己保证生成区域路径的正确性 
    return notify_fail("请输入即将生成的区域的正确路径。\n");
  if (file_size(dir) == -2 && dir[strlen(dir) - 1] != '/') dir += "/";
  //准备工作 
  this_object()->set("d_dir", dir);
  write("即将在" + this_object()->query("d_dir") + "生成新的区域。\n");
  set("prepared_domain", 1);
  set("temp_room_id", 1);
  create_new_room();
  return 1;
}
int do_stop() {
  set("prepared_domain", 0);  //可以进行区域生成标记，0:no 1:yes 
  set("temp_room_id", 1);
  write("区域生成完成，请继续用file来修改房间的file_name。\n");
  return 1;
}
int query_autoload() { return 1; }
int create_new_room() {
  string file, dir, str = "";
  object room;
  dir = this_object()->query("d_dir");
  file = sprintf("%s%d.lpc", dir, this_object()->query("temp_room_id"));
  if (file_size(file) != -1) {
    write("该房间已经存在。\n");
    return (-1);  //房间已经存在 
  }
  str += "\n";
  str += "// " + file + "\n";
  str += "// code by " + this_player()->query("id") + "@mudnow\n";
  str += "// create on" + ctime(time()) + "\n";
  str += "// written for Vworld\n";
  str += @ROOM_CODE 
inherit ROOM; 
void create() 
{ 
ROOM_CODE;
  str += sprintf("\tset(\"short\", \"房间%3d\");\n",
    this_object()->query("temp_room_id"));
  str += sprintf("\tset(\"long\", @LONG\n区域生成器生成的房间%s%d。\nLONG\n\t 
);\n",
    this_object()->query("d_dir"), this_object()->query("temp_room_id"));
  if (!write_file(file, str + @ROOM_CODE 
 set("exits",([])); 
 setup(); 
} 
ROOM_CODE)
  ) {
    write("您无权在此目录写入房间。\n");
    return (0);  //无权限写入。 
  }
  //正常生成房间 
  write(sprintf("生成新房间%s\n。", file));
  //用户移动到新房间 
  if (!(room = find_object(file)))
    call_other(file, "???");
  if (!(room = find_object(file))) {
    write("房间已经生成，但是无法进入。\n");
    return (2);  //房间已经生成，但是无法进入 
  }
  this_player()->move(room);
  write(sprintf("您已经进入房间%s。\n", file));
  this_object()->set("temp_room_id", this_object()->query("temp_room_id") + 1);
  return 1;  //正常生成临时房间 
}
int do_test(string arg) {
  string src, dst, *dirs;
  object me = this_player();
  seteuid(ROOT_UID);
  if (!arg || sscanf(arg, "%s %s", src, dst) != 2) return 0;
  src = resolve_path(me->query("cwd"), src);
  dst = resolve_path(me->query("cwd"), dst);
  if (file_size(dst) == -2) {
    dirs = explode(src, "/");
    dst += "/" + dirs[sizeof(dirs) - 1];
  }
  if (cp(src, dst)) write("Ok.\n");
  else write("Failed.");
  return 1;
}
int do_exit(string dest) {
  object me = this_player();
  seteuid(ROOT_UID);
  if (!dest) return 0;
  if (rm(resolve_path(me->query("cwd"), dest)))
    write("Ok.\n");
  else write("Failed.\n");
  return 1;
}
int room_save(object room) {
  return 0;
}
int do_change_id(string file_id) {
  object env = environment(this_player());
  object room;
  object room_next;
  int i;
  //开始进行本房间的复制改名。 
  if (!file_id) return notify_fail("对不起，请输入正确的房间file_name\n");
  file_id = sprintf("%s%s.lpc", this_object()->query("d_dir"), file_id);
  write("file_id");
  rm(file_id);
  cp(sprintf("%s.lpc", base_name(env)), file_id);
  if (!(room = find_object(file_id)))
    call_other(file_id, "???");
  if (!(room = find_object(file_id))) {
    write("房间已经生成，但是无法进入。\n");
    return (2);  //房间已经生成，但是无法进入 
  }
  this_player()->move(room);
  write(sprintf("您已经进入房间%s。\n", file_id));
  rm(sprintf("%s.lpc", base_name(env)));
  destruct(env);
  //开始进入所有相关链接的修改 
  for (i = 0; i < sizeof(room->query("exits")); i++) {
    if (!(room_next = find_object((values(room->query("exits")))[i])))
      call_other(file_id, "???");
    if (!(room_next = find_object((values(room->query("exits")))[i]))) {
      write("房间文件存在，但是有未知错误，无法修改。\n");
    }
    room_next->set("exits/" + map_dirs[(keys(room->query("exits")))[i]], file_id
    );
    room_save(room_next);
  }
  return 1;
}
int do_name(string name)

{
  if (!name) return notify_fail("错误的命名！\n");
  environment(this_player())->set("short", name);
  room_save(environment(this_player()));
  return 1;
}
