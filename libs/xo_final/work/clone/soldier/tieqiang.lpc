//standard 长枪.c   edit by lin on March 3,  97
#include <weapon.h>
#include <ansi.h>
inherit QIANG;


void create() {
  set_name("铁枪", ({ "tie qiang", "qiang", "gun" }));
  set_weight(2500);
  set("long", @LONG
一根六尺余长的木杆长枪，枪头是熟铁打就，上面系着红樱，是军中士兵
常用的武器；由军器所统一制作。
LONG);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "杆");
    set("value", 600);
    set("cant_sell", "官军的装备也来买卖，不要脑袋了么？！\n");
    set("material", "iron");
  }
  init_qiang(30);
  set("wield_msg", "$N紧紧握住手中的$n。\n");
  set("unwield_msg", "$N将手中的$n放下。\n");
  setup();
}
int is_soldier_use(object me) {
  return 1;
}
