//  standard soldieritem  lin 06/26/97

#include <weapon.h>
#include <ansi.h>

inherit BLADE;



void create()
{
    set_name(HIW"军刀"NOR, ({ "jun dao","dao","blade"}) );
    set_weight(2500);
    set("long",@LONG
一把精光四射的腰刀，是禁军中刀兵的武器。由军器所统一制作
LONG);
    if( clonep() )
	set_default_object(__FILE__);
    else {
	set("unit", "把");
        set("cant_sell","官军的装备也来买卖，不要脑袋了么？！\n");
	set("value", 500);
	set("material", "iron");
    }
    init_blade(35);
    set("wield_msg", "$N「唰」的一声抽出一把$n握在手中。\n");
    set("unwield_msg", "$N将手中的$n插入腰间。\n");
    setup();
}
int is_soldier_use(object me)
{
    return 1;
}

