//zaobu_zhizhui.c 皂布直缀
//by trill 04/06/97

#include <armor.h>
inherit CLOTH;



void create() {
  set_name("皂布直缀", ({ "zaobu zhizhui", "cloth" }));
  set_weight(1500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一套青色的对襟布衣，常见到和尚行者穿它。\n");
    set("unit", "套");
    set("value", 300);
    set("material", "cloth");
    set("armor_prop/armor", 1);
  }
  setup();
}
