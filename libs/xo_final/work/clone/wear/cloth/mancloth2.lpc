#include <armor.h>

inherit CLOTH;
inherit F_CLOTHNAME;



void create()
{
    set_name(high_man_cloth(), ({ "yi fu","cloth" }) );
    set_weight(400);
    if( clonep() )
        set_default_object(__FILE__);
    else {
        set("unit", "套");
        set("value",random(300)+200);
        set("material", "cloth");
        set("armor_prop/armor", 4);
    }
    setup();
}
