#include <armor.h>
inherit CLOTH;


void create()
{
    set_name("大红袈裟", ({ "jiasha", "cloth" }) );
    set("long", "一件大红缎面金线镶边的袈裟。\n"
                "看得出来它的主人身价也颇为不凡。\n");
    set_weight(1000);
    if( clonep() )
        set_default_object(__FILE__);
    else
    {
        set("unit", "件");
        set("material", "cloth");
        set("value",1000);
        set("armor_prop/armor", 1);
    }
    setup();
}

