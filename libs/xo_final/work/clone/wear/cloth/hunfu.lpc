#include <ansi.h>
#include <armor.h>
inherit CLOTH;


void create()
{
    set_name( RED"红色婚服"NOR, ({ "hunfu", "fu" }) );
    set_weight(800);
    if( clonep() )
        set_default_object(__FILE__);
    else {        
	set("long","一件红色的婚服，灿烂夺目，益发显得新郎英俊潇洒，光彩照人");
        set("unit", "件");
        set("value", 600);
        set("armor_prop/armor", 1);
        set("material", "cloth");  
	set("armor_prop/personality", 20);
        set("male_only", 1);
    }
    setup();
}
