#include <ansi.h>
#include <armor.h>

inherit HEAD;



void create()
{
    set_name( WHT"银簪子"NOR, ({ "yin zanzi", "zanzi", "yinzanzi" }) );
    set_weight( 15 );                       //三钱；
    if( clonep() )
        set_default_object(__FILE__);
    else 
    {
        set( "long", "这是一件用白银打成的首饰。\n" );
        set( "unit", "根" );
        set( "value", 2000 );                //价格：(1*100)防御力价格
                                            //+(20*15)白银价格
                                            //+(1*50)附加价格=450总价格；
        set( "material", "silver" );        //质地：白银（单价
                                            //２０，０００文／千克）
        set( "armor_prop/armor", 1 );       //防御力：+1；
        set( "armor_prop/personality", 1 ); //附加值：容貌：+1；
        set( "female_only", 1 );            //女性专用。
    }

    setup();
}
