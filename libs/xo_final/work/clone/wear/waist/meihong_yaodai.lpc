#include <armor.h>
inherit WAIST;


void create()
{
    set_name("梅红攒线腰带", ({"meihong yaozi", "yaodai", "waistband"}));
    set_weight(100);
    if ( clonep() )
        set_default_object(__FILE__);
    else {
        set("unit", "根");
        set("value", 200);
        set("material", "leather");
        set("armor_prop/armor", 1);
    }
    setup();
}
