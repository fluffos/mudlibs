#include <armor.h>
inherit WAIST;


void create()
{
    set_name("皮腰带", ({"pi yaozi", "yaodai", "waistband"}));
    set_weight(300);
    if ( clonep() )
        set_default_object(__FILE__);
    else {
        set("unit", "根");
        set("value", 50);
        set("material", "leather");
        set("armor_prop/armor", 1);
    }
    setup();
}
