#include <ansi.h>
#include <armor.h>

inherit ARMOR;

void create()
{
    set_name(CYN"浑天无极战甲"NOR, ({"huntian jia", "jia", "armor", }) );
    set_weight(3000);
    if( clonep() )
    {
        set_default_object(__FILE__);
    }
    else
    {
        set("long",@LONG
一套银光闪闪的铠甲，乃是用精钢打就的上千个钢环连接而成，既轻巧
通风，又结实耐用。是禁军军官们最喜爱的护身甲胄。
LONG);
        set("unit", "套");
        set("value",1000);
        set("material", "steel");
        set("armor_prop/armor", 90000);
        set("armor_prop/defence", 90000);
    }

    setup();
}

void init()
{ 
    if ( !query("owner") )
    {
        set("owner", this_player()->query("id"));
    }
    else if ( query("owner") != this_player()->query("id") )
    {
        destruct(this_object());
        return notify_fail("你从哪里弄来的?\n");
    }

    set("no_give", HIW"此事还是作罢，不要再想了吧...... \n"NOR);
    set("no_put", HIW"丢不得！丢不得！丢不得！丢不得！丢不得！\n"NOR);
    set("no_drop", HIW"丢不得！丢不得！丢不得！丢不得！丢不得！\n"NOR);  
    set("no_get", HIW"好东西你看看就得了，还想拿？小心我打你PP哦...... \n"NOR);
    set("no_sell", HIW"此事还是作罢，不要再想了吧...... \n"NOR);   
} 

int query_autoload()
{
    if( !this_player() )
    {
        return 0;
    }

     return 1;
}

