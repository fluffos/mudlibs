//bailing_qunzi.c
#include <armor.h>
#include <ansi.h>
inherit SKIRT;


void create() {
  set_name(WHT "白绫裙子" NOR, ({ "bailing qunzi", "qunzi", "skirt" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "条");
    set("value", 0);
    set("material", "silk");
    set("armor_prop/armor", 1);
    set("armor_prop/dodge", 4);
    set("female_only", 1);
  }
  setup();
}
