// 海参 /clone/eat/food/haishen.c
// by lala, 1997-12-16

inherit ITEM;

inherit F_FOOD;



void create() {
  set_name("海参", ({ "hai shen" }));
  set_weight(500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", @LONG
浑身乌黑，软软的海参，也是宴席上的珍品。
LONG
    );
    set("unit", "斤");
    set("value", 10000 + random(20000));
    set("food_remaining", 15);
    set("food_supply", 80);
  }
}

int do_eat() {
  return notify_fail("这还是生的，怎么吃呀。\n");
}
