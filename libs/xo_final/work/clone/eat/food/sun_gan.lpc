inherit ITEM;

inherit F_FOOD;



void create()
{
    set_name( "笋干", ({"sun gan", "gan"}) );
    set_weight( 500 );
    if ( clonep() )
            set_default_object( __FILE__ );
    else {
        set( "long", @LONG
笋干也是四川的土特产，也是一种山珍。
LONG
        );
        set( "unit", "斤" );
        set( "value", 5000 + random( 500 ) );
        set( "food_remaining", 15 );
        set( "food_supply", 80 );
    }
}
