#include <ansi.h>
inherit ITEM;
inherit F_FOOD;



void create()
{
    set_name(RED "红烧鲤鱼" NOR, ({"hongshao yu", "yu"}));
    set_weight(1500);
    set("long", @LONG
这是扬州最有名的红烧鲤鱼，鱼肉明目养身，红烧后更味美色香。
LONG
    );        
    if( clonep() ) 
        set_default_object(__FILE__);
    else {
        set("unit", "盘");
        set("value", 5500);
        set("food_remaining", 9);
        set("food_supply", 30);
    }
    setup();
}
