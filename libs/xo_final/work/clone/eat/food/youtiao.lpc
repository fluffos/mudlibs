// common food in city and class . edit by lin on March 4.1997
inherit ITEM;
inherit F_FOOD;


void create() {
  set_name("油条", ({ "yautue", "you tiao" }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一根酥松黄脆的油条。\n");
    set("unit", "根");
    set("value", 200);
    set("food_remaining", 3);
    set("food_supply", 25);
  }
}
