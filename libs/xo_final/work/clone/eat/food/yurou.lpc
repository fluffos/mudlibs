// 鱼肉 /clone/eat/food/yurou.c
// by lala, 1997-12-16

inherit ITEM;

inherit F_FOOD;



void create() {
  set_name("鱼肉", ({ "yu rou" }));
  set_weight(500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", @LONG
这鱼肉才是平常人家的食物，还是比较便宜的。
LONG
    );
    set("unit", "斤");
    set("value", 3000 + random(500));
    set("food_remaining", 15);
    set("food_supply", 80);
  }
}

int do_eat() {
  return notify_fail("这还是生的，怎么吃呀。\n");
}
