// 金华火腿 /clone/eat/food/jinhua_huotui.c
// by lala, 1997-12-16

inherit ITEM;

inherit F_FOOD;



void create() {
  set_name("金华火腿", ({ "jinhua huotui", "huotui" }));
  set_weight(10000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", @LONG
风味特殊，香气浓郁，以色香味形“四绝”著称的金华名产。
LONG
    );
    set("unit", "条");
    set("value", 10000 + random(20000));
    set("food_remaining", 15);
    set("food_supply", 80);
    set("gifts", ([
      "con": 1,
      "dex": -1,
    ]));
  }
}
