// zongzi.c

inherit ITEM;
inherit F_FOOD;



void create()
{
    set_name("火腿粽子", ({"huotui zongzi", "zongzi" }) );
    set_weight(30);//一两
    if( clonep() ) 
        set_default_object(__FILE__);
    else {
        set("unit", "个");
        set("value", 450);
        set("food_remaining", 1);
        set("food_supply", 30);
    }
    setup();
}
