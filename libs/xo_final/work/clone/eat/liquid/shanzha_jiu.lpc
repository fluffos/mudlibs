// 山楂酒 /clone/eat/liquid/shanzha_jiu.c

#include <ansi.h>

inherit ITEM;
inherit F_LIQUID;



void create() {
  set_name(RED "山楂酒" NOR, ({ "shanzha jiu", "jiu" }));
  set_weight(300);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一个小小的装着山楂酒的小酒壶。\n");
    set("unit", "壶");
    set("value", 1250 + random(1000));
    set("max_liquid", 20);
  }
  // because a container can contain different liquid
  // we set it to contain wine at the beginning
  set("liquid", ([
    "type": "alcohol",
    "name": RED "山楂酒" NOR,
    "remaining": 17,
    "drunk_apply": 10,
  ]));
}

void init() {
  this_object()->delete("value");
  add_action("do_drink", "drink");
}
