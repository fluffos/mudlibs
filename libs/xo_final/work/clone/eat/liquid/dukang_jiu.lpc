// dukang_jiu.c 杜康酒 writen by tea 12.10.98

#include <ansi.h>

inherit ITEM;
inherit F_LIQUID;



void create()
{
    set_name(HIB"杜康酒"NOR, ({ "dukang jiu", "jiu" }));
    set_weight(300);
    if (clonep())
        set_default_object(__FILE__);
    else
    {
        set("long", "一壶杜康酒，柔软纯净，芳香浓郁，味长回甜。\n");
        set("unit", "壶");
        set("value", 5000);
        set("max_liquid", 10);
    }
    set("liquid", ([
        "type": "alcohol",
        "name": HIM"宝丰酒"NOR,
        "remaining": 10,
        "drunk_apply": 50,
        "drink_apply": 30,
    ]));
}