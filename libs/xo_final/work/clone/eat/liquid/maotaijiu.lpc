#include <ansi.h>

inherit ITEM;
inherit F_LIQUID;



void create() {
  set_name(RED "茅台酒" NOR, ({ "maotai jiu", "jiu" }));
  set_weight(300);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一壶百年沉酿的茅台，酒香四散直上云霄。\n");
    set("unit", "壶");
    set("value", 5500);
    set("max_liquid", 35);
  }
  // because a container can contain different liquid
  // we set it to contain wine at the beginning
  set("liquid", ([
    "type": "alcohol",
    "name": RED "茅台酒" NOR,
    "remaining": 9,
    "drunk_apply": 5,
  ]));
}

void init() {
  this_object()->delete("value");
  add_action("do_drink", "drink");
}
