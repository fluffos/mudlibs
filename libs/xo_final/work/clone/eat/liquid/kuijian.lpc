inherit ITEM;
inherit F_LIQUID;



void create() {
  //实际玩家买到应该是个茶壶。一开始是满的。
  set_name("魁尖茶", ({ "kuijian cha", "cha hu", "hu", "cha" }));
  set_weight(120);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一壶新沏的魁尖茶，悠悠地冒着香气~~~~~~\n");
    set("unit", "壶");
    set("value", 500);

  }
  set("liquid", ([
    "type": "water",
    "name": "魁尖茶",
    "remaining": 10,
    "drunk_apply": 10,
  ]));
  set("max_liquid", 50);
  setup();

}
