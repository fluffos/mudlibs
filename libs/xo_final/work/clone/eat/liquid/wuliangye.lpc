#include <ansi.h>

inherit ITEM;
inherit F_LIQUID;



void create()
{
    set_name(WHT"五粮液"NOR, ({ "wuliang ye", "jiu" }));
    set_weight(300);
    if (clonep())
        set_default_object(__FILE__);
    else 
    {
        set("long", "一个精致的白玉酒壶，香气四溢。\n");
        set("unit", "壶");
        set("value", 5500);
        set("max_liquid", 45);
    }
    // because a container can contain different liquid
    // we set it to contain wine at the beginning
    set("liquid", ([
        "type": "alcohol",
        "name": WHT"五粮液"NOR,
        "remaining": 7,
        "drunk_apply": 8,
    ]));
}

void init()
{
    this_object()->delete("value");
	add_action("do_drink","drink");
}
