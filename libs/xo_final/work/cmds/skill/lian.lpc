// filename : /cmds/skill/lian.c

#include <ansi.h>

inherit F_CLEAN_UP;

int main( object me, string arg )
{
    int limit, ratio;
    object env;
    string xiuwei_type;
    string weapon_type;
    object my_weapon;

    env = environment(me);

    if ( objectp(env) && env->query("no_fight"))
    {
        if ( userp(me) && !(me->query("doing") && me->query("doing") == "scheme") )
        {
            return notify_fail(HIR "这房间不能用来练功。\n" NOR);
        }
    }

    if ( me->is_lianing() )
    {
        return notify_fail("你已经是在练习了，认真点吧。\n");
    }

    if ( me->is_busy() )
    {
        return notify_fail("你现在无法静下心来练习。\n");
    }

    if ( me->is_fighting() )
    {
        return notify_fail("战斗中还想练习，找死啊。\n");
    }

    if ( me->is_duilianing() )
    {
        return notify_fail("对练的时候请专心些。\n");
    }

    if ( !arg || !me->query_jibie( arg ) )
    {
        return notify_fail( "你要练习什么武功?\n" );
    }
    seteuid( getuid() );

    xiuwei_type = SKILL_D(arg)->query_xiuwei_type();
    if ( !xiuwei_type || "force" == xiuwei_type )
    {
        return notify_fail( "这个东东也可以练习的吗?\n" );
    }

    if ( "unarmed" == xiuwei_type )
    {
        if ( me->query_temp("weapon") )
        {
            return notify_fail( "拿着武器练习拳法，你真有才?\n" );
        }
    }
    else if ( "dodge" != xiuwei_type )
    {
        weapon_type = SKILL_D(arg)->query_weapon_type();
        if ( !weapon_type )
        {
            weapon_type = xiuwei_type;
        }

        my_weapon = me->query_temp("weapon");

        if ( !my_weapon )
        {
            return notify_fail( "你就打算这么干练?\n" );
        }

        if ( (string)my_weapon->query("weapon_type") != weapon_type )
        {
            return notify_fail( "你用的武器不对吧?\n" );
        }
    }

    if ( (me->query("new_master") && me->query("can_improve")) || SKILL_D(arg)->valid_lian(me) )
    {
	    limit = me->query_lian_limit();
	    // 必须在 10% 或 99% 之间
	    if ( limit < 10 )
	    {
	        limit = 10;
	    }
	    else if ( limit > 99 )
	    {
	        limit = 99;
	    }

	    ratio = me->query_char_ratio("sen");
	    if ( ratio < limit )
	    {
		    return notify_fail( "你需要休息一会儿才能再练习!\n" );
	    }

	    message_vision( "$N定了定神, 拉开架势.\n", me );
	    me->start_lian( arg );

	    return 1;
    }

    return 0;
//    return notify_fail( "这种技能不能通过练习来增长!\n" );
}

int help (object me)
{
    write(@HELP
指令格式：lian <武功>

练习是学习和掌握一门武功最基本的方式, 但练习只能使你对武功由生疏到
熟练, 要真正透彻地领悟一门武功, 实战才是最关键的因素.
缺省的情况当你的体能降到 10% 以下, 练习就会自动停止. 你可以设定环
境变量 lian_limit 来控制练习时消耗体能的下限. 注意, 这个值是百分比.
如果你希望主动停止练习, 可以使用 stop 指令.

相关指令：stop

HELP
    );
    return 1;
}
 
