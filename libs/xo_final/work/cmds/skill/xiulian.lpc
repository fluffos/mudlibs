inherit F_CLEAN_UP;

#include <skill.h>
#include <ansi.h>

int exercising(object me);
int halt_exercise(object me);

int main(object me, string arg)
{
    string my_force, force;
    object where;
    int force_jibie;
    
    seteuid(getuid());

    where = environment( me );
    if ( objectp(where) && where->query("no_fight"))
    {
        if ( userp(me) && !(me->query("doing") && me->query("doing") == "scheme") )
        {
            return notify_fail(HIR "这房间不能用来练功。\n" NOR);
        }
    }

    if ( !arg )
    {
        if ( !force = me->query("using_force") )
        {
            this_object()->help();
            return 1;
        }
    }
    else
    {
        force = arg;
    }

    if ( !me->can_act() )
    {
        return notify_fail("你现在正忙着呢。\n");
    }

    if ( me->query_temp( "mask/dazuo" ) )
    {
        return notify_fail("你现在正忙着呢。\n");
    }

    if ( me->is_fighting() )
    {
        return notify_fail("战斗中不能练内功，你不会想走火入魔吧。\n");
    }

    if ( me->is_duilianing() )
    {
        return notify_fail("对练中不能练内功，会走火入魔的。\n");
    }

    force_jibie = me->query_jibie( force );
    if ( !force_jibie )
    {
        return notify_fail( "你没学过这门内功，怎能无师自练呢？\n");
    }

    if ( SKILL_D( force )->query_xiuwei_type() != "force" )
    {
        return notify_fail( "你要练的是内功吗？\n" );
    }

    notify_fail("这门技能不能用来修炼内力。\n");
    if ( !(me->query("new_master") && me->query("can_improve")) && !SKILL_D( force )->valid_xiulian(me) )
    {
        return 0;
    }

    if ( me->query_char_ratio( "kee" ) < 90 ||
         me->query_char_ratio( "sen" ) < 90 ||
         me->query_char_ratio( "gin" ) < 90 )
    { 
        return notify_fail("你现在身体状况不佳，无法产生内息运行全身经脉。\n");
    }

    my_force = me->query("using_force");

    if ( !my_force )
    {
        write( HIY"你开始修炼" + to_chinese(force) + "。\n"NOR );
    }
    else if ( my_force != force )
    {
        write( RED"你决定改修" + to_chinese(force) + "，所以你的内力"
            "必须从新积累。\n"NOR );
        me->set( "force", 0 );
    }

    me->set("using_force", force);    
    if ( me->query_temp("exercise_cost") < 10 )
    {
        me->set_temp("exercise_cost", 200);
    }

    me->set_short_desc(HIW"<修炼内力中>"NOR);
    message_vision("$N盘膝坐下，紧闭双目，开始修炼内力。\n", me);
    write(HIW"你心中存想，缓缓催动体内气息运行周天。\n"
      "只觉体内一股热气直透上来,你进入了一种玄妙的境界......\n"NOR);    

    me->start_busy( (: exercising :), (: halt_exercise :) );

    return 1;
}

int exercising( object me )
{
    string using_force, force_type;
    int force_gain, jilei_gain, xiuwei_gain;
    int exercise_cost;
    int force, max_force, lingwu, my_con, my_spi,level, jibie, max_zouhuo;
    int now_jibie;

    exercise_cost = me->query_temp("exercise_cost");
    using_force = me->query("using_force");

    lingwu = me->query_lingwu( using_force );
    jibie = me->query_jibie( using_force );
    level = (int)SKILL_D(using_force)->query_level();

    my_con = me->query( "con" ); 
    my_spi= me->query("spi");                         
    force = me->query( "force" );
    max_force = me->query( "max_force" );

    force_gain = random(10);
    xiuwei_gain = random(level + 1);

    if ( !random(3) )
    {
        tell_object( me, HIW"你的内息在体内沿着经脉要穴不断运转......\n"NOR );
        if ( !random(4) ) 
        {
            tell_object( me, WHT"你的真气在绵绵不绝地向丹田凝聚......\n"NOR );
        }
        force_gain = ( jibie * level  + my_con + my_spi ) / 5;
        xiuwei_gain++;
    }

    if ( !random( 25 ) )
    {
        jilei_gain = 10;

        if ( !random( 20 ) ) 
        {
        	jilei_gain += sqrt( max_force ) + 20;
            xiuwei_gain++;
        	tell_object( me, HIC"你的内功修为有所提高!\n"NOR );
        }
        me->improve_jilei( using_force, jilei_gain );
    }

    if ( exercise_cost >= 10 )
    {
        if ( userp(me) )
        {
            me->add("force", force_gain);
        }
        me->add_temp( "exercise_cost", -10 );
        return 1;
    }

    message_vision( "$N运功完毕，深深吸了口气，站了起来。\n", me );
    me->delete_temp("exercise_cost");    	
    me->set_short_desc(0);

    if ( me->query( "can_recover_max_force" ) )
    {
        me->add( "max_force", me->query( "recover_force" ) );
        me->set( "can_recover_max_force", 0 );
        write( HIC"你感觉到散入经脉的真气重归丹田. \n" NOR );
    }

    if ( force < max_force * 2 )
    {
        return 0;
    }

    force_type = SKILL_D(using_force)->query_type();
    if ( userp(me) )
    {
        me->add( "max_force", 1 );

        if ( force_type == "yin" )
        {
            me->add( "yin", 1 );
        }
        else if ( force_type == "yang" )
        {
            me->add( "yang", 1 );
        }

        me->set( "force", max_force + 1 );
    }

    write( HIC"你感觉内力充盈，显然内功又有进境。\n"NOR );
    me->improve_xiuwei( "force", xiuwei_gain );

    if ( userp(me) )
    {
        now_jibie = me->query_jibie(using_force);
        if ( max_force > ((jibie * level * 5) + me->query("rendumai") * 10) ) 
        {
            write( HIY"你隐隐觉得，内力好象不受控制，似随时会喷薄而出。\n"NOR );
        }

        if ( now_jibie > 150 && random(3) == 1 ) 
        {
            write( HIG"你的内功级别好像是 " + now_jibie + " 级。\n"NOR );
        }

        if ( me->query( "can_recover_max_force" ) )
        {
            me->add( "max_force", me->query( "recover_force" ) );
            me->set( "can_recover_max_force", 1 );
            write( HIC"你感觉到散入经脉的真气重归丹田. \n" NOR );
        }

        call_out( "show_balance", 5, me );
        max_zouhuo = me->query_max_force(using_force);
        if ( max_force > max_zouhuo )
        {
            switch ( random( 4 ) )
            {
                case 0 :
                    write( HIY "你觉得内息有些混乱。\n" NOR );
                    break;
                case 1 :
                    write( HIY "你感觉到内力有失控的迹象。\n" NOR );
                    break;
                case 2 :
                    write( HIY "你觉得有些胸闷头痛，心里很烦躁。\n" NOR );
                    break;
                default :
                    break;
            }
            if ( !wizardp(me) && !random( 40 + max_zouhuo - max_force) && (max_force > max_zouhuo) )
            {
                remove_call_out("lost_control");
                call_out("lost_control", 1, me);
            }           
        }
    }

    return 0;
}

int halt_exercise(object me)
{
    int force, max_force, jibie; 
    string using_force;

    using_force = me->query( "using_force" );
    jibie = me->query_jibie( using_force );
    force = me->query( "force" );
    max_force = me->query( "max_force" );

    if ( force > max_force * 2 )
    {
        me->set( "force", (int)me->query("max_force") * 2 );
    }

    me->delete_temp( "mask/lian_force" );
    me->delete_temp("exercise_cost");   
    me->set_short_desc(0);
    write( "你强行将体内运行的真气压回丹田，站起身来。\n" );

    if ( userp(me) && !random( 100 + jibie * 10 ) )
    {
        remove_call_out( "lost_control" );
        call_out( "lost_control", 3, me );
    }

    return 1;
}

// trill:  真是不幸 走火入魔了... :-(((
// apply_condition( "zouhuo_rumo" );
// 照这样干，修炼两门内功的人就惨了。。。。。。lin
int lost_control(object me)
{
    int time, max_force, recover_force;
    string using_force;

    if ( !userp(me) )
    {
        return 1;
    }

    max_force = me->query( "max_force" );
    using_force = me->query( "using_force" );
    recover_force = me->query_jibie( using_force ) * 
        SKILL_D( using_force )->query_level() / 20 + 1;
    time = max_force / recover_force / 4; 

    if ( me->query_kar() % 4 == 0 )
    {
        time += random( 4 );
    }

    write( RED "你觉得体内的真气突然失去控制，蹿入全身各处经脉，\n"
        "你浑身如针刺一般，痛苦之至。\n" NOR);

    me->delete_temp("exercise_cost");   
    me->unconcious();

    if ( me->query("age") > 25 )
    {
        me->set( "recover_force", recover_force );
        me->apply_condition( "zouhuo_rumo", time ); 
        me->set( "max_force", max_force / 2 );
        me->set( "yin", me->query( "yin" ) / 2 );
        me->set( "yang", me->query( "yang" ) / 2 );
        me->add( "max_age", -1 );
    }
    else
    {
        me->add( "max_force", -11);
        me->add(SKILL_D(using_force)->query_type(), -11);
        //先不考虑换了内功马上修炼然后stop不加内力就走火的情况了吧
    }

    LOG_D->do_log( me, "你因强行修炼内力，控制不住自己的内息，走火入魔了。" );
    return 1;
}

// qyz:实现内功里阴与阳的作用。
void show_balance( object me )
{
    int yin, yang, chazhi;

    if ( !userp(me) )
    {
        return;
    }

    yin = me->query( "yin" );
    yang = me->query( "yang" );

    if ( ( yin - yang ) >= 0 )
    {
        chazhi = ( yin - yang );
    }
    else
    {
        chazhi = ( yang - yin );
    }

    if ( me->query( "force_ok" ) || me->query("age") < 40 )
    {
        return;
    }

    if ( yin > 1000 && yang > 1000 && chazhi < 6 )
    {
        tell_object( me, HIW"你突然觉得体内的真气流动不同寻常，体内阴阳二气\n"
            "正在慢慢地融合......\n"NOR );

        if ( !random(10) )
        {
            tell_object( me, HIC"终于，你体内的真气完全汇交融合为一体，只觉得全身\n"
                "内力充盈，你的内功已经大成了。\n"NOR );   
            me->add( "max_force", 1000 );
            LOG_D->do_log( me, "你成功的达成了阴阳双修，内力大增。" );
            me->set( "force", me->query("max_force") );
            me->set( "force_ok", 1 );
        }
        else
        {
            tell_object( me, HIM"在内功精进的同时，你隐隐觉得体内的阴阳二气\n"
                "似乎在互相冲撞，真气的流动有些不大顺畅。\n"NOR);
        }
    }

    return;
}

int help(object me)
{
    write( @HELP
指令格式 : xiulian [ 内功名称 ] 

运气练功，控制体内的气在各经脉间流动，藉以训练人体肌肉骨骼的耐
力、爆发力，并且用内力的形式将能量储备下来。
修练时你的生命、精神、体能的值都必须大于 90%。

HELP
    );
    return 1;
}
