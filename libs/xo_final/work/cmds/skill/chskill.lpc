#include <ansi.h>

inherit F_CLEAN_UP;

int sort_skill(string file) {
  int i;

  if (!sscanf(file, "%*s.lpc")) {
    return 0;
  }

  i = strlen(file);
  while (i--) {
    if (file[i] == '.' || file[i] == '-' || file[i] == '_') {
      continue;
    }

    if (file[i] < 'a' || file[i] > 'z') {
      return 0;
    }
  }

  return 1;
}

int main(object me, string arg) {
  string exert, str, *file;

  int i = 0, j = 0;
  string *xiuwei_type = KUNGFU_D->all_xiuwei_type();
  string *xiuwei_chinese = KUNGFU_D->all_xiuwei_chinese();
  int jibie = 0;
  int index = -1, new_index = -1;
  object skill;

  seteuid(getuid());

  if (!arg) {
    return notify_fail("指令格式 : chskill [武功名称]\n");
  }

  xiuwei_type += ({ "whip", "axe", "staff", "spear", "dagger", "pen", "fan", "hammer" });
  xiuwei_chinese += ({ "长兵刃", "长兵刃", "长兵刃", "长兵刃", "短兵刃", "短兵刃", "短兵刃", "短兵刃" });

  if (!(jibie = me->query_jibie(arg)) && -1 == (index = member_array(arg, xiuwei_type))) {
    return notify_fail("你要查对什么技能？\n");
  }

  if (0 < jibie && file_size(SKILL_D(arg) + ".lpc") < 1) {
    return notify_fail("错误！你要查对技能文件已经消失，请通知巫师。\n");
  }

  if (stringp(SKILL_D(arg))) {
    skill = load_object(SKILL_D(arg));
  }
  if (0 < jibie) {
    str = sprintf(
      "\n┌%-24s────────────────────────┐\n",
      HIW "【" + to_chinese(arg) + HIW "功能表】" NOR
    );
  } else {
    str = sprintf(
      "\n┌%-24s────────────────────────┐\n",
      HIW "【" + xiuwei_chinese[index] + HIW "功能表】" NOR
    );
  }

  if (0 < jibie) {
    str += sprintf("│" HIY "等级" NOR "：  %s  \t\t\t      " HIY "类别" NOR "：  %-9s%7s  \n",
      "/cmds/comm/skills"->skill_level(skill->type(), me->query_jibie(arg))
      , skill->type(), "│");
  }

  str += "│\t\t\t\t\t\t\t\t    │\n";

  str += "│" HIM "修为类型" NOR "：\t\t\t\t\t\t\t    │\n";
  if (0 < jibie) {
    new_index = member_array(skill->query_xiuwei_type(), xiuwei_type);

    if (-1 != new_index) {
      str += sprintf(
        "│\t%-28s ",
        HIC + xiuwei_chinese[new_index] + "(" + skill->query_xiuwei_type() + ")" NOR
      );
    }
  } else {
    str += sprintf("│\t%-28s ", HIC + xiuwei_chinese[index] + "(" + arg + ")" NOR);
  }
  str += "\t\t\t\t\t    │\n";

  j = 0;
  if (skill && stringp(exert = skill->exert_function_file(""))) {
    file = get_dir(exert);
    if (sizeof(file) > 0) {
      file = filter_array(file, (: sort_skill :));
      j = sizeof(file);
    }
  }

  if (j && j > 0) {
    str += "├─────────────────────────────────┤\n";

    str += "│" HIG "内功方面(exert + )" NOR "：\t\t\t\t\t\t    ";
    for (i = 0; i < j; i++) {
      if (i % 4 == 0) {
        str += "│\n│\t";
      }

      str += sprintf("%-14s ", YEL + replace_string(file[i], ".lpc", "") + NOR);
      if (i > j - 2) {
        switch (i % 4) {
          case 0: str += "\t\t\t\t\t        "; break;
          case 1: str += "\t\t\t        "; break;
          case 2: str += "\t\t    "; break;
          default: break;
        }
      }
    }
    str += "│\n";
  }

  j = 0;
  if (skill && stringp(exert = skill->perform_action_file(""))) {
    file = get_dir(exert);
    if (sizeof(file) > 0) {
      file = filter_array(file, (: sort_skill :));
      j = sizeof(file);
    }
  }

  if (j && j > 0) {
    str = str + "├─────────────────────────────────┤\n";
    str += "│" HIG "外功方面(perform + )" NOR "：\t\t\t\t\t    ";

    for (i = 0; i < j; i++) {
      if (i % 4 == 0) {
        str += "│\n│\t";
      }
      str += sprintf("%-14s ", WHT + replace_string(file[i], ".lpc", "") + NOR);
      if (i > j - 2) {
        switch (i % 4) {
          case 0: str += "\t\t\t\t        "; break;
          case 1: str += "\t\t        "; break;
          case 2: str += "\t    "; break;
          default: break;
        }
      }
    }
    str += "│\n";
  }

  str += "└─────────────────────────────────┘\n";
  write(str);
  return 1;
}

int help(object me) {
  write("\n指令格式 : chskill [武功名称]\n");
  write(@HELP
这个指令可以让你查询此项技能的功能和数据。

内功方面显示可运用(exert)的内功。

外功方面显示可使用(perform)的外功。
HELP);

  return 1;
}
