// exert.c writen by tea 10.15.98
#include <skill.h>
#include <ansi.h>

inherit F_CLEAN_UP;

int main(object me, string arg)
{
    string force;
    int delay;
    int cdtime = 0;

    seteuid(getuid());

    if ( me->is_busy() )
    {
        return notify_fail("你上一个动作没有完成，不能施用内功。\n");
    }

    if ( !arg )
    {
        return notify_fail("你要用内功做什麽？\n");
    }

    if ( !environment(me) )
    {
        return notify_fail("你在虚空中无法运功。\n");
    }

    if ( environment(me)->query("no_fight") )
    {
        return notify_fail("你无法在这里使用内功。\n");
    }

    if ( environment(me)->query("no_kill") )
    {
        return notify_fail( "这里不准杀人，也不准使用绝技！\n");
    }

    if ( environment(me)->query("safeplace") )
    {
        return notify_fail( "这里不准使用伤害人的绝技！\n");
    }

    if ( me->query_condition("no_exert") )
    {
        return notify_fail(HIR "你只觉得内息一阵紊乱，根本无法控制内息。\n" NOR);
    }

    if ( !(force = me->query("using_force")) )
    {
        return notify_fail("你现在还不会内功。\n");
    }

    if ( file_size( SKILL_D(force) + ".lpc" ) == -1 )
    {
        return notify_fail("你现在没有使用任何内功。\n");
    }

    if ( 100 > me->query_jibie(force) )
    {
        return notify_fail("你的内功等级不够。\n");
    }

    if ( time() < me->query_temp("global_cd/exert") )
    {
        return notify_fail("你的内息还没调匀。\n");
    }

    if ( me->query("eff_kee") < me->query("max_kee") / 2
        || me->query("eff_gin") < me->query("max_gin") / 2
        || me->query("eff_sen") < me->query("max_sen") / 2 )
    {
        return notify_fail("你已经受伤过重，再运真气只怕有生命危险！\n");
    }

    delay = 1 + random(2);

    switch ( me->query_xiuwei_dengji("force") )
    {
        case 0:
        case 1:
            delay = 1 + random(3);
            break;

        case 2:
            delay = 1 + random(2);
            break;

        case 3:
            if ( !random(10) )
            {
                delay = 0;
            }
            break;

        case 4:
            if ( !random(8) )
            {
                delay = 0;
            }
            break;

        case 5:
            if ( !random(6) )
            {
                delay = 0;
            }
            break;

        case 6:
            if ( !random(4) )
            {
                delay = 0;
            }
            break;

        case 7:
            if ( !random(3) )
            {
                delay = 0;
            }
            break;

        case 8:
            if ( !random(2) )
            {
                delay = 0;
            }
            break;

        case 9:
        default:
            if ( random(3) )
            {
                delay = 0;
            }
            break;
    }

    if ( cdtime = SKILL_D(force)->exert_function(me, arg) )
    {
        me->set_temp("global_cd/exert", time() + delay + cdtime);
        return 1;
    }

    if ( cdtime = SKILL_D("force")->exert_function(me, arg) )
    {
        me->set_temp("global_cd/exert", time() + delay + cdtime);
        return 1;
    }

    return 0;
}

int help(object me)
{
    write(@HELP
指令格式：exert <功能名称> [on <施用对象>] [with <内力点数>] 
用内力进行一些特异功能，你必需要指定<功能名称>，<施用对象>则可有可无。
在你使用某一种内功的特异功能之前，你必须先学会一种内功。
以下是一些内功常见的功用，不一定所有内功都有这些功能，你必须试试看才知道。
一级内功修为：      战斗中使用通用内功，cd 1-3
    heal                用内力替自己疗伤
    recover             用内力恢复自己的生命
    refresh             用内力恢复自己的精神
    regenerate          用内力恢复自己的体能

二级内功修为：      战斗中使用通用内功，cd 1-2
    powerup             增强自己的命中
    parry               增强自己的招架
    dodge               增强自己的躲闪

三级内功修为：      战斗中使用通用内功，1/10概率无cd
    shield              增强自己的物理防御
    protect             增强自己的内功防御

四级内功修为：      战斗中使用通用内功，1/8概率无cd
    dispel              驱毒，只能替自己驱毒
    shot                制作毒药并弹射攻击敌人

五级内功修为：      战斗中使用通用内功，1/6概率无cd
    dispel              驱毒，可以替他人驱毒
    lifeheal            用内力替他人疗伤

六级内功修为：      战斗中使用通用内功，1/4概率无cd
    revive              救醒昏迷的其他人

七级内功修为：      战斗中使用通用内功，1/3概率无cd
    transfer            传送内力给他人

八级内功修为：      战斗中使用通用内功，1/2概率无cd
    powerup             同时增强自己的命中、招架和躲闪

九级内功修为：      战斗中使用通用内功，2/3概率无cd
    shield              同时增强自身的物理和内功防御
HELP
        );
        return 1;
}

