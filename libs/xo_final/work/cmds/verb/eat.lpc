#include <ansi.h>


inherit F_CLEAN_UP;

mixed main(object who, string arg) {
  if (!arg)
    return notify_fail("你要吃什么？\n");
  foreach (object ob in all_inventory(this_player()))
    if (ob->id(arg) && ob->is_food())
      return ob->do_eat(arg);
  foreach (object ob in all_inventory(environment(this_player())))
    if (ob->id(arg) && ob->is_food())
      return ob->do_eat(arg);
  return notify_fail("哪里有能吃的 " + arg + "？\n");
}
