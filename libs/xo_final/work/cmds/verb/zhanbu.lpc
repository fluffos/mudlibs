// where.c
// 06-14-95
#include <command.h>
#include <ansi.h>


inherit F_CLEAN_UP;

int main(object me, string str)
{
	object ob, where, *ob_list;
	int i;
	int hour;
        mapping fam;
      
       hour = (time() % 86400) / 3600 + 8;
       if (!str) return notify_fail("指令格式：zhanbu <人物>\n"); 
        if( me->query("id") == str )
           return notify_fail("你自己好端端的，还是发烧了？\n");
        if( environment( me )->query("short") != YEL"八卦台"NOR )
        return notify_fail("你没有站在八卦台上，怎么能掐算占卜啊？\n");
 //   if( me->query("peaceful"))
//    {
 //       return notify_fail("你到底想干什么呢?\n");
  //  }   
        if( me->query("force") < 8000 )
        return notify_fail("你的内力不足，还不能化内力为精力去占卜。\n"); 
        if ( (int)me->query_jibie("qimen-bagua") < 150 )
        return notify_fail("你的奇门八卦学的不精，未得木灵子真传，如何能占卜得出来？\n");
        if ( (int)me->query_jibie("kongdong-xinfa") < 200 )
        return notify_fail("你的崆峒心法的等级不够，如何能占卜得出来？\n");
        fam = me->query("family");
//        if( ! fam || fam["family_name"] != "崆峒派" )
//        return notify_fail("你不是崆峒派弟子，未得木灵子传授，如何能够占卜？\n");
        message_vision(HIG"$N捏着手指，按照子、丑、寅、卯、辰、巳、午、未、申、酉、戌、亥的方位，\n仔细的掐算着。。。\n"NOR, me);
	ob = find_player(str);
        if( !ob || !me->visible(ob)) return notify_fail("现在没这个人。\n");
        if( hour>=22 || hour<=8 )    
        return notify_fail("这个时候人家还在睡觉呢，不要害人了吧？\n");           
        if ( userp(ob) && wiz_level(ob))
             return notify_fail("你没有办法知道巫师的位置。\n");
	if( !ob ) ob = find_living(str);
	if( !ob || !me->visible(ob)) {
		str = resolve_path(me->query("cwd"), str);
		ob_list = children(str);
		for(i=0; i<sizeof(ob_list); i++) {
			if( !ob = environment(ob_list[i]) ) continue;
			printf("%O\n", ob );
		}
		return 1;
	}
	where = environment(ob);
	if (!where) return notify_fail("这个人不知道在那里耶...\n");
//		(string)ob->query("id"),
//		(string)where->query("short"),
//		(string)file_name(where),
       if (random(me->query_jibie("kongdong-xinfa")/10)<10+random(80))
       {
       	message_vision(HIC"突然一个晴天霹雳，正打在$N的脑门上。\n"NOR,me);
        me->set("force",0);
	me->unconcious();
	return 1;
         }
	write(sprintf("你全神贯注,凝视天空的变幻的景象，忽然感觉到%s正躲在%s\n",
		(string)ob->short(),
        repeat_string("=-",3)));
       LOOK_CMD->look_room(where);
       me->set("force",0);
	return 1;
}

int help(object me)
{
	write(@HELP
指令格式: zhanbu <玩家的 ID>

这个指令是用算出其他玩家目前所在的位置.
但是你必须是崆峒派的弟子，增加道士的能力，嘿嘿。
还要学会奇门八卦到150级,还要学会崆峒心法到200级。
但是必须站在倥侗的八卦台上才能占卜。

HELP
	);
	return 1;
}

