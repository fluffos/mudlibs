// filename : /cmds/app/goto.c
#include <options.h>
//

inherit F_CLEAN_UP;
#include <ansi.h>
int main(object me, string arg) {
  int j;
  int goto_inventory = 0;
  object obj;
  object *all;
  string msg;

  if (!wizardp(me) && !avatarp(me))
    return 0;
  if (!arg) arg = "/d/place/wiz/inn";

  if (sscanf(arg, "-i %s", arg) && wizardp(me)) goto_inventory = 1;
  //       arg = "/d/place/wiz/inn";        
  if (me->is_busy()) {
    message_vision(HIY "$N很怪异的趴在地上想钻进去，可是能力好象有些不够，急得满头大汗......\n" NOR, me);
    return 1;
  }
  if (me->query_temp("will_quit")) {
    message_vision(HIG "$N很怪异的趴在地上想钻进去，可是能力好象有些不够，急得满头大汗......\n" NOR, me);
    return 1;
  }
  seteuid(geteuid(me));
  //     obj = find_player(arg);
  obj = LOGIN_D->find_body(arg);
  if (!obj) obj = find_living(arg);
  if (!obj || !me->visible(obj)) {
    arg = resolve_path(me->query("cwd"), arg);
    if (!sscanf(arg, "%*s.lpc")) arg += ".lpc";
    if (!(obj = find_object(arg)) && !(obj = load_object(arg))) {
      //write( sprintf( "filename is %s\n", arg ) );
      if (file_size(arg) >= 0)
        return me->move(arg);
      return notify_fail("没有这个玩家、生物、或地方。\n");
    }
  }
  if (avatarp(me) && obj->query("env/refuse_goto"))
    return notify_fail("对不起，对方拒绝你靠近他。\n");
  if (wizardp(me) && me->query("env/invisibility") && obj->query("env/refuse_goto"))
    return notify_fail("对不起，隐身状态视同精灵。\n");
  if (!goto_inventory && environment(obj))
    obj = environment(obj);
  if (obj == me) return notify_fail("你以为你是谁呀，神仙也不能违背物理定律。\n");

  if (!obj) return notify_fail("这个物件没有环境可以 goto。\n");

  if (!me->query("env/invisibility")) {
    if (stringp(msg = me->query("env/msg_mout")))
      message_vision(msg + "\n", me);
    else
      message_vision(HIW "$N突然化成一缕青烟散去。。。。。。\n" NOR, me);
  }
  //    if(avatarp(me))
  //    CHANNEL_D->do_channel( me, "sysinfo",
  //                "Now I fly to "  + arg+":: HaHaHa!!?"); 
  all = all_inventory(me);
  for (j = 0; j < sizeof(all); j++)
    if (avatarp(me) && me->query("gender") != "女性" && !wizardp(me)) {
      message_vision("$N把$n往地下狠狠地一摔。\n", me, all[j]);
      all[j]->move("/d/city/hangzhou/mumu/void");
    }
  me->move(obj);
  if (!me->query("env/invisibility")) {
    if (stringp(msg = me->query("env/msg_min")))
      message_vision(msg + "\n", me);
    else
      message_vision(HIW "$N突然从云端跳了出来。。。。。。\n" NOR, me);
  }
  return 1;
}


int help(object me) {
  write(@HELP
指令格式 : goto [-i] <目标>
 
这个指令会将你传送到指定的目标. 目标可以是一个living 或房间
的档名. 如果目标是living , 你会被移到跟那个人同样的环境.
如果有加上 -i 参数且目标是 living, 则你会被移到该 living 的
的 inventory 中.
 
HELP
  );
  return 1;
}
