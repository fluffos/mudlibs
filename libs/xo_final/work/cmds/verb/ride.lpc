// ride.c 骑（马、牛、驴、骡子、猪？？？……）
#include <ansi.h>



inherit F_CLEAN_UP;

int do_ride(object me, object ob);
int do_ride_none(object me);

int main(object me, string arg)
{
    object ob;

    if ( !arg )
    {
        return notify_fail("指令格式：ride <动物>|none。\n");
    }

    if ( arg == "none" )
    {
        if ( me->query_temp_marks("is_riding") == 0 )
        {
            return notify_fail("你现在什么也没有骑啊，从哪儿下来呢？\n");
        }

        do_ride_none(me);
        return 1;
    }

    if ( !objectp(ob = present(arg, environment(me))) )
    {
        return notify_fail("这里没有 " + arg + "。\n");
    }

    if ( ob == me )
    {
        return notify_fail("想骑自己吗？你以为自己是什么动物呢？\n");
    }

    if ( !ob->query("can_be_ride") )
    {
        return notify_fail("什么？" + ob->name() + "恐怕不可以骑。\n");
    }

    if ( me->query_temp_marks("is_riding") != 0 )
    {
        return notify_fail("你现在正骑着一" + me->query_temp_marks("is_riding") + "呢，得先下来才行。\n");
    }

    if ( !me->can_act() )
    {
        return notify_fail("你现在正忙着呢，无法脱身！\n");
    }

    if ( ob->query("is_rided_by") )
    {
        return notify_fail("有人正骑着呢！\n");
    }
        
    do_ride(me, ob);

    switch ( to_int(sqrt( me->query_xiuwei_by_type( "dodge" ) + 1 ) / 10) )
    {
        case 0:
            message_vision( YEL"$N牵过一" + ob->query("unit") 
                + "$n" + YEL"，小心翼翼地骑了上去，看起来笨手笨脚的。\n"NOR, me, ob);
            break;
        case 1:
            message_vision( YEL"$N手脚麻利地骑上了一" + ob->query("unit")
                + "$n" + YEL"。\n"NOR, me, ob );
            break;
        case 2:
            message_vision( YEL"$N用手一撑$n" + YEL"的背，一跃而上。\n"NOR, me, ob );
            break;
        case 3:
            message_vision( YEL"$N轻轻跃上$n，$n" + YEL"跃跃欲奔。\n"NOR, me, ob );
            break;
        default:
            message_vision( YEL"$N身形晃动，飘上$n" + YEL"背。\n"NOR, me, ob );
            break;
    }

    return 1;
}

int do_ride(object me, object ob)
{
    me->set_temp_marks("is_riding", ob->query("unit") + ob->query("name"));
    me->set_temp_marks("zuoji/speed", ob->query("speed"));
    me->set_temp_marks("zuoji/xingcheng", ob->query("xingcheng"));
    me->set_temp_marks("zuoji/max_xingcheng", ob->query("max_xingcheng"));
    ob->set("is_rided_by", me->query("id"));
    //ob->move( HALL );
    return 1;
}

int do_ride_none(object me)
{
    object ob, this, *inv;
    int i = 0;

    if ( !this = find_object( HALL ) )
    {
        this = load_object( HALL );
    }
    inv = all_inventory(this);
    while ( i < sizeof(inv) && i >= 0 )
    {
        if ( inv[i]->query("is_rided_by") == me->query("id") )
        {
            ob = inv[i];
            i = -10;
        }
        i++;    
    }

    if ( i >= 0 )
    {
        return notify_fail("发现错误！\n");
    }

    message_vision( YEL"$N从$n" + YEL"上跳下。\n"NOR, me, ob);
    ob->move( environment(me) );
    ob->delele("is_rided_by");
    ob->set("xingcheng", me->query_temp_marks("zuoji/xingcheng"));

    me->delete_temp_marks("is_riding");
    me->delete_temp_marks("zuoji");

    return 1;
}

int help (object me)
{
    write(@HELP
指令格式 : ride [<动物>|none]
 
这个指令让你能骑上动物，当然这种动物要可以骑才行。
如果输入 ride none  则可以从你正在骑的动物上下来。
 
HELP
    );
    return 1;
}

