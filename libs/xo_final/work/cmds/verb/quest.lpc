// quest.c
#include <ansi.h>

inherit F_CLEAN_UP;

int write_newquest(object me)
{
    mapping quest;
    string type;

    if ( !(quest =  me->query("newquest")))
    {
        write("你现在没有任何任务！\n");
        return 1;
    }

    switch ( quest["result"] )
    {
        case "reward":
            type = "完成";
            break;

        case "delay":
            type = "延迟完成";
            break;

        case "fail":
            type = "失败";
            break;

        case "cancel":
            type = "放弃";
            break;

        case "wait":
            type = "接到";
            break;

        case "accomplish":
            type = "等待交差";
            break;

        default:
            write("你现在没有任何任务！\n");
            return 1;
            break;
    }

    if ( stringp(quest["target"]) )
    {
        write("你刚" + type + "的任务是去" + quest["kind"] + "【" + quest["target"] + "】" + "。\n");
    }
    else if ( objectp(quest["target"]) )
    {
        write("你刚" + type + "的任务是去" + quest["kind"] + "【" + quest["target"]->query("name") + "】" + "。\n");
    }
    else
    {
        write("你刚" + type + "任务。\n");
    }

    if ( quest["cd_time"] >= time() )
    {
        write("距离下一个任务: " + time_string(quest["cd_time"] - time()) + "。\n");
    }
    else
    {
        write("现在可以接收下一个任务了。\n");
    }

    if ( "wait" != quest["result"] )
    {
        return 1;
    }

    if ( !undefinedp(quest["where"]) )
    {
        write("任务地点在: " + quest["where"] + "。\n");
    }

    if ( !undefinedp(quest["level"]) )
    {
        write("任务难度: " + chinese_number(quest["level"]) + "。\n");
    }

    if ( !undefinedp(quest["master"]) )
    {
        write("任务发放人: " + quest["master_name"] + "(" + quest["master"] + ")" + "。\n");
    }

    if ( !undefinedp(quest["time"]) && 0 < quest["time"] )
    {
        if ( quest["time"] >= time() )
        {
            write("任务剩余时间: " + time_string(quest["time"] - time()) + "。\n");
        }
        else
        {
            write("任务已经超时。\n");
        }
    }

	return 1;
}

int write_oldquest(object me)
{
    mapping quest;
    string type;

    if ( !(quest =  me->query("oldquest")))
    {
        write("你现在没有任何任务！\n");
        return 1;
    }

    type = quest["status"];

    write("你刚" + type + "的任务是" + "【" + quest["quest"] + "】" + "。\n");

    if ( "等待" != quest["status"] )
    {
        return 1;
    }

    if ( stringp(quest["prompt"]) )
    {
        write(quest["prompt"]);
    }

    if ( !undefinedp(quest["master"]) )
    {
        write("任务发放人: " + quest["master_name"] + "(" + quest["master"] + ")" + "。\n");
    }

    if ( !undefinedp(quest["task_time"]) && 0 < quest["task_time"] )
    {
        if ( quest["task_time"] >= time() )
        {
            write("任务剩余时间: " + time_string(quest["task_time"] - time()) + "。\n");
        }
        else
        {
            write("任务已经超时。\n");
        }
    }

	return 1;
}

int main(object me, string arg)
{
    write("=========================新版任务==============================\n");
    write_newquest(me);
    write("===============================================================\n");
    write("===============================================================\n");
    write("=========================门派任务==============================\n");
    write_oldquest(me);
    write("===============================================================\n");

	return 1;
}

int help(object me)
{
    write(@HELP
指令格式 : quest
 
这个指令可以显示出你当前的任务。
HELP
    );
    return 1;
}

