// clean.c
#include <weapon.h>
#include <ansi.h>


inherit F_CLEAN_UP;

int main( object me )
{   
    if (me->query("age")>14)
    {
    message_vision(HIY"$N轻轻地闭上双眼，希望再得到上天的眷顾，却不料一道闪电劈了下来。\n"NOR, me);
    return 1;
    }
    if (me->query_temp("daogao"))
    return notify_fail("你正在祷告!!!!!!\n");
    message_vision(HIG"$N轻轻地闭上双眼，默默的祈祷着……\n"NOR, me);
    me->set_temp("daogao",1);    
    call_out("daogao",2,me);
    return 1;
}
int daogao(object me)
{
    if(!objectp(me)) return 0;
    me->set("con",1+random(30));
    me->set("int",1+random(35));
    me->set("str",1+random(30));
    me->set("kar",1+random(35));
    me->set("cps",1+random(30));
    me->set("per",random(35));
    me->set("spi",1+random(30));
    me->set("dex",1+random(30));
    me->set("cor",1+random(30));
    me->set("locker/newman",1);
    message_vision(HIC"$N忽然全身泛起一片霞光，莫不是真的有神仙???!!!\n"NOR, me);
    me->delete_temp("daogao");   
    return 1;	
	
}
