#include <ansi.h>


inherit F_CLEAN_UP;

int do_xiadu(object me, object ob);

int main(object me, string arg) {
  object ob;

  if (!arg) return notify_fail("唔，好主意!\n");
  if (!objectp(ob = present(arg, environment(me))))
    return notify_fail("这里没有 " + arg + "。\n");
  if (me->query_temp_marks("is_xiadu") != 0)
    return notify_fail("你正在伺机下毒!\n");
  if (me->query("force") <= me->query("max_force") * 1.5)
    return notify_fail("你的内力不够。\n");
  if (ob->query("name") != me->query("yipin_task/obname")
    || me->query("yipin_task/keyname") != "活捉")
    return notify_fail("现在没必要下毒吧？坏名声的。\n");
  message_vision(HIG "$N正在偷偷摸摸的下毒，不知想害谁。\n" NOR, me);
  do_xiadu(me, ob);
  return 1;
}

int do_xiadu(object me, object ob) {

  me->set_temp_marks("is_xiadu", 1);
  me->start_busy(5);
  if (random(5) == 1) {
    ob->unconcious();
    message_vision(HIW "$N居然下毒成功了。\n" NOR, me);
  } else
    message_vision(HIW "$N一着不慎，居然被$n发现了。\n" NOR, me, ob);
  me->set("force", 0);
  me->delete_temp_marks("is_xiadu", 1);
  return 1;
}


int help(object me) {
  write(@HELP
指令格式 : xiadu <人物>
 
这个指令让你对某些江湖经验不足之人下毒。
 
HELP
  );
  return 1;
}
