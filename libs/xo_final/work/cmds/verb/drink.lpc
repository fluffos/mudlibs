//cmds: drink.c
#include <ansi.h>

inherit F_CLEAN_UP;
//作用，在可以打水的房间中，没有装水的容器也可以喝水。
int main( object me, string arg )
{
    object env;
    string type,name,place;

    if( arg ) 
        return 0;

    env = environment(me);
    if ( !env ) return 0;

    type = env->query("watertype");
    if(!type) type = "water";
    place = env->query("fillplace");
    name = env->query("watername");
    if ( !name ) name = "清水";

      if ( me->is_busy() )
        return notify_fail("你上一个动作还没有完成。\n");

    if ( me->is_fighting())
        return notify_fail(HIW "你正在战斗中，不能喝水!!\n" NOR);

    if ( (int)me->query("water") >= me->max_water_capacity() )
        return notify_fail("你已经喝太多了，再也灌不下一滴水了。\n");

    if ( !env->query("resource/water") )
        return notify_fail("这里没有地方可以装水。\n");

    message_vision( "$N俯下身去，从"+place+"里掬了一捧"+ name + "喝了下去。\n", me );

//drink_bonus:
    me->add("water",30);
    if( type == "alcohol" )
       me->apply_condition("drunk",(int)me->query_condition("drunk")
+ 6);
    return 1;
}
 
