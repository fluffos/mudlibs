#include <ansi.h>
#include <combat.h>


inherit F_CLEAN_UP;

void printlevel(object);
int querylevel(object,string,int);
void create()
{
seteuid(ROOT_UID);
}

int main(object me, string arg)
{
    object ob,here = environment( me );
/*    
    if( !wizardp(me) ){
        return 0;
    }
    if( !arg )
    {
        foreach ( object user in filter( users(), (: environment($1) :) ) )
            printlevel(user);
		return 1;
    }
*/	if ( !(ob = get_object(arg)) )
	    return notify_fail("这里没有这个人。。\n");
	if ( !ob->is_character() )
	    return notify_fail("你这是怎么回事！！！\n");
        if ( ob->query("gin")<50)
            return notify_fail(GRN"你只觉得头晕眼花。\n"NOR  );
   if ( ob!=this_player()&&userp(ob)||ob->query("nostare"))
            return notify_fail(HIB"你有些心虚，不敢把目光过久的停在同一处。\n"NOR  );
        if ( !objectp( ob = present( arg, here ) ) )
            return notify_fail( "看清楚些，这里没有这个人。\n" );
            tell_object( me, WHT"你凭经验仔细的打量了一下"+ob->query("name")+"，获得如下信息：\n"NOR );    
	ob->add("gin",-50);
        printlevel(ob);
    return 1;
}

void printlevel(object ob)
{
    ob->select_attack_action();
    ob->select_parry_action();
    ob->select_dodge_action();
    printf(YEL"%s 的攻击因子：%-10d"NOR,ob->name(),
           COMBAT_D->wugong_power(ob, ob->query_temp("attack_skill"),
              TYPE_ATTACK));
    printf(GRN" 招架因子：%-10d"NOR,
           COMBAT_D->wugong_power(ob, ob->query_temp("parry_skill"),
              TYPE_PARRY));
    printf(CYN" 躲闪因子：%-10d\n"NOR,
           COMBAT_D->wugong_power(ob, ob->query_temp("dodge_skill"),
              TYPE_DODGE));
}
