// nod.c 答应对方的求婚。
// by trill 06/15/97



inherit F_CLEAN_UP;

int promise_marriage(object, string);

int main(object me, string arg)
{
    mapping prop;
    string *id;
    int i;

    if (me->query("gender") != "女性")
        return 0;
    prop = me->query_temp("be_proposed");
    if (!prop)
        return 0;

    id = keys(prop);
    if (!sizeof(id))
    {
        me->delete("be_proposed");
        return 0;
    }
    if (sizeof(id) == 1)
    {
        if (!arg || arg == id[0])
        {
            promise_marriage(me, id[0]);
            return 1;
        }
        return 0;
    }

    if (!arg)
    {
        write("你要答应谁的求婚呢？\n");
        return 1;
    }

    for (i = 0; i < sizeof(id); i++)
    {
        if (id[i] == arg)
        {
            promise_marriage(me, id[i]);
            return 1;
        }
    }
    write("你的求婚者中没有这个人。\n");
    return 1;
}

int promise_marriage(object me, string id)
{
    object you;
    string msg, log_msg;

    if (!present(id, environment(this_player())))
    {
        //write( "真是可惜，他已经走了，暂时离开这个世界了。\n" );
        write("这里没有这个人耶..\n");
        return 1;
    }
    you = find_player(id);
    if (stringp(msg = me->query("env/nod_msg")))
    {
        message_vision(msg, me, you);
        log_msg = replace_string(msg, "$N", me->name());
        log_msg = replace_string(log_msg, "$n", you->name());
        log_msg = sprintf("    %s promise %s\n%s\n",
                          me->query("id"), you->query("id"), log_msg);
        log_file("static/QIUHUN_MSG", log_msg);
    }
    else
        message_vision("$N羞涩的冲着$n点点头。\n", me, you);
    tell_object(you, "哇，" + me->name() + "答应了你的求婚了。\n");
    me->delete_temp("be_proposed");
    me->set("will_marry", you->query("id"));
    you->set("will_marry", me->query("id"));
    // 承诺 维持一年，一年还不结婚，只好取消了
    me->apply_condition("will_marry", 2160);
    you->apply_condtion("will_marry", 2160);
    return 1;
}

int help(object me)
{// *INDENT-OFF*
    write(@HELP
指令格式: nod <某个求婚者ID>

答应你的某个求婚者的求婚。若只有一个求婚者，那只要输入 nod 就可以了。
这个指令女性专用。

相关的帮助：help marriage

HELP
    );
    return 1;
}
