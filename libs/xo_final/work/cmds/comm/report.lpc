#include <ansi.h>


inherit F_CLEAN_UP;

void get_title(object who,string title);
void do_report(object who,string title,string text);

int main(object who,string arg)
{
    if(!arg)
    {
        printf("请先指定一个标题：");
        input_to( (:get_title,who:) );
        return 1;
    }
    printf("请输入正文：");
    who->edit( (: do_report,who,arg:) );
    return 1;
}

void get_title(object who,string title)
{
    printf("请输入正文：");
    who->edit ( (: do_report,who,title :) );
    return;
}

void do_report( object who,string title,string text )
{
    string env="unknown";
    if(environment(who))
        env=file_name(environment(who));
    log_file("nosave/report",sprintf(YEL BBLU"%s(%s) reported at %s %s\n"NOR,who->name(),
            who->query("id"),env,ctime(time())));
    log_file("nosave/report",YEL BBLU "title : " + title + "\n" NOR );
    log_file("nosave/report",text + "\n" );
    log_file("nosave/report","---------------------------------------------\n");
    printf("\n 呵呵，多谢啦！\n");
}

int help(object who)
{
    write(@HELP

指令格式： report [title]

HELP );
    return 1;
}
