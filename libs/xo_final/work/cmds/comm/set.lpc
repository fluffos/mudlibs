// /cmds/usr/set.c

#define MAX_ENV_VARS	20



inherit F_CLEAN_UP;

int help();

int main(object me, string arg) {
  int i;
  string term, *terms, *wiz_only;
  mixed data;
  mapping env;

  wiz_only = ({ "invisibility", "immortal", "combat_test" });

  if (me != this_player(1)) return 0;

  env = me->query("env");


  if (!arg || arg == "") {
    if (!mapp(env) || !sizeof(env))
      write("你现在没有设定任何环境变量。\n");
    else {
      write("你目前设定的环境变量有：\n");
      terms = keys(env);
      for (i = 0; i < sizeof(terms); i++)
        printf("%-20s  %O\n", terms[i], env[terms[i]]);
    }
    return 1;
  }

  if (strsrch(arg, "/") != -1)
    return notify_fail("对不起，你不允许使用这样的设置！\n");


  if (sscanf(arg, "%s %s", term, data) != 2) {
    term = arg;
    data = "0";
  }

  if (term && term != "") {
    if (mapp(env) && undefinedp(env[term]) &&
      sizeof(env) >= MAX_ENV_VARS) {
      return notify_fail("你已设的环境变量过多，请先用 unset 删掉几个吧。\n");
    }
    sscanf(data, "%d", data);
    if ((wiz_level(me) < 1) && (member_array(term, wiz_only) != -1))
      return notify_fail("只有一定等级的神仙才能用这个环境变量。\n");
    me->set("env/" + term, data);
    printf("设定环境变量：%s = %O\n", term, data);
    return 1;
  }
  return help();
}

int help() {
  write(@TEXT
指令格式：set <变量名> [<变量值>]
 
这个指令让你设定一些环境变量，不加参数时会显示你目前已设的环境变量，不指定
变量值，则内定值为 "YES"。
 
取消变量设定请用 unset 指令。
 
至于有哪些环境变量可以设定，请见 help settings。
TEXT
  );
  return 1;
}
