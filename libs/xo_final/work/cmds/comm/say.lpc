// say.c

#include <ansi.h>



inherit F_CLEAN_UP;

int main(object me, string arg)
{
//    string strTime;
//    strTime = sprintf(CYN"  [%s]"NOR,ctime(time())[11..15]);

    if( me->query("doing") == "scheme" )
    {
        if ( me->query("gin") < 100 )
        {
            return notify_fail("你现在的精神不济，等一会儿吧。\n");
        }
        me->addn("gin", -50);
    }

        if( (int)me->query("kee")<5)
                return notify_fail(RED "你现在生命垂危，还是不要说话为妙!\n" NOR);
        if( (int)me->query("sen")<5)
                return notify_fail(HIW "你现在太累了，没法说话。。。\n" NOR);
	if (!arg) {
		write("你自言自语不知道在说些什麽。\n");
		message("sound", me->name() + "自言自语不知道在说些什麽。\n",
			environment(me), me);
		return 1;
	}
	if( (int)me->query("kee") < (int)me->query("max_kee") / 5 ) {
		arg = replace_string(arg, " ", " ... ") + " ...";
	}

        write(CYN"你说道：" + arg + NOR  + "\n");
        message("sound",CYN + me->name() + CYN"说道：" + arg + "\n"NOR,
		environment(me), me);

	// The mudlib interface of say
	all_inventory(environment(me))->relay_say(me, arg);
        // receive -sen
        if( me->query_temp("cost_sen_tosay")>5){
             me->add("sen",-1);
             me->delete_temp("cost_sen_tosay");
        }
        me->add_temp("cost_sen_tosay",1);
	return 1;
}

int help (object me)
{
	write(@HELP
指令格式: say <讯息>
 
    说话，所有跟你在同一个房间的人都会听到你说的话。同时，
  由于说话是一中活动，它将消耗一部分体力。
 
注: 本指令可用 ' 取代.
 
HELP
	);
	return 1;
}
