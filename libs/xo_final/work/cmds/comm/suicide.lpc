// suicide.c

#include <ansi.h>
#include <command.h>



inherit F_CLEAN_UP;

int laosi(object);

void create() { seteuid(ROOT_UID); }

int main(object me, string arg)
{
    string passwd;
        if ( me->is_busy() )
                return notify_fail("你上一个动作还没完成，不能自杀。\n");
        
        if ( wizardp( me ) )
                return notify_fail("你是XO巫师，不能随意自杀，自杀请申请批准。\n");

        if ( !arg )
        {
                write("您想以什么方式自杀啊？\n");
                return 1;
        }

    if ( arg != "-f" )
                return notify_fail("想要自杀的彻彻底底、干干脆脆，就使用suicide -f来实现。\n");

        write(
                "如果您选择永远死掉的自杀方式，这个人物的资料就永远删除了，请务必\n"
                "考虑清楚。\n如果您后悔了，请直接敲回车键(enter)退出自杀。\n"
                "如果您确定要永远离开这个世界，请将您的密码输入：");
        input_to("check_password", passwd, me, 1);
        return 1;
}

void check_password(string passwd, object me, int forever)
{
        object link_ob;
        string old_pass;

        if( passwd == "" )
    {
                write("你在死亡线上兜了一圈，又回来了。\n");
                return;
        }
    link_ob = me->query_temp("link_ob");
        old_pass = link_ob->get_passwd();
        if( crypt(passwd, old_pass)!=old_pass ) {
                write("密码错误！\n");
                return;
        }

        if (forever) 
        {   
        if( !link_ob ) return 0;
            log_file("nosave/SUICIDE",
            sprintf( "%s commits a suicide on %s\n", geteuid(me), ctime(time())) );
        seteuid(getuid());   
//        rm( link_ob->query_save_file() + __SAVE_EXTENSION__ );
//        rm( me->query_save_file() + __SAVE_EXTENSION__ );
//        rm( LOG_DIR + me->query_log_file() );
        write("好吧，永别了:)。\n");
        message("channel:sys", me->name() +
            "自杀了，以後的江湖中你只能听到一些关于这个人的传说了。\n", 
            users(), ({me}));
/*
        UNIQUE_D->check_unique_for_delete(me);
        FAMILY_D->clear_all_family_relation( me->query("id") );
        MARRY_D->divorce( me );
        destruct(me);
*/
        call_out("dest",1,me);
        }
}

int laosi( object me )
{
    object link_ob;
    string file, title, end;

    title = @TEXT
◎ 笑傲江湖记录系统 ◎
=============================================================
TEXT
;
    end = @TEXT
=============================================================

                                            ＸＯ  ＴＥＡＭ

TEXT
;


    file = LOG_D->query_log_file( me->query("id") );
    log_file( "nosave/DIE_PLAYER",
        sprintf( "%s(%s)永远的离开了笑傲江湖，终年%s岁。\n", me->name(), geteuid( me ), chinese_number( me->query( "age" ) ) ) );
    seteuid( getuid() );
    link_ob = me->query_temp("link_ob");
    me->delete( "last_read_log" );
    write( sprintf( "你经过%s年的闯荡江湖，这是你这些年的经历。\n" , chinese_number( me->query( "age" ) - 13 ) ) );
    write( title );
    foreach ( string s in explode(read_file( file ),"\n") )
    {
       write (s + "\n");
    }
    write( end );    
    write( "你的江湖历程在此刻终于结束了。\n" );
    tell_room( environment( me ), me->name() +
        "永远的离开笑傲江湖，以後你只能听到这个人的一些过去的传奇了。\n", ({ me }));
    call_out( "dest", 1 , me );
    return 1;
}

varargs void dest( object me, int force )
{
    int i;
    object *things;
     object link_ob;
     if(!objectp(me))  return;
    link_ob = me->query_temp( "link_ob" ); 

    if (me->query("age")>25 && !force)
    {  
         BAN_D->AddID(me->query("id"));
         me->add("max_age",-5);
     }    
    else
    {    
    rm( LOG_D->query_log_file( me->query( "id" ) ) );
    rm( link_ob->query_save_file() + __SAVE_EXTENSION__ );
    rm( me->query_save_file() + __SAVE_EXTENSION__ );
    UNIQUE_D->check_unique_for_delete( me );
    FAMILY_D->clear_all_family_relation( me->query("id") );
    }
    // add by xli 1999.4.8
    things=all_inventory(me);
    for(i=0;i<sizeof(things);i++)
    {if(userp(things[i]))
        things[i]->move(environment(me));     else destruct(things[i]);
    }
    // end
    destruct(me);
    return;
}

int help (object me)
{
    write(@HELP
指令格式: suicide [-f]
 
如果因为某种原因你不想活了, 你可以选择自杀.
suicide -f : 永远的除去玩家资料, 系统会要求你
             输入密码以确认身份.
 
请慎重选择（小树一脸严肃的说）

HELP
);
        return 1;
}


