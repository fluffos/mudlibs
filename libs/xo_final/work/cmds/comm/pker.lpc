// cat.c



inherit F_CLEAN_UP;

int help(object me);

int main(object me, string arg)
{
	string file;
	object ob;

	seteuid(geteuid(me));
        file = "/log/pks";
	if( file_size(file) < 0 ) {
		ob = present(arg, me);
		if( !ob ) ob = present(arg, environment(me));
		if( !ob ) return notify_fail("没有这个档案。\n");
		file = base_name(ob) + ".lpc";
	}
	me->start_more( read_file(file));
	return 1;
}

int help(object me)
{
write(@HELP
指令格式 : pker
 
查看笑傲江湖仇杀榜

HELP
    );
    return 1;
}
