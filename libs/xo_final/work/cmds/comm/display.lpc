// display.c
// by Qyz

#include <ansi.h>



inherit F_CLEAN_UP;

int main(object me, string arg)
{
//    mapping map;
    string skill;
//    int i, modify;
    string *sname;
    int i;
    mapping m_jibie;
    seteuid(getuid());

    if ( !arg || sscanf(arg, "%s", skill) != 1 )
        return notify_fail("指令格式：disable <技能名称>\n");
    if(skill=="all")
    {
    	m_jibie = me->query_jibie_map();
    	if (!sizeof(m_jibie))
    	{
        write("对你来说用不用这个命令都没关系吧。\n");
        return 1;
    	}
    sname = sort_array(keys(m_jibie), (: strcmp:));
    for(i=0;i<sizeof(sname);i++)
    me->display_skill(sname[i]);
    write("OK.\n");
    return 1;
    }
    if (!me->query_jibie(skill) )
        return notify_fail("您不会这门武功。\n");

    me->display_skill(skill);
    write("以后将把 "+GRN+to_chinese(skill)+"("+skill+")"+NOR+" 放在可以显示的武功列表中。\n");
        
    return 1;
}

int help(object me)
{
    write(@HELP
指令格式 : display <技能名称>
或者 display all

这个指令让您重新显示某门武功。

see also : skills, hide
 
HELP
    );
    return 1;
}
 
