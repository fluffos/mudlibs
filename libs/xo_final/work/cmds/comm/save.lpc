// Filename : /cmds/comm/save.c

#include <ansi.h>
#include <options.h>



inherit F_CLEAN_UP;

int main(object me, string arg)
{
    object link_ob, *inv;
    int livetime, i;

    seteuid( getuid() );

	link_ob = me->query_temp("link_ob");
    if ( !objectp(link_ob) )
        return notify_fail(RED "你不是经由正常连线进入，不能储存。\n" NOR);


    livetime = time() - me->query("birthday");
    if ( !wizardp( me ) && livetime <= CAN_SAVE_LIMIT_TIME )
    {
        return notify_fail(RED "初次进入不玩够 10 分钟以上，不能储存。\n" NOR);
    }

    if ( time()-me->query_temp("last_savetime")>3 ) //(int)link_ob->save() && (int)me->save() ) 
    {                            
    if ( environment( me ) &&
         environment( me )->IsRoom()&&
         !environment(me)->query("not_startroom") &&
         !environment(me)->query("virtual_room") )
    {
        me->set( "startroom", file_name( environment( me ) ) );
        write(HIW "当你下次连线进来时，将会从这里进入游戏。\n" NOR);
    }
        UNIQUE_D->check_unique_for_delete( me );
        //remove_call_out("change_user");
        //call_out("change_user",1,me);
        inv = all_inventory(me);
        for ( i = 0 ; i < sizeof( inv ) ; i++ )
            if ( inv[i]->is_unique() )
                UNIQUE_D->change_user_for_unique( inv[i], me ); 
        me->save();
        write( HIY "OK.\n" NOR );
        me->set_temp("last_savetime",time());
        return 1;
    } 
    else 
    {
        write( HIY "OK.\n" NOR );
    //    write(MAG "你发现这个世界上有什么奇怪的事情正在发生着，要当心了。\n" NOR);
        return 1;
    }
}

int change_user( object me )
{
    object *inv;
    int i;
    inv = all_inventory(me);
    for( i=0 ; i < sizeof( inv ) ; i++ )
        if( inv[i]->is_unique() )
            UNIQUE_D->change_user_for_unique( inv[i], me ); 
    write(HIY "OK.\n" NOR);
    return 1;
}

int help(object me)
{
    write(@HELP
指令格式：save

把你辛苦奋斗的结果存起来。
HELP
    );
    return 1;
}
