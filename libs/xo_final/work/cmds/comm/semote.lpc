// semote.c



inherit F_CLEAN_UP;

int main(object me, string arg)
{
	string *e;
    string semote;
	int i;

	e = sort_array(EMOTE_D->query_all_emote(), 1);

    semote = sprintf("%-15s",e[0]);
	for(i=1; i<sizeof(e); i++)
		semote = sprintf("%s%-15s%s",semote, e[i], (i%5==4)?"\n": "");
	semote = sprintf("%s\n", semote);
    me->start_more(semote);
	return 1;
}

int help(object me)
{
  write(@HELP
指令格式 : semote

这个指令可以列出目前所能使用的 emote.
HELP
    );
    return 1;
}
