// Filename : /cmds/usr/wizlist.c
#include <ansi.h>
inherit F_CLEAN_UP;
int main(object me, string arg)
{

    string * list;
    write("\n");
    cat("/etc/wiz_note");
    write("以下为参与XO II 在线管理的巫师：\n");

  list = sort_array(SECURITY_D->query_wizlist(), 1);
  for(int i=0; i<sizeof(list); i++)
        printf("%-15s%c", list[i],  (i%5==4) ? '\n' : ' ');
  printf("\n");
  return 1;
}

int help(object me)
{
write(@HELP
指令格式 : wizlist

列出目前的神仙名单。

HELP
     );
     return 1;
}

