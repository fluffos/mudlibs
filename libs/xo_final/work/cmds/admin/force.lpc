// force.c



inherit F_CLEAN_UP;

void create() { seteuid(getuid()); }

int main(object me, string arg) {
  string dest, cmd;
  object ob;
  int ret;

  if (me != this_player(1)) return 0;

  if (!arg || sscanf(arg, "%s to %s", dest, cmd) != 2)
    return notify_fail("指令格式force <某人> to <指令>\n");
  if (!ob = get_object(dest))
    return notify_fail("找不到" + dest + "。\n");
  if (!living(ob))
    return notify_fail("这个物件不能执行命令。\n");
  if (wiz_level(me) < wiz_level(ob))
    return notify_fail("你没有强制" + ob->name() + "执行指令的权力。\n");
  if (userp(ob))
    log_file("acct/force", sprintf("[%s] %s(%s) forces %s(%s) to %s\n",
      ctime(time())[4..15], me->name(), geteuid(me),
      ob->name(), geteuid(ob), cmd));
  ret = ob->force_me(cmd);
  if (ret) {
    printf("O.K.\n");
  } else {
    printf("失败..\n");
  }
  return 1;
}

int help(object me) {
  write(@Help
 指令格式force <某人> to <指令>

 强迫某人做某事, 但你的巫师等级必须比对方高。
Help
  );
  return 1;
}
