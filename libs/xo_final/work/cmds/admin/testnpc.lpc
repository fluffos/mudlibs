inherit F_CLEAN_UP;

int main(object me, string arg)
{
    string path = "/d/menpai/shaolin/npc/";
    string file, id;

    if ( 2 != sscanf( arg, "%s %s", file, id ) )
    {
        file = arg;
        id = arg;
    }

    "/cmds/app/update"->main(me, "here");
    "/cmds/app/update"->main(me, path + file);
    "/cmds/wiz/clone"->main(me, path + file);

    "/cmds/comm/hp"->main(me, id);
    "/cmds/comm/skills"->main(me, id);
    "/cmds/comm/score"->main(me, id);
    "/cmds/comm/inventory"->main(me, id);

    return 1;
}

