// npurge.c writen by tea 10.19.98
// a new purge command for purge some special player!

#include <ansi.h>
#define SYNTAX	"指令格式：npurge [<未上线天数>] | <使用者姓名> because <原因>\n"

//inherit F_CLEAN_UP;

private int do_purge_players(int day);
private int do_purge_player(string arg);
private int do_purge_wrong();
//private int do_purge_newbie();
private int do_purge_log();

int main(object me, string arg)
{
	string status;
	int day;

	status = wizhood(me);
	if ( me != this_player(1) ||
		 wiz_level(me) < wiz_level(status) )
	{
		return notify_fail("你没有权力使用这个指令。\n");
	}

	if ( !arg ) return notify_fail(SYNTAX);

	if ( sscanf(arg, "%d", day) && day >= 0 )
		return do_purge_players(day);

	if ( arg == "wrong data" )
		return do_purge_wrong();

//	if ( arg == "useless newbie" )
//		return do_purge_newbie();

	if ( arg == "illegal log" )
		return do_purge_log();

	return do_purge_player(arg);

}


int do_purge_player(string arg)
{
	string name, reason;
	string login_file, body_file, log_file;
	mixed info;
	object ob;

	if ( sscanf(arg, "%s because %s", name, reason)!=2 )
		return notify_fail(SYNTAX);

	seteuid(getuid());
	login_file = DATA_DIR + "login/" + name[0..0] + "/" + name + ".o";
	body_file = DATA_DIR + "user/" + name[0..0] + "/" + name + ".o";
	log_file = DATA_DIR + "log/" + name[0..0] + "/" + name;
	if ( file_size( login_file ) < 0 )
		return notify_fail("没有这位使用者。\n");

	info = stat( login_file );
	write( "此玩家"+chinese_number((time()-(int)info[1]) / 86400 )+"天未上线。\n" );

	ob = new(LOGIN_OB);
	ob->set("id", name);
	if ( !ob->restore() ){
		destruct( ob );
		write( "没有玩家 "+name+" 的资料。\n");
		return 1;
	}

	printf("现在时间：%d  上次连线时间：%d  上次连线地址：%s\n", time(), ob->query("last_on"), (string)ob->query("last_from") );
	rm( login_file );
	rm( body_file );
	rm( log_file );
	FAMILY_D->clear_all_family_relation(name);
	MARRY_D->divorce(name);
	write( "玩家 " + capitalize(name) + " 被删除掉了。\n" );
	log_file( PURGE_LOG, sprintf("[%s] %s purged %s because %s.\n",
		ctime(time())[0..15], geteuid(this_player(1)), name, reason));

	return 1;
}

private int do_purge_wrong()
{
	int i, j, ppl_cnt, count;
	string *dir, *ppls, name;
	string login_dir, user_dir, log_dir;
	object ob;

	seteuid( getuid() );
	message("system", "\n 整理玩家存档中，请稍候.... \n", users());
	write("处理中：");
	count = 0;
	ppl_cnt = 0;
	login_dir = DATA_DIR + "login/";
	user_dir = DATA_DIR + "user/";
	log_dir = DATA_DIR + "log/";
	dir = get_dir( login_dir );
	for ( i = 0; i < sizeof( dir ); i++ )
	{
		reset_eval_cost();
		write( dir[ i ] );
		ppls = get_dir( login_dir + dir[i] + "/" );
		ppl_cnt += sizeof(ppls);
		for ( j = 0; j < sizeof( ppls ); j++ )
		{
			if ( sscanf( ppls[ j ], "%s.o", name ) == 1 )
				if ( (string)SECURITY_D->get_status(name) != "(player)" )
					continue;
// 增加判断 上线时间 和 ip
			ob = new(LOGIN_OB);
			ob->set("id", name);
			if ( !ob->restore() ){
				destruct( ob );
				write( "没有玩家 "+name+" 的资料。\n");
				return 1;
			}
// 判断结束
			if( !ob->query("last_on") || !ob->query("last_from") )
			{
				rm( login_dir + dir[ i ] + "/" + ppls[ j ] );
				rm( user_dir  + dir[ i ] + "/" + ppls[ j ] );
				rm( log_dir + dir[ i ] + "/" + name );
				MARRY_D->divorce(name);
				FAMILY_D->clear_all_family_relation(name);
				count++;
			}
		}
	}
	write( "\n\n整理前总共有 " + ppl_cnt + " 位玩家。\n" );
	write( count + " 个无连线时间或连线地址的玩家被清除掉了。\n");
	write( "整理后剩下 " + (ppl_cnt - count) + " 位玩家。\n");
	log_file( PURGE_LOG, sprintf("[%s] %s cleaned up %d characters who is newbie login for less 1 hour and didn't login for more than 10 days\n"
		"\t\tResulting statistics: %d characters remaining.\n",
		ctime(time())[0..15], geteuid(this_player(1)),
		count, ppl_cnt - count ) );

	return 1;
}

private int do_purge_players(int day)
{
	int i, j, ppl_cnt, count;
	string *dir, *ppls, name;
	string login_dir, user_dir, log_dir;
	mixed info;

	seteuid( getuid() );
	message("system", "\n 整理玩家存档中，请稍候.... \n", users());
	write("处理中：");
	count = 0;
	ppl_cnt = 0;
	login_dir = DATA_DIR + "login/";
	user_dir = DATA_DIR + "user/";
	log_dir = DATA_DIR + "log/";
	dir = get_dir( login_dir );
	for ( i = 0; i < sizeof( dir ); i++ )
	{
		reset_eval_cost();
		write( dir[ i ] );
		ppls = get_dir( login_dir + dir[i] + "/" );
		ppl_cnt += sizeof(ppls);
		for ( j = 0; j < sizeof( ppls ); j++ )
		{
			if ( sscanf( ppls[ j ], "%s.o", name ) == 1 )
				if ( (string)SECURITY_D->get_status(name) != "(player)" )
					continue;
			info = stat( login_dir + dir[ i ] + "/" + ppls[ j ] );
			if ( ( time()-(int)info[ 1 ] ) / 86400 >= day )
			{
				rm( login_dir + dir[ i ] + "/" + ppls[ j ] );
				rm( user_dir  + dir[ i ] + "/" + ppls[ j ] );
				rm( log_dir + dir[ i ] + "/" + name );
				MARRY_D->divorce(name);
				FAMILY_D->clear_all_family_relation(name);
				count++;
			}
		}
	}
	write( "\n\n整理前总共有 " + ppl_cnt + " 位玩家。\n" );
	write( count + " 个超过 " + day + " 天未上线的玩家被清除掉了。\n");
	write( "整理后剩下 " + (ppl_cnt - count) + " 位玩家。\n");
	log_file( PURGE_LOG, sprintf("[%s] %s cleaned up %d characters who didn't login for more than %d days\n"
		"\t\tResulting statistics: %d characters remaining.\n",
		ctime(time())[0..15], geteuid(this_player(1)),
		count, day, ppl_cnt - count ) );

	return 1;
}

int do_purge_log()
{
    string *all_player, *player_log, id, letter;
    
    all_player = ({ });
    foreach( letter in get_dir( DATA_DIR + "log/" ) )
        all_player += get_dir( DATA_DIR + "log/" + letter + "/" );
    player_log = filter(map( all_player,
        function(string file) 
        {
            if( file_size( DATA_DIR + "login/" + file[0..0] + "/" + file + ".o" ) < 0 )
                 return file;
            return 0;
        }),
        (: $1 :) );
    seteuid( getuid() );
    foreach( id in player_log )
        rm( DATA_DIR + "log/" + id[0..0] + "/" + id );
    if ( sizeof( player_log ) > 0 )
        write( "清除了" + sizeof( player_log ) + "非法的玩家记录文件.\n" );
    else
        write( "没有非法的玩家文件.\n" );
    return 1;
}

int help( object me )
{
write(@HELP
指令格式：npurge [<未上线天数>] | <使用者英文名> because <原因>

清除一个玩家或清除超过一定天数没有上线玩家。
HELP
	);
    return 1;
}
