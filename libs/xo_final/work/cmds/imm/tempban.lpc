/* $Id$
 * for xo mudlib ver 1.5
 * tempban用来临时ban掉一些ip.
 */
 
#include <ansi.h>



inherit F_CLEAN_UP;

#define SYNTAX  "指令格式: tempban [add|remove|print] ip [mins]\n"

int main(object me, string arg)
{
    string site;
    string* opt;

    if (!arg)
        return notify_fail( SYNTAX );
    
    opt = explode( arg, " " ) - ({ "" });
    
    if ( opt[0] == "print" )
    {
        mapping banned = BAN_D->GetTempBannedSites();
        if ( !banned || sizeof( banned ) == 0 )
        {
            write("目前没有被临时封掉的IP.\n");
        }
        else
        {
            int cur_time = time();
            foreach( string s, int tm in banned )
            {
                printf("%-30s%d分钟\n", s, (tm-cur_time)/60 +1 );
            }
        }
        return 1;
    }
    
    else if ( opt[0] == "add" || opt[0] == "remove" )
    {
        if ( sizeof( opt ) <= 1 )
        {
            return notify_fail("参数不足。\n" SYNTAX );
        }
        site = opt[1];
        if ( opt[0] == "remove" )
        {
            BAN_D->RemoveTempBannedSite( site );
            write("Ok.\n");
        }

        else // opt is add
        {
            if ( sizeof(opt) > 2 )
            {
                int mins = atoi( opt[2] );
                if ( mins <= 0 || mins > 120 )
                {
                    return notify_fail("不合法的时间。不能超过120分钟。时间单位是分。\n");
                }
                BAN_D->AddTempBannedSite( site, mins );
            }
            else
            {
                BAN_D->AddTempBannedSite( site ); // let band to do decision
            }
            write("Ok.\n");
        }
        return 1;
    }
    return notify_fail( SYNTAX );
}

int help(object me)
{
    write( SYNTAX );
    write( @HELP

该指令用来临时性的 ban 掉一些 ip。
用法：
    tempban add aaa.bbb.ccc.ddd 3
        把 aaa.bbb.ccc.ddd 封掉 3 分钟
    tempban print
        现在现在被临时封掉的ip.
    tempban remove x.y.z.u
        去掉对x.y.z.u这个ip的封禁。

HELP );
    return 1;
}

