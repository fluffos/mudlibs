int main(object me, string arg) {
  object ob, env;
  string name;
  env = environment(me);

  if (!objectp(ob = find_player(arg)))
    return notify_fail("这里没有这个人哦~~\n");

  name = ob->query("name");

  message_vision(CYN "$N虔诚地双手合十，默默地祈祷道：\n"
    +name + "生日快乐~~\n",
    me);

  call_out("show_flower", 2, name);
  return 1;
}


void show_flower(string name) {
  string str;
  str = "天空中突然闪出一道绚丽的火花，一个巨大的图案逐渐\n"
    "显现：\n";
  str += color1[random(sizeof(color1))] + pic[random(sizeof(pic))] + NOR;
  str += YEL "四下里隐隐传来众人深沉的祝福声：\n"
    "     “" HIM + name
    +NOR "" YEL "生日快乐，永远幸福...”\n";
  message("marry", str, users());
}

int help(object me) {
  write(@LONG

			生日祝福专用指令。
    用法：
        hbless 某人
LONG);
  return 1;
}
