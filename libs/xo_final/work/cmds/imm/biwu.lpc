#include <ansi.h>



inherit F_CLEAN_UP;

int main(object me, string arg)
{
    string how,type;
    object tai=load_object("/d/place/biwu/biwutai");

    if (!arg || sscanf(arg, "%s %s", how, type) != 2) 
      return notify_fail("biwu baoming xunhuan,biwu biwu xunhuan,biwu end xunhuan \n");   
       if(how=="baoming")
    {
        tai->set_temp("biwu/baoming",1);
        if(type=="xunhuan")
        {tai->set_temp("biwu/xunhuan",1);
         message("channel:chat",HIR"【擂台】"+       "笑傲江湖循环赛制比武的报名工作现在开始。\n"NOR,users());
        return 1;}
        if(type=="taotai")
        {tai->set_temp("biwu/taotai",1);
         message("channel:chat",HIR"【擂台】"+  "笑傲江湖循淘汰制比武的报名工作现在开始。\n"NOR,users());
        return 1;}
        else
        return notify_fail("开始什么赛制的比武大会呢?\n");      
        }
    if(how=="biwu")
    {
//        if( !tai->query_temp("biwu/baoming"))
//        return notify_fail("请先开始报名工作。\n");             
//        tai->delete_temp("biwu/baoming"); 
        tai->set_temp("biwu/baoming",1);       
        tai->set_temp("biwu/taotai",1);    
        tai->set_temp("biwu/biwu",1);
        if(tai->query_temp("biwu/xunhuan"))
        {
         message("channel:chat",HIR"【擂台】"+  "笑傲江湖循环赛制比武的正式开始。\n"NOR,users());
        return 1;}
        if(tai->query_temp("biwu/taotai"))
        {
         message("channel:chat",HIR"【擂台】"+  "笑傲江湖循淘汰制比武的正式开始。\n"NOR,users());
        return 1;}
        else
        return notify_fail("开始什么赛制的比武大会呢?\n");      
        }
    if(how=="end")
    {
        if (!tai->query_temp("biwu/biwu")&&!tai->query_temp("biwu/baomin"))
        return notify_fail("现在没有主办比武大会啊？\n");
        tai->delete_temp("biwu");
        message("channel:chat",HIR"【擂台】"+   "笑傲江湖的比武大会结束了。\n"NOR,users());
        tai->showresult();
        return 1;               
        }      
            return notify_fail("biwu baoming xunhuan,biwu biwu xunhuan,biwu end xunhuan \n");
 }
