#include <ansi.h>

inherit F_CLEAN_UP;

void create() { seteuid(getuid()); }

int main(object me, string arg)
{
    object ob, old_app;
    string *skname;
    mapping skills;
    int i;

    if( !arg || !ob = present(arg, environment(me)) )
    {
        return notify_fail("你要将谁逐出师门？\n");
    }

    if ( arg == "cancel" )
    {
        old_app = me->query_temp("pending/expell");
        if ( !objectp(old_app) )
        {
            return notify_fail("你现在并没有要把谁逐出师门的意思。\n");
        }

        write("你改变主意不想把" + old_app->name() + "逐出师门了。\n");
        tell_object(old_app, me->name() + "改变主意不想把你逐出师门了。\n");
        me->delete_temp("pending/expell");

        return 1;
    }

    if( !ob->is_character() )
    {
        return notify_fail("你逐不动他。\n");
    }

    if ( !living(ob) )
    {
        return notify_fail("你必须先把" + ob->name() + "弄醒。\n");
    }

    if ( (object)me->query_temp("pending/expell") == ob )
    {
        if( me->query("family/privs") == -1
            && (string)me->query("family/family_name") == (string)ob->query("family/family_name") )
        {
            message_vision("\n$N对着$n说道：从今天起，你再也不是我"
                + me->query("family/family_name") + "的弟子了，你走吧！\n\n",
                me, ob);
            tell_object(ob, "\n你被" + me->query("family/title") + "开革出师门了！\n\n");
        }
        else if( ob->is_apprentice_of(me) ) {
            message_vision("\n$N对着$n说道：从今天起，你我师徒恩断情绝，你走吧！\n\n",
                me, ob);
            tell_object(ob, "\n你被师父开革出师门了！\n\n");
        }
        else
        {
            return notify_fail("这个人不是你的弟子。\n");
        }

        me->process_betray(ob);
        me->delete_temp("pending/expell");
    }
    else
    {
        old_app = me->query_temp("pending/betray");

        if ( objectp(old_app) )
        {
            write("你改变主意不想把" + old_app->name() + "逐出师门了。\n");
            tell_object(old_app, me->name() + "改变主意不想找你判师了。\n");
        }

        message_vision("$N想要把$n逐出师门。\n", me, ob);
        tell_object(me, YEL "请在5秒内再次输入expell " + ob->query("id") + "确认将他逐出师门。\n"
            "他被逐出师门将会损失在本门派期间获得的所有技能、修为、实战经验、江湖阅历、门忠等。\n" NOR);
        me->set_temp("pending/expell", ob );
        call_out("clean_expell", 5, me);

        return 1;
    }

    return 1;
}

void clean_expell(object me)
{
    if ( !me )
    {
        return;
    }

    me->delete_temp("pending/expell");
}

int help(object me)
{
    write(@HELP
指令格式 : expell|kaichu <某人>
 
这个指令可以让你开除不成才的弟子，被开除的弟子所有技能都会降到原来
的一半，而且综合评价一项会变成零，这对于一个人物而言是一个「比死还
严重」的打击，请你在开除一名弟子之前务必审慎考虑。
 
HELP
    );
    return 1;
}
