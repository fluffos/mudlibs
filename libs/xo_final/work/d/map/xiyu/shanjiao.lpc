inherit ROOM;
void init();
int do_climb(string);



void create()
{
    set( "short","天山脚下" );
    set( "long",@LONG
连绵不绝的天山就在你的眼前。远望天山，美丽多姿，流光溢彩。南麓玉女峰高插云霄，
北麓罗汉峰素裹银装，更有东麓千里牧场，水草丰饶。
LONG
    );

    set( "exits",([ /* sizeof() ==2 */
        "east" : __DIR__"muchang",
        "west" : "/d/menpai/tianshan/shanjiao" ,
    ]) );
    set( "outdoors","xiyu");
    setup();
}

void init()
{
    add_action("do_climb", "climb");
}


int do_climb(string arg)
{
    object me = this_player();

    if (arg != "shan") return command("climb "+arg);
   if( me->query_xiuwei("dodge") < 3000  )              
    {
        tell_object(me,"你的轻功太差，无法爬上岩石。\n");
        return 1;
    }

    message_vision("$N顺着岩石艰难的爬上了玄铁山。\n", me);

    me->move("/d/map/xiyu/kuangshan");

    return 1;
}
