

#include <weapon.h>

inherit HAMMER;

void create()
{
    set_name("铁镐", ({ "tie gao", "tiegao" }) );
    set_weight(5000);
    if( clonep() )
        set_default_object(__FILE__);
    else
    {
        set("unit", "把");
        set("long", "这是一把用于挖矿石的铁镐。\n");
        set("value", 100);
        set("material", "wood");
        set("wield_msg", "$N从身边举起一把$n握在手中。\n");
        set("unwield_msg", "$N放下了手中的$n。\n");
    }

    init_hammer(12);
    setup();
}




