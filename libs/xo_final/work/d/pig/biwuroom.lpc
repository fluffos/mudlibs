// pigtest room

inherit ROOM;

void create() {
  set("short", "比武场");
  set("long", @LONG
    这里是啸傲江湖的比武场，在这里举行一年一度的比武大会。中间是一块很
大的空地。en..描述就这么多吧先。:)
LONG);
  set("no_die", 1);
  set("exits", ([
    "west": "/d/city/dali/jiulou"
  ]));
  setup();
}


void init() { add_action("do_b", ({ "tiaozhan", "bihua" })); }

int do_b(string arg) {
  this_player()->set_temp("pending/biwu", 1);
  return 0;
}
