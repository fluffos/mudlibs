string *place = ({
  "/d/city/lanzhou/kezhan",
  "/d/city/dali/jiulou",
  "/d/city/nanyang/xiaodian",
  "/d/city/yangzhou/jiulou",
});
string *place_chinese = ({ "兰州", "大理", "南阳", "扬州", });

mapping get_yipin_task() {
  mapping task_other;
  object pantu;
  int place_num;

  if (random(3) == 1) {
    pantu = new("/d/zuzhi/yipin_tang/npc/pantu");
    place_num = random(sizeof(place));
    pantu->move(place[place_num]);
    task_other = ([
      "task_type": "short",
      "time_limit": 500,
      "bonus": 5,
      "keyname": "杀",
      "obname": pantu->query("name"),
      "need_type": 1,
      "task_message": YEL "在" + place_chinese[place_num] +
      "有个叫" + pantu->query("name") +
      "的一品堂叛徒。\n你的任务是杀了他。\n" NOR,
    ]);
    return task_other;
  }
  return task[random(sizeof(task))];
}
