// saodi_puren.c
// by lnwm 97-09-12

#include <ansi.h>

inherit NPC;

void create() {
  set_name("扫地仆人", ({ "saodi puren", "puren" }));
  set("title", "一品堂杂役");
  set("age", 30 + random(10));
  set("gender", "男性");
  set_wugong("blade", 40 + random(50), 40 + random(50), 1);
  set_xiuwei_by_type("blade", random(200));
  set("combat_exp", 10000);

  set("chat_chance", 5);
  set("chat_msg", ({
    (: random_move :),
  }));
  set("force", 100);
  set("max_force", 100);
  set("force_factor", 0);
  setup();
  carry_object(CLOTH_DIR "cloth1")->wear();
}

void init() {
  object me;
  me = this_player();
  if (me->query_condition("kill_yipin")) {
    set_xiuwei_by_type("blade", 600);
    set_wugong("wuhu-dao", 60 + random(20), 100 + random(20), 1);
    message_vision("突然扫地的仆人拽出一把腰刀, 向$P扑了过去. \n", me);
    carry_object(__DIR__ "obj/blade1")->wield();
    kill_ob(me);
    me->fight_ob(this_object());
  }
  return;
}
