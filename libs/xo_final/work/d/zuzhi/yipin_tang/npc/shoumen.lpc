// shoumen.c
// by lnwm 97-09-12

#include <ansi.h>

inherit NPC;

void create()
{
	set_name(BLU"守门卫士"NOR, ({ "shoumen weishi","weishi"}));
    set("title",BLU"一品堂总堂"NOR);
    set("age", 30+random(10));
    set("gender", "男性");
    set_wugong("banruo-shenfa",150,random(150),1);
	set_wugong("fengxiang-jianfa",100,100,1);
    set_xiuwei_by_type("dodge",1200);
	set_xiuwei_by_type("sword",1000);
    set("combat_exp", 100000);
    
	set("force",2000);
	set("max_force",2000);
	set("force_factor",100);
    setup(); 
    carry_object(__DIR__"obj/cloth1")->wear();
    carry_object(__DIR__"obj/jian1") ->wield();
}

void init()
{
    object me;
    me=this_player();

    if( me->query_condition("kill_yipin") && this_object()->can_act())
    {
        message_vision(RED"守门卫士冲$P冷笑一声: 想走? 没那么容易!\n"NOR, me);
        kill_ob(me);
        me->fight_ob(this_object());
        return;
    }
    
    remove_call_out("greeting");
    call_out("greeting",1,me);
    return;
}

void greeting( object me )
{
    if ( !me || environment( me ) != environment(this_object()) )
		    return; 
    if( me->IsMemberOf("yipin"))
    {
        message_vision("守门卫士看了$P一眼, 微微点了点头. \n", me);
        return;
    }
    message_vision("守门卫士盯了$P一眼, 又若无其事地转过头去. \n", me);
    return;
}  

int accept_fight( object me )
{
    message_vision("守门卫士盯了$P一眼, 欠身说道: 在下有要务在身, 恕不能奉陪. \n", me );
    return 0;
}

int refuse_killing( object me )
{
    int i;
    object *inv;

    me->apply_condition("kill_yipin", 100 );
    
    inv=all_inventory( environment( this_object() ) );
    for ( i=0; i< sizeof(inv); i++ )
    {
        if( userp( inv[i] )) continue;
        if( !inv[i]->IsMemberOf("yipin") ) continue;
		inv[i]->kill_ob(me);
        me->fight_ob( this_object() );
    } 
    return 0;
} 
