#include <ansi.h>

inherit NPC;

void create()
{
	set_name(GRN"护卫"NOR, ({ "hu wei","wei"}));
    set("title",GRN"一品堂总堂"NOR);
    set("age", 20+random(10));
    set("gender", "男性");
    set_wugong("chusuifeng",60,60,1);
	set_wugong("wuhu-dao",100,100,1);
    set_xiuwei_by_type("dodge",600);
	set_xiuwei_by_type("blade",600);
    set("combat_exp", 100000);
	JoinZuzhi("yipin","指挥使","玄阳堂");    
	set("force",1000);
	set("max_force",1000);
	set("force_factor",10);
    set("chat_chance", 3 );
    set("chat_msg", ({
        (:random_move:),
    }) );
    setup(); 
    carry_object(__DIR__"obj/cloth2")->wear();
    carry_object(__DIR__"obj/blade2") ->wield();   
} 

void init()
{
    object me,ob;
    me=this_player();
    
    if( me->query_condition("kill_yipin") )
    {
        if( me->query_temp_marks("lnwm/yipin/be_followed") > 4 )
				return;
		message_vision(RED"护卫高声叫喊：往哪逃？\n"NOR,me);
        kill_ob(me);
        me->fight_ob(this_object());
        ob = new( __DIR__"huwei5" );
        ob->move( environment( me ) );
        ob->set("force_factor",70);
		ob->kill_ob( me );
        me->fight_ob( ob );
        ob->set_leader( me );
    	me->add_temp_marks( "lnwm/yipin/be_followed", 1 );
	}
    return;
}
