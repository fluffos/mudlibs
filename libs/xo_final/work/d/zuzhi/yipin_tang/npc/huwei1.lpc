#include <ansi.h>
#include "weishi.h"

inherit NPC;

void create()
{
	set_name(YEL"金甲护卫"NOR, ({ "hu wei","wei"}));
    set("title",YEL"一品堂总堂"NOR);
    set("age", 30+random(10));
    set("gender", "男性");
    set_wugong("banruo-shenfa",80,80,1);
	set_wugong("damo-jian",80,80,1);
    set_xiuwei_by_type("dodge",600);
	set_xiuwei_by_type("sword",600);
    set("combat_exp", 50000);
	JoinZuzhi("yipin","指挥使","玄阳堂");    
	set("force",1000);
	set("max_force",1000);
	set("force_factor",20);
    setup(); 
    carry_object(__DIR__"obj/cloth1")->wear();
    carry_object(__DIR__"obj/jian1") ->wield();
}   
