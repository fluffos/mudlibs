// Room: /xuanwu/neiyuan_men.c

inherit ROOM;

void create() {
  mixed *local = localtime(time());
  int time = local[2] * 60 + local[1] * 15 + local[0];

  set("short", "内院门");
  set("long", @LONG
你信步走到玄武堂的内院门前。一阵寒风来，你不禁紧了紧身上
的衣衫。环顾四下里，正好看见院里看门阿三冻得直跺脚。门外的小
路分了个岔，向山腰的练武场折去。
LONG
  );
  set("exits", ([ /* sizeof() == 3 */
    "east": __DIR__ "xiaolu2",
    "west": __DIR__ "menfang",
    "north": __DIR__ "tingyuan3",
  ]));
  set("outdoors", "xuanwu");

  printf("time=%d\n", time);
  if (time < 240) {
    create_door("east", ([
      "name": "两扇朱漆大门",
      "lock": "玄武堂内院门",
      "status": 3,
      "id": ({ "east", "朱漆大门", "door" }),
      "other_side_dir": "west",
    ]));
    call_out("do_open", 240 - time);
  } else {
    create_door("east", ([
      "name": "两扇朱漆大门",
      "lock": "玄武堂内院门",
      "status": 0,
      "id": ({ "east", "朱漆大门", "door" }),
      "other_side_dir": "west",
    ]));
    call_out("do_close", 720 - time);
  }
  set("no_clean_up", 0);

  setup();
}

void do_open() {
  object npc;

  remove_call_out("do_open");
  if (npc = present("a san", load_object(__DIR__ "menfang"))) {
    tell_room(this_object(), @LONG
阿三披着衣服揉着惺忪的睡眼从屋里走出来，掏出一把钥匙，“喀嚓
”一声打开了门上的大铁锁，然后使劲把朱漆大门推了开来。一阵寒
风吹来，冻得他打了个寒战，赶紧溜回房里接着做他的黄梁美梦去了。
LONG);
    this_object()->unlock_door("east", "玄武堂内院门");
    this_object()->open_door("east");
  }
  call_out("do_close", 480);
}

void do_close() {
  object npc;

  remove_call_out("do_close");
  if (npc = present("a san", load_object(__DIR__ "menfang"))) {
    tell_room(this_object(), @LONG
阿三拎着一串钥匙从屋里走出来，先用力把大门掩上，“喀嚓”一声
落了锁。然后又施施然地踱了回去。
LONG);
    this_object()->close_door("east");
    this_object()->lock_door("east", "玄武堂内院门");
  }
  call_out("do_open", 240);
}
