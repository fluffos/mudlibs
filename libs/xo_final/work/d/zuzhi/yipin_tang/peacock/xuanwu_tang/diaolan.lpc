// Room: /xuanwu/diaolan.c

inherit ROOM;

void create()
{
    set("short", "吊篮");
    set("long", @LONG
一个硕大的吊篮，虽说是木制的，但绝对和精美无缘。不过这一
根根粗壮敦实的木料，以及那腕口粗的绞索，到真的很给人安全感。
LONG );
    set("exits/out", __DIR__"xuanya1" );
    set("no_clean_up", 0);

    setup();
}

void go_down()
{
    object room = this_object(), outside;

    if ( query("exits/out") == __DIR__"xuanya1" )
    {
        tell_room( room, @LONG
两名青衣卫士合力转动绞盘，在一阵“嘎嘎”的声响中，吊篮从崖边
缓缓垂了下去。
LONG );
        delete("exits");
        if ( outside = find_object( __DIR__"xuanya1" ) )
        {
            tell_room( outside, @LONG
两名青衣卫士合力转动绞盘，在一阵“嘎嘎”的声响中，吊篮从崖边
缓缓垂了下去。
LONG );
            outside->delete("exits/enter");
        }
        call_out( "go_down", 5 );
    }
    else if ( undefined( "exits/out" ) &&  !query_marks("山腰") )
    {
        set( "long", @LONG
吊篮在凛冽的山风中轻轻摇晃着。你看着忽远忽近的山壁，不禁
提心吊胆的。但就现在而言，无论愿意不愿意，都只能把全部的信任
寄托在上面的两位身上了。
LONG );
        tell_room( room, "山腰\n");
        set_marks("山腰" , 1);
        call_out( "go_down", 5 );
    }
    else
    {
        delete_marks("山腰");
        set("exits/out", __DIR__"tianjing");
        set("long", @LONG
一个硕大的吊篮，虽说是木制的，但绝对和精美无缘。不过这一
根根粗壮敦实的木料，以及那腕口粗的绞索，到真的很给人安全感。
LONG );
        if ( outside = find_object( __DIR__"tianjing" ) )
        {
            tell_room( outside, "从崖边缓缓垂下了一个吊篮。\n" );
            outside->set("exits/enter", __DIR__"diaolan" );
        }
        call_out( "go_up", 5 );
    }
}

void go_up()
{
    object room = this_object(), outside;

    if ( query("exits/out") == __DIR__"tianjing" )
    {
        tell_room( room, "吊篮轻轻一颤，然后缓缓向上升起。\n" );
        delete("exits");
        if ( outside = find_object( __DIR__"tianjing" ) )
        {
            tell_room( outside, "吊篮轻轻一颤，然后缓缓向上升起。\n" );
            outside->delete("exits/enter");
        }
        call_out( "go_up", 5 );
    }
    else if ( undefined("exits/out") &&  !query_marks("山腰") )
    {
        set( "long", @LONG
吊篮在凛冽的山风中轻轻摇晃着。你看着忽远忽近的山壁，不禁
提心吊胆的。但就现在而言，无论愿意不愿意，都只能把全部的信任
寄托在上面的两位身上了。
LONG );
        set_marks("山腰" , 1);
        call_out( "go_up", 5 );
    }
    else
    {
        delete_marks("山腰");
        set("exits/out", __DIR__"xuanya1");
        set("long", @LONG
一个硕大的吊篮，虽说是木制的，但绝对和精美无缘。不过这一
根根粗壮敦实的木料，以及那腕口粗的绞索，到真的很给人安全感。
LONG );
        if ( outside = find_object( __DIR__"xuanya1" ) )
        {
            tell_room( outside, "从崖边缓缓升上了一个吊篮。\n" );
            outside->set("exits/enter", __DIR__"diaolan" );
        }
    }
}

int receive_blow( string arg )
{
    int t1, t2;
    string *args, msg, s1, s2;
    object room = this_object();

    msg = "从下面的山谷里传来了";

    args = explode( arg, " ");
    switch ( sizeof( args ) )
    {
        case 1:
            sscanf( args[0], "%d%s", t1, s1);
            if ( s1 == "l" ) s1 = "悠长";
            else s1 = "短促";
            msg += CHINESE_D->chinese_number( t1 ) + "声" + s1 + "的哨响。\n";
            break;
        case 2:
            sscanf( args[0], "%d%s", t1, s1);
            sscanf( args[1], "%d%s", t2, s2);
            if ( s1 == "l" )
            {
                s1 = "长";
                s2 = "短";
            }
            else
            {
                s1 = "短";
                s2 = "长";
            }
            msg +=  CHINESE_D->chinese_number( t1 ) + s1 +
                    CHINESE_D->chinese_number( t2 ) + s2 + "的" +
                    CHINESE_D->chinese_number( t1 + t2 ) + "声哨响。\n";
            break;
        default:
            msg += "一串长短错落变化繁复的哨音。";
            break;
    }
    tell_room( room, msg );

    return 1;
}

int event_blow( string arg )
{
    object xuanya = load_object( __DIR__"xuanya1" );

    tell_room( this_object(), "尖锐的哨声冲天而起，划破云霄。\n" );
    return xuanya->receive_blow( arg );
}