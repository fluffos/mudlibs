// Room: /xuanwu/xiaochuan.c

inherit ROOM;

void create()
{
    set("short", "小船");
    set("long", @LONG
一艘木制的小船，除了操舟的黑衣人，只能容得下两人入座。
LONG );
    set("exits/out", __DIR__"yandong" );

    setup();
    call_out( "goto_next_room", 5 );
}

void goto_next_room()
{
    object room = this_object(), outside;

    outside = query( "exits/out" );
    switch ( outside )
    {
        case __DIR__"yandong":
            delete("exits");
            set_marks( "方向", __DIR__"tianjing" );
            set( "long", "四下里黑漆漆的，什么都看不见，只有淙淙的水声不断。\n");
            tell_room( room,
                "黑衣人扳动双桨，小舟向暗河划去。\n"
                "一进入暗河，四周一下子就黑了起来。在这地底十余丈的地方，原本\n"
                "就是没有任何一丝光线的。\n" );
            if ( outside = find_object( outside ) )
            {
                tell_room( outside, "黑衣人扳动双桨，小舟向暗河划去。没入漆黑的河道中，消失不见了。\n" );
                outside->delete("exits/enter");
            }
            call_out( "goto_next_room", 5 );
            break;
        case __DIR__"tianjing":
            delete("exits");
            set_marks( "方向", __DIR__"yandong" );
            set( "long", "四下里黑漆漆的，什么都看不见，只有淙淙的水声不断。\n");
            tell_room( room,
                "黑衣人扳动双桨，小舟向暗河划去。\n"
                "一进入暗河，四周一下子就黑了起来。在这地底十余丈的地方，原本\n"
                "就是没有任何一丝光线的。\n" );

            outside = load_object( outside ) )
            tell_room( outside, "黑衣人扳动双桨，小舟向暗河划去。没入漆黑的河道中，消失不见了。\n" );
            outside->delete("exits/enter");

            call_out( "goto_next_room", 5 );
            break;
        case 0:
            outside = query_marks( "方向" );
            delete_marks( "方向" );
            set( "exits/out", outside );
            set("long", "一艘木制的小船，除了操舟的黑衣人，只能容得下两人入座。\n" );
            tell_room( room,
                "忽然，你发现前面仿佛有一线光亮，却又暗淡地仿佛是幻觉。\n"
                "转过一个小弯之后，小船驶出了地下河，四下里一下子就亮起来了。\n" );
            if ( outside = find_object( outside ) )
            {
                tell_room( outside, "忽然一阵水声传来，一艘小船从暗河中驶了出来。\n" );
                outside->set( "exits/enter", __DIR__"duchuan" );
            }
            call_out( "goto_next_room", 5 );
            break;
        default:
            delete("exits");
            tell_room( room, 
                "船上有人没有？怎么开到天上来了？\n"
                "噢，出Bug 了？赶紧报告巫师吧。\n" );
            remove_call_out( "goto_next_room" );
            break;
    }
}

