//zhangfang.c 玄武堂的帐房先生。
//高手噢，人称铁算盘，是堂主的幕后军师，平日深藏不露。
//还没想好怎么做秘密。

#include <ansi.h>

inherit NPC;

void create() {
  set_name("帐房先生", ({ "zhangfang xiansheng", "zhangfang", "xiansheng" }));
  set("gender", "男性");
  set("age", 50 + random(10));
  set("long", "一个身着长衫的帐房先生，正低着头扒拉算盘。\n");

  set("str", 23); set("cor", 20); set("int", 25);
  set("per", 22); set("spi", 24); set("cps", 13);
  set("dex", 20); set("con", 28); set("kar", 18);

  set("force", 1000); set("max_force", 1000); set("force_factor", 0);

  set_wugong("dodge", 100);
  set_wugong("unarmed", 100);
  set_wugong("feiyan-gong", 100, 100, 1);
  set_wugong("tiesha-zhang", 100, 100, 1);
  set_wugong("duanshi-xinfa", 80, 80, 1);
  set_xiuwei_by_type("dodge", 1000);
  set_xiuwei_by_type("unarmed", 1000);
  set_xiuwei_by_type("short", 2000);
  set("combat_exp", 30000);
  set("social_exp", 50000);
  setup();
  carry_object(CLOTH_DIR "cloth5")->wear();
  carry_object(__DIR__ "obj/suanpan");
  JoinZuzhi("yipin", "护国都尉", "玄武堂");
}

int refuse_killing(object me) {
  command("wield suanpan");
  return 0;
}

int accept_fight(object me) {
  if (me->IsMemberOf("yipin")) {
    if (me->query_condition("can_stay_in_xuanwu") > 2) {
      say("帐房先生笑道：“糟老头子哪会什么武功。”\n");
      return 0;
    } else if (sizeof(filter(all_inventory(me), function(object inv)
      {
        if ((inv->name() == YEL "玄武令" NOR) &&
          (inv->query("id") == "ling pai"))
          return 1;
        else return 0;
      }))) {
      command("say 你不赶紧到堂主那里去报到，还等什么呢？\n");
      return 0;
    } else {
      message_vision(CYN, me);
      message_vision2("$N神情紧张地四下张望了一下，回过身来对$n道："
        "“过了时限还不赶紧走，你不要命啦？！”",
        this_object(), me);
      message_vision(NOR, me);
      return 0;
    }
  } else {
    message_vision(CYN "$N看了$n一眼，脸色忽然大变：咦？你是什么人？"
      "怎么闯上来的？\n" NOR
      , this_object(), me);
    command("wield suanpan");
    kill_ob(me);
    return notify_fail("");
  }
}

int valid_teach(object me, string skill) {
  say("帐房先生笑道：“糟老头子哪会什么武功。”\n");
  return 0;
}
