// /xuanwu_tang/suidao.c

#include <ansi.h>

inherit ROOM;

string look_lamp(object);

void create() {
  set("short", "隧道");
  set("long", @LONG
一条南北走向的隧道，平整的墙壁显示出开凿者是颇下了一些功
夫的，墙上还嵌着几盏铜制的油灯，照得长近十丈的隧道亮堂堂的。
隧道的北端向下倾斜，开口在一个天然岩洞的洞顶处。借着油灯的光
芒，你能看见一道台阶沿着洞壁盘旋而下。隧道的南端是一道平整的
石壁封住了去路。
LONG);

  set("detail", ([
    "lamp": (: look_lamp :),
    "油灯": (: look_lamp :),
    "灯": (: look_lamp :),
  ]));

  set("exits", ([
    "down": __DIR__ "yandong1.lpc",
  ]));

  setup();
}

void init() {
  add_action("do_turn", "turn");
}

string look_lamp(object me) {
  int exp = me->query("social_exp");

  printf("exp = %d\n", exp);
  if (exp < 900) {
    if (exp < 100)
      call_out("lamp0", 10, me);
    else
      call_out("lamp1", (1000 - exp) / 100, me);
    return @TEXT
你望着油灯，心里很是奇怪，这些油灯固然比平常的来得硕大，但就
算注满了油也最多不过能着个一天一夜，为什么这里的油灯好象是常
年累月地长明不灭的呢？
TEXT;
  }
  if (exp < 9000) {
    if (exp < 1000)
      call_out("lamp0", 10, me);
    else
      call_out("lamp2", (10000 - exp) / 1000, me);
    return @TEXT
你望着油灯，心中觉得很奇怪，在地下点火不是很容易熄灭的吗？而
这里点着这么多盏灯，却一点也不觉得气闷。
TEXT;
  }
  return @TEXT
呵呵。
TEXT;
}

void lamp0(object me) {
  tell_object(me, "你始终想着灯的事，真是百思不得其解。\n");
}

void lamp1(object me) {
  tell_object(me, @TEXT
你始终想着灯的事，终于想到了答案，应该有人天天来加灯油的吧。
也许就是那个带你进来的农民呢。对，应该就是他了。
TEXT);
}

void lamp2(object me) {
  if (present(me, this_object()))
    tell_object(me, @TEXT
你仔细看着油灯，忽然发现底座上开着几个不起眼的小洞。附耳过去
还能听见轻微的气流声。你快步走到走到另一盏灯前发现也是如此。
原来这条隧道的通风口是开在灯上的，难怪平整的洞壁上什么都没有。
TEXT);
  else tell_object(me, @TEXT
你想灯的事想了一路，还是没想明白。
“也许那些灯有些什么不同寻常的地方吧，真应该看仔细些的。”
明白了这么空想是没有用的之后，你这么想道。
TEXT);
}

void open_exit() {
  message("vision", @TEXT
只听得“喀啦啦”地一阵轻响，南边的墙裂作几段，逐层陷了进去，
形成了一道台阶通向上面。
TEXT, this_object());
  set("exits/up", __DIR__ "xiaowu");
}

void close_exit() {
  message("vision", @TEXT
只听得“喀啦啦”地一阵轻响，通向上面的阶梯逐级收了回来，合并
成一道平整的墙面。
TEXT, this_object());
  delete("exits/up");
}

int do_turn(string arg) {
  object *obs, me = this_player(), room = load_object(__DIR__ "xiaowu");

  if (!arg || arg == "") return notify_fail("你想转动什么？\n");
  if ((arg != "lamp") && (arg != "油灯") && (arg != "灯"))
    return 0;

  if (query("exits/up")) {
    message_vision("$N走到最南端的油灯旁，将灯座向右转了半圈。\n", me);
    close_exit();
    room->close_exit();
  } else {
    message_vision("$N走到最南端的油灯旁，将灯座向左转了半圈。\n", me);
    open_exit();
    room->open_exit();
  }
  return 1;
}
