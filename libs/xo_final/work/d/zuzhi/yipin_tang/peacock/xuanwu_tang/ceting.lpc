
inherit ROOM;

void create()
{
    set("short", "侧厅");
    set("long", @LONG
这里是玄武堂的侧厅。地上铺着一条绣金绿绒富贵毯，走在上面
，软软的，好象春天的嫩草地。靠着墙立着两排高达屋顶的书架，上
面塞满了一品堂多年来积累的各种资料。屋顶垂下数条鹿皮索，供书
奴们纵身取书时借力用。屋角的一樽盘龙纹鼎正幽幽地散出一股莫名
的芳香。一品堂的高手们时常在这里听手下的情况汇报。
    西边穿过一道珠帘是个庭院，不时有巡逻的卫士走过。
LONG
    );
    set("exits", ([ /* sizeof() == 1 */
        "west"	: __DIR__"tingyuan1",
    ]));
