//jieyin_ren.c 一品堂之玄武堂的接引人

#include <ansi.h>

inherit NPC;

int wait = 0;

int ask_for_xuanwu(object);
void do_dailu0(object);
void do_dailu1(object);

void create() {
  set_name("农夫", ({ "nong fu", "nongfu", "man" }));
  set("gender", "男性");
  set("age", 40);
  set("long", "一个典型的北方农民，正光着膀子在田里干活。\n");
  set("combat_exp", 3000);
  set_wugong("unarmed", 30, 30, 1);
  set("inquiry", ([
    "玄武堂": (: ask_for_xuanwu :),
  ]));

  set("chat_chance", 1);
  set("chat_msg", ({
    "农夫抬手擦了一下额头上的汗珠，又继续干他的活。\n",
  }));

  setup();
  //    carry_object(__DIR__"obj/cloth1")->wear();
}

void init() {
  add_action("do_say", "say");
}

int do_say(string arg) {
  object me = this_player();

  if (arg == "河图") {
    do_dailu0(me);
    return 1;
  }
  return 0;
}

int ask_for_xuanwu(object ob) {
  object me = this_player();

  message_vision("$N抬头看了$n一眼，又低下头去干活。\n", ob, me);
  call_out("do_jietou", random(4) + 3, me);
  return 1;
}

void do_jietou(object me) {
  message_vision("$N忽然抬起头来问$n：「这位" + RANK_D->query_respect(me) +
    "，你可曾听说过河图？」\n", this_object(), me);
}

void do_dailu0(object me) {
  say("一个农民直起腰来，拄着锄头答道：「灵龟。」\n");
  set("long", "一个光着膀子的农民，他正拄着锄头望着你。\n");
  do_dailu1(me);
}

void relay_whisper(object me, string msg) {
  if (msg != "河图")
    message_vision(BLU "$N抬头看了$n一眼，脸上露出疑惑的表情。\n" NOR,
      this_object(), me);
  else do_dailu1(me);
}

void do_dailu1(object me) {
  message_vision2("$N直起腰来，抬头看看天，然后拖着锄头走到田边，"
    "在$n身前的田埂上坐了下来。",
    this_object(), me);
  command("whisper " + me->query("id") + " 随我来。");
  call_out("do_dailu2", 5, me);
}

void do_dailu2(object me) {
  object ob = this_object();

  if (me->query_leader() != ob) {
    if (wait < 4) {
      wait += 1;
      call_out("do_dailu2", 5, me);
    } else {
      message_vision("$N疑惑地看了$n一眼，又抡起锄头锄起地来。\n", ob, me);
      set("long", "一个典型的北方农民，正光着膀子在田里干活。\n");
      wait = 0;
    }
  } else {
    message_vision("$N放下手里的锄头，转身离去。\n", ob);
    command("north");
    wait = 0;
  }
}
