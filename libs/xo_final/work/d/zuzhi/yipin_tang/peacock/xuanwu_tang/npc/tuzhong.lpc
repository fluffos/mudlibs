//tuzhong.c 一品堂之玄武堂的普通徒众

#include <ansi.h>

inherit __DIR__ "weishi";

void create() {
  set_name(HIG "徒众" NOR, ({ "tuzhong" }));
  set("gender", "男性");
  set("age", 20 + random(10));
  set("long", "一个身着黑色劲装的男子。\n");

  set("combat_exp", 3000);
  //    set_wugong("unarmed",30,30,1);

  setup();
  carry_object(__DIR__ "obj/cloth1")->wear();
}
