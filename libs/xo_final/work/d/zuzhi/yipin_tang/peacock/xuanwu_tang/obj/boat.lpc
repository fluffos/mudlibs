// filename:    diaolan.c
// by peacock 9/5/1997
// 备注：一品堂之玄武堂悬崖处的吊篮。

#include <ansi.h>
#define XUANWU_TANG "/u/peacock/xuanwu_tang/"

inherit ITEM;

int loaded;

void create() {
  set_name("吊篮", ({ "diao lan", "diaolan", "lan" }));
  set("long", @LONG
一个硕大的吊篮，虽说是木制的，但绝对和精美无缘。不过这一
根根粗壮敦实的木料，以及那腕口粗的绞索，到真的很给人安全感。
LONG);
  set("unit", "个");
  set("value", 1);
  set("weight", 100000);
  set("no_get", 1);

  setup();
  loaded = 0;
}

void init() {
  add_action("do_enter", "enter");
  add_action("do_out", "out");
  //add_action("do_look", "look");
}

int do_enter(string arg) {
  object ob = this_object(), me = this_player();

  if (!id(arg) && (arg != "吊篮") && (arg != "篮"))
    return 0;
  if (me->query_temp_marks("玄武/吊篮")) {
    write("你已经在吊篮里了。\n");
    return 1;
  }

  me->set_temp_marks("玄武/吊篮", 1);
  message_vision("$N手扶篮圈略一借力，纵身跃入篮内。\n", me);
  return 1;
}

int do_out(string arg) {
  object ob = this_object(), me = this_player();

  if (!id(arg) && (arg != "吊篮") && (arg != "篮"))
    return 0;
  if (!me->query_temp_marks("玄武/吊篮")) {
    write("你根本就不在吊篮里。\n");
    return 1;
  }

  me->delete_temp_marks("玄武/吊篮");
  message_vision("$N手扶篮圈略一借力，纵身跃出吊篮。\n", me);
  return 1;
}

varargs int move(mixed dest, int silent) {
  object room = environment(this_object());
  object *invs;
  int i, result;

  if ((result = ::move(dest, silent)) && room) {
    invs = all_inventory(room);
    for (i = sizeof(invs) - 1; i >= 0; i--) {
      if (invs[i]->is_character() &&
        invs[i]->query_temp_marks("玄武/吊篮"))
        invs[i]->move(dest, silent);
    }
  }
  return result;
}

void go_down() {
  object ob = this_object(), room = find_object(XUANWU_TANG "xuanya1");

  if (room == environment(ob)) {
    message("vision", @LONG
两名玄武堂弟子合力转动绞盘，在一阵“嘎嘎”的声响中，吊篮从崖
边缓缓垂了下去。
LONG, room);
    set("long", @LONG
凛冽的山风吹过，吊篮轻轻摇晃起来。你看着忽远忽近的山壁，
不禁提心吊胆的。但就现在而言，无论愿意不愿意，都只能把全部的
信任寄托在上面的两位身上了。
LONG);

    move(XUANWU_TANG "shanyao");
  } else move(XUANWU_TANG "tianjing");
}

void go_up() {
  object ob = this_object(), room = find_object(XUANWU_TANG "tianjing");

  if (room == environment(ob)) {
    message("vision", @LONG
绞索倏然绷紧，曳动吊篮向上升去。
LONG, room);
    set("long", @LONG
凛冽的山风吹过，吊篮轻轻摇晃起来。你看着忽远忽近的山壁，
不禁提心吊胆的。但就现在而言，无论愿意不愿意，都只能把全部的
信任寄托在上面的两位身上了。
LONG);

    move(XUANWU_TANG "shanyao");
  } else move(XUANWU_TANG "xuanya1");
}
