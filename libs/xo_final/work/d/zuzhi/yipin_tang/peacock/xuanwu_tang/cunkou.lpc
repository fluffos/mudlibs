// xuanwud.c XUANWU_D

#include "ansi.h"

inherit ROOM;

void create() {
  set("short", "村口");
  set("long", @LONG
你站在一个小山村的村口处。看得出来，这里很穷。
LONG
  );
  set("valid_startroom", 1);
  set("exits", ([
    "north": __DIR__ "xiaowu",
  ]));
  set("objects", ([
    __DIR__ "npc/nongfu": 3,
    __DIR__ "npc/jieyin_ren": 1,
  ]));
  set("outdoors", "xuanwu");
  setup();
}

int welcome_visitor(object who) {
  tell_object(who, "你游目四望，只见几个农夫正在田里干活。\n");

  if (present("nong fu"))
    tell_object(who,
      "一个农夫正巧看见你望着他，冲你点了一下头，又接着忙他的活。\n"
    );

  return 1;
}
