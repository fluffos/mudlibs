inherit ROOM;

void create() {
  set("short", "碎石小道");
  set("long", @LONG
转离兴州府的喧嚣闹市，你折向一条曲曲折折的碎石小路。小路蜿蜒向北，穿
过一片树丛转几个弯，消失在绿荫之后。这里已经是兴州府的近郊，地势渐渐开阔
向西望去，能隐隐望的见贺兰山的雪峰。小路的一侧不知什么时候多出了一条小溪
随路蜿蜒南去。
LONG
  );
  set("exits", ([
    "south": "/d/city/xingqing/road26",
    "northeast": __DIR__ "xiaodao2",
  ]));
  set("outdoors", "lnwm");
  setup();
}
int valid_leave(object who, string dir) {
  if (!userp(who) && dir == "south")
    return 0;
  return ::valid_leave(who, dir);
}
