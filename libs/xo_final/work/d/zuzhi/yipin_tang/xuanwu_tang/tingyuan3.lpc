// Room: /xuanwu/tingyuan3.c

inherit ROOM;

void create() {
  set("short", "庭院");
  set("long", @LONG
在两间休息室之间，夹着一个小小的庭院。一只小猫正好奇的昂
着头，对着天上飘落的雪花喵喵直叫。风儿吹过，屋檐下的冰霖互相
撞击，叮令作响，仿佛是一挂挂风铃。院子当中的石桌上堆着几个空
酒坛子。也不知是那几个醉猫留下的。
    从这往南就是玄武堂的内院了。北边飘来阵阵酒肉香气，那是吃
饭的地方了。
LONG
  );
  set("exits", ([ /* sizeof() == 4 */
    "east": __DIR__ "xiuxi_shi1",
    "west": __DIR__ "xiuxi_shi2",
    "south": __DIR__ "neiyuan_men",
    "north": __DIR__ "tingyuan4",
  ]));
  set("no_clean_up", 0);
  set("outdoors", "xuanwu");
  setup();
}
