// xuanwud.c XUANWU_D

#include "ansi.h"

inherit ROOM;

void create()
{
    set("short", "村口");
    set("long", @LONG
出了村子往西，是一片麦田。贺兰山脉终年积雪，气候寒冷，每年只在夏季
的几个月内可以种植作物，因此在山脚下少有农夫耕作。不过这里好象是例外，
想是积雪在夏季融化，灌溉了这里的一片土地。即便如此，这里的土地亦是以沙
石为主，并不富饶，因此在这里生活，并不富裕，只勉强温饱。
LONG
       );
    set("valid_startroom", 1);
    set("exits", ([
		"north" 	:   __DIR__ "xiaowu",
        "southeast"	:	__DIR__ "shancun",
		]) );
    set("objects", ([
        __DIR__ "npc/nongfu" : 3,
        __DIR__ "npc/jieyin_ren" :1,
        ]) );
    set("outdoors","xuanwu");
    setup();
}

int welcome_visitor( object who )
{
    tell_object( who, "你游目四望，只见几个农夫正在田里干活。\n");

    if ( present( "nong fu" ) )
        tell_object( who, 
            "一个农夫正巧看见你望着他，冲你点了一下头，又接着忙他的活。\n"
            );

    return 1;
}
