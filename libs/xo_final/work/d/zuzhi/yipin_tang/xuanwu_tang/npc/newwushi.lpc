#include <ansi.h>

inherit __DIR__"weishi";

void leave( object ob );

void create()
{
    set_name( HIG "卫士" NOR , ({ "jinyi weishi", "weishi" }) );
    set("gender", "男性" );
    set("age", 20 + random(10) );
    set("long", "一个身着锦衣，外罩大红武士袍的男子。\n");

    set("max_force",2000);
    set("force",2000);
    set("force_factor", 150);
    set("env/attack", 80);

    set("combat_exp", 10000);
    set_xiuwei_by_type("sword",1400);
    set_xiuwei_by_type("zonggang", 300);
    
    set_wugong("haoran-zhengqi",100,100,1);
    set_wugong("sword",130,130,1);
    setup();

    call_out( "leave", 60, this_object() );
    
//    carry_object(__DIR__"obj/cloth1")->wear();
//    carry_object(__DIR__"obj/cloth1")->wield();
}

void leave( object ob )
{
    message_vision( "$N匆匆离开了。\n", ob );
    destruct( ob );
}
    