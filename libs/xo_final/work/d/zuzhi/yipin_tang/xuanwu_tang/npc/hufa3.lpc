// hufa3.c 一品堂之玄武堂的护法。

#include <ansi.h>

inherit __DIR__ "hufa";

void create() {
  set_name(HIW "武神通" NOR, ({ "wu shentong", "wu", "hufa" }));
  set("gender", "男性");
  set("age", 55);
  set("long", "一个身着红稠锦衣的男子，身形彪悍，拳掌生风，正是一品堂的传功护法。\n");
  set("title", HIY "玄武堂护法" NOR);
  set("combat_exp", 1500000);
  set("social_exp", 30000);
  set_force(2000, 2000, 200);
  set_wugong("panheng-zhang", 100, 100, 1);
  set_wugong("yanxing", 50, 50, 1);
  set_xiuwei("unarmed", 1900);
  set_xiuwei("dodge", 900);
  JoinZuzhi("yipin", "传功护法", "玄武堂");

  setup();
  carry_object(__DIR__ "obj/hufacloth")->wear();
}
