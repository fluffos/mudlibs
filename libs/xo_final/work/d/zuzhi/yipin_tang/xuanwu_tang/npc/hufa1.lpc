// hufa1.c 一品堂之玄武堂的护法。

#include <ansi.h>

inherit __DIR__"hufa";

void create()
{
    set_name( HIW"铁影"NOR , ({ "tie ying", "tie", "hufa" }) );
    set("gender", "男性" );
    set("age", 45 );
    set("long", "一个身着红稠锦衣的男子，手持长剑，肃然而立，正是一品堂的传功护法。\n");
    set("title",HIY"玄武堂护法"NOR);
    set("combat_exp", 1500000);
    set("social_exp", 30000);
    set_force(2000,2000,200);
    set_wugong("xuanzhu-jian",100,100,1);
    set_wugong("kunlun-bu",60,60,1);
    set_xiuwei("sword",1900);
    set_xiuwei("dodge",1200);
    JoinZuzhi("yipin","传功护法","玄武堂");

    setup();
    carry_object(SWORD_DIR"sword1")->wield();
    carry_object(__DIR__"obj/hufacloth")->wear();
}
