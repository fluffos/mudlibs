//玄武堂的标准npc。
// by lnwm 98-09-06

#include <ansi.h>

inherit NPC;

private int InAlarm = 0;

int is_xwnpc()
{
    return 1;
}

int SetAlarm( int Alarm )
{
    InAlarm = Alarm;
}

int QueryAlarm()
{
    return InAlarm;
}

int refuse_killing( object ppl )
{
    ppl->set_temp_marks( "lnwm/闯入玄武", 1 );
    ppl->apply_condition("kill_xuanwu", 150 );
    XUANWU_D->EnemyCome( environment( this_object() ) );
    //警报发动。
    return 0;
}