// suanpan.c
// modified by lin 21/05/97
#include <weapon.h>
#include <ansi.h>
inherit SHORT;

void create() {
  set_name("算盘", ({ "suanpan", "abacus" }));
  set_weight(250);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
    set("long", @LONG
看起来普普通通的一个的算盘，入手居然如此沉重，实在是出乎你的
意料之外。仔细看来，赫然是镔铁铸成的，难怪这么重。想来要是砸
在人身上也一定很过瘾吧。
LONG);
    set("value", 120);
    set("material", "iron");
    set("wield_msg", "$N抄起$n。\n");
    set("unwield_msg", "$N放下手中的$n。\n");
    set("verbs", ({ "chop", "point", "bash", "crush", "slam" }));
  }

  init_short(3);
  setup();
}
