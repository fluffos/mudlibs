// hufacloth.c 红稠锦衣

#include <armor.h>

inherit CLOTH;

void create() {
  set_name("红稠锦衣", ({ "hongchou jinyi", "jinyi", "cloth" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("material", "cloth");
    set("value", 3000);
    set("armor_prop/armor", 6);
  }
  setup();
}
