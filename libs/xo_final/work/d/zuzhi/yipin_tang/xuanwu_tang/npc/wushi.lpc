//wushi.c
//by lnwm 98-09-06
//武士是防卫玄武堂的xwnpc，敌人入侵时要赶到出事现场。
//可以对练

#include <ansi.h>

inherit __DIR__ "xwnpc";

int is_wushi() {
  return 1;
}

int welcome_visitor(object me) {
  object npc = this_object(), cloth, ling;
  int time_available;

  if (!userp(me)) return 0;
  foreach (object inv in deep_inventory(me)) {
    if ((inv->name() == YEL "玄武令" NOR) && inv->id("ling pai"))
      ling = inv;
    if ((inv->name() == "黑色号坎") && inv->id("hao kan"))
      cloth = inv;
  }

  if (!cloth && !ling
    || me->query_temp_marks("lnwm/闯入玄武")
    || me->query_condition("kill_xuanwu")) {
    message_vision("$N大喝一声：“什么人竟想混入玄武堂，今天教你来得，去不得！”\n", npc);
    kill_ob(me);
    me->kill_ob(npc);
    me->set_temp_marks("lnwm/闯入玄武", 1);
    XUANWU_D->EnemyCome(environment(npc));
  } else if (ling) {
    message_vision("$N奇怪地看了$n一眼，你不去堂主那报到，在这里瞎转悠什么？\n", npc, me);
  } else if (time_available = me->query_condition("can_stay_in_xuanwu") > 2) {
    if (random(10) > 8)
      message_vision("$N冲$n微微一笑，点了一下头。\n", npc, me);
  } else {
    message_vision(GRN "$N见$n走了过来，诧异地说：“咦？你不是已经在这里待了三\n"
      "天了吗？还不赶快下山？”\n" NOR, npc, me);
  }
}

int query_ask_answer(object ppl, string arg) {
  object npc = this_object();

  if (random(2))
    message_vision("$N瞟了$n一眼道：“少用嘴多用手，你这颗脑袋自会长得牢靠些。”\n",
      npc, ppl);
  else
    message_vision("$N瞪了$n一眼，冷冷道：“不该你问的就别乱打听！”\n",
      npc, ppl);
  return 1;
}

int accept_fight(object me) {
  message_vision("$N瞪了$n一眼，道：“我正在执行公务，别烦我。”\n",
    this_object(), me);
  return 0;
}

int accept_duilian(object me) {
  if (QueryAlarm()) {
    tell_object(me, "现在正有敌人闯入玄武堂，你还是先去协助杀敌为好。\n");
    return 0;
  } else if (!me->query_condition("can_stay_in_xuanwu")) {
    message_vision("$N看了$n一眼，你早该下山了，恕不能奉陪。\n", this_object(), me);
    return 0;
  } else if (this_object()->query("gin") / this_object()->query("max_gin") > 0.6 &&
    this_object()->query("kee") / this_object()->query("max_kee") > 0.6 &&
    this_object()->query("sen") / this_object()->query("max_sen") > 0.6) {
    message_vision("$N一点头，那好吧，我就奉陪了。\n", this_object());
    return 1;
  } else {
    message_vision("$N摇摇头：你还是另找别人吧。\n", this_object());
    return 0;
  }
  return 0;
}
