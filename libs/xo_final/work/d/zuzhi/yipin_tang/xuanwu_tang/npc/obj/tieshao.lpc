// tieshao.c
//by lnwm 98-09-12

#include <ansi.h>

inherit ITEM;

void create() {
  set_name("铁哨", ({ "tieshao", "shao", "whistle" }));
  set_weight(50);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "只");
    set("long", @LONG
一只黑黝黝的哨子，是用生铁铸成的。看来要想吹(blow)响它，还颇要几分气力。
LONG);
    set("value", 1);
    set("material", "iron");
  }

  setup();
}

void init() {
  add_action("do_blow", "chui");
  add_action("do_blow", "blow");
}

string to_chinese(string str) {
  switch (str) {
    case "s":
      return "短";
    case "l":
      return "长";
    default:
      return 0;
  }
}

int do_blow(string arg) {
  string *args;
  string msg, s1, s2;
  int i, t1, t2;
  object obj = this_object(), ppl = this_player();

  if (!arg || arg == "") {
    write("你想怎么吹呢？几声长音几声短音？\n比如想吹出个三长两短来，就 blow 3l 2s。\n");
    return 1;
  }

  msg = "$N从怀里掏出一个铁哨，";
  args = explode(arg, " ");
  switch (sizeof(args)) {
    case 0:
      msg += "象叼奶嘴一样含在嘴里，把个头摇来晃去，也许是想吹出沉默之声吧。\n";
      break;
    case 1:
      sscanf(args[0], "%d%s", t1, s1);
      if (!(s1 = to_chinese(s1))) {
        write("这个音好象吹不出来。\n");
        return 1;
      }
      msg += "吹出了" + CHINESE_D->chinese_number(t1) + "个" + s1 + "音。\n";
      break;
    case 2:
      //            write(sprintf("%O\n",args));
      sscanf(args[0], "%d%s", t1, s1);
      sscanf(args[1], "%d%s", t2, s2);
      if (!(s1 = to_chinese(s1)) || !(s2 = to_chinese(s2))) {
        write("这串音好象吹不出来。\n");
        return 1;
      }
      if (s1 == s2) {
        write(CYN "哨子对你说：都是" + s1 + "音，还要分开来吹，你这算是玩我？大爷不干了！\n" NOR);
        write("你手里的哨子哗啦的一声就散架了。\n");
        destruct(obj);
        return 1;
      }
      msg += "吹出了" + CHINESE_D->chinese_number(t1) + s1 + CHINESE_D->chinese_number(t2) + s2 + "的"
        +CHINESE_D->chinese_number(t1 + t2) + "声哨响。\n";
      break;
    default:
      tell_object(ppl, "你想吹出一首歌吗？那么复杂！\n");
      return 1;
  }
  message_vision(msg, ppl);
  environment(ppl)->event_blow(arg);
  return 1;
}
