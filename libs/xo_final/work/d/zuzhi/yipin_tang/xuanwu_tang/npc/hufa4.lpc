// hufa4.c 一品堂之玄武堂的护法。

#include <ansi.h>

inherit __DIR__"hufa";

void create()
{
    set_name( HIW "木连秋" NOR , ({ "mu lianqiu", "mu", "hufa" }) );
    set("gender", "男性" );
    set("age", 52 );
    set("long", "一个身着红稠锦衣的男子，手中九节鞭精光闪闪，虎虎生威，正是一品堂的传功护法。\n");
    set("title",HIY"玄武堂护法"NOR);
    set("combat_exp", 1500000);
    set("social_exp", 30000);
    set_force(1800,1800,180);
    set_wugong("dulong-bian",100,100,1);
    set_wugong("shenxing",50,50,1);
    set_xiuwei("whip",1100);
    set_xiuwei("dodge",800);
    JoinZuzhi("yipin","护国将军","玄武堂");

    setup();
    carry_object(WHIP_DIR"9-whip")->wield();
    carry_object(__DIR__"obj/hufacloth")->wear();
}
