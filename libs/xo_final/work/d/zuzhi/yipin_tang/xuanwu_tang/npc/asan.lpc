//asan.c 一品堂之玄武堂的内院门房

#include <ansi.h>

inherit __DIR__ "weishi";

void create() {
  set_name("阿三", ({ "a san", "san" }));
  set("gender", "男性");
  set("age", 45 + random(10));
  set("long", @LONG
阿三是玄武堂内院的门房。要是谁练武回来晚了，内院门已经关了，
就得求他开门了。也许是晚上总睡不好的缘故，他成天睡眼惺忪的，
好象怎么也睡不醒似的。
LONG);

  set_wugong("unarmed", 30, 30, 1);
  set_wugong("dodge", 30, 30, 1);
  set_xiuwei_by_type("unarmed", 50);
  set_xiuwei_by_type("dodge", 50);
  set("combat_exp", 3000);
  set("social_exp", 10000);

  set("chat_chance", 10);
  set("chat_msg", ({
    "一阵寒风吹来，阿三不禁打了个寒颤。\n",
    "阿三裹紧了身上的羊皮袄，跺了跺脚。\n",
    CYN "阿三望着窗外骂道：“这个鬼地方……”\n" NOR,
    CYN "阿三笑着道：“天寒地冻的，晚上来我这儿喝几杯吧。”\n" NOR,
  }));
  setup();
  carry_object(__DIR__ "obj/yangpi_ao")->wear();
}
