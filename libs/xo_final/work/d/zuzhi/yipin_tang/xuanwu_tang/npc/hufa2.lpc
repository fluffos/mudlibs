// hufa2.c 一品堂之玄武堂的护法。

#include <ansi.h>

inherit __DIR__"hufa";

void create()
{
    set_name( HIW "洛无尘" NOR , ({ "luo wuchen", "luo", "hufa" }) );
    set("gender", "男性" );
    set("age", 55 );
    set("long", "一个身着红稠锦衣的男子，身形飘渺，显然轻功不凡，正是一品堂的传功护法。\n");
    set("title",HIY"玄武堂护法"NOR);
    set("combat_exp", 1500000);
    set("social_exp", 30000);
    set_force(1400,1400,140);
    set_wugong("zhuifeng-quan",50,50,1);
    set_wugong("huifeng-wuliu",100,100,1);
    set_xiuwei("unarmed",1400);
    set_xiuwei("dodge",1900);
    JoinZuzhi("yipin","传功护法","玄武堂");

    setup();
    carry_object(__DIR__"obj/hufacloth")->wear();
}
