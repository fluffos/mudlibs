//qinhaoran.c 玄武堂的堂主
#include <ansi.h>

inherit __DIR__ "xwnpc";

void crash(object ob);

void create() {
  set_name("秦浩然", ({ "qin haoran", "qin", "tangzhu" }));
  set("gender", "男性");
  set("age", 50 + random(10));
  set("rank_info/zhiye", YEL "玄武堂堂主" NOR);
  set("long", @LONG
站在你面前的，就是一品堂中权力最大的汉人了。据说他是无量弟子，
因为和师兄争掌门失败，一怒之下拂袖而去。要是还留在师门里，该
是左子穆的师叔辈了。也不知是真是假，不过他一身的无量功夫倒是
货真价实的。
LONG);

  set("str", 35); set("cor", 34); set("int", 33);
  set("per", 17); set("spi", 24); set("cps", 27);
  set("dex", 30); set("con", 30); set("kar", 13);

  set("force", 3500); set("max_force", 3500); set("force_factor", 0);

  set_wugong("dodge", 100);
  set_wugong("unarmed", 100);
  set_wugong("liuyun-jian", 120);
  set_wugong("yanxing", 140, 140, 1);
  set_wugong("nanshan-liushi", 120, 120, 1);
  set_wugong("haoran-zhengqi", 150, 150, 1);
  set_wugong("jue-jian", 100, 100, 1);
  set_xiuwei_by_type("dodge", 2300);
  set_xiuwei_by_type("unarmed", 2300);
  set_xiuwei_by_type("sword", 2500);
  set("combat_exp", 300000);
  set("social_exp", 500000);

  setup();

  carry_object(CLOTH_DIR "cloth5")->wear();
  carry_object(SWORD_DIR "changjian")->wield();
  JoinZuzhi("yipin", "护国都尉", "玄武堂");
}

int welcome_visitor(object me) {
  object npc = this_object(), yin, ling;

  foreach (object inv in deep_inventory(me)) {
    if ((inv->name() == YEL "玄武令" NOR) && inv->id("ling pai"))
      ling = inv;
  }

  if (ling) {
    message_vision("$N躬身一礼道：“" + me->name() + "参见堂主。”\n"
      "言罢，恭恭敬敬地将一枚$n双手奉上。\n", me, ling);
    call_out("crash", 1, ling);
    //        ling->move( VOID_OB );

    if (me->id(ling->query("持令人"))) {
      me->apply_condition("can_stay_in_xuanwu", 216);
      message_vision("\n" CYN, me);
      message_vision2("秦浩然接过令来，看了一眼，点点头道：“好。你在本堂可以逗留三"
        "天的时间。在这三天里，你可以随意使用本堂的一切东西，也可以向"
        "任何一位教习请教武功上的疑难。这里的每一位教习都有一身出类拔"
        "萃的功夫，是我们大夏费了不少心血才礼聘来的。三天虽不算长，但"
        "要是好好利用，已经够你学到不少东西了。”", npc);
      message_vision(NOR "\n", me);
      tell_object(me, CYN "秦浩然回头道：“阴总管。”\n\n" NOR);
      if (yin = present("yin wuji", environment(npc)))
        yin->welcome(me);
      else tell_object(me, CYN "秦浩然回过头来对你说：“阴总管不知为什么离开了一下，你回头找\n"
        "他领件号坎去。”\n" NOR);
    } else {
      message_vision("秦浩然接过令来，看了一眼，点点头道：“好……”\n", me);
      message_vision("这令你是从哪来的？？来人！！！n", me);
      me->move(__DIR__ "tingyuan1");
      me->set_temp_marks("lnwm/闯入玄武", 1);
      XUANWU_D->EnemyCome(environment(me));
    }
  }
  return 1;
}

int refuse_killing(object me) {
  set("force_factor", 100);
  set("env/attack", 90);
  return ::refuse_killing(me);
}

int accept_fight(object me) {
  if (me->IsMemberOf("yipin")) {
    say("秦浩然瞪了你一眼，沉声道：“本堂禁止私斗，别让我第二次听到这种话。”\n");
    return 0;
  } else {
    message_vision(CYN "$N看了$n一眼，脸色忽然大变：“咦？你是什么人？"
      "怎么闯上来的？”\n" NOR
      , this_object(), me);
    me->move(__DIR__ "tingyuan1");
    me->set_temp_marks("lnwm/闯入玄武", 1);
    XUANWU_D->EnemyCome(environment(me));
    return notify_fail("");
  }
}

int valid_teach(object me, string skill) {
  return 0;
}

void crash(object ob) {
  destruct(ob);
}
