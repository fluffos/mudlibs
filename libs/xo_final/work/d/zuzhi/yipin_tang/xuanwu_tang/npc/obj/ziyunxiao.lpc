// ziyunxiao.c 紫云箫

#include <weapon.h>
inherit SHORT;

void create() {
  set_name("紫云箫", ({ "ziyun xiao", "xiao" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "支");
    set("long", "一支晶莹通透的紫云箫。\n");
    set("value", 20);
    set("material", "iron");
    set("wield_msg", "$N从腰间抽出一支$n拿在手中。\n");
    set("unwield_msg", "$N将手中的$n插回腰间。\n");
  }
  init_short(20);
  setup();
}
