// haokan.c

#include <armor.h>

inherit SURCOAT;
inherit F_SAVE;
inherit F_AUTOLOAD;

void create()
{
    set_name("号坎", ({ "hao kan", "haokan" }) );
    set_weight(1000);
    if( clonep() )
        set_default_object(__FILE__);
    else {
        set("unit", "件");
        set("material", "cloth");
        set("value", 10);
        set("armor_prop/armor", 1);
    }
    setup();
}

int IsAutoLoad()
{
    object ob = environment( this_object() );

    if( query("equipped") && userp( ob ) 
       && ob->query_condition("can_stay_in_xuanwu") )
        return 1;
    else 
        return 0;
}

/*int query_autoload()
{
    return 1;
}*/

mapping GetItemInfo()
{
    return ([
        "owner" : query( "owner" ),
        "long"  : query( "long"  ),
        ]);
}

int SetItemInfo( mapping info )
{
    if ( mapp( info ) )
    {
        set( "owner",   info[ "owner" ] );
        set( "long", info[ "long" ] );
        return 1;
    }
    else if ( !info )
    {
        return 1;
    }
    else return 0;
}