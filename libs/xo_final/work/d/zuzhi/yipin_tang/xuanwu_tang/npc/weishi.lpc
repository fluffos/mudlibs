//weishi.c
//reedit by lnwm 98-09-06
//卫士是最普通的xwnpc。低级下属。

#include <ansi.h>

inherit __DIR__ "xwnpc";

int is_weishi() {
  return 1;
}

int welcome_visitor(object me) {
  object npc = this_object(), cloth, ling;
  int time_available;

  if (!userp(me)) return 0;
  foreach (object inv in deep_inventory(me)) {
    if ((inv->name() == YEL "玄武令" NOR) && inv->id("ling pai"))
      ling = inv;
    if ((inv->name() == "黑色号坎") && inv->id("hao kan"))
      cloth = inv;
  }

  if (!cloth && !ling
    || me->query_temp_marks("lnwm/闯入玄武")
    || me->query_condition("kill_xuanwu")) {
    message_vision(CYN "$N大喝一声：“什么人竟敢擅闯玄武堂，今天教你来得，去不得！”\n" NOR, npc);
    kill_ob(me);
    me->kill_ob(npc);
    me->set_temp_marks("lnwm/闯入玄武", 1);
    XUANWU_D->EnemyCome(environment(npc));
  } else if (ling) {
    message_vision("$N对$n躬身一礼：“堂主正在等着您呢。”\n", npc, me);
  } else if (time_available = me->query_condition("can_stay_in_xuanwu") > 2) {
    if (random(10) > 8)
      message_vision("$N见$n过来，抱拳行礼。\n", npc, me);
  } else {
    message_vision(GRN "$N对$n一拱手道：堂主命您火速下山。\n" NOR, npc, me);
  }
}

int query_ask_answer(object ppl, string arg) {
  object npc = this_object();

  if (random(2))
    message_vision("$N对$n一拱手：“在下正在奉令行事，请恕不便多言。”\n",
      npc, ppl);
  return 1;
}

int accept_fight(object me) {
  message_vision("$N看了$n一眼，道：“在下正在执行公务，恕不能奉陪。”\n",
    this_object(), me);
  return 0;
}

int accept_duilian(object me) {
  return 0;
}
