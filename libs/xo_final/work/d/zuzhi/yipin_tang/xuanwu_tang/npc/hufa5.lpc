// hufa4.c 一品堂之玄武堂的护法。

#include <ansi.h>

inherit __DIR__ "hufa";

void create() {
  set_name(HIW "王殄" NOR, ({ "wang tian", "wang", "hufa" }));
  set("gender", "男性");
  set("age", 60);
  set("long", "一个身着红稠锦衣的男子，四肢如柱，手拿长刀，正是一品堂的传功护法。\n");
  set("title", HIY "玄武堂护法" NOR);
  set("combat_exp", 1500000);
  set("social_exp", 30000);
  set_force(1700, 1700, 170);
  set_wugong("eyu-jianfa", 100, 100, 1);
  set_wugong("chusuifeng", 50, 50, 1);
  set_xiuwei("long", 1900);
  set_xiuwei("dodge", 1000);
  JoinZuzhi("yipin", "传功护法", "玄武堂");

  setup();
  carry_object(LONG_DIR "longdao")->wield();
  carry_object(__DIR__ "obj/hufacloth")->wear();
}
