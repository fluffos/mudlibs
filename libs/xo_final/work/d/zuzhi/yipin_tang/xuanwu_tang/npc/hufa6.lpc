// hufa6.c 一品堂之玄武堂的护法。

#include <ansi.h>

inherit __DIR__"hufa";

void create()
{
    set_name( HIW"关玲"NOR , ({ "guan ling", "guan", "hufa" }) );
    set("gender", "女性" );
    set("age", 39 );
    set("long", "一个身着红稠锦衣的女子，身形如水，面露秋波，正是一品堂的传功护法。\n");
    set("title",HIY"玄武堂护法"NOR);
    set("combat_exp", 1200000);
    set("social_exp", 20000);
    set_force(1700,1700,170);
    set_wugong("luoying-xiaofa",100,100,1);
    set_wugong("luofeng",50,50,1);
    set_xiuwei("short",1900);
    set_xiuwei("dodge",1500);
    JoinZuzhi("yipin","传功护法","玄武堂");

    setup();
    carry_object(__DIR__"obj/ziyunxiao")->wield();
    carry_object(__DIR__"obj/hufacloth")->wear();
}
