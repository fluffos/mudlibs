// tingyuan2.c

inherit ROOM;

void create()
{
    set("short", "庭院");
    set("long", @LONG
出大厅向东。眼前竟是极大的一处庭院，院内树木纷繁茂盛，被一圈矮矮的
山墙环绕。山墙外，远远看去，是一带远远的山脉，山峰尖锐耸立，高低错落。
    山墙的一脚有些塌陷，从缝隙中看过去，便知这山墙外已是悬崖，望崖下看
去，白云缭绕，深不见底。
LONG
    );
    set("exits", ([
        "west" : __DIR__"zhengting",
    ]));
    set("no_clean_up", 0);
    set("outdoors","xuanwu");
    setup();
}
