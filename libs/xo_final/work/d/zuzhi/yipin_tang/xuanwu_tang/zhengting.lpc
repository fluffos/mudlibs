// Room: /u/zodiac/xuanwu/zhengting.c

#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "玄武堂正厅");
  set("long", @LONG
玄武正厅是一品堂的高手们商议重大举措之地。正面墙上由顶及
地，绘着一只裹在黑云中的一只作势欲扑的白老虎。正当间，摆着一
张长条香案。两旁铺着绣花锦垫的磐龙靠背椅雁行排开。一品堂的高
手们有的是颇有城府的险诈人物，却也不乏脾气暴躁的莽汉。议事不
和时，不免拍桌打凳，弄得厅中的各个小几满是裂痕。两边的墙壁黑
黝黝的毫不起眼，其实确是纯钢铸成，里面还不知有什么古怪。
    正厅东面有座庭院。北面屏风后面有一扇门，通往内院。
LONG
  );
  set("exits", ([ /* sizeof() == 4 */
    "east": __DIR__ "tingyuan2",
    "south": __DIR__ "tingyuan1",
    "north": __DIR__ "neiyuan",
  ]));
  set("objects", ([
    __DIR__ "npc/qinhaoran": 1,
    __DIR__ "npc/yinwuji": 1,
  ]));

  set("no_clean_up", 0);

  setup();

}

int valid_leave(object me, string dir) {
  if (dir == "north") {
    string msg = "两个身着青衣的童子当住了$N的去路，恭身一礼道："
      "堂主正在休息。$R请回吧。";
    msg = replace_string(msg, "$R", RANK_D->query_respect(me));
    message_vision(CYN, me);
    message_vision2(msg, me);
    message_vision(NOR, me);
    return notify_fail("");
  }
  return ::valid_leave(me, dir);
}
