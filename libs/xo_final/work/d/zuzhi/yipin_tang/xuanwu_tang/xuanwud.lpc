// xuanwud.c XUANWU_D

#include "ansi.h"

inherit ITEM;

private string *RoomNames = allocate(30);
private object *RegisteredRooms = allocate(60);

void create() {
  int i;
  string *name_list = ({
    "ceting", "chufang", "fanting", "menfang", "neitang", "neiyuan_men", "shanlu",
    "shanpo", "tingyuan1", "tingyuan2", "tingyuan3", "tingyuan4", "weishifang1",
    "weishifang2", "wuchang1", "wuchang2", "wuchang3", "wuchang4", "xiaolu1",
    "xiaolu2", "xiuxishi1", "xiuxishi2", "xiuxishi3", "xuanya1", "xuanya3",
    "xuanya4", "yanwu_ting", "zhangfang", "zhengmen", "zhengting"
  });

  set_name("玄武堂控制台", ({ "xuanwud" }));
  set("long", "这里是玄武堂的总控台，对全堂的指令都是从这里发出来的。\n");
  setup();
  i = 0;
  foreach (string name in name_list) {
    RoomNames[i] = name;
    i = i + 1;
  }
}

string *query_RoomNames() {
  return RoomNames;
}

object *query_RegisteredRooms() {
  return RegisteredRooms;
}

void CheckReg(object *list) {
  foreach (object ob in list) {
    if (!objectp(ob))
      list -= ({ ob });
  }
}

int RegisterRoom(object ob) {
  CheckReg(RegisteredRooms);

  if (member_array(file_name(ob), RoomNames) != -1) {
    if (member_array(ob, RegisteredRooms) == -1)
      RegisteredRooms += ({ ob });
    return 1;
  } else return 0;
}


int warning() {}
