// shanjiao.c
// by lnwm

inherit ROOM;

void create()
{
	set("short", "贺兰山脚");
	set("long", @LONG
小路弯弯曲曲终于到了尽头，再往前就要爬山了。贺兰山高耸挺拔，山路崎
岖难行，很多地方则四处是陡峭的悬崖，无可着手，所以古来几乎少有人迹。不
过山脚下倒有些农户零零散散地分布在各地，原因是每当夏季，山上的积雪融化
后，也可灌溉山下的农田，所以虽然自然环境恶劣，也还有些祖辈就在这里居住
的村民。
LONG
	);
	set("exits", ([ 
  		"west" 		: __DIR__ "shancun",
 	 	"northup" 	: __DIR__ "shandao1",
		"southeast"	: __DIR__ "x_x1",
]));
	set("no_clean_up", 0);
	set("outdoors", "xuanwu");
	setup();
	replace_program(ROOM);
}
