// chuanyun-jian    穿云箭法

inherit SKILL;

mapping *action = ({
  ([ "action": "$N扳开$w，“铮”地一箭向$n的$l射去",
    "lian": "$N",
    "jibie": 2,
    "sen": 1,
    "damage_type": "割伤"
  ]),
  ([ "action": "$N身形陡然后退，",
    "lian": "$N",
    "jibie": 2,
    "sen": 1,
    "damage_type": "割伤"
  ]),
});

string *parry_msg = ({
  "$n不慌不忙，待$w直至身前，方将手中$v一格，只听得“当”的一声，$w直荡了开去。\n",
  "$n虚扳弓弦，只听“铮”的一声，$N还道$n射出一箭，急忙收回$w，舞了个风雨不透。\n",
  "$n蝎步旋身，同时将$v一带，弓弦直向$N的手腕抹去。\n",
});
string *unarmed_parry_msg = ({
});

int valid_learn(object me) {
  return 1;
}

int valid_lian(object me) {
  object ob;
  ob = me->query_temp("weapon");
  if (!ob || (string)ob->query("weapon_type") != "bow")
    return notify_fail("通过冥想来练箭法？这是不是太有创意了？\n");
  return valid_learn(me);
}

string query_xiuwei_type() { return "short"; }

string query_weapon_type() { return "bow"; }

int query_dengji() { return 1; }

mapping query_action(int jibie) {
  int i, size;

  size = sizeof(action);
  for (i = 0; i < sizeof(action); i++)
    if (action[i]["jibie"] > jibie) {
      size = i;
      break;
    }
  return action[random(size)];
}

string query_parry_msg(object weapon) {
  if (weapon)
    return parry_msg[random(sizeof(parry_msg))];
  else
    return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}

string query_zhaoshi(int jibie) {
  int i;
  for (i = 0; i < sizeof(action); i++) {
    if (action[i]["jibie"] >= jibie)
      return action[i]["zhaoshi"];
  }
  return "";
}

int query_youxiao_jibie() { return 20; }    //高攻低防

int query_parry_ratio() { return 3; }      //parry = (20/10)*(3/10)=0.6
