inherit ROOM;

void create() {
  set("short", "农家");
  set("long", @LONG
山区的农家。屋门低矮，屋内阴暗寒冷，窗户为抵御冬季的寒风，用泥封得
死死的，所以屋内不见阳光。墙上靠着一把锄头，已经因年头比较久，有几处破
损了，用布条捆着。屋内没有人，想是主人在田里耕作。
LONG
  );
  set("exits", ([
    "south": __DIR__ "shancun",
  ]));
  set("no_clean_up", 0);
  setup();
}
