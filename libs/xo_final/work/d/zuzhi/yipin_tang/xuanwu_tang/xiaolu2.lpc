// Room: /xuanwu/xiaolu2.c

inherit ROOM;

void create() {
  mapping d;

  set("short", "小路");
  set("long", @LONG
一条小路连着由西向东，将内院门和内堂连了起来。不知名的小
草张满了路边还开出几朵微黄的小花，平添了几分生趣。小路的青石
板上有一层薄冰，一旦不小心很容易摔倒。往南岔出一条山路，若隐
若现的向西南峰折去。
LONG
  );
  set("exits", ([ /* sizeof() == 3 */
    "west": __DIR__ "neiyuan_men",
    "east": __DIR__ "neitang",
    "southup": __DIR__ "shanlu",
  ]));
  set("outdoors", "xuanwu");
  set("no_clean_up", 0);

  setup();

  d = copy(load_object(__DIR__ "neiyuan_men")->query_doors()["east"]);
  d["id"] = ({ "west", "朱漆大门", "door" });
  d["other_side_dir"] = "east";
  create_door("west", d);
}
