#include <ansi.h>
inherit ROOM;

void create()
{
	set("short", "大门");
	set("long", @LONG
你沿碎石小道而来，折过一道弯。一座气派非凡的府第就呈现在你眼前。厚
重的青石台阶逐级而上，竟有三四十级。台阶尽头是两扇杉木大门。门用黄铜包
裹，外面镶满了巨大的铜钉。门楣两侧点缀着一对风铃，当强烈的西风吹过时，
就发出叮咚之声，令整座府第凭添几分肃穆。大门正上方有一座大匾，匾上横书
三个大字
                  ****************************
                  *   一      品      堂     *
                  ****************************
LONG
	);
	set("exits", ([ /* sizeof() == 1 */
		"west" : __DIR__ "xiaodao3",
		"east" : __DIR__"yongdao1",
	]));

    set("objects", ([
            __DIR__ "npc/huwei1" : 2,
            __DIR__ "npc/shoumen": 2,
        ]) );                    	
	set("outdoors","lnwm");

	setup();
}

int valid_leave( object me, string arg)
{
    if ( !userp( me ) && arg == "west" )
        return 0;
    if ( me->query_condition("kill_yipin") && arg == "west" 
            && present("shoumen weishi", environment(me)) )
    {
        return notify_fail(RED"守门卫士拦住了你的去路。 \n"NOR);
    }
    return 1;
}
