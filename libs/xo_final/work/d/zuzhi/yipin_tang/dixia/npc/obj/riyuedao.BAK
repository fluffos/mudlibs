
// by lnwm for yipin_tang
// 97-12-11

#include <weapon.h>
#include <armor.h>
#include <ansi.h>

inherit BLADE;
inherit F_SAVE;
inherit F_AUTOLOAD;

void create()
{
	set_name(RED"日"NOR + CYN"月"NOR + YEL"刀"NOR, ({"riyun dao"}) );
	set_weight(2000);
        set("long",CYN"背阔刃薄的宝刀，刀身极度弯曲，呈新月之状。\n" NOR);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "把");
		set("value",15000);
                set("cant_sell","这把刀形状奇异，本店不敢收购，实在抱歉。\n");
		set("material", "steel");
                set("armor_prop/armor",15);
	}
	init_blade( 45 + random(30));
	set("wield_msg", "$N「唰」的一声抽出一把明晃晃的$n握在手中。\n");
	set("unwield_msg", "$N将手中的$n插入腰间。\n");
	setup();
}

int query_autoload()
{
    if ( environment( this_object() )->query_condition("yipin_jiewuqi") )
	return 1;
	else 
	return 0;
}