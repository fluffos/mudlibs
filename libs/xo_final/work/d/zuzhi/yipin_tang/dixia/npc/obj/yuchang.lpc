#include <weapon.h>
#include <ansi.h>
#include <mudlib.h>
#include <command.h>
inherit SWORD;
inherit F_SAVE;
inherit F_AUTOLOAD;
void create() {
  set_name("鱼肠剑", ({ "yuchang jian", "jian", "yuchang" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("value", 40000);
    set("material", "steel");
  }
  init_sword(47);

  set("wield_msg", "$N将剑从剑鞘中抽出来,只见青光一闪,顿时寒气逼人！\n" NOR);
  set("unwield_msg", "$N将手中的$n插入腰间的剑鞘。\n");
  setup();
}
