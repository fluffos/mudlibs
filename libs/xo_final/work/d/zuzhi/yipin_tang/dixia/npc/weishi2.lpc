//weishi2.c.白衣卫士
//date:1997.9.8
//by dan  

#include <ansi.h>
#include "refuse_kill.h"

inherit NPC;    

void create()
{
    set_name(RED"白衣卫士"NOR, ({ "wei shi"}));
    set("title",YEL"一品堂"NOR);
    set("age", 22);
    set("gender", "男性");
    set("str",40);
    set("per", 25);   
    set_wugong("wuliang-jian",100,100,1);
    set_xiuwei_by_type("sword",400);
    set_xiuwei_by_type("dodge",600);
    set_wugong("ny-bufa",100,100,1);
    set("max_force",800);
    set("force",800);
    set("combat_exp", 10000);
    set("force_factor",20);
    JoinZuzhi("yipin","杀手","玄阳堂");
    set("chat_chance",5);
    set("chat_chance_combat", 10);
    set("chat_msg_combat", ({
        "白衣卫士喝道：来啊！大家一起上,快把这个奸细拿下！\n",
    }));
    setup(); 
    carry_object(__DIR__"obj/cloth2")->wear();
    carry_object(__DIR__"obj/jian1") ->wield();  
} 

void init()
{
    object ob, me;
    ob = this_object();
    me = this_player();
    
    if ( ob->can_act() 
        && !me->query_condition("kill_yipin")
        && !ob->is_fighting() 
        && (me->IsBossOf( this_object(), "yipin"  ) ) )
    {
        remove_call_out("greeting");
        call_out("greeting", 1, me);
    }
    if (ob->can_act() 
        && me->query_condition("kill_yipin") )
    {
        remove_call_out("kill_him");
        call_out("kill_him", 1, me);
        return;
    }    
    if (me->IsMemberOf( "yipin" ) ) return;   
    if ((me->query("id"))=="wei shi") return;
    remove_call_out("kill_him");
    call_out("kill_him", 1, me);
}

void greeting(object me)
{
    if( interactive(me) && environment() == environment(me))
    {
        message_vision(GRN"$N对$n拱手施礼：“卑职见过大人！”\n"NOR,
                        this_object(), me);
    }
}    

void kill_him(object me)
{
    message_vision( "$N对着$n大喝一声：往哪跑？？“！！！” \n",
 this_object(), me );
    kill_ob(me);
    me->fight_ob(this_object());
}
