#include <weapon.h>
#include <ansi.h>
#include <mudlib.h>
#include <command.h>

inherit SWORD;
inherit F_SAVE;
inherit F_AUTOLOAD;

void create()
{
	set_name( CYN"乾"NOR + YEL"坤"NOR + GRN"剑"NOR, ({ "qiankun jian" }) );
	set_weight(1000);
	set("long",RED"一柄形状怪异的剑，剑身象蛇身一样弯弯曲曲，青色的剑身隐隐有雪光透出。\n"NOR);		
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "柄");
		set("value",15000);
                set("cant_sell","这柄剑形状奇异，本店不敢收购，实在抱歉。\n");
		set("material", "steel");
                set("armor_prop/armor",15);
	}
	init_sword( 40 + random(20));

	set("wield_msg","$N将剑从剑鞘中抽出来,只见青光一闪,顿时寒气逼人！\n" NOR);
	set("unwield_msg", "$N将手中的$n插入腰间的剑鞘。\n");  
    setup();
}

int query_autoload()
{
    if ( environment( this_object() )->query_condition("yipin_jiewuqi") )
	return 1;
	else 
	return 0;
}