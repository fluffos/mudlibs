//密道模型之五--翻板

#include <ansi.h>
inherit ROOM;

void init()
{
    	object ob, me;
    	ob = this_object();
    	me = this_player();
          
    	if (me->IsMemberOf("yipin")) return;   
    	if ((ob->query("id"))=="wei shi") return;  
    	if ((me->query("combat_exp")>30000)) 
     	{
      		if( random(5) < 2 )
                message_vision(RED"$N只觉得脚下一空，身体失去平衡，$N急忙向前一跃。\n"NOR, me);
      		return;
     	}
    	if( random(10) > 5 ) 
     	{
      		if( random(5) < 2 )
                message_vision(RED"$N只觉得脚下一空，身体失去平衡，$N急忙向前一跃。\n"NOR, me);
      		return;
     	}          
    	remove_call_out("fan_him");
    	call_out("fan_him", 0, me);
}

void fan_him(object me)
{
       	if((int)(me->query("kee")) < (int)(me->query("eff_kee")/2))
	{
		me->die();
		return;
	}
  	message_vision(RED"$N只觉得脚下一空，身体失去平衡，重重的摔在地下。\n"NOR, me);
	me->receive_damage("sen" ,(int)( me->query("sen")/2 ));
	me->receive_damage("kee" ,(int)( me->query("kee")/2 ));
	me->receive_damage("gin" ,(int)( me->query("gin")/2 ));
	return;
}

