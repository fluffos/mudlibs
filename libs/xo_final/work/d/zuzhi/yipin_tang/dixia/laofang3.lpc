// modified by lnwm 97-12-11

#include <ansi.h>
inherit ROOM;

int come_other(object me);

void create() {
  set("short", "牢房");
  set("long", @LONG
这里是一品堂总舵关押人犯的牢房。屋子里阴气森森，让你觉得很不自在。
四面的墙壁上挂满了各式各样的刑具－－有老虎钳、麻袋、皮鞭···，刑具看
起来都作暗红色，不知道上面沾染了多少人血。地面上血迹斑斑，都已经看不出
原来的本色了。空气中弥漫着一股令人做呕的血腥的气息，耳边不时传来受刑的
人犯的惨叫“啊～～～啊～～～”，在寂静的地下传出老远，你不由得心惊肉跳
，只想逃离这里。你发现牢房顶上有一扇天窗，似乎很容易就能砸(za)碎。
LONG
  );

  set("objects", ([
    __DIR__ "npc/yuzu": 1,
  ]));
  setup();
}

void init() {
  object me, ob;
  me = this_player();
  ob = this_object();
  add_action("do_za", "za");
  me->apply_condition("yipin_laofang", 60);  //关半个小时好了。
  return;
}


int do_za(string arg) {
  object me, ob, yuzu;
  me = this_player();
  ob = this_object();

  if (!arg || (arg != "窗" && arg != "天窗" && arg != "window"))
    return notify_fail("你要砸什么？\n");

  if (!me->can_act())
    return notify_fail("你现在不能砸东西！\n");

  if (yuzu = present("yu zu", environment(me))) {
    message_vision("狱卒暴喝一声，你想做什么？\n", me);
    yuzu->kill_ob(me);
    message_vision(YEL "狱卒高声喊着，快来人呀！犯人要逃跑！！\n", me);
    call_out("come_other", 30, me);
    return 1;
  }
  if (query_temp_marks("window") == 1)
    return notify_fail("天窗已经被砸开了，你还想干什么？\n");

  if (me->query("force") < 300)
    return notify_fail("你的内力不够，好象砸不开那里。\n");

  tell_object(me, "你奋起全力，对准天窗一砸，终于将它砸开了！\n");
  set_temp_marks("window", 1);
  ob->set("exits/up", __DIR__ "xuanya");
  me->add("force", -300);
  remove_call_out("del");
  call_out("del", 10, ob);
  return 1;
}

void del(object ob) {
  ob->delete("exits/up");
  set_temp_marks("window", 0);
  return;
}

int come_other(object me) {
  object yuzu;

  if (yuzu = present("yu zu", environment(me))) {
    message_vision(RED "\n只见外面突然冲进来几个狱卒，一顿乱棒将$N打翻在地。\n" NOR, me);
    yuzu->remove_killer(me);
    me->unconcious();
    return 1;
  } else {
    return 1;
  }

}

int valid_leave(object me, string dir) {
  mapping exits = this_object()->query("exits");

  if (!mapp(exits) || undefinedp(exits["up"])) {
    return 0;
  }

  if (dir != "up") {
    return 0;
  }

  me->clear_condition("yipin_laofang");
  return 1;
}
