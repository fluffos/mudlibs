// /d/menpai/yipin_tang/dixia/xuancai_tang_rukou.c 玄才堂的地下入口
// By lala Sept. 6, 1997

#include <ansi.h>
inherit  ROOM;

void create()
{
    set( "short", GRN"石穴"NOR );
    set( "long", @LONG
到了这里，路忽然没有了。洞穴的尽头是冷漠的石壁，上面悬着一盏跳动着
绿莹莹的火苗的油灯，把本来就狰狞的石壁照得仿佛妖魔的脸孔一般。处在这个
石穴内的人的脸也被镀上了一层奇怪的绿色。那一阵阵吹来的带着异香的阴风在
这里也无影无踪了。只有死一样的寂静。虽然没有风，然而那盏油灯却在摇曳不
定，仿佛是有人拉过它一样。
LONG );
    set( "exits", ([
        "southwest" : __DIR__"midao1",
        ]) );
    setup();
}                

void init()
{
    add_action( "do_la",({ "la","拉","pull" }) );
    add_action( "do_fang", "fang" );
}

int do_la( string arg )
{
    object next_here, me = this_player();
    
    if( !arg || 
    ( arg != "you deng" && arg != "lamp" && arg != "灯" &&arg != "youdeng" && arg != "油灯" ) )  
    return notify_fail("你要拉什么？\n");
    message_vision( "$N伸出手去，小心地拉了一下头上的油灯。\n", me );
    if( query_temp( "marks/cant_la_now" ) )
    {
        message("vision", "然而却拉不动。\n", this_object() );
        return 1;
    }                
    remove_call_out( "check_me" );
    call_out( "check_me", 1, me );
    return 1;
}    

void check_me( object me )
{
    object guard, ob, next_here, here = this_object();
    
    if ( !ob = find_object( __DIR__"groom2" ) )
        ob = load_object( __DIR__"groom2" );
    if ( !next_here = find_object( __DIR__"shenf2" ) )
        next_here = load_object( __DIR__"shenf2" );        

//卫士房里面的反应
    message( "vision", "\n突然墙上的一个小银铃响了起来。\n\n", ob );
    if ( !guard = present( "wei shi", ob ) )
        return; //没有人就不去开门了 
    if ( !guard->can_act() )
        return;        
    message_vision( CYN"$N说道：有人来了，我去开门。\n\n"NOR, guard );        
    message( "vision", "一位中年壮汉往东快步离开。\n", ob );        
    set_temp( "marks/cant_la_now", 1 );
    remove_call_out( "check_me" );
    guard->move( next_here );

//验证处的反应
    message( "vision", "一位中年壮汉走了过来。\n", next_here );
    message_vision( @LONG
    
$N在墙上什么地方一按，墙上就打开了一扇小窗，他从窗口向外望去。
他看了看，对外面说道：“你的令牌？”并向外递出一个小小铜盘去。

LONG, guard );

//好了，又回到这里了。现在是入口的反应
    message_vision( @LONG
忽然，尽头的石壁上开了一扇小小的窗，一个人向外望了望，对$N说道：
“你的令牌？”并伸出一个小小的铜盘，意思是让$N把令牌放(fang)在盘中。
LONG, me );
    me->set_temp( "pending/一品/can_fang", 1 );
//这里加个东西：如果那个人不放呢？过一会就不理他了吧
    remove_call_out( "check_fang" );
    call_out( "check_fang", 10, me, here, next_here, ob, guard );    
}

int do_fang( string arg )
{
    object guard, ob, obj, next_here, me = this_player();
    if( !arg ||
    ( arg != "令牌" && arg != "lingpai" && arg != "ling pai" ) )
        return 0;   //如果没有说放什么
    if( !me->query_temp( "pending/一品/can_fang" ) )
        return 0;   //如果不是该放的人     
    if( !obj = present( "ling pai", me ) )
        return 0;   //如果我没有令牌
    remove_call_out( "check_fang" );
    if ( !next_here = find_object( __DIR__"shenf2" ) )
        next_here = load_object( __DIR__"shenf2" );        
    if( !guard = present( "wei shi", next_here ) )
    {
        message( "vision", "那个在窗口的人突然抽回盘子，也不拿令牌，就砰地关上窗子。\n", 
            this_object() );
        delete_temp( "marks/cant_la_now" );            
        return 1;
    }   //如果那个人突然被人作了，就不要令牌了。
    message_vision( "$N掏出一块令牌放在盘子里面，那个人把盘子拿回去，砰地关上窗子。\n",
            me );
    me->delete_temp( "pending/一品/can_fang" );            
    obj->move( guard );
    if( obj->query( "name" )==BLU"玄才令"NOR )
    {
        message_vision( "“吱嘎嘎”一阵响，石壁上开了一道门，\n" +
            "把$N放了进去，然后又咣的一声关上了。\n", me );
    
        //现在是里面的反应
        message_vision( @LONG
$N从窗子外收回盘子，里面放着一块令牌。
他拿一些奇怪的东西在令牌上一划，点了点头。
$N扳动机关，“吱嘎嘎”一阵响，石壁上开了一道门，
一个人走了进来，然后门又咣的一声关上了。
LONG, guard );
    me->move( next_here ); //好了，终于进去了。
    message( "vision", "一位中年壮汉往西快步离开。\n", next_here );        
    if ( !ob = find_object( __DIR__"groom2" ) )
        ob = load_object( __DIR__"groom2" );
    guard->move( ob );
    message( "vision", "一位中年壮汉走了过来。\n", ob );
    message_vision( CYN"$N说道：一切正常，平安无事。\n"NOR, guard );
    delete_temp( "marks/cant_la_now" );
    return 1;
    }   //这就进来了
        
    //下面就是如果不对的处理
    message_vision( @LONG
$N从窗子外收回盘子，里面放着一块令牌。
他拿一些奇怪的东西在令牌上一划，微微一怔，然后嘿嘿冷笑起来。
$N扳动机关，“吱嘎嘎”一阵响，不知道什么地方的机关被打开了。
LONG, guard );
    message( "vision", "一位中年壮汉往西快步离开。\n", next_here );        
    if ( !ob = find_object( __DIR__"groom2" ) )
        ob = load_object( __DIR__"groom2" );
    guard->move( ob );
    message( "vision", "一位中年壮汉走了过来。\n", ob );
    message_vision( CYN"$N说道：嘿嘿，居然有人想蒙混过关。我放蛇咬了他一下。\n"NOR,
        guard );
    message_vision( BLU@LONG
突然从头顶上方传来一阵冷笑声：

好大胆子，敢用假令混进玄才堂？！

一条小蛇，突然从油灯里面出现，闪电般地一纵，在$N身上咬了一口就不见了。

LONG NOR, me );
    me->apply_condition( "snake_poison", 8  );
    // 100太过分了！，持续两个小时？！改成8
    delete_temp( "marks/cant_la_now" );
    return 1;
}        

void check_fang( object me, object here, object next_here, object ob, object guard )                
{
    if( present( "wei shi", next_here ) )
    {
        message( "vision", @LONG
        
那个人等了这么长时间，见没有什么动静，不免
有些发怒：“怎么回事？没有令牌来干什么？怎
么磨磨蹭蹭的！”说完砰地关上窗。                          
        
LONG, here );
        message_vision( @LONG
        
$N等了这么长时间，见没有什么动静，不免
有些发怒：“怎么回事？没有令牌来干什么？怎
么磨磨蹭蹭的！”说完砰地关上窗，一边转过身
来一边口中骂骂咧咧。                          
        
LONG, guard );
        message( "vision", "一位中年壮汉向西离开。\n", next_here );
        guard->move( ob );
        message( "vision", "一位中年壮汉走了过来。\n", ob );
        message_vision( CYN"$N说道：什么狗东西！在外面捣乱，可能是想混进来吧！\n"NOR, 
            guard );
        me->delete_temp( "pending/一品/can_fang" );
        delete_temp( "marks/cant_la_now" );
    }
}                            
        
                    
