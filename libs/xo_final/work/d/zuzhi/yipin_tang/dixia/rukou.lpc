// /d/menpai/yipin_tang/dixia/rukou.c 地下入口
// By lala Sept. 6, 1997
// BY lnwm for out 97-09-15

#include <ansi.h>
inherit ROOM;

void create() {
  set("short", BLU "石穴" NOR);
  set("long", @LONG
随着顶上的铁盖轰隆一声盖回原来的地方，你感觉到陷入了一片无边的黑暗
之中：你无法看到什么东西，只听到铁门关闭的声音远远的传开去，然而你等了
良久却始终没有听到回音。过了一会，你的眼睛已经逐渐适应了这里的环境，你
才发现这里并不是没有任何照明的。在你头的侧上方的石壁上有两盏暗蓝色的火
苗在幽幽的燃着。它们使你能稍稍看见你附近的东西，同时又把洞顶嶙峋的石块
投成巨大而奇异的黑影，仿佛狰狞的怪兽笼罩在洞穴的深处。
LONG);
  set("exits", ([
    "north": __DIR__ "midao_n",
    "south": __DIR__ "midao_s",
  ]));
  setup();
}

void init() {
  add_action("do_open", ({ "tui", "推", "push" }));
}

int do_open(string arg) {
  object me;

  me = this_player();

  if (!arg || arg == "") {
    tell_object(me, "你要推什么？\n");
    return 1;
  }
  if (arg == "铁盖" || arg == "tiegai" || arg == "up") {
    message_vision("$N用手向上推了推铁盖，只停一阵机关响动，一缕光线从上面照射下来。\n", me);
    if (!query("exits/up")) {
      set("exits/up", "/d/zuzhi/yipin_tang/lingyige");
      call_out("close_up", 3);
    }
    return 1;
  } else {
    tell_object(me, "你不可以推" + arg + "。\n");
    return 1;
  }
}

void close_up() {
  if (!query("exits/up")) return;
  message("vision", "一阵沉闷的机关响动，石穴重又陷入一片黑暗之中。\n", this_object());
  delete("exits/up");
}
