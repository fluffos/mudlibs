// yanxishi.c
// 在一品堂内学习希奇古怪的工夫的地方。比如易容术。
// by lnwm 97-12-11

#include <ansi.h>
#include <skill.h>

inherit ROOM;

void create()
{
	set("short", "研习室");
	set("long", @LONG
这里是玄才堂的研习室。一品堂弟子阅读了本堂的情报或秘籍时，可以在这里
将所学到的东西研习(yanxi)巩固。
    屋中的陈设也十分简单，只有几张普通的桌椅，旁侧的架子上拜放了一些希奇
古怪的器具，也不知是做什么用的。东侧的一张桌子上摆放了一些瓶瓶罐罐，引人
注目的是旁边的几张胶质面具和靠桌的一面巨大的铜镜，显见是为一品堂弟子练习
易容术所准备的。
LONG
	);

	set("exits", ([ /* sizeof() == 1 */
            "south" : __DIR__"qingbao",
]));      
	setup();
}

void init()
{
	add_action("do_yanxi","yanxi");
}

int do_yanxi( string arg )
{
	string skill;
	object me;
    
	int my_jibie, gin_cost;
    int my_lingwu;
    int gain_jibie;
        
	skill = "yirong-shu";
	me = this_player();
	gin_cost = 10;

    if ( me->is_busy() )
        return notify_fail("你现在无法静下心钻研。\n");

    if ( !arg ) 
        return notify_fail( "你想研习什么工夫？\n" );

    if ( arg != "yirong-shu" && arg != "易容术" )
    {
		return notify_fail("你不能研习这个。\n");
    }

	if ( me->is_fighting() || me->is_duilianing() )
		return notify_fail("战斗时不能研习。\n");

    if ( !me->can_act() )
        return notify_fail("你现在无法研习！\n");

    my_jibie = me->query_jibie(skill);
    my_lingwu = me->query_lingwu(skill);

    if ( !my_jibie )
	{
		if ( (int)me->query("gin") > gin_cost )
	    {
            tell_object( me, YEL"你摆弄着桌上的器具练习易容之术，似乎有些心得。\n"NOR );
			me->improve_jibie( skill, 1 );
        	me->receive_damage( "gin", gin_cost );
			return 1;
		}
	}
	if ( me->query_lingwu_ratio( skill ) < 100 )
    {    
	    me->receive_damage( "gin", gin_cost );   
	    return notify_fail( "你对易容术的理论还缺乏进一步的认识。\n" );
	}

    gain_jibie = 1;
	gin_cost = 20;

	if ( my_jibie > 50 )
		return notify_fail("你靠自己研习已经不能再掌握更深入的易容术了。\n");

    if ( !my_jibie || me->query_lingwu_ratio( skill ) >= 90 )
    {
	    if ( (int)me->query("gin") > gin_cost )
	    {
            tell_object( me, YEL"你摆弄着桌上的器具练习易容之术，似乎有些心得。\n"NOR );
			me->improve_jibie( skill, gain_jibie );
        }
		else
		{
		    gin_cost = me->query( "gin" ) - 1;
		    tell_object( me, "你实在是太疲惫了，什么也没学到。\n");
    	}
 		me->receive_damage( "gin", gin_cost );
        return 1;
    }
	return 1;
}
