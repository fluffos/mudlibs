//密道模型之三--暗器
                
#include <ansi.h>
inherit ROOM;

void init()
{
	object ob, me;
	me = this_player();
	ob = this_object();

	if( me->IsMemberOf("yipin") != 1 && query("combat_exp") < 100000)
	{
		if( random(5) < 2 )
		{                                                 
        		message_vision(RED"$N只听见“嚓～嚓～”的机关开动的声音，密道四壁上裂开了无数小口，“唰～唰～唰～”\n"
		                       "从中射出了一蓬蓬暗器和羽箭，来得又急又多，让$N无处藏身。\n"NOR, me);
            		message_vision(RED"$N身中数箭，浑身浴血，看来是不行了！！！\n"NOR, me);
			remove_call_out("jian");
			call_out("jian", 0, me);
		        return;
	        }
		else
		{   
                if( random(5) < 2 )
	        message_vision(RED"$N感觉有一种说不出的担心充满的了整个心头，只想赶快离开这里。\n"NOR, me);
	    	return;                             	
		}
	}
}	    	                                

void jian(object me)
{                
	if((int)(me->query("kee")) < (int)(me->query("eff_kee")/2))
	{
		me->die();
		return;
	}
	me->receive_damage("sen" ,(int)(me->query("sen"))-(int)(me->query("sen")/3));
	me->receive_damage("kee" ,(int)(me->query("kee"))-(int)(me->query("kee")/3));
	me->receive_damage("gin" ,(int)(me->query("gin"))-(int)(me->query("gin")/3));
	return;
}