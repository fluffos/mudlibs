//midao_1.c.黑衣卫士

#include <ansi.h>
inherit ROOM;

void init() {
  int i;
  object ob, me, npc;
  ob = this_object();
  me = this_player();

  if (me->IsMemberOf("yipin")) return;
  if ((ob->query("id")) == "wei shi") return;
  if ((me->query("combat_exp") > 30000)) return;
  if (random(10) > 5) return;
  if (objectp(present("wei shi", environment(me)))) return;
  message_vision(RED "突然警铃大作，一群一品堂卫士出现$N在四周.\n" NOR, me);
  for (i = 1 + random(4); i >= 0; i--) {
    npc = new(__DIR__ "npc/weishi1");
    npc->move(ob);
  }
  return;
}
