//密道模型之四--翻板

#include <ansi.h>
inherit ROOM;

void init() {
  object me, ob;
  me = this_player();
  ob = this_object();

  if (me->IsMemberOf("yipin") != 1 && me->query("combat_exp") < 100000) {
    if (random(5) < 3) {
      message_vision(RED "$N只觉脚下一松，身子一沉，还来不及张嘴叫唤，就看见\n"
        "地下裂开了一个大口子，将$N吞了下去。\n" NOR, me);
      me->move(__DIR__ "laofang3");
      return;
    }

    else {
      if (random(5) < 2)
        message_vision(HIY "$N感觉有一种说不出的担心充满的了整个心头，只想赶快离开这里。\n" NOR, me);
      return;
    }
  }
}
