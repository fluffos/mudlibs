// /d/menpai/yipin_tang/dixia/midao_s.c 通向南方的密道
// By lala Sept. 6, 1997

#include <ansi.h>
inherit  ROOM;

string *all_exits = ({
"north",     "south",     "east",      "west", 
"northeast", "northwest", "southeast", "southwest",
"northup",   "southup",   "eastup",    "westup", 
"northdown", "southdown", "westdown",  "eastdown",
"enter", "out",
    });

    
    
void create()
{
    string exit1 = all_exits[random(sizeof(all_exits))];
    string exit2 = exit1;
    string exit3 = exit1;
    
    while( exit2 == exit1 )
        exit2 = all_exits[random(sizeof(all_exits))];
    while( exit3 == exit1 || exit3 == exit2)
        exit3 = all_exits[random(sizeof(all_exits))];
        
    set( "short", BLU"密道"NOR );
    set( "long", @LONG
一条石洞中的密道。在密道的石壁上同样有两团蓝火在跳跃，而密道的深处同样
也笼罩在一团不可知的如憧憧鬼影之中。周围静谧异常，除了偶尔远远传来一声关闭
铁门的声音外，就只剩下你的足音、心跳声和略显急促的呼吸声。时而吹来一小阵阴
凉的风，带来一种淡淡而诡异的香气。
LONG );
    set( "exits", ([
        exit1 : __DIR__"midao2",
        exit2 : __DIR__"rukou",
        exit3 : __FILE__,
        ]) );
    set( "item_desc", ([
        exit1 : "从这里望去，洞穴的深处隐藏在诡异的黑暗之中。\n",
        exit2 : "从这里望去，洞穴的深处隐藏在诡异的黑暗之中。\n",
        exit3 : "从这里望去，洞穴的深处隐藏在诡异的黑暗之中。\n",
        ]) );
    setup();
}                

int valid_leave( object me, string dir )
{
    string exit1, exit2, exit3;
    object there;

    there = query( "exits/" + dir );
    
    if ( !there )
        return notify_fail("这个方向没有出路。\n");

    delete( "exits" );

    exit1 = all_exits[random(sizeof(all_exits))];
    exit2 = exit1;
    exit3 = exit1;
    
    while( exit2 == exit1 )
        exit2 = all_exits[random(sizeof(all_exits))];
    while( exit3 == exit1 || exit3 == exit2)
        exit3 = all_exits[random(sizeof(all_exits))];
    
    set( "exits/" + exit1, __DIR__"midao2" );
    set( "exits/" + exit2, __DIR__"rukou"   );
    set( "exits/" + exit3, __FILE__ );            

    set( "item_desc", ([
        exit1 : "从这里望去，洞穴的深处隐藏在诡异的黑暗之中。\n",
        exit2 : "从这里望去，洞穴的深处隐藏在诡异的黑暗之中。\n",
        exit3 : "从这里望去，洞穴的深处隐藏在诡异的黑暗之中。\n",
        ]) );

    me->move( there );
    
    return notify_fail("");
}
   
