
// 地下牢房的入口
// By lnwm 98/03/27

#include <ansi.h>
inherit  ROOM;


void crash( object ob);

void create()
{
    set( "short", GRN"牢房入口"NOR );
    set( "long", @LONG
黑暗的地下通道。冰冷的石壁在昏暗摇曳的油灯下投射出模糊而黑暗的影子。
前面有扇厚重的石门，门上一条粗大的铁链将门闩绑死，上面还挂着一把巨大的铜
锁。只在门的上方开了一个小小的窗口。
    你隐隐能听到门内传出铁链与地摩擦发出的声响，还有人压抑的粗重的呼吸和
呻吟声。
LONG );
    set( "exits", ([
        "northwest" : __DIR__"midao2",
        ]) );
    setup();
}                

void welcome_visitor( object me )
{
    object *inv;
    int i;

    inv = all_inventory(me);

    for ( i = 0; i < sizeof(inv); i++ )
    {
        if ( inv[i]->query("name") == "牢房腰牌" )
        {
            call_out("crash",1,inv[i] );
        }
        if ( inv[i]->is_character() && (!userp(inv[i])) 
             && inv[i]->query("name") == me->query("yipin_task/obname")
             && me->query("yipin_task/keyname") == "活捉")             
        {
            message_vision("门卫见$P身上背着一个人进来，点点头：送到里面去吧。", me );            
            this_object()->set("exits/southeast", __DIR__"shenf4");
            me->delete("lnwm/yipin/牢房");
            call_out("close",5,this_object() );
        }
    }
}

void close( object ob )
{
    if( ob->query("exits/southeast") )
        ob->delete("exits/southeast");
}

void crash( object ob )
{
    destruct( ob );
}