inherit SKILL;

mapping *action = ({
  ([ "action": "$N剑身平指，一招「顺流直下」，手中$w挽了一个剑花，如长江三
                 峡中一叶扁舟，以万均之势刺向$n胸口",
    "lian": "$N手中$w平平刺出，虽说毫无花哨，却如离弦之箭，挟有万均之势，
                 这正是一招「顺流直下」。",
    "sen": 3,
    "jibie": 5,
    "dodge": 10,
    "parry": 10,
    "wound": 10,
    "zhaoshi": "「顺流直下」",
    "damage_type": "刺伤" ]),
  ([ "action": "正在$n手忙脚乱之际，$N又一招「白虹贯日」，$w剑尖直指苍天，向
                  $n遥遥发出一道剑气",
    "lian": "$N使出一招「白虹贯日」，手中$w化为无坚不摧的一道剑气。",
    "sen": 3,
    "jibie": 10,
    "dodge": 15,
    "parry": 5,
    "wound": 15,
    "zhaoshi": "「白虹贯日」",
    "damage_type": "刺伤" ]),
  ([ "action": "$N身形一侧，使出一招「云横西岭」，手中$w缓缓移动，就见漫天剑
                 气袭向$n，宛如在$n四周布下了一道铜墙铁壁",
    "lian": "$N手中$w一晃，使出一招「云横西岭」，只见剑影如虹，将$N团团包
                  围在其中。",
    "sen": 2,
    "jibie": 18,
    "dodge": 20,
    "parry": 0,
    "wound": 20,
    "zhaoshi": "「云横西岭」",
    "damage_type": "割伤" ]),
  ([ "action": "$N气凝丹田，脚踩阴阳，左手手捏剑诀，一招「飞沙走石」手中$w
                  灌注了十成内力缓缓刺出，顿时地上的砂石落叶随着$N走动之势象
                  受到了什么命令似的开始围绕照$n缓缓转动起来。",
    "lian": "$N脚踩阴阳，手捏剑诀，一招「飞沙走石」手中$w缓缓刺出。",
    "sen": 2,
    "jibie": 25,
    "dodge": 0,
    "parry": 15,
    "wound": 22,
    "zhaoshi": "「飞沙走石」",
    "damage_type": "刺伤" ]),
  ([ "action": "$N不退反进，袍袖一拂，口中一声长啸，手中$w以剑作刀，使出一
                   招「喝马奔泉」，直上直下的朝$n劈了下来。",
    "lian": "$N双手直握，手中$w化作一道长虹，宛如天兵天将，利劈华山，这
                   确正是一招「喝马奔泉」。",
    "sen": 5,
    "jibie": 80,
    "dodge": 10,
    "parry": 20,
    "wound": 30,
    "zhaoshi": "「喝马奔泉」
        " damage_type " : " 割 伤 "  ]),    
});

string *parry_msg = ({
    " $n 往 后 一 纵 ， 在 半 空 中 身 形 一 折 ， 使 出 一 招 「 白 虹 贯 日 」 ， 手 中 的 $v 化 作 一 条 长 虹 ，
    磕 开 了 $N 的 $w 。 \ n ",
    " $n 使 出 一 招 「 云 横 西 岭 」 ， 手 中 的 $v 化 做 一 道 铜 墙 铁 壁 ， 使 得 $N 的 攻 势 不 攻 自 破 。 \ n ",
    " $n 将 手 中 的 $v 一 晃 ， 一 招 「 飞 沙 走 石 」 ， 宛 如 黑 云 压 城 ， $N 顿 觉 无 从 下 手 ， 无 奈 只
    得 收 招 自 保 。 \ n ",
    " $n 顺 势 一 招 「 顺 流 直 下 」 ， 整 个 人 随 剑 走 ， 凌 空 划 出 一 道 长 虹 ， $v 不 仅 荡 开 了 $N 的
    $w ， 而 且 剑 尖 还 直 指 $N 的 胸 前 。 \ n ",
});

int valid_learn(object me)
{
    if ( (int)me->query(" dodge ") < 40 )
        return notify_fail(" 你 的 身 法 不 够 ， 没 有 办 法 练 双 清 剑 法 。 \ n ");

    if ( (string)me->query(" using_force ") != " " )
        return notify_fail(" 无 量 剑 法 必 须 配 合 才 能 练 。 \ n ");

    return 1;
}

int valid_lian( object me )
{
    object ob;
    ob = me->query_temp(" weapon ");
    if ( !ob || (string)ob->query(" weapon_type ") != " sword " )
        return notify_fail(" 你 必 须 先 找 一 把 剑 才 能 练 习 剑 法 。 \ n ");

    return valid_learn( me );
}

string query_xiuwei_type() { return " sword "; }   
string query_weapon_type() { return " sword "; }

int query_dengji() { return 2; }

mapping query_action(int jibie)
{
	int i, size;

	size = sizeof( action );
	for ( i = 0; i < sizeof( action ); i++ )
		if ( action[ i ][ " jibie " ] > jibie )
		{
			size = i;
			break;
		}
    return action[ random( size ) ];
}

string query_parry_msg(object weapon)
{   
    if ( weapon )
        return parry_msg[random(sizeof(parry_msg))];
}

string query_zhaoshi( int jibie )
{
    int i;
    for ( i = 0; i < sizeof(action); i++ )
    {
        if ( action[ i ][ " jibie " ] >= jibie )
            return action[ i ][ " zhaoshi " ];
    }
    return " ";
}

int query_youxiao_jibie() { return 10; }

int query_parry_ratio() { return 8 ; }
