#include <room.h>
#include <ansi.h>
#include "bianjing.h"

inherit BROOM;
void create()
{
    set("short",CYN "东廊" NOR);
    set("long",@LONG

相国寺的两侧翼廊环绕着广场一般宏大的圣容殿前大院。这里是每月八次的
大相国寺瓦市的举办地，动辄吸引数万人前来，凡商旅交易，皆萃其中，四方赴
京师，以货物求售转售他人者，必由于此。廊壁上皆是高益，文进，李象坤等人
所绘的壁画，精美绝伦。廊外是僧人居住的八个大院。
LONG);
    set("exits",([
        "south"    : __DIR__"dxgs_donglang1",
        "east"     : __DIR__"dxgs_yuan4",
        "west"     : __DIR__"dxgs_dongta",
        "north"    : __DIR__"dxgs_donglang3",
    ]));
    set("detail",([
    ]));
    set("objects",([
    ]));
    setup();
}
void init()
{
    ::init();
}    
