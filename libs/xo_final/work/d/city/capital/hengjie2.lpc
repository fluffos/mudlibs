// 汴京     /d/city/capital/hengjie2.c
#include <room.h>
#include <ansi.h>
#include "bianjing.h"
inherit STREET;
void create() {
  set("short", GRN "横街" NOR);
  set("long", @LONG
    沿着金明池南岸，是一条牙道柳径，人称横街。南面是大门，面开五间，朱
漆金钉，黄瓦青檐，柱子上盘龙赘凤，的是皇家制度。北面临水是一处宫殿：两
层巨石台基上三座大殿相连，当中一座面开五间，重檐歇山，殿门匾额上题着“
临水殿”三个镏金大字。
LONG GRN @TEXT
    一阵阵微风吹来，夹着池水的气息，让人联想起了江南的风光。
TEXT NOR);
  set("exits", ([
    "north": __DIR__ "linshui_dian",
    "northeast": __DIR__ "jinming_dongan1",
    "southwest": __DIR__ "jinming_chi",
    "west": __DIR__ "chimen_guangchang",
  ]));
  set("outdoors", "capital");
  set("objects", ([
    //          __DIR__"npc/youren1" : 2,
  ]));
  setup();
}
