#include "bianjing.h"
inherit BROOM;

#include <room.h>
#include <ansi.h>    

void create()
{
    set("short",CYN"遇仙正店"NOR);
    set("long", @LONG
这是一家相当大的酒店，地处南宫城的汴河南岸。临门汴河里舟楫相连，船
夫们撑桨摇橹，哼着号子。店里地方宽阔，正面挂着一幅对联：
LONG CYN@TEXT    
            刘阮入天台，一日易年
            遇仙寻我店，不醉不还
TEXT NOR@DET
    店中前有楼，后有台，住在都城的人们都称其为“台上”。 
DET);
    set("objects", ([
        __DIR__"npc/xiaoer2" : 1,
    ]));
    set("exits", ([  
        "east" : __DIR__"yujie6",
    ]));
//    set("detail",([
//    ]));
    setup();
}