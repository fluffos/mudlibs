// 汴京     /d/city/capital/jianke_miao.c
#include <room.h>
#include <ansi.h>
inherit ROOM;
void create()
{
  set("short", "剑客庙");
  set("long",@LONG
战国末年，秦欲灭六国统一天下；燕太子丹以重金聘得荆柯，行刺秦王以图
缓解燕国覆灭之灾；可惜荆柯最终功亏一篑，反被秦王杀死。后人有为了纪念这
位有名的剑客，就建起荆柯祠以供奉之。这间破破烂烂的小庙里已经没有了神像，
也不知道是不是供奉荆柯的。
LONG);
  set("exits",([
    "north"    : __DIR__"jinming_chi",
  ]));
  setup();
}
