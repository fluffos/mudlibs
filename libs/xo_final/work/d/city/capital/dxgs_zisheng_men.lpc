// 汴京     /d/city/capital/dxgs_zisheng_men.c
#include <room.h>
#include <ansi.h>
#include "bianjing.h"

inherit DOOR_ROOM;
//inherit BROOM;  
void create() {
  set("short", RED "资圣门" NOR);
  set("long", @LONG  
资圣门在大殿的北面，上面建有著名的资圣阁；两边都是僧侣居住的房间，
东面一间普普通通的小院子门上立有一块牌子，写着“方丈室”。再向北走就是
相国寺的后门了。
LONG);
  set("exits", ([
    "up": __DIR__ "dxgs_zisheng_ge",
    "south": __DIR__ "dxgs_shengrong_ge",
    "east": __DIR__ "dxgs_fangzhang",
    "west": __DIR__ "dxgs_jianyuan",
    "north": __DIR__ "dxgs_houmen",
  ]));
  create_door("east", "木门", "west", DOOR_CLOSED);
  create_door("west", "木门", "east", DOOR_CLOSED);
  set("detail", ([
  ]));
  set("objects", ([
  ]));
  set("outdoors", "capital");
  setup();
}
void init() {
  //::init();
  add_action("do_open", "open");
}
int do_open(string arg) {
  if (!arg || arg == "") return 0;
  if (arg == "door" || arg == "west" || arg == "east") {
    write("这扇门从里面锁住了。\n");
    return 1;
  }
}
