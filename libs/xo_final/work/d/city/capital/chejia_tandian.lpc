inherit BROOM;

#include <room.h>
#include <ansi.h>    

void create()
{
    set("short","车家炭店");
    set("long", @LONG
一家相当气派的店铺，卖的却是普普通通的煤炭。不过这也是人所必需之物，
销量甚大，故而生意不错。因为门前御街宽阔，炭车进出方便，故而成了城中第
一大的炭店。店里空空的，没有柜台，北首靠墙堆着二人高的木炭和煤块，伙计
们个个黑乎乎的满头大汗。
LONG);
    set("objects", ([
        __DIR__"npc/huoji1" : 2,
        __DIR__"npc/che_daxing" : 1,
    ]));
    set("exits", ([  
        "west" : __DIR__"yujie5",
        "east" : __DIR__"hanh_men",
        
    ]));
//    set("detail",([
//    ]));
    setup();
}
