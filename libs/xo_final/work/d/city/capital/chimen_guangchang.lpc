// 汴京     /d/city/capital/chimen_guangchang.c
#include <room.h>
#include <ansi.h>
#include "bianjing.h"
inherit STREET;
void create()
{
  set("short",HIY "池门广场" NOR);
  set("long",@LONG
这里是金明池南岸的中心，面对池岸是一个周围数百丈的大广场。北面是一
座长达数百步的木桥，朱漆栏杆，下排雁柱，人称“仙桥”，又称“虹桥”，南
面是一座宽达百丈的高大殿阁----宝津阁，建在一个高十数丈的高台上面。向南
绕过宝津阁，可到宴殿。
LONG GRN @TEXT
    一阵阵微风吹来，夹着池水的气息，让人联想起了江南的风光。
TEXT NOR);
  set("exits",([
    "northup"  : __DIR__"xianqiao",
    "east"  : __DIR__"hengjie2",
    "south" : __DIR__"yandian",
    "west" : __DIR__"hengjie0",
  ]));
  set("outdoors","capital");
  set("objects",([
//          __DIR__"npc/youren1" : 2,
  ]));
  setup();
}
