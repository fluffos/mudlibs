#include <room.h>
#include <ansi.h>
#include "bianjing.h"
inherit SROOM;
void create() {
  set("short", GRN "北山子茶坊" NOR);
  set("long", @LONG            
小小一间门脸，门面装潢淡雅，不施重彩。进得门来，迎面是一个小池塘，
一座三尺宽小桥飞架塘上，扎着彩花，名为「仙桥」：顶梁上悬下丝丝缎带，缀
着盏盏小灯，仿佛满天的星星。过了「仙桥」，便入「仙洞」。
LONG
  );
  set("objects", ([
  ]));
  set("exits", ([
    "north": __DIR__ "tushizi_jie2",
    "south": __DIR__ "xiandong",
  ]));
  set("detail", ([
  ]));
  setup();
}
