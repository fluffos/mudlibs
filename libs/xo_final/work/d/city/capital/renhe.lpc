// dali_renhe.c

inherit ROOM;

void create() {
  set("short", "仁和车行汴京总号");
  set("long", @LONG
这里就是仁和车行的总号,之所以将总号设在汴京,除了因为这里的繁荣
,还因为仁和车行的老板一开始就是在这里发家的.  仁和车行本来没有什么
名气，只是一家普通车行而已。然而当大宋和西夏签订了盟约后，宋老板抓
住时机开办了东京到兰州的租车业务，由于近来边境平静无事，大宋和西夏
的交易愈加繁荣，乘坐这家车行的客人也大大增加，仁和车行现以成为全国
数一数二的大车行，在所有的主要城市都建立了分号。
LONG
  );
  set("exits", ([
    "north": __DIR__ "xinz_men",
  ]));
  set("objects", ([
    __DIR__ "npc/boss": 1,
  ]));
  setup();
}

int valid_leave(object me, string dir) {
  if (me->query_temp_marks("booked_mache"))
    return notify_fail("你应该快上马车了，不要再随便跑开。\n");

  else if (me->query_temp_marks("waiting_mache"))
    return notify_fail("你正在等马车呢，不要随便走开。\n");
  else return ::valid_leave(me, dir);
}
