// 汴京     /d/city/capital/xianqiao.c
#include <room.h>
#include <ansi.h>
#include "bianjing.h"
inherit STREET;
void create()
{
  set("short",MAG "仙桥" NOR);
  set("long",@LONG
仙桥连接着金明池南岸的横街和池中的小岛。桥长数百步，木石相间；桥上
朱漆扶栏，下排雁柱，中央高高隆起，有如飞虹之状。桥北尽处是一个小岛，四
岸以巨石相砌，岛中央有一座大殿。
LONG GRN @TEXT
    一阵阵微风吹来，夹着池水的气息，让人联想起了江南的风光。
TEXT NOR);
  set("exits",([
    "northdown"   : __DIR__"jinming_dao",
    "southdown"  : __DIR__"chimen_guangchang",
  ]));
  set("outdoors","capital");
  setup();
}
