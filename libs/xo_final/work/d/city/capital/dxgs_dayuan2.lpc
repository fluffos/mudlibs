// 汴京     /d/city/capital/dxgs_dayuan2.c
#include <room.h>
#include <ansi.h>
#include "bianjing.h"

inherit BROOM;
void create() {
  set("short", HIW "大院" NOR);
  set("long", @LONG
相国寺寺院规模宏大，殿阁楼台无不令行人驻足赞叹。正中的大院更是象个
大广场一般。每个月举行五次大型的贸易集市，就设在大院中，买卖各方总共有
数万人之多，江南西北各地的商人，都把他们的货物运到这里，互相直接用货物
交易，动辄值数十万之巨。东西两廊也都是货摊。北面是一座极大的殿阁，向南
而望，三门，东西二塔，尽在大院两廊包围之中。
LONG);
  set("exits", ([
    "south": __DIR__ "dxgs_sanmen",
    "west": __DIR__ "dxgs_xilang4",
    "east": __DIR__ "dxgs_donglang4",
    "north": __DIR__ "dxgs_shengrong_ge",
  ]));
  set("outdoors", "capital");
  setup();
}
