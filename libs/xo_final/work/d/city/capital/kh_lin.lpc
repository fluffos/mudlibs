
#include <room.h>
#include <ansi.h> 
#include "bianjing.h"
inherit SROOM;
void create()
{
    set("short","快活林");
    set("long",
"这是一个很别致的林间酒店，竹篱茅舍，掩不住酒香阵阵。一面酒旗上书斗\n"
"大一个" BLINK RED"酒" NOR "字迎风摇晃。酒店虽并不位于闹市繁华之处，店里却高朋满座，客人们\n"
"大碗喝酒，猜拳行令之声不绝于耳。可见都是江湖豪客，他们却不单是为了这里\n"
"的好酒而来的，这家位于密林深处的小酒馆还有其它的神秘之处。\n"
        );
    set("exits", ([
        "north" : __DIR__"shulin2",
        ]));
    setup();
}            
        