#include "bianjing.h"
inherit SROOM;
void create()
{
	set("short",BLU "城隍庙" NOR);
	set("long", @LONG
古时候挖土筑城，城下之地就叫做隍，也有人认为，城外的护城河叫做隍。
周易中始定其名，后人皆于城中建庙，以祭祀城隍。如今盛世太平，百业俱兴，
这里也建得格外堂皇。两厢有七十二司之地狱，并黑白无常等塑像，皆栩栩如生。
LONG
	);
	set("objects", ([        
	    __DIR__"obj/item/hei_wuchang" : 1,
	    __DIR__"obj/item/bai_wuchang" : 1,
	    __DIR__"npc/keeper" : 1,
         ]));
	set("exits", ([  
            "south" : __DIR__"jiucheng_qianggen",
            "east"  : __DIR__"yaoshiqiao_jie",
    ]));
    set("detail",([
    ]));
	setup();
}
