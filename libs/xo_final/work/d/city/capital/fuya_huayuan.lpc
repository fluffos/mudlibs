inherit SROOM;
void create() {
  set("short", GRN "小花园" NOR);
  set("long", @LONG
开封府中政事纷忙，知府平时每天要处理上百件公务，到了节假日，甚至更
忙得不可开交。但是人都会忙里偷闲嘛，府衙后院之中也还是有一个小小的花园，
虽然花卉不多，地方不大，可是也挺精美，连在几座厅堂之间，其幽静清谧，是
府中不可多得的。
LONG);
  set("exits", ([
    "west": __DIR__ "fuya_houtang",
  ]));
  set("objects", ([
  ]));
  set("detail", ([
  ]));
  set("outdoors", "capital");
  setup();
