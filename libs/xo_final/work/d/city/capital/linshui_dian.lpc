// 汴京     /d/city/capital/linshui_dian.c
#include <room.h>
#include <ansi.h>
#include "bianjing.h"
inherit BROOM;
void create() {
  set("short", RED "临水殿" NOR);
  set("long", @LONG
临水殿建在池边，面向池水。一共有三座大殿互连，当中一座重檐歇山式屋
顶，面开五间，朱漆彩绘，富丽豪华。这里是皇帝每次临幸时观看禁军的水上表
演的地方。平时也不禁止游人进来观赏。
LONG GRN @TEXT
    一阵阵微风从湖面上吹来，夹着池水的气息，让人联想起了江南的风光。
TEXT NOR);
  set("exits", ([
    "south": __DIR__ "hengjie2",
  ]));
  setup();
}
