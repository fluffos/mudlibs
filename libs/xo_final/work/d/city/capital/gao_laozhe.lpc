#include <ansi.h>
inherit "/d/menpai/shennong/npc/ShennongNpc.lpc";

void create()
{
    set_name("高老者", ({ "gao laozhe", "gao", "laozhe", "gaolaozhe", }) );
    set("class_score/神农帮",       250);
    set("title", BLU"神农帮香主"NOR);
    create_family("神农帮", 1, "香主");
    set("combat_exp",    500000);
    set("social_exp",   100000);
    set("negative_score",  500);
    set("max_force",       1000);
    set("force",           1000);
    set("force_factor",     50);
    set("max_kee",         600);
    set("max_sen",         1500);
    set("kee",             1500);
    set("sen",             600);
    set("age",              50);
    set("int",              27);
    set("long", @LONG
    一个身材甚高的老者，双手十指如鸟爪。看来是长于鹰爪功一类的武功。
LONG
    ); 
    
//    set_wugong("unarmed",           120, 120, 0);
//    set_wugong("yingzhua-shou",     100, 100, 1);
//    set_wugong("blade",             120, 120, 0);
//    set_wugong("baidu-dao",          80,  80, 1);
//    set_wugong("hammer",            120, 120, 0);
    set_wugong("shennong-chu",       150,  150, 1);
    set_wugong("xingyun-shenfa",    120, 120, 0);
//    set_wugong("lingshe-shenfa",     80,  80, 1);
    set_wugong("banruo-xinfa",      100,  100, 1);
    
//    set_wugong("dugong",             45,  45, 0);

    set_xiuwei_by_type("unarmed",   400);
    set_xiuwei_by_type("blade",     400);
    set_xiuwei_by_type("dodge",     1000);
    set_xiuwei_by_type("long",     1900);

    setup();

    carry_object( CLOTH_DIR + "cloth2" )->wear();
    carry_object( SHORT_DIR + "yaochu" )->wield();
    add_money( "coin", 20 + random(20) );
}
        