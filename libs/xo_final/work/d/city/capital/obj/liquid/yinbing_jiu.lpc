//汴京 LIQUIDs:  yinbing_jiu.c 

inherit ITEM;
inherit F_LIQUID;

#include <ansi.h>

void create() {
  set_name(HIR "银饼酒" NOR, ({ "yin bing jiu", "jiu" }));
  set_weight(300);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", @LONG
        一个竹子制成的大酒杯，里面恰好能装一角酒。
LONG);
    set("unit", "杯");
    set("value", 1200);
    set("max_liquid", 3);
    set("drink_msg", "$N端起酒杯喝了一大口银饼酒。\n");
  }
  set("liquid", ([
    "type": "alcohol",
    "name": "银饼酒",
    "remaining": 3,
    "drink_apply": 20,
    "drunk_apply": 6,
  ]));
}
void init() {
  add_action("do_drink", "drink");
}

int drink_effect(object who, object this) {}
