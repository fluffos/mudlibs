//汴京 LIQUIDs: huang_jiu.c 

inherit ITEM;
inherit F_LIQUID;

#include <ansi.h>

void create() {
  set_name(YEL "黄酒" NOR, ({ "huang jiu", "jiu" }));
  set_weight(300);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", @LONG
        一个竹子制成的大酒杯，里面恰好能装一角酒。
LONG);
    set("unit", "杯");
    set("value", 2200);
    set("max_liquid", 3);
    set("drink_msg", "$N端起酒杯喝了一大口黄酒。\n");
  }
  set("liquid", ([
    "type": "alcohol",
    "name": "黄酒",
    "remaining": 3,
    "drink_apply": 20,
    "drunk_apply": 4,
  ]));
}
void init() {
  add_action("do_drink", "drink");
}

int drink_effect(object who, object this) {}
