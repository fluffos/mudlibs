// 汴京 FRUITs:    jin_tao.c
#include <ansi.h>
inherit ITEM;
inherit F_FRUIT;
void create()
{
    set_name(YEL"金桃"NOR, ({"jin tao","tao","fruit"}));
    set_weight(70);
    set("long", "金灿灿的一个桃子，看上去肯定好吃的狠。");
    set("unit", "个");
    set("value", 500);
    set("fruit_remaining", 3); //可以吃5口
    set("food_supply", 15);   //每口加10的food
    set("water_supply", 15);  //每口可以加10的water
    //每次吃的msg,没有也可以的。
    set("eat_msg", "$N拿起$n，大大的啃了一口。\n"); 
    //最后一口的msg，没有亦可
    set("end_msg", "$N仔细的啃完了这个$n。\n");  
    //吃饱了的msg, 没有亦可，但不能有代词。
    set("over_msg", "吃这么多？小心撑破肚皮！！！！\n"); 
    // 水果吃完剩下的东西 :-)
    set("core", "桃核");     //name
    set("core_id", ({"tao hu", "core"}) ); //id
    set("core_unit", "个");    //unit
    set("core_long", "一个桃核。\n"); //long

    setup();
}
void init()
{
    add_action("do_eat","eat");
}
