//汴京 FRUITs :   橄榄ganlan.c

inherit ITEM;
inherit F_FRUIT;

#include <ansi.h>

void init()
{
    add_action("do_eat", "eat");
}

void create()
{
    set_name(GRN"橄榄"NOR, ({"gan lan","lan","fruit"}));
    set_weight(500);
    set("long", @LONG   
  一包用盐水腌过的橄榄,用荷叶包着。
LONG);
    set("unit", "包");
    set("value", 400);
    set("fruit_remaining", 7);
    set("food_supply", 4); 
    set("water_supply", 13);
    set("eat_msg", "$N拿起一个$n，含在嘴里。\n");
    set("end_msg", "$N仔细的啃完了最后一个$n。\n");
    set("gifts",([        
        "spi" : 2,
    ]));
    set("core", GRN"荷叶"NOR);  
    set("core_id", ({"he ye", "ye","leaf"}) );
    set("core_unit", "张");  
    set("core_long", "一张用来包食品的荷叶，已经揉皱了。\n"); 

    setup();
}
