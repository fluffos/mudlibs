//汴京 FOODs:     dong_yutou.c

inherit ITEM;
inherit F_FOOD;

#include <ansi.h>

void create() {
  set_name(CYN "冻鱼头" NOR, ({ "dong yutou", "yutou", "fishhead", "food" }));
  set_weight(400);
  set("long", @LONG   
    鱼头凉着吃？－－不腥吗？
        你倒试试看：
LONG);
  set("unit", "盘");
  set("value", 4800);
  set("over_value", 0);
  set("food_remaining", 4);
  set("gifts", ([
    "spi": 1,
  ]));
  set("food_supply", 10);
  set("eat_msg", "$N夹起一块$n放进嘴里，登时一股凉意直贯心底！原来一点也不腥！\n");
  set("end_msg", "$N将剩下的$n吃的干干净净.\n");
}
int eat_effect(object me, object this) {
  if (me->query("water") < me->max_water_capacity())
    me->add("water", 15);
  return 0;
}
int finish_eat(object me, object this) {
  this->set_name(GRN "小竹盘儿" NOR, ({ "zhu pan", "pan", "zhu", "plate" }));
  this->set("long", "一个竹子编的小盘。\n");
  this->set("unit", "个");
  this->set("value", 0);
  this->set_weight(10);
  return 1;
}
