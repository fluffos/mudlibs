//汴京 FOODs:     bxwanzi.c

inherit ITEM;
inherit F_FOOD;

#include <ansi.h>

void create()
{
    set_name(CYN"冰雪冷丸子"NOR, ({"bingxue leng wanzi","wanzi","dot","food"}));
    set_weight(400);
    set("long",@LONG   
    一盘凉凉的冰雪丸子，上面还浇上了橘子汁和梅汁，一股股雾气从盘子上
  散发开来。
LONG);
    set("unit", "盘");
    set("value", 5000);
    set("over_value",0);
    set("food_remaining", 5);  
    set("gifts",([
        "spi" : 1,
        "force" : 1000,
    ]));
    set("food_supply", 1);
    set("eat_msg","$N夹起一块$n放进嘴里，登时一股凉意直贯心底！\n");
    set("end_msg","$N将剩下的$n吃的干干净净.\n");
}
int eat_effect(object me,object this) 
{                                                        
    tell_object( me,HIW"你觉得一股冰凉的感觉直透到心窝。\n"NOR);
    if( me->query("water") < me->max_water_capacity() ) 
        me->add("water",15);     
    return 0;
}
int finish_eat( object me , object this )
{
    this->set_name(GRN"小竹盘儿"NOR,({"zhu pan","pan","zhu","plate" }));
    this->set("long","一个竹子编的小盘。\n");
    this->set("unit","个");
    this->set("value",0);
    this->set_weight(10);
    return 1;
}
