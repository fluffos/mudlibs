//汴京 FOODs:     xingpian.c

inherit ITEM;
inherit F_FOOD;

#include <ansi.h>

void create()
{
    set_name(YEL"杏片"NOR, ({"xing pian","pian","piece","xing","food"}));
    set_weight(100);
    set("long",@LONG  
    一包晒干的杏片。
LONG);
    set("unit", "包");
    set("value", 1100);
    set("over_value",0);
    set("food_remaining", 6);
    set("food_supply", 5);
    set("eat_msg","$N用两个手指轻轻地夹了一片$n放进嘴里.\n");
    set("end_msg","$N将剩下的$n吃的干干净净.\n");
}
int finish_eat( object me , object this )
{
    this->set_name(WHT"油纸"NOR,({"you zhi","zhi","paper"}));
    this->set("long","一张小贩们经常用来包食物的油纸.\n");
    this->set("unit","张");
    this->set("value",0);
    this->set_weight(1);
    return 1;
}
