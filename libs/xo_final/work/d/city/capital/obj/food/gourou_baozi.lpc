// 汴京 FOOD：   gourou_baozi.c
#include <ansi.h>
inherit ITEM;
inherit F_FOOD;
void create()
{
    set_name("狗肉包子", ({"gourou baozi","baozi","bao"}));
    set_weight(500);
    if (clonep())
        set_default_object(__FILE__);
    else {
        set("long", "一包热气腾腾的狗肉包子，用油纸包着。\n");
        set("unit", "包");
        set("value", 800);
        set("over_value",0);
        set("food_remaining", 3);
        set("food_supply", 50);//正常饭量的人一顿吃二斤。
        set("eat_msg","$N从纸包里拿出一个$n放进嘴里，兴奋地吃起来\n");
        set("end_msg","$N将纸包里的最后一个$n放进嘴里，颇有些舍不得。.\n");
        }
}
int eat_effect(object me,object this)
{   
    if( me->query("water") > 0 )
        me->add("water",-5);
    return 0;
}
int finish_eat( object me , object this )
{
    this->set_name("油皮纸",({"youpi zhi","zhi","paper" }));
    this->set("long","一张用来包包子的纸，已经被油浸透了。\n");
    this->set("unit","张");
    this->set("value",0);
    this->set_weight(1);
    return 1;
}
