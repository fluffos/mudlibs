//汴京： FOODs :    hutao_zongzi.c

inherit ITEM;
inherit F_FOOD;

#include <ansi.h>

void create()
{
    set_name(HIY"胡桃"NOR+YEL"粽子"NOR, ({"hutao zongzi","zongzi","food"}));
    set_weight(50);
    set("long",@LONG 
    粽子本名“角黍”，俗称为“粽子”。煮的粽子用烧艾草的灰调水淋煮，
  煮好的粽子颜色金黄，所谓“角黍包金，香蒲切玉”就是谓此。
LONG);
    set("unit", "个");
    set("value", 800);
    set("over_value",0);  
    set("gifts",([
        "con" : 1,
    ]));                                
    set("food_remaining", 2);
    set("food_supply", 30);
    set("eat_msg","$N拿起$n咬了一口--真粘呀！，牙齿都要掉下来了!里面的胡桃脆脆的。\n");
    set("end_msg","$N将剩下的$n吃的干干净净.\n");
}
int eat_effect(object me,object this)
{
    if( me->query("water") > -4 )
        me->add("water",-2);    
    return 0;
}
int finish_eat( object me , object this )
{
    this->set_name(HIG"菰叶"NOR,({"gu ye","ye","leaf" }));
    this->set("long",@LONG      
    菰叶就是芦苇叶子，民间通常都用它来包粽子，这片叶子上面粘着不少
  江米粒，显然是已经用过的叶子了。
LONG);
    this->set("unit","张");
    this->set("value",0);
    this->set_weight(1);
    return 1;
}
