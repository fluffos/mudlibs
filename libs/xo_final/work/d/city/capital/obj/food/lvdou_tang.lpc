// 汴京 FOOD：    lvdou_tang.c
inherit ITEM;
inherit F_FOOD;
#include <ansi.h>
void create()
{
        set_name("绿豆汤", ({"lvdou tang","tang"}));
        set_weight(150);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("long",@LONG
    一碗冰镇绿豆汤，放了些红糖在里面。
LONG
);
                set("unit", "碗");
                set("value", 800);
                set("over_value",0);
                set("food_remaining", 4);
                set("food_supply",1);//正常饭量的人一顿吃二斤。
                set("eat_msg","$N呷了一口绿豆汤，好凉爽呀！.\n");
//                set("end_msg","$N将纸包里的最后一个$n放进嘴里，颇有些舍不得。.\n");
        }
}
int eat_effect(object me,object this)   
{
    if( me->query("water") < me->max_water_capacity() )
    {
        me->add("water",15);
        return 0;
    }
    else
    {
        tell_object(me,"你肚子里已经灌了个水饱儿了，别喝啦n");
        return 1;
    }
}
int finish_eat( object me , object this )
{
    this->set_name(GRN"竹碗"NOR,({"zhu wan","wan" }));
    this->set("long","一个竹子抠成的小碗。\n");
    this->set("unit","只");
    this->set("value",0); 
    this->set_weight(10);
    return 1;
}
