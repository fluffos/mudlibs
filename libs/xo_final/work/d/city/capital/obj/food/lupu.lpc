// 汴京 FOOD：    lupu.c    

inherit ITEM;
inherit F_FOOD;         

#include <ansi.h>       

void create()
{
    set_name(RED"鹿脯"NOR, ({"lu pu","lu","pu","meat"}));
    set_weight(400);
    set("long",MAG @LONG
    一包烤的焦黄流油的鹿脯肉，香气四溢。
LONG NOR
);
    set("unit", "包");
    set("value", 3000);
    set("over_value",0);
    set("food_remaining", 4);
    set("food_supply",40);
    set("gifts",([
        "str" : 5, 
        "dex" : 3,
        "cor" : 3,
    ]));
    set("eat_msg","$N贪婪地将一块$n放进嘴里大嚼起来.\n");
    set("end_msg","$N将纸包里的最后一块$n放进嘴里，颇有些舍不得。.\n");
        }
int eat_effect(object me,object this)
{                       
    if( me->query("water") < me->max_water_capacity() ) 
        me->add("water",-3);  
    if( me->query("kee") < me->query("max_kee") ) 
        me->add("kee",3);
    return 0;
}
int finish_eat( object me , object this )
{
    set_name("油皮纸",({"you pi zhi","zhi","paper" }));
    set("long",@LONG        
    一张用来包食物的油皮纸，已经被油浸透了。
LONG);
    this->set("unit","张");
    this->set("value",0);
    this->set_weight(50);
    return 1;
}
