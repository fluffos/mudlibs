#include <ansi.h>
#include "bianjing.h"
inherit ITEM;

void create()
{
    set_name(HIW "白无常" NOR, ({ "bai wuchang","wuchang" }) );;
    set("long","白无常伸著长长的舌头瞪著你，黝黑的脸上看不出任何喜怒哀乐。\n");
