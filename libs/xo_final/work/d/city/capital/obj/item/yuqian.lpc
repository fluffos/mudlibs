// 汴京 TEA :      yuqian.c

inherit TEA;
              
#include <ansi.h>
#include "bianjing.h"

void create()
{
    set_name(GRN"雨前"NOR, ({ "yu qian","cha","tea"}) );
    set("long",@LONG 
    雨前是茶中的精品，是用精心采制的茶叶，焙干而成，作淡绿色，清香
  无比。
LONG);
    set("unit","饼");
    set("value",10000);
    set_weight(50);
    setup();
}
