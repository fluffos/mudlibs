// 汴京 TEA :      longyuan_baochun.c

inherit TEA;

#include <ansi.h>
#include "bianjing.h"

void create() {
  set_name(YEL "龙苑报春" NOR, ({ "longyuan baochun", "cha", "tea" }));
  set("long", @LONG 
    龙苑报春是茶中的精品，是用精心采制的茶叶，焙干而成，作浅白绿，遍
  体布满白毛，味清微苦，入口滑润。
LONG);
  set("unit", "饼");
  set("value", 2000);
  set_weight(50);
  setup();
}
