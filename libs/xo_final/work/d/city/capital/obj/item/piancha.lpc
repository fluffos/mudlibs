// 汴京 TEA :      piancha.c

inherit TEA;
              
#include <ansi.h>
#include "bianjing.h"

void create()
{
    set_name(HIR"片茶"NOR, ({ "pian cha","cha","tea"}) );
    set("long",@LONG 
    市卖的茶叶习惯上都作成饼状，是采下茶叶后，焙干碾碎压成的。有的
  里面还掺了些麝香，冰片等香料，和苍耳，白术等药材。
LONG);
    set("unit","饼");
    set("value",100);
    set_weight(50);
    setup();
}
