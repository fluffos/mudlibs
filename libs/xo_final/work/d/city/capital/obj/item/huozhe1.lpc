// 汴京 ITEM :      huozhe.c


inherit ITEM;
              
#include <ansi.h>
#include "bianjing.h"

void StartFire( object me );
int do_fire( string arg );
int CanFire( object me );
int EndFire( object me );
void SetAfterFire();

void create()
{
    set_name("火折子"NOR, ({ "huo zhezi","zhezi","zhe" }) );
    set("long",@LONG 
    这是一个用来在黑暗的地方照明的火折。点着(fire)后可以燃烧一段时间，
  以便使用它的人能够看清周围的东西。
LONG);
    set("unit","个");
    set("value",300);
    set_weight(20);
    set("material","paper");
    setup();
}
void init()
{
    add_action("do_fire","fire");
}
int do_fire( string arg )
{
    object me,this;
     
    me = this_player();
    this = this_object();
    
    if( !arg || !id(arg) ) 
        return notify_fail("你想点什么？\n");
    if( !this->CanFire( me ) )
        return 0;
    StartFire( me );
    call_out("EndFire",120,me);
    return 1;
}
void StartFire( object me )
{
    me->set_temp("using_fire",1);
    set("no_drop","点燃的火折不能扔。\n");
    set("firing",1);
    set("cant_sell","点过了火折不能卖！\n");
    message_vision("$N从怀里掏出一个火折子，点着了举在手里\n",me);
    return;
}
int CanFire( object me )
{
    if( !me->can_act() ) 
        return notify_fail("你现在正忙着呢，待会儿再说吧。\n");
    if( me->query_temp("using_fire") )
        return notify_fail("你已经在使用火折了呀！\n");
    if( query("firing") )
        return notify_fail("这个火折已经点燃了。\n");
    if( query("after_fire") )
        return notify_fail("这个火折已经点过了，不能使了。\n");
    return 1;
}
int EndFire( object me )
{
    message_vision("只见$N手上的火折渐渐地越来越暗，终于熄灭了。\n",me);
    SetAfterFire();
    me->delete_temp("using_fire");
    return 1;
}
void SetAfterFire()
{
    set("long",@LONG
    这是一个用来在黑暗的地方照明的火折。点着(fire)后可以燃烧一段时间，
  以便使用它的人能够看清周围的东西。但是这个火折已经用过了，不能再用
  了
LONG);
    delete("value");
    delete("firing");
    delete("no_drop");
    set("after_fire",1);
    return;
}
    

    
    
    

