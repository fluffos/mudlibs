// 汴京 TEA :      miyun_long.c

inherit TEA;

#include <ansi.h>
#include "bianjing.h"

void create() {
  set_name(GRN "密云龙" NOR, ({ "miyun long", "cha", "tea" }));
  set("long", @LONG 
    密云龙是茶中的精品，是用精心采制的茶叶，焙干而成，常常用作贡品。
LONG);
  set("unit", "饼");
  set("value", 30000);
  set_weight(50);
  setup();
}
