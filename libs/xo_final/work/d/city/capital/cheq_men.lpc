#include <room.h>
#include <ansi.h>   
#include "bianjing.h"
inherit GATE;
void create()
{
	set("short", HIW "陈桥门" NOR);
	set("long", @LONG
陈桥门，又叫长景门，门外有著名的陈桥驿。当年太祖皇帝就是在这里黄袍
加身，荣登大宝的。那以后，陈桥驿被改建为接待辽国使臣的番院。城门外建有
巨大的椭圆型瓮城，纵横各百步，城门有三重，三道城门屈曲而开，不在同一条
直线上。城门上建有高大的门楼，登上门楼，城外数十里尽收眼底。
LONG
	);
	set("outdoors", "capital");
	set("objects", ([ 
                  __DIR__"npc/gate_shibing" : 2,
                  __DIR__"npc/gate_yuhou" : 1,
         ]));
	set("exits", ([ 
                   "east" : __DIR__"fqiu_men",
                  "west" : __DIR__"ytai_men",
         ]));
        set("detail",([
        ]));
	setup();
}
