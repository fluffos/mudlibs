// 汴京NPCs:   huoji1.c
 
inherit NPC;
inherit F_VENDOR;

#include <ansi.h>
#include "bianjing.h"     

void create()
{
    set_name(comm_man_name(), ({ "huo ji","huo"}) );
    set("gender", "男性" );
    set("age",20 + random(15) );
    set_hp("gin", 500);
    set_hp("kee", 600);
    set_hp("sen", 600);
    set("title",BLK"炭店伙计"NOR);
    set("attitude", "friendly");
    set("vendor_goods", ([  
        "柴"        : BIANJING_ITEM "chai",
    ]) );
    set("combat_exp", 1000);
    set("social_exp", 400);
    set_wugong("unarmed",50,50,1);
    set_xiuwei_by_type("unarmed",100);
    set_xiuwei_by_type("dodge",100);
    set_wugong("qinggong",40,40,1);
    setup();
    carry_object(CLOTH_DIR "mancloth1" )->wear();
}
void init()
{
        object ob;
        ::init();
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
        }
        add_action("do_vendor_list", "list");
}
void greeting(object ob)
{
        if( !ob || environment(ob) != environment() ) return;
        message_vision("伙计迎着$N跑上来：“客官，买炭么？”\n",ob);
}
