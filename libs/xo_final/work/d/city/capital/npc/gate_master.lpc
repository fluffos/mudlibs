//汴京 Npc : gate_master.c 
inherit SOLDIER;
#include "bianjing.h"
#include <ansi.h>
string call_others(object who);
void create() {
  set_name("营指挥使", ({ "zhihui shi", "shi" }));
  set("title", CYN "侍卫亲军" + RED "虎翼军第" + chinese_number(random(96) + 1) + "营" NOR);
  set("age", 30);
  set("gender", "男性");
  set("long", "    禁军中每五百人为一营，设营指挥使一人总管。\n");
  set("combat_exp", 30000);
  set("max_force", 2000);
  set("force", 2000);
  set("force_factor", 50);
  set("talk_msg", ({
    "庶民之家，断不可存片甲兵刃，若有违反，杀无赦！！！！！\n",
    "好男儿当为国效力，看你身材体格不错，当兵吧？\n",
  }));
  set("chat_chance_combat", 10);
  set("chat_msg_combat", ({
    (: call_others :),
  }));
  SetPower("zhihui shi", 1);
  setup();
  SetEquipment("zhihui shi");
}
