// 汴京NPCs:   xiaoer2.c
 
inherit NPC;
inherit F_VENDOR;

#include <ansi.h>
#include "bianjing.h"     

void create()
{
    set_name(comm_man_name(), ({ "xiao er","waiter"}) );
    set("gender", "男性" );
    set("age",20+ random(10) );
    set_hp("gin", 500);
    set_hp("kee", 600);
    set_hp("sen", 600);
    set("title","店小二");
    set("attitude", "friendly");
    set("vendor_goods", ([  
        "银饼酒"       : BIANJING_LIQUID "yinbing_jiu",
        "羊羔酒"       : BIANJING_LIQUID "yanggao_jiu",
        "整坛羊羔酒"   : BIANJING_LIQUID "yanggao_jiu1",
        "女儿红"       : BIANJING_LIQUID "nverhong_jiu",
        "女儿红酒"     : BIANJING_LIQUID "nverhong_jiu1",
        "蛇胆酒"       : BIANJING_LIQUID "shedan_jiu",
        "黄酒"         : LIQUID_DIR      "hulu",
    ]) );
    set("positive_score", 100);
    set("combat_exp", 1000);
    set("social_exp", 400);
    set_wugong( "unarmed" , 90 , 90, 1);
    set_xiuwei_by_type( "unarmed",120 );
    setup();
    carry_object(CLOTH_DIR "mancloth1" )->wear();

}
void init()
{
        object ob;
        ::init();
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
        }
        add_action("do_vendor_list", "list");
}
void greeting(object ob)
{
        if( !ob || environment(ob) != environment() ) return;
        message_vision("店小二迎着$N跑上来：“客官请入座！来点什么酒？我们这里的酒可是天下闻名！”\n",ob);
}
