// 汴京NPCs:  liu_biyun.c

inherit NPC;

#include <ansi.h>
#include "bianjing.h"

void create() {
  set_name(GRN "刘碧云" NOR, ({ "liu biyun", "liu" }));
  set("gender", "女性");
  set("age", 34);
  set_hp("gin", 300);
  set_hp("kee", 300);
  set_hp("sen", 300);
  set("str", 10);
  set("title", CYN "教坊" RED "舞妓" NOR);
  set("class", "government");
  set("nickname", CYN "霓裳仙子" NOR);
  set("long", @LONG
    刘碧云是教坊中最有名的一名舞妓，她体形婀娜，舞姿轻快，尤其擅长
从中唐以来几乎绝迹的「公孙大娘剑舞」，柔美之中透出一股刚毅，别有一
番风韵。
LONG);
  set("inquiry", ([
    "飞虹身法": "嘻嘻，你说的就是公孙前辈留传下来的剑舞呀！\n",
    "飞虹轻功": "嘻嘻，你说的就是公孙前辈留传下来的剑舞呀！\n",
  ]));
  set("attitude", "friendly");
  set("rank_info/respect", "姐姐");
  set("rank_info/rude", "贱货");
  set("positive_score", 2000);
  //    set_wugong();
  set_xiuwei_by_type("dodge", 12000);  //haha!!!!!!!!
  setup();
  carry_object(CLOTH_DIR "ouse_shashan")->wear();

}
