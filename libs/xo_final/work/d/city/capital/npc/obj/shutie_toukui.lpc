// standard soldieritem    lin       06/26/97
#include <armor.h>
inherit HEAD;

#include <ansi.h>
void create() {
  set_name("熟铁头盔", ({ "tie toukui", "toukui", }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "这是禁军士兵戴的头盔，由军器所统一制作.\n");
    set("unit", "只");
    set("value", 100);
    set("cant_sell", HIR "这是军中的东西，小的可不能收\n" NOR);
    set("material", "iron");
    set("armor_prop/armor", 5);

  }
  setup();
}
int is_soldier_use(object me) {
  return 1;
}
