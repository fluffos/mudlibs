// standard soldieritem   edit by in 06/26/1997
#include <armor.h>
inherit BOOTS;
#include <ansi.h>
void create() {
  set_name("军靴", ({ "jun xue", "xue" }));
  set_weight(700);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "这是禁军中士兵统一专用的军靴。布制厚底。\n");
    set("unit", "双");
    set("value", 200);
    set("cant_sell", "官军的装备也来买卖，不要脑袋了么？！\n");
    set("material", "steel");
    set("armor_prop/armor", 1);
    set("armor_prop/dodge", 5);
  }
  setup();
}
int is_soldier_use(object me) {
  return 1;
}
