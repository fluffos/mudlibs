//汴京 Npc : jinjun_kaoguan1.c

inherit "/d/city/capital/npc/soldier0"; 

#include "bianjing.h"
#include <ansi.h>

string call_others(object who); 

void create()
{
    set_name("邢万里", ({ "xing wanli","xing","kaoguan","wanli" }));
    set("title",BLU "主考官" NOR);    
    set("age", 44 );
    set("long", @LONG
    这位是主持每年两度的招募士兵、选拔将校活动的主考官；他身穿全套将校
  戎服，显得格外精神。他的身边是各级协考官员，还有些士兵，拿着不少器械
  用具。
LONG);
    set("combat_exp", 30000);
    set("social_exp", 10000);
    set("talk_msg",({
        "好男儿当为国效力，看你身材体格不错，当兵吧？\n", 
        "当兵有很多好处咧！！可以领到很多军饷，还有一份充足的口粮。\n",
        "这位壮士，看来是位江湖英雄呀，不知道愿不愿意参加禁军，为国效力呢？\n",
        "这位英雄，江湖险恶，哪儿比得在军旅中扬威天下，相当年金刀杨老令公、还有\n"
        "那些驰骋疆场的将帅，多么威风！！那可是一呼万应呀，江湖哪里能比得呢！\n",
    }));
    SetPower("zhihuishi",1);                   
    setup();
    SetEquipment("zhihui shi");
}
void init()
{
    add_action("AcceptMember","join");
    add_action("Report", "report");
}
int AcceptMember( string arg )
{
    object who, me;
    me = this_object(); 
    who = this_player();
    if ( arg && arg != "jinjun" && arg != "禁军" )
        return notify_fail("这里是招收禁军(jinjun)士兵和军官的地方！没事儿别瞎凑热闹！\n");
    if ( !living( who ) || !who->can_act() )
        return 0;
    if ( !living( me ) || !me->can_act() )
        return 0;
    if ( who->IsMemberOf( "jinjun" ) )
    {
        if ( who->ZuzhiTouxian( "jinjun" ) == "军士" )
            return notify_fail("你要想获得晋升成为军官，可以到里面营房中参加比武。\n");
        else 
            return notify_fail("要想晋升，请到里面比武\n");
    }
    if ( who->IsRefusedBy( "jinjun" ) )
        return notify_fail("你的江湖背景很复杂，禁军中不收你这样的人.\n");
    //收
    if ( who->query("gender") == "女性" )
    {
        if( who->query("age") < 35 )
        {
            message_vision( query("name") + "带着嘲笑的眼光看了看$N，笑道：“这位" + 
          who->query("rank_info/respect") + "也要参军？！嘻嘻，不如在这里等一等，收个\n"
          "夫家回去生孩子吧！哈哈哈哈......”\n", who );
            return 1;
        }
        else
        {
            message_vision( query("name") + "瞪了$N一眼，喝道：“这里在进行军国大事，"+
          "你一个妇道人家瞎凑什么热闹？！”\n", who);
            return 1;
        }
    }
    if ( who->query("age") < 18 )
    {
        message_vision( query("name") +"不屑一顾地看了看$N，说：“就你这点身子骨，还想当兵？\n"
       "当兵是好事，不过你还是先回家去，等两年再来也不迟嘛！”\n", who);
        return 1;
    }
    if ( who->query_temp( "join_army/refused" ) )
        return notify_fail( "你已经落选了，要想再考，明年再说吧。\n" );
    if ( who->query_temp( "join_army/testing" ) )
        return notify_fail( "你不是正在考嘛？\n" ); 

    who->set_temp( "join_army/testing" , 1 );
    message_vision( query("name") +"笑了笑，说：“好吧，那咱们就看看，你是不是块当兵的料！”\n"
      "一名考官拿过纸笔，将$N的姓名抄在纸上\n" , who );
    message_vision( "一名考官拿过一根长长的竹竿，让$N站直身体，将竿子在他身边一比......\n", who);
    if( who->query("kar") < 14 || who->query("kar") > 30 )
    {
        message_vision( "只听考官对着$N叹了口气，说道：“你太矮啦！不合太祖皇帝定下的规矩”。\n"
        "顺手拿过登记策，在$N的名字上划了大大的一个叉子,喊道：“下一个！！”\n" , who );
        set_temp("join_army/refused",1);
        return 1;
    }
    message_vision( "考官对主考官说：“可以，考下一项！”\n\n"
    "主考官指着地上的一块大石头，对$N说：“把这块石头搬起来！让我们看看\n"
    "你有多大力气。”\n", who );
    who->set_temp("join_army/get_stone",1);
    return 1;
}
int accept_object( object who, object ob )
{
    int num;
    if ( !who->query_temp( "join_army/testing" ) )
    {
        message_vision( "考官看了看$N，疑惑地说：“你要干什么？”\n" , who );
        return 0;
    }
    if ( !who->query_temp( "join_army/get_stone" ) )
    {
        message_vision( query("name") + "疑惑地说：“考试要守规矩，你瞎搞什么？”\n",who );
        return 0;
    }
    if ( !ob->query("use_for_join_army's_test") )
    {
        command( "say 这可不是我要你拿的东西呀！ 那块石头呢？" );
        command( "shake " + who->query("id") );
        return 0;
    }
    who->delete_temp("join_army/get_stone");
    command( "nod " + who->query("id") );
    command( "say 不错，你的体格还蛮好嘛！" );
    message_vision( "$N脚下一个趔趄，赶忙把石头扔在地上\n", this_object() );
    ob->move( environment( this_object() ) );
    message_vision( query("name") + "对$N说：“这是最后一项了，看看远处那个棋标上面划着几条杠杠？\n"
     "看仔细了，赶紧告诉( report )我！”\n"
     "$N顺着考官指点的方向，瞪大眼睛看了半天\n" , who );
    num = random( 5 );
    who->set_temp( "join_army/sight_test", num );
    if ( who->query("kar") == 24 || who->query("int") > 30 )
        num = random( 7 );
    tell_object( who,"似乎是" + chinese_number( num ) + "条\n" );
    return 1;
}
int Report( string arg )
{
    int num,f_num;
    object who, me;
    who = this_player();
    me = this_object();
    if ( !who->query_temp( "join_army/testing" ) )
        return notify_fail( "你要干什么呀？！\n" );
    num = who->query_temp( "join_army/sight_test" );
    if ( !num )
    {
        command( "heng " + who->query("id") );
        command( "say 考试要守规矩，当心轰你出去！" );
        return 1;
    }
    if ( !arg || sscanf( arg,"%d",f_num ) != 1 || !intp( f_num ) )
        return notify_fail( "你想干吗呀？想好了再说不行嘛！？\n" );
    message_vision( "$N带着探询的口气说道：“是" + chinese_number( f_num ) + "条吧？”\n"
      ,who );
    if ( num == f_num )
    {
        command( "smile " + who->query("id") );
        message_vision( query("name") + "对$N道：“不错，你各项都合格了，进去比"
         "试一下武艺吧。如果你能打败里面的武士，就\n"
         "能当上军官啦！\n"
         "  可是如果不能的话，你就只能当兵了。\n", who );
        who->delete_temp( "join_army/sight_test" );
        who->set_temp("join_army/test_skill",1);
        return 1;//到这里已经肯定可以进禁军了。
    }
    else 
    {
        command( "sigh " + who->query("id") );
        command( "say 虽然是最后一项了，可是我也不能放宽要求呀。" );
        message_vision( "考官将$N的名字从登记簿上划了去。\n" , who );
        who->delete_temp( "join_army" );
        who->set_temp( "join_army/refused" , 1 );
        return 1;
    }
}
   
int refuse_killing( object who )
{
    tell_object( who, "在这千军万马之中你居然想单枪匹马地动刀动枪？！不是螳臂挡车吗？！\n");
    return 1;
}
int accept_fight( object who )
{
    return notify_fail("这里不许比武，要想比武，请到里面营房去\n");
}
