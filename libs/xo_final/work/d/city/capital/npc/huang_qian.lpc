//汴京 Npc : huang_qian.c 
inherit SOLDIER; 
#include "bianjing.h"
#include <ansi.h>
string call_others(object who); 
void create()
{
    set_name("黄谦",({ "huang qian","huang","qian" }));
    set("title",CYN"殿前司"RED"天武"YEL"第二十一营"RED"指挥使"NOR);    
    set("age", 38 );
    set("gender", "男性");
    set("long", "    禁军中每五百人为一营，设营指挥使一人总管。\n");
    set("combat_exp", 30000);
    set("max_force",500); 
    set("force",500);
    set("force_factor",10);     
    set("talk_msg",({
        "我马上就要除授徽州团练副使，南下赴任去了。"
    }));
    set("chat_chance_combat", 10);
    set("chat_msg_combat", ({
        (: call_others :),
    }));                    
    set_wugong("wuhu-dao",80,80,1);
    set_xiuwei_by_type("blade", 600);
    set_wugong("yuanyang-tui",70,70,1);
    set_xiuwei_by_type("unarmed", 600);
    set_wugong("meihua-bu",100,100,1);
    set_xiuwei_by_type("dodge",600);
    setup();
    carry_object( __DIR__"obj/wuyun_xue" )->wear();
    carry_object( __DIR__"obj/jundao" )->wield();
    carry_object( __DIR__"obj/zhan_pao" )->wear();
}
