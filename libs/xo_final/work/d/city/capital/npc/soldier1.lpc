//汴京 Npc : soldier1.c  guarding......

inherit SOLDIER; 

#include "bianjing.h"
#include <ansi.h>

mapping fanhao = ([
CYN"侍卫步军司"RED"虎翼"   : 96,
CYN"侍卫步军司"RED"神卫"   : 30,
CYN"侍卫步军司"RED"振武"   : 10,
CYN"侍卫步军司"RED"宣毅"   : 10,
CYN"殿前司"RED"龙骑"   : 13,
CYN"殿前司"RED"捧日"   : 30,
CYN"殿前司"RED"拱圣"   : 22,
]);
string call_others(object who); 
void create()
{
    set_name(comm_man_name(), ({ "shi bing", "bing","soldier" }));
    set("age", 18 + random (30) );
    set("combat_exp", 8000);
    set("talk_msg",({
        "当今之世，蕃戎内侵，边事不断，不知道哪一天我就会被派到西北前线去送了性命，唉！\n",
        "一个月才发四百文，够干什么的呢？\n", 
    }));
    set("chat_chance_combat", 10);
    set("chat_msg_combat", ({
        (: call_others :),
    }));                    
    set_wugong("qiang",100,100);
    set_wugong("jinjun-qiangfa",50,50,1);
    set_xiuwei_by_type("long", 250 );
    set_wugong("taizu-quan",70,70,1);
    set_xiuwei_by_type("unarmed", 300);
    set_wugong("qinggong",100,100,1);
    set_xiuwei_by_type("dodge",300);
    setup();
    SetTitle();
    carry_object( __DIR__"obj/tieqiang" )->wield();
    carry_object( __DIR__"obj/junfu" )->wear();
    carry_object( __DIR__"obj/guangming_jia" )->wear();
    carry_object( __DIR__"obj/junxue" )->wear();
    carry_object( __DIR__"obj/shutie_toukui")->wear();
}
void SetTitle()
{
    int n;
    string loca,*key;
    //设定title
    loca = this_object()->query("startroom");
    if( loca == BIANJING_DIR "bingying_men1" )
    {
        set("title",CYN"殿前司"RED"天武第七军"YEL"第" + chinese_number( random(8)
        + 1 ) +"营"NOR"士兵"); 
        set("long", "    一名殿前司的禁军士兵，驻守京师。但见他全副武装；\n"+
                "脸上左颊刺有黑色纹记「天武」二字。\n");
        return;
    }
    else if( loca == BIANJING_DIR "bingying_men2" )
    {
        set("title",CYN "殿前司"RED"神勇"YEL"第"+chinese_number(random(14)+1) + "营"NOR"士兵");
        set("long", "    一名殿前司的禁军士兵，驻守京师。但见他全副武装；\n"+
                "脸上左颊刺有黑色纹记「神勇」二字。\n");
        return;
    }
    else if( loca == BIANJING_DIR "bingying_men3" )
    {
        set("title",CYN "侍卫亲军步军司"RED"神卫"YEL"第"+chinese_number( random(30) + 1 ) + "营"NOR"士兵");
        set("long", "    一名侍卫步军司的禁军士兵，驻守京师。但见他全副武装；\n"+
                "脸上左颊刺有黑色纹记「神卫」二字。\n");
        return;
    }
    else if( loca == BIANJING_DIR "bingying_men4" )
    {
        set("title",CYN "侍卫亲军步军司"RED"虎翼"YEL"第"+chinese_number( random(
90) + 1 ) + "营"NOR"士兵");
        set("long", "    一名侍卫步军司的禁军士兵，驻守京师。但见他全副武装；\n"+
                "脸上左颊刺有黑色纹记「虎翼」二字。\n");
        return;
    }
    
    else 
    {
        key = keys( fanhao );
        n = random( sizeof( key ) );
        set("title",key[ n ]+YEL"第"+chinese_number( random(
fanhao[ key[ n ] ] ) + 1 ) + "营"NOR"士兵");
        set("long", "    一名禁军士兵，驻守京师。但见他全副武装；\n"
+
                "脸上左颊刺有黑色纹记。\n");
        return;
    }
} 
