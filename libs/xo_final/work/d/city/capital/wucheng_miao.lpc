#include "bianjing.h"
inherit BROOM;
void create() {
  set("short", RED "武成王庙" NOR);
  set("long", @LONG
唐开元十九年，诏建太公尚父庙，祭奉姜太公，肃宗时始封其为“武成王”
。大殿正中供有贴金青铜武成王坐像，留候张良为配；左侧依次为武安君白起，
淮阴候韩信，武候诸葛亮和唐李靖，李勋；右侧为张良，田穰且，孙武，吴起，
乐毅。两壁墙上绘有范蠡等六十四名将，庄严肃穆。
LONG
  );
  set("objects", ([
    __DIR__ "npc/keeper": 1,
  ]));
  set("exits", ([
    "north": __DIR__ "leijia_qiao",
  ]));
  set("detail", ([
  ]));
  setup();
}
