#include <room.h>
#include <ansi.h>
#include "bianjing.h"
inherit BROOM;
void create() {
  set("short", CYN "水心殿" NOR);
  set("long", @LONG
这是一座很有特色的圆形建筑物。当中是一间二层重檐攒尖大殿，有殿额题
曰：
LONG HIY @TEXT
                         水  心  殿
TEXT NOR @AAAA
是太祖御笔。四面是一圈圆形的回廊，东西南北四方各有一间重檐厅门，飞流彩
绘，朱栏青瓦。四门各有一道联廊直通中央的大殿。
AAAA);
  set("exits", ([
    "out": __DIR__ "jinming_dao",
  ]));
  setup();
}
