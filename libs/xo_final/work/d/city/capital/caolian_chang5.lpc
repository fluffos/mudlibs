#include "bianjing.h"
inherit BROOM;
void create()
{
    set("short",YEL "操练场" NOR );
    set("long", @LONG            
好大的一个操练广场，脚下是踏实的黄土，四面皆是营房。每天早晨军中士
兵要在这里轮班操练一到两个时辰。余下的时间就都归其自由支配了。久居繁华，
人心生变，向往富贵生平，甚至做小买卖的也大有人在。
LONG
    );
    set("objects", ([ 
        __DIR__"npc/soldier3" : 4,
    ]));
    set("location",([
        "meihua-zhuang" : 2,
    ]));
    set("exits", ([    
	    "south" : __DIR__"bingying_men2",
    	"north" : __DIR__"caolian_chang6",
        "east"  : __DIR__"yingfang7",
        "west"  : __DIR__"caolian_chang8",
    ]));
    set("detail",([
    ]));     
    set("outdoors","capital");
    setup();
}
