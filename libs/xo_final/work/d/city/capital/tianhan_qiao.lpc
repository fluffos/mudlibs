// 汴京   zhou_qiao.c
#include <room.h>
#include <ansi.h>
#include "bianjing.h"
inherit STREET;
void create() {
  set("short", HIW "州桥" NOR);
  set("long", @LONG
州桥正名“天汉桥”，正对着宣德楼南的御路，是天街上第一处桥梁。桥身
宽阔，以青石为之；石梁，石笋，栏杆及近桥两岸皆是石壁，雕镌海马，水兽，
飞云之状。桥下石柱紧密排列，桥面平缓，石洞低矮，一般客船等均无法通行。
只有一种汴河里专用的扁舟可以通过。跨过州桥，御路偏转向东
LONG
  );
  set("objects", ([
  ]));
  set("exits", ([
    "north": __DIR__ "yujie4",
    "southeast": __DIR__ "yujie5",
    "west": __DIR__ "junyi_qiao",
  ]));
  set("detail", ([
  ]));
  setup();
}
