// 汴京  fengqiumen_jie2.c
#include <room.h>
#include <ansi.h>
#include "bianjing.h"
inherit STREET;
void create() {
  set("short", HIW "新封丘门里街" NOR);
  set("long", @LONG              
新封丘门里的大街与天汉桥东西御路，并为城中街道之最宽。至安远门间数
里之地，两旁皆是天武，捧日，拱圣，龙卫，神卫，骁骑，虎翼等禁军各军营地。
兵营大门皆有士兵把守，练武之声不断。
LONG
  );
  set("objects", ([
  ]));
  set("exits", ([
    "south": __DIR__ "fengqiumen_jie3",
    "east": __DIR__ "bingying_men1",
    "west": __DIR__ "bingying_men2",
    "north": __DIR__ "fengqiumen_jie1",
  ]));
  set("detail", ([
  ]));
  set("outdoors", "capital");
  setup();
}
int valid_leave(object me, string dir) {
  if (dir != "north")
    return ::valid_leave(me, dir);
  if (me->query("class") == "soldier" || me->query("class") == "governmen
t")
    return ::valid_leave(me, dir);
  if (!objectp(present("shi bing", environment(me))))
    return ::valid_leave(me, dir);
  else {
    message_vision("守门的士兵拦住$N喝道：“里面是禁军兵营，你乱闯什么！！”
\n", me);
    return notify_fail("守门士兵拦住了你的去路。\n");
  }
}
