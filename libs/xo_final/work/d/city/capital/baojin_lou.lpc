// 汴京     /d/city/capital/baojin_lou.c
#include <room.h>
#include <ansi.h>
#include "bianjing.h"
inherit BROOM;
void create()
{
  set("short",RED "                          宝津楼" NOR);
  set("long",@LONG
宝津楼建在一座高二十余丈，宽百丈的高台上，楼高三层，有插天之势，面
阔九间，重檐歇山屋顶全用琉璃瓦覆盖。二楼正中虚设着御驾龙座。南面有一道
游廊，下高台直通宴殿前。
LONG GRN @TEXT
    登高远望，四面皆为秀水环抱，金明池水碧波荡漾，龙舟御坊金壁辉煌；东
面，越过雄伟的城墙，京师繁华秀丽的景色尽收眼底
TEXT NOR);
  set("exits",([
    "southdown"  : __DIR__"yandian",
  ]));
  setup();
}
