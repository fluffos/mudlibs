inherit ROOM;

void create() {
  set("short", "仁和车行兰州分号");
  set("long", @LONG
仁和车行的兰州分号。仁和车行本来没有什么名气，只是东京城的一家
普通车行而已。然而当大宋和西夏签订了盟约后，这家车行的老板抓住时机
开办了东京到兰州的租车业务，由于近来边境平静无事，大宋和西夏的交易
愈加繁荣，乘坐这家车行的客人也大大增加，仁和车行竟一跃成为全国数一
数二的大车行，在所有的主要城市都建立了分号。
LONG
  );
  set("exits", ([
    "east": __DIR__ "nanmen",    //兰州南门
  ]));
  set("objects", ([
    __DIR__ "npc/laogan": 1,      //管马车的老甘  
  ]));

  setup();
}

int valid_leave(object ppl, string dir) {
  if (ppl->query_temp_marks("booked_mache"))
    return notify_fail("你应该快上马车了，不要再随便跑开。\n");
  if (ppl->query_temp_marks("waiting_mache"))
    return notify_fail("你正在等马车呢，不要随便走开。\n");
  return ::valid_leave(ppl, dir);
}
