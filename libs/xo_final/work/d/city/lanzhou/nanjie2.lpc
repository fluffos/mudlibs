inherit ROOM;

void create()
{
    set( "short", "南大街" );
    set( "long", @LONG
脚下是青石铺成的路面，整齐干净，不时有行人从身边擦肩而过。北面是个
热闹的集市，路东有个铺子，门首招牌上画着一柄斧头，一把剪子，铺子里传来
叮叮当当的响声。西边是一条静谧的小街，街当中有口水井。向南一直走，就到
南门了。
LONG
    );
    set( "outdoors", "lanzhou" );
    set( "exits", ([
        "north"     :   __DIR__"nanjie1",   //南大街
        "south"     :   __DIR__"nanmen",    //兰州南门
        "east"      :   __DIR__"tiepu",     //铁铺
        "west"      :   __DIR__"xiaoxiang", //小巷
    ]) );
    set( "objects", ([
        __DIR__"npc/dog"        :   1,      //癞皮狗
    ]) );

    setup();
}
