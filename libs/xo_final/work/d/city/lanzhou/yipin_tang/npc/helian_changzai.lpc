// /d/city/lanzhou/yipin_tang/npc/helian_changzai.c 一品堂的情报站站长－－赫连长在
// By lala 1997/09/13

inherit NPC;

void create() {
  set_name("赫连长在", ({ "helian changzai", "changzai" }));
  set("long", "一位身材高大、满面络腮胡须的汉子，看起来不象是汉人。\n");
  set("gender", "男性");
  set("title", "兰州城里的神秘人物");
  set("age", 43);
  set("attitude", "friendly");
  setup();
  carry_object(CLONE_DIR "wear/cloth/cloth5");
}

int refuse_killing(object me) {
  message_vision(
    "$N狡黠地一笑，摇头道：“不不，您是我们的客人啊，我们怎么能和客人动手呢？”\n" +
    "说罢扳动机关，一块翻板转动，$n就身不由己地落了下去。\n\n", this_object(), me);
  me->move("/d/city/lanzhou/yipin_tang/andao");
  return 1;
}

void init() {
  object me = this_player();
  add_action("do_nod", "nod");
  add_action("do_shake", "shake");
  remove_call_out("ask_you");
  call_out("ask_you", 2, me);
}

void ask_you(object me) {
  command("bow " + me->query("id"));
  command("say 这位" + RANK_D->query_respect(me) + "，\n" + @LONG
当今天下五国并立，大宋北有强辽、南有大理、西有吐蕃和大夏，
正是所谓大丈夫立功名之时日。然则大宋积弱，不思进取，无以
为天下之共主；北辽素为强蛮，性粗野，好杀掠，倘若为天下主，
恐非苍生之福；吐蕃地处荒凉，发服皆不同与中国，若为天下主，
则必令中国变发易服，非黎庶之所愿也；至若大理一国，国小民
少，无能为天下主。唯有大夏，天纵圣明、励精图治、国富民强、
政通人和，且其习与中国相近，足以为天下主也。足下何不借此
良机投效大夏，进可以建功立业、出将入相，退可仗剑横行、名
镇江湖，且大夏皇帝特设“一品堂”以待天下豪杰，名剑、黄金、
美女、秘籍无一不备；足下可有意乎？
LONG);
  me->set_temp("pending/一品堂/can_shake_&_nod", 1);
  remove_call_out("byebye");
  call_out("byebye", 60, me);
}

void byebye(object me) {
  if (!me || environment(me) != environment())
    return;
  command("say 既然足下还没有考虑好，那么我也不勉强，\n" +
    "今天之事还望足下保守秘密，大家方便，如何？\n");
  command("say 送客！");
  remove_call_out("kill_him");
  call_out("kill_him", 20 + random(10), me);
  me->move("/d/city/lanzhou/zhaimen");
  message_vision("那个仆人把$N送出来，然后又仔细的插好了门。\n", me);
}

int do_nod() {
  object me = this_player();

  if (environment(me) != environment())
    return 0;
  if (!me->query_temp("pending/一品堂/can_shake_&_nod"))
    return 0;
  remove_call_out("after_nod");
  call_out("after_nod", 1, me);
  return 0;
}

void after_nod(object me) {
  object obj;

  me->delete_temp("pending/一品堂/can_shake_&_nod");
  command("bigman " + me->query("id"));
  obj = new(__DIR__ "obj/letter");
  if (me->query_temp("yipin/fazhan_ren") != 0)
    obj->set("持信人", me->query("id"));
  else
    obj->set("持信人", "奸细");
  obj->move(me);
  command("say 好。这有一封书信。你持此信可直去兴庆府一品堂总堂。\n");
  command("say 然后将此信交给赫连云鹰将军！。\n");
  command("say 时候不等人，你这就出发罢。\n");
  command("say 来人！送客！\n");
  if (!me->query_temp("yipin/fazhan_ren")) {
    remove_call_out("kill_him");
    call_out("kill_him", 20 + random(10), me);
  }
  remove_call_out("byebye");
  me->move("/d/city/lanzhou/zhaimen");
  message_vision("那个仆人把$N送出来，然后又仔细的插好了门。\n", me);
}

int do_shake() {
  object me = this_player();

  if (environment(me) != environment())
    return 0;
  if (!me->query_temp("pending/一品堂/can_shake_&_nod"))
    return 0;
  remove_call_out("after_shake");
  call_out("after_shake", 1, me);
  return 0;
}

void after_shake(object me) {
  me->delete_temp("pending/一品堂/can_shake_&_nod");
  me->set("yipin/refuse_join", 1);
  command("hehe " + me->query("id"));
  command("say 也罢，人各有志，不能强求。");
  command("say 大路朝天，各走一边。您请便吧！");
  remove_call_out("byebye");
  remove_call_out("kill_him");
  call_out("kill_him", 20 + random(10), me);
  me->move("/d/city/lanzhou/zhaimen");
  message_vision("那个仆人把$N送出来，然后又仔细的插好了门。\n", me);
}

void kill_him(object me) {
  object there = environment(me);
  object obj;

  if (!there) return;

  obj = new(__DIR__ "killer");
  obj->move(there);
  obj->set_leader(me);
  obj->set("is_following", 1);
}
