//  By Lin
//  Changed by Lala, 1998-03-20

inherit ROOM;

void create()
{
    set( "short", "泰仁堂" );
    set( "long", @LONG
药铺不大，却异常的整洁；正面是柜台，柜台后面是个大柜子(gui zi)，几
百个小抽屉上一一用红纸标着药材的名称；靠近屋顶的墙上悬着一块黑底金字的
匾额，写着“妙手回春”。地下几个伙计正在分拣刚刚收购来的草药。东边一张
小矮桌儿，上面放着笔墨纸砚，桌后坐着一位老郎中。一股刺鼻药味充满了整个
房间。
LONG
    );
    set( "item_desc", ([
        "柜子"      :   "柜子上用红纸标着药名。仔细看，原来都是一味味的草药\n"
                        + "却没有成药的名字。\n",
        "gui zi"    :   "柜子上用红纸标着药名。仔细看，原来都是一味味的草药\n"
                        + "却没有成药的名字。\n",
        "guizi"     :   "柜子上用红纸标着药名。仔细看，原来都是一味味的草药\n"
                        + "却没有成药的名字。\n",
    ]) );
    set( "exits", ([
        "south"     :   __DIR__"xijie1",    //西大街
    ]) );
    set( "objects", ([
        __DIR__"npc/doctor"     :   1,      //王君效
        __DIR__"npc/xiaoxia"    :   1,      //小霞
    ]) );

    setup();
}

