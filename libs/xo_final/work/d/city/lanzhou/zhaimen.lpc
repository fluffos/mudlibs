//  一品堂在兰州的情报站的大门  /d/city/lanzhou/zhaimen.c
//  By Lin
//  Changed by Lala, 1998-03-20

inherit ROOM;

void create()
{
    set( "short", "深宅大门" );
    set( "long", @LONG
这家大院不知是属于哪一个富商大贾的。朱漆大门紧闭，上面的红漆似乎刚
刚刷过；门上的铜钉崭新发亮。墙高足有一丈，上面谱着黑瓦。小巷里静悄悄的
看不见一个人影。小巷当中有一口水井，井台上覆满青苔，辘轮已经腐朽，显然
是年代久远的东西了。
    东面穿过一条小巷通向大街。
LONG
    );
    set( "outdoors", "lanzhou" );
    set( "exits", ([
        "southeast" :   __DIR__"xiaoxiang", //小巷
        "down"      :   __DIR__"yipin_tang/jing",       //一品堂的井
    ]) );
    set( "resource/water", 1 );             //有水源
    set( "fillplace", "井" );               //水源名称：井
    set( "search_things", ([
        "井台"      :   BOOK_DIR + "qishang-quan",      //搜索的物品：七伤拳谱
    ]) );

    setup();
}

void init()
{
    add_action( "do_knock", "knock" );      //敲门的动作。
    add_action( "do_pull", "pull" );        //拉人的动作。
}

int do_knock( string arg )                  //敲门的动作。
{                                           //arg：敲的对象。
    object npc, ppl = this_player();
    object here = this_object();

    if ( !arg
     || arg != "gate" )
        return notify_fail( "你要敲什么啊？\n" );
    if ( !ppl->can_act() )
        return notify_fail( "你正忙着呢，没有办法来敲门！\n" );
    if ( present( "pu ren", here ) )
        return notify_fail( "这不是有人吗？还敲什么门？好玩啊？！\n" );
    if ( query_temp( "is_waiting" ) )
        return notify_fail( "不管怎么敲，也没有人来开门。\n" );
    message_vision( "$N举起手来，在门上拍了几下。\n" +
        "不一会儿，里面就传来了开启大门的声音。一位" +
        "仆役模样的人走出来，\n" + "他看着$N说道：“这位" 
        + RANK_D->query_respect( ppl ) + "有什么事情？”\n", ppl );
    npc = new( __DIR__"yipin_tang/npc/puren" );         //仆人出来开门
    npc->move( here );
    remove_call_out( "go_back" );
    call_out( "go_back", 10 );
    return 1;
}

void go_back()
{
    object npc, here = this_object();
    
    if ( npc = present( "pu ren", here ) )
    {
        tell_room( here, "那仆人站了这一会，见没有什么动静，有些奇怪，"
            + "摇摇头回去了。\n" );
        destruct( npc );
    }
    return;
}

int do_pull( string arg )                   //拉的动作函数。
{                                           //arg：拉的对象。
    object ppl = this_player();
    object who, there;
   
    if ( !there =find_object( __DIR__"yipin_tang/jing" ) )
        there = load_object( __DIR__"yipin_tang/jing" );
    if ( !arg 
        || arg =="" )
        return notify_fail( "你要拉谁啊？\n" );
    if( !who = present( arg, there ) )
        return notify_fail( "井里面并没有这个人要你来拉啊。\n" );
    if( ppl->query("sen") < 50 )            //要消耗50点的体能来拉一个人出来。
        return notify_fail( "你现在力气不足，无法把" 
            + who->query("name") + "拉上来。\n" );
    message_vision( "$N把一根长绳垂下井去用力拉，把$n从井里面拉了出来。\n", 
        ppl, who );                 
    message_vision( "从井口垂下一根长绳，$N看准机会，纵身一跃抓住长绳，\n" 
        + "上面的人用力一拉，把$N拉了上去。\n", who );
    who->move( this_object() );
    ppl->add( "sen", -50 );
    return 1;
}        

int valid_leave( object ppl, string dir )   //不许跳井。
{
    if( dir == "down" )
        return notify_fail( "你要跳井自杀？！生命可贵，不要轻生！\n" );
    return ::valid_leave( ppl, dir );
}            
