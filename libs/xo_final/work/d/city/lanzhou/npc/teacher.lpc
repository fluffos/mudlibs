//  范积古：教书先生    /d/city/lanzhou/npc/teacher.c
//  等级：
//  【巳等】小门派的弟子，江湖闲汉
//          零级修为（      ０－  １００）一级武功（    ０－  ６０）
//          经验（        ０－  ７５００）声望（          ０－         ７５）
//  By lin
//  Changed by lala, 1998-03-29

inherit NPC;
inherit F_MASTER;

void create()
{
    set_name( "范积古", ({ "fan jigu", "fan", "jigu", "fanjigu", "teacher" }) );
    set( "title", "私塾先生" );
    set( "gender", "男性" );                //性别：男
    set( "age", 69 );                       //年龄：69
    set( "attitude", "friendly" );          //态度：友善
    set( "positive_score", 75 );            //正声望：75
    set( "long", @LONG
    范积古在兰州也是颇有名气的一介老儒。他三十多年来一直在以教书为生。
不过这两年世风日下，加上他上了岁数，四邻的人家看他连走路都歪歪斜斜的样
子，越发不愿送孩子来读书了。
LONG
    );

    set_wugong( "unarmed",       20,     20,    1 );    //基本拳法：    一级

    set_wugong( "literate",      50,     50,    0 );    //读书识字

    set( "inquiry", ([
        "读书"      :   "读书乃是圣贤之道，学而优则仕是人生之大道也！",
    ]) );

    setup();
    carry_object( CLOTH_DIR + "mancloth1" )->wear();    //一般服装
}

void init()
{
    object ppl;

    ::init();

    add_action( "DoNod", "nod" );           //点头的动作。

    if ( !userp( ppl = this_player() ) 
        || !can_act() )
        return;
    remove_call_out( "Greeting" );
    call_out( "Greeting", 1, ppl );
}

void Greeting( object ppl )
{
    if ( ppl->query( "marks/范积古" ) == 1) //已经得到允许学功夫的标记。
        say( name() + "笑了笑，说：“你又来啦？真是好学。”\n" );
    else
        say( name() + "说道：“这位" + RANK_D->query_respect( ppl )
            + "找老朽，莫非是想讨教孔孟之道？”\n" );
}

int DoNod()
{    
    object ppl = this_player();

    if ( ppl->query_temp( "teacher/temp" )
        || ppl->query( "marks/范积古" ) )
        return 0;

    command( "say “如今世风日下，" + RANK_D->query_respect( ppl )
        + "若真心想学，老朽自当尽力。”" );
    ppl->set_temp( "teacher/temp", 1 );     //可以收钱了。
}

int valid_teach( object ppl, string skill )
{
    if ( !ppl->query( "marks/范积古" ) )
    {
        command( "say “咦？我不记得收过你这个学生啊……”" );
        return 0;
    }
    if ( skill != "literate" 
        || ppl->query_jibie( "literate" ) > 49 )
        return 0;
    return 1;
}

int accept_object( object ppl, object obj )
{
    if ( !ppl->query_temp( "teacher/temp" ) //没有标记不收钱
        || !obj->value() )
        return 0;

    if ( ppl->query( "marks/范积古" ) )     //已经答应了，可是还可以收钱。
    {
        command( "say “好，好，你既有这份心，老朽就收下了。”" );
        return 1;
    }
    if ( obj->value() < 1000 )             //不足一两白银
    {
        command( "say “你的诚意不够，这钱还是拿回去吧。”" );
        return 0;
    }
    ppl->set( "marks/范积古", 1 );          //以后就可以学了
    ppl->delete_temp( "teacher/temp" );     //把要钱的标记去掉
    command( "ok" );
    command( "say “既然是这样，老朽自当倾囊相授！”" );
    return 1;
}
