//  崔兴福：布庄老板，干活  /d/city/lanzhou/npc/tailor.c
//  等级：
//  【巳等】小门派的弟子，江湖闲汉
//          零级修为（      ０－  １００）一级武功（    ０－  ６０）
//          经验（        ０－  ７５００）声望（          ０－         ７５）
//  By lin
//  Changed by lala, 1998-03-29

inherit NPC;

#include <ansi.h>

string AskMe();

void create()
{
    set_name( "崔兴福", 
        ({ "cui xingfu","cui", "xingfu", "cuixingfu", "boss" }) );
    set( "title", YEL"布庄"GRN"老板"NOR );
    set( "gender", "男性" );                //性别：男
    set( "age", 42 );                       //年龄：42
    set( "str", 12);                        //臂力：12
    set( "attitude", "friendly" );          //态度：友善
    set( "long", @LONG
    崔老板看上去很是和气，一脸堆笑；不过听说他对待雇来的小姑娘可狠毒了。
LONG
    );

    set( "combat_exp", 500 );
    set("social_exp",1000);

    set_wugong( "unarmed",40,40,1);

    set( "inquiry", ([
        "here"      :   "这里是布店，有上好的绸缎。客官要不要看一看？",
        "小翠"      :   "客官说的什么，小的怎么不懂呀？抱歉抱歉。",
        "雇工"      :   "我这里有几个小姑娘在干活，怎么，没犯王法呀？",
        "work"      :   (: AskMe :),
        "工作"      :   (: AskMe :),
        "干活"      :   (: AskMe :),
    ]) );
    set( "talk_msg", ({
        "“城市里有不少干活(work)的地方，比如我这里就可以。你有兴趣吗？”",
    }) );

    setup();
    carry_object( CLOTH_DIR + "mancloth2" )->wear();    //高级服装
}

void init()
{
    object ppl;

    ::init();

    add_action( "DoWork", "work" );        //可以在这里工作。

    if ( !userp( ppl = this_player() ) 
        || !can_act() )
        return;
    remove_call_out( "Greeting" );
    call_out( "Greeting", 1, ppl );
}

void Greeting( object ppl )
{
    if ( !ppl 
        || environment( ppl ) != environment() ) 
        return;
    if ( ppl->query( "age" ) < 15 
        && ppl->query( "gender" ) == "女性"  )
        say( name() + "说：“小姑娘，要不要在我这里干活(work)呀？很轻松的，"
            + "工钱嘛，好说。”\n" );
    else
        message_vision( name() + "笑咪咪地说道：“这位$F，进来看看货吧。上好"
            + "的绸缎哪！”\n", ppl );
}

string AskMe()
{
    object ppl = this_player();

    if ( ppl->query( "gender" ) != "男性" )
      return( "要工作？好吧，干(work)一天２０文钱。" );
    return( "你要干活？好吧，去帮忙(work)搬东西。" );
}

int DoWork()
{
    object ppl = this_player();

    if ( ppl->query( "gin" ) < 90           //精力要在50以上，体能在55以上。
        || ppl->query( "sen" ) < 90 )
        return notify_fail( "你体力不够，不能干活。\n" );
     
    if ( ppl->query( "gender" ) == "女性" 
        && ppl->query( "age" ) < 20 )
        message_vision( "$N拿了一块绸缎，到一边绣了起来……\n", ppl );
    else
        message_vision( "$N走到一边，开始一趟一趟地搬布锭……\n", ppl );
    ppl->start_busy(40);
    ppl->disable_command( "verb", "你正在干活！" );
    remove_call_out( "Work" );
    call_out( "Work", 80, ppl );
    return 1;
}

int Work( object ppl )
{
object coin=new("/clone/money/silver");
 coin->set_amount( 1 );
    coin->move( ppl );
    message_vision( "$N结束了一天的工作，好累呀……\n", ppl );
    message_vision( "老板给了$N一些工钱。\n", ppl );
    ppl->enable_path();
    ppl->add( "gin", -90 );                 //精力损失50点；
    ppl->add( "sen", -90 );                 //体能损失55点；
    return 1;
}     
