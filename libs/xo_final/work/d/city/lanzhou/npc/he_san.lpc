//  何三：泼皮，和秘密有关  /d/city/lanzhou/npc/he_san.c
//  等级：
//  【巳等】小门派的弟子，江湖闲汉
//          零级修为（      ０－  １００）一级武功（    ０－  ６０）
//          经验（        ０－  ７５００）声望（          ０－         ７５）
//  By lin
//  Changed by lala, 1998-03-25

inherit NPC;

int AskMe();

void create() {
  set_name("何三", ({ "he san", "he", "hesan" }));
  set("title", "地痞");
  set("gender", "男性");                //性别：男
  set("age", 23);                       //年龄：23
  set("str", 25);                       //臂力：25
  set("per", 20);                       //容貌：20
  set("attitude", "heroism");           //态度：豪侠
  set("negative_score", 50);            //负声望：50
  set("long", @LONG
    这何三是个泼皮，专放重利债，在赌博场吃闲钱，专管打架吃酒。
LONG
  );

  set_wugong("unarmed", 50, 50, 1);    //基本拳法：    一级

  set_wugong("qinggong", 50, 50, 1);    //基本轻功：    一级

  set_xiuwei_by_type("unarmed", 70);  //拳脚修为：    零级
  set_xiuwei_by_type("dodge", 50);  //轻功修为：    零级

  set("combat_exp", 4000);              //战斗经验：4000

  set("talk_msg", ({
    "“看你挺结实的身子骨，帮我教训教训镖局那个李大傻子如何？”",
  }));
  set("inquiry", ([
    "金湘玉": (: AskMe :),
    "龙门客栈": "哼！那个破地方，老子再也不去了！躲晦气还来不及呢！",
    "here": "这儿是兰州城，没听说过吗？真笨！",
  ]));
  set("chat_chance", 8);
  set("chat_msg", ({
    "何三骂骂咧咧的说道：“龙门客栈的老板娘真不是好东西，老子欠债又不\n"
    + "是不能还了，竟敢把老子轰出来？！”\n",
    "何三哼道：“金湘玉那臭婊子成天就知道卖弄风骚，不知又和那个相好了。”"
    + "\n",
  }));

  setup();

  carry_object(CLOTH_DIR + "mancloth1")->wear();    //一般服装
  carry_object(FOOD_DIR + "gourou");     //红烧狗肉
  carry_object(LIQUID_DIR + "hulu");     //酒葫芦
}

int AskMe() {
  command("say “她神气什么？哼，别以为我不知道她 那点丑事儿。\n"
    "你想听听？嗯？嘿嘿……”");
  this_player()->set_temp("marks/何三", 1);         //玩家被作可以要钱的标
  //记。
  return 1;
}

int accept_object(object ppl, object obj) {
  if (ppl->query_temp("marks/何三") == 1)           //如果可以收钱，就收。
  {
    if (obj->value() >= 100)          //一百文以上
    {
      command("whisper " + ppl->query("id")
        + "“前两天，我还看见一个黑影，半夜里摸进她房里，嘿嘿～～”");
      ppl->delete_temp("marks/何三");
      return 1;
    }
    message_vision("$N冲$n瞪了瞪眼：“你当我是穷要饭的是不是？”\n",
      this_object(), ppl);
    ppl->delete_temp("marks/何三");
    return 0;
  }
  return 0;
}
