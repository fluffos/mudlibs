// common 士兵 by lin on March 4. 1997

#include <ansi.h>

inherit NPC;

void create() {
  int num = 1 + random(3);
  set_name(comm_man_name(), ({ "shi bing", "bing", "shibing", "soldier" }));
  set("title", YEL "殿前" RED "广勇" CYN + "右厢第" + chinese_number(num) +
    "军第" + chinese_number((num - 1) * 10 + random(10) + 1) + "指挥禁兵" NOR);
  set("age", 20 + random(30));
  set("gender", "男性");
  set("str", 40);
  set("con", 40);
  set("cor", 40);
  set("bellicosity", 500);
  set("long", @LONG
    一名从京城调来驻守西北前线的禁军士兵。但见他全副武装；脸上左颊刺有
黑色纹记「广勇」二字。
LONG
  );

  set_wugong("qiang", 90, 90, 1);
  set_wugong("jinjun-qiangfa", 80, random(40) + 40, 1);
  set_xiuwei_by_type("long", 100 + random(200));
  set_wugong("unarmed", 100, random(20) + 75);
  set_wugong("taizu-quan", 90, 40 + random(50), 1);
  set_xiuwei_by_type("unarmed", 100 + random(200));
  set_wugong("qinggong", 100, random(30) + 65, 1);
  set_xiuwei_by_type("dodge", 100 + random(100));

  setup();

  carry_object(SOLDIER_DIR + "tieqiang")->wield();
  carry_object(SOLDIER_DIR + "junfu")->wear();
  carry_object(SOLDIER_DIR + "guangming_jia")->wear();
  carry_object(SOLDIER_DIR + "junxue")->wear();
  carry_object(SOLDIER_DIR + "shutie_toukui")->wear();
}

int accept_fight(object me) {
  command("say 我看你今天是活得不耐烦了," + RANK_D->query_rude(me) + ",去死吧！\n");
  me->apply_condition("kill_lanzhou", 360);
  kill_ob(me);
  return 1;
}
