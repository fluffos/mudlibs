//  癞皮狗：野兽    /d/city/lanzhou/npc/dog.c
//  等级：
//  【巳等】小门派的弟子，江湖闲汉
//          零级修为（      ０－  １００）一级武功（    ０－  ６０）
//          经验（        ０－  ７５００）声望（          ０－         ７５）
//  By lin
//  Changed by lala, 1998-03-25

inherit NPC;

void create() {
  set_name("癞皮狗", ({ "laipi gou", "laipigou", "gou", "dog" }));
  set("race", "野兽");                  //种族：野兽
  set("gender", "雄性");                //性别：雄性
  set("age", 2);                        //年龄：2
  set("str", 24);                        //臂力：24
  set("cor", 26);                        //胆识：26
  set("long", @LONG
    一只浑身脏兮兮的癞皮狗。
LONG
  );
  set("limbs", ({ "头部", "身体", "前脚", "后脚", "尾巴" }));   //部位
  set("verbs", ({ "bite", "claw" }));   //动作：咬，抓
  set("chat_chance", 10);
  set("chat_msg", ({
    "癞皮狗用鼻子闻了闻你的脚。\n",
    "癞皮狗在你的脚边挨挨擦擦的，想讨东西吃。\n",
    "癞皮狗冲着路上的行人“汪～汪～～”乱叫。\n",
    "癞皮狗在跑到墙边，支起后腿撒尿。\n",
    "癞皮狗对著你摇了摇尾巴。\n",
    "癞皮狗用后腿抓了抓自己的耳朵。\n"
  }));

  set_temp("apply/attack", 14);         //增加攻击力
  set_temp("apply/armor", 5);           //增加防御力

  setup();
}

int accept_object(object ppl, object obj)  //如果有人给骨头则跟着走。
{
  if (obj->id("bone")) {
    set_leader(ppl);
    message_vision("$N高兴地汪汪叫了起来。\n", this_object());
    return 1;
  }
  return 0;
}
