//  濮正清：书坊老板，卖书  /d/city/lanzhou/npc/bookboss.c
//  等级：
//  【巳等】小门派的弟子，江湖闲汉
//          零级修为（      ０－  １００）一级武功（    ０－  ６０）
//          经验（        ０－  ７５００）声望（          ０－         ７５）
//  By lin
//  Changed by lala, 1998-03-25

inherit NPC;
inherit F_VENDOR;

#include <ansi.h>

void create()
{
    set_name( "濮正清", 
        ({ "pu zhengqing", "pu", "zhengqing", "puzhengqing", "boss" }) );
    set( "title", YEL"书坊"GRN"老板"NOR );
    set( "gender", "男性" );                //性别：男
    set( "age", 28 );                       //年龄：28
    set( "attitude", "friendly" );          //态度：友善
    set( "long", @LONG
    濮正清一看就是个读书人，他虽然功名未就，但卖书贩画为生，也颇为自得。
LONG
    );

    set( "inquiry", ([
        "书"        :   "我这里什么书都有，你想买什么？我还能修补旧书。",
        "here"      :   "这是我花了三百两银子买来的店铺。",  
        "史记"      :   "《史记》是一本非常好的历史书，五季纷争百年，可惜现\n"
                        + "在文不久存矣，唉……",
    ]) );
    set( "talk_msg", ({
        "“此地地处西北边陲，但好歹也是天朝之土，读读书，长些知识还是\n"
            + "必要的。”",
    }) );
    set( "chat_chance", 8 );
    set( "chat_msg", ({
        "老板手里拿着一把鸡毛掸子，轻轻掸去墙上，书架上的尘土。\n",
        "老板笑着问道：“买书？还是看看字画儿？”\n",
    }) );
    set( "vendor_goods", ([
        "《三字经》":   BOOK_DIR + "sanzi_jing",
        "《百家姓》":   BOOK_DIR + "baijia_xing",
    ]));
     
    setup();
      
    carry_object( CLOTH_DIR + "cloth3" )->wear();       //紫布长衫
}

void init()
{       
    ::init();

    add_action( "do_vendor_list", "list" );
}

int accept_object( object ppl, object obj )
{

    if ( ppl->query( "combat_exp" ) < 30000 ) //玩家经验不足30000无效            
        return 0;
    if ( (obj->query( "id" ) == "shi ji" )     //如果接受的是《史记》
        && ( !obj->query( "value" ) ) )
    {
        if ( !ppl->query_temp( "temp/shiji" ) )         //如果没有修补的记录
        {
            message_vision( "濮正清看了看书，对$N说道：“唔，这本书很不错嘛！"
                + "可惜破得不成样子了。”\n", ppl );
            message_vision( "濮正清想了想，接着说：“这样吧，我可以给你修补修"
                + "补，你给一两银子吧。”\n", ppl );
            ppl->set_temp( "temp/shiji", 1 );           //加要收钱的标记
            return 0;
        }
        if ( ppl->query_temp( "temp/shiji" ) == 2 )     //如果已经收了钱
        {
            message_vision( "濮正清接过书来，对$N说道：“请稍等，我马上就可以"
                + "修好。”\n", ppl );
            remove_call_out( "GiveBook" );    
            call_out( "GiveBook", 6, ppl, obj );
            ppl->delete_temp( "temp/shiji" );           //交易完成
            return 1;
        }
        return 0;                           //其他东西不收
    }
    if ( ( obj->value() >= 1000)            //如果该收钱，且钱足够
        && ( ppl->query_temp( "temp/shiji" ) == 1 ) )
    {
        message_vision( "濮正清看了看$N，说道：“那好吧，把书给我。”\n", 
            ppl );
        ppl->set_temp( "temp/shiji", 2 );
        remove_call_out( "Dest" );
        call_out( "Dest", 1, obj );
        return 1;
    }
    return 0;                               //除钱和《史记》不收。
}

int GiveBook( object ppl, object obj )     //把书交给玩家
{
    object book = new( __DIR__"obj/new_shiji" );
    
    book->move(ppl);
    destruct(obj);
    message_vision( "濮正清把一本修补好的《史记》交给$N，说：“好了，$F请收好"
        + "。”\n", ppl );
    return 1;
}

int Dest( object obj )                      //把钱删掉
{
    destruct( obj );
}
