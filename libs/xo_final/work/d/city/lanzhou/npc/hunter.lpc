//  猎户：出售山货  /d/city/lanzhou/npc/hunter.c
//  等级：
//  【巳等】小门派的弟子，江湖闲汉
//          零级修为（      ０－  １００）一级武功（    ０－  ６０）
//          经验（        ０－  ７５００）声望（          ０－         ７５）
//  By lin
//  Changed by lala, 1998-03-26

inherit NPC;
inherit F_VENDOR;

void create() {
  set_name("猎户", ({ "lie hu", "liehu", "hunter" }));
  set("gender", "男性");                //性别：男
  set("age", 35);                       //年龄：35
  set("long", @LONG
    这是个临近山上的猎户，时常来城里卖山货。
LONG
  );

  set_wugong("unarmed", 60, 60, 1);    //基本拳法：    一级

  set("combat_exp", 7500);              //战斗经验：7500

  set("talk_msg", ({
    "“出城向东南走四百多里才能到崆峒山呢，听说山上有神仙，也不知道\n"
    + "是不是真的。”",
  }));
  set("chat_chance", 15);
  set("chat_msg", ({
    "猎户大声吆喝：“卖山货嘞～～ ～～”\n",
  }));
  set("vendor_goods", ([
    "野山鸡": __DIR__ "obj/chicken",
    "狐狸皮": __DIR__ "obj/foxcloth",
    "皮背心": __DIR__ "obj/beixin",
  ]));
  setup();
  carry_object(CLOTH_DIR + "cloth2")->wear();        //粗布衣
}

void init() {
  object ppl;

  ::init();

  add_action("do_vendor_list", "list");

  if (!userp(ppl = this_player())
    || !can_act())
    return;
  remove_call_out("Greeting");
  call_out("Greeting", 1, ppl);
}

void Greeting(object ppl) {
  message_vision("猎户喊道：“这位$F，尝尝山货吧！”\n", ppl);
}
