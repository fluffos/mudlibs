inherit NPC;
int dest(object ob);
void create() {
  set_name("年青人", ({ "young man", "young", "man" }));
  set("gender", "男性");
  set("age", 23);
  set("per", 24);
  set("long", "     一个年纪轻轻，眉清目秀的后生，一看便知是个读书人.\n"
    "     只是身上穿戴颇为寒酸，面有菜色，显然是落魄难求生\n"
    "     计。 \n");
  set("attitude", "friendly");
  setup();
  carry_object(__DIR__ "obj/cloth2")->wear();
}
void init() {
  object ob;
  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 30, ob);
  }

}
void greeting(object ob) {
  say("  年青人可怜巴巴地向伙计求道：'行行好，就当我几十个钱吧？'\n"
    "  伙计大声斥责道：'几本破书烂纸也想骗钱？！当心我报了官，\n"
    "  将你拿进衙门里，一顿驮水棍打你个七荤八素！快滚！\n");
}
int accept_object(object who, object ob) {
  object shu;
  if (ob->value() >= 1000) {
    if (who->query("marks/年轻人")) {
      if (who->query_temp_marks("年轻人"))
        return 0;
      else {
        shu = new(__DIR__ "obj/shiji");
        who->set_temp_marks("年轻人", 1);
      }
    } else {
      if (who->query("age") > 15)
        return 0;
      shu = new(__DIR__ "obj/shiji_book");
      who->set("marks/年轻人", 1);
      LOG_D->do_log(who,
        "年轻的你在兰州镖局中求助了一个身无分文的年轻书生。");
    }
    say("年青人忍不住哽噎起来，说道：'在下流寓到此，谁知盘缠用尽，\n"
      "此地举目无亲，若无恩人相助......\n"
      "多谢" + RANK_D->query_respect(who) + ",只是读书人不可无端受人之物，在下\n"
      "的这几本书，原是指望细心研读，谁承想落到如此地步，竟欲以\n"
      "此当钱求生。恩人就将此书收下，留作纪念吧！\n"
      "年青人缓缓走出店门\n");
    shu->move(who);
    remove_call_out("dest");
    call_out("dest", 1, ob);
    return 1;
  } else {

    return 0;
  }
}
int dest(object ob) {
  destruct(ob);
  destruct(this_object());
}
