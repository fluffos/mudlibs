//  衙役：和夜猫子的秘密有关    /d/city/lanzhou/npc/yayi.c
//  等级：
//  【戊等】小门派的大弟子，大、中门派的一般弟子
//  ★
//  〖三级〗一级修为（  １０１－  １５０）一级武功（  ６０－１００）
//          经验（  ７５００－１５０００）声望（        ７５－       １５０）
//          内力（      ０－      ２００）体能、生命（  ２００－     ２５０）
//  By Lin
//  Changed Lala, 1998-03-28

#define LANZHOU_DIR "/d/city/lanzhou/"

#include <ansi.h>

inherit NPC;

void create()
{
    set_name( "衙役", ({ "ya yi", "yayi", "ya" }) );
    set( "age",  34 );
    set( "title", BLU"兰州"GRN"公差"NOR );
    set( "gender", "男性" );                //性别：男
    set( "age", 40 );                       //年龄：40
    set( "str", 40 );                       //臂力：40
    set( "positive_score", 150);            //正声望：150
    set( "negative_score", 150);            //负声望：150
    set( "attitude", "killer" );            //态度：嗜杀
    set( "bellicosity", 250 );              //杀气：250
    set( "long", @LONG
    这是一名在衙门里面做事的衙役，就是所谓“六扇门里的公人”，这些人的
脾气一般都不好，不要招惹他才是。
LONG
    );

    set_wugong( "blade",        100,    100,    1 );    //横刀六式：    一级

    set_wugong( "unarmed",      100,    100,    1 );    //基本拳法：    一级

    set_wugong( "qinggong",     100,    100,    1 );    //基本轻功：    一级

    set_xiuwei_by_type( "blade",    150 );  //刀法修为：    一级
    set_xiuwei_by_type( "unarmed",  150 );  //拳脚修为：    一级
    set_xiuwei_by_type( "dodge",    150 );  //轻功修为：    一级

    set( "max_force",   200 );              //内力：    200
    set( "force",       200 );
    set( "force_factor", 10 );              //加力：    10(5%)

    set_hp( "kee",      250 );              //生命：    250

    set( "combat_exp",  15000 );            //战斗经验：15000

    set( "env/attack",  80 );

    set( "chat_chance_combat",  10 );
    set( "chat_msg_combat", ({
        "衙役喝道：“大胆蟊贼！要造反不成！！”\n", 
        "衙役一边打一边叫骂：“反贼还不快快放下兵器就擒！”\n",
    }) );
    set( "chat_chance", 3 );
    set( "chat_msg", ({
        "衙役问道：“你有什么事？”\n", 
        "衙役喝道：“衙门重地，没事别老站在这儿！”\n", 
    }) );

    setup();
    carry_object( BLADE_DIR + "blade2" )->wield();      //单刀
    carry_object( CLOTH_DIR + "yayi_fu" )->wear();      //衙役服
    carry_object( BOOTS_DIR + "wuyun_xue" )->wear();    //乌云靴
}

void init()
{
    object ppl;

    ::init();

    if ( !userp( ppl = this_player() ) 
        || !can_act() )
        return;
    remove_call_out( "Greeting" );
    call_out( "Greeting", 1, ppl );
}

void Greeting( object ppl )
{
    if ( !ppl 
        || environment( ppl ) != environment() ) 
        return;
    if ( present( "yu ma", ppl ) )          //身上有羊脂玉马
    {
        message_vision( "衙役冲着$N喝道：“哈哈，原来你就是夜猫子！”\n", ppl );
        kill_ob( ppl );
        ppl->fight_ob( this_object() );
     }
}

int accept_fight( object ppl )
{
    command( "say “我看你今天是活得不耐烦了, "+ RANK_D->query_rude(ppl)
        + ", 去死吧！”" );
    say( RED"只听得衙役一声大喝：“杀死他！”\n"NOR );
    message_vision( RED"只见大门里冲出来很多捕快，个个持刀向$N砍下，"
        + "登时将$N砍翻在地！！\n"NOR, ppl );
    ppl->unconcious(); 
    ppl->move( LANZHOU_DIR + "dongchang" );  
    message_vision( "$N被一群衙役从衙门前踢了过来。\n", ppl );
    return 1;
}

int accept_bihua( object ppl )
{
    return accept_fight( ppl );
}

int accept_object( object ppl, object obj )
{
    int score;
    object gold;

    if ( obj->query( "id" ) != "ye maozi" ) //如果不是夜猫子就不要。
        return 0;
    if ( ppl->query( "marks/lin/送官" ) )     //如果已经送来过一个就揭
    {                                                   //发他／她。
        message_vision( "衙役看了看$N，疑惑地说：“你不是抓来过一个了么？”\n", 
            ppl );
        call_out( "Dest", 1, obj );
        return 1;
    }
    if ( query( "yemaozi" ) )               //如果身上已经有夜猫子，就杀他／她。
    {
        message_vision( "衙役冲着$N大喝道：“天下哪儿来的两个夜猫子？！"
            + RANK_D->query_rude( ppl ) + "竟敢欺骗老爷！”\n", ppl );
        kill_ob( ppl );
        ppl->fight_ob( this_object() );
        remove_call_out( "Dest" );
        call_out( "Dest", 1, obj );
        return 1;
    }

    if ( ppl->query( "mud_age" ) < 3600 * 24 * 2        //如果玩家年龄在十六以下
        && ppl->query( "combat_exp" ) < 10000           //或经验不足一万，
        && ppl->query( "max_force" ) < 300 )            //或内力不足三百，则否认
    {
        message_vision ( "衙役上下打量了$N许久，突然嘿嘿冷笑道：“哼！就凭你\n"
            + "这么点道行，也能抓住夜猫子？！说！你是不是夜猫子的同党！！”\n",
            ppl );
        kill_ob( ppl );
        ppl->fight_ob( this_object() );
        remove_call_out( "Dest" );
        call_out( "Dest", 1, obj );
        return 1;
    }
        
    message_vision( "衙役冲着$N笑了笑道：“很好，你既然为朝廷效力了一番，朝廷\n"
        + "自然不会亏待了你。”\n", ppl );
    call_out( "Dest", 1, obj );

    //下面是为朝廷卖力的后果，grin....——Lin
    ppl->add( "negative_score", 400 );      //负声望加四百
    score = ppl->query( "positive_score" );
    if ( score > 100 )
        ppl->add( "positive_score",  -100 );//正声望减一百
    else
        ppl->set( "positive_score", 0 );
    ppl->set( "marks_lin/kill_ye_maozi", 1 );           //这个标记给金湘玉；
    ppl->set( "marks/lin/送官" ,  1 );        //这个标记以后衙役检查；
    ppl->set( "marks/lin/兰州秘密A",  -1 );             //这个标记决定了以后不
                                                        //能和金学功夫；
    set( "yemaozi", 1 );                    //衙役记住今天已经收到过夜猫子了；
    gold = new( MONEY_DIR + "gold" );       //发金子了
    gold->set_amount( 20 );
    gold->move( ppl );
    remove_call_out( "Rumor" );
    call_out( "Rumor", 10, ppl );
    return 1;
}

void Dest( object obj )
{
       destruct( obj );
}

void Rumor( object ppl )
{
    switch( random( 10 ) )
    {
        case 0  :
            command( "rumor 有人把夜猫子交到官府，换了二十两金子！" );
            break;
        case 1  :
            command( "rumor " + ppl->name() 
                + "把夜猫子交到官府，换了二十两金子！" );
            break;
        default :
            break;
    }
}
