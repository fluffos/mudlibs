//  杂货郎：卖杂货  /d/city/lanzhou/npc/seller.c
//  等级：
//  【巳等】小门派的弟子，江湖闲汉
//          零级修为（      ０－  １００）一级武功（    ０－  ６０）
//          经验（        ０－  ７５００）声望（          ０－         ７５）
//  By lin
//  Changed by lala, 1998-03-29

inherit NPC;
inherit F_VENDOR;

void create() {
  set_name("杂货郎", ({ "zahuo lang", "lang", "zahuolang", "seller" }));
  set("gender", "男性");                //性别：男
  set("attitude", "friendly");          //态度：友善
  set("positive_score", 20);            //正声望：20
  set("long", @LONG
    一个走街串巷的杂货郎。
LONG
  );

  set("combat_exp", 1500);              //战斗经验：1500

  set("talk_msg", ({
    "“要出城吗？出城过黄河向东北走能到西夏的都城——兴庆府。”",
  }));
  set("chat_chance", 12);
  set("chat_msg", ({
    "杂货郎喊道：“便宜好用的杂货！～～～”\n",
  }));

  set("vendor_goods", ([
    "银簪子": HEAD_DIR + "yin_zanzi",
    "麻袋": MISC_DIR + "bag",
    "玉镯子": WRISTS_DIR + "yu_zhuozi",
    "清水葫芦": LIQUID_DIR + "hulu0",
    "火折子": MISC_DIR + "fire",
  ]));

  setup();

  carry_object(CLOTH_DIR + "mancloth1")->wear();    //一般服装
  add_money("coin", random(101) + 30);  //三十至一百三十文铜钱
}

void init() {
  object ppl;

  ::init();

  add_action("do_vendor_list", "list");

  if (!userp(ppl = this_player())
    || !can_act())
    return;
  remove_call_out("Greeting");
  call_out("Greeting", 1, ppl);
}

void Greeting(object ppl) {
  say("杂货郎喊道：“各种日用物事的卖喽，又便宜又好用哇！”\n");
}
