//  修补后的史记：解谜的报偿。  /d/city/lanzhou/npc/obj/new_shiji.c
//  By lin
//  Changed by lala, 1998-03-16

inherit ITEM;

void create() {
  set_name("史记", ({ "shi ji", "shiji", "book" }));
  set_weight(200);                      //四市两；    
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "卷");
    set("long", "一本经过修补装订的古书。\n");
    set("value", 1800);               //价格：(20*100)等级价值
    //-((40-20)*10)难度价值=1800总价值；
    set("material", "paper");         //质地：纸（无价值）
    set("skill", ([
      "name": "literate",  //技能的名称；
      "exp_required": 30000,      //学习该技能所要求的最少经验；
      "sen_cost": 20 + random(20),      //每次读书消耗的精力；
      "difficulty": 40,         //学这本书的基本悟性值；
      "max_lingwu": 100,        //学到的最高等级。
    ]));
  }
}
