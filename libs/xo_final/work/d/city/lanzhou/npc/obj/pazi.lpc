//  帕子：一品堂在兰州的联络记号    /d/city/lanzhou/npc/obj/pazi.c
//  By lala, 1998-03-16

inherit ITEM;

void create()
{
    set_name( "帕子", ({"pa zi", "pazi", "noserag" }) );
    set( "long", "一块丝质的帕子，上面写了些潦草的字迹，让人无法看清。\n" );
    set_weight( 25 );                       //半市两；
    if ( clonep() )
        set_default_object( __FILE__ );
    else 
    {
        set( "unit", "块" );
        set( "value", 10 );                 //价格：0.3*25丝绸价格=7.5总价值；
                                            //近似为10文；
        set( "material", "silk" );          //质地：丝绸（单价３００文／千克）
    }
    setup();
}
