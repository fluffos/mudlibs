//standard 长枪.c   edit by lin on March 3,  97
#include <weapon.h>
#include <ansi.h>
inherit QIANG;

void create() {
  set_name("长枪", ({ "qiang" }));
  set_weight(2500);
  set("long", "一根六尺余长的木杆长枪，枪头是纯钢打就，上面系着红樱。\n");
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "杆");
    set("value", 1000);
    set("material", "iron");
  }
  init_qiang(30);
  set("wield_msg", "$N紧紧握住手中的$n。\n");
  set("unwield_msg", "$N将手中的$n放下。\n");
  setup();
}
