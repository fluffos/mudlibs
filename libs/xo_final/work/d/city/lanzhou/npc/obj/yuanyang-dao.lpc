//  鸳鸯刀：金湘玉和夜猫子的信物    /d/city/lanzhou/npc/obj/yuanyang-dao.c
//  By lin on March 3,  97
//  Changed by lala, 1998-03-26

#include <weapon.h>
#include <ansi.h>

inherit BLADE;

void create()
{
	set_name( HIY"短刀"NOR, ({ "duan dao", "duandao", "dao", "blade"}) );
	set_weight( 1500 );                     //三市斤
    set( "long", "一把精光闪闪，一尺多长的短刀，刃闪青光，背显雕纹；看起来似"
            + "乎是一对鸳鸯刀中的一把。\n");

	if ( clonep() )
		set_default_object( __FILE__ );
	else
    {
		set( "unit", "把" );
        set( "value", 3725 );               //价格：(35*100)攻击力的价值
                                            //+150*1.5钢的价值=3725兵器的价值；

		set( "value", 2000 );
        set( "material", "steel" );         //质地：钢（单价１５０文／千克）；
	}
    init_blade( 35 );                       //攻击力：+35。

	set( "wield_msg", "$N「嗖」的一声抽出一把$n握在手中。\n" );
	set( "unwield_msg", "$N将手中的$n插入刀鞘。\n" );

	setup();
}
