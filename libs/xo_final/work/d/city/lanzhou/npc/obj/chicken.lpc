//  野鸡：猎户出售物，完成任务用。  /d/city/lanzhou/npc/obj/chicken.c

inherit ITEM;

void create() {
  set_name("野鸡", ({ "ye ji", "yeji", "chicken" }));
  set_weight(1500);                       //三市斤；
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "只");
    set("long", "一只风干的野鸡，可以用来作出美味的鸡羹。\n");
    set("value", 300);                //价格：300文。
  }
}
