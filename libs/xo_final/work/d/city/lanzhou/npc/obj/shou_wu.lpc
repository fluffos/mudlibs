// shouwu.c 何首乌
inherit ITEM;
void init()
{
        add_action("do_eat", "eat");
}
void create()
{
        set_name("何首乌", ({"shou wu", "wu"}));
        set("value", 8000);
        set("food_remaining", 5);
        set("food_supply", 20);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "片");
                set("long", "这是已经切成片的何首乌，黑黑的，也不知道是真是假。\n");
                set("value", 8000);
        }
        setup();
}
int do_eat(string arg)
{
        if (!id(arg))
        return notify_fail("你要吃什么？\n");
        this_player()->add("sen", 100);
        message_vision("$N吃下一片何首乌，顿时间觉得全身充满了活力 !\n", this_player());
        destruct(this_object());
        return 1;
}
