//  等级：
//  【戊等】小门派的大弟子，大、中门派的一般弟子
//  ★★
//  〖一级〗二级修为（  ３０１－  ４５０）二级武功（  ８０－１２０）
//          经验（      ３万－      ６万）声望（       ３００－      ６００）
//          内力（  ３００－      ６００）体能、生命（   ２７５－    ３５０）
//  By Qyz
//  Changed by lala, 1998-03-26

inherit RENHE;

void create() {
  set_name("老甘", ({ "lao gan", "laogan", "old", "gan" }));
  set("title", "仁和车行管事");
  set("gender", "男性");                //性别：男
  set("age", 56);                       //年龄：56
  set("location", "兰州");              //位置：兰州——车行专用
  set("attitude", "friendly");          //态度：友善
  set("positive_score", 320);           //正声望：320
  set("long", @LONG
    老甘是仁和车行里资格最老的人之一，当初仁和车行就靠他们辛勤苦干才
发展到今天的规模。
LONG
  );

  set_wugong("haofeng-quan", 80, 80, 1);    //浩风拳：      二级

  set_wugong("tianhong", 80, 80, 1);    //天虹步：      二级

  set_xiuwei_by_type("unarmed", 320);  //拳脚修为：    二级
  set_xiuwei_by_type("dodge", 320);  //轻功修为：    二级

  set("combat_exp", 30000);             //战斗经验：30000

  set("max_force", 6000);              //内力：    300
  set("force", 300);
  set("force_factor", 15);              //加力：    15(5%)

  set_hp("kee", 275);                   //生命、体能：  275
  set_hp("sen", 275);

  setup();

  carry_object(CLOTH_DIR + "mancloth1")->wear();    //一般服装
  add_money("coin", random(300));     //三百文以内的铜钱
}
int refuse_killing(object me) {
  if (me->query_temp("kill_renhe")) {
    command("chat* nokill " + me->query("id"));
    me->unconcious();
    me->move("/d/city/lanzhou/yipin_tang/jing");
  } else {
    me->set_temp("kill_renhe", 1);
    command("nokill " + me->query("id"));
  }
  return 1;
}
