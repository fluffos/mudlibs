//  说书人：闲人    /d/city/lanzhou/npc/talker.c
//  等级：
//  【巳等】小门派的弟子，江湖闲汉
//          零级修为（      ０－  １００）一级武功（    ０－  ６０）
//          经验（        ０－  ７５００）声望（          ０－         ７５）
//  By lin
//  Changed by lala, 1998-03-29

inherit NPC;

void create()
{
    set_name( "说书人", ({ "shuoshu ren", "shuoshuren", "ren", "talker" }) );
    set( "gender", "男性" );                //性别：男
    set( "age", 50 );                       //年龄：50
    set( "attitude", "friendly" );          //态度：友善
    set( "long", @LONG
    一个在街头广场上说书卖艺的老者，看起来很是健谈。
LONG
    );

    set( "talk_msg", ({
        "“路过城门的时候多注意注意官府的榜文，没准有好事。”",
        "“北城门每天天一黑就关，等到破晓才开。”",
        "“小孩子可以到城隍庙里去，有人给吃喝。”",
        "“听说布庄的崔老板在招小工干活呢。”",
        "“城里有个老头教人读书识字呢，年轻人还不去学学？有好处的。”",
        "“看看客栈和州府的留言板，也许有有用的东西。”",
        "“小巷里面有水井，渴了可以去喝水。”",
        "“兰州这个城不大，不过四百来户人家，可是光军队就驻了两三千人。”",
    }) );

    setup();
    carry_object( CLOTH_DIR + "mancloth1" )->wear();    //一般服装
}
