//  王君效：老医生  /d/city/lanzhou/npc/doctor.c
//  等级：
//  【巳等】小门派的弟子，江湖闲汉
//          零级修为（      ０－  １００）一级武功（    ０－  ６０）
//          经验（        ０－  ７５００）声望（          ０－         ７５）
//  By lin
//  Changed by lala, 1998-03-25

inherit NPC;
//inherit CHAR_D;

void create()
{
    set_name( "王君效", 
        ({ "wang junxiao", "wang", "wangjunxiao", "junxiao", "doctor" }) );
    set( "title", "老郎中" );
    set( "gender", "男性" );                //性别：男
    set( "age", 70 );                       //年龄：70
    set( "per", 25 );                       //容貌：25
    set( "attitude", "friendly" );          //态度：友善
    set( "positive_score", 1000 );          //正声望：1000
    set( "long", @LONG
    王老倌早年据说作过仁宗皇帝的御前太医，他生性清恬，仁宗皇帝驾崩后，
他谢绝了高官厚爵，带着孙女儿来到这西北边境，开业行医。他医术高超，且待
人热情，给穷人看病从来不收银子，所以颇受众人尊敬。
LONG
    );

    set( "no_kill", "lanzhou" );

    set( "inquiry", ([
        "玉灵散"    :   "玉灵散是救人性命的灵丹妙药，配制极难，老汉可不卖！",
    ]) );

    setup();
    
    carry_object( CLOTH_DIR + "cloth5" )->wear();       //紫绸长衫
}

int Dest( object obj )
{
    destruct( obj );
}

int accept_object( object ppl, object obj ) //收到纸条
{
    object yao = new( __DIR__"obj/yuling_san" );        //yao：玉灵散
    if ( obj->id( "bian tiao" ) ) 
    {
        say( "王太医皱了皱眉头。\n" ); 
        command( "say “既是这样，快去救人！”" );
        command( "say “这是药，快去吧。”" );   
        yao->move( ppl ); 
        call_out( "Dest", 1, obj );       
        return 1;
    }
    return 0;
}

int be_killed( object ppl )
{       
    message_vision( "王老倌大叫了一声：“为我报仇！”\n", ppl );
    ppl->set_temp( "marks_lin/kill_wang", 1 );          //玩家被作杀王的记号。
    ppl->set_marks( "lin/kill_wang", 1 );               //玩家被作杀死王的记
                                                        //号。
}

int refuse_killing( object ppl )
{
    object xia = present( "xiao xia", environment( ppl ) );     //xia：小霞

    ppl->set_temp( "marks_lin/kill_wang", 1 );          //玩家被作杀王的记号。
    if ( xia                                //如果有小霞，则参加战斗。
        && xia->can_act() )
    {
        message_vision( "$N先是一愣，赶忙迎上前来对$n喊道：“恶人！不许伤害我"
            + "爷爷！”\n", xia, ppl);
        xia->kill_ob( ppl );
        ppl->fight_ob( xia );
    }
    return 0;
}
