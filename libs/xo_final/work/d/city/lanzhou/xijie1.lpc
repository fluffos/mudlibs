inherit ROOM;

void create()
{
    set( "short", "西大街" );
    set( "long", @LONG
脚下是青石铺成的路面，整齐干净，不时有行人从身边擦肩而过。东面是广
场，有供坐骑休息吃草的马栏；北边是一家小小门面，正门上一块黑漆木匾，匾
上写着“泰仁堂”三个字，一股药香不断从门里飘出来；南面是一家大镖局，高
高的旗杆上，镖旗威武地随风飘扬。
LONG
    );
    set( "outdoors", "lanzhou" );
    set( "exits", ([
        "north"     :   __DIR__"yaopu",     //药铺
        "south"     :   __DIR__"biaoju/biaoju_men",//镖局大门
        "east"      :   __DIR__"guangchang",//中央广场
        "west"      :   __DIR__"xijie2",    //西大街
    ]) );
    set( "objects", ([
       NPC_DIR "beggar"         :   1,      //标准乞丐 
    ]) ); 

    setup();
}
