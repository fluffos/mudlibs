//  兰州南大街  /d/city/lanzhou/nanjie`.c
//  By lin
//  Changed by Lala, 1998-03-20

inherit ROOM;

void create() {
  set("short", "南大街");
  set("long", @LONG
这里是兰州城里最热闹的地方，每天上午都有集市，卖杂货的，日常用品的，
小孩玩具的，卖蔬菜粮食的，山珍野货的；一大早都聚集在这里高声叫卖，买东
西的人磨肩接踵，把一条大街挤得水泄不通；卖小吃的商贩甚至呆到半夜。路东
是本城的城煌殿，殿前空场上摆着大香炉，香火日夜不断；门前有个说书的。路
西是一家歌舞妓院，几名穿红戴绿的年轻女子在门前招引着行人。耳边各种各样
的叫卖声，嘻笑声，孩子啼哭声，讼经念佛声吵得人心烦意乱。
    北边是城中心的广场。
LONG
  );
  set("outdoors", "lanzhou");
  set("item_desc", ([
    "west": "一幢装饰得华丽异常的二层绣楼，楼上匾额上写着：\n"
    + "             群红夺彩   \n",
  ]));
  set("exits", ([
    "north": __DIR__ "guangchang",  //兰州广场
    "south": __DIR__ "nanjie2",   //南大街
    "east": __DIR__ "chenghuang_dian",       //城隍殿
    "west": __DIR__ "qunhong_yuan",          //群红院
  ]));
  set("objects", ([
    __DIR__ "npc/seller": 1,      //杂货贩
    __DIR__ "npc/hunter": 1,      //猎户   
    NPC_DIR + "beggar": 1,      //标准乞丐
  ]));

  setup();
}
