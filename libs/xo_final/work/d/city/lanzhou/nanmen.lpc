#define XIBEI_DIR   "/d/map/xibei/"

inherit ROOM;
#include "men.h"


void create() {
  set("short", "南门");
  set("long", @LONG
出南门，有一条大路穿过西北的田野直达关中。城门外，几队士兵在巡逻；
一些农民，猎户正背着要卖的东西进城；远处还有一些商旅在缓缓东行。城门两
边各贴着几张很大的榜文(bang wen)，一些人围着观看。城门上一条白底匾额上
写着“兰州”两个黑色的大字。
LONG
  );
  set("outdoors", "lanzhou");
  set("item_desc", ([
    "榜文": (: look_bangwen :),
    "bang wen": (: look_bangwen :),
    "bangwen": (: look_bangwen :),
  ]));
  set("exits", ([
    "east": XIBEI_DIR + "tuntian3",         //西北土路
    "north": __DIR__ "nanjie2",   //南大街
    "west": __DIR__ "renhe",     //仁和车行
  ]));
  set("objects", ([
    __DIR__ "npc/shibing": 2,      //士兵   
    __DIR__ "npc/xiaowei": 1,      //将虞侯
    "/d/place/wiz/polan": 1,
  ]));

  setup();
}
