inherit ROOM;

void create() {
  set("short", "客房");
  set("long", @LONG
客房打扫得干干净净，墙上挂着字画，桌子上摆着汝窑插瓶，青瓷茶壶，临
窗小几上摆着一盆蜡梅，冬天开花时香气四溢；床上铺着崭新的炕席，很是幽静
高雅。这里不但干净，而且安全，无人打扰。
LONG
  );
  set("sleep_room", "inn");
  set("exits", ([
    "south": __DIR__ "changyuan",  //龙门客栈场院
  ]));

  setup();
}
