//  趟子手：龙门镖局趟子手  /d/city/lanzhou/npc/fighter.c
//  等级：
//  【戊等】小门派的大弟子，大、中门派的一般弟子
inherit NPC;

void create()
{
    set_name( comm_man_name(), 
        ({ "tangzi shou", "tangzi shou", "shou", "fighter" }) );
    //set( "title","龙门镖局 趟子手" );
    JoinZuzhi("longmen", "趟子手", "");
    set("title", "龙门镖局 趟子手");
    set( "gender", "男性" );
    set( "age", 28 + random( 10 ) );
    set( "str", 25 );
    set( "positive_score", 150 );
    set( "long", @LONG
    一位正当壮年的黑脸汉子，身上的肌肉一块块凸起来，好不魁梧。
LONG
    );

    set_wugong( "unarmed", 100, 100, 0 );
    set_wugong( "taizu-quan", 100, 100, 1 );
    set_wugong( "jiben-qinggong", 100, 100, 1 );
    set_wugong( "blade", 100, 100, 0 );
    set_wugong( "ditang-dao", 100, 100, 1 );
    set_wugong( "haoran-zhengqi", 100, 100, 1 );

    set_xiuwei_level_by_type("unarmed", 1);
    set_xiuwei_level_by_type("blade", 1);
    set_xiuwei_level_by_type("dodge", 1);
    set_xiuwei_level_by_type("force", 1);

    set( "combat_exp", 13000 );

    set( "talk_msg", ({
        "“练武之人要能吃苦，吃得了苦才能练成好功夫！”",
        "“咱们总镖头的武功，不是天下第一也差不多。”",
    }) );

    setup();

    add_money( "coin", random( 10 ) );      //十文以内的铜钱。

    carry_object( BLADE_DIR + "blade1" )->wield();      //朴刀
    carry_object( CLOTH_DIR + "cloth2" )->wear();       //粗布衣
}

