#include <ansi.h>

inherit F_NEW_MASTER;

#include "biaoju_master.h"

string ask_me();
int ask_yunbiao();
int ask_leave();

void create()
{
    set_name( "秦天彪", 
        ({ "qin tianbiao", "qin", "qintianbiao", "tianbiao", "master" }) );
    //create_zuzhi( "龙门镖局", 1, "总镖头" );
    JoinZuzhi(my_zuzhi(), "总镖头", "");
    set( "title", HIW"龙门镖局总镖头"NOR );
    set( "nickname", CYN"关西第一刀"NOR );
    set( "gender", "男性" );
    set( "age", 52 );
    set( "str", 30 );
    set( "cor", 30 );
    set( "dex", 30 );
    set( "per", 22 );
    set( "int", 29 );
    set( "rank_info/respect", "老英雄" );
    set( "positive_score", 1000 );         
    set( "long", @LONG
    秦天彪少年时就生得异常魁梧，早年曾在少林寺当了很多年的俗家弟子，后
来又得高人相授，刀法和铁砂掌功夫都是相当了得。现在是龙门镖局的大当家。
LONG
    );

    set_wugong( "unarmed", 300, 300, 0 );
    set_wugong( "taizu-quan", 300, 300, 0 );
    set_wugong( "tiesha-zhang", 300, 300, 1 );

    set_wugong( "qinggong", 300, 300, 0 );
    set_wugong( "jiben-qinggong", 300, 300, 0 );
    set_wugong( "chusuifeng", 300, 300, 0 );
    set_wugong( "caiyun-gong", 300, 300, 1 );

    set_wugong( "blade", 300, 300, 0 );
    set_wugong( "fenglei-dao", 300, 300, 1 );

    set_wugong( "haoran-zhengqi", 300, 300, 1 );

    set_xiuwei_level_by_type("unarmed", 5);
    set_xiuwei_level_by_type("blade", 7);
    set_xiuwei_level_by_type("dodge", 5);
    set_xiuwei_level_by_type("force", 5);
    set_xiuwei_level_by_type("zonggang", 5);

    set( "combat_exp",  1000000 );
    set( "social_exp",   170000 );

    set( "talk_msg", ({
        "“这位英雄来我镖局有何贵干？”",
    }) );

    set("inquiry", ([
        "运镖" : (: ask_yunbiao :),
        "升职" : (: ask_me :),
        "离开" : (: ask_leave :),
    ]));

    set("no_quest", 1);
    set("no_public", 1);

    setup();

    carry_object( CLOTH_DIR + "cloth5" )->wear();
    carry_object( __DIR__ "obj/fenglei-dao" )->wield();
    add_money( "silver", 5 );
}

void init()
{
    object ppl;

    ::init();
    add_action( "do_nod", "nod" );

    if ( !userp( ppl = this_player() )
        || !can_act() )
    {
        return;
    }

    remove_call_out( "Greeting" );
    call_out( "Greeting", 1, ppl );
}

void Greeting( object ppl )
{       
    if( !ppl 
        || environment( ppl ) != environment() ) 
    {
        return;
    }

    command( "say “这位英雄来我镖局有何贵干？”" );
    command( "look "+ ppl->query( "id" ) );
}

int refuse_killing( object ppl )            //被杀时的反应
{
    object npc = this_object();

    if( !living( npc ) 
        || query_temp( "weapon" ) )
    {
        return 0;
    }

    message_vision( "$N看了$n一眼，冷笑道：“居然有你这么不知天高地厚的狂妄之"
        "徒，哼哼，待老夫今天好好收拾你！！\n", npc, ppl );
    if ( !npc->query_temp("weapon") )
    {
        new( __DIR__"obj/fenglei-dao")->move( npc );
        command( "wield blade" );
        return 1;
	}

	return 0;
}

int do_nod()
{
    object me = this_player();

    if ( me->query_temp( "pending/qin_leaving" ) )
    {
        me->delete_temp( "pending/qin_leaving" );
        //kickout_chengyuan(me);
        me->LeaveZuzhi(my_zuzhi());
        message_vision( "$N冲着秦天彪点点头，说道：我愿意离开龙门镖局。\n秦天彪叹了口气，说道：好吧。\n", me );
        return 1;
    }

    if ( !me->query_temp( "pending/qin_testing" ) )
    {
        return 0;
    }

    if ( me->query("gender") == "无性" )
    {
        command( "heng " + me->query( "id" ) );
        command( "say 本镖局岂能容下你这样的阉割之人。\n" );
        return 1;
    }

    me->delete_temp( "pending/qin_testing" );
    message_vision( "$N冲着秦天彪点点头，说道：我愿意投入龙门镖局。\n", me );
    message_vision( "秦天彪“哈哈”大笑，说道：好，好，既然你愿意，从今天起你就是我龙门镖局的人了。\n"
        "在镖局里规矩不多，\n"
        "       一 不和黑道上的人来往， 二 不要招惹官府。\n"
        "好了，现在你可以下去自己找镖头，镖师们学武去了。\n", me );

    //recruit_chengyuan( me, "镖师" );
    //me->set( "zuzhi/generation", 3 );
    me->JoinZuzhi(my_zuzhi(), "镖师", "");

    return 1;
}

int ask_yunbiao()
{
    object me = this_player();
    string title;

    if ( me->query_temp( "pending/qin_testing") )
    {
        write("我还在等你答复呢。\n");
        return 1;
    }

    if ( !me->IsMemberOf(my_zuzhi()) )
    {
        //提示加入镖局
        command( ":)" );
        command( "say " + RANK_D->query_respect(me) + "，如果你有心想入我派，就先在镖局学几年武，打好根基再说。" );
        command( "say 你可愿意？" );
        me->set_temp( "pending/qin_testing", 1 );
        write( "你如果愿意就点头(nod)。\n" );

        return 1;
    }

    //给任务
    return YUNBIAO_D->give_quest(this_object(), me);
}

int ask_leave()
{
    object me = this_player();

    if ( me->query_temp( "pending/qin_leaving") )
    {
        write("我还在等你答复呢。\n");
        return 1;
    }

    if ( !me->IsMemberOf(my_zuzhi()) )
    {
        command( "say 你没事别瞎问。" );
        return 1;
    }

    command( ":)" );
    command( "say " + RANK_D->query_respect(me) + "，如果你有心离开镖局，就nod。\n" );
    command( "say 你可愿意？\n" );
    me->set_temp( "pending/qin_leaving", 1 );
    write( "你如果愿意就点头(nod)。\n" );
    
    return 1;
}

string ask_me()
{
    object you = this_player();
    string defeat_master;

    if ( !you->IsMemberOf(my_zuzhi()) )
    {
        return "你不是我镖局弟子，来问我这些事情做什么？";
    }

    if ( you->query_xiuwei("dodge") < 10 )
    {
        return "你还是先练好基本功再说。";
    }

    if ( this_object()->ZuzhiTouxianJibie(my_zuzhi()) <= you->ZuzhiTouxianJibie(my_zuzhi()) + 1 )
    {
        return "怎么连我的位置你也有兴趣了？";
    }

    if ( defeat_master = you->query_temp( "qintianbiao/defeat_master" ) )
    {
        command( "nod " + you->query( "id" ) );
        command( "say 不错不错，短短几年，你就能够击败" + defeat_master + "了。" );

        you->IncreaseZuzhiTouxian(my_zuzhi(), 1);
        you->delete_temp( "qintianbiao/fight_master" );
        you->delete_temp( "qintianbiao/defeat_master" );
        return( "从今天起，你就是龙门镖局的新" + you->ZuzhiTouxian(my_zuzhi()) + "了！" );
    }

    if ( you->query_temp( "qintianbiao/fight_master" ) )
    {
        command( "angry " + you->query( "id" ) );
        return( "不是说让你去找" + ZUZHI_D->GetTouxian(my_zuzhi(), you->query_temp( "qintianbiao/fight_master" )) + "比划么？" );
    }

    you->set_temp( "qintianbiao/fight_master", you->ZuzhiTouxianJibie(my_zuzhi()) + 1 );
    return "你去找" + ZUZHI_D->GetTouxian(my_zuzhi(), you->ZuzhiTouxianJibie(my_zuzhi()) + 1) + "，让他们考验一下你的功夫吧！";
}

