//  朱算：兰州的奸细    /d/city/lanzhou/npc/zhusuan.c
//  等级：
//  【巳等】小门派的弟子，江湖闲汉
#include <ansi.h>

inherit NPC;

void create() {
  set_name("朱算", ({ "zhu suan", "zhusuan", "zhu", "sir" }));
  set("title", "帐房先生");
  create_family("龙门镖局", 3, "账房");
  set("gender", "男性");
  set("age", 56);
  set("attitude", "friendly");
  set("long", @LONG
    朱算来镖局已有十来年了。他心思敏捷，打得一手好算盘又颇懂经营之道，
这二年不但使镖局财源滚滚，还办起了其他行当的买卖。
LONG
  );

  set("chat_chance", 5);
  set("chat_msg", ({
    "朱算把算盘拨得“哗哗”响，嘴里不住念叨着什么。\n",
    "朱算说道：“什么时候我也能发笔财就好了！”\n",
  }));

  set_wugong("literate", 100, 100);
  setup();
  carry_object(CLOTH_DIR + "cloth5")->wear();
}
