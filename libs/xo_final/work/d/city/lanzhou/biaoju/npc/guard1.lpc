//  李镖头：龙门镖局镖师    /d/city/lanzhou/npc/guard1.c
//  等级：
//  【戊等】小门派的大弟子，大、中门派的一般弟子
inherit F_NEW_MASTER;

#include "biaoju_master.h"

void create() {
  set_name("李镖头",
    ({ "li biaotou", "biaotou", "li", "libiaotou", "guard" }));
  //set( "title", "龙门镖局镖头" );
  //create_zuzhi( "龙门镖局", 2, "镖头" );
  JoinZuzhi(my_zuzhi(), "镖头", "");
  set("title", "龙门镖局 镖头");
  set("gender", "男性");
  set("age", 35);
  set("per", 21);
  set("str", 30);
  set("int", 22 + random(12));
  set("positive_score", 500);

  set("long", @LONG
    李镖头正当旺年，身材魁梧，一身的肌肉练得块块凸起，似要爆裂开来。他
虽然武功不是很高，可是人很热情，要是你向他学功夫，他说不定会很高兴地教
你。
LONG
  );

  set_wugong("unarmed", 100, 100, 0);
  set_wugong("taizu-quan", 100, 100, 1);

  set_wugong("qinggong", 100, 100, 1);
  set_wugong("jiben-qinggong", 100, 100, 1);

  set_wugong("blade", 100, 100, 0);
  set_wugong("ditang-dao", 300, 300, 1);

  set_wugong("haoran-zhengqi", 100, 100, 1);

  set_xiuwei_level_by_type("unarmed", 2);
  set_xiuwei_level_by_type("blade", 2);
  set_xiuwei_level_by_type("dodge", 1);
  set_xiuwei_level_by_type("force", 1);
  set_xiuwei_level_by_type("zonggang", 1);

  set("combat_exp", 50000);
  set("social_exp", 5000);

  set("talk_msg", ({
    "“练武之人要能吃苦，吃得了苦才能练成好功夫！”",
    "“咱们总镖头的武功，不是天下第一也差不多。”",
  }));

  set("no_quest", 1);
  set("no_public", 1);

  setup();

  carry_object(BLADE_DIR + "blade2")->wield();      //单刀
  carry_object(CLOTH_DIR + "jinzhuang1")->wear();   //黑色劲装
}
