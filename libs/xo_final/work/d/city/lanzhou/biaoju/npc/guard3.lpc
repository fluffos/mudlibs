//  洪镖头：龙门镖局镖师    /d/city/lanzhou/npc/guard3.c
//  等级：
//  【丁等】大门派的三级师傅、中等门派的二级师傅、小门派的一级师傅
inherit F_NEW_MASTER;

#include "biaoju_master.h"

void create() {
  set_name("洪镖头",
    ({ "hong biaotou", "hongbiaotou", "biaotou", "hong", "guard" }));
  //set( "title", "龙门镖局镖头" );
  //create_zuzhi( "龙门镖局", 2, "镖头" );
  JoinZuzhi(my_zuzhi(), "镖头", "");
  set("title", "龙门镖局 镖头");

  set("gender", "男性");
  set("age", 50);
  set("per", 20);
  set("str", 30);
  set("cor", 30);
  set("positive_score", 5000);
  set("long", @LONG
    洪镖头擅长拳脚，精通暗器，是镖局里的第二号人物。
LONG
  );

  set_wugong("unarmed", 200, 200, 0);
  set_wugong("taizu-quan", 200, 200, 0);
  set_wugong("tiesha-zhang", 200, 200, 1);

  set_wugong("qinggong", 200, 200, 0);
  set_wugong("jiben-qinggong", 200, 200, 0);
  set_wugong("chusuifeng", 200, 200, 1);

  set_wugong("blade", 200, 200, 0);
  set_wugong("ditang-dao", 200, 200, 0);
  set_wugong("liuhe-dao", 200, 200, 0);
  set_wugong("wuhu-dao", 300, 300, 1);

  set_wugong("haoran-zhengqi", 200, 200, 1);

  set_xiuwei_level_by_type("unarmed", 3);
  set_xiuwei_level_by_type("blade", 4);
  set_xiuwei_level_by_type("dodge", 3);
  set_xiuwei_level_by_type("force", 4);
  set_xiuwei_level_by_type("zonggang", 4);

  set("combat_exp", 150000);
  set("social_exp", 50000);

  set("talk_msg", ({
    "“练武之人要能吃苦，吃得了苦才能练成好功夫！”",
    "“咱们总镖头的武功，不是天下第一也差不多。”",
  }));

  set("no_quest", 1);
  set("no_public", 1);

  setup();

  carry_object(CLOTH_DIR + "cloth4")->wear();
  carry_object(BOOK_DIR + "tiesha-zhang");

  add_money("silver", 1);
  add_money("coin", 230);
}
