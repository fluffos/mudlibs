//  汤镖头：龙门镖局镖师，有秘密    /d/city/lanzhou/npc/guard2.c
//  等级：
//  【丁等】大门派的三级师傅、中等门派的二级师傅、小门派的一级师傅
#include <ansi.h>

inherit F_NEW_MASTER;

#include "biaoju_master.h"

void create() {
  set_name("汤镖头",
    ({ "tang biaotou", "tangbiaotou", "biaotou", "tang", "guard" }));
  //set( "title", "龙门镖局镖头" );
  //create_zuzhi( "龙门镖局", 2, "镖头" );
  JoinZuzhi(my_zuzhi(), "镖头", "");
  set("title", "龙门镖局 镖头");
  set("gender", "男性");
  set("age", 38);
  set("per", 20);
  set("str", 28);
  set("positive_score", 500);
  set("negative_score", 3500);
  set("long", @LONG
    汤镖头中等身材，面色和气，从外表看不出有什么真功夫。
LONG
  );

  set_wugong("unarmed", 150, 150, 0);
  set_wugong("taizu-quan", 150, 150, 0);
  set_wugong("tiesha-zhang", 150, 150, 1);

  set_wugong("qinggong", 150, 150, 0);
  set_wugong("jiben-qinggong", 150, 150, 0);
  set_wugong("chusuifeng", 150, 150, 1);

  set_wugong("blade", 150, 150, 0);
  set_wugong("ditang-dao", 150, 150, 0);
  set_wugong("liuhe-dao", 300, 300, 1);

  set_wugong("haoran-zhengqi", 150, 150, 1);

  set_xiuwei_level_by_type("unarmed", 3);
  set_xiuwei_level_by_type("blade", 3);
  set_xiuwei_level_by_type("dodge", 3);
  set_xiuwei_level_by_type("force", 2);
  set_xiuwei_level_by_type("zonggang", 2);

  set("combat_exp", 100000);
  set("social_exp", 30000);

  set("no_quest", 1);
  set("no_public", 1);

  set("inquiry", ([
    "练武": "江湖险恶呀，我看你还是读读书，将来当官发财去得了。",
    "学功夫": "你向老李问问吧，他很有功夫教你的。",
    "总镖头": "秦大哥在西北还真是数一数二的，不过嘛……",
    "金湘玉": "……",
    "夜猫子": "夜猫子是本地有名的大盗，据说最近失了手，正被官府\n"
    + "通缉，还受了重伤呢。哼哼～～",
  ]));

  setup();

  carry_object(BLADE_DIR + "blade2")->wield();
  carry_object(CLOTH_DIR + "jinzhuang1")->wear();

  add_money("silver", 1);
  add_money("coin", 350);
}

int query_answer(object ppl) {
  object npc = this_object();
  int test = ppl->query("marks/lin/兰州秘密A");     //test：兰州秘密的步骤

  if (test > 3)                        //如果已经全部完成
  {
    command("fear");
    command("say “为了那个臭婆娘的事，你已经杀了我一次，难道还不够吗？！"
      + "”");
    return 1;
  }

  if (test == 3                          //如果正好应该问本NPC
  && !npc->query("been_asked")) {
    ppl->disable_command("verb", "你这件事还没有干完呢！\n");
    npc->set("been_asked", 1);
    command("say “你有事吗？”");
    command("look " + ppl->query("id"));
    call_out("GotoDie", 2, ppl, npc);
    return 1;
  }

  return 0;
}

int GotoDie(object ppl, object npc)      //汤镖头中计自寻死路。
{
  tell_object(ppl, GRN "你在" + name() + "的耳边说道：“ 金湘玉让我来跟你\n"
    + "说，你要想和她私下解决夜猫子的事，就跟我来。咱们商量商量条件。”"
    NOR);
  command("ok");
  message_vision("$N看了看$n，脸上流露出贪婪的表情。\n", npc, ppl);
  command("follow " + ppl->query("id"));
  ppl->set_temp("marks/lin/杀汤", 1);   //应该杀汤镖头了。
  ppl->enable_path();
  return 1;
}

int be_killed(object ppl)                 //被杀时的反应。
{
  object *inv;
  int i;

  if (ppl->query("marks/lin/兰州秘密A") != 3)       //如果不是该杀则无效。
  {
    return 0;
  }

  tell_object(ppl, "嘻嘻～～\n");
  if (!ppl->query_temp("marks/lin/杀汤"))  //如果不是骗出来的汤镖头，则无效。        
  {
    return 0;
  }
  ppl->delete_temp("marks/lin/杀汤");

  inv = all_inventory(environment(ppl));
  for (i = 0; i < sizeof(inv); i++) {
    if (living(inv[i])
      && inv[i] != ppl
      && inv[i] != this_object()
      && !id("jin xiangyu")) {
      tell_object(ppl, RED "不好，有人看到了。\n" NOR);
      ppl->set("marks/lin/兰州秘密A", -1);      //事情没有办好，以后金
      //湘玉也不敢认你了。
      return 0;
    }
  }

  tell_object(YEL "你想： 这下金湘玉可以放心了。\n" NOR);
  ppl->set("marks/lin/兰州秘密A", 4);
  ppl->set("marks/lin/兰州秘密B", 1);           //解谜成功。
  return 0;
}
