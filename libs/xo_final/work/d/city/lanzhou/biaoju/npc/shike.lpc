// by locker
#include <ansi.h>
inherit NPC;

void create()
{
    set_name( "闲汉", ({ "xian han", "han", "xian"}) );
    set( "title", "江湖人士" );
    set( "gender", "男性" );
    set( "age", random(20) + 30 );
    set( "long", @LONG
    一条江湖好汉，披着一声黑风衣，背着一把单刀，吃东西时都不放下，还时
不时干咳一声，让你摸不透他的底细。
LONG
    );
    set( "attitude", "heroism" );
    set( "negative_score", 1000 );
    set( "chat_chance", 5 );

    set_wugong("sharen-daofa", 200, 200, 1);
    set_xiuwei("blade", random(20000));

    set("max_force", random(5000)+1000);
    set("force", 6000);
    set("nostare", 1);
    set("force_factor", random(1000));

    set( "chat_msg", ({
        "闲汉叹道：“这年头混碗饭吃都难，唉！”\n",
     }) );

    setup();
    carry_object( BLADE_DIR + "sidao" )->wield(); 
}

int refuse_killing(object ob)
{
    command("follow " + ob->query("id"));
    kill_ob(ob);
    command("heihei");
    return 1;
}

int accept_fight(object me)
{
    command("heihei " + me->query("id"));
    command("say 等大爷吃饱了再说！");
    return 0;
}

