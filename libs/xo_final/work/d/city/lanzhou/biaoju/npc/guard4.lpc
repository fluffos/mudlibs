//  成镖头：龙门镖局镖师    /d/city/lanzhou/npc/guard4.c
//  等级：
//  【戊等】小门派的大弟子，大、中门派的一般弟子
inherit F_NEW_MASTER;

#include "biaoju_master.h"

void create() {
  set_name("成镖头",
    ({ "cheng biaotou", "biaotou", "cheng", "chengbiaotou", "guard" }));
  //set( "title", "龙门镖局镖头" );
  //create_zuzhi( "龙门镖局", 2, "镖头" );
  JoinZuzhi(my_zuzhi(), "镖头", "");
  set("title", "龙门镖局 镖头");

  set("gender", "男性");
  set("age", 28);
  set("per", 21);
  set("str", 23);
  set("positive_score", 250);
  set("long", @LONG
    成镖头是龙门镖局一个很一般的镖头，不怎么受重视，功夫也比较差。
LONG
  );

  set_wugong("unarmed", 200, 200, 0);
  set_wugong("taizu-quan", 200, 200, 0);
  set_wugong("tiesha-zhang", 200, 200, 1);

  set_wugong("qinggong", 200, 200, 0);
  set_wugong("jiben-qinggong", 200, 200, 0);
  set_wugong("chusuifeng", 200, 200, 0);
  set_wugong("caiyun-gong", 200, 200, 1);

  set_wugong("blade", 200, 200, 0);
  set_wugong("ditang-dao", 200, 200, 0);
  set_wugong("liuhe-dao", 200, 200, 0);
  set_wugong("kuaidao", 300, 300, 1);

  set_wugong("haoran-zhengqi", 200, 200, 1);

  set_xiuwei_level_by_type("unarmed", 3);
  set_xiuwei_level_by_type("blade", 6);
  set_xiuwei_level_by_type("dodge", 4);
  set_xiuwei_level_by_type("force", 4);
  set_xiuwei_level_by_type("zonggang", 4);

  set("combat_exp", 24000);
  set("social_exp", 2400);

  set("no_quest", 1);
  set("no_public", 1);

  setup();

  carry_object(BLADE_DIR + "blade2")->wield();
  carry_object(CLOTH_DIR + "jinzhuang1")->wear();
}
