inherit NPC;

void create() {
  set_name(comm_man_name(),
    ({ "tangzi shou", "tangzi shou", "shou", "fighter" }));
  //set( "title","龙门镖局 趟子手" );
  JoinZuzhi("longmen", "趟子手", "");
  set("title", "龙门镖局 趟子手");
  set("gender", "男性");
  set("age", 18 + random(20));
  set("long", @LONG
    他是镖局中的一名趟子手，因为功夫不够高，所以老是摊不着好差事。
LONG
  );

  set_wugong("unarmed", 100, 100, 1);
  set_wugong("qinggong", 100, 100, 1);
  set_wugong("blade", 100, 100, 1);
  set_wugong("haoran-zhengqi", 100, 100, 1);

  set_xiuwei_level_by_type("unarmed", 1);
  set_xiuwei_level_by_type("blade", 1);
  set_xiuwei_level_by_type("dodge", 1);
  set_xiuwei_level_by_type("force", 1);

  set("combat_exp", 6000);

  set("talk_msg", ({
    "“练武之人要能吃苦，吃得了苦才能练成好功夫！”",
    "“咱们总镖头的武功，不是天下第一也差不多。”",
  }));

  setup();

  carry_object(CLOTH_DIR + "cloth2")->wear();       //粗布衣
  carry_object(BLADE_DIR + "blade")->wear();       //粗布衣
}
