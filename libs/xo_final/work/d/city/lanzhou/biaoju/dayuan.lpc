#include <room.h>

inherit ROOM;

void create()
{
    set( "short", "镖局大院" );
    set( "long", @LONG
这里是镖局宽敞的大院，地上铺着青石方砖，天井东西各种有一棵枣树；几
名镖师正在院子当中练武，院子墙角的架子(jia zi)上整齐地摆放着枪棍刀剑等
兵器。院子东边是帐房，门前停了两辆镖车，几个趟子手正倚在车上聊天；西边
是间厢房，房门紧闭。
LONG
    );

    set( "outdoors", "lanzhou" );

    set( "blade_number", 10 );
    set( "item_desc", ([
        "架子"      :   "一个红漆漆过的粗木兵器架子，上面的兵器随你取用。\n",
        "jia zi"    :   "一个红漆漆过的粗木兵器架子，上面的兵器随你取用。\n",
        "jiazi"     :   "一个红漆漆过的粗木兵器架子，上面的兵器随你取用。\n",
    ]) );

    set( "exits", ([
        "north"     :   __DIR__"biaoju_men",//龙门镖局大门    
        "south"     :   __DIR__"dating",    //龙门镖局大厅
        "east"      :   __DIR__"zhangfang", //龙门镖局帐房
        "west"      :   __DIR__"xiangfang",
    ]) );

    set("objects",([
         __DIR__"npc/guard1"    :   1,      //李镖头
         __DIR__"npc/guard2"    :   1,      //汤镖头
         __DIR__"npc/fighter"   :   2,      //趟子手
    ]) );

    setup();
}

void init()
{
    add_action( "do_get", ({ "qu", "get" }) );
}

int do_get( string arg )
{
    object ppl = this_player();
    object ob;
    
    if ( !arg || arg == "" )
    {
        return notify_fail( "你可以取朴刀(blade)，或是木刀(mudao)。\n" );
    }

    if ( !query( "blade_number" ) )
    {
        return notify_fail( "刀已经被拿光了，架子上空荡荡的。\n" );
    }

    if ( arg == "blade" || arg == "朴刀" )
    {
        if ( ppl->query_temp("lanzhou/qublade") )
        {
            return notify_fail( "你已经取过了，干嘛呀？是不是想赚钱？\n" );
        }

        message_vision( "$N从架子上取下一柄朴刀，握在手中。\n", ppl );
        ob = new( BLADE_DIR + "pudao" );
        ob->move( ppl );

        ppl->set_temp( "lanzhou/qublade" , 1 );
        add( "blade_number", -1 );

        return 1;
    }

    if ( arg == "mudao"
        || arg == "木刀" 
        || arg == "mu dao" )
    {
        message_vision( "$N从架子上取下一柄练习用的木刀。\n", ppl );
        ob = new( BLADE_DIR + "mudao" );
        ob->move( ppl );
        add( "blade_number" , -1 );
        return 1;
    }

    return 0;
}

