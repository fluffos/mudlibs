#include <ansi.h>
#include <room.h>

inherit KITCHEN_ROOM;

void create()
{
    set("short", "厨房");
    set("long", @LONG
这里是龙门镖局的厨房，总镖头很好客，特地吩咐厨房免费招待各方豪杰。想吃饭的
话，只要说句“恭喜发财”，就会有伙计送上饭菜来。也正因为这一条规矩，很多过
路英雄宁可去龙门客栈花钱吃饭。 
LONG
    );

    set("exits", ([
        "north" : __DIR__"xiangfang"
    ]));

    set("objects", ([ 
        __DIR__"npc/shike" : 2,
    ]));

    set("family", "龙门镖局");
    ::create();
}

