inherit SHOP;                               //标准当铺兼钱庄。

void create() {
  set("short", "金城当铺");
  set("long", @LONG
这是一间很气派的店面，阳光透过几扇临街的大窗子照得地下亮堂堂的。左
首墙上有一块木板(ban)， 上面写得有字，伙计坐在高高的柜台后面，身后墙上
贴着一张告示(gao shi)。 店主人是个波斯胡商，因早年受伤致残无法行走，就
在城里久居下来，开了这家当铺维持生计，顺带也作些钱庄的生意。只因他行动
不便，所以很少露面。
LONG
  );
  set("dangpu_location", "lanzhou");    //当铺位置：兰州
  set("item_desc", ([
    "木板": @TEXT
─────────────────────
  当物入店  实为自愿  立据为证  过期不还
  金银入库  包你安全  代发交子  会钞方便
─────────────────────
可以使用的指令有：
value   ——    物品估价。          pawn    ——    典当。          
    格式：value < 物品的英文名 >            格式：pawn < 物品的英文名 >
pawnlist——    已典当物品列表。    redeem  ——    赎取物品。      
    格式：pawnlist                          格式：redeem < 物品的序号 >
sell    ——    出售物品。          list    ——    可购买物品列表。
    格式：sell < 物品的英文名 >             格式：list
buy     ——    购买物品。      
    格式：buy < 物品的英文名 >
convert ——    兑换货币。      
    格式：convert < 数量 > < 货币种类１ > to < 货币种类２ >
cun     ——    存钱。              qu      ——    取钱。          
    格式：cun < 数量 > < 货币种类 >         格式：qu < 数量 > < 货币种类 >
check   ——    查帐。          
    格式：check
TEXT
    ,
    "ban": @TEXT
─────────────────────
  当物入店  实为自愿  立据为证  过期不还
  金银入库  包你安全  代发交子  会钞方便
─────────────────────
可以使用的指令有：
value   ——    物品估价。          pawn    ——    典当。          
    格式：value < 物品的英文名 >            格式：pawn < 物品的英文名 >
pawnlist——    已典当物品列表。    redeem  ——    赎取物品。      
    格式：pawnlist                          格式：redeem < 物品的序号 >
sell    ——    出售物品。          list    ——    可购买物品列表。
    格式：sell < 物品的英文名 >             格式：list
buy     ——    购买物品。      
    格式：buy < 物品的英文名 >
convert ——    兑换货币。      
    格式：convert < 数量 > < 货币种类１ > to < 货币种类２ >
cun     ——    存钱。              qu      ——    取钱。          
    格式：cun < 数量 > < 货币种类 >         格式：qu < 数量 > < 货币种类 >
check   ——    查帐。          
    格式：check
TEXT
    ,
    "告示": "银一两当钱千，金一两当钱十千。只收足赤货色，\n"
    + "若有以铜冒金者，交官拿问。\n",
    "gao shi": "银一两当钱千，金一两当钱十千。只收足赤货色，\n"
    + "若有以铜冒金者，交官拿问。\n",
    "gaoshi": "银一两当钱千，金一两当钱十千。只收足赤货色，\n"
    + "若有以铜冒金者，交官拿问。\n",
  ]));
  set("exits", ([
    "west": __DIR__ "beijie",    //兰州北街
  ]));
  set("objects", ([
    __DIR__ "npc/youngman": 1,
  ]));

  setup();
}
