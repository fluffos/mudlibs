//  By lin
//  Changed by Lala, 1998-03-11

inherit ROOM;

void create() {
  set("short", "布庄");
  set("long", @LONG
这是一家专营布帛生意的小店铺。别看店不大，从这里却能买到江南的丝绸、
关中的好棉布。东墙靠着一张长桌，上面堆着成匹的各种布料。店主人除了能替
顾客定做合身的衣服，还雇了几个小姑娘，做一些刺绣工艺来卖，虽然比不上江
南和京里的绣品，却也蛮漂亮的，价钱也很便宜。北面有一道门，挂着绣锻门帘，
帘偶尔传来年轻姑娘的嬉笑声。门口挂了一块牌子(pai zi)。
LONG
  );
  set("item_desc", ([
    "牌子": "牌子上写着：招小工。\n",
    "pai zi": "牌子上写着：招小工。\n",
    "paizi": "牌子上写着：招小工。\n",
    "north": "一道绣花的门帘将帘后的屋子挡住了。\n",
  ]));
  set("exits", ([
    "south": __DIR__ "xijie2",    //西街
  ]));
  set("objects", ([
    __DIR__ "npc/tailor": 1,      //布庄老板
  ]));

  setup();
}
