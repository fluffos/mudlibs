inherit NPC;
void create() {
  set_name("旅客", ({ "lu ke", "ke" }));
  set("combat_exp", 600 + random(800));
  set("long", "一名长途跋涉来到此地的旅客，脸上颇有风尘劳顿之态。\n");
  setup();
  if (random(2) == 1) {
    {
      object carried_ob = carry_object(__DIR__ "obj/cloth1");
      if (carried_ob) carried_ob->wear();
    }
  } else {
    {
      object carried_ob = carry_object(__DIR__ "obj/cloth3");
      if (carried_ob) carried_ob->wear();
    }
  }
  if (random(2) == 1) {
    carry_object("/clone/money/silver");
  }
}
