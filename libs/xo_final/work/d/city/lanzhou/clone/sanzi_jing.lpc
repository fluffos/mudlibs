//  By lin
//  Changed by lala, 1998-03-16

inherit BOOK;

void create() {
  set_name("三字经", ({ "sanzi jing", "sanzijing", "jing", "book" }));
  set_weight(150);                      //三市两；
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "本");
    set("long", "这本书的纸张都已经泛黄了，看上去相当破旧。\n");
    set("value", 600);                //价格：(20*30)等级价值
    //-((20-20)*10)难度价值=600总价值；
    set("material", "paper");         //质地：纸（无价值）
    set("skill", ([
      "name": "literate",         //技能名称；
      "xiuwei_required": 0,      //修为要求；            
      "gin_cost": 10 + random(10),  //精力消耗；
      "difficulty": 20,     //基本悟性；
      "max_lingwu": 30,     //最大领悟；
      "bonus_jilei": -1,     //-1表示literate每次所得的积累。
    ]));
  }
}
