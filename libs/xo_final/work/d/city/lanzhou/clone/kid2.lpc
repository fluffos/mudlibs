inherit NPC;
void create()
{
    set_name("小孩",({ "xiao hai","kid" }) );
    set("gender", "女性" );
    set("age", 7);
    set("long", "这是个很可爱的小孩子，正在和同伴玩耍。\n");
    set("combat_exp", 50);
    set("score", 50);
    set("shen_type", 1);
    set("str", 8);
    set("cor", 8);
    set("cps", 8);
    set("per", 25);
    set("attitude", "peaceful");
    setup();
    carry_object(__DIR__"obj/wocloth1")->wear();
}
