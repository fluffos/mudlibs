#include <ansi.h>

inherit NPC;

inherit F_VENDOR;

void create()
{
    set_name( comm_man_name(), ({ "zhongyuan shangren","shangren" }) );
    set( "title",YEL"中原商人"NOR );
    set("gender", "男性" );
    set( "long", @LONG
他是一名从中国穿过浩瀚的大沙漠这里来做生意的。
LONG
    );
    set( "age",33 );

    set_wugong( "taizu-quan",100,100,1 );
    set_wugong( "feiyan-zoubi",80,80,1 );
    set_xiuwei_by_type( "unarmed",700+random(300) );
    set_xiuwei_by_type( "dodge",700+random(300) );
    set( "combat_exp", 50000 );
    set( "attitude", "friendly" );
    set( "vendor_goods",([
        "黄连"       :   MED_DIR"huang_lian",
        "大黄"       :   MED_DIR"dahuang",
        "银耳"       :   MED_DIR"yiner",
//        "指南针"     :   "u/hydra/desert/obj/compass",
        "丝绸"       :   __DIR__"obj/sichou",
    ]) );       

    setup();
    carry_object(CLOTH_DIR"cloth5")->wear();
    add_money( "silver",5+random(3) );
}

void init()
{       
    ::init();
    add_action( "do_vendor_list", "list");
}
