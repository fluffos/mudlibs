#include <room.h>
#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "厨房");
  set("long", @LONG
这里是镇南王府的厨房，规模很大，靠南是一排灶台，大锅小锅好几口，西
面是好几排长条桌子和凳子，是给下人们吃饭时坐的。东面有个小门通向小巷，
灶台边有个小门通向柴房。这里飘荡着一股饭菜的香味，王府请的可是江南名厨，
你感觉自己肚子咕咕叫了起来。
LONG
  );
  set("exits", ([
    "southwest": __DIR__ "chaiyuan",
    "east": __DIR__ "xiaoxiang",
    "north": __DIR__ "xiaoyuan",
  ]));

  setup();
  //place_program(ROOM);
}
