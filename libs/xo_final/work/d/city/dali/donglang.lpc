#include <room.h>
#include <ansi.h>

inherit ROOM;

void create()
{
	set("short", "东走廊");
	set("long", @LONG
这是条连接大厅和内宅和王府大院的走廊，位于大厅的东面，飞檐红柱，大
理石铺就的地面一尘不染，两个衣着光鲜的小丫鬟认真的在擦洗两边的栏杆和柱
子，走廊向西北拐了个弯通向内宅。西面就是王府大厅，西南面是王府大院。
不时见丫鬟们匆匆走过。偶尔传来银铃般的笑声。
LONG
	);
    set("exits", ([ 
	        "west"  : __DIR__"dating",
	        "northwest"  : __DIR__"zoulang",
	        "southwest"  : __DIR__"wangfu_dayuan",
        ]));
	
	setup();
	//place_program(ROOM);
}                       

