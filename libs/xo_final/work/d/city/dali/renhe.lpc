// dali_renhe.c

inherit ROOM;

void create() {
  set("short", "仁和车行大理分号");
  set("long", @LONG
一间拥挤不堪的房间，屋里都是些要到外地做买卖的生意人，间或也有
一些佩剑挎刀的江湖人物。这里就是有名的仁和车行的大理分号。由于大理
远处西南一隅，故而除了有自备车辆的大理王公贵族外的其他希望到中原去
的人士都不得不到这里来租车。于是乎，仁和车行的生意越做越大，在所有
主要城市都有它的分号。
LONG
  );
  set("exits", ([
    "east": __DIR__ "nanmen",
  ]));
  set("objects", ([
    __DIR__ "npc/asi": 1,
  ]));
  setup();
}

int valid_leave(object me, string dir) {
  if (me->query_temp_marks("booked_mache"))
    return notify_fail("你应该快上马车了，不要再随便跑开。\n");

  else if (me->query_temp_marks("waiting_mache"))
    return notify_fail("你正在等马车呢，不要随便走开。\n");
  else return ::valid_leave(me, dir);
}
