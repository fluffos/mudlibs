#include <room.h>

inherit ROOM;

void create() {
  set("short", "东街");
  set("long", @LONG
这里是一条笔直的东街，从这再往东走就是一条幽静的小巷。街道两旁布满
了店铺，来来往往的行人很多，显得甚是热闹。北面是一家肉铺，可以听到里面
传出的讨价还价的声音。南面的药铺就安静的多，听说这家药铺的老板粗通医疗
之术，经常救死扶伤，在大理城还算有名。
LONG
  );
  set("exits", ([
    "north": __DIR__ "roupu",
    "south": __DIR__ "yaopu",
    "east": __DIR__ "xiangdao",
    "west": __DIR__ "guangchang",
  ]));
  set("outdoors", "xinan");
  setup();
  //place_program(ROOM);
}
