// worker1.c

inherit NPC;

void create() {
  set_name("搬运工", ({ "banyun gong", "worker" }));
  set("gender", "男性");
  set("str", 40);
  set("age", 32);
  set("long", "搬运工正在忙碌地搬东西。\n");
  set("combat_exp", 500);
  set("attitude", "friendly");
  set_wugong("unarmed", 30);
  set_xiuwei_by_type("unarmed", 100);
  setup();
  add_money("coin", 30);
  carry_object(CLONE_DIR + "wear/cloth/cloth2")->wear();
}
