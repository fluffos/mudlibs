inherit RENHE;
void create() {
  set_name("阿四", ({ "ah si", "si", "waiter" }));
  set("title", "仁和车行伙计");
  set("gender", "男性");
  set("location", "大理");
  set("age", 18);
  set_hp("gin", 500);
  set_hp("kee", 700);
  set("max_force", 6000);
  set_hp("sen", 700);
  set_wugong("haofeng-quan", 70);
  set_wugong("tianhong", 70);
  set_xiuwei_by_type("unarmed", 1000);
  set_xiuwei_by_type("dodge", 1000);
  set("combat_exp", 50000);
  set("long", "阿四看起来就是一付很是精明的样子，难怪仁和车行会把\n"
    "大理分号交给他管。\n");
  set("attitude", "friendly");
  setup();
  carry_object(CLOTH_DIR "cloth1")->wear();
}

int refuse_killing(object me) {
  if (me->query_temp("kill_renhe")) {
    command("chat* nokill " + me->query("id"));
    me->unconcious();
    me->move("/d/menpai/shennong/shanxi");

  } else {
    me->set_temp("kill_renhe", 1);
    command("nokill " + me->query("id"));
  }
  return 1;
}
