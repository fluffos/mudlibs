// huoji.c

inherit NPC;
inherit F_VENDOR;

void create()
{
    set_name("茶庄伙计", ({ "huo ji","waiter" }) );
    set("gender", "男性" );
    set("age", 18);
    set("long",
        "茶庄伙计正忙着招呼客人, 忙碌地走过去走过来。\n");
	set("combat_exp", 5);
    set_xiuwei("unarmed",30);
	set("sell_times", 20);
    set("attitude", "friendly");
    set("inquiry", ([
        "鼎泰茶庄" : "这里就是鼎泰茶庄呀! 客官。",
    ]) );

    set("vendor_goods", ([
		"茶杯" : CLONE_DIR + "misc/chabei",
		"茶壶" : CLONE_DIR + "misc/chahu",
		"紫瓷茶壶": CLONE_DIR + "misc/chahu1",
		"白瓷茶壶": CLONE_DIR + "misc/chahu2",
		"彩瓷茶壶": CLONE_DIR + "misc/chahu3",
		"沱茶" : CLONE_DIR + "misc/tuocha",
		"红茶" : CLONE_DIR + "misc/hongcha",
		"绿茶" : CLONE_DIR + "misc/lvcha",
		"磨锅茶" : CLONE_DIR + "misc/moguo",
		"花茶" : CLONE_DIR + "misc/huacha",
    ]) );
    setup();
	carry_object( CLONE_DIR + "wear/cloth/cloth1")->wear();
}

void init()
{
    object ob;

    ::init();
    if( interactive(ob = this_player()) && this_object()->can_act() )
    {
        remove_call_out("greeting");
        call_out("greeting", 1, ob);
    }
    add_action("do_vendor_list", "list");
}

void greeting(object ob)
{
    if( !ob || environment(ob) != environment() ) return;
    switch( random(3) )
    {
    case 0:
        say( "茶庄伙计笑咪咪地说道：这位" + RANK_D->query_respect(ob)
            + "，进来看看这里的茶叶吧。\n");
        break;
    case 1:
        say( "茶庄伙计用毛巾抹了抹靠门的一张桌子，说道：这位" + RANK_D->query_respect(ob)
            + "，先请坐。\n");
        break;
    case 2:
        say( "茶庄伙计说道：这位" + RANK_D->query_respect(ob)
            + "，本庄新进了一些好茶，要不要买些回去尝尝？\n");
        break;
    }
}

