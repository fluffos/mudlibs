// Filename : /d/city/dali/npc/shibing.c

inherit NPC;

void create()
{
    set_name("禁军士兵", ({ "shi bing", "bing" }));
    set("title","虎威营");
    set("age", 22);
    set("gender", "男性");
    set("long", "这是一名虎威营的禁军士兵。他身穿轻甲，头戴铁盔\n"
                "手里拿着一杆长矛。\n");
    set("str",40);
    set("per", 25);
    set("combat_exp", 10000);
    set_wugong("jinjun-qiangfa",100,100,1);
    set_wugong("qinggong",100,100,1);
    set_xiuwei_by_type("long",900+random(200));
    set_xiuwei("dodge",1000);
    set("max_force",1000);
    set("force",1000);
    set("force_factor",1);
    setup();
    carry_object(__DIR__"obj/gun")->wield();
    carry_object(__DIR__"obj/junfu")->wear();
    carry_object(__DIR__"obj/kaijia")->wear();
    carry_object(__DIR__"obj/toukui")->wear();
}

int accept_fight(object me)
{
    command("heng");
    command("say 敢来这里捣乱，我看你是不要命了！");
    kill_ob(me);
    return 1;
}
