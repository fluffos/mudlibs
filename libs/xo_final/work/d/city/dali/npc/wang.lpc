//changed by lnwm
//on 1997 6 7 for learn literate

inherit NPC;
inherit F_MASTER;

#include <ansi.h>

string *fate_msg = ({
    "你近日之内，必有血光之灾。",
    "只要你多做善事，你会一切太平的。",
    "好手相呀，你将来必定仕途顺利，吉星高照！",
    "嘻嘻，我看，你很快会交上桃花运。。",
    "唉，看来你是注定要倒霉一辈子了。",
                });
string do_ok(string msg,object me);

void create()
{
    set_name("王半仙", ({ "wang banxian","wang" }) );
    set("title","算命先生");
    set("gender", "男性" );
    set("age",60);
    set("inquiry", ([
        "读书"     : (:do_ok:),
        "literate"      :  (:do_ok:),
        "读书识字"      :  (:do_ok:),
        "学习"          :  (:do_ok:),        
    ]) );
	set("combat_exp", 100000);
    set_wugong("literate", 60);
  	set("attitude", "friendly");
	set_xiuwei("unarmed",300);
    setup();
    carry_object(__DIR__"obj/cloth1")->wear();
}

void init()
{
    object ob;
    ::init();
    if( interactive(ob = this_player()) && this_object()->can_act() ) 
    {
        remove_call_out("greeting");
        call_out("greeting", 3, ob);
    }
    add_action("suan_ming", "suan");
}

void greeting(object ob)
{
     if(!ob || environment(ob)!=environment() )return;
     tell_object(ob,"王半仙凝视了你半晌：“客官愿否听我一言？"
         "如愿意的话，\n不妨算一算你命运如何。”\n");
}

int suan_ming(string arg)
{
        object ob;
        ob = this_player();
        if(!arg) return 0;
        if(arg == "ming" || arg == "命")
        {
                if( !ob->can_afford(1000) )
                {
                message_vision("王半仙向$N白了一眼：“没钱，还想算命，一辈子受穷去吧。”\n",
                ob);
                return 1;
                }
                if( ob->can_afford(1000) == 2)
                {
                message_vision("王半仙对$N说：“哎呀，我没钱找你呀，你上当铺去换一下钱吧，\n"
				"当铺就在这条街上。”\n",ob);
                return 1;
                }
        ob->pay_money(1000);
        message_vision("$N伸出手去让王半仙替$P算命。\n",ob);
        message_vision("王半仙拿起$N的手仔细端详，过了一会，抬起头对$N\n"
        "说：“"+fate_msg[random(sizeof(fate_msg))]+"”\n",ob);
        return 1;
        } 
}

int valid_teach(object ob,string skill)
{
      	if( !ob->query_marks("marks/wang") )
	{
       	say("王半仙说道：咦？我不记得答应教你呀……\n");
             return 0;
    	}
       if( skill != "literate" || ob->query_jibie("literate") > 59 )
       	     return 0;
       return 1;
}

int accept_object(object who, object ob)
{
        if( ob->value() >= 1000000 )
	{
        	say("王半仙点了点头，说道:'既然是这样，老朽老朽就收下了！'\n");
        	if (who->query("yin")>0)
                command("tell "+who->query("id")+" 你的阴性内力有"+who->query("yin")+"点。\n" );
        	if (who->query("yang")>0)
                command("tell "+who->query("id")+" 你的阳性内力有"+who->query("yang")+"点。\n" );
                call_out("dest",1,ob);
            	return 1;
        } 
   	 else
	{
  		 say("王半仙说道：你的诚意不够，这钱还是拿回去吧。\n");
  		 return 0;
    	 }

}

string do_ok(string msg, object me)
{
	me = this_player();
	me->set_marks("marks/need",1);
	message_vision("王半仙对$P说：要学占卜之术，我可先指点你点读书识字的知识。\n",me);
	msg = "不过......";
    return msg;
}

void dest(object ob)
{
	destruct(ob);
}
