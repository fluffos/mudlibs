inherit NPC;
inherit F_VENDOR;
void create()
{
	set_name("小岚", ({ "xiao lan", "lan" }) );
	set("gender", "女性" );
	set("age", 13);
	set("title","卖花女孩");
	set("long",
		"这是一位卖花的小女孩，正向四处叫卖手中的鲜花。\n");
	set("combat_exp", 20);
	set("attitude", "friendly");
	set("chat_chance",5);
    set("chat_msg", ({
        "小女孩叫道：“买花喽～～”\n",
        "小女孩看着你，笑道：“买朵玫瑰，送给心上人吧。”\n",
        (: random_move :)
    }) );
	set("vendor_goods", ([
//        	"黑牡丹" : __DIR__"obj/black_flower",
//		"红玫瑰" : __DIR__"obj/red_flower",
//              "蓝天鹅" : __DIR__"obj/blue_flower",
        "黄玫瑰" : __DIR__"obj/yellow_flower",
        "紫罗兰" : __DIR__"obj/purple_flower",
        "白茶花" : __DIR__"obj/white_flower",
	]));
	setup();
	add_money("coin",10);
}

void init()
{
    add_action("do_vendor_list","list");
}
