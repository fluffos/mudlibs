inherit NPC;
inherit F_VENDOR;

void create() {
  set_name("王胡子", ({ "wang huzi", "wang", "huzi" }));
  set("title", "肉铺老板");
  set("gender", "男性");
  set("age", 35);
  set("long", "一个满脸大胡子，和横肉的家伙。\n");
  set("str", 29);
  set("int", 14);
  set("combat_exp", 25000);
  set("attitude", "heroism");
  set_xiuwei_by_type("unarmed", 600);
  set("vendor_goods", ([
    "猪尾巴": FOOD_DIR "zhu-weiba",
    "猪头": FOOD_DIR "zhutou",
    "猪肉": FOOD_DIR "zhurou",
  ]));

  setup();
  add_money("silver", 1);
  add_money("coin", 500);
  carry_object(CLOTH_DIR "cloth2")->wear();

}

void init() {
  object ob;

  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
  add_action("do_vendor_list", "list");
}

void greeting(object ob) {
  if (!ob || environment(ob) != environment()) return;
  switch (random(4)) {
    case 2:
      say("王胡子咧开大嘴, 笑着道：这位"
        +RANK_D->query_respect(ob)
        + "，要买肉是吗? \n");
      break;
  }
}
