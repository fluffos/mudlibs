// common food in city and class . edit by lin on March 4.1997
inherit ITEM;
inherit F_FOOD;
void create()
{
        set_name("馒头", ({"man tou"}));
        set_weight(100);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("long", "一个白面馒头\n");
                set("unit", "口");
                set("value", 2);//很便宜，（基本食物都应该很便宜）.
                set("food_remaining", 3);
                set("food_supply", 25);//正常饭量的人一顿吃二斤。
        }
}
