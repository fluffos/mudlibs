#include <ansi.h>
#include <armor.h>
inherit CLOTH;
void create() {
  set_name(YEL "狐狸皮" NOR, ({ "fox cloth", "cloth" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "张");
    set("long", "金黄色的狐狸皮，又漂亮又保暖。\n");
    set("value", 1200);
    set("material", "leather");
    set("armor_prop/armor", 15);
  }
  setup();
}
