inherit ITEM;
void create()
{
        set_name("三字经", ({ "book" }));
	set_weight(200);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "本");
		set("value", 100);
		set("material", "paper");
		set("skill", ([
			"name":"literate",
			"exp_required":	0,	
                        "sen_cost":10+random(10),
			"difficulty":	20,
			"max_skill":	15
		]) );
	}
}
