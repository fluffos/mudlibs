// boots for 军官   edit by in on March 4, 1997
#include <armor.h>
inherit BOOTS;
void create()
{
        set_name("乌云靴", ({ "blackcloud boots","boots" }) );
        set_weight(700);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long", "这是军官们最爱穿的军靴。\n");
                set("unit", "双");
                set("value", 200);
                set("material", "cloth");
                set("armor_prop/armor", 1);
                set("armor_prop/dodge", 4);
          
        }
        setup();
}
