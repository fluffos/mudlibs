// 楚州茶博士 /d/city/chuzhou/npc/cha_boshi.c
// by lala, 1997-12-14

#include <ansi.h>

inherit NPC;
inherit F_VENDOR;

void create() {
  set_name("茶博士", ({ "cha boshi", "waiter" }));
  set("gender", "男性");
  set("age", 36);
  set("long",
    "手拎个大茶壶，站在柜台边上的茶博士正在沏一壶茶。\n"
  );
  set("combat_exp", 8000);
  set_wugong("unarmed", 20, 20, 1);
  set_temp("apply/attack", 20);
  set_temp("apply/attack", 30);
  set("chat_chance_combat", 10);
  set("attitude", "friendly");
  set("vendor_goods", ([
    "富春茶": LIQUID_DIR "fuchun",
    "龙井茶": LIQUID_DIR "longjing",
    "魁尖茶": LIQUID_DIR "kuijian",
    "蟹黄包子": FOOD_DIR "xiehuang",
    "金丝茶馓": FOOD_DIR "chasan",
  ]));
  setup();
  carry_object(CLOTH_DIR "cloth2")->wear();
  add_money("coin", 10 + random(200));
}

void init() {
  object ob;
  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
  add_action("do_vendor_list", "list");
}

void greeting(object ob) {
  if (!ob || environment(ob) != environment()) return;
  say("茶博士说：“这位" + RANK_D->query_respect(ob)
    + "，您想喝茶还是吃点心？楚州的‘金丝茶馓’不吃可惜啊！”\n");
}
