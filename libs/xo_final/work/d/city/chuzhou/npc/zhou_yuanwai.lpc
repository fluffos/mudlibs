inherit NPC;

void create() {
  set_name("周员外", ({ "zhou yuanwai", "zhou", "yuanwai" }));
  set("gender", "男性");
  set("age", 58);
  set("title", "本地乡绅");
  set("long", @LONG
周员外是本地有名的乡绅，他家祖上似乎做过不小的官，但是周员外本人并没有
做太久的官，也没有做到多高的官，只做过一两任知州、通判一类的官职。但是
由于他一向比较方正，所以在本地颇有好名。
LONG
  );
  set_wugong("dagger", 250, 250, 1);
  set_wugong("dodge", 250, 250, 1);
  set_xiuwei_by_type("short", 600);
  set_xiuwei_by_type("dodge", 600);
  set("combat_exp", 10000);
  set("social_exp", 20000);
  set("positive_score", 5000);
  set("kee", 400);
  set("max_kee", 400);
  set("eff_kee", 400);
  set("sen", 400);
  set("max_sen", 400);
  set("eff_sen", 400);
  setup();

  carry_object(CLOTH_DIR "baizhu_sipao")->wear();
  carry_object(__DIR__ "obj/riben_zheshan")->wield();
}
