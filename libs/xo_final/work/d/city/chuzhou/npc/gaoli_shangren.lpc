inherit NPC;

inherit F_VENDOR;

#include <ansi.h>

string *name = ({
  "金正文", "朴海靖", "卢太云", "李更相", "崔呈浩",
});

void create() {
  set_name(name[random(sizeof(name))], ({ "gaoli shangren", "shangren", "corean", }));
  set("title", RED "高丽" WHT "商人" NOR);
  set("gender", "男性");
  set("age", 33);
  set("long", @LONG
一个高丽商人，有着典型的高丽人的面孔。他乘船历尽千辛万苦穿过日本海才来
到中国。不过好在他安全的到了，先不管他是否能安全的回去——他自己现在好
象也并不关心这个——他关心的是怎么能把他辛辛苦苦带来的货物买个好价钱。
LONG
  );
  set("attitude", "friendly");
  set("vendor_goods", ([
    "高丽人参": __DIR__ "obj/gaoli_renshen",
    "高丽纸": __DIR__ "obj/gaoli_zhi",
    "高丽墨": __DIR__ "obj/gaoli_mo",
    "虎皮": __DIR__ "obj/tigercloth",
    "日本折扇": __DIR__ "obj/riben_zheshan",
    "倭刀": __DIR__ "obj/wodao",
  ]));
  set("talk_msg", ({
  }));
  set("kee", 400);
  set("max_kee", 400);
  set("eff_kee", 400);
  set("sen", 400);
  set("max_sen", 400);
  set("eff_sen", 400);
  set_wugong("mian-zhang", 100, 100, 1);
  set_wugong("tianhong", 100, 100, 1);
  set_xiuwei_by_type("unarmed", 1200);
  set_xiuwei_by_type("dodge", 1200);
  set("combat_exp", 100000);
  set("social_exp", 100000);
  set("positive_score", 5000);
  set("negative_score", 1000);
  setup();

  carry_object(CLOTH_DIR "cloth5")->wear();
  add_money("silver", 10 + random(5));
}

void init() {
  ::init();
  add_action("do_vendor_list", "list");
}
