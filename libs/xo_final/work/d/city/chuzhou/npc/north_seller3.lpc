inherit NPC;

inherit F_VENDOR;

#include <ansi.h>

void create()
{
    set_name( "河南客商", ({ "henan keshang", "keshang", "seller", }) );
    set( "title", HBYEL BLU"北方"WHT"商人"NOR );
    set( "gender", "男性" );
    set( "age", 25 + random(25) );
    set( "long", @LONG
这是个北方来的商人，带来了许多北方的特产，正在大声的叫卖。
LONG
    );
    set( "attitude", "friendly" );
    set( "vendor_goods",([
        "毛尖茶"        :   MISC_DIR + "maojian_cha",
        "毛尖茶酒"      :   LIQUID_DIR + "maojian_chajiu",
        "银花"          :   MISC_DIR + "yin_hua",  
        "核桃"          :   FRUIT_DIR + "hetao",        
    ]));
    set( "talk_msg",({
    }));
    set("kee",400);
    set("max_kee",400);
    set("eff_kee",400);
    set("sen",400);
    set("max_sen",400);
    set("eff_sen",400);
    set( "max_force",   500 );
    set( "force",       500 );
    set( "force_factor", 20 );
    set( "combat_exp",  10000 + random( 5000 ) );
    set( "social_exp",  20000 + random( 5000 ) );
    set( "positive_score",  100 + random( 500 ) );
    set( "negative_score",  100 + random( 500 ) );
    set_wugong( "fuhu-quan",        200, 200, 1 );
    set_wugong( "jiben-qinggong",   200, 200, 1 );
    set_xiuwei_by_type( "unarmed",  300 + random( 600 ) );
    set_xiuwei_by_type( "dodge",    300 + random( 600 ) );

    setup();

    carry_object( CLOTH_DIR + "cloth5" )->wear();
    carry_object( MISC_DIR + "maojian_cha" );
    carry_object( LIQUID_DIR + "maojian_chajiu" );
    carry_object( MISC_DIR + "yin_hua" );  
    add_money( "coin", 20 + random(31) );
}

void init()
{
    ::init();
    add_action( "do_vendor_list", "list");
}
