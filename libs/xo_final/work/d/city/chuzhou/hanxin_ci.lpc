inherit ROOM;
#include <ansi.h>

void create() {
  set("short", WHT "韩信祠" NOR);
  set("long", @LONG
楚州为古时“兴汉三杰”之一的韩信故里，所以这里建有祠堂纪念他。大殿
正中韩信戎装仗剑而立，英气逼人。上方悬挂着一块金字大匾(sign)，旁边高悬
着一付对联(duilian) ，正是对韩信一生的生动评价。
LONG
  );
  set("no_kill", "yangzhou");
  set("detail", ([
    "sign": YEL @LONG

              国  士  无  双
            
LONG
    NOR,
    "duilian": @LONG
        
            存              生
            亡              死
            两              一
            妇              知
            人              己
        
LONG
    , ]));

  set("exits", ([
    "north": __DIR__ "yanxing_jie",
  ]));
  set("objects", ([
    __DIR__ "npc/youke": random(4),
  ]));
  setup();
}
