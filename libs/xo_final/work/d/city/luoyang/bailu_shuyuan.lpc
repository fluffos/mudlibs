#include <room.h>

inherit ROOM;

void create() {
  set("short", "白鹿书院");
  set("long", @LONG
这里是今朝大学士程颢老先生传授理学的地方，书院四周是碧绿色的竹子，
微风吹过，发出哗哗的声音，在这里似乎能忘记外面喧闹的洛阳城。屋内有一位
老先生正在向他的学生仔细的讲授着什么。老先生的背后有一个大书架，上面整
齐的摆放着四书五经等等许多理学书籍。
LONG
  );
  set("exits", ([
    "southwest": __DIR__ "nanshi",
  ]));
  set("objects", ([
    __DIR__ "npc/chenghao": 1
  ]));
  setup();
  //place_program(ROOM);
}
