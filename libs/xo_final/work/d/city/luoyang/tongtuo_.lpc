#include <room.h>

inherit ROOM;

void create() {
  set("short", "铜驼街");
  set("long", @LONG
铜驼街是洛阳城南的主要街道，是洛阳城最热闹的地方。宽阔的街道青石铺
成，所以人和车马走在上面，并未尘土飞扬。无论是从那里来的旅客都能被这里
的热闹非凡的气氛所感染，感觉到中原大都市的繁华。沿街西侧是一座两层的酒
楼，那里是有钱的公子哥去的地方。东边是洛阳著名的花市，无论是白天还是晚
上都可以闻到从那里飘来的阵阵花香。
LONG
  );
  set("exits", ([
    "north": __DIR__ "luohe_qiao",
    "south": __DIR__ "tongtuo_jie2",
    "west": __DIR__ "jiulou1",
    "east": __DIR__ "nanshi",
  ]));
  set("objects", ([
    __DIR__ "npc/youke": 2
  ]));
  set("outdoors", "luoyang");
  setup();
  //place_program(ROOM);
}
