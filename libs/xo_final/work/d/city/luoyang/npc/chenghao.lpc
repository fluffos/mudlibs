//NPC:/d/city/luoyang/npc 白鹿书院之主 edit by Happyman Mar.25.97
inherit NPC;
string talk_me();
void create() {
  set_name("程颢", ({ "cheng hao", "cheng" }));
  set("title", "老先生");
  set("gender", "男性");
  set("age", 60);
  set("long", "程老先生是当世大儒，你要有什么问题可以请教他。\n");
  set("attitude", "friendly");
  set("combat_exp", 1000000);
  set("social_exp", 1000000);
  set("max_force", 2000);
  set("force", 2000);
  set("force_factor", 100);
  set_wugong("unarmed", 200, 200, 1);
  set("talk_msg", ({
    (: talk_me :)
  }));
  set_wugong("literate", 200, 200, 0);
  setup();
  carry_object(__DIR__ "obj/cloth1")->wear();
}

int valid_teach(object me, string skill) {
  if (me->query_temp("can_teach_zeng")) {
    me->add_temp("can_teach_zeng", -1);
    return 1;
  }
  return 1;
}

string talk_me() {
  object me = this_player();
  command("shake " + me->query("id"));
  message_vision("程老先生对$N说道：做学问的当要专心致志，不可荒废时光。\n", me);
  return "不要再整天闲聊了.\n";
}
