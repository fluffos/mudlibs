//NPC:/d/city/luoyang/npc 饭馆活计 edit by Happyman Mar.25.97
inherit NPC;
inherit F_VENDOR;
void create()
{
        set_name("活计", ({ "huoji","waiter" }) );
        set("gender", "男性" );
        set("age", 18);
        set("long", "这是一位跑堂的活计，脸上堆满了笑容。\n");
        set("combat_exp",1000);
        set_wugong("unarmed",40,40,1);
        set("attitude","friendly");
        set("chat_chance", 5);
        set("chat_msg",(
         {
            "客官，您要点来什么。\n"
           
         }));
         setup();
        set("vendor_goods", ([
                "江南黄酒": __DIR__"obj/hulu",
                "白面馒头": __DIR__"obj/mantou",
                "红烧狗肉": __DIR__"obj/gourou",
                "肉馅包子": __DIR__"obj/baozi",
        ]) );
        carry_object(__DIR__"obj/cloth1")->wear();
}
void init()
{
        object ob;
        ::init();
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
        }
        add_action("do_vendor_list", "list");
}
