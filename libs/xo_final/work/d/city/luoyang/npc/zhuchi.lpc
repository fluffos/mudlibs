inherit NPC;
void create() {
  set_name("主持", ({ "zhuchi", "chi" }));
  set("gender", "男性");
  set("title", "僧人");
  set("age", 60);
  set("long", "这是一位老和尚，双手合什，嘴中念念有词。\n"
  );
  set("attitude", "friendly");
  set("combat_exp", 60000);
  set_wugong("unarmed", 70, 70, 1);
  set("chat_chance", 10);
  set("chat_msg", ({
    "阿弥陀佛。\n",
  }));
  setup();
  carry_object(__DIR__ "obj/cubu_jia")->wear();
}
