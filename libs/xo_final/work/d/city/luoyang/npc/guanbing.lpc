// //NPC:/d/city/luoyang/npc/guanbing copy from Lin's lanzhou
inherit NPC;
void create() {
  set_name("士兵", ({ "shi bing", "bing" }));
  set("title", "禁军");
  set("age", 22);
  set("gender", "男性");
  set("long", "这是一名京中调来的禁军士兵。他身穿轻甲，头戴铁盔\n"
    "腰间挂着腰刀。\n");
  set("str", 40);
  set("per", 25);
  set("combat_exp", 10000);
  set_wugong("blade", 100, 100, 1);
  set("chat_chance_combat", 10);
  set("chat_msg_combat", ({
    "士兵喝道：大胆刁民，竟敢造反不成？\n",
    "士兵喝道：来人哪，有反贼！\n",
  }));
  setup();
  carry_object(__DIR__ "obj/blade")->wield();
  carry_object(__DIR__ "obj/junfu")->wear();
  carry_object(__DIR__ "obj/kaijia")->wear();
  carry_object(__DIR__ "obj/toukui")->wear();
  carry_object(__DIR__ "obj/yaopai")->wear();
}
int accept_fight(object me) {
  command("say 我看你今天是活得不耐烦了," + RANK_D->query_rude(me) + ",去死吧！\n");
  me->apply_condition("killer", 100);
  kill_ob(me);
  return 1;
}
