inherit NPC;
inherit F_VENDOR;
void create()
{
        set_name("猎户", ({ "lie hu","hunter" }) );
        set("gender", "男性" );
        set("age", 35);
        set("long",
          "这是个临近山上的猎户，时常来城里卖山货。\n"
        );
        set("combat_exp", 10000);
        set_lingwu("unarmed",80);
        set_jibie("unarmed",80);
        enable_skill("unarmed");
        set("chat_chance", 15);
        set("chat_msg",({
"              卖山货嘞~~~~ ~~~~\n",
        }) );
        set("vendor_goods", ([
               "野山鸡" : __DIR__"obj/chicken",
               "狐狸皮" : __DIR__"obj/foxcloth",
               "牛皮背心" : __DIR__"obj/beixin",
        ]) );
        setup();
        carry_object(__DIR__"obj/cloth2")->wear();
}
void init()
{
        object ob;
        ::init();
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
        }
        add_action("do_vendor_list", "list");
}
void greeting(object ob)
{
     say( "猎户喊道：这位" + RANK_D->query_respect(ob)
     + "，尝尝山货吧！\n");
             
}
