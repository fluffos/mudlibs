// common shield.c modified by lin on March 4 , 1997
#include <armor.h>
inherit SHIELD;
void create()
{
	set_name("牛皮盾", ({ "leather shield", "shield" }) );
	set_weight(3000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("material", "leather");
		set("unit", "面");
		set("value", 300);
		set("armor_prop/armor", 5);
		set("armor_prop/defense", 3);
	}
	setup();
}
