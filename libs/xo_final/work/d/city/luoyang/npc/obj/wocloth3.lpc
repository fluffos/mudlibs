#include <armor.h>
inherit CLOTH;
void create()
{
        set_name("大红对襟团凤镶边小袄", ({ "cloth" }) );
        set_weight(800);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long", "一件华丽的手绣绸袄，只是穿上显得过于妖艳了。\n");
                set("unit", "件");
                set("value", 1000);
                set("material", "cloth");
               
                set("armor_prop/personality",5);
                set("female_only", 1);
        }
        setup();
}
