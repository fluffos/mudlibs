#include <armor.h>
inherit CLOTH;
void create() {
  set_name("绿绸撒花裙", ({ "skirt", "cloth" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一件漂亮的撒花绸裙。\n");
    set("unit", "件");
    set("value", 600);
    set("material", "cloth");
    set("armor_prop/armor", 1);
    set("armor_prop/personality", 1);
    set("female_only", 1);
  }
  setup();
}
