//NPC:/d/city/luoyang/npc/houji3 客店活计 edit by Happyman Mar.25.97
inherit NPC;
void create()
{
        set_name("活计", ({ "huoji","waiter" }) );
        set("gender", "男性" );
        set("age", 18);
        set("long", "这是一位客店的活计，脸上堆满了笑容。\n");
        set("attitude","friendly");
        set("chat_chance", 5);
        set("chat_msg",(
         {
            "客官，您要住店吗？\n",
           
         }));
        set("combat_exp",1000);
        set_wugong("unarmed",40,40,1);
        setup();
        carry_object(__DIR__"obj/cloth1")->wear();
}
