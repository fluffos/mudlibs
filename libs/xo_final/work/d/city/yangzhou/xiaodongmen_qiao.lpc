inherit ROOM;
#include <ansi.h>



void create() {
  set("short", YEL "小东门桥" NOR);
  set("long", @LONG
小东门桥由青石筑成，桥面光滑平整，据说是前朝所建，年代久远。河中心
的桥墩上爬满了青苔，青青的河水从桥下悠然流过，滋润着青苔，孕育了扬州。
你站在桥上，看着小秦淮河两边的密密的屋檐，听着偶尔传出的儿童的嬉笑声，
你感受到扬州悠闲的一面。
LONG
  );
  set("no_clean_up", 0);
