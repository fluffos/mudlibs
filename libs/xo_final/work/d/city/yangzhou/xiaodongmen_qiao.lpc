  set("no_kill", "yangzhou");

  set("exits", ([ /* sizeof() == 2 */
    "west": __DIR__ "hejia_jie",
    "east": __DIR__ "xincheng_cangjie",
  ]));

  setup();
  //place_program(ROOM);
