#include <ansi.h>
#include <room.h>

inherit SLEEP_ROOM;

void create()
{
    set("short", "女弟子睡房");
    set("long", @LONG
几张木板床一字排开，床的被褥叠的整整齐齐，床头各有一个小柜子，柜子
上放了一面铜镜。除了这些，屋内就别无它物。看来镖局弟子虽然在扬州这繁华
之地，生活也是很清苦的。
LONG
    );

    set("exits", ([
        "northeast" : __DIR__"tianjing",
        "south" : __DIR__"neifang",
    ]));

    set("no_kill", "penglai");
    set("family", "凤翔镖局");
    set("gender", "女性");
    set("exit_room", __DIR__"tianjing");

    ::create();
}

int valid_leave(object me, string dir)
{
    if ( dir != "south" )
    {
        return ::valid_leave(me, dir);
    }

    PLACE_D->drop_all_users(me);    

    return 1;
}

