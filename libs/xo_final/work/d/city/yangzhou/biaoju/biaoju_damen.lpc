#include <ansi.h>
#include <room.h>

inherit ROOM;

void create()
{
    set("short", "镖局大门");
    set("long", @LONG
门口蹲着一对石狮子，东面的石狮子的边上有一旗斗，飘着一面写着「凤翔
九天」的黄缎旗。门前的石阶上站着两个趟子手。门楣上是一个烫金匾额「凤翔
镖局」。据说开这家镖局的总镖头周天翔年轻时是山东蓬莱派的高足，一手八仙
剑使的出神入化，号称「剑掌双绝」。现在年纪大了，很少行走江湖了。
LONG
    );

    set("exits", ([
        "west" : __DIR__"biaoju_tingyuan",
        "north" : "/d/city/yangzhou/xincheng_cangjie",
    ]));

    set("objects", ([
        __DIR__"npc/tangzi_shou" + (random(2) + 1) : 1,
        __DIR__"npc/tangzi_shou" + (random(2) + 1) : 1,
        __DIR__"npc/chen_biaotou" : 1,
    ]));

    set("no_kill", "penglai");
    set("outdoor", "yangzhou");

    setup();
    replace_program(ROOM);
}

