#include <ansi.h>
#include <room.h>

inherit KITCHEN_ROOM;

void create() {
  set("short", "厨房");
  set("long", @LONG
东边是个大灶台，几个厨娘在忙活着。中间是放着一张桌子，摆着几张长条
凳，一些镖局弟子正坐在那里填饱肚子。看那饭菜，真不知道那几个弟子是如何
下咽的，不知镖局从哪里找来的厨娘，估计不会是扬州人，找到这么几个宝贝也
真是不容易。
LONG
  );

  set("exits", ([
    "west": __DIR__ "tianjing"
  ]));

  set("no_kill", "penglai");
  set("family", "凤翔镖局");

  ::create();
}
