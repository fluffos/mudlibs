inherit ITEM;

void create() {
  set_name("石锁", ({ "shi suo", "suo" }));
  set_weight(40000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "这是一块方方正正的大石头，上面有个提手。\n");
    set("unit", "只");
    set("value", 70);
  }
}

void init() {
  add_action("do_get", "get");
}

int do_get(string arg) {
  object *inv;
  object ob, me = this_player(1);

  if (!arg) {
    return 0;
  }

  if (!ob = present(arg, environment())) {
    return 0;
  } else if (!ob->id("shi suo") && arg != "all") {
    return 0;
  }

  inv = deep_inventory(me);
  foreach (ob in inv) {
    if (ob->id("shi suo")) {
      tell_object(me, "不要那么贪心好不好!\n");
      return 1;
    }
  }

  return 0;
}
