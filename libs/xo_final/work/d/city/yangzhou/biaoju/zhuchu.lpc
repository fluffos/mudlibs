inherit ROOM;

void create() {
  set("short", "周局主的住处");
  set("long", @LONG
屋子里简简单单，靠南放着一张床，西窗下放着一张松木桌，桌下放着三张
木凳。东墙放着一个木架，架子上摆着一铜盆，挂着一块布巾。这里就是周天翔
周局主的日常起居之处。
LONG
  );

  set("no_clean_up", 0);

  set("objects", ([
    __DIR__ "npc/zhou_tianxiang": 1
  ]));

  set("exits", ([
    "north": __DIR__ "tianjing",
  ]));

  setup();
