inherit ROOM;

#include <ansi.h>
#include <room.h>

void create()
{
    set("short", "天井");
    set("long", @LONG
这是个小小的院子，摆着几盆花，地面扫的一尘不染，也很安静，没有前院
的吆喝声。南边就是周总镖头的住处了。西面是睡房，镖局弟子中在扬州没有住
处都在那里休息。东面是个厨房，一般的镖局弟子都在那里吃喝。
LONG
    );

    set("exits", ([
        "east" : __DIR__"chufang",
        "south" : __DIR__"zhuchu",
        "west" : __DIR__"nan_shuifang",
        "southwest" : __DIR__"nv_shuifang",
        "northwest" : __DIR__"biaoju_dating",
        "northeast" : __DIR__"biaoju_dating",
    ]));

    set("objects", ([ 
        "/maze/forest/forest_door" : 1,
    ]));

    set("outdoors", "yangzhou");
    set("no_kill", "penglai");

    setup();
}

