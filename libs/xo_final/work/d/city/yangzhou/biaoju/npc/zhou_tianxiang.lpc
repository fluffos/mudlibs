#include <ansi.h>

inherit F_NEW_MASTER;

#include "biaoju_master.h"

string ask_me();

void create()
{
    set_name("周天翔", ({"zhou tianxiang", "zhou"}) );
    //set("title","凤翔镖局局主");
    set("nickname", "剑掌双绝");
    set("long", @LONG
周天翔身材消瘦，红光满面，看上去颇有些仙风道骨。据说周
天翔原是山东蓬莱派的高徒，一手八仙剑使的出神入化，一手
创下凤翔镖局。
LONG
    );
    set("gender", "男性");

    set("str", 21);
    set("con", 22);
    set("per", 22);
    set("int", 27);
    set("kar", 25);
    set("dex", 26);

    set("age", 61);

    set( "combat_exp", 500000 );
    set( "social_exp", 500000 );

    set_wugong( "penglai-xinfa", 300, 300, 1 );

    set_wugong( "jiben-quanfa", 300, 300, 0 );
    set_wugong( "changquan", 300, 300, 0 );
    set_wugong( "baxian-zhang", 300, 300, 1);

    set_wugong( "jiben-jianfa", 300, 300, 0 );
    set_wugong( "chuiliu-jianfa", 300, 300, 0 );
    set_wugong( "baxian-jian", 300, 300, 1);

    set_wugong( "jiben-qinggong", 300, 300, 0 );
    set_wugong( "xingyun-shenfa", 300, 300, 0 );
    set_wugong( "baxian-shenfa", 300, 300, 1);

    set_xiuwei_level_by_type("unarmed", 7);
    set_xiuwei_level_by_type("sword", 7);
    set_xiuwei_level_by_type("dodge", 7);
    set_xiuwei_level_by_type("force", 5);
    set_xiuwei_level_by_type("zonggang", 5);

    set("talk_msg", ({
        "老夫现在正忙着呢，你别打扰我了。\n",
    }));

    set("inquiry", ([
        "升职" : (: ask_me :),
    ]));

    set("no_quest", 1);
    set("no_public", 1);

    //create_zuzhi( "凤翔镖局", 1, "总局主" );
    JoinZuzhi(my_zuzhi(), "总局主", "");
    set("title", "凤翔镖局总局主");
    create_family( "蓬莱派", 16, "掌门人" );
    setup();

    carry_object(CLOTH_DIR "heibu_yi")->wear();
    carry_object(BOOTS_DIR "sifeng_kuanxue")->wear();
    carry_object(SWORD_DIR "changjian")->wield();
}

string ask_me()
{
    object you = this_player();
    string defeat_master;

    if ( !you->IsMemberOf(my_zuzhi()) )
    {
        return "你不是我镖局弟子，来问我这些事情做什么？";
    }

    if ( you->query_xiuwei("dodge") < 10 )
    {
        return "你还是先练好基本功再说。";
    }

    if ( this_object()->ZuzhiTouxianJibie(my_zuzhi()) <= you->ZuzhiTouxianJibie(my_zuzhi()) + 1 )
    {
        return "怎么连我的位置你也有兴趣了？";
    }

    if ( defeat_master = you->query_temp( "liuxinghai/defeat_master" ) )
    {
        command( "nod " + you->query( "id" ) );
        command( "say 不错不错，短短几年，你就能够击败" + defeat_master + "了。" );

        you->IncreaseZuzhiTouxian(my_zuzhi(), 1);
        you->delete_temp( "liuxinghai/fight_master" );
        you->delete_temp( "liuxinghai/defeat_master" );
        return( "从今天起，你就是凤翔镖局的新" + you->ZuzhiTouxian(my_zuzhi()) + "了！" );
    }

    if ( you->query_temp( "liuxinghai/fight_master" ) )
    {
        command( "angry " + you->query( "id" ) );
        return( "不是说让你去找" + ZUZHI_D->GetTouxian(my_zuzhi(), you->query_temp( "liuxinghai/fight_master" )) + "比划么？" );
    }

    you->set_temp( "liuxinghai/fight_master", you->ZuzhiTouxianJibie(my_zuzhi()) + 1 );
    return "你去找" + ZUZHI_D->GetTouxian(my_zuzhi(), you->ZuzhiTouxianJibie(my_zuzhi()) + 1) + "，让他们考验一下你的功夫吧！";
}

