inherit NPC;

void create()
{
    set_name("镖局弟子", ({"biaoju dizi", "dizi"}) );
    set("gender", "男性");
    set("long", @LONG
这个是凤翔镖局的一个趟子手，显得略微老成一些。
LONG
    );

    set("str", 21);
    set("con", 22);
    set("age", 28);

    set( "combat_exp", 2000 );
    set( "social_exp", 500 );

    set_wugong( "penglai-xinfa", 100, 100, 1 );
    set_wugong( "jiben-jianfa", 100, 100, 0 );
    set_wugong( "chuiliu-jianfa", 100, 100, 1);
    set_wugong( "jiben-qinggong", 100, 100, 0 );
    set_wugong( "xingyun-shenfa", 100, 100, 1 );

    set_xiuwei_level_by_type( "sword", 1 );
    set_xiuwei_level_by_type( "dodge", 1 );
    set_xiuwei_level_by_type( "force", 1 );

    //create_zuzhi( "凤翔镖局", 4, "趟子手" );
    JoinZuzhi("fengxiang", "趟子手", "");
    set("title", "凤翔镖局趟子手");
    setup();

    carry_object(CLOTH_DIR "cloth6")->wear();
    carry_object(SWORD_DIR "changjian")->wield();
}

