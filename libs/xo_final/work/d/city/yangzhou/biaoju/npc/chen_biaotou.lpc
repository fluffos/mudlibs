inherit F_NEW_MASTER;

#include "biaoju_master.h"

void create()
{
    set_name("陈镖头", ({"biao shi", "shi"}) );
    //create_zuzhi( "凤翔镖局", 2, "镖头" );
    JoinZuzhi(my_zuzhi(), "镖头", "");
    set("title", "凤翔镖局镖头");
    set("long", @LONG
这是凤翔镖局的一个镖头，在镖局干了十几年了，江湖阅历很丰富。
LONG
    );
    set("str", 21);
    set("con", 22);
    set("age", 32);

    set( "combat_exp", 10000 );
    set( "social_exp", 3000 );

    set_wugong( "penglai-xinfa", 200, 200, 1 );

    set_wugong( "jiben-quanfa", 200, 200, 0 );
    set_wugong( "changquan", 200, 200, 0);
    set_wugong( "feiying-zhang", 200, 200, 1);

    set_wugong( "jiben-qinggong", 200, 200, 0 );
    set_wugong( "xingyun-shenfa", 200, 200, 0 );
    set_wugong( "chusuifeng", 200, 200, 1 );

    set_xiuwei_level_by_type("unarmed", 3);
    set_xiuwei_level_by_type("dodge", 3);
    set_xiuwei_level_by_type("force", 2);
    set_xiuwei_level_by_type("zonggang", 2);

    set("no_quest", 1);
    set("no_public", 1);

    setup();

    carry_object(CLOTH_DIR "mabu_kuanshan")->wear();
    carry_object(BOOTS_DIR "baodi_kuaixue")->wear();
}

