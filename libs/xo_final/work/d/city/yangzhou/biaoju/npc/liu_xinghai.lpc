inherit F_NEW_MASTER;

#include "biaoju_master.h"

string ask_me();
int ask_yunbiao();
int ask_leave();

void create() {
  set_name("刘星海", ({ "liu xinghai", "liu" }));
  //create_zuzhi( "凤翔镖局", 1, "总镖头" );
  JoinZuzhi(my_zuzhi(), "总镖头", "");
  set("title", "凤翔镖局总镖头");
  set("long", @LONG
他身形修长，虎臂雄腰，剑眉虎目，正值中年，身强力壮，一手
八仙掌已得师傅的真传，镖局现在也是他挑大梁。
LONG
  );
  set("gender", "男性");

  set("str", 21);
  set("con", 22);
  set("per", 22);
  set("int", 27);
  set("kar", 25);
  set("dex", 25);

  set("age", 32);

  set("combat_exp", 100000);
  set("social_exp", 10000);

  set_wugong("jiben-quanfa", 200, 200, 0);
  set_wugong("changquan", 200, 200, 0);
  set_wugong("feiying-zhang", 300, 300, 0);
  set_wugong("baxian-zhang", 200, 200, 1);

  set_wugong("jiben-jianfa", 200, 200, 0);
  set_wugong("chuiliu-jianfa", 200, 200, 0);
  set_wugong("fengxiang-jianfa", 300, 300, 0);
  set_wugong("baxian-jian", 200, 200, 1);

  set_wugong("jiben-qinggong", 200, 200, 0);
  set_wugong("xingyun-shenfa", 200, 200, 0);
  set_wugong("chusuifeng", 300, 300, 0);
  set_wugong("baxian-shenfa", 200, 200, 1);

  set_wugong("penglai-xinfa", 200, 200, 1);

  set_xiuwei_level_by_type("unarmed", 7);
  set_xiuwei_level_by_type("sword", 7);
  set_xiuwei_level_by_type("dodge", 7);
  set_xiuwei_level_by_type("force", 4);
  set_xiuwei_level_by_type("zonggang", 4);

  set("inquiry", ([
    "运镖": (: ask_yunbiao :),
    "升职": (: ask_me :),
    "离开": (: ask_leave :),
  ]));
  create_family("蓬莱派", 17, "弟子");

  set("no_quest", 1);
  set("no_public", 1);

  setup();
  carry_object(CLOTH_DIR "heibu_yi")->wear();
  carry_object(BOOTS_DIR "sifeng_kuanxue")->wear();
  carry_object(SWORD_DIR "changjian")->wield();
}

void init() {
  ::init();
  add_action("do_nod", "nod");
}

int do_nod() {
  object me = this_player();

  if (me->query_temp("pending/liu_leaving")) {
    me->delete_temp("pending/liu_leaving");
    //kickout_chengyuan(me);
    me->LeaveZuzhi(my_zuzhi());
    message_vision("$N冲着刘星海点点头，说道：我愿意离开凤翔镖局。\n刘星海叹了口气，说道：好吧。\n", me);
    return 1;
  }

  if (!me->query_temp("pending/liu_testing")) {
    return 0;
  }

  if (me->query("gender") == "无性") {
    command("heng " + me->query("id"));
    command("say 本镖局岂能容下你这样的阉割之人。\n");
    return 1;
  }

  me->delete_temp("pending/liu_testing");
  message_vision("$N冲着刘星海点点头，说道：我愿意投入凤翔镖局。\n", me);
  message_vision("刘星海“哈哈”大笑，说道：好，好，既然你愿意，从今天起你就是我凤翔镖局的人了。\n"
    "在镖局里规矩不多，\n"
    "       一 不和黑道上的人来往， 二 不要招惹官府。\n"
    "好了，现在你可以下去自己找镖头，镖师们学武去了。\n", me);

  //recruit_chengyuan( me, "趟子手" );
  //me->set( "zuzhi/generation", 4 );
  me->JoinZuzhi(my_zuzhi(), "趟子手", "");

  return 1;
}

int ask_yunbiao() {
  object me = this_player();
  string title;

  if (me->query_temp("pending/liu_testing")) {
    write("我还在等你答复呢。\n");
    return 1;
  }

  if (!me->IsMemberOf(my_zuzhi())) {
    //提示加入镖局
    command(":)");
    command("say " + RANK_D->query_respect(me) + "，如果你有心想入我派，就先在镖局学几年武，打好根基再说。");
    command("say 你可愿意？");
    me->set_temp("pending/liu_testing", 1);
    write("你如果愿意就点头(nod)。\n");

    return 1;
  }

  //给任务
  return YUNBIAO_D->give_quest(this_object(), me);
}

int ask_leave() {
  object me = this_player();

  if (me->query_temp("pending/liu_leaving")) {
    write("我还在等你答复呢。\n");
    return 1;
  }

  if (!me->IsMemberOf(my_zuzhi())) {
    command("say 你没事别瞎问。");
    return 1;
  }

  command(":)");
  command("say " + RANK_D->query_respect(me) + "，如果你有心离开镖局，就nod。\n");
  command("say 你可愿意？\n");
  me->set_temp("pending/liu_leaving", 1);
  write("你如果愿意就点头(nod)。\n");

  return 1;
}

// added by xli 1999.1
int accept_bihua(object ppl) {
  if (ppl->query("class") == "qingcheng") {
    if (ppl->query("xli_marks/bihua_liu")) {
      tell_object(ppl, "司马卫这个牛鼻子，竟然派你这么个年轻弟子来挑衅。\n");
      tell_object(ppl, "好，我今天就让你看看我蓬莱派武功的厉害。\n");
      bihua_ob(ppl);
      return 1;
    }

    tell_object(ppl, "一个小小的青城弟子，也配我亲自动手？\n");
    return 1;
  }

  command("say " + "既然你有心和我较量较量，我就奉陪奉陪。");
  bihua_ob(ppl);
  return 1;
}

// by ffox to make player can apprentice zhou tianxiang
string ask_me() {
  object you = this_player();
  string defeat_master;

  if (!you->IsMemberOf(my_zuzhi())) {
    return "你不是我镖局弟子，来问我这些事情做什么？";
  }

  if (you->query_xiuwei("dodge") < 10) {
    return "你还是先练好基本功再说。";
  }

  if (this_object()->ZuzhiTouxianJibie(my_zuzhi()) <= you->ZuzhiTouxianJibie(my_zuzhi()) + 1) {
    return "怎么连我的位置你也有兴趣了？";
  }

  if (defeat_master = you->query_temp("liuxinghai/defeat_master")) {
    command("nod " + you->query("id"));
    command("say 不错不错，短短几年，你就能够击败" + defeat_master + "了。");

    you->IncreaseZuzhiTouxian(my_zuzhi(), 1);
    you->delete_temp("liuxinghai/fight_master");
    you->delete_temp("liuxinghai/defeat_master");
    return ("从今天起，你就是凤翔镖局的新" + you->ZuzhiTouxian(my_zuzhi()) + "了！");
  }

  if (you->query_temp("liuxinghai/fight_master")) {
    command("angry " + you->query("id"));
    return ("不是说让你去找" + ZUZHI_D->GetTouxian(
      my_zuzhi(),
      you->query_temp("liuxinghai/fight_master")
    ) + "比划么？");
  }

  you->set_temp("liuxinghai/fight_master", you->ZuzhiTouxianJibie(my_zuzhi()) + 1);
  return "你去找" + ZUZHI_D->GetTouxian(
    my_zuzhi(),
    you->ZuzhiTouxianJibie(my_zuzhi()) + 1
  ) + "，让他们考验一下你的功夫吧！";
}
