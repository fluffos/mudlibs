#include <ansi.h>

inherit NPC;

void create() {
  set_name("周夫人", ({ "zhou furen", "furen" }));
  set("title", "侠女");
  set("nickname", HIG "迷人的过去" NOR);
  set("long", @LONG
周夫人虽年纪不小，但是看上去风姿依旧，她的过去一定很不简单。
周夫人早年据说是峨嵋女弟子，不知当年为何做了周夫人。
LONG
  );
  set("gender", "女性");

  set("str", 21);
  set("con", 22);
  set("per", 40);
  set("int", 30);
  set("kar", 25);
  set("dex", 26);

  set("age", 52);

  set("combat_exp", 50000000);
  set("social_exp", 500000);

  set_wugong("daojia-xinfa", 300, 300, 1);
  set_wugong("qiushui-qingyun", 300, 300, 1);
  set_wugong("yunv-jianfa", 300, 300, 1);

  set_xiuwei_level_by_type("sword", 9);
  set_xiuwei_level_by_type("dodge", 8);
  set_xiuwei_level_by_type("force", 4);
  set_xiuwei_level_by_type("zonggang", 7);

  set("talk_msg", ({
    "姑娘你想学峨嵋功夫么？\n",
  }));

  create_family("蓬莱派", 15, "掌门夫人");

  set("no_quest", 1);
  set("no_public", 1);

  set("inquiry", ([
    "武功": "我们女人没有武功的话如何在江湖上立足呢？",
    "女儿": "我女儿叫陆丽仙，十年之前失散了，不知现在何处？",
    "陆丽仙": "是啊，我的女儿陆丽仙从小多才多艺，还很会猜谜呢。",
  ]));

  setup();
  carry_object("/d/zuzhi/yipin_tang/dixia/npc/obj/qiankunjian")->wield();
  carry_object("/d/menpai/kunlun/npc/obj/diaoqiu")->wear();
}

