inherit F_NEW_MASTER;

#include "biaoju_master.h"

void create()
{
    set_name("张镖师", ({"zhang biaoshi", "zhang", "biaoshi"}) );
    set("gender", "男性");
    //create_zuzhi( "凤翔镖局", 3, "镖师" );
    JoinZuzhi(my_zuzhi(), "镖师", "");
    set("title", "凤翔镖局镖师");
    set("long", @LONG
这是凤翔镖局的一个镖师，在镖局干了十几年了，江湖阅历很丰富。
LONG
    );

    set("str", 21);
    set("con", 22);
    set("age", 30);

    set( "combat_exp", 5000 );
    set( "social_exp", 2000 );
    
    set_wugong( "penglai-xinfa", 150, 150, 1 );

    set_wugong( "jiben-jianfa", 150, 150, 0 );
    set_wugong( "chuiliu-jianfa", 150, 150, 1);

    set_wugong( "jiben-qinggong", 150, 150, 0 );
    set_wugong( "xingyun-shenfa", 150, 150, 1 );

    set_xiuwei_level_by_type( "sword", 2 );
    set_xiuwei_level_by_type( "dodge", 2 );
    set_xiuwei_level_by_type( "force", 1 );
    set_xiuwei_level_by_type( "zonggang", 1 );

    set("no_quest", 1);
    set("no_public", 1);

    setup();
    carry_object(CLOTH_DIR "cloth6")->wear();
    carry_object(SWORD_DIR "changjian")->wield();
}

