#include <room.h>

inherit ROOM;

void create() {
  set("short", "周夫人的房间");
  set("long", @LONG
屋子里简简单单，靠东放着一张床，西窗下放着一张檀香木桌，桌上放着一面铜镜。
东墙放着一个木架，架子上放满了书籍。这里就是周夫人的日常起居之处。
LONG
  );

  set("objects", ([
    __DIR__ "npc/zhou_furen": 1
  ]));

  set("exits", ([
    "east": __DIR__ "zhuchu",
  ]));

  setup();
  replace_program(ROOM);
}
