// Room: /d/city/yangzhou/anding_men.c

inherit ROOM;
#include "men.h"
#include <ansi.h>


void create() {
  set("short", YEL "安定门" NOR);
  set("long", @LONG
一座高大的城门耸峙在渡江桥头，城门嵌有「安定门」三字石额。城墙上建
有一个城楼，几个士兵在巡逻。左右各有一个水门，便于官河和小秦淮河流通，
及城内外的水运的便利。城门口贴着几张榜文。大量的行人车辆进出安定门，熙
熙攘攘的人群立即使人感受到扬州的繁华。往西去是通往杭州的大道。
LONG
  );
  set("no_clean_up", 0);
  set("outdoors", "yangzhou");
  set("bangwen", "yangzhou");
  set("no_kill", "yangzhou");
  set("detail", ([
    "榜文": (: look_bangwen :),
  ]));
  set("objects", ([
    __DIR__ "npc/xiaowei": 1,
    __DIR__ "npc/shibing2": 1,
    __DIR__ "npc/shibing1": 1,
  ]));
  set("exits", ([ /* sizeof() == 2 */
    "south": __DIR__ "dujiang_qiao",
    "north": __DIR__ "nanmen_dajie",
    //"west" : "/d/map/zhongyuan2/dadao6", 
  ]));

  setup();
}
void init() {
  ///        add_action("mmmm", "mmm");
}
varargs object mmmm(string arg) {
  object ob;
  object me = this_player();
  if (!arg) return efun::snoop(me);
  ob = get_object(arg);
  if (!ob) return efun::snoop(me);
  return efun::snoop(me, ob);
}

int valid_leave(object me, string dir) {
  if (me->query("no_leave_yangzhou") && dir == "south") {
    write("巡捕现在不能离开扬州。\n");
    return 0;
  }
  return ::valid_leave(me, dir);
}
