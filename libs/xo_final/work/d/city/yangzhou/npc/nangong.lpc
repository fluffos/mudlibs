
#include <ansi.h>
inherit NPC;
inherit F_VENDOR;


void create()
{
    set_name( WHT "南宫玟" NOR, 
		({ "nangong ming","ming","seller" }) );
    set("gender", "女性" );
    set("title", YEL"南宫世家"NOR );
    set("age", 26);
    set("per", 28);
    set("long", @LONG
一位不懂武功，但熟知兵器护具的小妇人，美丽大方，非常好客。
LONG
    );
    set( "chat_chance", 5 );
    set( "chat_msg", ({
        "咳，出门在外不能不带点防身的护具啊！看看有什么中意的么？\n",
        "现在这个社会不太平啊，强盗坏人多哦，功夫再高，还是需要装备好啊。\n",
        "您不要走，本店新到了些希奇货哦。\n",
        "客官，您要想好啊，在我这里买的东西可是不能再当或者卖出的啊！\n",

    }));
    set("inquiry", ([
        "宝刀" : "啊，宝刀配英雄，希望您能早日笑傲江湖！！",
        "南宫世家"   : "咳！您看到了，我们「南宫世家」没落了，只好卖点宝物为生了！",
   	]) );
    set("attitude", "friendly");
    set("vendor_goods", ([
        "凤銮金丝带"   : __DIR__"obj/fengsi",      
        "金刚戒"   : __DIR__"obj/jingang",     
        "金缕雪衫"     : __DIR__"obj/jinglv",      
        "莽皮战靴"  : __DIR__"obj/mangpixue",       
        "蚕丝软猬甲"    : __DIR__"obj/ruanweijia",               
        "雁羽披风"    : __DIR__"obj/yanyu", 
        "暮雪银龙盔"    : __DIR__"obj/yinglong",
        "春子剑"    : __DIR__"obj/chunzijian",
        "夏丑刀"    : __DIR__"obj/xiachoudao",        
    ]) );
    set("no_kill", "yangzhou");
    set("combat_exp",1000);
    set("social_exp",1000);
    setup();
    carry_object( "/clone/wear/cloth/danhuang_shayi")->wear();
}
void init()
{
    object ob = this_player();
    ::init();
    if( this_object()->can_act() )
    {
        remove_call_out("greeting");
        call_out("greeting", 1, ob);
    }
    add_action("do_vendor_list", "list");
}
void greeting(object ob)
{
    if( !ob || environment(ob) != environment() ) return;
    message_vision("南宫玟忧虑的说道：“就算有笑傲江湖的绝世武功，又能怎么样呢？”\n",ob);
}

