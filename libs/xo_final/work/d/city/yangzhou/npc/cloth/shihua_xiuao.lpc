//hua_xiuao 时花绣袄
//by trill 04/06/97

#include <armor.h>

inherit CLOTH;



void create()
{
	set_name("时花绣袄", ({"shihua xiuao", "cloth"}));
	set_weight(1500);
	if ( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "一套玉蓝色的缎袄，上面绣着大朵的芍药。\n");
		set("unit", "套");
		set("value", 5000);
		set("material", "cloth");
		set("armor_prop/armor", 3);
		set("female_only", 1);
		set("armor_prop/personality", 1);
	}
	setup();
}
