#include <armor.h>

inherit WAIST;



void create()
{
	set_name("", ({"", "yaodai", "waistband"}));
	set_weight(1000);
	if ( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "");
		set("unit", "根");
		set("value", 500);
		set("material", "cloth");
		set("armor_prop/armor", 1);
	}
	setup();
}



