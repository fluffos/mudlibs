// xunbu.c
// by trill

#include <ansi.h>

inherit NPC;



void create() {
  set_name(YEL "捕快" NOR, ({ "bu kuai", "bu" }));
  set("gender", "男性");
  set("age", 35);
  set("title", "扬州城"),
    set("long", "他是一个捕快，腰跨钢刀，一副精明干练的样子。\n");

  set("no_leave_yangzhou", 1);

  set("str", 30);
  set("con", 30);

  set_wugong("sharen-daofa", 150, 150, 1);
  set_wugong("jiben-qinggong", 200, 200, 1);
  set_xiuwei_by_type("dodge", 4101);
  set_xiuwei_by_type("blade", 4101);
  set_force(3000, 3000, 300);

  set("combat_exp", 500000);

  setup();
  carry_object(__DIR__ "obj/yaodao")->wield();
  carry_object(CLOTH_DIR + "xunbu_fu")->wear();
  carry_object(BOOTS_DIR + "zaoxue")->wear();
}
