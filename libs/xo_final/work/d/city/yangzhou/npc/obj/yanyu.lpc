#include <ansi.h>
#include <armor.h>

inherit SURCOAT;

void create() {
  set_name(WHT "雁羽披风" NOR, ({ "yanyu pifeng", "pi feng", }));
  set_weight(300);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一件北国大雁羽毛丝制成的披风，轻盈保暖。\n");
    set("unit", "件");
    set("value", 300000);
    set("material", "cloth");
    set("cant_sell", "这样的宝物小的没胆气收下，还是贵人您自己保管好了。\n");
    set("wear_msg", "只听见「呋」地一声，$N的肩已经披上一件暖绒绒的--$n。\n");
    set("armor_prop/armor", 15);
  }
  setup();
}
