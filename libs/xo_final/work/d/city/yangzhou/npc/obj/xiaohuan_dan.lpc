#include <ansi.h>
inherit ITEM;
void setup() {}
void init() {
  add_action("do_eat", "eat");
}
void create() {
  set_name(YEL "小还丹" NOR, ({ "xiaohuan dan", "dan", "xiaohuandan" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "颗");
    set("long", "这是一颗补气专用的小还丹，精心炼制，治疗创伤。\n");
    set("value", 200000);
  }
  setup();
}
int do_eat(string arg) {
  if (!id(arg))
    return notify_fail("你要吃什么药？\n");
  if ((int)this_player()->query("eff_qi") ==
    (int)this_player()->query("max_qi"))
    return notify_fail("你现在不需要吃小还丹。\n");
  else {
    this_player()->receive_curing("qi", 150);
    message_vision(WHT "$N吃下一颗小还丹，顿时头冒热气，气色红润起来，气血顺畅。\n", this_player());
    destruct(this_object());
    return 1;
  }
}
