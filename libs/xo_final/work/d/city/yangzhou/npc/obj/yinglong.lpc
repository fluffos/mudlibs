#include <armor.h>
inherit HEAD;

#include <ansi.h>
void create()
{
    set_name(WHT"暮雪"HIW"银龙"NOR"头盔", ({ "yinlong toukui","toukui", }) );
    set_weight(800);
    if( clonep() )
            set_default_object(__FILE__);
    else {
        set("long", "这是由滇南白金打造的头盔。\n");
        set("unit", "只");
        set("value",200000);
        set("cant_sell",HIR"这是穆王府的东西，小的可不能收\n"NOR);
        set("material", "steel");
        set("armor_prop/armor", 15);
        set("armor_prop/personality", 10);
         
    }
    setup();
}

