//Cloth :qingbu_yi.c

#include <armor.h>
inherit CLOTH;



void create() {
  set_name("青布衣", ({ "xiao gua", "cloth" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一套青布的衣衫，店小二多穿这类衣服。\n");
    set("value", 100);
    set("unit", "套");
    set("material", "cloth");
    set("armor_prop/armor", 1);
  }
  setup();
}
