#include <weapon.h>
#include <armor.h>
#include <ansi.h>

inherit BLADE;
inherit F_SAVE;

void create() {
  set_name(YEL "夏丑" NOR + RED "刀" NOR, ({ "xiachou dao" }));
  set_weight(500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long", @LONG           
            一把用千年西域青铜打造的宝刀，象牙刀鞘上刻着丑牛的图纹。
        刀身长约两尺，刀柄上用白金嵌丝盘成四个篆字
LONG
      WHT "                         夏   沐   丑   牛  \n" NOR);
    set("value", 600000);
    set("cant_sell", "这把刀乃是千年之宝，本店不敢收购，实在抱歉。\n");
    set("material", "steel");
  }
  init_blade(50);
  set("wield_msg", "$N「唰」的一声抽出一把寒光四射的$n握在手中。\n");
  set("unwield_msg", "$N将手中的$n插入腰间的黄金刀鞘。\n");
  setup();
}
