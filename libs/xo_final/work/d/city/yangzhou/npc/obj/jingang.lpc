#include <ansi.h>
#include <armor.h>
#include <mudlib.h>
#include <command.h>

inherit FINGER;
inherit F_AUTOLOAD;

void create() {
  set_name(WHT "金刚戒" NOR, ({ "jingang jie", "jie", "ring" }));
  set_weight(80);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一枚金刚石打造的戒指，坚固无比。\n");
    set("unit", "枚");
    set("value", 200000);
    set("material", "steal");
    set("cant_sell", "这样的宝物小的没胆气收下，还是贵人您自己保管好了。\n");
    //      set("armor_prop/personality", 10);
    set("armor_prop/armor", 5);
  }
  setup();
}
