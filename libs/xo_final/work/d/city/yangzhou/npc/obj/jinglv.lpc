#include <armor.h>
#include <ansi.h>
inherit CLOTH;
void create()
{
    set_name(YEL"金缕雪衫"NOR, ({ "jinglv shan", "cloth" }));
    set("long","一套冰雪蚕丝和金缕丝制成的薄衫，精美绝伦，贴身护体。\n");
    set_weight(500);
    if (clonep())
        set_default_object(__FILE__);
    else {
        set("material", "cloth");
        set("unit", "套");
        set("value", 500000);
        set("cant_sell","这样的宝物小的没胆气收下，还是贵人您自己保管好了。\n");
        set("armor_prop/armor", 40);
        set("armor_prop/personality", 20);
    }
    setup();
}
