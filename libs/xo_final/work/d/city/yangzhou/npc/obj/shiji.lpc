#include <ansi.h>
inherit ITEM;


void create()
{
        set_name("史记", ({ "shu", "book" }));
        set_weight(200);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "卷");
                set("long", "一本很古旧的线装书，兰皮上写着两个篆字'史记'，里面的内容\n"
                            "很多都已经模糊不清。\n");
                
                set("material", "paper");
             
              }
}
void init()
{
    add_action("do_read","read");
}
int do_read(string arg)
{
    object me;
    me = this_player();
    if( arg=="book")
     {
        write("这本书太破旧了，现在没法读\n");
        return 1;
     }
}
