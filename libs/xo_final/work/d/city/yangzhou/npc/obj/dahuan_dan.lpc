#include <ansi.h>
inherit ITEM;

void create()
{
    set_name(WHT"大还丹"NOR, ({ "dahuan dan", "dahuan dan", "dan" }) );
    if ( clonep() )
        set_default_object( __FILE__ );
    else 
    {
        set( "unit", "颗" );
        set( "long", "这是一颗救命还魂的灵丹，余木真人炼制，你可以用（tun）来食用。\n" );
        set( "value", 500000 );              
    }

    setup();
}

void init()
{
    add_action( "do_drink", "tun" );        
}

int do_drink()
{
    object ppl = this_player();
    message_vision( "$N一口吞下了一颗大还丹，突然感到四肢麻木…随即躺到在地…\n", ppl );
    ppl->disable_player( "<打坐中>" );
    remove_call_out( "effect" );
    call_out( "effect", 5, ppl );
    return 1;
}

int effect( object ppl )                    //药效发生函数。
{
    ppl->set( "eff_kee", ppl->query("max_kee") );
    ppl->set( "kee", ppl->query("max_kee") );
    ppl->set( "eff_gin", ppl->query("max_gin") );
    ppl->set( "gin", ppl->query("max_gin") );
    ppl->set( "eff_sen", ppl->query("max_sen") );
    ppl->set( "sen", ppl->query("max_sen") );
    message_vision(WHT"$N四肢血液慢慢活络，缓缓的站了起来。\n", ppl );
    tell_object( ppl, "你觉得仿佛脱胎换骨一般!!!!\n" );
    ppl->enable_player();
    destruct(this_object());
    return 1;
}
