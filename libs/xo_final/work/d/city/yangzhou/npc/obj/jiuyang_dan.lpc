
#include <ansi.h>

inherit ITEM;

int do_eat( string arg );

void create()
{
	set_name( WHT"九阳"RED"丹"NOR, ({"jiuyang dan", "dan" }));
	set_weight(200);
	if ( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", @LONG
这是一颗补气养身的九阳丹，滋养精气，补血养身。传说是重阳真人亲手
炼制，用九十九种药材合炼而成。
LONG
    );
		set("unit", "颗");
		set("value", 200000);
	}
	setup();
}

void init()
{
    add_action("do_eat", "eat");
}    

int do_eat( string arg )
{
    object me = this_player();
    if( !arg ||
       ( arg != "jiuyangdan" 
      && arg != "dan"
      && arg != "corean ginseng"
      && arg != "ginseng"
      ))
        return 0;
   if ( me->is_busy() )
		return notify_fail("你现在忙着别的事呢！\n");

	if ( me->is_fighting() )
		return notify_fail("你无法抽出空来在战斗中吃补摇啊！\n");
   
    me->set("sen", me->query("eff_sen") );
    if( me->query("eff_kee") != me->query("max_kee") )
        me->add("eff_kee", ( me->query("max_kee")-me->query("eff_kee") )/2 );
    if( ( me->query("kee") + 100 ) > me->query("eff_kee") )
        me->set("kee", me->query("eff_kee"));
    else
        me->add("kee", 200);
    me->set("gin", me->query("max_gin") );
    me->add("force", 150);
    message_vision(RED"$N吃下一颗九阳丹，只觉得血涌如潮，似乎内力更充裕！！！\n"NOR, me );
    destruct(this_object());
    return 1;
}    