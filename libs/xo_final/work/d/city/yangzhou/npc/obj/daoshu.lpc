// jianshu.c

inherit ITEM;



void create()
{
    set_name("「刀术指南」", ({ "daoshu zhinan", "book", "shu" }));
    set_weight(300);
	if( clonep() )
		set_default_object(__FILE__);
	else {
        set("unit", "本");
        set("long",	"这是一本普普通通的介绍如何使刀的书。\n");
        set("value", 20);
        set("material", "paper");
        set("skill", ([
			"name" 		   :  "blade",
            "xiuwei_required"  : 0,
            "literate_required" : 5,
            "gin_cost"         : 10+random(10),
            "max_lingwu"        : 20,
            "bonus_jilei"      : 5,
            "bonus_combat_exp" : 1,
            "max_combat_exp"   : 100,
		]) );
	}
}
