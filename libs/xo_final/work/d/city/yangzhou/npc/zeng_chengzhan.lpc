//Npc : teacher.c
//by trill 05/07/97

inherit NPC;

string talk_me();



void create() {
  set_name("增城湛", ({ "zeng chengzhan", "zeng", "teacher" }));
  set("title", "崇雅书院先生");
  set("gender", "男性");
  set("age", 59);
  set("long", @LONG
增城湛公是当今大儒，原是当朝的侍郎，现告老还乡，闲来无事，把
自家的园子改建成书院，传授孔孟之道。
LONG
  );
  set("attitude", "peaceful");
  set("combat_exp", 10);
  set("social_exp", 1000000);
  set("positive_score", 100000);
  set("str", 15);
  set("cor", 18);
  set("cps", 20);
  set("per", 26);
  set_wugong("literate", 100, 100, 0);
  set("talk_msg", ({
    (: talk_me :)
  }));
  setup();
  carry_object(CLOTH_DIR "baizhu_sipao")->wear();
  carry_object(HEAD_DIR "yizi_jin")->wear();
  carry_object(WAIST_DIR "yaqing_tao1")->wear();
  carry_object(BOOTS_DIR "sixie")->wear();
}

int valid_teach(object me, string skill) {
  if (me->query_temp("can_teach_zeng")) {
    me->add_temp("can_teach_zeng", -1);
    return 1;
  }
  return 1;
}

string talk_me() {
  object me = this_player();
  command("shake " + me->query("id"));
  message_vision("增城湛老先生对$N说道：做学问的当要专心致志，不可荒废时光。\n", me);
  return "不要再整天闲聊了.\n";
}

int accept_object(object me, object ob) {
  if (ob->value() >= 10000) {
    me->add_temp("can_teach_zeng", ob->value() / 10000);
    message_vision("增城湛对$N笑道：既然你如此有向学之心，我就教你吧。\n", me);
    return 1;
  }
  return 0;
}
