// Room: /d/city/yangzhou/tongsi_jie.c

#include <ansi.h>
inherit ROOM;

private varargs void enter_xinfang( object, object, string );


void create()
{
    set("short", YEL"通泗街"NOR);
    set("long", @LONG
通泗街由大块青石砌成，两边整齐的种着槐树，树下各有一道排水沟。北边
是扬州官衙，门前立着一对石狮，门上挂一匾额「扬州」。行人到此多加快脚步，
免惹是非，车马亦加上一鞭，加速通过。南面都是民宅，几条小巷曲折穿插其中，
偶然有一顶轿子进出。
LONG
    );
    set("outdoors", "yangzhou");
    set("no_kill", "yangzhou");
    set("objects", ([
        __DIR__"npc/xunbu" : 1,
"/d/place/wiz/locker"   :   1, 
    ]));
    set("exits", ([ /* sizeof() == 3 */
        "north" : __DIR__"guanya",
	"southeast" : __DIR__ "caohe_cexiang",
        "west" : __DIR__"tongsi_men",
        "east" : __DIR__"xiaojie",
    ]));

    setup();
}

void init()
{
    add_action( "do_enter", ({ "enter", "jinru" }) );
    if (wizardp(this_player()))
    {
        add_action("do_list", ({ "list" }) );
    }
}

int do_enter( string arg )
{
    object me = this_player();
    notify_fail("没有你想要进入的新房或没经允许.\n");
    if ( ! arg )
        return 0; // should be help msg..
    if ( arg == me->query("id") || arg == me->query("have_married/id") ||
        me->query_temp(arg + " invited") || wizardp(me) )
    {
        object room = load_object("/d/place/player/" + arg );
        if ( !room )
            return 0;
		if ( me->id(arg) )
			arg = "自己";
		tell_room(room, me->name() + "走了进来。\n");
        me->move(room);
		tell_room(this_object(), me->name() + "离开了这里，进入了 " +
                room->query("short") + "。\n");
		tell_object( me, "你进入了 " + room->query("short") + "。\n");
        return 1;
    }
    return 0;
}

int do_list(string arg)
{
    int i;
    string * list;
    string ret;
    mapping m;
	if (!wizardp(this_player()))
		return 0;
    i = 0;
    printf("可以进入的新房:\n");
    list = keys(m);
    list = sort_array(list, (: $1 > $2 ? 1 : -1 :));
    ret = "";
    foreach (string s in list )
    {
        ret += sprintf("%-15s", s);
        i ++;
        if ( i % 5 == 0 )
           ret += "\n";
    }
    ret += "\n";
    this_player()->start_more((ret));
    return 1;
}
