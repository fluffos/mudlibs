inherit ROOM;

void create()
{  
    set("short","小店");
    set("long",@LONG
这是一家专供过往行人驻足歇脚的小店，入座的大多是些囊中羞涩的穷苦平
民，其中有些人身背长刀，袒露胸膛，看得出是练过硬功夫的。在这样的地方歇
息，最好是尽量少说话，免得白惹出些事端来，于人于己都不是什么好事。
LONG);
    set("exits",([
        "east"  : __DIR__"dajie2",
    ]));

    set("objects",([
        __DIR__"npc/waiter" : 1,
        __DIR__"npc/man" :1,
        "/clone/eat/liquid/hulu" :1,
    ]));

    setup();
}

