#include <ansi.h>
#include <room.h>
inherit DOOR_ROOM;

void create() {
  set("short", GRN "后院花园" NOR);
  set("long", @LONG
这里是一个小小的花园，几座形态奇兀的假山，环着一个十步见方的池塘，
塘中种着荷花，菱角；几条金鲤鱼悠闲地游来游去。头顶上是高大的榆树，池
边几块青石，一张白玉石桌，别有风趣。南墙角上有一口井，井台上立着一只
木雕彩绘的仙鹤；乍看上去，还真以为是活物呢!!
LONG);

  set("exits", ([
    "southwest": __DIR__ "dxiangf",
  ]));

  set("resource/water", 1);
  set("fillplace", "青石井");
  set("watername", "井水");

  create_door("southwest", "垂花青缎门帘", "northeast", DOOR_CLOSED);
  setup();
}

void init() {
  add_action("do_tiao", "jump");
}

int do_tiao(string arg) {
  object ppl = this_player();

  if (!arg || (arg != "jing" && "well" != arg)) {
    return notify_fail("你要往那里跳啊？\n");
  }

  if (!ppl->can_act()) {
    return notify_fail("你正忙着呢！\n");
  }

  if (ppl->query("marks/left_funiu") != 1) {
    message_vision(HIM "$N跳下水井，溅起很大的水花，在井里扑腾了半天，好不容易才爬了上来。”\n" NOR, ppl);
    ppl->unconcious();
    return 1;
  }

  PLACE_D->drop_all_users(ppl);
  message_vision(HIG "$N跳下水井，居然找到了一条密道!”\n" NOR, ppl);
  ppl->move(__DIR__ "mishi");
  ppl->start_busy(5);

  return 1;
}
