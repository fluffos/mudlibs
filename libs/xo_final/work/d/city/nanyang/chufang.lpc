#include <ansi.h>
#include <room.h>

inherit KITCHEN_ROOM;

void create()
{
    set("short", "厨房");
    set("long", @LONG
这里是负责供应柯府上上下下一百多人一日三餐的大厨房；不过，老爷夫人
和小姐的饭菜并不在这里做。厨房里整天都是乱哄哄的：有时开灶煮饭，有时烧
水烹茶；不动火时，厨娘们也要忙着择菜，和面。靠外墙根有两张桌子，是供府
里的徒弟，食客们用餐的。
LONG
    );

    set("item_desc",([
          "桌子" : "一张干干净净的长条木板桌，两个人正在你身边坐(zuo)着吃饭。\n",
    ]));

    set("exits",([
        "north" : __DIR__"qianyuan",
    ]));

    set("objects",([
          __DIR__"npc/chuniang" : 1,
    ]));

    set("family", "伏牛派");

    ::create();
}

int can_zuo(object me)
{
    if ( !me->query_temp("lin_marks/暂住") )
    {
        tell_object(me, "哪儿来的饿死鬼？想白吃吗？！\n\n");
        return 0;
    }

    return 1;
}

int do_zuo(object me)
{
    me = this_player();

    if ( !objectp(present("chu niang", environment(me))) )
    {
        return notify_fail("可是厨娘已经死了。\n");
    }

    return ::do_zuo(me);
}

