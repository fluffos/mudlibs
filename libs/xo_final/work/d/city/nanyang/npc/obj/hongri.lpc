#include <ansi.h>
#include <weapon.h>

inherit BLADE;

void create() {
  set_name(CYN "虹日刀" NOR, ({ "hong ri dao", "dao", "blade" }));
  set_weight(1500);

  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一口精光四射的宝刀。\n");
    set("unit", "口");
    set("value", 10000);
    set("material", "steel");
  }
  init_blade(26);

  set("wield_msg", "$N拿起$n握在手中。\n");
  set("unwield_msg", "$N将手中的$n放下。\n");

  setup();
}
