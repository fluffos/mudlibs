// louluo.c
#include <ansi.h>

inherit NPC;

void create() {
  set_name("小喽罗", ({ "lou luo", "lou" }));
  set("gender", "男性");
  set("title", GRN "青松寨" NOR);
  set("str", 25);
  set("max_sen", 400);
  set("age", random(10) + 16);
  set("attitude", "aggressive");
  set("combat_exp", 500);

  setup();
  carry_object(__DIR__ "obj/cloth1")->wear();
}
