//liuqi.c
#include <ansi.h>

inherit NPC;

void create()
{
    set_name("刘七", ({ "liu qi","liu" }) );
    set("gender", "男性" );
    set("title",GRN"青松寨"NOR+"头领");
    set("str",40);
    set("age", 35);
    set("max_force",300);
    set("force",300);
    set("force_factor",30);
    set("max_kee",600);
    set_wugong("unarmed",100);
    set_wugong("taizu-quan",80,80,1);
    set_xiuwei_by_type("unarmed",250);
    set_wugong("blade",100,100);
    set_wugong("ditang-dao",70,60,1);
    set_xiuwei_by_type("blade",300);
    set_wugong("qinggong",100,100);
    set_xiuwei_by_type("dodge",100);
    set("attitude","aggressive");
    set("combat_exp", 8500);

    setup();
    carry_object(__DIR__"obj/cloth1")->wear();
    carry_object(BLADE_DIR"blade1")->wield();
}

