#include <ansi.h>

inherit NPC;
inherit F_VENDOR;

string ask_skills();

void create()
{
    set_name("吕七", ({ "lv qi","lv" }) );
    set("gender", "男性" );
    set("title","剑客");
    set("age", 35);

    set_wugong("xueying-jian", 120, 120,1);
    set_wugong("yirong-shu", 300, 300,1);
    set_xiuwei("sword", 1200);

    set("combat_exp", 40000);
    set("social_exp", 20000);

    set("can_teach", 1);

    set("inquiry",([
        "武功"   :    (: ask_skills :),
        "skills" :    (: ask_skills :),
    ]) );

    set( "vendor_goods", ([
        "易容油膏"      :   CLONE_DIR + "misc/yirong",
    ]) );    

    setup();
    carry_object(SWORD_DIR"sword1")->wield();
    carry_object(CLOTH_DIR"cloth1")->wear();
}

void init()
{
    object ob;
    if ( interactive(ob = this_player()) && !is_fighting() )
    {
        remove_call_out("greeting");
        call_out("greeting", 1, ob);
    }

    add_action("do_vendor_list", "list");
}

void greeting(object ob)
{
    if ( !ob || environment(ob) != environment() )
    {
        return;
    }

    command("look "+ob->query("id"));
}

int accept_teach( object ppl, string skill )
{
    if ( skill != "yirong-shu" )
    {
        return 0;
    }

    if ( ppl->query( "marks/lin/兰州秘密B" ) == 1  )        //如果没有学功夫的标记
    {
        command( "say “既然是金湘玉叫你来的，就教你些功夫吧。”" );
        return 1;
    }

    command( "say “天下可没有白占的便宜哦。“" );

    return 0; 
}

string ask_skills()
{ 
    command( "sigh" );
    return "当初我和夜猫子一起犯了事，金湘玉让我易容后躲到这里，\n
没想到还时有仇家来追杀。\n
你要是能把夜兄也救出来就好了，我们一起喝酒泡妞，岂不爽哉!";
}

