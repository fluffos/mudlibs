#include <ansi.h>

inherit __DIR__ "funiu.lpc";

void create() {
  set_name("柯百岁", ({ "ke baisui", "ke" }));
  set("gender", "男性");
  set("age", 71);
  set("str", 30);
  set("cor", 30);
  set("cps", 30);
  set("int", 25);
  set("ker", 24);
  set("kar", 30);
  set("dex", 30);

  set("inquiry", ([
    "武功": "我年轻时酷爱武术，收集了不少武功秘籍，无奈悟性不够啊。",
  ]));

  create_family("伏牛派", 1, HIW "掌门人" NOR);
  set("class", "funiu");
  set("no_kill", "funiu");
  set("combat_exp", 100000);
  set("social_exp", 800000);
  set("positive_score", 50000);

  set_wugong("ke-xinfa", 300, 300, 1);

  set_wugong("jiben-quanfa", 300, 300, 0);
  set_wugong("taizu-quan", 300, 300, 0);
  set_wugong("zhuifeng-quan", 300, 300, 1);

  set_wugong("whip", 300, 300, 0);
  set_wugong("baisheng-bian", 300, 300, 1);

  set_wugong("qinggong", 300, 300, 0);
  set_wugong("xingyun-shenfa", 300, 300, 0);
  set_wugong("meihua-bu", 300, 300, 1);

  set_xiuwei_level_by_type("unarmed", 4);
  set_xiuwei_level_by_type("long", 7);
  set_xiuwei_level_by_type("dodge", 4);
  set_xiuwei_level_by_type("force", 5);
  set_xiuwei_level_by_type("zonggang", 5);

  setup();

  carry_object(__DIR__ "obj/goldwhip")->wield();
  carry_object(CLOTH_DIR "cloth5")->wear();
}

void init() {
  object me = this_player();

  ::init();

  if (me->query("family/family_name") == "伏牛派") {
    call_out("varify_class_score", 1, me);
  }
}

void varify_class_score(object me) {
  if (!me || environment(me) != environment(this_object())) {
    return;
  }

  if (me->query("family/family_name") != "伏牛派") {
    return;
  }

  if (me->query("class_score/伏牛派") < -20) {
    command("heng " + me->query("id"));
    message_vision("柯百岁对$N怒气冲冲地说道：'你目无尊长，干下如此多伤害同门?!\n"
      "之事，竟然还有胆子来见我???!!\n", me);
    kill_ob(me);
    me->fight_ob(this_object());
  }
}

int accept_apprentice(object ob) {
  if (ob->query("PKS") > 30) {
    message_vision(
      "柯百岁对$N说：“阁下在江湖上劣迹已经出了名了，老夫断乎不会收下您这样\n"
      + "的人物!!!!\n", ob);
    command("heng " + ob->query("id"));
    return 0;
  }

  message_vision("柯百岁高兴对$N笑了笑，说：很好很好。\n", ob);
  return ::accept_apprentice(ob);
}

int accept_chushi(object me) {
  if (me->query_jibie("baisheng-bian") < 50) {
    me->add("class_score/伏牛派", -10);
    message_vision("柯百岁冷冷地瞪了$N一眼，说：'你的功夫还学得很不够，就想走了?'\n", me);
    tell_object(me, "你还得练练本门的功夫再说吧。\n");
    return 0;
  }

  if (me->query("age") < 20) {
    message_vision("柯百岁对$N笑了笑,说：'你的年纪太小，先不要急着闯荡江湖嘛。'\n", me);
    tell_object(me, "过两年再说吧。\n");
    return 0;
  }

  return 1;
}

void talk_chushi(object me) {
  object ob;

  message_vision("柯百岁看了看$N,叹了口气,说：'既是这样,我也就不久留你了，但愿你能再找到更好的师傅。\n"
    "到时候,可不要忘记为师啊，呵呵。'\n", me);
  message_vision("柯百岁拿出一些银子交给$N，说：'这些银两，你带着路上用吧，算是为师的一点礼物。\n", me);
  ob = new(MONEY_DIR "silver");
  ob->set_amount(100);
  ob->move(me);
  message_vision("$N向师傅恭恭敬敬地磕了四个头，就此离开伏牛派，去闯荡江湖了。\n", me);

  ob->set("marks/left_funiu", 1);

  tell_object(me, "为师年少时收集的武功秘籍就在花园旁边的密室里，你现在可以进去了。\n");
}

int accept_betray(object me) {
  return 1;
}

int refuse_killing(object me) {
  if (me->query("family/family_name") == "伏牛派") {
    me->set("class_score/伏牛派", -50);
    message_vision("柯百岁愤怒地对$N喝了一声，道：“老夫收徒四十余年，还没有见过你这样的叛逆！！！\n", me);
    CRIME_D->set_crime(me, "funiu");
  }

  message_vision("柯百岁镇静地看了看$N，说：“阁下进招吧！今天老夫就用这条老命陪阁下玩玩儿！！\n", me);

  return 0;
}
