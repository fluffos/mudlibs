//tang.c
#include <ansi.h>

inherit NPC;

void create()
{
    set_name("汤小泉", ({ "tang xiaoquan","tang" }) );
    set("gender", "男性" );
    set("title",GRN"青松寨"RED"二寨主"NOR);
    set( "negative_score", 3830);  
    set("str",34);
    set("age", 37);
    set("max_kee",1500);
    set("max_gin",1000);
    set("max_sen",1000);
    set("max_force",2000);
    set("force",2000);
    set("force_factor",200);
    set_wugong("taizu-quan",80,80,1);
    set_xiuwei_by_type("unarmed",3201);
    set_wugong("wuhu-dao",100,70,1);
    set_xiuwei_by_type("blade",3201);
    set("attitude","aggressive");
    set("combat_exp", 18500000);

    setup();
    carry_object(__DIR__"obj/cloth1")->wear();
    carry_object(__DIR__"obj/hongri")->wield();
}

