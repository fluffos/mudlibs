#include <ansi.h>

inherit __DIR__"funiu.lpc";

mixed help_me(object me);

void create()
{
    set_name("过彦之", ({ "guo yanzhi","guo" }) );
    set("gender", "男性" );
    set("age", 29);
    set("str", 30);
    set("cor", 30);
    set("cps", 30);
    set("int", 35);
    set("ker", 24);
    set("kar", 30);
    set("dex", 30);
    set("talk_limit",([
        "marks/lin/伏牛百胜" : 0,
    ]));
    set("talk_msg",({
        "百胜鞭法是我派的镇派绝技，若非深得掌门人的赞许，是没有机会学到的，就是学了，\n"
        "也不许随便传给别人。\n",
        "要想学习百胜鞭法，就要先作些给我伏牛派光大门户的事情呀！\n",
    }));

    set("inquiry",([
          "暂住" : (: help_me :),
          "住"   : (: help_me :),
          "帮助" : (: help_me :),
          "help" : (: help_me :),   
    ]));
    set("class_score/伏牛派", 1200);
    create_family("伏牛派", 2, "大弟子" );
    set("class", "funiu");
    set("no_kill","funiu");
    set("combat_exp", 40000);
    set("social_exp", 20000);
    set("positive_score", 5000);

    set_wugong( "ke-xinfa", 200, 200, 1);

    set_wugong( "jiben-quanfa", 200, 200, 0 );
    set_wugong( "taizu-quan", 200, 200, 0);
    set_wugong( "zhuifeng-quan", 200, 200, 1);

    set_wugong( "whip", 200, 200, 0 );
    set_wugong( "duanyun-bian", 300, 300, 1 );

    set_wugong( "qinggong", 200, 200, 0);
    set_wugong( "xingyun-shenfa", 200, 200, 0);
    set_wugong( "meihua-bu", 200, 200, 1);

    set_xiuwei_level_by_type("unarmed", 4);
    set_xiuwei_level_by_type("long", 4);
    set_xiuwei_level_by_type("dodge", 4);
    set_xiuwei_level_by_type("force", 4);
    set_xiuwei_level_by_type("zonggang", 4);

    setup();
    carry_object(__DIR__"obj/qlwhip")->wield();
    carry_object(CLOTH_DIR"cloth5")->wear();
}

void init()
{
    ::init();
}

mixed help_me(object me)
{
    if ( me->query("family/family_name") == "伏牛派" )
    {   
        return("过彦之气鼓鼓地说道：“这就是你的家了，倒什么乱！?”");
    }

    if ( me->query_temp("lin_marks/暂住") )
    {                                                 
        command("haha "+me->query("id"));
        return("“阁下不是已经住下了么？莫非阁下的头脑出了什么问题？”");
    }
    
    if ( me->query("PKS") > 10 )
    {
        return("“阁下身上的人命官司太多了，敝派薄土陋地，恐怕接纳不了。”");
    }
       
    message_vision("过彦之冲着$N笑了笑，说道：“既然阁下瞧得起柯府，我们自当尽力相待。\n", me);
    me->set_temp("lin_marks/暂住", 1);
    write ("过彦之同意你在柯府暂住了。\n");
    return 1;
}

int accept_teach( object who, string skill )
{
    if ( skill == "baisheng-bian" )
    {
        tell_object(who, "过彦之说：“这门功夫是本门的不传之密，虽是本派弟子，也不是都能学的。\n"
            "你去向师傅请教吧，看他老人家愿不愿意教给你。”\n");
        return 0;
    }

    return ::accept_teach(who, skill);
}

