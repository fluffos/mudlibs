#include <ansi.h>

inherit __DIR__"funiu.lpc";

void create()
{
    set_name("梁仲成", ({ "liang zhongcheng","liang" }) );
    set("gender", "男性" );
    set("age", 23);

    create_family("伏牛派", 2, "弟子" );
    set("class", "funiu");
    set("combat_exp", 7000);
    set("class_score/伏牛派", 400);
    set("social_exp", 200);
    set("talk_msg",({
        "北门外的伏牛山风景很好的，要不是有一伙歹徒盘踞在山上，城里的人肯定都会经常\n"
        "到山上去游玩的。\n",
        "几次想象师兄们一样去帮助官府围剿强盗，师傅就是不让，唉！\n",
        "你到过大理么？那里肯定很好玩吧？\n",
    }));

    set_wugong( "ke-xinfa", 100, 100, 1);

    set_wugong( "jiben-quanfa", 100, 100, 0 );
    set_wugong( "taizu-quan", 100, 100, 1);

    set_wugong( "whip", 100, 100, 0 );
    set_wugong( "kuangfeng-bian", 300, 300, 1 );

    set_wugong( "qinggong", 100, 100, 0);
    set_wugong( "xingyun-shenfa", 100, 100, 1);

    set_xiuwei_level_by_type("unarmed", 2);
    set_xiuwei_level_by_type("long", 2);
    set_xiuwei_level_by_type("dodge", 2);
    set_xiuwei_level_by_type("force", 2);
    set_xiuwei_level_by_type("zonggang", 2);

    set("no_kill", "funiu");
    setup();
    carry_object(CLOTH_DIR"cloth3")->wear();
    carry_object(__DIR__"obj/whip")->wield();
}

