#include <ansi.h>
#include <room.h>

inherit DOOR_ROOM;

void create()
{
    set("short",CYN "卧室" NOR);
    set("long",@LONG
这是柯府老爷柯百岁的卧房；收拾得简朴，干净利落。床上只一床青稠棉被，
一只黄柏木枕，六棱小桌上一只碎花青瓷自斟壶，一只梅花冻石杯；靠墙方几上
放着一只烟袋，墙上挂着一根黑黝黝的鞭子。
    西面是正房堂屋。再向里走就是柯府内眷们的居室了。
LONG);
    set("exits",([
        "west"  : __DIR__"zhengf",
    ]));

    set("objects",([
        __DIR__"npc/ke" : 1,
    ]));

    create_door("west", "榆木红漆门", "east", DOOR_CLOSED);
    setup();
}

