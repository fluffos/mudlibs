inherit SLEEP_ROOM;

void create() {
  set("short", "南厢房");
  set("long", @LONG
这是一间专门供上府求助的江湖侠客们小住的客房。来这里的人，有的是缺
钱，有的是躲仇人；对于这些人，只要没有大恶，伏牛派一律予以热情款待。东
墙下有一张方桌，两把椅子；床头上一张高几，茶具，香炉一一齐备。屋里打扫
得干干净净。
LONG);

  set("exits", ([
    "north": __DIR__ "dating",
  ]));

  set("objects", ([
    __DIR__ "npc/lv": 1,
  ]));

  set("need_clean", "伏牛派");

  ::create();
}

int forbid_sleep(object me) {
  if (!me->query_temp("lin_marks/暂住")) {
    return 1;
  }

  return 0;
}
