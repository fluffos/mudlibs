// 9-whip.c
// modified by Lin on March 29 ,1997
#include <ansi.h>
#include <weapon.h>

inherit WHIP;

void create()
{
    set_name(HIC "九节鞭" NOR, ({ "jiu jie bian","whip" }) );
    set_weight(500);
    if( clonep() )
        set_default_object(__FILE__);
    else {
        set("long","九根精光闪闪，六寸长短的钢棍，用钢环连在一起。好似一条鞭子.\n");
        set("unit", "条");
        set("value", 3200);
        set("material", "steel");
    }
    init_whip(50);

    set("wield_msg", "$N将一条$n从腰间解下来，握在手中。\n");
    set("unwield_msg", "$N将手中的$n束在腰间。\n");

    setup();
}

