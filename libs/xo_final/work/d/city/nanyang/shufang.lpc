#include <ansi.h>
inherit ROOM;

void create()
{
    set("short", "内书房" );
    set("long",@LONG
柯百岁其人一生习武，于文字上没有半点学问；可是因为朋友多，不得不也
布置出一间书房来，以便新朋老友们聚会之用。这间“书房”与别的书房不同的
是：房中没有一架书橱，却是四面墙上都挂着兵器，皆是嵌金镶玉，灿烂辉煌，
那些都是柯百岁珍爱的收藏。
LONG);

    set("exits",([
        "north" : __DIR__"tianjing",
    ]));

    set("search_things",([
        "墙" : __DIR__"obj/whip"  ,
    ]) );

    set("need_clean","伏牛派");

    set("objects",([
        WHIP_DIR"whip" : 3,
    ]));

    setup();
}

