//  By lin
//  Hydra copied from lanzhou

#include <ansi.h>
inherit NPC;
int ask_me( object );
string talk_me( object );

void create()
{
    set_name( "乞丐", ({ "qi gai", "qigai", "beggar" }) );
    set( "gender", "男性" );
    set( "combat_exp", 1000000 );
    set( "per", 14 );
    set( "force", 4500 );
    set( "max_force", 4500 );
     //set_wugong("qinglong-zhua",150,150,1);
    set_xiuwei_by_type("unarmed",2000+random(1000));
    set_wugong("meihua-bu",100,100,1); 
    set_xiuwei_by_type("dodge",2000);
    set( "chat_chance", 10 );
    set( "chat_msg", ({
        "乞丐说道：“好心的大爷哪～赏我要饭的几文钱吧～”\n",
        "乞丐懒洋洋地打了个哈欠。\n",
        (:random_move:),
    }) );
    set("chat_chance_combat", 10);
    set("chat_msg_combat", ({
        "乞丐喝道：来啊！大家一起上,快把这个王八蛋拿下！\n",
    }));
    
    setup();
    carry_object( CLOTH_DIR + "cloth2" )->wear();
}

int accept_object( object ppl, object obj ) //收了东西说好话。
{
    command( "smile" );
    command( "say “多谢这位" + RANK_D->query_respect( ppl ) +
        "，您好心一定会有好报的！”" );
    return 1;
}


void init()
{
    //object ppl = this_player();

    ::init();
}
