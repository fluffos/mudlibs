// Room: /d/city/matou/dali_yidao.c

inherit ROOM;

string look_bangwen();

void create() {
  set("short", "驿道");
  set("long", @LONG
这是大理国为传公文，调军队，对大宋通商，役使数万民工修成的大道。大
道上不时有身着官服的人疾驰而过，行人纷纷闪在一旁。边上有家驿站，门口贴
着一张榜文。
驿站边上停着一辆马车。
LONG
  );
  set("exits", ([ /* sizeof() == 1 */
    "west": "/d/city/dali/nanmen",
    "north": __DIR__ "shichang",
  ]));
  set("objects", ([]));
  set("outdoors", "xinan");
  set("detail", ([ /* sizeof() == 1 */
    "榜文": (: look_bangwen :),
  ]));
  set("no_clean_up", 0);
  set("long2", "这是大理国为传公文，调军队，对大宋通商，役使数万民工修成的大道。大
道上不时有身着官服的人疾驰而过，行人纷纷闪在一旁。边上有家驿站，门口贴
着一张榜文。
驿站边上停着一辆马车。
");
  set("long1", "这是大理国为传公文，调军队，对大宋通商，役使数万民工修成的大道。大
道上不时有身着官服的人疾驰而过，行人纷纷闪在一旁。边上有家驿站，门口贴
着一张榜文。
");

  setup();
  //	//place_program(ROOM);
}
int valid_leave(object me, string dir) {
  if (userp(me)) return ::valid_leave(me, dir);
  if (me->is_character() && dir == "enter" && !me->query("can_enter"))
    return 0;
  return ::valid_leave(me, dir);
}

string look_bangwen() {
  return "      由于大理到扬州路途遥远，道路难走，大理国段王爷特出资开通\n"
    "      从大理到扬州的定期马车，方便扬州于大理的人员物资的交流。\n\n\n"
    "                       大理国主 段\n";

}


void init() {
  object che;
  if (!che = find_object(__DIR__ "mache"))
    che = load_object(__DIR__ "mache");
  if (che = find_object(__DIR__ "mache"))
    if (!che->query("moving")) {
      if (!query("exits/enter")) {
        set("exits/enter", __DIR__ "mache");
        che->set("exits/out", __FILE__);
      }
      remove_call_out("on_road");
      call_out("on_road", 10, che, this_object(), 0);
      che->set("moving", 1);
    }
  return;
}

void che_start(int i) {
  switch (i) {
    case 0:
      remove_call_out("open_yangzhou");
      call_out("open_yangzhou", 1);
      i = 1;
      break;
    case 1:
      remove_call_out("open_dali");
      call_out("open_dali", 1);
      i = 0;
      break;
    default: break;
  }
}

void open_dali() {
  object che;
  if (!che = find_object(__DIR__ "mache"))
    che = load_object(__DIR__ "mache");
  if (che = find_object(__DIR__ "mache")) {
    message("vision", "只觉得马车渐渐慢了下来，车夫冲车厢里喊了一声：“大理到了！ ”\n",
      che);
    che->set("exits/out", __FILE__);
    message("vision", "一辆马车渐渐停了下来，一个旅客把车门打开，放下一架木梯。\n", this_object());
    set("exits/enter", __DIR__ "mache");
  }
  set("long", (string)this_object()->query("long2"));
  remove_call_out("on_road");
  call_out("on_road", 10, che, this_object(), 0);
}

void open_yangzhou() {
  object che, room;
  if (!room = find_object(__DIR__ "yangzhou_yidao"))
    room = load_object(__DIR__ "yangzhou_yidao");
  if (room == find_object(__DIR__ "yangzhou_yidao")) {
    message("vision", "一辆马车渐渐停了下来，一个旅客把车门打开，放下一架木梯。\n", room);
    room->set("exits/enter", __DIR__ "mache");
    room->set("long", (string)room->query("long2"));
  }
  if (!che = find_object(__DIR__ "mache"))
    che = load_object(__DIR__ "mache");
  if (che == find_object(__DIR__ "mache")) {
    message("vision", "只觉得马车渐渐慢了下来，车夫冲车厢里喊了一声：“扬州到了！ ”\n",
      che);
    che->set("exits/out", __DIR__ "yangzhou_yidao");
  }
  room->set("long", (string)room->query("long2"));
  remove_call_out("on_road");
  call_out("on_road", 10, che, room, 1);
}

void on_road(object che, object room, int i) {
  room->set("long", (string)room->query("long1"));
  message("vision", "车夫一扬鞭子，喊了一声“走喽~~~~~~~”，一个旅客收起木梯，关好车门。\n" +
    "马车缓缓起开了。\n", che);
  che->delete("exits/out");
  message("vision", "车夫一扬鞭子，喊了一声“走喽~~~~~~~”，一个旅客收好木梯，关上车门。\n" +
    "马车缓缓向远方驶去。\n", room);
  room->delete("exits/enter");
  remove_call_out("che_start");
  call_out("che_start", 70, i);
  return;
}
