inherit VRM_SERVER;

void create() {
  string *room_desc = ({
    "这里是一条泥泞的小路，四周毒虫聚集。\n",
    "四周弥漫着一股腐臭的气息。\n",
  });

  // 迷宫房间所继承的物件的档案名称。
  set_inherit_room(__DIR__ "forestroom");

  //set_npcs_rate(85);
  set_maze_traps(0);
  set_lonely_create(1);
  set_maze_boxs(0);
  set_maze_nodeath(1);

  //刷新时间
  set_maze_refresh(15 * 60);

  //迷宫的单边长
  set_maze_long(30);

  //入口方向(出口在对面)
  set_entry_dir("west");

  //入口与区域的连接方向
  set_link_entry_dir("west");

  //入口与区域的连接档案名
  set_link_entry_room(__DIR__ "bigtree");

  //出口与区域的连接方向
  set_link_exit_dir("east");

  //出口与区域的连接档案名
  set_link_exit_room(__DIR__ "home");

  //入口房间短描述
  set_entry_short("小树林入口");

  //入口房间描述
  set_entry_desc(@LONG
循着腐烂的气息，你小心翼翼的向密林深处走去。
LONG);

  //出口房间短描述
  set_exit_short("小树林边缘");

  //出口房间描述
  set_exit_desc(@LONG
经过一番血战，你终于看到了前方的一片光明。
LONG
  );

  //迷宫房间的短描述
  set_maze_room_short("荒芜泥泞的小路");

  //迷宫房间的描述，如果有多条描述，制造每个房
  //间的时候会从中随机选择一个。
  set_maze_room_desc(room_desc);

  // 迷宫房间是否为户外房间？
  set_outdoors(1);
}
