#include <ansi.h>

inherit ROOM;

void create()
{
    set("short", "林间小路");
    set("long", @LONG
小路坑洼不平，很是难走。
LONG
    );

    set("outdoors", "newbie");

    set("objects", ([ 
        __DIR__ "npc/muren"  : 1,
    ]));

    setup(); 
}

void init()
{
    object muren;
    object me = this_player();

    if ( !userp(me) )
    {
        return;
    }

    if ( !wizardp(me) && (1 <= me->query_xiuwei_jibie("unarmed") || 1 <= me->query_xiuwei_jibie("dodge")) )
    {
        tell_object(me, "你是怎么混进来的。\n");
        me->move(__DIR__ "bigtree", 1);
        return;
    }

    if ( !present("mu ren", this_object()) )
    {
        muren = new(__DIR__ "npc/muren");
        if ( muren )
        {
            muren->move(this_object());
        }
    }

    add_action("do_look", "look" );
    add_action("do_back", "back" );
}

int do_look(string arg)
{
    if ( !wizardp(this_player()) )
    {
        if ( "east" == arg || "west" == arg || "north" == arg || "south" == arg )
        {
            tell_object(this_player(), "四周围弥漫着剧毒的瘴气，你什么都看不到。\n");
            return 1;
        }
    }

    return 0;
}

varargs int do_back(string arg)
{
    this_player()->move(__DIR__ "bigtree");

    return 1;
}

