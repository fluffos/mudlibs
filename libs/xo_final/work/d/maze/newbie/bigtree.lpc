#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "大树");
  set("long", @LONG
走到这里，面前是一颗无比巨大的参天大树，树根附近有个一人宽的小洞。
你可以试试钻(zuan)进去看看。
LONG
  );

  set("exits", ([
    "east": __DIR__ "migong/entry",
    "south": "/d/place/newbie/village/forest",
  ]));

  set("outdoors", "newbie");

  set("no_fight", 1);

  setup();
}

void init() {
  add_action("do_enter", "zuan");
}

int do_enter(string arg) {
  object me;
  object room;

  me = this_player();

  room = call_other(__DIR__ "migong", "random_room");
  if (!room) {
    write("加载房间失败。\n");
    return 1;
  }

  message_vision(HIW "只见一道白光，$N已经消失了。\n" NOR, me);

  me->move(room);

  message_vision(HIW "$N出现在这里。\n" NOR, me);

  return 1;
}
