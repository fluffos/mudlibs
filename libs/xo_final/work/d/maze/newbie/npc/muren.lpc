inherit NPC;

void create()
{
    set_name("木人",({ "mu ren", "ren" }) );
    set("long",@LONG
一个傻乎乎的木人。
LONG    );

    set("attitude", "friendly");

    set("age", 45);
    set("str", 50);
    set("int", 50);
    set("con", 50);
    set("dex", 50);
    set("cor", 50);
    set("spi", 50);
    set("cps", 50);

    set_hp("gin", 100000);
    set_hp("kee", 100000);
    set_hp("sen", 100000);

    set("force", 30000);
    set("max_force", 30000);
    set("force_factor", 0);

    set("combat_exp", 2500000);

    set("env/shili", 100);
    set("env/attack", 50);
    
    set_wugong("jiben-neigong", 200, 200, 1);
    set_wugong("jiben-quanfa", 200, 200, 1);
    set_wugong("jiben-qinggong", 200, 200, 1);

    set_xiuwei_level_by_type("unarmed", 1);
    set_xiuwei_level_by_type("dodge", 1);

    setup();
}

int is_tongshi_of( object ppl )
{
    return 1;
}

int accept_duilian( object ppl )
{
    return 1;
}

int duilian_ob( object ppl )
{
    delete_all_wugong();

    set_wugong("jiben-neigong", ppl->query_jibie("jiben-neigong"), ppl->query_lingwu("jiben-neigong"), 1);
    set_wugong("jiben-quanfa", ppl->query_jibie("jiben-quanfa"), ppl->query_lingwu("jiben-quanfa"), 1);
    set_wugong("jiben-jianfa", ppl->query_jibie("jiben-jianfa"), ppl->query_lingwu("jiben-jianfa"), 1);
    set_wugong("jiben-qinggong", ppl->query_jibie("jiben-qinggong"), ppl->query_lingwu("jiben-qinggong"), 1);

    set_xiuwei_by_type("unarmed", ppl->query_xiuwei_by_type("unarmed"));
    set_xiuwei_by_type("sword", ppl->query_xiuwei_by_type("sword"));
    set_xiuwei_by_type("dodge", ppl->query_xiuwei_by_type("dodge"));
    set_xiuwei_by_type("force", ppl->query_xiuwei_by_type("force"));
    set_xiuwei_by_type("combat_exp", ppl->query_xiuwei_by_type("combat_exp"));
    set_xiuwei_by_type("zonggang", ppl->query_xiuwei_by_type("zonggang"));

    set("combat_exp", ppl->query("combat_exp"));

    set("force_factor", 0);

    if ( ppl->query_temp("weapon") )
    {
        if ( !present("zhu jian", this_object()) )
        {
            carry_object(SWORD_DIR "zhujian");
        }
        command("wield zhu jian");
    }
    else
    {
        command("unwield all");
    }

    return ::duilian_ob(ppl);
}

