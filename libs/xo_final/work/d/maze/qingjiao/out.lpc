#include <ansi.h>
inherit ROOM;

#include "/d/maze/qingjiao/qingjiao.h"

void create() {
  set("short", "花海");
  set("long", @LONG 
放眼望去，但见天地间仿佛已被鲜花充满，但却是无人认得出的花
朵，只觉得这些花无比的鲜艳，无比的美丽。真是令人想不到，荒漠之
中，竟有这样的花海。

LONG
  );
  set("outdoors", "qingjiao");

  set("exits", ([
    "out": __FILE__,
  ]));

  setup();
}

int valid_leave(object me, string dir) {
  int i;
  object *inv;

  inv = all_inventory(this_object());

  if (userp(me) && dir == "out") {
    for (i = 0; i < sizeof(inv); i++) {
      if (inv[i] != me && living(inv[i])) {
        return notify_fail("看起来" + inv[i]->query("name") + "不会让你离开的。\n");
      }
    }

    if (!me->query("shilian/" + me->query_temp("shilian/family") + "/" + me->query_temp("shilian/master"))) {
      me->set(
        "shilian/" + me->query_temp("shilian/family") + "/" + me->query_temp("shilian/master"),
        1
      );
      tell_object(me, HIY "【师门】恭喜你！你完成了" + me->query_temp("shilian/master_name") +
        "的试炼任务，符合要求即可学习技能！\n" NOR);
      message("channel:rumor", HIB + "【试炼大阵】" + me->query("name") +
        "完成了" + me->query_temp("shilian/master_name") +
        "的试炼任务，可以向其学习武功了。\n" + NOR, users());
      me->save();
    }

    leave_maze(me);

    return -1;
  }

  return ::valid_leave(me, dir);
}
