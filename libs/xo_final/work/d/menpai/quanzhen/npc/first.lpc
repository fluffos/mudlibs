#include <ansi.h>
inherit F_FIRST;

void create() {
  set("master_dir", __DIR__ "npc" + "/wang");
  set("start_room", __DIR__ "/datang1");
  ::create();
}


string zm_apply() {
  object ob = this_player();
  if (query("class", ob) != "taoist") {
    return "本教例由全真道士掌门！";
  }
  return ::zm_apply();
}
