inherit F_NEW_MASTER;

#include "quanzhen_master.h"

void create() {
  set_name("宋德方", ({ "song defang", "song" }));
  set("gender", "男性");
  set("age", 24);
  set("class", "swordman");
  set("long",
    "他就是全真教第三代弟子中的好手，马钰的俗家弟子。\n");
  set("attitude", "friendly");
  set("shen_type", 1);
  set("str", 26);
  set("int", 25);
  set("con", 25);
  set("dex", 26);

  set("env/wimpy", 60);

  /*
    set("chat_chance_combat", 60);
    set("chat_msg_combat", ({
        (: exert_function, "powerup" :),
        (: exert_function, "recover" :),
        (: perform_action, "strike.ju" :),
        (: perform_action, "strike.ju" :),
        (: perform_action, "strike.ju" :),
        (: perform_action, "sword.ding" :),
        (: perform_action, "sword.ding" :),
        (: perform_action, "sword.ding" :),
    }));
*/

  set("combat_exp", 160000);

  set_wugong("xiantian-gong", 150, 150, 1);
  set_wugong("baibian-daxue", 300, 300, 1);
  set_wugong("jiben-qinggong", 150, 150, 1);

  set_xiuwei_level_by_type("force", 3);
  set_xiuwei_level_by_type("dodge", 3);
  set_xiuwei_level_by_type("short", 4);
  set_xiuwei_level_by_type("zonggang", 3);

  create_family("全真教", 3, "弟子");

  set("inquiry", ([
    "全真教": "我全真教是天下道家玄门正宗。\n",
  ]));

  ::create();
  setup();

  carry_object(SHORT_DIR "dagger")->wield();
  carry_object(__DIR__ "obj/greyrobe")->wear();
}
