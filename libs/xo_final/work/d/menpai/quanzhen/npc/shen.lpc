inherit F_NEW_MASTER;

#include "quanzhen_master.h"

void create()
{
    set_name("申志凡", ({"shen zhifan", "shen"}));
    set("gender", "男性");
    set("age", 24);
    set("class", "taoist");
    set("long",
    "他就是全真教第三代弟子中的好手，郝大通的弟子。\n");
    set("attitude", "friendly");
    set("shen_type",1);
    set("str", 26);
    set("int", 25);
    set("con", 25);
    set("dex", 26);

    set("combat_exp", 160000);

    set_wugong("xiantian-gong", 150, 150, 1);
    set_wugong("taizu-quan", 300, 300, 1);
    set_wugong("jiben-qinggong", 150, 150, 1);

    set_xiuwei_level_by_type("force", 3);
    set_xiuwei_level_by_type("dodge", 3);
    set_xiuwei_level_by_type("unarmed", 2);
    set_xiuwei_level_by_type("zonggang", 3);

    create_family("全真教", 3, "弟子");

    set("inquiry", ([
        "全真教" :  "我全真教是天下道家玄门正宗。\n",
    ]) );

    ::create();
    setup();

    carry_object(__DIR__"obj/greyrobe")->wear();

}

