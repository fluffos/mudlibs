// huizheng.c 慧正--龙树院的知事
// written by hydra 19980513 


#include <ansi.h>

inherit __DIR__ "hui_master.lpc";

string change_master(object);
void give_letter(object);

void create() {
  seteuid(getuid());
  set_name("慧正", ({ "hui zheng", "zheng", "hui", "bonze" }));
  set("long", @LONG
少林龙树院知事慧正师傅。据说他为人正直，在出家前由于打抱不平
时被玄寂大师遇上，大师因其为人而受他为徒。
LONG
  );
  set("title", RED "少林寺" BLU "龙树院" HIC "知事" NOR);
  set("gender", "男性");
  set("age", 60);
  set("class", "bonze");

  set("inquiry", ([
    "比武": (: change_master :),
    "升级": (: change_master :),
  ]));

  set("str", 35);
  set("int", 23);
  set("spi", 30);
  set("con", 34);

  set_wugong("banruo-xinfa", 300, 300, 1);
  set_wugong("weituo-chu", 300, 300, 1);
  set_wugong("shaolin-shenfa", 300, 300, 1);

  set_xiuwei_level_by_type("force", 5);
  set_xiuwei_level_by_type("unarmed", 5);
  set_xiuwei_level_by_type("dodge", 5);
  set_xiuwei_level_by_type("zonggang", 5);

  set("combat_exp", 2400000);
  set("social_exp", 500000);
  set("positive_score", 30000);
  set("negative_score", 0);
  set("class_score", 10000);

  create_family("少林派", 37, "弟子");
  set("family/belong", BLU "龙树院" NOR);

  set("no_kill", "shaolin");
  setup();
  carry_object(CLOTH_DIR "sengyi3")->wear();

}

#include "hui_master.h";
#include "zhishi.h";
