// huinian.c 慧念--龙树院的master
// written by hydra 19980513 


#include <ansi.h>

inherit __DIR__ "hui_master.lpc";

void create() {
  seteuid(getuid());
  set_name("慧念", ({ "hui nian", "nian", "hui", "bonze" }));
  set("long", @LONG
少林龙树院的慧念师傅。他是慧字辈中年龄最老的，内力最高的一
位了。他座下的弟子也都以内力高著称。
LONG
  );
  set("title", RED "少林寺" BLU "龙树院" HIW "武僧" NOR);
  set("gender", "男性");
  set("age", 62);
  set("class", "bonze");

  set("str", 35);
  set("int", 24);
  set("spi", 30);
  set("con", 34);

  set_wugong("banruo-xinfa", 300, 300, 1);
  set_wugong("ruying-suixing", 300, 300, 1);

  set_xiuwei_level_by_type("force", 5);
  set_xiuwei_level_by_type("dodge", 5);
  set_xiuwei_level_by_type("zonggang", 5);

  set("combat_exp", 600000);
  set("social_exp", 500000);
  set("positive_score", 32000);
  set("negative_score", 0);
  set("class_score", 10000);

  create_family("少林派", 37, "弟子");
  set("family/belong", BLU "龙树院" NOR);

  set("no_kill", "shaolin");
  setup();
  carry_object(CLOTH_DIR "sengyi3")->wear();
}

#include "hui_master.h";

int lose_bihua(object ppl) {
  if (ppl->query_temp("hydra/shaolin/fight_master") == query("id")) {
    command("smile " + ppl->query("id"));
    command("say 好徒儿，有出息！");
    ppl->set_temp("hydra/shaolin/defeat_master", 1);
    ppl->delete_temp("hydra/shaolin/fight_master");
    command("say 你去找你慧正师叔说吧！");
  }
  return 1;
}
