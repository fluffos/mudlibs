#include <ansi.h>

inherit __DIR__"hui_master.lpc";

string do_accept(string msg,object me);
void penlty_killer(object);

void create()
{
    seteuid(getuid());
	set_name("慧见", ({ "hui jian", "hui", "jian", "bonze" }) );
	set("long",	"一个四十多岁的中年僧人，是玄痛大师的得力助手。\n"
			"负责戒律院的日常工作。\n");
	set("gender", "男性");
	set("age", 43);
	set("attitude", "friendly");
	set("class", "bonze1");

	set("str", 27);
	set("int", 35);
	set("spi", 30);
	set("con", 30);
	set("cps", 30);
	set("cor", 20);
	set("per", 30);
	set("kar", 30);

    set("force", 2000);
    set("max_force", 2000);
    set("force_factor", 40);
  
  set_wugong("banruo-xinfa", 300, 300, 1);
  set_wugong("fenghuo-gun", 300, 300, 1);
  set_wugong("shaolin-shenfa", 300, 300,1);
  
  set_xiuwei_level_by_type("force", 5);
  set_xiuwei_level_by_type("long", 4);
  set_xiuwei_level_by_type("dodge", 5);
  set_xiuwei_level_by_type("zonggang", 5);
	
    set("combat_exp", 180000);
    set("social_exp", 50000);
    set("positive_score",10000);
    set("negative_score",0);
    set("class_score",10000);

    create_family("少林派", 37, "弟子");
    set("title",RED"少林寺"CYN"戒律院"HIC"知事"NOR);

    set("no_kill","shaolin");	
    setup();
    carry_object(CLOTH_DIR"sengyi3")->wear();
    carry_object(LONG_DIR"qimei_gun")->wield();
}

int accept_object(object ppl,object obj)
{
    string msg;
    if ( ! userp(obj) ) 
    {
        command( "say 多谢了，不过贫僧不要这东西！" );
        return 0;
    }
    if ( obj->query("id") != ppl->query("hydra/shaolin/kaoyan_arrest") )
    {
        command( "say 多谢了，不过贫僧不要这东西！" );
        return 0;
    }   
    
    call_out( "penlty_killer",2,obj );

    if ( ppl->query("mud_age") > ppl->query("hydra/shaolin/kaoyan_time") )
    {
        ppl->delete("hydra/shaolin/can_ask_kaoyan");
        ppl->delete("hydra/shaolin/kaoyan_arrest");
        ppl->delete("hydra/shaolin/kaoyan_time");
        ppl->set("hydra/shaolin/lose_kaoyan",1);
        command( "sigh" );
        command( "say 事情是做的不错，可惜时间过了。");
        ppl->set("hydra/shaolin/allow_enter_shuku",3);
        command("say 不过方丈念你除恶有功，特许你进藏经阁书库参阅典籍三次，好自为之吧。");        
        log_file( "shaolin_kaoyan",sprintf( 
            "[%s]:%s(%s)没能完成了方丈的考验：缉拿杀人魔。\n",ctime(time()),
            ppl->name(1),geteuid(ppl) ));            
        return 1;
    }
    ppl->delete("hydra/shaolin/can_ask_kaoyan");
    ppl->delete("hydra/shaolin/kaoyan_arrest");
    ppl->delete("hydra/shaolin/kaoyan_time");
    ppl->set("hydra/shaolin/pass_kaoyan",1);
    LOG_D->do_log(ppl,"你成功地通过了方丈的考验，允许拜玄字辈为师！");
    log_file( "shaolin_kaoyan",sprintf( 
        "[%s]:%s(%s)完成了方丈的考验：缉拿杀人魔。\n",ctime(time()),
        ppl->name(1),geteuid(ppl) ));    
    msg = "不错，不错，行侠仗义当为我佛门弟子楷模！\n";
    msg += "好，现在，你可以找玄字辈师傅拜师去了！";
    command( "say " + msg );
    return 1;
}

void penlty_killer( object killer )
{
    message_vision( HIY"$N看了一眼$n，回头叫道：执法僧兵，把这大奸大恶之徒关入水牢。\n"+
        RED"两名僧兵答道：是！说着便把$n押走了。。。\n\n"NOR,this_object(),killer );
    killer -> move("/d/menpai/shaolin/shuilao1");
    killer -> apply_condition( "shuilao",50 );
}
