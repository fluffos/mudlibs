#include <ansi.h>

inherit __DIR__"xuan_master.lpc";

void create()
{
    seteuid(getuid());
    set_name("玄难", ({"xuan nan","xuannan","xuan","nan"}));
    set("long",@LONG
他是一位须眉皆白的老僧，脸上一付慈祥的表情。
这位威严的老僧便是少林寺达摩院的首座。
LONG   );
    set("title",RED"少林寺"MAG"达摩院"HIM"首座"NOR);
    set("rank_info/respect", "玄难大师");
    set("gender", "男性");
    set("attitude", "friendly");
    set("class", "bonze");
    set("family",([
        "title"         :"少林寺达摩院首座",
        "generation"    :36,
        "family_name"   :"少林派",
        "master_name"   :"灵门",
        "master_id"     :"ling men",
        "belong"        :MAG"达摩院"NOR,
        ]) );

    set("age", 76);
    set("str", 30);
    set("int", 35);
    set("con", 30);
    set("spi", 30);
    set("per", 28);

    set("combat_exp", 7000000);
    set("social_exp", 200000);
    set("class_score", 500000);
    set("positive_score",150000);

    set_wugong("yijin-jing", 300, 300, 1);
    set_wugong("jingang-zhang", 300, 300, 1);
    set_wugong("shaolin-shenfa", 300, 300,1);

    set_xiuwei_level_by_type("force", 6);
    set_xiuwei_level_by_type("unarmed", 8);
    set_xiuwei_level_by_type("dodge", 6);
    set_xiuwei_level_by_type("zonggang", 6);

    set("inquiry",([
        "武功" : "少林僧人习武只为健体强身，可不是为了逞强好胜。",
    ]) );

    set("no_kill","shaolin");
    setup();
    carry_object(CLOTH_DIR"jiasha2")->wear();
}

