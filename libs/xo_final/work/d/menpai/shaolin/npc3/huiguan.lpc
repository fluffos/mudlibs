#include <ansi.h>

inherit __DIR__ "hui_master.lpc";

void create() {
  seteuid(getuid());
  set_name("慧观", ({ "hui guan", "hui", "guan", "bonze" }));
  set("long", @LONG
少林般若堂的师傅，负责教授般若堂弟子的功夫，他精通江湖各大
门派的武功，但是于本门功夫却有些荒废了。
LONG
  );
  set("title", RED "少林寺" GRN "般若堂" HIW "武僧" NOR);
  set("gender", "男性");
  set("age", 45);
  set("class", "bonze");

  set("str", 35);
  set("int", 24);
  set("spi", 30);
  set("con", 34);

  set_wugong("banruo-xinfa", 300, 300, 1);
  set_wugong("xiangmo-zhang", 300, 300, 1);
  set_wugong("shaolin-shenfa", 300, 300, 1);

  set_xiuwei_level_by_type("force", 5);
  set_xiuwei_level_by_type("long", 5);
  set_xiuwei_level_by_type("dodge", 5);
  set_xiuwei_level_by_type("zonggang", 5);

  set("combat_exp", 800000);
  set("social_exp", 500000);
  set("positive_score", 22000);
  set("negative_score", 0);
  set("class_score", 10000);

  create_family("少林派", 37, "弟子");
  set("family/belong", GRN "般若堂" NOR);

  set("no_kill", "shaolin");
  setup();
  carry_object(CLOTH_DIR "sengyi3")->wear();
  carry_object(LONG_DIR "gangzhang")->wield();
}

#include "hui_master.h";

int lose_bihua(object ppl) {
  if (ppl->query_temp("hydra/shaolin/fight_master") == query("id")) {
    command("smile " + ppl->query("id"));
    command("say 好徒儿，有出息！");
    ppl->set_temp("hydra/shaolin/defeat_master", 1);
    ppl->delete_temp("hydra/shaolin/fight_master");
    command("say 你去找你慧鸣师叔说吧！");
  }
  return 1;
}
