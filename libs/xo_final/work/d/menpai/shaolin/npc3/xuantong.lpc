#include <ansi.h>

inherit __DIR__"xuan_master.lpc";

void create()
{
    seteuid(getuid());
    set_name("玄痛", ({"xuan tong","xuantong","xuan","tong"}));
    set("long",@LONG
他是一位须眉皆白的老僧，当他抬头扫视四周时，眼光无比威严。
在他的目光下，你不禁心里打起了小鼓，不知自己什么时候就会犯
过失，撞在老僧的手里。这位威严的老僧便是少林寺戒律院的首座。
LONG   );
    set("title",RED"少林寺"CYN"戒律院"HIM"首座"NOR);
    set("rank_info/respect", "玄痛大师");
    set("gender", "男性");
    set("attitude", "friendly");
    set("class", "bonze1");
    set("family",([
        "title"         :"少林寺戒律堂首座",
        "generation"    :36,
        "family_name"   :"少林派",
        "master_name"   :"灵门",
        "master_id"     :"ling men",
        "belong"        :CYN"戒律院"NOR,
        ]) );

    set("age", 67);
    set("str", 30);
    set("int", 26);
    set("con", 30);
    set("spi", 30);
    set("kar", 30);

    set("combat_exp", 700000);
    set("social_exp", 200000);
    set("class_score", 400000);
    set("positive_score",500000);

    set_wugong("yijin-jing", 300, 300, 1);
    set_wugong("longzhua-shou", 300, 300, 1);
    set_wugong("shaolin-shenfa", 300, 300,1);

    set_xiuwei_level_by_type("force", 6);
    set_xiuwei_level_by_type("unarmed", 6);
    set_xiuwei_level_by_type("dodge", 6);
    set_xiuwei_level_by_type("zonggang", 6);

    set("inquiry",([
        "武功" : "少林僧人习武只为健体强身，可不是为了逞强好胜。",
    ]) );

    set("no_kill","shaolin");
    setup();
    carry_object(CLOTH_DIR"jiasha2")->wear();
}

int refuse_killing( object me )
{
    command("wield blade");
    return ::refuse_killing(me);
}
