#include <ansi.h>

inherit __DIR__"xuan_master.lpc";

void create()
{
    seteuid(getuid());
    set_name("玄寂", ({"xuan ji","xuanji","xuan","ji"}));
    set("long",@LONG
他是一位须眉皆白的老僧，脸上一付慈祥的表情。
这位威严的老僧便是少林寺龙树院的首座，他负责给少林弟子每天
讲经说法。
LONG   );
    set("title",RED"少林寺"BLU"龙树院"HIM"首座"NOR);
    set("rank_info/respect", "玄寂大师");
    set("gender", "男性");
    set("attitude", "friendly");
    set("class", "bonze");
    set("family",([
        "title"         :"少林寺龙树院首座",
        "generation"    :36,
        "family_name"   :"少林派",
        "master_name"   :"灵门",
        "master_id"     :"ling men",
        "belong"        :BLU"龙树院"NOR,
        ]) );

    set("age", 65);
    set("str", 30);
    set("int", 32);
    set("con", 30);
    set("spi", 23);
    set("per", 32);

    set("combat_exp", 6000000);
    set("social_exp", 240000);
    set("class_score", 400000);
    set("positive_score",80000);

    //龙树院以内力见长，所以玄寂的内力极高
    set_wugong("yijin-jing", 300, 300, 1);
    set_wugong("yiwei-dujiang", 300, 300,1);

    set_xiuwei_level_by_type("force", 6);
    set_xiuwei_level_by_type("dodge", 8);
    set_xiuwei_level_by_type("zonggang", 6);

    set("inquiry",([
        "武功" : "少林僧人习武只为健体强身，可不是为了逞强好胜。",
    ]) );

    set("no_kill","shaolin");
    setup();
    carry_object(CLOTH_DIR"jiasha2")->wear();
}

