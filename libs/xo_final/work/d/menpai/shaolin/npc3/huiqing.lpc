#include <ansi.h>

inherit __DIR__ "hui_master.lpc";

void create() {
  seteuid(getuid());
  set_name("慧清", ({ "hui qing", "hui", "qing", "bonze" }));
  set("long", @LONG
少林罗汉堂的一名负责教罗汉堂弟子功夫的和尚，过了木人巷的弟子
就可以拜他为师了。他教功夫的时候特别有耐心，而且教得也很好，
所以座下弟子很多。
LONG
  );
  set("title", RED "少林寺" YEL "罗汉堂" HIW "武僧" NOR);
  set("gender", "男性");
  set("age", 41);
  set("attitude", "friendly");
  set("class", "bonze");

  set("str", 27);
  set("int", 32);
  set("spi", 30);
  set("con", 30);

  set_wugong("banruo-xinfa", 300, 300, 1);
  set_wugong("lixue-bufa", 300, 300, 1);

  set_xiuwei_level_by_type("force", 5);
  set_xiuwei_level_by_type("dodge", 4);
  set_xiuwei_level_by_type("zonggang", 5);

  set("combat_exp", 1200000);
  set("social_exp", 500000);
  set("positive_score", 32000);
  set("negative_score", 0);
  set("class_score", 10000);

  create_family("少林派", 37, "弟子");
  set("family/belong", YEL "罗汉堂" NOR);

  set("no_kill", "shaolin");
  setup();
  carry_object(CLOTH_DIR "sengyi3")->wear();

}

#include "hui_master.h";

int lose_bihua(object ppl) {
  if (ppl->query_temp("hydra/shaolin/fight_master") == query("id")) {
    command("smile " + ppl->query("id"));
    command("say 好徒儿，有出息！");
    ppl->set_temp("hydra/shaolin/defeat_master", 1);
    ppl->delete_temp("hydra/shaolin/fight_master");
    command("say 你去找你慧轮师叔说吧！");
  }
  return 1;
}
