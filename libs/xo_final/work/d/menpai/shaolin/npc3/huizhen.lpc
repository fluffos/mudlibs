// huizhen.c 慧贞--达摩院的知事
// written by hydra 19980513 


#include <ansi.h>

inherit __DIR__ "hui_master.lpc";

string change_master(object);
void give_letter(object);

void create() {
  seteuid(getuid());
  set_name("慧贞", ({ "hui zhen", "zhen", "hui", "bonze" }));
  set("long", @LONG
少林达摩院知事慧贞师傅，协助玄难大师处理达摩院日常事务，
同时教授弟子功夫。
LONG
  );
  set("title", RED "少林寺" MAG "达摩院" HIC "知事" NOR);
  set("gender", "男性");
  set("age", 55);
  set("class", "bonze");

  set("inquiry", ([
    "升级": (: change_master :),
    "比武": (: change_master :),
  ]));

  set("str", 35);
  set("int", 28);
  set("spi", 30);
  set("con", 34);

  set_wugong("banruo-xinfa", 300, 300, 1);
  set_wugong("wuxiangjie-zhi", 300, 300, 1);
  set_wugong("shaolin-shenfa", 300, 300, 1);

  set_xiuwei_level_by_type("force", 5);
  set_xiuwei_level_by_type("unarmed", 5);
  set_xiuwei_level_by_type("dodge", 5);
  set_xiuwei_level_by_type("zonggang", 5);

  set("combat_exp", 1500000);
  set("social_exp", 500000);
  set("positive_score", 21000);
  set("negative_score", 0);
  set("class_score", 10000);

  create_family("少林派", 37, "弟子");
  set("family/belong", MAG "达摩院" NOR);

  set("no_kill", "shaolin");
  setup();
  carry_object(CLOTH_DIR "sengyi3")->wear();
}

#include "hui_master.h";
#include "zhishi.h";
