#include <ansi.h>

inherit __DIR__"xuan_master.lpc";

void create()
{
    seteuid(getuid());
    set_name("玄苦", ({"xuan ku","xuanku","xuan","ku"}));
    set("long",@LONG
他是一位须眉皆白的老僧，脸上一付慈祥的表情。
这位威严的老僧便是少林寺般若堂的首座，他对别派武功深有研究。
LONG   );
    set("title",RED"少林寺"GRN"般若堂"HIM"首座"NOR);
    set("rank_info/respect", "玄苦大师");
    set("gender", "男性");
    set("attitude", "friendly");
    set("class", "bonze1");
    set("family",([
        "title"         :"少林寺般若堂首座",
        "generation"    :36,
        "family_name"   :"少林派",
        "master_name"   :"灵门",
        "master_id"     :"ling men",
        "belong"        :GRN"般若堂"NOR,
        ]) );

    set("age", 74);
    set("str", 30);
    set("int", 32);
    set("con", 30);
    set("spi", 23);
    set("per", 26);

    set("combat_exp", 8000000);
    set("social_exp", 600000);
    set("class_score", 500000);
    set("positive_score",120000);

    set_wugong("yijin-jing", 300, 300, 1);
    set_wugong("damo-jian", 300, 300, 1);
    set_wugong("shaolin-shenfa", 300, 300,1);

    set_xiuwei_level_by_type("force", 6);
    set_xiuwei_level_by_type("sword", 7);
    set_xiuwei_level_by_type("dodge", 6);
    set_xiuwei_level_by_type("zonggang", 6);

    set("inquiry",([
        "武功" : "少林僧人习武只为健体强身，可不是为了逞强好胜。",
    ]) );

    set("no_kill","shaolin");
    setup();
    carry_object(CLOTH_DIR"jiasha2")->wear();
    carry_object(SWORD_DIR"changjian")->wield();
}

