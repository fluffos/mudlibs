#include <ansi.h>

inherit __DIR__"hui_master.lpc";

string do_accept(string msg,object me);
string change_master( object );
void greeting( object );

void create()
{
    seteuid(getuid());
	set_name("慧轮", ({ "hui lun", "hui", "bonze" }) );
	set("long",	"一个四十多岁的中年僧人。\n");
	set("gender", "男性");
	set("age", 41);
	set("attitude", "friendly");
	set("class", "bonze");

	set("str", 17);
	set("int", 30);
	set("spi", 30);
	set("con", 30);
	set("cps", 30);
	set("cor", 20);
	set("per", 30);
	set("kar", 30);

    set_wugong("banruo-xinfa", 300, 300, 1);
    set_wugong("meihua-dao", 300, 300, 1);
    set_wugong("shaolin-shenfa", 300, 300,1);

    set_xiuwei_level_by_type("force", 5);
    set_xiuwei_level_by_type("blade", 5);
    set_xiuwei_level_by_type("dodge", 5);
    set_xiuwei_level_by_type("zonggang", 5);

    set("combat_exp", 800000);
    set("social_exp", 500000);
    set("positive_score",40000);
    set("negative_score",0);
    set("class_score",10000);

    set("inquiry", ([
		"木人巷"	:	(:do_accept:),
	    "升级"      :   (: change_master :),
	    "比武"      :   (: change_master :),
    ]) );
    create_family("少林派", 37, "弟子");
    set("title",RED"少林寺"YEL"罗汉堂"HIC"知事"NOR);
    set("family/belong",YEL"罗汉堂"NOR );

    set("no_kill","shaolin");	
    setup();
    carry_object(CLOTH_DIR"sengyi3")->wear();
    carry_object(BLADE_DIR "blade")->wield();
}

#include "hui_master.h";
#include "zhishi.h";

void init()
{
    object ppl = this_player();

    ::init();
	if( userp(ppl))
    	call_out("greeting",1,ppl );
  	add_action("do_nod","nod");
}

//If ppl had killed in shaolin,then huilun will arrest him,hehe
void greeting( object ob )
{
    object this,xianglong,fuhu;
    string msg;
    this = this_object();
    if( environment(ob) != environment(this) )
        return;
    if( ob->query("family/family_name") == "少林派" )
        return;
    //xianglong--降龙罗汉 ；fuhu--伏虎罗汉
    if( ob->query_condition("kill_shaolin") )
    {
        msg = YEL"$N一见$n过来，大喝一声，“大胆狂徒，竟然敢在少林寺杀人\n";
        msg +=   "放火！降龙伏虎罗汉何在！\n\n"NOR;
        if( !objectp(xianglong = present( "hui si",environment(ob) )) && 
            !objectp(fuhu = present( "hui tong",environment(ob) )) )
        {
            msg += CYN"只见两名中年僧人从后面奔出，向$n发起了进攻！\n\n"NOR;
            message_vision( msg,this,ob );
            xianglong = new( "/d/menpai/shaolin/luohan_zhen/npc/huisi.lpc" );
            fuhu = new( "/d/menpai/shaolin/luohan_zhen/npc/huitong.lpc" );
            xianglong -> set( "force_factor",150 );
            xianglong -> set( "env/attack",100 );
            xianglong -> set( "is_killing_enemy",ob->query("id") );
            fuhu -> set( "force_factor",150 );
            fuhu -> set( "env/attack",100 );
            fuhu -> set( "is_killing_enemy",ob->query("id") );
            xianglong -> move( environment( ob ) );
            fuhu -> move( environment( ob ));
            xianglong -> set_leader( ob );
            fuhu -> set_leader( ob );
        }
        else
            message_vision(msg,this,ob);
        if(objectp(xianglong) )
            xianglong -> kill_ob( ob );
        if(objectp(fuhu) )
            fuhu -> kill_ob( ob );
        ob -> set_temp("shaolin/being_jina",1);
        this -> kill_ob( ob );
    }
}    
        
        


string do_accept(string msg, object me)
{
	me = this_player();
	if( me->query("family/family_name") != "少林派" )
	{
		msg = "木人巷只有本派的弟子可以使用，施主请回吧";
	}
	else if ( me->query("family/master_id"))
	{
		msg = "你已是我少林座下弟子，无需再闯木人巷了，好好学功夫吧";
	}
	else if ( me->query("lnwm/pass_muren") )
	{
	    msg = "你已经闯过了木人巷，不用再闯了。";
	}
	else if ( this_object()->query_marks("lnwm/有人闯"))
	{
		msg = "木人巷现正有本门弟子在里头,请稍等一会";	
	}
    else if ( me->query_lingwu("fuhu-quan") < 60 )
    {
        msg = "木人巷是本门弟子艺成试练的地方，\n"
              "等你把伏虎拳练得出神入化再来吧。";
    }  
    else if ( me->query("max_force") < 300 )
    {
        msg = "本门弟子应注重内外兼修，\n"
              "等你把丹田气练得再精纯些再来吧。";
    }  
	else {
		me->set_marks("lnwm/问慧轮", 1);
		command("nod");
		command("say 小师侄，你真有心闯木人巷吗?\n");
		msg="你若有心闯木人巷，就点个头(nod)";
	}
	return msg;
}

int do_nod(string arg)
{
	object me;
	me = this_player();
	  	
	if ( me->query_marks("lnwm/问慧轮") )
	{
		if ( this_object()->query_marks("lnwm/有人闯"))
		{
			message_vision("慧轮说:木人巷现正有本门弟子在里头,请稍等一会\n",me);
		}
		else
		{
			message_vision(CYN"\n\n慧轮对$P说:好孩子!有勇气!那你就试试吧!\n\n\n"NOR,me);
			message_vision(YEL"慧轮燃起一根供香，然后对$P说:在这根香熄灭前,希望你打出木人巷!\n\n\n"NOR,me);		
			message_vision(GRN"慧轮转过身，在身后的供桌上轻轻按了一下，他的身后的地上出现一条暗道。\n"NOR,me);
			message_vision(GRN"$P看了看暗道口，然后毫不犹豫地走了进去\n\n\n\n"NOR,me);
			me->delete_marks("lnwm/问慧轮");
            me->set_temp( "huilun", this_object() );
			me->move( "/d/menpai/shaolin/muren_xiang/entrance" );
			message_vision(GRN"\n\n只听一阵机簧之声，暗道的门合上了\n\n\n\n"NOR,me);
			this_object()->set_marks("lnwm/有人闯",1);
		}
		return 1;
	}
	else
	{
		return 0;	
	}

}

int do_fail(object me)
{
	tell_object(me,CYN"你忽然看见一个灵活的人影，几个跳跃越过木人来到你的身边.\n\n"NOR);
	tell_object(me,CYN"来人伸出手抓住你，说:师父让我带你出去.\n\n"NOR);
	tell_object(me,CYN"来人在旁边的墙上按了一下，墙上出现一个暗门，来人带着你从暗门离开木人巷.\n\n"NOR);
	me -> move("/d/menpai/shaolin/muren_xiang/exit");		
	tell_object(me,YEL"你定睛一看，是你的师兄，罗汉堂大弟子虚戒!\n\n"NOR);
	tell_object(me,YEL"虚戒对你说:师父面前的香已经点完，你还没有闯过木人巷，真是可惜。\n\n"NOR);
//	tell_object(me,YEL"虚戒看了你一眼:别那么灰心，练好了功夫再来嘛.\n\n"NOR);
	tell_object(me,YEL"\n虚戒叹了一口气,转身离去了.\n"NOR);
	call_out("delete_call_murenxiang",1);
}

void delete_call_murenxiang()
{
	this_object()->delete_marks("lnwm/有人闯");
	//remove_call_out("do_fail");
}

