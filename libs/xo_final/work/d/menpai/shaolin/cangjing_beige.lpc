// 藏经阁北阁 : /d/shaolin/cangjing_beige.c

inherit ROOM;



void create()
{
    set("short","藏经阁北阁");
    set("long",@LONG
这是一间收拾得极为朴素的楼阁，中间放着一张竹制的茶几，有位老僧坐在
蒲团上正翻阅着经书，对你的到来，他仿佛置若罔闻。往北就是藏经阁的北阁书
库，往南是一条长长的走廊。
LONG
    );
    set("exits",([
        "south" : __DIR__"cangjing_zoulang4",
        "north" : __DIR__"cangjing_shukun",
    ]) );
    
    set("objects",([
        __DIR__"npc/huwei3" :   2,
    ]) );
    
    setup();
}

int valid_leave( object me,string dir )
{
    object ob;
    if( me->query("family/family_name") != "少林派" 
        &&  dir == "north"
        &&  objectp(ob=present("huwei seng",this_object()))
        &&  living( ob ))
    {
        message_vision("$N拦住$n，“你不是少林弟子，不能进去！”\n",
            ob,me);
        return notify_fail("你只得收住脚步。\n");
    }
    return ::valid_leave( me,dir );
}