#include <room.h>

inherit DOOR_ROOM;



void create()
{
    set("short","龙树院西禅房");
    set("long",@LONG
这是龙树院的西禅房，是龙树院首座打坐练功起居之处。屋内正中有一张很
旧的蒲团。除此之外，再无其它物事。禅房的东侧有一扇门，走出去就是龙树院
的大殿。
LONG
    );
    set("exits",([
        "east" : __DIR__"longshu_dadian",
    ]) );

    create_door("east","龙树院西厢房房门","west",DOOR_CLOSED);

    setup();
}
