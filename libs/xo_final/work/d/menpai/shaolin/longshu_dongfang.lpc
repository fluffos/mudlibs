void create()
{
    set("short","龙树院东禅房");
    set("long",@LONG
这是龙树院的东禅房，是龙树院首座起居之处。西面有一扇门，那里通往龙
树院的大殿。屋子的上方开着一扇天窗，抬头望去，正好有一枝粗大的树枝挡住
了一线的天空。
LONG
    );
    set("exits",([
        "west" : __DIR__"longshu_dadian",
    ]) );
    
    set("objects",([
        __DIR__"npc3/huinian":1,
    ]) );

    create_door("west","龙树院东厢房房门","east",DOOR_CLOSED);

    setup();
}

