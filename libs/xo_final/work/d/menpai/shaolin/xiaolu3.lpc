inherit ROOM;



void create()
{
   	set("short", "青石小路");
   	set("long", @LONG
这是一条弯弯曲曲的小路，沿着山坡通向山下。小路不宽，地面由青条石铺
成，多年以来已被众僧踩得很光滑。不时的会有一两个僧人挑着水同从这里经过，
有的是因为犯了戒律而被罚到这里来挑水，也有的是为了锻炼身体或者是练什么
武功才挑的。从这里可以望到北面的五乳蜂，也可以隐约的看到南面的嵩山三十
六峰。
LONG
	);
	
	set("exits", ([ 
	    "northup"  : __DIR__"xiaolu2",
        "northwest"  : __DIR__"shanjian1",     ]));
	if( random(10) > 7 )
		set("objects", ([
			__DIR__"npc/heshang5" : 1,
			]) );
    set("outdoors","shaolin");
    setup();
	//place_program(ROOM);
}
