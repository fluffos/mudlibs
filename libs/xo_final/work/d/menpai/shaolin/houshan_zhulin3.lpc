// hou shan zhu lin 3 : /d/shaolin/houshan_zhulin3.c

inherit ROOM;



void create()
{
    set("short","后山竹林");
    set("long",@LONG
你走在一片茂密的竹林丛中，脚下踩着软软的碎叶，耳旁听得鸟鸣声声。环
顾四周，这一片竹影，看上去无边无际。你发觉自己被淹没在绿的海洋中了，但
却有一种并不急于出去，而想在这里多停留一会的想法。
LONG
    );
    set("exits",([
        "northeast" : __DIR__"houshan_zhulin"+(random(4)+1),
        "north" : __DIR__"fangzhang_houshan",
        "northwest" : __DIR__"houshan_zhulin"+(random(4)+1),
        "south" : __DIR__"houshan_zhulin"+(random(4)+1),
    ]));
    set("not_startroom",1);
    setup();
}

int valid_leave(object me, string dir)
{
	if ( dir == "north")
	{
        me->add_temp("mark/steps",1);
        if (me->query_temp("mark/steps") == 10)
        {
            me->delete_temp("mark/steps");
            me->move(__DIR__"xinchan_tang");
            return notify_fail("\n");
        }
    }
    else
        me->delete_temp("mark/steps");

        return ::valid_leave(me,dir);
}
