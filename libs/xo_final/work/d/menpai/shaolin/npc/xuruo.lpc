#include <ansi.h>

inherit __DIR__"xu_master";

void create()
{
    set_name("虚若", ({ "xu ruo", "xu", "ruo", "he shang", 
                        "seng ren", "bonze", "monk" }) );
    set("long",	@LONG
    虚若看起来有些木讷，但做事很有恒心，所以很得器重。
LONG
    );
    set("age", 36 );

    set_wugong("shaolin-neigong", 300, 300, 1);
    set_wugong("qianye-shou", 300, 300, 1);
    set_wugong("banruo-shenfa", 200, 200,1);

    set_xiuwei_level_by_type("force", 4);
    set_xiuwei_level_by_type("unarmed", 3);
    set_xiuwei_level_by_type("dodge", 3);
    set_xiuwei_level_by_type("zonggang", 4);

    setup();
    carry_object(CLOTH_DIR "sengyi1") -> wear();
}
