#include <ansi.h>

inherit __DIR__"xu_master";

void create()
{
    seteuid(getuid());
    set_name("虚音", ({ "xu yin", "xu", "yin", "he shang",
                        "seng ren", "bonze" }) );
    set("title","和尚院僧人");
    set("long",	@LONG
虚音是虚字辈人缘最好的一个，他入寺时间长，又不以老字辈倨傲。相反却常常帮助
刚刚入寺的小弟子，十分热心，大家都很喜欢他。
LONG
    );

    set("age", 38 );

    set_wugong("shaolin-neigong", 300, 300, 1);
    set_wugong("ertang-jian", 300, 300, 1);
    set_wugong("jimie-zhua", 300, 300, 1);
    set_wugong("shaolin-shenfa", 200, 200, 1);

    set_xiuwei_level_by_type("force", 4);
    set_xiuwei_level_by_type("unarmed", 4);
    set_xiuwei_level_by_type("sword", 2);
    set_xiuwei_level_by_type("dodge", 1);
    set_xiuwei_level_by_type("zonggang", 4);
    
    setup();
    carry_object(CLOTH_DIR "sengyi1") -> wear();
}
