inherit __DIR__"seng.lpc";



void create()
{
    set_name("灰衣僧人", ({ "huiyi sengren","sengren","monk" }) );

    set("age",64);
    set("chat_chance",8);
    set("chat_msg",({
        "灰衣僧人慢慢抬起头来，懒洋洋地看了你一眼，又低下了头。\n",
        "灰衣僧人拿起佛经看了一眼，又闭上了眼睛，嘴里默默念着。\n",
    }) );
    
	set_xiuwei("dodge",70);
	set_xiuwei("unarmed",70);
    setup();
    carry_object(CLOTH_DIR"jiasha1")->wear();
}
            
