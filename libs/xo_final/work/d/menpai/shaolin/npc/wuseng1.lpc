inherit __DIR__"wuseng.lpc";



void create()
{
    set_name("武僧", ({ "wu seng","seng","monk" }) );

    set_wugong("luohan-quan"    ,100);
    set_wugong("weituo-zhang"   , 20, 20, 1);
    set_wugong("shaolin-shenfa" ,100,100, 1);
    set_xiuwei_by_type("dodge"  ,800);
    set_xiuwei_by_type("unarmed",800);

    setup();
    carry_object( CLOTH_DIR "sengyi1")->wear();
}

