#include <ansi.h>

inherit __DIR__ "xu_master";

void create() {
  set_name("虚亮", ({ "xu liang", "xu", "liang", "he shang",
    "seng ren", "bonze" }));
  set("long", @LONG
    一个看起来比较木讷的和尚，好象颈椎练功受过什么伤，所以脖子老是直直地
挺着，转头时不是扭头，而是连脖子一起慢慢地转过来，让你看着都觉得累。不过
虚亮脾气很好。大家拿他开玩笑他也不生气。
LONG
  );
  set("age", 25);

  set_wugong("shaolin-neigong", 300, 300, 1);
  set_wugong("shaolin-dandao", 300, 300, 1);
  set_wugong("fuhu-quan", 300, 300, 1);
  set_wugong("shaolin-shenfa", 200, 200, 1);

  set_xiuwei_level_by_type("force", 4);
  set_xiuwei_level_by_type("unarmed", 3);
  set_xiuwei_level_by_type("blade", 2);
  set_xiuwei_level_by_type("dodge", 1);
  set_xiuwei_level_by_type("zonggang", 4);

  setup();
  carry_object(CLOTH_DIR "sengyi1")->wear();
}
