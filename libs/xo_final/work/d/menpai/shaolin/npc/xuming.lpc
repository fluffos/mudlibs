#include <ansi.h>

inherit __DIR__"xu_master";

void create()
{
    seteuid(getuid());
    set_name("虚明", ({ "xu ming", "xu", "ming", "he shang",
                        "seng ren","bonze" }) );
    set("long",	@LONG
一个二十多岁的青年僧人，身材魁梧，双目有神。举手投足间常显现出彪悍
之气，怎么看也象武师多过象和尚。
LONG
        );

    set_wugong("shaolin-neigong", 300, 300, 1);
    set_wugong("kuaige-dao", 300, 300, 1);
    set_wugong("sanhua-zhang", 300, 300, 1);
    set_wugong("shaolin-shenfa", 200, 200,1);

    set_xiuwei_level_by_type("force", 4);
    set_xiuwei_level_by_type("unarmed", 3);
    set_xiuwei_level_by_type("blade", 2);
    set_xiuwei_level_by_type("dodge", 1);
    set_xiuwei_level_by_type("zonggang", 4);

    setup();
    carry_object(CLOTH_DIR "sengyi1.lpc")->wear();
}

int accept_object( object ppl, object obj )
{
    object gold;

    if ( obj->query( "id" ) != "tong xia" ) 
        return 0;
    if ( query( "box" ) )               
    {
        message_vision( "虚明冲着$N大喝道：“周老太爷怎么会让你送两个礼盒？！"
            + RANK_D->query_rude( ppl ) + "竟敢欺骗贫僧！”\n", ppl );
        kill_ob( ppl );
        ppl->fight_ob( this_object() );
        remove_call_out( "Dest" );
        call_out( "Dest", 1, obj );
        return 1;
    }

    if ( ppl->query( "mud_age" ) < 3600 * 24 * 2        //如果玩家年龄在十六以下
        && ppl->query( "combat_exp" ) < 50000           //或经验不足一万，
        && ppl->query( "max_force" ) < 1000 )            //或内力不足三百，则否认
    {
        message_vision ( "虚明上下打量了$N许久，突然嘿嘿冷笑道：“哼！就凭你\n"
            + "这么点道行，也能走镖？你是怎么来的，还不老实交代！！”\n",
            ppl );
        kill_ob( ppl );
        ppl->fight_ob( this_object() );
        remove_call_out( "Dest" );
        call_out( "Dest", 1, obj );
        return 1;
    }
        
    message_vision( "虚明拍拍$N肩头，笑了笑道：“很好，不愧是周老太爷的镖师。\n"
        + "这些是你走镖的报酬，拿好哦。”\n", ppl );
    call_out( "Dest", 1, obj );
    set( "box", 1 );                    
    gold = new( MONEY_DIR + "gold" );       
    gold->set_amount( 10 );
    gold->move( ppl );
    command("chat 恭喜，"+ppl->query("name")+"("+ppl->query("id")+")"+"走镖成功，获得十两金子的报酬。");
    return 1;
}

void Dest( object obj )
{
    destruct( obj );
}

