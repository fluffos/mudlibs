#include <ansi.h>

inherit NPC;

string ask_for_join();



void create()
{
	set_name("缘根", ({ "yuan gen", "yuangen", "bonze" }) );
    set("title", "少林寺菜园执事");
	set("long",	@LONG
    缘根是少林寺掌管菜园的僧人，俗称「菜头」。
武功，佛学皆无可取之处，也不入「玄慧虚空」的排
辈。
LONG
);

	set("gender", "男性");
	set("age", 41);
	set("attitude", "friendly");
    create_family("少林派", 38, "弟子");


	set("str", 30);
	set("con", 30);
	set("cps", 30);
	set("cor", 20);
	set("per", 30);


    set("combat_exp", 10000);
    set("social_exp", 10000);

	set("inquiry", ([
		"出家" : "我出家就是为了混口饭吃。",
        "干活" : "挑五百桶水还是浇这三十亩地，你自己挑吧！",
        "犯戒" : "要是让戒律园的师傅知道了那还了得？！",
	]) );

    set("class","bonze");

	setup();
}

int accept_object(object who, object ob)
{
    object *obj,me,jielv_seng;
    int i,j;
    string nick;

    if( ob->value() < 100 && ob->id("leg")) {
			say("缘根道：“这是什么？打发叫花子吗？\n");
			return 0;
		} 

	if( who->query("oldquest/task_time") > time()) {
		say(CYN"缘根脸一板道：“竟敢贿赂我？！要让戒律院的知道了你就完了。”\n"NOR);
        say(CYN"接着脸色转和，道：“念你初犯，我就不报告戒律院了。”\n"NOR);
        return 1;
	    } 
    else {
        obj = all_inventory(environment(who));
        me=this_object();
        j=0;
    	for(i=0; i<sizeof(obj); i++) {
	    	if( living(obj[i]) && obj[i]!=who && obj[i]!=me){
                if(nick= obj[i]->query("title")){
                    if(strsrch(nick,"戒律院")>=0) {
                        j=2;
                        jielv_seng=obj[i];
                        }
                    }
                if(j==0) j=1;
                }
            }
        if(j==0) {
            say(CYN"缘根点点头，道：“你倒还挺懂事的嘛。今天的活不多，你就歇歇吧。”\n"NOR);
            who->set("oldquest/task_time",time());
            return 1;
            }
        if(j==1) {
            say(CYN"缘根压低声音，恶狠狠地道：“你疯了吗？这里这么多人？”\n"NOR);
            return 0;
            }
        if(j==2) {
            nick=CYN"缘根大声喊了起来：“戒律院的"+jielv_seng->query("name")
                +"师傅，"+who->query("name")+"竟向我行贿，你看该怎么办？”\n"NOR;
            say(nick);
            tell_object(who,CYN"缘根背转身来，冲你露出一脸坏笑。\n你从他眼中分明读出了“你这个大笨蛋”六个字。\n"NOR);
            return 0;
            }
        }
}

	
