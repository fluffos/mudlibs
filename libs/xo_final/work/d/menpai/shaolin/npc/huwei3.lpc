//huwei3.c  灰衣护卫
//Hydra
inherit __DIR__"guard.lpc";



void create()
{
    seteuid(getuid());
    set_name("灰衣护卫僧", ({ "huwei seng","huwei", "seng","monk guard", "monk", "guard" }) );    
    set("max_force",1000);
    set("force",1000);
    set("force_factor",80);

    create_family("少林派", 38, "弟子"); 
    delete("title");

    set_wugong("banruo-zhang",100,100,1);
    set_wugong("shaolin-shenfa",60,60,1);
    set_wugong("shaolin-neigong",40,40,1);
    set_xiuwei("dodge",1000);
    set_xiuwei("unarmed",1800+random(500));

    setup();
    carry_object(CLOTH_DIR "sengyi1") -> wear();
}

void init()
{
    object ob;
    
    ::init();
    if( interactive(ob = this_player()) 
        && ob->query("family/family_name") != "少林派" ) 
    {
        remove_call_out("greeting");
        call_out("greeting", 1, ob);
    }
}

void greeting(object ob)
{
    if( !ob || !present(ob, environment(this_object())) ) return;
    say( name() + "说道：你怎么进来的，还不快出去！\n");
}

