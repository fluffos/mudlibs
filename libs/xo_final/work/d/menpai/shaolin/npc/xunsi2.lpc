//xunsi2.c
//Hydra

#include <ansi.h>

inherit __DIR__"guard";



void create()
{
    set_name(YEL"巡寺武僧"NOR, ({ "xunsi wuseng","wuseng","seng","monk" }) );
    set("gender", "男性" );
    set("class","bonze");
    set("age",40);
    create_family("少林派", 38, "弟子"); 
	set( "chat_chance", 10 );
	set("chat_msg", ({
			"巡寺武僧警惕地审视着周围。\n",
			"巡寺武僧看了你一眼，又转头到另一边。\n",
			(: random_move :),
			}) );
    set_wugong("jimie-zhua", 100 + random(50),80+random(50),1);
    set_wugong("lixue-bufa", 100 + random(50),80+random(50),1);
	set_wugong("cibei-dao", 100, 100, 1 );
    set_xiuwei("dodge", 1200 + random(200));
    set_xiuwei("unarmed",2500 + random(500));
    set("max_force",1500+random(500) );
    set("force",query("max_force") );
    set("force_factor",query("max_force")/11 );
    set("social_exp",20000);
    set("combat_exp",1000000);
    setup();
	carry_object( CLOTH_DIR"jiasha1")->wear();
}

int welcome_visitor( object ppl )
{
    int i;
    object *inv;

    if ( ppl->query("family/family_name") == "少林派" )
        return 1;
    
    inv = all_inventory( environment() );
    for(i = 1; i < sizeof(inv); i++)
        if( inv[i] != this_object() && !inv[i]->weigong(ppl) )
            continue;
    message_vision("$N"+RED"大叫一声：大胆狂徒，居然潜入藏经阁。\n"NOR,
        this_object());
    kill_ob(ppl);
    return 1;
}