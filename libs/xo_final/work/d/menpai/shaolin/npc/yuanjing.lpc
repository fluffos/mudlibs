int ling_money( string arg )
{
    object ppl,money;    
    mapping quest;
    ppl = this_player();
    quest = ppl -> query("quest");
    if( ppl -> query("family/family_name") != "少林派" )
        return 0;
    if( !ppl -> query("family/master_id") )
        return 0;
    if( arg != "money" && arg != "钱" )
        return notify_fail("你要领什么？\n");
    if( !quest )
    {
        command("say 慧觉大师没有让你去买东西啊？");
        return 1;
    }
    switch( quest["quest"] )
    {
        case "取「三字经」":
            money = new(COIN_OB);   
            money -> set_amount( 200 );
            break;
        case "取「说文解字」":
            money = new(SILVER_OB);
            money -> set_amount( 2 );
            break;
        default:
            command("say 慧觉大师没有让你去买东西啊？");
            return 1;
            break;
    }
    if( !ppl->query("shaolin/can_ling_money") )
        return notify_fail("缘净说到：“你已经领过钱了呀？”\n");    
    command("nod");
    tell_object( ppl,"好吧，这些钱你拿去吧，路上小心啊！”\n"
        "缘净给你一些钱。\n");
    ppl -> delete( "shaolin/can_ling_money" );
    money -> move( ppl );
    return 1;
}    
    