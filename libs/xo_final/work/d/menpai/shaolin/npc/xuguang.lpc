#include <ansi.h>

inherit __DIR__"xu_master";

void create()
{
    seteuid(getuid());
    set_name("虚光", ({ "xu guang", "xu", "guang", "he shang",
                        "seng ren", "bonze" }) );
    set("long",	@LONG
虎头虎脑的小和尚，穿着一件小小的僧衣，一双眼睛大大得十分有神。别看他
年纪小，可入寺已有十多年了。是当年方丈从寺外拣回来的弃婴。因为身世可
怜，所以大家对他都十分爱护。
LONG
    );
    set( "age", 12 );

    set_wugong("shaolin-neigong", 300, 300, 1);
    set_wugong("yuanhou-gun", 300, 300, 1);
    set_wugong("duoluoye-zhi", 300, 300, 1);
    set_wugong("weituo-zhang", 300, 300, 1);
    set_wugong("shaolin-shenfa", 200, 200,1);

    set_xiuwei_level_by_type("force", 4);
    set_xiuwei_level_by_type("unarmed", 2);
    set_xiuwei_level_by_type("long", 3);
    set_xiuwei_level_by_type("dodge", 1);
    set_xiuwei_level_by_type("zonggang", 4);

    set("social_exp",   800);
    
    setup();
    carry_object(CLOTH_DIR "sengyi_c") -> wear();
}
