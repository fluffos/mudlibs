#include <ansi.h>

inherit __DIR__ "xu_master";

void create() {
  seteuid(getuid());
  set_name("虚静", ({ "xu jing", "xu", "jing", "he shang",
    "seng ren", "bonze" }));
  set("long", @LONG	
    虚静的武功在罗汉堂顶多算中游水平，但却是少有用功的几个之一，每天除
早午晚三课的时间，他几乎都在不停地练拳。晚上也常常打坐练功到深夜。方丈
感他执着，常常亲自指点他两招。
LONG
  );
  set("age", 26);

  set_wugong("shaolin-neigong", 300, 300, 1);
  set_wugong("jiben-quanfa", 300, 300, 1);
  set_wugong("yintuoluo-zhua", 300, 300, 1);
  set_wugong("shaolin-shenfa", 200, 200, 1);

  set_xiuwei_level_by_type("force", 4);
  set_xiuwei_level_by_type("unarmed", 2);
  set_xiuwei_level_by_type("dodge", 1);
  set_xiuwei_level_by_type("zonggang", 4);

  set("social_exp", 2000);

  setup();
  carry_object(CLOTH_DIR "sengyi1")->wear();
}
