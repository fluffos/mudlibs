inherit NPC;


void create() {
  set_name("种菜和尚", ({ "zhongcai heshang", "heshang", "monk" }));
  set("gender", "男性");
  set("class", "bonze");
  set("age", 17);
  set("chat_chance", 6);
  set("chat_msg", ({
    "种菜和尚拿了一个大瓢，慢慢地一瓢一瓢将清水浇到菜地上。\n",
    "种菜和尚蹲到菜园边，拔去园里的杂草。\n",
  }));
  set_wugong("unarmed", 100, 100, 1);
  set_wugong("jiben-qinggong", 100, 100, 1);
  set_xiuwei("dodge", 300);
  set_xiuwei("unarmed", 300);
  set("social_exp", 2000);
  set("combat_exp", 10000);
  setup();
  //        carry_object(__DIR__"obj/cloth4")->wear();
}
