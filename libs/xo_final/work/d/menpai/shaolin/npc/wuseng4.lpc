inherit __DIR__"wuseng.lpc";



void create()
{
    set_name("武僧", ({ "wu seng","seng","monk" }) );
    set_wugong("fuhu-quan",90,90,1);
    set_wugong("shaolin-shenfa",100,100,1);
    set_xiuwei_by_type("unarmed",300+random(1500));
    set_xiuwei_by_type("dodge",300+random(1500));
    set("max_force",500+random(1500));
    set("force",500+random(1500));
    set("force_factor",20+random(15));
    set("combat_exp",100000+random(100000));

    setup();
    carry_object( CLOTH_DIR "sengyi1")->wear();
}

