#include <ansi.h>
inherit __DIR__"wuseng.lpc";



void create()
{
    set_name(RED"年轻武僧"NOR, ({ "nianqing wuseng", "wuseng", "seng","monk" }) );
    set("age",18);

    set_wugong("luohan-quan"    , 80);
    set_wugong("weituo-zhang"   , 60, 60, 1);
    set_wugong("shaolin-shenfa" , 90, 90, 1);
    set_xiuwei_by_type("dodge"  ,500);
    set_xiuwei_by_type("unarmed",500);

    setup();
    carry_object( CLOTH_DIR "sengyi2")->wear();
}

