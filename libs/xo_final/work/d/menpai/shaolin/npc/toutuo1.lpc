// qyz
inherit __DIR__ "seng";



void create() {
  set_name("火工头陀", ({ "huogong toutuo", "toutuo", "monk" }));
  set("age", 40);

  set("str", 33);
  set("con", 29);

  set("chat_chance", 10);
  set("chat_msg", ({
    "火工头陀拿起一把巨大的铲子，在一口冒着热气的大锅里搅着。\n",
    "火工头陀费力地拉着风箱，并不时偏头看看灶里的火势。\n",
    "火工头陀抽空拿起搭在肩上的毛巾，擦了擦汗，喘了口气又继续干起来。\n",
  }));

  set_wugong("unarmed", 110, 110, 1);
  set_wugong("jiben-qinggong", 100, 100, 1);
  set_xiuwei("unarmed", 90);
  set_xiuwei("dodge", 90);
  set("social_exp", 2000);
  set("combat_exp", 10000);
  setup();
}
