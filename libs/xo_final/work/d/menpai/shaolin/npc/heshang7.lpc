// qyz
inherit __DIR__"seng.lpc";


void create()
{
    set_name("烧饭僧人", ({ "shaofan sengren","sengren","monk" }) );
	set( "chat_chance", 10 );
	set("chat_msg", ({
            "烧饭僧人从菜筐里拿出一个茄子，一边切一边嘟囔：\n"
            "“全寺两百多人的饭只得我们两个来做，哪里忙得过来呀。”\n",
            "烧饭僧人费劲地从外面提进一桶萝卜，然后开始一只一只洗了起来。\n",
			"烧饭僧人从水桶里捞起一块雪白的豆腐，欣赏地看了看，然后放到案板上熟练地切了起来。\n",
			"烧饭僧人从锅里端出一碗热气腾腾的清蒸豆腐，看看左右无人，偷偷掐了一块放进嘴里。\n",
			}) );
    set_wugong("unarmed", 70);
    set_wugong("jiben-qinggong", 70 + random(50));
    set_xiuwei("dodge", 50 );
    set_xiuwei("unarmed",50);
    set("social_exp",1000);
    set("combat_exp",8000);
    
    setup();
}

void init()
{
    add_action("do_yao","yao");
}

int do_yao()
{
    object who = this_player();
    object me = this_object();
    int food,water;

    if ( who->query("family/family_name") != "少林派")
    {
        command("say 斋饭还没做好，施主是不是先在膳堂坐坐？");
        return 1;
    }
    if ( (who->query("water") >= who->max_water_capacity()/2)
        &&(who->query("food") >= who->max_food_capacity()/2) )
    {
        who->add("class_score/少林派", -1);
        return notify_fail("你吃得饱饱的，喝得足足的来这里添什么乱？！\n");
    }

    message_vision("$N揉着肚子可怜兮兮得对$n说：\n"
        "“大师傅，还有剩饭吗？实在是饿得不行了。”\n\n",who,me);
    message_vision("$n抬头看了$N一眼，把嘴往菜筐一孥，道：\n"
        "“饭是还没做好，有些蔬菜可以生吃，自己拿吧。我还忙着呢。”\n\n",
        who,me);
    
    if ( random(2) )
         message_vision("$N从菜筐里翻出一条罗卜来，",who,me);
    else message_vision("$N从菜筐里拿出一个大茄子来，",who,me);
    message_vision("三口两口就吃了个干干净净。\n",who,me);
    tell_object(who,"水灵灵的瓜菜，吃起来既顶饱又解渴，可真好吃呀！\n");

    who->set("food" ,me->max_food_capacity());
    who->set("water",me->max_water_capacity());

    return 1;
}

