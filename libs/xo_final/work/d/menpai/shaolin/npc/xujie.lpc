// Filename : /d/menpai/shaolin/npc/xujie.c

#include <ansi.h>

inherit __DIR__"xu_master";

void create()
{
    seteuid(getuid());
    set_name("虚戒", ({ "xu jie", "xu", "jie", "he shang",
                        "sen ren", "bonze" }) );
    set("title","罗汉堂武僧");
    set("long",	@LONG
    虚戒本来是年轻一代中武功的佼佼者，但由于过分注重武功修练，忽略了佛
法的研习，以至一些小处把持不定，屡次犯戒。方丈为了让他时刻能保持禅心，
特地给他换成现在的法号。
LONG
        );

    set( "age", 27 );

    set_wugong("shaolin-neigong", 300, 300, 1);
    set_wugong("fengmo-zhangfa", 300, 300, 1);
    set_wugong("qufannao-zhi", 300, 300, 1);
    set_wugong("luohan-quan", 300, 300, 1);
    set_wugong("shaolin-shenfa", 200, 200, 1);

    set_xiuwei_level_by_type("force", 4);
    set_xiuwei_level_by_type("unarmed", 2);
    set_xiuwei_level_by_type("long", 2);
    set_xiuwei_level_by_type("dodge", 1);
    set_xiuwei_level_by_type("zonggang", 4);

    setup();
    carry_object(CLOTH_DIR "sengyi2") -> wear();  
}
