#include <ansi.h>

inherit __DIR__ "xu_master";

void create() {
  set_name("虚缘", ({ "xu yuan", "xu", "yuan", "he shang",
    "seng ren", "bonze" }));
  set("long", @LONG
一个精干的青年僧人，你很容易就注意到，他的手掌似乎比常人
的要大一圈。看来他在掌法方面的造诣一定不低。
LONG
  );

  set("age", 24);

  set_wugong("shaolin-neigong", 200, 200, 1);
  set_wugong("wuding-zhi", 300, 300, 1);
  set_wugong("shaolin-shenfa", 200, 200, 1);

  set_xiuwei_level_by_type("force", 4);
  set_xiuwei_level_by_type("unarmed", 4);
  set_xiuwei_level_by_type("dodge", 1);
  set_xiuwei_level_by_type("zonggang", 4);

  set("combat_exp", 7000000);

  setup();
  carry_object(CLOTH_DIR "sengyi1")->wear();
}
