//NPC: /d/menpai/shaolin/npc/fanren.c 犯人
//By lala on June 29, 1997

#include <ansi.h>
inherit NPC;



void create()
{
	set_name("老犯人", ({"fan ren", "fan" ,"ren"}) );
	set("age", random(20)+50);
	set("gender", "男性");
	set("long", @LONG
一名水牢中的犯人。不知道他坐了多久的牢，只见他面目枯槁，头发稀
疏，眼睛呆滞无光，只有间或一轮，还说明他是一个活物。
LONG );
	set("chat_chance", 10);
	set("chat_msg", (
	{
		"老犯人喃喃的低声嘀咕了些什么。\n",
		"老犯人走动了几步，只听见一阵镣铐的“稀里哗啦”的响声。\n",
		"老犯人低声自语道：“上一次见太阳是什么时候了？十年前还是十五年前？”\n",
		"老犯人向你凑过来，低声招呼道：“怎么？你也来了？嘿嘿……”\n",
		"老犯人俯下身去，从"BLU"没到胸口的污水"NOR"里掬了一捧\n"BLU +
		"散发着令人作呕的，漂浮着许多不知是什么生物的污水"NOR"喝了下去。\n",
		"老犯人从墙上抓了几只"BLU"虫子"NOR"塞进嘴里。一边咀嚼，一边发出满意的哼声。\n"
	}) );
	switch (random(3))
	{
		case 0:
		set("class", "bonze");
		break;
		case 1:
		set("class", "bonze1");
		break;
		case 2:
		break;
	}
	setup();
}