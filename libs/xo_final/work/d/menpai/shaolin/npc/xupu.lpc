#include <ansi.h>

inherit __DIR__"xu_master";

void create()
{
    set_name("虚普", ({ "xu pu", "xu", "pu", "he shang", 
                        "sen ren", "bonze" }) );
    set("long",	"一个身材高大的青年僧人，目光炯炯有神，全身充满了活力。\n");

    set_wugong("shaolin-neigong", 300, 300, 1);
    set_wugong("jiben-daofa", 300, 300, 1);
    set_wugong("dahong-quan", 300, 300, 1);
    set_wugong("shaolin-shenfa", 200, 200,1);

    set_xiuwei_level_by_type("force", 4);
    set_xiuwei_level_by_type("unarmed", 3);
    set_xiuwei_level_by_type("blade", 1);
    set_xiuwei_level_by_type("dodge", 1);
    set_xiuwei_level_by_type("zonggang", 4);

    set("social_exp",  5000);

    setup();
    carry_object(CLOTH_DIR"sengyi1")->wear();
}
