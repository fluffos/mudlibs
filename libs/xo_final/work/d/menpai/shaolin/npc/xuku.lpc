#include <ansi.h>

inherit __DIR__ "xu_master";

void create() {
  seteuid(getuid());
  set_name("虚苦", ({ "xu ku", "xu", "monk" }));
  set("long", @LONG
    虚苦总是默默无闻地在罗汉堂埋头工作，每天难得见他有一次笑脸，似乎总
担着很重的心事。当年他剃度出家时，方丈就是怜他悲惨的身世而收他入寺，并
赐法名为苦。
LONG
  );
  set("age", 30);

  set_wugong("shaolin-neigong", 300, 300, 1);
  set_wugong("cibei-dao", 300, 300, 1);
  set_wugong("tianzhufo-zhi", 300, 300, 1);
  set_wugong("shaolin-shenfa", 200, 200, 1);

  set_xiuwei_level_by_type("force", 4);
  set_xiuwei_level_by_type("unarmed", 2);
  set_xiuwei_level_by_type("blade", 3);
  set_xiuwei_level_by_type("dodge", 1);
  set_xiuwei_level_by_type("zonggang", 4);

  set("social_exp", 15000);

  setup();
  carry_object(CLOTH_DIR "sengyi2")->wear();
}
