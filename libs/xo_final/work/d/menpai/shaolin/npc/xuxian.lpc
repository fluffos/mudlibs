#include <ansi.h>

inherit __DIR__ "xu_master";

void create() {
  seteuid(getuid());
  set_name("虚闲", ({ "xu xian", "xu", "xian", "he shang",
    "seng ren", "bonze" }));
  set("long", @LONG
    虚闲人如其名，是罗汉堂里出名的懒人，练功既不勤奋，也不认真。方丈多
次劝他，他都表面答应回头却依然我行我素。其实他的天资很好，十分聪明。长
辈们常常在背后叹惜这么好的天资可惜浪费了。
LONG
  );
  set("age", 26);

  set_wugong("shaolin-neigong", 300, 300, 1);
  set_wugong("banruo-zhang", 300, 300, 1);
  set_wugong("jiben-qinggong", 300, 300, 1);
  set_wugong("shaolin-shenfa", 300, 300, 1);

  set_xiuwei_level_by_type("force", 4);
  set_xiuwei_level_by_type("unarmed", 4);
  set_xiuwei_level_by_type("dodge", 1);
  set_xiuwei_level_by_type("zonggang", 4);

  set("socail_exp", 12000);

  setup();
  carry_object(CLOTH_DIR "sengyi1")->wear();
}
