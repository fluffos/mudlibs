// long shu da dian : /d/shaolin/longshu_dadian.c

#include <ansi.h>
#include <room.h>

inherit DOOR_ROOM;



void create()
{
    set("short","龙树院大殿");
    set("long",@LONG
这里是龙树院的大殿。大殿的两旁整整齐齐地排放着两排蒲团，中间是一座
讲坛，龙树院首座就在这里向众僧讲经。东西两侧各有一间厢房，门被从里闩了
个严严实实。
LONG
    );
    set("exits",([
        "south" : __DIR__"longshu_yuan",
        "east"  : __DIR__"longshu_dongfang",
        "west"  : __DIR__"longshu_xifang",
    ]) );
   
    set("objects",([
        __DIR__"npc3/xuanji":1,
    ]) );
    set("need_clean", "少林派" );
    
    create_door( "east","龙树院东厢房房门","west",DOOR_CLOSED);
    create_door( "west","龙树院西厢房房门","east",DOOR_CLOSED);

    set("no_clean_up",1);
    setup();
}

void init()
{
        add_action("da_sao", "sao");
        add_action("da_sao", "clean");
}

int da_sao(string arg)
{
    object me;
    mapping quest;
    me = this_player();
    if( !me->can_act() ) return notify_fail("你现在无法打扫。\n");

    if( call_other("/cmds/verb/clean", "main", me, arg ) )
    {
        if( quest = me->query("quest") )
        {
            if( quest["quest"] == "打扫龙树院大殿" )
            me->set("oldquest/status", "打扫龙树院大殿" );
            return 1;
        }
        return 1;
    }
    return 0;
}
