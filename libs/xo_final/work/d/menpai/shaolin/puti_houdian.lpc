// pu ti yuan hou dian : /d/shaolin/puti_houdian.c

inherit ROOM;

void init();
int do_push(string);



void create()
{
    set("short","菩提院后殿");
    set("long",@LONG
殿上并列着三尊佛像，前面点着几盏油灯，佛像之前安着一座屏风，屏风上
装着一面极大的铜镜(tongjing)，擦得晶光净亮，镜中将你的人影照了出来。有
几位僧人，各自坐在佛像前的蒲团上。
LONG
    );
    set("exits",([
        "south" : __DIR__"puti_qiantang",
    ]) );

    set("item_desc", ([
        "tongjing" : "铜镜上镌着四句经偈(jingji)\n",
        "jingji" : "\t一切有为法,\n\t如梦幻泡影,\n\t如露亦如电,\n\t当作如是观。\n"
    ]) );

    set("objects", ([
        __DIR__"npc/zhiyuan" : 1,
        __DIR__"npc/zhizhan" : 1,
    ]));

    setup();
}

/*void init()
{
	add_action("do_push", "push");
}
*/

int do_push(string arg)
{
	object me = this_player();

    if (arg != "一梦如是" ) return command("push "+arg);

    if( me->query_temp("marks/菩") ) 
    {
        message_vision("$N在镜上那首经偈第一行第一个“一”字上一揿。\n", me);
        message_vision("$N跟着又在第二行的“梦”字上揿了一下。\n", me);
        message_vision("$N伸指在第三行的第一个“如”字上一揿。\n", me);
        message_vision("$N又在第四行的“是”字上一揿。\n", me);
        message_vision("只听得轧轧声响，$N脚下的石砖突然陷了下去。\n", me);
        message_vision("耳旁风声作响，$N身子往下直坠。\n", me);
        me->move(__DIR__"puti_mishi");
    }
    else
    {
        message_vision("$N往铜镜上一按，沾了一手的铜锈。\n", me);
    }

    return 1;
}
