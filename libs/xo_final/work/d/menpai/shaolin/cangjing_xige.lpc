// 藏经阁西阁 : /d/shaolin/cangjing_xige.c

inherit ROOM;



void create()
{
    set("short","藏经阁西阁");
    set("long",@LONG
这是一间收拾得极为朴素的楼阁，中间放着一张长长的木桌，有几位僧人坐
在蒲团上正翻阅着经书。四周静得出奇，似乎可以听到窗外竹叶飘落在地上的声
音。往北是藏经阁的西阁书库，往南是一条长长的走廊。
LONG
    );
    set("exits",([
        "south" : __DIR__"cangjing_zoulang1",
        "north" : __DIR__"cangjing_shukuw",
    ]) );
    
    set("objects",([
        __DIR__"npc/huwei3" :   2,
    ]) );

    setup();
}

int valid_leave( object me,string dir )
{
    object ob;
    if( me->query("family/family_name") != "少林派" 
        &&  dir == "north"
        &&  objectp(ob=present("huwei seng",this_object()))
        &&  living( ob ))
    {
        message_vision("$N拦住$n，“你不是少林弟子，不能进去！”\n",
            ob,me);
        return notify_fail("你只得收住脚步。\n");
    }    
    return ::valid_leave( me,dir );
}