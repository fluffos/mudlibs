// 藏经阁东阁书库 : /d/shaolin/cangjing_shukue.c

inherit ROOM;

void init();
int do_study(string);

string * books = ({
    "dabanruo-jing",
    "fahua-jing",
    "huayan-jing",
    "lengjia-jing",
    "lengyan-jing",
    "weimo-jing",
    "wuliang-jing",     
    "xiaobanruo-jing",
});

string * obj = ({
    "baiyu-jing",
    "jingang-jing",
    "huayan-jing",
});

string * search_book = ({
    "ahan-jing",
    "mohe-jing",        
});
        


void create()
{
    string what_is_this_book;
    set("short","东阁书库");
    set("long",@LONG
这是一间很大的书库，书库中间和四周墙边密密地排满了书架(shelf)。 书
架上的书放得整整齐齐，显得多而不乱。门口立着一块牌子(sign)，上面写着借
书的规矩。
LONG
    );
    set("exits",([
        "south" : __DIR__"cangjing_dongge",
    ]) );

    set("item_desc", ([
        "shelf" : "书架上摆满了佛经，你可以从上面取(qu)一本。\n",
        "sign"  : "每次限取书一册。\n",
    ]));
    
    set("objects",([
        __DIR__"obj/"+obj[random(sizeof(obj))]  :   1,
    ]) );
    
    what_is_this_book=__DIR__"obj/"+search_book[random(sizeof(search_book))];
    set( "have_fojing",10);
    set("no_clean_up", 0);
    setup();
    add("search_things",([
        "书架"     : what_is_this_book,
    ]));

}

void init()
{
    add_action("do_study", "study");
    add_action("do_study", "du");
    add_action("do_qu", "qu");
}

int do_qu(string arg)
{
    object ppl,ob;
    ppl = this_player();
    
    if( !arg || (arg != "fojing" && arg!="佛经"))
        return command( "qu" + arg );
        
    if( ppl->query("family/family_name") != "少林派" )
        return notify_fail( "你不是少林弟子，想偷书么？\n" );
    
    if( !query("have_fojing") )
        return notify_fail( "书架上的佛经已经被取光了。\n");
    
    if( ppl->query_temp("shaolin/qu_fojing") )
        return notify_fail( "你不是刚拿了一本吗？出家人不要那么贪心。。\n");
        
    ob = new( __DIR__"obj/"+books[random(sizeof(books))]);
    ppl -> set_temp("shaolin/qu_fojing",1);
    add( "have_fojing",-1 );
    message_vision( "$N从书架上取下一本" + ob->query("name") +"。\n",ppl);
    ob->move(ppl);
    return 1;
}

int do_study(string arg)
{
    object me = this_player();

    message_vision("请不要在书库里读书。\n", me);

    return 1;
}

