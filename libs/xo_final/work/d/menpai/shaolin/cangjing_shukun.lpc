// 藏经阁北阁书库 : /d/shaolin/cangjing_shukun.c

inherit ROOM;

string * books = ({
    "banruoshenfa",
    "cibeidaofa",
    "ertangjianpu",
    "fumojianpu",
    "lianhuabufa",
    "qufannaozhi",
    "shaolindandao",
//    "weituozhangpu",
});

void init();
int do_study(string);



void create()
{
    set("short","北阁书库");
    set("long",@LONG
这是一间很大的书库，书库中间和四周墙边密密地排满了书架(shelf)。 书
架上的书放得整整齐齐，显得多而不乱。门口立着一块牌子(sign)，上面写着借
书的规矩。
LONG
    );
    set("exits",([
        "south" : __DIR__"cangjing_beige",
    ]) );

    set("item_desc", ([
        "shelf" : "书架上摆满了武功秘籍。\n",
        "sign"  : "每次限取(qu)书一册。\n",
    ]));
    set("no_clean_up", 0);
    set("have_miji",10 );
    setup();
}

void init()
{
    add_action("do_study", "study");
    add_action("do_study", "du");
    add_action("do_qu"   , "qu");
}

int do_qu(string arg)
{
    object ppl,ob;
    ppl = this_player();
    
    if( !arg || ( arg != "shu" && arg != "mi ji" && arg!="书" && arg!="秘籍") )
        return command( "qu" + arg );
        
    if( ppl->query("family/family_name") != "少林派" )
        return notify_fail( "你不是少林弟子，想偷书么？\n" );
    
    if( !query("have_miji") )
        return notify_fail( "今天书架上的武功秘籍已经被取光了。\n");
    
    if( ppl->query_temp("shaolin/qu_miji1") )
        return notify_fail( "你不是刚拿了一本吗？出家人不要那么贪心。。\n");
        
    ob = new( __DIR__"book/"+books[random(sizeof(books))]);
    ppl -> set_temp("shaolin/qu_miji1",1);
    add( "have_miji",-1 );
    message_vision( "$N从书架上取下一本" + ob->query("name") +"。\n",ppl);
    ob->move(ppl);
    return 1;
}


int do_study(string arg)
{
    object me = this_player();

    message_vision("请不要在书库里读书。\n", me);

    return 1;
}

