// 藏经阁西阁书库 : /d/shaolin/cangjing_shukuw.c

inherit ROOM;

string * books = ({
    "banruozhangfa",
    "damojianpu",
    "duoluoyezhi",
    "fengmodaopu",
    "fumozhangfa",
    "jimiezhua",
    "lixuebufa",
    "longxingjianpu",
    "meihuadaopu",
    "mohezhijue",
    "qianyeshou",
    "ruyingsuixing",
    "sanhuazhang",
    "tianzhufoshou",
    "wudingzhi",
});    

void init();
void close(object room);
int do_study(string);
int do_move(string);



void create()
{
    set("short","西阁书库");
    set("long",@LONG
这是一间很大的书库，书库中间和四周墙边密密地排满了书架(shelf)。 书
架上的书放得整整齐齐，显得多而不乱。门口立着一块牌子(sign)，上面写着借
书的规矩。
LONG
    );
    set("exits",([
        "south" : __DIR__"cangjing_xige",
    ]) );

    set("item_desc", ([
        "shelf" : "书架上摆满了武功秘籍。\n",
        "sign"  : "每次限取书一册。\n",        
    ]));
    set("have_miji",10);
    set("no_clean_up", 0);
    
    setup();
}

void init()
{
    add_action("do_study", "study");
    add_action("do_study", "du");
    add_action("do_move" , "move");
    add_action("do_qu"   , "qu" );
}

int do_qu(string arg)
{
    object ppl,ob;
    ppl = this_player();
    
    if( !arg || ( arg != "shu" && arg != "mi ji") )
        return command( "qu" + arg );
        
    if( ppl->query("family/family_name") != "少林派" )
        return notify_fail( "你不是少林弟子，想偷书么？\n" );
    
    //if(!me->query("hydra/shaolin/allow_enter_shuku")
    //   return notify_fail("你未经方丈允许，不得取武功秘籍！\n");
    
    if( !query("have_miji") )
        return notify_fail( "今天书架上的武功秘籍已经被取光了。\n");
    
    if( ppl->query_temp("shaolin/qu_miji2") )
        return notify_fail( "你不是刚拿了一本吗？出家人不要那么贪心。。\n");
        
    ob = new( __DIR__"book/"+books[random(sizeof(books))]);
    ppl -> set_temp("shaolin/qu_miji2",1);
    add( "have_miji",-1 );
    message_vision( "$N从书架上取下一本" + ob->query("name") +"。\n",ppl);
    ob->move(ppl);
    return 1;
}

int do_study(string arg)
{
    object me = this_player();

    message_vision("请不要在书库里读书。\n", me);

    return 1;
}

int do_move(string arg)
{
    object me = this_player();

    if (arg != "shelf") return command("move "+arg);

    message_vision("$N将墙边的一排书架移开。\n", me);
    message_vision("$N墙上顿时出现了一个入口。\n", me);

    set("exits/enter", __DIR__"cangjing_midao");

    remove_call_out("close");
    call_out("close", 5, this_object());

    return 1;
}

void close(object room)
{
        message("vision","只听一阵“吱吱”作响，书架自动移回原处，又将入口掩上了。\n", room);
        room->delete("exits/enter");
}

