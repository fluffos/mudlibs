#include <ansi.h>

inherit ROOM;



void create()
{
	set("short", CYN"立佛殿"NOR);
	set("long", @LONG
少林立佛殿，这里立有一座高及殿顶的释迦牟尼的金身立像。佛祖站立于讲
经台之上，面露微笑，眉目慈祥，手指捏兰花之型。四周众徒拱卫聆听。整座塑
像雕工精细，造型生动，显然出自名家手笔。佛殿两厢的墙壁之上绘有壁画，讲
的是佛经上生死轮回，潜心礼佛而遇难呈祥的诸般故事。
LONG
	);
	set("exits", ([ /* sizeof() == 1 */
		"north": __DIR__"tianwang-dian.lpc",
		"south": __DIR__"dadao1.lpc",
	]));
	set("need_clean", "少林派");
	set("objects", ([
        __DIR__"npc/heshang6.lpc" :2,
    ])); 
    
	setup();
}

void init()
{
//        add_action("da_sao", "sao");
        add_action("da_sao", "clean");
}

int da_sao(string arg)
{
    object me;
    mapping quest;
    me = this_player();
    if( !me->can_act() ) return notify_fail("你现在无法打扫。\n");

    if( call_other("/cmds/verb/clean", "main", me, arg ) )
    {
        if( quest = me->query("quest") )
        {
            if( quest["quest"] == "打扫立佛殿" )
            me->set("oldquest/status", "打扫立佛殿" );
            return 1;
        }
        return 1;
    }
    return 0;
}

