{
   	set("short", "膳堂");
   	set("long", @LONG
这里是少林寺有职位的高僧用斋的地方。膳堂不大，从东到西摆了两排长长
的餐桌和长凳，几位小和尚正来回忙碌着布置素斋。素斋做得十分精致，远远就
可以闻到扑鼻的香气。
LONG
	);
	
	set("exits", ([ /* sizeof() == 1 */
		"south": __DIR__"zhaiyuan.lpc",
		"north": __DIR__"xiangji-chu.lpc",
    ]));
	set("objects", ([
		__DIR__"npc/huwei" : 2,
       	]) );
	setup();
