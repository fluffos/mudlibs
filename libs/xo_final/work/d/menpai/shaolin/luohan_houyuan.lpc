// Room: /d/shaolin/luohan_houyuan.c
// Hydra 19980523 for 少林弟子 升级

#define OUT     "/d/menpai/shaolin/luohan_tang4"

#include <ansi.h>

inherit ROOM;



void create()
{
    set("short", YEL"罗汉堂后院"NOR);
    set("long", @LONG
这里是少林弟子升级的地方，你必须在这里打败降龙伏虎两罗汉，才能获得
玄生大师的推荐，获得向玄字辈高僧学习的机会。降龙伏虎两罗汉如两尊铁塔，
矗立在此，正等待着你。
LONG
    );
    set("objects", ([
        __DIR__"npc3/huisi"   : 1,
        __DIR__"npc3/huitong"  : 1,
    ]));
    setup();
}

void init()
{
    object me = this_player();
    add_action("do_quit", "quit");
    add_action("do_stop", "stop");
    add_action("do_kill", "kill");
    add_action("do_bihua", "bihua");
    add_action("do_fight", "fight");
    add_action("do_surrender", "surrender");
    add_action("do_use", "use"); 
    add_action("do_fu", "fu");     
    if(userp(me) && me->query("hydra/shaolin/in_chuang") )
    {
        call_out("do_check",3,me);
    }
}

void full(object ob)
{
    ob -> set("eff_kee",ob->query("max_kee"));
    ob -> set("kee",ob->query("max_kee"));
    ob -> set("eff_sen",ob->query("max_sen"));
    ob -> set("sen",ob->query("max_sen"));
    ob -> set("force",ob->query("max_force"));
}

void welcome_visitor( object me )
{
    object xianglong,fuhu,this;
    this = this_object();
    if( !me->query("hydra/shaolin/in_chuang") )
        return;
    if(!xianglong = present("hui si",this) )
        xianglong = new("/d/menpai/shaolin/npc3/huisi");
    if(!fuhu = present("hui tong",this) )
        fuhu = new("/d/menpai/shaolin/npc3/huitong");
    message_vision(CYN"慧思慧通见$N过来，一点头，同时说道：小心了！\n\n"
        "说着，便拍掌向你攻来。\n\n"NOR,me);
    xianglong -> set( "force_factor",150 );
    xianglong -> set( "force",1500 );
    xianglong -> set( "env/attack",75 );
    fuhu -> set( "force_factor",150 );
    fuhu -> set( "force",1500 );
    fuhu -> set( "env/attack",75 );
    full(xianglong);
    full(fuhu);
    xianglong->bihua_ob(me);
    me->bihua_ob(xianglong);
    fuhu->bihua_ob(me);
    me->bihua_ob(fuhu);
}

int do_quit(string arg)
{
    write("临阵脱逃？逃不掉啦，打吧！\n");
    return 1;
}
int do_use(string arg)
{
    write("可没那么便宜的事！\n");
    return 1;
}

int do_fu(string arg)
{
    write("可没那么便宜的事！\n");
    return 1;
} 
int do_stop(string arg)
{
    write("既然接受了挑战你就不能罢战了。\n");
    return 1;
}

int do_kill(string arg)
{
    write("不是让你比划吗...\n");
    return 1;
}
int do_surrender(string arg)
{
    write("能放过么，能求饶么...\n");
    return 1;
}

int do_bihua(string arg)
{
    write("不是已经打了么？\n");
    return 1;
}

int do_fight(string arg)
{
    write("不是已经打了么？\n");
    return 1;
}

void do_check( object me )
{
    remove_call_out( "do_check" );
    if ( me->query_temp( "hydra/shaolin/finish_fight" ) ||
         me->query_temp( "netdead" ) ||
         !living( me ) )
    {
        remove_call_out( "done_test" );
        call_out( "done_test", 1, me );
    }
    else
    {
        call_out( "do_check", 3, me );
    }
}

void done_test( object me )
{
    remove_call_out( "done_test" );
    remove_call_out( "do_check" );
    if(!me->is_ghost())  
    {
        message_vision( YEL"\n比试完了，暗门打开，$N走了出去。\n"NOR,me );
        me -> delete_temp("hydra/shaolin/finish_fight");
        me -> move( OUT );
    }
}
