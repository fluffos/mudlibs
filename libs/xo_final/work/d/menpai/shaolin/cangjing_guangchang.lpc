int valid_leave(object me, string dir) {
  object ob;
  if (me->query("family/family_name") != "少林派"
    && dir == "enter"
    && objectp(ob = present("shaolin sengbing", this_object()))
    && living(ob)) {
    message_vision("$N拦住$n，“师主请留步，本寺藏经重地，外人请勿擅入。！”\n",
      ob, me);
    return notify_fail("你只得收住脚\n");
  }
  //    if(!me->query("hydra/shaolin/allow_enter_shuku")
  //    && dir=="enter" )
  //    return notify_fail("你未经方丈允许，不得进入藏经阁！\n");
  return ::valid_leave(me, dir);
}
