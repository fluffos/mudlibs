// muren_xiang/npc/npc.c
#include <ansi.h>

inherit NPC;

void setup()
{
    mapping my = query_entire_dbase();

    if ( !my["name"]) set_name("木人", ({"mu ren", "muren", "mu-ren"}));
    if ( !my["long"]) set("long", "这是一个制作精巧的机关木人，雕工精细，眉目传神。\n");
    if ( !my["gender"]) set("gender", "男性");
    if ( !my["title"]) set("title", NOR);
    if ( !my["attitude"]) set("attitude", "peaceful");

    if ( !my["age"]) set("age", 30);

    if ( !my["sen"]) set("sen", 500);

    ::setup();
}

void win_bihua( object who )
{
    who->set_temp("finish_bihua", 1);
    who->set_temp("be_defeated", 1);
}

void lose_bihua( object who )
{
    who->set_temp("finish_bihua", 1);
    who->set_temp("be_defeated", 0);
}
