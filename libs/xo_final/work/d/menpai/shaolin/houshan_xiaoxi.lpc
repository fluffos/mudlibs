// hou shan xiao xi : /d/shaolin/houshan_xiaoxi.c

inherit ROOM;
#include <ansi.h>
void init();
int do_look(string);
int do_jump(string);



void create() {
  set("short", "后山小溪");
  set("long", @LONG
你掉入一条小溪中，呛了好大一口水。你费了九牛二虎之力才爬上一块溪水
中突出的岩石，活象个落汤鸡。岸边有只蛤蟆张开大嘴，冲着你直叫唤，
好象非常快乐的样子。缥缈的水雾是瀑布看起来更加美丽。
LONG
  );

  set("item_desc", ([
    "bank": "岸上就是少林寺的后山。\n",
  ]));

  setup();
}

void init() {
  add_action("do_jump", "jump");
  add_action("do_look", "look");
}

int do_jump(string arg) {
  object me = this_player();

  if (arg != "岸边")
    return command("jump " + arg);
  message_vision("$N提足一口气，跃回了岸上。\n", me);
  me->move(__DIR__ "houshan_pubu");

  return 1;
}

int do_look(string arg) {
  object me = this_player();
  if (arg != "瀑布") {
    return command("look " + arg);
  }
  if (me->query("gin") < 50 || random(me->query_kar()) < 31 || me->query("social_exp") < 20000) {
    message_vision(YEL "$N看着瀑布，水花四溅，细细的水珠纷纷钻进你的脖子。\n" NOR, me);
    message_vision(YEL "纷飞的水雾让$N看起来却突然觉得有些伤神。\n" NOR, me);
    me->unconcious();
    return 1;
  }
  tell_object(me, RED "你透过水布隐约看见瀑布中似乎别有洞天，莫不是一个“水帘洞”?\n" NOR);
  me->set_temp("shaolin/damo", 1);
  return 1;
}
