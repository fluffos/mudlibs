#include <ansi.h>

inherit ROOM;



void create() {
  set("short", "走廊");
  set("long", @LONG 
少林寺藏经阁的中心，从这里可以到达一楼的所有藏经室，也可以从这里上
楼。楼上所藏不同于一楼的经卷，而是少林的武功秘籍，修为到了一定程度的武
僧可以上楼参悟武学秘籍。
LONG);

  set("exits", ([
    "east": __DIR__ "cangjing_ge3",
    "west": __DIR__ "cangjing_ge4",
    "north": __DIR__ "cangjing_ge6",
    "south": __DIR__ "cangjing_ge2",
    "up": __DIR__ "cangjing_ge21",
  ]));
  set("objects", ([
    __DIR__ "npc/huwei1": 3,
  ]));

  setup();
}

int volid_leave(object me, string dir) {
  if (dir == "up")
    return notify_fail(RED @LONG
你兴冲冲地向楼上爬去。突然，只听楼上有人冷哼了一声，你抬头一看，
一位干枯的老僧正站在楼梯口，只见他袍袖轻轻一动，你只觉一堵气墙
迎面压了下来。“破衲功！”这个传奇式的名字在你脑中一闪，这时你
已经象一捆稻草一样飞了出去！
LONG NOR);
  return ::valid_leave(me, dir);
}
