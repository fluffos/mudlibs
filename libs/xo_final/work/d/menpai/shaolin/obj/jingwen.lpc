// jianshu.c

inherit ITEM;



void create()
{
    set_name("旧经书", ({ "jing shu", "book", "shu" }));
    set_weight(300);
	if( clonep() )
		set_default_object(__FILE__);
	else {
        set("unit", "本");
        set("long","这是一本十分破旧的经书。\n");
          set("value",1);
        set("material", "paper");
        set("skill", ([
			"name"             :  "literate",  
            "xiuwei_required"  : 0,
            "literate_required" : 0,
            "gin_cost"         : 10+random(10),
            "max_lingwu"        : 20,
            "bonus_jilei"      : 5,
            "bonus_social_exp" : 2,
            "max_social_exp"   : 300,
		]) );
	}
}
