#include <weapon.h>
//  shaolin:jiedao
#include <ansi.h>
inherit BLADE;
//inherit F_SAVE;
//inherit F_AUTOLOAD;


void create()
{
	set_name("戒刀", ({ "blade"}) );
	set_weight(1500);
        set("long","一把普普通通的戒刀，结实耐用.\n");
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "把");
		set("value", 800);
		set("material", "iron");
	}
	init_blade(10);
	set("wield_msg", "$N抽出一把$n握在手中。\n");
	set("unwield_msg", "$N将手中的$n插入腰间。\n");
	setup();
}
