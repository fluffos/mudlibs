// fang zhang jing she ke ting : /d/shaolin/fangzhang_hall.c

inherit ROOM;



void create() {
  set("short", "方丈精舍客厅");
  set("long", @LONG
这是一个并不算很大的客厅，正前方的香案上敬着一樽佛像，地上四散摆着
几个蒲团，却又丝毫不显凌乱。一位老僧在蒲团上打坐，仿佛已完全出离于外界
的尘嚣。往西是一间书房，东边有一扇小门虚掩着......往南就可以走出方丈精
舍。
LONG
  );
  set("exits", ([
    "south": __DIR__ "fangzhang_changlang2",
    "west": __DIR__ "fangzhang_shufang",
    "east": __DIR__ "fangzhang_chanfang",
  ]));

  set("need_clean", "少林派");

  setup();
}

void init() {
  add_action("da_sao", "sao");
  add_action("da_sao", "clean");
}

int da_sao(string arg) {
  object me;
  mapping quest;
  me = this_player();
  if (!me->can_act()) return notify_fail("你现在无法打扫。\n");

  if (call_other("/cmds/verb/clean", "main", me, arg)) {
    if (quest = me->query("quest")) {
      if (quest["quest"] == "打扫方丈精舍客厅")
        me->set("oldquest/status", "打扫方丈精舍客厅");
      return 1;
    }
    return 1;
  }
  return 0;
}
