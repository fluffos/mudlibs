// fang zhang shu fang : /d/shaolin/fangzhang_shufang.c

inherit ROOM;

void init();
int do_jump(string);



void create()
{
    set("short","方丈精舍书房");
    set("long",@LONG
这是方丈用于会见贵客的书房，西面和南面是两排靠墙的书架，北面靠墙是
一张书桌，窗口(window)正对着后院，有竹枝清翠，疏影横斜，好一处悠然的所
在！这里往东可以回到大厅。
LONG
    );
    set( "exits", ([
        "east" : __DIR__"fangzhang_hall",
    ]) );

    set("objects", ([
        __DIR__"npc3/xuanci" : 1,
    ]));

    set("item_desc", ([
        "window" : "窗外是方丈精舍后院。\n",
    ]) );

    setup();
}

void init()
{
    add_action("do_jump", "jump");
}


int do_jump(string arg)
{
    object me = this_player();

    if (arg != "window") return command("jump "+arg);

    message_vision("$N嗖地一声，从窗口跳了出去。\n", me);

    me->move(__DIR__"fangzhang_houyuan");

    return 1;
}

