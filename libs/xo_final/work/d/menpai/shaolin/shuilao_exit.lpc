inherit ROOM;



void create()
{
	set("short", "水牢出口");
	set("long", @LONG
这里是少林寺水牢的出口。从阴暗的充满着令人作呕的臭气的水牢出来到这
里，站在干燥的砖地上，呼吸着干燥的空气，身上沐浴着从门口斜射进来的几缕
阳光，真令人有隔世为人的感慨。
LONG );
	set("exits",([
                  "up" : __DIR__"jielu_yuan0",
	]) );
	setup();
}
