#include <ansi.h>

inherit ROOM;



void create()
{
	set("short", CYN"法堂"NOR);
	set("long", @LONG
少林法堂。本寺高僧和远游来的游方高僧讲经说法的地方。整个讲堂整洁肃
穆，许多黄布绸幡从天花板上直垂而下，地上一溜摆着数十个蒲团，供听讲弟子
围坐。法堂南首有一个高台，高台上摆着一个檀木条案，条案背后是一个黄布蒲
团，讲经的高僧就坐在上面。这里平时就作为弟子向师傅请教的地方。
LONG
	);
	set("exits", ([ /* sizeof() == 1 */
		"west" : __DIR__"sheli_yuan.lpc",
		"south": __DIR__"daxiong-baodian.lpc",
        "north": __DIR__"zhongyang_guangchang1.lpc",
	]));
	set("objects", ([
		__DIR__"npc/huwei" : 2,
        __DIR__"npc/xuyin" : 1,
        __DIR__"npc3/huijue": 1,
		]) );
	set("need_clean", "少林派");
	set("no_fight",1);
	setup();
//       call_other( CLONE_DIR "board/shaolin_b", "???");
}

void init()
{
        add_action("da_sao", "sao");
        add_action("da_sao", "clean");
        add_action("do_zuo","zuo");
}

int da_sao(string arg)
{
    object me;
    mapping quest;
    me = this_player();
    if( !me->can_act() ) return notify_fail("你现在无法打扫。\n");

    if( call_other("/cmds/verb/clean", "main", me, arg ) )
    {
        if( quest = me->query("quest") )
        {
            if( quest["quest"] == "打扫法堂" )
            me->set("oldquest/status", "打扫法堂" );
            return 1;
        }
        return 1;
    }
    return 0;
}

int do_zuo( string arg )
{
    object me = this_player();
//    if( me->query("family/family_name") != "少林派" )
//        return notify_fail("你又不是少林弟子，坐下来干吗？\n");
    if( !query("can_zuo"))
        return notify_fail("现在又不是早课时间，你坐下来干什么？\n");
    if( me->query_temp("shaolin/ready_listen") )
        return notify_fail("你不是已经坐下了吗？\n");
    if( !me->can_act() )
        return notify_fail("你现在无法坐下来听课！\n");
    me -> add( "shaolin/can_read_jing",10 );
    if( me->query("gender")=="女性")
    tell_object( me,WHT"你小心翼翼的坐了下来，心扑通扑通直跳！\n"NOR);
    else   tell_object( me,"你找了个蒲团，盘腿坐下，准备开始听课。\n");
    me -> set_temp("shaolin/ready_listen",1);
    me -> start_busy(10,"你正在听课，一定要专心哦！\n");
    return 1;
}

int valid_leave( object who, string dir )
{
    object me;
    if( dir == "north" &&  (who->query("class") != "bonze") && (who->query("class") != "bonze1") )
    {
        if((me = present( "huwei seng", this_object() )) && !wizardp(who) &&
            me->can_act())
        {
            message_vision("灰衣护卫僧双手合十，对$N恭谨地说：“施主且留步，\n"
                        "里面乃本派内室，还请施主见谅。”\n", who );
            return notify_fail("你只好收住了脚。\n");
        }
    }
    who->delete_temp("shaolin/ready_listen");
    return ::valid_leave( who, dir );
}

