// hou shan pu bu : /d/shaolin/houshan_pubu.c

inherit ROOM;
#include <ansi.h>
void init();
int do_jump(string);



void create()
{
    set("short","后山瀑布");
    set("long",@LONG
走到这里，眼前一片开阔。一道瀑布挂在前方，犹如一条雪白的帘子遮住了
峭壁。瀑布的水顺山石而下，汇成了一道小溪，潺潺流淌着。瀑布旁的
峭壁上隐隐有一行小字。低头往脚下一看，这里是山崖边一块突出的大
岩石，光秃秃的，寸草不生，连飞鸟也不愿在此逗留。四周静得出奇。再往前显
然已经没有路了。
LONG
    );
    set("exits", ([
        "south" : __DIR__"houshan_zhulin6",
    ]) );

    set("item_desc", ([
        "小字" : "达摩练剑处\n",
    ]) );

    setup();
}

void init()
{
    add_action("do_jump", "jump");
}

int do_jump(string arg)
{
    object me = this_player();
    	object *all;
	int i;
	all=all_inventory(me);

    if (arg != "pubu" && arg != "瀑布" && arg != "小溪")
        return command("jump "+arg);
    	    for(i=0;i<sizeof(all);i++)
		if(userp(all[i])){
		    message_vision("$N把$n往地下一摔，鼓足勇气向瀑布走去，走近才发现瀑布的绚丽多姿。\n",me,all[i]);
		    all[i]->move("/clone/misc/void");
		}
    if (arg == "pubu" || arg == "瀑布")
    {
    	if (random(10)&&me->query_jibie("yiwei-dujiang")>99&&me->query_temp("shaolin/damo")>=1)
    	{
        message_vision("$N提足一口气，一个【燕子投林】跃入瀑布，四周的水在$N身边快速泻下，\n", me);
        message_vision("通过水布看外面非常的绚丽。湿漉漉的穿过瀑布,发现其中别有洞天。\n", me);
        me->move(__DIR__"pubuzhong");
        me->set_temp("shaolin/damo",2);
         }
         else
        {message_vision("$N搓动掌心，一招【一苇渡江】，跳入了瀑布之中,只听见一声惨叫，顿时随水失去了踪影。\n", me);
         me->die();}
    }
    else
    {
        message_vision("$N一纵身，一招【屁股向后，平沙落雁式】飞向瀑布，结果一整风吹来。\n", me);
        message_vision("只听得“扑通”一声，$N一下子倒栽在了小溪里面，全身湿漉漉的在那里茫然失措。\n", me);
        message_vision("果然不愧为【屁股向后，平沙落雁式】...@_@哈哈 \n", me);
        me->move(__DIR__"houshan_xiaoxi");
    }
    return 1;
}
