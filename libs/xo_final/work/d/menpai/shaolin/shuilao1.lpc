#include <ansi.h>
#include "shuilao.h"
inherit ROOM;



void create()
{
	set("short", BLU"水牢"NOR);
	set("long", BLU @LONG
少林寺的水牢。这里是少林寺专门关押桀傲不驯、顽固不化的犯规弟子和罪
大恶极、恶贯满盈的江湖黑道人物的地方。整个房间黑漆漆的，只有湿漉漉的花
岗石砌的墙壁上的几盏油灯发出摇曳不定而又惨淡微弱的光芒。犯人就站在没到
胸口的黑乎乎的积水中。积水散发出一种难闻的味道，令人眩晕欲呕。不知这里
曾经关押过多少江洋大盗，多少江湖上名动一时的人物在此度过最后的岁月。
LONG NOR);
	set("exits",([
		"north" : __DIR__"shuilao2",
		"east"  : __DIR__"shuilao3",
	]) );
	set("no_fight", 1);
	set("resource/water",1);
	set("fillplace", BLU"没到胸口的污水"NOR);
	set("watername", BLU"散发着令人作呕的气味，漂浮着许多不知是什么生物的污水"NOR);
	switch(random(2))
	{
		case 0:
		break;
		case 1:
		set("objects",([
			__DIR__"npc/fanren" : random(2)+1,
		]) );
		break;
	}
	setup();
}
