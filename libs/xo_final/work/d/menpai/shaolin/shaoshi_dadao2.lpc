// road for enter shaolin: lin on 06/01/97 02:00AM
// shaoshi_dadao2.c
#include <ansi.h>
#include <room.h>

inherit ROOM;



void create()
{
    set("short",CYN"青石甬道"NOR);
    set("long",@LONG
一条整齐的青石甬道，沿着山势一直向北面山上而去，石板宽阔平整，有些
已显年久之色，有些上面的斧凿痕迹还是崭新的。一些小路顺着树林的间隙穿向
四面八方。北面山上，少林寺黄墙青瓦的山门掩映在一片树影之中。
LONG);
    set("exits",([
         "southdown" : __DIR__"shaoshi_dadao1",
        "northup"     : __DIR__"shanmen_guangchang",        
    ]));
    set("outdoors","shaolin");
    setup();
    //place_program(ROOM);
}
