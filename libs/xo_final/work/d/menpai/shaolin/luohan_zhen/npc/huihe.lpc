//huijing.c 十八罗汉之接引罗汉
#include <ansi.h>
inherit NPC;



void create()
{
	set_name("慧和",({ "hui he","hui","monk" }) );
	set("long",@LONG
他是一位须发花白的老僧，身穿一袭金边红色袈裟。他身材瘦高，
太阳穴高高鼓起，似乎身怀绝世武功。
LONG	);

	set("title", YEL"接引罗汉"NOR);
	set("gender", "男性");
	set("attitude", "friendly");
	set("class", "bonze");

	set("age", 38);
	set("str", 25);
	set("int", 25);
	set("con", 25);
	set("dex", 25);
    set_hp("kee",1000);
    set_hp("sen",500);
	set("force", 2500);
	set("max_force", 2500);
    set("force_factor",250);
	set("combat_exp", 3000000);
	set("class_score", 5000);
    set("positive_score",3000);
    set("social_exp",5000);
    set("env/attack",75);
    
    set_wugong("banruo-shenfa", 185,160,1);
    set_wugong("shaolin-xinfa",120,100,1);
    set_wugong("mohe-zhi",100,100,1);
    set_wugong("fuhu-quan",60);

    set_xiuwei_by_type("unarmed",3500);
    set_xiuwei_by_type("dodge",2100);
    set_xiuwei_by_type("zonggang",300);

	create_family("少林派", 37, "弟子");

	setup();

    carry_object(CLOTH_DIR "hong-jiasha")->wear();
}


#include "xli_hui.h"

