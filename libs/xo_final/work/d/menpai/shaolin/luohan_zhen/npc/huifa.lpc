//huisi.c 十八罗汉之妙音罗汉
#include <ansi.h>
inherit NPC;



void create()
{
	set_name("慧法",({ "hui fa","hui","monk" }) );
	set("long",@LONG
他是一位须发花白的老僧，身穿一袭金边红色袈裟。他身材瘦高，
太阳穴高高鼓起，似乎身怀绝世武功。
LONG	);


	set("title", YEL"妙音罗汉"NOR);
	set("gender", "男性");
	set("attitude", "friendly");
	set("class", "bonze");

	set("age", 50);
	set("str", 25);
	set("int", 25);
	set("con", 25);
	set("dex", 25);
    set_hp("kee",1000);
    set_hp("sen",700);
    set_force(3000,3000,300);
	set("combat_exp", 3600000);
	set("class_score", 5000);
    set("positive_score",3000);
    set("social_exp",6000);
    set("env/attack",75);
    
    set_wugong("banruo-shenfa", 185,160,1);
    set_wugong("shaolin-xinfa",120,100,1);
    set_wugong("longzhua-shou",80,70,1);
    set_wugong("fuhu-quan",60);

    set_xiuwei_by_type("unarmed",random(20000));
    set_xiuwei_by_type("dodge",2500);
    set_xiuwei_by_type("zonggang",300);

	create_family("少林派", 37, "弟子");

	setup();

    carry_object(CLOTH_DIR "hong-jiasha")->wear();
}

#include "xli_hui.h"

