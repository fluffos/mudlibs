// deng.c

#include <ansi.h>;

inherit F_NEW_MASTER;

#include "murong_master.h"

void create() {
  set_name("邓百川", ({ "deng baichuan", "deng" }));
  set("gender", "男性");
  set("age", 42);
  set("long", "他是慕容家四大家臣之首，功力最为深厚。\n");
  set("attitude", "peaceful");
  set("str", 26);
  set("int", 22);
  set("con", 25);
  set("dex", 22);

  set("combat_exp", 750000);

  set_wugong("shenyuan-gong", 300, 300, 1);
  set_wugong("lanting-bifa", 300, 300, 1);
  set_wugong("yuxue-dunxing", 250, 250, 1);

  set_xiuwei_level_by_type("force", 5);
  set_xiuwei_level_by_type("dodge", 5);
  set_xiuwei_level_by_type("short", 7);
  set_xiuwei_level_by_type("zonggang", 5);

  create_family("慕容世家", 17, "家臣");

  set("inquiry", ([
    "慕容博": "那是老主人。\n",
    "慕容复": "他就是我们跟随的公子！\n",
  ]));

  ::create();
  setup();

  carry_object(CLOTH_DIR "cloth1")->wear();
  carry_object(SHORT_DIR "pen")->wield();
}
