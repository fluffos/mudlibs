// wangfuren.c
#include <ansi.h>;

inherit F_NEW_MASTER;

#include "murong_master.h"

void create()
{
    set_name("王夫人", ({ "wang furen","wang" }) );
    set("gender", "女性" );
    set("title", HIM"蔓陀山庄庄主"NOR );
    set("age", 35);
    set("long", "她身穿鹅黄绸衫，眉目口鼻均美艳无伦，脸上却颇有风霜岁月的痕迹。\n");
    set("shen_type", -1);
    set("combat_exp", 100000);
    set("per", 30);
    set("str", 20);
    set("dex", 18);
    set("con", 19);
    set("int", 20);
    set("attitude", "friendly");

    set_wugong("shenyuan-gong", 150, 150, 1);
    set_wugong("meiren-shan", 300, 300, 1);
    set_wugong("wuzhan-mei", 300, 300, 1);
    set_wugong("qingliang-shan", 300, 300, 1);
    set_wugong("hexiang", 300, 300, 1);

    set_xiuwei_level_by_type("force", 3);
    set_xiuwei_level_by_type("dodge", 2);
    set_xiuwei_level_by_type("short", 5);
    set_xiuwei_level_by_type("zonggang", 3);

    create_family("慕容世家", 19, "贵宾");

    ::create();
    setup();
    carry_object(__DIR__"obj/yellow_cloth")->wear();
    carry_object(SHORT_DIR"dagger")->wield();
}
