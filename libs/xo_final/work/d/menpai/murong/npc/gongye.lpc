// gongye.c

#include <ansi.h>;

inherit F_NEW_MASTER;

#include "murong_master.h"

void create() {
  set_name("公冶乾", ({ "gongye qian", "gongye" }));
  set("gender", "男性");
  set("age", 35);
  set("long", "他是慕容家四大家臣之二，为人稳重。\n");
  set("attitude", "peaceful");
  set("str", 27);
  set("int", 24);
  set("con", 26);
  set("dex", 24);

  set("combat_exp", 620000);

  set_wugong("shenyuan-gong", 300, 300, 1);
  set_wugong("tougu-shan", 300, 300, 1);
  set_wugong("fengliu-shan", 300, 300, 1);
  set_wugong("shaonian-you", 250, 250, 1);

  set_xiuwei_level_by_type("force", 5);
  set_xiuwei_level_by_type("dodge", 6);
  set_xiuwei_level_by_type("short", 6);
  set_xiuwei_level_by_type("zonggang", 5);

  create_family("慕容世家", 17, "家臣");

  set("inquiry", ([
    "慕容博": "那是老主人。\n",
    "慕容复": "他就是我们跟随的公子！\n",
  ]));

  ::create();
  setup();

  carry_object(CLOTH_DIR "cloth1")->wear();
  carry_object(SHORT_DIR "zheshan")->wield();
}
