// feng.c

#include <ansi.h>;

inherit F_NEW_MASTER;

#include "murong_master.h"

void create() {
  set_name("风波恶", ({ "feng boe", "feng" }));
  set("gender", "男性");
  set("age", 28);
  set("long", "他是慕容家四大家臣之四，最喜欢打架，轻易却不服输。\n");
  set("attitude", "peaceful");
  set("str", 24);
  set("int", 21);
  set("con", 24);
  set("dex", 28);

  set("combat_exp", 480000);

  set_wugong("shenyuan-gong", 300, 300, 1);
  set_wugong("kuangcao-bifa", 300, 300, 1);
  set_wugong("yuxue-dunxing", 300, 300, 1);

  set_xiuwei_level_by_type("force", 5);
  set_xiuwei_level_by_type("dodge", 5);
  set_xiuwei_level_by_type("short", 3);
  set_xiuwei_level_by_type("zonggang", 5);

  create_family("慕容世家", 17, "家臣");

  set("inquiry", ([
    "慕容博": "那是老主人。\n",
    "慕容复": "他就是我们跟随的公子！\n",
  ]));

  ::create();
  setup();

  carry_object(CLOTH_DIR "cloth1")->wear();
  carry_object(SHORT_DIR "pen")->wield();
}
