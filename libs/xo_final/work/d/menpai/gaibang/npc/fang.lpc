// fang.c

#include <ansi.h>;

inherit F_NEW_MASTER;

#include "gaibang_master.h"

void create() {
  set_name("方舵主", ({ "fang duozhu", "fang", "duozhu" }));
  set("long",
    "这是位衣著邋塌，蓬头垢面的丐帮八袋弟子，现任大仁分舵舵主。\n");
  set("gender", "男性");
  set("nickname", HIG "大仁分舵" HIY "舵主" NOR);
  set("title", "丐帮八袋弟子");
  set("age", 25);
  set("attitude", "peaceful");
  set("class", "beggar");
  set("beggarlvl", 8);
  set("str", 23);
  set("int", 22);
  set("con", 18);
  set("dex", 25);

  set("combat_exp", 69000);

  set_wugong("qiankun-yiqi", 150, 150, 1);
  set_wugong("jueqing-dao", 300, 300, 1);
  set_wugong("yan-shuangfei", 150, 150, 1);

  set_xiuwei_level_by_type("force", 3);
  set_xiuwei_level_by_type("dodge", 3);
  set_xiuwei_level_by_type("blade", 3);
  set_xiuwei_level_by_type("zonggang", 3);

  //set("party/party_name", HIC"丐帮"NOR);
  //set("party/rank", HIG"大仁分舵"HIY"八袋舵主"NOR);
  //set("party/level", 8);
  create_family("丐帮", 19, "弟子");

  ::create();
  setup();

  carry_object(__DIR__ "obj/cloth")->wear();
  carry_object(BLADE_DIR "blade")->wield();
}
