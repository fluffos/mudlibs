// xiang.c

#include <ansi.h>;

inherit F_NEW_MASTER;

#include "gaibang_master.h"

void create()
{
    set_name("项长老", ({"xiang zhanglao", "xiang", "zhanglao"}));
    set("nickname", HIR "丐帮六老" NOR);
    set("gender", "男性");
    set("title", "丐帮九袋长老");
    set("age", 59);
    set("attitude", "peaceful");
    set("class", "beggar");
     set("beggarlvl", 9);

    set("str", 30);
    set("int", 24);
    set("con", 30);
    set("dex", 24);

    set("combat_exp", 1500000);
    set("shen", 100000);

    set_wugong("qiankun-yiqi", 300, 300, 1);
    set_wugong("wuxing-quan", 300, 300, 1);
    set_wugong("yan-shuangfei", 200, 200, 1);

    set_xiuwei_level_by_type("force", 4);
    set_xiuwei_level_by_type("dodge", 3);
    set_xiuwei_level_by_type("unarmed", 6);
    set_xiuwei_level_by_type("zonggang", 4);

    //set("party/party_name", HIC"丐帮"NOR);
    //set("party/rank", RED"九袋长老"NOR);
    //set("party/level", 9);
    create_family("丐帮", 18, "长老");

    setup();

    carry_object(__DIR__"obj/cloth")->wear();
}

