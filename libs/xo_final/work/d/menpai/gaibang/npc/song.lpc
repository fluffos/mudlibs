// song.c

#include <ansi.h>;

inherit F_NEW_MASTER;

#include "gaibang_master.h"

void create() {
  set_name("宋长老", ({ "song zhanglao", "song", "zhanglao" }));
  set("nickname", "丐帮六老");
  set("gender", "男性");
  set("age", 50);
  set("long", "他是一个白须老者，是本帮外家奇门兵器高手。\n");
  set("attitude", "peaceful");
  set("class", "beggar");
  set("beggarlvl", 9);

  set("str", 24);
  set("int", 20);
  set("con", 24);
  set("dex", 20);

  set("combat_exp", 100000);

  set_wugong("qiankun-yiqi", 200, 200, 1);
  set_wugong("long-blade", 300, 300, 1);
  set_wugong("shanduo-zhishu", 300, 300, 1);

  set_xiuwei_level_by_type("force", 4);
  set_xiuwei_level_by_type("dodge", 4);
  set_xiuwei_level_by_type("blade", 2);
  set_xiuwei_level_by_type("zonggang", 4);

  set("party/party_name", HIC "丐帮" NOR);
  set("party/rank", RED "九袋长老" NOR);
  set("party/level", 9);
  create_family("丐帮", 10, "弟子");

  ::create();
  setup();

  carry_object(BLADE_DIR "blade")->wield();
  carry_object(__DIR__ "obj/cloth")->wear();
}
