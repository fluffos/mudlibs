// xie.c
#include <ansi.h>;

inherit F_NEW_MASTER;

#include "gaibang_master.h"

void create()
{
    set_name("谢副舵主", ({"xie duozhu", "xie", "duozhu"}));
    set("gender", "男性");
    set("nickname", HIG"大义分舵"HIY"副舵主"NOR);
    set("title", "丐帮八袋弟子");
    set("age", 25);
    set("attitude", "peaceful");
    set("class", "beggar");
     set("beggarlvl", 8);
    set("str", 23);
    set("int", 22);
    set("con", 18);
    set("dex", 25);

    set("combat_exp", 69000);

    set_wugong("qiankun-yiqi", 150, 150, 1);
    set_wugong("qinglong-dao", 300, 300, 1);
    set_wugong("yan-shuangfei", 150, 150, 1);

    set_xiuwei_level_by_type("force", 3);
    set_xiuwei_level_by_type("dodge", 3);
    set_xiuwei_level_by_type("blade", 2);
    set_xiuwei_level_by_type("zonggang", 3);

    //set("party/party_name", HIC"丐帮"NOR);
    //set("party/rank", HIG"大义分舵"HIY"七袋副舵主"NOR);
    //set("party/level", 7);
    create_family("丐帮", 19, "弟子");

    ::create();
    setup();

    carry_object(__DIR__"obj/cloth")->wear();
    carry_object(BLADE_DIR"blade")->wield();
}

