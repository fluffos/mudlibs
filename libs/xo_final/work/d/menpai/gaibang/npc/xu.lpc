// xu.c

#include <ansi.h>;

inherit F_NEW_MASTER;

#include "gaibang_master.h"

void create()
{
    set_name("徐长老", ({"xu zhanglao", "xu", "zhanglao"}));
    set("gender", "男性");
    set("age", 85);
    set("long", "白须飘动，穿着一身补丁累累的鹑衣，是个年纪极高的老丐。\n");
    set("title", "丐帮九袋长老");
    set("attitude", "peaceful");
    set("class", "beggar");
     set("beggarlvl", 9);
    set("no_get", "1");

    set("str", 24);
    set("int", 20);
    set("con", 24);
    set("dex", 20);

    set("combat_exp", 100000);

    set_wugong("qiankun-yiqi", 300, 300, 1);
    set_wugong("baxian-zhang", 300, 300, 1);
    set_wugong("meihua-bu", 300, 300, 1);

    set_xiuwei_level_by_type("force", 4);
    set_xiuwei_level_by_type("dodge", 4);
    set_xiuwei_level_by_type("unarmed", 7);
    set_xiuwei_level_by_type("zonggang", 4);

    //set("party/party_name", HIC"丐帮"NOR);
    //set("party/rank", RED"九袋长老"NOR);
    //set("party/level", 9);
    create_family("丐帮", 18, "长老");

    ::create();
    setup();

    carry_object(__DIR__"obj/cloth")->wear();
}

