// This program is a part of NT MudLIB

#include <ansi.h>;

inherit F_NEW_MASTER;

#include "gaibang_master.h"

void create()
{
    set_name("余洪兴", ({"yu hongxing", "yu", "hongxing"}));
    set("title", "丐帮八袋弟子");
    set("gender", "男性");
    set("age", 30);
    set("long",
        "这是位笑眯眯的丐帮八袋弟子，生性多智，外号小吴用。\n");
    set("attitude", "peaceful");
    set("class", "beggar");

    set("str", 20);
    set("int", 30);
    set("con", 22);
    set("dex", 20);

    set("combat_exp", 300000);

    set_wugong("qiankun-yiqi", 150, 150, 1);
    set_wugong("liaoyuan-qiangfa", 300, 300, 1);
    set_wugong("yan-shuangfei", 150, 150, 1);

    set_xiuwei_level_by_type("force", 3);
    set_xiuwei_level_by_type("dodge", 3);
    set_xiuwei_level_by_type("long", 3);
    set_xiuwei_level_by_type("zonggang", 3);

    create_family("丐帮", 19, "弟子");

    set_temp("apply/damage", 100);
    set_temp("apply/unarmed_damage", 100);
    set_temp("apply/armor", 200);

    ::create();
    setup();

    carry_object(__DIR__"obj/cloth")->wear();
    carry_object(LONG_DIR"qiang")->wield();
}

