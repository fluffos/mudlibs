// chen-guyan.c

#include <ansi.h>;

inherit F_NEW_MASTER;

#include "gaibang_master.h"

void create() {
  set_name("陈孤雁", ({ "chen guyan", "chen", "guyan" }));
  set("nickname", "长臂叟");
  set("gender", "男性");
  set("title", "丐帮九袋长老");
  set("age", 50);
  set("long", "他是一个两条手臂甚长的老者。\n");
  set("attitude", "peaceful");
  set("class", "beggar");
  set("beggarlvl", 9);

  set("str", 24);
  set("int", 20);
  set("con", 24);
  set("dex", 20);

  set("combat_exp", 100000);

  set_wugong("qiankun-yiqi", 200, 200, 1);
  set_wugong("bagua-dao", 300, 300, 1);
  set_wugong("yan-shuangfei", 300, 300, 1);

  set_xiuwei_level_by_type("force", 4);
  set_xiuwei_level_by_type("dodge", 3);
  set_xiuwei_level_by_type("blade", 5);
  set_xiuwei_level_by_type("zonggang", 4);

  //set("party/party_name", HIC"丐帮"NOR);
  //set("party/rank", RED"九袋长老"NOR);
  //set("party/level", 9);
  create_family("丐帮", 18, "弟子");

  ::create();
  setup();

  carry_object(__DIR__ "obj/cloth")->wear();
  carry_object(BLADE_DIR "blade")->wield();
}
