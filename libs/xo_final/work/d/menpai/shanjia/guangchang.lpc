inherit ROOM;

void create()
{
    set("short",    "岱庙广场");
    set("long",     @LONG
泰山号称“东岳”、“岱宗”，故而泰山脚下的泰安城里面有座岱庙供奉东
岳大帝。岱庙前的广场也是城里面最热闹的地方，许多小贩和游人挤来挤去，有
不少还愿的人们从广场上就开始虔诚地参拜起来。广场的北面就是岱庙了，东面
的东街通向东门。
LONG
    );
    set("outdoors", "taian"); 
    set("exits",    ([
        //"north"     :   __DIR__"daimiao",
        "south"     :   __DIR__"nanjie",
        "east"      :   __DIR__"dongjie",
    ])  );
    setup();
}
