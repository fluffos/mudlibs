inherit ROOM;

void create() {
  set("short", "小酒馆");
  set("long", @LONG
一间小小的酒馆，里面摆放着三两张桌子，桌旁的长凳上坐着几个闲人在喝
酒闲聊。一旁的柜台上放着些酒壶和酒菜，也无非是白干、花生、豆腐而已，正
是小地方人们一天闲下来后聚在一起吹吹牛，传传闲话的地方。
LONG
  );
  set("exits", ([
    "east": __DIR__ "nanjie",
  ]));
  /*
    set("objects",  ([
        __DIR__"npc/wang_xiaowu"    :   1,
        __DIR__"npc/jiuke"          :   2,
    ])  );
*/
  setup();
}
