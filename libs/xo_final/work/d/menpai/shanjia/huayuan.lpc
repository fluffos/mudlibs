inherit ROOM;

void create()
{
    set("short",    "花园");
    set("long",     @LONG
LONG
    );
    set("outdoors",     "shanjia");
    set("need_clean",   "单家");
    set("exits",    ([
        "south"     :   __DIR__"houyuan",
        "northwest" :   __DIR__"xi_pangmen",
        "northeast" :   __DIR__"dong_pangmen",
    ])  );
    setup();
}
