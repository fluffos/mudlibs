#include <ansi.h>
inherit __DIR__ "ShanjiaNpc.lpc";

void create() {
  set_name("单仲山", ({ "shan zhongshan", "shan", "zhongshan", "shanzhongshan", }));
  set("class_score/单家", 400);
  set("title", WHT "泰山五虎" NOR);
  create_family("单家", 2, "弟子");
  set("combat_exp", 160000);
  set("social_exp", 160000);
  set("positive_score", 1700);
  set("max_force", 1000);
  set("force", 1000);
  set("force_factor", 40);
  set("max_kee", 450);
  set("max_sen", 450);
  set("kee", 450);
  set("sen", 450);
  set("age", 32);
  set("int", 27);
  set("long", @LONG
    这是单家泰山五虎的老二，也就是单正的次子，对「铁面判官」单正的真传
已经略窥门径。
LONG
  );

  set_wugong("wuhu-dao", 110, 110, 1);
  /*
    set_wugong("yingzhua-shou",     100, 100, 1);
    set_wugong("blade",             120, 120, 0);
    set_wugong("baidu-dao",          80,  80, 1);
    set_wugong("shennong-chu",       80,  80, 1);
    set_wugong("jiben-qinggong",    120, 120, 0);
    set_wugong("lingshe-shenfa",     80,  80, 1);
    set_wugong("shaolin-xinfa",      60,  60, 1);
    set_wugong("dugong",             45,  45, 0);
*/
  set_xiuwei_by_type("unarmed", 600);
  set_xiuwei_by_type("blade", 700);
  set_xiuwei_by_type("dodge", 600);

  setup();

  carry_object(CLOTH_DIR + "mabu_kuanshan")->wear();
  carry_object(BLADE_DIR + "blade1")->wield();
  add_money("silver", 3 + random(7));
}
