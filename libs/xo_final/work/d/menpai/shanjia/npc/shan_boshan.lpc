#include <ansi.h>
inherit __DIR__"ShanjiaNpc.lpc";

void create()
{
    set_name("单伯山", ({ "shan boshan", "shan", "boshan", "shanboshan", }) );
    set("class_score/单家",       500);
    set("title", GRN"泰山五虎"NOR);
    create_family("单家", 2, "弟子");
    set("combat_exp",   300000);
    set("social_exp",   300000);
    set("positive_score", 3000);
    set("max_force",      1300);
    set("force",          1300);
    set("force_factor",     50);
    set("max_kee",         525);
    set("max_sen",         525);
    set("kee",             525);
    set("sen",             525);
    set("age",              35);
    set("int",              27);
    set("long", @LONG
    这是单家泰山五虎的老大，也就是单正的长子，已经得了「铁面判官」单正的真传。
LONG
    ); 

    set_wugong("kuaidao",            90,  90, 1);
/*
    set_wugong("yingzhua-shou",     100, 100, 1);
    set_wugong("blade",             120, 120, 0);
    set_wugong("baidu-dao",          80,  80, 1);
    set_wugong("shennong-chu",       80,  80, 1);
    set_wugong("jiben-qinggong",    120, 120, 0);
    set_wugong("lingshe-shenfa",     80,  80, 1);
    set_wugong("shaolin-xinfa",      60,  60, 1);
    set_wugong("dugong",             45,  45, 0);
*/
    set_xiuwei_by_type("unarmed",   800);
    set_xiuwei_by_type("blade",     950);
    set_xiuwei_by_type("dodge",     800);

    setup();

    carry_object( CLOTH_DIR + "mabu_kuanshan" )->wear();
    carry_object( BLADE_DIR + "blade1" )->wield();
    add_money( "silver", 5 + random(10) );
}
        