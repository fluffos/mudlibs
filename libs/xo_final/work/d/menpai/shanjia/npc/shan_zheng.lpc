#include <ansi.h>
inherit __DIR__ "ShanjiaNpc.lpc";
inherit F_MASTER;

void create() {
  set_name("单正", ({ "shan zheng", "shan", "shanzheng", }));
  set("class_score/单家", 1000);
  set("title", "单家庄庄主");
  set("nickname", RED "铁面判官" NOR);
  create_family("单家", 1, "庄主");
  set("combat_exp", 36000000);
  set("social_exp", 36000000);
  set("positive_score", 36000);
  set("max_force", 3600);
  set("force", 3600);
  set("force_factor", 120);
  set("max_kee", 1100);
  set("max_sen", 1100);
  set("kee", 1100);
  set("sen", 1100);
  set("age", 58);
  set("int", 30);
  set("rank_info/respect", "单老英雄");
  set("long", @LONG
LONG
  );

  set_wugong("fenglei-dao", 180, 180, 1);
  /*
    set_wugong("yingzhua-shou",     120, 120, 0);
    set_wugong("pikong-zhang",      100, 100, 1);
    set_wugong("blade",             150, 150, 0);
    set_wugong("baidu-dao",         100, 100, 0);
    set_wugong("panshe-dao",         80,  80, 1);
    set_wugong("hammer",            150, 150, 0);
    set_wugong("shennong-chu",      100, 100, 0);
    set_wugong("baicao-chu",         80,  80, 1);
    set_wugong("jiben-qinggong",    150, 150, 0);
    set_wugong("lingshe-shenfa",    100, 100, 0);
    set_wugong("jumang-shenfa",      80,  80, 1);
    set_wugong("shaolin-xinfa",      80,  80, 1);
    set_wugong("dugong",             60,  60, 0);

*/
  set_xiuwei_by_type("unarmed", 1700);
  set_xiuwei_by_type("blade", 2200);
  set_xiuwei_by_type("dodge", 1500);

  setup();

  carry_object(CLOTH_DIR + "cloth5")->wear();
  carry_object(BLADE_DIR + "blade1")->wield();
  add_money("gold", 2 + random(5));
}

void attempt_apprentice(object ppl) {
  object npc = this_object();

  if (ppl->query("positive_score") < ppl->query("negative_score")
    && ppl->query("negative_score") > 1000) {
    command("say “哼！你们这些邪魔外道难道没有听说过「铁面判官」么！”");
    return;
  }
  if (ppl->query("str") < 15
    || ppl->query("dex") < 15) {
    command("say “只有力大灵活的人才适合练我家的刚猛刀法，"
      +RANK_D->query_respect(ppl) + "看起来似乎不适合，不如另投明师。”");
    return;
  }
  if (ppl->query("class_score/单家") < 0) {
    message_vision("$N看了看$n，脸上流露出不信任的神色，摇了摇头。\n",
      npc, ppl);
    ppl->delete_temp("pending");
    return;
  }
  command("say “好，既然如此，我就收你为徒，你可要牢记除恶扬善的道理！”");
  command("recruit " + ppl->query("id"));
}

void init() {
  object ppl = this_player();
  object npc = this_object();

  add_action("give_quest", "quest");
  if (!userp(ppl)
    || !npc->can_act())
    return;
  call_out("Greeting", 1, ppl, npc);
}

void Greeting(object ppl, object npc) {
  if (!present(ppl, environment()))
    return;
  if ((ppl->query("positive_score") > ppl->query("negative_score")
    || ppl->query("negative_score") < 1000)
    && ppl->query("family/family_name") != "单家") {
    message_vision("$N向$n一拱手，道：“这位" + RANK_D->query_respect(ppl)
      + "光临敝庄，有何赐教呢？”\n", npc, ppl);
    return;
  }
  if (ppl->query("family/family_name") == "单家") {
    message_vision("$N勃然大怒，喝道：“" + ppl->query("name") +
      "，你这不成器的东西！居然结交匪类，鱼肉乡里～～”\n", npc);
    if (random(36) < ppl->query_kar()
      && !ppl->query_marks("marks/shanjia/Expell")) {
      ppl->set_marks("marks/shanjia/Expell", 1);
      ppl->add("class_score/单家", -ppl->query("negative_score") / 4);
      ppl->delete("negative_score");
      message_vision(GRN "$N看看$n，想了一想道：“哼！本来是应该将你逐出门墙，\n" +
        "今念你是初犯，就姑且饶了你。如果有下次，绝不轻饶！”\n" NOR, npc, ppl);
      tell_object(ppl, WHT "你的师门忠诚度下降了！\n");
      return;
    }
    message_vision(YEL "$N对着$n一挥袖子，道：“你如今做出这江湖之上人人痛恨之事，\n" +
      "本门不能再容你这武林败类。你我师徒今日恩断义绝，你走吧！”\n" NOR, npc, ppl);
    ppl->delete_marks("marks/shanjia/Expell");
    ppl->delete("family");
    ppl->set("class_score/单家", -1);
    ppl->delete("negative_score");
    ppl->set_xiuwei_by_type("blade", ppl->query_xiuwei_by_type("blade") * 2 / 3);
    ppl->set_xiuwei_by_type("unarmed", ppl->query_xiuwei_by_type("unarmed") * 3 / 5);
    ppl->set_xiuwei_by_type("dodge", ppl->query_xiuwei_by_type("dodge") * 3 / 5);
    ppl->set("title", "单家弃徒");
    tell_object(ppl, RED "你被师傅开革出师门了！！！\n" NOR);
    tell_object(ppl, WHT "你的刀法修为下降了！\n" NOR);
    tell_object(ppl, WHT "你的轻功修为下降了！\n" NOR);
    tell_object(ppl, WHT "你的拳脚修为下降了！\n" NOR);
    return;
  }
  command("say “胆大的妖魔小丑！居然跑到这里来撒野！”");
  kill_ob(ppl);
  ppl->fight_ob(npc);
}
