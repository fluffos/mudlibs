#include <ansi.h>
inherit __DIR__ "ShanjiaNpc.lpc";

void create() {
  set_name("单小山", ({ "shan xiaoshan", "shan", "xiaoshan", "shanxiaoshan", }));
  set("class_score/单家", 100);
  set("title", YEL "泰山五虎" NOR);
  create_family("单家", 2, "弟子");
  set("combat_exp", 22000);
  set("social_exp", 22000);
  set("positive_score", 220);
  set("max_force", 160);
  set("force", 160);
  set("force_factor", 20);
  set("max_kee", 240);
  set("max_sen", 240);
  set("kee", 240);
  set("sen", 240);
  set("age", 21);
  set("int", 27);
  set("long", @LONG
    这是单家泰山五虎的老五，也就是单正的小儿子，对单家的功夫还只有些比
较粗浅的领悟。
LONG
  );

  set_wugong("ditang-dao", 60, 60, 1);
  /*
    set_wugong("yingzhua-shou",     100, 100, 1);
    set_wugong("blade",             120, 120, 0);
    set_wugong("baidu-dao",          80,  80, 1);
    set_wugong("shennong-chu",       80,  80, 1);
    set_wugong("jiben-qinggong",    120, 120, 0);
    set_wugong("lingshe-shenfa",     80,  80, 1);
    set_wugong("shaolin-xinfa",      60,  60, 1);
    set_wugong("dugong",             45,  45, 0);
*/
  set_xiuwei_by_type("unarmed", 100);
  set_xiuwei_by_type("blade", 220);
  set_xiuwei_by_type("dodge", 100);

  setup();

  carry_object(CLOTH_DIR + "mabu_kuanshan")->wear();
  carry_object(BLADE_DIR + "blade1")->wield();
  add_money("silver", 1 + random(2));
}
