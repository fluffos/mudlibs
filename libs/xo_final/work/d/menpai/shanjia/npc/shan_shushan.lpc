#include <ansi.h>
inherit __DIR__"ShanjiaNpc.lpc";

void create()
{
    set_name("单叔山", ({ "shan shushan", "shan", "shushan", "shanshushan", }) );
    set("class_score/单家",       300);
    set("title", RED"泰山五虎"NOR);
    create_family("单家", 2, "弟子");
    set("combat_exp",    60000);
    set("social_exp",    60000);
    set("positive_score",  600);
    set("max_force",       600);
    set("force",           600);
    set("force_factor",     30);
    set("max_kee",         350);
    set("max_sen",         350);
    set("kee",             350);
    set("sen",             350);
    set("age",              26);
    set("int",              27);
    set("long", @LONG
    这是单家泰山五虎的老三，也就是单正的三子，对「铁面判官」单正的真传
已经刚刚初有所悟。
LONG
    ); 

    set_wugong("wuhu-dao",           60,  60, 1);
/*
    set_wugong("yingzhua-shou",     100, 100, 1);
    set_wugong("blade",             120, 120, 0);
    set_wugong("baidu-dao",          80,  80, 1);
    set_wugong("shennong-chu",       80,  80, 1);
    set_wugong("jiben-qinggong",    120, 120, 0);
    set_wugong("lingshe-shenfa",     80,  80, 1);
    set_wugong("shaolin-xinfa",      60,  60, 1);
    set_wugong("dugong",             45,  45, 0);
*/
    set_xiuwei_by_type("unarmed",   300);
    set_xiuwei_by_type("blade",     450);
    set_xiuwei_by_type("dodge",     300);

    setup();

    carry_object( CLOTH_DIR + "mabu_kuanshan" )->wear();
    carry_object( BLADE_DIR + "blade1" )->wield();
    add_money( "silver", 1 + random(5) );
}
        