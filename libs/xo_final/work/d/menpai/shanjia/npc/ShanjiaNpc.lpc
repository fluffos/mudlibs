// 单家的ＮＰＣ标准文件  /d/menpai/shanjia/npc/ShanjiaNpc.c
// by lala, 1998-02-13

inherit NPC;

void Greeting( object ppl );

void setup()
{
    mapping my = this_object()->query_entire_dbase();
                                                                                                     
    if( !my["gender"]         ) set("gender",           "男性" );
    if( !my["age"]            ) set("age",     18 + random(50) );
    if( !my["attitude"]       ) set("attitude",     "peaceful" );
                                
    if( !my["max_force"]      ) set("max_force",            100);
    if( !my["force"]          ) set("force",                100);
    if( !my["force_factor"]   ) set("force_factor",           5);
    if( !my["max_kee"]        ) set("max_kee",              225);
    if( !my["max_sen"]        ) set("max_sen",              225);
    if( !my["kee"]            ) set("kee",                  225);
    if( !my["sen"]            ) set("sen",                  225);
                                    
    if( !my["combat_exp"]     ) set("combat_exp",         10000);
    if( !my["social_exp"]     ) set("social_exp",         15000);
    if( !my["positive_score"] ) set("positive_score",       100);

    if( !my["inquiry"]        )
        set("inquiry",  ([
            "here"      :   "这里就是山东泰安单家庄。",
            "rumors"    :   "泰安单家在江湖上素以侠义闻名。",    
        ]) );

    if( !my["talk_msg"]       )
        set("talk_msg", ({
            "“单家的主要功夫是刀法，比较讲究臂力。”",
            "“学武之人一定要讲究武德。”",
            "“我们单家的弟子一向是嫉恶如仇，如果本门弟子有作奸犯科的事情是不会轻饶的。”",
            "“所谓路见不平，拔刀相助，江湖上要见义勇为。”",
        }) );  
    if( !my["family"]         )
        set("family",   ([
            "family_name"   :   "单家",
            "master_name"   :   "单正",
            "master_id"     :   "shan zheng",
            "generation"    :   2,
            "title"         :   "弟子",
        ]) );
    ::setup();
}

void init()
{
    ::init();
    if( this_player()->query("negative_score") > this_player()->query("positive_score")
     && this_player()->query("negative_score") > 1000 )
        call_out("Greeting", 1, this_player());
}

void Greeting( object ppl )
{
    if( !present( ppl, environment() )
    ||  !userp(ppl) )
        return;
    message_vision( "$N对着$n勃然大怒，喝道：“奸邪鼠辈，今日是你恶贯满盈之时！”\n",
        this_object(), ppl );
    kill_ob(ppl);
    ppl->fight_ob(this_object());
}


void attempt_apprentice( object ppl )
{
    command( "say “你还是去拜庄主「铁面判官」他老人家吧！”" );
    return;
}

            