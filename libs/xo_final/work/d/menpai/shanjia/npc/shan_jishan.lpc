#include <ansi.h>
inherit __DIR__ "ShanjiaNpc.lpc";

void create() {
  set_name("单季山", ({ "shan jishan", "shan", "jishan", "shanjishan", }));
  set("class_score/单家", 200);
  set("title", BLU "泰山五虎" NOR);
  create_family("单家", 2, "弟子");
  set("combat_exp", 30000);
  set("social_exp", 30000);
  set("positive_score", 360);
  set("max_force", 360);
  set("force", 360);
  set("force_factor", 30);
  set("max_kee", 290);
  set("max_sen", 290);
  set("kee", 290);
  set("sen", 290);
  set("age", 24);
  set("int", 27);
  set("long", @LONG
    这是单家泰山五虎的老四，也就是单正的四子，对单家的功夫还只有些比较
粗浅的领悟。
LONG
  );

  set_wugong("ditang-dao", 80, 80, 1);
  /*
    set_wugong("yingzhua-shou",     100, 100, 1);
    set_wugong("blade",             120, 120, 0);
    set_wugong("baidu-dao",          80,  80, 1);
    set_wugong("shennong-chu",       80,  80, 1);
    set_wugong("jiben-qinggong",    120, 120, 0);
    set_wugong("lingshe-shenfa",     80,  80, 1);
    set_wugong("shaolin-xinfa",      60,  60, 1);
    set_wugong("dugong",             45,  45, 0);
*/
  set_xiuwei_by_type("unarmed", 200);
  set_xiuwei_by_type("blade", 320);
  set_xiuwei_by_type("dodge", 200);

  setup();

  carry_object(CLOTH_DIR + "mabu_kuanshan")->wear();
  carry_object(BLADE_DIR + "blade1")->wield();
  add_money("silver", 1 + random(3));
}
