inherit ROOM;

void create() {
  set("short", "泰安南街");
  set("long", @LONG
泰安的南街从南门直通向岱庙。一进南门就能看见岱庙的屋顶，每年都有许
多的游客到泰山来登山游玩，因而这南街的两旁是些饭铺和客栈聚集的地方，一
根竹竿上挑着个酒幌从路旁的小店口伸出，告诉你这是个什么所在。
LONG
  );
  set("outdoors", "taian");
  set("exits", ([
    "north": __DIR__ "guangchang",
    "south": __DIR__ "nanmen",
    "west": __DIR__ "jiuguan",
  ]));
  setup();
}
