inherit ROOM;

void create() {
  set("short", "泰安东门");
  set("long", @LONG
泰安东城门建在泰山之麓，依托着大山，倒也显得有些气势。一条土路从这
里向东面延伸过去，远远望去，可以看见几里外有个小小的村庄，其中有所宅院
甚是整齐，想来是家大户人家。
LONG
  );
  set("outdoors", "taian");
  set("exits", ([
    "east": __DIR__ "xiaolu",
    "west": __DIR__ "dongjie",
  ]));
  setup();
}
