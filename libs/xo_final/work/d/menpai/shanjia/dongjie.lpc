inherit ROOM;

void create() {
  set("short", "泰安东街");
  set("long", @LONG
泰安城的东街通向城东门，街南是家杂货铺，卖些供游客上山游玩的手杖、
麻鞋、水壶之类的东西，也有一点日用品，不过种类很少。街北是家当铺，但是
由于城太小，所以生意并不好。西北方就是泰山脚下了，从那里就游人就可以上
山。
LONG
  );
  set("outdoors", "taian");
  set("exits", ([
    "north": __DIR__ "dangpu",
    //"south"     :   __DIR__"zahuopu",
    "east": __DIR__ "dongmen",
    //"northwest" :   __DIR__"taishan_jiaoxia",
    "west": __DIR__ "guangchang",
  ]));
  setup();
}
