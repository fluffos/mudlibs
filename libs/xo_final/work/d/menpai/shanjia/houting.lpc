inherit ROOM;

void create()
{
    set("short",    "后厅");
    set("long",     @LONG
LONG
    );
    set("need_clean",   "单家");
    set("exits",    ([
        "north"     :   __DIR__"houyuan",
        "south"     :   __DIR__"zhengting",
        "southwest" :   __DIR__"xixiang",
        "southeast" :   __DIR__"dongxiang",
    ])  );
    set("objects",  ([
        __DIR__"npc/shan_jishan":   1,
    ])  );
    setup();
}
