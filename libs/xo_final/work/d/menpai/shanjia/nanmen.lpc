inherit ROOM;

void create()
{
    set("short",    "泰安南门");
    set("long",     @LONG
这里是泰安城的南门。从这里一直向南走，可以过淮河到达淮南。泰安是个
不大的小城，城墙显得灰暗而没有生气，城门口连一个守兵也没有，倒是有一两
只老母鸡在四处找东西吃。
LONG
    );
    set("outdoors", "taian"); 
    set("exits",    ([
        "north"     :   __DIR__"nanjie",
    ])  );
    setup();
}
