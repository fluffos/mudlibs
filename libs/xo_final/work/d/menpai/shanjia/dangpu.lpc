inherit HOCKSHOP;

void create() {
  set("short", "泰安当铺");
  set("long", @LONG
当铺的店面并不大，颇为陈旧的黑漆大柜台已经有不少的地方露出了木头，
墙角也有不少的灰尘，一切都显得那么没有生气。一个上了年纪的活计躲在柜台
后面打着瞌睡，一只懒洋洋的老猫则趴在他脚边的阳光里打着呼噜。
LONG
  );
  set("dangpu_location", "taian");
  set("exits", ([
    "south": __DIR__ "dongjie",
  ]));
  setup();
}
