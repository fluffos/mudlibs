#include <room.h>

inherit ROOM;

void create() {
  set("short", "剑湖畔");
  set("long", @LONG
只见湖畔生着一丛丛茶花，湖面上时有微风送来，吹得花儿轻轻摆动，摇曳
生姿，云南茶花本有“甲天下”之称，这里的茶花虽是生在野外，不曾经人精心
栽培，但气侯湿暖，极是适宜茶花生长，所以倒还长得不错，边上尽是悬崖峭壁
，崖边有些小树丛，上面长满了青红色的野果。树丛后光秃秃的一大片石壁(shi
bi)，上面爬满了蔓藤。
LONG
  );
  set("exits", ([
    "southeast": __DIR__ "gudi",
    "north": __DIR__ "hupan2",
  ]));
  set("item_desc", ([ "shibi":
    "这石壁非常光滑，宛然似一面铜镜，上面爬了许多蔓藤，看起来\n"
    "似乎并没有什么特殊之处。\n", ]));
  set("outdoors", "wuliang");
  setup();
}
