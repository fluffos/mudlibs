inherit ROOM;

void create()
{
    set("short","岔道");
    set("long",@LONG
你走在一条狭窄的山路上，两边都是高高的岩石，被露水打的湿漉漉的，几
株小草在岩缝里倔强的生长着。脚下是很多碎石，走起来磕磕拌拌的，很不舒服
。小路一直向西渐渐升高，东面是剑湖宫的正门。
LONG
);

    set("exits",([
        "eastup"   : __DIR__"xiao_shanpo",
        "west" : __DIR__"chadao1",
    ]));
    set("outdoors","wuliang");

    set("objects", ([
        __DIR__"npc/shang_yuqing": 1 ,
        __DIR__"npc/qu_lianxing": 1,
    ]) ); 
    setup();
}

int welcome_visitor( object who )
{
    if( random(5) > 2 )
    {
        tell_object( who, "一阵山风吹来，你不由得打了个寒战。\n");
        return 1;
    }
    return 0;
}

