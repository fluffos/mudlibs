#include <room.h>

inherit ROOM;

void create() {
  set("short", "洞口");
  set("long", @LONG
进得洞来，四周黑乎乎一片，没有丝毫光亮，脚下道路倒还平整，便似走在
石板路上一般，想来定是经过人工修整，这洞看来曾有人居住过，脚下道路一直
向东延伸，不住向下倾斜，越来越低，也不知通向何方。
LONG
  );

  set("exits", ([
    "eastdown": __DIR__ "tongmen",
  ]));
  setup();
  //place_program( ROOM );
