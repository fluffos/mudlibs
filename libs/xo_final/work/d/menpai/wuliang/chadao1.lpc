inherit ROOM;

void create() {
  set("short", "岔道");
  set("long", @LONG
你走在一条狭窄的山路上，两边都是高高的岩石，被露水打的湿漉漉的，几
株小草在岩缝里倔强的生长着。脚下是很多碎石，走起来磕磕拌拌的，很不舒服
。小路一直向西渐渐升高，东面是剑湖宫的正门。
LONG
  );

  set("exits", ([
    "east": __DIR__ "chadao2",
    "west": __DIR__ "shidao",
  ]));
  setup();
  set("outdoors", "wuliang");
  //place_program(ROOM);
}
