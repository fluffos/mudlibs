#include <room.h>
inherit DOOR_ROOM;

void create() {
  set("short", "屋后");
  set("long", @LONG
这里是屋后的一片空地，四处杂草丛生，墙角胡乱堆放着一些杂物，往西是
囚房，一条黄泥路通向南边的小木屋，向北则是一道山门。从那里可到后山。
LONG);
  set("status_lock", 1);

  set("objects", ([
    __DIR__ "npc/yu_gbiao": 1,
    __DIR__ "npc/wu_gsh": 1, ]));
  set("exits",
    ([
      "west": __DIR__ "qiushi",
      "north": __DIR__ "shanmen",
      "south": __DIR__ "muwu", ]));

  create_door("west", "铁门", "east", DOOR_CLOSED);
  setup();
}

void init() {
  add_action("do_open", "open");
}

int do_open(string arg) {
  object room;

  //room = this_object();
  room = environment(this_player());
  if (!objectp(room) || !arg || arg != "door") return 0;

  if (arg == "door") {
    if (!room->query("status_lock")) return 0;
    tell_object(this_player(), "门被一把大铁锁锁住了。\n");
    return 1;
    //    if ( room->query("status_lock") )
    //        return notify_fail("门被一把大铁锁锁住了。\n");
    //    else
    //              return 0;
  }
  return 0;
}
