// room:/d/wuliang/shanjiao.c
#include <room.h>
inherit ROAD;

void create() {
  set("short", "无量山脚");
  set("long", @LONG
这里地处群山环抱之中，河水潺潺，绿草依依；阳光明媚，空气清新。四面
山岩耸立，溪水自崖缝中涓涓而下，一团团雾气在山腰浮动。半空中不时有毛色
绚烂的山雀飞过，留下'唧唧喳喳'的叫声回荡在耳边。北面一座大山，高耸入云，
一条山道弯弯曲曲隐进山里。
LONG
  );
  set("exits", ([
    "northup": __DIR__ "shanlu1",
    "northwest": "/d/map/xinan/jiangbian",
  ]));

  set("objects", ([
    __DIR__ "obj/shibei1": 1
  ]));

  setup();
  set("outdoors", "wuliang");
}
