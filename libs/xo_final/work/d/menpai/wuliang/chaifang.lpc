inherit ROOM;
string look_sign(object me);

void create() {
  set("short", "柴房");
  set("long", @LONG
这里用来存放厨房里生火用的柴禾。一捆捆干树枝堆在南墙角，足有一人高；
这里的柴大部分都是派中弟子们自己在山上砍伐的，偶尔从卖柴的人那里买些。
只因后山是无量派禁地，严禁擅入，很多砍柴的害怕，便跟本不上山来。北边是
厨房，一股股油烟味不时飘过来。
LONG);

  set("item_desc", ([
    "shuzhi": (: look_sign :),
    "chai": (: look_sign :),
    "柴": (: look_sign :),
    "south": (: look_sign :),
  ]));
  set("exits", ([
    "northwest": __DIR__ "chufang",
  ]));
  setup();
}

string look_sign(object me) {
  return "一大堆树枝堆在南墙前，足有一人高。\n";
}

void init() {
  add_action("do_che", "zuan");
}

int do_che(string arg) {
  object me;
  me = this_player();

  if (arg == "chaidui") {
    message_vision(
      "$N拨开散在表面的树枝，钻进柴堆里，发现墙角有而洞。\n"
      "$N从墙角的洞中钻了出去。\n", me,);
    me->move(__DIR__ "xiao_shanpo");
    return 1;
  } else {
    write("你要钻什么？\n");
    return 1;
  }
}
