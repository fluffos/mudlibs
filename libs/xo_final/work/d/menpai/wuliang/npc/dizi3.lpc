inherit NPC;

void create()
{
    set_name("练功弟子", ({ "liangong dizi","dizi" }) );
    set("gender", "男性" );
    set("age",15);

    set_wugong("jiben-qinggong",50);
    set_xiuwei("dodge",150);
    set_wugong("unarmed",40);
    set_xiuwei_by_type("unarmed",90);

    set("combat_exp",100);
    set("social_exp",100);
    setup();
    carry_object(__DIR__"obj/cloth")->wear();
}

