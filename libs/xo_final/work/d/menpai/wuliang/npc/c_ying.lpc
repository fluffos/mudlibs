{
    set_name("苍蝇", ({ "cang ying" ,"ying"}) );
    set("race", "野兽");
    set("age", 1);
    set("long", "一只绿头金翅大苍蝇.\n");

    set("limbs", ({ "头部", "身体", "翅膀" }) );
