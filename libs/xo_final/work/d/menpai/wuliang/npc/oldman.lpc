inherit NPC;

void create()
{
    set_name("老者",({"old man","man"}));
    set("long","一名精神攫烁的老人正坐在亭子里休息.\n");
    set("gender","男性");
    set("age",70);
    set("attitude","peaceful");
    set("str",30);
    set("per",25);
    set("combat_exp",1000000);
    set("social_exp",100000);

    set_wugong("unarmed",100,100,1);
    set_wugong("nanshan-liushi",200,200,1);
    set_xiuwei("unarmed",2000);
    set_xiuwei("dodge",2000);

    setup();
}

