#include <ansi.h>

inherit NPC;

void create() {
  set_name("巡山弟子", ({ "xunshan dizi", "dizi" }));
  set("gender", "男性");
  set("age", 25);
  set("str", 35);
  set("int", 15);
  set("long", "巡山弟子用锐利的眼光到处扫视着。\n");
  set("combat_exp", 6000);
  set("attitude", "herosim");

  set("force", 200);
  set("max_force", 200);
  set("force_factor", 1);
  set("kee", 200);
  set("max_kee", 200);
  set("no_get", 1);

  set_wugong("unarmed", 70);
  set_wugong("sword", 80);
  set_xiuwei("dodge", 800);
  set_xiuwei("unarmed", 600);
  set_xiuwei("sword", 600);

  setup();
  carry_object(__DIR__ "obj/cloth")->wear();
  carry_object(__DIR__ "obj/changjian")->wield();
  add_money("coin", 30);
}

void init() {
  object ob;

  ::init();

  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 3, ob);
  }
}

void greeting(object ob) {
  if (!ob || !present(ob, environment(this_object())) || is_fighting()) {
    return;
  }

  call_out("do_kill", 10, ob);
  say(HBBLU "巡山弟子一拱手：“这位"
    +RANK_D->query_respect(ob) + "，请速速下山，\n"
    "此地乃本门禁地，还望原谅。”\n" NOR);
}

void do_kill(object ob) {
  if (!ob || !present(ob, environment(this_object()))) {
    return;
  }

  say(YEL "巡山弟子眉头一皱：“敬酒不吃吃罚酒，看来你是想让我们\n"
    "动手了，出招吧！”\n" NOR);
  ob->delete_temp("status_waiting");
  kill_ob(ob);
  ob->fight_ob(this_object());
}
