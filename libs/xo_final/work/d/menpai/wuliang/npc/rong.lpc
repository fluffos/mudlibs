#include <ansi.h>

inherit F_NEW_MASTER;

#include "east_master.h"

void create()
{
    set_name("容子矩", ({ "rong ziju", "rong" }) );
    create_family("无量剑派东宗",5,"弟子");
    set("class","wuliang_east");
    set("gender", "男性" );
    set("age", 50);
    set("str", 25);
    set("int", 30);
    set("per",24);
    set("long","容子矩为人极为精明,办事干练,无量派上上下下的事都要经他的手.\n");
    set("combat_exp", 10000);
    set("social_exp", 10000);
    set("class_score", 1000);
    set("positive_score",9000);
    set("attitude", "heroism");

    set_wugong( "wuliang-xinfa", 200, 200, 1 );

    set_wugong( "unarmed", 200, 200, 0 );
    set_wugong( "taizu-quan", 200, 200, 0 );
    set_wugong( "nanshan-liushi", 200, 200, 1 );

    set_wugong( "sword", 200, 200, 0 );
    set_wugong( "wuliang-jian", 200, 200, 0 );
    set_wugong( "liuyun-jian", 200, 200, 1);

    set_wugong( "jiben-qinggong", 200, 200, 0 );
    set_wugong( "wuliang-shenfa", 200, 200, 0 );
    set_wugong( "yanxing", 200, 200, 1 );

    set_xiuwei_level_by_type("unarmed", 4);
    set_xiuwei_level_by_type("sword", 4);
    set_xiuwei_level_by_type("dodge", 4);
    set_xiuwei_level_by_type("force", 4);
    set_xiuwei_level_by_type("zonggang", 4);

    ::create();

    setup();
    carry_object(__DIR__"obj/cloth")->wear();
    carry_object(__DIR__"obj/xuanquan")->wield();
    add_money("coin",10);
}

void init()
{
    object ob;

    ::init();

    if ( interactive(ob = this_player()) && !is_fighting() && ob->query("family/family_name") == "无量剑派东宗" )
    {
        remove_call_out("greeting");
        call_out("greeting", 1, ob);
    }
}

int accept_apprentice(object who)
{
    if ( who->query("family/family_name") == "无量剑派东宗" )
    {
        if ( (int)who->query("class_score/无量剑派东宗") > 10 )
        {
            return 1;
        }

        command("say 你还是现为师门做点事吧。\n");
        return 0;
    }

    return can_apprentice(who);
}

void greeting(object ob)
{
     if ( !ob || environment(ob) != environment(this_object()) )
    {
        return;
    }

    say("容子矩笑眯眯地说:过来一块练练吧!\n"NOR);
}

