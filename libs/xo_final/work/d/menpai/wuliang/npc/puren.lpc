inherit NPC;

void create()
{
    set_name("仆人", ({ "pu ren" }) );
    set("gender", "男性" );
    set("age", 53);
    set("long", "一位满脸风霜的老仆人。\n");
    set("combat_exp", 700);
    set("social_exp", 4000);
    set("attitude", "peaceful");

    set_wugong("unarmed", 50);
    set_wugong("jiben-qinggong", 35);
    set_xiuwei("dodge", 300);
    set_xiuwei("unarmed",300);
	
    setup();
    add_money("coin", 10);
    carry_object(__DIR__"obj/cloth")->wear();
}

