inherit F_NEW_MASTER;

#include "east_master.h"

void create() {
  set_name("曲连兴", ({ "qu lianxing", "qu" }));
  create_family("无量剑派东宗", 6, "弟子");
  set("class", "wuliang_east");
  set("gender", "男性");
  set("age", 25);

  set_wugong("wuliang-xinfa", 150, 150, 1);

  set_wugong("unarmed", 150, 150, 0);
  set_wugong("taizu-quan", 150, 150, 0);
  set_wugong("nanshan-liushi", 150, 150, 1);

  set_wugong("sword", 150, 150, 0);
  set_wugong("wuliang-jian", 150, 150, 1);

  set_wugong("jiben-qinggong", 150, 150, 0);
  set_wugong("wuliang-shenfa", 150, 150, 0);

  set_xiuwei_level_by_type("unarmed", 3);
  set_xiuwei_level_by_type("sword", 3);
  set_xiuwei_level_by_type("dodge", 3);
  set_xiuwei_level_by_type("force", 3);
  set_xiuwei_level_by_type("zonggang", 3);

  set("combat_exp", 20000);

  ::create();

  setup();
  carry_object(__DIR__ "obj/cloth")->wear();
}

void init() {
  ::init();
  add_action("do_leave", "go");
}

int accept_apprentice(object me) {
  return can_apprentice(me);
}

int do_leave(string arg) {
  if (arg == "eastup") {
    message_vision("曲连兴拦住了$N，说：'后山是本派重地，你请回吧。'\n",
      this_player());
    return 1;
  }
}
