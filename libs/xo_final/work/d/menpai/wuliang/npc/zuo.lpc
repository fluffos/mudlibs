inherit F_NEW_MASTER;

#include <ansi.h>
#include "east_master.h"

int time_period(int timep, object me);
string change_master(object who);
string master_name(object me);
int recruit_apprentice(object me);
string about_yubi(object me);
string leave_east(object);
void get_sword(object);
void back_dating();

void create() {
  seteuid(getuid());
  set_name("左子穆", ({ "zuo zimu", "zuo", "zimu" }));
  set("gender", "男性");
  set("age", 50);
  set("str", 30);
  set("cor", 30);
  set("cps", 30);
  set("int", 25);
  set("ker", 24);
  set("kar", 30);
  set("positive_score", 10000);

  set("rank_info/respect", "左先生");
  set("class", "wuliang_east");

  set("long", "左子穆身材极为高大，目光犀利，但也儒雅有礼，显然曾读过不少书。\n");

  create_family("无量剑派东宗", 5, "掌门人");

  set("combat_exp", 500000);
  set("social_exp", 20000);

  set_wugong("wuliang-xinfa", 300, 300, 1);

  set_wugong("unarmed", 300, 300, 0);
  set_wugong("taizu-quan", 300, 300, 0);
  set_wugong("nanshan-liushi", 300, 300, 0);
  set_wugong("lingxiao-shou", 300, 300, 1);

  set_wugong("sword", 300, 300, 0);
  set_wugong("wuliang-jian", 300, 300, 0);
  set_wugong("liuyun-jian", 300, 300, 1);

  set_wugong("jiben-qinggong", 300, 300, 0);
  set_wugong("wuliang-shenfa", 300, 300, 0);
  set_wugong("yanxing", 300, 300, 1);

  set_xiuwei_level_by_type("unarmed", 5);
  set_xiuwei_level_by_type("sword", 5);
  set_xiuwei_level_by_type("dodge", 5);
  set_xiuwei_level_by_type("force", 5);
  set_xiuwei_level_by_type("zonggang", 5);

  set("inquiry", ([
    "此地": "这里便是无量剑派。",
    "姓名": "嗯，你既知我姓左，怎会不知在下便是无量东宗掌门人左子穆？,
        " 玉 壁 ": (: about_yubi :),
        " 指 点 武 功 " : (: change_master :),
    ]) );

    ::create();

    setup();
    carry_object(__DIR__" obj / xuanquan ")->wield();
}

void init()
{
    object this, env, me;

    ::init();
    add_action(" do_kneel ", ({ " kneel ", " ketou " }) );

    this = this_object();
    env = environment( this );
    me = this_player();

    if ( !objectp(env) )
    {
        return;
    }

    if (( env->query( " short " ) == " 侧 厅 " ) &&
        ( this->query_temp( " bai_zuo " ) == me->query( " id " ) ))
    {
        remove_call_out( " tell_mengui " );
        call_out( " tell_mengui ", 1, me );
    }
}

// 这儿我希望实现的是当 ppl 拜了 zuo 以后, zuo 走去侧厅等待 ppl 完成拜师
// 仪式. 可能出现的意外情况是 ppl 不过去, 这种情况 zuo 会记住谁放了他鸽
// 子, 在这次 MUD 运行中就拒收这个 ppl.
int accept_apprentice(object me)
{
    object this, env;
    string my_id;
    object sword;

    my_id = me->query( " id " );
    this = this_object();
    env = environment( this );

    if ( can_apprentice(me) )
    {
        return 1;
    }

    if ( 2 == me->query_temp(" bai_zuo ") )
    {
        sword = new(__DIR__" obj / sword ");
        sword->move( me );
        sword->set(" long "," 一 把 无 量 剑 派 本 门 使 用 的 长 剑 ， 剑 上 刻 着 " + HIY " 无 量 剑 " +
            me->query(" name ") + NOR" \ n ");
        me->delete_temp( " bai_zuo " );
        this->delete_temp( " bai_zuo " );
        this->delete_temp( " bai_list / " + me->query(" id ") );
        message_vision(" 左 掌 门 将 一 把 刻 着 $N 名 字 的 长 剑 交 给 了 $N ， 说 ： 这 把 剑 就 归 你 "
                   " 随 身 携 带 使 用 。 \ n 记 住 ， 剑 在 人 在 ， 剑 亡 人 亡 ！ \ n ", me);

        me->set( " wuliang / master ", " shang yuqing " );
        tell_object(me, " 从 今 天 起 ， 你 就 去 跟 商 余 庆 师 兄 学 习 本 门 基 本 武 功 吧 。 \ n ");

        me->save();
        call_out(" back_dating ", 5);

        return 0;
    }

    if ( this->query_temp( " bai_list / " + my_id ) )
    {
        command( " heng " + my_id );
        message_vision(" 左 子 穆 冷 冷 地 对 $N 说 ： 你 品 性 不 正 ， 不 配 入 我 门 。 \ n ", me);
        return 0;
    }

    command( " nod " + my_id );
    this->set_temp( " bai_zuo ", my_id );
    this->set_temp( " bai_list / " + my_id, 1 );
    call_out( " back_dating ", 60 );
    message_vision(" 左 子 穆 对 $N 说 ： 既 然 这 样 ， 先 随 我 去 拜 过 了 祖 师 。 \ n ", me);
    call_out(" go_cedian ", 1);

    return 0;
}

void go_cedian()
{
    remove_call_out( " go_cedian " );

    if ( environment( this_object() )->query(" short ") == " 大 厅 " )
    {
        command( " go west " );
    }
}

void back_dating()
{
    remove_call_out( " back_dating " );

    if ( environment( this_object() )->query(" short ") == " 侧 厅 " )
    {
        command( " go east " );
    }
}

void tell_mengui( object me )
{
    if ( !me || environment(me) != environment() )
    {
        back_dating();
        return;
    }

    tell_object(me, YEL@MSG
左子穆对你说: 既然入我门下，第一便是要恪守本派门规。你听好了，我无量剑派

        首戒欺师灭祖，不敬尊长；  二戒同门操戈，兄弟不和。
        三戒心猿意马，不用心练功；四戒恃强凌弱，擅伤无辜。
        五戒奸淫好色，调戏妇女；  六戒口出妄言，行事不正。

这些门规，你要记牢了，如有违反，我定严惩不殆！！
好了，给祖师爷磕头吧！
MSG NOR);
    me->set_temp( " bai_zuo ", 1 );
}

int do_kneel(string arg)
{
    object me, this;

    me = this_player();
    this = this_object();

    if ( environment( this )->query(" short ") != " 侧 厅 " )
    {
        tell_object( me, " 你 打 算 给 谁 磕 头 啊 ？ \ n " );
        return 1;
    }

    if ( 1 == me->query_temp( " bai_zuo " ) )
    {
        message_vision(" $N 对 着 墙 上 挂 着 的 祖 师 像 拜 了 八 拜 ， 站 起 身 来 。 \ n ", me);
        message_vision(" 左 子 穆 高 兴 对 $N 笑 了 笑 ， 说 ： 很 好 很 好 (apprentice zuo) 。 \ n ", me);
        me->set_temp(" bai_zuo ", 2);
        return 1;
    }

    return 0;
}

//qyz & falcon
//let player can change a master when he becomes strong...
string change_master(object who)
{
    string msg;
    object me;

    me = this_player();
    if ( me->query(" family / family_name ") != " 无 量 剑 派 东 宗 " )
    {
        return " 这 位 " + RANK_D->query_respect(me) + " 说 笑 了, 老 朽 无 德 无 能, 何 言 指 点 。 ";
    }

    if ( me->query( " marks / 悟 剑 居 " ) )
    {
        return " 你 的 武 功 已 经 不 低 于 师 父 我 了 。 ";
    }

    // 如果还没有 master, 就先指定商余庆. 不过怎么可能没有呢!!!
    if ( !me->query(" wuliang / master ") )
    {
        me->set( " wuliang / master ", " shang yuqing " );
        msg = " 从 今 天 起 ， 你 就 去 跟 商 余 庆 师 兄 学 习 本 门 基 本 武 功 吧 。 ";
    }
    else if ( me->query(" wuliang / defeat_master ") != me->query(" wuliang / master ") )
    {
        if ( !me->query_temp(" wuliang / fight_master ") )
        {
            me->set_temp(" wuliang / fight_master ", me->query(" wuliang / master "));
            printf( " 左 子 穆 沉 思 了 一 会 ... \ n " );
            msg = sprintf( " 好 ， 你 去 跟 % s 比 试 一 下 ， 再 做 决 定 吧 。 ",
                master_name(me) );
        }
        else
        {
            printf( " 左 子 穆 有 些 发 怒 。 \ n " );
            msg = sprintf( " 好 高 骛 远 ， 是 学 不 好 功 夫 的 ， 你 还 是 先 跟 % s 多 学 点 东 西 再 说 。 ",
                master_name(me));
            me->add(" class_score / 无 量 剑 派 东 宗 ", -1);
        }
    }
    else
    {
        me->delete(" wuliang / defeat_master ");
        me->delete_temp(" wuliang / fight_master ");
        switch ( me->query(" wuliang / master ") )
        {
            case " shang yuqing ":
                me->set( " wuliang / master ", " qu lianxing " );
                msg = " 好 ， 你 现 在 可 以 去 跟 曲 连 兴 师 兄 学 习 了 。 ";
                LOG_D->do_log(me, " 你 击 败 了 商 余 庆 而 获 准 向 曲 连 兴 学 习 更 高 深 的 武 功 。 ");
                break;

            case " qu lianxing ":
                me->set( " wuliang / master ", " rong ziju " );
                msg = " 嗯 ， 不 错 ， 现 在 就 让 你 容 师 叔 来 指 导 你 吧 。 ";
                LOG_D->do_log(me, " 你 击 败 了 曲 连 兴 ， 并 获 准 向 容 子 矩 请 教 更 高 深 的 武 功 。 ");
                break;

            case " rong ziju ":
                me->set( " wuliang / master ", " zuo zimu " );
                msg = " 好 徒 儿 ， 从 今 天 开 始 ， 为 师 亲 自 指 点 于 你 ！ ";
                LOG_D->do_log(me, " 在 你 击 败 容 子 矩 后 ， 左 子 穆 对 你 特 别 赏 识 ， 并 决 定 全 心 培 养 你 。 ");
                break;

            // 我认为 zuo 在这儿应该是给一个令牌什么的
            case " zuo zimu ":
                me->set(" marks / 悟 剑 居 ", 1);
                msg = " 你 武 功 已 至 如 此 境 界 ， 看 来 足 以 领 悟 悟 剑 居 中 本 派 的 武 学 精 华 。 ";
                LOG_D->do_log(me, " 你 武 功 终 于 大 成 ， 你 被 左 子 穆 获 准 去 参 修 无 量 剑 最 高 深 的 武 功 － － 石 壁 绝 学 。 ");
        }
    }

    return msg;
}

string master_name( object me )
{
    string master_id;

    master_id = me->query(" wuliang / master ");

    switch ( master_id )
    {
        case " shang yuqing " : return " 你 商 师 兄 ";
        case " qu lianxing " : return " 你 曲 师 兄 ";
        case " rong ziju " : return " 你 容 师 叔 ";
        case " zuo zimu " : return " 为 师 我 ";
        default : error( " master_name " );
    }
}

//lnwm:here is for 四川的无名老人
string about_yubi( object me )
{
    string msg;

    me = this_player();

    if ( me->query(" family / family_name ") != " 无 量 剑 派 东 宗 " )
    {
        message_vision(CYN" \ n 左 子 穆 冷 冷 地 看 了 $P 一 眼 ： 这 是 我 无 量 的 地 方 ， 关 你 什 么 事 ？ ！ \ n "NOR, me );
        msg = " 以 后 请 不 要 再 问 这 个 问 题 。 ";
        return msg;
    }

    if ( me->query(" lnwm / maowu / 问 左 子 穆 ") == 1 )
    {
        if ( me->query(" class_score / 无 量 剑 派 东 宗 ") >= 500 )
        {
            if ( !random(20) )
            {
                tell_object( me, CYN" \ n 左 子 穆 稍 稍 犹 豫 了 一 下 ： 你 最 好 不 要 再 问 这 个 问 题 。 \ n "NOR);
                tell_object( me, CYN" 左 子 穆 深 深 地 看 了 你 一 眼 ： 当 年 你 的 一 位 师 叔 就 是 在 参 看 玉 壁 的 秘 密 后 突 然 失 踪 的 。 \ n "NOR);
                me->delete(" lnwm / maowu / 问 左 子 穆 ");
                me->set(" lnwm / maowu / 师 叔 " , 1 );
                msg = " 玉 壁 是 我 无 量 的 秘 密 ， 你 现 在 还 是 不 知 道 的 好 些 ， 去 吧 。 \ n ";
                return msg;
            }
            else
            {
                msg = " 玉 壁 是 我 无 量 的 秘 密 ， 你 现 在 还 是 不 知 道 的 好 些 ， 去 吧 。 \ n ";
                return msg;
            }
        }
        else
        {
            tell_object( me, CYN" \ n 左 子 穆 略 微 有 些 不 快 ： 你 问 这 个 问 题 做 什 么 ？ \ n "NOR);
            msg = " 你 还 是 想 想 如 何 为 师 门 多 做 些 贡 献 吧 。 ";
            return msg;
        }
    }
    else
    {
        tell_object( me , CYN" \ n 左 子 穆 一 脸 茫 然 。 \ n "NOR);
        msg = " 你 怎 么 想 起 来 问 这 个 问 题 呢 ？ ";
        return msg;
    }
}

int accept_betray( object me )
{
    me->delete(" wuliang / master ");
    return 1;
}

int accept_chushi( object me )
{
    object this;

    me = this_player();
    this = this_object();

    if( me->query_jibie(" liuyun - jian ") > 90 )
    {
        if(!me->query(" marks / 悟 剑 居 ") )
        {
            me -> add( " class_score / 无 量 剑 派 东 宗 ",-10);
            tell_object(me, " 你 功 夫 未 成 ， 还 是 在 我 手 下 多 学 几 年 吧 。 \ n ");
            return 0;
        }
        else if( me->query(" age ") < 20 )
        {
            message_vision(CYN" $N 对 $n 说 道 ： “ 你 年 纪 轻 轻 就 出 去 ， 人 家 会 以 为 我 无 量 "
                " 无 人 的 。 ” \ n "NOR,this,me);
            me -> add( " class_score / 无 量 剑 派 东 宗 ",-10);            
            tell_object(me, " 过 两 年 再 说 吧 。 \ n ");
            return 0;
        }
        else
        {
            return 1;
        }
    }
    else
    {
        tell_object(me, " 学 艺 未 精 ， 出 去 岂 非 给 我 无 量 东 宗 丢 脸 ！ \ n ");
        return 0;
    }

    return 1;
}        

void talk_chushi(object me)
{
    command( " snow "+me->query(" id "));
    message_vision(CYN" $N 看 看 了 $n ， 道 ： “ 既 然 这 样 ， 我 也 知 道 留 你 不 住 了 。 "
       " 出 去 了 可 不 要 忘 了 为 师 和 你 的 师 兄 弟 们 啊 。 \ n "NOR, this_object(), me);
    me->delete(" marks / 悟 剑 居 ");
    get_sword(me);
    tell_object(me, " 罢 了 ， 罢 了 。 。 。 \ n ");
    me->delete(" wuliang / master ");
}

void get_sword( object me )
{
    object *inv;

    inv = all_inventory( me );

    foreach( object ob in inv )
    {
        if( ob->query(" id ")==" chang jian " 
            && ob->query(" name ")==HIY" 长 剑 "NOR )
        {
            say(CYN" 左 子 穆 说 道 ， “ 你 身 上 的 剑 就 不 要 带 着 了 吧 。 \ n "
            " 说 着 把 你 身 上 的 长 剑 拿 走 了 。 \ n "NOR );
            ob -> move(environment(me));
            destruct(ob);
        }
    }
}

