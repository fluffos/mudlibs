inherit NPC;

void create()
{
    set_name("癞皮狗", ({ "dog" }) );
    set("race", "野兽");
    set("age", 2);
    set("long", "一只浑身脏兮兮的癞皮狗。\n");
    set("str", 27);
    set("cor", 30);
    set("limbs", ({ "头部", "身体", "前脚", "後脚", "尾巴" }) );
    set("verbs", ({ "bite", "claw" }) );

    set_wugong("dodge",100);
    set_xiuwei("dodge",100);

    set("chat_chance", 10);
    set("chat_msg", ({
            (: this_object(), "random_move" :),
            "癞皮狗用鼻子闻了闻你的脚。\n",
            "癞皮狗在你的脚边挨挨擦擦的，想讨东西吃。\n",
            "癞皮狗对著你摇了摇尾巴。\n",
            "癞皮狗用後腿抓了抓自己的耳朵。\n" }) ); 

   set_temp("apply/attack", 10);
   set_temp("apply/armor", 5);

   setup();
}

int accept_object(object who, object ob)
{
    if( ob->id("bone") )
    {
        set_leader(who);
        message("vision", name() + "高兴地汪汪叫了起来。\n", environment());
        return 1;
    }

    return 0;
}

