#include <weapon.h>
#include <ansi.h>
#include <mudlib.h>
inherit SWORD;

void create() {
  set_name(HIY "长剑" NOR, ({ "chang jian", "sword" }));
  set_weight(1500);

  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("value", 1000);
    set("material", "steel");
  }

  init_sword(16);
  set("cant_sell", "无量剑派的东西，砍了小的脑袋也不敢收。\n");
  set("wield_msg", "$N「唰」地一声抽出一把$n握在手中。\n");
  set("unwield_msg", "$N将手中的$n插入腰间的剑鞘。\n");
  setup();
}

int query_autoload() {
  if (!this_player()) return 0;

  if (objectp(environment()) &&
    environment()->query("family/family_name") == "无量剑派东宗") {
    this_object()->set("long", "一把无量剑派本门使用的长剑，剑上刻着"
      +HIY "无量剑" + this_player()->query("name") + "" NOR + "几个字\n");
    return 1;
  } else {
    return 0;
  }
}

varargs int move(mixed dest, int silent) {
  object env = environment();

  if (!env) {
    return ::move(dest, silent);
  }

  if (objectp(env) && env->is_character()
    && env->id(query("owner")) && !env->is_ghost())
    return notify_fail("剑在人在，剑亡人亡。这把师门佩剑可不能离身。\n");

  //呵呵，人已经死了，怎么还剑忘人亡。。:P -- nerd
  if (!stringp(query("owner")) &&
    (dest->query("family/family_name") == "无量剑派东宗")) {
    set("owner", dest->query("id"));
    set("long", "一把无量剑派本门使用的长剑，剑上刻着" +
      HIY "无量剑  " + dest->name() + NOR "几个字\n");
  } else {
    tell_object(env, "剑转眼间断成了数块，不见了。\n");
    call_out("dest", 1);
    //destruct(this_object());
    return 1;
  }
  return ::move(dest, silent);
}

// sigh..
void dest() {
  destruct(this_object());
}

int IsAutoLoad() { return 1; }

mapping GetItemInfo() {
  return ([
    "owner": query("owner"),
    "long": query("long"),
  ]);
}

int SetItemInfo(mapping info) {
  if (mapp(info)) {
    set("owner", info["owner"]);
    set("long", info["long"]);
    return 1;
  } else if (!info) {
    return 1;
  } else return 0;
}
