inherit ITEM;

void create() {
  set_name("铜钥匙", ({ "yao shi", "shi" }));
  set("long", "一把黄澄澄的铜钥匙。\n");
  set_weight(20);
  set("unit", "把");
  set("value", 200);
  setup();
}

void init() {
  add_action("do_kai", "kai");
}

int do_kai(string arg) {
  object me;
  object where;

  me = this_player();
  where = environment(me);

  if (!arg || arg != "suo") return 0;

  if (arg == "suo") {
    if (where->query("short") != "屋后") {
      return notify_fail("你要开什么？\n");
    }

    if (!where->query("status_lock")) {
      return notify_fail("锁已经打开了。\n");
    } else {
      where->delete("status_lock");
    }
    message_vision("只听“咔嗒”一声，锁被打开了。\n", me);
    return 1;
  }

  return 0;
}
