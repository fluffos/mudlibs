inherit F_NEW_MASTER;

#include "east_master.h"

void create() {
  set_name("商余庆", ({ "shang yuqing", "shang", "yuqing" }));
  create_family("无量剑派东宗", 6, "弟子");
  set("class", "wuliang_east");
  set("gender", "男性");
  set("age", 36);

  set_wugong("wuliang-xinfa", 100, 100, 1);

  set_wugong("unarmed", 100, 100, 0);
  set_wugong("taizu-quan", 100, 100, 1);

  set_wugong("sword", 100, 100, 0);
  set_wugong("wuliang-jian", 100, 100, 1);

  set_wugong("jiben-qinggong", 100, 100, 0);
  set_wugong("wuliang-shenfa", 100, 100, 1);

  set_xiuwei_level_by_type("unarmed", 2);
  set_xiuwei_level_by_type("sword", 2);
  set_xiuwei_level_by_type("dodge", 2);
  set_xiuwei_level_by_type("force", 2);
  set_xiuwei_level_by_type("zonggang", 2);

  set("combat_exp", 20000);

  set("inquiry", ([
    "职责": "我同曲连兴负责看守通往后山的要道, 同时我们也传授刚入门的"
    "师弟们本门的基本武功.",
    "后山": "后山是本门禁地, 未得掌门人同意, 不能进入.",
  ]));

  ::create();

  setup();
  carry_object(__DIR__ "obj/cloth")->wear();
}

void init() {
  ::init();
  add_action("do_leave", "go");
}

int accept_apprentice(object me) {
  return can_apprentice(me);
}

int do_leave(string arg) {
  if (arg == "eastup") {
    message_vision("商余庆拦住了$N，说：'后山是本派重地，你请回吧。'\n", this_player());
    return 1;
  }

  return 0;
}
