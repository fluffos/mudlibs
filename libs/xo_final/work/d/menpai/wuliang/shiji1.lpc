#include <room.h>

inherit ROOM;

void create() {
  set("short", "石级");
  set("long", @LONG
这里是一条全以山中大石砌成的石级，极是倾斜，一直向西边延伸，路旁的
石壁上湿漉漉的，沾满了青苔，那石级弯弯曲曲，不知通向何方，只听到石级尽
处隐隐传来轰隆轰隆的水声，又有光线透进来，看来石级的尽头别有出路。
LONG
  );
  set("exits", ([
    "west": __DIR__ "dongxue",
    "east": __DIR__ "shishi2",
  ]));

  setup();

  //place_program(ROOM);
