#include <ansi.h>
inherit ITEM;

void create()
{
    set_name("石碑", ({"shi bei", "xiang", "box"}));
    set_weight(200000);
    if( clonep() )
        set_default_object(__FILE__);
    else {
        set("long", "碑上写着      \n"+ HIY @LONG
                  无
                  量
                  仙
                  境
                  
                  第
                  三
                  十
                  一
                  洞
                  天
LONG NOR);
        set("unit", "块");
        set("material", "steal");
    }
    set("no_get",1);
    setup();
}
