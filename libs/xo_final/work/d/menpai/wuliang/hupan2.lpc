#include <room.h>

inherit ROOM;

void create() {
  set("short", "剑湖畔");
  set("long", @LONG
只见湖畔生着一丛丛茶花，湖面上时有微风送来，吹得花儿轻轻摆动，摇曳
生姿，云南茶花本有“甲天下”之称，这里的茶花虽是生在野外，不曾经人精心
栽培，但气侯湿暖，极是适宜茶花生长，所以倒还长得不错，边上尽是悬崖峭壁
，崖边有些小树丛，上面长满了青红色的野果。
LONG
  );
  set("exits", ([
    "southeast": __DIR__ "jianhu_pan",
    "west": __DIR__ "hupan1",
  ]));

  set("outdoors", "wuliang");
  setup();
  //place_program( ROOM );
}
