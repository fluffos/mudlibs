#include <room.h>
inherit DOOR_ROOM;

void create() {
  set("short", "剑湖宫东门");
  set("long", @LONG
这是剑湖宫通向宫外的一道偏门，门板不知是以什么材料制成，看上去黝黑
一片，似乎极为沉重，上面有两个擦得晶亮的铜环；门内有一株老柏，生得苍劲
挺拔，枝叶茂密，南面一扇小木门，终日都紧闭着，也不知道是通向什么地方。
LONG);
  set("exits",
    ([
      "west": __DIR__ "lianwu_ting",
      "east": __DIR__ "shandao",
      "south": __DIR__ "chufang",
    ]));

  /*
    set("search_things",([
        "木门": "/clone/misc/domainmaker",
    ]));
*/

  set("need_clean", "无量剑派东宗");
  set("objects", ([
    __DIR__ "npc/dizi2": 2, ]));

  create_door("south", "木门", "north", DOOR_CLOSED);
  setup();
}

void init() {
  add_action("do_open", "open");
}

int do_open(string arg) {
  write("那铁锁已经锈迹斑斑，打不开了。\n");
  return 1;
}
