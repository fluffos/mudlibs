#include <ansi.h>
#include <room.h>

inherit ROOM;

void create() {
  set("short", "绝崖");
  set("long", @LONG
这里已没有出路，前面是一道深渊，隐隐能听到从下面传来隆隆的响声。
西北角上一条大瀑布从高崖直泻而下，便如潮水大至一般。这里已到了山路的
尽头，再也无法往前走了。
LONG);
  set("exits", ([
    "south": __DIR__ "milin1",
  ]));
  set("outdoors", "wuliang");
  setup();
}

void init() {
  call_out("decide_down", 4, this_player());
}

void decide_down(object me) {
  object obj, ob = this_object();

  if (ob != environment(me)) return;

  if (objectp(obj = present("gan ghao", ob)) && living(obj)
    && me->query("max_force") > 1000 && obj->is_killing(me->query("id"))) {
    tell_object(me, HIR "你脚下一软，只觉耳旁风声呼呼，身子直坠而下......\n" NOR);
    tell_object(me, HIY "突然，你撞到一棵大松树上，被弹了起来，再落下时，已抱住了松树的一个树枝。\n\n" NOR);
    me->move("/d/place/jianhu/pine");
    tell_room(ob, "忽然你发现周围少了个人，不知什么时候$N已不见了。\n", me);
  } else {
    tell_object(me, "突然一阵劲风卷来，你只觉身子飘飘忽忽，险些坠下崖底。\n");
  }
}
