#include <room.h>
inherit DOOR_ROOM;

void create() {
  set("short", "囚室");
  set("long", @LONG
这里光线昏暗，仅从西边狭小的窗户里透出几线天光。四面都是由坚固的山
石砌成，出口处是黝黑的铁栅栏。平常这儿都用来关押不守门规的弟子，有时也
关押擅闯无量剑派的江湖中人。牢房的角落有很多老鼠洞，经常有老鼠进进出出
。
LONG);
  set("exits",
    ([
      "east": __DIR__ "wuhou", ]));
  set("objects", ([
    __DIR__ "npc/rat": 2,
  ]));
  create_door("east", "铁门", "west", DOOR_CLOSED);
  setup();
}

void reset() {
  string book;
  ::reset();

  if (random(10) > 5) {
    book = "wuliang-jian-pro";
  } else {
    book = "wuliang-jian";
  }

  set("search_things", ([
    "老鼠洞": ([
      BOOK_DIR + book: 0,
    ]),
  ]));
}
