inherit NPC;

#include "west.h";

void create()
{
    set_name("张双翌", ({ "zhang shuangyi", "zhang"}) );
    set("title","执法长老");
    set("gender", "男性" );
    set("age", 42);
   
    set("no_kill", "west_wuliang");
    set("str", 20);
    set("cor", 20);
    set("cps", 20);
    set("per", 20);
    set("int", 24);

    set("attitude", "heroism");

    set("max_force", 1100);
    set("force", 1100);
    set("force_factor", 40);

    set("long", @LONG
他是一位无量剑派西宗的长辈，掌门人的师弟。他是西宗执法长老，以铁
面无情而著称，
LONG
    );

    set("combat_exp", 200000);

    set_wugong("yanxing", 100, 100, 1);
    set_wugong("wuliang-xinfa", 100, 100, 1);
    set_wugong("liuyun-jian",120, 100, 1);

    set_xiuwei_by_type("sword", 2200);
    set_xiuwei_by_type("dodge", 2200);
    set_xiuwei_by_type("zonggang", 900);
    setup();

    carry_object(__DIR__"obj/sword")->wield();
    carry_object(CLOTH_DIR+"cloth3")->wear();
}

void init()
{
    object me;
    me = this_player();

    if ( me->query_condition( "kill_west_wuliang" ) )
    {
        message_vision("张双翌对$N大喝：大胆狂徒，以为无量山是你随便杀人放火的地方吗？\n视我们西宗为无物吗？\n", me );
        set("force_factor", 150);
        set("env/attack", 70);
        command( "kill " + me->query( "id" ) );
        me->set_temp("pending/no_leave_west", 1);
        return ;
    }
}

