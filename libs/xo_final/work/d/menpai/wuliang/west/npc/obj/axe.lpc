// axe.c

#include <weapon.h>

inherit AXE;

void create() {
  set_name("铁斧", ({ "tie fu", "axe" }));
  set_weight(6000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long", "这是一把沈重的铁斧，用来剁肉的，上面还刻着个邢字。\n");
    set("value", 11);
    set("wield_msg", "$N拿出一把剁肉用的$n，握在手中当作武器。\n");
    set("unwield_msg", "$N放下手中的$n。\n");
  }
  init_axe(11, TWO_HANDED);
  setup();
}

void init() {
  add_action("do_duo", ({ "duo", "chop" }));
}

int do_duo(string arg) {
  object me, retou, *all;
  int i;

  me = this_player();
  if (arg != "corpse")
    return notify_fail("这把斧子是邢老头给你剁邢虎的人头用的！\n");
  all = all_inventory(environment(me));
  for (i = 0; i < sizeof(all); i++) {
    if (!(userp(all[i])) &&
      (string)all[i]->query("name") == "邢虎的尸体") {
      message_vision("$N操起一把铁斧干净利落的剁下邢虎的人头。\n", me);
      all[i]->set("name", "一具无头尸体");
      all[i]->set("long", "一具无头尸体躺在那里。\n");
      retou = new("/d/menpai/wuliang/west/npc/obj/rentou");
      retou->set("name", "邢虎的人头");
      if (!(retou->move(me)))
        retou->move(environment(me));
      return 1;
    }
  }
  return notify_fail("这里没有邢虎的尸体。\n");
}
