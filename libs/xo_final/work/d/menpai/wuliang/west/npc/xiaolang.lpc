#include "include/xing.mark"

inherit NPC;

private void create();
private void init();

int ask_me();
int do_answer( string );
int accept_object( object, object );
private void del0( object );
private void del1( object );

private int JudeRing;

private void create()
{
    set_name("小郎", ({"xiao lang", "nan dizi", "dizi"}) );
    set("long", @LONG
他身形修长，猿臂熊肩，剑眉虎目，二十几岁的年纪，体形并不特别魁梧雄
壮，但一看便知是矫捷勇悍的年轻人。
LONG
    );
    set("gender", "男性");
    set("attitude", "heroism");
    set("no_kill", "west_wuliang");

    set("per", 25);

    set("age", 24);
    set("max_kee", 500);
    set("kee",500);
    set("max_force", 600);
    set("force", 600);
    set("combat_exp", 8000);
    set("inquiry", ([
        "心事" : "我是有心事，可谁能帮助我？ 说着说着，就长叹一声。\n",
        "小玉" : "小玉啊，她是我的师妹。",
        "邢小玉" : "小玉啊，她是我的师妹。",
        "帮助" : (:ask_me:),
        "帮忙" : (:ask_me:),
    ]));

    set_wugong("unarmed",80,80,1);
    set_wugong("nanshan-liushi",40,30,1);
    set_wugong("wuliang-xinfa",50,40,1);
    set_wugong("sword",60,40,1);         
    set_wugong("wuliang-jian",40,20,1);
    set_xiuwei_by_type("parry",100);
    set_xiuwei_by_type("sword",100);
    set_xiuwei_by_type("dodge",100);
    set_xiuwei_by_type("unarmed",100);

    create_family("无量剑派西宗", 6, "弟子");
    setup();

    JudeRing = 0;
    carry_object(__DIR__"obj/sword")->wield();
    carry_object(__DIR__"obj/baishan")->wear();
}

void init()
{
    add_action("do_answer", "answer");
    add_action("do_answer", "huida");
}

int ask_me()
{
    object ppl = this_player();
    int xing_temp_mark, xing_mark;

    if ( JudeRing )
    {
        message_vision( "小郎对$N说到：谢谢了，我现在不需要帮忙。\n", ppl );
        return 1;
    }

    xing_temp_mark = ppl->GetTempMark( "xing" );
    xing_mark = ppl->GetMark( "xing" );

    if ( xing_temp_mark & X_HELP_XIAOLANG )
    {
        message_vision( "小郎对你说道：赶紧去吧，我在这里等你。\n", ppl );
    }
    else if ( xing_temp_mark & X_LOST )
    {
        command( "kick " + ( string ) ppl->query( "id" ) );
        message_vision( "小郎看着$N，叹了一口气，说到：帮不上别人的忙，就不要\n"
            + "随便允诺嘛。下次吧。\n", ppl );
        remove_call_out( "del0" );
        call_out( "del0", 300, ppl );
    }
    else if ( xing_mark & X_HELP_XIAOLANG )
    {
        command( "touch " + ( string ) ppl->query( "id" ) );
        message_vision( "小郎笑着对$N说：多谢您的帮忙！\n", ppl );
    }
    else if ( xing_temp_mark & X_NOT_HELP_XIAOLANG )
    {
        message_vision( "小郎看着$N皱了皱眉头，说道：\n"
            + "你既然不想帮我，还问什么？", ppl );
    }
    else
    {
        command( "look " + ( string ) ppl->query( "id" ) );
        message_vision( "小郎对$N说到：我有是需要人帮我。你能帮我吗？\n", ppl );
        xing_temp_mark |= X_HELPING_XIAOLANG;
        ppl->SetTempMark( "xing", xing_temp_mark );
        write( "如果你想帮他，回答(huida)能，否则回答(huida)不。\n");
    }
    return 1;
}

int do_answer( string arg )
{
    object ppl, letter;
    int xing_temp_mark, xing_mark;
    
    ppl = this_player();
    xing_temp_mark = ( int ) ppl->GetTempMark( "xing" );
    xing_mark = ( int ) ppl->GetMark( "xing" );    

    if ( !( xing_temp_mark & X_HELPING_XIAOLANG ) )
    {
        return notify_fail("什么？\n");
    }
    else if ( arg == "不" )
    {
        command("sigh");
        xing_temp_mark |= X_NOT_HELP_XIAOLANG;
        xing_temp_mark &= NOT( X_HELPING_XIAOLANG );
        ppl->SetTempMark( "xing", xing_temp_mark );
        write( "小郎看着你，叹到：那就算了罢。\n" );
        return 1;
    }
    else if ( arg == "能" || arg == "可以" )
    {
        letter = new( __DIR__"obj/letter" );
        letter->move( ppl );
        write("小郎悄悄给你一封信。\n");
        command( "whisper " + ( string ) ppl->query( "id" ) 
            + " 请你把这封信给花园里的那个姑娘。赶紧去吧！" );
        remove_call_out( "del1" );
        call_out( "del1", 600, ppl );
        write( "小郎期盼的看着你。\n" );
        
        return 1;
    }
    write("你要回答什么？\n");
    return 1;
}

int accept_object(object ppl, object ob)
{
    int xing_mark, xing_temp_mark;

    if ( userp(ob) ) return 0;

    xing_mark = ppl->GetMark( "xing" );
    xing_temp_mark = ppl->GetTempMark( "xing" );

    if ( (string)ob->query("id") == "yu lianhuan" )
    {
        if ( xing_temp_mark & X_BACK )
        {
            xing_temp_mark &= NOT( X_BACK );
            ppl->SetTempMark( "xing", xing_temp_mark );
            message_vision( "$N对小郎说:\n小玉让我告诉你，她在花园等你。\n", ppl );
            command( "jump" );
            command( "wave " + ( string ) ppl->query( "id" ) );
            message_vision( "小郎向西离去。", ppl );
            xing_mark |= X_MATCH_XIAOLANG;
            ppl->SetMark( "xing", xing_mark );
            JudeRing = 1;
            this_object()->move("/d/menpai/wuliang/west/huayuan");
            return 1;
        }
        else
        {
            message_vision( "小郎皱着眉头看着你，不满的对你说道；\n" +
                "这是小玉的吧，你从哪里得到的？\n", ppl );
            return 0;
        }
    }
    return 0;
}


void del0(object ppl)
{
    int xing_temp_mark = ppl->GetTempMark( "xing" );
    if ( xing_temp_mark & X_LOST )
    {
        xing_temp_mark &= NOT( X_LOST );
        ppl->SetTempMark( "xing", xing_temp_mark );
    }
}

void del1(object ppl)
{
    object ob;
    
     int xing_temp_mark;
       if(!objectp(ppl))  return;
       xing_temp_mark = ppl->GetTempMark( "xing" );

    if ( xing_temp_mark & X_HELPING_XIAOLANG )
    {
        xing_temp_mark &= NOT( X_HELPING_XIAOLANG );
        xing_temp_mark |= X_LOST;
        ppl->SetTempMark( "xing", xing_temp_mark );
        write("你迟迟未把信送到，小郎的忙你是帮不上了。\n");
        if ( objectp( ob = present( "xin", ppl ) ) ) destruct(ob);
    }
}

void setup()
{
    object room;
    ::setup();

    if ( !random( 3 ) )
    {
        JudeRing = 0;
    }

    room = find_object( "/d/menpai/wuliang/west/xishi_lu2" );
    if ( !room )
    {
        room = load_object( "/d/menpai/wuliang/west/xishi_lu2" );
    }

    remove_call_out( "delay_move" );
    call_out( "delay_move", 1, room);
}

private void delay_move( object room )
{
    if ( objectp( present( "xiao lang", room ) ) )
    {
        //destruct( this_object() );
    }
    else
    {
        move( "/d/menpai/wuliang/west/xishi_lu2" );
    }
}

