inherit NPC;

#include <ansi.h>

void create() {
  set_name("陈光席", ({ "chen guangxi", "chen" }));
  set("title", "剑屋总管");
  set("gender", "男性");
  set("no_kill", "west_wuliang");
  set("age", 32);
  set("str", 26);
  set("int", 20);
  set("per", 26);
  set("long", "一中年汉子，据说他掌管剑屋有十几年了。\n");
  set("combat_exp", 50000);
  set("social_exp", 2000);
  set("attitude", "heroism");

  set("force", 600);
  set("max_force", 600);
  set("force_factor", 20);
  set("kee", 600);
  set("max_kee", 600);

  set_wugong("unarmed", 80, 80, 1);
  set_wugong("sword", 100, 100, 1);
  set_wugong("wuliang-shenfa", 80, 80, 1);
  set_wugong("yanxing", 70, 70, 1);
  set_wugong("wuliang-jian", 80, 100, 1);
  set_xiuwei("unarmed", 100);
  set_xiuwei("sword", 100);

  setup();
  carry_object(__DIR__ "obj/jian")->wield();
  carry_object(__DIR__ "obj/cloth")->wear();
}


void init() {
  add_action("do_ling", "ling");
}

int do_ling(string arg) {
  object who, sword;

  who = this_player();
  if (!arg) {
    return notify_fail("你想领什么？\n");
  }

  if (arg != "jian" && arg != "sword") {
    return notify_fail("你要领什么？\n");
  }

  if (who->query("family/family_name") != "无量剑派西宗") {
    return notify_fail("你没有领剑的资格。\n");
  }

  if (objectp(present("chang jian", who)) ||
    objectp(present("jian", who)) || objectp(present("sword", who))) {
    return notify_fail("陈光席不满的看了你一眼，说道：“你身上不是有剑吗？”\n");
  }

  if (this_object()->query("swords") < 10) {
    message_vision("陈光席轻轻地从架子上取下一把剑，递给$N。\n", who);
    sword = new(__DIR__ "obj/peijian");
    sword->move(who);
    sword->set("long", "一把无量剑派本门使用的长剑，剑上刻着" +
      HIY " 无量剑" +
      who->query("name") + NOR "\n");
    who->save();
    return 1;
  }

  write("不巧，剑已经领完了。\n");
  return 1;
}
