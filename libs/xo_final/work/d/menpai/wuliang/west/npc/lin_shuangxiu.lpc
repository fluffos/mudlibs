inherit F_NEW_MASTER;

#include "west.h"
#include "west_master.h"

void create()
{
    set_name("林双秀", ({ "lin shuangxiu", "dao gu", "lin"}) );
    set("gender", "女性" );
    set("age", 48);
   
    set("no_kill", "west_wuliang");
    set("str", 20);
    set("cor", 20);
    set("cps", 20);
    set("per", 20);
    set("int", 24);

    set("attitude", "peaceful");

    set("long", @LONG
她是一位无量剑派西宗的长辈，掌门人的师姐。慈眉善目，和蔼可亲，正
在指点弟子无量剑法。
LONG
    );

    create_family("无量剑派西宗", 5, "弟子");

    set("combat_exp", 200000);

    set_wugong( "wuliang-xinfa", 200, 200, 1 );

    set_wugong( "unarmed", 200, 200, 0 );
    set_wugong( "taizu-quan", 200, 200, 0 );
    set_wugong( "nanshan-liushi", 200, 200, 1 );

    set_wugong( "sword", 200, 200, 0 );
    set_wugong( "wuliang-jian", 200, 200, 0 );
    set_wugong( "liuyun-jian", 200, 200, 1);

    set_wugong( "jiben-qinggong", 200, 200, 0 );
    set_wugong( "wuliang-shenfa", 200, 200, 0 );
    set_wugong( "yanxing", 200, 200, 1 );

    set_xiuwei_level_by_type("unarmed", 4);
    set_xiuwei_level_by_type("sword", 4);
    set_xiuwei_level_by_type("dodge", 4);
    set_xiuwei_level_by_type("force", 4);
    set_xiuwei_level_by_type("zonggang", 4);

    ::create();

    setup();

    carry_object(__DIR__"obj/sword")->wield();
    carry_object(__DIR__"obj/daopao")->wear();
}

int accept_apprentice(object me)
{
    return can_apprentice(me);
}

