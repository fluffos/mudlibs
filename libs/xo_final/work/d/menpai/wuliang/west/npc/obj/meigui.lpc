#include "flower.h"
#include <ansi.h>

void create()
{
    set_name(HIR "玫瑰花" NOR, ({"meigui hua","meigui","hua"}));
    set_weight(10);
    if (clonep())
        set_default_object(__FILE__);
    else {
        set("unit", "朵");
        set("long", "一朵芳香馥郁的玫瑰花，正羞答答的开着。\n");
        set("value", 200);
        set("material", "steel");
        set("armor_prop/armor",1);
        set("armor_prop/personality", 3);
        set("wield_msg", "$N漫不经心的拈其一朵$n，浅笑着说道：进招吧！\n");
        set("unwield_msg", "$N将手中的$n藏在背后，一副很得意的样子。\n");
    }
    init_sword(1);
    setup();
}

void init()
{
    add_action("do_dai", "dai");
}

int do_dai(string arg)
{
    object ob, me;

    me = this_player();
    if ( !arg || ( arg != "meigui hua" && arg != "hua" && arg != "meigui" )) 
        return notify_fail("你要戴什么？\n");
    if ( !objectp( ob = present(arg, me) ) )
        return notify_fail("你身上没有花。\n");
    if ( ob->query("equipped") )
        return notify_fail("你已经戴着了。\n");
    ob->wear();
    if ( (string)me->query("gender") == "女性" ) {
        message_vision("$N将一朵玫瑰花插在鬓间，回眸一笑，好一个美貌娇娘！\n", me);
        return 1;
    }
    message_vision("$N将玫瑰花别在胸前，好一个风流儿郎！\n");
    return 0;
}
