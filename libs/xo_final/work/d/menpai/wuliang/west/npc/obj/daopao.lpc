// qing-daopao.c

#include <armor.h>

inherit CLOTH;

void create() {
  set_name("青道袍", ({ "qing daopao", "daopao", "cloth" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一领青道袍，道士道姑多长年穿它。\n");
    set("unit", "领");
    set("value", 300);
    set("material", "cloth");
    set("armor_prop/armor", 1);
    set("armor_prop/personality", 3);
  }
  setup();
}
