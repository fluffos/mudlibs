#include <armor.h>
#include <ansi.h>
inherit NECK;

void create()
{
    set_name("玉连环", ({"yu lianhuan", "jadering", "jade ring", "ring"}) );
    set("weight", 500);
    if (clonep())
        set_default_object(__FILE__);
    else {
        set("long", @LONG
一个晶莹剔透的玉连环，温润可爱。上面刻着一行字：    
        玲珑玉连环, 问君谁能解。
LONG
        );
        set("unit", "串");
        set("value", 200);
        set("material", "jade");
        set("armor_prop/armor", 1);
        set("armor_prop/personality", 10);
        set("unequip_msg","$N从脖子上解下一串$n。\n");
        set("wear_msg", "$N把$n戴在脖子上。\n");
        set("female_only", 1);
    }
    setup();
}
