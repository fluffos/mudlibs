// baizi.c

inherit ITEM;
inherit F_FOOD;

void create() {
  set_name("包子", ({ "baozi" }));
  set_weight(150);  //三两
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一个热腾腾的包子。\n");
    set("unit", "个");
    set("value", 2);
    set("food_remaining", 3);
    set("food_supply", 40);
  }
  setup();
}
