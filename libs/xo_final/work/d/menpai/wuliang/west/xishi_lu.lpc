// Room: /d/wuliang/xishi_lu.c
//by trill 01/24/97 

#include <room.h>
inherit ROOM;

void create() {
  set("short", "细石路");
  set("long", @LONG
你走在一条很长的细石路上，脚下的细石辗的很细，睬在上面，发出吱吱呀呀的
声音。路两旁植满了花木，长得十分惹人注目。东面屋子的窗户紧闭。似乎从南面的
空地那边隐隐约约传来阵阵剑器相撞的锵锵声。北面是西宗的厨房。
LONG
  );
  set("no_clean_up", 0);
  set("exits", ([ /* sizeof() == 4 */
    "east": __DIR__ "nvdizi_shi",
    "west": __DIR__ "nandizi_shi",
    "south": __DIR__ "neiting",
    "north": __DIR__ "chufang",
  ]));

  setup();
}

int valid_leave(object me, string dir) {
  mapping me_fam;

  if ((!(me_fam = me->query("family")) || me_fam["family_name"] != "无量剑派西宗" && !wizardp(me))
    && (dir == "west" || dir == "east")) {
    return notify_fail("那是无量剑派弟子的休息室，客人可以去厢房休息。\n");
  }

  if ((string)me->query("gender") == "男性" && dir == "east" && !wizardp(this_player())) {
    write("有没有搞错啊？\n");
    return notify_fail("那是女弟子休息室！\n");
  }

  if ((string)me->query("gender") == "女性" && dir == "west" && !wizardp(this_player())) {
    return notify_fail("那是男弟子休息室，你还是别进去的好。\n");
  }

  return ::valid_leave(me, dir);
}
