// This program is a part of NT MudLIB

#include <ansi.h>

inherit F_NEW_MASTER;

#include "emei_master.h"

int ask_for_ji();

void create()
{
    set_name("贝锦仪", ({ "bei jinyi", "bei", "jinyi"}));
    set("long", "她是峨嵋派的第四代俗家弟子。\n");
    set("gender", "女性");
    set("age", 21);
    set("attitude", "peaceful");
    set("class", "fighter");
    set("shen_type", 1);

    set("str", 21);
    set("int", 25);
    set("con", 24);
    set("dex", 20);

    set("combat_exp", 250000);

    set_wugong("minghe-gong", 200, 200, 1);
    set_wugong("xiuyue-jianfa", 300, 300, 1);
    set_wugong("yanbo-bu", 300, 300, 1);

    set_xiuwei_level_by_type("force", 4);
    set_xiuwei_level_by_type("dodge", 3);
    set_xiuwei_level_by_type("sword", 3);
    set_xiuwei_level_by_type("zonggang", 4);

    set("inquiry", ([
        "出家"     : "你去本山的庵堂里找我静字辈师姐吧。她们在福寿庵、千佛庵、\n万年庵、万行庵和卧云庵修行。\n",
        "灭绝师太" : "她是本派掌门人，在华藏庵修行。\n",
        "纪晓芙"   : (: ask_for_ji :),
    ]));

    create_family("峨嵋派", 4, "弟子");

    ::create();
    setup();

    carry_object(SWORD_DIR"changjian")->wield();
    carry_object(CLOTH_DIR"female-cloth")->wear();
    carry_object(CLOTH_DIR"female-shoe")->wear();
}

int ask_for_ji()
{
    object ob;
    ob = this_player();
    tell_object(ob,"贝锦仪说道：纪晓芙在舍身崖呢。她就是想不开。嗨！\n");
    ob->set("marks/ji", 1);
    return 1;
}
