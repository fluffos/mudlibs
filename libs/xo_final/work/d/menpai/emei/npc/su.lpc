// This program is a part of NT MudLIB
// su.c 苏梦清

#include <ansi.h>

inherit F_NEW_MASTER;

#include "emei_master.h"

void create()
{
    set_name("苏梦清", ({ "su mengqing","su","mengqing"}));
    set("long",
        "她是峨嵋派的第四代俗家弟子。\n");
    set("gender", "女性");
    set("age", 22);
    set("attitude", "peaceful");
    set("shen_type", 1);
    set("class", "fighter");

    set("str", 30);
    set("int", 30);
    set("con", 30);
    set("dex", 30);
    set("per", 30);

    set("combat_exp", 150000);

    set_wugong("minghe-gong", 200, 200, 1);
    set_wugong("feiyan-chunci", 300, 300, 1);
    set_wugong("yanbo-bu", 300, 300, 1);

    set_xiuwei_level_by_type("force", 4);
    set_xiuwei_level_by_type("dodge", 3);
    set_xiuwei_level_by_type("short", 3);
    set_xiuwei_level_by_type("zonggang", 4);

    create_family("峨嵋派", 4, "弟子");

    ::create();
    setup();
    carry_object(SHORT_DIR"dagger")->wield();
    carry_object(CLOTH_DIR"female-cloth")->wear();
    carry_object(CLOTH_DIR"female-shoe")->wear();
}

