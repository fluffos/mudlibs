// This program is a part of NT MudLIB
// fang.c 方碧琳

#include <ansi.h>

inherit F_NEW_MASTER;

#include "emei_master.h"

void create()
{
    set_name("方碧琳", ({ "fang bilin","fang","bilin"}));
    set("long",
        "她是峨嵋派的第四代俗家弟子。\n");
    set("gender", "女性");
    set("age", 20);
    set("attitude", "peaceful");
    set("shen_type", 1);
    set("shen", 10000);
    set("class", "fighter");

    set("str", 30);
    set("int", 30);
    set("con", 30);
    set("dex", 30);
    set("per", 30);

    set("combat_exp", 150000);

    set_wugong("minghe-gong", 200, 200, 1);
    set_wugong("lengyue-ci", 300, 300, 1);
    set_wugong("jiben-qinggong", 300, 300, 1);

    set_xiuwei_level_by_type("force", 4);
    set_xiuwei_level_by_type("dodge", 2);
    set_xiuwei_level_by_type("short", 2);
    set_xiuwei_level_by_type("zonggang", 4);

    set("inquiry", ([
        "出家"     : "你去本山的庵堂里找我静字辈师姐吧。她们在福寿庵、千佛庵、\n万年庵、万行庵和卧云庵修行。\n",
        "灭绝师太" : "她是本派掌门人，在华藏庵修行。\n",
    ]));

    create_family("峨嵋派", 4, "弟子");

    ::create();
    setup();
    carry_object(SHORT_DIR"dagger")->wield();
    carry_object(CLOTH_DIR"female-cloth")->wear();
    carry_object(CLOTH_DIR"female-shoe")->wear();
}

