// This program is a part of NT MudLIB
// zhao.c 静照师太

#include <command.h>
#include <ansi.h>

inherit F_NEW_MASTER;

#include "emei_master.h"

void create()
{
    set_name("静照师太", ({ "jingzhao shitai","jingzhao","shitai"}));
    set("long",
       "她是一位中年出家道姑，道冠高拢，慈眉善目。\n");
    set("gender", "女性");
    set("age", 43);
    set("attitude", "peaceful");
    set("shen_type", 1);
    set("shen", 10000);
    set("class", "bonze");
    set("inquiry",([
        //"剃度"  : (: ask_for_join :),
        //"出家"  : (: ask_for_join :),
        "还俗"  : "峨嵋弟子，不能还俗。你找掌门师太吧。",
    ]));

    set("str", 30);
    set("int", 30);
    set("con", 30);
    set("dex", 30);
    set("per", 20);

    set("combat_exp", 150000);

    set_wugong("minghe-gong", 300, 300, 1);
    set_wugong("jiumei-ci", 300, 300, 1);
    set_wugong("yuxue-dunxing", 300, 300, 1);

    set_xiuwei_level_by_type("force", 5);
    set_xiuwei_level_by_type("dodge", 5);
    set_xiuwei_level_by_type("short", 6);
    set_xiuwei_level_by_type("zonggang", 5);

    create_family("峨嵋派", 4, "弟子");

    ::create();
    setup();
    carry_object(SHORT_DIR"dagger")->wield();
    carry_object(CLOTH_DIR"ni-cloth")->wear();
    carry_object(CLOTH_DIR"ni-shoe")->wear();
}

