// This program is a part of NT MudLIB
// ling.c 赵灵珠

#include <ansi.h>

inherit F_NEW_MASTER;

#include "emei_master.h"

void create()
{
    set_name("赵灵珠", ({ "zhao lingzhu","zhao","lingzhu"}));
    set("long",
        "她是峨嵋派的第四代俗家弟子。\n");
    set("gender", "女性");
    set("age", 22);
    set("attitude", "peaceful");
    set("shen_type", 1);
    set("shen", 10000);
    set("class", "fighter");

    set("str", 30);
    set("int", 30);
    set("con", 30);
    set("dex", 30);
    set("per", 30);

    set("combat_exp", 150000);

    set_wugong("minghe-gong", 200, 200, 1);
    set_wugong("qingxin-jianfa", 300, 300, 1);
    set_wugong("jiben-qinggong", 300, 300, 1);

    set_xiuwei_level_by_type("force", 4);
    set_xiuwei_level_by_type("dodge", 2);
    set_xiuwei_level_by_type("sword", 2);
    set_xiuwei_level_by_type("zonggang", 4);

    create_family("峨嵋派", 4, "弟子");

    ::create();
    setup();
    carry_object(SWORD_DIR"changjian")->wield();
    carry_object(CLOTH_DIR"female-cloth")->wear();
    carry_object(CLOTH_DIR"female-shoe")->wear();
}

