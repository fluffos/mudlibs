inherit NPC;

void create() {
  set_name("烧火小道士", ({ "shaohuo daoshi", "daoshi" }));
  set("title", "崆峒弟子");
  set("gender", "男性");
  set("class", "taoist");
  set("age", 16);
  create_family("崆峒派", 2, "弟子");

  set_wugong("dahong-quan", 20, 20, 1);
  set_xiuwei("unarmed", 100);

  set("social_exp", 2000);
  set("combat_exp", 10000);
  set("force", 200);
  set("max_force", 200);
  set("force_factor", 10);
  set("apply_food", 15);
  setup();
  carry_object(__DIR__ "obj/cloth3")->wear();
}
