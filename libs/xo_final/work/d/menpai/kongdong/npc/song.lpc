inherit F_NEW_MASTER;

#include "kongdong_master.h"

void create()
{
    set_name("宋欢臣", ({ "song huanchen","chen","song" }) );
    set("title","崆峒派二师兄");
    set("gender", "男性" );
    set("class", "kongdong");
    set("age",23);
    create_family("崆峒派", 2, "弟子");
    set("social_exp",2000);
    set("combat_exp",10000);

    set_wugong( "kongdong-xinfa", 150, 150, 1 );

    set_wugong( "unarmed", 150, 150, 0 );
    set_wugong( "shizi-zhan", 150, 150, 0 );
    set_wugong( "dahong-quan", 300, 300, 1 );

    set_wugong( "sword", 150, 150, 0 );
    set_wugong( "fengyun-jian", 150, 150, 0 );
    set_wugong( "kongling-jian", 300, 300, 1);

    set_wugong( "jiben-qinggong", 150, 150, 0 );
    set_wugong( "nieyun-bufa", 150, 150, 0 );
    set_wugong( "luofeng", 300, 300, 1);

    set_xiuwei_level_by_type("unarmed", 3);
    set_xiuwei_level_by_type("sword", 3);
    set_xiuwei_level_by_type("dodge", 3);
    set_xiuwei_level_by_type("force", 3);
    set_xiuwei_level_by_type("zonggang", 3);

    ::create();

    setup();
    carry_object(__DIR__"obj/cloth1")->wear();
}

