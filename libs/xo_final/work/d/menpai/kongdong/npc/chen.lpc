inherit F_NEW_MASTER;

#include "kongdong_master.h"

void create() {
  set_name("陈汉京", ({ "chen hanjing", "chen", "jing" }));
  set("title", "崆峒派大师兄");
  set("gender", "男性");
  set("class", "taoist");
  set("positive_score", 8000);
  set("age", 25);
  set_hp("sen", 600);
  set_hp("kee", 600);
  create_family("崆峒派", 2, "弟子");

  set("social_exp", 2000);
  set("combat_exp", 10000);

  set_wugong("kongdong-xinfa", 200, 200, 1);

  set_wugong("unarmed", 200, 200, 0);
  set_wugong("shizi-zhan", 200, 200, 0);
  set_wugong("dahong-quan", 200, 200, 0);
  set_wugong("wulong-quan", 300, 300, 1);

  set_wugong("sword", 200, 200, 0);
  set_wugong("fengyun-jian", 200, 200, 0);
  set_wugong("kongling-jian", 200, 200, 1);

  set_wugong("jiben-qinggong", 200, 200, 0);
  set_wugong("nieyun-bufa", 200, 200, 0);
  set_wugong("luofeng", 200, 200, 1);

  set_xiuwei_level_by_type("unarmed", 4);
  set_xiuwei_level_by_type("sword", 4);
  set_xiuwei_level_by_type("dodge", 4);
  set_xiuwei_level_by_type("force", 4);
  set_xiuwei_level_by_type("zonggang", 4);

  ::create();

  setup();
  carry_object(__DIR__ "obj/cloth2")->wear();
}

void init() {
  object ob = this_player();

  ::init();

  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("say_hi");
    call_out("say_hi", 1, ob);
  }
}

void say_hi(object ob) {
  if (!ob || environment(ob) != environment(this_object())) {
    return;
  }

  if (ob->query("family/family_name") != "崆峒派") {
    message_vision("陈汉京向$N一拱手：这位" + RANK_D->query_respect(ob) + "，"
      "家师就在里面，快请进吧。\n", ob);
    return;
  }

  message_vision("陈汉京笑着拍拍$N的肩膀：怎么样，功夫有长进吗？好好练吧。\n", ob);
  return;
}
