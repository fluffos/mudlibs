inherit F_NEW_MASTER;

#include "kongdong_master.h"

void create() {
  set_name("夏星幕", ({ "xia xingmu", "xia", "xingmu" }));
  set("title", "崆峒派三师兄");
  set("gender", "男性");
  set("class", "kongdong");
  set("age", 22);

  create_family("崆峒派", 2, "弟子");

  set_wugong("kongdong-xinfa", 100, 100, 1);

  set_wugong("unarmed", 100, 100, 0);
  set_wugong("shizi-zhan", 300, 300, 1);

  set_wugong("sword", 100, 100, 0);
  set_wugong("fengyun-jian", 300, 300, 1);

  set_wugong("jiben-qinggong", 100, 100, 0);
  set_wugong("nieyun-bufa", 300, 300, 1);

  set_xiuwei_level_by_type("unarmed", 2);
  set_xiuwei_level_by_type("sword", 2);
  set_xiuwei_level_by_type("dodge", 2);
  set_xiuwei_level_by_type("force", 2);
  set_xiuwei_level_by_type("zonggang", 2);

  set("social_exp", 200);
  set("combat_exp", 10000);
  set("positive_score", 1000);
  set("class_score/崆峒派", 450);

  ::create();

  setup();
  carry_object(__DIR__ "obj/cloth1")->wear();
}
