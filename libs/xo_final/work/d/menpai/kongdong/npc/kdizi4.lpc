inherit NPC;

void create()
{
    set_name("扫地道士", ({ "saodi daoshi", "daoshi" }) );
    set("title", "崆峒弟子");
    set("gender", "男性" );
    set("class", "taoist");
    set("age", 40);

	set_wugong("dahong-quan", 40, 40, 1);

	create_family("崆峒派", 2, "弟子");

	set_xiuwei("unarmed", 200);

    set("social_exp", 2000);
    set("combat_exp", 10000);
    set("force", 200);
    set("max_force", 200);
    set("force_factor", 10);
	set("apply_food", 15);
    setup();
    carry_object(__DIR__"obj/cloth2")->wear();
}

