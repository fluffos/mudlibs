#include <ansi.h>

inherit F_NEW_MASTER;

#include "kongdong_master.h"

void create() {
  seteuid(getuid());
  set_name("木灵子", ({ "mu lingzi", "mu", "lingzi" }));
  set("class", "taoist");
  set("gender", "男性");
  set("age", 50);
  set("str", 30);
  set("cor", 30);
  set("cps", 30);
  set("int", 25);
  set("ker", 24);
  set("kar", 30);

  set("rank_info/respect", "老神仙");

  set("long", "木灵子红光满面，一看就是修道有成之人，颇有些仙风道骨之相。\n");

  create_family("崆峒派", 1, "掌门人");
  set("positive_score", 30000);
  set("combat_exp", 1000000);
  set("social_exp", 200000);

  set_wugong("kongdong-xinfa", 300, 300, 1);

  set_wugong("unarmed", 300, 300, 0);
  set_wugong("qishang-quan", 300, 300, 1);

  set_wugong("sword", 300, 300, 0);
  set_wugong("fengyun-jian", 300, 300, 0);
  set_wugong("kongling-jian", 300, 300, 1);

  set_wugong("jiben-qinggong", 300, 300, 0);
  set_wugong("nieyun-bufa", 300, 300, 0);
  set_wugong("luofeng", 300, 300, 1);

  set_xiuwei_level_by_type("unarmed", 7);
  set_xiuwei_level_by_type("sword", 5);
  set_xiuwei_level_by_type("dodge", 5);
  set_xiuwei_level_by_type("force", 5);
  set_xiuwei_level_by_type("zonggang", 5);

  set("env/attack", 75);

  ::create();

  setup();
  carry_object(__DIR__ "obj/cloth1")->wear();
}

int accept_apprentice(object ob) {
  if ((int)ob->query("PKS") > 10) {
    command("hmm");
    command("say 你手上血腥浓重，怎能修身得道？\n");
    return 0;
  }

  if (ob->query("gender") == "无性") {
    command("heihei");
    command("say 你是一个阉割之人，怎能修身得道？\n");
    return 0;
  }

  return 1;
}

int recruit_apprentice(object ob) {
  ::recruit_apprentice(ob);

  command("en");
  say("木灵子笑道：“这位" + RANK_D->query_respect(ob) + "真是个可造之才呀！\n"
    "将来必能发扬我崆峒派门庭！\n");

  ob->set_family("title", "开山大弟子");

  return 1;
}

int accept_chushi(object me) {
  object this = this_object();

  if (me->query_temp("kongdong/出师比划")) {
    tell_object(me, "我不是让你先跟我比划一下吗？\n");
    return 0;
  }

  if (me->query("class_score/崆峒派") < 1000) {
    message_vision(CYN "$N对$n道：“你在我门下多年，为师门所做"
      "未免太少了一些。”\n" NOR, this, me);
    if (me->query("class_score/崆峒派") > -50) {
      me->add("class_score/崆峒派", -10);
    }

    tell_object(me, "你还是先为光大师门多干点事吧！\n");
    return 0;
  }

  if (me->query_jibie("qishang-quan") > 80) {
    if (me->query("age") < 20) {
      message_vision(CYN "$N对$n说道：“你年纪轻轻就出去，人家会以为我崆峒派"
        "无人的。”\n" NOR, this, me);
      if (me->query("class_score/崆峒派") > -50) {
        me->add("class_score/崆峒派", -10);
      }
      tell_object(me, "过两年再说吧。\n");
      return 0;
    } else if (!me->query_temp("kongdong/比划成功")) {
      me->set_temp("kongdong/出师比划", 1);
      tell_object(me, "你先空手跟为师比划一下，让我看看你拳脚功夫如何了。\n");
      return 0;
    }
  } else {
    tell_object(me, "以你现在的实力，难于在江湖上独挡一面，还是跟为师再学学吧！\n");
    return 0;
  }

  return 1;
}

int talk_chushi(object me) {
  me->delete_temp("kongdong/比划成功");
  me->delete_temp("kongdong/出师比划");
  return 1;
}

int accept_betray(object me) {
  return 1;
}

int accept_fight(object ppl) {
  object this = this_object();

  if (ppl->query_temp("kongdong/出师比划")) {
    if (this->is_fighting()) {
      return notify_fail("现在木灵子不能跟你比划。\n");
    }

    if (ppl->query_temp("weapon")) {
      return notify_fail("木灵子道：“我不是让你空手跟我比划吗？”\n");
    }

    this->powerup();
    this->set("env/attack", 90);
    message_vision(CYN "$N道，“好，进招吧。”\n", this);

    return 1;
  }

  return ::accept_fight(ppl);
}

int lose_bihua(object ppl) {
  object this = this_object();

  if (ppl->query_temp("kongdong/出师比划")) {
    command("chat* haha");
    command("chat 我崆峒终于也出了一个人才。");
    command("say 真是青出于蓝胜于蓝啊，你的功夫已经比为师的高了。");
    command("say 如此，你就另谋高就去吧(再次输入chushi mu)。");
    ppl->delete_temp("kongdong/出师比划");
    ppl->set_temp("kongdong/比划成功", 1);
  }

  return 1;
}

int win_bihua(object ppl) {
  object this = this_object();

  if (ppl->query_temp("kongdong/出师比划")) {
    command("pat " + ppl->query("id"));
    command("say 看来为师的功夫还略高你一些，还够你学一阵的。");
    ppl->delete_temp("kongdong/出师比划");
    if (ppl->query("class_score/崆峒派") > -50) {
      ppl->add("class_score/崆峒派", -10);
    }
  }

  return 1;
}

void heart_beat() {
  object this, ob;
  string *bihua;

  this = this_object();
  bihua = this->query_bihua();

  foreach (string name in bihua) {
    if (objectp(ob = find_player(name)) &&
      ob->query_temp("kongdong/出师比划") &&
      ob->query_temp("weapon")) {
      if (ob->query("class_score/崆峒派") > -50) {
        ob->add("class_score/崆峒派", -100);
      }

      command("heng " + ob->query("id"));
      command("say 我不是让你空手跟我打的吗？居然敢欺骗师傅！！");
      command("stop");
    }
  }

  return ::heart_beat();
}
