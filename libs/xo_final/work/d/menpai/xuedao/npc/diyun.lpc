// This program is a part of NT MudLIB

#include <ansi.h>

inherit F_NEW_MASTER;

#include "xuedao_master.h"

void create() {
  set_name("狄云", ({ "di yun", "di", "yun" }));
  set("long",
    "他就是" + HIR "血刀门" NOR + "弟子狄云。\n"
    "他今年看起来倒满和蔼的。\n");
  set("gender", "男性");
  set("age", 30);
  set("attitude", "peaceful");
  set("shen_type", 1);
  set("str", 25);
  set("int", 25);
  set("con", 25);
  set("dex", 25);

  set("combat_exp", 5000000);

  set_wugong("mizong-neigong", 300, 300, 1);
  set_wugong("liancheng-jianfa", 300, 300, 1);
  set_wugong("shenkong-xing", 250, 250, 1);

  set_xiuwei_level_by_type("force", 5);
  set_xiuwei_level_by_type("dodge", 9);
  set_xiuwei_level_by_type("sword", 7);
  set_xiuwei_level_by_type("zonggang", 5);

  create_family("血刀门", 5, "弟子");

  ::create();
  setup();
  carry_object(SWORD_DIR "changjian")->wield();
  carry_object(CLOTH_DIR "cloth1")->wear();
}
