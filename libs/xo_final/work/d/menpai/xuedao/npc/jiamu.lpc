#include <ansi.h>

inherit F_NEW_MASTER;

#include "xuedao_master.h"

void create() {
  set_name("嘉木活佛", ({ "jiamu huofo", "huofo", "jiamu" }));
  set("long", @LONG
嘉木活佛是雪山寺有道的高僧，对佛法有精深
的研究。他身穿一件黄色袈裟，头带僧帽。目
光如电，似乎身怀绝技。
LONG);
  set("title", "雪山寺活佛");
  set("gender", "男性");
  set("class", "bonze");
  set("age", 38);
  set("attitude", "peaceful");
  set("shen_type", -1);

  set("str", 35);
  set("int", 20);
  set("con", 25);
  set("dex", 20);

  set("combat_exp", 800000);

  set_wugong("mizong-neigong", 200, 200, 1);
  set_wugong("honglian-dao", 300, 300, 1);
  set_wugong("shenkong-xing", 200, 200, 1);

  set_xiuwei_level_by_type("force", 4);
  set_xiuwei_level_by_type("dodge", 9);
  set_xiuwei_level_by_type("blade", 5);
  set_xiuwei_level_by_type("zonggang", 4);

  create_family("血刀门", 6, "弟子");

  ::create();
  setup();

  carry_object("/d/menpai/xuedao/obj/y-jiasha")->wear();
  carry_object("/d/menpai/xuedao/obj/sengmao")->wear();
}
