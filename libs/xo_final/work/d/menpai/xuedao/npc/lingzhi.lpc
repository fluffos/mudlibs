#include <ansi.h>

inherit F_NEW_MASTER;

#include "xuedao_master.h"

void create() {
  set_name("灵智上人", ({ "lingzhi shangren", "shangren", "lingzhi" }));
  set("long", @LONG
灵智上人是雪山寺中地位较高的喇嘛。
身穿一件青色袈裟，头带僧帽。
LONG
  );
  set("nickname", HIR "大手印" NOR);
  set("title", HIY "大喇嘛" NOR);
  set("gender", "男性");
  set("age", 40);
  set("attitude", "peaceful");
  set("shen_type", -1);
  set("str", 25);
  set("int", 27);
  set("con", 28);
  set("dex", 26);

  set("combat_exp", 350000);

  set_wugong("mizong-neigong", 150, 150, 1);
  set_wugong("shehe-bada", 300, 300, 1);
  set_wugong("shenkong-xing", 150, 150, 1);

  set_xiuwei_level_by_type("force", 3);
  set_xiuwei_level_by_type("dodge", 9);
  set_xiuwei_level_by_type("unarmed", 2);
  set_xiuwei_level_by_type("zonggang", 3);

  create_family("血刀门", 7, "弟子");

  ::create();
  setup();

  carry_object("/d/menpai/xuedao/obj/c-jiasha")->wear();
  carry_object("/d/menpai/xuedao/obj/sengmao")->wear();

  add_money("silver", 50);

}
