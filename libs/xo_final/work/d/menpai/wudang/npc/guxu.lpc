// guxu.c 谷虚

#include <ansi.h>

inherit F_NEW_MASTER;

#include "wudang_master.h"

string ask_me();

void create() {
  set_name("谷虚道长", ({ "guxu daozhang", "guxu", "daozhang" }));
  set("long", "他就是俞岱岩的弟子谷虚道长。\n他今年四十岁，主管武当派的俗事。\n");
  set("gender", "男性");
  set("age", 40);
  set("attitude", "peaceful");
  set("shen_type", 1);
  set("str", 22);
  set("int", 25);
  set("con", 26);
  set("dex", 23);

  set("combat_exp", 500000);

  set_wugong("daojia-xinfa", 100, 100, 1);
  set_wugong("jiben-gunfa", 300, 300, 1);
  set_wugong("staff", 300, 300, 1);
  set_wugong("juemen-gun", 300, 300, 1);
  set_wugong("laojun-zhangfa", 300, 300, 1);
  set_wugong("jiben-qinggong", 100, 100, 1);

  set_xiuwei_level_by_type("force", 3);
  set_xiuwei_level_by_type("dodge", 3);
  set_xiuwei_level_by_type("long", 4);
  set_xiuwei_level_by_type("zonggang", 3);

  set("env/wimpy", 60);
  create_family("武当派", 3, "弟子");
  set("inquiry", ([
    "道德经": (: ask_me :),
    "jing": (: ask_me :),
    "book": (: ask_me :),
  ]));

  set("book_count", 1);

  ::create();
  setup();
  carry_object(LONG_DIR "gangzhang")->wield();
  carry_object(CLOTH_DIR "dao-cloth")->wear();
  carry_object(CLOTH_DIR "dao-shoe")->wear();
}

/*
