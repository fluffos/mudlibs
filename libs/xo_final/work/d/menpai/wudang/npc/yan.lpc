// yan.c 俞岱岩

#include <ansi.h>

inherit F_NEW_MASTER;

#include "wudang_master.h"

string ask_yao1();
string ask_yao2();
void create()
{
    set_name("俞岱岩", ({ "yu daiyan", "yu" }));
    set("nickname","武当三侠");
    set("long",
        "他就是张三丰的三弟子俞岱岩。\n"
        "身穿一件干干净净的灰色道袍。\n"
        "他已年过四十，身材瘦长。恬淡冲和，沉默寡言。\n");
    set("gender", "男性");
    set("age",43);
    set("attitude", "peaceful");
    set("shen_type", 1);
    set("str", 29);
    set("int", 28);
    set("con", 31);
    set("dex", 25);

    set("combat_exp", 1450000);

    set_wugong("daojia-xinfa", 300, 300, 1);
    set_wugong("raozhi-roujian", 300, 300, 1);
    set_wugong("jiben-qinggong", 300, 300, 1);

    set_xiuwei_level_by_type("force", 5);
    set_xiuwei_level_by_type("dodge", 5);
    set_xiuwei_level_by_type("sword", 5);
    set_xiuwei_level_by_type("zonggang", 5);

    create_family("武当派", 2, "弟子");

    ::create();
    setup();
    carry_object(SWORD_DIR"changjian")->wield();
    carry_object("/d/menpai/wudang/obj/greyrobe")->wear();

}

