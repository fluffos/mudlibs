#include <ansi.h>
inherit F_FIRST;

void create() {
  set("master_dir", __DIR__ "npc" + "/zhang");
  set("start_room", "/d/menpai/wudang/guangchang");
  ::create();
}

string zm_apply() {
  object ob = this_player();
  if (query("class", ob) != "taoist") {
    return "本门修真之士，方能执掌门户！";
  }
  return ::zm_apply();
}
