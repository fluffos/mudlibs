inherit ROOM;

#include "/d/menpai/qingcheng/qc_room.h"

void create()
{
    set("short","半山亭");
    set("long", @LONG
这里有一块五丈见方的天然平整磐石，青城弟子略加整饬，在其上修建了一
座亭子，漆为红色的圆木搭起尖尖的亭盖，中央竖有一根两人合抱的松木柱子，
旁边是一圈木椅木桌，供来此的人们坐下歇息。
LONG);

    set("exits",([
        "southup"  : __DIR__"guanjing_tai",
        "westdown" : __DIR__"shanyao",
    ]));

    setup();
}

