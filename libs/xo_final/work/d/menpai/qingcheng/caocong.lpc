//   Last Modified:xli 1999.9

inherit ROAD;

void create()
{
    set("short","草丛");
    set("long", @LONG
一片杂草丛生的地方，地处青城后山，少有人迹。草间不时有虫子跳出来，
发出蟋蟋嗦嗦的响声。这里有几棵叫不上名字的树，都是自生自灭，不知已度过
多少个春秋了。草丛中间或还有些野花，点缀一下，倒也有几丝生机。
草丛中有着几棵颇为高大挺拔的古树，据说已有千年的历史。然而看那生机勃勃
的枝叶，再看那虽然粗糙，却完整得只有一些小虫眼的树皮，怎么都会使人认为
是前几年才种的。
LONG);

    set("exits",([
        "west"  : __DIR__"shandao6",
    ]));

    setup();
}

void init()
{
    add_action("do_xian", ({"xian", "bo"}));
    add_action("do_record", "record");
}

int do_xian(string arg)
{
    object me;
    me = this_player();

    if ( !arg || arg != "树皮")
    {
        return notify_fail("你要掀什么？\n");
    }

    if (! me->query("xli_marks/can_xian") )
    {
        return notify_fail("这是一棵千年的古树，怎么能随便掀开它的树皮呢？\n");
    }

    tell_object(me, "你走到古树跟前，仔细查看一番。\n");
    tell_object(me, "只觉树的背面有一块树皮很奇怪，象是被人割下来又仔细贴了上去。\n");
    tell_object(me, "你于是轻轻掀下了这块树皮，突然发现里面有字！\n");
    tell_object(me, "你定睛一看，原来正是武功〖霸业锥〗的秘诀！\n");
    tell_object(me, "你微微一笑。\n");
    tell_object(me, "你凑上前去，细细地观察上面所刻之字...\n");
    me->delete("xli_marks/can_xian");
    call_out("need_paper", 3, me);

    return 1;
}

int need_paper(object who)
{
	object me;
	me = this_player();

	if ( !me || environment(me) != this_object() || !living(me) )
	{
	    return 1;
    }

    tell_object(me, "你仰着头，还未看多久，只觉强烈的阳光使自己头昏脑胀的！\n");
    tell_object(me, "看来不能这样学的，还是想办法把这刻在树上的文字记录（record）下来吧！\n");
    me->set("xli_marks/can_record", 1);

    return 1;
}
    
int do_record(string arg)
{
    object me;
    me = this_player();

	if ( !me || environment(me) != this_object() || !living(me) )
	{
	    return 1;
	}

    if ( arg != "文字" )
    {
        tell_object(me, "你要记录什么啊？\n");
        return 1;
    }

    if ( me->query("xli_marks/can_record") == 1 )
    {
        tell_object(me,"没有纸和笔，你怎么记录啊？\n");
        return 1;
    }

    if ( me->query("xli_marks/can_zhuangding") == 1 )
    {
        tell_object(me, "你取出纸和笔，仔细地记录起来树上的文字...\n");
        me->start_busy(5);
        call_out("do_recording", 4, me);
        return 1;
    }

    tell_object(me, "记录文字？你搞错什么了吧！\n");
    return 1;
}
 
int do_recording(object who)
{
	if ( !who || environment(who) != this_object() || !living(who) )
	{
	    return 1;
	}

    tell_object(who, "你记录完树上的文字，查看了一下，然后小心翼翼地将纸和笔放回怀里。\n");
    who->delete("xli_marks/can_record");
    who->set("xli_marks/can_zhuangding", 2);      
    return 1;
}

