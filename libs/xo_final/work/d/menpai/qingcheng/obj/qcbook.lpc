// file:   qcbook.c
// name:   书(可变)
// attrib: 青城的书，记载武功 霸业锥
// write:  xli
// date:   1999.1

#include <ansi.h>
#include <mudlib.h>
#include <command.h>

inherit BOOK;
inherit F_SAVE;
//inherit F_AUTOLOAD;

void create() {
  set_name("无字天书", ({ "shu", "book" }));
  set_weight(600);

  if (clonep()) {
    set_default_object(__FILE__);
  } else {
    set("unit", "本");
    set("long", "这本书很新，上面密密麻麻记载着许多字，还有一些图画。\n");
    set("value", 10000);
    set("cant_sell", "这本书这么新，一定不是什么值钱的东西！\n");
    set("material", "paper");

    set("skill", ([
      // 提高的 技能的名字
      "name": "baye-zhui",
      // 该 player 的 xiuwei 必须大于 xiuwei_required  
      "xiuwei_required": 300,
      // 该 player 的 literate 必须大于 literate_required 
      // 否则读不懂
      "literate_required": 80,
      // 每次耗的精神 
      "gin_cost": 10 + random(10),
      // 能读到的最高的jibie
      "max_jibie": 80,
      // 如果这本书是涨 jilei 的 那么不再判断领悟比是否小于 < 90
      // 否则 就当 领悟比 < 90 必须去练了
      "bonus_jilei": 0,
      // 每次获得的xiuwei 
      "bonus_xiuwei": 1,
      // 最高可能获得的修为，就是当PLAYER的修为大于max_xiuwei
      // 就不能再涨修为了
      "max_xiuwei": 400,  // 实际这本书读起来是不会涨什么修为的
    ]));
  }
}

int query_autoload() {
  return 1;
}

varargs int move(mixed dest, int silent) {
  object env = environment();

  if (objectp(env) && env->is_character() && env->id(query("owner"))) {
    return notify_fail("这本书你好不容易才拿到的，送人多可惜啊！\n");
  }

  if (!stringp(query("owner"))) {
    set("owner", dest->query("id"));

    if (dest->query("xli_marks/bookname")) {
      set_name(dest->query("xli_marks/bookname"), ({ "shu", "book" }));
    } else {
      set_name("无字天书", ({ "shu", "book" }));
    }

    set("long", "这本书很新，上面密密麻麻记载着许多字，还有一些图画。\n");
  }

  return ::move(dest, silent);
}
