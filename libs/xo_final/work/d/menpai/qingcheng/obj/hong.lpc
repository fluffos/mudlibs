#include <weapon.h>
#include <ansi.h>
#include <mudlib.h>   
#include <command.h>

inherit SHORT;
inherit F_SAVE;
inherit F_AUTOLOAD;

void create()
{
	set_name(BLU "雷公轰" NOR, ({ "leigong hong","hong" }) );
	set_weight(1000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "套");
        set("no_drop",1);
        set("cant_sell", "小孩玩的东西能值什么钱？也拿来卖！\n");
		set("value", 1000);
		set("material", "steel");
         }
	init_short(15);
	set("wield_msg", "$N左手伸入右手衣袖，右手伸入左手衣袖，将$n取出。\n");
	set("unwield_msg", "$N将手中的$n分开放回左右衣袖内。\n");
	setup();
	
}

void init()
{
    add_action("do_drop",({"drop"}));
}

int do_drop(string arg)
{
    object me = this_player();

    if(me->is_ghost())
    {
        if(arg == "leigong hong" || arg == "hong")
        {
            move(VOID_OB);
            message_vision("$N扔下了一套"+BLU"雷公轰"NOR+"。\n",me);
        }
    }

    return 1;
}

int query_autoload()
{
    if( !this_player() ) return 0;

    if( objectp(environment())&&
          environment()->query("family/family_name") == "青城派")
    {
        set("long","
一套青城派本门使用的雷公轰，分为一柄六七寸长、锥尖曲了两曲的铁锥，
以及一个锤柄长仅及尺，锤头还没常人的拳头大的八角小锤，甚为玲珑。\n");
        return 1; 
    }
    else
    {
        return 0;
    }
}

int IsAutoLoad() { return 1; }

varargs int move(mixed dest, int silent)
{
    object env = environment();

    if ( objectp( env ) && env->is_character() && env->id( query( "owner" ) ) && !env->is_ghost() )
        return notify_fail( "这套师门兵刃可不能离身。\n");
        
    if ( !stringp( query( "owner" ) ) &&
         ( dest->query( "family/family_name" ) == "青城派" ) )
    {
        set( "owner", dest->query( "id" ) );
        set("long","
一套青城派本门使用的雷公轰，分为一柄六七寸长、锥尖曲了两曲的铁锥，
以及一个锤柄长仅及尺，锤头还没常人的拳头大的八角小锤，甚为玲珑。\n");
    }

    return ::move( dest, silent );
}

mapping GetItemInfo()
{
    return ([
        "owner" : query( "owner" ),
        "long"  : query( "long"  ),
        ]);
}

int SetItemInfo( mapping info )
{
    if ( mapp( info ) )
    {
        set( "owner",   info[ "owner" ] );
        set( "long", info[ "long" ] );
        return 1;
    }
    else if ( !info )
    {
        return 1;
    }
    else return 0;
}

