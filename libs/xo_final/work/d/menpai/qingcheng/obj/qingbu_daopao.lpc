#include <armor.h>
inherit CLOTH;

void create() {
  set_name("青布道袍", ({ "qingbu daopao", "daopao", "cloth" }));
  set_weight(500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一件普普通通的青布道袍。\n");
    set("unit", "件");
    set("value", 10);
    set("cant_sell", "青城派的破道袍也拿来卖？\n");
    set("material", "cloth");
    set("armor_prop/armor", 1);
    set("armor_prop/personality", 2);
  }
  setup();
}
