#include <ansi.h>

inherit NPC;
string do_mofang_bangmang(object);

string *mofang_things = ({
  "一袋面粉", "一袋高粱", "一袋玉米", "一袋小麦", "一袋大麦",
  "一把扫帚", "一个篮子", "一根鞭子", "一根绳子", "一块黑布",
});

string *things_where = ({
  "前殿", "后殿", "半山亭", "厢房", "松风观", "武器房", "练武厅"
});

void create() {
  set_name("白老头", ({ "bai laotou", "bai", "laotou" }));
  set("gender", "男性");
  set("age", 48);
  set("title", WHT "磨房管事" NOR);
  set("long", @LONG
他是青城派磨房的管事，在磨房里监督着几个磨房弟子工作。
LONG);
  create_family("青城派", 8, "弟子");
  set("class", "qingcheng");
  set("combat_exp", 20000);
  set("social_exp", 55000);

  set_wugong("jiben-quanfa", 80, 80, 1);

  set_wugong("songfeng-xinfa", 15, 15, 0);

  set_wugong("jiujin-ci", 35, 35, 0);
  set_wugong("zhaodi-hong", 20, 20, 1);

  set_wugong("jiben-qinggong", 40, 40, 1);

  set_xiuwei_by_type("unarmed", 150);
  set_xiuwei_by_type("short", 400);
  set_xiuwei_by_type("dodge", 80);

  set("force", 180);
  set("max_force", 180);
  set("force_factor", 10);
  set("inquiry", ([
    "帮忙": ( : do_mofang_bangmang: ),
  ]));

  setup();
  carry_object("/d/menpai/qingcheng/obj/leigong_hong")->wield();
  carry_object("/d/menpai/qingcheng/obj/qingbu_daopao")->wear();
}

string do_mofang_bangmang(object me) {
  int place;
  int now_thing;
  int things_place;
  me = this_player();

  place = me->query("xli_marks/renwu_where");
  if (!me->query("xli_marks/do_renwu"))  // 不是派来帮忙的
  {
    command("say 你真是勤快，不过磨房现在并不忙。");
    return "你就不用到这里来帮我了，还是多多练功吧！";
  }

  if (place != 2)  // 不是派到这里来的
  {
    command("say 司马掌门可没说要你到这里来帮忙啊！");
    return "是不是你记错地方了？";
  }

  if (me->query("xli_marks/finish_renwu"))  // 这个任务已经完成了
  {
    return "你已经完成司马掌门的任务了，这就回去复命吧！";
  }

  now_thing = me->query("xli_marks/now_thing");
  if (now_thing > 10) {
    now_thing = random(10);
    me->set("xli_marks/now_thing", now_thing);
  }

  if (now_thing)  // 已经给任务了
  {
    command("say 不是叫你取「" + mofang_things[now_thing - 1] + "」吗？");
    command("? " + me->query("id"));
    return "还不快去拿?";

  }

  now_thing = random(sizeof(mofang_things)) + 1;
  things_place = random(sizeof(things_where)) + 1;
  command("say 现在磨房里正缺「" + mofang_things[now_thing - 1] + "」，你就去取一下吧！");
  me->set("xli_marks/now_thing", now_thing);       // 要取的东西
  me->set("xli_marks/things_place", things_place);  // 要取的地方
  return "记得尽快拿回来。";
}

int accept_object(object ppl, object obj) {
  object me;
  me = this_player();

  if (me->query("xli_marks/renwu_where") == 2 && me->query("xli_marks/find")) {
    command("smile " + me->query("id"));
    tell_object(me, me->query("name") + "真不错，很勤快！\n");
    me->delete("xli_marks/renwu_where");
    me->delete("xli_marks/do_renwu");
    me->delete("xli_marks/now_thing");
    me->set("xli_marks/finish_renwu", 1);
    tell_object(me, "你可以回去向司马掌门复命了！\n");
    return 1;
  }

  return 0;
}
