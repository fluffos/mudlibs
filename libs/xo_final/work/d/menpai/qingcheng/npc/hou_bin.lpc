// file   : hou_bin.c
// attrib : NPC
// name   : 侯斌，青城大师兄，负责在前殿接待客人，可以发路费(小秘密)
// writer : xli
// date   : 1998.10

#include <ansi.h>
#include "sima_quest.h"

inherit F_NEW_MASTER;

void create()
{
    set_name("侯斌",({"hou bin", "hou"}));
    set("gender", "男性");
    set("age", 28);
    set("title", CYN"青城派大师兄"NOR);
    set("long",@LONG
他是青城派大师兄，名列青城四秀之首，最受师父司马卫的器重。
LONG);
    create_family("青城派", 9, "弟子");
    set("class", "qingcheng");
    set("combat_exp", 110000);
    set("social_exp", 25000);

    set_wugong("songfeng-xinfa", 250, 250, 1);

    set_wugong("jiben-quanfa", 250, 250, 0);
    set_wugong("songfeng-quan", 250, 250, 0);
    set_wugong("cuixin-zhang", 250, 250, 1);

    set_wugong("dagger", 250, 250, 0);
    set_wugong("jiujin-ci", 250, 250, 0);
    set_wugong("yunv-zhen", 300, 300, 1);

    set_wugong("jiben-qinggong", 250, 250, 0);
    set_wugong("hexiang", 250, 250, 1);

    set_xiuwei_level_by_type("unarmed", 5);
    set_xiuwei_level_by_type("short", 6);
    set_xiuwei_level_by_type("dodge", 5);
    set_xiuwei_level_by_type("force", 4);
    set_xiuwei_level_by_type("zonggang", 4);

    ::create();

    setup();
    carry_object("/d/menpai/qingcheng/obj/leigong_hong")->wield();
    carry_object("/d/menpai/qingcheng/obj/qingbu_daopao")->wear();
}

void init()
{
    ::init();
    add_action("do_ling","ling");
}

int do_ling(string arg)
{
    object givemoney,me;
    me = this_player();

    if ( !arg || arg != "路费" )
    {
        return notify_fail("你要领什么？\n");
    }

    if( me->query("xli_marks/ling_lufei") )
    {
        tell_object(me,"侯斌对你说道：师父既然派你去做事，我且按本门规矩发给你四两银子作为路费。\n");
        tell_object(me,"一个弟子从后面捧出了一个托盘，里面放着四两纹银，送到你面前。\n");
        tell_object(me,"你恭敬地向侯斌作了一个揖，伸手取了那四两银子，小心地放回袖中。\n");
        givemoney = new(MONEY_DIR"silver");
        givemoney->set_amount(4);
        givemoney->move(me);

        me->delete("xli_marks/ling_lufei");
        return 1;
    }

    return notify_fail("师父没有叫你出去做事，拿什么路费啊！\n");
}

