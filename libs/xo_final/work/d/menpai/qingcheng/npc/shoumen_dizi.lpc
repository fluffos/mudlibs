#include <ansi.h>

inherit NPC;

void create()
{
    set_name("守门弟子",({"shoumen dizi","dizi"}));
    set("long",@LONG
一位年轻的青城弟子，正站在大门旁，恭恭敬敬地迎接来访客人。
LONG);
    create_family("青城派",9,"弟子");
    set("class","qingcheng");    
    set_wugong("jiben-quanfa",80,80,0);
    set_wugong("songfeng-quan",60,60,1);
    set_wugong("cuixin-zhang",60,60,1);
    set_xiuwei_by_type("unarmed",300+random(300));
    
    set_wugong("jiujin-ci",80,80,1);
    set_xiuwei_by_type("short",100+random(200));

    set_wugong("jiben-qinggong",60,60,1);
    set_xiuwei_by_type("dodge",100+random(50));
    
    setup();
}

