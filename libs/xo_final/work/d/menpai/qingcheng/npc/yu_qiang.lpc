// file   : yu_qiang.c
// attrib : NPC
// name   : 于强   三师兄，负责在观主卧室外看守
// writer : xli
// date   : 1998.10

#include <ansi.h>
#include "sima_quest.h"

inherit F_NEW_MASTER;

void create() {
  set_name("于强", ({ "yu qiang", "yu" }));
  set("gender", "男性");
  set("age", 25);
  set("title", HIM "青城派三师兄" NOR);
  set("long", @LONG
他是青城派现任三师兄，名列青城四秀之三，武功虽不甚好，却知书达理。
LONG);
  create_family("青城派", 9, "弟子");
  set("class", "qingcheng");
  set("combat_exp", 100000);
  set("social_exp", 25000);

  set_wugong("songfeng-xinfa", 150, 150, 1);

  set_wugong("jiben-quanfa", 150, 150, 0);
  set_wugong("songfeng-quan", 150, 150, 0);
  set_wugong("cuixin-zhang", 150, 150, 1);

  set_wugong("dagger", 150, 150, 0);
  set_wugong("jiujin-ci", 150, 150, 0);
  set_wugong("zhaodi-hong", 300, 300, 1);

  set_wugong("jiben-qinggong", 150, 150, 0);
  set_wugong("hexiang", 150, 150, 1);

  set_xiuwei_level_by_type("unarmed", 3);
  set_xiuwei_level_by_type("short", 4);
  set_xiuwei_level_by_type("dodge", 3);
  set_xiuwei_level_by_type("force", 2);
  set_xiuwei_level_by_type("zonggang", 2);

  ::create();

  setup();
  carry_object("/d/menpai/qingcheng/obj/leigong_hong")->wield();
  carry_object("/d/menpai/qingcheng/obj/qingbu_daopao")->wear();
}
