#include <ansi.h>

inherit NPC;

void create()
{
    set_name("接引弟子",({"jieyin dizi","dizi"}));
    set("long",@LONG
一位年轻的青城弟子，恭恭敬敬地站在那里。
LONG);
    if(random(3)>0)
        set("gender","男性");
    else
        set("gender","女性");
    set("age",22);
    create_family("青城派",9,"弟子");
    set("class","qingcheng");    
    set_wugong("unarmed",100,100,1);
    setup();
}

void init()
{   
    if(this_player()->query("family/family_name") != "青城派" )
    {
        call_out("greet_me",1,this_player());
    }
}

void greet_me(object me)
{
    if( me && environment(me) == environment(this_object()) )
    {
        tell_object(me,CYN"接引弟子说道：客人累了可以进厢房歇息。\n"NOR);
    }
}

