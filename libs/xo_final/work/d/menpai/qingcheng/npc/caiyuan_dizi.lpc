#include <ansi.h>

inherit NPC;

void create() {
  set_name("菜园弟子", ({ "caiyuan dizi", "dizi" }));
  set("long", @LONG
一位年轻的青城弟子，正在菜园里辛勤地种着菜。
LONG);
  if (random(3) > 0) {
    set("gender", "男性");
  } else {
    set("gender", "女性");
  }
  set("age", 22);
  create_family("青城派", 9, "弟子");
  set("class", "qingcheng");
  setup();
}
