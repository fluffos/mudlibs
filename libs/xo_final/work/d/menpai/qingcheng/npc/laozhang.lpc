#include <ansi.h>

inherit NPC;

void create() {
  set_name("老张", ({ "lao zhang", "zhang" }));
  set("gender", "男性");
  set("age", 64);
  set("title", HIY "武器房管事" NOR);
  set("long", @LONG
他是青城派武器房的管事，负责将武器发放给各个弟子。他已不问江湖多年，
然而青城的弟子还是对他非常尊重，因为据说他是现任掌门的师兄。
LONG);
  create_family("青城派", 8, "掌门师兄");
  set("class", "qingcheng");
  set("combat_exp", 120000);
  set("social_exp", 75000);

  set_wugong("jiben-quanfa", 70, 70, 0);
  set_wugong("songfeng-quan", 65, 65, 1);
  set_wugong("cuixin-zhang", 65, 65, 1);

  set_wugong("songfeng-xinfa", 35, 35, 0);

  set_wugong("jiujin-ci", 85, 85, 0);
  set_wugong("zhaodi-hong", 55, 55, 0);
  set_wugong("shier-po", 70, 70, 0);
  set_wugong("yunv-zhen", 85, 85, 1);

  set_xiuwei_by_type("unarmed", 120);
  set_xiuwei_by_type("short", 310);
  set_xiuwei_by_type("dodge", 240);

  set("force", 400);
  set("max_force", 400);
  set("force_factor", 25);
  setup();
  carry_object("/d/menpai/qingcheng/obj/leigong_hong")->wield();
  carry_object("/d/menpai/qingcheng/obj/qingbu_daopao")->wear();
}

void init() {
  if (this_player()->query("family/family_name") == "青城派") {
    add_action("do_ling", "ling");

    remove_call_out("greet_me");
    call_out("greet_me", 1, this_player());
  }
}

int greet_me(object me) {
  if (me && present(me, environment(this_object())) && (me->query("family/family_name") == "青城派")
    && (me->query("xli_marks/ling_num") == 10)) {
    tell_object(me, "老张看了看你，说道：你可是来这里领取(ling)我青城独门兵刃雷公轰的？\n");
  }

  return 1;
}

int do_ling(string arg) {
  object me, wuqi;
  int lingnum;
  me = this_player();

  lingnum = me->query("xli_marks/ling_num");

  if (!arg) {
    return notify_fail("你想领什么？\n");
  }

  if (me->query("family/family_name") != "青城派") {
    return notify_fail("你不是我青城弟子，怎么能领我青城独门兵刃呢？\n");
  }

  if (arg != "兵刃" && arg != "bingren" && arg != "雷公轰" && arg != "leigong hong" && arg != "hong") {
    return notify_fail("我这里除了我青城派的雷公轰，并无它物了。\n");
  }

  message_vision(YEL @MSG
$N向老张恭敬地作了一个揖，问道：
不知张管事可否让我领一套本门兵刃雷公轰？
MSG NOR, me);

  if (objectp(present("leigong hong", me))) {
    return notify_fail("老张看了看你，说道：你不是已经有雷公轰了吗？\n");
  }

  if (lingnum == 0) {
    return notify_fail("老张微有愠色：本门发给弟子的兵刃是有数的，你已无权领取了。\n");
  }

  if (lingnum == 10) {
    message_vision(BLU @MSG
老张对$N说道：头一次领取雷公轰，我须得将本门武器领取之规矩对你说清楚:
雷公轰领取后，即只为你自己所用，应倍加爱惜，不要随意损坏了。本门发给各个
弟子的兵刃是有限数的，从此以后，你只有九次在我这里领取雷公轰的机会，过后
即不可再领取了。
MSG NOR, me);
  }

  message_vision("老张将贴有『" + me->query("name") + "』名字的小抽屉打开，取出一套雷公轰。\n", me);
  message_vision("老张将它交给了$N\n", me);
  wuqi = new("/d/menpai/qingcheng/obj/leigong_hong");
  wuqi->move(me);
  message_vision("$N双手接过了雷公轰，说道：谢谢张总管！\n", me);
  command("smile " + me->query("id"));
  me->set("xli_marks/ling_num", lingnum - 1);
  return 1;
}
