// file   : fang_jin.c
// attrib : NPC
// name   : 方晋   二师兄，负责在练武厅指导其它弟子
// writer : xli
// date   : 1998.10

#include <ansi.h>
#include "sima_quest.h"

inherit F_NEW_MASTER;

void create()
{
    set_name("方晋",({"fang jin", "fang"}));
    set("gender", "男性");
    set("age", 25);
    set("title", HIY"青城派二师兄"NOR);
    set("long",@LONG
他是青城派二师兄，名列青城四秀之二，武功却是四人中最好的。
LONG);
    create_family("青城派", 9, "弟子");
    set("class", "qingcheng");
    set("combat_exp", 100000);
    set("social_exp", 25000);
    
    set_wugong("songfeng-xinfa", 200, 200, 1);

    set_wugong("jiben-quanfa", 200, 200, 0);
    set_wugong("songfeng-quan", 200, 200, 0);
    set_wugong("cuixin-zhang", 200, 200, 1);

    set_wugong("dagger", 200, 200, 0);
    set_wugong("jiujin-ci", 200, 200, 0);
    set_wugong("shier-po", 300, 300, 1);

    set_wugong("jiben-qinggong", 200, 200, 0);
    set_wugong("hexiang", 200, 200, 1);

    set_xiuwei_level_by_type("unarmed", 4);
    set_xiuwei_level_by_type("short", 5);
    set_xiuwei_level_by_type("dodge", 4);
    set_xiuwei_level_by_type("force", 3);
    set_xiuwei_level_by_type("zonggang", 3);

    ::create();

    setup();
    carry_object("/d/menpai/qingcheng/obj/leigong_hong")->wield();
    carry_object("/d/menpai/qingcheng/obj/qingbu_daopao")->wear();
}

