// file   : luo_xuan.c
// attrib : NPC
// name   : 罗煊  四师兄，在大理城内闲逛，有关于他的小秘密
// writer : xli
// date   : 1998.10

#include <ansi.h>
#include "sima_quest.h"

inherit F_NEW_MASTER;

void create() {
  set_name("罗煊", ({ "luo xuan", "luo" }));
  set("gender", "男性");
  set("age", 24);
  set("title", GRN "青城派四师兄" NOR);
  set("long", @LONG
他是青城派现任四师兄，名列青城四秀之末，却因带艺拜师，武功颇不凡。
LONG);
  create_family("青城派", 9, "弟子");
  set("class", "qingcheng");
  set("combat_exp", 150000);
  set("social_exp", 30000);

  set_wugong("songfeng-xinfa", 100, 100, 1);

  set_wugong("jiben-quanfa", 100, 100, 0);
  set_wugong("songfeng-quan", 100, 100, 0);
  set_wugong("cuixin-zhang", 100, 100, 1);

  set_wugong("dagger", 100, 100, 0);
  set_wugong("jiujin-ci", 100, 100, 0);
  set_wugong("tianbo-ci", 300, 300, 1);

  set_wugong("jiben-qinggong", 100, 100, 0);
  set_wugong("hexiang", 100, 100, 1);

  set_wugong("blade", 100, 100, 0);
  set_wugong("ditang-dao", 300, 300, 1);

  set_xiuwei_level_by_type("unarmed", 2);
  set_xiuwei_level_by_type("short", 3);
  set_xiuwei_level_by_type("blade", 2);
  set_xiuwei_level_by_type("dodge", 2);
  set_xiuwei_level_by_type("force", 1);
  set_xiuwei_level_by_type("zonggang", 1);

  ::create();

  setup();
  carry_object("/d/menpai/qingcheng/obj/leigong_hong")->wield();
  carry_object("/d/menpai/qingcheng/obj/qingbu_daopao")->wear();
}
