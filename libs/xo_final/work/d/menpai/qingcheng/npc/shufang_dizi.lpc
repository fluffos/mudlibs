#include <ansi.h>

inherit NPC;

void create()
{
    set_name("书房弟子", ({"shufang dizi","dizi"}));
    set("long",@LONG
一位年轻的青城弟子，恭恭敬敬地站在那里。
LONG);

    if ( random(3) > 0 )
    {
        set("gender","男性");
    }
    else
    {
        set("gender","女性");
    }
    set("age", 22);
    create_family("青城派", 9, "弟子");
    set("class", "qingcheng");    
    setup();
}

void init()
{   
    if ( this_player()->query("family/family_name") == "青城派" )
    {
        call_out("greet_me", 1, this_player());
    }
}

void greet_me(object me)
{
    if ( !me || environment(me) != environment(this_object()) )
    {
        return;
    }

    if ( me->query("xli_marks/can_record") )
    {
       tell_object(me, CYN"书房弟子说道：书房里笔墨纸砚齐全，需要的话，可以领取使用（ling 纸)。\n"NOR);
    }

    if ( me->query("xli_marks/can_zhuangding") == 2 )
    {
       tell_object(me, CYN"书房弟子说道：有什么零散的纸张需要订成书的可以在这里装订（zhuangding 书名 )。\n"NOR);
    }
}

