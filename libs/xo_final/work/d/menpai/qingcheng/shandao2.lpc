inherit ROAD;

void create() {
  set("short", "山道");
  set("long", @LONG
一条曲折的山道，一眼看不到头，走的人多了，石面已经非常光滑了。旁边
杂草丛生，野花处处，时有野兔等窜出。夏夜还能听到蛐蛐在草丛中低鸣，甚为
清净闲适。
LONG);

  set("exits", ([
    "eastdown": __DIR__ "guanjing_tai",
    "southup": __DIR__ "shandao3",
  ]));

  setup();
}
