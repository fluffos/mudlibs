inherit ROAD;

void create() {
  set("short", "林荫道");
  set("long", @LONG
一条碎石铺成的小道，两边种植了许多柳树，微风拂柳之时，树影婆娑，让
人顿觉心底一片空明，格外舒畅。青城弟子常于闲时来此处休憩散心，以稍解一
身的疲劳。道旁有些石椅石凳，几个弟子正在坐着闲聊。
LONG);

  set("exits", ([
    "north": __DIR__ "xiangfang",
    "south": __DIR__ "huilang",
  ]));

  set("objects", ([
    __DIR__ "npc/jieyin_dizi": 1 + random(2),
  ]));

  setup();
}
