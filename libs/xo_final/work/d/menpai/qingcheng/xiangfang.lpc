inherit SLEEP_ROOM;

#include "/d/menpai/qingcheng/qc_room.h"

void create()
{
    set("short","厢房");
    set("long", @LONG
这里是青城派的厢房，供来访客人休息和住宿。房间里摆着一张整洁的床，
一个床头柜，几盆君子兰摆放在各个角落里，靠墙放着一个架子，上面是供客人
们洗漱的用具。房间朴素简单，但井井有条，也显出青城派待客的尊敬与细致。
LONG);

    set("exits",([
        "south"  : __DIR__"linyin_dao1",
    ]));

    ::create();
