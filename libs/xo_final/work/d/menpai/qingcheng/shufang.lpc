//   file  :   shufang.c
//   attrib:   room
//   name  :   书房
//   writer:   xli
//   date  :   1999.1
//   Last Modified:xli 1999.9

inherit ROOM;

void create()
{
    set("short","书房");
    set("long", @LONG
这里就是青城派的书房。房里物事甚为简单，一张八仙木桌，旁边摆着几个
凳子，桌子上备有纸张和几支笔，以供本门弟子在需要的时候领取使用。两个书
房弟子恭敬地站在桌子旁边。
LONG);

    set("objects", ([
        __DIR__"npc/shufang_dizi" : 2,
    ]));

    set("exits",([
        "south" : __DIR__"qiandian",
    ]));

    setup();
}

void init()
{
    add_action("do_ling", "ling");
    add_action("do_zhuangding", "zhuangding");
}

int do_ling(string arg)
{
    object me;
    me = this_player();

    if ( !arg || arg!="纸" )
    {
        return notify_fail("书房弟子说道：这里没有"+arg+"这样东西。\n");
    }

    if ( !me->query("xli_marks/can_record" ) )
    {
        return notify_fail("书房弟子说道：这里的纸笔是供需要的时候给的，你拿来干什么？\n");
    }

    tell_object(me, "书房弟子从桌子上拿出一叠纸和一只笔，递给了你。\n");
    tell_object(me, "你将纸笔放入怀里。\n");
    me->delete("xli_marks/can_record");
    me->set("xli_marks/can_zhuangding", 1);
    return 1;
    
}
        
int do_zhuangding(string arg)
{
    object me;
    me = this_player();

    if ( !arg )
    {
        tell_object(me, "书房弟子问道：你要装订的书的书名是什么？\n");
        return 1;
    }

    if ( me->query("xli_marks/can_zhuangding") == 1 )
    {
        tell_object(me,"书房弟子对你笑道：你这些白纸，难道要订成本『无字天书』吗？\n");
        return 1;
    }

    if ( me->query("xli_marks/can_zhuangding") == 2 )
    {
        tell_object(me, "书房弟子恭恭敬敬地接过你记满文字的纸，交给一个下人，拿到里面装订去了。\n");
        tell_object(me, "一位中年人迅速向里面走去...\n");
        me->delete("xli_marks/can_zhuangding");
        me->start_busy(10);
        call_out("do_giveshu", 8, me, arg);
        return 1;
    }

    tell_object(me,"书房弟子问道：你要装订什么啊？\n");
    return 1;     
}

int do_giveshu(object me, string bookname)
{
    object yourbook;

    if ( !me || environment(me) != this_object() )
    {
        return 1;
    }

    tell_object(me, "一个下人将一本装订好的书交给了书房弟子。\n");
    tell_object(me, "书房弟子将书交到你的手上。\n");

    yourbook = new(__DIR__"obj/qcbook");
    yourbook->set("name", bookname);

    me->set("xli_marks/bookname", bookname);
    yourbook->move(me);

    return 1;
}

