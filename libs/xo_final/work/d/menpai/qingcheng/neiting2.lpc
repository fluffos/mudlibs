//   file  :   neiting1.c
//   attrib:   room of QingCheng
//   name  :   流云厅 参修“城字十二破”(shier-po)
//   writer:   xli
//   date  :   1998.11       
//   last modify:xli 1998.12

#include <ansi.h>
inherit ROOM;

void create() {
  set("short", "流云厅");
  set("long", @LONG
这里是青城派的流云厅，地方不大，无甚设施，只有四面墙上点着几根松明
火把，用以照亮。火光之间，只见粉白的墙上整齐地画着许多图形，仔细看去，
皆为两人对战的情形，你来我往，一幅幅看去，只觉其中的众多奥妙菲夷所思，
果然是青城武功的精要所在。
LONG);
  set("no_fight", 1);
  set("exits", ([
    "west": __DIR__ "liangong_fang",
  ]));

  set("not_startroom", 1);
  setup();
}

void init() {
  object me;

  me = this_player();

  if (me->query_temp("xli_marks/can_canxiu")) {
    add_action("do_canxiu", "canxiu");
  }

  add_action("do_quit", "quit");
}

int do_quit(string arg) {
  tell_object(this_player(), "你正在内厅里练功，怎么能随便出去呢？\n");
  return 1;
}

int do_canxiu(string arg) {
  object me, ob;
  me = this_player();

  if (!me->query_temp("xli_marks/can_canxiu")) {
    return notify_fail("一个弟子在外面大声说道：你本次参修时间已到，就请出来吧！\n");
  }

  if (me->query_temp("canxiu/shier-po")) {
    return notify_fail("你不是已经在参修了！\n");
  }

  if (arg) {
    return notify_fail(arg + "这个东西你如何参修得了？真是莫名其妙！\n");
  }

  if (me->query("gin") < 30) {
    return notify_fail("你现在无法集中精神来参修。\n");
  }

  if (!me->can_act() || me->is_fighting()) {
    return notify_fail("你现在无法静下心来参修武功。\n");
  }

  ob = me->query_temp("weapon");
  if (!ob || (string)ob->query("weapon_type") != "short" ||
    (string)ob->query("name") != BLU "雷公轰" NOR) {
    return notify_fail("参修青城派武功怎么能不携带我青城独门兵器" + BLU "雷公轰" NOR + "呢？\n");
  }

  me->set_temp("canxiu/shier-po", 1);

  tell_object(me, "你踱到墙边，开始一幅幅仔细观看上面的对战图。\n");
  tell_object(me, "原来上面所绘两人所用武功为青城派的「城字十二破」，不禁凑近了一些......\n");
  // me->disable_command("verb", "你正在参修青城武功，可不要为外事所打扰！\n");

  //remove_call_out("start_canxiu");
  call_out("start_canxiu", 5, me);

  return 1;
}

int start_canxiu(object who) {
  int jibie;
  int times;

  if (!who || environment(who) != this_object()) {
    return 1;
  }

  jibie = who->query_jibie("shier-po");
  times = jibie / 10;
  tell_object(who, "你边看边想，不知不觉从袖中取出" + BLU "雷公轰" NOR + "，跟着墙上的图形比划了起来......\n");

  //remove_call_out("start_bihua");
  call_out("start_bihua", 5, who, times);

  return 1;
}

int start_bihua(object who, int times) {
  int add_xiuwei;
  int add_lingwu;  // 加领悟的级别和修为
  int now_lingwu;
  int now_gin;

  if (!who || environment(who) != this_object()) {
    return 1;
  }

  if (times > 0) {
    tell_object(who, "你将所学的「城字十二破」各招式施展出来，然后和墙上所绘进行对照。\n");
    tell_object(who, "只觉平时许多不懂之处，在此一参修，顿时豁然开朗，颇有收益！\n\n");

    call_out("start_bihua", 5, who, times - 1);
    return 1;
  }

  who->delete_temp("canxiu/shier-po");

  now_lingwu = who->query_lingwu("shier-po");
  now_gin = who->query("gin");

  tell_object(who, HIM "\n你停手收势，将刚才所学细细回味归纳，反复推敲。\n" NOR);
  tell_object(who, HIM "只觉倘若临敌，施展「城字十二破」必会更加得心应手!\n" NOR);

  add_xiuwei = 0;
  add_lingwu = 3 - sqrt(now_lingwu / 20) + random(who->query("int") / 20);
  who->improve_xiuwei("short", add_xiuwei);
  who->improve_lingwu("shier-po", add_lingwu);
  who->set("gin", now_gin / 3);

  tell_object(who, CYN "\n你的「城字十二破」这门武功又上了一层楼！\n" NOR);

  return 1;
}

int valid_leave(object me, string dir) {
  if (!me->can_act() || me->is_fighting()) {
    return notify_fail("你现在正在参修，不能随便走动。\n");
  }

  if (me->query_temp("canxiu/shier-po")) {
    return notify_fail("你还没参修完呢。\n");
  }

  me->delete_temp("canxiu/shier-po");
  me->delete_temp("xli_marks/can_canxiu");

  return ::valid_leave(me, dir);
}
