//   file  :   pianfang.c
//   attrib:   room of QingCheng
//   name  :   偏房
//   writer:   xli
//   date  :   1998.10
//   这里和完成青城的任务有关，在这里品茶(pin cha)，有机会得到两个青城弟子的提示。
//   Last Modified:xli 1999.9

inherit ROOM;

string *things_where = ({
  "前殿", "后殿", "半山亭", "厢房", "松风观", "武器房", "练武厅"
});
string *caiyuan_things = ({
  "一包白菜籽", "一包萝卜籽", "一包青菜籽", "一包西瓜籽", "一包苹果籽", "一袋桃子核",
  "一把锄头", "一个菜篮", "一把铲子", "一架梯子", "一把砍刀", "一根草绳",
});
string *mofang_things = ({
  "一袋面粉", "一袋高粱", "一袋玉米", "一袋小麦", "一袋大麦",
  "一把扫帚", "一个篮子", "一根鞭子", "一根绳子", "一块黑布",
});
string *chufang_things = ({
  "一袋面粉", "一袋小米", "一袋大米",
  "一袋白菜", "一袋青菜", "一块豆腐",
  "一把扫帚", "一个篮子", "一把菜刀",
});

void create() {
  set("short", "偏房");
  set("long", @LONG
这里是青城派松风观的偏房，中央放置着一张紫檀木的方桌，旁边围绕着几
个圆木凳子，桌上放着一套苏州无锡制造的茶壶茶杯，非常精致。青城派的弟子
有时到这里来喝茶聊天，两个茶童不时来续水。这里是品茶的好地方！
LONG);

  set("exits", ([
    "south": __DIR__ "songfeng_guan",
  ]));

  setup();
}

void init() {
  add_action("do_pin", "pin");
}

int do_pin(string arg) {
  object me;
  int place;
  int thing;
  int renwu_where;
  string renwu_thing;
  string renwu_place;
  string *cha_name = ({ "龙井", "茉莉", "冰片", "磨锅", "菊花", "绿茶" });
  string *buyman_first = ({ "王", "赵", "刘", "李", "陈" });
  string *buyman_second = ({ "二", "三", "四", "五", "六" });

  me = this_player();
  place = me->query("xli_marks/things_place");
  thing = me->query("xli_marks/now_thing");

  if (!arg || (arg != "cha" && arg != "茶")) {
    return notify_fail("你要干什么？\n");
  }

  if (me->query("xli_marks/have_pin")) {
    return notify_fail("你刚品过了茶，又来干什么啊？\n");
  }

  me->set("xli_marks/have_pin", 1);
  message_vision("$N从桌上端起一杯" + cha_name[random(sizeof(cha_name))] +
    "，轻轻地抿了一小口。\n", me);
  message_vision("$N只觉香气扑鼻，入口滑润，心神顿时为之一振。\n", me);

  renwu_where = me->query("xli_marks/renwu_where");
  if (!renwu_where || !place || !thing) {
    return 1;
  }

  renwu_place = things_where[place - 1];
  if (renwu_where == 1) {
    renwu_thing = chufang_things[thing - 1];
  }
  if (renwu_where == 2) {
    renwu_thing = mofang_things[thing - 1];
  }
  if (renwu_where == 3) {
    renwu_thing = caiyuan_things[thing - 1];
  }

  me->start_busy(2);

  if (random(10) > 2) {
    tell_object(me, "这时两个青城弟子走了进来，坐在你旁边的桌子旁。\n");
    tell_object(me, "他们一人拿起一杯" + cha_name[random(sizeof(cha_name))] +
      "，一边品茶，一边聊天。\n");

    if (random(10) > 2) {
      tell_object(me, "只听其中一个弟子说道：昨天看见"
        +buyman_first[random(sizeof(buyman_first))]
        +buyman_second[random(sizeof(buyman_second))]
        + "下山，是不是又买什么去了？\n");
      tell_object(me, "另一个弟子说道：是啊，我今天早上看见他回来了。\n"
        + "买了很多东西，其中好象有" + renwu_thing + "，就放在" + renwu_place + "。\n");
    }
  }

  return 1;
}
