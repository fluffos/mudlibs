inherit ROAD;

void create() {
  set("short", "小径");
  set("long", @LONG
一条笔直的小径，十多级条石台阶削凿得整整齐齐，因常年踩踏，每个台阶
的中部都微微向下凹进。东边尽头就是青城派的山门，青城弟子经常沿着这条小
径下山，每年走过这里进入青城的游客也是非常多的。
LONG);

  set("exits", ([
    "east": __DIR__ "shanmen",
    "westdown": __DIR__ "shandao3",
  ]));

  setup();
}
