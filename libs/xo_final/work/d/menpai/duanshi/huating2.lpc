// room:/d/menpai/duanshi/huating2.c  writen by lala Aug-1-97

#include <room.h>
#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "花厅");
  set("long", @LONG
花厅打扫得干干净净，墙上挂着字画，桌子上摆着汝窑插瓶，青瓷茶壶，临
窗小几上摆着一盆茶花，娇艳夺目；这里是王府上供客人住宿的地方。房间中央
有一张舒服的大床，床上铺着崭新的被褥。一名侍女站在床旁边。
LONG
  );
  set("exits", ([
    "south": __DIR__ "ceting1",
  ]));
  set("objects", ([
    __DIR__ "npc/shinv": 1,
  ]));
  set("sleep_room", "inn");
  set("no_fight", 1);
  setup();
}

void init() {
  add_action("check_sleep", "sleep");
}

int check_sleep() {
  object ob, me = this_player();
  if (me->query("class") == "duanshi") {
    tell_object(me, "这里不是让你睡的地方。\n");
    return 1;
  }
  if ((ob = present("shi nv", this_object())) && (ob->can_act())) {
    message_vision("$N莞尔一笑对$n说：“婢子服侍您就寝。”说完很快铺好了床铺。\n", ob, me);
  }
  return 0;
}
