#include <room.h>
#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "井房");
  set("long", @LONG
这里是小厨房后面，有一间井房，平时只有王府里有身份的人才吃这里的水。
井房正中的青石栏围着一眼井，四周是大理石铺地，但因为怕水打湿了地面滑脚，
所以从井到门口铺了一条地毯。
LONG
  );
  set("exits", ([
    "west": __DIR__ "xiaochufang",
  ]));
  set("resource/water", 1);
  set("fillplace", "水井");
  set("watername", "甘甜阴凉的井水");
  set("outdoors", "dali");
  setup();
}
