inherit ROOM;

void create()
{
	set("short", "王府大院");
	set("long", @LONG
这里是镇南王府的大院，当面一堵宽阔的白玉照壁，上书“忠心报国”四个
大字，落款是当今大理皇帝段正明，一色的青砖铺地，有几个仆役正在院中洒扫，
北面是王府的门厅，东面是对称的另外一座牌楼，南面是个小院。
LONG
	);
    set("exits", ([ 
	        "south"  : __DIR__"qianyuan",
	        "north"  : __DIR__"menting",
	        "west"  : __DIR__"wangfu_pailou",
	        "east"  : __DIR__"wangfu_pailou2",
        ]));
	set("objects", ([
			__DIR__"npc/jiading3" : 3,
		]));	
	set("item_desc", ([
			"west" : "只见一座雕刻着二龙抢珠的绿琉璃瓦朱红影壁墙严严实实地挡住了你的视线。\n",
			"east" : "只见一座雕刻着二龙抢珠的绿琉璃瓦朱红影壁墙严严实实地挡住了你的视线。\n",
			"north" : "只见一座雕刻着九条苍龙的绿琉璃瓦朱红影壁墙严严实实地挡住了你的视线。\n",
			"south" : "只见一座雕刻着一条穿云飞龙的绿琉璃瓦朱红影壁墙严严实实地挡住了你的视线。\n",
		]));
	set("outdoors", "dali");
	setup();
	//place_program(ROOM);
