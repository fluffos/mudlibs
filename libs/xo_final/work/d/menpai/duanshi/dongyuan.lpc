int valid_leave(object me, string dir)
{
        object ob, here=this_object();

        if (dir=="north" 
                && ( ob=present("zhu danchen", here) || ob=present("wei shi") )
                && ( ob->can_act() ) )
        {
                message_vision("$N喝道：“这位"+RANK_D->query_respect(me)+
                "，此处是王世子居住的地方，不经允许不得擅入！”\n", ob, me);
                return notify_fail("");
        }
        return ::valid_leave(me, dir);
}
