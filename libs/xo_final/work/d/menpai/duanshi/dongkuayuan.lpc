#include <room.h>
#include <ansi.h>

inherit ROOM;

void create()
{
	set("short", "东跨院");
	set("long", @LONG
这里是镇南王府的东跨院。王府在这里养着各种动物，有各种好马、打猎用
的猎犬和猎鹰以及用于传信的信鸽。这个院子里人声嘈杂，不时有家丁拉着客人
的马匹到马厩里来，也有几个家丁在训练猎鹰。
LONG
	);
    set("exits", ([ 
	        "southeast"  : __DIR__"ge_fang",
	        "southwest"  : __DIR__"ying_fang",
	        "east"       : __DIR__"zhufang1",
			"west"       : __DIR__"yueliang_men4",
			"northeast"  : __DIR__"gou_fang",
			"northwest"  : __DIR__"ma_jiu",
        ]));
	set("objects", ([
			__DIR__"npc/jiading3" : random(4),
		]));
	set("outdoors", "dali");
	setup();
}                       

