// NPC: /d/menpai/duanshi/npc/fan_hua.c
// By lala on July 12, 97

inherit F_NEW_MASTER;

#include <ansi.h>
#include "duanshi_master.h"

void create() {
  set_name("范骅", ({ "fan hua", "fan", "hua" }));
  set("title", CYN "大理国" RED "司马" NOR);
  set("gender", "男性");
  set("age", 43);
  set("attitude", "peaceful");
  set("class", "duanshi");
  set("long", @LONG
范骅官居大理三公之一的司马之位，深得保定帝的信任，视之如左膀右臂。
他与华赫艮、巴天石可以说是生死之交。他的刀法在三人中为最高，故担
任了大理最高军事长官。
LONG);
  set("str", 25);
  set("int", 26);
  set("spi", 27);
  set("con", 28);
  set("cps", 29);
  set("cor", 30);
  set("per", 15);

  set("rank_info/respect", "司马大人");

  set("class_score/镇南王府", 2000);
  set("combat_exp", 100000);
  set("social_exp", 500000);
  set("positive_score", 50000);

  set_wugong("duanshi-neigong", 200, 200, 1);
  set_wugong("huzhua-gong", 300, 300, 1);
  set_wugong("yanbodiaoke", 300, 300, 1);
  set_wugong("meihua-bu", 200, 200, 1);

  set_xiuwei_level_by_type("force", 4);
  set_xiuwei_level_by_type("unarmed", 4);
  set_xiuwei_level_by_type("long", 4);
  set_xiuwei_level_by_type("dodge", 4);
  set_xiuwei_level_by_type("zonggang", 4);

  create_family("镇南王府", 1, "司马");

  ::create();
  setup();

  carry_object(CLONE_DIR "wear/boots/wuyun_xue")->wear();
  carry_object(CLONE_DIR "wear/waist/chahe_luandai")->wear();
  carry_object(CLONE_DIR "wear/cloth/baizhu_sipao")->wear();
  carry_object(CLONE_DIR "wear/head/qingsha_jin")->wear();
}

#include "sangong.h"
