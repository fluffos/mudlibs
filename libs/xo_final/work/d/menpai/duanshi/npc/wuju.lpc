// NPC: /d/city/dali/npc/wuju.c

inherit F_NEW_MASTER;

#include <ansi.h>
#include "duanshi_master.h"

int change_dengji();

void create() {
  set_name("段无惧", ({ "duan wuju", "duan", "wuju" }));
  set("title", "镇南王府大管事");
  set("gender", "男性");
  set("age", 34);
  set("attitude", "peaceful");
  set("class", "duanshi");
  set("long", @LONG
段无惧是大理镇南王府的大管事，三十多岁，是段无畏的孪生兄弟。兄弟两个
都是从小在王府当差的，现在他主要负责府内的家丁管理和升级工作。
LONG);
  set("str", 28);
  set("int", 30);
  set("spi", 30);
  set("con", 30);
  set("cps", 30);
  set("cor", 20);

  set("combat_exp", 10000);
  set("score", 2000);

  set("inquiry", ([
    "升级": (: change_dengji :),
  ]));

  set_wugong("duanshi-neigong", 100, 100, 1);
  set_wugong("jiben-qinggong", 300, 300, 1);
  set_wugong("blade", 300, 300, 1);
  set_wugong("shenxing", 300, 300, 1);

  set_xiuwei_level_by_type("force", 2);
  set_xiuwei_level_by_type("blade", 1);
  set_xiuwei_level_by_type("dodge", 3);
  set_xiuwei_level_by_type("zonggang", 2);

  create_family("镇南王府", 1, "管事");

  ::create();
  setup();
  carry_object(CLOTH_DIR "baiduan_shan")->wear();
  carry_object(__DIR__ "obj/finger")->wear();
  carry_object(__DIR__ "obj/blade");
}

int refuse_killing(object me) {
  command("wield blade");
  me->apply_condition("kill_dali", 200);
  return 0;
}

int change_dengji() {
  object me;

  me = this_player();
  if (me->query("class") == ("duanshi")) {
    if (!me->query_temp("marks/问过升级")) {
      if (((me->query("class_score/镇南王府") <= 350)
        && (me->query("title") == "镇南王府家丁"))
        || ((me->query("class_score/镇南王府") <= 600)
          && (me->query("title") == BLU "镇南王府家丁" NOR))
        || ((me->query("class_score/镇南王府") <= 150)
          && (me->query("title") == "镇南王府见习家丁"))) {
        message_vision(HIW "$N对$n很不满意：“你为王府尽忠了吗？我看你做得很不够啊" +
          "。”\n" NOR, this_object(), me);
        me->set_temp("marks/问过升级", 1);
      }
      if ((me->query("title") == CYN "镇南王府家丁" NOR)) {
        message_vision(HIM "$N对$n摇摇头：“嗯，你已经升到家丁的头儿了，再要升级，就要当卫士了" +
          "，\n那个事可不是我管的。你去找家兄问问看他能不能推荐一下吧。”\n" NOR, this_object(), me);
        me->set_temp("marks/问过升级", 1);
      }
      if ((me->query("class_score/镇南王府") > 600)
        && (me->query("title") == BLU "镇南王府家丁" NOR)) {
        if (random(5) > 3) {
          message_vision(GRN "$N对$n点点头：“嗯，既然你已经为王府尽力很久" +
            "，王府也不会亏待你。\n从今日起，给你升级一等。”\n" NOR, this_object(), me);
          me->set("title", CYN "镇南王府家丁" NOR);
          me->set_temp("marks/问过升级", 1);
        } else {
          message_vision(HIY "$N漫不经心地看了看$n：“噢～～这个么，咱们身为" +
            "王府下人，主要考虑的应该是怎么给王爷尽忠。\n现在府上没有空名额，" +
            "你升级的事啊，等等再说。”\n" NOR, this_object(), me);
          me->set_temp("marks/问过升级", 1);
        }
      }
      if ((me->query("class_score/镇南王府") > 350)
        && (me->query("title") == "镇南王府家丁")) {
        if (random(5) > 2) {
          message_vision(GRN "$N对$n点点头：“嗯，既然你已经为王府尽力很久" +
            "，王府也不会亏待你。\n从今日起，给你升级一等。”\n" NOR, this_object(), me);
          me->set("title", BLU "镇南王府家丁" NOR);
          me->set_temp("marks/问过升级", 1);
        } else {
          message_vision(HIY "$N漫不经心地看了看$n：“噢～～这个么，咱们身为" +
            "王府下人，主要考虑的应该是怎么给王爷尽忠。\n现在府上没有空名额，" +
            "你升级的事啊，等等再说。”\n" NOR, this_object(), me);
          me->set_temp("marks/问过升级", 1);
        }
      }
      if ((me->query("class_score/镇南王府") > 150)
        && (me->query("title") == "镇南王府见习家丁")) {
        if (random(5) > 1) {
          message_vision(CYN "$N对$n点点头：“嗯，既然你已经为王府尽力很久" +
            "，王府也不会亏待你。\n从今日起，给你升级一等。”\n" NOR, this_object(), me);
          me->set("title", "镇南王府家丁");
          me->set_temp("marks/问过升级", 1);
        } else {
          message_vision(HIC "$N漫不经心地看了看$n：“噢～～这个么，咱们身为" +
            "王府下人，主要考虑的应该是怎么给王爷尽忠。\n现在府上没有空名额，" +
            "你升级的事啊，等等再说。”\n" NOR, this_object(), me);
          me->set_temp("marks/问过升级", 1);
        }
      }
      if ((me->query("title") != CYN "镇南王府家丁" NOR)
        && (me->query("title") != BLU "镇南王府家丁" NOR)
        && (me->query("title") != "镇南王府家丁")
        && (me->query("title") != "镇南王府见习家丁")) {
        message_vision(HIC "$N对$n摇摇头：“你升级的事情不是我所能管的，我是爱莫能助啊" +
          "。”\n" NOR, this_object(), me);
        me->set_temp("marks/问过升级", 1);
      }
    } else {
      message_vision(YEL "$N对$n似乎很不耐烦：“你升级的事情我不是给你办了嘛，你怎么老缠着我？" +
        "”\n" NOR, this_object(), me);
    }
  } else {
    message_vision(WHT "$N对$n莫名其妙：“你升级的事情？你也不是我们王府上的人呐，和我们没有关系！" +
      "”\n" NOR, this_object(), me);
  }
  return 1;
}
