#include <ansi.h>
#include "guard.h"

void create() {
  string name, id;
  int i, j;
  i = random(sizeof(second_name));
  j = random(sizeof(last_name));
  name = "段";
  name += second_name[i];
  name += last_name[j];
  id = second_id[i];
  id += last_id[j];
  set_name(name, ({ "duan " + id, id, "chu shi" }));
  set("title", "镇南王府厨师");
  set("gender", "男性");
  set("age", 55);
  set("combat_exp", 1500);
  set("class", "duanshi");
  set("max_force", 200);
  set("force", 200);
  set("force_factor", 0);

  set("env/attack", 55);

  create_family("镇南王府", 2, "厨师");

  setup();

  carry_object(CLONE_DIR "wear/cloth/mabu_kuanshan")->wear();
}
