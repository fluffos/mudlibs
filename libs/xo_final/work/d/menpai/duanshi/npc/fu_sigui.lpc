inherit F_NEW_MASTER;

#include <ansi.h>
#include "duanshi_master.h"

string *chat_msg = ({
  "傅思归在侍卫当中走来走去，不时纠正动作有错误的侍卫。\n",
  "傅思归舞动熟铜齐眉棍，呼呼有风，不一会竟成了一团金光，把人罩在当中。\n",
  "“棍扫扫一片，枪挑一条线……”傅思归大声地对练习的侍卫解说要领。\n",
});

void create() {
  set_name("傅思归", ({ "fu sigui", "fu", "sigui" }));
  set("title", CYN "大理国" GRN "四大卫护" NOR);
  set("gender", "男性");
  set("age", 38);
  set("attitude", "peaceful");
  set("class", "duanshi");
  set("long", @LONG
傅思归身为大理国四大卫护之一，一身功夫颇为了得，但是他这个人看起来
却是普普通通，就象任何一个乡下的农夫一样平和朴实。
LONG);
  set("str", 24);
  set("int", 24);
  set("spi", 24);
  set("con", 24);
  set("cps", 24);
  set("cor", 24);
  set("per", 20);

  set("class_score/镇南王府", 800);
  set("combat_exp", 45000);
  set("social_exp", 300000);
  set("positive_score", 9000);

  set_wugong("duanshi-neigong", 150, 150, 1);
  set_wugong("zuiliu-dao", 300, 300, 1);
  set_wugong("haofeng-quan", 300, 300, 1);

  set_xiuwei_level_by_type("force", 3);
  set_xiuwei_level_by_type("blade", 3);
  set_xiuwei_level_by_type("unarmed", 2);
  set_xiuwei_level_by_type("zonggang", 3);

  set("env/attack", 60);

  create_family("镇南王府", 1, "卫护");

  ::create();
  setup();

  carry_object(CLONE_DIR "wear/boots/wuyun_xue")->wear();
  carry_object(CLONE_DIR "wear/waist/chahe_luandai")->wear();
  carry_object(CLONE_DIR "wear/cloth/baizhu_sipao")->wear();
  carry_object(CLONE_DIR "wear/head/qingsha_jin")->wear();
  carry_object(BLADE_DIR "blade1")->wield();
}

#include "weihu.h"
