inherit F_NEW_MASTER;

#include <ansi.h>
#include "duanshi_master.h"

string *chat_msg = ({
	"褚万里提起渔竿，取下一条鱼儿，看了看，又把它抛回水中。\n",
	"褚万里抬渔竿一看，钩上空空，看来这次运气不够好，白白被鱼儿吃了饵料，不过他并不以为意。\n",
	"褚万里一边举着渔竿，一边警觉地观察四周的动静。\n",
});

void create()
{
	set_name("褚万里", ({ "zhu wanli", "zhu", "wanli" }) );
	set("title",CYN"大理国"GRN"四大卫护"NOR);
	set("gender", "男性");
	set("age", 42);
	set("attitude", "peaceful");
	set("class", "duanshi");
	set("long", @LONG
褚万里身为大理国四大卫护之一，是这四者中最年长者。他整日里总是拎着
渔竿钓鱼，看起来不似武士，倒象是平常人家的渔户。
LONG);
	set("str", 27);
	set("int", 27);
	set("spi", 27);
	set("con", 27);
	set("cps", 27);
	set("cor", 27);
	set("per", 27);

	set("class_score/镇南王府", 800);
	set("combat_exp", 55000);
	set("social_exp", 300000);
	set("positive_score", 11000);

    set_wugong("duanshi-neigong", 150, 150, 1);
    set_wugong("dingnan-dao", 300, 300, 1);

    set_xiuwei_level_by_type("force", 3);
    set_xiuwei_level_by_type("blade", 4);
    set_xiuwei_level_by_type("zonggang", 3);

	set("env/attack", 55);

	create_family("镇南王府", 1, "卫护");

    ::create();
	setup();

	carry_object(CLONE_DIR"wear/boots/wuyun_xue")->wear();
	carry_object(CLONE_DIR"wear/waist/chahe_luandai")->wear();
	carry_object(CLONE_DIR"wear/cloth/baizhu_sipao")->wear();
	carry_object(CLONE_DIR"wear/head/qingsha_jin")->wear();
	carry_object(BLADE_DIR"blade1")->wield();
}

#include "weihu.h"

