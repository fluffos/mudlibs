inherit ITEM;

void create()
{
    set_name("「醉柳刀法」", ({ "zuiliu daofa", "book", "shu" }));
    set_weight(250);
    if( clonep() )
        set_default_object(__FILE__);
    else {
    set("unit", "本");
    set("num", "a1");
    set("long", "这是一本略显陈旧的刀法书。\n");
    set("value", 200);
    set("material", "paper");
    set("skill", ([
        "name"              :"zuiliu-dao",
        "xiuwei_required"   : 290,
        "literate_required" : 60,
        "gin_cost"          : 10+random(10),
        "max_jibie"         : 50,
        "max_lingwu"        : 50,
        "bonus_xiuwei"      : 2,
        "max_xiuwei"        : 400,
        ]) );
    }
}   

#include "duan_book.h"
