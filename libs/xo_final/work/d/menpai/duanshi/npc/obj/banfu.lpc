// banfu.c  
#include <weapon.h>
#include <ansi.h>
inherit TWOHANDS_AXE;

void create()
{
        set_name(HIW"银柄板斧"NOR, ({ "yin banfu", "banfu", "axe" }) );
        set_weight(36000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "对");
set("long", "一对重达七十二斤的银柄大板斧，本是古笃诚的看家兵器。\n");
                set("value", 2000);
                set("material", "iron");
                set("wield_msg", "$N抽出两把$n握在手中。\n");
                set("unwield_msg", "$N放下手中的$n。\n");
        }
        init_twohands_axe(60);
        setup();
}
