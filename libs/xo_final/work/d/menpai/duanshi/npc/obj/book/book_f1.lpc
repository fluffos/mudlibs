inherit ITEM;

void create()
{
    set_name("「短兵战技」", ({ "duanbing zhanji", "book", "shu" }));
    set_weight(200);
    if( clonep() )
        set_default_object(__FILE__);
    else {
    set("unit", "本");
    set("num", "f1");
    set("long", "这是一本讲短兵刃格斗的书。\n");
    set("value", 100);
    set("material", "paper");
    set("skill", ([
        "name"              :"dagger",
        "xiuwei_required"   : 0,
        "literate_required" : 10,
        "gin_cost"          : 10+random(10),
        "max_jibie"         : 50,
        "max_lingwu"        : 50,
        "bonus_xiuwei"      : 2,
        "max_xiuwei"        : 100,
        ]) );
    }
}   

#include "duan_book.h"
         