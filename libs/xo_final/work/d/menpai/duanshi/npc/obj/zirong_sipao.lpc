//zirong_sipao.c cry

#include <ansi.h>
#include <armor.h>

inherit CLOTH;

void create()
{
	set_name(HIM"紫绒丝袍"NOR, ({ "zirong sipao", "cloth" }));
	set("long","一套轻便柔软的丝袍，做工极其精细，非常人所有。\n");
	set_weight(800);
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("material", "cloth");
		set("unit", "套");
		set("value", 10000);
		set("armor_prop/armor", 5);
		set("armor_prop/personality", 1);  
	}
	setup();
}
