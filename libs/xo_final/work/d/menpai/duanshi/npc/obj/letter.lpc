//letter.c 要送的信（用在Quest当中）
//By lala 

inherit ITEM;

void create() {
  set_name("信", ({ "xin", "letter" }));
  set_weight(50);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "这是一封普通的信件。\n");
    set("unit", "封");
    set("value", 0);
    set("material", "paper");
  }
  setup();
}
