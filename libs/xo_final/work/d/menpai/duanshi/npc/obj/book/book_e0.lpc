inherit ITEM;

void create()
{
    set_name("「狂风鞭法残本」", ({ "kuangfengbianfa canben", "book", "shu" }));
    set_weight(100);
    if( clonep() )
        set_default_object(__FILE__);
    else {
    set("unit", "本");
    set("num", "e0");
    set("long", "这是一本讲解狂风鞭法的书，可惜已经残缺不全了。\n");
    set("value", 20);
    set("material", "paper");
    set("skill", ([
        "name"              :"kuangf-bian",
        "xiuwei_required"   : 100,
        "literate_required" : 50,
        "gin_cost"          : 10+random(10),
        "max_jibie"         : 50,
        "max_lingwu"        : 50,
        "bonus_xiuwei"      : 2,
        "max_xiuwei"        : 400,
        ]) );
    }
}   

#include "duan_book.h"
         