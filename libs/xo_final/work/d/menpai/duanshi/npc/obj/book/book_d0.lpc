inherit ITEM;

void create() {
  set_name("「化书」", ({ "hua shu", "book", "shu" }));
  set_weight(300);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "本");
    set("num", "d0");
    set("long", "这是谭子的化书，是道家的至高无上的经典。\n");
    set("value", 1050);
    set("material", "paper");
    set("skill", ([
      "name": "shenxing",
      "xiuwei_required": 280,
      "literate_required": 90,
      "gin_cost": 10 + random(10),
      "max_jibie": 60,
      "max_lingwu": 60,
      "bonus_xiuwei": 2,
      "max_xiuwei": 450,
    ]));
  }
}

#include "duan_book.h"
