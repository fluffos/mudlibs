inherit ITEM;

void create() {
  set_name("「横刀六式」", ({ "hengdao liushi", "book", "shu" }));
  set_weight(250);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "本");
    set("num", "a4");
    set("long", "这是一本介绍江湖上常见的横刀六式的小册子。\n");
    set("value", 30);
    set("material", "paper");
    set("skill", ([
      "name": "blade",
      "xiuwei_required": 10,
      "literate_required": 5,
      "gin_cost": 10 + random(10),
      "max_jibie": 60,
      "max_lingwu": 60,
      "bonus_jilei": 2 + random(5),
    ]));
  }
}

#include "duan_book.h"
