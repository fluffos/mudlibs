inherit ITEM;

void create()
{
    set_name("「追风秘本」", ({ "zhuifeng miben", "book", "shu" }));
    set_weight(250);
    if( clonep() )
        set_default_object(__FILE__);
    else {
    set("unit", "本");
    set("num", "c1");
    set("long", "这是一本深入讲述追风拳的书。\n");
    set("value", 540);
    set("material", "paper");
    set("skill", ([
        "name"              :"zhuifeng-quan",
        "xiuwei_required"   : 340,
        "literate_required" : 75,
        "gin_cost"          : 10+random(10),
        "max_jibie"         : 80,
        "max_lingwu"        : 80,
        "bonus_jilei"       : 2+random(5),
        ]) );
    }
}   

#include "duan_book.h"
         