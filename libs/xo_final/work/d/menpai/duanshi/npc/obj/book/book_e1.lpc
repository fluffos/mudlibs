inherit ITEM;

void create()
{
    set_name("「鞭法精要」", ({ "bianfa jingyao", "book", "shu" }));
    set_weight(200);
    if( clonep() )
        set_default_object(__FILE__);
    else {
    set("unit", "本");
    set("num", "e1");
    set("long", "这是一本讲基本鞭法的书。\n");
    set("value", 200);
    set("material", "paper");
    set("skill", ([
        "name"              :"whip",
        "xiuwei_required"   : 0,
        "literate_required" : 10,
        "gin_cost"          : 10+random(10),
        "max_jibie"         : 80,
        "max_lingwu"        : 80,
        "bonus_xiuwei"      : 2,
        "max_xiuwei"        : 200,
        ]) );
    }
}   

#include "duan_book.h"
         