//letter0.c段无畏的推荐信
//By lala 

inherit ITEM;

void create()
{
	set_name("推荐信", ({"tuijian xin", "xin", "letter"}));
	set_weight(50);
	if ( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "这是一封段无畏写给四大卫护的推荐信。\n");
		set("unit", "封");
		set("value", 0);
		set("material", "paper");
	}
	setup();
}



