// golden_pen.c writen by tea 10.17.98

#include <weapon.h>
#include <ansi.h>

inherit PEN;

void create() {
  set_name(HIY "金丝判官笔" NOR, ({ "golden pen", "pen" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "支");
    set("long", "一支金丝旋绕的判官笔，笔头包着金皮。上面工整地镌刻着“镇南王府段”\n");
    set("value", 30000);
    set("material", "gold");
    set("cant_sell", "啊？！这个可是镇南王府的东西呀！小的我还想多活两年呢，可不敢收！\n");

  }
  init_pen(30);
  set("wield_msg", "$N从怀中抽出一把$n握在手中。\n");
  set("unwield_msg", "$N将手中的$n藏入怀中。\n");

  setup();
}
