inherit ITEM;

void create()
{
    set_name("「轻功秘奥」", ({ "qinggong miao", "book", "shu" }));
    set_weight(300);
    if( clonep() )
        set_default_object(__FILE__);
    else {
    set("unit", "本");
    set("num", "d3");
    set("long", "这是一本深入讲述轻功的书。\n");
    set("value", 240);
    set("material", "paper");
    set("skill", ([
        "name"              :"jiben-qinggong",
        "xiuwei_required"   : 50,
        "literate_required" : 40,
        "gin_cost"          : 10+random(10),
        "max_jibie"         : 130,
        "max_lingwu"        : 130,
        "bonus_xiuwei"      : 2,
        "max_xiuwei"        : 300,
        ]) );
    }
}   

#include "duan_book.h"
         