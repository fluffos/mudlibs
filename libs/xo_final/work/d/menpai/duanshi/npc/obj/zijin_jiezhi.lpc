// zijin_jiezhi.c cry

#include <ansi.h>
#include <armor.h>

inherit FINGER;

void create() {
  set_name(YEL "紫金戒指" NOR, ({ "zijin jiezhi", "jiezhi", "finger" }));
  set_weight(500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "这是一枚紫金精刻的戒指。\n");
    set("unit", "枚");
    set("value", 20000);
    set("material", "gold");
    set("armor_prop/armor", 2);
    set("armor_prop/strength", 1);
  }
  setup();
}
