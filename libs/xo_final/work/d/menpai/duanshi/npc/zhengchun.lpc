// NPC: /d/menpai/duanshi/npc/zhengchun.c  段正淳 writen by cry 9.10.98

inherit F_NEW_MASTER;

#include <ansi.h>
#include "duanshi_master.h"

string *drink_msg = ({
  "段正淳慢慢地品味着手中的酒，嘴里不停念着：红棉，红棉……\n",
  "段正淳叹道：“不知道甘宝宝现在怎么样了。”\n",
  "段正淳向你瞥了一眼：“凤凰儿现在何处呢？”\n",
  "段正淳眼睛直直地盯着窗外的茶花：阿萝一定喜欢这种。\n",
});

string change_master();
void delay_duan_quest(object me, int num);
void fail_duan_quest(object me);
void call_guard(object me);
void create() {
  set_name("段正淳", ({ "duan zhengchun", "duan", "zhengchun" }));
  set("title", CYN "大理国" YEL "镇南王" NOR);
  set("gender", "男性");
  set("age", 49);
  set("attitude", "peaceful");
  set("class", "duanshi");
  set("apprentice_available", 2);
  set("long", @LONG
段正淳是大理镇南王，兼保国大将军，总揽文武机要，是大理皇帝段正明的
兄弟。他身穿紫袍，一张国字脸，神态威猛，浓眉大眼，肃然有王者之相。
LONG);

  set("str", 30); set("cor", 30); set("int", 30);
  set("per", 30); set("spi", 30); set("cps", 30);
  set("dex", 30); set("con", 30); set("kar", 30);

  set("combat_exp", 800000);
  set("social_exp", 200000);
  set("class_score/镇南王府", 10000);

  set("inquiry", ([
    "指点武功": (: change_master :),
  ]));

  set_wugong("duanshi-xinfa", 300, 300, 1);
  set_wugong("yiyang-zhi", 300, 300, 1);
  set_wugong("wuluo-qingyan", 300, 300, 1);
  set_wugong("duanjia-shenfa", 300, 300, 1);

  set_xiuwei_level_by_type("force", 6);
  set_xiuwei_level_by_type("unarmed", 7);
  set_xiuwei_level_by_type("dodge", 5);
  set_xiuwei_level_by_type("zonggang", 6);

  create_family("镇南王府", 1, "王爷");
  set("rank_info/respect", "王爷");
  set("chat_chance", 10);
  set("chat_msg", ({
    drink_msg[random(sizeof(drink_msg))],
  }));

  setup();
  carry_object(__DIR__ "obj/zirong_sipao")->wear();
  carry_object(__DIR__ "obj/xiaoniu_pixue")->wear();
  carry_object(__DIR__ "obj/zijin_jiezhi")->wear();
}


void init() {
  object me = this_player();

  add_action("do_duilian", "duilian");
  if (me->query("class_score/镇南王府") >= 4500 || me->query("quest"))
    add_action("give_quest", "quest");
}

int accept_fight(object me) {
  object *inv = all_inventory(this_object());
  int i;
  string id;

  for (i = 0; i < sizeof(inv); i++) {
    id = inv[i]->query("id");
    if (id != "zirong sipao" && id != "xiaoniu pixue" && id != "zijin jiezhi") {
      if (inv[i]->move(me))
        message_vision("段正淳给$N一" + inv[i]->query("unit") + inv[i]->query("name") + ".\n", me);
      else {
        message_vision("段正淳扔下一" + inv[i]->query("unit") + inv[i]->query("name") + ".\n", me);
        inv[i]->move(environment(this_object()));
      }
    }
  }
  set("force_factor", 200);
  return ::accept_fight(me);
}

int do_duilian(string arg) {
  object me = this_player();

  if (me->query("family/master_id") != "duan zhengchun") {
    message_vision("$N笑了笑，对$n摇了摇头。\n", this_object(), me);
    return 1;
  }

  return 0;
}

int accept_apprentice(object me) {
  object ob = this_object();
  int score = me->query("class_score/镇南王府");

  if (me->query("class") != "duanshi") {
    command("say “对不起，我只收府内的武官。”");
    return 0;
  }
  if (me->query("title") != CYN "大理国" RED "武官" NOR) {
    command("say “你还不够资格。”");
    return 0;
  }
  if (score < 5600 + random(2000) - 10 * me->query_per() - 10 * me->query_kar()) {
    command("say “我还需要考虑一下，你先下去吧。”");
    return 0;
  } else {
    if (query("apprentice_available")) {
      if (find_call_out("do_recruit") != -1)
        command("say 慢著，一个一个来。");
      else
        call_out("decide_recruit", 2, ob, me);
    } else
      command("say 本王今天已经收了二个武官，不想再收人了。");
    return 0;
  }

  return 0;
}

void decide_recruit(object ob, object me) {
  string msg;

  command("say 你既然对我如此忠心，我就亲自指点你武功吧。");
  me->set("title", CYN "大理国" GRN "武官" NOR);
  LOG_D->do_log(me, "你得到段正淳的赏识，被提升为" + me->query("title") + NOR "，并由他亲自指点你武功。\n");
  me->set("family/master_id", "duan zhengchun");
  me->set("family/master_name", "段正淳");
  message_vision(@LONG
$N决定收$n为弟子。

$n跪了下来向$N恭恭敬敬地磕了四个响头，叫道：「师父！」

LONG, ob, me);
  tell_object(me, "恭喜您成为镇南王的亲传弟子。\n");
  msg = me->query("name") + "入府以来一直忠心耿耿，现提升为" NOR + me->query("title") + HIC "！\n";
  command("chat " + msg);
  me->save();
}

int recruit_apprentice(object ob) {
  this_object()->add("apprentice_availavble", -1);
  return 1;
}

string change_master() {
  string msg;
  object me = this_player();

  if (me->query("family/master_id") == "duan zhengchun")
    if (!me->query_temp("lost_fight/寺") && !me->query_temp("ask_zhengchun")
      && !me->query_temp("fight_zhengchun"))
      if (me->query("title") != CYN "大理国" WHT "武官" NOR)
        if (me->query("class_score/镇南王府") > 7000 + random(2000) - 10 * me->query_per() - 10 * me->query_kar()) {
          me->set_temp("fight_zhengchun", 1);
          msg = "不知道你武功已经练到什么程度了？好，那咱们比划比划吧。";
          this_object()->set("force_factor", 200);
        } else {
          msg = "你先跟着我学吧！";
          me->set_temp("ask_zhengchun", 1);
        } else {
          command("? " + me->query("id"));
          msg = "我不是让你去天龙寺吗？";
        } else
          msg = "你怎么这么烦呀！";
      else
        msg = "你应该找你自己的师傅呀？";
  return msg;
}

int win_bihua(object me) {
  int n;

  set("food", max_food_capacity());
  set("water", max_water_capacity());
  n = query("max_kee");
  set("eff_kee", n);
  n = query("max_force");
  set("force", n);
  set("force_factor", 30);

  if (!me->query_temp("fight_zhengchun")) return 0;
  me->set_temp("lost_fight/寺", 1);
  command("say 你还是回去好好练武吧，不要好高骛远！！！");
  this_object()->set("force_factor", 50);
  me->delete_temp("fight_zhengchun");
  return 0;
}

int lose_bihua(object me) {
  int n;
  string msg;

  set("food", max_food_capacity());
  set("water", max_water_capacity());
  n = query("max_kee");
  set("eff_kee", n);
  n = query("max_force");
  set("force", n);
  set("force_factor", 30);

  if (!me->query_temp("fight_zhengchun")) return 0;
  command("say " + "没想到你武功如此精进，你去向天龙寺的方丈本因大师求教吧，\n"
    + "不过是否能学成就要看你自己的了。\n");
  me->delete_temp("fight_zhengchun");
  set("force_factor", 50);
  me->set("title", CYN "大理国" WHT "武官" NOR);
  msg = me->query("name") + "对本王忠心耿耿、武功出神入化，现提升为" NOR + me->query("title") + HIC "！\n";
  LOG_D->do_log(me, "你打败了段正淳，被提升为" + me->query("title") + NOR "，并获准去天龙寺学武。");
  command("chat " + msg);
  me->save();
  return 0;
}

#include "duan_givequest.h"
#include "duan_be_killed.h"
