inherit F_NEW_MASTER;

#include <ansi.h>
#include "duanshi_master.h"

string *chat_msg = ({
  "古笃诚警惕地向四周望了望，回身向屋里看了一眼，见一切正常，似乎略放了放心。\n",
  "古笃诚抽出腰间的两把板斧，爱惜地看看，又插回腰间。\n",
  "古笃诚挺了挺胸膛，又紧了紧腰带，显得更加英武神气。\n",
});

void create() {
  set_name("古笃诚", ({ "gu ducheng", "gu", "ducheng" }));
  set("title", CYN "大理国" GRN "四大卫护" NOR);
  set("gender", "男性");
  set("age", 39);
  set("attitude", "peaceful");
  set("class", "duanshi");
  set("long", @LONG
古笃诚身为大理国四大卫护之一，是这四者中最象武士的一个。他生得满面
络腮胡须，善使一对板斧，膂力过人，对段家忠心耿耿。
LONG);
  set("str", 34);
  set("int", 22);
  set("spi", 25);
  set("con", 27);
  set("cps", 27);
  set("cor", 22);
  set("per", 20);

  set("class_score/镇南王府", 800);
  set("combat_exp", 50000);
  set("social_exp", 300000);
  set("positive_score", 10000);

  set_wugong("duanshi-neigong", 150, 150, 1);
  set_wugong("pangencuojie", 300, 300, 1);
  set_wugong("unarmed", 300, 300, 1);

  set_xiuwei_level_by_type("force", 3);
  set_xiuwei_level_by_type("blade", 5);
  set_xiuwei_level_by_type("unarmed", 2);
  set_xiuwei_level_by_type("zonggang", 3);

  set("env/attack", 60);

  create_family("镇南王府", 1, "卫护");

  ::create();
  setup();

  carry_object(CLONE_DIR "wear/boots/wuyun_xue")->wear();
  carry_object(CLONE_DIR "wear/waist/chahe_luandai")->wear();
  carry_object(CLONE_DIR "wear/cloth/baizhu_sipao")->wear();
  carry_object(CLONE_DIR "wear/head/qingsha_jin")->wear();
  carry_object(BLADE_DIR "blade1")->wield();
}

#include "weihu.h"
