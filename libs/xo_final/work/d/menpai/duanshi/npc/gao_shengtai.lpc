//这是高升泰的基本函数
void create() {
  set_name("高升泰", ({ "gao shengtai", "gao", "shengtai" }));
  set("title", CYN "大理国" MAG "候爵" NOR);
  set("gender", "男性");
  set("nickname", "鄯阐候");
  set("age", 48);
  set("attitude", "peaceful");
  set("class", "duanshi");
  set("long", @LONG
高升泰是当年除奸的大功臣高智兴之子，乃保定帝的股肱之臣。现爵封
鄯阐候，以大理国东都鄯阐为封邑，成为京城大理的东面屏障。他内功
相当深厚，仅次于保国大将军、镇南王段正淳。无论是王府还是皇宫的
警卫工作都由他负责。新来投效大理段氏的江湖豪杰和希望得到升级或
的渴求学习高深武功的王府卫士都可以来找他。
LONG);
  set("inquiry", ([
    "效力": (: do_accept_me :),
    "升级": (: change_dengji :),
    "指点武功": (: change_master :),
    //              "任务"     : (: give_quest    :),
    "口令": (: ask_key :),
  ]));
  set("str", 33);
  set("int", 33);
  set("spi", 33);
  set("con", 33);
  set("cps", 33);
  set("cor", 33);
  set("per", 33);

  set("rank_info/respect", "高君候");

  set("class_score/镇南王府", 3000);
  set("combat_exp", 700000);
  set("social_exp", 150000);
  set("positive_score", 100000);

  set_wugong("duanshi-neigong", 300, 300, 1);
  set_wugong("wolong-zhang", 300, 300, 1);
  set_wugong("duanjia-shenfa", 300, 300, 1);

  set_xiuwei_level_by_type("force", 5);
  set_xiuwei_level_by_type("unarmed", 6);
  set_xiuwei_level_by_type("dodge", 5);
  set_xiuwei_level_by_type("zonggang", 5);

  set("env/attack", 60);
  set("quest_num", 8);

  create_family("镇南王府", 1, "侯爵");

  ::create();
  setup();

  carry_object(CLONE_DIR "wear/boots/wuyun_xue")->wear();
  carry_object(CLONE_DIR "wear/waist/yindai")->wear();
  carry_object(CLONE_DIR "wear/cloth/cloth5")->wear();
  carry_object(CLONE_DIR "wear/head/qingsha_jin")->wear();
}

void init() {
  object me = this_player();
  ::init();
  if (can_act() && userp(me) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1);
  }
  add_action("say_ok", "ok");
  add_action("do_bihua", "bihua");
  add_action("do_fight", "fight");
  add_action("do_kill", "kill");
}

int do_bihua() {
  object me = this_player();

  if (!me->query_temp("pending/is_testing")) return 0;
  message("vision", "加油，加油！\n", me);
  return 1;
}

int do_kill() {
  object me = this_player();

  if (!me->query_temp("pending/is_testing")) return 0;
  message("vision", "这是比武啊，你怎么来真的？！\n", me);
  return 1;
}

int do_fight() {
  object me = this_player();

  if (!me->query_temp("pending/is_testing")) return 0;
  message("vision", "加油，加油！\n", me);
  return 1;
}

//不能随便被人杀掉喔 
int refuse_killing() {
  object me = this_player();
  me->apply_condition("kill_dali", 500);
  set("env/attack", 80);
  if (file_name(environment()) == "/d/menpai/duanshi/xiaoketing")
    call_out((: call_guard, this_player(1) :), 3);
  return 0;
}

void call_guard(object killer) {
  int i;
  object ob;
  if (!this_object() || !this_object()->is_fighting()) return;
  if (environment(killer) != environment()) return;
  if (present("duan guard", environment())) return;
  say("几名卫士从屏风后面冲了出来！\n");
  for (i = 0; i < 5; i++) {
    ob = new(__DIR__ "weishi1");
    ob->move(environment());
    ob->kill_ob(killer);
    ob->set_leader(killer);
  }
}

void greeting() {
  object me = this_player();
  if (me->query_condition("kill_dali")) {
    message_vision("$N对着$n大喝一声：“杀人放火的强盗，快快受死吧！！！” \n",
      this_object(), me);
    kill_ob(me);
  } else {
    if (me->query("class") != "duanshi") {
      command("haha " + me->query("id"));
      command("say “这位" + RANK_D->query_respect(me) + "光临镇南王府不知有何见教？”");
      command("say “莫非有意效力于大理皇家么？”");
    } else {
      command("nod " + me->query("id"));
    }
  }
}

#include "gao_touxiao.h";//对新人投效的反应
#include "gao_shengji.h";//对要求升级的反应
