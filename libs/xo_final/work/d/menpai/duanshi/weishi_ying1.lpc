// room:/d/menpai/duanshi/weishi_ying1.c  writen by lala July-27-97

#include <room.h>
#include <ansi.h>

inherit ROOM;

void create()
{
	set("short", "卫士营");
	set("long", @LONG
这里是王府卫士们的住处，整整齐齐的一排平房。镇南王府的卫士都是由四
大护卫严格考核后录用的，个个身手不凡，大理段氏虽是皇族却很尊敬武林人氏
段王爷更是善待自己的部下，所以江湖上有不少豪杰投身王府甘做卫士，当然每
年的薪俸也极为丰厚。只是四大护卫的要求十分严格，录用的只是前来应聘者中
极少数。王府卫士分为黄衣、紫衣、红衣三等，以黄衣卫士为尊，红衣卫士最次。
LONG
	);
    set("exits", ([ 
	        "south"  : __DIR__"weishi_ying2",
	        "east"   : __DIR__"lianwu_chang1",
        ]));
	set("sleep_room", "镇南王府");
	set("no_fight", 1);
	setup();
}                       

void init()
{
	add_action("check_sleep", "sleep");
}

int check_sleep()
{
	object me=this_player();
	if ((me->query("title")!=RED"镇南王府卫士")
	&&  (me->query("title")!=MAG"镇南王府卫士"NOR)
	&&  (me->query("title")!=YEL"镇南王府卫士"NOR)) 
	{
		tell_object(me, "这里不是让你睡的地方。\n");
		return 1;
	}
	return 0;
}
