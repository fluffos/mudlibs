// muni_men.c cry

#include <room.h>
inherit DOOR_ROOM;

void create()
{
        set("short", "牟尼堂前");
        set("long",@LONG
穿过长廊，来到几间屋前。只见那几间屋全以松木拾成，板门木柱，木料均
不去皮，天然质朴，和一路行来金碧辉煌的殿堂截然不同。心中不禁凭添几分闲
适雅致的情怀。
LONG
        );
	set("outdoors","tianlongsi");
	set("exits", ([
		"west" : __DIR__"muni",
		"east" : __DIR__"lang1",
	]));
	create_door("west","小木门","east",DOOR_CLOSED);
	setup();
}
