// cibei.c cry

#include <ansi.h>
inherit ROOM;
string *condi = ({
	"capital",	"dali",		"funiu",
	"government",	"kunlun",	"lanzhou",
	"soldier",	"suzhou",	"west_wuliang",
	"wuliang",	"yangzhou",	"yipin",
	});
void tell_time(int t, object me);
void create()
{
	set("short", "慈悲院");
	set("long",@LONG
这是高僧点化顽徒的地方。不少江湖豪客由于厌倦了打打杀杀，充满仇恨的
日子，来到此处落发为僧，皈依佛门。墙上一张字画，上书一个斗大的「佛」。
地上一个蒲团，上面一个清晰的「悔」字。
LONG
	);
	set("no_fight",1);
	set("exits", ([
	    "west" : __DIR__"luodi",
	]));
	set("detail",([
		"蒲团" : "一个写有悔字的蒲团，经常有人在上面静坐悔过（hui）。\n",
	]) );
	setup();
}

void init()
{
	add_action("do_open","open");
	add_action("do_hui","hui");
}

int do_hui()
{
	object me=this_player();
	int i,huitime=1;

	if ( me->query_condition() )
		for(i=0;i<sizeof(condi);i++)
			if ( me->query_condition("kill_"+condi[i]) )
				huitime+=10;
	huitime+=me->query("bellicosity");
	message_vision(WHT"$N双目微闭，开始忏悔以往的种种恶行。。。\n"NOR,me);
	tell_time(huitime,me);
	me->set_temp("block_msg/all",1);
	me->set("no_get", 1);
	me->set("no_get_from", 1);
	me->disable_player("<悔过中>");
	call_out("over_hui", huitime, me);
	return 1;
}

void tell_time(int t, object me)
{
        int d, h, m, s;
        string time;
        s = t % 60;             t /= 60;
        m = t % 60;             t /= 60;
        h = t % 24;             t /= 24;
        d = t;

        if(d) time = chinese_number(d) + "天";
        else time = "";

        if(h) time += chinese_number(h) + "小时";
        if(m) time += chinese_number(m) + "分";
        time += chinese_number(s) + "秒";
        tell_object(me,"你需要"+time+"的时间。\n\n");
}

void over_hui(object me)
{
	int i;
    int bel;
	if ( me->query_condition() )
		for(i=0;i<sizeof(condi);i++)
			if ( me->query_condition("kill_"+condi[i]) )
				me->clear_condition("kill_"+condi[i]);
	bel=me->query("bellicosity");
	me->set("bellicosity",bel*4/5);
	me->enable_player();
	me->set_temp("block_msg/all", 0);
	me->delete("no_get");	
	me->delete("no_get_from");	
	message_vision(WHT"$N慢慢睁开双眼，露出一片和善的笑容。\n"NOR,me);
}

int do_open(string arg)
{
	object obj,me=this_player(),ob=this_object();

	if ( !arg || arg!="字画" && arg!="picture" ) return 0;
	if ( ob->query("exits/east") )
		return notify_fail("字画已经被揭开了。\n");
	if ( objectp(obj=find_object(__DIR__"mishi")) )
		tell_room(obj,"有人从另一边打了字画。\n");
	else
		obj=load_object(__DIR__"mishi");
	message_vision("$N用手揭开字画，出现了一条密道！\n",me);
	set("exits/east",__DIR__"mishi");
	obj->set("exits/west",__DIR__"cibei");
	call_out("close_exit", 2, ob, obj);
	return 1;
}

void close_exit(object ob,object obj)
{
	tell_room(ob,"字画荡了回来，挡住了密道。\n");
	tell_room(obj,"字画荡了回来，挡住了密道。\n");
	delete("exits/east");
	obj->delete("exits/west");
}