// tading1.c cry

#include <ansi.h>
inherit ROOM;

void create() {
  set("short", "塔顶");
  set("long", @LONG
这是天龙寺塔塔顶，室中空无一物，只有中央地上摆放着一张供桌。四面是
严丝合缝的砖墙，没有一扇窗户，只有几座古灯发出昏暗的光照亮着室内。一个
老年僧人正坐在一个蒲团上打坐修炼。
LONG
  );
  set("exits", ([
    "down": __DIR__ "ta1",
  ]));
  set("objects", ([
    __DIR__ "npc/taseng1": 1,
  ]));
  set("detail", ([
    "供桌": "供桌上有一个锦盒。\n",
    "锦盒": "锦盒由金丝镶边，上嵌宝石，雕刻精美，据说是盛放舍利子用的。\n",
  ]));
  setup();
}

void init() {
  add_action("do_open", "open");
}

int do_open(string arg) {
  object item, obj, ob = this_object(), me = this_player();

  if (!arg || arg != "锦盒" && arg != "box") return 0;
  if (objectp(obj = present("huta seng", ob))) {
    tell_object(me, "一个老僧正挡在你前面。\n");
  } else if (ob->query_temp("zi_lost") || random(4)) {
    tell_object(me, CYN "你打开锦盒，里面什么都没有。\n" NOR);
    ob->set_temp("zi_lost", 1);
  } else {
    tell_object(me, CYN "你打开锦盒，从里面取出一粒舍利子。\n" NOR);
    ob->set_temp("zi_lost", 1);
    item = new(__DIR__ "obj/shelizi");
    item->move(me);
  }
  return 1;
}
