    "south": __DIR__ "baodian",
    "east": __DIR__ "youyou",
  ]));
  set("objects", ([
    __DIR__ "npc/songmonk": 1,
  ]));
  set("search_things", ([
    "书架": __DIR__ "obj/jing" + random(3),
  ]));
  setup();
