// ta1.c cry
inherit ROOM;

void create()
{
	set("short", "天龙寺塔");
	set("long",@LONG
天龙寺共有三塔，建于唐初。这是天龙三塔中最高的一座，高约二百余尺，
共有十六级，塔顶有铁铸记云：“大唐贞观尉迟敬德造。”相传天龙寺有五宝，
三塔为五宝之首，不知缘何。
LONG
        );
	set("outdoors", "tianlongsi");
	set("exits", ([
	    "south" : __DIR__"talin",
	    "up" : __DIR__"tading1",
	]));
	set("objects",([
	    __DIR__"npc/taseng" : 1,
	]));
	setup();
}

#include "ta.h"