// talin.c cry
inherit ROOM;

void create() {
  set("short", "塔林");
  set("long", @LONG
这是一片塔林。放眼望去，林林总总有不下百座高矮不一的石塔，这些都为
历代皇族所建，或是为了祈求菩萨保佑，或是为了还愿平心。东西北三面还各有
一座高塔，显然与众不同。
LONG
  );
  set("outdoors", "tianlongsi");
  set("exits", ([
    "north": __DIR__ "ta1",
    "west": __DIR__ "ta2",
    "east": __DIR__ "ta3",
    "south": __DIR__ "sanyuan",
  ]));
  set("objects", ([
    __DIR__ "npc/diseng": 1,
  ]));
  setup();
}
