//diseng.c 扫地僧 writen by cry 9.29.98

inherit NPC;

int ask_me();
void create() {
  set_name("扫地僧", ({ "saodi seng", "seng" }));
  set("gender", "男性");
  set("age", 20 + random(30));
  set("long", @LONG
由于天龙寺塔对于天龙寺有特殊的意思，所以每个塔都有人负责守护和打扫，
他就是其中一个。
LONG);

  set("vendetta_mark", "tianlongsi");

  set("force", 500);
  set("max_force", 500);
  set("force_factor", 50);

  set_wugong("dodge", 100);
  set_wugong("unarmed", 100);
  set_wugong("tianhong", 100, 100, 1);
  set_wugong("duanshi-neigong", 100, 100, 1);
  set_wugong("zhuifeng-quan", 100, 100, 1);
  set_xiuwei_by_type("dodge", 300);
  set_xiuwei_by_type("unarmed", 600);
  set("combat_exp", 50000);
  set("social_exp", 10000);
  set("title", "天龙寺");
  set("inquiry", ([
    "五灭神偷": (: ask_me :),
  ]));
  setup();

  carry_object(__DIR__ "obj/cloth1")->wear();
}

int ask_me() {
  object me = this_player();

  if (me->query_temp("cry/jianpu") == 1)
    me->set_temp("cry/jianpu", 2);
  if (me->query_temp("cry/jianpu")) {
    tell_object(me, @TEXT
扫地僧惊呀地看着你：“你是说那个偷看寺里的武林绝学「六脉神剑」的
那个‘五灭神偷’？他好像被关在慈悲院的密室里了。”
TEXT);
  }
  return 1;
}
