// fengseng.c 疯僧 writen by cry 9.10.98

#include <ansi.h>

inherit NPC;

void create()
{
    set_name( "疯僧" , ({ "feng seng", "seng" }) );
    set("gender", "男性" );
    set("age", 40+random(20) );
    set("long", @LONG
他本是天龙寺的一名武僧，负责保护舍利子，后因舍利子被盗而变的疯颠。
LONG    );
    
    set("str", 30);    set("cor", 30);    set("int", 30);
    set("per", 30);    set("spi", 30);    set("cps", 30);
    set("dex", 30);    set("con", 30);    set("kar", 30);
    set("force", 2200); 
    set("max_force", 2200); 
    set("force_factor", 220);

    set_wugong("shenxing"       , 100, 100, 1);
    set_wugong("duanshi-xinfa"  , 150, 150, 1);
    set_wugong("wolong-zhang"   , 100, 100, 1);
    set_xiuwei_by_type("dodge"  , 1901);
    set_xiuwei_by_type("unarmed", 1901);
    set("combat_exp", 4000000);
    set("social_exp", 40000);
    set("env/attack", 75);
    set("max_kee",1200);
    set("title","天龙寺");

    setup();

    carry_object( __DIR__"obj/cloth3")->wear();
}

int lose_bihua( object me )
{
	me->set_temp_marks("cry/can_enter",1);
	call_out("dest_obj",1,me);
	return 0;
}

int win_bihua( object me )
{
	call_out("dest_obj",1,me);
	return 0;
}

void dest_obj(object me)
{
	object ob=this_object();

	if( me->query_temp_marks("cry/can_enter") )
		tell_room(environment(ob),
HIY"疯僧突然一阵风似的消失了！远处传来：可能不是他偷的。。。\n"NOR);
	else
		tell_room(environment(ob),
HIY"疯僧突然一阵风似的消失了！远处传来：看你还敢不敢偷。。。\n"NOR);

	destruct(ob);
}

void die()
{
    message_vision("只见疯僧“哈哈”一阵大笑，一阵风似的消失了。\n",this_object());
    destruct(this_object());
}
