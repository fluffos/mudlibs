// cloth2.c cry

#include <armor.h>
inherit CLOTH;
void create()
{
	set_name("蓝布僧袍", ({ "seng pao", "cloth" }) );
	set_weight(400);
	if( clonep() )
	    set_default_object(__FILE__);
	else {
	    set("long","一件僧人常穿的袍子.\n");
	    set("unit", "件");
	    set("material", "cloth");
	    set("armor_prop/armor", 1);
	}
	setup();
}