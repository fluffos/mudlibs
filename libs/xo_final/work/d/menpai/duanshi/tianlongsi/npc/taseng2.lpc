//taseng2.c 护塔僧 cry
#include <ansi.h>

inherit NPC;

void create()
{
    set_name( "护塔僧" , ({ "huta seng", "seng" }) );
    set("gender", "男性" );
    set("age", 40+random(30) );
    set("long", @LONG
他是天龙寺塔塔顶的护塔僧，看起来武功很高。你要打什么坏主意，还是小心为妙。
LONG    );
    
    set("vendetta_mark", "tianlongsi");
    
    set("str", 30 );    set("cor", 23 );    set("int", 29 );
    set("per", 22 );    set("spi", 25 );    set("cps", 27 );
    set("dex", 28 );    set("con", 26 );    set("kar", 24 );
    
    set("force", 2500); 
    set("max_force", 2500); 
    set("force_factor", 250);

    set_wugong("dodge"          , 200);
    set_wugong("unarmed"        , 200);
    set_wugong("shenxing"       , 150, 150, 1);
    set_wugong("duanshi-xinfa"  , 150, 150, 1);
    set_wugong("wolong-zhang"   , 150, 150, 1);
    set_xiuwei_by_type("dodge"  , 3000);
    set_xiuwei_by_type("unarmed", 3201);
    set("combat_exp", 9000000);
    set("social_exp", 40000);
    set("max_kee",1600);
    set("title","天龙寺");

    setup();

    carry_object( __DIR__"obj/cloth3")->wear();
}

void init()
{
    call_out("kill_visitor", 14, this_player() );
}

void kill_visitor(object me)
{
    object ob=this_object();

    if( environment(me)==environment(ob) && !ob->is_killing() )
    {
        ob->kill_ob(me);
        me->kill_ob(ob);
    }
}
 
void welcome_visitor()
{
	tell_object(this_player(),CYN"护塔僧说道：此地仍本寺禁地，请施主快快离开！\n"NOR);
}

int accept_fight( object me )
{
	command("say 贫僧护塔重任在身，请施主见谅。");
	return 0;
}
