// guest1.c 进香客 writen by cry 9.20.98

#include <ansi.h>
inherit NPC;

void create()
{
    set_name( "进香客" , ({ "guest" }) );
    set("gender", "男性" );
    set("age", 24+random(10) );
    set("long", @LONG
天龙寺是远近闻名的大寺院，每天都有很多慕名而来的进香客。
LONG    );
    
    set("force", 1000); 
    set("max_force", 1000); 
    set("force_factor", 100);

    set_wugong("dodge"          , 120, 120, 1);
    set_wugong("unarmed"        , 120, 120, 1);
    set_wugong("haoran-zhengqi" , 100, 100, 1);
    set_xiuwei_by_type("dodge"  , 1000);
    set_xiuwei_by_type("unarmed", 1000);
    set("combat_exp", 30000);
    set("social_exp", 10000);

    setup();

    carry_object( CLOTH_DIR "zhifeng_kuanshan")->wear();
    carry_object( BOOTS_DIR "sifeng_huangxue" )->wear();
    carry_object( HEAD_DIR "sanshan_mao"      )->wear();
}

void init()
{
	object me=this_player();

	if(me->query("title")==CYN"大理国"+WHT"武官"NOR
	&& me->query_temp("cry/help")!=-1){
		add_action("do_nod","nod");
		add_action("do_shake","shake");
		add_action("do_accept","accept");
	}
}

void welcome_visitor()
{
	object me=this_player();

	if( me->query("title")!=CYN"大理国"+WHT"武官"NOR )
		return ;
	if(!me->query_temp("cry/help")){
		remove_call_out("ask_help");
		call_out("ask_help",10,me);
		return ;
	}
	if(me->query_temp("cry/help")<7)
		return ;
	else
		message_vision("进香客见到$N走进来，赶紧起身笑道：“大人好，大人请坐。”\n",me);
	if(me->query_temp("cry/help")==8){
		command("whisper "+me->query("id")
+" 听说前几年天龙寺里来了一个五灭神偷，\n偷看了寺里的武林绝学，叫什么"
+"「六脉神剑」的，闹的寺里沸沸扬扬，\n不知大人可曾听说？");
		me->set_temp("cry/help",7);
		me->set_temp("cry/jianpu",1);
	}
}

int accept_object( object me, object obj)
{
	int help=me->query_temp("cry/help");

	if(help<2)
		return 0;
	if(help>5)
		return notify_fail("进香客说道：“这怎么好意思。”\n");
	if(obj->query("name")=="党参" && 1!=(help-2)%3){
		help+=1;
		tell_object(me,"进香客说道：“真是太感谢大人了！”\n");
	}else if(obj->query("name")==BLK"何首乌"NOR && 2!=(help-2)%3){
		help+=2;
		tell_object(me,"进香客说道：“真是太感谢大人了！”\n");
	}else{
		tell_object(me,"进香客说道：“小民只需要一支「党参」和一支「"+BLK"何首乌"NOR+"」。”\n");
		return 0;
	}
	if(help==5){
		help=6;
		tell_object(me,"进香客说道：“现在药材已经齐了，小民这就回去了。这里有黄金一两，\n"
+"请"+me->query("name")+"大人收下吧。（accept）”\n");
		call_out("go_away",30,this_object(),me);
	}
	me->set_temp("cry/help",help);
	return 1;
}

int do_accept()
{
	object me=this_player(),ob=this_object();

	if(me->query_temp("cry/help")!=6) return 0;
	remove_call_out("go_away");
	me->set_temp("cry/help",7);
	ob->add_money("gold",1);
	command("give gold to "+me->query("id"));
	call_out("go_away",1,ob,me);
	return 1;
}

void go_away(object ob, object me)
{
	if(me->query_temp("cry/help")==6){
		me->set_temp("cry/help",8);
		tell_object(me,"既然武官大人执意不收，小民只能以后再图报答了。\n");
	}
	message_vision("$N匆匆忙忙地离开了。\n",ob);
	destruct(ob);
}

void ask_help(object me)
{
	if(environment()!=environment(me)) return ;
	me->set_temp("cry/help",1);
	tell_object(me,"进香客说道：“这位武官大人不知可否帮小民一个忙？（nod/shake）”\n");
}

int do_nod(string arg)
{
	object me=this_player(),ob=this_object();

	if(arg && arg!="guest") return 0;
	if(me->query_temp("cry/help")==1){
		call_out("do_say",1,me,ob);
		me->set_temp("cry/help",2);
	}
	return 0;
}

void do_say(object me, object ob)
{
	message_vision(CYN"$N的脸上露出了愉快的表情。\n"NOR,ob);
	tell_object(me,@TEXT

进香客说道：“小民的妻子得了一种怪病，经常全身发抖，面色紫青。
大夫说，是贱妾体内积累了寒毒，须用几种大补的名贵药材才可驱除。
其中的「党参」、「何首乌」小民实在无处取得，小民知道大理段府
的武官神通广大，武功超群，所以来求武官大人。望大人可怜小民，
替小民取得两味药材，小民必将感激不尽。
TEXT );
}

int do_shake(string arg)
{
	object me=this_player();

	if(arg && arg!="guest") return 0;
	if(me->query_temp("cry/help")==1){
		remove_call_out("do_sigh");
		call_out("do_sigh",1,me);
	}
	return 0;
}

void do_sigh(object me)
{
	me->set_temp("cry/help",-1);
	tell_object(me,"进香客叹了口气：“既然武官大人有事，小民就不打扰了。”\n");
}