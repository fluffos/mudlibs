inherit NPC;

void create()
{
    set_name( "本参" , ({ "ben can", "can" }) );
    set("gender", "男性" );
    set("age", 67 );
    set("long", @LONG
这魁梧的僧人法名本参，是本因方丈的师弟，仍天龙寺牟尼堂的一位高僧。
LONG    );
    
    set("force", 2600); set("max_force", 2600); set("force_factor", 160);

    set_wugong("dodge"          , 150);
    set_wugong("unarmed"        , 150);
    set_wugong("shenxing"       , 150, 150, 1);
    set_wugong("duanshi-xinfa"  , 125, 125, 1);
    set_wugong("yiyang-zhi"     , 100, 100, 1);
    set_xiuwei_by_type("dodge"  , 3000);
    set_xiuwei_by_type("unarmed", 3400);
    set("combat_exp", 8600000);
    set("social_exp", 65000);
    set("max_kee",2000);
    set("title","天龙寺神僧");

    setup();

    carry_object( __DIR__"obj/cloth4")->wear();
}

int refuse_killing()
{
	set_wugong("liumai-shenjian",  15,  15, 1);
	add("force_factor",100);
	command("say 施主仍然如此无礼，就休怪老僧了。");
	return 0;
}
