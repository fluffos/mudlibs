// baodian.c cry
inherit ROOM;

void create() {
  set("short", "崇圣宝殿");
  set("long", @LONG
这是一座金碧辉煌的大殿，正面一座高约二十余尺的佛祖宝像，通体镶金，
并嵌有宝石无数，烂灿耀眼，尽显皇家王者之风。座下香烟缭绕，近旁竖立有两
根檀木巨柱，气势恢宏。
LONG
  );
  set("outdoors", "tianlongsi");
  set("exits", ([
    "south": __DIR__ "square1",
    "north": __DIR__ "sanyuan",
  ]));
  set("objects", ([
    __DIR__ "npc/benyin": 1,
  ]));
  setup();
}
