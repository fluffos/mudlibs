// xiang.c writen by cry 9.18.98]

#include <ansi.h>
inherit ITEM;

void create() {
  set_name(MAG "香" NOR, ({ "xiang" }));
  set_weight(10);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "柱");
    set("long", "这是一柱香,你可以点燃它(burn)。\n");
    set("value", 10);
    set("material", "wood");
  }
  setup();
}


// burn issue --- should be move to a feature called burn
private int burning = 0;

// burn.c command api
int can_burn() {
  return 1;
}

mixed burn() {
  if (burning)
    return "这个东西已经是点燃的了。\n";
  burning = 1;
  write("你点着了" + name() + "。\n");
  set("name", "点燃的" + name());
  call_out("burn_over", 20);
  return 1;
}

int is_burning() {
  return burning;
}

protected void burn_over() {
  write(name() + "烧完了.\n");
  destruct(this_object());
}
