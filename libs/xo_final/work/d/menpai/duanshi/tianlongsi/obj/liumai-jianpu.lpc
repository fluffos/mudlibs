// liumai-jianpu 六脉神剑谱 writen by cry 9.18.98

inherit ITEM;

void create()
{
	set_name("六脉神剑谱", ({ "liumai jianpu", "jianpu" }));
	set_weight(3000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit","本");
		set("long","这是武林绝学六脉神剑的图谱。
上面涂的密密麻麻，似乎是一张山水画，又好像只是一堆破纸。\n");
		set("value",0);
		set("no_get", 1);
		set("no_give", 1);
		set("no_drop", 1);
		set("material","paper");
		set("cant_sell","伙计疑惑的看着你：“你有病呀，画的乱七八糟的破纸也来卖。”\n");
		set("skill",([
			"name"			: "liumai-shenjian",
			"gin_cost"		: 0,
			"xiuwei_required"	: 5300,
			"literate_required"	: 150,
			"bonus_jilei"		: 0,
                        "max_jibie"		: 150,
			"bonus_xiuwei"		: 3,
			"max_xiuwei"       	: 10000,
		]) );
	}
}

varargs int move(mixed dest, int silent)
{
    object ob=this_object();

    if( ob->query("cant_move") )
    {
        destruct(ob);
        return 1;
    }
    return ::move(dest, silent);
}

#include "study_jing.h"
