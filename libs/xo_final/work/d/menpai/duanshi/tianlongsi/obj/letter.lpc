// letter.c writen by cry 9.20.98

#include <ansi.h>
inherit ITEM;

void create() {
  set_name(HIW "信" NOR, ({ "letter" }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "这是一封普通的信，叠成四方，纸有些泛黄。\n");
    set("unit", "封");
    set("material", "paper");
  }
  setup();
}

void init() {
  add_action("do_open", "open");
}

int do_open(string arg) {
  object me = this_player(), ob = this_object(), obj;

  if (objectp(obj = present(arg, me)) && ob == obj) {
    if (me->query_temp("cry/jianpu") < 2) {
      tell_object(me, "你将信打开，只待看时忽然信中冒出一股白烟。\n");
      me->delete("env/immortal");
      me->die();
      destruct(ob);
      return 1;
    }
    tell_object(me, @TEXT
你将信打开，默默的读着信中的内容。

	有缘人：
	    吾自知将不久于人世，故借此书信将吾所得之秘密传于后世。
	若干年前，吾混入寺中为僧，窥得天龙寺之绝世武功「六脉神剑」，
	每日清晨，抄录其一二，耗愚三年之心血终于大成。然其所载武功
	深奥之极，始终难成。一日，稍有不慎，为天龙寺神僧枯荣发现，
	无耐技不如人，囚吾于慈悲院密室之中，终身未得逃脱。然所抄之
	「六脉神剑谱」幸得保存，被吾置于兜率大士院香炉之内。
	    有缘人得此神功之后，必无敌于天下，望其号令武林，除恶扬
	善，一改武林之大乱，吾目明已。

							五灭神偷绝笔
TEXT);
    me->set_temp("cry/jianpu", 3);
    call_out("dest_item", 2, me, ob);
    return 1;
  }
  return 0;
}

void dest_item(object me, object ob) {
  tell_object(me, HIR "你手中的信忽然自己燃烧起来，化为一堆灰烬。\n" NOR);
  destruct(ob);
}
