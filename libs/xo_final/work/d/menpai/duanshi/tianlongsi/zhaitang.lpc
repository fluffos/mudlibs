// zhaitang.c cry
inherit ROOM;

void create() {
  set("short", "斋堂");
  set("long", @LONG
一间供香客用斋的饭堂，中间放有几张长桌，每桌长近十五尺，两侧各放木
椅若干。饭堂正壁上刻有一经（jing），供人参悟。僧人们至此，都要先默诵此
经，然后再用斋饭。
LONG
  );
  set("valid_startroom", 1);
  set("outdoors", "tianlongsi");
  set("exits", ([
    "west": __DIR__ "youyou",
  ]));
  set("detail", ([
    "jing": @TEXT
	佛言。饭恶人百。不如饭一善人。
	饭善人千。不如饭一持五戒者。
	饭五戒者万。不如饭一须陀洹。
	饭百万须陀洹。不如饭一斯陀含。
	饭千万斯陀含。不如饭一阿那含。
	饭一亿阿那含。不如饭一阿罗汉。
	饭十亿阿罗汉。不如饭一辟支佛。
	饭百亿辟支佛。不如饭一三世诸佛。
	饭千亿三世诸佛。不如饭一无念无住无修无证之者。
TEXT
  ]));
  setup();
}

void init() {
  add_action("do_zuo", ({ "zuo", "sit" }));
}

int do_zuo() {
  object me = this_player();
  if (me->query("food") > me->max_food_capacity() / 2 &&
    me->query("water") > me->max_water_capacity() / 2)
    return notify_fail("你已经够饱的了，该干什么就去干什么吧！\n");
  if (me->is_busy() || me->is_fighting() || me->is_duilianing())
    tell_object(me, "你现在正忙着呢。\n");
  else {
    message_vision("$N找了张椅子坐了下来，不一会儿就有一个小沙弥端上来一菜一饭。\n"
      + "虽是素菜，但口味极佳，你开始细嚼慢咽的吃起饭来！\n", me);
    me->start_busy(3);
    me->set("food", me->max_food_capacity());
    me->set("water", me->max_water_capacity());
    call_out("over_eat", 6, me);
  }
  return 1;
}

void over_eat(object me) {
  message_vision("$N将饭菜吃的干干净净，高高兴兴的站了起来！\n", me);
}
