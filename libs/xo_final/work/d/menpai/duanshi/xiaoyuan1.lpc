#include <room.h>
#include <ansi.h>

inherit ROOM;

void create()
{
	set("short", "小院");
	set("long", @LONG
一所精巧的小院，是供王府的男性家丁居住的地方。院子西面南面都是一排
家丁们住的厢房。院子中有几棵树，还有一些石桌石凳，石桌上还刻了一张围棋
棋盘，看来有不少家丁平时得闲会手谈一局的。
LONG
	);
    set("exits", ([ 
	        "south"  : __DIR__"xiangfang3",
	        "north"  : __DIR__"xikuayuan",
			"west"   : __DIR__"xiangfang1",
        ]));
	set("outdoors", "dali");
	setup();
}                       
