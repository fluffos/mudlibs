#include <room.h>
#include <ansi.h>

inherit ROOM;

void create()
{
	set("short", "月亮门");
	set("long", @LONG
路走到这里，出现了一座小巧的月亮门。虎皮石的地基，红色的宫墙，绿色
的琉璃瓦，在周围的艳丽的大理茶花的掩映下煞是好看。这是通向东跨院的入口。
两个家丁正在门口值班。
LONG
	);
    set("exits", ([ 
	        "east"  : __DIR__"dongkuayuan",
	        "west"  : __DIR__"jiadao2",
        ]));
	set("objects", ([
			__DIR__"npc/jiading2" : 2,
		]));
	set("outdoors", "dali");
	setup();
}                       

int valid_leave(object me, string dir)
{
	object *inv;
	int i;
    inv = all_inventory( this_object() );

	if (dir=="east" && me->query("class") != "duanshi")
	{
    	for( i = 0; i < sizeof(inv) ; i++ )
	    {
	        if ( inv[i]->query("title") == BLU"镇南王府家丁"NOR
    	    && !inv[i]->is_killing() 
    	    && living( inv[i] )
	        && !userp( inv[i] ) )
	        {
        		message_vision("$N走上前一步，对$n施礼道：“这位"+RANK_D->query_respect(me)+
		        "，\n此处是本府饲养动物的地方，不方便让客人进入。”\n", inv[i], me);
        		return notify_fail("");
        		i = sizeof(inv);
            }        		
        }            
	}
	return ::valid_leave(me, dir);
}
