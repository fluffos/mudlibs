// tianhong.c 2
inherit ITEM;
void create()
{
    set_name("天虹步法", ({ "tianhong bufa", "shu", "book" }));
    set_weight(600);
    if( clonep() )
        set_default_object(__FILE__);
    else {
    set("unit","本");
    set("long","这是一本介绍天虹步法的古书，看起来是唐朝时的古物，但是也许是誊写的。\n");
    set("value", 500);
    set("material", "paper");
    set("skill", ([
        "name"         : "tianhong",
        "xiuwei_required"  : 110,
        "literate_required": 20,
        "gin_cost"     : 10+random(10),
        "max_jibie"    : 70,
        "bonus_jilei"      : 0,
        "bonus_xiuwei"     : 2,
        "max_xiuwei"       : 300,
        "bonus_combat_exp" : 10,
        "max_combat_exp"   : 10000,
        "bonus_social_exp" : 0,
        "max_social_exp"   : 0,
        ]) );
    }
}
