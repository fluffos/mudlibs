//lingpai.c高升泰的令牌
//By lala 

inherit ITEM;

void create()
{
	set_name("令牌", ({"ling pai", "pai", "letter"}));
	set_weight(250);
	if ( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "这是一块高升泰的令牌。\n");
		set("unit", "块");
		set("value", 0);
		set("material", "bamboo");
	}
	setup();
}



