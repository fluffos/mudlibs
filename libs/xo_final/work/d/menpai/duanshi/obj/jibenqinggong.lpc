// jibenqinggong.c 1
inherit ITEM;
void create()
{
    set_name("轻功入门", ({ "qinggong rumen", "shu", "book" }));
    set_weight(300);
    if( clonep() )
        set_default_object(__FILE__);
    else {
    set("unit","本");
    set("long","这是一本普普通通的轻功入门，大街上随处可见。\n");
    set("value", 20);
    set("material", "paper");
       set("skill", ([
        "name"         : "jiben-qinggong",
        "xiuwei_required"  : 0,
        "literate_required": 5,
        "gin_cost"     : 10+random(10),
        "max_jibie"    : 70,
        "bonus_jilei"      : 0,
        "bonus_xiuwei"     : 2,
        "max_xiuwei"       : 70,
        "bonus_combat_exp" : 5,
        "max_combat_exp"   : 1000,
        "bonus_social_exp" : 0,
        "max_social_exp"   : 0,
        ]) );
    }
}
