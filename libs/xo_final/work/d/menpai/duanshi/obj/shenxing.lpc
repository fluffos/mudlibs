// shenxing.c 3
inherit ITEM;
void create()
{
    set_name("化书", ({ "shen xing", "shu", "book" }));
    set_weight(1200);
    if( clonep() )
        set_default_object(__FILE__);
    else {
    set("unit","本");
    set("long","这是谭子的化书，是道家最高深秘奥的经典。\n");
    set("value", 300);
    set("material", "paper");
       set("skill", ([
        "name"         : "shenxing",
        "xiuwei_required"  : 320,
        "literate_required": 40,
        "gin_cost"     : 10+random(10),
        "max_jibie"    : 100,
        "bonus_jilei"      : 0,
        "bonus_xiuwei"     : 4,
        "max_xiuwei"       : 500,
        "bonus_combat_exp" : 30,
        "max_combat_exp"   : 5000,
        "bonus_social_exp" : 0,
        "max_social_exp"   : 0,
        ]) );
    }
}
