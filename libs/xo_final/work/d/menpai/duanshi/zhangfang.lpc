inherit ROOM;

void create() {
  set("short", "王府帐房");
  set("long", @LONG
这里是镇南王府的帐房，光线明亮，当面是一个五尺长的柜台，樟木制的柜
面被摸的锃光瓦亮，靠墙是一排放帐本的橱，橱门虚掩着。平时帐房由花老爷子
掌管，王府的日常开销和下人仆役们的工钱都在这里支取。最近花老爷子身体不
好，暂由管杂务的霍先生主理。东面是后厢房，西面就是大院了。
LONG
  );
  set("exits", ([
    "west": __DIR__ "qianyuan",
    "east": __DIR__ "houxiang",
  ]));
  set("objects", ([
    __DIR__ "npc/cui_baiquan": 1,
  ]));
  setup();
  //place_program(ROOM);
