#include <room.h>
#include <ansi.h>

inherit DOOR_ROOM;


void create() {
  set("short", "王爷卧室");
  set("long", @LONG
这里是镇南王爷的卧室，房间宽敞明亮，东面一扇雕刻精美的纸窗，窗纸
上绘的是百鸟争鸣。透过纸窗可见一大艳丽异常的花园，园内以茶花为主，兼有
各地名花。东面一张布置华丽的床，北面则挂有一幅「侍女图」。室内正中一张
檀木圆桌，段正淳正在桌旁饮酒，还不时自言自语几句。
LONG
  );
  set("exits", ([
    "south": __DIR__ "zhengyuan",
  ]));
  set("objects", ([
    __DIR__ "npc/zhengchun": 1,
  ]));
  create_door("south", ([
    "name": "卧室门",
    "id": ({ "south", "door" }),
    "status": 1,
    "other_side_dir": "north",
  ]),
    "north");
  setup();
}
