#include <room.h>
#include <ansi.h>

inherit ROOM;

void create()
{
	set("short", "鸽房");
	set("long", @LONG
这儿是王府的鸽房。养着上百只鸽子。这些鸽子是专门训练来传递消息的信
鸽，它们不但可以传递信件，还可以传递小件的重要物事。几个家丁举着面小红
旗，轰着鸽子，准备带它们出去训练一下。一个身份高些的家丁走来走去地监督
他们。
LONG
	);
    set("exits", ([ 
	        "north"  : __DIR__"dongkuayuan",
        ]));
	set("objects", ([
			__DIR__"npc/jiading3" : 2,
			__DIR__"npc/jiading2" : 1,
		]));
	setup();
}                       

