#include <ansi.h>
inherit F_FIRST;

void create() {
  set("master_dir", __DIR__ "npc" + "/xuzhu");
  set("start_room", "/d/menpai/tianshan/xianchou");
  ::create();
}

string zm_apply() {
  object ob = this_player();
  if (query("gender", ob) != "女性")
    return "灵鹫宫只有女子才能接任掌门弟子一职。";
  return ::zm_apply();
}
