// This program is a part of NT MudLIB

#include <ansi.h>

inherit F_NEW_MASTER;

#include "tianshan_master.h"

void create() {
  set_name("天山童姥", ({ "tong lao", "tong", "lao" }));
  set("long",
    "她就是" + HIC "「灵鹫宫」" NOR + "的开山祖师.\n" +
    "乍一看似乎是个十七八岁的女子,可神情却是老气横秋.\n" +
    "双目如电,炯炯有神,向你瞧来时,自有一股凌人的威严.\n");
  set("title", HIC "灵鹫宫主人" NOR);
  set("gender", "女性");
  set("per", 20);
  set("age", 96);
  set("nickname", HIR "唯我独尊" NOR);
  set("shen_type", 0);
  set("attitude", "peaceful");

  set("str", 25);
  set("int", 35);
  set("con", 40);
  set("dex", 40);

  set("combat_exp", 5000000);

  set_wugong("bahuang-gong", 300, 300, 1);
  set_wugong("yuxiao-xianfeng", 300, 300, 1);
  set_wugong("liuyang-zhang", 300, 300, 1);
  set_wugong("yueying-wu", 300, 300, 1);

  set_xiuwei_level_by_type("force", 6);
  set_xiuwei_level_by_type("dodge", 7);
  set_xiuwei_level_by_type("long", 8);
  set_xiuwei_level_by_type("unarmed", 8);
  set_xiuwei_level_by_type("zonggang", 6);

  create_family("灵鹫宫", 1, "主人");

  ::create();
  setup();

  carry_object("/d/menpai/tianshan/obj/qingyi")->wear();
  carry_object("/d/menpai/tianshan/obj/doupeng")->wear();
}

int accept_betray(object who) {
  return 1;
}

int accept_chushi(object who) {
  return 1;
}
