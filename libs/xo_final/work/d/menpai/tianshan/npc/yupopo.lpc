#include <ansi.h>

inherit F_NEW_MASTER;

#include "tianshan_master.h"

void create() {
  set_name("余婆婆", ({ "yu popo", "yu", "popo" }));
  set("long", @LONG
余婆婆是缥缈峰灵鹫宫中九天九部中昊天部的
首领。她如今年过半百，跟随童姥多年，出生
入死，饱经风霜。
LONG);
  set("title", "缥缈缝灵鹫宫");
  set("nickname", HIW "昊天部首领" NOR);
  set("gender", "女性");
  set("age", 60);
  set("attitude", "peaceful");
  set("str", 30);
  set("int", 30);
  set("con", 30);
  set("dex", 30);

  set("combat_exp", 1000000);

  set_wugong("xiaowuxiang", 150, 150, 1);
  set_wugong("yunfeng-bianfa", 300, 300, 1);
  set_wugong("qinggong", 150, 150, 1);

  set_xiuwei_level_by_type("force", 3);
  set_xiuwei_level_by_type("dodge", 3);
  set_xiuwei_level_by_type("long", 2);
  set_xiuwei_level_by_type("zonggang", 3);

  create_family("灵鹫宫", 2, "首领");

  ::create();
  setup();

  carry_object("/d/menpai/tianshan/obj/qingyi")->wear();
  carry_object("/d/menpai/tianshan/obj/doupeng")->wear();
  carry_object(SWORD_DIR "changjian")->wield();
  add_money("silver", 15);
}
