// yue-wife.c 岳夫人

#include <ansi.h>

inherit F_NEW_MASTER;

#include "huashan_master.h"

void create() {
  set_name("宁中则", ({ "ning zhongze", "ning", "zhongzhe", "yue wife" }));
  set("nickname", "淑女剑");
  set("gender", "女性");
  set("class", "swordsman");
  set("age", 50);
  set("long", "岳夫人原姓宁，闺名宁中则，"
    "是岳不群的师妹，也是他的妻子。\n");
  set("attitude", "peaceful");
  set("shen_type", 1);

  set("str", 24);
  set("int", 25);
  set("con", 23);
  set("dex", 22);

  set("combat_exp", 760000);

  set_wugong("mingyu-gong", 300, 300, 1);
  set_wugong("baxian-jian", 300, 300, 1);
  set_wugong("zuixian-wangyue", 300, 300, 1);

  set_xiuwei_level_by_type("force", 6);
  set_xiuwei_level_by_type("dodge", 7);
  set_xiuwei_level_by_type("sword", 7);
  set_xiuwei_level_by_type("zonggang", 6);

  set_temp("apply/attack", 220);
  set_temp("apply/dodge", 220);
  set_temp("apply/parry", 600);
  set_temp("apply/damage", 150);
  set_temp("apply/unarmed_damage", 150);
  set_temp("apply/armor", 600);

  create_family("华山派", 13, "掌门夫人");

  ::create();
  setup();

  carry_object(SWORD_DIR "changjian")->wield();
  carry_object(CLOTH_DIR "cloth0")->wear();
}

