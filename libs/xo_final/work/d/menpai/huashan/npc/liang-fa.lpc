// liang-fa.c
#include <ansi.h>

inherit F_NEW_MASTER;

#include "huashan_master.h"

void create() {
  set_name("梁发", ({ "liang fa", "liang", "fa" }));
  set("nickname", "闭嘴佛");
  set("gender", "男性");
  set("age", 30);
  set("long", "梁发是岳不群的第三弟子。\n");
  set("attitude", "peaceful");

  set("str", 26);
  set("con", 30);
  set("int", 24);
  set("dex", 30);

  set("combat_exp", 50000);
  set("shen_type", 1);

  set_wugong("zixia-gong", 150, 150, 1);
  set_wugong("qingfeng-jianfa", 300, 300, 1);
  set_wugong("zhuifeng-bufa", 150, 150, 1);

  set_xiuwei_level_by_type("force", 3);
  set_xiuwei_level_by_type("dodge", 3);
  set_xiuwei_level_by_type("sword", 4);
  set_xiuwei_level_by_type("zonggang", 3);

  create_family("华山派", 14, "弟子");

  ::create();
  setup();

  carry_object(SWORD_DIR "changjian")->wield();
  carry_object(CLOTH_DIR "cloth1")->wear();
}
