// lao-denuo.c

#include <ansi.h>

inherit F_NEW_MASTER;

#include "huashan_master.h"

void create()
{
    set_name("劳德诺", ({ "lao denuo","lao","denuo" }) );
    set("nickname", "老好人");
    set("gender", "男性");
    set("age", 61);
    set("long", "劳德诺是岳不群的二弟子。\n");
    set("attitude", "peaceful");

    set("str", 26);
    set("con", 30);
    set("int", 24);
    set("dex", 30);

    set("combat_exp", 150000);
    set("shen_type", -1);

    set_wugong("zixia-gong", 150, 150, 1);
    set_wugong("songshan-jianfa", 300, 300, 1);
    set_wugong("zhuifeng-bufa", 150, 150, 1);

    set_xiuwei_level_by_type("force", 3);
    set_xiuwei_level_by_type("dodge", 3);
    set_xiuwei_level_by_type("sword", 4);
    set_xiuwei_level_by_type("zonggang", 3);

    set_temp("apply/damage", 100);
    set_temp("apply/armor", 100);

    set("apply/dodge", 100);

    create_family("华山派", 14, "弟子");

    ::create();
    setup();

    carry_object(SWORD_DIR"changjian")->wield();
    carry_object(CLOTH_DIR"cloth1")->wear();
}

void relay_emote(object me, string verb)
{
    if (verb != "beg")
    {
        switch (random(5))
        {
        case 0:
            command("bored");
            break;

        case 1:
            command("shzi");
            break;

        case 2:
            command("@@");
            break;

        case 3:
            command("cold");
            break;

        default:
            command("heihei");
            break;
        }
        return;
    }

    if( query("family/family_name", me) != "华山剑宗" )
    {
        command("poor"+query("id", me));
        return;
    }

    command("sigh");
    command("say 这位" + RANK_D->query_respect(me) +
        "！入了剑宗，后悔了吧？不要紧，回头是岸嘛！");
    set_temp("beg_huashan", 1, me);
}
