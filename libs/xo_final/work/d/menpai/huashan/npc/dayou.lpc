// dayou.c 

#include <ansi.h>

inherit F_NEW_MASTER;

#include "huashan_master.h"

void create() {
  set_name("陆大有", ({ "lu dayou", "lu", "dayou" }));
  set("nickname", "六猴儿");
  set("long",
    "陆大有身材很瘦，又长的尖嘴猴腮的，但别看他其貌不扬，他在\n"
    "同门中排行第六，是华山派年轻一代中的好手。肩上坐着一只小\n"
    "猴，一对眼睛四处乱转。\n");
  set("gender", "男性");
  set("age", 26);
  set("attitude", "peaceful");
  set("shen_type", 1);
  set("str", 23);
  set("int", 23);
  set("con", 24);
  set("dex", 28);

  set("combat_exp", 50000);

  set_wugong("zixia-gong", 150, 150, 1);
  set_wugong("huashan-jianfa", 150, 150, 1);
  set_wugong("zhuifeng-bufa", 300, 300, 1);

  set_xiuwei_level_by_type("force", 3);
  set_xiuwei_level_by_type("dodge", 3);
  set_xiuwei_level_by_type("sword", 4);
  set_xiuwei_level_by_type("zonggang", 3);

  create_family("华山派", 14, "弟子");

  ::create();
  setup();
  carry_object(SWORD_DIR "changjian")->wield();
}
