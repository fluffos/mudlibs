// This program is a part of NITAN MudLIB
// gao-laozhe.c

#include <ansi.h>

inherit F_NEW_MASTER;

#include "huashan_master.h"

void create() {
  set_name("高老者", ({ "gao laozhe", "gao" }));
  set("title", HIR "华山第十二代长老" NOR);
  set("long",
    "他就是华山的长老高老者。一副浑不在乎的模样，开朗乐天，万事不萦怀，\n"
    "但事事追随他的师兄矮老者。\n");
  set("gender", "男性");
  set("age", 65);
  set("attitude", "peaceful");
  set("shen_type", 1);
  set("str", 26);
  set("int", 25);
  set("con", 28);
  set("dex", 25);

  set("combat_exp", 1750000);

  set_wugong("zixia-gong", 250, 250, 1);
  set_wugong("kuangfeng-jian", 300, 300, 1);
  set_wugong("lianhuan-bufa", 300, 300, 1);

  set_xiuwei_level_by_type("force", 5);
  set_xiuwei_level_by_type("dodge", 5);
  set_xiuwei_level_by_type("sword", 6);
  set_xiuwei_level_by_type("zonggang", 5);

  create_family("华山派", 12, "弟子");

  set("inquiry", ([
    "紫霞神功": "那是本门无上的内功心法。据说紫霞有个大秘密，可惜已失传多年了。\n",
    "密室": "你胡说八道些甚麽？\n",
  ]));

  ::create();
  setup();
  carry_object(CLOTH_DIR "cloth1")->wear();
  carry_object(SWORD_DIR "changjian")->wield();
}
