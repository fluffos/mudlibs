// This program is a part of NITAN MudLIB

#include <ansi.h>

inherit F_NEW_MASTER;

#include "huashan_master.h"

void create()
{
    set_name("矮老者", ({ "ai laozhe", "ai" }));
    set("title", HIG "华山第十二代长老" NOR);
    set("long", "他就是华山的长老矮老者。一张严肃"
            "威严的脸，望而生畏。\n");
    set("gender", "男性");
    set("attitude", "peaceful");
    set("shen_type", 1);
    set("str", 31);
    set("int", 35);
    set("con", 31);
    set("dex", 32);
    set("age", 66);

    set("combat_exp", 1900000);

    set_wugong("zixia-gong", 250, 250, 1);
    set_wugong("lianhuan-jianfa", 300, 300, 1);
    set_wugong("lianhuan-bufa", 300, 300, 1);

    set_xiuwei_level_by_type("force", 5);
    set_xiuwei_level_by_type("dodge", 5);
    set_xiuwei_level_by_type("sword", 5);
    set_xiuwei_level_by_type("zonggang", 5);

    create_family("华山派", 12, "弟子");

    set("inquiry", ([
        "紫霞神功" : "那是本门无上的内功心法。据说紫霞密笈缺了最後一页，可惜我至今仍无法叁透，唉！\n",
        "密室"     : "你胡说八道些甚麽？\n",
    ]));

    set("env/wimpy", 60);

    ::create();
    setup();
    carry_object(CLOTH_DIR"cloth1")->wear();
    carry_object(SWORD_DIR"changjian")->wield();
}

