#include <ansi.h>
inherit __DIR__"ShennongNpc.lpc";



void create()
{
    set_name("高老者", ({ "gao laozhe", "gao", "laozhe", "gaolaozhe", }) );
    set("class_score/神农帮",       600);
    set("title", BLU"神农帮香主"NOR);
    create_family("神农帮", 1, "香主");
    set("combat_exp",    500000);
    set("social_exp",   100000);
    set("negative_score",  500);
    set("max_force",       1000);
    set("force",           1000);
    set("force_factor",     50);
    set("max_kee",         600);
    set("max_sen",         1500);
    set("kee",             1500);
    set("sen",             600);
    set("age",              50);
    set("int",              27);
    set("long", @LONG
    一个身材甚高的老者，双手十指如鸟爪。看来是长于鹰爪功一类的武功。
听说原来是个禁军头领，后来革职了，也不知是不是因为上头知道了他和神农帮的关系。
LONG
    ); 
    
    set_wugong("unarmed",           120, 120, 0);
    set_wugong("yingzhua-shou",     100, 100, 1);
    set_wugong("jinjun-qiangfa",    150,  150, 1);
//    set_wugong("meihua-bu",    200, 200, 1);
    set_wugong("haoran-zhengqi",      100,  100, 1);
  

    set_xiuwei_by_type("unarmed",   2200);
    set_xiuwei_by_type("dodge",     1901);
    set_xiuwei_by_type("long",     3000);

    setup();

    carry_object( CLOTH_DIR + "cloth2" )->wear();
//    carry_object( SHORT_DIR + "yaochu" )->wield();
    add_money( "coin", 20 + random(20) );
}
        