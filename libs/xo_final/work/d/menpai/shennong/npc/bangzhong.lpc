// by lala, 1998-01-23

inherit __DIR__"ShennongNpc.lpc";



void create()
{
    set_name("帮众", ({ "bang zhong", "bangzhong", }) );
    set("age",  14 + random(50));
    
    set_wugong("unarmed",           20 + random(40), 20 + random(40), 1);
    set_wugong("blade",             20 + random(40), 30 + random(40), 1);
    set_wugong("jiben-qinggong",    20 + random(40), 30 + random(40), 1);
    //set_wugong("shaolin-xinfa",     15, 15, 1);

    set_xiuwei_by_type("unarmed",   random(100));
    set_xiuwei_by_type("blade",     random(100));
    set_xiuwei_by_type("dodge",     random(100));

    setup();

    carry_object( CLOTH_DIR + "cloth2" )->wear();
    switch( random(3) )
    {
        case 0:
            break;
        case 1:
            carry_object( BLADE_DIR + "kuandao" )->wield();
            break;
        case 2:
            carry_object( SHORT_DIR + "yaochu" )->wield();
            break;
    }
    add_money( "coin", 20 + random(20) );
}


        
