int do_cai(string mogu)
{
    object me=this_player();
    if(mogu!="mo gu" && mogu!="mogu" && mogu!="蘑菇")
        return 0;
    me->add("gin",-20);
    me->add("sen",-7);
    write("你在败叶之中仔细查看————\n");
    if(kl_mark("query",me,"tree/cai",0,0))
    {tell_object(me,"无论怎么样也找不到想要的蘑菇了。\n");
    return 1;}
    if(kl_mark("query",me,"tree/have_cai",0,0)!=0)
    {tell_object(me,"竟然找不到一朵象样的蘑菇！\n");
    return 1;}
    if(random(20)==0) {
        new(__DIR__"obj/mogu1")->move(me);
        kl_mark("set",me,"tree/have_cai",1,0);
        write("你发现了一朵长得很鲜艳的"RED"红"NOR"蘑菇————\n");
        }
    if(random(20)==1) {
        new(__DIR__"obj/mogu2")->move(me);
        kl_mark("set",me,"tree/have_cai",1,0);
        write("你发现了一朵长得很鲜艳的"CYN"青"NOR"蘑菇————\n");
        }
    else write("竟然找不到一朵象样的蘑菇！\n");
    kl_mark("set",me,"tree/cai",1,0);
    return 1;
}
