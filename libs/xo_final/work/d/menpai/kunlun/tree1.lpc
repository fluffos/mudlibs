#include "kl_r.h"



void create()
{
    set( "short", "丛林" );
    set( "long", @LONG
这里没有阳光，只有那望不到头的象墙壁似的古树。树上爬满了粗粗细细的
弯弯曲曲的藤萝－－有的藤萝从树枝上吊下来，又在那湿漉漉的、充满了恶臭的
草地上生了根。这里没有道路，只有那深没足踝的、一步一滑的泥土、腐草和败
叶。
LONG );
    set("exits", ([ /* sizeof() == 8 */
    "west" : __FILE__,
    "southeast" : __FILE__,
    "northwest" : __FILE__,
    "north" : __FILE__,
    "southwest" : __FILE__,
    "northeast" : __FILE__,
    "south" : __FILE__,
    "east" : __FILE__,
]) );
    set("not_startroom",1);
    setup();
}
//

void init()
{
    object me=this_player(),*inv;
    kl_mark("set",me,"tree/catch",0,0);
    kl_mark("set",me,"tree/tear",0,0);
    kl_mark("set",me,"tree/cai",0,0);
    inv = all_inventory( this_object() );

  //      add_action( "do_catch","catch" );
 //       add_action( "do_tear", "tear" );
  //     add_action( "do_cai", ({"cai", "dig"}) );

}
int valid_leave(object me,string dir)
{
   object jungle = environment(me);

    if( dir == "north" && 
        kl_mark("query",me,"tree/enter",0,0)> 50 && 
        me->query("kar")+random(100)>100 ){
         
         me->move(__DIR__"xuanya");
         kl_mark("delete",me,"tree",0,0);
         return notify_fail("你眼前突然一亮，敢情已经到了一个悬崖边上！\n");         
    }
    if(kl_mark("query",me,"tree/enter",0,0)==0&&dir=="southeast"){
       me->move(__DIR__"shandao03");
         kl_mark("delete",me,"tree",0,0);
         destruct(jungle);
         return notify_fail("你眼前光线稍微亮了一点，原来已经走出了丛林。\n");
    }
    if(dir=="southeast") kl_mark("add",me,"tree/enter",-1,0);
    else kl_mark("add",me,"tree/enter",1,0);
    me->add( "sen", -10 );
    me->add( "gin", -10 );
    tell_object(me,"在丛林里面转来转去真不是个滋味。\n");

    return 1;
}


int do_catch(string what)
{
    object me = this_player();
    if( what!="diao"&&what!="貂" ) return 0;
    me->add("sen",-30);
    me->add("gin",-10);
    write("你轻松地爬上一棵古树，拨开藤萝————\n");
    if(kl_mark("query",me,"tree/catch",0,0)!=0) 
    {tell_object(me,"好象刚才已经看过了，什么也没有的说。\n");
    return 1;}    
    switch (random(20)) {
      case 0:
       if(random(5)==0) {
         new(__DIR__"obj/diaopi1")->move(me);
         write("你发现了一只"WHT"银貂"NOR"，迅速抓住了它————\n");
         write("你很有技巧地将"WHT"银貂皮"WHT"给扒了下来，小心地放进了怀里。\n");
        }
       else write("你什么也没有发现。\n"); 
       break;
      case 1:
         new(__DIR__"obj/diaopi2")->move(me);
         write("你发现了一只"YEL"黄貂"NOR"，迅速抓住了它————\n");
         write("你很有技巧地将"YEL"黄貂皮"WHT"给扒了下来，小心地放进了怀里。\n");
       break;
      default:
         write("你什么也没有发现！\n");
       break;
     }
    kl_mark("set",me,"tree/catch",1,0);
    return 1;
}

int do_tear(string muer)
{
    object me=this_player();
    if(muer!="mu er" && muer!="muer" && muer!="木耳")
        return 0;
    me->add("gin",-20);
    me->add("sen",-7);
    write("你在身旁的一棵古树上摸索————\n");
    if(kl_mark("query",me,"tree/tear",0,0)) 
    {tell_object(me,"无论怎么样也不能在这棵树上找到好的木耳了。\n");
    return 1;}    
    if(kl_mark("query",me,"tree/have_tear",0,0)!=0)
    {tell_object(me,"竟然找不到一丛好的木耳！\n");
    return 1;}  
    if(random(20)==0) {
        new(__DIR__"obj/muer")->move(me);
        kl_mark("set",me,"tree/have_tear",1,0);
        write("你发现了一丛长势良好的木耳————\n");
        }
    else write("你找来找去没有发现一丛象样的木耳——\n");
    kl_mark("set",me,"tree/tear",1,0);
    return 1;
}

