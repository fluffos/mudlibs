#include "kl_r.h"

string do_look();


void create()
{
    set( "short", "前厅" );
    set( "long", @LONG
这里就是前厅，以方砖铺地，南北两头有回廊，往里进去是大厅，往外面走
是练武场。一架浓密的葡萄架上，绿珠般的垂实，浓荫迎地，清凉蔽体。从梁柱
的气势就可以看出这里的富贵气象。
LONG );
    set( "item_desc",([
    "梁柱":(:do_look:),
]) );
    set( "exits", ([ /* sizeof() == 4 */
    "west" : __DIR__"wuchang",
    "north" : __DIR__"huilang02",
    "east" : __DIR__"dating",
    "south" : __DIR__"huilang04",
]) );

    set( "objects", ([
    __DIR__"npc/nandizi" : random(1)+1,
    __DIR__"npc/nvdizi" : random(1)+1,
]) );

    setup();
}

string do_look()
{
    object me=this_player();
    message_vision( "$N正在盯着这里的梁梁柱柱看，好象在欣赏什么。\n", me );
    return( @TEXT
      你可以一条巨大的“龙”盘旋在柱子上。     
TEXT);
}