#include "kl_r.h"



void create()
{
    set("short", "天井");
    set("long", @LONG
天井大约十几平米，种植着几课沙棠树。从这里仰望碧空，信步遐思，可以
想得很远很远。大自然乘兴而来，日晖月影，四季常照，风、雨、霜、雪，轮番
光顾。蝶儿来这里欢舞，蝉儿来这里高歌，小鸟来这里玩耍，秋蛰来这里低吟。
静观宇宙之大，其意境尽然在这个小小天井里。
LONG );
    set("exits", ([ /* sizeof() == 3 */
