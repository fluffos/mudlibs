#include "kl_r.h"
string do_dir();
string  *leave =({
    "west", "north", "northwest", "southwest",
    "northeast", "southeast", "south", "east", });

void create()
{
    set( "short", GRN"竹林"NOR );
    set( "long", @LONG
一片茂密的竹林，其势足有三四人高，走来走去，俱是成簇成垄的青竹，置
身其间，只感到散漫清朗，纤巧清秀，竹荫浓郁，使得幽谷更加清幽。
LONG );
    set( "no_clean_up", 0 );
    set( "exits", ([ 
    "southeast" : __DIR__"zhulin1",
    "west" : __DIR__"xiaodao01",

]) );
/*
    set("item_desc", ([
    "east" : (:do_dir:),
    "west" : (:do_dir:),
    "north" : (:do_dir:),
    "south" : (:do_dir:),
    "southeast" : (:do_dir:),
    "northwest" : (:do_dir:),
    "northeast" : (:do_dir:),
    "southwest" : (:do_dir:),
]) );
*/
    set("not_startroom",1);
    setup();
}

void init()
{
    object me=this_player();
    if(!kl_mark("query",me,"zhulin",0,0)){
    add_action("ba_zhusun",({"ba","dig"}) );
    add_action("do_chase","chase");
    }

}

string do_dir()
{
    return(WHT"一片清新幽静的竹林，怎么也看不够！\n"NOR);
}
  
int ba_zhusun(string str)
{
    object me = this_player();
    if( !str ) return 0;
    if( str != "竹笋" && str!="zhusun" && str!="zhu sun" ) return 0;
//    if( kl_mark("query",me,"zhulin/zhusun",0,0)) return 0;
//    if( kl_mark("query",me,"zhulin/rec",0,0)!=1 ) return 0;
    if( me->query_temp("kunlun/zhusun")>4)
	    return notify_fail("你已经拔了好几根了。\n");
    new(__DIR__"obj/zhusun")->move(this_player());
    message_vision( "$N从竹叶下面拔出一棵竹笋！\n",this_player());
    me->add_temp("kunlun/zhusun",1);
    //    kl_mark("set",me,"zhulin/zhusun",1,0);
    return 1;
}

int do_chase(string str)
{
    object me = this_player();
    if( !str ) return 0;
    if( str != "白花蛇" && str!="bai she" && str!="baishe" ) return 0;
 //   if( kl_mark("query",me,"zhulin/snake",0,0) ) return 0;
 //   if( kl_mark("query",me,"zhulin/rec",0,0)!=3 ) return 0;
    if (me->query_temp("kunlun/baishe")>5)
	    return notify_fail("你已经抓了六条白蛇了。以后再说吧。\n");
    message_vision("$N向小"HIY"蛇"NOR"串去的方向追逐过去———\n",this_player());
    new(__DIR__"npc/baishe")->move(environment(this_player()));
    message_vision( "突然一条白花蛇从竹叶下面串了出来——\n",this_player());
    me->add_temp("kunlun/baishe",1);
    //   kl_mark("set",me,"zhulin/snake",1,0);
    return 1;
}
