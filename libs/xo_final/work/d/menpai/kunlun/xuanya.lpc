// 悬崖
// Ffox 96-5-14 16:11

#include "kl_r.h"



void create() {
  set("short", "悬崖边");
  set("long", @LONG
眼前是一道万丈峡谷,往下看去是万丈深渊。漫谷的云雾，在脚底飘来飘去。
人站在这里，不禁将心提到了嗓子眼，这里不是久留之地，还是速速离去为好。
不过要自杀的话，这里到是一个理想的场所，只需轻轻往下一跳……
LONG);
  set("item_desc", ([
    "down": "往下一望，让人头晕目眩——\n",
  ]));
  set("outdoors", "kunlun");
  set("exits", ([
    "southeast": __DIR__ "tree1",
  ]));
  setup();
}

void init() {
  add_action("do_jump", "jump");
}

int do_jump(string str) {
  object me = this_player();
  if (str != "down") return 0;


  PLACE_D->drop_all_users(this_player());
  message_vision("$N奋力跃起，向那万丈深渊跳了下去。\n", me);
  if (random(100) + me->query("kar") < 35) me->die();
  else {
    write(HIW "你感觉身体被一棵树挂了一下！\n" NOR);
    me->uncouncious();
    me->move(__DIR__ "juebi");
  }
  return 1;
}

int valid_leave(object me, string dir) {
  object jungle;
  if (dir == "south") {
    jungle = new(__DIR__ "tree1");
    write("你走入了一片黑森森的丛林！\n");
    kl_mark("set", me, "tree/enter", 49, 0);
    me->move(jungle);
    tell_room(this_object(), me->query("name") + "串入丛林当中，立时消失了。\n", me);
    return notify_fail(HIW "你走入了一片黑森森的丛林！\n" NOR);
  }
  return ::valid_leave(me, dir);
}
