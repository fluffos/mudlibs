inherit ITEM;
inherit F_LIQUID;



void create()
{
    set_name( "木桶", ({ "mu tong","tong" }) );
    set_weight(3000);
        if( clonep() )
	    set_default_object(__FILE__);
        else {
            set("long", "木桶，可以用来装水。\n");
            set("unit", "对");
            set("value", 90);
            set("max_liquid", 2000);
        }

	set("liquid", ([
		"name": "清水",
		"remaining": 30,
	]) );
}

