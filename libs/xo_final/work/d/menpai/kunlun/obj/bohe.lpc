#include "kl_o.h"



void create()
{
    set_name( "薄荷", ({ "bo he","bohe" }) );
    if ( clonep() )
        set_default_object(__FILE__);
    else {
        set( "unit", "把" );
        set( "long", "一把薄荷，用作调味品，也可入药。\n");
        set( "value", 10);
    }
    setup();
}
