// chongcao.c 虫草
// Ffox 98-4-20 20:20

#include "kl_o.h"



void create()
{
    set_name( "虫草", ({ "chong cao", "chongcao","cao" }) );
    if ( clonep() )
        set_default_object(__FILE__);
    else {
        set( "unit", "株" );
        set( "long", "虫草者，冬虫夏草者也，可以入药。看上去与普通的草儿没有大的区别。\n");
        set( "value", 7000);
    }
    setup();
}
