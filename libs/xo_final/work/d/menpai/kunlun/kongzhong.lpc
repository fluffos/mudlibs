// kongzhong.c 空中
// Ffox 96-5-14 15:48

#include "kl_r.h"



void create()
{
	set("short","空中");
	set("long",
YEL"身在空中，寒风呼啸吹过耳际…………\n"NOR
 );
    set( "not_startroom",1);
        setup();
}
void init()
{
    object me = this_player();
    add_action("do_look","look");
    write(YEL"你在空中迅速地往下降落，速度越来越快……\n"NOR);
//    remove_call_out("do_check");
    call_out("do_check",6,me);
}

int do_look()
{
    write(HIR"生死关头，千万大意不得！！！！\n"NOR);
    return 1;
}

void do_check()
{
    object me = this_player();
    if( (me->query("kar")+random(100)) <115 ) {
        write(HIY"突然间，你失去了知觉………\n"NOR);
            me->set("eff_kee",me->query("eff_kee")/2);
            me->set("eff_sen",me->query("eff_sen")/2);
            me->set("eff_gin",me->query("eff_gin")/2);
            me->set("water",me->query("water")/2);
            me->set("food",me->query("food")/2);
            me->set("sen",1);
            me->set("gin",1);
            me->set("kee",1);
            me->set("force",me->query("force")/2);
            me->move(__DIR__"gudi2.lpc",1);
        if(me->query("eff_kee")<me->query("max_kee")/6)
        me->die();
        else if (!random(10))
        me->die();
        else
        me->uncouncious();
        return;
    }
    tell_object( me, HIR"你耳边突然听得一声响，感觉接触到了实地！\n"NOR );
    me->move( __DIR__"gaodi" );
    return;
}

