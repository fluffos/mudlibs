// cuigu.c    翠谷
// Ffox 98-5-17 11:25

#include "kl_r.h"

void initial_setting();
int clean_book(string);



void create() {
  set("short", "翠谷");
  set("long", @LONG
眼前一座高峰阻路。放眼四望，旦见翠谷四周高山环绕，似乎亘古以来从未
有人迹到过。四面雪峰插云，险峻陡绝计无法攀援而入。只见草地上有七八头野
山羊低头吃草，见了人也不惊避，树上十余只猴儿跳跃相戏，看来虎豹之类猛兽
身子笨重，不能逾峰而至。
LONG);
  set("item_desc", ([
    "树": "不知名的果树，长着些野果子，可以摘下来<pick>，不知可不可以吃。\n",
    "tree": "不知名的果树，长着些野果子，可以摘下来<pick>，不知可不可以吃。\n",
    "qingtai": "张在石壁上的一些青苔，长势很好。\n",
    "青苔": "张在石壁上的一些青苔，长势很好。\n",
    "qing tai": "张在石壁上的一些青苔，长势很好。\n",
  ]));
  set("exits", ([
    "south": __DIR__ "cuigu",
  ]));
  set("outdoors", "kunlun");
  initial_setting();
  setup();
}

void init() {
  add_action("do_push", "push");
  add_action("do_hide", "hide_book");
  add_action("do_pick", "pick");
}

int do_pick(string arg) {
  object me = this_player();
  if (arg != "fruit")
    return notify_fail("你要从树上摘什么？\n");
  if (present("fruit", me))
    return notify_fail(GRN "吃完了再摘，树上很多的，没有人和你抢。\n" NOR);
  new(__DIR__ "obj/yeguo")->move(me);
  message_vision("$N从树上轻巧地摘下一枚野果。\n", me);
  return 1;
}

int do_push(string what) {
  object me = this_player();
  object book;
  if (what != "qing tai" && what != "青苔")
    return 0;
  if (!query("have_book")) {
    write("这里的青苔后面已经没有东西了。\n");
    return 1;
  }
  message_vision("$N将这里的青苔仔细地拨开，露出一个小小的洞穴。\n", me);
  message_vision("$N从洞穴里面取出一个小包裹，打开来，是一本书。\n", me);
  book = new(__DIR__ "obj/gujian-jue");
  book->set("owner", me->query("id"));
  book->move(me);
  delete("have_book");
  write("好象是一本关于武功的书籍。\n");
  return 1;
}

void initial_setting() {
  object *ob_list;
  int old_size;
  clean_book(__DIR__ "obj/gujian-jue.lpc");
  ob_list = children(__DIR__ "obj/gujian-jue.lpc");
  old_size = sizeof(ob_list);
  if (old_size > 0) return;
  set("have_book", 1);
  return;
}

int clean_book(string str) {
  object *ob_list;
  int old_size, i;
  ob_list = children(str);
  old_size = sizeof(ob_list);
  ob_list->clean_up();
  for (i = 0; i < sizeof(ob_list); i++) {
    if (ob_list[i] && !ob_list->query("owner")) {
      destruct(ob_list[i]);
    } else if (!objectp(ob_list[i]));
    else if (!environment(ob_list[i])) {
      destruct(ob_list[i]);
    }
  }
  ob_list -= ({ 0 });
  return 1;
}

int do_hide() {
  object me = this_player();
  object obj;
  string arg = "gujian jue";
  if (!objectp(obj = present(arg, me)))
    return notify_fail("你要藏什么东西呢？\n");
  destruct(obj);
  write(HIY "你小心地将这本书用布包裹！\n" NOR);
  message_vision("$N将一个小包裹放进了那个小洞穴，用青苔遮好。\n", me);
  set("have_book", 1);
  return 1;
}
