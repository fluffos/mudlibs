#include "kl_r.h"



void create() {
  set("short", "石屋");
  set("long", @LONG
这里是一个小小的石屋，屋内摆着一个火盆，从屋外进到这里，令人顿时感
觉十分温暖，屋内摆设十分简朴，只有一张石床，一张石桌，几个石凳。能在这
样的地方长期住下去的人应该是一位隐士了。
LONG
  );
  set("exits",
    ([
      "out": __DIR__ "gaodi",
    ]));

  set("objects", ([
    __DIR__ "npc/shenmi": 1,
  ]));
  setup();
}

void init() {
  add_action("do_zuo", "zuo");
}
int do_zuo() {
  object me = this_player();
  me->set("water", me->max_water_capacity());
  me->set("food", me->max_food_capacity());
  write("你坐在石桌旁边吃了个饱。\n");
  return 1;
}
