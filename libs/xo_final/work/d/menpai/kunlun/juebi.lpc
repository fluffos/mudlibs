// juebi.c 绝壁
// Ffox 96-5-14 16:11

#include "kl_r.h"

void close_hole();



void create() {
  set("short", "绝壁");
  set("long", @LONG
眼前茫茫云海，更无去路，竟是置身在一个三面皆空的极高平台上。那平台
倒有十余丈方圆，可是半天临空，上既不得，下又不能，当真是死路一条。这大
平台上白皑皑的都是冰雪，既无树林，更无野兽。背靠山壁，往下看去，不知高
低，左右看去，一片模糊。从这里跳下去的话，多半是死路一条了。
LONG);
  set("item_desc", ([
    "山壁": "在你的左边，山壁好象有一块突起的地方。",
  ]));
  set("outdoors", "kunlun");
  setup();
}

void init() {
  add_action("do_push", "push");
  add_action("do_jump", "jump");
}

int do_jump(string str) {
  object me = this_player();

  if (str != "down") return 0;

  PLACE_D->drop_all_users(me);
  message_vision("$N奋力跃起，向崖下跳去。\n", me);
  me->move(__DIR__ "kongzhong", 1);
  return 1;
}

int do_push(string str) {
  object me = this_player();
  int i = 0;
  int my_sen;             //你的体能。
  if (!str) return notify_fail("你要推什么？\n");
  my_sen = me->query("sen");
  if (my_sen <= 10) return notify_fail("你现在累得一点力气都没有了。\n");
  me->receive_damage("sen", 10);
  //    message_vision( "$N用力向"+str+"推了一下！\n", me );
  if (str != "左侧山壁" && str != "left") return notify_fail("乱推了一通，什么动静也没有。\n");
  message_vision("$N使出全身气力向左侧山壁推了一下......\n", me);
  i = random(20);
  if (wizardp(me)) printf("random(20)==%d\n", i);
  if (i != 15 || query("exits/enter"))
    return notify_fail("结果，丝毫没有影响！\n");
  add("exits/enter", __DIR__ "shidong");
  message_vision(HIR "突然间，传来一声轰隆隆的响声，山壁上露出一个黑黝黝的洞穴入口！\n" NOR, me);
  call_out("close_hole", 15, me);
  return 1;
}

void close_hole() {
  message_vision(NOR "随着一声巨响，山壁恢复了原样......\n", this_player());
  delete("exits/enter");
}

int valid_leave(object me, string dir) {
  if (query("exits/enter") && dir == "enter") {
    if (me->query_jibie("suogu-gong") < 150) {
      write("你身体太大了，钻不进去。\n");
      return 0;
    }
    PLACE_D->drop_all_users(this_player());
    kl_mark("set", me, "hole/enterhole", 1, 0);
    write("你运用缩骨功的绝学，将身体缩小………………\n");
    write("一弯腰，你毫不费力地钻进了石洞。\n");
  }
  return ::valid_leave(me, dir);
}
