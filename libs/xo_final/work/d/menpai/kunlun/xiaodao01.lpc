inherit ROAD;


void create() {
  set("short", "碎石小道");
  set("long", @LONG
此处地势渐开阔，周围山势较缓，光线充足。一条碎石小道，向西南方向一
直延伸而出，再往东过去。是一片葱郁的竹林，长势茂盛，苍翠喜人，竟然成了
这个山坳欢迎来客的一道屏障。
LONG);
  set("no_clean_up", 0);
  set("exits", ([ /* sizeof() == 2 */
    "southwest": __DIR__ "rukou02",
    "east": __DIR__ "zhulin",
    //    "east" : __DIR__"xiaojing",

  ]));
  setup();
}

int valid_leave(object me, string dir) {
  if (dir == "east") {
    tell_object(me, "你走入了一片青翠的竹林。\n");
  }
  return ::valid_leave(me, dir);
}
