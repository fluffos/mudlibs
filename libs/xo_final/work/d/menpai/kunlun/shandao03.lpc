#include "kl_r.h"



void create()
{
    set( "short", "山道" );
    set( "long", @LONG
一阵阵云雾象半透明的乳白色的轻纱从面前、身边不停的飘过，渐渐的眼前
到处都是白茫茫的一片。只让人觉得它柔软、清凉、轻盈、飘忽、不可捉摸。在
北面显出一片长长的黑影，大概就是近处的树林了。
LONG );
    set( "exits", ([ /* sizeof() == 2 */
    "northwest" : __DIR__"xuanya",
    "southdown" : __DIR__"shandao02",
]) );
    setup();
}

int valid_leave(object me,string dir)
{
    object jungle;
    if(dir=="northwest") {
        jungle=new(__DIR__"tree1");
        write("你走入了一片黑森森的丛林！\n");
        me->move(jungle);
        tell_room(this_object(),me->query("name")+"串入丛林当中，立时消失了。\n",me);
        return notify_fail( HIW"你走入了一片黑森森的丛林！\n"NOR );
        }
    return ::valid_leave(me,dir);
}
