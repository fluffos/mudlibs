// diaoqiu   貂裘
// Ffox 98-4-25 20:25

#include <armor.h>
#include <ansi.h>
inherit CLOTH;


void create() {
  set_name("貂裘", ({ "diao qiu", "diaoqiu", "qiu" }));
  set_weight(600);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一袭柔软的貂裘，一定花了制造的人的不少心血．\n");
    set("unit", "袭");
    set("material", "leather");
    set("value", 100000);
    set("armor_prop/armor", 30);
  }
  setup();
}
