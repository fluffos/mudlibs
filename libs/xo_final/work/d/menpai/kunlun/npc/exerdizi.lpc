#include "kl_p.h"

void create()
{
    set_name( "练功弟子", ({ "di zi", "dizi" }) );
    create_family("昆仑派", 4, "弟子");
    set( "title", "昆仑派第四代弟子" );
    set( "long", @LONG
昆仑派门下弟子，在昆仑派里成为一名弟子，的确是一件自豪的事情。他们一个
个显得英姿勃发，看来功夫也必定不低的了。
LONG );
    set( "gender", "男性" );
    set( "age", 20 );
    set( "attitude", "peaceful" );
    set( "inquiry", ([
        "此地" : (:about_here:),
    ]) );
    set( "chat_chance", 5 );
    set( "chat_msg", ({
        "练功弟子在旁边摆开了马步，一副大家风范。\n",
        "练功弟子抽出一把长剑，练起了一套剑法。\n",
        "练功弟子在你的身旁突然一个跃起，高高超过了头顶。\n",
     }));
    
    set_wugong( "kunwu-jian", 100, 100, 1 );
    set_wugong( "baihe-quan", 100, 100, 1 );
    set_wugong( "kunlun-bu", 100, 100, 1 );
    set_wugong( "liangyi-xinfa", 50, 50, 1 );
    set_xiuwei( "sword", 800 );
    set_xiuwei( "dodge", 800 );
    set_xiuwei( "unarmed", 800 );
    set( "max_force", 1000 );
    set( "force", 1000 );
    set( "force_factor", 0 );
    set( "combat_exp", 80000 );
    setup();
    carry_object( "/clone/wear/cloth/cloth1" )->wear();
    carry_object( "/clone/weapon/sword/changjian" )->wield();
}

