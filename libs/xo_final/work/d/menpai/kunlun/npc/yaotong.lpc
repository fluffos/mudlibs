inherit HEALER;

void create()
{
    set( "gender", "男性" );
    set( "age", random(5)+14 );
    set( "title", "昆仑派" );
    set_name("药童",({ "yao tong", "tong", "yaotong" }) );
    set( "long", @LONG
在昆仑派里要是的一名童子。
LONG );
    set( "attitude", "peaceful" );
    set( "chat_chance", 5 );
    set("no_get",1);

    set( "chat_msg", ({
        "药童看了你一眼，又去帮师傅磨药去了。\n",
    }) );
    set_xiuwei("dodge",100+random(200) );
    setup();
    carry_object( "/clone/wear/cloth/cloth2" )->wear();    
}

