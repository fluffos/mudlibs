// xiaojie  小姐

// Ffox 98-4-25 19:42
#include "kl_master.h"

void create() {
  set_name("斑淑娴", ({ "ban shuxian", "xiao jie", "ban" }));
  create_family("昆仑派", 4, "弟子");
  set("gender", "女性");
  set("title", "昆仑派");
  set("age", 23);
  set("inquiry", ([
    "此地": (: about_here :),
    "针线": "我已经做过很多针线活了，你要帮忙么？",
    "帮忙": "你只管说好了，只要我能帮的，一定尽力。",
    "貂裘": "你说貂裘啊！用二十张银貂皮可以作一件貂裘。"
  ]));

  set("chat_chance", 5);
  set("chat_msg", ({
    "小姐轻轻地叹了一声气，不注意很难听见。\n",
    "小姐低头看了看自己手中的一块貂皮，小心地缝了起来。\n",
    "小姐看了看你，对你说道：请问您来这里有什么事情么？\n",
  }));

  set("long", @LONG
掌门的千金小姐，父母十分疼爱，如今长得落落大方，对同门师兄弟和姐妹们十
分照顾，大家有什么事情需要帮忙的也常来找她。小姐的针线活那更是一绝。
LONG);
  set("attitude", "peaceful");
  set("per", 45);

  set_wugong("liangyi-xinfa", 200, 200, 1);

  set_wugong("unarmed", 200, 200, 0);
  set_wugong("panheng-zhang", 300, 300, 1);

  set_wugong("jiben-jianshu", 200, 200, 0);
  set_wugong("sword", 200, 200, 0);
  set_wugong("xuanzhu-jian", 300, 300, 1);

  set_wugong("qingfeng-liuye", 300, 300, 1);

  set_wugong("jiben-qinggong", 200, 200, 0);
  set_wugong("yinzhi-bufa", 300, 300, 1);

  set_xiuwei_level_by_type("unarmed", 5);
  set_xiuwei_level_by_type("sword", 5);
  set_xiuwei_level_by_type("blade", 5);
  set_xiuwei_level_by_type("dodge", 5);
  set_xiuwei_level_by_type("force", 4);
  set_xiuwei_level_by_type("zonggang", 4);

  /*
    set("chat_chance_combat", 20);      
    set("chat_msg_combat", ({
        (: SKILL_D("daya-jian")->perform_action(this_object(), "fengyu-ruhui") :),
    }) );  
*/

  set("combat_exp", 5000000);

  ::create();

  setup();

  carry_object("/clone/wear/cloth/cloth_f")->wear();
  carry_object("/clone/weapon/sword/sword1")->wield();
}

int accept_object(object me, object ob) {
  if (!kl_dizi(me)) {
    return 0;
  }

  if (ob->query("name") == "针") {
    if (me->query("woshi/needle")) {
      message_vision("小姐对你笑道：“针是已经有了，在多也没有用的。”\n");
      return 0;
    }

    command("say " + "这样就只缺貂皮了。");
    kl_mark("set", me, "woshi/needle", 1, 1);
    return 1;
  }

  if (ob->query("name") == WHT "银貂皮" NOR) {
    if (!kl_mark("query", me, "woshi/needle", 1, 1)) {
      command("say " + "做针线活首先就得有针啊！光有貂皮也做不出貂裘的哦。");
      return 0;
    }

    if (kl_mark("query", me, "woshi/diaopi", 1, 1) >= 20) {
      command("say " + "现在貂皮已经够了，你再等一会儿就可以了。");
      return 0;
    }

    kl_mark("add", me, "woshi/diaopi", 1, 1);
    if (kl_mark("query", me, "woshi/diaopi", 1, 1) == 20) {
      command("say " + "现在貂皮已经够了，你再等一会儿就可以了。");
    } else {
      command("say " + "现在还差" +
        chinese_number(20 - kl_mark("query", me, "woshi/diaopi", 1, 1)) + "张。");
    }

    return 1;
  }

  if (ob->query("name") == YEL "黄貂皮" NOR) {
    command("say " + "这种貂皮是不适合于作貂裘的，需要银貂皮。");
    return 0;
  }

  return 0;
}

void init() {
  object me = this_player();

  ::init();
  if (kl_mark("query", me, "woshi/diaopi", 1, 1) >= 20) {
    remove_call_out("give_diaoqiu");
    call_out("give_diaoqiu", 2, me);
  }
}

int give_diaoqiu(object me) {
  if (this_object()->query("havedone")) {
    message_vision("小姐说道：我今天太累了，以后再给你吧。\n", me);
    return 1;
  }

  write("小姐一抬眼，看到了你————\n");
  command("xixi " + me->query("id"));
  command("say " + "你要的貂裘终于做完了。");
  message_vision("小姐给$N一件貂裘。\n", me);

  new(__DIR__ "obj/diaoqiu")->move(me);
  kl_mark("delete", me, "woshi", 1, 1);
  this_object()->set("havedone", 1);

  return 1;
}
