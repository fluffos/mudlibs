#include "kl_p.h"

string gender();

void create()
{
    set( "gender", (:gender:) );
    set( "age", random(50)+14 );
    set( "title", "昆仑派" );
    set_name("仆人",({ "pu ren", "puren", "ren" }) );
    set( "long", @LONG
在昆仑派里的一些打杂的仆人。
LONG );
    set( "attitude", "peaceful" );
    set( "chat_chance", 5 );
    set( "chat_msg", ({
    "仆人将房间里面打扫得干干净净。\n",
    "仆人看了你一眼，又去忙自己的事情去了。\n",
    }) );
    set_xiuwei("dodge",100+random(200) );
    setup();
    carry_object( CLOTH_DIR"cloth2" )->wear();    
}

string gender()
{
    if ( query("sex") )
    {
        return(query("sex"));
    }

    if ( random(10)>2 )
    {
        set("sex","男性");
        return("男性");
    }

    set("sex","女性");
    return("女性");
}
