// oldman 老人
// Ffox 98-4-25 17:26
inherit NPC;
inherit F_VENDOR;

void create()
{
    set_name( "老人", ({ "lao ren", "laoren", "waiter" }) );
    set( "gender", "男性" );                //性别：男
    set( "age", 60 );                       //年龄：22
    set( "attitude", "friendly" );          //态度：友善
    set( "rank_info/respect", "老人家" );   //敬称：小二哥
    set( "long", @LONG
老人家身形佝偻，自己在这里维持着可怜的生计。
LONG );
    set_wugong( "unarmed",       60,     60,    1 );    //基本拳法：    一级
    set_xiuwei( "unarmed",  100 );  //拳脚修为：    零级
    set( "combat_exp",  7500 );             //战斗经验：7500
    set( "talk_msg", ({
        "“这里不是经常有人来的，一般就附近的山里人偶尔到这里买一点土货。”",
    }) );
    set( "vendor_goods", ([
        "江南黄酒"  :   LIQUID_DIR + "hulu",
        "白面馒头"  :   FOOD_DIR + "mantou",
        "红烧狗肉"  :   FOOD_DIR + "gourou",
        "肉馅包子"  :   FOOD_DIR + "baozi",
        "蒜子"      : __DIR__"obj/suanzi",
        "柴刀"       : "/d/menpai/kunlun/obj/chaidao",
        "白菜子"    : __DIR__"obj/baicaizi",
        "薄荷子"    : __DIR__"obj/bohezi",
        "锄头"      : __DIR__"obj/chutou",
        "木炭"      : __DIR__"obj/mutan",
]) );

    setup();
    carry_object( CLOTH_DIR + "cloth1" )->wear();       //青布衣衫
}

void init()
{
    object ppl;
    ::init();
    add_action( "do_vendor_list", "list" );
    if ( !userp( ppl = this_player() ) || !can_act() )
        return;
    remove_call_out( "Greeting" );
    call_out( "Greeting", 1, ppl );
}

void Greeting( object ppl )
{
    if ( !ppl || environment( ppl ) != environment() ) 
        return;
    switch(random(3)){
    case 0:
     message_vision("老人对$N说道：“这位"+RANK_D->query_respect( ppl )+"到这里来是想买东西呢还是要喝点酒？”\n",ppl);
     break;
    case 1:
     message_vision("老人对$N点了点头，算是打了个招呼。\n", ppl);
     break;
    case 2:
     message_vision("老人说到：“这位"+ RANK_D->query_respect( ppl )+"不买一点土货么？”\n",ppl);
     break;
    default:
     break;
    }
}
