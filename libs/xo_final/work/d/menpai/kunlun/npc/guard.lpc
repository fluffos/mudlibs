// guard.c 护门弟子
// Ffox 98-4-25 19:11

#include "kl_p.h"

string do_ask();

void create()
{
    set_name( "护门弟子", ({ "di zi", "dizi", "guard",  }) );
    create_family("昆仑派", 4, "弟子");
    set( "title", "昆仑派第四代弟子" );
    set( "long", @LONG
昆仑派门下弟子，在昆仑派里成为一名弟子，的确是一件自豪的事情。他们一个
个显得英姿勃发，看来功夫也必定不低的了。
LONG );
    set( "gender", "男性" );
    set( "age", 31 );
    set( "attitude", "peaceful" );
    set( "inquiry", ([
        "求教" : (:do_ask:),
        "拜师" : (:do_ask:),
        "此地" : (:about_here:),
    ]) );
    set( "chat_chance", 5 );
    set( "chat_msg", ({
        "护门弟子在门口挪动来挪动去，在注意着大门口的动静。”\n",
        "护门弟子有些牢骚：“整天守着个大门，真没有意思。”\n",
        "护门弟子看了看你，朝你点了点头。\n",
     }));
    
    set( "gender", "男性" );
    set( "age", 31 );
    set( "attitude", "peaceful" );
    set_wugong( "kunwu-jian", 100, 100, 1 );
    set_wugong( "baihe-quan", 100, 100, 1 );
    set_wugong( "kunlun-bu", 100, 100, 1 );
    set_wugong( "liangyi-xinfa", 50, 50, 1 );
    set_wugong( "literate", 130, 130, 0 );
    set_xiuwei( "sword", 1026+random(200) );
    set_xiuwei( "dodge", 1026+random(200) );
    set_xiuwei( "unarmed", 1100 );
    set( "max_force", 1000 );
    set( "force", 1000 );
    set( "force_factor", 50 );
    set( "combat_exp", 80000 );
    setup();
    carry_object( "/clone/wear/cloth/cloth1" )->wear();
    carry_object( "/clone/weapon/sword/changjian" )->wield();
}

string do_ask()
{
    object me = this_player();

    if( me->query_condition("kill_kunlun") )
    {
        command("heng "+me->query("id") );
        return("没门............");
    }

    if ( kl_dizi(me) )
    {
        command("kick "+me->query("id"));
        return ("别来无恙啊？ ");
    }

    kl_mark("set",me,"door/pass",1,0);
    return("您请进，一直往东就可以看见师傅了。");
}

