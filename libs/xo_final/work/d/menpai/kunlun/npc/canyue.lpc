// canyue.c  作为参阅函数的一个文件 来自于study.c
// Ffox 97-9-9 11:16

#include <ansi.h>
#include <skill.h>

int get_gain(object, object, mapping);

//这一段放的是段府书房里面的书阅读的限制条件
//在此引用 Ffox 97-9-9 11:42
//条件是：你的领悟级别的三次方乘以该门功夫的级别除以灵性的二分之三
//这样在学三级功夫的一般灵性为二十的人学到一百级要经验
//100x100x100x3/(20*3/2) = 100000（十万）

int invalid_canyue(object me, object ob) {
  string this_skill;
  int dengji, exp, jibie, need_exp, spi;

  this_skill = ob->query("skill/name");
  dengji = me->query_lingwu(this_skill);
  exp = me->query("combat_exp");
  spi = me->query_spi() * 3 / 2;
  jibie = SKILL_D(this_skill)->query_dengji() + SKILL_D(this_skill)->query_level();
  need_exp = dengji * dengji * dengji * jibie / spi;

  if (exp < need_exp && dengji < ob->query("skill/max_lingwu")) {
    write("你经验不足，对典籍上的东西无法领会。\n");
    return 1;
  }
  return 0;
}

int canyue(object ob) {
  object me = this_player();
  mapping book;
  int cost;

  //    if ( environment(me)->query("wiz") )
  //        write(HIR "这是属于神的房间，不能用来参阅典籍。\n" NOR);

  if (me->is_busy()) {
    write("你现在忙着别的事呢！\n");
    return 0;
  }
  if (me->is_fighting()) {
    write("你无法在战斗中专心下来参阅新知！\n");
    return 0;
  }
  if (me->is_lianing()) {
    write("你无法在练习中专心下来参阅新知！\n");
    return 0;
  }

  if (me->is_duilianing()) {
    write("你无法在对练中专心下来参阅新知！\n");
    return 0;
  }

  //    if ( !arg || !objectp(ob = present( arg, me ) ) )
  //        write("你要参阅什么？\n");

  if (!mapp(book = ob->query("skill"))) {
    write("你无法从这样东西学到任何东西。\n");
    return 0;
  }

  if (!me->query_jibie("literate")) {
    write("你应该先找个老师教会你读书识字(literate)。\n");
    return 0;
  }

  if (!me->query_lingwu("literate") && book["name"] != "literate") {
    write("你的读书识字需要进一步熟悉，最好找本长知识的书来读。\n");
    return 0;
  }

  if (!SKILL_D(book["name"])->valid_learn(me)) {
    write("学习这门功夫需要满足的一些条件你还没有具备。\n");
    return 0;
  }

  cost = book["gin_cost"] * ((40 - (int)me->query_int()) / 10);
  if (cost <= 0) cost = 1;

  if ((int)me->query("gin") < cost) {
    write("你现在过于疲倦，无法专心下来参阅新知。\n");
    return 0;
  }

  message("vision", me->name() + "正专心地参阅" + ob->name()
    + "。\n", environment(me), me);
  message("vision", "你开始参阅" + ob->name() + "。\n", me);
  me->receive_damage("gin", cost);

  // 经过如许多的条件判断，应该可以参阅了
  //    notify_fail( "你参阅了半天" + ob->name() + "，却一无所获。\n");
  if (invalid_canyue(me, ob)) return 0;
  get_gain(me, ob, book);
  return 1;
}

int get_gain(object me, object ob, mapping book) {
  string type;
  int bonus;

  type = SKILL_D(book["name"])->query_xiuwei_type();

  if (type && (int)me->query_xiuwei_by_type(type) < book["xiuwei_required"]) {
    write("你拿着" + ob->name() + "仔细端详，却发现很难理解上面所讲的一切。\n");
    return 1;
  }
  if ((int)me->query_lingwu("literate") < book["literate_required"]) {
    write("你拿着" + ob->name() + "仔细参阅了一下，却发现上面的文字过于艰深，也许你需要\n"
      "多学些读书识字方面的东西了。\n");
    return 1;
  }
  if (ob->invalid_study(me))
    return 1;
  if (!me->query_jibie(book["name"]))
    me->set_jibie(book["name"], 0);

  // 典籍分成两类一类是涨jibei和exp
  // 这类相当于 课外典籍，丰富知识的
  // 另一类是涨jibie和xiuwei的
  // 这类就是课本了，用于学写的，象师傅。

  if (book["bonus_jilei"]) {
    if (!book["max_lingwu"]
      || me->query_lingwu(book["name"]) > book["max_lingwu"]) {
      write("这本典籍的一切都都已尽被你须知，你已经无法从中学到新东西了。\n");
      return 1;
    }
    if (!me->query_jibie(book["name"])) {
      write("这本典籍只能从中领悟到熟练度。你还不会这门技能。\n");
      return 1;
    }
    bonus = book["bonus_jilei"];
    if (bonus <= 0)
      me->improve_jilei(book["name"], (int)me->query_lingwu("literate") / 3 + 1);
    else
      me->improve_jilei(book["name"], bonus);
    if (book["bonus_social_exp"] &&
      (int)me->query("social_exp") < book["max_social_exp"]) {
      bonus = book["bonus_social_exp"];
      me->add("social_exp", bonus);
    }
    if (book["combat_exp"] &&
      (int)me->query("combat_exp") < book["max_combat_exp"]) {
      bonus = book["bonus_combat_exp"];
      me->add("combat_exp", bonus);
    }
  } else {
    if (me->query_jibie(book["name"])
      && me->query_lingwu_ratio(book["name"]) < 90) {
      write("功夫需要多加练习，才能真正掌握。\n");
      return 1;
    } else {
      if (me->query_jibie(book["name"]) >= book["max_jibie"]) {
        write("这本典籍的一切都都已尽被你须知，你已经无法从中学到新东西了。\n");
        return 1;
      }
      if (bonus = book["bonus_jibie"] > 0)
        me->improvve_jibie(book["name"], bonus);
      else if (bonus <= 0) {
        if (me->query("age") < 15)  // to avoid selecting gifts
          me->improve_jibie(book["name"], random(15));
        else
          me->improve_jibie(book["name"],
            random((int)me->query("int") / 10 + random(2)));
        // 这样的random没有用，因为多参阅若干次总有一次是最大值: "int"-1 + 1

        if (book["bonus_xiuwei"] &&
          (int)me->query_xiuwei_by_type(type) < book["max_xiuwei"]) {
          bonus = book["bonus_xiuwei"];
          me->improve_xiuwei(type, bonus);
        }
      }
    }
  }
  write(YEL "你参阅有关" + to_chinese(book["name"]) + "的技巧，从中悟出了一些心得。\n" NOR);
  return 1;
}
