// master.c 昆仑派掌门人。
// Ffox 98-1-17 9:12
#include "kl_master.h"

void create() {
  set_name("白鹿子", ({ "bai luzi", "bai", "master" }));
  set("title", "昆仑派第三代掌门人");
  set("class", "kunlun");
  set("gender", "男性");
  set("age", 55);
  set("long", @LONG
昔日英雄，走遍关外，罕逢对手，曾生擒白虎于昆仑，为人耿直。得上代掌门之
真传，对弟子谆谆教导，昆仑派在他手下，如今是逐渐发扬光大。作为昆仑第三
代掌门人，此人名振江湖。武林中有谁不识？
LONG);
  set("attitude", "peaceful");
  set("positive_score", 30000);
  set("per", 40);
  set("str", 40);
  set("int", 40);
  set("con", 40);
  set("dex", 40);
  set("inquiry", ([
    "此地": (: about_here :),
  ]));
  set("chat_chance", 5);
  set("chat_msg", ({
    "白鹿子在大厅里面踱来踱去，看见你来了也没有怎么注意。\n",
    "白鹿子对你说道：昆仑派现在是一片昌盛的势头啊！\n",
    "白鹿子抚摩了一下神像，一副若有所思的样子。\n",
  }));

  create_family("昆仑派", 3, "掌门人");

  set_wugong("liangyi-xinfa", 300, 300, 1);

  set_wugong("unarmed", 300, 300, 0);
  set_wugong("wuxing-quan", 300, 300, 1);

  set_wugong("jiben-jianshu", 300, 300, 0);
  set_wugong("sword", 300, 300, 0);
  set_wugong("liangyi-jian", 300, 300, 1);

  set_wugong("liangyi-dao", 300, 300, 1);

  set_wugong("jiben-qinggong", 300, 300, 0);
  set_wugong("huifeng-wuliu", 300, 300, 1);

  set_xiuwei_level_by_type("unarmed", 6);
  set_xiuwei_level_by_type("sword", 6);
  set_xiuwei_level_by_type("blade", 6);
  set_xiuwei_level_by_type("dodge", 6);
  set_xiuwei_level_by_type("force", 5);
  set_xiuwei_level_by_type("zonggang", 5);

  set("combat_exp", 15000000);

  ::create();

  setup();
  carry_object("/clone/wear/cloth/cloth5")->wear();
  carry_object("/clone/weapon/sword/sword1")->wield();
}

int accept_apprentice(object ob) {
  if (ob->query_condition("kill_kunlun")) {
    return 0;
  }

  if (ob->query("gender") == "无性") {
    command("haha " + ob->query("id"));
    command("say 我昆仑派乃是江湖正派，怎么能收阉割之人啊！");
    return 0;
  }

  command("say 嗯，不错，不错，你很有眼光。\n            将来光大我昆仑派还需依靠你了。");

  if (ob->query("kunlun_task")) {
    ob->delete("kunlun_task");
  }

  if (ob->query("kunlun_work")) {
    ob->delete("kunlun_work");
  }

  if (ob->query("canyue")) {
    ob->delete("canyue");
  }

  ob->delete("ffox");

  return 1;
}

int accept_betray(object me) {
  return 1;
}

int accept_chushi(object me) {
  object this;

  me = this_player();
  this = this_object();

  if (me->query_temp("昆仑派/比划成功")) {
    return 1;
  }

  if (me->query_temp("昆仑派/出师比划")) {
    tell_object(me, "我不是让你先跟为师我比划一下吗？\n");
    return 0;
  }

  if (me->query("class_score/昆仑派") < 3000) {
    message_vision(CYN "$N对$n道：“你在我门下多年，为昆仑派所做"
      "未免太少了一些。”\n" NOR, this, me);

    if (me->query("class_score/昆仑派") > -50) {
      me->add("class_score/昆仑派", -10);
    }

    tell_object(me, "你还是先为光大昆仑派多干点事吧！\n");
    return 0;
  }

  if (me->query_jibie("liangyi-xinfa") > 150) {
    if (me->query("age") < 20) {
      message_vision(CYN "$N对$n说道：“你年纪轻轻就出去，人家会以为我昆仑派"
        "无人的。”\n" NOR, this, me);

      if (me->query("class_score/昆仑派") > -50) {
        me->add("class_score/昆仑派", -10);
      }

      tell_object(me, "再等两年再说吧。\n");
      return 0;
    } else {
      me->set_temp("昆仑派/出师比划", 1);
      tell_object(me, "你先跟为师比划一下，让我看看你功夫如何了。\n");
      return 0;
    }
  } else {
    tell_object(me, "以你现在内功修为，难于在江湖上独挡一面，还是跟为师再学学吧！\n");
    return 0;
  }

  return 1;
}

int talk_chushi(object me) {
  me->delete_temp("昆仑派/比划成功");
  me->delete_temp("昆仑派/出师比划");
  command("chat 昆仑派弟子" + me->query("name") + "(" + me->query("id") + ")" + "正式离开昆仑派。");
  command("say 以后行走江湖，你可不要危害武林啊。");
  message_vision("$N恭恭敬敬地跪了下来，向$n磕了九个响头。\n", me, this_object());
  return 1;
}

int accept_fight(object ppl) {
  object this;
  this = this_object();

  if (ppl->query_temp("昆仑派/出师比划")) {
    if (this->is_fighting()) {
      return notify_fail("现在白鹿子不能跟你比划。\n");
    }

    this->set("eff_kee", this->query("max_kee"));
    this->set("kee", this->query("max_kee"));
    this->set("eff_sen", this->query("max_sen"));
    this->set("sen", this->query("max_sen"));
    this->set("force", this->query("max_force"));
    this->set("force_factor", 200);
    this->set("force", 5000);
    this->set("max_force", 5000);
    this->set("env/attack", 75);
    message_vision(CYN "$N道，“好徒儿，进招吧。”\n", this);
    return 1;
  }
  return ::accept_fight(ppl);
}

int lose_bihua(object ppl) {
  object this = this_object();

  if (ppl->query_temp("昆仑派/出师比划")) {
    command("chat* fu " + ppl->query("id"));
    command("say 真是青出于蓝胜于蓝啊，你的功夫已经比为师的高了。");
    ppl->delete_temp("昆仑派/出师比划");
    ppl->set_temp("昆仑派/比划成功", 1);
  }

  return 1;
}

int win_bihua(object ppl) {
  object this = this_object();

  if (ppl->query_temp("昆仑派/出师比划")) {
    command("pat " + ppl->query("id"));
    command("say 看你学业不精，还是好好再和为师多多学习啊！");
    ppl->delete_temp("昆仑派/出师比划");
    if (ppl->query("class_score/昆仑派") > -50) {
      ppl->add("class_score/昆仑派", -10);
    }
  }

  return 1;
}
