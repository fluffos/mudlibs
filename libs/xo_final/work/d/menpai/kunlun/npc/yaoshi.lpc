// yaoshi.c 药师
// Ffox 98-4-22 14:19

#include "kl_master.h"
#include "yaofangwork.h"
#include "work.h"

string do_give_work();

void create()
{
    set_name( "药师", ({ "yao shi", "yaoshi", }) );
    set( "gender", "男性" );
    set( "can_teach",1);
    create_family( "昆仑派", 4, "弟子" );
    set( "title", "昆仑派" );
    set( "attitude", "peaceful" );
    set( "age", 60 );
    set( "per", 35 );
    set( "long", @LONG
仙风道骨，飘逸红尘，制药本领在这里是众人皆知，大伙凡有什么，均来这里请
求帮忙，真是手到病除。在这里呆了几十年，大家都称他为活神仙。有他在这里
，也可以算是昆仑派的一件幸事。
LONG );
    set( "inquiry", ([
        "干活"      :   (: do_give_work:),
        "帮什么忙"  :   (: do_give_work:),
        "此地"      :   (: about_here  :),
    ]) );
    set( "chat_chance", 5 );
    set( "chat_msg", ({
        "药师尝了尝手中的药，皱了皱眉头。\n",
        "药师将几味药放进了钵盂，捣了几下。\n",
        "药师从旁边的框里面挑选出几种草药，仔细加工了起来。\n",
    }));

    set_wugong( "liangyi-xinfa", 150, 150, 1 );

    set_wugong( "unarmed", 150, 150, 0 );
    set_wugong( "baihe-quan", 300, 300, 1 );

    set_wugong( "jiben-jianshu", 150, 150, 0 );
    set_wugong( "sword", 150, 150, 0 );
    set_wugong( "kunwu-jian", 300, 300, 1 );

    set_wugong( "xifeng-daofa", 300, 300, 1 );

    set_wugong( "jiben-qinggong", 150, 150, 0 );
    set_wugong( "kunlun-bu", 300, 300, 1 );

    set_xiuwei_level_by_type("unarmed", 4);
    set_xiuwei_level_by_type("sword", 4);
    set_xiuwei_level_by_type("blade", 4);
    set_xiuwei_level_by_type("dodge", 4);
    set_xiuwei_level_by_type("force", 3);
    set_xiuwei_level_by_type("zonggang", 3);

    set( "combat_exp", 500000 );

    ::create();
    setup();
    carry_object( "/clone/wear/cloth/cloth2" )->wear();
}

string do_give_work()
{
    return(give_work("药房","药师"));
}

