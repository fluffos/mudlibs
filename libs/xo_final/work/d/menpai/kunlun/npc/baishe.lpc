// baishe.c  白花蛇  //出自于无量的毒蛇，后来到昆仑。
// FFox 98-4-25 14:04

#include <ansi.h>
inherit NPC;

void use_poison();

void create()
{
    set_name("白花蛇", ({ "bai she","she" }) );
    set("units","条");
    set("race", "野兽");
    set("age", 4);
    set("yes_carry", 1);
    set("long", "一条白色的蛇，这就是传说中的白花蛇。\n");
    set("limbs", ({ "头部", "身体", "尾巴", "七寸" }) );
    set("verbs", ({ "bite" }) );
    set("attitude", "aggressive");
    set( "chat_chance", 15 );
    set( "chat_msg", ({
        "白蛇扭动了一下身体 。”\n",
        "白花蛇将头微微抬了一抬！”\n",
        "白花蛇张开了口，露出两颗毒牙。\n",
     }));
    
    set_wugong("dodge",50);
    set_xiuwei("dodge",200);
    set_temp("apply/dodge",100);
    set("combat_exp", 10000);
    set("bellicosity", 300 );
    set("chat_chance_combat", 40);
    set("chat_msg_combat", ({
                (: use_poison :),
        }) );
    setup();
}
void use_poison()
{
    object *enemy, ob;

    enemy = query_enemy();
    if ( sizeof(enemy) )
    {
        ob = enemy[random(sizeof(enemy))];
    }

    tell_object(ob,RED"你觉得腿上被咬了一下，一看是两个毒牙印痕。\n"NOR);

    if( random(query("combat_exp")) > (int)ob->query("combat_exp") )
    {
        ob->apply_condition("snake_poison", 
            (int)this_player()->query_condition("snake_poison")
            + random(5)+3);
    }
}

