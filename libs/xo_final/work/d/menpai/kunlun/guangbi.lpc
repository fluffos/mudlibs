#include "kl_r.h"



void create()
{
    set( "short", "光碧堂" );
    set( "long", @LONG
这里摆着一张条几，一张方桌，两边是靠背椅子。条几上面摆着一个白地青
花的磁瓶，里面插着一些奇怪的小花，花香扑鼻。墙壁上挂着些美人、佛像、花
鸟……这里是掌门接见客人的地方。
LONG );
    set( "item_desc", ([
    "椅子" : "一个高脚靠背椅。\n",
]) );
    set( "exits", ([ /* sizeof() == 1 */
    "west" : __DIR__"langdao05",
]) );
    set("objects", ([
    __DIR__"npc/puren" : 1+random(1),
]) );
    setup();
}

void init()
{
    add_action( "do_push", "push");    
}

int do_push(string arg)
{
    	object me, ob;
	me = this_player();
	ob = this_object();
    if( query("open")) return 0;
    if( !arg || arg != "椅子" ) return 0;
    else {
        message_vision( "$N将椅子往旁边移开，发现了椅子后的一个小暗门。\n", me );
        add( "exits/enter", __DIR__"mishi" );
        set( "open", 1 );
       remove_call_out("del");
	call_out("del", 10, ob); 
	return 1;
    }
    return 1;
}
void del(object ob)
{                                
	ob->delete("exits/enter");  
	set( "open", 0);
	return;
}