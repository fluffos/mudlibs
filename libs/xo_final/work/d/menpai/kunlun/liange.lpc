
#include <ansi.h>
inherit ROOM;



void create()
{
        set("short", YEL"秋蝉武场"NOR);
        set("long", @LONG
这里就是昆仑派的秋蝉武场，四周建造有三间幽雅清静的小阁楼，是
供昆仑弟子们练功的地方，白鹿子专门培养了一些功夫不等的侍女作为陪
练。昆仑派的弟子可以来这里请侍女姐姐们陪自己练武。
LONG
        );
       set("no_quit",1);
       set( "not_startroom",1 );
        set("exits", ([
                 "north":__DIR__"yueying",
                 "west":__DIR__"fengyu",
                 "east":__DIR__"tianjing",
                 "south":__DIR__"shuangxue",               
        ]));
        
        setup();

}

int valid_leave(object me, string dir)
{
      if ( dir=="east" ) 
       {
        if( me->query("marks/昆仑/陪练A") > 0 )
        {
  
        return notify_fail(HIR + "请先回到你请过侍女姐姐的地方，用(qing hui)请侍女姐姐回去休息后才能离开。\n" + NOR);
          }
        if( me->query("marks/昆仑/陪练B") > 0 )
        {
  
        return notify_fail(HIR + "请先回到你请过侍女姐姐的地方，用(qing hui)请侍女姐姐回去休息后才能离开。\n" + NOR);
          }
        if( me->query("marks/昆仑/陪练C") > 0 )
        {
  
        return notify_fail(HIR + "请先回到你请过侍女姐姐的地方，用(qing hui)请侍女姐姐回去休息后才能离开。\n" + NOR);
          }
       }
       return 1;
}
