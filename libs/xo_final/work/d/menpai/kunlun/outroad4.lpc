inherit ROAD;



void create()
{
    set( "short", "山道" );
    set("long", @LONG
这里是穿行于喀拉昆仑山的一条山道。路边丛林漫漫。到处是一片阴森的景
色。据说此处经常有强盗出没，过往的商人们一般都是结伴而行，单人从不敢从
此路过。这些年，强盗猖獗。人人都是岌岌可危。一直往南边去就是天竺的道路
了。
LONG );
    set("exits", ([ /* sizeof() == 2 */
    "northeast" : __DIR__"outroad3",
    "east"      : __DIR__"maowu",
    "southwest" : __DIR__"shandao",
]) );
    set("item_desc",([
    "southwest" : "一条通往南方去的山道。\n",
]) );
    setup();
}

