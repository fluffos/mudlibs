#include "kl_r.h"



void create() {
  set("short", "大门");
  set("long", @LONG
一扇大门，门口蹲踞着两个大石狮子，门上写着三个字：三圣坳。此处就是
昆仑派之所在地了，门口有弟子把守。昆仑派现在享誉江湖，武功自是不凡，气
势也是不小，到此处不管是本名弟子，还是其他门派的弟子，都得很恭敬的。
LONG);
  set("kunlun/water", 1);
  set("exits", ([ /* sizeof() == 2 */
    "west": __DIR__ "grass",
    "east": __DIR__ "wuchang",
  ]));
  set("objects", ([
    __DIR__ "npc/guard": 2,
  ]));
  setup();
}

int valid_leave(object me, string dir) {
  if (dir == "east") {
    if (!kl_dizi(me)) {
      if (!kl_mark("query", me, "door/pass", 0, 0)) {
        if (present("di zi", environment(me))) {
          message_vision("护门弟子对$N喊道：你是来干什么的？怎么随便乱闯啊？\n", me);
          return notify_fail("你被拦住了。\n");
        }
      }
    }
  }
  if (!kl_dizi(me)) kl_mark("delete", me, "door/pass", 0, 0);
  return ::valid_leave(me, dir);
}
