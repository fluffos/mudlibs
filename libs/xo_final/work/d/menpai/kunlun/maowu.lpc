#include "kl_r.h"



void create()
{
    set("short","茅屋");
    set("long",@LONG
一间东倒西歪屋，几个南腔北调人。这里竟然有一家小茅屋，屋里坐着一个
从天竺过来的客商，正在歇息。主人是一个上了年纪的老人，也许正是上了年纪
了，只好在这偏僻之处弄了这么一片小茅屋，随便招待一下过往行人，也顺便卖
一点土产品。
LONG );
    set("exits",([
    "west" : __DIR__"outroad4",
]) );
    set("objects",([
    __DIR__"npc/oldman" : 1,
    __DIR__"npc/keshang" : 1,
]) );
    setup();
}
