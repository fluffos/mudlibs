// shoproom.c   里间
// Ffox 98-4-30 10:09

inherit ROOM;

void create() {
  set("short", "里间");
  set("long", @LONG
这里是小馆的里间，几间睡房，供远客住宿之用。几张简易的床铺，但是对
于远在他乡的游子来说，这也是不容易的了。
LONG);
  set("sleep_room", "inn");
  set("exits", ([ /* sizeof() == 2 */
    "north": __DIR__ "shop",
  ]));
  setup();
}

void init() {
  this_player()->add_temp("hami/sleep", -1);
  add_action("do_che", "zuan");
}
int do_che(string arg)                    //一个钻的动作函数。
{                                           //arg：动作目标。
  object ppl = this_player();
  if (arg == "chuang"
    || arg == "床") {
    message_vision("$N搬开床板，钻了进去。\n", ppl);
    ppl->move(__DIR__ "tang");
    return 1;
  }
  write("你要钻什么？\n");
  return 1;
}
