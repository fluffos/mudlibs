#include "hami.h"

void create() {
  set_name("阿凡提", ({ "a fanti", "fanti" }));
  set("gender", "男性");                //性别：男
  set("age", 40);
  set("long", @LONG
本地人……
LONG);
  set("attitude", "friendly");
  set("inquiry", ([
    "此地": (: ask_where :),
  ]));
  setup();
  carry_object(CLOTH_DIR + "cloth2")->wear();       //粗布衣
}
