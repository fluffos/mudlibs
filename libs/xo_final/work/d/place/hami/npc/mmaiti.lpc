// mmaiti.c    买买提
// Ffox 98-4-30 14:14

#include <ansi.h>
inherit F_VENDOR;
#include "hami.h"

void create() {
  set_name("买买提", ({ "mai maiti", "maiti" }));
  set("gender", "男性");                //性别：男
  set("age", 40);
  set("long", @LONG
本地人……以种植果品为生……
LONG);
  set("attitude", "friendly");
  set("inquiry", ([
    "此地": (: ask_where :),
  ]));
  set("vendor_goods", ([
    HIG "哈蜜瓜" NOR: "/clone/eat/fruit/hamigua",
    MAG "葡萄" NOR: "/clone/eat/fruit/putao",
  ]));
  set("chat_chance", 5);
  set("chat_msg", ({
    "买买提叫道：哎，来看一看我种植的新品种葡萄了哦。 ",
    "买买提很高兴的对你说： 哈哈，我种的哈密瓜熟啦！",
  }));

  setup();
  carry_object(CLOTH_DIR + "cloth2")->wear();       //粗布衣
}

void init() {
  ::init();
  add_action("do_vendor_list", "list");
  add_action("do_work", "work");
}
int do_work() {
  object me = this_player();
  if (query((string)me->query("id"))) {
    command("say 现在不用你帮忙了，你等一下再来好了。\n");
    return notify_fail("今天的活计完了。\n");
  }
  if (me->query("sen") < 80) return notify_fail("你现在太累了。干不了重体力活。\n");
  write("你埋头在果园里干起活来…………………\n");
  write("不一会儿……\n");
  write("你干完了果园里的活。\n");
  me->add("sen", -80);
  command("say " + me->query("name") + "辛苦了！");
  set((string)me->query("id"), 1);
  new("/clone/money/silver")->move(me);
  command("say 这是给你的报酬！");
  message_vision("买买提给了$N一两银子。\n", me);
  return 1;
}
