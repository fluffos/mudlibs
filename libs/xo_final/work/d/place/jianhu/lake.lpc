// lake.c  cry

#include <ansi.h>
inherit ROOM;

int look_hua();
int look_hole();
int do_drink();
void create() {
  set("short", GRN "剑湖" NOR);
  set("long", @LONG
左边山崖上一条大瀑布如玉龙悬空，滚滚而下，倾入一座清澈异常的大湖
之中。瀑布注入处湖水翻滚，只离得瀑布十余丈，湖水(lake)便一平如镜。仰
望高崖，白雾封谷，只是在峭壁的高处有一个洞孔，看来是不可能爬上去的。
一斜眼，只见湖畔生着一丛丛茶花，在水光下摇曳生姿。
LONG
  );
  set("valid_startroom", 1);
  set("outdoors", "wuliang");
  //    set( "resource/water", 1 );    有水源
  //    set( "fillplace", "湖" );     水源名
  set("no_fight", 1);
  set("exits", ([
    "north": __DIR__ "gu",
  ]));
  set("detail", ([
    "湖水": ("你是不是找不到出路，想跳湖自杀（zisha）！\n"),
    "lake": ("你是不是找不到出路，想跳湖自杀（zisha）！\n"),
    "茶花": (: look_hua :),
    "chahua": (: look_hua :),
    "洞孔": (: look_hole :),
    "hole": (: look_hole :),
  ]));
  setup();
}

void init() {
  add_action("do_drink", "drink");
}

int do_drink() {
  object me = this_player();

  if (me->query("water") < me->max_water_capacity()) {
    me->add("water", 30);
    tell_object(me,
      "你抄起几口湖水吃了，入口清冽，甘美异常，一条冰凉的水线直通入腹中。\n");
  } else
    tell_object(me, "你已经喝的太多了！\n");
  return 1;
}

int look_hua() {
  object me = this_player();

  me->start_busy(5);
  me->set("gin", (int)me->query("max_gin"));
  return notify_fail(HIC "一丛美丽的茶花，在水光映照下摇曳生姿。\n"
    +HIW "你触景生情，感觉精神好多了！" NOR);
}

int look_hole() {
  object me = this_player();

  if (random(10))
    return notify_fail(
      "那是峭壁高处的一个洞孔，你一时还看不出有什么奇怪的地方。\n");
  else {
    me->set_temp("lingbo", 1);
    return notify_fail(CYN "忽然你发现洞孔中有一点闪光，竟是一把悬着的宝剑。\n" NOR);
  }
}
