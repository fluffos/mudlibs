// room3.c writen by cry 9.30.98

#include <ansi.h>
inherit DOOR_ROOM;

int BeenSearched = 0;

string decide_lingbo();
void create()
{
    set("short", WHT"石室"NOR);
    set("long",
"眼前一个"+MAG"宫装美女"+NOR"，手持长剑，剑尖对准了你胸膛。只见那女子始终一动
不动，定睛看时，见这女子虽是仪态万方，却似并非活人，乃是一座白玉雕成
的"+WHT"玉像"NOR+"。这玉像与生人一般大小，身上一件"+YEL"淡黄色绸衫"NOR+"微微颤动；更奇的是一
对眸子莹然有光，神采飞扬，乃是以黑宝石雕成，只觉越看越深，眼里隐隐有
光彩流转。\n"
       );
    set("valid_startroom", 1);
    set("no_fight",1);
    set("exits", ([
        "north" : __DIR__"room4",
        "west" : __DIR__"room2",
    ]) );
    create_door("west",([
        "name" : "一扇玉石门",
        "status": 1,
        "id"  : ({ "west","玉石门","door"}),
        "other_side_dir": "east",
    ]) );
    set ("detail",([
        "玉足" : @TEXT
只见玉像双脚的鞋子内侧似乎绣得有字。凝目看去，认出右足鞋上绣的是“磕首
千遍，供我驱策”八字，左足鞋上绣的是“遵行我命，百死无悔”八个字。
TEXT
    ]) );
    setup();
}

void init()
{
        add_action("do_duanyi","duanyi");
        add_action("do_lov","lov");
        add_action("do_love","love");
        add_action("do_loveu","loveu");
        add_action("do_flook","flook");
        add_action("do_kneel","kneel");
        add_action("do_ketou","ketou");
        add_action("do_search","search");
}

int do_search(string arg)
{
    object me=this_player();
    
    if (arg != "小蒲团") return 0;
        message_vision("$N开始仔细搜寻这里的"+arg+"......\n",me); 
    me->disable_command("verb","你现在正在搜索中。\n");
    call_out("new_stone",3,me);
    return 1;
}

void new_stone(object me)
{
    object item;
    string msg;

    if( BeenSearched )
    {
        tell_object( me, "这里似乎已经给人搜过了。\n");//lnwm 990306
        return;    
    }

    me->receive_damage("gin" , 10);     
    if ( me->query_temp_marks("can_get_lingbo")>2 )
        item=new(__DIR__"obj/lingbo");
    else
        item=new(__DIR__"obj/cao");
    me->add("social_exp", 10+random(10));
    msg = "$N找到了一"+item->query("unit")+item->name()+"！\n";
    item->move(me);
    message_vision(msg,me);
    me->enable_path();
    BeenSearched = 1;
}

int do_duanyi(string arg)
{
        object me=this_player();

        if( arg && arg!="玉像" ) return 0;
        if( !me->query_temp_marks("can_get_lingbo") )
                me->set_temp_marks("can_get_lingbo",1);
        return notify_fail(
CYN"你神驰目眩，竟如着魔中邪，痴痴地看着玉像：“不知神仙姐姐如何称呼？”\n"NOR);
}

int do_lov(string arg)
{
        object me=this_player();

        if( !arg || arg!="玉像" ) return 0;
        if( !me->query_temp_marks("can_get_lingbo") )
                me->set_temp_marks("can_get_lingbo",1);
        return notify_fail(
CYN"喔,玉像是多么迷人，你想你是爱上他了。\n"NOR);
}

int do_love(string arg)
{
        object me=this_player();

        if( !arg || arg!="玉像" ) return 0;
        if( !me->query_temp_marks("can_get_lingbo") )
                me->set_temp_marks("can_get_lingbo",1);
        return notify_fail(
CYN"你心情激荡，激动地对玉像道：“我要跟你说一句，天上地下，人间海底，
我们都要在一起！”\n"NOR);
}

int do_loveu(string arg)
{
        object me=this_player();

        if( !arg || arg!="玉像" ) return 0;
        if( !me->query_temp_marks("can_get_lingbo") )
                me->set_temp_marks("can_get_lingbo",1);
        return notify_fail(
CYN"你对玉像说： 我就是喜欢喜欢喜欢喜欢喜欢喜欢你！！！！！！！！！\n"NOR);
}

int do_flook(string arg)
{
        object me=this_player();

        if( !arg || arg!="玉像" ) return 0;
        if( !me->query_temp_marks("can_get_lingbo") )
                me->set_temp_marks("can_get_lingbo",1);
        return notify_fail(
CYN"你深情的凝视着玉像。\n"NOR);
}

int do_kneel()
{
        object me=this_player();

        if ( !me->query_temp_marks("can_get_lingbo") ) 
                return notify_fail("你为什么要脆下呢？\n");
        me->set_temp_marks("is_kneel",1);
        return notify_fail(
WHT"你看见神仙姐姐如此迷人，便即脆了下来，原来玉像前本有两个蒲团，似是
供人跪拜之用，你双膝跪着的是个较大蒲团，玉足前另有一较小蒲团，想是
让人磕头用的。\n"NOR);
}

int valid_leave(object me, string dir)
{
        if(me->query_temp_marks("is_kneel")){
                me->delete_temp_marks("is_kneel");
                tell_object(me,"你从蒲团上站了起来。\n");
        }
        return 1;
}

int do_ketou()
{
        object me=this_player();

        if ( !me->query_temp_marks("can_get_lingbo") ) 
            return notify_fail("你为什么要磕头呢？\n");
        if ( !me->query_temp_marks("is_kneel") ) 
            return notify_fail("你要先脆下才行？\n");
        me->add_temp_marks("amount_ketou",1);
        if (me->query_temp_marks("amount_ketou")==100){
            write(HIY"你不知已磕了多少头，小蒲团面上一层薄薄的蒲草已然破裂，露出下面有物。\n"NOR);
            me->set_temp_marks("can_get_lingbo",2);
        } else if (me->query_temp_marks("amount_ketou")==55)
            write(HIY"你磕到五六百个头，已觉腰酸背痛，头颈渐渐僵硬。\n"NOR);
        else 
            write("你磕了个头，有点儿疼。\n");
        me->add("kee",-10);
        return 1;
}
