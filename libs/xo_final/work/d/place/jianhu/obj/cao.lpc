// cao.c cry

#include <ansi.h>
#include <armor.h>
inherit WRISTS;

void create()
{
        set_name(MAG"蒲草"NOR, ({ "cao" }) );
        set_weight(1);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long", "这是一根用来做蒲团的草。\n");
                set("unit", "根");
                set("value", 10);
        	set("armor_prop/karma", 3);      //运气 //change to 3 by lnwm 990306
                set("wield_msg", "$N悄悄地把一根$n系在手指上。\n");
                set("unequip_msg", "$N从手指上取下了$n。\n");		
        }
        setup();
}