#include <ansi.h>
inherit ITEM;
void create() {
  set_name(MAG "蛇胆" NOR, ({ "she dan", "dan" }));
  set_weight(30);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "这是一枚从巨蟒体内取出的蛇胆，不知道吃了会怎样。\n");
    set("unit", "枚");
    set("value", 20000);
  }
}

void init() {
  add_action("do_eat", "eat");
}

int do_eat(string arg) {
  object me;
  me = this_player();

  if (!me->can_act()) return notify_fail("你现在无法吃东西。\n");

  if (!arg || this_object() != present(arg, me))
    return notify_fail("你要吃什么？\n");

  if (!me->query_condition("snake_poison"))
    return notify_fail("你张开口一下子就把蛇胆吞了下去，还没什么感觉呢。\n");

  message_vision("$N从怀里掏出一枚蛇胆，吃了下去。\n", me);
  tell_object(me, HIG "你觉得体内的毒性好象被控制住了。\n" NOR);

  call_out("dest_me", 1, this_object());
  me->clear_condition("snake_poison");
  return 1;
}

void dest_me(object ob) {
  destruct(ob);
}
