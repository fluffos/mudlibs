#include <ansi.h>
#include <armor.h>

inherit WAIST;

void create()
{
    set_name(RED"五"YEL"彩"BLU"落"WHT"云"CYN"巾"NOR, ({ "luoyun jin","jin" }) );
    set_weight(200);
    if( clonep() )
        set_default_object(__FILE__);
    else {
        set("long","一条散着异彩的腰带，。\n");
        set("unit", "套");
        set("material", "cloth");
        set("armor_prop/armor", 5);
	set("armor_prop/personality", 5);   //容貌
	set("armor_prop/intelligence", 2);   //悟性
    }
    setup();
}
