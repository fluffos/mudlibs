#include <armor.h>
inherit CLOTH;

void create()
{
    set_name("大敞衫", ({ "da changshan", "changshan", "cloth" }) );
    set_weight(500);
    if( clonep() )
        set_default_object(__FILE__);
    else {
        set("long","一件粗布大敞衫，布料粗糙至极。\n");
        set("unit", "套");
        set("material", "cloth");
        set("armor_prop/armor", 5);
    }
    setup();
}