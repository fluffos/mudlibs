#include <armor.h>
inherit CLOTH;

void create()
{
    set_name("破青衫", ({ "po qingshan","qingshan", "cloth" }) );
    set_weight(200);
    if( clonep() )
        set_default_object(__FILE__);
    else {
        set("long","一件残破的青布衣衫，沾满了泥土，但却坚韧异常，再也不能撕破半分。\n");
        set("unit", "套");
        set("material", "cloth");
        set("armor_prop/armor", 12);
	set("armor_prop/personality", -5);   //容貌
    }
    setup();
}