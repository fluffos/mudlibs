//eyu_jian.c 鳄鱼剪 writen by tea 98.11.15

#include <weapon.h>
#include <ansi.h>
inherit QIANG;
void create()
{
    set_name(BWHT BLK"鳄鱼剪"NOR, ({ "eyu jian","jian"}) );
    set_weight(3000);
    set("long","一把二尺长的鳄鱼剪，精铁打就，上面刻有鳄鱼纹。");
    if( clonep() )
        set_default_object(__FILE__);
    else {
        set("unit", "把");
        set("value",10000);
        set("material", "steel");
    }
        init_qiang(55);
    set("wield_msg", "$N拔出一把$n紧紧握在手中n。\n");
    set("unwield_msg", "$N将手中的$n别在要间。\n");
    setup();
}
