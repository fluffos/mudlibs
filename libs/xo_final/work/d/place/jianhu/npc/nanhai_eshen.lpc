// nanhai_eshen.c writen by tea 10.27.98

#include <ansi.h>

inherit NPC;

void create()
{
    set_name("南海鳄神",({"nanhai eshen", "nanhai", "eshen"}));
    set("long",@LONG
四大恶人之三，做事蛮横无理，喜无端生事，现在正盯着你，小心为妙。
LONG );
    set("nickname",HIB"凶神恶煞"NOR);
    set("gender", "男性" );
    set("age", 44);
    
    set("vendetta_mark", "eren");
    set("str", 35 );    set("cor", 25 );    set("int", 25 );
    set("per", 19 );    set("spi", 20 );    set("cps", 25 );
    set("dex", 25 );    set("con", 25 );    set("kar", 28 );
    
    set_force( 2500, 2500, 250 );
    set("using_force","liangyi-xinfa");

    set_wugong("kunlun-bu"      , 100, 100, 1);
    set_wugong("liangyi-xinfa"  , 130, 130, 1);
    set_wugong("panheng-zhang"  , 150, 150, 1);
    set_wugong("eyu-jianfa"     , 150, 150, 1);
    set_xiuwei_by_type("dodge"  , 3201);
    set_xiuwei_by_type("unarmed", 1901);
    set_xiuwei_by_type("long"	, 5301);
    set("combat_exp", 10000000);
    set("social_exp", 40000);
    set("title","四大恶人");
    set("bellicosity",10000);
    set("max_kee",3000);
    set_temp("apply/armor",100);

    setup();

    carry_object( __DIR__"obj/cloth2")->wear();
    carry_object( __DIR__"obj/eyu_jian")->wield();
}

int accept_fight( object me )
{
	command("heng");
	return 1;
}

void welcome_visitor()
{
	if( query("eff_kee") < query("max_kee") )
	{this_object()->set("force",3000);
	this_object()->set("eff_kee",this_object()->query("max_kee"));}
	this_object()->kill_ob(this_player());
}
void die()
{ 
        object npc = this_object();
        object killer = npc->query_temp( "last_damage_from" );
        command( "rumor " + "恶人终于被"+killer->query("name")+"杀死了！" );
    killer->add("justice",1);
              destruct(this_object());
} 
