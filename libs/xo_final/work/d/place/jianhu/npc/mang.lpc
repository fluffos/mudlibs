//mang.c writen by cry 9.30.98

#include <ansi.h>
inherit NPC;

void create() {
  set_name(HIY "花斑巨蟒" NOR, ({ "ju mang", "mang" }));
  set("race", "野兽");
  set("age", 10);
  set("yes_carry", 1);
  set("long", "一条全身花斑的巨蟒。\n");
  set("limbs", ({ "头部", "身体", "尾巴", "七寸" }));
  set("verbs", ({ "bite" }));
  set("attitude", "aggressive");

  set("combat_exp", 80000000);
  set("bellicosity", 10000);
  set_temp("apply/damage", 150);
  set_temp("apply/wound", 150);
  set_temp("apply/armor", 150);
  set("max_kee", 2000);
  setup();

  carry_object(__DIR__ "obj/mangpi")->wear();
  carry_object(__DIR__ "obj/shedan");
}

void init() {
  set("food", max_food_capacity());
  set("water", max_water_capacity());
  call_out("do_kill", 1, this_player(), this_object());
}

int do_kill(object me, object obj) {
  if (obj->can_act() && environment(me) == environment(obj)) {
    tell_object(me, HIY "花斑巨蟒" NOR + RED "眼中红光一闪。\n\n" NOR);
    me->apply_condition("snake_poison", 30);
    obj->kill_ob(me);
    me->kill_ob(obj);
  }
  return 1;
}
