#include <ansi.h>

inherit NPC;

void create()
{
    set_name("段延庆",({"duan yanqing", "duan", "yanqing"}));
    set("long",@LONG
四大恶人之首，虽然下肢残废，但手握青铁杖，以杖代脚，武功出神入化。
LONG );
    set("nickname",HIR"恶贯满盈"NOR);
    set("gender", "男性" );
    set("age", 50);

    set("vendetta_mark", "eren");
    set("str", 30 );    set("cor", 30 );    set("int", 29 );
    set("per", 12 );    set("spi", 25 );    set("cps", 50 );
    set("dex", 28 );    set("con", 26 );    set("kar", 24 );
    
    set_force( 3000, 3000, 300 );
    set("using_force","duanshi-xinfa");

    set_wugong("duanjia-shenfa" , 150, 150, 1);
    set_wugong("duanshi-xinfa"  , 150, 150, 1);
    set_wugong("yiyang-zhi"     , 150, 150, 1);
    set_wugong("yiyang-zhang"	, 150, 150, 1);
    set_xiuwei_by_type("dodge"  , 5301);
    set_xiuwei_by_type("unarmed", 5301);
    set_xiuwei_by_type("long"	, 5301);
    set("combat_exp", 20000000);
    set("social_exp", 50000);
    set("title","四大恶人");
    set("bellicosity",10000);
    set("max_kee",3000);
    set_temp("apply/armor",100);

    set("chat_chance_combat", 60);

    setup();

    carry_object( __DIR__"obj/cloth1")->wear();
    carry_object( __DIR__"obj/tiezhang")->wield();
}
	
int accept_fight( object me )
{
	command("heng");
	return 1;
}

void welcome_visitor()
{
	if( query("eff_kee") < query("max_kee") )
	{this_object()->set("force",3000);
	this_object()->set("eff_kee",this_object()->query("max_kee"));}
	this_object()->kill_ob(this_player());
	if(random(2)==1) this_player()->apply_condition( "miyao",20 );
}
void die()
{ 
        object npc = this_object();
        object killer = npc->query_temp( "last_damage_from" );
        command( "rumor " + "恶人终于被"+killer->query("name")+"杀死了！" );
    killer->add("justice",random(2)+1);
        destruct(this_object());
} 
