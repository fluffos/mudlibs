// ye_erniang.c writen by tea 10.27.98

#include <ansi.h>

inherit NPC;

int ask_child();
void create() {
  set_name("叶二娘", ({ "ye erniang", "ye", "erniang" }));
  set("long", @LONG
四大恶人之二，据说专抢别人的孩子，扶养一天后再杀掉，因而为人所痛恨，
但又怎知她。。。
LONG);
  set("nickname", HIY "无恶不做" NOR);
  set("gender", "女性");
  set("age", 42);

  set("inquiry", ([
    "孩子": (: ask_child :)
  ]));

  set("vendetta_mark", "eren");
  set("str", 20); set("cor", 25); set("int", 25);
  set("per", 29); set("spi", 30); set("cps", 25);
  set("dex", 30); set("con", 26); set("kar", 28);

  set_force(2000, 2000, 200);
  set("using_force", "kongdong-xinfa");
  set("max_kee", 3000);
  set_temp("apply/armor", 100);

  set_wugong("luofeng", 300, 300, 1);
  set_wugong("kongdong-xinfa", 200, 200, 1);
  set_wugong("wulong-quan", 150, 150, 1);
  set_wugong("xiangsi-dao", 100, 100, 1);
  set_xiuwei_by_type("dodge", 3201);
  set_xiuwei_by_type("unarmed", 1901);
  set_xiuwei_by_type("blade", 5301);
  set("combat_exp", 10000000);
  set("social_exp", 40000);
  set("title", "四大恶人");
  set("bellicosity", 10000);

  setup();

  carry_object(__DIR__ "obj/sahua_ao")->wear();
  carry_object(__DIR__ "obj/luoyun_jin")->wear();
  carry_object(__DIR__ "obj/liuye_dao")->wield();
}

int ask_child() {
  object me = this_player();

  command("sneer " + me->query("id"));
  kill_ob(me);
  return 1;
}
int accept_fight(object me) {
  command("heng");
  return 1;
}

void welcome_visitor() {
  if (query("eff_kee") < query("max_kee")) {
    this_object()->set("force", 3000);
    this_object()->set("eff_kee", this_object()->query("max_kee"));
  }
  this_object()->kill_ob(this_player());
}
void die() {
  object npc = this_object();
  object killer = npc->query_temp("last_damage_from");
  command("rumor " + "恶人终于被" + killer->query("name") + "杀死了！");
  killer->add("justice", 1);
  destruct(this_object());
}
