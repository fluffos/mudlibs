// room1.c  cry

#include <ansi.h>
#include <room.h>
inherit DOOR_ROOM;


void close_exit();
int look_shui();
int look_mirror();
void create()
{
    set("short", WHT"石室"NOR);
    set("long", @LONG
你眼前陡然光亮。只见所处之地是座圆形石室，光亮从镶在左边石壁上的
一块大水晶透来。室中放着一只石桌，桌前有凳，桌上竖着一面铜镜，镜旁放
着些梳子钗钏之属，看来竟是闺阁所居。再看那石室时，只见壁上东一块、西
一块的镶满了铜镜，随便一数，便已有三十余面。
LONG
       );
    set("valid_startroom", 1);
    set("no_fight",1);
    set("exits", ([
        "north" : __DIR__"door1",
    ]) );
    create_door("north","一扇石门","south",DOOR_CLOSED);
    set("detail", ([
        "水晶" : (: look_shui :),
        "铜镜"   : (: look_mirror :),
    ]) );
    set("search_things",([
        "石桌" :  __DIR__"obj/zan",
    ]) );
    setup();
}

void init()
{
        if (this_object()->query("exits/east")) {
            remove_call_out("close_exit");
        call_out("close_exit",10,this_player());
        }
}
int look_shui()
{
        object me=this_player();

        write(HIC"一块镶在石壁上的水晶窗，双眼贴着水晶向外瞧去，只见碧绿水流不住
晃动，鱼虾水族来回游动，极目所至，竟无尽处。你恍然大悟，原来处
身之地竟在水底。\n"NOR);
        me->set_temp("can_out",1);
        return 1;
}

int look_mirror()
{
        object me=this_player();

        if ( me->query( "social_exp" )<10000 )
            write(
"你看着石壁上一块块的铜镜，只觉得眼花缭乱！可能是你的阅历太低了吧！\n");
        else if ( random(4) ) {
            write(
"你仔细端详石壁上的铜镜，但觉奇妙无比。。。\n");
            me->add("social_exp",10);
            me->unconcious();
        } else {
            write(
"你仔细端详石壁上的铜镜，但觉奇妙无比。。。\n"
+CYN"忽见东首一面斜置的铜镜反映光亮，照向西南隅，石壁上似有一道缝，
你忙抢将过去，使力推那石壁，果然是一道门，缓缓移开，露出一个洞来。\n"NOR);
            set("exits/east",__DIR__"room2");
            remove_call_out("close_exit");
            call_out("close_exit",10,me);
        }
        return 1;
}

void close_exit()
{
    message("vision",
"忽听一声轻响，东面的石壁逐渐关了起来，又合并成一道平整的墙面。\n",this_object());
    delete( "exits/east" );
}
