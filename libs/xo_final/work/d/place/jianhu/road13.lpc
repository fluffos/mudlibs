#include <ansi.h>
inherit ROOM;

void create()
{
    set("short", WHT"石阶"NOR);
    set("long", @LONG
一条石级从石室斜向上引，一眼望不到尽头，你跨步而上，走到一百
多级时，已转了三四个弯，分不清东南西北。
LONG
       );
    set("valid_startroom", 1);
    set("exits", ([
        "up" : __FILE__,
        "down" : __FILE__,
    ]) );
    setup();
}

int valid_leave(object me,string dir)
{
	if (dir=="up" && !random(4)) {
	    	this_player()->move(__DIR__"road14");
		return -1;
	}
	if (dir=="down" && !random(4)) {
	    	this_player()->move(__DIR__"road"+random(5));
		return -1;
	}
 	return ::valid_leave(me,dir);
}