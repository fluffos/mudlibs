// wuchang1.c   edit by lin on March 6,1997

#include <ansi.h>

inherit NPC;

void create() {
  set_name(BLK "黑无常" NOR, ({ "hei wuchang", "wuchang" }));
  set("long", "黑无常伸著长长的舌头瞪著你，黝黑的脸上看不出任何喜怒哀乐。\n");

  set("chat_chance", 15);
  set("chat_msg", ({
    (: random_move :),
    "黑无常发出一阵像呻吟的声音，当他发现你正注视著他的时候，瞪了你一眼。\n",
    "黑无常把长长的舌头伸出来，缓缓地舔了舔自己又黑又长的手指。\n"
  }));
  set("gender", "男性");
  set("age", 1000);
  set("combat_exp", 20000);
  set("max_gin", 10000);
  set("max_kee", 10000);
  set("max_sen", 10000);
  setup();
}

void init() {
  object ob;
  ob = this_player(1);
  if (!(ob) || !present(ob)) return;
  if (!ob->is_ghost() && interactive(ob)) {
    command("say 喂！阳人来阴间做什麽？");
    kill_ob(ob);
    ob->fight_ob(this_object());
    return;
  } else {
    command("xixi " + (string)ob->query("id"));
    command("say 真乖，不用我抓，你就来了。");
    command("ha " + (string)ob->query("id"));
  }
}

int accept_fight(object ob) {
  return 1;
}

int is_ghost() {
  return 1;
}
