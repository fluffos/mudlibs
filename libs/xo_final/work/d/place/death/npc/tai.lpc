// Room: /d/death/tai.c  edit by lin on March 7,1997
#include <ansi.h>

inherit ROOM;
void create()
{
	set("short",CYN "望乡台" NOR);
 	set("long", 
"这是鬼魂与"+RED "前世" NOR+"告别的最后之所了。眼前是一个高高的"+CYN "石台" NOR+"，四面凌空，皆\n"
"是浓雾笼罩一般，如梦似幻，"+HIW "脚下" NOR+"似有万丈"+BLU "深渊" NOR+"，又似是曾经相识的"+RED "家乡故土" NOR+"，\n"
"向下望去，隐隐可见生前之地，亲朋好友都如鬼魅一般，虚无缥缈，可望而不可\n"
"及........\n"
BLU "          望着脚下熟悉的一切，你的记忆似乎又被唤醒了，不禁悲\n"
"      从中来，恋恋不舍.................\n\n" NOR
);
	set("exits", ([ 
		"west" : "/d/death/dadian",
	]));
	setup();
}
void init()
{
        object ob;
        if( interactive(ob = this_player())  ) {
        remove_call_out("do_string");
        call_out("do_string",20,ob);}
        add_action("do_jump","jump");
}
int do_string(object ob)
{
       if( !ob || environment(ob) != environment() ) return;
        write(BLU "    一个声音在你耳边说道：“汝已身入冥府，该当在此于前世一刀两断，\n"
                  "速速去登西方极乐世界为妙，"+RED "切不可再纵身于尘世情色之中......\n\n" NOR);
        ob->unconcious();
        return 1;
}
int do_jump(string arg)
{
        message_vision(HIR "$N想起尘世间的种种好处，不顾一切的朝脚下那个虚幻的世界跳去.......\n\n\n\n" NOR,this_player());
        this_player()->set_temp("block_msg/all",1);
        this_player()->set("no_get", 1);
        this_player()->set("no_get_from", 1);
        this_player()->disable_player("<虚无飘渺间>");
        remove_call_out("go_home");
        call_out("go_home",6,this_player(), arg);
        return 1;
}
int go_home(object ob, string arg)
{
        ob->enable_player();
        ob->set_temp("block_msg/all",0);
        ob->delete("no_get");
        ob->delete("no_get_from");
        write(HIW "你觉得好象刚刚作了一个梦........\n" NOR);
        ob->reincarnate();
        switch ( arg ) {
        	case "yangzhou" :
        		ob->move("/d/city/yangzhou/kuixing_ge");
        		break;
        	case "luoyang" :
		        ob->move("/d/map/zhongyuan/nanmen");
		        break;
			case "lanzhou" :
				ob->move("/d/city/lanzhou/guangchang");
				break;
			default :
				switch ( random(3) ) {
		        	case 0 :
        				ob->move("/d/city/yangzhou/kuixing_ge");
        				break;
			       	case 1 :
		    		    ob->move("/d/map/zhongyuan/nanmen");
				        break;
				case 2 :
				     ob->move("/d/city/lanzhou/chh_dian");
					break;
				}
		}						      
        message("vision","你身边忽然多了一个身影.......\n",environment(ob),ob);
        return 1;
}

