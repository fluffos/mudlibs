#include <ansi.h>
#include <armor.h>

inherit SURCOAT;

void create() {
  set_name(YEL "皮氅" NOR, ({ "pi chang", "chang", "surcoat", }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一件由野牦牛加上一种神奇的材料皮制成的大氅。\n");
    set("unit", "件");
    set("value", 2000000);
    set("no_give", 1);
    set("cant_sell", "你是怎么搞到这东西的？听说要去官府先交税的。\n");
    set("wear_msg", "只听见「噗」地一声，$N的身上已经多了一件霞光四射的战衣——$n。\n");
    set("material", "leather");
    set("armor_prop/armor", 55);
  }
  setup();
}

int cannot_search(object me) {
  if (random(me->query("kar")) < 4)
    return 1;
  else
    return 0;
}
