#include <ansi.h>
#include <room.h>
inherit ROOM;

void create()
{
    set("short", "男卧室");
    set("long", @LONG
几张木板床一字排开，床的被褥叠的整整齐齐，床头各有一个小柜子，除了
这些，屋内就别无它物。
LONG
    );
    set("no_clean_up", 0);
    set("exits", ([
        "north" : __DIR__"lian_life_cmds"
    ]));
    set( "sleep_room", "inn" );
    set( "no_fight", 1);
    setup();
}
