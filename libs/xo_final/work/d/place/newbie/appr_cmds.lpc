#include <ansi.h>
#include <room.h>

inherit ROOM;

void create()
{
    set("short",HIG "第四级:投师学艺指令" NOR);
    set("long", @LONG
这里是笑傲江湖新手培训站中投师学艺指令的培训教室。一排排的桌椅整整齐齐，
负责讲授投师学艺指令的巫师正在授课，下面有很多象你一样的xo的新手正在认
真的听课。时时有新手若有所得的点点头，恰在这时，巫师讲到了精彩处，教室
里暴发出一阵热烈的掌声。你被这种气氛所感染，静静的坐到一个空位上，开始
学习xo中的投师学艺指令。
LONG
    );

    set("exits", ([ /* sizeof() == 2 */
        "up" : __DIR__"life_cmds",
        "down": __DIR__"cont_cmds",
        "out" : __DIR__"start",
        //"in"  : __DIR__"ke_ting", 
    ]));

    set("objects", ([ /* sizeof() == 1 */
       __DIR__"npc/appr_shen.lpc" : 1,
    ]));

    set("no_fight",1);
    setup();

    replace_program(ROOM);
}

