#include <ansi.h>
#include <armor.h>
inherit CLOTH;
void create() {
  set_name(HBWHT "纱衣" NOR, ({ "shayi" }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一件雪白的纱衣，从头顶直垂到身后，更衬托出女神的亭亭玉立。");
    set("unit", "件");
    set("value", 600);
    set("armor_prop/armor", 1);
    set("material", "cloth");
    set("armor_prop/personality", 10);
    set("female_only", 1);
  }
  setup();
}
