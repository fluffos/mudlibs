// nvshen1.c
// 该女神负责介绍与拜师和学习技能有关的指令,apprentice,ask,qingjiao,xiulian,lian,quest等

#include <ansi.h>

inherit NEWBIE_NPC;

void create()
{
    ::create();

    set_name(YEL "女神" NOR,({"nvshen"}));

    my_msg = ({
        "\n    欢迎！欢迎！我是负责拜师学艺指令的女神，我将教你如何使用拜师学艺指令。\n",
        "\n    要学艺当然要首先找个师傅，在xo里，新手一般都要先拜镖师，学一些xo里\n"+
            "公共的基本武功。拜师的指令是apprentice 师傅代号，如要拜扬州镖局的刘星海\n"+
            "为师，可用apprentice liu。\n",
        "\n    拜师以后你一定想知道这个师傅能够教给你什么武功，这就要用到ask指令。\n"+
            "ask 师傅代号 about 武功就可以知道你师傅能教你什么武功。当然ask指令还不\n"+
            "只有这一个作用，以后你会逐渐明白。\n",
        "\n    知道了武功名之后，就可以学习这些武功了。学习武功时要用到的指令首先\n"+
            "是qingjiao。qingjiao指令的格式为qingjiao 某人 武功名。qingjiao一次后，\n"+
            "如果师傅愿意教你的话，你就会这种武功了，以后只有等领悟比大于90%后，才可\n"+
            "以继续qingjiao。\n",
        "\n    那你一定要问，怎么增加一种武功的领悟比了。增加一般武功的领悟比可以\n"+
            "用lian 武功名，增加内功的领悟比则可以用xiulian 内功名。其实增加领悟比的\n"+
            "的主要方式是打斗，关于打斗的指令你将在以后学到。\n",
        "\n    另外还有一条常用的跟学艺有关的指令quest，顾名思义，quest就是去完成\n"+
            "师傅教给你的任务了。作quest可以增加你的师门忠诚度，有些武功只有当忠诚度\n"+
            "到一定值才可以学。\n",
        "\n    如果你已经掌握了这些指令，请往上走，那里将有我的朋友教你使用这里的\n"+
            "生活指令。\n",
    });
}

