#include <ansi.h>

inherit NEWBIE_NPC;

void create()
{
    ::create();

    set_name(YEL "女神" NOR,({"nvshen"}));

    my_msg = ({
        "\n欢迎你来到笑傲江湖，我和这里的其他朋友将负责教你如何使用这里的一些常用指令。\n",
        "\n无论将来你在培训站中的任何房间中，只要敲out，就可以回到此地。\n",
        "\n好了，请敲u(up 的缩写)，然后回车，那里将有我的朋友教你使用这里的移动指令。\n",
    });
}

