inherit NPC;
inherit F_MASTER;
#include "biaoju_master.h"

string ask_me();
int zhongcheng(object, string);

void create() {
  set_name("刘星海", ({ "liu xinghai", "liu" }));
  create_zuzhi("凤翔镖局", 1, "总镖头");
  set("long", @LONG
他身形修长，虎臂雄腰，剑眉虎目，正值中年，身强力壮，一手
八仙掌已得师傅的真传，镖局现在也是他挑大梁。
LONG
  );
  set("gender", "男性");
  set("str", 21);
  set("con", 22);
  set("per", 22);
  set("int", 27);
  set("kar", 25);
  set("dex", 25);

  set("age", 33);
  set("combat_exp", 100000);
  set("social_exp", 10000);

  set_wugong("jiben-quanfa", 90, 90, 0);
  //    set_wugong( "changquan", 80, 80, 0 );
  set_wugong("feiying-zhang", 70, 70, 0);
  set_wugong("baxian-zhang", 70, 70, 1);
  set_wugong("jiben-jianfa", 90, 90, 0);
  set_wugong("chuiliu-jianfa", 60, 60, 0);
  set_wugong("fengxiang-jianfa", 60, 60, 0);
  set_wugong("baxian-jian", 40, 40, 1);
  set_wugong("jiben-qinggong", 90, 90, 0);
  set_wugong("xingyun-shenfa", 70, 70, 0);
  set_wugong("chusuifeng", 60, 60, 0);
  set_wugong("baxian-shenfa", 70, 70, 1);
  set_wugong("penglai-xinfa", 100, 100, 1);

  set_wugong("changquan", 100, 100, 1);

  set_xiuwei_by_type("unarmed", 950);
  set_xiuwei_by_type("sword", 800);
  set_xiuwei_by_type("dodge", 950);
  set("inquiry", ([
    "升职": "你还是先练好基本功再说。",
  ]));
  create_family("蓬莱派", 17, "弟子");

  setup();
  carry_object(CLOTH_DIR "heibu_yi")->wear();
  carry_object(BOOTS_DIR "sifeng_kuanxue")->wear();
  carry_object(SWORD_DIR "changjian");
}

void init() {
  ::init();
  add_action("do_nod", "nod");
  add_action("give_quest", "quest");
}

int do_nod() {
  object me = this_player();
  if (!me->query_temp("testing")) return 0;
  me->delete_temp("testing");
  message_vision("$N冲着刘星海点点头，说道：我愿意投入凤翔镖局。\n", me);
  message_vision("刘星海“哈哈”大笑，说道：好，好，既然你愿意，从今天起你就是我凤翔镖局的人了。\n"
    "在镖局里规矩不多，\n"
    "       一 不和黑道上的人来往， 二 不要招惹官府。\n"
    "好了，现在你可以下去自己找镖头，镖师们学武去了。\n", me);
  recruit_chengyuan(me, "趟子手");
  me->set("zuzhi/generation", 4);
  return 1;
}


int attempt_apprentice(object me) {
  string title;

  if (query("no_find/" + me->query("id"))) {
    message_vision("刘星海冷冷对$N说道：我叫你在大厅等，你跑哪里去了？现在还有脸见我？！\n", me);
    return 0;
  }
  if (query_temp("inviting")) {
    write("刘星海对你说道：我正忙着呢。你过伙在来吧。\n");
    return 0;
  }
  if (me->query("family") && me->query("family/family_name") != "蓬莱派") {
    command("shake " + me->query("id"));
    command("say 本镖局暂时不接收别派弟子。\n");
    return 0;
  }
  if (me->query("zuzhi"))
    if (me->query("zuzhi/zuzhi_name") != "凤翔镖局") {
      command("say 你已经加入了一个组织了，凤翔镖局不会收你的。\n");
      return 0;
    }
  if (me->query("age") < 18) {
    if (me->query("zuzhi/zuzhi_name") == "凤翔镖局") {
      command("say 你还是等到了十八岁再来拜师。\n");
      return 0;
    }
    command(":)");
    command("say " + RANK_D->query_respect(me) + "，我们蓬莱派只收十八岁以上的人为正式入室弟子，\n"
      "      如果你有心想入我派，就先在镖局学几年武，打好根基再说。\n");
    command("say 你可愿意？\n");
    me->set_temp("testing", 1);
    write("你如果愿意就点头(nod)。\n");
    return 0;
  } else {
    //该正式拜师了。
    if (me->query("family")) {
      if (me->query("family/family_name") == "蓬莱派") {
        command("say 咱师兄弟的你还客气什么？\n");
        command("haha " + me->query("id"));
        return 0;
      }
      command("say 你既然已经投入" + me->query("family/family_name") + "，就该安心学功夫，各家各派都有自己的长处的。\n");
      return 0;
    }
    title = me->query("title");
    if (me->query("zuzhi/zuzhi_name") == "凤翔镖局") {
      if (me->query("zuzhi/generation") > 3) {
        command("shake " + me->query("id"));
        command("say 你在镖局这几年都干了些什么，到现在还是个趟子手。哼，升了镖师再找我。\n");
        return 0;
      } else {
        command("say 你既然诚心想入蓬莱派，等我请师傅来，你在此等候一下，我去请师傅。\n");
        set_temp("inviting", me);
        remove_call_out("invite_master");
        call_out("invite_master1", 1, this_object());
        return 0;
      }
    } else {
      command("say 我派不收十八岁以上的非镖局弟子为徒，真是抱歉。\n");
      return 0;
    }
    return 1;
  }
}

void invite_master1(object ob) {
  command("go southwest");
  remove_call_out("invite_master2");
  call_out("invite_master2", 1, ob);
}

void invite_master2(object ob) {
  command("go south");
  remove_call_out("invite_master3");
  call_out("invite_master3", 1, ob);
}

void invite_master3(object ob) {
  object master;
  if (objectp(master = present("zhou tianxiang", environment(ob)))) {
    //邀请师傅到大厅收徒。
    message_vision("$N恭恭敬敬的对$n说道：有个人想入本派，师傅您请到大厅看看吧。\n", ob, master);
    message_vision("$N冲着$n点点头。\n", master, ob);
    set_temp("find_master", master);
    master->should_follow(ob);
  } else {
    //没找到。只好回去说抱歉了。
    set_temp("find_master", 0);
  }
  remove_call_out("back_with_master1");
  call_out("back_with_master1", 1, ob);
}

void back_with_master1(object ob) {
  command("go north");
  remove_call_out("back_with_master2");
  call_out("back_with_master2", 1, ob);
}

void back_with_master2(object ob) {
  command("go northwest");
  remove_call_out("back_with_master3");
  call_out("back_with_master3", 2, ob);
}

void back_with_master3(object ob) {
  //回到大厅了。
  object ppl, master;
  ppl = query_temp("inviting");
  delete_temp("inviting");
  if (!present(ppl, environment(ob))) {
    // 嗯，敢放我的鸽子，这次不再收你为徒了。
    set("not_find/" + ppl->query("id"), 1);
    return;
  } else {
    if (!query_temp("find_master")) {
      message_vision("刘星海对$N说道：不好意思，家师不在，你下次再来吧。\n", ppl);
    } else {
      master = query_temp("find_master");
      command("nod " + ppl->query("id"));
      message_vision("刘星海指着$N对周天翔说道：就是这人想入本派。\n", ppl);
      // 下面就交给周天翔处理，开始收徒了，
      master->set_temp("can_recruit", ppl);
      master->attempt_apprentice(ppl);
    }
  }
}

// added by xli 1999.1
int accept_bihua(object ppl) {
  if (ppl->query("class") == "qingcheng") {
    if (ppl->query("xli_marks/bihua_liu")) {
      tell_object(ppl, "司马卫这个牛鼻子，竟然派你这么个年轻弟子来挑衅。\n");
      tell_object(ppl, "好，我今天就让你看看我蓬莱派武功的厉害。\n");
      bihua_ob(ppl);
      return 1;
    }
    tell_object(ppl, "一个小小的青城弟子，也配我亲自动手？\n");
    return 1;
  }
  command("say " + "既然你有心和我较量较量，我就奉陪奉陪。");
  bihua_ob(ppl);
  return 1;
}
// end 
void setup() {
  if (query("not_find"))
    delete("not_find");
  ::setup();
}
