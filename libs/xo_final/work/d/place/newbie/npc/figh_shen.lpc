// 这里将介绍跟战斗有关的指令enable,disable,wield,unwield,enforce,shili,wimpy,attack,bihua,duilian,kill,wear,remove等
// figh_shen.c

#include <ansi.h>

inherit NEWBIE_NPC;

void create()
{
    ::create();

    set_name(YEL "女神" NOR,({"nvshen"}));

    my_msg = ({
        "\n    欢迎！欢迎！我是负责打斗指令的女神，我将教你如何使用打斗指令。\n",
        "\n    你是否还记得，增加武功积累的主要方式是打斗，另外打斗也是增加实战经\n"+
            "验的唯一方式。可见打斗指令的重要。\n",
        "\n    打斗前先要决定自己使用什么武功，enable 武功名开始使用该武功；disable\n"+
            "则停止使用该武功。\n",
        "\n    然后如果不是用拳脚功夫的话，就需要使用相应的兵器，这就要用到wield和\n"+
            "unwield指令。wield 兵器名使用该兵器，unwield则放弃使用。\n",
        "\n    你也可以穿上一些护具来保护自己，如你现在身上的布衫就是护具。穿某种\n"+
            "护具用wear 护具名，remove则取下该护具。你也可以用wear all穿上你所有的\n"+
            "所有护具，remove all则取下所有护具。\n",
        "\n    此外，还可以设置一些参数，如攻防比、实力比等。enforce 指定每一击用\n"+
            "几成内力；set attack 数目(0~100)，指定攻防比；set shili 数目(0~100)\n"+
            "指定实力比；set wimpy 数目(0~100)，则当体能、生命中任一个剩余小于指定\n"+
            "百分比时，自动逃跑。\n",
        "\n    现在你就可以用打斗指令开始打斗了。打斗指令有bihua，duilian，kill等。\n"+
            "指令格式都是：指令名 人物名或玩家id。duilian对象只能是自己同门，而bihua\n"+
            "和kill的对象则可为任何人。\n",
        "\n    培训到此结束。当然这些都只是基本指令，更多的还需要你去探索。最后祝\n"+
            "你在xo玩得快快乐乐！\n",
    });
}

