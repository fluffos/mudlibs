//life_shen.c
// 该女神负责介绍xo跟生活有关的指令,如get,drop,drink,eat,zuo,work,buy,list,pawn,redeem,sleep,cun,qu,check等

#include <ansi.h>

inherit NEWBIE_NPC;

void create()
{
    ::create();

    set_name(YEL "女神" NOR,({"nvshen"}));

    my_msg = ({
        "\n    欢迎！欢迎！我是负责生活指令的女神，我将教你如何使用生活指令。\n",
        "\n    当你到某个地方后，可能发现有些东西被丢在地上，要想拣起这些东西，可\n"+
            "用get指令。get 物品名可以拣起某件东西，get all则可以拣起地上所有的东西。\n"+
            "当你不想要身上的某件东西时，可以用drop 物品名来丢掉它。\n",
        "\n    现在介绍赚钱的指令work，在某些地方，如布店、果园等可以工作赚钱。没\n"+
            "有钱很多生活指令都无从谈起。\n",
        "\n    辛辛苦苦赚了一点钱，赶快存起来吧，要不然被人杀掉可就什么都没有了。\n"+
            "xo里有四个在钱庄用的命令：cun，qu，check和convert。check指令可以查看你\n"+
            "存钱的总数；cun当然是用来存钱啦，格式为cun 钱数 单位，如cun 100 coin。\n"+
            "qu是取钱的指令，格式与cun相同。convert 是用来兑换钱的，该指令的格式为：\n"+
            "convert 数目 单位 to 单位，如convert 1000 coin to sliver。当然这些\n"+
            "指令都只能在钱庄使用，值得注意的是，xo里除扬州和楚州外，其它地方的当铺和钱\n"+
            "庄在一个地方。\n",
        "\n    xo里买东西使用buy指令，具体使用方法请help buy。跟buy密切相关的一个\n"+
            "指令为list，list 代号可列出该人物出售的所有物品和价格。在当铺里直接list\n"+
            "可以列出当铺里现在出售的东西。\n",
        "\n    现在介绍当铺里的指令。当铺里买东西可以直接用buy 物品名。当铺里专用\n"+
            "指令有：pawn，pawnlist和redeem。pawn可用来典当东西，格式为pawn 物品名；\n"+
            "pawnlist 则列出你在该当铺里典当的所有东西和编号；redeem用来赎回典当的东\n"+
            "西，格式为redeem 编号。\n",
        "\n    说了这么多，差点忘了最主要的吃喝指令。eat和drink是最主要的吃喝指令。\n"+
            "这两种指令格式相同，在指令名后加上物品名就可以了。另外当你拜师后，可到厨\n"+
            "房用zuo指令吃喝。\n",
        "\n    还有一条生活指令sleep，即使我不说你也肯定知道该指令的功能。睡上一觉\n"+
            "可以恢复精神和体能。当然只能在卧室睡觉，不过入丐帮后另当别论。\n",
        "\n    如果你已经掌握了这些指令，请往上走，那里将有我的朋友教你使用这里的\n"+
            "投师学艺指令。\n",
    });
}

