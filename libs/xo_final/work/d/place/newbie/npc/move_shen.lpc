// nvshen1.c

#include <ansi.h>

inherit NEWBIE_NPC;

void create()
{
    ::create();

    set_name(YEL "女神" NOR,({"nvshen"}));

    my_msg = ({
        "\n    欢迎！欢迎！我是负责移动指令的女神，我将教你如何使用移动指令。\n",
        "\n    笑傲江湖中共有east，south，west，north，up，down，in，out 等基本移\n" +
            "动指令。分别对应着往东，南，西，北，上，下，里，外走。\n",
        "\n    east，south，west，north，up，down还可组合成其它一些指令，如north-\n" + 
            "east，southwest等，分别代表往东北和西南方向走。\n",
        "\n    为了方便玩家，每个指令都可以其首字母或首字母的组合代替。 如 e 代表\n" +
            "east，w代表west，ne代表northeast等。但in，out没有相应的简写。\n",
        "\n    最后介绍给你另一个跟移动有关的指令look（简写为l 〕。该指令不带参数\n" + 
            "时，显示你当前所在的地方的情况。参数可以是方向，如l west，也可以是人，\n" +
            "如l nvshen。以方向为参数时，显示对应方向处地点的描述；以人名为参数，则\n" +
            "显示该人物的描述。\n",
        "\n    好了，移动指令就介绍这些。你可以敲in进入熟悉这些指令的地方。那里模\n" + 
            "拟了清华的开放实验室，清华的玩家应该不会陌生，其他的朋友也可以藉此机会\n" +
            "熟悉一下清华最大的上机场所，权当参观。:)\n" +
            "    如果你已经掌握了这些指令，请往上走，那里将有我的朋友教你使用这里的\n" +
            "基本指令。\n"
    });
}

void greeting(object ob, int times)
{
    ::greeting(ob, times);

    if ( times == sizeof(my_msg) - 1 )
    {
        command( "whisper " + this_player()->query( "id" ) +  " 在实验室里迷路的话，请呼唤我的名字(nvshen)，我就会把你带回这里。\n");
    }
}

