// nvshen1.c

#include <ansi.h>
inherit NPC;
void create()
{
        set_name(YEL "女神" NOR,({"nvshen"}));
        set("gender", "女性" );
        set("age", 22);
        set("per",100);
        set("long",@LONG
    她面若桃花，眉如墨画，在一件雪白的纱衣的衬托下，更显得亭亭玉立。真
可谓沉鱼落雁，闭月羞花。你斜眼偷窥，只见她正看着你，目光中蕴满笑意，你
看着看着，不由得痴了。
LONG
        );
        set("combat_exp", 100000000);
        set("attitude", "friendly");
        set("rank_info/respect", "尊敬的女神");
        setup();
        carry_object(__DIR__"obj/sha")->wear();
}
