// xiaoer.c

#include <ansi.h>

inherit NPC;
inherit F_VENDOR;
void create()
{
	set_name(YEL "店小二" NOR, ({ "xiao er","waiter"}) );
	set("gender", "男性" );
	set("age", 22);
	set("long",
	"店小二身穿青布衣衫，正在忙着招呼客人。\n"
	);
	set("combat_exp", 1200);
	set("attitude", "friendly");
	set("rank_info/respect", "小二哥");
	set("vendor_goods", ([
        "小菜包子" : FOOD_DIR "xiaocai",
        "蟹黄包子" : FOOD_DIR "xiehuang",
        "稀沙包子" : FOOD_DIR "xisha",
        "芝麻包子" : FOOD_DIR "zhima",
        "鸭菜包子" : FOOD_DIR "yacai",
        "千层油糕" : FOOD_DIR "yougao",
        "火腿粽子" : FOOD_DIR "zongzi",
        "富春茶" : LIQUID_DIR "fuchun",
        "龙井茶" : LIQUID_DIR "longjing",
        "魁尖茶" : LIQUID_DIR "kuijian",
        ]) );
	setup();
	carry_object(__DIR__"obj/qingbu_yi")->wear();

}

void init()
{
	object ob;
	::init();
	if( interactive(ob = this_player()) && !is_fighting() ) {
		remove_call_out("greeting");
		call_out("greeting", 1, ob);
	}
	add_action("do_vendor_list", "list");
}

void greeting(object ob)
{
	if( !ob || environment(ob) != environment() ) return;
	say( "店小二说道：这位" + RANK_D->query_respect(ob)+ "，要点什么？\n");
}
