// nvshen1.c
//该女神负责跟交流有关的指令say,whisper,who,tell,reply,new,semote,nick,describe等

#include <ansi.h>

inherit NEWBIE_NPC;

void create() {
  ::create();

  set_name(YEL "女神" NOR, ({ "nvshen" }));

  my_msg = ({
    "\n    欢迎！欢迎！我是负责交流指令的女神，我将教你如何使用交流指令。\n",
    "\n    作为一名新手，一定有很多的问题要问。另外，mud 本身也是一个交朋友的\n" +
    "好地方。这些都离不开交流指令。\n",
    "\n    最简单的交流指令就是say，只要在 say 后加上你想说的内容就可以了。如\n" +
    "say hi。但请注意say指令只有跟你在一个地方的玩家才能看到。如果你想跟跟你\n" +
    "在一起的某个玩家说话，又不想让在场的其他人看到的话，可以用whisper指令。\n" +
    "指令格式为whisper 玩家代号 内容。\n",
    "\n    要想让你的话被在线的所有玩家看到，就要用到频道。这里的频道跟现实生\n" +
    "活中的频道概念没有什么差别。xo有new，chat，rumor等频道供玩家交流，但新\n" +
    "手只能使用new 频道。使用方法是new加空格再加你要说的内容。\n",
    "\n    如果你想跟一个不在你身边的玩家交流，但又不想让其它人知道。就要用到\n" +
    "另外三个命令：who，tell和reply。who 指令可以列出所有在线的玩家，tell指\n" +
    "令的用法是：tell 玩家代号 内容。当此玩家回答你后，你就可以用reply 内容\n" +
    "跟他继续交流了。\n",
    "\n    说到交流，就不能不提semote，所谓semote就是用一些易记的单词代替一些\n" +
    "常用的动作。至于xo里有哪些semote请使用help semote，具体各个semote代表什\n" +
    "动作，随着你的经验的增长你会知道的越来越多的。semote是mud里非常有意思的\n" +
    "一部分吆，不了解可不行。\n",
    "\n    另外还有两个指令要了解：nick和describe。顾名思义，nick就是给自己起\n" +
    "个绰号，describe就是创建自己的描述，当别人look你时将看到这些描述。给自\n" +
    "己起个好的绰号及写一段好的描述也是交流的一个方面。\n",
    "\n    如果你已经掌握了这些指令，请往上走，那里将有我的朋友教你使用这里的\n" +
    "投师学艺指令。\n",
  });
}
