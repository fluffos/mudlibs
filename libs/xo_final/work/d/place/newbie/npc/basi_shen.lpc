#include <ansi.h>

inherit NEWBIE_NPC;

void create() {
  ::create();

  set_name(YEL "女神" NOR, ({ "nvshen" }));

  my_msg = ({
    "\n    欢迎！欢迎！我是负责基本指令的女神，我将教你如何使用基本指令。\n",
    "\n    先介绍一下help指令，不带参数时，打help显示一个帮助主题列表。要看哪\n" +
    "项主题，只要在help后加主题就行了，如help maps等。\n",
    "\n    此外基本指令还有hp，score，skills，i等。其中i指令是显示你身上的物\n" +
    "品以及装备情况，其它指令的作用只要 help+指令名（如help hp) 就知道了。\n",
    "\n    如果你已经掌握了这些指令，请往上走，那里将有我的朋友教你使用这里的\n" +
    "交流指令。\n",
  });
}
