#include <room.h>
inherit ROOM;

void create() {
  set("short", "菜园");
  set("long", @LONG
你来到了一个不小的菜园，园子里的菜地分成了好几畦，分别种着白菜，萝
卜，韭菜，边上有几个小棚子，养了一些鸡鸭。一些新手正在田间做些农活，另
一些新手在喂鸡喂鸭，大家说说笑笑，园子里好不热闹。
LONG
  );
  set("exits", ([
    "southeast": __DIR__ "lian_life_cmds",
  ]));
  set("objects", ([
    __DIR__ "npc/lao_tou": 1,
  ]));

  setup();
}

void init() {
  add_action("do_work", ({ "work", "ganhuo" }));
  add_action("do_liangong", ({ "xiulian", "dazuo", "kill", "lian" }));
}

int do_liangong(string arg) {
  tell_object(this_player(), "这里不能练功。\n");
  return 1;
}

int do_work() {
  object ob, me;

  me = this_player();
  if (me->query("kee") < 10 || me->query("sen") < 30)
    return notify_fail("你太累，先去睡觉吧。\n");
  if (objectp(ob = present("laotou", (environment(me)))) &&
    ob->can_act()) {
    message_vision("$N辛苦的工作终于结束了，可人也累的要死\n", me);
    me->add("kee", -10);
    me->add("sen", -30);
    ob = new(MONEY_DIR "coin");
    ob->set_amount(50);
    ob->move(me);
    message_vision("老头对$N说：这是你的工钱。\n", me);
    return 1;
  }
  return notify_fail("你想帮谁干活啊？\n");
}
