inherit ROOM;

void create() {
  set("short", "小树林入口");

  set("long", @LONG
从这里可以望到北面的小树林，也可以隐约的看到南面的村口。
听说树林里有很多木人和怪物，进入之后可以用命令back回来。
LONG
  );

  set("exits", ([
    "north": MAZE_PATH "newbie/bigtree",
    "south": __DIR__ "cundao2",
    "west": __DIR__ "kitchen",
    "east": __DIR__ "bank",
    "northeast": __DIR__ "chehang",
  ]));

  set("objects", ([
    "/d/city/yangzhou/biaoju/obj/shitou": 10 + random(10),
  ]));

  set("outdoors", "newbie");

  setup();
}
