inherit ROOM;

void create() {
  set("short", "菜园");
  set("long", @LONG
你来到了一个不小的菜园，园子里的菜地分成了好几畦，分别种着白菜，萝
卜，韭菜，边上有几个小棚子，养了一些鸡鸭。一些新手正在田间做些农活，另
一些新手在喂鸡喂鸭，大家说说笑笑，园子里好不热闹。
LONG
  );

  set("exits", ([
    "east": __DIR__ "cundao1",
  ]));

  set("objects", ([
    __DIR__ "npc/lao_tou": 1,
  ]));

  set("outdoors", "newbie");

  set("no_fight", 1);

  setup();
}

void init() {
  add_action("do_work", ({ "work", "ganhuo" }));
  add_action("stop_working", "stop");
  add_action("do_liangong", ({ "xiulian", "dazuo", "kill", "lian" }));
}

int do_liangong(string arg) {
  tell_object(this_player(), "这里不能练功。\n");
  return 1;
}

int halt_working(object me) {
  message_vision("$N把手中的活一甩，嚷嚷道：不干了，不干了！\n", me);
  me->delete_temp("job/work");

  return 1;
}

int stop_working() {
  object me = this_player();

  me->interrupt_me(me);

  me->start_busy(10);

  return 1;
}

void finish_work(object who) {
  object coin;

  who->delete_temp("job/work");

  message_vision("$N辛苦的工作终于结束了，可人也累的半死。\n", who);
  message_vision("老头对$N说：这是你的工钱。\n", who);

  if (userp(who)) {
    coin = new(MONEY_DIR "coin");
    coin->set_amount(50 + random(50));
    coin->move(who);

    who->start_busy(3);
  }

  return;
}

int working(object me) {
  if (!living(me)) {
    me->delete_temp("job/work");
    return 0;
  }

  if (!me->query_temp("job/work/working") || !me->query_temp("job/work/time")) {
    me->delete_temp("job/work");
    return 0;
  }

  if (time() >= me->query_temp("job/work/time")) {
    finish_work(me);
    return 0;
  }

  if (!random(3)) {
    tell_object(me, "你擦了把身上的汗水！\n");
  }

  return 1;
}

int do_work() {
  object me = this_player();

  if (me->query_temp("job/work/working")) {
    tell_object(me, "你已经在工作了!\n");
    return 1;
  }

  if ((int)me->query("sen") < 30 || (int)me->query("kee") < 30) {
    tell_object(me, "你还是先去休息一下吧!\n");
    return 1;
  }

  me->add("kee", -10);
  me->add("sen", -10);

  me->set_temp("job/work/working", 1);
  me->set_temp("job/work/time", time() + 20 + random(10));

  message_vision("$N开始辛苦地工作，可以用stop停止......\n", me);

  me->start_busy((: call_other, __FILE__, "working", me :),
    (: call_other, __FILE__, "halt_working", me :));

  return 1;
}

int valid_leave() {
  object me = this_player();

  me->interrupt_me(me);
  return ::valid_leave();
}
