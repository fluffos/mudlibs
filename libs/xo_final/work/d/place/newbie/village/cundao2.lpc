inherit ROOM;

void create() {
  set("short", "村道");

  set("long", @LONG
这是一条弯弯曲曲的小路，沿着山坡通向山下。小路不宽，地面由青条石铺
成。从这里可以望到北面的小树林，也可以隐约的看到南面的村口。
LONG
  );

  set("exits", ([
    "north": __DIR__ "forest",
    "south": __DIR__ "cundao1",
    "west": __DIR__ "rest_male",
    "east": __DIR__ "rest_female",
  ]));

  set("outdoors", "newbie");

  set("no_fight", 1);

  setup();
}
