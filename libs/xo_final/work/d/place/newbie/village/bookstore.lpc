inherit ROOM;

string look_sign(object me);

void create() {
  set("short", "小书店");

  set("long", @LONG
这里专卖市坊中各种字画和书籍刻本，其中还有不少是难得一见的珍本，但由于
老板不善经营，加上地方过于偏僻，所以每天买书，看书的人没有多少，店内光线有
些不足，只老板辛友清一人无精打采地守着，四周乱七八糟堆着一些卷轴，线订本，
给人一种杂乱无章的感觉。
LONG);

  set("item_desc", ([
    "书架": (: look_sign :),
  ]));

  set("exits", ([
    "west": __DIR__ "cundao1",
  ]));

  set("objects", ([
    __DIR__ "npc/bookboss": 1
  ]));

  set("no_fight", 1);

  setup();
}

string look_sign(object me) {
  return "书架上堆满了书，有些已经翻得破破烂烂。\n";
}
