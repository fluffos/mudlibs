#include <ansi.h>

inherit NPC;

void create()
{
    set_name(YEL "老头" NOR, ({ "lao tou"}) );
    set("gender", "男性" );
    set("age", 52);
    set("long", "他有些佝偻，满脸皱纹，不过可能因为经常劳动，依然红光满面。\n");
    set("combat_exp", 1200);
    set("attitude", "friendly");
    set("rank_info/respect", "大爷");

    setup();

    carry_object(CLOTH_DIR"cloth1")->wear();
}

void init()
{
    object ob;

    ::init();

    if ( interactive(ob = this_player()) && !is_fighting() )
    {
        remove_call_out("greeting");
        call_out("greeting", 1, ob);
    }
}

void greeting(object ob)
{
    if ( !ob || environment(ob) != environment() )
    {
        return;
    }

    tell_object(ob, "这位" + RANK_D->query_respect(ob)+ "，要干活(work)吗？\n");
}

