inherit NPC;

int ask_me();

string *my_msg = ({
    "你可以去旁边的菜地干活儿挣钱。\n", 
    "可以去旁边的书店买书。\n", 
    "我们这个村子包吃包住。\n", 
    "村后的小树林可以练功。\n", 
    "离开村子可以ask我。\n", 
});

void create()
{
    set_name( "老村长", ({ "lao cunzhang", "cun zhang", "cunzhang" }) );

    set( "gender", "男性" );
    set( "age", 60 );
    set( "attitude", "friendly" );
    set( "rank_info/respect", "老人家" );
    set( "long", @LONG
老人家身形佝偻，自己在这里维持着可怜的生计。
LONG );

    set_wugong("jiben-neigong", 100, 100, 1);
    set_wugong("jiben-quanfa", 100, 100, 1);
    set_wugong("jiben-qinggong", 100, 100, 1);
    set_wugong("literate", 100, 100, 0);

    set_xiuwei_level_by_type("unarmed", 0);
    set_xiuwei_level_by_type("dodge", 0);
    set_xiuwei_level_by_type("force", 0);

    set( "combat_exp",  7500 );
    set( "can_teach", 1 );

    set( "talk_msg", ({
        "“这里不是经常有人来的，一般就附近的山里人偶尔到这里买一点土货。”",
    }) );

    set("inquiry",([
        "离开" : (: ask_me :),
        "leave" : (: ask_me :),
        "出村" : (: ask_me :),
    ]));

    setup();
    carry_object( CLOTH_DIR + "cloth1" )->wear();
}

void init()
{
    object ppl;

    ::init();

    if ( !userp( ppl = this_player() ) || !can_act() )
    {
        return;
    }

    remove_call_out( "Greeting" );
    call_out( "Greeting", 1, ppl );
}

void Greeting( object ppl )
{
    if ( !ppl || environment( ppl ) != environment(this_object()) )
    {
        return;
    }

    tell_object(ppl, my_msg[random(sizeof(my_msg))]);
}

int ask_me()
{
    object me = this_player();
    object letter = new( __DIR__ "obj/letter");

    if ( letter && letter->move(me) )
    {
        tell_object(me, "既是这样，就拿这封信去车行吧。\n马车的目的地是随机的，你的未知旅程就从这里开始吧。\n");
    }

    return 1;
}

int accept_teach(object ob, string skill)
{
    return 1;
}

int zhongcheng( object me, string skill )
{
    return 1;
}

