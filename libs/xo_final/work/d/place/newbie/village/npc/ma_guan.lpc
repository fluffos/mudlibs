inherit NPC;

void create() {
  set_name("梅老三",
    ({ "mei laosan", "mei", "laosan", "meilaosan", "stableman" }));
  set("title", "马倌");
  set("gender", "男性");
  set("age", 24);
  set("str", 26);
  set("per", 10);
  set("long", @LONG
    一个村里的年轻人，被派到这里来看马。他尖头削背，看上去蛮机灵的。
LONG
  );
  set("chat_chance", 3);

  set("chat_msg", ({
    "马倌一边往石槽里添草一边叹气。\n",
    "马倌说：“唉！累了一整天也落不了个好！”\n",
    "马倌说：“什么时候我也能发笔财就好了！”\n",
  }));

  setup();
  carry_object(CLOTH_DIR + "cloth1")->wear();
}

int accept_object(object ppl, object obj) {
  object horse;

  if (!obj->id("xin")) {
    command("say “我不是收破烂的！”");
    return 0;
  }

  if (!obj->query("leave_village")) {
    command("say “我不是收破烂的！”");
    return 0;
  }

  if (!(horse = new(__DIR__ "obj/mache")) || !ppl->move(horse)) {
    command("say “马车还在路上！”");
    return 0;
  }

  tell_object(ppl, name() + "一把将你推进一辆马车里。\n");

  call_out("Dest", 1, obj);

  return 1;
}

void Dest(object obj) {
  destruct(obj);
}
