inherit ITEM;

void create()
{
    set_name("信", ({"xin", "letter"}));

    if ( clonep() )
    {
        set_default_object(__FILE__);
    }
    else
    {
        set("long", "一封封的严严实实的信，信封上写着：给车行。\n");
        set("unit", "封");
        set("value", -100);
    }

    set("leave_village", 1);

    setup();
}

