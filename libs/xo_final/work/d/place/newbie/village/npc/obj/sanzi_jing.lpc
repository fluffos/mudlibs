inherit BOOK;

void create() {
  set_name("《三字经》", ({ "sanzi jing", "jing", "book", "shu" }));
  set_weight(600);

  if (clonep()) {
    set_default_object(__FILE__);
  } else {
    set("unit", "本");
    set("long", "这本书的纸张都已经泛黄了，看上去相当破旧。\n");
    set("value", 70);
    set("material", "paper");
    set("skill", ([
      "name": "literate",
      "xiuwei_required": 0,
      "gin_cost": 10 + random(20),
      "max_lingwu": 50,
      "bonus_jilei": -1,  //-1表示用literate来计算你每次所得的jilei
    ]));
  }
}
