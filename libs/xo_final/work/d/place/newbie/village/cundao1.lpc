inherit ROOM;

void create()
{
    set("short", "村道");

    set("long", @LONG
这是一条弯弯曲曲的小路，沿着山坡通向山下。小路不宽，地面由青条石铺
成。从这里可以望到北面的街道，也可以隐约的看到南面的村口。
LONG
    );

    set("exits", ([ 
        "north" : __DIR__"cundao2",
        "south" : __DIR__"entry",
        "west"  : __DIR__"caiyuan",
        "east"  : __DIR__"bookstore",
    ]));

    set("outdoors", "newbie");

    set("no_fight", 1);

    setup();
}

