inherit ROOM;

void create()
{
    set( "short", "车行" );
    set( "long", @LONG
这里一共有五排棚子，养着好几百匹高头军马，大部分都是从西北民族手中
买来的。每天清晨，骑兵队都要牵出马来出城巡逻，到掌灯时分才回来。每到马
队列队时，就会有许多孩子甚至成年人在路边看热闹，可是谁也不敢靠近。
LONG
    );

    set( "exits", ([
        "southwest"     :   __DIR__"forest",
    ]) );

    set( "objects", ([
        __DIR__"npc/ma_guan"    :   1,
    ]) );

    set("no_fight", 1);

    setup();
