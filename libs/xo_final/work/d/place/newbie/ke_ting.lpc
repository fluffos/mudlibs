#include <ansi.h>
#include <room.h>
inherit ROOM;

void create()
{
    set("short", "客厅");
    set("long", @LONG
这里是培训站的客厅，北墙贴着一张山水画，一看就知是名家手笔，倚墙放
着一张红木桌，两张太师椅。女神正陪着刘星海，两人各坐在一张太师椅上。桌
上放置着一盘盆景。左右两边的廊柱下放着一排红木椅，间隔着放着几张茶几，
茶几上摆放一些时鲜花木。
LONG
    );
    set("no_fight",1);
    set("exits", ([
         "out" : __DIR__"appr_cmds",
    ]));
    set("objects", ([
        __DIR__"npc/liu_xinghai" : 1,
        __DIR__"npc/nvshen" : 1,
    ]));
    set("no_kill", "penglai");
    setup();
}

void init()
{
    call_out("give_sth", 1);
}

//为了方便新手，这里给新手练习轻功用的负重的石头和练习剑法用的剑
int give_sth()
{
    object sth,who;

    who=this_player();
    if (!userp(who)) return 1;
    if ( objectp(present("shitou",who)) ) return 1;
    sth = new(__DIR__"obj/shi_tou");
    sth->move( who );
    who->save();
    message_vision("天上忽然落下一块石头，好象是练习轻功时用的，差点砸死$N。\n",who);
    if ( objectp(present("pojian",who)) ) return 1;
    sth = new(__DIR__"obj/po_jian");
    sth->move( who );
    sth->wield();
    who->save();
    message_vision("天上忽然落下一柄破剑，差点刺死$N。\n",who);
}
