// Room: /d/newbie/kaifang/da_men.c

#include <ansi.h>

inherit KAIFANG;

string look_sign(object me);

void create()
{
    set("short", "大门");
    set("long", @LONG
这是是清华大学开放实验室的大门，门前有一个平台。门开着，看来今天不
是10号，机房正开放，不时有学生进进出出。门上挂着一块匾(sign)，往东走下
一些台阶，是门厅。
LONG
    );

    set("exits", ([ 
        "eastdown"  : __DIR__"men_ting",
	    "out"       : "/d/place/newbie/move_cmds", 
    ]));

    set("item_desc", ([
        "sign" : (:look_sign:),
    ]));

    setup();
}

string look_sign(object me)  
{
    return HIY "清华大学开放实验室。\n" NOR;
}

