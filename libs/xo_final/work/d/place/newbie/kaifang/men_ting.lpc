// Room: /d/newbie/kaifang/men_ting.c
#include <ansi.h>

inherit KAIFANG;

void create() {
  set("short", "门厅");
  set("long", @LONG
这里是门厅，墙壁上有两块板，分别是实验室的平面图和信息管理中心的介
绍。两块板的下方各有一个长凳。西北面是男厕所，西南是女厕所，北面是划卡
处，西面向上是大门。
LONG
  );
  set("exits", ([
    "westup": __DIR__ "da_men",
    "northwest": __DIR__ "nan_ce_suo",
    "southwest": __DIR__ "nv_ce_suo",
    "north": __DIR__ "hua_ka_chu",
  ]));
  setup();
}

int valid_leave(object me, string dir) {
  if ((dir == "northwest") && (this_player()->query("gender") != "男性"))
    return notify_fail("你去那种地方干吗?!\n");
  else if ((dir == "southwest") && (this_player()->query("gender") != "女性"))
    return notify_fail("流氓啊！！！！！\n");
  else
    return ::valid_leave(me, dir);
}
