// Room: /d/newbie/kaifang/hua_ka_chu.c
#include <ansi.h>

inherit KAIFANG;
void create() {
  set("short", "划卡处");
  set("long", @LONG
这里是划卡处，只有划卡后才允许进入，退出后要划卡注销。当然如果有人
要参观，经过实验室工作人员同意也可以进入。往西有过道通往西机房，北面是
中央机房，往南是门厅。
LONG
  );
  set("exits", ([
    "west": __DIR__ "guo_dao",
    "north": __DIR__ "yi_duan",
    "south": __DIR__ "men_ting",
  ]));
  setup();
}

void init() {
  ::init();
  add_action("hua_ka", "hua_ka");
  call_out("give_card", 1);
}

int valid_leave(object me, string dir) {
  if (((dir == "west") || (dir == "north")) && (this_player()->query("ppfx/have_hua") != 1))
    return notify_fail("请先划卡(hua_ka)再进入机房!\n");
  else if ((dir == "south") && (this_player()->query("ppfx/have_hua") != 0))
    return notify_fail("请先划卡(hua_ka)再离开，否则你的机时会延续到晚上10:00!\n");
  else
    return ::valid_leave(me, dir);
}

int give_card() {
  object ka, who;

  who = this_player();
  if (objectp(present("linshi ka", who)) || objectp(present("ka", who)))
    return 1;
  ka = new(__DIR__ "obj/lin_shi_ka");
  ka->move(who);
  ka->set("long", "一张实验室的临时卡，可以凭此出入实验室。卡上有条形码和你的名字" +
    HIM " " + who->query("name") + NOR "\n");
  who->save();
  message_vision("天上飘来一个卡片，好象是出入机房的临时卡，落在$N手上。\n", who);
}

int hua_ka() {
  object who;
  string mess;

  who = this_player();
  if (who->query("ppfx/have_hua") == 1) {
    who->set("ppfx/have_hua", 0);
    mess = "注销成功\n";
  } else {
    who->set("ppfx/have_hua", 1);
    mess = "注册成功\n";
  }
  message_vision("$N拿出临时卡，在划卡机上轻轻的划过，显示屏上显示出" + HIC "" + who->query("name") + mess + NOR, who);
  return 1;
}
