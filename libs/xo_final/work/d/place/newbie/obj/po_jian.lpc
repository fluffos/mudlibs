#include <weapon.h>
#include <ansi.h>

inherit SWORD;

void create() {
  set_name("新手之剑", ({ "pojian" }));
  set_weight(1500);
  set("long", "一把锈迹斑斑的长剑，是专为新手练习lian指令而设的。\n");
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("material", "steel");
  }
  init_sword(1);
  set("wield_msg", "$N「唰」的一声抽出一把$n握在手中。\n");
  set("unwield_msg", "$N将手中的$n插回腰间的剑鞘。\n");
  setup();
}
