#include <ansi.h>
#include <room.h>

inherit ROOM;

void create()
{
    set("short", HIM "第一级:移动指令" NOR);
    set("long", @LONG
这里是笑傲江湖新手培训站中移动指令的培训教室。一排排的桌椅整整齐齐，
负责讲授移动指令的巫师正在授课，下面有很多象你一样的xo的新手正在认真的
听课。时时有新手若有所得的点点头，恰在这时，巫师讲到了精彩处，教室里暴
发出一阵热烈的掌声。你被这种气氛所感染，静静的坐到一个空位上，开始学习
xo中的移动指令。
LONG
    );

    set("exits", ([ 
        "up" : __DIR__"basi_cmds",
	    "down": __DIR__"start",
        "out" : __DIR__"start",
	    //"in"  : __DIR__"kaifang/da_men",
    ]));

    set("objects", ([ /* sizeof() == 1 */
        __DIR__"npc/move_shen.lpc" : 1,
    ]));

    set("no_fight",1);
    setup();

    replace_program(ROOM);
}
