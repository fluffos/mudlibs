#include <ansi.h>
#include <room.h>
inherit ROOM;

void create() {
  set("short", "练武场");
  set("long", @LONG
练武场青石铺地，南边倚墙靠着个兵器架，插着各式器械。东头一个沙坑，
边上放着几个石锁，石磨盘，北面立着几个木桩。
LONG
  );
  set("exits", ([
    "out": __DIR__ "figh_cmds",
  ]));
  set("objects", ([
    __DIR__ "npc/pei_lian": 4,
  ]));
  setup();
}
