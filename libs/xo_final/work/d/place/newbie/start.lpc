// Room: /d/newbie/start.c
// 这是新手培训站的入口,里边Xo的简单介绍.
// By ppfx
#include <ansi.h>
#include <room.h>

inherit ROOM;

void create() {
  set("short", "新手培训站");
  set("long", @LONG
欢迎你加入到Xo，从这里你将开始神秘的武林之旅。这里有血雨腥风，也有
柔情脉脉。你可以成为一代大虾，也可以成为无恶不作的大坏蛋，一切都取决于
你自己。笑傲江湖是一个完全由国人自主开发的MUD ，这里的很多指令都是汉语
拼音。虽然可能有些朋友更喜欢英文的指令，但用中文指令带来的亲切感也许你
只能在这里体会到。:)
    如果你确定要从此离开这个新手培训站，请使用leave指令。
LONG
  );

  set("exits", ([ /* sizeof() == 2 */
    "up": __DIR__ "move_cmds",
  ]));

  set("objects", ([ /* sizeof() == 1 */
    __DIR__ "npc/start_shen.lpc": 1,
  ]));

  set("no_fight", 1);

  setup();
}

void init() {
  add_action("do_leave", "leave");
}

int do_leave(string arg) {
  object me = this_player();
  string start_room;

  me->delete_all_wugong();
  me->delete("family");
  me->delete("zuzhi");
  me->delete("class");

  me->set_xiuwei_by_type("unarmed", 0);
  me->set_xiuwei_by_type("sword", 0);
  me->set_xiuwei_by_type("blade", 0);
  me->set_xiuwei_by_type("long", 0);
  me->set_xiuwei_by_type("short", 0);
  me->set_xiuwei_by_type("dodge", 0);
  me->set_xiuwei_by_type("force", 0);
  me->set_xiuwei_by_type("zonggang", 0);

  me->set("max_force", 0);
  me->set("force", 0);
  me->set("combat_exp", 0);
  me->set("title", "普通百姓");
  me->set("mud_age", 0);

  start_room = __DIR__ "village/entry";
  tell_object(me, "你的笑傲江湖历程就从此开始了。\n");
  tell_object(me, "大小神仙们一起对你高喊: 加油!!\n");
  LOG_D->clear_log(me->query("id"));
  LOG_D->do_log(me, sprintf("你充满传奇色彩的一生就从%s开始。",
    load_object(start_room)->query("short")));

  me->delete("ppfx/interval");
  me->delete("ppfx/have_hua");
  me->delete("xli_marks/is_newbie");
  me->delete("xli_marks/enter_room");

  me->move(start_room);
  me->set("startroom", start_room);
  me->save();

  return 1;
}
