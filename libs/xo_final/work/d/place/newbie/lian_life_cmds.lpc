#include <ansi.h>
#include <room.h>
inherit ROOM;
void create()
{
    set("short", HIY "生活指令练习中心" NOR);
    set("long", @LONG
东面是当铺兼钱庄，西面是一家小店，南面是男卧室，北面是女卧室，西北
是一个菜园，可以在那里赚钱。这些都是新手练习常用生活指令的地方。
LONG
    );
    set("exits", ([ /* sizeof() == 6 */
        "east"  : __DIR__"dangpu_qianzhuang",
        "west": __DIR__"xiao_dian",
        "south"  : __DIR__"nan_woshi",
        "north" : __DIR__"nv_woshi",
        "out" : __DIR__"life_cmds",
        "northwest" : __DIR__"cai_yuan",
    ]));
    set("no_fight",1);
    setup();
}

int valid_leave(object me, string dir)
{
        if (wizardp(me))
            return ::valid_leave(me,dir);
        if ( (dir=="south") && (this_player()->query("gender")!="男性") )
           return notify_fail("你去那种地方干吗?!\n");
        else if ( (dir=="north") && (this_player()->query("gender")!="女性") )
           return notify_fail("流氓啊！！！！！\n"); 
        else
           return ::valid_leave(me,dir);
}
