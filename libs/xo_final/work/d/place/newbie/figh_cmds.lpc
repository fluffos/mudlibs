#include <ansi.h>
#include <room.h>

inherit ROOM;

void create() {
  set("short", HIR "第六级:打斗指令" NOR);
  set("long", @LONG
这里是笑傲江湖新手培训站中打斗指令的培训教室。一排排的桌椅整整齐齐，
负责讲授打斗指令的巫师正在授课，下面有很多象你一样的xo的新手正在认真的
听课。时时有新手若有所得的点点头，恰在这时，巫师讲到了精彩处，教室里暴
发出一阵热烈的掌声。你被这种气氛所感染，静静的坐到一个空位上，开始学习
xo中的打斗指令。
LONG
  );

  set("exits", ([ /* sizeof() == 3 */
    //"in"  : __DIR__"lianwu_chang", 
    "out": __DIR__ "start",
    "down": __DIR__ "life_cmds",
  ]));

  set("objects", ([ /* sizeof() == 1 */
    __DIR__ "npc/figh_shen.lpc": 1,
  ]));

  set("no_fight", 1);
  setup();

  replace_program(ROOM);
}
