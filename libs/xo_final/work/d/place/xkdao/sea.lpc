//sea.c.浅海
//date:1997.8.19
// by dan 

#include <room.h>
#include <ansi.h>
#include <nature.h>

inherit ROOM;    

void create()
{
    set("short", HIC"浅海"NOR);
    set("long",@LONG
这是靠近岸边的浅海，远处是汹涌澎湃的大海，海浪一浪高过一浪，海风呼
啸着卷起七八丈高的海浪向你扑过来，打在你身上，你浑身上下已没有一处是干
的了，你已经快要支持不住了。一条条鱼儿在海里遨游，丝毫不畏惧海浪的肆意
冲击.
LONG);
    set("exits", ([ /* sizeof() == 2 */
       "south" : __DIR__"shore",
    ]));  
    set("objects",([
      __DIR__"npc/fish" : 1 ,
      __DIR__"npc/dolphin":1,
    ]));
    set("type", 1);
    set("discrease",10);
    set("not_startroom",1);
    setup();
}                            

void init()
{
    object me,room1,room2,room3;
    me = this_player();
    if ( me->query("id") == "xiong" )
    {
         me->move( __DIR__"shore" );
    }
    if ( !room1 = find_object(__DIR__"caodi") )
          room1 = load_object(__DIR__"caodi");
    if ( !room2 = find_object(__DIR__"shore") )
          room2 = load_object(__DIR__"shore");        
    if ( !room3 = find_object(__DIR__"sea") )
          room3 = load_object(__DIR__"sea");
    if ( room1->query("typhoon") )
    {
       message_vision(RED"台风正在逼近小岛......\n",me);
       return ;
    } 
    if ( room2->query("typhoon") )
    {
       message_vision(RED"台风正在逼近小岛......\n",me);
       return ;
    } 
    if ( room3->query("typhoon") )
    {
       message_vision(RED"台风正在逼近小岛......\n",me);
       return ;
    } 
    if( NATURE_D->GetSeason() == AUTUMN )
    {
       if ( random( 5 ) < 4 ) return;
    }   
    if ( random( 10 ) > 0 ) return;
    message_vision(RED"台风来了，风量慢慢变大了......\n"NOR,me);
    room1->set("typhoon",1);
    room2->set("typhoon",1);
    room3->set("typhoon",1);
    remove_call_out("typhoon");
    call_out("typhoon",30,me);
    return;
}

int typhoon(object me)
{
    object room1,room2,room3,*inv;
    int j;
    if ( !room1 = find_object(__DIR__"caodi") )
          room1 = load_object(__DIR__"caodi");
    if ( !room2 = find_object(__DIR__"shore") )
          room2 = load_object(__DIR__"shore");        
    if ( !room3 = find_object(__DIR__"sea") )
          room3 = load_object(__DIR__"sea"); 
    message_vision(RED"台风卷过海岛，杀死了一切生气......\n"NOR,me); 
    room1->set("typhoon",0);
    room2->set("typhoon",0);
    room3->set("typhoon",0);
    inv = all_inventory( room1 );
    for ( j = 0; j < sizeof(inv); j++ )
    {  
       if ( living( inv[j] ) )   
       {
           inv [j] ->die();
       }
       else
       {
           if ( inv[j]->query("id") != "mu wu"  )
           destruct( inv[j] );
       }                       
    }
    inv = all_inventory( room2 );
    for ( j = 0; j < sizeof(inv); j++ )
    {  
       if ( living( inv[j] ) )   
       {
           inv [j] ->die();
       }
       else
       {
           destruct( inv[j] );
       }                       
    }
    inv = all_inventory( room3 );
    for ( j = 0; j < sizeof(inv); j++ )
    {  
       if ( living( inv[j] ) )   
       {
           inv [j] ->die();
       }
       else
       {
           destruct( inv[j] );
       }                       
    }                      
    return 1;
}

