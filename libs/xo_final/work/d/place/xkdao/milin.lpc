#include <room.h>
#include <ansi.h>

inherit ROOM;

void create() {
  set("short", GRN "密林" NOR);
  set("long", @LONG
这是阴暗的丛林，四周都是高大参天的乔木，把阳光都遮住了，灰灰暗暗的
让你几乎看不清路了，无数的蔓条从四面八方伸过来，把你扯得一坑一拌的。路
上、树下都铺上了厚厚的一层枯叶，看来这里是很少有人来过的，你已经分辨方
向了. 在树丛中还有很长的杂草......
LONG);
  set("exits", ([ /* sizeof() == 2 */
    "out": __DIR__ "caodi",
  ]));
  set("outdoor", "xkdao");
  set("search_things", ([
    "枯叶": __DIR__ "npc/obj/modao_shi",
  ]));
  set("not_startroom", 1);
  if (random(10) > 0)
    set("objects", ([
      __DIR__ "npc/obj/polei_shu": 1,
      __DIR__ "npc/hare": 1,
    ]));
  if (random(8) == 1)
    add("objects", ([ __DIR__ "npc/lnwm": 1, ]));
  setup();
}

void init() {
  object ob, room, cave;
  int i;
  if (!room = find_object(__DIR__ "milin"))
    room = load_object(__DIR__ "milin");
  if (!cave = find_object(__DIR__ "cave"))
    cave = load_object(__DIR__ "cave");
  if (cave->query("dan") == 0) {
    i = random(10);
    if (i >= 8) {
      cave->set("dan", 1);
      cave->set("long", (string)cave->query("long"));
    }
    if (i < 8) {
      cave->set("dan", 2);
      cave->set("long", (string)cave->query("long1"));
    }
    /*
      if ( i < 4 )
      {
           cave->set("dan",3);
           cave->set("long", (string)cave->query("long2") );
           npc = new( __DIR__"npc/man1");
           npc ->move( cave );
      }
*/
  }
  if (!(room->query_temp("xiong"))) {
    if (random(20) > 18) {
      room->set_temp("xiong", 1);
      ob = new(__DIR__ "npc/bear");
      ob->move(__DIR__ "milin");
    }
  }

  add_action("do_kill", "kill");
  return;
}

int do_kill(string arg) {
  object me, ob, obj;

  me = this_player();
  ob = this_object();

  if (!obj = present("ye tu", ob))
    return 0;
  if (arg == "ye tu") {
    message_vision("兔子受惊含往南逃窜，无影无踪.....\n", me);
    destruct(obj);
    if (!ob->query("exits/south"))
      ob->add("exits/south", "/d/place/xkdao/cave");
    call_out("close_path", 10, ob);
    return 1;
  }
  return 0;
}

int close_path(object ob) {
  if (ob->query("exits/south"))
    ob->delete("exits/south");
  return 1;
}
