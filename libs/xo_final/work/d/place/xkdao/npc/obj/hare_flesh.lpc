#include <ansi.h>

inherit ITEM;
inherit F_FOOD;

void create()
{
    set_name(YEL"烤兔肉"NOR, ({"kaotu rou","rou"}));
    set_weight(1500);
    if (clonep())
            set_default_object(__FILE__);
    else {
        set("long", "一块肥得流油的烤兔肉。\n");
        set("unit", "块");
        set("value", 20);
        set("food_remaining", 10);
        set("food_supply", 50);
    }
}
