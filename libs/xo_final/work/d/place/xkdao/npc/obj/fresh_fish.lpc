#include <ansi.h>

inherit ITEM;

void create()
{
    set_name(RED"鱼肉"NOR, ({"yu rou","rou"}));
    set_weight(1500);
    if (clonep())
            set_default_object(__FILE__);
    else {
        set("long", "一块未加工的鱼肉。\n");
        set("unit", "块");
        set("value", 20);
        set("can_cook",1);
        set("cook_name","grill_fish");
        set("cook_msg","$N找了根木棍串起鱼，在火堆上烤了起来.....\n");
     }
}
