#include <ansi.h>

inherit ITEM;

void create()
{
    set_name(YEL"断斧"NOR, ({"duan fu","fu"}));
    set_weight(300);
    if (clonep())
    {
            set_default_object(__FILE__);
    }
    else 
    {
        set("long", "一把锈迹斑斑的断了的斧子，好像不怎么好用的....\n");
        set("unit", "把");
        set("value", 20);
    }
}

