//firestone.c.燧石
//date:1997.10.23
//by dan

#include <ansi.h>

inherit ITEM;

void create()
{
    set_name(YEL"燧石"NOR, ({"sui shi","shi"}));
    set_weight(300);
    if (clonep())
            set_default_object(__FILE__);
    else {
        set("long", "几块燧石，据说可以打出火，你试试....\n");
        set("unit", "块");
        set("value", 20);
     }
}

void init()
{
   add_action("do_fire","fire");
}

int do_fire(string arg)
{
     object ob,obj,me,evn,*inv;
     int i;
     me = this_player();
     evn =  environment( me );
     if ( !arg )
       {
         inv = all_inventory( evn );
         for ( i = 0; i < sizeof(inv); i++ )
          {
            if ( inv[i]->query("can_fire") )
             {
               ob = inv[i];
             } 
          }
          if ( !objectp( ob) )
          return notify_fail(" 没有什么可烧的啊.......\n");
       }  
     else
       { 
          if ( !objectp(ob = present(arg, evn)) )
          return notify_fail("你面前并没有这样东西。\n");
          if ( !ob->query("can_fire") )
          return notify_fail("这东西点不着，你还是....烧自己的手也许好些!\n");
       }
     message_vision("$N拿起燧石开始点$n...着了一团火出来了...\n",me,ob);
     obj = new( __DIR__"firebrand" ) ;
     obj ->move( evn );
     destruct(ob);   
     return 1;
}  
