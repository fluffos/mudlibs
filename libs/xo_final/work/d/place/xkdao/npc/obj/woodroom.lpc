#include <ansi.h>

inherit ITEM;

void create()
{
    set_name(GRN"木屋"NOR, ({"mu wu","wu"}));
    set_weight(1500000);
    if (clonep())
            set_default_object(__FILE__);
    else {
        set("long", "一间用木料搭成的木屋，将就着住吧....\n");
        set("unit", "间");
        set("value", 20);
        set("can_fire",1);
     }
}
