//fishman.c. 渔 夫
//data:1997.10.16
//by dan

inherit NPC;

#include <ansi.h>

int about_chuhai(object me);

void create()
{
     set_name(" 渔夫",({"fishman"}));
     set("gender","男性");
     set("age",50);
     set("long",@LONG
他皮肤黝黑，饱经风霜的脸上流露出大海的沧桑!
LONG
     );
     setup();
     set("chat_chance",5);
     set("chat_msg",({
     "渔夫说道：这些天总有人来这儿，要出海，好象是找什么侠客\n"+
     "岛, 我祖祖辈辈都在这一带海上打鱼为生，从没听说过.\n",
     }) );
     set("inquiry",([
       "出海":(:about_chuhai:),
     ]));
}

int about_chuhai(object me)
{
    string msg;
    object ob,boat;
    me = this_player();
    ob = this_object();
    boat= load_object("/d/place/xkdao/shore1");
    msg="";
    if (boat->query("xk_shore")==0)
    {
    if (me->query("xk_boat")== 0)
    {
        msg+="这几天天气不错，我也正想出海,咱们一块可以做\n";
        msg+=" 个伴, 你去准备一下，我在海边等你。\n";
        me->set("xk_boat",1);
        message_vision("渔夫回答:"+msg,me);
        command("go south");
        command("enter");
        return 1;
    }
    if (me->query("xk_boat")==2)
    {
        msg+="太危险了， 可不想陪你去海上送死.\n";
        message_vision(" 渔 夫 回 答:"+msg,me);
//        boat->delete("exits/enter");
        return 1;
    }
    msg+="你想出海？....";
    message_vision(" 渔 夫 回 答:"+msg,me);
    return 1;
    }
    msg+="不好。。。我的船不见了...\n";
    message_vision("渔夫叫道:"+msg,me);
    return 1;
}
