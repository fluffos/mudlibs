#include <ansi.h>

inherit NPC;

void create()
{
	set_name(BLU "鱼儿" NOR, ({ "yu", "fish" }) );
	set("race", "野兽");
	set_weight(2500);
	set("age", 1);
	set("long", "一条在水中自由游动的鱼儿,当心它可吃肉......\n");
	set("verbs", ({ "bite" }) );
    set("combat_exp", 30000);
    set("edible",1);
    set("refine_name","fresh_fish");
    set("refine_msg","$N拿起鱼开膛...破肚...去鳞...剔骨...加工成上好的鱼肉.\n");
	setup();
}
