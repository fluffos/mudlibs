inherit ROOM;
#include <biwu.h>

void create() {
  set("short", "休息室");
  set("long", @LONG
这是一间供参加比武的人小憩的房间。两端各自摆放着一张舒适的大躺椅，
躺椅的旁边是一个小茶几，还有一个梳洗的架子，架子上放着一盆热水，搭着一
块雪白的毛巾，旁边有一块小小的香皂。
LONG);
  set("not_startroom", 1);
  setup();
}
