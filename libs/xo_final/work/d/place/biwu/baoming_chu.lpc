//   file  :   /d/place/biwu/baoming_chu.c
//   attrib:   room
//   name  :   比武大赛报名处
//   write :   xli
//   date  :   1999.6
//   last modified:xli 1999.6
inherit ROOM;
#include <ansi.h>
#include <biwu.h>
//BIWU_TITLE
//BIWU_DENGJI_1 BIWU_DENGJI_2 BIWU_DENGJI_3

string paper_desc;
void create()
{
    set("short","比武大赛报名处");
    set("long", @LONG
这里就是笑傲江湖（XO）比武大赛的报名处，大门正敞开着，一面五色锦旗
在门口迎风招展。宽阔的大厅里面摆放着几张檀木方桌，桌子上有着笔墨纸砚，
还有几个翠竹镂空编织成的小箱子。只见几个笑傲江湖的巫师正在忙着给来参加
笑傲江湖比武大赛的人们进行登记，人是络绎不绝，却也井然有序。
    正对大门的墙上醒目地贴着一张“报名规则”（ＰＡＰＥＲ）。
LONG);
    paper_desc=
"    ================================================\n"+
"                 笑傲江湖"+BIWU_TITLE+"报名规则\n"+
"    ================================================\n"+
"    凡欲参加笑傲江湖"+BIWU_TITLE+"的人员，均须先行在此处交\n"+
"    纳参赛费用并签字画押，方能得到参赛资格。\n"+
"    本次比武大赛按照年龄段分为三个组别：\n"+
"     组别名称          年龄限制\n"+
"    "+BIWU_DENGJI_1+"        50岁以上\n"+
"    "+BIWU_DENGJI_2+"        35岁至50岁\n"+
"    "+BIWU_DENGJI_3+"        20岁至35岁\n"+
HIR"    凡是现有年龄低于20岁以下者，请勿参加本次"+BIWU_TITLE+"。\n"NOR+
"    由于组织本次"+BIWU_TITLE+"所需，特对参赛者收取参赛费用，\n"+
"    对应于以上三个组别，收费分别为\n"+
"    "+HIY"8两银子    "
"    "+HIB"4两银子    "
"    "+HIM"2两银子\n"NOR
"    请将参赛费用交给负责参赛者报名工作的"+HIG"可乐"NOR+"小姐，谢谢合作！\n"+
"\n"
"    在交纳了相应的费用后，请画押（ＨＵＡＹＡ）以保证遵从下面几点：\n"
"    1.公平竞争，服从任何对阵安排并认真投入比赛。\n"
"    2.服从比赛结果，尊重组织者对比赛输赢的判定。\n"
"    3.不在比赛过程中使用欺骗和狡诈的手段谋取利益。\n"
"    4.不在比赛过程中有不文明表现。\n"
"    ===============================================\n";

    set("item_desc", ([
    "paper" : paper_desc,
    ]));
    
    set("objects", ([
    __DIR__"npc/miss_kele.lpc" : 1,   //接待小姐可乐
    ]));
    set("exits", ([
    "out" : __DIR__"restroom",
    ]));
    set("no_fight",1);
    set("not_startroom",1);
    setup();
}

void init()
{
    add_action("do_huaya","huaya");
}

int do_huaya(string arg)
{
    object me=this_player();
    if(!me->query("xli_marks/can_huaya"))
        return notify_fail("你尚未交纳参赛费用，请先交纳后进行登记。\n");
    tell_object(me,
    "你拿起一支毛笔，仔细端详了一下面前的保证书......\n"
    "只见上面写着：\n"
    "我自愿报名参加笑傲江湖"+BIWU_TITLE+"，并遵守如下规定\n"
    "1.公平竞争，服从任何对阵安排并认真投入比赛。\n"
    "2.服从比赛结果，尊重组织者对比赛输赢的判定。\n"
    "3.不在比赛过程中使用欺骗和狡诈的手段谋取利益。\n"
    "4.不在比赛过程中有不文明表现。\n\n"
    "特此立据，立据人：\n\n");
    tell_object(me,"你想了想，在立据人一栏中工工整整地填下了："+me->query("name")+"。\n");
    tell_object(me,HIG"可乐"NOR+"小姐拿起保证书，看了一下你的签名，对你微笑着说：\n");
    tell_object(me,"好了，你已经登记在笑傲江湖"+BIWU_TITLE+"的参赛人员中了。\n");
    tell_object(me,"记得到时一定要来参加哦！\n");
    log_file(BAOMING_FILE,me->query("id")+"\n");
    me->delete("xli_marks/can_huaya");
    me->set("xli_marks/have_baoming",1); // 报名过，记录在案
    return 1;
}
