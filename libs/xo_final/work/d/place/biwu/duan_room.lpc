#include <biwu.h>
#include "kantai.h"

void create() {
  set("short", "段氏厅");
  set("long", @LONG
这里就是大理段氏弟子观看比武大会的大厅。一色的青砖铺地，宽大的厅堂
里放着几张圆桌和几十张硬木凳子，厅的中央摆放了几张小小的茶几，几盆茶花
点缀在十几张红木太师椅中间，显然是给段府中地位高的人准备的。
几个高级家丁和丫鬟在旁肃立着。
LONG);
  set("objects", ([
    "/d/menpai/duanshi/npc/jiading1": 1,
    "/d/menpai/duanshi/npc/shinv": 2,
  ]));
  set("not_startroom", 1);
  setup();
}
