inherit ROOM;
#include <biwu.h>

void create() {
  set("short", "比武大厅");
  set("long", @LONG
这里就是笑傲江湖比武大会的比武大厅了。空荡荡的房间里面并没有什么东
西，青石方砖铺就的地面直展开来，倒映着周围火把闪烁的火光，看上去不禁让
人热血澎湃。几根红木大柱在各个角落里撑起圆型的拱顶，四周挂着许多各式各
样的旗子，仔细看上去，除了间杂着一些印有“笑傲江湖”字样的大旗子外，都
是各个门派放置于此，以鼓励本门比武弟子力争第一的。
LONG);
  set("not_startroom", 1);
  setup();
}

void init() {
  add_action("do_accept", "accept");
}

int do_accept(string arg) {
  tell_object(this_player(), "你想接受什么啊？\n");
  return 1;
}
