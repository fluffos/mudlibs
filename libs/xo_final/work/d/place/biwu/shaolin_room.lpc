#include <biwu.h>
#include "kantai.h"

void create()
{
    set("short","少林厅");
    set("long",@LONG
这里是少林弟子观看比武大会的地方。整个大厅整洁肃穆，许多黄布绸幡从
天花板上直垂而下。地上一溜摆着数十个蒲团，供弟子们围坐。虽说少林从不参
与俗世的江湖纷争，但是比武大会这样的武林盛会是多年难得一次的，所以也有
众多的少林好手来此与各路英雄切磋技艺，或是前来观摩其它门派的功夫。
LONG);
    set("not_startroom",1);
    setup();
}
    
