// file: /d/place/biwu/restroom.c
// attrib: room
// name:  休息室
// write: xli
// date:  1999.6.24
// last modify:xli 1999.6.24
inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "休息室");
  set("long", @LONG
这是一间休息室，为来报名参加笑傲江湖比武大赛的人提供一个暂时休憩的
地方。许多紫红木凳散开摆放在室内，几张茶几上放置着许多茶壶和茶杯，众多
种类的茶飘出各种茶香，在室内徐徐萦绕。笑傲江湖的比武大赛报名处就在休息
室的里间。隐约可以看见一位小姐正在笑脸盈盈地接待来参加大赛的人员。
LONG);
  set("exits", ([
    "enter": __DIR__ "baoming_chu",
  ]));
  set("no_fight", 1);
  set("not_startroom", 1);
  setup();
}

void init() {
  add_action("do_back", "back");
}

int do_back(string arg) {
  string DestRoom;
  object me = this_player();

  DestRoom = me->query("startroom");
  message_vision("$N向大家挥了挥手，急速离开了。\n", me);
  me->move(DestRoom);
  return 1;
}
