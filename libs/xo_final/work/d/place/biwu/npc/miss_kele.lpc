// file: miss_kele.c
// attrib: NPC
// name:  可乐小姐
// usage: 笑傲江湖比武大会负责参赛者接待工作的小姐 :)
// write: xli
// date: 1999.6

inherit NPC;
#include <ansi.h>
#include <biwu.h>

void create()
{
    set_name(HIG"可乐"NOR,({"kele"}));
    set("long",@LONG
一位仪表端庄，言谈举止得体大方的美眉。
正在忙而不乱地接待着各方来参加比武大会的英雄。
LONG);
    set("title",HIY"笑傲江湖"NOR+BIWU_TITLE+HIM"接待美眉"NOR);
    set("gender","女性");
    set("age",18);
    set("per",30);
    set("attitude","friendly");
    setup();
    carry_object(CLONE_DIR"wear/cloth/nenlv_choushan")->wear();
    carry_object(CLONE_DIR"wear/boots/zihua_xie")->wear();
    carry_object(CLONE_DIR"wear/head/hong_m")->wear();
}

int accept_object(object me,object obj)
{
    int myAge,myFee;
    int thisValue;

    myAge=me->query("age");

    thisValue=obj->value();

    command("smile "+me->query("id"));
    if(me->query("xli_marks/have_baoming")) //已经报过名了
    {
        command("tell "+me->query("id")+
        "你已经报名参加"+BIWU_TITLE+"了！\n");
        return notify_fail("\n");
    }
    if(myAge<=20)
    {
        command("tell "+me->query("id")+
      " 你现在还不够二十岁，就不要参加"+BIWU_TITLE+"了吧！");
        return notify_fail("\n");
    }
    if(myAge<=35)
        myFee=2000;
    if(myAge>35 && myAge<=50)
        myFee=4000;
    if(myAge>50)
        myFee=8000;
    if(thisValue<myFee)
    {
        command("tell "+me->query("id")+" 你交纳的报名费不足，
请交纳足够的参赛费以进入我们的"+BIWU_TITLE+"。");
        return notify_fail("\n");
    }
    me->set("xli_marks/can_huaya",1); // 交了钱，可以画押了
    command("tell "+me->query("id")+" 欢迎参加笑傲江湖"+BIWU_TITLE+"！");
    command("tell "+me->query("id")+
" 你已经交纳了足够的参赛费用，请使用ＨＵＡＹＡ指令进行登记。");
    
    return 1;
}
