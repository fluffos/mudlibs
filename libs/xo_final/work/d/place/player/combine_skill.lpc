//  标准的玩家自创技能  //
//**********************//

#include <ansi.h>
#include <dbase.h>

inherit F_DBASE;
inherit F_SAVE;

void create() {
  seteuid(ROOT_UID);
  set("virtual", 1);
}

int valid_learn(object me) {
  return 0;
}

void set_owner(object me) {
  set("owner_id", me->query("id"));
}

void set_owner_id(string owner_id) {
  set("owner_id", owner_id);
}

void set_id(string skill_id) {
  set("skill_id", skill_id);
}

void set_name(string skill_name) {
  set("skill_name", skill_name);
}

void set_dengji(int dengji) {
  set("dengji", dengji);
}

void set_all_action(mapping *all_action) {
  set("actions", all_action);
}

void set_all_parry_msg(string *all_action) {
  return set("parry_msg", all_action);
}

void set_all_dodge_msg(string *all_action) {
  return set("dodge_msg", all_action);
}

void set_all_unarmed_msg(string *all_action) {
  return set("unarmed_msg", all_action);
}

string skill_id() {
  return query("skill_id");
}

string skill_name() {
  return query("skill_name");
}

int query_dengji() {
  return query("dengji");
}

mapping *get_all_action() {
  return query("actions");
}

string *get_all_parry_msg() {
  return query("parry_msg");
}

string *get_all_dodge_msg() {
  return query("dodge_msg");
}

string *get_all_unarmed_msg() {
  return query("unarmed_msg");
}

string query_save_file() {
  string owner_id;
  string skill_id;

  if (!stringp(owner_id = query("owner_id"))) {
    return 0;
  }

  if (!stringp(skill_id = query("skill_id"))) {
    return 0;
  }

  return DATA_DIR + "skill/" + owner_id[0..0] + "/" + owner_id + "/" + skill_id;
}
