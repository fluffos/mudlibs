#include <ansi.h>

inherit SKILL_UNARMED;
inherit "/d/place/player/combine_skill";

/* Two inherits define create, get_all_action, get_all_parry_msg, get_all_unarmed_msg, query_dengji, skill_id, valid_learn(); the later one was already in effect: name it. */
void create() { combine_skill::create(); }
mapping * get_all_action() { return combine_skill::get_all_action(); }
string * get_all_parry_msg() { return combine_skill::get_all_parry_msg(); }
string * get_all_unarmed_msg() { return combine_skill::get_all_unarmed_msg(); }
int query_dengji() { return combine_skill::query_dengji(); }
string skill_id() { return combine_skill::skill_id(); }
int valid_learn(object me) { return combine_skill::valid_learn(me); }
