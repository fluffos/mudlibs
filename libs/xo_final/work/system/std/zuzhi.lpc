//  zuzhi.c in /system/std
inherit F_CLEAN_UP;
inherit F_SAVE;
inherit F_DBASE;

void create() {
  seteuid(getuid());
  restore();
}

string query_save_file() {
  return DATA_DIR + "zuzhi/" + this_object()->QueryId();
}

int FireMember(object who) {
  set("member/" + who->query("id") + "/leavetime", time());
  add("number_to_join", -1);
  delete("all_member/" + who->query("id"));
  save();
  return 0;
}

void RecruitMember(object who, string touxian, string zhiwu, int entertime) {
  set("member/" + who->query("id") + "/entertime", time());
  add("number_to_join", 1);
  set("all_member/" + who->query("id"), who->name());
  save();
  return;
}
