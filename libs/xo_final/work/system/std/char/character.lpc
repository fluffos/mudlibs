{
    return KUNGFU_D->query_potential_limit(this_object());
}

////////////////////////////////////////////////////////////////////
// Lian interface

int is_lianing()
{
    return lianing;
}

void start_lian(string skill)
{
    zhao_index = 0;
    lianing = 1;
    lian_skill = skill;
    start_busy((: is_lianing:));
}

void stop_lian()
{
    lianing = 0;
    if (is_busy())
    {
        this_object()->interrupt_me();
    }
}

void do_lian()
{
    KUNGFU_D->check_lian(this_object());
}

// set_force ( force, max_force, force_factor )
// nerd 98-10-02
varargs int set_force(int force, int max_force, int factor)
{
    set("force", force);
    set("max_force", max_force);
    set("force_factor", factor);
}

mixed is_input()
{
    return in_input();
}

mixed is_inedit()
{
    return in_edit();
}

// -- overrides ------------
string set_short_desc(string desc)
{
    return short_desc = desc;
}

string query_short_desc()
{
    return short_desc;
}

string short (int raw)
{
    string str = name::short (raw);
    return CHAR_D->query_short(this_object(), str, raw);
}

int skill_death_penalty()
{
    if (userp(this_object()))
    {
        skill::skill_death_penalty();
        art::skill_death_penalty();
    }
    return 1;
}

int is_container() { return 1; }
int is_living() { return 1; } // 1 for test first. hehe

void powerup()
{
    CHAR_D->powerup(this_object());
}

int can_improve_neili()
{
    if ( query("max_force") < query_max_force() )
    {
        return 1;
    }

    return 0;
}

int improve_neili(int neili)
{
    if ( query("max_force") + neili > query_max_force() )
    {
        neili = query_max_force() - query("max_force");
    }

    addn("max_force", neili);
    return neili;
}

