////////////////////////////////////////////////////////////////////

void create()
{
    // so LOGIN_D can export uid to us
    seteuid(0);

    lianing = 0;
}

// Use this function to identify if an object is a character.
int is_character()
{
    return 1;
}

// setup: used to configure attributes that aren't known by this_object()
// at create() time such as living_name (and so can't be done in create()).
void setup()
{
    //parse_init();
    seteuid(getuid(this_object()));

    set_heart_beat(1);
    tick = 5 + random(10);
    enable_player();

    CHAR_D->setup_char(this_object());
}

void heart_beat()
{
    int wimpy_ratio, cnd_flag;
    mapping my;
    object ob, this;

    my = query_entire_dbase();
    this = this_object();

    // If we are dying because of mortal wounds?
    if ( my["eff_kee"] < 0 || my["eff_sen"] < 0 || my["eff_gin"] < 0 )
    {
        remove_all_enemy();
        die();
        return;
    }

    // If we're dying or falling unconcious?
    if ( my["kee"] < 0 || my["sen"] < 0 || my["gin"] < 0 )
    {
        remove_all_enemy();

        if ( !living(this) )
        {
            die();
        }
        else
        {
            unconcious();
        }

        return;
    }

    KUNGFU_D->check_force(this);

    // Do attack if we are fighting.
    if ( is_busy() )
    {
        continue_action();

        // lian 应该在忙状态
        KUNGFU_D->check_lian(this);

        // We don't want heart beat be halt eventually, so return here.
        return;
    }
    else if( living(this) )
    {
        // Is it time to flee?
        wimpy_ratio = (int) query("env/wimpy");
        if ( is_fighting() && intp(wimpy_ratio) && wimpy_ratio > 0 &&
            (query_char_ratio("kee") <= wimpy_ratio ||
             query_char_ratio("sen") <= wimpy_ratio ||
             query_char_ratio("gin") <= wimpy_ratio) )
        {
            GO_CMD->do_flee(this);
        }

        // Do attack or clean up enemy if we have fleed.
        attack();
    }

    CHAR_D->heart_beat_hook(this);

    if ( tick-- )
    {
        return;
    }

    tick = 5 + random(10);

    cnd_flag = update_condition();

    // If we are compeletely in peace, turn off heart beat.
    // heal_up() must be called prior to other two to make sure it is called
    // because the && operator is lazy :P
    if ( ((cnd_flag & CND_NO_HEAL_UP) || !heal_up()) &&
        !is_fighting() && !interactive(this) )
    {
        if (environment())
        {
            ob = first_inventory(environment());
            while ( ob && !interactive(ob) )
            {
                ob = next_inventory(ob);
            }
        }

        if ( !ob )
        {
            set_heart_beat(0);
        }
    }

    // NPC 就不老？真是不可思意
    if ( !interactive(this) )
    {
        return;
    }

    // Make us a bit older. Only player's update_age is defined.
    // Note: update_age() is no need to be called every heart_beat, it
    //       remember how much time has passed since last call.
    // this_object()->update_age();
    // moved to user.c -- nerd

}

int visible(object ob)
{
    return 1;
}

int query_char_ratio(string type)
{
    if (type != "gin" && type != "kee" && type != "sen")
        error("STD_CHAR: 种类只能是 gin, kee, sen 其中之一。\n");

    if ( 0 < query("max_" + type) )
    {
        return query(type) * 100 / query("max_" + type);
    }

    return 0;
}

int query_char_eff_ratio(string type)
{
    if (type != "gin" && type != "kee" && type != "sen")
        error("STD_CHAR: 种类只能是 gin, kee, sen 其中之一。\n");
    if ( 0 < query("eff_" + type) )
    {
        return query(type) * 100 / query("eff_" + type);
        }
        
        return 0;
}

int query_lingwu_ratio(string skill)
{
    return KUNGFU_D->query_lingwu_ratio(this_object(), skill);
}

int query_jilei_ratio(string skill)
{
    return KUNGFU_D->query_jilei_ratio(this_object(), skill);
}

