inherit NPC;
inherit F_SAVE;
inherit F_AUTOSAVE;

string ask_wugong();

void setup()
{
    set("new_master", 1);
    set("can_improve", 1);

    NPC_D->reset_xiuwei(this_object());

    delete("kee");
    delete("sen");
    delete("gin");
    delete("eff_kee");
    delete("eff_sen");
    delete("eff_gin");
    delete("max_kee");
    delete("max_sen");
    delete("max_gin");

    delete("qi");
    delete("shen");
    delete("jing");
    delete("eff_qi");
    delete("eff_shen");
    delete("eff_jing");
    delete("max_qi");
    delete("max_shen");
    delete("max_jing");

    delete("jingli");
    delete("eff_jingli");
    delete("max_jingli");

    delete("neili");
    delete("max_neili");
    delete("force");
    delete("max_force");
    delete("force_factor");
    delete("jiali");

    ::create();
    ::setup();

    restore();

    if ( !query("no_public") )
    {
        if ( mapp(query("inquiry")) )
        {
            add("inquiry", ([
                "切磋武功" : (: ask_wugong :),
            ]));
        }
        else
        {
            set("inquiry", ([
                "切磋武功" : (: ask_wugong :),
            ]));
        }
    }
}

void init()
{
    ::init();

    if ( this_object()->query("no_quest") )
    {
        return;
    }

    add_action("do_agree", "agree");
    add_action("do_quest", "quest");
    add_action("do_done", "done");
    add_action("do_cancel", "cancel");
    add_action("do_drop", "drop");
}

void reset()
{
    NPC_D->reset_xiuwei(this_object());
/*
    string * xiuwei_type = KUNGFU_D->all_xiuwei_type();
    int i, count;

    count = sizeof(xiuwei_type);

    for ( i = 0; i < count; i++ )
    {
        if ( 0 == query_xiuwei_by_type(xiuwei_type[i]) )
        {
            set_xiuwei_by_type(xiuwei_type[i], 0);
            continue;
        }

        set_xiuwei_level_by_type(xiuwei_type[i], query_xiuwei_jibie(xiuwei_type[i]));
    }
*/
}

nomask string ask_wugong()
{
    return QINGJIAO_D->ask_wugong(this_player(), this_object());
}

nomask int do_agree(string arg)
{
    return QINGJIAO_D->do_agree(this_player(), this_object(), arg);
}

int accept_apprentice(object me)
{
    return APPRENTICE_D->accept_apprentice(me, this_object());
}

int accept_teach(object me, string skill)
{
    return QINGJIAO_D->accept_teach(me, this_object(), skill);
}

int zhongcheng( object me, string skill )
{
    return QINGJIAO_D->zhongcheng(me, this_object(), skill);
}

nomask int do_quest(string arg)
{
    return QUEST_D->do_quest(this_player(), this_object(), arg);
}

nomask int do_done(string arg)
{
    return QUEST_D->do_done(this_player(), this_object(), arg);
}    

nomask int do_cancel(string arg)
{
    return QUEST_D->do_cancel(this_player(), this_object(), arg);
}

nomask int do_drop(string arg)
{
    return QUEST_D->do_drop(this_player(), this_object(), arg);
}

string query_save_file()
{
    return DATA_DIR + "npc" + base_name(this_object());
}

void heart_beat()
{
    ::heart_beat();

    NPC_D->master_heart_beat(this_object());
}

