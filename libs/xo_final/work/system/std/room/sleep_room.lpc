#include <ansi.h>
#include <room.h>

inherit ROOM;

void create()
{
    if ( !query("short") )
    {
        set("short", "睡房");
    }

    if ( !query("long") )
    {
        set("long", @LONG
这里可以睡觉。
LONG
        );
    }

    set("no_fight", 1);
    set("sleep_room", "inn");

    setup();
}

void init()
{
    object me = this_player();
    string exit_room = this_object()->query("exit_room");
    object obj;
    string room_gender = this_object()->query("gender");
    string room_family, my_family;

    if ( wizardp(me) )
    {
        add_action("do_sleep", "sleep");
        return;
    }

    room_family = this_object()->query("family");
    my_family = me->query("family/family_name");
    if ( !my_family )
    {
        my_family = me->query("zuzhi/zuzhi_name");
    }

    if ( ("inn" != this_object()->query("sleep_room") && room_family && my_family && room_family != my_family)
        || (room_gender && me->query("gender") != room_gender) )
    {
        write( "你跑到" + room_gender + "弟子睡房做什么？这里可不是你来的地方...\n" );
        if ( exit_room && ( (obj = find_object(exit_room)) || (obj = load_object(exit_room)) ) )
        {
            me->move(obj, 1);
        }
        else
        {
            me->move(VOID_OB, 1);
        }
        return;
    }

    add_action("do_sleep", "sleep");
}

int do_sleep()
{
    object me = this_player();

    if ( !me->can_act() )
    {
        tell_object( me, "你正忙着呢。\n");
        return 1;
    }

    if ( this_object()->forbid_sleep(me) )
    {
        tell_object( me, "这里不是让你睡的地方。\n");
        return 1;
    }

    return 0;
}

