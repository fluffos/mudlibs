#pragma save_binary
#include <ansi.h>
#include <dbase.h>
#include <room.h>

inherit F_DBASE;
inherit F_CLEAN_UP;

int query_max_encumbrance()
{
    return 100000000000;
}

object make_inventory( string file )
{
    object ob;
    string err;

    err = catch( ob = new( file ) );
    if ( err || !objectp( ob ) )
    {
        write( "创建房间中的物体失败，请报告巫师。（见room_log）\n" );
        log_file( ROOM_LOG,sprintf( "无法在房间%s中载入%s，错误是：%s\n",
            base_name(this_object()),file, err ) );
        return 0;
    }
    // Support for uniqueness
    // 我觉得这个应该用sefun重载new()，以便对每一个物件检查:)
    if( ob->is_unique() && UNIQUE_D->had_cloned( ob ) )
    {   
        destruct( ob );
        return 0;
    }
    if( ob->violate_unique() )
        ob = ob->create_replica();
    if( !ob )
        return 0;

    ob->move( this_object() );
    ob->set( "startroom", base_name( this_object() ) );
    /*if( ob->is_character() )
    ob->SetTitle();*/
    return ob;
}

void reset()
{
    mapping ob_list, ob;
    //string *list;
    //int i, j;//, num;
    //object temp_ob;

    //
    // Check loaded objects to match the objects specified in "objects"
    // while query("objects") is
    // ([ <object filename>: <amount>, ..... ])
    // and query_temp("objects") is
    // ([ <object filename>: ({ob1, ob2, ...}), .... ])
    //
    delete_all_temp_marks();
    set( "no_clean_up", 0 );
    ob_list = query( "objects" );
    if ( !mapp( ob_list ) )
        return;
    ob = query_temp( "objects" );
    if ( !mapp( ob ) )
        ob = allocate_mapping( sizeof( ob_list ) );
    foreach( string item in keys(ob_list) )
    {
        int num = ob_list[ item ];
        int j;
        object temp_ob;

        if ( !item || !stringp(item) )
        {
            continue;
        }

        // Allocate an array if we have multiple same object specified.
        if ( undefinedp( ob[ item ] ) &&
             intp( num ) && num > 1 )
        {
            ob[ item ] = allocate( num );
        }

        if ( num == 1 )
        {
            if ( !ob[ item ] )
                ob[ item ] = make_inventory( item );
            temp_ob = ob[ item ];
            if ( !temp_ob )
                break;
            if ( environment( temp_ob ) != this_object() &&
                temp_ob->is_character() )
            {
                if ( !temp_ob->return_home( this_object() ) )
                    add( "no_clean_up", 1 );
            }
        }
        else
        {
            for ( j = 0; j < num; j++ )
            {
                // If the object is gone, make another one.
                if ( !objectp( ob[ item ][ j ] ) )
                {
                    ob[ item ][ j ] = make_inventory( item );
                    continue;
                }
                temp_ob = ob[ item ][ j ];

                // Try to call the wandering npc come back here.
                if ( environment( temp_ob ) != this_object() &&
                     temp_ob->is_character() )
                {
                    if ( !temp_ob->return_home( this_object() ) )
                    add( "no_clean_up", 1 );
                }
            }
        }
    }
    set_temp( "objects", ob );
}

int valid_leave(object me, string dir)
{
    int me_dodge,you_dodge,me_value,you_value;
    string my_name;
    object *obs;

    if( sizeof(obs = query("guarded/" + dir)) ) 
    {
        my_name = me->name();
        foreach (object guard in obs)
        {
            if ( !guard
                || guard == me              // guard是自己？
                || !present(guard,this_object())    // guard还在么？
                || guard->is_busy()         // guard busy?
                || !living(guard)           // guard昏迷了？
                || !guard->visible(me)          // guard看不见我？
                || ((string)guard->query_temp("pending/guarding") != dir))
                continue;

            // Check move skill.
            you_dodge=guard->query_xiuwei_jibie("dodge");
            you_value=you_dodge+(int)(guard->query_dex()/10);
            me_dodge=me->query_xiuwei_jibie("dodge");
            me_value=me_dodge+(int)(me->query_dex()/10);
            if( (me_value-you_value) < (2-random(1+random(3))) )
            {
                message_vision("$n想要从$N身边经过，但是被$N挡住了。\n", guard, me);
                guard->start_busy(1);
                me->start_busy(1);
                return notify_fail("你无法通过！\n");
            }
            else
            {
                tell_object(guard,my_name+"闪过的阻挡！\n");
                guard->start_busy(1);
            }
        }
    }
    return 1;
}

//add by peacock, idea by qyz
int welcome_visitor( object me )
{
    foreach( object inv in all_inventory( this_object() ) )
    {
        inv->welcome_visitor( me );
    }
    return 1;
}

void setup()
{
    //parse_init();
    seteuid( getuid() );
    reset();
}

int IsRoom()
{
    return 1;
}

int inventory_accessible()
{
    return 1;
}

int inventory_visible()
{
    return 1;
}

varargs string short()
{
    if (stringp(query("apply/short")))
        return query("apply/short");
    
    return query("short");
}

varargs string long()
{
    if (stringp(query("apply/long")))
        return query("apply/long");

    return query("long");
}

