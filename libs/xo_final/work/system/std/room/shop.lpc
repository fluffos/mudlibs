//  标准当铺    /system/std/room/shop.c  
//************************************************************************//
//    每个玩家当的东西，在一年（玩家时间）内可以赎回，价格和当的时候是一样//
//的，都降为value的30%。一年后将不能再赎，当铺将这些东西公开以高价出售。  //
//    因为考虑到不应该在一个当铺里当的东西哪儿都能赎，所以在当铺ROOM中加了//
//个参数set( "dangpu_location", string ) 。 这个参数是必须的，否则就通当通//
//赎了。                                                                  //
//    铁铺如果inherit SMITHSHOP， 则有收购铁器的功能(sell)，按重量收。    //
//************************************************************************//    
// Edit by Lin on March 7,1997                                            //
//************************************************************************//
//    首先加入了购买过期商品的功能，又加入了替换ansi控制字的函数true_     //  
//string（这个函数其实不一定要在这里加的，因为别的地方很可能也要用它，比如//
//questnpc里面）改善了已经有的功能，然后又加入了店铺开关张的时间控制。    //  
//************************************************************************//
// Changed by lala on March 7, 1998 —— 真是很巧啊，整整一年。(lala)     //
//************************************************************************//
// Last modified : 98-09-22 by nerd :) remove one unused variable
//************************************************************************//
// Last modified : 98-10-02 by hydra  更改跟NATURE_D不兼容的地方
// CAN_SHOP()里面判断晚上用NATURE_D->AtNight()代替CheckTime()
//************************************************************************//

#include <ansi.h>

inherit ROOM;
inherit F_FINANCE;

void init()
{
    seteuid( getuid() );
    seteuid( geteuid() );

    add_action( "DoValue",     "value" );   //给物品估价的函数。
    add_action( "DoPawn",      "pawn" );    //典当物品的函数。
    add_action( "DoPawnlist",  "pawnlist" );//查看典当物品的函数。
    add_action( "DoRedeem",    "redeem" );  //赎买典当物品的函数。
    add_action( "DoSell",      "sell" );    //收购物品的函数。
    add_action( "DoList",      "list" );    //列出出售物品的函数。
    add_action( "DoBuy",       "buy" );     //买物品的函数。

    add_action( "DoConvert",   "convert" ); //换钱的函数。
    add_action( "DoSave",      "cun" );     //存钱的函数。
    add_action( "DoLoad",      "qu");       //取钱的函数。
    add_action( "DoCheck",     "check");    //查帐的函数。
}

//**************************************************************************//
//  下面三个函数是标准当铺和标准钱庄所公用的。                              //
//  int Dest()                                                              //
//  int CheckTime()                                                         //
//  int CanShop()                                                           //
//**************************************************************************//

int Dest()                                  //删除延时的函数。
{
    delete_temp( "busy" );
}

