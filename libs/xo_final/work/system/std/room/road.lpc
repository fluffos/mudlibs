inherit ROOM;
#include "room_type.h"

void setup()
{
    mapping obj;
    seteuid( getuid() );
    if( !(this_object()->query("quyu")) )
    {
        if( random(5) == 2 )
        {
            obj = this_object()->query("objects");
            if( !obj  
                || !mapp(obj) )
                obj = ([ MISC_DIR "tree" : random(2) + 1 ]);
            else
                obj[ MISC_DIR "tree" ] =  random(2) + 1 ;
            this_object()->set("objects", obj);
        }
    }
    /*else if( this_object()->query("quyu") == "desert" )
    {
                             * * * * * * * * * * * *
    }                        * 这里本来就其它的语句*
    else                     * 我注掉了.           *
    {                        * * * * * * * * * * * *
    
    }*/

    this_object()->reset();
    this_object()->set("outdoors","map");
    if( random(16) == 1 )
        new( WEAPON_DIR "short/xiaostone" )->move( this_object() );
    if( random(16) == 2 )
        new( WEAPON_DIR "short/stone" )->move( this_object() );
    if( random(16) == 3 )
        new( MISC_DIR "stone" )->move( this_object() );
    if( random(16) == 4 )
        new( MISC_DIR "xiaostone" )->move( this_object() );
    else if( random(10) == 5 )
        new( MISC_DIR "bigstone" )->move( this_object() );
}

int valid_leave(object ppl, string dir)
{
    mapping exit;
    int force,mforce,sen,kee;
    force = ppl->query("force");
    mforce = ppl->query("max_force");
    sen = ppl->query("sen");
    kee = ppl->query("kee");

    if ( !mapp(exit = this_object()->query("exits")) 
        || undefinedp(exit[dir]) )
    {
        if ( query_verb() == "go" )
            return notify_fail("这个方向没有出路。\n");
        else
            return 0;
    }
    if( !userp( ppl ) )
        return ::valid_leave( ppl, dir );
    check_cost(ppl, 2, 2, 1, 1, 1, 1, mforce, force, sen);
    return ::valid_leave( ppl, dir );
}

string query_room_type()
{ 
    return "road";
}
