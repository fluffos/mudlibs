#include <ansi.h>
#include <room.h>

inherit ROOM;

void create() {
  if (!query("short")) {
    set("short", "厨房");
  }

  if (!query("long")) {
    set("long", @LONG
东边是个大灶台，几个厨娘在忙活着。中间是放着一张桌子，摆着几张长条
凳，一些门内弟子正坐在那里填饱肚子。看那饭菜，真不知道那几个弟子是如何
下咽的，不知从哪里找来的厨娘，估计不会是本地人，找到这么几个宝贝也
真是不容易。
LONG
    );
  }

  set("kitchen_room", 1);
  set("no_clean_up", 0);
  set("no_fight", 1);

  setup();
}

void init() {
  add_action("do_zuo", "zuo");
}

int do_zuo() {
  object me = this_player();
  string room_family;
  string my_family, my_zuzhi;
  int flag = 0;

  if (!me->can_act()) {
    return notify_fail("你现在正忙着呢！\n");
  }

  message_vision("$N一屁股坐了下去，大喊一声：上菜！\n", me);

  room_family = this_object()->query("family");
  my_family = me->query("family/family_name");
  my_zuzhi = me->query("zuzhi/zuzhi_name");

  if (room_family && !this_object()->can_zuo(me)) {
    if (!my_family && !my_zuzhi) {
      flag = 1;
    } else if (my_family) {
      if (room_family == my_family) {
        flag = 1;
      }
    } else if (my_zuzhi) {
      if (room_family == my_zuzhi) {
        flag = 1;
      }
    }

    if (0 == flag) {
      message_vision("过了好一会儿，也没人搭理$N，$N讪讪的站了起来。\n", me);
      return 1;
    }
  }

  this_object()->prepare_eat(me);
  message_vision("一个厨娘给$N送上一些吃的，$N开始吃喝起来。\n", me);
  me->start_busy((: call_other, __FILE__, "eating", me, 3 :), "你还没吃饱呢。\n");
  return 1;
}

int eating(object me, int delay) {
  if (!me->query_temp("kitchen/eating")) {
    me->set_temp("kitchen/eating", delay);
  }

  if (1 < me->query_temp("kitchen/eating")) {
    me->set_temp("kitchen/eating", me->query_temp("kitchen/eating") - 1);
    return 1;
  }

  me->delete_temp("kitchen/eating");
  message_vision("$N吃饱喝足，站了起来。\n", me);

  me->set("food", (int)me->max_food_capacity());
  me->set("water", (int)me->max_water_capacity());

  return 0;
}
