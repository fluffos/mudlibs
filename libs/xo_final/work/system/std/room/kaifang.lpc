//这是模拟清华开放实验室中的所有房间都需要inherit的文件
#include <room.h>

inherit ROOM;

void init()
{
    add_action("back", "nvshen");
}

int getback()
{
    this_player()->move("/d/place/newbie/move_cmds");
    return 1;
}

int back()
{
    tell_object(this_player(), "    你刚呼唤完女神的名字，就看见女神脚蹋七彩云霞飘然而来。她对你招了招\n"+
				"手，你便凌空而起，落到了云霞之上。当云霞散去，你也缓缓落地。\n");
    remove_call_out("getback");
    call_out("getback", 2);
    return 1;
}

