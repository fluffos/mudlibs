// BUG: 可能不太好用,因为inherit COMBINED_ITEM和WEAPON时,
// 会产生nomask冲突的错误.
#include <weapon.h>

//inherit COMBINED_ITEM;
inherit WEAPON;

varargs void init_throwing(int damage, int wound, int flag)
{
    init_weapon( damage, wound, flag | POINTED );
    set_weapon_type("throwing");
}

void setup()
{
	::setup();
	seteuid( getuid() );

	if ( clonep(this_object()) ) return;

	set( "skill_type", "throwing" );
	set( "verbs", ({ "throw" }) );
}
