#include <weapon.h>

inherit WEAPON;

varargs void init_club(int damage, int wound, int flag) {
  if (clonep(this_object())) return;

  init_weapon(damage, wound, (int)flag | LONG | SECONDARY);
  //    set("flag", 1 );
  set("skill_type", "club");
  set_weapon_type("club");
  set("xiuwei_type", "long");
  set("rigidity", (int)(damage / 5));
  if (!query("actions")) {
    set("actions", (: call_other, WEAPON_D, "query_action" :));
    set("verbs", ({ "bash", "crush", "slam" }));
  }
}
