// filename : long_blade.c

#include <weapon.h>

inherit WEAPON;

varargs void init_long_blade(int damage, int wound, int flag) {
  init_weapon(damage, wound, flag | POINTED);
  set_weapon_type("long_blade");
  set("skill_type", "blade");
  set("xiuwei_type", "blade");
  set("verbs", ({ "thrust", "slash", "slice", "hack" }));
}
