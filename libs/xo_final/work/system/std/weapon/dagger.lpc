// dagger.c

#include <weapon.h>

inherit WEAPON;

varargs void init_dagger(int damage, int wound, int flag) {
  init_weapon(damage, wound, flag | EDGED | SECONDARY);
  set("skill_type", "dagger");
  set_weapon_type("dagger");
  set("xiuwei_type", "short");
  set("verbs", ({ "slice", "pierce", "thrust" }));
}
