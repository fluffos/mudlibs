// staff.c

#include <weapon.h>

inherit WEAPON;

varargs void init_staff(int damage, int wound, int flag) {
  init_weapon(damage, wound, flag | LONG | TWO_HANDED);
  set_weapon_type("staff");
  set("skill_type", "staff");
  set("xiuwei_type", "long");
  //staff包括月牙铲，黄金杵。。。。。。
  set("verbs", ({ "bash", "crush", "slam" }));
}
