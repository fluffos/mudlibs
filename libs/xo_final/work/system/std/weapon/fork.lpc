// filename : /std/weapon/fork.c

#include <weapon.h>

inherit WEAPON;

varargs void init_fork(int damage, int wound, int flag)
{
    init_weapon( damage, wound, flag | POINTED );
    set_weapon_type( "fork" );
    set( "skill_type", "fork" );
    set( "xiuwei_type", "long");
    set( "verbs", ({ "thrust" }) );
}

