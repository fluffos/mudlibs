// filename : /std/weapon/qiang.c

#include <weapon.h>

inherit WEAPON;

varargs void init_qiang(int damage, int wound, int flag) {
  init_weapon(damage, wound, flag | POINTED);
  set_weapon_type("spear");
  set("skill_type", "spear");
  set("xiuwei_type", "long");
  set("verbs", ({ "thrust" }));
}
