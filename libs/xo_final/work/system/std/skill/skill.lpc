//	filename : /std/skill.c
//
// 	This is the standard skill daemon object. All objects defining a skill
//	should inherit this as its skeleton.

inherit F_CLEAN_UP;

nosave string my_id;
nosave string my_name;

void create()
{
	seteuid( getuid() );

    my_id = KUNGFU_D->get_skill_id(this_object());
    my_name = KUNGFU_D->get_skill_name(my_id);
}

string chinese_name()
{
    return my_name;
}

string skill_id()
{
    return my_id;
}

//
// valid_learn()
//
// This function is to check if a character should be able to 
// learn/study/practice the skill. The default function just
// returns 1 to allow any characters improve the skill. However,
// a good skill should has its own feature and restriction. Redefine
// this function in your skill object and make it reasonable 
// according to the power of the skill.

int valid_learn( object me )
{
	return KUNGFU_D->valid_learn(me, this_object());
}

int valid_lian( object me )
{
	return KUNGFU_D->valid_lian(me, this_object());
}

// 
// type()
//
// This function should return the type of the skill. The skill type now
// affects if the skill requires combat exp in order to be learned (see
// /cmds/std/learn.c ) and the ranking of a skill level (see 
// /cmds/usr/skills.c )。
// Currently we have only 2 types of skill: "martial" and "knowledge".

string type()
{
	return "martial";
}

// 缺省情况下, 这门武功的 parry power 等于其 attack power
int query_parry_ratio()
{
	return KUNGFU_D->query_parry_ratio(this_object());
}

int query_youxiao_jibie()
{
	return KUNGFU_D->query_youxiao_jibie(this_object());
}

int query_dengji()
{
    return KUNGFU_D->query_dengji(this_object());
}

int query_level()
{
    return query_dengji();
}

//
// skill_improved()
//
// This function is called when a character's skill has gained a new level.
// You can make some modify to a character according to the skill.
void skill_improved(object me)
{
    KUNGFU_D->skill_improved(me, this_object());
}

mapping *get_all_action()
{
    return KUNGFU_D->get_all_action(this_object());
}

string *get_all_parry_msg()
{
    return KUNGFU_D->get_all_parry_msg(this_object());
}

string *get_all_unarmed_msg()
{
    return KUNGFU_D->get_all_unarmed_msg(this_object());
}

mapping query_action(int jibie)
{
    return KUNGFU_D->query_action(this_object(), jibie);
}

string query_zhaoshi( int jibie )
{
    return KUNGFU_D->query_zhaoshi(this_object(), jibie);
}

string query_parry_msg(object weapon)
{
    return KUNGFU_D->query_parry_msg(this_object(), weapon);
}

// exert_action()
//
//     This function is used by the "exert" command as specific skill's 
// command parser. This function parses the arguments in the standard form
// (that is, exert <function> [<arg>]).
//     In order to use this default exert command parser, you must define
// a function called exert_action_file(string func) in the skill object
// that takes the function name as argument and return the file name that
// defines the specified function. 

int perform_action(object me, string action)
{
    return KUNGFU_D->perform_action(this_object(), me, action);
}

string perform_action_file(string action)
{
    return KUNGFU_D->perform_action_file(this_object(), action);
}

