// filename : /std/force.c

inherit SKILL;

// add this by tea 10.15.98
int exert_function(object me, string arg)
{
    return KUNGFU_D->exert_function(this_object(), me, arg);
}

mixed hit_ob(object me, object victim, int damage_bonus, int factor)
{
    return KUNGFU_D->hit_ob(this_object(), me, victim, damage_bonus, factor);
}

string query_xiuwei_type()
{
    return "force";
}

int valid_xiulian( object me )
{
    return KUNGFU_D->valid_xiulian(me, this_object());
}

string exert_function_file(string func)
{
    return KUNGFU_D->exert_function_file(this_object(), func);
}

int perform_action(object me, string action)
{
    return notify_fail("内功只能exert。\n");
}

