inherit SKILL_SHORT;

string* suanpans = ({ "tie suanpan", "jin suanpan", "suanpan", "abacus" });

mapping *get_all_action()
{
    return ({
    ([    "action":"$N手中$w平推而出",
        "lian"  :"$N手中$w平推而出",
        "jibie" :10,
        "sen"   :4,
        "dodge" :20,     
        "parry" :0,
        "damage":20,
        "wound" :5,
        "damage_type":"瘀伤"   ]),
    ([    "action":"$N手中$w向上一举，顺势向下砸下",
        "lian"  :"$N手中$w向上一举，顺势向下砸下",
        "jibie" :10,
        "sen"   :4,
        "dodge" :20,     
        "parry" :0,
        "damage":20,
        "wound" :5,
        "damage_type":"瘀伤"   ]),        
});
}

string query_weapon_type()
{
    return "plate";
}

int valid_lian( object me )
{
    object weapon;

    weapon = me->query_temp( "weapon" );    
    if ( !weapon || member_array( weapon->query( "id" ) , suanpans ) == -1 )
    {
        return notify_fail("你必须先找一块算盘才能练。\n");
    }

    return ::valid_lian(me);
}

int valid_learn(object me)
{   
    if ( me->query_jibie("literate") < 100 )
    {
        return notify_fail("你的文化太低，无法练这门武功。\n");
    }

    return ::valid_learn(me);
}

