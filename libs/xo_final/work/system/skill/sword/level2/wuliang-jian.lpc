inherit SKILL_SWORD;

mapping *get_all_action()
{
    return ({
        ([	"action":"$N一招「白虹贯日」，手中$w舞的密不透风，罩向$n全身",
            "lian"  :"$N把手中$w舞的密不透风，正是一招「白虹贯日」",
            "sen"   :3,
            "jibie" :5,
            "dodge" :10,
            "parry" :10,
            "wound":10,
            "zhaoshi" : "「白虹贯日」",
            "damage_type":"刺伤"   ]),
        ([  "action":"未待招式使老，$N又一招「无边落木」，$w化作数道剑气，向$n急刺过去",
            "lian"  :"$N一招「无边落木」，手中$w化为数道剑气",
            "sen"   :3,
            "jibie" :10,
            "dodge" :15,
            "parry" :5,
            "wound":15,
            "zhaoshi" : "「无边落木」",
            "damage_type":"刺伤"    ]),
        ([  "action":"紧跟着$N揉身而上，一招「苍松迎客」，击向$n的$l",
            "lian"  :"$N手握$w，使出一招「苍松迎客」，身形极为优美",
            "sen"   :2,
            "jibie" :18,
            "dodge" :20,
            "parry" :0,
            "wound":20,
            "zhaoshi" : "「苍松迎客」",
            "damage_type":"割伤" ]),
        ([  "action":"$N脚走阴阳，手捏剑诀，一招「古柏森森」手中$w缓缓刺出",
            "lian"  :"$N脚走阴阳，手捏剑诀，一招「古柏森森」手中$w缓缓刺出",
            "sen"   :2,
            "jibie" :25,
            "dodge" :0,
            "parry" :15,
            "wound":22,
            "zhaoshi" : "「古柏森森」",
            "damage_type":"刺伤"    ]),
        ([  "action":"只听$N大喝一声，反手一招「青山隐隐」，手中$w舞作一团青光，扫向$n的$l",
            "lian"  :"$N反手一招「青山隐隐」，手中$w舞作一团青光",
            "sen"   :5,
            "jibie" :32,
            "dodge" :0,
            "parry" :15,
            "wound":30,
            "zhaoshi" : "「青山隐隐」",
            "damage_type":"割伤"    ]),
        ([  "action":"$N左手捏了个剑诀，一招「金雁横空」，右手$w自左而右横扫而过",
            "lian"  :"$N左手捏了个剑诀，一招「金雁横空」，右手$w自左而右横扫而过",
            "sen"   :4,
            "jibie" :40,
            "dodge" :5,
            "parry" :20,
            "wound":28,
            "zhaoshi" : "「金雁横空」",
            "damage_type":"割伤"    ]),
        ([  "action":"又见$N高高跃起，一式「腾蛟起凤」，向$n$l一劈",
            "lian"  :"$N身形乍展，高高跃起，一式「腾蛟起凤」$w凌空一劈",
            "sen"   :5,
            "jibie" :50,
            "dodge" :5,
            "parry" :15,
            "wound":40,
            "zhaoshi" : "「腾蛟起凤」",
            "damage_type":"刺伤"    ]),
        ([  "action": "$N手中$w有意无意地顺手一击，刺向$n的$l",
            "lian"  : "$N手中$w有意无意地顺手一击刺出",
            "sen"   :3,
            "jibie" :60,
            "dodge" :10,
            "damage":25,
            "wound":30,
            "damage_type" : "刺伤"  ]),
        ([  "action": "$N手持$w，对着$n的$l胡点乱刺",
            "lian" : "$N手持$w，对着半空乱点乱刺，看似随心所欲",
            "sen"   :3,
            "jibie" :70,
            "dodge" :10,
            "parry" :15,
            "damage":45,
            "wound":35,
            "damage_type" : "刺伤"  ]),
        ([  "action": "$N后退一步，手中$w却化出点点青光，围住了$n",
            "lian"  : "$N后退一步，手中$w却化出点点青光",
            "sen"   :5,
            "jibie" :80,
            "dodge" :10,
            "parry" :20,
            "damage":65,
            "wound":30,
            "damage_type" : "割伤"  ]),    
    });
}

