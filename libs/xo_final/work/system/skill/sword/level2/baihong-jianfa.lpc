inherit SKILL_SWORD;

mapping *get_all_action()
{
    return ({
        ([	"action":"$N左手握拳，右手剑走轻灵，一招「白虹一现」，$w化成一道光芒，射向$n的$l",
            "lian"  :"$N左手握拳，右手剑走轻灵，一招「白虹一现」，$w化成一道光芒射出",
            "sen"   :3,
            "jibie" :5,
            "dodge" :10,
            "parry" :10,
            "wound":10,
            "zhaoshi" : "「白虹一现」",
            "damage_type":"刺伤"   ]),
        ([  "action":"$N使出一招「鹰起云扬」，身形向上飘起，手中$w猛的劈向$n的$l",
            "lian"  :"$N使出一招「鹰起云扬」，身形向上飘起，手中$w猛的劈下",
            "sen"   :3,
            "jibie" :10,
            "dodge" :15,
            "parry" :5,
            "wound":15,
            "zhaoshi" : "「鹰起云扬」",
            "damage_type":"刺伤"    ]),
        ([  "action":"$N身形一晃，猛然一式「波涛汹涌」，将$w舞得有如波涛，挟着一阵劲风向$n扫去",
            "lian"  :"$N身形一晃，猛然一式「波涛汹涌」，将$w舞得有如波涛，挟着一阵劲风扫去",
            "sen"   :2,
            "jibie" :18,
            "dodge" :20,
            "parry" :0,
            "wound":20,
            "zhaoshi" : "「波涛汹涌」",
            "damage_type":"割伤" ]),
        ([  "action":"$N一身清啸，身行一顿，随即将手中$w舞成一道光环，一招「日月无光」卷起地上的灰尘扫向$n的$l",
            "lian"  :"$N一身清啸，身行一顿，随即将手中$w舞成一道光环，一招「日月无光」卷起地上的灰尘",
            "sen"   :2,
            "jibie" :25,
            "dodge" :0,
            "parry" :15,
            "wound":22,
            "zhaoshi" : "「日月无光」",
            "damage_type":"刺伤"    ]),
        ([	"action":"$N倒转身子，似乎象要逃跑，猛然身行一转，使出一招“回手剑”，剑尖化作几点星光射向$n的$l",
            "lian"  :"$N倒转身子，似乎象要逃跑，猛然身行一转，使出一招“回手剑”，剑尖化作几点星光",
            "sen"   :3,
            "jibie" :35,
            "dodge" :10,
            "parry" :10,
            "wound": 25,
            "damage": 10,
            "zhaoshi" : "「回手剑」",
            "damage_type":"刺伤"   ]),
        ([  "action":"$N向左跨出一步，左手捏着剑决，一招「百流汇海」右手$w化出好几道光芒射向$n的$l",
            "lian"  :"$N向左跨出一步，左手捏着剑决，一招「百流汇海」右手$w化出好几道光芒",
            "sen"   :3,
            "jibie" :40,
            "dodge" :15,
            "parry" :5,
            "wound": 30,
            "damage": 15,
            "zhaoshi" : "「百流汇海」",
            "damage_type":"刺伤"    ]),
        ([  "action":"$N运力纵起丈余，一招「天鹰翱翔」，挥出手中$w，飘然刺向$n的$l",
            "lian"  :"$N运力纵起丈余，一招「天鹰翱翔」，挥出手中$w，飘然刺出",
            "sen"   :2,
            "jibie" :45,
            "dodge" :20,
            "parry" :0,
            "wound": 20,
            "damage": 30,
            "zhaoshi" : "「天鹰翱翔」",
            "damage_type":"割伤" ]),
        ([  "action":"$N右手举$w过顶，身子一摆，一招「冰霜雪雨」，$w化做几点寒星射向$n",
            "lian"  :"$N右手举$w过顶，身子一摆，一招「冰霜雪雨」，$w化做几点寒星",
            "sen"   :2,
            "jibie" :50,
            "dodge" :0,
            "parry" :15,
            "wound":22,
            "damage": 35,
            "zhaoshi" : "「冰霜雪雨」",
            "damage_type":"刺伤"    ]),
        ([  "action":"$N将左手握拳，虚击一招，突然面如寒霜，挥出手中$w刺向$n的$l，好一招「风雪江山」",
            "lian"  :"$N将左手握拳，虚击一招，突然面如寒霜，挥出手中$w，好一招「风雪江山」",
            "sen"   :2,
            "jibie" :60,
            "dodge" :20,
            "parry" :0,
            "wound":30,
            "damage": 40,
            "zhaoshi" : "「风雪江山」",
            "damage_type":"割伤" ]),
        ([  "action":"$N手中$w一指，脸上露出微微的笑容，真气飞速地流遍全身，一招「白虹万道」，$w化成万道光芒雷霆般射向$n的$l",
            "lian"  :"$N手中$w一指，脸上露出微微的笑容，真气飞速地流遍全身，一招「白虹万道」，$w化成万道光芒雷霆般射出",
            "sen"   :2,
            "jibie" :80,
            "dodge" :0,
            "parry" :20,
            "wound": 35,
            "damage": 50,
            "zhaoshi" : "「白虹万道」",
            "damage_type":"刺伤"    ]),
    });
