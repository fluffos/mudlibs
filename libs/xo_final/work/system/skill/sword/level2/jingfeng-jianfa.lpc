inherit SKILL_SWORD;

mapping *get_all_action() {
  return ({
    ([ "action": "$N纵身跃起手中$w轻挥，一招「风平浪静」，斩向$n后颈",
      "lian": "$N纵身跃起手中$w轻挥，一招「风平浪静」",
      "sen": 3,
      "jibie": 5,
      "dodge": 10,
      "parry": 10,
      "wound": 10,
      "zhaoshi": "「风平浪静」",
      "damage_type": "刺伤" ]),
    ([ "action": "$N手中$w连画三个弧形，一招「风起云涌」，向$n的右臂齐肩斩落",
      "lian": "$N手中$w连画三个弧形，一招「风起云涌」",
      "sen": 3,
      "jibie": 10,
      "dodge": 15,
      "parry": 5,
      "wound": 15,
      "zhaoshi": "「风起云涌」",
      "damage_type": "刺伤" ]),
    ([ "action": "$N轻吁一声，飞身一跃而起，一招「风卷残云」，连续向$n刺出数剑",
      "lian": "$N轻吁一声，飞身一跃而起，一招「风卷残云」，连续刺出数剑",
      "sen": 2,
      "jibie": 18,
      "dodge": 20,
      "parry": 0,
      "wound": 20,
      "zhaoshi": "「风卷残云」",
      "damage_type": "割伤" ]),
    ([ "action": "$N仰天一声清啸，斜行向前，一招「风流云散」，$w横削直击，击向$n的$l",
      "lian": "$N仰天一声清啸，斜行向前，一招「风流云散」，$w横削直击",
      "sen": 2,
      "jibie": 25,
      "dodge": 0,
      "parry": 15,
      "wound": 22,
      "zhaoshi": "「风流云散」",
      "damage_type": "刺伤" ]),
  });
}
