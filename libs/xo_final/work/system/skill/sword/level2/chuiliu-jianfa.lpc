inherit SKILL_SWORD;

mapping *get_all_action() {
  return ({
    ([ "action": "$N一招「春风拂柳」，手中$w一转，剑尖抖了两抖，刺向$n$l",
      "lian": "$N一招「春风拂柳」，手中$w一转，剑尖抖了两抖",
      "jibie": 8,
      "zhaoshi": "「春风拂柳」",
      "sen": 2,
      "damage": 30,
      "damage_type": "刺伤" ]),
    ([ "action": "$N一招「新新柳色」，手中$w斜刺而出，腕力抖动，剑尖轻颤",
      "lian": "$N一招「新新柳色」，手中$w斜刺而出，腕力抖动，剑尖轻颤",
      "jibie": 16,
      "zhaoshi": "「新新柳色」",
      "sen": 2,
      "damage": 35,
      "damage_type": "割伤" ]),
    ([ "action": "只见$N一招「柳丝随风」，手中$w拖出一条剑影，转身反刺，犹如柳丝随风",
      "lian": "只见$N一招「柳丝随风」，手中$w拖出一条剑影，转身反刺，犹如柳丝随风",
      "jibie": 24,
      "zhaoshi": "「柳丝随风」",
      "sen": 2,
      "parry": 5,
      "damage": 40,
      "damage_type": "刺伤" ]),
    ([ "action": "又见$N一式「垂柳丝黄」，身子左转，剑身挺出，全身侧成一条直线",
      "lian": "又见$N一式「垂柳丝黄」，身子左转，剑身挺出，全身侧成一条直线",
      "jibie": 32,
      "zhaoshi": "垂柳丝黄",
      "sen": 3,
      "dodge": 10,
      "damage": 45,
      "damage_type": "刺伤" ]),
    ([ "action": "$N身子一侧，一招「柳影婆娑」，剑身一转，划了一个很小的圈子，反腕斜刺而出",
      "lian": "$N身子一侧，一招「柳影婆娑」，剑身一转，划了一个很小的圈子，反腕斜刺而出",
      "jibie": 40,
      "sen": 2,
      "zhaoshi": "「柳影婆娑」",
      "parry": 10,
      "damage": 50,
      "damage_type": "刺伤" ]),
    ([ "action": "$N将$w换至左手，一招「相与谁近」，反手一掌推出",
      "lian": "$N将$w换至左手，一招「相与谁近」，反手一掌推出",
      "jibie": 48,
      "zhaoshi": "「相与谁近」",
      "sen": 2,
      "damage": 55,
      "damage_type": "刺伤" ]),
    ([ "action": "$N提剑踏上一步，剑尖在腕力的驱使下抖动不已，正是一招「乱发齐天」",
      "lian": "$N提剑踏上一步，剑尖在腕力的驱使下抖动不已，正是一招「乱发齐天」",
      "jibie": 56,
      "zhaoshi": "「乱发齐天」",
      "sen": 3,
      "parry": 10,
      "damage": 55,
      "damage_type": "刺伤" ]),
    ([ "action": "$N一招「斜阳疏影」，身形一跃，斜冲向前，右手挥动$w向下直斩向$n$l",
      "lian": "$N一招「斜阳疏影」，身形一跃，斜冲向前，右手挥动$w向下直斩",
      "jibie": 64,
      "zhaoshi": "「斜阳疏影」",
      "sen": 3,
      "parry": 20,
      "damage": 65,
      "damage_type": "刺伤" ]),

  });
}
