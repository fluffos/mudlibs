#include <ansi.h>

inherit SKILL_SWORD;

mapping *get_all_action() {
  return ({
    ([ "action": "$N一声长叹，$w轻点一招" MAG "「醉拍春衫惜旧香」" NOR "向着$n的$l疾刺而去",
      "lian": "$N一声长叹，$w轻点一招" MAG "「醉拍春衫惜旧香」" NOR "疾刺而去",
      "sen": 3,
      "jibie": 5,
      "dodge": 10,
      "parry": 10,
      "wound": 10,
      "zhaoshi": MAG "「醉拍春衫惜旧香」" NOR,
      "damage_type": "刺伤" ]),
    ([ "action": "$N紧缩眉头，心中似有很深的怨气$w一闪而隐，一招" MAG "「天将离恨恼梳狂」" NOR "刺向$n的$l",
      "lian": "$N紧缩眉头，心中似有很深的怨气$w一闪而隐，一招" MAG "「天将离恨恼梳狂」" NOR "刺出",
      "sen": 3,
      "jibie": 10,
      "dodge": 15,
      "parry": 5,
      "wound": 15,
      "zhaoshi": MAG "「天将离恨恼梳狂」" NOR,
      "damage_type": "刺伤" ]),
    ([ "action": "$N仰天不语，脸上掠过一丝忧愁，$w暂缓，一招" HIG "「年年陌上生青草」" NOR "遥遥刺向$n的$l",
      "lian": "$N仰天不语，脸上掠过一丝忧愁，$w暂缓，一招" HIG "「年年陌上生青草」" NOR "遥遥刺出",
      "sen": 2,
      "jibie": 18,
      "dodge": 20,
      "parry": 0,
      "wound": 20,
      "zhaoshi": HIG "「年年陌上生青草」" NOR,
      "damage_type": "割伤" ]),
    ([ "action": "$N怔怔而望，若有所思，忽然变招，蓦然有骤风席卷，剑招凌烈撒向$n的$l，好一招" RED "「日日楼中到夕阳」" NOR,
      "lian": "$N怔怔而望，若有所思，忽然变招，蓦然有骤风席卷，剑招凌烈，好一招" RED "「日日楼中到夕阳」" NOR,
      "sen": 2,
      "jibie": 25,
      "dodge": 0,
      "parry": 15,
      "wound": 22,
      "zhaoshi": RED "「日日楼中到夕阳」" NOR,
      "damage_type": "刺伤" ]),
    ([ "action": "$N衣袂飞舞，身形舒缓如舞，轻歌曼妙，一招" HIC "「云渺渺，水茫茫」" NOR "，$w划向$n的$l",
      "lian": "$N衣袂飞舞，身形舒缓如舞，轻歌曼妙，一招" HIC "「云渺渺，水茫茫」" NOR,
      "sen": 3,
      "jibie": 35,
      "dodge": 10,
      "parry": 10,
      "wound": 25,
      "damage": 10,
      "zhaoshi": HIC "「云渺渺，水茫茫」" NOR,
      "damage_type": "刺伤" ]),
    ([ "action": "$N微闭双目，一股落寞的神情布于脸上，剑意凝重，空气顿时压力大增一招" YEL "「征人归路许多长」" NOR "飞刺$n的$l",
      "lian": "$N微闭双目，一股落寞的神情布于脸上，剑意凝重，空气顿时压力大增一招" YEL "「征人归路许多长」" NOR,
      "sen": 3,
      "jibie": 40,
      "dodge": 15,
      "parry": 5,
      "wound": 30,
      "damage": 15,
      "zhaoshi": YEL "「征人归路许多长」" NOR,
      "damage_type": "刺伤" ]),
    ([ "action": "$N斜倚长剑，轻啸而歌却充满了枯涩的意味，$w自肋下翻刺而出一招" HIM "「相思本是无凭语」" NOR "刺向$n的$l",
      "lian": "$N斜倚长剑，轻啸而歌却充满了枯涩的意味，$w自肋下翻刺而出一招" HIM "「相思本是无凭语」" NOR "刺出",
      "sen": 2,
      "jibie": 45,
      "dodge": 20,
      "parry": 0,
      "wound": 20,
      "damage": 30,
      "zhaoshi": HIM "「相思本是无凭语」" NOR,
      "damage_type": "割伤" ]),
    ([ "action": "$N缓缓摇头，双目中似有泪光闪动$w辉映着苍白的光芒若隐若现的闪现而出，一招" YEL "「莫向花笺费泪行」" NOR + "刺向$n的$l",
      "lian": "$N缓缓摇头，双目中似有泪光闪动$w辉映着苍白的光芒若隐若现的闪现而出，一招" YEL "「莫向花笺费泪行」" NOR + "刺出",
      "sen": 2,
      "jibie": 50,
      "dodge": 0,
      "parry": 15,
      "wound": 22,
      "damage": 35,
      "zhaoshi": YEL "「莫向花笺费泪行」" NOR,
      "damage_type": "刺伤" ]),
  });
}
