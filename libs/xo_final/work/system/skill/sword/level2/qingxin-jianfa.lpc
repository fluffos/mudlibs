inherit SKILL_SWORD;

mapping *get_all_action() {
  return ({
    ([ "action": "$N手中$w“嗖”地递出，突然间半空挽出一个剑花，正是一招「芙蓉花开」\n"
      "不知不觉间，$w已经向$n的$l刺去",
      "lian": "$N手中$w“嗖”地递出，突然间半空挽出一个剑花，正是一招「芙蓉花开」",
      "jibie": 8,
      "zhaoshi": "「芙蓉花开」",
      "sen": 2,
      "damage": 30,
      "damage_type": "刺伤" ]),
    ([ "action": "$N手中$w一抖，发出嗡嗡之声，向$n眼睛刺去，但是$w在半路忽地一转\n"
      "竟向$n$l刺去，正是芙蓉剑法中的「花开花谢」",
      "lian": "$N手中$w一抖，发出嗡嗡之声，向前刺去，但是$w在半路忽地一转，正是芙蓉剑法中的「花开花谢」",
      "jibie": 16,
      "zhaoshi": "「花开花谢」",
      "sen": 2,
      "damage": 35,
      "damage_type": "割伤" ]),
    ([ "action": "$N不理会对方攻势来路，手中$w刷的一剑「泉鸣芙蓉」，向$n$l刺去",
      "lian": "$N手中$w刷的一剑「泉鸣芙蓉」",
      "jibie": 24,
      "zhaoshi": "「泉鸣芙蓉」",
      "sen": 2,
      "parry": 5,
      "damage": 40,
      "damage_type": "刺伤" ]),
    ([ "action": "$N手中$w倏地刺出，剑势穿插迂回，如梦如幻，正是一招「花香四溢」，向\n"
      "$n$l刺去",
      "lian": "$N手中$w倏地刺出，剑势穿插迂回，如梦如幻，正是一招「花香四溢」",
      "jibie": 32,
      "zhaoshi": "「花香四溢」",
      "sen": 3,
      "dodge": 10,
      "damage": 45,
      "damage_type": "刺伤" ]),
    ([ "action": "$N手中$w倏地刺出，极尽诡奇之能事，动向无定，不可捉摸。正是一招\n"
      "「借花献佛」指向$n$l",
      "lian": "$N手中$w倏地刺出，极尽诡奇之能事，动向无定，不可捉摸。正是一招\n"
      "「借花献佛」",
      "jibie": 40,
      "sen": 2,
      "zhaoshi": "「借花献佛」",
      "parry": 10,
      "damage": 50,
      "damage_type": "刺伤" ]),
    ([ "action": "$N飞身跃起，一式「芙蓉出水」$w发出一声龙吟从半空中刺向$n的$l",
      "lian": "$N飞身跃起，一式「芙蓉出水」$w发出一声龙吟从半空中刺下",
      "jibie": 48,
      "zhaoshi": "「芙蓉出水」",
      "sen": 2,
      "damage": 60,
      "damage_type": "刺伤" ]),
  });
}
