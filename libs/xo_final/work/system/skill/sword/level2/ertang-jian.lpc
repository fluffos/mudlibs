inherit SKILL_SWORD;

mapping *get_all_action() {
  return ({
    ([ "action":
      "$N使一式「信道而驰」，手中$w嗡嗡微振，幻成一条白光刺向$n的$l ",
      "lian":
      "$N使一式「信道而驰」，手中$w嗡嗡微振，幻成一条白光直刺出去",
      "zhaoshi": "「信道而驰」",
      "dodge": 5,
      "sen": 2,
      "jibie": 0,
      "parry": 8,
      "force": 10,
      "damage": 10,
      "damage_type": "刺伤",
    ]),
    ([ "action":
      "$N错步上前，使出「百无聊赖」，剑意若有若无，$w淡淡地向$n的$l挥去",
      "lian":
      "$N错步上前，使出「百无聊赖」，剑意若有若无，$w淡淡地向前挥去",
      "zhaoshi": "「百无聊赖」",
      "dodge": 10,
      "parry": 18,
      "force": 20,
      "sen": 1,
      "jibie": 8,
      "damage": 15,
      "damage_type": "刺伤",
    ]),
    ([ "action":
      "$N一式「赤地千里」，纵身飘开数尺，运发剑气，手中$w遥摇指向$n的$l",
      "lian":
      "$N一式「赤地千里」，纵身飘开数尺，运发剑气，手中$w遥摇指出",
      "zhaoshi": "「赤地千里」",
      "dodge": 13,
      "sen": 2,
      "parry": 12,
      "jibie": 15,
      "force": 30,
      "damage": 20,
      "damage_type": "刺伤",
    ]),
    ([ "action":
      "$N纵身轻轻跃起，一式「冰壶秋月」，剑光如水，一泻千里，洒向$n全身",
      "lian":
      "$N纵身轻轻跃起，一式「冰壶秋月」，剑光如水，一泻千里",
      "zhaoshi": "「冰壶秋月」",
      "sen": 3,
      "jibie": 25,
      "dodge": 15,
      "parry": 30,
      "force": 30,
      "damage": 20,
      "damage_type": "刺伤",
    ]),
    ([ "action":
      "$N手中$w中宫直进，一式「独行其是」，无声无息地对准$n的$l刺出一剑",
      "lian":
      "$N手中$w中宫直进，一式「独行其是」，无声无息地刺了出去",
      "zhaoshi": "「独行其是」",
      "dodge": 10,
      "sen": 3,
      "jibie": 34,
      "parry": 8,
      "force": 60,
      "damage": 50,
      "damage_type": "刺伤",
    ]),
    ([ "action":
      "$N左指凌空虚点，右手$w逼出丈许雪亮剑芒，一式「愁云惨淡」刺向$n的咽喉",
      "lian":
      "$N左指凌空虚点，右手$w逼出丈许雪亮剑芒，一式「愁云惨淡」刺了出去",
      "zhaoshi": "「愁云惨淡」",
      "dodge": 10,
      "parry": 9,
      "force": 20,
      "sen": 2,
      "jibie": 45,
      "damage": 30,
      "damage_type": "刺伤",
    ]),
  });
}

int valid_learn(object me) {
  if (me->query_jibie("buddhism") < 60) {
    return notify_fail("你的佛学修为不够，强练绝技会伤及身体。\n");
  }

  return ::valid_learn(me);
}
