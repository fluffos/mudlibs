#include <ansi.h>

inherit SKILL_SWORD;

mapping *get_all_action()
{
    return ({
    ([  "action":
"$N一招"+HIR"「云锁青山」"NOR+"，寒眉冷蹙，左手捏一个剑诀，右手中$w向$n肩部横削过去",
        "lian"  :
"$N一招「云锁青山」，左手捏了一个剑诀，右手$w横削",
// 锁的含义：攻上三路，横削
        "sen"   :3,
        "jibie" :20,
        "zhaoshi":"「云锁青山」",
         "dodge" :40,
        "parry" :40,
        "damage":100,
        "wound":100,
        "damage_type":"割伤"    ]),
    ([  "action":
"$N一招"+HIG"「夏雨蒙蒙」"NOR+"，回身闪步，转身用$w直削$n$l，行动之处快如脱兔",
        "lian"  :
"$N使出一招「夏雨蒙蒙」，只见剑光霍霍，回身反削",
//  夏雨以急骤为特色，回身反削要出敌不意。
        "sen"   :6,
        "jibie" :40,
        "zhaoshi":"「夏雨蒙蒙」",
        "dodge":20,
        "parry":50,
        "damage":120,
        "wound":100,
        "damage_type":"割伤" ]),
    ([  "action":
"$N一招"+HIY"「玉池碧水」"NOR+",作势跃起，姿态有如白鹤亮翅，目不转睛，$w似随凛凛\n"
"秋风忽忽飘动，悠悠向$n$l刺去",
        "lian"  :
"$N作势跃起，姿态有如白鹤亮翅，目不转睛，一招「玉池碧水」，$w似随凛凛\n"
"秋风忽忽飘动",
//  玉池碧水从岸上看，波光粼粼。所以此招用意在于飘忽不定
        "sen"   :5,
        "jibie" :60,
        "zhaoshi":"「玉池碧水」",
                "dodge":70,
        "parry":10,
        "damage":140,
        "wound":110,
        "damage_type":"刺伤"    ]),
    ([  "action":
"$N一招"+HIY"「清风拂面」"NOR+"，右手腕一抖，内力催动，将手中$w舞成一团剑花，带动一片寒气向$n攻去",
        "lian"  :
"$N使出一招「清风拂面」，右手腕一抖，内力催动，将手中$w舞成一团剑花",
// 此招顾名思义，以内力催动剑气。
        "sen"   :5,
        "jibie" :80,
        "zhaoshi":"「清风拂面」",
        "damage":160,
        "wound":120,
        "damage_type":"刺伤"    ]),
	([	"action":
"$N一招"+HIB"「晓露凝颊」"NOR+"，腾身跳步，身子拳旋而起，$w似一分为二，二分为四，一片剑影直袭$n头部",
                "lian" :
"$N一招「晓露凝颊」，腾身跳步，身子拳旋而起，$w似一分为二，二分为四，\n"
"一片剑影向上三路划去",
// 此招“晓露凝颊”，自然是攻向对方的面部，不过limb为面部的话，每次
// 在颊上划两道子，这个好象不太对劲的说。
        "zhaoshi":"「晓露凝颊」",
        "sen" :5,
        "dodge":40,
        "parry":30,
        "jibie":100,
        "damage":180,
        "wound":130,
        "damage_type":"割伤"
	]),
        ([ 
        "action":
"$N一招"+HIC"「娇姿宛然」"NOR+"，足下稍顿，身形一扭，左手捏稳剑诀，右手中$w缓缓平推而出n"
"百忙之中，仍不忘顾盼自如，一姿一势极是好看，宛如剑舞一般",
        "lian":
"$N一招「娇姿宛然」，足下稍顿，身形一扭，左手捏稳剑诀，右手中$w缓缓平\n"
"推而出，一姿一势极是好看",
//  此招用以攻心，仪态万方，不失胜者之象，从气势上压倒对方。
//  99-1-3 14:58 Amber 这叫美人计吧？呵呵 
        "zhaoshi":"「娇姿宛然」",
        "sen":8,
                "dodge":80,
        "parry":70,
        "jibie":120,
        "damage":200,
        "wound":200,
        "damage_type":"刺伤"
	]),
});
}

