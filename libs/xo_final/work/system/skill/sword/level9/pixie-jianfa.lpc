        "dodge":20,
        "parry":50,
        "damage":120,
        "wound":100,
        "damage_type":"割伤" ]),
    ([  "action":
"$N舞动$w，一招「花开见佛」挟著无数剑光刺向$n的$l",
        "lian"  :
"$N舞动$w，一招「花开见佛」挟著无数剑光刺出",
        "sen"   :5,
        "jibie" :60,
        "zhaoshi":"「花开见佛」",
                "dodge":70,
        "parry":10,
        "damage":140,
        "wound":110,
        "damage_type":"刺伤"    ]),
    ([  "action":
"$N手中$w一声清啸，祭出「流星赶月」剑锋闪烁不定，银光飞舞，猛地里一剑挺出，直刺$n$l",
        "lian"  :
"$N手中$w一声清啸，祭出「流星赶月」剑锋闪烁不定，银光飞舞，猛地里一剑挺出",
        "sen"   :5,
        "jibie" :80,
        "zhaoshi":"「流星赶月」",
        "damage":160,
        "wound":120,
        "damage_type":"刺伤"    ]),
	([	"action":
"$N手中$w剑光暴长，一招「飞燕穿柳」往$n$l刺去",
                "lian" :
"$N手中$w剑光暴长，一招「飞燕穿柳」",
        "zhaoshi":"「飞燕穿柳」",
        "sen" :5,
        "dodge":40,
        "parry":30,
        "jibie":100,
        "damage":180,
        "wound":130,
        "damage_type":"割伤"
	]),
        ([ 
        "action":
"$N手中$w化成一道光弧，直指$n$l，一招「江上弄笛」发出虎哮龙吟刺去",
        "lian":
"$N手中$w化成一道光弧，一招「江上弄笛」发出虎哮龙吟刺去",
        "zhaoshi":"「江上弄笛」",
        "sen":8,
                "dodge":80,
        "parry":70,
