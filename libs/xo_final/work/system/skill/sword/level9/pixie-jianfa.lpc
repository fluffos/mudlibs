inherit SKILL_SWORD;

mapping *get_all_action()
{
    return ({
    ([  "action":
"$N使一招「群邪辟易」，手中$w圈起，倏地刺出，银星点点，剑尖直向$n的$l刺去",
        "lian"  :
"$N使一招「群邪辟易」，手中$w圈起，倏地刺出，银星点点，剑尖直刺",
        "sen"   :3,
        "jibie" :20,
        "zhaoshi":"「群邪辟易」",
         "dodge" :40,
        "parry" :40,
        "damage":100,
        "wound":100,
        "damage_type":"割伤"    ]),
    ([  "action":
"$N一招「钟馗抉目」，剑随身转，围着$n身围疾刺，剑光霍霍罩向$n的$l",
