inherit SKILL_SWORD;

mapping *get_all_action()
{
    return ({
        ([  "action":"$N纵身跃起手中$w轻挥，斩向$n后颈",
            "lian"  :"$N纵身跃起手中$w轻挥",
            "sen"   : 6,
            "jibie" :5,
            "dodge" :20,
            "parry" :30,
            "zhaoshi":"「风平浪静」",
            "damage" :65,
            "wound":40,
            "damage_type":"劈伤"    ]),
        ([  "action":"$N手中$w连画三个弧形，向$n的右臂齐肩斩落",
            "lian"  :"$N手中$w连画三个弧形",
            "parry" :0,
            "sen"   :8,
            "jibie" :10,
            "dodge" :40,
            "zhaoshi":"「风起云涌」",
            "damage" :70,
            "wound":45,
            "damage_type":"刺伤" ]),
        ([  "action":"$N轻吁一声，刷刷刷刷四剑，向$n胸，腹，腰，肩四处连刺",
            "lian"  :"$N轻吁一声，刷刷刷刷四剑",
            "sen"   :7,
            "jibie" :20,
            "dodge" :20,
            "parry" :30,
            "zhaoshi":"「风卷残云」",
            "damage" :75,
            "wound":45,
            "damage_type":"割伤"    ]),
        ([  "action":"$N仰天一声清啸，斜行向前，$w横削直击，迅捷无比，击向$n的$l",
            "lian"  :"$N仰天一声清啸，斜行向前，$w横削直击，迅捷无比",
            "sen"   :8,
            "jibie" :30,
            "dodge" :30,
            "parry" :30,
            "zhaoshi":"「风流云散」",
            "damage" :80,
            "wound":55,
            "damage_type":"割伤"    ]),
    });
}

