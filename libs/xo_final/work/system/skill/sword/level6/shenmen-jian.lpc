inherit SKILL_SWORD;

mapping *get_all_action()
{
    return ({
        ([  "action":
    "$N身形斜飞，手中$w轻轻点向$n的腕部",
            "lian"  :
    "$N身形斜飞，手中$w轻轻点出",
            "sen"   :10,
            "jibie" :15,
            "dodge" :30,
            "parry" :20,
            "damage":75,
            "wound": 60,
            "damage_type":"割伤"    ]),
        ([  "action":
    "$N长跃而起，$w猛然下刺，直打$n腕部的神门穴",
            "lian"  :
    "$N长跃而起，$w猛然下刺，直打神门穴",
            "sen"   :20,
            "jibie" :30,
            "dodge" :40,
            "parry" :10,
            "damage":90,
            "wound": 75,
            "damage_type":"割伤" ]),
        ([  "action":
    "$N手中$w自上而下反刺，模拟冰轮横空、清光铺地的光景",
            "lian"  :
    "$N手中$w自上而下反刺，模拟冰轮横空、清光铺地的光景",
            "sen"   :30,
            "jibie" :45,
            "dodge" :20,
            "parry" :20,
            "damage":105,
            "wound": 85,
            "damage_type":"割伤"    ]),
        ([  "action":
    "$N手中$w颤动来回挥削，只幌得$n眼花撩乱，浑不知从何攻来",
            "lian"  :
    "$N手中$w颤动来回挥削，只幌得人眼花撩乱，浑不知从何攻来",
            "sen"   :40,
            "jibie" :60,
            "dodge" :40,
            "parry" :30,
            "damage":110,
            "wound": 90,
            "damage_type":"割伤"    ]),
    	([	"action":
    "$N手中$w由内自外一刺，左手虚击，身形一晃，$w已搭在$n腕部",
                    "lian" :
    "$N手中$w由内自外一刺，左手虚击，身形一晃",
            "sen" :50,
            "jibie":75,
            "dodge":10,
            "parry":60,
            "damage":120,
            "wound": 100,
            "damage_type":"割伤"
    	]),
        ([  "action":
    "$N左掌横摆胸前，右手中$w轻轻挥拂，直取$n的神门要穴",
            "lian"  :
    "$N左掌横摆胸前，右手中$w轻轻挥拂",
            "sen"   :40,
            "jibie" :80,
            "dodge" :40,
            "parry" :30,
            "damage":110,
            "wound": 90,
            "damage_type":"割伤"    ]),
        ([  "action":
    "$N手中$w中宫直入，携着强大的劲道攻向$n的$l",
                    "lian" :
    "$N手中$w中宫直入，携着强大的劲道攻出",
            "sen" :50,
            "jibie":100,
            "dodge":10,
            "parry":60,
            "damage":120,
            "wound": 100,
            "damage_type":"割伤"
        ]),
    });
}

