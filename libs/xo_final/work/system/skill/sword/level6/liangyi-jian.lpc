inherit SKILL_SWORD;

mapping *get_all_action() {
  return ({
    ([ "action":
      "$N将手中$w急速亮出，使出一招「无风无浪」，往前似若有无向$n的肩头削了过去",
      "lian":
      "$N将手中$w急速亮出，使出一招「无风无浪」，往前似若有无地削了过去",
      "sen": 10,
      "jibie": 15,
      "dodge": 30,
      "parry": 20,
      "zhaoshi": "「无风无浪」",
      "damage": 75,
      "wound": 60,
      "damage_type": "割伤" ]),
    ([ "action":
      "$N手中$w耀出点点剑光，正是一招「半雨半晴」，向$n迎头罩下",
      "lian":
      "$N手中$w耀出点点剑光，正是一招「半雨半晴」",
      "sen": 20,
      "jibie": 30,
      "dodge": 40,
      "parry": 10,
      "zhaoshi": "「半雨半晴」",
      "damage": 90,
      "wound": 75,
      "damage_type": "割伤" ]),
    ([ "action":
      "$N奋力吼出一声，使出一招「壮气蒿莱」，举起手中$w，向$n猛刺过去",
      "lian":
      "$N奋力吼出一声，使出一招「壮气蒿莱」，举起手中$w，向前猛刺过去",
      "sen": 30,
      "jibie": 45,
      "dodge": 20,
      "parry": 20,
      "zhaoshi": "「壮气蒿莱」",
      "damage": 105,
      "wound": 85,
      "damage_type": "割伤" ]),
    ([ "action":
      "$N一个猛回头，正是一招「秦娥望月」，反手一剑向$n的右腿奋力刺去",
      "lian":
      "$N一个猛回头，正是一招「秦娥望月」，反手一剑向下奋力刺去",
      "sen": 40,
      "jibie": 60,
      "dodge": 40,
      "parry": 30,
      "zhaoshi": "「秦娥望月」",
      "damage": 110,
      "wound": 90,
      "damage_type": "割伤" ]),
    ([ "action":
      "$N脸现悲凄之神态，竟是一招「霸陵伤别」，一股气势逼人的剑气向$n扑头而去",
      "lian":
      "$N脸现悲凄之神态，竟是一招「霸陵伤别」，一股气势逼人的剑气向周围散开",
      "zhaoshi": "「霸陵伤别」",
      "sen": 50,
      "jibie": 75,
      "dodge": 10,
      "parry": 60,
      "damage": 120,
      "wound": 100,
      "damage_type": "割伤"
    ]),
  });
}
