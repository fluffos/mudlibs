            "damage":90,
            "wound": 75,
            "damage_type":"割伤" ]),
        ([  "action":
    "$N使出一招"HIY"「山崩」"NOR"，纵身跃入半空，$w如山崩般劈向$n的$l",
            "lian"  :
    "$N使出一招"HIY"「山崩」"NOR"，纵身跃入半空，$w如山崩般劈下",
            "sen"   :30,
            "jibie" :45,
            "dodge" :20,
            "parry" :20,
            "zhaoshi":HIY"「山崩」"NOR,
            "damage":105,
            "wound": 85,
            "damage_type":"割伤"    ]),
        ([  "action":
    "$N使出"HIC"「千旋转」"NOR"，将$w舞得如纺车一般，忽然一剑刺向$n的$l",
            "lian"  :
    "$N使出"HIC"「千旋转」"NOR"，将$w舞得如纺车一般，忽然一剑刺出",
            "sen"   :40,
            "jibie" :60,
            "dodge" :40,
