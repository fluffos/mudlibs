            "zhaoshi":HIC"「千旋转」"NOR,
            "damage":110,
            "wound": 90,
            "damage_type":"割伤"    ]),
    	([	"action":
    "$N使出一招"HIM"「降魔舞」"NOR"，全身劲气贯于$w中，剑气直指$n的$l",
                    "lian" :
    "$N使出一招"HIM"「降魔舞」"NOR"，全身劲气贯于$w中",
            "zhaoshi":HIM"「降魔舞」"NOR,
            "sen" :50,
            "jibie":75,
            "dodge":10,
            "parry":60,
            "damage":120,
            "wound": 100,
            "damage_type":"割伤"
    	]),
        ([  "action":
    "$N单足独立，使出一式"MAG"「鹤舞」"NOR"，一道剑光如白影般向$n的$l扫去",
            "lian"  :
    "$N单足独立，使出一式"MAG"「鹤舞」"NOR"，一道剑光如白影般扫去",
            "sen"   :40,
            "jibie" :80,
            "dodge" :40,
            "parry" :30,
            "zhaoshi":MAG"「鹤舞」"NOR,
            "damage":110,
            "wound": 90,
            "damage_type":"割伤"    ]),
        ([  "action":
    "$N使出一招"GRN"「龙腾」"NOR"，手中$w如游龙般扑向$n的$l",
                    "lian" :
    "$N使出一招"GRN"「龙腾」"NOR"，手中$w如游龙般",
            "zhaoshi":GRN"「龙腾」"NOR,
            "sen" :50,
            "jibie":100,
            "dodge":10,
            "parry":60,
            "damage":120,
            "wound": 100,
            "damage_type":"割伤"
        ]),
        ([  "action":
    "$N飞身一跃，居高临下使出"BLU"「花雨满天」"NOR"，顿时剑尖如雨刺向$n的$l",
                    "lian" :
    "$N飞身一跃，居高临下使出"BLU"「花雨满天」"NOR"，顿时剑尖如雨",
            "zhaoshi":BLU"「花雨满天」"NOR,
