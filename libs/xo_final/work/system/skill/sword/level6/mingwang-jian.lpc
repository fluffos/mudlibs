#include <ansi.h>;

inherit SKILL_SWORD;

mapping *get_all_action()
{
    return ({
        ([  "action":
    "$N怒目圆睁，使出一招"HIB"「不动」"NOR"，手中$w一抖，直刺$n的$l",
            "lian"  :
    "$N怒目圆睁，使出一招"HIB"「不动」"NOR"，手中$w一抖",
            "sen"   :10,
            "jibie" :15,
            "dodge" :30,
            "parry" :20,
            "zhaoshi":HIB"「不动」"NOR,
            "damage":75,
            "wound": 60,
            "damage_type":"割伤"    ]),
        ([  "action":
    "$N使出一式"HIW"「起手出剑」"NOR"，足下一滑，剑芒闪向$n的$l",
            "lian"  :
    "$N使出一式"HIW"「起手出剑」"NOR"，足下一滑",
            "sen"   :20,
            "jibie" :30,
            "dodge" :40,
            "parry" :10,
