#include <ansi.h>;

inherit SKILL_SWORD;

mapping *get_all_action()
{
    return ({
        ([  "action":"$N身体左转，左手剑指，两腿屈膝，右前臂内旋，剑尖前端一寸处短促抖腕发力，一招"HIB"「飞燕入林」"NOR"，手中$w轻轻颤动，一剑自上而下扎向$n的$l",
            "lian"  :"$N身体左转，左手剑指，两腿屈膝，右前臂内旋，剑尖前端一寸处短促抖腕发力，一招"HIB"「飞燕入林」"NOR"，手中$w轻轻颤动，一剑自上而下",
            "sen"   :5,
            "jibie" :10,
            "dodge" :10,
            "parry" :10,
            "damage":55,
            "wound" :40,
            "zhaoshi" : HIB"「飞燕入林」"NOR,
            "damage_type":"刺伤"   ]),
        ([  "action":"$N身形不动，右前臂外旋，剑刃上崩，立马左腿左弓步，一招"HIG"「青龙吐水」"NOR"，手中$w向前下反刺，一剑指向$n的$l",
            "lian"  :"$N身形不动，右前臂外旋，剑刃上崩，立马左腿左弓步，一招"HIG"「青龙吐水」"NOR"，手中$w向前下反刺",
            "sen"   :5,
            "jibie" :20,
            "dodge" :15,
            "parry" :15,
            "damage":55,
            "wound" :40,
            "zhaoshi" : HIG"「青龙吐水」"NOR,
            "damage_type":"刺伤"    ]),
        ([  "action":"$N左脚向前一步，蹬地跳起，身体腾空疾速左转，右手$w先向前刺，随转体变向，使出一式"MAG"「凤凰挚窝」"NOR"，剑光如匹练般泄向$n的$l",
            "lian"  :"$N左脚向前一步，蹬地跳起，身体腾空疾速左转，右手$w先向前刺，随转体变向，使出一式"MAG"「凤凰挚窝」"NOR"，剑光如匹练般",
            "sen"   :6,
            "jibie" :30,
            "dodge" :15,
            "parry" :15,
            "damage":65,
            "wound" :45,
            "zhaoshi" : MAG"「凤凰挚窝」"NOR,
            "damage_type":"割伤" ]),
        ([  "action":"$N碎步急进，提剑沿剑身方向疾速上崩，一招"HIW"「白蛇吐信」"NOR"直取$n的$l",
            "lian"  :"$N碎步急进，提剑沿剑身方向疾速上崩，一招"HIW"「白蛇吐信」"NOR,
            "sen"   :6,
            "jibie" :40,
            "dodge" :15,
            "parry" :15,
            "damage":70,
            "wound" :45,
            "zhaoshi" : HIW"「白蛇吐信」"NOR,
            "damage_type":"淤伤"    ]),
        ([  "action":"$N平剑斜洗，臂圆剑直，双脚交替弧形迈进，右手$w使出一式"HIC"「玉女穿梭」"NOR"，剑锋往来运转如梭，连绵不绝刺向$n的$l",
            "lian"  :"$N平剑斜洗，臂圆剑直，双脚交替弧形迈进，右手$w使出一式"HIC"「玉女穿梭」"NOR"，剑锋往来运转如梭，连绵不绝",
            "sen"   :7,
            "jibie" :50,
            "dodge" :15,
            "parry" :15,
            "damage":75,
            "wound" :50,
            "zhaoshi" : HIC"「玉女穿梭」"NOR,
            "damage_type":"割伤"    ]),
        ([  "action":"$N屈腕抬臂，剑由前向后上方抽带，挺起中平剑奋勇向前，右手$w使出一式"HIY"「仙人指路」"NOR"刺向$n的$l",
            "lian"  :"$N屈腕抬臂，剑由前向后上方抽带，挺起中平剑奋勇向前，右手$w使出一式"HIY"「仙人指路」"NOR,
            "sen"   :7,
            "jibie" :60,
            "dodge" :10,
            "parry" :20,
            "damage":80,
            "wound" :50,
            "zhaoshi" : HIY"「仙人指路」"NOR,
            "damage_type":"割伤"    ]),
        ([  "lian"  :"$N左撤步，抱剑当胸，挥剑做圆环形，正反搅动，右手$w一式"HIG"「怀中抱月」"NOR"，剑意圆润，刺向$n的$l",
            "action":"$N左撤步，抱剑当胸，挥剑做圆环形，正反搅动，右手$w一式"HIG"「怀中抱月」"NOR"，剑意圆润",
            "sen"   :7,
            "jibie" :70,
            "dodge" :15,
            "parry" :25,
            "damage":90,
            "wound" :60,
            "zhaoshi" : HIG"「怀中抱月」"NOR,
            "damage_type":"刺伤"    ]),
        ([  "action": "$N侧身退步，左手剑指划转，腰部一扭，上体后仰，右手$w一记"HIM"「反身朝阳」"NOR"自下上撩指向$n的$l",
            "lian"  : "$N侧身退步，左手剑指划转，腰部一扭，上体后仰，右手$w一记"HIM"「反身朝阳」"NOR"自下上撩指",
            "sen"   :7,
            "jibie" :80,
            "dodge" :20,
            "parry" :20,
            "damage":95,
            "wound" :65,
            "zhaoshi" : HIM"「反身朝阳」"NOR,
            "damage_type" : "刺伤"  ]),
    });
