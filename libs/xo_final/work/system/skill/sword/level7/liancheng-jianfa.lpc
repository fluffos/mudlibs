inherit SKILL_SWORD;

mapping *get_all_action()
{
    return ({
        ([  "action":"$N使一式「孤鸿海上来」，手中$w嗡嗡微振，幻成一条疾光刺向$n的$l",
            "lian"  :"$N使一式「孤鸿海上来」，手中$w嗡嗡微振，幻成一条疾光",
            "sen"   :5,
            "jibie" :10,
            "dodge" :10,
            "parry" :10,
            "damage":55,
            "wound" :40,
            "zhaoshi" : "「孤鸿海上来」",
            "damage_type":"刺伤"   ]),
        ([  "action":"$N错步上前，使出「池潢不敢顾」，手中$w划出一道剑光劈向$n的$l",
            "lian"  :"$N错步上前，使出「池潢不敢顾」，手中$w划出一道剑光",
            "sen"   :5,
            "jibie" :20,
            "dodge" :15,
            "parry" :15,
            "damage":55,
            "wound" :40,
            "zhaoshi" : "「池潢不敢顾」",
            "damage_type":"刺伤"    ]),
        ([  "action":"$N手中$w一抖，一招「落日照大旗」，斜斜一剑反腕撩出，攻向$n的$l",
            "lian"  :"$N手中$w一抖，一招「落日照大旗」，斜斜一剑反腕撩出",
            "sen"   :6,
            "jibie" :30,
            "dodge" :15,
            "parry" :15,
            "damage":65,
            "wound" :45,
            "zhaoshi" : "「落日照大旗」",
            "damage_type":"割伤" ]),
        ([  "action":"$N手中剑锵啷啷长吟一声，一式「马鸣风萧萧」，一道剑光飞向$n的$l",
            "lian"  :"$N手中剑锵啷啷长吟一声，一式「马鸣风萧萧」，一道剑光飞出",
            "sen"   :6,
            "jibie" :40,
            "dodge" :15,
            "parry" :15,
            "damage":70,
            "wound" :45,
            "zhaoshi" : "「马鸣风萧萧」",
            "damage_type":"淤伤"    ]),
        ([  "action":"$N一式「落日阳关路」，手中$w舞出无数剑花，使$n难断虚实，无可躲避",
            "lian"  :"$N一式「落日阳关路」，手中$w舞出无数剑花",
            "sen"   :7,
            "jibie" :50,
            "dodge" :15,
            "parry" :15,
            "damage":75,
            "wound" :50,
            "zhaoshi" : "「落日阳关路」",
            "damage_type":"割伤"    ]),
        ([  "action":"$N手中$w斜指苍天，剑芒吞吐，一式「羌笛怨杨柳」，对准$n的$l斜斜击出",
            "lian"  :"$N手中$w斜指苍天，剑芒吞吐，一式「羌笛怨杨柳」，斜斜击出",
            "sen"   :7,
            "jibie" :60,
            "dodge" :10,
            "parry" :20,
            "damage":80,
            "wound" :50,
            "zhaoshi" : "「羌笛怨杨柳」",
            "damage_type":"割伤"    ]),
        ([  "lian"  :"$N一式「春风度玉门」，手腕急抖，挥洒出万点金光，刺向$n的$l",
            "action":"$N一式「春风度玉门」，手腕急抖，挥洒出万点金光，刺向$n的$l",
            "sen"   :7,
            "jibie" :70,
            "dodge" :15,
            "parry" :25,
            "damage":90,
            "wound" :60,
            "zhaoshi" : "「春风度玉门」",
            "damage_type":"刺伤"    ]),
        ([  "action": "$N一式「遥挂在前川」，$w飞斩盘旋，如疾电般射向$n的胸口",
            "lian"  : "$N一式「遥挂在前川」，$w飞斩盘旋，如疾电般射出",
            "sen"   :7,
            "jibie" :80,
            "dodge" :20,
            "parry" :20,
            "damage":95,
            "wound" :65,
            "zhaoshi" : "「遥挂在前川」",
            "damage_type" : "刺伤"  ]),
        ([  "action": "$N一式「飞流三千尺」，$w突然从天而降，一片金光围掠$n全身",
            "lian"  : "$N一式「飞流三千尺」，$w突然从天而降，一片金光围掠对手全身",
            "sen"   :8,
            "jibie" :90,
            "dodge" :30,
            "parry" :20,
            "damage":105,
            "wound" :70,
            "zhaoshi" : "「飞流三千尺」",
            "damage_type" : "刺伤"  ]),
    });
}

