#include <ansi.h>;

inherit SKILL_SWORD;

mapping *get_all_action() {
  return ({
    ([ "action": "$N意带神闲，一式" GRN "「分花拂柳」" NOR "，$w轻轻飞动，幻起一片剑光，围掠$n全身",
      "lian": "$N意带神闲，一式" GRN "「分花拂柳」" NOR "，$w轻轻飞动，幻起一片剑光",
      "sen": 4,
      "jibie": 0,
      "dodge": 10,
      "parry": 20,
      "zhaoshi": GRN "「分花拂柳」" NOR,
      "wound": 30,
      "damage_type": "刺伤" ]),
    ([ "action": "$N使一招" HIY "「琴心三叠」" NOR "，身形向上飘起，手中$w虚虚实实幻出三点寒光射向$n$l",
      "lian": "$N使一招" HIY "「琴心三叠」" NOR "，身形向上飘起，手中$w虚虚实实幻出三点寒光",
      "sen": 3,
      "jibie": 5,
      "dodge": 20,
      "parry": 20,
      "zhaoshi": HIY "「琴心三叠」" NOR,
      "damage": 55,
      "wound": 40,
      "damage_type": "割伤" ]),
    ([ "action": "$N身形一转，猛然一式" HIG "「罡风扫叶」" NOR "，舞出满天剑影，挟着劲风向$n的$l扫去",
      "lian": "$N身形一转，猛然一式" HIG "「罡风扫叶」" NOR "，舞出满天剑影，挟着劲风扫去",
      "sen": 4,
      "jibie": 10,
      "dodge": 10,
      "parry": 0,
      "zhaoshi": HIG "「罡风扫叶」" NOR,
      "damage": 70,
      "wound": 50,
      "damage_type": "割伤" ]),
    ([ "action": "$N仰天长笑，身形飘然而起，在半空中身子一旋，一式" HIM "「狂歌痛饮」" NOR "狂风般地击向$n",
      "lian": "$N仰天长笑，身形飘然而起，在半空中身子一旋，一式" HIM "「狂歌痛饮」" NOR "狂风般地击出",
      "sen": 4,
      "jibie": 20,
      "dodge": 40,
      "parry": 0,
      "zhaoshi": HIM "「狂歌痛饮」" NOR,
      "damage": 65,
      "wound": 55,
      "damage_type": "刺伤" ]),
    ([ "action": "$N左手捏着剑诀，右足踏开一招" RED "「定阳针」" NOR "向上斜刺，长剑锵然跃出倏的化作几点星光射向$n的$l",
      "lian": "$N左手捏着剑诀，右足踏开一招" RED "「定阳针」" NOR "向上斜刺，长剑锵然跃出倏的化作几点星光",
      "sen": 5,
      "jibie": 30,
      "dodge": 30,
      "parry": 10,
      "zhaoshi": RED "「定阳针」" NOR,
      "damage": 70,
      "wound": 65,
      "damage_type": "割伤" ]),
    ([ "action": "$N向前迈去一大步，使出" HIB "「探海屠龙」" NOR "，手中$w舞成一个光球，迅若奔雷击向$n的$l",
      "lian": "$N向前迈去一大步，使出" HIB "「探海屠龙」" NOR "，手中$w舞成一个光球，迅若奔雷",
      "sen": 5,
      "jibie": 40,
      "dodge": 10,
      "parry": 15,
      "zhaoshi": HIB "「探海屠龙」" NOR,
      "damage": 85,
      "wound": 75,
      "damage_type": "割伤" ]),
  });
}
