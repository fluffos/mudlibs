inherit SKILL_SWORD;

mapping *get_all_action() {
  return ({
    ([ "action": "$N左手横眉，$w斜削而出，剑光似有似无，出手似快似慢，剑路似实似虚，招式 
将变未变。正是“清风十三式”中的第一式“清风徐来” ",
      "lian": "$N左手横眉，$w斜削而出，剑光似有似无，出手似快似慢，剑路似实似虚，招式 
将变未变。正是“清风十三式”中的第一式“清风徐来”",
      "sen": 4,
      "jibie": 0,
      "dodge": 10,
      "parry": 20,
      "zhaoshi": "「清风徐来」",
      "wound": 30,
      "damage_type": "刺伤" ]),
    ([ "action": "$N使出“清风十三式”中第八式“风动千铃”。剑光点点流动，如风铃此起彼伏，却 
分不清到底哪一处在响",
      "lian": "$N使出“清风十三式”中第八式“风动千铃”。剑光点点流动，如风铃此起彼伏，却 
分不清到底哪一处在响",
      "sen": 3,
      "jibie": 5,
      "dodge": 20,
      "parry": 20,
      "zhaoshi": "「风动千铃」",
      "damage": 55,
      "wound": 40,
      "damage_type": "割伤" ]),
    ([ "action": "$N使出“清风十三式”中第二式“流空萤火”，回剑轻削，飘渺的剑光点点飞来如同
夜空中流萤飞舞，袭向$n$l",
      "lian": "$N使出“清风十三式”中第二式“流空萤火”，回剑轻削，飘渺的剑光点点飞来如同
夜空中流萤飞舞",
      "sen": 4,
      "jibie": 10,
      "dodge": 10,
      "parry": 0,
      "zhaoshi": "「流空萤火」",
      "damage": 70,
      "wound": 50,
      "damage_type": "割伤" ]),
    ([ "action": "$N手腕轻抖横剑削来，只见剑意萧萧，飘摇不定，却是“清风十三式”中第三式
“竹外山岚” ",
      "lian": "$N手腕轻抖横剑削来，只见剑意萧萧，飘摇不定，却是“清风十三式”中第三式
“竹外山岚” ",
      "sen": 4,
      "jibie": 20,
      "dodge": 40,
      "parry": 0,
      "zhaoshi": "「竹外山岚」",
      "damage": 65,
      "wound": 55,
      "damage_type": "刺伤" ]),
    ([ "action": "$N手中$w回掠，似乎意态优闲，停招不发，然而剑势不经意的变幻之间已拂向$n$l，
正是“清风十三式”中第四式“云淡风轻”",
      "lian": "$N手中$w回掠，似乎意态优闲，停招不发，然而剑势不经意的变幻之间，
正是“清风十三式”中第四式“云淡风轻”",
      "sen": 5,
      "jibie": 30,
      "dodge": 30,
      "parry": 10,
      "zhaoshi": "「云淡风轻」",
      "damage": 70,
      "wound": 65,
      "damage_type": "割伤" ]),
    ([ "action": "$N左手轻掠划了一个半弧，右手$w连点，使出“清风十三式”中第五式“空穴来风”， 
淡淡的剑气忽然从四面八方掩向$n",
      "lian": "$N左手轻掠划了一个半弧，右手$w连点，使出“清风十三式”中第五式“空穴来风”",
      "sen": 5,
      "jibie": 40,
      "dodge": 10,
      "parry": 15,
      "zhaoshi": "「空穴来风」",
      "damage": 85,
      "wound": 75,
      "damage_type": "割伤" ]),
    ([ "action": "$N将$w横持在面前，左手斜挥而下，右手一转将$w平平推出，丝丝剑气飘然而至。 
正是“清风十三式”中第七式“霜笛清晓”",
      "lian": "$N将$w横持在面前，左手斜挥而下，右手一转将$w平平推出，丝丝剑气飘然而至。 
正是“清风十三式”中第七式“霜笛清晓”",
      "sen": 3,
      "jibie": 60,
      "dodge": 20,
      "parry": 20,
      "zhaoshi": "「霜笛清晓」",
      "damage": 55,
      "wound": 40,
      "damage_type": "割伤" ]),
    ([ "action": "$N手中$w剑势忽左忽右，不断向前飘动，让人分不清方向，然而剑光却渐渐 
涨起，如春风点染绿林。正是“清风十三式”中第九式“绿涨春风”",
      "lian": "$N手中$w剑势忽左忽右，不断向前飘动，让人分不清方向，然而剑光却渐渐 
涨起，如春风点染绿林。正是“清风十三式”中第九式“绿涨春风”",
      "sen": 4,
      "jibie": 80,
      "dodge": 10,
      "parry": 0,
      "zhaoshi": "「绿涨春风」",
      "damage": 70,
      "wound": 50,
      "damage_type": "割伤" ]),
    ([ "action": "$N使出“清风十三式”中第十式“寒梅落雪”，只见剑势萧疏，剑光清冷， 
如点点落梅在风中飘向$n$l",
      "lian": "$N使出“清风十三式”中第十式“寒梅落雪”，只见剑势萧疏，剑光清冷， 
如点点落梅在风中",
      "sen": 4,
      "jibie": 100,
      "dodge": 40,
      "parry": 0,
      "zhaoshi": "「寒梅落雪」",
      "damage": 65,
      "wound": 55,
      "damage_type": "刺伤" ]),
    ([ "action": "$N手中$w轻转，一道道短短的弧光浮现身前，正是“清风十三式”中 
第十二式“风送浮萍”，只见弧光飘动，浮向$n$l。”",
      "lian": "$N手中$w轻转，一道道短短的弧光浮现身前，正是“清风十三式”中 
第十二式“风送浮萍”，只见弧光飘动",
      "sen": 5,
      "jibie": 150,
      "dodge": 30,
      "parry": 10,
      "zhaoshi": "「风送浮萍」",
      "damage": 70,
      "wound": 65,
      "damage_type": "割伤" ]),
  });
}
