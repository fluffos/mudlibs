inherit SKILL_SWORD;

mapping *get_all_action() {
  return ({
    ([ "action":
      "$N怒目圆睁，使出一招「安如磐石」，手中$w一抖，直刺$n的$l  ",
      "lian":
      "$N怒目圆睁，使出一招「安如磐石」，手中$w一抖，直刺出去",
      "zhaoshi": "「安如磐石」",
      "dodge": 10,
      "sen": 2,
      "jibie": 0,
      "parry": 15,
      "force": 18,
      "damage": 15,
      "damage_type": "刺伤",
    ]),
    ([ "action":
      "$N使出一式「昂然直入」，足下一滑，剑芒闪向$n的$l  ",
      "lian":
      "$N使出一式「昂然直入」，足下一滑，剑芒直闪出去",
      "zhaoshi": "「昂然直入」",
      "dodge": 20,
      "parry": 24,
      "force": 30,
      "sen": 2,
      "jibie": 12,
      "damage": 25,
      "damage_type": "刺伤",
    ]),
    ([ "action":
      "$N使出一招「天悬地隔」，纵身跃入半空，$w如山崩般劈向$n的$l  ",
      "lian":
      "$N使出一招「天悬地隔」，纵身跃入半空，$w如山崩般劈了出去",
      "zhaoshi": "「天悬地隔」",
      "dodge": 23,
      "sen": 2,
      "parry": 22,
      "jibie": 25,
      "force": 40,
      "damage": 30,
      "damage_type": "刺伤",
    ]),
    ([ "action":
      "$N使出「随风转舵」，将$w舞得如纺车一般，忽然一剑刺向$n的$l  ",
      "lian":
      "$N使出「随风转舵」，将$w舞得如纺车一般，忽然一剑疾刺出去",
      "zhaoshi": "「随风转舵」",
      "sen": 3,
      "jibie": 35,
      "dodge": 25,
      "parry": 40,
      "force": 40,
      "damage": 30,
      "damage_type": "刺伤",
    ]),
    ([ "action":
      "$N使出一招「天各一方」，全身劲气贯于$w中，剑气直指$n的$l  ",
      "lian":
      "$N使出一招「天各一方」，全身劲气贯于$w中，剑气直刺出去",
      "zhaoshi": "「天各一方」",
      "dodge": 20,
      "sen": 3,
      "jibie": 44,
      "parry": 18,
      "force": 70,
      "damage": 60,
      "damage_type": "刺伤",
    ]),
    ([ "action":
      "$N单足独立，使出一式「图穷匕见」，一道剑光如白影般向$n的$l扫去  ",
      "lian":
      "$N单足独立，使出一式「图穷匕见」，一道剑光如白影般直扫出去",
      "zhaoshi": "「图穷匕见」",
      "dodge": 20,
      "parry": 19,
      "force": 30,
      "sen": 2,
