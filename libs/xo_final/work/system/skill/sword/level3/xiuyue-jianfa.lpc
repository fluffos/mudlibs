inherit SKILL_SWORD;

mapping *get_all_action() {
  return ({
    ([ "action": "$N手中$w一转，回身一剑，刺向$n$l，正是一招「月挂长空」",
      "lian": "$N手中$w一转，回身一剑，正是一招「月挂长空」",
      "jibie": 8,
      "sen": 5,
      "parry": 0,
      "dodge": 10,
      "damage": 50,
      "wound": 50,
      "limb": "小腹",
      "zhaoshi": "「月挂长空」",
      "damage_type": "刺伤"
    ]),
    ([ "action": "只见$N身法陡然加快，施展出「剑气纵横」，剑风荡漾，$w瞬间已至$n$l",
      "lian": "只见$N身法陡然加快，施展出「剑气纵横」，剑风荡漾",
      "jibie": 16,
      "sen": 6,
      "parry": 10,
      "dodge": 0,
      "damage": 60,
      "wound": 50,
      "limb": "胸口",
      "zhaoshi": "「剑气纵横」",
      "damage_type": "刺伤"
    ]),
    ([ "action": "$N纵身跃起，使出一招「晴空万里」，陡见$w从半空直指$N$l",
      "lian": "$N纵身跃起，使出一招「晴空万里」",
      "jibie": 24,
      "sen": 7,
      "parry": 0,
      "dodge": 10,
      "damage": 60,
      "wound": 40,
      "zhaoshi": "「晴空万里」",
      "damage_type": "刺伤"
    ]),
    ([ "action": "$N腾空而起，一招「月下山头」来势又准又快，手中$w已到$n$l",
      "lian": "$N腾空而起，一招「月下山头」来势又准又快",
      "jibie": 32,
      "sen": 5,
      "parry": 0,
      "dodge": 10,
      "damage": 65,
      "wound": 45,
      "zhaoshi": "「月下山头」",
      "damage_type": "刺伤"
    ]),
    ([ "action": "$N剑峰忽转，一剑笔直地向$n$l刺来，内劲十足，正是一招「穿月无限」",
      "lian": "$N剑峰忽转，一剑笔直，内劲十足，正是一招「穿月无限」",
      "jibie": 40,
      "sen": 5,
      "parry": 10,
      "damage": 70,
      "wound": 50,
      "zhaoshi": "「穿月无限」",
      "damage_type": "刺伤"
    ]),
    ([ "action": "$N手中$w猛然回撤，紧接着一剑，气势磅礴，剑气纵横，正是「皓月穿空」",
      "lian": "$N手中$w猛然回撤，紧接着一剑，气势磅礴，剑气纵横，正是「皓月穿空」",
      "jibie": 48,
      "sen": 6,
      "parry": 10,
      "dodge": 0,
      "damage": 70,
      "wound": 50,
      "limb": "小腹",
      "zhaoshi": "「皓月穿空」",
      "damage_type": "刺伤"
    ]),
  });
}
