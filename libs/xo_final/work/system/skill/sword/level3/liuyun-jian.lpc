inherit SKILL_SWORD;

mapping *get_all_action() {
  return ({
    ([ "action": "$N一招「伯牙抚琴」，手中$w一弹，刺向$n的$l",
      "lian": "$N一招「伯牙抚琴」，手中$w一弹，缓缓刺出",
      "sen": 4,
      "jibie": 0,
      "dodge": 10,
      "parry": 20,
      "zhaoshi": "「伯牙抚琴」",
      "wound": 30,
      "damage_type": "刺伤" ]),
    ([ "action": "紧接着$N一招「樊哙屠狗」，高举手中$w，向$n迎头一劈",
      "lian": "$N一招「樊哙屠狗」，手中$w凌空一劈",
      "sen": 3,
      "jibie": 5,
      "dodge": 20,
      "parry": 20,
      "zhaoshi": "「樊哙屠狗」",
      "damage": 55,
      "wound": 40,
      "damage_type": "割伤" ]),
    ([ "action": "紧跟着$N反手一招「西子浣沙」，手中$w向$n的$l一抹",
      "lian": "$N手握$w，使出一招「西子浣沙」向前顺势一抹",
      "sen": 4,
      "jibie": 10,
      "dodge": 10,
      "parry": 0,
      "zhaoshi": "「西子浣沙」",
      "damage": 70,
      "wound": 50,
      "damage_type": "割伤" ]),
    ([ "action": "$N左手捏了个剑诀，右手一招「班超投笔」，手中$w对准$n一点",
      "lian": "$N左手捏了个剑诀，右手一招「班超投笔」，手中$w轻轻一点",
      "sen": 4,
      "jibie": 20,
      "dodge": 40,
      "parry": 0,
      "zhaoshi": "「班超投笔」",
      "damage": 65,
      "wound": 55,
      "damage_type": "刺伤" ]),
    ([ "action": "只见$N弓步上前，双手紧握$w，一招「张良进履」，向$n的头部由下而上一撩",
      "lian": "$N一个弓步，使出一招「张良进履」，手中$w往上一撩",
      "sen": 5,
      "jibie": 30,
      "dodge": 30,
      "parry": 10,
      "zhaoshi": "「张良进履」",
      "damage": 70,
      "wound": 65,
      "damage_type": "割伤" ]),
    ([ "action": "$N手拿$w，一招「渐离击筑」，向$n的$l飞速一击",
      "lian": "$N手拿$w，一招「渐离击筑」，快速击出",
      "sen": 5,
      "jibie": 40,
      "dodge": 10,
      "parry": 15,
      "zhaoshi": "「渐离击筑」",
      "damage": 85,
      "wound": 75,
      "damage_type": "割伤" ]),
  });
}
