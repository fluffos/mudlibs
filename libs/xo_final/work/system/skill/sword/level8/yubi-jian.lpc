#include <ansi.h>

inherit SKILL_SWORD;

mapping *get_all_action()
{
    return ({
        ([  "action":"\n$N手中$w一抖，幻化出几道光影，一招「起舞弄清影」恰似满天风\n"
                     "雪罩向$n",
            "lian"  :"$N手中$w一抖，幻化出满天光影，一招「起舞弄清影」向前推出",
            "sen"   :6,
            "jibie" :10,
            "dodge" :25,
            "parry" :10,
            "wound" :50,
            "damage":50,
            "zhaoshi" : "「起舞弄清影」",
            "damage_type":"刺伤"   ]),
        ([  "action":"\n$N身行飘忽，瞬间来到$n的面前，一招「何似在人间」手\n"
                     "中$w似进似退，直点$n",
            "lian"  :"$N身行飘忽，一招「何似在人间」$w似进似退点出",
            "sen"   :7,
            "jibie" :20,
            "dodge" :15,
            "parry" :25,
            "wound" :50,        
            "damage":65,
            "zhaoshi" : "「何似在人间」",
            "damage_type":"刺伤"    ]),
        ([  "action":"\n$N淡然一笑，竟仿佛$n并不存在，手中$w一声清吟，正是「落花人独立」",
            "lian"  :"$N淡然一笑，手中$w一声清吟，正是「落花人独立」",
            "sen"   :7,
            "jibie" :30,
            "dodge" :15,
            "parry" :15,
            "wound" :80,
            "damage":65,
            "zhaoshi" : "「落花人独立」",
            "damage_type":"刺伤" ]),
        ([  "action":"\n$N脚步游移不定，倒转手中$w，身行如燕直冲而起，再一\n"
                     "式「微雨燕双飞」自上而下直向$n扑来",
            "lian"  :"$N脚步游移不定，倒转手中$w，身行如燕直冲而起，再一\n"
                     "式「微雨燕双飞」自上而下扑去",
            "sen"   :7,
            "jibie" :40,
            "dodge" :35,
            "parry" :25,
            "wound" :80,
            "damage":75,
            "zhaoshi" : "「微雨燕双飞」",
            "damage_type":"刺伤"    ]),
        ([  "action":"\n$N竟仿佛没有在战斗，神情闲适，手中$w自下转上再转而下，划过一道白虹，\n"
    				 "一招「夕阳照雨足」，$n双目为剑光所刺，不住向后倒退",
            "lian"  :"$N神情闲适，手中$w自下转上再转而下，划过一道白虹，\n"
                     "正是一招「夕阳照雨足」",
            "sen"   :7,
            "jibie" :50,
            "dodge" :35,
            "parry" :35,
            "wound" :60,
            "damage":90,
            "zhaoshi" : "「夕阳照雨足」",
            "damage_type":"割伤"    ]),
        ([  "action":CYN"\n$N心底空明，剑随心意，身行傲然拔起，正是「空翠落庭阴」，\n$n为$N气势所逼，不住倒退"NOR,
            "lian"  :CYN"$N心底空明，剑随心意，身行傲然拔起，正是「空翠落庭阴」"NOR,
            "sen"   :7,
            "jibie" :60,
            "dodge" :40,
            "parry" :40,
            "wound" :80,
            "damage":115,
            "zhaoshi" : "「空翠落庭阴」",
            "damage_type":"割伤"    ]),
        ([  "action":"\n$N气定神闲，身子似动非动，微微颔首，似若有所悟，手中$w一招「看取莲花净」。\n"
                     "仿佛$n并不存在一般",
            "lian"  :"$N气定神闲，身子似动非动，微微颔首，似若有所悟，正是一招「看取莲花净」",
    		"sen"   :7,
            "jibie" :70,
            "dodge" :45,
            "parry" :45,
            "wound" :90,
            "damage":130,
            "zhaoshi" : "「看取莲花净」",
            "damage_type":"刺伤"    ]),
        ([  "action": CYN"\n\n$N身行瞬然而上，姿势清雅曼妙，如皓月当空，正是一招「应知不染心」"
    				  "手中$w幻成一道光轮，\n方圆几丈为$N剑气笼罩，$n几乎躲无所处"NOR,
    	    "lian" : CYN"$N身行瞬然而上，姿势清雅曼妙，如皓月当空，正是一招「应知不染心」"NOR,
            "sen"   :7,
            "jibie" :80,
            "dodge" :40,
            "parry" :50,
            "wound" :60,
            "damage":140,
            "zhaoshi" : "「应知不染心」",
            "damage_type" : "刺伤"  ]),
    });
}

