#include <ansi.h>

#define OO YEL"大雅古剑法"NOR

inherit SKILL_SWORD;

mapping *get_all_action()
{
    return ({
    ([  "action": 
"$N手中$w舞动出一片网状，使出"OO"第一式：「盘庚式」，\n"
"将$n周围尽皆罩住",
        "lian"  :
"$N念着口诀：若网在纲，有条不紊"
"$N手中$w舞动出一片网状，使出"OO"第一式：「盘庚式」，\n"
"将自身周围尽皆罩住",
        "sen"   :5,
        "jibie" :15,
        "dodge" :10,
        "parry" :20,
        "zhaoshi":"「盘庚式」",
        "damage":50,
        "wound":50,
        "damage_type":"割伤"    ]),

    ([  "action":
"$N手中$w挥动一股霸道的剑气，正是"OO"第二式：「毕命式」，\n"
"对着$n左右斜劈，凛然有风",
        "lian"  :
"$N念着口诀：彰善潸恶，树之风声"
"$N手中$w挥动一股霸道的剑气，正是"OO"第二式：「毕命式」，\n"
"左右斜劈，凛然有风",
        "sen"   :10,
        "jibie" :30,
        "dodge" :30,
        "parry" :10,
        "zhaoshi":"「毕命式」",
        "damage":60,
        "wound":60,
        "damage_type":"割伤" ]),
    ([  "action":
"$N手中$w闪出点点剑光，联成一线，正是"OO"第三式：「罔命式」，\n"
"$w带动光线，在$n面前挥舞",
        "lian"  :
"$N念着口诀：绳衍纠谬，格其非心"
"只见$N手中$w闪出点点剑光，联成一线，正是"OO"第三式：「罔命式」，\n"
"光线长久不绝",
        "sen"   :15,
        "jibie" :45,
        "dodge" :20,
        "parry" :20,
        "zhaoshi":"「罔命式」",
        "damage":70,
        "wound":70,
        "damage_type":"割伤"    ]),
    ([  "action":
"$N舞动手中$w，正是"OO"第四式：「大畜式」，\n"
"剑光霍霍之中，从一个意想不到的角度突然挑出一剑，向$n的下颚直刺",
        "lian"  :
"$N念着口诀：刚健笃实辉光，日新其德"
"$N舞动手中$w，正是"OO"第四式：「大畜式」，\n"
"剑光霍霍之中，从一个意想不到的角度不时挑出一剑",
        "sen"   :20,
        "jibie" :60,
        "dodge" :40,
        "parry" :40,
        "zhaoshi":"「大畜式」",
        "damage":80,
        "wound":80,
        "damage_type":"割伤"    ]),
	([	"action":
"$N手中$w发出龙吟之声，阴阳相和，高声琨，正声缓，正是"OO"\n"
"第五式：「瞽蒙式」，剑锋直向$n左肩刺过去",
                "lian" :
"$N念着口诀：鼓琴瑟，以役大师"
"$N手中$w发出龙吟之声，阴阳相和，高声琨，正声缓，正是"OO"\n"
"第五式：「瞽蒙式」，剑锋直向前刺",
        "zhaoshi":"「瞽蒙式」",
        "sen" :25,
        "jibie":75,
        "dodge":20,
        "parry":50,
        "damage":90,
        "wound":90,
        "damage_type":"割伤"
	]),
	([	"action":
"$N身体在原地游走，脚步散而不乱，正是"OO"第六式：「述而式」，\n"
"手中$w摆动，不时向$n刺出一剑",
                "lian" :
"$N念着口诀：志于道，据于德，依于仁，游于艺"
"$N身体在原地游走，脚步散而不乱，正是"OO"第六式：「述而式」，\n"
"手中$w摆动，不时刺出一剑",
        "zhaoshi":"「述而式」",
        "sen" :30,
        "jibie":90,
        "dodge":70,
        "parry":10,
        "damage":100,
        "wound":100,
        "damage_type":"割伤"
	]),
	([	"action":
"$N身体十分稳重，正是"OO"第七式：「至诚式」，\n"
"手中$w若有若无，缓缓击出一剑，向$n的肩部搭了过去",
                "lian" :
"$N念着口诀：盹盹其仁，渊渊其渊，浩浩其天"
"$N身体十分稳重，正是"OO"第七式：「至诚式」，\n"
"手中$w若有若无，缓缓击出一剑",
        "zhaoshi":"「至诚式」",
        "sen" :35,
        "jibie":105,
        "dodge":40,
        "parry":30,
        "damage":110,
        "wound":110,
        "damage_type":"割伤"
	]),
	([	"action":
"$N使出的正是"OO"第八式：「止戢式」，\n"
"手中$w剑光柔和，隐隐有风雷之声，向$n扑面涌去，令人顿有退避之意",
                "lian" :
"$N念着口诀：载戢戈，载蠹弓矢，我求懿德，肆于时夏"
"$N使出的正是"OO"第八式：「止戢式」，\n"
"手中$w剑光柔和，隐隐有风雷之声，令人听来顿有退避之意",
        "zhaoshi":"「止戢式」",
        "sen" :10,
        "jibie":120,
        "dodge":80,
        "parry":70,
        "damage":130,
        "wound":130,
        "damage_type":"割伤"
	]),
});
}

string *get_all_parry_msg()
{
    return ({
        "$n使出「“恒”字诀」，口中念道：日月得天而能久照，四时变化而能久成"
        "只见$n丝毫不乱，应接不暇，将$N的招式一一截住",
        "$n使出「“遁”字诀」，口中念道：刚当位而应，与时行也"
        "$n见机而动，向外轻巧地跃开",
        "$n使出「“萃”字诀」，口中念道：乃乱乃萃，其志乱也"
        "$n似乎有些散乱，竟尔突然定住，顿时将$N的攻势化解于无形",
        "$n使出「“革”字诀」，口中念道：文明以说，大亨以正"
        "$n在千钧一发之际，突然不知从什么地方横出一剑，拦住了$N的这一招",
        "$n使出「“比”字诀」，口中念道：舍逆取顺"
        "$n低头躲过$N这一招，闪身跃开",
        "$n使出「“需”字诀」，口中念道：刚健而不陷，其义不穷困矣"
        "$n无偏不偏，恰恰从$N的攻势中躲了开去",
        });
}

string *get_all_unarmed_msg()
{
    return ({
        "$n使出「“恒”字诀」，口中念道：日月得天而能久照，四时变化而能久成"
        "只见$n丝毫不乱，应接不暇，将$N的招式一一截住",
        "$n使出「“遁”字诀」，口中念道：刚当位而应，与时行也"
        "$n见机而动，向外轻巧地跃开",
        "$n使出「“萃”字诀」，口中念道：乃乱乃萃，其志乱也"
        "$n似乎有些散乱，竟尔突然定住，顿时将$N的攻势化解于无形",
        "$n使出「“革”字诀」，口中念道：文明以说，大亨以正"
        "$n在千钧一发之际，突然不知从什么地方横切一掌，拦住了$N的这一招",
        "$n使出「“比”字诀」，口中念道：舍逆取顺"
        "$n低头躲过$N这一招，闪身跃开",
        "$n使出「“需”字诀」，口中念道：刚健而不陷，其义不穷困矣"
        "$n无偏不偏，恰恰从$N的攻势中躲了开去",
        });
}

