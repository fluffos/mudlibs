inherit SKILL_SWORD;

mapping *get_all_action() {
  return ({
    ([ "action":
      "$N身体立得笔直，使出一招「鸿渐于干」，手中的$w突然向$n的右肩刺了过去",
      "lian":
      "$N身体立得笔直，使出一招「鸿渐于干」，手中的$w突然向前下方刺去",
      "sen": 4,
      "jibie": 10,
      "dodge": 20,
      "parry": 30,
      "zhaoshi": "「鸿渐于干」",
      "damage": 80,
      "damage_type": "割伤" ]),
    ([ "action":
      "$N将身形顿住，使出一招「鸿渐于磬」，将手中$w慢慢向前递出，逼得$n直倒退",
      "lian":
      "$N将身形顿住，使出一招「鸿渐于磬」，将手中$w慢慢向前递出",
      "sen": 8,
      "jibie": 25,
      "dodge": 30,
      "parry": 20,
      "zhaoshi": "「鸿渐于磬」",
      "damage": 90,
      "damage_type": "割伤" ]),
    ([ "action":
      "$N身体凝住不动，使出一招「鸿渐于陆」，$w缓缓向前，直销$n的右肩",
      "lian":
      "$N身体凝住不动，使出一招「鸿渐于陆」，$w缓缓向前销了过去",
      "sen": 12,
      "jibie": 40,
      "dodge": 10,
      "parry": 50,
      "zhaoshi": "「鸿渐于陆」",
      "damage": 120,
      "damage_type": "割伤" ]),
    ([ "action":
      "$N身形一动不动，使出一招「鸿渐于木」，$w向上挑出，一道白光向$n头顶霹了过去",
      "lian":
      "$N身形一动不动，使出一招「鸿渐于木」，$w向上挑出，闪出一道白光",
      "sen": 16,
      "jibie": 55,
      "dodge": 30,
      "parry": 10,
      "zhaoshi": "「鸿渐于木」",
      "damage": 130,
      "damage_type": "割伤" ]),
    ([ "action":
      "$N身体似若虚无，使出一招「鸿渐于陵」，手中$w象是重若千钧，向$n当头压下",
      "lian":
      "$N身体似若虚无，使出一招「鸿渐于陵」，手中$w象是重若千钧，缓缓砍下",
      "zhaoshi": "「鸿渐于陵」",
      "sen": 20,
      "jibie": 70,
      "dodge": 40,
      "parry": 10,
      "damage": 140,
      "damage_type": "割伤"
    ]),
  });
}
