inherit SKILL_SWORD;

//以攻为守，以守为攻，海天一线，玉石俱焚，如封似闭，义无返顾，天河倒泻，开天辟地
mapping *get_all_action()
{
    return ({
        ([  "action":"紧接着$N一招「以攻为守」，浑不顾$n的攻势，一剑直劈而出",
            "lian"  :"$N一招「以攻为守」，手中$w凌空一劈。招势大开大阖，颇有气势",
            "sen"   : 6,
            "jibie" :5,
            "dodge" :20,
            "parry" :30,
            "zhaoshi":"「以攻为守」",
            "damage" :65,
            "wound":40,
            "damage_type":"劈伤"    ]),
        ([  "action":"紧跟着$N反手一招「以守为攻」，踏前两步，手中$w洒出道道剑影罩住$n全身",
            "lian"  :"$N手握$w，使出一招「以守为攻」，手中$w洒出万道剑影罩住全身",
            "parry" :0,
            "sen"   :8,
            "jibie" :10,
            "dodge" :40,
            "zhaoshi":"「以守为攻」",
            "damage" :70,
            "wound":45,
            "damage_type":"刺伤" ]),
        ([  "action":"$N左手捏了个剑诀，右手一招「海天一线」，手中$w微横，斜斜指向$n$l",
            "lian"  :"$N左手捏了个剑诀，右手一招「海天一线」，手中$w微横，全身无一处破绽",
            "sen"   :7,
            "jibie" :20,
            "dodge" :20,
            "parry" :30,
            "zhaoshi":"「海天一线」",
            "damage" :75,
            "wound":45,
            "damage_type":"割伤"    ]),
        ([  "action":"只见$N双手紧握$w，一招「如封似闭」，划出千百个大大小小的圈子，遮在$n身前",
            "lian"  :"$N一个弓步，使出一招「如封似闭」，划出千百个大大小小的圈子",
            "sen"   :8,
            "jibie" :30,
            "dodge" :30,
            "parry" :30,
            "zhaoshi":"「如封似闭」",
            "damage" :80,
            "wound":55,
            "damage_type":"割伤"    ]),
        ([  "action":"$N手拿$w，一招「玉石俱焚」，以全身的功力向$n的$l飞速一击",
            "lian"  :"$N手拿$w，一招「玉石俱焚」，快速击出",
            "sen"   :8,
            "jibie" :40,
            "dodge" :10,
            "parry" :10,
            "zhaoshi":"「玉石俱焚」",
            "damage" :95,
            "wound":70,
            "damage_type":"刺伤"    ]),
    });
}

