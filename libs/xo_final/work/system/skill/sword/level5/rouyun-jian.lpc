// rouyun-jian.c
// 柔云剑术
//不论拳脚还是兵器，一招既出，再次出招，自必收回再发，
//柔云剑术的妙诣却在一招之后，不论对方如何招架退避，
//第二招顺势跟着就来，如柔丝不断，春云绵绵。
//杏花春雨、三环套月、白虹贯日
//春云乍展、斗柄南指、耿耿银河
//六级武功


inherit SKILL_SWORD;

mapping *get_all_action() {
  return ({
    ([ "action": "紧跟着$N反手一招「杏花春雨」，手中$w向$n的$l一抹",
      "lian": "$N手握$w，使出一招「杏花春雨」向前顺势一抹",
      "sen": 10,
      "jibie": 0,
      "dodge": 10,
      "parry": 10,
      "zhaoshi": "「杏花春雨」",
      "wound": 65,
      "damage_type": "割伤" ]),

    ([ "action": "紧接着$N一招「三环套月」，手中$w幻化出无数光环，卷向$n",
      "lian": "$N一招「三环套月」，手中$w幻化出无数光环",
      "sen": 20,
      "jibie": 10,
      "dodge": 20,
      "parry": 40,
      "zhaoshi": "「三环套月」",
      "damage": 95,
      "wound": 75,
      "damage_type": "割伤" ]),

    ([ "action": "$N一招「耿耿银河」，手中$w横削，随即千头万绪般乱点下来，真若天上繁星一般",
      "lian": "$N手中$w向前千头万绪般乱点下去，正是一招「耿耿银河」",
      "sen": 30,
      "jibie": 20,
      "dodge": 30,
      "parry": 60,
      "zhaoshi": "「耿耿银河」",
      "damage": 105,
      "wound": 80,
      "damage_type": "刺伤" ]),
    ([ "action": "只见$N弓步上前，双手紧握$w，一招「春云乍展」，向$n的头部由下而上一撩",
      "lian": "$N一个弓步，使出一招「春云乍展」，手中$w往上一撩",
      "sen": 40,
      "jibie": 30,
      "dodge": 20,
      "parry": 70,
      "zhaoshi": "「春云乍展」",
      "damage": 110,
      "wound": 80,
      "damage_type": "割伤" ]),
    ([ "action": "$N手拿$w，一招「斗柄南指」，向$n的$l飞速一击",
      "lian": "$N手拿$w，一招「斗柄南指」，快速击出",
      "sen": 50,
      "jibie": 40,
      "dodge": 20,
      "parry": 75,
      "zhaoshi": "「斗柄南指」",
      "damage": 115,
      "wound": 85,
      "damage_type": "割伤" ]),
    ([ "action": "$N一招「白虹贯日」，手中$w划出一道彩虹，闪电般刺向$n的$l",
      "lian": "$N一招「白虹贯日」，手中$w一抖，闪电般向前刺出",
      "sen": 60,
      "jibie": 100,
      "dodge": 100,
      "parry": 100,
      "zhaoshi": "「白虹贯日」",
      "damage": 135,
      "wound": 100,
      "damage_type": "刺伤" ]),
  });
}
