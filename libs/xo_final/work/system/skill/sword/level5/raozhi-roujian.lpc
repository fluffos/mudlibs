inherit SKILL_SWORD;

mapping *get_all_action() {
  return ({
    ([ "action": "$N使出一招「天外流星」，手中$w如一条银蛇般刺向$n的$l",
      "lian": "$N使出一招「天外流星」，手中$w如一条银蛇般刺出",
      "sen": 6,
      "jibie": 5,
      "dodge": 20,
      "parry": 30,
      "zhaoshi": "「天外流星」",
      "damage": 65,
      "wound": 40,
      "damage_type": "刺伤" ]),
    ([ "action": "$N一式「落花满天」，手中$w化做满天剑影直刺向$n的$l",
      "lian": "$N一式「落花满天」，手中$w化做满天剑影",
      "parry": 0,
      "sen": 8,
      "jibie": 10,
      "dodge": 40,
      "zhaoshi": "「落花满天」",
      "damage": 70,
      "wound": 45,
      "damage_type": "刺伤" ]),
    ([ "action": "$N使出一招「窗含柔月」，手中$w挥舞，舞出数个剑花圈向$n的$l",
      "lian": "$N使出一招「窗含柔月」，手中$w挥舞，舞出数个剑花",
      "sen": 7,
      "jibie": 20,
      "dodge": 20,
      "parry": 30,
      "zhaoshi": "「窗含柔月」",
      "damage": 75,
      "wound": 45,
      "damage_type": "割伤" ]),
    ([ "action": "$N轻轻一跃，一招「乘风归去」，却在转身之际对准$n$l斜斜挥出一剑",
      "lian": "$N轻轻一跃，一招「乘风归去」，却在转身之际斜斜挥出一剑",
      "sen": 8,
      "jibie": 30,
      "dodge": 30,
      "parry": 30,
      "zhaoshi": "「乘风归去」",
      "damage": 80,
      "wound": 55,
      "damage_type": "割伤" ]),
    ([ "action": "$N神态悠闲，手中$w凭空一指，一招「白云千载」轻妙地划向$n的$l",
      "lian": "$N神态悠闲，手中$w凭空一指，一招「白云千载」轻妙地划出",
      "sen": 8,
      "jibie": 40,
      "dodge": 10,
      "parry": 10,
      "zhaoshi": "「白云千载」",
      "damage": 95,
      "wound": 70,
      "damage_type": "刺伤" ]),
  });
}
