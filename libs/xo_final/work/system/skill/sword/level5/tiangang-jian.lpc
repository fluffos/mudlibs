inherit SKILL_SWORD;

mapping *get_all_action() {
  return ({
    ([ "action": "$N运力一抖剑，一时「马蹴落花」，剑幻出点点剑花，飘然刺出",
      "lian": "$N运力一抖剑，一时「马蹴落花」，剑幻出点点剑花，飘然刺出",
      "sen": 6,
      "jibie": 5,
      "dodge": 20,
      "parry": 30,
      "zhaoshi": "「马蹴落花」",
      "damage": 65,
      "wound": 40,
      "damage_type": "劈伤" ]),
    ([ "action": "$N手中剑一指，纵起丈余，一式「横行漠北」，雷霆般击出",
      "lian": "$N手中剑一指，纵起丈余，一式「横行漠北」，雷霆般击出",
      "parry": 0,
      "sen": 8,
      "jibie": 10,
      "dodge": 40,
      "zhaoshi": "「横行漠北」",
      "damage": 70,
      "wound": 45,
      "damage_type": "刺伤" ]),
    ([ "action": "$N身形向上飘起，突然一转身，头下脚上，手握剑，一招「絮坠无声」，无声无息地攻出",
      "lian": "$N身形向上飘起，突然一转身，头下脚上，手握剑，一招「絮坠无声」，无声无息地攻出",
      "sen": 7,
      "jibie": 20,
      "dodge": 20,
      "parry": 30,
      "zhaoshi": "「絮坠无声」",
      "damage": 75,
      "wound": 45,
      "damage_type": "割伤" ]),
    ([ "action": "$N大喝一声，一招「白虹经天」，剑闪电般划出一道大圆弧劈下",
      "lian": "$N大喝一声，一招「白虹经天」，剑闪电般划出一道大圆弧劈下",
      "sen": 8,
      "jibie": 30,
      "dodge": 30,
      "parry": 30,
      "zhaoshi": "「白虹经天」",
      "damage": 80,
      "wound": 55,
      "damage_type": "割伤" ]),
    ([ "action": "$N忽然身形高高跃起，使出「浪迹天涯」，手中剑幻出漫天花瓣，迅如雷霆射出",
      "lian": "$N忽然身形高高跃起，使出「浪迹天涯」，手中剑幻出漫天花瓣，迅如雷霆射出",
      "sen": 8,
      "jibie": 40,
      "dodge": 10,
      "parry": 10,
      "zhaoshi": "「浪迹天涯」",
      "damage": 95,
      "wound": 70,
      "damage_type": "刺伤" ]),
  });
}
