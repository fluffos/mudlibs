#include <ansi.h>

inherit SKILL_SWORD;

mapping *get_all_action() {
  return ({
    ([ "action": "$N提起$w，划了个半圈，斜斜向$n$l刺去",
      "lian": "$N提起$w，划了个半圈",
      "jibie": 8,
      "sen": 5,
      "parry": 0,
      "dodge": 10,
      "damage": 50,
      "wound": 50,
      "limb": "小腹",
      "damage_type": "刺伤"
    ]),
    ([ "action": "$N突然间将$w交左手，反手刺出",
      "lian": "$N突然间将$w交左手，反手刺出",
      "jibie": 16,
      "sen": 6,
      "parry": 10,
      "dodge": 0,
      "damage": 60,
      "wound": 50,
      "limb": "胸口",
      "damage_type": "刺伤"
    ]),
    ([ "action": "$N突然跨步向前，一招「十步杀一人」，手中$w向$n的$l劈出",
      "lian": "$N突然跨步向前，一招「十步杀一人」",
      "jibie": 24,
      "sen": 7,
      "parry": 0,
      "dodge": 10,
      "damage": 60,
      "wound": 40,
      "zhaoshi": "「十步杀一人」",
      "damage_type": "刺伤"
    ]),
    ([ "action": "$N身子往下一矮身，同时一挥手中$w，一招「脱剑膝前横」，向$n的$l横劈而出",
      "lian": "$N身子往下一矮身，同时一挥手中$w，一招「脱剑膝前横」",
      "jibie": 32,
      "sen": 5,
      "parry": 0,
      "dodge": 10,
      "damage": 65,
      "wound": 45,
      "zhaoshi": "「脱剑膝前横」",
      "damage_type": "刺伤"
    ]),
    ([ "action": "$N剑招忽变，歪歪斜斜地使出一式「雨打飞花」，剑路全走斜势，飘逸无伦，偶尔又夹著一招正式，令$n极难捉摸",
      "lian": "$N剑招忽变，歪歪斜斜地使出一式「雨打飞花」，剑路全走斜势，飘逸无伦，偶尔又夹著一招正式",
      "jibie": 40,
      "sen": 5,
      "parry": 10,
      "damage": 70,
      "wound": 50,
      "zhaoshi": "「雨打飞花」",
      "damage_type": "刺伤"
    ]),
    ([ "action": "$N剑刃平刺而出，锋朝左右，一招「大漠平沙」，$w上剑光渺茫莫测，辽阔无边地刺向$n的$l",
      "lian": "$N剑刃平刺而出，锋朝左右，一招「大漠平沙」，$w上剑光渺茫莫测，辽阔无边",
      "jibie": 48,
      "sen": 6,
      "parry": 10,
      "dodge": 0,
      "damage": 70,
      "wound": 50,
      "limb": "小腹",
      "zhaoshi": "「大漠平沙」",
      "damage_type": "刺伤"
    ]),
    ([ "action": "$N一振$w，一式「金针渡劫」，出招迅捷无伦，$w陡发嗤嗤声响，剑尖离$n$l已不及半尺",
      "lian": "$N一振$w，一式「金针渡劫」，出招迅捷无伦，$w陡发嗤嗤声响",
      "jibie": 56,
      "sen": 6,
      "parry": 0,
      "dodge": 10,
      "damage": 75,
      "wound": 50,
      "zhaoshi": "「金针渡劫」",
      "damage_type": "割伤"
    ]),
    ([ "action": "$N手中$w急转，使出一招「神驼骏足」，气度沉稳，直削$n$l，剑势如渊停岳峙，看似古拙，实则蕴藏无穷奥妙",
      "lian": "$N手中$w急转，使出一招「神驼骏足」，气度沉稳，剑势如渊停岳峙，看似古拙，实则蕴藏无穷奥妙",
      "jibie": 64,
      "sen": 7,
      "parry": 0,
      "dodge": 0,
      "damage": 85,
      "wound": 60,
      "zhaoshi": "「神驼骏足」",
      "damage_type": "刺伤"
    ]),
    ([ "action": "$N横剑当腹，摆一招「雪拥蓝桥」势，陡然带起一团冷森森的剑光，将$n周身环环裹住",
      "lian": "$N横剑当腹，摆一招「雪拥蓝桥」势，陡然带起一团冷森森的剑光",
      "jibie": 100,
      "sen": 5,
      "parry": 0,
      "dodge": 10,
      "damage": 65,
      "wound": 45,
      "zhaoshi": "「雪拥蓝桥」",
      "damage_type": "刺伤"
    ]),
    ([ "action": "$N剑尖斜指向地，使一招「木叶萧萧」，手腕一抖，剑光暴长，但听飒飒声响，转瞬间已连攻$n身上七八处要害",
      "lian": "$N剑尖斜指向地，使一招「木叶萧萧」，手腕一抖，剑光暴长，但听飒飒声响",
      "jibie": 120,
      "sen": 5,
      "parry": 10,
      "damage": 70,
      "wound": 50,
      "zhaoshi": "「木叶萧萧」",
      "damage_type": "刺伤"
    ]),
    ([ "action": "$N斜出一剑，一招「峭壁断云」，剑势出奇险峻，精妙难言，$w迳削$n的$l，於凌厉剑势之中，暗伏极繁复的後著变化",
      "lian": "$N斜出一剑，一招「峭壁断云」，剑势出奇险峻，精妙难言",
      "jibie": 150,
      "sen": 6,
      "parry": 10,
      "dodge": 0,
      "damage": 70,
      "wound": 50,
      "limb": "小腹",
      "zhaoshi": "「峭壁断云」",
      "damage_type": "刺伤"
    ]),
    ([ "action": HIG "$N晃动$w，踏奇门，走偏锋，剑尖颤了几颤，巧妙无比，似左实右，已点在$n$l" NOR,
      "lian": HIG "$N晃动$w，踏奇门，走偏锋，剑尖颤了几颤，巧妙无比，似左实右" NOR,
      "jibie": 200,
      "sen": 6,
      "parry": 0,
      "dodge": 10,
      "damage": 75,
      "wound": 50,
      "damage_type": "割伤"
    ]),
    ([ "action": HIW "$N翻身一剑，剑诀斜引，锋芒从半空中直泻下来，向$n的$l斩落" NOR,
      "lian": HIW "$N翻身一剑，剑诀斜引，锋芒从半空中直泻下来" NOR,
      "jibie": 300,
      "sen": 7,
      "parry": 0,
      "dodge": 0,
      "damage": 85,
      "wound": 60,
      "damage_type": "刺伤"
    ]),
  });
}
