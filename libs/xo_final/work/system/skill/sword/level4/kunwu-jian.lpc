inherit SKILL_SWORD;

mapping *get_all_action()
{
    return ({
        ([  "action":
    "$N往后一个踞步，正是一招「黑虎坐洞」，手中$w向$n肩部直挑过去",
            "lian"  :
    "$N往后一个踞步，使出一招「黑虎坐洞」，手中$w向前直挑而上",
            "sen"   :3,
            "jibie" :5,
            "dodge" :20,
            "parry" :20,
            "zhaoshi":"「黑虎坐洞」",
            "damage":60,
            "damage_type":"割伤"    ]),
        ([  "action":
    "$N目光盯住$n，使出一招「青蛇盘地」，手中$w旋起一片剑光，将$n整个罩住",
            "lian"  :
    "$N目光向前凝视，使出一招「青蛇盘地」，只见剑光霍霍",
            "sen"   :6,
            "jibie" :20,
            "dodge" :25,
            "parry" :25,
            "zhaoshi":"「青蛇盘地」",
            "damage":70,
            "damage_type":"割伤" ]),
        ([  "action":
    "$N手臂往前一伸，一招「白猿鲜果」随之递出，$w向$n急刺过去",
            "lian"  :
    "$N一个拗步，手握$w，使出一招「白猿鲜果」，向前急刺而出",
            "sen"   :9,
            "jibie" :35,
            "dodge" :30,
            "parry" :30,
            "zhaoshi":"「白猿鲜果」",
            "damage":80,
            "damage_type":"割伤"    ]),
        ([  "action":
    "$N身子突然跃起，使出一招「乌雀空飞」，手中$w向$n的右肩划下",
            "lian"  :
    "$N手拿$w，使出一招「乌雀空飞」，身体随之跃起",
            "sen"   :12,
            "jibie" :50,
            "dodge" :35,
            "parry" :35,
            "zhaoshi":"「乌雀空飞」",
            "damage":90,
            "damage_type":"割伤"    ]),
    	([	"action":
    "$N手中$w施展开来，正是一招「丹凤亮翅」，晃出点点剑花，向$n击过去",
                    "lian" :
    "$N将手中的$w施展开来，一招「丹凤亮翅」，晃出点点剑花",
            "zhaoshi":"「丹凤亮翅」",
            "sen" :15,
            "jibie":75,
            "dodge":40,
            "parry":40,
            "damage":100,
            "damage_type":"割伤"
    	]),
            ([ 
            "action":
    "$N一招「黄龙探海」，手举$w，向$n当头砍下，隐隐有风雷之声",
            "lian":
    "$N一招「黄龙探海」，手举$w，往前砍下，隐隐有风雷之声",
            "zhaoshi":"「黄龙探海」",
            "sen":18,
            "jibie":90,
            "dodge":45,
            "parry":45,
            "damage":110,
            "damage_type":"割伤"
    	]),
    });
}

