inherit SKILL_SWORD;

mapping *get_all_action() {
  return ({
    ([ "action":
      "$N募的使一招「别风淮雨」，顿时剑光中几朵血花洒向$n全身",
      "lian":
      "$N募的使一招「别风淮雨」，顿时剑光中几朵血花洒向四方",
      "zhaoshi": "「别风淮雨」",
      "dodge": 50,
      "sen": 3,
      "jibie": 0,
      "parry": 80,
      "force": 80,
      "damage": 70,
      "damage_type": "刺伤",
    ]),
    ([ "action":
      "$N剑尖微颤作龙吟，一招「风流云散」，切骨剑气如飓风般裹向$n全身",
      "lian":
      "$N剑尖微颤作龙吟，一招「风流云散」，切骨剑气如飓风般直刺出去",
      "zhaoshi": "「风流云散」",
      "dodge": 60,
      "parry": 70,
      "force": 90,
      "sen": 4,
      "jibie": 20,
      "damage": 75,
      "damage_type": "刺伤",
    ]),
    ([ "action":
      "$N随风轻轻飘落，一式「高风亮节」，手中$w平指，缓缓拍向$n脸颊",
      "lian":
      "$N随风轻轻飘落，一式「高风亮节」，手中$w平指，缓缓拍出",
      "zhaoshi": "「高风亮节」",
      "dodge": 65,
      "sen": 3,
      "parry": 60,
      "jibie": 35,
      "force": 70,
      "damage": 75,
      "damage_type": "刺伤",
    ]),
    ([ "action":
      "$N呼的一声拔地而起，一式「金风玉露」，$w幻出万道光影，将$n团团围住",
      "lian":
      "$N呼的一声拔地而起，一式「金风玉露」，$w幻出万道光影疾刺出去",
      "zhaoshi": "「金风玉露」",
      "sen": 3,
      "jibie": 50,
      "dodge": 85,
      "parry": 50,
      "force": 80,
      "damage": 80,
      "damage_type": "刺伤",
    ]),
    ([ "action":
      "$N手中$w斜指苍天，剑芒吞吐，一式「攀龙附凤」，对准$n的$l斜斜击出",
      "lian":
      "$N手中$w斜指苍天，剑芒吞吐，一式「攀龙附凤」，斜刺出去",
      "zhaoshi": "「攀龙附凤」",
      "dodge": 60,
      "sen": 3,
      "jibie": 68,
      "parry": 68,
      "force": 80,
      "damage": 80,
      "damage_type": "刺伤",
    ]),
    ([ "action":
      "$N合掌跌坐，一式「飞龙在天」，$w自怀中跃出，如疾电般射向$n的胸口",
      "lian":
      "$N合掌跌坐，一式「飞龙在天」，$w自怀中跃出，如疾电般射出",
      "zhaoshi": "「飞龙在天」",
      "dodge": 100,
      "parry": 90,
      "force": 120,
      "sen": 8,
      "jibie": 95,
      "damage": 100,
      "damage_type": "刺伤",
    ]),
  });
}

int valid_learn(object me) {
  if (me->query_jibie("buddhism") < 101) {
    return notify_fail("你的佛学修为不够，强练绝技会伤及身体。\n");
  }

  return ::valid_learn(me);
}
