#include <ansi.h>

inherit SKILL_SWORD;

mapping *get_all_action() {
  return ({
    ([ "action": "$N$w一立，举剑过顶，弯腰躬身，使一招「万岳朝宗」，正是嫡系正宗的嵩山剑法，突然间剑光一吐，$w化作一道白虹，向$n直刺过来",
      "lian": "$N$w一立，举剑过顶，弯腰躬身，使一招「万岳朝宗」，正是嫡系正宗的嵩山剑法，突然间剑光一吐，$w化作一道白虹",
      "jibie": 8,
      "sen": 5,
      "parry": 0,
      "dodge": 10,
      "damage": 50,
      "wound": 50,
      "limb": "小腹",
      "zhaoshi": "「万岳朝宗」",
      "damage_type": "刺伤"
    ]),
    ([ "action": "$N一剑自上而下，朝$n$l直劈下去，这一招「独劈华山」虽平平无奇，但呼的一声响，从空中疾劈而下，确有开山裂石的声势",
      "lian": "$N一剑自上而下，直劈下去，这一招「独劈华山」虽平平无奇，但呼的一声响，从空中疾劈而下，确有开山裂石的声势",
      "jibie": 16,
      "sen": 6,
      "parry": 10,
      "dodge": 0,
      "damage": 60,
      "wound": 50,
      "limb": "胸口",
      "zhaoshi": "「独劈华山」",
      "damage_type": "刺伤"
    ]),
    ([ "action": "$N左手向外一分，右手$w向右掠出，使的是一招「开门见山」，招数堂皇，势道凌厉，$w直扫$n$l",
      "lian": "$N左手向外一分，右手$w向右掠出，使的是一招「开门见山」，招数堂皇，势道凌厉",
      "jibie": 24,
      "sen": 7,
      "parry": 0,
      "dodge": 10,
      "damage": 60,
      "wound": 40,
      "zhaoshi": "「开门见山」",
      "damage_type": "刺伤"
    ]),
    ([ "action": "$N忽尔使出一招「千古人龙」，气度清隽，但虚虚实实，後着甚多，这一剑离$n尚有尺许，便已缩转，一斜身，$w转向$n$l削落",
      "lian": "$N忽尔使出一招「千古人龙」，气度清隽，但虚虚实实，後着甚多",
      "jibie": 32,
      "sen": 5,
      "parry": 0,
      "dodge": 10,
      "damage": 65,
      "wound": 45,
      "zhaoshi": "「千古人龙」",
      "damage_type": "刺伤"
    ]),
    ([ "action": "$N剑路轻灵，使出一招「叠翠浮青」，$w颤动，剑锋上冷光闪动，刷刷刷连环三剑，攻得$n险象环生",
      "lian": "$N剑路轻灵，使出一招「叠翠浮青」，$w颤动，剑锋上冷光闪动，刷刷刷连环三剑",
      "jibie": 40,
      "sen": 5,
      "parry": 10,
      "damage": 70,
      "wound": 50,
      "zhaoshi": "「叠翠浮青」",
      "damage_type": "刺伤"
    ]),
    ([ "action": "$N手中$w寒光连闪，这一招「玉井天池」威仪整肃，气象森严，便似千军万马奔驰而来，长枪大戟，黄沙千里，尽显堂堂之阵、正正之师的气度",
      "lian": "$N手中$w寒光连闪，这一招「玉井天池」威仪整肃，气象森严，便似千军万马奔驰而来，长枪大戟，黄沙千里，尽显堂堂之阵、正正之师的气度",
      "jibie": 48,
      "sen": 6,
      "parry": 10,
      "dodge": 0,
      "damage": 70,
      "wound": 50,
      "limb": "小腹",
      "zhaoshi": "「玉井天池」",
      "damage_type": "刺伤"
    ]),
    ([ "action": "$N手中$w自左而右急削过去，使出嵩山派正宗剑法「天外玉龙」，$w如灵蛇，如神龙，剑身似曲似直，便如一件活物一般，奔腾矫夭，气势雄浑",
      "lian": "$N手中$w自左而右急削过去，使出嵩山派正宗剑法「天外玉龙」，$w如灵蛇，如神龙，剑身似曲似直，便如一件活物一般，奔腾矫夭，气势雄浑",
      "jibie": 56,
      "sen": 6,
      "parry": 0,
      "dodge": 10,
      "damage": 75,
      "wound": 50,
      "zhaoshi": "「天外玉龙」",
      "damage_type": "割伤"
    ]),
    ([ "action": HIW "突然间寒光一闪，$N手中$w" + HIW "直刺向$n，剑上震荡而发巨声，实是乾坤一掷的猛击，一剑之出，具雷霆万钧之势！" NOR,
      "lian": HIW "突然间寒光一闪，$N手中$w" + HIW "直刺而出，剑上震荡而发巨声，实是乾坤一掷的猛击，一剑之出，具雷霆万钧之势！" NOR,
      "jibie": 64,
      "sen": 7,
      "parry": 0,
      "dodge": 0,
      "damage": 85,
      "wound": 60,
      "damage_type": "刺伤"
    ]),
  });
}
