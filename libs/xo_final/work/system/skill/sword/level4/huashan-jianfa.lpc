    ([ "action": "$N侧身斜刺一剑，一招" + (order[random(13)]) + "「古柏森森」" NOR "卷带着森然剑气，将$n包围紧裹",
      "lian": "$N侧身斜刺一剑，一招" + (order[random(13)]) + "「古柏森森」" NOR "卷带着森然剑气",
