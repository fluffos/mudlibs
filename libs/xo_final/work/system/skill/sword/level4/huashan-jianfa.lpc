    ([ "action": "$N双手握起$w，剑芒暴长，一式" + (order[random(13)]) + "「无双无对」" NOR "，驭剑猛烈绝伦地往$n冲刺",
      "lian": "$N双手握起$w，剑芒暴长，一式" + (order[random(13)]) + "「无双无对」" NOR "，驭剑猛烈绝伦地刺出",
