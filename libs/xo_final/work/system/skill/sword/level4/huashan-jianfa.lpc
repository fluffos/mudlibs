    ([ "action": "$N凝气守中，$w逼出雪亮剑芒，挥出" + (order[random(13)]) + "「无边落木」" NOR "，一剑快似一剑地攻向$n",
      "lian": "$N凝气守中，$w逼出雪亮剑芒，挥出" + (order[random(13)]) + "「无边落木」" NOR "，一剑快似一剑",
