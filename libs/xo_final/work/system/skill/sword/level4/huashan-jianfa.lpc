      "damage_type": "刺伤"
    ]),
    ([ "action": "$N飞身跃起，一式" + (order[random(13)]) + "「金雁横空」" NOR "，卷起漫天剑影，$w向$n电射而去",
      "lian": "$N飞身跃起，一式" + (order[random(13)]) + "「金雁横空」" NOR "，卷起漫天剑影",
      "jibie": 48,
