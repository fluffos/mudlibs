inherit SKILL_SWORD;

mapping *get_all_action()
{
    return ({
        ([  "action"  : "$N右手$w慢慢指出，突然间在空中一颤，发出嗡嗡之声，跟着便是嗡嗡两剑，手中$w剑光暴长，向$n的$l刺去",
            "lian"    : "$N右手$w慢慢指出，突然间在空中一颤，发出嗡嗡之声，跟着便是嗡嗡两剑，手中$w剑光暴长",
            "jibie"   : 8,
            "sen"     : 5,
            "parry"   : 0,
            "dodge"   : 10,
            "damage"  : 50,
            "wound"   : 50,
            "limb"    : "小腹",
            "damage_type":"刺伤"
        ]),
        ([  "action"  : "$N手中$w如鬼如魅，竟然已绕到了$n背后，$n急忙转身，耳边只听得嗡嗡两声",
            "lian"    : "$N手中$w如鬼如魅",
            "jibie"   : 16,
            "sen"     :  6,
            "parry"   :  10,
            "dodge"   :  0,
            "damage"  : 60,
            "wound"   : 50,
            "limb"    : "胸口",
            "damage_type":"刺伤"
        ]),
        ([  "action"  : "$N手中$w寒光陡闪，手中的$w，猛地反刺，直指$n胸口。这一下出招快极，抑且如梦如幻，正是“百变千幻衡山云雾十三式”中的绝招「百变千幻」",
            "lian"    : "$N手中$w寒光陡闪，手中的$w，猛地反刺。这一下出招快极，抑且如梦如幻，正是“百变千幻衡山云雾十三式”中的绝招「百变千幻」",
            "jibie"   : 24,
            "sen"     :  7,
            "parry"   :  0,
            "dodge"   :  10,
            "damage"  : 60,
            "wound"   : 40,
            "zhaoshi" : "「百变千幻」",
            "damage_type":"刺伤"
        ]),
        ([  "action"  : "$N不理会对方攻势来路，手中$w刷的一剑「泉鸣芙蓉」，向$n小腹刺去",
            "lian"    : "$N不理会对方攻势来路，手中$w刷的一剑「泉鸣芙蓉」",
            "jibie"   : 32,
            "sen"     :  5,
            "parry"   :  0,
            "dodge"   :  10,
            "damage"  : 65,
            "wound"    : 45,
            "zhaoshi" : "「泉鸣芙蓉」",
            "damage_type":"刺伤"
        ]),
        ([  "action"  : "$N不理会对方攻势来路，手中$w刷的一剑「鹤翔紫盖」，向$n额头刺去",
            "lian"    : "$N不理会对方攻势来路，手中$w刷的一剑「鹤翔紫盖」",
            "jibie"   : 40,
            "sen"     :  5,
            "parry"   :  10,
            "damage"  : 70,
            "wound"   : 50,
            "zhaoshi" : "「鹤翔紫盖」",
            "damage_type":"刺伤"
        ]),
        ([  "action"  : "$N手中$w倏地刺出，剑势穿插迂回，如梦如幻，正是一招「石廪书声」，向$n$l刺去",
            "lian"    : "$N手中$w倏地刺出，剑势穿插迂回，如梦如幻，正是一招「石廪书声」",
            "jibie"   : 48,
            "sen"     :  6,
            "parry"   :  10,
            "dodge"   :  0,
            "damage"  : 70,
            "wound"   : 50,
            "limb"    : "小腹",
            "zhaoshi" : "「石廪书声」",
            "damage_type":"刺伤"
        ]),
        ([  "action"  : "$N手中$w倏地刺出，极尽诡奇之能事，动向无定，不可捉摸。正是一招「天柱云气」，指向$n$l",
            "lian"    : "$N手中$w倏地刺出，极尽诡奇之能事，动向无定，不可捉摸。正是一招「天柱云气」",
            "jibie"   : 56,
            "sen"     :  6,
            "parry"   :  0,
            "dodge"   :  10,
            "damage"  : 75,
            "wound"    : 50,
            "zhaoshi" : "「天柱云气」",
            "damage_type":"割伤"
        ]),
        ([  "action"  : "$N飞身跃起，『雁回祝融』！，$w发出一声龙吟从半空中洒向$n的$l",
            "lian"    : "$N飞身跃起，『雁回祝融』！，$w发出一声龙吟",
            "jibie"   : 64,
            "sen"     :  7,
            "parry"   :  0,
            "dodge"   :  0,
            "damage"  :  85,
            "wound"   :60,
            "zhaoshi" : "「雁回祝融」",
            "damage_type":"刺伤"
        ]),
    });
}

