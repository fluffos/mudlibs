inherit SKILL_SWORD;

mapping *get_all_action()
{
    return ({
        ([  "action"  : "$N右手$w斜指而下，左手五指正在屈指而数，从一数到五，握而成拳，又
将拇指伸出，次而食指，终至五指全展，跟着又屈拇指而屈食指，再屈中
指，然后手中$w剑光暴长，向$n的$l刺去",
            "lian"    : "$N右手$w斜指而下，左手五指正在屈指而数，从一数到五，握而成拳，又
将拇指伸出，次而食指，终至五指全展，跟着又屈拇指而屈食指，再屈中
指，然后手中$w剑光暴长",
            "jibie"   : 8,
            "sen"     : 5,
            "parry"   : 0,
            "dodge"   : 10,
            "damage"  : 50,
            "wound"   : 50,
            "limb"    : "小腹",
            "zhaoshi" : "「岱宗如何」", 
            "damage_type":"刺伤"
        ]),
        ([  "action"  : "$N手中$w一晃，向右滑出三步，一招“朗月无云”，转过身来，身
子微矮，$w向$n斜斜刺去",
            "lian"    : "$N手中$w一晃，向右滑出三步，一招“朗月无云”，转过身来，身
子微矮，$w斜斜刺去",
            "jibie"   : 16,
            "sen"     :  6,
            "parry"   :  10,
            "dodge"   :  0,
            "damage"  : 60,
            "wound"   : 50,
            "limb"    : "胸口",
            "zhaoshi" : "「朗月无云」",
            "damage_type":"刺伤"
        ]),
        ([  "action"  : "$N手中$w圈转，一招「峻岭横空」去势奇疾，无数剑光刺向$n的$l",
            "lian"    : "$N手中$w圈转，一招「峻岭横空」去势奇疾，无数剑光刺去",
            "jibie"   : 24,
            "sen"     :  7,
            "parry"   :  0,
            "dodge"   :  10,
            "damage"  : 60,
            "wound"   : 40,
            "zhaoshi" : "「峻岭横空」",
            "damage_type":"刺伤"
        ]),
        ([  "action"  : "$N展开剑势，身随剑走，左边一拐，右边一弯，越转越急。猛地
$w剑光暴长，一招「泰山十八盘」往$n$l刺去",
            "lian"    : "$N展开剑势，身随剑走，左边一拐，右边一弯，越转越急。猛地
$w剑光暴长，一招「泰山十八盘」",
            "jibie"   : 32,
            "sen"     :  5,
            "parry"   :  0,
            "dodge"   :  10,
            "damage"  : 65,
            "wound"    : 45,
            "zhaoshi" : "「泰山十八盘」",
            "damage_type":"刺伤"
        ]),
        ([  "action"  : "$N手中$w倏地刺出，一连五剑，每一剑的剑招皆苍然有古意。招数
古朴，内藏奇变，正是「五大夫剑」",
            "lian"    : "$N手中$w倏地刺出，一连五剑，每一剑的剑招皆苍然有古意。招数
古朴，内藏奇变，正是「五大夫剑」",
            "jibie"   : 40,
            "sen"     :  5,
            "parry"   :  10,
            "damage"  : 70,
            "wound"   : 50,
            "zhaoshi" : "「五大夫剑」",
            "damage_type":"刺伤"
        ]),
    });
}

