inherit SKILL_SWORD;

mapping *get_all_action()
{
    return ({
        ([	"action":"$N大喝一声，一式「摧灭烦恼贼」，手中$w威猛无匹地向$n刺去",
        	"lian"  :"$N面带庄严之色，手中$w迅猛地向前刺去",
            "sen"   :3,
            "jibie" :0,
            "zhaoshi":"「摧灭烦恼贼」",
        	"damage_type":	"刺伤"
        ]),
        ([	"action":"$N怒吼连连，$w化作一团光芒，铺天盖地向$n裹去，正合「勇健无能逾」之意",
            "lian"  :"$N手中$w指打八方，化作一团光芒",
            "sen"	:3,
        	"jibie"	:10,
        	"zhaoshi":"「勇健无能逾」",
        	"damage_type":	"割伤"
        ]),
        ([	"action":"$N$w斜指，一式「劫中有刀兵」反击$n的$l",
            "lian"  :"$N$w斜指，挑向假想中的敌手",
        	"sen"	:1,
        	"jibie"	:20,
        	"zhaoshi":"「劫中有刀兵」",
        	"damage_type":	"割伤"
        ]),
        ([	"action":"$N面上忽含微笑之意，$w上指，似是施礼，突然一式「供养於十方」\n"
        			 "剑花点点，竟把$n全身都笼罩其中",
        	"lian"  :"$N$w上指，突然下划，幻化出无数剑影",
        	"sen"	:1,
        	"jibie"	:30,
        	"zhaoshi":"「供养於十方」",
        	"damage_type":	"割伤"
        ]),
        ([	"action":"$n攻向$N的$l，$N微微一笑，以「觉知众魔事」刺向$n的空门",
        	"lian"  :"$N剑带守势，忽然转守为攻，$w直刺了出去",
            "sen"	:2,
        	"jibie"	:40,
        	"zhaoshi":"「觉知众魔事」",
        	"damage_type":	"刺伤"
        ]),
        ([	"action":"$N$w化作八方风雨，伴有隐隐雷声，中宫急进，正是一式「天地皆洞然」",
        	"lian"  :"$N$w化作八方风雨，伴有隐隐雷声，中宫急进",
            "sen"	:2,
        	"jibie"	:50,
        	"zhaoshi":"「天地皆洞然」",
        	"damage_type":	"刺伤"
        ]),
        ([	"action":"$N使出「化令向佛道」$w微摆，喝一声：“善哉！”，$w侧转，平拍$n的$l",
        	"lian"  :"$N侧转$w，平平拍出",
        	"sen"	:1,
        	"jibie"	:60,
        	"zhaoshi":"「化令向佛道」",
        	"damage_type":	"瘀伤"
        ]),
        ([	"action":"$N大吼一声，$w一式「降伏四种魔」，连攻$n身上四大要害",
        	"lian"  :"$N$w一抖，连攻四个方向",
            "sen"	:3,
        	"jibie"	:70,
        	"zhaoshi":"「降伏四种魔」",
        	"damage_type":	"刺伤"
        ]),
    });
}

