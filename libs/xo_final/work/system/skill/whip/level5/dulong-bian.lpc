inherit SKILL_LONG;

mapping *get_all_action() {
  return ({
    ([ "zhaoshi": "「神龙回首」",
      "action": "$N身形一转，一招「神龙回首」，手中$w如矫龙般腾空一卷，猛地向$n劈头打下",
      "lian": "$N身形一转，一招「神龙回首」，手中$w如矫龙般腾空一卷，猛地劈头打下",
      "jibie": 10,
      "sen": 3,
      "dodge": 0,
      "parry": 0,
      "damage": 55,
      "wound": 40,
      "damage_type": "鞭伤"
    ]),
    ([ "zhaoshi": "「怒龙在天」",
      "action": "$N力贯鞭梢，一招「怒龙在天」，手中$w舞出满天鞭影，排山倒海般扫向$n全身",
      "lian": "$N力贯鞭梢，一招「怒龙在天」，手中$w舞出满天鞭影，排山倒海般扫出",
      "jibie": 15,
      "sen": 2,
      "dodge": 10,
      "parry": 10,
      "damage": 60,
      "wound": 55,
      "damage_type": "鞭伤"
    ]),
    ([ "zhaoshi": " 「毒龙横飞」",
      "action":
      "$N使一招「毒龙横飞」，就地一滚，手中$w自下而上撩向$n的$l  ",
      "lian":
      "$N使一招「毒龙横飞」，就地一滚，手中$w自下而上撩出  ",
      "jibie": 25,
      "limb": "腿部",
      "sen": 4,
      "dodge": 0,
      "parry": 20,
      "damage": 70,
      "damage_type": "鞭伤"
    ]),
    ([ "zhaoshi": "「云龙三现」",
      "action": "$N跃入半空，使一招「云龙三现」，高举$w卷向$n的$l  ",
      "lian": "$N跃入半空，使一招「云龙三现」，高举$w横卷而出  ",
      "jibie": 33,
      "sen": 3,
      "dodge": 10,
      "parry": 10,
      "damage": 75,
      "wound": 65,
      "damage_type": "刺伤"
    ]),
    ([ "zhaoshi": "「龙归大海」",
      "action": "$N展身虚步，提腰跃落，一招「龙归大海」，$w一卷，拦腰击向$n",
      "lian": "$N展身虚步，提腰跃落，一招「龙归大海」，$w一卷，拦腰击出",
      "jibie": 40,
      "limb": "面门",
      "sen": 4,
      "dodge": 10,
      "parry": 20,
      "damage": 95,
      "wound": 70,
      "damage_type": "刺伤"
    ]),
  });
}

string query_weapon_type() {
  return "whip";
}
