#include <ansi.h>

inherit SKILL_LONG;

mapping *get_all_action() {
  return ({
    ([ "zhaoshi": MAG "「凤凰展翅」" NOR,
      "action": "$N向上跃起，一招" MAG "「凤凰展翅」" NOR "，手中$w自下而上，击向$n的脸颊",
      "lian": "$N向上跃起，一招" MAG "「凤凰展翅」" NOR "，手中$w自下而上",
      "jibie": 10,
      "sen": 3,
      "dodge": 0,
      "parry": 0,
      "damage": 55,
      "wound": 40,
      "damage_type": "鞭伤"
    ]),
    ([ "zhaoshi": MAG "「彩凤栖梧」" NOR,
      "action": "$N一招" MAG "「彩凤栖梧」" NOR "，手中$w直绕向$n的$l",
      "lian": "$N一招" MAG "「彩凤栖梧」" NOR "，手中$w直绕",
      "jibie": 15,
      "sen": 2,
      "dodge": 10,
      "parry": 10,
      "damage": 60,
      "wound": 55,
      "damage_type": "鞭伤"
    ]),
    ([ "zhaoshi": HIY "「鸾凤和鸣」" NOR,
      "action":
      "$N一招" HIY "「鸾凤和鸣」" NOR "，手中$w腾空一卷，一声脆响入磬，猛地向$n劈头打下",
      "lian":
      "$N一招" HIY "「鸾凤和鸣」" NOR "，手中$w腾空一卷，一声脆响入磬，猛地打下",
      "jibie": 25,
      "limb": "腿部",
      "sen": 4,
      "dodge": 0,
      "parry": 20,
      "damage": 70,
      "damage_type": "鞭伤"
    ]),
    ([ "zhaoshi": HIG "「游龙戏凤」" NOR,
      "action": "$N踏上一步，冲着$n轻佻一笑，手中$w却毫不停留，一招" HIG "「游龙戏凤」" NOR "，扫向$n的$l",
      "lian": "$N踏上一步，轻佻一笑，手中$w却毫不停留，一招" HIG "「游龙戏凤」" NOR,
      "jibie": 33,
      "sen": 3,
      "dodge": 10,
      "parry": 10,
      "damage": 75,
      "wound": 65,
      "damage_type": "刺伤"
    ]),
    ([ "zhaoshi": HIR "「龙飞凤舞」" NOR,
      "action": "$N跃在半空，一招" HIR "「龙飞凤舞」" NOR "，手中$w如游龙洗空，长凤戏羽，乱雨倾盆般分点$n左右",
      "lian": "$N跃在半空，一招" HIR "「龙飞凤舞」" NOR "，手中$w如游龙洗空，长凤戏羽，乱雨倾盆般分点左右",
      "jibie": 40,
      "limb": "面门",
      "sen": 4,
      "dodge": 10,
      "parry": 20,
      "damage": 95,
      "wound": 70,
      "damage_type": "刺伤"
    ]),
    ([ "zhaoshi": HIM "「龙凤呈祥」" NOR,
      "action": "$N向前急进，手中$w圈转如虹，一招" HIM "「龙凤呈祥」" NOR "，罩向$n前胸",
      "lian": "$N向前急进，手中$w圈转如虹，一招" HIM "「龙凤呈祥」" NOR,
      "jibie": 40,
      "limb": "面门",
      "sen": 4,
      "dodge": 10,
      "parry": 20,
      "damage": 95,
      "wound": 70,
      "damage_type": "刺伤"
    ]),
  });
}

string query_weapon_type() {
  return "whip";
}
