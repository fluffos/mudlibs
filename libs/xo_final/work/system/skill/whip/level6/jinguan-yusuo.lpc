#include <ansi.h>

inherit SKILL_LONG;

mapping *get_all_action() {
  return ({
    ([ "action":
      "却见$N双手轮转，护住周身，顿时将$n的招数全全封锁",
      "lian":
      "却见$N双手轮转，护住周身，顿时将自己全全封锁",
      "jibie": 8,
      "sen": 4,
      "dodge": 20,
      "damage": 50,
      "damage_type": "内伤" ]),

    ([ "action":
      "但是$N身形急变，内劲迸发，将$n的攻势阻隔开来",
      "lian":
      "但是$N身形急变，内劲迸发，将攻势阻隔开来",
      "jibie": 16,
      "sen": 6,
      "dodge": 10,
      "parry": 20,
      "damage": 60,
      "damage_type": "刺伤" ]),

    ([ "action":
      "但是$N身子微侧，双手同时一拨，已将$n的招数卸于无形",
      "lian":
      "但是$N身子微侧，双手同时一拨",
      "jibie": 24,
      "sen": 6,
      "dodge": 20,
      "damage": 54,
      "damage_type": "内伤" ]),
  });
}

string query_weapon_type() {
  return "whip";
}
