inherit SKILL_LONG;

mapping *get_all_action() {
  return ({
    ([ "zhaoshi": "「大海沉沙」",
      "action":
      "$N伫立不动，挥动$w，使出一招「大海沉沙」，手中$w缓缓向$n的$l击去，去势虽不劲急，\n但鞭势沉滞，如同压了几千斤泥沙一般",
      "lian":
      "$N伫立不动，挥动$w，使出一招「大海沉沙」，手中$w缓缓击去，去势虽不劲急，\n但鞭势沉滞，如同压了几千斤泥沙一般",
      "jibie": 10,
      "sen": 3,
      "dodge": 0,
      "parry": 0,
      "damage": 30,
      "damage_type": "鞭伤"
    ]),
    ([ "zhaoshi": "「海天一线」",
      "action":
      "$N手持$w中央，一招「海天一线」，$w一端陡然一翻，点向$n前胸，劲风所至，将$n退路封住，\n另一端如灵蛇出洞，疾速卷向$n脚踝",
      "lian":
      "$N手持$w中央，一招「海天一线」，$w一端陡然一翻",
      "jibie": 15,
      "sen": 2,
      "dodge": 10,
      "parry": 10,
      "damage": 40,
      "damage_type": "鞭伤"
    ]),
    ([ "zhaoshi": " 「巨浪排空」",
      "action":
      "$N冷哼一声，急催内力，使出一招「巨浪排空」，鞭势加快，只见十数重鞭影如惊滔骇浪般向$n的$l疾卷而来",
      "lian":
      "$N冷哼一声，急催内力，使出一招「巨浪排空」，鞭势加快，只见十数重鞭影如惊滔骇浪般",
      "jibie": 25,
      "limb": "腿部",
      "sen": 4,
      "dodge": 0,
      "parry": 20,
      "damage": 45,
      "damage_type": "鞭伤"
    ]),
    ([ "zhaoshi": "「万里无波」",
      "action":
      "$N缓缓转动手中$w，一式「万里无波」，手中$w去势奇慢，不带丝毫破空之声，\n但所过之处尘土飞扬，$w上所带劲风已刮得人扑面生疼",
      "lian":
      "$N缓缓转动手中$w，一式「万里无波」，手中$w去势奇慢，不带丝毫破空之声",
      "jibie": 33,
      "sen": 3,
      "dodge": 10,
      "parry": 10,
      "damage": 50,
      "damage_type": "刺伤"
    ]),
    ([ "zhaoshi": "「沧海一粟」",
      "action":
      "$N身形游走不定，忽地使出一招「沧海一粟」，$w上风声大作，刹那间数十条鞭影从四面八方向$n周身要害击到",
      "lian":
      "$N身形游走不定，忽地使出一招「沧海一粟」，$w上风声大作，刹那间数十条鞭影",
      "jibie": 40,
      "limb": "面门",
      "sen": 4,
      "dodge": 10,
      "parry": 20,
      "damage": 60,
      "damage_type": "刺伤"
    ]),
    ([ "zhaoshi": "「怒海蓝涛」",
      "action":
      "$N狂啸一声，双目精光大盛，一招「怒海蓝涛」，鞭势展开，或横扫直击，或盘旋翻卷，倾刻间已将$n全身裹住",
      "lian":
      "$N狂啸一声，双目精光大盛，一招「怒海蓝涛」，鞭势展开，或横扫直击，或盘旋翻卷",
      "jibie": 50,
      "limb": "后脑",
      "sen": 5,
      "parry": 20,
      "dodge": 20,
      "damage": 70,
      "damage_type": "鞭伤"
    ]),
  });
}

string query_weapon_type() {
  return "whip";
}
