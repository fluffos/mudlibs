#include <ansi.h>

inherit SKILL_LONG;

mapping *get_all_action()
{
    return ({
    ([	"action":
"$N伫立不动，挥动$w，使出一招「大海沉沙」，手中$w缓缓向$n的$l击去，去势虽不劲急，\n但鞭势沉滞，如同压了几千斤泥沙一般",
        "lian"  :
"$N伫立不动，挥动$w，使出一招「大海沉沙」，手中$w缓缓击去，去势虽不劲急，\n但鞭势沉滞，如同压了几千斤泥沙一般",
        "jibie" :8,
        "zhaoshi":"「大海沉沙」",
        "sen"   :4,
        "dodge" :20,
        "damage":50,
        "damage_type":"内伤"   ]),

    ([  "action":
"$N手持$w中央，一招「海天一线」，$w一端陡然一翻，点向$n前胸，劲风所至，将$n退路封住，\n另一端如灵蛇出洞，疾速卷向$n脚踝",
        "lian"  :
"$N手持$w中央，一招「海天一线」，$w一端陡然一翻，劲风所至，如灵蛇出洞",
        "jibie" :16,
        "zhaoshi":"「海天一线」",
        "sen"   :6,
        "dodge" :10, 
        "parry" :20,
        "damage":60,
        "damage_type":"刺伤"    ]),

    ([  "action":
"$N冷哼一声，急催内力，使出一招「巨浪排空」，鞭势加快，只见十数重鞭影如惊滔骇浪般向$n的$l疾卷而来",
        "lian"  :
"$N冷哼一声，急催内力，使出一招「巨浪排空」，鞭势加快，只见十数重鞭影如惊滔骇浪般疾卷而来",
        "jibie" :24,
        "zhaoshi":"「巨浪排空」",
        "sen"   :6,
        "dodge" :20,
        "damage":54,
        "damage_type":"内伤"    ]),

    ([  "action":
"$N缓缓转动手中$w，一式「万里无波」，手中$w去势奇慢，不带丝毫破空之声，\n但所过之处尘土飞扬，$w上所带劲风已刮得人扑面生疼",
        "lian"  :
"$N缓缓转动手中$w，一式「万里无波」，手中$w去势奇慢，不带丝毫破空之声，\n但所过之处尘土飞扬，$w上所带劲风已刮得人扑面生疼",
        "jibie" :32,
        "zhaoshi":"「万里无波」",
        "sen"   :5,
        "dodge" :40,
        "damage":60,
        "damage_type":"淤伤"    ]),

    ([  "action":
"$N身形游走不定，忽地使出一招「沧海一粟」，$w上风声大作，刹那间数十条鞭影从四面八方向$n周身要害击到",
        "lian"  :
"$N身形游走不定，忽地使出一招「沧海一粟」，$w上风声大作，刹那间数十条鞭影从四面八方击到",
        "jibie" :40,
        "sen"   :8,
        "zhaoshi":"「沧海一粟」",
        "damage":65,
        "parry" :60,      
        "damage_type":"刺伤"   ]),

    ([  "action":
"$N狂啸一声，双目精光大盛，一招「怒海蓝涛」，鞭势展开，或横扫直击，或盘旋翻卷，倾刻间已将$n全身裹住",
        "lian"  :
"$N狂啸一声，双目精光大盛，一招「怒海蓝涛」，鞭势展开，或横扫直击，或盘旋翻卷",
        "jibie" :48,
        "zhaoshi":"「怒海蓝涛」",
        "sen"   :7,
        "damage":50,
        "parry": 50,
        "damage_type":"刺伤"   ]),
});
}

string query_weapon_type()
{
    return "whip";
}

