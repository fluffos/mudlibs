#include <ansi.h>

inherit SKILL_LONG;

mapping *get_all_action() {
  return ({
    ([ "action":
      "$N向上跃起，一招" MAG "「凤凰展翅」" NOR "，手中$w自下而上，击向$n的脸颊",
      "lian":
      "$N向上跃起，一招" MAG "「凤凰展翅」" NOR "，手中$w自下而上",
      "jibie": 8,
      "zhaoshi": MAG "「凤凰展翅」" NOR,
      "sen": 4,
      "dodge": 20,
      "damage": 50,
      "damage_type": "内伤" ]),

    ([ "action":
      "$N一招" MAG "「彩凤栖梧」" NOR "，手中$w直绕向$n的$l",
      "lian":
      "$N一招" MAG "「彩凤栖梧」" NOR "，手中$w直绕",
      "jibie": 16,
      "zhaoshi": MAG "「彩凤栖梧」" NOR,
      "sen": 6,
      "dodge": 10,
      "parry": 20,
      "damage": 60,
      "damage_type": "刺伤" ]),

    ([ "action":
      "$N一招" HIY "「鸾凤和鸣」" NOR "，手中$w腾空一卷，一声脆响入磬，猛地向$n劈头打下",
      "lian":
      "$N一招" HIY "「鸾凤和鸣」" NOR "，手中$w腾空一卷，一声脆响入磬",
      "jibie": 24,
      "zhaoshi": HIY "「鸾凤和鸣」" NOR,
      "sen": 6,
      "dodge": 20,
      "damage": 54,
      "damage_type": "内伤" ]),

    ([ "action":
      "$N踏上一步，冲着$n轻佻一笑，手中$w却毫不停留，一招" HIG "「游龙戏凤」" NOR "，扫向$n的$l",
      "lian":
      "$N踏上一步，冲着$n轻佻一笑，手中$w却毫不停留，一招" HIG "「游龙戏凤」" NOR,
      "jibie": 32,
      "zhaoshi": HIG "「游龙戏凤」" NOR,
      "sen": 5,
      "dodge": 40,
      "damage": 60,
      "damage_type": "淤伤" ]),

    ([ "action":
      "$N跃在半空，一招" HIR "「龙飞凤舞」" NOR "，手中$w如游龙洗空，长凤戏羽，乱雨倾盆般分点$n左右",
      "lian":
      "$N跃在半空，一招" HIR "「龙飞凤舞」" NOR "，手中$w如游龙洗空，长凤戏羽，乱雨倾盆",
      "jibie": 40,
      "sen": 8,
      "zhaoshi": HIR "「龙飞凤舞」" NOR,
      "damage": 65,
      "parry": 60,
      "damage_type": "刺伤" ]),

    ([ "action":
      "$N向前急进，手中$w圈转如虹，一招" HIM "「龙凤呈祥」" NOR "，罩向$n前胸",
      "lian":
      "$N向前急进，手中$w圈转如虹，一招" HIM "「龙凤呈祥」" NOR,
      "jibie": 48,
      "zhaoshi": HIM "「龙凤呈祥」" NOR,
      "sen": 7,
      "damage": 50,
      "parry": 50,
      "damage_type": "刺伤" ]),
  });
}

string query_weapon_type() {
  return "whip";
}
