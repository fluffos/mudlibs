inherit SKILL_LONG;

mapping *get_all_action()
{
    return ({
    ([	"action":
"$N将身一纵，跃在半空，一式「彩凤栖梧」，手中$w盘旋而下，鞭势灵动之至，击向$n$l",
        "lian"  :
"$N将身一纵，跃在半空，一式「彩凤栖梧」，手中$w盘旋而下，鞭势灵动之至",
        "jibie" :8,
        "zhaoshi":"「彩凤栖梧」",
        "sen"   :4,
        "dodge" :20,
        "damage":50,
        "damage_type":"内伤"   ]),

    ([  "action":
"$N沉肩滑步，手中$w一抖，一式「凤凰展翅」，迅捷无比地分打左右两侧，$n顿时左右支绌，慌了手脚",
        "lian"  :
"$N沉肩滑步，手中$w一抖，一式「凤凰展翅」，迅捷无比地分打左右两侧",
        "jibie" :16,
        "zhaoshi":"「凤凰展翅」",
        "sen"   :6,
        "dodge" :10, 
        "parry" :20,
        "damage":60,
        "damage_type":"刺伤"    ]),

    ([  "action":
"$N将内力注入$w，蓦地使出一式「蛟龙戏凤」，$w矫夭飞舞，直如神龙破空一般抽向$n",
        "lian"  :
"$N将内力注入$w，蓦地使出一式「蛟龙戏凤」，$w矫夭飞舞，直如神龙破空一般",
        "jibie" :24,
        "zhaoshi":"「蛟龙戏凤」",
        "sen"   :6,
        "dodge" :20,
        "damage":54,
        "damage_type":"内伤"    ]),

    ([  "action":
"$N一声清啸，手中$w一招「龙飞凤舞」，划出漫天鞭影铺天盖地地向$n卷来，势道猛烈之极",
        "lian"  :
"$N一声清啸，手中$w一招「龙飞凤舞」，划出漫天鞭影铺天盖地",
        "jibie" :32,
        "zhaoshi":"「龙飞凤舞」",
        "sen"   :5,
        "dodge" :40,
        "damage":60,
        "damage_type":"淤伤"    ]),

    ([  "action":
"$N面露微笑跨前一步，右手$w轻扬，缓缓使出一式「龙凤呈祥」，鞭势平和中正，不带丝毫霸气",
        "lian"  :
"$N面露微笑跨前一步，右手$w轻扬，缓缓使出一式「龙凤呈祥」，鞭势平和中正，不带丝毫霸气",
        "jibie" :40,
        "sen"   :8,
        "zhaoshi":"「龙凤呈祥」",
        "damage":65,
        "parry" :60,      
        "damage_type":"刺伤"   ]),
});
}

string query_weapon_type()
{
    return "whip";
}

