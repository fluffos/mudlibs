inherit SKILL_SHORT;

mapping *get_all_action() {
  return ({
    ([ "action": "$N手中$w抡动如飞，锤势连绵不断，一招［生生不息］，暴雨般向$n倾泻而去！",
      "lian": "$N手中$w抡动如飞，锤势连绵不断，一招［生生不息］，暴雨般倾泻而去！",
      "zhaoshi": "「生生不息」",
      "jibie": 10,
      "sen": 3,
      "damage": 15,
      "damage_type": "瘀伤"
    ]),
    ([ "action": "$N激进如飞，身影忽隐忽现，一招［明晦隐现］，手中的$w却早到$n的眼前。",
      "lian": "$N激进如飞，身影忽隐忽现，一招［明晦隐现］。",
      "zhaoshi": "「明晦隐现」",
      "jibie": 20,
      "sen": 3,
      "damage": 20,
      "damage_type": "刺伤"
    ]),
    ([ "action": "$N手中$w舞动，一招［雷动九天］挟着震天的撞击之声，猛砸$n的$l。",
      "lian": "$N手中$w舞动，一招［雷动九天］挟着震天的撞击之声。",
      "zhaoshi": "「雷动九天」",
      "jibie": 30,
      "sen": 3,
      "damage": 25,
      "damage_type": "瘀伤"
    ]),
    ([ "action": "$N手中的$w一转，一招［无中生有］从四面八方盖向$n的$l",
      "lian": "$N手中的$w一转，一招［无中生有］",
      "zhaoshi": "「无中生有」",
      "jibie": 40,
      "sen": 3,
      "damage": 30,
      "damage_type": "刺伤"
    ]),
    ([ "action": "$N一抖手中的$w，一招［我法俱空］锤影漫天飞舞，虚虚实实的挥向$n的$l",
      "lian": "$N一抖手中的$w，一招［我法俱空］锤影漫天飞舞，虚虚实实",
      "zhaoshi": "「我法俱空」",
      "jibie": 50,
      "sen": 3,
      "damage": 35,
      "damage_type": "瘀伤"
    ]),
  });
}

string query_weapon_type() {
  return "hammer";
}
