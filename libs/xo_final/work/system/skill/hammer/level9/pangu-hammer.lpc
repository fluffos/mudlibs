inherit SKILL_SHORT;

mapping *get_all_action() {
  return ({
    ([ "action": "$N左手单臂抡起$w，一招「开山」，夹杂着阵阵风声向$n$l砸去",
      "lian": "$N左手单臂抡起$w，一招「开山」，夹杂着阵阵风声砸去",
      "zhaoshi": "「开山」",
      "jibie": 10,
      "sen": 3,
      "damage": 15,
      "damage_type": "瘀伤"
    ]),
    ([ "action": "$N将手中$w划出一道半弧，一式「断岳」便如流星坠地，直轰$n",
      "lian": "$N将手中$w划出一道半弧，一式「断岳」便如流星坠地",
      "zhaoshi": "「断岳」",
      "jibie": 20,
      "sen": 3,
      "damage": 20,
      "damage_type": "刺伤"
    ]),
    ([ "action": "突然间$N手中$w挟着无上劲力，一招「劈天」施出，飞砍向$n而去",
      "lian": "突然间$N手中$w挟着无上劲力，一招「劈天」施出，飞砍而去",
      "zhaoshi": "「劈天」",
      "jibie": 30,
      "sen": 3,
      "damage": 25,
      "damage_type": "瘀伤"
    ]),
    ([ "action": "$N嗔目大喝，施一招「分海」，$w在劲力推动之下，向$n缓缓压来",
      "lian": "$N嗔目大喝，施一招「分海」，$w在劲力推动之下，缓缓压来",
      "zhaoshi": "「分海」",
      "jibie": 40,
      "sen": 3,
      "damage": 30,
      "damage_type": "刺伤"
    ]),
    ([ "action": "$N紧握$w，那势「还虚」的劲力便如同排山倒海般朝$n飞旋而出",
      "lian": "$N紧握$w，那势「还虚」的劲力便如同排山倒海般飞旋而出",
      "zhaoshi": "「还虚」",
      "jibie": 50,
      "sen": 3,
      "damage": 35,
      "damage_type": "瘀伤"
    ]),
    ([ "action": "$N高举$w，那势「破衲」的劲力便如同排山倒海般朝$n飞旋而出",
      "lian": "$N高举$w，那势「破衲」的劲力便如同排山倒海般飞旋而出",
      "zhaoshi": "「破衲」",
      "jibie": 60,
      "sen": 3,
      "damage": 40,
      "damage_type": "刺伤"
    ]),
    ([ "action": "$N反转$w，那势「克己」的劲力便如同排山倒海般朝$n飞旋而出",
      "lian": "$N反转$w，那势「克己」的劲力便如同排山倒海般飞旋而出",
      "zhaoshi": "「克己」",
      "jibie": 70,
      "sen": 4,
      "damage": 55,
      "damage_type": "瘀伤"
    ]),
  });
}

string query_weapon_type() {
  return "hammer";
}
