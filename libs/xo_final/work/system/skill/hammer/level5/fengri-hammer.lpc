#include <ansi.h>

inherit SKILL_SHORT;

mapping *get_all_action() {
  return ({
    ([ "action": "$N手中$w一转，卷着一股强劲的" + BLINK "" + HIR "[炎炎烈日]" NOR "之火烧向$n的$l，
这一下又稳又猛又烈，势大力狠，眼见就到了$n身前",
      "lian": "$N手中$w一转，卷着一股强劲的" + BLINK "" + HIR "[炎炎烈日]" NOR "之火，
这一下又稳又猛又烈，势大力狠",
      "zhaoshi": BLINK "" + HIR "[炎炎烈日]" NOR,
      "jibie": 10,
      "sen": 3,
      "damage": 15,
      "damage_type": "瘀伤"
    ]),
    ([ "action": "$N双手一紧，手中$w夹带着" + BLINK "" + HIR "[封日]" NOR "般的威力，劈头盖脸地就向$n砸了过去",
      "lian": "$N双手一紧，手中$w夹带着" + BLINK "" + HIR "[封日]" NOR "般的威力，劈头盖脸地就砸了过去",
      "zhaoshi": BLINK "" + HIR "[封日]" NOR,
      "jibie": 20,
      "sen": 3,
      "damage": 20,
      "damage_type": "刺伤"
    ]),
    ([ "action": "$N将$w高举过肩，蓄紧力发，对准$n的$l发出" + BLINK "" + HIY "[烈日之光]" NOR "",
      "lian": "$N将$w高举过肩，蓄紧力发，发出" + BLINK "" + HIY "[烈日之光]" NOR "",
      "zhaoshi": BLINK "" + HIY "[烈日之光]" NOR,
      "jibie": 30,
      "sen": 3,
      "damage": 25,
      "damage_type": "瘀伤"
    ]),
    ([ "action": "$N身走轻灵，手中$w忽上忽下，甩出" + BLINK "" + HIY "[熊熊火焰]" NOR "令人捉摸不清去路，
就在$n一恍惚间，“唰”地砸向$n的$l",
      "lian": "$N身走轻灵，手中$w忽上忽下，甩出" + BLINK "" + HIY "[熊熊火焰]" NOR "令人捉摸不清去路",
      "zhaoshi": BLINK "" + HIY "[熊熊火焰]" NOR,
      "jibie": 40,
      "sen": 3,
      "damage": 30,
      "damage_type": "刺伤"
    ]),
    ([ "action": "$N趁与$n错身之时，倒转$w，锤柄砸向$n，
这一下如" + BLINK "" + HIR "[烈火]" NOR "，悄无声息的射上了$n的$l",
      "lian": "$N倒转$w，锤柄如" + BLINK "" + HIR "[烈火]" NOR "，悄无声息的射上",
      "zhaoshi": BLINK "" + HIR "[烈火]" NOR,
      "jibie": 50,
      "sen": 3,
      "damage": 35,
      "damage_type": "瘀伤"
    ]),
    ([ "action": "$N手持$w对着" + BLINK "" + HIR "[炎日]" NOR "画了一个无形大圈，卷的周围沙土尘扬，
趁$n不能辨物之时，手中$w斜斜地封向$n的$l",
      "lian": "$N手持$w对着" + BLINK "" + HIR "[炎日]" NOR "画了一个无形大圈，卷的周围沙土尘扬",
      "zhaoshi": BLINK "" + HIR "[炎日]" NOR,
      "jibie": 60,
      "sen": 3,
      "damage": 40,
      "damage_type": "刺伤"
    ]),
    ([ "action": "$N一声长啸，大锤直封$n，此招看似简单、看似无力，但是力道无穷浑厚，
相传源自盘古开天时所用的" + BLINK "" + HIW "[破烈日]" NOR "无极招数。",
      "lian": "$N一声长啸，大锤直封，此招看似简单、看似无力，但是力道无穷浑厚，
相传源自盘古开天时所用的" + BLINK "" + HIW "[破烈日]" NOR "无极招数。",
      "zhaoshi": BLINK "" + HIW "[破烈日]" NOR,
      "jibie": 70,
      "sen": 4,
      "damage": 55,
      "damage_type": "瘀伤"
    ]),
  });
}

string query_weapon_type() {
  return "hammer";
}
