inherit SKILL_SHORT;

mapping *get_all_action() {
  return ({
    ([ "action": "$N手中$w一转，卷着一股强劲的风力挥向$n的$l，
这一下又急又猛，势大力狠，眼见就到了$n身前",
      "lian": "$N手中$w一转，卷着一股强劲的风力，
这一下又急又猛，势大力狠",
      "zhaoshi": "「天乾锤」",
      "jibie": 10,
      "sen": 3,
      "damage": 15,
      "damage_type": "瘀伤"
    ]),
    ([ "action": "$N双手一震，手中$w夹带着闷雷般的响声，劈头盖脸地就向$n砸了过去",
      "lian": "$N双手一震，手中$w夹带着闷雷般的响声，劈头盖脸地砸了过去",
      "zhaoshi": "「地坤锥」",
      "jibie": 20,
      "sen": 3,
      "damage": 20,
      "damage_type": "刺伤"
    ]),
    ([ "action": "$N将$w高举过肩，蓄紧力发，对准$n的$l发出雷霆一击",
      "lian": "$N将$w高举过肩，蓄紧力发，发出雷霆一击",
      "zhaoshi": "「泽兑锤」",
      "jibie": 30,
      "sen": 3,
      "damage": 25,
      "damage_type": "瘀伤"
    ]),
    ([ "action": "$N身走轻灵，手中$w忽上忽下，令人捉摸不清去路，
就在$n一恍惚间，“唰”地砸向$n的$l",
      "lian": "$N身走轻灵，手中$w忽上忽下，令人捉摸不清去路",
      "zhaoshi": "「山艮锥」",
      "jibie": 40,
      "sen": 3,
      "damage": 30,
      "damage_type": "刺伤"
    ]),
    ([ "action": "$N趁与$n错身之机，倒转$w，锤把戳向了$n，
这一下如白蛇吐芯，悄无声息的点上了$n的$l",
      "lian": "$N趁错身之机，倒转$w，锤把如白蛇吐芯",
      "zhaoshi": "「日离锤」",
      "jibie": 50,
      "sen": 3,
      "damage": 35,
      "damage_type": "瘀伤"
    ]),
    ([ "action": "$N紧握$w猛挥了个大圆，卷的周身长内沙土尘扬，
趁$n不能辨物之记，手中$w斜斜地砸向$n的$l",
      "lian": "$N紧握$w猛挥了个大圆，卷的周身长内沙土尘扬",
      "zhaoshi": "「月坎锥」",
      "jibie": 60,
      "sen": 3,
      "damage": 40,
      "damage_type": "刺伤"
    ]),
    ([ "action": "$N一声龙吟长啸,大锤直击$n右肩，此招毫无花巧,但胜在力道雄浑，
相传源自盘古开天时所用的混沌一破。",
      "lian": "$N一声龙吟长啸,大锤直击，此招毫无花巧,但胜在力道雄浑，
相传源自盘古开天时所用的混沌一破。",
      "zhaoshi": "「混沌一破」",
      "jibie": 70,
      "sen": 4,
      "damage": 55,
      "damage_type": "瘀伤"
    ]),
  });
}

string query_weapon_type() {
  return "hammer";
}
