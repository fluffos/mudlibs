#include <ansi.h>

int exert(object me, object target, int amount)
{
    if (me->is_busy())
         return notify_fail("你现在正忙着呢。\n");    
    if(!target||target==me)
         return notify_fail("你要把内力传给谁?\n");   
    if( me->query_jibie("duanshi-xinfa") < 250 )
         return notify_fail("你的段氏心法等级不够，传给别人内力有害自身。\n");    
    if(!me->query_team()||member_array(target,me->query_team())==-1)
         return notify_fail("你只能给和自己组队的人传输内力。\n");                    
    if( me->query("force") < 2000 )
         return notify_fail("你的内力不够浑厚,无法给别人输送内力。\n");
    if(!amount||amount<1000)
        amount=1000;                  
    me->add("force",-amount);
    target->add("force",amount/2);
    if (target->query("force")>target->query("max_force")*3)
    target->set("force",target->query("max_force")*3);    
    message_vision(HIM"$N正全神贯注的给$n灌输内力!\n"NOR, me,target);
    me->start_busy(amount/500);
    return 1;
}
