inherit SKILL_UNARMED;

mapping *get_all_action() {
  return ({
    ([ "action": "$N使出一招「闲过信陵饮」，双拳一错，幻出数十个拳影向$n全身罩去",
      "lian": "$N使出一招「闲过信陵饮」，双拳一错，幻出数十个拳影向假象敌全身罩去",
      "zhaoshi": "「闲过信陵饮」",
      "sen": 8,
      "parry": 20,
      "dodge": 20,
      "jibie": 0,
      "wound": 60,
      "damage": 90,
      "damage_type": "瘀伤"
    ]),
    ([ "action": "$N一招「五狱倒为轻」，腾空而起，和身双拳向$n击去",
      "lian": "$N一招「五狱倒为轻」，腾空而起，和身双拳向假象敌击去",
      "zhaoshi": "「五狱倒为轻」",
      "damage": 105,
      "wound": 70,
      "sen": 9,
      "parry": 20,
      "dodge": 20,
      "jibie": 30,
      "damage_type": "瘀伤"
    ]),
    ([ "action": "$N使出，「眼花耳热后」一声大喝，趁$n未有反应，双拳分袭$n的胸腹",
      "lian": "$N使出，「眼花耳热后」一声大喝，双拳分袭假象敌的胸腹",
      "zhaoshi": "「眼花耳热后」",
      "sen": 10,
      "jibie": 60,
      "parry": 30,
      "dodge": 20,
      "damage": 110,
      "damage_type": "瘀伤"
    ]),
    ([ "action": "$N双拳一错，使出「千秋二壮士」，对准$n连续击出，",
      "lian": "$N双拳一错，使出「千秋二壮士」，对准假象敌连续击出，",
      "zhaoshi": "「千秋二壮士」",
      "damage": 125,
      "wound": 80,
      "sen": 8,
      "parry": 30,
      "dodge": 20,
      "jibie": 100,
      "damage_type": "瘀伤"
    ]),
    ([ "action":
      "$N鼓起全部气力于左拳，只听见骨节爆响的声音，一招「纵死侠骨香」迅猛地向$n击去",
      "lian":
      "$N鼓起全部气力于左拳，只听见骨节爆响的声音，一招「纵死侠骨香」迅猛地击去",
      "zhaoshi": "「纵死侠骨香」",
      "sen": 10,
      "jibie": 120,
      "parry": 10,
      "dodge": 40,
      "damage": 125,
      "wound": 85,
      "damage_type": "瘀伤"
    ]),
    ([ "action": "$N使出「持觞劝侯嬴 」，化出数道身形同时击向$n的$l",
      "lian": "$N使出「持觞劝侯嬴 」，化出数道身形同时击出",
      "zhaoshi": "「持觞劝侯嬴 」",
      "sen": 8,
      "jibie": 140,
      "damage": 130,
      "wound": 90,
      "parry": 10,
      "dodge": 25,
      "damage_type": "瘀伤"
    ]),
  });
}

string *get_all_parry_msg() {
  return ({
    "$n一招「持觞劝侯嬴 」，双掌翻舞，$N眼前一花，失去了$n的踪影",
    "$n两手握拳，一招「千秋二壮士」，格开了$N的一击",
    "但见$n一招「闲过信陵饮」，跟上一步，化开了$N的攻势",
  });
}
