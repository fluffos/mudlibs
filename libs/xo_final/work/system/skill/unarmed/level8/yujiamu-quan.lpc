         "damage": 110,
         "damage_type":  "瘀伤"
    ]),
    ([   "action": "$N神形怪异，使一招"HIC"「嗔恚」"NOR"，双拳上下击向$n的$l",
         "lian"  :"$N神形怪异，使一招"HIC"「嗔恚」"NOR"，双拳上下击出",
         "zhaoshi" : HIC"「嗔恚」"NOR,
