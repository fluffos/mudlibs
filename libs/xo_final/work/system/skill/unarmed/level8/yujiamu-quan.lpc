         "dodge" : 20,
         "jibie":    100,
         "damage_type":  "瘀伤"
    ]),
    ([   "action": 
"$N使出一招"HIC"「静寂」"NOR"，双拳交错，缓缓击出，劲气直指$n的$l",
         "lian"  : 
"$N使出一招"HIC"「静寂」"NOR"，双拳交错，缓缓击出，劲气直指",
         "zhaoshi" : HIC"「静寂」"NOR,
         "sen"  : 10,
         "jibie": 120,
         "parry" : 10,
         "dodge" : 40,
         "damage": 125,
         "wound" : 85,
         "damage_type":  "瘀伤"
    ]),
    ([   "action":"$N微微一笑，使出一式"HIC"「妙音」"NOR"，双拳前后击出，直取$n的左胸",
         "lian" :"$N微微一笑，使出一式"HIC"「妙音」"NOR"，双拳前后击出",
         "zhaoshi" : HIC"「妙音」"NOR,
