#include <ansi.h>

inherit SKILL_UNARMED;

mapping *get_all_action()
{
    return ({
    ([   "action"  :"$N并举双拳，使出一招"HIC"「灌顶」"NOR"，当头砸向$n的$l",
         "lian"    :"$N并举双拳，使出一招"HIC"「灌顶」"NOR"，当头砸下",
         "zhaoshi" : HIC"「灌顶」"NOR,
