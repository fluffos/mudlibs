inherit SKILL_UNARMED;

mapping *get_all_action() {
  return ({
    ([ "zhaoshi": "「黑虎偷心」",
      "action":
      "$N使出一招「黑虎偷心」，中宫直入，一拳直击$n中腹",
      "lian":
      "$N使出一招「黑虎偷心」，中宫直入，一拳直击出去",
      "jibie": 5,
      "limb": "腹部",
      "sen": 2,
      "damage": 25,
      "damage_type": "瘀伤"
    ]),
    ([ "zhaoshi": "「钟馗斗鬼」",
      "action":
      "$N弹腿侧身，一招「钟馗斗鬼」，左掌右拳，分别击向$n左肋之下",
      "lian":
      "$N弹腿侧身，一招「钟馗斗鬼」，左掌右拳，分别击出",
      "jibie": 10,
      "limb": "左肋",
      "sen": 2,
      "damage": 30,
      "damage_type": "瘀伤"
    ]),
    ([ "zhaoshi": " 「乾坤定」",
      "action":
      "$N双腿微屈，右掌挥出，击向$n$l，步履极为凝重",
      "lian":
      "$N双腿微屈，右掌挥出，使出一招「乾坤定」，步履极为凝重",
      "jibie": 15,
      "sen": 2,
      "damage": 30,
      "damage_type": "瘀伤"
    ]),
    ([ "zhaoshi": "「天下归一」",
      "action":
      "$N左掌划了个圈子，踏上一步，击向$n$l..",
      "lian":
      "$N左掌划了个圈子，踏上一步，使出一招「天下归一」.",
      "jibie": 20,
      "sen": 2,
      "damage": 35,
      "damage_type": "瘀伤"
    ]),
    ([ "zhaoshi": "「尉迟立马」",
      "action":
      "$N飞身回掌，一招「尉迟立马」，左脚踢向$n后腰.",
      "lian":
      "$N飞身回掌，一招「尉迟立马」，左脚反身踢出。.",
      "jibie": 25,
      "limb": "后腰",
      "damage": 30,
      "sen": 3,
      "damage_type": "瘀伤"
    ]),
    ([ "zhaoshi": "「张飞嗔目」",
      "action":
      "$N大喝一声，双掌齐发，自上而下地拍向$n头顶，正是一招「张飞嗔目」",
      "lian":
      "$N大喝一声，双掌齐发，自上而下地拍出，正是一招「张飞嗔目」",
      "jibie": 30,
      "limb": "头顶",
      "sen": 2,
      "damage": 40,
      "damage_type": "瘀伤"
    ]),
    ([ "zhaoshi": " 「周处伏蛟」",
      "action":
      "$N一招「周出伏蛟」，左手揽过$n右臂，右拳向$n肩头拍了下去",
      "lian":
      "$N一招「周出伏蛟」，左手内揽，右手握拳，直劈下方",
      "jibie": 35,
      "limb": "肩头",
      "sen": 2,
      "damage": 40,
      "damage_type": "瘀伤"
    ]),
    ([ "zhaoshi": "「围魏救赵」",
      "action":
      "$N一招「围魏救赵」，不顾$n的攻势，双手直击$n头顶",
      "lian":
      "$N一招「围魏救赵」，双手直击前方",
      "jibie": 40,
      "limb": "头顶",
      "sen": 2,
      "damage": 45,
      "damage_type": "瘀伤"
    ]),
    ([ "zhaoshi": "「独劈华山」",
      "action":
      "$N开掌吐气，大喝一声，踏上一步，右掌作刀，直劈$n上身",
      "lian":
      "$N开掌吐气，大喝一声，踏上一步，右掌作刀，直劈不回，正是一招「独劈华山」",
      "jibie": 45,
      "limb": "前胸",
      "sen": 3,
      "damage": 50,
      "damage_type": "瘀伤"
    ]),
  });
