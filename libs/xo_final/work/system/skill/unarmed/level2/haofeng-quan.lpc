([  "action":
"$N挺身卓立，一式「人闻清钟」，右拳上冲，左掌向$n的小腹按去",
    "lian":
"$N身形挺得笔直，一式「人闻清钟」，右拳高举，左掌奋力按出",
    "jibie"     :8,   
    "limb":"小腹",
    "zhaoshi":"「人闻清钟」",
    "sen"       :3,
    "damage"   :30,
    "damage_type":	"瘀伤"
]),
([  "action":
"$N身形前倾，使出「落落元宗」，右掌护胸，左手向$n的$l捣出",
    "lian":
"$N身形前倾，右掌护胸，左手捣出，正是「落落元宗」！",
    "jibie"     :16,   
    "zhaoshi":"「落落元宗」",
    "sen"       :2,
    "dodge"     :10,
	"damage"     :40,
	"damage_type":	"瘀伤"
]),
([  "action":
"$N使出浩风拳「太华夜碧」，脚下步伐窜动，两手在胸前交叉，右掌攻向$n$l",
    "lian":
"$N使出浩风拳「太华夜碧」，脚下步伐窜动，两手在胸前交叉，右掌攻向$n$l",
    "jibie"     :24, 
    "zhaoshi":"「太华夜碧」",
    "sen"       :3,
	"dodge"     :0,
	"parry"     :10,
	"damage"    :40,
	"damage_type":	"瘀伤"
]),
([  "action":
"$N使出一招「虚伫神素」，对准$n当胸一拳，左腿屈向前伸，踏上一步",
    "lian":
"$N使出一招「虚伫神素」，当胸一拳，左腿屈向前伸，踏上一步",
    "jibie"     :32, 
    "zhaoshi":"「虚伫神素」",
    "sen"       :2,
    "parry"     :10,
    "damage"     :55,
    "damage_type":	"瘀伤"
]),
([  "action":
"$N使出「月出东」，左掌凝力发出，右拳一转，后发先至",
    "lian":
"$N使出「月出东」，左掌凝力发出，右拳一转，后发先至",
    "zhaoshi":"「月出东」",
    "jibie"     :40,
    "sen"       :3,
    "dodge"     :10,
    "parry"     :0,
    "damage"     :30,
    "damage_type":	"瘀伤"
]),
([  "action" :
"$N卓立不动，一式「手把芙蓉」，上身微侧，一拳从中路推出，击向$n$l",
	"lian" :
"$N卓立不动，一式「手把芙蓉」，上身微侧，一拳从中路推出",
    "jibie"     :48, 
    "zhaoshi":"「手把芙蓉」",
