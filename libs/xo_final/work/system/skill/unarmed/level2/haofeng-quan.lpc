string *get_all_parry_msg()
{
    return ({
        "$n不退不让，使出「脱然畦封」，左掌按出，硬接$N的来势",
        "$n以第二势「虚伫神素」，右掌接住$N的来势，左手一连三拳，逼得$N退出三步",
        "$n一招「落落元宗」，步下一错，散出一地人影，逃得满地都是，不可收拾",
        "$n一招「虚伫神素」，身随拳走，恰恰让过$N的攻势",
        "$n一招「太华夜碧」，单拳护身，足成独立，另一只手挥向$N的右手",
        "$n长啸声中，一招「人闻清钟」，身若游龙，$N的攻势顿时落在空处",
    });
}

