inherit SKILL_UNARMED;

mapping *get_all_action()
{
    return ({
    ([  "action": "$N双掌合什，使出一招「灵山礼佛」，一拜而下，划向$n的$l",
        "lian"  : "$N双掌合什，使出一招「灵山礼佛」，一拜而下",
        "zhaoshi":"「灵山礼佛」",
        "jibie"     : 7,
        "sen"       : 2,
        "damage"    :20,
        "damage_type" : "瘀伤"
    ]),
    ([  "action": "$N使出一招「山门护法」，身形微斜，双掌推向$n的$l",
        "lian"  : "$N默想敌人的方位，使出一招「山门护法」，双掌并力推出",
        "zhaoshi":"「山门护法」",
        "jibie"     :14,
        "sen"       : 3,
    	"damage"    :20,
        "damage_type" : "瘀伤"
    ]),
    ([  "action": "$N使出韦陀掌「恒河入海」，猱身而上，双掌自左向右划向$n身前三处大穴",
        "lian"  : "$N猱身而上，双掌划出，正是「韦陀掌」第三式「恒河入海」",
        "zhaoshi":"「恒河入海」",
        "jibie"     :20,
        "sen"       : 2,
    	"dodge"     : 5,
        "damage"    :20,
    	"damage_type" : "瘀伤"
    ]),
    ([  "action": "$N双掌先沉再起，自下而上，使出「万仞天开」，对准$n的头颈撩去",
        "lian"  : "$N双掌先沉再起，自下而上翻掌托天，正是「韦陀掌」第四式「万仞天开」",
        "zhaoshi":"「万仞天开」",
        "jibie"     :28,
        "sen"       : 2,
        "damage"    :35,
        "damage_type" : "瘀伤"
    ]),
    ([  "action": "$N使出「立雪断臂」，左掌下按，右掌划向左肩，身前三尺尽笼在掌势之中",
        "lian"  : "$N左掌下按，右掌划向左肩，试图将身前三尺笼在掌势之中",
        "zhaoshi":"「立雪断臂」",
        "jibie"     :35,
        "sen"       : 3,
        "dodge"     :10,
        "damage"    :30,
        "damage_type" : "瘀伤"
    ]),
    ([  "action": "$N前腿踢出，后腿脚尖点地，一式「横空出世」，二掌直出，攻向$n的上中下三路",
    	"lian"  : "$N前腿踢出，后腿脚尖点地，一式「横空出世」，二掌直出",
        "zhaoshi":"「横空出世」",
        "jibie"     :45,
        "sen"       : 3,
        "parry"     :10,
        "damage"    :30,
    	"damage_type" : "内伤"
    ]),
    ([  "action": "$N左掌划一半圆，一式「长虹贯日」，右掌斜穿而出，疾拍$n的胸前大穴",
    	"lian"  : "$N左掌划一半圆，右掌奋力穿出，「长虹贯日」",
        "zhaoshi":"「长虹贯日」",
        "jibie"     :50,
        "sen"       : 2,
    	"parry"     :10,
        "damage"    :40,
        "damage_type" : "内伤"
    ]),
    ([  "action": "$N使一式「云断秦岭」，右掌上引，左掌由后而上一个甩劈，斩向$n的$l",
    	"lian"  : "$N使一式「云断秦岭」，右掌上引，左掌由后而上一个甩劈",
        "zhaoshi":"「云断秦岭」",
        "jibie"     :55,
        "sen"       : 2,
        "damage"    :35,
        "damage_type" : "劈伤"
    ]),
    ([  "action": "$N吐气扬声，一招「风雷交作」，掌分阴阳，交叠翻转，一变再变，拍向$n的$l",
        "lian"  : "$N吐气扬声，一招「风雷交作」，掌分阴阳，并力推出",
        "zhaoshi":"「风雷交作」",
        "jibie"     :60,
        "sen"       : 3,
        "parry"     :10,
    	"damage"    :50,
        "damage_type" : "瘀伤"
    ]),
});
}

string *get_all_parry_msg()
{
    return ({
        "$n双掌合什，一招「灵山礼佛」，封住中路",
        "$n使一招「恒河入海」，将$N的攻势带向右侧",
        "$n使一招「山门护法」，双掌翻出，硬接$N的攻势",
        "$n一招「长虹贯日」，攻敌所必救。$N不得不抽招换式，先图自保",
    });
}

int valid_learn(object me)
{
    if( (int)me->query("max_force") < 100 )
    {
        return notify_fail("你的内力太弱，无法练习韦陀掌。\n");
    }

    return ::valid_learn(me);
}

