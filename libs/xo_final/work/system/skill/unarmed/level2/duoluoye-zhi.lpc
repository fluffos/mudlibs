    "zhaoshi": "「出家证果」",
    "damage" : 20,
    "parry"  : 5,
    "dodge"  : 5,
    "jibie"  : 0,
    "sen"    : 6,
    "damage_type" : "刺伤",
]),
([  "action" : "$N身形微闪，幻化出数个身影，双手十指如电光石火般直插$n的\n"
                        "$l，一式「断欲绝求」，招式之快，令人叹为观止",
    "lian"   : "$N身形微闪，幻化出数个身影，双手十指如电光石火般向前直插而出\n"
                        "一式「断欲绝求」，招式之快，令人叹为观止",
    "zhaoshi": "「断欲绝求」",
    "damage" : 30,
    "parry"  : 10,
    "dodge"  : 10,
    "jibie"  : 10,
    "sen"    : 7,
    "damage_type" : "刺伤",
]),
([  "action" : "$N左手虚划半圆罩向$n胸前三尺之内，右手轻撮，疾点向$n的$l，正是一式\n"
                        "「割爱去贪」",  
    "lian"   : "$N左手虚划半圆罩向前方，右手撮成鹤指从中疾穿而出，体会「割爱去贪」\n"
                        "内含的佛家禅意",
    "zhaoshi": "「割爱去贪」",
    "damage" : 40,
    "parry"  : 20,
    "dodge"  : 20,
    "jibie"  : 25,
    "sen"    : 6,
    "damage_type" : "刺伤",
]),
([  "action" : "$N轻提一口丹田气，已从头顶越向$n身后，趁$n惊惶失措，看也不看向背后连点\n"
                        "三指，一式「明来暗谢」令$n退避不及",
    "lian"   : "$N转一式「转重令轻」，轻提一口丹田气，向上跃起，随手向后点出三指。\n"
                        "出手轻柔，正是「明来暗谢」一式的精要所在",
    "zhaoshi": "「明来暗谢」",
    "damage" : 50,
    "parry"  : 30,
    "dodge"  : 0,
    "jibie"  : 35,
    "sen"    : 7,
    "damage_type" : "刺伤",
]),
([  "action" : "$N口宣一声佛号，以一式「忍恶无嗔」，右手食指指地，斜斜向上\n"
                        "勾出，指气如剑，直指$n$l",
    "lian"   : "$N口宣一声佛号，以一式「忍恶无嗔」，右手食指指地，斜斜向上勾出",
    "zhaoshi": "「忍恶无嗔」",
    "damage" : 60,
    "parry"  : 0,
    "dodge"  : 30,
    "jibie"  : 50,
    "sen"    : 6,
    "damage_type" : "刺伤",
]),
([  "action" : "$N卖个破绽，待得$n来攻时，一手上引护胸，一手如莲花初绽，欲开却合\n"
                        "几道隐约的指影直射$n$l，却是一招妙绝精微的「恶还本身」",
    "lian"   : "$N一手上引护胸，一手如莲花初绽，欲开却合，几道隐约的指影直射出去，\n"
                        "却是一招妙绝精微的「恶还本身」",
    "zhaoshi": "「恶还本身」",
    "damage" : 70,
    "parry"  : 30,
    "dodge"  : 30,
    "jibie"  : 60,
    "sen"    : 8,
    "damage_type" : "刺伤",
]),
([  "action" : "$N对$n的攻式视若不见，使出一式「问道宿命」，身形如渊凝立，右手\n"
                    "拇指斜斜向$n$l捺去",
    "lian"   : "$N身形如渊凝立，右手拇指斜斜向外捺去，似已修得「问道宿命」一招\n"
                    "个中三味",
    "zhaoshi": "「问道宿命」",
    "damage" : 80,
    "parry"  : 40,
    "dodge"  : 0,
    "jibie"  : 75,
    "sen"    : 9,
    "damage_type" : "刺伤",
]),
([  "action" : "$N突地单足点地，身形疾转，双手交叉轮指如飞，丝丝白气向$n周身射去\n"
                        "正是「多罗叶指」的最后一式「生即有灭 」",
    "lian"   : "$N单足点地，身形疾转，双手交叉轮指如飞，丝丝白气向周遭射去，正是\n"
                        "「多罗叶指」的最后一式「生即有灭 」",
    "zhaoshi": "「生即有灭」",
    "damage" : 90,
    "parry"  : 40,
    "dodge"  : 40,
    "jibie"  : 90,
    "sen"    : 10,
    "damage_type" : "刺伤",
])
});
}

int valid_learn(object me)
{
    int budd_jibie,skill_jibie;

    budd_jibie = me->query_jibie("buddhism");
    skill_jibie = me->query_jibie("duoluoye-zhi");
    
    if ( 8*skill_jibie /15+ 40 > budd_jibie )
    {
        return notify_fail("你的佛学修为不够，强练绝技会伤及身体。\n");
    }

    if ( (int)me->query("max_force") < 250 )
    {
        return notify_fail("你的内力不够，没有办法练多罗叶指。\n");
    }

    return ::valid_learn(me);
}

