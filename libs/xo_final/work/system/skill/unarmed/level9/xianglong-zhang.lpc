string *get_all_parry_msg()
{
    return ({
        "$n不待回身，半招「神龙摆尾」，做势反劈。$N见这招势凶狠，不敢硬接，纵身避开",
        "只见$n左掌圆劲，右掌直推，挡在身前。一招纯是防御，却是在双方之间布了一道坚壁",
        "$n当下不敢怠慢，双掌当胸平推，将自己全身笼罩在掌力之下。守得稳若渊停岳峙，直无半点破绽",
        });
}

string *get_all_unarmed_msg()
{
    return ({
        "$p不待回身，半招「神龙摆尾」，做势反劈。$N见这招势凶狠，不敢硬接，纵身避开",
        "只见$p左掌圆劲，右掌直推，挡在身前。一招纯是防御，却是在双方之间布了一道坚壁",
        "$p当下不敢怠慢，双掌当胸平推，将自己全身笼罩在掌力之下。守得稳若渊停岳峙，直无半点破绽",
        });
}

