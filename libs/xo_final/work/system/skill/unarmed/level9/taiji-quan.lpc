string *get_all_parry_msg()
{
    return ({
         "$n眼见$N$w攻到，当即使出一招「揽雀尾」，右脚实，左脚虚，运起“挤”字诀，粘连粘随，右掌已搭住$N左腕，横劲发出。$N身不由主的向前一冲，跨出两步，方始站定",
         "不料$n双手一圈，如抱太极，一股雄浑无比的力道组成了一个旋涡，只带得$N在原地急转七八下",
         "$n「双风贯耳」，连消带打，双手成圆形击出，随即左圈右圈，一个圆圈跟着一个圆圈，大圈、小圈、平圈、立圈、正圈、斜圈，一个个太极圆圈发出，登时便套得$N跌跌撞撞，身不由主的立足不稳",
         "$n使出一招「云手」，左手高，右手低，一个圆圈已将$N$w套住",
         "$n觉气息微窒，当下一招「斜飞势」，将$N$w引偏",
         "$n吸一口气，体内真气流转，右掌挥出，一拒一迎，将$N的力道尽行碰了回去",
         "$n双掌一翻，使出一招「云手」，双掌柔到了极处，空明若虚，将$N$w的急劲尽数化去",
        "$n当即双掌一扬，迎着$w接去，待得手掌与$N$w将触未触之际，施出「揽雀尾式」，将$w轻轻拢住，脚下“金鸡独立式”，左足关地，右足悬空，全身急转，宛似一枚陀螺",
         "就在这电光石火的一瞬之间，$n身子一弓，正是「白鹤亮翅」的前半招，$N的劲力登时落空",
    });
}

string *get_all_unarmed_msg()
{
    return ({
         "$n眼见$N$w攻到，当即使出一招「揽雀尾」，右脚实，左脚虚，运起“挤”字诀，粘连粘随，右掌已搭住$N左腕，横劲发出。$N身不由主的向前一冲，跨出两步，方始站定",
         "不料$n双手一圈，如抱太极，一股雄浑无比的力道组成了一个旋涡，只带得$N在原地急转七八下",
         "$n「双风贯耳」，连消带打，双手成圆形击出，随即左圈右圈，一个圆圈跟着一个圆圈，大圈、小圈、平圈、立圈、正圈、斜圈，一个个太极圆圈发出，登时便套得$N跌跌撞撞，身不由主的立足不稳",
         "$n使出一招「云手」，左手高，右手低，一个圆圈已将$N$w套住",
         "$n觉气息微窒，当下一招「斜飞势」，将$N$w引偏",
         "$n吸一口气，体内真气流转，右掌挥出，一拒一迎，将$N的力道尽行碰了回去",
         "$n双掌一翻，使出一招「云手」，双掌柔到了极处，空明若虚，将$N$w的急劲尽数化去",
