inherit SKILL_UNARMED;

mapping *get_all_action() {
  return ({
    ([ "action": "$N双掌一错，一招「阳关三叠」幻出层层掌影奔向$n的$l",
      "lian": "$N双掌一错，一招「阳关三叠」幻出层层掌影",
      "dodge": 10,
      "parry": 25,
      "sen": 10,
      "jibie": 10,
      "zhaoshi": "「阳关三叠」",
      "damage": 60,
      "damage_type": "淤伤"
    ]),
    ([ "action": "$N暴喝一声，单掌猛然推出，一招「地久天长」强劲的掌风直扑$n的$l",
      "lian": "$N暴喝一声，单掌猛然推出，一招「地久天长」强劲的掌风直扑而出",
      "dodge": 30,
      "parry": 15,
      "sen": 11,
      "jibie": 17,
      "zhaoshi": "「地久天长」",
      "damage": 75,
      "damage_type": "淤伤"
    ]),
    ([ "action": "$N双掌纷飞，一招「金龙戏水」直取$n的$l",
      "lian": "$N双掌纷飞，一招「金龙戏水」",
      "dodge": 20,
      "parry": 35,
      "sen": 10,
      "jibie": 24,
      "zhaoshi": "「金龙戏水」",
      "damage": 80,
      "damage_type": "淤伤"
    ]),
    ([ "action": "$N按北斗方位急走，一招「万物复苏」，阵阵掌风无孔不入般地击向$n的$l",
      "lian": "$N按北斗方位急走，一招「万物复苏」，阵阵掌风无孔不入",
      "dodge": 5,
      "parry": 20,
      "sen": 12,
      "jibie": 31,
      "zhaoshi": "「万物复苏」",
      "damage": 68,
      "damage_type": "淤伤"
    ]),
    ([ "action": "$N回身错步，双掌平推，凝神聚气，一招「回光反照」拍向$n的$l",
      "lian": "$N回身错步，双掌平推，凝神聚气，一招「回光反照」",
      "dodge": 15,
      "parry": 30,
      "sen": 15,
      "jibie": 53,
      "zhaoshi": "「回光反照」",
      "damage": 120,
      "wound": 90,
      "damage_type": "淤伤"
    ]),
    ([ "action": "$N左掌立于胸前，右掌推出，一招「神光乍现」迅然击向$n$l",
      "lian": "$N左掌立于胸前，右掌推出，一招「神光乍现」迅然击出",
      "dodge": 24,
      "parry": 34,
      "sen": 11,
      "jibie": 42,
      "zhaoshi": "「神光乍现」",
      "limb": "后脑",
      "damage": 96,
      "wound": 60,
      "damage_type": "淤伤"
    ]),
    ([ "action": "$N使出「百里千长」，身形急进，快速向$n出掌攻击",
      "lian": "$N使出「百里千长」，身形急进，快速出掌攻击",
      "dodge": 21,
      "parry": 30,
      "sen": 14,
      "jibie": 65,
      "zhaoshi": "「百里千长」",
      "damage": 130,
      "wound": 90,
      "damage_type": "淤伤"
    ]),
    ([ "action": "$N一招「星游九天」，双掌虚虚实实的击向$n的$l",
      "lian": "$N一招「星游九天」，双掌虚虚实实",
      "dodge": 15,
      "parry": 30,
      "sen": 15,
      "jibie": 80,
      "zhaoshi": "「星游九天」",
      "damage": 140,
      "wound": 100,
      "damage_type": "淤伤"
    ]),
    ([ "action": "$N左掌画了个圈圈，右掌推出，一招「北斗易位」击向$n$l",
      "lian": "$N左掌画了个圈圈，右掌推出，一招「北斗易位」",
      "dodge": 21,
      "parry": 30,
      "sen": 14,
      "jibie": 100,
      "zhaoshi": "「北斗易位」",
      "damage": 150,
      "wound": 110,
      "damage_type": "淤伤"
    ]),
  });
}

string *get_all_parry_msg() {
  return ({
    "$n双掌上架，架住了$N的攻势",
    "$n双掌幻化出无数掌影，护住全身",
    "$n双掌交错，左右穿插翻飞，全力防住了$N的攻势",
    "$n身形急旋，向右闪开，左掌上架，档住了$N这一招"
  });
}

string *get_all_unarmed_msg() {
  return ({
    "$n双掌上架，架住了$N的攻势",
    "$n双掌幻化出无数掌影，护住全身",
    "$n双掌交错，左右穿插翻飞，全力防住了$N的攻势",
    "$n身形急旋，向右闪开，左掌上架，档住了$N这一招"
  });
}
