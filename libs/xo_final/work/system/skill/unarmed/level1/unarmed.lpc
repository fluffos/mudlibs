inherit SKILL_UNARMED;

mapping *get_all_action() {
  return ({
    ([ "action":
      "$N猛地向$n挥出一拳",
      "lian": "$N也不看方向，猛地挥出一拳，险些脱臼......",
      "jibie": 5,
      "sen": 1,
      "damage_type": "瘀伤"
    ]),
    ([ "action":
      "$N兜手揽步，右肘使劲向$n撞去.......",
      "lian":
      "$N兜手揽步，呼吸粗重，猛地向右一撞，险些摔倒......",
      "jibie": 20,
      "sen": 1,
      "damage_type": "瘀伤"
    ]),
    ([ "action":
      "$N晃右一步，左拳出击!!",
      "lian":
      "$N倒了倒步子，一拳向左挥出，体会着出招的路数.....",
      "jibie": 25,
      "sen": 1,
      "damage_type": "瘀伤"
    ]),
    ([ "action":
      "$N大喝一声，站稳马步，一拳打向$n的$l",
      "lian":
      "$N蹲下身子，站稳马步，辨准方向，「呼」地打出一拳......",
      "jibie": 30,
      "sen": 1,
      "damage_type": "瘀伤"
    ]),
    ([ "action":
      "$N双拳互扣，跨上一步，看准$n的动作，猛地向$p$l双拳齐出。。。。",
      "lian":
      "$N跨上一步，双拳互扣，先想了想部位，再慢慢挥拳出招，体会着用力的诀窍...",
      "jibie": 40,
      "sen": 1,
      "damage_type": "瘀伤"
    ]),
    ([ "action":
      "$N躲开$n的进攻，脚下移步换位，左手护胸，右手成拳，一拳向$n臀部捶去.....",
      "lian":
      "$N想好了对手的臀部在什么地方，左手护胸，右手一拳挥出，不免有一种大功告成的快感...",
      "jibie": 47,
      "limb": "臀部",
      "sen": 1,
      "damage_type": "瘀伤"
    ]),
    ([ "action":
      "$N一招「马步横踢」，右腿蜷，左脚铲，左手微拳，向$n腹部击去....",
      "lian":
      "$N摆起「马步横踢」的架式，右腿蜷，左脚铲，重心左移，带动左拳挥出。。。。",
      "jibie": 55,
      "sen": 1,
      "damage_type": "瘀伤"
    ]),
    ([ "action":
      "$N大喝一声，跳起有二尺来高，左腿踢向$n肋下，同时双拳挥出，直击$n面门...",
      "lian":
      "$N大喝一声，纵身而起，二拳一腿同时攻出，尽力保持着身体的平衡......",
      "jibie": 64,
      "limb": "面门",
      "sen": 1,
      "damage_type": "瘀伤"
    ]),
  });
