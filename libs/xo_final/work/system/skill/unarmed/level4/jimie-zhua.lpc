string *get_all_parry_msg()
{
    return ({
        "$n左脚向左成撇步站定，左掌顺势向前以一式「」圈手封出，挡住了$N的一招",
        "$n顺势收左手扣腰，右掌以封手封向左方，化$N的攻势于无形",
        "却见$n身形不变，收左右手向上撩手，轻而易举的挡开了$N这招",
        "但$n不退反进，一式「」随即身体转正，右手向右甩出，以刁手向$N刁出，迫得$N中途收招",
    });
}

int valid_learn(object me)
{
    int budd_jibie,skill_jibie;

    budd_jibie = me->query_jibie("buddhism");
    skill_jibie = me->query_jibie("jimie-zhua");

    if ( 14*skill_jibie /25+ 60 > budd_jibie )
    {
        return notify_fail("你的佛学修为不够，强练绝技会伤及身体。\n");
    }

    if ( (int)me->query("max_force") < 400 )
    {
        return notify_fail("你的内力不够，没有办法练寂灭抓。\n");
    }

    return ::valid_learn(me);
}

