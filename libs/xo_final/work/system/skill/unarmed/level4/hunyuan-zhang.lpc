inherit SKILL_UNARMED;

mapping *get_all_action()
{
    return ({
    ([  "action": "$N挺身卓立，一式伏虎拳起手势「明知山有虎」，右拳上冲，左掌向$n的小腹按去",
        "lian"  : "$N身形挺得笔直，有如一根标枪一般，右拳高举，左掌奋力按出",
        "zhaoshi":"「明知山有虎」",
        "limb"  :"小腹",
        "jibie" :4,
        "sen"   :3,
        "dodge" :10,
        "parry" :10,
        "damage":60,
        "wound" :25,
        "damage_type" : "瘀伤"
    ]),
    ([  "action": "$N身形前倾，使出伏虎拳第二势「却向虎山行」，右掌护胸，左手一连三拳，尽向$n的$l捣出",
        "lian"  : "$N身形前倾，右掌护胸，左手一连捣出三拳，正是伏虎拳第二势「却向虎山行」",
        "zhaoshi":"「却向虎山行」",
        "jibie" :16,
        "sen"   :4,
        "dodge" :10,
        "parry" :20,
        "damage":65,
        "wound" :30,
        "damage_type" : "瘀伤"
    ]),
    ([  "action": "$N使出伏虎拳「狐鹿皆遁走」，步下一错，散出一溜人影，同时攻向$n$l",
        "lian"  : "$N使出伏虎拳「狐鹿皆遁走」，步下一错，散出一溜人影，同时出拳攻击",
        "zhaoshi":"「狐鹿皆遁走」",
        "jibie" :26, 
        "sen"   :3,
        "dodge" :20,
        "parry" :10,
        "damage":70,
        "wound" :35,
        "damage_type" : "瘀伤"
    ]),
    ([  "action": "$N中宫直进，使出「有虎夜入林」，对准$n当胸一拳，意态豪放，傲然不群",
        "lian"  : "$N大步跨前，当胸捣出一拳，体会猛虎入林的王者之风",
        "zhaoshi":"「有虎夜入林」",
        "jibie" :36, 
        "sen"   :4,
        "dodge" :10,
        "parry" :20,
        "damage":75,
        "wound" :35,
        "damage_type" : "瘀伤"
    ]),
    ([  "action": "$N使出「意托八禅定」，身形滴溜留一个旋身，掌势飘忽不定，捺向四面八方",
        "lian"  : "$N使出「意托八禅定」，身形自左向右一个旋身，掌势撒向四面八方",  
        "zhaoshi":"「意托八禅定」",
        "jibie" :45,
        "sen"   :4,
        "dodge" :10,
        "parry" :20,
        "force" :30,
        "damage" : 80,
        "wound" :40,
        "damage_type" : "瘀伤"
    ]),
    ([  "action": "$N卓立不动，一式「心无寸波兴」，二手抱于胸前，左手曲中食二指，大指微挑，\n"
                  "右手并指如刀，独将无名指曲回，拳不拳掌不掌，无数变化尽在其中",
        "lian"  : "$N卓立不动，双手置于胸前，拳不拳掌不掌，细细揣摩每一种变化",
        "zhaoshi":"「心无寸波兴」",
        "jibie" :54, 
        "sen"   :4,
        "dodge" : 15,
        "parry" : 20,
        "damage":85,
        "wound" :45,
        "damage_type" : "瘀伤"
    ]),
    ([  "action": "$N欺身向前，拳走连环，一式「好拳凭得力」，击向$n$l",   
     //令吾想起“好风凭借力，送我上青云”也，叹叹。 lin
        "lian"  : "$N拳走连环，步踏洪门，正是伏虎拳第七式「好拳凭得力」",
        "zhaoshi":"「好拳凭得力」",
        "jibie" :63,
        "sen"   :3,
        "dodge" : 10,
        "parry" : 10,
        "damage":85,
        "wound" :50,
        "damage_type" : "内伤"
    ]),
    ([  "action": "$N使一式「妙步匿踪形」，脚下一错，人已闪到$n的身后，\n头也不回，反手就是一拳，仿佛背后长了眼睛一般，直奔$n后心而去",
        "lian"  : "$N使一式「妙步匿踪形」，脚下一错，身形闪出丈外，反手一拳，击向原来的位置",
        "zhaoshi":"「妙步匿踪形」",
        "limb"  :"后心",
        "jibie" :72,    
        "sen"   : 4,
        "dodge" : 5,
        "parry" :10,
        "damage":85,
        "wound" :45,
        "damage_type" : "劈伤"
    ]),
    ([  "action": "$N一招「斯时威已去」，虎尾步，大折身，威风尽去，趁$n不备双手抢向$n的下盘",
        "lian"  : "$N虎尾步，大折身，双手成虎爪贴地抢出，正是伏虎拳第九式「斯时威已去」",
        "zhaoshi":"「斯时威已去」",
        "limb"  :"腿部",
        "jibie" :81, 
        "sen"   :3,    
        "dodge" :10,
        "parry" :0,
        "damage":90,
        "wound" :50,
        "damage_type" : "瘀伤"
    ]),
    ([  "action": "$N长声悲啸，以扰乱$n的心神，一招「呦呦作哀鸣」，攻向$n的$l",
        "lian"  : "$N长声悲啸，手下攻势不绝，却与嘴上毫不相干",
        "zhaoshi":"「呦呦作哀鸣」",
        "jibie" :90,    
        "sen"   :3,
        "dodge" :10,
        "parry" :10,
        "damage":90,
        "wound" :55,
        "damage_type" : "瘀伤"
    ]),
    ([  "action": "$N一招「纵虎归山去」，单拳护身，足成独立，另一只手挥向$n面门",
        "lian"  : "$N单拳护身，另一手挥出，足下独立，一个不稳，差点扭了脚",
        "zhaoshi":"「纵虎归山去」",
        "limb"  :"面门",
        "jibie" :99,   
        "sen"   :5,   
        "dodge" :10,
        "parry" :20,
        "damage":90,
        "wound" :55,
        "damage_type" : "瘀伤"
    ]),
    ([  "action": "$N纵声长啸，使出伏虎拳最后一式「再作天龙吟」，身若游龙，拳随身走，刹那间已向$n攻出五式",
        "lian"  : "$N拳不停手，身形流动，步法怪异，一不留神之下，左脚被右腿绊了一下，差点摔倒", 
        "zhaoshi":"「再作天龙吟」",
        "jibie" :108,
        "sen"   :4,
        "dodge" :10,
        "parry" :20,
        "damage":95,
        "wound" :60,
        "damage_type" : "瘀伤"
    ]),
});
}

string *get_all_parry_msg()
{
    return ({
    "$n不退不让，使出伏虎拳起手势「明知山有虎」，左掌按出，硬接$N的来势",
    "$n以第二势「却向虎山行」，右掌接住$N的来势，左手一连三拳，逼得$N退出三步",
    "$n一招「狐鹿皆遁走」，步下一错，散出一地人影，逃得满地都是，不可收拾",
    "$n一招「有虎夜入林」，身随拳走，恰恰让过$N的攻势",
    "$n使出「意托八禅定」，身形滴溜留一个旋身，将将让开$N的攻势",
    "$n卓立不动，双手置于胸前，拳不拳掌不掌。\n$N只觉其中暗藏无数变化，不敢贸然进击",
    "$n不守反攻，以攻为守，拳走连环，正是伏虎拳第七式「好拳凭得力」",
    "$n使一式「妙步匿踪形」，脚下一错。$N只觉眼前一花，$n已不知去向了",
    "$n一招「斯时威已去」，虎尾步，大折身，贴地蹿出",
    "$n长声悲啸，趁$N攻势一乱，回敬数拳，弄得$N好不容易到手的优势化为乌有",
    "$n一招「纵虎归山去」，单拳护身，足成独立，另一只手挥向$N的右手",
    "$n长啸声中，一招「再作天龙吟」，身若游龙，$N的攻势顿时落在空处",
});
}

string *get_all_unarmed_msg()
{
    return ({
    "$n不退不让，使出伏虎拳起手势「明知山有虎」，左掌按出，硬接$N的来势",
    "$n以第二势「却向虎山行」，右掌接住$N的来势，左手一连三拳，逼得$N退出三步",
    "$n一招「狐鹿皆遁走」，步下一错，散出一地人影，逃得满地都是，不可收拾",
    "$n一招「有虎夜入林」，身随拳走，恰恰让过$N的攻势",
    "$n使出「意托八禅定」，身形滴溜留一个旋身，将将让开$N的攻势",
    "$n卓立不动，双手置于胸前，拳不拳掌不掌。\n$N只觉其中暗藏无数变化，不敢贸然进击",
    "$n不守反攻，以攻为守，拳走连环，正是伏虎拳第七式「好拳凭得力」",
    "$n使一式「妙步匿踪形」，脚下一错。$N只觉眼前一花，$n已不知去向了",
    "$n一招「斯时威已去」，虎尾步，大折身，贴地蹿出",
    "$n长声悲啸，趁$N攻势一乱，回敬数拳，弄得$N好不容易到手的优势化为乌有",
    "$n一招「纵虎归山去」，单拳护身，足成独立，另一只手挥向$N的右手",
    "$n长啸声中，一招「再作天龙吟」，身若游龙，$N的攻势顿时落在空处",
});
}

