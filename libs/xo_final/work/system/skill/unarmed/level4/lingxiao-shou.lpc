string *get_all_parry_msg()
{
    return ({
        "$n一招「舞若翻袖」，双掌翻舞，$N眼前一花，失去了$n的踪影",
        "$n两手握拳，一招「颓若寝兽」，格开了$N的一击",
        "但见$n一招「齐若友朋」，跟上一步，化开了$N的攻势",
    });
}

int valid_learn(object me)
{
    if ( me->query("max_force") < 300 )
    {   
        write("你的内力太弱，无法练凌霄拿云手。\n");
        return 0;
    }

    return ::valid_learn(me);
}

