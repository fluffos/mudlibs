    ([   "action"  :"$N一招「势若山岳」，左掌化虚为实击向$n的$l",
         "lian"    :"$N一招「势若山岳」，左掌虚虚实实击出",
         "zhaoshi" : "「势若山岳」",
         "damage" : 40,
         "wound"  : 15, 
         "sen"    : 8,
         "parry"  : 20,
         "dodge"  : 20,
         "jibie"  : 5,   
         "damage_type":  "瘀伤"
    ]),
    ([   "action"  :"$N前脚剔出，右手随后一招「屹若战阵」拍向$n的$l",
