inherit SKILL_UNARMED;

mapping *get_all_action()
{
    return ({
    ([   "action"  :"$N使出一招「稳若盘石」，左掌直立，右掌穿出击向$n的$l",
         "lian"    :"$N使出一招「稳若盘石」，左掌直立，右掌向前击出",
         "zhaoshi" : "「稳若盘石」",
