         "zhaoshi" : "「屹若战阵」",
         "sen"   : 10,
         "jibie" : 15,
         "parry" : 30,
         "dodge" : 20,
         "damage": 70,
         "damage_type":  "瘀伤"
    ]),
    ([   "action": "$N双掌一错，使出「翼若搏鹫」，身形飞起，对准$n的$l连续拍出",
         "lian"  :"$N双掌一错，使出「翼若搏鹫」，身形飞起数尺",
         "zhaoshi" : "「翼若搏鹫」",
