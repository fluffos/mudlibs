         "damage": 60,
         "damage_type":  "瘀伤"
    ]),
    ([   "action":"$N使出「迸若流落」，化出数道身形同时击向$n的$l",
         "lian" :"$N使出「迸若流落」，化出数道身形同时击出",
         "zhaoshi" : "「迸若流落」",
         "sen"   : 8,
