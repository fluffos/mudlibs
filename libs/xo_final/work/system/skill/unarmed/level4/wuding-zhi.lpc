string *get_all_parry_msg()
{
    return ({
        "$n身形一跃而起，躲开$N攻势，同时一招「锡卓浸影」，幻出万千指影，罩向$N",
        "$n身体往后一仰，险险避过$N的一击",
        "$n镇定自若，一招「自动虚岩」，身形一侧，躲开了$N的这一击",
    });
}

int valid_learn(object me)
{
    int budd_jibie,skill_jibie;

    budd_jibie = me->query_jibie("buddhism");
    skill_jibie = me->query_jibie("wuding-zhi");
    
    if ( 2*skill_jibie /5+ 100 > budd_jibie )
    {
        return notify_fail("你的佛学修为不够，强练绝技会伤及身体。\n");
    }

    if( (int)me->query("max_force") < 950 )
    {
        return notify_fail("以你现在的内力练大智无定指只能有损自身！\n");
    }

    return ::valid_learn(me);
}

