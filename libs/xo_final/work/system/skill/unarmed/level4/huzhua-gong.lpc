inherit SKILL_UNARMED;

mapping *get_all_action()
{
    return ({

        ([      "action":
"$N左掌微分，右手一长使出一招「饿虎扑食」，抓向$n的$l",
                "lian" :
"$N左掌微分，右手一长使出一招「饿虎扑食」，抓向半空中......",
                "jibie"  :10,
                "zhaoshi":"「饿虎扑食」",
                "sen"    :5,
                        "dodge"  :0,
                        "parry"  :0,
                "damage" :60,
                "wound"  :30,
                        "damage_type":  "抓伤"
        ]),
        ([      "action":
"$N倏地一个转身，双手一翻，一招「白虎跳涧」直掼$n下颌....",
                "lian" :
"$N倏地一个转身，双手一翻，一招「白虎跳涧」直掼假想对手的下颌....",
                "jibie":20,
                "limb" : "下颌",
                "sen"  :5,
                "zhaoshi":"「白虎跳涧」",
                        "dodge":0,
                        "parry":0,
                "damage":60,
                "wound" :35,
                        "damage_type":"瘀伤"
        ]),
        ([      "action":
"$N身子微斜，随即跨出一步，左手忽掌忽爪使出「龙虎交会」，拍向$n的$l",
                "lian" :
"$N身子微斜，随即跨出一步，左手忽掌忽爪使出一招「龙虎交会」来。",
                "jibie":35,
                "zhaoshi":"「龙虎交会」",
                "sen"  :6,
                        "dodge":0,
                        "parry":10,
                "damage":75,
                "wound" : 40,
                        "damage_type":"瘀伤"
        ]),
        ([      "action":
"$N使出「猛虎下山」，身子一纵，双手对准$n的后心抓去",
                "lian" :
"$N使出「猛虎下山」，身子一纵，跨步上前，身形右转，双手同时向右抓去...",
                "jibie":45,
                "zhaoshi":"「猛虎下山」",
                "sen":8,
                "limb":"后心",
                        "dodge":10,
                        "parry":0,
                "damage":75,
                                "wound" :40,
                        "damage_type":  "抓伤"
        ]),
        ([      "action":
"$N左手虚晃，右抓挂风，一招「虎虎生威」击向$n$l",
                "lian":
"$N左手虚晃，右抓挂风，一招「虎虎生威」，出爪威猛，不怒自威....",
                "jibie":60,
                "sen"  :7,
                "zhaoshi":"「虎虎生威」",
                        "dodge":0,
                        "parry":20,
                        "damage":80,
                                "wound" :40,
                        "damage_type":  "抓伤"
        ]),
        ([      "action":
"$N使出「虎尾剪」，凌空跃起，冷不防在落地前对准$n$l踢出一脚",
                "lian":
"$N使出「虎尾剪」，凌空跃起，两脚空踢下方....",
                "jibie":70,
                "sen": 6,
                "zhaoshi":"「虎尾剪」",
                        "dodge":5,
                        "parry":30,
                "damage":90,
                                "wound" :45,
                        "damage_type":"瘀伤"
        ]),
        ([      "action":
"$N右手在$n$l划过，随後一招「乳虎啸谷」左爪又向同一方位抓到",
                "lian":
"$N右手斜抓前方，随後一招「乳虎啸谷」左爪又向同一方位抓到",
                "jibie":80,
                "zhaoshi":"「乳虎啸谷」",
                "sen" : 9,
                        "parry":30,
                "damage":90,
                                "wound" :50,
                        "damage_type":  "抓伤"
        ]),
});
}

string *get_all_parry_msg()
{
    return ({
        "$n使出一招「虎落平阳」，躲开了$N的$w",
        "$n身形急转，一式「飞虎上冈」，登时将$N的$w躲开了",
        "$n一招「纵虎归山」，不战而走，向左急闪，同时右手翻出，攻向$N....",
    });
}

string *get_all_unarmed_msg()
{
    return ({
        "$n使出一招「虎落平阳」，躲开了$N的$w",
        "$n身形急转，一式「飞虎上冈」，登时将$N的$w躲开了",
        "$n一招「纵虎归山」，不战而走，向左急闪，同时右手翻出，攻向$N....",
    });
}

