inherit SKILL_UNARMED;

mapping *get_all_action() {
  return ({
    ([ "action":
      "$N力透指端，手上青筋暴起，使出「鹰爪手」中的第一式“飞鹰展翅”，一声\n"
      "大喝，向$n$l抓去.......",
      "lian":
      "$N力透指端，手上青筋暴起，一声大喝，使出「搏兔式」，纵爪直抓，劲力非凡",
      "jibie": 10,
      "zhaoshi": "「鹰爪手」第一式",
      "sen": 10,
      "dodge": 10,
      "parry": 10,
      "damage": 60,
      "damage_type": "抓伤"
    ]),
    ([ "action":
      "$N身形急转，跨步向西，左手微拳，护住胸腹，右手成抓，五指如钩，直插$n后颈....",
      "lian":
      "$N身形急转，跨步向西，左手微拳，护住胸腹，右手成抓，五指如钩，直插出去....",
      "jibie": 20,
      "zhaoshi": "「鹰爪手」第二式",
      "limb": "后颈",
      "sen": 10,
      "dodge": 20,
      "parry": 20,
      "damage": 100,
      "damage_type": "抓伤"
    ]),
    ([ "action":
      "$N使出「鹰爪手」的「搏虎式」，十指似铁钩一般，伸臂向左，向$n左肩直插了下去....",
      "lian":
      "$N使出「鹰爪手」的第三式「搏虎式」，十指似铁钩一般...",
      "jibie": 30,
      "zhaoshi": "「鹰爪手」第三式",
      "limb": "左肩",
      "sen": 8,
      "dodge": 15,
      "parry": 10,
      "damage": 60,
      "damage_type": "创伤"
    ]),
    ([ "action":
      "$N一招「翔空式」，屈腿越起，斜飞向右，左手力贯五指，飞快地抓向$n头顶.....",
      "lian":
      "$N一招「翔空式」，屈腿越起，斜飞向右，左手力贯五指，飞快地抓向下方.....",
      "jibie": 40,
      "zhaoshi": "「鹰爪手」第四式",
      "limb": "头顶",
      "sen": 11,
      "dodge": 40,
      "parry": 30,
      "damage": 110,
      "damage_type": "抓伤"
    ]),
    ([ "action":
      "$N运起内力，大喝一声，一招「飞鹰落涧」，身子腾空而起，双爪齐向$n面门抓去......",
      "lian":
      "$N运起指力，大喝一声，一招「飞鹰落涧」，身子腾空而起，双爪齐抓向下......",
      "jibie": 50,
      "zhaoshi": "「鹰爪手」第五式",
      "limb": "面门",
      "sen": 11,
      "dodge": 20,
      "parry": 30,
      "damage": 70,
      "damage_type": "抓伤"
    ]),
    ([ "action":
      "$N十指如钩，使出「鹰爪手」的第六式，十指似乎长了一截，迅疾无论地抓向$n的前胸",
      "lian":
      "$N十指如钩，使出「鹰爪手」的第六式，十指似乎长了一截，迅疾无论地连续抓出...",
      "jibie": 60,

      "sen": 20,
      "limb": "胸口",
      "zhaoshi": "「鹰爪手」第六式",
      "parry": 40,
      "damage": 110,
      "damage_type": "抓伤"
    ]),
  });
}

string *get_all_parry_msg() {
  return ({
    "$n使出一招「夸夫追日」，掌力一吐，身子斜向左方，挡开了$N的$w",
    "$n一招「漫天飞雪」，掌风似墙一般将$N的$w挡了回去",
    "$n使出「盘古开天」，反攻$N$l，化解了$N的攻势\n",
    "$n掌开乾坤，双掌一上一下，内力吐出，将$N的攻势化解了",
    "$n左手伸出，两跟手指想钳子一般紧紧夹住了$N的$w!!",
  });
}

string *get_all_unarmed_msg() {
  return ({
    "$n使出一招「夸夫追日」，掌力一吐，身子斜向左方，挡开了$N",
    "$n一招「漫天飞雪」，掌风似墙一般将$N的攻势挡了回去",
    "$n使出「盘古开天」，反攻$N$l，化解了$N的攻势",
    "$n掌开乾坤，双掌一上一下，内力吐出，将$N的攻势化解了",
  });
}
