inherit SKILL_UNARMED;

mapping *get_all_action() {
  return ({
    ([ "action": "$N心如止水，使出「佛心兰花」，五指拢作兰花状，向$n拂去",
      "lian": "$N五指拢作兰花状，体会「佛心兰花」，旁人还以为你想吃鸡爪了",
      "jibie": 6,
      "sen": 9,
      "dodge": 0,
      "parry": 30,
      "damage": 10,
      "zhaoshi": "「佛心兰花」",
      "damage_type": "刺伤"
    ]),
    ([ "action": "$N纵身一跃，一招「龙指天下」，十指居高临下，以泰山压顶之势向$n袭去",
      "lian": "$N纵身一跃，使出一招「龙指天下」，但好象有些不得要领",
      "jibie": 13,
      "sen": 8,
      "dodge": 30,
      "parry": 10,
      "wound": 20,
      "damage": 19,
      "zhaoshi": "「龙指天下」",
      "damage_type": "刺伤"
    ]),
    ([ "action": "$N闻风先动，抢先一招「佛手降魔」，十指隐着丝丝劲风，向$n袭去",
      "lian": "$N十指微动，使出「佛手降魔」，十指间隐着丝丝劲风",
      "jibie": 20,
      "sen": 9,
      "dodge": 40,
      "parry": 30,
      "wound": 40,
      "damage": 40,
      "zhaoshi": "「佛手降魔」",
      "damage_type": "刺伤"
    ]),
    ([ "action": "$N使出「弹指惊雷」，扣起中指，运力弹开，只见一道光芒以迅雷不及掩耳之势向$n面门冲去",
      "lian": "$N扣起中指，运力弹开，正是一招「弹指惊雷」",
      "jibie": 27,
      "sen": 10,
      "dodge": 0,
      "parry": 40,
      "wound": 20,
      "damage": 30,
      "zhaoshi": "「弹指惊雷」",
      "damage_type": "刺伤"
    ]),
    ([ "action": "$N后退两尺，使出「佛光灌顶」，右手中指微弹，一道详和的瑞光向$n的印堂飞去",
      "lian": "$N右手中指慢慢抬起，体会「佛光灌顶」的气势",
      "jibie": 36,
      "sen": 10,
      "dodge": 30,
      "parry": 0,
      "wound": 40,
      "damage": 50,
      "zhaoshi": "「佛光灌顶」",
      "damage_type": "刺伤"
    ]),
    ([ "action": "$N使出「罗汉御魔」，左手引开视线，右手五指叉开，指尖带着淡淡金光，向$n咽喉叉去",
      "lian": "$N左右手配合，使出「罗汉御魔」，招式甚为漂亮",
      "jibie": 44,
      "sen": 11,
      "dodge": 50,
      "parry": 20,
      "wound": 40,
      "damage": 93,
      "zhaoshi": "「罗汉御魔」",
      "damage_type": "刺伤"
    ]),
    ([ "action": "$N无我无心，倒飘两尺开外，右手中指遥指丹田，一道淡金色光芒直飞出去，气势浩然",
      "lian": "$N闭目盘膝而坐，心念「佛指天心」，右手指尖似有金光流动",
      "jibie": 52,
      "sen": 11,
      "dodge": 20,
      "parry": 40,
      "wound": 40,
      "damage": 90,
      "zhaoshi": "「佛指天心」",
      "damage_type": "刺伤"
    ]),
    ([ "action": "$N抖擞精神，使出「地狱擒魔」，十指间金光暴现，像无数利剑，将$n全身笼罩",
      "lian": "$N凝神聚气，体会「地狱擒魔」，身着的衣服无风自动",
      "jibie": 64,
      "sen": 10,
      "dodge": 60,
      "parry": 20,
      "wound": 50,
      "damage": 80,
      "zhaoshi": "「地狱擒魔」",
      "damage_type": "刺伤"
    ]),
  });
}

string *get_all_parry_msg() {
  return ({
    "$n一招「龙指天下」，立右掌护住上三路，伸左拳挡向下盘，封得密不透风",
    "$n使出「弹指惊雷」，一指弹出，罡风后发先至，扑向面门，赶紧收招",
    "$n临危不慌，使出「罗汉御魔」，十指微动，几道金光交错成网，根本攻不进去",
    "$n心无旁骛，指尖轻点，直袭招中破绽之处，将攻势击散于无形",
  });
}

string *get_all_unarmed_msg() {
  return ({
    "$n一招「龙指天下」，立右掌护住上三路，伸左拳挡向下盘，封得密不透风",
    "$n使出「弹指惊雷」，一指弹出，罡风后发先至，扑向面门，赶紧收招",
    "$n临危不慌，使出「罗汉御魔」，十指微动，几道金光交错成网，根本攻不进去",
    "$n心无旁骛，指尖轻点，直袭招中破绽之处，将攻势击散于无形",
  });
}

int valid_learn(object me) {
  int budd_jibie, skill_jibie;

  budd_jibie = me->query_jibie("buddhism");
  skill_jibie = me->query_jibie("mohe-zhi");

  if (14 * skill_jibie / 25 + 60 > budd_jibie) {
    return notify_fail("你的佛学修为不够，强练绝技会伤及身体。\n");
  }

  if ((int)me->query("max_force") < 900) {
    return notify_fail("你的内力太弱，无法练摩诃指。\n");
  }

  return ::valid_learn(me);
}
