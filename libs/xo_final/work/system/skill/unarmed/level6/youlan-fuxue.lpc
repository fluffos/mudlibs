#include <ansi.h>

inherit SKILL_UNARMED;

string *xuedao = ({
  "巨骨穴",
  "地仓穴",
  "肩井穴",
  "颊车穴",
  "承泣穴",
  "风池穴",
  "章门穴",
  "风府穴",
  "精促穴",
  "陶道穴",
  "强间穴",
  "少海穴",
  "犊鼻穴",
  "神门穴",
  "华盖穴",
  "大椎穴",
  "太阳穴",
  "膻中穴",
  "命门穴",
  "鸠尾穴",
  "三阴交",
  "天柱穴"
});

mapping *get_all_action() {
  return ({
    ([ "action": "$N右手五指分开，微微一拨，再并拢向外一拂，一式「花疏云淡」，
拂向$n的膻中要穴",
      "lian": "$N右手五指分开，微微一拨，再并拢向外一拂，一式「花疏云淡」",
      "zhaoshi": "「花疏云淡」",
      "damage": 50,
      "wound": 15,
      "parry": 20,
      "dodge": 30,
      "jibie": 10,
      "sen": 7,
      "damage_type": "淤伤",
    ]),
    ([ "action": "$N侧身掠向$n，一式「轻云蔽月」，左手五指暗暗运气拨向$n的胸前
大穴",
      "lian": "$N一式「轻云蔽月」，左手五指暗暗运气",
      "zhaoshi": "「轻云蔽月」",
      "damage": 60,
      "wound": 15,
      "parry": 30,
      "dodge": 10,
      "jibie": 20,
      "sen": 8,
      "damage_type": "淤伤",
    ]),
    ([ "action": "$N使一式「云破月来」，左掌虚攻，右手并指斜前翻出，拍向$n的肩
井穴",
      "lian": "$N使一式「云破月来」，左掌虚攻，右手并指斜前翻出",
      "zhaoshi": "「云破月来」",
      "damage": 60,
      "wound": 20,
      "parry": 30,
      "dodge": 30,
      "jibie": 25,
      "sen": 9,
      "damage_type": "淤伤",
    ]),
    ([ "action": "$N左掌护胸，微微侧身，右掌勾上，一式「幽兰弄影」，缓缓拂向$n
的天突穴",
      "lian": "$N左掌护胸，微微侧身，右掌勾上，一式「幽兰弄影」",
      "zhaoshi": "「幽兰弄影」",
      "damage": 90,
      "wound": 15,
      "parry": 30,
      "dodge": 30,
      "jibie": 40,
      "sen": 10,
      "damage_type": "淤伤",
    ]),
    ([ "action": "$N使一式「芳兰竟体」，身影不定地掠至$n身后，猛地拍向$n的大椎
穴",
      "lian": "$N使一式「芳兰竟体」，身影不定",
      "zhaoshi": "「芳兰竟体」",
      "damage": 100,
      "parry": 60,
      "dodge": 0,
      "jibie": 50,
      "sen": 10,
      "damage_type": "淤伤",
    ]),
    ([ "action": "$N两臂左手下右手上地于胸前成兰花指形翻上，微吸一口气，一式「
兰桂齐芳」，双手向外快速一拨，激出数道劲气逼向$n的华盖、璇玑、紫宫几处大穴",
      "lian": "$N两臂左手下右手上地于胸前成兰花指形翻上，微吸一口气，一式「
兰桂齐芳」，双手向外快速一拨，激出数道劲气",
      "zhaoshi": "「兰桂齐芳」",
      "damage": 130,
      "wound": 90,
      "parry": 30,
      "dodge": 20,
      "jibie": 80,
      "sen": 11,
      "damage_type": "淤伤",
    ]),
    ([ "action": "$N衣袂飘飘，向上跃起，一式「月影花香」，居高临下，拂出一道劲
力罩向$n的百会大穴",
      "lian": "$N衣袂飘飘，向上跃起，一式「月影花香」，居高临下，拂出一道劲
力",
      "zhaoshi": "「月影花香」",
      "damage": 130,
      "wound": 90,
      "parry": 30,
      "dodge": 20,
      "jibie": 100,
      "sen": 11,
      "damage_type": "淤伤",
    ]),
    ([ "action": "$N凝神施展出「花好月圆」，双手疾拂，一环环的劲气逼向$n的上中
下各大要穴",
      "lian": "$N凝神施展出「花好月圆」，双手疾拂，一环环的劲气逼出",
      "zhaoshi": "「花好月圆」",
      "damage": 130,
      "wound": 90,
      "parry": 30,
      "dodge": 20,
      "jibie": 120,
      "sen": 11,
      "damage_type": "淤伤",
    ]),
    ([ "action": "$N左手忽做兰花之形，五指轻拢慢抹，拂向$n的周身大穴",
      "lian": "$N左手忽做兰花之形，五指轻拢慢抹",
      "zhaoshi": "「轻拢慢抹」",
      "damage": 130,
      "wound": 90,
      "parry": 30,
      "dodge": 20,
      "jibie": 150,
      "sen": 11,
      "damage_type": "淤伤",
    ]),
    ([ "action": "$N右手轻摇，颤抖不定，便如兰花浴风般划向$n的$l",
      "lian": "$N右手轻摇，颤抖不定，便如兰花浴风般",
      "zhaoshi": "「兰花浴风」",
      "damage": 130,
      "wound": 90,
      "parry": 30,
      "dodge": 20,
      "jibie": 200,
      "sen": 11,
      "damage_type": "淤伤",
    ]),
    ([ "action": HIC "忽见$N" + (random(2) ? "右" : "左") + "手手掌五指分开，形如兰花，姿态曼妙难言，出手优雅，气度闲逸，望之轻描淡写，行若无事地拂向$n的" + xuedao[random(sizeof(xuedao))] + "" NOR,
      "lian": HIC "忽见$N" + (random(2) ? "右" : "左") + "手手掌五指分开，形如兰花，姿态曼妙难言，出手优雅，气度闲逸，望之轻描淡写，行若无事" NOR,
      "zhaoshi": "「行若无事」",
      "damage": 130,
      "wound": 90,
      "parry": 30,
      "dodge": 20,
      "jibie": 220,
      "sen": 11,
      "damage_type": "淤伤",
    ]),
    ([ "action": HIC "$N淡然一笑，出手若春兰葳蕤，晓风过林，似慢实快，若重还轻拂向$n的" + xuedao[random(sizeof(xuedao))] + "，已深得快、准、奇、清四字要诀" NOR,
      "lian": HIC "$N淡然一笑，出手若春兰葳蕤，晓风过林，似慢实快，若重还轻，已深得快、准、奇、清四字要诀" NOR,
      "zhaoshi": "「若重还轻」",
      "damage": 130,
      "wound": 90,
      "parry": 30,
      "dodge": 20,
      "jibie": 250,
      "sen": 11,
      "damage_type": "淤伤",
    ]),
    ([ "action": HIR "$N双手交叠，使出“兰花手双手式”，形状便如兰花新蕾初放，于轻风中微微摇摆。$n看得有些发呆，却蓦然发现$N的十指已拂到面前！" NOR,
      "lian": HIR "$N双手交叠，使出“兰花手双手式”，形状便如兰花新蕾初放，于轻风中微微摇摆！" NOR,
      "zhaoshi": "「兰花手双手式」",
      "damage": 130,
      "wound": 90,
      "parry": 30,
      "dodge": 20,
      "jibie": 300,
      "sen": 11,
      "damage_type": "淤伤",
    ]),
  });
}
