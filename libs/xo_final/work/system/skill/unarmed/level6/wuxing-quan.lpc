#include <ansi.h>

inherit SKILL_UNARMED;

mapping *get_all_action()
{
    return ({
([  "action":
        "$N数击不中，突发一拳，使出五行拳中的"HIY"“劈”"NOR"字诀，劈向$n的$l",
    "lian": 
      "$N突发一拳，使出五行拳的"HIY"「力劈华山」"NOR"，向前劈出",
    "jibie"     :0,   
    "limb"           :"脸部",
    "zhaoshi"      :"「力劈华山」",
    "sen"       :30,
    "damage"     :65,
    "wound"      :50,
    "damage_type":	"瘀伤"
]),
([  "action":
"$N身形前倾，使出"HIC"「冲天一炮」"NOR"，左掌护胸，右手成拳向$n的$l捣出",
    "lian":
"$N左掌护胸，右手成拳,仔细体会"HIC"“钻”"NOR"字诀的要旨。",
    "jibie"     :10,   
    "zhaoshi":"「冲天一炮」",
    "sen"       :20,
    "dodge"     :10,
	"damage"     :80,
    "wound"      :60,
	"damage_type":	"瘀伤"
]),
([  "action":
"$N使出五行拳"HIG"「一索横江」"NOR"，身行转动，双臂砸向$n$l",
    "lian":
"$N使出五行拳"HIG"「一索横江」"NOR"，脚下步伐窜动，双臂挥舞，一副万夫不挡之勇",
    "jibie"     :30, 
    "zhaoshi":"「一索横江」",
    "sen"       :30,
	"dodge"     :20,
	"parry"     :20,
	"damage"    :85,
	"damage_type":	"瘀伤"
]),
([  "action":
"$N双手成拳，左腿屈向前伸，踏上一步，化出一片拳影对准$n当胸打去，",
    "lian":
"$N使出一招"HIR"「扑天盖地」"NOR"，左腿屈向前伸，踏上一步，化出一片拳影",
    "jibie"     :40, 
    "zhaoshi":"「扑天盖地」",
    "sen"       :30,
    "parry"     :50,
    "damage"     :100,
    "wound"      :65,
    "damage_type":	"瘀伤"
]),
([  "action":
"$N使出"HIW"「山崩地裂」"NOR"，左掌凝力发出，右拳一转，后发先至",
    "lian":
"$N使出"HIW"「山崩地裂」"NOR"，左掌凝力发出，右拳一转，后发先至",
    "zhaoshi":"「山崩地裂」",
    "jibie"     :50,
    "sen"       :45,
    "dodge"     :40,
    "parry"     :90,
    "damage"     :110,
    "wound"      :80,
    "damage_type":	"瘀伤"
]),
});
}

string *get_all_parry_msg()
{
    return ({
        "$n不退不让，使出「力劈华山」，硬接$N的来势",
        "$n以“钻”字诀「冲天一炮」，左掌接住$N的来势，右手直向前打去，逼得$N退出三步",
        "$n一招「一索横江」，脚下步伐窜动，双臂挥舞，一副万夫不挡之勇",
        "$n一招「扑天盖地」，身随拳走，恰恰让过$N的攻势",
        "$n一声长啸，一招「山崩地裂」，双拳封挡，$N的攻势顿时落在空处",
    });
}

string *get_all_unarmed_msg()
{
    return ({
        "$n不退不让，使出「力劈华山」，硬接$N的来势",
        "$n以“钻”字诀「冲天一炮」，左掌接住$N的来势，右手直向前打去，逼得$N退出三步",
        "$n一招「一索横江」，脚下步伐窜动，双臂挥舞，一副万夫不挡之勇",
        "$n一招「扑天盖地」，身随拳走，恰恰让过$N的攻势",
        "$n一声长啸，一招「山崩地裂」，双拳封挡，$N的攻势顿时落在空处",
    });
}

