inherit SKILL_UNARMED;

mapping *get_all_action()
{
    return ({
    ([  "action" : "$N脚走环步，上身姿势坐定不动，双手一式「沿门托钵」，平平向上击向$n",
        "lian"   : "$N脚走环步，上身姿势坐定不动，双手一式「沿门托钵」，平平向上击出",
        "zhaoshi": "「沿门托钵」",
        "damage" : 50,
        "wound"  : 15,
        "parry"  : 20,
        "dodge"  : 30,
        "jibie"  : 10,
        "sen"    : 7,
        "damage_type" : "淤伤",
    ]),
    ([  "action" : "又见$N一招「智珠在握」，双手握拳，若有若无的向$n一击，却蕴含着无限的攻势",
        "lian"   : "$N双手握拳，若有若无的向前一击，乃是一招「智珠在握」",
        "zhaoshi": "「智珠在握」",
        "damage" : 60,
        "wound"  : 15,
        "parry"  : 30,
        "dodge"  : 10,
        "jibie"  : 20,
        "sen"    : 8,
        "damage_type" : "淤伤",
    ]),
    ([  "action" : "$N大袖一挥，一招「达世知幻」，两股劲风夹面击向$n的$l",
        "lian"   : "$N大袖一挥，一招「达世知幻」，两股劲力澎湃涌出",
        "zhaoshi":"「达世知幻」",
        "damage" : 60,
        "wound"  : 20,
        "parry"  : 30,
        "dodge"  : 30,
        "jibie"  : 25,
        "sen"    : 9,
        "damage_type" : "淤伤",
    ]),
    ([  "action" : "$N两膝微弯，一脚向前踢出，随后右手捏紧跟而上，一招「直心出欲」，向$n的$l拍去",
        "lian"   : "$N两膝微弯，一脚向前踢出，随后右手捏紧跟而上，一招「直心出欲」，向前拍出",
        "zhaoshi":"「直心出欲」",
        "damage" : 90,
        "wound"  : 15,
        "parry"  : 30,
        "dodge"  : 30,
        "jibie"  : 40,
        "sen"    : 10,
        "damage_type" : "淤伤",
    ]),
    ([  "action" : "$N左脚一点，右脚腾起跃进，一式「心寂欲除」，将$n罩在掌风之下",
        "lian"   : "$N左脚一点，右脚腾起跃进，一式「心寂欲除」，掌力所至，花败草衰，不禁有得意感",
        "zhaoshi":"「心寂欲除」",
        "damage" : 100,
        "parry"  : 60,
        "dodge"  : 0,
        "jibie"  : 40,
        "sen"    : 10,
        "damage_type" : "淤伤",
    ]),
    ([  "action" : "$N左脚向後偷步，身体向右微转，左手缓缓推出，击向$n的$l，\n"
                   "又忽地身形一转，右手从袖中急拍而出，后力十足，乃是一招「转重令轻」",
        "lian"   : "$N左脚向後偷步，身体向右微转，左手缓缓推出，又忽地身形一转，\n"
                   "右手从袖中急拍而出，后力十足，乃是一招「转重令轻」",
        "zhaoshi":"「转重令轻」",
        "damage" : 130,
        "wound"  : 90,
        "parry"  : 30,
        "dodge"  : 20,
        "jibie"  : 30,
        "sen"    : 11,
        "damage_type" : "淤伤",
    ])
});
}

string *get_all_parry_msg()
{
    return ({
        "$n身体向后微微仰倒，一式「无著得道」顺势右拳收腰、左手封掌护胸，档开了$N这一击",
        "$n右掌拉回，立掌护住左肩部位，接著收左拳向前直击而出，以攻为守，防开了对方的攻势",
        "$n不退反进，一招「假真并观」，左腿上前一步，右手攻向$N的$l",
    });
}

string *get_all_unarmed_msg()
{
    return ({
        "$n身体向后微微仰倒，一式「无著得道」顺势右拳收腰、左手封掌护胸，档开了$N这一击",
        "$n右掌拉回，立掌护住左肩部位，接著收左拳向前直击而出，以攻为守，防开了对方的攻势",
        "$n不退反进，一招「假真并观」，左腿上前一步，右手攻向$N的$l",
    });
}

int valid_learn(object me)
{
    int budd_jibie,skill_jibie;

    budd_jibie = me->query_jibie("buddhism");
    skill_jibie = me->query_jibie("duoluoye-zhi");
    
    if ( 2*skill_jibie /5+ 100 > budd_jibie )
    {
        return notify_fail("你的佛学修为不够，强练绝技会伤及身体。\n");
    }

    if ( (int)me->query("max_force") < 850 )
    {
        return notify_fail("你的内力不够，没有办法练拈花指。\n");
    }

    return ::valid_learn(me);
}

