inherit SKILL_UNARMED;

mapping *get_all_action() {
  return ({
    ([ "action": "$N一招「剑指南山」，右手拇指直刺$n的$l",
      "lian": "$N一招「剑指南山」，右手拇指直刺",
      "dodge": 10,
      "parry": 25,
      "sen": 10,
      "jibie": 10,
      "zhaoshi": "「剑指南山」",
      "damage": 60,
      "damage_type": "淤伤"
    ]),
    ([ "action": "$N使一招「天荒地老」，左手轻轻一挥，右手刺向$n的檀中大穴",
      "lian": "$N使一招「天荒地老」，左手轻轻一挥，右手刺向对方的檀中大穴",
      "dodge": 30,
      "parry": 15,
      "sen": 11,
      "jibie": 17,
      "zhaoshi": "「天荒地老」",
      "damage": 75,
      "damage_type": "淤伤"
    ]),
    ([ "action": "$N双掌翻飞，一招「海枯石烂」，暗藏玄机，中指戳向$n的$l",
      "lian": "$N双掌翻飞，一招「海枯石烂」，暗藏玄机",
      "dodge": 20,
      "parry": 35,
      "sen": 10,
      "jibie": 24,
      "zhaoshi": "「海枯石烂」",
      "damage": 80,
      "damage_type": "淤伤"
    ]),
    ([ "action": "$N一声大喝，一式「大江东去」，双指齐出，攻向$n的胸口和$l",
      "lian": "$N一声大喝，一式「大江东去」，双指齐出",
      "dodge": 5,
      "parry": 20,
      "sen": 12,
      "jibie": 31,
      "zhaoshi": "「大江东去」",
      "damage": 68,
      "damage_type": "淤伤"
    ]),
    ([ "action": "$N连上数步，一招「乌雀南飞」，左掌劈向$n，右手却暗袭$n的$l",
      "lian": "$N连上数步，一招「乌雀南飞」",
      "dodge": 24,
      "parry": 34,
      "sen": 11,
      "jibie": 42,
      "zhaoshi": "「乌雀南飞」",
      "limb": "后脑",
      "damage": 96,
      "wound": 60,
      "damage_type": "淤伤"
    ]),
    ([ "action": "$N双手不住晃动，缓缓逼近$n，一招「冰冻千里」，笼罩了$n的$l",
      "lian": "$N双手不住晃动，一招「冰冻千里」",
      "dodge": 15,
      "parry": 30,
      "sen": 15,
      "jibie": 53,
      "zhaoshi": "「冰冻千里」",
      "damage": 120,
      "wound": 90,
      "damage_type": "淤伤"
    ]),
    ([ "action": "$N一招「寿比南山」，手指不住晃动，不离$n的$l方寸之间",
      "lian": "$N一招「寿比南山」，手指不住晃动",
      "dodge": 21,
      "parry": 30,
      "sen": 14,
      "jibie": 65,
      "zhaoshi": "「寿比南山」",
      "damage": 130,
      "wound": 90,
      "damage_type": "淤伤"
    ]),
  });
}
