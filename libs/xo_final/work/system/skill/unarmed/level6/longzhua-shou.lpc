        "lian"   : "$N双手平提胸前，左手护住面门，一招「抱残式」右手向前急推",
        "zhaoshi": "「抱残式」",
        "damage" : 70,
        "wound"  : 50,
        "parry"  : 80,
        "dodge"  : 0,
        "jibie"  : 40,
        "sen"    : 8,
        "damage_type" : "淤伤",
    ]),
    ([    "action" : "$N两手胸前环抱，腋下含空，五指如钩，一招「守缺式」插向$n的顶门",
        "lian"   : "$N两手胸前环抱，腋下含空，五指如钩，一招「守缺式」由上而下一插",
        "zhaoshi": "「守缺式」",
        "damage" : 100,
        "wound"  : 80,
        "parry"  : 0,
        "dodge"  : 0,
        "jibie"  : 48,
        "sen"    : 11,
