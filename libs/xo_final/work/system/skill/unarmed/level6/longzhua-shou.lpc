        "lian"   : "$N右腿斜跨一步，一招「抢珠式」，上手取目，下手迅速反勾",
        "zhaoshi": "「抢珠式」",
        "damage" : 80,
        "wound"  : 60,
        "parry"  : 50,
        "dodge"  : 50,
        "jibie"  : 56,
