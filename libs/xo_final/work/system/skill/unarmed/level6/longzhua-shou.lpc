string *get_all_parry_msg()
{
    return ({
        "只见$n以攻代守，腾步上前，左手护胸，右手探出，一招「掏虚式」击向$n的裆部",
        "但见$n右手虚握，左手掌立如山，一招「批亢式」，格开了$N的攻势",
        "$N左手指向$n胸前的五道大穴，右手斜指太阳穴，一招「拿云式」反而使$n进退两难",
        "$N前脚着地，一手顶天成爪，一手指地，一招「追日式」劲气笼罩$n的全身",
    });
}

int valid_learn(object me)
{
    int budd_jibie,skill_jibie;

    budd_jibie = me->query_jibie("buddhism");
    skill_jibie = me->query_jibie("longzhua-shou");
    
    if ( 8*skill_jibie /25+ 120 > budd_jibie )
    {
        return notify_fail("你的佛学修为不够，强练绝技会伤及身体。\n");
    }

    if((int)me->query("max_force") < 1200)
    {
        return notify_fail("你的内力不足，强练龙爪手会走火入魔。\n");
    }

    return ::valid_learn(me);
}

