string *get_all_parry_msg()
{
    return ({
        "$n一招「红花绿叶」，架住了$N的所有攻势",
        "$n身形飘出，一招「云中漫步」躲开了$N的所有攻势",
    });
}

int valid_learn(object me)
{
    int budd_jibie,skill_jibie;

    budd_jibie = me->query_jibie("buddhism");
    skill_jibie = me->query_jibie("wuxiangjie-zhi");
    
    if ( 2*skill_jibie /5+ 100 > budd_jibie )
    {
        return notify_fail("你的佛学修为不够，强练绝技会伤及身体。\n");
    }

    if( (int)me->query("max_force") < 1000 )
    {
        return notify_fail("以你现在的内力练无相劫指只能有损自身！\n");
    }

    return ::valid_learn(me);
}

