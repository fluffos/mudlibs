#include <ansi.h>

inherit SKILL_UNARMED;

mapping *get_all_action()
{
    return ({
    ([	"action": "$N使出倚天屠龙掌中的一式"+HIY"『武林至尊』"NOR+"，一笔"
                   "一划，暗含内劲，击向$n的$l",
        "lian"  : "$N使出倚天屠龙掌中的一式"+HIY"『武林至尊』"NOR+"，一笔"
                   "一划，暗含内劲",
        "dodge" :10,
        "parry" :10,
        "sen"   :5,
        "jibie" :0,
        "damage":100,
        "zhaoshi": HIY"『武林至尊』"NOR,
        "damage_type":"淤伤"   
	]),
    ([	"action": "$N使出倚天屠龙掌中的一式"+HIY"『宝刀屠龙』"NOR+"，“龙"
                   "”字笔划甚多，笔划多的不觉其繁，击向$n的$l",
        "lian"  : "$N使出倚天屠龙掌中的一式"+HIY"『宝刀屠龙』"NOR+"，“龙"
                   "”字笔划甚多，笔划多的不觉其繁",
        "dodge" :15,
        "parry" :15,
        "sen"   :5,
        "jibie" :25,
        "damage":100,
        "zhaoshi": HIY"『宝刀屠龙』"NOR,
        "damage_type":"淤伤"   
	]),
    ([	"action": "$N使出倚天屠龙掌中的一式"+HIY"『号令天下』"NOR+"，“下"
                   "”字笔划甚少，笔划少的不见其陋，击向$n的$l",
        "lian"  : "$N使出倚天屠龙掌中的一式"+HIY"『号令天下』"NOR+"，“下"
                   "”字笔划甚少，笔划少的不见其陋。",
        "dodge" :20,
        "parry" :20,
        "sen"   :7,
        "jibie" :50,
        "damage":120,
        "zhaoshi": HIY"『号令天下』"NOR,
        "damage_type":"淤伤"
    ]),  
    ([	"action": "$N使出倚天屠龙掌中的一式"+HIY"『莫敢不从』"NOR+"，其缩"
                   "也凝重，似尺蠖之屈，其纵也险劲，如狡兔之脱，击\n向$n的$l",
        "lian"  : "$N使出倚天屠龙掌中的一式"+HIY"『莫敢不从』"NOR+"，其缩"
                   "也凝重，似尺蠖之屈，其纵也险劲，如狡兔之脱",
        "dodge" :25,
        "parry" :25,
        "sen"   :8,
        "jibie" :75,
        "damage":170,
        "zhaoshi": HIY"『莫敢不从』"NOR,
        "damage_type":"淤伤"
    ]),  
    ([	"action": "$N使出倚天屠龙掌中的一式"+HIY"『倚天不出』"NOR+"，淋漓"
                   "酣畅，雄浑刚健，俊逸处如风飘，如雪舞，厚重处如\n虎蹲，"
                   "如象步，击向$n的$l",
        "lian"  : "$N使出倚天屠龙掌中的一式"+HIY"『倚天不出』"NOR+"，淋漓"
                   "酣畅，雄浑刚健，俊逸处如风飘，如雪舞，厚重处如\n虎蹲，"
                   "如象步",
        "dodge" :30,
        "parry" :30,
        "sen"   :10,
        "jibie" :100,
        "damage":170,
        "zhaoshi": HIY"『倚天不出』"NOR,
        "damage_type":"淤伤"
    ]),  
	([	"action": "$N使出倚天屠龙掌中的一式"+HIY"『谁与争锋』"NOR+"，长啸"
                   "一声，右掌直划下来，当真是星剑光芒，如矢应机，\n霆不暇"
                   "发，电不及飞，这一直乃是“锋”字的最后一笔，直劈向$n的$l",
        "lian"  : "$N使出倚天屠龙掌中的一式"+HIY"『谁与争锋』"NOR+"，长啸"
                   "一声，右掌直划下来，当真是星剑光芒，如矢应机，\n霆不暇"
                   "发，电不及飞，这一直乃是“锋”字的最后一笔",
        "dodge" :30,
        "parry" :30,
        "sen"   :15,
        "jibie" :125,
        "damage":150,
        "zhaoshi": HIY"『谁与争锋』"NOR,
        "damage_type":"淤伤"
    ]),  
});
}

string *get_all_parry_msg()
{
    return ({
        "$n双掌上架，架住了$N的攻势",
        "$n双掌幻化出无数掌影，护住全身", 
        "$n双掌交错，左右穿插翻飞，全力防住了$N的攻势",
        "$n身形急旋，向右闪开，左掌上架，档住了$N这一招"
    });
}

int valid_learn(object me)
{
    if ( me->query( "social_exp" ) < 20000 )
    {
        return notify_fail( "你还需要在江湖中历练才能领悟这门武功。\n" );
    }

    return ::valid_learn(me);
}

