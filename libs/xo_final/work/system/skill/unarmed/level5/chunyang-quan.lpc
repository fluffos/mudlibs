#include <ansi.h>

inherit SKILL_UNARMED;

mapping *get_all_action() {
  return ({
    ([ "action": "只见$N身形一矮，大喝声中以拳化勾一个" HIW "「玄鹤捕食」" NOR "对准$n的$l戳了过去",
      "lian": "$N身形一矮，大喝声中以拳化勾一个" HIW "「玄鹤捕食」" NOR,
      "dodge": 10,
      "parry": 10,
      "sen": 5,
      "jibie": 0,
      "damage": 100,
      "zhaoshi": HIW "「玄鹤捕食」" NOR,
      "damage_type": "淤伤"
    ]),
    ([ "action": "$N左手一分，身形扭转右拳运气，蜿蜒前伸，一招" HIY "「金蛇寻龟」" NOR "便往$n的$l
招呼过去",
      "lian": "$N左手一分，身形扭转右拳运气，蜿蜒前伸，一招" HIY "「金蛇寻龟」" NOR,
      "dodge": 15,
      "parry": 15,
      "sen": 5,
      "jibie": 25,
      "damage": 100,
      "zhaoshi": HIY "「金蛇寻龟」" NOR,
      "damage_type": "淤伤"
    ]),
    ([ "action": "$N右拳在$n面门一晃，和身向前一扑左拳使了个" HIB "「野马上槽」" NOR "往$n的$l狠命一抡",
      "lian": "$N右拳一晃，和身向前一扑左拳使了个" HIB "「野马上槽」" NOR,
      "dodge": 20,
      "parry": 20,
      "sen": 7,
      "jibie": 50,
      "damage": 120,
      "zhaoshi": HIB "「野马上槽」" NOR,
      "damage_type": "淤伤"
    ]),
    ([ "action": "$N步履一沉，左拳拉开，右拳带风，一招" HIR "「黑虎掏心」" NOR "势不可挡地击向$n$l",
      "lian": "$N步履一沉，左拳拉开，右拳带风，一招" HIR "「黑虎掏心」" NOR "势不可挡",
      "dodge": 25,
      "parry": 25,
      "sen": 8,
      "jibie": 75,
      "damage": 170,
      "zhaoshi": HIR "「黑虎掏心」" NOR,
      "damage_type": "淤伤"
    ]),
    ([ "action": "只见$N拉开架式，一招" HIM "「二龙戏珠」" NOR "双拳齐出击向$n$l，虎虎有风",
      "lian": "$N拉开架式，一招" HIM "「二龙戏珠」" NOR "双拳齐出",
      "dodge": 30,
      "parry": 30,
      "sen": 10,
      "jibie": 100,
      "damage": 170,
      "zhaoshi": HIM "「二龙戏珠」" NOR,
      "damage_type": "淤伤"
    ]),
    ([ "action": "$N虚晃一拳，回身欲走，只霎那间身子一侧，反脚踢起，正是" RED "「麒麟反挂」" NOR "！",
      "lian": "$N虚晃一拳，回身欲走，只霎那间身子一侧，反脚踢起，正是" RED "「麒麟反挂」" NOR "！",
      "dodge": 30,
      "parry": 30,
      "sen": 15,
      "jibie": 125,
      "damage": 150,
      "zhaoshi": RED "「麒麟反挂」" NOR,
      "damage_type": "淤伤"
    ]),
    ([ "action": "$N拉开后弓步，左拳一晃，右拳随出，左右拳掌交替变幻迭出，一招" GRN "「青龙
夺食」" NOR "往$n的$l攻去",
      "lian": "$N拉开后弓步，左拳一晃，右拳随出，左右拳掌交替变幻迭出，一招" GRN "「青龙
夺食」" NOR,
      "dodge": 30,
      "parry": 30,
      "sen": 15,
      "jibie": 150,
      "damage": 180,
      "zhaoshi": GRN "「青龙夺食」" NOR,
      "damage_type": "淤伤"
    ]),
    ([ "action": "只见$N运足气力，一个纵身，右拳从左拳后侧身穿出，身随拳至，力势千钧！
这一招的名字叫作" HIR "「赤龙穿云」" NOR "",
      "lian": "$N运足气力，一个纵身，右拳从左拳后侧身穿出，身随拳至，力势千钧！
这一招的名字叫作" HIR "「赤龙穿云」" NOR,
      "dodge": 30,
      "parry": 30,
      "sen": 15,
      "jibie": 180,
      "damage": 200,
      "zhaoshi": HIR "「赤龙穿云」" NOR,
      "damage_type": "淤伤"
    ]),
  });
}

string *get_all_parry_msg() {
  return ({
    "$n双掌上架，架住了$N的攻势",
    "$n双掌幻化出无数掌影，护住全身",
    "$n双掌交错，左右穿插翻飞，全力防住了$N的攻势",
    "$n身形急旋，向右闪开，左掌上架，档住了$N这一招"
  });
}
