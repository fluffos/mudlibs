string *get_all_parry_msg() {
  return ({
    "$n使出一招「凌空飞渡」，反手一掌拍向$N的$l，令其不的不回招自救",
    "$n一招「轻烟笼翠」，左掌随着身形的变化轻轻拍出",
    "$n转身退开一步，右掌连连挥动，抬臂上格",
    "$n手臂一转，掌力轻吐，左手缓缓击出，登时将$N的攻势化解了",
  });
}

string *get_all_unarmed_msg() {
  return ({
    "$n使出一招「凌空飞渡」，反手一掌拍向$N的$l，令其不的不回招自救",
    "$n一招「轻烟笼翠」，左掌随着身形的变化轻轻拍出",
    "$n转身退开一步，右掌连连挥动，抬臂上格",
    "$n手臂一转，掌力轻吐，左手缓缓击出，登时将$N的攻势化解了",
  });
}

int valid_learn(object me) {
  if (me->query("age") < 18) {
    return notify_fail("小小孩子，学些别的功夫打打基础再说吧。\n");
  }

  if (me->query_xiuwei_by_type("dodge") < (20 - me->query("dex")) * 60) {
    return notify_fail("你的身法不够敏捷，还是先练练轻功去吧。\n");
  }

  return ::valid_learn(me);
}
