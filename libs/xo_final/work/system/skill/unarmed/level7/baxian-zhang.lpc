inherit SKILL_UNARMED;

mapping *get_all_action()
{
    return ({
    ([  "action":"$N若酒醉一般，踉踉跄跄跨出三步，转身到了$n一侧，一招「张果老\n"
        "酒醉倒骑驴」左掌成握杯状斜斜击向$n的$l",
        "lian"  :"$N若酒醉一般，踉踉跄跄跨出三步，转身一招「张果老酒醉倒骑驴」\n"
        "左掌成握杯状击出",
        "dodge" :0,
        "sen"   :5,
        "jibie" :8, 
        "parry" :10,
        "damage":60,
        "wound" :25,
        "zhaoshi" : "「张果老酒醉倒骑驴」",
        "damage_type":"淤伤"   
        ]),
    ([  "action":"$N双掌一错，幻化出满天掌影，一招「韩湘子风雪拥蓝关」恰似满天\n"
        "风雪罩向$n",
        "lian"  :"$N双掌一错，幻化出满天掌影，一招「韩湘子风雪拥蓝关」向前推出",
        "dodge" :10,
        "sen"   :5,
        "jibie" :20,
        "damage":60,
        "wound" :30,
        "zhaoshi" : "「韩湘子风雪拥蓝关」",
        "damage_type":"淤伤"    ]),
    ([  "action":"$N大步向前，姿势飘逸，如飞燕掠过长空，一招「吕纯阳月下过洞庭」\n"
        "双脚交替踢向$n的$l，身体急速旋转旋向$n撞去",
        "lian"  :"$N大步向前，姿势飘逸，如飞燕掠过长空，一招「吕纯阳月下过洞庭」\n"
        "双脚交替踢出，身体旋转向前飞出",
        "dodge" :20,
        "sen"   :7,
        "jibie" :30,
        "damage":65,
        "wound" :35,
        "zhaoshi" : "「吕纯阳月下过洞庭」",
        "damage_type":"淤伤" ]),
    ([  "action":"$N左脚一收，身体向左倾斜，右手使出一招「汉钟离玉洞论道」，一\n"
        "掌拍向$n的$l",
        "lian"  :"$N左脚一收，身体向左倾斜，右手使出一招「汉钟离玉洞论道」，一\n"
        "掌拍出",
        "dodge" :40,
        "sen"   :6,
        "jibie" :40,
        "damage":70,
        "wound" :40,
        "zhaoshi" : "「汉钟离玉洞论道」",
        "damage_type":"淤伤"    ]),
    ([  "action":"$N一提真气，身子急拔，使出一招「铁拐李遨游东海」，幻出数个身\n"
                         "影，拍向$n全身的各处要穴",
        "lian"  :"$N一提真气，身子急拔，使出一招「铁拐李遨游东海」，幻出数个身\n"
                         "影，双掌虚虚拍出",
        "dodge" :30,
        "sen"   :8,
        "jibie" :50,
        "damage":75,
        "wound" :40,
        "zhaoshi" : "「铁拐李遨游东海」",
        "damage_type":"淤伤"    ]),
    ([  "action":"$N傲然一笑，身形急旋，扶摇至上，衣裾满天飘舞，空中一折腰，\n"
                         "双掌幻化出朵朵掌花，一招「何仙姑提篮散花」拢向$n",
        "lian"  :"$N傲然一笑，身形急旋，扶摇至上，衣裾满天飘舞，空中一折腰，\n"
                         "双掌幻化出朵朵掌花，一招「何仙姑提篮散花」向下击出",
        "dodge" :10,
        "sen"   :4,
        "jibie" :60,
        "damage":80,
        "wound" :40,
        "zhaoshi" : "「何仙姑提篮散花」",
        "damage_type":"淤伤"    ]),
    ([  "action" : "$N一个趔趄，如醉酒一般跌向$n，双掌交错翻飞，一招「吕洞宾醉\n"
                   "酒戏牡丹」一连十八掌拍向$n全身各大要穴",
         "lian"   : "$N一个趔趄，如醉酒一般仿佛要跌倒，双掌交错翻飞，一招「吕洞\n"
                   "宾醉酒戏牡丹」一连拍出十八掌",
        "dodge"  : 10, 
        "parry"  : 10,
        "sen"    : 5,
        "jibie"  : 70,
        "damge"  : 80,
        "wound"  : 45,
        "zhoshi" : "「吕洞宾醉酒戏牡丹」",
        "damage_type" : "淤伤" ]),
    ([  "action" : "$N左跨一步，右跨一步，瞬间来到$n的面前，一招「曹国舅捧笏上\n"
                   "朝」双掌内蕴真力，按向$n",
         "lian"   : "$N左跨一步，右跨一步，一招「曹国舅捧笏上朝」双掌内蕴真力缓\n"
                    "缓推出",
        "dodge"  : 10, 
        "parry"  : 10,
        "sen"    : 5,
        "jibie"  : 80,
        "damge"  : 85,
        "wound"  :50,
        "zhoshi" : "「曹国舅捧笏上朝」",
        "damage_type" : "淤伤" ]),
    ([  "action" : "$N笑嘻嘻的看着$n，双掌相合，使出一招「蓝采和击板行歌」，只见$N\n"
                   "吐声发力，双掌向$n推出，一股劲力夹着「啪、啪」的声音向$n卷去",
         "lian"   : "$N双掌相合，使出一招「蓝采和击板行歌」，只见$N吐声发力，双掌\n"
                "向前推出，一股劲力夹着「啪、啪」的声音向前涌去",
        "dodge"  : 10, 
        "parry"  : 10,
        "sen"    : 5,
        "jibie"  : 80,
        "damge"  : 90,
        "wound"  : 50,
        "zhoshi" : "「蓝采和击板行歌」",
        "damage_type" : "淤伤" ]),
});
}

string *get_all_parry_msg()
{
    return ({
        "$n左脚一收，身体向左倾斜，使出一招「汉钟离玉洞论道」，右手上\n"
        "架，身形向左闪开",
        "$n双掌一错，在身前一封，一招「韩湘子风雪拥蓝关」封住$n的门户",
        "$n一个趔趄，如醉酒一般向一侧跌出，一招「吕洞宾醉酒戏牡丹」双掌\n"
        "接连拍出，化解了$N的攻势",
    });
}

string *get_all_unarmed_msg()
{
    return ({
        "$n左脚一收，身体向左倾斜，使出一招「汉钟离玉洞论道」，右手上\n"
        "架，身形向左闪开",
        "$n双掌一错，在身前一封，一招「韩湘子风雪拥蓝关」封住$n的门户",
        "$n一个趔趄，如醉酒一般向一侧跌出，一招「吕洞宾醉酒戏牡丹」双掌\n"
        "接连拍出，化解了$N的攻势",
    });
}

