inherit SKILL_UNARMED;

mapping *get_all_action()
{
    return ({
    ([  "action" : "$N双手扬起，轻飘飘一式「叶落」，掌若落叶，向$n的$l拍去",
        "lian"   : "$N双手扬起，轻飘飘一式「叶落」，掌若落叶",
        "zhaoshi": "「叶落」",
        "damage" : 50,
        "wound"  : 15,
        "parry"  : 20,
        "dodge"  : 30,
        "jibie"  : 10,
        "sen"    : 7,
        "damage_type" : "淤伤",
    ]),
    ([  "action" : "$N左脚为轴心，右脚一旋，双手交替挥舞，如竹叶翻飞，正是「叶舞」，向$n的$l拍下",
        "lian"   : "$N左脚为轴心，右脚一旋，双手交替挥舞，如竹叶翻飞，正是「叶舞」",
        "zhaoshi": "「叶舞」",
        "damage" : 60,
        "wound"  : 15,
        "parry"  : 30,
        "dodge"  : 10,
        "jibie"  : 20,
        "sen"    : 8,
        "damage_type" : "淤伤",
    ]),
    ([  "action" : "$N身体高高跃起，左手立在胸前，右臂微曲，使一招「叶飘零」，向$n的$l和面门打去",
        "lian"   : "$N身体高高跃起，左手立在胸前，右臂微曲，使一招「叶飘零」",
        "zhaoshi":"「叶飘零」",
        "damage" : 60,
        "wound"  : 20,
        "parry"  : 30,
        "dodge"  : 30,
        "jibie"  : 25,
        "sen"    : 9,
        "damage_type" : "淤伤",
    ]),
    ([  "action" : "$N微一运劲，双掌青筋爆露，一式「枯叶」，将$n浑身上下都笼罩在重重掌影之中",
        "lian"   : "$N微一运劲，双掌青筋爆露，一式「枯叶」，向前拍出",
        "zhaoshi":"「枯叶」",
        "damage" : 90,
        "wound"  : 15,
        "parry"  : 30,
        "dodge"  : 30,
        "jibie"  : 40,
        "sen"    : 10,
        "damage_type" : "淤伤",
    ]),
    ([  "action" : "$N双掌平摊，左掌缓缓收至肩，右掌猛向前推出，\n掌风带着破空声，一招「弹枝」，如竹枝反弹，直奔$n心窝而去",
        "lian"   : "$N双掌平摊，左掌缓缓收至肩，右掌猛向前推出，\n掌风带着破空声，一招「弹枝」，如竹枝反弹",
        "zhaoshi":"「弹枝」",
        "damage" : 100,
        "parry"  : 60,
        "dodge"  : 0,
        "jibie"  : 40,
        "sen"    : 10,
        "damage_type" : "淤伤",
    ]),
    ([  "action" : "$N突然收掌，由腹部向前向上推出，掌风如涛，一式「叶如潮」，一片劲风直逼$n",
        "lian"   : "$N突然收掌，由腹部向前向上推出，掌风如涛，一式「叶如潮」",
        "zhaoshi":"「叶如潮」",
        "damage" : 130,
        "wound"  : 90,
        "parry"  : 30,
        "dodge"  : 20,
        "jibie"  : 30,
        "sen"    : 11,
        "damage_type" : "淤伤",
    ])
});
}

