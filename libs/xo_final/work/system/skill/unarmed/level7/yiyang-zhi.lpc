string *get_all_parry_msg()
{
    return ({
        "$n一指直趋他喉下七突穴，那是致命死穴，$N只得全力反击",
        "蓦地里一股劲风已无声无息的袭到，振开了$N的$w",
        "突然间$n变掌为指，嗤的一声响，使出一阳指力，疾点$w。两股力道\n"
        "在空中一碰，$n和$N都倒退了一步",
    });
}

string *get_all_unarmed_msg()
{
    return ({
        "$n不敢怠慢，大拇指一翘，捺了过去，将$N逼退",
        "$n急运真气，食指迎了上去，双方身子都是一幌",
    });
}

int valid_learn(object me)
{
    if(me->query("max_force")<1800 || me->query("force")<1800)
    {
        return notify_fail("你内力不够，无法学习一阳指。\n");
    }

    return ::valid_learn(me);
}

