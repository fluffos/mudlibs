inherit SKILL_UNARMED;

mapping *get_all_action()
{
    return ({
    ([  "action" : "$N左手轻轻拨动，右手五指徐徐弹出拨，一式「浪起湖心」，拂向$n的$l",
        "lian"   : "$N左手轻轻拨动，右手五指徐徐弹出拨，一式「浪起湖心」",
        "zhaoshi": "「浪起湖心」",
        "damage" : 50,
        "wound"  : 15,
        "parry"  : 20,
        "dodge"  : 30,
        "jibie"  : 10,
        "sen"    : 7,
        "damage_type" : "淤伤",
    ]),
    ([  "action" : "$N双手上下起落，俯身掠向$n，一式「瀑落清潭」，左手化掌成指，汹涌袭向$n的$l",
        "lian"   : "$N双手上下起落，一式「瀑落清潭」，左手化掌成指",
        "zhaoshi": "「瀑落清潭」",
        "damage" : 60,
        "wound"  : 15,
        "parry"  : 30,
        "dodge"  : 10,
        "jibie"  : 20,
        "sen"    : 8,
        "damage_type" : "淤伤",
    ]),
    ([  "action" : "$N左手由拳变掌，右手扭曲如灵蛇，一式「龟蛇竞渡」，左右并用，拍向$n的$l",
        "lian"   : "$N左手由拳变掌，右手扭曲如灵蛇，一式「龟蛇竞渡」，左右并用",
        "zhaoshi":"「龟蛇竞渡」",
        "damage" : 60,
        "wound"  : 20,
        "parry"  : 30,
        "dodge"  : 30,
        "jibie"  : 25,
        "sen"    : 9,
        "damage_type" : "淤伤",
    ]),
    ([  "action" : "$N一式「倒索攀山」，左手抽回，右手前探，戟指点向$n的$l",
        "lian"   : "$N一式「倒索攀山」，左手抽回，右手前探",
        "zhaoshi":"「倒索攀山」",
        "damage" : 90,
        "wound"  : 15,
        "parry"  : 30,
        "dodge"  : 30,
        "jibie"  : 40,
        "sen"    : 10,
        "damage_type" : "淤伤",
    ]),
    ([  "action" : "$N使一式「闪现雷鸣」，身影变幻不定地掠至$n身后，猛地拍向$n的$l",
        "lian"   : "$N使一式「闪现雷鸣」，身影变幻不定",
        "zhaoshi":"「闪现雷鸣」",
        "damage" : 100,
        "parry"  : 60,
        "dodge"  : 0,
        "jibie"  : 60,
        "sen"    : 10,
        "damage_type" : "淤伤",
    ]),
    ([  "action" : "$N两臂大开大阖，吸一口气，一式「地动山摇」，劲力透彻，双手快
速一拨，激出数道劲气逼向$n的$l",
        "lian"   : "$N两臂大开大阖，吸一口气，一式「地动山摇」，劲力透彻，双手快
速一拨，激出数道劲气",
        "zhaoshi":"「地动山摇」",
        "damage" : 130,
        "wound"  : 90,
        "parry"  : 30,
        "dodge"  : 20,
        "jibie"  : 80,
        "sen"    : 11,
        "damage_type" : "淤伤",
    ]),
    ([  "action" : "$N身形纵起，衣袂飘荡，双手轻轻拍动，一式「水拍云崖」，居高临
下，连绵不绝拍向$n的$l",
        "lian"   : "$N身形纵起，衣袂飘荡，双手轻轻拍动，一式「水拍云崖」，居高临
下，连绵不绝",
        "zhaoshi":"「水拍云崖」",
        "damage" : 130,
        "wound"  : 90,
        "parry"  : 30,
        "dodge"  : 20,
        "jibie"  : 100,
        "sen"    : 11,
        "damage_type" : "淤伤",
    ]),
    ([  "action" : "$N腾空而起，双掌合一，十指如钩，一招「泰山压顶」，疾向$n的击
落，势道凶猛已极",
        "lian"   : "$N腾空而起，双掌合一，十指如钩，一招「泰山压顶」",
        "zhaoshi":"「泰山压顶」",
        "damage" : 130,
        "wound"  : 90,
        "parry"  : 30,
        "dodge"  : 20,
        "jibie"  : 150,
        "sen"    : 11,
        "damage_type" : "淤伤",
    ]),
});
}

