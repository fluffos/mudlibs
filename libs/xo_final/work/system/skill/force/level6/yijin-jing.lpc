#include <ansi.h>

inherit FORCE_YANG;

int valid_learn(object me)
{
    if ( me->query("family/family_name") != "少林派" )
    {
        return notify_fail("这位施主，开什么玩笑。\n");
    }

    if ( me->query("gender") != "男性" )
    {
        return notify_fail(chinese_name() + "只有男性才能学。\n");
    }

    if ( me->query("have_married") )
    {
        return notify_fail("你非童男之体，不能练习" + chinese_name() + "。\n");
    }

    if ( me->query_jibie("banruo-xinfa") < me->query_jibie("yijin-jing") / 2 )
    {
        return notify_fail("你的" + to_chinese("banruo-xinfa") + "还没有练好呢！\n");
    }

    return ::valid_learn(me);
}

int valid_xiulian(object me)
{
    if ( me->query("family/family_name") != "少林派" )
    {
        return notify_fail("这位施主，开什么玩笑。\n");
    }

    if ( me->query("gender") != "男性" )
    {
        return notify_fail(chinese_name() + "只有男性才能学。\n");
    }

    if ( me->query("shaolin/announced") )
    {
        return notify_fail("你尝试着静思入定，可不知为什么，总是觉得很烦躁。\n");
    }

    return ::valid_xiulian(me);
}

