#include <ansi.h>

inherit FORCE_YANG;

string *parry_msg = ({
  "$n双臂一震，内力游走全身，$N根本不可近身。",
  "$n长袖一甩，一股大力将$N送出丈外。",
  "$n凝聚内力，轻描淡写地化解了$N的攻势。",
});

string *absorb_msg = ({
  "$n身体微蹲，双臂一张，浑厚的九阳神功游走全身。",
  "$n施展出九阳神功，浑身坚如寒铁。",
  "$n身型微展，九阳神功充斥了丈许空间。",
});

int valid_learn(object me) {
  if (me->query("gender") != "男性"
    || me->query("have_married")) {
    return notify_fail("你非童男之体，不能练习九阳神功。\n");
  }

  return ::valid_learn(me);
}

string query_parry_msg(object weapon) {
  return parry_msg[random(sizeof(parry_msg))];
}

string query_absorb_msg() {
  return absorb_msg[random(sizeof(absorb_msg))];
}
