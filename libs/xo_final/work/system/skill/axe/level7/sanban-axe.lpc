inherit SKILL_LONG;

mapping *get_all_action() {
  return ({
    ([ "zhaoshi": "「开瓜」",
      "action": "$N大喊一声「开瓜」，手中$w带着这一吼的威猛之势，朝$n当头劈下",
      "lian": "$N大喊一声「开瓜」，手中$w带着这一吼的威猛之势，当头劈下",
      "jibie": 10,
      "sen": 3,
      "dodge": 0,
      "parry": 0,
      "damage": 55,
      "wound": 40,
      "damage_type": "砍伤"
    ]),
    ([ "zhaoshi": "「剔牙」",
      "action": "$N大喊一声「剔牙」，顺势带过大斧，趁$n一愣之际，以斧尾护手刀向$n面门疾戳",
      "lian": "$N大喊一声「剔牙」，顺势带过大斧，以斧尾护手刀疾戳",
      "jibie": 15,
      "sen": 2,
      "dodge": 10,
      "parry": 10,
      "damage": 60,
      "wound": 55,
      "damage_type": "砍伤"
    ]),
    ([ "zhaoshi": " 「掏耳朵」",
      "action":
      "$N大喊一声「掏耳朵」，翻转斧头，手中$w划出一道银弧，奔着$n的脑袋横劈",
      "lian":
      "$N大喊一声「掏耳朵」，翻转斧头，手中$w划出一道银弧横劈",
      "jibie": 25,
      "limb": "腿部",
      "sen": 4,
      "dodge": 0,
      "parry": 20,
      "damage": 70,
      "damage_type": "砍伤"
    ]),
    ([ "zhaoshi": "「捅」",
      "action": "$N大喊一声「捅」，趁$n换招中的空隙，以斧尾护手刀向$n的$l狠狠戳了下去",
      "lian": "$N大喊一声「捅」，以斧尾护手刀狠狠戳了下去",
      "jibie": 33,
      "sen": 3,
      "dodge": 10,
      "parry": 10,
      "damage": 75,
      "wound": 65,
      "damage_type": "砍伤"
    ]),
  });
}

string query_weapon_type() {
  return "axe";
}
