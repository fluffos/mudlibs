inherit SKILL_LONG;

mapping *get_all_action() {
  return ({
    ([ "action": "$N纵步上前，手中$w自下而上，沉猛无比地向$n的小腹挑去",
      "lian": "$N纵步上前，手中$w自下而上，沉猛无比地挑去",
      "jibie": 10,
      "sen": 3,
      "dodge": 0,
      "parry": 0,
      "damage": 55,
      "wound": 40,
      "damage_type": "砍伤"
    ]),
    ([ "action": "$N快步跨出，左手平托$w，右掌猛推杖端，顶向$n的胸口",
      "lian": "$N快步跨出，左手平托$w，右掌猛推杖端",
      "jibie": 15,
      "sen": 2,
      "dodge": 10,
      "parry": 10,
      "damage": 60,
      "wound": 55,
      "damage_type": "砍伤"
    ]),
    ([ "action":
      "$N高举$w，全身跃起，手中$w朝着$n头盖天灵盖猛然击落下去",
      "lian":
      "$N高举$w，全身跃起，手中$w猛然击落下去",
      "jibie": 25,
      "limb": "腿部",
      "sen": 4,
      "dodge": 0,
      "parry": 20,
      "damage": 70,
      "damage_type": "砍伤"
    ]),
    ([ "action": "$N双手持杖如橹，对准$n猛地一搅，如同平地刮起一阵旋风",
      "lian": "$N双手持杖如橹，猛地一搅，如同平地刮起一阵旋风",
      "jibie": 33,
      "sen": 3,
      "dodge": 10,
      "parry": 10,
      "damage": 75,
      "wound": 65,
      "damage_type": "砍伤"
    ]),
    ([ "action": "$N横持$w，杖端化出无数个圆圈，凝滞沉重，把$n缠在其中",
      "lian": "$N横持$w，杖端化出无数个圆圈，凝滞沉重",
      "jibie": 40,
      "limb": "面门",
      "sen": 4,
      "dodge": 10,
      "parry": 20,
      "damage": 95,
      "wound": 70,
      "damage_type": "砍伤"
    ]),
    ([ "action":
      "$N全身滚倒，$w盘地横飞，化出漫天杖影，杖影把$n裹了起来",
      "lian":
      "$N全身滚倒，$w盘地横飞，化出漫天杖影",
      "jibie": 50,
      "limb": "腿部",
      "sen": 4,
      "dodge": 0,
      "parry": 20,
      "damage": 70,
      "damage_type": "砍伤"
    ]),
    ([ "action": "$N双手和十，躬身一递出$w，只见$w自肘弯飞出，拦腰向$n撞去",
      "lian": "$N双手和十，躬身一递出$w，只见$w自肘弯飞出",
      "jibie": 80,
      "sen": 3,
      "dodge": 10,
      "parry": 10,
      "damage": 75,
      "wound": 65,
      "damage_type": "砍伤"
    ]),
    ([ "action": "$N大喝一声，手中$w如飞龙般自掌中跃出，直向$n的胸口穿入",
      "lian": "$N大喝一声，手中$w如飞龙般自掌中跃出",
      "jibie": 100,
      "limb": "面门",
      "sen": 4,
      "dodge": 10,
      "parry": 20,
      "damage": 95,
      "wound": 70,
      "damage_type": "砍伤"
    ]),
  });
}

string query_weapon_type() {
  return "axe";
}
