inherit SKILL_DODGE;

mapping *get_all_action()
{
    return ({
    ([ "action":"但是$n身形飘忽，轻轻一纵，一招「野狗扑食」，举重若轻的避开这一击",
       "lian"  :"$N身形飘忽，轻轻一纵，一招「野狗扑食」",
       "jibie" :5,
       "sen"   :2, ]),
    ([ "action":"$n身随意转，一式「野狗斜纵」，倏地往一旁挪开了三尺，避过了这一招",
       "lian"  :"$N身随意转，一式「野狗斜纵」，倏地往一旁挪开了三尺",
       "jibie" :10,
       "sen"   :2, ]),
    ([ "action":"可是$n侧身一让，使出「野狗打滚」，$N这一招扑了个空",
       "lian"  :"$N侧身一让，使出「野狗打滚」",
       "jibie" :20,
       "sen"   :2, ]),
    ([ "action":"却见$n足不点地，一招「野狗上蹿」，往旁窜开数尺，躲了开去",
       "lian"  :"$N足不点地，一招「野狗上蹿」，往旁窜开数尺",
       "jibie" :30,
       "sen"   :3, ]),
    ([ "action":"$n身形微晃，使出「野狗下跳」，有惊无险地避开了$N这一招",
       "lian"  :"$N身形微晃，使出「野狗下跳」",
       "jibie" :40,
        "sen"  :3, ]),
    ([ "action":"$n身形往上一拔，一招「野狗左摇」，一个转折落在数尺之外",
       "lian"  :"$N身形往上一拔，一招「野狗左摇」，一个转折落在数尺之外",
       "jibie" :50,
       "sen"   :3, ]),
});
}

