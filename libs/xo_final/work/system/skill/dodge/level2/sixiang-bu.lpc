#include <ansi.h>

inherit SKILL_DODGE;

mapping *get_all_action() {
  return ({
    ([ "action": "$n一式" GRN "「斜燕归林去」" NOR "，身体如雨燕投林般直滑出丈余",
      "lian": "$N提气在胸，收腹提肩，一个" GRN "「斜燕归林去」" NOR "，高高跃起",
      "jibie": 5,
      "sen": 2, ]),
    ([ "action": "$n一式" MAG "「花蝶戏蕊心」" NOR "，忽然一弯腰，全身凌空而行，顿时闪过了$N的凌厉攻势",
      "lian": "$N足下一蹬，一个" MAG "「花蝶戏蕊心」" NOR "向后退去，险些扭伤了足踝",
      "jibie": 10,
      "sen": 2, ]),
    ([ "action": "$n一式" HIY "「黄雀啄叶露」" NOR "，足不动，手不抬，一转眼间便绕到了$N的身后",
      "lian": "$N双足一点，一个" HIY "「黄雀啄叶露」" NOR "，蹿起三尺来高",
      "jibie": 20,
      "sen": 2, ]),
    ([ "action": "$n一式" GRN "「青蜂弄花粉」" NOR "，一转身间，四面八方飘动着无数个$n的身影，令$N手足无措",
      "lian": "$N把握住身体的平衡，借着踢腿的力量，向旁边一跃",
      "jibie": 30,
      "sen": 3, ]),
    ([ "action": "$n一式" HIW "「蜓尾点水舞」" NOR "，长袖一拂，全身化为一道白影，幽幽地从$N头顶飘落",
      "lian": "$N向高空里一纵身，跃起五尺来高",
      "jibie": 40,
      "sen": 3, ]),
    ([ "action": "$n一式" MAG "「知了藏影踪」" NOR "，身行倏的从$N的眼前飘过，长发一甩，潇洒之极",
      "lian": "$N跃起五尺，一招" MAG "「知了藏影踪」" NOR "，轻轻落下地来",
      "jibie": 50,
      "sen": 3, ]),
  });
}
