inherit SKILL_DODGE;

mapping *get_all_action() {
  return ({
    ([ "action": "$n纵身一跳，一式「行神如空」轻轻躲了开去",
      "lian": "$N提气在胸，收腹提肩，纵身一越，一式「行神如空」，只跳起二尺来高",
      "jibie": 8,
      "sen": 2, ]),
    ([ "action": "$n猛的一闪身，使一招「走云连风」，向后跳开数尺",
      "lian": "$N以足尖点地，使一招「走云连风」，大步跨出数尺，险些扭伤了足踝",
      "jibie": 16,
      "sen": 2, ]),
    ([ "action": "$n双脚轻点，一个「巫峡千寻」，身形向后一退",
      "lian": "$N提气丹田，一个「巫峡千寻」，平地拔起三尺",
      "jibie": 24,
      "sen": 3, ]),
    ([ "action": "$n轻飘飘地向旁边一闪，$N的凌厉攻势尽数落在了空里",
      "lian": "$N把握住身体的平衡，借着踢腿的力量，向旁边一跃",
      "jibie": 32,
      "sen": 2, ]),
    ([ "action": "$n向高空里一纵身，一招「蓄素守中」，跃起五尺来高",
      "lian": "$N向高空里一纵身，一招「蓄素守中」，跃起五尺来高",
      "jibie": 40,
      "sen": 2, ]),
    ([ "action": "$n用力一拔，一招「行气如虹」，从$N头上跃了过去",
      "lian": "$N跃起五尺，在空中一个转折，轻轻落下地来",
      "jibie": 48,
      "sen": 3, ]),
    ([ "action": "$n低头侧身，蜷腿一纵，一个「饮真茹强」，向旁边跃开七尺",
      "lian": "$N低头侧身，蜷腿一纵，一个「饮真茹强」，向旁边跃开七尺",
      "jibie": 56,
      "sen": 2, ]),
  });
}
