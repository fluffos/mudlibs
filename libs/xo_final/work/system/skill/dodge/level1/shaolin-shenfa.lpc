  return ({
    ([
      "action":
      "$N纵身一跳，闪身躲了开去.......",
      "lian":
      "$N提气在胸，收腹提肩，纵身一越，只跳起二尺来高。。",
      "jibie": 8,
      "sen": 5,
    ]),
    ([ "action":
      "$N猛的一闪身，向后跳开数尺.....",
      "lian":
      "$N以足尖点地，大步跨出数尺，险些扭伤了足踝..",
      "jibie": 15,
      "sen": 5,
    ]),
    ([
      "action":
      "$N轻飘飘地向旁边一闪，$n的凌厉攻势尽数落在了空里。",
      "lian":
      "$N把握住身体的平衡，借着踢腿的力量，向旁边一跃。",
      "jibie": 25,
      "sen": 5,
    ]),
    ([
      "action":
      "$N向高空里一纵身，跃起五尺来高。。。",
      "lian":
      "$N向高空里一纵身，跃起五尺来高。。。",
      "jibie": 33,
      "sen": 5,
    ]),
    ([
      "action":
      "$N低头侧身，蜷腿一纵，向旁边跃开七尺。。",
      "lian":
      "$N低头侧身，蜷腿一纵，向旁边跃开七尺。。",
      "jibie": 40,
      "sen": 6,
    ]),
  });
