inherit SKILL_DODGE;

mapping *get_all_action()
{
    return ({
        ([
                "zhaoshi" : "「梅花照雪」",
                "action":
"$n使出一招「梅花照雪」，倒踩连环，连退两步.......",
                "lian" :
"$N使出一招「梅花照雪」，倒踩连环，连退两步，踏到最后面一根木桩上，险些摔下去",
                "jibie":          8,
                "sen"  :      3,
        ]),
        ([      "zhaoshi" :"「乾坤易位」",
                "action":
"$n一招「乾坤易位」，倒转身体，脚下一扭，一个纵步，飞飘开去",
                "lian" :
"$N一招「乾坤易位」，倒转身体，脚下一扭，一个纵步，跳到对面的桩子上，摇晃了一下",
                "jibie":15,
                "sen"  :3,
        ]),
        ([      "zhaoshi" :"「反足跳」",
                "action":
"$n一招「反足跳」，身子向右急侧，一个闪身，避过了$N的攻势",
                "lian" :
"$N一招「反足跳」，身子向右急侧，闪身反足退步，双脚交叉，分别挪动一个木桩",
                "jibie":25,
                "sen"  : 4,
        ]),
        ([      "zhaoshi" : "「撤步飞龙」",
                "action":
"$n旋了一个大圈，然后一个「撤步飞龙」，飘然转下身来，落到$N身后",
                "lian" :
"$N一蹬脚下的木桩，一个倒旋，使出了「撤步飞龙」，全凭直觉倒纵开去，踩上了一根木桩",
                "jibie":33,
                "sen"  : 4,
        ]),
        ([      "zhaoshi" : "「零落香尘」",
                "action":
"$n一式「零落香尘」，左腿为轴，右腿带动全身迅速地旋转起来",
                "lian" :
"$N一式「零落香尘」，左腿为轴，右腿带动全身迅速地旋转起来，稳稳地踏在另一根木桩上",
                "jibie":40,
                "sen"  : 3,
        ]),
        ([      "zhaoshi" : "「寒舍枝红」",
                "action":
"$n一式「寒舍枝红」，$N只觉得眼前一花，$n的身子已经腾空而起，翻身侧闪，从$N身\n"
"边一晃而过",
                "lian" :
"$N一式「寒舍枝红」，身子已经腾空而起，翻身侧闪，一个健步轻轻地落在一根桩子上",
                "jibie":50,
                "sen"  : 4,
        ]),
        ([      "zhaoshi" : "「反走八卦」",
                "action":
"$n身子一转，一式「反走八卦」，脚下踏着八卦的方位倒转起来",
                "lian" :
"$N身子一转，一式「反走八卦」，脚下踏着八卦的方位倒转起来，在晃动着的梅花桩上快\n"
"速行走着",
                "jibie":60,
                "sen"  : 3,
        ]),
});
}

