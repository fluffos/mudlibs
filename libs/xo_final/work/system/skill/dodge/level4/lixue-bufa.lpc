inherit SKILL_DODGE;

mapping *get_all_action()
{
    return ({
([     
    "action": "$n一招「阳春白雪」，$N只觉眼前一花，不见了$n的身影",
    "lian" :  "$N一招「阳春白雪」，身形飘浮不定，难以捉摸",
    "jibie": 6,
    "sen"  : 4,
]),
([     
    "action": "只见$n身子向后一翻，一招「月白风清」，后荡而起，掠向一旁",
    "lian" : "$N身子向后一翻，一招「月白风清」，后荡而起，掠向一旁",
    "jibie": 15,
    "sen"  : 3,
]),
([     
    "action": "却见$n「一飞冲天」，冲天而起，一波三折，端是美观",       
    "lian" : "$N一式「一飞冲天」，冲天而起，一波三折，端是美观",
    "jibie": 25,
    "sen"  : 3,
]),
([     
    "action":  "只见$n一招「左右逢源」，倒掠身形，凌空两个翻转，退出两丈开外",
    "lian" : "$N一招「左右逢源」，倒掠身形，凌空两个翻转，退出两丈开外",
    "jibie": 40,
    "sen"  : 4,
]),
([     
    "action":  "$n息气上升，意存玉枕，一招「莺歌燕舞」，身子飘然而起",
    "lian" : "$N息气上升，意存玉枕，一招「莺歌燕舞」，身子飘然而起",
    "jibie": 65,
    "sen"  : 4,
]),
});
}

int valid_learn(object me)
{
    if ( me->query_jibie("buddhism") < 80 )
    {
        return notify_fail("你的佛学修为不够，强练绝技会伤及身体。\n");
    }

    return ::valid_learn(me);
}

