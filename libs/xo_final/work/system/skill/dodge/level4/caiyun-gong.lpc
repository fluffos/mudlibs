inherit SKILL_DODGE;

mapping *get_all_action() {
  return ({
    ([
      "zhaoshi": "「彩云追月」",
      "action":
      "$n纵身一跳，一招「彩云追月」，轻轻松松躲了开去.......",
      "lian":
      "$N提气在胸，一招「彩云追月」，纵身一跃，飘至半空",
      "jibie": 8,
      "sen": 5,
    ]),
    ([ "zhaoshi": "「夸夫追日」",
      "action":
      "$n猛的一闪身，使一招「夸夫追日」，向后退出数丈.....",
      "lian":
      "$N向旁边猛的一闪，想使一招「夸夫追日」，却滑了一下，险些摔倒",
      "jibie": 15,
      "sen": 3,
    ]),
    ([ "zhaoshi": "「红霞映日」",
      "action":
      "$n一招「红霞映日」，轻飘飘地飞到半空，躲过了$N的凌厉攻势",
      "lian":
      "$N使劲一蹬腿，往上一招「红霞映日」，身体往上一直蹿去",
      "jibie": 25,
      "sen": 4,
    ]),
    ([ "zhaoshi": "「湘江水翻」",
      "action":
      "$n旋了一个大圈，然后一个「湘江水翻」，飘然转下身来，落到$N身后",
      "lian":
      "$N一蹬地，使劲一旋，一个「湘江水翻」飘然而下",
      "jibie": 33,
      "sen": 5,
    ]),
    ([ "zhaoshi": "「巫山云雨」",
      "action":
      "$n昂头向上一纵，一式「巫山云雨」飘到空中，在空中转了两个大圈，躲了过去",
      "lian":
      "$N低头侧身，昂头向上一纵，一式「巫山云雨」，在空中转了两个大圈",
      "jibie": 40,
      "sen": 4,
    ]),
    ([ "zhaoshi": "「飞彩流黄」",
      "action":
      "$n一式「飞彩流黄」，$N只觉得眼前一花，$n的身子已经腾空而起，翻身侧闪，从$N身边一晃而过",
      "lian":
      "$N一式「飞彩流黄」，身子已经腾空而起，翻身侧闪",
      "jibie": 50,
      "sen": 4,
    ]),
    ([ "zhaoshi": "「天光飞虹」",
      "action":
      "$n转过身子，一式「天光飞虹」从$N头顶一越而过",
      "lian":
      "$N一式「天光飞虹」，转身腾空，身形急晃，如同闪电以一般",
      "jibie": 60,
      "sen": 6,
    ]),
  });
}

int valid_lian(object me) {
  if (me->query("force") < 10)
    return notify_fail("你的内力没有了，还是先歇歇吧。\n");

  if (me->query("kee") < 10)
    return notify_fail("这么不要命的练呀，还是歇歇吧。\n");

  if (me->query("max_force") < 500)
    tell_object(me, "你内力不够，如果练习或使用这门功夫，会对身体有害\n");

  return ::valid_lian(me);
}

int valid_learn(object me) {
  if (!me->query("marks/lin/送官"))      //如果没有学功夫的标记
  {
    tell_object(me, "武林中人，要多为朝廷办事。\n");
    return 0;
  }

  return 1;
}
