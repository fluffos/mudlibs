inherit SKILL_DODGE;

mapping *get_all_action() {
  return ({
    ([
      "action":
      "只见$n一个游龙转身，一招「天淡云闲」，潇洒地往旁边躲开了$N的这一招",
      "lian":
      "$N一个游龙转身，一招「天淡云闲」，潇洒地往旁边飘出一丈",
      "jibie": 5,
      "sen": 4,
      "dodge": 0,
      "parry": 0,
      "damage": 10,
      "damage_type": "瘀伤"
    ]),
    ([ "action":
      "$n使出一招「困倚危楼」，象是全身无力似的，飘飘欲倒，但就在千钧一发之际，确躲开了$N的进攻",
      "lian":
      "使出一招「困倚危楼」，象是全身无力似的，飘飘欲倒",
      "jibie": 20,
      "sen": 8,
      "dodge": 0,
      "parry": 0,
      "damage": 20,
      "damage_type": "瘀伤"
    ]),
    ([
      "action":
      "$n身形微晃，一招「疏星淡月」，有惊无险地避开了$N这一招",
      "lian":
      "$N身形微晃，一招「疏星淡月」，向一边闪去",
      "jibie": 35,
      "sen": 12,
      "dodge": 0,
      "parry": 0,
      "damage": 30,
      "damage_type": "瘀伤"
    ]),
    ([
      "action":
      "$n漫不经心的向左一个「断云微渡」，刚好避过$N的凌厉攻势",
      "lian":
      "$N漫不经心的向左一个「断云微渡」飘了过去",
      "jibie": 50,
      "sen": 16,
      "dodge": 0,
      "parry": 0,
      "damage": 40,
      "damage_type": "瘀伤"
    ]),
    ([
      "action":
      "$n身形向后一纵，使出一招「帘卷西风」，避过了$N的攻击",
      "lian":
      "$N身形向后一纵，使出一招「帘卷西风」，退后丈馀",
      "jibie": 65,
      "sen": 20,
      "dodge": 0,
      "parry": 0,
      "damage": 50,
      "damage_type": "瘀伤"
    ]),
    ([
      "action":
      "可是$n使一招「回首坐云中」，身子轻轻飘了开去",
      "lian":
      "$N使一招「回首坐云中」，身子轻轻向后飘了开去",
      "jibie": 70,
      "sen": 24,
      "dodge": 0,
      "parry": 0,
      "damage": 60,
      "damage_type": "瘀伤"
    ]),
  });
}
