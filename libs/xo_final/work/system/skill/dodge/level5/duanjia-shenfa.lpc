inherit SKILL_DODGE;

mapping *get_all_action() {
  return ({
    ([ "action": "$n脚下连点，一式「蚂蚁上树」轻轻巧巧地躲了开去",
      "lian": "$N一式「蚂蚁上树」，脚下连点，结果踩了自己一脚",
      "jibie": 20,
      "sen": 2, ]),
    ([ "action": "$n突然一个箭步，使一招「蜻蜓点水」，倏地跳开数尺",
      "lian": "$N以一足点地，要使一招「蜻蜓点水」，只是脚下不稳摔倒在地",
      "jibie": 40,
      "sen": 3, ]),
    ([ "action": "$n一个「猴子打架」，身子左三晃，右三晃，不偏不倚地躲开了$N的进攻",
      "lian": "$N使出一个「猴子打架」，身子左三晃，右三晃，不小心跌了一跤",
      "jibie": 60,
      "sen": 3, ]),
    ([ "action": "$n向高空里一跃，一招「小鸡啄米」，从$N头顶掠过",
      "lian": "$N欲用一招「小鸡啄米」，向高空里一跃，结果只在地上打了个滚",
      "jibie": 80,
      "sen": 4, ]),
    ([ "action": "$n双臂一收，一个「大鹏展翅」，身子急旋而上，直冲天空",
      "lian": "$N双臂一收，想着「大鹏展翅」，身子急旋而上，可惜晕倒在地",
      "jibie": 100,
      "sen": 5, ]),
    ([ "action": "$n身形突变，一招「鸳鸯戏水」，身子轻盈的飘动，忽地转到了你背后",
      "lian": "$N身形突变，一招「鸳鸯戏水」，身子急旋而上，可惜不小心绊了一下右脚，差点跌到",
      "jibie": 120,
      "sen": 6, ]),
  });
}
