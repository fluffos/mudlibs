inherit SKILL_DODGE;

mapping *get_all_action() {
  return ({
    ([ "action": "$n足跟一支，全身后仰，一招「鲤鱼倒穿波」，反窜出丈余，躲过了$N的攻击",
      "lian": "$N足跟一支，全身后仰，一招「鲤鱼倒穿波」，反窜出丈余",
      "jibie": 20,
      "zhaoshi": "「鲤鱼倒穿波」",
      "sen": 2, ]),
    ([ "action": "$n身体忽然柔若无骨，左右摇摆，使出一招「雨打漂萍」，避过了$N的攻击",
      "lian": "$N身体忽然柔若无骨，左右摇摆，使出一招「雨打漂萍」",
      "jibie": 40,
      "zhaoshi": "「雨打漂萍」",
      "sen": 3, ]),
    ([ "action": "$n使出「物换星移」，滴溜溜一个转身，从$N身旁擦身而过，反而到了$N身后",
      "lian": "$N使出「物换星移」，滴溜溜一个转身",
      "jibie": 60,
      "zhaoshi": "「物换星移」",
      "sen": 3, ]),
    ([ "action": "$n一招「落叶随风」，身体如一片落叶一般飘了出去，身行之潇洒，迅速到了极处",
      "lian": "$N一招「落叶随风」，身体如一片落叶一般飘了出去，身行之潇洒，迅速到了极处",
      "jibie": 80,
      "zhaoshi": "「落叶随风」",
      "sen": 4, ]),
  });
}
