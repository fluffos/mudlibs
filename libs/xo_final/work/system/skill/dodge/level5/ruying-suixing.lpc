inherit SKILL_DODGE;

mapping *get_all_action() {
  return ({
    ([
      "action": "但见$n脚尖轻轻一点，一招「杯弓蛇影」，飞身从$N头顶越过",
      "lian": "$N脚尖轻轻一点，一招「杯弓蛇影」，飞身跃起",
      "jibie": 8,
      "sen": 3,
    ]),
    ([
      "action": "$n身形飘忽，使出一式「斗折蛇行」，忽左忽右",
      "lian": "$N身形飘忽，使出一式「斗折蛇行」，忽左忽右",
      "jibie": 16,
      "sen": 3,
    ]),
    ([
      "action": "$n一式「浮光掠影」，身形犹如闪电，前后左右飘浮不定",
      "lian": "$N一式「浮光掠影」，身形犹如闪电，前后左右飘浮不定",
      "jibie": 25,
      "sen": 3,
    ]),
    ([
      "action": "$n一招「形影不离」，斜跨出去，身形紧贴$N身后",
      "lian": "$N一招「形影不离」，斜跨出去，左闪又避",
      "jibie": 32,
      "sen": 2,
    ]),
    ([
      "action": "$n一招「虚无缥缈」，身形飞转，突然由一变百，难辨真假",
      "lian": "$N一招「虚无缥缈」，身形飞转，突然由一变百，难辨真假",
      "jibie": 42,
      "sen": 4,
    ]),
  });
}

int valid_learn(object me) {
  if (me->query_jibie("buddhism") < 100) {
    return notify_fail("你的佛学修为不够，强练绝技会伤及身体。\n");
  }

  return ::valid_learn(me);
}
