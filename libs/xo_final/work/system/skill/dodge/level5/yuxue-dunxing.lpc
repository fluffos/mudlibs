#include <ansi.h>

inherit SKILL_DODGE;

mapping *get_all_action()
{
    return ({
    ([ "action": "$n一式"HIW"「雪地莲花」"NOR"，身子掣忽一转，$N只觉的眼前一花，失去了目标",
       "lian"  : "$N一式"HIW"「雪地莲花」"NOR"，身子掣忽一转",
       "jibie" : 20,
       "zhaoshi":   HIW"「雪地莲花」"NOR,
       "sen"   : 2, ]),
    ([ "action": "$n一式"HIY"「一狐冲天」"NOR"，双脚点地，身子突然拔高了丈许，缓缓飘落在$N身后",
       "lian"  : "$N一式"HIY"「一狐冲天」"NOR"，双脚点地，身子突然拔高了丈许",
       "jibie" : 40,
        "zhaoshi":   HIY"「一狐冲天」"NOR,
       "sen"   : 3, ]),
    ([ "action": "$n一式"CYN"「移形换影」"NOR"，身行一晃，顿时无数条身影一下子出现在$N的面前",
       "lian"  : "$N一式"CYN"「移形换影」"NOR"，身行一晃，顿时无数条身影一下子出现",
       "jibie" : 60,
        "zhaoshi":   CYN"「移形换影」"NOR,
       "sen"   : 3, ]),
    ([ "action": "$n一式"MAG"「狡兔三窟」"NOR"，飘然向后一退，躲开$N的凌厉攻势",
       "lian"  : "$N一式"MAG"「狡兔三窟」"NOR"，飘然向后一退",
       "jibie" : 80,
        "zhaoshi":   MAG"「狡兔三窟」"NOR,
        "sen"  : 4, ]),
    ([ "action": "$n一式"BLU"「烟雨飘渺」"NOR"，身体急转，化为一道白光，虚幻不定的出现在$N的周围",
       "lian"  : "$N一式"BLU"「烟雨飘渺」"NOR"，身体急转，化为一道白光，虚幻不定",
       "jibie" : 100,
        "zhaoshi":   BLU"「烟雨飘渺」"NOR,
       "sen"   : 5, ]),
});
}

