#include <ansi.h>

inherit SKILL_DODGE;

mapping *get_all_action() {
  return ({
    ([ "action": "只见$n一招" HIW "「白鹤冲天」" NOR "，身体向上笔直地纵起丈余，躲过了$N这一招",
      "lian": "$N一招" HIW "「白鹤冲天」" NOR "，身体向上笔直地纵起丈余",
      "jibie": 5,
      "zhaoshi": HIW "「白鹤冲天」" NOR,
      "sen": 1, ]),
    ([ "action": "$n一个" BLU "「鹞子翻身」" NOR "，向后纵出数丈之远，避开了$N的凌厉攻势",
      "lian": "$N一个" BLU "「鹞子翻身」" NOR "，向后纵出数丈之远",
      "jibie": 10,
      "zhaoshi": BLU "「鹞子翻身」" NOR,
      "sen": 1, ]),
    ([ "action": "$n使出" HIY "「大鹏展翅」" NOR "，向一旁飘然纵出，轻轻着地",
      "lian": "$N使出" HIY "「大鹏展翅」" NOR "，向一旁飘然纵出，轻轻着地",
      "jibie": 20,
      "zhaoshi": HIY "「大鹏展翅」" NOR,
      "sen": 1, ]),
    ([ "action": "但是$n一招" HIC "「白鹤冲天」" NOR "身形飘忽，轻轻一纵，早已避开",
      "lian": "$N一招" HIC "「白鹤冲天」" NOR "身形飘忽，轻轻一纵",
      "jibie": 30,
      "zhaoshi": HIC "「白鹤冲天」" NOR,
      "sen": 1, ]),
    ([ "action": "$n身随意转，一招" HIB "「鹞子翻身」" NOR "倏地往一旁挪开了三尺，避过了这一招",
      "lian": "$N身随意转，一招" HIB "「鹞子翻身」" NOR "倏地往一旁挪开了三尺",
      "jibie": 40,
      "zhaoshi": HIB "「鹞子翻身」" NOR,
      "sen": 1, ]),
    ([ "action": "可是$n一招" YEL "「大鹏展翅」" NOR "侧身一让，$N这一招扑了个空",
      "lian": "$N一招" YEL "「大鹏展翅」" NOR "侧身一让",
      "jibie": 50,
      "zhaoshi": YEL "「大鹏展翅」" NOR,
      "sen": 1, ]),
    ([ "action": "却见$n足不点地一招" HIC "「白鹤冲天」" NOR "，往旁窜开数尺，躲了开去",
      "lian": "$N足不点地一招" HIC "「白鹤冲天」" NOR "，往旁窜开数尺",
      "jibie": 60,
      "zhaoshi": HIC "「白鹤冲天」" NOR,
      "sen": 1, ]),
    ([ "action": "$n身形微晃，一招" MAG "「鹞子翻身」" NOR "有惊无险地避开了$N这一招",
      "lian": "$N身形微晃，一招" MAG "「鹞子翻身」" NOR,
      "jibie": 70,
      "zhaoshi": MAG "「鹞子翻身」" NOR,
      "sen": 1, ]),
  });
}
