inherit SKILL_DODGE;

mapping *get_all_action() {
  return ({
    ([
      "action": "但见$n脚尖轻轻一点，一招「天马行空」，飞身跃入天空",
      "lian": "$N脚尖轻轻一点，一招「天马行空」，飞身跃入天空",
      "jibie": 20,
      "sen": 5,
    ]),
    ([
      "action": "$n身形随风飘出，一式「斜风细雨」，掠出三丈开外",
      "lian": "$N身形随风飘出，一式「斜风细雨」，掠出三丈开外",
      "jibie": 40,
      "sen": 4,
    ]),
    ([
      "action": "$n一式「一泻千里」，身形犹如闪电，直退出去，衣带飘飞，疑是仙人",
      "lian": "$N一式「一泻千里」，身形犹如闪电，直退出去，衣带飘飞，疑是仙人",
      "jibie": 60,
      "sen": 4,
    ]),
    ([
      "action": "$n一招「啸傲湖山」，身形飞转，直窜入天空",
      "lian": "$N一招「啸傲湖山」，身形飞转，直窜入天空",
      "jibie": 80,
      "sen": 5,
    ]),
    ([
      "action": "$n一招「天花乱坠」，身形直飘出去，尤如一片青云飘浮在空中",
      "lian": "$N一招「天花乱坠」，身形直飘出去，尤如一片青云飘浮在空中",
      "jibie": 100,
      "sen": 4,
    ]),
  });
}

int valid_learn(object me) {

  int budd_jibie, skill_jibie;
  budd_jibie = me->query_jibie("buddhism");
  skill_jibie = me->query_jibie("yiwei-dujiang");

  if (8 * skill_jibie / 25 + 120 > budd_jibie) {
    return notify_fail("你的佛学修为不够，强练绝技会伤及身体。\n");
  }

  if ((int)me->query("max_force") < 1000) {
    return notify_fail("你内力修为不够，不能练一苇渡江。\n");
  }

  return ::valid_learn(me);
}
