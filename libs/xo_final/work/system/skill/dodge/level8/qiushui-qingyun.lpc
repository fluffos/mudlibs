int valid_learn( object who )
{
    if ( who->query("gender") != "男性" )
    {
        return ::valid_learn(who);
    }

    tell_object( who, "此功乃及女柔之大成，阳刚之躯可学乎？谬也\n" );
    return 0;
}

int valid_lian( object me )
{
    if ( me->query("force") < me->query("max_force") / 20 )
    {
        return notify_fail("你的内力不纯，不如先休息一会儿再练。\n");
    }
   
    if ( me->query("kee") < 10 )
    {
        return notify_fail("这么不要命的练呀，还是歇歇吧。\n");
    }
        
    if ( me->query("max_force") < 1500 )
    {
        tell_object( me, "你内力不够，如果练习或使用这门功夫，会对身体有害\n");
    }

    return ::valid_lian(me);
}

