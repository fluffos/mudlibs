#include <ansi.h>

inherit SKILL_DODGE;

mapping *get_all_action()
{
    return ({
    ([  "action" : "$n使出一招"HIC"「心空」"NOR"，身体向侧后飘去 ",
        "lian"   : "$N使出一招"HIC"「心空」"NOR"，身体向侧后飘去 ",
        "jibie"  : 10,
        "sen"    :  5, 
        "zhaoshi": HIC"「心空」"NOR,
    ]),
    ([  "action" : "$n使出一招"HIW"「誓言空」"NOR"，双足一点，跃至数丈之外 ",
        "lian"   : "$N使出一招"HIW"「誓言空」"NOR"，双足一点，跃至数丈之外 ",
        "jibie"  : 20,
        "sen"    :  4, 
        "zhaoshi": HIW"「誓言空」"NOR,
    ]),
    ([  "action" : "$n使出一招"HIM"「莲空」"NOR"，身形一变，滑至$N身后 ",
        "lian"   : "$N使出一招"HIM"「莲空」"NOR"，身形一变 ",
        "jibie"  : 30,
        "sen"    :  5, 
        "zhaoshi": HIM"「莲空」"NOR,
    ]),
    ([  "action" : "$n大吼一声，使出一招"HIG"「大安空」"NOR"，从$N头顶越过 ",
        "lian"   : "$N大吼一声，使出一招"HIG"「大安空」"NOR" ",
        "jibie"  : 40,
        "sen"    :  5, 
        "zhaoshi": HIG"「大安空」"NOR,
    ]),
    ([  "action" : "$n使出一招"HIY"「佛空」"NOR"，如轻鸿般飘去，瞬间又闪至$N面前 ",
        "lian"   : "$N使出一招"HIY"「佛空」"NOR"，如轻鸿般飘去 ",
        "jibie"  : 50,
        "sen"    :  4, 
        "zhaoshi": HIY"「佛空」"NOR,
    ]),
    ([  "action" : "$n使出一招"HIR"「金刚空」"NOR"，顿时$N周围都是$n的身影 ",
        "lian"   : "$N使出一招"HIR"「金刚空」"NOR"，顿时周围都是$N的身影 ",
        "jibie"  : 60,
        "sen"    :  6, 
        "zhaoshi": HIR"「金刚空」"NOR,
    ]),
});
}

