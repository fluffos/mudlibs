inherit SKILL_DODGE;

mapping *get_all_action()
{
    return ({
    ([  "action"  : "$n忽然「咯」的一声喷出口酒气，刚巧腹部一缩，躲过了$N这一招",
        "lian"    : "$N忽然「咯」的一声喷出口酒气，刚巧腹部一缩，身形急旋，扶摇至上",
        "jibie"   : 10,
        "sen"     : 4,]),
    ([  "action"  : "$n醉眼朦胧，右脚一软，顺势倒入$N的怀里，$N的凌厉攻势一下全部打空",
        "lian"    : "$N醉眼朦胧，右脚一软，幻出数个身影",
        "jibie"   : 20,
        "sen"     : 4,]),
    ([  "action"  : "$n双眼似睁似闭，顺着$N的招式一个举杯饮酒，全身自膝盖向后平平倒了下去",
        "lian"    : "$N双眼似睁似闭，一个举杯饮酒，全身自膝盖向后平平倒了下去",
        "jibie"   : 30,
        "sen"     : 5,]),
    ([  "action"  : "但是$n喝醉了似的身子向后一倒，右脚却直踢而上，将$N逼了开去",
        "lian"    : "$N喝醉了似的身子向后一倒，右脚却直踢而上",
        "jibie"   : 40,
        "sen"     : 5,]),
    ([  "action"  : "$n双腿无力，脚下一软坐倒在地，身形顿时矮半截，刚好逼过了$N的招式",
        "lian"    : "$N双腿无力，脚下一软坐倒在地，身形顿时矮半截",
        "jibie"   : 50,
        "sen"     : 5,]),
    ([  "action"  : "可是$n摇摇摆摆地乱走了几步，脚下不丁不八却已经转到了$N的身后",
        "lian"    : "$N摇摇摆摆地乱走了几步，脚下不丁不八却已经满场游走",
        "jibie"   : 60,
        "sen"     : 5,]),
    ([  "action"  : "却见$n左脚踩在自己右脚上一拌，身子向右歪去，刚巧躲过了$N的攻击",
        "lian"    : "$N左脚踩在自己右脚上一拌，身子向右歪去",
        "jibie"   : 80,
        "sen"     : 5,]),
    ([  "action"  : "$n满脸醉相，信步往左一踏，有惊无险地避开了$N这一招",
        "lian"    : "$N满脸醉相，信步往左一踏",
        "jibie"   : 100,
        "sen"     : 5,]),
});
}

