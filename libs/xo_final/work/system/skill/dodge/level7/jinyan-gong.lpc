#include <ansi.h>;

inherit SKILL_DODGE;

mapping *get_all_action() {
  return ({
    ([ "action": "却不料$n身形一转，一个" HIY "「藏形匿迹」" NOR "突然转到了$N的身后",
      "lian": "$N身形一转，一个" HIY "「藏形匿迹」" NOR,
      "jibie": 5,
      "zhaoshi": HIY "「藏形匿迹」" NOR,
      "sen": 1, ]),
    ([ "action": "$n足尖在地面一点，身形拔地而起，" HIC "「飞灵八方」" NOR "躲开了这一招",
      "lian": "$N足尖在地面一点，身形拔地而起，" HIC "「飞灵八方」" NOR "躲开了这一招",
      "jibie": 10,
      "zhaoshi": HIC "「飞灵八方」" NOR,
      "sen": 1, ]),
    ([ "action": "$n随着$N攻来的招式一个" HIW "「乘虚御空」" NOR "飘了起来，就如一片微风中的柳絮一般",
      "lian": "$N一个" HIW "「乘虚御空」" NOR "飘了起来，就如一片微风中的柳絮一般",
      "jibie": 20,
      "zhaoshi": HIW "「乘虚御空」" NOR,
      "sen": 1, ]),
    ([ "action": "$n使出" HIY "「解行遁变」" NOR "，身形左一晃、右一闪，不知怎么的，从攻击的间隙中钻了出来",
      "lian": "$N使出" HIY "「解行遁变」" NOR "，身形左一晃、右一闪",
      "jibie": 30,
      "zhaoshi": HIY "「解行遁变」" NOR,
      "sen": 1, ]),
    ([ "action": "$n使出" HIM "「回神转玄」" NOR "，足不点地地围绕$N连绕三个大圈，把$N这一招避了开去",
      "lian": "$N使出" HIM "「回神转玄」" NOR "，足不点地",
      "jibie": 40,
      "zhaoshi": HIM "「回神转玄」" NOR,
      "sen": 1, ]),
    ([ "action": "$n连旋数个大圈，跟着又是一个大圈，运起金雁功的" HIC "「弃厄飞霄」" NOR "，身形高高地拔了起来",
      "lian": "$N连旋数个大圈，跟着又是一个大圈，运起金雁功的" HIC "「弃厄飞霄」" NOR "，身形高高地拔了起来",
      "jibie": 50,
      "zhaoshi": HIC "「弃厄飞霄」" NOR,
      "sen": 1, ]),
    ([ "action": "$n身形流转，衣袖飘拂，绕场团走，正是金雁功的" HIB "「隐景舞天」" NOR "，形态缦妙已极",
      "lian": "$N身形流转，衣袖飘拂，绕场团走，正是金雁功的" HIB "「隐景舞天」" NOR "，形态缦妙已极",
      "jibie": 60,
      "zhaoshi": HIB "「隐景舞天」" NOR,
      "sen": 1, ]),
    ([ "action": "$n身形飘浮，长袖翻卷，一势" HIW "「出有入无」" NOR "，轻松自如地避开了$N的攻势",
      "lian": "$N身形飘浮，长袖翻卷，一势" HIW "「出有入无」" NOR "，轻松自如",
      "jibie": 70,
      "zhaoshi": HIW "「出有入无」" NOR,
      "sen": 1, ]),
  });
}
