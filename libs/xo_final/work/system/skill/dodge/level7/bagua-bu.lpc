inherit SKILL_DODGE;

mapping *get_all_action()
{
    return ({
        ([ "action":"$n双臂置于身后，不急不缓，昂首从$N眼前跨过，正是八卦步起手式「开步」",
           "lian"  :"$N双臂置于身后，不急不缓，昂首跨过，正是八卦步起手式「开步」",
           "jibie" :5,
           "zhaoshi": "「开步」",
           "sen"   :1, ]),
        ([ "action":"$n一式「阖步」，左手一扬，身行一晃，缓缓的向后一退，轻松让过了$N的凌厉攻势",
           "lian"  :"$N一式「阖步」，左手一扬，身行一晃，缓缓的向后一退",
           "jibie" :10,
            "zhaoshi": "「阖步」",
           "sen"   :1, ]),
        ([ "action":"$n一式「四正步」，前后脚脚尖脚跟相靠，身体如行云流水般向左滑出四步",
           "lian"  :"$N一式「四正步」，前后脚脚尖脚跟相靠，身体如行云流水般向左滑出四步",
           "jibie" :20,
            "zhaoshi": "「四正步」",
           "sen"   :1, ]),
        ([ "action":"$n足不动，手不抬，一转眼间便绕到了$N的身后，却是一式「四奇步」的身法",
           "lian"  :"$N足不动，手不抬，一转眼间便绕到了身后，却是一式「四奇步」的身法",
           "jibie" :30,
            "zhaoshi": "「四奇步」",
           "sen"   :1, ]),
        ([ "action":"$n一式「天地风云」，全身化为一道白影，忽的拔地而起,在半空中一个空翻，已落到几丈远的地方",
           "lian"  :"$N一式「天地风云」，全身化为一道白影，忽的拔地而起,在半空中一个空翻，已落到几丈远的地方",
           "jibie" :40,
            "zhaoshi": "「天地风云」",
            "sen"  :1, ]),
        ([ "action":"$n一式「龙虎鸟蜿」，身体如一只金雁般行云流水，又宛若一条矫矢苍龙急速盘旋，瞬间滑出丈余",
           "lian"  :"$N一式「龙虎鸟蜿」，身体如一只金雁般行云流水，又宛若一条矫矢苍龙急速盘旋，瞬间滑出丈余",
           "jibie" :50,
            "zhaoshi": "「龙虎鸟蜿」",
           "sen"   :1, ]),
        ([ "action":"$n一招「坐乾踏坤」，身随意转，瞻之在前，忽焉在后，倏地往一旁挪开了三尺",
           "lian"  :"$N一招「坐乾踏坤」，身随意转，瞻之在前，忽焉在后，倏地往一旁挪开了三尺",
           "jibie" :60,
            "zhaoshi": "「坐乾踏坤」",
           "sen"   :1, ]),
        ([ "action":"可是$n的身形陡地变得飘忽不定，竟丝毫不着力，令$N无法看清，正是一式「移艮走巽」的身法",
           "lian"  :"$N的身形陡地变得飘忽不定，竟丝毫不着力",
           "jibie" :70,
            "zhaoshi": "「移艮走巽」",
           "sen"   :1, ]),
        ([ "action":"$n一式「跑坎游离」，双臂前伸，全身贴地平飞，犹如在水面滑行一般，顿时闪过了$N的凌厉攻势",
           "lian"  :"$N一式「跑坎游离」，双臂前伸，全身贴地平飞，犹如在水面滑行一般",
           "jibie" :80,
            "zhaoshi": "「跑坎游离」",
           "sen"   :1, ]),
        ([ "action":"$n一式「离震回兑」，两臂鹏举如翼，在剌剌风声中，轻盈地一跃，$N以为$n要绕到自己的身后，但再定睛\n"
                    "一看，$n却又回到了原来的位置",
           "lian"  :"$N一式「离震回兑」，两臂鹏举如翼，在剌剌风声中，轻盈地一跃",
           "jibie" :90,
            "zhaoshi": "「离震回兑」",
            "sen"  :1, ]),
        ([ "action":"$n陡然使出一式「八面埋伏」，身形由一分二，由二变四，又四为八，犹如鬼魅忽隐忽现，令人难以琢磨",
           "lian"  :"$N陡然使出一式「八面埋伏」，身形由一分二，由二变四，又四为八，犹如鬼魅忽隐忽现，令人难以琢磨",
           "jibie" :100,
            "zhaoshi": "「八面埋伏」",
           "sen"   :1, ]),
    });
}

