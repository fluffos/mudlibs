inherit SKILL_DODGE;

mapping *get_all_action()
{
    return ({
    ([  "action"  : "$n身形一晃，纤腰一扭，一招「星河鹭起」，弹地而起",
        "lian"    : "$N身形一晃，纤腰一扭，一招「星河鹭起」，弹地而起",
        "jibie"   : 10,
        "sen"     : 4,
        "zhaoshi" : "「星河鹭起」",]),
    ([  "action"  : "$n一招「歌尽桃花扇底风」，$N只觉眼前一花，不见了$n的身影",
        "lian"    : "$N一提真气，身子急拔，使出一招一招「歌尽桃花扇底风」，幻出数个身影",
        "jibie"   : 20,
        "sen"     : 4,
        "zhaoshi" : "「歌尽桃花扇底风」", ]),
    ([  "action"  : "$n一招「扫尽浮云风不定」，身形微晃，有惊无险地避开了$N这一招",
        "lian"    : "$N若酒醉一般，踉踉跄跄跨出三步，一招「扫尽浮云风不定」，身形微晃",
        "jibie"   : 30,
        "sen"     : 5,
        "zhaoshi" : "「扫尽浮云风不定」", ]),
    ([  "action"  : "只见$n身子向后一翻，一招「缥渺孤鸿影」，后荡而起，掠向一旁",
        "lian"    : "$N身子向后一翻，一招「缥渺孤鸿影」，后荡而起，掠向一旁",
        "jibie"   : 40,
        "sen"     : 5,
        "zhaoshi" : "「缥渺孤鸿影」", ]),
    ([  "action"  : "$n一招「起舞弄清影」，长袖翻飞，躲过$N这一招",
        "lian"    : "$N悄然一笑，身形急旋，仿佛飞蝶戏花一般，一招「起舞弄清影」，长袖翻飞",
        "jibie"   : 50,
        "sen"     : 5,
    "zhaoshi" : "「起舞弄清影」", ]),
    ([  "action"  : "却见$n「万顷江田一鹭飞」，冲天而起，一波三折，端是美观",
        "lian"    : "$N「万顷江田一鹭飞」，冲天而起，一波三折，端是美观",
        "jibie"   : 60,
        "sen"     : 5,
        "zhaoshi" : "「万顷江田一鹭飞」", ]),
    ([  "action"  : "可是$n一个「流水落花春去也」，侧身一让，$N这一招扑了个空",
        "lian"    : "$N一个「流水落花春去也」，侧身一让",
        "jibie"   : 70,
        "sen"     : 5,
        "zhaoshi" : "「流水落花春去也」", ]),
    ([  "action"  : "只见$n一招「月轮穿沼水无痕」，倒掠身形，凌空两个翻转，退出两丈开外",
        "lian"    : "$N一招「月轮穿沼水无痕」，倒掠身形，凌空两个翻转，退出两丈开外",
        "jibie"   : 90,
        "sen"     : 5,
        "zhaoshi" : "「月轮穿沼水无痕」", ]),
    ([  "action"  : "$n息气上升，意存玉枕，一招「月在青天影在波」，身子飘然而起",
        "lian"    : "$N息气上升，意存玉枕，一招「月在青天影在波」，身子飘然而起",
        "jibie"   : 100,
        "sen"     : 5,
        "zhaoshi" : "「月轮穿沼水无痕」", ]),
});
}

