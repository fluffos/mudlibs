inherit SKILL_DODGE;

mapping *get_all_action()
{
    return ({
    ([  "action"  : "$n傲然一笑，身形急旋，扶摇至上，衣裾满天飘舞，使出一式「何仙姑提\n"
                    "篮散花」空中一折腰，一翻身悄然落在$N的身后",
        "lian"    : "$N傲然一笑，身形急旋，扶摇至上，衣裾满天飘舞，使出一式「何仙姑提\n"
                    "篮散花」空中一折腰，一翻身悄然落地上",
        "jibie"   : 10,
        "sen"     : 4,
        "zhaoshi" : "「何仙姑提篮散花」",]),
    ([  "action"  : "$n一提真气，身子急拔，使出一招「铁拐李遨游东海」，幻出数个身影，\n"
                    "$N不知哪是真哪是假，无从选择",
        "lian"    : "$N一提真气，身子急拔，使出一招「铁拐李遨游东海」，幻出数个身影，\n"
                    "令人不知哪是真哪是假",
        "jibie"   : 20,
        "sen"     : 4,
        "zhaoshi" : "「铁拐李遨游东海」", ]),
    ([  "action"  : "$n若酒醉一般，踉踉跄跄跨出三步，一式「张果老酒醉倒骑驴」闪开了$N\n"
                    "的攻势",
        "lian"    : "$N若酒醉一般，踉踉跄跄跨出三步，一式「张果老酒醉倒骑驴」向一侧闪开了",
        "jibie"   : 30,
        "sen"     : 5,
        "zhaoshi" : "「张果老酒醉倒骑驴」", ]),
    ([  "action"  : "$n大步向前，眼见就要撞上$N，一招「吕纯阳月下过洞庭」一拔身形，越\n"
                    "过$N的头顶，飘然落在$N的背后",
        "lian"    : "$N大步向前，一招「吕纯阳月下过洞庭」一拔身形，跃其数丈高，飘然落在地面",
        "jibie"   : 40,
        "sen"     : 5,
        "zhaoshi" : "「吕纯阳月下过洞庭」", ]),
    ([  "action"  : "$n悄然一笑，身形急旋，仿佛飞蝶戏花一般，一招「何仙姑嘻笑采山茶」绕\n"
                    "着$N游走，轻轻巧巧的避开了$N的攻势",
        "lian"    : "$N悄然一笑，身形急旋，仿佛飞蝶戏花一般，一招「何仙姑嘻笑采山茶」满场游走",
        "jibie"   : 50,
        "sen"     : 5,
        "zhaoshi" : "「何仙姑嘻笑采山茶」", ]),
});
}

