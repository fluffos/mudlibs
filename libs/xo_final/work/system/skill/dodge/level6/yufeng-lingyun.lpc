inherit SKILL_DODGE;

mapping *get_all_action() {
  return ({
    ([ "action": "$n一式「追风逐电」，身子掣忽一转，$N只觉的眼前一花，失去了目标",
      "lian": "$N一式「追风逐电」，身子掣忽一转",
      "jibie": 15,
      "sen": 2,
      "zhaoshi": "「追风逐电」",
    ]),
    ([ "action": "$n一式「左右穿花」，双脚点地，身子突然拔高了丈许，缓缓飘落在$N身后",
      "lian": "$N一式「左右穿花」，双脚点地，身子突然拔高了丈许",
      "jibie": 30,
      "sen": 2,
      "zhaoshi": "「左右穿花」",
    ]),
    ([ "action": "$n一式「登云步月」，身行一晃，顿时无数条身影一下子出现在$N的面前",
      "lian": "$N一式「登云步月」，身行一晃，顿时无数条身影一下子出现",
      "jibie": 45,
      "sen": 4,
      "zhaoshi": "「登云步月」",
    ]),
    ([ "action": "$n一式「无影无踪」，飘然向后一退，躲开$N的凌厉攻势",
      "lian": "$N一式「无影无踪」，飘然向后一退",
      "jibie": 60,
      "sen": 3,
      "zhaoshi": "「无影无踪」",
    ]),
    ([ "action": "$n一式「划地为牢」，身体急转，化为一道白光，虚幻不定的出现在$N的周围",
      "lian": "$N一式「划地为牢」，身体急转，化为一道白光，虚幻不定",
      "jibie": 75,
      "sen": 2,
      "zhaoshi": "「划地为牢」",
    ]),
  });
}
