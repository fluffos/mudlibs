        "jibie"  : 15,
        "sen"    :  2, 
        "zhaoshi":  BLU"「似来还往」"NOR,
        ]),
    ([  "action" : "但是$n使出"CYN"「蜻蜓点水」"NOR"，脚尖站地，身形东倒西歪间，破天冲起",
        "lian"   :"$N使出"CYN"「蜻蜓点水」"NOR"，脚尖站地，身形东倒西歪间，破天冲起",
        "jibie"  : 30,
        "sen"    :  2, 
        "zhaoshi":  CYN"「蜻蜓点水」"NOR,
        ]),
    ([  "action" :"$n一招"HIY"「飞黄腾达」"NOR"，身随意转，刹那间在原地转了七八十圈，突然往地上一坐，\n原是转晕了，却使$N落了空",
        "lian"   :"$N一招"HIY"「飞黄腾达」"NOR"，身随意转，刹那间在原地转了七八十圈，突然往地上一坐",
        "jibie"  : 45,
        "sen"    :  4, 
        "zhaoshi":  HIY"「飞黄腾达」"NOR,
        ]),
    ([  "action" :"可是$n一个"HIW"「白驹过隙」"NOR"，身形微侧，提气直纵，躲过$N攻击",
        "lian"   :"$N一个"HIW"「白驹过隙」"NOR"，身形微侧，提气直纵",
        "jibie"  : 60,
        "sen"    :  3, 
        "zhaoshi":  HIW"「白驹过隙」"NOR,
        ]),
    ([  "action" :"却见$n使出"HIW"「浮光掠影」"NOR"，在原地留下一个幻象，真身躲到了一边",
        "lian"   :"却见$N使出"HIW"「浮光掠影」"NOR"，在原地留下一个幻象，真身躲到了一边",
        "jibie"  : 75,
        "sen"    :  2, 
        "zhaoshi":  HIW"「浮光掠影」"NOR,
        ]),
    ([  "action" :"$n身形一顿，"HIB"「逝者如斯」"NOR"，身形平平掠出，在空中留下一道弧形",
        "lian"   :"只见$N身形一顿，"HIB"「逝者如斯」"NOR"，身形平平掠出，在空中留下一道弧形",
        "jibie"  : 90,
        "sen"    :  3, 
        "zhaoshi":  HIB"「逝者如斯」"NOR,
        ]),
});
