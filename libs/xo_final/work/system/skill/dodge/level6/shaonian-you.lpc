#include <ansi.h>

inherit SKILL_DODGE;

mapping *get_all_action()
{
    return ({
    ([  "action" : "只见$n一招"BLU"「似来还往」"NOR"，双脚一前一后，似进又退，在$N一愣间躲过了攻击",
