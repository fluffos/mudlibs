inherit SKILL_DODGE;

mapping *get_all_action() {
  return ({
    ([ "action": "但是$n身形飘忽，轻轻一纵，一招「乳燕投林」，举重若轻的避开这一击",
      "lian": "但见$N身形飘忽，轻轻一纵，一招「乳燕投林」，举重若轻的跃入天空",
      "jibie": 15,
      "sen": 2,
    ]),
    ([ "action": "$n身随意转，一式「雪花飞舞」，倏地往一旁飘开数尺，避过了这一招",
      "lian": "$N身随意转，一式「雪花飞舞」，倏地往一旁飘开数尺",
      "jibie": 30,
      "sen": 2,
    ]),
    ([ "action": "可是$n侧身一让，使出「柳絮轻飘」，$N这一招扑了个空",
      "lian": "$N侧身一让，使出「柳絮轻飘」",
      "jibie": 45,
      "sen": 4,
    ]),
    ([ "action": "却见$n足不点地，一招「腾云驾雾」，身形滴溜溜一转，往旁闪开数尺，躲了开去",
      "lian": "$N足不点地，一招「腾云驾雾」，身形滴溜溜一转，往旁闪开数尺",
      "jibie": 60,
      "sen": 3,
    ]),
    ([ "action": "$n左脚一点右脚背，身形往上一拔，一招「一鹤冲天」，轻轻巧巧地避开了这一招",
      "lian": "却见$N左脚一点右脚背，身形往上一拔，一招「一鹤冲天」",
      "jibie": 75,
      "sen": 2,
    ]),
  });
}
