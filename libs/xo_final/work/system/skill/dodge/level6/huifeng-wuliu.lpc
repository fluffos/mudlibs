inherit SKILL_DODGE;

mapping *get_all_action()
{
    return ({
    ([  "action" : "但见$n脚尖轻轻一点，一招「天马行空」，飞身跃入天空",
        "lian"   : "但见$N脚尖轻轻一点，一招「天马行空」，飞身跃入天空",
        "jibie"  : 15,
        "sen"    :  2, 
        ]),
    ([  "action" : "$n身形随风飘出，一式「斜风细雨」，掠出三丈开外",
        "lian"   :"$N身形随风飘出，一式「斜风细雨」，掠出三丈开外",
        "jibie"  : 30,
        "sen"    :  2, 
        ]),
    ([  "action" :"$n一式「一泻千里」，身形犹如闪电，直退出去，衣带飘飞，疑是仙人",
        "lian"   :"$N一式「一泻千里」，身形犹如闪电，直退出去，衣带飘飞，疑是仙人",
        "jibie"  : 45,
        "sen"    :  4, 
        ]),
    ([  "action" :"$n一招「天花乱坠」，身形直飘出去，尤如一片青云飘浮在空中",
        "lian"   :"$N一招「天花乱坠」，身形直飘出去，尤如一片青云飘浮在空中",
        "jibie"  : 60,
        "sen"    :  3, 
        ]),
    ([  "action" :"却见$n「一飞冲天」，冲天而起，一波三折，端是美观",
        "lian"   :"却见$N「一飞冲天」，冲天而起，一波三折，端是美观",
        "jibie"  : 75,
        "sen"    :  2, 
        ]),
    ([  "action" :"只见$n一招「左右逢源」，倒掠身形，凌空两个翻转，退出两丈开外",
        "lian"   :"只见$N一招「左右逢源」，倒掠身形，凌空两个翻转，退出两丈开外",
        "jibie"  : 90,
        "sen"    :  3, 
        ]),
});
}

