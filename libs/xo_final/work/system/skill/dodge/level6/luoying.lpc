inherit SKILL_DODGE;

mapping *get_all_action() {
  return ({
    ([ "action": "$n将头一低，双臂内弯，手肘向前，似箭般向$N怀中扑去，正是一招“灵鳌步”，$N大惊之下，所发招数统统打在$n身后，尽数落空",
      "lian": "将头一低，双臂内弯，手肘向前，似箭般向$N怀中扑去，正是一招“灵鳌步”",
      "jibie": 15,
      "sen": 2,
      "zhaoshi": "“灵鳌步”",
    ]),
    ([ "action": "$n身形疾闪，使出一招“海燕腾空”，身体如同为海风所激，向后飘开一丈有余，避过$N攻击",
      "lian": "$N身形疾闪，使出一招“海燕腾空”，身体如同为海风所激，向后飘开一丈有余",
      "jibie": 30,
      "sen": 2,
      "zhaoshi": "“海燕腾空”",
    ]),
    ([ "action": "$n将身一纵，跃在半空，收腹含胸，一招“长空落雁”，在空中轻轻巧巧一个翻身，悄无声息地落在$N身后",
      "lian": "$N将身一纵，跃在半空，收腹含胸，一招“长空落雁”，在空中轻轻巧巧一个翻身",
      "jibie": 45,
      "sen": 4,
      "zhaoshi": "“长空落雁”",
    ]),
    ([ "action": "$n眼见敌招攻来，委实避无可避，忽然一招“巫峡云断”，凌空一个铁板桥，全身自膝盖以上，平平折断，$N招数顿时失了准头，全部打在空处",
      "lian": "$N眼见敌招攻来，委实避无可避，忽然一招“巫峡云断”，凌空一个铁板桥，全身自膝盖以上，平平折断",
      "jibie": 60,
      "sen": 3,
      "zhaoshi": "“巫峡云断”",
    ]),
    ([ "action": "$n身形闪动，使出一招“青鸟振翼”，双臂展开，宛若翩翩起舞，姿态飘逸，闪过$N攻击",
      "lian": "却见$N身形闪动，使出一招“青鸟振翼”，双臂展开，宛若翩翩起舞，姿态飘逸",
      "jibie": 75,
      "sen": 2,
      "zhaoshi": "“青鸟振翼”",
    ]),
    ([ "action": "$n身法一变，一式“湘灵空舞”，随着$N攻势，敌左则左，敌右则右，$N虽看似大占上风，却无一招能够击中",
      "lian": "只见$N身法一变，一式“湘灵空舞”，随着$N攻势，敌左则左，敌右则右",
      "jibie": 90,
      "sen": 3,
      "zhaoshi": "“湘灵空舞”",
    ]),
    ([ "action": "$n一声清啸，身形拔地而起，正是一招“鹏搏九霄”，在空中一连几个转折，扶摇直上，迅若鲲鹏，举重若轻的闪过$N攻击",
      "lian": "却见$N一声清啸，身形拔地而起，正是一招“鹏搏九霄”，在空中一连几个转折，扶摇直上，迅若鲲鹏",
      "jibie": 120,
      "sen": 2,
      "zhaoshi": "“鹏搏九霄”",
    ]),
    ([ "action": "$n气凝丹田，脚下疾踩后天八卦方位，一式“归去来兮”，当真是望之在前，忽焉在后，$N手忙脚乱，连抵挡都有所不能，更别提还手反击了",
      "lian": "只见$N气凝丹田，脚下疾踩后天八卦方位，一式“归去来兮”，当真是望之在前，忽焉在后",
      "jibie": 150,
      "sen": 3,
      "zhaoshi": "“归去来兮”",
    ]),
  });
}
