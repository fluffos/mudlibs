inherit SKILL_DODGE;

mapping *get_all_action()
{
    return ({
([     
    "action": "但见$n脚不着地，一招「步步生莲」，身形早在数丈之外",
    "lian" :  "$N脚不着地，一招「步步生莲」，轻轻一滑，绕了一个大圈又回到原地",
    "jibie": 8,
    "sen"  : 5,
]),
([     
    "action": "$n身形飘忽，轻轻一纵，使出一式「有无相生」，早已避开",
    "lian" : "$N身形飘忽，轻轻一纵，使出一式「有无相生」，横跃出很远\n",
    "jibie": 16,
    "sen"  : 5,
]),
([     
    "action": "$n一式「无所着相」，身形不变，轻轻滑出丈余",
    "lian" : "$N一式「无所着相」，身形不变，平平滑出丈余，差点没摔了一跤",
    "jibie": 25,
    "sen"  : 5,
]),
([     
    "action": "$n一招「应云何住」，$n眼前一花，已失去$N的踪影",
    "lian" : "$N一招「应云何住」，用力一踩竹枝，弹起数尺",
    "jibie": 32,
    "sen"  : 5,
]),
([     
    "action": "$n身形急转，一招「梦幻泡影」，在空中一个转折，已在数丈之外",
    "lian" : "$N身形急转，一招「梦幻泡影」，在空中一个转折，已在数丈之外",
    "jibie": 42,
    "sen"  : 5,
]),
});
}

int valid_learn(object me)
{
    if ( me->query_jibie("buddhism") < 60 )
    {
        return notify_fail("你的佛学修为不够，强练绝技会伤及身体。\n");
    }
    if( me->query("max_force") < 300 )
    {
        return notify_fail("你内力不足，无法练习般若身法。\n");
    }

    return ::valid_learn(me);
}

int valid_lian( object me )
{
    object env;

    if ( !me )
    {
        return 0;
    }

    env = environment(me);
    if( env->query("short") == "后山竹林" )
    {
        return ::valid_lian(me);
    }

    return notify_fail("般若身法必须在竹林里练习。\n");
}

