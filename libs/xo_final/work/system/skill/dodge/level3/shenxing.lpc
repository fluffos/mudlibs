inherit SKILL_DODGE;

mapping *get_all_action() {
  return ({
    ([
      "action":
      "只见$n双膝微弯，似向左侧躲去，却又疾闪向右，$N的攻势尽落空里",
      "lian":
      "只见$N双膝微弯，似向左侧躲去，却又疾闪向右....",
      "jibie": 8,
      "sen": 4,
    ]),
    ([ "action":
      "$n脚下连点数下，未等$N看清，$n已绕了几个圈子，落到三尺之外.....",
      "lian":
      "$N脚下连点数下，未等你看清，$N已绕了几个圈子，落到三尺之外.....",
      "jibie": 16,
      "sen": 3,
    ]),
    ([
      "action":
      "$n身形一展，似欲纵向半空，却是全身蜷作一团，从$N身后饶了过去",
      "lian":
      "$N身形一展，似欲纵向半空，却是全身蜷作一团，饶到一旁",
      "jibie": 25,
      "sen": 3,
    ]),
    ([
      "action":
      "正见$n全身空门毕露，向前扑出，却又一个转身，向侧边蹿出丈许！",
      "lian":
      "正见$N全身空门毕露，向前扑出，却又一个转身，向侧边蹿出丈许！",
      "jibie": 33,
      "sen": 4,
    ]),
    ([
      "action":
      "眼看$n无路可退，却见$n向后一仰，一个翻身，避开这必中的一击！",
      "lian":
      "$N向后退了两步，忽地一个后仰，翻了一个身，又站了起来",
      "jibie": 40,
      "sen": 3,
    ]),
  });
}
