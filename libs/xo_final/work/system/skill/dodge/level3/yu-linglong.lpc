#include <ansi.h>

inherit SKILL_DODGE;

mapping *get_all_action()
{
    return ({
    ([ "action":"$n轻轻巧巧地往后一跃，身轻如燕，一式"BLU"「单燕南飞」"NOR"，$N的招数顿时用尽",
       "lian"  :"$N提气在胸，收腹提肩，一个"BLU"「单燕南飞」"NOR"，高高跃起",
       "jibie" :5,
       "sen"   :2, ]),
    ([ "action":"$n不退反进，身形飒然欺进，一式"BLU"「一叶障目」"NOR"，张开手掌往$N眼前一舞而过，$N视线被挡，手上招数顿时缓了一缓",
       "lian"  :"$N足下一蹬，一个"BLU"「一叶障目」"NOR"向后退去，险些扭伤了足踝",
       "jibie" :10,
       "sen"   :2, ]),
    ([ "action":"$n双袖轻拂，身形拔地而起，在空中一个空翻，"HIW"「双燕分飞」"NOR"，跃到$N身后",
       "lian"  :"$N双足一点，一个"HIW"「双燕分飞」"NOR"，蹿起三尺来高",
       "jibie" :20,
       "sen"   :2, ]),
    ([ "action":"$n左足上挑，右足力蹬，一式"HIC"「燕子出巢」"NOR"纵跃于几丈开外",
       "lian"  :"$N把握住身体的平衡，借着踢腿的力量，向旁边一跃",
       "jibie" :30,
       "sen"   :3, ]),
    ([ "action":"$n左一步，右一转，斜刺里一插，一式"GRN"「余音绕梁」"NOR"，围绕$N转了半圈，避开了$N的出招",
       "lian"  :"$N向高空里一纵身，跃起五尺来高",
       "jibie" :40,
        "sen"  :3, ]),
    ([ "action":"$n一声轻啸，一式"HIM"「走马看花」"NOR"长身而起，侧身让过了$N这招",
       "lian"  :"$N跃起五尺，一招"HIM"「走马看花」"NOR"，轻轻落下地来",
       "jibie" :50,
       "sen"   :3, ]),
    ([ "action":"$n待$N攻近面门，后退几步，突然身形后挫，回手一式"HIM"「燕子回头」"NOR"，堪堪躲过$N这一招",
       "lian"  :"$N跃起五尺，一招"HIM"「燕子回头」"NOR"，轻轻落下地来",
       "jibie" :60,
       "sen"   :3, ]),
    ([ "action":"$n一式"HIB"「燕南归巢」"NOR"，一个侧身飘然掠起，转眼已在$N身后",
       "lian"  :"$N跃起五尺，一招"HIB"「燕南归巢」"NOR"，轻轻落下地来",
       "jibie" :70,
       "sen"   :3, ]),
});
}

