inherit SKILL_DODGE;

mapping *get_all_action() {
  return ({
    ([
      "action":
      "$n一个「随风而舞」，身形飘忽不定，躲过了$N这一招",
      "lian":
      "只见$N一个「随风而舞」，身形飘忽不定....",
      "jibie": 8,
      "sen": 4,
    ]),
    ([ "action":
      "$n身形飘飘，使出一招「身随意转」，避过了$N的攻击",
      "lian":
      "$N身形飘飘，使出一招「身随意转」，已绕了几个圈子，落到三尺之外.....",
      "jibie": 16,
      "sen": 3,
    ]),
    ([
      "action":
      "$n使出「移步换形」，在千钧一发间躲过了$N的攻势",
      "lian":
      "$N身形一展，似欲纵向半空，却是全身蜷作一团，绕到一旁",
      "jibie": 25,
      "sen": 3,
    ]),
    ([
      "action":
      "$n衣袂飘飘，一招「事了拂衣去」，潇洒地避了开去",
      "lian":
      "正见$N衣袂飘飘，一招「事了拂衣去」，向侧边蹿出丈许！",
      "jibie": 33,
      "sen": 4,
    ]),
    ([
      "action":
      "眼看$n无路可退，却见$n向后一仰，一个翻身，避开这必中的一击！",
      "lian":
      "$N向后退了两步，忽地一个后仰，翻了一个身，又站了起来",
      "jibie": 40,
      "sen": 3,
    ]),
  });
}
