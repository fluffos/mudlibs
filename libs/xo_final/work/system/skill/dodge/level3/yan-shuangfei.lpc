inherit SKILL_DODGE;

mapping *get_all_action()
{
    return ({
        ([
                "action":"$n一个「比翼双飞」，随着$N的攻势飘起，从容躲过这一招",
                "lian" :"$N提气纵身，一个箭步，向后急越.......",
                "jibie":          8,
                "sen"  :      4,
        ]),
        ([      
                "action":"$n使出一招「巧燕穿云」，猛然纵起丈余，结果$N扑了个空",
                "lian" :"$N使出一招「巧燕穿云」，猛然纵起丈余",
                "jibie":15,
                "sen"  :3,
        ]),
        ([     
                "action":"$n身形一摇，幻出几个人影，一招「望穿秋水」躲过了$N的攻势",
                "lian" :"$N身形一摇，幻出几个人影",
                "jibie":25,
                "sen"  : 4,
        ]),
        ([      "zhaoshi" : "「飞鸟投林」",
                "action":"$n一招「飞鸟投林」纵身跃起，倏忽已落至$N身后",
                "lian" :"$N一招「飞鸟投林」纵身跃起",
                "jibie":33,
                "sen"  : 5,
        ]),
        ([      "zhaoshi" : "「紫燕呢喃」",
                "action":
"$n左一摇，右一晃，一招「紫燕呢喃」已轻松闪过",
                "lian" :
"$N左一摇，右一晃，一招「紫燕呢喃」已轻松闪过",
                "jibie":40,
                "sen"  : 4,
        ]),
        ([      "zhaoshi" : "「飞天鬼影」",
                "action":"$N一式「飞天鬼影」,形如鬼魅，身子急拔而起",
                "lian" :"$N一式「飞天鬼影」,形如鬼魅，身子急拔而起",
                "jibie":50,
                "sen"  : 4,
        ]),
        ([      "zhaoshi" : "「粱上君子」",
                "action":
"$N一式「粱上君子」飘到空中，两腿一蹬，身子借力而起",
                "lian" :
"$N一式「粱上君子」飘到空中，两腿一蹬，身子借力而起",
                "jibie":60,
                "sen"  : 6,
        ]),
});
}

