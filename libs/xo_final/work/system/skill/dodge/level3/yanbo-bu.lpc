inherit SKILL_DODGE;

mapping *get_all_action() {
  return ({
    ([ "zhaoshi": "「月上柳梢头」",
      "action": "$n一个「月上柳梢头」，随着$N的攻势飘起，从容躲过这一招",
      "lian": "$N提气纵身，一个箭步，向后急越.......",
      "jibie": 8,
      "sen": 4,
    ]),
    ([ "zhaoshi": "「大漠孤烟直」",
      "action": "$n使出一招「大漠孤烟直」，猛然纵起丈余，结果$N扑了个空",
      "lian": "$N猛的一闪身，身形急转，滴溜溜地兜了一个圈子",
      "jibie": 15,
      "sen": 3,
    ]),
    ([ "zhaoshi": "「碎影舞斜阳」",
      "action": "$n身形一摇，幻出几个人影，一招「碎影舞斜阳」躲过了$N的攻势",
      "lian": "$N轻飘飘地提气上蹿，仿佛升天一样",
      "jibie": 25,
      "sen": 4,
    ]),
    ([ "zhaoshi": "「燕子三抄水」",
      "action": "$n一招「燕子三抄水」纵身跃起，倏忽已落至$N身后",
      "lian": "$N一招「燕子三抄水」纵身跃起",
      "jibie": 33,
      "sen": 5,
    ]),
    ([ "zhaoshi": "「云深不知处」",
      "action":
      "$n左一摇，右一晃，一招「云深不知处」已轻松闪过",
      "lian":
      "$N左一摇，右一晃，一招「云深不知处」已轻松闪过",
      "jibie": 40,
      "sen": 4,
    ]),
    ([ "zhaoshi": "「斜日杏花飞」",
      "action": "$n双足一点，斜斜飞起，使出「斜日杏花飞」已闪到$N身侧",
      "lian": "$N双足一点，斜斜飞起，使出「斜日杏花飞」",
      "jibie": 50,
      "sen": 4,
    ]),
  });
}
