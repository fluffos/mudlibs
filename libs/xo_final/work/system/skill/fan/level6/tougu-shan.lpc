#include <ansi.h>

inherit SKILL_SHORT;

mapping *get_all_action()
{
    return ({
    ([  "action": "$N端坐不动，一招"HIC"「秋风拂叶」"NOR"，手中$w带着一股劲风，击向$n的脸颊",
        "lian"  : "$N端坐不动，一招"HIC"「秋风拂叶」"NOR"，手中$w带着一股劲风",
        "jibie" :10,
        "sen"   :5,
        "damage":30,
        "zhaoshi":  HIC"「秋风拂叶」"NOR,
	"wound" :30,
        "damage_type" : "刺伤"
    ]),
    ([  "action": "$N单臂一挥，一招"HIW"「玉带围腰」"NOR"，手中$w直绕向$n的身后",
        "lian"  : "$N单臂一挥，一招"HIW"「玉带围腰」"NOR,
        "jibie" :20,
        "sen"   :5,
        "damage":35,
        "zhaoshi":  HIW"「玉带围腰」"NOR,
	"wound" :30,
        "damage_type" : "刺伤"
    ]),
    ([  "action": "$N身形一转，一招"HIB"「流云断川」"NOR"，手中$w如矫龙般腾空一卷，猛地向$n劈头打下",
        "lian"  : "$N身形一转，一招"HIB"「流云断川」"NOR"，手中$w如矫龙般腾空一卷",
        "jibie" :30, 
        "sen"   :5,
        "damage":45,
        "zhaoshi":  HIB"「流云断川」"NOR,
	"wound" :35,
        "damage_type" : "刺伤"
    ]),
    ([  "action": "$N力贯尘梢，一招"HIG"「春风化雨」"NOR"，手中$w舞出满天幻影，排山倒海般扫向$n全身",
        "lian"  : "$N力贯尘梢，一招"HIG"「春风化雨」"NOR"，手中$w舞出满天幻影",
        "jibie" :40, 
        "sen"   :5,
        "damage":55,
        "zhaoshi":  HIG"「春风化雨」"NOR,
	"wound" :35,
        "damage_type" : "刺伤"
    ]),
    ([  "action": "$N忽的向前一跃，一招"HIY"「野马分鬃」"NOR"，手中$w分击$n左右",
        "lian"  : "$N忽的向前一跃，一招"HIY"「野马分鬃」"NOR"，手中$w分击",
        "jibie" :50,
        "sen"   :5,
        "damage":65,
        "zhaoshi":  HIY"「野马分鬃」"NOR,
	"wound" :45,
        "damage_type" : "刺伤"
    ]),
    ([  "action": "$N慢步上前，一招"GRN"「竹影扫阶」"NOR"，手中$w缓缓罩向$n前胸",
        "lian"  : "$N慢步上前，一招"GRN"「竹影扫阶」"NOR"，手中$w缓缓罩去",
        "jibie" :60, 
        "sen"   :6,
        "damage":70,
        "zhaoshi":  GRN"「竹影扫阶」"NOR,
	"wound" :55,
