#include <ansi.h>

inherit SKILL_SHORT;

mapping *get_all_action()
{
    return ({
    ([  "action": "$N手中的$w自左而右地一晃，使出"BLU"「铁骑突出」"NOR"带着呼呼风声横打$n的章门穴!",
        "lian"  : "$N手中的$w自左而右地一晃，使出"BLU"「铁骑突出」"NOR"带着呼呼风声横打",
        "jibie" :10, 
        "limb"  :"脸部",
        "sen"   :1,
        "zhaoshi":  BLU"「铁骑突出」"NOR,
        "damage_type" : "刺伤"
    ]),
    ([  "action": "$N飞身跃起，一式"MAG"「龙耀九霄」"NOR"，卷起漫天扇影，$w向$n电射而去",
        "lian"  : "$N飞身跃起，一式"MAG"「龙耀九霄」"NOR"，卷起漫天扇影",
        "jibie" :20, 
        "limb"  :"眼睛",
        "sen"   :1,
        "zhaoshi":  MAG"「龙耀九霄」"NOR,
        "damage_type" : "刺伤"
    ]),
    ([  "action": "$N凝气守中，$w逼出尺许雪亮笔锋，挥出"GRN"「灵台观景」"NOR"，一扇快似一扇地攻向$n",
        "lian"  : "$N凝气守中，$w逼出尺许雪亮笔锋，挥出"GRN"「灵台观景」"NOR,
        "jibie" :30, 
        "limb"  :"鼻梁",
        "sen"   :1,
        "zhaoshi":  GRN"「灵台观景」"NOR,
        "damage_type" : "瘀伤"
    ]),
    ([  "action": "$N使出一招"HIW"「遥拜玉虚」"NOR"挺扇中宫直进，扇尖颤动，中途忽然转而向上变幻无方",
        "lian"  : "$N使出一招"HIW"「遥拜玉虚」"NOR"挺扇中宫直进，扇尖颤动，中途忽然转而向上变幻无方",
        "jibie" :40,
        "limb"  :"肩头",
        "sen"   :1,
        "zhaoshi":  HIW"「遥拜玉虚」"NOR,
        "damage_type" : "刺伤"
    ]),
    ([  "action": "$N侧身斜刺一笔，一招"HIC"「天音萧煞」"NOR"卷带着呼呼扇风，将$n包围紧裹",
        "lian"  : "$N侧身斜刺一笔，一招"HIC"「天音萧煞」"NOR"卷带着呼呼扇风",
        "jibie" :50, 
        "limb"  :"左臂",
        "sen"   :1,
        "zhaoshi":  HIC"「天音萧煞」"NOR,
        "damage_type" : "瘀伤"
    ]),
});
}

string query_weapon_type()
{
    return "fan";
}

