inherit SKILL_SHORT;

mapping *get_all_action()
{
    return ({
    ([  "action": "$N一招“五展梅”「冬梅初吐蕊」，手中$w犹如点点淡黄色的梅蕊刺向$n的$l",
        "lian"  : "$N一招“五展梅”「冬梅初吐蕊」，手中$w犹如点点淡黄色的梅蕊刺去",
        "zhaoshi":"「冬梅初吐蕊」",
        "jibie" :10,
        "limb"  : "头顶",
        "sen"   :3,
        "damage":5,
        "damage_type" : "瘀伤"
    ]),
    ([  "action": "$N使出“五展梅”「幼梅傲霜雪」，$n只觉剑气扑面而来，仿佛置身冰天雪地中，\n"
"$w仿佛化作傲霜的梅枝刺向$n的$l",
        "lian"  : "$N使出“五展梅”「幼梅傲霜雪」，$w仿佛化作傲霜的梅枝",
        "zhaoshi":"「幼梅傲霜雪」",
        "jibie" :17,
        "limb"  : "小腹",
        "sen"   :3,
        "damage":10,
        "damage_type" : "刺伤"
    ]),
    ([  "action": "$N一招“五展梅”「劲梅笑迎春」，$w连续划出几个圆圈，剑势如朵朵梅花，\n"
"$n眼前一花，$w已攻到面前",
        "lian"  : "$N一招“五展梅”「劲梅笑迎春」，$w连续划出几个圆圈，剑势如朵朵梅花",
        "zhaoshi":"「劲梅笑迎春」",
        "jibie" :25, 
        "limb"  : "小腹",
        "sen"   :3,
        "damage":15,
        "damage_type" : "划伤"
    ]),
    ([  "action": "$N一腾身，$w飞舞，正是“五展梅”「腊梅暗香浮」,$n竟似闻到淡淡梅花幽香，\n"
"恍惚间心驰神动,剑气已直刺$n的$l",
        "lian"  : "$N一腾身，$w飞舞，正是“五展梅”「腊梅暗香浮」",
        "zhaoshi":"「腊梅暗香浮」",
        "jibie" :32, 
        "limb"  : "右眼",
        "sen"   :3,
        "damage":20,
        "damage_type" : "刺伤"
    ]),
    ([  "action": "$N向前跨上一步，手中$w使出“五展梅”「红梅展新枝」,剑光爆涨，\n"
"快愈闪电直刺$n的$l",
        "lian"  : "$N向前跨上一步，手中$w使出“五展梅”「红梅展新枝」,剑光爆涨，\n"
"快愈闪电",
        "zhaoshi":"「红梅展新枝」",
        "jibie" :38,
        "limb"  : "左眼",
        "sen"   :3,
        "damage":25,
        "damage_type" : "刺伤"
    ]),
    ([  "action": "$N手中的$w一晃，使出“五展梅”终极招式「五梅花枝俏」,五式合作一式，\n"
"瞬间剑意漫天，$n只见梅花四处飞舞，隐藏其中的杀气已透骨而入",
        "lian"  : "$N手中的$w一晃，使出“五展梅”终极招式「五梅花枝俏」,五式合作一式，\n"
"瞬间剑意漫天",
        "zhaoshi":"「五梅花枝俏」",
        "jibie" :38,
        "limb"  : "左眼",
        "sen"   :3,
        "damage":25,
        "damage_type" : "刺伤"
    ]),
});
}

string query_weapon_type()
{
    return "fan";
}

