inherit SKILL_SHORT;

mapping *get_all_action()
{
    return ({
    ([  "action": "$N身形一展，施出一招「横峰断云势」，$w疾风般刺向$n的$l",
        "lian"  : "$N身形一展，施出一招「横峰断云势」，$w疾风般刺去",
        "zhaoshi":"「横峰断云势」",
        "jibie" :10,
        "limb"  : "头顶",
        "sen"   :3,
        "damage":5,
        "damage_type" : "瘀伤"
    ]),
    ([  "action": "$N一声叱喝，$w如灵蛇吞吐，施一招「青龙啸」向$n的$l刺去",
        "lian"  : "$N一声叱喝，$w如灵蛇吞吐，施一招「青龙啸」撩出",
        "zhaoshi":"「青龙啸」",
        "jibie" :17,
        "limb"  : "小腹",
        "sen"   :3,
        "damage":10,
        "damage_type" : "刺伤"
    ]),
    ([  "action": "$N飞身一跃而起，$w使出一式「琉璃刃」，三刺连环，射向$n$l",
        "lian"  : "$N飞身一跃而起，$w使出一式「琉璃刃」，三刺连环",
        "zhaoshi":"「飞云式」",
        "jibie" :25, 
        "limb"  : "琉璃刃",
        "sen"   :3,
        "damage":15,
        "damage_type" : "划伤"
    ]),
    ([  "action": "$N$w闪电般一晃，陡然使出一招「虚空无尽势」，飕的刺向$n$l",
        "lian"  : "$N$w闪电般一晃，陡然使出一招「虚空无尽势」，飕的刺出",
        "zhaoshi":"「虚空无尽势」",
        "jibie" :32, 
        "limb"  : "右眼",
        "sen"   :3,
        "damage":20,
        "damage_type" : "刺伤"
    ]),
    ([  "action": "$N飞身跃起，一式「天地重元势」，$w连环九刺，尽数射向$n而去",
        "lian"  : "$N飞身跃起，一式「天地重元势」，$w连环九刺，尽数射向斜上方",
        "zhaoshi":"「天地重元势」",
        "jibie" :38,
        "limb"  : "左眼",
        "sen"   :3,
        "damage":25,
        "damage_type" : "刺伤"
    ]),
});
}

string query_weapon_type()
{
    return "fan";
}

