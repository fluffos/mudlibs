inherit SKILL_SHORT;

mapping *get_all_action() {
  return ({
    ([ "action": "$N手中的$w自左而右地一晃，使出「飞黄腾达」带着呼呼风声横打$n的章门穴",
      "lian": "$N手中的$w自左而右地一晃，使出「飞黄腾达」带着呼呼风声横打",
      "jibie": 10,
      "limb": "脸部",
      "sen": 1,
      "zhaoshi": "「飞黄腾达",
      "damage_type": "刺伤"
    ]),
    ([ "action": "$N飞身跃起，一式「快马加鞭」，卷起漫天扇影，$w向$n电射而去",
      "lian": "$N飞身跃起，一式「快马加鞭」，卷起漫天扇影",
      "jibie": 20,
      "limb": "眼睛",
      "sen": 1,
      "zhaoshi": "「快马加鞭」",
      "damage_type": "刺伤"
    ]),
    ([ "action": "$N凝气守中，$w逼出尺许雪亮扇锋，挥出「灵台观景」，一扇快似一扇地攻向$n",
      "lian": "$N凝气守中，$w逼出尺许雪亮扇锋，挥出「灵台观景」",
      "jibie": 30,
      "limb": "鼻梁",
      "sen": 1,
      "zhaoshi": "「灵台观景」",
      "damage_type": "瘀伤"
    ]),
    ([ "action": "$N使出一招「群山叠影」挺扇中宫直进，扇尖颤动，中途忽然转而向上变幻无方",
      "lian": "$N使出一招「群山叠影」挺扇中宫直进，扇尖颤动，中途忽然转而向上变幻无方",
      "jibie": 20,
      "limb": "眼睛",
      "sen": 1,
      "zhaoshi": "「群山叠影」",
      "damage_type": "刺伤"
    ]),
    ([ "action": "$N侧身斜刺一扇，一招「风雷卷破」卷带着呼呼扇风，将$n包围紧裹",
      "lian": "$N侧身斜刺一扇，一招「风雷卷破」卷带着呼呼扇风",
      "jibie": 30,
      "limb": "鼻梁",
      "sen": 1,
      "zhaoshi": "「风雷卷破」",
      "damage_type": "瘀伤"
    ]),
  });
}

string query_weapon_type() {
  return "fan";
}
