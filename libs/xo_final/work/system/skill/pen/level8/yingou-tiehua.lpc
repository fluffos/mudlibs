inherit SKILL_SHORT;

mapping *get_all_action() {
  return ({
    ([ "action": "$N飞身跃起，一式「卷」字诀，卷起漫天笔影，$w向$n电射而去",
      "lian": "$N飞身跃起，一式「卷」字诀，卷起漫天笔影",
      "jibie": 40,
      "limb": "脸部",
      "sen": 1,
      "zhaoshi": "「卷」字诀",
      "damage_type": "刺伤"
    ]),
    ([ "action": "$N凝气守中，$w逼出尺许雪亮笔锋，陡然挥出「离」字诀攻向$n",
      "lian": "$N凝气守中，$w逼出尺许雪亮笔锋，陡然挥出「离」字诀",
      "jibie": 50,
      "limb": "眼睛",
      "sen": 1,
      "zhaoshi": "「离」字诀",
      "damage_type": "刺伤"
    ]),
    ([ "action": "$N使出一招「悲」字诀挺笔中宫直进，笔尖颤动，中途忽然转而向上",
      "lian": "$N使出一招「悲」字诀挺笔中宫直进，笔尖颤动，中途忽然转而向上",
      "jibie": 60,
      "limb": "鼻梁",
      "sen": 1,
      "zhaoshi": "「悲」字诀",
      "damage_type": "瘀伤"
    ]),
    ([ "action": "$N侧身斜刺一笔，一招「苍」字诀卷带着呼呼笔风，将$n包围紧裹",
      "lian": "$N侧身斜刺一笔，一招「苍」字诀卷带着呼呼笔风，将周身包围紧裹",
      "jibie": 100,
      "limb": "鼻梁",
      "sen": 1,
      "zhaoshi": "「苍」字诀",
      "damage_type": "瘀伤"
    ]),
  });
}

string query_weapon_type() {
  return "pen";
}
