inherit SKILL_SHORT;

mapping *get_all_action()
{
    return ({
    ([  "action": "$N一招「惊空式」，手中$w疾点向$n的期门穴",
        "lian"  : "$N一招「惊空式」，手中$w疾点",
        "jibie" :10, 
        "limb"  :"脸部",
        "sen"   :1,
        "zhaoshi": "「惊空式」",
        "damage_type" : "刺伤"
    ]),
    ([  "action": "$N吐气开声一招「皓月式」，$w如灵蛇吞吐，向$n白海穴戳去",
        "lian"  : "$N吐气开声一招「皓月式」，$w如灵蛇吞吐",
        "jibie" :20, 
        "limb"  :"眼睛",
        "sen"   :1,
        "zhaoshi": "「皓月式」",
        "damage_type" : "刺伤"
    ]),
    ([  "action": "$N向前跨上一步，手中$w使出「穿云式」，疾点$n的地仓穴",
        "lian"  : "$N向前跨上一步，手中$w使出「穿云式」",
        "jibie" :30, 
        "limb"  :"鼻梁",
        "sen"   :1,
        "zhaoshi": "「穿云式」",
        "damage_type" : "瘀伤"
    ]),
    ([  "action": "$N手中的$w自左而右地一晃，使出「飞雪式」带着呼呼风声横打$n的章门穴",
        "lian"  : "$N手中的$w自左而右地一晃，使出「飞雪式」带着呼呼风声横打",
        "jibie" :40,
        "limb"  :"肩头",
        "sen"   :1,
        "zhaoshi": "「飞雪式」",
        "damage_type" : "刺伤"
    ]),
    ([  "action": "$N飞身跃起，一式「金光式」，卷起漫天笔影，$w向$n电射而去",
        "lian"  : "$N飞身跃起，一式「金光式」，卷起漫天笔影",
        "jibie" :50, 
        "limb"  :"左臂",
        "sen"   :1,
        "zhaoshi": "「金光式」",
        "damage_type" : "瘀伤"
    ]),
    ([  "action": "$N凝气守中，$w逼出尺许雪亮笔锋，挥出「天灵式」，一笔快似一笔地攻向$n",
        "lian"  : "$N凝气守中，$w逼出尺许雪亮笔锋，挥出「天灵式」，一笔快似一笔",
        "jibie" :60,
        "limb"  :"小腹",
        "sen"   :1,
        "zhaoshi": "「天灵式」",
        "damage_type" : "刺伤"
    ]),
});
}

string query_weapon_type()
{
    return "pen";
}

