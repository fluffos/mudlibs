inherit SKILL_SHORT;

mapping *get_all_action() {
  return ({
    ([ "action": "$N刷刷刷连出三招，使出「青蟒吐信」，但见$w闪动，犹如蟒蛇吐信一般，不知要劈向何处",
      "lian": "$N刷刷刷连出三招，使出「青蟒吐信」，但见$w闪动，犹如蟒蛇吐信一般，不知要劈向何处",
      "jibie": 10,
      "sen": 5,
      "damage": 30,
      "zhaoshi": "「青蟒吐信」",
      "wound": 30,
      "damage_type": "刺伤"
    ]),
    ([ "action": "$N得理不让人，又是一招，$w直挥$n面门，逼得$n急忙侧头避让",
      "lian": "$N得理不让人，又是一招",
      "jibie": 20,
      "sen": 5,
      "damage": 35,
      "zhaoshi": "「惊」字诀",
      "wound": 30,
      "damage_type": "刺伤"
    ]),
    ([ "action": "$N左脚又在$n小腿上一扫，想将$n拌倒，跟着$w一抖，已指住$n咽喉",
      "lian": "$N手中的$w一抖",
      "jibie": 30,
      "sen": 5,
      "damage": 45,
      "zhaoshi": "「伤」字诀",
      "wound": 35,
      "damage_type": "刺伤"
    ]),
    ([ "action": "$N一声冷笑，手中$w迎面砍下，直劈$n$l",
      "lian": "$N一声冷笑，手中$w迎面砍下",
      "jibie": 40,
      "sen": 5,
      "damage": 55,
      "zhaoshi": "「卷」字诀",
      "wound": 35,
      "damage_type": "刺伤"
    ]),
    ([ "action": "$N一下冲到$n身前，突然之间拔出$w，便往$n头上砍了下去",
      "lian": "$N突然之间拔出$w",
      "jibie": 50,
      "sen": 5,
      "damage": 65,
      "zhaoshi": "「离」字诀",
      "wound": 45,
      "damage_type": "刺伤"
    ]),
    ([ "action": "$N突然一下拔$w挥击，既是突如其来，行动又是快极，$n全无闪避的馀裕",
      "lian": "$N突然一下拔$w挥击，既是突如其来，行动又是快极",
      "jibie": 60,
      "sen": 6,
      "damage": 70,
      "zhaoshi": "「悲」字诀",
      "wound": 55,
      "damage_type": "刺伤"
    ]),
    ([ "action": "$N$w挺出，一招「毒蛇出洞」，向$n当胸劈去，势道甚是劲急",
      "lian": "$N$w挺出，一招「毒蛇出洞」",
      "jibie": 70,
      "sen": 6,
      "damage": 75,
      "zhaoshi": "「毒蛇出洞」",
      "wound": 60,
      "damage_type": "刺伤"
    ]),
    ([ "action": "$N叫声：「好！」$w圈转，削向$n$l",
      "lian": "$N叫声：「好！」$w圈转",
      "jibie": 90,
      "sen": 6,
      "damage": 75,
      "zhaoshi": "「圈」字诀",
      "wound": 60,
      "damage_type": "刺伤"
    ]),
    ([ "action": "$N一招「灵舌吐信」，$w尖快绝无比点向$n的$l",
      "lian": "$N一招「灵舌吐信」，$w尖快绝无比",
      "jibie": 150,
      "sen": 6,
      "damage": 75,
      "zhaoshi": "「灵舌吐信」",
      "wound": 60,
      "damage_type": "刺伤"
    ]),
  });
}

string query_weapon_type() {
  return "pen";
}
