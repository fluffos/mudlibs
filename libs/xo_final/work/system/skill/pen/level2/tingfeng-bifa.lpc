#include <ansi.h>

inherit SKILL_SHORT;

mapping *get_all_action()
{
    return ({
    ([  "action": "$N一招"HIG"「指点江山」"NOR"，手中$w疾点向$n的期门穴!",
        "lian"  : "$N一招"HIG"「指点江山」"NOR"，手中$w疾点",
        "jibie" :10, 
        "limb"  :"脸部",
        "sen"   :1,
        "zhaoshi":  HIG"「指点江山」"NOR,
        "damage_type" : "刺伤"
    ]),
    ([  "action": "$N吐气开声一招"HIB"「银钩铁划」"NOR"，$w如灵蛇吞吐，向$n白海穴戳去!",
        "lian"  : "$N吐气开声一招"HIB"「银钩铁划」"NOR"，$w如灵蛇吞吐",
        "jibie" :20, 
        "limb"  :"眼睛",
        "sen"   :1,
        "zhaoshi":  HIB"「银钩铁划」"NOR,
        "damage_type" : "刺伤"
    ]),
    ([  "action": "$N向前跨上一步，混身充满战意，手中$w使出"CYN"「银瓶乍破」"NOR"，疾点$n的地仓穴!",
        "lian"  : "$N向前跨上一步，混身充满战意，手中$w使出"CYN"「银瓶乍破」"NOR,
        "jibie" :30, 
        "limb"  :"鼻梁",
        "sen"   :1,
        "zhaoshi":  CYN"「银瓶乍破」"NOR,
        "damage_type" : "瘀伤"
    ]),
});
}

string query_weapon_type()
{
    return "pen";
}

