inherit SKILL_SHORT;

mapping *get_all_action()
{
    return ({
    ([  "action": "只见$N时述「天王索命」，一笔紧似一笔，一笔快似一笔，一气呵成，直逼$n的周身大穴",
        "lian"  : "只见$N时述「天王索命」，一笔紧似一笔，一笔快似一笔，一气呵成",
        "jibie" :10, 
        "limb"  :"脸部",
        "sen"   :1,
        "zhaoshi":  "「天王索命」",
        "damage_type" : "刺伤"
    ]),
    ([  "action": "$N一招「天马行空」，$w自上而下划出一个大弧，平平地向$n的$l挥去",
        "lian"  : "$N一招「天马行空」，$w自上而下划出一个大弧",
        "jibie" :20, 
        "limb"  :"眼睛",
        "sen"   :1,
        "zhaoshi":  "「天马行空」",
        "damage_type" : "刺伤"
    ]),
    ([  "action": "$N一招「神龙摆尾」，右脚虚上，右手回收，$w向下截劈$n的$l",
        "lian"  : "$N一招「神龙摆尾」，右脚虚上，右手回收",
        "jibie" :30, 
        "limb"  :"鼻梁",
        "sen"   :1,
        "zhaoshi":  "「神龙摆尾」",
        "damage_type" : "瘀伤"
    ]),
});
}

string query_weapon_type()
{
    return "pen";
}

