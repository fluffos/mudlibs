inherit SKILL_SHORT;

mapping *get_all_action()
{
    return ({
    ([  "action": "$N吐气开声一招「泣」字诀，$w如灵蛇吞吐，向$n白海穴戳去",
        "lian"  : "$N吐气开声一招「泣」字诀，$w如灵蛇吞吐",
        "jibie" :10, 
        "limb"  :"脸部",
        "sen"   :1,
        "zhaoshi":  "「泣」字诀",
        "damage_type" : "刺伤"
    ]),
    ([  "action": "$N向前跨上一步，混身充满战意，使出「惊」字诀，疾点$n的地仓穴",
        "lian"  : "$N向前跨上一步，混身充满战意，使出「惊」字诀",
        "jibie" :20, 
        "limb"  :"眼睛",
        "sen"   :1,
        "zhaoshi":  "「惊」字诀",
        "damage_type" : "刺伤"
    ]),
    ([  "action": "$N手中的$w自左而右地一晃，使出「伤」字诀横打$n的章门穴",
        "lian"  : "$N手中的$w自左而右地一晃，使出「伤」字诀横打章门穴",
        "jibie" :30, 
        "limb"  :"鼻梁",
        "sen"   :1,
        "zhaoshi":  "「伤」字诀",
        "damage_type" : "瘀伤"
    ]),
});
}

string query_weapon_type()
{
    return "pen";
}

