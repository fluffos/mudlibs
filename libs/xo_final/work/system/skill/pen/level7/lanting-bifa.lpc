inherit SKILL_SHORT;

mapping *get_all_action() {
  return ({
    ([ "action": "$N吐气开声一招「泣」字诀，$w如灵蛇吞吐，向$n白海穴戳去",
      "lian": "$N吐气开声一招「泣」字诀，$w如灵蛇吞吐",
      "jibie": 10,
      "sen": 5,
      "damage": 30,
      "zhaoshi": "「泣」字诀",
      "wound": 30,
      "damage_type": "刺伤"
    ]),
    ([ "action": "$N向前跨上一步，混身充满战意，使出「惊」字诀，疾点$n的地仓穴",
      "lian": "$N向前跨上一步，混身充满战意，使出「惊」字诀",
      "jibie": 20,
      "sen": 5,
      "damage": 35,
      "zhaoshi": "「惊」字诀",
      "wound": 30,
      "damage_type": "刺伤"
    ]),
    ([ "action": "$N手中的$w自左而右地一晃，使出「伤」字诀横打$n的章门穴",
      "lian": "$N手中的$w自左而右地一晃，使出「伤」字诀横打",
      "jibie": 30,
      "sen": 5,
      "damage": 45,
      "zhaoshi": "「伤」字诀",
      "wound": 35,
      "damage_type": "刺伤"
    ]),
    ([ "action": "$N飞身跃起，一式「卷」字诀，卷起漫天笔影，$w向$n电射而去",
      "lian": "$N飞身跃起，一式「卷」字诀，卷起漫天笔影",
      "jibie": 40,
      "sen": 5,
      "damage": 55,
      "zhaoshi": "「卷」字诀",
      "wound": 35,
      "damage_type": "刺伤"
    ]),
    ([ "action": "$N凝气守中，$w逼出尺许雪亮笔锋，陡然挥出「离」字诀攻向$n",
      "lian": "$N凝气守中，$w逼出尺许雪亮笔锋，陡然挥出「离」字诀",
      "jibie": 50,
      "sen": 5,
      "damage": 65,
      "zhaoshi": "「离」字诀",
      "wound": 45,
      "damage_type": "刺伤"
    ]),
    ([ "action": "$N使出一招「悲」字诀挺笔中宫直进，笔尖颤动，中途忽然转而向上",
      "lian": "$N使出一招「悲」字诀挺笔中宫直进，笔尖颤动，中途忽然转而向上",
      "jibie": 60,
      "sen": 6,
      "damage": 70,
      "zhaoshi": "「悲」字诀",
      "wound": 55,
      "damage_type": "刺伤"
    ]),
    ([ "action": "$N侧身斜刺一笔，一招「苍」字诀卷带着呼呼笔风，将$n包围紧裹",
      "lian": "$N侧身斜刺一笔，一招「苍」字诀卷带着呼呼笔风",
      "jibie": 70,
      "sen": 6,
      "damage": 75,
      "zhaoshi": "「苍」字诀",
      "wound": 60,
      "damage_type": "刺伤"
    ]),
  });
}

string query_weapon_type() {
  return "pen";
}
