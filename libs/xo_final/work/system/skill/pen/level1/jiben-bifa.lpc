string *get_all_parry_msg()
{
    return ({
        "$n全是同归于尽的架式，$v反刺$N\n",
        "$n手中$v对刺$N。\n",
});
}

string *get_all_unarmed_msg()
{
    return ({
        "$n全是同归于尽的架式，$v反刺$N\n",
        "$n手中$v对刺$N。\n",
});
}

