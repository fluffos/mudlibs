inherit SKILL_SHORT;

mapping *get_all_action() {
  return ({
    ([ "action": "$N一招「指点江山」，手中$w疾点向$n的期门穴!",
      "lian": "$N一招「指点江山」，手中$w疾点期门穴!",
      "jibie": 10,
      "limb": "脸部",
      "sen": 1,
      "zhaoshi": "「指点江山」",
      "damage_type": "刺伤"
    ]),
    ([ "action": "$N吐气开声一招「银钩铁划」，$w如灵蛇吞吐，向$n白海穴戳去",
      "lian": "$N吐气开声一招「银钩铁划」，$w如灵蛇吞吐",
      "jibie": 20,
      "limb": "眼睛",
      "sen": 1,
      "zhaoshi": "「银钩铁划」",
      "damage_type": "刺伤"
    ]),
    ([ "action": "$N向前跨上一步，手中$w一晃，正是一招使出「灵蛇吐雾」，疾点$n的地仓穴",
      "lian": "$N向前跨上一步，手中$w使出「灵蛇吐雾」",
      "jibie": 30,
      "limb": "鼻梁",
      "sen": 1,
      "zhaoshi": "「灵蛇吐雾」",
      "damage_type": "瘀伤"
    ]),
    ([ "action": "$N手中的$w左右急晃，舞成一段光芒，使出「千变万化」带着呼呼风声笼罩了$n的章门穴",
      "lian": "$N手中的$w左右急晃，舞成一段光芒，使出「千变万化」带着呼呼风声",
      "jibie": 40,
      "limb": "肩头",
      "sen": 1,
      "zhaoshi": "「千变万化」",
      "damage_type": "刺伤"
    ]),
    ([ "action": "$N飞身跃起，一式「千蛇出洞」，卷起漫天笔影，紧紧裹住$n",
      "lian": "$N飞身跃起，一式「千蛇出洞」，卷起漫天笔影",
      "jibie": 50,
      "limb": "左臂",
      "sen": 1,
      "zhaoshi": "「千蛇出洞」",
      "damage_type": "瘀伤"
    ]),
    ([ "action": "$N使出一招「神蛇引路」挺笔中宫直进，$w忽的颤动，中途忽然转而向上变幻无方",
      "lian": "$N使出一招「神蛇引路」挺笔中宫直进，$w忽的颤动，中途忽然转而向上变幻无方",
      "jibie": 60,
      "limb": "小腹",
      "sen": 1,
      "zhaoshi": "「神蛇引路」",
      "damage_type": "刺伤"
    ]),
  });
}

string query_weapon_type() {
  return "pen";
}
