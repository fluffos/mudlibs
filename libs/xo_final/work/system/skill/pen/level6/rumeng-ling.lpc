inherit SKILL_SHORT;

mapping *get_all_action() {
  return ({
    ([ "action": "$N一招「飞鸿展翅」，手中$w猛然点向$n小腹",
      "lian": "$N一招「飞鸿展翅」，手中$w猛然点出",
      "jibie": 10,
      "sen": 5,
      "damage": 30,
      "zhaoshi": "「飞鸿展翅」",
      "wound": 30,
      "damage_type": "刺伤"
    ]),
    ([ "action": "$N不退反进，一招「兰花抚穴式」，手中$w点向$n天池穴",
      "lian": "$N不退反进，一招「兰花抚穴式」",
      "jibie": 20,
      "sen": 5,
      "damage": 35,
      "zhaoshi": "「兰花抚穴式」",
      "wound": 30,
      "damage_type": "刺伤"
    ]),
    ([ "action": "$N手中$w猛然旋转，使出「云开日出」，疾点$n的天门穴",
      "lian": "$N手中$w猛然旋转，使出「云开日出」",
      "jibie": 30,
      "sen": 5,
      "damage": 45,
      "zhaoshi": "「云开日出」",
      "wound": 35,
      "damage_type": "刺伤"
    ]),
    ([ "action": "$N手中$w呼呼做响，使出「天旋地转」，$w直打$n的区门穴",
      "lian": "$N手中$w呼呼做响，使出「天旋地转」",
      "jibie": 40,
      "sen": 5,
      "damage": 55,
      "zhaoshi": "「天旋地转」",
      "wound": 35,
      "damage_type": "刺伤"
    ]),
    ([ "action": "$N飞身跃起，一式「漫天金光」，手中$w犹如万千光点向$n飞击而去",
      "lian": "$N飞身跃起，一式「漫天金光」，手中$w犹如万千光点",
      "jibie": 50,
      "sen": 5,
      "damage": 65,
      "zhaoshi": "「漫天金光」",
      "wound": 45,
      "damage_type": "刺伤"
    ]),
    ([ "action": "$N招式陡然变慢，一招「金羽飞箭」，手中$w如离弦之箭直袭$w要穴",
      "lian": "$N招式陡然变慢，一招「金羽飞箭」，手中$w如离弦之箭",
      "jibie": 60,
      "sen": 6,
      "damage": 70,
      "zhaoshi": "「金羽飞箭」",
      "wound": 55,
      "damage_type": "刺伤"
    ]),
  });
}

string query_weapon_type() {
  return "pen";
}
