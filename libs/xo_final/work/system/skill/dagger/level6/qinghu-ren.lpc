#include <ansi.h>

inherit SKILL_SHORT;

mapping *get_all_action() {
  return ({
    ([ "action": "$N一招" + BLINK "" + HIW "「灵狐探首」" NOR "，身形一低，手中$w嗡嗡直刺$n的$l",
      "lian": "$N一招" + BLINK "" + HIW "「灵狐探首」" NOR "，身形一低，手中$w嗡嗡直刺",
      "jibie": 10,
      "zhaoshi": BLINK "" + HIW "「灵狐探首」" NOR,
      "sen": 5,
      "damage": 30,
      "wound": 30,
      "damage_type": "刺伤"
    ]),
    ([ "action": "只见$N纵身跃起，一招" + BLINK "" + HIY "「飞狐冲天」" NOR "，刃光如水，一泄千里，洒向$n全身",
      "lian": "只见$N纵身跃起，一招" + BLINK "" + HIY "「飞狐冲天」" NOR "，刃光如水，一泄千里",
      "jibie": 20,
      "zhaoshi": BLINK "" + HIY "「飞狐冲天」" NOR,
      "sen": 5,
      "damage": 35,
      "wound": 30,
      "damage_type": "刺伤"
    ]),
    ([ "action": "$N飘然而进，手中$w陡然突进,刹那间连出数招，分刺$w全身各处要害，正是一招" + BLINK "" + HIB "「妖狐灵动」" NOR,
      "lian": "$N飘然而进，手中$w陡然突进,刹那间连出数招，正是一招" + BLINK "" + HIB "「妖狐灵动」" NOR,
      "jibie": 30,
      "zhaoshi": BLINK "" + HIB "「妖狐灵动」" NOR,
      "sen": 5,
      "damage": 45,
      "wound": 35,
      "damage_type": "刺伤"
    ]),
    ([ "action": "$N手中$w斜斜的一指$n，犹如灵狐出洞，以迅雷之速直取$n的$l，却是一招" + BLINK "" + HIR "「青狐扑食」" NOR,
      "lian": "$N手中$w斜斜的一指，犹如灵狐出洞，以迅雷之速直取$n的$l，却是一招" + BLINK "" + HIR "「青狐扑食」" NOR,
      "jibie": 40,
      "zhaoshi": BLINK "" + HIR "「青狐扑食」" NOR,
      "sen": 5,
      "damage": 55,
      "wound": 35,
      "damage_type": "刺伤"
    ]),
    ([ "action": "$N一招" + BLINK "" + HIC "「狐死首丘」" NOR "，匕首刃尖指天，弓身探上，竟然是同归于尽的招式",
      "lian": "$N一招" + BLINK "" + HIC "「狐死首丘」" NOR "，匕首刃尖指天，弓身探上，竟然是同归于尽的招式",
      "jibie": 50,
      "zhaoshi": BLINK "" + HIC "「狐死首丘」" NOR,
      "sen": 5,
      "damage": 65,
      "wound": 45,
      "damage_type": "刺伤"
    ]),
    ([ "action": "$N手中$w自左而右地划了一个大弧，刺向$n的$l,突然间又转到另一方向，这正是一招" + BLINK "" + HIM "「狐疑未决」" NOR,
      "lian": "$N手中$w自左而右地划了一个大弧，突然间又转到另一方向，这正是一招" + BLINK "" + HIM "「狐疑未决」" NOR,
      "jibie": 60,
      "zhaoshi": BLINK "" + HIM "「狐疑未决」" NOR,
      "sen": 6,
      "damage": 70,
      "wound": 55,
      "damage_type": "刺伤"
    ]),
    ([ "action": "$N一式" + BLINK "" + HIM "「狐媚魇道」" NOR "，手中$w急转，化为一道血光，虚幻不定地出现在$n周围",
      "lian": "$N一式" + BLINK "" + HIM "「狐媚魇道」" NOR "，手中$w急转，化为一道血光，虚幻不定",
      "jibie": 70,
      "zhaoshi": BLINK "" + HIM "「狐媚魇道」" NOR,
      "sen": 6,
      "damage": 75,
      "wound": 60,
      "damage_type": "刺伤"
    ]),
    ([ "action": "$N纵身轻轻跃起，刃光如轮急转，晃得$n头晕目眩，正是一招" + BLINK "" + HIG "「狐假虎威」" NOR,
      "lian": "$N纵身轻轻跃起，刃光如轮急转，正是一招" + BLINK "" + HIG "「狐假虎威」" NOR,
      "jibie": 80,
      "zhaoshi": BLINK "" + HIG "「狐假虎威」" NOR,
      "sen": 6,
      "damage": 85,
      "wound": 70,
      "damage_type": "刺伤"
    ]),
  });
}

string query_weapon_type() {
  return "dagger";
}
