inherit SKILL_SHORT;

mapping *get_all_action() {
  return ({
    ([ "action": "$N脚下一滑，瞬间飘至$n面前，左手锤护住当胸，右手三指轻轻拈锥刺出，隐隐却有一丝内力贯注其上",
      "lian": "$N脚下一滑，瞬间飘向前方，左手锤护住当胸，右手三指轻轻拈锥刺出，隐隐却有一丝内力贯注其上",
      "jibie": 10,
      "sen": 5,
      "damage": 30,
      "wound": 30,
      "damage_type": "刺伤"
    ]),
    ([ "action": "$N袍袖轻挥，带出一股劲风，左手锤直击$n腹部，右手锥则挽出一道寒光，迅疾刺向$n眉间",
      "lian": "$N袍袖轻挥，带出一股劲风，左手锤直击中路，右手锥则挽出一道寒光，迅疾刺向上方",
      "jibie": 20,
      "sen": 5,
      "damage": 35,
      "wound": 30,
      "damage_type": "刺伤"
    ]),
    ([ "action": "$N右手五指捏住小锥，将一股真气汇聚其上，小锥竟似有了生命一般，游龙一闪，刺向$n前胸",
      "lian": "$N右手五指捏住小锥，将一股真气汇聚其上，小锥竟似有了生命一般，游龙一闪，电一般刺出",
      "jibie": 30,
      "sen": 5,
      "damage": 45,
      "wound": 35,
      "damage_type": "刺伤"
    ]),
    ([ "action": "$N右手手指急动，小锥在手掌中游走，忽然中指一弹，小锥如离弦之箭，直刺$n颈部",
      "lian": "$N右手手指急动，小锥在手掌中游走，忽然中指一弹，小锥如离弦之箭，直刺前方",
      "jibie": 40,
      "sen": 5,
      "damage": 55,
      "wound": 35,
      "damage_type": "刺伤"
    ]),
    ([ "action": "$N右手将小锥一松，左手锤在锥尾上一碰，只听“叮”的一声，小锥直奔$n腹部而去",
      "lian": "$N右手将小锥一松，左手锤在锥尾上一碰，只听“叮”的一声，小锥直奔前下方而去",
      "jibie": 50,
      "sen": 5,
      "damage": 65,
      "wound": 45,
      "damage_type": "刺伤"
    ]),
    ([ "action": "$N口中长啸一声，右手五指不停绕动，小锥幻出无数锥影，寒光道道，直刺$n面门",
      "lian": "$N口中长啸一声，右手五指不停绕动，小锥幻出无数锥影，寒光道道，向前方直刺出去",
      "jibie": 60,
      "sen": 6,
      "damage": 70,
      "wound": 55,
      "damage_type": "刺伤"
    ]),
    ([ "action": "$N右掌暗运一股柔力，手腕一抖，小锥划出一道弧线，绕过$n身侧，竟直刺其后心",
      "lian": "$N右掌暗运一股柔力，手腕一抖，小锥划出一道弧线，绕出半圈，竟掉转锥尖，反向刺出",
      "jibie": 70,
      "sen": 6,
      "damage": 75,
      "wound": 60,
      "damage_type": "刺伤"
    ]),
    ([ "action": "$N贯注内力于右手掌，挥动之间，隐约幻出七彩，迷离之间，小锥竟已向$n心口刺出",
      "lian": "$N贯注内力于右手掌，挥动之间，隐约幻出七彩，迷离之间，小锥竟已如闪电般刺出",
      "jibie": 80,
      "sen": 6,
      "damage": 85,
      "wound": 70,
      "damage_type": "刺伤"
    ]),
  });
}

string query_weapon_type() {
  return "dagger";
}
