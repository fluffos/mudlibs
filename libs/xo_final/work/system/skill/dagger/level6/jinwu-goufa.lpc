inherit SKILL_SHORT;

mapping *get_all_action()
{
    return ({
    ([  "action": "$N手中$w一抖，一式「灵蛇吐信」，闪电般的疾刺向$n的$l",
        "lian"  : "$N手中$w一抖，一式「灵蛇吐信」，闪电般的疾刺",
        "jibie" :10, 
        "limb"  :"脸部",
        "sen"   :1,
        "zhaoshi": "「灵蛇吐信」",
        "damage_type" : "刺伤"
    ]),
    ([  "action": "$N身形突闪，招式陡变，手中$w从一个绝想不到的方位斜刺向$n的$l",
        "lian"  : "$N身形突闪，招式陡变，手中$w从一个绝想不到的方位斜刺",
        "jibie" :20, 
        "limb"  :"眼睛",
        "sen"   :1,
        "zhaoshi": "「皓月式」",
        "damage_type" : "刺伤"
    ]),
    ([  "action": "$N一式「柔丝轻系」，剑意绵绵不绝，化做一张无形的大网将$n困在当中",
        "lian"  : "$N一式「柔丝轻系」，剑意绵绵不绝，化做一张无形的大网",
        "jibie" :30, 
        "limb"  :"鼻梁",
        "sen"   :1,
        "zhaoshi": "「柔丝轻系」",
        "damage_type" : "瘀伤"
    ]),
    ([  "action": "$N一声阴笑，飞身纵起，一式「张牙舞爪」，手中$w狂舞，幻出千万条手臂，合身扑向$n",
        "lian"  : "$N一声阴笑，飞身纵起，一式「张牙舞爪」，手中$w狂舞，幻出千万条手臂",
        "jibie" :40,
        "limb"  :"肩头",
        "sen"   :1,
        "zhaoshi": "「张牙舞爪」",
        "damage_type" : "刺伤"
    ]),
    ([  "action": "$N身形一旋看似欲走，手中$w却倏的从腋下穿过，疾刺向$n的$l，好一式「天蝎藏针」",
        "lian"  : "$N身形一旋看似欲走，手中$w却倏的从腋下穿过，好一式「天蝎藏针」",
        "jibie" :50, 
        "limb"  :"左臂",
        "sen"   :1,
        "zhaoshi": "「天蝎藏针」",
        "damage_type" : "瘀伤"
    ]),
    ([  "action": "$N脚步踉跄，身形忽的向前跌倒，一式「井底望月」，掌中$w自下而上直刺$n的小腹",
        "lian"  : "$N脚步踉跄，身形忽的向前跌倒，一式「井底望月」，掌中$w自下而上直刺",
        "jibie" :60,
        "limb"  :"小腹",
        "sen"   :1,
        "zhaoshi": "「井底望月」",
        "damage_type" : "刺伤"
    ]),
    ([  "action": "$N身形一晃，一式「金蛇缠腕」，手中$w如附骨之蛆般无声无息地刺向$n的手腕",
        "lian"  : "$N身形一晃，一式「金蛇缠腕」，手中$w如附骨之蛆般无声无息",
        "jibie" :80, 
        "limb"  :"鼻梁",
        "sen"   :1,
        "zhaoshi": "「金蛇缠腕」",
        "damage_type" : "瘀伤"
    ]),
    ([  "action": "$N一声厉啸，身形冲天而起，一式「神蟾九变」，掌中$w如鬼魅般连刺$n全身九道大穴",
        "lian"  : "$N一声厉啸，身形冲天而起，一式「神蟾九变」，掌中$w如鬼魅般连刺",
        "jibie" :100,
        "limb"  :"肩头",
        "sen"   :1,
        "zhaoshi": "「神蟾九变」",
        "damage_type" : "刺伤"
    ]),
    ([  "action": "$N缓缓低首，手中$w中宫直进，一式「蜈化龙形」，迅捷无比地往$n的$l刺去",
        "lian"  : "$N缓缓低首，手中$w中宫直进，一式「蜈化龙形」，迅捷无比地刺去",
        "jibie" :150, 
        "limb"  :"左臂",
        "sen"   :1,
        "zhaoshi": "「蜈化龙形」",
        "damage_type" : "瘀伤"
    ]),
});
}

string query_weapon_type()
{
    return "dagger";
}

