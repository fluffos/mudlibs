inherit SKILL_SHORT;

mapping *get_all_action()
{
    return ({
    ([  "action": "$N一招「指点江山」，手中$w疾点向$n的期门穴!",
        "lian"  : "$N一招「指点江山」，手中$w疾点",
        "jibie" :10,
        "sen"   :5,
        "damage":30,
        "zhaoshi":  "「指点江山」",
	"wound" :30,
        "damage_type" : "刺伤"
    ]),
    ([  "action": "$N吐气开声一招「银钩铁划」，$w如灵蛇吞吐，向$n白海穴戳去",
        "lian"  : "$N吐气开声一招「银钩铁划」，$w如灵蛇吞吐",
        "jibie" :20,
        "sen"   :5,
        "damage":35,
        "zhaoshi":  "「银钩铁划」",
	"wound" :30,
        "damage_type" : "刺伤"
    ]),
    ([  "action": "$N向前跨上一步，手中$w一晃，正是一招使出「灵蛇吐雾」，疾点$n的地仓穴",
        "lian"  : "$N向前跨上一步，手中$w一晃，正是一招使出「灵蛇吐雾」",
        "jibie" :30, 
        "sen"   :5,
        "damage":45,
    "zhaoshi":  "「灵蛇吐雾」",
	"wound" :35,
        "damage_type" : "刺伤"
    ]),
    ([  "action": "$N手中的$w左右急晃，舞成一段光芒，使出「千变万化」带着呼呼风声笼罩了$n的章门穴",
        "lian"  : "$N手中的$w左右急晃，舞成一段光芒，使出「千变万化」带着呼呼风声，直刺前方",
        "jibie" :40, 
        "sen"   :5,
        "damage":55,
    "zhaoshi":  "「千变万化」",
	"wound" :35,
        "damage_type" : "刺伤"
    ]),
    ([  "action": "$N飞身跃起，一式「千蛇出洞」，卷起漫天棍影，紧紧裹住$n",
        "lian"  : "$N飞身跃起，一式「千蛇出洞」，卷起漫天棍影",
        "jibie" :50,
        "sen"   :5,
        "damage":65,
    "zhaoshi":  "「千蛇出洞」",
	"wound" :45,
        "damage_type" : "刺伤"
    ]),
    ([  "action": "$N凝气守中，$w逼出阵阵光芒，挥出「灵台观景」，一招快一招地攻向$n",
        "lian"  : "$N凝气守中，$w逼出阵阵光芒，挥出「灵台观景」，一招快一招",
        "jibie" :60, 
        "sen"   :6,
        "damage":70,
    "zhaoshi":  "「灵台观景」",
	"wound" :55,
        "damage_type" : "刺伤"
    ]),
    ([  "action": "$N使出一招「神蛇引路」挺笔中宫直进，$w忽的颤动，中途忽然转而向上变幻无方",   
        "lian"  : "$N使出一招「神蛇引路」挺笔中宫直进，$w忽的颤动，中途忽然转而向上变幻无方",
        "jibie" :70,
        "sen"   :6,
        "damage":75,
    "zhaoshi":  "「神蛇引路」",
	"wound" :60,
        "damage_type" : "刺伤"
    ]),
    ([  "action": "$N侧身手中的$w斜刺，一招「奇采迭出」，刺向$n胸前檀中大穴",
        "lian"  : "$N侧身手中的$w斜刺，一招「奇采迭出」",
        "jibie" :80,    
        "sen"   :6,
        "damage":85,
    "zhaoshi":  "「奇采迭出」",
	"wound" :70,
        "damage_type" : "刺伤"
    ]),
});
}

string query_weapon_type()
{
    return "stickwhip";
}

