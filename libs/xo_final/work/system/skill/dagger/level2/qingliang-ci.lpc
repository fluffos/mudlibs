inherit SKILL_SHORT;

mapping *get_all_action()
{
    return ({
    ([  "action": "$N左手施展出一招「清心普善」，手中的$w疾点向$n的期门穴",
        "lian"  : "$N左手施展出一招「清心普善」，手中的$w疾点",
        "jibie" :10, 
        "limb"  :"脸部",
        "sen"   :1,
        "zhaoshi":  "「清心普善」",
        "damage_type" : "刺伤"
    ]),
    ([  "action": "$N吐气开声一招「寒梅映雪」，$w如灵蛇吞吐，向$n白海穴戳去",
        "lian"  : "$N吐气开声一招「寒梅映雪」，$w如灵蛇吞吐",
        "jibie" :20, 
        "limb"  :"眼睛",
        "sen"   :1,
        "zhaoshi":  "「寒梅映雪」",
        "damage_type" : "刺伤"
    ]),
    ([  "action": "$N向前跨上一步，混身充满战意，手中$w使出「追风逐电」，疾点$n的地仓穴",
        "lian"  : "$N向前跨上一步，混身充满战意，手中$w使出「追风逐电」",
        "jibie" :30, 
        "limb"  :"鼻梁",
        "sen"   :1,
        "zhaoshi":  "「追风逐电」",
        "damage_type" : "瘀伤"
    ]),
});
}

string query_weapon_type()
{
    return "dagger";
}

