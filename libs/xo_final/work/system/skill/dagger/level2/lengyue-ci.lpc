inherit SKILL_SHORT;

mapping *get_all_action() {
  return ({
    ([ "action": "$N双脚并步，身体立起，一招「莲叶托桃」，$w向前平刺$n的裆部",
      "lian": "$N双脚并步，身体立起，一招「莲叶托桃」，$w向前平刺",
      "jibie": 10,
      "limb": "脸部",
      "sen": 1,
      "zhaoshi": "「莲叶托桃」",
      "damage_type": "刺伤"
    ]),
    ([ "action": "$N一招「群魔乱舞」，$w舞动护住全身向$n撞去",
      "lian": "$N一招「群魔乱舞」，$w舞动护住全身",
      "jibie": 20,
      "limb": "眼睛",
      "sen": 1,
      "zhaoshi": "「群魔乱舞」",
      "damage_type": "刺伤"
    ]),
  });
}

string query_weapon_type() {
  return "dagger";
}
