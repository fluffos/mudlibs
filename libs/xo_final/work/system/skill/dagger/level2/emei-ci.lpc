inherit SKILL_SHORT;

mapping *get_all_action()
{
    return ({
    ([  "action": "$N身形一展，施出一招「蝎尾针」，手中$w疾风般刺向$n的$l",
        "lian"  : "$N身形一展，施出一招「蝎尾针」，手中$w疾风般刺出",
        "jibie" :10, 
        "limb"  :"脸部",
        "sen"   :1,
        "zhaoshi":  "「蝎尾针」",
        "damage_type" : "刺伤"
    ]),
    ([  "action": "$N一声叱喝，$w如灵蛇吞吐，施一招「蛾眉刺」向$n的$l刺去",
        "lian"  : "$N一声叱喝，$w如灵蛇吞吐，施一招「蛾眉刺」，迅急无比",
        "jibie" :20, 
        "limb"  :"眼睛",
        "sen"   :1,
        "zhaoshi":  "「蛾眉刺」",
        "damage_type" : "刺伤"
    ]),
    ([  "action": "$N飞身一跃而起，手中$w使出「电光劲」，三刺连环，射向$n$l",
        "lian"  : "$N飞身一跃而起，手中$w使出「电光劲」，三刺连环",
        "jibie" :30, 
        "limb"  :"鼻梁",
        "sen"   :1,
        "zhaoshi":  "「电光劲」",
        "damage_type" : "瘀伤"
    ]),
    ([  "action": "$N手中$w闪电般一晃，陡然使出一招「回峰蜿蜒势」，飕的刺向$n$l",
        "lian"  : "$N手中$w闪电般一晃，陡然使出一招「回峰蜿蜒势」",
        "jibie" :40,
        "limb"  :"肩头",
        "sen"   :1,
        "zhaoshi":  "「回峰蜿蜒势」",
        "damage_type" : "刺伤"
    ]),
    ([  "action": "$N飞身跃起，一式「九转连环势」，手中$w连环九刺，尽数射向$n而去",
        "lian"  : "$N飞身跃起，一式「九转连环势」，手中$w连环九刺",
        "jibie" :50, 
        "limb"  :"左臂",
        "sen"   :1,
        "zhaoshi":  "「九转连环势」",
        "damage_type" : "瘀伤"
    ]),
});
}

string query_weapon_type()
{
    return "dagger";
}

