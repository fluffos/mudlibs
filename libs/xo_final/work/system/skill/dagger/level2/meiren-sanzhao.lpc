inherit SKILL_SHORT;

mapping *get_all_action()
{
    return ({
    ([  "action": "$N身子微曲，纤腰轻扭，左足反踢，向$n的小腹踢去，$n后缩相避，\n$N顺势反过身来，左手搂住$n头颈，右手握剑对准$n后心，一剑刺去",
        "lian"  : "$N身子微曲，纤腰轻扭，左足反踢，\n$N顺势反过身来，一剑刺去",
        "jibie" :10, 
        "limb"  :"脸部",
        "sen"   :1,
        "zhaoshi": "贵妃回眸",
        "damage_type" : "刺伤"
    ]),
    ([  "action": "$N翻身卧倒，$n伸出右足踏住$N的后腰，$N的脑袋向着她自己的胸口钻落，\n顺势在地下一个筋斗，在$n的胯下钻过，右手握剑刺入$n的后心",
        "lian"  : "$N翻身卧倒，脑袋向着她自己的胸口钻落，\n顺势在地下一个筋斗，右手握剑刺出",
        "jibie" :20, 
        "limb"  :"眼睛",
        "sen"   :1,
        "zhaoshi": "小怜横陈",
        "damage_type" : "刺伤"
    ]),
    ([  "action": "$N右足向前轻踢，顺势一勾，腿上的剑疾向$n的咽喉刺去",
        "lian"  : "$N右足向前轻踢，顺势一勾，腿上的剑疾刺去",
        "jibie" :30, 
        "limb"  :"鼻梁",
        "sen"   :1,
        "zhaoshi": "飞燕回翔",
        "damage_type" : "瘀伤"
    ]),
});
}

int valid_learn( object me )
{
    if ( me->query("gender") != "女性" )
    {
        return notify_fail("你不是女子，又怎么能学会美人三招呢？\n");
    }

    return ::valid_learn( me );
}

int valid_lian( object me )
{
    if ( me->query("gender") != "女性" )
    {
        return notify_fail("你不是女子，又怎么能学会美人三招呢？\n");
    }

    return ::valid_lian( me );
}

string query_weapon_type()
{
    return "dagger";
}

