inherit SKILL_SHORT;

mapping *get_all_action()
{
    return ({
    ([  "action": "$N双手一晃，一招「千变万化」，手中的$w幻出万道金光，
如一条金龙般飞向$n的$l",
        "lian"  : "$N双手一晃，一招「千变万化」，手中的$w幻出万道金光，
如一条金龙般飞出",
        "jibie" :10, 
        "limb"  :"脸部",
        "sen"   :1,
        "zhaoshi":"「千变万化」",
        "damage_type" : "刺伤"
    ]),
    ([  "action": "$N右手一抖，一道金光冒出，只一刹那间，左手$w迅雷般越
过右手的$w，正是一招「奇诡莫测」，抢先飞向$n的$l",
        "lian"  : "$N右手一抖，一道金光冒出，只一刹那间，左手$w迅雷般越
过右手的$w，正是一招「奇诡莫测」",
        "jibie" :20, 
        "limb"  :"眼睛",
        "sen"   :1,
        "zhaoshi":"「奇诡莫测」",
        "damage_type" : "刺伤"
    ]),
});
}

string query_weapon_type()
{
    return "dagger";
}

