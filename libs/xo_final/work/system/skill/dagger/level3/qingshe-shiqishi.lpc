inherit SKILL_SHORT;

mapping *get_all_action() {
  return ({
    ([ "action": "$N一反身，使一招「鱼死网破」，$w不顾一切地劈向$n的$l",
      "lian": "$N一反身，使一招「鱼死网破」，$w不顾一切地劈出",
      "jibie": 10,
      "limb": "脸部",
      "sen": 1,
      "zhaoshi": "「鱼死网破」",
      "damage_type": "刺伤"
    ]),
    ([ "action": "$N右手$w向后撤，再向前平平托起，一招「描龙绣凤」刺向$n的$l",
      "lian": "$N右手$w向后撤，再向前平平托起，一招「描龙绣凤」",
      "jibie": 20,
      "limb": "眼睛",
      "sen": 1,
      "zhaoshi": "「描龙绣凤」",
      "damage_type": "刺伤"
    ]),
    ([ "action": "$N身子向上纵起，一招「天地同寿」，头下脚上，$w向$n的头顶刺去",
      "lian": "$N身子向上纵起，一招「天地同寿」，头下脚上",
      "jibie": 30,
      "limb": "鼻梁",
      "sen": 1,
      "zhaoshi": "「天地同寿」",
      "damage_type": "瘀伤"
    ]),
  });
}

string query_weapon_type() {
  return "dagger";
}
