inherit SKILL_SHORT;

mapping *get_all_action() {
  return ({
    ([ "action": "只见$N$w望空一点，一招「翻天覆地」同时攻向$n的头部，左腿横出，扫向$n腿部",
      "lian": "只见$N$w望空一点，一招「翻天覆地」",
      "jibie": 10,
      "limb": "脸部",
      "sen": 1,
      "zhaoshi": "「翻天覆地」",
      "damage_type": "刺伤"
    ]),
    ([ "action": "只见$N左手剑指虚攻$n的上身，$w却以迅雷不及掩耳之势向$n的腰部钩去。好一招「若离若合」！",
      "lian": "只见$N左手剑指虚攻，$w却以迅雷不及掩耳之势钩去",
      "jibie": 20,
      "limb": "眼睛",
      "sen": 1,
      "zhaoshi": "「若离若合」",
      "damage_type": "刺伤"
    ]),
    ([ "action": "只见$N一招「雪满银钩」将$w舞得如同雪花纷飞，将$n的全身笼罩在$w光芒之下",
      "lian": "只见$N一招「雪满银钩」将$w舞得如同雪花纷飞",
      "jibie": 30,
      "limb": "鼻梁",
      "sen": 1,
      "zhaoshi": "「雪满银钩」",
      "damage_type": "瘀伤"
    ]),
  });
}

string query_weapon_type() {
  return "dagger";
}
