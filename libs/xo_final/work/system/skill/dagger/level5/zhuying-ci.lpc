#include <ansi.h>

inherit SKILL_SHORT;

mapping *get_all_action() {
  return ({
    ([ "action": "$N一转身，$w向后斜带，一招「飞横拔户」，砍向$n的$l",
      "lian": "$N一转身，$w向后斜带，一招「飞横拔户」，砍去",
      "zhaoshi": "「飞横拔户」",
      "jibie": 10,
      "limb": "头顶",
      "sen": 3,
      "damage": 5,
      "damage_type": "瘀伤"
    ]),
    ([ "action": "$N双手握着$w，微一低头，一招「闭门思过」，突然从脑后疾向$n刺去",
      "lian": "$N双手握着$w，微一低头，一招「闭门思过」",
      "zhaoshi": "「闭门思过」",
      "jibie": 17,
      "limb": "小腹",
      "sen": 3,
      "damage": 10,
      "damage_type": "刺伤"
    ]),
    ([ "action": "$N双手执着$w，钩头向内，一招「欲擒故纵」，倒转身体，刺向$n",
      "lian": "$N双手执着$w，钩头向内，一招「欲擒故纵」，倒转身体",
      "zhaoshi": "「欲擒故纵」",
      "jibie": 25,
      "limb": "脸部",
      "sen": 3,
      "damage": 15,
      "damage_type": "划伤"
    ]),
    ([ "action": "$N一招「对牛弹琴」，$w在$n一楞之间突然划向$n的$l",
      "lian": "$N一招「对牛弹琴」，$w在一楞之间突然划出",
      "zhaoshi": "「对牛弹琴」",
      "jibie": 32,
      "limb": "右眼",
      "sen": 3,
      "damage": 20,
      "damage_type": "刺伤",
    ]),
  });
}

string query_weapon_type() {
  return "dagger";
}
