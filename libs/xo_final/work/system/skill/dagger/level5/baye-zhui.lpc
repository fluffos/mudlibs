inherit SKILL_SHORT;

mapping *get_all_action()
{
    return ({
    ([  "action": "$N一式「变幻多端」，忽听得飕飕两声，黄光闪动，$w向$n的$l射出",
        "lian"  : "$N一式「变幻多端」，忽听得飕飕两声，黄光闪动",
        "zhaoshi":"「变幻多端」",
        "jibie" :10,
        "limb"  : "头顶",
        "sen"   :3,
        "damage":5,
        "damage_type" : "瘀伤"
    ]),
    ([  "action": "$w倏左倏右，四面八方的罩向$n，却是$N以一式「倏左倏右」向$n发出八枚$w",
        "lian"  : "$N倏左倏右，四面八方，却是$N以一式「倏左倏右」",
        "zhaoshi":"「倏左倏右」",
        "jibie" :17,
        "limb"  : "小腹",
        "sen"   :3,
        "damage":10,
        "damage_type" : "刺伤"
    ]),
    ([  "action": "$N低哼一声，一式「仙女散花」，一把$w向$n撒出，共有四四一十六之多",
        "lian"  : "$N低哼一声，一式「仙女散花」，一把$w撒出，共有四四一十六之多",
        "zhaoshi":"「仙女散花」",
        "jibie" :25, 
        "limb"  : "脸部",
        "sen"   :3,
        "damage":15,
        "damage_type" : "划伤"
    ]),
    ([  "action": "$n只听得飕飕声响，却是$N一招「满天星雨」，十多枚$w向$n各大穴飞去",
        "lian"  : "$N一招「满天星雨」，十多枚$w疾刺而出",
        "zhaoshi":"「满天星雨」",
        "jibie" :32, 
        "limb"  : "右眼",
        "sen"   :3,
        "damage":20,
        "damage_type" : "刺伤"
    ]),
    ([  "action": "突然黄光一闪，$N一式「千里追魂」，三枚$w向$n的胸口要害打去",
        "lian"  : "突然黄光一闪，$N一式「千里追魂」，三枚$w直刺斜上方",
        "zhaoshi":"「千里追魂」",
        "jibie" :38,
        "limb"  : "左眼",
        "sen"   :3,
        "damage":25,
        "damage_type" : "刺伤"
    ]),
    ([  "action": "$N一式「回头望月」，突然反手掷出三枚$w，飞向$n的后脑",
        "lian"  : "$N一式「回头望月」，突然反手掷出三枚$w",
        "zhaoshi":"「回头望月」",
        "jibie" :45,
        "limb"  : "前胸",
        "sen"   :3,
        "damage":30,
        "damage_type" : "划伤"
    ]),
    ([  "action": "$N一招「闪电风雷」，五枚$w连续飞射，破风声劲急，快得$n不能看清形影",
        "lian"  : "$N一招「闪电风雷」，五枚$w连续飞射，破风声劲急",
        "zhaoshi":"「闪电风雷」",
        "jibie" :52,
        "limb"  : "头顶",
        "sen"   :3,
        "damage":35,
        "damage_type" : "划伤"
    ]),
    ([  "action": "$N一招「金花夺命」，全身飞扑而进，左手飞扬，四枚$w射向$n和胸部",
        "lian"  : "$N一招「金花夺命」，全身飞扑而进，左手飞扬",
        "zhaoshi":"「金花夺命」",
        "jibie" :60,
        "limb"  : "脚面",
        "sen"   :3,
        "damage":40,
        "damage_type" : "刺伤"
    ]),
    ([  "action": "$N飞身而起，一招「梅花顿现」，$w一枚枚的从$N手中飞出，杂杂梅花射向$n",
        "lian"  : "$N飞身而起，一招「梅花顿现」，$w一枚枚的从$N手中飞出",
        "zhaoshi":"「梅花顿现」",
        "jibie" :66,
        "limb"  : "腰间",
        "sen"   :3,
        "damage":45,
        "damage_type" : "划伤"
    ]),
});
}

string query_weapon_type()
{
    return "dagger";
}

