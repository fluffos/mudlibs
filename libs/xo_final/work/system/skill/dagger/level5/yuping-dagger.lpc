inherit SKILL_SHORT;

mapping *get_all_action()
{
    return ({
    ([  "action": "$N手中$w斜指，一招「停车问路」，反身一顿，一刀向$n的$l撩去",
        "lian"  : "$N手中$w斜指，一招「停车问路」，反身一顿，一刀撩去",
        "zhaoshi":"「停车问路」",
        "jibie" :10,
        "limb"  : "头顶",
        "sen"   :3,
        "damage":5,
        "damage_type" : "瘀伤"
    ]),
    ([  "action": "$N一招「童子挂画」，左右腿虚点，$w一提一收，平刃挥向$n的颈部",
        "lian"  : "$N一招「童子挂画」，左右腿虚点，$w一提一收",
        "zhaoshi":"「童子挂画」",
        "jibie" :17,
        "limb"  : "小腹",
        "sen"   :3,
        "damage":10,
        "damage_type" : "刺伤"
    ]),
    ([  "action": "$N展身虚步，提腰跃落，一招「推窗望月」，刀锋一卷，拦腰斩向$n",
        "lian"  : "$N展身虚步，提腰跃落，一招「推窗望月」，刀锋一卷",
        "zhaoshi":"「推窗望月」",
        "jibie" :25, 
        "limb"  : "脸部",
        "sen"   :3,
        "damage":15,
        "damage_type" : "划伤"
    ]),
    ([  "action": "$N一招「开门见山」，$w大开大阖，自上而下划出一个大弧，笔直劈向$n",
        "lian"  : "$N一招「开门见山」，$w大开大阖，自上而下划出一个大弧",
        "zhaoshi":"「开门见山」",
        "jibie" :32, 
        "limb"  : "右眼",
        "sen"   :3,
        "damage":20,
        "damage_type" : "刺伤"
    ]),
    ([  "action": "$N手中$w一沉，一招「临溪观鱼」，双手持刃拦腰反切，砍向$n的胸口",
        "lian"  : "$N手中$w一沉，一招「临溪观鱼」，双手持刃拦腰反切",
        "zhaoshi":"「临溪观鱼」",
        "jibie" :38,
        "limb"  : "左眼",
        "sen"   :3,
        "damage":25,
        "damage_type" : "刺伤"
    ]),
    ([  "action": "$N挥舞$w，使出一招「张弓望的」，上劈下撩，左挡右开，齐齐罩向$n",
        "lian"  : "$N挥舞$w，使出一招「张弓望的」，上劈下撩，左挡右开",
        "zhaoshi":"「张弓望的」",
        "jibie" :45,
        "limb"  : "前胸",
        "sen"   :3,
        "damage":30,
        "damage_type" : "划伤"
    ]),
    ([  "action": "$N一招「风送轻舟」，左脚跃步落地，$w顺势往前，挟风声劈向$n的$l",
        "lian"  : "$N一招「风送轻舟」，左脚跃步落地，$w顺势往前",
        "zhaoshi":"「风送轻舟」",
        "jibie" :52,
        "limb"  : "头顶",
        "sen"   :3,
        "damage":35,
        "damage_type" : "划伤"
    ]),
