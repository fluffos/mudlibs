inherit SKILL_SHORT;

mapping *get_all_action()
{
    return ({
    ([  "action": "$N右手一挥$w，一舞剑器动四方。$n如山色沮丧，就连天地亦为之久低昂",
        "lian"  : "$N右手一挥$w，一舞剑器动四方。如山色沮丧，就连天地亦为之久低昂",
        "jibie" :10,
        "sen"   :3,
        "damage":15,
        "damage_type" : "瘀伤"
    ]),
    ([  "action": "$N剑锋突转，一招『羿射九日落』矫如群帝骖龙翔",
        "lian"  : "$N剑锋突转，一招『羿射九日落』矫如群帝骖龙翔",
        "jibie" :20,
        "sen"   :3,
        "damage":20,
        "damage_type" : "刺伤"
    ]),
    ([  "action": "$N手中的$w突然使出『绛唇珠袖两寂寞』，真是来如雷霆收震怒，罢如江海凝清光，让
$n喘不过气来",
        "lian"  : "$N手中的$w突然使出『绛唇珠袖两寂寞』，真是来如雷霆收震怒，罢如江海凝清光，让
人喘不过气来",
        "jibie" :30, 
        "sen"   :3,
        "damage":25,
        "damage_type" : "瘀伤"
    ]),
    ([  "action": "$N剑气一转，『金粟堆南木已拱，瞿塘石城草萧瑟』使出，只觉得玳弦急管曲复终，乐
极哀来月东出，姿态妙曼已极",
        "lian"  : "$N剑气一转，『金粟堆南木已拱，瞿塘石城草萧瑟』使出，只觉得玳弦急管曲复终，乐
极哀来月东出，姿态妙曼已极",
        "jibie" :40, 
        "sen"   :3,
        "damage":30,
        "damage_type" : "刺伤"
    ]),
    ([  "action": "$N双手紧握$w，一招『风尘洞庭昏王室，足茧荒山转愁』向$n$l劈落",
        "lian"  : "$N双手紧握$w，一招『风尘洞庭昏王室，足茧荒山转愁』劈落",
        "jibie" :50,
        "sen"   :3,
        "damage":35,
        "damage_type" : "瘀伤"
    ]),
});
}

string query_weapon_type()
{
    return "dagger";
}

