inherit SKILL_SHORT;

mapping *get_all_action() {
  return ({
    ([ "action": "$N一招「钩心斗角」，$w自左而右，一气呵成横扫$n的$l",
      "lian": "$N一招「钩心斗角」，$w自左而右，一气呵成",
      "jibie": 10,
      "limb": "脸部",
      "sen": 1,
      "zhaoshi": "「钩心斗角」",
      "damage_type": "刺伤"
    ]),
    ([ "action": "$N右脚向前一步，左膝提起，一招「不阴不阳」，$w向前上方刺向$n的$l",
      "lian": "$N右脚向前一步，左膝提起，一招「不阴不阳」，$w向前上方刺出",
      "jibie": 20,
      "limb": "眼睛",
      "sen": 1,
      "zhaoshi": "「不阴不阳」",
      "damage_type": "刺伤"
    ]),
    ([ "action": "$N使一招「尔虞我诈」，右脚向后回撤，$w随身体右后撤，突然向左前方刺向$n的$l",
      "lian": "$N使一招「尔虞我诈」，右脚向后回撤，$w随身体右后撤，突然向左前方刺出",
      "jibie": 30,
      "limb": "鼻梁",
      "sen": 1,
      "zhaoshi": "「尔虞我诈」",
      "damage_type": "瘀伤"
    ]),
    ([ "action": "$N使出「峰峦重叠」，$w划出三个圆弧，绵绵不断划向$n的$l",
      "lian": "$N使出「峰峦重叠」，$w划出三个圆弧，绵绵不断",
      "jibie": 40,
      "limb": "肩头",
      "sen": 1,
      "zhaoshi": "「峰峦重叠」",
      "damage_type": "刺伤"
    ]),
  });
}

string query_weapon_type() {
  return "dagger";
}
