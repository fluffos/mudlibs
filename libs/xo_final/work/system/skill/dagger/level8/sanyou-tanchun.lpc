#include <ansi.h>

inherit SKILL_SHORT;

mapping *get_all_action()
{
    return ({
    ([  "action": "$N面色凝然，内力不停流转于全身，真气却汇聚于手中$w之上，正是一式「松柏常青」，\n"+
                  "$n只觉周围隐隐散发着寒气，而$w就在不经意间迅疾闪到了面前，心下不禁大骇",
        "lian"  : "$N面色凝然，内力不停流转于全身，真气却汇聚于手中$w之上，正是一式「松柏常青」，\n"+
                  "周围隐隐散发着寒气，而$w就在不经意间迅疾闪出，一丝破空之声甚为骇人",
        "zhaoshi":"「松柏常青」",
        "jibie" :10,
        "sen"   :6,
        "damage":75,
  	"wound":70,
        "damage_type" : "刺伤"
    ]),
    ([  "action": "$N将一股真气凝聚于丹田之中，身形一晃，脚踏四象，衣袖带起阵阵轻风，一式「竹影夜摇」，\n"+
                  "$n眼前顿时幻出无数身影，其中夹杂着数道$w的寒光，竟似同时攻向自己周身各处要穴",
        "lian"  : "$N将一股真气凝聚于丹田之中，身形一晃，脚踏四象，衣袖带起阵阵轻风，一式「竹影夜摇」，\n"+
                  "顿时幻出无数身影，其中夹杂着数道$w的寒光，竟似同时攻向前方各处",
        "zhaoshi":"「竹影夜摇」",
        "jibie" :40,
        "sen"   :7,
        "damage":80,
  	"wound":80,
        "damage_type" : "瘀伤"
    ]),
    ([  "action": "$N暗运内力，提气纵身，飘然前行，竟似在冰上滑行，瞬间便来到了$n身前，一式「踏雪寻梅」，\n"+
                  "手掌翻飞，$w自下而上，带着丝丝风声，划向$n",
        "lian"  : "$N暗运内力，提气纵身，飘然前行，竟似在冰上滑行，瞬间便纵出数丈，一式「踏雪寻梅」，\n"+
                  "手掌翻飞，$w自下而上，带着丝丝风声，发力划出",
        "zhaoshi":"「踏雪寻梅」",
        "jibie" :70, 
        "sen"   :8,
        "damage":90,
  	"wound":90,
        "damage_type" : "划伤"
    ]),
});
}

int valid_learn(object me)
{
    if ( me->query_jibie("yunv-zhen") < 60 )
    {
        return notify_fail("青城武功讲究根基扎实，你城字十二破的功夫还未到一定火候，不能练习三友探春！\n");
    }

    return ::valid_learn( me );
}

int valid_lian( object me )
{
    if ( me->query_jibie("yunv-zhen") < 60 )
    {
        return notify_fail("青城武功讲究根基扎实，你城字十二破的功夫还未到一定火候，不能练习三友探春！\n");
    }

    return ::valid_lian( me );
}

string query_weapon_type()
{
    return "dagger";
}

