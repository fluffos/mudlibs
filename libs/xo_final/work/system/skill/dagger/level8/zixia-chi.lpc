inherit SKILL_SHORT;

mapping *get_all_action()
{
    return ({
    ([  "action": "$N使一招「陨星乍现」，手中$w疾射$n的$l",
        "lian"  : "$N使一招「陨星乍现」，手中$w疾射",
        "jibie" :10,
        "sen"   :5,
        "damage":30,
        "zhaoshi":  "「陨星乍现」",
	"wound" :30,
        "damage_type" : "刺伤"
    ]),
    ([  "action": "$N使出「玉隼击空」，双手下沉$w陡的向上飞出直袭$n的$l",
        "lian"  : "$N使出「玉隼击空」，双手下沉$w陡的向上飞出",
        "jibie" :20,
        "sen"   :5,
        "damage":35,
        "zhaoshi":  "「玉隼击空」",
	"wound" :30,
        "damage_type" : "刺伤"
    ]),
    ([  "action": "$N一招「暮霭沉沉」，长袖一挥，手中$w从腋下激射$n的$l",
        "lian"  : "$N一招「暮霭沉沉」，长袖一挥，手中$w从腋下激射刺出",
        "jibie" :30, 
        "sen"   :5,
        "damage":45,
        "zhaoshi":  "「暮霭沉沉」",
	"wound" :35,
        "damage_type" : "刺伤"
    ]),
    ([  "action": "$N手中$w一式「长电裂空」，$w幻作一道白光直奔$n的$l",
        "lian"  : "$N手中$w一式「长电裂空」，$w幻作一道白光",
        "jibie" :40, 
        "sen"   :5,
        "damage":55,
        "zhaoshi":  "「长电裂空」",
	"wound" :35,
        "damage_type" : "刺伤"
    ]),
    ([  "action": "$N纵身一跃，手中$w一招「苍龙入海」射向$n的$l",
        "lian"  : "$N纵身一跃，手中$w一招「苍龙入海」",
        "jibie" :50,
        "sen"   :5,
        "damage":65,
        "zhaoshi":  "「苍龙入海」",
	"wound" :45,
        "damage_type" : "刺伤"
    ]),
    ([  "action": "$N手扣$w,凭空一指，一招「巴山夜雨」洒向$n的$l",
        "lian"  : "$N手扣$w,凭空一指，一招「巴山夜雨」洒出去",
        "jibie" :60, 
        "sen"   :6,
        "damage":70,
        "zhaoshi":  "「巴山夜雨」",
	"wound" :55,
        "damage_type" : "刺伤"
    ]),
    ([  "action": "$N身形一晃，使一招「彗星横空」$w脱手而出，袭向$n的$l",   
        "lian"  : "$N身形一晃，使一招「彗星横空」$w脱手而出",
        "jibie" :70,
        "sen"   :6,
        "damage":75,
        "zhaoshi":  "「彗星横空」",
	"wound" :60,
        "damage_type" : "刺伤"
    ]),
    ([  "action": "$N身形一转手中$w使一招「后弈射日」画出一道光弧袭向$n的$l",
        "lian"  : "$N身形一转手中$w使一招「后弈射日」画出一道光弧",
        "jibie" :80,    
        "sen"   :6,
        "damage":85,
        "zhaoshi":  "「后弈射日」",
	"wound" :70,
        "damage_type" : "刺伤"
    ]),
});
}

string query_weapon_type()
{
    return "dagger";
}

