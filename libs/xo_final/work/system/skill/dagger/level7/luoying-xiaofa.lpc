string query_weapon_type()
{
    return "dagger";
}

int valid_lian( object me )
{
    if ( me->query_jibie("literate") < 150 )
    {
        return notify_fail("你的文化太低，无法练这门武功。\n");
    }

    return ::valid_lian(me);
}

int valid_learn(object me)
{   
    if ( me->query_jibie("literate") < 150 )
    {
        return notify_fail("你的文化太低，无法练这门武功。\n");
    }

    return ::valid_learn(me);
}

