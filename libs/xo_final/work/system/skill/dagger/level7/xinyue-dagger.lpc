inherit SKILL_SHORT;

mapping *get_all_action() {
  return ({
    ([ "action": "$N右手一挥$w，扬起漫天刀光。挥挥洒洒尽在$n左右，\n$n彷佛笼罩在凄迷月色之中，刀意竟是无穷无尽，绵绵不绝!",
      "lian": "$N右手一挥$w，扬起漫天刀光。挥挥洒洒尽在$n左右，\n刀意竟是无穷无尽，绵绵不绝!",
      "jibie": 10,
      "limb": "头顶",
      "sen": 3,
      "damage": 5,
      "damage_type": "瘀伤"
    ]),
    ([ "action": "$N刀锋突转，带着奇异的弧度呼啸而来，淡淡的刀光仿佛天上那一抹新月!",
      "lian": "$N刀锋突转，带着奇异的弧度呼啸而来，淡淡的刀光仿佛天上那一抹新月!",
      "jibie": 17,
      "limb": "小腹",
      "sen": 3,
      "damage": 10,
      "damage_type": "刺伤"
    ]),
    ([ "action": "$N手中的$w突然重若千斤，挥洒之间，无不沉滞已极。竟似泰山压顶一般，让$n喘不过气来!",
      "lian": "$N手中的$w突然重若千斤，挥洒之间，无不沉滞已极。竟似泰山压顶一般!",
      "jibie": 25,
      "limb": "脸部",
      "sen": 3,
      "damage": 15,
      "damage_type": "划伤"
    ]),
    ([ "action": "$N刀意一转，复又变的轻柔万分，有如春风化雨，又如白雪轻舞，姿态妙曼至极!",
      "lian": "$N刀意一转，复又变的轻柔万分，有如春风化雨，又如白雪轻舞，姿态妙曼至极!",
      "jibie": 32,
      "limb": "右眼",
      "sen": 3,
      "damage": 20,
      "damage_type": "刺伤"
    ]),
    ([ "action": "$N双手紧握$w，双脚一弹，一飞冲天。人随刀势，刀随人形，向$n$l劈落!",
      "lian": "$N双手紧握$w，双脚一弹，一飞冲天。人随刀势，刀随人形!",
      "jibie": 38,
      "limb": "左眼",
      "sen": 3,
      "damage": 25,
      "damage_type": "刺伤"
    ]),
  });
}

string query_weapon_type() {
  return "dagger";
}
