#include <ansi.h>

inherit SKILL_SHORT;

mapping *get_all_action() {
  return ({
    ([ "action": HIR "「 瞬天杀! 」" + HIM "$N" HIM "使出超神速的缩地加天剑拔刀术，在$n" HIM "未感痛楚前想置其死地!" NOR,
      "lian": HIR "「 瞬天杀! 」" + HIM "$N" HIM "使出超神速的缩地加天剑拔刀术!" NOR,
      "zhaoshi": "「 瞬天杀! 」",
      "jibie": 10,
      "limb": "头顶",
      "sen": 3,
      "damage": 5,
      "damage_type": "瘀伤"
    ]),
    ([ "action": HIR "「火产灵神!」" + HIY "$N" HIY "把整把无限刃由刀身至刀尖燃烧，能力发挥至极限，完全焚毁对手!!" NOR,
      "lian": HIR "「火产灵神!」" + HIY "$N" HIY "把整把无限刃由刀身至刀尖燃烧，能力发挥至极限，完全焚毁对手!!" NOR,
      "zhaoshi": "「火产灵神!」",
      "jibie": 17,
      "limb": "小腹",
      "sen": 3,
      "damage": 10,
      "damage_type": "刺伤"
    ]),
    ([ "action": HIR "「红莲腕」！" + HIY "$N" HIY "在抓住对手时,，炎灵引爆手套内藏的火药" NOR,
      "lian": HIR "「红莲腕」！" + HIY "$N" HIY "在抓住对手时，炎灵引爆手套内藏的火药" NOR,
      "zhaoshi": "「红莲腕」！",
      "jibie": 25,
      "limb": "脸部",
      "sen": 3,
      "damage": 15,
      "damage_type": "划伤"
    ]),
    ([ "action": HIM "「秘剑.炎灵!」" + HIY "$N" HIY "以无限刃点火，向对手同时发出斩击和火烧！ " NOR,
      "lian": HIM "「秘剑.炎灵!」" + HIY "$N" HIY "以无限刃点火，向对手同时发出斩击和火烧！ " NOR,
      "zhaoshi": "「秘剑.炎灵!」",
      "jibie": 32,
      "limb": "右眼",
      "sen": 3,
      "damage": 20,
      "damage_type": "刺伤"
    ]),
    ([ "action": HIG "「影子鬼附身!」" + HIY "$N" HIY "将" WHT "心之蛊惑" HIY "作用于自己，使自己相信本身天下无敌，引发所有潜能，发挥最强威力" NOR,
      "lian": HIG "「影子鬼附身!」" + HIY "$N" HIY "将" WHT "心之蛊惑" HIY "作用于自己，使自己相信本身天下无敌，引发所有潜能，发挥最强威力" NOR,
      "zhaoshi": "「影子鬼附身!」",
      "jibie": 38,
      "limb": "左眼",
      "sen": 3,
      "damage": 25,
      "damage_type": "刺伤"
    ]),
    ([ "action": HIC "「背车刀!」" + HIY "$N" HIY "将右手的刀于背后交给左手，利用假动作，在预料不到的地方出刀 。 " NOR,
      "lian": HIC "「背车刀!」" + HIY "$N" HIY "将右手的刀于背后交给左手，利用假动作，在预料不到的地方出刀 。 " NOR,
      "zhaoshi": "「背车刀!」",
      "jibie": 45,
      "limb": "前胸",
      "sen": 3,
      "damage": 30,
      "damage_type": "划伤"
    ]),
    ([ "action": HIW "「二阶堂平法!」" + HIY "$N" HIY "由[一，八，十]这三字组成[平]字将剑气射出，麻痹心肺$n" HIY "，并让$n" HIY "无法动弹。 " NOR,
      "lian": HIW "「二阶堂平法!」" + HIY "$N" HIY "由[一，八，十]这三字组成[平]字将剑气射出。 " NOR,
      "zhaoshi": "「二阶堂平法!」",
      "jibie": 52,
      "limb": "头顶",
      "sen": 3,
      "damage": 35,
      "damage_type": "划伤"
    ]),
    ([ "action": HIC "「回天剑舞六连!」" + HIW "$N" HIW "反握短戟，运用流水招式刺出，左右再变两招，瞬间出六招。 " NOR,
      "lian": HIC "「回天剑舞六连!」" + HIW "$N" HIW "反握短戟，运用流水招式刺出，左右再变两招，瞬间出六招。 " NOR,
      "zhaoshi": "「回天剑舞六连!」",
      "jibie": 60,
      "limb": "脚面",
      "sen": 3,
      "damage": 40,
      "damage_type": "刺伤"
    ]),
    ([ "action": HIG "「阴阳双飞!」" + HIW "$N" HIW "幻化两把短戟，双刀纵横十字交叉做剪刀架势攻向$n" HIW " 。" NOR,
      "lian": HIG "「阴阳双飞!」" + HIW "$N" HIW "幻化两把短戟，双刀纵横十字交叉做剪刀架势。" NOR,
      "zhaoshi": "「阴阳双飞!」",
      "jibie": 66,
      "limb": "腰间",
      "sen": 3,
      "damage": 45,
      "damage_type": "划伤"
    ]),
  });
}

string query_weapon_type() {
  return "dagger";
}
