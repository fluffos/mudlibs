// shachang-dianbing.c 一阳指之沙场点兵
// writen by tea 10.20.98

#include <ansi.h>

int perform(object me, mixed target)
{
    object weapon;

    if ( !target )
        return notify_fail("你要攻击谁？\n");
    if ( !(target = present( target, environment( me ) ) ) )
        return notify_fail("没这个人啊？\n");

    if ( !objectp( target ) ||
         !target->is_character() ||
         !me->is_fighting(target) )
        return notify_fail("沙场点兵只能对战斗中的对手使用。\n");

    if ( me->query_temp("perform/attack") )
            return notify_fail("你正在施展绝技，不能施展新的绝技。\n");

    if ( !weapon=me->query_temp("weapon") || weapon->query("weapon_type")!="staff" ) 
        return notify_fail("你手中没有兵器，如何使用杖法？！\n");		
	
    if ( (int)me->query_jibie("yiyang-zhang") < 100 )
        return notify_fail("你的“一阳杖”不够娴熟，无法施展沙场点兵。\n");

    if ( me->query("force") < me->query("gin")/4+me->query("max_force")/10 || me->query("max_force") < 2000 )
        return notify_fail("你现在内力不足，无法施展沙场点兵。\n");

    if ( me->query("gin") < me->query("max_gin") )
	return notify_fail("你现在精神不足，无法施展沙场点兵。\n");

    me->set_temp("perform/attack",
        ([
            "name" : PERFORM_DIR "yiyang-zhi/shachang-dianbing",
            "call" : "action",
            "target"  : target,
        ]) );
    write("OK。\n");
    return 1;
}

int action(object me, object target)
{
    object *inv=all_inventory(environment(me));
    int i;
    mapping action = 
	([  "action"    :HIB"$N瞬时身形转动，绕着$n快步而行，$w快速连点。"NOR,
	    "sen"       :20,
	    "dodge"     :25,
	    "parry"     :25,
	    "damage"    :200,
	    "wound"	:100,
	    "force"	:(me->query("gin")/4+me->query("max_force")/10),
	    "limb"      :"胸口",
	    "damage_type" : "瘀伤"
	]);

    if( me->query("force") < me->query("gin")/4+me->query("max_force")/10 ){
	write("你感到内力不足，没能使出沙场点兵\n");
	return 0;
    }

    tell_object(me, "你使出一阳杖的绝技沙场点兵。\n\n");

    for(i=0;i<sizeof(inv);i++)
	if( userp(inv[i]) )
	    if ( inv[i] != me )
		tell_object( inv[i],
HIB"刹那间，仿佛从"+me->name()+"身后吹起万丈狂沙，四周弥漫起无限杀机，令你感到一阵窒息。"NOR);
	    else
		tell_object( me,
HIB"刹那间，你胸中热血沸腾，一股纯阳真气弥漫而出，衣衬汩汩，占据了整个空间。"NOR);

    me->set_temp("attack_skill", "yiyang-zhang");
    me->set_temp("perform/attack/action", action);
    me->set("gin",0);
    return 1;
}
