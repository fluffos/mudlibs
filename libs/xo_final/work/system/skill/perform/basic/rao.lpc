#include <ansi.h>

string name() {
  return "绕字诀";
}

int perform(object me, object target) {
  string msg;
  int time;
  int xiuwei_type;

  if ((int)me->query("force") < 1200) {
    return notify_fail(HIY "你现在真气不足。\n" HIY);
  }

  if (target->is_busy()) {
    return notify_fail(target->name() + "目前正自顾不暇，攻击吧骚年！\n");
  }

  xiuwei_type = KUNGFU_D->query_attack_xiuwei(me);
  if (me->query_xiuwei_dengji(xiuwei_type) < 3) {
    return notify_fail("你的修为略显不足！\n");
  }

  msg = YEL "$N提起真气，速度暴涨，一招快如鬼魅，如入无人之境！\n" NOR;

  if (me->query("combat_exp") > random((int)target->query("combat_exp"))) {
    msg += HIW "结果$n被$N的诡异身法吓得目瞪口呆！\n" NOR;

    time = me->query_xiuwei_dengji(xiuwei_type) + 1;
    if (time > 5) {
      time = 5;
    }

    target->start_busy(time);
    me->addn("force", -100);
  } else {
    msg += "$n只是勉强的逃了开去。\n";
    me->addn("force", -1200);
    me->start_busy(1);
  }

  message_combatd(msg, me, target);

  return 1;
}
