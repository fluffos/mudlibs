#include <ansi.h>
#include <combat.h>
#include <nt_adapter.h>

string name()
{
    return "连字诀";
}

int perform(object me, object target)
{
    string msg;
    int i;
    int time;
    string xiuwei_type;

    if ( query("force", me) < 1000 )
    {
        return notify_fail("你的真气不够，无法施展「" + name() + "」。\n");
    }

    xiuwei_type = KUNGFU_D->query_attack_xiuwei(me);

    time = me->query_xiuwei_dengji(xiuwei_type) + 1;

    msg = HIC "$N" HIC "一声长啸，灵台清明，凝神归元，使出江湖绝学「" + name() + "」。\n"
          HIY "招式陡然变得凌厉无比，一转念间已然攻出" + chinese_number(time) + "招！\n" NOR;

    message_combatd(msg, me, target);

    for ( i = 0; i < time; i++ )
    {
        if ( ! me->is_fighting(target) )
        {
            break;
        }

        COMBAT_D->fight_control(me, target, AT_PERFORM);
    }

    addn("force", -(time * 100), me);

    return 1;
}

