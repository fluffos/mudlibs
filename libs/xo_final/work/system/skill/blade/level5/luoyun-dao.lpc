inherit SKILL_BLADE;

mapping *get_all_action() {
  return ({
    ([ "action": "$N手中$w平平一刀，一式「万里乌云」，挥向$n$l",
      "lian": "$N手中$w平平一刀，一式「万里乌云」",
      "jibie": 10,
      "zhaoshi": "「万里乌云」",
      "sen": 5,
      "dodge": 30,
      "damage": 40,
      "damage_type": "刀伤" ]),
    ([ "action": "$N手中$w自空而下，一式「云深雾锁」，劈向$n$l",
      "lian": "$N手中$w自空而下，一式「云深雾锁」",
      "jibie": 19,
      "zhaoshi": "「云深雾锁」",
      "sen": 7,
      "dodge": 10,
      "parry": 20,
      "damage": 70,
      "damage_type": "割伤" ]),
    ([ "action": "刀光闪烁间，$N腾空而起，半空直下，一式「五雷轰顶」，手中$w已经到$n$l",
      "lian": "刀光闪烁间，$N腾空而起，半空直下，一式「五雷轰顶」",
      "jibie": 26,
      "zhaoshi": "「五雷轰顶」",
      "sen": 6,
      "dodge": 20,
      "damage": 30,
      "damage_type": "割伤" ]),
    ([ "action": "$N不慌不忙，一式「风声萧萧」，手中$w反转不定，猛地一刀砍向$n$l",
      "lian": "$N不慌不忙，一式「风声萧萧」，手中$w反转不定",
      "jibie": 33,
      "zhaoshi": "「风声萧萧」",
      "sen": 4,
      "dodge": 20,
      "damage": 60,
      "damage_type": "砍伤" ]),
    ([ "action": "$N双手握刀，一式「力劈群山」，手中$w自上而下，如长龙般而下，砍向$n$l",
      "lian": "$N双手握刀，一式「力劈群山」，手中$w自上而下，如长龙般而下",
      "jibie": 40,
      "sen": 5,
      "zhaoshi": "「力劈群山」",
      "damage": 50,
      "parry": 20,
      "damage": 40,
      "damage_type": "刀伤" ]),
  });
}
