inherit SKILL_BLADE;

mapping *get_all_action() {
  return ({
    ([ "action": "$N手持$w一刀劈下，迅即无比，势不可当",
      "lian": "$N手持$w一刀劈下，迅即无比，势不可当",
      "jibie": 10,
      "sen": 5,
      "dodge": 30,
      "damage": 40,
      "damage_type": "刀伤" ]),
    ([ "action": "$N刀锋自下而上划了个半弧，$w忽深忽吐，刺向$n的颈部",
      "lian": "$N刀锋自下而上划了个半弧，$w忽深忽吐",
      "jibie": 19,
      "sen": 7,
      "dodge": 10,
      "parry": 20,
      "damage": 70,
      "damage_type": "割伤" ]),
    ([ "action": "$N忽然将$w舞得天花乱坠，闪电般压向$n",
      "lian": "$N忽然将$w舞得天花乱坠",
      "jibie": 26,
      "sen": 6,
      "dodge": 20,
      "damage": 30,
      "damage_type": "割伤" ]),
    ([ "action": "$N一横$w，刀锋像门板一样向$n推去，封住$n所有的退路",
      "lian": "$N一横$w，刀锋像门板一样",
      "jibie": 33,
      "sen": 4,
      "dodge": 20,
      "damage": 60,
      "damage_type": "砍伤" ]),
    ([ "action": "$N转身跃起，手舞$w，身与刀进合做一道电光射向$n",
      "lian": "$N转身跃起，手舞$w，身与刀进合做一道电光",
      "jibie": 40,
      "sen": 5,
      "damage": 50,
      "parry": 20,
      "damage": 40,
      "damage_type": "刀伤" ]),
    ([ "action": "$N挥舞$w，乱砍乱杀，$w化作道道白光，上下翻飞罩向$n",
      "lian": "$N挥舞$w，乱砍乱杀，$w化作道道白光，上下翻飞",
      "jibie": 50,
      "sen": 5,
      "damage": 10,
      "damage": 40,
      "parry": 50,
      "damage_type": "割伤" ]),
    ([ "action": "$N将$w使得毫无章法，不守半点规矩，偏生快得出奇，$w挟风声劈向$n的$l",
      "lian": "$N将$w使得毫无章法，不守半点规矩，偏生快得出奇，$w挟风声劈下",
      "jibie": 60,
      "sen": 5,
      "dodge": 20,
      "parry": 20,
      "damage": 70,
      "damage_type": "砍伤" ]),
    ([ "action": "$N大喝一声，手中的$w就如长虹一般向$n直劈而下",
      "lian": "$N大喝一声，手中的$w就如长虹一般直劈而下",
      "jibie": 70,
      "sen": 7,
      "dodge": 40,
      "parry": 40,
      "damage": 85,
      "damage_type": "割伤" ]),

  });
}
