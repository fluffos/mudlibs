inherit SKILL_BLADE;

mapping *get_all_action() {
  return ({
    ([ "action": "$N手中$w斜指，一招「怒火燎原」，反身一顿，一刀向$n的$l撩去",
      "lian": "$N手中$w斜指，一招「怒火燎原」，反身一顿，一刀撩去",
      "jibie": 10,
      "zhaoshi": "「怒火燎原」",
      "sen": 5,
      "dodge": 30,
      "damage": 40,
      "damage_type": "刀伤" ]),
    ([ "action": "$N一招「赤焰冲天」，左右腿虚点，$w一提一收，平刃挥向$n的颈部",
      "lian": "$N一招「赤焰冲天」，左右腿虚点，$w一提一收",
      "jibie": 19,
      "zhaoshi": "「赤焰冲天」",
      "sen": 7,
      "dodge": 10,
      "parry": 20,
      "damage": 70,
      "damage_type": "割伤" ]),
    ([ "action": "$N展身虚步，提腰跃落，一招「洪炉翻腾」，刀锋一卷，拦腰斩向$n",
      "lian": "$N展身虚步，提腰跃落，一招「洪炉翻腾」，刀锋一卷",
      "jibie": 26,
      "zhaoshi": "「洪炉翻腾」",
      "sen": 6,
      "dodge": 20,
      "damage": 30,
      "damage_type": "割伤" ]),
    ([ "action": "$N一招「流星飞坠」，$w大开大阖，自上而下划出一个大弧，笔直劈向$n",
      "lian": "$N一招「流星飞坠」，$w大开大阖，自上而下划出一个大弧",
      "jibie": 33,
      "zhaoshi": "「流星飞坠」",
      "sen": 4,
      "dodge": 20,
      "damage": 60,
      "damage_type": "砍伤" ]),
    ([ "action": "$N手中$w一沉，一招「火雨漫天」，双手持刃拦腰反切，砍向$n的胸口",
      "lian": "$N手中$w一沉，一招「火雨漫天」，双手持刃拦腰反切",
      "jibie": 40,
      "sen": 5,
      "zhaoshi": "「火雨漫天」",
      "damage": 50,
      "parry": 20,
      "damage": 40,
      "damage_type": "刀伤" ]),
    ([ "action": "$N挥舞$w，使出一招「赤莲幻升」，上劈下撩，左挡右开，齐齐罩向$n",
      "lian": "$N挥舞$w，使出一招「赤莲幻升」，上劈下撩，左挡右开",
      "jibie": 50,
      "zhaoshi": "「赤莲幻升」",
      "sen": 5,
      "damage": 10,
      "damage": 40,
      "parry": 50,
      "damage_type": "割伤" ]),
    ([ "action": "$N一招「红莲烈火」，左脚跃步落地，$w顺势往前，挟风声劈向$n的$l",
      "lian": "$N一招「红莲烈火」，左脚跃步落地，$w顺势往前，挟风声劈下",
      "jibie": 60,
      "zhaoshi": "「红莲烈火」",
      "sen": 5,
      "dodge": 20,
      "parry": 20,
      "damage": 70,
      "damage_type": "砍伤" ]),
    ([ "action": "$N盘身驻地，一招「火内莲花」，挥出一片流光般的刀影，向$n的全身涌去",
      "lian": "$N盘身驻地，一招「火内莲花」，挥出一片流光般的刀影",
      "jibie": 70,
      "zhaoshi": "「火内莲花」",
      "sen": 7,
      "dodge": 40,
      "parry": 40,
      "damage": 85,
      "damage_type": "割伤" ]),

  });
}
