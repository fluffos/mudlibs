inherit SKILL_BLADE;

mapping *get_all_action() {
  return ({
    ([ "action": "$N一招「古宅春风」，手中$w挟着风势砍向$n$l!",
      "lian": "$N把手中$w舞的密不透风，正是一招「古宅春风」。",
      "jibie": 10,
      "zhaoshi": "「古宅春风」",
      "sen": 5,
      "dodge": 30,
      "damage": 40,
      "damage_type": "刀伤" ]),
    ([ "action": "未待招式使老，$N又一招「桃花拂面」，手中$w向$n面门掠了上去",
      "lian": "$N一招「桃花拂面」，手中$w反撩上来。。。。。。",
      "jibie": 19,
      "zhaoshi": "「桃花拂面」",
      "sen": 7,
      "dodge": 10,
      "parry": 20,
      "damage": 70,
      "damage_type": "割伤" ]),
    ([ "action": "只见$N一招「鸳鸯戏水」，手中$w挽出一片刀花，晃得$n眼花缭乱",
      "lian": "$N反手一招「鸳鸯戏水」，手中$w挽出一片刀花，晃得人眼花缭乱。",
      "jibie": 26,
      "zhaoshi": "「鸳鸯戏水」",
      "sen": 6,
      "dodge": 20,
      "damage": 30,
      "damage_type": "割伤" ]),
    ([ "action": "又见$N高高跃起，一式「柳丝随风」，刀刃飘忽不定，切向$n的$l",
      "lian": "$N身形乍展，高高跃起，一式「柳丝随风」，刀刃飘忽不定。",
      "jibie": 33,
      "zhaoshi": "「柳丝随风」",
      "sen": 4,
      "dodge": 20,
      "damage": 60,
      "damage_type": "砍伤" ]),
    ([ "action": "$N身子一侧，一招「梅花照雪」，刀锋忽转向右，在空中转了半个圈，又切向$n$l..",
      "lian": "$N身子一侧，一招「梅花照雪」，刀锋忽转向右，在空中转了半个圈..",
      "jibie": 40,
      "sen": 5,
      "zhaoshi": "「梅花照雪」",
      "damage": 50,
      "parry": 20,
      "damage": 40,
      "damage_type": "刀伤" ]),
    ([ "action": "$N将$w换至左手，突然倒身移步，向左卖了个破绽。。。",
      "lian": "$N将刀换至左手，突然倒身移步，刀峰一晃......",
      "jibie": 50,
      "zhaoshi": "「鸳鸯展翅」",
      "sen": 5,
      "damage": 10,
      "damage": 40,
      "parry": 50,
      "damage_type": "割伤" ]),
    ([ "action": "$N纵刀过肩，一招二式，刀锋忽然飘忽不定，变出一式「镜中鸳鸯」..",
      "lian": "$N纵刀过肩，一招二式，刀锋忽然飘忽不定，变出一式「镜中鸳鸯」..",
      "jibie": 60,
      "zhaoshi": "「镜中鸳鸯」",
      "sen": 5,
      "dodge": 20,
      "parry": 20,
      "damage": 70,
      "damage_type": "砍伤" ]),
    ([ "action": "$N一招「投石寻偶」，连人带刀，一股劲风直扑$n!!!!!",
      "lian": "$N刀峰急抖，练到得意出，突然使出一招「投石寻偶」...",
      "jibie": 70,
      "zhaoshi": "「投石寻偶」",
      "sen": 7,
      "dodge": 40,
      "parry": 40,
      "damage": 85,
      "damage_type": "割伤" ]),

  });
}
