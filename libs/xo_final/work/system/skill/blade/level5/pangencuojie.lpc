inherit SKILL_BLADE;

mapping *get_all_action() {
  return ({
    ([ "action":
      "$N着地向$n卷去，双刀劈向$n下盘",
      "lian":
      "$N着地向前卷去，双刀劈出",
      "jibie": 15,
      "limb": "下身",
      "sen": 5,
      "dodge": 5,
      "parry": 30,
      "damage": 70,
      "wound": 30,
      "damage_type": "劈伤" ]),
    ([ "action":
      "$N就地一滚，左右$w同时向$n下三路攻到",
      "lian":
      "$N就地一滚，左右$w同时向假象之敌下三路攻到",
      "jibie": 30,
      "limb": "左腿",
      "sen": 6,
      "dodge": 0,
      "parry": 40,
      "wound": 35,
      "damage": 75,
      "damage_type": "劈伤" ]),
    ([ "action":
      "$N左$w护住自己的要害，欺身而上，右$w猛磕$n踝部",
      "lian":
      "$N左$w护住自己的要害，欺身而上，右$w猛磕下去",
      "jibie": 45,
      "limb": "踝部",
      "sen": 8,
      "dodge": 10,
      "parry": 50,
      "damage": 80,
      "wound": 45,
      "damage_type": "淤伤" ]),
    ([ "action":
      "$N见$n来势汹汹，$w如门板般一封，同时伸足飞踢$n裆部",
      "lian":
      "$N$w如门板般一封，同时伸足飞踢",
      "jibie": 60,
      "limb": "裆部",
      "sen": 7,
      "dodge": 20,
      "parry": 30,
      "damage": 90,
      "wound": 50,
      "damage_type": "淤伤" ]),
    ([ "action":
      "$N一个前滚翻，避开$n的攻势，突然站起，$w拦腰横劈$n",
      "lian":
      "$N一个前滚翻，$w拦腰横劈",
      "jibie": 75,
      "limb": "腰部",
      "sen": 10,
      "damage": 100,
      "dodge": 0,
      "parry": 50,
      "wound": 60,
      "damage_type": "劈伤" ]),
    ([ "action":
      "$N怒吼连连，猛地$w脱手飞出，向$n袭至，随后$N紧跟便到，又将$w接回手中",
      "lian":
      "$N猛地$w脱手飞出，在空中划了两条弧线，随后$N紧跟便到，又将$w接回手中",
      "jibie": 90,
      "sen": 13,
      "dodge": 0,
      "parry": 50,
      "damage": 110,
      "wound": 65,
      "damage_type": "割伤" ]),
  });
}

int valid_learn(object me) {
  if (me->query("age") < 16) {
    return notify_fail("你的年纪太小，无法修练这门刚猛的武功。\n");
  }

  return ::valid_learn(me);
}
