inherit SKILL_BLADE;

mapping *get_all_action() {
  return ({
    ([ "action":
      "$N藏刀内收，一招「百废俱新」，刀锋自下而上划了个半弧，向$n的$l挥去",
      "lian":
      "$N藏刀内收，一招「百废俱新」，刀锋自下而上划了个半弧，向外挥去",
      "zhaoshi": "「百废俱新」",
      "dodge": 50,
      "sen": 4,
      "jibie": 0,
      "parry": 80,
      //                "force":                 70,
      "damage": 70,
      "wound": 10,
      "damage_type": "割伤",
    ]),
    ([ "action":
      "$N左掌虚托右肘，一招「草木皆兵」，手中$w笔直划向$n的$l",
      "lian":
      "$N左掌虚托右肘，一招「草木皆兵」，手中$w笔直划出",
      "zhaoshi": "「草木皆兵」",
      "dodge": 55,
      "parry": 58,
      //                "force":                 70,
      "sen": 3,
      "jibie": 18,
      "damage": 65,
      "damage_type": "割伤",
    ]),
    ([ "action":
      "$N一招「炮凤烹龙」，$w绕颈而过，刷地一声自上而下向$n猛劈",
      "lian":
      "$N一招「炮凤烹龙」，$w绕颈而过，刷地一声自上而下劈出",
      "zhaoshi": "「炮凤烹龙」",
      "dodge": 63,
      "sen": 3,
      "parry": 62,
      "jibie": 35,
      //                "force":                 90,
      "damage": 75,
      "wound": 15,
      "damage_type": "割伤",
    ]),
    ([ "action":
      "$N右手反执刀柄，一招「抱诚守真」，猛一挫身，$w直向$n的颈中斩去",
      "lian":
      "$N右手反执刀柄，一招「抱诚守真」，猛一挫身，$w笔直推出",
      "zhaoshi": "「抱诚守真」",
      "sen": 3,
      "jibie": 55,
      "dodge": 65,
      "parry": 70,
      //                "force":                 80,
      "damage": 70,
      "damage_type": "割伤",
    ]),
    ([ "action":
      "$N一招「堆金积玉」，无数刀尖化作点点繁星，向$n的$l挑去",
      "lian":
      "$N一招「堆金积玉」，无数刀尖化作点点繁星，向外挑出",
      "zhaoshi": "「堆金积玉」",
      "dodge": 60,
      "sen": 3,
      "jibie": 72,
      "parry": 80,
      //                "force":                 100,
      "damage": 76,
      "damage_type": "割伤",
    ]),
    ([ "action":
      "$N双手合执$w，一招「无中生有」，拧身急转，刀尖直刺向$n的双眼",
      "lian":
      "$N双手合执$w，一招「无中生有」，拧身急转，刀尖直刺出去",
      "zhaoshi": "「无中生有」",
      "dodge": 70,
      "parry": 90,
      //                "force":                100,
      "sen": 5,
      "jibie": 90,
      "damage": 130,
      "wound": 50,
      "damage_type": "割伤",
    ]),
  });
}

int valid_learn(object me) {
  if (me->query_jibie("buddhism") < 100) {
    return notify_fail("你的佛学修为不够，强练绝技会伤及身体。\n");
  }

  return ::valid_learn(me);
}
