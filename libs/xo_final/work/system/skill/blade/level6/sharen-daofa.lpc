inherit SKILL_BLADE;

mapping *get_all_action() {
  return ({
    ([ "action": "$N大喝一声，奋力向$n劈下",
      "lian": "$N大喝一声，双手握刀，全力劈下",
      "sen": 10,
      "jibie": 100,
      "damage": 110,
      "wound": 55,
      "damage_type": "劈伤"
    ]),
    ([ "action": "$N蓦的发力迅速斜削向$n的$l",
      "lian": "$N双手持刀，发力迅速向下斜削下去",
      "sen": 10,
      "jibie": 175,
      "damage": 140,
      "wound": 65,
      "damage_type": "劈伤"
    ]),
    ([ "action": "$N挥刀从一个诡异的角度砍向$n",
      "lian": "$N刀交左手，反手从一个诡异的角度砍出",
      "sen": 10,
      "jibie": 250,
      "damage": 230,
      "wound": 85,
      "damage_type": "劈伤"
    ]),

  });
}

int valid_learn(object me) {
  if (me->query("bellicosity") < 5000) {
    return notify_fail("你杀气不够，领悟不了杀人刀法。\n");
  }

  if (me->query_xiuwei("blade") < 5300) {
    return notify_fail("你的修为，领悟不了杀人刀法。\n");
  }

  return ::valid_learn(me);
}
