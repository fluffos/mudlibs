inherit SKILL_BLADE;

mapping *get_all_action()
{
    return ({
    ([	"action":"$N一招「目送归鸿」，目光落处正是手中$w挥向$n$l!",
        "lian"  :"$N一抖手中$w，凌空劈落，正是一招「目送归鸿」",
        "jibie" : 5,
        "zhaoshi":"「目送归鸿」",
        "sen"   : 5,
        "dodge" : 10,     
        "parry" : 10,
        "wound" : 35,
        "damage_type":"割伤"   ]),
    ([  "action":"$N身形微探，正是一招「俯仰自得」，刀风由下及上，击向$n$l...",
        "lian"  :"$N身行一晃，一招「俯仰自得」，发出「呼呼」的声响...",
        "jibie" : 20,
        "zhaoshi":"「俯仰自得」",
        "sen"   : 5,
        "dodge" : 10,
        "parry" : 10,
        "wound" : 45,
        "damage_type":"割伤"    ]),
    ([  "action":"又见$N刀光乱舞，一招「手挥五弦」将$n全身照住！",
        "lian"  :"又见$N刀光一片，一招「手挥五弦」已然舞开......",
        "jibie" : 30,
        "zhaoshi":"「手挥五弦」",
        "sen"   : 6,
        "dodge" : 0,
        "parry" : 30,
        "wound" : 40,
        "damage_type":"割伤"    ]),
    ([  "action":"但见$N使出一招「游心太玄」，刀光挟着风势，「呼」地冲向$n的当胸....",
        "lian"  :"但见$N使出一招「游心太弦」，刀光挟着风势，「呼」地冲向前方....",
        "jibie" : 40,
        "limb":"前胸",
        "zhaoshi":"「游心太弦」",
        "sen"   : 6,
        "dodge" : 20,
        "parry" : 20,
        "wound" : 50,
        "damage_type":"砍伤"    ]),
    ([  "action":"$N身子一侧，一招「广大慈悲」，刀峰虚点，却反手砍向$n前胸",
        "lian"  :"$N身子一侧，一招「广大慈悲」，身形跃左，刀峰削右，直劈前方",
        "jibie" : 50,
        "sen"   : 6,
        "limb":"前胸",
        "zhaoshi":"「广大慈悲」",
        "wound" : 55, 
        "dodge" : 30,
        "parry" : 10,
        "damage_type":"割伤"   ]),
    ([  "action":"$N一招「佛法无边」，左掌合十，刀峰已动，展向$n面门！！",
        "lian"  :"$N一招「佛法无边」，左掌合十，刀峰晃动，耀人眼目！",
        "jibie" : 60,
        "zhaoshi":"「佛法无边」",
        "sen"   : 5,
        "dodge" : 10,
        "parry" : 30,
        "wound" : 60,
        "damage_type":"割伤"   ]),

});
}

int valid_learn(object me)
{
    if ( me->query_jibie("buddhism") < 60 )
    {
        return notify_fail("你的佛学修为不够，强练绝技会伤及身体。\n");

    }
    return ::valid_learn(me);
}

