inherit SKILL_BLADE;

mapping *get_all_action()
{
    return ({
    ([	"action":"$N内息转动，运劲于单刀，全身骨节一阵暴响，起手一式「示诞生」向$n劈出，将$n全身笼罩在赤热的刀风下",
        "lian"  :"$N内息转动，运劲于单刀，全身骨节一阵暴响，起手一式「示诞生」",
        "jibie" :10,
        "zhaoshi":"「示诞生」",
        "sen"   :5,
        "dodge" :0,     
        "parry" :0,
        "damage":70,
        "wound" :30,
        "damage_type":"砍伤"   ]),
    ([  "action":
"$N面带轻笑，一招「始心镜」，火焰刀内劲由内及外慢慢涌出，$N双掌如宝像合十于胸前，向着$n深深一鞠",
        "lian"  :
"$N面带轻笑，一招「始心镜」，火焰刀内劲由内及外慢慢涌出，$N双掌如宝像合十于胸前，深深一鞠",
        "jibie" :25,
        "zhaoshi":"「始心镜」",
        "sen"   :5,
        "dodge" :0,
        "parry" :0,
        "damage":75,
        "wound" :35,
        "damage_type":"劈伤"    ]),
    ([  "action":
"$N刀掌相合又打开，这招「现宝莲」以火焰刀无上功力聚出一朵红莲，盛开的花瓣飞舞旋转，漫布在$n四周",
        "lian"  :
"$N刀掌相合又打开，这招「现宝莲」以火焰刀无上功力聚出一朵红莲，盛开的花瓣飞舞旋转，漫布在四周",
        "jibie"  :40,
        "limb"   :"左腿",
        "zhaoshi":"「现宝莲」",
        "sen"    :7,
        "dodge"  :0,
        "parry"  :10,
        "damage" :80,
        "wound"  :40,
        "damage_type":"割伤"    ]),
    ([  "action":
"$N面带金刚相，刀气搓圆，使无数炙热的刀气相聚，这招「破法执」犹如一只巨大的飞鹰，凌空向$n飞抓而下",
        "lian"  :
"$N面带金刚相，刀气搓圆，使无数炙热的刀气相聚，这招「破法执」犹如一只巨大的飞鹰，凌空飞抓而下",
        "jibie"  :55,
        "zhaoshi":"「破法执」",
        "sen"    :5,
        "dodge"  :10,
        "parry"  :5,
        "damage" :85,
        "wound"  :45,
        "damage_type":"砍伤"    ]),
    ([  "action":
"$N暴喝一声，竟然使出伏魔无上的「开显圆」，气浪如飓风般围着$N飞旋，炎流将$n一步步向着$N拉扯过来",
        "lian"  :
"$N暴喝一声，竟然使出伏魔无上的「开显圆」，气浪如飓风般围着$N飞旋",
        "jibie"  :70,
        "sen"    :6,
        "limb"   :"前胸",
        "zhaoshi":"「开显圆」",
        "damage" :90,
        "wound"  :50, 
        "parry"  :22,
        "damage_type":"刀伤"   ]),
    ([  "action":
"$N口念伏魔真经，钢刀连连劈出，将$n笼罩在炙焰之下，这如刀切斧凿般的「显真常」气浪似乎要将$n从中劈开",
        "lian"  :
"$N口念伏魔真经，钢刀连连劈出，这如刀切斧凿般的「显真常」气浪从中劈开",
        "jibie"  :85,
        "limb"   :"胸口",
        "zhaoshi":"「显真常」",
        "sen"    :6,
        "dodge"  :20,
        "damage" :100,
        "wound"  :55,
        "damage_type":"刺伤"   ]),
    ([  "action":
"$N现宝相，结迦兰，右手「归真法」单刀挥出，半空中刀气凝结不散，但发出炙灼的气浪却排山倒海般地涌向$n",
        "lian"  :
"$N现宝相，结迦兰，右手「归真法」单刀挥出，半空中刀气凝结不散，但发出炙灼的气浪却排山倒海般",
        "jibie" :100,
        "limb":"前胸",
        "zhaoshi":"「归真法」",
        "sen"    :7,
        "dodge"  :-10,
        "parry"  :40,
        "damage" :110,
        "wound"  :60,
        "damage_type":"刀伤"   ]),
    ([  "action":
"$N虚托刀柄，一式「吉祥逝」，内力运转，跟着全身衣物无风自动，$N身体微倾，闪电一刀，斩向$n$",
        "lian"  :
"$N虚托刀柄，一式「吉祥逝」，内力运转，跟着全身衣物无风自动，$N身体微倾，闪电一刀",
        "jibie" :120,
        "limb":"前胸",
        "zhaoshi":"「吉祥逝」",
        "sen"    :7,
        "dodge"  :-10,
        "parry"  :40,
        "damage" :110,
        "wound"  :60,
        "damage_type":"刀伤"   ]),
});
}

