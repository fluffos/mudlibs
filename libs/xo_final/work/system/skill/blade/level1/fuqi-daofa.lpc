inherit SKILL_BLADE;

mapping *get_all_action() {
  return ({
    ([ "action": "$N轻轻一笑，手中$w斜指，一招「女貌郎才珠万斛」，反身撩向$n的$l",
      "lian": "$N轻轻一笑，手中$w斜指，一招「女貌郎才珠万斛」",
      "jibie": 5,
      "sen": 1,
      "zhaoshi": "「女貌郎才珠万斛」",
      "damage_type": "砍伤" ]),
    ([ "action": "$N面带微笑，一招「天教丽质为眷属」，$w一提一收，平刃挥向$n的颈部",
      "lian": "$N面带微笑，一招「天教丽质为眷属」，$w一提一收",
      "jibie": 10,
      "sen": 1,
      "zhaoshi": "「天教丽质为眷属」",
      "damage_type": "砍伤" ]),
    ([ "action": "$N展颜微笑，$w刀锋左右开阖，一招「碧箫声里双鸣凤」，拦腰斩向$n",
      "lian": "$N展颜微笑，$w刀锋左右开阖，一招「碧箫声里双鸣凤」",
      "jibie": 20,
      "sen": 1,
      "zhaoshi": "「碧箫声里双鸣凤」",
      "damage_type": "割伤" ]),
    ([ "action": "$N使一招「清风引佩下瑶台」，$w自上而下划出一个大弧，笔直劈向$n",
      "lian": "$N使一招「清风引佩下瑶台」，$w自上而下划出一个大弧",
      "jibie": 30,
      "sen": 1,
      "zhaoshi": "「清风引佩下瑶台」",
      "damage_type": "砍伤" ]),
    ([ "action": "$N手中$w一沉，一招「刀光掩映孔雀屏」，双手持刃反切，砍向$n胸口",
      "lian": "$N手中$w一沉，一招「刀光掩映孔雀屏」，双手持刃反切",
      "jibie": 38,
      "sen": 1,
      "zhaoshi": "「刀光掩映孔雀屏」",
      "damage_type": "割伤" ]),
    ([ "action": "$N一招「明月照妆成金屋」，手中$w上劈下撩，左挡右开，齐齐罩向$n",
      "lian": "$N一招「明月照妆成金屋」，手中$w上劈下撩，左挡右开",
      "jibie": 50,
      "limb": "腿上",
      "sen": 1,
      "zhaoshi": "「明月照妆成金屋」",
      "damage_type": "割伤" ]),
    ([ "action": "$N跃步落地，$w顺势送出，一招「喜结丝罗在乔木」，斜斜劈向$n的$l",
      "lian": "$N跃步落地，$w顺势送出，一招「喜结丝罗在乔木」",
      "jibie": 60,
      "sen": 1,
      "zhaoshi": "「喜结丝罗在乔木」",
      "damage_type": "砍伤" ]),
    ([ "action": "$N轻笑声中，「千金一刻庆良宵」使出，一片流光般的刀影涌向$n全身",
      "lian": "$N轻笑声中，「千金一刻庆良宵」使出，一片流光般的刀影涌出",
      "jibie": 70,
      "sen": 1,
      "zhaoshi": "「千金一刻庆良宵」",
      "damage_type": "砍伤" ]),
  });
}
