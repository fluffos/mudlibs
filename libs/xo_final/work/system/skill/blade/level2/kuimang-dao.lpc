inherit SKILL_BLADE;

mapping *get_all_action() {
  return ({
    ([ "action": "$N手中$w斜指，一招「蝰蛇翻身」，反身一顿，一刀向$n的$l撩去",
      "lian": "$N手中$w斜指，一招「蝰蛇翻身」，反身一顿，一刀撩去",
      "jibie": 10,
      "zhaoshi": "「蝰蛇翻身」",
      "limb": "左腿",
      "sen": 3,
      "dodge": 20,
      "damage": 20,
      "damage_type": "刀伤" ]),
    ([ "action": "$N一招「巨蟒缠身」，左右腿虚点，$w一提一收，平刃挥向$n的颈部",
      "lian": "$N一招「巨蟒缠身」，左右腿虚点，$w一提一收",
      "jibie": 20,
      "zhaoshi": "「巨蟒缠身」",
      "sen": 3,
      "dodge": 10,
      "parry": 20,
      "damage": 30,
      "damage_type": "割伤" ]),
    ([ "action": "$N展身虚步，提腰跃落，一招「蛇蜕于野」，刀锋一卷，拦腰斩向$n",
      "lian": "$N展身虚步，提腰跃落，一招「蛇蜕于野」，刀锋一卷",
      "jibie": 30,
      "zhaoshi": "「蛇蜕于野」",
      "sen": 4,
      "limb": "后腰",
      "dodge": 20,
      "parry": 15,
      "damage": 35,
      "damage_type": "割伤" ]),
    ([ "action": "$N一招「曲蛇吐信」，$w大开大阖，自上而下划出一个大弧，笔直劈向$n",
      "lian": "$N一招「曲蛇吐信」，$w大开大阖，自上而下划出一个大弧",
      "jibie": 50,
      "zhaoshi": "「曲蛇吐信」",
      "sen": 2,
      "limb": "小腿",
      "dodge": 20,
      "parry": 10,
      "damage": 60,
      "damage_type": "砍伤" ]),
    ([ "action": "$N手中$w一沉，一招「蛇鹤相争」，双手持刃拦腰反切，砍向$n的胸口",
      "lian": "$N手中$w一沉，一招「蛇鹤相争」，双手持刃拦腰反切",
      "jibie": 50,
      "zhaoshi": "「蛇鹤相争」",
      "sen": 4,
      "limb": "后腰",
      "dodge": 20,
      "parry": 15,
      "damage": 70,
      "damage_type": "割伤" ]),
    ([ "action": "$N挥舞$w，使出一招「蝰蟒暴伸」，上劈下撩，左挡右开，齐齐罩向$n",
      "lian": "$N挥舞$w，使出一招「蝰蟒暴伸」，上劈下撩，左挡右开",
      "jibie": 60,
      "zhaoshi": "「蝰蟒暴伸」",
      "sen": 2,
      "limb": "小腿",
      "dodge": 20,
      "parry": 10,
      "damage": 80,
      "damage_type": "砍伤" ]),
  });
}
