int valid_learn(object me) {
  if (me->query_jibie("buddhism") < 30) {
    return notify_fail("你的佛学修为不够，强练绝技会伤及身体。\n");
  }

  if ((int)me->query("max_force") < 100) {
    return notify_fail("你的内力不够,无法练少林单刀！\n");
  }

  return ::valid_learn(me);
}
