#include <ansi.h>

inherit SKILL_BLADE;

mapping *get_all_action() {
  return ({
    ([ "action": "$N凌空跃起，双手握起$w，高举过头，一招" HIM "「劈天盖地满壮志」" NOR "，势
如奔雷坠地，卷起漫天风尘，一刀向$n的$l劈了下来",
      "lian": "$N凌空跃起，双手握起$w，高举过头，一招" HIM "「劈天盖地满壮志」" NOR "，势
如奔雷坠地，卷起漫天风尘，一刀劈了下来",
      "jibie": 10,
      "zhaoshi": HIM "「劈天盖地满壮志」" NOR,
      "limb": "左腿",
      "sen": 3,
      "dodge": 20,
      "damage": 20,
      "damage_type": "刀伤" ]),
    ([ "action": "$N左腿斜跨一步，右手握着$w，横架前胸，猛地侧身旋转，以腰带
臂，以臂扛刀，一招" HIR "「弯刀逆转倒乾坤」" NOR "，平刃挥向$n的$l",
      "lian": "$N左腿斜跨一步，右手握着$w，横架前胸，猛地侧身旋转，以腰带
臂，以臂扛刀，一招" HIR "「弯刀逆转倒乾坤」" NOR,
      "jibie": 20,
      "zhaoshi": HIR "「弯刀逆转倒乾坤」" NOR,
      "sen": 3,
      "dodge": 10,
      "parry": 20,
      "damage": 30,
      "damage_type": "割伤" ]),
    ([ "action": "$N手握$w，展开身形，使动" HIW "「遥看万疆千里雪」" NOR "，突然之间，四周中
白光闪动，丈余圈子之内，全是刀影",
      "lian": "$N手握$w，展开身形，使动" HIW "「遥看万疆千里雪」" NOR "，突然之间，四周中
白光闪动，丈余圈子之内，全是刀影",
      "jibie": 30,
      "zhaoshi": HIW "「遥看万疆千里雪」" NOR,
      "sen": 4,
      "limb": "后腰",
      "dodge": 20,
      "parry": 15,
      "damage": 35,
      "damage_type": "割伤" ]),
    ([ "action": "$N一招" HIG "「壮志豪气满江湖」" NOR "，$w声势大变，东砍一刀少林寺的降魔刀
法，西劈一刀广西黎山洞黎老汉的柴刀十八路，回转又是一刀江南史家的
回风拂柳刀，刀刀不离$n左右",
      "lian": "$N一招" HIG "「壮志豪气满江湖」" NOR "，$w声势大变，东砍一刀少林寺的降魔刀
法，西劈一刀广西黎山洞黎老汉的柴刀十八路，回转又是一刀江南史家的
回风拂柳刀",
      "jibie": 40,
      "zhaoshi": HIG "「壮志豪气满江湖」" NOR,
      "sen": 2,
      "limb": "小腿",
      "dodge": 20,
      "parry": 10,
      "damage": 60,
      "damage_type": "砍伤" ]),
  });
}
