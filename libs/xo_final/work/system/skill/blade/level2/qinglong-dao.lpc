inherit SKILL_BLADE;

mapping *get_all_action() {
  return ({
    ([ "action": "$N身行晃动，猛地一招[龙战四方]砍向$n的$l",
      "lian": "$N身行晃动，猛地一招[龙战四方]",
      "jibie": 10,
      "zhaoshi": "「龙战四方」",
      "limb": "左腿",
      "sen": 3,
      "dodge": 20,
      "damage": 20,
      "damage_type": "刀伤" ]),
    ([ "action": "$N身行猛地向前一冲，脚下虚晃一扫，举刀一招[龙腾四海]向$n的$l砍去",
      "lian": "$N身行猛地向前一冲，脚下虚晃一扫，举刀一招[龙腾四海]",
      "jibie": 20,
      "zhaoshi": "「龙腾四海」",
      "sen": 3,
      "dodge": 10,
      "parry": 20,
      "damage": 30,
      "damage_type": "割伤" ]),
    ([ "action": "$N腾空越起，挥刀凌空砍下，正是一招[索命一刀]",
      "lian": "$N腾空越起，挥刀凌空砍下，正是一招[索命一刀]",
      "jibie": 30,
      "zhaoshi": "「索命一刀」",
      "sen": 4,
      "limb": "后腰",
      "dodge": 20,
      "parry": 15,
      "damage": 35,
      "damage_type": "割伤" ]),
    ([ "action": "$N大喝一声，一招[龙飞九天]连环朝$n的$l砍去",
      "lian": "$N大喝一声，一招[龙飞九天]",
      "jibie": 40,
      "zhaoshi": "[龙飞九天]",
      "sen": 2,
      "limb": "小腿",
      "dodge": 20,
      "parry": 10,
      "damage": 50,
      "damage_type": "砍伤" ]),
  });
}
