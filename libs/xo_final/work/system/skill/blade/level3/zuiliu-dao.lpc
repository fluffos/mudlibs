inherit SKILL_BLADE;

mapping *get_all_action() {
  return ({
    ([ "action": "$N一招「欲反不尽」，握紧$w，左脚斜斜踏上一步，举刀横砍",
      "lian": "$N一招「欲反不尽」，握紧$w，左脚斜斜踏上一步，举刀横砍",
      "jibie": 8,
      "zhaoshi": "「欲反不尽」",
      "sen": 3,
      "dodge": 0,
      "damage": 40,
      "wound": 20,
      "damage_type": "刀伤" ]),
    ([ "action": "未待招式使老，$N又一招「相期与来」，脚下一个趔趄，刀锋从一个怪异的角度\n"
      "砍了下来",
      "lian": "未待招式使老，$N又一招「相期与来」，脚下一个趔趄，刀锋从一个怪异的角度\n"
      "砍了下来",
      "jibie": 16,
      "zhaoshi": "「相期与来」",
      "sen": 4,
      "dodge": 10,
      "parry": 10,
      "damage": 45,
      "wound": 20,
      "damage_type": "割伤" ]),
    ([ "action": "只见$N一招「明漪绝底」，两眼望天，身子一歪，$w一晃，在半空转了个方向\n"
      "带着一阵风声砍了下来",
      "lian": "只见$N一招「明漪绝底」，两眼望天，身子一歪，$w一晃，在半空转了个方向\n"
      "带着一阵风声砍了下来",
      "jibie": 24,
      "zhaoshi": "「明漪绝底」",
      "sen": 3,
      "dodge": 0,
      "damage": 50,
      "wound": 30,
      "damage_type": "割伤" ]),
    ([ "action": "又见$N高高跃起，一式「奇花初胎」，双手握刀，纵刀过肩，大喝一声\n"
      "刀锋越过头顶，直向$n砍了下去",
      "lian": "又见$N高高跃起，一式「奇花初胎」，双手握刀，纵刀过肩，大喝一声\n"
      "刀锋越过头顶，直砍了下去",
      "jibie": 32,
      "zhaoshi": "奇花初胎",
      "sen": 4,
      "dodge": 20,
      "damage": 60,
      "wound": 30,
      "damage_type": "砍伤" ]),
    ([ "action": "$N身子一侧，一招「妙造自然」，摇摇晃晃地，身法一顿，刀顺着收势\n"
      "反向击出，斜掠向$n$l",
      "lian": "$N身子一侧，一招「妙造自然」，摇摇晃晃地，身法一顿，刀顺着收势\n"
      "反向击出",
      "jibie": 40,
      "sen": 3,
      "zhaoshi": "「妙造自然」",
      "wound": 50,
      "parry": 10,
      "damage": 65,
      "wound": 35,
      "damage_type": "刀伤" ]),
    ([ "action": "$N将$w向后一甩，身子跟着转了半个圈子，刀从另一个方向横扫向$n",
      "lian": "$N将$w向后一甩，身子跟着转了半个圈子，刀从另一个方向横扫而出",
      "jibie": 48,
      "zhaoshi": "「碧山人来」",
      "sen": 3,
      "damage": 70,
      "wound": 40,
      "damage_type": "割伤" ]),
    ([ "action": "$N纵刀过肩，一招「伊谁与裁」，探身向前，转身至$n身侧，一刀砍向$n$l",
      "lian": "$N纵刀过肩，一招「伊谁与裁」，探身向前，转身至$n身侧，一刀砍出",
      "jibie": 56,
      "zhaoshi": "「伊谁与裁」",
      "sen": 3,
      "damage": 75,
      "wound": 40,
      "damage_type": "砍伤" ]),
    ([ "action": "$N一招「青春鹦鹉」，$w在身前乱挥一阵",
      "lian": "$N一招「青春鹦鹉」，$w在身前乱挥一阵",
      "jibie": 64,
      "zhaoshi": "「青春鹦鹉」",
      "sen": 2,
      "dodge": 0,
      "parry": 10,
      "wound": 35,
      "damage": 85,
      "wound": 45,
      "damage_type": "割伤" ]),

  });
}
