inherit SKILL_BLADE;

mapping *get_all_action()
{
    return ({
    ([	"action":"$N身形沉稳，手中$w猛的一转，施展出单刀的刀法，一招「举杯邀明月」朝$n的$l处砍去！",
        "lian"  :"$N身形沉稳，手中$w猛的一转，施展出单刀的刀法，一招「举杯邀明月」砍去",
        "jibie" :8,
        "zhaoshi":"「举杯邀明月」",
        "sen"   :3,
        "dodge" :0,
        "damage":40,
        "wound" : 20,
        "damage_type":"刀伤"   ]),
    ([  "action":"$N刀锋一转，划过一道圆弧，突然又于其上施展出挑、刺的招数，正是一招「对影成三人」！",
        "lian"  :"$N刀锋一转，划过一道圆弧，突然又于其上施展出挑、刺的招数，正是一招「对影成三人」",
        "jibie" :16,
        "zhaoshi":"「对影成三人」",
        "sen"   :4,
        "dodge" :10, 
        "parry" :10,
        "damage" :45,
        "wound":20,
        "damage_type":"割伤"    ]),
    ([  "action":"$N刀法突然凌厉，专走险路，赫然竟是马刀的路数，只见一招「天涯共此时」朝$n的$l砍去！",
        "lian"  :"$N刀法突然凌厉，专走险路，赫然竟是马刀的路数，只见一招「天涯共此时」砍了下来",
        "jibie" :24,
        "zhaoshi":"「天涯共此时」",
        "sen"   :3,
        "dodge" :0,
        "damage" : 50,
        "wound":30,
        "damage_type":"割伤"    ]),
    ([  "action":"$N体内的真气在不断变化，不断游移，突然一招「海角若比邻」斩向$n的$l!",
        "lian"  :"$N体内的真气在不断变化，不断游移，突然一招「海角若比邻」",
        "jibie" :32,
        "zhaoshi":"海角若比邻",
        "sen"   :4,
        "dodge" :20,
        "damage":60,
        "wound" :30,
        "damage_type":"砍伤"    ]),
});
}

