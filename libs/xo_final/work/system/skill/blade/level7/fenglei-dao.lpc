inherit SKILL_BLADE;

mapping *get_all_action()
{
    return ({
    ([	"action":"$N一招「风雷齐动」，手中$w挟着风势砍向$n$l!",
        "lian"  :"$N把手中$w舞的密不透风，正是一招「风雷齐动」",
        "jibie" :8,
        "zhaoshi":"「风雷齐动」",
        "sen"   :8,
        "dodge" :30,     
        "parry" :10,
        "damage":65,
        "wound": 50,
        "damage_type":"刀伤"   ]),
    ([  "action":
"$N横刀胸前，奋力外削，刀峰劈空，发出「呼呼」的声响，击向$n$l...",
        "lian"  :
"$N横刀胸前，奋力外削，刀峰劈空，发出「呼呼」的声响...",
        "jibie" :20,
        "zhaoshi":"「横刀劈空」",
        "sen"   :10,
        "dodge" :10,
        "parry" :10,
        "damage":75,
        "wound": 60,
        "damage_type":"割伤"    ]),
    ([  "action":
"又见$N揉身而上，抢步俯身，一刀向$n右腿斩去......",
        "lian"  :
"又见$N揉身而上，抢步俯身，一刀向下斩去......",
        "jibie" :30,
        "limb":"右腿",
        "zhaoshi":"「地堂六式」",
        "sen"   :8,
        "dodge" :0,
        "parry" :30,
        "wound": 65,
        "damage":85,
        "damage_type":"割伤"    ]),
    ([  "action":
"但见$N使出一招「雷霆万钧」，刀光挟着风势，「呼」地冲向$n的右肩....",
        "lian"  :
"但见$N使出一招「雷霆万钧」，刀光挟着风势，「呼」地冲向前方....",
        "jibie" :40,
        "limb":"右肩",
        "zhaoshi":"「雷霆万钧」",
        "sen"   :10,
        "dodge" :20,
        "parry" :20,
        "damage":80,
        "damage_type":"砍伤"    ]),
    ([  "action":
"$N身子一侧，一招「万马腾云」，身形跃左，刀峰削右，直劈$n前胸......",
        "lian"  :
"$N身子一侧，一招「万马腾云」，身形跃左，刀峰削右，直劈前方......",
        "jibie" :50,
        "sen"   :11,
