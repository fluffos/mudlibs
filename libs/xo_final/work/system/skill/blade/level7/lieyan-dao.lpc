inherit SKILL_BLADE;

mapping *get_all_action() {
  return ({
    ([ "action": "$N一招「黑龙现身」，$w有如一条黑龙在$n的周身旋游，勿快勿慢，变化若神",
      "lian": "$N一招「黑龙现身」，$w有如一条黑龙在周身旋游，勿快勿慢，变化若神",
      "jibie": 8,
      "zhaoshi": "「黑龙现身」",
      "sen": 8,
      "dodge": 30,
      "parry": 10,
      "damage": 65,
      "wound": 50,
      "damage_type": "刀伤" ]),
    ([ "action":
      "$N一招「万水千山」，左右腿一前一后，$w乱披风势向$n的$l斩去",
      "lian":
      "$N一招「万水千山」，左右腿一前一后，$w乱披风势斩去",
      "jibie": 20,
      "zhaoshi": "「万水千山」",
      "sen": 10,
      "dodge": 10,
      "parry": 10,
      "damage": 75,
      "wound": 60,
      "damage_type": "割伤" ]),
    ([ "action":
      "$N纵身跃落，一招「横扫千里」，$w带着疾风呼的一声便向$n横扫过去",
      "lian":
      "$N纵身跃落，一招「横扫千里」，$w带着疾风呼的一声横扫过去",
      "jibie": 30,
      "limb": "右腿",
      "zhaoshi": "「横扫千里」",
      "sen": 8,
      "dodge": 0,
      "parry": 30,
      "wound": 65,
      "damage": 85,
      "damage_type": "割伤" ]),
    ([ "action":
      "$N一招「左右开弓」，$w大开大阖，左右并进，左一刀，右一刀向$n的两肩砍落",
      "lian":
      "$N一招「左右开弓」，$w大开大阖，左右并进，左一刀，右一刀",
      "jibie": 40,
      "limb": "右肩",
      "zhaoshi": "「左右开弓」",
      "sen": 10,
      "dodge": 20,
      "parry": 20,
      "damage": 80,
      "damage_type": "砍伤" ]),
    ([ "action":
      "$N手中$w自上而下，一招「百丈飞瀑」，刀光流泻，如一片雪白瀑布砍向$n的头部",
      "lian":
      "$N手中$w自上而下，一招「百丈飞瀑」，刀光流泻，如一片雪白瀑布",
      "jibie": 50,
      "sen": 11,
      "limb": "前胸",
      "zhaoshi": "「百丈飞瀑」",
      "damage": 90,
      "wound": 70,
      "dodge": 30,
      "parry": 30,
      "damage_type": "刀伤" ]),
    ([ "action":
      "$N挥舞$w，使出一招「直摧万马」，上劈下撩，左挡右开，如千军万马般罩向$n",
      "lian":
      "$N挥舞$w，使出一招「直摧万马」，上劈下撩，左挡右开，如千军万马",
      "jibie": 60,
      "limb": "前胸",
      "zhaoshi": "「直摧万马」",
      "sen": 12,
      "dodge": 20,
      "parry": 40,
      "wound": 85,
      "damage": 100,
      "damage_type": "割伤" ]),
    ([ "action":
      "$N带得刀风劲疾，一招「灵猫翻身」，一个猛转身，连刀带人往$n的$l的劈去",
      "lian":
      "$N带得刀风劲疾，一招「灵猫翻身」，一个猛转身，连刀带人劈去",
      "jibie": 80,
      "sen": 11,
      "limb": "前胸",
      "zhaoshi": "「灵猫翻身」",
      "damage": 90,
      "wound": 70,
      "dodge": 30,
      "parry": 30,
      "damage_type": "刀伤" ]),
    ([ "action":
      "$N向前一个弓步，一招「上步劈山」，$w直直的劈出，一片流光般的刀影向$n的全身罩去",
      "lian":
      "$N向前一个弓步，一招「上步劈山」，$w直直的劈出，一片流光般的刀影罩去",
      "jibie": 100,
      "limb": "前胸",
      "zhaoshi": "「上步劈山」",
      "sen": 12,
      "dodge": 20,
      "parry": 40,
      "wound": 85,
      "damage": 100,
      "damage_type": "割伤" ]),
  });
}
