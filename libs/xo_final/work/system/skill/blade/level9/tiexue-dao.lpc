inherit SKILL_BLADE;

mapping *get_all_action() {
  return ({
    ([ "action":
      "$N一招「黑龙现身」，$w有如黑龙在$n的周身旋游，勿快勿慢，变化若神",
      "lian":
      "$N一招「黑龙现身」，$w有如黑龙在周身旋游，勿快勿慢，变化若神",
      "zhaoshi": "「黑龙现身」",
      "sen": 10,
      "jibie": 20,
      "damage": 100,
      "wound": 100,
      "damage_type": "劈伤",
    ]),
    ([ "action":
      "$N一招「万水千山」，左右腿一前一后，$w乱披风势向$n的$l斩去",
      "lian":
      "$N一招「万水千山」，左右腿一前一后，$w乱披风斩去",
      "zhaoshi": "「万水千山」",
      "sen": 20,
      "jibie": 40,
      "damage": 110,
      "wound": 110,
      "damage_type": "劈伤",
    ]),
    ([ "action":
      "$N纵身跃落，一招「横扫千里」，$w带着疾风呼的一声便向$n横扫过去",
      "lian":
      "$N纵身跃落，一招「横扫千里」，$w带着疾风呼的一声横扫过去",
      "zhaoshi": "「横扫千里」",
      "limb": "腰部",
      "sen": 12,
      "weapon": "火焰刀风",
      "jibie": 60,
      "damage": 120,
      "wound": 120,
      "damage_type": "砍伤",
    ]),
    ([ "action":
      "$N一招「左右开弓」，$w大开大阖，左右并进，左右两刀向$n的两肩砍落",
      "lian":
      "$N一招「左右开弓」，$w大开大阖，左右并进，左右两刀砍落",
      "zhaoshi": "「左右开弓」",
      "sen": 23,
      "jibie": 80,
      "weapon": "火焰刀风",
      "damage": 130,
      "wound": 130,
      "damage_type": "砍伤",
    ]),
    ([ "action":
      "$N手中$w自上而下，一招「百丈飞瀑」刀光流泻，如瀑布般砍向$n的头部",
      "lian":
      "$N手中$w自上而下，一招「百丈飞瀑」刀光流泻，如瀑布般",
      "zhaoshi": "「百丈飞瀑」",
      "sen": 20,
      "jibie": 100,
      "weapon": "无形刀气",
      "damage": 140,
      "wound": 140,
      "damage_type": "劈伤",
    ]),
    ([ "action":
      "$N使出一招「直摧万马」，上劈下撩，左挡右开，如千军万马般罩向$n",
      "lian":
      "$N使出一招「直摧万马」，上劈下撩，左挡右开，如千军万马",
      "zhaoshi": "「直摧万马」",
      "sen": 30,
      "jibie": 120,
      "weapon": "无形刀气",
      "damage": 150,
      "wound": 150,
      "damage_type": "劈伤",
    ]),
    ([ "action":
      "$N带得刀风劲疾，一招「怪蟒翻身」，转身连刀带人往$n的$l的劈去",
      "lian":
      "$N带得刀风劲疾，一招「怪蟒翻身」，转身连刀带人劈去",
      "zhaoshi": "「怪蟒翻身」",
      "sen": 20,
      "jibie": 140,
      "weapon": "无形刀气",
      "damage": 140,
      "wound": 140,
      "damage_type": "劈伤",
    ]),
    ([ "action":
      "$N一招「上步劈山」，$w直直的劈出，一片流光般的刀影向$n的全身罩去",
      "lian":
      "$N一招「上步劈山」，$w直直的劈出，一片流光般的刀影罩去",
      "zhaoshi": "「上步劈山」",
      "sen": 30,
      "jibie": 150,
      "weapon": "无形刀气",
      "damage": 150,
      "wound": 150,
      "damage_type": "劈伤",
    ]),
  });
