#include <ansi.h>

inherit SKILL_BLADE;

mapping *get_all_action() {
  return ({
    ([ "action":
      "$N一招" HIR "「钻木取火」" NOR "，全身骨节一阵暴响，手中$w幻出无数刀光笼罩了$n的全身",
      "lian":
      "$N一招" HIR "「钻木取火」" NOR "，全身骨节一阵暴响，手中$w幻出无数刀光笼罩四周",
      "zhaoshi": "钻木取火",
      "sen": 10,
      "jibie": 20,
      "damage": 100,
      "wound": 100,
      "damage_type": "劈伤",
    ]),
    ([ "action":
      "$N跃在空中，凌空下击，使出一招" HIR "「风火无边」" NOR "，手中$w此起彼伏，一道道无形刀气袭向$n全身各处",
      "lian":
      "$N跃在空中，凌空下击，使出一招" HIR "「风火无边」" NOR "，手中$w此起彼伏，一道道无形刀气袭向四周",
      "zhaoshi": "风火无边",
      "sen": 20,
      "jibie": 40,
      "damage": 110,
      "wound": 110,
      "damage_type": "劈伤",
    ]),
    ([ "action":
      "$N左臂一圈，将手中$w挂压出去，顺势使出一招" HIR "「祝融怀焰」" NOR "，手中$w直指向$n的面门",
      "lian":
      "$N左臂一圈，将手中$w挂压出去，顺势使出一招" HIR "「祝融怀焰」" NOR "，手中$w直劈而下",
      "zhaoshi": "祝融怀焰",
      "limb": "腰部",
      "sen": 12,
      "weapon": "火焰刀风",
      "jibie": 60,
      "damage": 120,
      "wound": 120,
      "damage_type": "砍伤",
    ]),
    ([ "action":
      "$N跨前一大步，借腰胯之力，一招" HIR "「白佛光度」" NOR "，手中$w前出后至，横劈向$n的$l，刀风凌厉之极",
      "lian":
      "$N跨前一大步，借腰胯之力，一招" HIR "「白佛光度」" NOR "，手中$w前出后至，横劈而出，刀风凌厉之极",
      "zhaoshi": "白佛光度",
      "sen": 23,
      "jibie": 80,
      "weapon": "火焰刀风",
      "damage": 130,
      "wound": 130,
      "damage_type": "砍伤",
    ]),
    ([ "action":
      "$N哈哈大笑，全身劲力凝于手中$w，一招" HIR "「刀山火海」" NOR "，刀气汹涌而出，$n被逼得一阵气窒",
      "lian":
      "$N哈哈大笑，全身劲力凝于手中$w，一招" HIR "「刀山火海」" NOR "，刀气汹涌而出，一阵寒气逼人",
      "zhaoshi": "刀山火海",
      "sen": 20,
      "jibie": 100,
      "weapon": "无形刀气",
      "damage": 140,
      "wound": 140,
      "damage_type": "劈伤",
    ]),
    ([ "action":
      "$N挥动手中$w，四周竟带起一股热浪，一招" HIR "「双龙吐焰」" NOR "，凌空劈出，炽热的刀气击向$n的$l",
      "lian":
      "$N挥动手中$w，四周竟带起一股热浪，一招" HIR "「双龙吐焰」" NOR "，凌空劈出，炽热的刀气击而出",
      "zhaoshi": "双龙吐焰",
      "sen": 30,
      "jibie": 120,
      "weapon": "无形刀气",
      "damage": 150,
      "wound": 150,
      "damage_type": "劈伤",
    ]),
  });
}

string *get_all_parry_msg() {
  return ({
    "$n手中$v射出无数火焰之光，$N惊诧中，猛然退步",
    "$n手中$v幻化出无数刀光，反手横击，正中$N的$w",
    "$n一招「星火燎原」，手中$v激发无数内力向$N点点射出，$N急忙翻身撤步",
  });
}

string *get_all_unarmed_msg() {
  return ({
    "$n回身抽刀，手中$v横劈而下，霸气肆意，$N茫然中无从下手",
    "$n跃然而起，手中$v猛然回劈，正中$N的$w",
  });
}
