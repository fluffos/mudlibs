#include <nt_adapter.h>

int exert(object me, object target) {
  int n, q;
  int jibie;

  if (target != me) {
    return notify_fail("你只能用内功疗自己的伤。\n");
  }

  if (me->in_war()) {
    return notify_fail("战斗中运功疗伤？找死吗？\n");
  }

  if (me->query("force") < 20) {
    return notify_fail("你的内力不够。\n");
  }

  q = query("eff_kee", me) - query("kee", me);
  if (q < 10) {
    return notify_fail("你现在气力充沛。\n");
  }

  jibie = me->query_jibie(me->query("using_force"));

  if (0 < jibie) {
    n = 100 * q / jibie;
  } else {
    n = 0;
  }
  if (query("breakup", me)) {
    n = n * 7 / 10;
  }
  if (n < 20) {
    n = 20;
  }

  if (query("force", me) < n) {
    if (q > 1000000) {
      q = q / n * query("force", me);
    } else {
      q = q * query("force", me) / n;
    }

    n = query("force", me);
  }

  addn("force", -n, me);

  if (q < 1) {
    q = 1;
  }
  me->receive_heal("kee", q);

  message_vision("$N深深吸了几口气，脸色看起来好多了。\n", me);

  return 1;
}
