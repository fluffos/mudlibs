#include <ansi.h>
#include <nt_adapter.h>

void remove_effect(object me, int amount);

int exert(object me, object target) {
  string my_skill;
  string skill_ob;
  int jibie;

  my_skill = me->query("using_force");
  skill_ob = SKILL_D(my_skill);

  if (target != me) {
    return notify_fail("你只能用内功来提升自己的躲闪力。\n");
  }

  if (me->query_xiuwei_dengji("force") < 2) {
    return notify_fail("你的内功略显不足。\n");
  }

  if (query("force", me) < 200) {
    return notify_fail("你的内力不够。\n");
  }

  if (query_temp("powerup/dodge", me)) {
    return notify_fail("你已经在运功中了。\n");
  }

  addn("force", -100, me);

  combat_message(HIR "$N" HIR "凝神息气，运起" + skill_ob->chinese_name() + "，只见一股轻烟悄然缭绕周身。\n" NOR, me);

  jibie = me->query_jibie(my_skill);

  addn_temp("apply/dodge", jibie * 2 / 3, me);
  set_temp("powerup/dodge", 1, me);

  me->start_call_out(
    (: call_other, __FILE__, "remove_effect", me, jibie * 2 / 3, skill_ob->chinese_name() :),
    jibie / 3
  );

  return 1;
}

void remove_effect(object me, int amount, string skill) {
  if (query_temp("powerup/dodge", me)) {
    addn_temp("apply/dodge", -amount, me);
    delete_temp("powerup/dodge", me);
    tell_object(me, "你的" + skill + "运行完毕，将内力收回丹田。\n");
  }
}
