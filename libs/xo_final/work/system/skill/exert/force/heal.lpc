#include <ansi.h>

int exert(object me, object target, int amount) {
  string my_skill;

  my_skill = me->query("using_force");

  if (target != me) {
    return notify_fail("你只能用内功疗自己的伤。\n");
  }

  if (me->in_war()) {
    return notify_fail("战斗中运功疗伤？找死吗？\n");
  }

  if (!amount) {
    amount = 40;
  }

  if (me->query("force") < amount) {
    return notify_fail("你的真气不够。\n");
  }

  if (target->query("eff_kee") >= target->query("max_kee")
    && target->query("eff_gin") >= target->query("max_gin")
    && target->query("eff_sen") >= target->query("max_sen")) {
    return notify_fail("你没有受到内伤。\n");
  }

  if (target->query("eff_kee") < target->query("max_kee") / 4
    || target->query("eff_gin") < target->query("max_gin") / 4
    || target->query("eff_sen") < target->query("max_sen") / 4) {
    return notify_fail("你已经受伤过重，只怕一运真气便有生命危险！\n");
  }

  message_vision(RED "$N运气双掌，掌心向下举过头顶，双掌殷红如血。\n" NOR, me);
  me->addn("force", -amount);

  amount *= me->query_jibie(my_skill) * SKILL_D(my_skill)->query_dengji() / 100;
  if (amount < 50) {
    amount = 50;
  }

  me->receive_curing("kee", amount);
  me->receive_curing("gin", amount);
  me->receive_curing("sen", amount);

  message_vision(HIY "$N脸上由白转青，由青转红，吐出了一口瘀血，脸色好多了。\n" NOR, target);

  return 1;
}
