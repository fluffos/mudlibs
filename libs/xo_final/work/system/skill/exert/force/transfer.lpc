#include <ansi.h>
#include <nt_adapter.h>

int exert(object me, object target)
{
    string my_skill;
    string skill_ob;
    int jibie;

    my_skill = me->query("using_force");
    skill_ob = SKILL_D(my_skill);
    jibie = me->query_jibie(my_skill);

    if ( target == me )
    {
        return notify_fail("你只能将内力传给他人。\n");
    }

    if ( me->query_xiuwei_dengji("force") < 7 )
    {
        return notify_fail("你的内功略显不足。\n");
    }

    if ( (!target) || !userp(target)  || query("id", target) == query("id", me) )
    {
        return notify_fail("你要将真气传给谁？\n");
    }

    if ( me->in_war() )
    {
        return notify_fail("战斗中无法传功！\n");
    }

    if ( !target->can_act() )
    {
        return notify_fail(target->name() + "现在正忙着呢！\n");
    }

    if ( query("max_force", me) < 400 )
    {
        return notify_fail("你的内力修为不够。\n");
    }

    if ( query("force", me) < 200 )
    {
        return notify_fail("你的真气不够。\n");
    }

    if ( query("fore", target) >= query("max_force", target) )
    {
        return notify_fail( target->name() + "内力充沛，不必劳起你的真气！\n");
    }

    message_combatd( HIY "$N坐了下来运起内功，将手掌贴在$n背心，缓缓地将真气输入$n体内....\n\n过了不久，$N额头上冒出豆大的汗珠，$n吐出一口瘀血，脸色看起来红润多了。\n" NOR, me, target );

    target->addn("force", 10 + (int)jibie / 3 );
    if ( target->query("force") > target->query("max_force") )
    {
        target->set("force", target->query("max_force"));
    }

    addn("force", -300, me);

    return 1;
}

