#include <ansi.h>
#include <nt_adapter.h>

int exert(object me, object target) {
  string my_skill;
  string skill_ob;
  int jibie;

  my_skill = me->query("using_force");
  skill_ob = SKILL_D(my_skill);
  jibie = me->query_jibie(my_skill);

  if (target == me) {
    return notify_fail("你只能用内功来替他人疗伤。\n");
  }

  if (me->query_xiuwei_dengji("force") < 5) {
    return notify_fail("你的内功略显不足。\n");
  }

  if ((!target) || !userp(target) || query("id", target) == query("id", me)) {
    return notify_fail("你要用真气为谁疗伤？\n");
  }

  if (me->in_war()) {
    return notify_fail("战斗中无法运功疗伤！\n");
  }

  if (!target->can_act()) {
    return notify_fail(target->name() + "现在正忙着呢！\n");
  }

  if (query("max_force", me) < 300) {
    return notify_fail("你的内力修为不够。\n");
  }

  if (query("force", me) < 150) {
    return notify_fail("你的真气不够。\n");
  }

  if (query("eff_kee", target) >= query("max_kee", target)) {
    return notify_fail(target->name() + "只是累了，没有受伤，不必劳起你的真气疗伤！\n");
  }

  if (query("eff_kee", target) < query("max_kee", target) / 5) {
    return notify_fail(target->name() + "已经受伤过重，经受不起你的真气震荡！\n");
  }

  message_combatd(
    HIY "$N坐了下来运起内功，将手掌贴在$n背心，缓缓地将真气输入$n体内....\n\n过了不久，$N额头上冒出豆大的汗珠，$n吐出一口瘀血，脸色看起来红润多了。\n" NOR,
    me,
    target
  );

  target->receive_curing("kee", 10 + (int)jibie / 3);
  addn("kee", 10 + jibie / 3, target);

  if (query("kee", target) > query("eff_kee", target)) {
    set("kee", query("eff_kee", target), target);
  }

  addn("force", -150, me);

  return 1;
}
