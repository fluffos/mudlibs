#include <ansi.h>
#include <nt_adapter.h>

void remove_effect(object me, int amount);

int exert(object me, object target) {
  string my_skill;
  string skill_ob;
  int jibie;

  my_skill = me->query("using_force");
  skill_ob = SKILL_D(my_skill);
  jibie = me->query_jibie(my_skill);

  if (target != me) {
    return notify_fail("你只能用内功来提升自己的防御力。\n");
  }

  if (me->query_xiuwei_dengji("force") < 3) {
    return notify_fail("你的内功略显不足。\n");
  }

  if (query("force", me) < 200) {
    return notify_fail("你的内力不够。\n");
  }

  if (query_temp("powerup/shield", me)) {
    return notify_fail("你已经在运功中了。\n");
  }

  addn("force", -200, me);

  message_combatd(HIW "$N" HIW "身子一晃，衣袖一波波的不住激荡，劲气逼人！\n" NOR, me);

  addn_temp("apply/armor", jibie / 2, me);
  set_temp("powerup/shield", 1, me);

  if (me->query_xiuwei_dengji("force") >= 9) {
    addn_temp("apply/force_armor", jibie / 2, me);
    set_temp("powerup/protect", 1, me);
  }

  me->start_call_out(
    (: call_other, __FILE__, "remove_effect", me, jibie / 2, skill_ob->chinese_name() :),
    jibie
  );

  return 1;
}

void remove_effect(object me, int amount, string skill) {
  if (query_temp("powerup/shield", me)) {
    addn_temp("apply/armor", -amount, me);
    delete_temp("powerup/shield", me);
    addn_temp("apply/force_armor", -amount, me);
    delete_temp("powerup/protect", me);
    tell_object(me, "你的" + skill + "运行完毕，将内力收回丹田。\n");
  }
}
