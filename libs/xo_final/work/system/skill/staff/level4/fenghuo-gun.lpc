inherit SKILL_LONG;

mapping *get_all_action() {
  return ({
    ([ "action":
      "$N抬右脚踢棍跟向后，同时身体左转，原地跳成弓步，$w向前刺出，攻向$n$l\n"
      "正是一招「乌龙翻江」",
      "lian":
      "$N抬右脚踢棍跟向后，同时身体左转，原地跳成弓步，$w向前刺出...",
      "jibie": 0,
      "zhaoshi": "「乌龙翻江」",
      "sen": 9,
      "dodge": 10,
      "parry": 10,
      "damage": 20,
      "damage_type": "刺伤" ]),
    ([ "action":
      "$N两腿屈膝成马步，一招「顽石点头」，$w随身轮一个五花，眼瞟向$n右侧，\n"
      "$w却刺向$n左侧",
      "lian":
      "$N两腿屈膝成马步，一招「顽石点头」，$w随身轮一个五花，眼瞟向右，\n"
      "$w却刺向左侧",
      "jibie": 20,
      "zhaoshi": "「顽石点头」",
      "sen": 7,
      "dodge": 0,
      "parry": 40,
      "damage": 55,
      "wound": 15,
      "damage_type": "刺伤" ]),
    ([ "action":
      "$N使出「黑风展翅」，两脚不动，棍梢向上向后轮起，一溜向前，挑向$n$l",
      "lian":
      "$N使出「黑风展翅」，两脚不动，棍梢向上向后轮起，一溜向前挑阳。",
      "jibie": 60,
      "zhaoshi": "「黑风展翅」",
      "sen": 10,
      "dodge": 10,
      "parry": 30,
      "damage": 60,
      "wound": 20,
      "damage_type": "割伤" ]),
    ([ "action":
      "$N使出一式「孤雁出群」，上体稍右转，$w由右向左下方打，接着左脚向前\n"
      "棍由左向右轮过，横扫$n",
      "lian":
      "$N使出一式「孤雁出群」，上体稍右转，$w由右向左下方打，接着左脚向前\n"
      "棍由左向右轮过，横扫一圈。",
      "jibie": 90,
      "zhaoshi": "「孤雁出群」",
      "sen": 9,
      "dodge": 30,
      "parry": 30,
      "damage": 75,
      "wound": 20,
      "damage_type": "淤伤" ]),
    ([ "action":
      "$N一招「铁牛耕地」，左脚上前一步，$w由上向下打，不待$n反应，又由下向上\n"
      "撩向$n下阴",
      "lian":
      "$N一招「铁牛耕地」，左脚上前一步，$w由上向下打，又由下向上撩起。",
      "jibie": 120,
      "sen": 7,
      "zhaoshi": "「铁牛耕地」",
      "dodge": 0,
      "parry": 30,
      "damage": 80,
      "wound": 30,
      "damage_type": "瘀伤" ]),
  });
}

int valid_learn(object me) {
  if (!me->query_jibie("buddhism")) {
    return notify_fail("你的佛学修为不够，强练绝技会伤及身体。\n");
  }

  return ::valid_learn(me);
}

string query_weapon_type() {
  return "staff";
}
