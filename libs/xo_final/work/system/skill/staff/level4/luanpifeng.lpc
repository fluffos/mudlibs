        "sen"   :5,
        "dodge" :5,     
        "parry" :30,
        "damage":60,
		"wound" :30,
        "damage_type":"劈伤"   ]),
    ([  "action":
"$N一式「怪蟒翻身」，手中的$w从下向上斜挑向$n",
		"lian"  :
"$N一式「怪蟒翻身」，手中的$w从下向上斜挑",
		"jibie" :20,
        "sen"   :6,
        "dodge" :10,
        "parry" :30,
        "damage":65,
		"wound" :35,
        "damage_type":"淤伤"    ]),
    ([  "action":
"$N使出「飞星逐月」，双脚点地一蹬，连人带棍平飞起来直撞向$n",
		"lian"  :
"$N双脚点地一蹬，连人带棍平飞起来直撞向前",
		"jibie" :25,
        "limb"  :"胸口",
        "sen"   :8,
        "dodge" :10,
        "parry" :40,
        "damage":70,
		"wound" :35,
        "damage_type":"淤伤"    ]),
    ([  "action":
"$N把$w舞成一团巨大的棍影，如「烈火燎原」般向$n卷去",
		"lian"  :
"$N把$w舞成一团巨大的棍影，向前卷去",
		"jibie" :40,
        "limb"  :"身体",
        "sen"   :7,                        
        "dodge" :20,
        "parry" :20,
        "damage":80,
