inherit SKILL_LONG;

mapping *get_all_action()
{
    return ({
    ([	"action":
"$N右脚后退一步，一招「白猿献棒」，手中$w从右侧直攻$n的左腿",
        "lian"  :
"$N右脚后退一步，一招「白猿献棒」，手中$w由右向左直劈而下",
        "jibie" :0,
        "limb"  : "左腿",
        "zhaoshi":"「白猿献棒」",
        "sen"   :9,
        "dodge" :10,
        "parry" :10,
        "damage":20,
        "damage_type":"瘀伤"   ]),
    ([  "action":
"$N一招「猿猴开销」，右手在$w上轻轻一拨，只见$w脱手而出，只飞向$n$l",
        "lian"  :
"$N一招「猿猴开销」，右手在$w上轻轻一拨，只见$w脱手而出往空中飞去",        
        "jibie" :20,
        "zhaoshi":"「猿猴开销」",
        "sen"   :7,
        "dodge" :0, 
        "parry" :40,
        "damage":55,
        "wound":15,
        "damage_type":"戳伤"    ]),
    ([  "action":
"$N使出「猿猴挠杆」，左手指在$w上连拨数下，$w转成一圈，激起强烈劲风扑向$n",
        "lian"  :
"$N使出「猿猴挠杆」，左手指在$w上连拨数下，$w转成一圈，一股激起强烈劲风",
        "jibie" :60,
        "zhaoshi":"「猿猴挠杆」",
        "sen"   :10,
        "dodge" :10,
        "parry" :30,
        "damage":60,
        "wound" :20,
        "damage_type":"震伤"    ]),
    ([  "action":
"$N使出一式「猿猴背棒」，手中$w由下置上，舞过身前，连攻$n身上数处要穴",
        "lian"  :
"$N使出一式「猿猴背棒」，手中$w由下置上，舞过身前，轻轻收于背后",
        "jibie" :90,
        "zhaoshi":"「猿猴背棒」",
        "sen"   :9,
        "dodge" :30,
        "parry" : 30,
        "damage":45,
        "wound" :20,
        "damage_type":"戳伤"    ]),
    ([  "action":
"$N身子一侧，一招「猴棒落地」，猛地蹲下，$w横扫$n下盘",
        "lian"  :
"$N身子一侧，一招「猴棒落地」，猛地蹲下，握棍猛扫",
        "jibie" :120,
        "sen"   :7,
        "zhaoshi":"「猴棒落地」",
        "dodge":0,
        "parry" :30,
        "damage" : 45,  
        "wound"  : 30,    
        "damage_type":"瘀伤"   ]),
});
}

int valid_learn(object me)
{      
    if ( !me->query_jibie("buddhism"))
    {
        return notify_fail("你的佛学修为不够，强练绝技会伤及身体");
    }

    return ::valid_learn(me);
}

string query_weapon_type()
{
    return "staff";
}

