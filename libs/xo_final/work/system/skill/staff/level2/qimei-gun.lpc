inherit SKILL_LONG;

mapping *get_all_action() {
  return ({
    ([ "action":
      "$N一招「起手式」，撤步屈腿，双手握$w，右臂发力，左手回收，$w直打$n腰际",
      "lian": "$N把手中$w舞的密不透风，正是一招「起手式」",
      "jibie": 8,
      "zhaoshi": "「起手式」",
      "limb": "腰间",
      "sen": 3,
      "dodge": 20,
      "damage": 20,
      "damage_type": "瘀伤" ]),
    ([ "action":
      "$N一招「单棒挑日月」，跨上一步，右手发力，$w欲脱手而出，暴长二尺，径点$n$l",
      "lian": "$N一招「单棒挑日月」，手中$w欲脱手而出。。。。。",
      "jibie": 16,
      "zhaoshi": "「单棒挑日月」",
      "sen": 5,
      "dodge": 10,
      "parry": 20,
      "damage": 40,
      "damage_type": "瘀伤" ]),
    ([ "action":
      "只见$N一招「棒打双犬」，收棒回立，提腿收肩，将$w向$n左右各击一下",
      "lian":
      "$N一招「棒打双犬」，收棒回立，提腿收肩，向左右各击一下",
      "jibie": 24,
      "zhaoshi": "「棒打双犬」",
      "sen": 4,
      "dodge": 20,
      "damage": 30,
      "damage_type": "瘀伤" ]),
    ([ "action": "又见$N一式「横扫千军」，手中$w一长，自左至右横扫$n中路，$w激起一阵劲风",
      "lian": "$N一式「横扫千军」，手中$w一长，自左至右横扫中路，$w激起一阵劲风",
      "jibie": 32,
      "zhaoshi": "横扫千军",
      "sen": 3,
      "dodge": 20,
      "damage": 40,
      "damage_type": "瘀伤" ]),
    ([ "action": "$N身子一侧，一招「大鹏展翅」，$w走长枪的路子，径点$n面门",
      "lian": "$N身子一侧，一招「大鹏展翅」，$w走长枪的路子",
      "jibie": 40,
      "sen": 5,
      "zhaoshi": "「大鹏展翅」",
      "damage": 20,
      "parry": 20,
      "damage_type": "瘀伤" ]),
    ([ "action": "$N一招「南征北战」，手中$w指东打西，轻灵之中蕴存着无尽后力",
      "lian": "$N一招「南征北战」，手中$w指东打西，轻灵之中蕴存着无尽后力",
      "jibie": 48,
      "zhaoshi": "「南征北战」",
      "sen": 2,
      "damage": 40,
      "parry": 50,
      "damage_type": "瘀伤" ]),
    ([ "action": "$N大喝一声，$w向$n当头直挥，至中途却突然一转，击向$n$l",
      "lian": "$N一招「伏兵十面」，$w中途一转",
      "jibie": 56,
      "zhaoshi": "「伏兵十面」",
      "sen": 3,
      "dodge": 20,
      "parry": 20,
      "damage": 35,
      "damage_type": "瘀伤" ]),
    ([ "action": "$N一招「龙宫探宝」，$w横扫$n下路",
      "lian": "$N一招「龙宫探宝」，$w横扫下路",
      "jibie": 64,
      "zhaoshi": "「龙宫探宝」",
      "sen": 4,
      "dodge": 20,
      "parry": 10,
      "damage": 36,
      "damage_type": "瘀伤" ]),
  });
}

string query_weapon_type() {
  return "staff";
}
