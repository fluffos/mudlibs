int valid_learn(object me)
{   
    if ( ( me->query("str") * 20 + me->query("max_force") ) < 1100 )
    {
        return notify_fail("你的膂力过小，需要格外多修习内功加以辅助，方可学习这门功夫\n");
    }

    return ::valid_learn(me);
}

string query_weapon_type()
{
    return "staff";
}

