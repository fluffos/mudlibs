//#include <force.h>

int query_capacity_force()
{
    int capacity_force,n;
    
    capacity_force = 500;
    capacity_force += ( (int)query("age") - 14 )* 50;
    capacity_force += (int)( (int)query("max_force")/10 );
    capacity_force += (int)query("flow/shou_taiyin");
    capacity_force += (int)query("flow/shou_shaoyin");
    capacity_force += (int)query("flow/shou_jueyin");
    capacity_force += (int)query("flow/zu_taiyin");
    capacity_force += (int)query("flow/zu_shaoyin");
    capacity_force += (int)query("flow/zu_jueyin");
    capacity_force += (int)query("flow/shou_yangming");
    capacity_force += (int)query("flow/shou_taiyang");
    capacity_force += (int)query("flow/shou_shaoyang");
    capacity_force += (int)query("flow/zu_yangming");
    capacity_force += (int)query("flow/zu_taiyang");
    capacity_force += (int)query("flow/zu_shaoyang");
    n = 0;
    if ( query("force_summation/renmai_pulse") > 200 ) n = 1;    
    capacity_force += n * 700;
    n = 0;
    if ( query("force_summation/dumai_pulse") > 200 ) n = 1;    
    capacity_force += n * 700;
    n = 0;
    if ( query("force_summation/chongmai_pulse") > 200 ) n = 1;    
    capacity_force += n * 800;
    n = 0;
    if ( query("force_summation/daimai_pulse") > 200 ) n = 1;    
    capacity_force += n * 800;
    n = 0;
    if ( query("force_summation/yinqiao_pulse") > 200 ) n = 1;    
    capacity_force += n * 200;
    n = 0;
    if ( query("force_summation/yanqiao_pulse") > 200 ) n = 1;    
    capacity_force += n * 200;
    n = 0;
    if ( query("force_summation/yinwei_pulse") > 200 ) n = 1;    
    capacity_force += n * 300;
    n = 0;
    if ( query("force_summation/yangwei_pulse") > 200 ) n = 1;    
    capacity_force += n * 300;
    n = 0;
    if ( query("force_summation/tufu_guan") > 200 ) n = 1;    
    capacity_force += n * 250;
    n = 0;
    if ( query("force_summation/yuchi_guan") > 200 ) n = 1;    
    capacity_force += n * 250;
    n = 0;
    if ( query("force_summation/chongluo_guan") > 200 ) n = 1;    
    capacity_force += n * 500;
    n = 0;
    if ( query("force_summation/mingmen_guan") > 200 ) n = 1;    
    capacity_force += n * 500;
    n = 0;
    if ( query("force_summation/jiaji_guan") > 200 ) n = 1;    
    capacity_force += n * 250;
    n = 0;
    if ( query("force_summation/yuzhen_guan") > 200 ) n = 1;    
    capacity_force += n * 250;
    n = 0;
    if ( query("force_summation/haidi_guan") > 200 ) n = 1;    
    capacity_force += n * 500;
    n = 0;
    if ( query("force_summation/lingtai_guan") > 200 ) n = 1;    
    capacity_force += n * 500;
    n = 0;
    if ( query("force_summation/niwan_guan") > 200 ) n = 1;    
    capacity_force += n * 1000;
  
    return capacity_force;
}
