// filename : /feature/finance.c

// can_afford() checks if this_object() can afford a price, it returns:
//
//      0:      cannot afford.
//      1:      can afford with proper money(coins).
//      2:      如果身上的硬通货不够，但是有银票 return 2。
//
int can_afford(int amount)
{
    return MONEY_D->can_afford(this_object(), amount);
}

// 用来查看玩家身上钱的数量。
// add this by tea 12.6.98
int query_money()
{
    return MONEY_D->query_money(this_object());
}

int pay_money(int amount)
{
    return MONEY_D->pay_money(this_object(), amount);
}

