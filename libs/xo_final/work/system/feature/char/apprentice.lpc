int is_apprentice_of(object master)
{
    return APPRENTICE_D->is_apprentice_of(this_object(), master);
}

int is_tongmen_of(object obj)
{
    return APPRENTICE_D->is_tongmen_of(this_object(), obj);
}

void assign_apprentice(string title, int privs)
{
    APPRENTICE_D->assign_apprentice(this_object(), title, privs);
}

// This is used for NPC, or start a new family for a player.
void create_family(string family_name, int generation, string title)
{
    APPRENTICE_D->create_family(this_object(), family_name, generation, title);
}

int recruit_apprentice(object dizi)
{
    return APPRENTICE_D->recruit_apprentice(this_object(), dizi);
}

int attempt_apprentice(object dizi)
{
    return APPRENTICE_D->attempt_apprentice(this_object(), dizi);
}

int process_betray(object dizi)
{
    return APPRENTICE_D->process_betray(this_object(), dizi);
}

int process_chushi(object dizi)
{
    return APPRENTICE_D->process_chushi(this_object(), dizi);
}

int is_betrayed(string family)
{
    return APPRENTICE_D->is_betrayed(this_object(), family);
}

int is_chushied(string family)
{
    return APPRENTICE_D->is_chushied(this_object(), family);
}

// 返回的字串说明 me 是 obj 的什么关系
