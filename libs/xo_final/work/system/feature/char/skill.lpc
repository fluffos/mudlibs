{
    if ( !KUNGFU_D->check_skill(skill) )
    {
        error("F_SKILL: No such skill (" + skill + ")\n");
    }
}

int valid_skill( string skill )
{
    return KUNGFU_D->valid_skill(skill);
}

// 领悟的阈值公式
int lingwu_limit( string skill)
{
    return KUNGFU_D->lingwu_limit(this_object(), skill);
}

// 级别突破公式
varargs private int can_break_limit( string skill, int usage )
{
    return KUNGFU_D->can_break_limit(this_object(), skill, usage);
}

