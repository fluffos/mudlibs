}

void improve_jibie(string skill, int amount)
{
    check_skill( skill );
    
    amount = KUNGFU_D->improve_jibie(this_object(), skill, amount);

    if ( !mapp( m_jibie ) ) 
        m_jibie = ([ skill : amount ]);
    else 
        m_jibie[ skill ] += amount;
}

void improve_lingwu(string skill, int amount)
{
    check_skill( skill );

    amount = KUNGFU_D->improve_lingwu(this_object(), skill, amount);
    
    if ( !mapp( m_lingwu ) ) 
        m_lingwu = ([ skill : amount ]);
    else 
        m_lingwu[ skill ] += amount;
}

void improve_jilei_real(string skill, int amount)
{
    check_skill( skill );

    if ( !mapp( m_jilei ) ) 
        m_jilei = ([ skill : amount ]);
    else 
        m_jilei[ skill ] += amount;
}

void set_jilei_real(string skill, int amount)
{
    check_skill( skill );

    if ( !mapp( m_jilei ) ) 
        m_jilei = ([ skill : amount ]);
    else 
        m_jilei[ skill ] = amount;
}

void improve_jilei(string skill, int amount)
{
    check_skill( skill );
    KUNGFU_D->improve_jilei(this_object(), skill, amount);
}

void improve_xiuwei(string type, int amount)
{
    if ( 0 == amount )
    {
        return;
    }

    amount = KUNGFU_D->improve_xiuwei(this_object(), type, amount);

    if ( !mapp( m_xiuwei ) ) 
        m_xiuwei = ([ type : amount ]);
    else 
        m_xiuwei[ type ] += amount;
    if (!random(5))
        message("vision", "你的" + type + "修为有所提高．\n", this_player());
}

// qyz : make it easy to set skills of npc. 
// modify by nerd : make it varargs and delete set xiuwei
varargs int set_wugong(string skill, int jibie, int lingwu, int enable)
{   
    if ( !jibie ) jibie = 10;
    if ( !lingwu ) lingwu = jibie;
    if ( !enable ) enable = 0;
    set_jibie( skill, jibie );
    set_lingwu( skill, lingwu );
    set_jilei( skill, 0 );
    if ( enable ) enable_skill(skill);
    sort_wugong( SKILL_D(skill)->query_xiuwei_type() );
    return 1;
}

varargs int set_skill(string skill, int jibie, int lingwu, int enable)
{
    if ( !valid_skill(skill) )
    {
        return 0;
    }

    if ( "force" == skill )
    {
        skill = "jiben-neigong";
    }

    return set_wugong(skill, jibie, lingwu, enable);
}

varargs void map_skill(string skill, string mapped_to)
{
    if ( !valid_skill(mapped_to) )
    {
        return 0;
    }

    if ( "force" == mapped_to )
    {
        mapped_to = "jiben-neigong";
    }

    enable_skill(mapped_to);
}

varargs void prepare_skill(string skill, string mapped_to)
{
    if ( !valid_skill(mapped_to) )
    {
        return 0;
    }

    if ( "force" == mapped_to )
    {
        skill = "jiben-neigong";
    }

    map_skill(skill, mapped_to);
}

string query_skill_mapped(string skill)
{
    return query_wugong(skill);
}

varargs int query_skill(string skill, int raw)
{
    return query_jibie(skill);
}

varargs void improve_skill(string skill, int amount, int weak_mode)
{
    improve_jilei(skill, amount);
}

int skill_death_penalty()
{
    return KUNGFU_D->skill_death_penalty(this_object());
}

// 为计算 wugong_power 所必须的排序
int sort_wugong( string type )
{
    return KUNGFU_D->sort_wugong(this_object(), type);
}

