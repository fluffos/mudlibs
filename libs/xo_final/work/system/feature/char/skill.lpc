// Filename : /system/feature/skill.c

#include <ansi.h>
#include <dbase.h>
#include <options.h>

mapping m_jibie;
mapping m_lingwu;
mapping m_jilei;
mapping m_xiuwei;
mapping m_enable;
mapping m_hide;

////////////////////////////////////////////////////////////////////////////
// Function prototype

int lingwu_limit( string );
varargs private int can_break_limit( string, int);
void check_skill( string );
int valid_skill( string );
int sort_wugong( string );
void improve_xiuwei(string type, int amount);

mapping query_jibie_map() { return m_jibie; }
mapping query_lingwu_map() { return m_lingwu; }
mapping query_jilei_map() { return m_jilei; }
mapping query_xiuwei_map() { return m_xiuwei; }
mapping query_enable_map() { return m_enable; }
mapping query_hide_map() { return m_hide; }

void set_jibie_map(mapping jibie_map) { m_jibie = copy(jibie_map); }
void set_lingwu_map(mapping lingwu_map) { m_lingwu = copy(lingwu_map); }
void set_jilei_map(mapping jilei_map) { m_jilei = copy(jilei_map); }
void set_xiuwei_map(mapping xiuwei_map) { m_xiuwei = copy(xiuwei_map); }
void set_enable_map(mapping enable_map) { m_enable = copy(enable_map); }
void set_hide_map(mapping hide_map) { m_hide = copy(hide_map); }

/////////////////////////////////////////////////////////////////////////////

void set_jibie(string skill, int val)
{
    check_skill( skill );

    if ( !mapp( m_jibie ) )
        m_jibie = ([ skill: val ]);
    else 
        m_jibie[ skill ] = val;
}

int query_jibie(string skill)
{
    if ( skill && mapp( m_jibie ) && !undefinedp( m_jibie[ skill ] ) ) 
        return m_jibie[ skill ];
    return 0;
}

void set_jilei(string skill, int val)
{
    check_skill( skill );

    if ( 0 > val )
    {
        val = 0;
    }

    if ( !mapp( m_jilei ) ) 
        m_jilei = ([ skill: val ]);
    else 
        m_jilei[ skill ] = val;
}

int query_jilei(string skill)
{
    if ( mapp( m_jilei ) && !undefinedp( m_jilei[ skill ] ) ) 
        return m_jilei[ skill ];
    return 0;
}

void set_lingwu(string skill, int val)
{
    check_skill( skill );

    if ( 0 > val )
    {
        val = 0;
    }

    if ( !mapp( m_lingwu ) ) 
        m_lingwu = ([ skill: val ]);
    else 
        m_lingwu[ skill ] = val;
}

int query_lingwu(string skill)
{
    if ( mapp( m_lingwu ) && !undefinedp( m_lingwu[ skill ] ) ) 
        return m_lingwu[ skill ];
    return 0;
}

void set_xiuwei(string skill, int val)
{
    string type;

    if ( !valid_skill( skill ) )
        type = skill;
    else
        type = SKILL_D(skill)->query_xiuwei_type();

    if ( 0 > val )
    {
        val = 0;
    }

    if ( !mapp( m_xiuwei ) )
        m_xiuwei = ([ type : val ]);
    else
        m_xiuwei[ type ] = val;
} 

int query_xiuwei(string skill)
{
    string type;

    check_skill( skill );
    type = SKILL_D(skill)->query_xiuwei_type();
    if ( mapp( m_xiuwei ) && !undefinedp( m_xiuwei[ type ] ) ) 
        return m_xiuwei[ type ];
    return 0;
}

void set_xiuwei_by_type(string type, int val)
{
    if ( 0 > val )
    {
        val = 0;
    }

    if ( !mapp( m_xiuwei ) )
        m_xiuwei = ([ type : val ]);
    else
        m_xiuwei[ type ] = val;
} 

void set_xiuwei_level_by_type(string type, int val)
{
    KUNGFU_D->set_xiuwei_level_by_type(this_object(), type, val);
} 

int query_xiuwei_by_type(string type)
{
    if ( mapp( m_xiuwei ) && !undefinedp( m_xiuwei[ type ] ) ) 
    {
        return m_xiuwei[ type ];
    }

    return 0;
}

int query_xiuwei_jibie(string type)
{
    int ob_xiuwei;

    if ( mapp( m_xiuwei ) && !undefinedp( m_xiuwei[ type ] ) )
    {
        ob_xiuwei = query_xiuwei_by_type( type );

        return KUNGFU_D->query_xiuwei_jibie(ob_xiuwei);
    }

    return 0;
}

int query_xiuwei_dengji(string type)
{
    return query_xiuwei_jibie( type );
}

int query_max_xiuwei_jibie()
{
    return KUNGFU_D->query_max_xiuwei_jibie(this_object());
}

int enable_skill(string skill)
{
    if ( !valid_skill( skill ) )
    {
        return 0;
    }

    if ( !KUNGFU_D->enable_skill(this_object(), skill) )
    {
        return 0;
    }

    if ( !mapp( m_lingwu ) || !m_lingwu[ skill ] )
        return 0;
    if ( !mapp( m_enable ) )
        m_enable = ([ skill : 1 ]);
    else
        m_enable[ skill ] = 1;

    return 1;
}

int skill_enabled(string skill)
{
    if ( !skill || !mapp( m_enable ) || undefinedp(m_enable[skill]) )
    {
        return 0;
    }

    return 1;
}

int check_hide_skill(string skill)
{
    if ( !stringp(skill) ) 
    {
        error("Invalid skill name!\n");
    }
    if( !mapp(m_hide) ) return 0;
    return (!undefinedp(m_hide[skill]));
}

int hide_skill(string skill)
{
    if ( !stringp(skill) ) return 0;
    if ( !valid_skill(skill) ) return 0;
    if ( !mapp(m_hide) )
    {
        m_hide = ([ skill : 1 ]);
    }
    else 
    {
        m_hide[skill] = 1;
    }
    return 1;
}

int display_skill(string skill)
{
    if ( !stringp(skill) ) return 0;
    if ( !valid_skill(skill) ) return 0;
    if ( !mapp(m_hide) || 
         undefinedp(m_hide[skill] ) )
    {
        return 0;
    }
    else
    {
        map_delete( m_hide, skill); 
        return 1;
    }
}

void disable_skill(string skill)
{
    //check_skill( skill );
    if ( mapp( m_enable ) )
    {
        map_delete( m_enable, skill );
    }
}

int delete_wugong(string skill)
{
    int retVal;

    if ( mapp(m_jibie) ) map_delete( m_jibie, skill );
    if ( mapp(m_lingwu) ) map_delete( m_lingwu, skill );
    if ( mapp(m_jilei) ) map_delete( m_jilei, skill );
    if ( mapp(m_enable) ) map_delete( m_enable, skill );
    retVal = undefinedp( m_jibie[ skill ] );
    retVal = retVal && undefinedp( m_lingwu[ skill ] );
    retVal = retVal && undefinedp( m_jilei[ skill ] );
    retVal = retVal && undefinedp( m_enable[ skill ] );
    return retVal;
}

void delete_all_wugong()
{
    m_jibie = ([]);
    m_lingwu = ([]);
    m_jilei = ([]);
    m_enable = ([]);
}

void delete_all_xiuwei()
{
    m_xiuwei = ([]);
}

