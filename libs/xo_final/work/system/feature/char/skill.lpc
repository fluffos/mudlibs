string query_wugong_max(string type)
{
    return KUNGFU_D->query_wugong_max(this_object(), type);
}

// 由武器类型在jibie数组中找出此类的武功, 返回筛选出的数组 
string * query_wugong_list(string weapon_type)
{
    return KUNGFU_D->query_wugong_list(this_object(), weapon_type);
}

