#include <ansi.h>
#include <dbase.h>
#include <options.h>

private mapping m_art_jibie;
private mapping m_art_jilei;
private mapping m_art_lingwu;

////////////////////////////////////////////////////////////////////////////
// Function prototype

mapping query_art_jibie_map() { return m_art_jibie; }
mapping query_art_lingwu_map() { return m_art_lingwu; }
mapping query_art_jilei_map() { return m_art_jilei; }

/////////////////////////////////////////////////////////////////////////////

void set_art_jibie(string skill, int val)
{
    if ( !mapp( m_art_jibie ) )
        m_art_jibie = ([ skill: val ]);
    else 
        m_art_jibie[ skill ] = val;
}

int query_art_jibie(string skill)
{
    if ( mapp( m_art_jibie ) && !undefinedp( m_art_jibie[ skill ] ) ) 
        return m_art_jibie[ skill ];
    return 0;
}

void set_art_jilei(string skill, int val)
{
    if ( !mapp( m_art_jilei ) ) 
        m_art_jilei = ([ skill: val ]);
    else 
        m_art_jilei[ skill ] = val;
}

int query_art_jilei(string skill)
{
    if ( mapp( m_art_jilei ) && !undefinedp( m_art_jilei[ skill ] ) ) 
        return m_art_jilei[ skill ];
    return 0;
}

void set_art_lingwu(string skill, int val)
{
    if ( !mapp( m_art_lingwu ) ) 
        m_art_lingwu = ([ skill: val ]);
    else 
        m_art_lingwu[ skill ] = val;
}

int query_art_lingwu(string skill)
{
    if ( mapp( m_art_lingwu ) && !undefinedp( m_art_lingwu[ skill ] ) ) 
        return m_art_lingwu[ skill ];
    return 0;
}


void improve_art_jibie(string skill, int amount)
{
    if ( !mapp( m_art_jibie ) ) 
        m_art_jibie = ([ skill : amount ]);
    else 
        m_art_jibie[ skill ] += amount;
}

void improve_art_lingwu(string skill, int amount)
{
    if ( !mapp( m_art_lingwu ) ) 
        m_art_lingwu = ([ skill : amount ]);
    else 
        m_art_lingwu[ skill ] += amount;
}

