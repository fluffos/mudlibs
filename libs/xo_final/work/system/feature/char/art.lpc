varargs int set_art(string skill, int jibie, int lingwu)
{   
    if ( !jibie ) jibie = 10;
    if ( !lingwu ) lingwu = jibie;
    set_art_jibie( skill, jibie );
    set_art_lingwu( skill, lingwu );
    set_art_jilei( skill, 0 );
    return 1;
}

int delete_art(string skill)
{
    if ( mapp(m_art_jibie) ) map_delete( m_art_jibie, skill );
    if ( mapp(m_art_lingwu) ) map_delete( m_art_lingwu, skill );
    if ( mapp(m_art_jilei) ) map_delete( m_art_jilei, skill );
    return 1;
}

