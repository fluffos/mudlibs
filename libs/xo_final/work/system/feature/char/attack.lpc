void add_killer( object ob );

///////////////////////////////////////////////////////////////////////////
// 状态判断函数

varargs int is_duilianing(object ob)
{
    if ( ( ob && ( ob == duishou )) || ( !ob && duishou ) )
    {
        return 1;
    }

    return 0;
}

// This function returns 1 if we are fighting anyone (or with ob)
varargs int is_fighting(object ob)
{
    if ( !ob )
    {
        return sizeof(enemy) > 0;
    }

    return member_array(ob, enemy) != -1;
}

// 看看我是否正在与 id 比划或者正在与某人比划
varargs int is_bihuaing(string id)
{
    if ( !id )
    {
        return sizeof(bihua) > 0;
    }

    return member_array(id, bihua) != -1;
}

// This function returns 1 if we are fighting anyone (or with ob)
varargs int is_killing(string id)
{
    if ( !id )
    {
        return sizeof(killer) > 0;
    }

    return member_array(id, killer) != -1;
}


// 起动战斗
void duilian_ob(object ob)
{
    if ( !ob || ob == this_object() )
    {
        return;
    }

    if ( NPC_D->forbid_duilian(this_object(), ob) )
    {
        return;
    }

    delete_temp( "pending/duilian" );
    set_heart_beat( 1 );

    duishou = ob;
}


//This function starts fight between this_object() and ob
void fight_ob(object ob)
{
    if ( !ob || ob == this_object() )
    {
        return;
    }

    if ( NPC_D->forbid_fight(this_object(), ob) )
    {
        return;
    }

    delete_temp( "pending/fight" );
    set_heart_beat( 1 );

    // 如果对手正处于练习或对练状态, 我们就让他停下来准备战斗
    // 准备过程 busy random( 3 )
    if ( ob->is_lianing() )
    {
        ob->stop_lian();
        ob->start_busy( random( 3 ) );
        message_vision( HIY"$N赶紧收势迎战！\n" NOR, ob );
    }
    else if ( ob->is_duilianing() )
    {
        ob->remove_all_duishou();
        ob->start_busy( random( 3 ) );
        message_vision( HIY"$N赶紧停手迎战！\n" NOR, ob );
    }

    if ( member_array( ob, enemy ) == -1 ) 
    {
        enemy += ({ ob });
    }

    if ( ob->is_fighting(this_object()) )
    {
        return;
    }

    ob->fight_ob(this_object());
    return;
}

void bihua_ob(object ob)
{
    if ( CHAR_D->forbid_bihua(this_object(), ob) )
    {
        return;
    }

    if ( member_array( ob->query( "id" ), bihua ) == -1 )
    {
        bihua += ({ ob->query( "id" ) });
    }

    delete_temp( "pending/bihua" );
    fight_ob( ob );
}

// This function starts killing between this_object() and ob
void kill_ob(object ob)
{
    object *guards;

    if ( !ob )
    {
        return;
    }

    if ( CHAR_D->forbid_kill(this_object(), ob) )
    {
        return;
    }

    if ( member_array(ob->query("id"), killer) == -1 )
    {
        killer += ({ ob->query("id") });
    }

    tell_object(ob, HIR "看起来" + this_object()->name() + "想杀死你！\n" NOR);

    // If we were protecting the target, cancel the protection.
    if ( ob == query_temp( "guardfor" ) )
    {
        delete_temp("guardfor");
        guards = ob->query_temp("guarded");
        guards -= ({ this_object() });
        ob->set_temp("guarded", guards);
        tell_object(this_object(), HIY "你停止保护" + ob->name() + "。\n" NOR);
        tell_object(ob, HIY + this_object()->name() + "停止保护你。\n" NOR);
    }

    // Check if anyone are is guarding the target, let them join the combat too.
    if ( arrayp(guards = ob->query_temp("guarded")) )
    {
        guards = filter_array(guards, (:
                objectp($1)
            &&    living($1)
            &&    $1 != this_object()
            &&    present($1, environment())
            &&    !is_fighting($1)
            &&    $1->visible(this_object()) :));

        if ( sizeof(guards) > 0 )
        {
            // guards must be added to enemy prior to call guards join the fight
            // thus can prevent infinite loop in the mutual guard case.
            enemy += guards;
            message("vision", HIR + ob->name() + "受到攻击！你挺身加入战团！\n" NOR,
                guards);
            guards->kill_ob(this_object());
        }
    }

    fight_ob(ob);
}

varargs int in_war(object who)
{
    return CHAR_D->in_war(this_object(), who);
}

///////////////////////////////////////////////////////////////////////////
// 战斗对象整理 

void clean_up_duishou()
{
    if ( objectp( duishou ) )
    {
        // 如果我的对手不在我的 environment 中, 或 disable_command 了,
        // 就不认为他是我的对手了.
        if (( environment( duishou ) != environment() ) ||
            !living( duishou ) )
        {
            duishou = 0;
        }
    }
}

void clean_up_enemy()
{
    CHAR_D->clean_up_enemy(this_object());

    if ( sizeof( enemy ) > 0 )
    {
        for ( int i = 0; i < sizeof( enemy ); i++ )
        {
            object ob = enemy[ i ];

            if ( !objectp( ob ) || environment( ob ) != environment() ||
                ( !living( ob ) && !is_killing( ob->query( "id" ) ) ) )
            {
                enemy[ i ] = 0;
                // 我们只需要保证 bihua 中的元素也一定存在于 enemy 中,
                // 事情就会好办些.
                if ( bihua && objectp( ob ) )
                {
                    bihua -= ({ ob->query( "id" ) });
                }
            }
        }
        enemy -= ({ 0 });
    }
}

int remove_duishou(object ob)
{
    if ( duishou && ( ob == duishou ))
    {
        duishou = 0;
        return 1;
    }

    return 0;
}

// Stop fighting ob.
int remove_enemy(object ob)
{
    if ( is_killing( ob->query( "id" ) ) )
    {
        return 0;
    }

    CHAR_D->remove_enemy(this_object(), ob);

    enemy -= ({ ob });
    return 1;
}

// 停止同 ob 的比划
int remove_bihua(object ob)
{
    if ( is_bihuaing( ob->query( "id" ) ) )
    {
        if ( bihua )
        {
            bihua -= ({ ob->query( "id" ) });
        }
        remove_enemy( ob );
        return 1;
    }

    return remove_enemy(ob);
}

// Stop killing ob.
int remove_killer(object ob)
{
    if ( !ob )
    {
        return 0;
    }

    if ( is_killing( ob->query( "id" ) ) )
    {
        killer -= ({ ob->query( "id" ) });
        remove_enemy( ob );
        return 1;
    }

    return remove_enemy(ob);
}

void remove_all_duishou()
{
    if ( objectp( duishou ) )
    {
        duishou->remove_duishou( this_object() );
    }

    duishou = 0;
}

// Stop all fighting, include bihua, but killer remains.
void remove_all_enemy()
{
    for ( int i = 0; i < sizeof( enemy ); i++ )
    {
        // We ask our enemy to stop fight, but not nessessary to confirm
        // if the fight is succeffully stopped, bcz the fight will start
        // again if our enemy keeping call COMBAT_D->fight() on us.
        if ( objectp( enemy[ i ] ) )
        {
            if ( bihua )
            {
                bihua -= ({ enemy[ i ]->query( "id" ) });
            }
            // 为了保证如果 enemy[ i ] 是我的比划对手我们双方停手
            // 但如果需要 bihua 时如果一方停手而另一方不会主动停,
            // 那么可能就要用 remove_enemy 了.
            enemy[ i ]->remove_bihua( this_object() );
            //enemy[ i ]->remove_enemy( this_object() );
        }
        enemy[ i ] = 0;;
    }

    enemy = ({});
}

// Stop all fighting and killing.
void remove_all_killer()
{
    killer = ({});
    enemy -= ({ 0 });

    for ( int i = 0; i < sizeof( enemy ); i++ )
    {
        if ( enemy[ i ] )
        {
            if ( bihua )
            {
                bihua -= ({ enemy[ i ]->query( "id" ) });
            }

            enemy[ i ]->remove_killer( this_object() );
            enemy[ i ] = 0;
        }
    }

    enemy -= ({ 0 });
}

void add_enemy( object ob )
{
    if ( member_array(ob->query("id"), enemy) == -1 )
    {
        enemy += ({ ob->query("id") });
    }
}

void add_killer( object ob )
{
    if ( member_array(ob->query("id"), killer) == -1 )
    {
        killer += ({ ob->query("id") });
    }
}

///////////////////////////////////////////////////////////////////////////
// 战斗进行

// This function checks if the current opponent is available or
// select a new one.
object select_opponent()
{
    int which;

    // 如果有对练的人，我们优先选择他. 理论上我们应该做到
    // 在对练的时候没有人同我在战斗
    if ( duishou )
    {
        return duishou;
    }

    if ( !sizeof( enemy ) )
    {
        return 0;
    }

    which = random( MAX_OPPONENT );

    return which < sizeof( enemy ) ? enemy[ which ] : enemy[ random(sizeof(enemy)) ];
}

// This is called in heart_beat() to perform attack action.
int attack()
{
    object opponent;

    clean_up_duishou();
    clean_up_enemy();

    if ( !living( this_object() ) )
    {
        return 0;
    }

    opponent = select_opponent();
    if ( !objectp( opponent ) )
    {
        return 0;
    }

    set_temp( "last_opponent", opponent );
    //COMBAT_D->fight( this_object(), opponent );
    if ( opponent->is_busy() || !living( opponent ) )
    {
        guarding = 0;
        COMBAT_D->fight_control( this_object(), opponent, AT_QUICK );
    }
    else if ( will_attack() )
    {
        guarding = 0;
        COMBAT_D->fight_control( this_object(), opponent, AT_NORMAL );
    }
/*        else if ( !guarding )
    {
         COMBAT_D->display_guarding_msg( this_object(), opponent );
    }
*/
    guarding++;
    return 1;
}

//
// init() - called by MudOS when another object is moved to us.
//
void init()
{
    COMBAT_D->player_comein(this_object(), this_player());
}

// will attack:
// return if this object will attack in one fight action.
// 1 means will attack, 0 won't.
private int will_attack()
{
    return COMBAT_D->will_attack(this_object());
}

int will_beatback( int type )
{
    return COMBAT_D->will_beatback(this_object(), type);
}

