// vendor.c

#include <dbase.h>
#include <ansi.h>

int buy_object( object me, string what )
{
    mapping goods;
    string ob, *name;
    int i;

    if( stringp( ob = query( "vendor_goods/" + what ) ) )
        return ob->query( "value" );
    goods = query( "vendor_goods" );
    name = keys( goods );
    for ( i = 0; i < sizeof( name ); i ++ )
        if ( goods[ name[ i ] ]->query( "id" ) == what )
            return goods[ name[ i ] ]->query( "value" );
    return 0;
}

void compelete_trade( object me, string what )
{
    mapping goods;
    string ob_file, *name;
    object ob;
    int i;

    if( stringp( ob_file = query( "vendor_goods/" + what ) ) ) 
        ob = new( ob_file );
    else
    {
        goods = query( "vendor_goods");
        name = keys( goods );
        for ( i = 0; i < sizeof( name ); i ++ )
            if ( goods[ name[ i ] ]->query( "id" ) == what ) 
            {
                ob = new( goods[ name[ i ] ] );
                break;
            }
    }
    if ( ob )
    {
        ob->move( me );
        message_vision( "$N向$n买下一" + ob->query( "unit" ) + 
            ob->query( "name" ) + "。\n", me, this_object() );
//        me->eventTaskEnd("buy", ob);
    }
}

string price_string(int v)
{
	int gold_v, silver_v;
	string msg;

	if ( !v ) return "";
	gold_v = v / 10000;
	v -= gold_v*10000;
	silver_v = v / 1000;
	v -= silver_v*1000;
	if ( gold_v ) 
		msg= chinese_number( gold_v) + "两"+YEL "黄金" NOR;
	if ( silver_v ) {
		if ( msg  ) msg = msg + chinese_number( silver_v ) + "两"+WHT "银子" NOR;
		else msg = chinese_number( silver_v ) + "两"+WHT "银子" NOR;
	}
	if ( v ) {
		if ( msg ) 	msg = msg + chinese_number(v)+"文"+YEL "铜钱" NOR;
		else msg = chinese_number(v)+"文"+YEL "铜钱" NOR;
	}
 	return msg;
}

int do_vendor_list(string arg)
{
	mapping goods;
	string list, *name;
	object owner;
	int i;

	if ( !arg || !objectp( owner = present( arg, environment( this_player() ) ) ) )
	{
	    owner = this_object();
	}

	if( !mapp(goods = owner->query( "vendor_goods" ) ) ) 
	    return notify_fail( owner->name() + "不卖东西！\n");

	name = keys( goods );
	list = "你可以向"+owner->query("name")+"购买下列这些东西：\n";
	for( i = 0; i < sizeof( name ); i ++ )
		list += sprintf( "%-40s：%s\n",
			name[ i ] + "(" + goods[ name[ i ] ]->query( "id" ) + ")",
			price_string( goods[ name[ i ] ]->query( "value" ) ) );
	write( list );
	return 1;	
}
