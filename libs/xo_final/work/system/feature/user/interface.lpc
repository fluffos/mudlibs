// /system/feature/user/interface.c
// this is user interface, such as screen..etc.

private nosave int * Screen;

void create()
{
	Screen = ({ 100, 24 });
}

// user interface
int * GetScreen()
{
    return Screen;
}

int *SetScreen(int width, int height)
{
    if (!width || !height)
    {
        return Screen;
    }
    width--;

    if (width * height > __LARGEST_PRINTABLE_STRING__)
    {
        if (width > height)
        {
            width = __LARGEST_PRINTABLE_STRING__ / height;
        }
        else if (height > width)
        {
            height = __LARGEST_PRINTABLE_STRING__ / width;
        }
        else
        {
            width = height = (__LARGEST_PRINTABLE_STRING__ - 1) / 2;
        }
    }

    return (Screen = ({ width, height }));
}

private void window_size(int width, int height)
{
    SetScreen(width,height);
}

