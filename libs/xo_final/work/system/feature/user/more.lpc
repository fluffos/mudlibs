// filename : /feature/more.c

#include <ansi.h>

private nosave string *text;
private nosave int line;
private nosave int fNum = 0;

int query_line() {
  return line;
}

int query_fNum() {
  return fNum;
}

string *query_text() {
  return text;
}

void set_line(int num) {
  line = num;
}

void set_fNum(int num) {
  fNum = num;
}

void set_text(string *value) {
  text = value;
}

void continue_more() {
  input_to("more");
}

void refresh(int height) {
  MORE_D->refresh(this_object(), height);
}

void EndMore() {
  MORE_D->EndMore(this_object());
}

void more(string cmd) {
  MORE_D->more(this_object(), cmd);
}

void start_more(string msg) {
  MORE_D->start_more(this_object(), msg);
}
