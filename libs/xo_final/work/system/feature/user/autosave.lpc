// from xo II 

// checked by lnwm&nerd 1998/01/20

#include <options.h>

int autosave()
{
    int result,last_time;
    object me = this_object();

    if (!me)
    {
        return 0;
    }

    last_time = (int) me->query("last_save_time");
    if ( last_time + AUTO_SAVE_INTERVAL > time() )
    {
        return 1;
    }

    me->set("last_save_time", time());
    if ( userp(me) )
    {
        message("vision", "自动存档。。。。。。。", me );
    }
    result = me->save();

    if ( userp(me) )
    {
        if ( result )
        {
            message("vision","完毕。\n", me );
        }
        else
        {
            message("vision","存储失败。\n", me );
        }
    }

    return 1;
}

