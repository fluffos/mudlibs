// filename : /feature/alias.c

#define MAX_REPEAT         30
#define MAX_ALIASES     40
#define HIS_BUF_SIZE     10    // history buffer size

mapping alias;

private nosave string *history, last_input;
private nosave int last_cmd, repeat_cnt = 0;

string query_last_input() {
  return last_input;
}

void set_last_input(string cmd) {
  last_input = cmd;
}

int query_repeat_cnt() {
  return repeat_cnt;
}

void add_repeat_cnt(int cnt) {
  repeat_cnt += cnt;
}

void set_repeat_cnt(int cnt) {
  repeat_cnt = cnt;
}

string add_cmd_history(string str) {
  int i;

  if (str[0] == '!') {
    if (pointerp(history) && sizeof(history)) {
      if (sscanf(str, "!%d", i)) {
        str = history[(HIS_BUF_SIZE + last_cmd - i) % HIS_BUF_SIZE];
      } else {
        str = history[last_cmd];
      }
    } else {
      return "";
    }
  } else {
    if (!pointerp(history)) {
      history = allocate(HIS_BUF_SIZE);
    }
    last_cmd = (last_cmd + 1) % HIS_BUF_SIZE;
    history[last_cmd] = str;
  }

  return str;
}

string process_input(string str) {
  return ALIAS_D->process_input(this_object(), str);
}

void delete_alias(string verb) {
  if (mapp(alias)) {
    map_delete(alias, verb);
  }
}

void set_alias_real(string verb, string replace) {
  if (!mapp(alias)) {
    alias = ([ verb: replace ]);
  } else {
    alias[verb] = replace;
  }
}

int set_alias(string verb, string replace) {
  return ALIAS_D->set_alias(this_object(), verb, replace);
}

mapping query_all_alias() {
  return alias;
}
