// filename : /feature/autoload.c

#include <autoload.h>

class Item * AutoLoad;

void clean_up_autoload() {
  AutoLoad = 0;
}

class Item * query_autoload() {
  return AutoLoad;
}

void set_autoload(class Item * items) {
  AutoLoad = items;
}

void save_autoload() {
  AUTOLOAD_D->save_autoload(this_object());
}

void restore_autoload() {
  AUTOLOAD_D->restore_autoload(this_object());
}
