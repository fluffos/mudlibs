// filename : /feature/message.c

#include <ansi.h>
#include <dbase.h>
#include <command.h>

#define MAX_MSG_BUF_SIZE        2000

private nosave int html_user = 0;  // 默认不是html用户
private nosave string *msg_buffer = ({});

void receive_message(string msgclass, string msg) {
  string subclass, *ch;
  object this;

  this = this_object();

  if (!CHAR_D->receive_message(this, msgclass, msg)) {
    return;
  }

  if ((in_input(this)) || in_edit(this) && msgclass != "editor") {
    if (sizeof(msg_buffer) < MAX_MSG_BUF_SIZE) {
      msg_buffer += ({ msg });
    }
  } else {
    if (html_user) {
      receive(translate(msg));
    } else {
      receive(msg);
    }
  }
}

string write_prompt() {
  if (sizeof(msg_buffer)) {
    receive(BLU "【输入时暂存讯息】\n" NOR);
    map_array(msg_buffer, (: receive :));
    msg_buffer = ({});
  }

  // AGENTS.md §15ag-style driver-compat note (same root cause as
  // system/feature/user/editor.lpc): this driver build is __OLD_ED__, so
  // query_ed_mode() doesn't exist -- and isn't needed here anyway, since
  // write_prompt() itself is never called by the driver while an OLD_ED
  // session is active (comm.cc's print_prompt() short-circuits straight
  // to ip->prompt for `ip->ed_buffer`-active connections, bypassing
  // APPLY_WRITE_PROMPT entirely). This branch was therefore always dead
  // code under this driver; removed rather than reimplemented.

  if (this_object()) {
    string prompt = CHAR_D->write_prompt(this_object());
    receive(prompt + " ");
    //return prompt ;
  }

  return 0;
}

void receive_snoop(string msg) {
  receive("#" + msg);
}

// www mud suport
int is_html_user() {
  return html_user;
}

int set_html_user(int h) {
  return html_user = h;
}

// 奇怪。 为什么printf打不出来呢？
void force_recv(string msg) {
  receive(msg);
}
