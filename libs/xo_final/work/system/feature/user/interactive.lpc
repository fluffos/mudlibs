// /system/feature/user/interactive.c
// handle interactive events...
#include <user.h>
#include <dbase.h>
#include <room.h>
#include <ansi.h>

protected void user_dump(int type)
{
    INTERACTIVE_D->user_dump(this_object(), type);
}

// net_dead: called by the gamedriver when an interactive player loses
// hir network connection to the mud.
protected void net_dead()
{
    INTERACTIVE_D->net_dead(this_object());
}

// reconnect: called by the LOGIN_D when a netdead player reconnects.
void reconnect()
{
    INTERACTIVE_D->reconnect(this_object());
}

private string GetInvDesc(object env)
{
    return INTERACTIVE_D->GetInvDesc(this_object(), env);
}

// 天哪！看一眼这个世界都要这么多行程序～！
string eventDescribeEnv(object env, int brief)
{
    return INTERACTIVE_D->eventDescribeEnv(this_object(), env, brief);
}

void disable_heart_beat()
{
    set_heart_beat(0);
}

void enable_heart_beat()
{
    set_heart_beat(1);
}

void start_user_dump(int timeout, int status)
{
    call_out("user_dump", timeout, status);
}

void stop_user_dump()
{
    remove_call_out("user_dump");
}

