private nosave function fnCallback;
private nosave string fpFile;
private nosave int flgTemp;

private void create()
{
    flgTemp = 0;
    fnCallback = 0;
}

varargs int edit(function callback, string file)
{
    if ( ! file )
    {
        fpFile = TEMP_DIR + geteuid(this_player()) + sprintf("%d", time());
        flgTemp = 1;  // this is a temp file, rm it after edit.
    }
    else
    {
        fpFile = file;
    }

    fnCallback = callback;
    if ( !wizardp(this_object()) )
    {
        write("输入结束请用 `.'，离开用 `x'，取消输入用 `Q'。\n");
    }

    assure_file(fpFile);
    ed_start( fpFile, !wizardp(this_object()) );
    //write("—————————————————————————————\n");
    //input_to( "input_line", "", callback );

    if ( !wizardp(this_object()) || file_size(fpFile) < 1 )
    {
        ed_cmd( "$a" );
    }

    return 1;
}

string process_input(string str)
{
    int x;

    if ((x = query_ed_mode()) == -1)
    {
        return str;
    }

    if (str && str[0..0] == "!" && strlen(str) > 1)
    {
        return str[1..];
    }

    if ( !x )
    {
        str = ed_cmd(str);
        message("editor", str, this_object());

        if (query_ed_mode() == -1)
        {
            if (functionp(fnCallback))
            {
                string content = read_file ( fpFile );
                if ( flgTemp )
                {
                    rm ( fpFile );
                }
                if (!content)
                {
                    printf("取消.\n");
                }
                else
                {
                    evaluate(fnCallback, content);
                }
            }
            fnCallback = 0;
            fpFile = 0;
            flgTemp = 0;
            return "";
        }

        return "";
    }

    str = ed_cmd(str);
    message("editor", str, this_object());
    return "";
}

