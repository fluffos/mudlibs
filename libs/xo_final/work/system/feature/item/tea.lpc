int do_drink(string arg) {
  int heal, recover, gin, eff_gin, max_gin, remaining;
  object me = this_player();

  heal = 2;
  recover = 3;

  if (arg != "tea" && arg != "cha" && arg != this_object()->query("id")) return 0;

  if (!me->can_act())
    return notify_fail("你上一个动作还没有完成。\n");

  if (me->is_fighting())
    return notify_fail("你在战斗，还是老实一点比较安全。\n");

  if (me->query("water") >= me->max_water_capacity())
    return notify_fail("你已经喝太多了，再也灌不下一滴水了。\n");

  if (!remaining = this_object()->query("remaining"))
    return notify_fail("茶壶已经空了。\n");

  set("value", 0);
  gin = me->query("gin");
  eff_gin = me->query("eff_gin");
  max_gin = me->query("max_gin");
  me->add("water", query("drink_supply"));

  if (remaining > 1) {
    add("remaining", -1);
    message_vision("$N端起茶壶，喝下一口" + query("name") + "。细细品味，只觉得\n" +
      "一股香气直入心脾，$N觉得精神好多了。\n", me);
  } else {
    add("remaining", -1);
    message_vision("$N端起茶壶，把剩下的" + query("name") + "一饮而尽。\n" +
      "一股香气直入心脾，$N觉得精神好多了。\n", me);
    set("long", "一个空茶壶。\n");
    set("name", "茶壶");
    set("unit", "个");
  }
  if ((eff_gin + heal) < max_gin)
    eff_gin += heal;
  else
    eff_gin = max_gin;
  if (gin < eff_gin)
    if ((gin + recover) > eff_gin)
      gin = eff_gin;
    else
      gin += recover;

  me->set("gin", gin);
  me->set("eff_gin", eff_gin);
  return 1;
}
