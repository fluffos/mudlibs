// checked by lnwm&nerd 1998/01/20

#include <action.h>

private nosave class Action * Actions = ({});

class Action * GetActions() {
  if (!Actions)
    return (Actions = ({}));
  else
    return Actions;
}

void AddAction(mixed verbs, object ob, string func) {
  if (!arrayp(verbs)) verbs = ({ verbs });
  foreach (string verb in verbs) {
    class Action Action = new(class Action);
    Action->verb = verb;
    Action->ob = file_name(ob);
    Action->func = func;
    if (!Actions) Actions = ({ Action });
    else Actions += ({ Action });
  }
}

int RemoveAction(string func, string verb) {
  return 0;
}
mixed *FilterAction() {
  return filter(map(GetActions(), function(class Action Action)
    {
      object obj;
      if ((obj = find_object(Action->ob)) &&
        (present(obj, this_object()) ||
          present(obj, environment(this_object()))))
        return Action;
      else
        return 0;
    }), (: $1 :));
}

class Action FindAction(string verb) {
  foreach (class Action Action in GetActions())
    if (Action->verb == verb)
      return Action;
  return 0;
}

int eventAct(class Action Action, string arg) {
  if (find_object(Action->ob))
    return call_other(Action->ob, Action->func, arg);
  return 0;
}
