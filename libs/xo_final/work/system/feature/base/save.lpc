// filename : /feature/save.c

int save() {
  string file;

  file = this_object()->query_save_file();
  if (stringp(file)) {
    assure_file(file + __SAVE_EXTENSION__);
    return save_object(file);
  }
  return 0;
}

int restore() {
  string file;

  file = this_object()->query_save_file();
  if (stringp(file)) {
    return restore_object(file);
  }
  return 0;
}
