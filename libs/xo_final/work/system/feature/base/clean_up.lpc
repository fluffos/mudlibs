// checked by lnwm&nerd 1998/01/20
private nosave int m_no_clean = 0;

int set_no_clean(int val) {
  return (m_no_clean = val);
}

int get_no_clean() {
  return m_no_clean;
}

int clean_up() {
  if (!CLEANUP_D->clean_up(this_object())) {
    return 1;
  }

  destruct(this_object());
  return 0;
}
