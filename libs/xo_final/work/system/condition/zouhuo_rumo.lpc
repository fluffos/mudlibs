// zouhuo_rumo.c
#include <condition.h>

inherit F_CLEAN_UP;

int update_condition(object me, int duration) {
  if (!duration) {
    me->delete("recover_force");
    me->delete("can_recover_max_force");
    return 0;
  }

  me->set("can_recover_max_force", 1);
  me->apply_condition("zouhuo_rumo", duration - 1);
  return CND_CONTINUE;
}
