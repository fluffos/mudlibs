// jinchuang-yao.c
#include <ansi.h>
#include <condition.h>

inherit F_CLEAN_UP;

int update_condition(object me, int duration)
{
    if ( !duration )
    {
        return 0;
    }

    if ( (int)me->query("eff_kee") < (int)me->query("max_kee") )
    {
        me->receive_curing("kee", 50);
    }

    if ( (int)me->query("eff_sen") < (int)me->query("max_sen") )
    {
        me->receive_curing("sen", 50);
    }

    if ( (int)me->query("eff_gin") < (int)me->query("max_gin") )
    {
        me->receive_curing("gin", 50);
    }
    
    if ( duration == 1)
    {
        tell_object(me, "你伤口上敷的金创药药性已经快发挥完了\n");
    }

    me->apply_condition("jin-chuangyao", duration - 1);
    return CND_CONTINUE;
}

