// kill_government.c
// 这是对于官府这一特殊的“门派”所设的追杀令，非城市所用也，如果用了这个
//condition，就是天下一起捕了。。。。。。可怕
#include <condition.h>

inherit F_CLEAN_UP;

int update_condition(object me, int duration) {
  object env = environment(me);

  if (!duration) {
    return 0;
  }

  me->apply_condition("kill_government", duration - 1);

  if ((duration % 10) == 0 && env->query_roomtype() == "city") {
    tell_object(me, "朝廷正发下海捕文书，四处捉拿你......\n");
  }

  return CND_CONTINUE;
}
