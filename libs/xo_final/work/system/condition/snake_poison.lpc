// snake_poison.c

#include <ansi.h>
#include <condition.h>

int update_condition(object me, int duration)
{
    if ( duration < 1 )
    {
        return 0;
    }

    me->receive_wound("kee", 100);
    me->receive_damage("sen", 100);
    me->apply_condition("snake_poison", duration - 1);
    tell_object(me, HIG "你中的蛇毒发作了！\n" NOR );
    return CND_CONTINUE;
}

