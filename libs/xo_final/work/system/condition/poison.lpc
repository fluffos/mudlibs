// poison.c

#include <condition.h>

int update_condition(object me, mapping info) {
  if (!mapp(info)) {
    return 0;
  }

  me->receive_damage("kee", info["damage"]);
  me->receive_wound("kee", info["damage"] / 2);

  info["duration"]--;
  if (info["duration"] < 1) {
    return 0;
  }

  me->apply_condition("poison", info);
  tell_object(me, info["message"]);

  return CND_CONTINUE;
}
