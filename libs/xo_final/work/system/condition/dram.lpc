// dram.c
// By seagate
// 药物的反作用

#include <ansi.h>
#include <condition.h>

int update_condition(object me, int duration)
{
    if ( duration < 1 )
    {
        return 0;
    }

    me->receive_damage("kee", 3);
    me->apply_condition("dram", duration - 1);
    tell_object(me,  HIY"你服的药发生轻微的副作用！\n" NOR );
    return CND_CONTINUE;
}

