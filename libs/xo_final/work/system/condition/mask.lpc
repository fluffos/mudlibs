#include <ansi.h>
#include <condition.h>
#include <dbase.h>

inherit F_CLEAN_UP;

int update_condition(object me, int duration) {
  if (!me->query_temp_marks("apply")) {
    return 0;
  }
  //    message_vision(HIW "$N易容中... \n" NOR , me);

  if (duration < 1) {
    if (!me->query_temp_marks("apply")) {
      return 0;
    }

    message_vision(CYN "易容术失效了.\n" NOR, me);
    me->delete_temp_marks("apply");
    return 0;
  }

  me->apply_condition("mask", duration - 1);
  return CND_CONTINUE;
}
