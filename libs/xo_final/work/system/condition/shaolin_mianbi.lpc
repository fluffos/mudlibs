// shaolin_mianbi.c  面壁的惩罚
// Hydra created 19980517
#include <ansi.h>
#include <login.h>
#include <condition.h>

int update_condition(object me, int duration)
{
    if ( duration < 1 )
    {
        me->move("/d/menpai/shaolin/mianbi_exit");
        message_vision(HIY "只听一阵脚步声响，$N跟着护卫僧走过来。\n" NOR, me);
        tell_object(me, HIY "一个护卫僧打开石门，把你带了出来。\n" NOR);
        me->set("startroom", "/d/menpai/shaolin/mianbi_exit");
        return 0;
    }

    me->apply_condition("shaolin_mianbi", duration - 1);
    return CND_CONTINUE;
}

