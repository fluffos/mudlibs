// kill_west_wuliang.c
#include <condition.h>

inherit F_CLEAN_UP;

int update_condition(object me, int duration)
{
    if( !duration )
    {
        write("由于时日长久，无量剑派西宗已经放弃了对你的追杀。\n");
        return 0;
    }

    me->apply_condition("kill_west_wuliang", duration - 1);
    return CND_CONTINUE;
}

