// healing.c

#include <ansi.h>
#include <condition.h>

inherit F_CLEAN_UP;

int update_condition(object me, int duration)
{
    if ( !duration )
    {
        return 0;
    }

    if ( (int)me->query("eff_kee") >= (int)me->query("max_kee") )
    {
        tell_object( me, HIW "你的伤势已经完全痊愈了！\n" NOR );
        return 0;
    }
    else
    {
        me->receive_curing("kee", 5 + random(5) );
        tell_object( me, GRN "你感到你的伤势大有好转....\n" NOR );
    }

    me->apply_condition("healing", duration - 1);
    return CND_CONTINUE;
}

