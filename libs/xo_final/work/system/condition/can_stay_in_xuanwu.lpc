// can_stay_in_xuanwu.c
#include <condition.h>

inherit F_CLEAN_UP;

int update_condition(object me, int duration) {
  if (!duration) {
    return 0;
  }

  if (duration <= 2) {
    tell_object(me, "你在玄武堂学艺的时限已经到了，得赶快走了。\n");
  }

  me->apply_condition("can_stay_in_xuanwu", duration - 1);
  return CND_CONTINUE;
}
