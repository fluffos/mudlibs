// general.c
// by Seagate
// 药物的反作用

#include <ansi.h>
#include <condition.h>

int update_condition(object me, int duration) {
  if (duration < 1) {
    return 0;
  }

  me->receive_damage("kee", 7);
  me->apply_condition("general", duration - 1);
  tell_object(me, HIG "你服的药发生一般的副作用！\n" NOR);
  return CND_CONTINUE;
}
