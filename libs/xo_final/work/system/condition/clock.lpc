// clock.c
#include <condition.h>

inherit F_CLEAN_UP;

int update_condition(object me, mapping info)
{
    if ( mapp( info ) )
    {
        info = filter( map( info, function( mixed key, mapping map, object me)
            {
                int dur;

                dur = -- map[ "duration" ];
                if ( dur <= map[ "warning_time" ] )
                tell_object( me, map[ "warning_msg" ] );
                if ( dur ) return map;
                else return 0;
            }, me ), (: $2 : ) );
    }

    if ( sizeof( info ) )
    {
        me->apply_condition("clock", info);
        return CND_CONTINUE;
    }

    return 0;
}

