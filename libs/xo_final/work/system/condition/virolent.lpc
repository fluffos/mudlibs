// virolent.c
// by Seagate
// 药物的反作用

#include <ansi.h>
#include <condition.h>

int update_condition(object me, int duration)
{
    if ( duration < 1 )
    {
        return 0;
    }

    me->receive_damage("kee", 15);
    me->apply_condition("virolent", duration - 1);
    tell_object(me,  HIB"你服的药发生了严重的副作用！\n" NOR );

    return CND_CONTINUE;
}

