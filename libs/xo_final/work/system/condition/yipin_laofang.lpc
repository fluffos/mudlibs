// yipin_laogang.c
// by lnwm 1997-12-21
// 被捕入狱要放的。

#include <ansi.h>
#include <condition.h>
#include <dbase.h>

inherit F_CLEAN_UP;

int update_condition(object me, int duration)
{
    if ( environment( me )->query("short") != "牢房" )
    {
        return 0;
    }

    if ( duration < 1 ) 
    {
        message_vision(HIY"只听见“咣当”一声，一个黑衣卫士打开了牢门，对$N说道：\n"
                "小子，真是福大命大，没死在这儿，现在你可以走了。\n"NOR, me);
        message_vision(RED"黑衣卫士接着奸笑着，不能让这小子便宜走了。\n说着从口袋里拿出一块手帕往$N鼻子上一盖。\n"NOR, me);
        tell_object( me , "你只觉一阵甜香入鼻，然后就丧失了意识，丧失意识之前，\n"
                          "你最后看到的情形是一块黑布将你的头蒙了起来。\n" );
        me->unconcious();
        me->move("/d/zuzhi/yipin_tang/xuanwu_tang/x_x5" );
        return 0;
    }

    me->apply_condition("yipin_laofang", duration - 1);
    return CND_CONTINUE;
}

