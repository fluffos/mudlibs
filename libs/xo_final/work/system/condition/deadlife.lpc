// deadlife.c

#include <ansi.h>
#include <condition.h>

inherit F_CLEAN_UP;

int update_condition(object me, int duration) {
  if (me->query_condition("dis_deadlife")) {
    return 0;
  }

  if (me->query("eff_gin") > 50) {
    me->receive_wound("gin", 50);
  } else {
    me->set("gin", 5);
    me->set("eff_gin", 5);
  }

  if (me->query("eff_kee") > 50) {
    me->receive_wound("kee", 50);
  } else {
    me->set("kee", 10);
    me->set("eff_kee", 10);
  }

  if (me->query("eff_sen") > 50) {
    me->receive_wound("sen", 50);
  } else {
    me->set("sen", 5);
    me->set("eff_sen", 5);
  }

  tell_object(me, HIR "你身上的生死符发作了！\n" NOR);
  return CND_CONTINUE;
}
