// miyao.c 迷药!!慎之,慎之!
//by leonhart

#include <ansi.h>
#include <condition.h>

inherit F_CLEAN_UP;

int update_condition(object me, int duration) {
  if (duration < 1) {
    return 0;
  }

  me->disable_command("verb", "你只感到浑身无力，连抬抬胳膊的力气都没有了。\n");
  me->apply_condition("miyao", duration - 1);
  message_vision(HIW "$N浑身乏力，似乎是中了某种迷药了！\n" NOR, me);
  return CND_CONTINUE;
}
