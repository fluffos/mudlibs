//  yipin.c   一品堂

inherit ZUZHI;

string *zhiwu = ({
  "玄武堂",
  "玄阳堂",
  "玄才堂",
  "玄云堂",
});

string *touxian1 = ({
  "徒众",
  "杀手",
  "杀手统领",
  "指挥使",
  "副总管",
  "总管",
  "总堂副总管",
  "护国都尉",
  "护国将军",
  "护国大将军",
});

string *touxian2 = ({
  "徒众",
  "细作",
  "细作统领",
  "指挥使",
  "副总管",
  "总管",
  "总堂副总管",
  "护国参议",
  "护国军师",
  "护国公",
});

//这实际上是一个象familyd一样的关系表，记录了这个组织不接收的别派和其他组织的名单.
string *refusedzuzhi = ({
  "jinjun",
});

string *refusedfamily = ({
});

string QueryName(object who) {
  return "一品堂";
}

string QueryId(object who) {
  return "yipin";
}

string *QueryTouxian(object who) {
  //tell_object( who,"yipin say: hello!\n");
  if (who->ZuzhiZhiwu("yipin") == "玄阳堂") {
    return touxian1;
  }

  if (who->ZuzhiZhiwu("yipin") == "玄才堂") {
    return touxian2;
  }

  return touxian1;
}

string *QueryZhiwu(object who) {
  return zhiwu;
}

string *RefusedZuzhi(object who) {
  return refusedzuzhi;
}

string *RefusedFamily(object who) {
  return refusedfamily;
}
