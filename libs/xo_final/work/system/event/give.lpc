// EVENT_GIVE
// for xo lib 2
// object that can be given to others should inherit this.
// by nerd 2001/10/12

// give somebody something
mixed indirect_give_liv_obj(object target)
{
//    mixed tmp;

    if (environment() != this_player())
    {
        return "#这东西不是你的。";
    }
//    tmp = CanDrop(this_player());
    if (tmp != 1)
    {
        return (tmp || "你不能把你的" + GetDefiniteShort() + "给出去.");
    }
    tmp = target->CanCarry(GetMass());
    if (tmp != 1)
    {
        return (tmp || GetDefiniteShort() + "太重了.");
    }
    return 1;
}

// give something to somebody
// 这时候还没有后一个参数，liv，就是不知道对象。
mixed direct_give_obj_to_liv()
{
    mixed tmp;

    if (environment() != this_player())
    {
        return "#这东西不是你的。";
    }
    tmp = CanDrop(this_player());
    if (tmp != 1)
    {
        return (tmp || "你不能把你的" + GetDefiniteShort() + "给别人.");
    }
    return 1;
}

