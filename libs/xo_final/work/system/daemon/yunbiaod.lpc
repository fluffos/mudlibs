mixed give_quest(object who, object player) {
  int time;
  object biaoche;
  mapping biao;

  if (player->query_xiuwei("dodge") < 300) {
    return "运镖可是件危险的差使，还是练好了功夫再来吧！";
  }

  if (player->query_temp("quest_yunbiao/have_task")) {
    return "你上次的镖还没送到呢，怎么又来了？";
  }

  /*
    if ( player->query_temp("quest_yunbiao/finished_time" )
        && (time() - player->query_temp("quest_yunbiao/finished_time")) < 20 )
    {
        return RANK_D->query_respect(me) + "辛苦了，现在没有镖车要运，过会再来吧！\n";
    }
*/

  if (mapp(player->query_temp("quest_yunbiao"))) {
    if (player->query_temp("quest_yunbiao/status") == "missed"
      && (time() - player->query_temp("quest_yunbiao/finished_time")) < 120) {
      return "你把我的镖弄哪里去啦？不是被人劫了吧？";
    }

    if (player->query_temp("quest_yunbiao/status") == "timeout"
      && (time() - player->query_temp("quest_yunbiao/finished_time")) < 60) {
      return "你把我的镖弄哪里去啦？不是被弄丢了吧？";
    }

    if (!player->query_temp("quest_yunbiao/finished_time")
      && (time() - player->query_temp("quest_yunbiao/start_time")) < 120) {
      return "你把我的镖弄哪里去啦？不是被私吞了吧？";
    }
  }

  biao = yun_biao[random(sizeof(yun_biao))];
  time = biao["time"];

  player->delete_temp("quest_yunbiao");
  player->set_temp("quest_yunbiao/name", biao["name"]);
  player->set_temp("quest_yunbiao/file", biao["file"]);
  player->set_temp("quest_yunbiao/bonus", biao["bonus"]);
  player->set_temp("quest_yunbiao/time", biao["time"]);
  player->set_temp("quest_yunbiao/start_time", time());
  player->set_temp("quest_yunbiao/have_task", 1);

  biaoche = new("/quest/yunbiao/biaoche");
  biaoche->set_name(HIW "镖车" NOR, ({ player->query("id") + "'s biao che", "cart", "che" }));
  biaoche->set("time", time);
  biaoche->set("file", biao["file"]);
  biaoche->start_escape_me();
  biaoche->set("owner", player->query("id"));
  biaoche->set("owner_name", player->query("name"));
  biaoche->move(environment(player));

  /*
     message("channel:rumor",HIM"【镖局传闻】"+query("name", me)+
         "即将护送镖车起程前往" + biao["name"] + "！\n" NOR,
         users());  
    */

  /*delete_temp("apply/short", me);
    me->set_temp("apply/short",
        ({HIM"福威镖局镖头"NOR+me->name()+"("+query("id", me)+")"}));*/

  message_sort(HIM "$N" HIM "对$n" HIM "吩咐道：请在" + time_string(time) + "内，将镖车运送到" +
    biao["name"] + "。一路多加小心，你还是趁早上路吧！\n" NOR, who, player);

  return 1;
}
