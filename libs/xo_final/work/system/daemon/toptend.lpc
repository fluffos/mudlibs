#include <ansi.h>

#define AGE_B "年龄"
#define PKER_B "杀人数"
#define ZONGGANG_B "总纲"
#define UNARMED_B "拳法"
#define DODGE_B "轻功"
#define SWORD_B "剑法"
#define BLADE_B "刀法"
#define SHORT_B "短兵刃"
#define FORCE_B "内功"
#define LONG_B "长兵刃"
#define EXP_B "经验"
#define MONEY_B "钱财"

void topten_checkplayer(object);
int get_all_data(object, string);
int topten_del(string, string);
int topten_add(object, string);
int topten_save(string, string, string);
string topten_query(string);
#define TOPTEN_AGE "/data/topten/age"
#define TOPTEN_LONG "/data/topten/long"
#define TOPTEN_PKER "/data/topten/pker"
#define TOPTEN_ZONGGANG "/data/topten/zonggang"
#define TOPTEN_UNARMED "/data/topten/unarmed"
#define TOPTEN_DODGE "/data/topten/dodge"
#define TOPTEN_SWORD "/data/topten/sword"
#define TOPTEN_BLADE "/data/topten/blade"
#define TOPTEN_MONEY "/data/topten/money"
#define TOPTEN_SHORT "/data/topten/short"
#define TOPTEN_EXP "/data/topten/exp"
#define TOPTEN_FORCE "/data/topten/force"

void create() {
  seteuid(getuid());
}
void topten_checkplayer(object player) {
  if (!wizardp(player)) {
    topten_add(player, "age");
    topten_add(player, "pker");
    topten_add(player, "long");
    topten_add(player, "force");
    topten_add(player, "unarmed");
    topten_add(player, "dodge");
    topten_add(player, "blade");
    topten_add(player, "sword");
    topten_add(player, "exp");
    topten_add(player, "money");
    topten_add(player, "zonggang");
    topten_add(player, "short");
  }
  return;
}

int topten_save(string f_name, string b_name, string str) {
  string *astr;
  int i;
  astr = explode(str, "\n");
  str = "";
  for (i = 0; i < sizeof(astr) && i < 10; i++)
    str += astr[i] + "\n";
  if (!write_file(f_name, str, 1)) {
    return notify_fail("无法写文件" + f_name + "，权限不够!不能更新" + b_name + "!\n");
  }
  return 1;
}

string topten_query(string type) {
  string b_name, f_name, str, *astr, *bstr, name, data;
  int i, j;
  switch (type) {
    case "age":
      b_name = AGE_B;
      f_name = TOPTEN_AGE;
      break;
    case "long":
      b_name = LONG_B;
      f_name = TOPTEN_LONG;
      break;
    case "pker":
      b_name = PKER_B;
      f_name = TOPTEN_PKER;
      break;
    case "force":
      b_name = FORCE_B;
      f_name = TOPTEN_FORCE;
      break;
    case "unarmed":
      b_name = UNARMED_B;
      f_name = TOPTEN_UNARMED;
      break;
    case "dodge":
      b_name = DODGE_B;
      f_name = TOPTEN_DODGE;
      break;
    case "sword":
      b_name = SWORD_B;
      f_name = TOPTEN_SWORD;
      break;
    case "blade":
      b_name = BLADE_B;
      f_name = TOPTEN_BLADE;
      break;
    case "money":
      b_name = MONEY_B;
      f_name = TOPTEN_MONEY;
      break;
    case "short":
      b_name = SHORT_B;
      f_name = TOPTEN_SHORT;
      break;
    case "zonggang":
      b_name = ZONGGANG_B;
      f_name = TOPTEN_ZONGGANG;
      break;
    case "exp":
      b_name = EXP_B;
      f_name = TOPTEN_EXP;

      break;
    default:
      return "没有" + type + "这种排行榜！\n";
  }
  if (file_size(f_name) == -1)
    return b_name + "的数据文件还没有创建！\n";
  astr = explode(read_file(f_name), "\n");
  str = "";
  for (i = 0; i < sizeof(astr); i++) {
    bstr = explode(astr[i], ".");
    str += "\t" + "\t" HIC "排行第" + chinese_number(i + 1) + "：" HIW;
    for (j = 0; j < sizeof(bstr); j++) {
      data = explode(bstr[j], ")")[1];
      name = replace_string(bstr[j], data, "");
      str += name + "\t";
    }

    str += "\n" NOR;

  }
  return str;
}
int get_all_data(object player, string type) {
  int total;
  switch (type) {
    case "age":
      total = (int)player->query("mud_age");
      break;
    case "long":
      total = (int)player->query_xiuwei_by_type("long");
      break;
    case "pker":
      total = (int)player->query("PKS");
      break;
    case "force":
      total = ((int)player->query("max_force") + 1000 * (int)player->query_xiuwei_by_type("force")) / 2;
      break;
    case "unarmed":
      total = (int)player->query_xiuwei_by_type("unarmed");
      break;
    case "dodge":
      total = (int)player->query_xiuwei_by_type("dodge");
      break;
    case "sword":
      total = (int)player->query_xiuwei_by_type("sword");
      break;
    case "blade":
      total = (int)player->query_xiuwei_by_type("blade");
      break;
    case "zonggang":
      total = (int)player->query_xiuwei_by_type("zonggang");
      break;
    case "short":
      total = (int)player->query_xiuwei_by_type("short");
      break;
    case "money":
      total = (int)player->query("savemoney");
      break;
    case "exp":
      total = (int)player->query("combat_exp");
      break;
    default:
      total = -1;  //用-1标志类型出错！
  }
  return total;
}

int topten_del(string pid, string type) {
  string str, *astr, *bstr, b_name, f_name;
  int i, j, k;
  switch (type) {
    case "age":
      b_name = AGE_B;
      f_name = TOPTEN_AGE;
      break;
    case "long":
      b_name = LONG_B;
      f_name = TOPTEN_LONG;
      break;
    case "pker":
      b_name = PKER_B;
      f_name = TOPTEN_PKER;
      break;
    case "force":
      b_name = FORCE_B;
      f_name = TOPTEN_FORCE;
      break;
    case "unarmed":
      b_name = UNARMED_B;
      f_name = TOPTEN_UNARMED;
      break;
    case "dodge":
      b_name = DODGE_B;
      f_name = TOPTEN_DODGE;
      break;
    case "sword":
      b_name = SWORD_B;
      f_name = TOPTEN_SWORD;
      break;
    case "blade":
      b_name = BLADE_B;
      f_name = TOPTEN_BLADE;
      break;
    case "short":
      b_name = SHORT_B;
      f_name = TOPTEN_SHORT;
      break;
    case "zonggang":
      b_name = ZONGGANG_B;
      f_name = TOPTEN_ZONGGANG;
      break;
    case "money":
      b_name = MONEY_B;
      f_name = TOPTEN_MONEY;
      break;
    case "exp":
      b_name = EXP_B;
      f_name = TOPTEN_EXP;
      break;
    default:
      return notify_fail("没有" + type + "这种排行榜！\n");
  }
  if (file_size(f_name) == -1)
    return notify_fail(b_name + "还没有创建！\n");
  str = read_file(f_name);
  astr = explode(str, "\n");
  for (i = 0; i < sizeof(astr); i++) {
    if (strsrch(astr[i], pid) != -1)  //该行包括id则为真
    {
      if (strsrch(astr[i], ".") == -1)  //为真表示该行只有一个id，即pid
      {
        str = "";
        for (j = 0; j < sizeof(astr); j++)
          if (j != i)
            str += astr[j] + "\n";
        return topten_save(f_name, b_name, str);
      } else {
        bstr = explode(astr[i], ".");
        for (j = 0; j < sizeof(bstr); j++)
          if (strsrch(bstr[j], pid) != -1)  //说明该项即pid,应该去除
          {
            astr[i] = "";
            for (k = 0; k < sizeof(bstr); k++)
              if (k != j) {
                if ((k + 1) != sizeof(bstr)
                  && !((j + 1) == sizeof(bstr) && j == (k + 1))
                )
                  astr[i] += bstr[k] + ".";
                else
                  astr[i] += bstr[k];
              }
            //本来去除后j的循环应该停止,但是不影响结果
          }
        str = implode(astr, "\n");
        return topten_save(f_name, b_name, str);
      }
    }
  }
  return 1;
}

int topten_add(object player, string type) {
  string str, b_name, f_name;
  string *astr;
  int i, j, data;
  if ((string)SECURITY_D->get_status(player) != "(player)")
    return 0;
  if (wizardp(player))
    return 0;
  switch (type) {
    case "age":
      b_name = AGE_B;
      f_name = TOPTEN_AGE;
      break;
    case "long":
      b_name = LONG_B;
      f_name = TOPTEN_LONG;
      break;
    case "pker":
      b_name = PKER_B;
      f_name = TOPTEN_PKER;
      break;
    case "force":
      b_name = FORCE_B;
      f_name = TOPTEN_FORCE;
      break;
    case "unarmed":
      b_name = UNARMED_B;
      f_name = TOPTEN_UNARMED;
      break;
    case "dodge":
      b_name = DODGE_B;
      f_name = TOPTEN_DODGE;
      break;
    case "sword":
      b_name = SWORD_B;
      f_name = TOPTEN_SWORD;
      break;
    case "blade":
      b_name = BLADE_B;
      f_name = TOPTEN_BLADE;
      break;
    case "short":
      b_name = SHORT_B;
      f_name = TOPTEN_SHORT;
      break;
    case "zonggang":
      b_name = ZONGGANG_B;
      f_name = TOPTEN_ZONGGANG;
      break;
    case "money":
      b_name = MONEY_B;
      f_name = TOPTEN_MONEY;
      break;
    case "exp":
      b_name = EXP_B;
      f_name = TOPTEN_EXP;
      break;
    default:
      return notify_fail("没有" + type + "这种排行榜！\n");
  }
  if (!objectp(player) || !userp(player))
    return 0;
  if (file_size(f_name) == 0) {
    str = player->query("name") + "(" + player->query("id") + ")" + get_all_data(player, type);
    return topten_save(f_name, b_name, str);
  }
  //主要程序！
  if (get_all_data(player, type) == -1)
    return notify_fail("数据查询错误，可能是查询类型错误！\n");
  //应该先排除该player的id!
  topten_del(player->query("id"), type);
  str = read_file(f_name);
  astr = explode(str, "\n");

  i = 0;
  while (i < sizeof(astr)) {
    str = "";
    sscanf(explode((explode(astr[i], ".")[0]), ")")[1], "%d", data);
    if (data < (int)get_all_data(player, type)) {
      //单独加入，暂时没考虑人数超过十行！
      for (j = 0; j < sizeof(astr); j++) {
        if (j == i)
          str += player->query("name") + "(" + player->query("id") + ")" + get_all_data(
            player,
            type
          ) + "\n";
        str += astr[j] + "\n";
      }
      return topten_save(f_name, b_name, str);
    } else if (data == (int)get_all_data(player, type)) {
      //并排加入
      for (j = 0; j < sizeof(astr); j++) {
        if (j == i)
          str += astr[j] + "." + player->query("name") + "(" + player->query("id") + ")" + get_all_data(
            player,
            type
          ) + "\n";
        else
          str += astr[j] + "\n";
      }
      return topten_save(f_name, b_name, str);
    }
    i++;
  }
  if (sizeof(astr) < 20) {
    str = implode(
      astr,
      "\n"
    ) + "\n" + player->query("name") + "(" + player->query("id") + ")" + get_all_data(player, type);
    return topten_save(f_name, b_name, str);
  }
  return 0;
}
