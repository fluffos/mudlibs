#include <ansi.h>

void refresh(object who, int height)
{
    int i;
    int line = who->query_line();
    string *text = who->query_text();
    int fNum = who->query_fNum();

    for (i = line + height; line < sizeof(text) && line < i; line ++ )
    {
        if ( fNum )
        {
            tell_object(who, sprintf("%4d ", line + 1));
        }

        tell_object(who, color_filter(sprintf( "%s\n", text[line] )));
    }

    who->set_line(line);
}

void EndMore(object who)
{
    who->set_line(0);
    who->set_fNum(0);
    who->set_text(0);
}

void more(object who, string cmd)
{
    int i;
    int height = who->GetScreen()[1];
    int line = who->query_line();
    string *text = who->query_text();
    int fNum = who->query_fNum();

    if ( !height )
    {
        height = 24;
    }
    height --;

    switch ( cmd )
    {
        case "":
            refresh(who, height);
            line = who->query_line();
            if ( line >= sizeof( text ) )
            {
                EndMore(who);
                return;
            }
            break;

        case "b":
            line = line - height *2;
            who->set_line(line);
            if ( line < 0 )
            {
                EndMore(who);
                return;
            }
            refresh(who, height);
            line = who->query_line();
            break;

        case "n":
            if ( wizardp(who) )
            {
                fNum = !fNum;
                who->set_fNum(fNum);
                line -= height;
                if (line < 0)
                {
                    line = 0;
                }
                who->set_line(line);
            }
            refresh(who, height);
            line = who->query_line();
            break;

        case "q":
            EndMore(who);
            return;
        
        default:
            if ( wizardp(who) )
            {
                if( sscanf(cmd, "g %d", i) == 1 )
                {
                    if ( i < 0 || i > sizeof (text) )
                    {
                        tell_object(who, sprintf("行号超出范围。最大为：%d。\n",sizeof(text) + 1));
                    }
                    else
                    {
                        line = i - height / 2;
                        if ( line < 0 )
                        {
                            line = 0;
                        }
                        who->set_line(line);
                        refresh (who, height);
                        line = who->query_line();
                    }
                }
            }
    }

    tell_object(who, sprintf( BBLU " == 下面还有哦 " YEL "%d%%" NOR BBLU
            " == (ENTER 下一页，q 离开，b 上一页 )" NOR,
            ( who->query_line() * 100 / sizeof( text ) ) ));
    who->continue_more();
}

void start_more(object who, string msg)
{
    who->set_line(0);
    who->set_text(explode (msg, "\n" ));

    more( who, "" ); //, explode( msg, "\n" ), 0 );
}

