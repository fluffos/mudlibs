void delay_quest(object player, object master);
int do_done(object player, object master);

mixed query_quest_marks(object who, string mark) {
  return who->query("newquest/" + mark);
}

void set_quest_marks(object who, string mark, mixed value) {
  who->set("newquest/" + mark, value);
}

void delete_quest_marks(object who, string mark) {
  who->delete("newquest/" + mark);
}

int give_quest(object player, object master) {
  if (!master->is_tongmen_of(player) && !player->is_manmade_npc()) {
    return 0;
  }

  message_vision("$N对$n说道：" + RANK_D->query_respect(master) + "“最近可有缺什么物件?”\n", player, master);

  set_quest_marks(player, "start_time", time());
  set_quest_marks(player, "result", "wait");
  delete_quest_marks(player, "level");
  delete_quest_marks(player, "where");

  call_out("give_quest_msg", 1, player, master);

  return 1;
}

void give_quest_msg(object player, object master) {
  int index = random(sizeof(my_quests));

  if (!player || !master || environment(player) != environment(master)) {
    return;
  }

  set_quest_marks(player, "kind", "找");
  set_quest_marks(player, "master", master->query("id"));
  set_quest_marks(player, "master_name", master->query("name"));
  set_quest_marks(player, "finish_time", 0);
  set_quest_marks(player, "target", my_quests[index]["quest"]["target"]);
  set_quest_marks(player, "bonus", my_quests[index]["quest"]["bonus"]);
  if (my_quests[index]["time"]) {
    set_quest_marks(player, "time", time() + my_quests[index]["time"]);
  } else {
    set_quest_marks(player, "time", time() + 900);
  }
  set_quest_marks(player, "cd_time", time() + 60);
  set_quest_marks(player, "result", "wait");

  tell_object(
    player,
    sprintf(my_quests[index]["msg"], master->query("name"), my_quests[index]["quest"]["target"])
  );
  tell_object(
    player,
    "你有" + HIY + time_string(query_quest_marks(player, "time") - time()) + NOR + "来完成这个任务。\n"
  );
}

int accept_quest_object(object player, object master, object obj) {
  if (master->query("id") != query_quest_marks(player, "master")) {
    if (master->query("new_master")) {
      tell_object(player, master->query("name") + "疑惑的看着你说：我有给你任务吗？\n");
    }
    return 0;
  }

  if ("找" != query_quest_marks(player, "kind") || "wait" != query_quest_marks(player, "result")) {
    tell_object(player, master->query("name") + "疑惑的看着你说：我有给你任务吗？\n");
    return 0;
  }

  if (!query_quest_marks(player, "bonus") ||
    obj->name() != query_quest_marks(player, "target")) {
    tell_object(player, master->query("name") + "疑惑的看着你说：这个不是我让你取的啊？做事要认真点啊。\n");
    return 0;
  }

  if (query_quest_marks(player, "time") && (query_quest_marks(player, "time") < time())) {
    delay_quest(player, master);
  } else {
    set_quest_marks(player, "result", "accomplish");
    do_done(player, master);
  }

  call_out("destruct_mo_object", 1, obj);
  return 1;
}

void destruct_mo_object(object obj) {
  if (obj) {
    destruct(obj);
  }
}

void delay_quest(object player, object master) {
  message_vision("$N白了$n一眼道：“怎么这样磨蹭，这么久才回来！我真是看错了人。”\n", master, player);

  //延迟完成任务，奖励减半
  set_quest_marks(player, "bonus", query_quest_marks(player, "bonus") / 2);
  set_quest_marks(player, "result", "accomplish");

  do_done(player, master);

  set_quest_marks(player, "result", "delay");
  set_quest_marks(player, "cd_time", time() + 10);
}

int do_quest(object player, object master, string arg) {
  int tt;
  int max_xiuwei;

  if (!arg || !master->id(arg)) {
    return 0;
  }

  if (master->is_tongmen_of(player) && master->have_family_quest(player)) {
    tell_object(player, "我不是已经给你任务了吗，快快起程。\n");
    master->family_quest(player);
    return 1;
  }

  if ("wait" == query_quest_marks(player, "result")) {
    if (query_quest_marks(
      player,
      "master"
    ) && (master->query("id") != query_quest_marks(player, "master"))) {
      tell_object(player, "你不是已有" + query_quest_marks(player, "master_name") + "的任务在身吗?\n");
    } else {
      tell_object(player, "我不是已经给你任务了吗，快快起程。\n");
    }

    return 0;
  }

  if ("accomplish" == query_quest_marks(player, "result")) {
    tell_object(player, "你还有任务没有交差吧。\n");
    return 0;
  }

  delete_quest_marks(player, "level");
  delete_quest_marks(player, "where");
  delete_quest_marks(player, "time");

  if ((tt = (int)query_quest_marks(player, "cd_time")) && tt > time()) {
    switch (query_quest_marks(player, "result")) {
      case "reward":
        tell_object(player, "近日无事，你先下去练习吧。\n");
        break;

      case "fail":
        tell_object(player, "办事如此不力，还不自己反省反省。\n");
        break;

      case "cancel":
        tell_object(player, "没用的东西，你还是过会儿再来吧。\n");
        break;

      case "delay":
      default:
        tell_object(player, RANK_D->query_respect(player) + "办事拖拉，仍需努力啊。\n");
        break;
    }

    return 0;
  }

  if (master->is_tongmen_of(player) || player->is_manmade_npc()) {
    if (!random(3) && !player->is_manmade_npc() && master->family_quest(player)) {
      return 1;
    }

    if (3 > random(10) && give_quest(player, master)) {
      return 1;
    }
  }

  player->run_command("say 敢问" + RANK_D->query_respect(master) + "，最近可有何事需要效劳？");

  if (!master->is_tongmen_of(player) && !wizardp(player) && !player->is_manmade_npc()) {
    max_xiuwei = player->query_max_xiuwei_jibie();

    if (6 < max_xiuwei && !random(5)) {
      set_quest_marks(player, "start_time", time());
      set_quest_marks(player, "result", "wait");
      call_out("do_dajiu", 1, player, master);
      return 1;
    }
  }

  set_quest_marks(player, "start_time", time());
  set_quest_marks(player, "result", "wait");
  call_out("do_newtask", 1, player, master);
  return 1;
}

int do_cancel(object player, object master, string arg) {
  int tt;

  if (!arg || !master->id(arg)) {
    return 0;
  }

  if (master->is_tongmen_of(player) && master->have_family_quest(player)) {
    master->cancel_family_quest(player);
    return 1;
  }

  if (master->query("id") != query_quest_marks(player, "master")) {
    tell_object(player, master->query("name") + "疑惑的看着你说：我有给你任务吗？\n");
    return 1;
  }

  if ("wait" != query_quest_marks(player, "result")) {
    tell_object(player, "你没有任务在身。\n");
    return 1;
  }

  if ((tt = (int)query_quest_marks(player, "cd_time")) && tt > time()) {
    tell_object(player, "时辰未到，不可放弃。\n");
    return 1;
  }

  player->run_command("say 这个任务我恐怕无能为力。");
  tell_object(player, "你太令我失望了，待我亲自跑一趟吧。\n");

  player->start_busy(15);

  set_quest_marks(player, "result", "cancel");
  set_quest_marks(player, "finish_time", time());
  set_quest_marks(player, "cd_time", time() + 30);
  delete_quest_marks(player, "where");
  delete_quest_marks(player, "time");

  player->delete("baohu");
  player->delete_temp("baohu");

  return 1;
}

int do_done(object player, object master, string arg) {
  int bonus;

  if (!arg || !master->id(arg)) {
    return 0;
  }

  if (master->is_tongmen_of(player) && master->have_family_quest(player)) {
    master->done_family_quest(player);
    return 1;
  }

  if (master->query("id") != query_quest_marks(player, "master")) {
    tell_object(player, master->query("name") + "疑惑的看着你说：我有给你任务吗？\n");
    return 1;
  }

  if ("accomplish" != query_quest_marks(player, "result")) {
    tell_object(player, "你的任务完成了吗?\n");
    return 1;
  }

  bonus = query_quest_marks(player, "bonus");

  if (0 >= bonus) {
    bonus = 1;
  }

  message_vision("$N高兴的拍了拍$n道：“不错不错，果然办事利落。”\n", master, player);

  player->add("class_score/" + master->query("family/family_name"), bonus);
  printf(
    HIR "->你对" + master->query("family/family_name") + "的忠诚度升高 %s 点\n" NOR,
    chinese_number(bonus)
  );

  set_quest_marks(player, "result", "reward");
  set_quest_marks(player, "finish_time", time());
  set_quest_marks(player, "cd_time", time() + 2);
  delete_quest_marks(player, "where");
  delete_quest_marks(player, "time");

  player->delete("baohu");
  player->delete_temp("baohu");

  GIFT_D->boss_bonus(player, ([
    "percent": 100,
    "exp": 1000 + random(5000),
    "pot": 1000 + random(5000),
    "score": 100 + random(100),
    "gongxian": 10 + random(10),
    "gold": 1 + random(5),
    "jilei_num": 1 + random(3),
    "jilei_min": 10 + random(20),
    "jilei_max": 50 + random(20),
  ]));

  return 1;
}

int do_newtask(object player, object master) {
  object guai;
  int level, i;
  string kind, where, msg;
  int max_xiuwei;

  if (!player || !master || environment(player) != environment(master)) {
    return 1;
  }

  //确定任务种类
  if (master->is_tongmen_of(player) || wizardp(player) || player->is_manmade_npc()) {
    kind = "杀";
  } else {
    max_xiuwei = player->query_max_xiuwei_jibie();

    if (3 >= max_xiuwei) {
      kind = "杀";
    } else if (4 == max_xiuwei) {
      i = random(4);
      if (i > 0) {
        kind = "杀";
      } else {
        kind = "擒";
      }
    } else if (5 == max_xiuwei) {
      i = random(4);
      if (i > 1) {
        kind = "杀";
      } else if (i == 1) {
        kind = "擒";
      } else {
        kind = "劝";
      }
    } else {
      i = random(4);
      if (i == 0) {
        kind = "杀";
      } else if (i == 1) {
        kind = "擒";
      } else if (i == 2) {
        kind = "劝";
      } else {
        kind = "降";
      }
    }
  }

  //确定任务等级
  level = random(10);

  set_quest_marks(player, "kind", kind);
  set_quest_marks(player, "level", level);
  set_quest_marks(player, "master", master->query("id"));
  set_quest_marks(player, "master_name", master->query("name"));
  set_quest_marks(player, "finish_time", 0);
  set_quest_marks(player, "time", 0);
  set_quest_marks(player, "cd_time", time() + 60);

  guai = new("/quest/shilian/guai");
  where = guai->invocation(player, level);

  if ("没人在。" == where) {
    set_quest_marks(player, "result", "reward");
    set_quest_marks(player, "time", 0);
    set_quest_marks(player, "cd_time", 0);
    tell_object(player, "任务发放失败，请重来。\n");
    return 1;
  }

  switch (kind) {
    case "擒":
      tell_object(player, "现在有一个" + where + "附近出没，此人尚未恶贯满盈，但极难点化，你这就去将其生擒回来，让我亲自点化。\n");
      break;
    case "降":
      tell_object(player, "现在有一个" + where + "附近出没，此人刚刚出山尚未为恶，但非常好勇斗狠，你只需狠狠教训一回，就不敢为恶了。\n");
      break;
    case "劝":
      tell_object(player, "现在有一个" + where + "附近出没，此人本性不坏，只是未能冲破迷津，你这就去点化此人吧。\n");
      break;
    case "杀":
    default:
      tell_object(player, "现在有一个" + where + "附近出没，此人已经残杀了不少无辜，恶贯满盈了，你这就去将其除掉吧。\n");
      break;
  }

  set_quest_marks(player, "target", guai);
  set_quest_marks(player, "bonus", level);
  set_quest_marks(player, "where", where);

  //msg = player->name() + "接到一个难度" + chinese_number(level) + "的" + kind + "妖任务。";
  //MONITOR_D->report_system_msg (msg);

  return 1;
}

int do_drop(object player, object master, string arg) {
  object obj;

  if (!arg) {
    return 0;
  }

  if (master->query("id") != query_quest_marks(player, "master")) {
    tell_object(player, master->query("name") + "疑惑的看着你说：我有给你任务吗？\n");
    return 1;
  }

  if ("wait" != query_quest_marks(player, "result")) {
    tell_object(player, "你没有任务在身。\n");
    return 1;
  }

  if (!objectp(obj = present(arg, player))) {
    tell_object(player, "你身上没有这样东西。\n");
    return 1;
  }

  if (query_quest_marks(player, "kind") != "擒") {
    tell_object(player, "“不要在这么乱丢垃圾。”\n");
    return 1;
  }

  if (!obj->is_character() || obj->is_corpse()) {
    tell_object(player, "“不要在这么乱丢垃圾。”\n");
    return 1;
  }

  if (obj != query_quest_marks(player, "target")) {
    tell_object(player, "“我没有叫你擒此人回来。”\n");
    return 1;
  }

  call_out("accomplish", 2, player, obj, obj->name());
  return 0;
}

void accomplish(object me, object obj, string name) {
  if (!obj || living(obj)) {
    return;
  }

  destruct(obj);

  tell_room(environment(me), "几个弟子把" + name + "押了下去。\n\n");

  set_quest_marks(me, "result", "accomplish");
}

int do_dajiu(object player, object master) {
  object me = this_player();
  object guai, xie;
  int level, i;
  string where, msg;

  if (!player || !master || environment(player) != environment(master)) {
    return 1;
  }

  //确定任务等级
  level = random(10);

  set_quest_marks(player, "kind", "搭救");
  set_quest_marks(player, "level", level);
  set_quest_marks(player, "master", master->query("id"));
  set_quest_marks(player, "master_name", master->query("name"));
  set_quest_marks(player, "finish_time", 0);
  set_quest_marks(player, "time", 0);
  set_quest_marks(player, "cd_time", time() + 60);

  guai = new("/quest/dajiu/baohunpc");
  where = guai->invocation(me, level);

  if ("没人在。" == where) {
    set_quest_marks(player, "result", "reward");
    set_quest_marks(player, "time", 0);
    set_quest_marks(player, "cd_time", 0);
    tell_object(player, "任务发放失败，请重来。\n");
    return 1;
  }

  tell_object(me, CYN "\n现在有" + where + "附近被敌人掳去，已经快不行了，你去搭救吧。\n" NOR);

  set_quest_marks(player, "target", guai);
  set_quest_marks(player, "bonus", level);
  set_quest_marks(player, "where", where);

  me->delete("baohu/kk");
  me->set("baohu/id", guai->query("id"));
  me->set("baohu/name", guai->query("name"));
  me->set_temp("baohu/ob", guai);

  xie = new("/quest/dajiu/ling");
  if (xie->move(me)) {
    tell_object(
      me,
      master->query("name") + "拿出一" + xie->query("unit") + xie->query("name") + "。\n " + master->query("name") + "给你一" + xie->query("unit") + xie->query("name") + "。\n"
    );
  } else {
    tell_object(
      me,
      master->query("name") + "拿出一" + xie->query("unit") + xie->query("name") + "。\n " + xie->query("name") + "掉在地上不见了。\n"
    );
  }

  return 1;
}
