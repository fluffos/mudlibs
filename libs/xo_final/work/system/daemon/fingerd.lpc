#include <ansi.h>
#include <net/dns.h>

// 这里的login_ob是个公用的login_ob，用在
// finger玩家的时候不重复的new出login object出来，以免
// 产生过多的object而不释放内存。要知道destruct()并不立刻
// 释放内存的。
nosave object login_ob;

void create()
{
    seteuid( getuid() );
//	login_ob = new (LOGIN_OB);
}

//private function
int set_login_ob( string id )
{
	if (!login_ob) // destruct by other program?
		login_ob = new (LOGIN_OB);
	login_ob->set("id", id);
	return login_ob->restore();
}

