{
    return time_string(time);
    // nerd -- 98-08-30
    /*int month, day, hour;

    time /= 3600;
    hour = time % 24;
    time /= 24;
    day = time % 30;
    month = time / 30;
    return (month?month + "m":"") + (day?day + "d":"") + hour + "h";*/
}

string finger_all()
{
    object *ob = users(), me;
    string msg;
    int i;

    msg = "";
    me = this_player();
    for ( i = 0; i < sizeof( ob ); i++ )
    {
        if ( me && !me->visible(ob[i]) )
            continue;
        if(  wizardp( ob[i] ) && ob[i]->query("env/refuse_finger") )
            continue;
        // 为某些不希望玩家知道自己上线的巫师准备。by lnwm 980922
        msg = sprintf("%s%-20s  %-20s \n", msg, 
            ob[i]->query("name"), ob[i]->query("id"),);
    }
    return msg;
}

string finger_user(string name)
{
    object body, me;
    string msg; //, mud;
	int last_off, last_on;
    
	if (!set_login_ob(name))
        return "没有这个玩家。\n";
	me = this_player();
	last_off = login_ob->query("last_off");
	last_on = login_ob->query("last_on");

    msg =  sprintf( "\n英文代号：\t%s\n姓    名：\t%s\n权限等级：\t%s\n"
            "真实姓名：\t%s\n电子邮件：\t%s\n所在地区或单位：%s\n"
            "主页：\t\t%s\n联系方法：\t%s\n上次连线时间：\t%s\n"
			"上次离线时间：\t%s\n",
        login_ob->query("id"),
        login_ob->query("name"),
        SECURITY_D->get_status(name),
        login_ob->query("real_name"),
        login_ob->query("email"),
        login_ob->query("location"),
        login_ob->query("homepage"),
        login_ob->query("contact"),
		last_on == 0 ? "无记录" : ctime(last_on),
		last_off > last_on ? ctime(last_off) : "非正常退出或连线中" );

	// if other daemon call, there are no this_player -- nerd
    if ( me && wizardp(me) )
        msg += sprintf("上次连线地址：\t%s\n",
                login_ob->query("last_from") );
        
    body = find_player( name );

    if ( objectp( body ) && geteuid( body ) == name )
    {
        if(  wizardp( body ) && body->query("env/refuse_finger") )
            {;}
        else  if ( me && wizardp(me) )
        {
            msg += sprintf( "\n%s目前正在从 %s 连线中。\n",
                    body->name(1), query_ip_name(body) );
        }
        else if( me && me->visible(body) ) 
            msg += sprintf( "\n%s目前正在连线中。\n",body->name(1));
    }

    return msg + "\n请用chfn指令改变你自己的个人资讯。\n";
}

object acquire_login_ob(string id)
{
	object ob;
    ob = find_player(id);
    if ( ob )
    {
        // Check if the player is linkdead
        if ( ob->query_temp("link_ob") )
            return ob->query_temp("link_ob");
    }
    return set_login_ob(id) ? login_ob : 0;
}

// public function
int check_passwd(string id, string pw)
{
	string pass;
	if (!set_login_ob(id))
		return 0;
	pass = login_ob->query("password");
	if ( crypt(pw, pass) == pass )
		return 1;
	return 0;
}

// iMud functions.
mixed * GetRemoteFinger( string who )
{
    object lob, uob;
    uob = find_player( who );
    if ( ! lob = acquire_login_ob( who ) )
        return ({ });
    if( uob->query("env/all/invisibility") ) return ({});
    return ({ lob->query("name"),   // chinese name
                0,                  // title... not avaible now
                0,                  // real name... not avaible 2.
                lob->query("email"),// email
                ctime(lob->query("last_on")), // last login
                uob ? query_idle( uob ) : -1,
                uob ? query_ip_number( uob ) : 0,
                SECURITY_D->get_status( who ),
                who
            });
}
