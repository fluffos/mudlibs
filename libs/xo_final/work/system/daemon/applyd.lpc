#include <ansi.h>

inherit F_SAVE;
inherit F_DBASE;

mapping apply;

void create()
{
        seteuid(getuid());
        set("name", "申请精灵");
        if ( !restore() && !mapp(apply) )
        apply = ([]);
}

int remove()
{
        save();
        return 1;
}

string query_save_file() { return DATA_DIR + "applyd"; }

int set_apply(string my_id, mapping my_apply)
{
        apply[my_id] = my_apply;
        save();
        return 1;
}

int delete_apply( string my_id )
{
        map_delete( apply, my_id );
        save();
        return 1;
}

mapping query_apply(string my_id )
{
        if ( !undefinedp(apply[my_id]) )
                return apply[my_id];
        else
                return ([]);
}

string *query_all_apply()
{
        return keys(apply);
}

int do_view( string arg )
{
    string *id, *options;
    mapping my_apply;
    int i, j;
    if ( !arg )
    {
        write("现在已经填写巫师申请的玩家如下：\n");
        id = query_all_apply();
        for ( i = 0; i < sizeof(id); i++ )
        {
            printf("%5s%s", id[i], (i+1)%3?"    ":"\n ");
        }
        return 1;
    }
    if ( !undefinedp(apply[arg]) )    
    {
        my_apply = apply[arg];
        options = keys(my_apply);
        for ( j = 0; j < sizeof(options); j++ )
        {
            printf("%s\n%s", options[i], my_apply[options[i]]);
        }
        return 1;
    }
    return notify_fail("没有这份巫师申请。\n");
}