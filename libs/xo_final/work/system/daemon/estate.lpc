\n\
void create()\n\
{\n\
    set( "no_clean_up", 0 );\n"

#define ROOM_TAIL       "\n\
    setup();\n\
}\n"

#define ITEM_STRING     "   set ( \"item_desc\", (["
#define EXIT_STRING     "   set ( \"exits\", ([\
        "out"   :"
#define OBJECT_STRING   "   set ( \"object\", (["
#define END_STRING      "   ]) );\n"

private void create()
{
    seteuid( geteuid() );
}

int CreateRoom( string city, string own, string out_dir )
{
    string file;
    string room_code;
    file = resolve_path( ESTATE_DIR + city , own ) + ".lpc";
    if ( file_size( file ) != -1 )
    {
        log_file( "nosave/create_room_fail", file + " 已经存在了。\n" );
        return 0;
    }
    else
    {
        room_code = ROOM_HEAD + @TEXT
    set( "short", "空房间" );
    set( "long", "这是一间什麽也没有的空房间。\n" );
TEXT        
            + EXIT_STRING + "\"" + dir + "\",\n" 
            + END_STRING + ROOM_TAIL; 
        if ( !write_file( file, room_code ) )
        {
            log_file( "nosave/create_room_fail", file + " 写失败。\n" );
            return 0;
        }
        else
        {
            return 1;
        }
    }
} 

string GetRoom( string city, string own )
{
    string room_file;
    room_file = ESTATE_DIR + city + "/" + own + ".lpc";
    if ( file_size( room_file ) != -1 )
    {
        return room_file;
    }
    else
    {
        return 0;
    }
}

