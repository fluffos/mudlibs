#define DIR_VERBS "/cmds"

inherit F_CLEAN_UP;

private mapping m_verbs;

varargs int load_verbs(mixed val);

private void create() {
  int res;
  m_verbs = ([]);
  res = load_verbs();
  write("  ]载入了 " + res + " 个命令动词。\n");
}

varargs int load_verbs(mixed val) {
  string *verbs = 0;
  int i = 0;
  string dir;

  verbs = ({});
  foreach (dir in get_dir(DIR_VERBS + "/")) {
    dir = DIR_VERBS + "/" + dir;
    if (file_size(dir) == -2)
      verbs += map(get_dir(dir + "/*.lpc"), (: $(dir) + "/" + $1 :));
  }
  foreach (string verb in verbs) {
    object ob;

    if (ob = find_object(verb))
      destruct(ob);
    if (ob = load_object(verb)) {
      string v = ob->get_verb();  // maybe need add the synonyms
      m_verbs[v] = ob;
      i++;
    }
  }
  return i;
}

string get_error_msg(string verb) {
  if (!m_verbs[verb])
    return 0;
  else
    return (string)m_verbs[verb]->get_error_msg();
}

mapping get_verbs() {
  return m_verbs;
}
