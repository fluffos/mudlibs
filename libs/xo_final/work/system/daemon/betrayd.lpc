inherit F_CLEAN_UP;

void create() {
  seteuid(getuid());
}

void save_old_family(object me, object ob) {
  mapping jibie_map;
  mapping lingwu_map;
  mapping jilei_map;
  mapping xiuwei_map;
  mapping enable_map;
  mapping hide_map;

  me->set("apprentice/valid", 1);

  me->set("apprentice/family", me->query("family"));
  me->set("apprentice/class", me->query("class"));
  me->set("apprentice/class_score", me->query("class_score"));
  me->set("apprentice/combat_exp", me->query("combat_exp"));
  me->set("apprentice/social_exp", me->query("social_exp"));

  jibie_map = copy(me->query_jibie_map());
  me->set("apprentice/jibie_map", jibie_map);

  lingwu_map = copy(me->query_lingwu_map());
  me->set("apprentice/lingwu_map", lingwu_map);

  jilei_map = copy(me->query_jilei_map());
  me->set("apprentice/jilei_map", jilei_map);

  xiuwei_map = copy(me->query_xiuwei_map());
  me->set("apprentice/xiuwei_map", xiuwei_map);

  enable_map = copy(me->query_enable_map());
  me->set("apprentice/enable_map", enable_map);

  hide_map = copy(me->query_hide_map());
  me->set("apprentice/hide_map", hide_map);
}

void restore_old_family(object me, object ob) {
  if (!me->query("apprentice/valid")) {
    return;
  }

  me->set("apprentice/valid", 0);

  me->set("family", me->query("apprentice/family"));
  me->set("class", me->query("apprentice/class"));
  me->set("class_score", me->query("apprentice/class_score"));
  me->set("combat_exp", me->query("apprentice/combat_exp"));
  me->set("social_exp", me->query("apprentice/social_exp"));
  me->set("title", "普通百姓");

  me->set_jibie_map(me->query("apprentice/jibie_map"));
  me->set_lingwu_map(me->query("apprentice/lingwu_map"));
  me->set_jilei_map(me->query("apprentice/jilei_map"));
  me->set_xiuwei_map(me->query("apprentice/xiuwei_map"));
  me->set_enable_map(me->query("apprentice/enable_map"));
  me->set_hide_map(me->query("apprentice/hide_map"));
}
