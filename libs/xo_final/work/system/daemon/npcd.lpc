int return_home(object this, object home)
{
    object env = environment(this);

    // Are we at home already?
    if ( !env || env == home )
    {
        return 1;
    }

    // Are we able to leave?
    if ( !living( this ) || this->is_fighting() ||
         !mapp( env->query( "exits" ) ) ) 
    {
        return 0;
    }

    // Leave for home now.
    message( "vision", this->name() + "急急忙忙地离开了。\n", env, this );
    return this->move( home );
}

int chat(object who)
{
    string *msg;
    int chance, rnd;

    if ( !environment(who) )
    {
        return 0;
    }

    chance = who->query( who->is_fighting() ? "chat_chance_combat" : "chat_chance" );
    if ( !chance )
    {
        return 0;
    }

    msg = who->query( who->is_fighting() ? "chat_msg_combat": "chat_msg" ); 
    if ( arrayp( msg ) )
    {
        if (( random( 100 ) < chance ) && sizeof( msg ))
        {
            rnd = random( sizeof( msg ) );
            if ( stringp( msg[ rnd ] ) )
            {
                who->say( msg[ rnd ] );
            }
            else if ( functionp( msg[ rnd ] ) )
            {
                return evaluate( msg[ rnd ] );
            }
        }
        return 1;
    }

    return 0;
}

void update_npc_age(object who)
{
    int temp, sign, temp1;
    int mud_age;
    int age;

    if ( !who->query_last_age_set() )
    {
        who->set_last_age_set(time());
    }

    who->add("mud_age", time() - who->query_last_age_set());

    who->set_last_age_set(time());

    temp = who->query("age");

    mud_age = (int) who->query("mud_age");
    age = (int) who->query("age_modify");
    if (mud_age < 259200)
    {
        age += 14 + mud_age / BASE_TIME_1;
    }
    else if (mud_age < 1123200)
    {
        age += 20 + (mud_age - 259200) / BASE_TIME_2;
    }
    else if (mud_age < 2419200)
    {
        age += 30 + (mud_age - 1123200) / BASE_TIME_3;
    }
    else
    {
        temp1 = (mud_age - 2419200)/ BASE_TIME_4;
        age  = 40 + temp1 * 120 / ( temp1 + 120 );
    }

    if ( age != temp )
    {
        if ( age <= 100 )
        {
            who->set("age", age);
        }
    }

    if (age > temp && temp)
    {
        who->save();
    }
}

void npc_heart_beat(object who)
{
    mapping schedule;

    if ( who->query("can_improve") )
    {
        if ( !random(20) )// 不需要一直update_age
        {
            update_npc_age(who);
        }

        who->autosave();
    }

    // NPC 的 chat 
    if ( living(who) && !who->is_busy() ) 
    {
        chat(who);
        if ( !who )
        {
            return;
        }
    }

    // NPC 的 schedule
    if ( clonep(who) && mapp(schedule = who->query("schedule")) )
    {
        mapping gt;
        int time_tag;

        gt = NATURE_D->game_time(1);
        time_tag = gt[LT_HOUR] * 100 + (gt[LT_MIN] / 10) * 10;
        if( time_tag != who->get_last_scheduled_time_tag() )
        {
            evaluate(schedule[time_tag]);
            who->set_last_scheduled_time_tag(time_tag);
        }

        if ( !who )
        {
            return;
        }
    }
}

void master_heart_beat(object who)
{
    mapping m_jibie = who->query_jibie_map();
    string *sname;
    string select_skill;
    string skill_ob;
    object wuxian;

    return;

    if ( 0 < who->query("last_lian") )
    {
        if ( time() - who->query("last_lian") > 300 + random(60) )
        {
            who->run_command("stop");
            who->delete("last_lian");
            who->set("last_stop", time());
        }

        return;
    }

    if ( 0 < who->query("last_stop") )
    {
        if ( time() - who->query("last_stop") > 60 + random(60) )
        {
            who->delete("last_stop");
        }
        return;
    }

    if ( !who->can_act() )
    {
        return;
    }

    if ( !sizeof(m_jibie) )
    {
        return;
    }

    sname = keys(m_jibie);
    select_skill = sname[random(sizeof(sname))];
    if ( !KUNGFU_D->valid_skill(select_skill) )
    {
        return;
    }

    skill_ob = SKILL_D(select_skill);

    if ( !random(3) )
    {
        who->run_command("chat 闲暇无事，待我将【" + skill_ob->chinese_name() + "】演练一番!");
    }

    switch ( skill_ob->query_xiuwei_type() )
    {
        case "force":
            who->delete("last_lian");
            who->run_command("xiulian " + select_skill);
            return;
            break;

        case "dodge":
            who->run_command("lian " + select_skill);
            break;

        case "unarmed":
            who->run_command("unwield all");
            who->run_command("lian " + select_skill);
            break;

        default:
            if ( !(wuxian = present("wuxian shi", who)) )
            {
                who->carry_object("/clone/weapon/misc/wuxian");
            }
            if ( !(wuxian = present("wuxian shi", who)) )
            {
                return;
            }
            who->run_command("unwield all");
            wuxian->do_huan(skill_ob->query_weapon_type());
            who->run_command("wield shi");
            who->run_command("lian " + select_skill);
            break;
    }

    who->set("last_lian", time());

    return;
}

