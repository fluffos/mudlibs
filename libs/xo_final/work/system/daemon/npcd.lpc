void relay_emote(object ob, object me, string verb)
{
    string player_id, object_id, att, relay_msg;

    if( !userp(me) ) return;
    if( !me->can_act()) return;
    object_id = ob->query("id");
    player_id = me->query("id");
    att = ob->query( "attitude" );

    // 如果这个npc身上设了emote这个mapping
    // 对一些emote有特殊的反应，
    // 这个反应可以是个string，也可以是个function

    if ( relay_msg = ob->query("emote/" + verb ) )
    {
        if ( stringp( relay_msg ) )
            message_vision( relay_msg + "\n", ob, me );
        else if ( functionp( relay_msg ) )
            return evaluate( relay_msg );
        return;
    }

    if ( random(100) < 30 ) return ;

    switch(verb)
    {
    case "hit" :
        if ( ob->id("kids") || ob->id("kid") || ob->id("ya huan") )
        {
            ob->run_command("chat* qifu " + player_id );
            ob->run_command("hit " + player_id );
            return;
        }
        switch ( att )
        {
        case "friendly" : case "peaceful" :
            ob->run_command("shake " + player_id);
            break;
        case "heroism" :
             ob->run_command( "say 这位" + RANK_D->query_respect(me) + "，你为什么要打我？会痛的！\n" );
            ob->run_command( "hammer " + player_id);
            break;
        case "killer" :
            message_vision("$N恶狠狠对$n骂道：你小子是不要命了吧，惹到我的头上来了。\n", ob, me);
            ob->run_command( "hammer " + player_id );
            break;
        default :
            message_vision("$N狠狠瞪了$n一眼。\n", ob, me);
            ob->run_command( "kick " + player_id );
            break;
        }
        break;

    case "kick" :
        if ( ob->id("kids") || ob->id("kid") || ob->id("ya huan") )
        {
            ob->run_command("chat* qifu " + player_id );
            ob->run_command("trip " + player_id );
            return;
        }
        switch ( att )
        {
        case "friendly" : case "peaceful" :
            message_vision( "$N微微对$n一笑，一副不置可否的样子。\n", ob, me );
            break;
        case "heroism" :
            ob->run_command( "say 这位" + RANK_D->query_respect(me) + "，你为什么要踢我一脚？" );
            ob->run_command( "kick " + player_id);
            break;
        case "killer" :
            message_vision("$N恶狠狠对$n骂道：你小子是不要命了吧，惹到我的头上来了。\n", ob, me);
            ob->run_command( "hammer " + player_id );
            break;
        default :
            message_vision("$N狠狠瞪了$n一眼。\n", ob, me);
            ob->run_command( "kick " + player_id );
            break;
        }
        break;
    case "hammer" :
        if ( ob->id("kids") || ob->id("kid") || ob->id("ya huan") )
        {
            ob->run_command("chat* qifu " + player_id );
            ob->run_command("trip " + player_id );
            return ;
        }
        switch( att )
        {
        case "killer" :
            message_vision("$N恶狠狠对$n骂道：你小子是不要命了吧，惹到我的头上来了。\n", ob, me);
            ob->run_command("hammer " + player_id);
            break;
        default :
            ob->run_command("pure");
            ob->run_command("faint " + player_id );
            break;
        }
        break;
    case "admire" :
        switch ( att )
        {
        case "friendly" : case "peaceful" :
            ob->run_command("smile " + object_id );
            break;
        case "heroism" :
            ob->run_command("haha " + object_id );
            break;
        case "killer" :
            ob->run_command("look " + player_id );
            break;
        default :
            ob->run_command("xixi " + player_id );
            break;
        }
        break;
    case "interest" :
        switch ( att )
        {
        case "killer" :
            ob->run_command("grin " + player_id );
            break;
        case "heroism":
            ob->run_command("kick " + object_id );
            break;
        default :
            ob->run_command("shake " + object_id );
            break;
        }
        break;
    case "loveu" : case "love" : case "loveshoe" : case "qmarry" :
        switch ( ob->query("gender") )
        {
        case "男性" :
            if ( (string)me->query("gender") == "男性" )
                ob->run_command("chat* laugh1 " + player_id);
            else
                ob->run_command("interest " + player_id);
            break;
        case "女性" :
            if ( (string)me->query("gender") == "男性" )
            {
                ob->run_command("shake " + player_id);
                if ( (int)me->query_per() > 25 
                && (int)ob->query("age") < 30 && (int)ob->query("int") > 22 )
                    ob->run_command("sing");
            }
            else 
                ob->run_command("? " + player_id);
            break;
        }
        break;
    case "poke" :
        switch( att )
        {
        case "friendly" : case "peaceful" :
            ob->run_command("? " + player_id);
            break;
        default :
            ob->run_command("poke " + object_id);
            break;
        }
        break;
    case "trip" :
        if ( ob->id("kids") || ob->id("kid") || ob->id("ya huan") )
        {
            ob->run_command("chat* qifu " + player_id );
            ob->run_command("kick " + player_id );
            return ;
        }
        switch ( att )
        {
        case "friendly" : case "peaceful" :
            ob->run_command("shake " + player_id );
            break;
        default :
            ob->run_command("kick " + player_id );
        }
    default :
        ob->run_command( "? "+ player_id );
        ob->run_command( "doubt " + player_id );
        break;
    }
}

private nosave string *reject_msg = ({
    "说道：“您太客气了，这怎么敢当？”\n",
    "说道：“请教？这怎么敢当？”\n",
    "笑着说道：“您见笑了，我怎够资格‘指点’您什么？”\n",
});

private nosave string *refuse_msg = ({
    "说道：“这位$U，应当是$M向您请教才是。”\n",
});

string get_reject_msg()
{
    return reject_msg[ random( sizeof( reject_msg ) ) ];
}

string get_refuse_msg()
{
    return refuse_msg[ random( sizeof( refuse_msg ) ) ];
}

//Qyz 用于回答玩家关于功夫的问题。
int tell_skills( object me, object you )
{
    mapping skills;
    string *sname, att,skill; 
    mapping my_family, your_family;
    int my_gen, your_gen;
    
    att = me->query("attitude");
    skills = me->query_jibie_map();

    if ( !me->is_tongmen_of( you ) )
    {
        switch ( att )
        {
           case "friendly" : case "peaceful" :
                message_vision( me->name() + 
                    "对$N笑着说：“见笑了，我哪里会什么武功呢，你还是去问别人吧。”\n",you);
                break;
            case "heroism" :
                message_vision( me->name() +
                    "对$N冷淡地摇摇头说：“你并非本门中人，多问这些干甚？”\n",you);
                break;
            case "killer" : case "aggressive" :
                message_vision( me->name() + 
                    "恶狠狠对$N骂道：“你小子问这个干什么？想动手吗？”\n",you);
                break;
            default :
                message_vision("$N冷冷看了$n一眼，并不说话。\n", you, me);
                break;
        }

        return 1;
    }                                                                   

    my_family = me->query( "family" );
    your_family = you->query( "family" );
    my_gen = my_family[ "generation" ];
    your_gen = your_family[ "generation" ];

    if ( my_gen > your_gen )
    {
        message_vision("$N恭恭敬敬地对$n说：“我的功夫嘛，哪里比得上您呢？”\n",me ,you);
        return 1;
    }

    sname = keys(skills);   
    skill = sname[random(sizeof(sname))];
    message_vision("$N对着$n点了点头：“你在本门可以学习" + 
                    to_chinese(skill)+"(" + skill + ")这门武功。”\n",me,you);        

    return 1;
}

void full_me(object ob)
{
    ob->set("eff_kee", ob->query("max_kee"));
    ob->set("kee", ob->query("max_kee"));
    ob->set("eff_sen", ob->query("max_sen"));
    ob->set("sen", ob->query("max_sen"));
    ob->set("eff_gin", ob->query("max_gin"));
    ob->set("gin", ob->query("max_gin"));
    ob->set("force", 2 * ob->query("max_force"));
    ob->clear_condition();
    ob->revive(1);
}

void auto_perform(object ob)
{
    string *dodge_func;
    string *basic_func;
    string *spec_func;
    string *dodge_spec_func;
    string *temp_func;
    string my_force;
    string xiuwei_type;
    string dodge_skill;
    string attack_skill;
    object weapon;
    int dodge_count, basic_count, spec_count, dodge_spec_count;
    string cmd;
    int i;

    if ( weapon = ob->query_temp("weapon") )
    {
        xiuwei_type = weapon->query("weapon_type");
    }
    else
    {
        xiuwei_type = "unarmed";
    }

    dodge_func = get_dir(PERFORM_DIR + "dodge/*.lpc");
    basic_func = get_dir(PERFORM_DIR + "basic/*.lpc");

    dodge_spec_func = ({});
    dodge_skill = ob->query_wugong("dodge");
    if ( dodge_skill )
    {
        temp_func = get_dir(PERFORM_DIR + dodge_skill + "/*.lpc");
        if ( temp_func && arrayp(temp_func) && 0 < sizeof(temp_func) )
        {
            dodge_spec_func += temp_func;
        }
    }

    spec_func = ({});
    attack_skill = ob->query_wugong(xiuwei_type);
    if ( attack_skill )
    {
        temp_func = get_dir(PERFORM_DIR + attack_skill + "/*.lpc");
        if ( temp_func && arrayp(temp_func) && 0 < sizeof(temp_func) )
        {
            spec_func += temp_func;
        }
    }

    dodge_count = sizeof(dodge_func);
    basic_count = sizeof(basic_func);
    spec_count = sizeof(spec_func);
    dodge_spec_count = sizeof(dodge_spec_func);
    i = random(dodge_count + basic_count + spec_count + dodge_spec_count);

    if ( i < dodge_count )
    {
        my_force = dodge_func[random(dodge_count)];
        if ( !my_force )
        {
            return;
        }

        my_force = my_force[0..strlen(my_force)-3];
        cmd = "perform dodge." + my_force;
    }
    else if ( i < dodge_count + basic_count )
    {
        my_force = basic_func[random(basic_count)];
        if ( !my_force )
        {
            return;
        }

        my_force = my_force[0..strlen(my_force)-3];
        cmd = "perform " + my_force;
    }
    else if ( i < dodge_count + basic_count + spec_count )
    {
        my_force = spec_func[random(spec_count)];
        if ( !my_force )
        {
            return;
        }

        my_force = my_force[0..strlen(my_force)-3];
        cmd = "perform " + attack_skill + "." + my_force;
    }
    else
    {
        my_force = dodge_spec_func[random(dodge_spec_count)];
        if ( !my_force )
        {
            return;
        }

        my_force = my_force[0..strlen(my_force)-3];
        cmd = "perform " + dodge_skill + "." + my_force;
    }

    ob->run_command(cmd);
}

void auto_exert(object ob)
{
    string *all_func = get_dir(EXERT_DIR + "force/*.lpc");
    string *spec_func;
    string my_force = ob->query("using_force");

    if ( my_force )
    {
        spec_func = get_dir(EXERT_DIR + my_force + "/*.lpc");
    }
    if ( spec_func )
    {
        all_func += spec_func;
    }

    if ( !all_func || !arrayp(all_func) || 0 >= sizeof(all_func) )
    {
        return;
    }

    my_force = all_func[random(sizeof(all_func))];
    my_force = my_force[0..strlen(my_force)-3];

    ob->run_command("exert " + my_force);
}

