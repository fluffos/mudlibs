varargs int random_place_x(object me, string* dirs)
{
    int  i, j, k;
    object  newob;
    mixed*  file, exit;

    if ( !dirs )
    {
        dirs = dirs1;
    }

    if ( !sizeof(dirs) )
    {
        return 0;
    }

    i = random(sizeof(dirs));    // pick up one directory

    file = get_dir( dirs[i] + "/*.lpc", -1 );
    if ( !sizeof(file) )
    {
        return 0;
    }

    for ( k = 0; k < 30; k++ )
    {
        j = random(sizeof(file));

        if ( file[j][1] > 0 )
        {
            newob = load_object(dirs[i] + "/" + file[j][0]);
            if ( !newob )
            {
                continue;
            }

            if ( newob->query("no_fight") ||
                !(exit = newob->query("exits")) ||
                sizeof(exit) < 1 ||
                !newob->query("outdoors") )
            {
                continue;
            }

            if ( me->move(newob) )
            {
                message_vision("$N走了过来。\n", me);
                me->set("area", area1[i]);
                if ( me->owner() && objectp(me->owner()) && wizardp(me->owner()) )
                {
                    tell_object(me->owner(), "place: " + dirs[i] + "/" + file[j][0] + "\n");
                }
                return 1;
            }
        }
    }

    return 0;
}

varargs int random_place(object who, string* dirs)
{
    int j;

    for ( j = 0; j < 30; j++ )
    {
        if ( random_place_x(who, dirs) )
        {
            break;
        }
    }

    if ( 30 <= j )
    {
        return 0;
    }

    return 1;
}

#define MAX_MOVED       5

int random_move(object ob)
{
    mapping exits;
    string *moved;
    string dir;
    string *dirs;
    int i, n;

    if ( !ob )
    {
        return 0;
    }

    if ( !environment(ob) )
    {
        return 0;
    }

    if ( ob->is_fighting() || ob->is_duilianing() )
    {
        return 0;
    }

    if ( ob->query("new_master") )
    {
        return 0;
    }

    if ( environment(ob) && environment(ob)->query_doors() )
    {
        ob->run_command("open door");
    }

    moved = ob->query_temp("moved");

    if ( !moved )
    {
        moved = ({ });
    }

    if ( !ob->is_manmade_npc() && sizeof(moved) >= MAX_MOVED )
    {
        // out of range, move back
        dir = GO_CMD->query_reverse(moved[sizeof(moved) - 1]);
    }
    else
    {
        exits = environment(ob)->query("exits");
        if ( !exits )
        {
            return 0;
        }
        dirs = keys(exits);
        if ( sizeof(dirs) < 12 )
        {
            n = 12;
        }
        else
        {
            n = sizeof(dirs);
        }

        for ( i = 0; i < n; i++ )
        {
            if ( !sizeof(dirs) )
            {
                return 0;
            }

            dir = dirs[random(sizeof(dirs))];
            if ( !get_object(exits[dir]) )
            {
                log_file("log", sprintf("%s 的 %s 方向房间不存在。\n", base_name(environment(ob)), dir));
                break;
            }

            if ( stringp(GO_CMD->query_reverse(dir)) &&
                !get_object(exits[dir])->query("no_fight") )
            {
                break;
            }

            dirs -= ({ dir });
        }
    }

    if ( sizeof(moved) &&
        GO_CMD->query_reverse(dir) == moved[sizeof(moved) - 1])
    {
        // move back
        moved = moved[0..<2];
    }
    else
    {
        moved += ({ dir });
    }
    ob->set_temp("moved", moved);

    return GO_CMD->main(ob, dir);
}

void reset_xiuwei(object who)
{
    int i;
    string *sname;
    string type;
    int dengji;
    int min_dengji, max_dengji;
    mapping m_jibie = who->query_jibie_map();

    if ( !sizeof(m_jibie) )
    {
        return;
    }

    who->delete_all_xiuwei();

    sname = keys(m_jibie);

    min_dengji = 100;
    max_dengji = 1;

    for ( i = 0; i < sizeof(m_jibie); i++ )
    {
        if (SKILL_D(sname[i])->is_native_skill())
        {
            continue;
        }

        if ( who->query_jibie(sname[i]) <= 0 )
        {
            continue;
        }

        type = SKILL_D(sname[i])->query_xiuwei_type();
        dengji = SKILL_D(sname[i])->query_dengji();

        if ( dengji > who->query_xiuwei_dengji(type) )
        {
            who->set_xiuwei_level_by_type(type, dengji);
        }

        if ( 0 < dengji )
        {
            if ( dengji < min_dengji )
            {
                min_dengji = dengji;
            }
            if ( dengji > max_dengji )
            {
                max_dengji = dengji;
            }
        }
    }

    if ( min_dengji < 1 )
    {
        min_dengji = 1;
    }
    if ( max_dengji > 10 )
    {
        max_dengji = 10;
    }

    who->set_xiuwei_level_by_type("zonggang", (min_dengji + max_dengji) / 2);
/*
    string * xiuwei_type = KUNGFU_D->all_xiuwei_type();
    int i, count;

    count = sizeof(xiuwei_type);

    for ( i = 0; i < count; i++ )
    {
        if ( 0 == query_xiuwei_by_type(xiuwei_type[i]) )
        {
            set_xiuwei_by_type(xiuwei_type[i], 0);
            continue;
        }

        set_xiuwei_level_by_type(xiuwei_type[i], query_xiuwei_jibie(xiuwei_type[i]));
    }
*/
}

mixed carry_object(object who, string file)
{
    object ob;

    // Don't let master copy clone equips
    if( !clonep(who) )
    {
        return VOID_OB;
    }

    if ( !objectp(ob = new(file)) )
    {
        return VOID_OB;
    }

    // Support of uniqueness. 
    if ( ob->is_unique() && UNIQUE_D->had_cloned( ob ) )
    {   
        destruct( ob );
        return VOID_OB;
    }

    if ( ob->violate_unique() )
    {
        ob = ob->create_replica();
    }

    if ( !ob )
    {
        return VOID_OB;
    }

    ob->move( who);
    return ob;
}

int accept_fight(object this, object who)
{
    string att;
    int gin, max_gin, kee, max_kee, sen, max_sen;

    att = this->query( "attitude" );

    if ( this->is_fighting() )
    {
        switch( att )
        {
            case "heroism"  :
            case "killer"   :
                this->run_command( "say 哼！出招吧！\n" );
                break;
            default :
                this->run_command( "say 想倚多为胜，这不是欺人太甚吗！\n" );
                return 0;
        }
    }

    gin = this->query( "gin" );
    max_gin = this->query( "max_gin" );
    kee = this->query( "kee" );
    max_kee = this->query( "max_kee" );
    sen = this->query( "sen" );
    max_sen = this->query( "max_sen" );

    if ( gin * 100 / max_gin >= 90 &&
         kee * 100 / max_kee >= 90 &&
         sen * 100 / max_sen >= 90 )
    {
        switch( att )
        {
            case "friendly":
                this->run_command( "say “" + RANK_D->query_self( this )
                        + "怎么可能是" + RANK_D->query_respect( who )
                        + "的对手？”\n" );
                return 0;
            case "heroism"    :
            case "aggressive"   :
            case "killer"       :
                this->run_command( "say 哼！出招吧！\n" );
                break;

            default:
                if ( !this->is_fighting() )
                {
                    this->run_command( "say 既然" + RANK_D->query_respect( who )
                            + "赐教，" + RANK_D->query_self( this )
                            + "只好奉陪。\n" );
                }
        }
        return 1;
    }
    else
    {
        this->run_command( "say “哼！你这不是趁人之危嘛？”\n" );
        return 0;
    }
}

int accept_bihua(object this, object who)
{
    return accept_fight(this, who);
}

int accept_duilian(object this, object who)
{
    return accept_fight(this, who);
}

