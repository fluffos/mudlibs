#include <mudlib.h>

int query_str(object who) {
  int eff_str = 0;

  if ((int)who->query("force") >= (int)who->query("force_factor")) {
    eff_str = (int)who->query("force_factor");
  }

  eff_str += (int)who->query("str") + who->query_temp("apply/strength") + who->query("gifts_modify/str");

  return eff_str;
}

int query_cor(object who) {
  return (int)who->query("cor") + (int)who->query("bellicosity") / 50 + who->query_temp("apply/courage") + who->query("gifts_modify/cor");
}

int query_int(object who) {
  return (int)who->query("int") + who->query("gifts_modify/int") + who->query_temp("apply/intelligence");
}

int query_spi(object who) {
  return (int)who->query("spi") + who->query("gifts_modify/spi") + who->query_temp("apply/spirituality");
}

int query_cps(object who) {
  return (int)who->query("cps") + (int)who->query("force_factor") / 2 + who->query_temp("apply/composure") + who->query("gifts_modify/cps");
}

int query_per(object who) {
  return (int)who->query("per") + who->query("gifts_modify/per") + who->query_temp("apply/personality");
}

int query_con(object who) {
  return (int)who->query("con") + who->query("gifts_modify/con") + who->query_temp("apply/constitution");
}

int query_kar(object who) {
  return (int)who->query("kar") + who->query("gifts_modify/kar") + who->query_temp("apply/karma");
}

int query_dex(object who) {
  return (int)who->query("dex") + who->query("gifts_modify/dex") + who->query_temp("apply/dex");
}

int query_age(object who) {
  int age, zhuyan;
  string force;

  age = who->query("age");
  if (age <= 18) return age;
  force = who->query("using_force");
  if (force)
    age -= who->query_lingwu(force) / 10 * SKILL_D(force)->query_zhuyan();
  zhuyan = who->query_lingwu("zhuyan-shu");
  age -= zhuyan / 5;
  if (zhuyan == 200) age = 18;
  return (age < 18) ? 18 : age;
}

int max_int(int system_type) {
  if (SYSTEM_64BIT == system_type) {
    return 9223372036000000000;
  }

  return 2147400000;
}
