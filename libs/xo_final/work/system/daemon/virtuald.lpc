/* /system/daemon/virtual.c
 * from XO Object Library II
 * compile some virtual objects. 
 * created by trill 19970920
 * version: @(#) virtual.c 1.0@(#)
 */

void create()
{
    seteuid(getuid());

    if( clonep() ) 
    {
        destruct(this_object());
    }
}

object compile_object(string file)
{
    int idx;
    object ob;
    string pname = file;

    //log_file("nosave/virtual", sprintf("[%s] Trying to load virtual obj:%s\n",
     //       ctime(time())[4..15], file) );
    if ( !file )
    {
        return 0;
    }

    if ( 0 == (idx = strsrch(file, "/d/place/player/")) )
    {
        //玩家房间
        ob = new_object("/d/place/player/newroom");
        if ( !ob )
        {
            return 0;
        }

        if ( ob->restore_me(file[strlen("/d/place/player/")..]) )
        {
            return ob;
        }

        destruct(ob);
        return 0;
    }

    if ( 0 == (idx = strsrch(file, "/d/place/skills/")) )
    {
        //玩家自创技能
        ob = new_object("/d/place/player/combine_unarmed");
        if ( !ob )
        {
            return 0;
        }

        ob->set_owner_id("driver");
        ob->set_id(file[strlen("/d/place/skills/")..]);
        if ( ob->restore() )
        {
            return ob;
        }

        destruct(ob);
        return 0;
    }

    if ( file[0..1] == "/f" )
    {
        ob = FUBEN_D->compile_object(file);
        if ( objectp(ob) ) 
        {
            ob->setup();
            return ob;
        }

        return 0;
    }

    while ( 1 )
    {
        idx = strsrch(pname, "/", -1);

        if ( idx == -1 )
        {
            return 0;
        }

        if ( idx != 0 )
        {
            pname = pname[0..idx-1];
        }

        if ( file_exists(pname + ".lpc") )
        {
            if ( ob = pname->query_maze_room(file[idx + 1..]) )
            {
                ob->set_virtual_flag();
                return ob;
            }
        }

        if ( !idx )
        {
            return 0;
        }
    }

    return 0;
}

