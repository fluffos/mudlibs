varargs mapping query_action(object skill, int jibie, string type)
{
    int i, size;
    mapping *action = skill->get_all_action(skill);
    mapping result;
    string skill_type;
    int skill_dengji;
    int min_damage, max_damage;
    int min_temp, max_temp;

    if ( "parry" == type || "dodge" == type )
    {
        jibie = ACTION_MAX_JIBIE;
    }

    size = sizeof( action );
    i = size * jibie / ACTION_MAX_JIBIE;
    if ( i > size )
    {
        i = size;
    }

    i = random(i);
    result = action[i];

    skill_type = skill->query_xiuwei_type();
    if ( !skill_type || "dodge" == skill_type || "force" == skill_type
        || "parry" == type || "dodge" == type )
    {
        if ( "dodge" == skill_type )
        {
            result["action"] += "。";
        }

        return result;
    }

    skill_dengji = query_dengji(skill);

    min_damage = skill_dengji * DAMAGE_STEP * 3 / 4 - DAMAGE_STEP / 2;
    max_damage = min_temp + DAMAGE_STEP;

    //按照固定的算法设置damage，使得技能移植比较容易，只要关注action的描述即可
    //同时，skill也可以随意放在哪个目录，自动获取等级，自动计算damage，全自动
    min_temp = min_damage + DAMAGE_STEP * i / size;
    max_temp = min_temp + DAMAGE_STEP / size + 1;
    result["damage"] = min_temp + random(max_temp - min_temp);
    result["wound"] = (min_temp + random(max_temp - min_temp)) / (2 + random(2));
    result["force"] = (min_temp + random(max_temp - min_temp)) / (3 + random(2));
    result["dodge"] = jibie / 40 + random(jibie / 40);
    result["parry"] = jibie / 40 + random(jibie / 40);
    result["sen"] = skill_dengji * jibie / 50;

    switch ( skill_type )
    {
        case "sword":
            result["damage_type"] = sword_hurt_type[random(sizeof(sword_hurt_type))];
            break;

        case "blade":
            result["damage_type"] = blade_hurt_type[random(sizeof(blade_hurt_type))];
            break;

        case "long":
            result["damage_type"] = long_hurt_type[random(sizeof(long_hurt_type))];
            break;

        case "short":
            result["damage_type"] = short_hurt_type[random(sizeof(short_hurt_type))];
            break;

        case "unarmed":
            result["damage_type"] = unarmed_hurt_type[random(sizeof(unarmed_hurt_type))];
            break;

        default:
            break;
    }

/*
    write(sprintf(HIY"%s damage %d wound %d force %d dodge %d parry %d sen %d %s"NOR"\n"
        ,skill->skill_id() , result["damage"], result["wound"], result["force"], result["dodge"], result["parry"], result["sen"],
        result["damage_type"]));
*/

    return result;
}

string query_zhaoshi( object skill, int jibie )
{
    int i, size;
    mapping *action = skill->get_all_action(skill);

    size = sizeof( action );
    i = size * jibie / ACTION_MAX_JIBIE;
    if ( i > size )
    {
        i = size;
    }

    if ( !undefinedp(action[ i ][ "zhaoshi" ]) && stringp(action[ i ][ "zhaoshi" ]) )
    {
        return action[ i ][ "zhaoshi" ];
    }

    return "【" + skill->chinese_name() + "】";
}

string get_parry_msg(object skill)
{
    string *parry_msg = skill->get_all_parry_msg(skill);
    string result = parry_msg[random(sizeof(parry_msg))];
    mapping action = query_action(skill, 1000, "parry");
    string zhaoshi;

    if ( !undefinedp(action["zhaoshi"]) && stringp(action["zhaoshi"]) )
    {
        zhaoshi = action["zhaoshi"];
    }
    else
    {
        zhaoshi = "【" + skill->chinese_name() + "】";
    }

    return replace_string(result, "$Z", zhaoshi);
}

