}

string query_parry_msg(object skill, object weapon)
{
    if ( !weapon )
    {
        string unarmed_parry_msg = get_unarmed_parry_msg(skill);
        string *all_unarmed_parry_msg = get_all_unarmed_msg(skill);

        if ( unarmed_parry_msg )
        {
            return unarmed_parry_msg;
        }
        else if ( all_unarmed_parry_msg )
        {
            return all_unarmed_parry_msg[random(sizeof(all_unarmed_parry_msg))];
        }
        else
        {
            return "$n反手一招，荡开了$N的攻势";
        }
    }
    else
    {
        string unarmed_parry_msg = get_parry_msg(skill);
        string *all_unarmed_parry_msg = get_all_parry_msg(skill);

        if ( unarmed_parry_msg )
        {
            return unarmed_parry_msg;
        }
        else if ( all_unarmed_parry_msg )
        {
            return all_unarmed_parry_msg[random(sizeof(all_unarmed_parry_msg))];
        }
        else
        {
            return "$n反手一招，荡开了$N的攻势";
        }
    }
}

mixed hit_ob(object skill, object me, object victim, int damage_bonus, int factor)
{
    int damage;
    int my_force, his_force;
    int my_force_jibie, his_force_jibie;
    string my_using_force, his_using_force;

    if ( "force" != skill->query_xiuwei_type() )
    {
        return 0;
    }

    if ( factor > me->query("force") )
    {
        factor = me->query("force");
    }

    me->add( "force", - factor );

    my_force = me->query( "force" );
    his_force = victim->query( "force" );

    damage = my_force / 20 + factor - his_force / 25;

    my_using_force = me->query( "using_force" );
    his_using_force = victim->query( "using_force" );

    my_force_jibie = me->query_jibie( my_using_force );
    his_force_jibie = victim->query_jibie( his_using_force );

    // 原来的damage太大了，造成enforce就是damage主要部分了
    damage = damage / 3;//damage本来就应该是主要由enforce引起的

    if ( damage < 0 )
    {
        if ( !me->query_temp( "weapon" ) &&
            random( his_force_jibie ) > my_force_jibie / 2 )
        {
            damage = - damage;
            me->receive_damage( "kee", damage * 2 );
            me->receive_wound( "kee", damage );
            if ( damage < 10 )
            {
                return "$N受到$n的内力反震，闷哼一声。\n";
            }
            else if ( damage < 20 )
            {
                return "$N被$n以内力反震，「嘿」地一声退了两步。\n";
            }
            else if ( damage < 40 )
            {
                return "$N被$N以内力反震，胸口如遭重击，连退了五六步！\n";
            }
            else
            {
                return "$N被$n的内力反震，眼前一黑，身子向后直飞出去！！\n";
            }
        }

        if ( damage_bonus + damage < 0 )
        {
            return - damage_bonus;
        }

        return damage;
    }

    damage -= victim->query_temp( "apply/armor_vs_force" );
    if ( damage_bonus + damage < 0 )
    {
        return - damage_bonus;
    }

    if ( random( my_force_jibie ) < damage )
    {
        return damage;
    }

    return 0;
}

string exert_function_file(object skill, string func)
{
    return EXERT_DIR + skill->skill_id() + "/" + func;
}

int exert_function(object skill, object me, string arg)
{
    string func, target, file;
    object target_ob;
    int amount = 0;
    int result = 0;

    if ( sscanf(arg, "%s on %s with %d", func, target, amount) == 3 )
    {
        if ( !objectp( target_ob = present(target, environment(me)) ) )
        {
            return notify_fail("这里没有 " + target + "。\n");
        }
    }
    else if ( sscanf(arg, "%s with %d", func, amount) == 2 )
    {
        target_ob = me;
    }
    else if ( sscanf(arg, "%s on %s", func, target) == 2 )
    {
        if ( !objectp( target_ob = present(target, environment(me)) ) )
        {
            return notify_fail("这里没有 " + target + "。\n");
        }
    }
    else
    {
        func = arg;
        target_ob = me;
    }

    if ( time() < me->query_temp(sprintf("exert_cd/%s/%s", skill->skill_id(), func)) )
    {
        return notify_fail("你刚刚使用了" + func + "，现在真气尚未凝聚。\n");
    }

    if ( !stringp(file = exert_function_file(skill, func)) || file_size(file + ".lpc") <= 0 )
    {
        return notify_fail("你所用的内功中没有这种功能。\n");
    }

    result = (int)call_other( file, "exert", me, target_ob, amount);

    if ( 1 < result )
    {
        me->set_temp(sprintf("exert_cd/%s/%s", skill->skill_id(), func), time() + result - 1);
        result = 1;
    }

    return result;
}

string perform_action_file(object skill, string action)
{
    return PERFORM_DIR + skill->skill_id() + "/" + action;
}

nosave int perform_private(string skill_id, object me, string action)
{
    string target_id, file;
    object target;
    int result = 0;

    if ( !skill_id )
    {
        return 0;
    }

    if ( sscanf( action, "%s on %s", action, target_id ) != 2 )
    {
    	target = me->select_opponent();

        if ( !target || environment(target) != environment(me) )
        {
            return notify_fail("你只能对战斗中的对手使用。\n");
        }
    }
    else if ( !(target = present(target_id, environment(me))) )
    {
        return notify_fail("你只能对战斗中的对手使用。\n");
    }

/*
    if ( time() < me->query_temp(sprintf("perform_cd/%s/%s", skill_id, action)) )
    {
        return notify_fail("你刚刚使用了" + action + "，现在真气尚未凝聚。\n");
    }
*/

    file = PERFORM_DIR + skill_id + "/" + action;
    if ( !stringp( file ) || file_size( file + ".lpc" ) <= 0 )
    {
        return notify_fail("你所用的外功中没有这种功能。\n");
    }

    result = (int)call_other( file, "perform", me, target);

/*
    if ( 1 < result )
    {
        me->set_temp(sprintf("perform_cd/%s/%s", skill_id, action), time() + result - 1);
        result = 1;
    }
*/

    return result;
}

int perform_action(object skill, object me, string action)
{
    return perform_private(skill->skill_id(), me, action);
}

int perform_basic_action(object me, string action)
{
    string skill_id;
    object weapon = me->query_temp("weapon");

    if ( !weapon )
    {
        skill_id = "unarmed";
    }
    else
    {
        skill_id = weapon->query("xiuwei_type");
    }

    if ( !skill_id )
    {
        return 0;
    }

    skill_id = "basic";

    return perform_private(skill_id, me, action);
}

int perform_dodge_action(object me, string action)
{
    return perform_private("dodge", me, action);
}

int receive_damage( string type, int damage, object who, object me )
{
    string msg;

    if ( !who || !me )
    {
        return 0;
    }

    msg = sprintf(HIW"%s-->%s: damage[%s]-->%d"NOR"\n", objectp(who) ? who->query("id") : "", objectp(me) ? me->query("id") : "", type, damage);

    if ( who && wizardp(who) && who->query("env/combat_test") )
    {
        tell_object(who, msg);
    }

    if ( who && me && wizardp(me) && me->query("env/combat_test") )
    {
        tell_object(me, msg);
    }

    return 0;
}

int receive_wound( string type, int damage, object who, object me )
{
    string msg;

    if ( !who || !me )
    {
        return 0;
    }

    msg = sprintf(HIW"%s-->%s: wound[%s]-->%d"NOR"\n", objectp(who) ? who->query("id") : "", objectp(me) ? me->query("id") : "", type, damage);

    if ( who && wizardp(who) && who->query("env/combat_test") )
    {
        tell_object(who, msg);
    }

    if ( who && me && wizardp(me) && me->query("env/combat_test") )
    {
        tell_object(me, msg);
    }

    return 0;
}

int check_damage_type( string type, object me )
{
    if ( "max_qi" == type )
    {
        type = "max_kee";
    }
    if ( "qi" == type )
    {
        type = "kee";
    }
    if ( "max_jingli" == type || "max_jing" == type )
    {
        type = "max_gin";
    }
    if ( "jingli" == type || "jing" == type )
    {
        type = "gin";
    }
    if ( "max_neili" == type )
    {
        type = "max_force";
    }
    if ( "neili" == type )
    {
        type = "force";
    }
    if ( "jiali" == type )
    {
        type = "force_factor";
    }

    if ( type != "gin" && type != "kee" && type != "sen" )
    {
        CHANNEL_D->do_channel(me, "sys", "F_DAMAGE(" + me->query_idname() + "): 伤害种类错误( 只能是 gin, kee, sen 其中之一 )。\n");
        return 0;
    }

    return 1;
}

// 用来实现走火入魔造成的伤害
void check_force(object who)
{
    int chazhi;
    mapping my = who->query_entire_dbase();

    return;
    if ( !living( who ) )
    {
        return;
    }

    if ( wizardp( who ) && query( "env/immortal" ) )
    {
        return;
    }

    chazhi = my["yin"] - my["yang"];
    if ( chazhi < 0 )
    {
        chazhi *= -1;
    }

    if ( chazhi >= 200 || my["yang"] < 400 || my["yang"] >= 1000 )
    {
        return;
    }

    who->remove_all_enemy();

    message( "system",
        HIW "\n突然，你感觉到体内的阴阳二气冲撞越来越剧烈。\n"NOR
        HIR "你只觉得体内的气息越流越快，隐隐有控制不住的感觉……\n\n" NOR
        HIR "强烈的内气在你的经脉里四处游走，你渐渐地失去了知觉……"NOR, who );
    who->disable_player( "<走火入魔>" );
    who->set( "gin", 0 );
    who->set( "kee", 0 );
    who->set( "sen", 0 );
    who->add( "max_force", -400 );
    who->add( "yin", -200 );
    who->add( "yang", -200 );
    who->set( "force", 0 );
    who->set_temp( "block_msg/all", 1 );
    COMBAT_D->announce( who, "unconcious" );
}

int query_lian_limit(object who)
{
    int lian_limit;

    if ( undefinedp(who->query("env/lian_limit")) || !intp(who->query("env/lian_limit")) )
    {
        lian_limit = 10;
    }
    else
    {
        lian_limit = who->query("env/lian_limit");
        if ( lian_limit < 10 )
        {
            lian_limit = 10;
        }
        else if ( lian_limit > 99 )
        {
            lian_limit = 99;
        }
    }

    return lian_limit;
}

void check_lian(object who)
{
    string msg;
    object weapon, skill;
    object room;
    mapping action;
    int jibie, sen_cost, ratio, limit;
    int bonus;
    int SnowRain = 0;
    string lian_skill;

    if ( !who->is_lianing() || !environment(who) || random(100) <= 30 )
    {
        return;
    }

    // 如果角色的体能值已经在 10% 或设定的限度下, 就停止练习
    ratio = who->query_char_ratio("sen");
    limit = query_lian_limit(who);
    lian_skill = who->query_lian_skill();

    if ( (ratio < limit) || !SKILL_D(lian_skill)->valid_lian(who) )
    {
        msg = sprintf("$N停手收势，气沉丹田, 练完了%s。\n",
                    to_chinese(lian_skill));
        message_vision(msg, who);
        who->stop_lian();
        return;
    }

    jibie = who->query_jibie(lian_skill);
    action = SKILL_D(lian_skill)->query_action(jibie);
    if ( undefinedp(action["lian"]) )
    {
        msg = sprintf("$N气沉丹田, 认真练习%s。\n",
                    to_chinese(lian_skill));
    }
    else
    {
        msg = action["lian"] + "。\n";
    }
    weapon = who->query_temp("weapon");
    if ( objectp(weapon) )
    {
        msg = replace_string(msg, "$w", weapon->name());
    }
    message_vision(msg, who);

    // 消耗体能, 如果这一次动作领悟了, 还要消耗精神
    room = environment(who);
    if ( objectp(room)
        && NATURE_D->GetWeather(PLACE_D->Contain(room),
                                NATURE_D->GetSeason()) >= 3)
    {
        SnowRain = 1;
        if (!action["sen"])
        {
            sen_cost = 8;
        }
        else
        {
            sen_cost = 2 * (int) action["sen"];
        }
    }
    else
    {
        if (!action["sen"])
        {
            sen_cost = 3;
        }
        else
        {
            sen_cost = (int) action["sen"];
        }
    }

    if ( userp(who) )
    {
        who->receive_damage("sen", sen_cost);
    }

    if ( random(100) > 70 || random(100) < who->query_int() )
    {
        skill = load_object(SKILL_D(lian_skill));
        if (SnowRain)
        {
            bonus = who->query_xiuwei_dengji(skill->query_xiuwei_type())
                - skill->query_dengji() + 6;
        }
        else
        {
            bonus = who->query_xiuwei_dengji(skill->query_xiuwei_type())
                - skill->query_dengji() + 2;
        }
        if (bonus <= 0 && !random(100 * (1 - bonus)))
        {
            bonus = 1;
        }
        if (bonus <= 0)
        {
            bonus = 0;
        }
        // TODO : 考虑已经会了高等级武功的情况
        who->improve_jilei(lian_skill, bonus);
    }
}

int lingwu_limit(object who, string skill)
{
    int lingwu, dengji;

    lingwu = who->query_lingwu(skill);
    dengji = SKILL_D( skill )->query_dengji();

    return lingwu * lingwu * ( dengji * dengji + 1 ) * 6 / 202 + 10;
}

int query_lingwu_ratio(object who, string skill)
{
    int lingwu, jibie;

    lingwu = who->query_lingwu(skill);
    jibie = who->query_jibie(skill);
    if (!jibie)
        return 0;
    return lingwu * 100 / jibie;
}

int query_jilei_ratio(object who, string skill)
{
    int jilei, temp;

    jilei = who->query_jilei(skill);
    if (!jilei)
        return 0;
    temp = jilei * 100 / lingwu_limit(who, skill);
    if (temp > 100)
        temp = 100;
    return temp;
}

varargs int query_max_force(object who, string using_force)
{
    int result = 0;
    int times = 0;

    if ( !using_force )
    {
        using_force = who->query("using_force");
    }
    if ( !using_force )
    {
        return 0;
    }

    result = (who->query_jibie( using_force ) * (int)SKILL_D(using_force)->query_dengji() / 2 + who->query( "con" ) / 3 ) * 10;

    result += result / 10 * who->query_xiuwei_dengji("force");

    if ( who->query("breakup") )
    {
        result += result / 10 * 3;
    }

    if ( times = (int)who->query("reborn/times") )
    {
        result += times * result / 2;
    }

    if ( who->query("jingmai/neili") )
    {
        result += who->query("jingmai/neili");
    }

    if ( who->query("jingmai/finish") )
    {
        result += ZHOUTIAN_D->query_jingmai_effect("neili");
    }

    if ( who->query_temp("apply/max_neili") )
    {
        result += who->query_temp("apply/max_neili");
    }

    return result;
}

int query_potential_limit(object who)
{
    return system_maxint();
}

void set_xiuwei_level_by_type(object who, string type, int val)
{
    int min_xiuwei = query_xiuwei_by_level(val);
    int max_xiuwei = query_xiuwei_by_level(val + 1);

    if ( 0 >= min_xiuwei )
    {
        min_xiuwei = 1;
    }

    who->set_xiuwei_by_type(type, min_xiuwei + random(max_xiuwei - min_xiuwei - 1));
} 

int query_max_xiuwei_jibie(object who)
{
    int jibie = 0;
    int i;

    for ( i = 0; i < sizeof(xiuwei_type); i++ )
    {
        if ( who->query_xiuwei_jibie(xiuwei_type[i]) > jibie )
        {
            jibie = who->query_xiuwei_jibie(xiuwei_type[i]);
        }
    }

    return jibie;
}

int valid_skill( string skill )
{
    if ( !stringp(SKILL_D(skill)) ||
        ( !find_object( SKILL_D(skill) ) && !load_object( SKILL_D(skill) ) &&
         file_size( SKILL_D(skill) + ".lpc" ) < 0 ) )
    {
        return 0;
    }

    return 1;
}

int check_skill( string skill )
{
    if ( !stringp( SKILL_D(skill) ) ||
        ( !find_object( SKILL_D(skill) ) && !load_object( SKILL_D(skill) ) &&
         file_size( SKILL_D(skill) + ".lpc" ) < 0 ))
    {
        return 0;
    }

    return 1;
}

int enable_skill(object who, string skill)
{
    if (SKILL_D(skill)->query_xiuwei_type() == "force")
    {
        who->set("using_force", skill);
        return 0;
    }

    if ( "martial" != SKILL_D(skill)->type() )
    {
        return 0;
    }

    return 1;
}

// 由武器类型在enable数组中找出此类的武功, 然后随机挑选一种
string query_wugong(object who, string type)
{
    int i;
    string *select;
    string *skills;
    mapping m_enable = who->query_enable_map();

    if ( "force" == type )
    {
        return who->query("using_force");
    }

    if ( !mapp( m_enable ) )
    {
        return 0;
    }
    skills = keys( m_enable );

    select = ({});

    for ( i = 0; i < sizeof( skills ); i++ )
    {
        if ( SKILL_D(skills[ i ])->query_weapon_type() == type
            || SKILL_D(skills[i])->query_xiuwei_type() == type )
        {
            select += ({ skills[ i ] });
        }
    }
    if ( sizeof( select ) )
    {
        return select[ random( sizeof( select ) ) ];
    }
    return 0;
}

// 由武器类型在enable数组中找出此类的武功, 然后挑出其中jibie最高的一种
string query_wugong_max(object who, string type)
{
    int i, max_level;
    string *skills, select;
    mapping m_enable = who->query_enable_map();

    if ( !mapp( m_enable ) )
    {
        return 0;
    }

    skills = keys( m_enable );
    max_level = 0;
    for ( i = 0; i < sizeof( skills ); i++ )
    {
        if ( SKILL_D(skills[ i ])->query_weapon_type() != type
            && SKILL_D(skills[i])->query_xiuwei_type() != type )
        {
            continue;
        }

        if ( who->query_jibie(skills[i]) > max_level )
        {
            max_level = who->query_jibie(skills[i]);
            select = skills[i];
        }
    }

    return select;
}

// 由武器类型在jibie数组中找出此类的武功, 返回筛选出的数组 
string * query_wugong_list(object who, string weapon_type)
{
    int i;
    string *skills, *select;
    mapping m_jibie = who->query_jibie_map();

    if ( !mapp( m_jibie ) )
    {
        return 0;
    }
    skills = keys( m_jibie );
    select = ({});
    for ( i = 0; i < sizeof( skills ); i++ )
    {
        if ( weapon_type == SKILL_D(skills[ i ])->query_weapon_type()
            || weapon_type == SKILL_D(skills[i])->query_xiuwei_type() )
        {
            select += ({ skills[ i ] });
        }
    }
    if ( sizeof( select ) )
    {
        return select;
    }
    return 0;
}

// 级别突破公式
varargs private int can_break_limit( object who, string skill, int usage )
{
    int lingwu, limit, jilei;
    mapping m_lingwu = who->query_lingwu_map();

    lingwu = m_lingwu[ skill ] + 1;
    limit = who->lingwu_limit( skill );
    jilei = who->query_jilei( skill );

    if ( usage <= 0 )
    {
        usage = 1;
    }

    //原来的公式:
    //if ( 100 / lingwu > random( 100 ) + 1 )
    //    return 1;
    if ( random( lingwu ) == 0 || jilei > usage * limit * 3 /2 )
    {
        return 1;
    }

    return 0;
}

// 为计算 wugong_power 所必须的排序
int sort_wugong( object who, string type )
{
    int i, j;
    int dengji_i, lingwu_i, dengji_j, lingwu_j;
    string *skills, temp;

    skills = query_wugong_list( who, type );
    if ( !sizeof( skills ) )
    {
        who->delete_temp("sort_wugong/" + type);
    }

    for ( i = 0; i < sizeof( skills ); i++ )
    {
        dengji_i = SKILL_D( skills[ i ] )->query_dengji();
        lingwu_i = who->query_lingwu(skills[ i ]);

        for ( j = i + 1; j < sizeof( skills ); j++ )
        {
            dengji_j = SKILL_D( skills[ j ] )->query_dengji();
            lingwu_j = who->query_lingwu(skills[ j ]);

            if (( dengji_i < dengji_j ) ||
                (( dengji_i == dengji_j ) && ( lingwu_i < lingwu_j )))
            {
                temp = skills[ i ];
                skills[ i ] = skills[ j ];
                skills[ j ] = temp;

                dengji_i=dengji_j;
                lingwu_i=lingwu_j;
            }
        }
    }

    set_temp( "sort_wugong/" + type, skills );
    return 1;
}

int improve_jilei(object who, string skill, int amount)
{
    int limit, bonus;
    string type;

    if ( !check_skill( skill ) )
    {
        return 0;
    }

    // NPC 暂时不考虑能增加积累
    if ( !userp( who ) && !(who->query("new_master") && who->query("can_improve")) )
    {
        return 0;
        //if ( !mapp(skills) ) skills = ([]);
        //if ( undefinedp( skills[ skill ] ) ) skills[ skill ] = 0;
    }

    if ( !amount || !who->query_jibie(skill) )
    {
        return 0;
    }

    who->improve_jilei_real(skill, amount);

    limit = lingwu_limit( who, skill );

    if ( who->query_jibie(skill) > who->query_lingwu(skill) ) 
    {
        if ( who->query_jilei(skill) > limit  && can_break_limit( who, skill ) )
        {
            who->improve_lingwu(skill, 1);
            who->set_jilei_real(skill, 0);

            tell_object( who, HIC "你的「" + to_chinese(skill) + "」进步了！\n" NOR );

            if ( functionp( SKILL_D(skill)->skill_improved() ) )
            {
                SKILL_D(skill)->skill_improved(who);
            }

            type = SKILL_D( skill )->query_xiuwei_type();
            sort_wugong( who, type );

            // PLAYER在武功的勤学苦练中，当武功取得一定进步后
            // 武学修为应该相应有所进步的。
                // 当武功每进步十级后，相应的武学修为有所进步。
            // 每次奖励5乘以这门武功的等级。
            // 在PLAYER练了从第一等到第九等的九门60级武功时
                // 总共能获得1350点修为，占到总修为的10%
            // 比例不是很高，修为还是主要从师傅请教所得。     
            // lin: 还是改成越往后得的越多好一点，我倾向于到了后边是没有师傅的。

            //if ( m_lingwu[ skill ] % 10 == 0 )
            //为什么要到10的倍数,还是能涨就涨的好
            //防止有人用死亡法练功,也让玩家不会白进步!
            //changed by tea 12.6.98
            /*if ( m_lingwu[ skill ] % 2 == 0 )
            {
                bonus = SKILL_D( skill )->query_dengji();
                
            	bonus += (int)this_object()->query_xiuwei_by_type( type );
            
                set_xiuwei_by_type( type, bonus );
            }*/
            who->improve_xiuwei(type, random(SKILL_D( skill )->query_dengji() + 1));
        }
    }
    //当LINGWU超过JIBIE时
    else
    {
        if ( who->query_jilei(skill) > 2 * limit  && can_break_limit( who, skill, 2 ) )
        {
            who->improve_lingwu(skill, 1);
            who->set_jilei_real(skill, 0);

            tell_object( who, HIC "你的「" + to_chinese(skill) + "」进步了！\n" NOR );
            if ( functionp( SKILL_D(skill)->skill_improved() ) )
            {
                SKILL_D(skill)->skill_improved(who);
            }

            type = SKILL_D( skill )->query_xiuwei_type();
            sort_wugong( who, type );

            // 如果LINGWU > JIBIE应该多奖励一点，是原来的两倍
            // 但是练习的速度，也只有原来的1/2了
            who->improve_xiuwei(type, random(SKILL_D( skill )->query_dengji() + 1) * 2);

//            if ( m_lingwu[ skill ] % 5 == 0 )
//            {
/*            bonus = SKILL_D( skill )->query_dengji();
//            bonus *= 5;
          if (type=="unarmed")
           {
           	bonus += (int)this_object()->query_xiuwei_by_type( type )-1;
            }
            else
            {
            	bonus += (int)this_object()->query_xiuwei_by_type( type );
            }
          
            set_xiuwei_by_type( type, bonus );
//            }
*/
        }
    }

    if ( !userp(who) && who->query("can_improve") )
    {
        //NPC领悟比大于100就可以自动进步
        while ( who->query_lingwu_ratio( skill ) > 100 )
        {
            who->improve_jibie( skill, 1 );
            who->improve_xiuwei(type, random(SKILL_D( skill )->query_dengji() + 1) + 1);
            who->run_command("chat* haha");
            who->run_command("chat 经过一番勤学苦练，我的【" + SKILL_D( skill )->chinese_name() + "】终于有所进境了!");
            who->save();
        }
    }

    return amount;
}

int skill_death_penalty(object who)
{
    string *sk;
    int i;
    int enable;
    mapping xiuwei_dec = ([ ]);
    mapping m_lingwu = who->query_lingwu_map();
    mapping m_jilei = who->query_jilei_map();
    mapping m_enable = who->query_enable_map();

    if ( !mapp( m_lingwu ) ||
         newbiep( who ) ) //who->query( "age" ) < SKILL_PENALTY_LIMIT )
    {
        return 0;
    }

    // 现在有三种选择
    enable = random( 3 );

    sk = keys( m_lingwu );

    if ( !mapp( m_jilei ) )
    {
        for ( i = 0; i < sizeof( sk ); i++ ) 
        {
            if ( SKILL_D( sk[i] )->is_knowledge() )
            {
                continue;
            }

            if ( enable == 2 || !mapp( m_enable ) )
            {
                m_lingwu[ sk[1] ] -= random(2);
            }
            else if ( mapp( m_enable ) && m_enable[ sk[i] ] - enable )
            {
                m_lingwu [ sk[ i ] ] --;
            }

            if ( m_lingwu[ sk[ i ] ] < 0 )
            {
                m_lingwu[ sk[i] ] = 0;
            }
        }
    }
    else
    {
        foreach ( string skill in sk ) //i = 0; i < sizeof( sk ); i++ ) 
        {
            if ( SKILL_D( skill )->is_knowledge() )
            {
                continue;   // literate 类不下降？
            }

            if ( (int) m_enable[skill] - enable ) // 需要降的武功。0: en, 1: !en, 2:all
            {
    //            int lingwu = m_lingwu[skill];
                if ( m_jilei[skill] > 0 )
                {
                    m_jilei[skill] = 0; // 损失了积累。
                }
                else
                {
                    string xiuwei_name, xiuwei_dengji;
                    m_lingwu[skill] --; // 降一个等级。
                    if ( m_lingwu[skill] < 0 )  // 不能小于0
                    {
                        m_lingwu[skill] = 0;
                    }
                    xiuwei_name = SKILL_D(skill)->query_xiuwei_type();
                    xiuwei_dengji = SKILL_D(skill)->query_dengji();
                    xiuwei_dec[ xiuwei_name ] += xiuwei_dengji;
                }
            }
        }
    }

    //map( xiuwei_dec, (: set_xiuwei_by_type( $1, (query_xiuwei_by_type($1) - (int)$2 / 2) ) :), who );
    sk = keys(xiuwei_dec);
    foreach ( string skill in sk )
    {
        who->set_xiuwei_by_type(sk, who->query_xiuwei_by_type(sk) - xiuwei_dec[sk] / 2);
    }

    //skill_map = 0;
    return 1;
}

string query_random_attack_type()
{
    return attack_type[random(sizeof(attack_type))];
}

string *query_all_skills(string type, int dengji)
{
    int j;
    string new_path;

    if ( member_array( type, skill_type ) < 0 )
    {
        return 0;
    }

    if ( dengji < 1 )
    {
        dengji = 1;
    }
    if ( dengji > 9 )
    {
        dengji = 9;
    }

    for ( j = dengji; j > 0; j-- )
    {
        new_path = sprintf("/system/skill/%s/level%d/", type, j);
        if ( undefinedp( new_search[ new_path ] ) )
        {
            continue;
        }

        return keys(new_search[ new_path ]);
    }

    return 0;
}

string query_attack_xiuwei(object me)
{
    object weapon;
    string xiuwei_type;

    weapon = me->query_temp("weapon");

    if ( !weapon )
    {
        xiuwei_type = "unarmed";
    }
    else
    {
        xiuwei_type = weapon->query("xiuwei_type");
    }

    if ( !xiuwei_type )
    {
        xiuwei_type = "zonggang";
    }

    return xiuwei_type;
}

