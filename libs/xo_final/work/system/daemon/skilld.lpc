mapping *get_all_action(object skill)
{
    switch ( skill->query_xiuwei_type() )
    {
        case "sword":
            return sword_action;
            break;

        case "blade":
            return blade_action;
            break;

        case "long":
            return long_action;
            break;

        case "short":
            return short_action;
            break;

        case "unarmed":
            return unarmed_action;
            break;

        case "dodge":
            return dodge_action;
            break;

        default:
            break;
    }

    return basic_action;
}

