void new_rehash(string dir, int level);

void create()
{
    int i, j;

    set("no_clean_up", 1);
    seteuid(geteuid());
    set("name", "武功精灵");
    set("id", "skilld");

    i = sizeof(skill_type);
    while ( i-- )
    {
        new_rehash(sprintf("/system/skill/%s", skill_type[i]), 1);

        for ( j = 1; j <= 9; j++ )
        {
            new_rehash(sprintf("/system/skill/%s/level%d", skill_type[i], j), j);
        }
    }

    xiuwei_interval = allocate(MAX_XIUWEI_LEVEL + 1);

    xiuwei_interval[0] = 0;

    //0 1000 2600 5000 8200 12200 17000 22600 29000 36200 44200 * 2
    for ( i = 1; i < MAX_XIUWEI_LEVEL + 1; i++ )
    {
        xiuwei_interval[i] = ((i + 1) * (i + 1) + i * i) * 400;
    }
}

void new_rehash(string dir, int level)
{
    int i;
    string *cmds;
    mapping level_skill = ([]);

    if ( dir[ sizeof( dir ) - 1 ] != '/' )
    {
        dir += "/";
    }

    cmds = get_dir(dir);
    i = sizeof(cmds);

    while ( i-- )
    {
        if ( 1 == sscanf( cmds[ i ], "%s.lpc", cmds[ i ] ) )
        {
            level_skill[cmds[i]] = level;
        }
    }

    if ( sizeof( cmds ) )
    {
        new_search[ dir ] = level_skill;
    }
}

string find_skill(string skill)
{
    int i, j;
    string new_path;

    i = sizeof( skill_type );

    while ( i-- ) 
    {
        new_path = sprintf("/system/skill/%s/", skill_type[i]);
        if ( undefinedp( new_search[ new_path ] ) )
        {
            continue;
        }

        if ( !undefinedp(new_search[ new_path ][skill]) )
        {
            return new_path + skill;
        }

        for ( j = 1; j <= 9; j++ )
        {
            new_path = sprintf("/system/skill/%s/level%d/", skill_type[i], j);
            if ( undefinedp( new_search[ new_path ] ) )
            {
                continue;
            }

            if ( !undefinedp(new_search[ new_path ][skill]) )
            {
                return new_path + skill;
            }
        }
    }

    //return "/d/place/skills/" + skill;
    return 0;
}

void test(string skill)
{
    write(HIY + SKILL_D(skill) + "==" + SKILL_D(skill)->query_dengji() + NOR "\n");
}

int *query_xiuwei_score()
{
    return xiuwei_interval;
}

int query_xiuwei_jibie(int ob_xiuwei)
{
    int i;

    for ( i = sizeof(xiuwei_interval) - 1; i >= 0 ; i-- )
    {
        if ( ob_xiuwei >= xiuwei_interval[i] )
        {
            return i;
        }
    }

    return 0;
}

int query_xiuwei_by_level(int level)
{
    if ( level >= sizeof(xiuwei_interval) )
    {
        return 2 * xiuwei_interval[sizeof(xiuwei_interval) - 1];
    }

    return xiuwei_interval[level];
}

