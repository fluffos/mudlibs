int valid_learn( object me, object skill )
{
    object weapon = me->query_temp( "weapon" );
    string weapon_type = skill->query_weapon_type();

    if ( "force" == skill->query_xiuwei_type() )
    {
        if ( (int)me->query("PKS") > 5 && (int)me->query_jibie(skill->skill_id()) >= 40 )
        {
            return notify_fail("你杀人过多，无法领悟更高深的" + skill->chinese_name() + "。\n");
        }
    }

    if ( weapon_type && "unarmed" != weapon_type )
    {
        if ( !weapon || weapon->query("weapon_type") != weapon_type )
        {
            return notify_fail("你必须先找一把适合的武器才能学习这项技能。\n");
        }
    }
    else
    {
        if ( weapon )
        {
            return notify_fail("你必须空手才能学习这项技能。\n");
        }
    }

	return 1;
}

int valid_lian( object me, object skill )
{
    object weapon = me->query_temp( "weapon" );
    string weapon_type = skill->query_weapon_type();

    if ( "force" == skill->query_xiuwei_type() )
    {
        return notify_fail(skill->chinese_name() + "只能通过修炼或者是使用来增加领悟度。\n");
    }

    if ( "dodge" == skill->query_xiuwei_type() )
    {
        if ( me->query("new_master") && me->query("can_improve") )
        {
            return 1;
        }

        if ( me->query_encumbrance() * 100 / me->query_max_encumbrance() < 10 )
        {
            return notify_fail("轻功必须负重练习。\n");
        }

        return 1;
    }

    if ( weapon_type && "unarmed" != weapon_type )
    {
        if ( !weapon || weapon->query("weapon_type") != weapon_type )
        {
            return notify_fail("你必须先找一把适合的武器才能练习这项技能。\n");
        }
    }
    else
    {
        if ( weapon )
        {
            return notify_fail("你必须空手才能练习这项技能。\n");
        }
    }

    return 1;
}

int valid_xiulian( object me, object skill )
{
    if ( "force" != skill->query_xiuwei_type() )
    {
        return notify_fail(skill->chinese_name() + "只能通过练习或者是使用来增加领悟度。\n");
    }

    if ( me->query("new_master") && me->query("can_improve") )
    {
        return 1;
    }

    if ( (int)me->query("bellicosity") >= 200 )
    {
        return notify_fail("你尝试着静思入定，可不知为什么，总是觉得很烦躁。\n");
    }

    return 1;
}

int query_dengji(object skill)
{
    string skill_id = skill->skill_id();

    int i, j;
    string new_path;

    i = sizeof( skill_type );

    while ( i-- ) 
    {
        for ( j = 1; j <= 9; j++ )
        {
            new_path = sprintf("/system/skill/%s/level%d/", skill_type[i], j);
            if ( undefinedp( new_search[ new_path ] ) )
            {
                continue;
            }

            if ( !undefinedp(new_search[ new_path ][skill_id]) && intp(new_search[ new_path ][skill_id]) )
            {
                return new_search[ new_path ][skill_id];
            }
        }
    }

    return 1;
}

