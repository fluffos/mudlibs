// placed.c
// PLACE_D
// by lnwm 98-09-22 
// 决定某个房间属于的区域。

#include <ansi.h>

//  XIYU        西域 (沙漠以西)含：天山，昆仑，高昌，龟兹等。
//  XIBEI       西北 (沙漠以东)含：兰州，兴庆，崆峒，一品堂等。
//  ZHONGYUAN   中原 含：洛阳，华山，丐帮，伏牛，忭京，少林，五台等。
//  GUANWAI     关外 含：幽州，长白山等。
//  XINAN       西南 含：青城，成都，峨嵋，大理，无量，神农等。
//  JIANGNAN    江南 含：楚州，扬州，苏州，慕容等。
//  OTHER       其他 含：沙漠，侠客岛等。


void create() {
  seteuid(getuid());
}

string Contain(object room) {
  string file, *dir;

  if (!room)
    return "NOTFOUND";

  file = file_name(room);
  dir = explode(file, "/");

  switch (dir[2]) {
    case "xiyu":
    case "kunlun":
    case "gaochang":
    case "tianshan":
    case "hami": return "XIYU";
    case "xibei":
    case "kongdong":
    case "lanzhou":
    case "liangzhou":
    case "xingqing":
    case "yipin_tang": return "XIBEI";
    case "huashan":
    case "zhongyuan":
    case "shaolin":
    case "capital":
    case "luoyang":
    case "newbie":
    case "nanyang": return "ZHONGYUAN";
    case "xinan":
    case "duanshi":
    case "emei":
    case "shennong":
    case "wuliang":
    case "dali":
    case "cunzi": return "XINAN";
    case "chuzhou":
    case "hangzhou":
    case "yangzhou": return "JIANGNAN";
    case "matou":
    case "death":
    case "wiz":
    case "desert":
    case "xkdao": return "OTHER";
    default: return "OTHER";
  }
}

void drop_all_users(object me) {
  int i;
  object *all;

  if (!me) {
    return;
  }

  all = all_inventory(me);

  for (i = 0; i < sizeof(all); i++) {
    if (!userp(all[i])) {
      continue;
    }

    message_vision("$N把$n往地下一摔。\n", me, all[i]);
    all[i]->move("/clone/misc/void");
  }
}
