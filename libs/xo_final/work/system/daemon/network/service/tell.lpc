#include "mudlib.h"
#include "../intermud.h"
#include <ansi.h>

#define SERVICE_TELL

void eventReceiveTell(string mud, string from, string to, mixed *data) {
  object user;
  string errmsg, msg;
  //NBUG( data );
  /*    if( file_name(previous_object()) != INTERMUD_D )
        return;*/
  user = find_player(to);
  //NBUG( user );
  if (!user) {
    errmsg = "目前" + mud_name() + "并没有这个玩家。";
  } else if (user->query("env/tunetell")) {
    errmsg = "对方不愿意收听其他人的tell。";
  } else {
    msg = sprintf(GRN "%s(%s@%s)告诉你：\"%s\"" NOR "\n", data[0], from, mud, data[1]);
    message("vision", msg, user);
    user->set_temp("reply", from + "@" + mud);
    return;
  }
  //NBUG( errmsg );
  SendToUser("error", mud, from, ({ "unk-user", errmsg }));
}

void eventSendTell(string mud, string target, string uname, string msg) {
  SendToUser("tell", mud, target, ({ uname, msg }));
}
