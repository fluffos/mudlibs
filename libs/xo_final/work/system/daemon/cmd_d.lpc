mapping search = ([]);

private void create()
{
    seteuid(ROOT_UID);
    //set("name", "test精灵");
    //set("id", "cmd_d");
}

void rehash(string dir)
{
    int i;
    string *cmds;

    if ( dir[ sizeof( dir ) - 1 ] != '/' )
        dir += "/";
    cmds = get_dir(dir);
    i = sizeof(cmds);
    while ( i-- )
        if ( !sscanf( cmds[ i ], "%s.lpc", cmds[ i ] ) )
        {
            if ( i == 0 )
                cmds = cmds[ 1..sizeof(cmds) ];
            else if ( i == sizeof( cmds ) )
                cmds = cmds[ 0..<2 ];
            else
                cmds = cmds[ 0..i - 1 ] + cmds[ i + 1..<1 ];
        }
    if ( sizeof( cmds ) )
        search[ dir ] = cmds;
}

string find_command(string verb, string *path)
{
    int i;

    if ( !pointerp( path ) ) return 0;

    i = sizeof( path );
    while ( i-- ) 
    {
        if ( undefinedp( search[ path[ i ] ] ) )
            rehash( path[ i ] );
        if ( undefinedp( search[ path[ i ] ] ) )
            continue;
        if ( member_array( verb, search[ path[ i ] ] ) != -1 )
            return path[ i ] + verb;
    }
    return 0;
}

int command_hook(object this, string verb, string file, string arg)
{
    object env;

#ifdef PROFILE_COMMANDS
    int mem, utime, stime;
    mapping info;

    mem = memory_info();
    info = rusage();
    utime = info["utime"];
    stime = info["stime"];
#endif

/*    if ( stringp( file ) && BIWU_D->query_biwu() )
       //  && !environment( this_object() )->query("biwu") )
       {
            string * file_name = explode( file, "/" );
            if ( file_name[ 1 ] == "verb" )
            {
                switch ( file_name[ 2 ] ) 
                {
                    case "fight"    : 
                    case "bihua"    : 
                    case "guard"    :
                    case "kill"     :
                    case "duilian"  :  
                    return notify_fail("现在是笑傲江湖比武大会时间，禁止所有其他战斗。\n");
                }
