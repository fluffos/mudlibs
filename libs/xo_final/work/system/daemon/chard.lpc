string comm_man_name()
{
    return surname[ random ( sizeof ( surname ) ) ] + manname1[ random ( sizeof( manname1 ) ) ];
}

mixed query_prop(object who, string prop, mixed raw)
{
    if ( "combat_exp" == prop && 0 < who->query_xiuwei_by_type(prop) )
    {
        return system_maxexp();
    }

    return 0;
}

mixed add_prop(object who, string prop, mixed data)
{
    int old_exp;
    int new_exp;

    if ( "combat_exp" == prop )
    {
        old_exp = who->query("combat_exp", 1);
        new_exp = (int)data;
        if ( system_maxexp() - old_exp < new_exp )
        {
            who->set_xiuwei_by_type(prop, (int)who->query_xiuwei_by_type(prop) + 1);
            return new_exp - (system_maxexp() - old_exp);
        }
    }

    return data;
}

string query_short(object who, string str, int raw)
{
    string mask = who->query_temp_marks("apply/short");

    if (sizeof(mask))
    {
        str = (string) mask[sizeof(mask) - 1];
    }
    else if (!raw)
    {
        string nick = who->query("nickname");

        if (stringp(nick))
        {
            str = sprintf("「%s」%s", nick, str);
        }
    }

    if (!raw)
    {
        if( who->query_short_desc() )
            str = who->query_idname() + who->query_short_desc();

        if (who->is_ghost())
            str = HIB "(鬼气) " NOR + str;
        if (who->query_temp_marks("is_riding"))
            str += "骑着一" + who->query_temp_marks("is_riding");
        if( who->is_fighting() )
                str += HIR " <战斗中>" NOR;
        if (who->query_temp("netdead"))
        {
            switch( who->query("doing") )
            {
            case "breakup":
            case "animaout":
            case "invent":
                    str += HIY " <闭关中>" NOR;
                    break;

            case "closed":
            case "xiulian":
                    str += HIY " <修炼中>" NOR;
                    break;

            case "scheme":
                    str += HIW " <计划中>" NOR;
                    break;

            case "trigger":
                    str += HIW " <触发中>" NOR;
                    break;

            default:
                    str += HIG " <断线中>" NOR;
            }
        }
        else if (who->is_input())
            str += "正在输入文字。";
        else if (who->query_temp("mask_exercising"))
            str += "正在修炼内力。";
        else if (who->query_temp("mask/dazuo"))
            str += "正在修炼内力。";
        else if (who->is_inedit())
            str += "在编辑什么东西。";
        else if (interactive(who) && !who->query("doing")
                 && query_idle(who) > 120)
            str += "在这里发呆。";
        if (!living(who))
            str += HIR + who->query("disable_type") + NOR;
        // if NPC is not human, no title for it
        if (who->query("race") == "人类" && !sizeof(mask))
        {
            string title = who->query("title");

            // if NPC has title, don't display zhiye
            if ((!userp(who)) && stringp(title))
            {
                str = sprintf("%s %s", title, str);
            }
            else
                str = sprintf("%s %s", RANK_D->query_zhiye(who), str);
        }
    }

    return str;
}

#define SCHEME_CMD          "/cmds/verb/scheme"
void heart_beat_hook(object who)
{
    if ( !who )
    {
        return;
    }

    // 检测辅助任务  
    MYGIFT_D->check_curgift(who);

    if ( who->query("doing") == "scheme" )
    {
        // executing schedule now
        SCHEME_CMD->execute_schedule(who);
    }
}

int forbid_fight(object me, object who)
{
    if ( !me )
    {
        return 1;
    }

    if ( me == who )
    {
        return 1;
    }

    if ( who && !userp(who) )
    {
        return 0;
    }

    if ( me->query("taskguai") && me->owner() && who != me->owner() )
    {
        return 1;
    }

    if ( who && who->query("taskguai") && who->owner() && me != who->owner() )
    {
        return 1;
    }

    return 0;
}

int forbid_duilian(object me, object who)
{
    return forbid_fight(me, who);
}

int forbid_bihua(object me, object who)
{
    return forbid_fight(me, who);
}

int forbid_kill(object me, object who)
{
    return forbid_fight(me, who);
}

int forbid_damage(object me, object who)
{
    return forbid_fight(me, who);
}

int forbid_wound(object me, object who)
{
    return forbid_fight(me, who);
}

void clean_up_enemy(object who)
{
    // 对 perform 的取消！ add this by tea 10.24.98  8:00 in the morning!!!
    if( !stringp(who->query_temp("perform/attack/call"))
        && who->query_temp("perform/attack/name") )
    {
        who->delete_temp("perform/attack");
        tell_object(who, "PERFORM CANCEL.\n");
    }
}

void remove_enemy(object who, object ob)
{
    // 对 perform 的取消！ add this by tea 10.24.98  8:00 in the morning!!!
    if( who->query_temp("perform/attack/target") == ob )
    {
        who->delete_temp("perform/attack");
        tell_object(who, "PERFORM CANCEL.\n");
    }
}

varargs int in_war(object ob, object who)
{
    return ob->is_fighting(who) || ob->is_duilianing(who);
}

