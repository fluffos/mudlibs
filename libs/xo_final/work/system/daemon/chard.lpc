#include <ansi.h>
#include <race.h>
#include <weapon.h>
#include <login.h>
#include <command.h>

inherit F_DBASE;

void create()
{
	seteuid( getuid() );
    set("name", "角色精灵");
    set("id", "chard");
}

void setup_char(object ob)
{
    string race;
    mapping my;

    race = ob->query("race");
    if ( !stringp( race ) )
	{
        race = "人类";
        ob->set("race", "人类");
    }

    switch ( race )
	{
        case "人类":
            HUMAN_RACE->setup_human(ob);
            break;

        case "妖魔":
            MONSTER_RACE->setup_monster(ob);
            break;

        case "野兽":
        case "走兽":
        case "昆虫":
        case "飞禽":
        case "爬蛇":
        case "家畜":
        case "走畜":
            BEAST_RACE->setup_beast(ob);
            break;

        default:
            error("CHAR_D: " + race + "不存在.\n");
    }

    my = ob->query_entire_dbase();

    if ( undefinedp(my["gin"]) ) my["gin"] = my["max_gin"];
    if ( undefinedp(my["kee"]) ) my["kee"] = my["max_kee"];
    if ( undefinedp(my["sen"]) ) my["sen"] = my["max_sen"];

    if ( undefinedp(my["eff_gin"]) ) my["eff_gin"] = my["max_gin"];
    if ( undefinedp(my["eff_kee"]) ) my["eff_kee"] = my["max_kee"];
    if ( undefinedp(my["eff_sen"]) ) my["eff_sen"] = my["max_sen"];

    if ( !ob->query_max_encumbrance() )
    {
        ob->set_max_encumbrance( my["str"] * 5000 );
    }

    //ob->reset_action();
}

int max_food_capacity(object ob)
{
    return ob->query_weight() / 200;
}

int max_water_capacity(object ob)
{
    return ob->query_weight() / 200;
}

varargs object make_corpse(object victim, object killer)
{
    int i;
    object corpse, *inv;

    if ( victim->is_ghost() ) 
	{
        inv = all_inventory(victim);
        inv->owner_is_killed(killer);
        inv -= ({ 0 });
        i = sizeof(inv);
        while ( i-- )
			inv[ i ]->move( environment( victim ) );
        return 0;
    }
    if( !victim->query("corpse_ob") ||
        !corpse = new( victim->query("corpse_ob")) )
      corpse = new(CORPSE_OB);
     if ( userp( victim ) )
     {
       corpse->set("nokantou", 1);
     }
    corpse->set_name( victim->name(1) + "的尸体", ({ "corpse" }) );
    corpse->set("long", victim->long() + "然而，" +
		gender_pronoun(victim->query("gender")) +
		"已经死了，只剩下一具尸体静静地躺在这里。\n");
    corpse->set("age", victim->query("age"));
    corpse->set("gender", victim->query("gender"));
    corpse->set("victim_name", victim->name(1));
    corpse->set_weight( victim->query_weight() );
    corpse->set_max_encumbrance( victim->query_max_encumbrance() );
    corpse->move(environment(victim));
        
    // Don't let wizard left illegal items in their corpses.
    if ( !wizardp(victim) ) 
	{
        inv = all_inventory(victim);
        inv->owner_is_killed(killer);
        inv -= ({ 0 });
        i = sizeof(inv);
        while ( i-- )
		{
            inv[ i ]->move(corpse);
            if (( inv[ i ]->is_equipped() == EQUIP_WORN ) &&
                ( !inv[ i ]->wear() ))
			{
                inv[ i ]->move(environment(victim));
            }
        }
    }

    return corpse;
}

string *all_keeginsen = ({ "kee","gin","sen" });

void powerup(object obj)
{
    int i;

    for( i = 0; i < sizeof(all_keeginsen); i++ )
    {
        obj->set("eff_" + all_keeginsen[i], obj->query("max_" + all_keeginsen[i]));
        obj->set(all_keeginsen[i], obj->query("max_" + all_keeginsen[i]));
    }

    obj->set("food", obj->max_food_capacity());
    obj->set("water", obj->max_water_capacity());
    obj->set("force", 2 * obj->query("max_force"));

    obj->clear_condition();
}

int query_gongfang(object obj)
{
    int attack;

    if (undefinedp(obj->query("env/attack")) || !intp(obj->query("env/attack")))
    {
        attack = 50;
    }
    else
    {
        attack = obj->query("env/attack");
        if (attack < 0)
            attack = 0;
        else if (attack > 100)
            attack = 100;
    }
    return attack;
}

int query_shili(object obj)
{
    int shili;

    if (undefinedp(obj->query("env/shili")) || !intp(obj->query("env/shili")))
        shili = 100;
    else
    {
        shili = obj->query("env/shili");
        if (shili < 1)
            shili = 1;
        else if (shili > 100)
            shili = 100;
    }
    return shili;
}

int query_combat_brief(object obj)
{
    int combat_brief;

    if ( !userp(obj) )
    {
        return 1;
    }

    if (undefinedp(obj->query("env/combat_brief")) ||
        !intp(obj->query("env/combat_brief")))
    {
        combat_brief = 0;
    }
    else
    {
        combat_brief = obj->query("env/combat_brief");
    }
    return combat_brief;
}

int can_act(object this)
{
    if ( !living(this) )
    {
        return 0;
    }

    if ( this->is_busy() || 
         this->is_lianing() || 
         this->is_duilianing() ||
         this->is_fighting() )
    {
        return notify_fail("你现在正忙于其他的事情，不可能分心。\n");
    }

    if ( this->query_temp("disable_path") == "verb" )
    {
        if ( this->query_temp("disable_status") )
        {
            return notify_fail(this->query_temp("disable_status") );
        }

        return 0;
    }

    return 1;
}

int unconcious(object this)
{
    object defeater;

    if ( !living( this ) )
    {
        return 1;
    }

    if ( wizardp( this ) && this->query( "env/immortal" ) )
    {
        return 0;
    }

    if ( this->run_override("unconcious") )
    {
        return 0;
    }

    message( "system", HIR "\n你的眼前一黑，接着什么也不知道了……\n\n" NOR, this );
    this->disable_player( " <昏迷不醒>" );

    this->set( "gin", 0 );
    this->set( "kee", 0 );
    this->set( "sen", 0 );
    this->set_temp( "block_msg/all", 1 );
    COMBAT_D->announce( this, "unconcious" );

    // 消除战斗标记
    this->remove_all_enemy();

    // added by yuhj, 消除对练标记
    this->remove_all_duishou();

    defeater = this->query_last_damage_from();
    this->set_temp( "faint_by", defeater );

    return 1;
}

varargs void revive( object this, int quiet )
{
    while ( environment(this)->is_character() )
    {
        this->move( environment( environment() ) );
    }

    this->enable_player();
    this->set_temp( "block_msg/all", 0 );

    if ( !quiet )
    {
        COMBAT_D->announce( this, "revive" );
        message( "system", HIY "\n不知过了多久。。。。。。。。慢慢地你又恢复了知觉。\n\n" NOR, this );
    }
}

int die(object this)
{
    object corpse, killer;
    object env = environment( this );

    if ( wizardp( this ) && this->query( "env/immortal" ) )
    {
        return 1;
    }

    if ( env )
    {
        all_inventory( env )->remove_killer( this );
    }

    if ( env && env->query("no_death") )
    {
        this->unconcious();
        return 0;
    }

    if ( env && env->query( "no_die" )         //是比武的场所，而且这
        && this->query_temp( "pending/biwu" ) )         //个人在比武中。
    {
        this->remove_killer( this->query_temp( "last_damage_from" ) );
        this->revive();
        this->delete_last_damage_from();
        COMBAT_D->announce( this, "biwu" ); //在这里加了个比武时的表现。——Lala
        return 1;
    }

    if ( this->run_override("die") )
    {
        return 1;
    }

    REWARD_D->killer_reward( this );        // 凶手得到报应。
    this->delete("vendetta");		    // 删除仇杀！
    this->clear_condition();                // Clear all the conditions by death.
    this->add( "max_age", -1 );             // 死一次少活一年。
    this->enable_player();

    corpse = make_corpse( this, killer );
    if ( objectp( corpse ) )
    {
        //有标志"edible"为 1 ,在尸体上加可加工的标志
        if ( this->query( "edible" ) )
        {
            corpse->set( "refine_name", this->query( "refine_name" ) );
            corpse->set( "number", this->query( "number" ) );
            if ( this->query( "refine_msg" ) )
            {
              corpse->set( "refine_msg", this->query( "refine_msg" ) );
            }
        }
        corpse->move( environment(this) );
    }

    this->revive( 1 );

    COMBAT_D->announce( this, "dead" );     //把宣布死亡挪到这里来了。——Lala

    this->remove_all_killer();

//    this->dismiss_team();
//  哪个傻瓜加的这句??? dismiss_team()要带参数的. --by lnwm
    if ( userp( this ) )
    {
        this->set( "gin", 1 );
        this->set( "kee", 1 );
        this->set( "sen", 1 );
        this->set( "eff_gin", 1 );
        this->set( "eff_kee", 1 );
        this->set( "eff_sen", 1 );
        this->set_ghost();
        this->delete_last_damage_from();
        this->delete_all_marks();
        this->delete_all_temp_marks();
        //MARRY_D->divorce( this );
        this->move( DEATH_ROOM );
    }
    else if ( this->query("new_master") )
    {
        rm( this->query_save_file() + __SAVE_EXTENSION__ );
        destruct( this );
    }
    else
    {
        destruct( this );
    }

    return 1;
}

// 返回每次可能恢复的数量
int heal_amount(object this)
{
    mapping my;
    int amount;

    my = this->query_entire_dbase();
    amount =  (my[ "con" ] + random( my[ "con" ] )) * 2 ;
    // 除以一个固定的数并不一定好
    amount += my[ "max_force" ] / 10;
    return amount;
}

// 用来恢复三要素的有效值, 返回 1 表示需要 update_flag++
int heal_body( object this, string prop )
{
    mapping my;

    my = this->query_entire_dbase();

    if ( my[ prop ] >= my[ "eff_" + prop ] )
    {
        my[ prop ] = my[ "eff_" + prop ];
        if ( my[ "eff_" + prop ] < my[ "max_" + prop ] )
        {
            my[ "eff_" + prop ]++;
            return 1;
        }
        return 0;
    }
    return 1;
}

// 饥饿计数器, 当水或食物其中一个在零以下时, 每次心跳我们就增加一次,
// 现在设定为饿或渴三天没有事, 第四天开始减少三要素值.
// 12hour 等于 1year, 2m = 1d, 所以一天有 60 次心跳.
#define DAY_BEAT    60
int heal_up(object this)
{
    int update_flag;
    mapping my;

    //if( this_object()->is_fighting() ) return -1;

    if ( this->query("doing") && this->query("doing") != "scheme" )
    {
        //闭关不消耗
        return 1;
    }

    update_flag = 0;

    my = this->query_entire_dbase();

    if ( my["water"] > 0 )
    {
        if ( userp( this ) )
        {
            this->set_hungry_tick(0);
            my["water"] -= 1;
        }
        update_flag++;
    }
    else
    {
        tell_object(this, "你感到口渴。\n" );
    }

    if ( my["food"] > 0 )
    {
        if ( userp( this ) )
        {
            this->set_hungry_tick(0);
            my["food"] -= 1;
        }
        update_flag++;
    }
    else
    {
        tell_object(this, "你感到肚子好饿。\n" );
    }

    if ( userp( this ) )
    {
        if ( ( my[ "water" ] < 1 ) || ( my[ "food" ] < 1 ) )
        {
            this->add_hungry_tick(1);
            if ( this->query_hungry_tick() > 3 * DAY_BEAT )
            {
                if ( 10 < this->query("gin") )
                {
                    this->receive_damage( "gin", 1 );
                }
                if ( 10 < this->query("kee") )
                {
                    this->receive_damage( "kee", 1 );
                }
                if ( 10 < this->query("sen") )
                {
                    this->receive_damage( "sen", 1 );
                }
            }

            return update_flag;
        }
    }

    my["gin"] += heal_amount(this) / 2;
    if ( heal_body( this, "gin" ) )
    {
        update_flag++;
    }

    my["kee"] += heal_amount(this);
    if ( heal_body( this, "kee" ) )
    {
        update_flag++;
    }

    my["sen"] += heal_amount(this);
    if ( heal_body( this, "sen" ) )
    {
        update_flag++;
    }

    //if ( my["food"] < 1 && userp( this_object() ) )
    //    return update_flag;

    if ( my["max_force"] && my["force"] < my["max_force"] )
    {
    	if ( random(500) == 1 )
    	{
    	    this->apply_condition("ganmao", 30);
    	}

        my["force"] += this->query_jibie( my["using_force"] );
        if ( my["force"] > my["max_force"] )
        {
            my["force"] = my["max_force"];
        }
        update_flag++;
    }

    return update_flag;
}

