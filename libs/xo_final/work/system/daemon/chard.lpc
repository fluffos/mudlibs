string convert_prop(string prop)
{
    if ( "max_qi" == prop )
    {
        return "max_kee";
    }
    if ( "qi" == prop )
    {
        return "kee";
    }
    if ( "max_jingli" == prop || "max_jing" == prop )
    {
        return "max_gin";
    }
    if ( "jingli" == prop || "jing" == prop )
    {
        return "gin";
    }
    if ( "max_neili" == prop )
    {
        return "max_force";
    }
    if ( "neili" == prop )
    {
        return "force";
    }
    if ( "jiali" == prop )
    {
        return "force_factor";
    }

    return prop;
}

int receive_message (object this, string msgclass, string msg)
{
    string subclass, *ch;

    if (!interactive (this))
    {
        this->relay_message (msgclass, msg);
        return 0;
    }

    if (sscanf (msgclass, "%s:%s", subclass, msgclass) == 2)
    {
        switch (subclass)
        {
            case "channel":
                ch = this->query ("channels");
                if (!pointerp (ch) || member_array (msgclass, ch) == -1)
                {
                    return 0;
                }
                break;

            case "outdoor":
                if (!environment (this) || !environment (this)->query ("outdoors"))
                {
                    return 0;
                }
                break;

            default:
                error ("Message: Invalid Subclass " + subclass + ".\n");
                return 0;
                break;
        }
    }

    if (this->query_temp ("block_msg/all")
        || this->query_temp ("block_msg/" + msgclass)
        || this->query ("blind"))
    {
        return 0;
    }

    return 1;
}

string write_prompt(object this)
{
    mixed prompt = this->query ("env/prompt");
    mapping my;
    string *dir, hp, cwd = this->query ("cwd");
    
    if (!cwd)
    {
        cwd = "";
    }
    else
    {
        cwd = sprintf ("%s", cwd == "/" ? "/" : cwd[0.. < 2]);
    }

    if (stringp (prompt))
    {
        my = this->query_entire_dbase ();
        dir = explode (file_name (environment (this)), "/");

        if (strsrch (prompt, "$HP") > -1)
        {
            hp = sprintf ("精神:%s%d%%" NOR " 生命:%s%d%%" NOR " 体能:%s%d%%" NOR,
            HP_CMD->status_color (my["gin"], my["max_gin"]),
                  my["gin"] * 100 / my["max_gin"],
            HP_CMD->status_color (my["kee"], my["max_kee"]),
                  my["kee"] * 100 / my["max_kee"],
            HP_CMD->status_color (my["sen"], my["max_sen"]),
                  my["sen"] * 100 / my["max_sen"]);
            prompt = replace_string (prompt, "$HP", hp);
        }
        prompt = replace_string(prompt, "$D", "日期:" + ctime(time())[0..9]);
        prompt = replace_string(prompt, "$T", "时间:" + ctime(time())[11..18]);

        if (wizardp(this))
        {
            prompt = replace_string (prompt, "$L", "位置:" +
                       chinese_place_name (dir[2]));
            prompt = replace_string (prompt, "$P", "工作目录:" + cwd);
        }
        prompt = replace_string (prompt, "$$", "$");
        prompt = replace_string (prompt, "$_", "\n");
        prompt += ">";
    }
    else
    {
        prompt = ">";
    }

    return prompt;
}

void reset_character(object who)
{
    if ( userp(who) && (int) who->query("thief") > 0 )
    {
        who->add("thief", -1);
    }
}

