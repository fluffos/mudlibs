int debug_meet = 0;
int debug_fight = 0;
int debug_kill = 0;
int debug_learn = 0;
int debug_drug = 0;
int debug_item = 0;
int debug_skip_npc = 0;

int rzr_id = 0;
int max_npcs = 10;

int get_max_npcs() {
  return max_npcs;
}

int set_max_npcs(int count) {
  max_npcs = count;
  return 1;
}

int get_next_rzr_id() {
  int i;

  for (i = 0; i < max_npcs * 2; i++, rzr_id++) {
    if (max_npcs * 2 < rzr_id) {
      rzr_id = 1;
    }

    if (!find_living("rzr" + rzr_id)) {
      break;
    }
  }

  //CHANNEL_D->do_channel(this_object(), "rzr", "rzr " + rzr_id );
  rzr_id++;

  return rzr_id - 1;
}

int is_debug_meet() {
  return debug_meet;
}

int is_debug_fight() {
  return debug_fight;
}

int is_debug_kill() {
  return debug_kill;
}

int is_debug_learn() {
  return debug_learn;
}

int is_debug_drug() {
  return debug_drug;
}

int is_debug_item() {
  return debug_item;
}

int is_debug_skip_npc() {
  return debug_skip_npc;
}

int set_debug_meet(int flag) {
  debug_meet = flag;
  return 1;
}

int set_debug_fight(int flag) {
  debug_fight = flag;
  return 1;
}

int set_debug_kill(int flag) {
  debug_kill = flag;
  return 1;
}

int set_debug_learn(int flag) {
  debug_learn = flag;
  return 1;
}

int set_debug_drug(int flag) {
  debug_drug = flag;
  return 1;
}

int set_debug_item(int flag) {
  debug_item = flag;
  return 1;
}

int set_debug_skip_npc(int flag) {
  debug_skip_npc = flag;
  return 1;
}

void debug_msg(string msg) {
  CHANNEL_D->do_channel(this_object(), "debug", msg);
}

void announce_msg(string msg) {
  CHANNEL_D->do_channel(this_object(), "rzr", msg);
}

void init_rzr() {
  if (!objectp(find_object(MANMADE_NPC)) &&
    catch(load_object(MANMADE_NPC))) {
    return;
  }
}

void continue_load_rzr(string *rzr_files, int index, int max_id, int count) {
  int temp = 0;
  object rzr;

  init_rzr();

  if (count >= max_npcs) {
    for (temp = count; temp < sizeof(rzr_files); temp++) {
      rm(DATA_DIR "rzr/" + rzr_files[temp]);
    }
  }

  if (index >= sizeof(rzr_files) || count >= max_npcs) {
    remove_call_out("generate_npc");
    call_out("generate_npc", 5, this_object());
    return;
  }

  // must use the one defined for this class, can not use local variable
  if (sscanf(rzr_files[index], "rzr%d.o", temp) != 1) {
    call_out("continue_load_rzr", 3, rzr_files, index + 1, max_id, count);
    return;
  }

  // check if the rzr is already in system
  if (find_living("rzr" + temp)) {
    call_out("continue_load_rzr", 3, rzr_files, index + 1, max_id, count);
    return;  // don't load rzr if it is already in the system
  }

  rzr = new(MANMADE_NPC);  // this call will increase rzr_id by 1
  rzr->set("id", "rzr" + temp);
  rzr->restore();
  rzr->set_name(rzr->query("name"), ({ "rzr" + temp, "rzr" }));
  rzr->set_living_name("rzr" + temp);
  rzr->set_manmade_npc_chats();
  if (!rzr->random_place()) {
    rzr->disappear();
    //分配地址失败，则继续重建该rzr
    call_out("continue_load_rzr", 3, rzr_files, index, max_id, count);
    return;
  }

  tell_room(environment(rzr), rzr->query("name") + "(" + rzr->query("id")
    + ") 忽然出现在一阵烟雾中。\n");
  announce_msg(rzr->query("name") + "(" + rzr->query("id")
    + ") 降生在[" + environment(rzr)->query("short") + "]");

  count++;
  if (temp > max_id) {
    max_id = temp;
  }

  rzr_id = max_id + 1;
  call_out("continue_load_rzr", 3, rzr_files, index + 1, max_id, count);
}

void load_rzrs() {
  string *rzr_files;

  rzr_files = get_dir(DATA_DIR "rzr/*.o");

  //destruct(new(MANMADE_NPC));
  init_rzr();

  if (!rzr_files) {
    remove_call_out("generate_npc");
    call_out("generate_npc", 5, this_object());
    return;
  }

  remove_call_out("continue_load_rzr");
  call_out("continue_load_rzr", 3, rzr_files, 0, 0, 0);
}

int generate_npc(object ob) {
  int i, count, real_count;
  object *rzrs;
  string *rzr_files;

  init_rzr();

  rzrs = children(MANMADE_NPC);
  count = sizeof(rzrs);
  real_count = 0;

  for (i = 0; i < count; i++) {
    if (environment(rzrs[i])) {
      real_count++;
      rzrs[i]->enable_heart_beat();
    }
  }

  if (real_count < max_npcs) {
    object env;
    object rzr;

    rzr = new(MANMADE_NPC);
    if (!rzr->random_place()) {
      rzr->disappear();
    } else {
      tell_room(environment(rzr), rzr->query("name") + "(" + rzr->query("id")
        + ") 忽然出现在一阵烟雾中。\n");
      announce_msg(rzr->query("name") + "(" + rzr->query("id")
        + ") 降生在[" + environment(rzr)->query("short") + "]");
    }
  }

  rzr_files = get_dir(DATA_DIR "rzr/*.o");
  if (rzr_files && arrayp(rzr_files) && 0 < sizeof(rzr_files)) {
    count = random(sizeof(rzr_files));
    if (sscanf(rzr_files[count], "rzr%d.o", i) == 1) {
      if (!find_living("rzr" + i)) {
        rm(DATA_DIR "rzr/" + rzr_files[count]);
      }
    }
  }

  remove_call_out("generate_npc");
  call_out("generate_npc", 5, this_object());

  return 1;
}

void shuffle_rzrs() {
  int i, count, index;
  object *rzrs;

  init_rzr();

  rzrs = children(MANMADE_NPC);
  count = sizeof(rzrs);

  if (count < 10) {
    for (i = 0; i < count; i++) {
      if (environment(rzrs[i]) && rzrs[i]->random_place()) {
        tell_room(environment(rzrs[i]), rzrs[i]->query("name") + "(" + rzrs[i]->query("id")
          + ") 忽然出现在一阵烟雾中。\n");
      }
    }

    remove_call_out("shuffle_rzrs");
    call_out("shuffle_rzrs", 900, this_object());
    return;
  }

  for (i = 0; i < 10; i++) {
    index = random(count);

    if (rzrs[index]->query("newquest") || rzrs[index]->query("oldquest")) {
      continue;
    }

    if (rzrs[index]->random_place()) {
      tell_room(environment(rzrs[index]), rzrs[index]->query("name") + "(" + rzrs[index]->query("id")
        + ") 忽然出现在一阵烟雾中。\n");
    }
  }

  remove_call_out("shuffle_rzrs");
  call_out("shuffle_rzrs", 900, this_object());
}

void destroy_all_npcs() {
  object *rzrs;
  object rzr;
  int i, count;
  object env;

  announce_msg("因为人造人作恶多端, 大天地决定将系统中的所有人造人即时处死");
  rzrs = children(MANMADE_NPC);
  count = sizeof(rzrs);

  for (i = 0; i < count; i++) {
    rzr = rzrs[i];
    env = environment(rzr);
    if (env) {
      tell_room(env, "只见天上一道闪电不偏不倚地击中 " + rzr->query("name") + "(" + rzr->query("id")
        + ") ，将之化为一堆灰烬。\n");
      rzr->disappear();
    }
  }
}

void create() {
  seteuid(getuid());
  set("name", "人造人系统精灵");
  set("id", "manmaded");

  CHANNEL_D->do_channel(this_object(), "sys", "人造人系统已经启动。");

  remove_call_out("generate_npc");

  destroy_all_npcs();

  init_rzr();

  remove_call_out("load_rzrs");
  call_out("load_rzrs", 5);

  remove_call_out("shuffle_rzrs");
  call_out("shuffle_rzrs", 5);
}

string generate_name() {
  return surname[random(sizeof(surname))] + firstname[random(sizeof(firstname))];
}

void remove_rzr(object who) {
  string my_file = who->query_save_file() + __SAVE_EXTENSION__;

  rm(my_file);
}
