// Mutli.Deny and Mutli.Allow...
int CheckDupIp(object ob) {
  return FALSE;
}

// new 的检查 -- 5 min才能new一个
int RegisterNew(object ob) {
  string my_ip = query_ip_number(ob);
  if (!ob)
    return 0;
  if (!sizeof(__NewIps)) {
    __NewIps = ([ my_ip: time() ]);
    return 1;
  }
  foreach (string ip, int t in __NewIps) {
    if (ip == my_ip) {
      if (time() - t > 5 * 60) {
        __NewIps[ip] = time();
        return 1;
      } else {
        return 0;
      }
    }
  }
  __NewIps[my_ip] = time();
  return 1;
}
