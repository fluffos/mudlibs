// ban.c

inherit F_CLEAN_UP;
inherit F_SAVE;
inherit F_DBASE;

private string array __Sites = 0;
private string array __Names = 0;
private nosave string array __tmpSites = 0;
private nosave string array __tmpNames = 0;
private nosave mapping __NewIps = 0;
private string array __MultiAllow = 0;
private string array __MUltiDeny = 0;

void create() {
  set("no_clean_up", 1);
  seteuid(getuid());
  restore();
}

string query_save_file() {
  return DATA_DIR "daemon/band";
}

private int AddTo(string array ref dest, string n) {
  if (!n)
    return 0;
  if (!sizeof(dest)) {
    dest = allocate(1);
    dest = ({ n });
  } else {
    if (member_array(n, dest) == -1) {
      dest += ({ n });
      return 1;
    } else {
      return -1;
    }
  }
  return 1;
}

int RemoveFrom(string array ref from, string what) {
  int ret;
  string array rest;
  if (!what || !sizeof(from))
    return 0;
  rest = regexp(from, what);
  ret = sizeof(from) - sizeof(rest);
  from -= rest;
  return ret;
}

int IsMemberOf(string array arr, string what) {
  if (!what || !sizeof(arr))
    return 0;
  foreach (string n in arr) {
    if (regexp(what, n))
      return 1;
  }
  return 0;
}

// --------begin sites ----------
int AddBannedSite(string ip) {
  //if (geteuid(previous_object()) != ROOT_UID
  int r = AddTo(ref __Sites, ip);
  save();
  return r;
}

string array GetBannedSites() {
  return __Sites;
}

int RemoveBannedSite(string ip) {
  int r = RemoveFrom(ref __Sites, ip);
  save();
  return r;
}

int IsBannedSite(string ip) {
  return IsMemberOf(__Sites, ip);
}
//end sites..

