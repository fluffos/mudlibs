int clean_up(object who) {
  object *inv;
  int i;

  int no_clean = who->query("no_clean_up") || who->get_no_clean();

  if (!clonep(who) && no_clean) {
    return 0;
  }

  if (interactive(who)) {
    return 0;
  }

  // If we are contained in something, let environment do the clean
  // up instead of making recursive call. This will prevent clean-up
  // time lag.
  if (environment(who)) {
    return environment(who)->clean_up();
  }

  inv = all_inventory(who);
  for (i = sizeof(inv) - 1; i >= 0; i--) {
    if (interactive(inv[i])) {
      return 0;
    }
  }

  return 1;
}
