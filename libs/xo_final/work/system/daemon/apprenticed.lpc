#include <ansi.h>

inherit F_CLEAN_UP;

void create() {
  seteuid(getuid());
}

int accept_apprentice(object me, object master) {
  return 1;
}

int is_apprentice_of(object dizi, object master) {
  mapping family;

  if (!mapp(family = dizi->query("family")) || !mapp(master->query("family"))) {
    return 0;
  }

  if (family["master_id"] == (string)master->query("id") &&
    family["master_name"] == (string)master->query("name")) {
    return 1;
  }

  return 0;
}

int is_tongmen_of(object dizi, object obj) {
  mapping my_family, your_family;

  my_family = dizi->query("family");
  your_family = obj->query("family");

  if (!mapp(my_family) || !mapp(your_family)) {
    return 0;
  }

  if (my_family["family_name"] == your_family["family_name"]) {
    return 1;
  }

  return 0;
}

void assign_apprentice(object dizi, string title, int privs) {
  mapping family;

  if (!mapp(family = dizi->query("family"))) {
    return;
  }

  family["title"] = title;
  family["privs"] = privs;

  if (userp(dizi) || !dizi->query("title")) {
    if (family["generation"] == 1) {
      dizi->set("title", family["family_name"] + "开山祖师");
    } else {
      dizi->set("title", sprintf("%s第%s代%s", family["family_name"],
        chinese_number(family["generation"]), family["title"]));
    }
  }
}

// This is used for NPC, or start a new family for a player.
void create_family(object dizi, string family_name, int generation, string title) {
  mapping family;

  family = allocate_mapping(6);

  family["family_name"] = family_name;
  family["generation"] = generation;

  dizi->set("family", family);

  // priv = -1 for ALL privileges.
  dizi->assign_apprentice(title, -1);
}

int recruit_apprentice(object master, object dizi) {
  mapping my_family, family, score;
  string f_name, my_fam;

  if (dizi->is_apprentice_of(master)) {
    return 0;
  }

  if (!mapp(my_family = master->query("family"))) {
    return 0;
  }

  my_fam = master->query("family/family_name");
  f_name = dizi->query("family/family_name");
  score = dizi->query("class_score");

  if (!f_name || !stringp(f_name) || f_name != my_fam) {
    BETRAY_D->save_old_family(dizi, master);
  }

  if (!mapp(score)) {
    dizi->set("class_score/" + my_fam, 0);
  }

  family = allocate_mapping(sizeof(my_family));
  family["master_id"] = master->query("id");
  family["master_name"] = master->query("name");
  family["family_name"] = my_family["family_name"];
  family["generation"] = my_family["generation"] + 1;
  family["enter_time"] = time();

  dizi->set("family", family);
  dizi->set("class", master->query("class"));
  dizi->set("master", master->query("id"));
  dizi->assign_apprentice("弟子", 0);

  FAMILY_D->remove_family_enemy(my_family["family_name"], dizi->query("id"));

  dizi->delete("oldquest");

  LOG_D->do_log(dizi, sprintf("你决意拜到%s门下，成为%s。",
    family["master_name"], dizi->query("title")));

  master->talk_recruit(dizi);

  return 1;
}

int attempt_apprentice(object master, object dizi) {
  master->run_command("say 好吧，我就收下你这个徒弟了。");
  master->run_command("recruit " + dizi->query("id"));
  return 1;
}

int process_betray(object master, object dizi) {
  string f_name, my_fam;

  if (!mapp(master->query("family")) || !mapp(dizi->query("family"))) {
    return 0;
  }

  my_fam = master->query("family/family_name");
  f_name = dizi->query("family/family_name");

  if (stringp(f_name)) {
    BETRAY_D->restore_old_family(dizi, master);
  }

  dizi->delete("class");
  dizi->delete("master");
  dizi->delete("family");
  dizi->delete("newquest");
  dizi->delete("oldquest");

  dizi->set("class_score/" + my_fam, 0);
  dizi->set("title", "普通百姓");

  if (!dizi->query("betray/" + my_fam)) {
    dizi->set("betray/" + my_fam, 1);
  } else {
    dizi->set("betray/" + my_fam, dizi->query("betray/" + my_fam) + 1);
  }

  FAMILY_D->remove_family_enemy(my_fam, dizi->query("id"));

  LOG_D->do_log(dizi, sprintf("你决意判出%s门下。", my_fam));

  return 1;
}

int process_chushi(object master, object dizi) {
  string f_name, my_fam;

  if (!mapp(master->query("family")) || !mapp(dizi->query("family"))) {
    return 0;
  }

  my_fam = master->query("family/family_name");
  f_name = dizi->query("family/family_name");

  master->run_command("snow " + dizi->query("id"));
  message_vision(CYN "$N看看了$n，道：“既然这样，我也知道留你不住了。"
    "出去了可不要忘了为师和你的师兄弟们啊。\n" NOR, master, dizi);

  master->talk_chushi(dizi);

  master->run_command("chat " + dizi->query("name") + "从今往后不再是我" + my_fam + "的弟子。\n");

  FAMILY_D->remove_family_enemy(my_fam, dizi->query("id"));

  LOG_D->do_log(dizi, sprintf("你获得了" + master->query("name") + "的允许，从" + my_fam + "出师。\n"));
  log_file("chushi", sprintf("%s(%s)于%s顺利从" + my_fam + "出师。\n", dizi->query("name"),
    getuid(dizi), ctime(time())));

  message_vision("$N恭恭敬敬地跪了下来，向$n磕了四个响头。\n", dizi, master);
  message_vision(CYN "$N深深叹了一口气，说道：“罢了，罢了。。。\n" NOR, master, dizi);

  if (!dizi->query("chushi/" + f_name)) {
    dizi->set("chushi/" + f_name, 1);
  } else {
    dizi->set("chushi/" + f_name, dizi->query("chushi/" + f_name) + 1);
  }

  dizi->delete("class");
  dizi->delete("master");
  dizi->delete("family");
  dizi->delete("newquest");
  dizi->delete("oldquest");
  dizi->set("title", "普通百姓");

  return 1;
}

int is_betrayed(object dizi, string family) {
  return dizi->query("betray/" + family);
}

int is_chushied(object dizi, string family) {
  return dizi->query("chushi/" + family);
}

// 返回的字串说明 me 是 obj 的什么关系
string get_tongmen_guanxi(object me, object obj) {
  mapping my_family, your_family;
  int my_gen, your_gen;
  int my_time, your_time;
  string my_gender;

  my_family = me->query("family");
  your_family = obj->query("family");

  if ((obj != me) && mapp(my_family) && mapp(your_family) &&
    (my_family["family_name"] == your_family["family_name"])) {
    my_gen = my_family["generation"];
    your_gen = your_family["generation"];
    my_time = my_family["enter_time"];
    your_time = your_family["enter_time"];
    my_gender = me->query("gender");
    if (my_gen == your_gen) {
      if (my_gender == "男性" || my_gender == "无性") {
        // 先入为大
        if (my_time < your_time)
          return "师兄";
        else
          return "师弟";
      } else {
        if (my_time < your_time)
          return "师姐";
        else
          return "师妹";
      }
    } else if (my_gen > your_gen) {
      if (my_family["master_id"] == obj->query("id"))
        return "弟子";
      else if (my_gen - your_gen == 1)
        return "师侄";
      else
        return "徒孙";
    } else {
      if (your_family["master_id"] == me->query("id"))
        return "师父";
      else if (your_gen - my_gen == 1) {
        if (my_time < your_time)
          return "师伯";
        else
          return "师叔";
      } else if (your_gen - my_gen == 2) {
        if (my_time < your_time)
          return "师伯祖";
        else
          return "师叔祖";
      } else {
        if (my_time < your_time)
          return "太师伯祖";
        else
          return "太师叔祖";
      }
    }
  }

  return 0;
}
