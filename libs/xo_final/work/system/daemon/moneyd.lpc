#include <ansi.h>

string price_string(int v)
{
    int gold_v, silver_v;
    string msg;

    if ( !v )
    {
        return "";
    }
    gold_v = v / 10000;
    v -= gold_v*10000;
    silver_v = v / 1000;
    v -= silver_v*1000;

    if ( gold_v ) 
    {
        msg= chinese_number( gold_v) + "两"+YEL "黄金" NOR;
    }
    if ( silver_v )
    {
        if ( msg  )
        {
            msg = msg + chinese_number( silver_v ) + "两"+WHT "银子" NOR;
        }
        else
        {
            msg = chinese_number( silver_v ) + "两"+WHT "银子" NOR;
        }
    }
    if ( v )
    {
        if ( msg )
        {
            msg = msg + chinese_number(v)+"文"+YEL "铜钱" NOR;
        }
        else
        {
            msg = chinese_number(v)+"文"+YEL "铜钱" NOR;
        }
    }

    return msg;
}

// can_afford() checks if this_object() can afford a price, it returns:
//
//      0:      cannot afford.
//      1:      can afford with proper money(coins).
//      2:      如果身上的硬通货不够，但是有银票 return 2。
//
int can_afford(object this, int amount)
{
    int total;
    object gold, silver, coin, cash;

    if ( this->is_manmade_npc() )
    {
        return 1;
    }

    // 如果使用 this 作为参数, ppl 只能使用身上的 money
    // 去买东西, 而不能用 env 中的.
    gold = present("gold_money", this);
    silver = present("silver_money", this);
    coin = present("coin_money", this);
    cash = present("thousand-cash_money", this);

    total = 0;
    if ( gold ) 
    {
        total += gold->value();
    }
    if ( silver ) 
    {
        total += silver->value();
    }
    if ( coin ) 
    {
        total += coin->value();
    }

    if ( total < amount )
    {
        if ( cash )
        {
            return 2;
        }
        else
        {
            return 0;
        }
    }

    return 1;
}

// 用来查看玩家身上钱的数量。
// add this by tea 12.6.98
int query_money(object this)
{
    int total;
    object gold, silver, coin, cash;

    gold = present("gold_money", this);
    silver = present("silver_money", this);
    coin = present("coin_money", this);
    cash = present("thousand-cash_money", this);

    total = 0;
    if ( cash ) 
    {
        total += cash->value();
    }
    if ( gold ) 
    {
        total += gold->value();
    }
    if ( silver ) 
    {
        total += silver->value();
    }
    if ( coin ) 
    {
        total += coin->value();
    }

    return total;
}

int pay_money(object this, int amount)
{
    int total, cashn, gn, sn, cn;
    object cash, gold, silver, coin;

    cash = present("thousand-cash_money", this);
    gold = present("gold_money", this);
    silver = present("silver_money", this);
    coin = present("coin_money", this);

    total = 0;

    if ( cash )
    {
        total += cash->value();
    }
    if ( gold )
    {
        total += gold->value();
    }
    if ( silver )
    {
        total += silver->value();
    }
    if ( coin )
    {
        total += coin->value();
    }

    if ( total < amount )
    {
        return 0;
    }

    total -= amount;

    cashn = total / 1000000;
    total -= cashn * 1000000;
    gn = total /10000;
    total -= gn * 10000;
    sn = total /1000;
    cn = total - sn * 1000;

    if ( cash )
    {
        cash->set_amount(cashn);
    }
    else if ( cashn )
    {
        cash = new( MONEY_DIR + "thousand-cash" );
        cash->set_amount( cashn );
        cash->move( this );    
    }

    if ( gold )
    {
        gold->set_amount(gn);
    }
    else if ( gn )
    {
        gold = new( MONEY_DIR + "gold" );
        gold->set_amount( gn );
        gold->move( this );    
    }

    if ( silver )
    {
        silver->set_amount(sn) ;
    }
    else if ( sn )
    {
        silver = new( MONEY_DIR + "silver" );
        silver->set_amount( sn );
        silver->move( this );
    }

    if ( coin )
    {
        coin->set_amount(cn);
    }
    else if ( cn )
    {
        coin = new( MONEY_DIR + "coin" );
        coin->set_amount( cn );
        coin->move( this );
    }

    return 1;        
}

int player_pay(object who, int amount)
{
    object z_ob, t_ob, g_ob, s_ob, c_ob;
    int zc, tc, gc, sc, cc, left;
    int v;

    seteuid(getuid());

    if( z_ob = present("thousand-gold_money", who) )
        zc = z_ob->query_amount();
    else
        zc = 0;
    if (t_ob = present("thousand-cash_money", who))
        tc = t_ob->query_amount();
    else
        tc = 0;
    if( g_ob = present("gold_money", who) )
        gc = g_ob->query_amount();
    else
        gc = 0;
    if( s_ob = present("silver_money", who) )
        sc = s_ob->query_amount();
    else
        sc = 0;
    if( c_ob = present("coin_money", who) )
        cc = c_ob->query_amount();
    else
        cc = 0;

    v  = cc + sc * 100 + gc * 10000;
    v += tc * 100000;
    v += zc * 10000000;

    if( v < amount ) {
        if( who->query("balance")<amount )
            return 0;

        who->addn("balance", -amount);
        return 1;
    } else {
        left = v - amount;
        if( zc ) {
            zc = left / 10000000;
            left %= 10000000;
        }

        if( tc ) {
            tc = left / 100000;
            left %= 100000;
        }
        gc = left / 10000;
        left = left % 10000;
        sc = left / 100;
        cc = left % 100;

        if( z_ob )
            z_ob->set_amount(zc);

        if( t_ob )
            t_ob->set_amount(tc);

        if( g_ob )
            g_ob->set_amount(gc);
        else if( gc ) {
            g_ob = new(GOLD_OB);
            g_ob->set_amount(gc);
            g_ob->move(who, 1);
        }
        if( s_ob )
            s_ob->set_amount(sc);
        else if( sc ) {
            s_ob = new(SILVER_OB);
            s_ob->set_amount(sc);
            s_ob->move(who, 1);
        }
        if( c_ob )
            c_ob->set_amount(cc);
        else if( cc ) {
            c_ob = new(COIN_OB);
            c_ob->set_amount(cc);
            c_ob->move(who, 1);
        }

        return 1;
    }
}

