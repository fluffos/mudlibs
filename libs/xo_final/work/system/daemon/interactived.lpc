#include <ansi.h>
#include <user.h>
#include <room.h>

void user_dump(object who, int type) {
  if (who && wizardp(who)) {
    return;
  }

  switch (type) {
    case DUMP_NET_DEAD:
      if (wizardp(who)) {
        return;
      }
      tell_room(environment(who), who->query("name") + "断线超过 "
        +NET_DEAD_TIMEOUT / 60 + " 分钟，自动退出这个世界。\n");
      who->set_temp("valid_quit", 1);
      who->run_command("quit");
      break;

    case DUMP_IDLE:
      tell_object(who, "对不起，您已经发呆超过 "
        +IDLE_TIMEOUT / 60 + " 分钟了，请下次再来。\n");
      tell_room(environment(who), "一阵风吹来，将发呆中的" + who->query("name")
        + "化为一堆飞灰，消失了。\n", ({ who }));
      who->set_temp("valid_quit", 1);
      who->run_command("quit");
      break;
  }
}

// net_dead: called by the gamedriver when an interactive player loses
// hir network connection to the mud.
void net_dead(object who) {
  object link_ob;

  if (!who->query("doing")) {
    who->disable_heart_beat();
  }

  if (objectp(link_ob = who->query_temp("link_ob"))) {
    destruct(link_ob);
  }

  // Stop fighting, we'll be back soon.
  who->remove_all_enemy();

  who->set_temp("netdead", 1);
  if (userp(who) && !who->query("doing")) {
    who->start_user_dump(NET_DEAD_TIMEOUT, DUMP_NET_DEAD);
    tell_room(environment(who), who->query("name") + "断线了。\n", who);
    CHANNEL_D->do_channel(who, "sys", "断线了。");
  } else {
    //who->run_command("quit");
    if (environment(who)) {
      message("vision", who->name() + "离线了。\n", environment(who), ({ who }));
    }
  }
}

// reconnect: called by the LOGIN_D when a netdead player reconnects.
void reconnect(object who) {
  who->enable_heart_beat();
  who->set_temp("netdead", 0);
  who->stop_user_dump();
  who->setup();
  tell_object(who, "重新连线返回。\n");
}

nosave object curren_interactive;
string GetInvDesc(object who, object env) {
  string str;
  string *shorts;
  int i, maxi;
  mapping inv = ([]);
  object *all, *rest;
  //object env = environment();

  curren_interactive = who;
  all = filter(all_inventory(env),
    (: $1 != curren_interactive && curren_interactive->visible($1) :));
  rest = filter(all, (: $1->query("unit") && !($1->is_character()) :));
  // rest 是有unit的而且不是npc/player的。比如coin什么的。
  all -= rest;  // all现在是没有unit的或者是char.

  if (sizeof(all)) {
    shorts = map(all, (: "    " + (string)$1->short() :));
    str = implode(shorts, "\n") + "\n";
  } else {
    str = "";
  }

  shorts = map(rest, (: (string)$1->query("unit") +
    (string)$1->short() :));
  foreach (string s in shorts) {
    if (s) {
      inv[s]++;
    }
  }

  for (i = 0, maxi = sizeof(shorts = keys(inv)); i < maxi; i++) {
    string key = shorts[i];
    int val = inv[key];

    if (val == 1) {
      str += "    " + key[2..];  // 去掉一个unit?
    } else {
      str += "    " + chinese_number(val) + key;
    }
    str += "\n";
  }

  return str;
}

// 天哪！看一眼这个世界都要这么多行程序～！
string eventDescribeEnv(object who, object env, int brief) {
  //object env = environment();
  string msg, ext;
  int sizeofexit;
  int bSeeExits = 0;

  if (!env) {
    msg = "你的四周灰蒙蒙地一片，什么也没有。\n"
      "你被带入了虚无之境，快找巫师来把你救出来吧。\n";
  } else {
    mapping exits = env->query("exits");
    if (mapp(exits)) {
      if (env->query("outdoors")
        && NATURE_D->AtNight()
        && !newbiep(who)     // 新手保护
        && !wizardp(who)) {
        foreach (object ob in all_inventory(who)) {
          if (ob->IsFire()) {
            if (ob->IsBurn()) {
              bSeeExits = 1;
            }
          }
        }  // else canlook = 0...
      } else {
        bSeeExits = 1;
      }

      if (bSeeExits) {
        string *dirs = filter(keys(exits),
          (: !($(env)->query_door($1, "status") & DOOR_CLOSED) :));
        sizeofexit = sizeof(dirs);
        if (sizeofexit == 1) {
          ext = HIY + dirs[0] + NOR;
        } else if (sizeofexit) {
          ext = sprintf(HIY "%s" NOR " 和 " HIY "%s" NOR,
            implode(dirs[0..sizeofexit - 2], "、"),
            dirs[sizeofexit - 1]);
        }
      }
    }

    if (!brief) {
      msg = sprintf("%s - %s\n    %s%s",
        env->query("short"),
        wizardp(who) ? file_name(env) : "",
        env->query("long"),
        env->query("outdoors") ? NATURE_D->outdoor_room_description(env) : "");

      if (!bSeeExits) {
        msg += "    正是深夜，周围不辩道路。\n";
      } else if (!sizeofexit) {
        msg += "    这里没有任何明显的出路。\n";
      } else {
        msg += "    这里" + ((sizeofexit == 1) ? "唯一" : "明显") + "的出口是 " + ext + "。\n";
      }
      msg += GetInvDesc(who, env);
    } else {
      msg = HIG + env->query("short") + NOR;
      if (bSeeExits && sizeofexit) {
        msg += "[ " + ext + " ]";
      }
      msg += "\n";
      if (brief == 1) {
        msg += GetInvDesc(who, env);
      }
    }
  }
  tell_object(who, msg);
  return msg;
}
