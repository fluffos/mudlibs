// #include <net/telnet.h>
#include <mudlib.h>
#include <net/daemons.h>
#include <ansi.h>
private void LoadData();
int AddSite(string pattern);
int RemoveSite(string pattern);
int PrintSites();
int IsBannedSite(string);
int IsMultiLogin(string, object);
int IsTimeAllowed(object);
int IsLegalID(string);
int IsLoopbackSite(string);

void Dump();

private string *Sites = 0;
private string *mlDeny = 0;
private mapping mlAllow = 0;
private string *BannedIds = 0;
private string *BannedNames = 0;
private mapping NewIps = 0;
private nosave mapping tmpBannedSites = 0;

private string last_error = "未知的错误";
private string *BadStrings = ({ "baba", "father", "mother",
  "grandpa", "grandfather", "fuck", "mama", "shit" });

void create() {
  seteuid(getuid());
  LoadData();
}

void Dump() {
  printf("Sites..........\n");
  foreach (string s in Sites)
    printf("%s\n", s);
  printf("mlAllow : %O", mlAllow);
}

