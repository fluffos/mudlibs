                        GetWeather( PLACE_D->Contain( room ), GetSeason() ) ) + "\n";
}
               

mixed *RealTime( int time ) //给出time对应的时间数组。
{
    mixed *result = allocate(10);
    if( !time )
        time = time();      //如果time为0则给出当前系统时间。

    if (time < 0)
        time = -time;

    result[ND_YEAR] = time / 86400;     //一年是86400秒
    time %= 86400;
    result[ND_SEASON] = time / 21600;   //一季度是21600秒
    time %= 21600;
    result[ND_MONTH] = time / 7200;     //一月是7200秒
    time %= 7200;                       //按我们的约定，一个月是8天。
    result[ND_DAY] = time / 900;        //一天是900秒(15分钟)。
    time %= 900;
    result[ND_SHICHEN] = time / 75;     //一个时辰是75秒。
    time %= 75;
    result[ND_SHIKE] = time/19;         //一刻是18。75秒 
    time %= 19;
    result[ND_MIN] = time;              //再往下就用不着了吧。

    return result;
}

int QueryYear() 
{
    return RealTime(0)[ND_YEAR] + 1;
}

int QuerySeason()
{
    return RealTime(0)[ND_SEASON] + 1;
}

int QueryMonth()
{
    return RealTime(0)[ND_SEASON] * 3 + RealTime(0)[ND_MONTH] + 1;
}

int QueryDay()
{
    return RealTime(0)[ND_DAY] + 1;
}

int QueryShiChen()
{
    return RealTime(0)[ND_SHICHEN] + 1;
}

int QueryShiKe()
{
    return RealTime(0)[ND_SHIKE];
}

int AtNight()
{
    if(  Time == NIGHT || Time == SANGEN || Time == WUGEN || Time == LINGCHEN )
        return 1;
    else 
        return 0;
}

string replace_ctime(int t)
{
    string month, ctime = ctime(t);

    switch(ctime[4..6])
    {
        case "Jan"      :       month = "01";break;
        case "Feb"      :       month = "02";break;
        case "Mar"      :       month = "03";break;
        case "Apr"      :       month = "04";break;
        case "May"      :       month = "05";break;
        case "Jun"      :       month = "06";break;
        case "Jul"      :       month = "07";break;
        case "Aug"      :       month = "08";break;
        case "Sep"      :       month = "09";break;
        case "Oct"      :       month = "10";break;
        case "Nov"      :       month = "11";break;
        case "Dec"      :       month = "12";break;
    }

    return sprintf("%s/%s/%s %s", month, (ctime[8]==' '?"0"+ctime[9..9]:ctime[8..9]), ctime[<4..<1], ctime[11..15]);
}

