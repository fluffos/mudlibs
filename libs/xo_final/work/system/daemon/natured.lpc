int GetSeason()
{
    return Season;
}

int GetTime()
{
    return Time;
}

int Season( int month )
{
    if( month >= 3 && month <= 5 )
        return SPRING;
    else if( month >=6 && month <= 8 )
        return SUMMER;
    else if( month >=9 && month <= 11 )
        return AUTUMN;
//    else if( month == 12 || month >=1 && month <= 2 )
//        return WINTER;
    else 
        return WINTER;
}

int Time( int shichen )
{

    if ( shichen==1)
        return SANGEN;
    else if ( shichen==3)
        return WUGEN;
    else if ( shichen==4)
        return LINGCHEN;
    else if ( shichen==5)
        return MORNING;
    else if ( shichen==6)
        return SHANGWU;
    else if( shichen ==7 )
        return NOON;
    else if( shichen ==8 || shichen ==9)
        return AFTERNOON;
    else if( shichen ==10 )
        return EVENING;
    else
       return NIGHT;
}

int GetWeather( string place, int season )
{

    if ( place =="OTHER" )
		return 6;
    if( season == WINTER )
    {
        switch( place )
        {
            case "XIYU":
            case "XIBEI":
            case "GUANWAI":
                if( Random1 == 0 )
                {
//                    StartBadWeather( place, SNOW );
//                    return CLOUD;
		      return SNOW;
                };
                break;
            case "ZHONGYUAN":
                if( Random2 == 0 )
                {
//                    StartBadWeather( place, SNOW );
//                    return CLOUD;
                      return SNOW;
                };
                break;
            default:
                if( random(2))
                    return FINE;
                else
                    return CLOUD;
        };
        if( random(2) )
            return FINE;
        else
            return CLOUD;
    }
    else if( season == SUMMER )
    {
        switch( place )
        {
            case "XINAN":
            case "JIANGNAN":
                if( Random1 == 0 )
                {
//                    StartBadWeather( place, RAIN );
//                   return CLOUD;
		     return RAIN;
                };
                break;
            case "XIBEI":
            case "XIYU":
            case "ZHONGYUAN":
                if( Random2 == 0  )
                {
//                    StartBadWeather( place, RAIN );
//                    return CLOUD;
		      return RAIN;
                };
                break;
            default:
                if( random(4))
                    return FINE;
                else
                    return CLOUD;
        };
        if( random(3) )
            return FINE;
        else
            return CLOUD;
    }
    else if( random(3) )
        return FINE;
    else
        return CLOUD;
}

string GetDescription( string place, int season, int time , int weather )
{
    if( weather == SNOW )
        return Snow[random(2)];
    else if ( weather == RAIN )
        return Rain[random(4)];
    else if( weather == CLOUD )
        return Cloud[time-1];
    else if( weather == FINE )
        return Fine[time-1];       
    else
        return NoWeather[0];
}

string GetPlaceDescription( string place, int season, int time , int weather )
{
    if( weather == SNOW )
        return SnowPlace[random(2)];
    else if ( weather == RAIN )
        return RainPlace[random(4)];
    else if( weather == CLOUD )
        return CloudPlace[time-1];
    else if( weather == FINE )
        return FinePlace[time-1];
    else
        return NoWeather[0];
}


