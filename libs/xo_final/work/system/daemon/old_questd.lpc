    "$N对$n说：“现在没什么事做，你先下去练功吧。”\n",
    "$N向$n摇了摇头：“你还是应当多练练功为上。”\n",
});

string get_family_id( string family_name )
{
    switch( family_name )
    {
        case "无量剑派东宗" :   return "east";      break;
        case "无量剑派西宗" :   return "west";      break;
        case "伏牛派"       :   return "funiu";     break;
        case "崆峒派"       :   return "kongdong";  break;
        case "少林派"       :   return "shaolin";   break;
        case "镇南王府"     :   return "duanshi";   break;
        case "蓬莱派"       :   return "penglai";   break;
        case "凤翔镖局"     :   return "biaoju";    break;
        case "神农帮"       :   return "shennong";  break;
        case "昆仑派"       :   return "kunlun";    break;

        default:                return "common";    break;
    }
}

int time_period(int timep, object me);
string GetQuestFile( object who, string family );

private string get_quest_reward_msg();
private string get_quest_fail_msg();
private string get_quest_delay_msg();
private string get_quest_refuse_msg();

/////////////////////////////////////////////////////////////////////////////

//who---player, me---npc
varargs int give_oldquest(object who, object me, int candone)
{
    mapping quest;
    object send_obj;
    int timep, bonus, penals,positive_score, negative_score;  
    string his_class, my_class, his_class_id,quest_file;
    mixed msg;

    if ( who->is_tongshi_of( me ) )
    {
        his_class = who->query("zuzhi/zuzhi_name");
        my_class = me->query("zuzhi/zuzhi_name");
    }
    else
    {
        his_class = who->query("family/family_name");
        my_class = me->query("family/family_name");
    }

    if ( his_class != my_class )  
    {
         tell_object( who, me->name() + "疑惑地看着你：“这位"+RANK_D->query_respect( who )
            + "有何贵干？”\n" );
         return 0;
    }

    his_class_id = get_family_id( his_class );

    if ( quest = who->query( "oldquest" ) )
    {
        if ( quest[ "class" ] != his_class_id )
        {
            tell_object( who, me->name()+"疑惑地看着你：“这位" + RANK_D->query_respect( who )
                + "想要干什么？”\n" );
            return 0;
        }

        quest_file = quest["quest_file"];

        if ( who->query("oldquest/status") == "等待" )
        {
            if ( who->query("oldquest/prompt") )
            {
                tell_object(who, who->query("oldquest/prompt"));
            }
            else
            {
                tell_object(who, "你还有任务没完成。\n");
            }
            return 1;
        }
        else if ( who->query("oldquest/status") == "完成" )
        {
            if ( !candone )
            {
                tell_object(who, "你还有任务没交差。\n");
                return 1;
            }

            if ( who->query("oldquest/task_time") && who->query("oldquest/task_time") < time() )
            {
                //任务超时
                msg = quest["delay_msg"];
                if ( !msg )
                {
                    tell_object( who, me->name() + get_quest_delay_msg() );
                }
                // Amber: here to detect funcp to penal delay   97-12
                // 提供evaluate的接口，可能比call_other快。
                else if ( functionp( msg ) )
                {
                    msg = evaluate( msg, who, me );

                    if ( stringp( msg ) )
                    {
                        msg = replace_string(msg, "$N", me->query("name"));
                        tell_object( who, msg );
                    }
                    else if ( msg )
                    {
                        return 1;
                    }
                }
                else
                {
                    msg = replace_string(msg, "$N", me->query("name"));
                    if ( is_chinese( msg ) )
                    {
                        tell_object( who, msg );
                    }
                    else
                    {
                        msg = call_other( quest_file, msg, who, me );
                        if ( stringp( msg ) )
                        {
                            tell_object( who, msg );
                        }
                        else if ( msg )
                        {
                            return 1;
                        }
                    }
                }

                // 这里用来自己修改"quest"的标志
                // 实际可以用来继续发给下一个quest（连续性）。
                who->set("oldquest/status", "超时");
                who->set("oldquest/task_time", time() + 20);

                return 1;
            }
            else
            {
                // Amber: here to detect funcp to reward 1997-12-17
                // Amber: 加了一个reward的通用语 97-12-18
                msg = quest["reward_msg"];
                if ( !msg )
                {
                    tell_object( who, me->name() + get_quest_reward_msg() );
                }
                else if ( functionp( msg ) )
                {
                    msg = evaluate( msg, who, me );
                    if ( stringp( msg ) )
                    {
                        msg = replace_string(msg, "$N", me->query("name"));
                        tell_object( who, msg );
                    }
                    else if ( msg )
                    {
                        return 1;
                    }
                }
                else
                {
                    msg = replace_string(msg, "$N", me->query("name"));
                    if ( is_chinese( msg ) )
                    {
                        tell_object( who, msg );
                    }
                    else
                    {
                        msg = call_other( quest_file, msg, who, me );
                        if ( stringp( msg ) )
                        {
                            tell_object( who, msg );
                        }
                        else if ( msg )
                        {
                            return 1;
                        }
                    }
                }

                // 这里用来自己修改"quest"的标志
                // 实际可以用来继续发给下一个quest（连续性）。
                bonus = quest["bonus"];
                bonus += random((int)who->query("kar"))/10;
                who->add( "class_score/" + his_class , bonus );
                printf(RED"->你对" + his_class + "的忠诚度升高 %s 点\n"NOR, chinese_number(bonus) );

                if ( positive_score = quest["positive_score"])
                {
                    positive_score *= ( 1 + random((int)who->query("kar"))/15);
                    who->add("positive_score",positive_score);
                    printf(GRN"->正评价升高 %s 点\n"NOR
                        , chinese_number(positive_score ));
                }

                if( negative_score = quest["negative_score"])
                {
                    negative_score *= ( 1 + random((int)who->query("kar"))/15 );
                    who->add("negative_score",negative_score);
                    printf(CYN"->负评价升高 %s 点\n"NOR
                        , chinese_number(negative_score ));
                }

                GIFT_D->boss_bonus(who, ([
                    "percent" : 100,
                    "exp" :     1000 + random(5000),
                    "pot" :     1000 + random(5000),
                    "score" :   100 + random(100),
                    "gongxian" :    10 + random(10),
                    "gold" :    1 + random(5),
                    "jilei_num" :   1 + random(3),
                    "jilei_min" :   10 + random(20),
                    "jilei_max" :   50 + random(20),
                    ]));

                who->set("oldquest/status", "奖励");
                who->set("oldquest/task_time", time() + 5);

                return 1;
            }
        }
        else if ( who->query("oldquest/status") == "放弃" )
        {
            msg = quest["fail_msg"];
            if ( !msg )
            {
                tell_object( who, me->name() + get_quest_fail_msg() );
            }
            else if ( functionp( msg ) )
            {
                msg = evaluate( msg, who, me );
                if ( stringp( msg ) )
                {
                    msg = replace_string(msg, "$N", me->query("name"));
                    tell_object( who, msg );
                }
                else if ( msg )
                {
                    return 1;
                }
            }
            else
            {
                msg = replace_string(msg, "$N", me->query("name"));
                if ( is_chinese( msg ) )
                {
                    tell_object( who, msg );
                }
                else
                {
                    msg = call_other( quest_file, msg, who, me );
                    if ( stringp( msg ) )
                    {
                        tell_object( who, msg );
                    }
                    else if ( msg )
                    {
                        return 1;
                    }
                    // 这里用来自己修改"quest"的标志
                    // 实际可以用来继续发给下一个quest（连续性）。
                }
            }
            // Amber: 加入一项新的参数penals用来和bonus分开处理惩罚的忠诚度
            penals = quest["penals"];
            if ( !penals )
            {
                penals = quest["bonus"] / 3;
            }
            who->add( "class_score/" + his_class, -penals);
            if ( penals )
            {
                printf(HIY"->你对" + his_class + "的忠诚度下降 %s 点\n"NOR
                   ,chinese_number( penals ) ); 
            }

            who->set("oldquest/status", "取消");
            who->set("oldquest/task_time", time() + 60);

            return 1;
        }
    }

    if ( who->query("oldquest/task_time") && ( who->query("oldquest/task_time") > time() ) ) 
    {                     
        message_vision( get_quest_refuse_msg(), me, who );
        return 1;
    }

    //发布新的任务
    quest_file = GetQuestFile( who, his_class );
    if ( file_size( quest_file + ".lpc" ) == -1 )
    {
        return 0;
    }

    quest = quest_file->query_quest();
    if ( !mapp( quest ) )
    {
        return 0;
    }

    msg = quest[ "quest_msg" ];
    if ( functionp( msg ) )
    {
        msg = evaluate( msg, who, me );

        if ( stringp( msg ) )
        {
            msg = replace_string(msg, "$N", me->query("name"));
            quest[ "prompt" ] = msg;
            tell_object( who, msg );
        }
        else if ( msg )
        {
            return 0;
        }
        if ( quest[ "send_ob" ] )
        {
            send_obj = new( quest[ "send_ob" ] );
            if ( !send_obj )
            {
                return 0;
            }

            if ( send_obj->is_character() || !send_obj->move( who ) )
            {
                // Amber: 避免玩家拿不了时出错。97-12-18
                // 另外这样可以实现护送NPC的功能了，OB就可以是NPC。
                send_obj->move( environment( me ) );
            }
        }
    }
    else
    {
        msg = replace_string(msg, "$N", me->query("name"));
        if ( is_chinese( msg ) )
        {
            quest[ "prompt" ] = msg;
            tell_object( who, msg );

            if ( quest["send_ob"] )
            {
                send_obj = new( quest["send_ob"] );
                if ( !send_obj )
                {
                    return 0;
                }

                if ( send_obj->is_character() || !send_obj->move( who ) )
                {
                    // Amber: 避免玩家拿不了时出错。97-12-18
                    // 另外这样可以实现护送NPC的功能了，OB就可以是NPC。
                    send_obj->move( environment( me ) );
                }
            }
        }
        else
        {
            msg = call_other( quest_file, msg, who, me );

            if ( stringp( msg ) )
            {
                quest[ "prompt" ] = msg;
                tell_object( who, msg );
            }
            else if ( msg )
            {
                return 1;
            }
            if ( quest[ "send_ob" ] )
            {
                send_obj = new( quest[ "send_ob" ] );
                if ( !send_obj )
                {
                    return 0;
                }

                if ( send_obj->is_character() || !send_obj->move( who ) )
                {
                    // Amber: 避免玩家拿不了时出错。97-12-18
                    // 另外这样可以实现护送NPC的功能了，OB就可以是NPC。
                    send_obj->move( environment( me ) );
                }
            }
        }
    }

    quest[ "class" ] = his_class_id;// 门派标志
    quest[ "quest_file" ] = quest_file;// 这是新加的一项。quest所在文件。
    quest[ "status" ] = "等待";
    who->set( "oldquest", quest );// 这是quest的标志mapping
    who->delete("oldquest/task_time");
    who->set("oldquest/master", me->query("id"));
    who->set("oldquest/master_name", me->query("name"));

    if ( timep = quest["time"] )
    {
        time_period( timep, who );
        who->set("oldquest/task_time", time() + timep);
    }

    return 1;
}

void cancel_oldquest(object who, object me)
{
    if ( who->query("oldquest/master") != me->query("id") )
    {
        tell_object(who, "我没有给你任务吧。\n");
        return;
    }

    if ( who->query("oldquest/status") != "等待" )
    {
        tell_object(who, "你没有任务可以取消。\n");
        return;
    }

    who->set("oldquest/status", "放弃");
    give_oldquest(who, me);
}

void done_oldquest(object who, object me)
{
    if ( who->query("oldquest/master") != me->query("id") )
    {
        tell_object(who, "我没有给你任务吧。\n");
        return;
    }

    if ( who->query("oldquest/status") != "完成" )
    {
        tell_object(who, "你没有任务可以交差。\n");
        return;
    }

    give_oldquest(who, me, 1);
}

int have_oldquest(object who, object me)
{
    return ( who->query("oldquest/status") == "等待" || who->query("oldquest/status") == "完成" );
}

int time_period(int timep, object me)
{
    int t, d, h, m, s;
    string time;

    t = timep;
    s = t % 60; t /= 60;
    m = t % 60; t /= 60;
    h = t % 24; t /= 24;
    d = t;

    if ( d )
    {
        time = chinese_number(d) + "天";
    }
    else
    {
        time = "";
    }

    if ( h )
    {
        time += chinese_number(h) + "小时";
    }

    if ( m )
    {
        time += chinese_number(m) + "分";
    }

    time += chinese_number(s) + "秒";

    tell_object(me,HIW "你有" + time + "的时间\n去完成你师傅给的任务。\n"NOR);
    return 1;
}

string GetQuestFile( object who, string family )
// Amber:这段分出来用来寻找quest_file;
// Amber:用来找到现在可以领到的或身上有的quest是属于哪个文件的
{
    int score;
    string tag;

    score = who->query( "class_score/" + family );

    if ( random( score ) < 300 )
    {
        tag = get_family_id( family ) + "/quest0";
    }
    else if ( random( score ) < 1000 )
    {
        tag = get_family_id( family ) + "/quest1";
    }
    else if ( random( score ) < 3000 )
    {
        tag = get_family_id( family ) + "/quest2";
    }
    else
    {
        tag = get_family_id( family ) + "/quest3";
    }

    if ( file_size( tag + ".lpc" ) == -1 )
    {
        tag = get_family_id( family ) + "/quest0";
    }

    return QUEST(tag);
}

int accept_quest_object( object who, object me, object ob )
{
    string who_class, my_class, who_class_id;
    mapping quest;

    if ( who->is_tongshi_of( me ) )
    {
        my_class = me->query( "zuzhi/zuzhi_name" );
        who_class = who->query( "zuzhi/zuzhi_name" );
    }
    else
    {
        my_class = me->query("family/family_name");
        who_class = who->query("family/family_name");
    }

    who_class_id = get_family_id( who_class );

    if ( my_class != who_class || 
        who->query( "oldquest/class" ) != who_class_id )
    {
        tell_object( who, me->name() + "疑惑地看着你：这位" +
            RANK_D->query_respect(who) + "是什么意思？\n" );
        return 0;
    }

    if ( !(quest = who->query("oldquest")))
    {
        //tell_object(who, me->name() + "笑道：你给我东西干什么？\n");
        return 0;
    }

    if ( quest["master"] != me->query("id") )
    {
        return 0;
    }

    if ( "取" + ob->name(1) != quest["quest"] || userp(ob) )
    {
        tell_object(who, me->name() + "皱眉说：我当初可不是让你去找这个呀！\n");
        return 0;
    }

    // 这里用来自己修改"quest"的标志
    who->set("oldquest/status", "完成");

    call_out( "destruct_quest_object", 2, me, ob );
    return 1;
}

int accept_special_object( object who, object me, object ob )
{
    mapping quest;
    string task, name, dest, msg, quest_file;

    if ( !quest = who->query("oldquest") )
    {
        return 0;
    }

    task = quest["quest"];

    if ( !task || !sscanf( task, "送%s给%s", name, dest )== 2 )
    {
        return 0;
    }

    if ( name != ob->name() ||
        ob->is_character() ||
        dest != this_object()->name() )
    {
        return 0;
    }

    if ( "等待" == who->query("oldquest/status") )
    {
        return 0;
    }

    msg = quest[ "send_msg" ];
    if ( !msg )
    {
        message_vision( "$N对着$n点了点头说: 好了,你先回去覆命吧.\n", this_object(), who );
    }
    else if ( functionp( msg ) )
    {
        msg = evaluate( msg, who, this_object() );
        if ( stringp( msg ) )
        {
            tell_object( who, msg );
        }
        else if ( msg )
        {
            return 1;
        }
    }
    else
    {
        msg = replace_string(msg, "$N", me->query("name"));
        if ( is_chinese( msg ) )
        {
            tell_object( who, msg );
        }
        else 
        {
            quest_file = quest["quest_file"];
            msg = call_other( quest_file, msg, who, this_object() );
            if ( stringp( msg ) )
            {
                tell_object( who, msg );
            }
            else if ( msg )
            {
                return 1;
            }
        }
    }

    who->set("oldquest/status", "完成");

    call_out( "destruct_quest_object", 2, me, ob );
    return 1;
}

void destruct_quest_object( object me, object ob )
{
    if ( ob && me && environment(ob) == me )
    {
        destruct(ob);
    }
}

private string get_quest_fail_msg()
{
    return quest_fail_msg[ random( sizeof( quest_fail_msg ) ) ];
}

private string get_quest_delay_msg()
{
    return quest_delay_msg[ random( sizeof( quest_delay_msg ) ) ];
}

private string get_quest_refuse_msg()
{
    return quest_refuse_msg[ random( sizeof( quest_refuse_msg ) ) ];
}
private string get_quest_reward_msg()
{
    return quest_reward_msg[ random( sizeof( quest_reward_msg ) ) ];
}

