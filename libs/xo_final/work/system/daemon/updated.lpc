// updated.c
#include <ansi.h>

void create()
{
	seteuid(getuid());
}

void check_user(object ob)
{
	mapping my;

	my = ob->query_entire_dbase();
	if ( undefinedp(my["eff_gin"]) ) my["eff_gin"] = my["max_gin"];
	if ( undefinedp(my["eff_kee"]) ) my["eff_kee"] = my["max_kee"];
	if ( undefinedp(my["eff_sen"]) ) my["eff_sen"] = my["max_sen"];
	if ( my["eff_gin"] > my["max_gin"] ) my["eff_gin"] = my["max_gin"];
	if ( my["eff_kee"] > my["max_kee"] ) my["eff_kee"] = my["max_kee"];
	if ( my["eff_sen"] > my["max_sen"] ) my["eff_sen"] = my["max_sen"];
	if ( my["gin"] > my["eff_gin"] ) my["gin"] = my["eff_gin"];
	if ( my["kee"] > my["eff_kee"] ) my["kee"] = my["eff_kee"];
	if ( my["sen"] > my["eff_sen"] ) my["sen"] = my["eff_sen"];

    if ( my["force"] > 2*my["max_force"] )
         my["force"] = 2*my["max_force"]; 
}

void check_money(object user)
{
    //add by lnwm 玩家身上钱数的最大限制。990902
    //newbie 10gold player 50gold high_mortal 100gold
    int i;
    int allmoney=0,invmoney=0;

    object* things;

    if ( !user || !userp(user) )
    {
        return;
    }

    allmoney = user->query("savemoney");

    things=all_inventory(user);
    for(i=0;i<sizeof(things);i++)
    {
        if(things[i]->query("id")=="thousand-cash" 
        || things[i]->query("id")=="gold"
        || things[i]->query("id")=="silver"
        || things[i]->query("id")=="coin")
        {
            invmoney = invmoney+things[i]->value();
        }
    }
    allmoney += invmoney;
    if(newbiep(user) )
    {   if( allmoney > 1000000)
        {
        foreach(object obj in things)
        {
            if( obj ->value() )
                destruct(obj);
        }
        user->set("savemoney",1000000);
         write(RED"最近发行新版货币，系统已经替你自动兑换所有的旧版货币，
并存入钱庄，请注意查收。\n"NOR);
        }
     }
    else if(high_mortalp(user) )
    {   if( allmoney > 10000000)
        {
        foreach(object obj in things)
        {
            if( obj ->value() )
                destruct(obj);
        }
        user->set("savemoney",10000000);
         write(RED"最近发行新版货币，系统已经替你自动兑换所有的旧版货币
，并存入钱庄，请注意查收。\n"NOR);
        }
     }
    else 
    {
        if(allmoney > 5000000)
        {    
        foreach(object obj in things)
        {
            if( obj ->value() )
                destruct(obj);
        }
        user->set("savemoney",5000000);
         write(RED"最近发行新版货币，系统已经替你自动兑换所有的旧版货币
,并存入钱庄，请注意查收。\n"NOR);
        }
     }
}

void born_player(object me)
{
    me->start_call_out((: call_other, __FILE__, "give_new_mygift_quest", me:), 3);
}

// 给予新的MYGIFT辅助任务
void give_new_mygift_quest(object me)
{
    MYGIFT_D->give_mygift(me, "1");
}

