#include <ansi.h>
#include <room.h>

inherit ROOM;

void create()
{
    set("short", YEL"石洞"NOR);
    set("long", @LONG
千年古洞, 四处留下岁月年痕. 四壁已经斑斑驳驳, 依稀可见有些裂痕了.
墙上象是用油彩绘着一些字画. 石壁上刻着一首唐诗<<侠客行>>。但只有诗句，
却无注释。在石壁上还刻有几十行蝌蚪文. 光线很暗，你只好用手仔细摸索(canxiu)，
才能了解你们写的详细内容。
LONG
    );

    set("exits", ([
        "south": __DIR__"out",
    ]));
    set("objects", ([
        "/d/place/wiz/buddha": 1,
        ]));
    set("not_startroom", 1);

    setup();
}

