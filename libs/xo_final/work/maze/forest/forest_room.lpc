#include <ansi.h>
inherit MAZE_ROOM;

void create() {
  set("short", HIC "蛇洞" NOR);
  set("long", @LONG
好多蛇啊！
LONG);

  set("outdoors", "forest");

  set("objects", ([
    "/maze/forest/npc/snake_king": random(2),
    "/maze/forest/npc/bear_king": random(2),
    "/maze/forest/npc/tiger_king": random(2),
    "/maze/forest/npc/wolf_king": random(2),
  ]));
  setup();
}
