inherit NPC;

void set_reward() {
  set("rewards", ([
    "percent": 100,
    "exp": 1000 + random(5000),
    "pot": 1000 + random(5000),
    "score": 100 + random(100),
    "gongxian": 10 + random(10),
    "gold": 1 + random(5),
    "jilei_num": 1 + random(3),
    "jilei_min": 10 + random(20),
    "jilei_max": 50 + random(20),
  ]));

  set("drops", ([
    "RA&RANDOM" + (1 + random(9)) + "0": 500,
    "RA&RANDOM" + (1 + random(9)) + "0": 500,
    "RA&RANDOM" + (1 + random(9)) + "0": 500,
    "RA&RANDOM" + (1 + random(9)) + "0": 500,
    "RA&MODULE" + random(4): 500,
    "RA&NUMBER" + random(3): 500,
    "FI&/clone/goods/sun": 30,
    "FI&/clone/goods/moon": 30,
    "FI&/clone/goods/enchant-scroll": 30,
    "MO&A1000": 10,
    "MO&A1001": 10,
    "MO&A1002": 10,
    "MO&A1003": 10,
    "MO&A1004": 10,
    "MO&A1005": 10,
    "MO&A1006": 10,
    "MO&A3000": 30,
    "MO&A3001": 30,
    "MO&A3002": 30,
    "MO&A3003": 30,
    "MO&A3004": 30,
    "MO&A3005": 10,
    "MO&A3006": 10,
  ]));
}

void setup() {
  set_reward();

  ::setup();
}

void die() {
  object me = this_object();
  object killer = query_last_damage_from();
  mapping drops;

  if (me && killer && mapp(drops = query("drops"))) {
    EQUIPMENT_D->killer_reward(killer, me, drops);
  }

  if (me && killer && mapp(drops = query("rewards"))) {
    GIFT_D->fuben_bonus(killer, drops);
  }

  ::die();
}
