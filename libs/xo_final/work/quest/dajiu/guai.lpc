void init() {
  object me = this_object();
  object who = this_player();

  ::init();

  add_action("do_no", "steal");
}

int do_no(string arg) {
  object who = this_player();
  object me = this_object();

  if (!userp(who)) {
    return 1;
  }

  if (who != owner()) {
    message_vision(CYN "$N说道：你不想死就滚！。\n" NOR, me);
    //random_move();
    return 1;
  }

  me->kill_ob(who);
  return 0;
}

void heart_beat() {
  object guai = this_object();

  ::heart_beat();

  if (!guai || !environment(guai)) {
    return;
  }

  if (!owner() || "wait" != QUEST_D->query_quest_marks(owner(), "result")) {
    leave();
    return;
  }
}

void unconcious() {
  die();
}

void die() {
  object me = owner();

  me->add_temp("baohu/killer", 1);

  if ((int)me->query_temp("baohu/killer") >= 3) {
    me->set("baohu/done", 1);
    me->delete("baohu/get");
    me->delete_temp("baohu/killer");
  }

  message_vision(CYN "\n$N喊:  兄弟，我们完了......\n" NOR, this_object());

  load_object(VOID_OB);
  this_object()->move(VOID_OB);

  leave();
}

void destruct_ob(object ob) {
  if (ob) {
    destruct(ob);
  }
}

void kill_ob(object ob) {
  object me = this_object();

  if (QUEST_D->query_quest_marks(ob, "target") == me && owner() == ob) {
    me->set_leader(ob);
  }

  ::kill_ob(ob);
}

void leave() {
  if (this_object()) {
    if (environment()) {
      message("vision", HIB + name() + "嘿嘿一笑，回山去了。\n" NOR, environment());
    }

    remove_call_out("leave");
    destruct(this_object());
  }

  return;
}
