inherit NPC;

#include <ansi.h>

void copy_status(object me, int level);
void set_skills(int max_value, int level);
void set_hp_status(object me, int level);

object owner() { return query("owner"); }

void leave();

object carry_object(string file) {
  object ob = ::carry_object(file);

  if (ob) {
    ob->set("no_drop", 0);
    ob->set("value", 0);
    return ob;
  }

  return 0;
}

void create() {
  set_name(comm_man_name(), ({ "robber" }));

  set("age", 10 + random(80));
  set("gender", random(2) ? "男性" : "女性");
  set("attitude", "heroism");

  set("per", 40);
  set("str", 40);
  set("cor", 40);
  set("con", 40);
  set("int", 40);
  set("spi", 40);
  set("cps", 40);
  set("kar", 40);

  set("food", 10000);
  set("water", 10000);
  set_weight(30000);

  set("no_steal", 1);
  set("taskguai", 1);

  setup();
}

string invocation(object me, int level) {
  object guai, env;

  guai = this_object();
  copy_status(me, level);

  set_name(query("name"), ({ me->query("id") + "'s robber", "robber" }));

  set("owner", me);
  set("target", QUEST_D->query_quest_marks(me, "target"));

  remove_call_out("leave");
  call_out("leave", 300);
}

