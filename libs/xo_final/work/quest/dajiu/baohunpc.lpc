#include <ansi.h>

inherit NPC;

void leave();
void exertheal(object me);
void copy_status(object me, int level);
void set_skills(int max_value, int level);
void set_hp_status(object me, int level);

object owner() { return query("owner"); }

void create() {
  set_name(comm_man_name(), ({ "di zi", "dizi" }));
  set("age", 10 + random(80));
  set("gender", random(2) ? "男性" : "女性");
  set("attitude", "friendly");

  set("per", 40);
  set("str", 40);
  set("cor", 40);
  set("con", 40);
  set("int", 40);
  set("spi", 40);
  set("cps", 40);
  set("kar", 40);

  set("food", 10000);
  set("water", 10000);
  set_weight(30000);

  set("no_steal", 1);

  set("taskguai", 1);

  set("chat_chance", 5);
  set("chat_msg", ({
    (: random_move :)
  }));

  setup();
}

