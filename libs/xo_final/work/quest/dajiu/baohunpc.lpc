string invocation(object me, int level) {
  object guai, env;
  string where;

  set_name(comm_man_name(), ({ me->query("id") + "'s di zi", "di zi", "dizi" }));

  guai = this_object();

  copy_status(me, level);

  set("owner", me);
  set("level", level);
  set("title", me->query("name") + "搭救的");

  if (!NPC_D->random_place(guai)) {
    return "没人在。";
  }

  env = environment(guai);
  where = guai->query("name");

  if (env) {
    where += "在" + query("area");
  }

  remove_call_out("leave");
  call_out("leave", 300);

  return where;
}

void init() {
  object me = this_object();
  object who = this_player();

  ::init();

  if (me == QUEST_D->query_quest_marks(who, "target") && owner() == who) {
    add_action("do_block", "", 1);
    add_action("do_baohu", "baohu");
    add_action("do_baohu", "dajiu");
    add_action("do_healup", "heal");
  }
}

int do_healup() {
  object who = this_player();
  object ob = this_object();

  if (ob->query("kee") > (ob->query("max_kee") - 20)) {
    message_vision("$N说了声谢谢!\n$N气色不错。\n", ob);
    return 1;
  }

  if (who->query("kee") < 300 || who->query("force") < 1000) {
    tell_object(who, "你气色更差！\n");
    return 1;
  }

  who->add("force", -200);
  ob->add("kee", 150);
  ob->add("sen", 150);
  message_vision("$N受到了$n的真气灌入!\n$N的气色看起来好多了。\n", ob, who);
  return 1;
}

int do_baohu() {
  object me = this_player();
  object ob2 = this_object();
  object ob, killer1, killer2, killer3;
  string where, where1, where2;
  int level;

  if (ob2 != QUEST_D->query_quest_marks(me, "target") || owner() != me) {
    //add by snowtu for 花仙多的话导致太多返回，不是自己的直接返回0，这样只有自己的，baohu才生效
    return 0;
  }
  /*
    {
        message_vision(CYN"$N说道：你不是我等的那个人。哎。。。。\n"NOR,ob2);
        return 1;
    }
*/

  if (!me->can_act()) {
    return notify_fail("你正忙着呢。\n");
  }

  me->run_command("say 我来也，救人一命，胜及七级浮屠。");

  if (!me->query("baohu/kk")) {
    level = random(10);

    killer1 = new(__DIR__ "guai");
    if (killer1) {
      where = killer1->invocation(me, level);
    }

    killer2 = new(__DIR__ "guai");
    if (killer2) {
      where = killer2->invocation(me, level);
    }

    killer3 = new(__DIR__ "guai");
    if (killer3) {
      where = killer3->invocation(me, level);
    }

    if (killer1) {
      me->set_temp("baohu/killer1", killer1);
    }
    if (killer2) {
      me->set_temp("baohu/killer2", killer2);
    }
    if (killer3) {
      me->set_temp("baohu/killer3", killer3);
    }

    if (killer1 && killer1->move(environment())) {
      message_vision("\n" + killer1->query("name") + "突然跳了出来......\n", me);
      killer1->run_command("follow " + me->query("id"));
      killer1->kill_ob(me);
    }
    if (killer2 && killer2->move(environment())) {
      message_vision("\n" + killer2->query("name") + "突然跳了出来......\n", me);
      killer2->run_command("follow " + me->query("id"));
      killer2->kill_ob(me);
    }
    if (killer3 && killer3->move(environment())) {
      message_vision("\n" + killer3->query("name") + "突然跳了出来......\n", me);
      killer3->run_command("follow " + me->query("id"));
      killer3->kill_ob(me);
    }

    me->set("baohu/kk", 1);
    return 1;
  }

  return 1;
}

int accept_object(object who, object ob) {
  int i, j, k;
  string str;
  object guai = this_object();
  object me = this_player();

  if (ob->name() != "令牌" || ob->query("id") != "ling pai") {
    message_vision(CYN "$N说道：这是什么玩意儿，快带我回山。\n" NOR, guai);
    return 0;
  }

  if (guai != QUEST_D->query_quest_marks(me, "target") || owner() != me) {
    message_vision(CYN "$N说道：你不是我等的那个人。\n" NOR, guai);
    return 1;
  }

  if (!me->query("baohu/done")) {
    message_vision(CYN "$N说道：我还没脱险，别磨磨蹭蹭，动作快点。\n" NOR, guai);
    return 1;
  }

  if (me->query_temp("baohu/get")) {
    message_vision(CYN "$N说道：谢谢。\n" NOR, guai);
    return 1;
  }

  me->add("baohuhuaxian", 1);
  i = (int)me->query("baohuhuaxian");
  i = 100 + random(120);

  me->add("combat_exp", i);
  str = " do dajiu got " + i + " exp";
  tell_object(me, "得到了" + chinese_number(i) + "点实战经验！\n");

  //i = 4000 + random(k);
  //MONEY_D->pay_player(me, i);
  //tell_object (me,"\n除了战斗所得，你还赢得了"+MONEY_D->money_str(i)+"的奖励！\n");
  //str = str + " and " + i + " money.";

  guai->run_command("haha " + me->query("id"));
  guai->run_command("chat " + me->query("name") + "成功搭救了" + guai->query("name") + "。");
  message_vision(CYN "$N说道：谢谢你搭救了我！。\n" NOR, guai);

  me->set_temp("baohu/get", 1);
  me->set("baohu/done", "done");

  QUEST_D->set_quest_marks(me, "result", "accomplish");

  return 1;
}

void heart_beat() {
  object guai = this_object();

  ::heart_beat();

  if (!guai || !environment(guai)) {
    return;
  }

  if (!owner() || "wait" != QUEST_D->query_quest_marks(owner(), "result")) {
    leave();
    return;
  }
}

void die() {
  object me, where, ob, target;

  target = query_last_damage_from();

  if (!target) {
    ::die();
    return;
  }

  me = this_object();
  where = environment();

  ob = owner();
  if (!ob) {
    ::die();
    return;
  }

  if (ob == target) {
    CHANNEL_D->do_channel(this_object(), "chat", "想不到" + ob->name(1) + "监守自盗，真是害死我了。。。\n");
  } else if (!present(ob, where)) {
    message_vision(CYN "$N说道：" + ob->name() + CYN "武功太烂了，害死我，你。。。。这个。。天。杀的。。，\n" NOR, me);
  } else {
    message_vision(CYN "$N说道：你武功太烂了，害死我，你。。。。这个。。天。杀的。。，$N气绝身亡了。\n" NOR, me);
  }

  if (ob && "wait" == QUEST_D->query_quest_marks(
    ob,
    "result"
  ) && me == QUEST_D->query_quest_marks(ob, "target")) {
    ob->set("baohu/fail", 1);
    ob->delete("baohu/get");
    ob->delete("baohu/kk");
    QUEST_D->set_quest_marks(ob, "result", "fail");
  }

  ::die();
}

void unconcious() {
  die();
}

void leave() {
  if (this_object()) {
    if (environment()) {
      message("vision", HIB + name() + HIB "化为地上的一朵鲜花。\n" NOR, environment());
    }

    destruct(this_object());
  }

  return;
}

varargs int receive_damage(string type, int damage, object who) {
  object me = this_object();

  damage = ::receive_damage(type, damage, who);

  if (damage > 0) {
    exertheal(me);
  }

  return damage;
}

varargs int receive_wound(string type, int damage, object who) {
  object me = this_object();

  damage = ::receive_wound(type, damage, who);

  if (damage > 0) {
    exertheal(me);
  }

  return damage;
}

void exertheal(object me) {}

int do_block(string arg) {
  object me = this_object();
  object who = this_player();
  string verb = query_verb();
  int t;

  if (!userp(who)) {
    return 0;
  }

  if (who->query_temp("baohu_kill") == 0) {
    return 0;
  }

  if (verb != "go" && !(environment() && environment()->query("exits/" + verb))) {
    return 0;
  }

  t = random(3);
  if (t == 1) {
    message_vision("$n不管$N死活，撒手跑了。\n", me, who);
    return 0;
  }

  message_vision("$N一伸手拦在$n面前，高声叫道：\n" + " 还不来救我，我要死了。\n\n", me, who);
  tell_object(who, me->name() + "一把拦住了你！\n");
  return 1;
}
