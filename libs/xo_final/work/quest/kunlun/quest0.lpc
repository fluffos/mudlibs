//Qyz
#include <ansi.h>

inherit SKILL;

mapping *quest = ({
([
    "quest" : "取清风宝剑",
    "time"  : 1200,
    "bonus" : 20,
    "quest_msg" : "$N叹了口气道：前几日一柄清风宝剑不知道哪儿去了，你帮我查一下。\n",
    "reward_msg": "$N很高兴的对你笑笑，说：好样的！真不愧是昆仑弟子。\n",
    "fail_msg"  : "$N叹了口气，说道：下去呆着吧，真是没用。\n",
    "delay_msg" : "$N很生气，说道：怎么这时候才回来？\n",
]),
([
    "quest" : "取馕",
    "time"  : 900,
    "bonus" : 6,
    "quest_msg" : "$N吩咐你：厨房需要招待几个客人，你下山去买点馕吧，\n",
    "reward_msg": "$N很高兴的对你笑笑：常跑跑腿，也是一种锻炼啊！\n",
    "fail_msg"  : "$N叹了口气，说道：下去呆着吧，真是没有用。\n",
    "delay_msg" : "$N很气愤，怎么这时候才回来？\n",
]),
([
    "quest" : "取百合",
    "time"  : 1000,
    "bonus" : 14,
    "quest_msg" : "$N吩咐你：厨房需要百合，你去哪儿弄一包来。\n",
    "reward_msg": "$N很高兴的对你笑笑：常跑跑腿，也是一种锻炼啊！\n",
    "fail_msg"  : "$N叹了口气，说道：下去呆着吧，真是没有用。\n",
    "delay_msg" : "$N很气愤，怎么这时候才回来？\n",
]),
([
    "quest" : "取"MAG"葡萄"NOR,
    "time"  : 1200,
    "bonus" : 8,
    "quest_msg" : "$N说道：听说山下的葡萄熟了，你弄点葡萄回来。\n",
    "reward_msg": "$N很高兴笑道：这葡萄真不错！！\n",
    "fail_msg"  : "$N叹了口气，说道：下去呆着吧，真是没有用。\n",
    "delay_msg" : "$N很生气地道：怎么这么慢啊？\n",
]),
([
    "quest" : "取貂裘",
    "time"  : 1500,
    "bonus" : 20,
    "quest_msg" : "$N对你点点头说道：昆仑处在寒冷地方，避寒之物不可少啊！\n"
                  "                      你去弄一件貂裘来。\n", 
    "reward_msg": "$N很高兴的对你说：你真能干啊。\n",
    "fail_msg"  : "$N哼哼道：不知道平日都吃饭做什么去了！\n",
    "delay_msg" : "$N很气愤，说道：你怎么这么慢！！！\n",
]),
([
    "quest" : "取指南针",
    "time"  : 1000,
    "bonus" : 6,
    "quest_msg" : "$N对你说道：“沙漠一直是去往中原的一道障碍，听说\n"
                  "  有指南针的话要好一些，你去到哪儿买一个指南针回来！\n",
    "reward_msg": "$N很高兴的对你说：这个指南针，确实是有些奇妙啊！\n",
    "fail_msg"  : "$N安慰你说：我知道你是尽力了。\n",
    "delay_msg" : "$N点了点头，叹了一口气，说道：你下去休息休息吧。\n",
]),
([
    "quest" : "取印度蛇药",
    "time"  : 800,
    "bonus" : 15,
    "quest_msg" : "$N对你说：山里有蛇，但是没有好的蛇药，听说有\n"
                  "一种印度蛇药，疗效不错，你去为大伙买一点来好了。\n",
    "reward_msg": "$N很高兴的对你说：你真能干啊。\n",
    "fail_msg"  : "$N哼哼道：不知道平日都吃饭做什么去了！\n",
    "delay_msg" : "$N很气愤，说道：你怎么这么慢！！！\n",
]),
([
    "quest" : "取梵文书籍",
    "time"  : 1000,
    "bonus" : 8,
    "quest_msg" : "$N对你说：近来常有一些印度人从山下经过，语言不通。\n"
                  "    听书山下有梵文书籍卖，你下山去买本梵文书籍回来吧。\n",
    "reward_msg": "$N很高兴的说：这书连我也看不懂，得仔细研究研究。\n",
    "fail_msg"  : "$N道：连这点小事也做不好了！\n",
    "delay_msg" : "$N很气愤，说道：你太慢了！！！\n",
]),
([
    "quest" : "取马头琴",
    "time"  : 1200,
    "bonus" : 12,
    "quest_msg" : "$N对你说：有个客人很喜欢音乐，我准备送一个好的乐器给他。\n"
                  "              你下山去买一把马头琴回来吧！\n",
    "reward_msg": "$N很高兴的说：这马头琴样子真不错。\n",
    "fail_msg"  : "$N道：连这样的事情都不能完成？！\n",
    "delay_msg" : "$N很气愤，说道：你速度太慢了！！！\n",
]),

([
    "quest" : "取"YEL"丝绸"NOR,
    "time"  : 1000,
    "bonus" : 15,
    "quest_msg" : "$N对你说：小姐要做衣服，需要"YEL"丝绸"NOR"，你去弄一匹来。\n",
    "reward_msg": "$N很高兴的对你说：你办事效率很高嘛！\n",
    "fail_msg"  : "$N哼哼道：不知道平日都吃饭做什么去了！\n",
    "delay_msg" : "$N很气愤，说道：怎么搞的？！！！\n",
]),
});

mapping query_quest()
{
    return quest[random(sizeof(quest))];
}

