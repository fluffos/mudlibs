//by lala

#include <ansi.h>

inherit SKILL;

mapping *quest = ({
  ([ "quest": "送信给慧觉",  // quest 2
  "time": 1000 + random(100),
    "send_ob": "/d/menpai/duanshi/npc/obj/letter",
    "bonus": 15 + random(8),
    "quest_msg":
    "$N说：“这里有一封信是府上给少林寺慧觉大师的，你辛苦一趟吧。”\n",
    "send_msg":
    "慧觉点头微笑道：“施主辛苦了，回去请转告贵主上，说慧觉收到信了。”\n",
    "reward_msg":
    "$N满意地对你说：“很好很好，多跑跑路，多办办事，长长见识嘛。”\n",
  ]),
  ([ "quest": "取勾魂刀",
    "time": 700,
    "bonus": 15,
    "quest_msg":
    "$N说：“听说江湖上出现了一把勾魂刀，你想法把它找来吧。”\n",
    "reward_msg":
    "$N凝视着你递给他的勾魂刀，叹道：“果然是一把好刀呀！”\n",
  ]),
  ([ "quest": "取悬泉剑",
    "time": 1200,
    "bonus": 15 + random(10),
    "quest_msg":
    "$N说：“无量派有一种自制的宝剑“悬泉剑”，你支找一把来。”\n",
    "reward_msg":
    "$N凝视着你递给他的悬泉剑，叹道：“果然是一把好剑呀！”\n",
  ]),
  ([ "quest": "杀怪老头",  // quest 4
  "time": 1200,
    "bonus": 15 + random(15),
    "positive_score": 60,
    "quest_msg":
    "$N郑重地对你说：“无量剑派有一个怪老头，曾经是段府的仇敌，\n"
    "虽然隐姓埋名，终于还是被我发现了，现在我命你去把他杀了，为大理\n"
    "段氏被去这个祸害！”\n",
    "reward_msg":
    "$N大喜，对你说：“你能办成这件事，为大理段氏出了一口气，日\n"
    "后我必将极力推举你！”\n",
    "fail_msg":
    "$N叹了一口气，说：“那贼子果然厉害，也难怪你敌不过他，只\n"
    "是，如此一来，那恶贼必将愈加猖獗，唉～～”\n",
    "delay_msg":
    "$N舒了一口气：“你一去不返，我等均以为凶多吉少，如今你终\n"
    "于杀掉那恶贼而平安归来，还属天助呀！”\n",
  ]),
  ([ "quest": "取" BLU "鱼肠剑" NOR,  // quest 6
  "time": 1600 + random(500),
    "bonus": 30,
    "quest_msg":
    "$N说道：“听说有人在大理城中得了一把宝剑，这等宝物若是落在\n"
    "凡夫俗子手中，只怕会招人窥觑，若是被心术不正之徒拿到，势将为\n"
    "祸他人，你这就下山去跑一趟吧。”\n",
    "reward_msg":
    "$N接过宝剑，拉出匣中看了看点了点头道：“嗯，倒也难为你了\n"
    "，先下去休息休息吧。“\n",
    "fail_msg":
    "$N皱了皱眉头沉吟道：“看来得我亲自走一趟了。”\n",
    "delay_msg":
    "$N接过剑来看了看，淡淡地说道：“这点小事都费这么长时间，\n"
    "罢了，你先下去吧。”\n",
  ]),
});

mapping query_quest() {
  return quest[random(sizeof(quest))];
}
