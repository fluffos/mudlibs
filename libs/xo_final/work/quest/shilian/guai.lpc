inherit NPC;

#include <ansi.h>

void copy_status(object me, int level);
void leave();

object owner()
{
    return query("owner");
}

void create()
{    
    set_name(comm_man_name(), ({ "yao guai", "guai" }) );
    set("age", 10 + random(80) );
    set("gender", random(2) ? "男性" : "女性");
    set("attitude", "heroism");

    set("per", 40);
    set("str", 40);
    set("cor", 40);
    set("con", 40);
    set("int", 40);
    set("spi", 40);
    set("cps", 40);
    set("kar", 40);

    set("food", 10000);
    set("water", 10000);
    set_weight(30000);

    set("no_steal", 1);
    set("taskguai", 1);

    set("chat_chance", 5);
    set("chat_msg", ({
         (: random_move :),
    }) );

    setup();
}

string invocation(object me, int level)
{
    object guai, env;    
    string where;

    set_name(query("name"), ({ me->query("id") + "'s stranger", "mosheng ren", "stranger" }) );

    guai = this_object();

    copy_status(me, level);

    set("owner", me);
    set("kind", QUEST_D->query_quest_marks(me, "kind"));
    set("level", level);
    set("nickname", HIR + me->query("name") + "，我恨死你了"NOR);

    me->delete_temp("quest/fight_time");

    if ( !NPC_D->random_place(guai) )
    {
        return "没人在。";
    }

    env = environment(guai);
    where = guai->query("name");

    if ( env )
    {
        where += "在" + query("area");
    }

    remove_call_out("leave");       
    call_out("leave", 300);  

    return where;
}

void leave()
{
    if ( this_object() )
    {
        if ( environment() )
        {
            message("vision", HIB + name() + HIB"嘿嘿一笑，回山去了。\n" NOR, environment());
        }

        remove_call_out("leave");
        destruct(this_object());
    }

    return;
}

