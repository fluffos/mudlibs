int accept_fight(object ob)
{
    object me = this_object();

    if ( ob != owner() || QUEST_D->query_quest_marks(owner(), "target") != me )
    {
        message_vision(CYN"$N说道：快走开，要不我吃了你。\n"NOR, me);
        return 0;
    }

    if ( query("kind") != "降" )
    {
        command("say 我不找你，你倒送上门来了，我就成全了你。");
        me->kill_ob(ob);
        return 1;
    }

    if ( query("eff_kee") < query("max_kee") 
         || query("eff_sen") < query("max_sen") )
    {
        message_vision(CYN"$N说道：我受伤了，这样打不公平吧。\n"NOR,me);
        return 0;
    }

    command("say 废话少说，尽管放马过来，看谁怕谁。");

    remove_call_out("check_result");
    call_out("check_result", 1, me, ob);

    return 1;
}

int accept_duilian(object ob)
{
    return 0;
}

int accept_bihua(object ob)
{
    return 0;
}

int forbid_kill(object ob)
{
    return !accept_fight(ob);
}

void init ()
{
    ::init ();

    if ( this_player() == owner() )
    {
        add_action("do_persuade", "persuade");
    }
}

void heart_beat()
{
    object guai = this_object();
    object who = owner(); 

    ::heart_beat();

    if ( !guai || !environment(guai) )
    {
        return;
    }

    if ( !is_fighting()
        && query("eff_kee") >= query("max_kee") / 2 
        && query("kind") != "降" 
        && query("eff_kee") < query("max_kee") )
    {
        command("exert heal");
    }

    if ( query("kee") < query("eff_kee") - 10 && query("kind") != "降" )
    {
        command("exert recover");
    }

    if ( query("sen") < query("eff_sen") - 10 ) 
    {
        command("exert refresh");
    }

    if ( !owner() || "wait" != QUEST_D->query_quest_marks(owner(), "result") )
    {
        leave();
        return;
    }
}

int check_result(object me, object ob)
{
    int guai_max_kee, ob_max_kee;

    guai_max_kee  = me->query("max_kee");
    ob_max_kee = ob->query("max_kee");

    if ( me->is_fighting() )
    {
        call_out("check_result", 1, me, ob);
        return 1;
    }

    if ( !living(me) 
        || (int)me->query("kee") < 1 
        || (int)me->query("sen") < 1 )
    {
        return 1;
    }

    if ( ((int)me->query("kee") * 100 / guai_max_kee) <= 50 )
    {
        if ( !living(me) 
            || (int)me->query("kee") < 1 
            || (int)me->query("sen") < 1 )
        {
            return 1;
        }

        if ( random(3) < 1 )
        {
            command ("say 我还没准备好，你就开打了，不算数。");
        }
        else
        {
            if ( ob->query_temp("quest/fight_time") )
            {
                command ("say 我现在方知天外有天，人外有人，我还要回山多多修炼，告辞了。");
                QUEST_D->set_quest_marks(ob, "result", "accomplish" );
                ob->delete_temp("quest/fight_time");

                leave();
                return 1;
            }
            else
            {
                command ("say 我一时大意，也没尽全力，我不服，再比一次。");
                ob->set_temp("quest/fight_time", 1);
                return 1;
            }
        }
    }
    else
    {
        command("say 哈哈，你输了，我天下无敌。");
        return 1;
    }
}

int do_persuade(string arg)
{
    object me = this_player();
    object ob = this_object();
    int guai_max_kee, guai_eff_kee;

    if ( !arg )
    {
        return 0;
    }

    if ( !ob->id(arg) || environment(ob) != environment(me) || QUEST_D->query_quest_marks(me, "target") != ob
        || owner() != me )
    {
        return notify_fail("你要劝谁？\n");
    }

    if ( QUEST_D->query_quest_marks(me, "kind") != "劝"  || ob->query("kind") != "劝" )
    {
        return 0;
    }

    if ( !me->can_act() )
    {
        return notify_fail("你正忙着呢。\n");
    }

    me->run_command("say 放下屠刀，立地成佛。");

    if ( !living(ob) )
    {
        return notify_fail("很显然，" + ob->name() + "听不见你说的话。\n");
    }

    if ( me != ob->query("owner") || !ob->is_fighting(me) )
    {
        message_vision(CYN"$N说道：你罗嗦些什么，快滚开。\n"NOR, ob);
        return 1;
    }

    guai_max_kee = ob->query("max_kee");
    guai_eff_kee = ob->query("eff_kee");

    if ( guai_eff_kee * 100 / guai_max_kee < 15 )
    {
        command("say 你说的有道理，我这就回山去。");
        QUEST_D->set_quest_marks(me, "result", "accomplish" );

        leave();
        return 1;
    }
    else if ( guai_eff_kee * 100 / guai_max_kee < 20 )
    {
        command("say 你看我现在，不比做佛快乐吗。");
        me->start_busy(1 + random(3));
        return 1;
    }
    else
    {
        me->start_busy(3);
        return notify_fail(ob->name() + "正专心致志战斗，懒得理你。\n");
    }
}

void die()
{
    object me = owner();

    if ( !me || QUEST_D->query_quest_marks(me, "target") != this_object()
        || environment(me) != environment(this_object()) )
    {
        return;
    }

    if ( QUEST_D->query_quest_marks(me, "kind") == "杀" && query("kind") == "杀" )
    {
        QUEST_D->set_quest_marks( me, "result", "accomplish" );
    }       
    else
    {
        QUEST_D->set_quest_marks( me, "result", "fail" );
    } 

    ::die();
}

int accept_object (object who, object ob)
{
    object guai = this_object();

    if ( ob->name() != "金创药" || ob->query("id") != "jinchuang yao" )
    {
        message_vision(CYN"$N说道：这是什么玩意儿，想毒死我啊。\n"NOR,guai);
        return 0;
    }

    guai->receive_curing("kee", 1000);
    guai->receive_curing("sen", 1000);
    command("exert recover");
    call_out ("destruct_ob", 1, ob);
    if ( query("eff_kee") == query("max_kee") )
    {
        message_vision(CYN"$N说道：我好了，来来来，咱们再大战三百回合。\n"NOR, guai);
    }

    return 1;
}

void destruct_ob (object ob)
{
    if ( ob )
    {
        destruct (ob);
    }
}

void kill_ob (object ob)
{
    object me = this_object();

    if ( QUEST_D->query_quest_marks(ob, "target") == me && owner() == ob )
    {
        me->set_leader(ob);
    }

    ::kill_ob(ob);
}

