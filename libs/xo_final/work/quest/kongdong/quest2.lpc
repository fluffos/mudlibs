//Qyz
#include <ansi.h>

inherit SKILL;

mapping *quest = ({
  ([ "quest": "杀将虞候",
    "time": 1000,
    "bonus": 10,
    "quest_msg":
    "$N愤愤不平地对你说：“兰州城中将虞候欺上瞒下，无恶不作，\n"
    "你去把他杀了！”\n",
    "reward_msg":
    "$N看看你，轻轻颔首：“嗯，很好。”\n",
  ]),
  ([ "quest": "取风雷刀",
    "time": 500,
    "bonus": 10,
    "quest_msg":
    "$N想了一下，“哦，我曾听人说，城里汤镖头有把风雷刀还不错\n"
    "，你这就下山去取回来我赏鉴一番。”\n",
    "reward_msg":
    "$N拿起风雷刀仔细看了看：“嗯，这风雷刀确实言过其实，并”\n"
    "不能称作什么好刀。”\n",
  ]),
  ([ "quest": "取铁砂掌谱",
    "time": 500,
    "bonus": 7,
    "quest_msg":
    "$N想了一下，“哦，我曾听人说，城里洪镖头有一本拳谱，上面\n"
