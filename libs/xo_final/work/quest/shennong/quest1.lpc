#include <ansi.h>

inherit SKILL;

string *medicine1 = ({
  "竹参", HIW "银耳" NOR, "五味子", "天麻", "蛇毒药", "黄连", "凤党", "杜仲",
  "大黄", "云南白药",
});

string *medicine2 = ({
  BLK "何首乌" NOR, HIW "山参" NOR, HIM "灵芝" NOR, MAG "甘草" NOR, "毒蛇", "金创药",
  "蜜蜂", "党参", "败耳草", HIY "虎骨" NOR,
});

string *npc1 = ({
  "小丫鬟", "青衣小厮", "书童", "仆人",
});

string *npc2 = ({
  "练功弟子", "守门弟子", "巡山弟子", "无量弟子", "女弟子", "西宗弟子",
  "小郎", "邢小玉",
});

mapping query_quest() {
  string name;
  if (random(4) == 0) {
    name = medicine1[random(sizeof(medicine1))];
    return ([ "quest": "取" + name,
      "time": 400 + random(200),
      "bonus": 3 + random(3),
      "quest_msg":
      "$N想了一想，说：“现在帮里要配药对付无量派，你去弄些\n"
      +name + "回来吧。”\n",
      "reward_msg":
      "$N点了点头说：“嗯，回来的还算及时，休息去吧。”\n",
    ]);
  }
  if (random(4) == 1) {
    name = npc1[random(sizeof(npc1))];
    return ([ "quest": "杀" + name,
      "time": 300 + random(300),
      "bonus": 4 + random(3),
      "quest_msg":
      "$N冷笑一声：“哼，你去杀一个无量派的狗东西，……以你\n"
      "的功夫，就杀" + name + "吧，快去快回。”\n",
      "reward_msg":
      "$N点头道：“好好，给本帮扬威立万，叫他们知道我们的厉害！”\n",
    ]);
  }
  if (random(4) == 2) {
    name = medicine2[random(sizeof(medicine2))];
    return ([ "quest": "取" + name,
      "time": 500 + random(300),
      "bonus": 6 + random(5),
      "quest_msg":
      "$N郑重地说：“无量派的家伙手上还是有点功夫的，要配厉害的\n"
      "药才能对付，现在缺些重要的药物，嗯，你去弄些" + name + "回来。”\n",
      "reward_msg":
      "$N一笑：“不错，有了这" + name + "本帮就又多了一分把握。\n",
    ]);
  }
  if (random(4) == 3) {
    name = npc2[random(sizeof(npc2))];
    return ([ "quest": "杀" + name,
      "time": 400 + random(400),
      "bonus": 8 + random(6),
      "quest_msg":
      "$N沉思片刻道：“你去试试无量的家伙们手上的功夫怎样，\n"
      "估计左老头你打不过，你就杀个" + name + "吧，快去快回。”\n",
      "reward_msg":
      "$N点头道：“看来无量派的功夫不怎么样啊！”\n",
    ]);
  }
}
