// by trill

#include <ansi.h>

inherit SKILL;

mapping *quest = ({
  ([ "quest": "取水晶包子",
    "time": 250,
    "bonus": 4,
    "positive_score": 2,
    "quest_msg": "$N对你说道：你去给我买个水晶包子来。\n",
    "reward_msg": "$N对你点点头。\n",
    "fail_msg": "$N对着你摇了摇头，说：“连这点事都做不好.....下去吧。”\n",
    "delay_msg": "$N似乎有些不满：“怎么现在才办好这件事？，你。。。”\n",
  ]),
  ([ "quest": "取白缎衫",
    "time": 250,
    "bonus": 4,
    "positive_score": 3,
    "quest_msg": "$N对你说道：我要一件白缎衫，你给我买一件来。\n",
    "reward_msg": "$N对你点点头。\n",
    "fail_msg": "$N对着你摇了摇头，说：“连这点事都做不好.....真是没用。”\n",
    "delay_msg": "$N似乎有些不满：“怎么现在才办好这件事？，唉。。。”\n",
  ]),
  ([ "quest": "取皂纱转角簇花巾",
    "time": 300,
    "bonus": 8,
    "positive_score": 3,
    "quest_msg": "$N对你说道：我要一顶皂纱转角簇花巾，你给我买一顶来。\n",
    "reward_msg": "$N对你点点头。\n",
    "fail_msg": "$N对着你摇了摇头，说：“连这点事都做不好.....真是没用。”\n",
    "delay_msg": "$N似乎有些不满：“怎么现在才办好这件事？，唉。。。”\n",
  ]),
  ([ "quest": "取白苎丝袍",
    "time": 300,
    "bonus": 6,
    "positive_score": 3,
    "quest_msg": "$N对你说道：我要一件白苎丝袍，你给我买一件来。\n",
    "reward_msg": "$N对你点点头。\n",
    "fail_msg": "$N对着你摇了摇头，说：“连这点事都做不好.....真是没用。”\n",
    "delay_msg": "$N似乎有些不满：“怎么现在才办好这件事？，唉。。。”\n",
  ]),
  ([ "quest": "取薄底快靴",
    "time": 300,
    "bonus": 6,
    "positive_score": 3,
    "quest_msg": "$N对你说道：我要一双薄底快靴，你给我买一双来。\n",
    "reward_msg": "$N对你点点头。\n",
    "fail_msg": "$N对着你摇了摇头，说：“连这点事都做不好.....真是没用。”\n",
    "delay_msg": "$N似乎有些不满：“怎么现在才办好这件事？，唉。。。”\n",
  ]),
  ([ "quest": "扫天井",
    "time": 400,
    "bonus": 10,
    "positive_score": 10,
    "quest_msg": "$N想了想，说道：“暂时也没什么事做，听人说天井没人打扫，你\n"
    "就先去打扫一下吧。”\n",
    "reward_msg": "$N说，“嗯，不错，能吃苦，是块好材料。”\n",
    "fail_msg": "$N瞪着你，似乎有些发怒：“让你去打扫个天井，这点小事也办不好。。。”\n",
    "delay_msg": "$N无奈地笑了笑：“扫个地都要花那么多时间。。。唉！！”\n",
  ]),
});


mapping query_quest() {
  return quest[random(sizeof(quest))];
}
