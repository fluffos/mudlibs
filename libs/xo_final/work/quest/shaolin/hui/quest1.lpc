//Hydra
#include <ansi.h>

inherit SKILL;

mapping *quest = ({
        ([      "quest":                "送信给秦天彪",
                "time":                 600+random(200),
                "send_ob":              "/d/menpai/shaolin/obj/letter",
                "bonus":                6+random(6),
                "quest_msg":
"$N说：“兰州的秦天彪以前是我寺俗家弟子，最近我寺要召集少林俗家弟子\n"
"开一次会，你去给我送封信给他通知一下吧。”\n",
                "send_msg":
"秦天彪点了点头道：“大师辛苦了，回去请转告$N大师，说我一定准时出席。”\n",
                "reward_msg":
"$N满意地对你说：“很好很好，辛苦了，你先下去歇着吧。”\n",
        ]),                      
        ([      "quest":                "打扫大雄宝殿",
                "time":                 300,
                "bonus":                4,
                "quest_msg":            
"$N想了一下，说：你去打扫一下大雄宝殿吧，那里的地也该扫扫了。\n",
                "reward_msg":      
"$N说，“嗯，不错，能吃苦，是练武的好材料。”\n",
                "fail_msg":             
"$N瞪着你，似乎有些圭怒：“让你去打扫大雄宝殿，怎么你竟。。。”\n",
                "delay_msg":            
"$N无奈地笑了笑：“扫地都要花那么多时间。。。唉！！”\n",
