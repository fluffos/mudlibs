//  峨眉派QUEST: quest0.c
//  Amber@XO Edit in 1999.1~2 for XO 1.5~2.0
//  忠诚度<300；这一部分的任务特点是必须完成，即便拖延时间也比放弃好得多。因为惩罚高于奖励。
//  扫地、打水、给NPC送消息、给NPC送东西
//  都是一些基本全能完成的任务，让玩家熟悉任务特点。

#include <ansi.h>
#include <emei.h>
#include "quest0.h"

inherit SKILL;
//  12个房间
string * place = ({ CYN"七星亭"NOR, YEL"秋水居"NOR, CYN"清风轩"NOR, "采薇坪",
    RED"丹房"NOR, GRN"对月坛"NOR, "静心斋", "静心斋", "静心斋", "琴房", "碎石小径",
    "无为轩",YEL"逍遥堂"NOR, YEL"逍遥堂"NOR, YEL"逍遥堂"NOR, GRN"竹屋"NOR,
});
//  下面的水分别来自： 天池峰瀑布，天池，玉女池, 解脱坡，古塔，初喜亭，观音泉 7处
string * water = ({ "甘甜的清水", CYN"清水"NOR, "清凉的池水", "甘甜的泉水", GRN"泉水"NOR,
    "清凉彻骨的泉水", "冰凉的泉水",
});
//  10个NPC，除了文清、如云不好找，其他的除非被杀，当然啦，很可能的。
string * dizi = ({ "如风","如云","如月","如霞","文慧","文清","彩岚","彩苹","彩薇",
    "彩妍",
});
//  需要送给弟子(NPC)的物品：
string * item = ({
    FRUIT_DIR "caomei",     // 草莓
    FRUIT_DIR "juzi",       // 桔子
    FRUIT_DIR "yangmei",    // 杨梅
    FRUIT_DIR "foushou",    // 佛手
    FRUIT_DIR "yingtao",    // 樱桃
    FOOD_DIR  "sun_gan",    // 笋干
    FOOD_DIR  "zongzi",     // 火腿粽子
    SKIRT_DIR "bailing_qunzi", // 白绫裙子
});
//  需要取的小东西，散布在峨眉区域中，锻炼玩家熟悉道路
string * things = ({
});
// give quest
mapping query_quest()
{
    int n = random(100);
    //  打扫各处（嘿嘿），计12种任务
    if ( n < 29 )//  30%概率
        return 
            ([
                "quest"     : "打扫"+ place[ random( sizeof( place ) ) ],
                "time"      : 240,
                "bonus"     : random(3) + 1,
                "penals"    : 3,
                "quest_msg" : "$N对你说：“你去帮着四处打扫打扫吧。”\n",
                "reward_msg": 
"$N对你点了点头：“不错，蛮勤快么；记住，修道要从小事作起！”\n",
                "delay_msg" : "$N看了看你，说：“嗯，知道了。”\n",
                "fail_msg"  : 
"$N有些生气地对你说：“修道要从小事作起，你连扫地这么点小事都懒得作，\n"
"怎么能修得正道呢？回去好好想想吧！”\n",
            ]);
    //  拿水罐去打水，山上山下不同之处的泉水名称不同，所以要到处跑。计7种任务
    else if ( n < 39 )//  10%概率
        return
            ([
                "quest"     : "取装满"+water[ random( sizeof( water ) ) ] +"的水罐",
                "time"      : 120 + random(240),// 2～6分钟
                "bonus"     : random(4) + 1,
                "penals"    : 4,
                "quest_msg" : 
"$N说：“你来得正好，我正想喝些清茶；你拿这个罐子，去打些泉水回来好沏茶。\n"
"记得一定要干净哦！”\n",
                "send_ob"   : EMEI_OBJ "item/pot",// 空的，打满水回来
                "reward_msg":
"$N接过水罐，微笑道：“嗯，这水很干净啊，谢谢你啊。”\n"
"你赶紧说道：“这是弟子应该的。”\n",
                "delay_msg" : 
"$N接过水罐来看了看：“这么半天才回来，算了，我也不想喝了，你去忙你的吧。”\n"
"你嗯了一声，吐了吐舌头。\n",
                "fail_msg"  : 
"$N有些生气地对你说：“修道要从小事作起，你连打水这么点小事都懒得作，\n"
"怎么能修得正道呢？回去好好想想吧！”\n",
            ]);
    //  给NPC送消息，完成方法：与其talk即可。计10种任务
    else if ( n < 59 )//  20%概率
    {
        string name = dizi[ random(sizeof(dizi)) ];
        return
            ([
                "quest"     : "叫"+ name,
            	"time"      : 30,
            	"bonus"     : 2,
            	"penals"    : 3,
            	"quest_msg" : 
"$N看了看你，说：“你去告诉" + name + "，叫她一会儿到我这里来，我有事和她讲。\n"
"快去！”\n",
            	"reward_msg":
"$N冲你笑了笑，拍拍你的肩膀说：“不错，这么快就回来啦。”\n",
                "delay_msg" :
"$N嗯了一声：“知道了，你下去吧。”\n",
                "fail_msg"  :
"$N瞪了你一眼：“不就是这么大的一块地方，你怎么会连人都找不到？！\n"
"真是......”\n",
             ]);
    }
    else if ( n < 62 )//  送蜡烛，这个任务是下面那个任务的原型，计10种任务
    {//  3%概率
        string name = dizi[ random(sizeof(dizi)) ];
        return
        ([
            "quest"     : "送"HIR"红烛"NOR"给"+name,
            "time"      : 360,
            "send_ob"   : EMEI_OBJ "item/red_candle",
            "bonus"     : 1 + random(4),
            "penals"    : 4,
            "quest_msg" :
"$N说：“对了，前天听" + name + "说她晚上想看书可油灯太暗，我正好到山下买了\n"
"些蜡烛，蛮不错的，你拿一根给她送去吧。”\n",
            "send_msg"  :
name +"见到你给她的蜡烛很是高兴：“代我多谢师傅，难为她老人家还惦记着。也谢谢\n"
"你啦，嘻嘻。”\n",
            "reward_msg":
"$N嗯了一声：“送到了就行了。”\n",
            "delay_msg" :
"$N嗯了一声：“送到了就行了，只是下次动作麻利些，是不是又抽空跑哪里玩去了啊？”\n",
            "fail_msg"  :
"$N看了看你，不太满意地说：“真是......东西哪？算了，你留着吧。”\n",
        ]);
    }
    else if ( n < 87 )//  如云从江南带来的东西，水果啦，用具啦等等，很平常的东西。72种任务
    {   //  25%概率
        string name = ( dizi - ({ "如云" }) )[ random( sizeof(dizi) - 1 ) ];
        string obj = item[ random(sizeof(item)) ];
        string ItemName = obj->query("name");
        return
        ([
            "quest"     : "送" + ItemName + "给"+name,
            "time"      : 120 + random(300),
            "send_ob"   : obj,
            "bonus"     : 1 + random(4),
            "penals"    : 4,
            "quest_msg" :
"$N说：“让你干些什么呢？对了，我这里有些如云从江南带来的" + ItemName + "，\n"
"我想你们孩子肯定更喜欢；你带去给了" + name + "吧。”\n",
            "send_msg"  :
name +"见到你给她的" + ItemName + "很是高兴：“代我多谢师傅，难为让她老人家惦记。也谢谢\n"
"你啦，嘻嘻。”\n",
            "reward_msg":
"$N嗯了一声：“送到了就行了。”\n",
            "delay_msg" :
"$N嗯了一声：“送到了就行了，只是下次动作麻利些，是不是又抽空跑哪里玩去了啊？”\n",
            "fail_msg"  :
"$N看了看你，不太满意地说：“真是......东西哪？算了，你留着吧。”\n",
        ]);
    }  
    else if ( n < 99 )//  取东西，一些不值钱的东西散布在峨眉区域中，锻炼玩家熟悉环境。
    {   //  12%概率
        string thing = things[ random( sizeof( things ) ) ];
        return
            ([
                "quest"     : "取"+ thing,
                "time"      : 120 + random(240),// 2～6分钟
                "bonus"     : random(3) + 1,
                "penals"    : 3,
                "quest_msg" : 
"$N赞许地看了看你：“嗯，好吧，就让你去跑跑腿儿：替为师取些" + thing + "回来。”\n",
                "reward_msg":
"$N接过"+thing+"来，道：“好好，你去歇着吧。”\n",
                "delay_msg" : 
"$N接过"+thing+"来：“这么半天才回来，是不是到哪儿偷着玩去了？”\n",
                "fail_msg"  : 
"$N有些生气地说：“修道要从小事作起，你这么点小事都懒得作，怎么能修得正道\n"
"呢？回去好好想想吧！”\n",
            ]);
    }
    else// 1%的几率。嘿嘿，白花花的银子不能留在手里，多可惜啊～～（1种任务）
        return
        ([
            "quest"     : "送"WHT "银子" NOR"给严子天",
            "time"      : 400,
            "send_ob"   : MONEY_DIR "silver",
            "bonus"     : 10,
            "penals"    : 20,// Grin...
            "quest_msg" :
"$N有些不耐烦地对你说：“你要是实在没有什么事可做的话，山下小镇上茶馆的老板\n"
"常送茶叶给我，我也怪不好意思的。你拿这银子给他送去，千万要他收下再回来；我要是\n"
"自己去他肯定是不会收的。”\n",
            "send_msg"  :
"严子天见到你给她的银子很是高兴：“哎呀呀，这怎么使得！你师傅是仙人呀，能到我这\n"
"里喝茶我求还求不来呢，怎么能收钱啊！？”客套了半天，总算收下了。\n",
            "reward_msg":
"$N很满意地对你说：“不错，出去没给我丢脸，你去歇着吧。有时间多看看书、复习\n"
"一下我教你的炼气之术才是正经的。”\n",
            "delay_msg" :
"$N嗯了一声：“送到了就行了，只是下次动作麻利些，是不是又抽空跑哪里玩去了啊？”\n",
            "fail_msg"  :
"$N看了看你，很不满意地说：“真是给我丢人......银子哪？算了，你留着使吧。”\n",
        ]);
}

