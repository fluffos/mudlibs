int do_free(string str) {
  object ob, who, env;
  string where;

  ob = this_player();
  if (!who = present(str, this_object())) return notify_fail("释放谁?\n");
  message_vision("$N将$n释放了!\n", ob, who);
  message("system", "\n\n  [1;32m " + who->name(1) + "出狱了, 希望他能改过自新, 下次不要再犯法了。[0m\n\n", users());
  where = who->query("putjail_position");
  if (where) {
    env = load_object(where);
    if (env && env != this_object()) {
      message_vision("$N被传送回" + env->query("short") + "了..\n", who);
      who->move(env);

    } else who->move("/d/city/wumiao");
  } else who->move("/d/city/wumiao");
  who->delete_temp("out_of_power");
  who->delete("putjail_time");
  who->delete("putjail_position");
  who->save();
  return 1;
}


int no_fly(string str) {
  write("哈哈哈~~~你是插翅也难飞了~~~~~呵呵~~:p\n");
  return 1;
}
