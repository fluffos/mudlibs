string chinese_number(int i) {
  return CHINESE_D->chinese_number(i);
}
string to_chinese(string str) {
  return CHINESE_D->chinese(str);
}
int is_chinese(string str) {
  // Originally a GBK lead-byte range check (str[0] > 160 && str[0] < 255,
  // strlen>=2 meaning "at least one full 2-byte GBK char"). This driver's
  // strings are native UTF-8: str[0] is a full Unicode codepoint, not a
  // raw byte, and strlen() counts characters, not bytes. Rewritten to a
  // direct CJK Unified Ideographs codepoint range check (see AGENTS.md §15h).
  if (strlen(str) >= 1 && str[0] >= 0x4e00 && str[0] <= 0x9fff) return 1;
  return 0;
}
