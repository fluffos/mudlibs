// Last edited by deforce on 03-03-2010
inherit CONTAINER;
inherit M_GETTABLE;
inherit M_VALUABLE;
inherit M_WEARABLE;

/* Two inherits define mudlib_setup, ob_state, query_body_size, remove(); the later one was already in effect: name it. */
void mudlib_setup() { m_valuable::mudlib_setup(); m_wearable::mudlib_setup(); }
mixed ob_state() { return m_wearable::ob_state(); }
int query_body_size() { return m_wearable::query_body_size(); }
void remove() { m_wearable::remove(); }

void setup()
{
   set_id("backpack", "pack");
   set_long("A pack that you can wear on your back.");
   add_relation("in");
   set_default_relation("in");
   set_mass(20000);
   set_max_capacity(320);
   set_slot("back");
}

mixed indirect_get_obj_from_obj(object ob1, object ob2) { return 1; }
mixed indirect_put_obj_wrd_obj(object ob1, object ob2) { return 1; }

int is_carry_container() { return 1; }
varargs int query_hide_contents() { return 1; }