inherit OBJ;
inherit M_GETTABLE;
inherit M_VALUABLE;

/* Two inherits define mudlib_setup(); the later one was already in effect: name it. */
void mudlib_setup() { m_valuable::mudlib_setup(); }

void setup()
{
   set_id("medium-length steel blade", "steel blade", "medium-length blade", "blade", "blade_medium");
   set_long("A medium-length steel blade.");

   set_mass(1100);
   set_value(1440);
}