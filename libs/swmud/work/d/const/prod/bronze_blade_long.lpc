inherit OBJ;
inherit M_GETTABLE;
inherit M_VALUABLE;

/* Two inherits define mudlib_setup(); the later one was already in effect: name it. */
void mudlib_setup() { m_valuable::mudlib_setup(); }

void setup()
{
   set_id("long bronze blade", "bronze blade", "long blade", "blade", "blade_long");
   set_long("A long bronze blade.");

   set_mass(1000);
   set_value(600);
}