inherit OBJ;
inherit M_GETTABLE;
inherit M_VALUABLE;

/* Two inherits define mudlib_setup(); the later one was already in effect: name it. */
void mudlib_setup() { m_valuable::mudlib_setup(); }

void setup()
{
   set_id("steel cortosis-weave axe blade", "steel blade", "axe blade", "cortosis-weave blade", "blade", "blade_axe");
   set_long("A steel axe blade with cortosis woven into it.");

   set_mass(950);
   set_value(2730);
}