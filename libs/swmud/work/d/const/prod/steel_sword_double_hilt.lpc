inherit OBJ;
inherit M_GETTABLE;
inherit M_VALUABLE;

/* Two inherits define mudlib_setup(); the later one was already in effect: name it. */
void mudlib_setup() { m_valuable::mudlib_setup(); }

void setup()
{
   set_id("steel double-sword hilt", "steel hilt", "double-sword hilt", "hilt", "hilt_double_sword");
   set_long("A steel double-sword hilt.");

   set_mass(875);
   set_value(2100);
}