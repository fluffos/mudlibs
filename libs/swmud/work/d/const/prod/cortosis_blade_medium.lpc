inherit OBJ;
inherit M_GETTABLE;
inherit M_VALUABLE;

/* Two inherits define mudlib_setup(); the later one was already in effect: name it. */
void mudlib_setup() { m_valuable::mudlib_setup(); }

void setup()
{
   set_id("medium-length steel cortosis-weave blade", "steel blade", "medium-length blade", "cortosis-weave blade", "blade", "blade_medium");
   set_long("A medium-length steel blade with cortosis woven into it.");

   set_mass(1200);
   set_value(3360);
}