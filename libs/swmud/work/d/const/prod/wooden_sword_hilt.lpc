inherit OBJ;
inherit M_GETTABLE;
inherit M_VALUABLE;

/* Two inherits define mudlib_setup(); the later one was already in effect: name it. */
void mudlib_setup() { m_valuable::mudlib_setup(); }

void setup()
{
   set_id("wooden sword hilt", "wooden hilt", "sword hilt", "hilt", "hilt_sword");
   set_long("A wooden sword hilt.");

   set_mass(150);
   set_value(120);
}