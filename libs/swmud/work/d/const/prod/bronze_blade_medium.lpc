inherit OBJ;
inherit M_GETTABLE;
inherit M_VALUABLE;

/* Two inherits define mudlib_setup(); the later one was already in effect: name it. */
void mudlib_setup() { m_valuable::mudlib_setup(); }

void setup()
{
   set_id("medium-length bronze blade", "bronze blade", "medium-length blade", "blade", "blade_medium");
   set_long("A medium-length bronze blade.");

   set_mass(800);
   set_value(480);
}