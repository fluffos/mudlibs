inherit OBJ;
inherit M_GETTABLE;
inherit M_VALUABLE;

/* Two inherits define mudlib_setup(); the later one was already in effect: name it. */
void mudlib_setup() { m_valuable::mudlib_setup(); }

void setup()
{
   set_id("bronze double-sword hilt", "bronze hilt", "double-sword hilt", "hilt", "hilt_double_sword");
   set_long("A bronze double-sword hilt.");

   set_mass(750);
   set_value(900);
}