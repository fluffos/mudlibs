inherit OBJ;
inherit M_GETTABLE;
inherit M_VALUABLE;

/* Two inherits define mudlib_setup(); the later one was already in effect: name it. */
void mudlib_setup() { m_valuable::mudlib_setup(); }

void setup()
{
   set_id("wooden axe handle", "wooden handle", "axe handle", "handle", "handle_axe");
   set_long("A wooden axe handle.");

   set_mass(400);
   set_value(320);
}