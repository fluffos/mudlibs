inherit OBJ;
inherit M_GETTABLE;
inherit M_VALUABLE;

/* Two inherits define mudlib_setup(); the later one was already in effect: name it. */
void mudlib_setup() { m_valuable::mudlib_setup(); }

void setup()
{
   set_id("short bronze blade", "bronze blade", "short blade", "blade", "blade_short");
   set_long("A short bronze blade.");

   set_mass(500);
   set_value(300);
}