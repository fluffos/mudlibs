inherit OBJ;
inherit M_GETTABLE;
inherit M_VALUABLE;

/* Two inherits define mudlib_setup(); the later one was already in effect: name it. */
void mudlib_setup() { m_valuable::mudlib_setup(); }

void setup()
{
   set_id("wooden double-sword hilt", "wooden hilt", "double-sword hilt", "hilt", "hilt_double_sword");
   set_long("A wooden double-sword hilt.");

   set_mass(375);
   set_value(300);
}