inherit OBJ;
inherit M_GETTABLE;
inherit M_VALUABLE;

/* Two inherits define mudlib_setup(); the later one was already in effect: name it. */
void mudlib_setup() { m_valuable::mudlib_setup(); }

void setup()
{
   set_id("short steel blade", "steel blade", "short blade", "blade", "blade_short");
   set_long("A short steel blade.");

   set_mass(650);
   set_value(900);
}