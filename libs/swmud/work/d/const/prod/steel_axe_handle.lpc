inherit OBJ;
inherit M_GETTABLE;
inherit M_VALUABLE;

/* Two inherits define mudlib_setup(); the later one was already in effect: name it. */
void mudlib_setup() { m_valuable::mudlib_setup(); }

void setup()
{
   set_id("steel axe handle", "steel handle", "axe handle", "handle", "handle_axe");
   set_long("A steel axe handle.");

   set_mass(1200);
   set_value(2240);
}