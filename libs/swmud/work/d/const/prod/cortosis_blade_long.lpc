inherit OBJ;
inherit M_GETTABLE;
inherit M_VALUABLE;

/* Two inherits define mudlib_setup(); the later one was already in effect: name it. */
void mudlib_setup() { m_valuable::mudlib_setup(); }

void setup()
{
   set_id("long steel cortosis-weave blade", "steel blade", "long blade", "cortosis-weave blade", "blade", "blade_long");
   set_long("A long steel blade with cortosis woven into it.");

   set_mass(1600);
   set_value(4200);
}