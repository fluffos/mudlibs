inherit OBJ;
inherit M_GETTABLE;
inherit M_VALUABLE;

/* Two inherits define mudlib_setup(); the later one was already in effect: name it. */
void mudlib_setup() { m_valuable::mudlib_setup(); }

void setup()
{
   set_id("bronze sword hilt", "bronze hilt", "sword hilt", "hilt", "hilt_sword");
   set_long("A bronze sword hilt.");

   set_mass(400);
   set_value(360);
}