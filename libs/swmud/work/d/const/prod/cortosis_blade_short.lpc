inherit OBJ;
inherit M_GETTABLE;
inherit M_VALUABLE;

/* Two inherits define mudlib_setup(); the later one was already in effect: name it. */
void mudlib_setup() { m_valuable::mudlib_setup(); }

void setup()
{
   set_id("short steel cortosis-weave blade", "steel blade", "short blade", "cortosis-weave blade", "blade", "blade_short");
   set_long("A short steel blade with cortosis woven into it.");

   set_mass(700);
   set_value(2100);
}