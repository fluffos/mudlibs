inherit OBJ;
inherit M_GETTABLE;
inherit M_VALUABLE;

/* Two inherits define mudlib_setup(); the later one was already in effect: name it. */
void mudlib_setup() { m_valuable::mudlib_setup(); }

void setup()
{
   set_id("steel axe blade", "steel blade", "axe blade", "blade", "blade_axe");
   set_long("A steel axe blade.");

   set_mass(850);
   set_value(1170);
}