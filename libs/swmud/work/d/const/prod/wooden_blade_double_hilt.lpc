inherit OBJ;
inherit M_GETTABLE;
inherit M_VALUABLE;

/* Two inherits define mudlib_setup(); the later one was already in effect: name it. */
void mudlib_setup() { m_valuable::mudlib_setup(); }

void setup()
{
   set_id("wooden double-blade hilt", "wooden hilt", "double-blade hilt", "hilt", "hilt_double_blade");
   set_long("A wooden double-blade hilt.");

   set_mass(300);
   set_value(240);
}