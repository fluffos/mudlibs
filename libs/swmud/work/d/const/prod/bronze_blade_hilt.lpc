inherit OBJ;
inherit M_GETTABLE;
inherit M_VALUABLE;

/* Two inherits define mudlib_setup(); the later one was already in effect: name it. */
void mudlib_setup() { m_valuable::mudlib_setup(); }

void setup()
{
   set_id("bronze blade hilt", "bronze hilt", "blade hilt", "hilt", "hilt_blade");
   set_long("A bronze blade hilt.");

   set_mass(275);
   set_value(240);
}