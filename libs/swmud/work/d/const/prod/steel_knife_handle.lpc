inherit OBJ;
inherit M_GETTABLE;
inherit M_VALUABLE;

/* Two inherits define mudlib_setup(); the later one was already in effect: name it. */
void mudlib_setup() { m_valuable::mudlib_setup(); }

void setup()
{
   set_id("steel knife handle", "steel handle", "knife handle", "handle", "handle_knife");
   set_long("A steel knife handle.");

   set_mass(85);
   set_value(140);
}