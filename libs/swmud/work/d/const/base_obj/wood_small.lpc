inherit OBJ;
inherit M_GETTABLE;
inherit M_VALUABLE;

/* Two inherits define mudlib_setup(); the later one was already in effect: name it. */
void mudlib_setup() { m_valuable::mudlib_setup(); }

void setup()
{
   set_id("small block of wood", "wood", "block", "wood block", "small wood", "wood_small");
   set_long("A small block of wood.");

   set_mass(100);
   set_value(40);
}