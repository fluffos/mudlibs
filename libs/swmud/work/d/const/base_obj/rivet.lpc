inherit OBJ;
inherit M_GETTABLE;
inherit M_VALUABLE;

/* Two inherits define mudlib_setup(); the later one was already in effect: name it. */
void mudlib_setup() { m_valuable::mudlib_setup(); }

void setup()
{
   set_id("rivet");
   set_long("A metal rivet used for fastening a blade to a handle or hilt.");

   set_mass(80);
   set_value(100);
}