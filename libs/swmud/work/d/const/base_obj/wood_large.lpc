inherit OBJ;
inherit M_GETTABLE;
inherit M_VALUABLE;

/* Two inherits define mudlib_setup(); the later one was already in effect: name it. */
void mudlib_setup() { m_valuable::mudlib_setup(); }

void setup()
{
   set_id("large block of wood", "wood", "block", "wood block", "large wood", "wood_large");
   set_long("A large block of wood.");

   set_mass(300);
   set_value(100);
}