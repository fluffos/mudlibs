inherit OBJ;
inherit M_GETTABLE;
inherit M_VALUABLE;

/* Two inherits define mudlib_setup(); the later one was already in effect: name it. */
void mudlib_setup() { m_valuable::mudlib_setup(); }

void setup()
{
   set_id("medium-sized block of wood", "wood", "block", "wood block", "medium wood", "wood_medium");
   set_long("A medium-sized block of wood.");

   set_mass(200);
   set_value(70);
}