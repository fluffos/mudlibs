inherit OBJ;
inherit M_GETTABLE;
inherit M_VALUABLE;

/* Two inherits define mudlib_setup(); the later one was already in effect: name it. */
void mudlib_setup() { m_valuable::mudlib_setup(); }

void setup()
{
   set_id("very large block of wood", "wood", "block", "wood block", "very large wood", "wood_very_large");
   set_long("A very large block of wood.");

   set_mass(500);
   set_value(150);
}