inherit OBJ;
inherit M_WEARABLE;
inherit M_GETTABLE;

/* Two inherits define mudlib_setup, ob_state, query_body_size, remove(); the later one was already in effect: name it. */
void mudlib_setup() { m_wearable::mudlib_setup(); }
mixed ob_state() { return m_wearable::ob_state(); }
int query_body_size() { return m_wearable::query_body_size(); }
void remove() { m_wearable::remove(); }

void setup()
{
   set_id("dancer's outfit", "outfit", "dancer_outfit");
   set_long("This dancer's outfit leaves little to the imagination.");

   set_slots("torso", "head");
   set_wear_message("$N $vslide on $p $o.");
   set_remove_message("$N $vslide off $p $o.");

   set_attribute_modifiers((["cha" : 10]));

   set_mass(2000);
}

int valid_wear()
{
   if (environment(this_object())->query_gender() == 2) { return 1; }

   write("You decide that you couldn't get away with wearing something like that.\n");

   return 0;
}