inherit ARMOR;
inherit ARMOR_CUSTOM;

/* Two inherits define do_check_obj, receive_object(); the later one was already in effect: name it. */
void do_check_obj() { armor_custom::do_check_obj(); }
mixed receive_object(object target, string relation) { return armor_custom::receive_object(target, relation); }

void setup()
{
   set_id("Echani shield suit", "shield suit", "suit", "armor");
   set_long("The Echani combined their talents for energy shield design with their armorcrafting skills to develop this innovative combat suit.  It provides capable defense that is augmented with a low strength energy shield.");

   set_slots("torso", "right arm", "left arm", "right leg", "left leg");

   set_armor_class(7);
   set_resistances(([ "%electrical" : 10, "%energy" : 10 ]));

   set_mass(8500);
   set_value(10000);
}