inherit ARMOR;
inherit ROBE_CUSTOM;
inherit HOOD;

/* Two inherits define do_check_obj, receive_object(); the later one was already in effect: name it. */
void do_check_obj() { robe_custom::do_check_obj(); }
mixed receive_object(object target, string relation) { return robe_custom::receive_object(target, relation); }

void setup()
{
   set_id("padawan robe", "robe");
   set_long("A plain, light-brown robe made of machine-spun wool.  It has a hood, which can be worn up or down by raising or lowering it.");

   set_slots("torso", "left arm", "right arm", "left leg", "right leg");

   set_armor_class(1);
   set_repair_skill("clothing repair");
   set_repair_guilds(({"jedi", "merchant"}));
   set_parts_type("clothing");

   set_mass(3000);
   set_value(300);
}

int is_jedi_armor() { return 1; }