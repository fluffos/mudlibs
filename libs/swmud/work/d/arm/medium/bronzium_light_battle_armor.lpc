inherit ARMOR;
inherit ARMOR_CUSTOM;

/* Two inherits define do_check_obj, receive_object(); the later one was already in effect: name it. */
void do_check_obj() { armor_custom::do_check_obj(); }
mixed receive_object(object target, string relation) { return armor_custom::receive_object(target, relation); }

void setup()
{
   set_id("bronzium light battle armor", "light battle armor", "battle armor", "armor");
   set_long("This molded armor is made of better materials than standard military issue, but is still relatively cheap and easy to mass-produce, making it ideal for light militias and the like.");

   set_slots("torso", "right arm", "left arm", "right leg", "left leg");

   set_armor_class(8);
   set_mass(18000);
   set_value(2400);
}