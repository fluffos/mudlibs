inherit ARMOR;
inherit ARMOR_CUSTOM;

/* Two inherits define do_check_obj, receive_object(); the later one was already in effect: name it. */
void do_check_obj() { armor_custom::do_check_obj(); }
mixed receive_object(object target, string relation) { return armor_custom::receive_object(target, relation); }

void setup()
{
   set_id("military suit", "suit", "armor");
   set_long("This standard issue suit provides good protection, but can be heavier and more restrictive than some of its counterparts. Even so, many mercenaries swear the tradeoffs are worth it.");

   set_slots("torso", "right arm", "left arm", "right leg", "left leg");

   set_armor_class(6);
   set_mass(14000);
   set_value(1800);
}