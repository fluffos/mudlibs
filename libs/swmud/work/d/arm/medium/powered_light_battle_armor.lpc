inherit ARMOR;
inherit ARMOR_CUSTOM;

/* Two inherits define do_check_obj, receive_object(); the later one was already in effect: name it. */
void do_check_obj() { armor_custom::do_check_obj(); }
mixed receive_object(object target, string relation) { return armor_custom::receive_object(target, relation); }

void setup()
{
   set_id("powered light battle armor", "light battle armor", "battle armor", "armor");
   set_long("This is an early attempt at power-assisted armor.  Dampening fields block the noise of servomotors, unintentionally shielding against external extremes in sonic frequencies as well.");

   set_slots("torso", "right arm", "left arm", "right leg", "left leg");

   set_armor_class(8);
   set_resistances(([ "sonic" : 25 ]));
   set_attribute_modifiers((["str" : 5]));

   set_mass(18000);
   set_value(7500);
}