inherit VIBRO_BLADE_BASE;
inherit BLADE_CUSTOM;

/* Two inherits define do_check_obj, receive_object(); the later one was already in effect: name it. */
void do_check_obj() { blade_custom::do_check_obj(); }
mixed receive_object(object target, string relation) { return blade_custom::receive_object(target, relation); }

void setup()
{
   set_id("vibroaxe", "axe", "vaxe");
   set_long("This large, heavy axe has a vibrating blade.");
   set_combat_messages("combat-blade");
   set_damage_type("slashing", 14);
   set_damage_type("striking", 14);
   set_durability(14);
   set_skill_used("slash 2h");
   set("two_hands", 1);
   set_mass(9250);
   set_value(4800);
}