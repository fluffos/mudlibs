inherit OBJ;
inherit M_GETTABLE;
inherit M_VALUABLE;
inherit M_WEARABLE;

/* Two inherits define mudlib_setup, ob_state, query_body_size, remove(); the later one was already in effect: name it. */
void mudlib_setup() { m_valuable::mudlib_setup(); m_wearable::mudlib_setup(); }
mixed ob_state() { return m_wearable::ob_state(); }
int query_body_size() { return m_wearable::query_body_size(); }
void remove() { m_wearable::remove(); }

private nosave string holster_relation = "holstered";

void set_holster_relation(string value)
{
   if (strlen(value))
   {
      holster_relation = value;
   }
}

int is_holster() { return 1; }

int has_weapons() { return sizeof(all_inventory(this_object())); }

string long()
{
   string long_desc = object::get_base_long();

   foreach (object thing in all_inventory(this_object()))
   {
      long_desc += "  " + thing->short() + " (" + holster_relation + ")\n";
   }

   return long_desc + object::get_extra_long() + this_object()->get_desc_properties();
}