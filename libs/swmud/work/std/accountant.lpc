/* Do not remove the headers from this file! see /USAGE for more info. */

inherit ADVERSARY;
inherit M_ACCOUNTANT;

/* Two inherits define begin_conversation, remove(); the later one was already in effect: name it. */
void begin_conversation() { m_accountant::begin_conversation(); }
void remove() { m_accountant::remove(); }

void mudlib_setup(mixed *args...)
{
   adversary::mudlib_setup(args...);
   m_accountant::mudlib_setup(args...);
}
