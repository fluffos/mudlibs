###############################################################################
#     Customizable runtime config file for FluffOS -- swmud (Lima-based)    #
###############################################################################
# swmud (github.com/coupdeforce/swmud) ships as "additions and changes to
# the base mudlib... must be installed over the current Lima mudlib" (the
# upstream repo's own README). work/ here is therefore built as: a full
# copy of this project's already-converted libs/lima/work/ (164, port
# 40212 -- see its NOTES.md), with every file from swmud's own tree
# overlaid on top (852 new files, 233 overriding same-path Lima files).
# Runtime config below is modeled directly on libs/lima/config.fluffos
# since swmud inherits Lima's whole architecture (capability-based
# security, natural-language command parser, no add_action()).

name : Star Wars Mud

port number : 40227

mudlib directory : /home/sunyc/src/mudlib/libs/swmud/work

# log directory resolves against the driver's launch CWD, not the mudlib
# directory -- always launch via `cd libs/swmud && driver config.fluffos`
log directory : /log

global include file : <global.h>

debug log file : execute
include directories : /include

master file : /secure/master
simulated efun file : /secure/simul_efun

save binaries directory : /secure/binaries

time to clean up : 7200
time to swap : 1800
time to reset : 1800

maximum bits in a bitfield : 1200
maximum local variables : 30
maximum evaluation cost : 5000000
maximum array size : 15000
maximum buffer size : 400000
maximum mapping size : 15000
inherit chain size : 60
maximum string length : 200000
maximum read file size : 200000
maximum byte transfer : 10000

reserved size : 0

mudlib error handler : 1
