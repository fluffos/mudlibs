#include <ansi.h>
inherit ITEM;
void setup() {}
void init() {
  add_action("do_eat", "eat");
}
void create() {
  set_name(HIW "新年礼物" NOR, ({ "li wu", "li" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "颗");
    set("long", "这是一个新年礼物。\n");
    set("value", 0);
  }
  setup();
}

int do_eat(string arg) {
  int fw;
  int force_limit, neili_limit, force_skill, add_skill, improve;

  object me = this_player();

  if (!id(arg))
    return notify_fail("你要吃什么？\n");
  me->add("money", 3000);
  message_vision(HIM "$N吃了下去，真好吃！\n" NOR, me);
  destruct(this_object());
  return 1;
}
