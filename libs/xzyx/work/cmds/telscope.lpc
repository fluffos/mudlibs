#include <ansi.h>

inherit ITEM;
void init() {
  add_action("do_see", "see");

}
void create() {
  set_name(HIY "望远镜" NOR, ({ "telscope" }));
  set_weight(5000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "这是一个普通的望远镜，你可以用他来监视你附近的动静\n" +
      "如：see south。 see none取消监视。\n");
    set("unit", "副");
    // set("no_drop","这么好的东西，还是好好留着吧。\n");
    set("value", 50000);
    set("material", "gold");

  }
  setup();
}

int do_see(string arg) {
  mapping exits;
  object env, me;
  me = this_player();
  env = environment(me);
  if (!arg || arg == "") return 0;
  if (arg == "none")
    if (env = me->query_temp("snoop")) {
      env->delete_temp("snp/" + me->query("id"));
      me->delete_temp("snoop");
      message_vision("$N取消了监视。\n", me);
      remove_call_out("clear_temp");
      return 1;
    } else return notify_fail("你并没有在监视\n");
  if (me->query_temp("snoop")) return notify_fail("你现在正在监视呢！\n");
  if (me->query("jing") < 50) return notify_fail("你太累了，没法集中精力监视\n");
  if (mapp(exits = env->query("exits")) && !undefinedp(exits[arg])) {
    if (objectp(env = find_object(exits[arg])))
      env->set_temp("snp/" + me->query("id"), me);
    else {
      call_other(exits[arg], "???");
      find_object(exits[arg])->set_temp("snp/" + me->query("id"), me);
    }
    message_vision("$N拿起望远镜开始监视" + arg + "方向的动静\n", me);
    //me->command("look "+arg);
    me->force_me("look " + arg);
    me->set_temp("snoop", env);
    call_out("clear_temp", 60, env, me);
    return 1;
  }
  return notify_fail("你要看哪里？\n");
}

void clear_temp(object env, object me) {
  env->delete_temp("snp/" + me->query("id"));
  tell_object(me, "你监视了半天，太累了，先休息一会吧\n");
  me->delete_temp("snoop");
  me->add("jing", -30);


}
