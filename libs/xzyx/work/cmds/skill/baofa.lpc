// baofa.c

#include <skill.h>

inherit F_CLEAN_UP;

int main(object me, string arg) {
  string rennai;
  int result;

  seteuid(getuid());

  if (me->is_busy())
    return notify_fail("( 你上一个动作还没有完成，不能施用爆发力。)\n");

  if (!arg)
    return notify_fail("你要用爆发力做什么？\n");

  if (stringp(rennai = me->query_skill_mapped("rennai"))) {
    notify_fail("你所学的忍耐技能中没有这种功能。\n");
    if (SKILL_D(rennai)->baofa_function(me, arg)) {
      if (random(120) < (int)me->query_skill("rennai"))
        me->improve_skill(rennai, 1, 1);
      return 1;
    } else if (SKILL_D(rennai)->baofa_function(me, arg)) {
      if (random(120) < (int)me->query_skill("rennai", 1))
        me->improve_skill("rennai", 1, 1);
      return 1;
    }
    return 0;
  }

  return notify_fail("你请先用 enable 指令选择你要使用的忍耐技能。\n");
}

int help(object me) {
  write(@HELP
指令格式：baofa <功能名称> [<施用对象>]

使用人类潜在的爆发力。你必需要指定<功能名称>，<施用对象>则可有可无。
请参考 help rennai 可得知一些大部分爆发力都有的功能。
HELP
  );
  return 1;
}
