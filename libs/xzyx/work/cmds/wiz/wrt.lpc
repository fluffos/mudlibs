#include <ansi.h>
inherit F_CLEAN_UP;
int main(object me, string arg) {
  write_file(arg,
    HIY + BLINK + BBLK "
           欢迎光临 驰骋天下

" NOR + HIR "★" HIY "   驰骋天下MUD已经正式开放，但是如果您发现有
     任何有关解谜或系统中的问题，请向巫师们汇报
" HIR "★" HIY "   请用help rules 来查询游戏规则，对于履次犯规
     的玩家，本MUD将采取在泥巴世界中最严厉的惩罚。
" HIR "★" HIY "   当巫师在繁忙地进行测试的时候，请尽量不要打扰
" HIR "★" HIY "   有问题请到留言板POST出来，不要给巫师写信。
" HIR "★" HIY "   请 suicide 掉所有不用的帐号，以节省系统开销\n" NOR

  );
  return 1;
}
