#include <login.h>
#include <ansi.h>
inherit F_CLEAN_UP;

int main(object me, string arg) {
  object who;

  if (!arg) {
    if (me->query("level") < 50
      || me->query_score("reputation") < 60000) return notify_fail("只有声望够高的顶级玩家才有建帮的资格。\n");

    if (me->query("clan/create")) return notify_fail("每个人一生只允许\创造一次新帮派。\n");

    if (me->query("clan/clan_level")) return notify_fail("你已经是帮派成员了, 请先脱离原来帮派。\n");

    if (me->query_temp("clan/sign_number") < 2) return notify_fail("你至少得找两个副手来帮忙才能建帮。\n");
    write("目前已有的帮派如下: \n\n");
    seteuid(ROOT_UID);
    write(read_file("/obj/CLAN"));
    write("\n在帮名决定之前, 可随时以指令:q脱离建帮手续。请\n");
    write("创一具风格的全新帮派。请输入帮派名: ");
    input_to("get_clan_name", me);
    return 1;
  }

  if (sscanf(arg, "with %s", arg)) {
    if (me->query("level") < 44) return notify_fail("你的等级不足以参与建帮。\n");

    if (me->query("clan/clan_level")) return notify_fail("你已经是帮派成员了, 无法帮助外人建帮。\n");

    if (me->query("clan/signed")) return notify_fail("你已经帮忙成立过帮会了。\n");

    who = present(arg, environment(me));

    if (who == me) return notify_fail("请找自己以外的人帮忙。\n");

    if (!objectp(who) || !living(who))
      return notify_fail("这里没有这个人。\n");

    message_vision(HIW "$N决定协助$n创立一个新帮派。\n" NOR
      , me, who);

    who->add_temp("clan/sign_number", 1);
    me->set("clan/signed", 1);
#ifdef SAVE_USER
    me->save();
#endif
    return 1;
  } else {
    tell_object(me,
      "指令格式: cestablish 或是 cestablish with <某人>\n");
    return 1;
  }
}

private void get_clan_name(string arg, object me) {
  seteuid(getuid(me));
  me->set("clan/clan_name", arg);
  write("您确定要用这当您的帮派名吗(y/n/q)？");
  input_to("confirm_name", me);
}

private void confirm_name(string yn, object me) {
  if (yn == "") {
    write("您确定要用这当您的帮派名吗(y/n)？");
    input_to("confirm_name", me);
    return;
  }
  if (yn == "q") {
    write("那么....下次吧。\n");
    return;
  }

  if (yn[0] != 'y' && yn[0] != 'Y') {
    write("那么请重新输入您想要的帮派名字: ");
    input_to("get_clan_name", me);
    return;
  }
  seteuid(ROOT_UID);
  // keep in /log/CLAN
  log_file("CLAN", sprintf("[%s] %s 由 %s(%s) 创立\n",
    ctime(time()), me->query("clan/clan_name"), me->name(),
    me->query("id")));
  // write in /obj/CLAN for player to query clan data
  write_file("/obj/CLAN", sprintf("[%s] %s 由 %s(%s) 创立\n",
    ctime(time()), me->query("clan/clan_name"), me->name(),
    me->query("id")));
  write("请输入这个帮派领导人的称号(如: 帮主, 门主, 掌门): ");
  input_to("get_clan_rank", me);
}

private void get_clan_rank(string arg, object me) {
  if (strlen(arg) > 4) {
    write("称号过长, 请重新输入: ");
    input_to("get_clan_rank", me);
  }
  seteuid(getuid(me));
  me->set("clan/rank", arg);
  me->set("clan/nick", "第一代大头目");
  me->set("clan/clan_level", 3);
  me->set("clan/elder", 0);
  write("您确定要用这当您的帮派称号吗(y/n)？");
  input_to("confirm_rank", me);
}

private void confirm_rank(string yn, object me) {
  object mark;

  if (yn == "") {
    write("您确定要用这当您的帮派称号吗(y/n)？");
    input_to("confirm_rank", me);
    return;
  }

  if (yn[0] != 'y' && yn[0] != 'Y') {
    write("那么请重新输入您想要的帮派称号: ");
    input_to("get_clan_rank", me);
    return;
  }
#ifdef SAVE_USER
  me->save();
#endif
  message("system", HIW "天朝公告: " + me->query("clan/clan_name")
    + "已由" + me->name() + "创立完成, 开始招收帮众!!\n" NOR, users());
  mark = new("/obj/clan_symbol");
  mark->move(me);
  return;
}


int help(object me) {
  write(@HELP
本指令用途为成立帮派, 想成立帮派的人(以下以帮主称之)首先需
找人(以下以帮众称之)协助一起进行, 方能成立新帮派。在成立帮
派之初, 帮众人数必需在两人以上, 而各项成立帮派之限制请参阅
: help clan, 指令格式如下:
1. 帮众□
   cestablish with <某人>
2. 帮主
   cestablish
   并随指示填入帮派各项基本资料。□
HELP
  );
  return 1;
}
