#include <ansi.h>

inherit F_SSERVER;

int perform(object me) {
  string msg;
  object weapon, target;
  int skill, ap, dp, neili_wound, qi_wound;
  int a;

  me->clean_up_enemy();
  target = me->select_opponent();

  skill = me->query_skill("lengxue-dao", 1);

  if (!(me->is_fighting()))
    return notify_fail("「狂风乱舞」只能对战斗中的对手使用。\n");

  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "blade")

    return notify_fail("你没有刀，使不出[狂风乱舞]。\n");

  if (skill < 60)
    return notify_fail("你的「冷血刀法」等级不够, 不能使用「狂风乱舞」！\n");

  if (me->query("neili") < 250)
    return notify_fail("你的内力不够，无法运用「狂风乱舞」！\n");

  msg = HIR "$N口中默念起[御风术]，猛的一个飞上了几丈高的地方，暗运十成气息于刀上，突然向下直飞下来，手中的刀一顿乱 舞着，暗藏着无限的杀机，只见$N手中的刀越舞越快，逼得$n两眼都睁不开了。\n" NOR;
  message_vision(msg, me, target);

  ap = me->query("combat_exp") + skill * (300 + random(100)) + random(10000);
  dp = target->query("combat_exp") / 2;
  if (dp < 1)
    dp = 1;
  a = random(10);
  if (ap > dp - random(dp / 4)) {
    if (userp(me))
      me->add("neili", -200);

    msg = HIR "只见$N手中的刀直劈向$n，刹时间，$n的脑袋象开了花一般，狂喷鲜血！\n" NOR;
    neili_wound = 200 + random(skill) / 2;
    if (neili_wound > target->query("neili"))
      neili_wound = target->query("neili");
    qi_wound = 300 + random(skill) / 3;
    if (qi_wound > target->query("qi"))
      qi_wound = target->query("qi");

    target->add("neili", -neili_wound);
    target->add("qi", -qi_wound);
    me->start_busy(3);
  } else {
    msg = HIR "只见$n不慌不忙，轻轻一闪，躲过了$N的必杀一击！\n" NOR;
    if (userp(me))
      me->add("neili", -200);
    me->start_busy(4);
  }
  message_vision(msg, me, target);

  return 1;
}
