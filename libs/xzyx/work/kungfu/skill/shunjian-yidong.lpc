// 圣殿 之瞬间移动
#include <ansi.h>
inherit SKILL;

mapping *action = ({
  ([
    "action": "$n神情一凛，足下生风，一式" HIY "「浪子回头」" NOR "早已躲开$N的攻击。\n",
  ]),
  ([
    "action": "$n不顾$N攻势，运起全部功力，一式" HIC "「移步换景」" NOR "，合身扑向$N，吓得$N连忙闪到一旁。\n",
  ]),
  ([
    "action": "$n身形微沉，猛一踏地，一式" HIM "「平步青云」" NOR "，疾冲云霄，$N的眼前竟没有了$n踪迹。\n",
  ]),
  ([
    "action": "$n不躲不闪，突然大喝一声，正是一式" HIY "「晴空霹雳」" NOR "，$N攻势一顿，$n便趁势躲了开去。\n",
  ]),
  ([
    "action": "$n身形一矮，一式「凌空虚渡」，贴地而行，避开了$N的锋芒。\n",
  ])
});

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

int valid_enable(string usage) {
  return usage == "dodge";
}

int valid_learn(object me) {
  if ((int)me->query("dex") < 15)
    return notify_fail("你不适合学[瞬间移动]。。\n");
  return 1;
}

string query_dodge_msg(string limb) {
  object me, ob;
  mapping action;

  me = this_player();
  action = query_action(me, ob);

  return action["action"];
}

int practice_skill(object me) {
  if ((int)me->query("qi") < 30)
    return notify_fail("你的体力太差了，不能练习瞬间移动。\n");
  me->receive_damage("qi", 25);
  return 1;
}
