// lianfa.c 「连发」

#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>

inherit F_SSERVER;
int perform(object me, object target) {
  object weapon;
  string msg;
  int i;

  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("「连发」只能对战斗中的对手使用。\n");

  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "gun")
    return notify_fail("你使用的武器不对。\n");

  if ((int)me->query_skill("jiguang-gun", 1) < 80)
    return notify_fail("你的激光枪法不够娴熟，不会使用「连发」。\n");
  if ((int)me->query_skill("jiqi-gaizao", 1) < 80)
    return notify_fail("你的机器改造不够娴熟，不会使用「连发」。\n");
  msg = HIY "$N忽然上满弹药，连发数枪。\n";
  message_vision(msg, me, target);
  for (i = 0; i < 3; i++)
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0);

  me->start_busy(4);
  me->add("neili", -400);
  return 1;
}
