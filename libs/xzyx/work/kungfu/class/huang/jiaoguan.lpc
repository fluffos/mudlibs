#include <ansi.h>
inherit NPC;
inherit F_MASTER;

void create() {
  set_name("武术教官", ({ "jiao guan", "guan" }));
  set("long",
    "他就是皇族的小统领。\n"
    "他已年过半百。\n");
  set("gender", "男性");
  set("age", 50);
  set("attitude", "peaceful");
  set("shen_type", 1);
  set("str", 30);
  set("int", 25);
  set("con", 30);
  set("dex", 30);

  set("max_qi", 10000);
  set("max_jing", 1800);
  set("neili", 5000);
  set("max_neili", 5000);
  set("jiali", 100);
  set("combat_exp", 500000);
  set("score", -7000);

  set_skill("force", 120);
  set_skill("baqi-jue", 120);
  set_skill("dodge", 120);
  set_skill("yuneng-shu", 120);
  set_skill("weizhen-steps", 120);
  set_skill("bashan-zhang", 120);
  set_skill("parry", 120);
  set_skill("literate", 120);
  set_skill("rennai", 120);
  set_skill("unarmed", 120);
  set_skill("sword", 120);
  set_skill("dingbang-jian", 120);
  map_skill("force", "baqi-jue");
  map_skill("rennai", "yuneng-shu");
  map_skill("dodge", "weizhen-steps");
  map_skill("parry", "dingbang-jian");
  map_skill("unarmed", "bashan-zhang");
  map_skill("sword", "dingbang-jian");
  create_family("皇族", 3, "小统领");
  setup();
  carry_object("/d/huang/obj/shoujia")->wear();

}

void attempt_apprentice(object ob) {
  command("say 好吧，我就收下你了。");
  command("say 希望你它日能助我族一统天下！");
  command("recruit " + ob->query("id"));
  if ((string)ob->query("class") != "killer")
    ob->set("class", "killer");
}
