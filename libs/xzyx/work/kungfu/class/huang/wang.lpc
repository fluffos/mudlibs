// wang.c

inherit NPC;
#include <ansi.h>
inherit F_MASTER;

void create() {
  set_name("南角王", ({ "nianjiao wang", "wang" }));
  set("nickname", HIB "叱咤风云" NOR);
  set("long",
    "他就是皇族的二号人物。\n"
    "他已年过半百。\n");
  set("gender", "男性");
  set("age", 50);
  set("attitude", "peaceful");
  set("shen_type", 1);
  set("str", 30);
  set("int", 25);
  set("con", 30);
  set("dex", 30);

  set("max_qi", 8000);
  set("max_jing", 6000);
  set("neili", 100000);
  set("max_neili", 100000);
  set("jiali", 350);
  set("combat_exp", 8000000);
  set("score", -7000);

  set_skill("force", 180);
  set_skill("baqi-jue", 180);
  set_skill("dodge", 180);
  set_skill("weizhen-steps", 180);
  set_skill("strike", 180);
  set_skill("bashan-zhang", 180);
  set_skill("parry", 180);
  set_skill("literate", 180);
  set_skill("dingbang-jian", 180);
  set_skill("sword", 180);
  set_skill("cuff", 180);
  set_skill("chiyan-quan", 180);
  map_skill("force", "baqi-jue");
  map_skill("dodge", "weizhen-steps");
  map_skill("parry", "dingbang-jian");
  map_skill("strike", "bashan-zhang");
  map_skill("cuff", "chiyan-quan");
  map_skill("sword", "dingbang-jian");
  create_family("皇族", 2, "大统领");
  set("chat_chance", 1);
  set("chat_msg", ({
    "南角王说道：现在天下四分，谁会是最后的胜者呢？\n",
    "南角王自言自语的说：皇兄近来好象有什么心事一样。\n",
    "南角王深深的叹了口气。\n",
  }));

  setup();
  carry_object("/d/huang/obj/yuhua")->wield();
  carry_object("/d/huang/obj/pao")->wear();

}

void attempt_apprentice(object ob) {
  if ((int)ob->query_skill("baqi-jue", 1) < 130) {
    command("say 你的霸气诀还太差了");
    return;
  }
  command("say 好吧，我就收下你了。");
  command("say 希望你它日能助我族一统天下！");
  command("recruit " + ob->query("id"));
  if ((string)ob->query("class") != "killer")
    ob->set("class", "killer");
}
