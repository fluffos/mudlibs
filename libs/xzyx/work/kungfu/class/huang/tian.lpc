#include <ansi.h>
inherit NPC;
inherit F_MASTER;

void consider();
string ask_me();

void create() {
  set_name("天广皇", ({ "huang", "tianguang huang" }));
  set("title", HIR "皇族领袖" NOR);
  set("nickname", BLU "霸主" NOR);
  set("gender", "男性");
  set("age", 200);
  set("long",
    "他就是天广皇。一心只想一统天下，因此被人称作「霸主」。\n");
  set("attitude", "peaceful");
  set("class", "scholar");

  set("str", 21);
  set("int", 30);
  set("con", 26);
  set("dex", 30);

  set("chat_chance", 1);
  set("chat_msg", ({
    "天广皇叹了口气道：“唉 …… 何时才能君临天下啊 ……”\n",
    "天广皇低头沉思，悠然不语。\n",
  }));
  set("inquiry", ([
    "天广皇": "就是老子我! \n",
    "霸业": "如果你能帮我争天下，我一定重重谢你。\n",
  ]));

  set("qi", 10000);
  set("max_qi", 10000);
  set("jing", 8000);
  set("max_jing", 8000);
  set("neili", 200000);
  set("max_neili", 200000);
  set("jiali", 500);

  set("book_count", 1);
  set("combat_exp", 10000000);
  set("score", 0);

  set_skill("force", 200);             // 基本内功
  set_skill("baqi-jue", 200);     // 霸气诀
  set_skill("yuneng-shu", 200);
  set_skill("rennai", 200);
  set_skill("unarmed", 200);           // 基本拳脚
  set_skill("dodge", 200);             // 基本躲闪
  set_skill("parry", 200);             // 基本招架
  set_skill("weizhen-steps", 200);
  set_skill("sword", 200);             // 基本剑法
  set_skill("dingbang-jian", 200);  // 定邦剑法
  set_skill("literate", 200);
  // 读书识字

  map_skill("force", "baqi-jue");
  map_skill("dodge", "weizhen-steps");
  map_skill("parry", "dingbang-jian");
  map_skill("sword", "dingbang-jian");


  create_family("皇族", 1, "霸主");
  setup();

  carry_object("/d/huang/obj/taigu")->wield();
  carry_object("/d/huang/obj/pao")->wear();
}

void attempt_apprentice(object ob) {
  if ((int)ob->query_skill("baqi-jue", 1) < 150) {
    command("say 你的霸气诀还太差了");
    return;
  }
  command("say 好吧，我就收下你了。");
  command("say 希望你它日能助我一统天下！");
  command("recruit " + ob->query("id"));
  if ((string)ob->query("class") != "killer")
    ob->set("class", "killer");
}
