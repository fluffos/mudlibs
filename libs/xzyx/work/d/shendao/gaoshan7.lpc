#include <ansi.h>
inherit ROOM;
void haoqing(object ob);

void create() {
  set("short", "紫艳山顶");
  set("long", HIW @LONG
几经辛苦,你终于登上了"紫艳"山顶,望着山脚下正在向上攀登的人们,
一种强烈的征服感觉由心中升起.发眼望去,圣岛全景一览无遗,远离吵闹的
城市,回归清静的大自然,只见茫茫群峰拜于脚下，真乃江山多娇,心中万分
的舒畅,你不即想大吼几声:天大地大唯我最大.(aload).
LONG);
  set("outdoors", "shandao");

  set("exits", ([
    "northdown": __DIR__ "kunlun12",
    "southdown": __DIR__ "kunlun11",
  ]));

  //      set("objects", ([
  //              __DIR__"npc/guest" : 1]));

  setup();
  //      replace_program(ROOM);
}


void init() {
  object ob;

  ob = this_player();
  remove_call_out("haoqing");
  call_out("haoqing", 0, ob);

  add_action("do_aload", "aload");
}

void haoqing(object ob) {
  int imqi, ioqi;

  imqi = (int)ob->query("max_qi");
  ioqi = (int)ob->query("qi");
  if (ioqi < imqi)
    tell_object(ob, HIR "    忽然风云突变，一场大雨即将来到,刹时寒风刺骨，飞雨割面，\n"
      "你被冻得龇牙咧嘴、鼻涕直流，刚才的一番豪情壮志早被这副\n"
      "这副狼狈相清扫的踪迹全无了！\n"
      "    你只想找个避风处躲起来！\n" NOR);
}

int do_aload(string arg) {
  object me;
  me = this_player();
  if (random((int)me->query_skill("force")) <= 90) {
    //              me->receive_damage("qi", 50);
    //              me->receive_wound("qi",  50);
    message_vision(HIR "$N这一喊可了不得了，只见几个山顶保安冲了出来,一把抓住你从山上丢了下去,口中说道:我叫你在这里嚷嚷...\n" NOR, me);
    switch (random(2)) {
      case 0:
        me->move(__DIR__ "lukou");
        break;
      case 1:
        me->move(__DIR__ "gaoshan");
        break;
    }
    tell_object(me, HIR "你被保案一脚从山上踢了下来,只觉得浑身无处不疼，迷迷糊糊分不清东南西北....\n" NOR);
    message(
      "vision",
      HIR "只见" + me->query("name") + "从山上滚下了来，一头倒在地上，半天爬不起来！\n" NOR,
      environment(me),
      me
    );
    if ((int)this_player()->query("qi") < 250) this_player()->die();
    else this_player()->unconcious();
    return 1;
  }
  if (!arg || arg != "天大地大唯我最大") return notify_fail("你瞎喊什么？\n");
  message_vision(HIY
    "\n$N将手放在嘴边,对着山下大声喊到:“天大地大唯我最大”。\n" NOR, this_player());
  if (me->query("combat_exp") > 0) me->set("combat_exp", (int)me->query("combat_exp") + 200);
  else me->set("combat_exp", (int)me->query("combat_exp") - 200);
  message_vision(HIC
    "\n$N一时间心潮涌动,好像浑身充满了劲力，似乎战斗也有所提高！\n" NOR, this_player());
  return 1;
}
