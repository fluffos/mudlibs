#include <ansi.h>
inherit ROOM;

void create() {
  set("short", HIG "上山路");
  set("long", @LONG
你正走在"紫艳"山的上山路上,这里因为靠近火山口,所以空气似乎
十分稀薄,但到了山顶就好了,那里空气清欣,风景迷人,想到这你不由得
加快了脚步,想早一点到达山顶.
LONG
  );
  set("outdoors", "shendao");

  set("exits", ([
    "northwest": __DIR__ "gaoshan2",
    "southeast": __DIR__ "gaoshan",
  ]));

}


void init() {
  object ob;
  int ioqi;

  ob = this_player();
  ioqi = 300 / (int)ob->query("int") + 3;
  if ((int)ob->query("qi") < 50)
    message("vinson", HIR "你忽然感到呼吸吃力，身体发软,似乎是体内氧气不足,，歇息一会儿再走吧！\n" NOR, ob);
  ob->improve_skill("dodge", 0.1 * (int)ob->query_skill("dodge", 1));
  ob->receive_damage("qi", ioqi);
}
