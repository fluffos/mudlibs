#include <room.h>

inherit ROOM;

void create() {
  set("short", "城东街");
  set("long", @LONG
这里已经快接近圣殿了,一些圣殿武士分散各处守门着.几
个不名所谓的人,不时向那些身着白袍的武士投去慕的目光.
LONG
  );
  set("outdoors", "shendian");

  set("exits", ([
    "west": __DIR__ "cheneast3",
    "east": "/d/shendian/haian",
  ]));
  set("objects", ([
    __DIR__ "npc/wushi": 3 ]));
  setup();
}


int valid_leave(object me, string dir) {
  mapping myfam;
  myfam = (mapping)me->query("family");

  if ((!myfam || myfam["family_name"] != "圣殿") && dir == "northwest" &&
    objectp(present("wu", environment(me))))
    return notify_fail("武士一把抓住你,你干什么,非圣殿武士,不得入内.\n");

  return ::valid_leave(me, dir);
}
