#include <armor.h> 
#include <ansi.h>
inherit HEAD;
void create()
{
        set_name(HIW "光子盔"NOR, ({ "helmet", "toukui" }) );
        set_weight(2000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("material", "steel");
                set("unit", "顶");
                set("value", 150);
         set("armor_prop/armor", 10);
                set("armor_prop/dodge", 1);
        }
        setup();
}

