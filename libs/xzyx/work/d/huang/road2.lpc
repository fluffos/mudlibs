  set("short", "汉白玉路");
  set("long", @LONG
走到这里眼前一亮，这是一条铺着汉白玉的宽广的大道,再往前就是
皇族的聚居地了。
LONG);
  set("exits", ([
    "north": __DIR__ "yanwuchang",
    "west": __DIR__ "zahuopu",
    "east": __DIR__ "dianying",
    "south": __DIR__ "damen",
  ]));
  set("objects", ([ "/kungfu/class/huang/weishi": 4, ]));
  setup();
  replace_program(ROOM);
}
