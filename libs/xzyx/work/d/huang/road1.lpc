#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "不归路");
  set("long", @LONG
这是一条狭窄的小道。全由乱石堆成,显然曾花了不少人力.
给人阴森森的感觉.
LONG);

  set("exits", ([
    "north": __DIR__ "damen",
    "east": __DIR__ "luxingchu",
  ]));
  set("outdoors", "huang");
  setup();
  replace_program(ROOM);
}
