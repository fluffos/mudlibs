// taigu.c 泰古

#include <weapon.h>
#include <ansi.h>
inherit SWORD;

void create() {
  set_name(YEL "泰古神剑" NOR, ({ "taigu", "sword" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "柄");
    set("long", "这是把上古神兵，剑上篆刻着几个字" MAG "‘此剑只因天上有’。\n");
    set("value", 50000);
    set("material", "steel");
    set("no_drop", "这样东西不能离开你。\n");
    set("wield_msg", MAG "$N「唰」的一声抽出一柄$n" MAG "握在手中，只觉一股寒气扑面而来。\n");
    set("unwield_msg", HIW "$N将手中的$n" HIW "插回剑鞘，只听嗤的一声轻响。\n");
  }
  init_sword(100);
  setup();
}
