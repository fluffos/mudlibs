// yuehua.c 月华
#include <weapon.h>
#include <ansi.h>
inherit SWORD;

void create() {
  set_name(HIW "月华神剑" NOR, ({ "yuehua", "sword" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "柄");
    set("long", "这是把上古神兵，剑上篆刻着几个字" MAG "‘剑在人在，剑失人亡。’。\n");
    set("value", 50000);
    set("material", "steel");
    set("no_drop", "这样东西不能离开你。\n");
    set("wield_msg", HIB "$N「唰」的一声抽出一柄$n" HIB "握在手中，只觉一股寒气扑面而来。\n");
    set("unwield_msg", BLU "$N将手中的$n" BLU "插回剑鞘，只听嗤的一声轻响。\n");
  }
  init_sword(90);
  setup();
}
