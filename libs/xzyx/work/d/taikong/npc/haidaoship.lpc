#include <ansi.h>
inherit ITEM;
// void autoattack();
void create() {
  object me;
  string m_id, name, mubiao;
  int pohuai, nengyuan, myexp, i;
  me = this_player();
  m_id = me->query("id") + "-mubiao";
  name = me->query("name") + "的目标(海盗船)";
  mubiao = me->query("id");
  i = me->query_temp("wancheng");
  if (!me->query_skill("jiashi-shu"))
    pohuai = me->query("max_neili") * 5 + me->query("max_neili") * i;
  else
    pohuai = me->query("max_neili") * 10 + me->query_skill("jiashi-shu") * 50;
  nengyuan = me->query("max_neili") * 20 + me->query("max_neili") * 4 * i;
  myexp = me->query("combat_exp") + me->query("combat_exp") * i / 5;
  set_name(name, ({ m_id }));
  set_weight(3000000);
  set_max_encumbrance(1000000);
  set("long", "这是一艘海盗飞船。\n");
  set("unit", "艘");
  set("material", "metal");
  set("type", "战舰");
  set("value", 1000000);
  set("biao", mubiao);
  set("pohuai", pohuai);
  set("nengyuan", nengyuan);
  set("myexp", myexp);
  setup();
}
