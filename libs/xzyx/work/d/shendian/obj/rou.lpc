inherit ITEM;
inherit F_FOOD;

#include <ansi.h>
void create() {
  set_name(HIR "香肉" NOR, ({ "xian rou", "rou" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一块香喷喷的肉。\n");
    set("unit", "块");
    set("food_remaining", 4);
    set("food_supply", 20);
    set("material", "rou");
  }
  setup();
}
