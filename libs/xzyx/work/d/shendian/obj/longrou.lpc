#include <ansi.h>
inherit ITEM;
void setup() {}
void init() {
  add_action("do_eat", "eat");
}
void create() {
  set_name(HIG "火龙肉" NOR, ({ "rou", }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一小块火龙肉,是当年凤凰宗主陈信的东西,不知怎么到了阿古哒身上了。\n");
    set("unit", "块");
  }
  setup();
}
int do_eat(string arg) {
  object me = this_player();
  if (!id(arg))
    return notify_fail("你要吃什么？\n");
  me->add("max_neili", 2);
  message_vision(HIR "$N三两口吞下火龙肉,只觉得浑身发热,十分难受！\n" NOR, me);
  destruct(this_object());
  return 1;
}
