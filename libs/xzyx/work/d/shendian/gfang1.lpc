inherit ROOM;
#include <ansi.h>
int flag = 0;
void create() {
  set("short", "内间");
  set("long", @LONG
你信步来到贵宾房的内间,此间房子的当中摆着一张宽大的床,紫色的床单
直垂到地上,床上旁边的工作台上,放着一个小盒子(huo zi),墙上的墙视,正在
转播着天视台的新闻.
LONG
  );
  /*        set("objects", ([
        ]));
*/
  set("outdoors", "shendian");

  set("exits", ([
    "east": __DIR__ "gfang",
  ]));

  set("item_desc", ([
    "huo zi": "一个蓝色的盒了,上面镶着几颗宝贵的钻石,里面好象有什么东西。\n",

  ]));
  setup();
}

void init() {
  add_action("do_dakai", "dakai");
  add_action("do_dakai", "open");
}
int do_dakai(string arg) {
  object me = this_player();
  object ob;
  if (!arg || arg != "huo zi")
    return notify_fail("你要打开什么？\n");

  else if (flag == 0) {
    flag = 1;
    message_vision("你贼嘻嘻的打开小盒子,,哇噻,里面居然有一块紫色宝石。.\n", me);
    message_vision("$N你心中暗叫一声,发了,顺手把宝石放进怀里.\n" NOR, me);
    ob = new(__DIR__ "obj/baoshi");
    ob->move(this_player());

  } else message_vision("你小心翼翼地打开盒子,一股臭气从里面喷了出来,躲避不及,一口气全吃了下去,shit,$N心里狠狠的骂了一句。\n", me);


  return 1;
}
