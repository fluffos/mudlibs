#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "平台");
  set("long", @LONG
这里是一个不大不小的平台，当中停着一两卓卡，整体是青绿色的，表面如
同一般的卓卡有着生物般的皮肤，但特别的是隐隐然却又泛出金属的光泽，靠近
  卓卡门的地方有一个蓝色的按纽(请使用anxia kaiguang)。
LONG);
  set("item_desc", ([
    "kaiguang": "这显然是打开卓卡门的按纽。\n"
    "你可以按下(anxia)来试试看。\n",
  ]));
  set("exits", ([
    "northup": __DIR__ "guangchang",
  ]));
  set("no_clean_up", 0);
  setup();
}


void init() {
  add_action("do_anxia", "anxia");
}

int do_anxia(string arg) {
  object room;
  object ob = this_player();
  if (!arg || arg != "kaiguang") return notify_fail("你要按什么？\n");
  message_vision("$N轻轻的在按纽上按了一下，只听吱的几声轻响，卓卡的门真得打开了。\n\n"
    + "$N四周看了一看，轻轻一笑，弯腰走进卓越卡内\n", ob);
  tell_object(ob, "\n卓卡内空无一人，不过两排座位看来很舒服。。\n\n");
  room = load_object("/d/shendian/zhukalu");
  ob->move(room);

  call_out("mantuo", 10, ob);
  return 1;
}

int mantuo(object ob) {
  tell_object(ob, "终于卓卡停了下来,你打开门走了出来。"
    + "望四周一看，原来真得到了XXXXXX城。\n");
  ob->move("/d/city/guangchang");
  return 1;
}
