#include <room.h>

inherit ROOM;

void create() {
  set("short", "笃庞楼");
  set("long", @LONG
笃庞楼，历来是圣岛的名人集散地，圣岛在世人眼里一直是个
神圣而神秘的门派，所以各地有名有望的人都想到圣岛来一探研究，
而笃庞楼就是专门为这些人而建立的，但是听说笃庞楼只有一个房
间是从来不对外开放了，不知是什么原因？据一些小道消息，好像
那个房间以前是“凤凰星”陈大宗主住过的。
LONG);
  set("no_fight", "1");

  set("exits", ([
    "west": __DIR__ "zhoulang2",
    "up": __DIR__ "gfang",

  ]));
