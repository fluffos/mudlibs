#include <room.h>

inherit ROOM;

void create() {
  set("short", "承恩塔");
  set("long", @LONG
这里就是承恩塔的二楼，光阴不是十分的明亮，塔内空空荡荡
没有什么东西，靠近上三楼的门旁一位，看似中年的男人，手里
拿着一把剑站在那里，似乎阻止向上走的人。
LONG
  );
  //        set("outdoors", "shendian");

  set("exits", ([
    "down": __DIR__ "ta",
    "up": __DIR__ "ta2",
  ]));
  set("objects", ([
    __DIR__ "npc/peng": 1 ]));
  setup();
}


int valid_leave(object me, string dir) {
  mapping myfam;
  myfam = (mapping)me->query("family");

  if ((!myfam || myfam["family_name"] != "圣殿") && dir == "up" &&
    objectp(present("peng", environment(me))))
    return notify_fail("彭长老一把抓住你,你干什么,非圣殿武士,不得入内.\n");

  return ::valid_leave(me, dir);
}
