#include <room.h>

inherit ROOM;

void create() {
  set("short", "承恩塔");
  set("long", @LONG
这个塔叫做承恩塔，据说是无祖为了纪念某人而
命名的，其事当然已失传，众说纷纭也没有定论。你
在正处于在承恩截塔一楼的位置，这里一直以来都是
十分神秘的地方，不远处一位总是笑嘻嘻的长老正在
望着你。
LONG);
  set("exits", ([
    "up": __DIR__ "ta1",
    "south": __DIR__ "guangchang",
  ]));
  set("objects", ([
    "/d/shendian/npc/tian": 1,
  ]));
  set("outdoors", "shendian");
  setup();
}
