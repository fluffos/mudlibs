inherit NPC;
void create() {
  set_name("老流氓", ({ "lao liumang", "lao", "liumang" }));
  set("title", "凤凰败类");
  set("gender", "男性");
  set("age", 63);
  set("per", 11);

  set("long", "这位一位凤凰的弟子,年轻时专干些伤天害理的事。\n后来被圣殿田长老抓住,关在这里。\n");
  set("combat_exp", 99000);
  set("attitude", "peaceful");
  create_family("凤凰", 3, "大将");
  set_skill("literate", 100);
  set_skill("unarmed", 180);
  set_skill("dodge", 120);
  set_skill("parry", 160);
  set_skill("force", 140);
  set_skill("tenglong-zhang", 90);
  set_skill("wuzu-xinfa", 90);
  set_skill("fenghuang-shenfa", 90);
  set_skill("wudijiguang-zhan", 90);
  set_temp("apply/attack", 40);
  set_temp("apply/defense", 40);
  set_temp("apply/damage", 20);
  set_temp("apply/armor", 40);
  map_skill("unarmed", "wudijiguang-zhan");
  map_skill("parry", "wudijiguang-zhan");
  map_skill("dodge", "fenghuang-shenfa");
  map_skill("force", "wuzu-xinfa");
  set("max_jing", 1000);
  set("max_qi", 600);
  set("qi", 600);
  set("neili", 600);
  set("max_neili", 800);
  setup();
  carry_object("/clone/cloth/cloth")->wear();
}
void init() {
  object ob = this_player();

  ::init();
  if (((string)ob->query("family/family_name") == "圣殿")
    && ((int)ob->query("combat_exp") >= 100000)) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
}
void greeting(object ob) {
  if (!ob || environment(ob) != environment()) return;

  switch (random(1)) {
    case 0:
      command("laugh " + ob->query("id"));
      command("say 香嫩的人肉送上门来,嗯,看来功夫还不错呀,我们来比一比吧？");
      command("kill " + ob->query("id"));
      break;
  }
}
