#include <ansi.h>
inherit NPC;
void greeting(object ob);
void create() {
  set_name("小姐", ({ "xiao jie", "xiao", "jie" }));
  set("long", "她是都市大图书馆的接待小姐，正忙碌的敲击着键盘。\n");
  set("title", HIB "都市图书馆服务员" NOR);
  set("gender", "女性");
  set("age", 23);
  set("attitude", "friendly");
  set("shen_type", 1);

  set("per", 15);
  set("str", 15);
  set("int", 14);
  set("con", 15);
  set("dex", 16);
  set("qi", 200);
  set("max_qi", 200);
  set("jing", 200);
  set("max_jing", 100);
  set("neili", 300);
  set("max_neili", 300);
  set("combat_exp", 20000);

  set_skill("dodge", 90);
  set_skill("unarmed", 90);
  set_skill("parry", 90);

  set("chat_chance", 1);
  set("chat_msg", ({
    "接待小姐说道：欢迎您光临都市图书馆！\n",
    "接待小姐说道：您需要什么书？\n",
  }));

  setup();
  carry_object("/d/city/obj/qun")->wear();
}
