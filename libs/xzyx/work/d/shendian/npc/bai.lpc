#include <ansi.h>

inherit NPC;
inherit F_MASTER;
int ask_me();
int ask_fangqi();
int do_heal();

void create() {
  set_name("白长老", ({ "bai zhanglao", "bai", "zhanglao" }));
  set("title", HIC "圣殿长老团" NOR);
  set("long",
    "他就是圣殿的长老之一，人称“掌底游龙”的白..。\n"
  );
  set("gender", "男性");
  set("age", 110);
  set("attitude", "friendly");
  set("shen_type", 1);
  set("str", 30);
  set("int", 30);
  set("con", 30);
  set("dex", 30);
  set("per", 55);

  set("qi", 6000);
  set("max_qi", 6000);
  set("jing", 6000);
  set("max_jing", 6000);
  set("neili", 6000);
  set("max_neili", 6000);
  set("jiali", 50);
  set("combat_exp", 800000);
  set("score", 300000);

  set_skill("force", 130);
  set_skill("sword", 110);
  set_skill("parry", 120);
  set_skill("dodge", 120);
  set_skill("finger", 110);
  set_skill("literate", 140);
  create_family("圣殿", 1, "武士");

  set("inquiry", ([ "fangqi": (: ask_fangqi :),
  ]));

  setup();
}
int ask_fangqi() {
  object me = this_player();
  //  if(me->query("quest",1))
  //   {
  //    command("say 我又没有给你任务，放弃什么？");
  //    return 1;
  //   }    
  command("sigh");
  command("say 要你做一点事都做不好，怎么配做圣殿武士呀。");
  command("say 放弃任务是有惩罚的,你被减去战斗值200点。");
  command("disapp1 " + (string)me->query("id"));
  me->add("combat_exp", -200);
  me->set("quest", 0);
  return 1;
}
