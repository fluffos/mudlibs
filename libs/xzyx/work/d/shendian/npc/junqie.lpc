#include <command.h>
#include <ansi.h>
inherit NPC;
inherit F_MASTER;
void create() {
  set_name("石俊杰", ({ "shi junqie", "junqie", "shi" }));
  set("nickname", HIY "一剑震乾坤" NOR);
  set("gender", "男性");
  set("age", 35);
  set("long",
    "俊杰一手剑花练得出神入法。\n");
  set("attitude", "friendly");
  set("str", 30);
  set("int", 28);
  set("con", 30);
  set("dex", 30);
  set("per", 30);
  set("chat_chance", 1);
  set("max_qi", 1500);
  set("max_jing", 500);
  set("neili", 1500);
  set("max_neili", 1500);
  set("jiali", 100);
  set("shen_type", 1);

  set("combat_exp", 670000);
  set_skill("force", 100);
  set_skill("sword", 100);
  set_skill("parry", 100);
  set_skill("dodge", 100);
  set_skill("rennai", 100);
  set_skill("unarmed", 100);
  set_skill("parry", 100);
  set_skill("flying-shu", 100);
  set_skill("literate", 100);
  set_skill("sheshen-zhang", 100);
  set_skill("guang-jian", 100);
  set_skill("wuzhu-xinfa", 100);
  set_skill("shunjian-yidong", 100);
  map_skill("unarmed", "sheshen-zhang");
  map_skill("force", "wuzhu-xinfa");
  map_skill("dodge", "shunjian-yidong");
  map_skill("sword", "guang-jian");


  create_family("圣殿", 3, "");
  set("title", "圣殿低阶武士");
  setup();
  carry_object("/clone/misc/cloth")->wear();
  carry_object("/clone/weapon/changjian")->wield();
}

void attempt_apprentice(object ob) {
  //        if (ob->query_skill("literate",1) <= 10)
  // {
  //  command("say 虽然武功十分重要，但文化方面也不可不学，这位"+RANK_D->query_respect(ob)+"是否去读点书再来。");
  //            return;
  //       }
  command("haha");
  command("say " + RANK_D->query_respect(ob) + "很好，希望以后更加努力。");
  command("recruit " + ob->query("id"));
}
int accept_fight(object ob) {
  command("wield jian");
}
