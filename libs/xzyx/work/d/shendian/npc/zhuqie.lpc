void create() {
  set_name("朱倩", ({ "zhu qie", "zhu" }));
  set("gender", "女性");
  set("age", 68);
  set("attitude", "friendly");
  set("str", 30);
  set("int", 28);
  set("con", 30);
  set("dex", 30);
  set("per", 30);
  set("chat_chance", 1);
  set("max_qi", 2500);
  set("max_jing", 1500);
  set("neili", 3500);
  set("max_neili", 3500);
  set("jiali", 100);
  set("shen_type", 1);

  set("combat_exp", 800000);
  set_skill("force", 160);
  set_skill("sword", 160);
  set_skill("parry", 160);
  set_skill("dodge", 160);
  set_skill("literate", 160);
  set_skill("guang-jian", 160);
  set_skill("wuzhu-xinfa", 160);
  set_skill("shunjian-yidong", 160);
