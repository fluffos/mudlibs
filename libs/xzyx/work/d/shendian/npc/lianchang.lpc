#include <ansi.h>

inherit NPC;
inherit F_MASTER;
int ask_me();
int ask_abandon();
void do_heal();

void create() {
  set_name("练长风", ({ "lian changfeng", "lian", "changfeng" }));
  set("nickname", HIC "玉面情郎" NOR);
  set("long",
    "眼看此人身材高挑，五官端正、目如朗星，肌肤晒成古铜色，健壮中又含着几许温文，果然英挺帅气。\n"
  );
  set("gender", "男性");
  set("age", 24);
  set("attitude", "friendly");
  //        set("shen_type", 1);
  set("str", 40);
  set("int", 40);
  set("con", 30);
  set("dex", 30);
  set("per", 30);

  set("qi", 3000);
  set("max_qi", 3000);
  set("jing", 2000);
  set("max_jing", 2000);
  set("neili", 4000);
  set("max_neili", 4000);
  set("jiali", 120);
  set("combat_exp", 500000);
  set("score", 1000000);

  set_skill("force", 160);
  set_skill("sword", 150);
  set_skill("parry", 150);
  set_skill("dodge", 150);
  set_skill("rennai", 150);
  set_skill("unarmed", 150);
  set_skill("parry", 150);
  set_skill("flying-shu", 150);
  set_skill("literate", 150);
  set_skill("sheshen-zhang", 150);
  set_skill("guang-jian", 150);
  set_skill("wuzhu-xinfa", 150);
  set_skill("lieyang-jian", 250);
  set_skill("shunjian-yidong", 150);
  map_skill("unarmed", "sheshen-zhang");
  map_skill("rennai", "flying-shu");
  map_skill("force", "wuzhu-xinfa");
  map_skill("dodge", "shunjian-yidong");
  map_skill("sword", "lieyang-jian");

  prepare_skill("sword", "jiaoyang");

  create_family("圣殿", 2, "");

  set("title", HIR "圣殿中阶武士" NOR);
  set("chat_chance_combat", 10);
  set("chat_msg_combat", ({
    (: perform_action, "jiaoyang" :),
    (: do_heal :),
  }));
  set("inquiry", ([ "job": (: ask_me :),
    "abandon": (: ask_abandon :),
    "放弃": (: ask_abandon :),
  ]));

  setup();
  carry_object("/clone/cloth/cloth")->wear();
  carry_object("/clone/weapon/changjian")->wield(); ;
}

void do_heal() {
  command("exert recover");
  command("exert regenerate");
  return;
}

void attempt_apprentice(object ob) {
  mapping myfam;
  myfam = (mapping)ob->query("family");
  if (!(int)ob->query_temp("mask/agree") && (!myfam || ob->query("family/family_name") != "圣殿")) {
    command("say 我和你素无来往，拜师？太严重了，我可不能收你。");
    command("say 另外，如果" + RANK_D->query_respect(ob) + "没有要紧的事，最好还是速速离开本岛。");
    return;
  }
  if ((int)ob->query("shen") < 0) {
    command("say 哼，想我圣岛虽不过说联帮事务，但也不忘“行侠仗义”这几个字。");
    command("say 在德行方面，" + RANK_D->query_respect(ob) +
      "是否还做得不够？");
    return;
  }
  if ((int)ob->query("combat_exp") < 100000) {
    command("say 你的战斗力太低，让我如何收你？你还是去练练功再回来拜我吧。");
    return;
  }
  command("say 好吧，我就收下你了。从此你就跟我练长风一起学习吧。");
  command("recruit " + ob->query("id"));
  return;
}

int ask_me() {
  mapping myfam;
  object me, ob;
  int money;
  int pot;
  int exp;

  me = this_player();
  myfam = (mapping)me->query("family");
  if (!(int)me->query_temp("mask/agree") && (!myfam || me->query("family/family_name") != "圣殿")) {
    command("shake " + (string)me->query("id"));
    command("say " + RANK_D->query_respect(me) + "素无来往，不知此话从何说起呢？");
    return 1;
  }
  if (me->query("combat_exp") < 100000) {
    command("shake " + (string)me->query("id"));
    command("say 你的经验还太低了，还是先去做做其他任务吧。");
    return 1;
  }
  if (me->query("combat_exp") > 500000) {
    command("say 你的经验太高，还是去做其他任务吧。");
    return 1;
  }
  //if(me->query("recruit_number") <=0)
  //         {
  //          command("shake "+(string)me->query("id"));
  //          command("say 能教的弟子你都教完了，没多余的弟子了。");
  //          command("say 要么你再去收一些弟子回来吧。");
  //          return 1;
  //         }
  if (me->query("tianyu_teach") &&
    !me->query_temp("teach_finished")) {
    command("say 我已经给你任务了，还不赶快去做？");
    return 1;
  }
  if (me->query("tianyu_teach_failed")) {
    command("shake");
    command("say 你正在受罚期间，我不能给你任务。");
    return 1;
  }
  if (me->query_temp("teach_doing") &&
    !me->query_temp("teach_finished")) {
    command("? " + (string)me->query("id"));
    command("say 我不是已经让你去教武了吗？你怎么还在这？");
    return 1;
  }
  if (me->query_temp("tianyu_job") && !me->query_temp("teach_finished")) {
    command("shake " + (string)me->query("id"));
    command("say 你身上正领着任务呢，不做完我还不能再给你任务做。");
    return 1;
  }
  if (me->query_temp("teach_finished") &&
    me->query_temp("teach_doing")) {
    command("haha " + (string)me->query("id"));
    command("say 好样的！越多弟子成长，看我圣殿将更加强大。你辛苦了，下去休息吧。");
    //           me->add("recruit_number",-1);
    //           tell_object(me,HIG"还有"+chinese_number(me->query("recruit_number"))+"名弟子了你可以教。\n"NOR);
    me->delete_temp("teach_finished");
    me->delete_temp("teach_doing");
    me->delete_temp("tianyu_job");
    me->delete("tianyu_teach");
    //           me->add("combat_exp",100*me->query_temp("teach_upskills"));
    //           me->add("potential",me->query_temp("teach_upskills")*20);
    exp = 200 + random(200);
    pot = 100 + random(200);
    money = 150 + random(230);
    printf("你被奖励了%d点学习值，%d点战斗力，%d点电子货币！\n", pot, exp, money);
    me->add("combat_exp", exp);
    me->add("money", money);
    me->add("potential", pot);

    me->delete_temp("teach_upskills");
    return 1;
  }
  command("nod " + (string)me->query("id"));
  command("say 你来得正好，我这正好有事急需要人做。");
  command("say 所以，我想让你去教一个弟子习武，成长的越快越好。");
  message_vision("说着，练长风叫来了一个弟子。\n", me);
  command("say 就他吧，你赶快去带他去习武吧。");
  tell_object(me, "圣岛武士决定跟随你行动。\n");
  me->set_temp("teach_job", 1);
  me->set_temp("teach_doing", 1);
  me->set_temp("tianyu_job", 1);
  me->set_temp("teach_upskills", 1);
  me->set("tianyu_teach", 1);
  ob = new("/d/shendian/npc/mentu", 1);
  ob->move(environment(me));
  ob->set("jobby", (string)me->query("id"));
  ob->set_leader(me);
  ob->do_command(me);
  ob->do_jobtime(me);
  return 1;
}

int ask_abandon() {
  object me = this_player();
  if (!me->query("tianyu_teach")) {
    command("say 我又没有给你任务，放弃什么？");
    return 1;
  }
  if (me->query("tianyu_teach_failed")) {
    command("say 你正在受罚期间呢？还放弃什么？");
    return 1;
  }
  if (me->query_temp("teach_finished")) {
    command("say 你不是已经完成任务了吗？还放弃什么呀？");
    return 1;
  }
  command("sigh");
  command("say 教一个新武士也教不好，真没用。");
  command("say 按照本岛的规矩,你将受到一定的惩罚,减去战斗力100,学习值100。");
  command("disapp1 " + (string)me->query("id"));
  me->delete_temp("teach_began");
  me->delete_temp("teach_doing");
  me->delete_temp("tianyu_job");
  me->delete("tianyu_teach");
  me->add("combat_exp", -100);
  me->add("potential", -100);
  //  me->set("tianyu_teach_failed",1); 
  me->apply_condition("tianyu_teach", 50 - random(me->query("kar")));
  return 1;
}
