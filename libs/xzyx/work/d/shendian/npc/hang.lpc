#include <ansi.h>

inherit NPC;

int mojie_quest4();

void create() {
  set_name("含泪", ({ "hang" }));
  set("title", "圣殿独儿");
  set("nickname", "苦命人");
  set("gender", "男性");
  set("age", 22);
  set("long",
    "一个苦命的孩子，自小被圣殿收留，此时他正在偷偷的哭泣，不知为何？\n");
  set("combat_exp", 10000);
  set("attitude", "friendly");
  set("chat_chance", 10);
  set("chat_msg", ({
    "含泪悲愤的说到：总有一天我会报仇的！\n",
  }));
  set("inquiry", ([
    "报仇": (: mojie_quest4 :),
  ]));

  setup();
}

int mojie_quest4() {
  object me = this_player();

  if (me->query("mojie_quest4") != 1) {
    message_vision(CYN "我的父亲死得太惨了，就是阿古哒这个大魔头给害的。\n"
      "你能帮我报仇吗？我一定会报答你的！\n" NOR, me);
    me->set("tmarks4/杀", 1);
    return 1;
  }
  if (me->query("tmarks4/杀") == 1) {
    message_vision(CYN "大侠，你帮我报仇了？\n" NOR, me);
    return 1;
  }
  if (me->query("mojie_quest4") == 1) {
    message_vision(CYN "大侠的恩情，小弟必将铭记在心！\n" NOR, me);
    return 1;
  }
}
