#include <command.h>
#include <ansi.h>
inherit NPC;
inherit F_MASTER;
void create() {
  set_name("周炳贵", ({ "zhou bingung", "zhou" }));
  set("gender", "男性");
  set("age", 35);
  //        set("long",
  //            "一位满面胡须的大汉。\n");
  set("attitude", "friendly");
  set("str", 30);
  set("int", 28);
  set("con", 30);
  set("dex", 30);
  set("per", 30);
  set("chat_chance", 1);
  set("max_qi", 1500);
  set("max_jing", 500);
  set("neili", 1500);
  set("max_neili", 1500);
  set("jiali", 100);
  set("shen_type", 1);

  set("combat_exp", 200000);
  set_skill("force", 60);
  set_skill("sword", 60);
  set_skill("parry", 60);
  set_skill("dodge", 60);
  set_skill("literate", 60);
  set_skill("guang-jian", 60);
  set_skill("wuzhu-xinfa", 60);
  set_skill("shunjian-yidong", 60);
  map_skill("sword", "guang-jian");
  map_skill("force", "wuzhu-xinfa");
  map_skill("dodge", "shunjian-yidong");


  create_family("圣殿", 3, "弟子");
  set("title", "圣殿低阶武士");
  setup();
  carry_object("/clone/misc/cloth")->wear();
  carry_object("/clone/weapon/changjian")->wield();
}
