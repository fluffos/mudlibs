inherit ROOM;

void create() {
  set("short", "助手实验室");
  set("long", @LONG
这里是S博士的助手使用的实验室，虽然气派比起S博士的“超酷研究室”是差了许多，
但在一般平常人眼里，仍是一个非常不错的实验室。因为S博士一般都不在，所以日常
接待客人的人物就由他的助手来代替他完成。门口的LCD(lcd)上写了一些东西。
LONG
  );



  set("exits", ([
    "west": __DIR__ "yanjiushi1", ]));
  set("item_desc", ([ "lcd": "如果玩家需要什么新东西，请post到留言板上，由S博士来制作完成。（注：留言需有详细的说明）\n", ]));
  set("objects", ([ __DIR__ "obj/board1": 1, ]));

  setup();
  replace_program(ROOM);
}
