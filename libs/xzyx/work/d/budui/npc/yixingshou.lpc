inherit NPC;

void create() {
  object me;
  me = this_player();
  set_name("异行兽", ({ "yixing shou", "shou" }));
  set("race", "野兽");
  set("age", 3);
  set("long", "一只可爱的异行兽！\n");
  set("attitude", "peaceful");

  set("limbs", ({ "头部", "身体", "腿部", "手部", "牙齿" }));
  set("verbs", ({ "bite", "claw" }));

  set("combat_exp", (me->query("combat_exp") + random(500)));
  set_temp("apply/attack", 5);
  set_temp("apply/defense", 5);
  set_temp("apply/armor", 5);

  setup();
}

void die() {
  object ob;
  object me;
  me = this_player();
  message_vision("$N喷出一股绿色液体，死了。\n", this_object());
  ob = new(__DIR__ "yixingjisu");
  ob->move(me);
  destruct(this_object());
}
