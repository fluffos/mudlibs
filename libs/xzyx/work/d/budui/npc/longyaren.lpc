inherit NPC;

#include <ansi.h>
int do_quest();
int do_quest1(object me);
int do_quest2();

void create() {
  set_name("老婆婆", ({ "lao popo", "lao", "popo" }));
  set("title", HIM "老百姓" NOR);
  set("shen_type", 0);

  set("gender", "女性");
  set_max_encumbrance(100000000);
  set("age", 70);
  set("long",
    "她看起来有70多岁了，虽然乍一看没什么特别，但是她却给你一种特别神奇感觉，让你觉得她不一般！\n"
  );
  set("no_get_from", 1);

  set_skill("unarmed", 60);
  set_skill("dodge", 60);
  set_temp("apply/attack", 30);
  set_temp("apply/attack", 30);
  set_temp("apply/damage", 15);

  set("combat_exp", 10000);
  set("attitude", "friendly");
  set("inquiry", ([
    "聊天": (: do_quest :),
    "任务": (: do_quest1 :),
    "绣花针": (: do_quest2 :),
  ]));
  setup();
}
int do_quest() {
  object me;
  me = this_player();
  if (me->query_temp("任务")) return notify_fail("什么……，我听不清，再说一遍！\n");
  command("say 唉，你不知道这几年发生了多大的事，整个世界都快翻过来了……");
  me->set_temp("任务", 1);
  return 1;
}
int do_quest1(object me) {
  object i;
  object room;
  i = this_player();
  if (!(i->query_temp("任务"))) return notify_fail("任务……，什么任务？\n");
  if (!(i->query_temp("任务2"))) {
    command("say 对了，你能不能帮我找找绣花针哪，它就在这间房子里。");
    i->set_temp("任务1", 1);
  } else {
    command("say 呵呵，到底还是你们年轻人厉害，告诉你一个大秘密，我曾经有个老伴儿喜欢搞研究，那时他研究了一个什么叫什么什么封印的玩意，它可以给你无穷的力量。至于怎么拿嘛！……");
    i->set_temp("大任务", 1);
    write(HIY "忽然，从天空飞下来几个手拿" HIB "激光剑" HIY "的蒙面人，他们看看那个老婆婆，哼了一声：“死老太婆，居然能让你活到现在，哼！纳命来吧！\n" NOR);
    write(HIR "突然，那几个蒙面人中的一个从怀里拿出一个亮晶晶的东西来，对着老婆婆就是一罩，然后那个老婆婆象一个软泥一般塌了下来，但仍然用期盼的目光看着你……\n" NOR);

    write("那个蒙面人口中呸了一声：“他奶奶的，总算死了，走，我们回去向总部交代去！\n");
    me->die();
    i->set_temp("任务", 0);
    i->set_temp("任务1", 0);
    i->set_temp("任务2", 0);
  }
  return 1;
}
int do_quest2() {
  object me;
  object zhen;
  zhen = new(__DIR__ "obj/xiuhuazhen");
  me = this_player();
  if (!(me->query_temp("任务1"))) return notify_fail("绣花……针，你给我这个干嘛？\n");
  command("say 针呢?\n");
}
int accept_object(object who, object ob) {
  if ((string)ob->query("name") == "绣花针")  //       return notify_fail("这个又是什么……？\n");
  {
    command("say 呵呵，多谢了，对了，我还有件事想请你帮忙，好不好？\n");
    who->set_temp("任务2", 1);
  } else return notify_fail("这个又是什么……？\n");
  return 1;
}
