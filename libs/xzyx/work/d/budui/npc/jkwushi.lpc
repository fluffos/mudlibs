inherit NPC;
#include <ansi.h>

void create() {
  set_name(HIM "杰迪武士" NOR, ({ "wu shi", "wu", "shi" }));
  set("gender", "男性");
  set("age", random(10) + 30);
  set("str", 40);
  set("dex", 40);
  set("int", 40);
  set("long", "他站在那里，的确有说不出的威风。\n");
  set("combat_exp", 1000000);
  set("shen_type", 1);
  set("attitude", "peaceful");
  set_skill("force", 230);
  set_skill("sword", 300);
  set_skill("dodge", 230);
  set_skill("parry", 300);
  set_temp("apply/attack", 500);
  set_temp("apply/defense", 500);
  set_temp("apply/armor", 500);
  set_temp("apply/damage", 300);

  set("neili", 1500);
  set("max_neili", 500);
  set("chat_chance", 1);
  set("chat_msg_combat", ({
    (: random_move :)
  }));
  setup();
  //      carry_object(__DIR__"obj/jiguangjian")->wield();

}

void init() {
  object ob;
  ::init();
  if (interactive(ob = this_player()) &&
    (int)ob->query_condition("killer")) {
    remove_call_out("kill_ob");
    call_out("kill_ob", 1, ob);
    remove_call_out("follow_ob");
    call_out("follow_ob", 1, ob);
  }
}
