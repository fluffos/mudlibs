inherit NPC;
void create() {
  set_name("警察", ({ "tezhong bing", "bing" }));
  set("long",
    "他是一名特种警署的警察\n"
    "他刚刚二十，身材高大，混身冒出一股杀气。\n");
  set("gender", "男性");
  set("age", 21);
  set("attitude", "peaceful");
  set("shen_type", 1);
  set("str", 30);
  set("int", 30);
  set("con", 30);
  set("dex", 30);

  set("max_qi", 400);
  set("max_jing", 200);
  set("neili", 400);
  set("max_neili", 200);
  set("jiali", 20);
  set("combat_exp", 90000);


  set_skill("force", 80);
  set_skill("dodge", 80);
  set_skill("sword", 80);
  set_skill("parry", 80);

  setup();

}
