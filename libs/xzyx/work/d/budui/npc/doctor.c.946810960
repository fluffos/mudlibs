inherit NPC;
inherit F_MASTER;
#include <ansi.h>
int do_quest();
int do_finish();

void create()
{
        set_name(HIG"老博士"NOR, ({"doctor"}));
	set("nickname", HIB"暗黑研究员"NOR);
	set("gender", "男性");
	set("age", 50);
	set("long", 
		"他就是特种部队的黑暗研究员。他以前是特种部队的高级兵之一，现在退役了！\n");
	set("attitude", "peaceful");
	
	set("str", 50);
	set("int", 50);
	set("con", 50);
	set("dex", 50);
        set("qi", 9000);
	set("max_qi", 9000);
	set("jing", 5000);
	set("max_jing", 5000);
	set("neili", 9000);
	set("max_neili", 9000);
	set("jiali", 300);
	
	set("combat_exp", 5000000);
	set("score", -200000);
	 
	set_skill("force", 200);            
	set_skill("duanqing-xinfa", 200);    
	set_skill("blade", 200);          
	set_skill("lengxue-dao", 200);   
	set_skill("dodge", 200);      	    
	set_skill("jiqi-qudong", 200);     
	set_skill("parry", 200);             
	set_skill("unarmed", 200);           
	set_skill("yinyang-zhang", 200);        
	set_skill("rennai",200);
	set_skill("jianti-shu",200);
	map_skill("force", "duanqing-xinfa");
        map_skill("rennai","jianti-shu");
	map_skill("unarmed", "yinyang-zhang");
	map_skill("dodge", "jiqi-qudong");
	map_skill("parry", "lengxue-dao");
	map_skill("blade", "lengxue-dao");
        set("inquiry",([
                  "任务" : (: do_quest :),
	          "完成" : (: do_finish :),
	         ]));

	setup();
}
int do_quest()
{
      object me;
      me = this_player();
      if (me->query_temp("任务"))
      return notify_fail("你已经接了任务了！\n");
      if (me->query("family")["family_name"]!="特种部队")
      return notify_fail("你不是特种部队的，不能接这个任务！\n");
      if (me->query("combat_exp") > 500000)
      return notify_fail("你不需要完成这个任务来加经验值了！\n");
      command("say 
      我正在研究一种可以让合成人变异的药，需要一种异行生物的激素，你帮我去找找吧！\n");
      me->set_temp("任务",1);
      return 1;
}
int do_finish()
{
      object me;
      me = this_player();
      if (!(me->query_temp("任务"))) 
      return notify_fail("你还没有接任务呢！\n");
}
int accept_object(object who, object ob)
{
       int pot;
       int exp;
       int money;
      object me;
    me = this_player();
       if ((string)ob->query("name") == "异行激素") 
{
       command("say 谢谢了！\n");
       pot = random(100);
       exp = random(200);
       money = random(200); 
       write("你被奖励了，",pot,"点学习值，",exp,"点战斗力，",money,"点电子货币！\n");
       me->add("exp",exp);
       me->add("money",money);
       me->add("potential",pot);
       me->delete_temp("任务");
       return 1;
}
     
