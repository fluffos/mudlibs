inherit NPC;
#include <ansi.h>

void create() {
  set_name(HIW "舞女" NOR, ({ "wu nv", "nv" }));
  set("title", HIM "不包三陪" NOR);
  set("shen_type", 0);

  set("gender", "女性");
  set_max_encumbrance(100000000);
  set("age", 18);
  set("long",
    "她长得婀娜多姿，神采飞扬，犹如天仙下凡。\n"
    "她努力扭动着苗条的身材，在舞台上卖弄着风骚。\n");
  set("no_get_from", 1);

  set_skill("unarmed", 100);
  set_skill("dodge", 100);
  set_temp("apply/attack", 30);
  set_temp("apply/attack", 30);
  set_temp("apply/damage", 15);

  set("combat_exp", 50);
  set("attitude", "friendly");
  set("chat_msg", ({ "舞女妖媚的在你耳边说道：“大哥，来嘛，我们来一起跳个舞，好吗？”\n", }));



  setup();
}
