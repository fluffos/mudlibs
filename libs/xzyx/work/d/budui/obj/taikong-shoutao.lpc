#include <armor.h>
#include <ansi.h> 
inherit SHIELD;
 
void create()
{
	set_name(HIY"太空手套"NOR, ({ "taikong shoutao", "shoutao"}) );
	set_weight(7000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("material", "leather");
		set("unit", "面");
              set("value",100);
		set("armor_prop/armor", 10);
		set("armor_prop/defense", 3);
	}
	setup();
}
