inherit ITEM;
void setup() {}

void init() {
  add_action("do_drink", "drink");
}

void create() {
  set_name("太阳能量", ({ "sun power", "sun" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "瓶");
    set("long", "这是一瓶太阳能量。\n");
    set("value", 300);
  }
  setup();
}

int do_drink(string arg) {
  if (!id(arg))
    return notify_fail("你想喝什么药？\n");
  if ((int)this_player()->query("neili") ==
    (int)this_player()->query("max_neili"))
    return notify_fail("你现在不需要用太阳能量。\n");
  else {
    this_player()->add("neili", 1000);
    message_vision("$N喝下一瓶太阳能量，心中顿时感到无限光明。\n", this_player());
    destruct(this_object());
    return 1;
  }
}
