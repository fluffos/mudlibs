inherit ROOM;

void create() {
  set("short", "特种药铺");
  set("long", @LONG
这是一家小小的药铺，大箱小箱堆满了一地，都是一些普通的药具。这儿
的主人懒洋洋地躺在一只躺椅上，招呼着过往行人。摊上立着一块招牌(zhaopai)。
LONG
  );

  set("item_desc", ([
    "zhaopai": "请用 \"list\" 列出货物表，\"buy\" 向老板购物。\n",
  ]));
