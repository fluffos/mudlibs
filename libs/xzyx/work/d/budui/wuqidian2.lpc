inherit ROOM;

void create() {
  set("short", "特种银行");
  set("long", @LONG
这里就是特种银行了，虽然特种联盟势力非常广大，但是银行却只有这一家，不知道是
怎么回事。你走进这儿，就可以看见一个非常舒适的沙发，一个胖胖的机器人坐在沙发
上，对着你微笑，让你一看就感到无比的舒畅。门口有一块牌子(paizi)。
LONG
  );

  set("objects", ([
    "/d/budui/npc/robot-bank": 1,
  ]));
  set("item_desc", ([
    "paizi": "转帐 : zhuanzhang <某人> <电子货币数量>\n"
  ]));
  set("exits", ([
    "south": __DIR__ "wuqidian1",
    "east": __DIR__ "shougou",
  ]));
  setup();
  replace_program(ROOM);
}
