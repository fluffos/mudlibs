#include <ansi.h>
inherit NPC;
void greeting(object ob);
void create() {
  set_name("电动娃娃", ({ "diandong wawa", "dindong", "wawa" }));
  set("long", "它是个可爱的电动娃娃，还会说话哦。\n");
  set("gender", "男性");
  set("age", 10);
  set("attitude", "friendly");
  set("shen_type", -1);

  set("per", 15);
  set("str", 15);
  set("int", 14);
  set("con", 15);
  set("dex", 16);
  set("qi", 100);
  set("max_qi", 100);
  set("jing", 100);
  set("value", 20);
  set("max_jing", 100);
  set("neili", 10);
  set("max_neili", 10);
  set("combat_exp", 200);

  set_skill("unarmed", 10);
  set_skill("dodge", 10);
  set_skill("parry", 10);

  set("chat_chance", 1);
  set("chat_msg", ({
    "电动娃娃说道: 我唱歌给你听好吗？\n",
    "电动娃娃模仿着女声唱道: 好冷。。。雪已经积的那么深。。。 \n",
    "电动娃娃唱道: 眼看春天就要来了，而我也将。。也将不再生存。。\n",
    "电动娃娃唱道: 我最深爱的情人，却伤害我最深，为什么你背着我爱别人？\n",
    "电动娃娃说道:不过去我唱的不好，见笑了。 \n",
  }));

  setup();
  carry_object("/clone/misc/cloth")->wear();
}
