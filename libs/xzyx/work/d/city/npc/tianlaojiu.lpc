#include <ansi.h>
inherit NPC;
void greeting(object ob);
void create() {
  set_name("田老九", ({ "lao ban", "tian", "boss" }));
  set("long", "他就是这家公司的老板了，看起来财大气粗的样子哦。\n");
  set("title", HIW "电信公司老板" NOR);
  set("gender", "男性");
  set("age", 39);
  set("attitude", "friendly");
  set("shen_type", -1);

  set("per", 15);
  set("str", 15);
  set("int", 14);
  set("con", 15);
  set("dex", 16);
  set("qi", 200);
  set("max_qi", 200);
  set("jing", 200);
  set("max_jing", 100);
  set("neili", 300);
  set("max_neili", 300);
  set("combat_exp", 20000);

  set_skill("unarmed", 90);
  set_skill("dodge", 90);
  set_skill("parry", 90);
  set("startroom", "/d/city/beidajie1");

  set("chat_chance", 10);
  set("chat_msg", ({
    "田老九说道：要什么自己看，我要玩MUD就不招呼你了！\n",
    "田老九哈哈大笑了几声，高声说道：看看，又被我PK了一个！\n",
    "田老九嗨嗨的奸笑道: 今天杀了十八个，好爽！ \n",
  }));

  setup();
  carry_object("/clone/misc/cloth")->wear();
}
