#include <ansi.h>
inherit NPC;
void greeting(object ob);
void create() {
  set_name("星际浪子", ({ "lang zi", "lang", "zi" }));
  set("long", "他是一个在星际间流浪的浪子。\n");
  set("title", HIB "游手好闲" NOR);
  set("gender", "男性");
  set("age", 19);
  set("attitude", "friendly");
  set("shen_type", -1);

  set("per", 15);
  set("str", 15);
  set("int", 14);
  set("con", 15);
  set("dex", 16);
  set("qi", 200);
  set("max_qi", 200);
  set("jing", 200);
  set("max_jing", 100);
  set("neili", 300);
  set("max_neili", 300);
  set("combat_exp", 2000);

  set_skill("unarmed", 70);
  set_skill("dodge", 70);
  set_skill("parry", 70);
  set("startroom", "/d/city/beidajie1");

  set("chat_chance", 1);
  set("chat_msg", ({
    "星际浪子说道: 现在天下四分，大家都惶惶不安，唯有我无所畏惧！\n",
    "星际浪子哈哈大笑了几声，高声说道：人嘛，就是要逍遥，快活，才没白活啊！\n",
    "星际浪子说道: 后天下之忧而忧，后面是什么来着。。。！星际浪子狼狈的抓了抓后脑勺。\n",
    (: random_move :)
  }));

  setup();
  carry_object("/clone/misc/cloth")->wear();
}
