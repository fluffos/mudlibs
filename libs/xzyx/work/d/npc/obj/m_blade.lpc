// m_blade.c

#include <ansi.h>
#include <weapon.h>
inherit M_WEAPON;


int do_duanlian(object weapon);
int do_hui(object weapon);
int do_decide();
int do_check();


void init() {
  add_action("do_duanlian", "shengji");
  add_action("do_hui", "cuihui");
  add_action("do_check", "kan");
  add_action("do_decide", "gogogo");

}

void create() {
  object me;
  string w_name, w_id, w_or, name;
  int w_lv, color;
  me = this_player();
  //读入数据
  w_name = me->query("weapon/name");
  w_id = me->query("weapon/id");
  w_or = me->query("weapon/or");
  w_lv = me->query("weapon/lv");
  color = w_lv / 10;
  color = w_lv - color * 10;
  switch (color) {
    case 1:
    case 2:
      name = HIR + w_name + NOR;
      break;
    case 3:
    case 4:
      name = HIG + w_name + NOR;
      break;
    case 5:
      name = HIY + w_name + NOR;
      break;

    case 6:
      name = HIC + w_name + NOR;
      break;
    case 7:
      name = HIB + w_name + NOR;
      break;

    case 8:
      name = HIM + w_name + NOR;
      break;
    case 9:
      name = HIW + w_name + NOR;
      break;
    case 0:
      name = BLINK HIW + w_name + NOR;
      break;
  }

  set_name(name, ({ w_id, "myblade" }));
  set("unit", "柄");
  set("no_get", 1);
  set("no_drop", 1);
  set("long", "一把破刀\n");
  set_weight(500);
  set("wield_msg", HIM "$N偷偷摸摸的将怀中的" + name + "拿了出来，握在手中！\n");
  set("unwield_msg", HIW "$N飞快的将手中的" + name + "藏进自己的怀里。\n" NOR);
  init_blade(w_lv * 10 + 10);
  setup();
}



int do_duanlian(object weapon) {
  object me;
  int w_zhi, w_level;

  me = this_player();
  if (environment(me)->query("no_fight"))
    return notify_fail("这里禁止给刀升级。\n");

  if (me->is_busy()) return notify_fail("你正忙着！\n");
  if ((int)me->query("money") < 100)
    return notify_fail("没钱也想给刀升级，做梦吧！\n");
  if (!weapon)
    return notify_fail("你要干什么?\n");

  if ((int)me->query("max_neili") < 10)
    return notify_fail("你的气息不够，无法给刀升级！\n");

  if ((int)me->query("potential") < 100)
    return notify_fail("你的学习值不够，无法给刀升级！\n");

  message_vision(HIG "$N提起气息，只觉已经与手中破刀溶为一体。\n" NOR, me);
  me->add("max_neili", -10);
  me->set("neili", (int)me->query("max_neili"));
  me->add("potential", -10);
  me->add("money", -100);
  me->start_busy(10);
  w_zhi = (int)me->query("weapon/value");
  w_zhi = w_zhi + 10;
  me->set("weapon/value", w_zhi);
  w_level = (int)me->query("weapon/lv");
  if (w_zhi >= ((w_level + 1) * (w_level + 1))) {
    if (w_level >= me->query("age") - 9) {
      message_vision(HIR "只见刀身一晃，似乎没有成功。\n" NOR, me);
      return 1;
    } else {
      w_level++;
      me->set("weapon/lv", w_level);
      message_vision(HIM "只见$N手中的刀身发出一道强光，似乎能量又充足了点！\n" NOR, me);
      message_vision(HIW "$N的破刀的等级提升了！\n" NOR, me);
      weapon = this_object();
      if (weapon->query("equipped"))
        weapon->unequip();
      reload_object(weapon);
      me->set("weapon/value", 0);
      return 1;
    }
  }
  message_vision(HIY "$N正在努力的提升手中的破刀!\n" NOR, me);
  return 1;
}


int do_hui(string weapon) {
  string w_name;
  object me, ob;
  if (!weapon)
    return notify_fail("你要摧毁什么?\n");
  me = this_player();
  w_name = me->query("weapon/name");
  ob = present(weapon, me);
  if (objectp(ob) && w_name != ob->query("name")) {
    write("你一定要摧毁你这把可爱的破刀吗？决定了请键入gogogo。\n");
    me->set_temp("hui", 1000);
  }
  return 1;
}


int do_decide() {
  string w_name;
  object me, ob;
  me = this_player();
  if (me->query_temp("hui") != 1000)
    return notify_fail("你决定要干什么？\n");
  w_name = me->query("weapon/name");
  message_vision(HIR "你望着手中的" + w_name + "，挥着眼泪把它丢进了厕所!\n" NOR, me);
  me->set("weapon/make", 0);
  destruct(this_object());
  me->delete("weapon");
  me->save();
  return 1;
}


int do_check() {
  object me;
  string w_name, w_time, line;
  int w_lv, w_zhi;
  me = this_player();
  w_name = me->query("weapon/name");
  w_lv = me->query("weapon/lv");
  w_zhi = me->query("weapon/value");
  w_time = me->query("weapon/time");
  line = sprintf("破刀名称：%s\t\t\n制造时间： %s\n目前等级： %d/%d\n",
    w_name, w_time, w_lv, w_zhi);
  write(line);
  return 1;
}

int query_autoload() {
  object me = this_player();
  if (me->query("family/family_name") != "特种部队")
    return 0;
  return 1;
}
