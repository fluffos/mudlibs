inherit NPC;
string ask_me();
void create() {
  set_name("伤兵", ({ "shang bing", "bing" }));
  set("long",
    "一个满身是伤的士兵。\n");
  set("gender", "男性");
  set("age", 21);
  set("attitude", "peaceful");
  set("shen_type", 1);
  set("str", 10);
  set("int", 15);
  set("con", 10);
  set("dex", 10);

  set("max_qi", 100);
  set("max_jing", 100);
  set("neili", 100);
  set("max_neili", 100);
  set("jiali", 10);
  set("combat_exp", 10000);
  set("score", -100);

  set_skill("force", 80);
  set_skill("dodge", 70);
  set_skill("gun", 40);
  set_skill("parry", 50);
  set("inquiry", ([
    "局势": (: ask_me :),
  ]));

  setup();
}

string ask_me() {
  object obj, me, ob;
  me = this_player();
  ob = this_object();
  if (me->query_temp("dobudui") != 1) return "你是奸细，抓奸细呀！\n";
  if (me->query_temp("guancha") != 1) return "你还是先去观察一下战场吧！\n";
  if (me->query_temp("havemap") == 1) return "你有了地图还要？\n";
  command("say 这就是地道内部的地图，快去增援大队长！\n");
  write("说完后伤兵给你一张地图，就死了！\n");
  me->set_temp("havemap", 1);
  obj = new("/d/miti/budui/obj/map");
  obj->move(me);
  ob->die();
  return "Quickly！\n";
}
