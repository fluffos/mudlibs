dbase (["no_insert":1,"no_get":1,"no_drop":1,"name":"小精灵的信箱","id":"mailbox","owner_id":"xiaojl","unit":"个","long":"这是一个用来寄信、收信的信箱，你可以用以下指令来处理你的邮件：mail <某人>               寄信给别人。forward <信件编号> <某人> 将某封信转寄给别人。from                      查看信箱中的信件。read <信件编号>           阅读一封信件。discard <信件编号>        丢弃一封信件。",])
