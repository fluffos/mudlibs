inherit ITEM;

void create() {
  set_name("断肠草", ({ "duanchang cao", "cao" }));
  set_weight(10);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "棵");
    set("long", "这是一棵毒草。\n");
    set("value", 3);
    set("quest_poison", 1);
    set("poison_id", "duanchang cao");

  }


  setup();
}
