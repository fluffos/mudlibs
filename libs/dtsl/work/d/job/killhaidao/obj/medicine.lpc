
inherit ITEM;

void create()
{
        set_name("丹药", ({ "dan yao","yao" }) );
        set_weight(10);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "棵");
		set("long","这是一棵草。\n");               
        }

        setup();
}
