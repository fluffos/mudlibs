#include <ansi.h>
inherit ROOM;

void create()
{
	set("short", "飞天岭");
        set("long", @LONG
这里是屏风山的飞天岭了。南边是一座山峰。东边有一座悬崖。这
里地势很高，可以看到整个屏风山的景色。当天空晴朗之时，几乎可以
用手来触摸天空。据说此岭是仙人施展法术搬来，所以命名为飞天岭。
这里有一块大石头，似乎可以砸一下。
LONG
);
        set("exits",([
	"southwest" : __DIR__"dmjob_2_15",
	"eastdown" : __DIR__"dmjob_2_19",
	"east" : __DIR__"dmjob_0_19",
        ]));
set("outdoors","dmjob");
        setup();
//        replace_program(ROOM);
}

void init()
{
   add_action("do_ci","za");
}

int do_ci(string arg)
{
   object me,weapon;
   me=this_player();
   if(!arg||arg!="石头")
   return notify_fail("你要咂什么？\n");
   if(!objectp(weapon=me->query_temp("weapon")))
   return notify_fail("没有武器，你要用手砸吗？\n");
   if(weapon->query("skill_type")!="hammer")
   return notify_fail("你挥动"+weapon->name()+"晃了几下，发现毫无用处！\n");
   if(weapon->query("flag")==1)
   return notify_fail("你沮丧的发现手中的兵刃已经断掉了！\n");
   if(me->query("sen")<20)
   return notify_fail("你精神太差了！\n");
   if(me->query_skill("hammer",1)>=101)
   return notify_fail("你的基本锤法很高了，在这里已经无法提高了！\n");
   if(me->is_busy())
   return notify_fail("你正忙着呢！\n");
   
   message_vision(YEL"$N大喊一声，挥舞着手中的"+weapon->name()+"朝石头砸去！\n"NOR,me);
   me->improve_skill("hammer",me->query_int()/2+20+random(5));
   me->add("sen",-20);
   if(me->query_skill("hammer",1)<50)
   message_vision("$N被震的后退了几步。\n",me);
   else if(me->query_skill("hammer",1)<100)
   message_vision("只听碰的一声，石头被$N砸出一个大坑。\n",me);
   else if(me->query_skill("hammer",1)<150)
   message_vision("只听碰的一声，石头被$N砸得裂出道长纹！\n",me);
  
   return 1;
}
