// dart.c

#include <weapon.h>
#include <ansi.h>
inherit THROWING;

void create() {
  set_name(HIY "锁魂镖" NOR, ({ "fei biao", "biao", "dart" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "这是阴癸派的至宝暗器。\n");
    set("unit", "些");
    set("base_unit", "枚");
    set("base_weight", 40);
    set("throwing", 1);
    set("value", 5);
    set("no_save", 1);
  }
  set_amount(1);
  init_throwing(10, 10, 10);
  setup();
}

int is_get_of(object ob, object obj) {
  return 1;
}
