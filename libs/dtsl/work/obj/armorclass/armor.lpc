
#include <armor.h>

inherit ARMOR;

#include "armorsave.h"

void create()
{
   set_name("盔甲类型", ({ "armor"}) );
   set_weight(5000);
   if( clonep() )
     set_default_object(__FILE__);
   else {
     set("material", "铁");
     set("unit", "件");
     set("armor_prop/armor", 2);
   }
   setup();
}
