#include <login.h>
#include <ansi.h>
inherit F_CLEAN_UP;
mapping wiz_status;
string get_name(string str);
void create()
{
        seteuid(getuid());
}


int main(object me, string arg)
{
        string *wizlist,*imm,*app,*wizard,*arch,*admin,*other,wiz_id,wiz_cname,wiz_level,pstate,msg;
        int i,time;
        object player;

                imm=     allocate(20);
                app=     allocate(20);
                arch=    allocate(20);
                wizard=  allocate(20);
                admin=   allocate(20);
                other=   allocate(20);
                imm=({});
                app=({});
                wizard=({});
                arch=({});
                admin=({});
                other=({});
                wiz_cname="";
                msg=  HIG"◎"+MUD_NAME +"◎当前的巫师有：\n"NOR
                      "———————————————————————————————————\n"
                      "ＩＤ           姓名           等级           状态           发呆时间      \n"
                          "———————————————————————————————————\n";
        write(msg);
        msg="";
//        list = sort_array(SECURITY_D->query_wizlist(),1);
        wizlist = explode(read_file(WIZLIST), "\n");
        for(i=0;i<sizeof(wizlist);i++)//对wizlist排序,从immortal到admin
        {
                sscanf(wizlist[i], "%s %s", wiz_id, wiz_level);
                switch(wiz_level)
            {
                        case "(immortal)":
                               imm+=({wizlist[i]});
                               break;
                        case "(apprentice)":
                               app+=({wizlist[i]});
                               break;
                        case "(wizard)":
                               wizard+=({wizlist[i]});
                               break;
                        case "(arch)":
                               arch+=({wizlist[i]});
                               break;
                        case "(admin)":
                               admin+=({wizlist[i]});
                               break;
                        default: other+=({wizlist[i]});
                                break;
            }
                
        }
                wizlist=imm+app+wizard+arch+admin+other;
        for(i=0; i<sizeof(wizlist); i++)  
        {
                time=-1;//发呆时间
                pstate="离线";
                //leave_time=0;//离线时间
                sscanf(wizlist[i], "%s %s", wiz_id, wiz_level);
                player=find_player(wiz_id);
                if(objectp(player)&&interactive(player))
                {
                        wiz_cname=get_name(player->name());
                        pstate="在线";
                        time=query_idle(player);//发呆时间

                        if(player->query("env/invisibility"))
                        {
                                if(wizhood(me)=="player"||!me->visible(player))
                                {
                                        pstate="离线";
                                        time=-1;//如果巫师隐身之后,当作离线
                                        //leave_time=player->query_temp("link_ob")->query("last_on")-time();
                                }
                        }
                }
                else
                {
                        player=new("/obj/usertest");
                        player->set("id",wiz_id);
                        //write(player->query("id")+"\n");
                        //有可能出现player无法restore的情况
                        if(!player->restore()) wiz_cname="蓉蓉";
                        else
                        {
                                wiz_cname=get_name(player->name());
                                //leave_time=player->query_temp("link_ob")->query("last_on")-time();
                                destruct(player);
                        }
                }
                switch(wiz_level)
                {
                        case "(immortal)":
                               wiz_level="天使";
                               break;
                        case "(apprentice)":
                               wiz_level="精灵";
                               break;
                        case "(wizard)":
                               wiz_level="巫师";
                               break;
                        case "(arch)":
                               wiz_level="大神";
                               break;
                        case "(admin)":
                               wiz_level="天神";
                               break;
                        default :
                                wiz_level="其他";
                                break;
                }
                        if(time>=0)
                        msg+=sprintf(HIC"%-15s%-15s%-15s%-15s%-15s\n"NOR,wiz_id,wiz_cname,wiz_level,pstate,time/60+"分钟");
                        else
                        //msg+=sprintf("%-15s%-15s%-15s%-15s%-15s\n",wiz_id,wiz_cname,wiz_level,pstate,leave_time>0?leave_time/3600+"小时":"未知");
                        msg+=sprintf("%-15s%-15s%-15s%-15s\n",wiz_id,wiz_cname,wiz_level,pstate);
                        //msg=msg+wiz_id+wiz_cname+wiz_level+pstate+time+"\n";

        }
        write(msg);
        write("——————————————共记"+i+"名巫师———————————————\n");
                //write(sizeof(children("/obj/login"))+"\n");
        //write(sizeof(children("/obj/usertest"))+"\n");
        imm=({});
        app=({});
        wizard=({});
        arch=({});
        admin=({});
	other=({});
        return 1;
}
/*------------
ＩＤ       姓名        等级        状态               时间
———————————————————————————————————
 ID        中文名字    巫师等级    (连线) or (离线)：x小时x分x秒(最好是中文数字)
———————————————————————————————————
*/
int help(object me)
{
write(@HELP
指令格式 : wizlist

用途 : 列出目前所有的巫师名单。
HELP
     );
     return 1;
}

//去掉某些巫师名字的颜色符号
string get_name(string str)
{
    string str1, str2;
    while(sscanf(str,"%s*sm%s",str1,str2)==3)
        str=str1+str2;
    return str;
}

