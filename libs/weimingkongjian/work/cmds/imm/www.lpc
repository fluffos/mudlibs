/******************************************
 * wizlist.c                              *
 *                                        *
 * 这个命令使用于最基本的 es2 结构的 MUD, *
 * 根据自己的情况可能用作相应的修改，如   *
 * c_wizlevel。                           *
 *                                        *
 * 在 LOGIN_D 里的 enter_world 函数里     *
 * 要加一行 ob->set("last_on", time());   *
 * 这里的 ob 是 LOGIN_OB.然后更新 LOGIN_D.*
 ******************************************/
// by .

#include <ansi.h>
inherit F_CLEAN_UP;

mapping c_wizlevel = ([
"(boss)" : "幕后黑手",
"(admin)" : "天庭波士",
"(arch)" : "天界总管",
"(angel)" : "八部天神",
"(wizard)" : "天庭星宿",
"(apprentice)" : "天门守神",
"(genie)" : "天庭侍卫",
"(immortal)" : "金童玉女",
]);

int main(object me, string arg)
{
        string *list,msg,cwiz;
        int time,i,n,online;
        object login;

        seteuid(ROOT_UID);

        msg = sprintf("%-11s%-12s%-12s%-6s%s\n","ＩＤ","姓名","等级","状态","时间");
        msg += "———————————————————————————————————\n";
        list = sort_array(SECURITY_D->query_wizlist(), 1);

        n = sizeof(list);
        if(!n)
                return notify_fail(sprintf("%s目前没有巫师。\n",MUD_NAME));

        for(i=0;i<n;i++)
        {
                int day,hour,min;

                login = new(LOGIN_OB);
                login->set("id", list[i]);
                if(!login->restore())
                        continue;
                cwiz = c_wizlevel[wizhood(list[i])];
                if(!cwiz)
                        cwiz = "巫师";
                if(objectp(find_player(list[i])))
                        online = 1;
                else
                        online = 0;
                if(online)
                        time = time() - (int)login->query("last_on");
                else
                        time = time() - (stat(sprintf("%slogin%s%s%s",
                                DATA_DIR,"/"+list[i][0..0]+"/",list[i],__SAVE_EXTENSION__),-1)[1]);

                time /= 60;
                min = time%60;
                time /= 60;
                hour = time%24;
                time /= 24;
                day = time;

                msg += sprintf( "%-11s%-12s%-12s%-6s%s\n",
                        list[i],login->query("name"),cwiz,online?HIG+"连线："+NOR:"离线：",
                        sprintf("%s%s%s",day?sprintf("%s天",chinese_number(day)):"",
                        hour?sprintf("%s小时",chinese_number(hour)):"",
                        min?sprintf("%s分钟",chinese_number(min)):"小于一分钟") );
                destruct(login);
        }

        msg += "———————————————————————————————————\n";
        msg += sprintf("%s目前有%s位巫师。\n",MUD_NAME,chinese_number(n));
        msg += HIR"本站拒绝巫师申请\n";
        write(msg);
        return 1;
}

int help(object me)
{
write(@HELP
指令格式 : wizlist

用途 : 列出目前所有的巫师名单。
HELP
     );
     return 1;
}



