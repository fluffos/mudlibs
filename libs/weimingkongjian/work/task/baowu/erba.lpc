inherit ITEM;
#include <ansi.h>
#include "task.h"
void create()
{
        set_name(HIC "耳朵拔子", ({"er ba", "ba zi"}));
        set_weight(80);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long", "耳朵拔子.\n");
                set("unit", "件");
                set("task_object",1);
               set("owner_name",HIB "宁中则");
               set("owner_id","ning zhongze");
        }
}
