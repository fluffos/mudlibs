// topkan@xhc
inherit ITEM;
#include "task.h"
#include <ansi.h>
void create()
{
        set_name(HIM "地契", ({"di qi", "qi"}));
        set_weight(80);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long", "帐簿.\n");
                set("unit", "件");
                set("task_object",1);
                set("owner_name",HIR "钱眼开");
            set("owner_id","qian yankai");
        }
}
