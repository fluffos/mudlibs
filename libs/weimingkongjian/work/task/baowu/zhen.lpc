inherit ITEM;
#include "task.h"
#include <ansi.h>
void create()
{
        set_name(HIR "绣花针", ({"xiuhua zhen", "zhen"}));
        set_weight(80);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long", "平时用来补衣服用的针。\n");
                set("unit", "根");
               set("owner_name",HIG "林平之");
               set("owner_id","ling pingzi");
      set("task_object", 1);
        }
}
