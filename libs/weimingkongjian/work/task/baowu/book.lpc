#include "task.h"
#include <ansi.h>
inherit ITEM;

void create()
{
        set_name(HIM "老古董", ({"lao gudong", "gudong"}));
        set_weight(80);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long", "贺知章的老古董\n");
                set("unit", "件");
set("task_object",1);
               set("owner_name",HIC "李莫愁");
               set("owner_id","li mochou");
        }
}
