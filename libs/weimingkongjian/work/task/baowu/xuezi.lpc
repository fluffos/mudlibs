inherit ITEM;
#include "task.h"
#include <ansi.h>
void create()
{
        set_name(HIC "破靴子", ({"po xuezi", "boot"}));
        set_weight(80);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long", "天天穿的鞋子。\n");
                set("unit", "双");
               set("owner_name",HIR "道果禅师");
               set("owner_id","daoguo");
	set("task_object",1);
        }
}
