#include <ansi.h>

inherit NPC;
inherit F_MASTER;

void greeting(object);
void init();
void create()
{
        set_name("逍遥哥", ({ "npc doga", "xiaoyao", "ge"}));
        set("long",
            "他神情落魄，衣襟边幅不修，满头乌黑长发随风飘荡。\n"+
            "从他身上你丝毫看不出他深藏不漏的绝世武学，\n"+
            "但从他开阖的双眼间，精光爆射，顿时让人尊肃三分。\n");
        set("gender", "男性");
        set("age", 35);
        set("shen_type",1);
        set("attitude", "peaceful");
        set("nickname", HIW "人生难得几逍遥" NOR);

        set("str", 50);
        set("int", 50);
        set("con", 50);
        set("dex", 500);
        set("per", 50);

        set("qi", 280000);
        set("max_qi", 280000);
        set("jing", 180000);
        set("max_jing", 180000);
        set("neili", 20000);
        set("max_neili", 20000);
        set("jiali", 1000);

        set("combat_exp", 500000000);
        set("score", 0);
        set_skill("force", 1500);
        set_skill("dodge", 1500);
        set_skill("parry", 1500);
        set_skill("unarmed",1500);
        set_skill("blade",1500);

        set_skill("pixie-jian",1500);
        set_skill("liumai-shenjian",1500);
        set_skill("tiandao-blade",1500);
        set_skill("jiuyang-shengong",1500);

        map_skill("unarmed", "liumai-shenjian");
        map_skill("force", "jiuyang-shengong");
        map_skill("dodge", "pixie-jian");
        map_skill("parry", "tiandao-blade");
        map_skill("blade", "tiandao-blade");

        create_family("铁血盟",1,"盟主");
        setup();
        carry_object("/d/txm/obj/jinpao")->wear();
        carry_object("/d/txm/obj/tiandao")->wield();
        add_money("silver",100);
}

void init()
{
        object ob;
 
        ::init();
 
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
        }
}
void greeting(object ob)
{
       if ((string)ob->query("family/family_name") == "铁血盟") 
             {
               message_vision("逍遥哥对$N满意的点了点头。\n",ob);
               return;
              }
        if (!(string)ob->query("family/family_name"))
             {
               message_vision("逍遥哥冲着$N微笑说：你可是想来加入我铁血盟的吗？\n",ob);
               return;
              }
}


