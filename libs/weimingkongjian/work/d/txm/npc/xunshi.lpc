inherit ITEM;

void create() {
  set_name(HIY "巡查使" NOR, ({ "xun cha", "xuncha", "xun" }));
  set_weight(50);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "这是一颗有着特殊功能的不老仙丹，你可以(eat)了它。\n");
    set("unit", "条");

  }
}
void init() {
  add_action("do_eat", "eat");
}
int do_eat() {
  object me;
  me = this_player();
  if ((int)me->query("age") < 16)
    return notify_fail("你还不到100岁呢,目前还不能吃不老仙丹!\n");
  {
    message_vision(HIR "$N拿起一颗不老仙丹吞了下去，身上骤然发出一阵玄异的光芒。\n" NOR, me);
    me->add("combat_exp", 50000);
    me->add("max_jingli", 70000);
    me->add("max_neili", 30000);
    me->set_skill("dodge", (me->query_skill("dodge", 1) + 21));
    tell_object(me, "恭喜你成为不老仙!!!\n");

  }

  return 1;
}
