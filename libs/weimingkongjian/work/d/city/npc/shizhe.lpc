#include <ansi.h>
inherit NPC;
string ask_me();
string ask_toutai();

void create() {
  set_name(HIR "空间使者" NOR, ({ "wmkj shizhe", "shizhe" }));
  set("nickname", HIY "不知情愁枉少年" NOR);
  set("gender", "男性");
  set("age", 18);
  set("long", YEL "这位是〖未明空间〗的使者，向他打听“未明空间”，他会带给您想不到的惊喜。\n" NOR);
  set("shen_type", 1);
  set("combat_exp", 999999999);
  set("str", 300);
  set("dex", 300);
  set("con", 300);
  set("int", 30);
  set("per", 30);
  set("attitude", "friendly");
  set("max_qi", 100000);
  set("neili", 100000);
  set("jingli", 21000000);
  set("score", 100000);

  set("inquiry", ([
    "江湖风云": (: ask_me :),
    "未明空间": (: ask_me :),
    "投胎": (: ask_toutai :),
  ]));
  setup();
}

void init() {
  object ob;
  ob = this_player();
  ::init();
  if (interactive(ob) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
}

void greeting(object ob) {
  if (!ob || environment(ob) != environment()) return;
  command("whisper " + ob->query("id") + " " HIW "欢迎光临〖未明空间〗" + HIR + "(ask shizhe about 未明空间)\n" + NOR + HIW + "， 小的助您行走江湖．" NOR);
  command("es " + HIC "欢迎光临〖未明空间〗,IP: 61.188.204.17 Port: 2001/6666/7777/8888,奖励300基本skill,20万exp和qn,官方站，有保障,全新的感觉和特色,欢迎加入 \n" NOR);
}

string ask_me() {
  object me = this_player();
  mapping fam;

  if ((int)me->query("welcomexhc"))
    return "呵呵～这就是您的不是了！小的已经对您施过法力了！";
  else {
    me->set("welcomexhc", 1);
    me->add("max_neili", 1000);
    me->add("neili", 1000);
    me->add("jingli", 500);
    me->add("max_jingli", 500);
    me->add("potential", 200000);
    me->add("food", 5000);
    me->add("water", 10000);
    me->add("combat_exp", 200000);
    me->set_skill("literate", 200);
    me->set_skill("force", 300);
    CHANNEL_D->do_channel(
      me,
      "es",
      sprintf(
        "在下%s今日光临〖未明空间〗（ 61.137.101.202 :2001/6666/7777/8888）\n         现已得到未明空间使者的帮助和奖励！即日起开始行走江湖了！",
        me->name(1)
      )
    );
    return "欢迎光临" NOR + HIR "〖未明空间〗" NOR "，小的护架来迟，罪该万死！在下可助您行走江湖！\n"
      HIW "突然天空中一道" HIM "七" HIY "彩" HIR "霞" HIC "光" HIW "笼罩四方，转瞬即逝！" NOR;
  }
}
string ask_toutai() {
  object me = this_player();
  mapping fam;

  if ((int)me->query("tt"))
    return "投胎一次够了!";
  else {
    me->set("tt", 1);
    me->move("/d/register/entry");

  }
}
