// smith.c
inherit BHNPC;
// inherit F_DEALER;
//inherit F_VENDOR_SALE;
inherit F_BVENDOR;
string query_save_file() { return DATA_DIR + "npc/铁匠"; }
void create() {
  set_name("铁匠", ({ "tie jiang", "smith" }));
  this_object()->init_bhnpc();
  set("area_name", "扬州铁匠铺");
  set("area_file", "/d/city/datiepu.lpc");
  set("ziyuan", "铁矿");
  set("kaifa", 20);
  set("jizhi", 25);
  set("title", "铁匠铺老板");
  set("shen_type", 1);
  set("gender", "男性");
  set("age", 33);
  set("long", "铁匠正用铁钳夹住一块红热的铁块放进炉中。\n");
  set("combat_exp", 400);
  set("attitude", "friendly");
  set("vendor_goods", ([
    "changjian": "/d/city/obj/changjian",
    "knife": "/d/city2/obj/tudao",
    "dagger": "/d/city/obj/dagger",
    "staff": "/d/xingxiu/obj/staff",
    "club": "/d/xingxiu/obj/club",
    "blade": "/d/city/obj/gangdao",
    "axe": "/d/city/obj/gangaxe",
    "feidao": "/d/obj/feidao",
    "whip": "/d/city/obj/whip",
    "feihuangshi": "/d/obj/feihuangshi",
    "tielianzi": "/d/obj/tielianzi",
  ]));
  setup();
  carry_object("/clone/misc/cloth")->wear();
}
void init() {
  ::init();
  add_action("do_vendor_list", "list");
  //       add_action("do_list", "list");
  //        add_action("do_buy", "buy");
}
#include <die.h>
