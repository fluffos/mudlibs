// Room: /city/wumiao.c
#include <room.h>
inherit ROOM;
void create()
{
    set("short", "恩怨堂");
    set("long", @LONG
凡是在江湖上有过恩怨的人都到这里来跪拜（ｋｎｅｅｌ），
以忏悔过去的恩恩怨怨，从新作人。
LONG
    );
    set("no_fight", "1");
    set("no_steal", "1");
    set("no_sleep_room", "1");
    set("exits", ([
        "down" : __DIR__"wumiao",
    ]));
        setup();
}
void init()
{
     add_action("do_kneel", "kneel");
}

int do_kneel(string arg)
{
        object me=this_player(); 
        object ob;

        if ( (int)me->query("jing")<50)
           return notify_fail("你太累了，休息一下吧。\n");
           
        if ( (int)me->query("shen")>0)
           return notify_fail("你跟人无冤无仇到这里来干吗？\n");   
   
                           me->start_busy(3);
  message_vision("$N在恩怨堂前跪了下去！$N决心忘记前仇，从新做人。\n",me);
      me->add("jing",-(300+random(150)));
      me->add("shen",(50+random(20)));
    
  return 1;
} 


