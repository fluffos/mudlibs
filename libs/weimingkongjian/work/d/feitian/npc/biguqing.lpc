//Npc 比古清十郎
//diabio(青云)2003.3.1
#include <ansi.h>
inherit NPC;
int ask_tianxiang();
inherit F_MASTER;
void create() {
  set_name("比古清十郎", ({ "biwuqing shilang", "shilang" }));
  set("long", "他就是绯村剑心的师傅。 \n");
  set("title", HIR "飞天御剑流" HIY "当代掌门人" NOR);
  set("gender", "男性");
  set("age", 40);
  set("attitude", "peaceful");
  set("str", 40);
  set("dex", 50);
  set("con", 40);
  set("int", 40);
  set("per", 40);
  set("per", 23);
  set("tianyu_1", 1);
  set("max_qi", 6000);
  set("max_jingli", 10000);
  set("max_neili", 5000);
  set("max_jingqi", 1000);
  set("neili", 5000);
  set("qi", 6000);
  set("jingli", 10000);
  set("jingqi", 1000);
  set("combat_exp", 2000000);
  set_skill("dodge", 300);
  set_skill("unarmed", 300);
  set_skill("parry", 300);
  set_skill("sword", 300);
  set_skill("feitian-yujianliu", 300);
  set_skill("wuxing-dun", 150);
  set_skill("shayi", 300);
  set_skill("aikido", 150);
  set_skill("shayi-xinfa", 150);
  set_skill("force", 300);

  set_skill("literate", 350);
  map_skill("sword", "feitian-yujianliu");
  map_skill("force", "shayi-xinfa");
  map_skill("unarmed", "aikido");
  map_skill("dodge", "wuxing-dun");
  map_skill("parry", "feitian-yujianliu");
  set("inquiry", ([
    "飞天御剑流": "自战国时代开始以流传了三百年的武功。",
    "天翔龙闪": (: ask_tianxiang :),
    "绯村剑心": "他是我那不孝徒儿。" ]));
  setup();
  carry_object("/clone/misc/cloth")->wear();
  carry_object("/d/feitian/obj/wushidao")->wield();
}
void init() {
  add_action("do_qiecuo", "qingjiao");
  add_action("do_skills", ({ "skills", "cha" }));
  add_action("do_accept", "accept");
}
int do_qiecuo(string arg) {
  object me = this_player(), ob = this_object();
  string special, name;
  int exp, jb;
  if (!arg || sscanf(arg, "%s with %s", arg, name) != 2)
    return notify_fail("命令格式:  qingjiao <skills> with <somebody>。\n");
  ;
  if (!id(name))
    return notify_fail("你要向谁请教。\n");
  write(CYN "你向" + ob->name() + "抱拳说道：“在下" + me->name() + "，特向比古清前辈请教一下「" + to_chinese(arg) + "」的疑问。\n" NOR);
  if (!(special = me->query_skill_mapped(arg))) {
    if (arg == to_chinese(arg))
      write(CYN + ob->name() + "说道：“恕在下愚昧，不知「" + arg + "」是什么武功？到向你请较。\n" CYN);
    else
      write(CYN + ob->name() + "说道：“你必须enable这项特殊武功，才能和我切磋。\n" NOR);
    return 1;
  }
  if (me->is_busy() || me->is_fighting()) {
    write(CYN + ob->name() + "说道：你正忙着呢。\n" NOR);
    return 1;
  }
  if ((int)me->query("learned_points") >= (int)me->query("potential")) {
    write(CYN + ob->name() + "说道：这为" + RANK_D->query_respect(me) + "你的浅能不够了。\n" NOR); return 1;
  }
  if (!me->query_skill(arg, 1)) {
    write(CYN + ob->name() + "说道：你好象不会这种技能。\n" NOR);
    return 1;
  }
  if (arg == "force") {
    write(CYN + ob->name() + "说道：基本内功只能自己掌握，怎么能和我切磋呢？\n" NOR);
    return 1;
  }
  exp = me->query("combat_exp");
  jb = me->query_skill("arg", 1);
  if ((int)me->query_skill(
    arg,
    1
  ) * (int)me->query_skill(
    arg,
    1
  ) * (int)me->query_skill(arg, 1) / 10 > (int)me->query("combat_exp")) {
    write(CYN + ob->name() + "说道：你实战经练不够，武功造诣上无法进展了。\n" NOR);
    return 1;
  }
  if ((int)me->query("jingli") < 100) {
    write(CYN + ob->name() + "说道：这为" + RANK_D->query_respect(me) + "先休息一下吧，功夫需要循序渐进，不能急来。\n" NOR);
    return 1;
  }
  write(CYN + ob->name() + "点了点头，说道：“你进招吧！我来从中指点。”\n" NOR);
  write(CYN "你使出毕生所学开始和" + ob->name() + "较量起来。\n" NOR);
  write(CYN "比古清十郎使出剑决，腾挪招架，观察其破绽。\n" NOR);
  write(HIM "几招过后，你对" + to_chinese(arg) + "的体会又深了一层。\n" NOR);
  me->add("learned_points", 2);
  me->add("jingli", -30);
  me->improve_skill(arg, me->query_int() * 3);
  return 1;
}
int do_skills(string arg) {
  object me;
  me = this_player();
  if (!arg || arg != "shilang")
    return 0;
  if (wizardp(me))
    return 0;
  if (me->query("family/family_name") != "飞天御剑流") {
    command("shake " + me->query("id"));
    return 1;
  }
  tell_object(me, "比古清十郎目前所学过的技能：\n" +
    "  基本轻功 (dodge)                         - 深不可测 300/    0\n" +
    "  基本拳脚 (unarmed)                        - 深不可测 300/    0\n" +
    "  基本内功 (force)                         - 深不可测 300/    0\n" +
    "  基本招架 (parry)                         - 深不可测 300/    0\n" +
    "＊飞天御剑流 (feitian-yujianliu)           - 深不可测 300/    0    0\n" +
    "＊杀意心法 (shayi-xinfa)                   - 出神入化 150/    0    0\n" +
    "  基本剑法 (sword)                         - 深不可测 300/    0\n" +
    "＊五行遁 (wuxing-dun)                      - 出神入化 150/    0\n" +
    "＊合气道 (aikido)                          - 出神入化 150/    0\n"
  );
  return 1;
}
int recognize_apprentice(object ob) {
  if (ob->query("family/family_name") != "飞天御剑流") {
    command("say 非我派弟子不能学我功夫。\n");
    return 0;
  }
  if (ob->query("combat_exp") < 800000) {
    command("say 你的实战经练不够，我不能传授你功夫。\n");
    return 0;
  }
  return 1;
}
int ask_tianxiang() {
  object ob;
  ob = this_player();

  tell_object(ob, "比古清十郎说道：天降龙闪乃最高剑决，如要学会需和我以命相拼才行，你如想清楚了就跟我来陶窑！\n");
  command("go south");
  command("go west");
  command("sigh");
  return 1;
}
void kill_ob(object me) {
  command("say 你可要小心了，拿出你必生功力来杀我。\n");
  this_player()->set("feitian/bigu", 1);
  ::kill_ob(me);
}

void die() {
  message_vision("\n$N道：“你不必难过，飞天御剑流代代传人都是如此，如要学会最高剑决掌门就需陪上性命，你不必太难过。\n", this_object());
  this_player()->set("feitian/tianxiang_perform", 1);
  message_vision("\n在生死一线中你体会到了天翔龙闪的精髓。\n", this_object());
  ::die();
}
