inherit ROOM;

void create() {
  set("short", "广场");
  set("long", @LONG

    从开封城门走过来，你可以看见这个方圆几百里的空地，这个广场
具有悠久的历史，广场的四面八方都是玩家修建的各种各样的城池,从这
里开始，你也可以在这里的任何一个地方造属于自己的城堡,扩大地盘,
修起来了可是千秋万代的基业啊!

LONG);

  set("exits", ([
    "northeast": "/p/residence/txp1000526567",
    "southwest": "/p/residence/fbig1000408845",
    "southeast": "/p/residence/wshai1000390929",
    "westup": "/p/residence/tdj999922556",
    "eastup": "/p/residence/maxpk997811873",
    "southup": "/p/residence/ddgj997793077",
    "northwest": "/p/residence/king997760231",
    "northup": "/p/residence/maxpk997586821",
    "south": "/p/residence/claire997451570",
    "down": "/p/residence/atow997411400",
    "east": "/p/residence/xiha997341811",
    "up": "/p/residence/xiha997340238",
    "west": __DIR__ "chengmen",
    "north": __DIR__ "jiuguan",
  ]));
  set("outdoors", __DIR__);
  set("owner", "public");

  setup();
}
