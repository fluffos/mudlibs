#include <weapon.h>
#include <ansi.h>
inherit THROWING;
void create()
{
	set_name(HIG  "唐花" NOR, ({ "tanghua" }) );

	if( clonep() )
                set_default_object(__FILE__);
	else {
		set("unit", "枚");
		set("long", "唐花一开就谢，开时如花，谢时成铁。\n");
		set("value", 50000);
		set("base_unit", "枚");
		set("base_weight",100);
		set("material", "iron");
		set("wield_msg", HIC"$N手中突然多了一朵花。\n"NOR);
                set("unwield_msg",HIC"$N手中的花突然不见了。\n"NOR);
		}
	set_amount(1);
        init_thorwing(100);
	setup();
}
