//tangjue.c

#include <ansi.h>;
inherit NPC;
int carry_obj();


void create()
{
        set_name("唐绝", ({ "tang jue","tang"}));
        set("nickname", HIR"绝大少"NOR);
        set("long", 
"唐门三绝之一，唐绝最绝，绝得连唐门中人都不知道他的绝法，所有的绝门暗器，他都会用。\n");
        set("gender", "男性");
        set("age", 32);
        set("attitude", "peaceful");
        set("shen_type", 1);
        set("str", 28);
        set("int", 26);
        set("con", 26);
        set("dex", 27);
        set("max_qi", 8000);
        set("max_jingli", 2500);
        set("max_douzhi", 600);
        set("douzhi", 600);
        set("neili", 4500);
        set("max_neili", 4500);
        set("yanli", 200);
        set("jiali", 120);
        set("combat_exp", 900000);
        set("score", 8000);

        set_skill("force", 170);
        set_skill("throwing", 170);
        set_skill("dodge", 160);
        set_skill("parry", 170);
        set_skill("tao",160);
        set_skill("literate",120);
        set_skill("hand",160);
        set_skill("boyun-suowu",160);
        set_skill("tangmen-xinfa", 170);
        set_skill("feiyan-zong", 160);
        set_skill("tangmen-throwing", 170);
        
        map_skill("force", "tangmen-xinfa");
        map_skill("dodge", "feiyan-zong");
        map_skill("parry", "tangmen-throwing");
        map_skill("hand", "boyun-suowu");
        
        prepare_skill("hand","boyun-suowu");
        
        set("chat_chance_combat", 20);
        set("chat_msg_combat", ({
        	( : command("yun recover") : ),
        	( : command("yun recover") : ),
        	( : command("use qian") : ),
        	( : command("use hua") : ),
        	( : command("wield all") : );
        	( : command("wield all") : );
        	( : carry_obj : ),
        	( : carry_obj : ),
        	
        }) );
        
        set("chat_chance" , 8 );
        set("chat_msg" , ({
        	"唐门之大，但不容不肖子弟！\n",
        	"学武之道在于勤奋！\n",
        	"唐门的弟子要记好啊！\n",
        }) );
 	
        	
        	
        create_family("四川唐门", 3, "弟子");

        setup();
        carry_object("/clone/misc/cloth")->wear();
        carry_object("/d/tangmen/tangmenzhen/obj/jili")->wield();
        carry_object("/d/tangmen/tangmenzhen/obj/qinglizi")->wield();
}

int carry_obj()
{
	object me,ob;
	
	me = this_object();
	
	swith(0)
	{
		case 0:
	        ob = new("/kungfu/class/tangmen/obj/tanghua");
	        break;
	        default:
	        ob = new("/kungfu/class/tangmen/obj/qianqian");
	        break;
	 }
	 
	 ob->move(me);
	 return 1;
}	 