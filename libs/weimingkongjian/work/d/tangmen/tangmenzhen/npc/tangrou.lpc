inherit NPC;
inherit F_MASTER;
#include <ansi.h>;
int ask_job();
#include "/d/tangmen/tangmenzhen/npc/job.h";

void create()
{
        set_name("唐柔", ({ "tang rou","tang"}));
        set("nickname", HIG"锦江老四"NOR);
        set("long", 
"这是锦江四公子的老四，一身的功夫却是不凡。\n");
        set("gender", "男性");
        set("age", 25);
        set("attitude", "peaceful");
        set("shen_type", 1);
        set("str", 30);
        set("int", 25);
        set("con", 24);
        set("dex", 28);
        set("max_qi", 8000);
        set("max_jingli", 1000);
        set("max_douzhi", 1200);
        set("douzhi", 300);
        set("neili", 2000);
        set("max_neili", 2000);
        set("jiali", 100);
        set("shen", 2000);
        set("combat_exp", 100000);
        set("score", 7000);

        set_skill("force", 100);
        set_skill("throwing", 80);
        set_skill("dodge", 80);
        set_skill("parry", 80);
        set_skill("tao",80);
        set_skill("literate", 80);
        set_skill("hand",80);
        set_skill("boyun-suowu",80);
        set_skill("tangmen-xinfa", 80);
        set_skill("feiyan-zong", 80);
        set_skill("tangmen-throwing", 100);
        
        map_skill("force", "tangmen-xinfa");
        map_skill("throwing", "tangmen-throwing");
        map_skill("dodge", "feiyan-zong");
        map_skill("parry", "tangmen-throwing");
        map_skill("hand", "boyun-suowu");
        
        prepare_skill("hand", "boyun-suowu");
        
        create_family("四川唐门", 3, "弟子");

        set("inquiry", ([
                "job" : ( : ask_job  : ),
        ]));
        
        set("chat_chance_combat", 20);
        set("chat_msg_combat", ({
        	( : command("yun recover") : ),
        	( : command("yun recover") : ),
        	( : command("wield all") : ),
        	( : command("wield all") : ),
        }) );	

        setup();
        carry_object("/clone/misc/cloth")->wear();
        carry_object("/d/tangmen/tangmenzhen/obj/jili")->wield();
        carry_object("/d/tangmen/tangmenzhen/obj/feidao")->wield();
}

void attempt_apprentice(object ob)
{
    if ((int)ob->query("shen") > 0 || (int)ob->query ("shen") < 0
             || (int)ob->query ("combat_exp") > 100 )
        {
                command("say “我四川唐门乃是武林世家，你已是武林中人，我不能收你为徒！”\n");
                return;
        }
    if ((int)ob->query("dex") < 23 )
        {
        	command("say “你的身法太差了，不要误了自己啊！”\n");
        	return;    
        }
    if ( ob->query("family/family_name") == "四川唐门" 
             && ob->query("family/master_name") != "唐柔" )
        {
        	command("say “你已是我唐门人，我的功夫不是太高的，你还是找我大师哥吧!”\n");
        	return;
        }        	    
    command("say “好吧，从今天起你就是唐门的弟子了。”\n");
    ob->set("yanli",1);
    command("recruit " + ob->query("id"));
        

}
