
// dizi.c
inherit NPC;

void create()
{
        int i,amun;
        string *order = ({"唐"});
        string *orderr = ({"暗","器","小","虫","随","风"});
        set_name( order[random(1)] + orderr[random(6)], ({ "dizi" }) );
        set("gender", "男性");
        set("long",
		"唐门弟子，着一身灰色的劲装\n"
	);
        set("combat_exp", random(50000));
        set("class", "tangmen");
        set("neili", random(500));
        set("max_neili", random(500));

	set("title", "唐门弟子");
        set_skill("force", 10+random(80));
        set_skill("dodge", 10+random(80));
        set_skill("throwing", 10+random(80));
        set_skill("parry", 10+random(80));
        setup();

        add_money("silver", 5);
        carry_object("clone/misc/cloth")->wear();
}

int accept_fight(object me)
{
        if( (string)me->query("family/family_name")=="唐门" ) {
                command("nod");
                command("say 进招吧。");
                return 1;
        }
        command("say 唐门弟子不和别派的人过招。");
        return 0;
}
