inherit NPC;
inherit F_MASTER;
int carry_hh();
string ask_biao();
#include <ansi.h>;

void create()
{
        set_name("唐大", ({ "tang da","tang"}));
        set("nickname", HIC"大爷"NOR);
        set("long", 
"唐门中三代弟子的代表人，名列唐门一流高手之中，在武林是也隐然为一方之雄。\n");
        set("gender", "男性");
        set("age", 32);
        set("attitude", "peaceful");
        set("shen_type", 1);
        set("str", 25);
        set("int", 25);
        set("con", 25);
        set("dex", 28);
        set("max_qi", 8000);
        set("max_jingli", 1500);
        set("max_douzhi", 500);
        set("douzhi", 500);
        set("neili", 4000);
        set("max_neili", 4000);
        set("yanli",200);
        set("jiali", 100);
        set("combat_exp", 800000);
        set("shen",3000);
        set("score", 7000);

        set_skill("force", 160);
        set_skill("throwing", 160);
        set_skill("dodge", 160);
        set_skill("parry", 160);
        set_skill("tao",160);
        set_skill("literate", 120);
        set_skill("hand",160);
        set_skill("boyun-suowu",160);
        set_skill("tangmen-xinfa", 160);
        set_skill("feiyan-zong", 160);
        set_skill("tangmen-jueqi", 100);
        set_skill("tangmen-throwing", 160);
        
        map_skill("force", "tangmen-xinfa");
        map_skill("dodge", "feiyan-zong");
        map_skill("parry", "tangmen-throwing");
        map_skill("hand", "boyun-suowu");
        
        prepare_skill("hand","boyun-suowu");
        
        set("chat_chance" , 8 );
        set("chat_msg" , ({
        	( : command("drop hhbiao" ) :),
        	( : command("drop hhbiao" ) :),
        	( : command("say “唐门弟子要守门规啊，否则要受到惩罚的啊!”\n") : ),
        }) );	 
        
        set("chat_chance_combat", 20);  
	set("chat_msg_combat", ({
		( : command("yun recover" ) : ),
		( : command("yun recover" ) : ),
		( : carry_hh : ),
		( : carry_hh : ),
		( : command("wield hhbiao" ) : ),
		( : command("wield all") : ),
		( : command("wield all") : ),
		( : command("wield hhbiao" ) : ),
		( : command("wield hhbiao" ) : ),
		( : perform_action, "throwing.huihun" : ),
		( : perform_action, "throwing.huihun" : ),
	}) );	
        set("inquiry", ([
              "子母回魂镖" : ( : ask_biao : ),
              "回魂镖"     : ( : ask_biao : ),
        ]) );       
        
        create_family("四川唐门", 3, "弟子");
        

        setup();
        carry_object("/clone/misc/cloth")->wear();
        carry_object("/d/tangmen/tangmenzhen/obj/feidao")->wield();
        carry_object("/d/tangmen/tangmenzhen/obj/fhshi")->wield();
        carry_object("/d/tangmen/tangmenzhen/obj/tiejili")->wield();
        carry_object("/d/tangmen/tangmenzhen/obj/feidao")->wield();
        carry_object("/d/tangmen/tangmenzhen/obj/fhshi")->wield();
        carry_object("/d/tangmen/tangmenzhen/obj/tiejili")->wield();
        carry_object("/d/tangmen/tangmenzhen/obj/qinglianzi")->wield();
        carry_object("/d/tangmen/tangmenzhen/obj/qinglianzi")->wield();
        
}


void attempt_apprentice(object ob)
{
    if ( ob->query("family/family_name") != "四川唐门" )
        {
                command("say “我四川唐门乃是武林世家，你已是武林中人，我不能收你为徒！”\n");
                return;
        }
    if ( ob->query("combat_exp") < 500000 )
        {
        	command("say “你的经验太少，不能练好的功夫的！”\n");
        	return;
        }	
    if ( ob->query("gender") != "男性")
        {
        	command("say “你还是到我小妹那边去吧，我只收男弟子的！”\n");
        	return;
        }	       
    if ( ob->query_skill("tangmen-xinfa") < 80 || ob->query_skill("tangmen-throwing") < 80 )
        {
        	command("say “你的心法和暗器不太熟练，要加油啊！”\n");
        	return;
        }	
        
    command("say “好吧，从今天起你就是唐门的弟子了。”\n");
    command("recruit " + ob->query("id"));
        

}

string ask_biao()
{
	object me,ob;
	
	me = this_player();
	
	if ( me->query("family/family_name") != "四川唐门")
	        return HIR"你要这东西干什么啊？\n"NOR;
	     
	if ( (int)me->query_skill("tnagmen-xinfa") < 150 && (int)me->query_skill("tangmen-throwing") < 150 )     
	{
		command("laugh "+me->query("id") );
		return HIG"本门心法和暗器要多练练啊！\n"NOR;
	}
	
	if ( me->query_condition("huihunbiao") > 0 )
	{
		command("kok "+me->qurey("id") );
	        return HIC"你不是刚要过吗？\n"NOR;
        }
        
        ob = new("/kungfu/class/tangmen/obj/huihun.lpc");
        ob->move(me);
        me->apply_condition("huihunbiao", 20+(int)me->query("kill")/50);
        return HIC"好吧，这支镖就给你，不要乱杀无辜啊！\n"NOR;
}

int carry_hh()
{
	object ob,me;
	
	me = this_object();
	
	ob = new("/kungfu/class/tangmen/obj/huihun.lpc");
        ob->move(me);
        return;
}
