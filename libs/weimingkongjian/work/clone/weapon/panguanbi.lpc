// 判官笔

#include <weapon.h>
// AGENTS.md §11: original inherited a nonexistent PEN/init_pen (no
// /inherit/weapon/pen.lpc anywhere in this lib) -- the file's own
// description ("这是一柄普通的精钢剑" -- an ordinary refined-steel SWORD)
// and material/unit fields match the SWORD template it was clearly
// cloned from, so use that instead.
inherit SWORD;

void create()
{
	set_name("判官笔", ({ "panguanbi","pen" }));
	set_weight(5000);
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("unit", "对");
		set("long", "这是一柄普通的精钢剑，一般的剑客都配带此剑。\n");
		set("value", 1500);
		set("material", "steel");
		set("wield_msg", "$N「唰」的一声抽出一对$n握在手中。\n");
//		set("unwield_msg", "$N将手中的$n插回剑鞘。\n");
	}
	init_sword(25);
	setup();
}
