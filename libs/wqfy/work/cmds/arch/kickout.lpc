// kickout.c

#include <ansi.h>
#include <command.h>

inherit F_CLEAN_UP;

int main(object me, string arg)
{
        object ob;
        string wiz_status;
        string tmpstr;

        if( me!=this_player(1) ) return 0;

        if( !arg || sscanf(arg, "%s", arg)!=1 )
                return notify_fail("argument error!\n");


        wiz_status=SECURITY_D->get_status(me) ;

        ob = LOGIN_D->find_body(arg);
        if (ob->query("id")=="qiu") return notify_fail("咿... 看清楚，这个人你能踢的吗？\n");
        if (!ob) return notify_fail("咦... 有这个人吗?\n");

                if (    !living(ob)
                ||      !ob->is_character()
                ||      ob==me )
                        return notify_fail("ob error!\n");
        log_file("kickout_player", sprintf("[%s] %s kickout %s\n",
                        ctime(time()), geteuid(me), geteuid(ob)));
        tell_object( me, "你把 " + ob->query("name") + " 踢了出去!\n");
        seteuid(ROOT_UID);
        ob->save();
        destruct(ob);
        seteuid(getuid());

        return 1;
}

int help(object me)
{
write(@HELP
指令格式 : kickout <某人>

HELP
    );
    return 1;
}
