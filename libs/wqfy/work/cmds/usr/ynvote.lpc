//新的投票系统，好玩吧 xgchen@fy 2002-2-1
#include <ansi.h>
#define YNVOTE   "/adm/daemons/newvoted"
inherit F_CLEAN_UP;
int help();
int main(object me, string arg)
{
	object ob;
	string msg;
       	seteuid(ROOT_UID);
     if ( !arg || arg=="" ) return help();
        if (arg!="yes"&&arg!="no") return notify_fail("只能选择 yes or no!\n");
	if (me->query("have_voted")) return notify_fail("对不起，你已经投过票了。\n");
	if (!YNVOTE->query_temp("voting")) return notify_fail("现在并没有举行投票呀。\n");
	if (arg=="yes")
                {msg="是";}
                      else
            {msg="否";}
	write("Ok。你已经选择"+msg+"成功的投出了一票！\n");
message("system",HIY"【天神频道】"HIW+me->name()+"("+me->query("id")+")的一票投了("+msg+")！\n"NOR,users());
if(arg=="yes"){	me->add_temp("votedyes",1);}
if(arg=="no"){	me->add_temp("votedno",1);}
	me->set("have_voted",1);
	return 1;
}

int help()
{
	write(@TEXT
指令格式：ynvote <玩家id>

这个指令让你在投票活动中投票，
每人只能投一票。

TEXT
	);
	return 1;
}

