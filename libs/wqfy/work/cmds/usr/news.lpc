//修改于2002.03
#include <ansi.h>;
inherit BULLETIN_BOARD;

void create()
{
        set_name("风云新闻", ({ "fynews_board"}) );
        set("location", "/d/wiz/jobroom"); 
        set("board_id", "fynews_b");             
        set("capacity", 1000);
      setup();
}

int check_news(object me)
{
        int num,i,last_time_read;
        mapping *notes, last_read_time;
        string myid,msg="";
        
        notes = query("notes");
        last_read_time = me->query("last_read_news");
        myid = query("board_id");
        
        if( !pointerp(notes) || !sizeof(notes) ) return 1;
                i=sizeof(notes)-me->query("LastReadNews");

      if (i<0) i=0;
                write("\n从您上次阅读到现在"+((i==0)? "没有任何":"共有"+HIY+chinese_number(i)+NOR"条")+"新闻，请查阅（Help news)。\n\n");
                if(i>0) 
                 seteuid(ROOT_UID);
                me->start_call_out( (: call_other, __FILE__, "auto_notice",me :),
                 random(10)+10);
}
int main(object me, string arg)
{
        int num,i,last_time_read;
        mapping *notes, last_read_time;
        string myid,msg;

        last_read_time = me->query("last_read_news");
        myid = query("board_i");
        notes = query("notes");
        i=sizeof(notes)-me->query("LastReadNews");
        if( !pointerp(notes) || !sizeof(notes) )
                return notify_fail(MUD_NAME+"目前没有任何新闻。\n");
                
        if( !arg ) 
      {
      if (i<0) i=0;
                if(i>10) write("你可以 Help news 来查看"+MUD_NAME+"新闻系统的使用方法。\n"); 
                        return notify_fail(
                                "「"+MUD_NAME+"」目前共有"+HIW+chinese_number(sizeof(notes))+NOR"条新闻"+((i==0)? "。":"，您有"+HIY+chinese_number(i)+NOR"条新闻尚未阅读。")+"\n"); }
                                
                if( arg=="all") // 显示所有新闻
                {
                        msg = "\n\n    ━━━━━━━━━━━━ "HIW+MUD_NAME"新闻一览"NOR" ━━━━━━━━━━━━    \n";
                        notes = query("notes");
                        
                        if (mapp(last_read_time)) last_time_read = last_read_time[myid];
                        for(i=sizeof(notes)-1 ; i>-1 ; i--)
                        {
                                msg += sprintf("%s<%3d>" NOR,
                                notes[i]["time"] > last_time_read ? HIY: "", i+1);
                                msg += sprintf("     %-=36s %18s (%s)\n",
                                        notes[i]["title"], notes[i]["author"],
                                        CHINESE_D->chinese_time(5, ctime(notes[num]["time"])));
                        }
                        msg += "\n";
                        me->start_more(msg);
                        return 1;
                        
                }
                else
                if ( arg=="new" )  // 显示最新新闻
                {
                        if( !mapp(last_read_time) || undefinedp(last_read_time[myid]) )
                                num = 1;
                        else
                                for(num = 1; num<=sizeof(notes); num++)
                                        if( notes[num-1]["time"] > last_read_time[myid] ) break;
                                        
                } else if( !sscanf(arg, "%d", num) )
                
        return notify_fail("你到底要看第几条新闻呀？\n");
        
        if( num < 1 || num > sizeof(notes) )
                return notify_fail("看清楚点，好像没有这条新闻耶。\n");
                
        num--;
     me->start_more( sprintf("\n\n%s\n
[47;34m  作者 [44;37m %-70s
[47;34m  标题 [44;37m %-70s
[47;34m  时间 [44;37m %-70s[m  [36m\n------------------------------------------------------------------------------[m\n\n\n",
               BBLU HIY"天下无敌"HIG"第"+chinese_number(num + 1)+"条新闻"NOR, 
notes[num]["author"],notes[num]["title"],ctime(notes[num]["time"]))
+ notes[num]["msg"]+
        HIY"\n\n\t\t\t长孙无情@"MUD_NAME+NOR"\n-------------------------------------------------------------------------------\n\n", );

        if( !mapp(last_read_time) )
                me->set("last_read_news", ([ myid: notes[num]["time"] ]) );
        else 
                if( undefinedp(last_read_time[myid]) || notes[num]["time"] > last_read_time[myid] )
                        last_read_time[myid] = notes[num]["time"];

        if(me->query("LastReadNews") < num + 1)
                me->set("LastReadNews",num+1);

        return 1;
}

void init()
{
        object me=this_player();
       if (wizardp(me) &&  wiz_level(me) > wiz_level("(arch)") )
        {
                add_action("do_post", "jia");
                add_action("do_discard", "qu");
      } 
}
void done_post(object me, mapping note, string text)
{
        mapping *notes;

        note["time"] = time();
        note["msg"] = text;
        notes = query("notes");
        if( !pointerp(notes) || !sizeof(notes) )
                notes = ({ note });
        else
                notes += ({ note });

        if( sizeof(notes) > query("capacity"))
                notes = notes[query("capacity")/2 .. query("capacity")];

        set("notes", notes);
        save();
        restore();
        CHANNEL_D->do_channel(me, "fy", BLINK HIR"\n\n「"+MUD_NAME+BLINK HIR"」有了最新新闻，请用(news)查看。\n" NOR);
        tell_object(me, "新闻发表完毕。\n");

        return;
}
void auto_notice(object me)
{
        int num;
        mapping *notes;
        string msg;
        int last_read_time;

        if (! objectp(me))
                return;

        last_read_time = me->query("last_read_news");
        notes = query("notes");

        if (! pointerp(notes) || ! sizeof(notes))
                return;

        num = sizeof(notes) - 1;
        if (notes[num]["time"] <= last_read_time)
                return;
            if(me->query("LastReadNews") >= num )
                return;

        // some news need read, start next call out
     seteuid(ROOT_UID);
                me->start_call_out( (: call_other, __FILE__, "auto_notice",me :),
                random(20)+20);
        if (! living(me) || me->query_temp("block_msg/all"))
                return;

        while (num-- > 0)
        {
                if (notes[num]["time"] <= last_read_time)
                {
                        num++;
                        break;
                }

                // contine to find next
        }

        if (num < 0) num = 0;

    msg = HIY "-------------------------------------------------------------------------------\n" NOR;
    msg += CYN "如果你是个老玩家，或者已经很熟悉系统的最新运作。\n" NOR;
    msg += CYN "那么请你news最新的新闻，新闻频道将终止它的任务。\n" NOR;
     msg += CYN "我们谢谢你的合作。\n" NOR;
        tell_object(me, msg);
     me->start_more( sprintf("\n\n%s\n
[47;34m  作者 [44;37m %-70s
[47;34m  标题 [44;37m %-70s
[47;34m  时间 [44;37m %-70s[m  [36m\n------------------------------------------------------------------------------[m\n\n\n",
               HIY+MUD_NAME+HIG"第"+chinese_number(num + 1)+"条新闻"NOR, 
notes[num]["author"],notes[num]["title"],ctime(notes[num]["time"]))
+ notes[num]["msg"]+
        HIR"\n\n\t\t\t长孙无情@"MUD_NAME+NOR+HIY"\n-------------------------------------------------------------------------------\n\n", );

        // Keep track which post we were reading last time.
        if (notes[num]["time"] > (int)last_read_time)
                me->set("last_read_news", notes[num]["time"]);
            if(me->query("LastReadNews") < num + 1)
                me->set("LastReadNews",num+1);
    tell_object(me, HIM "谢谢光临"+MUD_NAME+"，我们将带给你无比欢乐。\n" NOR);
}
int help(object me)
{
    write(@HELP
「郑州风云」新闻系统指令 

指令格式 :
news                    查看共有的和最新发布的新闻。
news all                新闻一览。 
news new                阅读最新的新闻。 
news <新闻编号>         查看此编号新闻的详细内容。 
HELP
    );
    return 1;
}
