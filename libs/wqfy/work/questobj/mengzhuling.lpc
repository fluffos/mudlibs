// qiu 2002.4.28
#include <weapon.h>
#include <ansi.h>
inherit HAMMER;

void create()
{
	set_name(HIG  "盟主令" NOR, ({ "mengzhuling" }) );
	set_weight(1000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "枚");
		set("long", "这个是由武林各个公认的高手的武器炼制而成的盟主令，具有至高无上
的权力，能号令天下。到底能不能号令却没人敢去试试，因为拿这个东西的人多数都快死了。\n");
		set("max_haoling",2+random(4));
                set("material", "hammer");
	}
	init_hammer(50+random(100));
	setup();
}
void init()
{
	if(environment()==this_player())
	add_action("do_haoling","haoling");

}


int do_haoling(string arg)
{
    object me,target;
    me=this_player();
	if( !arg || sscanf(arg, "%s", target)!=1 )
		return notify_fail("指令格式：haoling <姓名> \n");
	target = present(target, environment(this_player()));

	if( !target
	||	!target->is_character()
	||	!me->is_fighting(target) )
		return notify_fail("［号令天下］只能对战斗中的对手使用。\n");
	if(target->is_busy())
		return notify_fail(target->name()+"已经手忙脚乱了！\n");
            if(query("max_haoling") <=0)        return notify_fail("你用盟主令用得太多了，早已失去威信力了！\n");
	message_vision("$N掏出一个盟主令，高声叫道：“盟主令牌在此，谁敢不遵！！天下莫敢不
从！！$n一看盟主令，心中剧震，目瞪口呆，一时间动弹不得。”\n",me,target);
            target->start_busy(3);add("max_haoling",-1);
	return 1;

}

