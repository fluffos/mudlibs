// icy_cloth.c

#include <ansi.h>
#include <armor.h>

inherit CLOTH;

void create()
{
	set_name( HIC "觇玉羽衣" NOR, ({ "jade-cloth", "cloth" }) );
            set("long", "天机穿的衣服，由无数块上等青田白玉编织而成，你仔细一打量，玉石似乎
排成几个字“天机第一，量横天下”，你不禁起了好奇心，希望将其他的天机物品
组合(zuhe)一下，看有什么发现。\n");
	set_weight(1000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "件");
		set("value", 40000);
		set("material", "cloth");
		set("armor_prop/armor", 10);
		set("armor_prop/dodge", 5);
	}
	setup();
}
void init()
{
  if(this_player()==environment())
  add_action("do_zuhe","zuhe");
}

int do_zuhe()
{
int i,hezhu=0,baizhu=0,fazhu=0;
object jade,me, *inv;
object zhu1,zhu2,zhu3;
me = this_player();
inv = all_inventory(me);
                for(i=0; i<sizeof(inv); i++)
                {
			if(inv[i]->query("name") == "[1;36m觇玉软靴[2;37;0m") {hezhu = 1; zhu1 = inv[i];}
                      if(inv[i]->query("name") == "[1;36m觇玉戒指[2;37;0m") {baizhu = 1; zhu2 = inv[i];}
                     if(inv[i]->query("name") == "[1;36m觇玉发簪[2;37;0m") {fazhu = 1; zhu3 = inv[i];}

		}
if( hezhu && baizhu && fazhu )
{
	destruct(zhu1);
        destruct(zhu2);
        destruct(zhu3);
	jade = new("/questobj/obj/chi");
	jade->move(me);
message_vision("$N终于把天机的东西找齐了，可是不知道怎么组合，只是眼瞪瞪的发呆，无聊的
摆弄，忽然间，一道白光闪过，耀眼的光芒刺得人都睁不开眼，光芒过后，一把晶莹的
玉尺出现在面前。\n",this_player());
	destruct(this_object());

}
else 
message_vision("$N真想把觇玉羽衣组合一下，但可惜的是手中没有东西呀！真是傻呆了。\n",this_player());

return 1;
}