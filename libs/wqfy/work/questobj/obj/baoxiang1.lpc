// qiu 2002.4.29
#include <ansi.h>
inherit ITEM;
void create()
{
        string *order=({HIB"蓝色宝箱"NOR, HIR"红色宝箱"NOR, HIY"金色宝箱"NOR,HIW"白色宝箱"NOR,HIM"紫色宝箱"NOR,HIC"青色宝箱"NOR});
        set_name((order[random(6)]) , ({ "bao-xiang", "xiang"}) );
        set_weight(1);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long",
                HIY "此物极其珍贵，唯有完成特殊任务者才能获得，似乎可以(open)打开。\n"NOR);
                set("unit","个");
                set("value", 0);
        }
        }
void init()
{
        add_action("open_gongbao","open");
}
int open_gongbao(string arg)
{
        object me = this_player();
        int exp;
        int pot;
        int sscore;
        if ( arg == "bao-xiang"){
        exp = 12000 + random(4000);
        pot=exp/5;
        sscore = -700 + random(300);
        message_vision(HIM"$N擦了擦额头的汗水，迫不及待地用颤抖的双手打开了宝箱。\n"NOR,this_player());
        this_player()->add("combat_exp",exp);
        this_player()->add("potential",pot); 
        this_player()->add("score",sscore);
        tell_object(this_player(),HIR"哇！！！！你被奖励了：\n\n" +
        chinese_number(exp) + "点实战经验。\n"+
        chinese_number(pot) + "点潜能。\n" +
        chinese_number(sscore) + "点综合评价。天下无敌全体巫师恭喜你！\n"NOR);
        command("rumor " + me->query("name") + "迫不及待地用颤抖的双手打开了宝箱！");
        destruct(this_object());
        return 1;
     }
     return 0; 
}
