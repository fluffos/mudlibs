#include <ansi.h>
inherit ITEM;
void create()
{
    set_name(HIM"三清宝典"NOR, ({ "tianbook" }) );
    set_weight(100);
    if( clonep() )
            set_default_object(__FILE__);
    else {
            set("unit", "本");
            set("material", "stone");
            set("long", "这是一本相传能通天地，灭鬼神的书籍，但是没几个人有毅力去真正读完他。\n");
            set("material", "paper");
	      set("skill", ([
			"name": 		"necromancy",	
			"exp_required":	0,				
			"sen_cost":		100,				
			"difficulty":	40,		
			"max_skill":	60		
		]) );
          }

    setup();
}
