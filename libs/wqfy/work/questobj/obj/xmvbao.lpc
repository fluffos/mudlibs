// hongbao.c
// ken 1999.12.3
#include <ansi.h>
inherit ITEM;

void create() {
  string *names = ({
    HIG "在线红包" NOR, HIM "发呆红包" NOR, HIW "挂机器人红包" NOR, HIY "大米红包" NOR, HIR "聊天红包" NOR
  });

  set_name(names[random(sizeof(names))], ({ "xmv-hongbao" }));
  set_weight(10);
  set("value", 100000);
  set("no_get", "1");
  set("no_drop", "1");


  set("unit", "个");
  set("long", "这是笨蛋巫师絮絮的给你的奖励，你可以打开(kai)看看。\n");
  setup();
}

void init() {
  add_action("do_kai", "kai");
}

int do_kai(string arg) {
  object me;
  int exp, pot, score;
  exp = 500 + random(100);
  pot = exp / 7;
  score = 5 + random(10);
  me = this_player();
  if (!arg || arg == "") return 0;
  if (arg == "xmv-hongbao" || arg == "红包") {
    message_vision("\n\n$N抹了抹头上的汗水，用颤抖的双手, 迫不急待地打开了" + this_object()->name() + "。\n" NOR, me);
    message_vision(HIW "\n$N满意地点了点头，心里暗暗的讥笑絮絮。\n\n" NOR, me);
    me->add("combat_exp", exp);
    me->add("potential", pot);
    me->add("score", score);

    tell_object(me, HIY "你被奖励了：\n" +
      chinese_number(exp) + "点实战经验\n" + chinese_number(pot) + "点潜能\n" +
      chinese_number(score) + "点评价\n" +
      NOR);
    tell_object(me, HIW "\n恭喜你!\n" NOR);
    CHANNEL_D->do_channel(this_object(), "rumor",
      sprintf(this_player()->query("name") + "(" + this_player()->query("id") + ")" + "偷偷开了一个超级笨蛋大巫师絮絮发的小红包！\n"));


    destruct(this_object());
    return 1;
  }
  return 1;
}

//}
