#include <ansi.h>
inherit ITEM;
void create() {
  set_name(HIY "免死金牌" NOR, ({ "jinpai" }));
  set_weight(1);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "块");
    set("material", "stone");
    set("long", "皇帝御赐的金牌，持金牌者能得到三次免死机会，是皇帝;给功劳极大的人的奖赏。\n");
    set("max_halt", 3);
  }

  setup();
}
void init() {
  if (environment() == this_player())
    add_action("do_miansi", "miansi");
}
int do_miansi() {
  object me = this_player();
  if (!me->is_fighting())
    return notify_fail("你现在并没有在战斗。\n");
  if (query("max_halt") <= 0)
    return notify_fail("" + this_object()->name() + "只能用三次！\n");
  me->remove_all_killer();
  add("max_halt", -1);
  message_vision(
    "$N掏出" + this_object()->name() + "喝道：“" + this_object()->name() + "在此，谁敢动我！”那些该死的东西马上停了下来，不敢动了。\n",
    me
  );
  write("Ok.\n");
  return 1;
}
