// qiu 2002.4.29
#include <ansi.h>
inherit ITEM;
void create()
{
    set_name(HIW"炼兵秘法" NOR, ({ "paper" }) );
    set_weight(1);
    if( clonep() )
            set_default_object(__FILE__);
    else {
            set("unit", "张");
                     set("long", "一张神秘的炼制（lian）兵器方法，你仔细一看，上面居然是武林盟主令的炼制方法。
你不禁欣喜若狂，于是急急的看了下去，可是你既失望又有一点希望，失望的是
要练制盟主令原来要天下公认武林高手的兵器，有希望的是现在那些高手的兵器
因为种种原因已经流落江湖，不知所踪，你想有机会能找到那些兵器。\n");
            set("material", "paper");
          }
    setup();
}
void init()
{
  if(this_player()==environment())
  add_action("do_lian","lian");
}

int do_lian()
{
int i,azhu=0,bzhu=0,czhu=0,dzhu=0,ezhu=0;
object jade,me, *inv;
object zhu1,zhu2,zhu3,zhu4,zhu5;
me = this_player();
inv = all_inventory(me);
              for(i=0; i<sizeof(inv); i++)
               {
                            if(inv[i]->query("name") == "[1;34m毁天锤[2;37;0m") {azhu = 1; zhu1 = inv[i];}
                            if(inv[i]->query("name") == "[1;37m小李飞刀[2;37;0m") {bzhu = 1; zhu2 = inv[i];}
                            if(inv[i]->query("name") == "[1;36m圆月弯刀[2;37;0m") {czhu = 1; zhu3 = inv[i];}
                            if(inv[i]->query("name") == "凝碧剑") {dzhu = 1; zhu4 = inv[i];}
                            if(inv[i]->query("name") == "[1;34m玄铁剑[2;37;0m") {ezhu = 1; zhu5 = inv[i];}
		}
if( azhu && bzhu && czhu && dzhu && ezhu )
{
	 destruct(zhu1);
        destruct(zhu2);
             destruct(zhu3);
             destruct(zhu4);
             destruct(zhu5);
	jade = new("/questobj/obj/mengzhuling");
	jade->move(me);
message_vision("$N经过万分辛苦终于找齐所需要的兵器了，满心欢喜按照秘录打造起盟主
令，经过一番敲敲打打，一把似模似样的盟主令出炉了。\n",this_player());
	destruct(this_object());

}
else 
message_vision("$N真想练制一把盟主令，但是手中材料都不足够，怎么练制呀，真是倒到家了。\n",this_player());

return 1;
}
