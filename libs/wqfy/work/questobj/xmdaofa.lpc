#include <ansi.h>
inherit ITEM;
void create()
{
    set_name(HIG"降魔道法"NOR, ({ "xmdaofa" }) );
    set_weight(1);
    if( clonep() )
            set_default_object(__FILE__);
    else {
            set("unit", "本");
            set("material", "stone");
            set("long", "一本三清宫的降魔道法，上面写着奇怪的符文，相传它除了能降魔
除妖外，还能与其他样东西做(zuo)出一本天书。\n");
          }

    setup();
}
void init()
{
  if(this_player()==environment())
  add_action("do_zuo","zuo");
}

int do_zuo()
{
int i,azhu=0,bzhu=0,czhu=0,dzhu=0;
object jade,me, *inv;
object zhu1,zhu2,zhu3,zhu4;
me = this_player();
inv = all_inventory(me);
                for(i=0; i<sizeof(inv); i++)
                {
		   if(inv[i]->query("name") == "[1;37m无字天书[2;37;0m") {azhu = 1; zhu1 = inv[i];}
                 if(inv[i]->query("name") == "[1;34m太极八卦道袍[2;37;0m") {bzhu = 1; zhu2 = inv[i];}
                 if(inv[i]->query("name") == "[1;32m镇魂幡[2;37;0m") {czhu = 1; zhu3 = inv[i];}
                 if(inv[i]->query("name") == "[1;34m生死簿[2;37;0m") {dzhu = 1; zhu4 = inv[i];}


		}
if( azhu && bzhu && czhu && dzhu )
{
	destruct(zhu1);
       destruct(zhu2);
       destruct(zhu3);
       destruct(zhu4);
	jade = new("/questobj/obj/tianbook");
	jade->move(me);
message_vision("$N口中念念有词，按着降魔道法的符文念了几次，眼前的几件东西
发出一阵青光，跟着冒出一股青烟笼罩了周围，青烟散去后，一本书出现在面前。\n",this_player());
	destruct(this_object());

}
else 
message_vision("$N按着符文念了好几次，却什么事也没发生。\n",this_player());

return 1;
}