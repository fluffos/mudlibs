inherit NPC;
#include <ansi.h>
inherit F_MASTER;
void create() {
  set_name(HIC "萧咪咪" NOR, ({ "xiaomimi" }));
  set("no_arrest", 1);
  set("gender", "女性");
  set("age", 26);
  set("long",
    "    这人满面媚笑,浑身上下充满了迷死男人的妖冶之气。\n");
  set("attitude", "peaceful");
  set("skill_public", 1);
  set("str", 40);
  set("per", 80);
  set("cor", 30);
  set("int", 24);
  set("cps", 30);
  set("chat_chance", 1);
  set("chat_msg", ({
    "萧咪咪纽动腰肢,嗲声嗲气的娇哼道:宝贝...来呀．．．．\n",
  }));

  set("force", 40000);
  set("max_force", 8000);
  set("force_factor", 100);

  set("combat_exp", 1800000);
  set("score", -50000);

  set_skill("move", 120);
  set_skill("parry", 100);
  set_skill("dodge", 120);
  set_skill("whip", 100);
  set_skill("force", 150);
  set_skill("iron-cloth", 120);
  set_skill("jin-gang", 130);
  set_skill("snowwhip", 90);
  map_skill("iron-cloth", "jin-gang");
  map_skill("whip", "snowwhip");
  map_skill("parry", "snowwhip");

  create_family("eren", 1, "十一师傅");
  set("title", "迷死人不赔命" NOR);
  setup();
  carry_object("/tongji/obj/piaodai")->wield();

}
