
inherit NPC;

void create()
{
        set_name("大绵羊", ({ "sheep" }) );
        set("race", "野兽");
        set("age", 5);
        set("long", "一只全身雪白的的绵羊。\n");
set_temp("kf_tufei",113);
        set("pursuer", 1);

        set("limbs", ({ "头部", "身体", "尾巴" }) );
        set("verbs", ({ "bite" }) );

        set("combat_exp", 25000);

        setup();
}

