//sku@00-11-25 
inherit ROOM;
void create()
{
	set("short", "北京南门");
	set("long", @LONG
北京南门，八丈高的城墙，厚三丈。城墙上弹痕累累
好象刚刚经历过战火的洗礼。进出城门的人熙熙攘攘。
LONG
	);
	set("exits", ([ 
              "north" : __DIR__"nanjie5",
              "south" : __DIR__"lu1",
              "west"  : __DIR__"room",
              ]));
        set("objects", ([
                __DIR__"npc/yulinjun" : 2,
               ]) );
	set("outdoors", "beijing");
	set("coor/x",-1090);
	set("coor/y",1000);
	set("coor/z",0);
	setup();
}
void zheng_notify()
{
object me,ob;
me = this_player();
if(ob = present("yu lin jun",this_object()))
{
message_vision("$N看了看通行证，又用警惕的眼神上下打量了$n一眼。对$n挥挥手说道：进去吧！\n",ob,me);
me->set_temp("okey_go_level4",1);

}
return;
}

int valid_leave(object me,string dir)
{
        object ob;
if(userp(me) && dir == "north" && ob=present("yu lin jun",this_object()))
{
if(me->query_temp("okey_go_level4")) {
me->delete_temp("okey_go_level4");
return 1;
}
else
{
message_vision("$N对$n道：外乡人不得入内！\n",ob,me);
return notify_fail("");
}
}
me->delete_temp("okey_go_level4");
return 1;
}
