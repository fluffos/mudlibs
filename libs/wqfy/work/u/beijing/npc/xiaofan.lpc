//sku@00-11-25 
inherit NPC;
inherit F_VENDOR;

void create()
{
        set_name("小贩", ({ "waiter" }) );
        set("gender", "男性" );
        set("age", 22);
        set("long",
                "这是个做小买卖的人，靠贩卖杂货为生。\n");
        set("combat_exp", 80);
        set("attitude", "friendly");
        set("rank_info/respect", "小贩");
        set("vendor_goods", ([
                __DIR__ "obj/yao" : random(10)+1,
                __DIR__ "obj/fengche" : random(2)+1,
//                __DIR__ "npc/obj/" : random(10)+1,
                              ]) );
        setup();
}

void init()
{       
        object ob;

        ::init();
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
        }
        add_action("do_vendor_list", "list");
}

void greeting(object ob)
{
        if( !ob || environment(ob) != environment() ) return;
        switch( random(3) ) {
                case 0:
                        say( "小贩笑咪咪地说道：这位" + RANK_D->query_respect(ob)
                                + "，您进城吗？\n");
                        break;
                case 1:
                        say( "小贩说道：这位" + RANK_D->query_respect(ob)
                                + "，您不看看我的货？包您满意！\n");
                        break;
                case 2:
                        say( "小贩说道：城里的包大人真是公正廉洁，不然我的小命就不保了。\n");
                        break;
        }
}
