//sku@00-11-25 
inherit NPC;
inherit F_VENDOR;
void create()
{
        set_name("门官", ({ "menguan" }) );
        set("gender", "男性" );
        set("age", 22);
        set("long",
                "北京南门的门官。\n");
        set("combat_exp", 80);
        set("attitude", "friendly");
        set("rank_info/respect", "门官");
        set("vendor_goods", ([
                 __DIR__ "obj/zheng" : random(2)+1,

                              ]) );
        set("inquiry", ([
"进城": "进城你要先买通行证。\n",
        ]) );

        setup();
}

void init()
{       
        object ob;

        ::init();
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
        }
        add_action("do_vendor_list", "list");
}

void greeting(object ob)
{
        if( !ob || environment(ob) != environment() ) return;
        switch( random(2) ) {
                case 0:
                        say( "门官说道：这位" + RANK_D->query_respect(ob)
                                + "，想进城吗？\n");
                        break;
                case 1:
                        say( "门官说道：这位" + RANK_D->query_respect(ob)
                                + "，想进城就买通行证。\n");
                        break;

        }
}
