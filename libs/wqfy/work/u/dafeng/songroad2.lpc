#include <room.h>

inherit ROOM;
void create() {
  set("short", "听松坪");
  set("long", @LONG
穿过小径，风没了。你眼前豁然一亮，是一个片大草坪。
草坪的尽头好象有一座江南风格的小庭院，白墙、青瓦。
LONG
  );
  set("exits", ([ /* sizeof() == 4 */
    "south": __DIR__ "songroad1",
    "north": __DIR__ "sroad",
    "west": __DIR__ "grass2",
    "east": __DIR__ "grass3",
  ]));

  set("coor/x", 10);
  set("coor/y", 20);
  set("coor/z", 0);
  setup();

}
