void create()
{
        set("short", "听松小径");
        set("long", @LONG
小径两边是无边的松林，数百万年的落叶松林地上形成了厚厚的松针，即使
人踩上去软软的，不会出什么声音。松间惠风和畅，所以路边的石头上好象
用刀剑之类的工具写着苍劲的两排字：
                听    松
                                □□风□题.
LONG
        );
        set("exits", ([ /* sizeof() == 4 */
  "north" : __DIR__"door",
  "south" : __DIR__"songroad2",
]));
        set("outdoors", "dafeng");
        set("coor/x",140);
	set("coor/y",-400);
	set("coor/z",30);
	setup();
       create_door("north", "木门", "south", );


}
int valid_leave(object me, string dir)
{
	if(dir == "north"){
	if( me->query_temp("played_muqin"))
		return 1;		
	else
	return notify_fail("一阵大风吹来，空气像一堵墙挡在你面前，让你无法前行。\n");
      
      
	}
	return 1;
}

