
inherit ROOM;

void create()
{
	set("short", "草坪");
	set("long", @LONG
一望无际的草坪。不知名的各色野花挥舞小拳头，一派生机勃勃的景象。
你自己又何尝不是一朵无名的小花，默默地在泥巴中奉献自己的青春。
想到这里你才体验到生命的无谓，心中怅然若失。
LONG
	);
	set("exits", ([
		"north" : __DIR__"grass4",
		"south" : __DIR__"grass6",
		"west" : __DIR__"songroad1",
		"east" : __DIR__"grass4",
	]));
	set("objects", ([
		__DIR__"npc/roadman2" : 1,
	]));
	set("outdoors", "dafeng");
	set("coor/x",115);
	set("coor/y",-70);
	set("coor/z",0);
	setup();
replace_program(ROOM);

}
