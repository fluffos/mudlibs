// cloth.c
//

#include <armor.h>

inherit CLOTH;
#include <ansi.h>
void create()
{
	set_name(HIG "大风袍" NOR, ({ "windcloth" }) );
	set_weight(3000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "领");
		set("long", "这是件昂贵的绿袍，据说带起的风能引偏暗器。\n");
		set("value", 80000);
		set("material", "cloth");
		set("armor_prop/armor", 50);
	}
	setup();
}
