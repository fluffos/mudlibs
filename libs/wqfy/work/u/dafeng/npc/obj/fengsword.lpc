// TIE@FY3
#include <weapon.h>
#include <ansi.h>
inherit SWORD;
void create() {
  set_name(HIG "快哉剑" NOR, ({ "kuaisword" }));
  set_weight(10000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "柄");
    set("long", "这是早已失传的古剑，据传是上古的神兵利器。\n");
    set("value", 500000);
    set("rigidity", 2800);
    set("material", "steel");
    set("max_enchant", 10);
    set("for_create_weapon", 1);
  }
  init_sword(120);
  setup();
}
