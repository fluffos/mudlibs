// roadman2.c

inherit NPC;

void create() {
  set_name("无所事事的人", ({ "meaninglessman" }));
  set("gender", "男性");
  set("age", 47);
  set("long", "这个人面带怡然之色，不知老之将至。\n");
  set("combat_exp", 600000);
  set("str", 27);
  set("force", 500);
  set("max_force", 300);
  set("force_factor", 150);
  setup();
  set("chat_chance", 2);
  set("chat_msg", ({
    "无所事事的人吟道：“无言独上西楼，月如钩。”\n",
    "无所事事的人的嘴里嘟哝著，不知道说些什麽。\n",
    "无所事事的人伸手从地上摘了朵野花，放在鼻下闻了闻。 \n",
  }));
  add_money("gold", 2);
}

int accept_fight(object me) {
  command("say " + RANK_D->query_respect(me) + "大侠饶命！生命诚可贵！\n");
  return 0;
}
