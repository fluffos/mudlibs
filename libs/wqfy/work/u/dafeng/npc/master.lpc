// dafeng-master.c

inherit NPC;
inherit F_MASTER;
#include <ansi.h>
void create() {
  set_name("赵无忌", ({ "master zhao", "master", "wuji" }));
  set("nickname", HIG "大风堂少主" NOR);
  set("gender", "男性");
  set("age", 30);
  set("str", 49);
  set("cor", 49);
  set("cps", 50);
  set("int", 49);
  set("apprentice_available", 1);
  set("per", 50);
  set("agi", 50);
  set("chat_chance_combat", 90);
  set("chat_msg_combat", ({
    (: perform_action, "sword.tianwaifeixian" :),
    (: perform_action, "dodge.tianwaifeixian" :),
  }));
  set("attitude", "friendly");
  set("max_force", 15000);
  set("force", 15000);
  set("force_factor", 30);
  set("max_kee", 99999999);
  set("max_gin", 99999999);
  set("max_sen", 999999);
  set("eff_kee", 999999);
  set("kee", 9999999);
  set("chat_chance", 1);
  set("chat_msg", ({
    "无忌从怀里摸出一个白玉老虎，陷入沉思。\n",
  }));

  set("long",
    "
他受命于大风堂危难之际，几经波折成为令人尊敬的少主！
但是，唐门暗器之厉害，仍然是他心中的隐痛．．．
\n"
  );
  create_family("大风堂", 2, "少主人");

  set("combat_exp", 100000000);
  set("score", 200000);

  set_skill("move", 100);
  set_skill("xiaodao", 350);
  set_skill("parry", 100);
  set_skill("dodge", 220);
  set_skill("force", 40);
  set_skill("literate", 160);
  set_skill("sword", 120);
  set_skill("unarmed", 100);
  set_skill("throwing", 150);
  set_skill("jingang-quan", 100);
  set_skill("feixian-sword", 150);
  set_skill("unarmed", 80);
  map_skill("unarmed", "jingang-quan");
  map_skill("dodge", "feixian-steps");
  map_skill("sword", "feixian-sword");
  map_skill("force", "xiaodao");
  map_skill("parry", "feixian-sword");


  setup();
  carry_object(__DIR__ "obj/fengcloth")->wear();

}

void attempt_apprentice(object ob) {
  if (query("apprentice_available")) {
    if (find_call_out("do_recruit") != -1)
      command("say 慢著，让我看仔细了。");
    else
      call_out("do_recruit", 2, ob);
  } else {
    command("say 今天这么多人投奔大风堂，其中必有蹊跷。");
  }
}

void do_recruit(object ob) {
  int age;
  age = (int)ob->query("age");
  if ((string)ob->query("gender") != "男性")
    command("say 承蒙看得起敝帮。不过，大风堂里全是浪子，女侠何必以身犯险呢。");
  else if (age >= 30)
    command("say 在下少不更事，这怎么敢当！");
  else if (ob->query_temp("marks/tang")) {
    ob->set("class", "swordsman");
    command("say 看在你不惧生死，见义勇为的份上，我就收你为徒吧！\n");
    command("say 阿弥陀佛，善哉！善哉！");
    command("recruit " + ob->query("id"));
  }
}

int recruit_apprentice(object ob) {
  if (::recruit_apprentice(ob)) {
    add("apprentice_availavble", -1);
    return 1;
  }
}

void re_rank(object student) {
  int exp;
  exp = (int)student->query("combat_exp");
  if (exp <= 32000) {
    student->set("title", "大风堂  小浪子");
    return;
  } else if (exp <= 128000) {
    student->set("title", "大风堂  小剑侠");
    return;
  } else if (exp <= 512000) {
    student->set("title", "大风堂  剑侠");
    return;
  } else if (exp <= 1536000) {
    student->set("title", "大风堂  大剑侠");
    return;
  } else if (exp <= 3456000) {
    student->set("title", "大风堂  剑客");
    return;
  } else if (exp <= 5187000) {
    student->set("title", "大风堂  大剑客");
    return;
  } else if (exp <= 26244000) {
    student->set("title", "大风堂  神剑");
    return;
  } else
    student->set("title", "大风堂  第三代少主");
  return;

}
