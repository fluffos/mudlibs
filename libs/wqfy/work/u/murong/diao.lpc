#include <ansi.h>

inherit NPC;

int do_ride(string);


void create() {
  set_name("白雕", ({ "diao" }));
  set("race", "野兽");
  set("age", 4);
  set("long", "一只凤凰正展翅欲飞,是一休的座骑，\n"
    "骑上就可以往来天地之间。\n");
  set("attitude", "peaceful");

  set("str", 26);
  set("cor", 30);
  set("no_get", "啊!你不可能把它背起来的。\n");

  set("limbs", ({ "头部", "身体", "爪子", "翅膀", "尾巴" }));
  set("verbs", ({ "bite", "claw" }));

  set("combat_exp", 200000);

  set_temp("apply/attack", 15);
  set_temp("apply/damage", 6);
  set_temp("apply/armor", 2);

  setup();
}

void die() {
  object ob;
  message_vision("$N扑腾几下翅膀，哀嗥了一声，死了！\n", this_object());
  destruct(this_object());

}

void init() {
  add_action("do_ride", "qi");
}

int do_ride(string arg) {
  mapping myfam;
  object room;
  object ob = this_player();
  if (!id(arg) || ob->query_temp("has_qi")) return 0;
  myfam = (mapping)ob->query("family");
  if (!myfam || myfam["family_name"] != "权力帮") {
    message_vision("$N一跃身跨上了凤凰。只见凤凰仰天长唳，突然猛然一颠......\n"
      HIR "结果$N摔了个鼻青脸肿！\n" NOR
      "看来凤凰不愿让$N骑，它只认识一休。\n", ob);
    ob->receive_damage("kee", 150);
    ob->receive_wound("kee", 150) return 1;
  }
  message_vision("$N一跃身跨上了凤凰。只见凤凰仰天长唳，突然展翅高飞。\n", ob);
  message("vision", "但看一雕一人身形渐渐缩小，终至不见。\n\n", environment(), ob);
  if (!(room = find_object("/d/fy/fysquare")))

    room = load_object("/d/fy/fysquare"); ;

  if (environment() == room) set_temp("fysquare", 1);
  else delete_temp("fysquare");
  ob->set_temp("has_qi", 1);
  move(__DIR__ "lantian");
  ob->move(__DIR__ "lantian");
  tell_object(ob, CYN "\n你不断地飞呀飞，万水千山身下飘过 ......\n\n" NOR);
  if (query_temp("fysquare")) {
    call_out("taohua", 3, ob);
    return 1;
  }
  call_out("dayuan", 3, ob);
  return 1;
}
void taohua(object ob) {
  tell_object(ob, "你终于飞到了桃花山庄，白雕落了下来。\n\n");
  this_object()->move(__DIR__ "damen");
  ob->move(__DIR__ "damen");
  message("vision", "一只白雕飞落在山庄门口，" + ob->query("name") + "从雕背上爬了下来。\n", environment(), ob);
  ob->delete_temp("has_qi");
}


void dayuan(object ob) {
  tell_object(ob, "你终于飞到了中原，白雕落了下来。\n\n");
  move(__DIR__ "dayuan");
  ob->move(__DIR__ "dayuan");
  message("vision", "一只白雕飞落在院子里，" + ob->query("name") + "从雕背上爬了下来。\n", environment(), ob);
  ob->delete_temp("has_qi");
}
