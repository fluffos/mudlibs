// waiter.c

inherit NPC;
inherit F_VENDOR;

void create()
{
	set_name("驼背老人", ({ "oldman", "man" }) );
	set("gender", "男性" );
	set("age", 52);
	set("long",
		"这位驼背老人望著炉火呆呆的出神。\n");
	        	                  set_temp("kf_tufei",199);
        set("pursuer", 1);
set("combat_exp", 5);
	set("vendor_goods", ([
		__DIR__"obj/liandao.lpc":10,
		__DIR__"obj/axe.lpc":10,
		__DIR__"obj/dingpa.lpc":10,
		__DIR__"obj/basket.lpc":10,
		__DIR__"obj/hammer.lpc":10,
		__DIR__"obj/chutou.lpc":10,
	]) );
	setup();
}

void init()
{	
	object ob;

	::init();
	add_action("do_vendor_list", "list");
}
