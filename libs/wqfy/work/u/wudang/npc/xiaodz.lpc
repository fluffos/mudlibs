  set("score", 20000);

  set("class", "taoist");

  set("str", 60);
  set("int", 60);
  set("cor", 60);
  set("cps", 60);
  set("spi", 60);

  set("force", 4000);
  set("max_force", 4000);
  set("force_factor", 100);

  set("atman", 400);
  set("max_atman", 400);

  set("mana", 200);
  set("max_mana", 200);

