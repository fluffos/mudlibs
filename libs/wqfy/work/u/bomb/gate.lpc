#include <ansi.h>
inherit ROOM;

void create() {
  set("short", "霹雳堂正门");
  set("long", @LONG
黑色的围墙，黄色的大门。门上挂著一块金匾，上书“霹雳堂”
三个龙飞凤舞的大字。大门左右各卧著一只雄伟的石狮。奇怪的是
石狮的脚下踩的不是什么绣球，而是一个表面坑坑洼洼的黝黑的铁弹！
一名头戴黑色冠帽，身穿黑色布袍的知客弟子，靠门而立。
LONG
  );
  set("exits", ([
    "westdown": __DIR__ "road2",
    "enter": __DIR__ "ting",
  ]));
  set("objects", ([
    __DIR__ "npc/dizi0": 1,
  ]));
  set("outdoors", "bombtang");
  set("coor/x", 400);
  set("coor/y", 12010);
  set("coor/z", 200);
  setup();
}

int valid_leave(object me, string dir) {
  object *enemy, ob;
  int i;

  if (userp(me) && (ob = present("bomb dizi", this_object()))) {
    enemy = ob->query_enemy();
    i = sizeof(enemy);
    while (i--) {
      if (enemy[i] == me)
        return notify_fail(HIY + ob->name() + "对" + me->name()
          + "喝道：想跑？没那么容易！\n" + HIR + ob->name() +
          "把" + me->name() + "挡了回来！\n" + NOR);
    }
  }
  return 1;
}
