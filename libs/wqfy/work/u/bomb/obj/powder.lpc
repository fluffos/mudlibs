// pearl.c

#include <weapon.h>

inherit THROWING;

void create() {
  set_name("火药", ({ "powder", "huoyao" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一把黑色的火药。\n");
    set("unit", "把");
    set("base_unit", "粒");
    set("base_weight", 4);
    set("base_value", 1);
  }
  set_amount(10);
  setup();
}
