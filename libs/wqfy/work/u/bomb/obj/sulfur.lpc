// pearl.c

#include <weapon.h>
inherit THROWING;


void create()
{
	set_name("硫磺", ({ "sulfur", "liuhuang" }) );
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long",	"一块金黄色的硫磺矿石。用它和硝石、木炭
以一定比例机械搅拌（ｍｉｘ），就得到了黑火药。\n");
		set("unit", "块");
		set("base_unit", "粒");
		set("base_weight", 4);
		set("base_value", 1);
	}
	set_amount(50);
	setup();
}

void init()
{
  if(this_player()==environment())
  add_action("do_combine","mix");
}

int do_combine()
{
int i,mt=0,xs=0,lh=0,num=0,sj=0,pskill;
object powder,me, *inv;
object mtbi,lhbi,xsbi,sjbi;
me = this_player();
inv = all_inventory(me);
                for(i=0; i<sizeof(inv); i++)
                {
			if(inv[i]->query("name") == "木炭") {mtbi = inv[i];mt = (int)mtbi->query_amount(); }
                        if(inv[i]->query("name") == "硫磺") {lhbi = inv[i];lh = (int)lhbi->query_amount()/2; }
                        if(inv[i]->query("name") == "硝石") {xsbi = inv[i];xs = (int)xsbi->query_amount()/2; }
                        if(inv[i]->query("name") == "石臼") {sjbi = inv[i];sj = 1; }
		}
if( mt && xs && lh && sj)
{
	num=lh;
	if(mt<lh)num=mt;
	if(xs<num)num=xs;
	mtbi->set_amount((mt-num));
	xsbi->set_amount((xs-num)*2);
	lhbi->set_amount((lh-num)*2);
message_vision("$N把手里的木炭、硫磺和硝石按比例放入石臼里，小心地混合研磨．\n",this_player());
	
	pskill = (int)this_player()->query_skill("powderskill");
	if(pskill<random(20))
	return notify_fail("你的火药术太差了，结果什么都没研磨出来。\n");	

	powder = new(__DIR__"powder");
	powder->set_amount(num);
	powder->move(me);
message_vision("$N把石臼里研磨好的火药倒了出来。\n",this_player());
	if(!this_player()->query("m_success/火药"))
        {
                this_player()->set("m_success/火药",1);
                this_player()->add("score",200);

        }

}
else {
message_vision("$N把手里的硫磺研碎，弄得满手金黄，气味刺鼻。\n",this_player());
	destruct(this_object());
	}

return 1;
}

