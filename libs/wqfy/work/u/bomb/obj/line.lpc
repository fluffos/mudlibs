// pearl.c

#include <weapon.h>
inherit THROWING;


void create()
{
	set_name("引线", ({ "line", "引线" ,"xian" }) );
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long",	"一捆用来做导火索的引线。\n");
		set("unit", "捆");
		set("base_unit", "根");
		set("base_weight", 4);
		set("base_value", 1);
        set("no_shown", 1);
	}
	set_amount(20);
	setup();
}
