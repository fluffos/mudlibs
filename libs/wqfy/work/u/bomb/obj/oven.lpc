inherit ITEM;

void create()
{
        set_name("铜炉", ({ "tong lu", "oven", "铜炉"}) );
        set_weight(5000);
        set_max_encumbrance(8000);
        set("no_get", 1);
        if( clonep() )
                set_default_object(__FILE__);
        else {
		set("prep", "on");
                set("unit", "鼎");
                set("long", "青铜铸成的炼钢炉。\n");
                set("value", 1);
        }
}

int is_container() { return 1; }

