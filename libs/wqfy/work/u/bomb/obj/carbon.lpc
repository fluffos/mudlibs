// pearl.c

#include <weapon.h>
inherit THROWING;


void create()
{
	set_name("木炭", ({ "carbon", "mutan" }) );
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long",	"一块漆黑的木炭。\n");
		set("unit", "块");
		set("base_unit", "片");
		set("base_weight", 40);
		set("base_value", 1);
        set("no_shown", 1);

	}
	set_amount(50);
	setup();
}
