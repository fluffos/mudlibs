// pearl.c

#include <weapon.h>
inherit THROWING;


void create()
{
	set_name("硝石", ({ "saltpeter", "硝石" ,"xiaoshi" }) );
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long",	"一块雪白的硝石矿。\n");
		set("unit", "块");
		set("base_unit", "粒");
		set("base_weight", 4);
		set("base_value", 1);
	}
	set_amount(50);
	setup();
}
