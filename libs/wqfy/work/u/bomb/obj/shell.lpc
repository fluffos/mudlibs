inherit ITEM;

void create() {
  set_name("霹雳外壳", ({ "shell", "外壳" }));
  set_weight(100 + random(50));
  set_max_encumbrance(800);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
    set("long", "一个用来制造霹雳弹的精钢外壳。\n");
    set("value", 1);
    set("material", "steel");
  }
}

int is_container() { return 1; }

void init() {
  if (this_player() == environment())
    add_action("do_combine", "make");
}

int do_combine() {
  int i, line = 0, powder = 0, shell = 0, level = 0, bskill, pskill;
  object bomb, me, *inv;
  object linebi, shellbi, powderbi;
  me = this_player();
  inv = all_inventory(me);
  for (i = 0; i < sizeof(inv); i++) {
    if (inv[i]->query("name") == "火药") {
      powderbi = inv[i]; powder = (int)powderbi->query_amount();
    }
    if (inv[i]->query("name") == "引线") { linebi = inv[i]; line = (int)linebi->query_amount(); }
  }
  if (line && powder > 40) {
    linebi->set_amount((line - 1));
    powderbi->set_amount(powder - 40);
    message_vision("$N把火药、引线放入霹雳外壳里，小心翼翼地想做一枚霹雳雷火弹。\n", this_player());

    pskill = (int)this_player()->query_skill("powderskill");
    bskill = (int)this_player()->query_skill("bombskill");
    if ((pskill + bskill) < random(40))
      return notify_fail("你的霹雳术、火药术太差了，差点炸死自己！\n");

    level = (pskill + bskill) / 40;    //除数大，威力小；除数小，威力大。
    if (level < 1) level = 1;
    bomb = new(__DIR__ "bomb0");
    bomb->set("level", level);
    bomb->move(me);
    message_vision("$N终于做好了一枚霹雳雷火弹。\n", this_player());
    me->start_busy(3);
    if (!this_player()->query("m_success/霹雳")) {
      this_player()->set("m_success/霹雳", 1);
      this_player()->add("score", 200);

    }
    destruct(this_object());

  } else {
    message_vision("$N把手里的霹雳外壳把玩了一会。\n", this_player());
  }

  return 1;
}
