inherit ROOM;
void create() {
  set("short", "后山角");
  set("long", @LONG
这里是霹雳堂的后山山角，山石黝黑，山石间杂着点点金黄的矿物，应该就是
硫磺矿了，硫磺可是制造火药的原料啊。霹雳堂建在此地，自然是有他的道理
的。
LONG
  );
  set("exits", ([ /* sizeof() == 4 */
    "southwest": __DIR__ "broad3",
  ]));
  set("outdoors", "bombtang");
  set("item_desc", ([
    "硫磺": "
你似乎可以挖（ｄｉｇ）一些出来。
                        \n",

  ]));
  set("coor/x", 1200);
  set("coor/y", 12090);
  set("coor/z", 250);
  setup();
}
void init() {
  add_action("do_chop", "dig");
}
do_chop() {
  object vege;
  if ((int)query("pulled") <= 20) {
    write("你挖了一块硫磺矿石放在怀里。\n");
    vege = new(__DIR__ "obj/sulfur");
    vege->move(this_player());
    add("pulled", 1);
    return 1;
  } else
    write("都被人挖光了！！\n");
  return 1;
}

void reset() {
  ::reset();
  delete("pulled");
}
