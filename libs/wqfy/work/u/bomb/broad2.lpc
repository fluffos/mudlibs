#include <ansi.h>
inherit ROOM;

void create() {
  set("short", "霹雳炼房前廊");
  set("long", @LONG
青石小路穿过了两边的黑碳堆，到这里为止。一个小小的方形门立在此处。
门上的墙壁上刻著“炼房”两个字。门旁挂著一块木牌，上写“非霹雳堂
弟子，请勿擅入！”
LONG
  );
  set("exits", ([
    "enter": __DIR__ "room",
    "west": __DIR__ "broad1",
  ]));
  set("outdoors", "bombtang");
  set("coor/x", 750);
  set("coor/y", 12010);
  set("coor/z", 200);
  setup();
}

int valid_leave(object me, string dir) {
  int i;
  object *inv, ro;
  if (dir != "enter") return 1;

  if ((string)me->query("family/family_name") == "霹雳堂") return 1;
  if (me->query_temp("bombgo")) {
    me->delete_temp("bombgo");
    return 1;
  }
  message_vision(HIY "你听到地下「喀」地一声轻响。\n" NOR, me);
  message_vision(HIR "$N并没在意，抬起脚继续向前走，接著「轰！」地一声巨响，原来$N踩到了霹雳堂的地火弹！\n$N被炸得直飞到三丈高的空中！\n" NOR, me);
  me->unconcious();
  message_vision(HIY "两个霹雳堂弟子把$N身上所有的东西搜了一遍。\n\n" NOR, me);
  inv = all_inventory(me);
  for (i = 0; i < sizeof(inv); i++) {
    destruct(inv[i]);
  }
  message_vision(HIY "两个霹雳堂弟子把$N抬了出去。\n" NOR, me);
  ro = find_object(__DIR__ "road1");
  //	me->delete_temp("bombgo");
  if (!objectp(ro)) load_object(__DIR__ "road1");
  me->move(ro);
  message("vision", HIY "两个霹雳堂弟子把" + me->name() + "重重地摔在了地上，然后转身离开了。\n" NOR, environment(me));
  return 0;
}
