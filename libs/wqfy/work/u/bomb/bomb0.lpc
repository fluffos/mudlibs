#include <ansi.h>  
#include <combat.h>
inherit ITEM;
void create()
{
        set_name( RED "霹雳雷火弹" NOR, ({ "bomb","pilidan" }) );
        set_weight(150);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "枚");
                set("long","这是一枚霹雳堂的镇堂之宝----霹雳弹。圆滚滚，黑黝黝，表面坑坑洼洼的。\n");
                set("material", "steel");
                set("level",12);
        }
        setup();
}
void init()
{
	add_action("do_shoot","bomb");
}
int do_shoot(string arg)
{
	object ob;
	object me;
	int dp,lvl,level,i;
	int damage;
	if (!arg) return notify_fail("你要炸谁？\n");
	me=this_player();
    if( environment(me)->query("no_fight") ||
        environment(me)->query("no_magic") ||
        environment(me)->query("no_spells") 
	)
	return notify_fail("在这不可偷袭！\n");
    ob=present(arg,environment(me));
    if (!objectp(ob) || !living(ob)) return notify_fail(this_object()->name()+"只能对活的生物使用。\n");
    if (!me->is_fighting(ob)) message_vision("$N浅浅一笑，从怀里摸出一枚黑球．．\n",me);
    message_vision("$N对着$n拔掉了手中的"+this_object()->name()+"引线，扔了出去...\n",me,ob);
    message_vision(RED "『轰．．．...』一声巨响！！！！！！！\n" NOR,me);
    message_vision("霹雳雷火弹打在$N身上，把$N炸得血肉横飞。\n",ob);
    ob->receive_damage("kee", 0, me);
    dp=COMBAT_D->skill_power(ob,"dodge",SKILL_USAGE_DEFENSE);
//       lvl=(int)this_object()->query("level");
	level = (me->query_skill("poderskill",1) + me->query_skill("bombskill",1))/40
//	for(i=1;i<=lvl;i++)level+=i;
    damage=30000*level-dp;
    damage/=100;
    if (damage<0) damage=0;
    ob->receive_wound("kee",damage,me);    
    COMBAT_D->report_status(ob);                                         
    ob->kill_ob(me); 
	destruct(this_object());
    me->start_busy(3);
    return 1;
}
