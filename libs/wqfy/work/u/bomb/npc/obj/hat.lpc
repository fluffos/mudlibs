// hat.c

inherit EQUIP;

void create() {
  set_name("黑色冠帽", ({ "hat" }));
  set_weight(300);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "顶");
    set("value", 100);
    set("long", "一顶黑色冠帽\n");
    set("material", "cloth");
    set("armor_type", "head");
    set("armor_prop/armor", 6);
  }
}
