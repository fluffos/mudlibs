
#include <weapon.h>
#include <ansi.h>
inherit SPEAR;

void create()
{
	set_name( HIR "红缨" NOR + "枪" NOR, ({ "redspear" }) );
	set_weight(3000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "把");
		set("long", "这是一把相当普通的长枪，份量不怎么轻。\n");
		set("value", 1000);
		set("material", "steel");
		set("wield_msg", "$N「唰」地一声把$n握在手中。\n");
		set("unwield_msg", "$N将手中的$n插入地下。\n");
	}
	init_spear(25);
	setup();
}
