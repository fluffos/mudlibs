#include <ansi.h>
inherit NPC;

void create() {
  set_name("知客弟子", ({ "bomb dizi", "dizi" }));
  set("gender", "男性");
  set("long",
    "霹雳堂知客弟子，身着黑色布袍、头戴黑色冠帽。\n"
  );
  set("combat_exp", random(40000));
  set("score", 200);
  set("class", "bombtang");
  set("force", random(800));
  set("max_force", random(800));
  set("vendetta_mark", "bombkiller");
  create_family("霹雳堂", 8, "弟子");

  set_skill("move", 80 + random(50));
  set_skill("force", 80 + random(50));
  set_skill("unarmed", 80 + random(50));
  set_skill("dodge", 80 + random(50));
  set_skill("spear", 80 + random(50));
  set_skill("duanhun-spear", 80 + random(50));
  map_skill("spear", "duanhun-spear");

  setup();

  add_money("silver", 5);
  carry_object(__DIR__ "obj/cloth1")->wear();
  carry_object(__DIR__ "obj/hat")->wear();
  carry_object(__DIR__ "obj/spear0")->wield();

}


int accept_fight(object me) {
  if ((string)me->query("family/family_name") == "霹雳堂") {
    command("nod");
    command("say 进招吧。");
    return 1;
  }
  command("say 霹雳堂的弟子不准和别派的人过招。");
  return 0;
}
