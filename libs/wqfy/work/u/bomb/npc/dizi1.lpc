inherit NPC;
int give_qin();
void create() {
  set_name("弟子", ({ "dizi" }));
  set("gender", "男性");
  set("long",
    "霹雳堂弟子，着一身黑色的布袍\n"
  );
  set("combat_exp", random(20000));
  set("score", 200);
  set("class", "bombtang");
  set("force", random(300));
  set("max_force", random(300));
  set("vendetta_mark", "bombkiller");

  create_family("霹雳堂", 7, "弟子");

  set_skill("move", 10 + random(80));
  set_skill("force", 10 + random(80));
  set_skill("unarmed", 10 + random(80));
  set_skill("parry", 10 + random(80));
  set_skill("dodge", 10 + random(80));
  set_skill("dachengforce", 10 + random(50));
  set_skill("spear", 10 + random(80));
  set_skill("duanhun-spear", 10 + random(80));
  map_skill("spear", "duanhun-spear");

  map_skill("force", "dachengforce");
  set("inquiry", ([
    "石臼": (: give_qin :),
    "stonevase": (: give_qin :),
  ]));

  setup();

  add_money("silver", 5);
  carry_object(__DIR__ "obj/cloth1")->wear();
  carry_object(__DIR__ "obj/spear0")->wield();

}

int accept_fight(object me) {
  if ((string)me->query("family/family_name") == "霹雳堂") {
    command("nod");
    command("say 进招吧。");
    return 1;
  }
  command("say 堂主不准弟子和别派的人过招。");
  return 0;
}

int give_qin() {
  object obj;
  if (!query("given")) {
    command("say 这石臼你先拿去用吧！！\n");
    obj = new(__DIR__ "obj/vase");
    obj->move(this_player());
    set("given", 1);
  } else
    command("say 我的石臼已经给人了！\n");
  return 1;
}

void reset() {
  delete("given");
}
