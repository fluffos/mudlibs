#include <ansi.h>
inherit NPC;
inherit F_MASTER;
void create()
{
        set_name("雷震天", ({ "master lei", "master","lei" }) );
        set("long",
                "霹雳堂堂主，看起来四十开外，面色黝黑，双目如电。\n");
	set("nickname", RED"天轰地震"NOR);
        set("attitude", "heroism");
	set("student_title","弟子");
	create_family("霹雳堂",4,"堂主");
	set("vendetta_mark", "bombkiller");
             set("force_factor", 20);
        set("max_gin", 3000);
        set("max_kee", 3000);
        set("max_sen", 3000);
        set("eff_gin", 3000);
        set("eff_kee", 3000);
        set("eff_sen", 3000);
        set("gin", 3000);
        set("kee", 3000);
        set("sen", 3000);
        set("max_force", 3000);
        set("force", 3000);
	  set("str", 37);
        set("cor", 26);
        set("cps", 25);
	set("agi",25);
	set("int",30);
        set("chat_chance_combat", 50);
        set("chat_msg_combat", ({
                (: perform_action, "spear.suomengduanhun" :),
        }) );
        set("combat_exp", 20000000);
	set_temp("apply/damage",500);
        set_skill("unarmed", 100);
        set_skill("bombskill", 500);
        set_skill("powderskill", 460);
	set_skill("spear",130);
	set_skill("duanhun-spear",150);
	set_skill("force",150);
        set_skill("parry", 120);
        set_skill("dodge", 170);
	set_skill("changquan",200);
	set_skill("dachengforce",150);
        set_skill("move", 100);
	set_skill("literate",150);
	map_skill("spear","duanhun-spear");
	map_skill("force","dachengforce");
        setup();

        carry_object(__DIR__"obj/pao")->wear();
        carry_object(__DIR__"obj/spear")->wield();
}

void attempt_apprentice(object me)
{
	if( !me->query("class"))
	{
	command("smile");
	command("say 很好！霹雳堂正在广纳英才，好好努力吧！\n");
        command("recruit " + me->query("id") );
	}
	else
	command("say 霹雳堂不能收你这种来历不明之人！\n");
}

void recruit_apprentice(object ob)
{
        if( ::recruit_apprentice(ob) )
                ob->set("class", "bombtang");
		ob->set("vendetta_mark", "bombkiller");

}
void re_rank(object student)
{
        int exp;
        exp = (int) student->query("combat_exp");
        if( exp <= 32000 ) {
                student->set("title","霹雳堂弟子");
                return ;
        } else if ( exp <= 64000 ) {
                student->set("title","霹雳堂配药师");
                return ;
        } else if ( exp <= 128000 ) {
                student->set("title","霹雳堂技监师");
                return ;
        } else if ( exp <= 256000 ) {
                student->set("title","霹雳堂副香主");
                return ;
        } else if ( exp <= 512000 ) {
                student->set("title","霹雳堂香主");
                return ;
        } else if ( exp <= 1024000 ) {
                student->set("title","霹雳堂地震旗旗主");
                return ;
        } else if ( exp <= 1536000 ) {
                student->set("title","霹雳堂轰天旗旗主");
                return ;
        } else if ( exp <= 2304000 ) {
                student->set("title","霹雳堂三级镇堂护法");
                return ;
        } else if ( exp <= 3456000 ) {
                student->set("title","霹雳堂二级镇堂护法");
                return ;
        } else if ( exp <= 5187000 ) {
                student->set("title","霹雳堂镇堂护法");
                return ;
        } else if ( exp <= 11244000 ) {
                student->set("title","霹雳堂军师");
                return ;
        } else
                student->set("title","霹雳堂副堂主");
                return ;

}

int accept_object(object who, object ob)
{
                if( (int)ob->value() >= 1000000 ) {
                        say("雷震天呵呵的笑道：四海之内皆兄弟，请...\n");
                        who->set_temp("bombgo", 1);
                        return 1;
                } else {
                    say("雷震天说道：这钱你还是拿回去吧，霹雳堂倒也不缺这些！\n");
                        return 0;
                }
        return 0;
} 
