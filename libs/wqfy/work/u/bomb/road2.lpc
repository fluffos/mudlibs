inherit ROOM;

void create() {
  set("short", "上山路");
  set("long", @LONG
弯弯曲曲的山石路，却很平坦。左右两边光秃秃的，寸草不生。霹雳堂
越来越近了，一股股刺鼻的臭鸡蛋的气味扑面而来，叫人作呕。
不远的前方，就是霹雳堂的大门了。
LONG
  );
  set("exits", ([
    "eastup": __DIR__ "gate",
    "westdown": __DIR__ "road1",
  ]));
  set("outdoors", "bombtang");
  set("coor/x", 200);
  set("coor/y", 12010);
  set("coor/z", 150);
  setup();
  replace_program(ROOM);
