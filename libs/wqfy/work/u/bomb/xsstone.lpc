inherit ROOM;
void create()
{
        set("short", "后山角");
        set("long", @LONG
这里是霹雳堂的后山另一个山角，山石黝黑，山石间杂着点点雪白的矿物，应该就是
硝石矿了，硝石和硫磺都是制造火药的原料啊。霹雳堂依此山而建，自然是有他的道理
的。
LONG
        );
        set("exits", ([ /* sizeof() == 4 */
  "northwest" : __DIR__"broad3",
]));
        set("outdoors", "bombtang");
        set("item_desc", ([
                "硝石": "
你似乎可以挖（ｄｉｇ）一些出来。
                        \n",

        ]) );
        set("coor/x",1200);
	set("coor/y",11890);
	set("coor/z",250);
	setup();
}
void init()
{
	add_action("do_chop","dig");
}
do_chop()
{
object vege;
if((int) query("pulled") <= 20)
{
write("你挖了一块硝石放在怀里。\n");
vege = new(__DIR__"obj/xiao");
vege->move(this_player());
add("pulled",1);
return 1;
}
else
        write("都被人挖光了！！\n");
        return 1;
}

void reset()
{
:: reset();
delete("pulled");
}
