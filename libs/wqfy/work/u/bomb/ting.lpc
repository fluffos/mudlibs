inherit ROOM;

void create() {
  set("short", "轰天霹雳堂");
  set("long", @LONG
地板则是由白玉石铺成。殿顶由四根八丈高的红柱撑著，左右墙
上挂著几幅奇怪的图画，正面的墙上高高地挂著一块金匾，上书“轰天堂”
三字。匾下是一张供台，一尊雷公像端坐其中。像前摆著各式水
果和两具烛台。
LONG
  );
  set("exits", ([
    "out": __DIR__ "gate",
    "east": __DIR__ "broad1",
  ]));
  set("objects", ([
    __DIR__ "npc/master": 1,
    __DIR__ "obj/line": 10,
  ]));
  set("valid_startroom", 1);
  set("coor/x", 500);
  set("coor/y", 12010);
  set("coor/z", 200);
  setup();

}
