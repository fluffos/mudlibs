inherit ROOM;
void create()
{
        set("short", "霹雳炼房");
        set("long", @LONG
这里就是霹雳堂禁地——霹雳炼房。威力无比的霹雳弹的独门精钢外壳就是在这里
炼就的。大厅中央两人高的青铜炉火焰熊熊，吐着纯青的火苗。四周堆满了
炼（ｂｕｒｎ）钢的木炭。
LONG
        );
        set("exits", ([ /* sizeof() == 4 */
  "out" : __DIR__"broad2",
  "east" : __DIR__"broad3",
]));
	set("objects", ([ 
		__DIR__"npc/dizi1" : 2,
		__DIR__"obj/oven" : 1,
		__DIR__"obj/carbon" : 10,
	]));
		set("no_fight",1);
		set("no_magic",1);
        set("resource/water",1);
	set("liquid/name","冷却池里的水");
	set("liquid/type", "alcohol");
	set("liquid/drunk_apply",3);

        set("coor/x",800);
	set("coor/y",12010);
	set("coor/z",200);
	setup();
}

void init()
{

	add_action("do_burn","burn");

}

int do_burn(string arg)
{
	object me;
	object tar;
	int weight;
	me = this_player();
	if( !arg || arg == "") 
                return notify_fail("你要炼什么东西？\n");
	tar = present(arg, me);
	if( !tar) 
		return notify_fail("你身上没有这东西。\n");
	if( userp(tar))
		return notify_fail("你不可以炼活的东西。\n");
	if((string)tar->query("material")!="steel")
		return notify_fail("这东西不含铁，会增加钢的杂质的。\n");
	weight=tar->query_weight()*0.8;
	if( weight<800)
		return notify_fail("这东西含铁不够，炼不出什么来。\n");
	message_vision("$N将$n投入了青铜炉，$n转眼化为一股铁流。\n", me, tar);
	tar->move(environment(me));
	destruct(tar);
	message_vision("铁流从青铜炉流入了$N旁边的模子里。\n\n\n",me);
	remove_call_out("get_iron");
	call_out("get_iron",random(5)+25,this_player());	
	me->set_temp("disable_inputs",1);

	return 1;
}


void get_iron(object me)
{
	object ke;
   	me->delete_temp("disable_inputs");
	message_vision("一个精钢霹雳外壳终于淬火炼成了，$N把霹雳外壳夹到了冷却池中。\n\n\n\n",me);
	message_vision("冷却完毕，$N把霹雳外壳夹出冷却池，擦拭干净后，揣入怀中。\n\n",me);
	ke = new(__DIR__"obj/shell");
	if(ke)
	ke->move(me);
	return;
}


