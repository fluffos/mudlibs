//sku@00-11-19 
inherit ROOM;
void create()
{
        set("short", "伙房");
        set("long", @LONG
这里是破庙的伙房。一个丐帮弟子正在忙
为南宫灵煮着今天的饭菜。
LONG );
       set("exits", ([
               "south" : __DIR__"fotang",
       ]));
   set("item_desc", ([
      "zaotai" : "灶台上正在烧饭，火塘里跳动着火苗。 \n",
      "灶台" :   "灶台上正在烧饭，火塘里跳动着火苗。 \n",
        ]) );
        set("coor/x",20);
        set("coor/y",2120);
        set("coor/z",0);
        set("coor/x",20);
        set("coor/y",2120);
        set("coor/z",0);
        setup();
}
void init()
{
   add_action("do_chui", "chui");
//   add_action("do_climb", "climb");
}

int do_chui(string arg)
{
   object me, obj;
   int flvl;
       

   me = this_player();
   flvl = (int)me->query_str();
   if(!arg || (arg != "huotang" && arg != "火塘"))
      return 0;
   me->receive_damage("sen",50);
   me->receive_damage("kee",50);
   me->receive_damage("gin",50);
  
   if (flvl >= 20) {  
      if (!query("exits/down")) {
         message_vision("$N憋足了吃奶的力气试图吹灭灶塘里的火苗。\n", me);
         message_vision("灶塘里的火苗慢慢的熄灭了，冒起了一阵青烟。 \n", me);
         set("exits/down", __DIR__"midao");
         call_out("close_path", 2);      
         return 1;
      }
   }
   else {
      if (!query("exits/down")) {
      message_vision("$N憋足了吃奶的力气试图吹灭灶塘里的火苗, 结果给呛的喘不过起来。\n", me);
         return 1;
      }
   }
   return 0;
}

void close_path()
{
   if(!query("exits/down") ) return;
   message("vision", "噗的一声，灶塘的火星又烧了起来。\n", this_object() );
   delete("exits/down");
}
int valid_leave(object me, string dir)
{
     if(wizardp(me)) 
           return 1;
     if(!((me->query("family/family_name") == "丐帮") && dir == "down"))
  {
            message_vision("快乐突然出现在$N的面前，啪、啪、啪打了$N三个耳光，说道：
不要脸，人家门派禁地你也闯？说完，快乐飞似跑开了！！\n",me);
           return notify_fail("");
    }
 return 1;
}  




