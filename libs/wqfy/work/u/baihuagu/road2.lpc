inherit ROOM;
void create() {
  set("short", "山中小路");
  set("long", @LONG
小路蜿蜒曲折，盘旋着向前延伸，路边的野花争齐斗艳，让你有种说
不出的感觉，让你觉得日复一日的武林争杀，真不如在这里隐居过的
好。
LONG
  );
  set("exits", ([ /* sizeof() == 4 */
    "south": __DIR__ "road4",
    "west": __DIR__ "road1",
    "northwest": __DIR__ "road3",
  ]));

  set("outdoors", "fengyun");
  set("coor/x", 110);
  set("coor/y", 1000);
  set("coor/z", 0);
  set("coor/x", 110);
  set("coor/y", 1000);
  set("coor/z", 0);
  setup();
  replace_program(ROOM);
}
