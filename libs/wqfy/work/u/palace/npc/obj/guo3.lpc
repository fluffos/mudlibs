#include <armor.h>
#include <ansi.h>
inherit CLOTH;

void create()
{
        set_name("紫菁玉蓉膏" , ({ "potion", "magic potion" }) );
        set_weight(3);
  set("long", WHT
      "这是一块有神奇功效的紫膏．\n"
      "可以用来提高身体的极限！\n" NOR);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "件");
		set("value", 20000);
                set("material", "cloth");
                set("armor_prop/armor", 10);
                set("max_heal",100);
        }
        setup();
}
void init()
{
        if(environment()==this_player())
        add_action("do_heal","eatpotion");

}


int do_heal()
{
        object me;
        int max_gin, max_kee, max_sen;
        me = this_player();
    if(query("max_heal") <=0)        return notify_fail("紫菁玉蓉膏的功效已经被用光了！\n");
        max_gin = (int) me->query("max_gin");
        max_kee = (int) me->query("max_kee");
        max_sen = (int) me->query("max_sen");
        message_vision( HIR "$N的全身映出一阵红光！！\n" NOR, me);
              add("max_heal",-1);
max_gin = max_gin * 11/10;
        max_kee = max_kee * 11/10;
        max_sen = max_sen * 11/10;
        switch(random(3)){
                case 0:
                        me->set("max_gin", max_gin);
                        break;
                case 1:
                        me->set("max_kee", max_kee);
                        break;
                case 2:
                        me->set("max_sen", max_sen);
                        break;
                        }
        return 1;
}


