//真武士头
inherit NPC;
#include <ansi.h>

void call_for_help();

void create()
{  
	string *name = ({"灭华","斩明","屠唐","刺宋","杀元","平秦","灭清","刺华","斩华","平西","灭华"});
	string *sname = ({"柳生","武藏","山本","阿部"});
        set_name(sname[random(sizeof(sname))]+name[random(sizeof(name))], ({ "wushitou"}) );
//	set_name( HIM "东瀛武士头" NOR, ({ "wushitou"}) );
	set("gender", "男性" );
	set("age", 35);
	set("agi",40);
	set("str", 40);
	set("long", @LONG
东瀛岛的护岛武士头。
LONG
); 
	set("max_gin", 3000);
        set("max_kee", 3200);
        set("max_sen", 3400);
        set("no_arrest",1) ;
	    set("attitude", "friendly");
        set("combat_exp", 700000);
        set_skill("unarmed", 80);
        set_skill("kongshoudao", 60);
        set_skill("force", 80);
		set_skill("move", 80);
		set_skill("blade",100);
		set_skill("wind-blade",100);
        set("chat_chance_combat",90);
        set("chat_msg_combat", ({          
                (: call_for_help :),		       
                (: perform_action, "blade.leitingpili" :),
        }) );
        set_skill("parry",80);
        set_skill("dodge",80);
		map_skill("unarmed", "kongshoudao");
		map_skill("blade", "wind-blade");
	 // Because the wushitou 武功 is not done yet, set apply to replace it.
        set_temp("apply/attack", random(250));
        set_temp("apply/dodge", random(250));
		setup();
        carry_object(__DIR__"obj/miancloth")->wear();
        carry_object(__DIR__"obj/mingblade")->wield();

        add_money("gold", 10);
}

void call_for_help()
{
        object ob;

        if( query("called_help") || present("yingzi", environment()) ) return;
        set("called_help", 1);
        say("\n\n武士头突然向你身后看了一眼，你感到脊背一阵发凉......\n\n");
        say("从你背后的暗处兀然现出一条人影，手中高举一把又长又窄的利刃向你劈来\n\n");
        ob = new(__DIR__"yingzi");
        ob->move(environment());
        ob->start_help();
}

void init()
{       int lev_com;
		int lev_skill;
        object ob;
        ::init();
        ob = this_player();
		lev_com=ob->query("combat_exp");
		lev_com += random( lev_com * 2 )/(random(1)+1) + random(lev_com * 2)/(random(2)+1);
		lev_skill=((lev_com)*50)/ob->query("combat_exp");
           set("combat_exp", lev_com);	
	    set_skill("unarmed",50+lev_skill);
              set("force_factor", 150);
	       set("max_force", 3000);
       	set("force", 3000);
		set_skill("blade",80+lev_skill);
		set_skill("move",80+lev_skill);
		set_skill("dodge",80+lev_skill);
		set_skill("parry",80+lev_skill);
		set_skill("kongshoudao",lev_skill);
		set_skill("wind-blade",80+lev_skill);

}
