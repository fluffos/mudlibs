
inherit NPC;
#include <ansi.h>

void call_for_help();

void create()
{
	set_name("黄衣武士", ({ "huangwushi"}) );
	set("gender", "男性" );
	set("age", 35);
	set("str", 30);
	set("agi",30);
	set("long", @LONG
一个东瀛岛的看门武士。
LONG
);
    set("max_gin", 800);
	set("max_kee", 800);
	set("max_sen", 1200);
    	set("attitude", "aggressive");
	set("no_arrest",1);
        set("combat_exp", 500000+random(500000));
        set_skill("unarmed", 80);
        set_skill("kongshoudao",60);
        set_skill("force", 60);
		set_skill("move",60);
	    map_skill("unarmed", "kongshoudao");
        set("chat_chance_combat", 20);
        set("chat_msg_combat", ({
		(: perform_action, "unarmed.yaozhan" :),
        }) );
        setup();
        carry_object(__DIR__"obj/hcloth")->wear();
        add_money("silver", 50);
}

