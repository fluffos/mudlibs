// thousand_hand.c

#include <ansi.h>

inherit NPC;
void create()
{
	set_name( "雾夕樱子", ({"yingzhi"}) );
	set("long", "这是一个异邦女子,她浓粉长发,小嘴杏腮,眉宇
间流露出浓浓的哀愁.她此时正低声抽泣着,显
的是如此的孤寂与楚楚可怜!
她让你忍不住有一种想要上去安慰的感觉!\n\n");
	set("attitude", "friendly");
	set("title", HIM "舞姬" NOR);
	set("max_gin", 500);
	set("max_kee", 500);
	set("max_sen", 500);
	set("age", 17);
    set("gender", "女性" );
	set("str", 35);
	set("cor", 30);
	set("cps", 25);
	set("per", 40);
	set("no_arrest",1);
	set("combat_exp", 1000);
	set("chat_chance", 15);
    set("chat_msg", ({
                "雾夕樱子自言自语到:我每天都只能舞给武士门看,平时他们没人会理睬我.\n",
                "雾夕樱子自言自语到:我十一岁就在这里做舞姬,但今天这里我还是不认识几个人.\n",
                "雾夕樱子自言自语到:从来没人愿意和我说说话.....\n",
                "雾夕樱子对你的进入并不惊奇,偶尔还向你望两眼,似乎在期待着什么.\n",
        }) );
	setup();
        carry_object(__DIR__"obj/nucloth")->wear();
        add_money("gold", 5);

}



void init()
{
        add_action("do_contact", "talk");
}

int do_contact()
{   object me;
	me=this_player();
    write(" \n\n雾夕樱子对你深深鞠躬,并停止了啜泣\n");
	command("say 多些你愿意和我交谈");
	command("say 我送你出去吧!!");
	write("\n\n花子背过身去按下了什么 \n");
	write("你突然觉得一股极大的弹力从你脚下传来,身子一轻,被弹出屋外.\n");
	write("你在离开前,回首再看雾夕樱子,她眼含热泪在向你挥手\n\n");
    me->move("/u/dongying/canfly2");
     return 1;
	 }


