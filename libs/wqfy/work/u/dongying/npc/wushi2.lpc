#include <ansi.h>
inherit NPC;
string	summon_more( object who);
void create()
{
	string *name = ({"松下刺三","山菱五十一","藤田屠二","山池灭六",
"阿部杀一","土肥原平","","岗村英刺","山本奥仁","东旭狂生","龟本二","速生一俊"});
        set_name(name[random(sizeof(name))], ({ "xunwushi"}) );
//	set_name( "武士", ({ "xunwushi" }) );
	set("long", "东瀛岛的将军武士\n");
	set("attitude", "aggressive");
	set("title", HIM "忍者" NOR);
	set("max_gin", 1800);
	set("max_kee", 1800);
	set("max_sen", 2200);
	set("age", 35);
	set_temp("shatime",999999999);
    set("gender", "男性" );
	set("str", 35);
	set("agi", 30);
	set("cps", 25);
	set("spi", 40);
	set("no_arrest",1);
	set("combat_exp", 1500000);
    set("chat_chance", 20);
    set("chat_msg", ({
      (: random_move :),
        }) );
	set("chat_chance_combat", 40);
	set("chat_msg_combat", ({
		(: summon_more(this_object()) :),
	}) );
	set_skill("unarmed", 100);
	set_skill("move",200);
	set_skill("dodge",200);
	set_skill("parry",200);
	set_skill("blade",100);
	set_skill("wind-blade",40);
	map_skill("blade","wind-blade");

	setup();
        carry_object(__DIR__"obj/zicloth")->wear();
        carry_object(__DIR__"obj/longblade")->wield();
        add_money("gold", 5);

}

string summon_more(object who)
{
	int i;
	object *enemy;
	object another;
	seteuid(getuid());
	another = new(__DIR__"yingzi1");
	another->move(environment(who));
	message_vision(another->name()+ "突然出现。\n"
		, this_object() );
	enemy = who->query_enemy();
	i = sizeof(enemy);
	while(i--) {
		if( enemy[i] && living(enemy[i]) ) {
			another->kill_ob(enemy[i]);
			enemy[i]->kill_ob(another);
			another->set_leader(enemy[i]);
		}
	}
	return "1";
}
