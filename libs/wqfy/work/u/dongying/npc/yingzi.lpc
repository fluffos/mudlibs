inherit NPC;
#include <ansi.h>

void call_reduce_kee();
void create() {
  set_name("影子武士", ({ "yingzi" }));
  set("gender", "女性");
  set("age", 25);
  set("str", 40);
  set("agi", 30);
  set("long", @LONG
一个如雾般无法看清的神秘家伙。
LONG
  );
  set("max_gin", 1700);
  set("max_kee", 1200);
  set("max_sen", 1900);
  set("no_arrest", 1);
  set_temp("shatime", 999999999);

  set("combat_exp", 800000);
  set("score", 700);
  set("chat_chance_combat", 60);
  set("chat_msg_combat", ({
    (: perform_action, "blade.leitingpili" :),
  }));
  set("attitude", "aggressive");
  set("vendetta/authority", 1);
  set("per", 1);
  set("intellgent", 1);
  set("pursuer", 1);
  set_skill("unarmed", 100);
  set_skill("blade", 100);
  set_skill("parry", 100);
  set_skill("dodge", 100);
  set_skill("move", 100);
  set_skill("wind-blade", 70);
  map_skill("blade", "wind-blade");
  setup();
  carry_object(__DIR__ "obj/longblade")->wield();
  carry_object(__DIR__ "obj/qcloth")->wear();
  add_money("silver", 80);
}



void init() {
  object ob;
  ::init();
  ob = this_player();
  this_object()->set("combat_exp", ob->query("combat_exp") - random(ob->query("combat_exp") / 4));
}
int heal_up() {
  if (environment() && !is_fighting()) {
    call_out("leave", 3);
    return 1;
  }
  return ::heal_up() + 1;
}

void leave() {
  say("影子武士倒退两步.\n\n");
  message("vision",
    HIW + name() + "说：下次请再指教！！！\n\n"
    +name() + "一晃身体,隐入黑暗中\n" NOR, environment(),
    this_object());
  destruct(this_object());
}


void start_help() {
  say(HIY "\n\n这人影突然一刀劈向你的背后，刀锋在空中划出一道霹雳！\n\n" NOR);
  say(HIR "你尽管早有防备，但未料到这武士刀法如此霸道.....\n\n" NOR);
  say(HIR "你迅速尽力前冲，刀锋在你后背拉开一道长长的血口！\n\n" NOR);
}
