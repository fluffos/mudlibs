// heaven_soldier.c

#include <ansi.h>

inherit NPC;

void create() {
  set_name("护岛武士", ({ "huwushi" }));
  set("long", "这是岛上专司打手之责的武士。\n");
  set("attitude", "friendly");
  set("str", 30);
  set("agi", 30);
  set("cps", 25);
  set("max_gin", 800);
  set("max_kee", 1200);
  set("max_sen", 1200);
  set_temp("shatime", 999999999);
  set_skill("unarmed", 120);
  set_skill("move", 100);
  set_skill("dodge", 100);
  set_skill("kongshoudao", 80);
  map_skill("unarmed", "kongshoudao");
  set("combat_exp", 500000);
  set("chat_chance", 30);
  set("chat_msg_combat", ({
    (: perform_action, "unarmed.yaozhan" :),
  }));
  setup();

  carry_object(__DIR__ "obj/qcloth")->wear();
}

int heal_up() {
  if (environment() && !is_fighting()) {
    call_out("leave", 1);
    return 1;
  }
  return ::heal_up() + 1;
}

void leave() {
  say("突然，护岛武士身后传来一阵铃声\n\n");
  message("vision",
    HIW + name() + "说：这次先放过你，下次没哪么便宜！！！\n\n"
    +name() + "向后看了看，一个翻身不见了。\n" NOR, environment(),
    this_object());
  destruct(this_object());
}
