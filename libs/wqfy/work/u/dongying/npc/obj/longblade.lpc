// blade.c

#include <weapon.h>

inherit BLADE;

void create()
{
        set_name("窄刃武士刀", ({ "blade" }) );
        set_weight(2000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "柄");
                set("value", 5000);
                set("material", "iron");
                set("long", "这是东洋忍者用的长刃刀，份量不重，但刀锋很利。\n");
                set("wield_msg", "$N从背后抽出一把明晃晃的$n握在手中。\n");
                set("unequip_msg", "$N将手中的$n插入背后的刀鞘。\n");
        }
        init_blade(35);
        setup();
}
