// tblade.c
#include <ansi.h>
#include <weapon.h>
inherit SWORD;
void create() {
  set_name(HIG "长生剑" NOR, ({ "sword" }));
  set_weight(20000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long",

      "这是一把明如秋水的长剑\n"
    );
    set("material", "steel");
    set("rigidity", 100000);
    set("wield_msg", "$N从陈旧的剑鞘中拔出一把$n握在手中。\n");
    set("unequip_msg", "$N将手中的$n插入腰间的剑鞘。\n");
    set("nature", "real");
    set("value", 1);
  }

  init_sword(80);
  setup();

}
