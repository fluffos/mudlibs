#include <weapon.h>
#include <ansi.h>
inherit BLADE;

void create() {
  set_name(HIR "秀哉" NOR, ({ "xueblade" }));
  set_weight(2000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long", "这是日本岛刀中极品,据说是中原一位著名铸剑师的杰作.");
    set("value", 8000);
    set("rigidity", 250);
    set("material", "steel");
  }
  init_blade(55);
  set("wield_msg", "$N从刀鞘中抽出一把雪亮的$n长刀握在手中。\n");
  set("unwield_msg", "$N将手中的$n插回刀鞘中。\n");
  setup();
}
