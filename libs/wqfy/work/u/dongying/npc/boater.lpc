// boater.c

inherit NPC;

void create()
{
    set_name("老妇人",({"old boater","boater"}));
    set("long","这是一个在船上做饭的老妇人\n");
    set("gender","女性");
    set("age",54);
    set("no_arrest",1);
    set("int",22);
    set("cor",20);
    set("per",10);
    set("con",20);
    set("cps",20);
    set("agi",20);
    set("gin",1000);
    set("max_gin",1000);
    set("eff_gin",1000);
    set("max_sen",1000);
    set("sen",1000);
    set("eff_sen",1000);
    set("combat_exp",1110);  
    set_skill("force",100);
    set_skill("nine-moon-force",150);
    set("force",1000);
    set("max_force",1000);
    set("force_factor",20);
    map_skill("force","nine-moon-force");
    set("attitude", "friendly");
	set("chat_chance",10);
	set("chat_msg",({
		"老婆子嘴里不停的叨叨这什么。\n",
    }) );
    setup();
    carry_object("obj/cloth")->wear(); 
    add_money("silver",30);
}

void unconcious()
{
::die();
}
