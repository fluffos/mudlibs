
inherit NPC;
void call_for_help();

void create()
{
	string *name = ({"秀一","俊二","赏三","圣四","贤五","高六","贞七","利八","雄九","英十"});
        set_name("黑山"+name[random(sizeof(name))], ({ "heiwushi"}) );
//	set_name("黑带武士", ({ "heiwushi"}) );
	set("gender", "男性" );
	set("age", 35);
	set("str", 30);
	set("agi",30);
	set("long", @LONG
这是东瀛岛的护岛武士。
LONG
); 
    set("no_arrest",1) ;
	set("max_gin", 800);
	set("max_kee", 800);
	set("max_sen", 1200);
	set("attitude", "aggressive");
	    set_temp("shatime",999999999);
       set("combat_exp", 2000000);
        set_skill("unarmed", 120);
        set_skill("kongshoudao", 80);
		set_skill("blade",100);
        set_skill("force", 100);
		set_skill("parry", 100);
        set_skill("dodge", 100);
		set_skill("move",100);
		set_skill("wind-blade",80);
	    map_skill("unarmed", "kongshoudao");
	    set("chat_chance_combat", 20);
        set("chat_msg_combat", ({
                name() + "惊叫到：快向首领报告，有支那猪猡闯入！！\n",
                name() + "狞笑道：猪猡！这次行动就要失败了！\n",
                (: call_for_help :),
        }) );
        setup();
        carry_object(__DIR__"obj/heicloth")->wear();
        carry_object(__DIR__"obj/longblade")->wield();
        add_money("silver", 50);
}

void init()
{       object ob;
        ::init();
        ob = this_player();
        set("combat_exp", ob->query("combat_exp")+random(800000));	
              
}

void call_for_help()
{
        object ob;
        if( query("called_help") || present("yingzi", environment()) ) return;
        set("called_help", 1);
        command("say 快来啊，快来啊！！！！！！！！");
        say("\n\n突然从暗处雾一般现出一个人影\n");
        ob = new(__DIR__"yingzi");
        ob->move(environment());
        ob->start_help();
}
