//假武士头
inherit NPC;
#include <ansi.h>
void call_for_help();

void create() {
  string *name = ({ "灭华", "斩明", "屠唐", "刺宋", "杀元", "平秦", "灭清", "刺华", "斩华", "平西", "灭华" });
  string *sname = ({ "柳生", "武藏", "山本", "阿部" });
  set_name(sname[random(sizeof(sname))] + name[random(sizeof(name))], ({ "wushitou" }));
  //	set_name( HIM "东瀛武士头" NOR, ({ "wushitou"}) );
  set("gender", "男性");
  set("age", 35);
  set("str", 50);
  set("long", @LONG
东瀛岛的护岛武士头。
LONG
  );
  set("max_gin", 1600);
  set("max_kee", 1800);
  set("max_sen", 2200);
  set("no_arrest", 1);
  set("attitude", "friendly");
  set("no_arrest", 1);
  set("combat_exp", 700000);
  set_skill("unarmed", 80);
  set_skill("kongshoudao", 60);
  set_skill("force", 80);
  set_skill("move", 80);
  set_skill("blade", 50);
  map_skill("unarmed", "kongshoudao");
  map_skill("blade", "wind-blade");
  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    "\n首领已经早走了，你留在此处等死吧！！！！!\n",
    (: call_for_help :),
  }));
  set_skill("parry", 80);
  set_skill("dodge", 80);
  setup();
  carry_object(__DIR__ "obj/miancloth")->wear();
  carry_object(__DIR__ "obj/mingblade")->wield();
  add_money("gold", 10);
}

void call_for_help() {
  object ob;

  if (query("called_help") || present("yingzi", environment())) return;
  set("called_help", 1);
  command("say 请您帮忙！");
  say("突然从暗处雾一般现出一个人影\n");
  ob = new(__DIR__ "yingzi");
  ob->move(environment());
  ob->start_help();
}

void init() {
  int lev_com;
  int lev_skill;
  object ob;
  ::init();
  ob = this_player();
  lev_com = ob->query("combat_exp");
  lev_com = lev_com + random(lev_com / 3);
  lev_skill = (lev_com * 30) / ob->query("combat_exp");
  set("combat_exp", lev_com);
  set_skill("unarmed", 30 + lev_skill);
  set_skill("move", 30 + lev_skill);
  set_skill("dodge", 30 + lev_skill);
  set_skill("parry", 30 + lev_skill);
  set_skill("blade", 30 + lev_skill);
  set_skill("kongshoudao", lev_skill);
  set_skill("wind-blade", lev_skill);

}
