inherit NPC;
void call_for_help();

void create() {
  string *name = ({ "十一", "十二", "十三", "四郎", "六郎", "十四", "十九",
    "二十二", "太郎", "二郎", "十八", "二十九", "二十二" });
  set_name("鬼居" + name[random(sizeof(name))], ({ "huangwushi" }));
  //	set_name("黄衣武士", ({ "huangwushi"}) );
  set("gender", "男性");
  set("age", 35);
  set("str", 30);
  set("long", @LONG
一个东瀛岛的护岛武士。
LONG
  );
  set("max_gin", 600);
  set("max_kee", 600);
  set("max_sen", 1200);
  set("attitude", "aggressive");

  set("no_arrest", 1);
  set("combat_exp", random(50000) + 500000);
  set_skill("unarmed", 120);
  set_skill("kongshoudao", 40);
  set_skill("force", 60);
  map_skill("unarmed", "kongshoudao");
  set_skill("move", 60);
  set("chat_chance_combat", 90);
  set("chat_msg_combat", ({
    name() + "阴笑道：到这找死来了？\n",
    (: call_for_help :),
  }));
  set_skill("parry", 50);
  set_skill("dodge", 50);
  setup();
  carry_object(__DIR__ "obj/hcloth")->wear();
  add_money("silver", 50);
}

void call_for_help() {
  object ob;

  if (query("called_help")) return;
  set("called_help", 1);
  command("say 请您帮忙！");
  say("突然从暗处雾一般现出一个人影\n");
  say("他紧紧贴在你的身后，如同你的影子\n");
  ob = new(__DIR__ "yingzi");
  ob->move(environment());
  ob->start_help();
}
