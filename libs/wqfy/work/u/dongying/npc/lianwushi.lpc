#include <ansi.h> 
inherit NPC;
string	summon_more( object who);
void create()
{
	string *name = ({"川","松","山","风","田","哉","秀","久"});
       set_name("武藏雄"+name[random(sizeof(name))], ({ "wushi"}) );
//	set_name( "高级武士", ({ "wushi" }) );
	set("long", "这是东瀛上的正在练功的武士，由于这里与内院已经很近了，
	任何打斗都有可能惊动别人，所以你最好不要叫他发现你。\n\n");
	set("attitude", "aggressive");
	set("title", HIM "忍者" NOR);
	set("max_gin", 1200);
	set("max_kee", 1200);
	set("max_sen", 2200);
set_temp("shatime",999999999);

	set("age", 35);
    set("gender", "男性" );
	set("str", 35);
	set("agi", 30);
	set("cps", 25);
	set("per", 40);
	set("no_arrest",1);
	set("combat_exp", 1500000);
    set("chat_chance", 5);
    set("chat_msg", ({
      (: random_move :),
        }) );
	set("chat_chance_combat", 30);
	set("chat_msg_combat", ({
        (: perform_action, "unarmed.yaozhan" :),
		(: summon_more(this_object()) :),
	}) );
	set_skill("unarmed",150);
	set_skill("move",200);
	set_skill("dodge",200);
	set_skill("move",150);
	set_skill("kongshoudao",100);
	map_skill("unarmed","kongshoudao");


	setup();
        carry_object(__DIR__"obj/redcloth")->wear();
        add_money("gold", 5);

}

string summon_more(object who)
{
	int i;
	object *enemy;
	object another;
	seteuid(getuid());
	another = new(__DIR__"yingzi1");
	another->move(environment(who));
	message_vision(another->name()+ "突然出现。\n"
		, this_object() );
	enemy = who->query_enemy();
	i = sizeof(enemy);
	while(i--) {
		if( enemy[i] && living(enemy[i]) ) {
			another->kill_ob(enemy[i]);
			enemy[i]->kill_ob(another);
			another->set_leader(enemy[i]);
		}
	}
	return "1";
}
