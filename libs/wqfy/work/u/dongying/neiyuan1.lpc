#include <ansi.h>

inherit ROOM;
void create()
{
        set("short", "武士内院");
        set("long", @LONG
干干净净的青石小路的尽头有两扇门,一扇是红门(leftdoor),一扇是
黑门(rightdoor),看来你需要作个选择,每个门里的武士头都有可能是假
的,而你杀了一个后,是否还有体力再杀第二个呢?
LONG
        );
        set("exits", ([ 
  "west" : __DIR__"neigate",
]));
    set("no_magic", 1);
	set("no_dazuo",1);
	set("item_desc", ([
	 "leftdoor" : "这是通向内院的一扇门，可你看起来与右边那扇没什么不同\n",
	 "rightdoor" : "这是通向内院的一扇门，可你看起来与左边那扇没什么不同\n",
	        ]) );
    set("coor/x",0);
	set("coor/y",0);
	set("coor/z",0);
	setup();
}

void init()
{
add_action("do_quit","quit");
add_action("do_open", "open");
}


int valid_leave(object me, string dir)
{
        int i;
        object *inv, ro;

	if( (time()-me->query_temp("shatime"))<1200)  {
		return 1;
	}

        message_vision(HIY "$N突然发现四面八方涌来无数的持刀武士,他们叫嚷这向你$N冲来.\n\n" NOR, me);
        message_vision(HIR "尽管奋力的抵抗着，但突然一个武士从$N的背后闪出,并用手刀重重的砍在了$N的脖子上。\n" NOR, me);
        me->unconcious();
        message_vision(HIY "一个武士对着晕倒的$N吐了口吐沫,然后进行了搜身.\n\n" NOR, me);
        inv = all_inventory(me);
        for(i=0; i<sizeof(inv); i++) {
                destruct(inv[i]);
        }
        message_vision(HIY "两个武士把$N抬了出去。\n" NOR, me);
    	ro = find_object(__DIR__"dilao");
	   if(!objectp(ro)) load_object(__DIR__"dilao");
        me->move(ro);
        message("vision", HIY "两个武士把" + me->name() + "重重地撂到地上，然后转身离开了。\n" NOR, environment(me));
        return 0;
}

void close_path()
{
        if(query("exits/northeast") ||query("exits/southeast") ){
        message("vision",
"一阵浓雾飞掩过来，再次盖住了暗门。\n",
                this_object() );
                delete("exits/northeast");
                delete("exits/southeast");}
}


int do_open(string arg)
{
	object me;
	me = this_player();
        if( !arg || arg=="" ) return 0;
        if( arg=="红门" || arg =="leftdoor" ) {
                write("你用力一推红门，");
	if( (int) me->query("force_factor") >= 40 )
		{
		write("面向东北的这扇暗门猛然被你推开了。\n");
     		set("exits/northeast", __DIR__"neiyuan2");
        	call_out("close_path", 5);
						
		return 1;	
		}
		else
		write("但门关的很紧，没有推开。\n");
		return 1;
	}
	 if( arg=="黑门" || arg =="rightdoor" ) {
                write("你用力一推黑门，");
	if( (int) me->query("force_factor") >= 40 )
		{
		write("面向东南的这扇暗门猛然被你推开了。\n");
     		set("exits/southeast", __DIR__"neiyuan3");
        	call_out("close_path", 5);
						
		return 1;	
		}
		else
		write("但门关的很紧，没有推开。\n");
		return 1;
	}
		write("你开什么？\n");
}

int do_quit()
{   	message("vision","这是一条不归路！\n",this_object());
		return 1;
		}


