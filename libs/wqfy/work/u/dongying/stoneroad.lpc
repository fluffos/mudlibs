inherit ROOM;

void create() {
  set("short", "石子路");
  set("long", @LONG
你走上了铺满细小碎石的一条长长的小道,周围是一片平川,绿油油
的草地,蓝蓝的天空,远处是戴着白帽子的群山.从这里再向东,就到了中
原武林极为憎恨的东瀛武士聚集的东瀛架势堂的地界了.
LONG
  );
  set("exits", ([
    "east": __DIR__ "huaroad1",
    "west": __DIR__ "island",
  ]));
  set("no_fight", 1);
  set("no_magic", 1);

  set("coor/x", 0);
  set("coor/y", 0);
  set("coor/z", 0);
  setup();
}
