#include <ansi.h>

inherit ROOM;

void create()
{
        set("short", "东瀛练武厅");
        set("long", @LONG
这里是到达东瀛武士头住处的必经之路，四面是光秃秃的墙壁，
大厅的木柱上还有道道刀痕，木地板上光可鉴人，四周整齐的放
着些练功服、干净的木屐和短袜，还有木剑和木刀。看来这是东
瀛武士练功的地方。在武厅的大门上写这两个大字：
                戊寅厅
这里向东隐约有个小门，但门从里面反锁上了。门四周的高墙(wall)
并不能难倒你。
LONG
        );
   set("exits", ([ 
  "north" :__DIR__"search10",
  "south" :__DIR__"search20",
  "west" : __DIR__"search14",
]));
    set("item_desc", ([
        "wall": "高高的围墙，但你掂量了一下，感觉自己可以爬(climb)过去。\n",
         "高墙": "高高的围墙，但你掂量了一下，感觉自己可以爬(climb)过去。\n",
        ]) );
  if (random(100)<10)
  {
  
      set("objects", ([
		__DIR__"obj/dabu" : 1,
                   ]) );
  }  
  if (random(100)<20)
  {
      set("objects", ([
		"/obj/money/gold" : 2,
                   ]) );
  }
   if (random(100)<5)
  {
      set("objects", ([
		"/obj/money/thousand-cash" : 1,
                   ]) );
  }

    set("no_magic", 1);
 	set("no_dazuo",1);
   set("coor/x",0);
	set("coor/y",0);
	set("coor/z",0);
	setup();
}

void init()
{
object me,ob;
me = this_player();
if(ob = present("wushi",this_object()))
{
message_vision("$N对$n大喊：你是谁，为什么来这？站住！站住！！！
再往里闯你是死路一条！！！！！\n",ob,me);
me->set_temp("befound",1);

}
add_action("climbing","climb");
add_action("do_quit","quit");
}

int climbing(string arg)
{
        object obj;
        object me;
        if(!arg || arg=="")
        {
                write("你要爬什么？\n");
                return 1;
        }
        if( arg == "wall" || arg == "高墙")
        {
        me = this_player();
        message_vision("$N如壁虎一般，游上了墙，悄无声息\n", me);
        me->start_busy(5);
        call_out("fliping",3,me);
        me->stop_busy();
        return 1;
        }
        else
        {
                write("你不可以爬"+arg+"\n");
                return 1;
        }
}
int fliping(object me)
{
	if( !me->is_ghost()) {
        me->move(__DIR__"langgate");
        message_vision("$N手扶墙壁，纵身跃下。\n", me);
	}
        return 1;
}

int do_quit()
{   	message("vision","这是一条不归路！\n",this_object());
		return 1;
		}

	

int valid_leave(object me, string dir)
{
        int i;
        object *inv, ro;

	if( (time()-me->query_temp("shatime"))<1200)  {
		return 1;
	}

        message_vision(HIY "$N突然发现四面八方涌来无数的持刀武士,他们叫嚷这向你$N冲来.\n\n" NOR, me);
        message_vision(HIR "尽管奋力的抵抗着，但突然一个武士从$N的背后闪出,并用手刀重重的砍在了$N的脖子上。\n" NOR, me);
        me->unconcious();
        message_vision(HIY "一个武士对着晕倒的$N吐了口吐沫,然后进行了搜身.\n\n" NOR, me);
        inv = all_inventory(me);
        for(i=0; i<sizeof(inv); i++) {
                destruct(inv[i]);
        }
        message_vision(HIY "两个武士把$N抬了出去。\n" NOR, me);
    	ro = find_object(__DIR__"dilao");
	   if(!objectp(ro)) load_object(__DIR__"dilao");
        me->move(ro);
        message("vision", HIY "两个武士把" + me->name() + "重重地撂到地上，然后转身离开了。\n" NOR, environment(me));
        return 0;
}
