inherit NPC;
#include <ansi.h>

void call_for_help();

void create() {
  set_name("黄衣武士", ({ "huangwushi" }));
  set("gender", "男性");
  set("age", 35);
  set("str", 30);
  set("long", @LONG
一个东瀛岛的护岛武士。
LONG
  );
  set("max_gin", 600);
  set("max_kee", 600);
  set("max_sen", 1200);
  set("attitude", "aggressive");
  set("no_arrest", 1);
  set("combat_exp", 500000 + random(500000));
  set_skill("unarmed", 80);
  set_skill("kongshoudao", 40);
  set_skill("force", 60);
  set_skill("move", 60);
  map_skill("unarmed", "kongshoudao");
  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    "\n黄衣武士阴笑到：到这找死来了？\n",
    (: call_for_help :),
  }));
  setup();
  carry_object(__DIR__ "obj/hcloth")->wear();
  add_money("silver", 50);
}

void call_for_help() {
  object ob;

  if (query("called_help")) return;
  set("called_help", 1);
  command("say 请您帮忙！");
  say("突然从暗处雾一般现出一个人影\n");
  ob = new(__DIR__ "yingzi");
  ob->move(environment());
  ob->start_help();
}
