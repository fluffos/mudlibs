inherit ROOM;

void create()
{
        set("short", "樱花林");
        set("long", @LONG
从樱花树的缝隙中斜撒出的光使你隐约见到前方似乎
有刀光闪动,你猛然从周围的美景的陶醉中清醒过来,意识
到再向东就是东瀛架势堂武士院了,那是中原武林人士的死
地.
LONG
        );
        set("exits", ([ 
  "east" : __DIR__"gate",
  "west" : __DIR__"huaroad2",
]));
    set("no_fight", 1);
	set("no_magic",1);

    set("coor/x",0);
	set("coor/y",0);
	set("coor/z",0);
	setup();
	replace_program(ROOM);
}
