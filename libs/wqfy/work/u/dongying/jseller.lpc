// banker.c

#include <ansi.h>

inherit NPC;
inherit F_BANKPAWNOWNER;
inherit F_VENDOR;
string ask_me(object who);

void create()
{
        set_name("东洋商人", ({ "japan seller","seller" }) );
        set("title", HIR "江湖首富" NOR);
        set("gender", "男性" );
        set("age", 46);
        set("richness",3000000);
        set("str", 42);
        set("cor", 30);
        set("cps", 30);
        set("int", 26);
        set("per", 53);
        set("con", 24);
        set("spi", 30);
        set("kar", 25);
        set("long",
"这是个看上去矮矮胖胖的东洋人,以高价收购中原的物品发财。
他手上有不少中国的好东西，不轻易示人。奇怪地是，他是出现间在
江湖人出了名，身世来历没人知道。现在他自己号称已是江湖首富。\n"
                );
	 set("no_arrest",1);
        set("combat_exp", 2500000);
        set("attitude", "friendly");
		set("chat_chance_combat", 80);
        set("chat_msg_combat", ({
                (: perform_action, "unarmed.yuhuan" :),
        }) );
        set("max_atman", 1000);     
	 set("atman", 1000);             
        set("atman_factor", 3);
        set("max_force", 1000);
	 set("force", 1000);             
        set("force_factor", 3);
        set("max_mana", 1000);
	 set("mana", 1000);               
        set("mana_factor", 3);
        set_skill("parry", 150);
	 set_skill("unarmed",200);
        set_skill("dodge", 150);
        set_skill("force", 150);
	 set_skill("feixian-steps",60);
	 set_skill("changquan",200);
	 map_skill("unarmed","changquan");
	 	set("rank_info/respect", "大商人");

	 	set("vendor_goods", ([
		"/u/dongying/obj/dabu" : 20,
		"/obj/example/dumpling" : 30,
	]) );
        setup();
        carry_object("/obj/cloth")->wear();
        add_money("gold", 15);
}


void init()
{	
	
	add_action("do_vendor_list", "list");
}



 
int accept_object(object me, object obj)
{
	object csword;
        if( (string) obj->query("name") == "虎符令")
	{
        message_vision("$N哈哈大笑，向$n深掬一躬：这是我国家至宝，被德川将军窃据多年。\n",this_object(),me);
        command("smile");
	command("say 如果阁下不是支那人，天皇陛下必有重赏。可惜......\n");
	command("say 赏由在下代领吧。嘻嘻。看你是江湖人士，我有一柄得自中原的利刃相赠\n");
	csword = new(__DIR__"obj/csword");
	if(csword)
	csword->move(me);
        message_vision("$N拿出柄很旧的长剑给$n。\n",this_object(),me);
	return 1;	
	}

	if( !obj->value() &&  !obj->query("value")) return 0;
        command("smile");
        command("say 多谢这位" + RANK_D->query_respect(me) +
"，财富嘛，多多益善！");
        return 1;
}


