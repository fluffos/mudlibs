#include <armor.h>

inherit FINGER;

void create() {
  set_name("古董", ({ "gudong" }));
  set_weight(1);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一个沾满铜锈的中原古董,这是东洋武士从中国掠夺来得!\n");
    set("unit", "个");
    set("value", 30000 + random(210000));
    set("armor_prop/personality", 10);


  }
  setup();
}
