// medicine.c

inherit ITEM;

void create() {
  set_name("东瀛大补丸", ({ "dabuwan" }));
  set_weight(50);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long",
      "东洋人的疗伤圣药，其实你怎么看都象中国的白药，可以用（yong）来治伤 。\n");
    set("unit", "包");
    set("value", 40000);
  }
}

void init() {
  if (this_player() == environment())
    add_action("apply_medicine", "yong");
}

int apply_medicine() {
  int value = 100;
  int diff;

  if (this_player()->is_fighting())
    return notify_fail("战斗中不能用药！！\n");
  diff = this_player()->query("max_kee") - this_player()->query("eff_kee");
  if (!(diff)) return notify_fail("你没有受伤！\n");
  if (value > diff) value = diff;

  message_vision("$N一口吞下东瀛大补丸，添了一下舌头，好象味道还可以\n", this_player());
  this_player()->add("eff_kee", value);
  this_player()->add("kee", value);
  destruct(this_object());
  return 1;
}
