#include <armor.h>

inherit FINGER;

void create()
{
	set_name("虎符令", ({ "tigerseal"}) );
	set_weight(1);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "一只造型古朴的铜虎，中间可以分开，虎身侧面写着几个你不认得的符号。\n");
		set("unit", "个");
		set("value", 30+random(300));
		set("armor_prop/personality", 10);


	}
	setup();
}