
#include <armor.h>
#include <ansi.h>
inherit CLOTH;

void create()
{
        set_name( "黑色武士服" , ({ "cloth" }) );
        set_weight(2000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("value", 20000);
                set("material", "cloth");
                set("unit", "件");
                set("armor_prop/armor", 15);
        }
        setup();
}
