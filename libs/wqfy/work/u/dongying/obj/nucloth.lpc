#include <armor.h>

inherit CLOTH;
#include <ansi.h>
void create()
{
	set_name( HIR "碎花和服" NOR , ({ "cloth" }) );
	set_weight(1000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "件");
		set("long", "一件日本妇女的盛装\n");
		set("material", "cloth");
		set("value", 1000);
		set("armor_prop/armor", 3);
	}
	setup();
}
