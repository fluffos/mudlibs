#include <armor.h>
#include <ansi.h>
inherit CLOTH;

void create() {
  set_name(MAG "幻影武士服" NOR, ({ "cloth" }));
  set_weight(2000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("value", 60000);
    set("material", "cloth");
    set("unit", "件");
    set("armor_prop/armor", 25);
  }
  setup();
}
