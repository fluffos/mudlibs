#include <ansi.h>
#include <weapon.h>
inherit BLADE;
void create() {
  set_name(HIB "名流" NOR, ({ "mingblade" }));
  set_weight(4000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long",
      "＂名流＂是日本武士梦寐以求的宝刀,不仅因为它是著名的利器,它更是高贵武士身份的象征.\n"
      "这把刀长三尺二,宽仅三分,刀身细长而如流水灵蛇,你随手一舞,竟在空中划出一道闪电\n");
    set("value", 200000);
    set("material", "sapphire");
    set("rigidity", 400000);
    set("wield_msg", "$N「刷」地一声抽出一柄闪著寒光的$n握在手中。\n");
    set("unequip_msg", "$N将手中的$n插入腰间的刀鞘。\n");
    set("weapon_prop/agility", 5);
    set("no_get", 1);
    set("no_drop", 1);
  }

  init_blade(120);
  setup();
}

void owner_is_killed(object killer) {
  message_vision(HIB "\n\n名流" NOR + "发出嗡嗡的哀鸣,突然碎成粉末,飞散在倒在地上的武士身上\n\n", killer);
  if (killer->query_temp("onansha")) {
    killer->add("combat_exp", 20000);
    killer->add("potential", 3500);
    killer->add("score", 150);
    killer->delete_temp("onansha");
  }

}
