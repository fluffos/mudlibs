inherit ROOM;

void create() {
  set("short", "樱花林");
  set("long", @LONG
一眼望不到尽头的樱花林,无尽的花香,无尽的美丽,无尽的
遐想.远处传来幽幽的琴声,异国女子低声的吟唱,你完全陶醉在
这仙境班的他乡.
LONG
  );
  set("exits", ([
    "east": __DIR__ "huaroad3",
    "west": __DIR__ "huaroad1",
  ]));
  set("objects", ([
    __DIR__ "npc/jseller": 1,
  ]));
  set("no_magic", 1);

  set("coor/x", 0);
  set("coor/y", 0);
  set("coor/z", 0);
  setup();
}
