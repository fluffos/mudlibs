#include <ansi.h>
inherit ROOM;
void create() {
  set("short", "东瀛武士馆");
  set("long", @LONG
这是武士馆设下陷阱专门抓外来人员的地方,四周是坚固的石墙,
牢不可破,头顶脚下也没有一点缝隙,在墙的角落里散放着不少杂物
和吃完的肉骨头,一块突出的石头上摆着一张铺开的棋盘.
LONG
  );
  set("item_desc", ([
    "stone": "很奇特的石柄，你忍不住也想去触摸它。\n",
    "石头": "磨的发亮的石柄，你忍不住也想去触摸它。\n"
  ]));
  set("no_magic", 1);
  set("objects", ([
    __DIR__ "npc/wushi3": 2,
  ]));
  set("coor/x", 0);
  set("coor/y", 0);
  set("coor/z", 0);
  setup();
}


void init() {
  write(HIR "\n\n\n你感觉脚下一轻,似乎踩了一个空,人向下落去!!\n\n" NOR);
  add_action("do_touch", "touch");
  add_action("do_quit", "quit");
}

int valid_leave(object me, string dir) {
  int i;
  object *inv, ro;

  if ((time() - me->query_temp("shatime")) < 1200) {
    return 1;
  }

  message_vision(HIY "$N突然发现四面八方涌来无数的持刀武士,他们叫嚷这向你$N冲来.\n\n" NOR, me);
  message_vision(HIR "尽管奋力的抵抗着，但突然一个武士从$N的背后闪出,并用手刀重重的砍在了$N的脖子上。\n" NOR, me);
  me->unconcious();
  message_vision(HIY "一个武士对着晕倒的$N吐了口吐沫,然后进行了搜身.\n\n" NOR, me);
  inv = all_inventory(me);
  for (i = 0; i < sizeof(inv); i++) {
    destruct(inv[i]);
  }
  message_vision(HIY "两个武士把$N抬了出去。\n" NOR, me);
  ro = find_object(__DIR__ "dilao");
  if (!objectp(ro)) load_object(__DIR__ "dilao");
  me->move(ro);
  message("vision", HIY "两个武士把" + me->name() + "重重地撂到地上，然后转身离开了。\n" NOR, environment(me));
  return 0;
}

void check_trigger() {
  object room;
  if ((int)query("trigger") == 4
    && !query("exits/up")) {
    message("vision",
      "你听见支轧一声,一丝阳光从上方照射下来!\n",
      this_object());
    set("exits/up", __DIR__ "gate");
    if (room = find_object(__DIR__ "gate")) {
      message("vision",
        "房顶上漏出一个四寸见方的圆洞!\n",
        room);
      room->set("exits/down", __FILE__);
    }

    delete("trigger");
    call_out("close_passage", 5);
  }
}

void close_passage() {
  object room;

  if (!query("exits/up")) return;
  message("vision",
    "支支哑哑的圆洞恢复了原样.\n", this_object());
  if (room = find_object(__DIR__ "gate")) {
    message("vision",
      "支支哑哑的圆洞恢复了原样.\n",
      room);
    room->delete("exits/down");
  }
  delete("exits/up");
}


int do_touch(string arg) {
  string dir;

  if (!arg || arg == "") {
    write("你要摸什么？\n");
    return 1;
  }

  if (arg == "stone" || arg == "石柄") {
    add("trigger", 1);
    write("你向一边搬了搬手柄,但好象方向不对.\n");
    check_trigger();
    return 1;
  }
}


void reset() {
  ::reset();
  delete("trigger");
}


int do_quit() {
  message("vision", "这是一条不归路。\n", this_object());
  return 1;
}
