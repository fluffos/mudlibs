// boat.c
inherit ROOM;
void create() {
  set("short", "船舱中");
  set("long", @LONG
光线很暗，船夫门告诉你海上经常有大风浪,你最好在
仓中,尽量少出来.船舱中有一个老妇人在做饭,你无聊
的躺在舱中数着以过的日子.
LONG
  );
  set("objects", ([
    __DIR__ "npc/boater": 1,
  ]));
  set("coor/x", 1500);
  set("coor/y", -400);
  set("coor/z", -60);
  setup();
}

void boat_run(int counter) {
  object dest;
  object *inv;
  int i;
  if (!present("old boater", this_object())) {
    message("vision", "船无人驾驶，在海面上漫无目的的飘荡...\n", this_object());
    call_out("boat_run", 20, counter);
    return;
  }
  inv = all_inventory(this_object());
  for (i = 0; i < sizeof(inv); i++)
    if (userp(inv[i])) {

      switch (counter) {
        case 0:
          message("vision", "船身开始晃动，缓缓向前驶去。\n", this_object());
          break;
        case 1:
          message("vision", "但闻水声荡荡，海天俱寂。\n", this_object());
          break;
        case 2:
          message("vision", "船在水中已经走了几天了。\n", this_object());
          break;
        case 3:
          message("vision", "茫茫大海，你不知还要走多久。\n", this_object());
          break;
        case 4:
          if (query_temp("mark/dest") == "island")
            message("vision", "海天一线处出现了一个黑点，黑点越来越大，你发现那是一个岛。\n", this_object());
          else
            message("vision", "海天一线处出现了一条黑影，黑影越来越近。\n", this_object());
          break;
        case 5:
          message("vision", "船夫对你说道：“到了，你们可以下船了。”\n", this_object());
          message("vision", "船夫对你说道：“回来时你只要吹口哨(whistle)就有人会接你的。”\n", this_object());

          if (query_temp("mark/dest") == "island") {
            set("exits/up", __DIR__ "island");
            if (!objectp(dest = find_object(__DIR__ "island")))
              dest = load_object(__DIR__ "island");
            set_temp("mark/dest", "mainland");
          } else {
            set("exits/up", __DIR__ "asidesea");
            if (!objectp(dest = find_object(__DIR__ "asidesea")))
              dest = load_object(__DIR__ "asidesea");
            set_temp("mark/dest", "island");
          }
          dest->set("exits/down", __DIR__ "boat");
          message("vision", "一条船缓缓驶了过来。\n", dest);
          call_out("leave", 10, dest);
          return;
      }

      call_out("boat_run", 5, counter + 1);
      return;
    }
}
void leave(object dest) {
  object *inv;
  object oob;
  int i;
  if (!oob = present("old boater", this_object()) || !living(oob)) {
    call_out("leave", 20, dest);
    return;
  }
  inv = all_inventory(this_object());
  for (i = 0; i < sizeof(inv); i++)
    if (userp(inv[i])) {
      message("vision", "船夫向你挥了挥手，船又驶了回去。\n", dest);
      message("vision", "船夫向你挥了挥手，船又驶了回去。\n", this_object());
      delete("exits/up");
      dest->delete("exits/down");
      call_out("boat_run", 5, 0);
      return;
    }
  message("vision", "船夫向你挥了挥手，船又驶了回去。\n", dest);
  delete("exits/up");
  dest->delete("exits/down");

  return;
}
