// seaside.c

#include <ansi.h>
inherit ROOM;
void create()
{
        set("short", "海边船坞");
        set("long", @LONG
无边无际的大海就在你的眼前了。这里海风拂面，清洗着旅客的一路劳顿。海风
清凉，略有点咸味，海面微微泛着波浪。碧蓝的的海水上面涌动的洁白的浪花，
海面飘着轻轻的薄雾。茫茫的大海上没有一点帆影，极目远眺，海天交界处蒙蒙一
片，分不出哪里是海，哪里是天。在海岸上,有几只大船停在岸边,一看就知道这是
走远洋的船.
海滩上有一块大石头很有趣,你走过去一看,这是一个石箱,你看了看身上的刺杀许可
顿时明白了它的用途.
LONG
        );
        set("exits", ([ 
  "west" : "/d/tieflag/seaside",
]));
        set("item_desc", ([
                "box": "这是个又笨又大的石头做的大容器,你也可以放些东西在里面(throw)。\n",
                "石箱" : "这是个又笨又大的石头做的大容器,你也可以放些东西在里面(throw)。\n"
        ]) );

	set("coor/x",0);
	set("coor/y",0);
	set("coor/z",0);
	setup();
}


void init()
{
	add_action("do_throw", "throw");
}


int do_throw(string arg)
{	
    object ob;
	object *inv;
	object anshashu;
	int i;
	if (!arg) return notify_fail("你要放什么入石箱？\n");
	if( arg !="anshashu" && arg != "刺杀许可")
		return notify_fail("你不可把"+arg+"放入石箱．\n");
	if (!this_player()->query_temp("onansha"))
	{write("\n你凭什么来做船,想白混啊?\n");
	return 1;
	}
	ob = new(__DIR__"npc/boater");
    
	write("\n\n你等了一会,一个头裹红巾的健壮男人走了过来\n\n");
	write("他上下打量了你一下,瞄了一眼石箱,对你一抱拳\n");
	write("然后说:请准备上船吧.\n");
    write("他仔细的看了看你的刺杀许可,点点头,又将它递了给你.\n\n");
// added by wd
	inv = all_inventory(this_player());
                for(i=0; i<sizeof(inv); i++)
                {
			if( (string)(inv[i]->query("name")) == HIR"刺杀令"NOR)
				{
					anshashu = inv[i];		
					break;
				}
		}


	destruct(anshashu);
	call_out("boat_come",5);
	return 1;


}


void boat_come()
{
	object boat;
	object woman;
	object *inv;
	object who, oob;
	int i;
	
	if (query("exits/down")) return;
	if (!objectp(boat=find_object(__DIR__"boat")))
		boat=load_object(__DIR__"boat");
	inv=all_inventory(boat);
	if (!(oob=present("old boater",boat)) || boat->query("exits/up") || !living(oob))
	{              
			message("vision","许久许久，海面上什么也没有出现。\n",this_object());
			return;
	}
	for (i=0;i<sizeof(inv);i++)
	    if (userp(inv[i]))
		{
			message("vision","许久许久，海面上什么也没有出现。\n",this_object());
			return;
		}
	message("vision","过了一会,一艘大船向你驶来,你不禁放心了很多(官府在后勤保障上还不错)\n",this_object());
	message("vision","船夫说道：“上船吧！\n",this_object());
	boat->set("exits/up","/d/tieflag/seaside");
	boat->set("no_fight",1);
	boat->set("no_magic",1);
	set("exits/down",__DIR__"boat");
	call_out("boat_leave",10,boat);
}
void boat_leave(object boat)
{
	if (query("exits/down")) delete("exits/down");
	if (boat->query("exits/up")) boat->delete("exits/up");
	message("vision","大船船身抖了一下,船就离开了海岸。\n",this_object()); 
	boat->set_temp("mark/dest","island");
	message("vision","大船船身抖了一下,船就离开了海岸。\n",boat);
	boat->delete("no_fight");
	boat->delete("no_magic");
	boat->boat_run(0);
}
