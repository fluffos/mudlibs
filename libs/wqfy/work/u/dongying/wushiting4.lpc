#include <ansi.h>

inherit ROOM;
void create()
{
        set("short", "东瀛武士厅");
        set("long", @LONG
武士厅有十余丈见方,四面是木门木窗,木地板.这里处处可见
到来往交谈的浪人和武士,他们对你并未很注意,但一有看到你的
无不对你怒目而视,手扶剑柄,似乎随时会抽出武器来.
再向东就到了专给武士练功的地方了,如果在那里给武士发现你的
踪迹,你就会彻底的暴露的.(open door)
LONG
        );
        set("exits", ([ 
  "west" : __DIR__"wushiting3",
  "north" : __DIR__"wushiting8",
  ]));
    set("no_magic", 1);
	set("no_dazuo",1);
	set("objects", ([
		__DIR__"npc/wushi4" : 2,
	]));
    set("coor/x",0);
	set("coor/y",0);
	set("coor/z",0);
	setup();
}

int do_open(string arg)
{
        object obj;
        object me;
        if(!arg || arg=="")
        {
                write("你要打开什么？\n");
                return 1;
        }
        if( arg == "door" || arg == "门" )
        {
        me = this_player();
        message_vision("$N趁人不注意悄悄推开了通向练武厅的小门\n", me);
        if( !query("exits/east") ) {
        set("exits/east", __DIR__"search21");
        call_out("close_path", 2);
        }
        return 1;
        }
        else
        {
                write("你不可以打开"+arg+"\n");
                return 1;
        }
}
void close_path()
{
        if( !query("exits/east") ) return;
        message("vision",
"小门又弹了回来,悄无声息的掩上了。\n",
                this_object() );
                delete("exits/east");
}


void init()
{
add_action("do_open","open");
add_action("do_quit","quit");
}

int do_quit()
{   	message("vision","这是一条不归路！\n",this_object());
		return 1;
		}
	


int valid_leave(object me, string dir)
{
        int i;
        object *inv, ro;

	if( (time()-me->query_temp("shatime"))<1200)  {
		return 1;
	}

        message_vision(HIY "$N突然发现四面八方涌来无数的持刀武士,他们叫嚷这向你$N冲来.\n\n" NOR, me);
        message_vision(HIR "尽管奋力的抵抗着，但突然一个武士从$N的背后闪出,并用手刀重重的砍在了$N的脖子上。\n" NOR, me);
        me->unconcious();
        message_vision(HIY "一个武士对着晕倒的$N吐了口吐沫,然后进行了搜身.\n\n" NOR, me);
        inv = all_inventory(me);
        for(i=0; i<sizeof(inv); i++) {
                destruct(inv[i]);
        }
        message_vision(HIY "两个武士把$N抬了出去。\n" NOR, me);
    	ro = find_object(__DIR__"dilao");
	   if(!objectp(ro)) load_object(__DIR__"dilao");
        me->move(ro);
        message("vision", HIY "两个武士把" + me->name() + "重重地撂到地上，然后转身离开了。\n" NOR, environment(me));
        return 0;
}
