inherit NPC;
void create() {
  set_name("老头子", ({ "laotou" }));
  set("gender", "男性");
  set("age", 62);
  set("long", "正在打扫的院子的东瀛老人。\n");
  set("combat_exp", 8000000);
  set("attitude", "friendly");
  set_skill("unarmed", 200);
  set_skill("demon-strike", 100);
  set_skill("demon-steps", 100);
  set_skill("dodge", 100);
  set_skill("force", 100);
  map_skill("unarmed", "demon-strike");
  map_skill("dodge", "demon-steps");
  set("force", 700);
  set("force_factor", 80);
  set("max_force", 700);
  set("chat_chance", 8);
  set("chat_msg", ({
    "老人对你道：到这里的人最今好象多了很多.\n",
    "老人对你道：可是我看到的回去的可不多.\n",
  }));

  setup();
  add_money("silver", 5);
  carry_object(__DIR__ "obj/cloth")->wear();
}

void init() {
  add_action("do_gogo", "go");
}


int do_gogo(string arg)

{
  object me;
  me = this_player();
  if (arg == "east") {
    command("say 你还是快离开这是非之地吧。");
    write("这个方向的路被挡住了 。\n");
    return 1;
  }
  return 0;
}
