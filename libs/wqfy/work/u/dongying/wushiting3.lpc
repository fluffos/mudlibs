#include <ansi.h>

inherit ROOM;
void create()
{
        set("short", "东瀛武士厅");
        set("long", @LONG
武士厅有十余丈见方,四面是木门木窗,木地板.这里处处可见
到来往交谈的浪人和武士,他们对你并未很注意,但一有看到你的
无不对你怒目而视,手扶剑柄,似乎随时会抽出武器来.
你似乎隐隐听到有女孩啜泣的声音.
LONG
        );
        set("exits", ([ 
  "east" : __DIR__"wushiting4",
  "west" : __DIR__"wushiting2",  
]));
    set("no_magic", 1);
	set("no_dazuo",1);
	   set("objects",([
		__DIR__"npc/wushi2" :1
		]));
    set("coor/x",0);
	set("coor/y",0);
	set("coor/z",0);
	setup();
}

void init()
{
   add_action("do_quit","quit");
   add_action("do_listen", "listen");
   add_action("do_northup", "northup");
}

int do_quit()
{   	message("vision","这是一条不归路！\n",this_object());
		return 1;
		}

int do_northup(string arg)
{
   object me, room;
   me = this_player();

   if(me->query_temp("marks/listen")) {
      tell_object(me, "你轻轻地拉开了一扇密门。\n\n");
      message("vision", me->name(me)+"犹豫地走了进去！\n", environment(me),me );
      room = find_object(__DIR__"canfly1");
      if(!objectp(room)) room=load_object(__DIR__"canfly1");
      me->move(room);
      return 1;
   }
   return 0;
}

int do_listen(string arg)
{
   object me, room;
   me = this_player();

   tell_object(me,"哭声若有若无，你仔细再听了听，好象隐隐约约从北边传来。\n");
   message("vision",me->name(me)+"突然住足，似乎在侧耳倾听着什么。\n", environment(me),me);
   tell_object(me, "\n你再仔细看了看那个方向，似乎有一个小门。\n", me);	
   me->set_temp("marks/listen",1);
   return 1;
}



int valid_leave(object me, string dir)
{
        int i;
        object *inv, ro;

	if( (time()-me->query_temp("shatime"))<1200)  {
		return 1;
	}

        message_vision(HIY "$N突然发现四面八方涌来无数的持刀武士,他们叫嚷这向你$N冲来.\n\n" NOR, me);
        message_vision(HIR "尽管奋力的抵抗着，但突然一个武士从$N的背后闪出,并用手刀重重的砍在了$N的脖子上。\n" NOR, me);
        me->unconcious();
        message_vision(HIY "一个武士对着晕倒的$N吐了口吐沫,然后进行了搜身.\n\n" NOR, me);
        inv = all_inventory(me);
        for(i=0; i<sizeof(inv); i++) {
                destruct(inv[i]);
        }
        message_vision(HIY "两个武士把$N抬了出去。\n" NOR, me);
    	ro = find_object(__DIR__"dilao");
	   if(!objectp(ro)) load_object(__DIR__"dilao");
        me->move(ro);
        message("vision", HIY "两个武士把" + me->name() + "重重地撂到地上，然后转身离开了。\n" NOR, environment(me));
        return 0;
}