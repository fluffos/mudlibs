#include <ansi.h>
inherit ROOM;

void create()
{
	set("short", "地牢");
	set("long", @LONG
这是东瀛岛专关犯人的地方,这里又黑又臭,在这里可以闻到腐尸烂肉的气味,
远处不断的传来阵阵的惨叫声和东洋人极其狂妄的大笑声.可以感觉到,在你身边
不断的有老鼠和更大的爬虫经过,还有什么动物似乎在啃着什么东西的骨头的声音
不断的传入你的耳朵里.
LONG
	);
	set("no_magic",1);
	set("coor/x",0);
	set("coor/y",0);
	set("coor/z",0);
	setup();
    
}
void init()
{
        add_action("do_dig", "dig");
        add_action("do_search", "search");
		this_player()->set_temp("onansha", 0);
	    this_player()->delete_temp("shatime");
		this_player()->query_time("marks/牢时间",0);
        call_out("airing", 10, this_player());

}

int do_search(string arg)
{
	object	ob;
	ob = this_player();
	if( ob->is_busy() )
               	return notify_fail("你的动作还没有完成，不能移动。\n");
	message_vision("$N仔细的查看四周的墙壁，搜遍了各个角落。\n", ob);
	ob->start_busy(2);
	call_out("search_obj", 4, ob);
	return 1;
}

int search_obj(object me)
{
	int kar;	
	kar = (int)me->query("kar");
	if( kar > 40 ) kar = 40;
		if( random(40 - kar) < 10) {
			message_vision(HIY "$N终于找到了一块以松动的石头。从这里好象可以挖(dig)开一条路.\n" NOR,me);
			me->set_temp("marks/找到石头", 1);
                me->add("score",150);

        }
		
		else
			message_vision("$N什么都没找到。\n", me);

	return 1;
}

int airing(object ob)
{
        int i, htime, ntime;

	if( environment(ob) == this_object()) {
		htime = (int)ob->query("str") + (int)ob->query("kar");
		ntime = ob->query_temp("marks/牢时间");
		if( ntime > htime ) {
			ob->set_temp("marks/牢时间",0);
			ob->die();
			ob->skill_death_penalty();
		}
		else if( ntime > (htime - 15) )
			message_vision(HIR "脚步声已经快到了这里了,眼看$N就要被武士们拉出去杀掉了!!!\n" NOR, ob);
		else if( ntime > (htime - 30) )
			message_vision(HIR "$N听到了远处传来脚步声,好象是向着这边来的,$N心里紧张极了。\n" NOR, ob);
		else 
			message_vision(HIW "$N知道,东瀛武士随时回进来将$N带出去,那将无疑意味着两个字--死亡!!。\n" NOR, ob);
		i=ob->query_temp("marks/牢时间")+5;
		ob->set_temp("marks/牢时间",i);
		call_out("airing",10, ob);
	}
	else
		return 1;
}

int do_dig(string arg)
{
        object 	obj, me;
	int	kar;
        if(!arg || arg=="")
        {
                write("你要往哪里挖？\n");
                return 1;
        }
        me = this_player();
		
        if( arg == "stone" || arg == "石头" || arg == "up")
        {
		if( me->is_busy() )
                	return notify_fail("你的动作还没有完成，不能移动。\n");
		if (!me->query_temp("marks/找到石头"))
		{
		message_vision("$N使尽全身的力气向墙壁下挖,但什么效果也没有。\n", me);
		return 1;
		}
                message_vision("$N疯了一般拼命的向一块石头下挖去。\n", me);
                message_vision("慢慢的,这块石头松动了,落了下来,露出一个小的口子。\n", me);
                message_vision("$N不顾一切的向着小口子钻了下去。\n", me);
                me->start_busy(5);
	            message_vision("一股水流狠狠的拍中了$N的头,$N晕了过去。\n", me);
		        me->unconcious();
        me->move("/d/fy/afa");
		set_temp("marks/牢时间",0);
        message("vision", HIY "一个浪将" + me->name() + "如死鱼一般冲上了岸.\n\n" NOR,environment(me));
                return 1;
        }
        else
        {
                write("这里没有"+arg+"！\n");
                return 1;
        }
}       

