#include <ansi.h>
inherit NPC;
void create()
{
	string *name = ({"斩","隐","藏","屠","霸","刚","阴","灭"});
        set_name("须贺鬼"+name[random(sizeof(name))], ({ "huanying"}) );
//	set_name("幻影武士", ({ "huanying"}) );
       set("gender", "男性" );
	set("age", 35);
	set("str", 40);
	set("long", @LONG
一个如雾般无法看清的神秘家伙。
LONG
);
	set("max_gin", 800);
	set("max_kee", 800);
	set("max_sen", 1200);
	set("no_arrest",1);
        set("combat_exp", 200000);
        set("score", 500);
        set("attitude", "aggressive");
		set("vendetta/authority",1);
        set("per", 1);
        set("intellgent",1);
	    set("pursuer",1);
        set_skill("blade", 80);
        set_skill("parry", 80);
        set_skill("dodge", 80);
		set_skill("move",80);
// 东洋剑道未做好,用attack 带提
        set_temp("apply/attack", 50);
        set_temp("apply/dodge", 30);

        setup();
        carry_object(__DIR__"obj/xueblade")->wield();
        carry_object(__DIR__"obj/huancloth")->wear();
        add_money("silver", 80);
}

void init()
{       object ob;
        ::init();
        ob = this_player();
        set("combat_exp", ob->query("combat_exp")-300000+random(800000));	
              

}
int heal_up()
{
	if( environment() && !is_fighting() ) {
		call_out("leave", 5);
		return 1;
	}
	return ::heal_up() + 1;
}

void leave()
{   say(name() +"倒退两步.\n\n");
	message("vision",
		HIW + name() + "说：下次请再指教！！！\n\n"
		+ name() + "一晃身体,隐入黑暗中\n" NOR, environment(),
		this_object() );
	destruct(this_object());
}

    
void start_help()
{
      command("say 哈....咿......\n");
}

