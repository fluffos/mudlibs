#include <ansi.h>

inherit ROOM;
void create()
{       set("short", "武士内院");
        set("long", @LONG
这只是一间小小的房间,里面陈设非常简单,只有一榻,一几,一柜.
靠墙挂着一幅字,上书一个斗大的--忍--字,窗外是一片竹林.
LONG
        );
        set("exits", ([ 
  "southwest" : __DIR__"neiyuan1",
]));
    if (random(300)>100) {   
	set("objects", ([
		__DIR__"npc/wushitou" : 1,
	]));}
	else{
	set("objects", ([
		__DIR__"npc/wushitou1" : 1,
	]));}
    set("no_magic", 1);
	set("no_dazuo",1);
    set("coor/x",0);
	set("coor/z",0);
	set("coor/y",0);
	setup();
}

void init()
{
add_action("do_quit","quit");
add_action("do_open", "open");
}

int do_quit()
{   	message("vision","这是一条不归路！\n",this_object());
		return 1;
		}

int valid_leave(object me, string dir)
{
        object ob,*inv,ro;
        int i;
        if( dir == "south" && ob=present("wushitou", this_object()))
	{
	message_vision("$N对$n喝道：想进去？宰了我再说！！\n", ob,me);
	ob->kill_ob(me);
	return notify_fail("快逃！\n");
	}
       

	if( (time()-me->query_temp("shatime"))<1200)  {
		return 1;
	}

        message_vision(HIY "$N突然发现四面八方涌来无数的持刀武士,他们叫嚷这向你$N冲来.\n\n" NOR, me);
        message_vision(HIR "尽管奋力的抵抗着，但突然一个武士从$N的背后闪出,并用手刀重重的砍在了$N的脖子上。\n" NOR, me);
        me->unconcious();
        message_vision(HIY "一个武士对着晕倒的$N吐了口吐沫,然后进行了搜身.\n\n" NOR, me);
        inv = all_inventory(me);
        for(i=0; i<sizeof(inv); i++) {
                destruct(inv[i]);
        }
        message_vision(HIY "两个武士把$N抬了出去。\n" NOR, me);
    	ro = find_object(__DIR__"dilao");
	   if(!objectp(ro)) load_object(__DIR__"dilao");
        me->move(ro);
        message("vision", HIY "两个武士把" + me->name() + "重重地撂到地上，然后转身离开了。\n" NOR, environment(me));
        return 0;
}


int do_open(string arg)
{
        object obj;
        object me;
        if(!arg || arg=="")
        {
                write("你要打开什么？\n");
                return 1;
        }
        if( arg == "picture" || arg == "条幅" || arg == "tiao")
        {
        me = this_player();
        message_vision("$N拉起墙上的条幅，发现了一个暗门。\n", me);
        if( !query("exits/south") ) {
        set("exits/south", __DIR__"secret");
        call_out("close_path", 2);
        }
        return 1;
        }
        else
        {
                write("你不可以打开"+arg+"\n");
                return 1;
        }
}
void close_path()
{
        if( !query("exits/south") ) return;
        message("vision",
"条幅荡了回来，又遮住了暗门。\n",
                this_object() );
                delete("exits/south");
}
