#include <ansi.h>

inherit ROOM;
void create()
{
        set("short", "玄关");
        set("long", @LONG
这里有一块牌子.
##################################################
#                 勇者之门                       #
##################################################
LONG
        );
        set("exits", ([ 
  "east" : __DIR__"mulang1",
  "west" : __DIR__"search15",
]));
        set("objects", ([
                __DIR__"npc/huanyin" : 1,
        ]) );
	set("no_magic", 1);
	set("no_dazuo",1);
	set("coor/x",0);
	set("coor/y",0);
	set("coor/z",0);
	setup();
}

void init()
{
  add_action("do_quit","quit");
}

int valid_leave(object me, string dir)
{
        int i;
        object *inv, ro;

	if( (time()-me->query_temp("shatime"))<1200)  {
		return 1;
	}

        message_vision(HIY "$N突然发现四面八方涌来无数的持刀武士,他们叫嚷这向你$N冲来.\n\n" NOR, me);
        message_vision(HIR "尽管奋力的抵抗着，但突然一个武士从$N的背后闪出,并用手刀重重的砍在了$N的脖子上。\n" NOR, me);
        me->unconcious();
        message_vision(HIY "一个武士对着晕倒的$N吐了口吐沫,然后进行了搜身.\n\n" NOR, me);
        inv = all_inventory(me);
        for(i=0; i<sizeof(inv); i++) {
                destruct(inv[i]);
        }
        message_vision(HIY "两个武士把$N抬了出去。\n" NOR, me);
    	ro = find_object(__DIR__"dilao");
	   if(!objectp(ro)) load_object(__DIR__"dilao");
        me->move(ro);
        message("vision", HIY "两个武士把" + me->name() + "重重地撂到地上，然后转身离开了。\n" NOR, environment(me));
        return 0;
}

int do_quit()
{   	message("vision","这是一条不归路！\n",this_object());
		return 1;
		}