// 藏宝室

#include <ansi.h>
inherit ROOM;
void create() {
  set("short", "密室");
  set("long", @LONG
这里是一间藏宝室，四周是一排排的珍宝架，但上面现在大部分已经空了，
似乎才给人搬走。被搬空的架子漏出了后面的密柜。密柜的锁已经被打开了。
LONG
  );
  set("exits", ([
    "westdown": __DIR__ "outwin",
  ]));
  set("no_magic", 1);
  set("no_fight", 1);
  set("objects", ([
    __DIR__ "obj/gudong": 2,
    __DIR__ "obj/bladebook": 1,
  ]));

  set("item_desc", ([
    "密柜": "嵌在墙内的一个秘密柜子。里面空空的，最下面的一个抽屉紧闭着。\n",
    "抽屉": "似乎可以拉开它（ｐｕｌｌ）\n",
  ]));
  set("coor/x", 0);
  set("coor/y", 0);
  set("coor/z", 0);
  setup();
}
void init() {
  add_action("do_pull", "pull");
}
void reset() {
  ::reset();
  delete("mark/虎符");

  object *ob;
  object inv;
  int i;
  int a;
  ob = all_inventory(environment(this_object()));
  for (i = 0; i < sizeof(ob); i++) {
    if (!living(obi)) continue;
    if (ob[i]->query("shatime") > 2400) {
      message_vision(HIY "$N突然发现四面八方涌来无数的持刀武士,他们叫嚷这向你$N冲来.\n\n" NOR, me);
      message_vision(HIR "尽管奋力的抵抗着，但突然一个武士从$N的背后闪出,并用手刀重重的砍在了$N的脖子上。\n" NOR, me);
      ob[i]->unconcious();
      message_vision(HIY "一个武士对着晕倒的$N吐了口吐沫,然后进行了搜身.\n\n" NOR, me);
      inv = all_inventory(ob[i]);
      a = i;
      i = 0;
      for (i = 0; i < sizeof(inv); i++) {
        destruct(inv[i]);
      }
      i = a;
      message_vision(HIY "两个武士把$N抬了出去。\n" NOR, me);
      ob[i]->move(__DIR__ "dilao");
      message("vision", HIY "两个武士把" + me->name() + "重重地撂到地上，然后转身离开了。\n" NOR, ob[i]);
    }
    return 1;
  }



}
int do_pull(string arg) {
  object hufu;
  if (arg != "抽屉") return notify_fail("你要拉开什么？\n");
  if (query("mark/虎符")) return notify_fail("你拉开抽屉，里面什么也没有\n");
  message_vision("$N将抽屉拉开\n", this_player());
  message_vision(HIW "“啪！”，抽屉底部的暗格坏了，一个重物砸在$N的脚上。\n" NOR, this_player());
  this_object()->set("mark/虎符", 1);
  hufu = new(__DIR__ "obj/hufu");
  hufu->move(environment(this_player()));
  return 1;
}




int valid_leave(object me, string dir) {
  int i;
  object *inv, ro;

  if ((time() - me->query_temp("shatime")) < 1200) {
    return 1;
  }

  message_vision(HIY "$N突然发现四面八方涌来无数的持刀武士,他们叫嚷这向你$N冲来.\n\n" NOR, me);
  message_vision(HIR "尽管奋力的抵抗着，但突然一个武士从$N的背后闪出,并用手刀重重的砍在了$N的脖子上。\n" NOR, me);
  me->unconcious();
  message_vision(HIY "一个武士对着晕倒的$N吐了口吐沫,然后进行了搜身.\n\n" NOR, me);
  inv = all_inventory(me);
  for (i = 0; i < sizeof(inv); i++) {
    destruct(inv[i]);
  }
  message_vision(HIY "两个武士把$N抬了出去。\n" NOR, me);
  ro = find_object(__DIR__ "dilao");
  if (!objectp(ro)) load_object(__DIR__ "dilao");
  me->move(ro);
  message("vision", HIY "两个武士把" + me->name() + "重重地撂到地上，然后转身离开了。\n" NOR, environment(me));
  return 0;
}
