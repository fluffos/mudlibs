#include <ansi.h>

inherit ROOM;
void create() {
  set("short", "东瀛长廊");
  set("long", @LONG
长长的走廊上什么人也没有,你四面都是水塘,长廊就高架其上,
你猛然发现四周环境一模一样,现在,你好象迷路了.
LONG
  );
  set("exits", ([
    "east": __DIR__ "miout",
    "west": __DIR__ "migong3",
    "south": __DIR__ "migong1",
    "north": __DIR__ "migong4",
  ]));
  set("no_magic", 1);
  set("no_dazuo", 1);
  set("coor/x", 0);
  set("coor/y", 0);
  set("coor/z", 0);
  setup();
}

void init() {
  add_action("do_quit", "quit");
}

int do_quit() {
  message("vision", "这是一条不归路！\n", this_object());
  return 1;
}
