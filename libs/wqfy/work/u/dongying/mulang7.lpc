inherit ROOM;
#include <ansi.h>
void create() {
  set("short", "木廊");
  set("long", @LONG
这是一条两面封闭的狭长木廊,光线昏暗,你踩在以有些年代的木制地板
上,发出单调的--咯吱,咯吱--声.在这里,你感觉到了巨大的杀气藏在每一个
角落,不得不小心翼翼,因为每走一步,这都可能是你这一生中的最后一步.
走廊的尽头是一扇可以拉开的门,你不知道门后等待你的是什么.......
LONG
  );
  set("exits", ([
    "south": __DIR__ "mulang6",
  ]));
  set("item_desc", ([
    "door": "这是通向前方的一扇糊纸的木门。\n",
  ]));
  set("no_magic", 1);
  set("no_dazuo", 1);
  set("coor/x", 0);
  set("coor/y", 0);
  set("coor/z", 0);
  setup();
}

void init() {
  object me;
  me = this_player();
  if (me->query_temp("befound")) {
    if (random((int)me->query("kar")) < 35) {
      me->receive_wound("sen", 50);
      write(HIR "此时的你已是精疲力尽，只希望能走出这要命的长廊！\n\n" NOR);
      write(HIG "你强忍住身上的疼痛，不禁想，还是回去吧!\n" NOR);
    }
  }
  add_action("do_quit", "quit");
  add_action("do_open", "open");
}
int valid_leave(object me, string dir) {
  int i;
  object *inv, ro;
  message_vision(HIG "你决定悄悄走过走廊而不惊动任何人!!\n\n" NOR, me);
  message_vision(HIR "你小心翼翼地四周观看着......\n\n\n" NOR, me);
  i = me->query("sen") - 20;
  me->set("sen", i);
  if ((time() - me->query_temp("shatime")) < 1200) return 1;
  message_vision(HIY "$N突然发现四面八方涌来无数的持刀武士,他们叫嚷这向你$N冲来.\n\n" NOR, me);
  message_vision(HIR "尽管奋力的抵抗着，但突然一个武士从$N的背后闪出,并用手刀重重的砍在了$N的脖子上。\n" NOR, me);
  me->unconcious();
  message_vision(HIY "一个武士对着晕倒的$N吐了口吐沫,然后进行了搜身.\n\n" NOR, me);
  inv = all_inventory(me);
  for (i = 0; i < sizeof(inv); i++) {
    destruct(inv[i]);
  }
  message_vision(HIY "两个武士把$N抬了出去。\n" NOR, me);
  ro = find_object(__DIR__ "dilao");
  if (!objectp(ro)) load_object(__DIR__ "dilao");
  me->move(ro);
  message("vision", HIY "两个武士把" + me->name() + "重重地撂到地上，然后转身离开了。\n" NOR, environment(me));
  return 0;
}

void close_path() {
  if (!query("exits/east")) return;
  message("vision",
    "木门悄无声息的合上了。\n",
    this_object());
  delete("exits/east");
}


int do_open(string arg) {
  object ob;
  object me;
  me = this_player();
  if (!arg || arg == "") return 0;
  if (arg == "木门" || arg == "door") {
    write("你蹑手蹑脚的轻轻去拉门。。。\n\n");
    if ((int)me->query("force_factor") >= 20) {
      if (random(300) < 100) {
        write("门后传来一声断喝!!!!\n\n");
        ob = new(__DIR__ "npc/huanyin");
        ob->move(__DIR__ "mulang7");
        return 1;
      } else {
        write("你终于走出了这道长廊。\n");
        set("exits/east", __DIR__ "neigate");
        call_out("close_path", 7);

        return 1;
      }
    } else
      write("但门关的很紧，没有推开。\n");
    return 1;
  }

  write("你开什么？\n");
}

int do_quit() {
  message("vision", "这是一条不归路！\n", this_object());
  return 1;
}
