#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "樱花林");
  set("long", @LONG
突然印入你眼帘的是大片的粉的,白的,红的,各种颜色的美丽
樱花.花瓣飘飘洒洒,落到你的头上,轻抚你的脸庞.这里鸟鸣花香,
蝴蝶飞舞,你仿佛来到了美的天堂.
LONG
  );
  set("exits", ([
    "east": __DIR__ "huaroad2",
    "west": __DIR__ "stoneroad",
  ]));
  set("no_fight", 1);
  set("no_magic", 1);
  set("no_dazuo", 1);
  set("coor/x", 0);
  set("coor/y", 0);
  set("coor/z", 0);
  setup();
}
