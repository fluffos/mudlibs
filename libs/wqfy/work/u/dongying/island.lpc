// seaside.c
#include <ansi.h>

inherit ROOM;
void create()
{
        set("short", "东瀛渡口");
        set("long", @LONG
海滩上满是洁白的细沙。一脚踩上，柔柔的细沙从脚趾间渗出来，漫到脚面上
，就好象踩在棉花上一样。海面上上下天光，一碧万顷，令你忘却了人间的凶杀阴
险之事。这里只有向东一条路可以走,你知道这是通向你的目的地----东瀛武院的路.
LONG
        );
        set("exits", ([ 
          "east"  : __DIR__"stoneroad",
		]));
    set("no_fight", 1);
	set("no_magic",1);

    set("coor/x",0);
	set("coor/y",0);
	set("coor/z",0);
	setup();
}

void init()
{
	add_action("do_whistle", "whistle");
}

int valid_leave(object me, string dir)
{
        int i;
        object *inv, ro;

	if( (time()-me->query_temp("shatime"))<1200)  {
		return 1;
	}

        message_vision(HIY "$N突然发现四面八方涌来无数的持刀武士,他们叫嚷这向你$N冲来.\n\n" NOR, me);
        message_vision(HIR "尽管奋力的抵抗着，但突然一个武士从$N的背后闪出,并用手刀重重的砍在了$N的脖子上。\n" NOR, me);
        me->unconcious();
        message_vision(HIY "一个武士对着晕倒的$N吐了口吐沫,然后进行了搜身.\n\n" NOR, me);
        inv = all_inventory(me);
        for(i=0; i<sizeof(inv); i++) {
                destruct(inv[i]);
        }
        message_vision(HIY "两个武士把$N抬了出去。\n" NOR, me);
        me->move("/u/dongying/dilao");
        message("vision", HIY "两个武士把" + me->name() + "重重地撂到地上，然后转身离开了。\n" NOR, environment(me));
        return 0;
}


int do_whistle(string arg)
{	
    object ob;
	ob = new(__DIR__"npc/boatman");
    
	write("\n\n你鼓足劲吹了一声口哨,一个身穿蓑衣的老人走了过来\n\n");
	write("他上下打量了你一下,对你一抱拳\n");
	write("然后说:请准备上船吧\n\n");
    call_out("boat_come",5);
    return 1;

}

void boat_come()
{
	object boat;
	object woman;
	object *inv;
	object who, oob;
	int i;
	
	if (query("exits/down")) return;
	if (!objectp(boat=find_object(__DIR__"boat")))
		boat=load_object(__DIR__"boat");
	inv=all_inventory(boat);
	if (!(oob=present("old boater",boat)) || boat->query("exits/up")|| !living(oob))
	{              
			message("vision","许久许久，海面上什么也没有出现。\n",this_object());
			return;
	}
	for (i=0;i<sizeof(inv);i++)
	    if (userp(inv[i]))
		{
			message("vision","许久许久，海面上什么也没有出现。\n",this_object());
			return;
		}
	message("vision","过了一会,一艘大船向你驶来,你不禁放心了很多(官府在后勤保障上还不错)\n",this_object());
	message("vision","船夫说道：“上船吧！”\n",this_object());
	boat->set("exits/up",__DIR__"island");
	boat->set("no_fight",1);
	boat->set("no_magic",1);
	set("exits/down",__DIR__"boat");
	call_out("boat_leave",10,boat);
}
void boat_leave(object boat)
{
	if (query("exits/down")) delete("exits/down");
	if (boat->query("exits/up")) boat->delete("exits/up");
	message("vision","大船船身抖了一下,船就离开了海岸。\n",this_object()); 
	boat->set_temp("mark/dest","mainland");
	message("vision","大船船身抖了一下,船就离开了海岸。\n",boat);
	boat->delete("no_fight");
	boat->delete("no_magic");
	boat->boat_run(0);
}
