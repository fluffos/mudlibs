#include <ansi.h>

inherit ROOM;
void create() {
  set("short", "内院门");
  set("long", @LONG
这是一个极干净,也很清净的地方,你万没料到在杀机重重的武士院中
会有如此一个清闲之地.但这里是武士院的禁地,很少有人能活着到这里来,
更没有敌人能活着走出去.
LONG
  );
  set("exits", ([
    "east": __DIR__ "neiyuan1",
    "west": __DIR__ "mulang7",
  ]));
  set("no_fight", 1);
  set("no_magic", 1);
  set("no_dazuo", 1);
  set("objects", ([
    __DIR__ "npc/laotou": 1,
  ]));

  set("coor/x", 0);
  set("coor/y", 0);
  set("coor/z", 0);
  setup();
}

void init() {
  object me;
  me = this_player();
  if (interactive(me))
    me->set_temp("shatime", time());
  add_action("do_quit", "quit");
  me->delete_temp("befound");
}

int valid_leave(object me, string dir) {
  int i;
  object *inv, ro;

  if ((time() - me->query_temp("shatime")) < 1200) {
    return 1;
  }

  message_vision(HIY "$N突然发现四面八方涌来无数的持刀武士,他们叫嚷这向你$N冲来.\n\n" NOR, me);
  message_vision(HIR "尽管奋力的抵抗着，但突然一个武士从$N的背后闪出,并用手刀重重的砍在了$N的脖子上。\n" NOR, me);
  me->unconcious();
  message_vision(HIY "一个武士对着晕倒的$N吐了口吐沫,然后进行了搜身.\n\n" NOR, me);
  inv = all_inventory(me);
  for (i = 0; i < sizeof(inv); i++) {
    destruct(inv[i]);
  }
  message_vision(HIY "两个武士把$N抬了出去。\n" NOR, me);
  ro = find_object(__DIR__ "dilao");
  if (!objectp(ro)) load_object(__DIR__ "dilao");
  me->move(ro);
  message("vision", HIY "两个武士把" + me->name() + "重重地撂到地上，然后转身离开了。\n" NOR, environment(me));
  return 0;
}

int do_quit() {
  message("vision", "这是一条不归路！\n", this_object());
  return 1;
}
