inherit NPC;
#include <ansi.h>
void create() {
  set_name("唐君伤", ({ "tang junshang", "jiushang" }));
  set("nickname", RED "镖不离手" NOR);
  set("long",
    "唐门唐君伤是唐门的老人物了，是唐方的二叔。据说他的暗器只失过一次手，\n"
    "就是那次对江湖奇侠萧秋水时，被萧秋水以忘情天书所破。");

  set("gender", "男性");
  set("age", 56);
  set("attitude", "peaceful");
  set("str", 42);
  set("int", 35);
  set("con", 40);
  set("per", 30);
  set("agi", 45);

  set("chat_chance_combat", 90);
  set("chat_msg_combat", ({
    (: perform_action, "throwing.qizigangbiao" :),
    (: perform_action, "dodge.rain" :),
    (: perform_action, "blade.banlanwushi" :),
  }));
  set("attitude", "friendly");
  set("max_force", 35000);
  set("force", 35000);
  set("force_factor", 35);
  set("max_kee", 29999);
  set("max_gin", 500);
  set("max_sen", 1000);

  set("chat_chance", 1);
  set("chat_msg", ({
    "唐君伤看看唐君秋。\n",
  }));


  set_skill("force", 150);
  set_skill("tangforce", 120);
  set_skill("dodge", 120);
  set_skill("parry", 100);
  set_skill("throwing", 130);
  set_skill("move", 140);
  set_skill("blade", 120);
  set_skill("tang-blade", 120);
  set_skill("tang-throwing", 120);
  set_skill("tang-steps", 120);

  map_skill("dodge", "tang-steps");
  map_skill("force", "tangforce");
  map_skill("throwing", "tang-throwing");
  map_skill("blade", "tang-blade");

  create_family("唐门", 4, "弟子");
  set("combat_exp", 3000000);
  setup();
  carry_object(__DIR__ "obj/dafeng")->wield();
}
void init() {
  object me;

  ::init();
  if (interactive(me = this_player()) && !is_fighting() && !random(5)) {
    add_action("do_accept", "accept");
    call_out("greeting", 1, me);
  }

}
int greeting(object me) {
  message_vision(HIY "\n$N对$n说道：想入唐门？（accept yes/no）\n" NOR, this_object(), me);
  return 1;
}



int do_accept(string arg) {
  string name;
  if (arg != "yes" && arg != "no")
    return notify_fail("你要接受什么？\n");
  if (arg == "yes") {
    name = (string)this_player()->query("name");
    name = "唐" + name[2..];
    this_player()->set("name", name);
    this_player()->save();
    message_vision(HIY "$N说道：好！你想入唐门，咱们就是一家人了！\n" NOR, this_object());
    this_player()->set_temp("rutangmen", 1);
  } else
    command("sigh");
  return 1;
}
