// laodenuo.c 
inherit NPC;
#include <ansi.h>
void create() {
  set_name("唐刚", ({ "tang gang", "gang" }));
  set("nickname", RED "子母回旋镖" NOR);
  set("long",
    "唐门唐刚是唐方的表哥，平日他最疼爱这个妹妹了。他是年轻一代的好手。\n");
  set("gender", "男性");
  set("age", 27);
  set("attitude", "peaceful");
  set("str", 42);
  set("int", 35);
  set("con", 30);
  set("per", 30);
  set("agi", 45);

  set("chat_chance_combat", 90);
  set("chat_msg_combat", ({
    (: perform_action, "throwing.qizigangbiao" :),
    (: perform_action, "dodge.rain" :),
    (: perform_action, "blade.banlanwushi" :),
  }));
  set("attitude", "friendly");
  set("max_force", 25000);
  set("force", 25000);
  set("force_factor", 35);
  set("max_kee", 11999);
  set("max_gin", 999);
  set("max_sen", 999);

  set("kee", 11999);
  set("chat_chance", 1);
  set("chat_msg", ({
    "唐十六说：唐方，你这丫头又去哪了？\n",
  }));


  set_skill("force", 130);
  set_skill("tangforce", 100);
  set_skill("dodge", 100);
  set_skill("parry", 100);
  set_skill("throwing", 100);
  set_skill("move", 100);
  set_skill("blade", 100);
  set_skill("tang-blade", 100);
  set_skill("tang-throwing", 110);
  set_skill("tang-steps", 100);

  map_skill("dodge", "tang-steps");
  map_skill("force", "tangforce");
  map_skill("throwing", "tang-throwing");
  map_skill("blade", "tang-blade");
  create_family("唐门", 17, "弟子");
  set("combat_exp", 1670000);
  setup();
  carry_object(__DIR__ "obj/dart")->wield();
}
