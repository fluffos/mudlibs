// movebook.c

#include <armor.h>
#include <ansi.h>
inherit FINGER;


void create()
{
	set_name("戒指", ({ "ring" }));
	set_weight(1);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "枚");
                set("for_xiao",1);
		set("long",
			"一枚别致的戒指，是唐方随身之物，上刻一个‘唐’字。\n");
	set("value", 100000);
		set("armor_prop/armor", 10);
		set("armor_prop/personality", 3);
		set("wear_msg", "$N轻轻地把一个$n戴在手指上。\n");
		set("unwield_msg", "$N轻轻地把$n从手指上除了下来。\n");


	}
	setup();
}


