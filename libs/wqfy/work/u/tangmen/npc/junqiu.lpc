// laodenuo.c 

inherit NPC;
#include <ansi.h>
void create() {
  set_name("唐君秋", ({ "tang junqiu", "junqiu" }));
  set("nickname", RED "手不离镖" NOR);
  set("long",
    "唐门唐君伤是唐门的老人物了，是唐方的三叔。据说他的暗器只失过一次手，\n"
    "就是那次对江湖奇侠萧秋水时，被萧秋水以忘情天书所破。");

  set("gender", "男性");
  set("age", 56);
  set("attitude", "peaceful");
  set("str", 42);
  set("int", 35);
  set("con", 40);
  set("per", 30);
  set("agi", 45);

  set("chat_chance_combat", 90);
  set("chat_msg_combat", ({
    (: perform_action, "throwing.qizigangbiao" :),
    (: perform_action, "dodge.rain" :),
    (: perform_action, "blade.banlanwushi" :),
  }));
  set("attitude", "friendly");
  set("max_force", 35000);
  set("force", 35000);
  set("force_factor", 35);
  set("max_kee", 19999);
  set("max_gin", 500);
  set("max_sen", 1000);

  set("chat_chance", 1);
  set("chat_msg", ({
    "唐君伤看看唐君伤。\n",
  }));


  set_skill("force", 150);
  set_skill("tangforce", 120);
  set_skill("dodge", 120);
  set_skill("parry", 100);
  set_skill("throwing", 130);
  set_skill("move", 140);
  set_skill("blade", 120);
  set_skill("tang-blade", 120);
  set_skill("tang-throwing", 120);
  set_skill("tang-steps", 120);

  map_skill("dodge", "tang-steps");
  map_skill("force", "tangforce");
  map_skill("throwing", "tang-throwing");
  map_skill("blade", "tang-blade");
  create_family("唐门", 4, "弟子");
  set("combat_exp", 3000000);
  setup();
  carry_object(__DIR__ "obj/dart")->wield();
}
