// laodenuo.c 

inherit NPC;
#include <ansi.h>
void create() {
  set_name("唐三十", ({ "tang sanshi", "sanshi" }));
  set("nickname", RED "袖里风云" NOR);
  set("long",
    "唐门唐三十是唐门负责看管护院的。\n");
  set("gender", "男性");
  set("age", 44);
  set("attitude", "peaceful");
  set("str", 18);
  set("int", 15);
  set("con", 20);
  set("per", 10);
  set("agi", 35);

  set("chat_chance_combat", 90);
  set("chat_msg_combat", ({
    (: perform_action, "throwing.tanghua" :),
    (: perform_action, "dodge.rain" :),
  }));
  set("attitude", "friendly");
  set("max_force", 7000);
  set("force", 7000);
  set("force_factor", 16);
  set("max_kee", 999);
  set("max_gin", 999);
  set("max_sen", 999);
  set("eff_kee", 999);
  set("kee", 999);
  set("chat_chance", 1);
  set("chat_msg", ({
    "唐三十叹了口气。\n",
  }));


  set_skill("force", 60);
  set_skill("tangforce", 60);
  set_skill("dodge", 60);
  set_skill("parry", 70);
  set_skill("throwing", 100);
  set_skill("move", 100);
  set_skill("blade", 40);
  set_skill("tang-blade", 60);
  set_skill("tang-throwing", 80);
  set_skill("tang-steps", 60);

  map_skill("dodge", "tang-steps");
  map_skill("force", "tangforce");
  map_skill("throwing", "tang-throwing");
  map_skill("blade", "tang-blade");
  create_family("唐门", 20, "弟子");
  set("combat_exp", 1670000);
  setup();
  carry_object(__DIR__ "obj/dart")->wield();
}
