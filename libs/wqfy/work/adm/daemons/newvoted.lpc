#include <ansi.h>
inherit F_DBASE;
void vote(object ob,object me);
int vote_list(object ob1,object ob2);
void start_vote();
private void count_time(int min);
void count_vote();

void create()
{
	seteuid(ROOT_UID);
	message("system", HIY"【天神频道】"HIR"\n\n各位玩家：我们巫师要求大家对以下问题作出投票:\n\n"+read_file("/log/newvote")+
HIR"\n请选择投票是(ynvote yes) 或者否  (ynvote no)。\n\n"NOR, users());
	start_vote(); // 开始投票！
}

void start_vote()
{
	message("system",HIY"【天神频道】"HIG"各位玩家，别急，您有现实10分钟时间供您决定投什么的票。\n" NOR,users());
	set_temp("voting",1); // 现在正在投票
        call_out("count_time",20,1); // "10"是指整个投票时间10分钟，可以自己修改
}

private void count_time(int min)
{
	min--;
	if( min ) {
                message("system",HIY"【天神频道】"HIG"各位玩家，别急，您还有现实" + chinese_number(min) +"分钟的时间，想好了再投！\n"NOR,users() );
		call_out("count_time", 10, min); // 告诉大家还有几分钟时间
	} else {
                message("system",HIY"【天神频道】"HIG"本次投票活动已经圆满结束。现在工作人员正在紧张计票中。\n"NOR,users() );
		call_out("count_vote", 3); // 到点啦
	}
}
void count_vote()
{
        object *list, *ob, ob1;
	string msg;
        int i, ppl_cnt,player_cnt;
        int opt_yes,opt_no;
        ob = users();
         ob = filter_array(children(USER_OB),(: userp :));
               ppl_cnt = 0;
                i = sizeof(list);
        list = sort_array(ob,"sort_user");
                while( i-- ){
                        if(opt_yes && list[i]->query("gender")!="男性") continue;
                        if(opt_no && list[i]->query("gender")!="女性") continue;
                        ppl_cnt++;
                        player_cnt++;

        msg =  CYN"\n          "+WHT+MUD_NAME+"投票结果"CYN"\n";
	msg += CYN"┏━━━━━━┯━━━━━━━━┓\n";
	msg += CYN"┃    "RED"选项"CYN"    │      "RED"票数 "CYN"     ┃\n";
	msg += CYN"┠──────┴────────┨\n";
		msg += sprintf(CYN"┃     "WHT"是"CYN"     │"HIR+"   %5d  "+NOR+CYN"               ┃\n"，i);
		msg += sprintf(CYN"┃     "WHT"否"CYN"     │"HIR+"   %5d  "+NOR+CYN"               ┃\n",i);
	msg += WHT"┗━━━━━━━━━━━━━━━┛\n";
	msg += HIY+"\n本次投票由于大家的努力我们圆满完成了。\n"NOR;
	delete_temp("voting"); // 投票结束！
	message("system",msg,users());
	return;
}
