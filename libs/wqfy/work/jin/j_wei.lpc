inherit F_CLEAN_UP;
#include <ansi.h> 
int find_allbing(string str);
int find_mybing(object me, string str, int show_position);

int main(object me, string arg)
{
   string QINBING_FILE = "/d/jin/npc/wei.lpc";
   object qinbing;
   int max_bing = 0;
   int current_bing = 0;

   seteuid(getuid());

   if( arg == "find" )
   {
     if (!wizardp(me))
        return notify_fail("只有巫师才能用这个选项。\n");
     else return find_allbing(QINBING_FILE);
   }   

   if( (string)me->query("family/family_name") !=RED"朝廷"NOR)
         return notify_fail("你并非锦衣卫，哪有资格召唤其他卫士。\n");
   
   if(me->query("combat_exp") >= 5000000)
   {
     max_bing = 4;
   }
   else if(me->query("combat_exp") >= 4000000)
   {
     max_bing = 2;
   }
   else if(me->query("combat_exp") >= 3000000)
   {
     max_bing = 1;
   }
   else max_bing = 0;

   if( max_bing < 1 ) 
         return notify_fail("你目前还没有资格召唤其他卫士。\n");

   current_bing = find_mybing(me, QINBING_FILE, 0);
   
   me->set_temp("jjf_current_bing", current_bing+1);

   if( (int)me-> query_temp("jjf_current_bing") > max_bing )
     return notify_fail("按你的级别，召唤其他卫士的规格不能再高了。\n");
   
   //if( (int)me->query("balance") < 10000)
   //{
    // return notify_fail("你现在没有足够的金钱来让其他卫士帮你了\n");
   //}   
   //me->set("balance",  (int)me->query("balance")-10000);   //me->save();

 
   message_vision(YEL"$N拿出一个笛子使劲的吹了一声：“嘟……嘟……\n"NOR, me);
   qinbing = new(QINBING_FILE);
   qinbing->move(environment(me));
   qinbing->show(me);

       return 1;
}
 
int find_allbing(string str)
{
   object *list;
   int number;
   object where;
   int i, count;
   
   count = 0;

   if(!str) return 0;

   list = children(str);
   number = sizeof(list);

   if(number) 
   {
     for(i=0; i<sizeof(list); i++) 
     {
        write((int)(i+1)+". "+file_name(list[i])+" "+
          list[i]->query("name")+"("+list[i]->query("id")+") is at ");
        where=environment(list[i]);
        if(where) 
        {
          if(where->query("short")) 
          {
             write(where->query("short"));
          } 
          else 
          {
             write(where->short());
          }
          write("("+file_name(where)+"), " );
          write("owner_id: " + list[i]->query("owner_id") + "\n");
        } 
        else 
        {
          write("???, ");
          write("owner_id: " + list[i]->query("owner_id") + "\n");
        }
     }
   }
   
   count = number;
   write("\n共有" + count + "个卫士。\n");
   return count;
}

int find_mybing(object me, string str, int show_position)
{
   object *list;
   int number;
   object where;
   int i, count;
   
   count = 0;

   if(!str) return 0;

   list = children(str);
   number = sizeof(list);

   if(number) 
   {
     for(i=0; i<sizeof(list); i++) 
     {
        if( (string)list[i]->query("owner_id") != (string)me->query("id") )
          continue;
        count++;
        if(!show_position) continue;

        //now also show position.
        write(list[i]->query("name")+"在");
        where=environment(list[i]);
        if(where) 
        {
          if(where->query("short")) 
          {
             write(where->query("short"));
          } 
          else 
          {
             write(where->short());
          }
          write("\n");
        } 
        else 
        {
          write("？？？");
          write("\n");
        }
     }
   }
   
   return count;
}


int help(object me)
{
    write(@HELP
指令格式: j_wei (巫师可用j_wei find) 
 
大内锦衣位可以用特殊的笛音召唤其他卫士来帮忙，
当然，没钱是没人愿意帮你的，没有钱亲兄弟也不亲了。
可用whisper对亲兵下命令。例如，如果你的亲兵叫ttt-jia，用
whisper ttt-jia kill xiao er即可命令他杀店小二。

HELP
    );
   return 1;
}