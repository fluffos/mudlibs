#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target)
{
        string msg;
        int extra;
        object weapon;
        if(me->is_busy())
                return notify_fail("你现在没空！！\n");

        if (me->query("class") != "official")
		return notify_fail("你不是朝廷中人，使不出这玉环索命拳！\n");

        extra = me->query_skill("changquan",1);
        if ( extra < 259) return notify_fail("你的少林长拳还不够纯熟！\n");
        if( !target ) target = offensive_target(me);
        if( !target
        ||      !target->is_character()
        ||      !me->is_fighting(target) )
             return notify_fail("『玉环索命拳』只能对战斗中的对手使用。\n");
     me->add_temp("apply/attack",extra);
     me->add_temp("apply/damage",extra*3);
        weapon = me->query_temp("weapon");
        msg = HIY  "$N使出少林长拳中的 "+BLINK HIM+"『玉环索命拳』"+NOR HIY+"，一招连环八式向$n攻出！\n" NOR;            
  COMBAT_D->do_attack(me,target,me->query_temp("weapon"),TYPE_REGULAR,msg);

        msg = BLINK HIY  "『黑虎掏心』！\n" NOR;
        msg += HIY"$N左手收肘，右手一拳直朝$n击去！\n"NOR;
  COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);

        msg = BLINK HIR  "『左勾右搭』！\n" NOR;
        msg += HIR"$N左一拳，右再一拳，双打$n两侧！ \n"NOR;
  COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);

        msg = BLINK HIG  "『中宫直进』！\n" NOR;
        msg += HIG"$N左手加招，右手一拳直击$n$l！ \n"NOR;
  COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);

        msg = BLINK HIC  "『泰山压顶』！\n" NOR;
        msg += HIC "$N一拳将$n击退：回转身！双手紧握，朝$n$l捶下！ \n"NOR;
  COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);

        msg = BLINK HIM  "『老汉推车』！\n" NOR;
        msg += HIM"$N玩起了流氓招式：双手直掏$n下面命门！ \n"NOR;
  COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);

        msg = BLINK HIB  "『长虹锥顶』！\n" NOR;
        msg += HIB"$N扬起拳头，不在意的向$n捶去！ \n"NOR;
  COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);

        msg = BLINK HIW  "『暴走乾坤』！\n" NOR;
        msg += HIW"$N移形幻影，双手化作无数拳影，盖向$n！ \n"NOR;
  COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
        me->add_temp("apply/attack",-extra);
        me->add_temp("apply/damage",-extra*3);

        me->add_temp("apply/attack",extra*5);
        me->add_temp("apply/damage",extra*6);
        msg = BLINK HIY  "『再最后一拳』！！\n" NOR;
        msg += HIR"$N深吸一口气，提起全身内力！！！\n"NOR;
        msg += HIR"“嘿”的一声，朝$n全身各个部位击去！！！！ \n"NOR;
  COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);   
            me->start_busy(3);
  me->add_temp("apply/attack",-extra*5);
  me->add_temp("apply/damage",-extra*6);

        return 1;
}
