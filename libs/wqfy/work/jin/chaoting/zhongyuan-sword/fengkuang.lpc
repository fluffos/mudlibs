#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>

inherit SSERVER;
 
int perform(object me, object target)

{
	object weapon, ob;
        string msg, string1;
        int count;
 if( !target ) target = offensive_target(me);

	if( !me->is_fighting() )
		return notify_fail("『疯狂剑雨』只能在战斗中使用。\n");
 

	if (!objectp(weapon = me->query_temp("weapon"))
	|| (string)weapon->query("skill_type") != "sword")
		return notify_fail("『疯狂剑雨』施展时必须拿着一把剑！\n");

	if( (int)me->query("force") < 200 )
		return notify_fail("你的内力不够！\n");

	if( (int)me->query_skill("sword") < 70 ||
	    me->query_skill_mapped("sword") != "zhongyuan-sword")
		return notify_fail("你的中原第一剑还不到家，无法使用『疯狂剑雨』！\n");

	msg = HIY "$N使出中原第一剑绝技『疯狂剑雨』，身法陡然加快！只见剑影如暴风骤雨，急泄而下。" NOR;
	COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0,msg);
	msg = HIB "～～～第一剑"NOR;
	COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0,msg);
	msg = HIR "～～～第二剑"NOR;
	COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0,msg);
	msg = HIW "～～～第三剑"NOR;
	COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0,msg);
	msg = HIG "～～～第四剑"NOR;
	COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0,msg);
	msg = HIC+BLINK "疯狂剑雨～～～最后一剑"NOR;
	COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0,msg);

	me->add("force", -50);
        me->start_busy(2);
 
	return 1;
}