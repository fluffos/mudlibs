#include <ansi.h>
#include <armor.h>

inherit CLOTH;

void create() {
  set_name(WHT "锦衣" NOR, ({ "jinyi" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("long", WHT "这是一件用锦缎缝成的衣服,质地高贵，更显出此人的不一般。：\n"
      CYN "上面用" YEL "金丝" CYN "绣着几个字：" YEL "大内东场锦衣卫\n" NOR);
    set("material", "cloth");
    set("value", 1000);
    set("armor_prop/armor", 5);
    set("wear_msg", WHT "$N利索地把$n" WHT "穿在身上，嘴角冷酷的笑了一笑。\n" NOR);
    set("unequip_msg", WHT "$N轻轻地把$n" WHT "脱了下来，嘴角还带着那冷酷的微笑。\n" NOR);
  }
  setup();
}
