//TIE@FY3
#include <ansi.h>
#include <weapon.h>
inherit SWORD;
void create() {
  set_name(WHT "锦剑" NOR, ({ "jsword" }));
  set_weight(7000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("value", 1000);
    set("long", CYN "这是一口遍体通黑的剑，剑身上用" YEL "金丝" CYN "锩着几个字：\n"
      WHT "大内东场锦衣卫\n" NOR);
    set("material", "steel");
    set("wield_msg", WHT "$N冷笑一声，将$n" WHT "缓缓抽出剑鞘。\n" NOR);
    set("unwield_msg", WHT "$N右手一晃，$n" WHT "已然回鞘。\n" NOR);
  }
  init_sword(25);
  setup();

}
