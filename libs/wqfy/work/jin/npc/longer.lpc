#include <ansi.h>
inherit NPC;
void create()
{
        set_name("龙二", ({"master longer","longer","master"}));
        set("long",
                CYN"他统领锦衣卫的总教头，奉皇帝的命令，来到风云城物色新一带的锦衣卫士。\n"NOR);
        set("nickname", RED"誓死效忠"NOR);
         set("title", "锦衣卫总教头");
        create_family(RED"朝廷"NOR,1,"新卫");

        set("str", 47);
        set("cor", 46);
        set("cps", 45);
        set("agi",45);
        set("int",40);
        set("attitude","friendly");
        set("max_force", 15000);
        set("force", 15000);
        set("force_factor", 100);
        set("chat_chance_combat", 90);
        set("chat_msg_combat", ({
                 "龙二冷笑一声道：雕虫小技还敢跟本教头撒野。\n",
             (: perform_action, "sword.tianxiabajian" :),
                      (: perform_action, "dodge.shimianmaifu" :),

        }) );
        set("combat_exp", 1000000000);
        set_temp("apply/damage",500);
        set_skill("unarmed", 250);
        set_skill("sword",210);
        set_skill("force",230);
        set_skill("parry",220);
          set_skill("shimian-steps",180);
        set_skill("dodge",200);
        set_skill("jingyiforce",180);
        set_skill("move",230);
        set_skill("literate",250);
        set_skill("danei-sword",200);
        set_skill("changquan",300);
        map_skill("unarmed","changquan");
        map_skill("force","jingyiforce");
        map_skill("sword","danei-sword");
        map_skill("parry","danei-sword");
              map_skill("move","shimian-steps");
              map_skill("dodge","shimian-steps");
         
             setup();

        carry_object(__DIR__"obj/jinpao")->wear();
        carry_object(__DIR__"obj/jsword")->wield();

}

void attempt_apprentice(object ob)
{
        call_out("do_recruit", 1, ob);
}

void recruit_apprentice(object ob)
{
        if( ::recruit_apprentice(ob) )
                ob->set("class", "official");
           //                 ob->add("betrayer",-1);

}
void do_recruit(object ob)
{
 
   if (ob->query("class") != "official")

 {
  command("sigh");
  command("say 皇上下旨，为了防止奸细混入，只从朝廷官员中选拔人才，你还是请回吧。\n");
  return;
 }
if((int)ob->query("combat_exp")<3000000) 
 {
  command("say 嘿嘿，你的心意我替皇上领了，你还是到衙门去多锻炼几年再来吧！\n");
  return;
 }
 command("smile");
 command("say 很好，皇上命我招收一批新卫士，你要发誓誓死效忠皇上。\n");
 command("recruit " + ob->query("id") );
}

void init()
{
        add_action("give_quest", "quest");
}

void re_rank(object student)
{
        int exp;
        exp = (int) student->query("combat_exp");
        if( exp <= 3000000 ) {
                student->set("title",WHT"锦衣卫 "CYN"新卫"NOR);
                return ;
        } else if ( exp <= 3500000) {
                student->set("title",HIC"青带 "WHT"锦衣卫"NOR);
                return ;
        } else if ( exp <= 4000000 ) {
                student->set("title",HIB"蓝带 "WHT"锦衣卫"NOR);
                return ;
        } else if ( exp <= 4500000 ) {
                student->set("title",MAG"紫带 "WHT"锦衣卫"NOR);
                return ;
        } else if ( exp <= 5000000 ) {
                student->set("title",HIG"绿带 "WHT"锦衣卫"NOR);
                return ;
        } else if ( exp <= 5500000 ) {
                student->set("title",HIW"白带 "WHT"锦衣卫"NOR);
                return ;
        } else if ( exp <= 6000000 ) {
                student->set("title",HIY"黄带"WHT"锦衣卫"NOR);
                return ;
        } else if ( exp <= 7000000 ) {
                student->set("title",HIY"五"HIG"彩"HIR"锦"HIC"衣"HIW"卫"NOR);
                return ;
        } else
                student->set("title",BLINK HIY"御前"HIR"带刀"HIM"侍卫"NOR);
                return ;

}
