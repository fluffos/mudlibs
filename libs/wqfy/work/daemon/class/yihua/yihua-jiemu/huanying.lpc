// 「幻影风沙」
// edit by xgchen 2002-03
#include <ansi.h>
inherit SSERVER;
#include <combat.h>
int perform(object me, object target) {
  int damage;
  string msg;
  object weapon;
  int extra;
  extra = me->query_skill("yihua-jiemu", 1);
  if (!target) target = offensive_target(me);
  if (!target || !target->is_character() || !me->is_fighting(target))
    return notify_fail("「幻影风沙」只能对战斗中的对手使用。\n");
  if ((int)me->query_skill("mingyu-shengong", 1) < 300)
    return notify_fail(RED "你明玉神功火候不够。\n" NOR);
  if ((int)me->query_skill("yihua-jiemu", 1) < 800)
    return notify_fail(WHT "你移花接木不够娴熟，使不出「幻影风沙」。\n" NOR);
  if ((int)me->query("force") < 400)
    return notify_fail(RED "你内力修为不足，无法运足内力。\n" NOR);
  if ((int)me->query("force") < 3000) {
    return notify_fail(HIC "你现在内力不够，没能将「幻影风沙」使完！\n" NOR);
  }
  if (target->is_busy())
    return notify_fail(target->name() + "目前正自顾不暇，放胆攻击吧。\n");

  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "sword")
    msg = HIC "$N身型急转，内劲带起无数沙尘，幻化无数影子，团团围住$n。\n" NOR;
  else
    msg = HIC "$N手中$w一振，剑身狂挥，风沙飞舞,幻化无数影子，团团围住$n。\n" NOR;
  if (random(10) > 2 && extra > ((int)target->query_skill("yihua-jiemu", 1) * 2)) {
    me->start_busy(1);
    target->start_busy(random(4));
    damage = (int)me->query_skill("yihua-jiemu", 1) + (int)me->query_skill("dodge", 1) / 2;
    damage = damage / 2 + random(damage);
    target->receive_damage("kee", damage);
    target->receive_wound("kee", damage / 2);
    me->add_temp("apply/attack", extra * extra);
    me->add_temp("apply/damage", extra * extra / 2);
    msg += HIC "$n只看到无数$N的影子，双目被风沙狂击，顿时长声痛极而呼！\n" NOR;
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
    me->set_temp("yihua-jiemu/huanying", 1);
    target->set_temp("block_msg/all", 1);
    target->start_busy(random(6) + 2);
    me->add_temp("apply/attack", -extra * extra);
    me->add_temp("apply/damage", -extra * extra / 2);
    call_out("huanying_end", (int)2 + random(6), me, target);
  } else {
    msg += HIY "$n闭目耸耳，用心灵感觉$N的位置，不顾一切向$N攻去,化解了$N的攻势。\n" NOR;
    me->start_busy(2);
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  }
  if (!target->is_fighting(me)) target->fight_ob(me);
  return 1;
}
void huanying_end(object me, object target) {
  if (!target) target = offensive_target(me);
  if (target) {
    message_vision(HIC "$N思想开始清醒，风沙也停止了。\n" NOR, target);
    target->set_temp("block_msg/all", 0);
  }
  me->delete_temp("yihua-jimu/huanying");
  return;
}
