// tie@fengyun
#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target) {
  string msg;
  int extra;
  int orforce;
  object weapon;
  extra = me->query_skill("unarmed");
  if (extra < 400) return notify_fail("你的解深密拳还不够纯熟！\n");
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("［妙行无住］只能对战斗中的对手使用。\n");
  me->add("force_factor", extra / 5);
  orforce = (int)me->query("force");
  me->add("force", extra / 5 * 100);
  me->add_temp("apply/attack", extra);
  weapon = me->query_temp("weapon");
  msg = HIY "$N使出解深密拳中的［妙行无住］，好象有六个身影闪向$n！\n" NOR;
  message_vision(msg, me, target);
  msg = HIY "  色！" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = HIY "    声！" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = HIY "        香！" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = HIY "              味！" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = HIW "                  触" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = HIW "                      法" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);

  me->start_busy(0);
  me->set("force_factor", 0);
  me->set("force", orforce);
  me->add_temp("apply/attack", -extra / 10);
  return 1;
}
