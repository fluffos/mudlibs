// LLY@FYSY
#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target) {
  int ap, dp;
  string msg;
  int extra;
  object weapon;
  extra = me->query_skill("duo-sword", 1);
  if (extra < 220) return notify_fail("你的夺命连环剑法还不够纯熟！\n");
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("［夺命连环剑］只能对战斗中的对手使用。\n");
  weapon = me->query_temp("weapon");
  msg = HIR "$N轻描淡写，挥尘如意，一瞬间就已使出夺命十三式，手中的" + weapon->name() + "轻灵流动，就像是河水般的向$n刺出第一剑!\n\n" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = HIR "------>>>>>>第二剑<<<<<<------" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = HIR "------>>>>>>第三剑<<<<<<------" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = HIR "------>>>>>>第四剑<<<<<<------" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = HIR "------>>>>>>第五剑<<<<<<------" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = HIR "------>>>>>>第六剑<<<<<<------" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = HIR "------>>>>>>第七剑<<<<<<------" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = HIR "------>>>>>>第八剑<<<<<<------" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = HIR "------>>>>>>第九剑<<<<<<------" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = HIR "------>>>>>>第十剑<<<<<<------" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = HIR "------>>>>>>第十一剑<<<<<<------" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = HIR "------>>>>>>第十二剑<<<<<<------" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = HIR "------>>>>>>第十三剑<<<<<<------" NOR;
  msg += CYN "\n$N的第十三剑刺出后，所有的变化都似已穷尽，又像是流水已到尽头，剑势也慢了，很慢。\n\n" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = HIC "虽然慢，却还是在变，$N忽然一剑挥出，不著边际，不成章法。";
  msg += "\n但是这一剑却像是画龙点晴，虽然空，却是所有转变的枢纽。" NOR;
  msg += HIR "\n然后$N就刺出了夺命十三剑的第十四剑-------------------------------------------
\n\n" NOR;
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);

  msg = RED "$N的剑气和杀气都很重，宛如满天岛云密布。这一剑刺出，忽然间就将满天乌云都拨开了，现出了阳光。";
  msg += "\n这一剑刺出，所有的变化才真的已到了穷尽，本已到了尽头的流水，现在就像是已完全枯竭，$N的力也已竭了。\n\n" NOR;
  if (target->query("disable_type") == HIW "<冻僵中>" NOR)
    return notify_fail("你现在无法用夺命十四式的剑势逼迫对方！\n");
  ap = me->query_skill("sword");
  ap = (ap * ap / 100 * ap / 40) * (int)me->query("sen");
  dp = target->query("combat_exp");
  if (random(ap + dp) > dp) {
    msg += "$n被$N的剑势所迫，动弹不得！\n";
    target->set_temp("disable_inputs", 1);
    target->set("disable_type", HIW "<冻僵中>" NOR);
    target->set_temp("is_unconcious", 1);
    seteuid(ROOT_UID);
    target->start_call_out((: call_other, __FILE__, "remove_frozen", target :),
      random((int)me->query_skill("sword") / 30) + ((int)me->query_skill("sword") / 30));
  } else
    msg += "但是$n并不惧于$N的剑势。\n";

  message_vision(msg + NOR, me, target);

  me->start_busy(8);
  return 1;
}
void remove_frozen(object me) {
  me->delete("disable_type");
  me->delete_temp("disable_inputs");
  me->delete_temp("is_unconcious");
  if (!me->is_ghost())
    message_vision(HIR "\n\n$N一声低吟，身行一顿,飞出剑光的笼罩之中！！\n\n" NOR, me);
}
