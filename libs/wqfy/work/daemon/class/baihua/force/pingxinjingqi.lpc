// recover.c

inherit SSERVER;

int exert(object me, object target, int amount)
{
        int force, lvl;
        if( target != me ) return 
        notify_fail("你只能运用净神真气将自己体内毒素逼出。\n");
        force =(int) me->query("force") - (int) me->query("max_force");
        if( force <=100) return notify_fail("你的真气不足。\n");
        lvl = me->query_skill("iceheart",1);
        if (random(lvl) < 20)
        {               me->add("force", -100  );
                        message_vision("$N运功抗毒，一团白雾在$N头上缓缓升起．．．\n", me);
                        return notify_fail("你觉得体内的气息流动,带走了毒素，你驱毒成功了。\n");
                        me->clear_condition();
        }
        else
        {

        me->clear_condition();  
                write("你觉得体内的气息流动，带走了毒素，你成功了！\n");
        return 1;
        }
}
