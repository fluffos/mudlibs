// lmd@wenxin
#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target) {
  string msg;
  int extra;
  extra = me->query_skill("liuyun-steps", 1);
  if (extra < 50) return notify_fail("你的［流云步法］还不够纯熟！\n");
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("［行云流水］只能对战斗中的对手使用。\n");
  if (target->is_busy())
    return notify_fail(target->name() + "已经晕头转向了！\n");
  message_vision(HIW "$N身如行云, 脚似流水，动作飘逸俊秀，而且$n的一举一动，早已被$N看破！\n", me, target);
  if (random((int)target->query("combat_exp")) < (int)me->query("combat_exp")) {

    message_vision(HIR "$N被带得晕头转向，步伐散乱，气息越来越重！！\n" NOR, target);
    target->start_busy(2);
  } else {
    message_vision("麻烦来了，$N处处受挫！\n", me);
    me->start_busy(2);
  }
  return 1;
}
