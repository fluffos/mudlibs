#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target)
{
        string msg;
        int extra,i,lmt;
        object weapon;
        extra = me->query_skill_eff_lvl("huanyu-blade",1);
        if ( extra < 200) return notify_fail("你的幻雨刀法还不够纯熟！\n");
        if( !target ) target = offensive_target(me);
        if( !target
        ||      !target->is_character()
        ||      !me->is_fighting(target) )
                return notify_fail("［流云戏雨］只能对战斗中的对手使用。\n");
        weapon = me->query_temp("weapon");
       msg = HIR  "$N长叹一声，加紧手中"+ weapon->name()+  "攻势，使出唤雨刀法中的不传绝学  ****  流云戏雨 ****！\n\n" NOR;
        message_vision(msg,me,target);
        msg = HIC  "$N刀光晃动不定，手中的"+ weapon->name()+  "一招[云飘飘兮，欲听雨] ，飘渺不定的向$n攻来！" NOR;
      me->add_temp("apply/attack",extra*10);
       me->add_temp("apply/damage",extra*10);
        message_vision(msg,me,target);
        lmt = random(3)+1;
        for(i=1;i<=lmt;i++)
        {
        msg =  HIC "听雨"+chinese_number(i)+"势！" NOR;
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
        }
       msg = HIW  "$N身形如梦似烟，手中的"+ weapon->name()+  "一招[云横横兮，欣观雨]， 狂风暴雨的向$n卷来！" NOR;
        message_vision(msg,me,target);
        lmt = random(3)+1;
        for(i=1;i<=lmt;i++)
        {
        msg =  HIW "观雨"+chinese_number(i)+"势！" NOR;
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
        }
       msg = HIY  "$N神情看似凝重，微探手中"+ weapon->name()+  "一招[云重重兮，凝思雨]，虚虚实实的响$n砍来！" NOR;

        message_vision(msg,me,target);
        lmt = random(3)+1;
        for(i=1;i<=lmt;i++)
        {
        msg =  HIY "思雨"+chinese_number(i)+"势！" NOR;
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
        }
       msg = HIB  "$N目露突露神采，反撩手中"+ weapon->name()+  "一招[云开开兮，喜悟雨]，如风似电的$n卷来！" NOR;
        message_vision(msg,me,target);
        lmt = random(3)+1;
        for(i=1;i<=lmt;i++)
        {
        msg =  HIB "悟雨"+chinese_number(i)+"势！" NOR;
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
        }
           me->add_temp("apply/attack",-extra*10);
       me->add_temp("apply/damage",-extra*10);
   me->start_busy(4);
        return 1;
}