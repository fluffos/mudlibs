// LLY@FYSY
inherit SKILL;
mapping *action = ({
        ([      "action":               
"$N手中$w的随风而出，一招「绝命」，$n被笼罩在一片剑光之中",
		"force" :		100,
                "damage_type":  "刺伤"
        ]),
        ([      "action":               
"$N使出夺命十三剑中的「夺命」，手中$w有如青虹，直划$n的$l",
                "force":               140,
                "damage_type":  "割伤"
        ]),
        ([      "action":               
"$N一招「丧命」，$w化作奇异的弧线直取$n的$l",
                "force":               170,
                "damage_type":  "割伤"
        ]),
        ([      "action":               
"$N手中$w虚实相间，一式「亡命」，向$n的$l劈出",
                "force":                110,
                "damage_type":  "割伤"
        ]),
        ([      "action":               
"$N手中$w无影无踪，突的一招「无命」对准$n$l一下刺去",
                "force":               120,
                "damage_type":  "刺伤"
        ]),
});

int valid_learn(object me)
{
        object ob;
        if( !(ob = me->query_temp("weapon"))
        ||      (string)ob->query("skill_type") != "sword" )
                return notify_fail("你必须先找一把剑才能练剑法。\n");
        return 1;
}

int valid_enable(string usage)
{
     return usage=="sword" || usage=="parry";
}

mapping query_action(object me, object weapon)
{
        return action[random(sizeof(action))];
}

int practice_skill(object me)
{
        if( (int)me->query("kee") < 40
        ||      (int)me->query("force") < 13 )
                return 
notify_fail("你的内力或气不够，没有办法练习夺命十三剑。\n");
        me->receive_damage("kee", 30);
        me->add("force", -13);
        write("你按著所学练了一遍夺命十三剑。\n");
        return 1;
}

string perform_action_file(string action)
{
        return CLASS_D("shenjian") + "/duo-sword/" + action;
}
 
int effective_level() { return 25;}

string *parry_msg = ({
        "却见$n大步上前，强攻$N的右肩，意欲迫退$N。\n",
        "$n剑势大开大合，招招皆攻往在$N的破绽，$N不得不退身而守！\n",
});

string *unarmed_parry_msg = ({
       "却见$n大步上前，强攻$N的右肩，意欲迫退$N。\n",
        "$n剑势大开大合，招招皆攻往在$N的破绽，$N不得不退身而守！\n",
});

string query_parry_msg(object weapon)
{
        if( weapon )
                return parry_msg[random(sizeof(parry_msg))];
        else
                return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}


int learn_bonus()
{
	return -100;
}
int practice_bonus()
{
	return -100;
}
int black_white_ness()
{
	return 30;
}


