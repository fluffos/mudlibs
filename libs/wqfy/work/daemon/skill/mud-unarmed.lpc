inherit SKILL;

////////////////////////////////

mapping *action = ({

  // ZHAOSHI :0

  ([
    "action": "$N身形突然加速，两拳却在加速中显的静止一样，$n感觉到「拳乱如麻」，只见$N的双拳攻向$n的$l",
    "damage": 50,
    "dodge": 10,
    "parry": 10,
    "damage_type": "瘀伤",
    "skill_name": "乱乱乱"
  ]),
  // ZHAOSHI :1

  ([
    "action": "$N前腿踢出，后腿脚尖点地，一式「出世」，二掌直出，攻向$n的$l",
    "damage": 80,
    "dodge": 15,
    "parry": 15,
    "damage_type": "瘀伤",
    "skill_name": "心烦乱"
  ]),
  // ZHAOSHI :2

  ([
    "action": "$N无聊的挥出一式「无聊」，二掌互相交击拍向$n的$l",
    "damage": 100,
    "dodge": 20,
    "parry": 20,
    "damage_type": "瘀伤",
    "skill_name": "无聊"
  ]),
  // ZHAOSHI :3

  ([
    "action": "$N前腿踢出，后腿脚尖点地，一式「出世」，二掌直出，攻向$n的$l",
    "damage": 130,
    "dodge": 25,
    "parry": 30,
    "damage_type": "瘀伤",
    "skill_name": "无聊"
  ]),
  // ZHAOSHI :4

  ([
    "action": "$N前腿踢出，后腿脚尖点地，一式「出世」，二掌直出，攻向$n的$l",
    "damage": 150,
    "dodge": 30,
    "parry": 40,
    "damage_type": "瘀伤",
    "skill_name": "发呆"
  ]),
  // ZHAOSHI :5

  ([
    "action": "$N前腿踢出，后腿脚尖点地，一式「出世」，二腿直出，攻向$n的$l",
    "damage": 180,
    "dodge": 40,
    "parry": 50,
    "damage_type": "瘀伤",
    "skill_name": "受累"
  ]),
  // ZHAOSHI :6

  ([
    "action": "$N两手往一起一合，一式「合击」，一手直出，攻向$n的$l",
    "damage": 200,
    "dodge": 50,
    "parry": 60,
    "damage_type": "瘀伤",
    "skill_name": "一手"
  ]),
  // ZHAOSHI :7

  ([
    "action": "$N前后腿踢出，两手直伸，一式「全面进击」，四肢直出，攻向$n的$l",
    "damage": 220,
    "dodge": 80,
    "parry": 70,
    "damage_type": "瘀伤",
    "skill_name": "理还乱"
  ]),
});
// ZHAOSHI :8
int valid_learn(object me) {
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练" + "泥潭乱拳" + "必须空手。\n");
  if ((int)me->query("max_force") < 50)
    return notify_fail("你的内力太弱，无法练" + "泥潭乱拳" + "。\n");
  return 1;
}
int valid_enable(string usage) { return usage == "unarmed" || usage == "parry"; }
int effective_level() { return 20; }
mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}
int practice_skill(object me) {
  if ((int)me->query("kee") < 30)
    return notify_fail("你的体力不够了，休息一下再练吧。\n");
  if ((int)me->query("force") < 30)
    return notify_fail("你的内力不够了，休息一下再练吧。\n");
  me->receive_damage("kee", 30);
  me->add("force", -30);
  return 1;
}
string *parry_msg = ({
  "$n利用身法引偏了$N的$w。\n",
});
string *unarmed_parry_msg = ({
  "$n轻描淡写的化解了$N的攻势。\n",
});
string query_parry_msg(object weapon) {
  if (weapon)
    return parry_msg[random(sizeof(parry_msg))];
  else
    return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}
int learn_bonus() {
  return 30;
}
int practice_bonus() {
  return -30;
}
int black_white_ness() {
  return 320;
}
string perform_action_file(string action) {
  return CLASS_D("player") + "/" + "unarmed" + "/" + action;
}
