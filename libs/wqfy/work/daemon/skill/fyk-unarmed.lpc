mapping *action = ({

  // ZHAOSHI :0

  ([
    "action": "$N飞身而起，化成如来佛主，双掌张开一招「生死轮回」，幻成一道金光笼罩$n$l",
    "damage": 50,
    "dodge": 10,
    "parry": 10,
    "damage_type": "瘀伤",
    "skill_name": "生死轮回"
  ]),
  // ZHAOSHI :1

  ([
    "action": "$N转了个身，使出第二招天道－－「乐不思蜀」，双拳发出一道银光，攻向$n$l",
    "damage": 80,
    "dodge": 15,
    "parry": 15,
    "damage_type": "瘀伤",
    "skill_name": "乐不思蜀"
  ]),
  // ZHAOSHI :2

  ([
    "action": "$N募然回首，双眼射出一道血红的光，第三招阿修罗道－－「有福无德」，射向$n$l",
    "damage": 100,
    "dodge": 20,
    "parry": 20,
    "damage_type": "瘀伤",
    "skill_name": "有福无德"
  ]),
  // ZHAOSHI :3

  ([
    "action": "人道－－「苦乐参半」，不等$n反应，第四招又狂卷而出，$n$l根本来不及躲避",
    "damage": 130,
    "dodge": 25,
    "parry": 30,
    "damage_type": "瘀伤",
    "skill_name": "苦乐参半"
  ]),
  // ZHAOSHI :4

  ([
    "action": "「愚痴无明」！，$n$l又重了$N的第五招－－畜生道，躺在底上开始呻吟",
    "damage": 150,
    "dodge": 30,
    "parry": 40,
    "damage_type": "瘀伤",
    "skill_name": "愚痴无明"
  ]),
  // ZHAOSHI :5

  ([
    "action": "然后$N头发一甩，一束白光飞出，第六招恶鬼道－－「饥渴难忍」！，蓬一声，$n$l和身体分了家",
    "damage": 180,
    "dodge": 40,
    "parry": 50,
    "damage_type": "瘀伤",
    "skill_name": "饥渴难忍"
  ]),
  // ZHAOSHI :6

  ([
    "action": "$N双手合并，开始讼经「苦痛无间」！，$n$l又复元，但是人已经痴呆呆了",
    "damage": 200,
    "dodge": 50,
    "parry": 60,
    "damage_type": "瘀伤",
    "skill_name": "苦痛无间"
  ]),
  // ZHAOSHI :7

  ([
    "action": "$N使处最后一招－－「天地轮回」！$n大彻大悟了，举起手中的兵器切向自己的$l，人也随精神消失而忘",
    "damage": 220,
    "dodge": 80,
    "parry": 70,
    "damage_type": "瘀伤",
    "skill_name": "天地轮回"
  ]),
});
// ZHAOSHI :8
int valid_learn(object me) {
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练" + "六道轮回" + "必须空手。\n");
  if ((int)me->query("max_force") < 50)
    return notify_fail("你的内力太弱，无法练" + "六道轮回" + "。\n");
  return 1;
}
int valid_enable(string usage) { return usage == "unarmed" || usage == "parry"; }
int effective_level() { return 20; }
mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}
int practice_skill(object me) {
  if ((int)me->query("kee") < 30)
    return notify_fail("你的体力不够了，休息一下再练吧。\n");
  if ((int)me->query("force") < 30)
    return notify_fail("你的内力不够了，休息一下再练吧。\n");
  me->receive_damage("kee", 30);
  me->add("force", -30);
  return 1;
}
string *parry_msg = ({
  "$n利用身法引偏了$N的$w。\n",
});
string *unarmed_parry_msg = ({
  "$n轻描淡写的化解了$N的攻势。\n",
});
string query_parry_msg(object weapon) {
  if (weapon)
    return parry_msg[random(sizeof(parry_msg))];
  else
    return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}
int learn_bonus() {
  return 30;
}
int practice_bonus() {
  return -30;
}
int black_white_ness() {
  return 320;
}
string perform_action_file(string action) {
  return CLASS_D("player") + "/" + "unarmed" + "/" + action;
}
