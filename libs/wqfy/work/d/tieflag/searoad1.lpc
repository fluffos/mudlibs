// searoad.c
inherit ROOM;
void create() {
  set("short", "海边路");
  set("long", @LONG
路面上的沙石越来越细，空气中弥漫着一股咸味，越往前走，咸味越明显。远处
隐隐传来波涛拍岸的声音。偶尔走过去一两个满脸水纹的老渔夫。
LONG
  );
  set("exits", ([
    "west": __DIR__ "searoad",
    "east": "/d/bat/lin1",
    "south": __DIR__ "seaside",
    "north": "/d/moondoor/gangwan",
  ]));
  set("objects", ([
    "/d/wiz/llx/newjob/npc/farmer6": 1,
    __DIR__ "npc/fishman": 1,
  ]));
  set("outdoors", "tieflag");
  set("coor/x", 1000);
  set("coor/y", -290);
  set("coor/z", -10);
  set("coor/x", 1000);
  set("coor/y", -290);
  set("coor/z", -10);
  set("coor/x", 1000);
  set("coor/y", -290);
  set("coor/z", -10);
  setup();
}
void init() {
  object room;
  object me;
  me = this_player();
  if (!wizardp(me) && ((int)me->query("OPK") > 0)) {
    if (!room = find_object("/d/tieflag/searoad"))
      room = load_object("/d/tieflag/searoad");
    this_player()->move(room);
  }
}
