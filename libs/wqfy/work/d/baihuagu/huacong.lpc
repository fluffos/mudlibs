inherit ROOM;

void create()
{
        set("short", "飘香花丛");
        set("long", @LONG
小路的尽头有一簇花丛。蜜蜂环绕飞舞。这里的花草(flower)似乎有些诡异。
LONG
        );
        set("exits", ([ 
  "south" : __DIR__"road3",
  "north" : __DIR__"road4",
]));
        set("objects", ([
                __DIR__"npc/bee" :2,
        ]) );

        set("item_desc", ([
                "flower": "这里的花草(flower)很密，但你似乎可以绕开(around)它们。\n",
                "花草": "这里的花草(flower)很密，但你似乎可以绕开(around)它们。\n"

        ]) );

        set("outdoors", "fengyun");
        set("coor/x",100);
        set("coor/y",1020);
        set("coor/z",0);
        set("coor/x",100);
        set("coor/y",1020);
        set("coor/z",0);
        setup();
}
void init()
{
        add_action("do_push", "around");
}
int do_push(string arg)
{
        object obj;
        object me;
        if(!arg || arg=="")
        {
                write("你要绕开什么？\n");
                return 1;
        }
        if( arg == "flower" || arg == "花草" || arg == "花")
        {
        me = this_player();
        message_vision("$N绕开路边的花草，发现了一条向西的路。\n", me);
        if(!me->query("m_success/铁雪"))
        {
                me->set("m_success/铁雪",1);
                me->add("score",70);

        }
        if( !query("exits/west") ) {
        set("exits/west", __DIR__"huacong1");
        call_out("close_path", 5);
        }
        return 1;
        }
        else
        {
                write("你不可以绕过"+arg+"\n");
                return 1;
        }
}
void close_path()
{
        if( !query("exits/west") ) return;
        message("vision",
"一阵风吹过，花草摇曳不定，淹没了向西的路。\n",
                this_object() );
                delete("exits/west");
}