inherit ROOM;
void create() {
  set("short", "百花谷中");
  set("long", @LONG
穿过花丛，你眼前豁然开朗。到处是盛开的鲜花，潺潺的流水打在光
滑的鹅卵石上，发出有节奏的响声，五彩的飞蝶四处飞舞，翠绿的不
知名的小鸟在枝头欢笑，好一处人间仙境。
。
LONG
  );
  set("exits", ([ /* sizeof() == 4 */
    "southup": __DIR__ "guwai",
  ]));
  set("objects", ([
    __DIR__ "npc/master": 1,
  ]));
  set("coor/x", 80);
  set("coor/y", 1050);
  set("coor/z", 90);
  setup();
}
void reset() {
  object master;
  if (master = present("master baihuaxian", this_object()))
    destruct(master);
  ::reset();
}
