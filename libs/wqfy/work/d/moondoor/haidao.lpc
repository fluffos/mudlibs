inherit	ROOM;
void create()
{
	set("short", "海岛");
	set("long", @LONG
这是海中的一个孤岛，岛上山石林立，悬崖陡峭，好象荒芜人烟。
LONG
	);
	set("exits", ([	/* sizeof() == 1 */
]));
/*	  set("objects", ([
	__DIR__"obj/lake2" : 1,
	"/d/stone/npc/scavenger" : 3,
			]) );*/
	set("item_desc", ([
		"mountain": "悬崖虽陡，但还有落脚之处。你似乎可以试着爬(climb)上去。\n",
		"悬崖":	"悬崖虽陡，但还有落脚之处。你似乎可以试着爬(climb)上去。\n",
		"up": "悬崖虽陡，但还有落脚之处。你似乎可以试着爬(climb)上去。\n",
	]) );
	set("outdoors",	"moondoor");

	set("coor/x",500);
	set("coor/y",-320);
	set("coor/z",80);
	setup();
}
void init()
{
 add_action("do_climb",	"climb");
 add_action("do_around", "around");
}

int do_around(string arg)
{
   object me, room;

 if(!arg || arg=="")
  {
   write("你要绕过什么？\n");
   return 1;
  }

 if( arg == "礁石" || arg == "stone" ||	arg == "jiaoshi")
  {
   me =	this_player();
   message_vision("$N转到礁石后面！！\n", me);
   room	= find_object(__DIR__"jiaoshi");
   if(!objectp(room)) room=load_object(__DIR__"jiaoshi");
   me->move(room);
   return 1;
  }
  else
   {
    write("你不可以绕过"+arg+"\n");
    return 1;
   }
}

int do_climb(string arg)
{
	object obj;
	object me;

	if(!arg	|| arg=="")
	{
		write("你要爬什么？\n");
		return 1;
	}
	if( arg	== "悬崖" || arg == "mountain" || arg == "up")
	{
	me = this_player();
	message_vision("$N慢慢地往悬崖上爬去。\n", me);
	me->move("d/moondoor/yading.lpc");
	return 1;
	}
	else
	{
		write("你不可以爬"+arg+"\n");
		return 1;
	}
}