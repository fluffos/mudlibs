// boat.c
inherit	ROOM;
void create()
{
 set("short", "木船");
 set("long", @LONG
木船非常完好，好象还有人偶尔使用。
LONG
 );
 set("coor/x",1500);
 set("coor/y",-400);
 set("coor/z",-60);
 setup();
}   

void boat_run(int counter)
{
 object	dest;
 object	*inv;
 int i;


 inv=all_inventory(this_object());		
 for (i=0;i<sizeof(inv);i++)
 if (userp(inv[i]))
  {
   if (query_temp("mark/dest")=="haidao")
    switch(counter)
     {
      case 0 :	message("vision","你划动小船，缓缓向前驶去。\n",this_object());
		break;
      case 1 :	message("vision","但闻水声荡荡，海天俱寂。\n",this_object());
		break;
      case 2 :	message("vision","远处的黑点越来越近了。\n",this_object());
		break;
      case 3 :	message("vision", "你奋力的划着小船。\n",this_object());
		break;
      case 4 :	message("vision", "黑点越来越大，你发现那果然是一个小岛。\n",this_object());
		break;
      case 5 :	message("vision","小船晃了一下，你发现已经靠岸了。\n",this_object());
		set("exits/up",__DIR__"haidao");

		if (!objectp(dest=find_object(__DIR__"haidao")))
		dest=load_object(__DIR__"haidao");
		set_temp("mark/dest","gangwan1");
		dest->set("exits/down",__DIR__"boat");
		message("vision","一条小船缓缓驶了过来。\n",dest);
		call_out("leave",10,dest);
		return;
     } 
    else
     switch(counter)
      {
       case 0 :	 message("vision","你划动小船，缓缓向大陆驶去。\n",this_object());
		 break;
       case 1 :	 message("vision","但闻水声荡荡，海天俱寂。\n",this_object());
		 break;
       case 2 :	 message("vision","小岛越来越远了。\n",this_object());
		 break;
       case 3 :	 message("vision", "你奋力的划着小船。\n",this_object());
		 break;
       case 4 :	 message("vision", "陆地越来越近。\n",this_object());

		 break;
       case 5 :	 message("vision","小船晃了一下，你发现已经靠岸了。\n",this_object());
		 set("exits/up",__DIR__"gangwan1");
		 if (!objectp(dest=find_object(__DIR__"gangwan1")))
		 dest=load_object(__DIR__"gangwan1");
		 set_temp("mark/dest","haidao");
		 dest->set("exits/down",__DIR__"boat");
		 message("vision","一条小船缓缓驶了过来。\n",dest);
		 call_out("leave",10,dest);
		 return;
     } 
   call_out("boat_run",3,counter+1);
   return;
  }
}

void leave(object dest)
{
 object	*inv;
 object	oob;

 int i;
 inv=all_inventory(this_object());		
 for (i=0;i<sizeof(inv);i++)
  if (userp(inv[i]))
   {
    message("vision","小船被水冲走了。\n",dest);
    if (query_temp("mark/dest")=="haidao")
     message("vision","你将小船向远处的黑点划去。\n",this_object());
     else message("vision","你将小船向远处的陆地划去。\n",this_object());
    delete("exits/up");
    dest->delete("exits/down");
    call_out("boat_run",3,0);
    return;		       
   }
 message("vision","小船被水冲走了。\n",dest);	       
 delete("exits/up");
 dest->delete("exits/down");
 return;
}