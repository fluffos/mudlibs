#include <room.h>
inherit ROOM;
void create() {
  set("short", "山洞中");
  set("long", @LONG
这是一个两丈见方的山洞，地上铺着一张草席，山洞中间架着
一堆篝火，篝火已灭，但燃烧所剩的炭灰尚留余温。篝火的旁边坐
着一个样貌极其英俊的男子，目露星光，看起来武功极高。
LONG
  );
  set("exits", ([
    "south": __DIR__ "yading.lpc",
  ]));
  set("objects", ([
    __DIR__ "npc/master_rui": 1
  ]));

  set("outdoors", "moondoor");
  set("coor/x", 0);

  set("coor/y", 0);
  set("coor/z", 0);
  setup();
}
