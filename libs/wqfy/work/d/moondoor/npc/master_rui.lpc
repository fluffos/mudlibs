inherit	NPC;
inherit	F_MASTER;
#include <ansi.h>
void create()
{
	set_name("芮玮", ({ "master ruiwei", "master", "master rui" }) );
	set("gender", "男性" );
	set("age", 24);
	set("str", 30);
	set("cor", 30);
	set("cps", 30);
	set("int", 30);
	set("per", 30);
	set("agi",30);
	set("chat_chance_combat", 90);
	set("chat_msg_combat", ({
		(: perform_action, "sword.bajian" :)
	}) );
	set("attitude","friendly");
	set("max_force", 5000);

	set("force", 5000);
	set("force_factor", 30);
	set("max_kee",2000);
	set("max_gin",2000);
	set("max_sen",2000);
	set("eff_kee",2000);
	set("kee",2000);
	set("chat_chance", 1);
	set("chat_msg",	({
"芮玮叹气道:可怜我的儿,生下来就已失踪! \n",
	       
	}) );
	set("long",
		"剑眉星目,气宇不凡,左手带着一只金色手套\n");
	create_family("月形门",	4, "门主");
	set("combat_exp", 7000000);
	set("score", 200000);

	set_skill("move", 200);
	set_skill("parry", 200);

	set_skill("dodge", 180);
	set_skill("force", 200);
	set_skill("sword",300);
	set_skill("literate", 200);
	set_skill("unarmed",200);
	set_skill("sea-sword",150);
	set_skill("flydragon-steps",160);
	set_skill("huashen-strike",180);
	set_skill("four-force",150);
	map_skill("dodge", "flydragon-steps");
	map_skill("unarmed", "huashen-strike");
	map_skill("force", "four-force");
	map_skill("parry", "sea-sword");
	map_skill("move", "flydragon-steps");
	map_skill("sword", "sea-sword");

	setup();
	carry_object(__DIR__"obj/seasword")->wield();
	carry_object(__DIR__"obj/jinsi")->wield();


}

void attempt_apprentice(object me)
{
	if(me->query_temp("for_bandit"))
	{
	command("say 希望你可以光大本门。\n");
	command("recruit " + me->query("id") );
		return;
	}
	else
	{
	command("sigh");
	command("say 我可怜的儿子刚刚出生就不见了。\n");
	command("say 心中挂念我儿,所以无意收徒。\n");

	}
}

void recruit_apprentice(object ob)

{
	if( ::recruit_apprentice(ob) )
		ob->set("class", "moondoor");
}
int accept_object(object me,object obj)
{
	if(obj->query("name") == "婴儿")
	{
	me->set_temp("for_bandit",1);
	command("smile");
	command("say 果然是我的儿，你现在可以拜我为师了，我将把我一身武学传授给你.\n");
	return 1;	
	}
	return 0;
}
void re_rank(object student)
{
	int exp;
	exp = (int) student->query("combat_exp");
	if( exp	<= 32000 ) {

		student->set("title","月形门门众");
		return ;	
	} else if ( exp	<= 64000 ) {
		student->set("title","月形门护法");
		return ;
	} else if ( exp	<= 128000 ) {
		student->set("title","月形门大护法");
		return ;
	} else if ( exp	<= 256000 ) {
		student->set("title","月形门总护法");
		return ;
	} else if ( exp	<= 512000 ) {
		student->set("title","月形门执法");
		return ;
	} else if ( exp	<= 1024000 ) {
		student->set("title","月形门大执法");
		return ;
	} else if ( exp	<= 1536000 ) {
		student->set("title","月形门总执法");
		return ;

	} else if ( exp	<= 2304000 ) {
		student->set("title","月形门长老");
		return ;
	} else if ( exp	<= 3456000 ) {
		student->set("title","月形门大长老");
		return ;
	} else if ( exp	<= 5187000 ) {
		student->set("title","月形门总监");
		return ;
	} else 
		student->set("title","月形门副门主");
		return ;

}