#include <ansi.h>
inherit ROOM;

void create()
{
    set("short",YEL"欢迎光临郑州风云"NOR);
    set("long",
"这里是最后的大门，踏出你将进入郑州风云，进一步学习江湖规矩\n"
"和生存技能，请你记得多保存你的资料"+HIC"(save)"NOR+",如果累了想离开请"+HIC"(quit)\n"NOR
",不懂的地方可以看帮助文件"HIC+"(help)"NOR+"，你还可以随时用"HIC"(map)"NOR"查看地图\n"
"祝你玩的愉快。\n"
    );
        

        set("exits", ([
		"south": "/d/fy/fqkhotel",
        ]));
        set("objects",([
                __DIR__"npc/jieyinshix":1,
                ]));
        set("no_magic", 1);
        set("no_fight", 1);
        set("coor/x",11);
	set("coor/y",-30);
	set("coor/z",-10);
	setup();
}
