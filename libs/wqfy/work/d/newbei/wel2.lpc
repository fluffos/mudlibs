#include <ansi.h>
inherit ROOM;

void create()
{
	set("short",YEL"欢迎光临郑州风云"NOR);
	set("long",
"如果你肚子饿了可以用"+HIC"(eat xxxx)"NOR+"指令吃东西，渴了还可以用"+HIC"(drink xxxx)"NOR+"\n"
"指令喝水，地上有东西你可以用"+HIC"(get xxxx、get all)"NOR+"捡起来，当然，你最好还是去\n"
"买"+HIC"(buy xxx from name)"NOR+"去买些你需要的东西，你也可以把你不用的东西卖掉，"
HIC"(sell)"NOR+"。\n"
);
        
        set("exits", ([
                "south":__DIR__"wel3",
        ]));
        set("objects",([
                __DIR__"npc/jieyinshi2":1,
                ]));
	set("no_magic", 1);
	set("no_fight", 1);
        
	set("coor/x",11);
	set("coor/y",-10);
	set("coor/z",-10);
	setup();
        replace_program(ROOM);
}
