// movebook.c

inherit ITEM;

void create()
{
	set_name("尸体", ({ "shiti" }));
	set_weight(1000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "具");
                set("for_ok",1);
		set("long",
			"这是一具尸体。看上去好象是个男人的尸体。\n");
		set("value", 0);
			set("skill", ([
			"name": 		"yiqiguanforce",	
			"exp_required":	1000000,				
			"sen_cost":		90,				
			"difficulty":	90,		
			"max_skill":	12	
		]) );
	}
}
