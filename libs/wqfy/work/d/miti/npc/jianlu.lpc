#include <ansi.h>
#include <room.h>
inherit ROOM;
void create ()
{
  set ("short", "剑庐 ");
  set ("long", @LONG
这是一间小小的剑室，兵器架(shelf)挂满了各式各样
的兵刃和批挂用的铠甲，看的出这里的主人收藏甚丰，也是
一个武林中人。
LONG);

  set("exits", ([ 
  "southeast" : __DIR__"hole3.lpc",
]));
  set("item_desc", ([ /* sizeof() == 1 */
  "shelf" : "挂满兵器的兵器架。
",
]));
  set("no_magic", 1);

  setup();
  replace_program(ROOM);
}
void init()
{
add_action("do_open","strike");

}
int do_open(string arg)
{
               object me;
                int urkee;
        if(!arg || arg=="")
        {
                write("你要干什么？\n");
                return 1;
        }

        if( arg == "shelf")
        {
         me = this_player();
                 urkee=me->query("eff_kee");
         message_vision(HIR"$N运足内力一掌击出,突然墙脚射出一只蜈蚣镖...\n"NOR, me);
         message_vision("("+RED"$N满身鲜血，已经有如风中残烛，随时都可能断气。"+NOR+")\n", me);
         me->receive_wound("kee",urkee+1000);
            }
       return 1;
}

