inherit NPC;
#include <ansi.h>
int kill_him();
void create() {
  set_name("金不换", ({ "jin buhuan", "jin" }));
  set("nickname", HIR "爱财如命" NOR);
  set("gender", "男性");
  set("age", 29);
  set("str", 100);
  set("per", 35);
  set("int", 30);
  set("attitude", "friendly");
  set("max_force", 3500);
  set("force", 3500);
  set("force_factor", 10);
  set("long",
    "金不换是比大侠沈浪还高了一辈的人物，他人如其名,爱财
如命；曾是丐帮中人，但不知为何反出丐帮，他在这里出现
是因为......\n"
  );
  set("chat_chance_combat", 90);
  set("chat_msg_combat", ({
    (: perform_action, "unarmed.xianglongwuhui" :)
  }));
  set("combat_exp", 2000000);
  set_skill("move", 230);
  set_skill("parry", 230);
  set_skill("dodge", 230);
  set_skill("force", 230);
  set_skill("unarmed", 250);
  set_skill("doggiesteps", 200);
  set_skill("dragonstrike", 250);
  set_skill("huntunforce", 200);
  map_skill("dodge", "doggiesteps");
  map_skill("force", "huntunforce");
  map_skill("unarmed", "dragonstrike");
  map_skill("parry", "dagou-stick");
  set("inquiry", ([
    "沈浪": (: kill_him :),
    "key": (: kill_him :),
  ]));
  setup();
  carry_object("d/miti/obj/key");

}
int kill_him() {
  object me;
  me = this_player();
  command("say 你好大胆，竟敢揭老子的底！！ \n");
  this_object()->kill_ob(me);
  me->kill_ob(this_object());
  return 1;
}
