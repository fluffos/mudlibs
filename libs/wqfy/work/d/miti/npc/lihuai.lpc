inherit NPC;
#include <ansi.h>
void create() {
  object ob;

  set_name("李坏", ({ "li huai", "li", "lihuai" }));

  set("gender", "男性");
  set("title", HIC "小李嫡传" NOR);
  set("age", 19);
  set("int", 40);
  set("cor", 40);
  set("con", 40);
  set("per", 40);
  set("str", 40);
  set("attitude", "peaceful");
  set("max_force", 9500);
  set("force", 19000);
  set("force_factor", 100);
  set("max_gin", 20000);
  set("max_kee", 100000);
  set("max_sen", 20000);
  set("long",
    "李坏确实是一个不折不扣的小坏蛋，不过他的武功底子
却没人清楚，不过作为李寻欢的孙子，想来也不会差到
哪里去。\n"
  );
  set("combat_exp", 5000000);
  set("chat_chance_combat", 80);
  set("chat_msg_combat", ({
    (: perform_action, "throwing.xiaoli-feidao" :),
  }));

  set_skill("move", 300);
  set_skill("parry", 300);
  set_skill("dodge", 300);
  set_skill("force", 40);
  set_skill("unarmed", 300);
  set_skill("throwing", 300);
  set_skill("feidao", 300);
  map_skill("throwing", "feidao");


  setup();
  carry_object("obj/cloth")->wear();
  ob = carry_object("obj/weapon/dart");
  ob->set_amount(40);
  ob->wield();

}
void killed_enemy(object who) {
  command("say 嘿嘿......想过去可没门儿。");
}
