inherit ROOM;

void create() {
  set("short", "山洞尽头");
  set("long", @LONG
终于又见到了一个人了，你的心欢喜的似乎要从嗓子眼
里蹦出来，真恨不得立刻让他带你离开这鬼地方。
LONG);

  set("no_magic", 1);
  set("exits", ([
    "enter": __DIR__ "midao",
  ]));
  set("objects", ([
    __DIR__ "npc/lihuai": 1,
    __DIR__ "obj/hezi": 1,
  ]));

  set("coor/x", 150);
  set("coor/y", 130);
  set("coor/z", 0);
  set("coor/x", 150);
  set("coor/y", 130);
  set("coor/z", 0);
  setup();
}
int valid_leave(object me, string dir) {
  object ob;
  if (userp(me) && dir == "south" && ob = present("li huai", this_object())) {
    message_vision("$N对$n道：这样就想走? 嘿嘿...\n", ob, me);
    return notify_fail("");
  }
  return 1;
}
