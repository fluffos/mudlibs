// xgchen@fy
#include <ansi.h>
inherit ITEM;

void create()
{
        string *names = ({
               HIG "青色盒子"NOR, HIW "白色盒子"NOR, HIY "金色盒子"NOR   });

        set_name( names[random(sizeof(names))], ({ "he-zi" }));
        set_weight(999999999999);
        set("no_get", 1);
        set("value", 100000);
    set("no_shown", 1);
        set("unit", "个");
        set("long", "这是个不知名的宝盒，你可以打开(open)看看。\n");
        setup();
}  

void init()
{
        add_action("do_open", "open");
}

int do_open(string arg)
{
        object me,ob;
        me = this_player();
      if( !arg || arg=="" ) return 0;
        if (me->is_busy()) return notify_fail("你正在忙怎么能做其他东西!\n");
        if (me->is_fighting()) return notify_fail("你正在战斗怎么能做其他东西!\n");
      if( arg=="盒子" || arg =="he-zi" ) {
 message_vision(HIC"\n\n$N用颤抖的双手, 打开了"+this_object()->name()+"。\n"NOR , me);
 if (random(100)<90)
{    
             ob = new("/d/xgchen/npc/shashou");
                ob->move(environment());
                ob->kill_ob(this_player());
                this_player()->kill_ob(ob);
                ob->invocation(me);
                ob->set_leader(this_player());
        }
        else{  ob = new("/d/miti/obj/onekey");
                ob->move(this_player());

}       
     return 1;
}
         return 1;
}

