#include <weapon.h>

inherit SWORD;

void create() {
  set_name("钥匙", ({ "key" }));
  set_weight(7000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long", "这是一把神秘的钥匙。\n");
    set("value", 400);
    set("onekey", 1);
    set("material", "steel");
  }
  init_sword(25);


  set("wield_msg", "$N「唰」地一声抽出一把$n握在手中。\n");
  set("unwield_msg", "$N将手中的$n插入腰间。\n");

  setup();
}
