#include <ansi.h>
inherit ITEM;
void create()
{
    set_name(HIY "黄钥匙" NOR, ({ "y-key","yellow key" }) );
    set_weight(1);
    set("no_shown", 1);
    if( clonep() )
            set_default_object(__FILE__);
    else {
            set("unit", "把");
            set("material", "steel");
            set("long", "一把黄澄澄的钥匙。\n");
          }
    setup();
}



