inherit ROOM;
void create()
{
        set("short", "清风细雨楼");
        set("long", @LONG
这是风云城中的首户，富甲一方，高大的门楼，大门上雕刻着一条
五爪金龙，煞是吓人。两边各有一对石狮门前上马石、栓马桩排了三排
比一般的王侯家还要阔气。奇怪的是不见有人出入。一对醒目的门环就
镶在大门上。
一个金漆大匾十分若人注目，上面龙飞凤舞的写着:

                  [37;41m┏━━━━━━━━━┓[0m
                  [37;41m┃[33m   流 云 听 雨 [37;41m   ┃[0m
                  [37;41m┗━━━━━━━━━┛[0m

LONG
        );
        set("exits", ([ 
  "north" : "/d/fy/ecloud5",
]));
 //       set("objects", ([
 //       __DIR__"obj/eren" : 1,
 //                       ]) );

        set("coor/x",50);
        set("coor/y",-5);
	set("coor/z",0);
	set("coor/x",50);
	set("coor/y",-5);
	set("coor/z",0);
	setup();
      //  replace_program(ROOM);
        
}

void init()
{
        add_action("do_open", "knock");
}
int do_open(string arg)
{
        object obj;
        object me;
        if(!arg || arg=="")
        {
                write("你要敲什么？\n");
                return 1;
        }
        if( arg == "menhuan" || arg == "门环")
        {
        me = this_player();
        message_vision("$N向前走了两步，伸手叩了叩镶在朱红大门上的门环．
＂呀＂地一声，门自动的打开了。\n", me);
        if( !query("exits/south") ) {
        set("exits/south", __DIR__"tingyuan");
        if(!me->query("m_success/听雨楼"))
        {
                me->set("m_success/听雨楼",1);
                me->add("score",100);

        }
        call_out("close_path", 1);
        }
        return 1;
        }
        else
        {
                write("你伸手叩了叩"+arg+"\n");
                return 1;
        }
}
void close_path()
{
        if( !query("exits/south") ) return;
        message("vision",
"厚重的朱红大门又又无声无息的合了起来．\n",
                this_object() );
                delete("exits/south");
}

