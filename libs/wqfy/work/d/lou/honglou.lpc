inherit ROOM;
#include <ansi.h>
void create() {
  set("short", "红楼");
  set("long", @LONG
一间轻巧精美的小楼，四周是一个个柱天大柜。门口立一牌匾，上书“吾楼禁地，
轻进必杀”。里边摆满了卷宗。没有楼主的手谕谁也不能进入，因为这里是收藏别人
秘密的地方。传说武林中所有人的背景这里都有，所以这里自然带上了几分神秘色彩。
LONG
  );
  set("exits", ([
    "eastdown": __DIR__ "dating",
  ]));
  set("objects", ([
    __DIR__ "obj/bian": 1,
    __DIR__ "npc/wuxie": 1,
  ]));
  set("outdoors", "fengyun");


  set("coor/x", 45);
  set("coor/y", -20);
  set("coor/z", 10);
  setup();
}
void reset() {
  object *inv;
  object con, item;
  ::reset();
  con = present("bian", this_object());
  inv = all_inventory(con);
  if (!sizeof(inv)) {
    item = new(__DIR__ "obj/book1");
    item->move(con);
  }
}
