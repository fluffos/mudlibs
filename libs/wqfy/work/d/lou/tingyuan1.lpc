inherit ROOM;
void create() {
  set("short", "清风细雨楼的庭院");
  set("long", @LONG
这是一条幽静绵长的院落，四周遍种着四季不谢的鲜花。
甬路两旁栽着矮科的柏树，路上干净的不能再干净。奇怪的
是偌大的院落竟然没有人走动。给这里平添了几分神秘色彩。
LONG
  );
  set("exits", ([ /* sizeof() == 4 */
    "south": __DIR__ "yanwu",
    "west": __DIR__ "tingyuan"
  ]));
  set("outdoors", "fengyun");
  set("coor/x", 55);
  set("coor/y", -10);
  set("coor/z", 0);
  setup();
  replace_program(ROOM);

