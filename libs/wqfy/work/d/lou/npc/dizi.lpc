void init()
{

	add_action("do_get","get");
}

int do_get(string arg)
{
string what;
if(!arg) return	0;
if(sscanf(arg,"%s",what) !=1) return 0;
if(what== "all"	|| what== "gold" )
{
message_vision("$N对$n怒吼一声：大胆毛贼！竟敢打清风细雨楼东西的主意！\n",this_object(),this_player());
this_object()->kill_ob(this_player());
this_player()->start_busy(2);
return 1;
}
}