#include <ansi.h>

inherit	NPC;

string kill_passenger(object who);

void create()
{
	set_name("白虎堂守库弟子", ({ "dizi" })	);
	set("gender", "女性" );
	set("title", HIR "血手玫瑰" NOR);
	set("age", 27);
	set("str", 27);
	set("int", 12);
	set("per", 10);
	set("max_kee", 10000);
	set("long", @LONG
她是二十多岁貌美如花的白虎堂弟子，由于武功非常出众，姿色过人，又是楼

主的亲信所以被派来看守宝库。
LONG
);
       set("chat_chance_combat", 20);
    set("chat_msg_combat", ({
    (: perform_action, "unarmed.fengjuancanyun"	:)
   }) );
	set("attitude",	"killer");

	set("combat_exp", 700000);
	set("bellicosity", 3000	);
//	   set("chat_chance", 50);
//	   set("chat_msg", ({
// "没有手谕，竟敢善闯本教禁地！！！\n",
//	    }) );
	set_skill("unarmed", 90);
	set_skill("dodge", 90);
	set_skill("parry", 80);
	set_skill("liuyun-steps",50);  
	set_skill("yingfengzhi",90);


	map_skill("unarmed","yingfengzhi");
	map_skill("dodge", "liuyun-steps");
	set("score", 100);

	setup();

	add_money("gold", 5); 
}
