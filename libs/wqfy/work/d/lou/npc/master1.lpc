inherit NPC;
inherit F_MASTER;
#include <ansi.h>
int kill_him();
void create() {
  set_name("夜孤魂", ({ "master yeguhun", "master" }));
  set("nickname", BLU "冷夜孤魂" NOR);
  set("gender", "男性");
  set("age", 34);
  set("agi", 30);
  set("per", 35);
  set("int", 30);
  set("attitude", "friendly");
  set("max_force", 3000);
  set("force", 3000);
  set("long",
    "
他是白虎堂堂主，处事精明沉稳，武功高强。
\n"

  );
  create_family("清风细雨楼", 3, "堂主");
  set("chat_chance_combat", 20);
  set("chat_msg_combat", ({
    (: perform_action, "unarmed.fengjuancanyun" :)
  }));
  set("combat_exp", 1000000);
  set_skill("move", 100);
  set_skill("dodge", 100);
  set_skill("force", 120);
  set_skill("literate", 80);
  set_skill("unarmed", 120);
  set_skill("liuyun-steps", 100);
  set_skill("yingfengzhi", 100);
  set_skill("cloudforce", 80);
  map_skill("dodge", "liuyun-steps");
  map_skill("force", "cloudforce");
  map_skill("unarmed", "yingfengzhi");
  setup();
  //	  carry_object(__DIR__"obj/monk_cloth")->wear();



}

void attempt_apprentice(object me) {
  if ((int)me->query_skill("force", 1) >= 50) {
    command("smile");
    command("recruit " + me->query("id"));
    return;
  } else {
    command("smile");
    command("say 你的体质太差了，怎么能学我的影风指法？你还是去学学内功心法吧！\n");

  }
}


void recruit_apprentice(object ob) {
  if (::recruit_apprentice(ob))
    ob->set("class", "lou");
}
void re_rank(object student) {
  student->set("title", "清风细雨楼白虎堂弟子");
  return;

}
int accept_fight(object me) {
  if (me->query("family/family_name") == query("family/family_name") &&
    me->query("family/master_id") == query("id")) {
    command("say 好，你赢了我，你就可以到我兄长那里学习了！\n");
    return 1;
  } else

  {
    command("say 不要自找麻烦，你走吧，这次放过你。\n");
    return 0;
  }
}
void win_enemy(object loser) {
  command("say 徒儿你离青出于蓝还差的远呢，还要努力呀！\n");
}
void lose_enemy(object winner) {
  command("say 呵呵，不错，不错！去我兄长那里学吧，他会好好待你的。\n");
  winner->set_temp("won_master_yeguhun", 1);
}
