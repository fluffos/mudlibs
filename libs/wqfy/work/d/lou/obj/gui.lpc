inherit	ITEM;

void create()
{
	set_name("大柜", ({ "gui", "大柜"}) );
	set_weight(500);
	set_max_encumbrance(800);
	set("no_get", 1);
	set("no_shown",	1);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "个");
		set("long", "一个柱天大柜。\n");
		set("value", 1);
	}
}

int is_container() { return 1; }