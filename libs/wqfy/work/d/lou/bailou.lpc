inherit	ROOM;
#include <ansi.h>
void create()
{
	set("short", "白楼");
	set("long", @LONG
庞大的一座楼，进入后给人一种舒畅的感觉。门口立一牌匾，上书“吾楼禁地，轻进必杀”。
与红楼相同的是，四周是一个个的柱天大柜，据说这里是收藏武功秘籍的地方。但是机关重重，
没人敢轻易进入。
LONG
	);
	set("exits", ([	
 "westdown" : __DIR__"dating",
]));
	set("objects", ([
	__DIR__"npc/mo"	: 1,
	__DIR__"obj/bian1" : 1,
	__DIR__"obj/gui" : 1,
			]) );
	set("outdoors",	"fengyun");


	set("coor/x",55);
	set("coor/y",-20);
	set("coor/z",10);
	setup();
}
void reset()
{
	object *inv;
	object con, item;
	::reset();
	con = present("gui", this_object());
	inv = all_inventory(con);
	if( !sizeof(inv)) {
	item = new(__DIR__"obj/book2");
	item->move(con);
	}
}