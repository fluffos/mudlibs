inherit	ROOM;
#include <room.h>
void create()
{
	set("short", "清风细雨楼帐房");
	set("long", @LONG
这里是金风细雨楼出入库银的账房，整间屋子是由坚硬的大理石砌成的。对面有一个厚
厚的钢门，连唯一的一个小窗上都镶满拇指粗细的钢条。这里由金风细雨楼最亲信的人日夜
把守。据说这里机关重重，没经楼主答应，没有人敢轻易进入。
LONG
	);
       set("exits", ([ /* sizeof() == 4	*/
       "south" : __DIR__"pinxiang",
       "east" :	__DIR__"tingyuan",
]));
       // set("exits", ([
	//	  "down": "不知谁把钥匙忘在门上，钢门半掩着，似乎可以推开(push)。\n",
       // ]) );
	set("coor/x",45);
	set("coor/y",-5);

	set("coor/z",0);
	setup();
}
void init()
{
	add_action("do_push", "push");
}
int do_push(string arg)
{
	object obj;
	object me;
	if(!arg	|| arg=="")
	{
		write("你要推什么？\n");
		return 1;
	}
	if( arg	== "door" || arg == "门" || arg	== "钢门")
	{
	me = this_player();
	message_vision("$N悄悄的推开一条缝，出现一条向下的出路。\n", me);

	if( !query("exits/down") ) {
	set("exits/down", __DIR__"down_room");
	/* if(!me->query("m_success/听雨楼"))
	 {
		me->set("m_success/听雨楼",1);
		me->add("score",100);

	} */
	call_out("close_path", 1);
	}
	return 1;
	}
	else
	{
		write("你伸手轻轻推了推"+arg+"\n");
		return 1;
	}
}
void close_path()
{

	if( !query("exits/down") ) return;
	message("vision",
"厚重钢门大门忽然无声无息的合了起来．\n",
		this_object() );
		delete("exits/down");
}