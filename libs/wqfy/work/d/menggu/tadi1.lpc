// data by xgchen
#include <room.h>
inherit ROOM;
#include <ansi.h>
void create() {
  set("short", "伏虎塔底");
  set("long", @LONG
爬上月轮山，便来到了伏虎塔之前。伏魔塔亦名镇妖塔，唐朝时建,
这座六角塔有十三层，在它的飞檐翘角上括有一百零四只大铁铃。
大门(gate)是由精钢而造,上面刻有几个字.
LONG);
  set("exits", ([
    "northwest": __DIR__ "zhenyaota",
    "east": __DIR__ "tadi2",
  ]));
  set("item_desc", ([
    "gate": "这是一个十分坚固的三丈来高的钢门,几行的咒语刻在上面。\n",
    "大门": "这是一个十分坚固的三丈来高的钢门,几行的咒语刻在上面。\n",
    "字": "嗑惕刹嗑惕,孰比刹木绎。\n",
    "咒语": "嗑惕刹嗑惕,孰比刹木绎。\n",
  ]));
  set("no_clean_up", 0);
  setup();
}
void init() {
  add_action("do_say", "say");
}
int do_say(string arg) {
  object me;
  me = this_player();
  if (!arg || arg == "") return 0;
  if (arg == "嗑惕刹嗑惕,孰比刹木绎。") {
    message_vision(HIY "\n$N你闭眼念起咒语,一阵金光把$N笼罩着,你慢慢消失了...\n" NOR, this_player());
    me->set("overgate", 1);
    me->move("/u/fengyuhu/ta1");
    return 1;
  }
}
