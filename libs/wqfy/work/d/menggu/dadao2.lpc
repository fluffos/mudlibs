#include <room.h>
inherit ROOM;
void create()
{
        set("short", "沿湖大道");
        set("long", @LONG
看得出这里本来风景秀丽，却显的一片萧瑟。大道向南北延伸。
LONG);
        set("exits", ([
            "west"     : __DIR__"dadao1",
            "southeast" : __DIR__"dadao3",
        ]));
        set("no_clean_up", 0);
        set("outdoors", "hangzhou");
        setup();
}
