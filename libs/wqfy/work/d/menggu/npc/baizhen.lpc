// baizhen.c

#include <ansi.h>

inherit NPC;

void create() {
  set_name("白语", ({ "bai zhen", "bai", "zhen" }));
  set("title", "天子门长老");
  set("nickname", HIY "金爪" HIB "铁钩" NOR);
  set("gender", "男性");
  set("age", 64);
  set("max_sen", 1000);
  set("sen", 1000);
  set("max_kee", 3000);
  set("kee", 3000);
  set("force", 1000);
  set("max_force", 1000);
  set("long",
    "白语是黄山派高手，三十年前就驰名武林了。\n");
  set("combat_exp", 3500000);
  set("shen_type", -1);
  set("attitude", "heroism");

  set_skill("unarmed", 195);
  set_skill("blade", 195);
  set_skill("parry", 190);
  set_skill("dodge", 190);
  set_skill("move", 190);

  setup();
  carry_object("/d/menggu/obj/tiejia")->wear();
}
