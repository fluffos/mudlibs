// qianlong.c

#include <ansi.h>

inherit NPC;

void create()
{
	set_name("元霸", ({ "yuan ba", "yuan"}) );
	set("title", "天子门前任副帮主");
	set("gender", "男性");
	set("age", 33);
	set("per", 24);
	set("long",
"他是天子门前任副帮主,和帮主李长风不和,一气离开天子门”。\n");
	set("combat_exp", 5000000);
	set("attitude", "piece");
	setup();
        carry_object("/obj/cloth")->wear();
}
void init()
{
        add_action("do_kneel", "kneel");
}

int do_kneel()
{
	int i;
        object *li, me = this_player();

        if ( objectp(present("li changfeng", environment(me))))
        {
              message_vision(
"$N正想杀你们呢,嘿嘿,纳命来吧！\n\n", me);
              chen = all_inventory(environment(me));
              for(i=0; i<sizeof(li); i++)
              {
                   if( li[i] -> query("id") == "li changfeng")
                       li[i]->kill_ob(me);
              }
        }
        message_vision(
"$N恭恭敬敬地跪了下来，磕头道：在下"+me->query("name")+",今日特来相助！\n\n", me);
        if( me->query("combat_exp") < 1500000 )
        {
              message_vision(
"$n看着$N，叹气了一声：小兄弟！凭你的功夫看来不能帮我了？！\n\n", me, this_object() );
              message_vision(
"$n的掌风一挥，你下了塔底去了。\n\n", me, this_object() );
              me->move("/d/menggu/zhenyaota");
              tell_object(me, HIR"你从塔顶被抛下来，好疼！还受了伤。\n"NOR);
message("vision", HIR"只见" + me->query("name") + "从塔顶上扑通一声跌了下来，躺在地上半天爬不起来！\n"NOR, environment(me), me);
              me->receive_wound("kee", 20);
              me->add("combat_exp", 0 - me->query("combat_exp") /100);
              return 1;
        }
        if( me->query("marks/yuanba") )
        {
              message_vision(
"$n看着$N，眼中留露对$N的感激。\n\n", me, this_object() );
        }
        else
        {
              message_vision(
"$n看着$N说道：兄弟！真不知道如何感激你啊。\n\n", me, this_object() );
              me->set("marks/yuanba", "1");
              me->add("score", 5000);
        }
        return 1;
}

