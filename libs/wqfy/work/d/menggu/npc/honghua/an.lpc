// meng.c 安健刚

#include <ansi.h>

inherit NPC;
inherit F_MASTER;

void create() {
  set_name("成江", ({ "cheng jiang", "cheng", "jiang" }));
  set("nickname", HIY "独角虎" NOR);
  set("long",
    "他是李长风的二弟子，对师父始终忠心不二。\n");
  set("gender", "男性");
  set("class", "fighter");
  set("age", 25);
  set("attitude", "friendly");
  set("shen_type", 1);
  set("per", 20);
  set("str", 30);
  set("int", 30);
  set("con", 30);
  set("dex", 30);

  set("max_kee", 1000);
  set("kee", 1000);
  set("sen", 1000);
  set("max_sen", 500);
  set("force", 500);
  set("max_force", 500);
  set("combat_exp", 500000);

  set_skill("force", 100);
  set_skill("dodge", 100);
  set_skill("unarmed", 100);
  set_skill("parry", 100);
  set_skill("throwing", 100);

  setup();
}
