// longjun.c

#include <ansi.h>

inherit NPC;

void create()
{
	set_name("龙骏", ({ "long jun", "long", "jun"}) );
	set("title", "天子门副帮主");
	set("gender", "男性");
	set("age", 32);
	set("long",
		"龙骏是天子门的副帮主，武功在江湖少有其匹。\n");
	set("combat_exp", 300000);
        set("shen_type", -1);
	set("attitude", "heroism");

	set_skill("unarmed", 200);
	set_skill("move", 200);
	set_skill("parry", 160);
	set_skill("dodge", 160);

	setup();
}
