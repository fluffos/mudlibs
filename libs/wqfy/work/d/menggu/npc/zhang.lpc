// zhang.c

#include <ansi.h>

inherit NPC;

void create()
{
	set_name("张文重", ({ "zhang wenzhong", "zhang", "wenzhong"}) );
	set("title", "天子门护法");
	set("nickname", HIR"鬼手"NOR);
	set("gender", "男性");
	set("age", 43);
	set("long",
"张文重人称“鬼手”，身材魁梧，留一丛短胡子。江湖盛
言“宁挨一枪，莫遇一张”就是指他了。此人办事卖力，这
些年来在天子门扶摇直上。\n");
	set("combat_exp", 1750000);
        set("shen_type", -1);
	set("attitude", "heroism");
        set("max_force", 2000);
        set("force", 2000);
        set("sen", 1000);
        set("max_sen", 1000);
        set("max_kee", 2000);
        set("kee", 2000);
        set("per", 20);
        set("int", 30);
        set("con", 30);
        set("str", 30);
        set("dex", 30);

	set_skill("unarmed", 120);
	set_skill("sword", 200);
	set_skill("parry", 100);
	set_skill("dodge", 100);
	set_skill("force", 100);

	setup();


}
