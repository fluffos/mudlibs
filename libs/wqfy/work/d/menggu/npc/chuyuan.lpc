// chuyuan.c

#include <ansi.h>

inherit NPC;

void create() {
  set_name("楚元", ({ "chu yuan", "chu", "yuan" }));
  set("title", "天子门护法");
  set("gender", "男性");
  set("age", 34);
  set("max_sen", 1000);
  set("sen", 1000);
  set("max_kee", 3000);
  set("kee", 3000);
  set("force", 1000);
  set("max_force", 1000);
  set("long",
    "楚元原是少林和尚，法名智圆，后来犯了清规，被追缴度牒，逐
出庙门，他索性还了俗，加入了天子门。\n");
  set("combat_exp", 3500000);
  set("shen_type", -1);
  set("attitude", "heroism");

  set_skill("unarmed", 155);
  set_skill("sword", 155);
  set_skill("parry", 150);
  set_skill("dodge", 150);
  set_skill("softsword", 150);
  set_skill("xisui", 100);
  set_skill("iron-cloth", 150);
  set_skill("move", 150);
  set_skill("puti-steps", 100);
  map_skill("sword", "softsword");
  map_skill("parry", "softsword");
  map_skill("iron-cloth", "xisui");
  map_skill("move", "puti-steps");
  map_skill("dodge", "puti-steps");

  setup();
  carry_object("/d/menggu/obj/tiejia")->wear();
  carry_object("/obj/weapon/longsword")->wield();
}
