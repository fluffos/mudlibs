// LLY@FYSY
inherit NPC;
int wieldsword();
void create()

{
  set_name("村民", ({ "farmer" }));

  set("gender", "男性");

  set("age", 25 + random(20));

  set("long", "谢家村的一个普通村民，他正在忙碌着。\n");

  set("combat_exp", random(100000) + 200000);

  set("attitude", "friendly");

  set_skill("sword", 130 + random(70));
  set_skill("softsword", 50 + random(40));
  map_skill("sword", "softsword");
  set("chat_chance", 10);

  set("chat_chance_combat", 90);
  set("chat_msg_combat", ({
    (: wieldsword :),
  }));
  setup();

  carry_object("/obj/cloth")->wear(); carry_object(__DIR__ "obj/sword");
}


int wieldsword() {
  command("wield sword");
  perform_action("sword.yijianguanghan");
  command("unwield sword");
  return 1;
}
