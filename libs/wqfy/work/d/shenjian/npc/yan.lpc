// LLY@FYSY 
#include <ansi.h>

inherit NPC;
void create()

{

  set_name("燕十三", ({ "master yan", "master", "master shisan" }));
  set("nickname", HIW "名剑纵然已消沉 可是如今剑仍在" NOR);
  set("gender", "男性");
  set("age", 37);
  set("str", 65);
  set("cor", 30);
  set("cps", 30);
  set("int", 30);
  set("per", 30);
  set("agi", 25);
  set("chat_chance_combat", 10);
  set("chat_msg_combat", ({
    (: perform_action, "sword.shisan" :),
  }));
  set("attitude", "friendly");
  set("max_force", 45000);
  set("force", 45000);
  set("force_factor", 140);
  set("max_kee", 99999);
  set("max_gin", 99999);
  set("max_sen", 99999);
  set("chat_chance", 30);
  set("chat_msg_combat", ({
    "萧萧木叶下，燕十三彷佛已与这大地秋色溶为一体。\n",
  }));
  set("long",
    "一个很冷静的人,带着一种已深入骨髓的冷漠与疲倦，却又偏偏带着种逼人的杀气。
他的人与剑十七岁时就已名满江湖，如今他年近中年，他已放不下手中的剑，别人也
不容他放下。当他放下剑时，他的生命就要结束。\n");
  create_family("夺命十三剑", 1, "掌门");
  set("combat_exp", 8000000);
  set("score", 200000);
  set_skill("move", 120);
  set_skill("parry", 200);
  set_skill("unarmed", 120);
  set_skill("dodge", 120);
  set_skill("force", 200);
  set_skill("literate", 60);
  set_skill("sword", 280);
  set_skill("unarmed", 100);
  set_skill("pyrobat-steps", 120);
  set_skill("duo-sword", 180);
  set_skill("celestrike", 100);
  set_skill("celestial", 180);
  map_skill("dodge", "pyrobat-steps");
  map_skill("unarmed", "celestrike");
  map_skill("move", "pyrobat-steps");
  map_skill("sword", "duo-sword");
  map_skill("force", "celestial");
  map_skill("parry", "duo-sword");
  setup();
  carry_object("/obj/cloth")->wear();
  carry_object("/obj/weapon/sword")->wield();
  carry_object(__DIR__ "obj/oldskin")->wear();

}


void reset() {
  delete("given");
}
int accept_object(object who, object ob, object jsword) {
  if (ob->query("id") == "jewelsword") {
    jsword = new("/d/shenjian/obj/jewelsword");
    jsword->move(this_object());
    command("remove skinmask");
    command("unwield sword");
    command("wield jewelsword");
    command("say 感谢这位" + RANK_D->query_respect(who) + "帮我找回此剑，如果你愿意随我学剑，我就收你这个徒弟！\n");
    this_player()->set_temp("for_repay", 1);
    return 1;
  } else {
    command("say 这位" + RANK_D->query_respect(who) + ",你将这给我有什么用呢？\n");
    return 0;
  }
}




void attempt_apprentice(object me) {
  if (me->query_temp("for_repay")) {
    command("nod");
    command("say 我只希望你知道，要成名并不是件很好受的事。\n");
    command("recruit " + me->query("id"));
    return;
  } else {
    command("shake");
    command("say 别开玩笑的，我哪有资格收你为徒。\n");
  }
}

void recruit_apprentice(object ob) {
  if (::recruit_apprentice(ob))
    ob->set("class", "swordman");
}


void re_rank(object student) {
  student->set("title", "夺命十三剑传人");
  return;
}
int accept_fight(object me) {
  command("shake");
  return 0;
}
void init() {
  add_action("do_look", "look");

}


int do_look(string arg) {
  if (arg == "oldman") {
    write("他四周弥漫着药香，看来是一个医者，青斗笠、绿蓑衣，满头白发加霜。\n");
    write("他看起来约七十多岁。\n");
    write("武功看起来好象略有小成，出手似乎极轻。\n");
    return 1;
  }
  return 0;
}
