int valid_leave(object me, string dir)

{
        object *inv, ob;
      
  int i;

     
   if( dir == "south")
 return 1;
      
  if( userp(me)) 
{
               
 inv = all_inventory(me);
  
              for(i=0; i<sizeof(inv); i++)
 {
                      
  if(inv[i]->name() == "芦苇")
 {
                     
           return 1;
      
                  }
      
          }
    
    }
        return notify_fail("\n你觉得胸口发闷，还是赶快找个地方上岸的好！\n"); 
}


