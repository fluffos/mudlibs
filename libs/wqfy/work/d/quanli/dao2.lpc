inherit ROOM;
#include <command.h>
void create() {
  set("short", "树林");
  set("long", @LONG
一片茫茫大树林，一团绿色的树，让人感到心旷神怡。
LONG
  );
  set("exits", ([ /* sizeof() == 2 */
    "south": __DIR__ "dao1",

  ]));
  set("item_desc", ([
    "tree": "你可以从这里钻（z u a n）过去。\n",
    "树林": "你可以从这里钻（z u a n）过去。\n"
  ]));
  set("no_dazuo", 1);

  set("no_magic", 1);
  set("outdoors", "quanli");

  set("coor/x", 0);
  set("coor/y", 12210);
  set("coor/z", 0);
  setup();
}
void init() {
  add_action("do_zuan", "zuan");
}
int do_zuan() {
  object me;
  object room;
  me = this_player();
  message_vision("$N瞧了一下四周，确定没有人，便一头向树林钻去。\n", me);
  if (random(40) < 20) {
    message_vision("$N一头钻进了树林。\n", me);
    me->move(__DIR__ "tree.lpc");
  } else {
    message_vision("$N钻了半天，还是钻不进去。\n", me);
  }
  return 1;
}
