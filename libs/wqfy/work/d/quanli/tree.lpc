// Room: /d/quanli/road.c

inherit ROOM;
#include <command.h>
void create()
{
	set("short", "大树林");
	set("long", @LONG
一大片的树林。
LONG
	);
	
	set("exits", ([ /* sizeof() == 2 */
  "south" : __DIR__"dao2",

]));
set("item_desc", ([
                "树林": "普通的树呀，有什么好瞧的。\n",
                "tree" :" 普通的树呀，有什么好瞧的。\n"
        ]) );
set("no_dazuo",1);

set("no_magic",1);

set("outdoors", "quanli");

        set("coor/x",0);
	set("coor/y",12220);
	set("coor/z",0);
	setup();
	
}
void init()
{
if(userp(this_player())) call_out("fight",5+random(1),this_player());
}
int fight(object me)
{
object ob;
message_vision("$N突然看见周围出现了一个黑衣人。\n",me);
ob = load_object(__DIR__"npc/man");
ob->move(environment(me));
call_out("aaa",10);
return 1;
}
void aaa()
{
set("exits/north",__DIR__"door");
}

