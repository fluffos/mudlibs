inherit	ROOM;
#include <ansi.h>
void create()
{
	set("short", "芳草地");
	set("long", @LONG
这是一片绿油油的芳草地，草的味道夹杂着泥土的芳香让人感到心旷神怡。
LONG
	);
	set("exits", ([	
  "south" : __DIR__"grass",
  "north" : __DIR__"huayuan",
]));
	set("objects", ([
	__DIR__"npc/snake" : 1,
	__DIR__"obj/grass" : 1,
			]) );
	set("outdoors",	"wudujiao");

	set("coor/x",-30);

	set("coor/y",-420);
	set("coor/z",0);
	set("coor/x",-30);
	set("coor/y",-420);
	set("coor/z",0);
	set("coor/x",-30);
	set("coor/y",-420);
	set("coor/z",0);
	setup();
}
void reset()
{
	object *inv;
	object con, item, item1;
	::reset();
	con = present("grass", this_object());
	inv = all_inventory(con);
	if( !sizeof(inv) && !random(3))	{
	item = new(__DIR__"obj/caoyao");
	item->move(con);

	item1 =	new(__DIR__"obj/caoyao");
	item1->move(con);
	}
}