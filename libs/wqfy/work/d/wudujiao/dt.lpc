inherit ROOM;
void create() {
  set("short", "迎客厅");
  set("long", @LONG
一间很大的房间，布置的极其华丽，正对着门是个香台，上面放满了贡品
，香台后面挂着一张巨画，画的是五毒教信奉的五种毒物，分别是：青蛇，赤蝎，
褐蜈，墨蛛，白蟾。五种毒物昏暗的光线下显得栩栩如生，给本来就很诡异的五
毒教又加上了一层神秘的面纱。
LONG
  );
  set("exits", ([ /* sizeof() == 4 */
    "north": "/d/wudujiao/lwchang",
    "east": "/d/wudujiao/men",
    "west": "/d/wudujiao/shufang",
    "south": "/d/wudujiao/chufang",
  ]));

  set("item_desc", ([
    "巨画": "一张巨大的画着五种毒物的画。\n",

    "picture": "一张巨大的画着五种毒物的画。\n",
  ]));

  set("objects", ([
    __DIR__ "obj/xiangtai": 1,
  ]));

  set("outdoors", "wudujiao");
  set("coor/x", -10);
  set("coor/y", -430);
  set("coor/z", 0);
  set("coor/x", -10);
  set("coor/y", -430);
  set("coor/z", 0);
  set("coor/x", -10);
  set("coor/y", -430);
  set("coor/z", 0);
  setup();
}



void reset() {
  object *inv;
  object item1, item2, item3, xiangtai;
  ::reset();

  xiangtai = present("xiangtai", this_object());
  inv = all_inventory(xiangtai);
  if (!sizeof(inv)) {
    item1 = new(__DIR__ "obj/foxiang");
    item2 = new(__DIR__ "obj/gongpin");
    item3 = new(__DIR__ "obj/book2");
    item1->move(xiangtai);
    item2->move(xiangtai);
    item3->move(xiangtai);
  }
}
