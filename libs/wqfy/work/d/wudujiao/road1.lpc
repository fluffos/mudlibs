inherit	ROOM;
void create()
{
	set("short", "青石子路");
	set("long", @LONG
这是一条铺满青石子的小路，路边茅草丛生，一个不起眼的小酒店斜斜的盖在
茅草后面，里面不时的传来划拳请酒的声音。西面一座高大的庭院屹立在群山之间，
那里就是江湖上人人谈名色变的五毒教了。
LONG
	);
	set("exits", ([	/* sizeof() == 4 */
