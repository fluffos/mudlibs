// blade.c

#include <weapon.h>

inherit	BLADE;

void create()
{
	set_name("护教刀", ({ "jieblade" }) );
	set_weight(4000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "柄");
		set("value", 500);
		set("material",	"iron");
		set("long", "这是一把五毒教教徒专用的普通刀，但刀刃十分锋利。\n");
		set("wield_msg", "$N抽出一把五毒教专用的$n握在手中。\n");
		set("unequip_msg", "$N将手中的$n插入腰间的刀鞘。\n");
	}

	init_blade(20);
	setup();
}