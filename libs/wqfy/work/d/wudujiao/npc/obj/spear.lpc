// TIE@FY3
#include <weapon.h>
#include <ansi.h>
inherit	SPEAR;
void create()
{
	set_name(HIY  "赤蝎枪" NOR, ({ "chixie spear" }) );
	set_weight(10000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "把");
		set("long", "一把乌黑发亮的长枪。\n");
		set("value", 50000);
		set("rigidity",2000);	
		set("material",	"steel");
		set("max_enchant",7);
		set("for_create_weapon",1);
	}
	init_spear(50);

	setup();
}