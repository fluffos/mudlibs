inherit NPC;
inherit F_MASTER;
#include <ansi.h>
void create() {
  set_name("墨蛛老者", ({ "master zhu", "master" }));
  set("nickname", WHT "墨蛛旗-旗主" NOR);
  set("gender", "男性");
  set("age", 60);
  set("per", 3);
  set("agi", 25);
  set("int", 30);
  set("attitude", "friendly");
  set("max_force", 3000);
  set("force", 1500);
  set("force_factor", 60);
  set("long",

    "
墨蛛老者是五毒教中的地位仅次于护法的五大毒使之一，
他身为五大毒使之一，无论是武功还是修养都是五毒教中数
一数二的，他是墨蛛旗的旗主。
\n"
  );
  create_family("五毒教", 4, "旗主");
  set("chat_chance_combat", 90);
  set("chat_msg_combat", ({
    (: perform_action, "blade.suixinsuoyu" :),
    (: perform_action, "dodge.zhizunwudu" :),
    //		  (: perform_action, "unarmed.dimo" :),
    (: exert_function, "zhangqi" :)
  }));
  set("combat_exp", 1600000);
  set("score", 200000);

  set_skill("move", 110);
  set_skill("parry", 100);
  set_skill("dodge", 110);

  set_skill("force", 150);
  set_skill("literate", 120);
  set_skill("unarmed", 100);
  set_skill("blade", 130);
  set_skill("mozhu-blade", 120);
  set_skill("toxin", 100);
  set_skill("wudutoxin", 100);
  set_skill("wudu-steps", 100);
  //	set_skill("demon-strike",70);
  set_skill("wudu-force", 100);
  set_skill("perception", 90);
  map_skill("dodge", "wudu-steps");
  map_skill("force", "wudu-force");
  map_skill("blade", "mozhu-blade");
  map_skill("toxin", "wudutoxin");
  setup();
  carry_object(__DIR__ "obj/jiao_cloth")->wear();
  carry_object(__DIR__ "obj/blade")->wield();

}


void attempt_apprentice(object me) {
  if (me->query_temp("won_hewu")) {
    command("smile");
    command("recruit " + me->query("id"));
    return;
  } else {
    command("shake");
  }
}

void recruit_apprentice(object ob) {
  if (::recruit_apprentice(ob))
    ob->set("class", "wudujiao");
}

void re_rank(object student) {
  student->set("title", "五毒教墨蛛旗弟子");
  return;

}
int accept_fight(object me) {
  if (me->query("family/family_name") == query("family/family_name") &&
    me->query("family/master_id") == query("id")) {
    command("say 好，你要是赢了我，就可以去找我师兄学功夫了！\n");
    return 1;
  } else {
    command("say 开什么玩笑，你配和我动手吗	？\n");
    return 0;
  }
}

void win_enemy(object loser) {
  command("say 哎！徒儿还要努力呀！\n");
}
void lose_enemy(object winner) {
  command("say 不枉我尽心教导你！好！你可以到你师伯那里深造去了。\n");
  winner->set_temp("won_mozhu", 1);
}
