#include <room.h>
inherit ROOM;

void create() {
  set("short", "后花园");
  set("long", @LONG
这里是五毒教的花园，四面群山围绕，园中万花竞艳。牡丹芍药，黄菊
红玫，四季香花，在这地竞同时开放，抬眼望去，宛如置身一片香涛花海之
中。白石小径，青竹篱笆间，零乱地站了十余个红衣少女，正在剪草灌花。
西面一角的花卉后面隐约可以看到一扇半开半闭的檀木门。
LONG
  );
  set("exits", ([
    "east": __DIR__ "huayuan",
    //  "north" : __DIR__"garden1",
    //  "south" : __DIR__"garden2",
    "west": __DIR__ "garden2",
  ]));
  set("objects", ([
    __DIR__ "npc/dagu": 1,
  ]));

  set("outdoors", "wudujiao");
  create_door("west", "檀木门", "east", DOOR_CLOSED);
  set("coor/x", -40);
  set("coor/y", -430);
  set("coor/z", 0);
  set("coor/x", -40);
  set("coor/y", -430);
  set("coor/z", 0);
  set("coor/x", -40);
  set("coor/y", -430);
  set("coor/z", 0);
  setup();
}
