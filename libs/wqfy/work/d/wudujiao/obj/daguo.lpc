inherit	ITEM;

void create()
{
	set_name("大锅", ({ "daguo", "大锅" , "guo"}) );
	set_weight(500);
	set_max_encumbrance(800);
	set("no_get", 1);
	set("no_shown",	1);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "口");
		set("long", "一口煮食物的热气腾腾的大锅。\n");
		set("value", 1);
	}
}

int is_container() { return 1; }