inherit ROOM;
void create()
{
        set("short", "五毒教");
        set("long", @LONG
一座高大的单檐建筑，在高高的砖台上和两边掖门相呼应，门额上
悬着一块金字的黑漆方匾：
                  [37;44m┏━━━━━━━━━┓[0m
                  [37;44m┃[33m  五   毒   教    ┃[0m
                  [37;44m┗━━━━━━━━━┛[0m

    [35m江湖上谈名色变的邪教~~~~~~~~~~~~~~~.[0m

LONG
        );
        set("exits", ([ 
  "east"   : "/d/wudujiao/road1",
  "west"   : "/d/wudujiao/dt",
]));
        set("objects", ([
                __DIR__"npc/jiaotu" : 2,
       ]) );
        set("outdoors", "wudujiao");
	set("coor/x",-15);
	set("coor/y",-430);
	set("coor/z",0);
	set("coor/x",-15);
	set("coor/y",-430);
	set("coor/z",0);
	setup();
}
int valid_leave(object me, string dir)
{
        object *inv;
        object ob;
        int i;
        if( userp(me))
        {
        if( me->query("class") != "wudujiao" && dir == "west" && ob=present("jiaotu", this_object()))
        {
                inv = all_inventory(me);
                for(i=0; i<sizeof(inv); i++)
                        if(inv[i]->query("jiao_cloth") && (int)inv[i]->query("equipped"))
	                        return 1;
                return notify_fail(ob->name()+"向你厉声喝道：你当五毒教是什么地方 ？ 是你想进就进的吗？非五毒教教徒不得入内！！\n");
        }
        return 1;
        }
        else return 1;
}

void reset()
{
object *inv, ob;
int i;
::reset();
ob=present("jiaotu", this_object());
if(ob) ob->set("chat_chance_combat",50);
inv = all_inventory();
if(ob)
{
ob->dismiss_team();
for(i=0;i<sizeof(inv);i++)
        if(inv[i]->query("id") == "jiaotu" && inv[i] != ob)
        if(i<=1)
        ob->add_team_member(inv[i]);
}
}

