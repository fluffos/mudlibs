inherit ROOM;
void create()
{
	set("short", "抱子石");
	set("long", @LONG
这里是终南山有名的抱子崖，迎面一块巨石突起，有如一老妇盘坐，森然俯视，双
臂环绕间的一块小石，正如一襁褓中的婴儿，惟妙惟肖，堪称一绝。
LONG
	);
	set("exits", ([	
  "northdown" :	__DIR__"shandao",
  "southup" : __DIR__"baozishi",
]));
	set("outdoors",	"zhongnan");
	set("coor/x",10);
	set("coor/y",-700);
	set("coor/z",100);
//	set("coor/x",30);
//	set("coor/y",-580);
//	set("coor/z",10);

	setup();
}
void init()
{
	add_action("do_go","go");

}

int do_go()
{
if(random(3)){
this_player()->move(this_object());
return 1;
}
}