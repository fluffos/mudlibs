inherit ROOM;
void create() {
  set("short", "终南山大道");
  set("long", @LONG
从莽林出来，这里景色豁然一变，只见冈峦回绕，松柏森映，水田蔬圃连绵其间，宛
然有江南景色。一条平坦的官道沿山脚蜿蜒而上，远远望见前方有一寺庙。这里已是终南
山脚下了。
LONG
  );
  set("exits", ([
    "southup": __DIR__ "puguangsi",
    "northeast": "/d/manglin/center4",
  ]));
  set("outdoors", "zhongnan");
  set("coor/x", 30);
  set("coor/y", -580);
  set("coor/z", 10);
  //	set("coor/x",30);
  //	set("coor/y",-580);

  //	set("coor/z",10);
  setup();
}
void init() {
  add_action("do_go", "go");

}

int do_go() {
  if (random(3)) {
    this_player()->move(this_object());
    return 1;
  }
}
