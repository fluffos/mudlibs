inherit ROOM;
#include <room.h>
void create() {
  set("short", "普光寺内室");
  set("long", @LONG
这里应该是本寺僧人休息的地方，房间墙角摆着两张木床，床上铺着破旧的被褥。
LONG
  );
  set("exits", ([
    "north": __DIR__ "puguangsi",
  ]));
  create_door("north", "木门", "south", DOOR_CLOSED);

  set("coor/x", 30);
  set("coor/y", -660);
  set("coor/z", 30);
  setup();
  replace_program(ROOM);
}
