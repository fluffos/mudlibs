inherit	ROOM;
void cloth_path();
void create()
{
	set("short", "古松树后");
	set("long", @LONG
这里常年不见阳光,树下极是阴暗,杂草高过人头,长草遮掩下露出
石碑的一角,隐隐显现"长春"二字"。
LONG
	);
	set("exits", ([	
  "west" : __DIR__"puguangsi",
]));
       set("objects", ([
		__DIR__"obj/stone" : 1,
       ]) );


	set("coor/x",20);
	set("coor/y",-650);

	set("coor/z",30);
	setup();
}
void init()
{
	add_action("do_open", "push");
}
int do_open(string arg)
{
	object obj;
	object me;
	if(!arg	|| arg=="")
	{
		write("你要推什么？\n");
		return 1;
	}
	if( arg	== "shibei" || arg == "石碑")
	{
	me = this_player();
	

		if((int)me->query("force")<300)
		message_vision("$N奋起吃奶的劲猛推石碑,但是石碑纹丝不动。\n", me);
		else
		{
	 if( !query("exits/down") ) {
	message_vision("$N奋起吃奶的劲猛推石碑,石碑缓缓移开,下面原来有一个洞。\n", me);
	set("exits/down", __DIR__"shidong");
	call_out("close_path", 1);
	}}
	return 1;
	}
	else
	{
		write("你不可以推"+arg+"\n");
		return 1;
	}
}
void close_path()
{
	if( !query("exits/down") ) return;
	message("vision",
"石碑晃了一下,又弹了回来，遮住了洞口。\n",
		this_object() );
		delete("exits/down");
}