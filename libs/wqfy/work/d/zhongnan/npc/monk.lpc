#include <ansi.h>
inherit	NPC;

int send_fan();

void create()
{
	set_name("和尚", ({ "monk"}) );
	set("gender", "男性");
	set("age", 32);
	set("long",
		"这个和尚正在没精打采的念经。\n"
	);
	set("attitude",	"peaceful");
	set("combat_exp", 100000);
	 set("command","feel");
	 set("chat_chance",2);
	 set("chat_msg",({
		"神雕大侠......唔......唔......玄铁剑??????\n",
		"阿.....嘛.....咪.....嘛.....咪.....哄.....\n"

				})   );
	set("env/wimpy", 100);
	set("inquiry", ([
		"玄铁剑" : "传说最后和神雕大侠一起消失在古墓中了......你问这做什么?(answer)"
	]) );
	setup();
	carry_object("/d/zhongnan/obj/sword")->wield();
	carry_object("obj/cloth")->wear();
}


void init()
{
add_action("do_answer","answer");

}
int do_answer(string arg)
{
if(arg == "少管闲事,再不说我杀了你" ) {
command("say 不要杀我，我说...我说...在...在前面的石碑下面！\n");

this_player()->set_temp("xtsword",1);
}

	return 1;
}