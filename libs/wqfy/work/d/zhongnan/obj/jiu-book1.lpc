// An example book

inherit	ITEM;

void create()
{
	set_name("九阴真经-轻功篇" , ({	"jiu-move" }) );
	set_weight(600);
	set("unit", "本");
	set("long", "这是九阴真经中的轻功篇章\n");
	set("value", 0);
	set("skill", ([
		"name":			"move",	     
		"exp_required":	200000,	      
		"sen_cost":		30,
		"difficulty":	20,  
		"max_skill":	200	
	]) );
}