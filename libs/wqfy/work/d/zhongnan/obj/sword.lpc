// msword.c

#include <weapon.h>

inherit SWORD;

void create() {
  set_name("木剑", ({ "sword" }));
  set_weight(70);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long", "这是一把奇形怪状的木质宝剑。\n");
    set("value", 40000);
    set("real", 0);
    set("material", "stone");
    set("rigidity", 700);
    set("wield_msg", "$N抽出一把奇形怪状的$n握在手中。\n");

    set("unwield_msg", "$N将手中的$n插入腰间。\n");
  }
  init_sword(45);
  setup();
}
