// msword.c

#include <weapon.h>

inherit SWORD;

void create() {
  set_name("玄铁剑", ({ "xtsword" }));
  set_weight(2000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long", "这是一把黑黝黝的铁剑,看起来分量不轻，剑脊上写着“大巧不工，重剑无锋”。\n");
    set("value", 40000);
    set("real", 0);
    set("material", "stone");
    set("rigidity", 700);
    set("wield_msg", "$N抽出一把黑黝黝的$n握在手中。\n");

    set("unwield_msg", "$N将手中的$n插入腰间。\n");
  }
  init_sword(120);
  setup();
}
