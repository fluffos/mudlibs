inherit ITEM;

void create() {
  set_name("摇摇欲坠的破石碑", ({ "shibei", "石碑" }));
  set_weight(500);
  set_max_encumbrance(80000);
  set("no_get", 1);
  set("no_shown", 1);
  set("prep", "under");
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "座");
    set("long", "一座摇摇欲坠的破石碑，碑上刻的却是长春子丘处机的一首诗，诗云：
			天苍苍兮临下土，
			胡为不救万灵苦？
			万灵日夜相凌迟，
			饮气吞声死无语。
			仰天大叫天不应，

			一物细琐枉劳形。
			安得大千复混沌，
			免教造物生精灵。
\n");
    set("value", 1);
  }
}

int is_container() { return 1; }
