#include <ansi.h>
inherit ITEM;
void create() {
  set_name("黑漆盒", ({ "muhe" }));
  set_weight(300);
  set_max_encumbrance(8000);
  set("unit", "个");
  set("long", "一个黑色精致的木盒,上书 '九阴真经'	四个篆文。\n");
  set("closed", 1);
  set("value", 20000);
}

int is_container() { return 1; }

void init() {
  if (this_player() == environment())
    add_action("do_open", "open");
}

int do_open(string arg) {
  object me, ob;
  if (!arg || arg != "muhe")
    return notify_fail("你要打开什么？\n");
  me = this_player();
  ob = this_object();
  message_vision("$N“嘎吱”一声，将$n打开了。。。\n", me, ob);
  ob->set("closed", 0);
  return 1;
}

int is_closed() {
  return ((int)this_object()->query("closed"));
}
