inherit	ROOM;
void create()
{
	set("short", "山道");
	set("long", @LONG
从莽林出来，这里景色豁然一变，只见冈峦回绕，松柏森映，水田蔬圃连绵其间，
宛然有江南景色。一条平坦的官道沿山脚蜿蜒而上，远远望见前方有一寺庙。这里已
是终南山脚下了。
LONG
	);
	set("exits", ([	
  "east" : __DIR__"puguangsi",
  "southup" : __DIR__"baozishi",
]));
	set("outdoors",	"zhongnan");
	set("coor/x",10);
	set("coor/y",-660);
	set("coor/z",50);
//	set("coor/x",30);
//	set("coor/y",-580);

//	set("coor/z",10);
	setup();
}
void init()
{
	add_action("do_go","go");

}

int do_go()
{
if(random(3)){
this_player()->move(this_object());
return 1;
}
}