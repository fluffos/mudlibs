inherit ROOM;
#include <room.h>
void create() {
  set("short", "普光寺");
  set("long", @LONG
这是一座小小的寺院，看起来香火并不怎么好，正对着大门的如来佛像金漆剥落，
挂满了蛛网，仅有的两个僧人没精打采地默默念诵着什么，你的来访似乎并没有引起
他们的注意。门口有一棵古松，郁郁葱葱，极是繁茂，树后的草丛中好象有一块石碑。
LONG
  );
  set("exits", ([ /* sizeof() == 4 */
    "west": __DIR__ "shandao",
    "northdown": __DIR__ "shanmen",
    "south": __DIR__ "neishi",
  ]));
  create_door("south", "木门", "north", DOOR_CLOSED);
  set("objects", ([
    __DIR__ "npc/monk": 2,
  ]));

  set("item_desc", ([
    "grass": "这里的茅草(grass)很密，但你似乎可以拨开(pushaside)它们。\n",
    "茅草": "这里的茅草(grass)很密，但你似乎可以拨开(pushaside)它们。\n"
  ]));

  set("coor/x", 30);
  set("coor/y", -650);
  set("coor/z", 30);
  setup();
  //	  replace_program(ROOM);
}


void init() {
  add_action("do_push", "pushaside");
}
int do_push(string arg) {
  object obj;

  object me;
  if (!arg || arg == "") {
    write("你要拨开什么？\n");
    return 1;
  }
  if (arg == "grass" || arg == "茅草" || arg == "草") {
    me = this_player();
    message_vision("$N拨开路边的茅草，发现原来有一条隐秘的小路通向树后。\n", me);

    if (!query("exits/east")) {
      set("exits/east", __DIR__ "btree");
      call_out("close_path", 5);
    }
    return 1;
  } else {
    write("你不可以爬" + arg + "\n");

    return 1;
  }
}
void close_path() {
  if (!query("exits/east")) return;
  message("vision",
    "一阵风吹过，茅草晃了晃，又淹没这条隐秘的小路。\n",
    this_object());
  delete("exits/east");
}
