// seller.c
//黑市商人
//wdl by 2001/1/1

inherit NPC;
inherit F_VENDOR;

void create() {
  set_name("精细虫", ({ "seller" }));
  set("gender", "男性");
  set("age", 22);
  set("long",
    "这位是大名鼎鼎的精细虫，谁买他的东西都会被宰一刀。\n");
  set("combat_exp", 10000000);
  set("attitude", "friendly");
  set("rank_info/respect", "宰一刀");
  set("vendor_goods", ([
  ]));
  setup();


}


void init() {
  object ob;

  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
  add_action("do_vendor_list", "list");
}

void greeting(object ob) {
  if (!ob || environment(ob) != environment()) return;
  switch (random(3)) {
    case 0:
      say("此人笑咪咪地说道：这位" + RANK_D->query_respect(ob)
        + "，本人新近从一位炼金术士那里价钱得到一批珍贵的物品，至于价钱嘛……\n");
      break;
    case 1:
      say("此人用那对贼溜溜的耗子眼瞄了你几下，说道：这位" + RANK_D->query_respect(ob)
        + "，您需要点什么？\n");
      break;
    case 2:
      say("精细鬼说道：这位" + RANK_D->query_respect(ob)
        + "，常常鲜吧。。\n");
      break;
  }
}
