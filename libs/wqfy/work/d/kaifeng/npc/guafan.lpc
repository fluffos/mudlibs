// tea_waiter.c

inherit NPC;
inherit F_VENDOR;

void create() {
  set_name("瓜农", ({ "guanong" }));
  set("gender", "男性");
  set("age", 60);
  set("long",
    "一个靠种瓜来为生的农民。\n");
  set("combat_exp", 5);
  set("attitude", "friendly");
  set("rank_info/respect", "老伯");
  set("chat_chance", 3);
  set("chat_msg", ({
    "瓜农叹了口气，道：辛苦种瓜一年，却又赚几个钱呀.......\n",
  }));

  set("vendor_goods", ([
    __DIR__ "obj/xigua": 11,
    __DIR__ "obj/tiangua": 22,

  ]));
  setup();
}

void init() {
  add_action("do_vendor_list", "list");
}
