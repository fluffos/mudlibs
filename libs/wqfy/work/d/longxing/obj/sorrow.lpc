#include <weapon.h>

inherit WHIP;
#include <ansi.h>
void create() {
  set_name(HIW "白羽神箭" NOR, ({ "baiyu-sorrow" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一把人见人怕的白羽神箭\n");
    set("unit", "堆");
    set("value", 10000);
    set("base_unit", "把");
    set("base_weight", 1);
    set("base_value", 1);
    set("wield_msg", "$N左手拉弓,右把" HIW "白羽神箭" NOR "拿在手上．\n");
  }
  init_whip(300);
  setup();
}
