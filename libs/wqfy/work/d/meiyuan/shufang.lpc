inherit ROOM;
#include <ansi.h>
void create() {
  set("short", HIY "赋闲居" NOR);
  set("long", @LONG
这里是主人休息看书的地方。房间里摆设很简单，
但很干净一张书桌，几把逍遥椅，桌子上放着一套景致
的紫砂茶壶。东面的墙上挂满了名人墨宝。西面是一个
巨大的书架。
LONG
  );
  set("exits", ([ /* sizeof() == 4 */
    "south": __DIR__ "meilin",
  ]));
  set("objects", ([
    __DIR__ "obj/bookcase": 1,
  ]));
  set("coor/x", -640);
  set("coor/y", -490);
  set("coor/z", 30);
  setup();
  replace_program(ROOM);
}

void reset() {
  object *inv;
  object item1, item2, bookcase;
  ::reset();

  bookcase = present("bookcase", this_object());
  inv = all_inventory(bookcase);
  if (!sizeof(inv)) {
    item1 = new(__DIR__ "obj/shengxian");
    item1->move(bookcase);
    item2 = new(__DIR__ "obj/shengxian");
    item2->move(bookcase);
  }


}
