// XXDER
inherit	ITEM;
void create()
{
	string *names =	({
		"「圣贤书」",
	});

	set_name( names[random(sizeof(names))],	({ "shengxian" }));
	set_weight(600);
	set("unit", "本");
	set("long", "这是读书人常看的书籍。\n");
	set("value",3000000);
	set("skill", ([
		"name":			"literate",		// name	of the skill
		"exp_required":	0,				// minimum combat experience required
										// to learn this skill.
		"sen_cost":		40,				// gin cost every time study this
		"difficulty":	70,				// the base int	to learn this skill
										// modify is gin_cost's	(difficulty - int)*5%

		"max_skill":	200				 // the	maximum	level you can learn
										// from	this object.
	]) );
}