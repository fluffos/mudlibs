inherit	ROOM;
#include <ansi.h>
void create()
{
	set("short",HIC	"花园" NOR);
	set("long", @LONG
好大的一个花园。花园周围种满了各种各样五颜六色
的奇珍异草，四季常开，香飘万里。花园中间一个大水池，
水池中间的假山上盘着九条蛟龙。九只龙头常年流出潺潺
的泉水。池中几十尾金龙鱼自由自在的畅游着。
LONG
	);
	set("exits", ([	/* sizeof() == 4 */
  "south" : __DIR__"xiaolu2",
  "north" : __DIR__"taijie",
  "east"  : __DIR__"yonglu",
  "west"  : __DIR__"yonglu2"
]));

	set("coor/x",-640);

	set("coor/y",-490);
	set("coor/z",30);
	setup();
	replace_program(ROOM);
}