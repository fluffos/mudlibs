inherit ROOM;
#include <room.h>
#include <ansi.h>
void create() {
  set("short", HIC "雁渡寒潭" NOR);
  set("long", @LONG
“清风抚竹，风去竹不留声。雁渡寒潭，雁去潭不留影”
潭如其名，清澈的潭水寒彻透骨。潭边种满翠绿的竹子，潭中
一个小岛。岛上有一小亭。
LONG
  );
  set("exits", ([
    "east": __DIR__ "yonglu2",
    "enter": __DIR__ "xiaoting",
  ]));

  set("no_magic", 1);
  set("no_fight", 1);
  set("coor/x", -40);

  set("coor/y", 40);
  set("coor/z", 0);
  setup();

}

void init() {
  add_action("do_jump", "jump");

}

int do_jump() {
  object me;
  int wait;
  me = this_player();
  wait = random(40 - (int)(me->query("con"))) * 0;
  if (wait <= 2) wait = 3;
  message_vision("$N噗嗵一声跳进潭中．\n", me);

  tell_object(me, "冰冷的潭水围绕着你,你已经感觉到身体有些麻木了．．\n");
  remove_call_out("curehimup");
  call_out("curehimup", wait, me);
  return 1;
}

void curehimup(object me) {
  int gin, kee, sen;
  if (!me) return;
  gin = (int)me->query("max_gin");
  kee = (int)me->query("max_kee");
  sen = (int)me->query("max_sen");
  if (me && environment(me) == this_object()) {
    message_vision("$N的精气神全恢复了！！\n", me);
    me->set("eff_gin", gin);
    me->set("eff_kee", kee);
    me->set("eff_sen", sen);
    me->set("gin", gin);
    me->set("kee", kee);
    me->set("sen", sen);
  }
  return;
}
