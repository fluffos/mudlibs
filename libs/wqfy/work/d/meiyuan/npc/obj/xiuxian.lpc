// XXDER
inherit	ITEM;
#include <ansi.h>
void create()
{
	string *names =	({
	       HIR "修仙入门" NOR,
	});

	set_name( names[random(sizeof(names))],	({ "xiuxian" }));
	set_weight(600);
	set("unit", "本");
	set("long", "妄想修道成仙的人天天捧着读的破书\n");
	set("value", 500000);
	set("skill", ([
		"name":			"incarnation",		   // name of the skill
		"exp_required":	0,				// minimum combat experience required
										// to learn this skill.
		"sen_cost":		40,				// gin cost every time study this
		"difficulty":	50,				// the base int	to learn this skill

										// modify is gin_cost's	(difficulty - int)*5%
		"max_skill":	100				 // the	maximum	level you can learn
										// from	this object.
	]) );
}