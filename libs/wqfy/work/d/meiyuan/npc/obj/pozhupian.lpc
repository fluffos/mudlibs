// XXDER
inherit	ITEM;
#include <ansi.h>
void create()
{
	string *names =	({
	       HIG "破竹片" NOR,
	});

	set_name( names[random(sizeof(names))],	({ "pozhupian" }));
	set_weight(600);
	set("unit", "片");
	set("long", "一片脏兮兮的破竹片。上面隐隐约约刻着一些字。\n");
	set("value", 800000);
	set("skill", ([
		"name":			"move",		    // name of the skill
		"exp_required":	0,				// minimum combat experience required
										// to learn this skill.
		"sen_cost":		40,				// gin cost every time study this
		"difficulty":	50,				// the base int	to learn this skill

										// modify is gin_cost's	(difficulty - int)*5%
		"max_skill":	160				 // the	maximum	level you can learn
										// from	this object.
	]) );
}