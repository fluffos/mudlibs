//mac's houshan.c
#include <room.h>
#include <ansi.h>
inherit ROOM;

void create()
{
  set("short","静心居");
  set("long",@LONG
这是一间僻静的禅房，相传少林高僧曾在此以易筋经化解令狐冲
的内伤，桌上放着一本曲谱。如果你勤奋好学，或许可以在这里
领悟一些武功。
LONG
  );
  set("exits",([
         "south": __DIR__"houshan.lpc",
               ]));
  set("outdoors","qianfo"); 
  set("coor/x",50);
	set("coor/y",2120);
	set("coor/z",30);
	setup();
}
void init()
{
    add_action("do_lingwu","lingwu");
    add_action("do_testlevel","levelmax");
}
int	do_lingwu(string str)
{
	int skill, cost;
	int task,bigtask,eff_task;
	int i,n,max_level;
	object me;
	string msg;
	
	me=this_player();	    

	if( me->is_fighting() )
		return notify_fail("不能在战斗中领悟。\n");
	task=(int)me->query("TASK");
	bigtask=(int)me->query("bigtasks");
	eff_task=task+bigtask*2;
	
	if( eff_task<=8000)
		return notify_fail("你的努力不够, 不能领悟吸星大法！\n");
	if((int)me->query("int")<50)
		return notify_fail("你的悟性不够，无法领悟武林绝学。\n"); 
	cost = (int)me->query("int") - 45;

	eff_task-=8000;
	for(i=0;i<800;i++){
	    if((i*i)<(eff_task*25))continue;
	    else 
		{
		max_level=i;
		i=800;
		}
	}	
	skill = me->query_skill("xixing-dafa",1);
	if(skill==0){
	    me->set_skill("xixing-dafa",1);
	    return notify_fail("你领悟了吸星大法！\n");
	    
	    }
	if( skill >=max_level)
	    return notify_fail("你要不断努力, 才能继续领悟吸星大法！\n");
	if( skill > 700)
		return notify_fail("你的吸星大法等级已经不能通过领悟的办法获得了！\n");

	if( me->query("force") < 50 )
		return notify_fail("你的内力不够，没有力气修炼「吸星大法」！\n");
 
	if( me->query("gin") < cost )
		return notify_fail("你现在太累了，无法集中精神修练「吸星大法」！\n");

	msg = HIC "$N盘膝入定，开始领悟吸星大法。\n";
	message_vision(msg, me);

	me->add("force", -50);
	me->add("gin", -cost);

	if (skill < 90)
		me->improve_skill("xixing-dafa", 10 + random((int)me->query("int") - 9));
	else if (skill < 200)
		me->improve_skill("xixing-dafa", 10 + random((int)me->query("int") * 4 - 9));
	else
		me->improve_skill("xixing-dafa", 10 + random((int)me->query("int") * 8 - 9));

	msg = MAG"$P的「吸星大法」进步了！\n"NOR;
	me->start_busy(random(3));

	message_vision(msg, me);

	return 1;
}
int	do_testlevel(string str)
{
	int skill, cost;
	int task,bigtask,eff_task;
	int i,n,max_level;
	object me;
	string msg;
	if(!str)
	me=this_player();
	else {
	    me=find_player(str);
	    if(!me)return notify_fail("你要查看谁的等级\n");	    
	    }

	task=(int)me->query("TASK");
	bigtask=(int)me->query("bigtasks");
	eff_task=task+bigtask*2;
	
	if( eff_task<=8000)
		return notify_fail("你的努力不够, 不能领悟吸星大法！\n");
	if((int)me->query("int")<50)
		return notify_fail("你的悟性不够，无法领悟武林绝学。\n"); 
	cost = (int)me->query("int") - 45;

	eff_task-=8000;
	for(i=0;i<800;i++){
	    if((i*i)<(eff_task*25))continue;
	    else 
		{
		max_level=i;
		i=800;
		}
	}	
	return notify_fail("你的努力可以达到"+max_level+"级吸星大法！\n");
	return 1;
}
