//by xgchen@fy
inherit ITEM;
void create() {
  set_name("石墙", ({ "石墙", "shiqiang" }));
  set_weight(6000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
    set("long",
      "一个着衣配坐的神妃像，上面好象刻着一些字。\n");
    set("value", 70);
    set("material", "wood");
    set("no_shown", 1);
    set("no_get", 1);
    set("no_drop", 1);
    set("skill", ([
      "name": "lingxiyizhi",
      "exp_required": 0,
      "sen_cost": 300,
      "difficulty": 200,
      "max_skill": 10
    ]));
  }
}
