// copy to /d/wsc/npc/zyhou.c
inherit NPC;
#include <ansi.h>
void create()
{
	set_name(MAG "紫衣侯" NOR, ({ "zyhou" }) );
	set("title", "五色帆船主");	
	set("gender", "男性" );
set("age", 42);
        set("str", 90);
        set("cor", 30);
        set("cps", 30);
       set("int", 30);
	set("per", 30);
        set("agi",25);	
	set("long",
		"这位就是名震天下的五色帆船主了，虽然看上去却不如想象
中那般严肃神情中带着说不出的疲倦，但仍带着让人不敢逼
视的威严。\n");
        set("chat_chance", 1);
        set("chat_msg", ({
               "紫衣侯说道：伽星大师，我是不会和你比的，你还是走吧。\n",
                "紫衣侯说道：我已经十多年没和人动手了。\n",
        }) );
        set("max_force", 15000);
        set("force", 15000);
        set("force_factor", 300);
	set("max_kee",999999);
        set("max_gin",999999);
        set("max_sen",999999);
	set("eff_kee",999999);
	set("kee",999999);		
	set("combat_exp", 10000000);
	set("attitude", "friendly");
	set_skill("unarmed",200);
	set_skill("dodge",200);
        set_skill("move", 200);
        set_skill("parry", 150);
        set_skill("force", 200);
        set_skill("literate", 200);
	set_skill("sword", 200);	
	setup();
	carry_object(__DIR__"obj/zipao")->wear();
	carry_object(__DIR__"obj/dysword")->wield();
}
int accept_object(object me, object obj)
{
	object real;
	if( (string) obj->query("name") == "枯树枝")
	{
        command("sigh");
        command("say 好快的剑法！这位" + RANK_D->query_respect(me) +
"，我与这人一战关系武林，这把钥匙给你，
若我不幸落败，你可进入密室。");
	me->set("marks/紫衣侯",0);
	real = new(__DIR__"obj/key");
        if(!me->query("m_success/密室钥匙"))
        {
                me->set("m_success/密室钥匙",1);
       }
	if( real )
	real->move(me);	
        return 1;
	}
	return 0;
}
