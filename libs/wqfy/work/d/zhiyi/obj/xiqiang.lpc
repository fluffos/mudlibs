// copy to /d/wsc/obj/xiqiang.c
inherit ITEM;
void create() {
  set_name("大禹剑法", ({ "西墙", "xiqiang" }));
  set_weight(600);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "章");
    set("long",
      "紫衣侯从古籍中偶然获得的一种威力无穷的剑法。\n");
    set("value", 70);
    set("material", "stone");
    set("no_shown", 1);
    set("no_get", 1);
    set("no_drop", 1);
    set("skill", ([
      "name": "dayusword",
      "exp_required": 0,
      "sen_cost": 50,
      "difficulty": 150,
      "max_skill": 70
    ]));
  }
}
