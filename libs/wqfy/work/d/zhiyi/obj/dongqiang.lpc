// copy to /d/wsc/obj/dongqiang.c
inherit ITEM;
void create() {
  set_name("无为心法", ({ "东墙", "dongqiang" }));
  set_weight(600);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "章");
    set("long",
      "紫衣侯融汇古今，自创的一种妙用无穷的内功心法。\n");
    set("value", 70);
    set("material", "stone");
    set("no_shown", 1);
    set("no_get", 1);
    set("no_drop", 1);
    set("skill", ([
      "name": "wuwei-force",
      "exp_required": 0,
      "sen_cost": 5,
      "difficulty": 150,
      "max_skill": 100
    ]));
  }
}
