// hongbao.c
// ken 1999.12.3
#include <ansi.h>
inherit ITEM;

void create()
{
        string *names = ({
               HIG "新年红包"NOR, HIM "新年红包"NOR, HIW "新年红包"NOR, HIY "新年红包"NOR, HIR "新年红包"NOR
        });

        set_name( names[random(sizeof(names))], ({ "hongbao" }));
        set_weight(10);
        set("value", 1);
        set("unit", "个");
        set("long", "这是春节给的红包，你可以打开(open)看看。\n");
        setup();
}  

void init()
{
        add_action("do_open", "open");
}

int do_open(string arg)
{
	object me;
        int exp,pot,score;
        exp=4000+random(2000);
        pot=exp/7;
        score=50+random(50);
    	me = this_player();
      if( !arg || arg=="" ) return 0;

       if (this_player()->query("chunjiehongbao3") == 1){
              message_vision(HIR"$N已经奖励过了，请不要乱用。\n"NOR,this_player());
                return 1;
        }
      if( arg=="hongbao" || arg =="红包" ) {
      message_vision("\n\n$N抹了抹头上的汗水，用颤抖的双手, 迫不急待地打开了"+this_object()->name()+"。\n"NOR , me);
      message_vision(HIW"\n$N满意地点了点头，呵呵地傻笑了两声。\n\n"NOR, me);
      me->add("combat_exp",exp);
      me->add("potential",pot);
      me->add("score",score);
      me->add("chunjiehongbao3",1); 
tell_object(me,HIY"你被奖励了：\n" +
        chinese_number(exp) + "点实战经验\n"+chinese_number(pot) + "点潜能\n"+
         chinese_number(score) + "点评价\n"+
         NOR);
       tell_object(me,HIR"\n郑州风云恭喜大家马年进步!！\n"NOR);
       destruct(this_object());
       return 1;
}
         return 1;
}

//}
