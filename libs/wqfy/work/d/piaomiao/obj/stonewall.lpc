inherit	ITEM;
void create()
{
	set_name("石壁", ({ "石壁","stonewall"}));
	set_weight(600);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "章");
		set("long",
			"一堵刻着天山折梅手的石壁。\n");
		set("value", 70);
		set("material",	"stone");
		set("no_shown",1);
		set("no_get",1);
		set("no_drop",1);
	if(random(2))
		set("skill", ([
			"name":			"zhemei-strike",	
			"exp_required":	0,		

			"sen_cost":		50,	
			"difficulty":	50,	
			"max_skill":	99		
		]) );
	
	}
}