#include <room.h>
inherit ROOM;
void create() {
  set("short", "寝室");
  set("long", @LONG
这是一间极大的房子，空荡荡地倒与少林寺的禅房差不多，房
中陈设古雅，铜鼎陶瓶，也有些像少林寺中的铜钟香炉。青色的帐
子遮着一张温软的床。
LONG
  );
  set("exits", ([
    "south": __DIR__ "meetingroom.lpc",
  ]));
  set("objects", ([
    __DIR__ "npc/master_xuzhu": 1,
    __DIR__ "npc/meijian": 1,
    __DIR__ "npc/lanjian": 1,
  ]));



  set("outdoors", "piaomiao");
  set("coor/x", 0);
  set("coor/y", 0);
  set("coor/z", 0);
  setup();
  replace_program(ROOM);
}
