#include <room.h>
inherit ROOM;
void create() {
  set("short", "后花园");
  set("long", @LONG
正值早春，一片皑皑积雪之间，萌出青青小草，奇哉!	此地竟
有竹子!	花园中间用巨竹搭着一个凉亭，构筑精雅，极尽巧思，竹
即是亭，亭即是竹，一眼看去，竟分不出是竹林还是亭子。亭子后
面是一扇石门。
LONG
  );
  set("exits", ([
    "west": __DIR__ "dadian.lpc",
    "north": __DIR__ "stoneroom.lpc",
  ]));
  set("objects", ([
    __DIR__ "npc/jujian": 1,
    __DIR__ "npc/zhujian": 1,
  ]));



  set("outdoors", "piaomiao");
  set("coor/x", 0);
  set("coor/y", 0);
  set("coor/z", 0);
  setup();
  create_door("north", "石门", "south", DOOR_CLOSED);

}
