#include <room.h>
inherit	ROOM;
void create()
{
  set("short","断魂崖");
  set("long",@LONG
此崖是山间突出的一个平台，甚为狭窄，仅有四尺见方，放眼
下看，隐约可以看到崖底怪石嶙峋，且此处乃是天然风口，山风凛
冽，吹得人摇摇欲坠。
LONG
  );
  set("exits",([
	 "southdown":__DIR__"piaomiao.lpc",
	 "eastup":__DIR__"shizu.lpc",	 
	]));
	
	set("outdoors",	"piaomiao");
  set("coor/x",0);
	set("coor/y",0);
	set("coor/z",0);

	setup();
  replace_program(ROOM);
}