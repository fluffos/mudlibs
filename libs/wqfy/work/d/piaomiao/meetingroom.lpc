#include <room.h>
inherit ROOM;
void create() {
  set("short", "议事厅");
  set("long", @LONG
灵鹫宫共分八部--昊天部，朱天部，赤天部，阳天部，玄天部
幽天部，成天部，鸾天部以及均天部。每当宫里发生大事时，各部
姐妹的首领就会被宫主招到此地商议，平时八部的人都分布于江湖
之中。所以无论江湖上有什么风吹草动，都瞒不过灵鹫宫主。
LONG
  );
  set("exits", ([
    "north": __DIR__ "qinshi.lpc",
    "east": __DIR__ "dadian.lpc",
  ]));

  set("outdoors", "piaomiao");
  set("coor/x", 0);
  set("coor/y", 0);

  set("coor/z", 0);
  setup();
  replace_program(ROOM);
}
