#include <room.h>
inherit ROOM;
void create() {
  set("short", "青石路");
  set("long", @LONG
两侧是峭壁，这条小路一直蜿蜒到峰顶. 地面是用青石板铺成
的大道，每块青石都是长约八尺，宽约三尺，甚是整齐，要铺成这
样的大道，工程浩大之极.	越往上走白雾越浓.
LONG
  );
  set("exits", ([
    "north": __DIR__ "fengding.lpc",
    "southwest": __DIR__ "road4.lpc",
  ]));

  set("outdoors", "piaomiao");
  set("coor/x", 0);
  set("coor/y", 0);
  set("coor/z", 0);

  setup();
}
