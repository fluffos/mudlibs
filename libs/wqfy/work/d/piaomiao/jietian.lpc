#include <room.h>
inherit ROOM;
void create() {
  set("short", "接天桥");
  set("long", @LONG
虽然名为接天桥实则是一条碗口粗的巨大铁索，而你就身在铁
索之上，山峰吹起时，铁索微微晃动使你急于离开这里.
LONG
  );
  set("exits", ([
    "west": __DIR__ "baizhang.lpc",
    "east": __DIR__ "road1.lpc",
  ]));

  set("outdoors", "piaomiao");
  set("coor/x", 0);
  set("coor/y", 0);
  set("coor/z", 0);
  setup();

  replace_program(ROOM);
}
