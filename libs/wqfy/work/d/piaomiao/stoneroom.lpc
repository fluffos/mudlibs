#include <room.h>
inherit	ROOM;
void create()
{
  set("short","石室");
  set("long",@LONG
进入石室，只见四壁岩石打磨得甚是光滑，石壁上刻满了无数径
长尺许的圆圈，每个圈中都刻了各种各样的图形，有的是人像，有的
是兽形，有的是残缺不全的文字，更有些只是记号和线条，圆圈旁注
着“甲一”、“甲二”、“子一”、“子二”等数字，圆圈之数若不
逾千，至少也有八九百个，一时却哪里看得周全，依稀可以看见上面
刻的文字:天-山-折-梅-手，竟然是仅次于天山六阳掌的绝世武功.
LONG
  );
  set("exits",([ 
	 "south":__DIR__"huayuan.lpc",	 
	]));
 set("objects",	([
		__DIR__"obj/stonewall" : 1,
       ]) );

 
	set("outdoors",	"piaomiao");
	set("coor/x",0);
	set("coor/y",0);
	set("coor/z",0);
	setup();
	create_door("south", "石门", "north", DOOR_CLOSED);

	  replace_program(ROOM);
}