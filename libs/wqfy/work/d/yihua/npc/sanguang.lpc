inherit NPC;
#include <ansi.h>
inherit F_MASTER;
void create() {
  set_name(HIM "轩辕三光" NOR, ({ "sanguang" }));
  set("no_arrest", 1);
  set("gender", "男性");
  set("age", 46);
  set("long",
    "    此人衣衫落拓、神情极轩昂，他裤管直卷到膝盖，泥脚上穿的是双草鞋
一双腿黝黑如铁，上面还长满了黑茸茸的毛。\n");
  set("attitude", "peaceful");
  set("skill_public", 1);
  set("str", 40);
  set("cor", 30);
  set("int", 24);
  set("cps", 30);
  set("chat_chance", 1);
  set("chat_msg", ({
    " 轩辕三光咯咯笑道：“老予平生别的坏事不做，就喜欢逼赌。\n",
  }));

  set("force", 40000);
  set("max_force", 8000);
  set("force_factor", 100);

  set("combat_exp", 2500000);
  set("score", -50000);

  set_skill("move", 120);
  set_skill("dodge", 120);
  set_skill("stealing", 200);
  set_skill("betting", 200);
  set_skill("force", 150);
  set_skill("iron-cloth", 120);
  set_skill("jin-gang", 130);
  set_skill("throwing", 200);
  map_skill("iron-cloth", "jin-gang");
  //        map_skill("unarmed", "tigerstrike");

  create_family("eren", 1, "六师傅");
  set("title", HIW "恶赌鬼" NOR);
  setup();
  carry_object(__DIR__ "obj/shaizi")->wield();

}
