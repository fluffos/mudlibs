inherit NPC;
#include <ansi.h>
inherit F_MASTER;
void create()
{
        set_name(HIR "李大嘴" NOR, ({ "lidazui" }) );

        set("gender", "男性");
        set("age", 48);
        set("long",
                "此人国字四方脸，浓眉大眼，长的甚是英武，只是眼中有丝戾气，显然不是
善良之辈，手中拿着一古怪事物\n");
        set("attitude", "aggressive");
        set("skill_public",1);
        set("no_arrest",1);
        set("str", 40);
        set("cor", 30);
        set("int", 24);
        set("cps", 30);
        set("chat_chance", 1);
        set("chat_msg", ({
                "李大嘴拿起半截人手啃了几口．．．．\n",
        }) );

        set("force", 40000);
        set("max_force", 8000);
        set("force_factor", 100);

        set("combat_exp", 2000000);
        set("score", -20000);
        
        set_skill("move", 90);
       set_skill("dodge", 90);
        set_skill("unarmed", 200);
        set_skill("force", 100);
        set_skill("iron-cloth", 100);
        set_skill("jin-gang", 130);
        set_skill("tigerstrike", 130);
        map_skill("iron-cloth", "jin-gang");
        map_skill("unarmed", "tigerstrike");

        create_family("eren", 1, "三师傅");
        set("title", HIC "不吃人头" NOR);
        setup();
        carry_object(__DIR__"obj/shou")->wield();

}

