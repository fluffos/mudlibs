inherit NPC;
#include <ansi.h>
inherit F_MASTER;
void create() {
  set_name(HIG "铁战" NOR, ({ "tiezhan" }));
  set("no_arrest", 1);
  set("gender", "男性");
  set("age", 79);
  set("long",
    "    这人身材也不太高，最多也只不过有六、七尺，但横著来量，竟也有五尺六七，一个人
看来竟是方的，就像是一块大石头。他的头更大得出奇，头砍下来称一称，最少也有三
五十斤，满头乱蓬蓬的生著鸡窝般的一头乱发，头发连著胡子，胡子连著头发，也分不
清什么是胡子，什么是头发了，鼻子嘴巴，更是连找都找不到。远远望去，这人就像是
一块大石块上蹲著一头刺猬，又像是一头被什么东西压得变了形的雄狮。\n");
  set("attitude", "killer");
  set("skill_public", 1);
  set("str", 60);
  set("cor", 30);
  set("int", 24);
  set("cps", 30);
  set("chat_chance", 1);
  set("chat_msg", ({
    "铁战吼道：想打架吗？找我就对了．．．．\n",
  }));

  set("force", 40000);
  set("max_force", 8000);
  set("force_factor", 100);

  set("combat_exp", 2700000);
  set("score", -50000);

  set_skill("move", 120);
  set_skill("parry", 150);
  set_skill("lianxin-blade", 200);
  set_skill("dodge", 120);
  set_skill("unarmed", 200);
  set_skill("force", 150);
  set_skill("iron-cloth", 120);
  set_skill("jin-gang", 130);
  set_skill("blade", 200);
  map_skill("iron-cloth", "jin-gang");
  map_skill("blade", "lianxin-blade");
  map_skill("parry", "lianxin-blade");

  create_family("eren", 1, "二师傅");
  set("title", HIR "狂狮" NOR);
  setup();
  carry_object(__DIR__ "obj/blade")->wield();

}
