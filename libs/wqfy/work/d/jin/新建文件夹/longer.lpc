#include <ansi.h>
inherit NPC;
void create() {
  set_name("龙二", ({ "master longer", "longer", "master" }));
  set("long",
    CYN "他统领锦衣卫的总教头，奉皇帝的命令，来到风云城物色新一带的锦衣卫士。\n" NOR);
  set("nickname", RED "誓死效忠" NOR);
  create_family("锦衣卫", 1, "总教头");
  set("str", 47);
  set("cor", 46);
  set("cps", 45);
  set("agi", 45);
  set("int", 40);
  set("attitude", "friendly");
  set("max_force", 15000);
  set("force", 15000);
  set("force_factor", 3);
  set("chat_chance_combat", 90);
  set("chat_msg_combat", ({
    "龙二冷笑一声道：雕虫小技还敢跟本教头撒野。\n",
    // (: perform_action, "dodge." :),
  }));
  set("combat_exp", 8000000);
  set_temp("apply/damage", 500);
  set_skill("unarmed", 120);
  set_skill("sword", 120);
  set_skill("force", 140);
  set_skill("parry", 120);
  set_skill("dodge", 140);
  set_skill("jingyiforce", 150);
  set_skill("move", 100);
  set_skill("literate", 200);
  set_skill("danei-sword", 100);
  set_skill("changquan", 100);
  map_skill("unarmed", "changquan");
  map_skill("force", "jingyiforce");
  map_skill("sword", "danei-sword");
  map_skill("parry", "danei-sword");
  setup();

  carry_object("/d/jin/jinpao")->wear();
  carry_object("/d/jin/jsword")->wield();

}

void attempt_apprentice(object me) {
  if (!me->query("class")) {
    command("smile");
    command("say 很好，皇上命我招收一批新卫士，你要发誓誓死效忠皇上。\n");
    command("say 记住，锦衣卫的叛徒是没有好下场的。 \n");
    command("recruit " + me->query("id"));
  } else
    command("say 为了不混进奸细，皇上下旨，只收愿意为皇上办事的普通百姓，你还是请回吧。\n");
}

void recruit_apprentice(object ob) {
  if (::recruit_apprentice(ob))
    ob->set("class", "swordsman");

}
void init() {
  add_action("give_quest", "quest");
}
void re_rank(object student) {
  int exp;
  exp = (int)student->query("combat_exp");
  if (exp <= 4000) {
    student->set("title", WHT "锦衣卫 四等卫士" NOR);
    return;
  } else if (exp <= 10000) {
    student->set("title", WHT "锦衣卫 三等卫士" NOR);
    return;
  } else if (exp <= 18000) {
    student->set("title", WHT "锦衣卫 二等卫士" NOR);
    return;
  } else if (exp <= 30000) {
    student->set("title", WHT "锦衣卫 一等卫士" NOR);
    return;
  } else if (exp <= 60000) {
    student->set("title", WHT "锦衣卫 二等传令士" NOR);
    return;
  } else if (exp <= 120000) {
    student->set("title", WHT "锦衣卫 一等传令士" NOR);
    return;
  } else if (exp <= 300000) {
    student->set("title", WHT "锦衣卫 二等御前护卫" NOR);
    return;
  } else if (exp <= 800000) {
    student->set("title", WHT "锦衣卫 一等御前护卫" NOR);
    return;
  } else if (exp <= 6000000) {
    student->set("title", WHT "锦衣卫 副总教头" NOR);
    return;
  } else if (exp <= 12000000) {
    student->set("title", WHT "锦衣卫 钦赐一等一高手" NOR);
    return;
  } else
    student->set("title", "锦衣卫 总教头");
  return;

}
