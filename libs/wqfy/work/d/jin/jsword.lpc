//TIE@FY3
#include <ansi.h>
#include <weapon.h>
inherit	SWORD;
void create()
{
	set_name(WHT "锦剑" NOR, ({ "jsword" }) );
	set_weight(7000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "把");
                set("value", 10000);
		set("long", "这是一把锋利的宝剑，锦衣卫专用的宝剑。\n");
		set("material",	"steel");
		set("wield_msg", WHT"白光一闪，$N"WHT"的手里已经多了一把$n！\n");
		set("unwield_msg", "$N手中的$n无声无息地落入锦绣剑鞘。\n");
	}
	init_sword(45);
	setup();

}
