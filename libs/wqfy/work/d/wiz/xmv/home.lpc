// Room: edit by com
#include <ansi.h>
inherit ROOM;
string *ids = ({});
int get_setup(object me);
void checking(object me);
#define KETING "/d/xmvroom/mishi"
void create() {
  set("short", "客厅");
  set("long", @LONG
这里是絮絮的书房。大多数时候，他都在这里接待朋友和来宾。房间里面没有
过多的摆设，简简单单。不过你要是想坏事的话就要小心了......
     ("arrest")("add_in")("remove_in")("invite")
LONG);
  set("no_fight", 1);
  set("no_magic", 1);
  set("no_dazuo", 1);
  set("no_xiao", 1);
  set("no_spells", 1);
  set("exits", ([ /* sizeof() == 1 */
    //  "south" : __DIR__"xxxxxx",
  ]));
  setup();
}
void init() {
  string wiz_status;
  object me;
  me = this_player();
  if (me->query("id") == "xmv") {
    add_action("do_invite", "invite");
    add_action("do_setup", "add_in");
    add_action("move_setup", "remove_in");
    add_action("do_arrest", "arrest");
    set("valid_startroom", 1);
  } else
    set("valid_startroom", 0);
  checking(me);
}
int do_invite(string arg) {
  object me, ob, ob1;
  int i;
  string msg;
  me = this_player();
  //        if (previous_object() && getuid(previous_object()) != ROOT_UID) return 0;
  if (!arg) return notify_fail("你准备邀请谁？\n");
  if (!objectp(ob = LOGIN_D->find_body(arg)))
    return notify_fail("没有这个人啊？\n");
  if (ob == me)
    return notify_fail("你是在开玩笑吧？\n");
  message_vision(sprintf(HIY "\n\t$N挥手招来信使：去，邀请%s来做客。\n" NOR, ob->name()), this_player());
  //        write("你邀请"+ob->name()+"到你的房间做客。\n");
  tell_object(ob, HIG "你眼前出现一个小信使：“絮絮邀请做客”。说完递给你一个请柬。\n\n" NOR);
  ob1 = new("/d/xmvroom/obj/qingtie");
  ob1->set("invited", me->query("id"));
  msg = HIR "尊敬的" + ob->name() + "阁下：\n\n" +
    "    敬请光临舍下，不胜荣幸。此请柬使用(use)后，请交御者。\n\n" +
    "                            " + me->name() + "上\n" NOR;
  ob1->set("long", msg);
  ob1->move(ob);
  return 1;
}
void checking(object me) {
  object snooper;
  if (!me || environment(me) != this_object()) return;
  else if (userp(me) && me->query("id") != "xmv" && me->query_temp("invited") != "com" && !get_setup(me)) {
    message_vision("\n仆人大叫，陌生人！门后涌出一帮恶仆，七手八脚把$N捆起来丢了出去。\n\n", me);
    me->move("/d/fy/fysquare");
    message_vision(HIY "“轰”的一声，$N被人从天上扔了下来！\n" NOR, me);
  } else if (objectp(snooper = query_snoop(me))) {
    message_vision(HIW "\n$N突然大叫了一声：我被$n监听了。$N对准$n一脚踢了过去！\n\n" NOR, me, snooper);
    seteuid(ROOT_UID);
    //destruct(ob);
    destruct(snooper);
    seteuid(getuid());
  }
  //        else 
  call_out("checking", 10, me);
}
int valid_leave(object me, string dir) {
  if (me->query_temp("invited"))
    me->delete_temp("invited");
  return 1;
}
int move_setup(string arg) {
  object me, ob;
  int i;
  me = this_player();
  if (previous_object() && getuid(previous_object()) != ROOT_UID) return 0;
  if (!arg) return notify_fail("嘿嘿，你准备删除谁进入这里的权限？\n");
  if (!objectp(ob = LOGIN_D->find_body(arg)))
    return notify_fail("你准备删除谁进入这里的权限？\n");
  if (ob == me)
    return notify_fail("你是在开玩笑吧？\n");
  for (i = 0; i < sizeof(ids); i++)
    if (ids[i] == ob->query("id"))
      ids = ids - ({ ob->query("id") });
  write("你删除了" + ob->name() + "进入这里的权限。\n");
  return 1;
}

int do_setup(string arg) {
  object me, ob;
  int i;
  me = this_player();
  if (previous_object() && getuid(previous_object()) != ROOT_UID) return 0;
  if (!arg) return notify_fail("嘿嘿，你准备给谁进入这里的权限？\n");
  if (!objectp(ob = LOGIN_D->find_body(arg)))
    return notify_fail("你准备给谁进入这里的权限？\n");
  if (ob == me)
    return notify_fail("你是在开玩笑吧？\n");
  for (i = 0; i < sizeof(ids); i++)
    if (ids[i] == ob->query("id"))
      return notify_fail("此人已经有了进入这里的权限。\n");
  ids = ids + ({ ob->query("id") });
  write("你给予了" + ob->name() + "进入这里的权限。\n");
  return 1;
}
int get_setup(object me) {
  int i;
  for (i = 0; i < sizeof(ids); i++)
    if (ids[i] == me->query("id"))
      return 1;
  return 0;
}

int do_arrest(string arg) {
  object me, ob, ob1;
  int i;
  string msg;
  me = this_player();
  //        if (previous_object() && getuid(previous_object()) != ROOT_UID) return 0;
  if (!arg) return notify_fail("你准备邀请谁？\n");
  if (!objectp(ob = LOGIN_D->find_body(arg)))
    return notify_fail("没有这个人啊？\n");
  if (ob == me)
    return notify_fail("你是在开玩笑吧？\n");
  message_vision(sprintf(HIY "\n\t$N一招手，叫来两个家奴：去，把%s给我叫来。\n" NOR,
    ob->name()), me);
  write("你邀请" + ob->name() + "到你的房间做客。\n");
  message_vision(HIY "\n\t面前忽然现出两个家奴，对$N喝道：老爷要找你问话。不由分说，架起$N就走。\n" NOR, ob);
  ob->set_temp("invited", "xmv");
  ob->move(KETING);
  message_vision(sprintf("$N被两个家奴架了过来。\n"), ob);
  return 1;
}
int valid_enter(object me) {
  object ob;
  if (userp(me) && me->query("id") != "com" && me->query("id") != "xmv" && me->query_temp("invited") != "com" && !get_setup(me)) {
    message_vision("\n$N刚进门，忽然从门后闪出几个仆人，七手八脚的把$N捆起来，丢了出去。\n\n", me);
    //		call_out("move_him",1,me);
    me->move("/d/fy/fysquare");
    message_vision(HIY "“轰”的一声，$N被人从天上扔了下来！\n" NOR, me);
    if (objectp(ob = LOGIN_D->find_body("com")))
      message_vision(HIY "\n一个家奴匆匆忙忙跑过来，向$N说道：老爷，刚才有人擅自闯进来客厅，被我们赶出去了。\n\n" NOR, ob);
    return 1;
  }
  return 0;
}
