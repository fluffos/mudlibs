#include <ansi.h>
inherit ITEM;

void create() {
  set_name("保险柜", ({ "gui", "保险柜" }));
  set_weight(500);
  set_max_encumbrance(800000);
  set("no_get", 1);
  set("no_show", 1);
  set("closed", 1);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
    set("long", "一个结实的保险柜\n");
    set("value", 0);
  }
}

int is_container() { return 1; }
int is_closed() {
  return ((int)this_object()->query("closed"));
}
