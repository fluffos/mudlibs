inherit ROOM;
#include <ansi.h>
void create() {
  set("short", HIC "乔峰工作室" NOR);
  set("long", @LONG
这是乔峰的工作室，据说这里也是个魔法时空之门：
     [35m天机 A  沉香 B  三清 C  大理 D  关外 E  黄山 F[0m
     [33m魔教 G  万梅 H  武当 I  神水 J  常春 K  少林 L[0m
     [36m神剑 M  清风 N  嵩山 O  兴国 P  蝙蝠 Q  幽灵 R[0m
     [37m帝王 S  千金 T  月后 U  五毒 V  移花 W  桃园 Z[0m
LONG);

  set("exits", ([ /* sizeof() == 4 */
    "down": "/d/wiz/jobroom",
    "A": "/d/fy/fysquare",
    "B": "/d/chenxiang/cxcenter",
    "C": "/u/taoguan/da_dian",
    "D": "/d/dali/dalicenter",
    "E": "/u/guanwai/tower",
    "F": "/d/huangshan/diezhang",
    "G": "/d/daimiao/tongting",
    "H": "/d/wanmei/center",
    "I": "/u/wudang/zhixiao",
    "J": "/d/shenshui/gong",
    "K": "/d/tieflag/gu5",
    "L": "/d/shaolin/fang",
    "M": "/d/shenjian/xw",
    "N": "/d/lou/woshi",
    "O": "/d/songshan/shuyuan",
    "P": "/d/qianfo/tianwang",
    "Q": "/d/bat/fchuan",
    "R": "/u/ghost/house3",
    "S": "/u/palace/datang",
    "T": "/d/qianjin/jinge",
    "U": "/d/tieflag/moonding",
    "V": "/d/wudujiao/mroom",
    "W": "u/yihua/dating.lpc",
    "Z": "/d/taoyuan/teaplace",

