#include <ansi.h>
inherit ITEM;

void init() {
  add_action("do_yong", "yong");
}
void create() {
  set_name(HIR "劳动节" HIG "粮" HIM "票" NOR, ({ "piao" }));
  set_weight(1);
  set("unit", "张");
  set("long", HIY "这是天下无敌为答谢新老完家的厚爱，特意送给大家的劳动节粮票！(yong)\n" NOR);
  set("value", 1);
  set("no_drop", 1);
  set("material", "paper");
  setup();
}
int do_yong() {
  int exp, pot, score, money;
  object mon, me, ob;

  me = this_player();

  if (me->query("mofan2") == 2) {
    message_vision(HIM "你已打用过粮票了吧，想占便宜呀？\n" NOR, this_object(), me);
    return 1;
  }
  exp = 51000;
  pot = 5100;
  score = 510;
  me->add("potential", pot);
  me->add("combat_exp", exp);
  me->add("score", score);
  tell_object(me, HIY "你获得了：\n" NOR + HIG +
    exp + "  点实战经验\n" NOR + HIC +
    pot + "  点潜能\n" NOR + HIW +
    score + "  点综合评价\n" NOR);
  me->set("mofan2", 2);
  if (present("piao", me)) destruct(present("piao", me));
  return 1;
}
