// book.c

inherit ITEM;

void create()
{
	int	i;

        string *names = ({
                "「魔法天书」", "「八识神通」", "「咒术天书」","「三清天书」"
        });

        string *skills= ({
                "magic", "essencemagic", "spells","necromancy"
        });

	i = random(4);
        set_name( names[i], ({ "book" }));
        set_weight(100);
        set("unit", "本");
	set("no_transfer",1);
        set("long", "这是一本相传能通天地，灭鬼神的书籍，但是没几个人有毅力去真正读完他。\n");
        set("skill", ([
                "name":                 skills[i],
                "exp_required": 0,                
                "sen_cost":             100,     
                "difficulty":   70,            
                "max_skill":    60,           
                                            
        ]) );
}
