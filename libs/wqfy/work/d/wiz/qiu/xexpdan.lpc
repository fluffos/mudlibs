// qiu 2002-5-31
inherit F_FOOD;
inherit ITEM;
#include <ansi.h>
void create()
{
	set_name(HIR"小经验丹"NOR , ({"xexpdan" }) );
    if( clonep() )
		set_default_object(__FILE__);
	else {
  set("long","一颗可以扭转命运降低经验的灵丹,专门为新手准备的。\n");
		set("unit", "颗");
                set("value", 400000); 
	}
}

void init()
{
 add_action("eat_guo","eat");
}

int eat_guo(string arg)
{
        object me = this_player();
        int exp;
        int pot;
              if (this_player()->query("combat_exp")>1000000 ) return notify_fail("小孩子不要乱吃东西啊，这是给新手吃的!\n");
        if ( arg == "expdan"){
        exp = -50000;
        message_vision(HIM"$N偷偷地见四下无人，迫不及待地吞下一颗降经验丹。\n"NOR,this_player());
        this_player()->add("combat_exp",exp);
//      this_player()->set("score",0);
        tell_object(this_player(),HIR"你全身抽搐几乎晕死过去,突然感到口咙一热,一口鲜血喷出,你的经验降低了：\n\n" +
        chinese_number(exp) + "点实战经验。天下无敌全体巫师提醒你吃多有害健康！\n"NOR);
        command("rumor 某人迫不及待地吞下一颗降经验丹！");
        destruct(this_object());
        return 1;
     }
     return 0; 
}