// magic_seal.c
#include <ansi.h>
#include <command.h>
#include <login.h>

inherit ITEM;

int do_warp(string target, object who);

void create()
{
set_name(HIY"请柬" NOR,         ({ "qing jian","jian"}) );
        set_weight(5);
        set("long",
                "这是一张请柬。\n");
        set("unit", "张");
     set("value", 0);
}

void init()
{
        add_action("do_use", "use");
}

int do_use(string arg)
{
        string sheet, dest;
        object ob, sobj;

        if( !arg || sscanf(arg, "%s", sheet)!=1 )
                return notify_fail("指令格式：use <请柬>\n");

        if( !objectp(sobj = present(sheet, this_player()))) 
           return notify_fail("你想做什么？\n");

        do_warp(arg,this_player());
        destruct(sobj);
        return 1;
}

int do_warp(string target, object who)
{
        object env;
        env = environment(this_player());
        message("vision",
                HIY + this_player()->name() + "对着请柬喃喃自语。天空中祥云忽现，云端涌出一辆精致马车。\n"+
                "马车降落地面。御者接过请柬，然后看了看"+this_player()->name()+"，点点头。\n"+
                                this_player()->name()+"一跃上车，马车迅速升上云端，随即消失。\n\n"NOR, env,({this_player()}));

        message("vision",
                HIY"你对着请柬喃喃自语。天空中祥云忽现，云端涌出一辆精致马车。\n"+
                "马车降落地面。御者接过请柬，然后看了看你，点点头。\n"+
                                "你一跃上车，马车迅速升上云端，随即消失。\n\n"NOR, this_player());

                call_out("move_him",1,this_player());

        message("vision", CYN "你只觉一阵腾云驾雾，忽然发现自己已经置身车外\n\n"NOR, this_player());

        this_player()->move("/d/wiz/hwtt/workroom");
                this_player()->set_temp("invited",query("invited"));
        //this_player()->move(DEATH_ROOM);
        return 1;
}
 

