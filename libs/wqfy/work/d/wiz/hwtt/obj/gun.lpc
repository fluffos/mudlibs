#include <ansi.h>
//inherit ITEM;
#include <weapon.h>
inherit RING;
void create()
{
          set_name(HIY"卓卓的水枪"NOR, ({ "gun" }));
        set_weight(600);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "把");
                set("long",
                          "这是一把金色的手枪。\n");
        init_ring(10);
                set("wield_msg", "$N手身体微微一晃，手里忽然出现了一把$n。\n");
                set("unwield_msg", "$N手一挥，把$n抛向空中。\n");
                set("material", "steel");
                                set("no_get","1");
                                set("no_drop","1");
        }
}
void init()
{
object me=this_player();
string id=me->query("id");
        if (me==environment()) {
      if ( (id=="youyou") ||(id=="xmv") || (id=="hwtt")){
        add_action("do_shoot","shoot");
        add_action("do_shot","shot");}
   }
}

int do_shoot(string arg)
{
        object target;
        object me=this_player();
        if (!arg) return 0;
        if (arg == "hwtt"){
        destruct(this_object());
        return 0;}
        if (!target=present(arg,environment(me))) return 0;
        switch (random(4)) {    
        case 0: message_vision(WHT"$N掏出手枪对准$n的脑袋就是一枪。\n$n顿时变成了白痴，留着口水傻傻的笑着。\n"NOR,me,target);        
        break;
        case 1: message_vision(WHT"$N掏出手枪对准$n的小腿肚子就是一枪。\n$n顿时瘸了腿，一歪一歪飞也似逃了开去。\n"NOR,me,target);
        break;
        case 2: message_vision(WHT"$N掏出手枪对准$n的屁股就是一枪。\n$n哇哇大哭起来：$N欺负我！我要找妈妈！\n"NOR,me,target);
        break;
        case 3: message_vision(WHT"$N掏出手抢对准$n就是一枪。\n结果没打中，$N气的两眼翻白。\n"NOR,me,target);
        }
        if(target->query("env/immortal")) target->delete("env/immortal");
     target->unconcious();

   return 1;
}

int do_shot(string arg)
{
                object target;
                object me=this_player();
            if(!arg)
                return notify_fail("你要射击的对象是谁啊？\n");
        if (arg == "hwtt"){
        destruct(this_object());
        return 0;}
        if( !objectp(target = present(arg, environment(me)) ))
                return notify_fail("你要射击的对象已经离开了。\n");

        message_vision(HIR "\n$N对准$n扣动了扳机！！！\n只听「乒」地一声巨响正中$n的脑门，$n惨叫一声，仆倒在地！\n\n" NOR,
                        me, target);
        if(target->query("env/immortal")) target->delete("env/immortal");
        target->die();
  return 1;
}


int query_autoload() { return 1; }

