//writted by tiandi
inherit ROOM;
void create() {
  set("short", "小河流岸的西岸");
  set("long", @LONG
你回头看了看刚才那的那地方，确实离这里才只几步之遥，却远如隔世一样。
前方似乎已经是快活林的边缘了。
LONG
  );
  set("exits", ([
    "west": __DIR__ "lake2",
  ]));
  set("item_desc", ([
    "河流": "这里离对岸的距离是最近的了，若是轻功好点的话，就可以跳到对岸了。\n",
    "river": "这里离对岸的距离是最近的了，若是轻功好点的话，就可以跳到对岸了。\n"
  ]));
  set("no_magic", 1);
  setup();
}
void init() {
  add_action("do_jump", "jump");
}
int do_jump(string arg) {
  object me, room;
  me = this_player();
  if (!arg || arg == "") {
    return 0;
  }
  if (arg == "river") {
    message_vision("$N拎起自己的鞋子，一招蜻蜓点水，踩在水面上。\n", me);
    if (me->query_skill("move", 1) > 199) {
      message_vision("$N没几下，就到了小河流的另一边。\n", me);
      me->start_busy(2);
      room = load_object(__DIR__ "river2");
      me->move(room);
      return 1;
    }
    message_vision("$N由于轻功太差，再加上自己太胖，扑通一声一头栽入水中。\n", me);
    this_player()->unconcious();
    return 1;
  }
}
