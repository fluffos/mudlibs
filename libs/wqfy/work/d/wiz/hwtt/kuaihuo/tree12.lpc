inherit ROOM;
void create()
{
        set("short", "茂密的森林");
        set("long", @LONG
阳光，透过树叶间微弱的缝隙，刺了进来，使原本暗淡无光的绿色顿时充满了活气。
森林的气息就是这样，淡淡的，略带一阵微香，让人有种心旷神怡的感觉。它给你带来
的是生呢？抑或是死呢？

LONG
        );
        set("exits", ([ /* sizeof() == 4 */
  	"east" : __DIR__"tree2",
  	"west" : __DIR__"tree10",
  	"north" : __DIR__"tree6",
  	"south" : __DIR__"tree5",

]));
	 set("item_desc", ([
               "tree": "这棵树与众不同，它竟然比周围的几棵要高一倍之多。\n"
        ]) );
set("outdoors", "kuaihuo");
	set("no_magic",1);
	setup();
}
void init()
{
        add_action("climbing", "climb");
}

int climbing(string arg)
{
        object obj;
        object me;
	 mapping skill;
        me = this_player();
 	 skill = me->query_skills();
         if (me->query("combat_exp")> 15000000 ) 
	 {
		write("什么？\n");
		return 1;
	 }
	 if ( sizeof(skill) > 60 )
	 { 
		write("什么？\n");
 		return 1;
        }
	  if ( me->query("TASK") <800 )
	 { 
		write("什么？\n");
 		return 1;
        }
        if(!arg || arg=="")
        {
                return 0;
        }
        if( arg == "tree" || arg == "树")
        {
        message_vision("$N发觉这棵树有些异样，慢慢地顺着树杆爬了上去。\n", me);
        me->start_busy(3);
        call_out("fliping",3,me);
        return 1;
        }
        else
        {
                write("什么？\n");
                return 1;
        }
}
int fliping(object me)
{
	if(!me->is_ghost()){
        me->move(__DIR__"treetop");
        message_vision("$N努力地爬了上来，发现这里竟然有。。。\n", me);
	}
        return 1;
}


