#include <ansi.h>
inherit ROOM;
void create()
{
        set("short", HIR"幽灵血池"NOR);
        set("long", @LONG
这里正中有一个大血池（BLOODY CHI），据说是幽灵宫的练武之地。血，血红。
据说，在这里祭（JI）一下，会有特殊的法术出现。
LONG
        );
	 set("exits", ([ 
		  "east" : __DIR__"youling",
		
		]));         
	set("objects",([
        	__DIR__"obj/chi" : 1,
		
      	]) );
	setup();
}
void init()
{
	add_action("do_out","out");
	add_action("do_ji","ji");
}
int do_out()
{
	object me,room;
	me = this_player();
	room = load_object(__DIR__"andao");
	me->move(room);
	return 1;
}
int do_ji(string arg)
{
	object me,weapon,ob;
        me = this_player();
        ob = me->query_temp("weapon");
if (!ob) return notify_fail("你拿什么祭啊？\n");
 if ( me->query_skill("yaoshen",1)<100 || me->query_temp("alreadyji"))
		{
message_vision(CYN"$N若有其事地念起了咒语，骤然间，天地皆为之变色。"HIY"
没有人，没有声音，红尘中的喧哗和烦恼，似已完全被隔绝在血池外。只不过世上一些最危险，
最可怕的事，往往就是隐藏在这平静中的。\n\n\n"HIR"一道闪电打了下来，击在了$N的脑袋上！\n"NOR,me);
	me->unconcious();
	return 1;
		}
	if (!arg)
		{
message_vision(CYN"$N若有其事地念起了咒语，骤然间，天地皆为之变色。"HIY"
正在这时，$N突然“啊”的叫了一声，“天哪，忘了要打谁了。”\n\n\n"+HIR"一道闪电打了下来，击在了$N的脑袋上！\n"NOR,me);
	me->unconcious();
	return 1;
		}
	ob = find_player(arg);
	if( !ob || wizardp(ob) )
		ob = find_living(arg);
	if( me->query("mana") < 100 ||  me->query("sen") < 500 )
 	{
message_vision(CYN"$N若有其事地念起了咒语，骤然间，天地皆为之变色，但却有些异样。"YEL"
正在这时，$N突然“啊”的叫了一声，“天哪，力量不够了。”\n\n\n"+HIR"一道闪电打了下来，击在了$N的脑袋上！\n"NOR,me);
	me->unconcious();
	return 1;
		}
       if( !ob || !environment(ob)) 
		{
message_vision(CYN"$N若有其事地念起了咒语，骤然间，天地皆为之变色，但却有些异样。"YEL"
正在这时，$N突然“啊”的叫了一声，“天哪，我怎么这么倒霉。”\n\n\n"+HIR"一道闪电打了下来，击在了$N的脑袋上！\n"NOR,me);
	me->unconcious();
	return 1;
	}
	
	
message_vision(CYN"$N若有其事地念起了咒语，骤然间，天地皆为之变色。"YEL"
没有人，没有声音，红尘中的喧哗和烦恼，似已完全被隔绝在血池外。只不过世上一些最危险，
最可怕的事，往往就是隐藏在这平静中的。一道道闪电撕裂了黝黑的苍穹，变成了一片银色的光幕，
笼罩了黑暗的土地。现在本来已经应该是日出的时候了，可是在没有闪电的时候，天地间却更黑暗。\n"NOR,me);
message_vision(RED"\n霹雳一声，天空中一道雷光，像怒屈的金虹，打在了$N的头上。\n"NOR,ob);	
	me->set_temp("alreadyji",1);
	if (random(me->query("combat_exp")*3)>random(ob->query("combat_exp")) )
		{
	message_vision("冥冥中仿佛真的有种神秘的力量，在主宰着人类的命运，\n绝没有任何一个应该受惩罚的人，能逃过“它”的制裁。\n",ob);	
	ob->unconcious();
	me->start_busy(10);
 	return 1;
		}
	else 	{
	message_vision("世上有很多事，并不是一定的，所以$N避开了这一击。\n",ob);	
	me->start_busy(10);
 	return 1;
		}
message_vision(CYN"$N若有其事地念起了咒语，骤然间，天地皆为之变色，但却有些异样。"YEL"
正在这时，$N突然“啊”的叫了一声，“天哪，怎么会这样？”\n\nn"+HIR"一道闪电打了下来，击在了$N自己的脑袋上！\n"NOR,me);
	me->unconcious();
	return 1;
}

