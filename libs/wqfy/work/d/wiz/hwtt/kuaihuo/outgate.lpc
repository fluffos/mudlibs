//writted by tiandi
inherit ROOM;
void create() {
  set("short", "城门外");
  set("long", @LONG
现在你的双脚终于能着实地踏着土地了。眼前是一扇大大的城门，就像三国时代的那种。城门外
有两个守卫，就是刚才大叫的那两个，可是那一排弓箭手却不见了。你突然兴奋地跳了起来，因为你
看见了城门上的几个大字----快活城。这可是江湖上公认的武林禁地之一。
LONG
  );
  set("objects", ([
    __DIR__ "npc/guards": 2,
  ]));
  set("outdoors", "kuaihuo");
  set("no_magic", 1);
  setup();
  setup();
}
void init() {
  add_action("do_west", "west");
}
int do_west() {
  object me, room;
  me = this_player();
  if (me->query("TASK") > 800 && me->query("marks/kuaihuo")) {
    room = load_object("/d/kuaihuo/ingate");
    me->move(room);
    return 1;
  }
  message_vision("城内闪出一排弓箭手，张弓搭箭，其中一人朝你说道：出去！\n", me);
  return 1;
}
