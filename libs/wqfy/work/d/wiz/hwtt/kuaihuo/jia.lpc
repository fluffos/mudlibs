//writted by tiandi
inherit ROOM;
void create() {
  set("short", "农家");
  set("long", @LONG
这是一户快活城内的普通人家。现在灶上还生着火，但主人却不知上哪了，把个大门敞开着。
LONG
  );
  set("exits", ([
    "north": __DIR__ "street4",
  ]));
  set("item_desc", ([
    "灶台": "火势不断，火焰后面便是一堵墙。\n"
  ]));
  set("no_magic", 1);
  setup();
}
void init() {
  add_action("do_jump", "jump");
}
int do_jump(string arg) {
  object me, room;
  me = this_player();
  if (!arg || arg != "灶台")
    return 0;
  message_vision("$N看了看灶台，突然一个纵身，斜飞而起，企图跳上后面那堵墙。\n", me);
  if (me->query_skill("move", 1) > 30) {
    message_vision("$N跃在半空，突觉火焰刺眼，索性闭起双目，一下子已站在了墙上。\n", me);
    room = load_object(__DIR__ "wall");
    me->move(room);
    me->start_busy(2);
    return 1;
  } else {
    message_vision("$N跃在半空，突觉火焰刺眼，提不起一点真气，怪叫一声，向后仰翻。\n", me);
    me->unconcious();
    return 1;
  }
}
