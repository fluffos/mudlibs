// TIE@FY3 ALL RIGHTS RESERVED
inherit ROOM;
int swing(object me);
void create() {
  set("short", "轩辕峰");
  set("long", @LONG
这是黄山后山东的最高峰，因一路怪石嶙峋，加之前面采石峰异常
难行，所以很少人烟。据说这里便是黄帝得道飞升的所在，也不知真假
但是至今留有许多道家遗迹，可见确有人在此修道。南边有一矮峰，上
面居然隐约有一茅庐，似乎有人居住，两峰之间仅有一根铁索。
LONG
  );
  set("exits", ([
    "south": __DIR__ "caishi",
    "north": __DIR__ "tiesuo",
  ]));
  set("item_desc", ([
    "tiesuo": "一根只通对面山岸的铁索，你可以试着荡(swing)过去。\n"
  ]));
  set("outdoors", "huangshan");
  set("coor/x", -650);
  set("coor/y", -520);
  set("coor/z", 40);
  setup();
  //        replace_program(ROOM);
}
init() {
  add_action("do_swing", "swing");
}
int do_swing(string arg) {
  object me;
  me = this_player();
  if (!arg || arg != "tiesuo") return 0;
  message_vision("$N似乎看见远处有一闪一闪的亮光，打算抓着铁索过去看看。\n", me);
  call_out("swing", 1, me);
  return 1;
}
int swing(object me) {
  object room;
  if (me->query("cor") < 40)
    return notify_fail("你看了看山下，跺了跺脚，想想还是太危险了。\n");
  message_vision("$N抓紧铁索，猛得蹬了一下左脚，“嗖”地一声朝发光处荡去！\n");
  room = load_object("/d/kuaihuo/tiesuo");
  me->move(room);
  return 1;
}
