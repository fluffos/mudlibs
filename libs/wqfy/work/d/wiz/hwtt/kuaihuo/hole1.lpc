inherit ROOM;
void create() {
  set("short", "山洞内");
  set("long", @LONG
这里黑黑的，几乎什么都看不见，你只能凭着自己的直觉慢慢走了。
LONG
  );
  set("exits", ([
    "out": __DIR__ "hill",
  ]));
  set("objects", ([
    __DIR__ "npc/cai": 1,
  ]));
  set("no_magic", 1);
  setup();
}
void init() {
  add_action("do_west", "northwest");
}
int do_west() {
  object me, room;
  me = this_player();
  room = load_object(__DIR__ "hole2");
  me->move(room);
  return 1;
}
