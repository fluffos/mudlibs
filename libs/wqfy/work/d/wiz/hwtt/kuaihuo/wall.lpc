//writted by tiandi
inherit ROOM;
void create() {
  set("short", "农家墙上");
  set("long", @LONG
这堵墙已经给烟熏得黑呦呦的。你站在墙上，却看见屋后别有洞天，竟然有一
条小溪流。
LONG
  );
  set("exits", ([
    "down": __DIR__ "jia",
  ]));
  set("item_desc", ([
    "wall": "黑呼呼的一堵墙。\n"
  ]));
  set("no_magic", 1);
  setup();
}
void init() {
  add_action("do_jump", "jump");
}
int do_jump(string arg) {
  object me, room;
  me = this_player();
  if (!arg || arg != "out")
    return 0;
  message_vision("$N向外一跳，轻巧地落在了屋后。\n", me);
  room = load_object(__DIR__ "room");
  me->move(room);
  me->start_busy(2);
  return 1;
}
