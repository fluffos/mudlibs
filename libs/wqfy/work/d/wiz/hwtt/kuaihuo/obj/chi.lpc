//血池  by tiandi
inherit ITEM;
void create() {
  set_name("幽灵血池", ({ "bloody chi", "chi" }));
  set_max_encumbrance(80000);
  set("no_get", 1);
  set("no_drop", 1);
  set("no_shown", 1);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
    set("long", "一个用来练功的血池。 \n");

    set("skill", ([
      "name": "youling-force",
      "exp_required": 0,
      "sen_cost": 50,
      "difficulty": 20,
      "max_skill": 100
    ]));

  }
}
void init() {
  add_action("do_dive", "dive");
}
int do_dive() {
  object me, room;
  me = this_player();
  if (!me->query("m_success/幽灵宫")) {
    write("什么？\n");
    return 1;
  }
  if (me->query_skill("youling-force", 1) < 100) {
    write("你想污染环境？\n");
    return 1;
  }
  room = load_object("/d/kuaihuo/youling3");
  message_vision("$N默运幽灵神功护体，一头钻进了血池中。\n", me);
  me->move(room);
  return 1;
}
