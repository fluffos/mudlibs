//血池
inherit ITEM;
void create() {
  set_name("妖神", ({ "stone", "yaoshen" }));
  set("no_get", 1);
  set("no_drop", 1);
  set("no_shown", 1);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "块");
    set("long", "妖神之术。 \n");

    set("skill", ([
      "name": "yaoshen",
      "exp_required": 1000000,
      "sen_cost": 50,
      "difficulty": 50,
      "max_skill": 149
    ]));

  }
}
