#include <ansi.h>
#include <weapon.h>
inherit SWORD;
void create() {
  set_name("石碑", ({ "stone", "sword" }));
  set_weight(1400000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "块");
    set("long", "这是一块立在快活林外的的石碑，上面写着“快活林”，石碑后面有条条的刻纹，似乎是兵器所砍。\n");
    set("value", 0);
    set("material", "iron");
    set("wield_msg", "$N双手费劲了力气把$n拿了起来，却还跌跌撞撞地移了几步。\n");
  }
  init_sword(650);
  setup();
}
mixed hit_ob(object me, object victim, int damage_bonus) {
  int pro;
  int dam;
  dam = (int)me->query("force");
  victim->receive_damage("kee", dam / 2);
  return RED "石碑的余力未殆，震得$n口吐鲜血，摇晃不已！\n" NOR;
}
