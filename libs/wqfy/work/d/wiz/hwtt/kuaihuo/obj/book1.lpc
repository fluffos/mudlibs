//血池
inherit ITEM;
void create()
{
        set_name("幽灵剑法", ({ "stone","sword"}) );
        set("no_get", 1);
	 set("no_drop",1);
	 set("no_shown",1);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "块");
                set("long", "幽灵剑法。 \n");
       	
		set("skill", ([
			"name": 		"youling-sword",	
			"exp_required":	0,		
			"sen_cost":		50,	
			"difficulty":	30,	
			"max_skill":	150		
		]) );
  
        }
}
