//writted by tiandi
inherit ROOM;
void create() {
  set("short", "小山");
  set("long", @LONG
大约五丈多高的一座小山。深山里那种总带着几分凄凉的静寂，绝不是红尘中人能想得到的。 
LONG
  );
  set("exits", ([
    "south": __DIR__ "lake2",
    "west": __DIR__ "fang",
  ]));
  set("item_desc", ([
    "hill": "你定睛一看，原来这是座假山。\n",
    "小山": "你定睛一看，原来这是座假山。\n"
  ]));
  set("no_magic", 1);
  setup();
}
void init() {
  add_action("do_push", "push");
}
int do_push(string arg) {
  object me, room;
  me = this_player();
  if (!arg || arg == "")
    return 0;
  if (!me->query("marks/kuaihuo") || me->query("TASK") < 800) {
    write("你要推什么？\n");
    return 1;
  }
  if (arg == "hill" || arg == "小山") {
    message_vision("$N试着推了推假山，结果果然露出一个山洞。\n", me);
    room = load_object(__DIR__ "hole1");
    me->move(room);
    message_vision("$N一闪身，钻进了洞中。\n", me);
    return 1;
  }
}
