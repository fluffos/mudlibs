//writted by tiandi
inherit ROOM;
void create() {
  set("short", "山洞外");
  set("long", @LONG
这里阳光明媚，跟刚才那黑暗并且潮湿的山洞更是明显对比。前面是一片春天，
旭日刚刚从青翠远山外升起，微风中带着远山新发木叶的芬芳，露珠在阳光下闪亮
得就像是初恋情人的眼睛。 
LONG
  );
  set("exits", ([
    "west": __DIR__ "youling2",

  ]));
  set("objects", ([
    __DIR__ "npc/bai": 1,
    __DIR__ "npc/girl": 7,
  ]));
  setup();
}
void reset() {
  object *inv, ob;
  string *sname = ({ "花月", "名月", "丘月", "水月", "云月", "雨月", "松月",
    "蒲月", "斜月", "银月" });
  int i;
  ::reset();
  ob = present("bai feifei", this_object());
  inv = all_inventory();
  if (ob) {
    ob->dismiss_team();
    for (i = 0; i < sizeof(inv); i++)
      if (inv[i]->query("id") == "youling girl" && inv[i] != ob) {
        ob->add_team_member(inv[i]);
        inv[i]->set("name", sname[i]);
      }

  }
}
