//writted by tiandi
inherit ROOM;
void create()
{
        set("short", "茂密的森林");
        set("long", @LONG
阳光，透过树叶间微弱的缝隙，刺了进来，使原本暗淡无光的绿色顿时充满了活气。
森林的气息就是这样，淡淡的，略带一阵微香，让人有种心旷神怡的感觉。它给你带来
的是生呢？抑或是死呢？

LONG
        );
    	set("exits", ([ 
		  "west" : __DIR__"tree2",
		  "east" : __DIR__"tree4",
		  "north": __DIR__"tree6",
		  "south": __DIR__"tree8",
		]));         
	set("outdoors", "kuaihuo");
	set("no_magic",1);
	setup();
}
void init()
{
        add_action("do_west", "west");
}
void do_west()
{
	object me,room;
	 mapping skill;
        me = this_player();
 	 skill = me->query_skills();
        if (me->query("combat_exp")< 15000000 && sizeof(skill) < 60 && me->query("TASK") >800) 
	{
		room = load_object(__DIR__"tree12");
		me->move(room);
		return;
	 }
	room = load_object(__DIR__"tree2");
	me->move(room);
	return;
}
