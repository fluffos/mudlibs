inherit ROOM;
void close_path();
void create()
{
        set("short", "山路尽头");
        set("long", @LONG
你沿着山路漫漫地向西走着，不知不觉中已来到这里，前面有一片未开发过的森林，路走到这儿，
也就没有路了。天上，一只大雕正巧飞过，可能在森林的深处，有它的老巢吧。
LONG
        );
        set("exits", ([ 
		  
		  "eastup" : __DIR__"road3",
		]));         
       set("objects", ([       
		 __DIR__"obj/stone" : 1,	
	]) );
	set("item_desc", ([
                "tree": "这里是没有开发过的森林，所以也就没有路了。你可以试着去砍(chop)开它们。\n",
  		 "森林": "这里是没有开发过的森林，所以也就没有路了。你可以试着去砍(chop)开它们。\n"

        ]) );
	set("outdoors", "huangshan");
 	set("coor/x",-670);
	set("coor/y",-530);
	set("coor/z",0);
	set("no_magic",1);
	setup();
}
init()
{
add_action("do_chop","chop");
}
int do_chop(string arg)
{
        object ob;
        object me;
        me = this_player();
	 ob = me->query_temp("weapon");
	 if(!arg || arg=="")
        {
                write("你要砍开什么？\n");
                return 1;
        }
        if( arg == "tree" || arg == "森林" )
	{
		if( !ob ) 
			{
			write("砍你个头！\n");
			return 1;
			}
		if( ob->query("id") != "gelu")
			{
			write("砍你个头！\n");
			return 1;
			}
		if( query("exits/west") ) {
    			write("你眼睛瞎了不成？\n");
			return 1;
			}
	message_vision(sprintf("$N用手中的%s砍倒了两边的大树。\n",ob->name()),me);
	set("exits/west",__DIR__"kuaihuostart");
	call_out("close_path",1);
	return 1;
	}
               return 1;
}
void close_path()
{
        if( !query("exits/west") ) return;
        message("vision",
"突然四周扬起一层灰，把路给堵住了。\n",
                this_object() );
                delete("exits/west");
}


