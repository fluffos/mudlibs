inherit ROOM;
void create()
{
        set("short", "茂密的森林");
        set("long", @LONG
阳光，透过树叶间微弱的缝隙，刺了进来，使原本暗淡无光的绿色顿时充满了活气。
森林的气息就是这样，淡淡的，略带一阵微香，让人有种心旷神怡的感觉。它给你带来
的是生呢？抑或是死呢？

LONG
        );
        set("exits", ([ 
		  "west" : __DIR__"tree2",
		  "north": __DIR__"tree2",
		  "south": __DIR__"tree2",
		  "east" : __DIR__"kuaihuostart",
		]));         
    set("outdoors", "kuaihuo");
	set("no_magic",1);
	setup();
}
