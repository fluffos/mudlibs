inherit ROOM;
string *names=({
	__DIR__"tree6",
	__DIR__"tree7",
	__DIR__"tree8",
	__DIR__"tree5",
} );
void create()
{
        set("short", "茂密的森林");
        set("long", @LONG
阳光，透过树叶间微弱的缝隙，刺了进来，使原本暗淡无光的绿色顿时充满了活气。
森林的气息就是这样，淡淡的，略带一阵微香，让人有种心旷神怡的感觉。它给你带来
的是生呢？抑或是死呢？

LONG
        );
    set("outdoors", "kuaihuo");
	set("no_magic",1);
	setup();
}
void reset()
{
	int i;	
	::reset();
	i=random(4);
	set("exits", ([
		"north" : names[i%4],
		"south" : names[(i+1)%4],
		"east" : names[(i+2)%4],
		"west" : names[(i+3)%4],
	]));
}
