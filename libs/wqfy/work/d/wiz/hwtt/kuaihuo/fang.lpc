inherit ROOM;
void create() {
  set("short", "慈宁园");
  set("long", @LONG
园外有一棵柳树。古往今来，也不知有多少人，用过多少名词形容过“柳”。
有人说柳如丝，有人说柳如雪，不管是如丝如雪，在一般人心目中，柳总是柔的。
春夜，春雨，巴山。 
LONG
  );
  set("exits", ([
    "east": __DIR__ "hill",

  ]));

  set("objects", ([
    __DIR__ "npc/shen": 1,
    __DIR__ "npc/qi": 1,
  ]));
  set("outdoors", "kuaihuo");
  set("no_magic", 1);

  setup();

}
void reset() {
  object me, me2;
  ::reset();
  me2 = present("zhu qiqi", this_object());
  me = present("shen lang", this_object());
  if (me) me->dismiss_team();
  if (me2) me2->dismiss_team();
  if (me && me2) me->add_team_member(me2);
}
