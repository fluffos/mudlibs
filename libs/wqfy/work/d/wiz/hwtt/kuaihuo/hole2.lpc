//writted by tiandi
inherit ROOM;
void create()
{
        set("short", "山洞内");
        set("long", @LONG
这里黑黑的，几乎什么都看不见，你只能凭着自己的直觉慢慢走了。
LONG
        );
	set("no_magic",1);
	setup();
}
void init()
{
	add_action("do_west","southeast");
	add_action("do_push","push");
}
int do_west()
{
	object me,room;
	me = this_player();
	room = load_object(__DIR__"hole1");
	me->move(room);
	return 1;
}
int do_push(string arg)
{
	object me,room;
	me = this_player();
	if (!arg || arg == "" )
		return 0;
        if (!me->query("marks/kuaihuo") || me->query("TASK") < 800 )
		{
		write("你要推什么？\n");
		return 1;
		}
	if ( arg == "hill" || arg == "stone")
	{
		if (me->query("str")<50)
		{
		message_vision("$N试着推了推假山，结果山石只略微动一了动，有一丝光透了进来。\n",me);
		return 1;
		}
	message_vision("$N试着推了推假山，结果发现了出口，外面的阳光照了进来，$N快睁不开眼了。\n",me);
	room = load_object(__DIR__"youling");
	me->move(room);
	  if(!me->query("m_success/幽灵宫"))
        {
                me->set("m_success/幽灵宫",1);
                me->add("score",500);

        }

	return 1;
	}
}
