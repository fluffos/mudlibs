//writted by tiandi
inherit ROOM;
void create() {
  set("short", "天上楼");
  set("long", @LONG
楼外楼的名气在快活城内可是数一数二的，不是因为它的菜，也不是因为它的酒，而是因为它
的主人，正是快活城的色使。这里是二楼雅座，能坐在这里的都是些大客人。靠墙的这边，挂着
一副很大的山水画。
LONG
  );
  set("exits", ([
    "down": __DIR__ "lou",
  ]));
  set("objects", ([
    __DIR__ "npc/wang": 1,
    __DIR__ "npc/jiu": 1,

  ]));
  set("no_magic", 1);
  setup();
}
void init() {
  add_action("do_open", "open");
}
int do_open(string arg) {
  object me, room;
  me = this_player();
  if (!arg || arg != "picture")
    return 0;
  room = load_object(__DIR__ "lou3");
  message_vision("$N拉开了墙上的画，露出了一扇暗门，走了进去。\n", me);
  me->move(room);
  return 1;
}
