inherit ROOM;
void create() {
  set("short", "欢喜殿");
  set("long", @LONG
这里是快活城的中央宫殿，是快活王平时处理要务的地点，龙柱黄颜，落云九露，
虽不如皇宫之宏伟壮观，但也能使人叹为观止了。中间一个牌匾，上刻：欢喜。
LONG
  );
  set("exits", ([
    "west": __DIR__ "nei",
    "eastdown": __DIR__ "jie",
  ]));
  set("objects", ([
    __DIR__ "npc/guards": 1,
  ]));
  set("no_magic", 1);
  setup();
}
