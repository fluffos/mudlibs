// 白飞飞 writted by tiandi
inherit NPC;
#include <ansi.h>
void create()
{
        set_name("白飞飞", ({ "bai feifei"}) );
        set("nickname", HIC"柔弱女子"NOR);
        set("gender", "女性" );
        set("age", 19);
        set("agi",30);
        set("str", 40);
        set("per", 20);
	 set("cor",20);
        set("int",10);
        set("attitude","friendly");
        set("max_force", 1000000);
        set("force", 1000000);
        set("force_factor", 100);
        set("max_mana", 1000000);
        set("mana", 1000000);
        set("max_atman", 10000);
	  set("marks/kuaihuo",1);
	  set("TASK",5000);
        set("atman", 10000);
        set("long",
"一个弱女子，楚楚可怜，看了也让人心疼。\n"
           );
	 set("inquiry", ([
	 "here": "我，我也不知道这是哪儿。\n",
  ]) );
	 
	set("combat_exp", 15000000);
        set_skill("dodge", 150);
        set_skill("move",100);
        set_skill("force", 150);
        set_skill("youling-sword", 150);
        set_skill("unarmed",50);
        set_skill("parry", 150);
	 set_skill("sword",150);
        set_skill("youling-force", 150);
        map_skill("force", "youling-force");
        map_skill("parry","youling-sword");
	 map_skill("sword","youling-sword");
	 set_skill("spells",150);
	 set_skill("yaoshen",150);
	 map_skill("spells","yaoshen");
        set("chat_chance_combat", 99);
        set("chat_msg_combat", ({
		    (: perform_action, "sword.jiujiuguitian" :),
     		   	(: cast_spell, "yuhuofenxin" :),

  	 }) );
	setup();
	carry_object(__DIR__"obj/sword")->wield();
      
}
void init()
{	
	add_action("do_look","look");
}
int do_look(string arg)
{
if (arg == "bai feifei" )
	{
write("一个弱女子，身穿白衣，低着头，却不敢抬头望你，楚楚可怜，看了也让你心疼。\n");
write("她看起来约十多岁。\n她长发如云，肌肤胜雪，不知倾倒了多少英雄豪杰。\n武功看起来好象"BLU"普普通通"NOR"，出手似乎极轻。\n");
write("她精神饱满，正处于巅峰状态。\n");
return 1;
	}
}
