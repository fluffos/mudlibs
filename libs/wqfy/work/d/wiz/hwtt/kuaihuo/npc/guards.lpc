// ken 1999.12.11
inherit NPC;
void create() {
  string *order = ({ "少年", "青年", "中年" });
  set_name((order[random(3)]) + "弟子", ({ "guards" }));
  set("gender", "男性");
  set("title", "快活城");
  set("age", 22);
  set("long", "这是快活城的侍卫，在这里，到处都有这样的人。\n");
  set("combat_exp", 300000 + random(100000));
  set("attitude", "friendly");
  set("chat_chance", 3);
  set("chat_msg", ({
    "快活城弟子向你喝道；站住！你是哪来的？\n",
    (: random_move :),
  }));

  setup();
  carry_object(__DIR__ "obj/sword")->wield();
  carry_object(__DIR__ "obj/cloth")->wear();

}
