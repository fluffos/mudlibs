inherit NPC;
#include "/d/kuaihuo/npc/master.h"
#include <ansi.h>
int wieldstaff();
int answer_inquiry();
void create() {
  set_name(HIC "快活王" NOR, ({ "master king" }));
  set("nickname", HIY "快" HIM "活" NOR);
  set("title", "快活城城主");
  set("gender", "男性");
  set("age", 60);
  set("agi", 100);
  set("str", 120);
  set("per", 40);
  set("cor", 90);
  set("int", 30);
  set("attitude", "friendly");
  set("max_force", 500000);
  set("force", 500000);
  set("force_factor", 200);
  set("max_mana", 500000);
  set("mana", 500000);
  set("max_atman", 500000);
  set("marks/kuaihuo", 1);
  set("TASK", 5000);
  set("atman", 500000);
  set("long",
    "暗淡的灯光下，只见此人浓眉倒垂，目光如炬，又眉中一道刀疤，更平添了他几分煞气。
此刻他那只女子般的美手，正在捋动着颔下的长髯，那双光彩流动的眼睛，那竞是双碧绿
的眼睛。\n"
  );
  set("chat_chance", 1);
  set("chat_msg", ({
    "快活王今天不知道是遇上什么事了，竟然一反常态，笑个不停。\n",
    "快活王嘿嘿地笑道：明日就是我的大婚之日了，倒时看沈浪还能如何？\n",
    "快活王长叹道：“我这一身武学，究竟到了何种地步，连我自己都不知道。”\n",
  }));
  create_family("快活城", 1, "城主");
  set("chat_chance_combat", 99);
  set("chat_msg_combat", ({
    (: perform_action, "dodge.long" :),
    (: exert_function, "five" :),
    (: wieldstaff :),
  }));
  set("inquiry", ([
    "快活城": "这里就是老夫的快活城，你看如何？\n",
    "出师": (: answer_inquiry :),
  ]));
  set("combat_exp", 50000000);
  set_skill("dodge", 150);
  set_skill("move", 100);
  set_skill("force", 150);
  set_skill("staff", 250);
  set_skill("chaotian-stick", 150);
  set_skill("long-steps", 150);
  set_skill("literate", 150);
  set_skill("unarmed", 150);
  set_skill("parry", 150);
  set_skill("wuxing-force", 150);
  set_skill("sushi-zhi", 140);
  map_skill("force", "wuxing-force");
  map_skill("move", "long-steps");
  map_skill("dodge", "long-steps");
  map_skill("unarmed", "sushi-zhi");
  map_skill("parry", "chaotian-stick");
  map_skill("staff", "chaotian-stick");
  setup();
  carry_object(__DIR__ "obj/mcloth")->wear();
  carry_object(__DIR__ "obj/mstaff");

}
int answer_inquiry() {
  object ob, room;
  ob = this_player();
  if (ob->query("class") == "kuaihuo") {
    say("快活王怒道：你考虑清楚了没有？(accept yes)\n");
    return 1;
  }
}
int wieldstaff() {
  command("wield staff");
  perform_action("staff.jingleiyiji");
  command("unwield staff");
  return 1;
}
void init() {
  add_action("do_look", "look");
  add_action("do_accept", "accept");
}
int do_accept(string arg) {
  object ob;
  ob = this_player();
  if (arg != "yes")
    return 0;
  if (ob->query("class") == "kuaihuo") {
    message_vision("快活王怒道：快滚，趁老夫现在心情好，还不快滚，难道非要老夫动手宰了你不成？\n", ob);
    ob->set("title", ob->query("oldtitle"));
    ob->set("family/enter_time", ob->query("oldenter"));
    ob->set("family/master_name", ob->query("oldmaster_name"));
    ob->set("family/master_id", ob->query("oldmaster_id"));
    ob->set("family/generation", ob->query("oldgeneration"));
    ob->set("family/family_name", ob->query("oldfamily_name"));
    ob->set("family/privs", ob->query("oldprivs"));
    ob->set("class", ob->query("oldclass"));
    ob->add("betrayer", -1);
    ob->delete("oldtitle");
    ob->delete("oldenter");
    ob->delete("oldmaster_name");
    ob->delete("oldmaster_id");
    ob->delete("oldfamily_name");
    ob->delete("oldprivs");
    ob->delete("oldclass");
    ob->save();
    return 1;
  }
  return 1;
}

int do_look(string arg) {
  if (arg == "master king") {
    write("暗淡的灯光下，只见此人浓眉倒垂，目光如炬，又眉中一道刀疤，更平添了他几分煞气。\n");
    write("此刻他那只女子般的美手，正在捋动着颔下的长髯，那双光彩流动的眼睛，那竞是双碧绿。\n");
    write("的眼睛。\n");
    write("他看起来约六十多岁。\n他相貌出众,百里挑一。\n武功看起来好象" HIR "与世无争" NOR "，出手似乎极轻。\n");
    write("他精神饱满，正处于巅峰状态。\n");
    write("他身上带著：\n");
    write("  √" HIB "花袍" NOR "(Hua pao)\n");
    return 1;
  }
}
void attempt_apprentice(object me) {
  if (me->query("marks/appking") && me->query("class") != "kuaihuo") {
    command("say 你这叛徒，活腻了不成？");
    kill_ob(me);
    return;
  }
  if (me->query("marks/appwang")) {
    command("say 你已经拜了王怜花了，还来戏弄老夫？");
    kill_ob(me);
    return;
  }
  if (!me->query("m_success/快活城")) {
    object room;
    command("say 快活城你也敢乱闯？");
    command("say 给我滚！\n");
    message_vision("$N一棍把$n打了昏了过去。\n", this_object(), me);
    me->unconcious();
    room = load_object("/d/huangshan/caishi");
    if (room) me->move(room);
    message_vision("$N被人从山上扔了下来，重重的摔在地下！\n", me);
  } else if (!me->query_temp("readyforking")) {
    command("hmm");
    command("say 不错，能活着走进快活城的倒也没几个。你若能找到金无望那个叛贼的下落，老夫变破例收你。");
  } else {
    command("say 好吧，看你花了那么多心思，老夫今天就破例收下了你。");
    command("chat 今天老夫破例收下了" + me->query("name") + "，从此" + me->query("name") + "就是我们快活城的人了。");
    command("recruit " + me->query("id"));
    me->set("marks/appking", 1);
  }
  return;
}

void recruit_apprentice(object ob) {
  ob->set("oldclass", ob->query("class"));

  ob->set("OLDTASK", ob->query("TASK"));
  ob->set("oldtitle", ob->query("title"));
  ob->set("oldenter", ob->query("family/enter_time"));
  ob->set("oldmaster_name", ob->query("family/master_name"));
  ob->set("oldmaster_id", ob->query("family/master_id"));
  ob->set("oldgeneration", ob->query("family/generation"));
  ob->set("oldfamily_name", ob->query("family/family_name"));
  ob->set("oldprivs", ob->query("family/privs"));
  if (::recruit_apprentice(ob))
    ob->set("class", "kuaihuo");
}

void re_rank(object student) {
  int exp;
  exp = (int)student->query("combat_exp");
  if (exp <= 32000) {
    student->set("title", "快活城弟子");
    return;
  } else if (exp <= 64000) {
    student->set("title", "快活城财使使者");
    return;
  } else if (exp <= 128000) {
    student->set("title", "快活城色使使者");
    return;
  } else if (exp <= 512000) {
    student->set("title", "快活城气使使者");
    return;
  } else if (exp <= 1024000) {
    student->set("title", "快活城酒使使者");
    return;
  } else if (exp <= 2048000) {
    student->set("title", "快活城四方巡使");
    return;
  } else if (exp <= 4096000) {
    student->set("title", "快活城总巡使");
    return;
  } else if (exp <= 8192000) {
    student->set("title", "快活城五行侍卫");
    return;
  } else if (exp <= 14000000) {
    student->set("title", "快活城战神");
    return;
  } else student->set("title", "快活城???");
  return;
}


int accept_fight(object me) {
  command("say 好，阁下胆识倒是过人，不知武功如何？\n");
  return 1;
}
void win_enemy(object loser) {
  command("puke");
}
void lose_enemy(object winner) {
  command("say 五十年来，你还是第一个能在武功上赢我的人。\n");
  winner->set_temp("won_king", 1);  //暂定义
}
