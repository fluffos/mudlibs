inherit NPC;
#include <ansi.h>
void create() {
  set_name("月", ({ "youling girl" }));
  set("nickname", YEL "幽灵宫女" NOR);
  set("gender", "女性");
  set("age", 19);
  set("agi", 30);
  set("str", 40);
  set("per", 20);
  set("cor", 20);
  set("int", 10);
  set("attitude", "friendly");
  set("max_force", 1000);
  set("force", 1000);
  set("force_factor", 10);
  set("max_mana", 1000);
  set("mana", 1000);
  set("max_atman", 1000);
  set("marks/kuaihuo", 1);
  set("TASK", 5000);
  set("atman", 1000);
  set("long",
    "一个幽灵宫的宫女\n"
  );

  set("combat_exp", 500000);
  set_skill("dodge", 100);
  set_skill("move", 100);
  set_skill("force", 100);
  set_skill("youling-sword", 100);
  set_skill("unarmed", 50);
  set_skill("parry", 10);
  set_skill("sword", 50);
  set_skill("youling-force", 50);
  map_skill("force", "youling-force");
  map_skill("parry", "youling-sword");
  map_skill("sword", "youling-sword");
  setup();
  carry_object(__DIR__ "obj/sword")->wield();

}
