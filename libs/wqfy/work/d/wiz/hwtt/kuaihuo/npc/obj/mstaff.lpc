#include <ansi.h>
#include <weapon.h>
inherit STAFF;

void create() 
{ 
	set_name(HIW"虎鸣齐瑶"NOR, ({"staff"}));
	set("long", @LONG
一根长约六尺的精致钢棍，暂且看不出是用何种物质所打造，不过却被武林视为“武林第一棍”。
LONG
	);
		set_weight(350000);
	if( clonep() )
	set_default_object(__FILE__);
	else {
	set("value", 0);
	set("material", "crimson gold");
	set("id", "staff");
	set("unit", "根");
	set("wield_msg", "只听$N道：“棍来！”$N身后几名弟子拿出一根$n。$N顺手就接了过来“呼”地舞了个花满天。\n");
	set("unwield_msg", "$N道：“收棍！”$N身后又出现了几名弟子，匆匆地把$n拿了下去。\n");
	}
	init_staff(400);
	setup();
}
