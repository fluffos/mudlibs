// 韩伶 writted by tiandi
inherit NPC;
#include <ansi.h>
void create() {
  set_name("韩伶", ({ "han ling", "jiushi" }));
  set("nickname", HIC "酒使" NOR);
  set("gender", "男性");
  set("age", 25);
  set("agi", 30);
  set("str", 40);
  set("per", 20);
  set("cor", 20);
  set("int", 10);
  set("attitude", "friendly");
  set("max_force", 50000);
  set("force", 50000);
  set("force_factor", 100);
  set("max_mana", 10000);
  set("mana", 10000);
  set("max_atman", 10000);
  set("marks/kuaihuo", 1);
  set("TASK", 5000);
  set("atman", 10000);
  set("long",
    "一个落拓的小老头，双目炯炯有神，可惜一双腿却断了，如今他只能
坐在桌边，喝着闷酒。\n"
  );
  set("inquiry", ([
    "快活城": "这里就是快活城了。\n",
    "韩伶": "韩伶就是我，怎么着？\n",
  ]));
  set("chat_chance", 1);
  set("chat_msg", ({
    "韩伶叹道：风雪漫中州，江湖无故人，且饮一杯酒，天涯……咳……咳咳……天涯洒泪行\n",
  }));
  set("combat_exp", 2000000);
  set_skill("dodge", 150);
  set_skill("move", 100);
  set_skill("force", 150);
  set_skill("unarmed", 50);
  set_skill("parry", 150);

  setup();
}
