
inherit NPC;
inherit F_VENDOR;
#include <ansi.h>
void create()
{
	set_name("诸葛十三", ({ "zhuge" }) );
	set("gender", "男性" );
	set("age", 31);
	set("title", HIG "狂风剑" NOR);
	set("long",
		"没有人知道他的来历．\n");
	set("combat_exp", 500000);
	set("attitude", "friendly");
	set("per",30);
	set("vendor_goods", ([
               "/obj/weapon/whip":20,
               "/obj/weapon/longsword":20,
               "/obj/weapon/dart":10,
               "/obj/weapon/shield":10,
               "/obj/weapon/eighthammer":10,
               "/obj/weapon/thin_sword":10,
               "/obj/weapon/dagger.lpc":10,
               "/obj/weapon/blade.lpc":10,
		"/obj/weapon/staff.lpc":10,
             	]) );
	set_skill("sword",50);
	set_skill("six-chaos-sword",50);
	set_skill("pyrobat-steps",50);
	set_skill("dodge",50);
	set_skill("parry",50);
	map_skill("dodge","pyrobat-steps");
	map_skill("parry", "six-chaos-sword");
	map_skill("sword","six-chaos-sword");
	setup();
	carry_object("/obj/longsword")->wield();
}
void init()
{
        add_action("do_vendor_list", "list");
}

