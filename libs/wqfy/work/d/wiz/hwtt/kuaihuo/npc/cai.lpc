// 金不换 writted by tiandi
inherit NPC;
#include <ansi.h>
void create() {
  set_name("金无望", ({ "jin wuwang", "caishi" }));
  set("nickname", HIY "财使" NOR);
  set("gender", "男性");
  set("age", 45);
  set("agi", 30);
  set("str", 10);
  set("per", 10);
  set("cor", 6);
  set("int", 10);
  set("attitude", "friendly");
  set("max_force", 3000);
  set("force", 3000);
  set("force_factor", 30);
  set("max_mana", 3000);
  set("mana", 3000);
  set("max_atman", 3000);
  set("marks/kuaihuo", 1);
  set("TASK", 5000);
  set("atman", 3000);
  set("long",
    "此人身着一身灰衣，胸口挂了一枚铜钱，上刻“财”字，快活城财使便是他了。\n"
  );
  set("chat_chance", 1);
  set("chat_msg", ({
    "金无望喃喃道：冷月照孤冢，死神夜引弓，燃灯寻白羽，化入碧血中。\n",

  }));
  set("inquiry", ([
    "财": "跟我谈财？\n",
    "沈浪": "我金无望欠此人的真是太多了，今生恐怕是无以回报了。。。\n",
  ]));
  set("combat_exp", 1000000);
  set_skill("dodge", 50);
  set_skill("move", 100);
  set_skill("force", 150);
  set_skill("unarmed", 50);
  set_skill("parry", 150);

  setup();
}
void init() {
  object ob;

  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
  add_action("do_accept", "accept");
}

void greeting(object ob) {
  if (!ob || environment(ob) != environment()) return;
  say("金无望面无表情地问你道：“你是不是快活王派来的？”（accept yes/no)\n");

}
int do_accept(string arg) {
  object me;
  me = this_player();
  if (arg == "yes") {
    say("金无望怒道：好，那老贼至今还不肯放过我，有本事你就杀了我，提我的头回去。\n");
    me->add_temp("readyforking", 1);
    kill_ob(me);
    return 1;
  }
  if (arg == "no") {
    say("金无望道：王怜花那小子，狡猾得很，不过我却没有杀他，也算是他欠我一个人情吧。\n");
    me->add_temp("readyforwang", 1);
    return 1;
  }
  return 1;
}
