#include <ansi.h>
inherit NPC;

void create() {
  set_name(HIY "金翅迦逻" NOR, ({ "bird" }));
  set("race", "野兽");
  set("gender", "雄性");
  set("age", 20);
  set("long", "这是一只大鸟，翅膀呈金黄色，是世间少有的品种。\n");

  set("str", 668);
  set("cor", 52);
  set("cps", 22);

  set("max_kee", 600000);
  set("max_gin", 600000);
  set("max_sen", 600000);
  set("attitude", "peaceful");
  set("limbs", ({ "头部", "身体", "左脚", "右脚", "尾巴" }));
  set("verbs", ({ "bite", "claw" }));
  set("chat_chance", 1);
  set("chat_msg", ({
    "大鸟“嗷～～”地鸣叫了几声\n",
  }));
  set("combat_exp", 10000000);
  set_temp("apply/attack", 100);
  set_temp("apply/armor", 1020);
  set_temp("apply/damage", 200);
  setup();
}
void init() {
  add_action("do_put", "put");
}
int do_put() {
  object *inv, me;
  int i, j;
  string objid;

  me = this_player();
  inv = all_inventory(me);
  for (i = 0; i < sizeof(inv); i++) {
    objid = (string)inv[i]->query("id");
    if (objid == "big egg") {
      j = 1;
      destruct(inv[i]);
    }
  }
  if (j != 1) {
    message_vision("$N在身上乱摸，好象在找什么东西。\n", me);
    return 1;
  }
  message_vision("$N从怀里拿出一个鸟蛋，放在鸟巢里空出来的位置上．\n", me);
  call_out("check", 2, me);
  return 1;
}
void check(object me) {
  mapping skill;
  skill = me->query_skills();
  if (me->query("combat_exp") > 10000000)
    return;
  if (sizeof(skill) > 60)
    return;
  message_vision(this_object()->query("name") + "挥舞着翅膀，发出“呼呼”的声音。突然它朝$N飞了过来！\n", me);
  call_out("fly1", 2, me);
  return;
}
void fly1(object me) {
  object ob, obb, room;
  ob = this_object();
  if (obb = present("bird", environment(me))) {
    message_vision("$N促不及防，被$n抓了起来。\n$n挥动的翅膀，竟然抓着你飞了起来！\n", me, ob);
    room = load_object("/d/kuaihuo/sky1");
    ob->move(room);
    me->move(room);
    call_out("fly2", 5, me);
    return;
  }
  return;
}
void fly2(object me) {
  object *inv;
  int i;
  string objname;
  object ob, obb, room;
  ob = this_object();
  if (obb = present(me->query("id"), environment(ob))) {
    inv = all_inventory(me);
    room = load_object("/d/kuaihuo/tree2");
    for (i = 0; i < sizeof(inv); i++) {
      if (!inv[i]->query("owner"))
        inv[i]->move(room);
      tell_object(room, "天空中突然掉下一个物体，正好打在你的头上，顿时你头上起了一个大包。\n");
    }
    message_vision("$N一慌张，身上的东西全掉了下去！\n", me);
    room = load_object("/d/kuaihuo/sky2");
    ob->move(room);
    me->move(room);
    call_out("fly3", 5, me);
    return;
  }
  return;
}
void fly3(object me) {
  object ob, obb, room;
  ob = this_object();
  if (obb = present(me->query("id"), environment(ob))) {
    message_vision("$N继续朝西南方飞去！\n", ob);
    room = load_object("/d/kuaihuo/sky3");
    ob->move(room);
    me->move(room);
    call_out("flying", 5, 0, me);
    return;
  }
  return;
}
void flying(int counter, object me) {
  object room;
  me = this_player();
  switch (counter) {
    case 0:
      message_vision("大鸟不停地扇动着翅膀，朝目的地飞去。\n", this_object());
      break;
    case 1:
      message_vision("茫茫的绿色在你眼底下闪过。。。\n", this_object());
      break;
    case 2:
      message_vision("远方好象已经没有了绿色，看上去有些什么东西，不过太远了，实在是看不清。。。\n", this_object());
      break;
    case 3:
      message_vision("终于看清楚了，在森林的彼端，竟然有许多建筑。\n", this_object());
      break;
    case 4:
      message_vision("这下更近了，不但有建筑，而且还有人耶，显然这里有人常住。建筑的门口还有两个侍卫。\n", this_object());
      break;
    case 5:
      message_vision(
        "侍卫抬头望了望，突然看见了大鸟：“有怪物！把它射下来！”\n突然门口出现了很多弓箭手，朝你所在的方向乱射一气，你正在庆幸没有被射伤时，\n却发现那只大鸟胸部已着实地中了一箭，虽未末羽，却入骨六分之多。\n
大鸟怪叫一声，忽然松开双爪，翻飞而去，你趁势落了下来。\n",
        this_object()
      );
      if (!me->query("marks/kuaihuo"))
        me->set("marks/kuaihuo", 1);
      if (!me->query("m_success/快活城"))
        me->set("m_success/快活城", 1);
      room = load_object("/d/kuaihuo/outgate");
      me->move(room);
      destruct(this_object());
      return;
  }
  call_out("flying", 5, counter + 1);

  return;
}
