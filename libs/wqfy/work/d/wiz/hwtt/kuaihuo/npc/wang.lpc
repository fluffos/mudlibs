inherit NPC;
#include <ansi.h>
int answer_inquiry();
void create()
{
        set_name("王怜花", ({ "wang lian hua","wang"}) );
        set("title","鬼才");
        set("gender", "男性" );
        set("age", 30);
        set("agi",50);
        set("str", 50);
        set("per", 40);
	  set("cor",50);
        set("int",30);
        set("attitude","friendly");
        set("max_force", 60000);
        set("force", 60000);
        set("force_factor", 200);
        set("max_mana", 60000);
        set("mana", 60000);
        set("max_atman", 60000);
	  set("marks/kuaihuo",1);
	  set("TASK",5000);
        set("atman", 60000);
        set("long",
"瞧这人年龄，最多也不过三十一二，但气派却都不小，神情也都居做已极。长身玉立，气度从容，
双眉斜飞人鬓，目光奕奕有神，一双手掌，更是白如莹玉。他就是江湖第一鬼才王怜花。\n"
        );
        set("chat_chance", 1);
        set("chat_msg", ({
                "王怜花踱步而行，似乎又在想什么鬼主意了。\n",
                "王怜花突然大笑起来：“妙！妙！妙啊！只有我王怜花才能想得出如此秒计。”\n",
                "王怜花跺了跺脚，狠狠地道：“沈浪，我要让你知道得罪我的后果，七七一定是我的。\n",
        }) );
        set("inquiry", ([
                "学艺": (: answer_inquiry :),
        ]) );
	 create_family("鬼才", 1, "才子");
	 set("combat_exp", 9000000);
        setup();
       carry_object(__DIR__"obj/cloth")->wear();
}
void attempt_apprentice(object me)
{   
  object ob;
  ob = this_object();
  if ( me->query("marks/appwang") && me->query("class")!="guicai")
   {
   command("say 你耍我？");
   return;
   }
    if ( me->query("marks/appking"))
   {
   command("say 你已经拜了快活王了，还用来拜我？");
   return;
   }
   if(!me->query("m_success/快活城"))
   {
     command("say 咦？你胆子倒是不小啊，感来此地，我劝你还是在快活王没发现之前赶快离开吧。");
    }
   else  if( !me->query_temp("readyforwang"))
    { 
    command("heihei");
    command("say 哪有那么容易啊，要是能找到金无望的话。。。");
    }
   else  

    {
    command("say 孺子可教也，做我门徒正合适。");
    command("rumor " + me->query("name") + "拜了王怜花为师。");
    command("recruit " + me->query("id") );
    me->set("marks/appwang",1);
    remove_call_out("do_copy");
    ob->set_temp("teachforid",me->query("id"));
    ob->set_temp("teachforname",me->query("name"));
    me->set("marks/wang_time",time());
    call_out("do_copy", 1, me, this_object());
    }
            return;
}
int do_copy(object me, object ob)
{
	mapping skill_status, map_status;
	string *sname, *mname;
	int i,level;
	
	if ( mapp(skill_status = me->query_skills()) ) {
		skill_status = me->query_skills();
		sname  = keys(skill_status);

		for(i=0; i<sizeof(skill_status); i++) {
			ob->delete_skill(sname[i]);
		}
	}

	if ( mapp(skill_status = me->query_skills()) ) {
		skill_status = me->query_skills();
		sname  = keys(skill_status);

		for(i=0; i<sizeof(skill_status); i++) {
			level = skill_status[sname[i]];
			if (level > 210 ) level = 210;
			ob->set_skill(sname[i], level+10);
		}
	}
	
	if ( mapp(map_status = me->query_skill_map()) ) {
		mname  = keys(map_status);

		for(i=0; i<sizeof(map_status); i++) {
			ob->map_skill(mname[i]);
		}
	}
	if ( mapp(map_status = me->query_skill_map()) ) {
		mname  = keys(map_status);

		for(i=0; i<sizeof(map_status); i++) {
			ob->map_skill(mname[i], map_status[mname[i]]);
		}
	}
	ob->set("combat_exp",me->query("combat_exp"));
	return 1;
}
int prevent_learn(object ob)
{
  if( this_object()->query_temp("teachforid") != ob->query("id"))
{
  	{
    	if ( !this_object()->query_temp("teachforid") )  return 0;
  	  say("王怜花说道：我现在正忙着教"+this_object()->query_temp("teachforname")+"，你难道没看见吗？\n");
       return 1;
 	 }
}
 else	 if((time()-this_player()->query("marks/wang_time"))>900)  
 	  {    
   	 say("王怜花说道：你想把我累死不成？过两个时辰再来吧！\n");
       return 1;
  	 }
 return 0;
}

void recruit_apprentice(object ob)
{
        if( ::recruit_apprentice(ob) )
                ob->set("class", "guicai");
}

void re_rank(object student)
{
       student->set("title","鬼才");
		    return ;
}


int accept_fight(object me)
{
        command("say 阁下是在开玩笑吧？\n");
        return 0;
}
int answer_inquiry()
{
	object ob,me;
	me = this_player();
	ob = this_object();
  if( this_object()->query_temp("teachforid") == me->query("id")
	 &&   (time()-me->query("marks/wang_time"))<7200)
  {
    say("王怜花说道：你想把我累死不成？过两个时辰再来吧！\n");
    return 1;
  }
  else if ( me->query("class") != "guicai")  
   {    
    say("王怜花说道：你是谁啊？\n");
    return 1;
   }
  else  
    {
    ob->set_temp("teachforid",me->query("id"));
    ob->set_temp("teachforname",me->query("name"));
    say("王怜花说道：好吧，先教你吧？学会之后可要帮师傅对付沈浪。\n");
    me->set("marks/wang_time",time());
    call_out("do_copy", 1, me, this_object());
    }
return 1;
}
