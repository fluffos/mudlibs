// cloth.c
//

#include <armor.h>
#include <ansi.h>

inherit CLOTH;

void create() {
  set_name(HIB "花袍" NOR, ({ "hua pao", "cloth" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("long", "这是一件衣服，表面看上去比较花，适合年轻人穿在身上，衣服背面有“快活”两个大字。\n");
    set("value", 100000);
    set("material", "cloth");
    set("armor_prop/armor", 100);
  }
  setup();
}
