inherit NPC;
#include <ansi.h>
void create() {
  set_name("独孤伤", ({ "dugu shang", "qishi" }));
  set("nickname", HIG "气使" NOR);
  set("gender", "男性");
  set("age", 25);
  set("agi", 30);
  set("str", 100);
  set("per", 10);
  set("cor", 106);
  set("int", 10);
  set("attitude", "friendly");
  set("max_force", 20000);
  set("force", 20000);
  set("force_factor", 130);
  set("max_mana", 20000);
  set("mana", 20000);
  set("max_atman", 20000);
  set("marks/kuaihuo", 1);
  set("TASK", 5000);
  set("atman", 20000);
  set("long",
    "他这冰冷的目光中，没有狠毒，没有愤怒，只是空的冰冷，
你从未见到过任何人的目光像他这样绝对的没有感情。 \n"
  );
  set("inquiry", ([
    "快活城": "你最好别在这里闹事，否则的话，我出手可不留情。\n",
  ]));
  set("combat_exp", 9000000);
  set_skill("dodge", 150);
  set_skill("move", 100);
  set_skill("force", 150);
  set_skill("unarmed", 250);
  set_skill("parry", 150);

  setup();
}
