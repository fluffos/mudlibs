// 沈浪 writted by tiandi
#include <combat.h>
//#include "/d/kuaihuo/npc/master.h"
inherit NPC;
#include <ansi.h>
int answer_inquiry();
void create() {
  set_name("沈浪", ({ "shen lang", "shen" }));
  set("nickname", HIC "天涯浪子" NOR);
  set("gender", "男性");
  set("age", 25);
  set("agi", 30);
  set("str", 60);
  set("per", 40);
  set("cor", 20);
  set("int", 30);
  set("attitude", "friendly");
  set("max_force", 250000);
  set("force", 250000);
  set("force_factor", 200);
  set("max_mana", 70000);
  set("mana", 70000);
  set("max_atman", 70000);
  set("marks/kuaihuo", 1);
  set("TASK", 5000);
  set("atman", 70000);
  set("long",
    "他身穿敝裘，头戴风帽，脚步懒散而缓慢，似是毫无力气。他看来落拓而潦倒，
懒洋洋地伸手将貂帽向上一推，这才露出了面目，却是个剑眉星目的英俊少年，
嘴角微微向上，不笑时也带着三分笑意，神情虽然懒散，但那种对什么事都满不
在乎的味道，却说不出的令人喜欢，只有他腰下斜佩的那把刀，才令人微觉害怕，
但那刀鞘亦是破旧不堪，又令人觉得刀虽是杀人凶器，只是佩在他身上，便没有
什么可害怕的。\n"
  );
  set("chat_chance_combat", 99);
  set("chat_msg_combat", ({
    (: perform_action, "blade.tianyaliuxing" :),
    (: perform_action, "blade.onheart" :),
  }));
  set("chat_chance", 1);
  set("chat_msg", ({
    "沈浪说道：今天不知道会发生什么事，快活王可不好对付啊。\n",
    "沈浪说道：熊猫儿，王怜花，再加上我，似乎还不是快活王的对手。\n",
  }));
  set("inquiry", ([
    "快活城": "这里和外面不同，正常的东西在这里也会变得不正常了。\n",
    "出城": (: answer_inquiry :),
  ]));
  set("combat_exp", 20000000);
  set_skill("dodge", 150);
  set_skill("move", 100);
  set_skill("force", 150);
  set_skill("tianya-blade", 150);
  set_skill("unarmed", 50);
  set_skill("parry", 150);
  set_skill("blade", 150);
  set_skill("moshen-force", 150);
  map_skill("force", "moshen-force");
  map_skill("parry", "tianya-blade");
  map_skill("blade", "tianya-blade");
  setup();
  carry_object(__DIR__ "obj/cloth")->wear();
  carry_object(__DIR__ "obj/shenblade")->wield();
}
void init() {
  add_action("do_detect", "detect");
  add_action("do_accept", "accept");
  add_action("do_kill", "kill");
}

int do_detect(string arg) {
  object ob;

  if (arg) ob = present(arg, environment(this_player()));
  else ob = this_player()->query_opponent();

  if (!ob) return notify_fail("你要探测谁的战斗力？\n");
  printf("探测器显示%s的战斗力是：2000000\n",
    ob->query("name"));
  return 0;
}
int answer_inquiry() {
  object ob, room;
  ob = this_player();
  say("在下等被困此处多日，正打算跟快活王火拼一场，但实力还稍逊一筹，\n阁下是否有意帮助我们？(accept yes)\n");
  return 1;
}

int do_accept(string arg) {
  string name;
  object room;
  if (arg != "yes")
    return notify_fail("你要接受什么？\n");
  if (this_player()->query_temp("helpformarry"))
    return notify_fail("你不是答应帮我们了吗？难道反悔了不成？\n");
  say("沈浪说道：好！事成之后，我沈浪一身武艺随你所学！\n");
  say("沈浪说道：你跟七七先在这里等着，我先去联络熊猫儿和王怜花！\n");
  call_out("busy1", 1, this_player());
  //this_player()->start_busy(40);
  this_player()->set_temp("helpformarry", 1);
  room = load_object("/d/kuaihuo/fang");
  room->delete("exits/east");
  return 1;
}
void busy1(object me) {
  say("沈浪走到了窗边，从衣服中拿出只白鸽，放了出去。\n只见白鸽的朝西北方飞了出去。\n");
  call_out("busy2", 5, me);
  return;
}
void busy2(object me) {
  message_vision("\n沈浪又走了回来。对着$N道：“我们暂且等一会吧。”\n", me);
  call_out("busy3", 15, me);
  return;
}
void busy3(object me) {
  object npc1, npc2, npc3, room;
  string msg;
  object npc4;
  npc1 = load_object(__DIR__ "wang");
  npc2 = load_object(__DIR__ "king1");
  npc3 = load_object(__DIR__ "jiu");
  room = load_object("/d/kuaihuo/fang");
  npc1->move(room);
  npc2->move(room);
  npc3->move(room);
  say("\n一会儿功夫，熊猫儿和王怜花走了进来，上下打量了你一下。\n沈浪略顿了顿，然后对猫儿说道：“这位新朋友，和我们是一道的。\n");
  say("\n    “走吧，我们去找快活王去！”\n    “不用你们来了，我自己过来了，哈哈哈哈”\n\n只见一条人影掠进屋内，正是快活王本人。\n");
  message_vision("\n$N道：拼了！\n", npc3);
  call_out("busy4", 8, npc1, npc2, npc3, me, room);
  return;
}
void busy4(object npc1, object npc2, object npc3, object me, object room) {
  string msg;
  msg = HIY "\n但见$N魁伟身形，突然开始移动，沉肃的面容上，泛起一层紫气，一步步往$n" NOR + HIY "走了过去。\n" NOR;
  COMBAT_D->do_attack(npc3, npc2, npc3->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = HIY "$N身形陡然一折，双臂微张，凌空翻身，直扑$n" NOR + HIY "。\n这一招不但变化精微，内蕴后着，威力之猛，更是惊人。\n" NOR;
  COMBAT_D->do_attack(npc3, npc2, npc3->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = HIY "$n" NOR + HIY "耸然变色，失声呼道：“玉石俱焚！！！”\n" NOR;
  COMBAT_D->do_attack(npc3, npc2, npc3->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = WHT "\n$N在一旁见有机可趁，突得一个地滚，翻身而上，与熊猫儿上下夹攻$n" NOR + WHT "！\n" NOR;
  COMBAT_D->do_attack(npc1, npc2, npc1->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = WHT "$N右腿向左挥出，左腿微曲腿向左斜踢，巨大的身形，竟藉着这一挥一踢之势，\n风车般凌空一转，竟自硬生生转了身！\n" NOR;
  COMBAT_D->do_attack(npc1, npc2, npc1->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = WHT "$N左手桌腿，随着臂时一缩之力，巧妙地避过了$n" NOR + WHT "的一指，右腿却已踢向$n" NOR + WHT "肩呷之处!\n" NOR;
  COMBAT_D->do_attack(npc1, npc2, npc1->query_temp("weapon"), TYPE_REGULAR, msg);
  message_vision("$N也流露出诧异的眼神道：“神风腿”！！！\n\n“沈浪在此！”", npc2);
  msg = HIB "\n就在这间不容发的刹那之间，$N叹息一声，双臂突然反挥而出，右掌骈起如刀，左掌藏在袖中，\n$N虽未回头，但这一掌一袖，却俱都攻向$n" NOR + HIB "必救之处，恰似背后长了眼睛一般。\n" NOR;
  message_vision("$N对着沈浪道：“你这是找死！”\n", npc2);
  COMBAT_D->do_attack(this_object(), npc2, this_object()->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = HIG "$N左手下垂，五刀连出，身形突转，右手已自颊边翻起，身形流动自如，\n口中吟道：“垂手乱翻雕玉佩，背人多整绿上鬟……”\n" NOR;
  COMBAT_D->do_attack(this_object(), npc2, this_object()->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = HIM "$N右手一斜，双臂曲收，招式一变，攻中带守，\n口中又吟道：“纤腰怕束金蝉断，寒鬓斜簪玉燕光……”\n" NOR;
  COMBAT_D->do_attack(this_object(), npc2, this_object()->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = HIR "只见$N长袖突然翻起，如流云，如泻水，招式自然巧妙，浑如天成，\n口中却朗声吟道：“自传芳酒翻红袖，似有微词动绛唇……”\n" NOR;
  COMBAT_D->do_attack(this_object(), npc2, this_object()->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = HIC "念到这里，$N身形已回旋三次，手中" + this_object()->query_temp("weapon")->name() + HIC "突又斜挥而起，道：“黄鹏久住浑相识，青鸟西飞意未回。”\n$n" NOR + HIC "脱口而道：“好一招青鸟西飞意未回。”\n" NOR;
  COMBAT_D->do_attack(this_object(), npc2, this_object()->query_temp("weapon"), TYPE_REGULAR, msg);
  msg = YEL "$N微微一笑，左掌突然化做一片掌形，护住了全身七十二处大穴。\n口中念道：“帘前春色应须惜，楼上花枝笑独眠。”右手持刀在影中一点而出！\n" HIW "$n也叹道：沈浪果然是文武双全！\n" NOR;
  COMBAT_D->do_attack(this_object(), npc2, this_object()->query_temp("weapon"), TYPE_REGULAR, msg);
  npc2->kill_ob(this_player());
  npc2->kill_ob(this_object());
  npc2->kill_ob(npc1);
  npc2->kill_ob(npc3);
  this_player()->kill_ob(npc2);
  this_object()->kill_ob(npc2);
  npc1->kill_ob(npc2);
  npc3->kill_ob(npc2);
  call_out("finish", 30, npc2, npc1, npc3, me, room);
  return;
}
void finish(object ob, object npc1, object npc3, object me, object room) {
  if (!me->query("m_success/婚礼") && me->query_temp("helpformarry")) {
    me->set("m_success/婚礼", 1);
    me->add("score", 1000);

  }
  if (ob) {
    message_vision("老夫不跟你们这帮凡夫俗子罗嗦了，你们好之为知吧。哼！\n快活王用力的一挥袖离开了。\n", this_object());
    destruct(ob);
  }
  if (npc1) {
    message_vision("熊猫儿说道：看来我们还是棋差一招，没想到快活王武功竟然那么高！我也回去准备准备了，就此告别。\n", this_object());
    destruct(npc1);
  }

  if (npc3) {
    message_vision("王怜花道：离谱，离谱，他的武功实在是太离谱了！\n", this_object());
    destruct(npc3);
  }
  room->set("exits/east", "/d/kuaihuo/hill");
  me->delete_temp("helpformarry");
  return;
}
int recognize_apprentice(object ob) {
  if (!ob->query("m_success/快活城")) {
    say("沈浪说道：这里太危险了，你还是速速离开吧。\n");
    return 0;
  }
  if (!ob->query("marks/appwang") && !ob->query("marks/appking")) {
    say("沈浪说道：你我恐怕没有缘分吧。\n");
    return 0;
  }
  if (!ob->query("m_success/婚礼")) {
    say("沈浪说道：你我恐怕没有缘分吧。\n");
    return 0;
  }
  return 1;
}
int do_kill(string arg) {

  object player, victim, weapon;
  string name;
  player = this_player();
  if (!arg) return 0;
  if (objectp(victim = present(arg, environment(this_object()))) && living(victim)) {
    name = (string)victim->name();
    if ((string)name == "朱七七") {
      message_vision("$N冷笑一声道：当着我的面想害七七？你给我去死吧！\n", this_object());
      this_object()->kill_ob(player);
      player->kill_ob(this_object());
      return 1;
    }
  }
  return 0;
}

int accept_fight(object me) {
  command("say 学武之人非要动刀动剑的吗？\n");
  return 0;
}
