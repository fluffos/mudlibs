// 朱七七  writted by tiandi
inherit NPC;
#include <ansi.h>
void create() {
  set_name("朱七七", ({ "zhu qiqi", "zhu" }));
  set("nickname", HIM "七姑娘" NOR);
  set("gender", "女性");
  set("age", 21);
  set("agi", 30);
  set("str", 10);
  set("per", 80);
  set("cor", 20);
  set("int", 30);
  set("attitude", "friendly");
  set("max_force", 1000);
  set("force", 1000);
  set("force_factor", 2);
  set("max_mana", 1000);
  set("mana", 1000);
  set("max_atman", 1000);
  set("marks/kuaihuo", 1);
  set("TASK", 5000);
  set("atman", 70000);
  set("long",
    "这女孩的目色分明，在月光下，明的清的，这女孩的容华清如水。你闻到一种淡淡的，\n如桂花般，在月色下，似有似无的幽香。
这女于黑白分明如黑山白水的眼。
这女子白皙的鼻梁挺起美丽的弧型。
这女子拗执坚强而下抿的唇，没有血色。\n"
  );
  set("chat_chance_combat", 99);
  set("chat_msg_combat", ({
    (: perform_action, "sword.tianyaliuxing" :),
    (: perform_action, "sword.onheart" :),
  }));
  set("chat_chance", 1);
  set("chat_msg", ({
    "七姑娘脚步顿时轻快起来，暗暗忖道：“原来能为自己所爱的人吃苦，竟也是一种快乐，\n只是世上又有几人能享受这种快乐……我岂非比别人都幸福的多……”\n",
  }));
  set("inquiry", ([
    "快活城": "这种鬼地方，如果我能出去的话，打死我也再不要来了。\n",
    "沈浪": "沈浪这人啊，真是让人讨厌呀。",
  ]));
  set("combat_exp", 500000);
  set_skill("dodge", 50);
  set_skill("move", 100);
  set_skill("force", 100);
  set_skill("fallingstar-sword", 150);
  set_skill("unarmed", 50);
  set_skill("parry", 150);
  set_skill("sword", 50);
  set_skill("moshen-force", 50);
  map_skill("force", "moshen-force");
  map_skill("parry", "fallingstar-sword");
  map_skill("sword", "fallingstar-sword");
  setup();
  carry_object(__DIR__ "obj/qcloth")->wear();
  carry_object(__DIR__ "obj/sword")->wield();
}
int recognize_apprentice(object ob) {
  if (!ob->query("m_success/快活城")) {
    say("七姑娘说道：这里太危险了，你还是快点走吧。\n");
    return 0;
  }
  if (!ob->query("marks/appwang") && !ob->query("marks/appking")) {
    say("七姑娘说道：别开玩笑了吧，我拜阁下为师还差不多。\n");
    return 0;
  }
  return 1;
}


int accept_fight(object me) {
  command("say 不比行吗？\n");
  return 0;
}
