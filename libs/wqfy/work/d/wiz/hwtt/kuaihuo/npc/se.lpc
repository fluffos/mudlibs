inherit NPC;
#include <ansi.h>
void create() {
  set_name("江左司徒", ({ "jiangzuo situ", "seshi" }));
  set("nickname", HIR "色使" NOR);
  set("gender", "男性");
  set("age", 33);
  set("agi", 30);
  set("str", 10);
  set("per", 50);
  set("cor", 6);
  set("int", 10);
  set("attitude", "friendly");
  set("max_force", 10000);
  set("force", 10000);
  set("force_factor", 30);
  set("max_mana", 10000);
  set("mana", 10000);
  set("max_atman", 10000);
  set("marks/kuaihuo", 1);
  set("TASK", 5000);
  set("atman", 10000);
  set("long",
    "快活城的色使。要是你离他远点的话，你还以为他是个女子呢。\n"
  );
  set("inquiry", ([
    "任务": "我的任务就是帮王爷收集世间美女，嘻嘻。\n",
  ]));
  set("combat_exp", 2000000);
  set_skill("dodge", 150);
  set_skill("move", 70);
  set_skill("force", 150);
  set_skill("unarmed", 50);
  set_skill("parry", 50);

  setup();
}
