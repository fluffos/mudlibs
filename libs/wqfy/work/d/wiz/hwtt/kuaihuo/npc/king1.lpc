inherit NPC;
#include <ansi.h>
void create()
{
        set_name(HIC"快活王"NOR, ({ "master king"}) );
        set("nickname", HIY"快"HIM"活"NOR);
        set("title","快活城城主");
        set("gender", "男性" );
        set("age", 60);
        set("agi",100);
        set("str", 120);
        set("per", 40);
	  set("cor",90);
        set("int",30);
        set("attitude","friendly");
        set("max_force", 500000);
        set("force", 500000);
        set("force_factor", 200);
        set("max_mana", 500000);
        set("mana", 500000);
        set("max_atman", 500000);
	  set("marks/kuaihuo",1);
	  set("TASK",5000);
        set("atman", 500000);
        set("long",
"暗淡的灯光下，只见此人浓眉倒垂，目光如炬，又眉中一道刀疤，更平添了他几分煞气。
此刻他那只女子般的美手，正在捋动着颔下的长髯，那双光彩流动的眼睛，那竞是双碧绿
的眼睛。\n"
        );
	  set("combat_exp", 5000000000);
    	  set_skill("dodge", 150);
        set_skill("move",100);
        set_skill("force", 150);
        set_skill("staff", 250);
        set_skill("chaotian-stick", 150);
        set_skill("long-steps", 150);
        set_skill("literate", 150);
        set_skill("unarmed",150);
        set_skill("parry", 150);
        set_skill("wuxing-force", 150);
        set_skill("sushi-zhi", 140);
        map_skill("force", "wuxing-force");
        map_skill("unarmed", "sushi-zhi");
        map_skill("parry","chaotian-stick");
	 map_skill("staff","chaotian-stick");
     
	carry_object(__DIR__"obj/mstaff");
	

	 setup();
}
