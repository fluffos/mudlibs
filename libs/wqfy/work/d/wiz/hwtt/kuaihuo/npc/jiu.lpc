// 熊猫儿 writted by tiandi
inherit NPC;
#include <ansi.h>
void create()
{
        set_name("熊猫儿", ({ "xiong maoer"}) );
        set("nickname", HIC"猫儿"NOR);
        set("gender", "男性" );
        set("age", 25);
        set("agi",30);
        set("str", 40);
        set("per", 20);
	 set("cor",20);
        set("int",10);
        set("attitude","friendly");
        set("max_force", 100000);
        set("force", 100000);
        set("force_factor", 100);
        set("max_mana", 10000);
        set("mana", 10000);
        set("max_atman", 10000);
	  set("marks/kuaihuo",1);
	  set("TASK",5000);
        set("atman", 10000);
        set("long",
"只见此人身长八尺，沈眉大眼，腰畔斜插着柄无鞘短刀，手里提着只发亮的酒葫芦，
一面高歌，一面痛欢。他蓬头敞胸，足登麻鞋，衣衫打扮虽然落魄，但龙行虎步，
神情间却另有一股目空四海，旁若无人的涝洒豪迈之气。\n"
           );
	 set("inquiry", ([
	 "快活城": "这里就是快活城了。\n",
  ]) );
	      set("chat_chance", 1);
	 set("chat_msg", ({
                "猫儿说道：“但将血泪酬知己，生死又何妨……”\n",
                
        }) );
	set("combat_exp", 10000000);
        set_skill("dodge", 150);
        set_skill("move",100);
        set_skill("force", 150);
        set_skill("unarmed",50);
        set_skill("parry", 150);

        setup();
}
