inherit ROOM;

void create()
{
        set("short", "铁索下");
        set("long", @LONG

∞∞∞∞∞∞∞∞∞∞∞∞∞∞∞∞∞∞∞∞∞∞∞∞∞∞∞∞∞∞
似乎有东西卡在前面的锁链中。

LONG
        );
       set("outdoors", "huangshan");
	set("coor/x",-650);
	set("coor/y",-510);
	set("coor/z",0);
	setup();
}
void init()
{
add_action("do_search","search");
}
int do_search()
{
	object me,ob;
	me = this_player();
	ob = load_object("/d/kuaihuo/obj/egg");
	message_vision("$N伸手向前方摸一摸，摸到什么东西，$N拿近一看，竟然是个鸟蛋，在阳光的照射下，闪出白光。\n",me);
	ob->move(me);
	return 1;
}
	
