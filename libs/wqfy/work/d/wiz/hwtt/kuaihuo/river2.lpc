inherit ROOM;
void create()
{
        set("short", "小河流岸");
        set("long", @LONG
走到这里，你不禁地突发奇想，一弯腰，竟然把鞋子脱了下来，站在溪中洗起了脚。
阳光打在河面上，映射而入你眼帘中的却是另一幅图像，你惊讶地叫了起来。
LONG
        );
 	set("exits", ([ 
		  "north" : __DIR__"river1",
		  "south" : __DIR__"river3",
		]));         
	 set("item_desc", ([
               "河流": "这里离对岸的距离是最近的了，若是轻功好点的话，就可以跳到对岸了。\n",
         	 "river": "这里离对岸的距离是最近的了，若是轻功好点的话，就可以跳到对岸了。\n"
	]) );
	set("no_magic",1);
	setup();
}
void init()
{
add_action("do_jump","jump");
}
int do_jump(string arg)
{
	object me,room;
	me = this_player();
        if(!arg || arg=="" )
        {
                return 0;
        }
        if( arg == "river" )
        {
        message_vision("$N拎起自己的鞋子，一招蜻蜓点水，踩在水面上。\n", me);
	 	if (me->query_skill("move",1) > 199)
	 	{ 
		 message_vision("$N没几下，就到了小河流的另一边。\n", me);
		 me->start_busy(2);
	 	 room = load_object(__DIR__"lake");
	 	 me->move(room);
		 return 1;
		}
	 message_vision("$N由于轻功太差，再加上自己太胖，扑通一声一头栽入水中。\n",me);
	 this_player()->unconcious();
	 return 1;
        }
}

