//writted by tiandi
#include <ansi.h>
#include "/d/kuaihuo/obj/study.h"
inherit ROOM;
void create() {
  set("short", "幽灵血池底");
  set("long", @LONG
这里四周都是血，不知道要用多少人的血才能筑成这样大的池子。你想到这
儿，不由自主地哆嗦了一下。东西两面各有一块石碑，东面那块刻着“幽灵剑法”
而西面那块却刻着“妖神”，北边插着一把刀，刀身成火状，刀柄上写着“妖神
火刃”。
LONG);
  set("exits", ([
    "up": __DIR__ "youling2",

  ]));
  set("objects", ([
    __DIR__ "obj/book1": 1,
    __DIR__ "obj/book2": 1,
  ]));
  set("no_magic", 1);
  setup();
}
void init() {
  add_action("do_ba", "ba");
  add_action("do_learn", "lingwu");
  add_action("do_study", "study");
  call_out("airing", 5, this_player());
}
int do_study() {
  object me;
  me = this_player();
  write("这项技能不能研读，只能通过领悟来提高。\n");
  return 1;
}
int do_ba() {
  object me, ob;
  me = this_player();
  if (me->query("m_success/幽灵宫") && me->query_skill(
    "yaoshen",
    1
  ) > 150 && !me->query_temp("get_blade")) {
    ob = load_object(__DIR__ "obj/yaoshen-blade");
    message_vision("$N念起妖神之术的拔刀咒，一道金光飞向妖神火刃，顿时火刃上的火焰消失了，\n这时，本已插在地上的妖神火刃似有灵性般地跃入$N怀中。\n", me);
    ob->move(me);
    me->set_temp("get_blade", 1);
    return 1;
  }
  message_vision("$N伸手尝试去拔插在地上的妖神火刃，不料火刃上突然冒出烈火，$N顿觉手上一阵疼痛。\n", me);
  me->receive_damage("kee", 500);
  return 1;
}
int airing(object ob) {
  int i, htime, ntime;

  if (environment(ob) == this_object()) {
    htime = (int)ob->query("str") + (int)ob->query("kar");
    htime = htime * 5;
    if (!(ntime = (int)ob->query_temp("marks/入池"))) ntime = 5;
    else ntime = ntime + 5;
    ob->set_temp("marks/入池", ntime);
    if (ntime > htime) {
      ob->die();
      ob->skill_death_penalty();
      ob->set_temp("marks/入池", 0);
    } else if (ntime > (htime - 60))
      message_vision(HIR "$N已经憋不住了，若再不换真气，必定死在池里了。\n" NOR, ob);
    else if (ntime > (htime - 90))
      message_vision(HIR "$N已经憋得面红耳赤，半分中之内再不出井，恐怕会憋死在这血池中。\n" NOR, ob);
    else
      message_vision(HIW "$N觉得呼吸逐渐不顺畅了，估计是憋不了很久，还是赶快上去吧。\n" NOR, ob);

    call_out("airing", 30, ob);
  } else
    ob->delete_temp("marks/入池");
  return 1;
}
