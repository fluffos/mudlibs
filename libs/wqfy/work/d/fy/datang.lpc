inherit ROOM;
void create() {
  set("short", "风云PKER大堂");
  set("long", @LONG
这里是[1;31m风云[2;37;0m状告和审判[1;31m杀人者[2;37;0m的地方，凡被其他玩家所杀的人
都可以到这里来告状（ｇａｏ），被告将被带到这里处罚。
用法：
	gao xxx to jail   （关进监狱）
	gao xxx to kill   （杀一次）
	gao xxx to poqi   （破气）
LONG
  );
  set("exits", ([ /* sizeof() == 4 */
    "north": __DIR__ "govern",
  ]));

  set("no_fight", 1);
  set("no_magic", 1);
  set("no_spells", 1);
  set("no_perform", 1);
  set("NONPC", 1);
  set("coor/x", -20);
  set("coor/y", -12);
  set("coor/z", 0);
  setup();
}


void init() {
  add_action("do_gao", "gao");
}
int gethim(object target, object me, string st2) {
  if (!target || !me) return 1;
  if (st2 == "jail") {
    if (!target->query_temp("netdead"))
      message_vision(target->query("name") + "匆匆忙忙地离开了。\n", target);
    target->move("/d/wiz/jail");
    if (!target->query_temp("netdead"))
      message_vision(target->query("name") + "走了进来。\n", target);
    return 1;
  }
  if (st2 == "kill") {
    if ((target->query("startroom") == "/d/wiz/jail.lpc") ||
      (target->query("startroom") == "/d/wiz/jail")) {
      target->add("OPK", -1);
      target->die();
      target->move("/d/wiz/jail");
    } else {
      target->move("/d/fy/datang");
      target->add("OPK", -1);
      target->die();
    }
  }
  if (st2 == "poqi") {
    if (target->query("max_force") > 2000) target->add("OPK", -1);
    target->set("max_force", random(100));
  }

  return 1;
}


int do_gao(string arg) {
  object me, target;
  string t1, t2;
  int exp, stra, leader, factor;

  if (!arg)
    return notify_fail("你要告谁？\n");
  me = this_player();

  sscanf(arg, "%s to %s", t1, t2);

  if (t2 != "jail" && t2 != "kill" && t2 != "poqi")
    return notify_fail("你想怎么告他？\n");
  target = find_player(t1);
  if (!target) target = find_living(t1);

  if (!target)
    return notify_fail("你要告的玩家现在不在线或者没有这个玩家，只有被告玩家在线时才能告！\n");

  if (wizardp(target))
    return notify_fail("你要告的玩家现在不在线或者没有这个玩家，只有被告玩家在线时才能告！\n");
  //	return notify_fail("巫师是不能告的！\n");

  if (me->query("pkid") != target->query("id"))
    return notify_fail("从来没杀过你的人不能告！\n");

  if (target->query("OPK") < 1)
    return notify_fail("现在她/他已不是杀人犯了，不能告！\n");

  if ((me->query("pk/pked_time") + 172800) < time())
    return notify_fail("你的有效控告时间超过了2天！\n");

  message(
    "channel:gab",
    "[1;31m" + me->query("name") + "因被" + target->query("name") + "所杀上告官府，官府处罚" + target->query("name") + "！！\n[2;37;0m",
    users()
  );
  gethim(target, me, t2);
  return 1;
}
