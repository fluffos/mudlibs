// tea_waiter.c

inherit NPC;
inherit F_VENDOR;

void create() {
  set_name("棋院老板", ({ "qiboss" }));
  set("gender", "男性");
  set("age", 40);
  set("long",
    "一个精明的商人．\n");
  set("combat_exp", 5);
  set("attitude", "friendly");
  set("rank_info/respect", "聂老九");
  set("chat_chance", 1);
  set("chat_msg", ({
    "棋院老板嘀咕到：今天怎么人这么少？？\n",
  }));

  set("vendor_goods", ([
    __DIR__ "obj/qipan": 20,
    __DIR__ "obj/qipan1": 10,
    __DIR__ "obj/qipan2": 5,
    //                __DIR__"obj/qipan3":2,
  ]));
  setup();
}

void init() {
  add_action("do_vendor_list", "list");
}
