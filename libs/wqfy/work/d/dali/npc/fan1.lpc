// tea_waiter.c

inherit NPC;
inherit F_VENDOR;

void create()
{
        set_name("卖药的", ({ "yaofan" }) );
        set("gender", "男性" );
        set("age", 40);
        set("long",
                "一个卖药的的小商人．\n");
        set("combat_exp", 5);
        set("attitude", "friendly");
        set("rank_info/respect", "李老四");
        set("chat_chance", 3);
        set("chat_msg", ({
                "卖药的吆喝道：专治跌打损伤．．\n",
                (: random_move :),
        }) );

        set("vendor_goods", ([
                __DIR__"obj/gaoyao":50,
                __DIR__"obj/keedrug":30,
                __DIR__"obj/dieda":20,
        ]) );
        setup();
}

void init()
{
        add_action("do_vendor_list", "list");
}
