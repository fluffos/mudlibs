inherit ITEM;
#include <ansi.h>

void create()
{
set_name(HIC"无忧丹"NOR, ({ "wuyou dan", "dan"}) );
        set_weight(10);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long", "这是一粒武林仇恨的消解丹\n");
                set("unit", "粒");
 set("value", 7000000);
          }
}

void init()
{
        add_action("eat_guo","eat");
}

int eat_guo(string arg)
{
        if ( arg == "dan" || arg == "wuyou dan"){
message_vision(HIW"$N捏了一粒无忧丹放进嘴里,转眼间所有仇恨荣辱烟消云散\n"NOR,this_player());
        this_player()->set("vendetta/authority", 0);
        this_player()->set("vendetta/shaolin", 0);
      this_player()->remove_all_killer();
                this_player()->del("vendetta_mark", "authority");
     this_player()->del("vendetta_mark","shaolin");
        destruct(this_object());
        return 1;
}
     return 0; 
}
