#include <ansi.h>
inherit ITEM;

void create()
{
    set_name(HIM"魔光水晶"NOR, ({ "feng crystal" }) );
    set_weight(1);
    if (clonep())
        set_default_object(__FILE__);
    else {
            set("unit", "颗");
            set("value", 10000);
    }
    setup();
}
