inherit NPC;
string ask_delexp();

void create()
{
    set_name("法官", ({ "fa guan", "fa", "guan" }));
    set("title", HIY+"大法官"+NOR);
    set("nickname", "减经验请give fa 1000 gold");
    set("str", 37);
    set("gender", "男性");
    set("age", 35);
    set("long",
        "他是江湖里一名大法官，你可以试一试降低你的实战经验，每次减10%的经验。\n");
    set("combat_exp", 1500);
    set("attitude", "friendly");
    set("inquiry", ([
        "减经验" : (: ask_delexp :),   
    ]));
    
    setup();
    carry_object("/clone/misc/cloth")->wear();
}
/*
void init()
{
    object ob;
    
    ::init();
    if (interactive(ob = this_player()) && !is_fighting()) {
        remove_call_out("greeting");
        call_out("greeting", 1, ob);
    }
    add_action("do_betray","decide");
}
*/
void greeting(object ob)
{
    if (!ob || environment(ob) != environment())
        return;
    switch(random(2)) {
    case 0 :
        say("大法官笑眯眯地说道：这位" + RANK_D->query_respect(ob) +
            "，快请进来歇口气吧。\n");
        break;
    case 1 :
        say("大法官说道：哟！这位" + RANK_D->query_respect(ob) + 
            "您来了啊！您要清除您的实战经验吗？\n");
        break;
    }
}

int accept_object(object who, object ob)
{
	int base_value, amount, value;

	if(!ob->query("money_id"))
	{
		return notify_fail("给我这些废物干什么？");
	}

	if( who->query_temp("ask_delexp") )
	{
       command("say "+who->query("name")+"，上次的事都还没办成，怎么好再收你的钱！\n");
       return 0;
	}

	base_value = ob->query("base_value") / 1000;
	amount = ob->query_amount();

	if(base_value <= 0)
	{
       command("say "+who->query("name")+"，多谢你的馈赠了！ \n");
       return 1;
	}

	if(amount >= 2100000000 / base_value)
	{
       command("say "+who->query("name")+"，这么多钱我可不敢收！\n");
       return 0;
	}

	value = (base_value * amount);
    if( value >= 1000)
	{
		message_vision("不知道$N有什么问题要问我呢？\n", who);
		who->add_temp("ask_delexp", value / 1000);
		return 1;
	}
	else
	{
       command("say "+who->query("name")+"，多谢你的馈赠了！ \n");
       return 1;
	}
}

string ask_delexp()
{
	int count,exper;
	object me = this_player();

    exper = (me->query("combat_exp"));
	count = (int)me->query_temp("ask_delexp");
	if( count )
	{
		if (me->query("jh_dj/dj") < 2)
		if( me->query("combat_exp") >= 1000000 )
		{
               me->add(("combat_exp") ,- exper/ 100* 10);
			tell_object(me,HIG"成功削减经验10%,欢迎再来!  \n"NOR);
			//me->add("rmb", -count * 100);
			//me->move("d/erengu/erengu");
			me->delete_temp("ask_delexp");
			//me->add("erengu/count",count);
		}
		else
		{
			tell_object(me,HIG"请检查你的经验值和等级是否符合条件！\n"NOR);
		}
	}

	return HIC"削减经验需要1000黄金，且自身经验必须大于100万。（等级大于1级的玩家不接受！）\n"NOR;
}
