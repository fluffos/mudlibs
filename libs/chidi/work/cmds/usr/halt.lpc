// halt.c
// By Xiang@XKX (12/17/95)
#include <ansi.h>
#define SCHEME_CMD      "/cmds/usr/scheme"

int main(object me, string arg) {
  object ob;

  if (me->query("doing") == "scheme") {
    // 执行计划中，终止
    write("你决定中止计划。\n");
    SCHEME_CMD->cancel_schedule(me);
    if (!me->is_busy())
      return 1;
  }

  if (me->query("doing") == "closed") {
    CLOSE_D->user_opened(me);
    //tell_object(me, "你中止了闭关。\n");
    //message_vision(HIY "$N" HIY "大喝一声，睁开眼来，一股气流登时将众人迫退四步。\n\n" NOR, me);
    me->add("potential", -(me->query("potential") / 10));
    CHANNEL_D->do_channel(this_object(), "rumor", "听说" + me->name(1) + "闭关中途突然复出。");
    if (ob = present("huanyu tianzhu", me))
      destruct(ob);
    if (me->is_busy())
      me->interrupt_me();
    return 1;
  }


  if (me->query_condition("dianxue_busy") && me->is_busy())
    return notify_fail("你已经给人点穴道，暂时不能动弹。\n");


  if (me->is_fighting()) {

    if (wizardp(me)) {
      me->remove_all_killer();
      message_vision("$N用巫师的神力阻止了这场打斗。\n", me);
      return 1;
    } else

      me->remove_all_enemy();
    write(BLK "你身行向后一跃，跳出战圈不打了。！\n" + NOR);
    return 1;

  } else if (!me->is_busy())
    return notify_fail("你现在不忙。\n");

  else if ((int)me->query_temp("pending/exercise") != 0) {
    tell_object(me, "你把正在运行的真气强行压回丹田，站了起来。\n");
    me->interrupt_me();
  } else if ((int)me->query_temp("pending/respirate") != 0) {
    tell_object(me, "你把正在灵台中运行的先天之气徐徐吐出，睁眼站了起来。\n");
    me->interrupt_me();
  }
  //  me->interrupt_me();//此处会导致学习等设置的BUSY无法控制.玩家可利用halt解除.

  return 1;
}
