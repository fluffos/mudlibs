
#include <ansi.h>
//inherit F_CLEAN_UP;
int check_legal_name(string name);
int check_legal_long(string name);
void enter_desc(object me, int roomtype, string s_title, string dir, string text);


int main(object me, string arg)
{
		int type;
        string name;
        object env;

		string filename;
		string this_file;

        seteuid(getuid());
        if(!arg || sscanf(arg,"%d %s", type, name) != 2)
			return notify_fail("指令格式：　bhren 1 大门 \n"
			+ "1 房间名字 \n"
			+ "2 房间描述 \n"
			+ "这个指令有些问题，房间的描述里面如果有房间名字就会出错。\n所以请谨慎使用。\n"
			);

		if((me->query("banghui/rank_lv")) < 8 && !wizardp(me))
			return notify_fail("你没有这种权力。\n");

        env = environment(me);

		if((string)env->query("owner") != (string) me->query("banghui/name") && !wizardp(me))
			return notify_fail("你没有权力修改这个房间的属性！\n");

    name = replace_string(name, "$BLK$", BLK);
    name = replace_string(name, "$RED$", RED);
    name = replace_string(name, "$GRN$", GRN);
    name = replace_string(name, "$YEL$", YEL);
    name = replace_string(name, "$BLU$", BLU);
    name = replace_string(name, "$MAG$", MAG);
    name = replace_string(name, "$CYN$", CYN);
    name = replace_string(name, "$WHT$", WHT);
    name = replace_string(name, "$HIR$", HIR);
    name = replace_string(name, "$HIG$", HIG);
    name = replace_string(name, "$HIY$", HIY);
    name = replace_string(name, "$HIB$", HIB);
    name = replace_string(name, "$HIM$", HIM);
    name = replace_string(name, "$HIC$", HIC);
    name = replace_string(name, "$HIW$", HIW);
    name = replace_string(name, "$NOR$", NOR);
	name += NOR;

	filename = base_name(environment(me))+".lpc";
	this_file = read_file(filename);

	switch(type)
	{
	case 1:					//房间名字
		this_file = replace_string(this_file,env->query("short"),name);
		env->set("short",name);

		break;
	case 2:					//房间描述
		this_file = replace_string(this_file,env->query("long"),name+"\n");
		env->set("long",name+"\n");
		break;
	default:
		return notify_fail("你要干什么？\n");
	}

	write_file(base_name(environment(me))+".lpc", this_file, 1);

	write("修改完毕！\n");
	return 1;
}

int check_legal_long(string name)
{
        int i;
        i = strlen(name);
        if( (strlen(name) < 120) || (strlen(name) > 600 ) ) {
                write("对不起，中文描述必须是六十到三百个中文字。\n");
                return 0;
        }
        while(i--) {
                if(name[i]==' ' || name[i] == '\n') continue;
                if( name[i]<' ' ) {
                        write("对不起，中文描述不能用控制字元。\n");
                        return 0;
                }
                if( i%2==0 && !is_chinese(name[i..<0]) ) {
                        write("对不起，描述必需是中文。\n");
                        return 0;
                }
        }
        return 1;
}
int help (object me)
{
        write(@HELP

指令格式：　buildbh 1 north 天地阁总坛 \n
1 普通房
2 休息室
3 铁匠铺
4 练功房
5 任务房
6 书院
7 钱庄
8 大门
9 擂台

HELP
        );
        return 1;
}

