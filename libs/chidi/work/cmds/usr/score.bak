//score.c 
#include <ansi.h>
#include <combat.h>
#include <mudlib.h>

inherit F_CLEAN_UP;

string display_attr(int gift, int value);
string status_color(int current, int max);
string date_string(int date);
string tribar_graph(int val, int eff, int max, string bcolor, string fcolor, string dcolor);
string tribara_graph(int val, int eff, int max, string bcolor, string fcolor, string dcolor);


void create() { seteuid(ROOT_UID); }

int main(object me, string arg)
{
        object ob;
        mapping my;
        string line, my_str,my_dex,my_con,my_int,my_kar,my_per,str1,str,skill_type, *marks;
        object weapon;
        int i, jin_li,nei_li,attack_points, dodge_points, parry_points,balance;
// int obstacles,dntg;  

        
        
        seteuid(getuid(me));
        if(!arg)

                ob = me;
                 
        else if (wizardp(me)) {
                ob = present(arg, environment(me));
                if (!ob) ob = find_player(arg);
                if (!ob) ob = find_living(arg);
                if (!ob) return notify_fail("你要察看谁的状态？\n");
                
        } else
                return notify_fail("只有巫师能察看别人的状态。\n");
        balance = (int)ob->query("money")+(int)ob->query("more_money")*10000*10000;
        
        my = ob->query_entire_dbase();
        
        my_str = display_attr(my["str"], ob->query_str());
         my_con = display_attr(my["con"], ob->query_con());
         my_int = display_attr(my["int"], ob->query_int());
         my_dex = display_attr(my["dex"], ob->query_dex());
                 if( wizardp(me) || (int)ob->query("age") >= 18 )  {
                my_kar = display_attr(my["kar"], ob->query_kar());
                my_per = display_attr(my["per"], ob->query_per());
        }else
        {
                my_kar ="隐藏";
                 my_per ="隐藏";
                }
        
        nei_li=((int)ob->query_skill("force", 1) + ob->query_skill("force")/5) * 10  ;
        jin_li=(int)ob->query_skill("taoism") * 10;
        
        write("\n");
        write(NOR HBBLU YEL"≡≡≡≡≡≡≡≡≡≡≡≡"HIG"个"NOR HBBLU YEL"≡≡"HIG"人"NOR HBBLU YEL"≡≡"HIG"档"NOR HBBLU YEL"≡≡"HIG"案"NOR HBBLU YEL"≡≡≡≡≡≡≡≡≡≡≡≡\n"NOR);
        write("你现在的头衔 : "+RANK_D->query_rank(ob)+"\n");
        write("你现在的职称 : "+ob->short(1)+"\n");
        line = NOR HBBLU YEL"≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡\n\n"NOR;
        str = "";
        str1 = "";
        if( mapp(my["family"]) ) {
                if( my["family"]["master_name"] ) str1 =my["family"]["family_name"]+HIC+my["family"]["master_name"];
        }
        if( mapp(my["marks"]) ) {
                marks = keys( my["marks"] );
                for( i = 0; i < sizeof(marks); i ++ ) {
                        if( str != "" ) str += "、";
                        str += marks[i];

                }
        }

  
      if( str1 != "" ) {
        
        line += sprintf( " 性 别[%s%6s%s]",
                HBBLU HIG, ob->query("gender"), NOR );
               line += sprintf(NOR"师 承[%s%-10s%s%s",
               HBBLU HIW,my["family"]["master_name"],NOR, "]" );
               line += sprintf(NOR"存  款[%s%-30s%s]\n",
                HBBLU HIY,MONEY_D->money_str(balance), NOR );
        
      }
        else      
       {
        
        line += sprintf( " 性 别[%s%6s%s]",
                HBBLU HIG, ob->query("gender"), NOR );
               line += sprintf(NOR"师 承[%s%-10s%s%s",
               HBBLU HIW,"还未拜师", NOR,"]" );
               line += sprintf(NOR"存  款[%s%-30s%s]\n",
                HBBLU HIY,MONEY_D->money_str(balance), NOR );
        
   
      }
   
        line += sprintf( " 种 类[%s%6s%s]",
                HBBLU HIG, ob->query("race"), NOR );
                   line += sprintf(NOR" 神  [%s%-10d%s]",
                HBBLU HIW, ob->query("shen"), NOR );
               
               line += sprintf(NOR"生  日[%s%-30s%s]\n",
                HBBLU HIY,CHINESE_D->chinese_date((int)ob->query("birthday") -14*365*24*60*60), NOR );
         
           line += sprintf( " 年 龄[%s%6s%s%s",
               HBBLU HIG,chinese_number(ob->query("age")),NOR, "]" );               
        
               line += sprintf(NOR"婚 否[%s%-10s%s%s",
                   HBBLU HIW,(ob->query("couple/have_couple") != 0)?"已婚":"未婚",NOR, "]" );
               line += sprintf(NOR"IP地址[%s%-30s%s]\n",
                HBBLU HIY,query_ip_number(ob), NOR );
           
        if( objectp(weapon = ob->query_temp("weapon")) )
                skill_type = weapon->query("skill_type");
        else
                skill_type = "unarmed";

       attack_points = COMBAT_D->skill_power(ob, skill_type, SKILL_USAGE_ATTACK);
        parry_points = COMBAT_D->skill_power(ob, skill_type, SKILL_USAGE_DEFENSE);
        dodge_points = COMBAT_D->skill_power(ob, "dodge", SKILL_USAGE_DEFENSE);

       line += sprintf( " 臂 力[%s %4s %s]",
                 HBRED HIY, display_attr(my["str"], ob->query_str()), NOR );
      
        line += "精 神[" + tribar_graph(my["jing"], my["eff_jing"], my["max_jing"], HBMAG, HIY ,HIY)
                + sprintf( "]",NOR);
             line += sprintf(NOR"值[%s%s%7d/ %7d %s(%4d%%)"NOR"%s\n",
                HBBLU,status_color(my["jing"], my["eff_jing"]), my["jing"], my["eff_jing"],
                status_color(my["eff_jing"], my["max_jing"]),   my["eff_jing"] * 100 / my["max_jing"],"]"
                );
        line += sprintf( " 根 骨[%s %4s %s]",
                HBRED HIY, display_attr(my["con"], ob->query_con()), NOR );
       
        line += "气 血[" + tribar_graph(my["qi"], my["eff_qi"], my["max_qi"], HBMAG, HIY ,HIY)
                + sprintf( "]",NOR);
             line += sprintf(NOR"值[%s%s%7d/ %7d %s(%4d%%)"NOR"%s\n",
                HBBLU,status_color(my["qi"], my["eff_qi"]), my["qi"], my["eff_qi"],
                status_color(my["eff_qi"], my["max_qi"]),       my["eff_qi"] * 100 / my["max_qi"],"]"
                );
 line += sprintf( " 悟 性[%s %4s %s]",
                HBRED HIY, display_attr(my["int"], ob->query_int()), NOR );
       
        line += "精 力[" + tribar_graph(my["max_jingli"], jin_li, jin_li, HBMAG, HIY ,HIY)
                + sprintf( "]",NOR);
                
            line += sprintf(NOR"值[%s%s%7d/ %7d (+%4d)"NOR"%s\n",
                HBBLU ,status_color(my["jingli"], my["max_jingli"]),    my["jingli"], my["max_jingli"],
                my["jiajing"] ,"]");
                

         line += sprintf( " 身 法[%s %4s %s]",
                HBRED HIY, display_attr(my["spi"], ob->query_dex()), NOR );
        
        line += "内 力[" + tribar_graph(my["max_neili"], nei_li, nei_li, HBMAG, HIY ,HIY)
                + sprintf( "]",NOR);
             line += sprintf(NOR"值[%s%s%7d/ %7d (+%4d)"NOR"%s\n",
                HBBLU,status_color(my["neili"], my["max_neili"]),       my["neili"], my["max_neili"],
                my["jiali"],"]" );
        
        
        
        if( my["food"] * 100 / ob->max_food_capacity() >= 90 ) str = HIC+"很饱";
        else if( my["food"] * 100 / ob->max_food_capacity() >= 50 ) str = HIC+"正常";
        else if( my["food"] * 100 / ob->max_food_capacity() >= 20 ) str = HIC+"缺食";
        else str = HIC + "饥饿";
        
        line += sprintf( " 容 貌[%s %4s %s]",
                HBRED HIY, my_per, NOR );
        line += "食 物[" + tribar_graph(my["food"], ob->max_food_capacity(),
                ob->max_food_capacity(), HBMAG, HIY ,HIY)
                + sprintf( "]", NOR );  
                 
                 line += sprintf(NOR"值[%s%s%7d/ %7d %-14s"NOR"%s\n",
                HBBLU ,status_color(my["food"], ob->max_food_capacity()),
        my["food"], ob->max_food_capacity(),str,"]" );
                      
        line += sprintf( " 福 缘[%s %4s %s]",
                HBRED HIY, my_kar, NOR );

        if( my["water"] * 100 / ob->max_water_capacity() > 60 ) str = HIC + "正常";
        else if( my["water"] * 100 / ob->max_water_capacity() > 30 ) str = HIC + "缺水";
        else str = HIC + "饥渴";

        line += "饮 水[" + tribar_graph(my["water"], ob->max_water_capacity(),
                ob->max_water_capacity(), HBMAG, HIY ,HIY)
                + sprintf( "]", NOR );
                  line += sprintf(NOR"值[%s%s%7d/ %7d %-14s"NOR"%s\n",
                HBBLU ,status_color(my["water"], ob->max_water_capacity()),
        my["water"], ob->max_water_capacity(), str, "]" );
        


        line += sprintf( " 杀 生[%s %4d %s]",
                HBBLU HIR, (my["MKS"] + my["PKS"]), NOR );
               line += sprintf(NOR"潜 能[%s%20d%s%s",
               HBBLU HIG,((int)ob->query("potential") - (int)ob->query("learned_points")),NOR, "]" );
               line += sprintf(NOR"攻[%s%15d(+%6d)"NOR"%s\n",
               HBBLU HIG,attack_points/20 + 1, ob->query_temp("apply/damage"), "]" );
        
       
        
          line += sprintf( " 杀 人[%s %4d %s]",
                HBBLU HIR, my["PKS"], NOR );
               line += sprintf(NOR"经 验[%s%20d%s%s",
               HBBLU HIG,my["combat_exp"], NOR,"]" );
               line += sprintf(NOR"防[%s%15d(+%6d)"NOR"%s\n",
               HBBLU HIG,(dodge_points/100 + (weapon? parry_points: 
               (parry_points/200)))/20 + 1, ob->query_temp("apply/armor"), "]" );   
               
             line += sprintf( " 死 亡[%s %4d %s]",
                HBBLU HIR, my["DIED"], NOR ); 
             
        line += sprintf( "评 价[%s %18s %s]",
                HBBLU HIG, ob->query("score")+"", NOR );

     line += sprintf(NOR "威 望[%s %19s %s]\n",
                HBBLU HIG, ob->query("weiwang")+"", NOR );

           
       line += sprintf(NOR+" %s在浴血重生已经度过了:"+NOR+HIW"%s "+NOR",你的性格是:"+NOR+HIW"%s\n\n"+NOR,ob==me?"你":ob->name(1),FINGER_D->age_string( (int)ob->query("mud_age")),(string)ob->query("character"));     

        line += HBBLU YEL"≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡≡\n\n"NOR;
  
       write(line+BBLK);
        return 1;
 }

string display_attr(int gift, int value)
{
        if( value > gift ) return sprintf( HIY "%4d", value );
        else if( value < gift ) return sprintf( HIC "%4d", value );
        else return sprintf("%3d", value);
}


string status_color(int current, int max)
{
        int percent;

        if( max ) percent = current * 100 / max;
        else percent = 100;

        if( percent > 100 ) return HIG;
        if( percent >= 90 ) return HIC;
        if( percent >= 60 ) return HIY;
        if( percent >= 30 ) return YEL;
        if( percent >= 10 ) return HIR;
        return RED;
}

string tribar_graph(int val, int eff, int max, string bcolor, string fcolor, string dcolor)
{
        string ret;
        int i, n, eff_n, max_n = 20;

        if( max == 0 ) max = 1;
        n = val * 100 / max / 5;
        eff_n = eff * 100 / max / 5;

        if( n < 0 ) n = 0;
        if( eff_n < 0 ) eff_n = 0;
        if( n > max_n ) n = max_n;
        if( eff_n > max_n ) eff_n = max_n;
        ret = NOR  + bcolor + fcolor ;
        for( i = 0 ; i < max_n; i ++ ) {
                if( i > eff_n ) ret += dcolor;
                if( i < n )  ret += "0";
                else ret += HBMAG HIW"-"NOR;
        }
        ret += fcolor + NOR ;
        return ret;
}

int help(object me)
{
        write(@HELP
指令格式：score
          score <对象名称>      （巫师专用）
显示自己或者指定对象（含怪物）的基本资料。此指令可以“sc”代替。

相关讯息：hp
HELP
        );
        return 1;
}

