inherit F_CLEAN_UP;
 
int main(object me)
{
        object ob,area;
       mixed dir,file;
       string *names;
       string line="";
       int i;

line += sprintf("%10s %15s %15s %10s %10s\n","城主","城市名","人口","税率","总开发度");
line += "------------------------------------------------------------------\n";
 
      dir=get_dir("/data/city/");
       if(!dir) return notify_fail("目前还没有城市。\n");
        
        for(i=0;i<sizeof(dir);i++)
      if( sscanf(dir[i], "%s.o", file) ) {
      area=new("/clone/room/area1.lpc");
      area->create(file);
      if(area->query("no_use"))
   {
      destruct(area);

      continue;
    } 
     if(area->query("owner"))  
      {
  line += sprintf("%10s%15s%15d %10d %10d\n",area->query("owner"),area->query("short"),area->query("people"), 
area->query("tax"),area->query("farm")+area->query("trade")+area->query("defendance")); 
     destruct(area);
     }
     }     
me->start_more(line);
 return 1;
}
int help(object me)
{
        write(@HELP
察看地盘数。
HELP
    );
    return 1;
}

