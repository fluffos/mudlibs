inherit F_CLEAN_UP;

mapping places=([
"bt" : "/d/baituo/dating.c",
//"ft" : "/d/feitian/guangchang.c",
"gm": "/d/gumu/shengou.c",
"mr": "/d/mr/xiaoshe.c",
"bj": "/d/city2/wenmiao.c",
"yz" : "/d/city/kedian.c",
"lj" : "/d/lingjiu/damen.c",
"sl" : "/d/shaolin/guangchang1.c",
"shushan" : "/d/shushan/yingketing.c",
"wd" : "/d/wudang/sanqingdian.c",
"xy" : "/d/xiaoyao/qingcaop.c",
"xx" : "/d/xingxiu/xxh2.c",
"hs" : "/d/huashan/square.c",
"xs" : "/d/xueshan/dadian.c",
"kl" : "/d/gaochang/room63.c",
"th" : "/d/taohua/haitan.c",
"ny" : "/d/nanyang/nanyang.c",
"qz" : "/d/quanzhou/zhongxin.c",
"cd" : "/d/city3/guangchang.c",
"ca" : "/d/changan/ca.c",
"xyang" : "/d/xiangyang/guangchang.c",
"yd" : "/d/yandang/jiedao.c",
"dl" : "/d/dali/guangchang.c",
"wdj": "/d/wudujiao/dating.c",
"em" : "/d/emei/guangchang.c",
"kf" : "/d/kaifeng/eastx.c",
"mj" : "/d/mingjiao/guangchang1",
"lx" : "/d/lingxiao/shanya",
"xh" : "/d/longmen/xiaolu3",
"hn"  :  "/d/hainan/baiyunan",
"hm"  :  "/d/heimuya/road1",
"ts"  :  "/d/taishan/daizong",
"qzj"  :  "/d/quanzhen/guangchang",
//"slj": "/d/shenlong/haitan",
//"ct":"/d/kaifeng/chengmen",
//"tc":"/d/tongchi/damen",
//"cx":"/d/cxwxm/damen",
//"xkd":"/d/xiakedao/neiting",

]);

int main(object me,string arg)
{
object room,ob,*obj;
    string msg;
        int i;
   if( !arg ) return notify_fail("你要去哪里？\n");
if (!stringp(places[arg]))  return notify_fail("你要去哪里？\n"); 
    
if( me->query("temp/insert"))
{
    return notify_fail("关键说道：“请取出你的会员卡（pull card）再飞吧。”\n");
}

//if (!stringp(places[arg]) && arg != "home")  return notify_fail("你要去哪里？\n");
if (!wizardp(me) && me->is_busy()) 
          return notify_fail("你上一个动作还没有完成,无法穿越时空之门！\n"); 

if (me->is_fighting())
         return notify_fail("战斗中无法穿越时空之门！\n");

if (me->is_busy())
		return notify_fail("你现在正忙着呢。\n");

if(me->is_ghost())
return notify_fail("鬼魂到处乱飞,会吓着人的！\n"); 

if( file_size("d/" + "party/" + me->query("partyid") + "/dating.c") <= 0 && arg == "home")                       
return notify_fail("你还没有加入任何帮派。\n");  
//if  (!environment(me)->query("outdoors"))
//       return notify_fail("这里不允许飞的！\n");
    if  (environment(me)->query("no_fly"))
      return notify_fail("这里不允许飞的！\n");
            
  if (present("biao yin",me)) return notify_fail("你身上带着镖银，无法穿越时空之门！\n");

   
  obj=deep_inventory(me);
     for (i=0;i<sizeof(obj);i++)         if (obj[i]->id("illicit salt"))
         return notify_fail("你身上带着私盐，无法穿越时空之门！\n");
   ob=first_inventory(me);
  if( stringp(msg = me->query("env/msg_mout")) )
      {if (msg!="") message_vision(msg+"\n", me);}
 
  else message_vision(HIR+"只见一阵烟雾过後，$N的身影已经不见了。\n"+NOR, me);
if(arg=="home")
me->move("d/" + "party/" + me->query("partyid") + "/dating.c");  
else {
if (!room=find_object(places[arg]) )
room=load_object(places[arg]);
    me->move(room);
}
    if( stringp(msg = me->query("env/msg_min")) )
       {if (msg!="") message_vision(msg+"\n", me);}
    else 
        message_vision(HIR+"$N的身影突然出现在一阵烟雾之中。\n"+NOR, me);
    me->receive_damage("jing", 10);
    return 1;
}

int help(object me)
{
        write(@HELP

指令格式：fly [地点]

这个指令能让你直接到达一些常用的地方。
扬州(yz)    少林寺(sl)    白驼山(bt)    
北京(bj)    昆仑(kl)      华山(hs)      
武当山(wd)  泰山(ts)      逍遥派(xy)  
星宿海(xx)  雪山寺(xs)    五毒教(wdj) 
泉州(qz)    灵鹫宫(lj)      黑木涯(hm) 
明教(mj)    长安(ca)      峨嵋派(em)    
大理(dl)    桃花岛(th)    古墓派(gm)  
襄阳(xyang) 成都 (cd)     海南剑派(hn) 
血河(xh)    全真教(qzj)   雁荡山派(yd)
  


HELP

 );
        return 1;
}



