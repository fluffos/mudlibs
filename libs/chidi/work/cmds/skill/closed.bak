// closed.c

#include <ansi.h>

inherit F_CLEAN_UP;

#define PERIOD          2000
#define PERIOD_POT      2000000

int clossing(object me);
int halt_closing(object me);

void create() { seteuid(getuid()); }

int main(object me, string arg) {
	int exercise_cost;
	int i;
	string *skills;
	mapping all_skills;
	object where;

	seteuid(getuid());
	where = environment(me);
	
	if (where->query("pigging"))
		return notify_fail("你还是专心拱猪吧！\n");

/*
	if (! ultrap(me))
		return notify_fail("你还没有到大宗师的境界，还是好好学习锻炼吧。\n");
*/
	
	if (me->query_skill("unarmed",1)<2000)
return notify_fail("你拳脚基础太差，闭关恐怕领悟不到什么！\n");
if (me->query_skill("dodge",1)<2000)
return notify_fail("你轻功基础太差，闭关恐怕领悟不到什么！\n");
if (me->query_skill("force",1)<2000)
return notify_fail("你内功基础不够，闭关恐怕领悟不到什么！\n");
if (me->query_skill("literate",1)<3000)
return notify_fail("你书读得太少了，闭关恐怕领悟不到什么！\n");

if (me->query("zhuanshi/times") < 4)
		return notify_fail("闭关修炼必须达到4次转世！\n");
if (me->query("jh_dj/dj") < 10)
		return notify_fail("你的人物等级还没有10级，加油练吧！\n");


	all_skills=me->query_skills();
	skills=keys(all_skills);          
	for(i=0;i<sizeof(skills);i++) 
	{


if(this_player()->query_skill(skills[i],1) >= (20000+this_player()->query("jh_dj/dj")*100) && skills[i] !="literate" && skills[i] !="force")
		
			return notify_fail("你的技能等级达到上限，闭关修行对你没什么效果了。\n");
	}

	if (me->query("doing")=="closed")
		return notify_fail("你已经在闭关修炼了！\n");

	if (! where->query("no_fight"))
		return notify_fail("在这里闭关？不太安全吧？\n");

	if (! where->query("sleep_room"))
		return notify_fail("你得找一个能够休息的地方闭关。\n");

	if (me->is_busy())
		return notify_fail("你现在正忙着呢。\n");

	if (me->query("potential")  < 2000000)
		return notify_fail("你的潜能不够，没法闭关修行。\n");

	if ((int)me->query("combat_exp") < 20000000)
		return notify_fail("你觉得实战经验颇有不足，看来目前还难以进行长时间的闭关修炼。\n");
	if ((int)me->query("max_neili") < 500000)
		return notify_fail("你觉得内力颇有不足，看来目前还难以进行长时间的闭关修炼。\n");
	if ((int)me->query("max_jingli") < 50000)
		return notify_fail("你觉得精力颇有不足，看来目前还难以进行长时间的闭关修炼。\n");

	message_vision("$N盘膝坐下，开始冥神运功，闭关修行。\n", me);
	me->set("startroom", base_name(where));
	me->set("doing", "closed");
	CLOSE_D->user_closed(me, "closed");
	me->start_busy(bind((:call_other, __FILE__, "closing" :), me),
	bind((:call_other, __FILE__, "halt_closing" :), me));
	CHANNEL_D->do_channel(this_object(), "rumor",
		sprintf("大宗师%s(%s)开始闭关修行。", me->name(1), me->query("id")));

	return 1;
}

int continue_closing(object me) {
	me->start_busy(bind((:call_other, __FILE__, "closing" :), me),
		bind((:call_other, __FILE__, "halt_closing" :), me));
	CLOSE_D->user_closed(me);
	tell_object(me, HIR "\n你继续闭关...\n" NOR);
	return 1;
}

int filter_skill(string sk, object me) {
	if (me->query_skill(sk, 1) < 200 || ! me->can_improve_skill(sk))
		return 0;
	if (SKILL_D(sk)->type() != "martial")
		return 0;
	if (SKILL_D(sk)->valid_enable("force"))
		return 1;
	if (SKILL_D(sk)->valid_enable("dodge") )
		return 1; 
	if (SKILL_D(sk)->valid_enable("parry") )
		return 0;
	return 1;
}

int closing(object me) {
	int t;
	int tn;
	int pot;
	int r;
	int i;
	int exp_inc;
	string *ks;
	string *skills;
	mapping all_skills;
	object ob;

	if ( me->query("potential")<= 200000)
	{
		tell_object(me, "你的潜能耗尽了。\n");
		message_vision("$N睁开双目，缓缓吐了一口气，站了起来。\n", me);
		CLOSE_D->user_opened(me);
		CHANNEL_D->do_channel(this_object(), "rumor",
		sprintf("听说%s(%s)闭关功德圆满。",
		me->name(1), me->query("id")));
		if (! interactive(me)) {
			me->force_me("chat* haha");
			call_out("user_quit", 0, me);
		}
		if ((ob = present("huanyu tianzhu", me)))
		                             destruct(ob);
		return 0;
	}
	if (present("huanyu tianzhu", me))
		me->add("learned_points", 46); 
	else  me->add("learned_points", 23);

	t = me->query_temp("last_closing");
	tn = time();
	if (tn - t < 0)
	{
		me->set_temp("last_closing", tn);
		return 1;
	}

	if (present("huanyu tianzhu", me))
	{
		if (tn - t < PERIOD/9*7)
		{
			return 1;
		}			
	}
	else if (tn - t < PERIOD)
	{
		return 1;
	}


	me->set_temp("last_closing", tn);
	pot=PERIOD_POT / 2 + random(PERIOD_POT);
	if ((me->query("potential")-pot)<0) pot=me->query("potential");
		me->add("potential", -pot);

	if (random(6) == 4)
		tell_object(me, "闭关修炼中...\n");


	if (random(100) < 33)
	{
		tell_object(me, HIR "你对内功有所领悟，感到内力进步了！\n" NOR);          
		me->add("max_neili", 300+ random(200));
	}
	if (random(100) < 33)
	{
		tell_object(me, HIM "你对神通有所领悟，感到精力进步了！\n" NOR);        
		me->add("max_jingli", 100+ random(200));
	}

	if (me->query_skill("jiuzhuan-12tian",1) > 30000)
	{
		tell_object(me, HIM "你的[阴阳九转十二天]已经到达上限，没办法再成长了！\n" NOR);
		me->set_skill("jiuzhuan-12tian", (int)me->query_skill("jiuzhuan-12tian",1) - 1);
	}

	if (me->query_skill("jiuyin-xinjing",1) > 30000)
	{
		tell_object(me, HIM "你的[九阴心经]已经到达上限，没办法再成长了！\n" NOR);
		me->set_skill("jiuyin-xinjing", (int)me->query_skill("jiuyin-xinjing",1) - 1);
	}

	if (me->query_skill("six-finger",1) > 30000)
	{
		tell_object(me, HIM "你的[六脉神剑]已经到达上限，没办法再成长了！\n" NOR);
		me->set_skill("six-finger", (int)me->query_skill("six-finger",1) - 1);
	}
	exp_inc = 5000 + random(1000);
	exp_inc = exp_inc * (100 + me->query_skill("force", 1)) / 500;
	exp_inc = exp_inc * (100 + me->query("int")) / 10000;
	me->add("combat_exp", exp_inc);

	all_skills=this_player()->query_skills();
	skills=keys(all_skills);          
	for(i=0;i<sizeof(skills);i++) 
	{
		if(SKILL_D(skills[i])->invalid_closed(me))	continue;

if(this_player()->query_skill(skills[i],1) >= (20000+this_player()->query("jh_dj/dj")*100) && skills[i] !="literate" && skills[i] !="force")
		
		{
			message_vision("$N睁开双目，缓缓吐了一口气，站了起来。\n", me);
			CLOSE_D->user_opened(me);
			CHANNEL_D->do_channel(this_object(), "rumor",
				sprintf("听说%s(%s)闭关功德圆满。",
				me->name(1), me->query("id")));
			if (! interactive(me)) {
				me->force_me("chat* haha");
				call_out("user_quit", 0, me);
			}
			if ((ob = present("huanyu tianzhu", me)))
				destruct(ob);
			tell_object(me, HIR "你的技能等级达到上限了，快去升级吧。\n" NOR);
			return 0;
		}

		this_player()->set_skill(skills[i],all_skills[skills[i]]+50);
	} 
	tell_object(me, HIY "你对自己的各项技能有所感悟。\n" NOR);
	return 1;
}

int halt_closing(object me) 
{
	object ob;
	CLOSE_D->user_opened(me);
	tell_object(me, "你中止了闭关。\n");
	message_vision(HIY "$N" HIY "大喝一声，睁开眼来，一股气流登时将众人迫退四步。\n\n" NOR, me);
	me->add("potential", -(me->query("potential") / 10));
	CHANNEL_D->do_channel(this_object(), "rumor", "听说" + me->name(1) + "闭关中途突然复出。");
		 if (ob = present("huanyu tianzhu", me))
				destruct(ob);
	return 1;
}

private void user_quit(object me) {
	if (! objectp(me) || interactive(me))
		return;
	me->force_me("quit");
}

int help(object me) {
	write(@HELP
指令格式 : closed

闭关修行（高手必经之路）。要求:
找个安全并且可以休息的地方才能闭关，闭关前需要有200万点潜能，2亿经验，
必须通元婴，通任督二脉，成为宗师。基本内功，轻功，拳脚要求2000级以上，
读书写字要求3000级以上，必需为4次转世等级达到10级以上。闭关开始以后，
玩家离线以后其角色将仍然在线修行，直到玩家中止闭关(halt)或是潜能耗尽。
期间内玩家的经验、技能、内力将会提升。

HELP );
	return 1;
}