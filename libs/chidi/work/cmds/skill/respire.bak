#include <ansi.h>
inherit F_SSERVER;
void create() { seteuid(getuid()); }

int main(object me, string arg)
{
     int lvl,poison,damage;
     string effect,who,str;
     object target,weapon;

     lvl=(int)me->query_skill("force");

     if((int)me->query("perform/peak")<100)
        return notify_fail("你还未达到可以自由控制体内息的境界！\n");
     if ((int)me->query("neili")<50000 || (int)me->query("jingli")<50000 )
        return notify_fail("你的内力或者精力不够！\n");
     if(me->is_busy())
     return notify_fail("你正忙着呢！\n"); 

     if(!arg)  
     return notify_fail("命令格式:respire <recover||heal||poison||break> <target>");

     if(sscanf(arg,"%s %s",effect,who)==2
        && !objectp(target= present(who, environment(me))))
     return notify_fail("这里现在好象没有这个人。\n"); 

     if(objectp(target) && !target->is_character()) 
     return notify_fail("看清楚些，那是活物吗？\n");

     if(objectp(target) && (effect=="recover" || effect=="heal" || effect=="poison"))
     return notify_fail("你无法对他人使用内息的这一功能！\n");  

     if( (int)me->query("neili") < 500 ) 
     return notify_fail("你的真气不够。\n");

     if(!target)
      effect=arg;

     if( me->is_fighting() && effect!="recover" && effect!="break")
     return notify_fail("先把你的对手打发掉吧。\n");    

     switch(effect)
     {
      case "poison":
        str=HIM"$N将内息调匀，缓缓地将一股柔和的真气运行于$N的周身。\n" NOR;
        if(me->query_condition("hunyuan_hurt"))
        {
         poison=me->query_condition("hunyuan_hurt");
         poison=poison-random(lvl*2);
         if(poison>0)
         {
          str+=HIM"过了一小会儿，$N脸上留下斗大的汗珠，$N身上的"NOR
               +HIR"混元无极"NOR+HIM"伤势好了小半.....\n"NOR;
          me->apply_condition("hunyuan_hurt", poison);
         } else
         {
          str+=HIW"$N缓缓的呼出一口气，如释重负，看来$N身上的"NOR
              +HIR"混元无极"NOR+HIW"伤势已经全好了！\n"NOR;
          me->clear_condition("hunyuan_hurt");
          }
         me->start_busy(3+random(5));
         me->add("neili",-200);
         message_vision(str,me);    
        } else   
        if(me->query_condition("jy_poison"))
        {
         poison=me->query_condition("jy_poison");
         poison=poison-random(lvl*2);
         if(poison>0)
         {
          str+=HIM"过了一小会儿，$N脸上留下斗大的汗珠，$N身上的"NOR
               +HIR"九阴白骨爪毒"NOR+HIM"解去了小半.....\n"NOR;
          me->apply_condition("jy_poison", poison);
         } else
         {
          str+=HIW"$N缓缓的呼出一口气，如释重负，看来$N身上的"NOR
              +HIR"九阴白骨爪毒"NOR+HIW"已经毒性全解了！\n"NOR;
          me->clear_condition("jy_poison");
         }
         me->start_busy(3+random(5));
         me->add("neili",-200);
         message_vision(str,me);    
        } else
        if(me->query_condition("xx_poison"))
        {
         poison=me->query_condition("xx_poison");
         poison=poison-random(lvl/2);
         if(poison>0)
         {
          str+=HIM"过了一小会儿，$N脸上留下斗大的汗珠，$N身上的"NOR
               +HIR"星宿掌毒"NOR+HIM"解去了小半.....\n"NOR;
          me->apply_condition("xx_poison", poison);
         } else
         {
          str+=HIW"$N缓缓的呼出一口气，如释重负，看来$N身上的"NOR
              +HIR"星宿掌毒"NOR+HIW"已经毒性全解了！\n"NOR;
          me->clear_condition("xx_poison");
         }
         me->start_busy(3+random(5));
         me->add("neili",-200);
         message_vision(str,me);    
        } else
        if(me->query_condition("wudu_poison"))
        {
         poison=me->query_condition("wudu_poison");
         poison=poison-random(lvl/2);
         if(poison>0)
         {
          str+=HIM"过了一小会儿，$N脸上留下斗大的汗珠，$N身上的"NOR
               +HIR"五毒之气"NOR+HIM"解去了小半.....\n"NOR;
          me->apply_condition("wudu_poison", poison);
         } else
         {
          str+=HIW"$N缓缓的呼出一口气，如释重负，看来$N身上的"NOR
              +HIR"五毒之气"NOR+HIW"已经毒性全解了！\n"NOR;
          me->clear_condition("wudu_poison");
         }
         me->start_busy(3+random(5));
         me->add("neili",-200);
         message_vision(str,me);    
        } else
if(me->query_condition("chanchu_poison"))
        {
         poison=me->query_condition("chanchu_poison");
         poison=poison-random(lvl/2);
         if(poison>0)
         {
          str+=HIM"过了一小会儿，$N脸上留下斗大的汗珠，$N身上的"NOR
               +HIR"蟾蜍毒"NOR+HIM"解去了小半.....\n"NOR;
          me->apply_condition("chanchu_poison", poison);
         } else
         {
          str+=HIW"$N缓缓的呼出一口气，如释重负，看来$N身上的"NOR
              +HIR"蟾蜍毒"NOR+HIW"已经毒性全解了！\n"NOR;
          me->clear_condition("chanchu_poison");
         }
         me->start_busy(3+random(5));
         me->add("neili",-200);
         message_vision(str,me);    
        } else
if(me->query_condition("fire_poison"))
        {
         poison=me->query_condition("fire_poison");
         poison=poison-random(lvl/2);
         if(poison>0)
         {
          str+=HIM"过了一小会儿，$N脸上留下斗大的汗珠，$N身上的"NOR
               +HIR"火毒"NOR+HIM"解去了小半.....\n"NOR;
          me->apply_condition("fire_poison", poison);
         } else
         {
          str+=HIW"$N缓缓的呼出一口气，如释重负，看来$N身上的"NOR
              +HIR"火毒"NOR+HIW"已经毒性全解了！\n"NOR;
          me->clear_condition("fire_poison");
         }
         me->start_busy(3+random(5));
         me->add("neili",-200);
         message_vision(str,me);    
        } else
if(me->query_condition("xuecan_poison"))
        {
         poison=me->query_condition("xuecan_poison");
         poison=poison-random(lvl/2);
         if(poison>0)
         {
          str+=HIM"过了一小会儿，$N脸上留下斗大的汗珠，$N身上的"NOR
               +HIR"寒毒"NOR+HIM"解去了小半.....\n"NOR;
          me->apply_condition("xuecan_poison", poison);
         } else
         {
          str+=HIW"$N缓缓的呼出一口气，如释重负，看来$N身上的"NOR
              +HIR"寒毒"NOR+HIW"已经毒性全解了！\n"NOR;
          me->clear_condition("xuecan_poison");
         }
         me->start_busy(3+random(5));
         me->add("neili",-200);
         message_vision(str,me);    
        } else
if(me->query_condition("flower_poison"))
        {
         poison=me->query_condition("flower_poison");
         poison=poison-random(lvl/2);
         if(poison>0)
         {
          str+=HIM"过了一小会儿，$N脸上留下斗大的汗珠，$N身上的"NOR
               +HIR"断肠花毒"NOR+HIM"解去了小半.....\n"NOR;
          me->apply_condition("flower_poison", poison);
         } else
         {
          str+=HIW"$N缓缓的呼出一口气，如释重负，看来$N身上的"NOR
              +HIR"断肠花毒"NOR+HIW"已经毒性全解了！\n"NOR;
          me->clear_condition("flower_poison");
         }
         me->start_busy(3+random(5));
         me->add("neili",-200);
         message_vision(str,me);    
        } else
if(me->query_condition("snake_poison"))
        {
         poison=me->query_condition("snake_poison");
         poison=poison-random(lvl/2);
         if(poison>0)
         {
          str+=HIM"过了一小会儿，$N脸上留下斗大的汗珠，$N身上的"NOR
               +HIR"蛇毒"NOR+HIM"解去了小半.....\n"NOR;
          me->apply_condition("snake_poison", poison);
         } else
         {
          str+=HIW"$N缓缓的呼出一口气，如释重负，看来$N身上的"NOR
              +HIR"蛇毒"NOR+HIW"已经毒性全解了！\n"NOR;
          me->clear_condition("snake_poison");
         }
         me->start_busy(3+random(5));
         me->add("neili",-200);
         message_vision(str,me);    
        } else
if(me->query_condition("yufeng_poison"))
        {
         poison=me->query_condition("yufeng_poison");
         poison=poison-random(lvl/2);
         if(poison>0)
         {
          str+=HIM"过了一小会儿，$N脸上留下斗大的汗珠，$N身上的"NOR
               +HIR"玉蜂针毒"NOR+HIM"解去了小半.....\n"NOR;
          me->apply_condition("yufeng_poison", poison);
         } else
         {
          str+=HIW"$N缓缓的呼出一口气，如释重负，看来$N身上的"NOR
              +HIR"玉蜂针毒"NOR+HIW"已经毒性全解了！\n"NOR;
          me->clear_condition("yufeng_poison");
         }
         me->start_busy(3+random(5));
         me->add("neili",-200);
         message_vision(str,me);    
        } else
if(me->query_condition("zhua_poison"))
        {
         poison=me->query_condition("zhua_poison");
         poison=poison-random(lvl/2);
         if(poison>0)
         {
          str+=HIM"过了一小会儿，$N脸上留下斗大的汗珠，$N身上的"NOR
               +HIR"凝血神抓"NOR+HIM"解去了小半.....\n"NOR;
          me->apply_condition("zhua_poison", poison);
         } else
         {
          str+=HIW"$N缓缓的呼出一口气，如释重负，看来$N身上的"NOR
              +HIR"凝血神抓"NOR+HIW"已经毒性全解了！\n"NOR;
          me->clear_condition("zhua_poison");
         }
         me->start_busy(3+random(5));
         me->add("neili",-200);
         message_vision(str,me);    
        } else

        if(me->query_condition("ice_poison"))
        {
         poison=me->query_condition("ice_poison");
         poison=poison-random(lvl/2);
         if(poison>0)
         {
          str+=HIM"过了一小会儿，$N脸上留下斗大的汗珠，$N身上的"NOR
               +HIR"寒冰掌毒"NOR+HIM"解去了小半.....\n"NOR;
          me->apply_condition("ice_poison", poison);
         } else
         {
          str+=HIW"$N缓缓的呼出一口气，如释重负，看来$N身上的"NOR
              +HIR"寒冰掌毒"NOR+HIW"已经毒性全解了！\n"NOR;
          me->clear_condition("ice_poison");
         }
         me->start_busy(3+random(5));
         me->add("neili",-200);
         message_vision(str,me);  
        } else
        write("你试图用内息解毒，可是看不出中了什么毒！\n");
        break;

      case "heal":
        if(me->is_fighting())
        {
         write("等打完架了再说吧！\n");
         break;
        } else
        if(me->query("eff_qi") < me->query("max_qi") ||
           me->query("eff_jing") < me->query("max_jing"))
        {
        str=MAG"$N将内息调匀，缓缓地将一股柔和的真气运行于$N的周身。\n"NOR;
        str+=MAG"过了一会儿，$N睁开眼睛，全身伤势大为好转！\n"NOR;
        if(me->query("eff_qi") < me->query("max_qi"))
         me->set("eff_qi",me->query("max_qi"));
        if(me->query("eff_jing") < me->query("max_jing"))
        me->set("eff_jing",me->query("max_jing"));  
        if(me->query("eff_qi") > me->query("max_qi"))
        me->set("eff_qi",me->query("max_qi"));
        if(me->query("eff_jing") > me->query("max_jing"))
        me->set("eff_jing",me->query("max_jing"));       
        me->add("neili",-100);
        me->start_busy(1+random(2));
        message_vision(str,me);  
        } else
        write("你的伤势都好啦，不用浪费内息了！\n");
        break;

      case "recover":
          if( me->query("qi") < me->query("eff_qi") ||
              me->query("jing") < me->query("eff_jing"))
          {
          me->add("neili",-(me->query("eff_qi")
                  -me->query("qi"))/10);
          me->set("qi",me->query("eff_qi"));
          me->set("jing",me->query("eff_jing"));
          me->start_busy(1);
          message_vision(HIG"$N暗运内息，深深地长吸一口气，"
          +"顿时整个人为之一振。\n"NOR,me);
          } else
          write("你现在精气充沛，不需要内息的补充。\n"); 
          break;

      case "break":
          if( me->query_temp("neixi/break" ))
          {
           write("你刚刚使用过“震字诀”，现在内息不够充沛！\n");
           break;
          }
          if( !target ) target = offensive_target(me);
          if(objectp(target) && target->is_fighting(me))
          {
           if(target->is_busy())
           {
            write("对方目前正疲于应付呢，抓紧攻击吧！\n");
            break;
           }
           me->set_temp("neixi/break",1);
           call_out("remove_effect",10,me);
           message_vision(HIW"$N暗运内息，深深地长吸一口气，将一股似柔非"
           +"柔，似刚非刚的真气向$n传了过去。\n"NOR,me,target);
           if(random(me->query("neili") + me->query("neili")*
                     me->query("perform/peak")/100) > target->query("neili")/2)
           {
            if(objectp(weapon=target->query_temp("weapon")))
            {
            message_vision(HIW"只听“喀”的一声，$n手中的"NOR
            +weapon->query("name")+HIW"被$N的这股真气震了个粉碎！\n"NOR,
            me,target);
            target->start_busy(random(2));
            weapon->unequip();
            weapon->move(environment(target));
            weapon->set("name",HIW"震碎的"NOR+weapon->query("name"));
            weapon->set("weapon_prop",0);
            weapon->set("value",0); 
            me->add("neili",-150);
            me->start_busy(1+random(2));
            } else
            {
            message_vision(HIR"$n只觉得一股若有若无的真气从$N的手心直涌过来，"
            +"不禁胸口大震！\n"NOR,me,target);
            damage=me->query("perform/peak")*me->query_skill("force",1);
            damage=damage/100;
            damage=damage/3+random(damage/3);
            target->receive_damage("qi",damage*3/2,me);
            target->receive_wound("qi",damage,me);
            target->start_busy(2+random(me->query("perform/peak")/20));   
            me->add("neili",-damage/3);  
            me->start_busy(1+random(2));
            }
           } else
           {
            message_vision(HIC"好在$n功力深厚，堪堪挡住了$N的这股真气。\n"NOR,
            me,target);
            me->start_busy(2);
            me->add("neili",-100);          
           }
          } else
          write("内息“震字诀”只能对战斗中的对手使用。\n"); 
          break;

      default:
        write("没有这个功能，请查看有关帮助！\n");
    }

        return 1;
}

int remove_effect(object me)
{
        if( objectp(me) && me->query_temp("neixi/break"))
        {
         me->delete_temp("neixi");
         tell_object(me,HIM"你略一调运内息，顿觉真气充盈无比！\n"NOR);
        }
        return 1;
} 



