// abandon.c
inherit F_CLEAN_UP;
int main(object me, string arg)
{
        if ( !arg || arg=="" ) return notify_fail("你要放弃哪一项技能？\n");
        
        if ( !(me->query_skill(arg,1) + me->query_skill_learn(arg)))
                return notify_fail("你并没有学过这项技能。\n");
                
        // edit by feng&jym 增加加密功能
        if ( me->query("ty_jiami") ) 
        {
                write(HIR"您已经执行加密操作了，要想放弃武功请输入您的管理密码：\n"NOR);
                input_to("check_password", 1, me, arg);
                return 1;
        } else
        {       
        if ( !me->delete_skill(arg) )
                return notify_fail("你并没有学过这项技能。\n");
                
        write("你决定放弃继续学习" + to_chinese(arg) + "。\n");
        me->reset_action();
        return 1;
        }

        me->delete("ty_jiami");
        write("你出现操作错误，现在已经清除，请重新使用放弃指令执行放弃武功操作！\n");
        return 1;
}
protected void check_password(string passwd, object me, string arg)
{
         object link_ob;
         string old_pass;
         link_ob = me->query_temp("link_ob");
         old_pass = link_ob->query("ad_password");
           if( crypt(passwd, old_pass)!=old_pass ) {
                   write("您输入的管理密码不正确，不能放弃武功！\n");
                   return;
           }
           if ( !me->delete_skill(arg) )
           {
                   write("你并没有学过这项技能。\n");
                   return;
           }
                
         write("你成功的放弃了" + to_chinese(arg) + "这样武功。\n");
         me->reset_action();
         return;
}

int help()
{
        write(@TEXT
指令格式：abandon/fangqi<技能名称>
放弃一项你所学过的技能，注意这里所说的「放弃」是指将这项技能从你人物
的资料中删除，如果你以后还要练，必须从０开始重练，请务必考虑清楚。
这个指令使用的场合通常是用来删除一些「不小心」练出来的技能，由于每个
人有着不同的天赋，所修习的武功也不会相同。如果样样都学，到头来只会样
样不精。
TEXT
        );
        return 1;
}

