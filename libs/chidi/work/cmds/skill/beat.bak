//充穴系统
//文档：
//当角色等级达到30级后，可以充穴，每5级可充一个穴穴位，每次充穴需要消耗(总穴位个数*8800000)点钱能，针具1套。
//充穴只可按照顺序，角色不冲开穴位，无法继续提升武学，4千级技能后，每50级需要充开一个血位。
//冲开穴位必须，购买一套针具，每次充穴消耗一套，一套针具包括九种银针（蝉针、圆针、堤针、锋针、铍针、圆利针、毫针、长针、大针）
//每充开一个学位提升等级1级，获得技能提升空间50级，每充开一条连贯穴位，获得4项属性加成.
//充穴失败，扣除相应潜能，和针具一套。

#include <ansi.h>

mapping xuewei = ([
	"奇经神脉" :   ({ "然谷","人迎","照海","属兑","晴明","不容","盆缺","冲阳","梁门","交信","解溪","丰隆","足三里","横鼻","阴谷","乳根","气冲","横谷",  }),
	"阴阳神脉" : ({ "巨仓","眉鍝","趟阳","臑俞","飞扬","居繆","天柱","承山","巨繆","承泣","玉枕","昆仑","承光","曲差","五处","风池","掼竹","络却","通天","眉冲","酞仁"  }),
	"经外奇脉" :   ({ "太阳","神聪","耳尖","印堂","腰痛点","鱼腰","球后","二白","八风","金津","定喘","十宣","夹脊","腰奇","玉液","鹤顶","羽明","阑尾","白虫窝","膝眼","胆囊","四缝","八邪", }),
]);

string do_score(object me)
{
	string strin,card,killer;
	int size,i,j,b,cc_len,tmp,index,baoji,index2,index3;
	string line  = "\n┏━━━━━━━━━━━━━━"+HIY"【穴道情况】"NOR"━━━━━━━━━━━━━━━━┓\n";

	for(j=0;j<3;j++)
	{
		switch(j)
		{
			case 0 : killer = "奇经神脉";  index = 38; break;
			case 1 : killer = "阴阳神脉"; index = 56; break;
			case 2 : killer = "经外奇脉";  index = 20; break;
		}

		strin = "/cmds/skill/beat"->query_xue(killer);
		size = sizeof(strin);
		cc_len = me->query(killer)-1;
		tmp = 1;
		card = "";
		if(sizeof(killer) > 9)  killer = killer[0..3]+"神脉";
		line += sprintf("┃"HIY"[%s]"NOR"%64s\n┃",killer,"┃");
		for(i=0;i<size;i++)
		{
			tmp ++;
			baoji = strin[i];
			if(sizeof(baoji) < 5) baoji += "穴";
			if(i > cc_len) card += sprintf("%"+(5+color_len(baoji))+"+s  [未冲]    ",baoji);
			else card += sprintf(HIG"%"+(5+color_len(strin[i]))+"+s  [已冲]    "NOR,baoji);
			if(tmp >= 5)
			{
				card += "┃\n┃";
				tmp = 1;
			}
		}
		line += sprintf("%s%"+index+"s\n",card,"┃");
		index = 10;
		for(b=0;b<size;b++)
		{
			index2 += b/2;
		}
		line += "┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛\n";
		line += sprintf(" [%s] 共"HIR"%d"NOR"级奖励等级,"HIR"%d"NOR"级未奖励,四项属性"HIR"%d X 4"NOR"点属性奖励\n"NOR,
		killer,size,size-(cc_len+1),cc_len<size?index2:0);
		if(j < 2) line += "┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓\n";
	}
	return line;
}

string *query_xue(string arg)
{
	if(!arg) return ({""});
	if(arg != "奇经神脉" && arg != "阴阳神脉" && arg != "经外奇脉") return ({""});
		
	return xuewei[arg];
}

int main(object me,string arg)
{
	object item,ob;
	int meXue,pot,i,size,index,level,xue_level,j;
	string *xue,info;

	if(wizardp(me) && ob = find_player(arg))
	{
		info = do_score(ob);
		if(info) tell_object(me,info);
		return 1;
	}

	if(!me || !objectp(me) || !arg)
	{
		info = do_score(me);
		if(info) tell_object(me,info);
		tell_object(me,HIY" 你要打通什么脉？奇经神脉、阴阳神脉、经外奇脉。 beat <穴道名称>\n"NOR);
		return 1;
	}

	if (!me->query("animaout"))
		return notify_fail("你还没有打通元婴出世，谈什么冲穴？\n");

	if(arg != "奇经神脉" && arg != "阴阳神脉" && arg != "经外奇脉")
	{
		tell_object(me,"你要打通什么脉？\n");
		return 1;
	}
	if(arg == "阴阳神脉")
	{
		size = sizeof(xuewei["奇经神脉"]);
		if(me->query("奇经神脉") < size)
		{
			tell_object(me,"你的奇经神脉还没打通！\n");
			return 1;
		}
	}
	else if(arg == "经外奇脉")
	{
		size = sizeof(xuewei["阴阳神脉"]);
		if(me->query("阴阳神脉") < size)
		{
			tell_object(me,"你的阴阳神脉还没打通！\n");
			return 1;
		}
	}
	if(me->query_level() < 30)
	{
		tell_object(me,"你的等级不足。\n");
		return 1;
	}
	
	if(me->query("zhuanshi/times") < 4)
	{
		tell_object(me,"你还没有4转。\n");
		return 1;
	}
	if((!item = present("zhen-ju",me)) && (!item = present("sky sword",me)) && (!item = present("dragon blade",me)))
	{
		tell_object(me,"你手无利器，如何针对穴位？\n");
		return 1;
	}

	xue = xuewei[arg];
	meXue = me->query(arg);
	size = sizeof(xue);
	level = me->query_level()/5*5-30;
	xue_level = me->query("奇经神脉")+me->query("阴阳神脉")+me->query("经外奇脉")+1;
	pot = xue_level*8800000;

	if(xue_level*5-5 > level)
	{
		tell_object(me,sprintf("充下一个穴位需要%d级以上。\n",30+xue_level*5-5));
		return 1;
	}

	if(me->query("potential",1) < pot)
	{
		tell_object(me,sprintf("你的潜能不足%d点。\n",pot));
		return 1;
	}
	if(meXue >= size)
	{
		tell_object(me,sprintf("你的%s已经打通。\n",arg));
		return 1;
	}

	me->add("potential",-pot);
	tell_object(me,sprintf("砰！一声你手中的%s被体内泄出的真气，震飞！找不见了。\n",item->name()));
	destruct(item);

	if(random(100) < 30)
	{	
		tell_object(me,sprintf(HIG"恭喜！ %s穴 充穴成功。\n恭喜你，等级提升1级。\n"NOR,xue[meXue]));
		
		me->add(arg,1);
		me->add("jh_dj/dj",1); 
		if(me->query("jh_dj/dj") > 150) 
		{ 
			me->delete("jh_dj/dj"); 
			me->add("jh_dj/zhuan",1); 
		} 

		if(me->query(arg) >= size)
		{
			index = 10;
			for(j=0;j<size;j++)
			{
				index += j/2;
			}
			me->add("str",index);
			me->add("con",index);
			me->add("int",index);
			me->add("dex",index);
			//me->add("kar",index);
			//me->add("per",index);
			me->set(arg,size);  //保险
			tell_object(me,sprintf(HIY"恭喜！你的 %s 已通，四项属性加成%d点。\n"NOR,arg,index));
			message("channel:rumor",YEL"【"+arg+"】"BLINK+HIY+me->name()+"通过不懈努力终于将「"+arg+"」的穴位全部打通,获得了四项属性加成"+index+"点。\n"NOR,users());
		}
		else
		{
			message("channel:rumor",YEL"【"+arg+"】"HIY+me->name()+"通过不懈努力将「"+xue[meXue]+"穴」打通了,获得等级提升1级。\n"NOR,users());
		}
	}
	else
	{
		tell_object(me,HIR"很不幸，充穴失败。\n"NOR);
	}
	return 1;
}

int help(object me) {
	write(@HELP

	++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
beat 穴道名称 
具体请输入beat查看3个穴道的名称;
冲穴条件:
1.达到4转或以上
2.人物等级30级以上
3.必须每升5级才能继续冲下一个穴道
4.必须有足够的POT
5.必须按顺序进行

冲穴的好处:
1.可以获得属性加成
2.每次成功冲穴一次人物等级提升1级


++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
HELP );
	return 1;
}