#include "/doc/help.h"
inherit F_CLEAN_UP;

int main(object me, string arg)
{
        string msg,pacth;

if( me->query("temp/insert"))

    return notify_fail("关键说道：“请取出你的会员卡（pull card）再gohome吧。”\n");


        if( me->is_busy() )
                return notify_fail("你的动作还没有完成，不能移动。\n");
        if (me->is_fighting()) return 0;
        if (me->is_ghost()) return 0;

	pacth = sprintf("/data/proom/%s/%sroom.lpc",geteuid(me),geteuid(me));
        if(file_size(pacth) < 0) return notify_fail("请购买 房间包裹(Room box)。\n");
	if(me->query("doing") )  return notify_fail("你在闭关呢。\n");
        if(stringp(msg = me->query("env/msg_home")) ) message_vision(msg + "\n", me);
	if(pacth) me->move(pacth);
        return 1;
}

int help(object me)
{
	write("请购买 房间包裹 Room box 方可使用。\n");
	return 1;
}