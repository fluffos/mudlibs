#include <ansi.h>
inherit F_CLEAN_UP;

int main(object me, string arg) {
  object area;
  string msg, file;
  mixed *dir;
  int i;

  if (NATURE_D->query_dipan_check())
    return notify_fail("请稍侯，目前各地盘正在清点中，请过会查询。\n");

  msg = sprintf(HIC "%-10s%-10s%-8s%-8s%-12s%-16s%8s\n" NOR,
    "地盘", "所属帮会", "    开发度", "   资金度", "   资产(黄金)", "   上日收入(白银)", "   忠诚度");
  msg += "—————————————————————————-----————————————\n";
  dir = get_dir("/data/guild/area/", 0);
  if (!dir) dir = ({});
  area = new("/clone/misc/area");
  for (i = 0; i < sizeof(dir); i++) {
    if (sscanf(dir[i], "%s.o", file) == 1) {
      area->create(file);
      msg += sprintf("%-10s%-16s%-8s%-8s%12s%16s%8s\n",
        file, area->query("banghui") ? area->query("banghui") : "独  立",
        area->query("kaifa") ? (int)area->query("kaifa") + "%" : "---",
        area->query("jizhi") ? (int)area->query("jizhi") + "%" : "---",
        (int)area->query("money") / 10000 + "  两  ",
        (int)area->query("last_money") / 100 + "  两  ",
        (area->query("banghui") == me->query("banghui/name")) ?
        area->query("zhongcheng") + "%" : "---");
    }
  }
  msg += "————————————————————————————————-----—————\n";
  destruct(area);
  msg += "\n";
  me->start_more(msg);
  return 1;
}

int help(object me) {
  write(@HELP
指令格式：dipan
用于显示所有地盘的所属帮会。
HELP
  );
  return 1;
}
