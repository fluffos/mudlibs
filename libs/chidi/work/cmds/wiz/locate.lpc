// locate.c by diabio
inherit F_CLEAN_UP;
object find_env(object ob);
int main(object me, string str) {
  string output = "";
  if (!str) return notify_fail("指令格式: locate <物品>\n");
  me->add("jing", -5);
  output = ("/adm/daemons/questd")->locate_obj(me, str);
  if (output == "")
    return notify_fail("确定不了" + str + "的大概位置。\n");
  write(output);
  return 1;
}
int help(object me) {
  write(@HELP
指令格式: locate <物品>
这个指令是用来得知使命物品的大概位置。
HELP
  );
  return 1;
}
