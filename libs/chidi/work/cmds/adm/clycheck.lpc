//cly 2007-09-17

inherit F_CLEAN_UP;

int busy;

int main(object me, string arg)
{
	int i, j;
	string *dir, *usrs, udir, name;
	object usr;

	if(!arg)
	{
		tell_object(me,"\n你要查什么内容？\n");
		return 1;
	}

	if(busy)
		return notify_fail(HIR "请等待上次查询完成后再操作！\n" NOR);
    write("数据查询中：\n");

	busy = 1;
	usr = new(USER_OB);

	dir = get_dir(DATA_DIR + "user/");
	for(i = 0; i < sizeof(dir); i++)
	{
		reset_eval_cost();

		udir = dir[i];
		write("查询目录 -= " + udir + " =-\n");
		usrs = get_dir(DATA_DIR + "user/" + udir + "/");
		for(j = 0; j < sizeof(usrs); j++)
		{
			if( sscanf(usrs[j], "%s.o", name) == 1 )
			{
				//if( (string)SECURITY_D->get_status(name)!="(player)" )
				//{
				//	write(BOLD+"排除巫师"+name+"\n"+NOR);
				//	continue;
				//}

				seteuid(name);
				export_uid(usr);
				usr->set_name("", ({ name }));
				if (!usr->restore())
				{
					destruct(usr);
					continue;
				}
				//usr->setup();

				if (usr->query(arg) > 10000000)
					write(name + "\t\t" + usr->query(arg) + "\n");

			}
		}
	}
	destruct(usr);

	write("查询完毕！\n");
	busy = 0;

	return 1;
}