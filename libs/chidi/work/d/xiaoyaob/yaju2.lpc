// yaju.c
// by keinxin

#include <ansi.h>
inherit ROOM;

void create()
{
        set("short", "雅居");
        set("long", @LONG
这是一间不是很大的居室，两边挂着字画，室中摆放着各种奇花异草，
书架上摆满了各种古籍善本。中间放着一张棋桌(table)。
LONG );

	set("item_desc", ([
		"table" : "一张棋桌，可以用钻研棋艺(xiaqi)\n",
	]));
	set("exits", ([
		"east" : __DIR__"muwu2",
	]));
	set("objects", ([

	]));
	setup();
}
void init()
{
	add_action("do_xiaqi","xiaqi");
}
int do_xiaqi(string arg)
{
       object me=this_player();
       if (me->query("job_lianasked")<1)
        return notify_fail("苏星河没有让你练，你白费力气干什么？\n"); 
         if (me->is_busy() )
       return notify_fail("你正忙练棋啊！\n");
        if (me->query("job_lian")>4)
       return notify_fail("你还是先练琴吧！\n");
        if (me->query("job_lian")<1)
       return notify_fail("你练习好了，可以去复命(task ok)了！\n");
       message_vision(BLU
      "$N将黑白二色棋子放入棋盘，细细端详……\n"NOR,me);
       me->improve_skill("art", (int)me->query_skill("art", 1)/3+1);
       me->add("jing",-20);
       me->add("job_lian",-1);
       me->start_busy(3);
       return 1;
}