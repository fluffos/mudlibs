inherit ROOM;
#include <ansi.h>;
void create()
{
	set("short", "石室");
	set("long", @LONG
这里是一个极大的石室，比之外面的任何一个都大了数倍，室中一排排
地列满了木制成的书架(shelf),可是书架上却空荡荡地连一本书也没有，走
近看时，只见书架上贴满了“昆仑派”，“少林派”，“青城派”之类的条
目，想象当年所列，皆是各门各派的武功秘籍。室中还有一张小床。
LONG );
	set("exits", ([
		"south" : __DIR__"shidong",
	]));
	set("objects", ([

                "d/xiaoyao/obj/lankepu" : 1,
                "d/xiaoyao/obj/ouxuepu" : 1,

	]));
	set("item_desc", ([
		"bed"   : "一张很简陋的小床。\n",
		"shelf" : "书架上贴着一张小贴：“乘天地之正，御六气之辩，以游于无穷，是为逍遥。”\n",
	]));
	set("no_clean_up", 0);
	setup();
}

