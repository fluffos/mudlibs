//wanzhenshan.c 

#include <ansi.h>
inherit BHNPC;

int ask_liguan();
int ask_quickout();
void create() {
  set_name("万震山", ({ "wan zhenshan", "wan", "zhenshan", "guanzhu" }));
  set("title", "襄阳武馆馆主");
  set("nickname", "五云手");
  set("gender", "男性");
  set("age", 62);
  set("str", 30);
  set("dex", 26);
  set("long", "这人紫金脸庞，面带威严，威武有力，站在那里就象是一座铁塔。\n");
  set("combat_exp", 100000);
  set("shen_type", 40);
  set("attitude", "peaceful");

  set_skill("force", 190);
  set_skill("strike", 190);
  set_skill("dodge", 190);
  set_skill("parry", 190);

  set("inquiry",
    ([
      "工作": "呵呵，你去找我的大徒弟吧，他会安排你的!",
      "练功": "东西练武场都可以练的，你去那儿练吧!",
      "离馆": (: ask_liguan :),
      "直接闯荡江湖": (: ask_quickout :),
    ]));


  setup();
  carry_object(__DIR__ "obj/jinduan")->wear();
}

int ask_liguan() {
  object ob;
  ob = this_player();
  if (ob->query("离馆")) {
    command("say 你不是已经来打听过了么？");
    return 1;
  }
  if (ob->query("combat_exp") > 3000000) {
    command("nod " + ob->query("id"));
    command("say 这位" + RANK_D->query_respect(ob) + "可以出去闯荡江湖了，江湖险恶，可千万小心啊。去和我
四徒弟孙均去说一声吧，他会安排的。");
    ob->set("离馆", 1);
    return 1;
  } else {
    command("pat " + ob->query("id"));
    command("say 这位" + RANK_D->query_respect(ob) + "的经验还太差，江湖太危险，你还是乖乖在武馆练功吧。");
    return 1;
  }
}


int ask_quickout() {
  int exp, pot;
  exp = 20000 + random(10000);
  pot = exp / 3;
  if (this_player()->query("离馆")) {
    command("say 你不是已经来打听过了么？");
    return 1;
  }

  command("nod " + this_player()->query("id"));
  command("say 这位" + RANK_D->query_respect(this_player()) + "如果你执意直接闯荡江湖，我也不阻拦你，去和我
四徒弟孙均去说一声吧，他会安排的。另外我给你传受一些江湖经验和技能。");
  this_player()->add("combat_exp", exp);
  this_player()->add("potential", pot);
  // this_player()->set_skill("literate",28);
  this_player()->add("newbieliwu", 1);
  tell_object(this_player(), HIY "你听了万馆主的见解，觉得脑中豁然开朗：   \n" +
    "增加了    \n" +
    chinese_number(exp) + "点实战经验\n" +
    chinese_number(pot) + "点潜能\n" NOR);

  this_player()->set("离馆", 1);
  return 1;

}
