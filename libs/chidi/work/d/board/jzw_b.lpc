#include <ansi.h>
inherit BULLETIN_BOARD;
void create()
{
         set_name(HIY"事情交流栏"NOR, ({ "board" }) );
         set("location", "/u/jzw/workroom");
         set("board_id", "jzw_b");
         set("long", "这是一个交流经验和问题的留言板。有任何事情请留言！\n");
        setup();
        set("capacity", 30);
        replace_program(BULLETIN_BOARD);
}
