#include <ansi.h>
inherit BHNPC;
void to_rob();
string ask_huijia();
string ask_daojia();
void create()
{
	set_name(HIM"方正大师"NOR, ({ "fangzheng dashi", "dashi", "fangzheng" }) );
	set("gender", "男性" );
	set("age", 60+random(20));
	set("long",
		"他是少林的方丈。\n");
        set("per", 35);
        set("no_get", 1);
        set("str", 40);
        set("int", 47);
        set("con", 46);
        set("dex", 48);
        set("qi", 4500);
        set("max_qi", 4500);
        set("jing", 4600);
        set("max_jing", 4600);
        set("neili", 4000);
        set("max_neili", 4000);
        set("chat_chance", 0);
    set_skill("force", 300);
    set_skill("hunyuan-yiqi", 300);
    set_skill("dodge", 300);
    set_skill("shaolin-shenfa", 300);
    set_skill("parry", 300);
    set_skill("unarmed", 300);
    set_skill("staff", 300);
        set_skill("jingang-quan", 300);
    set_skill("wuchang-zhang", 300);
    set_skill("yizhi-chan", 300);
    set_skill("banruo-zhang", 300);
    set_skill("buddhism", 300);
    set_skill("literate", 300);
    map_skill("force", "hunyuan-yiqi");
    map_skill("dodge", "shaolin-shenfa");
    map_skill("unarmed", "jingang-quan");
        map_skill("staff", "wuchang-zhang");
    map_skill("parry", "wuchang-zhang");
        set("inquiry", ([
        "护送" : (:ask_huijia:) ,
        "到了" : (:ask_daojia:) ,
         ]) );
        set("env/wimpy", 40);
        set_temp("apply/attack", 50);
        set_temp("apply/defense",100);
        set_temp("apply/armor", 100);
        set_temp("apply/damage", 10);
        setup();
        carry_object("/d/shaolin/obj/xuan-cloth")->wear();
}

void init()
{
	add_action("do_guard","guard");
}

void leave()
{
        object ob = this_object();
        if (ob->query("lingsong") == 0) {
                message_vision(HIG "大师见无人来接应,自己离开了。\n" NOR,this_object());
                destruct(this_object());
                }
        else call_out("leave",30);
}

string ask_huijia()
{
object me=this_player();
object ob = this_object();
if(me->query("job") != 2 )
return "我看你是魔教派来的那奸细!。。。\n";
set_leader(me);
   remove_call_out("clone_meng");
     call_out("clone_meng", 2, me);
ob->set("lingsong",30);
return "走吧！\n";
}

string ask_daojia()
{
 object ob,me;
 int pot,exp;
   pot=1000+random(400);
       exp=3000+random(1000);
 ob = this_object();
 me = this_player();
 if( environment(ob)->query("short")=="广场")
         {

          set_leader(0);
             me->set("shaolinjob",0);
             me->add("potential",pot);
             me->add("combat_exp",exp);
             me->set("job",0);
         tell_object(me,"你得到了\n"+HIW+
         chinese_number(exp)+NOR"点经验和"+HIW+chinese_number(pot)+NOR"点潜能!\n");   
        call_out("leavet",1);
           return "我走了，大家保重.....\n";  
      }
        else {
                return "还没到呢!你想不管了吗?\n";
        }
}

 int do_guard()
{  
  object me=this_player(); 
  object* ob;
  int i;     
 tell_room(environment(me),me->query("name")+"开始护送大师回寺。\n");
 me->add("job",1);
 return 1;}

void leavet()
{
        object ob = this_object();
        destruct(this_object());
}

void clone_meng(object me)
{ 
     object ob;
if (!me->query("shaolinjob")) return;
     tell_room(environment(me),"魔教教徒从后面追了上来！\n");
     ob=new("/kungfu/class/shaolin/tufei.lpc");
     ob->move(environment(this_player()));    
     this_player()->start_busy(2);
         call_out("clone_meng", 30, me);}
void end_guard(object me)
{ me->add("combat_exp",10);
  me->add("potential",5);
  if ((int)me->query("potential")-(int)me->query("learned_points")>100)   me->set("potential",(int)me->query("learned_points")+100);}
void die()
{
  object *me;
  int i;me = users();
  for (i = 0; i < sizeof(me); i ++)
    me[i]->delete("shaolinjob"); 
  me->apply_condition("menpai_busy",10);
  ::die();}
