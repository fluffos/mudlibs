#include <ansi.h>
inherit ITEM;
int j=3;
void create()
{
        set_name("魔教教徒", ({ "mojiaojiaozhong"}));
        set("unit", "只");
        set_weight(90000000);
        set("long", "
这是一支魔教的人马，正在追杀一群少林僧人。\n");
        set("no_get", 1);
        set("no_drop", 1);
	 set("no_put",1);
}

void init()
{ remove_call_out("aaa");
  call_out("aaa", 300, this_object());  
  add_action("do_rob", "jiuren");
}

int do_rob()
{
   object me, ob;   
   string arg;
   int stage, i;
   me = this_player();
   ob = this_object();
   stage = 0;
   arg = query("arg");

   if(!living(me)) return 0;
   if(!me->query("shaolinjob")) 
       return notify_fail("你胆子不小，竟敢和神教做对？\n");
   if(objectp(present("robber", environment(me))))
       return notify_fail("教徒看来武功不弱，你还是先打发了面前这个再说吧！\n");  

   message_vision(HIR"$N对着$n大吼一声："+me->name()+"在此！尔等不要猖狂！\n"NOR, me, ob);
   me->set_temp("xx_rob", 1);
        me->set("job",1);
   me->start_busy(3);
   remove_call_out("make_bs");
   call_out("make_bs", 1, me, ob); 
   return 1;     
}
void make_bs(object me, object ob)
{
   object obj, obj1;
	if (j>0){
	  obj = new(__DIR__"xiake");
         obj->move(environment(me));
	  obj->do_copy(me);
         obj1 = new(__DIR__"xiake");
         obj1->move(environment(me));
 	  obj1->do_copy(me);
          j=j-1;     }
else {
       message_vision(HIW"$N见已经无活人，将大师救出！！\n"NOR, me);    
       obj=new(__DIR__"dashi");
       obj->move(environment(me));
       obj->set("owner", me->query("id"));
/*
        me->add("combat_exp", 500);
       me->add("shen", 100);
       me->add("job",1);
          tell_object(me,"你被奖励了\n五百点经验值。\n");
*/
       me->delete_temp("rob_start");
       me->delete_temp("xx_rob");
       me->delete_temp("rob_job");
       me->delete_temp("j");       
       message_vision("$N转过几个小山丘就不见了。\n",ob);
       destruct(ob);
    }
}

void aaa(object me)
{
       message_vision("$N转过几个小山丘就不见了。\n",me);       
       destruct(me);
       return;
}

