// thousand.c

#include <ansi.h>

inherit MONEY;

void create() {
  set_name(YEL "十万两金票" NOR, ({ "thousand-golden", "thousand-golden_money" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("money_id", "thousand-golden");
    set("no_drop", 1);
    set("long", "一张面额值十万两金子的金票。\n");
    set("unit", "叠");
    set("base_value", 1000000000);
    set("base_unit", "张");
    set("base_weight", 6);
  }
  set_amount(1);
  init_throwing(50);
  setup();

}
