// 这分code 介绍的比较详细,准备给天涯新手巫师学习用的

inherit ITEM; 
mapping *ansi= ({
([     "yanse":    HIC,]),
([     "yanse":    HIG,]),
([     "yanse":    HIR,]),
([     "yanse":    HIB,]),
([     "yanse":    HIM,]),
([     "yanse":    HIY,]),
([     "yanse":    RED,]),
([     "yanse":    YEL,]), 
([     "yanse":    MAG,]),
([     "yanse":    CYN,]),

});
mapping *yao= ({
([     "name":     "当归",
       "id":       "dang gui",
       "shoubi":   random(3),   
       "random":   random(5),
       "tui":      random(3),]),
([     "name":     "川椒",
       "id":       "chuan jiao",
       "shoubi":   random(3),   
       "random":   random(3),
       "tui":      random(3),]),

([     "name":     "赤芍",
       "id":       "chi shao",
       "shoubi":   random(3),   
       "random":   random(4),
       "all":      random(3),
       "tui":      random(3),]),

([     "name":     "泽兰",
       "id":       "ze lan",
       "shoubi":   random(3),   
       "random":          2,
       "all":      random(3),
       "tui":      random(3),]),

([     "name":     "玉竹",
       "id":       "yu zhu",
       "shoubi":   random(3),   
       "random":          3,
       "all":      random(3),
       "tui":      random(3),]),

([     "name":     "无名异",
       "id":       "wuming yi",
       "shoubi":   random(3),   
       "random":          6,
       "all":      random(3),
       "tui":      random(3),]),
([     "name":     "黄柏",
       "id":       "huang bo",
       "shoubi":   random(3),   
       "random":          4,
       "all":      random(3),
       "tui":      random(3),]),

([     "name":     "陈皮",
       "id":       "chen pi",
       "shoubi":   random(3),   
       "random":          5,
       "all":      random(3),
       "tui":      random(3),]),

([     "name":     "松节",
       "id":       "song jie",
       "shoubi":   random(3),   
       "random":          7,
       "all":      random(3),
       "tui":      random(3),]),

([     "name":     "甘草",      
       "id":       "gan cao", 
       "shoubi":   random(3),   
       "random":          8,
       "all":      random(3),
       "tui":      random(3),]),

([     "name":     "贝母",
       "id":       "bei mu",
       "shoubi":   random(3),   
       "random":          9,
       "all":      random(3),
       "tui":      random(3),]),

});
void create()
{
    string name,id;
    int shoubi,tui,all,yaoo,yanse,all2;

    yanse = random(sizeof(ansi));
// 随机抽出*ansi里的其中一个([])

    yaoo = random(sizeof(yao)); 
// 随机抽出*yao里的其中一个([]) 
    name = yao[yaoo]["name"];
// name做为变量,name= *yao这个mapping里的[yaoo]{也就是上面抽出来的那个}
// 里的name变量名! 
    id = yao[yaoo]["id"]; 
// id做为变量,name= *yao这个mapping里的[yaoo]{也就是上面抽出来的那个}
// 里的id变量名!
// 以下的shou和tui all都是这个原理,不一一介绍了!
    shoubi = yao[yaoo]["shoubi"]; 
    tui = yao[yaoo]["tui"];
    all = yao[yaoo]["all"];
    all2 = yao[yaoo]["random"];
    set_name(ansi[yanse]["yanse"]+name+NOR,({id}) );  
// 设定该object 的name,中文名字为name变量,上面已经定义了
// id名为id变量,上面已经定义了! 
    set_weight(100);
    if( clonep() )
    set_default_object(__FILE__);
    else {
         set("unit", "个");                        
        }

   set("shoubi",shoubi);    
// 设定该obj shoubi变量为,上面以定义的shoubi变量名
// 以下也是这个原理
   set("all",all);
   set("tui",tui);
   set("yao",1);
   set("random",all2);
   setup();
  }

