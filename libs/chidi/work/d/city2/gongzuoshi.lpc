// gongzuoshi.c - 工作室

#include <room.h>
#include <login.h>

inherit ROOM;

string look_sign();

#define OUTROOM "/d/city2/tian_anm"

void create() {
  set("short", "工作室");
  set("long", @LONG

    这里是江湖的新手工作室。老板是一个一看就知道是十分精明的
干瘦的中年人，总是带着一脸奸笑。你可以看到许多人正在忙忙碌碌的
工作着，门口挂著一块牌子(sign)。
LONG
  );

  set("exits", ([
    "down": OUTROOM,
    //"east" : __DIR__"xiuxishi",
  ]));

  set("item_desc", ([
    "sign": @TEXT
现在正紧缺人手，急需雇佣一批短工来干活。

work        开始工作。

TEXT
  ]));

  set("no_fight", 1);
  set("no_kill", 1);

  setup();

}

void init() {
  add_action("do_work", "work");
}

int do_work(string arg) {
  object me;
  string tempstr;

  me = this_player();

  if (!interactive(me)) {
    me->move(OUTROOM);
    return 1;
  }

  if (me->query_temp("working") == 1) return notify_fail("你已经在工作当中了！\n");
  if (me->query("jing") < 20) return notify_fail("你想把人累死？！\n");
  if (me->query("qi") < 20) return notify_fail("你想把人累死？！\n");
  message_vision("$N开始了辛苦的工作....\n", me);

  if (random(20) == 0) {
    tempstr = "工作室老板突然冒了出来：“$N！你竟敢干活偷懒！”\n";
    message_vision(tempstr, me);
    me->move(OUTROOM);
    tempstr = "工作室老板一脚把$N踢了出来：“给我滚！叫你干活偷懒！”\n";
    message_vision(tempstr, me);
    return 1;
  }

  me->set_temp("working", 1);
  call_out("compelete_work", 3, me);
  return 1;
}

private void compelete_work(object me) {
  object ob;
  //      int i;

  me = this_player();
  //        me->delete_temp("working");

  if (present(me)) {                     // 如果玩家还在原地
    message_vision("$N的工作终于结束了，可人也累的要死。\n", me);
    me->add("jing", -10);
    me->add("qi", -10);
    //                me->add("balance",10000); //哪个白痴写的，这里没这个函数，pig 
    me->add("money", random(1500000));
    me->delete_temp("working");

    /*
                for( i = 0; i < 10; i ++ ) {            // 十两银子
                        ob = new("/clone/money/silver");
                        ob->move(me);
*/
    //              }
    tell_object(me, HIW "老板对你说：你的工钱我已经帮你存入了银号!\n" NOR);
  }
  return;
}
