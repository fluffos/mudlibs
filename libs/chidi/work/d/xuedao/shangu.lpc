inherit ROOM;
void create()
{
        set("short","后山山谷");
        set("long",@LONG
山谷里遍地积雪，四周好象没有一个出口，你仔细观察了一下周围，
发现山壁间似乎有一个小山洞(hole)。
LONG );
        set("exits",([
                "south" : __DIR__"shandong3",
        ]));
        set("outdoors", "xuedao"); 
        setup();
}

void init()
{
       add_action("do_enter","enter");
}

int do_enter(string arg)
{
       if( !arg || arg!="hole")
       return notify_fail("你要钻到哪里去？\n");
       this_player()->move(__DIR__"shidong");
       return 1;
}



