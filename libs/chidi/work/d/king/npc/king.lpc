// king.c 过秦论    by king
inherit BHNPC;
//inherit F_MASTER;
#include <ansi.h>
string ask_me();

void create()
{
        set_name("过秦论", ({ "guo qinlun","guo" }));
        set("gender", "男性");
        set("age", 19);
        set("nickname",HIW"无敌天下"NOR);
        set("long", "他就是闻名天下的过秦论，长得高高的，非常帅气，很有钱。\n");
        
       
        set("combat_exp", 10000000);
        set("shen_type", 0);
        
        set("str", 30);
        set("con", 30);    
        set("int", 45);
        set("dex", 35);
        set("per", 30);
        set("no_suck",1);
        set("max_qi", 10000);
        set("max_jing", 1000000);
        set("neili", 10000);
        set("max_neili",10000);
        set("jiali", 100);


        set_skill("unarmed", 2200);
        set_skill("dodge", 2200);
        set_skill("force",2200);
        set_skill("parry",2200);
        set_skill("axe",2200);
        set_skill("spear",2200);
        set_skill("throwing",2200);
        set_skill("sword",2200);
        set_skill("fengxiao-biao",2200);
        set_skill("fengxiao-xinfa",2200);
        set_skill("fengxiao-qiangfa",2200);
        set_skill("fengxiao-jianfa",2200);
        set_skill("fengxiao-shenfa",2200);
        set_skill("fengxiao-axe",2200);
        set_skill("fengxiao-zhang",2200);
        set_skill("literate",2200);



        map_skill("unarmed","fengxiao-zhang");
        map_skill("force","fengxiao-xinfa");
        map_skill("dodge","fengxiao-shenfa");
        map_skill("parry","fengxiao-qiangfa");
        map_skill("throwing","fengxiao-biao");
        map_skill("axe","fengxiao-axe");
        map_skill("sword","fengxiao-jianfa");
        map_skill("spear","fengxiao-qiangfa");
 
        create_family("风啸楼", 1, "开山祖师");
        set("title","风啸楼楼主");
        set("accept",1);
        set("chat_chance", 10);
        set("chat_msg", ({
        "过秦论说道: 现在天下大乱，我要去主持公道。\n",
        "过秦论叹了口气。\n",
        "过秦论把纸扇一展，转过身去，谁也不理。\n",
        
    }) );
    set("inquiry", ([
        "钱" : "我没钱？\n",
        "风啸楼" : "gc,e,e,e,u。\n",
        "拜师" : "好吧！你就Bai我吧\n",
    ]));


        
        setup();
      carry_object("/d/king/npc/obj/zhao.lpc")->wear();
     carry_object("/d/king/npc/obj/jian.lpc")->wield();
    add_money("coin",2);
}

void attempt_apprentice(object ob)
{
    if (mapp(ob->query("family"))  &&   (string)ob->query("family/family_name") != "风啸楼")
    {
        command("say " + RANK_D->query_respect(ob) + "既然已有名师指点，何必又来拜爷爷我呢？");
        return;
    }
    if (((int)ob->query_skill("sword",1) < 150) || ((int)ob->query_skill("fengxiao-jianfa",1) < 150))
    {
        command("say 我看" + RANK_D->query_respect(ob) + "的风啸剑法还没学到家吧。");
        return;
    }
    if (((int)ob->query_skill("force",1) < 150) || ((int)ob->query_skill("fengxiao-xinfa",1) < 130))
    {
        command("say 我看" + RANK_D->query_respect(ob) + "的风啸心法还没学到家吧。");
        return;
    }
    if (((int)ob->query_skill("dodge",1) < 150) || ((int)ob->query_skill("fengxiao-shenfa",1) < 150))
    {
        command("say 我看" + RANK_D->query_respect(ob) + "的风啸身法还没学到家吧。");
        return;
    }
    if ( (int)ob->query_skill("literate",1) < 160)
    {
        command("say 我看" + RANK_D->query_respect(ob) + "的读书识字还没学到家吧。");
        return;
    }
    if ((int)ob->query("shen") < 100000)
    {
        command("say 我风啸楼乃是堂堂名门正派，对弟子要求极严。");
        command("say 在德行方面，" + RANK_D->query_respect(ob) +
            "是否还做得不够？");
        return;
    }
    if ((int)ob->query_int() < 41) {
        command("say 依我看" + RANK_D->query_respect(ob) + "的资质似乎不适合学我独孤九剑？");
        return;
    }
        command("nod") ;
        command("say 风啸楼又要出一个绝世高人！\n");
        command("haha");
        command("recruit "+ob->query("id"));                 
}  

