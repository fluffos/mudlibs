// raozhi.c 风啸楼剑法「绕指」字诀
#include <ansi.h>
inherit F_SSERVER;
int perform(object me, object target) {
  int time;
  object weapon;
  string msg;
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("控制敌人只能对战斗中的对手使用。\n");
  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "sword")
    if (!objectp(weapon = me->query_temp("secondary_weapon"))
      || (string)weapon->query("skill_type") != "sword")
      return notify_fail("你使用的武器不对。\n");

  if (target->is_busy())
    return notify_fail(target->name() + "目前正自顾不暇，放胆攻击吧ⅵ\n");
  if (me->is_busy()) return notify_fail("你现在正忙着。\n");
  if (!me->visible(target)) return notify_fail("你看不到" + target->name() + "。\n");
  msg = HIW "$N使出「绕指」字诀，使出风啸剑法快速递出。\n";
  me->start_busy(2);
  time = (int)me->query_skill("fengxiao-jian") / 20;
  if (time < 10) time = 10;
  if (random(me->query("combat_exp")) > (int)target->query("combat_exp") / 20) {
    msg += HIR " 结果$p被$P完全控制了！\n" NOR;
    target->start_busy(time);
  } else {
    if (time > 5) time = 5;
    me->start_busy(time / 2);
    msg += HIC "可是$p看破了$P的企图，并没有上当。\n" NOR;
  }
  message_vision(msg, me, target);
  return 1;
}
