#include <ansi.h>
inherit NPC;
string ask_me();
string ask_toutai();
string ask_yuandan();

void create()
{
    set_name(HIR"浴血使者"NOR, ({ "yxcs shizhe", "shizhe" }) );
         set("nickname", HIY"不知情愁枉少年"NOR);
        set("gender", "男性" );
        set("age", 18);
        set("long", YEL"这位是〖浴血江湖〗的使者，向他打听“浴血江湖”，他会带给您想不到的惊喜。\n"NOR);
        set("shen_type", 1);
        set("combat_exp", 999999999);
        set("str", 300);
        set("dex", 300);
        set("con", 300);
        set("int", 30);
        set("per", 30);
        set("attitude", "friendly");
        set("max_qi", 100000);
        set("neili", 100000);
       set("jingli",21000000);
        set("score", 100000);

        set("inquiry", ([
                       "浴血江湖" : (: ask_me :),
                         "投胎" : (: ask_toutai :),
  "新年快乐" : (: ask_yuandan :),

        ]));
        setup();
}

void init()
{
        object ob=this_object();
        
        if( interactive (ob) )
        {
        remove_call_out("story_check");
        remove_call_out("check_time");
        }

        if( !ob->query_temp("story_start") )
        {
        call_out("story_check",2);
        ob->set_temp("story_start",1);
        }          
        
        if( !ob->query_temp("check_time") )
        {
        call_out("check_time", 1);
        ob->set_temp("check_time",1);
        }

        ob = this_player();     
        ::init();
        if( interactive(ob) && !is_fighting() )
               {
                        remove_call_out("greeting");
                        call_out("greeting", 1, ob);
                }

}

void greeting(object ob)
{
   if( !ob || environment(ob) != environment() ) return;
  command("whisper " + ob->query("id") + " "HIW"欢迎光临〖浴血江湖〗"+HIR+"(ask shizhe about 浴血江湖)\n"+NOR+HIW+"， 小的助您行走江湖．"NOR);
   //command("chat " + HIM"欢迎光临" +HIY"〖浴血江湖〗" + HIM"新手可以去fly yz(ask shizhe about 浴血江湖)得到奖励。\n"NOR);
  // command("chat " + HIM"欢迎光临" +HIY"〖浴血江湖〗" +HIM"最完整的升官和帮派系统，还能离线练功,修建城堡等。\n"NOR);
//command("chat " + HIM"欢迎光临" +HIY"〖浴血江湖〗" +HIM"各位玩家请加QQ群15173851,游戏论坛http://yulefeng.88uu.cn/bbs/。\n"NOR);
//command("chat " + HIM"欢迎光临" +HIY"〖浴血江湖〗" +HIM"为了减轻系统负担,增大出现了双特技成功几率.\n"NOR);


}

string ask_me()
 {
        object me = this_player();
        mapping fam; 
        
         if ((int) me->query("welcomexhc"))
                return "呵呵～这就是您的不是了！小的已经对您施过法力了！";
               else
        {
                me->set("welcomexhc", 1);
                  me->add("max_neili", 100000);
                me->add("neili", 100000);
                me->add("jingli", 100000);
                  me->add("max_jingli", 50000);
                  me->add("potential", 1000000);
                me->add("food", 15000);
                me->add("water", 15000);
                me->set("per", 30);
                me->set("kar", 30);
                  me->add("combat_exp",2000000);
                  me->set_skill("literate",1000);
                  me->set_skill("force",300);
                  me->set_skill("dodge",300);
                  me->set_skill("unarmed",300);
                  me->set_skill("sword",300);
                  me->set_skill("parry",300);
                  me->set_skill("blade",300);

      CHANNEL_D->do_channel(me, "es", sprintf("在下%s今日光临〖浴血江湖〗 现已得到浴血江湖使者的帮助和奖励！即日起开始行走江湖了！", me->name(1)));
               return "欢迎光临"NOR+HIR"〖浴血江湖〗"NOR"，小的护架来迟，罪该万死！在下可助您行走江湖！\n"
HIW"突然天空中一道"HIM"七"HIY"彩"HIR"霞"HIC"光"HIW"笼罩四方，转瞬即逝！"NOR;
        }
}
string ask_toutai()
 {
        object me = this_player();
        mapping fam; 
        
         if ((int) me->query("tt"))
                return "投胎一次够了!";
               else
        {    
                me->set("tt",1);
                me->move("/d/register/entry");
              
        }
}
string ask_yuandan()
 {
        object me = this_player();
        mapping fam; 
        
         if ((int) me->query("yuandan"))
                return "新年快乐！你不是已经领取过元旦礼品了吗？还不知足啊？";
               else
        {
                  me->set("yuandan", 1);
                  me->add("max_neili", 1500000);
                  me->add("max_jingli", 550000);
                  me->add("potential", 15000000);
                  me->add("food", 50000);
                  me->add("water", 50000);
                  me->add("combat_exp",35000000);
                  me->set_skill("literate",me->query_skill("literate",1)+1200);
                  me->set_skill("force",me->query_skill("force",1)+700);
                  me->set_skill("dodge",me->query_skill("dodge",1)+700);
                  me->set_skill("unarmed",me->query_skill("unarmed",1)+700);
                  me->set_skill("sword",me->query_skill("sword",1)+700);
                  me->set_skill("parry",me->query_skill("parry",1)+700);
                  me->set_skill("blade",me->query_skill("blade",1)+700);

      CHANNEL_D->do_channel(me, "es", sprintf("%s祝〖浴血江湖〗的所有玩家：圣诞节快乐！万事如意！", me->name(1)));
              
        }
}

int story_check()
{
        string *story_msg=({}),str;
        int story_msg_len;
        story_msg+= ( {"新手请◇fly yz◇【ask shizhe about 浴血江湖】领取丰富的奖励后，开始您的冒险旅程！\n"});
        story_msg+= ( {"奖励内容:福缘30★容貌30★内力10万★精力5万★基本技能300级★读书写字1000级★经验200万★潜能100万★！\n"});
        story_msg+= ( {"各位玩家请加本站的QQ群※15173851※，游戏论坛※http://yulefeng.88uu.cn/bbs/※，游戏修改请留意【浴血新闻】！\n"});
        story_msg+= ( {"为了避免选双特技号而浪费你的时间，这里增大出现了双特技几率，祝你在游戏愉快！\n"});
        story_msg+= ( {"完整的升官和帮派系统，离线练功，修建城堡，研究武功，包括独孤解迷等！\n"});
story_msg+= ( {"本站ip地址:xymud.kmip.net 5555/6666/7777/8888 备用ip地址:xymud.oicp.net！\n"});
story_msg+= ( {"元旦期间(1日-5日)的奖励礼品在浴血使者那里领取，ask shizhe about 新年快乐。\n"});

        story_msg_len=sizeof(story_msg);
        str=story_msg[random(story_msg_len)];

        message("channel:rumor",sprintf(HIM"\n【浴血江湖】浴血使者：%s\n" NOR, str),users());
        remove_call_out("story_check");
        call_out("story_check",300);
}
