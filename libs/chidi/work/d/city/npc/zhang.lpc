// zhang.c 张天师

#include <ansi.h>
#include <mudlib.h>
#include <command.h>

inherit BHNPC;

int ask_me();
int ask_pot();
int ask_take();
int ask_check();
int ask_shenshu();
string ask_zhuanyun();

void create()
{
	set_name("张天师", ({ "zhang tianshi", "zhang" }));
	set("age", 80);
	set("gender", "男性");
	set("long", "这是一位仙风神骨的法师。\n");
	set("attitude", "peaceful");

	set("str", 38);
        set("int", 35);
        set("con", 38);
	set("dex", 39);

        set("max_qi", 8000);
        set("max_jing", 8000);
        set("max_neili", 8000);

        set_skill("taoism", 350);

        set("chat_chance_combat", 3);
	set("chat_msg_combat", ({
                "张天师摇摇铃铛，道：天灵灵，地零零，太上老君还不显灵？\n",
                "张天师说：我这里可以存潜能，取潜能，方便玩家啊！\n",
	}));

        set("inquiry", ([
                "存潜能" : (: ask_pot :),
                "取潜能" : (: ask_take :),
                "查潜能" : (: ask_check :),
                   ]));

	setup();
//	carry_object("/u/keinxin/dao-cloth")->wear();
}






int ask_pot()
{      
        this_player()->start_busy(2);
        if ( this_player()->query("potential" ) < 10100){
        command("say 你只有这么点潜能，存什么存？？" );
        return 1;
        }     

        if ( this_player()->query("zhang_potential" ) > 10000000){
             command("say 你存了太多的潜能了，用掉点吧。" );
             return 1;
        }     

        this_player()->add("potential",-10000);
        this_player()->add("zhang_potential",1);

        
        command("say 好吧，你在我这里存放了"+chinese_number(this_player()->query("zhang_potential")*10000)+"点潜能。" );
        return 1;
}


int ask_take()
{      this_player()->start_busy(2);
        object me;
        me = this_player();
                if ( this_player()->query("potential" ) > 10000000){
        command("say 你身上潜能太多了，先去用掉点吧" );
        return 1;
        }     

        if ( this_player()->query("zhang_potential" ) < 1){
             command("chat 剑心快来啊，"+me->query("name")+"要骗潜能。剑心不在，老道先给你点教训。" );
             me->unconcious();
             return 1;
        }     

        this_player()->add("potential",10000);
        this_player()->add("zhang_potential",-1);

        command("say 好吧，这一万点潜能先给你。" );
        command("say 你在我这里还存了"+chinese_number(this_player()->query("zhang_potential")*10000)+"点潜能。" );
        return 1;
}

int ask_check()
{      
        this_player()->start_busy(2);
   

        if ( this_player()->query("zhang_potential" ) < 1){
             command("say 你在我这里没有存潜能。" );
             return 1;
        }     

        command("say 你在我这里还存了"+chinese_number(this_player()->query("zhang_potential")*10000)+"点潜能。" );
        return 1;
}



