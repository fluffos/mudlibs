#include <ansi.h>
inherit BHNPC;
string ask_me();

void create()
{
    set_name(HIR"内息使者"NOR, ({ "neixi shizhe", "neixi" }) );
         set("nickname", HIY"大慈大悲送内息"NOR);
        set("gender", "男性" );
        set("age", 18);
        set("long", YEL"这位是〖江湖〗的内息使者，向他打听“内息修为”，可能会带给您想不到的惊喜。\n"NOR);
        set("shen_type", 1);
        set("combat_exp", 999999999);
        set("str", 300);
        set("dex", 300);
        set("con", 300);
        set("int", 30);
        set("per", 30);
        set("attitude", "friendly");
        set("max_qi", 100000);
        set("neili", 100000);
       set("jingli",21000000);
        set("score", 100000);

        set("inquiry", ([
                       "内息修为" : (: ask_me :),
        ]));
        setup();
}

void init()
{
        object ob=this_object();
        
        if( interactive (ob) )
        {
        remove_call_out("story_check");
        //remove_call_out("check_time");
        }

        if( !ob->query_temp("story_start") )
        {
        call_out("story_check",2);
        ob->set_temp("story_start",1);
        }          
       /* 
        if( !ob->query_temp("check_time") )
        {
        call_out("check_time", 1);
        ob->set_temp("check_time",1);
        }
       */
        ob = this_player();     
        ::init();
        /*if( interactive(ob) && !is_fighting() )
               {
                        remove_call_out("greeting");
                        call_out("greeting", 1, ob);
                }
        */
}

void greeting(object ob)
{
   if( !ob || environment(ob) != environment() ) return;
  command("whisper " + ob->query("id") + " "HIW"欢迎光临〖本MUD〗"+HIR+"(ask shizhe about 内息修为)\n"+NOR+HIW+"， 小的助您行走江湖．"NOR);


}

string ask_me()
 {
        object me = this_player();
        mapping fam; 
        
        if((int)me->query("animaout") != 1)
        {
            return "嘿嘿～元婴都没出世，要内息干什么。。。";
        }
        else
        {
          if((int)me->query("perform/peak") >= 500)
                  return "嘿嘿～小子贪心～再问我就收回你的内息修为了！";
                  
          if((int)me->query("perform/peak") < 1)
          {
          	   me->add("perform/peak", 500+random(1600));
          	   command("say " + RANK_D->query_respect(me) + "你可以走了！");
          }
          else
               return "想作弊？";
        }
}

