// guanjia.c 财主管家
inherit BHNPC;
inherit F_DEALER;
void create() {
  set_name("管家", ({ "guan jia", "guan" }));
  set("gender", "男性");
  set("age", 65);
  set("combat_exp", 7500);
  set("area_name", "扬州城西大街");
  set_skill("unarmed", 35);
  set_skill("force", 35);
  set_skill("dodge", 40);
  set_temp("apply/attack", 30);
  set_temp("apply/defense", 40);
  set("shen_type", -1);
  setup();
  carry_object("/clone/misc/changpao")->wear();
  add_money("silver", 50);
}

void init() {
  object area;
  area = new("/clone/misc/area");
  area->create(query("area_name"));
  set("banghui", (string)area->query("banghui"));
  destruct(area);
  ::init();
}
