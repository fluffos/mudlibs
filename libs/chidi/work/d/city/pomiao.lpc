// Room: /city/pomiao.c
#include <room.h>
#define A_TIME 60
inherit ROOM;
string * add_msg = ({
        "/d/city/guangchang",
        "/d/baituo/yaofang",
        "/d/city/wumiao",
        "/d/huashan/zhenyue",
        "/d/quanzhou/bamboo",
        "/d/taishan/lianhua",
        "/d/shenlong/caoping",
        "/d/wudang/sanqingdian",
        "/d/xiaoyao/qingcaop",
        "/d/xueshan/cangjingge",
        "/d/baituo/chaifang",
        "/d/city/gbxiaowu",
        "/d/xiaoyao/pubu",
});

void create()
{
	set("short", "土地庙");
        set("long", @LONG
	这是一间破破烂烂的土地庙，庙里破败不堪，土地神像推在一旁，梁上地
下也布满了灰尘。一看就知道已经很久没有人来清理过了。正中放着个大香案，
上面零乱地丢满了各种拉圾（laji)！也许正是因为隐蔽的原因吧，据说丐帮
江南分舵就被设在此处。香案黑洞洞的，好象下边有个大洞(dong)。
LONG
          );
	set("valid_startroom", 1);
	set("exits", ([
		"south" : __DIR__"ml4",
		"enter" : __DIR__"gbandao",
	]));
	set("objects", ([
		CLASS_D("gaibang") + "/lu" : 1,
	]));
	create_door("enter", "小门", "out", DOOR_CLOSED);
      set("no_steal","1");
        set("item_desc", ([
                "laji" :  HIG"
一堆是什么都有的垃圾，还有小虫虫也，也许可以推(fan)开来看一下。\n
"NOR
        ]));
	setup();
        "/d/board/gaibang_b"->foo();
}
void init()
{
        add_action("do_enter", "enter");
        add_action("do_enter", "zuan");
        add_action("do_fan","fan");
        if (query("count") <= 0 && !query("job_start") )
        {
         set("job_start",1);
         remove_call_out("newjob");
         call_out("newjob",A_TIME); 
        }
}
int do_enter(string arg)
{
	object me;
	mapping fam;
	me = this_player();
	if( !arg || arg=="" ) return 0;
	if( arg=="dong" )
	{
		if( (fam = me->query("family")) && fam["family_name"] == "丐帮" ) 
		{
			message("vision",
				me->name() + "运起丐帮缩骨功，一弯腰往香案下的洞里钻了进去。\n",
				environment(me), ({me}) );
			me->move("/d/gaibang/undergb");
                	message("vision",
				me->name() + "从洞里走了进来。\n",
                		environment(me), ({me}) );
			return 1;
		}
		else 
			return notify_fail("这么小的洞，你钻得进去吗？\n");
	}
}	
int do_fan(string arg)
{
        object me = this_player();
        object ob,rz;
        string src_add,dest_add,des;
        object room,room2;

        src_add=add_msg[random(sizeof(add_msg))];
        dest_add=add_msg[random(sizeof(add_msg))];
        while (dest_add == src_add)
                dest_add=add_msg[random(sizeof(add_msg))];

        if (!arg || arg != "laji" )
                return 0;
        
                    if (me->query("combat_exp") < 500000){
tell_object(me,HIR"只听一阵恶狠狠的声音传来：你想死吗！不想死就先去练高功夫和经验再来！\n"NOR);
                                                      return 1;
                                                 }
        if (query("count") > 0) {
                if (!present("mi ling",me) ) {
                        if (! room = find_object(src_add) ) 
                                room = load_object(src_add);
                        rz = new("/d/tudimiao/npc/renzhi");
                        rz -> set("leader_name", me->query("id") );
                        rz -> set("title",me->query("name")+"所保护的");
                        rz -> set("dest_add",dest_add);
                        rz -> move(room);
                        if (! room2 = find_object(dest_add) )
                                room2 = load_object(dest_add);
                        des = "护送" + room->query("short") + "那里的" + rz->query("name") + "到达" + room2->query("short") ;
                        ob = new("/d/tudimiao/obj/miling");
                        ob -> set("describe",des);
                        ob -> set("src_add",room->query("short") );
                        ob -> set("dest_add",room2->query("short") );
                        ob -> set("src_des",room->query("outdoors") );
                        ob -> set("dest_des",room2->query("outdoors") );
                        ob -> move(me);
                        add("count",-1);
                        message_vision(HIY"$N小心翼翼地翻开拉圾，发现了一卷纸垫在下面，便顺手拣起来揣进怀中。\n"NOR,me);
                        tell_object(me,HIG"似乎有个声音在你耳边轻声说道：你这次的任务是"+des+"。\n"NOR);
                        return 1;
                }
                else {
                        tell_object(me,HIR"一个阴冷的声音在你耳边响起：你上次的任务还没完成呢。\n"NOR);
                        return 1;
                }
        }
        else {
                message_vision(YEL"$N试着翻了翻拉圾，结果‘w..w..’爬出成千上万只虫虫，$N碰了个灰头土脸。\n"NOR,me);
                return 1;
        }
}

void newjob()
{
        set("count",5);
        delete("job_start");
        remove_call_out("newjob");

        return;
}
