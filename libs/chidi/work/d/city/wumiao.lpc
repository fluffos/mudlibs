           set("valid_startroom",1);
    set("objects", ([
        __DIR__"obj/box" : 1,
"quest/quest_kill/dugu" : 1,
           __DIR__"npc/bigeye" : 1,
    __DIR__"npc/zhangsan" : 1,
    __DIR__"npc/wizer" : 1,
    __DIR__"npc/noshshizhe" : 1,
              
    ]));
        set("exits", ([
