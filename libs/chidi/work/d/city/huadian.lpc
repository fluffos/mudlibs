#include <ansi.h>
inherit ROOM;
void create() {
  set("short", HIM "鲜花店" NOR);
  set("long", @LONG
这里是扬州城里的一家鲜花店，花店内放满了各类娇艳欲滴的花
儿，满屋子都弥漫着一股浓郁的花香。卖花姑娘英莲手里提着浇水的
花洒，正细心的往花上喷着水。在店铺柜台上立着一个告示(gaoshi)。
LONG
  );

  set("no_fight", 1);
  set("exits", ([
    "north": __DIR__ "kedian",
  ]));
  set("item_desc", ([
    "gaoshi":
    "┌──────────────" + HIG "购花须知" NOR + "─────────────────┐\n"
    "│ 一：花店里花儿的价格用（list)查看，可直接向店主购买（buy)            │ \n"
    "│ 二：本鲜花店提供送花，详情请向买花女查询(ask ying lian about songhua)│ \n"
    "│ 三：请用(help flower)来查询花朵含义和资料。                          │ \n"
    "└───────────────────────────────────┘ \n\n"
  ]));
  set("objects", ([
    // __DIR__"npc/hua_girl" : 1,
  ]));
  set("no_fight", 1);
  set("no_sleep", 1);
  setup();

}
