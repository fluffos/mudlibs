// mabudai.c 乾坤袋
inherit ITEM;
void create()
{
        set_name(HIY"乾坤袋"NOR, ({ "qiankun dai", "dai"}));
        set_weight(1);
        set_max_encumbrance(800000);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "个");
                set("long", "这是一个专门用来存放贵重物品的袋子。\n");
                set("value", 100);
        }
        set("no_clean_up",10000000);
}
int is_container() { return 1; }
void init()
{
	add_action("do_get","get");
	add_action("do_put","put");
         set("no_give",1);
         //set("no_drop",1);
}

int do_get(string arg)
{
    string str;
    object me=this_player();
    if (!arg) return 0;
    if (!sscanf(arg,"%s from dai",str))
    if (!sscanf(arg,"%s from qiankun dai",str))
    return 0;
   // if ((me->query("id")!="feng")){
  //  write("不要随便拿人家的东西！\n");
    return 1;
    }else
 return 0;
}
int do_put(string arg)
{
    string str;
    object me=this_player();
    if (!arg) return 0;
    if (!sscanf(arg,"%s in dai",str))
    if (!sscanf(arg,"%s in qiankun dai",str))
    return 0;
  //  if ((me->query("id")!="feng")){
 //  write("这个不是垃圾桶！\n");
 //   return 1;
    }else
 return 0;
}
void reset()  {   }
