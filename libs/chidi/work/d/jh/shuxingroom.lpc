#include <ansi.h>
inherit ROOM;

int do_huansx(string arg);
void create() {
  set("short", "属性转换室");
  set("long", @LONG
这里是系统属性转换室,各位大侠们可以到此换属性(huansx)
使自己更加厉害!
LONG);
  set("exits", ([
    "down": "/d/jh/shengjiroom", ]));
  set("objects", ([
  ]));
  setup();
}
void init() {
  add_action("do_huansx", "huansx");
}

int do_huansx(string arg) {
  int exp, dj, sx, wx, shenfa, bili, con;
  object fae, shangshan, mengzhu, xinxiu;
  object me = this_player();
  exp = me->query("combat_exp");
  dj = me->query("jh_dj/dj") + me->query("jh_dj/zhuan") * 150;
  sx = (((dj - 1) * 10) - 1);
  wx = me->query("jh_dj/int", 1);
  shenfa = me->query("jh_dj/dex", 1);
  bili = me->query("jh_dj/str", 1);
  con = me->query("jh_dj/con", 1);
  fae = load_object("/d/taishan/npc/fa-e");
  fae->restore();
  shangshan = load_object("/d/taishan/npc/shang-shan");
  shangshan->restore();
  mengzhu = load_object("/d/taishan/npc/meng-zhu");
  mengzhu->restore();
  xinxiu = load_object("/d/taishan/npc/xin-xiu");
  xinxiu->restore();

  if (!arg)
    return notify_fail("您只能转换<int>(悟性) <con>(根骨) <str>(臂力) <dex>(身法) 这几项属性!\n");

  if (me->query("jh_dj/dj") < 2)
    return notify_fail("您没升级也想换属性？\n");
  if (me->query("zhuanshi/times") < 4)
    return notify_fail("您没4转也想换属性？\n");
  /*
        if( me->query("id")==fae->query("winner") )
  return notify_fail("您是当今罚恶使者，来这里换属性莫非想用BUG？\n");

        if( me->query("id")==shangshan->query("winner") )
  return notify_fail("您是当今赏善使者，来这里换属性莫非想用BUG？\n");

        if( me->query("id")==mengzhu->query("winner") )
  return notify_fail("您是当今武林盟主，来这里换属性莫非想用BUG？\n");

        if( me->query("id")==xinxiu->query("winner") )
  return notify_fail("您是当今新秀使者，来这里换属性莫非想用BUG？\n");
*/
  if (!me->query_temp("huansx")) {
    me->add_temp("huansx", 1);
    write(HIR "请注意，你换属性花的经验值和升级花的经验值不一样，如果你拿经验换属性\n"
      HIR "的话，那么可能会造成现有的经验值无法支持你现在的武功等级，无法继续学武功了\n" NOR
      HIR "也就是说，换属性花的经验值，会真的没了，系统战斗的时候或者学武功的时候，不会把\n" NOR
      HIR "你换属性用了的经验值加回去!如果你决定了，请再按一次" HIB " huansx " HIR "吧!\n" NOR);
    return 1;
  }

  if (arg == "int") {
    if (wx > sx)
      return notify_fail("您的悟性已经换到等级所支持的最高限制了，想再换，去升级吧!\n");
    else {
      if (exp < 1000000)
        return notify_fail("你想换悟性还需要" + (1000000 - exp) + "点经验值!\n");
      me->add("int", 1);
      me->add("jh_dj/int", 1);
      me->add("combat_exp", -1000000);
      tell_object(me, HIC "您成功的升到了换了一点先天悟性了!\n" NOR);
      return 1;
    }
  }
  if (arg == "dex") {
    if (shenfa > sx)
      return notify_fail("您的身法已经换到等级所支持的最高限制了，想再换，去升级吧!\n");
    else {
      if (exp < 900000)
        return notify_fail("你想换身法还需要" + (900000 - exp) + "点经验值!\n");
      me->add("dex", 1);
      me->add("jh_dj/dex", 1);
      me->add("combat_exp", -900000);
      tell_object(me, HIC "您成功的换了一点先天身法了!\n" NOR);
      return 1;
    }
  }
  if (arg == "con") {
    if (con > sx)
      return notify_fail("您的根骨已经换到等级所支持的最高限制了，想再换，去升级吧!\n");
    else {
      if (exp < 800000)
        return notify_fail("你想换根骨还需要" + (800000 - exp) + "点经验值!\n");
      me->add("con", 1);
      me->add("jh_dj/con", 1);
      me->add("combat_exp", -800000);
      tell_object(me, HIC "您成功的换了一点先天根骨了!\n" NOR);
      return 1;
    }
  }
  if (arg == "str") {
    if (bili > sx)
      return notify_fail("您的臂力已经换到等级所支持的最高限制了，想再换，去升级吧!\n");
    else {
      if (exp < 900000)
        return notify_fail("你想换臂力还需要" + (900000 - exp) + "点经验值!\n");
      me->add("str", 1);
      me->add("jh_dj/str", 1);
      me->add("combat_exp", -900000);
      tell_object(me, HIC "您成功的换了一点先天臂力了!\n" NOR);
      return 1;
    }
  }
}
