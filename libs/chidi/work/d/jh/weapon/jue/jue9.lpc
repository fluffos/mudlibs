// By jh@ty

inherit ITEM; 
int jh = random(1);
mapping *weapon= ({
([      "name":     "魔睛烛舞铁",
       "id":        "zhuwu tie",
       "yanse":        HIB,
       "int":           132,
       "str":           225,
       "dex":           350,
       "con":           220,
       "damage":       543,
       "lei":            1,
]),
});
int panduan(int arg) {  if ( arg )   jh = arg - 1;  }
void create()
{
    string name,id;

    name = weapon[jh]["name"];

    set_name(weapon[jh]["yanse"]+name+NOR,({weapon[jh]["id"]}) );  
    set_weight(100);
    if( clonep() )
    set_default_object(__FILE__);
    else {
         set("unit", "个");                        
        }

   set("ty_weapon",1);
   set("no_get",1);
   set("no_drop",1);             
   //set("no_put",1);
   //set("no_sell",1); 
   //set("no_give",1);
   set("zhongji_hc",1);
   set("bh",weapon[jh]["lei"]);
   if (weapon[jh]["str"])
   set("str",weapon[jh]["str"]);
   if (weapon[jh]["con"])
   set("con",weapon[jh]["con"]);
   if (weapon[jh]["dex"])
   set("dex",weapon[jh]["dex"]);
   if (weapon[jh]["int"])
   set("int",weapon[jh]["int"]);
   if (weapon[jh]["damage"])
   set("damage",weapon[jh]["damage"]);
   set("long", "这是一个差不多绝种的金属，可以用来镶嵌兵器(xiangqian)和合成装备！\n");
   
   setup();
  }

