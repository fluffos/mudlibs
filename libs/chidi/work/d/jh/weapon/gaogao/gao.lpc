// By jh@ty

inherit ITEM;
int jh = random(3);
mapping *weapon = ({
  ([ "name": "青龙岩",
    "id": "qinglong yan",
    "yanse": HIC,
    "int": 15 + random(50),
    "damage": 100 + random(300),
    "lei": 1,
  ]),
  ([ "name": "白虎石",
    "id": "baihu shi",
    "yanse": HIW,
    "str": 15 + random(100),
    "damage": 100 + random(200),
    "lei": 2,
  ]),
  ([ "name": "朱雀钢",
    "id": "zhuque gang",
    "yanse": HIG,
    "dex": 15 + random(100),
    "damage": 100 + random(200),
    "lei": 3,
  ]),
  ([ "name": "玄武铁",
    "id": "xuanwu tie",
    "yanse": HIM,
    "con": 15 + random(100),
    "damage": 100 + random(200),
    "lei": 4,
  ]),
});
int panduan(int arg) { if (arg) jh = arg - 1; }
void create() {
  string name, id;

  name = weapon[jh]["name"];

  set_name(weapon[jh]["yanse"] + name + NOR, ({ weapon[jh]["id"] }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
  }

  set("ty_weapon", 1);
  set("value", 1);

  set("no_get", 1);
  set("no_put", 1);
  // set("no_give",1);
  set("zhongji_hc", 1);
  set("bh", weapon[jh]["lei"]);
  if (weapon[jh]["str"])
    set("str", weapon[jh]["str"]);
  if (weapon[jh]["con"])
    set("con", weapon[jh]["con"]);
  if (weapon[jh]["dex"])
    set("dex", weapon[jh]["dex"]);
  if (weapon[jh]["int"])
    set("int", weapon[jh]["int"]);
  if (weapon[jh]["damage"])
    set("damage", weapon[jh]["damage"]);

  set("long", "这是一个高级的金属，可以用来镶嵌兵器(xiangqian)和合成装备！\n");

  setup();
}
