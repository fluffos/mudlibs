//By rock&jym /2002/4/29/
#include <ansi.h>
#include <login.h>

inherit NPC;
void create()
{

           set_name("升级师", ({ "shengji shi", "shi","shengji" }) );
           set("age", 20);
           set("long",@STORY
这个是江湖的升级师,你可以使用shengji指令来提升你的等级
具体请help shengji
STORY
              );
        set("chat_chance", 8);
        set("title",HIG"升级"NOR);
        exert_function(10);
        set("chat_msg", ({
        "您可以使用shengji指令来提升您的等级\n",
                }));

        set("gender","男性");
        set("combat_exp",10000);
        set("max_neili", 1500);
        set("force",9999999);

        set_skill("hunyuan-yiqi", 999);
        set_skill("force",999);
        map_skill("force", "hunyuan-yiqi");


        setup();
}

void init()
{
        add_action("do_shengji", "shengji");
}

int do_shengji(object me)
{ 
	int exp, dj,index,zs,jjz,indexx;        
	me = this_player(); 
	exp = me->query("combat_exp"); 
       zs = me->query("zhuanshi/times");
       jjz = me->query("jh_dj/zhuan");
	
	dj = me->query("jh_dj/dj");

	//升级所需经验=50+(当前级别+1)的三次方 
	//index = dj*10000000;
	index = (50+(dj+1))*(50+(dj+1))*(50+(dj+1))*(50+(dj+1));
        if(index > 1700000000 || index < 1) index = 1700000000;
       
       
	  
	  if ( jjz > 0)
	  if ( zs < 5)
	  return notify_fail("您想升下一级需要5转!\n");
	  
	  if ( jjz > 1)
	  if ( zs < 6)
	  return notify_fail("您想升下一级需要6转!\n");	
	  if ( jjz > 2)
	  if ( zs < 7)
	  return notify_fail("您想升下一级需要7转!\n");
	  
	  if ( jjz > 3)
	  if ( zs < 8)
	  return notify_fail("您想升下一级需要8转!\n");	
	  if ( jjz >4)
	  if ( zs < 9)
	  return notify_fail("您想升下一级需要9转!\n");
	  
	  if ( jjz > 5)
	  if ( zs < 10)
	  return notify_fail("您想升下一级需要10转!\n");	

	  if ( zs < 4 )
       return notify_fail("您想升下一级需要4转!\n");
	if( exp < index)
		return notify_fail("您想升下一级还需要"+(index-exp)+"点经验值!\n");

	me->add("combat_exp",-index);

	me->add("jh_dj/dj",1);

	if((dj = me->query("jh_dj/dj")) > 150)
	{
		me->delete("jh_dj/dj");
		me->add("jh_dj/zhuan",1);
	}

	tell_object(me,sprintf(HIC"您升到了%d级了!\n"NOR,me->query_level()));

	return 1;
}
