#include <ansi.h>
inherit NPC;

#define JJ_SYS "/d/jjfb/jsys/jj_sys"

int ask_job();

void create()
{

        set_name(HIW"副本士兵"NOR, ({ "shi bing", "shi" }));
        //set("title", HIW"贵宾VIP"NOR);

        set("gender", "男性");
        set("age", 26);
        set("long","他是一位年纪很轻的小伙，他是为一从心魔手中逃走的人。\n");

	set("inquiry", ([ 
        	"挑战个人副本" : (: ask_job :),
            ])); 

        setup();
        carry_object("/clone/misc/changpao")->wear();
}

int ask_job()
{
	object me,jjmem;
	
	me = this_player();

/*	if(!me->query("jym_level/vip"))
	{
       tell_object(me, HIG"呵呵～,你不是vip不能进入，加入vip以后再说来吧！\n"NOR);
                 	return 1;
    }*/
        if(me->query("jh_dj/dj") <= 19)
	{
      tell_object(me, HIG"你没到20级，以后再来吧！\n"NOR);
                 	return 1;
    }
    
        if(me->query("jh_dj/dj") >= 160)
	{
      tell_object(me, HIY"120级还来这里做什么。\n"NOR);
                 	return 1;
    }  
/*
	if(JJ_SYS->query_room_amount() >= 200)
	{
	tell_object(me,"镜像已经开启太多，欢迎下次参与。\n");
		return 1;
	}
*/
	//删除旧的副本
	jjmem = me->query_temp("jroom/jjfb_jjmem");
	if(objectp(jjmem))
	{
		jjmem->delete("user_id");
	}
	//创建新的副本
	JJ_SYS->jjfb(me);
	return 1;
}
