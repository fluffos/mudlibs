int ask_in()
{
	int count;
	object me = this_player();
	if( stringp(me->query("banghui/name")) )
	{
		command("say "+me->query("name")+"，避难？哼！一看你就是奸细！ \n");
		return 1;
	}
	
	else
		/*
	{
		count = (int)me->add("erengu/count",count);
		if( count <= 0 )
		{
			command("shake");
			command("say "+me->query("name")+"，恶人谷不是什么鸟人都能进的！\n");
			return 1;
		}
	
		else
	*/
		{
			if( (me->query("mud_age") - me->query("erengu/intime")) >= 1800 )
			{
				me->add( "erengu/count",-1 );
				me->set( "erengu/intime", me->query("mud_age") );
			}
			enteruser[me] = 1;
			me->set_temp("erengu/pass", 1);
			message_vision("李大嘴对$N说道：你可以进去了！”\n", me );
			return 1;
		}
	}




