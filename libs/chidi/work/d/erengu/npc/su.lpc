inherit NPC;

int ask_literate();
int do_study(string arg);

void create()
{
    set_name(HIM+"苏樱"+NOR, ({ "su ying", "su"}));
    set("gender", "女性" );
    set("age", 23);
    set("per", 23);
    set("long",
        "    她的名字叫做苏樱，可以算得上是人世间最聪明的女子。虽然时常刁钻古怪\n"+
		"实则是温柔善良。昔日她误认为小鱼儿已死的时候，毫不犹豫要跳下山谷：“我\n"+
		"并不是要为他死，我只觉得活着没什么意思了。”寥寥几字，无限情深。若是你\n"+
		"能得到他的指点"+HIM+"\"qingjiao literate\""+NOR+"，想必对你会有很大的帮助。\n");
    set("str", 50);
    set("int", 50);
    set("con", 50);
    set("dex", 50);
    set("jh_dj/dj", 5000);
	set("no_suck", 1);
    set("shen_type", 0);
    set("max_neli",1500000000);
	set("max_qi",1500000000);
    set("max_jingli",1500000000);
    set("jiali",50);
    set_skill("unarmed", 10000);
    set_skill("dodge", 10000);
    set_skill("force",15000);
    set_skill("sword",15000);
    set_skill("parry",9000);       
    set_skill("literate", 30000);

    set_temp("apply/attack", 5000000);
    set_temp("apply/defense", 5000000);
    set_temp("apply/damage",5000000);
    set("combat_exp", 1125000000);
    
    set("attitude", "peaceful");
        
    set("inquiry", ([
		"读书写字"  : (: ask_literate :),
		"读书"		: (: ask_literate :),
		"literate"	: (: ask_literate :),
		"qingjiao"	: (: ask_literate :),
    ]) );
    setup();
    carry_object("/clone/misc/cloth")->wear();
}

void init()
{
   add_action("do_study","qingjiao");
}

int do_study(string arg)
{
	string skill; 
	object me=this_player(),ob=this_object();
	me=this_player();
	
	 if (me->is_busy())
                return notify_fail("你现在正忙着呢。\n");

	if (ob->is_fighting())
		return notify_fail("你还是赶紧共御外敌吧！\n");

	if( !living(ob) )
		return notify_fail("嗯....你得先把" + ob->name() + "弄醒再说。\n");

	if( !arg || arg!="literate")
		return notify_fail(HIY"你要请教(qingjiao)什么？\n"NOR); 

	if (me->query_skill("literate", 1) < 10000)
		return notify_fail(HIB"你的文化差了些，还听不懂我的讲述！\n"NOR);

	if (me->query_skill("literate", 1) >= 30000)
	return notify_fail(HIR "这项技能你的程度已经不输你师父了!\n" NOR); 

	if( me->query("potential") < 1500 )
	return notify_fail("你的潜能不够了！\n"); 

	if( me->query("rmb") < 50 )
	return notify_fail("你的人民币不够了！\n"); 


	if( me->query("jing") < 100 || me->query("qi") < 400 )
	return notify_fail("你现在太累了，先休息一下吧！\n"); 

	me->receive_damage("qi",10 + random(40));
	me->receive_damage("jing", 10 + random(40));        
	me->add("potential",-500);
	
	if (me->query("zhuanshi/times") > 3)
	{
	me->add("rmb",-1);
	}
	
	tell_object(me,HIC+query("name")+HIC+"指点了你一些有关"HIW"「读书写字」"HIC"的问题，"
				+"你似乎有些心得。\n"NOR);
	me->improve_skill("literate",1800*(10+ random((int)me->query_int() - 9)));
   me->start_busy(1);

	return 1;
}

int ask_literate()
{
	object me;
	me = this_player();

	tell_object(me,"你可以向我学习读书写字(qingjiao literate)。\n");

	return 1;
}
