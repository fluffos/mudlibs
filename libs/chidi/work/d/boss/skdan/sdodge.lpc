#include <ansi.h>
inherit ITEM;void init(){add_action("do_eat", "eat");}

void create()
{
        set_name(NOR + HIW "减肥丹" NOR, ({ "jianfei dan", "jianfei", "dan" }));
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("long", HIW "这是一颗通体发红的药丸，据说吃了可以减肥，使你身轻如燕。\n" NOR);
                set("unit", "颗");
                set("no_give", 1);
                set("no_drop", 1);
                set("no_put", 1);
                set("no_get", 1);
                set("value", 10000000);
                set("weight", 50);set("merit", 2000);//价值

                set("only_do_effect", 1);
                set("gift_type", "dodge");
                set("gift_name", "基本轻功");
                set("gift_point", 15);
                set("gift_msg", HIG "突然间你感觉到全身瘦了一圈了，乐得你一蹦十多丈高。\n" NOR);
        }
        setup();
}
int do_eat(string arg)
{
		object me;
        int point;

		me = this_player();
        point = query("gift_point");
        if (!id(arg))
			return notify_fail("你要吃什么？\n");

		if(me->query_skill("dodge",1) > 20000)
		{
			return notify_fail(HIR "你的身体已经够轻了，再吃都经不起风吹了。\n" NOR);
		}

         // 真命天子提升成功几率
        if (this_player()->query("special_skills/emperor"))
                point += 18;

        // 天煞孤星提升成功几率
        if (this_player()->query("special_skills/lonely"))
                point += 10;


        message_vision(WHT "$N" WHT "一仰脖，吞下了一" +
                       query("unit") + name() + WHT
                       "。\n" NOR, this_player());

                if (random(40) >= (5)+ point)
                        
                
		{
				tell_object(me, HIR "不过你觉得这药好像没起到什么"
								"作用。\n" NOR);
		} else
		{
				tell_object(me, query("gift_msg"));
				tell_object(me, HIC "你的" + query("gift_name") +
                                                          HIC "增加了2级。\n" NOR);

				// 增加相应的天赋属性
                                me->set_skill(query("gift_type"), me->query_skill(query("gift_type"), 1) + 2);
		}

        destruct(this_object());
        return 1;
}

void owner_is_killed() { destruct(this_object()); }

