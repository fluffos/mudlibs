#include <ansi.h>
inherit ITEM; void init() { add_action("do_eat", "eat"); }
void create() {
  set_name(NOR + HIR "天煞孤星丹" NOR, ({ "tiansha dan", "dan" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", WHT "这是颗天界里较为珍贵的宝物，据说可以增加你的先天特技-天煞孤星(25%成功率)。\n" NOR);
    set("unit", "颗");
    set("no_give", 1);
    set("no_drop", 1);
    set("no_put", 1);
    set("no_get", 1);
    set("value", 10000);
    set("weight", 50); set("merit", 800);  //价值

    set("only_do_effect", 1);
    set("gift_type", "lonely");
    set("gift_name", "天煞孤星");
    set("gift_point", 25);
    set("gift_msg", HIM "突然你头部出现一道七彩霞光，随后自己化身成一条青龙直冲九重天。\n" NOR);
  }
  setup();
}

int do_eat(string arg) {
  int point;
  point = query("gift_point");
  if (!id(arg))
    return notify_fail("你要吃什么？\n");

  // 已经是真命天子不能吃
  if (this_player()->query("special_skill/emperor"))
    return notify_fail("你已经拥有这项技能了。\n");


  // 已经是天煞孤星不能吃
  if (this_player()->query("special_skill/lonely"))
    return notify_fail("你已经拥有这项技能了。\n");


  // 福星高照提升成功几率
  if (this_player()->query("special_skill/lucky"))
    point += 5;


  message_vision(WHT "$N" WHT "一仰脖，吞下了一" +
    query("unit") + name() + WHT
    "。\n" NOR, this_player());


  if (this_player()->query("gift/" + query("gift_type") + "/succeed") >= 500) {
    tell_object(this_player(), "你觉得这药好象没什么效果。\n");
  } else

  if (random(100) >= point) {
    tell_object(this_player(), HIR "不过你觉得这药好像没起到什么"
      "作用。\n" NOR);

    // 记录失败的记号
    this_player()->add("gift/" + query("gift_type") + "/fail", 1);
  } else {
    tell_object(this_player(), query("gift_msg"));
    tell_object(this_player(), HIC "你获得先天技能--" + query("gift_name") +
      HIC "\n" NOR);

    // 记录成功的记号
    this_player()->add("gift/" + query("gift_type") + "/succeed", 1);

    // 增加相应的天赋属性
    this_player()->set("special_skill/" + query("gift_type"), 1);
  }

  // 记录入吃丹的总量
  this_player()->add("gift/" + query("gift_type") + "/all", 1);
  destruct(this_object());
  return 1;
}

void owner_is_killed() { destruct(this_object()); }
