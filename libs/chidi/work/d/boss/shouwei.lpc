#include <ansi.h>

inherit BHNPC;
int big_blowing();

void create()
{

        set_name(HIB"远古守卫"NOR, ({"shou wei", "wei"}));

        set("gender", "男性");
        set("title", HIR"【"BLINK "BOSS"NOR HIR"】"NOR);
        set("age", 8600);
        set("no_suck",1);
        set("per",20);
        set("con",60);
        set("str",80);
        set("int",80);
        set("dex",800);

        set("long", 

        "这是一位远古时空的守卫者，因在外太空乱搞恋爱关系，被其主人封印到了这里。（BOSS）。\n");

   set("max_qi", 1800000000);
   set("max_jing", 1800000000);
   set("max_jingli", 210000000);   
   set("max_neili", 210000000);
   set("jingli", 2100000000);   
   set("neili", 2100000000);    
   set("jiali", 500);    
   set("jh_dj/dj",50);
    set("attitude", "aggressive");//自动KILL玩家
   set("combat_exp", 2140000000);
   set_skill("damo-force", 10000);
   set_skill("unarmed", 10000);
   set_skill("liumai-shenjian", 10000);
   set_skill("jiuyin-baiguzhao", 10000);
   set_skill("dodge", 10000);
   set_skill("shenghuo-ling", 10000);
   set_skill("wudu-yanluobu", 10000);
   set_skill("kongming-quan", 10000);
   set_skill("parry", 10000);
   set_skill("force", 10000);
   set_skill("wudu-shengong", 10000);
   set_skill("duji", 10000);
   set_skill("sword", 10000);
   set_skill("wudu-goufa", 10000);
   map_skill("unarmed", "liumai-shenjian");
   map_skill("sword", "shenghuo-ling");
   map_skill("dodge", "wudu-yanluobu");
   map_skill("force", "damo-force");
   map_skill("parry", "kongming-quan");
   set_temp("apply/defense1", random(300)+200);
   set_temp("apply/attack1",  random(300)+600);//闪避
   set_temp("apply/damage",random(1300)+600);
   set_temp("apply/armor", random(3000)+5000);
   set("chat_chance_combat", random(30)+10);
   set("chat_msg_combat", ({
        (: command("pain" + RANK_D->query_rude(this_player())+"!\n") :),
          (: exert_function, "recover" :), 
                (: big_blowing :),
                //(: perform_action, "sword.suo" :),
         (: perform_action, "sword.toufu" :),
          (: perform_action, "sword.yinfeng" :),
          
            }) ); 


        setup();

        carry_object("/clone/misc/cloth")->wear();
        carry_object("/d/city/obj/gangjian")->wield();
       
}


int big_blowing()
{
remove_call_out("hurting");
message_vision( HIR "\n\n守卫者身体周围出现一层强烈的光环，随即守卫者大喝一声："BLINK HIR"乾坤借力！\n\n" NOR,
this_object());
call_out("hurting",random(2)+1);
        
        
        return 1;
}

int hurting()
{
        int i;
        int dam;
        object *inv;
        message_vision( HIR "\n\n守卫者运起毕生功力，暴喝一声："BLINK HIR"神形俱灭！\n\n"NOR,this_object());
        inv = all_inventory(environment(this_object()));
        for(i=sizeof(inv)-1; i>=0; i --)
        if( living(inv[i]))
        if( inv[i] != this_object())
        {
        dam = random(40000*2)+10000;//绝招对房间内全体生物的伤害计算。
        if(dam <0) dam = 0;
        inv[i]->receive_wound("qi",dam);
        COMBAT_D->report_status(inv[i],1);
        }
        return 1;
}
