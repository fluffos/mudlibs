#include <ansi.h>
inherit BHNPC;
int big_blowing();

void create() {

  set_name(YEL "魔尊" NOR, ({ "mo zun", "mo" }));

  set("gender", "无性");
  set("title", HIR "【" BLINK "BOSS" NOR HIR "】" NOR);
  set("age", 980);
  set("no_suck", 1);
  set("per", 30);
  set("con", 60);
  set("str", 80);
  set("int", 80);
  set("dex", 700);

  set("long",

    "900年前想独霸武林的魔尊，你最好离他远点！（BOSS）。\n");

  set("max_qi", 1800000000);
  set("max_jing", 1800000000);
  set("max_jingli", 210000000);
  set("max_neili", 210000000);
  set("jingli", 2100000000);
  set("neili", 2100000000);
  set("jiali", 10000);
  set("jh_dj/dj", 120);
  set("attitude", "aggressive");  //自动KILL玩家
  set("combat_exp", 2140000000);
  set_skill("jiuyang-shengong", 20000);
  set_skill("unarmed", 20000);
  set_skill("blade", 20000);
  set_skill("houquan", 20000);
  set_skill("dodge", 20000);
  set_skill("shenghuo-ling", 20000);
  set_skill("wudu-yanluobu", 20000);
  set_skill("taiji-quan", 20000);
  set_skill("hujia-daofa", 20000);
  set_skill("parry", 20000);
  set_skill("piaomiao-shenfa", 20000);
  set_skill("force", 20000);
  set_skill("wudu-shengong", 20000);
  set_skill("douzhuan-xingyi", 20000);
  set_skill("sword", 20000);
  set_skill("pixie-jian", 20000);
  map_skill("unarmed", "six-finger");
  map_skill("sword", "pixie-jian");
  map_skill("dodge", "piaomiao-shenfa");
  map_skill("blade", "hujia-daofa");
  map_skill("force", "jiuyang-shengong");
  map_skill("parry", "douzhuan-xingyi");
  set_temp("apply/defense1", random(1300) + 1000);
  set_temp("apply/attack1", random(3000) + 1600);
  set_temp("apply/damage", random(3000) + 1000);
  set_temp("apply/armor", random(6000) + 3000);
  set("chat_chance_combat", random(30) + 10);
  set("chat_msg_combat", ({
    (: command("say 这样居然都被你找到，正好！我可以试试刚刚练成的绝世武功！") :),
    (: exert_function, "recover" :),
    (: big_blowing :)
    //(: perform_action, "sword.suo" :),
    // (: perform_action, "sword.toufu" :),
    //(: perform_action, "sword.yinfeng" :),

  }));


  setup();

  carry_object("/clone/misc/cloth")->wear();
  carry_object("/d/heimuya/npc/obj/zhen")->wield();
  //carry_object("/d/xiaoyao/obj/blade")->wield();

}
mixed weapon_ob(object me, object victim, int damage) {
  object weapon;
  if (!weapon = me->query_temp("weapon")) {
    weapon = new("/d/heimuya/npc/obj/zhen");
    weapon->move(me);
    command("wield zhen 1");
    weapon = new("/d/heimuya/npc/obj/zhen");
    weapon->move(me);
    command("wield zhen 1");
  }
  return 0;
}

int big_blowing() {
  remove_call_out("hurting");
  message_vision(HIR "\n\n魔尊纵身跃起，一记" BLINK YEL "魔" HIC "神" HIW "掌" MAG "" NOR "向你拍了过来\n\n" NOR,
    this_object());
  call_out("hurting", random(2) + 1);


  return 1;
}

int hurting() {
  int i;
  int dam;
  object *inv;
  message_vision(HIR "\n\n魔尊向天狂吠：" BLINK HIW "人" YEL "间" HIR "炼" HIC "狱！\n\n" NOR, this_object());
  inv = all_inventory(environment(this_object()));
  for (i = sizeof(inv) - 1; i >= 0; i--)
    if (living(inv[i]))
      if (inv[i] != this_object()) {
        dam = random(65000 * 2) + 10000;  //绝招对房间内全体生物的伤害计算。
        if (dam < 0) dam = 0;
        inv[i]->receive_wound("qi", dam);
        COMBAT_D->report_status(inv[i], 1);
      }
  return 1;
}
