inherit ROOM;

void create()
{
	set("coor",({120,5180,40}));
	set("short", "峡谷");
	set("long",
"你现在正走在一条狭长的深谷之中，东西两面都是高不可攀的峭\n"
"壁，往南沿著谷底一条乾涸的山涧可以通往峡谷的出口，北边的\n"
"峭壁从这里斜斜向上宛如从天上掉下来倒插进地面，形势更是危\n"
"峻，连天空都被北边的峭壁遮去了七、八分。\n"
);
	set("exits", ([ /* sizeof() == 2 */
		"northeast" : __DIR__"canyon3",
		"southup" : __DIR__"canyon1",
]));

	setup();
	replace_program(ROOM);
}
