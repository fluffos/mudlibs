);
	set("exits", ([ /* sizeof() == 2 */
		"east" : __DIR__"cavern3",
		"southwest" : __DIR__"cavern1",
	]));
	set("objects", ([
    __DIR__"npc/fat_worm" : 2,
		/*__DIR__"npc/worm" : 3,*/
	]) );

