// by HAPP@YSZZ

inherit ROOM;

void create ()
{
        set ("short", "神殿之门");
        set ("long", @LONG

这是通往神殿的大门（gate），透过门缝可以看到美丽的白羊宫耸立在奥林
匹亚峰上！
LONG);


        set("exits", ([ 
            "northdown"  :       __DIR__"toby1",
        ]));
 set("item_desc", ([
      "gate": "一扇由精美的玉石雕凿而成，你可以试下敲（knock）它。\n",
   ]) );

        set("outdoors", "12gong");
        setup();
}
void init()
{
        add_action("do_knock","knock");
}
int do_knock(string arg)
{ 
   object member;
   object killer;
   object obj;
   mixed *ob;
   int i;       
       member = this_player()->query_team();
       if (!arg || arg != "gate")
      {
            return notify_fail("你要敲什么？\n");
      }
  if (this_player()->query_condition("can_12gong"))
       return notify_fail("你刚做完12宫的任务，请稍后再来吧！\n");
if (this_player()->query("id")=="qufo"||this_player()->query("id")=="candy") 
    return notify_fail("你给列入黑名单了，还是把机会留给别人吧。\n");

if( !pointerp(this_player()->query_team()) || !this_player()->is_team_leader() || sizeof(member) != 5 )
    return notify_fail(HIG"开启神殿之门的人必须是队伍的领袖并且队伍人数＝5人。\n"NOR);
    ob = all_inventory(environment(this_player()));
    for(i=sizeof(ob)-1; i>=0; i--)
  
if ( pointerp(ob[i]->query_team()) && sizeof(ob[i]->query_team()) == 5 && ob[i]->query_condition("can_12gong"))  
   return notify_fail("你的队员有人刚做完这个任务，现在不能与你一起前往。\n"); 
 
if ( pointerp(ob[i]->query_team()) && sizeof(ob[i]->query_team()) == 5 && ob[i]->quest("id")=="qufo" || ob[i]->quest("id")=="candy" ) 
   return notify_fail("你的队员有人给列入黑名单了，不能与你一起组队前往。\n");  

    message_vision( HIG "$N在虚空中轻轻扣动几下，一阵优美的乐声中，$N被送到了一个奇异的地方！\n" NOR, this_player());
    message("channel:chat", HIY"【黄金十二宫】雅典娜(Ya dian na):通往黄金十二宫的神殿之门，已经被某小队打开，他们即将进入神界解救聖女!\n"NOR,users());
     killer=new("/d/12gong/npc/baiyang"); 
    killer->move("/d/12gong/baiyang"); 
    ob = all_inventory(environment(this_player()));
    for(i=sizeof(ob)-1; i>=0; i--)
   if ( pointerp(ob[i]->query_team()) && sizeof(ob[i]->query_team()) == 5)
            ob[i]->move("/d/12gong/baiyang");    
   return 1;
}
