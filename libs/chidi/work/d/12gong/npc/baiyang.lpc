//黃金第一宮守護者
//死亡隨機掉祝福寶石
inherit BHNPC;
#include "star.h"
void get_date();
 
void create()
{
        set_name("阿雷斯", ({"aleisi", "bai yang"}));
        set("long", "传说中的戰神阿雷斯，守护着白羊座\n");
        set("gender","男性");
        set("title", "【战神】");
        set("age",37);
        set("attitude", "peaceful");
        set("con",30);
        set("per",30);
        set("str",25);
        set("int",35);
        set("no_suck",1);
        set("combat_exp",1000000000);
        set("dex",30); 
        set("jh_dj/dj",1000);
        set("chat_chance",500);
        
          set_skill("dodge", 20000);
          set_skill("force", 20000);
          set_skill("parry", 20000);
          set_skill("unarmed", 20000);
          set_skill("sword", 20000);
         set_skill("westsword",20000);
          set_skill("boxing",20000);
          set_skill("piaomiao-shenfa",20000);
          set_skill("taixuan-gong",20000);
        set_skill("baiyang", 20000);
        map_skill("sword","westsword");
        map_skill("unarmed","boxing");
        map_skill("spells","baiyang");
        map_skill("force","taixuan-gong");
        map_skill("dodge","piaomiao-shenfa");
         map_skill("parry","westsword");
       set("max_jingli", 21000000);
        set("jingli", 21000000);
        set("max_neili", 21000000);
        set("neili", 21000000);
         set("max_qi", 80000000);
        set("max_jing", 80000000);
        set("jiali",20000);
        set_temp("apply/defense1", 20);
        setup();
        carry_object(__DIR__"obj/by_cloth")->wear();
        carry_object("/d/obj/weapon/sword/westsword")->wield();
}
void init()
{
        add_action("do_kill","kill");
        add_action("do_none","perform");        
        add_action("do_none","conjure");
        add_action("do_none","cast");
        add_action("do_none","halt");
        add_action("do_none","teamkill");//
        add_action("do_none","touxi");//
        add_action("do_none","ansuan");//

}
int do_none()
{
        object me = this_object();
        message_vision("$N冷笑一声：我乃$N，你想耍什么花样？\n",me);
        return 1;
} 
int do_kill()
{
        object me = this_object();
        object ob = this_player();        
        //if( pointerp(ob->query_team()) && ob->is_team_leader())//必须组队并且是队长
        //{
        set_temp("my_killer",ob);
//copy对方的HP和特殊攻击和防御等属性 
       ob->set_temp("apply/attack",me->query_temp("apply/attack"));//
       ob->set_temp("apply/dodge",me->query_temp("apply/dodge"));//
       ob->set_temp("apply/force",me->query_temp("apply/force"));//
         if (ob->query_temp("apply/defense1"))
        me->set_temp("apply/defense1",ob->query_temp("apply/defense1"));
         if (ob->query_temp("apply/attack1"))
        me->set_temp("apply/attack1",ob->query_temp("apply/attack1"));  
         if (ob->query_temp("apply/dodge"))
        me->set_temp("apply/dodge",ob->query_temp("apply/dodge"));  
          if (ob->query_temp("apply/force"))
        me->set_temp("apply/force",ob->query_temp("apply/force"));       
        return 0;
        //   }else{
        //message_vision("$N冷笑一声：只有队伍的队长才由资格杀我，你想耍什么花样？\n",me);
        //return 1;
       //}
} 
void check()
{
        object ob=this_object();
        object me=query_temp("my_killer");

     if( ! me ) return ;

     if(! present(me,environment()) )
     {
     remove_call_out("check");
     if(ob)
         destruct(ob);
     return;
     }
     if( me->is_ghost() )
     {
     remove_call_out("check");
     return;
     } 
//copy对方的特殊攻击和防御等属性
    ob->set_temp("apply/attack",me->query_temp("apply/attack"));//
    ob->set_temp("apply/dodge",me->query_temp("apply/dodge"));//
    ob->set_temp("apply/force",me->query_temp("apply/force"));//
       if (me->query_temp("apply/defense1"))
           ob->set_temp("apply/defense1",me->query_temp("apply/defense1"));
       if (me->query_temp("apply/attack1"))
           ob->set_temp("apply/attack1",me->query_temp("apply/attack1"));  
       if (me->query_temp("apply/dodge"))
           ob->set_temp("apply/attack1",me->query_temp("apply/dodge"));
       if (me->query_temp("apply/force"))
           ob->set_temp("apply/force",me->query_temp("apply/force"));   
   
     switch(random(6))
     {        
        case 0:
        {
        message_vision(HIR"$N双手一挥，一团烈火直冲$n而去！\n",ob,me);

        if(random(2))
        
                {
              message_vision(HIR"$N被$n的烈火烧个焦头焦脸！\n"NOR,me,ob);
              me->receive_wound("qi", query("max_neili")/5);
              me->receive_wound("jing", query("max_jingli")/10);
                }
        else
        message_vision(HIR"$N轻而易举的躲过了$n的攻击！\n"NOR,me,ob);
        }
        break;


        case 1:
        {

        message_vision(HIR"$N吹了起横笛，顿时一只白羊向$n直冲而去！\n",ob,me);

        if(random(2))

                {
              message_vision(HIR"$N被白羊撞了个人仰马翻！\n"NOR,me);
              me->receive_wound("qi", 2*query("max_neili")/5);
              me->receive_wound("jing", 2*query("max_jingli")/10);
                }
        else
        message_vision(HIR"$N对着白羊大喝一声：停！白羊乖乖从旁边溜开了！\n"NOR,me);
        }
        break;

        case 2:
        {

        message_vision(HIR"$N手中长剑变的硕大无比，直插$n后腰\n",ob,me);

        if(random(2))

                {
              message_vision(HIR"$N顿时血流如注，顷刻染红了全身！\n"NOR,me);
              me->receive_wound("qi", 2*query("max_neili")/5);
              me->receive_wound("jing", 2*query("max_jingli")/10);
                }
        else
        message_vision(HIR"$N顺着剑的方向，纵身跃起，躲过这致命一击！\n"NOR,me);
        }
        break;

  }
        if( random(8) == 5 )
        powerup();

        remove_call_out("check");
        call_out("check",2+random(3));
}
void die()
{
        string *dir,file;
        object equip;
        object killer;
        object me=this_object();
        object ob = query_temp("my_killer");

        if( ob && random(30) < 1 )
        { 
           
               dir = get_dir("/clone/misc/newitem/item/");
               file = "/clone/misc/newitem/item/"+dir[random(sizeof(dir))];
               equip = new(file);
               if( objectp(equip) )
               {
                 equip->change_ob(me,ob);
                 equip->move(ob);
                 tell_object(all_inventory(environment(me)),
                             BLINK+HIB"只听“哐铛”一声，好象一样东西从"
                             +me->name()+"的尸体中掉了出来···\n"NOR);
                 tell_object(all_inventory(environment(me)),
                             HIW+ob->name()+"看见了稀世珍宝"HIW+equip->name()+HIW+"从"HIW+me->name()+"身上掉下，立刻把它拣了起来！\n" NOR);              
               }
         
         }

        ob->start_busy(3);
        killer=new("/d/12gong/npc/jinniu"); 
        killer->move("/d/12gong/jinniu"); 
        message("chat",HIY+"【黄金十二宫】雅典娜(Ya dian na):"+ob->name()+
        "闯过了"+environment(ob)->query("short")+"\n"NOR,users());
        ob->add("12gong/number",1);
       ::die();
}
