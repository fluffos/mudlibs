// by happ@YSZZ

inherit BHNPC;
string ask_cloth();
#include <ansi.h>

void create()
{
   set_name("雅典娜", ({ "yadian na", "na" }));
   set("long", @LONG

LONG);
   set("gender", "女性");
   set("age", 20);
   set("no_suck",1);
   set("attitude", "peaceful");
   set("per",100);//means no rong-mao description.
   set("long", "传说中的雅典女神，她正在等待解救她的“黃金戰士”！\n");
   set("max_qi", 2100000000);
   set("max_jing", 2100000000);
   set("max_jingli", 210000000);   
   set("max_neili", 210000000);
   set("jingli", 2100000000);   
   set("neili", 2100000000);    
   set("jiali", 21000000);    
   set("combat_exp", 2140000000);
   set_skill("spells", 1900000);
   set_skill("buddhism", 19000000);
   set_skill("unarmed", 19000000);
   set_skill("jienan-zhi", 19000000);
   set_skill("dodge", 19000000);
   set_skill("lotusmove", 19000000);
   set_skill("parry", 19000000);
   set_skill("force", 19000000);
   set_skill("lotusforce", 19000000);
   set_skill("staff", 19000000);
   set_skill("lunhui-zhang", 19000000);
   map_skill("spells", "buddhism");
   map_skill("unarmed", "jienan-zhi");
   map_skill("dodge", "lotusmove");
   map_skill("force", "lotusforce");
   map_skill("parry", "lunhui-zhang");
   map_skill("staff", "lunhui-zhang");
   set_temp("apply/defense1", 1500000);
   set_temp("apply/attack1",  1500000);
   set("chat_chance_combat", 90);
   set("chat_msg_combat", ({
      (: cast_spell, "bighammer" :),
   }) );
   set("inquiry",([
      "黄金战士": (: ask_cloth:) ]));

   setup();
  carry_object("/d/12gong/obj/armor")->wear();
  carry_object("/d/12gong/obj/cloth")->wear();
  carry_object("/d/12gong/obj/pifeng")->wear();
  carry_object("/d/12gong/obj/shield")->wear();
  carry_object("/d/12gong/obj/staff")->wield();
}

string ask_cloth()
{
        object ob = this_object();
        object me = this_player();
        string *dir,file;
        mixed *obj;
        int i;
        object equip,equip1;
//队长奖励
       if( me->query("12gong/number") >= 12 && me->query("item/12gong/all") > 0 )
       {            
        if (!me->query("item/12gong/gift"))
        me->set("item/12gong/gift",0);
        dir = get_dir("/clone/misc/newitem/obj/");
        file = "/clone/misc/newitem/obj/"+dir[random(sizeof(dir))];
           if( file_size(file) != -1 )
           {
               equip = new(file);               
               if( objectp(equip) )
               {
                 equip->change_ob(me,ob);
                 equip->move(me);
                 tell_object(me,HIY"妳獲得了"+equip->name()+HIY"獎勵！\n" NOR);    
                 me->delete("12gong");
                 me->apply_condition("can_12gong",360);          
               }
		   //command("chat "HIY+me->name()+"带领他英勇的小队解救了我，成功获得了"+equip->name()+HIY"獎勵！");
		   command("chat "HIY+me->name()+"英勇的解救了我，成功获得了"+equip->name()+HIY"獎勵！");
            }
//额外奖励
		if (me->query("item/12gong/all")==10 && me->query("item/12gong/gift") == 0 )
              {
               equip1 = new("/clone/misc/newitem/obj/zf_stone",2);
               equip1->move(me);
               me->set("item/12gong/gift",1);
               tell_object(me,HIY"由于妳勇敢的完成10次任務，將額外獲得"+equip1->name()+HIY"獎勵！\n" NOR);
		 command("chat "HIY+me->name()+"出色的完成了10次任务，额外得到"+equip1->name()+HIY"獎勵！");  
                 }
		if (me->query("item/12gong/all")== 20 && me->query("item/12gong/gift") == 1 ) 
              {
               equip1 = new("/clone/misc/newitem/obj/lh_stone");
               equip1->move(me);
               me->set("item/12gong/gift",2);
               tell_object(me,HIY"由于妳勇敢的完成20次任務，將額外獲得"+equip1->name()+HIY"獎勵！\n" NOR);
		 command("chat "HIY+me->name()+"出色的完成了20次任务，额外得到"+equip1->name()+HIY"獎勵！");
                }
		 if (me->query("item/12gong/all")== 30 && me->query("item/12gong/gift") == 2 )
              {
               equip1 = new("/clone/misc/newitem/obj/cz_stone");
               equip1->move(me);
               me->delete("item/12gong/all");
               me->delete("item/12gong/gift");
               tell_object(me,HIY"由于妳勇敢的完成30次任務，將額外獲得"+equip1->name()+HIY"獎勵！\n" NOR);
		 command("chat "HIY+me->name()+"出色的完成了30次任务，额外得到"+equip1->name()+HIY"獎勵！");
               }
  
//将玩家自动送到武庙
			     tell_object(me,HIY"让我送你一程吧！空间逆转.......\n" NOR);
			     me->move("/d/wizard/guest_room"); 
		            return "恭喜妳们獲得如此珍貴的禮物！";		     
    }
return "你是怎么来到这里的???";               
}

