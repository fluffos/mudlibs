inherit ROOM;

int flag = 0;


void create ()
{
        set ("short", "神殿之门");
        set ("long", @LONG

这是通往神殿的大门（gate），透过门缝可以看到美丽的白羊宫耸立在奥林
匹亚峰上！
LONG);


        set("exits", ([ 
            "northdown"  :       __DIR__"toby1",
        ]));
 set("item_desc", ([
      "gate": "一扇由精美的玉石雕凿而成，你可以试下敲（knock）它。\n",
   ]) );

        set("outdoors", "12gong");
        setup();
}
void init()
{
        add_action("do_knock","knock");
}
