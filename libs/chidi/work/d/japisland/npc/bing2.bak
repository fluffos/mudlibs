#include <globals.h>
#include <ansi.h> 

inherit NPC;

//inherit "/d/japan/npc/offense_wokou";
void smart_fight();
void create()
{       
        
                                string *name= ({"蒙面忍者", "黑衣忍者","白衣忍者"});
        set_name(name[random(3)], ({ "jap badguy", "badguy"}) );
        set("title", HIY"倭寇"NOR); 
        set("long","
来自东瀛的强盗，他们烧杀抢掠，无恶不作。在日出城东边的小岛上有他们
的营地，是进攻日出城的基地。\n");
        set("attitude", "aggressive");
        set("no_return",1);
        //set("bellicosity", 1);
        set("no_arrest",1);
        set("wokou",1);
        set("str", 100);
        set("combat_exp", 15000000);
        set("class","ninja");
        set("max_kee",30000);
        set("max_sen",10000);
        set("max_gin",10000);
        
        set("chat_chance_combat", 99);
        set("chat_msg_combat", ({
                //(: perform_action, "blade.gobankiri" :), 
                //(: perform_action, "blade.hyakki" :), 
                //(: perform_action, "blade.leitingpili" :), 
                (: smart_fight() :), 
        }) ); 
        set_skill("force",100);
        set_skill("ghosty-force",100);
        set_skill("unarmed", 200);
        set_skill("blade", 150);
        set_skill("parry", 150);
        set_skill("dodge", 150);
        set_skill("ittouryu",160);
        set_skill("kongshoudao",160);
        set_skill("move",200);
        set_skill("enmeiryu",200); 
        
        map_skill("unarmed", "kongshoudao");
        map_skill("blade","ittouryu");
        map_skill("parry","ittouryu");
        map_skill("force","ghosty-force"); 
        set_temp("apply/armor", 70);
        set_temp("apply/move", 100); 
        set("resistance/kee",20);
        set("resistance/gin",20);
        set("resistance/sen",20);
        
        /*set("chat_chance", 10);
        set("chat_msg", ({
                (: random_move :),
        }) ); */
        
        setup(); 
        carry_object(__DIR__"obj/armor")->wear();
        carry_object(__DIR__"obj/blade2")->wield();
        //set("start_action",0);
} 

varargs void invocation(int exp,int life_bonus,object who)
{
        exp = exp*4/3;
//        ::invocation(exp,life_bonus,who);
        }

void smart_fight() {
 object me;
 me = this_object();
 
 if (query_temp("weapon")) { 
                if (random(3))
                        ccommand("perform leitingpili");
                else
                        ccommand("perform gobankiri");
                }
 else { 
                        ccommand("perform yaozhan");
 }
}
void unconcious()
{
        die();
}
void die()
{
        int gin,kee,sen,i,j;
        int expg,potg,scoreg,moneyg;
        object room;
        object *inv;
        string reward_msg;
	if(objectp(killer = query_temp("last_damage_from")))
        if (objectp(killer))
        {
                if(killer->query("possessed")) killer =killer->query("possessed");
                killer->add_temp("jap_badguy/bing2", 1);
        }
        this_object()->remove_all_killer();

         message_vision(HIW"$N叫道：八格！八格呀噜！\n"NOR,this_object());
        destruct(this_object());
        return ; 
}   
