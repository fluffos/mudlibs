  set_skill("wuhu-blade", 1260);
  set_skill("mingyu-gong", 1500);
  set_skill("yueying-wubu", 1250);
  set_skill("lianhuan-zhang", 1200);
  set_skill("xiantian", 1200);
  set_skill("xuanhu-blade", 1200);
  set_skill("moonforce", 1200);
