void init() {

  object me;

  ::init();
  if (interactive(me = this_player()) && !is_fighting()
    && living(me)) {
    call_out("greeting", 1, me);
  }

}

void greeting(object me) {

  object ob = this_object();
  if (!me || environment(me) != environment()) return;
  kill_ob(me);
  me->kill_ob(ob);
  return;

}



varargs void invocation(int exp, int life_bonus, object who) {
  exp = exp / 3 * 3;
  //        ::invocation(exp,life_bonus,who);
}

void smart_fight() {
  object me;
  me = this_object();

  if (query_temp("weapon")) {
    if (random(5)) {
      {
        command("enforce 500");
        command("enable blade kugu-blade");
        command("perform pozhan");
        command("enable blade xuanhu-blade");
        command("perform daojianruomeng");
        command("enable blade tianxin-blade");
        command("perform zhan");
        command("enable blade shenji-blade");
        command("perform jichulianhuan");
        command("enable blade ittouryu");
        command("perform gobankiri");
        command("perform hyakki");
        command("perform duomingqisha");
        command("perform tianlangshixue");

      }


    } else


    {

      command("enforce 500");
      command("enable blade kugu-blade");
      command("perform pozhan");
      command("enable blade xuanhu-blade");
      command("perform xuanhu");
      command("enable blade tianxin-blade");
      command("perform zhan");
      command("enable blade bingpo-blade");
      command("perform hgz");
      command("perform xuan");
      command("perform yushijufen");
      command("enable blade ittouryu");
      command("perform gobankiri");
      command("perform hyakki");
      command("perform duomingqisha");
      command("perform tianlangshixue");


    }


  } else {
    command("enforce 560");
    command("enable unarmed moyun-shou");
    command("perform pofuchenzhou");
    command("enable unarmed dragonfight");
    command("perform baiyue");
    command("perform pini");
    command("perform sheshen");
    command("perform wuhui");
    command("enable unarmed cuixin-zhang");
    command("perform cuixin");
    command("enable unarmed lianhuan-zhang");
    command("perform nianhua");



  }
}

