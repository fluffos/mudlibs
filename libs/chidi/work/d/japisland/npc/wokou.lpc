  set_skill("wanxi-spells", 1200);
  set_skill("wanxi-force", 1200);
  set_skill("dragonforce", 1200);
  set_skill("seashentong", 1200);
  set_skill("dragonfight", 1200);
  set_skill("cuixin-zhang", 1200);
  set_skill("moyun-shou", 1200);
  set_skill("huomoforce", 1200);
  map_skill("blade", "ittouryu");
  map_skill("parry", "mingyu-gong");
  map_skill("dodge", "yueying-wubu");
  //map_skill("dodge","fall-steps"); 
  map_skill("force", "xiantian");
  map_skill("spells", "baguazhou");
  map_skill("unarmed", "lianhuan-zhang");
  set("max_force", 10300000 + 1500 * laa);
  set("force", 23000000 + 500 * laa);
  set("max_mana", 10300000 + 1500 * laa);
