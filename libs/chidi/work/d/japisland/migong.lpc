
//倭寇岛迷宫
//tomcat 
//inherit VRM_SERVER;
inherit "/adm/daemons/vrm_server";

void create()
{
	// 迷宫房间所继承的物件的档案名称。
	set_inherit_room( __DIR__"wokouroom" );

	//刷新时间
	set_maze_refresh(1864000);
	
	//迷宫的单边长
        set_maze_long(15);

	//入口方向(出口在对面)
	set_entry_dir("west");

	//入口与区域的连接方向
	set_link_entry_dir("west");

	//入口与区域的连接档案名
	set_link_entry_room(__DIR__"rukou");

	//出口与区域的连接方向
	set_link_exit_dir("east");

	//出口与区域的连接档案名
	set_link_exit_room(__DIR__"home");

	//入口房间短描述
	set_entry_short("倭寇岛入口");

	//入口房间描述
	set_entry_desc(@LONG
这里是危机暗藏的小路
LONG);

	//出口房间短描述
	set_exit_short("倭寇岛大路");

	//出口房间描述
	set_exit_desc(@LONG
这里是小路
LONG
);

	//迷宫房间的短描述
	set_maze_room_short("倭寇岛危机暗藏的小路");

	//迷宫房间的描述，如果有多条描述，制造每个房
	//间的时候会从中随机选择一个。
	set_maze_room_desc(@LONG
这里是小路,周倭寇聚集,经常打家抢舍，胡乱撕杀。	
LONG
);

	//set_link_entry_room_x(10010);
	//set_link_entry_room_y(1880);
	//set_link_entry_room_z(0);

	// 迷宫房间是否为户外房间？
	set_outdoors(1);
}

