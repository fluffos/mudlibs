inherit ROOM;
#include <ansi.h> 
int new_random(int ran);


void create()
{


        set("short", "倭寇岛小路");
        set("long", @LONG
小路坑洼不平，很是难走
LONG
        );
        set("objects", ([
        __DIR__"npc/bing1": new_random(10),
        __DIR__"npc/bing2": new_random(10),
        __DIR__"npc/bing3": new_random(30),
        __DIR__"npc/bing4": new_random(40),
        __DIR__"npc/jiang1": new_random(20),
        __DIR__"npc/jiang2": new_random(40),
 __DIR__"npc/shuai1": new_random(3),

                        ]) );
        set("indoors", "japisland");
      //  set("no_death_penalty",1);
     //   set("can_dazuo",1);
        setup(); 
}  
int new_random(int ran)
{
	if(random(110)<=ran) return 1;
	else return 0;
}
int valid_leave(object obj, string dir){
        object another;
        seteuid(getuid());
        
        if (!wizardp(this_player()) && present("jap badguy", this_object()))
        {
                another = present("jap badguy", this_object());
                return notify_fail(another->name()+"闪身挡住了你的路。\n");
        }
        return 1;
}    
