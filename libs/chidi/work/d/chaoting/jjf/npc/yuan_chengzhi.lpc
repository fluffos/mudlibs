#pragma save_binary
// yuan_chengzhi.c 


int get_map(object me);
inherit BHNPC;

void create()
{
set_name("袁承志", ({ "yuan chengzhi", "yuan" }));
set("gender", "男性");
 set("age", 15);

set("inquiry", ([
                "拼地图" :  (: get_map :),
                 "地图" : (: get_map :),]) );

   set("combat_exp", 10000);
        set_skill("unarmed", 35);
        set_skill("force", 35);
        set_skill("dodge", 40);
        set_temp("apply/attack", 30);
        set_temp("apply/defense", 40);
  set("shen_type", 1);
	setup();
	carry_object("/d/city2/obj/diaopi")->wear();
 add_money("silver", 30);

}
	
int get_map(object me)
{ object *list,map;
        int i,k,g;

        me = this_player ();

        list = all_inventory(me);
        k = 8;
        g = 0;
        while (k--) {   i = sizeof(list);   
        while (i--) {
   if ((string)list[i]->query("id") == sprintf("map%d",k+1)
 &&list[i]->query("material")=="copper")
         { g=g+1;break;}             }
                     }
if (g==8)
  { map = new("/d/chaoting/jjf/obj/map0.lpc");
     map->move(me);
     command("say 这是我拼出来的，拼得好不好啊？\n");
  command("chat 据说"+this_player()->query("name")+"有一张全国军事地图，快来抢啊!\n");
    call_out("todest",1,me);
     return 1;
   }
if (g==0)
   { command("say 你没有地图叫我，如何来拼?\n");
     return 1;
   }
     command("say 地图太少，拼不出来，照我看应该有八块。\n");
     return 1;

}
void todest(object me)
{
object *list;
int k,i;
  k = 8;
while (k--) {   list = all_inventory(me);i = sizeof(list);   
        while (i--) {
   if ((string)list[i]->query("id") == sprintf("map%d",k+1)
   &&list[i]->query("material")=="copper")
 { destruct(list[i]);break;}             }

          }
}
