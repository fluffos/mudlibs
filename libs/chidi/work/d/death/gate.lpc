// gate.c
#include <ansi.h>
#include <command.h>
#include <login.h>

inherit ROOM;
void create() {
  set("short", HIW "鬼门关" NOR);
  set("long",
    "这里就是著名的阴间入口「鬼门关」，在你面前矗立著一座高大的\n"
    "黑色城楼，许多亡魂正哭哭啼啼地列队前进，因为一进鬼门关就无法再\n"
    "回阳间了。\n");
  set("exits", ([
    "north": "/d/death/gateway",
  ]));
  set("valid_startroom", 1);
  set("no_fight", 1);
  set("no_fight_npc", 1);
  set("objects", ([
    //__DIR__"npc/wgargoyle":1
  ]));
  setup();
}
void init() {
  int i;
  object *inv, me;
  me = this_player();
  if (!me->is_ghost()) {
    write(HIW "白无常说道：“阳人来阴间做什么？我送你回去吧！”\n" NOR);
    me->move(REVIVE_ROOM);
    return;
  }

  me->reincarnate();
  inv = all_inventory(me);
  for (i = 0; i < sizeof(inv); i++)
    DROP_CMD->do_drop(me, inv[i]);
  write(HIW "白无常说道：喂！新来的，你叫什么名字？\n" NOR);
  write(HIW "白无常用奇异的眼光盯著你，好像要看穿你的一切似的。\n" NOR);
  write(HIW "白无常「哼」的一声，从袖中掏出一本像帐册的东西翻看著。\n" NOR);
  write(HIW "白无常合上册子，说道：咦？阳寿未尽？怎么可能？\n" NOR);
  write(HIW "白无常搔了搔头，叹道：罢了罢了，你走吧。\n" NOR);
  write(MAG "一股阴冷的浓雾突然出现，很快地包围了你。\n" NOR);
  me->move(REVIVE_ROOM);
  message("vision",
    "你忽然发现前面多了一个人影，不过那人影又好像已经在那里\n"
    "很久了，只是你一直没发觉。\n", environment(me), me);

}
