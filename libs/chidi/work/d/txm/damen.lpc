// /d/txm/damen.c
inherit ROOM;
void create() {
  set("short", HIR "铁血盟大门" NOR);
  set("long",

    "" BRED + YEL "来到此处，你突然觉得眼前一片开阔，似乎有个
巨人在泰山腰半处用巨斧劈凿出这么一个所在。面前是由
腿般粗、一人半高的柳木桩密密匝匝扎成的栅栏，靠中间
用巨木搭成一个门形。左右两边权做门框的巨木上各挂着
条长幅，门檐上还有块匾，上书三个大字。\n\n" NOR + HIW "  

            ※※※※※※※※
    ┌─┐   ※铁   血   盟※   ┌─┐
    │九│   ※※※※※※※※    │一│
    │霄│                     │腔│
    │正│                     │豪│
    │气│                     │情│
    │快│                     │遍│
    │意│                     │洒│
    │江│                     │天│
    │湖│                     │地│
    └─┘                     └─┘

       \n" NOR);
  set("no_die", 1);
  set("no_fight_npc", 1);
  //set("no_fight", 1);
  set("no_steal", 1);
  set("exits", ([
    "north": "/d/xingxiu/xxroad2",
    "south": "/d/txm/guangchang",
  ]));

  set("objects", ([
    "/kungfu/class/txm/menwei": 2,
  ]));
  set("no_clean_up", 0);
  set("outdoors", "txm");
  setup();
  replace_program(ROOM);
}
int valid_leave(object me, string dir) {
  if ((dir == "south")
    && ((string)me->query("family/family_name") != "铁血盟")
    && objectp(present("men wei", environment(me))))
    return notify_fail("门卫喝道：闲杂人等禁入铁血盟！！”\n");
  return ::valid_leave(me, dir);
}
