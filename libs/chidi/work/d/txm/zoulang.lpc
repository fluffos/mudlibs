inherit ROOM;

void create() {
  set("short", "走廊");
  set("long", @LONG
  这里是碧血铁胆堂的二楼走廊，两边的墙上点着盏盏油灯，
发出鹅黄光芒，显得有些神秘。走廊两端的尽头并没有出口，
的确是不同寻常。可是如此重要的地方不会空建一条走廊，所
以你不由认定这里必有通往它地的门径。旁边墙壁上有张很奇
怪的字画(zihua)，你不禁但看了几眼。
LONG);

  set("exits", ([ /* sizeof() == 2 */
    "down": __DIR__ "tiedantang",
    "up": __DIR__ "gongdian",
  ]));
  set("objects", ([ /* sizeof() == 1 */
    //              __DIR__"npc/xuncha" : 1,
    __DIR__ "npc/npcdoga": 1,

  ]));
  set("no_clean_up", 0);
  set("outdoors", "txm");


  setup();
  replace_program(ROOM);
}
