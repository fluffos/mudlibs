inherit ROOM;

void create() {
  set("short", "四使厅");
  set("long", @LONG
  转过屏风，你来到了一间宽敞的厅堂。四角是合抱的大柱，高悬
着的匾上写着三个大字：四使厅。原来这里是铁血盟江湖四使者议事
的地方。厅堂的正中央摆着一张四方红木大桌，四边各有一张红木长
背靠椅。靠墙木架上的青铜小炉焚着上好的香，令来者心旷神仪。
LONG);

  set("exits", ([ /* sizeof() == 2 */
    "east": __DIR__ "juxieting",
  ]));
  set("objects", ([ /* sizeof() == 1 */
    __DIR__ "npc/xuncha": 1,
    __DIR__ "npc/npcdoga": 1,
  ]));
  set("no_clean_up", 0);
  set("outdoors", "txm");


  setup();
}
