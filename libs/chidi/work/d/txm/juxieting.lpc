    "north": __DIR__ "guangchang",
    "south": __DIR__ "tiedantang",
    "west": __DIR__ "sishiting",
    "east": __DIR__ "sitanshi",
  ]));
  set("objects", ([ /* sizeof() == 1 */
    //                __DIR__"npc/xuncha" : 1,
    __DIR__ "npc/npcdoga": 1,
  ]));
  set("no_clean_up", 0);
