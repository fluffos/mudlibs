// shoumu.c
#include <ansi.h>
inherit BHNPC;
void create() {
  set_name("守墓家奴", ({ "shoumu jianu", "jianu" }));
  set("long",
    "这是一个专门看守墓地的仆人。\n");
  //set("attitude", "heroism");
  set("attitude", "aggressive");  //自动KILL玩家
  //set("vendetta_mark", "authority");
  set("pursuer", 1);
  set("str", 270);
  set("cor", 260);
  set("cps", 250);
  set("max_qi", 250000000);
  set("max_jing", 250000000);
  set("max_neili", 250000000);
  set("max_jingli", 250000000);
  set("jiali", 250);

  set("jh_dj/dj", 30);
  set("combat_exp", 1000000000);
  set("chat_chance_combat", 15);
  set("chat_msg_combat", ({
    "守墓人喝道：你好大的胆子，竟敢动墓穴中的东西！\n",
    "守墓人喝道：要让岛主知道，非扒了你的皮不可！\n"
  }));
  set_skill("wudu-goufa", 5000);
  set_skill("sword", 5000);
  set_skill("wudu-shengong", 5000);
  set_skill("parry", 5000);
  set_skill("dodge", 5000);
  map_skill("sword", "wudu-goufa");
  map_skill("parry", "luoying-shenjian");
  add_temp("apply/attack", 500);
  add_temp("apply/defense", 500);
  add_temp("apply/damage", 500);
  add_temp("apply/armor", 1500);
  setup();
  carry_object("/clone/misc/cloth")->wear();
  carry_object("/clone/weapon/changjian")->wield();
}
