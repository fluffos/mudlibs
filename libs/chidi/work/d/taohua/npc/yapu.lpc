inherit BHNPC;
void create() {
  set_name("哑仆", ({ "yapu" }));
  set("gender", "男性");
  set("age", 56);
  set("long",
    "这是位既聋且哑，满脸风霜之色的老仆人。\n");
  //        set("attitude", "peaceful");
  set("str", 28);
  set("no_suck", 1);
  set("int", 17);
  set("con", 25);
  set("dex", 21);
  set("max_qi", 13000000);
  set("max_jing", 13000000);
  set("max_jingli", 13000000);
  set("jingli", 13000000);
  set("neili", 13000000);
  set("max_neili", 13000000);
  set("jiali", 8000);
  //set("attitude", "aggressive"); 自动KILL玩家
  set("jh_dj/dj", 20);
  set("combat_exp", 2000000000);
  set_skill("force", 3000);
  set_skill("huntian-qigong", 3000);
  set_skill("unarmed", 3000);
  set_skill("xianglong-zhang", 3000);
  set_skill("dodge", 3500);
  set_skill("xiaoyaoyou", 3500);
  set_skill("parry", 3500);
  set_skill("begging", 3000);
  set_skill("stealing", 3000);

  set_temp("apply/defense1", random(300) + 100);
  set_temp("apply/attack1", random(1300) + 600);
  set_temp("apply/damage", random(3000) + 100);
  set_temp("apply/armor", random(6000) + 1000);


  map_skill("force", "huntian-qigong");
  map_skill("unarmed", "xianglong-zhang");
  map_skill("dodge", "xiaoyaoyou");
  map_skill("parry", "xianglong-zhang");

  setup();
  carry_object("/clone/misc/cloth")->wear();
  if (random(10) > 3)
    carry_object("/d/taohua/obj/xiang");

