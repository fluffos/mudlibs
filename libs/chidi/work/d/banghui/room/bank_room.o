// a skeleton for user rooms  bank_room.o
inherit ROOM;
void create()
{
set("short", "SHORT_TITLE");
set("long", @LONG
LONG_TITLE
LONG
);
set("exits", ([
]));

set("objects", ([
"/d/shaolin/npc/mu-ren" : 3,
]) );

set("owner","CLYOWNER");
set("createuser","CLYCREATEUSER");
set("kickroom","CLYKICKROOM");
set("valid_startroom",1);
set("no_fight",1);
set("outdoors", "CLYOWNER");
set("bhroomtype",7);

set("no_clean_up",1);

setup();

}

void init()
{
	object ob=this_player();

	if((string)ob->query("banghui/name") != environment(ob)->query("owner") && environment(ob)->query("kickroom") && wiz_level(ob) < 1)
	{
		message("vision",HIY"〖帮派总坛〗"NOR+":"+HIY" " + ob->query("name") + "于今日" + NATURE_D->game_time() + "企图闯入" + environment(ob)->query("owner") + "总坛,被赶了出来!\n"NOR,users());
		message_vision(HIR"门卫突然从里面冲了出来给$N一脚,$N惨叫一声,被踢了出来。\n"NOR,this_player());
		ob->move(environment(ob)->query("kickroom"));
    }
}
