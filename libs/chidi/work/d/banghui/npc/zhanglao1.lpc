inherit BHNPC;
#include <ansi.h>
int place_room(object me,object ob);
string ask_job();
string ask_cancel();

void create()
{
        set_name(HIC"CLYNAME"NOR, ({ "CLYFULLID", "CLYFIRSTID" }));
        set("gender", "男性");
        set("age", 40+random(50));
        set("long", 
"他看起来有些老态龙钟的，两条雪白的眉毛垂到嘴角。\n");
        set("combat_exp", 30000000);
        set("shen_type", 0);
		set("max_neili", 100000000);
		set("neili", 100000000);
		set("max_qi",20000000);
		set("qi",20000000);
		set("max_jing",20000000);
		set("jing",20000000);
		set("max_jingli",100000000);
		set("jingli",100000000);
		set("per",random(30));
		set("jiali", 1000000);
        set("jiali", 400);
        set_skill("force", 500);
        set_skill("unarmed", 500);
        set_skill("dodge", 500);
        set_skill("parry", 500);
        set_skill("jiuyang-shengong",500);

		set("banghui/name","CLYOWNER");
		set("banghui/rank","任务长老");
        set("banghui/rank_lv", 8);

        set("inquiry", ([
                "quest" : (: ask_job :), 
                "job"   : (: ask_job :), 
                "工作"  : (: ask_job :),
				"cancel" : (: ask_cancel :),
       ]) );
        set("no_clean_up",1);

		set_temp("apply/attack", 1000000);
		set_temp("apply/defense", 1000000);
		set_temp("apply/damage", 1000000);

        setup();
        carry_object("/clone/weapon/changjian")->wield();
        carry_object("/clone/misc/cloth")->wear();
}

string ask_job()
{   
    int kill_count,reward_exp,reward_pot,reward_rmb,reward_gold;
    object me,killer,lingpai;
    me=this_player();

 if(me->query("banghui/name") != query("banghui/name"))
	 return CYN+"想加入我们帮派就去找帮主吧！\n"+NOR;

 if(me->query("combat_exp")< 200000000)//经验下限2亿
     return CYN"你的身手不行，还不赶紧回去习武！\n"NOR;

 if(me->query("bh_quest") && me->query_temp("bh_quest/have_task"))
	return HIW+me->query("name")+",你现在的任务是去除掉在"
         +me->query("bh_quest/killed_place_name")
         +"一带活动的"+me->query("bh_quest/killed_name")+"("
         +me->query("bh_quest/killed")+")。\n"+NOR;

 if(!me->query_temp("bh_quest/killed") && (time()-(int)me->query("bh_quest/time"))< 40)
	 return	CYN+"帮会大事，岂能儿戏！\n"+NOR;

 if( me->query_temp("bh_quest/count") > 14
     && !me->query_temp("bh_quest/reward"))
   {
    reward_exp=(int)me->query("combat_exp")/100;
    if(reward_exp>200000) reward_exp=200000;
    reward_exp=reward_exp+random(reward_exp);
	reward_pot=reward_exp/4;
    me->add("bh_quest/reward_exp",reward_exp);
    me->add("bh_quest/reward_potential",reward_pot);
    me->add("combat_exp", reward_exp);
    me->add("potential", reward_pot);
	reward_rmb = 50+random(50);
	reward_gold = reward_rmb + random(reward_rmb*2);
	me->add("money",(reward_gold/2)*10000);
    me->add("rmb", reward_rmb/2);
    me->set_temp("bh_quest/reward",1); 

	lingpai = new("clone/misc/lingpai");
	lingpai->create( me->query("banghui/name") );
	lingpai->add("rmb",reward_rmb/2);
	lingpai->add("money",reward_gold/2);
	lingpai->save();
	destruct(lingpai);

	reward_gold = me->query("bhgxrest") + (((reward_rmb - reward_rmb/2) % 3000) / 3) + ((reward_gold - reward_gold/2) % 15000) / 15;
	me->add("bhgx", reward_gold/1000);
	me->set("bhgxrest", reward_gold%1000);

    return 
HIW+me->query("name")+", 帮会在你的帮助努力之下势力大增。\n鉴于你出色的表现，老夫要额外嘉奖你：\n"+
CHINESE_D->chinese_number(reward_exp) +"点的『实战经验』 "+
CHINESE_D->chinese_number(reward_pot)+"点的『潜能』！\n"+
CHINESE_D->chinese_number(reward_gold) +"两的『黄金』 "+
CHINESE_D->chinese_number(reward_rmb) +"圆的『人民币』\n"+
"其中一半自动转入帮会用作帮会建设，你为帮会的贡献会有回报的。"NOR; 
    }

	if( me->query_temp("bh_quest/count") > 14)
	{
		me->set_temp("bh_quest/reward",0); 
		me->set_temp("bh_quest/count", 0);
	}
   killer=new("/d/banghui/npc/job_npc");
   place_room(me,killer);
   killer->start_escape(killer,me);
   me->set("bh_quest/killed",killer->query("id"));
   me->set("bh_quest/killed_name",killer->query("name"));
   me->set("bh_quest/killed_place_name",killer->query("area"));
   me->set("bh_quest/time",time());
   me->set_temp("bh_quest/have_task",1);
   return 
    HIC+me->query("name")+"，帮会在"+HIG+killer->query("area")+HIC+"的活动遇到了障碍，\n"
	+HIG+killer->query("title")+killer->query("name")+"("+killer->query("id")+")"+HIC+"一直破坏我们的计划，现在你就去除掉他吧。\n"
    +"你可不要让老夫失望了，切记在十二分钟内完成！\n"NOR;
}

string ask_cancel()
{
    int reward_exp,reward_pot,level=0;
	int reward_gold,reward_rmb;
    object me,lingpai;

    me=this_player();

	if(me->query("bh_quest") && me->query_temp("bh_quest/have_task"))
	{
		reward_exp=10000+random(5000)+level+
			(int)me->query_temp("bh_quest/count")*2000;
		reward_rmb = me->query_temp("bh_quest/count") + 1 + random(me->query_temp("bh_quest/count")/2+1) + random(5);
		reward_gold = reward_rmb + random(reward_rmb * 2);
		if(me->query("combat_exp") < 100000 )
			reward_exp -=reward_exp/5;
		if(me->query("combat_exp") > 1000000)
			reward_exp +=reward_exp/3;

		reward_pot=reward_exp/3+random(50)+50;

		me->add("combat_exp",-reward_exp);
		me->add("potential",-reward_pot);
		me->add("money",-reward_gold*10000);
		me->add("rmb",-reward_rmb);
		me->set_temp("bh_quest/reward",0); 
		me->set_temp("bh_quest/count", 0);
		me->set_temp("bh_quest/have_task",0);
		return sprintf("%s%s%s%s%s%s%s"NOR"\n",
			HIC+me->query("name"),"，你太让老夫失望了，现扣去你",
	CHINESE_D->chinese_number(reward_exp) +"点的『实战经验』",
	CHINESE_D->chinese_number(reward_pot)+"点的『潜能』！\n",
	CHINESE_D->chinese_number(reward_gold) +"两的『黄金』",
	CHINESE_D->chinese_number(reward_rmb) +"圆的『人民币』",
	"作为惩罚，你下去休息吧。");
	}
	else
	{
		return	CYN+"帮会大事，岂能儿戏！\n"+NOR;
	}
}
#include "/d/banghui/npc/quest_kill.h"
