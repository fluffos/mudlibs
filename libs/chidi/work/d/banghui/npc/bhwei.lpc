inherit NPC;
#include <ansi.h>

void create()
{
    set_name(HIY+"CLYNAME"+NOR, ({ "CLYFULLID", "CLYFIRSTID"}));
    set("gender", "男性");
    set("age", random(20) + 20);
    set("long", 
		"他双目炯炯有神，一副警惕神态，身上散发出无形的气息。\n"
		+"看见你盯着他，眼光朝你冷冷瞥来。\n");
    set("combat_exp", 2000000000);
    set("shen_type", 0);
    set("str", 50);
    set("int", 50);
    set("con", 50);
    set("dex", 50);
    set("max_neili", 2100000000);
    set("neili", 2100000000);
    //set("max_qi",2100000000);
    //set("qi",2100000000);
    //set("max_jing",2100000000);
    //set("jing",2100000000);
    set("max_jingli",2100000000);
    set("jingli",2100000000);
    set("per",random(30));
    set("jiali", 10000000);
    set_skill("force", 2000000);
    set_skill("unarmed", 2000000);
    set_skill("jiuyin-baiguzhao", 2000000);
    set_skill("dodge", 2000000);
    set_skill("parry", 2000000);
    set_skill("literate", 1000000);
    set_skill("sword", 2000000);

    map_skill("unarmed", "jiuyin-baiguzhao");

    set_temp("apply/attack", 10000000);
    set_temp("apply/defense", 10000000);
    set_temp("apply/damage", 10000000);

	set("banghui/name","CLYOWNER");
	set("banghui/rank","门卫");
	set("banghui/rank_lv", 2);

    set("chat_chance_combat", 60);
    set("chat_msg_combat", ({
        (: perform_action, "unarmed.zhua" :),
        (: exert_function, "recover" :),
    }) );

	setup();

    carry_object("/clone/weapon/changjian")->wield();
    carry_object("/clone/misc/cloth")->wear();
}
