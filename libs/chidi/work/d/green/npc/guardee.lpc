#pragma save_binary
// guard.c

inherit BHNPC;

void create() {
  set_name("卫兵", ({ "gate guard", "guard" }));
  set("title", "寨门");
  set("gender", "男性");
  set("age", 35);
  set("long", "你看到一个剽悍的大块头, 正在恶狠狠地瞪着你.\n");
  set("str", 5);
  set("int", 14);
  set("combat_exp", 3000 + random(1000));
  set("attitude", "heroism");
  set_skill("unarmed", 100);
  set_skill("parry", 100);
  set_skill("dodge", 100);
  set_temp("apply/attack", 100);
  set("inquiry", ([
    "野羊山": "这里就是野羊山。",
    "进山寨": "想进山寨？先问问我的拳头答不答应！",
  ]));

  setup();
  add_money("silver", 10);
  add_money("coin", 500);
  carry_object("/obj/cloth")->wear();
  /*
        carry_object("/u/cloud/obj/npc/butcher/knife");
        carry_object("/u/cloud/obj/npc/butcher/skin_belt")->wear();
*/
}
