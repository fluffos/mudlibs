#include <ansi.h>
inherit ROOM;

       void create() 
       { 
                   set("short", HIY "江湖会员服务中心" NOR);                  
                   set("long", HIW "这里便是江湖会员服务中心，正前方是一块巨大的玻璃门，\n"
                               "远远望去可以看见里面的会员服务大厅。\n" NOR);
                   set("no_fight", 1);
                   set("no_fight_npc",1);
                   set("no_steal", 1);
                   set("have_quest", 1);   
                   set("no_sleep_room", "1");
                   set("objects", ([
                           __DIR__"npc/tian"  :  1,
                   ]));
                   set("exits", ([
                           "enter"  :  __DIR__"sell",
                           "down"  :"/job/merchant/chaomai/shanghang",

                   ]));

                   setup();     
       } 

int valid_leave(object me, string dir)
{
        me = this_player();
        if ( dir == "enter" && objectp(present("xiao tian", environment(me)))
             && ! me->query("is_member"))
                return notify_fail(HIG "小天跳了出来，说道：“非江湖会员不得入内”。\n" NOR);

        return ::valid_leave(me, dir);
}
void init()
{ 
   if (!wizardp(this_user()))  
add_action("discmds",({"duanlian","ansuan","attack","sha","home","array","touxi","persuade","teach","exert","exercise","study","learn","sleep","kill","steal","cast","conjure","expell","fight","hit","perform","prcatice","scribe","surrender"}));
}
int discmds()
{ 
   tell_object(this_player(),"大胆！在会员中心也敢胡来？！\n");
    return 1;
}
