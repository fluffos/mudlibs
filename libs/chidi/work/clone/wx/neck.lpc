// necklace.c 玄天项圈
 
#include <armor.h>
 
inherit NECK;
 
void create()
{
	set_name(HIC"玄天项圈"NOR, ({ "neck", "necklace" }) );
	set_weight(1000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("material", "steel");
		set("unit", "串");
		set("long", "这是一串玄铁质的项链，用以保护颈部。\n");
		set("value", 1000);
                set("merit", 30);               
                set("armor_prop/armor", 100);
                set("armor_prop/armor_vs_force", 20);
                set("armor_prop/intelligence", 300);
                set("armor_prop/attack", 50);
                set("armor_prop/dodge", 50);
	}
	setup();
}
