// boots.c 玄天战靴

#include <armor.h>

inherit BOOTS;

void create() {
  set_name(HIC "玄天战靴" NOR, ({ "boots", "pi xue", "xue" }));
  set_weight(800);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("material", "leather");
    set("unit", "双");
    set("long", "这是一双用上好牛皮作的皮靴，据说由上海进口。用以保护足部。\n");
    set("value", 1000);
    set("merit", 20);
    set("armor_prop/armor", 200);
    set("armor_prop/armor_vs_force", 40);
    set("armor_prop/intelligence", 200);
    set("armor_prop/attack", -10);
    set("armor_prop/dodge", 100);

  }
  setup();
}
