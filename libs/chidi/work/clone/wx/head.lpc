// head.c 玄天战盔

#include <armor.h>

inherit HEAD;

void create() {
  set_name(HIC "玄天战盔" NOR, ({ "head", "toukui" }));
  set_weight(2000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("material", "steel");
    set("unit", "顶");
    set("long", "这是一顶铁质的肚带，用以保护头部。\n");
    set("value", 1000);
    set("merit", 20);
    set("armor_prop/armor", 200);
    set("armor_prop/armor_vs_force", 40);
    set("armor_prop/intelligence", 200);
    set("armor_prop/attack", -10);
    set("armor_prop/dodge", -10);

  }
  setup();
}
