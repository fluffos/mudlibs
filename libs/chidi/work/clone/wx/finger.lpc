// finger.c 玄天指套
#include <armor.h>
inherit FINGER;
void create() {
  set_name(HIC "玄天指套" NOR, ({ "finger", "zhitao" }));
  set_weight(500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "副");
    set("long", "这是五个环环相链的铁指套，前端锋利如刃，既可暗藏掌中伤人，又可保护指关节。\n");
    set("value", 1000);
    set("material", "steel");
    set("merit", 30);
    set("armor_prop/armor", 100);
    set("armor_prop/armor_vs_force", 20);
    set("armor_prop/intelligence", 300);
    set("armor_prop/attack", 50);
    set("armor_prop/dodge", 50);

  }
  setup();
}
