// wrists.c 玄天护腕
#include <ansi.h>
#include <armor.h>
inherit WRISTS;
void create() {
  set_name(HIC "玄天护腕" NOR, ({ "wrists", "hu wan" }));
  set_weight(500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "双");
    set("long", "这是一件布质的护腕，用以保护腕部。\n");
    set("value", 1300);
    set("material", "cloth");
    set("merit", 10);
    set("armor_prop/armor", 100);
    set("armor_prop/armor_vs_force", 20);
    set("armor_prop/intelligence", 100);
    set("armor_prop/attack", -5);
    set("armor_prop/dodge", -5);

  }
  setup();
}
