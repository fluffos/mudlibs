// zhibiao.c
 
#include <weapon.h>
 
inherit THROWING;
 
void create()
{
        set_name(HIG"纸镖"NOR, ({ "zhibiao", "zhi biao", "biao" }) );
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long", "江湖专有的著名暗器，据说它的攻击居然是负的。\n");
                set("unit", "扎");
               set("no_give", 1);
               set("no_drop", 1);
               set("no_put", 1);
               set("no_get", 1);
                set("base_unit", "扎");
                set("base_weight", 1);
                set("flag",2);
                set("value",1);
                set("merit", 10);
   set("damage", -100000);       //Here the damage=int_throwing, added by King
        }
        set_amount(10000);
 init_throwing(-100000);
        setup();
}
void set_amount(int amount)
{
   if (amount>10000)  amount=10000;
    ::set_amount(amount);
}

