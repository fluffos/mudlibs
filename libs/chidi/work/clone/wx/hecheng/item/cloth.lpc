
#include <ansi.h>
#include <armor.h>
#ifdef AS_FEATURE
#include <dbase.h>
#else

inherit CLOTH;

//inherit EQUIP;
#endif

int check_name(string str,object me);
//int do_rename(string arg);
void init()
{
   if (!mapp(this_player()->query("hcloth"))){
     this_object()->owner_is_killed();
     return;
   }
    if (this_player()!=environment()) return;
    //add_action("do_rename","gainame");
}
void create()
{   
    object me;
    string w_name,w_id;
    int w_armor;
    me = this_player();
   
    if (me){
    w_name=me->query("hcloth/name");
    w_id = me->query("hcloth/id");
    w_armor = me->query("hcloth/armor");
    set("armor_type", "cloth");
    set("armor_prop/armor", w_armor);
    if ( me->query("hcloth/int") ) 
    set("armor_prop/intelligence",me->query("hcloth/int"));
    if ( me->query("hcloth/dex") ) 
    set("armor_prop/dexerity",me->query("hcloth/dex"));
    if ( me->query("hcloth/con") ) 
    set("armor_prop/constitution",me->query("hcloth/con"));
    if ( me->query("hcloth/str") ) 
    set("armor_prop/strength",me->query("hcloth/str"));
    set_weight(5000);    
    set_name(w_name, ({w_id,"hecheng","cloth"}));

  //  set("flag", 1 | EDGED);
    set("unit", "件");   
    set("no_get",1);
  //  set("no_give",1);
    set("no_sell",1);
    set("no_steal",1);
    set("no_beg",1);
    set("no_drop",1);
 
     if ( me->query("env/hcloth1"))
set("wear_msg", ""HIG+me->name()+"装备合成铠甲!  "NOR+me->query("env/hcloth1")+"\n"NOR);
    if ( me->query("env/hcloth2"))
set("unwear_msg", ""HIM+me->name()+"脱下合成铠甲!  "NOR+me->query("env/hcloth2")+"\n"NOR);
 
    }
    setup();
}

int check_name(string name,object me)
{
        int i;

        i = strlen(name);

      if( (strlen(name) < 4) || (strlen(name) > 30 ) ) {
              tell_object(me,"合成盔甲名字请定在50个位数。\n");
                return 0;
        }
        while(i--) {
              if( name[i]<=' ' ) {
                  tell_object(me,"对不起，你的合成盔甲名字中不能用控制字符。\n");
                        return 0;
                }
        }
        return 1;
}
