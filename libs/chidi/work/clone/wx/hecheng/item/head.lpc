#include <ansi.h>
#include <armor.h>
#ifdef AS_FEATURE
#include <dbase.h>
#else
inherit CLOTH;
//inherit EQUIP;
#endif

int check_name(string str, object me);
//int do_hui(object weapon);
//int do_rename(string arg);
int do_qie(string arg);
//int do_xiang(object me,object obj);
void init() {
  if (!mapp(this_player()->query("hchead"))) {
    this_object()->owner_is_killed();
    return;
  }
  if (this_player() != environment()) return;
  //add_action("do_hui","duan");
  add_action("do_rename", "gainame");
  //add_action("do_qie","xiangqie");
}
void create() {
  object me;
  string w_name, w_id, w_lb;
  int w_armor;
  me = this_player();
  if (me) {
    w_name = me->query("hchead/name");
    w_id = me->query("hchead/id");
    w_armor = me->query("hchead/armor");
    //   w_lb = me->query("hcloth/lb");
    set("armor_type", "head");
    set("armor_prop/armor", w_armor);
    if (me->query("hchead/int"))
      set("armor_prop/intelligence", me->query("hchead/int"));
    if (me->query("hcloth/dex"))
      set("armor_prop/dexerity", me->query("hchead/dex"));
    if (me->query("hchead/con"))
      set("armor_prop/constitution", me->query("hchead/con"));
    if (me->query("hchead/str"))
      set("armor_prop/strength", me->query("hchead/str"));
    set_weight(5000);

    set_name(w_name, ({ w_id, "hecheng", "head" }));
    //  set("flag", 1 | EDGED);
    set("unit", "顶");
    set("no_get", 1);
    //  set("no_give",1);
    set("no_sell", 1);
    set("nopaimai", 1);
    set("no_drop", 1);

    if (me->query("env/hchead1"))
      set(
        "wear_msg",
        "" HIG + me->name() + "戴上一项合成头盔!  " NOR + me->query("env/hchead1") + "\n" NOR
      );
    if (me->query("env/hchead2"))
      set(
        "unwear_msg",
        "" HIM + me->name() + "取下合成头盔!  " NOR + me->query("env/hchead2") + "\n" NOR
      );

  }
  setup();
}

int check_name(string name, object me) {
  int i;

  i = strlen(name);

  if ((strlen(name) < 4) || (strlen(name) > 30)) {
    tell_object(me, "合成头盔名字请定在50个位数。\n");
    return 0;
  }
  while (i--) {
    if (name[i] <= ' ') {
      tell_object(me, "对不起，你的合成头盔名字中不能用控制字符。\n");
      return 0;
    }
  }
  return 1;
}
