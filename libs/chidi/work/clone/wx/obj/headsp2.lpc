
#include <ansi.h>
#include <armor.h>
inherit CLOTH;
void create()
{
        set_name( YEL"铁头盔"NOR, ({ "tie toukui","toukui"}) );
        set_weight(1000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "顶");
               set("head_type",1);
                set("material", "leather");               
                set("armor_prop/armor", 1);
        }
        setup();
}
