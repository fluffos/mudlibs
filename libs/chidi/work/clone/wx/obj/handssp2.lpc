#include <ansi.h>
#include <armor.h>
inherit CLOTH;
void create() {
  set_name(RED "皮手套" NOR, ({ "pi shoutao", "shoutao" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "双");
    set("hands_type", 1);
    set("material", "leather");
    set("armor_prop/armor", 1);
  }
  setup();
}
