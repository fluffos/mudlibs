#include <ansi.h>
#include <armor.h>
inherit CLOTH;
void create() {
  set_name(RED "铜头盔" NOR, ({ "tong toukui", "toukui" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "顶");
    set("head_type", 1);
    set("material", "leather");
    set("armor_prop/armor", 1);
  }
  setup();
}
