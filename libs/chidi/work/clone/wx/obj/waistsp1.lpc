#include <ansi.h>
#include <armor.h>
inherit CLOTH;
void create() {
  set_name(HIG "布腰带" NOR, ({ "bu yaodai", "yaodai" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "条");
    set("waist_type", 1);
    set("material", "leather");
    set("armor_prop/armor", 1);
  }
  setup();
}
