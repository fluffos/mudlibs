
#include <ansi.h>
#include <armor.h>
inherit CLOTH;
void create()
{
        set_name( HIB"布披风"NOR, ({ "bu pifeng","pifeng"}) );
        set_weight(1000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "件");
               set("pifeng_type",1);
                set("material", "leather");               
                set("armor_prop/armor", 1);
        }
        setup();
}
