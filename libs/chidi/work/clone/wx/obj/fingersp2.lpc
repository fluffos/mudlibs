#include <ansi.h>
#include <armor.h>
inherit CLOTH;
void create() {
  set_name(HIR "皮指套" NOR, ({ "pi zhitao", "zhitao" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "根");
    set("finger_type", 1);
    set("material", "leather");
    set("armor_prop/armor", 1);
  }
  setup();
}
