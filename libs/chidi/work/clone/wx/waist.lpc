// waist.c玄天腰带
#include <ansi.h>
#include <armor.h>
inherit WAIST;
void create() {
  set_name(HIC "玄天腰带" NOR, ({ "waist", "hu yao", "huyao" }));
  set_weight(500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "条");
    set("long", "这是一条皮质的护腰，用以保护腰部。\n");
    set("value", 1600);
    set("material", "leather");
    set("merit", 10);
    set("armor_prop/armor", 100);
    set("armor_prop/armor_vs_force", 20);
    set("armor_prop/intelligence", 100);
    set("armor_prop/attack", -5);
    set("armor_prop/dodge", -5);

  }
  setup();
}
