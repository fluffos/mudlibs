// wxdan.c 悟性丹

#include <ansi.h>
inherit ITEM;
void create() {
  set_name(HIY "神恩通神仙丹" NOR, ({ "tongshen xiandan", "xiandan" }));
  set_weight(200);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一颗七彩的悟性丹，据说吃了可以临时增加1小时的4倍悟性。\n");
    set("value", 1000);
    set("merit", 10);
    set("no_give", 1);
    set("no_drop", 1);
    set("no_put", 1);
    set("no_get", 1);
    set("unit", "颗");
  }
}
void init() {
  add_action("do_eat", "eat");
}
int do_eat(string arg) {
  object me;
  int tempwx;
  me = this_player();

  if (!id(arg))
    return notify_fail("你要吃什么？\n");
  if (me->query("wxdan", 1))
    return notify_fail("干什么？小心撑死你！\n");
  message_vision("$N一仰脖，吞下了一颗" + this_object()->name() +
    "。\n", me);
  if (random(10) >= 9) {
    message_vision("$N眨眨眼。\n", me);
    tell_object(me, "你觉得这药没啥味道，还不如花生好吃。\n");
  } else {
    tempwx = (int)me->query_int() * 3;
    tell_object(me, HIR "你觉得似乎自己运气好了一些。\n" NOR);
    me->set("wxdan", 1);
    me->add("int", tempwx);
    me->set("wuxingdan", tempwx);
    me->apply_condition("wuxing", 360);  //1小时悟性
    //me->apply_condition("wuxing", 4320);  //12小时悟性             
  }

  destruct(this_object());
  return 1;
}

void owner_is_killed() { destruct(this_object()); }
