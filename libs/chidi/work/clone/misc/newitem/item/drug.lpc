#include <armor.h>
#include <ansi.h>

inherit CLOTH;

void create() {
  set_name(BLINK HIR "元神丹" NOR, ({ "yuanshen soul" }));
  set_weight(1);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "这是一位无名的大侠研制的丹药，母指般大小，你捧在手心能强烈地感觉得到丹药的灵性。用法：boost\n");
    set("unit", "颗");
    set("value", 50000);
    set("no_drop", 1);
  }
  setup();
}

void init() {
  if (this_player() == environment())
    add_action("boost_skill", "boost");
}

int boost_skill() {
  int force_limit, neili_limit, force_skill, add_skill, improve;

  object ob, *list, couple_ob;
  string theskill;
  int thelevel = 0;
  mapping skl, lrn, map;
  string *sname, *mapped, target, cardname;
  int i, marry_flag;
  ob = this_player();
  skl = ob->query_skills();

  force_limit = ob->query_skill("force") * 10;
  neili_limit = ob->query("max_neili");
  force_skill = ob->query_skill("force", 1);

  if ((int)ob->query_condition("putizi_drug") > 0) {
    ob->add("max_neili", -5000);
    message_vision(HIR "$N试图元神丹，但身体承受不了，结果适得其反！\n" NOR, ob);
  } else if (neili_limit <= force_limit) {
    ob->add("max_neili", 5000);
    ob->add("neili", 5000);

    message_vision(HIY "$N运劲吸纳元神丹，只见$N周围隐药出现一层淡淡的灵魂真气，伴随体内内力源源而生。\n" NOR, this_player());
    ob->apply_condition("putizi_drug", 1000);
  }
  if (!sizeof(skl)) {
    write("你目前并没有学会任何技能。\n");
    return 1;
  }
  sname = sort_array(keys(skl), (: strcmp :));

  map = ob->query_skill_map();
  if (mapp(map)) mapped = values(map);
  if (!mapped) mapped = ({});

  lrn = ob->query_learned();
  if (!mapp(lrn)) lrn = ([]);

  for (i = 0; i < sizeof(skl); i++) {
    if (skl[sname[i]] > thelevel) { theskill = sname[i]; thelevel = skl[sname[i]]; }
  }
  ob->set_skill(theskill, (int)thelevel + 500);
  message_vision("$N的技能" BLINK HIG + to_chinese(theskill) + NOR + "得到了提升。\n", this_player());
  destruct(this_object());
  return 1;
}
