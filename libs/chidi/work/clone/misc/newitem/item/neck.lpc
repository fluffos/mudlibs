// armor.c
#include <ansi.h>
#include <armor.h>
inherit NECK;

void create() {
  set_name(HIM "英雄項鏈" NOR, ({ "neck", "hero neck" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("no_paimai", 1);
    set("unit", "个");  //单位
    set("express", "can_shenghua");  //可进化标志
    set("sh_lvl", 0);  //原始装备标志
    set("material", "zhuangbei");  //进化装备类标志
    set("point", 5);  //伤害力
    set("stype", "NECK");  //道具的子类别 
    set("ctype", "项链");  //道具的类别的中文名 
    set("type", "neck");  //道具的类型
    /*-----------特殊屬性---------------------*/
    set("armor", 1000);  //防禦
    set("defense1", 30);  //追加躲避
    //set("personality",100);//追加容貌
    /*--------------END------------------------*/
    set("wear_msg", HIY "只见$N把项链往脖子上使劲一勒，眼反了，舌头伸出来了，快打120啊！\n" NOR);
    set("remove_msg", HIC "$N把項鏈一扯，满脸涨红的吼道“谁抢，我跟谁急。”\n" NOR);
    set("long", HIR "\t    〖英雄套裝〗－－英雄項鏈\n" NOR
      YEL "\t這是一個由崑崙山下的萬年寒玉精華所造，\n"
      "\t據說將其磨粉配上仟年人參，天山雪蓮以\n"
      "\t及豬肉三塊，能生死人，肉白骨，絕世奇\n"
      "\t寶啊！传说得到英雄套装的人将成为\n"
      "\t江湖的至尊人物。\n" NOR
      HIY "\t   ----------進化基數----------\n" NOR
      HIG "\t     追加防禦：1000 ×進化次數\n" NOR
      HIG "\t     追加躲避：30  ×進化次數\n" NOR
      //HIG"\t     追加容貌：100  ×進化次數\n"NOR
      HIY "\t   ----------------------------\n" NOR);
  }
  setup();
}
void owner_is_killed() { destruct(this_object()); }
