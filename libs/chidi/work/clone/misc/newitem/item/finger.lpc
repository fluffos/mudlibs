// armor.c
#include <ansi.h>
#include <armor.h>
inherit FINGER;

void create() {
  set_name(HIM "英雄戒指" NOR, ({ "finger", "hero finger" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("no_paimai", 1);
    set("unit", "枚");  //单位        
    set("express", "can_shenghua");  //可进化标志
    set("sh_lvl", 0);  //原始装备标志
    set("material", "zhuangbei");  //进化装备类标志
    set("point", 5);  //伤害力
    set("stype", "FINGER");  //道具的子类别 
    set("ctype", "戒指");  //道具的类别的中文名 
    set("type", "finger");  //道具的类型
    /*-----------特殊屬性---------------------*/
    set("armor", 550);  //防禦
    set("attack1", 38);  //追加伤害
    set("defense1", 23);  //追加躲避
    //set("karma",50);//追加福缘
    /*--------------END------------------------*/
    set("wear_msg", HIY "只见$N對妳緊握拳頭，竪起中指，一臉賤笑的將戒指帶在中指上！\n" NOR);
    set("remove_msg", HIC "$N將戒指脫下，一臉癡獃的用舌頭舔着戒指痕。\n" NOR);
    set("long", HIR "\t    〖英雄套裝〗－－英雄手套      \n" NOR
      YEL "\t這是一枚以烈火孽龍的龍珠精彫琢而成\n"
      "\t上麵鑲嵌着精靈族聖女眼淚的結晶，此\n"
      "\t物是讓MM為之瘋狂，男仕为之沮丧之物\n"
      "\t－－因為實在太昂貴，传说得到英雄套\n"
      "\t装的人将成为江湖的至尊人物。  \n" NOR
      HIY "\t    ----------進化基數----------\n" NOR
      HIG "\t       追加防禦：550 ×進化次數\n" NOR
      HIG "\t       追加伤害： 38 ×進化次數\n" NOR
      HIG "\t       追加躲避： 23 ×進化次數\n" NOR
      //HIG"\t       追加福缘： 50 ×進化次數\n"NOR
      HIY "\t    ----------------------------\n" NOR);
  }
  setup();
}
void owner_is_killed() { destruct(this_object()); }
