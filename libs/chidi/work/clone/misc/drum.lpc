#include <ansi.h>

inherit ITEM;
void de_group(object *fighters);
void checking(object ob1, object ob2);
int att_fight(object ob1, object ob2);
void recover(object ob);
int sort_user(object ob1, object ob2);
string clear_title(string arg);
void add_title(object me, string arg);
void tellallrooms(string arg);
void setallpaizi(string arg);

nosave object *fightrooms;

#define LUNJIAN "/d/huashan/lunjian"

void create() {
  set_name(HIR "武林英雄鼓" NOR, ({ "drum" }));
  set_weight(5000000);
  set("no_get", 1);
  set("no_clean_up", 1);
  set("no_clean", 1);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "只");
    set("long", "这是一只牛皮制成的巨鼓，武林人士在华山论剑时敲响(knock)它开始比武。\n");
  }
}
int init() {
  add_action("do_knock", "knock");
}
int do_knock(string arg) {
  mapping exits;
  string *dirs;
  object me, ob, *env, *fighters, tempob, *tempfighters;
  int i, j;

  me = this_player();

  if (!arg || arg != "drum") return notify_fail("你要敲什么？\n");

  if (query("is_drum_knocked"))
    return notify_fail("比武大会已经开始了，不必再击鼓了。\n");

  if (!wizardp(me))
    return notify_fail("现在召开比武大会，必需由巫师击鼓。\n");

  exits = environment(me)->query("exits");
  map_delete(exits, "southdown");
  dirs = values(exits);

  fightrooms = ({});
  env = ({});

  for (i = 0; i < sizeof(dirs); i++) {
    if (!objectp(tempob = find_object(dirs[i]))) {
      tempob = load_object(dirs[i]);
    }

    tempfighters = all_inventory(tempob);
    for (j = 0; j < sizeof(tempfighters); j++) {
      if (userp(tempfighters[j])) {
        tempfighters[j]->set_temp("fight_start_room", tempob);
      }
    }

    fightrooms += ({ tempob });
    env += all_inventory(tempob);
  }

  for (i = 0, j = 0; i < sizeof(env); i++) {
    if (!userp(env[i]) || wizardp(env[i]))
      continue;

    env[i]->set("title", clear_title(env[i]->query("title")));

    if (j == 0) fighters = ({ env[i] });
    else fighters += ({ env[i] });

    j++;
  }
  if (j < 3) {
    environment(me)->set("exits/southdown", "d/huashan/houzhiwangyu.lpc");
    return notify_fail("到场人数太少了，你还是先多召集几个玩家吧。\n");
  }

  fightrooms += ({ environment(me) });

  tellallrooms(NOR + BOLD + "\n\n\t" + me->query("name") + "敲响了比武场上的大鼓，鼓声咚咚，令人热血沸腾。\n\n" + NOR);

  if (wiz_level(me) >= wiz_level("(arch)"))
    set("drum_knocked", me->query("name"));
  else
    delete("drum_knocked");
  set("is_drum_knocked", 1);
  delete("round");
  delete("loop");

  environment(this_object())->delete("exits");

  de_group(fighters);
  return 1;
}
int sort_user(object ob1, object ob2) {
  if (ob1->query("combat_exp") < ob2->query("combat_exp"))
    return 1;
  else return -1;
}

int sort_winner(object ob1, object ob2) {
  mapping arena = query("arena");
  if (!ob1 && !ob2) return 0;
  if (!ob1) return 1;
  if (!ob2) return -1;
  if ((arena[ob1] == arena[ob2]) && (ob1->query("combat_exp") > ob2->query("combat_exp")))
    return -1;
  if (arena[ob1] > arena[ob2])
    return -1;
  else return 1;
}

void de_group(object *fighters) {
  int i, j, k, n, m;
  string msg, file;
  object *list, no1, no2, no3, no4, no5, no6, no7, no8, no9, no10, no11;
  object ob;
  mapping arena;

  if (sizeof(fighters) <= 1) return;

  for (i = 0; i < sizeof(fighters); i++)
    if (query("group" + i)) delete("group" + i);

  if (sizeof(fighters) < 9) {
    if (query("loop")) {
      tellallrooms(HIW + "\n\n比武大会结束============================================================" + NOR);

      file = "seperator\n";
      arena = query("arena");
      list = sort_array(keys(arena), "sort_winner", this_object());
      i = 0;
      for (i; i < sizeof(list); i++) {
        if (!undefinedp(list[i])) {
          ob = list[i];

          if (ob) {
            tellallrooms(HIW + "\n\n本次比武大会的结果:\n" + HIM + "          第" + chinese_number(i + 1) + "名是"
              +ob->query("name") + "(" + ob->query("id") + ")。\n" + NOR);
            file += ob->query("name") + " (" + ob->query("id") + ")\n";
          }
        }
      }

      environment()->set("exits", ([
        "1": "d/huashan/biwu1.lpc",
        "2": "d/huashan/biwu2.lpc",
        "3": "d/huashan/biwu3.lpc",
        "4": "d/huashan/biwu4.lpc",
        "southdown": "d/huashan/houzhiwangyu.lpc",
      ]));

      if (stringp(query("drum_knocked"))) {
        log_file("/fight/lunjian", file);
        n = 0;
        for (i = 0; i < sizeof(list); i++) {
          if (!undefinedp(list[i])) {
            n++;
            ob = list[i];

            if (ob) {
              switch (n) {
                case 1:
                  add_title(ob, "【天尊】");
                  new("/clone/gift/gift/cake5")->move(ob);
                  ob->add("rmb", 25000);
                  ob->add("more_money", 5);

                  break;
                case 2:
                  add_title(ob, "【地皇】");
                  new("/clone/gift/gift/cake3")->move(ob);
                  ob->add("rmb", 20000);
                  ob->add("more_money", 4);

                  break;
                case 3:
                  add_title(ob, "【人杰】");
                  new("/clone/gift/gift/cake4")->move(ob);
                  ob->add("rmb", 15000);
                  ob->add("more_money", 3);

                  break;
                case 4:
                  add_title(ob, "本周天下第四");
                  new("/clone/gift/gift/cake")->move(ob);
                  new("/clone/gift/gift/cake")->move(ob);
                  ob->add("rmb", 10000);
                  ob->add("more_money", 2);

                  break;
                case 5:
                  add_title(ob, "本周天下第五");
                  new("/clone/gift/gift/cake")->move(ob);
                  ob->add("rmb", 8000);
                  for (m = 0; m < 15; m++) {
                    new("/clone/money/thousand-gold")->move(ob);
                  }

                  break;
                case 6:
                  add_title(ob, "本周天下第六");
                  new("/clone/gift/gift/cake2")->move(ob);
                  new("/clone/gift/gift/cake2")->move(ob);
                  new("/clone/gift/gift/cake2")->move(ob);
                  ob->add("rmb", 5000);
                  for (m = 0; m < 12; m++) {
                    new("/clone/money/thousand-gold")->move(ob);
                  }

                  break;
                case 7:
                  add_title(ob, "本周天下第七");
                  new("/clone/gift/gift/cake2")->move(ob);
                  new("/clone/gift/gift/cake2")->move(ob);
                  ob->add("rmb", 4000);
                  for (m = 0; m < 11; m++) {
                    new("/clone/money/thousand-gold")->move(ob);
                  }

                  break;
                case 8:
                  add_title(ob, "本周天下第八");
                  new("/clone/gift/gift/cake2")->move(ob);
                  ob->add("rmb", 3000);
                  for (m = 0; m < 10; m++) {
                    new("/clone/money/thousand-gold")->move(ob);
                  }

                  break;
                case 9:
                  add_title(ob, "本周天下第九");
                  ob->add("rmb", 2000);
                  for (m = 0; m < 8; m++) {
                    new("/clone/money/thousand-gold")->move(ob);
                  }

                  break;
                case 10:
                  add_title(ob, "本周天下第十");
                  ob->add("rmb", 1000);
                  for (m = 0; m < 5; m++) {
                    new("/clone/money/thousand-gold")->move(ob);
                  }

                  break;
                case 11:
                  break;
                default:
                  break;
              }
            }
          }
        }
        call_out("give_money", 0);
      }
      tellallrooms(HIW + "\n比武大会结束============================================================\n\n" + NOR);
      tellallrooms(HIW + "\n\n奖励发送完毕============================================================\n\n" + NOR);

      delete("drum_knocked");
      delete("lunshu");
      delete("is_drum_knocked");
      return;
    } else {
      tellallrooms(HIW + "\n\n比武大会第" + chinese_number((int)query("lunshu") + 1) + "轮参赛人数总共" + chinese_number(sizeof(fighters)) + "名\n\n" + NOR);

      msg = BOLD + "\n\n比武大会第" + chinese_number((int)query("lunshu") + 1) + "轮(循环赛)赛程：\n\n" + NOR;
      set("loop", 1);
      k = 0;
      arena = ([]);
      for (i = 0; i < sizeof(fighters); i++) {
        for (j = i + 1; j < sizeof(fighters); j++, k++) {
          set("group" + k, ([ fighters[i]: fighters[j] ]));
          msg += ((string)fighters[i]->query("name") + "(" + (string)fighters[i]->query("id") + ")" + HIY + "--.VS.--" + NOR + (string)fighters[j]->query("name") + "(" + (string)fighters[j]->query("id") + ")" + "\n\n");
        }

        if (objectp(fighters[i])) {
          arena += ([ fighters[i]: 0 ]);
        }
      }
    }
  } else {
    tellallrooms(HIW + "\n\n比武大会第" + chinese_number((int)query("lunshu") + 1) + "轮参赛人数总共" + chinese_number(sizeof(fighters)) + "名\n\n" + NOR);

    msg = BOLD + "\n\n比武大会第" + chinese_number((int)query("lunshu") + 1) + "轮(淘汰赛)赛程：\n\n" + NOR;
    set("loop", 0);
    list = sort_array(fighters, "sort_user", this_object());

    arena = ([]);
    for (i = 0; i < sizeof(list); i++) {
      arena += ([ list[i]: 0 ]);
    }

    m = 0;
    if (sizeof(list) % 2) {
      msg += HIY + ((string)list[0]->query("name") + "(" + (string)list[0]->query("id") + ")" + "------(此轮免战)\n\n" + NOR);
      set("group0", ([ list[0]: 0 ]));
      m = 1;
    }
    for (i = m; i < ((sizeof(list) + m) / 2); i++) {
      set("group" + i, ([
        list[i]: list[(sizeof(list) / 2) + i]
      ]));
      msg += ((string)list[i]->query("name") + "(" + (string)list[i]->query("id") + ")" + HIC + "--.VS.--" + NOR + (string)list[(sizeof(list) / 2) + i]->query("name") + "(" + (string)list[(sizeof(list) / 2) + i]->query("id") + ")" + "\n\n");
    }
  }

  msg += "\n";
  setallpaizi(msg);
  tellallrooms(msg);
  set("round", 0);
  set("arena", arena);
  remove_call_out("start_fight");
  call_out("start_fight", 5);
}

int filter_user(object ob1, object ob2) {
  mapping arena = query("arena");
  return (int)arena[ob1];
}

void start_fight() {
  int round = query("round");
  mapping fighters, arena = query("arena");
  object room = environment();
  object ob1, ob2, *list;
  if (mapp(fighters = query("group" + round))) {
    if (sizeof(keys(fighters)))
      ob1 = keys(fighters)[0];
    if (ob1)
      ob2 = fighters[ob1];
    else if (sizeof(values(fighters)))
      ob2 = values(fighters)[0];
    round++;
    set("round", round);
    if (ob1 && !ob2) {
      arena[ob1] += 1;
      tellallrooms(BOLD + "\n第" + chinese_number((int)query("lunshu") + 1) + "轮第" + chinese_number(round) + "回合：  "
        +ob1->query("name") + "(" + ob1->query("id") + ")" + HIY + "---------免战!\n" + NOR);
      remove_call_out("start_fight");
      call_out("start_fight", 1);
      return;
    }
    if (ob2 && !ob1) {
      arena[ob2] += 1;
      tellallrooms(BOLD + "\n第" + chinese_number((int)query("lunshu") + 1) + "轮第" + chinese_number(round) + "回合：  "
        +ob2->query("name") + "(" + ob2->query("id") + ")" + HIY + "---------免战!\n" + NOR);
      remove_call_out("start_fight");
      call_out("start_fight", 1);
      return;
    }
    if (!ob1 && !ob2) {
      tellallrooms(BOLD + "\n第" + chinese_number((int)query("lunshu") + 1) + "轮第" + chinese_number(round) + "回合：  "
        +HIY + "-----------SKIP----------\n" + NOR);
      remove_call_out("start_fight");
      call_out("start_fight", 1);
      return;
    }
    tellallrooms(BOLD + "\n第" + chinese_number((int)query("lunshu") + 1) + "轮第" + chinese_number(round) + "回合：  "
      +ob1->query("name") + "(" + ob1->query("id") + ")" + HIY + "---.VS.---" + NOR + BOLD
      +ob2->query("name") + "(" + ob2->query("id") + ")\n" + NOR);
    if (!room = find_object(LUNJIAN))
      room = load_object(LUNJIAN);
    room->set_temp("msg_rooms", this_object());
    recover(ob1);
    recover(ob2);
    tellallrooms(HIW + "\n" + ob1->query("name") + "和" + ob2->query("name") + "施展轻功,双双跃上擂台。\n\n" + NOR);
    ob1->move(room);
    ob2->move(room);
    message(
      "vision",
      HIW + "\n" + ob1->name() + "和" + ob2->name() + "一前一后，跃了上来。\n\n" + NOR,
      room,
      ({ ob1, ob2 })
    );
    set("time", 3);
    remove_call_out("att_fight");
    call_out("att_fight", 1, ob1, ob2);
  } else {
    tellallrooms(HIW + "比武大会第" + chinese_number((int)query("lunshu") + 1) + "轮比赛结束。\n" + NOR);
    environment()->set("item_desc/paizi", "现在还没开始比赛呢！");
    add("lunshu", 1);

    list = filter_array(keys(query("arena")), "filter_user", this_object());

    de_group(list);
  }
}


void checking(object ob1, object ob2) {
  object winner, room;
  mapping arena;
  if (!room = find_object(LUNJIAN))
    room = load_object(LUNJIAN);
  room->set_temp("msg_rooms", this_object());

  if (ob1 && ob2)
    if (present(ob1, room) && present(ob2, room)) {
      remove_call_out("checking");
      call_out("checking", 2, ob1, ob2);
      return;
    }

  if (!ob1 && !ob2)
    tellallrooms(BOLD "由于双方弃权,继续下一轮比赛。\n" NOR);
  else if (ob1 && (!ob2 || !present(ob2, room))) {
    winner = ob1;
    message("vision", HIC + ob1->name() + "哈哈大笑几声，跳了下去。\n" + NOR, room, ({ ob1 }));
  } else if (!ob1 || !present(ob1, room)) {
    winner = ob2;
    message("vision", HIC + ob2->name() + "哈哈大笑几声，跳了下去。\n" + NOR, room, ({ ob2 }));
  } else
    tellallrooms(BOLD + "由于双方弃权,继续下一轮比赛。\n" + NOR);

  if (winner) {
    arena = query("arena");
    arena[winner] += 1;
    if (ob1) {
      if (ob1->query_temp("fight_start_room"))
        ob1->move(ob1->query_temp("fight_start_room"));
      else
        ob1->move(environment());
    }
    if (ob2) {
      if (ob2->query_temp("fight_start_room"))
        ob2->move(ob2->query_temp("fight_start_room"));
      else
        ob2->move(environment());
    }
    tellallrooms(HIC + winner->query("name") + "哈哈大笑，从擂台上跳了下来。\n" + NOR);
    tellallrooms(BOLD + "这一回合的结果是：  " + winner->query("name") + " 胜。\n" NOR);
    recover(ob1); recover(ob2);
  }

  remove_call_out("start_fight");
  call_out("start_fight", 5);
}
int att_fight(object ob1, object ob2) {
  object room;
  if (!ob1 || !ob2) {
    remove_call_out("start_fight");
    call_out("start_fight", 5);
    return 1;
  }
  if (!room = find_object(LUNJIAN))
    room = load_object(LUNJIAN);
  room->set_temp("msg_rooms", this_object());
  if (present(ob1, room) && present(ob2, room)) {
    if (!ob1->is_killing(ob2) || !ob2->is_killing(ob1)) {
      if (query("time")) {
        tell_object(
          ob1,
          "\t\t" + HIR + "===" + CHINESE_D->chinese_number(query("time")) + "===\n\n" + NOR
        );
        tell_object(
          ob2,
          "\t\t" + HIR + "===" + CHINESE_D->chinese_number(query("time")) + "===\n\n" + NOR
        );
        add("time", -1);
        call_out("att_fight", 5, ob1, ob2);
        return 1;
      }
      tell_room(room, HIY "\t-------  开     始  -------\n\n" NOR);

      message_vision("\n$N对著$n喝道：「" + RANK_D->query_rude(ob2) + "！今日不是你死就是我活！」\n\n", ob1, ob2);
    }
    if (!ob1->is_killing(ob2)) ob1->kill_ob(ob2);
    if (!ob2->is_killing(ob1)) ob2->kill_ob(ob1);
  }
  remove_call_out("checking");
  call_out("checking", 2, ob1, ob2);
  return 1;
}
void recover(object me) {
  if (!me) return;
  if (!living(me)) me->revive();
  me->set("eff_jing", me->query("max_jing"));
  me->set("jing", me->query("max_jing"));
  me->set("eff_qi", me->query("max_qi"));
  me->set("qi", me->query("max_qi"));
  if (me->query("neili") < me->query("max_neili"))
    me->set("neili", me->query("max_neili"));
  if (me->query("jingli") < me->query("max_jingli"))
    me->set("jingli", me->query("max_jingli"));
  me->set("food", me->max_food_capacity());
  me->set("water", me->max_water_capacity());
  me->clear_condition();
}

string clear_title(string arg) {
  if (!arg) return "";
  if (
    (strsrch(arg, "【天尊】") >= 0)
    || (strsrch(arg, "【地皇】") >= 0)
    || (strsrch(arg, "【人杰】") >= 0)
    || (strsrch(arg, "本周天下第四") >= 0)
    || (strsrch(arg, "本周天下第五") >= 0)
    || (strsrch(arg, "本周天下第六") >= 0)
    || (strsrch(arg, "本周天下第七") >= 0)
    || (strsrch(arg, "本周天下第八") >= 0)
    || (strsrch(arg, "本周天下第九") >= 0)
    || (strsrch(arg, "本周天下第十") >= 0)
  ) {
    arg = replace_string(arg, HIY + "【天尊】" + NOR, "");
    arg = replace_string(arg, HIY + "【地皇】" + NOR, "");
    arg = replace_string(arg, HIY + "【人杰】" + NOR, "");
    arg = replace_string(arg, HIY + "本周天下第四" + NOR, "");
    arg = replace_string(arg, HIY + "本周天下第五" + NOR, "");
    arg = replace_string(arg, HIY + "本周天下第六" + NOR, "");
    arg = replace_string(arg, HIY + "本周天下第七" + NOR, "");
    arg = replace_string(arg, HIY + "本周天下第八" + NOR, "");
    arg = replace_string(arg, HIY + "本周天下第九" + NOR, "");
    arg = replace_string(arg, HIY + "本周天下第十" + NOR, "");

  }
  return arg;
}

void add_title(object me, string arg) {
  string title;
  title = BLINK + HIY + arg + NOR + clear_title(me->query("title"));
  me->set("title", title);
}
int give_money() {
  mapping exits;
  string *dirs;
  object *env, *fighters, tempob;
  int i;

  exits = environment(this_object())->query("exits");
  dirs = values(exits);

  env = ({});

  for (i = 0; i < sizeof(dirs); i++) {
    if (keys(exits)[i] != "southdown") {
      if (!objectp(tempob = find_object(dirs[i]))) {
        tempob = load_object(dirs[i]);
      }
      env += all_inventory(tempob);
    }
  }

  foreach (object user in env) {
    if (user && userp(user) && !wizardp(user)) {
      new("/clone/money/thousand-gold")->move(user);
      new("/clone/money/thousand-gold")->move(user);
      user->add("rmb", 500);
    }
  }
}

void tellallrooms(string arg) {
  int i = 0;

  for (i = 0; i < sizeof(fightrooms); i++) {
    message("vision", arg, fightrooms[i]);
  }
}

void setallpaizi(string arg) {
  int i = 0;

  for (i = 0; i < sizeof(fightrooms); i++) {
    fightrooms[i]->set("item_desc/paizi", arg);
  }
}
