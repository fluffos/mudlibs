// feidan.c 核子飞弹

#include <ansi.h>

inherit ITEM;

void create()
{
	set_name(HIR "核子飞弹" NOR, ({ "nucleus bomb" , "bomb" }));
	set_weight(100);
	if( clonep() )
		set_default_object(__FILE__);
	else {
                set("long", "这是高科技产品，是" RED "血滴子" NOR "的2000版本。\n");
                set("value", 50000);
                set("bullet", 10000);
                set("owner_id","clyz");
                set("no_sell", 1);
                set("no_give", 1);
                set("no_drop", 1);
                set("no_put", 1);
                set("unit", "枚");
	}
}

void init()
{
        add_action("do_launch", "launch");
        add_action("do_aim", "aim");
}

int do_launch(string arg)
{
        object me;
        object ob;
        string user;
        object obj;
        obj= this_object();
        me = this_player();

		user = query_temp("aim");

        if (! stringp(user))
                return notify_fail("你先瞄准(aim)好再发射！\n");

		ob = find_living(user);

        if (me->is_busy())
                return notify_fail("什么事情都等你忙完了再说。\n");

        if (me->is_fighting())
                return notify_fail("打完架再考虑这些事情吧！\n");

        if (! arg || ! id(arg))
                return notify_fail("你要发射什么？\n");


        if (! objectp(ob) ||
	    ! me->visible(ob))
                return notify_fail("你要炸的玩家现在好像不在线上。\n");

        message("vision",HIM "\n某人掏出一个" + name() + HIM "，喃喃自"
                       "语道：“5... 4... 3... 2... 1...”说罢一按开关！\n"
                       "就听“轰”的一声，" + name() + HIM "腾空而去！\n\n\n" NOR, users());

		call_out("shoot_sb", 1, obj, ob);

        return 1;
}

void shoot_sb(object obj, object ob)
{
	if(ob)
	{
        if (wizardp(ob))
		{
				message("vision",HIC "突然天空传来一阵嗡嗡的声音...\n" +
                       "“轰”的一声，"+ob->name(1)+ "被炸得浑身都是小烟，"
                       "一句话都说不出来...\n\n\n" NOR, users());

                message("vision",HIM +ob->name(1)+ "连忙点燃一张符纸，口中"
                       "直念叨：“太上老君救命啊...”\n\n" NOR, users());
		}
        else
        {
			if(random(3) == 0)
			{
				message("vision",HIC "突然天空传来一阵嗡嗡的声音...\n" +
                       "“轰”的一声，"+ob->name(1)+ "被炸得浑身都是小烟，"
                       "一句话都说不出来...\n\n\n" NOR, users());

                message("vision",HIG +ob->name(1)+ "一脸无辜的表情，真冤枉啊！\n\n" NOR, users());
                ob->ban_say_until(10 * 60, "你现在被炸得头晕眼花，说不出话");
                CHANNEL_D->do_channel(this_object(), "rumor",
                                      "听说" + ob->name(1) +
                                      "惨遭核子飞弹袭击，现在精神失常死了。");
				ob->die();
			}
			else if(random(3) == 1)
			{
				message("vision",
					HIR "【观察卫星】紧急报告，" + ob->name(1) +
					HIR "突然失去踪影，看来已经逃出地球，发射程序自动关闭。\n" NOR,users());
			}
			else
			{
				message("vision",HIC "突然天空传来一阵嗡嗡的声音...\n" +
                       "“轰”的一声，什么东西掉到"+ob->name(1)+ "旁边的小水沟...\n\n\n" NOR, users());

                message("vision",HIG +ob->name(1)+ "一脸惊恐的表情，真可怕啊，一个导弹就射到旁边的水沟了！\n\n" NOR, users());
                ob->ban_say_until(10 * 60, "你现在惊恐莫名，说不出话。");
			}
        }
        obj->add("bullet", -1);  
        obj->delete_temp("aim");

		return;
	}

	message("vision",
		HIR "【观察卫星】紧急报告，" + ob->name(1) +
		HIR "突然失去踪影，看来已经逃出地球，发射程序自动关闭。\n" NOR,users());
}

int do_aim(string arg)
{
        object me;
        object ob;
        object obj;
        string my_id;
        obj= this_object();
        me = this_player();
        if( obj->query("bullet") <=0)
               return notify_fail("导弹已经发射光了。\n");

        if( obj->query("owner_id")!=me->query("id"))
               return notify_fail("这枚导弹不属于你的。\n");

        if (arg && sscanf(arg, "%s with %s", arg, my_id) == 2 && ! id(my_id))
                return notify_fail("这里没有(" + my_id + ")这样东西。\n");

        if ((arg == "none" || arg == "cancel") && query_temp("aim"))
        {
                delete_temp("aim");
                write("立即取消飞弹瞄准！\n");
                return 1;
        }

      

        if (! arg || ! objectp(ob = find_living(arg)) ||
	    ! me->visible(ob))
                return notify_fail("你要瞄准哪个玩家？\n");

        if (me->is_busy())
                return notify_fail("什么事情都等你忙完了再说。\n");

        if (me->is_fighting())
                return notify_fail("打完架再考虑这些事情吧！\n");

        if (me->ban_say())
                return notify_fail("你现在说不出话来...导弹也没法发射。\n");

        if (ob->query("doing"))
                return notify_fail("你只能瞄准玩家。\n");

        tell_object(me, HIY "你掏出一个" + name() + HIY "，东瞄瞄，西瞄瞄。\n" NOR, me);
        //message("vision", HIR "【观察卫星】紧急报告，" + ob->name(1) +
                          //HIR "已经被人用" + name() +
                          //HIR "瞄准了。\n" NOR, ob);

		//message("channel:rumor",
		message("vision",
			HIR "【观察卫星】紧急报告，" + ob->name(1) +
			HIR "已经被人用高科技产品，血滴子的2000版本【" + name() +
			HIR "】瞄准了。\n" NOR,users());

        set_temp("aim", ob->query("id"));
        me->start_busy(2);

        return 1;
}

string long()
{
        object ob;
        string msg;

        msg = query("long");
        if (query_temp("aim") &&
            objectp(ob = find_player(query_temp("aim"))))
        {
                msg += "现在这枚飞弹正瞄准着" + ob->name(1) +
                       "，待命发射(launch)。\n";
        } else
                msg += "现在这枚飞弹正处于准备状态，"
                       "可以随时瞄准(aim)。\n";
        return msg;
}
