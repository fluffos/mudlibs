inherit ITEM;
inherit F_SAVE;

void create(string banghui)
{
        if( banghui)    set("banghui",banghui);
        if(! restore()) {
                set_name("无效令牌",({"lingpai"}));
                set("no_use",1);
        }
        else    {
                set_name(banghui+"令牌",({"lingpai"}));
                set("no_use",0);
        }
        set("unit","块");
        seteuid(getuid());
}

string query_save_file() { return DATA_DIR + "guild/" + query("banghui")+".o"; }

