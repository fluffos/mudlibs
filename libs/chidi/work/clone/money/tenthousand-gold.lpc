// thousand.c

#include <ansi.h>

inherit MONEY;

void create() {
  set_name(YEL "一万两金票" NOR, ({ "tenthousand-gold", "tenthousand-gold_money" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("money_id", "tenthousand-gold");
    set("no_drop", 1);
    set("long", "一张面额值一万两金子的金票。\n");
    set("unit", "叠");
    set("base_value", 100000000);
    set("base_unit", "张");
    set("base_weight", 6);
  }
  set_amount(1);
  init_throwing(50);
  setup();

}
