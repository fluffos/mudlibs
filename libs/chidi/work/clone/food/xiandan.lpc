//wuchangdan.c
#include <ansi.h>
inherit ITEM;
void setup()
{}
void init()
{
        add_action("do_eat", "eat");
}
void create()
{
        set_name(HIR"仙丹"NOR, ({"xian dan", "dan"}));
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "颗");
               set("long", "这是一颗晶莹火红的仙丹，黑客从天庭偷来得!\n");
                set("value", 1000000);
        }
        setup();
}

int do_eat(string arg)
{
        int fw;

        object me = this_player();


        if (!id(arg))
        return notify_fail("你要吃什么？\n");
        me->set("food", 18*me->max_food_capacity());
        me->set("water",18*me->max_water_capacity());
         message_vision(HIR"$N吃下一颗仙丹，顿时全身充满力量！\n"NOR,me);
        destruct(this_object());
        return 1;
}
