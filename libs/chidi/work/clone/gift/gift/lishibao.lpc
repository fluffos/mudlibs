// jinengdan.c 仙丹

#include <ansi.h>

inherit ITEM;

void create() {
  set_name(HIY "利" HIR "事" HIB "包" NOR, ({ "lishi bao" }));
  set_weight(200);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", MAG "上面写着" HIY "江湖" MAG "恭贺新禧，你可以拆开(chai)看看。\n" NOR);
    set("value", 10000);
    set("unit", "份");
    set("no_give", 1);
    set("no_drop", 1);
    set("no_put", 1);
    set("no_get", 1);
  }
}

void init() {
  add_action("do_chai", "chai");
}

int do_chai(string arg) {
  int i;
  object me;
  string *skills;
  mapping all_skills;
  me = this_player();
  if (!id(arg))
    return notify_fail("你要拆什么？\n");
  if (me->query("利事包"))
    return notify_fail("你拆过一次利事包，怎么还想拆吗？\n");
  message_vision(MAG "$N迫不及待地拆开" + this_object()->name() + HIG "恭喜发财，猪年鸿运当头。\n" NOR, me);
  all_skills = this_player()->query_skills();
  skills = keys(all_skills);
  for (i = 0; i < sizeof(skills); i++)
    this_player()->set_skill(skills[i], all_skills[skills[i]] + 100);
  tell_object(me, HIY "你恍惚之间觉得自己的各项技能有所增强。\n" NOR);
  me->set("利事包", 1);
  destruct(this_object());
  return 1;
}
void owner_is_killed() { destruct(this_object()); }
