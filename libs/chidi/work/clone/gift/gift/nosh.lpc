#include <ansi.h>

inherit ITEM;

void create()
{
	set_name(HIM "小点心" NOR, ({ "nosh", "festival nosh" }));
	set_weight(200);
	if( clonep() )
		set_default_object(__FILE__);
	else
	{
        set("long", MAG"这是一份很精致的小点心喔，快尝尝看。\n"NOR);
        set("value", 10000);
		set("unit", "份");
        set("no_give", 1);
        set("no_drop", 1);
        set("no_put", 1);
        set("no_get", 1);
        set("no_paimai", 1);
	}
}

void init()
{
	add_action("do_eat", "eat");
}

int do_eat(string arg)
{
	int i;    
	object me;    
	string *skills;
	mapping all_skills;

	me = this_player();
	if (!id(arg))
		return notify_fail("你要吃什么？\n");

	message_vision(MAG"$N慢慢举起一份"+ this_object()->name() +MAG"送入嘴里。\n"NOR, me);

	all_skills	= this_player()->query_skills();
	skills	= keys(all_skills);
	for(i = 0; i < sizeof(skills); i++)
	{
		if(SKILL_D((string)skills[i])->invalid_objadd(me))	continue;
		this_player()->set_skill(skills[i], all_skills[skills[i]]+100);
	}

	tell_object(me, HIY "你觉得自己武道上的修为更进了一步，不由....\n" NOR);
	message_vision("$N贼着眼睛四周瞥了一圈，舔舔嘴唇奸笑了两声。\n", me);

	destruct(this_object());
	return 1;
}

void owner_is_killed() { destruct(this_object()); }