// toukui.c 头盔
 
#include <armor.h>
#include <ansi.h>
#include <mudlib.h>
 
inherit HEAD;
 
void create()
{
         set_name(HIY"狮王头盔"NOR, ({ "shiwang toukui", "toukui" }));
        set_weight(2000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("material", "steel");
                set("unit", "顶");
            set("long", "这是一顶可增加防御能力200,悟性30的狮王头盔，下线不掉。\n"NOR); 
              set("jym_money",4);
		set("no_put",1);
              set("no_sell",1);
              set("no_get", 1);
              set("no_give", 1);
              set("no_drop",1); 

                set("armor_prop/armor", 200);
        set("armor_prop/intelligence", 30);
        }
        setup();
}