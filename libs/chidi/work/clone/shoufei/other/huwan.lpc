// huwan.c 护腕
#include <ansi.h>
#include <armor.h>
#include <mudlib.h>
inherit WRISTS;
void create() {
  set_name(HIR "真龙护腕" NOR, ({ "wrists", "huwan" }));

  set_weight(500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "双");
    set("long", "这是一双增加防御力200的真龙护腕,下线不掉。\n");
    set("jym_money", 2);
    set("no_put", 1);
    set("no_sell", 1);
    set("no_get", 1);
    set("no_give", 1);
    set("no_drop", 1);

    set("armor_prop/armor", 200);
    set("material", "cloth");
  }
  setup();
}
