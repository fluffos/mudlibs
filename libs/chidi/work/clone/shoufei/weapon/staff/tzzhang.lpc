#include <weapon.h>
#include <ansi.h>
inherit STAFF;

// 函数：所属类别
int query_xy() { return 1 ; }

// 函数：构造处理
void create()
{
        set_name("檀紫杖",({"tzzhang"}));
        set_weight(5000);
        if( clonep() )
        set_default_object(__FILE__);
        else {
		set("unit", "把");           //量词
		set("flag",1);              //单手双手
		set("material", "iron");
		set("wield_msg", "$N「唰」的一声抽出一柄$n握在手中。\n");
		set("unwield_msg", "$N将手中的$n插回刀鞘。\n");
		set("level", 30);            //装备等级
		set("value",7000);             //价值
		set("dp",-14);                //防御
		set("pp",0);                //追加防御
		set("ap",0);                //追加攻击
             }
	set("max_lasting",14000);   //耐久度
	init_staff(92);
        setup();

        set("gender","男、女");    //限制性别
}

#include "/clone/shoufei/long/weapon.h"
