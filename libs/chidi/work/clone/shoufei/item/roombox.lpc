#include <ansi.h>
inherit ITEM;

void create() {
  set_name(HIC "房间包裹" NOR, ({ "room box", "box" }));
  set("long", "使用后产生自己的房间，和自己的盟主。可以用<open box>打开包裹。\n");
  set("unit", "个");
}

//首先调用函数
void init() {
  add_action("do_check", "open");
}

int do_check(string arg) {
  object me;

  string old_status, new_status, name, file;
  me = this_player();

  if (!arg) {
    tell_object(me, "你要打开什么?\n");
    return 1;
  }
  if (arg != "box") return 0;
  //if ((int) me->query("luoyunjh"))
  //return notify_fail ("哈哈每个ID只能用一次，用多也没什么用!\n"); 
  else {
    me->set("luoyunjh", 1);
    name = me->query("id");
    mkdir("/data/proom/" + name);
    if (file_size("/data/proom/" + name + "/" + name + ".lpc") < 0) {
      mkdir("/data/proom/" + name);
      file = read_file("/d/feng/proom/ada.lpc");
      write_file("/data/proom/" + name + "/" + name + ".lpc", file, 1);

      file = read_file("/d/feng/proom/room.lpc");
      write_file("/data/proom/" + name + "/" + name + "room.lpc", file, 1);

      write_file(
        "/data/proom/" + name + "/playerme.h",
        sprintf("#define PLAYNAME \"%s\"" "\n", name),
        1
      );
      if (me) {
        tell_object(me, "您的房间已经生成。可以使用gohome指令回到自己的私人房间内。\n");
      }
    }
    destruct(this_object());
    return 1;
  }
}
