inherit BULLETIN_BOARD;

void create()
{
        set_name("留言板",({ "board" }) );
          set("location", "/u/lonely/workroom");
        set("board_id", "lonely_b");
        set("long","意虽高处,身却不就。感慨万分,情又何奈?\n" );
        setup();
        set("capacity", 3000);
        replace_program(BULLETIN_BOARD);
}

