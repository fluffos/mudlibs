// armor.c
#include <ansi.h>
#include <armor.h>
inherit HEAD;

void create() {
  set_name(HIM "英雄頭盔" NOR, ({ "head", "hero hand" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("no_paimai", 1);
    set("unit", "个");  //单位        
    set("express", "can_shenghua");  //可进化标志
    set("sh_lvl", 0);  //原始装备标志
    set("material", "zhuangbei");  //进化装备类标志
    set("point", 5);  //伤害力
    set("stype", "HEAD");  //道具的子类别 
    set("ctype", "头盔");  //道具的类别的中文名 
    set("type", "head");  //道具的类型
    /*-----------特殊屬性---------------------*/
    set("armor", 700);  //防禦
    set("defense1", 30);  //追加躲避
    //set("intelligence",50);//追加悟性
    /*--------------END------------------------*/
    set("wear_msg", HIY "只见$N细心的把头盔戴上，迎风狂吼“牺牲了一个$N，还有千千万万个$N”。\n" NOR);
    set("remove_msg", HIC "$N将头盔脱下，飘逸的秀发迎风而舞，众人惊羡之余却没有留意$N满肩膀的头屑。\n" NOR);
    set("long", HIR "\t\t〖英雄套裝〗－－英雄頭盔\n" NOR
      YEL "\t這是一個云梦之泽内稀有金属混合龙血铸造而成\n"
      "\t上有一新月形图案，乃是矮人族第一铸造师－－\n"
      "\t铸米大松所制造，传说得到英雄套装的人将成为\n"
      "\t江湖的至尊人物。\n" NOR
      HIY "\t    ----------進化基數----------\n" NOR
      HIG "\t      追加防禦：700  ×進化次數\n" NOR
      HIG "\t      追加躲避：30  ×進化次數\n" NOR
      //HIG"\t      追加悟性：50   ×進化次數\n"NOR
      HIY "\t    ----------------------------\n" NOR);
  }
  setup();
}
void owner_is_killed() { destruct(this_object()); }
