#include <ansi.h>

inherit ITEM;

void create()
{
        set_name(HIY "寰宇天珠" NOR, ({ "huanyu tianzhu", "tianzhu", "huanyu" }) );
        set_weight(200);
        if( clonep() )
                set_default_object(__FILE__);
        else {
              set("long", "寰宇天珠，携带在身上，可以加快你闭关的速度，下线，当机不掉。闭关中halt或者闭关结束消失！\n");
              set("no_put",1);
              set("no_sell",1);
              set("ty_gift", 1);
              set("no_drop", 1);
              set("no_get", 1);
              set("no_give", 1);
              set("tianya_money",10);
              set("unit", "颗");      }
}

int query_autoload()
{
        return 1;
}





