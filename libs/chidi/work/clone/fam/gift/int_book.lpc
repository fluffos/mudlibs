#include <ansi.h>
inherit ITEM;

void create() {
  set_name(HIY "四库全书" NOR, ({ "siku quanshu" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", HIG "这是一本文化典籍《四库全书》，你可以拿着它去北京书院找纪晓岚学习读书写字。\n" NOR);
    set("unit", "本");
    set("no_put", 1);
    set("no_get", 1);
    set("value", 10000);
    set("weight", 50);
    set("only_do_effect", 1);
  }
  setup();
}

void owner_is_killed() { destruct(this_object()); }
