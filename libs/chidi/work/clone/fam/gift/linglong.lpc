#include <ansi.h>
inherit ITEM; void init() { add_action("do_eat", "eat"); }

void create() {
  set_name(NOR + HIW "玲珑读写丹" NOR, ({ "linglong dan", "linglong", "dan" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", HIW "这是一颗通体雪白的药丸，据说吃了可以增加读书写字。\n" NOR);
    set("unit", "颗");
    set("no_give", 1);
    set("no_drop", 1);
    set("no_put", 1);
    set("no_get", 1);
    set("value", 10000000);
    set("weight", 50); set("merit", 2000);  //价值

    set("only_do_effect", 1);
    set("gift_type", "literate");
    set("gift_name", "读书写字");
    set("gift_point", 15);
    set("gift_msg", HIG "突然间你只觉灵台处一片空明，舒泰无比。\n" NOR);
  }
  setup();
}
int do_eat(string arg) {
  object me;
  int point;

  me = this_player();
  point = query("gift_point");
  if (!id(arg))
    return notify_fail("你要吃什么？\n");

  if (me->query_skill("literate", 1) > 30000) {
    return notify_fail(HIR "你灵智开发程度远远不够，吃再多也是无用。\n" NOR);
  }

  // 福星高照提升成功几率
  if (this_player()->query("special_skill/lucky"))
    point += 1;

  message_vision(WHT "$N" WHT "一仰脖，吞下了一" +
    query("unit") + name() + WHT
    "。\n" NOR, this_player());

  if (random(10) >= point) {
    tell_object(me, HIR "不过你觉得这药好像没起到什么"
      "作用。\n" NOR);
  } else {
    tell_object(me, query("gift_msg"));
    tell_object(me, HIC "你的" + query("gift_name") +
      HIC "增加了一百级。\n" NOR);

    // 增加相应的天赋属性
    me->set_skill(query("gift_type"), me->query_skill(query("gift_type"), 1) + 100);
  }

  destruct(this_object());
  return 1;
}

void owner_is_killed() { destruct(this_object()); }
