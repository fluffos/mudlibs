inherit ROOM;

void create() {
  set("short", "邪月广场");
  set("long", @LONG
这里是一个很宽阔的广场，铺着青石地面。周围聚集着江湖上不少邪魔外道，
很多邪派武林人物都喜欢来这里，因为这是通向各帮派的必进之路，正派人士
往往都敬而远之此处。这里有块牌子(sign)。
LONG);

  set("type", "xie");
  set("owner", "bh_public");
  set("item_desc", ([
    "sign": "各帮派的帮主可以在此处划出(buildroom)一块地盘为己用。\n",
  ]));

  set("exits", ([
    "north": "/d/kaifeng/chengmen",
  ]));

  setup();
}
