inherit ITEM;
inherit F_AUTOLOAD;
inherit F_SAVE;

void create()
{
	set_name("令牌",({"lingpai"}));
        set("unit", "个");
	set("no_drop",1);
        seteuid(getuid());
}

string short()
{
        string guild;

	if( stringp(query("short")) || !stringp(guild = query("banghui")) )
		return "某帮会" + ::short();
        else
                return guild + ::short();
}

string long()
{
	mapping player,npc,area;
	string msg;
	restore();
	player=query("player");
	npc=query("npc");
	area=query("area");
	msg=sprintf("%-16s%-10s%-10s%-10s%-10s\n",
		"帮会名称","帮主","玩家数","NPC数","地盘数");
	msg+="---------------------------------------------------------\n";
	msg+=sprintf("%-16s%-10s%-10d%-10d%-10d\n",query("banghui"),query("bangzhu"),sizeof(player),sizeof(npc),sizeof(area));
	msg+="\n请用show [-p][-n][-a]分别查看帮会玩家、NPC及地盘资料。\n";
	return msg;
}


string query_autoload() { return query("banghui"); }

string query_save_file() { return DATA_DIR + "guild/" + query("banghui"); }

void autoload(string name)
{
	set("banghui",name);
        if( !restore() ) {
		if( environment() ) environment()->delete("banghui");
                destruct(this_object());
        }
}

void init()
{
        if( !environment()->is_character() ) {
		message_vision("$N发出一阵耀眼的光芒，然後消失了。\n", this_object());
                destruct(this_object());
        } else {
		add_action("do_show","show");
	}
}

int do_show(string str)
{
	mapping data;
	string msg,*item;
	int i;
	if(! str ||(str!="-p"&& str !="-n" && str!="-a"))
		return notify_fail("请输入-p、-n或-a进行查看。\n");
	if(! restore())
		return notify_fail("数据恢复出错，请与巫师联系。\n");
	if(str=="-p")	{
		msg="  帮会玩家列表\n";
		msg+="----------------------\n";
		data=query("player");
		if(! data)	data=([]);
		item=keys(data);
		for(i=0;i<sizeof(item);i++)	{
			msg+=data[item[i]]+"("+item[i]+")\n";
		}
		write(msg);
		
	}
	else if(str=="-n")	{
		msg="  帮会NPC列表\n";
		msg+="----------------------\n";
		data=query("npc");
		if(! data)	data=([]);
		item=keys(data);
		for(i=0;i<sizeof(item);i++)	{
			msg+=data[item[i]]+"("+item[i]+")\n";
		}
		write(msg);
	}
	else	{
		msg="  帮会地盘列表\n";
		msg+="----------------------\n";
		data=query("area");
		if(! data)	data=([]);
		item=keys(data);
		for(i=0;i<sizeof(item);i++)	{
			msg+=data[item[i]]+"\n";
		}
		write(msg);
	}
	return 1;
}

