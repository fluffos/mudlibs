#pragma save_binary
#pragma save_binary
// gaoshou.c

#include <ansi.h>

inherit BHNPC;

void create()
{

    set_name("大内高手", ({ "danei gaoshou", "gaoshou","danei" }) );
    set("long", "这是一位朝廷聘用的大内高手，专门负责暗中保护朝廷命官的安全\n");
        set("attitude", "friendly");

    set_skill("spear",400);
     set_skill("parry",400);
    set_skill("dodge",400);
    set_skill("tiyunzong",400);
    set_skill("bahuang-qiangfa",400);
    map_skill("parry", "bahuang-qiangfa");
    map_skill("spear", "bahuang-qiangfa");
    map_skill("dodge", "tiyunzong");


        set("str", 40);
        set("con", 30);
        set("dex", 25);

        set("chat_chance", 15);
        set("chat_msg_combat", ({
        name() + "喝道：反了！竟然想刺杀朝廷命官？\n"
        }) );
        setup();

    carry_object("/clone/cloth/cloth")->wear();
    carry_object("/obj/weapon/spear")->wield();
}

int heal_up()
{
        if( environment() && !is_fighting() ) {
        call_out("leave", 1);
                return 1;
        }
        return ::heal_up() + 1;
}

void leave()
{
    object owner;
    message("vision",
        HIY + name() + "说道：奉大人召唤，现已完成保护的任务，就此告辞！\n"
        + name() + "纵身一跃，消失不见了。\n" NOR, environment(),
                this_object() );
    if(objectp(owner=this_object()->query("owner")) && !environment(this_object())->query("gaoshou"))
       owner->add_temp("havecalled",-1);
    destruct(this_object());
}

void invocation(object who)
{
        int i,d;
        object *enemy;
    object me;
    int skill,skilla;

    me=this_object();
    set("possessed",who);
    skill=who->query_skill("leadership");
    skilla=who->query_skill("strategy");
if (who->query_skill_mapped("force")=="bawang-force") d=(int)who->query_skill("bawang-force",1)/2;

    me->set("owner",who);
    me->set("max_qi",skill*5+skilla*5+500);
    me->set("eff_qi",skill*5+skilla*5+500);
    me->set("qi",skill*5+skilla*5+400);
    me->set("max_jing",skill*5+skilla*5+200);
    me->set("eff_jing",skill*5+skilla*5+200);
    me->set("jing",skill*5+skilla*5+200);
    me->set("max_neili",skill*3+skilla*3+200);
    me->set("eff_neili",skill*3+skilla*3+200);
    me->set("max_jingli",skill*3+skilla*3+200);
    i=skill+skilla;
    skill/=2;
    skilla/=2;
    me->set_skill("spear",40+skill+skilla);
    me->set_skill("parry",40+skill+skilla);
    me->set_skill("dodge",40+skill+skilla);
    me->set_skill("force",40+skill+skilla);
    me->set_skill("bahuang-qiangfa",30+skill/2+skilla);
    me->set_skill("tiyunzong",30+skill+skilla/2);
me->add_temp("apply/damage",d);

//    me->set("combat_exp",who->query("combat_exp")/2+random(who->query("combat_exp")/2));
    set("combat_exp", 10000000 + random((i)/4*i*i));
        message("vision",
                 name() + "喝道：大胆！竟敢和朝廷命官过不去！\n" NOR,
                environment(), this_object() );

    enemy = who->query_enemy();
    i = sizeof(enemy);
    while(i--) {
                if( enemy[i] && living(enemy[i]) ) {
                        kill_ob(enemy[i]);
                        if( userp(enemy[i]) ) enemy[i]->fight_ob(this_object());
                        else enemy[i]->kill_ob(this_object());
                }
        }
    set_leader(who);
}

void backattack(object owner)
{
        int i;
        object *enemy;
        if(objectp(owner))
        {
        enemy = all_inventory(environment());
        i = sizeof(enemy);
        while(i--) {
                if( enemy[i] && living(enemy[i])
                        &&enemy[i]->is_fighting(this_object())
                        &&enemy[i]->is_killing(this_object()->query("id"))
                        &&!enemy[i]->query_temp("disable_command") ) {
                    owner->kill_ob(enemy[i]);
                    enemy[i]->kill_ob(owner);
                }
        }

        }

}

void die()
{
    object owner;
    owner=this_object()->query("owner");
    if(objectp(owner)){
        owner->add("guanfu/can_alert",-1);
        owner->add_temp("havecalled",-1);
    backattack(owner);}
    ::die();
}

