#pragma save_binary
#pragma save_binary
// marchial.c
#include <ansi.h>
inherit BHNPC;
void create()
{       int i,c;
        string *name1 = ({"赵", "张", "王", "万", "蒋", "郭", "李", "武", "关", "周", "郑", "刘"});
        string *name2 = ({"明", "不", "星", "天", "迪", "如", "小", "梦", "光", "福", "彤", "欢"});
        string *name3 = ({"扬", "牛", "刃", "秋", "玑", "强", "英", "姬", "馨", "香", "柔", "倩"});
        set("title",HIY"江湖豪客"NOR);
        set("race","人类");
        set("long", "这是一位外省来的江湖客。\n");
        set("attitude", "heroism");
        set("rank_info/respect","游侠");
        if((i=random(2))==0)
                        set("gender","男性");
        else
                        set("gender","女性");
set_name((name1[random(12)])+
                (name2[random(12)])+
                        (name3[6*i+random(6)]),({"marchial"}));
        set("max_gin", 400);
        set("max_kee", 400);
        set("max_sen", 400);
        set("age",20+random(30));
        set("max_atman", 200);
        set("atman", 200);
        set("max_mana", 200);
        set("mana", 200);
        set("force",200);
        set("max_force",200);
        set("force_factor",random(3));
        set("per", random(20)+10);
        set("int", random(20)+10);
        set("spi", random(20)+10);
        set("str", random(20)+10);
        set("cor", random(20)+10);
        set("cps", random(20)+20);
        set("bellicosity",500+random(1000));
        set("combat_exp", 10000+random(100000));

        set("chat_chance", 45);
        set("chat_msg",({
                (: this_object(), "random_move" :),
        }));
        set("chat_msg_combat", ({
                name() + "喝道：孽障！死去吧！！。。。\n"
        }) );
        set_skill("unarmed",40+random(100));
        set_skill("dodge",40+random(100));
        set_skill("parry",40+random(100));
        set_skill("sword",40+random(100));
        set_skill("blade",40+random(100));
        set_skill("dagger",40+random(100));
        set_skill("hammer",40+random(100));
        set_skill("whip",40+random(100));
        set_skill("staff",40+random(100));
        set_skill("axe",40+random(100));
        set_skill("force",40+random(100));
        setup();
        carry_object("/obj/cloth")->wear();
        c=random(8);
        switch (c)
        {
        case 0: break;
        case 1: carry_object("obj/weapon/dagger")->wield();break;
        case 2: carry_object("obj/weapon/longsword")->wield();break;
        case 3: carry_object("obj/weapon/blade")->wield();break;
        case 4: carry_object("obj/weapon/whip")->wield();break;
        case 5: carry_object("obj/weapon/stick")->wield();break;
        case 6: carry_object("obj/weapon/sixhammer")->wield();break;
        case 7: {
                for(i=0;i<20;i++) carry_object("obj/weapon/dart")->wield();
                break;
                }
        }
        if(random(2)==0) 
                add_money("silver",random(5));
}
int is_ghost()
{
        return 0;
}

