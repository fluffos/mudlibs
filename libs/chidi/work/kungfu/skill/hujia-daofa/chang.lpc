// 八方藏刀式

#include <ansi.h>

inherit F_SSERVER;

int perform(object me) {
  string msg;
  object weapon;
  int skill, jing_cost;
  // mapping my_fam  = me->query("family");

  skill = me->query_skill("hujia-daofa", 1);
  jing_cost = (int)me->query("int") - 45;


  if (me->query("special_skill/gongfusoul") == 1) {
    if (time() - me->query_temp("gongfu_end") < 1) return notify_fail("你刚练过功，会走火入魔的！\n");
  } else {
    if (time() - me->query_temp("gongfu_end") < 2) return notify_fail("你刚练过功，会走火入魔的！\n");
  }

  if (me->is_fighting())
    return notify_fail("「八方藏刀式」不能在战斗中演练。\n");

  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "blade")
    return notify_fail("你必须先去找一把刀。\n");

  if (!skill || (skill < 20))
    return notify_fail("你的胡家刀法等级不够, 不能演练「八方藏刀式」！\n");

  if (me->query("neili") < 50)
    return notify_fail("你的内力不够，没有力气演练「八方藏刀式」！\n");

  if (me->query("jing") < -jing_cost)
    return notify_fail("你现在太累了，无法集中精神演练「八方藏刀式」！\n");

  write(HIC "你运起胡家刀法之「八方藏刀式」，手中" + weapon->name() + "随着刀意漫天飞舞。\n");
  //message_vision(msg, me);

  me->add("neili", -70);

  me->improve_skill("hujia-daofa", random((int)me->query_int()) * 4);
  me->set_temp("gongfu_end", time());
  write(HIY "你的「胡家刀法」进步了！\n" NOR);
  if (me->query("special_skill/gongfusoul") == 1) {
    me->start_busy(random(1));
  } else {
    me->start_busy(random(2));
  }

  //message_vision(msg, me);

  return 1;
}
