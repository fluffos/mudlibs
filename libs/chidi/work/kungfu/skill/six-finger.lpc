           "damage_type":  "刺伤"
        ]),
});


int valid_enable(string usage) { return usage=="finger" || usage=="unarmed" || 
usage=="parry"; }

int valid_learn(object me)
{
	int skill;

	skill = (int)me->query_skill("six-finger", 1);

	if(skill<300)
		return notify_fail("你的六脉神剑等级不够。\n");
	if(skill>500)
		return notify_fail("六脉神剑就只能学到这里了。\n");

	return 1;
}

int invalid_yanjiu(object me)
{
	if(me->query_skill("six-finger", 1) > 500)
	{
		return 1;
	}
                return 0;
}

string query_skill_name(int level)
{
    int i;
    for(i = sizeof(action); i > 0; i--)
            if(level >= action[i-1]["lvl"])
                    return action[i-1]["skill_name"];
}

int practice_skill(object me)
{
    return notify_fail("六脉神剑不能这样提高。\n");
}

mapping query_action(object me, object weapon)
{
    mapping a_action;
	int level,i,times;

    level   = (int) me->query_skill("six-finger", 1);
	times	= 1;

	if (random(level) > 300 && (string)me->query_skill_mapped("force") == "kumu-shengong" && 
		me->query_skill("kumu-shengong",1) > 500 && me->query("neili") > 300 && 
		me->query("family/family_name") == "大理段家")
	{
		times = 3 + (me->query_skill("six-finger",1)/500000);

		me->add("neili", -100);
	}

	me->add("neili", -100);
        for(i = sizeof(action); i > 0; i--)
        {
            if(level > action[i-1]["lvl"])
	    {
                a_action = action[NewRandom(i, 20, level/5)];
	        break;
            }
	}
    a_action["dodge"]  = (0-level/2)*times;
    a_action["parry"]  = (0-level/2)*times;
    a_action["attack"]  = (level/2)*times;
    a_action["damage"] = level*times;

	return a_action;
}

void do_interlink(object me, object victim)
{
    int maxskill,skill,i,j,k;
	int dex_add, hit_num;
	object *enemys,enemy;

    if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
		return;

    if( me->query("neili") < 2000 ) return;

    if( ((string)me->query_skill_mapped("force")!="kumu-shengong" ||
		(int)me->query_skill("kumu-shengong", 1) < 500 ||
		me->query("family/family_name") != "大理段家") && userp(me) )
		return;

    if( (int)me->query_skill("pixie-jian", 1) > 100 ) return;

    maxskill=me->query_skill("six-finger", 1);

	if (maxskill < 500) return;

	message_vision(HIM"\n$N忽然觉得剑谱中的六路剑法一一涌向心头，十指纷弹，此去彼来，
连绵无尽。剑气纵横，尘烟四起，六路剑法回转运使，$n顿时心神大乱，但
觉全身几处刺痛，几股鲜血从身上流出。忍痛抬头一看，一柱剑气迎面又到\n\n"NOR,me,victim);

    if (maxskill > 10000) skill = 10000;
	else skill = maxskill;

    enemys=me->query_enemy();
	k = sizeof(enemys);
    if (!k) return;

	hit_num = random(skill/500);
    for (i=0; i<5 + hit_num; i++)
	{
		j = random(20);
		if(k <= 1)
			enemy = enemys[0];
		else
			enemy = enemys[i%(k-1)];

		enemy->delete_temp("apply/shade_vision");

		if(j < 16)
		{
			message_vision(HIC+"\n$N大喝道：“"+HIR+skill_name[random(6)]+NOR+HIC+"”，随即一指向$n点出。" NOR,me,enemy);
			if ((int)enemy->query_skill("pixie-jian", 1) > 100)
			{
				dex_add = skill/100 + random(maxskill/2);
				me->add_temp("dex", dex_add);
				COMBAT_D->do_attack(me, enemy, 0, 0);
				me->add_temp("dex", -dex_add);
			}
			else
			{
				dex_add = skill/100 + random(maxskill/20);
				me->add_temp("dex",dex_add);
				COMBAT_D->do_attack(me, enemy, 0, 0);
				me->add_temp("dex",-dex_add);
			}
		}
		else if(j < 19)
		{
			//message_vision(HIY+"$N长笑一声，十指齐出，举止若行云流水，一指一划间气势磅礴。\n\n" NOR,me);
			message_vision(HIR+"\n$N长笑一声，十指齐出，一指一划间气势磅礴，$n立刻被打得委顿下来。\n" NOR, me, enemy);
			if( ((int)enemy->query_skill("pixie-jian", 1) > 100 && 
				(random(me->query_str()) >= enemy->query_str()/2)) ||
				(random(me->query("force")) >= enemy->query("force")/4*3))
			{
				enemy->receive_wound("qi", maxskill/2 + random(maxskill/2));
				enemy->receive_wound("jing", maxskill/20 + random(maxskill/10));
			}
			else
			{
				enemy->receive_wound("qi", maxskill/6 + random(maxskill/6));
				enemy->receive_wound("jing", maxskill/60 + random(maxskill/30));
			}
			enemy->apply_condition("yyz_damage", random(me->query_skill("six-finger", 1))
				+ enemy->query_condition("yyz_damage"));
			enemy->set_temp("yyzenemy", me->query("id"));
		}
		else
		{
			message_vision(HIB+"\n$N右手中指一竖，一式『中冲剑』发出，$n感觉胸口一麻就被定住。\n" NOR,me,enemy);
			enemy->start_busy(5);
		}
	}

	me->add("neili", -2000);
	me->start_busy(2);
}

mixed hit_ob(object me, object victim, int damage_bonus)
{
	object weapon;
	weapon = victim->query_temp("weapon");

    if( (string)me->query_skill_mapped("force")!="kumu-shengong" ||
		(int)me->query_skill("kumu-shengong", 1) < 500 ||
		me->query("family/family_name") != "大理段家" )
		return 100;

	if( damage_bonus < 100 ) return damage_bonus;
    if ((int)me->query("neili") < 20000)     return damage_bonus/10;
	if( ((int)victim->query_skill("pixie-jian", 1) > 100 && 
		(random(me->query_str()) >= victim->query_str()/3)) ||
		(random(me->query("force")) >= victim->query("force")/4*3))
	{
		me->add( "neili", -(1000+random(1000)) );
		victim->receive_wound("qi", damage_bonus/2);
		victim->delete_temp("apply/shade_vision");
		victim->apply_condition("yyz_damage", random(me->query_skill("six-finger", 1))
			+ victim->query_condition("yyz_damage"));
		victim->set_temp("yyzenemy", me->query("id"));

		return HIR "你听到「嗤啦」一声轻响，脸上竟溅到一些血滴！\n" NOR;
	}
	me->add( "neili", -(300+random(500)) );

	return (damage_bonus-100)/4;
}

string perform_action_file(string action)
{
	return __DIR__"six-finger/" + action;
}

mapping *query_skilldbase() {return action;}

