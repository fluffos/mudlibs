// powerup
#include <ansi.h>
inherit F_SSERVER;
void remove_effect(object me, int skill);
int exert(object me, object target) {
  int skill;
  string msg;
  if (me->query_temp("cast_powerup"))
    return notify_fail("你正在运功当中。\n");
  if (!me->query_skill_mapped("force")
    && me->query_skill_mapped("force") != "gouyee")
    return notify_fail("只有配合谷衣心法才能提升自身承受伤害的力量。\n");
  if (me->query("jingli") < 50)
    return notify_fail("你的精力不够！\n");

  me->add("jingli", -30);
  msg = CYN "$N默念咒语，$N的身体微微发光。不过瞬间又消失了。。。\n" NOR;
  message_vision(msg, me);
  msg = "你的抵抗能力提高了。\n";
  tell_object(me, msg);
  me->set_temp("cast_powerup", 1);
  skill = me->query_skill("gouyee");
  me->set_temp("apply/armor_vs_force", skill);
  if (me->is_fighting())
    me->start_busy(me->query_busy() + 2);
  me->start_call_out((: call_other, __FILE__, "remove_effect", me, skill :), skill);
  return 1;
}
void remove_effect(object me, int skill) {
  string msg;
  me->delete_temp("cast_powerup");
  if (me->query_temp("apply/armor_vs_force") < skill)
    me->delete_temp("apply/armor_vs_force");
  else
    me->add_temp("apply/armor_vs_force", -skill);
  msg = CYN "你的抵抗能力恢复正常了。\n" NOR;
  tell_object(me, msg);
  return;
}
