int valid_enable(string usage) {
  return usage == "sword" || usage == "dodge" || usage == "axe" || usage == "whip" || usage == "club" || usage == "staff" || usage == "throwing" || usage == "strike" || usage == "hand" || usage == "claw" || usage == "finger" || usage == "cuff" || usage == "blade" || usage == "unarmed" || usage == "hammer" || usage == "parry";
}
string query_parry_msg(object me, object weapon) {
  string msg;
  object my_weapon;

  if (!(my_weapon = me->query_temp("weapon"))) {
    if (!(my_weapon = me->query_temp("secondary_weapon")))
      return "";
  } else {
    if (!valid_enable(my_weapon->query("skill_type"))) {
      if (!(my_weapon = me->query_temp("secondary_weapon")))
        return "";
      else if (!valid_enable(my_weapon->query("skill_type")))
        return "";
    }
  }
  if (weapon)
    msg = weapon_vs_weapon_msg[random(sizeof(weapon_vs_weapon_msg))];
  else
    msg = unarmed_vs_weapon_msg[random(sizeof(unarmed_vs_weapon_msg))];
  msg = replace_string(msg, "$i", my_weapon->name());
  return msg;
}

string query_skill_name(int level) {
  int i;
  for (i = sizeof(action) - 1; i >= 0; i--)
    if (level >= action[i]["lvl"])
      return action[i]["skill_name"];
}
mapping query_action(object me, object weapon) {
  mapping a_action;
  int i, level;
  level = (int)me->query_skill("kuihua-baodian", 1);
  for (i = sizeof(action); i > 0; i--)
    if (level > action[i - 1]["lvl"]) {
      a_action = action[NewRandom(i, 20, level / 5)];
      break;
    }
  a_action["dodge"] = 0 - level * 4;
  a_action["parry"] = 0 - level * 4;
  a_action["attack"] = level * 4;
  a_action["damage"] = level * 4;
  if (me->query_temp("action_flag"))
    me->set_temp("action_msg", "紧跟着");
  return a_action;

}

string query_dodge_msg(string limb, object me) {
  me->set_temp("fight/dodge", me->query_skill("kuihua-baodian", 1) * 5);
  return dodge_msg[random(sizeof(dodge_msg))];
}
int valid_learn(object me) {

  if ((int)me->query_skill("jiuzhuan-12tian", 1) < 10000)
    return notify_fail("你的[阴阳九转十二重天]还没学到一万级，理解不了。\n");
  if ((int)me->query_skill("dugu-jiujian", 1) < 10000)
    return notify_fail("你的独孤九剑还没学到一万级，理解不了。\n");
  if ((int)me->query_skill("pixie-jian", 1) < 10000)
    return notify_fail("你的辟邪剑法还没学到一万级，理解不了。\n");
  if ((int)me->query_skill("yifeng-jian", 1) < 10000)
    return notify_fail("你的独孤九剑还没学到一万级，理解不了。\n");
  if ((int)me->query_skill("true-huaxue", 1) < 10000)
    return notify_fail("你的真化血神针还没学到一万级，理解不了。\n");
  if ((int)me->query_skill("tianxin-blade", 1) < 10000)
    return notify_fail("你的天行刀法还没学到一万级，理解不了。\n");
  if ((int)me->query_skill("tiandao-blade", 1) < 10000)
    return notify_fail("你的天刀刀法还没学到一万级，理解不了。\n");
  if ((int)me->query_skill("hujia-daofa", 1) < 10000)
    return notify_fail("你的胡家刀法还没学到一万级，理解不了。\n");
  if ((int)me->query_skill("kuihua-baodian", 1) > 400)
    return notify_fail("[葵花宝典]我只能教你这么多，以后就要靠你自己练习了。\n");

  return 1;
}

int valid_combo(string combo) {
  return combo == "kuihua-baodian";
}


mixed hit_ob(object me, object victim, int damage_bonus, int factor) {
  object weap, weap1;
  weap = victim->query_temp("weapon");
  weap1 = me->query_temp("weapon");
  if ((me->query_skill("kuihua-baodian") > 450) && (me->query("neili") > 10000)
    && (victim->query_temp("weapon"))
    && random(10) > 4) {
    message_vision(
      HIY "只见$N手中" + weap1->name() + "" HIY "一剑化千剑，一剑连着一剑将对方的" + weap->name() + "" HIR "刺的火星直冒！\n" NOR,
      me
    );
    if (!victim->is_busy())
      victim->start_busy(3);
    if ((me->query_skill("force")) > victim->query_skill("force") / 3) {
      message_vision(HIR "\n潜运全身真劲全力一剑刺下，只听 乒! 的一声巨响，" + weap->name()
        + "被" + weap1->name() + "" HIR "从$N" HIR "手中直刺成两段，$N" HIR "情急之下只好空手应战。\n" NOR, victim);
      weap->move(environment(me));
      weap->set("name", "断掉的" + weap->query("name"));
      victim->reset_action();
      weap->set("value", 0);
      weap->set("weapon_prop", 0);
      weap->set("long", "一把断掉的武器，从中断开，破口整齐，看来是被绝顶高手生生震断的。\n");
    } else {
      message_vision(HIY "\n$N暗运卸字决，" + weap->name()
        + "" HIY "顺着方向快速旋转数下，将" + weap1->name() + "" HIY "上的真劲全数卸去。\n" NOR, victim);
      victim->add("neili", -1000);
    }
    me->add("neili", -(20 + random(30)));
  }

  if (damage_bonus < 110) return 0;
  if (me->query("neili") < 50000) return 0;
  if (random(10) < 2) return 0;

  //  第六等级的伤气
  if (me->query_skill("kuihua-baodian", 1) > 4000
  ) {
    victim->receive_damage("qi", (damage_bonus) * 8, me);
    victim->receive_damage("jing", (damage_bonus) * 8, me);
    victim->delete_temp("apply/shade_vision");
    victim->clear_condition();
    return WHT "$N的葵花宝典已达到天人合一境界，配合九转12天发挥出第六层暗劲扑向$n！\n" NOR;
  }

  //  第五等级的伤气
  if (me->query_skill("kuihua-baodian", 1) > 3000
  ) {
    victim->receive_damage("qi", damage_bonus * 7, me);
    victim->receive_damage("jing", damage_bonus * 7, me);
    return YEL "$N的葵花宝典已达到忘我境界，配合九转12天发挥出第五层暗劲扑向$n！\n" NOR;
  }
  if (damage_bonus < 100) return 0;

  //  第四等级的伤气
  if (me->query_skill("kuihua-baodian", 1) > 2000
  ) {
    victim->receive_damage("qi", (damage_bonus - 100) * 6, me);
    victim->receive_damage("jing", (damage_bonus - 100) * 6, me);
    return MAG "$N的葵花宝典已达到忘物境界，配合九转12天发挥出第四层暗劲扑向$n！\n" NOR;
  }

  //  第三等级的伤气
  if (me->query_skill("kuihua-baodian", 1) > 500
  ) {
    victim->receive_wound("qi", (damage_bonus - 100) * 5, me);
    victim->receive_wound("jing", (damage_bonus - 100) * 5, me);
    return CYN "$N的葵花宝典已达到登堂入室境界，随意一击带出一阵暗劲扑向$n！\n" NOR;
  }
  // 第二等级的伤气
  if (me->query_skill("kuihua-baodian", 1) > 300
  ) {
    victim->receive_wound("qi", (damage_bonus - 100) * 3, me);
    victim->receive_wound("jing", (damage_bonus - 100) * 3, me);
    return RED "$N的葵花宝典已初有小成,带出一小阵" HIR "暗劲" HIW "扑向$n！\n" NOR;
  }
}
void do_interlink(object me, object victim) {
  int skill, i, j;
  object *enemy;

  skill = me->query_skill("kuihua-baodian", 1);
  if (skill > 2400) skill = 2400;

  if (skill > 60) {
    enemy = me->query_enemy();
    if (!sizeof(enemy)) return;
    // 对所有敌人均自动进行攻击
    for (i = 0; i < sizeof(enemy); i++) {
      for (j = 0; j < (skill / (60 * sizeof(enemy))); j++)
        if ((me->is_fighting(enemy[i]) || enemy[i]->is_fighting(me))) {
          if (environment(me) == environment(enemy[i])) {
            me->add_temp("str", skill / 100);
            me->add_temp("dex", skill / 100);

            if (me->query("special_skill/gongfusoul") == 1) {
              me->start_busy(random(1)); ;
            } else {
              me->start_busy(1);
            }


            COMBAT_D->do_attack(me, enemy[i], me->query_temp("weapon"), TYPE_REGULAR);
          }
        } else break;
    }
    me->delete_temp("str");
    me->delete_temp("dex");
  }
}


string perform_action_file(string action) {
  return __DIR__ "kuihua-baodian/" + action;
}
