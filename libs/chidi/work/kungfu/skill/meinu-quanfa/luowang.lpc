// luowang.c 

#include <ansi.h>

inherit F_SSERVER;
int perform(object me, object target)
{
        string msg;
        object weapon;

        if( !target ) target = offensive_target(me);

        if( !target
        ||      !target->is_character()
        ||      !me->is_fighting(target) )
                return notify_fail("牵制攻击只能对战斗中的对手使用。\n");

        if( (int)me->query_skill("force") < 100 )
                return notify_fail("你的内功修为不够火候，使用不了「天罗地网势」。\n");
        
        if( me->query_skill_mapped("force") != "yunu-xinjing")
                return notify_fail("你所用的内功与美女拳的气路相悖！\n");

        if( me->query("neili") <= 300 )
                return notify_fail("你的内力不够！\n");

        if( me->query("jingli") <= 200 )
                return notify_fail("你的精力不够！\n");
                
        if( (int)me->query_skill("cuff") < 120 )
                return notify_fail("你的美女拳不够娴熟，不会使用「天罗地网势」。\n");

        if( target->is_busy() ) 
                return notify_fail(target->name() + "目前正自顾不暇，放胆攻击吧ⅵ\n");

        msg = CYN "$N使出打美女拳「天罗地网势」，双拳舞起天罗地网，将$n吞没！\n";
        me->add("neili", -80);
        me->add("jingli", -20);

        if( ((random(me->query("combat_exp")/10000) * (int)me->query_skill("meinu-quan") ) > 
        (((int)target->query("combat_exp")/5000) * ((int)target->query_skill("parry")/2 + (int)target->query_skill("dodge")/2))/4) ) {

                msg += "结果$p被$P攻了个手忙脚乱，一时无法还招进攻！\n" NOR;
                target->start_busy( (int)me->query_skill("tianluo-diwang") /(30+random(10)));
        } else {
                msg += "可是$p看破了$P的企图，并没有上当。\n" NOR;
                me->start_busy(1+random(3));
        }
        message_vision(msg, me, target);

        return 1;
}

