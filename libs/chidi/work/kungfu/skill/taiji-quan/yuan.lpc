// tie@fengyun

#include <ansi.h>
#include <combat.h>
inherit F_SSERVER;
int perform(object me, object target) {
  string msg;
  int extra, skills, skills2;
  int i;
  object weapon;
  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("太极拳法之「圆转如意」只能对战斗中的对手使用。\n");

  if (objectp(me->query_temp("weapon")))
    return notify_fail("你先放下手中的武器再说吧？！\n");
  if ((int)me->query("neili") < 15000)
    return notify_fail("你的内力不够，不能用「圆转如意」\n");

  if ((int)me->query_skill("taiji-quan", 1) < 1500)
    return notify_fail("你的太极拳法不够娴熟，不能用「圆转如意」。\n");

  if ((int)me->query_skill("taiji-shengong", 1) < 1500)
    return notify_fail("你的太极神功不够娴熟，不能使用「圆转如意」。\n");
  skills = me->query_skill("taiji-quan", 1); if (skills > 2400) skills = 2400;
  skills2 = me->query_skill("taiji-shengong", 1); if (skills2 > 2000) skills2 = 2000;
  extra = skills / 20;
  extra += skills2 / 20;
  me->add_temp("apply/attack", extra);
  me->add_temp("apply/damage", extra);
  msg = HIM "$N运起［太极神功］，同时使出［太极拳法］中的「圆转如意」！\n" NOR;
  message_vision(msg, me, target);
  msg = HIW "$N划了一个圆圈！\n" NOR;
  message_vision(msg, me, target);
  for (i = 0; i < (skills / 6000 + 18); i++) {
    COMBAT_D->do_attack(me, target, weapon, TYPE_REGULAR, msg);
  }
  me->add_temp("apply/attack", -extra);
  me->add_temp("apply/damage", -extra);
  me->add("neili", -1000);
  me->start_busy(3);
  return 1;
}
