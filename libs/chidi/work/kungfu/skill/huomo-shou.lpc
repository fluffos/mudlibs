// huomo-shou.c【火魔手】
inherit SKILL;
#include <ansi.h>
mapping *action = ({
([    "action" : 
"$N口中朗声吟道：“"HIR"自传芳酒翻红袖，似有微词动绛唇。"NOR"”\n"
"长袖巧翻，如云似水的翻滚。火劲猎猎，一股股热浪卷向$n。",
    "dodge" : 5,
    "damage" : 35,
    "parry"  :10,
    "damage_type" : "淤伤"
]),
([    "action" : 
"$N口中朗声吟道：“"HIY"雾气暗通青桂苑，日华摇动黄金袍。"NOR"”\n"
"$N脸色涨的通红，衣袖鼓动，涨成了个圆球，蓄势而发。",
    "dodge" : 10,
    "damage" : 40,
    "parry"  :15,
    "damage_type" : "淤伤"
]),
([    "action" : 
"$N口中吟道：“"HIG"垂手乱翻雕玉璧，背人多整绿去鬟。"NOR"”\n"
"$N左手护胸，身形如蛇般摆动，右手却背在背后。手指不断抖动，\n"
"渐渐变得赤红。遥遥的弹向$n",
    "dodge" : 5,
    "damage" : 65,
    "parry"  :5,
    "damage_type" : "淤伤"
]),
([    "action" : 
"$N口中吟道：“"HIG"纤腰怕束金蝉断，寒鬓斜簪玉燕光。"NOR"”\n"
"$N右掌拖着一道淡淡的红烟，在空中变了三、四种手法才拂出。\n"
"不管击中没有，$N马上如一只大鸟，一飞冲天！",
    "dodge" : -5,
    "damage" : 85,
    "parry"  :-5,
    "weapon": "右掌",
    "damage_type" : "刺伤"
]),
([    "action" : 
"$N口中吟道：“"HIC"黄鹂久住浑相识，青鸟西飞意未回。"NOR"”\n"
"$N高高的跃起，凭着过人的轻功在半空盘旋。每盘旋一圈，功力暂时\n"
"就加一倍。回旋三次，$N的手掌凌空一挥，一股巨大的压力顿时向$n了出去。",
    "dodge" : -10,
    "damage" : 100,
    "parry"  :0,
    "damage_type" : "内伤"
]),
([    "action" : 
"$N口中吟道：“"HIC"帘前春色应须惜，楼上花枝笑独眠。"NOR"”\n"
"$N双手一翻，舞出掌影片片护住全身，另人眼花缭乱。片刻，\n"
"漫天掌影产生了变化，一片片被舞地赤红，像火蝴蝶一样围向$n！",
    "dodge" : 0,
    "parry"  :15,
    "damage" :180,
    "damage_type" : "淤伤"
])
});
int valid_enable(string usage) { 
    return (usage == "hand") || (usage == "unarmed");
}
int valid_combine(string combo) { return combo=="mjhong"; }

int valid_learn(object me)
{
    if ((int)me->query("neili") < 500)
   return notify_fail("你的内力不够。\n");
    if ((int)me->query_skill("force", 1) < 50)
   return notify_fail("你的内功火候太浅。\n");
    if ((int)me->query_skill("fire-force", 1) < 50)
   return notify_fail("你的业火神通火候太浅。\n");
    if( me->query_temp("weapon") || me->query_temp("secondary_weapon") )
   return notify_fail("练火魔手必须空手。\n");
        if( (string)me->query_skill_mapped("force")!= "fire-force")
    return notify_fail("学火魔手必须配合业火神通。\n");

    return 1;
}
mapping query_action(object me, object weapon)
{
        return action[random(sizeof(action))];
}
int practice_skill(object me)
{
        if( (int)me->query("qi") < 30
        ||      (int)me->query("neili") < 3 )
                return notify_fail("你的内力或气不够。\n");
        me->add("qi", -30);
        me->add("neili", -3);
        return 1;
}
string perform_action_file(string func)
{
return CLASS_D("wandao") + "/huomo-shou/" + func;
}
mixed hit_ob(object me, object victim, int damage_bonus)
{
        if( damage_bonus < 100 ) return 0;

        if( random(damage_bonus/2) > victim->query_str() 
        && (string)me->query_skill_mapped("force") == "fire-force"
        && (int)me->query("neili") > (int)victim->query("neili")*2/3 ) {
                victim->receive_wound("qi", (damage_bonus) / 2 );
                switch(random(3)) {
                        case 0: return HIR"$n的经脉被一丝丝狂燥的火劲给侵入，全身痛苦无比！\n"NOR;
                        case 1: return HIR"只听见“碰”的一声，$n身上的火劲爆发了！\n"NOR;
                        case 2: return HIR"$n只闻到一阵阵烧焦的味道，完全不知道自己已经被烧地体无完肤了！\n"NOR;
                }
        }
}

