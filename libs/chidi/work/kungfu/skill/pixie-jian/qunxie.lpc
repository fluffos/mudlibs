#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit F_SSERVER;
 
int perform(object me, object target)
{
    object weapon, ob, zb;
    string msg;
    int i, a;
 
    ob = me->select_opponent();
    if( !me->is_fighting() )
        return notify_fail("辟邪剑法之「群邪辟易」只能在战斗时使用。\n");
     if (me->query_temp("perform")>time()) return notify_fail("你上一招未使完！\n");
    if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "sword")
    if (!objectp(weapon = me->query_temp("secondary_weapon"))
    || (string)weapon->query("skill_type") != "sword")
        return notify_fail("你使用的武器不对。\n");
    else me->set_temp("secondly_weapon",1);
    if( (int)me->query("neili") < 2000 )
        return notify_fail("你的真气不够！\n");
    if( (int)me->query_skill("sword") < 1000 ||
        me->query_skill_mapped("sword") != "pixie-jian")
        return notify_fail("你的「辟邪剑法」还不够精纯，无法使用「群邪辟易」！\n");
msg = HIC "$N冷笑一声，突然向"+ob->name()+"直冲过去，"+ob->name()+"一惊，只觉得几股极细的剑气扑面而来！!\n" NOR;
    message_vision(msg, me);
    me->clean_up_enemy();
    me->add("neili", -150);
    me->set_temp("perform",time()+3);
    me->set_temp("perform_qunxie",1);        

    for(i = 0; i < 3; i++)
        if (me->is_fighting(ob) && ob->is_fighting(me) && ob->query("eff_qi")>0){
              me->set_temp("action_msg",HIY"剑势未缓\n"NOR);
                if (!weapon->query("equipped")) break;
              COMBAT_D->do_attack(me, ob,weapon, 0);
            }else break;

    if ( me->query_temp("armor") ) { // 装备开始
        if ( zb =  me->query_temp("armor/cloth") ) // 衣服
        {
             if ( zb->query("skill/pixie-jian") == "cloth" ) { 
             a = 1;
             if ( ob->query("eff_qi")>0 ) {
             message_vision(HIG"$N把七彩凤衣一挥，"+ob->name()+"一不小心又被连攻数招!\n"NOR, me);
             COMBAT_D->do_attack(me, ob,weapon, 0);
             COMBAT_D->do_attack(me, ob,weapon, 0);
                                           }
             }
         }

         if ( zb = me->query_temp("armor/finger") ) // 戒指
         {
             if ( zb->query("skill/pixie-jian") == "jiezhi" ) { 
             a++;
             if ( ob->query("eff_qi")>0 ) {
             message_vision(HIY"$N手中金"HIW"戒"HIG"指"HIY"一闪，一个转身又连攻数招!\n"NOR, me);
             COMBAT_D->do_attack(me, ob,weapon, 0);
             COMBAT_D->do_attack(me, ob,weapon, 0);
                                           }
             }
         }
                 
         if ( zb = me->query_temp("armor/neck") ) // 项链
         {
             if ( zb->query("skill/pixie-jian") == "xianglian" ) { 
             a++;
             if ( ob->query("eff_qi")>0 ) {
             message_vision(HIR"$N脖子上的"HIW"白金"HIM"项链"HIR"突然发出一阵强烈的光芒，"+ob->name()+"感觉一阵刺眼，又被连攻数招!\n"NOR, me);
             COMBAT_D->do_attack(me, ob,weapon, 0);
             COMBAT_D->do_attack(me, ob,weapon, 0);
                                           }
             }
         }

         if ( zb = me->query_temp("armor/boots") ) // 鞋子
         {
             if ( zb->query("skill/pixie-jian") == "xie" ) { 
             a++;
             if ( ob->query("eff_qi")>0 ) {
             message_vision(HIM"$N的双脚随着"HIB"绣花"HIC"小鞋"HIM"一阵快速移动，"+ob->name()+"看的晕头转向，又被连功数招\n"NOR, me);
             COMBAT_D->do_attack(me, ob,weapon, 0);
             COMBAT_D->do_attack(me, ob,weapon, 0);                                                                           }
             }
         }

         if ( a > 3 ) // 整套装备的作用
         {
             if ( ob->query("eff_qi")>0 ) {
             message_vision(HIY"$N的整套装备突然发出一阵金黄色的光芒，"+ob->name()+"一不小心，被$N连攻数招!!\n"NOR, me);
             COMBAT_D->do_attack(me, ob,weapon, 0);
             COMBAT_D->do_attack(me, ob,weapon, 0);   
             COMBAT_D->do_attack(me, ob,weapon, 0);  
                                           }
          }
    }
    me->delete_temp("perform_qunxie");
    me->delete_temp("secondly_weapon");
    return 1;
}

