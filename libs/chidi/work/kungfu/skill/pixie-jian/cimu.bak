#include <ansi.h>
inherit F_SSERVER;
int perform(object me, object target)
{
    object weapon;

    int damage;

    string msg;
    int busy;
    busy=(int)me->query_skill("pixie-jian") / 40; 
    if (busy > 20 ) busy=20;

    if( !target ) target = offensive_target(me);
    if( !target || !target->is_character() || !me->is_fighting(target) )
        return notify_fail("「刺目」只能对战斗中的对手使用。\n");

    if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "sword")
    if (!objectp(weapon = me->query_temp("secondary_weapon"))
    || (string)weapon->query("skill_type") != "sword")
        return notify_fail("你使用的武器不对。\n");
        
    if( (int)me->query_skill("pixie-jian", 1) < 800 )
        return notify_fail("你的辟邪剑法不够娴熟，不会使用。\n");
                            
    if( target->is_busy() )
        return notify_fail(target->name() + "目前正自顾不暇，放胆攻击吧。\n");

     if( (int)me->query("neili", 1) < 3000 )
        return notify_fail("你现在内力太弱，不能使用「刺目」。\n");
            
    msg = HIC "$N凝神息气，手腕疾抖，使出辟邪剑法中的绝招--“刺目”。只见千万个剑影扑天盖地飞向$n。\n\n"NOR;
  if( !target->is_killing(me) ) target->kill_ob(me);
  if (random(me->query_exp()*5) > target->query_exp() )
    {
     target->start_busy( busy );
        
        damage = (int)me->query_skill("pixie-jian", 1);
        damage = damage +  (int)me->query_skill("sword", 1);
        
        target->receive_damage("qi", damage,me);
        target->receive_wound("qi", damage/3,me);
        me->add("neili", -damage/2);
        msg += HIR"$n只觉一股双眼一黑，发现自己看不见东西了！\n"NOR;
        me->start_busy(1);
    } else 
    {
        msg += HIG"可是$p猛地向后一跃,跳出了$P的攻击范围。\n"NOR;
        me->add("neili", -100);
        me->start_busy(4);
    }
    message_vision(msg, me, target);
    return 1;
}

