// 独孤之以攻为守，无招胜有招
// add by lonely
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit F_SSERVER;

void do_attack(object me,object target,object weapon,int attack_time)
{
    int i;
    if (!me) return;
    me->delete_temp("perform");
    if (!living(me) || !target ) return;
    if (weapon == me->query_temp("secondary_weapon") )
    me->set_temp("secondly_weapon",1);
    if (!weapon->query("equipped")){ me->start_busy(3); return; }
    if (environment(me)!=environment(target)) return;
        for(i = 0; i < attack_time; i++)
            if (me->is_fighting(target) && target->is_fighting(me) && target->query("eff_qi")>0){
              me->set_temp("action_msg","紧接着后发先至");
// 断掉的断掉的断掉的断掉的断掉的断掉的断掉的断掉的，
                if (!weapon->query("equipped")){ me->start_busy(2); return; }
       if (me->query_skill_mapped("sword")!="dugu-jiujian") {me->start_busy(3); return; }
              COMBAT_D->do_attack(me, target, weapon, 0);
              me->start_busy(1);
            }else break;
    me->delete_temp("secondly_weapon");
    if (i) message_vision(CYN " 结果$p被$P攻了毫无还手之力！\n" NOR, me, target);
}

int perform(object me, object target)
{
    object weapon;
    string msg;
    int attack_time;
    if( !target ) target = offensive_target(me);
    if( !target
    ||  !target->is_character()
    ||  !me->is_fighting(target) )
       return notify_fail("「以攻为守」字诀只能对战斗中的对手使用。\n");
    if (!objectp(weapon = me->query_temp("weapon"))
        || (string)weapon->query("skill_type") != "sword")
    if (!objectp(weapon = me->query_temp("secondary_weapon"))
        || (string)weapon->query("skill_type") != "sword")
        return notify_fail("你使用的武器不对。\n");
    if( (int)me->query_skill("dugu-jiujian", 1) < 800 )
       return notify_fail("你还没有领悟独孤九剑的真谛，不会使用「以攻为守」字诀。\n");
   if( !me->query("duguqiubai") )
       return notify_fail("你没有得到仙遇,无法领会这一招。\n");
  if( (int)me->query_int() < 210 )
     return notify_fail("你的悟性不够，你无法领悟以攻为守。\n");
    if (!me->visible(target))    return notify_fail("你看不到"+target->name()+"。\n");
    if (me->query_temp("perform"))  return notify_fail("你上一个招式还没完成!\n");
    if ( me->query("neili")<100 )   return notify_fail("你的内力不足!\n");
    if( me->is_busy()) return notify_fail("你现在正忙着。\n");
      msg = HIY "$N使出独孤九剑「以攻为守」字诀，招招指向你的破绽，逼的$n不得不守。\n" NOR;
    if( !living(target) || random(me->query("combat_exp")) > (int)target->query("combat_exp")/3 )
    {
       attack_time = (int)me->query_skill("dugu-jiujian", 1) / 20;
        if(attack_time < 1)
            attack_time = 1;
    me->start_call_out( (: call_other, __FILE__, "do_attack", me, target,weapon,attack_time :), 2);
    if (me->query("neili")<150)
        me->set("neili",0);
    else
        me->add("neili", -150);
    me->set_temp("perform",1);
    }
    else
    {
        msg += HIY  "虽然$p"+ HIY +"看破了$P的企图，但还是侥幸逃离。\n" NOR;
          me->start_busy(1);
    }
    message_vision(msg, me, target);
    return 1;
}

