// zuida.c 少林醉棍 [八仙醉打]
#include <ansi.h>
inherit F_SSERVER;
void remove_effect(object me, int amount, int amount1);
int perform(object me, object target)
{
    object weapon;  
    string msg;
    int count, count1, cnt, skill;
    
    if( !me->is_fighting() )
        return notify_fail("「八仙醉打」只能在战斗中使用。\n");

    target = offensive_target(me);
        if( !target ) return notify_fail("八仙醉打只对战斗中的对手有效！\n");

    if (!objectp(weapon = me->query_temp("weapon"))
        || (string)weapon->query("skill_type") != "club")
            return notify_fail("你使用的武器不对。\n");

    if( environment(me)->query("no_fight") )
        return notify_fail("在这里你不能乱用醉棍打人！\n");

    if( (int)me->query_temp("zuida") ) 
        return notify_fail("你已经在运功中了。\n");

    if( (int)me->query_str() < 25 )
        return notify_fail("你的臂力不够，目前不能使用此绝技! \n");
	if( (int)me->query_skill("hunyuan-yiqi", 1) < 600)
		if( (int)me->query_skill("yijing-force",1) < 600)
			return notify_fail("你的混元一气功的功力不够，不能使用此项绝技！\n");

    if( (int)me->query_skill("club") < 900)
        return notify_fail("你的棍法修为不够，不能使用此项绝技! \n");

    if( (skill = me->query_skill("zui-gun", 1)) < 900 )
        return notify_fail("你在棍法上下的功夫还不够，不会使八仙醉打！\n");

    if( (int)me->query("neili") < 5000 )
        return notify_fail("你的真气不足！\n");

    if( me->query("jingli") < 500 )
        return notify_fail("你现在的精力不够，无法达到形醉意不醉的状态！\n");

    msg = HIY "$N使出少林醉棍的绝技「八仙醉打」，臂力陡然增加, 身法陡然加快！\n" NOR;
    
    message_vision(msg, me, target);
    skill = me->query_skill("zui-gun",1);
    cnt =(int)( (int)me->query_condition("drunk") / 3 );
    count = (me->query_skill("unarmed")/500 + random(cnt + 1)*2) * 2;
    count1 = (me->query_skill("dodge")/500 + random(cnt + 1)*2) * 2;
    me->add_temp("apply/attack",  count);
    me->add_temp("apply/dodge", count1);
    me->set_temp("zuida", 1);
    me->start_call_out( (: call_other, __FILE__, "remove_effect", me, count, count1 :), skill /3 );
    me->add("neili", -150);
	me->add("jingli", -250);
    return 1;
}
void remove_effect(object me, int amount, int amount1)
{
    if( me )
	{
		if ( (int)me->query_temp("zuida") ) 
		{
			me->add_temp("apply/attack",  -amount);
			me->add_temp("apply/dodge", -amount1);
			me->delete_temp("zuida");
			tell_object(me, HIY "你的八仙醉打运功完毕，将内力收回丹田。\n" NOR);
		}
    }
    
}
int clean_up()
{
    return 1;
}
void reset()
{
}

