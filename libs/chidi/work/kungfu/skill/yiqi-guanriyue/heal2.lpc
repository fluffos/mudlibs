// heal.c

#include <ansi.h>

int exert(object me, object target) {
  int skill;
  skill = me->query_skill("yiqi-guanriyue", 1);
  if (me->is_fighting())
    return notify_fail("战斗中运功疗伤？找死吗？\n");

  if ((int)me->query_skill("force", 1) < 150)
    return notify_fail("你的内功修为还不够。\n");
  if ((int)me->query("neili") < 500)  // - (int)me->query("max_neili") < 1000 )
    return notify_fail("你的真气不够。\n");

  write(HIY "你全身放松，坐下来开始运功疗伤。\n" NOR);
  message("vision",
    HIW + me->name() + "吐出一口瘀血，脸色看起来好多了。\n" NOR,
    environment(me), me);
  me->improve_skill("yiqi-guanriyue", random((int)me->query_int()) / 10);
  me->receive_curing("qi", 10 + (int)me->query_skill("force") / 3);
  me->add("neili", -50);
  me->set("jiali", 0);
  if (me->query("special_skill/gongfusoul") == 1) {
    me->start_busy(random(1)); ;
  } else {
    me->start_busy(random(2));
  }
  return 1;
}
