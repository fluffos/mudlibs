// fuxue.c 拈花指 「拈花拂穴」
#include <ansi.h>
inherit F_SSERVER;
int exert(object me, object target)
{
    int busy_time;
    if ( !wizardp(me)) return notify_fail("现在这个技能只有巫师才能使用！\n");      
    if( !target ) return notify_fail("你想点谁的穴位？\n");
    if( !target->is_character() || target->is_corpse() )
        return notify_fail("看清楚一点，那并不是活物。\n");
    if ((int)me->query_skill("king-of-dragon",1)< 1000000)
          return notify_fail("你的【君临天下】等级不够！\n");    
    if((int)me->query("neili") < 30000)
        return notify_fail("你的内力不够, 不能使用【天子擒拿手】! \n");
    if( target->is_busy() )
        return notify_fail(target->name() + "目前正自顾不暇，放胆攻击吧，yeah!\n");
    if( target->query_condition("dianxue_busy"))
        return notify_fail(target->name() + "已经中了【天子擒拿手】，放心进攻吧，yeah!\n");

    message("vision", CYN "你觉得隐隐之中有只无形的爪子把你的命脉给抓住了，顿时动弹不得！\n\n" NOR, environment(me), ({me}) );
    tell_object(me, "你使出【天子擒拿手】这个天下绝技，默运真气，五指间射出五道真气直射"+target->name()+"的五大命脉！\n\n" NOR);   
        tell_object(target, HIR "你突然间觉得有股无形的真气向你罩来，顿时给按倒在地，无法动弹！\n" NOR);
        message("vision", CYN "只见"+target->name()+"突然间给【天子擒拿手】的一股无形真气罩住，顿时给按倒在地，无法动弹！\n\n" NOR, environment(me), ({target}) );
        busy_time=random((int)me->query_skill("king-of-dragon",1))+1;
        target->start_busy(busy_time);
        target->apply_condition("dianxue_busy",busy_time/60);
        me->add("neili", -1000);
 
    me->set_temp("perform_time",time());
    return 1;
}

