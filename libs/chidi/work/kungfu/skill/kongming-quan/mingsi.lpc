// ming.c 「冥思决」
// By Dream 19:32 01-12-19
#include <ansi.h>
inherit F_SSERVER;
int perform(object me, object target)
{
        int damage;
    string msg;
    int skill, jing_cost;
    skill = me->query_skill("kongming-quan",1);
    if (me->query_int()<50)
        jing_cost = (int)me->query_int() - 50;
    else    jing_cost=1;
    if( me->is_fighting() )
        return notify_fail("「冥思决」不能在战斗中演练。\n");

if (me->query("special_skill/gongfusoul") == 1 )
 {
       if(time()-me->query_temp("gongfu_end")<1) return notify_fail("你刚练过功，会走火入魔的！\n");
        }
        else
       {
      if(time()-me->query_temp("gongfu_end")<2) return notify_fail("你刚练过功，会走火入魔的！\n");
        }  

    if( !skill || (skill < 200))
        return notify_fail("你的空明拳等级不够, 不能演练「冥思决」！\n");
    if( me->query("neili") < 50 )
        return notify_fail("你的内力不够，没有内力演练「冥思决」！\n");
    if (me->query_skill("unarmed",1)<= skill)
        return notify_fail("你的基本拳脚不够，无法通过演练「冥思决」提高空明拳的技巧！\n");
    if( me->query("jing") < -jing_cost )
        return notify_fail("你现在太累了，无法集中精神演练「冥思决」！\n");
    write (WHT "你盘腿坐下，将自己所学的空明拳冥想了一遍。\n" + NOR);
    me->add("neili", -50);
    me->add("jing", jing_cost);
   me->improve_skill("kongming-quan",random((int)me->query_int())*4);
 me->set_temp("gongfu_end",time());
        if (me->query("special_skill/gongfusoul") == 1 )
 {
       me->start_busy(random(1));
        }
        else
       {
        me->start_busy(random(2));
        }  

    return 1;
}

