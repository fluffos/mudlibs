// ming.c 「冥思决」
// By Dream 19:32 01-12-19
#include <ansi.h>
inherit F_SSERVER;
int perform(object me, object target)
{
        int damage;
    string msg;
    int skill, jing_cost;
    skill = me->query_skill("jiuzhuan-12tian",1);
    if (me->query_int()<50)
        jing_cost = (int)me->query_int() - 50;
    else    jing_cost=1;
    if( me->is_fighting() )
        return notify_fail("「冥思决」不能在战斗中演练。\n");
     if (!me->query("zhuanshi/times") > 9)
              return notify_fail("你还没有到达十转，不能使用九转十二天冥思决！\n");
    if( !skill || (skill < 100))
       return notify_fail("你的阴阳九转十二重天等级不够, 不能演练「冥思决」！\n");
    if( me->query("neili") < 50000 )
        return notify_fail("你的内力不够，没有内力演练「冥思决」！\n");
    
    if (me->query_skill("sword",1)<= skill)
        return notify_fail("你的基本剑法不够，无法通过演练「冥思决」提高阴阳九转十二重天的技巧！\n");
    if (me->query_skill("dodge",1)<= skill)
        return notify_fail("你的基本轻功不够，无法通过演练「冥思决」提高阴阳九转十二重天的技巧！\n");
    if (me->query_skill("force",1)<= skill)
        return notify_fail("你的基本内功不够，无法通过演练「冥思决」提高阴阳九转十二重天的技巧！\n");
    if (me->query_skill("parry",1)<= skill)
        return notify_fail("你的基本招架不够，无法通过演练「冥思决」提高阴阳九转十二重天的技巧！\n");
    if (me->query_skill("blade",1)<= skill)
        return notify_fail("你的基本刀法不够，无法通过演练「冥思决」提高阴阳九转十二重天的技巧！\n");
    if (me->query_skill("unarmed",1)<= skill)
        return notify_fail("你的基本拳脚不够，无法通过演练「冥思决」提高阴阳九转十二重天的技巧！\n");
    
    if( me->query("jing") < -jing_cost )
        return notify_fail("你现在太累了，无法集中精神演练「冥思决」！\n");
    if(!me->query("jiuzhuan-12tian/mingsi"))
    {
    tell_object(me, MAG "你盘腿坐下，将自己所学的「阴阳九转十二重天」冥想了一遍。\n" + NOR);    
    me->add("neili", -5000);
    me->add("jing", jing_cost);
     if ( skill < 60)
        me->improve_skill("jiuzhuan-12tian", 10);
    else if (skill < 90)
        me->improve_skill("jiuzhuan-12tian", 10 + random((int)me->query_int() - 9));
    else if (skill < 140)
        me->improve_skill("jiuzhuan-12tian", 10 + random((int)me->query_int() * 2 - 9));
    else if (skill < 200)
        me->improve_skill("jiuzhuan-12tian", 10 + random((int)me->query_int() * 4 - 9));
    else
        me->improve_skill("jiuzhuan-12tian", 10 + random((int)me->query_int() * 8 - 9));

    tell_object(me, HIY"你的「阴阳九转十二重天」进步了！\n"NOR);
        if (random(10)>8)    
        me->start_busy(1);   
        return 1;
    }
    else
{
    tell_object(me, MAG "你盘腿坐下，用☆速成大法☆把「阴阳九转十二重天」冥想了一遍。\n" + NOR);   
    me->add("neili", -50);
    me->add("jing", jing_cost);
   if ( skill < 60)
        me->improve_skill("jiuzhuan-12tian", 10);
    else if (skill < 90)
        me->improve_skill("jiuzhuan-12tian", 10 + random((int)me->query_int() - 9));
    else if (skill < 140)
        me->improve_skill("jiuzhuan-12tian", 10 + random((int)me->query_int() * 2 - 9));
    else if (skill < 200)
        me->improve_skill("jiuzhuan-12tian", 10 + random((int)me->query_int() * 4 - 9));
    else
        me->improve_skill("jiuzhuan-12tian", 10 + random((int)me->query_int() * 8 - 9));

    tell_object(me, HIY"你的「阴阳九转十二重天」进步了！\n"NOR);
        if (random(10)<6)    
        me->start_busy(1);   
        return 1;
}
}
