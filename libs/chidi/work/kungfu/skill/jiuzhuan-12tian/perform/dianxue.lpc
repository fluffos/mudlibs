// fuxue.c  「九转点穴法」
#include <ansi.h>
inherit F_SSERVER;
int perform(object me, object target) {
  int busy_time;
  //if ( !wizardp(me)) return notify_fail("现在这个技能只有巫师才能使用！\n");
  if ((time() - me->query_temp("perform_time")) < 5)
    return notify_fail("你积蓄真气，准备再次使用九转点穴法。\n");
  if (!target) target = offensive_target(me);
  if (!target) return notify_fail("你想点谁的穴位？\n");
  if (!target->is_character() || target->is_corpse())
    return notify_fail("看清楚一点，那并不是活物。\n");
  if ((int)me->query_skill("jiuzhuan-12tian", 1) < 10000)
    return notify_fail("九转点穴法需要1万级的【阴阳九转12天】才能施展！\n");
  if ((int)me->query_str() < 2500)
    return notify_fail("你臂力不够,不能使用这一绝技!\n");
  if ((int)me->query("neili") < 30000)
    return notify_fail("你的内力不够, 不能使用九转点穴法! \n");
  if (target->is_busy())
    return notify_fail(target->name() + "目前正自顾不暇，放胆攻击吧，yeah!\n");
  if (target->query_condition("dianxue_busy"))
    return notify_fail(target->name() + "已经中了九转点穴法，放心进攻吧，yeah!\n");

  message("vision", CYN "你似乎听到一声似有似无的“嗤嗤”的声音！\n\n" NOR, environment(me), ({ me }));
  tell_object(me, "你使出九转点穴法绝招，暗运内力，指端射出一股劲气直点" + target->name() + "的要穴！\n\n" NOR);

  if (random(me->query("kar")) > (int)target->query("kar") * 2 / 3) {
    tell_object(target, HIR "你突然间觉得浑身上下不听使唤，动弹不得！\n" NOR);
    message(
      "vision",
      CYN "只见" + target->name() + "突然间神色大变，动弹不得！\n\n" NOR,
      environment(me),
      ({ target })
    );
    busy_time = random((int)me->query("kar") * 10) + 1;
    if (busy_time > 30) busy_time = 30;
    target->start_busy(busy_time);
    target->apply_condition("dianxue_busy", busy_time / 30);
    me->add("neili", -1000);
  } else {
    message(
      "vision",
      CYN + target->name() + "好象突然觉得有一股劲气向自己的要穴射了过来，不及细想闪了一闪。\n" NOR,
      environment(me),
      ({ target })
    );
    tell_object(target, HIB "你突然发现自己的要穴让人点了一下，幸好没点中正确位置，你急运护体神功将劲气反弹了回去。\n" NOR);
    tell_object(me, HIB "你的点穴法太差劲了，居然点偏方向，结果让对方将劲气反射回来.....惨！...自己的穴道给点中了。\n" NOR);
    message_vision(HIW "$n从劲气来向看到原来是$N在点自己的穴位，不禁大怒：敢暗算我，看招！\n" NOR, me, target);
    if (target->query("shen") < -100) target->kill_ob(me);
    else target->fight_ob(me);
    me->fight_ob(target);
    me->start_busy(20);
    me->apply_condition("dianxue_busy", 1);
  }
  me->set_temp("perform_time", time());
  return 1;
}
