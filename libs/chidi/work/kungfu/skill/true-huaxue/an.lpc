#include <ansi.h>
inherit F_SSERVER;
int perform(object me) {
  string msg;
  object weapon;
  int skill, jing_cost;
  //    mapping my_fam  = me->query("family");
  skill = me->query_skill("true-huaxue", 1);
  if (me->query_int() < 50)
    jing_cost = (int)me->query_int() - 50;
  else jing_cost = 1;
  if (me->is_fighting())
    return notify_fail("「暗影式」不能在战斗中演练。\n");

  if (me->query("special_skill/gongfusoul") == 1) {
    if (time() - me->query_temp("gongfu_end") < 1) return notify_fail("你刚练过功，会走火入魔的！\n");
  } else {
    if (time() - me->query_temp("gongfu_end") < 2) return notify_fail("你刚练过功，会走火入魔的！\n");
  }

  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "throwing")
    return notify_fail("你手上的兵器不对啊。\n");
  if (!skill || (skill < 60))
    return notify_fail("你的真*化血神针等级不够！\n");
  if (me->query("neili") < 50)
    return notify_fail("你的内力不够！\n");
  if (me->query_skill("throwing", 1) <= skill)
    return notify_fail("你的基本暗器不够！\n");
  write(HIW "你使出真*化血神针之「暗影式」，将手中" + weapon->name() + HIW "挥舞了几下，似乎更深进了一些。\n" + NOR);

  me->add("neili", -50);
  //    me->add("jing", jing_cost);
  me->improve_skill("true-huaxue", random((int)me->query_int()) * 4);
  me->set_temp("gongfu_end", time());
  if (me->query("special_skill/gongfusoul") == 1) {
    me->start_busy(random(1));
  } else {
    me->start_busy(random(2));
  }
  return 1;
}
