//by pipip
#include <ansi.h>
#include <skill.h>
#include <weapon.h>
#include <combat.h>
inherit F_SSERVER;

int perform(object me, object target) {
  object weapon, ob;
  string msg;
  int i;

  ob = me->select_opponent();

  if (!me->is_fighting())
    return notify_fail("玉箫剑法之「刺」字决只能在战斗时使用。\n");
  if ((string)me->query("family/family_name") != "桃花岛")
    return notify_fail("只有桃花弟子才能使用该PFM。\n");
  if (me->query_temp("perform") > time()) return notify_fail("你上一招未使完！\n");
  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "sword")
    if (!objectp(weapon = me->query_temp("secondary_weapon"))
      || (string)weapon->query("skill_type") != "sword")
      return notify_fail("你使用的武器不对。\n");
    else me->set_temp("secondly_weapon", 1);
  if ((int)me->query("neili") < 2000)
    return notify_fail("你的真气不够！\n");
  if ((int)me->query_skill("sword") < 1000 ||
    ((int)me->query_skill("yuxiao-jianfa", 1) < 800)
    || me->query_skill_mapped("sword") != "yuxiao-jianfa")
    return notify_fail("你的「玉箫剑法」还不够精纯，无法使用「刺」字决！\n");

  msg = HIC "$N" HIC "一声清啸，手按玉箫，脚踏八卦四方之位，奏出一曲「" HIW "碧海潮生按玉箫" HIC "」。\n\n手中" + weapon->name() + HIC "剑发琴音，闪动不止，剑影如夜幕般扑向$n" HIC "。\n" NOR;
  message_vision(msg, me, ob);
  me->clean_up_enemy();
  me->add("neili", -150);
  me->set_temp("perform", time() + 4);
  me->set_temp("perform_ci", 1);
  for (i = 0; i < 6; i++)
    if (me->is_fighting(ob) && ob->is_fighting(me) && ob->query("eff_qi") > 0) {
      me->set_temp("action_msg", HIB "箫声绵绵\n" NOR);
      if (!weapon->query("equipped")) break;
      COMBAT_D->do_attack(me, ob, weapon, 0);
    } else break;
  me->delete_temp("perform_ci");
  me->delete_temp("secondly_weapon");
  return 1;
}
