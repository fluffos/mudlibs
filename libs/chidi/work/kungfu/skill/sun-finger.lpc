string query_skill_name(int level) {
  int i;
  for (i = sizeof(action) - 1; i >= 0; i--)
    if (level >= action[i]["lvl"])
      return action[i]["skill_name"];
}

int practice_skill(object me) {
  return notify_fail("一阳指只能研究来提高。\n");

  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练一阳指必须空手。\n");
  if ((int)me->query("qi") < 30)
    return notify_fail("你的体力太低了。\n");
  if ((int)me->query("jingli") < 60)
    return notify_fail("你的精力太低了。\n");
  if ((int)me->query("neili") < 50)
    return notify_fail("你的内力不够练一阳指。\n");
  me->receive_damage("jingli", 30);
  me->add("neili", -10);
  return 1;
}

mapping query_action(object me, object weapon) {
  mapping a_action;
  int i, level;
  level = (int)me->query_skill("sun-finger", 1);
  for (i = sizeof(action); i > 0; i--) {
    if (level > action[i - 1]["lvl"]) {
      a_action = action[NewRandom(i, 20, level / 5)];
      break;
    }
  }

  a_action["dodge"] = 0 - level / 2;
  a_action["parry"] = 0 - level / 2;
  a_action["attack"] = level;
  a_action["damage"] = level;
  return a_action;
}

void do_interlink(object me, object victim) {
  int maxskill, skill, i, j;

  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return;

  if (me->query("neili") < 2000) return;

  if ((string)me->query_skill_mapped("force") != "kumu-shengong" ||
    (int)me->query_skill("kumu-shengong", 1) < 500 ||
    me->query("family/family_name") != "大理段家")
    return;

  if ((int)me->query_skill("kuihua-xinfa", 1) > 100) return;

  maxskill = me->query_skill("sun-finger", 1);

  if (maxskill < 500) return;

  if (maxskill > 5000) skill = 5000;
  else skill = maxskill;

  if (random(10) > 7 || (random(maxskill) > victim->query_skill("pixie-jian", 1) / 2)) {
    if (!random(2)) {
      message_vision(HIG + "\n$N身随意转，反手一指点向$n，$n身形一窒，胸中气血翻腾。\n" NOR, me, victim);
      victim->delete_temp("apply/shade_vision");
      victim->start_busy(5);
    }

    me->add("neili", -2000);
    me->set_temp("sun-finger", 1);
    for (i = 0; i < 4 + random(skill / 500); i++) {
      if (((int)victim->query_skill(
        "pixie-jian",
        1
      ) > 100 && (random(maxskill) > victim->query_skill("pixie-jian", 1) / 2)) ||
        random(10) > 8) {
        message_vision(HIM + "$N身形连转，趁$n不备斜跨一脚食指点向$n面门，在$n脸上留下一道血痕。\n\n" NOR, me, victim);
        victim->receive_damage("qi", random(maxskill / 10));
        victim->receive_wound("jing", random(maxskill / 40));
      } else {
        if ((me->is_fighting(victim) || victim->is_fighting(me))) {
          if (environment(me) == environment(victim)) {
            COMBAT_D->do_attack(me, victim, me->query_temp("weapon"), 0);
          }
        } else break;
      }
    }
    me->delete_temp("sun-finger");
    me->start_busy(3);
  }
}

mixed hit_ob(object me, object victim, int damage_bonus, int factor) {
  object weapon;
  weapon = victim->query_temp("weapon");

  if ((string)me->query_skill_mapped("force") != "kumu-shengong" ||
    (int)me->query_skill("kumu-shengong", 1) < 500 ||
    me->query("family/family_name") != "大理段家")
    return 100;

  if (damage_bonus < 100) return damage_bonus / 2;
  if ((int)me->query("neili") < 20000) return damage_bonus / 10;

  if ((random(damage_bonus) + random(me->query("neili"))) > victim->query("neili") ||
    ((int)victim->query_skill("pixie-jian", 1) > 100 && (random(me->query_skill("sun-finger", 1)) >
      victim->query_skill("pixie-jian", 1))) ||
    random(10) > 8) {
    victim->receive_wound("qi", damage_bonus / 2);
    message_vision(HIR "\n$n突然觉得胸口一痛，已然被$N一指点中，鲜血喷涌而出，不由大骇。\n" NOR, me, victim);
    victim->delete_temp("apply/shade_vision");
    victim->apply_condition("yyz_damage", random(me->query_skill("sun-finger", 1)) / 10
      +victim->query_condition("yyz_damage"));
    victim->set_temp("yyzenemy", me->query("id"));
  } else if (objectp(weapon) && random(10) > 7) {
    message_vision(HIY "$N只觉胸中内力激荡豪情万丈，随手一指点出，$n手中的" + weapon->name() +
      "当即寸寸碎裂！\n" NOR, me, victim);
    weapon->move(environment(me));
    weapon->set("name", "碎裂的" + weapon->query("name"));
    victim->reset_action();
    weapon->set("value", 0);
    weapon->set("weapon_prop", 0);
    weapon->set("long", "一把碎裂的武器，看来是被绝顶高手使用内力硬生生震碎的。\n");
  }

  me->add("neili", -(200 + random(300)));

  return 10;
}

string perform_action_file(string action) {
  return __DIR__ "sun-finger/" + action;
}

mapping *query_skilldbase() { return action; }
