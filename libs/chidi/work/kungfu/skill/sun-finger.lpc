int valid_enable(string usage) {
  return usage == "finger" || usage == "unarmed" || usage == "parry";
}
int valid_combine(string combo) {
  return combo == "qingyan-zhang" || combo == "jinyu-quan";
}
int practice_level() { return 100; }

int valid_learn(object me) {
  mapping skl;
  string *sname;
  int i;

  //if (me->query("gender") == "女性" && me->query_str() < 27)
  //if(me->query_skill("sun-finger", 1) > 501)
  //{
  //	return notify_fail("一阳指不能这样提高。\n");
  //}

  if (me->query_str() < 27)
    return notify_fail("你由于先天体质所限，无法修习一阳指。\n");
  if (me->query("family/family_name") != "大理段家")
    return notify_fail("一阳指乃大理段氏不传之秘，只有段家弟子才能修习。\n");
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练一阳指必须空手。\n");
  if ((string)me->query_skill_mapped("force") != "kumu-shengong" &&
    (int)me->query_skill("kumu-shengong", 1) < 80)
    return notify_fail("你的枯木神功火候不够，无法学一阳指。\n");
  if ((int)me->query("max_neili") < 500)
    return notify_fail("你的内力太弱，无法学一阳指。\n");
  if ((int)me->query_skill("finger", 1) < 80 && (int)me->query_skill("unarmed", 1) < 80)
    return notify_fail("你的基础不够，无法学一阳指。\n");
  if (me->query_skill(
    "finger",
    1
  ) <= me->query_skill(
    "sun-finger",
    1
  ) && me->query_skill("unarmed", 1) <= me->query_skill("sun-finger", 1))
    return notify_fail("你的基础不够，无法领会更高深的技巧。\n");

  skl = me->query_skills();
  sname = keys(skl);
  for (i = 0; i < sizeof(skl); i++) {
    if (sname[i] == "kumu-shengong" || sname[i] == "beiming-shengong" || sname[i] == "huagong-dafa" || sname[i] == "jiuzhuan-12tian") continue;
    if (SKILL_D(sname[i])->valid_enable("force")) {
      return notify_fail("一阳指劲全靠枯木神功才能发挥功效，你不散去别派内功，如何修习？！\n");
      //tell_object(me,"一阳指劲全靠枯木神功才能发挥功效，你不散去别派内功，如何修习？！\n");
      //return 0;
    }
  }
  return 1;
}

string query_parry_msg(object me, object weapon) {
  string msg;
  object *enemys, enemy;
  int skill;

  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return "";

  enemys = me->query_enemy();
  if (sizeof(enemys) > 0)
    enemy = enemys[0];
  else {
    if (objectp(weapon) && userp(environment(weapon))) {
      enemy = environment(weapon);
    } else {
      return "";
    }
  }

  skill = me->query_skill("sun-finger", 1);

  if (me->query("family/family_name") == "大理段家" && (string)me->query_skill_mapped("force") == "kumu-shengong") {
    if (userp(enemy) && (enemy->query_skill(
      "pixie-jian",
      1
    ) > 100 || enemy->query_skill("kuihua-xinfa", 1) > 100)) {
      me->set_temp("fight/parry", skill);
    } else {
      me->set_temp("fight/parry", skill / 5);
    }
  } else {
    me->set_temp("fight/parry", skill / 10);
  }
  if ((string)me->query_skill_mapped("dodge") == "duanshi-shenfa")
    me->add_temp("fight/parry", skill / 10);

  msg = parry_msg[0];

  return msg;
}

