// heal.c

#include <ansi.h>

int exert(object me, object target) {
  int skill;
  skill = me->query_skill("jiuzhuan-jiuyang", 1);
  if (me->is_fighting())
    return notify_fail("战斗中运功疗伤？找死吗？\n");
  if (me->query("special_skill/gongfusoul") == 1) {
    if (time() - me->query_temp("gongfu_end") < 1) return notify_fail("你刚练过功，会走火入魔的！\n");
  } else {
    if (time() - me->query_temp("gongfu_end") < 2) return notify_fail("你刚练过功，会走火入魔的！\n");
  }
  if ((int)me->query_skill("jiuzhuan-jiuyang", 1) > (int)me->query_skill("jiuyang-shengong", 1) / 2)
    return notify_fail("你的九阳神功不能支撑你的九转残篇。\n");
  if ((int)me->query_skill("force", 1) < 150)
    return notify_fail("你的内功修为还不够。\n");
  if ((int)me->query("neili") < 500)  // - (int)me->query("max_neili") < 1000 )
    return notify_fail("你的真气不够。\n");

  tell_object(target, HIW "你全身放松，坐下来开始运功疗伤！\n" NOR);

  me->improve_skill("jiuzhuan-jiuyang", random((int)me->query_int()) * 4);
  me->receive_curing("qi", 10 + (int)me->query_skill("force") / 3);
  me->add("neili", -50);
  me->set("jiali", 0);
  me->set_temp("gongfu_end", time());

  if (me->query("special_skill/gongfusoul") == 1) {
    me->start_busy(random(1));
  } else {
    me->start_busy(random(2));
  }


  return 1;
}

void del_suck(object me) {
  if (!me) return;
  if (me->query_temp("suck"))
    me->delete_temp("suck");
}
