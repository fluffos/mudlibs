// art.c 琴棋书画
// cck 3/7/97

inherit SKILL;

void create() { seteuid(getuid()); }

string type() { return "knowledge"; }

int valid_learn(object me)
{
        if ( me->query("int") < 25 && me->query_int() < 32)
        return notify_fail("琴棋书画乃是极其风雅之事，" +RANK_D->query_respect(me)+"似乎太过于俗气了些。\n");

      if( (int)me->query("shen") < -10 )
      return notify_fail("你杀人如麻，倘若不能先平息了心头魔念，哪里又会有心思下棋？\n");

        return 1;
}
 
int practice_skill(object me)
{
        return notify_fail("琴棋书画只能通过领悟和学习来提高。\n");
}

