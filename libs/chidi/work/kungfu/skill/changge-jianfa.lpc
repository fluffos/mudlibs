#include <ansi.h>
inherit SKILL;
string type() { return "zhongji"; }
int tydamage = this_player()->query("tydamage/sword") ? this_player()->query("tydamage/sword") : this_player()->query_skill("changge-jianfa");

mapping *action = ({
  ([ "action":
    "$N一声长叹，$w轻点一招" + MAG "「醉拍春衫惜旧香」" NOR + "向着$n的$l疾刺而去",

    "damage": 160,
    "damage": tydamage,
    "damage_type": "刺伤"
  ]),
  ([ "action":
    "$N紧缩眉头，心中似有很深的怨气$w一闪而隐，一招" + MAG "「天将离恨恼梳狂」" NOR + "刺向$n的$l",

    "damage": 200,
    "damage": tydamage,
    "damage_type": "刺伤"
  ]),
  ([ "action":
    "$N仰天不语，脸上掠过一丝忧愁，$w暂缓，一招" + MAG "「年年陌上生青草」" NOR +
    "遥遥刺向$n的$l",

    "damage": 260,
    "damage": tydamage,
    "damage_type": "刺伤"
  ]),
  ([ "action":
    "$N怔怔而望，若有所思,忽然变招，\n"
    "蓦然有骤风席卷，剑招凌烈撒向$n的$l,好一招" + RED "「日日楼中到夕阳」" NOR,


    "damage": 300,
    "damage": tydamage,
    "damage_type": "刺伤"
  ]),
  ([ "action":
    "$N衣袂飞舞，身形舒缓如舞，轻歌曼妙\n"
    "一招" + MAG "「云渺渺，水茫茫」" NOR + "，$w划向$n的$l",

    "damage": 360,
    "damage": tydamage,
    "damage_type": "割伤"
  ]),
  ([ "action":
    "$N微闭双目，一股落寞的神情布于脸上，剑意凝重,空气顿时压力大增\n"
    "一招" + MAG "「征人归路许多长」" NOR + "飞刺$n的$l",

    "damage": 400,
    "damage": tydamage,
    "damage_type": "刺伤"
  ]),
  ([ "action":
    "$N斜倚长剑，轻啸而歌却充满了枯涩的意味，$w自肋下翻刺而出\n"
    "一招" + MAG "「相思本是无凭语」" NOR + "刺向$n的$l",

    "damage": 450,
    "damage": tydamage,
    "damage_type": "刺伤"
  ]),
  ([ "action":
    "$N缓缓摇头，双目中似有泪光闪动$w辉映着苍白的光芒"
    "若隐若现的闪现而出,一招" + YEL "「莫向花笺费泪行」" NOR + "刺向$n的$l",

    "damage": 650,
    "damage": tydamage,
    "damage_type": "刺伤"
  ]),
});

int valid_learn(object me) {
  object ob;

  if ((int)me->query("max_neili") < 200)
    return notify_fail("你的内力不够，没有办法练落雁剑法。\n");

  if (!(ob = me->query_temp("weapon"))
    || (string)ob->query("skill_type") != "sword")
    return notify_fail("你必须先找一把剑才能练剑法。\n");

  return 1;
}

int valid_enable(string usage) {
  return usage == "sword" || usage == "parry";
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

int practice_skill(object me) {
  if ((int)me->query("qi") < 30
    || (int)me->query("neili") < 30)
    return notify_fail("你的内力或气不够，没有办法练习长歌剑法。\n");
  me->receive_damage("qi", 30);
  me->add("neili", -3);
  write("你按著所学练了一遍长歌剑法。\n");
  return 1;
}


mixed hit_ob(object me, object victim, int damage_bonus) {
  if (damage_bonus < 110) return 0;
  if (me->query("neili") < 50000) return 0;
  if (random(10) < 2) return 0;

  //  第六等级的伤气
  if (me->query_skill("changge-jianfa", 1) > 5000
    && me->query("jh_dj/dj") >= 25) {
    victim->receive_damage("qi", damage_bonus, me);
    return WHT "$N心如死灰，情至义尽，" BLINK "" HIB "「葬心曲」" + NOR + "" + WHT + "剑气如怒涛般涌向$n！\n" NOR;
  }

  //  第五等级的伤气
  if (me->query_skill("changge-jianfa", 1) > 4000
    && me->query("jh_dj/dj") >= 20) {
    victim->receive_damage("qi", (damage_bonus - 100) / 2, me);
    return MAG "$N心不由主，失魂落魄，" BLINK "" + CYN + "「惑心音」" + NOR + "" + MAG + "剑气如鬼魅般迷惑$n！\n" NOR;
  }
  if (damage_bonus < 100) return 0;

  //  第四等级的伤气
  if (me->query_skill("changge-jianfa", 1) > 3000
    && me->query("jh_dj/dj") >= 15) {
    victim->receive_damage("qi", (damage_bonus - 100) / 3, me);
    return RED "$N心力交悴，怅然若失，" BLINK "" HIR "「碎心声」" + NOR + "" + RED + "剑气如凄怆般席卷$n！\n" NOR;
  }

  //  第三等级的伤气
  if (me->query_skill("changge-jianfa", 1) > 2000
    && me->query("jh_dj/dj") >= 10) {
    victim->receive_damage("qi", (damage_bonus - 100) / 4, me);
    return HIY "$N心烦意乱，念念不忘，" BLINK "" + GRN + "「扣心弦」" + NOR + "" + HIY + "剑气如惋伤般紧扣$n！\n" NOR;
  }
  // 第二等级的伤气
  if (me->query_skill("changge-jianfa", 1) > 1000
    && me->query("jh_dj/dj") >= 2) {
    victim->receive_damage("qi", (damage_bonus - 100) / 5, me);
    return YEL "$N心如刀割，黯然神伤，" BLINK "" + RED + "「伤心律」" + NOR + "" + YEL + "剑气如乱麻般攻向$n！\n" NOR;
  }
}

void do_interlink(object me, object victim) {
  int skill, i, j;
  object *enemy, weapon = me->query_temp("weapon");
  string all_enemy;

  if (!weapon) return;
  if (me->query("neili") < 3000) return;
  skill = me->query_skill("changge-jianfa", 1);
  if (skill > 1800) skill = 1800;
  if (skill > 400 && me->query_skill("sword", 1) > 4000) {
    enemy = me->query_enemy();
    if (!sizeof(enemy)) return;
    if (sizeof(enemy) == 1 && enemy[i]->query("eff_qi") < 0 && enemy[i]->query("neili") < 1000) return;
    all_enemy = enemy[0]->name();
    for (i = 1; i < sizeof(enemy); i++)
      all_enemy += ("、" + enemy[i]->name());
    message_vision(MAG + "$N一声长叹，手中神兵轻轻一摆，无数剑影同时卷向" + all_enemy + "。\n\n" NOR, me);
    me->add("neili", -3000);
    me->set_temp("changge-jianfa", 1);
    for (i = 0; i < sizeof(enemy); i++) {
      for (j = 0; j < (skill / (60 * sizeof(enemy))); j++)
        if ((me->is_fighting(enemy[i]) || enemy[i]->is_fighting(me)) && enemy[i]->query("eff_qi") > 0) {
          if (environment(me) == environment(enemy[i])) {
            COMBAT_D->do_attack(me, enemy[i], me->query_temp("weapon"));
          }
        } else break;
    }
    me->start_busy(2);
    me->delete_temp("changge-jianfa");

  }
}

string perform_action_file(string action) {
  return __DIR__ "changge-jianfa/" + action;
}
int power_point() { return 1.25; }
