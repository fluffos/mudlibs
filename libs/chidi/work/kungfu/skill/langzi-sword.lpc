#include <combat.h>
inherit SKILL;
// string type() { return "zhongji"; }
int tydamage = this_player()->query("tydamage/sword") ? this_player()->query("tydamage/sword") : this_player()->query_skill("langzi-sword");

mapping *action = ({
  ([ "action": "$N将手中$w握紧，暴喝一声，不顾$n的凌厉攻击，刺向$n的$l",
    "force": 560,
    "dodge": 280,
    "parry": 240,
    "damage": tydamage,
    "lvl": 0,
    "damage_type": "刺伤"
  ]),
  ([ "action": "$N手中$w一抖将" HIR "$n" NOR "的攻势化去，紧跟着反身一剑刺向" HIR "$n" NOR "$l" NOR,
    "force": 560,
    "dodge": 280,
    "parry": 240,
    "damage": tydamage,
    "lvl": 140,
    "damage_type": "刺伤"
  ]),
  ([ "action": HIB "$n使出" BLINK HIY "最后杀着" NOR HIB "，怎知$N也使出了最后绝技手中$w" HIB "向$n$l对刺过去" NOR,
    "force": 560,
    "dodge": 280,
    "parry": 240,
    "damage": tydamage,
    "lvl": 1000,
    "damage_type": "刺伤",
  ]),
});
int valid_enable(string usage) { return usage == "sword"; }
int practice_level() { return 200; }
int valid_learn(object me) {
  if ((int)me->query("max_neili") < 20000)
    return notify_fail("你的内力不够。\n");
  if (me->query_skill("sword", 1) <= me->query_skill("langzi-sword", 1))
    return notify_fail("你的基础不够，无法领会更高深的技巧！\n");
  if (me->query_skill("langzi-sword") < 250 && me->query("family/master_id") != "yang xiaoxie")
    return notify_fail("浪子三剑是通吃帮杨小邪绝技，其他师傅参悟还来不及，怎能教你？\n");
  return 1;
}
string query_skill_name(int level) {
  int i;
  for (i = sizeof(action) - 1; i >= 0; i--)
    if (level >= action[i]["lvl"])
      return action[i]["skill_name"];
}
mapping query_action(object me, object weapon) {
  int i, level;
  level = (int)me->query_skill("langzi-sword", 1);
  for (i = sizeof(action); i > 0; i--)
    if (level > action[i - 1]["lvl"])
      return action[NewRandom(i, 20, level / 5)];
}

int practice_skill(object me) {
  object ob;
  if ((int)me->query("qi") < 30
    || (int)me->query("neili") < 35)
    return notify_fail("你的内力或气不够，没有办法练习浪子三招。\n");
  if (!objectp(ob = me->query_temp("weapon"))
    || (string)ob->query("skill_type") != "sword")
    if (!objectp(ob = me->query_temp("secondary_weapon"))
      || (string)ob->query("skill_type") != "sword")
      return notify_fail("你装备的武器不对。\n");
  me->receive_damage("qi", 30);
  me->add("force", -20);
  me->add_temp("pratice_sword", 1);
  if (me->query_temp("pratice_sword") > me->query_skill("langzi-sword", 1) / 20) {
    if ((int)ob->query_amount() == 1) {
      ob->unequip();
      tell_object(me, BOLD "\n你的" + ob->query("name") + "用完了！\n\n" + NOR);
    }
    ob->add_amount(-1);
    me->delete_temp("pratice_sword");
  }
  write("你按著所学练了一遍浪子三招。\n");
  return 1;
}

mixed hit_ob(object me, object victim, int damage_bonus) {
  if (damage_bonus < 110) return 0;
  if (me->query("neili") < 50000) return 0;
  if (random(10) < 2) return 0;

  //  第六等级的伤气
  if (me->query_skill("langzi-sword", 1) > 5000
    && me->query("jh_dj/dj") >= 25
    && me->query_skill("damo-force", 1) > 500
  ) {
    victim->receive_damage("qi", (damage_bonus - 100) * 2, me);
    return HIR "$N手中" HIC " 利刃 " NOR HIR "发出" BLINK HIW "六道剑芒" NOR HIR "摧毁了$n的" BLINK HIR " 真元 " NOR HIR "！\n" NOR;
  }
  //  第五等级的伤气
  if (me->query_skill("langzi-sword", 1) > 4000
    && me->query("jh_dj/dj") >= 20
    && me->query_skill("damo-force", 1) > 500
  ) {
    victim->receive_damage("qi", (damage_bonus - 100), me);
    return HIR "$N手中" HIC " 利刃 " NOR HIR "发出" BLINK HIW " 五道剑芒 " NOR HIR "摧毁了$n的" BLINK HIR " 真元 " NOR HIR "！\n" NOR;
  }
  //  第四等级的伤气
  if (me->query_skill("langzi-sword", 1) > 3000
    && me->query("jh_dj/dj") >= 15
    && me->query_skill("damo-force", 1) > 500
  ) {
    victim->receive_damage("qi", (damage_bonus - 100) / 2, me);
    return HIR "$N手中" HIC " 利刃 " NOR HIR "发出" BLINK HIW " 四道剑芒 " NOR HIR "摧毁了$n的" BLINK HIR " 真元 " NOR HIR "！\n" NOR;
  }

  //  第三等级的伤气
  if (me->query_skill("langzi-sword", 1) > 2000
    && me->query("jh_dj/dj") >= 10
    && me->query_skill("damo-force", 1) > 500
  ) {
    victim->receive_damage("qi", (damage_bonus - 100) / 3, me);
    return HIR "$N手中" HIC " 利刃 " NOR HIR "发出" BLINK HIW " 三道剑芒 " NOR HIR "摧毁了$n的" BLINK HIR " 真元 " NOR HIR "！\n" NOR;
  }
  // 第二等级的伤气
  if (me->query_skill("langzi-sword", 1) > 400
    && me->query_skill("damo-force", 1) > 300
    && me->query_skill("langzi-sword", 1) < 2001
  ) {
    victim->receive_damage("qi", (damage_bonus - 100) / 4, me);
    return HIB "$N手中" HIW "剑气" NOR HIR "发出一阵阵" BLINK HIW " 剑气 " NOR HIR "摧毁了$n的" BLINK HIR " 真元 " NOR HIR "！\n" NOR;
  }


}


void do_interlink(object me, object victim) {
  int skill, i, j, k, damo;
  object *enemy, weapon = me->query_temp("weapon");
  string all_enemy;

  if (!weapon) return;
  if (me->query("neili") < 2000) return;
  if (skill > 1800) skill = 1800;
  skill = me->query_skill("langzi-sword", 1);
  k = me->query("kar", 1);
  damo = me->query_skill("damo-force", 1);
  if (random(damo) > 700 && random(k) > 30 && random(skill) > 700) {
    enemy = me->query_enemy();
    if (!sizeof(enemy)) return;
    if (sizeof(enemy) == 1 && enemy[i]->query("eff_qi") < 0) return;
    all_enemy = enemy[0]->name();
    for (i = 1; i < sizeof(enemy); i++)
      all_enemy += ("、" + enemy[i]->name());
    message_vision(
      MAG + "$N心中静如水，手中" + weapon->query("unit") + weapon->name() + MAG "一挥，意一动而招立生生生不息，永不终止,无涯无境," + all_enemy + "被$N攻的破绽百出。\n\n" NOR,
      me
    );
    me->add_query("neili", -100);
    me->set_temp("langzi-sword", 1);
    if (skill > 1000) skill = 1000;
    for (i = 0; i < sizeof(enemy); i++) {
      for (j = 0; j < (skill / (60 * sizeof(enemy))); j++)
        if ((me->is_fighting(enemy[i]) || enemy[i]->is_fighting(me)) && enemy[i]->query("eff_qi") > 0) {
          if (environment(me) == environment(enemy[i])) {
            COMBAT_D->do_attack(me, enemy[i], me->query_temp("weapon"), TYPE_QUICK);
          }
        } else break;
    }
    me->delete_temp("langzi-sword");
  }
}

string perform_action_file(string action) { return __DIR__ "langzi-sword/" + action; }
