string *usage_skills = ({ "sword", "blade","unarmed",
                            
                          "dodge", "parry", "force" });

int valid_enable(string usage)
{
        return (member_array(usage, usage_skills) != -1);
}

int valid_combo(string combo)
{
        return combo == "jiuzhuan-12tian";
}

int valid_force(string force) { return 1; }

int double_attack() { return 1; }
mapping query_action(object me, object weapon)
{
        switch (weapon ? weapon->query("skill_type") : "default")
        {
        case "whip":
                return action_whip[random(sizeof(action_whip))];
        default:
                return action_default[random(sizeof(action_default))];
        }
}

string query_dodge_msg(string limb)
{
        return dodge_msg[random(sizeof(dodge_msg))];
}

int valid_learn(object me)
{
               if ((int)me->query_skill("jiuzhuan-jiuyin",1) < 10000)
              return notify_fail("你的九阴残篇还没学到一万级，理解不了。\n"); 
      if ((int)me->query_skill("jiuzhuan-liuyin",1) < 10000)
              return notify_fail("你的六阴残篇还没学到一万级，理解不了。\n");    
         if ((int)me->query_skill("jiuzhuan-jiuyang",1) < 10000)
              return notify_fail("你的九阳残篇还没学到一万级，理解不了。\n");  
 if ((int)me->query_skill("beiming-shengong",1) < 10000)
              return notify_fail("你的北冥神功还没学到一万级，理解不了。\n"); 
 if ((int)me->query_skill("huagong-dafa",1) < 10000)
              return notify_fail("你的化功大法还没学到一万级，理解不了。\n"); 
 if ((int)me->query_skill("taiji-shengong",1) < 10000)
              return notify_fail("你的太极神功还没学到一万级，理解不了。\n"); 
 if ((int)me->query_skill("jiuyang-shengong",1) < 10000)
              return notify_fail("你的九阳神功还没学到一万级，理解不了。\n"); 
 if ((int)me->query_skill("mingyu-shengong",1) < 10000)
              return notify_fail("你的冥雨神功还没学到一万级，理解不了。\n"); 
 if ((int)me->query_skill("kuihua-xinfa",1) < 10000)
              return notify_fail("你的葵花心法还没学到一万级，理解不了。\n"); 
        if ((int)me->query_skill("jiuzhuan-12tian",1) > 400)
              return notify_fail("[阴阳九转十二重天]我只能教你这么多，以后就要靠你自己练习了。\n");       
       
        return 1;
}

int practice_skill(object me)
{
        return notify_fail("阴阳九转十二重天博大精深，无法简单的通过练习进步，只能通过冥思诀来进行练习。\n");
}

int difficult_level()
{
        return 500;
}
int is_special() 
{ 
        return 1; 
}

string perform_action_file(string action)
{
        return __DIR__"jiuzhuan-12tian/perform/" + action;
}

string exert_function_file(string action)
{
        return __DIR__"jiuzhuan-12tian/exert/" + action;
}



mixed ob_hit(object me, object victim, int damage)
{
        int ap, dp, i, level;
        object weapon = me->query_temp("weapon");
        mapping prepare;
        string attack_skill, result;

        if ( (level = victim->query_skill("jiuzhuan-12tian", 1)) < 100 || !living(victim) )
                return damage;

        dp = COMBAT_D->skill_power(victim, "dodge", SKILL_USAGE_DEFENSE);
        if( victim->query_skill_mapped("parry") == "jiuzhuan-12tian" )
                dp += COMBAT_D->skill_power(victim, "parry", SKILL_USAGE_DEFENSE);

        ap = COMBAT_D->skill_power(me, "dodge", SKILL_USAGE_DEFENSE);
        prepare = me->query_skill_prepare();
        if( !prepare ) prepare = ([]);

        if( objectp(weapon) ) attack_skill = weapon->query("skill_type");
        else switch( sizeof(prepare) )
        {
                case 0: attack_skill = "unarmed"; break;
                case 1: attack_skill = (keys(prepare))[0]; break;
                case 2: attack_skill = (keys(prepare))[me->query_temp("action_flag")]; break;
        }

        ap += COMBAT_D->skill_power(me, attack_skill, SKILL_USAGE_ATTACK);

        ap /= 100;
        dp /= 200;

        if ( random(ap+dp) > ap ) {
                result = GRN "$n突然举剑一刺，剑招随便无章，却莫明奇妙地突破了$N的攻势，大出$N意料！\n";
                result += "$n一转剑势，剑招源源而出，对$N发动攻势！\n" NOR;
                victim->add("neili", -30);
                victim->add("jingli", -30);
                me->start_busy( level/50 );
                damage = 0;

                return ([ "result" : result, "damage" : damage ]);
        }
        else if ( random(ap+dp) > ap ) {
                result = GRN "$n举剑反攻，后发先至地刺向$N，不仅把$N招术封死，更进一步发出攻击！\n" NOR;
                victim->add("neili", -20);
                victim->add("jingli", -20);
                me->start_busy( level/100 );
                damage = 0;

                return ([ "result" : result, "damage" : damage ]);
        }
        else if ( random(ap+2*dp) > ap ) {
                result = GRN "$n提剑回刺，落点正是$N的破绽，$N不得不撤招严守，身形一晃间已退出丈许！\n" NOR;
                victim->add("jingli", -20);
                damage = 0;

                return ([ "result" : result, "damage" : damage ]);
        }
        else if ( random(ap+3*dp) > ap ) {
                result = GRN "$n眼见避无可避，只好提剑乱刺一通，居然出乎意料地将$N的攻击接去大半。\n" NOR;
                victim->add("jingli", -10);
                damage /= 5;

                return ([ "result" : result, "damage" : damage ]);
        }
        else
                return damage;
}

mixed hit_ob(object me, object victim, int damage_bonus)
{
    if( damage_bonus < 100 ) return 0;
if (me->query("special_skill/jiuyinbody") == 1 && me->query("special_skill/jiuyangbody") == 1 && me->query("special_skill/yinyangbody") == 1 && (me->query("neili")<me->query("max_neili")*7/4))
     {
    me->add("neili",random((int)me->query("jiali"))*7);
victim->receive_wound("qi", (damage_bonus )*3);
victim->receive_wound("jing", (damage_bonus )*3);
   me->add("neili",random((int)me->query("jiali"))*7);
write(HIR "你综合毕生所学，发挥出九转十二天的暗劲，震毁了对手的丹田。！\n" + NOR);
     }

        if (me->query_skill("jiuzhuan-12tian",1)>100)
     if( random(me->query("neili"))*5 > random(victim->query("neili"))) {
                        victim->receive_wound("qi", (damage_bonus )*2,me);
                        victim->receive_wound("jing", (damage_bonus )*2,me);                       
                        return HIR "$N的"HIB"[阴阳九转十二重天]"HIR"摧毁了$n的真元和内力！\n" NOR;
        }
}
