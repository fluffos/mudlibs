// kuihua-xinfa.c 葵花心法
inherit FORCE;
int valid_enable(string usage) { return usage == "force"; }
// string type() { return "zhongji"; }
int valid_learn(object me) {
  mapping skl;
  string *sname;
  int i;
  int lvl = (int)me->query_skill("kuihua-xinfa", 1);
  //int t = 1, j;
  // for (j = 1; j < i / 10; j++) t*= 2;

  if ((string)me->query("gender") == "女性")
    return notify_fail("自古没有女人可以学葵花心法的。\n");

  if ((string)me->query("gender") == "男性")
    return notify_fail("葵花心法第一要诀：欲练神功，必先自宫。\n");

  if ((int)me->query_skill("force", 1) < 10)
    return notify_fail("你的基本内功火候不足，不能学葵花心法。\n");

  if (me->query_skill("force", 1) <= lvl)
    return notify_fail("你的基本内功基础不够，再学下去会走火入魔的。\n");

  if ((int)me->query_skill("kuihua-xinfa", 1) > 301)
    return notify_fail("葵花心法我就教到这儿，以后就要靠你自己练了。\n");

  if (me->query_skill("buddhism", 1))
    return notify_fail("你练了秃驴们的心法，还学葵花心法做什麽！\n");

  skl = me->query_skills();
  sname = keys(skl);
  for (i = 0; i < sizeof(skl); i++) {
    if (sname[i] == "kuihua-xinfa") continue;
    if (this_player()->query("zhuanshi/times")) continue;
    if (SKILL_D(sname[i])->valid_enable("force"))
      return notify_fail("你不先散了别派内功，怎能学葵花心法？！\n");
  }
  return 1;
}

mixed hit_ob(object me, object victim, int damage_bonus) {
  int kk;
  int maxlv;
  maxlv = (me->query("kuihualv") + 2) * (me->query("kuihualv") + 1) * (me->query("kuihualv") + 1);
  if (maxlv > 150) { maxlv = 150; }
  if (damage_bonus < 100) return 0;
  if (me->query("special_skill/yinyangbody") == 1 && (me->query("neili") < me->query

    ("max_neili") * 5 / 4)) {
    me->add("neili", random((int)me->query("jiali")) * 5);
    victim->receive_wound("qi", (damage_bonus));
    victim->receive_wound("jing", (damage_bonus));
    me->add("neili", random((int)me->query("jiali")) * 5);
    write(HIR "你默运葵花心法，以一股无比阴毒的内劲湮灭了对手的丹田。！\n" + NOR);

  }
  if (random(3 * (me->query_con())) > victim->query_con() && random(4 * (me->query_skill(
    "mingyu-shengong",
    1
  ))) > (damage_bonus)) {
    if (me->query("kuihualv")) {
      victim->receive_wound("qi", (damage_bonus) * (15 + me->query("kuihualv")) / 15);
      victim->receive_wound("jing", (damage_bonus) * (10 + me->query("kuihualv")) / 15);
      victim->add("neili", -(int)me->query("jiali") * me->query("kuihualv"));
      if (victim->query("neili") < 1) victim->set("neili", 1);
      { kk = victim->query("kar"); }
      if (kk < 15) kk = 15;
      if ((random(me->query("kar")) > random(kk) + 20) && (me->query("neili") < me->query("max_neili") * 5 / 4)) {
        me->add("neili", random((int)me->query("jiali")) * me->query("kuihualv"));
        //        if (me->query("neili")>me->query("max_neili")*5/4)
        //     me->set("neili",me->query("max_neili")*5/4);
      }
      if (me->query_skill(
        "mingyu-shengong",
        1
      ) > (me->query(
        "kuihualv",
        1
      ) * 1000 + 898) && me->query_skill(
        "mingyu-shengong",
        1
      ) < (me->query("kuihualv", 1) * 1000 + 1002)) {
        me->improve_skill(
          "mingyu-shengong",
          ((damage_bonus) + me->query_skill(
            "mingyu-shengong",
            1
          ) + me->query_skill("mingyu-gong", 1)) * maxlv
        );
      }
      return HIW "$N面色一白，葵花心法第" + chinese_number(me->query("kuihualv")) + "重威力随之而出，湮灭了$n的丹田！！！！\n" NOR;
    } else {
      victim->receive_wound("qi", (damage_bonus) * 2 / 3);
      victim->receive_wound("jing", (damage_bonus) * 2 / 3);
      victim->add("neili", -(int)me->query("jiali"));
      me->improve_skill(
        "mingyu-shengong",
        ((damage_bonus) + me->query_skill(
          "mingyu-shengong",
          1
        ) + me->query_skill("mingyu-gong", 1)) * 2
      );
      return HIW "$N面色一白，使出葵花心法的暗劲，湮灭了$n的丹田！！！！\n" NOR;
    }
  }
}

int practice_skill(object me) {
  return notify_fail("葵花心法只能用学(learn)的来增加熟练度。\n");
}
string exert_function_file(string func) {
  return __DIR__ "kuihua-xinfa/" + func;
}

void skill_improved(object me) {
  switch (me->query_skill("kuihua-xinfa", 1)) {
    case 1001:
      {

        tell_object(me, HIW "由于你勤奋研习，你的葵花心法已经突破〖第一重〗境界！！\n\n" NOR);
        me->set("kuihualv", 1);
        break;
      }
    case 2001:
      {

        tell_object(me, HIW "由于你勤奋研习，你的葵花心法已经突破〖第二重〗境界！！\n\n" NOR);
