#include <ansi.h>

inherit F_CLEAN_UP;

string name() { return HIC "朱蛤奇缘" NOR; }

int perform(object me, string skill) {

  message_vision(HIC "$N" HIC "暗运真气于全身七经八脉"
    "将自身的毒素逼出体外,登时全身舒畅无比。\n" NOR, me);
  tell_object(me, HIG "你感觉到万毒至尊的莽牯朱蛤的神奇功用。\n" NOR);

  me->clear_condition();
  return 1;
}
