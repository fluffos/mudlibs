#include <ansi.h>
#include <condition.h>
inherit F_CLEAN_UP;
int update_condition(object me, int duration) {
  int damage;
  if (duration < 1) return 0;

  if (!living(me)) {
    message("vision", me->name() + "凄惨地哼了一声。\n", environment(me), me);
  } else {
    tell_object(me, HIB "忽然一股寒流夹着一阵灼热涌上心来，你中的生死符发作了！\n" NOR);
    message("vision", me->name() + "突然倒在地上，双手在身上一阵乱抓。\n", environment(me), me);
  }

  damage = duration * 100000;
  if (duration > 5)
    damage = damage * 2;
  if (duration > 10)
    damage = damage * 2;
  if (duration > 17)
    damage = damage * 2;
  if (duration > 20)
    damage = damage * 2;
  if (duration > 40)
    damage = damage * (duration / 10);
  if (duration > 80)
    damage = me->query("max_qi") / 4;

  me->receive_wound("qi", damage);
  me->receive_wound("jing", damage / 5);
  me->apply_condition("ss_poison", duration - 1);
  me->set_temp("die_for", "中生死符毒");
  me->delete_temp("last_damage_from");
  if (duration < 1) return 0;
  return CND_CONTINUE;
}
