#include <ansi.h>
#include <condition.h>
inherit F_CLEAN_UP;
int update_condition(object me, int duration)
{
    if( duration < 1 ) return 0;

    if( duration % 5 == 0 )
    if( !living(me) ) {
        message("vision", me->name() + "痛苦地哼了一声。\n", environment(me));
    }else {
     tell_object(me, HIG"你中的蛇毒发作了！\n" NOR );
        message("vision",MAG+me->query("name")+"的身子突然不住地痉挛，痛苦得蜷缩了起来。\n\n",environment(me));
    }
    me->receive_wound("qi",15 + random(10));
    me->receive_wound("jing", 10);
    me->apply_condition("snake_poison", duration - 1);
    me->set_temp("die_for","中蛇毒");
    me->delete_temp("last_damage_from");
    if( duration < 1 ) return 0;
    return CND_CONTINUE;
}

