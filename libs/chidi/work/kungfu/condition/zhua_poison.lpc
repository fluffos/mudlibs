#include <ansi.h>
#include <condition.h>
inherit F_CLEAN_UP;
int update_condition(object me, int duration) {
  if (duration < 1) return 0;
  if (!living(me)) {
    message("vision", me->name() + "痛苦地呻吟着.\n", environment(me), me);
  } else {
    tell_object(me, HIB "你无意中低头一看，手上血管暴起，颜色紫里透黑，原来你中的凝血神抓发作了！\n" NOR);
    message("vision", me->name() + HIR "的脚步一阵踉跄,脸色突然变得煞白。\n" + me->name() + "忽然一阵头晕目眩,浑身上下说不出的难受。\n" NOR,
      environment(me), me);
  }
  me->receive_wound("qi", 25 + random(20));
  me->receive_wound("jing", 25);
  me->apply_condition("zhua_poison", duration - 1);
  me->start_busy(random(3));
  me->set_temp("die_for", "中凝血神抓毒");
  me->delete_temp("last_damage_from");
  if (duration < 1) return 0;
  return CND_CONTINUE;
}
