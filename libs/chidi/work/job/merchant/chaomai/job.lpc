// 商人任务之炒卖货物
// Create by zeus@刀剑笑 Nov.20.1999
// 增加炒卖货物的方法
// 在places和goods里同时增加你要增加的货物数据
// places中的name为货物的名字，与goods中的name要一样。
// places中的place为货物特产地的房间的短描述
// goods中的price为这个货物的一般价钱
// 需要注意的是places和goods中的货物必须在同一位置

#include <ansi.h>
mapping *places = ({
  "泉州货物集散地",
  "新疆货物集散地",
  "蜈蚣镇货物集散地",
  "大理货物集散地",
  "少林货物集散地",
  "扬州货物集散地",
});

mapping *goods = ({
  ([
    "name": "荔枝",
    "price": 1000
  ]),
  ([
    "name": "葡萄",
    "price": 700
  ]),
  ([
    "name": "熊掌",
    "price": 5000
  ]),
  ([
    "name": "牛油",
    "price": 2000
  ]),
  ([
    "name": "兵器",
    "price": 15000
  ]),
  ([
    "name": "妓女",
    "price": 50000
  ]),
});

string ask_job(object npc, object ob) {
  mapping job_sets;
  object given;

  if (ob->query("combat_exp") < 100000)
    return ("这位" + RANK_D->query_respect(ob) + "，你的经验这么低，我怎么敢把这么大数目的钱款交给你？\n");

  if (ob->query_temp("merchant/chaomai/given"))
    return ("这次炒卖了几次？\n");

  job_sets = goods[random(sizeof(goods))];

  given = new(__DIR__ "npc/obj/check");
  given->move(ob);
  message_vision(
    npc->query("name") + "阴阴的笑着说：“最近" + HIW + job_sets["name"] + NOR + "的生意挺好做，我的库存没有了，你帮我去进点货。",
    npc
  );
  message_vision("\n我给你一百两金子，你去尽量帮我买多点回来。买得多，赚得多。记得30分钟后可要拿回来哦。\n", ob);
  ob->set_temp("merchant/chaomai", job_sets);
  ob->set_temp("merchant/chaomai/given", 1);
  ob->set_temp("merchant/chaomai/now_money", 1000);
  ob->set_temp("merchant/chaomai/base_money", 1000);
  ob->set_temp("merchant/chaomai/starttime", time());
  ob->set_temp("job/fulltime", 1);
  ob->apply_condition("job_chaomai", 200);
  return "\n";
}

string give_gifts(object ob) {
  int win_money;

  win_money = ob->query_temp("merchant/chaomai/now_money") - ob->query_temp("merchant/chaomai/base_money") / 1000000;

  ob->add("money", win_money);
  ob->delete_temp("merchant/chaomai");
  ob->delete_temp("job");

  ob->clear_condition("job_chaomai");
  CHANNEL_D->do_channel(
    this_object(),
    "rumor",
    sprintf(HIG + ob->name() + NOR "帮胡子成功炒卖了一次货物得到了：" + MONEY_D->money_str(win_money) + "数目金钱，钱已存入银行\n")
  );
  return HIC "你帮风儿成功炒卖了一次货物，得到了：" + MONEY_D->money_str(win_money) + "数目金钱，风儿已经把钱存入你的银行了。\n" NOR;
}

int set_price(object me) {
  object env = environment(me);
  int i, price;

  for (i = 0; i < sizeof(places); i++) {
    price = goods[i]["price"];
    if (env->query("short") == places[i])
      price /= 2;
    env->set("merchant_job/" + goods[i]["name"], random(price / 2) + price / 2);
  }

  env->set("no_set_price", 0);
  return 1;
}
