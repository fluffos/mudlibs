#include <ansi.h>;
inherit "/quest/wudang/npcskill_n";
#include <command.h>;
#include "name.h";


int other_qi = 0, other_jing = 0;
object me = this_object(), questob, killertemp;
string username;
string guaiobname, *guaikeysa, *guaikeysb, *guaiobid;
int s1, s2;
void die();
void create() {

  object guai;
  guai = this_object();
  guaikeysa = keys(guainame);
  s1 = random(sizeof(guaikeysa));
  if (s1 == 0 || s1 == sizeof(guaikeysa)) s1 = 0;
  guaikeysb = keys(guainame[guaikeysa[s1]]);
  s2 = random(sizeof(guaikeysb));
  if (s2 == 0 || s2 == sizeof(guaikeysa)) s2 = 0;
  guaiobname = guaikeysb[s2];
  guaiobid = guainame[guaikeysa[s1]][guaikeysb[s2]];
  set_name(guaiobname, guaiobid);

  set("gender", "男性");
  set("env/wimpy", 30);
  set("per", 10);
  set("age", 60);
  set("attitude", "friendly");
  set("no_suck", 1);
  set_temp("apply/armor", 600);
  set("chat_chance", 10);
  set("chat_msg", ({
    (: random_move :) }));
  set("chat_chance_combat", random(90));
  setup();

  carry_object("/d/city/obj/changjian")->wield();
  carry_object("/clone/misc/cloth")->wear();
}
int setguaiskill(int chooseguai, int level, object guai) {
  switch (chooseguai) {
    case 0: set_gumu_guai(level, guai); break;
    case 1: set_emei_guai(level, guai); break;
    case 2: set_quanzhen_guai(level, guai); break;
    case 3: set_wudang_guai(level, guai); break;
    case 4: set_shaolin_guai(level, guai); break;
    case 5: set_baituo_guai(level, guai); break;
    case 6: set_gaibang_guai(level, guai); break;
    case 7: set_huashan_guai(level, guai); break;
    case 8: set_xingxiu_guai(level, guai); break;
    case 9: set_mingjiao_guai(level, guai); break;
    case 10: set_shenlong_guai(level, guai); break;
    case 11: set_taohua_guai(level, guai); break;
    case 10: set_xiaoyao_guai(level, guai); break;
    case 11: set_xueshan_guai(level, guai); break;
    default: set_mz_guai(level, guai); break;
  }
}

