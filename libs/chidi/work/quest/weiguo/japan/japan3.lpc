#include <ansi.h>
inherit BHNPC;
string *nm1_jp =({
"山本","龟田","姿三","大岛","松下","横田","东芝","候本","川野","山口",
"铃木","岗仓","小岛","井上","安奈","浅田","佐藤","广末","大竹","大村",
"伯佐","富冈","东乡",
});

string *id_jp =({
"shanben","guitian","zisan","dadao","songxia","hengtian","dongzhi","houben","chuangye","shankou",
"lingmu","gangcang","xiaodao","jinshang","annai","qiantian","zuoteng","guangmu","dazhu","dachun",
"bozuo","fugang","dongxiang",
});    
    
string *nm2_jp =({
"太郎","次郎","三郎","四郎","五郎","十一郎","十四郎","二十六","俊树",
"宁次","英机","冶字","俊雄","牧夫","光夫","敬一","英世","漱石","渝吉",
"一叶","子规","稻造","伊冲","松园","深水","大观","丰国","孝和","茂",
"川","卫","岛寿","光云","安治","山乐","梦二",
});

void create()
{
    int i = random(sizeof(nm1_jp));
    set_name(nm1_jp[i]+nm2_jp[random(sizeof(nm2_jp))], ({id_jp[i]}));
    set("gender", "男性" );//性别与上面对应
    set("long",
         "一个身长不足四尺满脸又是伤疤加横肉的小日本。\n");
    set("attitude", "aggressive");
    set("vendetta/authority",1);
    set("nickname",HIC"东洋倭寇"NOR);
    set("jiali",100+random(20)); 
    set("max_qi",5000+random(2000));
    set("max_jing",3000+random(1000));
    set("max_jingli",2000+random(1000));
    set("max_neili",8000+random(2000));
    set("eff_qi",query("max_qi"));
    set("eff_jing",query("max_jing"));
    set("jingli",query("max_jingli"));
    set("qi",query("max_qi"));
    set("jing",query("max_jing"));
    set("neili",8000+random(2000));
    set("per", 12);
    set("age", 22+random(20));
    set("shen_type", -1);    

    set("combat_exp", 5000000+random(1000000));
    set("chat_chance_combat", 60);
    set("chat_msg_combat", ({
               (: perform_action, "blade.leitingpili" :),  //这个pfm有问题
               (: perform_action, "blade.kuang" :),  
    }) );

    set("chat_chance", 10);
    set("chat_msg", ({
                "东洋倭寇喝道：男人的,统统的杀啦,杀啦的！！\n",
                "东洋倭寇笑道：花姑娘的,留下,让皇军快活,快活的!\n",
                "东洋倭寇笑道：杀喼喼!统统的杀啦,杀啦的！！\n",
                (: random_move :),
    }) );       

    set_skill("unarmed", 300+random(100));
    set_skill("blade", 300+random(100));
    set_skill("parry", 300+random(100));
    set_skill("dodge", 300+random(100));
    set_skill("force", 300+random(100));
    set_skill("renshu", 300+random(100));
    set_skill("kongshoudao",300+random(100));
    set_skill("wind-blade", 300+random(100)); 

    map_skill("blade", "wind-blade");
    map_skill("parry", "wind-blade"); 
    map_skill("dodge", "renshu");
    map_skill("force", "renshu");
    map_skill("unarmed", "kongshoudao");

    add_temp("apply/attack", 50);
    add_temp("apply/defense", 50);
    add_temp("apply/armor", 50);
    add_temp("apply/damage", 50);
    setup();

    carry_object(__DIR__"obj/japancloth")->wear();
    carry_object(__DIR__"obj/japanblade")->wield();
    add_money("gold", random(50));
}
void hunting()
{
        int i;
        object *ob;
        ob = all_inventory(environment());
        for(i=sizeof(ob)-1; i>=0; i--) {
        if( !ob[i]->is_character() || ob[i]==this_object() || !living(ob[i])) continue;
               continue;
        if(ob[i]->query("vendetta/authority") 
           || (userp(ob[i]) && ob[i]->query("age") < 18 )
           || ob[i]->query("is_quest") || ob[i]->query("is_robber") )
                continue;
                kill_ob(ob[i]);
                ob[i]->fight(this_object());
        }
}

void die()
{
        object ob, me, corpse;
        
        ob = this_object();
        me = query_temp("last_damage_from");
        
        message_vision(WHT"$N大叫一声,天皇万岁!!倒地而亡。\n"NOR,ob,me);
        if( objectp(corpse = CHAR_D->make_corpse(this_object())) )
        corpse->move(environment(this_object()));
        if (!userp(me)) return;
        if((int)me->query("combat_exp") < 2100000000)   {
        message("vision", me->name() + "由于成功的保卫了祖国,增加了300000经验和80000潜能。\n", me);
        me->add("combat_exp",300000);
        me->add("potential",80000);
        } else
        {
        message("vision", me->name()
        + "由于成功的保卫了祖国,增加了100000经验和5000潜能。\n", me);
        me->add("combat_exp",100000);
        me->add("potential",5000); 
        }
        destruct(ob);
        return;
}
