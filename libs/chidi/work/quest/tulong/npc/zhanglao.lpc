#include <room.h>
inherit NPC;
#include <ansi.h>

int do_knock(object me, string arg);

void create() {
  set_name("精灵长老", ({ "jingling zhanglao", "zhanglao" }));
  set("gender", "男性");
  set("age", random(20) + 20);

  set("long", "这是一位精灵神界的长老，一脸笑容。\n");
  set("combat_exp", 80000);
  set("attitude", "peaceful");
  set("per", 100);
  set("max_qi", 3000);
  set("max_jing", 2000);
  set("max_neili", 2000);
  set("neili", 1000);
  set("no_get", 1);

  setup();
  carry_object("clone/misc/cloth")->wear();
}

void init() {
  add_action("do_knock", "back");
}
int do_knock(object me, string arg) {
  me = this_player();
  message_vision(HIC "$N的身影消失在一阵光芒中。\n" NOR, me);
  me->set_temp("mark/diary", 0);
  me->set_temp("m_success/初级", 0);
  me->set_temp("m_success/幻影", 0);
  me->set_temp("m_success/孽龙", 0);
  write_file("/quest/tulong/master", "", 1);
  me->move("/d/tulong/spiritgate");
  return 1;
}

void unconcious() {
  reincarnate();
  set("eff_qi", query("max_qi"));
  set("qi", query("max_qi"));
  set("eff_jing", query("max_jing"));
  set("jing", query("max_jing"));
  set("jingli", query("eff_jingli"));
  say("精灵长老笑着说道：我们精灵神界的人是不会死的！\n");
  command("hehe");
}

void die() {
  unconcious();
}
