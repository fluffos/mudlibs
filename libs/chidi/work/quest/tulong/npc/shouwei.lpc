#include <room.h>
#include <localtime.h>
inherit NPC; 
#include <ansi.h>
int day;
int do_knock(string arg);
string ask_enter();
string ask_fangqi();
void create()
{
        set_name("精灵守卫", ({ "jingling shouwei", "shouwei"}));   
        set("gender", "男性");
        set("age", random(20) + 20);

        set("long","这是一位守卫精灵神界的美男子，可以问他关于如何进入的问题。\n");
        set("combat_exp", 80000);
        set("attitude", "peaceful");
		set("per",100);
        set("max_qi", 3000);
        set("max_jing", 2000);
        set("max_neili",2000);
        set("neili",1000);
        set("no_get",1);
        set("inquiry", ([
                 "进入" :   (: ask_enter :),   				 
                ]));

        setup();
        carry_object("clone/misc/cloth")->wear();
} 

void init()
{
	int l_time = time();
	mixed *lt = localtime(l_time);
	int gmt = l_time + lt[LT_GMTOFF];
	day = lt[LT_YDAY];
    add_action("do_knock","knock");
}
int do_knock(string arg)
{ 
   object member;
   string temp;

   member = this_player()->query_team();
     if (!arg || arg != "spiritgate")
      {
            return notify_fail("敲门请输入(knock spiritgate)！\n");
      }
	  
     if( this_player()->query("zhuanshi/times") < 4) return notify_fail("你这样的能力是进不了精灵界的,转了4次再来吧。\n");

     temp=read_file("/quest/tulong/master",1,1);
     if( temp != "" && (time()-query("begin/time"))<1800)
     return notify_fail("现在已经有人进入精灵神界了，请稍等。\n");
	 
	 else 
	 {
	 
//     if( sizeof(member) != 7 )
//     return notify_fail(HIG"如果队中成员数目不是正好为十四之半，精灵之门不会开启。\n"NOR);

	 if( this_player()->query("tulong/age") == day) 
	   {
	      if (this_player()->query("zhuanshi/times") > 3 && this_player()->query("tulong/entertimes") < 3) 
		  {
          message_vision( HIG "$N在虚空中轻轻扣动几下，一阵优美的乐声中，$N被送到了一个奇异的地方！\n" NOR, this_player());
          message("channel:chat", HBMAG"【精灵神界】精灵之门开启，某小队进入了精灵神界，破解神龙的封印!\n"NOR,users());
          this_player()->move("/d/tulong/spirit1"); 
          this_player()->set("fighter",0); 
          this_player()->set("mark/diary",0); 
          set("begin/time", time());		  
          this_player()->set_temp("m_success/初级",0);  
          this_player()->set_temp("m_success/幻影",0);  
          this_player()->set_temp("m_success/孽龙",0);  
          this_player()->set_temp("m_success/琼草",0);  
          write_file("/quest/tulong/master","",1);
          write_file("/quest/tulong/master",this_player()->query("id"),1);
          return 1;
		  }
		  
		  else 
		  {
		  return notify_fail("你进入【精灵神界】的次数用尽了。\n");
		  }
	   }
    else 
       {
          message_vision( HIG "$N在虚空中轻轻扣动几下，一阵优美的乐声中，$N被送到了一个奇异的地方！\n" NOR, this_player());
          message("channel:chat", HBMAG"【精灵神界】精灵之门开启，某小队进入了精灵神界，破解神龙的封印!\n"NOR,users());
          this_player()->move("/d/tulong/spirit1"); 
          this_player()->set("fighter",0); 
          this_player()->set("mark/diary",0); 
		  set("begin/time", time());
          this_player()->set("tulong/entertimes",0); 		  
          this_player()->set_temp("m_success/初级",0);  
          this_player()->set_temp("m_success/幻影",0);  
          this_player()->set_temp("m_success/孽龙",0);  
          this_player()->set_temp("m_success/琼草",0);  
          write_file("/quest/tulong/master","",1);
          write_file("/quest/tulong/master",this_player()->query("id"),1);
          return 1;	
       }		
    }
}

string ask_enter()
{
       object me=this_player();

       if(me)
       return "直接输入(knock spiritgate)就可以了！\n";

}

void unconcious()
{
        reincarnate();
        set("eff_qi", query("max_qi"));
        set("qi", query("max_qi"));
        set("eff_jing", query("max_jing"));
        set("jing", query("max_jing"));
        set("jingli", query("eff_jingli"));
        say( "精灵守卫笑着说道：我们精灵神界的人是不会死的！！\n");
        command("hehe");
}

void die()
{
        unconcious();
}