#include <ansi.h>
inherit ITEM;
void create()
{	set_name(HIC "宝箱" NOR, ({"box","xiang"}) );
	set_weight(200);
	if( clonep() )
		set_default_object(__FILE__);
	else {
                set("long", "这是烈火孽龙的宝箱，它收集的宝贝全装在里面。用法：break。\n");
                set("value", 10000);
                set("merit", 100000);
               set("no_give", 1);
               set("no_drop", 1);
			   set("no_paimai", 1);
			   set("nopaimai", 1);
			   set("no_steal",1);
               set("no_put", 1);
               set("no_get", 1);
		set("unit", "个");
	}
}
void init()
{
     add_action("do_eat","break");
}
int do_eat(string arg)
{ 
	object me,obj;
	me = this_player();    

        if (! id(arg))
                return notify_fail("你要打开箱子？请输入（break box）！\n");
      
        message_vision("$N兴奋的冲向" + this_object()->name() +
                       "猛得打开，顿时心花怒放。\n", me);
        if (random(100) >= 98)
            {
			   switch ( random (5)) 
			   {
                case 0:
                obj = new ("/u/seabird/gift/jiuyangdan.lpc");
				obj->move(me);
				message_vision("$N眨眨眼。\n", me);
                tell_object(me, "从宝箱中掏出一颗丹药。\n");
				break;
                case 1:
                obj = new ("/u/seabird/gift/jiuyindan.lpc");
				obj->move(me);
				message_vision("$N眨眨眼。\n", me);
                tell_object(me, "从宝箱中掏出一颗丹药。\n");
				break;
                case 2:
                obj = new ("/u/seabird/gift/liuyindan.lpc");
				obj->move(me);
				message_vision("$N眨眨眼。\n", me);
                tell_object(me, "从宝箱中掏出一颗丹药。\n");
				break;
                case 3:
                obj = new ("/clone/fam/gift/emperor1.lpc");
				obj->move(me);
				message_vision("$N眨眨眼。\n", me);
                tell_object(me, "从宝箱中掏出一颗丹药。\n");
				break;
                case 4:
                obj = new ("/clone/fam/gift/lonely1.lpc");
				obj->move(me);
				message_vision("$N眨眨眼。\n", me);
                tell_object(me, "从宝箱中掏出一颗丹药。\n");
				break;
			   }
            } 
		else if (random(100) >= 96)
            {
                obj = new ("/d/jh/weapon/jue/jue4.lpc");
				obj->move(me);
				message_vision("$N眨眨眼。\n", me);
                tell_object(me, "从宝箱中掏出一块魔睛蚀舞铁。\n");
		
            } 
		else
        {       
                tell_object(me, HIR "你觉得自己是个幸运之神的宠儿。\n你获得了一些浴血币。\n" NOR);
                me->add("rmb" ,me->query("zhuanshi/times")*100000);             
        }
        destruct(this_object());
		
	return 1;
}

void owner_is_killed() { destruct(this_object()); }
