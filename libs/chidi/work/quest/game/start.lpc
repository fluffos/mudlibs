//经验5000万~2亿
#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "江湖-游戏楼");
  set("long", @LONG
								
    这里是江湖游戏楼。
LONG
  );

  // set("outdoors", "taishan");

  set("exits", ([
    "south": "/d/city/chatroom",
    "enter": "/quest/game/01"
  ]));

  set("objects", ([
    "/quest/game/npc/master-wqa": 1,
  ]));


  setup();

  //replace_program(ROOM);
}

int valid_leave(object me, string dir) {
  if (dir == "enter") {

    tell_object(this_player(), "神灵对你说："
      "“记得用 go 向前走，用 who -g 查看，用chaww查看社会威望，用 qt 回来啊。”\n\n");

    if (this_player()->query("combat_exp") > 200000000)  // 经验上限2亿
      return notify_fail("你的经验已经达到2亿不能进去。\n");

    if (this_player()->query("combat_exp") < 80000000)  // 经验下限5000万
      return notify_fail("你的经验不够8000万不能进去。\n");

    // this_player()->move("/d/wqa/01");

    // 以此为加入的标志
    this_player()->set_temp("wqa's room/flag", 1);
  }
  return ::valid_leave(me, dir);
}
