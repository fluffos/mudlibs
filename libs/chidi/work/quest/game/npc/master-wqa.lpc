// master-wqa.c 

#include <ansi.h>

inherit NPC;

void create()
{
        set_name(YEL"神灵"NOR, ({ "master hyl", "master" }));

        set("long",@LONG
她是江湖的神仙，掌管江湖的梦幻时空。她身着雪白的衣衫，
雪白的长裙，身形苗条婀娜，气定神闲，轻风动裾，飘飘兮如仙子下凡尘。
你不禁想起庄子的描述：藐姑射之山，有神人居焉，肌肤若冰雪，绰约若
处子，不食五谷，吸风饮露。
LONG
        );

        set("gender", "女性" );
        set("age", 18);

        set("str", 50);         // 膂力         
        set("per", 30);         // 容貌
        set("int", 50);         // 悟性         
        set("con", 50);         // 根骨
        set("combat_exp", 8000000);
     
 

        setup();

        carry_object("/clone/misc/cloth")->wear();
   
}

void init()
{       
        object ob;

        ::init();
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
               add_action("do_change","change");
        }
}

void greeting(object ob)
{
        if( !ob || environment(ob) != environment() ) return;

        message_vision( HIW "神灵对"NOR+HIR"$N"NOR+HIW"说道:你已经回到了现实世界，你是否决定用声望兑换经验？\n" NOR, ob);
        message_vision( HIW "如果兑换请输入"NOR+HIG"change"NOR+HIW"，如果不换请使用"HIG"qt"HIW"退出或者"HIG"go"HIW"继续。\n" NOR, ob);

	return;
}


int do_change(string arg)
{ 
        int i, n, q, s;
        object ob;

	ob = this_player();

       if( ob->query("combat_exp") > 200000000 )  // 经验上限2亿
             return notify_fail("你的经验已经太多了。\n");

       if( ob->query("combat_exp") < 50000000 )  // 经验下限5千万
              return notify_fail("你的经验已经太少了。\n");


	if ( ob->query_temp("wqa's room/change") >= 1 )
		return notify_fail("你已经进行过兑换了，下次来到再进行兑换吧。\n"); 
       
        i = ob->query_temp("wqa's room/point");
        if( i <= 100 ) return notify_fail("你的社会声望不够100点，暂时不能给您兑换。\n");

        n = i*40+ random( i*30 + 10 );
        if (n<0) n=0;
        if (( n + ob->query("combat_exp"))>=200000000)
        n = 200000000 - ob->query("combat_exp");
        q = n/4;
        s = q/2000;

        tell_object( ob, HIB "神灵对你说：你现在总共有" 
                + chinese_number(i) + "点社会声望。\n" NOR );
        tell_object( ob, HIB "神灵对你说：你已经获得了" 
                + chinese_number(n) + "点实战经验。\n" NOR );
        tell_object( ob, HIB "神灵对你说：你已经获得了" 
                + chinese_number(q) + "点学习潜能。\n" NOR ); 
        tell_object( ob, HIB "神灵对你说：你已经获得了" 
                + chinese_number(s) + "点综合评价。\n" NOR );           
 
        ob->add("combat_exp", n);
        ob->add("potential", q);
        ob->add("score", s);
        ob->set_temp("wqa's room/point", -i);
	 ob->set_temp("wqa's room/change",1);
	return 1;
}
