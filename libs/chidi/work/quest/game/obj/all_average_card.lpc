// all_average_card.c - 均望卡

#include <ansi.h>

inherit COMBINED_ITEM;

void create() {
  set_name("均望卡", ({ "all average card", "card", "all" }));
  if (clonep()) set_default_object(__FILE__);
  set("unit", "叠");
  set("base_unit", "张");
  set("long", "梦幻时空的卡片，使用（use）可以平均分配所有人的社会声望。\n");
  set("value", 0);
  set("base_weight", 3);
  set_amount(1);

}

void init() {
  add_action("do_use", "use");
}

int do_use(string arg) {
  object me, ob, *all;
  int i, n, t, av;

  me = this_player();

  if (!id(arg)) return notify_fail("你想要使用什么东西？\n");

  if (me->is_busy()) return notify_fail("你正忙着呢！\n");
  me->start_busy(1);

  if (!me->query_temp("wqa's room/flag"))
    return notify_fail("你现在不在梦幻时空！\n");

  all = users();
  i = sizeof(all);
  t = 0; n = 0;
  while (i--) {
    if (!environment(all[i])) continue;
    if (wizardp(all[i])) continue;
    if (!all[i]->query_temp("wqa's room/flag")) continue;
    t += all[i]->query_temp("wqa's room/point");
    n++;
  }
  if (n <= 0) return notify_fail("现在没有人和你分声望！\n");

  av = t / n;

  message_vision(HIR "$N开始使用" + this_object()->query("name") + "....\n" NOR, me);

  all = users();
  i = sizeof(all);
  while (i--) {
    if (!environment(all[i])) continue;
    if (wizardp(all[i])) continue;
    if (!all[i]->query_temp("wqa's room/flag")) continue;
    all[i]->set_temp("wqa's room/point", av);
  }

  // set("name", "卡片");  set("id", "card");
  CHANNEL_D->do_channel(this_object(), "game", me->name()
    + "大声叫道：“同志们！让我们跑步进入共产主义！！”\n"
    "        " + me->name() + "与所有人平均分配"
    +chinese_number(t) + "点社会声望，每人分到"
    +chinese_number(av) + "点。\n");

  add_amount(-1);
  return 1;
}
