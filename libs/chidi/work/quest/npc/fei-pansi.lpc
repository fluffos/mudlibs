inherit __DIR__ "fei.lpc";


void set_skills() {
  object me = this_object();
  object weapon;
  int j;
  j = 200 + random(150);
  create_family("武当派", 3, "弟子");
  me->set_skill("unarmed", j);
  me->set_skill("dodge", j);
  me->set_skill("parry", j);

  me->set_skill("sword", j + random(15));
  me->set_skill("force", j + random(15));
  me->set_skill("taiji-jian", j + random(15));
  me->set_skill("taiji-shengong", j + random(15));
  me->set_skill("tiyunzong", j + random(15));
  me->set_skill("taiji-quan", j + random(15));

  me->map_skill("force", "taiji-shengong");
  me->map_skill("unarmed", "taiji-quan");
  me->map_skill("sword", "taiji-jian");
  me->map_skill("parry", "taiji-jian");
  me->map_skill("dodge", "tiyunzong");

  set("chat_chance_combat", 80);
  set("chat_msg_combat", ({
    (: perform_action, "sword.chan" :),
    (: perform_action, "sword.lian" :),
    (: perform_action, "sword.sui" :),
    (: exert_function, "recover" :),
  }));
  carry_object("/clone/misc/cloth")->wear();
  carry_object("/clone/weapon/changjian")->wield();
}
