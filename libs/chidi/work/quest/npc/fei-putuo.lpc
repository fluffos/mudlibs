inherit __DIR__"fei.lpc";


void set_skills()
{
        object me=this_object();
	object weapon;

	int j;
        j= 500+random(150); 
        create_family("神龙教", 3, "弟子"); 
	me->set_skill("unarmed", j);
	me->set_skill("dodge", j);
	me->set_skill("parry", j);
	me->set_skill("force", j);
        me->set_skill("sword", j);
	me->set_skill("staff", j+random(15));
	me->set_skill("shenlong-bashi", j+random(15));
	me->set_skill("yixingbu", j+random(15));
	me->set_skill("shedao-qigong", j+random(15));
	me->set_skill("shenlong-xinfa", j+random(15));

	me->map_skill("force", "shenlong-xinfa");
	me->map_skill("staff", "shedao-qigong");
        me->map_skill("parry", "shenlong-bashi");
	me->map_skill("dodge", "yixingbu");
	me->map_skill("unarmed", "shenlong-bashi");

	set("chat_chance_combat", 80);
	set("chat_msg_combat", ({
          (: perform_action,"chang3" :),
	}) );

    carry_object("/clone/misc/cloth")->wear();
     carry_object("/clone/weapon/gangzhang")->wield();
}
