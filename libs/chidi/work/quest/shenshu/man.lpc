#include <ansi.h>
inherit BHNPC;
void create()
{
       set_name("无名居士", ({ "noname", "man" }));
        set("title",HIW"一代宗师"NOR);
        set("long", 
              "他就是无名居士，没有人知道他的来历。\n"
              "如果你想收集神书，你可以问问他(book)和(shi).\n");
        set("age", 57);
        set("attitude", "friendly");
        set("str", 700);
        set("int", 40);
        set("con", 40);
        set("dex", 700);
        set("max_qi", 99999999);
        set("max_jing", 999999999);
        set("neili", 4500);
        set("max_neili", 4500);
        set("jiali", 0);
        set("combat_exp", 10000000);
        set("score", 50000);                
        set_skill("strike",200);
        set_skill("unarmed",200);
        set_skill("dodge",200);
        set_skill("force", 200);
        set_skill("parry", 210);
        set_skill("literate", 200);

        set("is_quest",1);
        set("inquiry", ([
            "book": "神书共有四十二本，你可以用help tasks获得有关方面知识！",
            "shi": "只有靠"HIR"七"+HIC+"彩"+HIY+"向"+HIM+"导"+HIG+"石"NOR+CYN"才能找到神书，灵石二十两一块！",
            ]) );
        setup();
}

int accept_object(object me, object ob)
{
       object shi; 

       if( ob->query("money_id") && ob->value() >= 2000)
       {       
         if (!present("xdshi", me))
        {
        shi = new("/clone/misc/findbook");
        command("say 好吧,"+me->query("name")+"既然给了钱，我就给你一块！\n");
        shi->move(me);
        message_vision("$N将一块"HIR"七"+HIC+"彩"+HIY+"向"+HIM+"导"+HIG+"石"NOR"交给了$n。\n" , this_object(), me );
        } else 
        command("say 你不是有了一块嘛，还想要？钱我没收！\n");
        return 1;
      }
      command("say 谢谢！");
      return 1;
}

void init()
{
                add_action("do_kill","team kill");
                add_action("do_kill","kill");
                add_action("do_kill","hit");
                add_action("do_kill","fight");
                add_action("do_kill","touxi");
                add_action("do_kill","steal");
                add_action("do_kill","beg");
                add_action("do_kill","persuade");              
}

int do_kill(string arg)
{
        string what,who;
        if(!arg) return 0;
        if(this_object()->id(arg))
        {
                write("你不是我对手，不要送死了。\n");
                return 1;
        }
        else
        if(sscanf(arg,"%s from %s",what,who)==2 && this_object()->id(who))
        {
                write("还是到别处去施展你的本事吧。\n");
                return 1;
        }
        return 0;
}

