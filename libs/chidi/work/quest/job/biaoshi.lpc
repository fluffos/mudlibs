#include <ansi.h>
inherit BHNPC;

int do_copy(object me);
int do_back(object me);

void create() {
  string weapon;
  set_name("护镖镖师", ({ "biaoshi" }));
  set("gender", "男性");
  set("age", random(10) + 25);
  set("no_quest", 1);
  set("no_suck", 1);
  set("no_fight", 1);
  set("str", 33);
  set("con", 26);
  set("int", 20);
  set("dex", 23);
  set("long", "镖局的镖师。\n");
  set("combat_exp", 21000000);
  set("attitude", "friendly");
  set_skill("force", 15000);
  set_skill("sword", 15000);
  set_skill("dodge", 15000);
  set_skill("parry", 15000);
  set_skill("fanliangyi-dao", 15000);
  set_skill("blade", 15000);
  set_skill("zixia-shengong", 15000);
  map_skill("blade", "fanliangyi-dao");
  set("max_qi", 2100000);
  set("max_jing", 2100000);
  set("neili", 2000000);
  set("max_neili", 1700);
  set("jiali", 3000);
  weapon = "/clone/weapon/changjian";
  setup();
  carry_object(weapon)->wield();
  carry_object("/clone/misc/cloth")->wear();
}

void die() {
  int i, pot, exp;
  object killer, ob;
  ob = this_object();
  exp = random(2000) + 5000;
  pot = exp / 2;
  if (objectp(killer = query_temp("last_damage_from")) && killer->query("id") == ob->query_temp("username"))
    tell_object(killer, HIM "恭喜你被奖励了" + chinese_number(exp) + "点实战经验\n"
      +chinese_number(pot) + "点潜能\n" NOR);
  killer->add_temp("biaoshi", 1);
  killer->add("combat_exp", exp);
  killer->add("potential", pot);
  killer->delete_temp("xx_rob");
  ob->clear_condition();
  destruct(ob);
  return;
}

int do_back(object me) {
  message_vision("$N看看周围，发现劫匪不见了，转身就离开了。\n", me);
  destruct(me);
}

int checking(object ob, object me) {
  if (!me || !present(me, environment())) do_back(ob);
  else call_out("checking", 2, ob, me);
  return 1;
}

int do_copy(object me) {
  int i;
  object ob;
  ob = this_object();
  if (!me->query_temp("xx_rob")) {
    do_back(ob);
    return 0;
  }
  message_vision(HIR "突然从车队后窜出一个$N，二话不说就扑向了$n！\n" NOR, ob, me);
  ob->kill_ob(me);
  me->kill_ob(ob);
  checking(ob, me);
  call_out("do_back", 350, ob);
  return 1;
}

void init() {
  object ob, me;
  mapping skill_status, map_status, hp_status;
  string *sname, *mname;
  int i, lvl;
  me = this_object();
  ob = this_player();
  ::init();
  if (!living(this_object())) return;
  if (interactive(ob = this_player()) && ob->query("id") == me->query_temp("username")) {
    me->map_skill("unarmed");
    me->map_skill("dodge");
    me->map_skill("parry");
    if (!(skill_status = ob->query_skills())) return;
    sname = keys(skill_status);
    for (i = 0; i < sizeof(skill_status); i++) {
      lvl = skill_status[sname[i]] / 5 * 3;
      if (lvl < 1000) {
        lvl = 1000;
        me->set_skill(sname[i], lvl);
      } else {
        me->set_skill(sname[i], lvl);
      }
    }
    if (!(map_status = ob->query_skill_map())) return;
    mname = keys(map_status);
    for (i = 0; i < sizeof(map_status); i++) {
      me->map_skill(mname[i], map_status[mname[i]]);
    }

    hp_status = ob->query_entire_dbase();
    me->set("str", hp_status["str"]);
    me->set("int", hp_status["int"]);
    me->set("con", hp_status["con"]);
    me->set("dex", hp_status["dex"]);
    me->set("max_qi", hp_status["max_qi"] / 5 * 3);
    me->set("eff_qi", hp_status["eff_qi"] / 5 * 3);
    me->set("qi", hp_status["eff_qi"] / 5 * 3);
    me->set("max_jing", hp_status["max_jing"] / 5 * 3);
    me->set("eff_jing", hp_status["eff_jing"] / 5 * 3);
    me->set("jing", hp_status["eff_jing"] / 5 * 3);
    me->set("max_neili", hp_status["max_neili"] / 5 * 3);
    me->set("neili", hp_status["max_neili"] / 5 * 3);
    me->set("max_jingli", hp_status["max_neili"] / 5 * 3);
    me->set("jingli", hp_status["max_neili"] / 5 * 3);
    me->set("jiali", hp_status["jiali"] / 5 * 3);
    me->set("combat_exp", hp_status["combat_exp"] / 5 * 3);
  }
  if (this_player()->query("id") != me->query_temp("username")) {
    add_action("do_kill", "team kill");
    add_action("do_kill", "kill");
    add_action("do_kill", "hit");
    add_action("do_kill", "fight");
    add_action("do_kill", "steal");
    add_action("do_kill", "beg");
    add_action("do_kill", "touxi");
    add_action("do_kill", "ansuan");
    add_action("do_kill", "perform");
  }


}
//不是自己的npc不能杀
int do_kill(string arg) {
  string what, who;
  if (!arg) return 0;
  if (this_object()->id(arg)) {
    write("江湖人士，还是少惹为妙。\n");
    return 1;
  } else if (sscanf(arg, "%s from %s", what, who) == 2 && this_object()->id(who)) {
    write("还是到别处去施展你的本事吧。\n");
    return 1;
  }
  return 0;
}
