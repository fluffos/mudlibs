string ask_job();
string fangqi_job();
void create()
{
        set_name("马仇", ({ "ma chou", "ma"}) );
        set("gender", "男性" );
        set("nickname", "土匪头子");
        set("title", HIR"目无王法"NOR);
        set("age", 31);
        set("no_suck", 1);
        set("no_get", 1);
        set("long", "住在扬州一带的土匪头，略有名气，常常以打劫镖车为生。\n");
        set("str", 29);
        set("dex", 26);
        set("con", 24);
        set("int", 22);
        set("per", 18);
        set("shen", -7500);
        set("max_qi", 800000);
        set("max_jing", 800000);
	 set("neili",2000);
	 set("max_neili",200000);
        set("eff_jingli", 180000);
	 set_skill("blade",800);
	 set_skill("zixia-shengong",800);
	 set_skill("fanliangyi-dao",600);
	 map_skill("blade","fanliangyi-dao");
	 
        set("combat_exp", 750000);
        set("chat_chance_combat", 55);
        set("chat_msg_combat", ({
                (: perform_action, "blade.sanshen" :),
        }));
        set("inquiry", ([
                "劫镖" : (: ask_job :),
                "抢劫" : (: ask_job :),
                "rob" : (: ask_job :),
                "放弃" : (: fangqi_job :),

        ]));        
        setup();
        carry_object("/clone/weapon/gangdao")->wield();
        carry_object("/clone/misc/cloth")->wear();
        add_money("silver", 10);
}
int accept_object(object me, object obj)
{
   object ob=this_object();
   if(!me || environment(me) != environment()) return 0;
   if(!objectp(obj)) return 0;
   if(!present(obj, me)) return notify_fail("你没有这件东西。");
   if(!ob->query_temp("give")){        
   if(userp(obj)){
       command("consider "+(string)me->query("id"));
       command("say 你拿个快死的人来骗我？");
       return 0;
       }
   if(obj->query("id") == "prize" && obj->query("owner") == me->query("id")){
       command("nod "+(string)me->query("id"));
       command("say 好样的！干得好！\n");       
       message_vision(HIY"$N将$n"HIY"拆开，拿出了一大堆金银财宝。\n"NOR,ob, obj);
       ob->set_temp("give",1);
       remove_call_out("destroying");
       call_out("destroying", 3, obj, ob, me);                       
       return 1;
       }
   if(obj->query("money_id")) {
       command("pat " + me->query("id"));
       command("say 钱我有的是，你以后还是留给自己吧。");
       return 0;
       }
   if(obj->query("owner") != me->query("id")){
       command("hehe "+(string)me->query("id"));
       command("say 不错啊，但这活可不是你干的。");
       return 1;
       }
   else return 0;
}
else
       command("shake"+(string)me->query("id"));
       command("say 现在我没时间，等会再来。");
       return 0;
       
}
//完成任务
void destroying(object obj, object ob, object me)
{   
   object n_money;
   if(obj) destruct(obj);
   if(!ob) return;
   if(!me || environment(me) != environment()){
      command("say 咦，人呢？");
      ob->delete_temp("give");  
      return;
      }
   command("pat "+me->query("id"));
   message_vision(HIY"$N对$n说道：你这次做得极为出色，这是你该得的部分，拿去吧！\n"NOR,ob, me);
   n_money = new("/clone/money/gold");
   n_money->move(me); 
   n_money->add_amount(1);  
   me->set_temp("robjob_exp",5000+ random(5000) + me->query_temp("biaoshi")*random(500));
   me->add("combat_exp", me->query_temp("robjob_exp"));
   me->add("potential", me->query_temp("robjob_exp"));
   tell_room(environment(me), me->name()+"数着钱袋里的金子，脸上的肌肉不住地颤动，眼睛散发着一种奇怪的光芒。\n" NOR, ({ me }));     
   tell_object(me, RED"你被奖励了"+chinese_number(me->query_temp("robjob_exp"))+"点经验值！\n"+chinese_number(me->query_temp("robjob_exp"))+"点潜能\n"NOR);
//   message("channel:sale",HIM"【江湖传闻】""听说"+me->query("name")
//     +"成功劫下长风镖局的镖车\n""  获得了"+chinese_number(me->query_temp("robjob_exp"))+"点经验值"+chinese_number(me->query_temp("robjob_exp")/4)+"点潜能""！\n"NOR,users());  
   me->delete_temp("robjob_exp");
   me->delete_temp("biaoshi");   
   me->clear_condition("rob_task");
   ob->delete_temp("give");    
   return;      
}
//领取任务
string ask_job()
{
  object me, ob;
  mapping aquest;
  int exp, j;
  aquest = quest[random(sizeof(quest))];
  me = this_player();
  ob = this_object();
  exp = me->query("combat_exp"); 
    if(me->query("combat_exp")<1000000000)//经验下限10亿
        return ""+me->query("name")+"("+me->query("id")+")你现在的实力还不能去劫镖。";  

    if(me->query("combat_exp")>=1800000000)//经验上限18亿
        return ""+me->query("name")+"("+me->query("id")+")我已经无法安排你去劫镖了。";    

    if(me->query_condition("rob_task"))
        return ""+me->query("name")+"("+me->query("id")+")你现在还有任务在身，等会儿再来吧。";   
    
    if(ob->query_temp("job_asked") == me->query("id")) 
        return ""+me->query("name")+"("+me->query("id")+")你不是已经领了任务了吗？怎么还不去？";

    if(ob->query_temp("job_asked"))
        return "嘿嘿，"+me->query("name")+"("+me->query("id")+")你来晚了，等下一次吧。";

    if(ob->query_temp("give"))
        return "嘿嘿，"+me->query("name")+"("+me->query("id")+")你稍等一会，我正在接受脏物呢。";

    if(me->query("shen") > -1000000) 
        return "哼！"+me->query("name")+"("+me->query("id")+")看来你的心肠还不够黑啊，这种事你不问也罢。";

    if(exp>=1400000000) j=10;
    else if(exp>=1300000000) j=9;
    else if(exp>=1150000000) j=8;
    else if(exp>=900000000) j=7;   
    else j=6;     
    me->set_temp("rob_job", 1);
    me->delete_temp("biaoshi");
    tell_object(me,HIB"这两天长风镖局会有一趟镖经过，够胆就和我一起去看看吧。\n"NOR);
    ob->set_temp("job_asked", me->query("id"));
    ob->set_temp("dest", aquest["name"]);
    ob->set_temp("start_place", aquest["start"]);
    me->set_temp("start_place", aquest["start"]);
    me->set_temp("j", j);    
    me->apply_condition("rob_task", j*2);      
    if (!ob->query_temp("give"))
    {
    ob->move(ob->query_temp("start_place"));
    me->move(me->query_temp("start_place"));
    ob->set_temp("place", aquest["place"]);   
    return "我现在就和你一起去"+ob->query_temp("place")+"看看。";
    }
else  
    return "嘿嘿，"+me->query("name")+"("+me->query("id")+")你没看见我正忙着吗？";
}
//放弃任务
string fangqi_job()
{
  object me, ob; 
  int exp, pot,j; 
  me = this_player();
  ob = this_object();
  exp=me->query_condition("rob_task");
  exp *=100;
  pot=exp/4;
    if(!me->query_condition("rob_task"))
   {
      return ""+me->query("name")+"("+me->query("id")+")你现在没有任务啊？";
    }else{
    me->add("combat_exp",-exp);
    me->add("potential",-pot);            
    me->detele_temp("rob_job");
    me->delete_temp("biaoshi");    
    ob->delete_temp("job_asked");
    ob->delete_temp("dest");
    ob->delete_temp("start_place");
    ob->delete_temp("give");
    me->delete_temp("start_place");    
    me->delete_temp("j");    
    me->clear_condition("rob_task");
    tell_room(environment(me), me->name()+"愁眉苦脸地看了看马仇，希望他能再给一次机会。\n" NOR, ({ me }));  
    tell_object(me, HIB"你被惩罚了"+chinese_number(exp)+"点经验值！\n"+chinese_number(pot)+"点潜能\n"NOR); 
    return "既然"+me->query("name")+"("+me->query("id")+")你没这个能力，惩罚你一下就算了吧。";
     }
 }


void do_back(object me)
{  
        me->delete_temp("wait_target");
        me->delete_temp("start_place");
        me->delete_temp("place");
        me->delete_temp("dest");
        message_vision("$N转过山丘，几个起落就不见了。\n", me);
        me->move("/d/xiangyang/lx"); 
        message_vision("$N急急忙忙地走了过来。\n", me); 
        remove_call_out("del_temp");
        call_out("del_temp", 5, me);                                   
}

void del_temp(object me) {me->delete_temp("job_asked");}

void init()
{
   object ob, where, me,obj;   
   ::init();
   ob =this_object();
   where = environment(ob);
   
   if(ob->query_temp("dest")){
     if(interactive(me = this_player()) && me->query_temp("rob_job")
        && ob->query_temp("job_asked") == me->query("id")
        && file_name(where) == ob->query_temp("start_place")) 
{         
    obj = new(__DIR__"shangdui");
    obj->set("owner",ob->query_temp("job_asked"));    
    obj->move(environment(me)); 
    obj->set("arg", ob->query_temp("dest"));
    message_vision(HIY"\n只听一阵车轮声传来，一只长风镖局的镖队出现在眼前！\n\n"NOR, ob);
    tell_object(me,"猎物终于出现了！\n"); 
    message_vision(HIY"$N对着$n大声命令道：你快抢(qiang)镖队，我来对付其他人！\n"NOR, ob, me); 
    message_vision("说完$N就冲上前去，和几个护镖镖师打斗追逐开了。\n", ob);   
    remove_call_out("do_back");
    do_back(ob);
    me->delete_temp("wait_target");
    me->set_temp("rob_start", 1);
           }
     else{
         remove_call_out("do_back");
         call_out("do_back", 90, ob);
         }
     }
}

