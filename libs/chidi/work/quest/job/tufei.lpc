#include <ansi.h>
inherit BHNPC;
void create() {
  string weapon;
  set_name("土匪", ({ "tufei" }));
  set("gender", "男性");
  set("age", random(10) + 25);
  set("no_quest", 1);
  set("str", 33);
  set("con", 26);
  set("int", 20);
  set("dex", 23);
  set("long", "山西劫匪。\n");
  set("combat_exp", 10800000 + random(4000000));

  set("no_quest", 1);
  set_skill("force", 450 + random(300));
  set_skill("sword", 450 + random(300));
  set_skill("dodge", 450 + random(300));
  set_skill("parry", 450 + random(300));
  set_skill("fanliangyi-dao", 450 + random(300));
  set_skill("blade", 450 + random(300));
  set_skill("zixia-shengong", 450 + random(300));
  map_skill("blade", "fanliangyi-dao");
  set("max_qi", 14500);
  set("eff_jingli", 14000);
  set("neili", 17000);
  set("max_neili", 17000);
  set("jiali", 30);
  weapon = "/clone/weapon/gangdao";
  setup();
  carry_object(weapon)->wield();
  carry_object("/clone/cloth/cloth")->wear();
}

void init() {
  object ob;
  remove_call_out("hunting");
  if (interactive(ob = this_player())) {
    call_out("hunting", 1);
  }
  if (!environment()->query("no_fight") && random(10) < 5)
    call_out("hunting", 1);
}

void hunting() {
  int i;
  object *ob;
  ob = all_inventory(environment());
  for (i = sizeof(ob) - 1; i >= 0; i--) {
    if (!ob[i]->is_character() || ob[i] == this_object() || !living(ob[i])) continue;
    if (ob[i]->query("vendetta/authority")) continue;
    kill_ob(ob[i]);
    ob[i]->fight(this_object());
  }
}
