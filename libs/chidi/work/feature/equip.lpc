#include <dbase.h>
#include <weapon.h>

#define USER_ENERGY_D "/adm/daemons/energy.lpc" //属性重算

//函数声明
varargs void count_equip_apply( object me, object equip, object equip2 );

int wear()
{
	object owner,equip,equip_1;
	mapping armor_prop, applied_prop;
	string *apply,type,equip_id;
    
	equip = this_object();
	equip_1 = 0;
    
	//如果这个武器无效
	if(!equip || !objectp(equip)) return 0;

	//如果武器处于内存中
	if( !owner = environment())
	{
		destruct(equip);
		return 0;
	}

	if( !owner->is_character() ) return 0;

	if( equip->query("equipped")) return 1;

	if(equip->query_xy() && equip->query("max_lasting") <= 1)
	{
		return notify_fail("装备已损坏。\n");
	}

	//判断是否可以装备(以后武装备型增多，需要修改)
	armor_prop = equip->query("weapon_prop");
	if(mapp(armor_prop)) return notify_fail(this_object()->name()+"是武器，不是护具，你只能穿戴可当作护具的东西。\n");

	armor_prop = equip->query("armor_prop");
	if(!mapp(armor_prop)) return notify_fail("你只能穿戴可当作护具的东西。\n");

	if(equip->query("level") > owner->query_level())
	{
		return notify_fail(sprintf( "装备%s得要 %d 级。\n", equip->query("name"),equip->query("level")));
	}
	if(equip->query("exp") > owner->query("combat_exp"))
	{
		return notify_fail(sprintf( "装备%s得要 %d 经验值。\n", equip->query("name"),equip->query("exp")));
	}
	if(query("gender") && (query("gender") != owner->query("gender") && query("gender") != "无性" && query("gender") != "男、女"))
	{
		return notify_fail(sprintf("你不能穿戴%s装备。\n",query("gender")));
	}
	if(equip->query("jianding") && equip->query("jianding") < 2)
	{
		return notify_fail("装备还没鉴定，不能装备。\n");
	}
	if(equip->query("locktime") && equip->query("locktime") < time())
	{
		return notify_fail("装备已经过期，请做丢弃处理。\n");
	}
	//需要装备时才计算时间
	//time()+24*3600*X    X是天数
	if(equip->query("need_time") && !equip->query("locktime"))
	{
		equip->set("locktime",time()+24*3600*equip->query("need_time"));
		equip->delete("need_time");
	}
	//交换装备
	type = equip->query("armor_type");
	if(owner->query_temp(sprintf("armor/%s", type)))
	{
		equip_id = owner->query(sprintf("armor/%s/equip_id",type));
		if(equip_id) equip_1 = present(equip_id);

		if(equip_id == equip->query("id")) return 0;  //如果是同一件装备 
		if(equip_1) equip_1->unequip();
	}

	owner->set_temp(sprintf("armor/%s",type),equip);  //记录武器类型
	owner->set(sprintf("armor/%s/equip_id",type),equip->query("id"));  //记录武器ID

	//防御力计算
	if(!armor_prop) return 0;   //兼容之前的
	apply = keys(armor_prop);
	applied_prop = owner->query_temp("apply");
	if(!mapp(applied_prop)) applied_prop = ([]);

	for(int i = 0; i<sizeof(apply); i++)
	{
		if( undefinedp(applied_prop[apply[i]]) )
		{
			applied_prop[apply[i]] = armor_prop[apply[i]];
		}
		else applied_prop[apply[i]] += armor_prop[apply[i]];
	}
	owner->set_temp("apply", applied_prop);

	//装备纪录为已经装备
	set("equipped", "worn");
	owner->set(sprintf("shiyong/%s",type),this_object()->query("id"));

	//重算属性加成
	count_equip_apply(owner,equip,equip_1 );
	return 1;
}

int wield()
{
	object owner, old_weapon,equip;
	mapping weapon_prop;
	string *apply;
	int flag;

	// Only character object can wear armors.
	//如果武器处于内存中
	equip = this_object();
	if( !owner = environment())
	{
		destruct(equip);
		return 0;
	}

	if( !owner->is_character() ) return 0;
	
	// If already wielded, just recognize it.
	if( query("equipped") ) return 1;
	
	// Check if we have "weapon_prop" defined.
	if( !mapp(weapon_prop = query("weapon_prop")) ) return notify_fail("你只能装备可当作武器的东西。\n");

	if(equip->query_xy() && equip->query("max_lasting") <= 1)
	{
		return notify_fail("武器已损坏。\n");
	}

	if(equip->query("level") > owner->query_level())
	{
		return notify_fail(sprintf( "装备%s得要 %d 级。\n", equip->query("name"),equip->query("level")));
	}
	if(equip->query("exp") > owner->query("combat_exp"))
	{
		return notify_fail(sprintf( "装备%s得要 %d 经验值。\n", equip->query("name"),equip->query("exp")));
	}
	if(query("gender") && (query("gender") != owner->query("gender") && query("gender") != "无性" && query("gender") != "男、女"))
	{
		return notify_fail(sprintf("你不能装备%s装备。\n",query("gender")));
	}
	if(equip->query("jianding") && equip->query("jianding") < 2)
	{
		return notify_fail("装备还没鉴定，不能装备。\n");
	}
	if(equip->query("locktime") && equip->query("locktime") < time())
	{
		return notify_fail("装备已经过期，请做丢弃处理。\n");
	}

	flag = query("flag");  // 双手武器标志 1:必须双手才能装备,2:可以不同手装备
	if( flag & TWO_HANDED )
	{
	        if( owner->query_temp("weapon") ||  owner->query_temp("secondary_weapon") ||  owner->query_temp("armor/shield") )
	        {
			return notify_fail("你必须空出双手才能装备双手武器。\n");
		}
	        owner->set_temp("weapon", this_object());
		owner->set_temp("secondary_weapon",this_object());
	}
	else
    	{
		// If we are are using any weapon?
		if( !(old_weapon = owner->query_temp("weapon")) ) owner->set_temp("weapon", this_object());

		// If we still have a free hand? 
		else if( !owner->query_temp("secondary_weapon") &&  !owner->query_temp("armor/shield") )
		{
            		// If we can wield this as secondary weapon?
            		if(flag & SECONDARY)
            		{
                		owner->set_temp("secondary_weapon", this_object());
                		owner->set("shiyong/secondary_weapon",this_object()->query("id"));
                	}
                	// If we can switch our old weapon to secondary weapon ?
                	else if( (int)old_weapon->query("flag") & SECONDARY )
			{
				old_weapon->unequip();
				owner->set_temp("weapon", this_object());
				old_weapon->wield();
				owner->set("shiyong/weapon",this_object()->query("id"));
			}
			// We need unwield our old weapon before we can use this one.
			else return notify_fail("你必须先放下你目前装备的武器。\n");
		}
		// We have both hands wearing something.
		else return notify_fail("你必须空出一只手来使用武器。\n");
	}
	apply = keys(weapon_prop);
	for(int i = 0; i<sizeof(apply); i++)
	{
		owner->add_temp("apply/" + apply[i], weapon_prop[apply[i]]);
	}
	owner->reset_action();
	set("equipped", "wielded");
	count_equip_apply(owner,this_object());
	owner->set("shiyong/weapon",this_object()->query("id"));
	return 1;
}

int unequip()
{
	object owner,s_weapon;
	mapping prop, applied_prop;
	string *apply, equipped;

	if( !(owner = environment())->is_character() ) return 0;
	if( !stringp(equipped = query("equipped")) ) return notify_fail("你目前并没有装备这样东西。\n");
	if( equipped=="wielded" )
	{
	        if( (object)owner->query_temp("weapon") == this_object() )
	        {
			owner->delete_temp("weapon");
			if( (object)owner->query_temp("secondary_weapon") == this_object() )
			{
				owner->delete_temp("secondary_weapon");
			}
			if (objectp(s_weapon=owner->query_temp("secondary_weapon")))
			{
				s_weapon->unequip();
				s_weapon->wield();
			}
		}
		else if( (object)owner->query_temp("secondary_weapon") == this_object() )
		{
			owner->delete_temp("secondary_weapon");
		}
	prop = query("weapon_prop");
	owner->reset_action();
        
	}
	else if( equipped=="worn" )
	{
		owner->delete_temp("armor/" + query("armor_type") );
		prop = query("armor_prop");
	}
	apply = keys(prop);
	applied_prop = owner->query_temp("apply");
	for(int i = 0; i<sizeof(apply); i++)
        // To support array apply, we cannot add_temp() here.
	applied_prop[apply[i]] -= prop[apply[i]];
	delete("equipped");

	count_equip_apply(owner,this_object());

	return 1;
}

//reast all index
varargs void count_equip_apply( object me, object equip, object equip2 )
{
	object item;
	int hp, neili, ap, dp, cps, pp, dex, str, con, ints, jingli, jing;

	//判断装备1 有哪些属性
        if( item = equip )
        {
                if( item->query("hp")  )               hp     = 1;  //气血
                if( item->query("jingli") )            jingli = 1;  //精力
                if( item->query("jing") )              jing   = 1;  //精气
                if( item->query("ap")  )               ap     = 1;  //魔法攻击
                if( item->query("dp")  )               dp     = 1;  //物理防御
                if( item->query("pp")  )               pp     = 1;  //魔法防御
                if( item->query("cp") )                cps    = 1;  //物理攻击
                if( item->query("mp")
                    || item->query("neili") )          neili  = 1;  //内力
        }

	//判断装备2 有哪些属性
        if( item = equip )
        {
                if( item->query("hp")  )               hp     = 1;  //气血
                if( item->query("jingli") )            jingli = 1;  //精力
                if( item->query("jing") )              jing   = 1;  //精气
                if( item->query("ap")  )               ap     = 1;  //魔法攻击
                if( item->query("dp")  )               dp     = 1;  //物理防御
                if( item->query("pp")  )               pp     = 1;  //魔法防御
                if( item->query("cp") )                cps    = 1;  //物理攻击
                if( item->query("mp")
                    || item->query("neili") )          neili  = 1;  //内力
        }
//属性重算
//-----------------------------------------------------------------------------------
	if(hp    ) USER_ENERGY_D->count_hp(me);        //气血
	if(jingli) USER_ENERGY_D->count_jingli(me);    //精力
	if(jing  ) USER_ENERGY_D->count_jing(me);      //精气
	if(ap    ) USER_ENERGY_D->count_ap(me);        //魔法攻击
	if(dp    ) USER_ENERGY_D->count_dp(me);        //物理防御
	if(pp    ) USER_ENERGY_D->count_pp(me);        //魔法防御
	if(cps   ) USER_ENERGY_D->count_cp(me);        //物理攻击
	if(neili ) USER_ENERGY_D->count_neili(me);     //内力
/*
	if(me->query("eff_qi") > me->query_max_hp())
	{
		me->set("qi",me->query_max_hp());
		me->set("eff_qi",me->query_max_hp());
	}
	if(me->query("eff_jing") > me->query_max_jing())
	{
		me->set("jing",me->query_max_jing());
		me->set("eff_jing",me->query_max_jing());
	}
	if(me->query("neili") > me->query_max_neili()) me->set("neili",me->query_max_neili());
*/
}
