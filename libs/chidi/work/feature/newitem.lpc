// newitem.c 新道具

#include <dbase.h>
#include <ansi.h>
#include <name.h>
#include <move.h>
#include <command.h>

inherit F_OBSAVE;
//inherit F_NOCLONE;

int is_item_make() { return 1; }

#define	LEVEL1		1
#define	LEVEL2		2
#define	LEVEL3		3
#define	LEVEL4		4
#define	LEVEL5		5
#define	LEVEL6		6
#define	LEVEL7		7
#define MAX_LEVEL       LEVEL7

nosave int *levels = ({ LEVEL1, LEVEL2, LEVEL3, LEVEL4,
                        LEVEL5, LEVEL6, LEVEL7});

nosave int performing  = 0;
nosave int attack_lvl  = 0;
nosave int defense_lvl = 0;

string chinese_s(mixed arg)
{
      if (! stringp(arg))return "无";
      if (arg == "cold")return HIW "冰";
      if (arg == "fire")return HIR "火";
      if (arg == "magic")return HIY "魔";
      if (arg == "lighting")return HIM "电";
}

// 武器的主人ID - 通过文件的名字来判断
string item_owner()
{
        string owner;
        if (sscanf(base_name(this_object()), ITEM_DIR"%*s/%s-%*s", owner))
                return owner;
        return 0;
}

// 判断该武器是否被当前某人所持有
int is_not_belong_me(object me)
{
        string user;

	user = query("user");
        if (! user || ! sscanf(user, "%*s(" + me->query("id") + ")"))
                return 1;

        return 0;
}

// 武器装备的等级
int weapon_level()
{
        mapping o;
        string *ks;
        int lvl;
        int i;

        lvl = 0;
        o = query("owner");
        if (mapp(o))
        {
                ks = keys(o);
                for (i = 0; i < sizeof(ks); i++)
                        lvl += o[ks[i]];
        }
       
        if (lvl > MAX_LEVEL) lvl = MAX_LEVEL;        
        return lvl;
}

// 防御装备的等级
int armor_level()
{
        // More to be added
        return 0;
}

// 武器装备的长描述
string weapon_long()
{
        string  n;
        int c;
        int type;
        int k;
        int lvl;
        string tessera_name;
        string result;

        c = query("sj_lvl",1);       
        n = query("unit") + name();
        if (! c)
                return "这" + n + "是無法進化的。\n";
        if (c)
        {
                result = HIY + name() + HIY "的等级：" + c + "/13\n" NOR;
        }

              result += "-------------------------------------\n";             
              result += HIW "物理防禦： " + query("armor_prop/armor") + "\n" NOR;
              result += HIW "進化次数： " + query("sj_lvl") + "\n" NOR;
              if (query("armor_prop/attack1"))
              result += HIW "追加傷害： " + query("armor_prop/attack1")+ "\n" NOR;
              if (query("armor_prop/defense1"))
              result += HIW "追加躲避： " + query("armor_prop/defense1")+ "\n" NOR; 
              if (query("armor_prop/intelligence"))             
              result += HIW "追加悟性： " + query("armor_prop/intelligence") + "\n" NOR;          
              if (query("armor_prop/dexerity"))    
              result += HIW "追加身法： " + query("armor_prop/dexerity") + "\n" NOR;
              if (query("armor_prop/constitution"))
              result += HIW "追加根骨： " + query("armor_prop/constitution") + "\n" NOR;
              if (query("armor_prop/strength"))
              result += HIW "追加臂力： " + query("armor_prop/strength") + "\n" NOR;
              if (query("armor_prop/karma"))
              result += HIW "追加福缘： " + query("armor_prop/karma") + "\n" NOR;
              if (query("armor_prop/personality"))
              result += HIW "追加容貌： " + query("armor_prop/personality") + "\n" NOR;
              if (query("armor_prop/dodge"))
              result += HIW "追加轻功： " + query("armor_prop/dodge") + "\n" NOR;
              if (query("armor_prop/force"))
              result += HIW "追加内功： " + query("armor_prop/force") + "\n" NOR;
              if (query("magic/power"))
              result += HIW "魔法攻击： " + query("magic/power") + "\n" NOR;
              if (query("magic/type"))
              result += HIW "魔法属性： " + chinese_s(query("magic/type"))  + "\n" NOR;
              result += "-------------------------------------\n";

        return result;
}

// 是普通武器装备
int is_weapon()
{
        return stringp(query("skill_type"));
}

// 是空手武器装备
int is_unarmed_weapon()
{
        return query("armor_type") == "hands";
}

// 道具的长描述
string item_long()
{
        //if (is_weapon() || is_unarmed_weapon())
                return weapon_long();

        return "";
}

// 武器装备的伤害值
int apply_damage()
{
        int d;
        int p;

        attack_lvl = weapon_level();
        p = query("point") / 2;
        d = attack_lvl * p / MAX_LEVEL + query("sj_lvl") * 2; // 進化一次增加2点攻击
        return d + p;
}

// 防御装备的有效值
int apply_armor()
{
        int d;
        int p;

        defense_lvl = armor_level();
        p = query("point");
        if (d > p * 3 / 2) d = p * 3 / 2 + query("sj_lvl") * 2;// 進化一次增加2点防御
        return d + p;
}

// 进行保存数据的接口函数
mixed save_dbase_data()
{
        mapping data;
        object  user;

        data = ([ "sj_lvl" : query("sj_lvl"),
                  "magic"  : query("magic"),
                  "armor_prop"  : query("armor_prop")
                  //"express" : query("express"), 
                  //"stype" : query("stype"), 
                  //"ctype" : query("ctype"), 
                  //"material"       : query("material"),
                  //"type"      : query("type")
]);

        if (! (user = environment()))
                data += ([ "user" : query("user") ]);
        else
        if (userp(user))
                data += ([ "user" : user->name(1) + "(" + user->query("id") + ")" ]);

        return data;
}

// 接受存盘数据的接口函数
int receive_dbase_data(mixed data)
{
        if (! mapp(data))
                return 0;

        if (intp(data["sj_lvl"]))
                set("sj_lvl", data["sj_lvl"]);

        if (mapp(data["magic"]))
                set("magic", data["magic"]);

        if (mapp(data["armor_prop"]))
                set("armor_prop", data["armor_prop"]);

        if (stringp(data["user"]))
                set("user", data["user"]);

        //if (! undefinedp(data["express"]))
        //        set("express", data["express"]);

        //if (intp(data["material"]))
       //         set("material", data["material"]);
 
        //if (mapp(data["stype"]))
        //        set("stype", data["stype"]);

        //if (mapp(data["ctype"]))
        //        set("ctype", data["ctype"]);

        //if (mapp(data["type"]))
        //        set("type", data["type"]);


        return 1;
}

// 读取存盘的数据
int restore()
{
        int r;

        if (base_name(this_object()) + ".lpc" == __FILE__)
                return 0;

        r = ::restore();
        set("no_sell", 1);
        set("no_drop", 1);
        set("no_put",1);       
        set("no_give",1);  
        set("no_get",1);                   
        return r;
}

// 保存数据
int save()
{
	int res;

        if (base_name(this_object()) + ".lpc" == __FILE__)
                return 0;

	return ::save();
}

//int query_autoload() { return (query("equipped") ? query("equipped") : "kept"); }

// 呼唤物品
int receive_summon(object me)
{
	return ITEM_D->receive_summon(me, this_object());
}
//隐藏物品
int hide_anywhere(object me)
{
        return ITEM_D->hide_anywhere(me, this_object());
}
// 镶嵌物品
int do_enchase(object me, object tessera)
{
        return ITEM_D->do_enchase(me, this_object(), tessera);
}
//自动穿戴
void autoload(string parameter)
{
        switch (parameter)
        {
        case "worn":
                this_object()->wear();
                break;

        case "wielded":
                this_object()->wield();
                break;
        }
}
void owner_is_killed() { destruct(this_object()); }
