// 函数：准备保存资料
void prepare_save() {
  object me = this_object();
  me->save_inventory();  //保存身上道具
  //保存宠物
  //保存eff症状效果
}

int save() {
  object me = this_object();
  string file;
  //GM不用存盘
  //if(wizardp(me)) return 1;
  if (stringp(file = this_object()->query_save_file())) {
    assure_file(file);
    prepare_save();  //过一遍装备 整理数组
    return save_object(file);
  }
  return 0;
}

int restore() {
  object me = this_object();
  string file;
  int flag = 0;

  file = this_object()->query_save_file();

  if (!stringp(file)) return 0;
  flag = restore_object(file);
  //读取eff效果
  //if( !arrayp(Effect) ) Effect = ({ });
  return flag;
}
