// filename : /inherit/char/pawn.c
//Modified and annotated by lonely@wmkj
// 此文件来自jackyboy,由于jackyboy的redeem()太长了看不懂,只好自己编了个短的
// 不知有没有漏洞
#include <ansi.h>
//inherit F_DEALER;暂时取消

int do_pawn(string arg)  //典当
{
  object me, ob;
  string str, *nopawn;
  int value;

  nopawn = ({ "coin", "silver", "gold", "cash", "thousand-cash",
    "hundred-cash", "mailbox", "box" });
  //不能当物品id阵列
  if (!arg || arg == "")
    return notify_fail("你要典当什么？\n");
  me = this_player();
  if (!undefinedp(me->query("pawn", 1)))
    if (sizeof(me->query("pawn")) > 99)
      return notify_fail("你典当的各种物品太多了。\n");
  if (!objectp(ob = present(arg, me)))
    return notify_fail("你好像没有这样东西吧。\n");

  if (ob->query("item_origin"))
    return notify_fail("本店不收半成品。\n");
  if (ob->query("money_id"))
    return notify_fail("你想当「钱」？？\n");
  if (ob->query("food_supply"))
    return notify_fail("我可不是养猪的，要你的剩菜剩饭干什么？\n");
  if (member_array(arg, nopawn) != -1 || ob->query("nopawn") == 1)
    return notify_fail("本店不收这样东西。\n");
  if ((ob->query("enpawn") == 0) && (living(ob) || ob->query_temp("block_msg/all") == 1))
    //如果"enpawn"属性不为0，且此物是角色(昏迷中)则可当,jackboy用此来当木人?!真的papaya！
    return notify_fail(HIW + "这个东西是活的呀？！怎么当嘛，真够papaya的了！\n" + NOR);
  value = ob->query("value");

  /*由于一些物品，没有设置value,所以无法典当，但是又很有用，所以暂时注释这几句
	   如果允许这里，请注意enpawn属性也应该判断一下
	if(value<30)
		return notify_fail("这是什么垃圾？居然也拿来典当!\n");
	*/

  //典当值value的60%！
  me->get_money(value * 60 / 100);
  //get_money按值给钱

  //str保存基本文件名
  str = base_name(ob);
  ////base_name定义在simul_efun/file.c中，用以返回此物件的真实档案名
  str = replace_string(str, "/", "|");  //注意："\\"即"\"!
  //避免出错！即在map里存map!
  //用|代替/，避免与mapping中的/搞错,

  me->add("pawn/" + str, 1);  //保存数量(+1)

  message_vision(
    "$N以" + CHINESE_D->price_str(value * 60 / 100) + "的" + YEL + "价钱" + NOR "把" + ob->query("name") + "典当了。\n",
    me
  );
  destruct(ob);
  return 1;
}

int do_redeemp(string target)  //赎玩家
{
  object me, ob, dest;

  me = this_player();
  ob = this_object();
  if (!target || target == "")
    return notify_fail(ob->query("name") + "俯到你的耳边悄声问道：你要赎什么人？\n");
  if (!objectp(dest = find_player(target)))
    //find_player() - 用名字寻找一个玩家
    return notify_fail(HIR + "玩家(" + target + ")目前似乎不在线上！\n" + NOR);
  if (!dest->query("selled"))
    return notify_fail(ob->query("name") + "急道：你可别诬陷好人，我怎么会非法扣押玩家呢！\n");
  switch (me->pay_money(dest->query("per") * 700, 0)) {
    case 0:
      return notify_fail("没钱还想赎人？信不信我把你给卖了！\n");
    case 2:
      return notify_fail("您的零钱不够了，银票又没人找得开。\n");
    default:
      message_vision(HIG + "$N从$n那里赎回了" + dest->query("name") + "。\n" + NOR, me, ob);
      dest->move(environment(ob));
      dest->set("startroom", base_name(environment(ob)));
      dest->delete("selled");
      message("vision", HIY + "只听见嗖的一声，一个遍体鳞伤的家伙从天花板上掉了下来！\n" + NOR,
        environment(dest), dest);
      tell_object(dest, "你被" + HIC + me->query("name") + NOR + "赎了出来。\n");
  }
  return 1;
}

string getname(string target)  //返回典当物品的名称
{
  string temp;
  object ob = new(target);
  temp = implode(ob->parse_command_id_list(), ",");
  //implode() - 连结多个字串.
  temp = ob->query("name") + " (" + temp + ")";
  destruct(ob);
  return temp;
}

object is_pawn(string goods, string *pawn)  //用于判断goods是否为可赎物品
{
  object ob;
  int i;

  for (i = sizeof(pawn) - 1; i >= 0; i--) {
    ob = new(replace_string(pawn[i], "|", "/"));
    if (ob->id(goods))
      return ob;
    destruct(ob);
  }
  return 0;
}

int do_redeem(string target)  //赎东西
{
  object dest, me, ob;
  int i;
  mapping pawn;
  string *pawns, str = "";

  me = this_player();
  ob = this_object();
  pawn = me->query("pawn");  //取出当过的物品文件名阵列
  if (!mapp(pawn) || !sizeof(pawn))
    return notify_fail("你没有当过任何物品。\n");

  pawns = keys(pawn);
  if (!target)  //没有target则对典当品进行列表
  {
    for (i = sizeof(pawns) - 1; i >= 0; i--)
      str += sprintf(
        "%30-s" + WHT + "数量：" + HIG + "%3-i" + NOR + "\n",
        getname(replace_string(pawns[i], "|", "/")),
        me->query("pawn/" + pawns[i])
      );
    tell_object(me, "你目前当了的物品有：\n" + str);
    return 1;
  }
  if (dest = is_pawn(target, pawns))  //如果target是典当品的id，则执行下面这段程序
  {
    switch (me->pay_money(dest->query("value"), 0)) {
      case 0:
        return notify_fail("没钱还想赎东西？\n");
      case 2:
        return notify_fail("本店本小，找不开您老的银票，您给想想办法？\n");
      default:
        message_vision(
          CYN + "$N花了" + CHINESE_D->price_str(dest->query("value")) + CYN + "从$n那里赎回了" + (ob->query("unit") ? ("一" + dest->query("unit")) : "") + dest->query("name") + "。\n" + NOR,
          me,
          ob
        );
        str = base_name(dest);
        str = replace_string(str, "/", "|");
        me->add("pawn/" + str, -1);
        if (me->query("pawn/" + str) <= 0)
          me->delete("pawn/" + str);
        dest->move(me);
        return 1;
    }
  } else
    return notify_fail("你要赎什么？(格式：redeem id)\n");
}
