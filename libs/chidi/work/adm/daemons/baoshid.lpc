// modi by tomcat 

#include <ansi.h>

inherit F_DBASE;
int random_place(string dirss,object bs);

string *dirs = ({
"/d/changan",
"/d/city",
"/d/baitou",
"/d/guanwai",
"/d/xueshan",
"/d/city2",
"/d/city3",
"/d/huashan",
"/d/quzhou",
"/d/dali",
"/d/mingjiao",
"/d/lingxiao",
"/d/shaolin",
});

string *dirname = ({
"长安城",
"扬州城",
"白驮山庄",
"关外",
"雪山寺",
"北京城",
"成都城",
"华山派",
"泉州城",
"大理城",
"明教",
"凌霄城",
"少林寺",

});


void create()
{
        seteuid(ROOT_UID);
        set("channel_id", "内存精灵");
        CHANNEL_D->do_channel( this_object(), "sys", "宝石系统已经启动。\n"); 
        set("name","baoshis");
        call_out("choose_baosi",10);
}

void choose_baosi()
{
        int i, j ,k,ppl,rd;
        object *list,newob;
        string str,m_name;
        string smp;
        
        remove_call_out("choose_baosi"); 
        j = random(sizeof(dirs));
        rd = random(3);
        if(rd==0) 
        {
        	 newob = new("/clone/misc/newitem/tm_stone");
                 str = "蓝";
        }
        if(rd==1) 
        {
        	 newob = new("/clone/misc/newitem/ts_stone");
                 str = "绿";
        }
        if(rd==2)
        { 
        	newob = new("/clone/misc/newitem/xy_stone");
                 str = "黄";
        }
        	
        
        if(random_place(dirs[j],newob)== 1 )
        message("channel:chat",HIG"【"+HIR"奇珍异宝"+HIG"】"+HIW"突然空中打了个炸雷,一个火球横空出世,拖着一道"+str+"光向"+dirname[j]+"的方向落去!\n"+NOR,users());
        call_out("choose_baosi",900);
        return ;
}

int random_place(string dirss,object bs)
{
        int  j, k;
        object  newob,ob;
        mixed*  file, exit;
        string id_name;
        file = get_dir( dirss+"/npc/*.lpc", -1 );
        
        if( !sizeof(file) ) return 0;

        for(k=0;k<50;k++) { // try 50 times
           j = random(sizeof(file));
           if( file[j][1] > 0 ) {
             newob=load_object(dirss+"/npc/"+file[j][0]);
             if(!newob) continue;
             id_name = newob->query("id");
             destruct(newob);
             if(!id_name) continue;
             if(!objectp(ob=find_living(id_name))) continue; //这个npc不是活的 
                     if(bs->move(ob)) {
                    CHANNEL_D->do_channel( this_object(), "sys", "宝石落到了"+ob->query("name")+"("+ob->query("id")+")的身上。\n"); 
                     return 1;
                    }
             }
           }
         CHANNEL_D->do_channel( this_object(), "sys", "本次宝石发布失败\n");        
        return 0;
}

   
