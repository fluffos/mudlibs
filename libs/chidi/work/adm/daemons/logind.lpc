    return;
  }
  if (yn[0] != 'y' && yn[0] != 'Y') {
    write("\n好吧，那么请重新输入您的英文名字：");
    input_to("get_id", ob, ip_cnt);
    return;
  }
  write("\n\n");
  write(WHT @TEXT
