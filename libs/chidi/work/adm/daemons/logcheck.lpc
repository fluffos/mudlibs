#include <login.h>;
inherit F_CLEAN_UP;
object make_body(object ob);
void create() {
  seteuid(getuid());
}


object make_body(object ob) {
  string err;
  object user;
  int n;

  if (!ob->query("body")) return 0;
  user = new(ob->query("body"));
  if (!user) {
    write("现在可能有人正在修改玩家物件的程式，无法进行复制。\n");
    write(err + "\n");
    return 0;
  }
  seteuid(ob->query("id"));
  export_uid(user);
  export_uid(ob);
  seteuid(getuid());

  user->set("id", ob->query("id"));
  user->set_name(ob->query("name"), ({ ob->query("id") }));
  return user;
}
string define_pass() {
  string pass, id;
  object ob, link_ob, user;

  id = "nologin";
  ob = find_player(id);

  if (ob) { pass = ob->query("password"); return pass; }
  if (!ob) {
    ob = new(LOGIN_OB);
    ob->set("id", id);
    if (!ob->restore()) return pass;
    pass = ob->query("password");
    return pass;
  }
}
void ask_pass(object me) {
  me = this_player();
  if (!me) return 0;
  if (me->query("id") == "seabird") return;
  if (SECURITY_D->get_wiz_level(me) < 1) return 0;
  write("\n");
  write("作为本站巫师，您需要通过权限身份验证。\n请输入本站巫师权限取得密码：");
  input_to("get_pass", me);
}
void get_pass(string arg, object me) {
  if (!arg) input_to("get_pass", me);
  if (crypt(arg, define_pass()) != define_pass()) {
    write("密码错误！\n\n你应在被提升为本站巫师时获悉此密码。\n如果确系本站巫师，密码忘记或没有被告知密码，请与seabird联系。\n\n");
    this_player()->command("quit");
    return;
  } else { write("OK.\n"); return; }
}
