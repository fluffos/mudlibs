string npcname;
string npcfid;
string npcid;

void createname();


void create()
{
        seteuid(getuid());

}

void buildroom(object me,string s_title,string l_title, string dir,int rec)
{
mapping pairs = ([
        "north":                "south",
        "south":                "north",
        "east":                 "west",
        "west":                 "east",
        "northup":              "southdown",
        "southup":              "northdown",
        "eastup":               "westdown",
        "westup":               "eastdown",
        "northdown":            "southup",
        "southdown":            "northup",
        "eastdown":             "westup",
        "westdown":             "eastup",
        "northeast":            "southwest",
        "northwest":            "southeast",
        "southeast":            "northwest",
        "southwest":            "northeast",
        "up":                   "down",
        "down":                 "up"
]);

        object env;
		object lingpai;
        string this_file;
        string my_file;
        string name;
		object myroom;
        string c_name;
		string stroutdoor;

		string npc_file;
		string npc_name;
		int    inpcnum;

		npc_file = "";
		npc_name = "";
		inpcnum = 0;

        name = (string)me->query("id")+sprintf("%d",time());
        c_name = base_name(environment(me))+".lpc";
        this_file = read_file(c_name);
        this_file = replace_string(this_file,"set(\"exits\", ([",
			"set(\"exits\", ([\n"+"\""+dir+"\""+" : \"/p/residence/"+name+"\",");   
        if(!write_file(c_name,this_file,1))
			return;

        environment(me)->set("exits/"+dir,"/p/residence/"+name);

		lingpai = new("clone/misc/lingpai");
		lingpai->create( me->query("banghui/name") );
		lingpai->add("created_room",1);
        switch(rec)
		{
        case 1:				//普通房	finish
			my_file = read_file("/d/banghui/room/general_room.o");
			break;
        case 2:				//休息室	finish
			my_file = read_file("/d/banghui/room/rest_room.o");
			lingpai->add("rest_room",1);

			break;
        case 3:				//铁匠铺	finish
			my_file = read_file("/d/banghui/room/weapon_room.o");
			lingpai->add("weapon_room",1);
	
			npc_file = read_file("/d/banghui/npc/tiejiang.lpc");
			createname();
			npc_file = replace_string(npc_file,"CLYOWNER",me->query("banghui/name"));
			npc_file = replace_string(npc_file,"CLYNAME",npcname);
			npc_file = replace_string(npc_file,"CLYFULLID",npcid);
			npc_file = replace_string(npc_file,"CLYFIRSTID",npcfid);
			npc_name = "/p/residence/"+name+"bhnpc.lpc";
			write_file(npc_name,npc_file,1);

			inpcnum = 1;

			break;
        case 4:				//练功房    finish
			my_file = read_file("/d/banghui/room/lian_room.o");
			lingpai->add("lian_room",1);

			npc_file = read_file("/d/banghui/npc/bhniu.lpc");
			createname();
			npc_file = replace_string(npc_file,"CLYOWNER",me->query("banghui/name"));
			npc_file = replace_string(npc_file,"CLYNAME",npcname);
			npc_file = replace_string(npc_file,"CLYFULLID",npcid);
			npc_file = replace_string(npc_file,"CLYFIRSTID",npcfid);
			npc_name = "/p/residence/"+name+"bhnpc.lpc";
			write_file(npc_name,npc_file,1);

			inpcnum = 3;

			break;
        case 5:				//工作房	finish
			my_file = read_file("/d/banghui/room/job_room.o");
			lingpai->add("job_room",1);

			npc_file = read_file("/d/banghui/npc/zhanglao1.lpc");
			createname();
			npc_file = replace_string(npc_file,"CLYOWNER",me->query("banghui/name"));
			npc_file = replace_string(npc_file,"CLYNAME",npcname);
			npc_file = replace_string(npc_file,"CLYFULLID",npcid);
			npc_file = replace_string(npc_file,"CLYFIRSTID",npcfid);
			npc_name = "/p/residence/"+name+"bhnpc.lpc";
			write_file(npc_name,npc_file,1);

			inpcnum = 1;

			break;
        case 6:				//书院
			my_file = read_file("/d/banghui/room/lit_room.o");
			lingpai->add("lit_room",1);

			npc_file = read_file("/d/banghui/npc/zhanglao2.lpc");
			createname();
			npc_file = replace_string(npc_file,"CLYOWNER",me->query("banghui/name"));
			npc_file = replace_string(npc_file,"CLYNAME",npcname);
			npc_file = replace_string(npc_file,"CLYFULLID",npcid);
			npc_file = replace_string(npc_file,"CLYFIRSTID",npcfid);
			npc_name = "/p/residence/"+name+"bhnpc.lpc";
			write_file(npc_name,npc_file,1);

			inpcnum = 1;

			break;
        case 7:				//钱庄
			my_file = read_file("/d/banghui/room/bank_room.o");
			lingpai->add("bank_room",1);

			break;
        case 8:				//大门		finish
			my_file = read_file("/d/banghui/room/men_room.o");
			lingpai->add("men_room",1);
			lingpai->set("kickroom", c_name);
	
			npc_file = read_file("/d/banghui/npc/bhwei.lpc");
			createname();
			npc_file = replace_string(npc_file,"CLYOWNER",me->query("banghui/name"));
			npc_file = replace_string(npc_file,"CLYNAME",npcname);
			npc_file = replace_string(npc_file,"CLYFULLID",npcid);
			npc_file = replace_string(npc_file,"CLYFIRSTID",npcfid);
			npc_name = "/p/residence/"+name+"bhnpc.lpc";
			write_file(npc_name,npc_file,1);

			inpcnum = 4;
			break;
		case 9:				//擂台
			my_file = read_file("/d/banghui/room/fight_room.o");
			lingpai->add("fight_room",1);

			break;
        }

        my_file = replace_string(my_file,
"set(\"exits\", ([",
"set(\"exits\", ([\n"+"\""+pairs[dir]+"\""+" : "+"\""+c_name+"\",");
        my_file= replace_string(my_file,"SHORT_TITLE",s_title);
        my_file= replace_string(my_file,"LONG_TITLE",l_title);
        my_file= replace_string(my_file,"CLYKICKROOM",lingpai->query("kickroom"));

		if(stringp(me->query("banghui/name")))
		{
			my_file= replace_string(my_file,"CLYOWNER",me->query("banghui/name"));
		}
		my_file= replace_string(my_file,"CLYCREATEUSER",me->query("id"));

		if(inpcnum > 0)
		{
			my_file= replace_string(my_file,"set(\"objects\", ([",
				"set(\"objects\", ([\n"+"\""+npc_name+"\" : "+inpcnum+","); 
		}

		write_file("/p/residence/"+name+".lpc",my_file,1);

		lingpai->save();
		destruct(lingpai);

		write("房间修建完毕！！\n");
}

int touch_file(string name)
{
if(write_file(name," ",1))
return 1;
else return 0;
}

void createname()
{
	string id1,id2;
	string name1,name2;
	int index1,index2,index3;

	index1=random(sizeof(first_name));
	index2=random(sizeof(second_name1)); 
	name1=first_name[index1]["name"];
	name2=second_name1[index2]["name"];
	id1=first_name[index1]["id"];
	id2=second_name1[index2]["id"];

	if(random(10))
	{
		index3	=	random(sizeof(third_name1));
		name2	+=	third_name1[index3]["name"];
		id2		+=	third_name1[index3]["id"];
	}

	npcname	= name1+name2;
	npcfid	= id1;
	npcid	= id1+" "+id2;
}
