#include <ansi.h>
#include <skill.h>
inherit F_DBASE;

int time;
int wwtime;
int saytime;
int jobTime;

void call_time();
void add_exp(object me, object env);
void add_skill(object me, object env);
void add_weiwang(object me, int index);
void dest_weapon();
void check_job();

//函数：初始
void create() {
  seteuid(ROOT_UID);
  set("channel_id", "倚天屠龙");
  CHANNEL_D->do_channel(this_object(), "sys", "倚天屠龙事件系统已经启动。\n");
  //检查时间
  time = time() + 300;
  call_time();
  dest_weapon();
}

void call_time() {
  object blade, sword;

  if (time <= time()) {
    CHANNEL_D->do_channel(this_object(), "sys", "倚天屠龙事件系统开始自检。\n");
    //检查是否存在物品
    if (!blade = query("blade")) {
      //生成物品
      if (blade = new("/clone/weapon/dragonblade")) {
        set("blade", blade);
        __FILE__->give_gift(blade, HIW "\n“啪”的一声一柄屠龙刀掉到你面前。\n\n" NOR);
      }
    }
    if (!sword = query("sword")) {
      //生成物品
      if (sword = new("/clone/weapon/skysword")) {
        set("sword", sword);
        __FILE__->give_gift(sword, HIW "\n“啪”的一声一柄倚天剑掉到你面前。\n\n" NOR);
      }
    }
    //同步时间
    time = time() + 300;
    call_out("call_time", 280);
  }
  //循环
  else call_out("call_time", 10);
}

void give_gift(object ob, string msg) {
  int i;
  object env;
  object *players, player;
  string objName = ob->name();

  CHANNEL_D->do_channel(this_object(), "sys", sprintf("倚天屠龙事件系统开始发放%s。\n", objName));

  players = users();
  if (sizeof(players)) {
    for (i = 0; i < 5; i++) {
      player = players[random(sizeof(players))];
      if (wizardp(player)) continue;

      env = environment(player);
      while (env && env->is_character())
        env = environment(env);
      if (env) break;
    }
    if (i >= 5) {
      destruct(ob);
      return;
    }

    if (objectp(env)) {
      tell_room(env, msg);
      ob->move(env);
      if (objName == HIM "屠龙刀" NOR) CHANNEL_D->do_channel(
        this_object(),
        "chat",
        HIY "武林至尊 宝刀屠龙 号令天下 莫敢不从\n" NOR
      );
      else CHANNEL_D->do_channel(this_object(), "chat", HIY "倚天不出 谁与争锋\n" NOR);

      CHANNEL_D->do_channel(
        this_object(),
        "chat",
        sprintf(NOR HIY "%s" NOR WHT "掉到了" HIC "%s" NOR WHT "。\n" NOR, objName, env->query("short"))
      );
    }
  }
}

//武林至尊号令修炼
int call_do_training(object me, string arg) {
  object *users, env;
  int i, size, index;

  if (!arg) {
    tell_object(me, "\n指令格式：\n"
      "xunlian -- 获得指令帮助\n"
      "xunlian “信息” -- 武林至尊，尊贵频道向各路英雄发出信息，所有信者均可获得潜能。(不支持表情)，每次消耗5千点经验。\n"
      "xunlian over -- 结束训练(集会)\n"
      "xunlian exp -- 同房间ID可定时获得丰厚经验，每秒消耗5点潜能，20点经验。每分钟获得1点江湖威望。\n"
      "xunlian skill -- 让同房间ID习武，每秒消耗5点潜能，20点经验。每分钟获得1点江湖威望。\n"
      HIG "以上各项目人员越多效果越佳，潜能、经验消耗完毕便会自动结束聚会。\n" NOR
      "倚天、屠龙不可同时使用。\n"
    );
    return 1;
  }

  switch (arg) {
    case "over":
      if (query("xunlian")) {
        if (query("xunlian") != me) {
          tell_object(me, "你无权结束集会。\n");
          return 1;
        }
        delete("xunlian");
        remove_call_out("add_exp");
        remove_call_out("add_skill");
        //remove_call_out("add_weiwang");

        message(
          "channel:rumor",
          YEL "【武林至尊】" HIY + me->name() + "[" + me->query("id") + "]：此次聚会习武到此为止，望各路英雄勤加苦练，振兴武林。\n" NOR,
          users()
        );
        return 1;
      } else {
        tell_object(me, "你没有组织训练。\n");
        return 1;
      }
      break;
    case "exp":
    case "skill":
      if (query("xunlian")) {
        tell_object(me, "已经号令各路英雄训练。\n");
        return 1;
      }
      env = environment(me);
      if (!objectp(env)) return 1;
      if (!env->query("no_fight")) {
        tell_object(me, "此处龙蛇混杂，不宜聚会，得找个清静之地。");
        return 1;
      }
      wwtime = time() + 3;
      set("xunlian", me);
      if (arg == "exp") add_exp(me, env);
      else add_skill(me, env);

      //call_out("add_weiwang",60,me);
      break;
    default:
      if (query("xunlian")) {
        tell_object(me, "已经号令各路英雄训练。\n");
        return 1;
      }
      if (me->query_temp("xunlian/chat") < time()) {
        if (me->query("combat_exp") < 5000) {
          tell_object(me, "经验不足5千点。\n");
          return 1;
        }
        users = users();

        users -= ({ me });
        size = sizeof(users);
        index = 20 * size;
        if (index > 5000) index = 5000;
        for (i = 0; i < size; i++) { users[i]->add("potential", index); }

        message(
          "channel:rumor",
          YEL "【武林至尊】" HIY + me->name() + "[" + me->query("id") + "]：" + arg + "\n" NOR,
          users()
        );
        message("channel:rumor", HIG "武林至尊至信，顿觉凌云豪气，获得" + index + "点潜能。\n" NOR, users);
        me->add("combat_exp", -5000);
        me->set_temp("xunlian/chat", time() + 20);
      } else tell_object(me, "请不要频繁用此频道发送信息。\n");
      return 1;
  }

  return 1;
}

void add_exp(object me, object env) {
  int i, size, index;
  object *users;

  if (!me || !objectp(me) || !env || !objectp(env) || !query("xunlian")) return;

  if (me->query("potential") < 10) {
    call_do_training(me, "over");
    tell_object(me, "你的潜能不足。\n");
    return;
  }
  if (me->query("combat_exp") < 1000) {
    call_do_training(me, "over");
    tell_object(me, "你的经验不足。\n");
    return;
  }
  if (environment(me) != env) {
    call_do_training(me, "over");
    tell_object(me, "你离开了聚会。\n");
    return;
  }

  users = all_inventory(env);
  users -= ({ me });
  size = sizeof(users);

  index = me->query_level() / 2;
  if (index < 10) index = 10;
  else if (index > 50) index = 50;

  index *= size;
  if (index > 1000) index = 1000;
  index = 1 + random(index);

  for (i = 0; i < size; i++) {
    if (!objectp(users[i]) || !userp(users[i]) || users[i]->is_npc()) continue;

    users[i]->add("combat_exp", index);
    if (index / size <= 10)
      tell_object(users[i], sprintf(RED "此次武林聚会，略微受益获得%d点经验。\n" NOR, index));
    else if (index / size <= 30)
      tell_object(users[i], sprintf(HIY "此次武林聚会，受益颇多获得%d点经验。\n" NOR, index));
    else tell_object(users[i], sprintf(HIG "此次武林聚会，受益非浅获得%d点经验。\n" NOR, index));
  }
  if (wwtime <= time()) {
    add_weiwang(me, size);
    wwtime = time() + 3;
  }
  if (saytime <= time()) {
    message(
      "channel:rumor",
      YEL "【武林至尊】" HIY + me->name() + "[" + me->query("id") + "]：武林聚会已经开始，到〖" + env->query("short") + "〗的朋友可获得大量经验。\n" NOR,
      users()
    );
    saytime = time() + 1800;
  }
  me->add("potential", -5);
  me->add("combat_exp", -20);
  tell_object(
    me,
    sprintf(HIG "剩余潜能%d点，%d点经验。\n" NOR, me->query("potential", 1), me->query("combat_exp", 1))
  );
  call_out("add_exp", 2, me, env);
}

void add_skill(object me, object env) {
  int i, size, index, skill_level;
  object *users;
  mapping skl;
  string *skillName, skill, skill_name;

  if (!me || !objectp(me) || !env || !objectp(env) || !query("xunlian")) return;

  if (me->query("potential") < 10) {
    call_do_training(me, "over");
    tell_object(me, "你的潜能不足。\n");
    return;
  }
  if (me->query("combat_exp") < 1000) {
    call_do_training(me, "over");
    tell_object(me, "你的经验不足。\n");
    return;
  }
  if (environment(me) != env) {
    call_do_training(me, "over");
    tell_object(me, "你离开了聚会。\n");
    return;
  }

  users = all_inventory(env);
  users -= ({ me });
  size = sizeof(users);

  index = me->query_level() / 2;
  if (index < 10) index = 10;
  else if (index > 30) index = 30;

  index *= size;

  if (index > 6000) index = 6000;
  index = 1 + random(index);
  for (i = 0; i < size; i++) {
    if (!objectp(users[i]) || !userp(users[i]) || users[i]->is_npc()) continue;
    skl = users[i]->query_skills();
    if (!skl || !mapp(skl)) continue;
    skillName = keys(skl);
    skill = skillName[random(sizeof(skillName))];
    if (!skill_level = users[i]->query_skill(skill, 1)) continue;

    users[i]->improve_skill(skill, index);

    if (skill_name = SKILL_D(skill)->query_skill_name(skill_level))
      tell_object(
        users[i],
        sprintf(HIC "你听了旁人的指点，对%s的「%s」这一招似乎有些心得。\n" NOR, to_chinese(skill), skill_name)
      );
    else tell_object(users[i], sprintf(HIC "你听了旁人的指点，对「%s」似乎有些心得。\n" NOR, to_chinese(skill)));
  }
  if (wwtime <= time()) {
    add_weiwang(me, size);
    wwtime = time() + 3;
  }
  if (saytime <= time()) {
    message(
      "channel:rumor",
      YEL "【武林至尊】" HIY + me->name() + "[" + me->query("id") + "]：武林聚会已经开始，到〖" + env->query("short") + "〗的朋友可对自己的武功有更深的领悟。\n" NOR,
      users()
    );
    saytime = time() + 1800;
  }
  me->add("potential", -5);
  me->add("combat_exp", -20);
  tell_object(
    me,
    sprintf(HIG "剩余潜能%d点，%d点经验。\n" NOR, me->query("potential"), me->query("combat_exp"))
  );
  call_out("add_skill", 2, me, env);
}

void add_weiwang(object me, int index) {
  if (!me || !objectp(me)) return;

  if (!index && index < 3) {
    tell_object(me, HIY "无人响应，本次没有增加威望。\n" NOR);
    return;
  }
  index /= 10;
  if (index < 1 || index > 20) index = 1;
  me->add("weiwang", index);
  tell_object(me, HIY "你获得了大家的好评，江湖威望增加" + index + "点。\n" NOR);
  //	call_out("add_skill",60,me);
}

int heal(object me, string arg) {
  object player;

  if (!me) return 0;

  if (arg == "me") player = me;
  else if (!arg || !player = find_player(arg)) {
    tell_object(me, "你要救谁？\n");
    return 1;
  }
  if (environment(player) != environment(me)) {
    tell_object(me, "这里没有" + arg + "\n");
    return 1;
  }
  if (me->query("weiwang") < 20) {
    tell_object(me, "你江湖威望不足！\n");
    return 1;
  }
  if (player->is_busy()) {
    tell_object(me, "对方忙碌中，无法救治！\n");
    return 1;
  }
  //精力
  player->set("jingli", player->query_max_jingli());
  //精神
  player->set("eff_jing", player->query_max_jing());
  player->set("jing", player->query_max_jing());
  //内力
  player->set("neili", player->query_max_neili());
  //气血
  player->set("eff_qi", player->query_max_hp());
  player->set("qi", player->query_max_hp());

  //食物、饮水
  player->set("food", player->max_food_capacity());
  player->set("water", player->max_water_capacity());

  me->add("weiwang", -20);
  tell_room(
    environment(me),
    sprintf(
      HIY "疾步跑来一位侠士，急忙抚住" HIC "%s" HIY "的背部，为其疗伤。\n" NOR + HIG "侠士" NOR + YEL "说道：" NOR "我奉武林至尊之命前来相助，现在你已无大碍，小人告退。\n",
      player->name()
    )
  );
  return 1;
}

void dest_weapon() {
  object item, *weapon;
  int size, i;

  weapon = children("/clone/weapon/dragonblade");
  size = sizeof(weapon);
  if (size) for (i = 0; i < size; i++) {
    if (environment(weapon[i]) && objectp(environment(weapon[i])) && userp(environment(weapon[i]))) {
      tell_object(environment(weapon[i]), "你的屠龙刀不易而飞了。\n");
    }
    destruct(weapon[i]);
  }

  weapon = children("/clone/weapon/skysword");
  size = sizeof(weapon);
  if (size) for (i = 0; i < size; i++) {
    if (environment(weapon[i]) && objectp(environment(weapon[i])) && userp(environment(weapon[i]))) {
      tell_object(environment(weapon[i]), "你的倚天剑不易而飞了。\n");
    }
    destruct(weapon[i]);
  }
}

int job_info(object me, string arg) {
  int flag, addEXP;
  string jobName, itemName, itemID;
  object item;

  if (!arg || sscanf(arg, "%s %s(%s) %d", jobName, itemName, itemID, addEXP) != 4) {
    tell_object(me,
      "发布任务指令格式:\n"
      "任务名称 对象名称 对象ID 经验奖励(奖励必须大于1千)\n"
      HIG "探望星哥 周星星(xingxing) 1000\n" NOR
    );
    return 1;
  }

  if (query("job")) {
    tell_object(me, "已经有任务发布。\n");
    return 1;
  }
  if (addEXP < 1000) {
    tell_object(me, "经验奖励太少了。\n");
    return 1;
  }
  if (me->query("weiwang") < addEXP / 1000) {
    tell_object(me, "你的江湖威望太少了。\n");
    return 1;
  }

  if (stringp(itemID) && stringp(itemName)) {
    item = present(itemID, environment(me));
    if (!item) item = present(itemID, me);
    if (!item) item = find_player(itemID);
    if (!item || !objectp(item)) {
      tell_object(me, sprintf("很难见到%s(%s)。\n", itemName, itemID));
      return 1;
    }
    if (item->name() != itemName) {
      tell_object(me, sprintf("%s有其他的名字？%s和%s。\n", itemID, item->name(), itemName));
      return 1;
    }
  } else {
    tell_object(me, "输入错误，无法发布。\n");
    return 1;
  }

  set("job/name", jobName);
  set("job/itemName", itemName);
  set("job/itemID", itemID);
  set("job/addEXP", addEXP);
  set("job/post", me);

  me->add("weiwang", -addEXP / 1000);
  jobTime = time() + 180;
  //检查任务过期
  check_job();
  return 1;
}

void check_job() {
  object me, *user = users();

  if (!query("job")) return;
  if (!me = query("job/post")) {
    message("channel:rumor", YEL "【武林至尊】" HIY "：任务发布者已下线，任务被迫终止。\n" NOR, user);
    delete("job");
    return;
  }
  if (jobTime < time()) {
    message(
      "channel:rumor",
      YEL "【武林至尊】" HIY + me->name() + "[" + me->query("id") + "]：任务时限已到，无人完成任务。\n" NOR,
      user
    );
    delete("job");
    return;
  }
  message(
    "channel:rumor",
    YEL "\n\n【武林至尊】" HIY + me->name() + "[" + me->query("id") + "]：《" + query("job/name") + "》任务已经开始。\n" NOR,
    user
  );
  message(
    "channel:rumor",
    YEL "【武林至尊】" HIY + me->name() + "[" + me->query("id") + "]：请各路英雄找到 " + query("job/itemName") + "(" + query("job/itemID") + ") 。找到后用 fulfil " + query("job/itemID") + " 指令完成任务。\n" NOR,
    user
  );
  message(
    "channel:rumor",
    YEL "【武林至尊】" HIY + me->name() + "[" + me->query("id") + "]：找到者重赏 " + query("job/addEXP") + " 点经验,若无人找到，任务将在 三分钟 后取消。\n\n" NOR,
    user
  );
  call_out("check_job", 30);
}
