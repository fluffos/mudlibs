				case 8: item->add("weapon_prop/constitution",(40+random(level/2))/2); break;    //增加根骨
			}
		}
	}
	else
	{
		switch(random(9))
		{
			case 0: item->add("pp",40+random(level/2));                      break;    //追加防御
			case 1: item->add("dp",40+random(level/2));                      break;    //增加防御
			case 2: item->add("jing",40+random(level));                    break;    //增加体质
			case 3: item->add("jingli",40+random(level));                  break;    //增加攻击
			case 4: item->add("armor_prop/intelligence",(40+random(level/2))/100); break;    //增加悟性
			case 5: item->add("armor_prop/strength",(40+random(level/2))/2);     break;    //增加力量
			case 6: item->add("armor_prop/dexerity",(40+random(level/2))/2);     break;    //增加身法
			case 7: item->add("armor_prop/constitution",(40+random(level/2))/2); break;    //增加根骨
			case 8: item->add("hp",40+random(level));                      break;    //增加根骨
		}
		if(random(100) < 20)
		{
			switch(random(9))
			{
				case 0: item->add("pp",40+random(level/2));                      break;    //追加防御
				case 1: item->add("dp",40+random(level/2));                      break;    //增加防御
