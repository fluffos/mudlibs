void init_equip_prop_4(object item)
{
	int type,level,baoji;
	string _name;
	
	if( !clonep(item) ) return;    // 只对复制物品！
	
	level = (1+item->query("level"))*300;
	baoji = (15 + random((level/200)));

	//是武器类
	if(item->query("weapon_prop/damage"))
	{
		switch(random(9))
		{
			case 0: item->add("jingli",40+random(level));                   break;    //增加精力
			case 1: item->add("jing",40+random(level));                     break;    //增加精神
			case 2: item->add("mp",40+random(level));                       break;    //增加体质
			case 3: item->add("ap",40+random(level/100));                       break;    //增加攻击
			case 4: item->add("weapon_prop/baoji",baoji);                    break;    //增加爆击
			case 5: item->add("weapon_prop/intelligence",(40+random(level/2))/100); break;    //增加悟性
			case 6: item->add("weapon_prop/strength",(40+random(level/2))/2);     break;    //增加力量
			case 7: item->add("weapon_prop/dexerity",(40+random(level/2))/2);     break;    //增加身法
