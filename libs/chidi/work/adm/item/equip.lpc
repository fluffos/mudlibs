#include <ansi.h>

void init_equip_prop_1(object item)
{
	int type,level,baoji;
	string _name;
	
	if( !clonep(item) ) return;    // 只对复制物品！
	
	level = (1+item->query("level"))*200;
	baoji = (5 + random((level/300)));

	//是武器类
	if(item->query("weapon_prop/damage"))
	{
		switch(random(9))
		{
			case 0: item->add("jingli",10+random(level/5));                   break;    //增加精力
			case 1: item->add("jing",10+random(level/5));                     break;    //增加精神
			case 2: item->add("mp",10+random(level/5));                       break;    //增加体质
			case 3: item->add("ap",10+random(level/1000));                       break;    //增加攻击
			case 4: item->add("weapon_prop/baoji",baoji);                     break;    //增加爆击
			case 5: item->add("weapon_prop/intelligence",(10+random(level/10))/600); break;    //增加悟性
			case 6: item->add("weapon_prop/strength",(10+random(level/10))/6);     break;    //增加力量
			case 7: item->add("weapon_prop/dexerity",(10+random(level/10))/6);     break;    //增加身法
			case 8: item->add("weapon_prop/constitution",(10+random(level/10))/6); break;    //增加根骨
		}
		if(random(100) < 20)
		{
			switch(random(9))
			{
				case 0: item->add("jingli",10+random(level/5));                   break;    //增加精力
				case 1: item->add("jing",10+random(level/5));                     break;    //增加精神
				case 2: item->add("mp",10+random(level/5));                       break;    //增加体质
				case 3: item->add("ap",10+random(level/1000));                       break;    //增加攻击
				case 4: item->add("weapon_prop/baoji",baoji);                     break;    //增加爆击
				case 5: item->add("weapon_prop/intelligence",(10+random(level/10))/600); break;    //增加悟性
				case 6: item->add("weapon_prop/strength",(10+random(level/10))/6);     break;    //增加力量
				case 7: item->add("weapon_prop/dexerity",(10+random(level/10))/6);     break;    //增加身法
				case 8: item->add("weapon_prop/constitution",(10+random(level/10))/6); break;    //增加根骨
			}
		}
	}
	else
	{
		switch(random(9))
		{
			case 0: item->add("pp",10+random(level/10));                      break;    //追加防御
			case 1: item->add("dp",10+random(level/10));                      break;    //增加防御
			case 2: item->add("jing",10+random(level/5));                    break;    //增加体质
			case 3: item->add("jingli",10+random(level/5));                  break;    //增加攻击
			case 4: item->add("armor_prop/intelligence",(10+random(level/10))/600); break;    //增加悟性
			case 5: item->add("armor_prop/strength",(10+random(level/10))/6);     break;    //增加力量
			case 6: item->add("armor_prop/dexerity",(10+random(level/10))/6);     break;    //增加身法
			case 7: item->add("armor_prop/constitution",(10+random(level/10))/6); break;    //增加根骨
			case 8: item->add("hp",10+random(level/5));                      break;    //增加根骨
		}
		if(random(100) < 20)
		{
			switch(random(9))
			{
				case 0: item->add("pp",10+random(level/10));                      break;    //追加防御
				case 1: item->add("dp",10+random(level/10));                      break;    //增加防御
				case 2: item->add("jing",10+random(level/5));                    break;    //增加体质
				case 3: item->add("jingli",10+random(level/5));                  break;    //增加攻击
				case 4: item->add("armor_prop/intelligence",(10+random(level/10))/600); break;    //增加悟性
				case 5: item->add("armor_prop/strength",(10+random(level/10))/6);     break;    //增加力量
				case 6: item->add("armor_prop/dexerity",(10+random(level/10))/6);     break;    //增加身法
				case 7: item->add("armor_prop/constitution",(10+random(level/10))/6); break;    //增加根骨
				case 8: item->add("hp",1000+random(level/5));                      break;    //增加根骨
			}
		}
	}
	item->set("bangding",1);
	item->set("_name",item->query("name"));
	item->set("zhiliang",1);
	item->set("name",sprintf(HIC"%s"NOR,item->query("_name")));
}

void init_equip_prop_2(object item)
{
	int type,level,baoji;
	string _name;
	
	if( !clonep(item) ) return;    // 只对复制物品！
	
	level = (1+item->query("level"))*250;
	baoji = (5 + random((level/200)));

	//是武器类
	if(item->query("weapon_prop/damage"))
	{
		switch(random(9))
		{
			case 0: item->add("jingli",20+random(level/2));                   break;    //增加精力
			case 1: item->add("jing",20+random(level/2));                     break;    //增加精神
			case 2: item->add("mp",20+random(level/2));                       break;    //增加体质
			case 3: item->add("ap",20+random(level/500));                       break;    //增加攻击
			case 4: item->add("weapon_prop/baoji",baoji);                    break;    //增加爆击
			case 5: item->add("weapon_prop/intelligence",(20+random(level/5))/400); break;    //增加悟性
			case 6: item->add("weapon_prop/strength",(20+random(level/5))/4);     break;    //增加力量
			case 7: item->add("weapon_prop/dexerity",(20+random(level/5))/4);     break;    //增加身法
			case 8: item->add("weapon_prop/constitution",(20+random(level/5))/4); break;    //增加根骨
		}
		if(random(100) < 20)
		{
			switch(random(9))
			{
				case 0: item->add("jingli",20+random(level/2));                   break;    //增加精力
				case 1: item->add("jing",20+random(level/2));                     break;    //增加精神
				case 2: item->add("mp",20+random(level/2));                       break;    //增加体质
				case 3: item->add("ap",20+random(level/500));                       break;    //增加攻击
				case 4: item->add("weapon_prop/baoji",baoji);                    break;    //增加爆击
				case 5: item->add("weapon_prop/intelligence",(20+random(level/5))/400); break;    //增加悟性
				case 6: item->add("weapon_prop/strength",(20+random(level/5))/4);     break;    //增加力量
				case 7: item->add("weapon_prop/dexerity",(20+random(level/5))/4);     break;    //增加身法
				case 8: item->add("weapon_prop/constitution",(20+random(level/2))/4); break;    //增加根骨
			}
		}
	}
	else
	{
		switch(random(9))
		{
			case 0: item->add("pp",20+random(level/5));                      break;    //追加防御
			case 1: item->add("dp",20+random(level/5));                      break;    //增加防御
			case 2: item->add("jing",20+random(level/2));                    break;    //增加体质
			case 3: item->add("jingli",20+random(level/2));                  break;    //增加攻击
			case 4: item->add("armor_prop/intelligence",(20+random(level/5))/400); break;    //增加悟性
			case 5: item->add("armor_prop/strength",(20+random(level/5))/4);     break;    //增加力量
			case 6: item->add("armor_prop/dexerity",(20+random(level/5))/4);     break;    //增加身法
			case 7: item->add("armor_prop/constitution",(20+random(level/5))/4); break;    //增加根骨
			case 8: item->add("hp",20+random(level/2));                      break;    //增加根骨
		}
		if(random(100) < 20)
		{
			switch(random(9))
			{
				case 0: item->add("pp",20+random(level/5));                      break;    //追加防御
				case 1: item->add("dp",20+random(level/5));                      break;    //增加防御
				case 2: item->add("jing",20+random(level/2));                    break;    //增加体质
				case 3: item->add("jingli",20+random(level/2));                  break;    //增加攻击
				case 4: item->add("armor_prop/intelligence",(20+random(level/5))/400); break;    //增加悟性
				case 5: item->add("armor_prop/strength",(20+random(level/5))/4);     break;    //增加力量
				case 6: item->add("armor_prop/dexerity",(20+random(level/5))/4);     break;    //增加身法
				case 7: item->add("armor_prop/constitution",(20+random(level/5))/4); break;    //增加根骨
				case 8: item->add("hp",20+random(level/2));                      break;    //增加根骨
			}
		}
	}
	item->set("bangding",1);
	item->set("zhiliang",2);
	item->set("name",sprintf(HIY"%s"NOR,item->query("_name")));
}

