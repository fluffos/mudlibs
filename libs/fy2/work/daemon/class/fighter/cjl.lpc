// shiao.c

inherit NPC;
inherit F_MASTER;

void consider();

void create()
{
	set_name("陈家洛", ({ "cjl" }) );

	set("nickname", "老天邪");
	set("gender", "男性");
	set("age", 30);
	set("long",
		"想当年他傲笑江湖,手创红花会,但经过种种打击后决定退出江湖。\n"
		"他乃是当年江湖上最据争议的人物,并且身兼数家之常.\n"
		"如今他还非常惦念他手创的红花会.\n");
	set("attitude", "peaceful");

	set("str", 26);
	set("cor", 30);
	set("int", 27);
	set("cps", 30);
	set("nobetray",1);
	set("force", 500);
	set("max_force", 500);
	set("force_factor", 30);

	set("combat_exp", 100000);
	set("score", -60000);
	set("xinzhi",-1);
	set("chat_chance_combat", 80);
	set("chat_msg_combat", ({
		(: consider :),
		(: exert_function, "powerup" :),
		(: exert_function, "recover" :)
	}) );

	set_skill("unarmed", 90);
	set_skill("sword", 80);
	set_skill("blade", 70);
	set_skill("throwing", 60);
	set_skill("force", 90);
	set_skill("parry", 90);
	set_skill("dodge", 90);
	set_skill("literate", 50);
	set_skill("perception", 50);

	set_skill("six-chaos-sword", 80);
	set_skill("celestial", 90);
	set_skill("celestrike", 90);
	set_skill("stormdance", 80);
	set_skill("pyrobat-steps", 50);
        set_skill("fonxansword", 80);
	set_skill("fonxanforce",50);
        set_skill("iron-cloth", 70);
        set_skill("jin-gang", 70);


	map_skill("sword", "six-chaos-sword");
	map_skill("parry", "six-chaos-sword");
	map_skill("force", "celestial");
	map_skill("unarmed", "celestrike");
	map_skill("dodge", "pyrobat-steps");
	map_skill("move", "pyrobat-steps");
        map_skill("iron-cloth", "jin-gang");

	create_family("红花会", 1, "创始人");

	setup();

	carry_object("/obj/longsword");
	carry_object(__DIR__"icy_boot")->wear();
	carry_object(__DIR__"icy_cloth")->wear();
}

void init()
{
//	add_action("do_swear", "swear");
	add_action("do_kill","kill");
}
int recognize_apprentice(object ob)
{
        if( !ob->query("marks/陈家洛") ){
                return 0;
        }

        return 1;
}

int do_kill(string arg)
{
	if (arg!="cjl")
	{
		return 0;
	}
	write("老夫以决定不再与人动手\n");
	return 1;
}
void attempt_apprentice(object me)
{
	if (me->query("marks/陈家洛"))
	{
		return ;
	}
	if (me->query("marks/帮派")=="红花会")
	{
		command("smile");
		write ("拜师不敢当,但看在同僚份上,可以切磋切磋\n");
		me->set("marks/陈家洛",1);
		return ;
	}
	return ;
}		


void consider()
{
	int i, flag = 0;
	object *enemy;

	enemy = query_enemy() - ({ 0 });
	for(i=0; i<sizeof(enemy); i++) {
		if( !living(enemy[i]) ) continue;
		if( enemy[i]->query_temp("weapon") ) {
			flag++;
			if(	!query_temp("weapon") ) {
				command("say " + RANK_D->query_respect(enemy[i]) + "既然使兵刃，在下空手接招未免不敬。");
				command("wield sword");
				command("say 进招吧！");
				break;
			}
		}
	}
	if( !flag && query_temp("weapon") ) {
		if( sizeof(enemy) > 1 )
			command("say 嗯... 既然" + chinese_number(sizeof(enemy)) + "位都是空手，在下理当奉陪！");
		else
			command("say 既然" + RANK_D->query_respect(enemy[0]) + "不使兵刃，在下自然奉陪！\n");
		command("unwield sword");
	}
}
