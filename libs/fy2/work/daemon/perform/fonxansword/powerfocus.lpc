// powerfocus.c

#include <ansi.h>

//inherit F_CLEAN_UP;
inherit SSERVER;

void remove_effect(object me);

int perform(object me, object target)
{
        int skill;
	
//	write(2+"\n");
	
        if( !target ) target = offensive_target(me);
//	write(3+"\n");
        if( !target
        ||      !target->is_character()
        ||      !me->is_fighting(target) )
                return notify_fail("加强攻击只能对战斗中的对手使用。\n");

	if ((int)me->query_temp("m_factor"))
	{
	      	return notify_fail("你已经加强攻击了\n");
	}
	if ((int)me->query("force")<100)
	{
		return notify_fail("你内力不够\n");
	}
	if (me->query_skill_mapped("force")!="fonxanforce")
	{
                return notify_fail("你内功等级不够\n");
	}
	if (me->query_skill("fonxanforce",1)<40)
	{
		return notify_fail("你内功等级不够\n");
	}
//	write(4+"\n");
	skill=(int)me->query_skill("fonxansword",1);
//	write(skill+"\n");
	if (random(skill)>60)
	{
		me->set_temp("m_factor",(int)me->query_skill("fonxanforce",1)/12+1);
        	me->start_call_out( (: call_other, __FILE__, "remove_effect", me 
 :),skill/20+(int)me->query_skill("fonxanforce",1)/20+2 );
        	message_vision(
               HIR 
"$N微一凝神，将气运到剑尖上！\n" NOR, me);
		me->add("force",-10);

	} 

       	if( me->is_fighting() ) me->start_busy(1);

        return 1;
}

void remove_effect(object me)
{
	me->delete_temp("m_factor");
        tell_object(me, "你的加强攻击运行完毕，将内力收回丹田。\n");
}
 
