// baxianzuijiu.c

#include <ansi.h>

inherit F_CLEAN_UP;

void remove_effect(object me, int amount);

int perform(object me, object target) {
  int skill;
  int dur;

  if (me->query_skill("zuixian-steps", 1) < 100) return notify_fail("你轻功等级不够。\n");
  if ((int)me->query("force") < 100) return notify_fail("你的内力不够。\n");
  if ((int)me->query_temp("dodgeup")) return notify_fail("你已经在运功中了。\n");

  dur = me->query_condition("drunk");
  if (dur < 1) return notify_fail("你毫无醉意。\n");

  skill = me->query_skill("dodge");

  me->add("force", -100);
  me->receive_damage("kee", 0);

  message_vision(
    HIR
    "$N醉意盎然，脚步踉跄，却隐含玄机，原来是醉仙望月步的绝招----八仙醉酒！！\n" NOR, me);

  me->add_temp("apply/dodge", skill / 4);
  me->set_temp("dodgeup", 1);

  me->start_call_out((: call_other, __FILE__, "remove_effect", me,
    skill / 4 :), skill);

  if (me->is_fighting()) me->start_busy(3);

  return 1;
}

void remove_effect(object me, int amount) {
  me->add_temp("apply/dodge", -amount);
  me->delete_temp("dodgeup");
  tell_object(me, "你的八仙醉酒运行完毕，将内力收回丹田。\n");
}
