// heal.c

#include <ansi.h>

int exert(object me, object target) {
  if (me->is_fighting())
    return notify_fail("战斗中运功解毒？找死吗？\n");

  if ((int)me->query("force") < 100)
    return notify_fail("你的真气不够。\n");

  if ((int)me->query("eff_kee") < (int)me->query("max_kee") / 2)
    return notify_fail("你已经受伤过重，只怕一运真气便有生命危险！\n");

  write(HIW "你全身放松，坐下来开始运功解毒。\n" NOR);

  if (random(me->query_skill("iceheart", 1) * 2) > 50) {
    me->clear_condition();
    message_vision("$N坐下来运功解毒，脸上一阵红一阵白，不久，吐出一口黑血，脸色看起来好多了。\n" NOR, me);
  } else
    message_vision("$N试着逼了逼毒，但是毫无效果。\n", me);

  me->add("force", -100);
  me->set("force_factor", 0);
  return 1;
}
