// mihun.c

#include <ansi.h>
#include <combat.h>

inherit SSERVER;

int exert(object me, object target)
{
	int i, skill, damage;

	if( !me->is_fighting() )
		return notify_fail("迷魂大法只能在战斗中使用。\n");

	if( (int)me->query("force") < 150 )
		return notify_fail("你的内力不够。\n");

	if( !target ) target = offensive_target(me);

	if( !target
	||	!target->is_character()
	||	!me->is_fighting(target) )
		return notify_fail("迷魂大法只能对战斗中的对手使用。\n");

	skill = me->query_skill("force");

	me->add("force", -150);
	me->receive_damage("kee", 10);

	me->start_busy(3);
	message_vision(
		BLU "$N两眼发出诡异的绿光，$n动作开始缓慢下来。\n" NOR, me, target);

    if( skill/2 + random(skill/2) < (int)target->query("cps") * 2 ) return 1;
		
    damage = skill - ((int)target->query("max_force") / 10);
    if( damage > 0 ) {
    target->receive_damage("sen", damage);
    if( (int)target->query("force") < skill * 2 )
    target->receive_wound("sen", damage/2);
	}
	return 1;
}

