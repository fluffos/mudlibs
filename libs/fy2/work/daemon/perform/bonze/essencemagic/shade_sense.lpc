// shade_sense.c

#include <ansi.h>

inherit SSERVER;

int conjure(object me, object target)
{
	int skill;
	if (me->query_skill("essencemagic",1) < 100)
	{
		return notify_fail("你法术等级不够\n");
	}

	if( me->query_temp("apply/shade_sense") )
		return notify_fail("你已经施展过隐识了。\n");

	if( (int)me->query("atman") < 200 )
		return notify_fail("你的灵力不够。\n");

	skill = me->query_skill("magic");

	me->add("atman", - 200);

	message_vision(	HIW "$N施展「隐识」之术，整个人渐渐幻入迷雾之中。\n" NOR, me);
	me->set_temp("apply/shade_sense", 1);
	me->start_call_out( (: call_other, __FILE__, "remove_effect", me :), random(skill));

	if( me->is_fighting() ) me->start_busy(5);

	return 1;
}

void remove_effect(object me)
{
	me->delete_temp("apply/shade_sense", -1);
	tell_object(me, "你的隐识失效了。\n");
}
