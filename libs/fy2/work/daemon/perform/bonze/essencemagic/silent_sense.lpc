// silent_sense.c

#include <ansi.h>

inherit SSERVER;

int conjure(object me, object target)
{
	if( (int)me->query("atman") < 100 ) return notify_fail("你的灵力不够！\n");
	me->add("atman", -100);
	message_vision( HIR "$N施展［寂识］，妄图冲破生命的极限！！\n" NOR, me);
	if( random(me->query_skill("essencemagic", 1) / 100) )   {
        me->set("eff_sen",me->query("max_sen"));
        me->set("sen",me->query("max_sen"));    }
	if( me->is_fighting() )
		me->start_busy(3);
	return 1;
}
