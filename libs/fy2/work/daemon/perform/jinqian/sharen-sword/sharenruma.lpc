// sharenruma.c

#include <ansi.h>
#include <combat.h>

inherit SSERVER;

int perform(object me, object target)
{
    object weapon;
	string msg;
    int skill;

	if( !target ) target = offensive_target(me);

	if( !target
	||	!target->is_character()
	||	!me->is_fighting(target) )
		return notify_fail("杀人如麻只能对战斗中的对手使用。\n");

	if ((skill = me->query_skill("sharen-sword", 1)) < 90)
	{
		return notify_fail("你剑法等级不够\n");
	}

    if (me->query("force") < 100)
    {
        return notify_fail("你内力不够\n");
    }

    weapon = me->query_temp("weapon");
	message_vision(HIR "$N凶性大发，手中的"NOR+weapon->query("name")+HIR"狂风暴雨般地向$n卷来！\n" NOR, me, target, me->query_temp("weapon"));
    COMBAT_D->do_attack(me, target, weapon, TYPE_REGULAR, HIR"第一剑！"NOR);
    me -> add("str", 5);
    COMBAT_D->do_attack(me, target, weapon, TYPE_REGULAR, HIR"第二剑！"NOR);
    me -> add("str", 5);
    COMBAT_D->do_attack(me, target, weapon, TYPE_REGULAR, HIR"第三剑！"NOR);
    if(random(skill) > 60){
    me -> add("str", 5);
    COMBAT_D->do_attack(me, target, weapon, TYPE_REGULAR, HIR"第四剑！"NOR);
    me -> add("str", 5);
    COMBAT_D->do_attack(me, target, weapon, TYPE_REGULAR, HIR"第五剑！"NOR);
    if(random(skill) > 90){
    me -> add("str", 5);
    COMBAT_D->do_attack(me, target, weapon, TYPE_REGULAR, HIR"第六剑！"NOR);
    me -> add("str", 5);
    COMBAT_D->do_attack(me, target, weapon, TYPE_REGULAR, HIR"第七剑！"NOR);
    me -> add("str", -10);   }
    me -> add("str", -10);  }
    me -> add("str", -10);
    me -> add("force", -100);
	me->start_busy(5);
	return 1;
}
