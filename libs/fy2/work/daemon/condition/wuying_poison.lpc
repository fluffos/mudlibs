// iceshock.c

#include <ansi.h>
#include <condition.h>

inherit F_CLEAN_UP;

int update_condition(object me, int duration)
{
    object *inv;
    int i;
	me->receive_damage("kee", 6);
    me->receive_wound("kee", 6);

	me->apply_condition("wuying_poison", duration - 1);

	tell_object(me, "你中的"+CYN"无影毒"NOR+"发作了。\n" NOR );

	if( duration < 1 ) return 0;

	return CND_CONTINUE;
}
