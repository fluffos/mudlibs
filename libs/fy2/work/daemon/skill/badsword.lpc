// badsword.c

inherit SKILL;

mapping *action = ({
  ([ "action": "$N手腕一转，使出李大嘴的『蚀骨蚀肉』，凌厉剑网直向$n全身削去",
    "post_action": (: call_other, WEAPON_D, "damage_weapon" :),
    "dodge": -20,
    "parry": 25,
    "damage": 90,
    "damage_type": "割伤"
  ]),
  ([ "action": "$N气运丹田，力贯剑峰，重心一沈朝$n当头砍下，正是轩辕三光的『恶人挡路』，霸气十足",
    "post_action": (: call_other, WEAPON_D, "damage_weapon" :),
    "dodge": 30,
    "parry": -30,
    "damage": 160,
    "force": 160,
    "damage_type": "割伤"
  ]),
  ([ "action": "$N身形一转使出阴老九的『恶鬼招魂』，霎时风声鹤唳，手中的$w从不可思议的方位窜出，直取$n首级",
    "post_action": (: call_other, WEAPON_D, "damage_weapon" :),
    "dodge": -50,
    "parry": 15,
    "damage": 130,
    "damage_type": "割伤",
  ]),
  ([ "action": "$N脸色一沈，将全身杀气贯注於$w之上，使出杜杀绝学『血手无情』",
    "post_action": (: call_other, WEAPON_D, "damage_weapon" :),
    "dodge": 40,
    "parry": -50,
    "damage": 200,
    "force": 180,
    "damage_type": "割伤",
  ])
});

int valid_learn(object me) {
  object ob;

  if ((int)me->query("max_force") < 100)
    return notify_fail("你的内力不够，没有办法练天魔剑法。\n");

  if ((string)me->query_skill_mapped("force") != "badforce")
    return notify_fail("天魔剑法必须配合万恶心法才能练。\n");

  if (!(ob = me->query_temp("weapon"))
    || (string)ob->query("skill_type") != "sword")
    return notify_fail("你必须先找一把剑才能练剑法。\n");

  return 1;
}

int valid_enable(string usage) {
  return usage == "sword" || usage == "parry";
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

int practice_skill(object me) {
  if ((int)me->query("kee") < 30
    || (int)me->query("force") < 3)
    return notify_fail("你的内力或气不够，没有办法练习天魔剑法。\n");
  me->receive_damage("kee", 30);
  me->add("force", -3);
  write("你按著所学练了一遍天魔剑法。\n");
  return 1;
}

string perform_action_file(string action) {
  return PERFORM_D("badman") + "/badsword/" + action;
}

int effective_level() { return 15; }

string *parry_msg = ({
  "$n使出一招「凶神恶煞」，手中的$v幻出一条黑气，磕开了$N的$w。\n",
  "$n使出一招「无恶不作」，手中的$v化做漫天血影，荡开了$N的$w。\n",
  "$n手中的$v一抖，一招「恶贯满盈」，向$N拿$w的手腕削去。\n",
});

string *unarmed_parry_msg = ({
  "$n将手中的$v舞得密不透风，封住了$N的攻势。\n",
  "$n反手一招「穷凶极恶」，整个人消失在一团剑光之中。\n",
  "$n使出一招「恶贯满盈」，$v直刺$N的双手。\n",
});

string query_parry_msg(object weapon) {
  if (weapon)
    return parry_msg[random(sizeof(parry_msg))];
  else
    return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}

int learn_bonus() {
  return 0;
}

int practice_bonus() {
  return 0;
}

int black_white_ness() {
  return -50;
}
