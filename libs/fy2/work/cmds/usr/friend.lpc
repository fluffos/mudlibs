// friend.c

#define MAX_ENV_FRIEND	20

inherit F_CLEAN_UP;

int help();

int main(object me, string arg) {
  int i, j = 0;
  string type, friendofme, *friends;

  if (me != this_player(1)) return 0;

  if (!friends = me->query("tell/friend"))
    friends = ({});
  if (!arg || arg == "") {
    write("你目前设定的好友名单为：\n");
    if (!me->query("friend_number"))
      write("\t没有设定任何好友。\n");
    else {
      for (i = 0; i < me->query("friend_number"); i++)
        printf("%s\n", friends[i]);
    }
    return 1;
  }

  if (sscanf(arg, "%s %s", type, friendofme) != 2)
    return help();

  if (type == "add") {
    if (me->query("friend_number") >= MAX_ENV_FRIEND)
      return notify_fail("你设定的好友太多了，请先用 friend delete 删掉几个吧。\n");
    if (!(i = me->query("friend_number"))) {
      me->set("friend_number", 0);
      i = 0;
    }
    if (i < sizeof(friends))
      friends[i] = friendofme;
    else
      friends += ({ friendofme });
    me->add("friend_number", 1);
    me->set("tell/friend", friends);
    printf("加入好友名单：%s\n", friendofme);
    return 1;
  }
  if (type == "delete") {
    if (me->query("friend_number") < 1)
      return notify_fail("你现在没有设定好友啊。\n");
    for (i = 0; i < me->query("friend_number"); i++) {
      if (friends[i] == friendofme) {
        for (j = i; j < me->query("friend_number") - 1; j++)
          friends[j] = friends[j + 1];
        friends[me->query("friend_number") - 1] = 0;
        me->add("friend_number", -1);
        me->set("tell/friend", friends);
        printf("删除好友名单：%s\n", friendofme);
        break;
      }
    }
    if (j == 0)
      return notify_fail("没有这个好友。\n");
    return 1;
  }
  return help();
}

int help() {
  write(@TEXT
指令格式：

friend                  列出好友名单
friend add <名称>       增加好友
friend delete <名称>    删除好友
TEXT
  );
  return 1;
}
