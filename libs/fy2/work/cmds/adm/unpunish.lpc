#include <ansi.h>
inherit F_CLEAN_UP;
int main(object me, string arg)
{
	string key, chinz;
	string classd;

        seteuid(geteuid());
	if( !arg || arg=="" )
		return notify_fail("指令格式：unpunish <受罚者> <刑罚>\n");

	if(sscanf(arg,"%s %s",classd,key)==2){
	PUNISH_D->remove_translate(classd,key);
	write("解除"+classd+"的"+key+"刑罚\n");

	return 1;
	}
	return 0;
}

int help()
{
	write ( @HELP
指令格式：unpunish <受罚者> <刑罚>\n
 
HELP
	);
	return 1 ;
}
