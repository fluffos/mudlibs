// cloth.c
//
// This is the basic equip for players just login.

#include <weapon.h>

inherit FORK;

void create()
{
     set_name("订做的", ({ "order" }) );
     set_weight(10000);
     set("no_get",1);
     set("no_drop",1);
	if( clonep() )
                set_default_object(__FILE__);
    else {
     set("unit", "柄");
     set("material", "steel");
     set("owner", "qiqi");
     set("ji_gold", 1);
     set("wield_msg", "$N把$n紧紧地握在手中。\n");
     set("unwield_msg", "$N松开了手中的$n。\n");
     init_fork(30);
     set("long",@LONG
这是一柄烤鸡翅膀用的叉子，不知道有谁会用它。
LONG        );
        }
        setup();
}

