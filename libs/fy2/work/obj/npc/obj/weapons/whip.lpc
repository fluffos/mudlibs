// cloth.c
//
// This is the basic equip for players just login.

#include <weapon.h>

inherit WHIP;

void create()
{
     set_name("订做的", ({ "order" }) );
     set_weight(5000);
     set("no_get",1);
     set("no_drop",1);
	if( clonep() )
                set_default_object(__FILE__);
    else{
     set("unit", "根");
     set("material", "steel");
     set("owner", "qiqi");
     set("ji_gold", 1);
     set("wield_msg", "$N从腰间摸出一条$n握在手中。\n");
     set("unwield_msg", "$N将手中的$n束在腰间。\n");
     init_whip(30);
     set("long",@LONG
这是一根自己订做的铁鞭，拿着倒是趁手。
LONG        );
        }
        setup();
}



