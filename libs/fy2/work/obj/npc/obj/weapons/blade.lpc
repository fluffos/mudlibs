// cloth.c
//
// This is the basic equip for players just login.

#include <weapon.h>

inherit BLADE;

void create() {
  set_name("订做的", ({ "order" }));
  set_weight(9000);
  set("no_get", 1);
  set("no_drop", 1);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("material", "steel");
    set("owner", "qiqi");
    set("ji_gold", 1);
    set("wield_msg", "$N拿出一把亮闪闪的$n，握在手中。\n");
    set("unequip_msg", "$N放下手中的$n。\n");
    init_blade(30);
    set("long", @LONG
这是一把亮闪闪的单刀，看上去不是很锋利。
LONG);
  }
  setup();
}
