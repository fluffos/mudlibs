#include <ansi.h>
inherit ROOM;

void create() {
  set("short", "钢索桥上");
  set("long", @LONG
钢索很滑，山风很大，人走在上面，就象是风中的残烛。放眼望
过去，四面都是白云，飘飘渺渺，浮浮动动，整个天地都好像在浮动
中。要想平平稳稳的走在上面，实在很不容易。
LONG
  );
  set("exits", ([
    "west": __DIR__ "shanya",
    "east": __DIR__ "youling1",
  ]));
  set("objects", ([
    __DIR__ "npc/gouhun": 1
  ]));
  set("outdoors", "youling");
  setup();
}

int valid_leave(object me, string dir) {
  if (dir == "east" && present("ghost", this_object()) && !me->query_temp("ghost/勾魂"))
    return notify_fail(HIW "勾魂使者喝道：没有合约，不可以进幽灵山庄。除非你能接我一招！(accept test)\n" NOR);
  me->delete_temp("ghost/勾魂");
  return 1;
}
