// sword.c : an example weapon

#include <weapon.h>

inherit SWORD;

void create() {
  set_name("乌木簪", ({ "black clip", "clip" }));
  set_weight(700);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "根");
    set("long", "这是一只簪发的木簪，乃千年沉香木所做。\n");
    set("value", 4000);
    set("material", "wood");
  }
  init_sword(5);

  // These properties are optional, if you don't set them, it will use the
  // default values.

  set("wield_msg", "$N从头上拔下一根$n握在手中。\n");
  set("unwield_msg", "$N将手中的$n插回头上。\n");

  // The setup() is required.

  setup();
}
