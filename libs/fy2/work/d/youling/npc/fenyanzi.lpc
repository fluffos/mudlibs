// teacher.c

inherit NPC;

void create()
{
	set_name("粉燕子", ({ "fen yan zi", "fen" }) );
	set("gender", "男性" );
	set("age", 52);
    set("title", "大盗");
    set("nickname", "万里踏花");
    set("long", "一张少女般嫣红的脸，一身剪裁极和身的粉红色衣裳
粉红色的腰带旁，斜挂着一支粉红色的腰囊。\n");
    set("attitude", "peaceful");
    set("combat_exp", 150000);
    set_skill("throwing", 100);
    set_skill("dodge", 100);
    set_skill("unarmed", 100);
	setup();
	set("score",5);
    carry_object(__DIR__"obj/biao")->wield();
    carry_object(__DIR__"obj/bag");
}

