// teacher.c

inherit NPC;

void create()
{
	set_name("孤独美", ({ "gu du mei" }) );
	set("gender", "男性" );
	set("age", 52);
    set("title", "独行大盗");
    set("nickname", "六亲不认");
    set("long", "一个两鬓斑白的人，衰老、憔悴、疲倦、悲伤而恐惧。\n");
    set("attitude", "peaceful");
    set("combat_exp", 5);
	setup();
	set("score",5);
    carry_object(__DIR__"obj/gusword")->wield();
}

void init()
{
        object ob;

        ::init();
        if( interactive(ob = this_player()) && !is_fighting()) {
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
        }
        add_action("do_agree", "agree");
}

void greeting(object ob)
{
        if( !ob || environment(ob) != environment() || query_temp("youling/agree")) return;
        message_vision("孤独美的喉结上下滚动着，充满了恐惧的眼里露出了一丝希望，喘息着道：
你．．．是谁？帮我！没有我，你走不出的！(agree to help)\n", ob);
}

int do_agree(string arg)
{
    if(arg != "to help")return 0;
    set_temp("youling/agree", 1);
    message_vision("孤独美充满了恐惧的眼里露出了一丝笑意，喘息着对$N道：谢谢你。\n", this_player());
    this_object()->set_leader(this_player());
    command("say 向东走。");
    return 1;
}

    
