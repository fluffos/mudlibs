#include <ansi.h>
inherit ROOM;

void create()
{
        object con, item;
        set("short", "山崖边");
        set("long", @LONG
前面是一道深不见底的万丈深渊。下面白云缭绕，什么都看不见，
就连死人的幽灵都看不见。难道那幽灵山庄就在这万丈深渊之下？
LONG
        );
        set("exits", ([ 
  "north" : __DIR__"conglin10",
  "south" : __DIR__"conglin9",
  "west" : __DIR__"conglin9",
]));
        set("objects", ([
        __DIR__"obj/rock" : 1,
        __DIR__"obj/pipe" : 1
])  );
        set("outdoors", "youling");
        setup();
        con = present("rock",this_object());
        item = present("pipe",this_object());
        item->move(con);
}

void init()
{
    remove_call_out("do_say");
    call_out("do_say", 1);
    add_action("do_blow", "blow");
}

int do_say()
{
    object ob;
    if(ob=present("gu du mei", this_object())){
        message("sound", CYN + ob->name() + "说道：到了。\n" NOR,
                environment(ob), ob);
    ob -> set_leader(0);
    }
    return 1;
} 
    
void close_path()
{
    if( !query("exits/east") ) return;
                delete("exits/east");
}

int do_blow(string arg)
{
    object me, *inv;
    int i, sign = 0;
    if(arg != "pipe")return 0;
    me = this_player();
    inv = all_inventory(me);
    if(sizeof(inv) < 1)return 0;
    for(i = 0; i<sizeof(inv); i++)
    if(inv[i]->query("id") == "pipe")sign = 1;
    if(sign == 0)return 0;
    message_vision(CYN"$N拿起一个铜哨吹了一声。\n\n"NOR, me);
    message_vision(HIW"白云之间忽然出现了一个人，什么人能凌空站在白云里？
你走到崖边才发现，白云里有条很粗的钢索，横贯了两旁的山崖。\n"NOR, me);
    if( !query("exits/east") ) {
    set("exits/east", __DIR__"bridge");
    call_out("close_path", 3);}
    return 1;
}

