// meat.c

inherit ITEM;
inherit F_FOOD;

void create() {
  set_name("一大锅肉", ({ "meat" }));
  set_weight(350);
  set("no_get", 1);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一大锅肉。\n");
    set("unit", "锅");
    set("value", 0);
    set("food_remaining", 400);
    set("food_supply", 4000);
    set("material", "bone");
  }
  setup();
}

int finish_eat() {
  set_name("铁锅", ({ "iron pan", "pan" }));
  set("long", "一口空空如也地铁锅。\n");
  return 1;
}
