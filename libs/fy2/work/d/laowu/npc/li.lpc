// mother.c
#include <ansi.h>
inherit NPC;

void create() {
  set_name("李神童", ({ "li" }));
  set("gender", "男性");
  set("title", HIG "绿高帽" NOR);
  set("age", 55);
  set("str", 50);
  set("long", @LONG
一个带着绿高帽的李神童
LONG);
  set("combat_exp", 250000);
  set_skill("unarmed", 80);
  set_skill("dodge", 80);
  set_skill("move", 80);

  set("attitude", "heroism");

  setup();

  carry_object(__DIR__ "obj/ao")->wear();
  add_money("gold", 1);
}
