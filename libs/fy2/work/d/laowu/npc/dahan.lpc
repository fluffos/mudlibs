// mother.c
inherit NPC;

void create()
{
	set_name("关东大汉", ({ "dahan" }) );
	set("gender", "男性" );
	set("age", 35);
	set("long", @LONG
这是一位从白山黑水来的关东大汉。
LONG    );
        set("chat_chance", 40);
        set("chat_msg", ({
    (: random_move :),
    "关东大汉豪爽得向你大笑！\n",
 }));
	set("combat_exp", 10000 + random(10) * 100);
    set_skill("unarmed", 10 + random (10));
    set_skill("dodge", 10 + random (10));
    set_skill("move", 10 + random (10));

	set("attitude", "heroism");

	setup();
    	
    carry_object("/obj/cloth")->wear();
    carry_object(__DIR__"obj/xuechang");
    add_money("silver", 10);
}

