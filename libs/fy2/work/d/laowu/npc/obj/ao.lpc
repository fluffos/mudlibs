// cloth.c
//
// This is the basic equip for players just login.

#include <armor.h>

inherit CLOTH;

void create() {
  set_name("大棉袄", ({ "ao" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("long", "一件暖和的大棉袄。\n");
    set("material", "cloth");
    set("armor_prop/armor", 2);
  }
  setup();
}
