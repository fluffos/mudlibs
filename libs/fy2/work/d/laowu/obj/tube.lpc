// bag.c

inherit ITEM;

void create()
{
	set_name("精钢圆筒", ({ "steel tube", "tube" }) );
	set_weight(500);
	set_max_encumbrance(8000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "口");
		set("long", "这是一只精钢所制的圆筒。\n");
		set("value", 40000);
	}
}

int is_container() { return 1; }
