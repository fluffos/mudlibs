inherit ROOM;
void create()
{
        set("short", "小屋");
        set("long", @LONG
屋子里温暖如春，桌上的瓶子里还插着几支腊梅，寒风在窗外呼
啸，窗子却紧紧的关着。地上铺着层木板，木板下就是冰冻三尺的松
花江。
LONG
        );
        set("exits", ([ 
  "west" : __DIR__"serve4",
]));
        set("item_desc", ([
                "木板": "这块木板似乎可以拉开(pull)。\n",
        ]) );
        setup();
}

void init()
{
    add_action("do_pull", "pull");
}

void close_path()
{
        if( !query("exits/down") ) return;
        message("vision",
"只听砰的一声，木板掉下去又挡住了暗门。\n",
                this_object() );
                delete("exits/down");
}


int do_pull(string arg)
{
        object me;
        if( !arg || arg=="" ) return 0;

        if( arg=="木板" ) {
                write("你拉起地上的木板，发现下面是空的。\n");
                if( !query("exits/down") ) {
                set("exits/down", __DIR__"serve43");
                call_out("close_path", 3);
                return 1;
        }   }
        else return notify_fail("你要拉起什么？\n");
}
