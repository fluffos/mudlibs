// waiter.c
#include <ansi.h>
inherit NPC;
inherit F_VENDOR;

void create() {
  set_name("徐娘", ({ "xuniang" }));
  set("gender", "女性");
  set("age", 57);
  set("long",
    "这位半老徐娘正用色迷迷的眼神盯着你。\n");
  set("title", HIG "徐娘半老，风韵犹存" NOR);
  set("combat_exp", 400000);
  set_skill("unarmed", 80);
  set_skill("meihua-shou", 80);
  set_skill("dodge", 80);
  set_skill("fall-steps", 80);
  map_skill("dodge", "fall-steps");
  map_skill("unarmed", "meihua-shou");
  set("max_force", 1000);
  set("force", 1000);
  set("force_factor", 20);
  set("attitude", "friendly");
  set("vendor_goods", ([
    __DIR__ "obj/cpdx": 10,
    __DIR__ "obj/cup1": 10,
    __DIR__ "obj/glxj": 10,
    __DIR__ "obj/pxhy": 10,
    __DIR__ "obj/cup2": 10,
  ]));
  setup();
  carry_object(__DIR__ "obj/caiskirt")->wear();
}

void init() {
  object ob;

  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
  add_action("do_vendor_list", "list");
}

void greeting(object ob) {
  if (!ob || environment(ob) != environment()) return;
  switch (random(3)) {
    case 0:
      say("徐娘色咪咪地说道：这位" + RANK_D->query_respect(ob)
        + "，饿了吧，来。。。\n");
      break;
  }
}
