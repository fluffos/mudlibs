// teacher.c

inherit NPC;

void create() {
  set_name("湖上水", ({ "shui" }));
  set("gender", "女性");
  set("age", 18);
  set("per", 30);
  set("title", "湖上八娇");
  set("long",
    "这是千金楼湖上八娇之一．
湖上水，流绕禁园中。
斜日暖摇清翠动，落花香暖众纹红，苹末起清风。
闲纵目，鱼跃小莲东。
泛泛轻摇兰棹稳，沉沉寒影上仙宫，远意更重重。
\n");
  set("attitude", "friendly");
  set("combat_exp", 50000);
  set_skill("unarmed", 60);
  set_skill("dodge", 60);
  setup();
  carry_object(__DIR__ "obj/shuicloth")->wear();
  carry_object(__DIR__ "obj/shuiyu");
  add_money("gold", 5);
}
