// waiter.c

inherit NPC;
inherit F_VENDOR;

void create()
{
	set_name("采菱女", ({ "cailing" }) );
	set("gender", "女性" );
	set("age", 17);
    set("per", 27);
	set("long",
		"这位高卷着裤脚，笑咪咪地看着你．\n");
	set("combat_exp", 1000);
	set("attitude", "friendly");
	set("vendor_goods", ([
        __DIR__"obj/nenou" : 10,
	]) );
	setup();
    carry_object("/obj/cloth")->wear();
	set("score",40);
}

void init()
{	
	object ob;

	::init();
	if( interactive(ob = this_player()) && !is_fighting() ) {
		remove_call_out("greeting");
		call_out("greeting", 1, ob);
	}
	add_action("do_vendor_list", "list");
}

void greeting(object ob)
{
	if( !ob || environment(ob) != environment() ) return;
	switch( random(3) ) {
		case 0:
			say( "采菱女笑咪咪地说道：这位" + RANK_D->query_respect(ob)
				+ "，请买一些嫩藕吧。\n");
			break;
	}
}
