// mother.c
#include <ansi.h>
inherit NPC;

void create()
{
	set_name("林仙儿", ({ "linxian" }) );
	set("gender", "女性" );
	set("age", 19);
	set("per", 26);
	set("long", @LONG
两弯似戚非戚笼烟眉，一双似喜非喜含情目．
行动如弱柳扶风，闲静似娇花照水．
LONG
);
    set("title", RED"武林第一美人"NOR);
	set("combat_exp", 50000);
    set_skill("unarmed", 60);
    set_skill("dodge", 60);
    set_skill("move", 60);
	set("attitude", "friendly");

	setup();
	
    carry_object(__DIR__"obj/silverskirt")->wear();
    add_money("silver", 10);
	set("score",-10);
}

void init()
{
        add_action("do_kill", "kill");
}

int do_kill()
{
        object ob;
        int i;

        command("say 你真的忍心对我下手？？");
        
        message_vision("旁边的阿飞对$N发动攻击！\n", this_player());

        if( objectp( ob = present("afei", environment(this_object())) ) )
                                 ob->kill_ob(this_player());    
                else    this_object()->kill_ob(this_player());          
        return 1;
}

