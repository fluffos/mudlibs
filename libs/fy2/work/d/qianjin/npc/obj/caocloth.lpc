// cloth.c
//
// This is the basic equip for players just login.

#include <armor.h>

inherit CLOTH;

void create()
{
	set_name("草衫", ({ "cao cloth", "cloth" }) );
	set_weight(3000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "件");
		set("value", 1000);
		set("long", "这是湖上草最爱穿的衣服，故被称为草衫。\n");
		set("material", "cloth");
		set("armor_prop/armor", 10);
	}
	setup();
}
