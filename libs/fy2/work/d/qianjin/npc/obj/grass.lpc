// token.c


inherit ITEM;

void create()
{
        set_name("勿忘我", ({ "grass" }) );
        set_weight(10);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "根");
                set("long", "一根勿忘我。\n");
                set("material", "paper");
                set("value", 1);
        }
        setup();
}
