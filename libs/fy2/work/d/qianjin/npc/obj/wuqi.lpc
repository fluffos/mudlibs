// hammer.c

#include <weapon.h>

inherit WHIP;

void create()
{
        set_name("红绸舞器", ({ "wuqi" }) );
        set_weight(8000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "根");
                set("long", "一根红绸舞器。\n");
                set("value", 3);
                set("material", "iron");
        set("wield_msg", "$N从腰间摸出一条$n握在手中。\n");
        set("unwield_msg", "$N将手中的$n束在腰间。\n");
        }

        init_whip(15);
        setup();
}
