// yu.c


inherit ITEM;

void create()
{
        set_name("花玉璧", ({ "huayu" }) );
        set_weight(10);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "块");
                set("long", "一块晶莹剔透的花玉璧。\n");
                set("material", "paper");
                set("value", 0);
        }
        setup();
}
