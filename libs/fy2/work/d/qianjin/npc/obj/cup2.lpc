// waterskin.c

inherit ITEM;
inherit F_LIQUID;

void create()
{
	set_name("大金杯", ({ "gold cup", "cup" }) );
	set_weight(1000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "一只用来喝酒的大金杯。\n");
		set("unit", "只");
		set("value", 100000);
		set("max_liquid", 40);
	}

	// The liquid contained in the container is independent, we set a copy
	// in each cloned copy.
	set("liquid", ([
		"type": "alcohol",
		"name": "美酒",
		"remaining": 40,
		"drunk_apply": 2,
	]) );
}
