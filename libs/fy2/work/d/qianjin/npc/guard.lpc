// mother.c
inherit NPC;

void create()
{
	set_name("打更的", ({ "guard" }) );
	set("gender", "男性" );
	set("age", 42);
	set("long", @LONG
一个醉熏熏的打更的
LONG
);
	set("combat_exp", 1000000);
    set_skill("unarmed", 200);
    set_skill("dodge", 200);
    set_skill("move", 200);
	set("attitude", "friendly");

	setup();
	
	carry_object("/obj/cloth")->wear();
	set("score",-10);
}

