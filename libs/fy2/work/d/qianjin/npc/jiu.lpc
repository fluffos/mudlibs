// teacher.c

inherit NPC;

void create()
{
	set_name("湖上酒", ({ "jiu" }) );
	set("gender", "女性" );
	set("age", 18);
    set("per", 30);
    set("title", "湖上八娇");
    set("long", 
"这是千金楼湖上八娇之一．
湖上酒，终日助清欢。
檀板轻声银甲缓，醅浮香米玉蛆寒，醉眼暗相看。
春殿晚，仙艳奉杯盘。
湖上风光真可爱，醉乡天地就中宽，帝王正清安。
\n");
    set("attitude", "friendly");
    set("combat_exp", 50000);
    set_skill("unarmed", 60);
    set_skill("dodge", 60);
    set_temp("apply/jiuyu", 1);
	setup();
    carry_object(__DIR__"obj/jiucloth")->wear();
    add_money("gold", 5);
}

int accept_object(object who, object ob)
{
    object obj;
    if ((string)ob->query("liquid/type")=="alcohol") {
        if ((int)ob->query("liquid/remaining") == 0) {
            command("shake");
            command("say 空的我不要...");
            return 0;
        }
        else {
            command("smile");
            command("say 多谢!");
            if(query_temp("apply/jiuyu"))   {
            obj = new(__DIR__"obj/jiuyu");
            obj -> move(who);
            delete_temp("apply/jiuyu"); }
            return 1;
        }
    }
    else return 0;
} 
