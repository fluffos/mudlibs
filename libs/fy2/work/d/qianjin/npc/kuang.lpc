// teacher.c
inherit NPC;

void create() {
  set_name("狂嫖客", ({ "piaoke" }));
  set("gender", "男性");
  set("age", 38);
  set("str", 200);
  set("long", "这是一位身怀巨金的狂嫖客\n");
  set("attitude", "heroism");
  set("combat_exp", 100000);
  set_skill("dodge", 80);
  set_skill("move", 80);
  set_skill("unarmed", 80);
  set("max_force", 1000);
  set("force", 1000);
  setup();
  carry_object(__DIR__ "obj/tuan")->wear();
}
