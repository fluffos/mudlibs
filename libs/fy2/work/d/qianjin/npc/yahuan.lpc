// teacher.c

inherit NPC;

void create()
{
	set_name("丫环", ({ "yahuan" }) );
	set("gender", "女性" );
	set("age", 15);
    set("per", 26);
    set("long", "天真可爱的丫环正在相互低头切切私语。\n");
    set("attitude", "friendly");
    set("combat_exp", 1000);
	setup();
    carry_object(__DIR__"obj/caiskirt")->wear();
}

