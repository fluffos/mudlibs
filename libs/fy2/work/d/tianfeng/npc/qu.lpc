// waiter.c

inherit NPC;
int go_shi();
void create()
{
	set_name("曲无容", ({ "wurong" }) );
	set("gender", "女性" );
	set("age", 23);
	set("long",
		"一个全身黑袍的女孩子．．\n");
    set("inquiry", ([
                "石观音" : (: go_shi :),
        ]));
    set("combat_exp", 2200000);
    set_skill("kongshoudao", 100);
    set_skill("dodge", 100);
    set_skill("ghosty-steps", 100);
    set_skill("unarmed", 100);
    set_skill("parry", 100);
    map_skill("dodge", "ghosty-steps");
    map_skill("unarmed", "kongshoudao");
    set("max_force", 2000);
    set("force", 2000);
    set("force_factor", 30);
    set("chat_chance", 10);
    set("chat_msg", ({
    "曲无容哼道：中原一点红，他真的爱我？？\n",
    }) );
	set("attitude", "heroism");
	set("per",30);
	setup();
	carry_object(__DIR__"obj/heicloth")->wear();
}

int go_shi()
{
        object me;
        me = this_player();
        write("曲无容对你冷笑一声：你想见我师父？
那我就成全你！！
你脚下一松，整个人不见了！父？\n");
        me -> move("/d/tianfeng/wu1");
        return 1;
}
