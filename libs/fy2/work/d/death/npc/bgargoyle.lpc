// gargoyle.c

#include <ansi.h>
#include <login.h>

inherit NPC;

string *death_msg = ({
  HIB "黑无常说道：喂！新来的，你叫什麽名字？\n\n" NOR,
  HIB "黑无常用奇异的眼光盯著你，好像要看穿你的一切似的。\n\n" NOR,
  HIB "黑无常「哼」的一声，从袖中掏出一本像帐册的东西翻看著。\n\n" NOR,
  HIB "黑无常合上册子，说道：咦？阳寿未尽？怎麽可能？\n\n" NOR,
  HIB "黑无常搔了搔头，叹道：罢了罢了，你走吧。\n\n"
  "一股阴冷的浓雾突然出现，很快地包围了你。\n\n" NOR,
});
string *revive_loc = ({
  "/d/fy/church",
  "/u/guanwai/tower",
});

void create() {
  set_name("黑无常", ({ "black gargoyle", "gargoyle" }));
  set("long",
    "黑无常伸著长长的舌头瞪著你，黝黑的脸上看不出任何喜怒哀乐。\n");
  set("attitude", "peaceful");
  set("chat_chance", 15);
  set("chat_msg", ({
    (: random_move :),
    "黑无常发出一阵像呻吟的声音，当他发现你正注视著他的时候，瞪了你一眼。\n",
    "黑无常把长长的舌头伸出来，缓缓地舔了舔自己又黑又长的手指。\n"
  }));
  set("age", 217);
  set("combat_exp", 20000000);
  set_skill("move", 300);
  set("max_gin", 900);
  set("max_kee", 900);
  set("max_sen", 200);
  set_skill("dodge", 40);
  set_skill("unarmed", 40);
  set_temp("apply/armor", 60);
  set_temp("apply/damage", 20);
  setup();
}

void init() {
  ::init();
  if (!previous_object()
    || !userp(previous_object()))
    return;
  if (previous_object()->query_temp("death_stage_active")) return;
  previous_object()->set_temp("death_stage_active", 1);
  call_out("death_stage", 1, previous_object(), 0);
}

void death_stage(object ob, int stage) {
  if (!ob || !present(ob)) {
    if (ob) ob->delete_temp("death_stage_active");
    return;
  }

  if (!ob->is_ghost()) {
    command("say 喂！阳人来阴间做什麽？");
    kill_ob(ob);
    ob->fight_ob(this_object());
    ob->delete_temp("death_stage_active");
    return;
  }

  tell_object(ob, death_msg[stage]);
  if (++stage < sizeof(death_msg)) {
    call_out("death_stage", 5, ob, stage);
    return;
  } else
    ob->reincarnate();

  ob->delete_temp("death_stage_active");
  ob->move(revive_loc[random(sizeof(revive_loc))]);
  // BUG FIX (deep functional test, AGENTS.md §7.24): this used to
  // unconditionally set the player's permanent login/respawn location
  // (query("startroom"), read by adm/daemons/logind.lpc's enter_world()
  // on every FUTURE full login) to whichever revive_loc waypoint the
  // player randomly landed in here. Neither "/d/fy/church" nor
  // "/u/guanwai/tower" carries the "valid_startroom" flag that
  // cmds/usr/save.lpc (the only other place that legitimately updates
  // this field) requires before doing the same thing -- this room is
  // meant to be a brief death/limbo waypoint, not a permanent home. Fix:
  // don't touch startroom here at all -- leave the player's real,
  // previously-chosen (valid_startroom-flagged) login location intact;
  // the move() above already handles the immediate post-death placement.
  message("vision",
    "你忽然发现前面多了一个人影，不过那人影又好像已经在那里\n"
    "很久了，只是你一直没发觉。\n", environment(ob), ob);
}
