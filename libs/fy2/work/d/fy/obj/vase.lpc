// bag.c

inherit ITEM;

void create()
{
	set_name("白玉瓶", ({ "vase" }) );
	set_weight(500);
    set("no_get",1);
    set("no_shown",1);
    set("no_cleanup",1);
	set_max_encumbrance(8000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "口");
		set("long", "这是一只羊脂白玉瓶，里面插着几朵青龙卧墨池。\n");
		set("value", 1);
	}
}

int is_container() { return 1; }
