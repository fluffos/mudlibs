// tea_leaf.c

#include <weapon.h>

inherit THROWING;

void create()
{
	set_name("青龙卧墨池", ({ "flower" }) );
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long",	"这是有名的牡丹品种，现在已经不多见了。\n");
		set("unit", "把");
		set("base_unit", "朵");
		set("base_weight", 1);
		set("base_value", 10);
		set("material", "plant");
    }
	set_amount(3);
	setup();
}
