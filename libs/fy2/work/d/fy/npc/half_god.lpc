#include <ansi.h>
inherit NPC;
inherit F_MASTER;
int time_period(int timep, object me);
void create()
{
	set_name("天机老人", ({ "tianji" }) );
	set("gender", "男性");
	set("age", 99);
	set("title", HIB"天机一棍"NOR);
	set("long",
		"天机老人年过六甲，鹤发童颜。在兵器谱上排名第一，
尤在上官，小李之上．天机老人收徒极挑剔．．．．\n");
	set("attitude", "peaceful");
        set("skill_public",1);
	set("str", 26000);
	set("cor", 30);
	set("int", 24);
	set("cps", 30);
	set("force", 40000);
	set("max_force", 80000);
	set("force_factor", 1000);
	set("combat_exp", 10000000);
	set("score", 200000);
	set_temp("apply/damage",1000);
        set("chat_chance", 5);
        set("chat_msg", ({
                "天机老人拿起旱烟抽了几口．．．．\n",
                "天机老人把旱烟枪在鞋上磕了几磕。\n",
                "天机老人擦了擦旱烟枪，旱烟枪变的更亮了。\n",
                "天机老人往旱烟枪里加了些旱烟。\n",
        }) );
	set_skill("unarmed", 100);
	set_skill("force", 100);
	set_skill("iron-cloth", 100);
	set_skill("yiqiforce", 30);
	set_skill("dagger", 200);
	map_skill("iron-cloth", "yiqiforce");
        map_skill("force", "yiqiforce");
        map_skill("unarmed", "yiqiforce");
	create_family("天机派", 1, "祖师");
	setup();
	carry_object(__DIR__"obj/jade-ring")->wear();
	carry_object(__DIR__"obj/jade-pin")->wear();
	carry_object(__DIR__"obj/jade-boots")->wear();
	carry_object(__DIR__"obj/jade-cloth")->wear();
	carry_object(__DIR__"obj/yandou")->wield();
}
int accept_fight(object me)
{
        command("say 生命可贵！不要自寻死路！");
        return 0;
}
void init()
{
        add_action("give_quest", "quest");
}
int time_period(int timep, object me)
{
        int t, d, h, m, s;
        string time;
        t = timep;
        s = t % 60;             t /= 60;
        m = t % 60;             t /= 60;
        h = t % 24;             t /= 24;
        d = t;
        if(d) time = chinese_number(d) + "天";
        else time = "";
        if(h) time += chinese_number(h) + "小时";
        if(m) time += chinese_number(m) + "分";
        time += chinese_number(s) + "秒";
        tell_object(me,HIW "天机老人沉思了一会儿，说道：\n请在" + time + "内");
        return 1;
}
int accept_object(object who, object ob)
{
	int bonus, exp, pot, score, factor, times;
	string test;
	mapping quest;
    if( ob->name(1) == "银子" )
    {   
        if(ob->value() == 10100) {
        tell_object(who,"天机老人呵呵说道：好，好...\n");
    	who->set("quest", 0 );
        who->set_temp("quest_number", 0);
        return 1;}
        else return 0;
    }
        if(!(quest =  who->query("quest")) || userp(ob))
	{
        tell_object(who,"天机老人说道：这不是我想要的。\n");
	return 0;
	}
        if( ob->name(1) != quest["quest"])
        {
        tell_object(who,"天机老人说道：这不是我想要的。\n");
        return 0;
        }
// Falcon  96-08-18
// Destory the object after it was accepted by halfgod
//	destruct( ob );
        if ((int) who->query("task_time") < time() )
        {
        tell_object(who,"天机老人说道：真可惜！你没有在指定的时间内完成！\n");
        who->set_temp("quest_number",0);
                        return 1;
        }
        else
        {
    if(!who->query_temp("quest_number"))
    who->set_temp("quest_number",0);
    tell_object(who,"天机老人说道：恭喜你！你又完成了一项任务！\n");
    exp = quest["exp_bonus"] * 3 / 2;
// put a limit on max exp we can get from a quest
    if( exp > 120) exp = 120;
    exp = exp * (int)( who->query_temp("quest_number") + 1);
    exp = exp / 2 + random(exp / 2);
exp=exp *2;
    pot = exp/ 4 - 2;
pot=pot *2;
    if(pot < 0)pot = 0;
    pot += 1;
//      for weekly race, each quest worth same, 20
//        score = quest["score"]/2 + random(quest["score"]/2);
        score = 1;
/*      factor=who->query("quest_factor");
	if (factor)
	{
		exp=exp*factor/10;
		pot=pot*factor/10;
		score=score*factor/10;
	}*/
// zjun
    who->add("combat_exp", exp);
    who->add("potential", pot);
    who->add("score", score);
    tell_object(who,HIY"你被奖励了：\n" +
    chinese_number(exp) + "点实战经验\n"+
    chinese_number(pot) + "点潜能\n" +
    chinese_number(score)+"点综合评价\n"NOR);
    who->set("quest", 0 );
    if(who->query_temp("quest_number") < 4)
    who->add_temp("quest_number", 1);
    return 1;
        }
    return 1;
}
