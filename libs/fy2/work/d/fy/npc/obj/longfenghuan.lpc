// dagger.c : an example weapon

#include <weapon.h>
#include <ansi.h>

inherit HAMMER;

void create()
{
	set_name(BLU"龙凤双环"NOR, ({ "longfeng", "huan" }) );
	set_weight(20000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "");
		set("long", 
"这是兵器谱上排名第二的兵器－－龙凤双环。龙凤双环闪着蓝幽幽的
光，看起来十分沉重，没有一定力量是没法使的动的。\n");
		set("value", 500000);
		set("material", "steel");
	}
	init_hammer(105);

// These properties are optional, if you don't set them, it will use the
// default values.
     set("wield_msg", "$N拿出一把$n，试了试重量，然後握在手中。\n");
     set("unwield_msg", "$N放下手中的$n。\n");
// The setup() is required.

	setup();
}

