// cloth.c
//
// This is the basic equip for players just login.

#include <armor.h>

inherit CLOTH;

void create() {
  set_name("小红褂", ({ "red cloth", "cloth" }));
  set_weight(300);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("value", 100);
    set("long", "这是一件小孩爱穿的小红褂。\n");
    set("material", "cloth");
    set("armor_prop/armor", 1);
  }
  setup();
}
