// cloth.c
//
// This is the basic equip for players just login.

#include <armor.h>

inherit CLOTH;

void create()
{
	set_name("青竹蓑", ({ "zhu cloth", "cloth" }) );
	set_weight(4000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "件");
		set("value", 70000);
		set("material", "cloth");
		set("armor_prop/armor", 10);
	}
	setup();
}
