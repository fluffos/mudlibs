// dumpling.c

inherit ITEM;
inherit F_FOOD;

void create() {
  set_name("橄榄鱼翅", ({ "glyc" }));
  set_weight(80);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一盘香喷喷的橄榄鱼翅。\n");
    set("unit", "盘");
    set("value", 15000);
    set("food_remaining", 1);
    set("food_supply", 30);
  }
}
