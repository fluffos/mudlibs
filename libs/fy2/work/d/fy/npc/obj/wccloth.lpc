// cloth.c
//
// This is the basic equip for players just login.

#include <armor.h>
#include <ansi.h>

inherit CLOTH;

void create() {
  set_name(BLU "五" RED "彩" HIY "紧" HIG "身" MAG "裙" NOR, ({ "five skirt", "skirt" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("value", 10000);
    set("long", "这是一件五彩斑斓的裙子。\n");
    set("material", "cloth");
    set("armor_prop/armor", 2);
  }
  setup();
}
