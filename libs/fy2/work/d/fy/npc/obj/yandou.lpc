// dagger.c : an example weapon

#include <weapon.h>
#include <ansi.h>

inherit DAGGER;

void create() {
  set_name(MAG "长柄旱烟枪" NOR, ({ "hanyan" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long", "这是天机老人的随身兵刃，看上去闪闪发光，乃是熟铜所制。\n");
    set("value", 3);
    set("material", "steel");
  }
  init_dagger(90);

  // These properties are optional, if you don't set them, it will use the
  // default values.

  set("wield_msg", "$N从腰后拔出一根$n握在手中。\n");
  set("unwield_msg", "$N将手中的$n掖入腰后。\n");

  // The setup() is required.

  setup();
}
