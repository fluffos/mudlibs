// dumpling.c

inherit ITEM;
inherit F_FOOD;

void create()
{
	set_name("油辣猪排", ({ "ylzp" }) );
	set_weight(80);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "一盘香喷喷的油辣猪排。\n");
		set("unit", "盘");
		set("value", 1500);
		set("food_remaining", 1);
		set("food_supply", 30);
	}
}
