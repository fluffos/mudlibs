// dog_m.c

inherit ITEM;
inherit F_FOOD;

void create()
{
        set_name("花生", ({ "small dish", "dish" }) );
        set_weight(100);
        if( clonep() )
                set_default_object(__FILE__);
        else {
		set("long", "小地方的花生，虽然粗糙，但也别有一番风味。\n");
		set("unit", "碟");
		set("value", 2);
        	set("food_remaining", 4);
		set("food_supply", 20);
	}

        setup();
}

int finish_eat()
{
        set_name("缺口的小碟子", ({ "plate" }) );
        set_weight(50);
        set("long", "一个缺口的小碟子。\n");
        return 1;
}

	
