// cloth.c
//
// This is the basic equip for players just login.

#include <armor.h>

inherit CLOTH;

void create()
{
	set_name("金钱袍", ({ "jinqian pao", "cloth" }) );
	set_weight(3000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "件");
		set("value", 1000);
		set("long", "这是金钱帮帮众统一穿的服装。\n");
		set("material", "cloth");
		set("armor_prop/armor", 5);
	}
	setup();
}
