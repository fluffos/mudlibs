// dumpling.c

inherit ITEM;
inherit F_FOOD;

void create()
{
	set_name("卤味儿", ({ "luwei" }) );
	set_weight(100);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "一袋乌糟糟的卤味儿，看上去并不好吃。\n");
		set("unit", "盘");
		set("value", 2000);
		set("food_remaining", 2);
		set("food_supply", 60);
	}
}
