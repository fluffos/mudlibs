// dumpling.c

inherit ITEM;
inherit F_FOOD;

void create()
{
	set_name("小炒粉丝", ({ "xcfs" }) );
	set_weight(80);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "一盘香喷喷的小炒粉丝。\n");
		set("unit", "盘");
		set("value", 1000);
		set("food_remaining", 1);
		set("food_supply", 30);
	}
}
