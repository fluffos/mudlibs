// dagger.c : an example weapon

#include <weapon.h>
#include <ansi.h>

inherit HAMMER;

void create()
{
	set_name("石锁", ({ "stone hammer", "hammer" }) );
	set_weight(10000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "柄");
		set("long", "这是一柄练功专用的石锁。\n");
		set("value", 50);
		set("material", "stone");
	}
	init_hammer(15);

// These properties are optional, if you don't set them, it will use the
// default values.

// The setup() is required.
	setup();
}
