// dumpling.c

inherit ITEM;
inherit F_FOOD;

void create()
{
	set_name("大白菜", ({ "big cabbage", "cabbage" }) );
	set_weight(80);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "一把青翠欲滴的大白菜。\n");
		set("unit", "把");
		set("value", 30);
		set("food_remaining", 3);
		set("food_supply", 30);
	}
}
