// cloth.c
//
// This is the basic equip for players just login.

#include <armor.h>

inherit CLOTH;

void create()
{
	set_name("翠花小袄", ({ "cuihua xiaoao", "cloth" }) );
	set_weight(3000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "件");
		set("long", "这是楚楚最爱穿的一件衣服。\n");
		set("value", 10000);
		set("material", "cloth");
		set("armor_prop/armor", 1);
	}
	setup();
}
