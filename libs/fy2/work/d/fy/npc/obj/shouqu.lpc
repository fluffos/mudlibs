// token.c


inherit ITEM;

void create()
{
        set_name("煮熟了的蛆", ({ "qu" }) );
        set_weight(10);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "条");
                set("material", "rib");
                set("value", 0);
        }
        setup();
}
