// cloth.c
//
// This is the basic equip for players just login.

#include <armor.h>
#include <ansi.h>

inherit CLOTH;

void create() {
  set_name(BLU "太极八卦道袍" NOR, ({ "eight cloth", "cloth" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("long", "这件衣服上写满了符咒，看来有些奥妙。\n");
    set("material", "cloth");
    set("value", 40000);
    set("armor_prop/armor", 20);
  }
  setup();
}
