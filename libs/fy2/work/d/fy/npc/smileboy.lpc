// teacher.c

inherit NPC;

void create() {
  set_name("金童", ({ "jintong" }));
  set("gender", "男性");
  set("age", 12);
  set("long", "一个天真无邪，未懂世事的小金童\n");
  set("attitude", "heroism");
  set("combat_exp", 500000);
  set_skill("unarmed", 100);
  set_skill("dodge", 100);
  set_skill("move", 100);
  set("max_force", 3000);
  set("force", 3000);
  set("force_factor", 10);
  set("chat_chance", 15);
  set("chat_msg", ({
    "金童看了你一眼，然后捂住嘴开始＂吃吃＂的笑。\n",
  }));
  setup();
  set("score", 5);
  carry_object(__DIR__ "obj/qhcloth")->wear();
}
