
#include <ansi.h>

inherit NPC;

void create()
{
        set_name("风云大衙役", ({ "yayi" }) );
        set("long",
"正在上堂的衙役，千万不要惹他们\n");
        set("attitude", "heroism");
        set("vendetta_mark", "authority");
        set("str", 47);
        set("cor", 26);
        set("cps", 25);
        set("combat_exp", 1000000+random(100) * 10000);
        set("chat_chance_combat", 15);
        set("chat_msg_combat", ({
                "风云大衙役喝道：还不快放下武器束手就缚？\n",
                "风云大衙役喝道：大胆刁民竟敢拒捕？反了！反了！\n"
        }) );
        set_skill("unarmed", 100+random(200));
        set_skill("dagger", 100+random(200));
        set_skill("parry", 100+random(200));
        set_skill("dodge", 100+random(200));
        set_skill("move", 100+random(200));

        set_temp("apply/attack", 100);
        set_temp("apply/defense", 100);
        set_temp("apply/armor", 70);
        set_temp("apply/damage", 50+random(100));
        set_temp("apply/move", 100);
        set("max_force", 1000);
        set("force", 1000);

        setup();

        carry_object(__DIR__"obj/fycf")->wear();
        carry_object(__DIR__"obj/swb")->wield();
}

void init()
{
        object ob;
        ::init();

	if( interactive(ob = this_player()) && !is_fighting() ) {
        if(ob->query("class") == "official" && 
ob->query("combat_exp") > 512000 && random(4) )
        set_leader(ob);
	}
}

