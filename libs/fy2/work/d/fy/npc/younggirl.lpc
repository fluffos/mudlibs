// tufei1.c

inherit NPC;

void create() {
  set_name("大辫子姑娘", ({ "younggirl" }));
  set("gender", "女性");
  set("age", 25);
  set("long", @LONG
一个美丽又善良，有一双温柔的大眼睛，辫子粗又长的姑娘
LONG);
  set("combat_exp", 2000 + random(100) * 20);

  set("attitude", "peaceful");

  set("apply/attack", 20 + random(10));
  set("apply/defense", 20 + random(10));

  set("max_force", 400);
  set("force", 400);

  set("force_factor", 3);
  setup();

  carry_object("/obj/cloth")->wear();
  add_money("gold", 1);
}
