// tea_waiter.c

inherit NPC;
inherit F_VENDOR;

void create()
{
        set_name("驼背老汉", ({ "han" }) );
        set("gender", "男性" );
        set("age", 60);
        set("long",
       "这位老汉好象快不行了．．．\n");
	set("combat_exp", 500);
        set("attitude", "friendly");
        set("chat_chance", 3);
        set("vendor_goods", ([
                __DIR__"obj/hsm":11,
                __DIR__"obj/xhg":11,
                __DIR__"obj/xlbt":11,
                __DIR__"obj/bigwine":11,
        ]) );
        setup();
}

void init()
{
        add_action("do_vendor_list", "list");
}
