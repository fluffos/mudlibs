// worker.c

inherit NPC;

void create()
{
        set_name("铁传甲", ({ "royal servant" }) );
        set("gender", "男性" );
        set("age", 39);
        set("long", "他是小李飞刀的贴心佣人，向来和李探花形影不离。 \n");
        set("combat_exp", 500000);
        set("attitude", "friendly");
	set_skill("force",  100); 
	set_skill("unarmed",100);
	set_skill("sword",  100);
	set_skill("dodge",  100);
	set_skill("parry",  100);
    set_skill("iron-cloth", 100);
	set("max_force",4000);
	set("force",4000);
    set("force_factor", 30);

	setup();
    carry_object("/obj/cloth")->wear();
}

