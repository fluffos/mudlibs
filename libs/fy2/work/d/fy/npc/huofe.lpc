// teacher.c

inherit NPC;

void create() {
  set_name("活佛", ({ "huofe" }));
  set("gender", "男性");
  set("age", 100);
  set("long",
    "塞外活佛，到中原来旅游．\n");
  set("attitude", "friendly");
  set("combat_exp", 1500000);
  set_skill("unarmed", 100);
  set_skill("dodge", 100);
  set_skill("move", 100);
  set_skill("force", 100);
  set("max_force", 3000);
  set("force", 3000);

  setup();
  set("score", 5);
  carry_object(__DIR__ "obj/jiasha")->wear();
}
