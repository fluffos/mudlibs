// weaponor.c

inherit NPC;
inherit F_VENDOR;

void create()
{
        set_name("诸葛雷", ({ "zhuge" }) );
        set("title", "兵器铺");
        set("gender", "男性" );
        set("age", 32);
        set("long", 
"金狮镖局的大镖头，手底下还可以．\n");
        set("combat_exp", 300000);
        set("attitude", "heroism");
        set_skill("unarmed", 100);
        set_skill("dodge", 100);
        set_skill("move", 100);
        set_skill("sword", 100);
        set_skill("parry", 100);
        set_skill("force", 100);
        set_skill("celestial", 100);
        set_skill("six-chaos-sword", 100);
        set_skill("pyrobat-steps", 100);
        map_skill("sword", "six-chaos-sword");
        map_skill("parry", "six-chaos-sword");
        map_skill("force", "celestial");
        map_skill("dodge", "pyrobat-steps");
        map_skill("move", "pyrobat-steps");

        set("inquiry", ([
                "兵器屋" : "本店专卖各种长短兵器", 
        ]) );

        set("vendor_goods", ([
        "/obj/weapon/longsword" : 50,
        "/obj/weapon/whip" : 50,
        "/obj/weapon/dart" : 50,
        "/obj/weapon/shield" : 50,
        "/obj/weapon/sixhammer" : 50,
        "/obj/weapon/thin_sword" : 50,
        "/obj/weapon/dagger.lpc" : 50,
        "/obj/weapon/staff.lpc" : 50,
        "/obj/weapon/blade.lpc" : 50,
        "/obj/weapon/ring.lpc" : 50,
        ]) );

        setup();
        add_money("silver", 50);
        carry_object(__DIR__"obj/jinzhuang")->wear();
        carry_object("/obj/weapon/longsword")->wield();
}

void init()
{
        object ob;

        ::init();
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
        }
        add_action("do_vendor_list", "list");


}

void greeting(object ob)
{
        if( !ob || environment(ob) != environment() ) return;
        switch( random(4) ) {
                case 0:
                        say( "诸葛雷道：这位"
                                + RANK_D->query_respect(ob)
                                + "，自个儿挑一件称手的兵器吧\n");
                        break;
                case 1:
                        say( "诸葛雷突然间出了神，好象想起了他的往事\n");
                        break;
        }
}

