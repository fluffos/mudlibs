// waiter.c

inherit NPC;
inherit F_VENDOR;

#include <ansi.h>
void create()
{
	set_name("芳儿", ({ "fang" }) );
	set("gender", "女性" );
	set("age", 24);
	set("title", RED "倾城胭脂店老板" NOR);
	set("long",
		"这位年轻风骚的老板正对你狂抛媚眼儿。\n");
	set("combat_exp", 100000);
	set("attitude", "peaceful");
	set("per",30);
	set("vendor_goods", ([
                __DIR__"obj/baohuayou":20,
                __DIR__"obj/huafendai":20,
                __DIR__"obj/yanzhi":20,
                __DIR__"obj/zhouzhi":10,
	]) );
	set_skill("unarmed",50);
	set_skill("dodge",50);
	setup();
	carry_object(__DIR__"obj/wccloth")->wear();
}

void init()
{	
	object ob;

	::init();
	if( interactive(ob = this_player()) && !is_fighting() ) {
		remove_call_out("greeting");
		call_out("greeting", 1, ob);
	}
	add_action("do_vendor_list", "list");
}

void greeting(object ob)
{
	if( !ob || environment(ob) != environment() ) return;
	switch( random(5) ) {
		case 0:
message_vision("$N笑着说道：这儿什么都有，买些回去给你的心上人吧。\n",this_object(),ob);
			break;
		case 1:
message_vision("$N笑咪咪地说道：这位"+RANK_D->query_respect(ob)+
"要买什么东西？\n",this_object(),ob);
			break;
	}
}

int accept_object(object who, object ob)
{
    string target;
    object obj, mask;
    if ((string)ob->query("id") != "pozhi")
    return 0;
    if (!stringp(ob->query("targetid")))
    return notify_fail("芳儿悄悄的告诉你，你要装成谁啊。\n");
    target = ob->query("targetid");
	obj = find_player(target);
	if( !obj || !who->visible(obj) || wizardp(obj) )
		obj = find_living(target);
    if(!obj){
    write("芳儿告诉你，好象没有这个人。\n");
    return 0;}
    mask = new ("/obj/renpimask");
    mask -> set("armor_prop/name", ({obj->name()})  );
    mask -> set("armor_prop/short", ({obj ->short()}));
    mask -> set("armor_prop/long", ({obj ->long()}));
    mask -> move(who);
    return 1;
}
 
