#include <ansi.h>
inherit ROOM;

void create() {
  object con, item;
  set("short", "经楼");
  set("long", @LONG
上了楼来, 首先你看到一幅张天师的画像挂在对面的墙上, 画像
的下方摆著一张覆著红布的桌子, 桌上整齐地放著茅山的镇教秘籍。
LONG
  );
  set("exits", ([ /* sizeof() == 1 */
    "down": __DIR__ "canjingge",
  ]));
  set("valid_startroom", 1);
  set("objects", ([
    __DIR__ "npc/master": 1,
    __DIR__ "npc/up_taoist": 2,
    __DIR__ "obj/desk": 1,
    __DIR__ "obj/book": 1,
  ]));
  set("outdoors", "taoguan");
  setup();
  con = present("desk", this_object());
  item = present("necromancy_book", this_object());
  item->move(con);
}
