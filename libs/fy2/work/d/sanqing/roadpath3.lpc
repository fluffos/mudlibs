#include <ansi.h>
inherit ROOM;

void create() {
  set("short", "藏经阁入口");
  set("long", @LONG
这是藏经阁的门口，你看到门前一个硕大的匾额(sign)，上边以
楷书写着〔藏经阁〕三个大字，边上有一行小字，但是岁月倾蚀，已
经看不清楚了。在门口的两侧有着两座栩栩如生的雕像，似乎直盯着
你看。
LONG
  );
  set("exits", ([ /* sizeof() == 1 */
    "south": __DIR__ "roadpath2",
    "north": __DIR__ "canjingge",
  ]));

  set("item_desc", ([ /* sizeof() == 1 */
    "sign": "\n\n            ,,   ;;                                               ,,, 
          ';;  ,,;,,,;;        ,,,                   ,,,;';,  ;;'''';;
      ;;;'';;   ;  ,,          ;;     ;;;;''''       ;; ,,;;   ;,;' ;;
                ;;  ';        ;' ;;, ,   ,,  ;,       ;'' ;;   ; ,,,;;
     ,  ,,,,,,;';;''        ,;' ,;'  ;; ;;' ;'        ;,;'';;,,'''  ;;
     ;;  ; ,,,,,,;,  ,     ';'';'   ;' ,;  ';,,       ;   ,;'';;    ;;
     ;;''; ;';;  '; ,;'      ,;',;, ';, ';   ''       ;  ' ';;;     ;;
        ,; ;''';; ;;;'      ;;;'' '   ' ,,,,,,        ;   ,;' ';,,  ;;
   '';;';' ;,,,'   ;;         ,  ;, '''';;''         ,; ,';,,,;;;''';;
     ;' ;  ; ;,,, ;';;,  ,';, ';  '     ;;  ,,,,     ;;   ;;  ,;',,,;;
   ,'  ;' ''    ;;'  ';,;; ';     ,,;'''''''''''''   ';    ;''''  ';;;
                                                                

                                                " + HIR "非本派弟子不得进入\n\n" NOR,
  ]));
  setup();
}

int valid_leave(object me, string dir) {
  if (dir == "north" && (string)me->query("family/family_name") != "三清宫" && me->query("class"))
    return notify_fail("你感到有什么神秘力量在阻挡着你，你觉得力不从心。\n");
  else return 1;
}
