// bottle.c

inherit ITEM;
inherit F_LIQUID;

void create() {
  set_name("橘子", ({ "orange", "sour orange" }));
  set_weight(80);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "这是一个又酸又小的橘子。\n");
    set("unit", "个");
    set("value", 80);
    set("max_liquid", 60);
  }

  // The liquid contained in the container is independent, we set a copy
  // in each cloned copy.
  set("liquid", ([
    "type": "water",
    "name": "橘子汁",
    "remaining": 6,
  ]));
}
