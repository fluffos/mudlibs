// Room: /d/snow/weapon_storage.c

inherit ROOM;

void create() {
  set("short", "比武场");
  set("long", @LONG
		这是一个用来比武的场所
LONG
  );
  set("exits", ([
    "south": __DIR__ "weapon_storage",
  ]));
  set("compare", 1);

  setup();
}


void init() {
  object ob;

  ob = this_player();
  if (!(userp(ob))) {
    destruct(ob);
  }
}
