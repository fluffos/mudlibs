inherit ROOM;
void create() {
  set("short", "千佛山角");
  set("long", @LONG
千佛山，又名历山，是中国佛教名山之一，从此向东眺望，一座
青山耸立，南北向绵延不绝，山腰处隐约可见几间瓦房，在青松翠柏
的掩映下格外超凡脱俗。西边是一条阳关大道，北边是几间格调清雅
的别墅。
LONG
  );
  set("exits", ([
    "west": __DIR__ "road1",
    "east": __DIR__ "road3",
  ]));
  set("objects", ([
    __DIR__ "npc/bonze": 1
  ]));
  set("outdoors", "qianfe");
  setup();
  replace_program(ROOM);
}
