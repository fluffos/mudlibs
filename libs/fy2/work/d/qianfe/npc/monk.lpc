inherit NPC;
void create() {
  string *order = ({ "朝拜", "扫地", "烧饭", "挑水", "砍柴", "淘米" });
  set_name((order[random(6)]) + "的和尚", ({ "monk" }));
  set("gender", "男性");
  set("age", 22);
  set("long", "这是兴国禅寺的和尚，正在忙着\n");
  set("combat_exp", 8000);
  set("attitude", "friendly");
  set_skill("unarmed", 50);
  set_skill("notracesnow", 30);
  set_skill("dodge", 40);
  set_skill("force", 40);
  map_skill("dodge", "notracesnow");
  set("force", 1000);
  set("force_factor", 2);
  set("max_force", 1000);
  set("chat_chance", 10);
  set("chat_msg", ({
    "小和尚抬手擦了擦汗．．．\n",
    (: random_move :),
  }));

  setup();
  carry_object(__DIR__ "obj/huicloth")->wear();
  carry_object(__DIR__ "obj/needle");
}
