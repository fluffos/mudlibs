inherit NPC;
int fight_him();
void create() {
  set_name("老实和尚", ({ "lao shi" }));
  set("gender", "男性");
  set("age", 22);
  set("long", "老实和尚整天疯疯癫癫，怪里怪气的．他的功夫也是如此．
老实和尚从来不说谎话，所以得名＂老实和尚＂\n");
  set("combat_exp", 100000);
  set("attitude", "friendly");
  set_skill("unarmed", 50);
  set_skill("notracesnow", 30);
  set_skill("dodge", 40);
  set_skill("force", 40);
  map_skill("dodge", "notracesnow");
  set("force", 1000);
  set("force_factor", 10);
  set("max_force", 1000);
  set("amount", 6);
  set("chat_chance", 10);
  set("chat_msg", ({
    "老实和尚嘿嘿的对着你笑。\n",
    (: random_move :),
  }));
  set("inquiry", ([
    "七彩丝缎带": (: fight_him :)
  ]));
  setup();
  carry_object(__DIR__ "obj/huicloth")->wear();
}

int fight_him() {
  object ob;
  if (query("amount") < 1) {
    command("say 你来迟了，七彩丝缎带都已经送人了。");
    return 1;
  }
  ob = this_player();
  command("say 想要七彩丝缎带？凭功夫拿吧。");
  this_object()->fight_ob(ob);
  ob->fight_ob(this_object());
  call_out("checking", 1, this_object(), ob);
  return 1;
}

int checking(object me, object ob) {

  object obj;
  int my_max_kee, his_max_kee;
  my_max_kee = me->query("max_kee");
  his_max_kee = ob->query("max_kee");

  if (me->is_fighting()) {
    if ((me->query("kee") * 100 / my_max_kee) <= 80)
      command("exert recover");
    call_out("checking", 1, me, ob);
    return 1;
  }

  if (!present(ob, environment())) return 1;

  if (((int)me->query("kee") * 100 / my_max_kee) <= 60) {
    command("say 果然厉害，恭喜你拿到七彩丝缎带！\n");
    add("amount", -1);
    obj = new(__DIR__ "obj/silk");
    obj->move(ob);
    return 1;
  }

  if (((int)ob->query("kee") * 100 / his_max_kee) < 60) {
    command("say 看来" + RANK_D->query_respect(ob) +
      "你的功夫还不够，江湖险恶，小心把小命送掉 !\n");
    return 1;
  }
  return 1;
}
