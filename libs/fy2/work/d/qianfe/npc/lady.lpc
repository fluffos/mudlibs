// girl.c

inherit NPC;

string ask_youngman();

void create() {
  set_name("千金小姐", ({ "lady" }));
  set("long", "一个衣饰华丽的妇人正跪在这里虔诚地膜拜著。\n");
  set("age", 23);
  set("gender", "女性");
  set("attitude", "peaceful");
  set("combat_exp", 10);
  setup();
  carry_object(__DIR__ "obj/lady_dress")->wear();
  carry_object(__DIR__ "obj/silver_clasp")->wear();
}
