// feng.c
#include <ansi.h>
inherit NPC;

int give_me();

void create()
{
        set_name("云流", ({ "yunliu" }) );
        set("gender", "男性");
        set("age", 50);
        set("combat_exp", 200000);
        set("attitude", "peaceful");
        set("class", "bonze");

        set("force", 1000);
        set("max_force", 1000);
        set("force_factor", 20);

        set("inquiry", ([
        		"弹琴": (: give_me :),
                "兴国": 
"兴国大师乃我的师叔祖，在八识神通方面有极深的造诣。\n",
                "兴国大师": 
"兴国大师乃我的师祖叔，在八识神通方面有极深的造诣。\n",
                "定邦": 
"定邦大师乃我的师叔，在少林长拳方面有极深的造诣。\n",
                "定邦大师": 
"定邦大师乃我的师叔，在少林长拳方面有极深的造诣。\n",
                "参机": 
"参机大师乃我的师父，是本寺第一高手。\n",
                "参机大师": 
"参机大师乃我的师父，是本寺第一高手。\n"
        ]) );

        set("title", "兴国禅寺云字辈大师");
        set("long", "他是兴国禅寺中颇有威望的云字辈大师\n");
        set_skill("dodge", 100);
        set_skill("force", 100);
        set_skill("literate", 100);
        set_skill("buddhism", 100);
        set_skill("notracesnow", 100);
        set_skill("parry", 100);
        set_skill("lotusforce", 100);
    	set_skill("unarmed", 100);
        set_skill("chanting", 100);
        set_skill("cloudstaff", 100);
        set_skill("magic", 100);
        set_skill("staff", 100);
        set_skill("changquan", 100);

        map_skill("force", "lotusforce");
        map_skill("staff", "cloudstaff");
        map_skill("parry", "cloudstaff");
        map_skill("dodge", "notracesnow");
        map_skill("unarmed", "changquan");

        setup();

        carry_object(__DIR__"obj/huicloth")->wear();
        carry_object(__DIR__"obj/rshoe")->wear();
        carry_object(__DIR__"obj/qin");
}

int give_me()
{
        object qin, me;

    	me = this_player();
        if( qin = present("qin", this_object())) {  
        command("say 这把古琴你拿去练吧！！");
        qin->move(me);
        }
        else 
        command("say 我的古琴已送人了！");
        return 1;
}

