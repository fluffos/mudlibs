// shoe.c

#include <armor.h>

inherit BOOTS;

void create() {
  string *names = ({
    "棉布", "紫布", "蓝布", "黑布", "洗得发白的", "粗布"
  });
  set_name(names[random(sizeof(names))] + "僧鞋", ({ "monk shoes", "shoes" }));
  set_weight(900);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("material", "cloth");
    set("unit", "双");
    set("value", 0);
    set("armor_prop/armor", 1);
    set("male_only", 1);
  }
  setup();
}
