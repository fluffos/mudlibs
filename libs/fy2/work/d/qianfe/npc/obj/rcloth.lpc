// jiasha.c

#include <armor.h>

inherit CLOTH;

void create()
{
    string *names = ({
    "棉布", "紫布", "蓝布", "黑布", "洗得发白的"
    });
	set_name(names[random(sizeof(names))]+"僧衣", ({ "monk cloth", "cloth" }) );
	set_weight(2000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "这件"+query("name")+"僧衣洗得很是干净。\n");
		set("unit", "件");
		set("value", 100);
		set("material", "cloth");
		set("armor_prop/armor", 2);
		set("male_only", 1);
	}
	setup();
}

