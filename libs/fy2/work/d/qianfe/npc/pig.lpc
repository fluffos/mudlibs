// girl.c

inherit NPC;

string ask_youngman();

void create()
{
	set_name("丧尽天良的畜生", ({ "pig" }) );
	set("long", "这个人正在光天化日下强奸民女！！！\n");
	set("age", 33);
	set("gender", "男性");
	set("attitude", "heroism");
	set("combat_exp", 1000);
    set("chat_chance", 80);
        set("chat_msg", ({
        "丧尽天良的畜生脱下了千金小姐的袜子\n",
        "丧尽天良的畜生脱下了千金小姐的鞋子\n",
        "丧尽天良的畜生脱下了千金小姐的裙子\n",
        "丧尽天良的畜生脱下了千金小姐的裤子\n",
        "丧尽天良的畜生脱下了千金小姐的银簪\n",
        "丧尽天良的畜生脱下了千金小姐的上衣\n",
        "丧尽天良的畜生脱下了千金小姐的小衣\n"
        }) );
     
	setup();
	carry_object("/obj/cloth")->wear();
}

void die()
{
    object killer;
    if( objectp(killer = query_temp("last_damage_from")) )
        killer->set_temp("bonze/pig", 1);  
  ::die();
}
