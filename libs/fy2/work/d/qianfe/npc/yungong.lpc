// feng.c
#include <ansi.h>
inherit NPC;

int give_me();

void create()
{
        set_name("云飞", ({ "yunfei" }) );
        set("gender", "男性");
        set("age", 52);
        set("combat_exp", 3000000);
        set("attitude", "peaceful");
        set("class", "bonze");

        set("force", 10000);
        set("max_force", 10000);
        set("force_factor", 50);

        set("inquiry", ([
                "兴国": 
"兴国大师乃我的师叔祖，在八识神通方面有极深的造诣。\n",
                "兴国大师": 
"兴国大师乃我的师祖叔，在八识神通方面有极深的造诣。\n",
                "定邦": 
"定邦大师乃我的师叔，在少林长拳方面有极深的造诣。\n",
                "定邦大师": 
"定邦大师乃我的师叔，在少林长拳方面有极深的造诣。\n",
                "参机": 
"参机大师乃我的师父，是本寺第一高手。\n",
                "参机大师": 
"参机大师乃我的师父，是本寺第一高手。\n"
        ]) );

        set("title", "兴国禅寺云字辈大师");
        set("long", "他是兴国禅寺中颇有威望的云字辈大师\n");
        set_skill("dodge", 200);
        set_skill("force", 200);
        set_skill("literate", 200);
        set_skill("buddhism", 200);
        set_skill("notracesnow", 200);
        set_skill("parry", 200);
        set_skill("lotusforce", 200);
    	set_skill("unarmed", 200);
        set_skill("chanting", 200);
        set_skill("cloudstaff", 200);
        set_skill("magic", 200);
        set_skill("staff", 200);
        set_skill("changquan", 200);

        map_skill("force", "lotusforce");
        map_skill("staff", "cloudstaff");
        map_skill("parry", "cloudstaff");
        map_skill("dodge", "notracesnow");
        map_skill("unarmed", "changquan");

        setup();

        carry_object(__DIR__"obj/huicloth")->wear();
        carry_object(__DIR__"obj/rshoe")->wear();
}

