// canji.c
#include <ansi.h>
inherit NPC;
inherit F_MASTER;

void create() {
  set_name("参机大师", ({ "master can", "master", "can" }));
  set("gender", "男性");
  set("age", 74);
  set("combat_exp", 600000);
  set("score", 18000);
  set("attitude", "peaceful");
  set("class", "bonze");

  set("str", 60);
  set("int", 30);
  set("cor", 20);
  set("con", 30);
  set("cps", 30);
  set("spi", 30);

  set("force", 3000);
  set("max_force", 3000);
  set("force_factor", 10);

  set("inquiry", ([
    "兴国":
    "兴国大师乃我的师叔，在八识神通方面有极深的造诣。\n",
    "兴国大师":
    "兴国大师乃我的师叔，在八识神通方面有极深的造诣。\n",
    "定邦":
    "定邦大师乃我的师弟，在少林长拳方面有极深的造诣。\n",
    "定邦大师":
    "定邦大师乃我的师弟，在少林长拳方面有极深的造诣。\n"
  ]));

  create_family("兴国禅寺", 4, "住持");

  set_skill("dodge", 30);
  set_skill("force", 100);
  set_skill("literate", 60);
  set_skill("buddhism", 100);
  set_skill("notracesnow", 40);
  set_skill("parry", 50);
  set_skill("lotusforce", 100);
  set_skill("unarmed", 80);
  set_skill("chanting", 100);
  set_skill("cloudstaff", 100);
  set_skill("magic", 100);
  set_skill("staff", 100);

  map_skill("force", "lotusforce");
  map_skill("staff", "cloudstaff");
  map_skill("parry", "cloudstaff");
  map_skill("dodge", "notracesnow");

  setup();

  carry_object(__DIR__ "obj/chu")->wield();
  carry_object("/obj/cloth")->wear();
}

void attempt_apprentice(object ob) {
  call_out("do_recruit", 2, ob);
}

void do_recruit(object ob) {
  command("say 阿弥陀佛，善哉！善哉！");
  command("recruit " + ob->query("id"));
}

int recruit_apprentice(object ob) {
  if ( ::recruit_apprentice(ob))
    ob->set("title", "兴国禅寺俗家弟子");
}

void init() {
  add_action("give_quest", "quest");
}
