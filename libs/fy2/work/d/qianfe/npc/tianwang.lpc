inherit NPC;
void create() {
  string *names = ({
    "广目", "增长", "多闻", "持国" });
  set_name(names[random(sizeof(names))] + "天王", ({ "lishi" }));
  set("gender", "男性");
  set("age", 42);
  set("no_shown", 1);
  set("long", "面貌雄伟，作忿怒相，上半身赤裸，两脚张开，呈紧张状．\n");
  set("combat_exp", 400000);
  set("attitude", "heroism");
  set_skill("staff", 50);
  set_skill("cloudstaff", 100);
  set_skill("unarmed", 50);
  set_skill("notracesnow", 30);
  set_skill("dodge", 40);
  set_skill("force", 40);
  map_skill("staff", "cloudstaff");
  map_skill("parry", "cloudstaff");
  map_skill("dodge", "notracesnow");
  set("force", 1000);
  set("force_factor", 20);
  set("max_force", 1000);

  setup();
  carry_object(__DIR__ "obj/chu")->wield();
}
