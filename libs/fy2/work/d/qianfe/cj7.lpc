inherit ROOM;
void create() {
  set("short", "韦驮殿");
  set("long", @LONG
韦驮天王为南天王部下八将之一，以勇武著称，现将军身，守护
伽蓝，为禅寺的守护神，双手合十，横宝杵于两腕，两足平立，注视
出入行人。
LONG
  );
  set("exits", ([
    "westup": __DIR__ "cj8",
    "eastup": __DIR__ "cj9",
    "south": __DIR__ "cj4",
    "north": __DIR__ "cj10"
  ]));
  set("objects", ([
    __DIR__ "npc/yunliu": 1
  ]));
  setup();
}
