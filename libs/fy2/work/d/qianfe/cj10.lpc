inherit ROOM;
void create()
{
        set("short", "观音殿");
        set("long", @LONG
观音殿供奉的是观世音菩萨，手持杨枝水瓶，乘狮立于普陀洛伽
山海之间，左右两菩萨协伺，乘象者为普贤菩萨，乘狮为文殊菩萨，
其四围为“华岩经”善财五十三参。
LONG
        );
        set("exits", ([ 
  "south"   : __DIR__"cj7",
  "west"   : __DIR__"cj11",
  "east"   : __DIR__"cj12",
  "north"   : __DIR__"cj13"
]));
        set("objects", ([   
        __DIR__"npc/yunhai" : 1
])  );
        setup();
        replace_program(ROOM);
}

