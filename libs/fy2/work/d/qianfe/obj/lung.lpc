// token.c


inherit ITEM;

void create()
{
        set_name("铜人的肺部", ({ "lung" }) );
        set("no_get", 1);
        set("no_shown", 1);
        set_weight(10);
        set_max_encumbrance(5);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("material", "copper");
                set("value", 0);
        }
        setup();
}

int is_container() { return 1; }

