inherit ROOM;
void create()
{
        set("short", "枯梅堂");
        set("long", @LONG
堂中洁净如洗，檀香飘渺。此堂虽以枯梅命名，却实为上好檀香
木打造。房顶很高，上挂八盏油灯，灯芯闪烁散发出袅袅白烟。阳光
映射白烟，留下条条光痕。
LONG
        );
        set("exits", ([ /* sizeof() == 4 */
  "west":  __DIR__"road5",
  "east":  __DIR__"road7",
]));
        set("objects", ([
        __DIR__"npc/oldman" : 1,
])  );
        setup();
        replace_program(ROOM);
}

