// dumpling.c

inherit ITEM;
inherit F_FOOD;

void create() {
  string *names = ({
    "大青菜", "大白菜", "小青菜", "小白菜",
    "绿豆苗", "青豆"
  });

  set_name(names[random(sizeof(names))], ({ "vegetable" }));
  set_weight(80);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一把青翠欲滴的" + query("name") + "。\n");
    set("unit", "把");
    set("value", 15);
    set("food_remaining", 3);
    set("food_supply", 20);
  }
}
