inherit ROOM;
void create()
{
        set("short", "梅林小路");
        set("long", @LONG
一条踏出的小路盘旋曲折。路边的梅树下一朵朵无名小花份外妖
窈。花有兰有紫，有些还有浇灌过的痕迹。繁密的梅枝间透下点点日
光，枝条摇摆，忽明忽暗。
LONG
        );
        set("exits", ([ /* sizeof() == 4 */
  "east" : __DIR__"road2",
  "west":  "/d/manglin/edge3",
]));
        set("item_desc", ([
                "野花": "漂亮的野花！\n"
        ]) );
        set("outdoors", "wanmei");
        setup();
}

void init()
{
    add_action("do_pick", "pick");
}

int do_pick(string arg)
{
    object ob;
    ob = new(__DIR__"obj/flower");
    ob -> move(this_player());
    write("你采了一朵路边的野花。\n");
    return 1;
}

