inherit ROOM;
void create() {
  set("short", "山庄正院");
  set("long", @LONG
正院的前方是庄主会客的雪梅阁，另一方则是枯梅堂的后门。山
风穿堂而过，枯梅堂的白烟笼罩于雪梅阁。阁前白玉石阶布满了各色
的花瓣。
LONG
  );
  set("exits", ([ /* sizeof() == 4 */
    "north": __DIR__ "wanmei5",
    "south": __DIR__ "wanmei6",
    "west": __DIR__ "road6",
    "east": __DIR__ "road8",
    "northwest": __DIR__ "wanmei4",
    "southwest": __DIR__ "wanmei3",
  ]));
  set("outdoors", "wanmei");
  setup();
}
