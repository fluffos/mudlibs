// crazy_dog.c

inherit NPC;

void create()
{
	set_name("水蛇", ({ "snake" }) );
	set("race", "野兽");
	set("age", 2);
	set("long", "一条滑溜溜的水蛇。\n");
	set("attitude", "aggressive");
	
	set("limbs", ({ "头部", "身体", "尾巴" }) );
	set("verbs", ({ "bite" }) );

	set("combat_exp", 5000);
    set_temp("apply/damage", 50);
	setup();
}
