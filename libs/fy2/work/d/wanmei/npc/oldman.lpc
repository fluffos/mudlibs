// banker.c

inherit NPC;

void create()
{
        set_name("满脸风霜的老人", ({ "oldman" }) );

        set("gender", "男性" );
        set("age", 75);
        
        set("long",
"这是一个满脸风霜的老人，但他双目有神，太阳穴高高隆起！\n");

        set("combat_exp", 1000000);
        set("attitude", "friendly");

        set("max_force", 1000);         
        set("force", 1000);             
        set("force_factor", 30);

        set("chat_chance", 15 );
        set("chat_msg", ({
        "满脸风霜的老人用袖子远远地一拂，你立刻感到透不过气来。\n",
        }) );

        set_skill("unarmed", 100);
        set_skill("parry", 100);
        set_skill("dodge", 100);
        set_skill("force", 100);
        
        setup();
        
        carry_object("/obj/cloth")->wear();

}

