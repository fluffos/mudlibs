// cloth.c
//
// This is the basic equip for players just login.

#include <armor.h>

inherit CLOTH;

void create() {
  set_name("青衣服", ({ "cloth" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("long", "这是一件青色的衣服。\n");
    set("material", "cloth");
    set("armor_prop/armor", 1);
  }
  setup();
}
