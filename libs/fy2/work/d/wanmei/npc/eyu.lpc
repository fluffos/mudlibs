// crazy_dog.c

inherit NPC;

void create()
{
	set_name("鳄鱼", ({ "cro" }) );
	set("race", "野兽");
	set("age", 12);
	set("long", "一只凶狠的鳄鱼。\n");
	set("attitude", "aggressive");
	
	set("limbs", ({ "头部", "身体", "尾巴" }) );
	set("verbs", ({ "bite" }) );

	set("combat_exp", 20000);
    set_temp("apply/damage", 60);
	setup();
}
