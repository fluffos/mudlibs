// token.c


inherit ITEM;

void create()
{
        set_name("马鬃木刷", ({ "brush" }) );
        set_weight(10);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "捆");
                set("material", "wood");
                set("value", 100);
        }
        setup();
}
