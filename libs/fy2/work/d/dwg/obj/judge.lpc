// token.c


inherit ITEM;

void create()
{
        set_name("判官神像", ({ "judge" }) );
        set("no_get", 1);
        set_weight(10);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "根");
            set("long", @LONG
这是一具判官神像，左手持笔，右手握剑。卓立在道旁，掌中之剑斜
斜地指向东面的一处山窟。
LONG);
                set("material", "wood");
                set("value", 0);
        }
        setup();
}
