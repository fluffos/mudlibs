// bag.c

inherit ITEM;

void create()
{
	set_name("书桌", ({ "desk", "书桌" }) );
	set_weight(500);
    set("no_get",1);
    set("no_shown",1);
	set_max_encumbrance(8000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "张");
        set("prep", "on");
		set("long", "一张红木书桌。\n");
		set("value", 1);
	}
}

int is_container() { return 1; }
