// dart.c
#include <ansi.h>
#include <weapon.h>

inherit THROWING;

void create()
{
	set_name(CYN"无影神针"NOR, ({ "needle" }) );
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long",	"有强大杀伤力的巨毒无比的无影神针\n");
		set("unit", "些");
		set("base_unit", "根");
		set("base_weight", 10);
		set("value", 200);
	}
	set_amount(5);
	init_throwing(40);
	setup();
}

mixed hit_ob(object me, object victim, int damage_bonus, int factor)
{
        int poison;
        poison = me->query_skill("poison") + 5 + random(5);
        victim->apply_condition("wuying_poison", poison);
        return;
}
