// token.c

#include <ansi.h>
inherit ITEM;

void create() {
  set_name(RED "断肠草" NOR, ({ "duancao" }));
  set_weight(10);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "根");
    set("long", "一根剧毒无比的断肠草。\n");
    set("material", "wood");
    set("value", 20000);
  }
  setup();
}
