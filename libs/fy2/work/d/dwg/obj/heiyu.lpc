// token.c

#include <ansi.h>
inherit ITEM;

void create()
{
        set_name("紫菁玉蓉膏", ({ "potion" }) );
        set_weight(10);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "颗");
                set("long", 
HIG"这是一颗有神奇功效的膏药．
可以用来提高身体的极限！\n");
                set("material", "paper");
                set("value", 1000);
        }
        setup();
}

void init()
{
    add_action("do_eat", "eat");
}

int do_eat(string arg)
{
    object me;
    int ekee, kee;
    if(arg != "potion")return 0;
    me = this_player();
    ekee = me->query("eff_kee");
    kee = me->query("kee");
    ekee += ekee / 10;
    kee += kee / 10;
    me->set("eff_kee", ekee);
    me->set("kee", kee);
    message_vision("$N服下一颗紫菁玉蓉膏，顿时浑身精力弥漫，看来有所作为。\n", me);
    destruct(this_object());
    return 1;
}
