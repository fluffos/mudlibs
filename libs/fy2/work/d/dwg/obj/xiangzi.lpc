// bag.c

inherit ITEM;

void create()
{
	set_name("大箱子", ({ "woodcase" }) );
	set_weight(20000);
	set_max_encumbrance(6000000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "个");
        set("prep", "under");
		set("long", "一个大箱子，木料很好，上面还包著黄铜。\n");
		set("value", 3);
	}
}

int is_container() { return 1; }
