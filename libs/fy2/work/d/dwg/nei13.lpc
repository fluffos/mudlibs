
inherit ROOM;

void create()
{
        object con, item;
        set("short", "菊花园");
        set("long", @LONG
一曲长廊环绕著半亩小园，小园中都种著菊花。菊花园里，清水
池边，有几间朴素的轩房。轩外绕著一曲竹篱，与前面华丽精致的建
筑大不相称。竹篱外，掩映著千竿翠竹。廊下悬著一只小小的金铃，
随风发出清脆的叮当声。这里的一切，似乎都与红尘隔绝，显得是那
样超然脱俗。
LONG
        );
        set("exits", ([ 
  "north" : __DIR__"nei12",
  "south": __DIR__"nei14",
]));
        set("objects", ([
        __DIR__"obj/guanmu" : 1,
        __DIR__"obj/heiyu" : 1
])  );
        set("outdoors", "dwg");
        setup();
        con = present("jinling",this_object());
        item = present("potion",this_object());
        item->move(con);
}

