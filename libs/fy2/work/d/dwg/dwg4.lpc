
#include <ansi.h>
inherit ROOM;

void create()
{
        object con, item;
        set("short", "白石道路");
        set("long", @LONG
这是一条笔直的，由晶莹的白石铺成的道路。路旁是两行修剪整
齐的花草，微风吹过，花香袭人。白色的晶石在天光下闪著迷人的色
彩。一切显的是那样的宁静，可你的内心却有一种不祥的预感。
LONG
        );
        set("exits", ([ 
  "south" : __DIR__"dwg2",
]));
        set("objects", ([
        __DIR__"obj/huacao" : 1,
        __DIR__"obj/hama" : 1,
        __DIR__"obj/duanchangcao" : 1,
        __DIR__"obj/leihuo" : 1,
        __DIR__"obj/stone" : 1
        ]) );
        set("outdoors", "dwg");
        setup();
        con = present("huacao",this_object());
        item = present("snowfrog",this_object());
        item->move(con);
        con = present("stone",this_object());
        item = present("duancao",this_object());
        item->move(con);
        item = present("pearl",this_object());
        item->move(con);
}

int valid_leave(object me, string dir)
{
        message_vision(HIY "一阵淡淡的花香飘过，你不由地深吸了一口气。\n" NOR, me);
        me->apply_condition("wuying_poison",10);
        return 1;
}


