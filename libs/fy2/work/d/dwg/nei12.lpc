
inherit ROOM;

void create()
{
        object con, item;
        set("short", "书房");
        set("long", @LONG
书房小巧精致，打扫的纤尘不然。靠墙的书架上摆满了各类书籍
，一张红木书桌横在雕花窗前，旁边放了个绣塌。几本翻开的书放在
书桌上，左手边是一盏水晶灯，旁边是一个翠绿欲滴的翡翠花瓶，里
面稀疏地插了几只白色的山茶花。
LONG
        );
        set("exits", ([ 
  "west" : __DIR__"nei10",
  "south": __DIR__"nei13",
]));
        set("objects", ([
        __DIR__"obj/desk" : 1,
        __DIR__"obj/book" : 1,
]));
        set("outdoors", "dwg");
        setup();
        con = present("desk",this_object());
        item = present("book",this_object());
        item->move(con);
}

