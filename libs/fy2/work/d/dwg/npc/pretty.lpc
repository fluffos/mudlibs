// mother.c
#include <ansi.h>
inherit NPC;

void create()
{
    string *names = ({
                "冬青", "玫瑰", "小兰", "杜鹃", "牡丹"        });

	set_name(names[random(sizeof(names))], ({ "pretty girl", "girl" }) );
	set("gender", "女性" );
	set("age", 19);
	set("long", @LONG
这是一位帝王谷的小丫头
LONG
);
    set("class", "yinshi");
	set("combat_exp", 20000);
    set_skill("unarmed", 30);
    set_skill("dodge", 30);
    set_skill("throwing", 30);
    set_skill("move", 30);
	set("attitude", "friendly");

	setup();
	
	carry_object("/obj/cloth")->wear();
    carry_object(__DIR__"obj/sand")->wield();
}

