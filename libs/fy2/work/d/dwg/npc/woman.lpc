// mother.c
inherit NPC;

void create() {
  set_name("白袍妇", ({ "woman" }));
  set("gender", "女性");
  set("age", 43);
  set("long", @LONG
这人云鬓不整，未洗铅华，四十多岁的年纪，五尺多高的身材，
容貌虽憔悴，但依稀仍可见少年时的风华。
LONG);
  set("chat_chance", 40);
  set("chat_msg", ({
    (: random_move :)
  }));
  set("class", "yinshi");
  set("combat_exp", 100000);
  set_skill("unarmed", 40);
  set_skill("dodge", 40);
  set_skill("move", 40);
  set_skill("flying-dragon", 40);
  set_skill("zuixian-steps", 40);
  map_skill("dodge", "zuixian-steps");
  map_skill("move", "zuixian-steps");
  map_skill("unarmed", "flying-dragon");

  set("attitude", "heroism");

  setup();

  carry_object("/obj/cloth")->wear();
}
