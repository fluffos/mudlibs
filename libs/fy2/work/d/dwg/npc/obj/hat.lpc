// hat.c
#include <ansi.h>
inherit EQUIP;

void create()
{
	set_name(HIY"白虎之铠"NOR, ({ "white tiger", "hat" }) );
	set_weight(700);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "顶");
		set("value", 70000);
		set("material", "cloth");
		set("armor_type", "head");
		set("armor_prop/armor", 10);
		set("armor_prop/dodge", 6);
	}
	setup();
}
