// token.c

#include <ansi.h>
inherit ITEM;

void create()
{
        string *names = ({
        BLU"一万"NOR, BLU"二万"NOR, BLU"三万"NOR, BLU"四万"NOR,
        BLU"五万"NOR, BLU"六万"NOR, BLU"七万"NOR, BLU"八万"NOR,
        BLU"九万"NOR, MAG"一筒"NOR, MAG"二筒"NOR, MAG"三筒"NOR,
        MAG"四筒"NOR, MAG"五筒"NOR, MAG"六筒"NOR, MAG"七筒"NOR,
        MAG"八筒"NOR, MAG"九筒"NOR, YEL"一索"NOR, YEL"二索"NOR,
        YEL"三索"NOR, YEL"四索"NOR, YEL"五索"NOR, YEL"六索"NOR,
        YEL"七索"NOR, YEL"八索"NOR, YEL"九索"NOR, BLK"东风"NOR,
        BLK"西风"NOR, BLK"南风"NOR, BLK"北风"NOR, HIR"红中"NOR,
        HIW"白板"NOR, HIG"发财"NOR
        });
        set_name(names[random(sizeof(names))], ({ "majiang" }) );
        set_weight(10);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "枚");
                set("long", "一副麻将牌中的一枚。\n");
                set("material", "wood");
                set("value", 10000);
        }
        setup();
}
