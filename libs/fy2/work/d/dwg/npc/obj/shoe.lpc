// shoe.c
#include <ansi.h>
inherit EQUIP;

void create()
{
	set_name(HIR"魅影神靴"NOR, ({ "ghosty boots", "boots" }) );
	set_weight(700);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "双");
		set("value", 6000);
		set("material", "cloth");
		set("armor_type", "feet");
		set("armor_prop/armor", 6);
		set("armor_prop/dodge", 4);
	}
	setup();
}
