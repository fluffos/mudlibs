// robe.c
#include <ansi.h>
inherit EQUIP;

void create()
{
	set_name(CYN"青龙宝甲"NOR, ({ "dragon cloth", "cloth" }) );
	set_weight(7000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "件");
		set("value", 100000);
		set("material", "cloth");
		set("armor_type", "cloth");
		set("armor_prop/armor", 20);
		set("armor_prop/dodge", 10);
	}
	setup();
}
