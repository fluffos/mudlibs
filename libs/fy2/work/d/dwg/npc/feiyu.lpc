// mother.c
inherit NPC;

void create()
{
	set_name("箫飞雨", ({ "feiyu" }) );
	set("gender", "女性" );
	set("age", 15);
    set("per", 26);
	set("long", @LONG
她是帝王谷谷主的女儿
LONG    );
        set("chat_chance", 40);
        set("chat_msg", ({
(: random_move :)
 }));
    set("class", "yinshi");
    create_family("帝王谷", 2, "弟子");
	set("combat_exp", 300000);
    set_skill("unarmed", 70);
    set_skill("dodge", 70);
    set_skill("move", 70);
    set_skill("flying-dragon", 70);
    set_skill("zuixian-steps", 70);
    map_skill("dodge", "zuixian-steps");
    map_skill("move", "zuixian-steps");
    map_skill("unarmed", "flying-dragon");

	set("attitude", "heroism");

	setup();
	
    carry_object(__DIR__"obj/zhanyi")->wear();
}

