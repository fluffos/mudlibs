
inherit ROOM;

void create()
{
        set("short", "风穴");
        set("long", @LONG
山窟外雾色朦胧，鬼气森森。山窟内更是阴暗，几乎是伸手难见
五指.洞内寒风如刀，呼啸不绝。深呼一口气，只觉的空气中充满了
血腥，一种不详的感觉涌上了心头。
LONG
        );
        set("no_cleanup",1);
        set("exits", ([ 
  "west" : __DIR__"dwg11",
  "east" : __DIR__"gunei2",
]));
        set("objects", ([
    __DIR__"obj/hulu" : 1,
]));
        setup();
        replace_program(ROOM);
}
