#include <ansi.h>
inherit ROOM;

void create()
{
        object con, item;
        set("short", "崖底");
        set("long", @LONG
在你的面前是一个小湖，湖水泛著粼光，轻柔地拍打著岸边的细
沙。透过清澈的湖水，你可以看到在水中嘻戏的鱼虾，还有随著水波
婆娑起舞的水草。岸边有一些矮小的灌木，灌木丛后是一道高耸入云
的危崖，给人以高不可攀的感觉。
LONG
        );
        set("exits", ([ 
]));
        set("outdoors", "dwg");
        setup();
}

void init()
{
    add_action("do_climb", "climb");
}
   
int do_climb(string arg)
{
    if(arg != "危崖")return notify_fail("你要爬什么。\n");
    else return notify_fail("你奋力向上爬去，爬了不到两三丈，只觉的手脚发软，向下滑了下去。\n");
}