inherit ROOM;

void create() {
  set("short", "石洞");
  set("long", @LONG
奔入石洞中，但觉酷热全消，迎面吹来一阵寒风。越往里走寒风
更烈，呼啸之声，连绵不绝。这寒风的呼啸，听来竞犹如战场上的杀
戮之声一般，使得这阴森幽暗的洞窟之中，充满了恐怖与杀机。
LONG
  );
  set("exits", ([
    "west": __DIR__ "gunei2",
    "east": __DIR__ "gunei5",
  ]));
  set("objects", ([
    __DIR__ "obj/needle": 1,
  ]));
  setup();
}
