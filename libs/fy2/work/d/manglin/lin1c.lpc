inherit ROOM;
void create()
{
        set("short", "莽林之中");
        set("long", @LONG
四周古树参天，荆棘密布。浓密宽厚的树叶遮蔽了日月星辰，使
人分不出昼夜。四下如死一般的寂静，只有风吹过树梢的沙沙之声。
偶尔一两声虎啸狼嚎随着腥风飘至耳际。
LONG
        );
        set("exits", ([ /* sizeof() == 4 */
  "north" : __DIR__"lin1",
  "south" : __DIR__"lin1",
  "east": __DIR__"center1",
  "west": __DIR__"lin1",
]));
        set("outdoors", "manglin");
        setup();
}

void init()
{
    add_action("do_climb", "climb");
}

int do_climb(string arg)
{
    if(arg != "tree")
    return 0;
    else 
    {
    message_vision("$N抓着突出的树枝，慢慢地顺着树杆爬了上去。\n", this_player());
    this_player()->start_busy(2);
    this_player()->move(__DIR__"tree1");
    message_vision("$N顺着树杆爬了上来。\n", this_player());
    return 1;
    }
}
