// crazy_dog.c

inherit NPC;

void create() {
  set_name("白颈灰熊", ({ "bear" }));
  set("race", "野兽");
  set("long", "这是一只凶猛无比的灰色熊\n");
  set("attitude", "aggressive");

  set("limbs", ({ "头部", "身体", "前脚", "後脚", "尾巴" }));
  set("verbs", ({ "bite", "claw", "dunt" }));

  set("combat_exp", 140000);
  set("bellicosity", 2000);

  set_temp("apply/damage", 100);

  setup();
}
