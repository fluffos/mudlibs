inherit ROOM;
void create() {
  set("short", "莽林之中");
  set("long", @LONG
四周古树参天，荆棘密布。浓密宽厚的树叶遮蔽了日月星辰，使
人分不出昼夜。四下如死一般的寂静，只有风吹过树梢的沙沙之声。
偶尔一两声虎啸狼嚎随着腥风飘至耳际。
LONG
  );
  set("exits", ([ /* sizeof() == 4 */
    "west": __DIR__ "lin4",
    "east": __DIR__ "lin4",
    "north": __DIR__ "lin4c",
  ]));
  set("outdoors", "manglin");
  setup();
}
