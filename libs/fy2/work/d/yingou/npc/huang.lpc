// tao_2.c
#include <ansi.h>

inherit NPC;
void pay_him(object who, int amount);

string *guzi = ({
  HIR "

          ⊙

" NOR,
  "
        ⊙

            ⊙
",
  "
        ⊙
          ⊙
            ⊙
",
  HIR "
        ⊙  ⊙

        ⊙  ⊙
" NOR,
  "
        ⊙  ⊙
          ⊙
        ⊙  ⊙
",
  "
        ⊙  ⊙
        ⊙  ⊙
        ⊙  ⊙
" });

string *bet_type = ({
  "小", "大", "围骰", "三点", "四点", "五点", "六点", "七点", "八点",
  "九点", "十点", "十一点", "十二点", "十三点", "十四点", "十五点",
  "十六点", "十七点", "十八点" });

int affordable(object me, int amount);
void create() {
  set_name("黄麻子", ({ "huang" }));
  set("gender", "男性");
  set("title", "银钩手");
  set("age", 32);
  set("long",
    "这是银钩赌坊的职业赌手，骰子上的功夫出神入化。\n"
  );
  set("combat_exp", 10000000);
  set("score", 20);

  set("int", 30);
  set("str", 100);

  set("chat_chance", 10);
  set("chat_msg", ({
    "黄麻子满面红光，耸恿着大家：加！再加大你的赌注！一定赢！\n",
    "黄麻子说道：再不下注就来不及了！\n",
  }));

  set("force", 15000);
  set("max_force", 15000);
  set("force_factor", 100);

  set("max_atman", 1000);
  set("atman", 1000);
  set_skill("unarmed", 500);
  set_skill("dodge", 400);
  set_skill("move", 600);
  set_skill("stealing", 400);
  set_skill("perception", 400);
  set_skill("betting", 300);
  set_skill("throwing", 300);
  map_skill("perception", "betting");
  map_skill("stealing", "betting");

  set_temp("apply/damage", 300);
  set_temp("apply/armor", 300);

  setup();

  add_money("gold", 30);
  carry_object(__DIR__ "obj/yincloth")->wear();
  carry_object(__DIR__ "obj/guzi")->wield();
}

void init() {
  object ob;

  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
  add_action("do_bet", "bet");
}

void greeting(object ob) {
  if (!ob || environment(ob) != environment()) return;
  switch (random(3)) {
    case 0:
      say("黄麻子说道：这位" + RANK_D->query_respect(ob)
        + "，进来！进来！ 输了算我的！\n");
      break;
  }
}

int do_bet(string arg) {
  int type, silver, typeold;
  int afford;
  object me;
  me = this_player();
  if (!arg || sscanf(arg, "%d %d", type, silver) != 2)
    return notify_fail("
骰子的赌法：

ｂｅｔ　＜种类＞　＜银量＞
\n");
  if (type < 0 || type > 18) return notify_fail("你要押哪个注。\n");
  if (silver <= 0) return notify_fail("你要押多少钱。\n");
  if (query_temp("betting/kaizhu")) return notify_fail("这一手来不及了，等下一手吧。\n");
  type += 1;
  if (typeold = me->query_temp("betting/type")) {
    if (type != typeold) return notify_fail("你不能同时押两个注。\n");
    else me->add_temp("betting/silver", silver);
    if (!afford = affordable(me, silver))
      return notify_fail("你没有这么多的银子。\n");
    pay_him(me, afford - silver);
    message_vision(
      "$N从身上拿出" + chinese_number(silver) + "两白银，加注在" + bet_type[type - 1] + "上．\n",
      me
    );
  } else {
    me->set_temp("betting/type", type);
    me->set_temp("betting/silver", silver);
    if (!afford = affordable(me, silver))
      return notify_fail("你没有这么多的银子。\n");
    pay_him(me, afford - silver);
    message_vision("$N从身上拿出" + chinese_number(silver) + "两白银，压在" + bet_type[type - 1] + "上．\n", me);
  }
  if (!query_temp("betting/start")) {
    set_temp("betting/start", 1);
    call_out("start_bet", 40);
  }
  return 1;
}

int affordable(object me, int amount) {
  int total;
  object silver;

  silver = present("silver_money", me);

  total = 0;
  if (silver) total += silver->value() / 100;

  if (total < amount) return 0;

  return total;
}

void pay_him(object who, int amount) {
  object ob;
  object silver;
  silver = present("silver_money", who);
  if (silver) destruct(silver);

  if (amount < 0) amount = 0;
  ob = new(SILVER_OB);
  ob->set_amount(amount);
  if (objectp(ob))
    ob->move(who);
}

void pay_user(object who, int amount) {
  object ob;

  if (amount / 100) {
    ob = new(__DIR__ "obj/gold");
    ob->set_amount(amount / 100);
    ob->move(who);
    amount %= 100;
  }
  if (amount) {
    ob = new(SILVER_OB);
    ob->set_amount(amount);
    ob->move(who);
  }
}

int start_bet() {
  int guzi1;
  object room = environment(this_object());
  set_temp("betting/kaizhu", 1);
  tell_room(room, "黄麻子大声叫道：下定注！说罢，将手中的三粒骰子撒向碗里．
．．．三粒骰子在碗里蹦跳着，发出悦耳的声音．．．\n");
  guzi1 = random(6) + 1;
  tell_room(room, "一粒骰子＂叮叮叮＂的跳动了几下，缓缓的停了下来：\n");
  tell_room(room, guzi[guzi1 - 1]);
  set_temp("betting/guzi1", guzi1);
  call_out("start_bet2", 5);
  return 1;
}

int start_bet2() {
  int guzi1;
  object room = environment(this_object());
  guzi1 = random(6) + 1;
  tell_room(room, "第二粒骰子在碗边旋转不停．．忽地翻了个身：\n");
  tell_room(room, guzi[guzi1 - 1]);
  set_temp("betting/guzi2", guzi1);
  call_out("start_bet3", 5);
  return 1;
}

int start_bet3() {
  int guzi1, guzi2, guzi3, i, guziall;
  int typeu, silveru, win_point = 0;
  object *inv;
  object room = environment(this_object());
  guzi1 = random(6) + 1;
  tell_room(room, "最后一粒骰子在碗里滑了两下，终于停在：\n");
  tell_room(room, guzi[guzi1 - 1]);
  set_temp("betting/guzi3", guzi1);
  guzi1 = query_temp("betting/guzi1");
  guzi2 = query_temp("betting/guzi2");
  guzi3 = query_temp("betting/guzi3");
  guziall = guzi1 + guzi2 + guzi3;
  inv = all_inventory(environment(this_object()));
  for (i = 0; i < sizeof(inv); i++) {
    if (userp(inv[i])) {
      typeu = inv[i]->query_temp("betting/type");
      typeu -= 1;
      silveru = inv[i]->query_temp("betting/silver");
      if (typeu == 2 && guzi1 == guzi2 && guzi2 == guzi3) {
        win_point = silveru * 36;
        pay_user(inv[i], silveru * 37);
      } else if (typeu > 2 && guziall == typeu) {
        win_point = silveru * 8;
        pay_user(inv[i], silveru * 9);
      } else if (typeu == 0 && guziall < 11) {
        win_point = silveru;
        pay_user(inv[i], silveru * 2);
      } else if (typeu == 1 && guziall > 10) {
        win_point = silveru;
        pay_user(inv[i], silveru * 2);
      } else win_point = -silveru;
      inv[i]->improve_skill("betting", win_point, 0);
      inv[i]->delete_temp("betting/silver");
      inv[i]->delete_temp("betting/type");
    }
  }
  if (guzi1 == guzi2 && guzi2 == guzi3)
    tell_room(room, "黄麻子高声叫道：“" + chinese_number(guzi1) +
      chinese_number(guzi2) + chinese_number(guzi3) + "三骰同点，小大通吃。”\n");
  else if (guziall < 11)
    tell_room(room, "黄麻子高声叫道：“" + chinese_number(guzi1) +
      chinese_number(guzi2) + chinese_number(guzi3) + chinese_number(guziall) + "点小，赔小吃大。”\n");
  else
    tell_room(room, "黄麻子高声叫道：“" + chinese_number(guzi1) +
      chinese_number(guzi2) + chinese_number(guzi3) + chinese_number(guziall) + "点大，赔大吃小。”\n");

  delete_temp("betting/guzi1");
  delete_temp("betting/guzi2");
  delete_temp("betting/guzi3");
  delete_temp("betting/kaizhu");
  delete_temp("betting/start");
  return 1;
}
