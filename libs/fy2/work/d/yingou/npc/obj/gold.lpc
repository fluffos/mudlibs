// gold.c

inherit MONEY;

void create() {
  set_name("纯金叶子", ({ "gold", "ingot", "gold_money" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("money_id", "gold");
    set("long", "黄澄澄的纯金叶子，人见人爱的纯金叶子，啊～～纯金叶子！\n");
    set("unit", "些");
    set("base_value", 10000);
    set("base_unit", "两");
    set("base_weight", 37);
  }
  set_amount(1);
}
