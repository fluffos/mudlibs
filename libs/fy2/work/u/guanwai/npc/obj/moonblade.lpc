#include <weapon.h>

inherit BLADE;

void create() {
  set_name("圆月弯刀", ({ "moonblade" }));
  set_weight(1500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long", "这是一把弯如月牙儿的弯刀。\n");
    set("value", 200000);
    set("material", "steel");
  }
  init_blade(50);

  set("wield_msg", "$N从腰间抽出一把亮闪闪的$n握在手中。\n");
  set("unwield_msg", "$N将手中的$n别在腰间。\n");


  setup();
}
