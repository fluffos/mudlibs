inherit NPC;
inherit F_MASTER;

void create()
{
	set_name("葛伦", ({ "master gelun", "master","gelun" }) );
	set("gender", "男性" );
	set("age", 99);
	set("int", 30);
        set("apprentice_available", 20);
        create_family("大招寺", 20, "主持");
	set("long",
		"葛伦高僧已在大招寺主持多年。男女弟子遍不关外。\n"
		);
	set("inquiry", ([
		"舍利子": "嗯....舍利子.....在舍利塔里。\n",
		"普松": "普松在大招寺的木屋里。",
	]) );
        set("combat_exp", 1000000);
        set("score", -90000);
	set("xinzhi",-1);
        set_skill("unarmed", 50);
        set_skill("staff", 100);
        set_skill("force", 100);
        set_skill("parry", 100);
        set_skill("literate", 80);
    	set_skill("iron-cloth", 150);
        set_skill("move", 100);

    	set_skill("bloodystrike", 100);
    	set_skill("cloudstaff", 100);
    	set_skill("bolomiduo", 100);
        set_skill("jin-gang", 150);


    	map_skill("unarmed", "bloodystrike");
        map_skill("staff", "cloudstaff");
        map_skill("force", "bolomiduo");
        map_skill("parry", "cloudstaff");
        map_skill("iron-cloth", "jin-gang");

        set("chat_chance_combat", 90);
        set("chat_msg_combat", ({
                (: perform_action, "staff.longxianyuye" :),
                (: perform_action, "iron-cloth.daoqiangburu" :),
        }) );


	setup();
	carry_object(__DIR__"obj/redcloth")->wear();
    carry_object(__DIR__"obj/9staff")->wield();
}

void reset()
{
        delete_temp("learned");
        set("apprentice_available", 20);
}

void attempt_apprentice(object ob)
{
        if( query("apprentice_available") ) {
                if( find_call_out("do_recruit") != -1 )
                        command("say 慢著，一个一个来。");
                else
                        call_out("do_recruit", 2, ob);
        } else {
                command("say 本主持今天已经收了二十个弟子，不想再收徒了。");
        }
}

void do_recruit(object ob)
{
                command("smile");
                command("say 很好，很好，很好。");
                command("recruit " + ob->query("id") );
}

int recruit_apprentice(object ob)
{
        if( ::recruit_apprentice(ob) )
                ob->set("class", "lama");
        add("apprentice_availavble", -1);
}

void init()
{
        add_action("give_quest", "quest");
}

void re_rank(object student)
{
        int exp;

        exp = (int) student->query("combat_exp");
        if(student->query("gender") == "男性")  {
        if( exp <= 32000 ) {
                student->set("title","大招寺俗家弟子");
                return ;
        } else if ( exp <= 64000 ) {
                student->set("title","大招寺小藏僧");
                return ;
        } else if ( exp <= 128000 ) {
                student->set("title","大招寺藏僧");
                return ;
        } else if ( exp <= 256000 ) {
                student->set("title","大招寺大藏僧");
                return ;
        } else if ( exp <= 512000 ) {
                student->set("title","大招寺小喇嘛");
                return ;
        } else if ( exp <= 1024000 ) {
                student->set("title","大招寺喇嘛");
                return ;
        } else if ( exp <= 1536000 ) {
                student->set("title","大招寺大喇嘛");
                return ;
        } else if ( exp <= 2304000 ) {
                student->set("title","大招寺护法");
                return ;
        } else if ( exp <= 3456000 ) {
                student->set("title","大招寺大护法");
                return ;
        } else if ( exp <= 5187000 ) {
                student->set("title","大招寺总护法");
                return ;
        } else if ( exp <= 26244000 ) {
                student->set("title","大招寺法王");
                return ;
        } else
                student->set("title","大招寺活佛");
                return ;
        }
        else {
        if( exp <= 32000 ) {
                student->set("title","大招寺俗家弟子");
                return ;
        } else if ( exp <= 64000 ) {
                student->set("title","大招寺小藏尼");
                return ;
        } else if ( exp <= 128000 ) {
                student->set("title","大招寺藏尼");
                return ;
        } else if ( exp <= 256000 ) {
                student->set("title","大招寺大藏尼");
                return ;
        } else if ( exp <= 512000 ) {
                student->set("title","大招寺小圣女");
                return ;
        } else if ( exp <= 1024000 ) {
                student->set("title","大招寺圣女");
                return ;
        } else if ( exp <= 1536000 ) {
                student->set("title","大招寺大圣女");
                return ;
        } else if ( exp <= 2304000 ) {
                student->set("title","大招寺护法");
                return ;
        } else if ( exp <= 3456000 ) {
                student->set("title","大招寺大护法");
                return ;
        } else if ( exp <= 5187000 ) {
                student->set("title","大招寺总护法");
                return ;
        } else if ( exp <= 26244000 ) {
                student->set("title","大招寺法王");
                return ;
        } else
                student->set("title","大招寺神尼");
                return ;
        }
}

