// rich.c

#include <room.h>

inherit ROOM;

string look_sign(object me);

void create()
{
        set("short", "张百万家");
	set("long", @LONG
你现在正站在张百万家里
    靠近门口的地方有一块乌木雕成的招牌(sign)。
LONG
        );
        set("exits", ([
                "south"          : "/u/cloud/eroad3",
//		"west"	         : "/u/wiz/bigmouth/sccroom",
	 ]) );

        set("item_desc", ([
                "sign": (: look_sign :),
        ]) );

//        create_door("west", "木门", "east", DOOR_CLOSED);

        setup();

}

string look_sign(object me)
{
        return "招牌写著：非请莫入。\n";
}

