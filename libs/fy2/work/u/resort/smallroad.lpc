
inherit ROOM;

void create()
{
        set("short", "羊肠小道");
        set("long", @LONG
一条被在恰克卜里山中砍柴的樵夫踏出的小道弯弯曲曲的向北面
的山幽伸展。道旁的茅草高达五尺，遮住了天光。山幽中的一切都显
的阴森幽暗。
LONG
        );
        set("exits", ([ 
  "south" : "/u/guanwai/citygate",
  "north" : __DIR__"smallroad2",
]));
        set("outdoors", "resort");

        setup();
        replace_program(ROOM);
}

