// pearl.c

#include <ansi.h>
inherit ITEM;

void create() {
  set_name(BLU "夜明珠" NOR, ({ "night pearl", "pearl" }));
  set_weight(10);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "价值连城的夜明珠，发出一种蓝幽幽的光泽。\n");
    set("unit", "串");
    set("value", 10000);
  }
  setup();
}
