// dagger.c : an example weapon

#include <weapon.h>
#include <ansi.h>
inherit HAMMER;

void create()
{
	set_name(HIG"毁天锤"NOR, ({ "jumbohammer", "hammer" }) );
	set_weight(30000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "");
		set("long", 
"这是蓝大先生惯用的兵器－－毁天锤。毁天锤长七尺三分，重八十四
公斤，看起来十分沉重，没有一定力量是没法使的动的。\n");
		set("value", 100000);
		set("material", "steel");
	}
	init_hammer(120);

// These properties are optional, if you don't set them, it will use the
// default values.
     set("wield_msg", "$N拿出一把$n，试了试重量，然後握在手中。\n");
     set("unwield_msg", "$N放下手中的$n。\n");
// The setup() is required.

	setup();
}
