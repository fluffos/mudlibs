// icy_cloth.c

#include <ansi.h>
#include <armor.h>

inherit CLOTH;

void create() {
  set_name(BLU "蓝布衣" NOR, ({ "cloth" }));
  set_weight(2000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("value", 40000);
    set("material", "cloth");
    set("armor_prop/armor", 10);
    set("armor_prop/dodge", 15);
    set("armor_prop/strength", 30);
  }
  setup();
}
