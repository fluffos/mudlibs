// taolord.c
#include <ansi.h>
inherit NPC;
inherit F_MASTER;

void create() {
  set_name("蓝天锤", ({ "master lan", "master", "lan" }));
  set("title", BLU "蓝大先生" NOR);
  set("gender", "男性");
  set("age", 42);
  set("long",
    "蓝天锤的一柄大锤用的出神入化．．．
每年都和帝王谷主绝顶一战，致今胜负不分．
蓝天锤的脾气爆如烈火，经常无缘无故的将弟子打成死伤或逐出墙门．\n");
  set("combat_exp", 1000000);
  set("score", 200000);

  set("class", "lishi");

  set("str", 60);
  set("int", 30);
  set("cor", 20);
  set("cps", 30);
  set("spi", 30);

  set("force", 3000);
  set("max_force", 3000);
  set("force_factor", 30);

  set("inquiry", ([
    "菩提心法":
    "菩提心法乃我傲仙宫之独门心法，习之不仅对自身有益，而且还能用\n
来济世救人。\n",
    "傲仙宫":
    "傲仙宫乃江湖中的名门正派。\n"
  ]));

  set("chat_chance_combat", 90);
  set("chat_msg_combat", ({
    (: perform_action, "hammer.kaitianpidi" :),
    (: perform_action, "dodge.mowuchen" :),
  }));

  create_family("傲仙宫", 7, "宫主");

  set_skill("dodge", 100);
  set_skill("force", 200);
  set_skill("hammer", 150);
  set_skill("literate", 100);
  set_skill("nodust-steps", 100);
  set_skill("pangu-hammer", 150);
  set_skill("parry", 100);
  set_skill("pofeng-strike", 120);
  set_skill("puti-force", 50);
  set_skill("unarmed", 100);

  map_skill("parry", "pangu-hammer");
  map_skill("hammer", "pangu-hammer");
  map_skill("force", "puti-force");
  map_skill("unarmed", "pofeng-strike");
  map_skill("dodge", "nodust-steps");

  setup();

  carry_object(__DIR__ "obj/huitianhammer")->wield();
  carry_object(__DIR__ "obj/lancloth")->wear();
}

void attempt_apprentice(object ob) {
  call_out("do_recruit", 2, ob);
}

void do_recruit(object ob) {
  command("smile");
  command("say " + ob->query("name") + "在傲仙宫好好学武，将来必将名扬天下。");
  command("recruit " + ob->query("id"));
}

int recruit_apprentice(object ob) {
  if ( ::recruit_apprentice(ob))
    ob->set("class", "lishi");
}

void init() {
  add_action("give_quest", "quest");
}

void re_rank(object student) {
  int exp;
  exp = (int)student->query("combat_exp");
  if (exp <= 32000) {
    student->set("title", "傲仙宫新秀");
    return;
  } else if (exp <= 128000) {
    student->set("title", "傲仙宫小侠");
    return;
  } else if (exp <= 512000) {
    student->set("title", "傲仙宫少侠");
    return;
  } else if (exp <= 1536000) {
    student->set("title", "傲仙宫大侠");
    return;
  } else if (exp <= 3456000) {
    student->set("title", "傲仙宫奇侠");
    return;
  } else if (exp <= 5187000) {
    student->set("title", "傲仙宫宗师");
    return;
  } else if (exp <= 26244000) {
    student->set("title", "傲仙宫泰斗");
    return;
  } else
    student->set("title", "傲仙宫天骄");
  return;
}
