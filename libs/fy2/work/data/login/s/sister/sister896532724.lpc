// cloth.c
//
// This is the basic equip for players just login.

#include <weapon.h>

inherit AXE;

void create()
{
     set_name("[30m铁斧[2;37;0m", ({ "axe" }) );
     set_weight(22000);
     set("no_get",1);
     set("no_drop",1);
	if( clonep() )
                set_default_object(__FILE__);
    else {
     set("unit", "把");
     set("material", "steel");
     set("owner", "sister");
     set("ji_gold", 1);
     set("wield_msg", "$N拿出一把沉重的$n，握在手中当作武器。\n");
     set("unwield_msg", "$N放下手中的$n。\n");
     init_axe(30, TWO_HANDED);
     set("long",@LONG
这是一把黑黝黝的板斧，看上去不是很锋利。
LONG        );
        }
        setup();
}
