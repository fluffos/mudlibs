// hat.c

inherit EQUIP;

void create()
{
	set_name("[1;37m玲珑白玉带[2;37;0m", ({ "belt" }) );
	set_weight(200);
    set("no_drop", 1);
    set("no_get", 1);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "条");
		set("long", 
"一条自制的腰带，看上去华丽非常。\n");
		set("material", "cloth");
		set("armor_type", "waist");
		set("armor_prop/armor", 21);
        set("bu_gold", 1024);
        set("owner", "cht");
	}
}
