// cloth.c
//
// This is the basic equip for players just login.

#include <weapon.h>

inherit HAMMER;

void create()
{
     set_name("[1;35m金锤[2;37;0m", ({ "jinc" }) );
     set_weight(8000);
     set("no_get",1);
     set("no_drop",1);
	if( clonep() )
                set_default_object(__FILE__);
    else {
     set("unit", "把");
     set("material", "steel");
     set("ji_gold",1);
     set("owner", "hjkl");
     set("wield_msg", "$N拿出一把$n，试了试重量，然後握在手中。\n");
     set("unwield_msg", "$N放下手中的$n。\n");
     init_hammer(31);
     set("long",@LONG
这是一把沈重的铁锤，打造的相当坚实。
LONG        );
        }
        setup();
}
