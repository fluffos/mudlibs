// time.c

#include <ansi.h>
inherit F_CLEAN_UP;

int main(object me, string arg) {
  int i, bt;
  string str, cmd;

  if (!arg)
    write(ZJBTSET "b12:" HIG "常用" NOR ":mycmds ofen" ZJSEP "b13:" HIY "技能" NOR ":mycmds skill" ZJSEP "b14:" HIR "战斗" NOR ":mycmds fight" ZJSEP
      "b15:" HIM "任务" NOR ":mycmds quest" ZJSEP "b16:" HIW "指南" NOR ":mycmds help" ZJSEP "b17:" HIC "频道" NOR ":liaotian" + "\n");
  else if (arg == "ofen")
    write(ZJBTSET "b1:查看" ZJBR "背包:i" ZJSEP "b2:综合" ZJBR "属性:score" ZJSEP "b3:健康" ZJBR "状态:hp"
      ZJSEP "b4:内精" ZJBR "上限:hp -m" ZJSEP "b5:属性" ZJBR "点数:hp -g" ZJSEP "b6:进阶" ZJBR "能力:help nl" ZJSEP "b7:附加" ZJBR "属性:istat"
      ZJSEP "b8:排行" ZJBR "榜单:help paihang" ZJSEP "b9:在线" ZJBR "玩家:who" ZJSEP "b10:如意" ZJBR "乾坤:summon qiankun" ZJSEP "b11:环顾" ZJBR "四周:look" + "\n");
  else if (arg == "skill")
    write(ZJBTSET "b1:查看" ZJBR "技能:help chaski" ZJSEP "b2:日常" ZJBR "练功:help liangong" ZJSEP "b3:全部" ZJBR "穿上:wear all"
      ZJSEP "b4:全部" ZJBR "脱下:remove all" ZJSEP "b5:查看" ZJBR "装备:arm" ZJSEP "b6:内力" ZJBR "疗伤:exert heal"
      ZJSEP "b7:汲取" ZJBR "体会:help jq" ZJSEP "b8:异常" ZJBR "状态:stat" ZJSEP "b9:战斗" ZJBR "信息:power" ZJSEP "b10:周天" ZJBR "经脉:help zt" ZJSEP "b11:环顾" ZJBR "四周:look" + "\n");
  else if (arg == "fight") {
    str = ZJBTSET;
    for (i = 1; i < 11; i++) {
      if (cmd = query("mycmds/fight/b" + i, me))
        str += "b" + i + ":" + cmd;
      else
        str += "b" + i + ":点击" ZJBR "选择" + i + ":mycmds reset " + i;
      str += ZJSEP;
    }
    str += "b11:重新" ZJBR "定义:mycmds reset";
    write(str + "\n");
  } else if (arg == "quest")
    write(ZJBTSET "b1:策马" ZJBR "奔腾:help fj" ZJSEP "b2:查看" ZJBR "任务:quest" ZJSEP "b3:使命" ZJBR "任务:task"
      ZJSEP "b4:使命" ZJBR "搜索:search" ZJSEP "b5:辅助" ZJBR "任务:mygift" ZJSEP "b6:扬州" ZJBR "客栈:recall back" ZJSEP "b7:结义" ZJBR "同盟:league"
      ZJSEP "b8:队伍" ZJBR "查看:team" ZJSEP "b9:脱离" ZJBR "队伍:team dismiss" ZJSEP "b10:自杀" ZJBR "重来:suicide" ZJSEP "b11:环顾" ZJBR "四周:look" + "\n");
  else if (arg == "help")
    write(ZJBTSET "b1:基本" ZJBR "系统:help topics" ZJSEP "b2:工作" ZJBR "指南:help work" ZJSEP "b3:" HIG "新手" ZJBR "攻略" NOR ":help start"
      ZJSEP "b4:环顾" ZJBR "四周:look" ZJSEP "b5:门派" ZJBR "列表:help menpai" ZJSEP "b6:商" ZJBR "店:help sx"
      ZJSEP "b7:环顾" ZJBR "四周:look" ZJSEP "b8:" HIC "更新" NOR ":help gxjh" ZJSEP "b9:自动" ZJBR "吸气:set auto_regenerate" ZJSEP "b10:会员" ZJBR "积分:vip" ZJSEP "b11:环顾" ZJBR "四周:look" + "\n");
  else if (arg == "reset") {
    str = ZJBTSET;
    for (i = 1; i < 11; i++) {
      str += "b" + i + ":点击" ZJBR "选择" + i + ":mycmds reset " + i;
      str += ZJSEP;
    }
    str += "b11:返回:mycmds fight";
    write(str + "\n");
    write(ZJTMPSAY "请点击你想要定义的按钮选择新功能。\n");
  } else if (sscanf(arg, "reset %d %s", bt, cmd) == 2) {
    string a, b;

    if (bt < 1 || bt > 10)
      return notify_fail(ZJOBLONG "没有这个按钮。。。\n");
    if (cmd == "自定义") {
      write(INPUTTXT("请输入自定义字串：标题:命令(查看:look)", "mycmds reset " + bt + " $txt#") + "\n");
      return 1;
    }
    cmd = replace_string(cmd, "：", ":");
    cmd = replace_string(cmd, "#E", ESA);
    cmd = replace_string(cmd, "/", ZJBR);
    cmd = replace_string(cmd, "\n", ZJBR);
    if (sscanf(cmd, "%s:%s", a, b) != 2)
      return notify_fail(HIR "格式错误，请重新定义！" NOR "\n");
    set("mycmds/fight/b" + bt, cmd, me);
    write(ZJBTSET "b" + bt + ":" + cmd + "\n");
  } else if (sscanf(arg, "reset %d", bt) == 1) {
    mapping smap, pmap, pfms, skips;
    string force_ski, weapon_ski, *pfm, ski_type, uski_type;
    int k, flag;
    string msg, *valid_types, *skis, *cmdd;
    object weapon;

    if (bt < 1 || bt > 10)
      return notify_fail(ZJOBLONG "没有这个按钮。。。\n");

    valid_types = ({ "finger", "hand", "cuff", "claw", "strike", "unarmed" });
    skips = ([]);
    if (!smap = me->query_skill_map()) smap = ([]);
    if (!pmap = me->query_skill_prepare()) pmap = ([]);
    msg = "";

    if (objectp(weapon = query_temp("weapon", me)))
      ski_type = query("skill_type", weapon);

    if (force_ski = smap["force"]) {
      pfms = SKILL_D(force_ski)->query_pfm();
      if (mapp(pfms) && pfms != ([])) {
        pfm = sort_array(keys(pfms), (: strcmp :));
        for (i = 0; i < sizeof(pfm); i++) {
          cmdd = explode(pfms[pfm[i]], ":");
          msg += cmdd[0] + ":mycmds reset " + bt + " " + replace_string(
            cmdd[0],
            ESA,
            "#E"
          ) + "：" + cmdd[1] + " " + pfm[i] + ZJSEP;
        }
      }
      skips[force_ski] = 1;
    }

    if (objectp(weapon)) {
      if (stringp(weapon_ski = smap[ski_type]) && !skips[weapon_ski]) {
        pfms = SKILL_D(weapon_ski)->query_pfm();
        if (mapp(pfms) && pfms != ([])) {
          pfm = sort_array(keys(pfms), (: strcmp :));
          for (i = 0; i < sizeof(pfm); i++) {
            cmdd = explode(pfms[pfm[i]], ":");
            msg += cmdd[0] + ":mycmds reset " + bt + " " + replace_string(
              cmdd[0],
              ESA,
              "#E"
            ) + "：" + cmdd[1] + " " + ski_type + "." + pfm[i] + ZJSEP;
          }
        }
        skips[weapon_ski] = 1;
      }
    } else if (!objectp(weapon)) {
      if (mapp(pmap) && pmap != ([])) {  //首先推送准备技能
        skis = sort_array(keys(pmap), (: strcmp :));
        for (k = 0; k < sizeof(skis); k++) {
          if (skips[pmap[skis[k]]]) continue;
          pfms = SKILL_D(pmap[skis[k]])->query_pfm();
          if (mapp(pfms) && pfms != ([])) {
            pfm = sort_array(keys(pfms), (: strcmp :));
            for (i = 0; i < sizeof(pfm); i++) {
              cmdd = explode(pfms[pfm[i]], ":");
              msg += cmdd[0] + ":mycmds reset " + bt + " " + replace_string(
                cmdd[0],
                ESA,
                "#E"
              ) + "：" + cmdd[1] + " " + skis[k] + "." + pfm[i] + ZJSEP;
            }
          }
          skips[pmap[skis[k]]] = 1;
        }
      }

      skis = sort_array(keys(smap), (: strcmp :));
      for (k = 0; k < sizeof(skis); k++) {
        flag = 1;
        for (i = 0; i < sizeof(valid_types); i++) {
          if (SKILL_D(smap[skis[k]])->valid_enable(valid_types[i])) {
            uski_type = valid_types[i];
            flag = 2;
          }
        }
        if (!skips[smap[skis[k]]] && flag == 2) {
          pfms = SKILL_D(smap[skis[k]])->query_pfm();
          if (mapp(pfms) && pfms != ([])) {
            pfm = sort_array(keys(pfms), (: strcmp :));
            for (i = 0; i < sizeof(pfm); i++) {
              cmdd = explode(pfms[pfm[i]], ":");
              msg += cmdd[0] + ":mycmds reset " + bt + " " + replace_string(
                cmdd[0],
                ESA,
                "#E"
              ) + "：" + cmdd[1] + " " + skis[k] + "." + pfm[i] + ZJSEP;
            }
          }
        }
        skips[smap[skis[k]]] = 1;
      }
    }
    write(ZJOBLONG "你想设定按钮" HIG + chinese_number(bt) + NOR "为什么功能？\n" ZJOBACTS2 + ZJMENUF(
      5,
      5,
      8,
      30
    )
      +msg
      + "内力" ZJBR "回气:mycmds reset " + bt + " 内力" ZJBR "回气：exert recover" ZJSEP
      + "内力" ZJBR "回精:mycmds reset " + bt + " 内力" ZJBR "回精：exert regenerate" ZJSEP
      + "内力" ZJBR "疗伤:mycmds reset " + bt + " 内力" ZJBR "疗伤：exert heal" ZJSEP
      + "内力" ZJBR "疗疾:mycmds reset " + bt + " 内力" ZJBR "疗疾：exert dispel" ZJSEP
      + "芳华" ZJBR "木:mycmds reset " + bt + " 芳华" ZJBR "木：smell mu" ZJSEP
      + "\n");
  }
  return 1;
}

int help(object me) {
  write(@HELP

这个指令让设定游戏默认的自定义按钮。

HELP
  );
  return 1;
}
