//arm.c

#include <ansi.h>
#include <combat.h>
inherit F_CLEAN_UP;

string name_temp(object ob, string type);

int main(object me, string arg) {
  object ob;
  mapping prepare;
  int attack_points, dodge_points, parry_points, islook;
  object weapon, second_weapon;
  string line, tmp, wp1, wp2, skill_type;

  if (arg) {
    ob = find_player(arg);
    if (!ob) ob = find_living(arg);
    if (!ob) ob = present(arg, environment(me));
    if (!wizardp(me) && (!ob || query("couple/child", me) != query("id", ob))) {
      islook = 0;   //不是巫师或孩子不能看具体攻击防御数值
    } else {
      islook = 1;       //可以查看全部数值
    }
    if (!ob) {
      return notify_fail("你要察看谁的装备？\n");
    }
  }
  if (!ob) {
    ob = me;
    islook = 1;       //可以查看全部数值
  }
  if (ob == me && me->is_ghost())
    return notify_fail("这些身外之物，生不带来，死不带去，还是算了吧！\n");

  line = "";
  tmp = ZJOBACTS2 + ZJMENUF(2, 2, 10, 30);
  wp1 = "无:null" ZJSEP;
  wp2 = "无:null" ZJSEP;

  weapon = query_temp("weapon", ob);
  second_weapon = query_temp("secondary_weapon", ob);
  if (weapon) {
    wp1 = query("name", weapon) + ":unwield " + query("id", weapon) + ZJSEP;
  }
  if (second_weapon) {
    wp2 = query("name", second_weapon) + ":unwield " + query("id", weapon);
  }

  line += HBBLU + " [" + query("name", ob) + "] 装备了下列物品：" NOR "\n";
  if (islook) {
    prepare = me->query_skill_prepare();
    if (objectp(weapon = query_temp("weapon", ob)))
      skill_type = query("skill_type", weapon);
    else if (prepare && sizeof(prepare) > 0) skill_type = (keys(prepare))[0];
    else
      skill_type = "unarmed";
  }
  // 先用无颜色的做排列(如此色码才不会被算进去导致乱掉)
  tmp += sprintf("[左手]：%s[右手]：%s", wp2, wp1);
  tmp += sprintf("[头部]：%s[颈部]：%s", name_temp(ob, "armor/head"), name_temp(ob, "armor/neck"));
  tmp += sprintf("[背部]：%s[披风]：%s", name_temp(ob, "armor/shubao"), name_temp(ob, "armor/surcoat"));
  tmp += sprintf("[衣服]：%s[护甲]：%s", name_temp(ob, "armor/cloth"), name_temp(ob, "armor/armor"));
  tmp += sprintf("[手腕]：%s[腰部]：%s", name_temp(ob, "armor/wrists"), name_temp(ob, "armor/waist"));
  tmp += sprintf("[盾牌]：%s[手掌]：%s", name_temp(ob, "armor/shield"), name_temp(ob, "armor/hands"));
  tmp += sprintf("[底衫]：%s[裤子]：%s", name_temp(ob, "armor/dishan"), name_temp(ob, "armor/kuzi"));
  tmp += sprintf("[袜子]：%s[内裤]：%s", name_temp(ob, "armor/wazi"), name_temp(ob, "armor/neiku"));
  tmp += sprintf("[戒指]：%s[足部]：%s", name_temp(ob, "armor/finger"), name_temp(ob, "armor/boots"));
  line = replace_string(line, "\n", ZJBR) + "\n";
  line += tmp;
  write(ZJOBLONG + line + "\n");

  return 1;
}
string name_temp(object ob, string type) {
  string name;
  object obj;
  if (objectp(obj = query_temp(type, ob))) {
    name = query("name", obj) + ":" + query("id", obj) + ZJSEP;
  } else {
    name = "无:null" ZJSEP;
  }
  return name;
}

int help(object me) {
  write(@HELP
指令格式: arm
 
可列出你(你)目前身上所携带的所有物品。
 
 
HELP);
  return 1;
}
