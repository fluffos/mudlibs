#include <ansi.h>

inherit F_CLEAN_UP;

string status_color(int current, int max);

int main(object me, string arg) {
  object ob;
  mapping my;
  string sp;
  int lv, level, exp, q1, q2, q3, qi1, qi2, qi3, jing1, jing2, jing3, nei1, nei2, jingli1, jingli2, a, q11, q22, q33, qi11, qi22, qi33, jing11, jing22, jing33, nei11, nei22, jingli11, jingli22;

  seteuid(getuid(me));
  if (!arg)
    ob = me;
  else
    ob = present(arg, environment(me));

  my = ob->query_entire_dbase();

  if (userp(ob) && (!stringp(my["born"]) || !my["born"]))
    return notify_fail("还没有出生呐，察看什么？\n");

  if (my["max_jing"] < 1 || my["max_qi"] < 1)
    return notify_fail("无法察看" + ob->name(1) + "的状态。\n");

  exp = query("combat_exp", ob) / 10000;
  a = query("balance", ob) / 10000;

  level = to_int(pow(to_float(exp), 1.0 / 3)) * 10 + 1;
  qi3 = query("qi", ob) / 10000;
  qi2 = query("eff_qi", ob) / 10000;
  qi1 = query("max_qi", ob) / 10000;
  jing1 = query("max_jing", ob) / 10000;
  jing2 = query("eff_jing", ob) / 10000;
  jing3 = query("jing", ob) / 10000;
  nei1 = query("max_neili", ob) / 10000;
  nei2 = query("neili", ob) / 10000;
  jingli1 = query("jingli", ob) / 10000;
  jingli2 = query("max_jingli", ob) / 10000;

  qi33 = query("qi", ob) / 100000000;
  qi22 = query("eff_qi", ob) / 100000000;
  qi11 = query("max_qi", ob) / 100000000;
  jing11 = query("max_jing", ob) / 100000000;
  jing22 = query("eff_jing", ob) / 100000000;
  jing33 = query("jing", ob) / 100000000;
  nei11 = query("max_neili", ob) / 100000000;
  nei22 = query("neili", ob) / 100000000;
  jingli11 = query("jingli", ob) / 100000000;
  jingli22 = query("max_jingli", ob) / 100000000;


  lv = query("level", ob);
  sp = "\n";
  // if (my["max_qi"] > 100000000){sp += ZJHPTXT+sprintf("生命y.%d:%d/%d/%d:%s",qi33,qi33,qi22,qi11,"#BBFF0000");   }

  sp += ZJHPTXT + sprintf("%s:100/100:%s", my["name"], "#000000");
  if (my["max_qi"] < 100000000) {
    sp += "║" + sprintf("气.%d:%d/%d/%d:%s", qi3, qi3, qi2, qi1, "#BBFF0000");
  } else if (my["max_qi"] > 100000000) {
    sp += "║" + sprintf("生命.%d:%d/%d/%d:%s", qi33, qi33, qi22, qi11, "#BBFF0000");
  }

  if (my["max_jing"] < 100000000) {
    sp += "║" + sprintf("精.%d:%d/%d/%d:%s", jing3, jing3, jing2, jing1, "#BBFF0066");
  } else if (my["max_jing"] > 100000000) {
    sp += "║" + sprintf("神识.%d:%d/%d/%d:%s", jing33, jing33, jing22, jing11, "#BBFF0066");
  }
  sp += "║" + sprintf("灵石.%d:%d/%d:%s", a, a, a, "#3CB371");
  sp += "║" + sprintf("等级：%d:%d/%d:%s", lv, lv, lv, "#BB990000");
  if (my["max_neili"] < 100000000) {
    sp += "║" + sprintf(
      "内力.%d:%d/%d/%d:%s",
      nei1,
      nei1,
      nei2,
      ob->query_current_neili_limit(),
      "#00BFFF"
    );
  } else if (my["max_neili"] > 100000000) {
    sp += "║" + sprintf(
      "法力.%d:%d/%d/%d:%s",
      nei22,
      nei22,
      nei11,
      ob->query_current_neili_limit(),
      "#00BFFF"
    );
  }
  if (my["max_jingli"] < 100000000) {
    sp += "║" + sprintf(
      "精力.%d:%d/%d/%d:%s",
      jingli1,
      jingli1,
      jingli2,
      ob->query_current_jingli_limit(),
      "#BB6600CC"
    );
  } else if (my["max_jingli"] > 100000000) {
    sp += "║" + sprintf(
      "灵力.%d:%d/%d/%d:%s",
      jingli11,
      jingli11,
      jingli22,
      ob->query_current_jingli_limit(),
      "#BB6600CC"
    );
  }
  sp += "║" + sprintf("经.%d:%d/%d:%s", exp, exp, exp, "#BB0066FF");


  sp += "\n";
  tell_object(me, sp);
  return 1;
}
