#include <ansi.h>
inherit ITEM;

void create()
{

        set_name(HIY"混沌天"NOR, ({ "hunduntian door","door"}) );
        set_weight(9999999999);
        set("no_sun",1);
		set("no_get",1);
		set("value", 5000);
		//set("no_get", 1);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long", GRN"从这个入口可以进入混沌天。(enter door)\n"NOR);
                set("long",""ZJURL("cmds:enter door")ZJSIZE(15)""HIR"进入"NOR"建议最低进入条件all sk > 20000级!\n");
		set("unit", "个");
                set("lore",1);
        }
        setup();
}
void init()
{
        add_action("do_enter","enter");
}
int do_enter(string arg)
{
        int time;
        object me = this_player();
        //if( time()-me->query_temp("boss/maze")<3600 )
        //     return notify_fail(HIG "秦皇陵一小时只能进一次哦。\n" NOR);
        me->move("/maze/hunduntian/enter");

        FUBEN_D->enter_maze(this_player(), "hunduntian");
        return 1;
}

