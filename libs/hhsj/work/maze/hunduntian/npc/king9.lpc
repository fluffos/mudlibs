void init()
{
        object me;

        ::init();
        if (! interactive(me = this_player()) ||
            this_object()->is_fighting())
                return;

        remove_call_out("kill_ob");
        call_out("kill_ob", 0.5, me);
}

void sp_attack()
{
        object *enemies, enemy, ob;
        object *obs;
        string msg;
        int i;

        enemies = query_enemy();
        if( !enemies || sizeof(enemies) == 0 )
                return;
        enemy = enemies[random(sizeof(enemies))];
           obs=filter_array(all_inventory(environment(this_object())),(:query("id", $1) == "skeleton fighter":)); 
        if( sizeof(obs) < 7 && !random(5) ) {
                msg = HIY"$N发出呜呜呜~的声音像是在呼叫同伴，\n"NOR;
                message_vision(append_color(msg, HIY),this_object(),enemy);
                for( i=0;i<3;i++ ) {
                        ob = new(__DIR__"king9");
                        ob->set_from_me(enemy);
                        ob->move(environment(enemy));
                        ob->kill_ob(enemy);
                }
                return;
        }
        if( !enemy->is_busy() && sizeof(ob) > 3 && !random(5) ) {
                msg = HIY"$N双爪往前一躬顿时一度气浪四散开来，只见白虎猛地一跃，冲你袭来。\n"
                         "$n还未看到身影白虎依然身至\n"
                         "顿时$n身体被撕开！\n" NOR;
                message_vision(append_color(msg, HIY),this_object(),enemy);
                enemy->start_busy(5);
                return;
        }
        /*
        秦皇僵尸久攻不下，感到十分不耐烦，于是把河图虎符都仍在一旁，从身边的剑鞘中
        拔出一把青光闪闪的宝剑，虽然在棺中历经千年岁月，这把宝剑仍然光可鉴人，锋利
        无匹。烛光跳动间你赫然看见，剑鞘上刻着两个篆字：鹿卢。
        */
       /* switch( random(5) ){
                case 4: msg = HBYEL "$N"HIY"双腿一登，身影随即消失只见一道庚金之气从$n"HIY"透体而过！\n"NOR; break;
                case 3: msg = HIW "$N"HIW"张开血盆大口，只听见~吼~一声虎啸，$n"HIW"只觉自己气血凝滞，五脏受损。\n"NOR; break;
                case 2: msg = HIY "$N"HIR"双爪发力大地都被撕开裂缝如同狂风袭向$n"HIR"，$n"HIR"被裂缝带入地下下落不明生死不知。\n"NOR; break;
                case 1: msg = YEL "$N"MAG"尾巴一扫，顿石飞沙走石场树木横飞...\n"
                                  "$n"MAG"双腿发力踏石,踏树,然而还是被一颗千年老树击中。\n"NOR;break;
                default: msg= HIC "$N"HIG"双爪离体，只见$n"HIG"脚边的地上纷纷并裂$n"HIG"，突然一双爪子冲$n"HIG"抓来。\n"NOR; break;
        }*/
        message_vision(msg,this_object(),enemy);
        if( !random(20) ) enemy->unconcious(); 
        enemy->receive_damage("qi",5000+random(50000),this_object());
        COMBAT_D->report_status(enemy);
        if( !enemy->is_busy() )
                enemy->start_busy(2);
        return;
}

varargs void start_busy(mixed new_busy, mixed new_interrupt)
{
        return;
}

mixed hit_ob(object me, object ob, int damage_bouns)
{
        int damage;
        int reduce;

        damage = 10000 + random(10000);
        reduce=query_temp("apply/reduce_fire", ob);
        damage -= damage * reduce / 100;
        if( damage < 0 ) damage = 0;
        ob->receive_damage("qi", damage, me);
        ob->receive_wound("qi", damage, me);
        set("neili",query("max_neili",  me), me);
        return HIY "$N" HIY "全身闪出耀眼的黑，登时令$n"
               HIY "全身混混谔谔。\n" NOR;
}
