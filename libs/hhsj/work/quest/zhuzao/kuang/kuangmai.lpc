#include <ansi.h>
inherit ITEM;

string *kuang1 = ({ __DIR__ "coin", __DIR__ "silver" });
string *kuang2 = ({ __DIR__ "coin", __DIR__ "silver", __DIR__ "gold" });
string *kuang3 = ({ __DIR__ "coin", __DIR__ "silver", __DIR__ "gold", __DIR__ "cash" });
string *kuang4 = ({
  __DIR__ "coin",
  __DIR__ "silver",
  __DIR__ "gold",
  __DIR__ "cash",
  __DIR__ "thousand-gold"
});
string *kuang5 = ({
  __DIR__ "coin",
  __DIR__ "silver",
  __DIR__ "gold",
  __DIR__ "cash",
  __DIR__ "thousand-gold",
  __DIR__ "jls"
});
string *kuang6 = ({
  __DIR__ "coin",
  __DIR__ "silver",
  __DIR__ "gold",
  __DIR__ "cash",
  __DIR__ "thousand-gold",
  __DIR__ "jls",
  __DIR__ "hhyz"
});

void init() {
  add_action("do_wakuang", "wakuang");
}


void create() {
  set_name("矿脉", ({ "kuang mai", "mai" }));
  set_weight(500000000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "块");
    set("no_drop", "不要乱丢，这东西打到人痛！\n");
    set("no_put", 1);
    set("no_get:", 1);
    set("long", "这是一条很好的矿脉，你可以用（wakuang）来试试你的运气如何。\n");
  }
  setup();
}

int do_wakuang() {
  object me = this_player();
  int b;
  if (me->is_busy()) return notify_fail("你现在很忙！不能挖！\n");
  /*if ((me->query("jingli") < 500))
        {
          tell_object(me,"你的精神状态还不适合这么沉重的劳动！\n");
          return 1;
        }
        else*/
  /* if ((me->query("qi") < 500 ))
        {
          tell_object(me,"你的身体条件还不够强壮，不能挖矿石！\n");
          return 1;
        }*/

  /*if ((me->query("combat_exp") > 5000000 ))
        {
          tell_object(me,"像你这等高手啊，还挖矿？\n");
          return 1;
        }*/

  message_vision(HIC "$N挥动铁镐开始在地上挖了起来。\n" NOR, me);
  me->add("jing", -100);
  me->add("qi", -150);
  me->add("combat_exp", 100 + random(50));
  //me->add("potential",100+random(100));
  b = 100 + random(50);
  me->improve_potential((b));
  me->start_busy(5 + random(5));

  remove_call_out("wakuang");
  call_out("wakuang", 5, me);

  return 1;
}

int wakuang(object me) {
  object ob;
  object ob1;

  if (random(5) < 3) {
    message_vision(CYN "一阵挖掘之后，$N什么也没挖到。\n" NOR, me); ;
    return 1;
  } else if ((int)me->query("work/wakuang") > 1500) {
    message_vision(HIR "$N熟练的在矿脉中找来查去，不一会儿就找出一块好矿石。\n" NOR, me);
    me->add("work/wakuang", 1);
    ob = new(kuang6[random(7)]);
    ob->move(me);
    destruct(this_object());
    return 1;
  } else if ((int)me->query("work/wakuang") > 1000) {
    message_vision(HIY "$N熟练的在矿脉中找来查去，不一会儿就找出一块好矿石。\n" NOR, me);
    me->add("work/wakuang", 1);
    ob = new(kuang5[random(6)]);
    ob->move(me);
    destruct(this_object());
    return 1;
  } else if ((int)me->query("work/wakuang") > 800) {
    message_vision(HIY "$N熟练的在矿脉中找来查去，不一会儿就找出一块好矿石。\n" NOR, me);
    me->add("work/wakuang", 1);
    ob = new(kuang4[random(5)]);
    ob->move(me);
    destruct(this_object());
    return 1;
  } else if ((int)me->query("work/wakuang") > 600) {
    message_vision(HIY "$N在矿脉中翻来覆去，找出一块好矿石。\n" NOR, me);
    me->add("work/wakuang", 1);
    ob = new(kuang3[random(4)]);
    ob->move(me);
    destruct(this_object());
    return 1;
  } else if ((int)me->query("work/wakuang") > 400) {
    message_vision(HIY "$N在矿脉中找来查去，好久才找出一块矿石。\n" NOR, me);
    me->add("work/wakuang", 1);
    ob = new(kuang2[random(3)]);
    ob->move(me);
    destruct(this_object());
    return 1;
  } else if ((int)me->query("work/wakuang") > 200) {
    message_vision(HIY "$N在矿脉中摸来摸去，好不容易找出一块矿石。\n" NOR, me);
    me->add("work/wakuang", 1);
    ob = new(kuang1[random(2)]);
    ob->move(me);
    destruct(this_object());
    return 1;
  } else {
    message_vision(HIG "$N找了半天，终于发现其中一块石头是矿石。\n" NOR, me);
    me->add("work/wakuang", 1);
    ob1 = new(__DIR__ "coin");
    ob1->move(me);
    destruct(this_object());
  }
  return 1;
}
