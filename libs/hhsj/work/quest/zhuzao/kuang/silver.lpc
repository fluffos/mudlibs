// silver.c

#include <ansi.h>

inherit MONEY;

void create() {
  set_name(WHT "灵石" NOR, ({ "silver", "ingot", "silver_money" }));
  /*if( clonep() )
                set_default_object(__FILE__);
        else*/ {
    set("money_id", "silver");
    set("long", "普通灵石，杂质较少。\n");
    set("unit", "堆");
    set("base_value", 100);
    set("base_unit", "块");
    set("base_weight", 80);
    set("only_do_effect", 1);
  }
  set_amount(1);
}
int do_effect(object me) {

  message_vision("$N慢慢吸收灵石里的灵力，感觉功力有所增长。\n" NOR, me);
  addn("max_neili", -1, me);
  addn("max_jingli", -1, me);
  add_amount(-1);

  if (query_amount() < 1)
    destruct(this_object());

  return 1;
}
