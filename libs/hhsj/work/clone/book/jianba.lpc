// zhengpu.c

inherit BOOK;

void create() {
  set_name("剑八", ({ "jian ba", "jianba" }));
  set_weight(500);
  /*if (clonep())
                set_default_object(__FILE__);
        else*/
  {
    set("unit", "本");
    set("long", "这是一卷用竹子制作的卷轴，（open）打开看看？。\n");
    set("value", 10);
    set("material", "paper");
    set("skill", ([
      "name": "shengling",
      "jing_cost": 200,
      "difficulty": 200,
      "max_skill": 100,
      // "min_skill":    10,
    ]));
  }
}
void init() {
  add_action("do_open", "open");

}
int do_open(string arg, object me) {
  if (!id(arg))
    return notify_fail("你想打开什么？\n");

  else if (query("open_count") > 0) {
    add("open_count", -1);
    message_vision("$N伸手打开卷轴，只见一道冲天剑气冲你而来，你根本来不及躲闪！\n", me);
    me->die();

  }
  destruct(this_object());

  return 1;
}
