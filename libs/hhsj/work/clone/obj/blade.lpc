#include <ansi.h>
#include <weapon.h>
inherit BLADE;

void create()
{
         set_name(HIG"雪饮狂刀"NOR, ({ "springrain blade", "blade" }) );
         set_weight(4000);
         /*if( clonep() )
                 set_default_object(__FILE__);
         else*/ {
                 set("unit", "柄");
                 set("value", 500);
                 set("material", "iron");
                 set("long",
                        "雪饮狂刀聂家祖传宝刀\n"
                        "此刀极其冰寒，又削铁如泥。\n");
                 set("wield_msg", "$N抽出一把明晃晃的$n握在手中。\n");
                 set("unequip_msg", "$N将手中的$n插入腰间的刀鞘。\n");
         }
         init_blade(300);
         setup();
}