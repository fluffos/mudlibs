#include <ansi.h>

inherit ITEM;

void create()
{
        set_name(HIG "器魂神石礼包" NOR, ({ "wis dan" }) );
        set_weight(200);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long","器魂神石礼包。\n"ZJURL("cmds:eat wis dan")ZJSIZE(15)"使用"NOR"看看!\n");
               // set("yuanbao", 200);
                set("value", 1000);
                set("unit", "粒");
                set("only_do_effect", 1);
        }
}

int do_effect(object me)
{
        object item;
		set("title",HBWHT"乞讨人"NOR,me);

        message_vision("$N一仰脖，吞下了一粒" + this_object()->name() +
                       "。\n", me);

                        item = new("/clone/shenshi/huo9");
                        item->move(me, 1);
						 item = new("/clone/shenshi/hu9");
                        item->move(me, 1);
						 item = new("/clone/shenshi/xuan9");
                        item->move(me, 1);
						 item = new("/clone/shenshi/long9");
                        item->move(me, 1);
						 item = new("/clone/shenshi/shen9");
                        item->move(me, 1);
						 item = new("/clone/qihun1");
                        item->move(me, 1);
                        item = new("/clone/qihun1");
                        item->move(me, 1);
                       item = new("/clone/qihun2");
                        item->move(me, 1);
                        item = new("/clone/qihun2");
                        item->move(me, 1);
                        item = new("/clone/qihun2");
						item->move(me, 1);


        destruct(this_object());
        return 1;
}