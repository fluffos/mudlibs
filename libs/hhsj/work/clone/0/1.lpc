#include <ansi.h>
#include <armor.h>
inherit WRISTS;

void create()
{
        set_name(HBCYN "洪荒护腕" NOR, ({ "honghuang wrists", "wrists" }));
        set_weight(500);
        /*if (clonep())
                set_default_object(__FILE__);
        else*/
        {
                set("unit", "柄");
                set("long", HIY "这便是洪荒曾经使用的护腕，遍体血光冲天。\n"
                            HIY + name() + HIY "的等级：远古神品  LV10\n" NOR);
                 set("yuanbao", 5); 
                set("no_sell", "这样东西不能卖。\n");
                set("material", "hong huang");
               // set("no_pawn", 1);
                //set("no_store", 1); // 不能用干降符文upd
                //set("no_save", 1); // quit不保存
                set("armor_prop/armor", 10000);
        }     

        set("mod_mark", "T6");
        set("mod_level", "T8");
        set("mod_name", HBRED "洪荒套装" NOR);

        set("quality_level", 5);
        
        setup();
}



int query_autoload() { return 0; }
