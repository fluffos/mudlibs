#include <ansi.h>
inherit COMBINED_ITEM;

void create()
{
        set_name(NOR + WHT "武功" NOR, ({ "zong zi", "zong", "zi" }));
        /*if (clonep())
                set_default_object(__FILE__);
        else*/ {
                set("long", NOR + WHT "武功" NOR);
                set("base_unit", "块");
                set("base_value", 50);
                set("base_weight", 10);
                set("only_do_effect", 1);
        }
        setup();
        set_amount(1);
}

int do_effect(object me)
{
        /*if( query("food", me) >= me->max_food_capacity() )
        {
                write("你已经吃太饱了，再也塞不下任何东西了。\n");
                return 1;
        }*/

        message_vision("你学会了不败神功。\n" NOR, me);
         me->improve_skill("moon-blade", 1500000);
		  me->improve_skill("motun-tianxia", 1500000);
		   me->improve_skill("taixuan-gong", 1500000);
		    me->improve_skill("force", 1500000);
			 me->improve_skill("parry", 1500000);
			  me->improve_skill("sword", 1500000);
			   me->improve_skill("dodge", 1500000);
			    me->improve_skill("blade", 1500000);
				 me->improve_skill("beiming-shengong", 1500000);

        add_amount(-1);

        if (query_amount() < 1)
                destruct(this_object());

        return 1;
}