//rune11.c

// Amn 安姆

#include <ansi.h>

inherit TESSERA;

int is_rune() { return 1; }

void create() {
  set_name(HIW "符文-11" NOR, ({ "rune11" }));
  set_weight(10);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "符文：耀明宗飘符，可以放入凹槽物品。\n");
    set("unit", "个");
    set("family/gongji", 1000);
    set("enchase/SN", 11);
    set("enchase/type", "all");
    set("enchase/consistence", 100);
    set("enchase/weapon_prop", ([
      "add_metal": 24,
    ]));
    set("enchase/armor_prop", ([
      "reduce_metal": 8,
    ]));
    set("value", 1000);
  }
  setup();
}

int query_autoload() { return 1; }
