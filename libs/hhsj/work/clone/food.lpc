#include <ansi.h>
inherit COMBINED_ITEM;

void create()
{
        set_name(NOR + WHT "粽子" NOR, ({ "zong zi", "zong", "zi" }));
        /*if (clonep())
                set_default_object(__FILE__);
        else*/ {
                set("long", NOR + WHT "这是一个分不出种类的粽子看起来很好吃的样子" NOR);
                set("base_unit", "块");
                set("base_value", 50);
                set("base_weight", 10);
                set("only_do_effect", 1);
        }
        setup();
        set_amount(1);
}

int do_effect(object me)
{
        if( query("food", me) >= me->max_food_capacity() )
        {
                write("你已经吃太饱了，再也塞不下任何东西了。\n");
                return 1;
        }

        message_vision("$N啊，屈原我替你吃粽子了地下好好待着。\n" NOR, me);
        addn("gongde", 3000, me);
		addn("yuanbao", 200, me);
		addn("max_neili", 2000000, me);

        add_amount(-1);

        if (query_amount() < 1)
                destruct(this_object());

        return 1;
}