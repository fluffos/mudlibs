#include <ansi.h>

inherit ITEM;

void create()
{
        set_name(HIM "洪荒异种" NOR, ({"hong huang", "hong", "huang"}));
        set_weight(10000);
        /*if (clonep())
                set_default_object(__FILE__);
        else*/
        {
                set("long", sort_msg(HIM "洪荒异种，混沌所生，但是这到底是个啥，谁也不知道。\n" NOR));
                set("unit", "块");
                 set("cz", 5);
                set("item_origin", 1);
                set("material_attrib", "hong huang");
                set("material_name", HIM "洪荒异种" NOR);
                set("can_make", "all");
                set("power_point", 5000+random(101));
        }
}

