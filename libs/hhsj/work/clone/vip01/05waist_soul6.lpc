#include <ansi.h>

inherit EQUIP_SOUL;

void create() {
  set_name(HIM "腰带之魂" NOR, ({ "waist soul6" }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", HIM "完美的腰带之魂，可用来改造腰带。\n" NOR);
    set("unit", "个");
    set("yuanbao", 10);
    set("value", 10000);
    set("no_sell", 1);
  }
  set("type", "waist");
  set("status", 6);
  set("auto_load", 1);

  setup();
}
