// This program is a part of NT MudLIB
// ab_crystal.c 能力水晶

#include <ansi.h>

inherit ITEM;

void create() {
  set_name(HIC "强化水晶" NOR, ({ "qhsj" }));
  set_weight(1);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", HIC "装备在6星之前使用（不包括6星），可以100%强化成功，qianghua xxx with qhsj \n" NOR);
    set("yuanbao", 100);
    set("value", 10000);
    set("unit", "块");
  }
  //set("set_data", 1);
  set("autoload", 1);
  setup();
}
