#include <ansi.h>
inherit BAOXIANG_ITEM;

void create() {
  set_name(HIM "洪荒月饼" NOR, ({ "yue" }));
  //这个一定要设置：
  set("BAOXIANG_LIST", ([
    "/clone/jiu": 910,
    "/clone/nan": 909,
    "/clone/bu": 909,
    "/clone/kui": 909,
    "/clone/xuan": 909,
    "/clone/bai": 909,
    "/clone/qing": 909,
    "/clone/hou": 909,
    "/clone/ba": 909,
    "/clone/yin": 909,
    "/clone/liu": 909,

  ]));

  set("long", HIY "这是一块洪荒月饼吃了可以领悟已经消失的武学。\n" NOR);
  set("unit", "些");
  set("yuanbao", 35);
  set("base_unit", "个");
  set("no_give", 1);
  set("no_drop", 1);
  set("base_weight", 1);
  set("base_value", 1);
  set_amount(1);  //因为是个combined物品 所以这个一定要设置，不然报错的
}
void init() {
  add_action("do_open", "open");  //玩家使用的接口 具体内容在std里
  add_action("do_test", "test");  //用于巫师测试用 测试ok请注释此行
}
