#include <ansi.h>

inherit ITEM;

void create() {
  set_name(HIG "清除死亡记录" NOR, ({ "sw dan" }));
  set_weight(200);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "清除死亡记录的丹药\n" ZJURL("cmds:eat sw dan") ZJSIZE(15) "使用" NOR "看看!\n");
    set("yuanbao", 10);
    set("value", 10000);
    set("unit", "粒");
    set("only_do_effect", 1);
  }
}

int do_effect(object me) {
  message_vision("$N一仰脖，吞下了一粒" + this_object()->name() +
    "。\n", me);
  delete("combat/last_die", me);
  delete("combat/dietimes", me);

  destruct(this_object());
  return 1;
}
