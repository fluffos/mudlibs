#include <ansi.h>

inherit ITEM;

void create() {
  set_name(HIG "文曲套装" NOR, ({ "wis dan" }));
  set_weight(200);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "研究练习汲取效果+240% 后天悟性+200\n" ZJURL("cmds:eat wis dan") ZJSIZE(15) "使用" NOR "看看!\n");
    // set("yuanbao", 200);
    set("value", 1000);
    set("unit", "粒");
    set("only_do_effect", 1);
  }
}

int do_effect(object me) {
  object item;

  message_vision("$N一仰脖，吞下了一粒" + this_object()->name() +
    "。\n", me);

  item = new("/clone/goods/wisdom_armor");
  item->move(me, 1);
  item = new("/clone/goods/wisdom_head");
  item->move(me, 1);
  item = new("/clone/goods/wisdom_boots");
  item->move(me, 1);
  item = new("/clone/goods/wisdom_surcoat");
  item->move(me, 1);
  item = new("/clone/goods/wisdom_waist");
  item->move(me, 1);
  item = new("/clone/goods/wisdom_wrists");
  item->move(me, 1);
  item = new("/clone/goods/wisdom_cloth");
  item->move(me, 1);

  destruct(this_object());
  return 1;
}
