#include <ansi.h>

inherit ITEM;

void create()
{
        set_name(HIR "先天臂力" NOR, ({ "str dan" }) );
        set_weight(200);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long","增加先天臂力的故事丹。\n"ZJURL("cmds:eat str dan")ZJSIZE(15)"使用"NOR"看看!\n");
                set("yuanbao", 50);
                set("value", 1000);
                set("unit", "粒");
                set("only_do_effect", 1);
        }
}

int do_effect(object me)
{
        message_vision("$N一仰脖，吞下了一粒" + this_object()->name() +"。\n", me);
        if(!query("gift/sun", me))
        {
        message_vision("恭喜$N成功增加先天臂力1点" + this_object()->name() +"。\n", me);
                addn("str", 1, me);
                addn("gift/sun", 1, me);
                destruct(this_object());
        }
        else
        {
        message_vision("$N已经吃过了，再吃无效。" + this_object()->name() +"。\n", me);
        }
        return 1;
}
