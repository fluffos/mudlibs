#include <ansi.h>

inherit ITEM;

void create() {
  set_name(HIG "符文大礼包" NOR, ({ "wis dan" }));
  set_weight(200);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "包含01到36的符文\n" ZJURL("cmds:eat wis dan") ZJSIZE(15) "使用" NOR "看看!\n");
    set("yuanbao", 380);
    set("value", 1000);
    set("unit", "粒");
    set("only_do_effect", 1);
  }
}

int do_effect(object me) {
  object item;

  message_vision("$N一仰脖，吞下了一粒" + this_object()->name() +
    "。\n", me);

