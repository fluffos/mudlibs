
#include <ansi.h>

inherit ITEM;

int is_tongren() { return 1; }
void create()
{
        set_name( "带脉·浮白穴" NOR, ({ "tongren e5" }));
        set_weight(50);
        
        set("unit", "个");
        set("long", NOR + YEL "这是一个冲穴铜人\n"ZJURL("cmds:chongxue tongren e5")ZJSIZE(10)"冲穴"NOR"\n");
        set("value", 10000);
        set("material", "steal");

        set("jingmai_name", "带脉");
        set("xuewei_name", "浮白穴");
        set("chongxue_xiaoguo", "WEAPON:10");
        set("neili_cost", "6000");
        setup();
}


