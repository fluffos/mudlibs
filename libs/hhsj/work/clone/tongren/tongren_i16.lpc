#include <ansi.h>

inherit ITEM;

int is_tongren() { return 1; }
void create() {
  set_name("经外奇脉·二白穴" NOR, ({ "tongren i16" }));
  set_weight(50);

  set("unit", "个");
  set("long", NOR + YEL "这是一个冲穴铜人\n" ZJURL("cmds:chongxue tongren i16") ZJSIZE(10) "冲穴" NOR "\n");
  set("value", 10000);
  set("material", "steal");

  set("jingmai_name", "经外奇脉");
  set("xuewei_name", "二白穴");
  set("chongxue_xiaoguo", "QI:100");
  set("neili_cost", "8000");
  setup();
}
