#include <ansi.h>

inherit ITEM;

int is_tongren() { return 1; }
void create() {
  set_name("督外脉·强间穴" NOR, ({ "tongren g15" }));
  set_weight(50);

  set("unit", "个");
  set("long", NOR + YEL "这是一个冲穴铜人\n" ZJURL("cmds:chongxue tongren g15") ZJSIZE(10) "冲穴" NOR "\n");
  set("value", 10000);
  set("material", "steal");

  set("jingmai_name", "督外脉");
  set("xuewei_name", "强间穴");
  set("chongxue_xiaoguo", "JIALI:5:DMG:10");
  set("neili_cost", "12000");
  setup();
}
