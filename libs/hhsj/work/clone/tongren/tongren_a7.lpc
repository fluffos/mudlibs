#include <ansi.h>

inherit ITEM;

int is_tongren() { return 1; }
void create() {
  set_name("阴跷脉·乳根穴" NOR, ({ "tongren a7" }));
  set_weight(50);

  set("unit", "个");
  set("long", NOR + YEL "这是一个冲穴铜人\n" ZJURL("cmds:chongxue tongren a7") ZJSIZE(10) "冲穴" NOR "\n");
  set("value", 10000);
  set("material", "steal");

  set("jingmai_name", "阴跷脉");
  set("xuewei_name", "乳根穴");
  set("chongxue_xiaoguo", "QI:30");
  set("neili_cost", "100");
  setup();
}
