
#include <ansi.h>

inherit ITEM;

int is_tongren() { return 1; }
void create()
{
        set_name( "阴跷脉·解溪穴" NOR, ({ "tongren a16" }));
        set_weight(50);
        
        set("unit", "个");
        set("long", NOR + YEL "这是一个冲穴铜人\n"ZJURL("cmds:chongxue tongren a16")ZJSIZE(10)"冲穴"NOR"\n");
        set("value", 10000);
        set("material", "steal");

        set("jingmai_name", "阴跷脉");
        set("xuewei_name", "解溪穴");
        set("chongxue_xiaoguo", "POT:20");
        set("neili_cost", "100");
        setup();
}


