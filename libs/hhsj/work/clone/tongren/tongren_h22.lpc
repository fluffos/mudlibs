
#include <ansi.h>

inherit ITEM;

int is_tongren() { return 1; }
void create()
{
        set_name( "任外脉·俞府穴" NOR, ({ "tongren h22" }));
        set_weight(50);
        
        set("unit", "个");
        set("long", NOR + YEL "这是一个冲穴铜人\n"ZJURL("cmds:chongxue tongren h22")ZJSIZE(10)"冲穴"NOR"\n");
        set("value", 10000);
        set("material", "steal");

        set("jingmai_name", "任外脉");
        set("xuewei_name", "俞府穴");
        set("chongxue_xiaoguo", "JIALI:20:_INT:4");
        set("neili_cost", "18000");
        setup();
}


