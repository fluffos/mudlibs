#include <ansi.h>

inherit ITEM;

int is_tongren() { return 1; }
void create() {
  set_name("手太阴脉·太渊穴" NOR, ({ "tongren j2" }));
  set_weight(50);

  set("unit", "个");
  set("long", NOR + YEL "这是一个冲穴铜人\n" ZJURL("cmds:chongxue tongren j2") ZJSIZE(10) "冲穴" NOR "\n");
  set("value", 10000);
  set("material", "steal");

  set("jingmai_name", "手太阴脉");
  set("xuewei_name", "太渊穴");
  set("chongxue_xiaoguo", "QI:30");
  set("neili_cost", "150");
  setup();
}
