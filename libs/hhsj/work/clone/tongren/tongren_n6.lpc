#include <ansi.h>

inherit ITEM;

int is_tongren() { return 1; }
void create() {
  set_name("手少阴脉·神门穴" NOR, ({ "tongren n6" }));
  set_weight(50);

  set("unit", "个");
  set("long", NOR + YEL "这是一个冲穴铜人\n" ZJURL("cmds:chongxue tongren n6") ZJSIZE(10) "冲穴" NOR "\n");
  set("value", 10000);
  set("material", "steal");

  set("jingmai_name", "手少阴脉");
  set("xuewei_name", "神门穴");
  set("chongxue_xiaoguo", "NEI:30");
  set("neili_cost", "4000");
  setup();
}
