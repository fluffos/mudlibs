#include <ansi.h>

inherit ITEM;

int is_tongren() { return 1; }
void create() {
  set_name("手太阳脉·小海穴" NOR, ({ "tongren k19" }));
  set_weight(50);

  set("unit", "个");
  set("long", NOR + YEL "这是一个冲穴铜人\n" ZJURL("cmds:chongxue tongren k19") ZJSIZE(10) "冲穴" NOR "\n");
  set("value", 10000);
  set("material", "steal");

  set("jingmai_name", "手太阳脉");
  set("xuewei_name", "小海穴");
  set("chongxue_xiaoguo", "NEI:30");
  set("neili_cost", "1200");
  setup();
}
