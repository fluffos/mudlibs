#include <ansi.h>

inherit ITEM;

int is_tongren() { return 1; }
void create() {
  set_name("足厥阴脉·章门穴" NOR, ({ "tongren u7" }));
  set_weight(50);

  set("unit", "个");
  set("long", NOR + YEL "这是一个冲穴铜人\n" ZJURL("cmds:chongxue tongren u7") ZJSIZE(10) "冲穴" NOR "\n");
  set("value", 10000);
  set("material", "steal");

  set("jingmai_name", "足厥阴脉");
  set("xuewei_name", "章门穴");
  set("chongxue_xiaoguo", "JING:50:_DEX:2");
  set("neili_cost", "8000");
  setup();
}
