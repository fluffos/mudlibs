
#include <ansi.h>

inherit ITEM;

int is_tongren() { return 1; }
void create()
{
        set_name( "足少阳脉·天冲穴" NOR, ({ "tongren q7" }));
        set_weight(50);
        
        set("unit", "个");
        set("long", NOR + YEL "这是一个冲穴铜人\n"ZJURL("cmds:chongxue tongren q7")ZJSIZE(10)"冲穴"NOR"\n");
        set("value", 10000);
        set("material", "steal");

        set("jingmai_name", "足少阳脉");
        set("xuewei_name", "天冲穴");
        set("chongxue_xiaoguo", "NEI:150:WATER:100");
        set("neili_cost", "9000");
        setup();
}


