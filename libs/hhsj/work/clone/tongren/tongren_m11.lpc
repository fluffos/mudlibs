
#include <ansi.h>

inherit ITEM;

int is_tongren() { return 1; }
void create()
{
        set_name( "足太阳脉·五处穴" NOR, ({ "tongren m11" }));
        set_weight(50);
        
        set("unit", "个");
        set("long", NOR + YEL "这是一个冲穴铜人\n"ZJURL("cmds:chongxue tongren m11")ZJSIZE(10)"冲穴"NOR"\n");
        set("value", 10000);
        set("material", "steal");

        set("jingmai_name", "足太阳脉");
        set("xuewei_name", "五处穴");
        set("chongxue_xiaoguo", "QI:20");
        set("neili_cost", "600");
        setup();
}


