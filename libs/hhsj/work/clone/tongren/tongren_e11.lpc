
#include <ansi.h>

inherit ITEM;

int is_tongren() { return 1; }
void create()
{
        set_name( "带脉·目窗穴" NOR, ({ "tongren e11" }));
        set_weight(50);
        
        set("unit", "个");
        set("long", NOR + YEL "这是一个冲穴铜人\n"ZJURL("cmds:chongxue tongren e11")ZJSIZE(10)"冲穴"NOR"\n");
        set("value", 10000);
        set("material", "steal");

        set("jingmai_name", "带脉");
        set("xuewei_name", "目窗穴");
        set("chongxue_xiaoguo", "JIALI:30");
        set("neili_cost", "1800");
        setup();
}


