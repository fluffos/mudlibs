
#include <ansi.h>

inherit ITEM;

int is_tongren() { return 1; }
void create()
{
        set_name( "督外脉·身柱穴" NOR, ({ "tongren g10" }));
        set_weight(50);
        
        set("unit", "个");
        set("long", NOR + YEL "这是一个冲穴铜人\n"ZJURL("cmds:chongxue tongren g10")ZJSIZE(10)"冲穴"NOR"\n");
        set("value", 10000);
        set("material", "steal");

        set("jingmai_name", "督外脉");
        set("xuewei_name", "身柱穴");
        set("chongxue_xiaoguo", "JIALI:30");
        set("neili_cost", "4000");
        setup();
}


