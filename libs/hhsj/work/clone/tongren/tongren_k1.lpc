
#include <ansi.h>

inherit ITEM;

int is_tongren() { return 1; }
void create()
{
        set_name( "手太阳脉·少泽穴" NOR, ({ "tongren k1" }));
        set_weight(50);
        
        set("unit", "个");
        set("long", NOR + YEL "这是一个冲穴铜人\n"ZJURL("cmds:chongxue tongren k1")ZJSIZE(10)"冲穴"NOR"\n");
        set("value", 10000);
        set("material", "steal");

        set("jingmai_name", "手太阳脉");
        set("xuewei_name", "少泽穴");
        set("chongxue_xiaoguo", "JING:20:_INT:1");
        set("neili_cost", "300");
        setup();
}


