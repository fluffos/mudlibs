#include <ansi.h>

inherit ITEM;

int is_tongren() { return 1; }
void create() {
  set_name("冲脉·水突穴" NOR, ({ "tongren f21" }));
  set_weight(50);

  set("unit", "个");
  set("long", NOR + YEL "这是一个冲穴铜人\n" ZJURL("cmds:chongxue tongren f21") ZJSIZE(10) "冲穴" NOR "\n");
  set("value", 10000);
  set("material", "steal");

  set("jingmai_name", "冲脉");
  set("xuewei_name", "水突穴");
  set("chongxue_xiaoguo", "AMR:40");
  set("neili_cost", "4000");
  setup();
}
