
#include <ansi.h>

inherit ITEM;

int is_tongren() { return 1; }
void create()
{
        set_name( "足少阳脉·悬厘穴" NOR, ({ "tongren q24" }));
        set_weight(50);
        
        set("unit", "个");
        set("long", NOR + YEL "这是一个冲穴铜人\n"ZJURL("cmds:chongxue tongren q24")ZJSIZE(10)"冲穴"NOR"\n");
        set("value", 10000);
        set("material", "steal");

        set("jingmai_name", "足少阳脉");
        set("xuewei_name", "悬厘穴");
        set("chongxue_xiaoguo", "NEI:130:FOOD:100");
        set("neili_cost", "18000");
        setup();
}


