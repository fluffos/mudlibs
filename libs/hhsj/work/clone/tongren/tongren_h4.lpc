
#include <ansi.h>

inherit ITEM;

int is_tongren() { return 1; }
void create()
{
        set_name( "任外脉·下脘穴" NOR, ({ "tongren h4" }));
        set_weight(50);
        
        set("unit", "个");
        set("long", NOR + YEL "这是一个冲穴铜人\n"ZJURL("cmds:chongxue tongren h4")ZJSIZE(10)"冲穴"NOR"\n");
        set("value", 10000);
        set("material", "steal");

        set("jingmai_name", "任外脉");
        set("xuewei_name", "下脘穴");
        set("chongxue_xiaoguo", "QI:20:_DEX:4");
        set("neili_cost", "6000");
        setup();
}


