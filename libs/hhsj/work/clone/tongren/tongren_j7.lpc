
#include <ansi.h>

inherit ITEM;

int is_tongren() { return 1; }
void create()
{
        set_name( "手太阴脉·经渠穴" NOR, ({ "tongren j7" }));
        set_weight(50);
        
        set("unit", "个");
        set("long", NOR + YEL "这是一个冲穴铜人\n"ZJURL("cmds:chongxue tongren j7")ZJSIZE(10)"冲穴"NOR"\n");
        set("value", 10000);
        set("material", "steal");

        set("jingmai_name", "手太阴脉");
        set("xuewei_name", "经渠穴");
        set("chongxue_xiaoguo", "NEI:20");
        set("neili_cost", "100");
        setup();
}


