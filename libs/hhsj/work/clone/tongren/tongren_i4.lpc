#include <ansi.h>

inherit ITEM;

int is_tongren() { return 1; }
void create() {
  set_name("经外奇脉·太阳穴" NOR, ({ "tongren i4" }));
  set_weight(50);

  set("unit", "个");
  set("long", NOR + YEL "这是一个冲穴铜人\n" ZJURL("cmds:chongxue tongren i4") ZJSIZE(10) "冲穴" NOR "\n");
  set("value", 10000);
  set("material", "steal");

  set("jingmai_name", "经外奇脉");
  set("xuewei_name", "太阳穴");
  set("chongxue_xiaoguo", "JING:500");
  set("neili_cost", "30000");
  setup();
}
