
#include <ansi.h>

inherit ITEM;

int is_tongren() { return 1; }
void create()
{
        set_name( "足厥阴脉·曲泉穴" NOR, ({ "tongren u10" }));
        set_weight(50);
        
        set("unit", "个");
        set("long", NOR + YEL "这是一个冲穴铜人\n"ZJURL("cmds:chongxue tongren u10")ZJSIZE(10)"冲穴"NOR"\n");
        set("value", 10000);
        set("material", "steal");

        set("jingmai_name", "足厥阴脉");
        set("xuewei_name", "曲泉穴");
        set("chongxue_xiaoguo", "JING:30:_CON:3");
        set("neili_cost", "8000");
        setup();
}


