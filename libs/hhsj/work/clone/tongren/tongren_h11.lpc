#include <ansi.h>

inherit ITEM;

int is_tongren() { return 1; }
void create() {
  set_name("任外脉·水泉穴" NOR, ({ "tongren h11" }));
  set_weight(50);

  set("unit", "个");
  set("long", NOR + YEL "这是一个冲穴铜人\n" ZJURL("cmds:chongxue tongren h11") ZJSIZE(10) "冲穴" NOR "\n");
  set("value", 10000);
  set("material", "steal");

  set("jingmai_name", "任外脉");
  set("xuewei_name", "水泉穴");
  set("chongxue_xiaoguo", "JING:20:_STR:5");
  set("neili_cost", "25000");
  setup();
}
