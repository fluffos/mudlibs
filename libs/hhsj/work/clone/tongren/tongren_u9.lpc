#include <ansi.h>

inherit ITEM;

int is_tongren() { return 1; }
void create() {
  set_name("足厥阴脉·膝关穴" NOR, ({ "tongren u9" }));
  set_weight(50);

  set("unit", "个");
  set("long", NOR + YEL "这是一个冲穴铜人\n" ZJURL("cmds:chongxue tongren u9") ZJSIZE(10) "冲穴" NOR "\n");
  set("value", 10000);
  set("material", "steal");

  set("jingmai_name", "足厥阴脉");
  set("xuewei_name", "膝关穴");
  set("chongxue_xiaoguo", "NEI:30:_DEX:1");
  set("neili_cost", "8000");
  setup();
}
