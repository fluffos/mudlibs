#include <ansi.h>

inherit ITEM;

int is_tongren() { return 1; }
void create() {
  set_name("足阳明脉·冲阳穴" NOR, ({ "tongren s37" }));
  set_weight(50);

  set("unit", "个");
  set("long", NOR + YEL "这是一个冲穴铜人\n" ZJURL("cmds:chongxue tongren s37") ZJSIZE(10) "冲穴" NOR "\n");
  set("value", 10000);
  set("material", "steal");

  set("jingmai_name", "足阳明脉");
  set("xuewei_name", "冲阳穴");
  set("chongxue_xiaoguo", "QI:30");
  set("neili_cost", "8000");
  setup();
}
