
#include <ansi.h>

inherit ITEM;

int is_tongren() { return 1; }
void create()
{
        set_name( "阳维脉·肩井穴" NOR, ({ "tongren d3" }));
        set_weight(50);
        
        set("unit", "个");
        set("long", NOR + YEL "这是一个冲穴铜人\n"ZJURL("cmds:chongxue tongren d3")ZJSIZE(10)"冲穴"NOR"\n");
        set("value", 10000);
        set("material", "steal");

        set("jingmai_name", "阳维脉");
        set("xuewei_name", "肩井穴");
        set("chongxue_xiaoguo", "POT:200:MAR:200");
        set("neili_cost", "2000");
        setup();
}


