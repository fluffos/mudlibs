
#include <ansi.h>

inherit ITEM;

int is_tongren() { return 1; }
void create()
{
        set_name( "足少阴脉·石关穴" NOR, ({ "tongren p10" }));
        set_weight(50);
        
        set("unit", "个");
        set("long", NOR + YEL "这是一个冲穴铜人\n"ZJURL("cmds:chongxue tongren p10")ZJSIZE(10)"冲穴"NOR"\n");
        set("value", 10000);
        set("material", "steal");

        set("jingmai_name", "足少阴脉");
        set("xuewei_name", "石关穴");
        set("chongxue_xiaoguo", "NEI:30");
        set("neili_cost", "4000");
        setup();
}


