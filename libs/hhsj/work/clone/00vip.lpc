#include <localtime.h>
#include <ansi.h>
inherit ITEM;

//函数生命
int GiveVipItem(object me);

//结构函数
void create()
{
        set_name(HIY"贵宾卡-月"NOR, ({ "vip card"}) );
        set("long","30天VIP贵宾会员卡。"ZJURL("cmds:upvip")ZJSIZE(12)"我要升级"NOR"！\n"
        );
        set("unit", "张");
        set("yuanbao", 150);
        set("value", 10000);
		set("no_sell", 1);
        set("no_put", 1);
        set("no_give", 1);
		set("no_drop", 1);
}

void init()
{
        add_action("do_vip", "upvip");
}

int do_vip(string arg)
{
        object me,ob;
        me = this_player();
        ob = this_object();
        

        if(GiveVipItem(me))
        {
                destruct(ob);
                return 1;
        }
        else
        {
                tell_object(me,HIR"升级贵宾权限失败，请联系Wiz。\n"NOR);
                return 1;
        }
        return 1;
}

//函数：赠送道具
int GiveVipItem(object me)
{
        int time;
        mixed localtime;


        if(!me) return 0;
        
        if(!query("hhsjvip_time",me)) time = time()+24*3600*30;
        else time = query("hhsjvip_time",me) + 24*3600*30;
        localtime = localtime(time);
                
        message_vision(HIR"$N成为了VIP贵宾!恭喜恭喜\n"NOR,me);
        tell_object(me,sprintf(HIG"贵宾权限到期时间%d年%d月%d日%d时%d分%d秒。\n"NOR,localtime[LT_YEAR],1+localtime[LT_MON],localtime[LT_MDAY],localtime[LT_HOUR],localtime[LT_MIN],localtime[LT_SEC]));
        set("hhsjvip", 1,me);
        set("hhsjvip_time",time,me);
        set("title",HIY"VIP贵宾"NOR,me);
        addn("srv/quit_save", 86400*30);

		

        me->save();

        return 1;
}
int query_autoload()
{
        return 1;
}

