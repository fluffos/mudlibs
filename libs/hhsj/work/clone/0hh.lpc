#include <ansi.h>

inherit ITEM;

void create() {
  set_name(HIG "洪荒套装" NOR, ({ "xm dan" }));
  set_weight(200);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "洪荒套装\n" ZJURL("cmds:eat xm dan") ZJSIZE(15) "使用" NOR "看看!\n");
    set("yuanbao", 15);
    set("value", 1000);
    set("unit", "粒");
    set("only_do_effect", 1);
  }
}

int do_effect(object me) {
  object item;

  message_vision("$N一仰脖，吞下了一粒" + this_object()->name() +
    "。\n", me);

  item = new("/clone/0/1");
  item->move(me, 1);
  item = new("/clone/0/2");
  item->move(me, 1);

  item = new("/clone/0/5");
  item->move(me, 1);

  item = new("/clone/0/8");
  item->move(me, 1);
  item = new("/clone/0/9");
  item->move(me, 1);
  item = new("/clone/0/10");
  item->move(me, 1);
  item = new("/clone/0/11");
  item->move(me, 1);

  item = new("/clone/0/13");
  item->move(me, 1);

  item = new("/clone/0/16");
  item->move(me, 1);




  destruct(this_object());
  return 1;
}
