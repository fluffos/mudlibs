#include <ansi.h>

inherit TESSERA;

void create() {
  set_name(RED "罗喉残魂" NOR, ({ "jing po", "jing" }));
  set_weight(1);
  /*if (clonep())
                set_default_object(__FILE__);
        else*/
  {
    set("long", RED "神魔精魄。。\n" NOR);
    set("value", 50000);
    set("unit", "块");
    set("can_enchant", "weapon");
    set("can_be_enchased", 1);
    set("magic/type", "magic");
    set("magic/power", 500);
    set("auto_load", 1);
  }

  set("enchase", ([ /* sizeof() == 5 */
    "weapon_prop": ([ /* sizeof() == 3 */
      "str": 20,
      "int": 20,
      "con": 20,
      "dex": 20,
      "ker": 20,
      "par": 20,
      "avoid_poison": 5,
      "counter_damage": 5,
      "add_skill": 200,
    ]),
    "type": "all",
    //"SN" : 1 + random(9),
  ]));

  set("enchant", 1);
  set("set_data", 1);
  setup();
}
