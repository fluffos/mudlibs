// hua4.c

inherit ITEM;

#include <ansi.h>

void create()
{
	set_name(HIC "脑残片" NOR, ({"naocan pian", "naocan", "pian"}));
   /*if (clonep())
		set_default_object(__FILE__);
   else*/ {
        	set("unit", "粒");
		set("long", "这是一粒脑残片。\n");
        	set("value", 10000000);
		set("only_do_effect", 1);
	}
        setup();
}

int do_effect(object me)
{
	object ob;
         mapping my;
	
        int time = 20;

        // vip的效果
        switch( me->query_viplevel() )
        {
        case 1:
                time = time - time / 10;
                break;
        case 2:
                time = time - time * 2 / 10;
                break;
        case 3:
                time = time - time * 3 / 10;
                break;
        case 4:
                time = time - time * 4 / 10;
                break;
        case 5:
                time = time - time * 5 / 10;
                break;
        case 6:
                time = time - time * 6 / 10;
                break;  
        case 7:
                time = time - time * 7 / 10;
                break;                  
        }
        if( time < 1 ) time = 1;
		

       /* if( time()-query_temp("last_eat/feicui", me) < time ) 
        {
                write("你刚服用过药，需药性发挥完效用以后才能继续服用。\n"); 
                return 1; 
        }*/
        
		if (me->is_fighting()) {
                tell_object(me, "你正在打架没空！\n");
                return 1;
        }
		
        set_temp("last_eat/naocan", time(), me); 
        me->clear_condition();
        delete_temp("block_msg/all", me);
        my = me->query_entire_dbase();
        my["jing"]   = my["eff_jing"]   = my["max_jing"]; 
        my["jingli"] = my["eff_jingli"] = my["max_jingli"]; 
        my["qi"]     = my["eff_qi"]     = my["max_qi"]; 
        my["neili"]  = my["max_neili"];
        me->clear_condition();
        me->clear_weak();
        message_vision("$N把" + name() + "扔进嘴里，直接就化散开。\n", me);
	tell_object(me, HIG "\n你只觉一股脑子混乱，顿时如同疯魔之人"
		        "脑识昏乱，苦不堪言！\n" NOR);
	destruct(this_object());
	return 1;
}
