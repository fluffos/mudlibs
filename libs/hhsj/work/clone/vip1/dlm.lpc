#include <ansi.h> 
inherit ITEM;

void create()
{
        set_name(NOR YEL "大灵脉" NOR, ({"da lm", "da", "lm" }));
                set("long", "大灵脉。\n");
                set("unit", "只");
                set("value", 500000000000);
				//set("yuanbao", 300);
                set("base_value", 500000000000);
                set("base_unit", "只");
				set("only_do_effect", 1);
                set("base_weight", 1000000);
                set("is da lm", 1);
        setup();
}

