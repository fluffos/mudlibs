// tianxin.c

#include <ansi.h>
#include "/clone/medicine/medicine.h"

void create() {
  set_name(HIW "二级解毒丹" NOR, ({ "jd2 dan" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "这是一粒白色的药丸，具有相当好的解毒效果。\n");
    set("base_unit", "粒");
    set("base_value", 2000);
    set("base_weight", 50);
    set("only_do_effect", 1);
  }
  setup();
}

int do_effect(object me) {
  if (time() - query_temp("last_eat/tianxin", me) < 10) {
    write("你刚服用过药，需药性发挥完效用以后才能继续服用。\n");
    return 1;
  }

  if (!me->query_skill_mapped("force")) {
    write("你没有激发任何内功，怎么发挥药力进行驱毒？\n");
    return 1;
  }

  set_temp("last_eat/tianxin", time(), me);

  message_vision(HIY "$N" HIY "暗暗运了一口气，服下了" + name() +
    HIY "，盘膝坐下，开始运功逼毒。\n" NOR, me);

  // 运功驱毒
  addn_temp("apply/dispel_poison", 150, me);
  SKILL_D("force")->exert_function(me, "dispel");
  addn_temp("apply/dispel_poison", -150, me);

  add_amount(-1);
  if (query_amount() < 1)
    destruct(this_object());

  return 1;
}
