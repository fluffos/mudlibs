// coin.c

#include <weapon.h>
#include <ansi.h>

inherit MONEY;
inherit F_EQUIP;

void create()
{
        set_name(HIY "灵石碎片" NOR, ({"coin", "coins", "coin_money" }));
        /*if( clonep() )
                set_default_object(__FILE__);
        else*/ {
                set("money_id", "coin");
                set("long", "这是一块充满杂质的碎片，约要一百个碎片才值得一块灵石。\n");
                set("unit", "堆");
                set("base_value", 1);
                set("base_unit", "块");
                set("base_weight", 30);
                set("consistence", 100);

                set("weapon_prop/damage", 10);
                set("flag", 2);
                set("wield_msg", "$N从袖口取出一堆$n抛了抛，握在手中。\n");
                set("unwield_msg", "$N将手中的$n放回兜里。\n");
                set("skill_type", "throwing");
				set("only_do_effect", 1);
                if( !query("actions") ) {
                    set("actions", (: call_other,WEAPON_D, "query_action" :));
                    set("verbs", ({ "throw" }) );
                }
        }
        set_amount(1);
}
int do_effect(object me)
{

        message_vision("$N慢慢吸收灵石里的灵力，感觉功力有所增长。\n" NOR, me);
		addn("max_neili", -10, me);
        addn("max_jingli", -10, me);
        add_amount(-1);

        if (query_amount() < 1)
                destruct(this_object());

        return 1;
}