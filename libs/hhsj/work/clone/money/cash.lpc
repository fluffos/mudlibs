// thousand.c

#include <ansi.h>

inherit MONEY;

void create() {
  set_name("奇异灵石", ({ "cash", "thousand-cash", "cash_money" }));
  /*if( clonep() )
                set_default_object(__FILE__);
        else*/ {
    set("money_id", "cash");
    set("long", "一块很特别的灵石里面充满了暴虐的能量。\n");
    set("unit", "堆");
    set("base_value", 100000);
    set("base_unit", "块");
    set("base_weight", 1);
    set("material", "paper");
    set("only_do_effect", 1);
  }
  set_amount(1);
}
int do_effect(object me) {

  message_vision("$N慢慢吸收灵石里的灵力，感觉功力有所增长。\n" NOR, me);
  addn("max_neili", -10000, me);
  addn("max_jingli", -10000, me);
  add_amount(-1);

  if (query_amount() < 1)
    destruct(this_object());

  return 1;
}
