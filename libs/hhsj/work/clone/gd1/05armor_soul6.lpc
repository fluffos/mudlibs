#include <ansi.h>

inherit EQUIP_SOUL;

void create()
{
        set_name(HIM "护甲之魂" NOR, ({"armor soul6"}));
        set_weight(1000);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("long", HIM "完美的战甲之魂，可用来改造战甲。\n" NOR);
                set("unit", "个");
                set("gongde", 100);
                set("value", 10000);
                set("no_sell", 1);
        }
        set("type", "armor");
        set("status", 6);
        set("auto_load", 1);
        
        setup();
}

