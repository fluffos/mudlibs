#include <ansi.h>

inherit ITEM;

void create() {
  set_name(HIY "杀气冲霄" NOR, ({ "hatred" }));
  set_weight(200);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "先天技能\n" ZJURL("cmds:eat hatred") ZJSIZE(15) "使用" NOR "看看!\n");
    set("gongde", 500);
    set("value", 10000);
    set("unit", "粒");
    set("only_do_effect", 1);
  }
}

int do_effect(object me) {
  if (!query("special_skill/hatred", me)) {
    set("special_skill/hatred", 1, me);
    message_vision("$N学会了" + this_object()->name() +
      "。\n", me);
    destruct(this_object());
  } else {
    message_vision("$N一仰脖，吞下了一粒" + this_object()->name() +
      "发现原来已经学过这个技能了。\n", me);
  }
  return 1;
}
