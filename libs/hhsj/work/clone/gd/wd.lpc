#include <ansi.h>

inherit ITEM;

void create() {
  set_name(HIR "挖洞" NOR, ({ "w d" }));
  set_weight(200);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "转换男女的挖洞手术。\n" ZJURL("cmds:eat w d") ZJSIZE(15) "使用" NOR "看看!\n");
    set("gongde", 500);
    set("value", 1000);
    set("unit", "粒");
    set("only_do_effect", 1);
  }
}

int do_effect(object ob) {
  message_vision("$N一仰脖，吞下了一粒" + this_object()->name() + "。\n", ob);
  if (query("gender", ob) != "男性") {
    write("你没有jj，无从割弃！\n");
    return 1;
  }
  if (query("gender", ob) == "女性") {
    write("你已经是女人了，不信你抠抠..\n");
    return 1;
  }
  CHANNEL_D->channel_broadcast("rumor", "听说" + query("name", ob) + "去了趟泰国，是不是想先给兄弟们爽爽呢？\n" + NOR);
  set("gender", "女性", ob);
  delete("couple/couple_id", ob);
  delete("couple/child_id", ob);
  destruct(this_object());
  return 1;
}
