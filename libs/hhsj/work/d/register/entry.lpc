// regiser: entry.c
// by Doing

#include <ansi.h>
#include <login.h>
#include <command.h>

inherit ROOM;

int is_chat_room() { return 1; }

int do_choose(string arg);
int do_washto(string arg);

void create() {
  int i, k;
  string desc;
  string *position;

  set("short", HIR "生命之谷" NOR);
  set("long",
    "混沌初分盘古开天地，迷雾、微风，天地初开，四周混沌，雾茫\n"
    "茫一片，这里就是子天丑地人寅出的生命之谷。\n"
    "　　谷中有一个石头砌成的池子，其中水清澈却不见底，不知道它究\n"
    "竟有多深，池子正上方悬挂着太极两仪四象，不知有何奥妙？！\n"
  );
  set("no_fight", 1);
  set("objects", ([
    __DIR__ "npc/pangu": 1,
  ]));
  set("item_desc", ([
    "【种族】": "\n"
    ZJOBACTS2 + ZJMENUF(2, 2, 5, 12) "人类:zz 1" ZJSEP "妖族:zz 2" ZJSEP "巫族:zz 3" ZJSEP "魔族:zz 4\n",
    "【男女】": "\n"
    ZJOBACTS2 + ZJMENUF(2, 2, 5, 12) "男性:xuan 1" ZJSEP "女性:xuan 2\n",
    "【性格】": "4选1\n"
    ZJOBACTS2 + ZJMENUF(
      2,
      2,
      5,
      12
    ) "光明磊落:choose 1" ZJSEP "狡黠多变:choose 2" ZJSEP "心狠手辣:choose 3" ZJSEP "阴险奸诈:choose 4\n",
    "【洗点】": "投胎之前可以先洗一下属性点，直到自己满意：\n" ZJOBACTS "指定分配洗点:washto\n",
  ]));

  setup();
}

void init() {
  add_action("do_choose", "choose");
  add_action("do_xuan", "xuan");
  add_action("do_washto", "washto");
  add_action("do_zz", "zz");
}

int do_zz(string arg) {
  object me;
  int n;

  if (!objectp(me = this_player()) ||
    !userp(me))
    return 1;

  if (!arg || arg == "")
    n = 1;
  else
    sscanf(arg, "%d", n);

  if (n < 1 || n > 4) {
    write("您只能选择(choose)系统所提供的种族：\n"
      HIC "1" NOR ".人类  "
      HIC "2" NOR ".妖族  "
      HIC "3" NOR ".巫族  "
      HIC "4" NOR ".魔族 ("
      HIC "zz 1" NOR "-" HIC "4" NOR ")\n");
    return 1;
  }

  switch (n) {
    case 1:
      set("race", "人类", me);
      break;
    case 2:
      set("race", "妖族", me);
      break;
    case 3:
      set("race", "巫族", me);
      break;
    case 4:
      set("race", "魔族", me);
      break;
  }

  write(HIC "你选择了" NOR + HIM + query("race", me) + NOR + HIC "的种族，接下来你可以选性别了。\n" NOR, me);
  return 1;
}

int do_xuan(string arg) {
  object me;
  int n;

  if (!objectp(me = this_player()) ||
    !userp(me))
    return 1;

  if (query(
    "race",
    me
  ) != "人类" && query(
    "race",
    me
  ) != "妖族" && query("race", me) != "巫族" && query("race", me) != "魔族") {
    write(HIC "你还是先确定好你的角色种族吧。\n" NOR, me);
    return 1;
  }

  if (!arg || arg == "")
    n = 1;
  else
    sscanf(arg, "%d", n);

  if (n < 1 || n > 2) {
    write("您只能选择(choose)系统所提供的这2种性别：\n"
      HIC "1" NOR ".男性  "
      HIC "2" NOR ".女性 ("
      HIC "xuan 1" NOR "-" HIC "2" NOR ")\n");
    return 1;
  }

  switch (n) {
    case 1:
      set("gender", "男性", me);
      break;
    case 2:
      set("gender", "女性", me);
      break;
  }

  write(HIC "你选择了" NOR + HIM + query("gender", me) + NOR + HIC "的性别，接下来你可以选性格了。\n" NOR, me);
  return 1;
}
int do_choose(string arg) {
  object me;
  int n;

  if (!objectp(me = this_player()) ||
    !userp(me))
    return 1;

  if (query("gender", me) != "男性" && query("gender", me) != "女性") {
    write(HIC "你还是先确定好你的角色性别吧。\n" NOR, me);
    return 1;
  }

  if (!arg || arg == "")
    n = 1;
  else
    sscanf(arg, "%d", n);

  if (n < 1 || n > 4) {
    write("您只能选择(choose)系统所提供的这四种角色性格：\n"
      HIC "1" NOR ".光明磊落  "
      HIC "2" NOR ".狡黠多变  "
      HIC "3" NOR ".心狠手辣  "
      HIC "4" NOR ".阴险奸诈 ("
      HIC "choose 1" NOR "-" HIC "4" NOR ")\n");
    return 1;
  }

  switch (n) {
    case 1:
      set("character", "光明磊落", me);
      break;
    case 2:
      set("character", "狡黠多变", me);
      break;
    case 3:
      set("character", "心狠手辣", me);
      break;
    case 4:
      set("character", "阴险奸诈", me);
      break;
  }

  write(
    HIC "你选择了" NOR + HIM + query("character", me) + NOR + HIC "的性格，接下来你可以" HIR "洗点" HIC "了。\n" NOR,
    me
  );
  return 1;
}

int do_washto(string arg) {
  int tmpstr, tmpint, tmpcon, tmpdex, dower;
  object me, cloth, shoe;
  mapping my;

  if (!objectp(me = this_player()) ||
    !userp(me))
    return 1;

  if (query("gender", me) != "男性" && query("gender", me) != "女性") {
    write(HIC "你还是先确定好你的角色性别吧。\n" NOR, me);
    return 1;
  }

  if (!query("character", me)) {
    write(HIC "你还是先确定(choose)好你的角色性格再选天赋吧。\n" NOR, me);
    return 1;
  }

  if (!arg || !stringp(arg)) {
    tell_object(me, INPUTTXT("请输入你想分配的方案：$br#"
      "按照臂力、悟性、根骨、身法次序输入4个用空格分开的数，注意每个数不能低于13或大于30，4个数之和必须为80。", "washto $txt#") + "\n");
    return 1;
  }

  if (sscanf(arg, "%d %d %d %d", tmpstr, tmpint, tmpcon, tmpdex) != 4) {
    tell_object(me, INPUTTXT("输入格式不对，请重新输入你想分配的方案：$br#"
      "按照臂力、悟性、根骨、身法次序输入4个用"
      "空格分开的数，注意每个数不能低于13或大于30，4个数之和必须为80。", "washto $txt#") + "\n");
    return 1;
  }

  if (tmpstr < 13 || tmpint < 13 || tmpcon < 13 || tmpdex < 13 || tmpstr > 30 || tmpint > 30 || tmpcon > 30 || tmpdex > 30 || (tmpstr + tmpint + tmpcon + tmpdex) != 80) {
    tell_object(me, INPUTTXT("输入格式不对，请重新输入你想分配的方案：$br#"
      "按照臂力、悟性、根骨、身法次序输入4个用"
      "空格分开的数，注意每个数不能低于13或大于30，4个数之和必须为80。", "washto $txt#") + "\n");
    return 1;
  }
  dower = 80 - (tmpstr + tmpint + tmpcon + tmpdex);

  write(HIC "你跳入忘忧池，顿时被一股激流卷了进去。\n" NOR, me);
  my = me->query_entire_dbase();

  my["str"] = tmpstr;
  my["int"] = tmpint;
  my["con"] = tmpcon;
  my["dex"] = tmpdex;
  my["kar"] = 30;
  my["per"] = 10 + random(21);
  if (dower > 0)
    my["dow"] = dower;
  set_temp("washed", 1, me);

  set("startroom", "/d/newbie/shijiezhishu", me);
  set("born", "古村", me);
  set("born_family", "没有", me);
  // 选择特殊技能
  UPDATE_D->born_player(me);

  me->move("/d/newbie/shijiezhishu");
  set("mud_age", 0, me);
  set("age", 11, me);
  me->save();
  message_vision("$N揉揉眼睛，迷惘的望着这个陌生的世界。\n", me);
  tell_object(me, HIY "新手导师：查看本人所在地的地图指令map，查看所有地图指令为map map\n" NOR);
  return 1;
}
