#include <room.h>
inherit ROOM;

void create() {
  set("short", "南贤办事处");
  set("long", @LONG
因为人太多的原因,南贤特意找天神开了一个分站,欠了一屁股债.
LONG);
  set("no_fight", 1);
  set("no_steal", 1);
  set("no_sleep_room", 1);

  set("valid_startroom", 1);
  set("objects", ([
    //__DIR__"obj/box" : 1,
  ]));
  set("objects", ([
    "/d/city/npc/nanxian1": 1,
  ]));

  set("exits", ([
    "east": __DIR__ "wumiao",
    //"out" : __DIR__"/d/ailao/ailao",
    //"up"   : __DIR__"wumiao2",
    //"northwest": "/d/wizard/guest_room",     
  ]));
  //create_door("northwest", "竹门", "southeast", DOOR_CLOSED);
  set("coor/x", -10);
  set("coor/y", 20);
  set("coor/z", 0);
  //setup();

  //("/adm/npc/nanxian")->come_here();
}

int valid_leave(object me, string dir) {
  if (dir == "northwest" && !playerp(me) && !me->is_chatter())
    return 0;

  return ::valid_leave(me, dir);
}
