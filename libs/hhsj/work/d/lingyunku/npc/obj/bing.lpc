// jiuyang.c

inherit BOOK;
inherit F_UNIQUE;

void create() {
  set_name("「冰心诀」", ({ "bingxinjue", "bingxinjue", "bingxinjue" }));
  set_weight(500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "本");
    set("long",
      "这是聂家祖传内功，冰心诀。\n",
    );
    set("value", 1);
    set("no_sell", 1);
    set("material", "paper");
    set("skill", ([
      "name": "bingxinjue",
      //"family_name" : "明教",
      "exp_required": 666666,
      "jing_cost": 70,
      "difficulty": 25,
      "max_skill": 180,
      // "min_skill"   :  30,
    ]));
  }
}

int query_autoload() { return 1; }
