// Room: /xiakedao/shidong2.c

inherit ROOM;

#include <ansi.h>

string look_bi();

void create() {
  set("short", "小石洞");
  set("long", @LONG
这是一个石洞，四周都被烧得通红只有一小块地方奇凉无比你忍不住靠了上去
LONG);
  set("exits", ([
    "east": __DIR__ "dong9",
    "west": __FILE__,
    "south": __FILE__,
    //"north" : __DIR__"yingbin",
  ]));
  set("objects", ([
    CLASS_D("tianxiahui") + "/niefeng": 1,


  ]));

  set("item_desc", ([
    "bi": (: look_bi :),
  ]));
  set("coor/x", -3080);
  set("coor/y", -22090);
  set("coor/z", 0);
  setup();
}

void init() {
  add_action("do_think", "think");
}

string look_bi() {
  object me = this_player();
  string msg;
  msg = HIW "\n你走到石壁前，仔细观看石壁上的内容，便忍不住地拿刀挥舞起来(think),心若冰清,天塌不惊...\n" NOR;

  return msg;
}

int do_think(string arg) {
  object here, me = this_player();
  int add;

  if (!here = find_object(__DIR__ "shidong"))
    here = load_object(__DIR__ "shidong");

  if (query("special_skill/clever", me))
    add = me->query_int() / 4;
  else
    add = me->query_int() / 10;

  if (!living(me) || arg != "bi")
    return notify_fail("你要参悟什么？\n");

  if (me->is_busy() || me->is_fighting())
    return notify_fail("你现在正忙着呢。\n");

  /*if( me->query_skill("literate",1) || query("learned_literate", me) )
                return notify_fail("你发现石壁上的武功深奥之极，一时难以体会！\n");*/

  if (query("int", me) < 27)
    return notify_fail("你若有所悟，然而总是有点不明白。\n");

  if (query("dex", me) < 27)
    return notify_fail("你研究了半天，只觉招式始终无法随意施展。\n");

  if ((int)me->query_skill("blade", 1) < 200)
    return notify_fail("你的基本刀法火候不够，无法领悟石壁"
      "上的武功。\n");

  if (query("max_neili", me) < 5000)
    return notify_fail("你的内力修为不足，无法学习石壁上的武功。\n");

  if (query("jing", me) < 85)
    return notify_fail("你现在精神不济，过于疲倦，还是休息"
      "一会吧。\n");

  if ((int)me->query_skill("aohanliujue", 1) >= 180)
    return notify_fail("你觉得石壁上记载的武功对你来说太浅了，结果你"
      "什么也没学到。\n");

  me->receive_damage("jing", 75);

  if (me->can_improve_skill("aohanliujue"))
    me->improve_skill("aohanliujue", add);

  me->start_busy(random(1));
  message_vision(HIY "\n$N" HIY "聚精会神的参详墙上所记载的武功，"
    "似有所悟。\n" NOR, me);
  write(HIC "你对「傲寒六诀」有了新的领悟。\n" NOR);
  return 1;
}
