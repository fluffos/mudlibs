// This program is a part of NITAN MudLIB

#include <ansi.h>
inherit ROOM;

int do_suicide1(string arg);
int do_suicide2(string arg);
void create() {
  set("short", "乐山大佛");
  set("long", @LONG
乐山大佛当水淹佛膝的时候传说中的凌云窟会显现(jump lyk),
LONG
  );
  set("coor/x", 2000);
  set("coor/y", -210);
  set("coor/z", 0);
  set("no_magic", 1);
  set("no_spells", 1);
  set("no_fight", 1);
  set("no_get_from", 1);
  setup();
}

void init() {
  add_action("do_suicide2", ({ "jump lyk", "jump" }));
}

int do_suicide2(string arg) {
  object me = this_player();



  tell_object(me, HIW "你飞身一跃,便进了凌云窟内！\n\n" NOR);

  me->unconcious();
  me->move("/d/lingyunku/dong1");
  me->revive();

  //delete_temp("mojiao/suicide", me);
  return 1;
}
