#include <room.h>
#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "荒山野地");
  set("long", @LONG
天空黑乎乎一片朵朵黑云聚集在一起,你掐指一算,看来这就是自己的劫难了
LONG);
  set("outdoors", "dj");
  set("exits", ([
    //"east" :  __DIR__,
    "west": __DIR__ "dj4",
    //"south" : __DIR__,
    //"north" : __DIR__,
  ]));
}

int valid_leave(object me, string dir) {
  int total_steps;

  if (me->query("heti") == "合体" ||
    me->query_skill("qimen-wuxing") >= 1500000) {
    total_steps = 1;
  } else {
    me->receive_damage("qi", 150000);
    me->receive_wound("qi", 150000);
    message_vision(HIR "突然天空降下一道水桶粗的闪电"
      "射向$N！" NOR "\n", me);

    total_steps = 30;
  }

  /*if (dir == "north")
	    	me->add_temp("dj/steps",1);

	if (dir == "south")
	    	me->add_temp("dj/steps",-1);

	if (me->query_temp("dj/steps") == total_steps)
	{
     	    	me->move(__DIR__"tao_in");
	    	me->delete_temp("dj/steps");
	    	write("你走了半天，终于走出了桃花迷阵。\n");
	   	return -1;
	}  

	if (me->query_temp("dj/steps") == - total_steps)
	{  
		me->move(__DIR__"tao_out");
	    	me->delete_temp("dj/steps");
	    	write("你走了半天，终于走出了桃花迷阵。\n");
		return -1;
     	}*/

  return ::valid_leave(me, dir);
}
