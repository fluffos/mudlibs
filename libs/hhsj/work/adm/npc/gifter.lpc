		addn("gongde", 8888, me);
		addn("yuanbao", 666, me);
        ob = new("/clone/money/lm");
        ob->move(me, 1);
		ob = new("/clone/honghuang");
        ob->move(me, 1);
        ob = new("/clone/vip01/wuji-water");
        ob->move(me, 1);
