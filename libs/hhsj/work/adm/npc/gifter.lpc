        set("autoload", 1, ob);
        set("setdbase", 1, ob);
        set("gifter/20186177", 1, me);
        return 1;
}
mixed ask_gift5()
{
        object me = this_player();
        if( query("gifter/2009070111", me) )
                return "你已经更换过容貌，不要太贪心。:)";

        set("per", 30, me);
        set("kar", 30, me);
        set("gifter/2009070111", 1, me);
        tell_object(me, HIY "\n你更换了容貌，祝你玩得愉快！\n" NOR);
        return 1;
}

mixed ask_gift6()
{
        object me = this_player();
        if( query("gifter/20090701", me) )
                return "你已经领过新人福利了，不要太贪心。:)";

        addn("max_neili", 100000, me);
        addn("max_jingli", 100000, me);
        set("gifter/20090701", 1, me);
        tell_object(me, HIY "\n你领取了新人福利，祝你玩得愉快！\n" NOR);
        return 1;
}

mixed ask_gift7()
{
        //int td;
        object ob;
        object me = this_player();

        //td = time() / 86400;
		if( query("cz", me) <  20 ){
                tell_object(me,CYN + query("name") + CYN + "说道：你冲值点不足20点,不能领取\n"+ NOR); 
                return 1;
        }      

        if( query("gifter/201890000", me) )
                return "你已经领过礼物了。";

        tell_object(me, HIY "\n你领取了vip积分点(" HIM "40200" NOR + HIY ")！\n" NOR);

       addn("vip/score", 40200, me);
        set("gifter/201890000", 1, me);
        return 1;
}

