int valid_enable(string usage) { return usage == "unarmed" || usage == "dodge"; }

int valid_learn(object me) {
  if (query("str", me) < 38)
    return notify_fail("你先天臂力不足，无法修炼风神腿。\n");

  if (query("con", me) < 38)
    return notify_fail("你先天根古不足，无法修炼风神腿。\n");

  /*if( query("bingxinjue", me)<300 )
                return notify_fail("你冰心决功力不够，无法修炼傲寒六诀。\n");*/

  if (query("max_neili", me) < 20000)
    return notify_fail("你的内力修为不足。\n");

  if ((int)me->query_skill("force", 1) < 500)
    return notify_fail("你的内功火候太浅。\n");

  if ((int)me->query_skill("martial-cognize", 1) < 500)
    return notify_fail("你的武学修养不足。\n");

  if ((int)me->query_skill("unarmed", 1) < (int)me->query_skill("fengshentui", 1))
    return notify_fail("你的基本拳脚火候不够，无法领会更高深的风神腿。\n");

  if ((int)me->query_skill("bingxinjue", 1) < (int)me->query_skill("fengshentui", 1))
    return notify_fail("你的冰心决水平有限，无法领会更高深的风神腿。\n");

  if ((int)me->query_skill("dodge", 1) < (int)me->query_skill("fengshentui", 1))
    return notify_fail("你的基本招架水平有限，无法领会更高深的风神腿。\n");

  if ((int)me->query_skill("force", 1) < (int)me->query_skill("fengshentui", 1))
    return notify_fail("你的基本内功水平有限，无法领会更高深的风神腿。\n");

  /*weapon=query_temp("weapon", me);
        if (me->query_skill("fengshentui", 1) < 1000 &&
              (!objectp(weapon) || query("id", weapon) != "xueyinkuangdao") )
                return notify_fail("你的傲寒六诀大成之前必须有雪饮狂刀配合才能学习。\n");*/
  return 1;
}

string query_skill_name(int level) {
  int i;
  for (i = sizeof(action) - 1; i >= 0; i--)
    if (level >= action[i]["lvl"])
      return action[i]["skill_name"];
}
mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

/*string query_dodge_msg(string limb)
{
        return dodge_msg[random(sizeof(dodge_msg))];
}*/

int double_attack() {
  return 1;
}

int practice_skill(object me) {
  return notify_fail("风神腿，无法简单的通过练习进步。\n");
}

mixed hit_ob(object me, object victim, int damage_bonus) {
  string *desc;
  object weapon;

  weapon = query_temp("weapon", me);

  if (!objectp(weapon)) return damage_bonus;

  desc = ({
    HIY "$N" HIY "纵身而起，无数身影随风而来$n" HIY "。\n" NOR,
    HIC "$N" HIC "轻旋身影,风云交际\n" NOR,
    HIR "$N" HIR "瞬间化作一团清风,围绕$n。\n" NOR,
  });

  if (me->is_busy()
    || random(4) >= 1
    || !living(victim)
    || damage_bonus < 150
    || query("neili", me) < 500
    || me->query_skill("fengshentui", 1) < 500)
    return 0;

  // 追加特效
  victim->receive_wound("qi", damage_bonus / 4, me);

  if (random(6) == 1) victim->start_busy(3 + random(5));

  return desc[random(sizeof(desc))];
}

mixed valid_damage(object ob, object me, int damage, object weapon) {
  mapping result;
  int ap, dp, cost;

  if ((int)me->query_skill("fengshentui", 1) < 350
    || me->query_skill_mapped("dodge") != "fengshentui"
    || query("neili", me) < 200
    || !living(me) || random(5) > 2)
    return;

  cost = damage / 2;
  if (cost > 100) cost = 100;

  ap = ob->query_skill("force", 1) * 4 + ob->query_skill("martial-cognize", 1);
  dp = me->query_skill("fengshentui", 1) * 5 + me->query_skill("martial-cognize", 1) + 100;

  if (dp / 2 + random(dp / 2) >= ap) {
    addn("neili", -cost, me);
    result = ([ "damage": -damage ]);

    switch (random(3)) {
      case 0:
        result += ([ "msg": HIW "$n" HIW "化作一道残影,快若流星。$N" HIW "目瞪口呆，一时难以找出其间破绽。\n" NOR ]);
        break;
      case 1:
        result += ([ "msg": HIW "只见$n" HIW "无影随形,随风而动。$N" HIW "眼花缭乱，无从攻击。\n" NOR ]);
        break;
      default:
        result += ([ "msg": HIG HIW "$n" HIW "化作一道清风,瞬间狂风大作把$N" HIW "团团围住，哪里还有机会攻击。\n" NOR ]);
        break;
    }
    return result;
  }
}

string perform_action_file(string action) {
  return __DIR__ "fengshentui/" + action;
}

int difficult_level() {
  return 30000;
}
