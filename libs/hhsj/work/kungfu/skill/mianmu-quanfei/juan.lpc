#include <ansi.h>
#include <combat.h>

#define JUAN "「" HIY "踏邪绝步" NOR "」"
string query_name() { return "踏邪"ZJBR"绝步"; }
inherit F_SSERVER;

int perform(object me, object target)
{
        object weapon;
        int damage;
        string msg;

        if (! target) target = offensive_target(me);

       if (! target || ! me->is_fighting(target))
                return notify_fail(JUAN "只能对战斗中的对手使用。\n");

        if( me->query_temp("weapon") || me->query_temp("secondary_weapon") )
                return notify_fail(JUAN "只能空手施展。\n");

        if ((int)me->query_skill("mianmu-quanfei", 1) < 120)
                return notify_fail("你的面目全非脚不够娴熟，难以施展" JUAN "。\n");

        if ((int)me->query_skill("force") < 120)
                return notify_fail("你的内功修为不够，难以施展" JUAN "。\n");


        if (me->query_skill_mapped("unarmed") != "mianmu-quanfei")
                return notify_fail("你没有激发面目全非脚，难以施展" JUAN "。\n");

        if (me->query_skill_prepared("unarmed") != "mianmu-quanfei")
                return notify_fail("你现在没有准备使用面目全非脚，难以施展" JUAN "。\n");

        if (! living(target))
                return notify_fail("对方都已经这样了，用不着这么费力吧？\n");

        msg = HIY "只见$N" HIY "身形疾转，双脚聚力齐发，一式「踏邪绝步」携"
              "着隐隐风雷之势踹向$n" HIY "！\n" NOR;

        if (random(me->query_skill("unarmed")) > target->query_skill("dodge") / 2)
        {
                me->start_busy(2);
                damage = me->query_skill("unarmed");
                damage = damage / 2 + random(damage);
                me->add("neili", -250);
				target->add("per",-random(5));
				msg += COMBAT_D->do_damage(me, target, UNARMED_ATTACK, damage, 55,
                                           HIR "结果$n" HIR "闪避不及，被$P"
										   HIR "双脚踢中脸部，凄然一声惨嚎，牙齿掉光并肿了半边脸,已面目全非。。\n" NOR);
        } else
        {
                me->start_busy(3);
                me->add("neili", -80);
                msg += CYN "$p" CYN "见$P" CYN "脚势汹涌，不敢硬"
                       "作抵挡，当即斜斜一跃避开。\n" NOR;
        }
        message_combatd(msg, me, target);

        return 1;
}