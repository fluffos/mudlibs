// transfer.c 传功
// Created by Xuanyuan 2002.7.28

#include <ansi.h>
inherit F_DBASE;
inherit F_SSERVER;

int transfer(object me, object target);
void remove_pending(object me, object target);

// 暂时按各种内功疗伤功能的强弱能力来衡量传功过程的快慢。
mapping eff_heal = ([
	"jiuyang-shengong"	: 9,	// 九阳神功在疗伤方面的效果无可置疑。
	"hunyuan-yiqi"		: 8,	// 鉴於易筋经以及九阳神功在疗伤方面的效果。
	"zixia-gong"		: 8,
// 紫霞神功及混元功在自疗方面没有什么提及，但是有鉴於其疗人的效果，以及岳不群曾经想让令狐冲
// 自习紫霞神功来治疗内伤，可见於自疗方面的效果，或许可以与易筋经相媲美。就算是有所不及，考
// 虑到当今紫霞神功没有什么特别的exert，也应当让紫霞神功在治疗方面的效果相对於其他内功更好。
	"taiji-shengong"	: 7,
	"xiantian-gong"		: 7,	// 书中有相当篇幅提到武当九阳功与全真玄门内功的疗伤。
	"yunu-xinjing"		: 7,	// 玉女心经应和玄门内功的疗伤效果左右。
	"kurong-changong"	: 6,	// 大理内功在疗人方面的效果很好，可是在自疗方面却没
								// 有什么特别之处。
	"linji-zhuang"		: 6,	// 峨嵋内功在疗伤方面没有什么特别描述，不过因其是九
								// 阳一系。
	"douzhuan-xingyi"	: 6,	// 斗转星移应有护心脉之效。
	"taixuan-gong"		: 5,
	"bitao-xuangong"	: 5,
	"bahuang-gong"		: 5,
	"yunu-xinjing"		: 5,
	"xiaowuxiang"		: 5,
	"huntian-qigong"	: 4,	// 混天功、蛤蟆功、龙象般若功走的都是刚猛一路的内功，
	"hamagong"			: 4,	// 因此在疗伤方面会相对弱些。
	"longxiang-banruo"	: 4,
	"shenghuo-xuanming"	: 5,	// 明教内功也属刚猛内功。
	"beiming-shengong"	: 3,	// 北冥神功吸人内力，体内真气相冲会影响疗伤时的效果。
	"huagong-dafa"		: 2,	// 化功大法以毒练功，在疗伤方面效果应该最为不好。
	"dulong-dafa"		: 2,
	"wudu-xinfa"		: 2,	// 聚毒练气，疗伤效果差。
	"hongming-xuangong"	: 1,
	"ding-force"		: 1,	// 以上三种内功书中未有提及，被列为不可考。
]);

int exert(object me, object target)
{
    int force, trans;

	if( !target || target==me || !living(target) )
		return notify_fail("你想给谁传功？\n");

	if( me->is_fighting() || me->is_busy() )
		return notify_fail("你正忙着呢！\n");

	if( target->is_fighting() || target->is_busy() )
		return notify_fail(target->name() + "正忙着呢！\n");

	if( me->query("to_transfer"))
		return notify_fail("人的一生只能给别人传一次功！\n");

	if( target->query("be_transfer"))
		return notify_fail(target->name() + "已经接受过一次传功，不能再次接受传功！\n");

	if( target->query("age") > 20)
		return notify_fail(target->name() + "武功已经成型，不能接受传功！\n");

	if( me->query_skill("force", 1) < 150 )
		return notify_fail("你的内功修为还没到能给别人传送功力的程度！\n");

	if( me->query_skill_mapped("force") != target->query_skill_mapped("force") )
		return notify_fail(target->name() + "所用特殊内功和你所用特殊内功气路相悖！\n");

	if( (int)me->query("max_neili") <= (int)target->query("max_neili") )
		return notify_fail("你的内力不如对方深厚，功力传不过去。\n");

    if( (int)me->query("neili") < (int)me->query("max_neili") )
		return notify_fail("你的真气不足。\n");

    if( (int)me->query("jingli") < (int)me->query("max_jingli") )
		return notify_fail("你的精力不足。\n");

	write(HIY"你一掌拍在" + target->name() + HIY"背心，顺势运气将体内真气缓缓地传送过去。\n"NOR);
	message("vision", me->name() +"一掌拍在，"+target->name()+"背心，顺势运气将体内真气缓缓地传送过去。\n"NOR,environment(me), ({me,target}));
	tell_object(target, HIR "你觉得一股热气从"+me->name()+HIR"的手掌中缓缓地传了过来，接着身体愈来愈热，霎时间头昏脑胀，身体如要炸将开来一般。\n" NOR);

	me->set_temp("apply/short", ({ me->name() +"满身满脸大汗淋漓，不住滴向身上，而面颊、头颈、发根各处，仍是有汗水源源渗出。"}));
	target->set_temp("apply/short", ({ target->name() +"坐在地下，满面赤红，神情极为痛苦。"}));

	me->set_temp("pending/transfer", 1);
	me->set_temp("pending/transfer_target", 1);
	me->set("jiali", 0);

	target->set("jiali", 0);
	target->set_temp("pending/transfer_hostage", me->query("id"));
	target->set_temp("pending/transfer", 1);

	me->start_busy((: transfer :));
	return 1;
}

int transfer(object me, object target)
{
	int effect, lvl, con, max, eff, i;
	string force_skill;
	object *inv;


	inv=all_inventory(environment(me));
	for (i=0;i<sizeof(inv);i++){
		if (inv[i]->query_temp("pending/transfer_hostage") == me->query("id") && living(inv[i]))
			target = inv[i];
        }

	if( !target ) 
	tell_object(me, "BUG! no target. report to Xuanyuan.\n");

	if( !living(me) || me->is_ghost() || !(force_skill = me->query_skill_mapped("force")) )
	{
		remove_pending(me, target);
		return 0;
	}

	if( me->query("jing") < 1 || me->query("jingli") < 1 )
	{
		remove_pending(me, target);
		me->unconcious();
		return 0;
	}
	else if( (int)me->query("max_neili") <= 1 )
	{
		tell_object(me, HIY"你催动真气，将体内最后一丝内力传了过去，累得大汉淋漓。\n"NOR);
		tell_object(target, HIY"你只觉得全身轻飘飘地，便如腾云驾雾，气力倍增。\n"NOR);
		message("vision", me->name() +"运功完毕，本来洁白俊美的脸之上，竟布满了一条条纵横交叉的深深皱纹。\n"NOR,	environment(me), ({me,target}));
		remove_pending(me, target);
        	return 0;
	}
	else if( target->query_temp("pending/transfer") )
	{
		target->start_busy(2);
	}

	lvl = me->query_skill("force");	// my enable force level.
	max = me->query("max_neili");	// my max neili.
	con = target->query("con");		// my original constitution.
	eff = eff_heal[force_skill];	// my force's effect on heal.
	if( !eff ) eff = 1;

	effect = lvl * max/10 * eff / (2*lvl + lvl*con*2/30) / 10;

	con = target->query_con();		// use apply constitution instead of original here.
	effect = (effect+random(effect))/2 + (con+random(con))/4;
	effect = effect * ((int)target->query("neili")*100 / (int)target->query("max_neili")) / 100;

	if( wizardp(me) ) tell_object(me, "每次传输"+chinese_number(effect)+"点最大内力。\n");
	target->add("max_neili", effect/4);
	me->add("max_neili", -50);
	me->add("neili", -50);
	return 1; 
}

void remove_pending(object me, object target)
{
	int i, old_exp;
	mapping skill_status, skill_target, skill_learned, pmap;
	string *sname, *sk;
	object *inv;

	inv=all_inventory(environment(me));
	for (i=0;i<sizeof(inv);i++){
		if (inv[i]->query_temp("pending/transfer_hostage") == me->query("id") && living(inv[i]))
			target = inv[i];
        }

	if( !target ) 
	tell_object(me, "BUG! no target. report to Xuanyuan.\n");

	// transfer random gift
	if(me->query_str()>70 )
		target->add("str",1+random(me->query_str()-70)/10);
	if(me->query_int()>70 )
		target->add("int",1+random(me->query_str()-70)/10);
	if(me->query_con()>70 )
		target->add("con",1+random(me->query_str()-70)/10);
	if(me->query_dex()>70 )
		target->add("dex",1+random(me->query_str()-70)/10);

	// transfer skills
	if ( mapp(skill_status = me->query_skills()) && mapp(skill_target = target->query_skills())) {
		sname  = keys(skill_status);
		for(i=0; i<sizeof(skill_status); i++) {
        	if(SKILL_D(sname[i])->type() != "knowledge"){
				if( !mapp(skill_learned) )	
					skill_learned = ([sname[i] : 0]);
				else	skill_learned += ([sname[i] : 0]);

				if(target->query_skill(sname[i]))
						target->set_skill(sname[i], skill_target[sname[i]] + skill_status[sname[i]]/2);
				else	target->set_skill(sname[i], skill_status[sname[i]]/2);
                }
		}
	}

	// transfer combat_exp
	if (me->query("combat_exp")*2/5 > 2000000)
		target->add("combat_exp", 2000000);
	else target->add("combat_exp", me->query("combat_exp")*2/5);

	old_exp = me->query("combat_exp")*3/5;
	me->set("combat_exp", old_exp/10);

	// transfer neili
	if (target->query("max_neili") > (int)target->query_skill("force") * (int)target->query("con") * 4 / 3)
		target->set("max_neili",target->query_skill("force") * (int)target->query("con") * 4 / 3);
	me->set("neili", 0);


	// me disable and abandon all skills
	pmap = me->query_skill_prepare();
	if (!pmap) pmap = ([]);

	if( mapp(pmap) && sizeof(pmap) > 0 )
	{
		sk = keys(pmap);
		for (i=0; i<sizeof(sk); i++)
		{
			me->prepare_skill(sk[i]);
		}
	}
	
	sk = keys(me->query_skills());
	for(i = 0; i<sizeof(sk); i++)
	{
        if(SKILL_D(sname[i])->type() != "knowledge"){
		me->map_skill(sk[i]);
		map_delete(me->query_skills(), sk[i]);
		}
	}
	me->reset_action();
	me->set("to_transfer",1);
	target->set("be_transfer",1);

	me->delete_temp("pending/transfer_target");
	me->delete_temp("pending/transfer");
	me->delete_temp("apply/short");
	target->delete_temp("pending/transfer_hostage");
	target->delete_temp("pending/transfer");
	target->delete_temp("apply/short");
}