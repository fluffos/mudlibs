inherit SKILL;

mapping *action = ({
([      "action": "只见$N拉开架式，一招「面目全非脚」使出，底下却飞踢$n的$l",
        "force" : 50,
        "attack": 40,
        "dodge" : 49,
        "parry" : 13,
        "damage": 20,
        "lvl"   : 100,
        "skill_name" : "面目全非脚",
        "damage_type":  "瘀伤"
]),
([      "action": "$N往后一纵，就势使了个「面目全非脚」，右腿扫向$n的$l",
        "force" : 100,
        "attack": 55,
        "dodge" : 61,
        "parry" : 21,
        "damage": 35,
        "lvl"   : 180,
        "skill_name" : "面目全非脚",
        "damage_type":  "内伤"
]),
});

int valid_enable(string usage)
{
        return usage == "unarmed" || usage == "parry";
}

int valid_learn(object me)
{
        if( me->query_temp("weapon") || me->query_temp("secondary_weapon") )
                return notify_fail("练面目全非脚不能拿武器。\n");

        if( me->query("max_neili")<200 )
                return notify_fail("你的内力不够，无法练习面目全非脚。\n");

        if ((int)me->query_skill("unarmed", 1) < 40)
                return notify_fail("你的基本拳脚火候太浅。\n");

        if ((int)me->query_skill("unarmed", 1) < (int)me->query_skill("mianmu-quanfei", 1))
                return notify_fail("你的基本拳脚火候有限，无法领会更高深的面目全非脚。\n");

        return 1;
}

string query_skill_name(int level)
{
        int i;
        for (i = sizeof(action)-1; i >= 0; i--)
                if (level >= action[i]["lvl"])
                        return action[i]["skill_name"];
}

mapping query_action(object me, object weapon)
{
        int i, level;
        level = (int)me->query_skill("mianmu-quanfei", 1);
        for (i = sizeof(action); i > 0; i--)
                if (level > action[i-1]["lvl"])
                        return action[NewRandom(i, 20, level / 5)];
}

int practice_skill(object me)
{
        if( me->query("qi")<70 )
                return notify_fail("你现在手足酸软，休息一下再练吧。\n");

        if( me->query("neili")<60 )
                return notify_fail("你的内力不够练习面目全非脚。\n");

        me->receive_damage("qi", 65);
        me->add("neili", -40);

        return 1;
}

string perform_action_file(string action)
{
        return __DIR__"mianmu-quanfei/" + action;
}