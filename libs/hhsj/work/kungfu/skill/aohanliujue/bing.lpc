#include <ansi.h>
#include <combat.h>

string name() { return HIM "冷刃冰心" NOR; }

inherit F_SSERVER;

int perform(object me, object target) {
  object weapon;
  int damage;
  string msg;
  int ap, dp, md, ly;

  if (!target) {
    me->clean_up_enemy();
    target = me->select_opponent();
  }

  if (!target || !me->is_fighting(target))
    return notify_fail(name() + "只能对战斗中的对手使用。\n");

  if (!objectp(weapon = query_temp("weapon", me)) ||
    query("skill_type", weapon) != "blade")
    return notify_fail("你使用的武器不对，难以施展" + name() + "。\n");

  if ((int)me->query_skill("force") < 160)
    return notify_fail("你的内功火候不够，难以施展" + name() + "。\n");

  if ((int)me->query_skill("aohanliujue", 1) < 350)
    return notify_fail("你的傲寒六诀还不到家，难以施展" + name() + "。\n");

  if (me->query_skill_mapped("blade") != "aohanliujue")
    return notify_fail("你没有激发傲寒六诀，难以施展" + name() + "。\n");

  if (query("neili", me) < 200)
    return notify_fail("你的真气不够，难以施展" + name() + "。\n");

  if (!living(target))
    return notify_fail("对方都已经这样了，用不着这么费力吧？\n");

  msg = HBCYN "冷刃冰心：刀冷，人更冷，最冷的，是用刀的心!冷心使出的冷刀，令人心寒，也无可奈何。\n" NOR HIG "只听唰的一声，" + weapon->name() + HIC "出手了！一道淡蓝色的刀气在$N的刀中快速的凝聚 \n"
    HBBLU "转眼间已经如同实质般。啊!$N这一声怒喝间，刀气已经离刀而去，化作湛蓝色的残影飞向$n\n"
    "$n" HBMAG "见这一招飞来面惊失色如同丢了魂一般静静的等待死亡\n"
    +weapon->name() + HIB "上的寒冰之气，使$n身体都仿佛被冰冻一般。\n" NOR;

  ap = attack_power(me, "blade");
  dp = defense_power(target, "dodge");

  md = me->query_skill("aohanliujue", 1);
  ly = target->query_skill("lonely-sword", 1);

  if (ap * 2 / 3 + random(ap) > dp) {
    damage = 0;
    if (me->query_skill("blade") > target->query_skill("force") &&
      query("reborn/times", me) >= query("reborn/times", target) && random(md) > ly) {
      me->start_busy(2);
      addn("neili", -100, me);
      msg += HIR "当$n" HIR "感到$N" HIR "出手时，" + weapon->name() + HIB "早已挥出，化作漫天寒冰刀气，划过两丈的虚空劈向$n。\n"
        "$n" HBRED "只感到周围所有空气全都变成了$N" HBBLU "手中所发出的寒冰刀气，\n"
        HBWHT "只见周围所有的刀气全都消失不见\n"
        HBCYN "突然一道玄冰刀气从$n后面飞射而出，瞬间将$n化作一座冰雕。$N" CYN "收刀静静的看着这座完美的冰雕"
        BCYN "冰雕一点一点地裂开，化为遍地冰屑，一丝血迹都看不到，诡异的可怕。\n" NOR;
      damage = -1;
    } else {
      me->start_busy(2);
      addn("neili", -600, me);
      damage = damage_power(me, "blade");
      damage += query("jiali", me);
      damage *= 3;
      msg += COMBAT_D->do_damage(me, target, WEAPON_ATTACK, damage, 300,
        HIR "结果$p" HIR "闪避不及，只觉得"
        "一股冰寒的刀气掠过全身，$n全身顿时崩裂出红色的冰屑！\n" NOR);
    }
  } else {
    me->start_busy(3);
    addn("neili", -300, me);
    msg += CYN "可是$p" CYN "犹如残影$P"
      CYN "这一招，连衣角都没碰到。\n" NOR;
  }
  message_combatd(msg, me, target);

  if (damage < 0)
    target->die(me);

  return 1;
}
