#include <ansi.h>

inherit F_SSERVER;
string name() { return HIB "剑十八" NOR; }
#define LIAN "「" HIW "剑十八" NOR "」"

int perform(object me, object target) {
  object weapon;
  string msg;
  int i;
  int count;

  if (!target) {
    me->clean_up_enemy();
    target = me->select_opponent();
  }

  /*if( userp(me) && !query("can_perform/shengling/xiong", me) )
                return notify_fail("你所使用的外功中没有这种功能。\n");*/

  if (!target || !me->is_fighting(target))
    return notify_fail(LIAN "只能对战斗中的对手使用。\n");

  if (!objectp(weapon = query_temp("weapon", me)) ||
    query("skill_type", weapon) != "sword")
    return notify_fail("你使用的武器不对！\n");

  if (query("neili", me) < 300000)
    return notify_fail("你的真气不够，无法施展" LIAN "！\n");

  if ((int)me->query_skill("force") < 300)
    return notify_fail("你的内功火候不够，难以施展" LIAN "！\n");

  if ((int)me->query_skill("shengling", 1) < 600)
    return notify_fail("你的圣灵剑法还不到家，无法施展" LIAN "！\n");

  if (me->query_skill_mapped("sword") != "shengling")
    return notify_fail("你没有激发圣灵剑法，无法施展" LIAN "。\n");

  if (!living(target))
    return notify_fail("对方都已经这样了，用不着这么费力吧？\n");

  msg = HIY "$N" HIY "使出「" HIW "剑十八" HIY "」，剑招三三无尽,六六无穷彷坲无穷无尽般 ……\n" NOR;

  message_combatd(msg, me);
  addn("neili", -50000, me);

  count = me->query_skill("sword") / 3;
  addn_temp("apply/damage", count, me);

  for (i = 0; i < 18; i++) {
    if (!me->is_fighting(target))
      break;

    if (random(2) && !target->is_busy())
      target->start_busy(1);

    COMBAT_D->do_attack(me, target, weapon, 0);
  }

  addn_temp("apply/damage", -count, me);
  me->start_busy(2 + random(3));
  return 1;
}
