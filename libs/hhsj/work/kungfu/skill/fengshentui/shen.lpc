#include <ansi.h>
#include <combat.h>

#define XIAN "「" HIR "神风动" NOR "」"

inherit F_SSERVER;

string attack1(object me, object target, int damage);
string attack2(object me, object target, int damage);

int perform(object me, object target) {
  int damage;
  string msg;
  object weapon;
  int ap, dp;

  /*if( userp(me) && !query("can_perform/fengshentui/san", me) )
                return notify_fail("你所使用的外功中没有这种功能。\n");*/

  if (!target) target = offensive_target(me);

  if (!target || !me->is_fighting(target))
    return notify_fail(XIAN "只能在战斗中对对手使用。\n");

  /*if( !objectp(weapon=query_temp("weapon", me)) || 
            query("skill_type", weapon) != "unarmed" )
                return notify_fail("你使用的武器不对！\n");*/

  if ((int)me->query_skill("fengshentui", 1) < 600)
    return notify_fail("你风神腿火候不足，无法施展" XIAN "。\n");

  if ((int)me->query_skill("force", 1) < 800)
    return notify_fail("你基本内功修为不够，无法施展" XIAN "。\n");

  if (query("neili", me) < 3000)
    return notify_fail("你现在真气不够，无法施展" XIAN "！\n");

  if (me->query_skill_mapped("unarmed") != "fengshentui")
    return notify_fail("你没有激发风神腿，无法使用" XIAN "。\n");

  if (!living(target))
    return notify_fail("对方都已经这样了，用不着这么费力吧？\n");

  addn("neili", -3000, me);

  ap = me->query_skill("unarmed") + me->query_skill("force") + me->query_skill(
    "martial-cognize",
    1
  ) + query("str", me);
  dp = target->query_skill("dodge") + target->query_skill("force") + target->query_skill(
    "martial-cognize",
    1
  );

  message_combatd(HIW "\n$N" HIW "观天地,悟神风,动也 ……\n\n", me, target);

  // 第一刀
  msg = HIY "$N" HBRED "以腿生风，再以风引动水火雷电，施展出「风雨江湖」，" HBMAG "$N顺势踢出无数幻影，瞬间狂风骤起，水火雷电齐聚 ……\n" NOR;

  if (ap * 4 / 5 + random(ap) > dp) {
    damage = ap * 2 + random(ap);
    msg += COMBAT_D->do_damage(me, target, WEAPON_ATTACK, damage, 300 + query("str", me),
      HIR "$n" HIR "惊魂未定，竟然不知躲避，被$N"
      HIW "一腿踢过，水火雷电入体，全身五颜六色，内脏受损,$n长叹!吾命休已。\n" NOR);
  } else {
    msg += CYN "$n" CYN "飞身一跃，滚在一边。\n" NOR;
  }

  // 第二刀
  msg += HBYEL "\n$N" "轻喝，「动风云」，引天之风,$N以腿劲引起天上风云之天地力量，如同天地破灭...\n" NOR;

  if (ap * 4 / 5 + random(ap) > dp) {
    damage = ap * 3 + random(ap);
    msg += COMBAT_D->do_damage(me, target, WEAPON_ATTACK, damage, 300 + query("str", me),
      (: attack1, me, target, damage :));
  } else {
    msg += CYN "$n" CYN "发现此招后劲不足，将这招化解。\n" NOR;
  }

  // 第三刀
  msg += HBCYN "『天地同心，劲破神州』→ $N全身极速旋转，接着化为大气成风流化入天地间，将天地间所有威能集中，对$n发动这毁天灭地的一击。。\n" NOR;
  if (ap * 4 / 5 + random(ap) > dp) {
    damage = ap * 4 + random(ap);
    msg += COMBAT_D->do_damage(me, target, WEAPON_ATTACK, damage, 350 + query("str", me),
      (: attack2, me, target, damage :));


  } else {
    msg += CYN "$n" CYN "身影狂闪，小心应对，竟将此招化解与无形。\n" NOR;
  }

  me->start_busy(4 + random(4));
  message_combatd(sort_msg(msg), me, target);
  return 1;
}

string attack1(object me, object target, int damage) {
  string msg;

  msg = HIR "$n" HIR "只觉的犹如天灾人祸降临，逃无可逃，惟有硬接等死。\n" NOR;

  addn("neili", -1 * damage / 2, target);

  return msg;
}

string attack2(object me, object target, int damage) {
  string msg;

  msg = HIR "$n" HIR "早已十魂失了八魄，正吃惊间，眼前一闪，铺天盖地的风火雷电卷席而来。\n" NOR;

  target->receive_wound("jing", damage / 8, me);
  if (random(4) == 1) target->start_busy(5 + random(5));

  return msg;
}
