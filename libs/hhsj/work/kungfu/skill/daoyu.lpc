#include <ansi.h>;
#include <combat.h>

inherit SKILL;

int is_pbsk() { return 1; }

string type() { return "martial"; }
string martialtype() { return "skill"; }

mapping *action = ({
([        "action" : "$N手中$w分化出一个圆圈"HIR"「圆月刀域」"NOR"，手中$w散发出无数弯刀飞向$n的$l。",
        "lvl" : 0,
        "skill_name" : "圆月刀域"
]),
([        "action" : "$N退了两步，手持$w散发出一股血腥的气味，"HIC"「血刀域」"NOR"刺鼻的血腥味直冲$n的$l",
        "lvl" : 10,
        "skill_name"  : "血刀域"
]),
([        "action" : "突然间天慢慢暗了下来，$N向$n劈出一道四十米长的刀气，"HIG"「敖寒刀域」"NOR"，刀气在$n的$l劈下，$n只觉$l呼呼的风声，恍惚间,已然没有知觉。",
        "lvl" : 20,
        "skill_name" : "敖寒刀域"
]),
([        "action" : "$N手中$w递出，血红色的人头出现在天空"HIY"「魔刀域」"NOR"，由下而上$w疾冲$n的$l",
        "lvl" : 30,
        "skill_name" :"魔刀域"
]),
([        "action" : "$N一招"HIW"「幻刀域」"NOR"，身子前倾，忽地连续间，手中$w已然不见只看到影子向$n的$l辟去",
        "lvl" : 40,
        "skill_name" : "幻刀域"
]),
([        "action" : "$N化作无数影子"BLU"「影刀域」"NOR"，影子手持$w一齐冲向$n的$l砍去",
        "lvl" : 50,
        "skill_name" : "影刀域"
]),
([        "action" : "$N左一招"MAG"「刀」"NOR"，右一招"HIM"「域」"NOR"，刀所到,无所不被域覆盖,昏天暗地仿佛世界末日笼罩$n",
        "lvl" : 60,
        "skill_name" : "万剑 归宗"
]),
});

int valid_enable(string usage) { return usage == "blade" || usage == "parry"; }
int valid_learn(object me)
{
        if( query("max_neili", me)<100000 )
                return notify_fail("你的内力不够。\n");
        if( me->query_skill("literate",1 )<600 )
                return notify_fail("你的读书写字不够。\n");
        if( me->query_skill("martial-cognize",1 )<3000 )
                return notify_fail("你的武学修养不够。\n");
        return 1;
}
int practice_skill(object me)
{
        object weapon;

        if( !objectp(weapon=query_temp("weapon", me) )
                 || query("skill_type", weapon) != "blade" )
                return notify_fail("你使用的武器不对。\n");
        if( query("qi", me)<30 || query("neili", me)<10 )
                return notify_fail("你的内力或气不够练刀域。\n");
        me->receive_damage("qi", 30);
        addn("neili", -10, me);
        return 1;
}
string query_skill_name(int level)
{
        int i;
        for(i = sizeof(action); i > 0; i--)
                if(level >= action[i-1]["lvl"])
                        return action[i-1]["skill_name"];
}
mapping query_action(object me, object weapon)
{
/* d_e=dodge_effect p_e=parry_effect f_e=force_effect m_e=damage_effect */
        int d_e1 = 40;
        int d_e2 = 60;
        int p_e1 = 10;
        int p_e2 = 30;
        int f_e1 = 50;
        int f_e2 = 100;
        int m_e1 = 10;
        int m_e2 = 110;
        int i, lvl, seq, ttl = sizeof(action);

        lvl = (int) me->query_skill("daoyu", 1);
        for(i = ttl; i > 0; i--)
                if(lvl > action[i-1]["lvl"])
                {
                        seq = i; /* 获得招数序号上限 */
                        break;
                }
        seq = random(seq);       /* 选择出手招数序号 */
        return ([
                "action"      : action[seq]["action"],
                "dodge"       : d_e1 + (d_e2 - d_e1) * seq / ttl,
                "parry"       : p_e1 + (p_e2 - p_e1) * seq / ttl,
                "force"       : f_e1 + (f_e2 - f_e1) * seq / ttl,
                "damage"      : m_e1 + (m_e2 - m_e1) * seq / ttl,
                "damage_type" : random(2) ? "砍伤" : "割伤",
        ]);
}
int learn_bonus() { return 30; }
int practice_bonus() { return 30; }
int success() { return 20; }
int power_point(object me) { return 1.0; }

string *shi = ({HIG "「弯月」" HIW,HIG "「血影」" HIW,HIG "「九重刀气」" HIW,HIG "「幻域」" HIW,
                                HIG "「影域。」" HIW,HIG "「魔域」" HIW,HIG "「刀-道」" HIW});
string *ship = ({HIW "\n$N持刀沉吟道,"BLK"圆月"HIW"域，霎时无数"BLK"弯刀"HIW"跟随月亮痕迹袭向$n" HIW "。\n" NOR,
                                HIW "\n$N身法陡快，忽念到"HIC"敖寒，突然间双眼发红,刀势宛如不受控制，辟向$n" HIW "。\n" NOR,
                                HIW "\n$N清吟"HIY"魔域，手里刀气犹如黑色的乌云般，将$n" HIW "笼罩。\n" NOR,
                                HIW "\n$N黯然低吟"HIR"刀"HIC"道"HIG"域，猛然挥刀将四周团团围住,犹如一个天地牢笼让人跳不出去并发出万道刀光徘徊。\n" NOR});

mixed hit_ob(object me, object victim, int damage_bonus, int factor)
{
        mixed result;
        string msg;
        int lvl , flagli = 0;
        int idx,idx2,ap,dp,damage,damage2;
        int num = 200;
        object weapon=query_temp("weapon", me);
        object *obs;

        if( ( userp(me) && query("daoguang", me)<1 ) || 
                me->query_skill("literate",1 )<600 ||
                me->query_skill("martial-cognize",1 )<200
                )
               return 0;

             if( !objectp(weapon) || query("skill_type", weapon) != "blade"
                 || me->query_skill_mapped("blade") != "daoyu")
                         return 0;
        if (query("id", me)=="li bai")
                flagli = 1;
                if (!flagli) {        
                if (query_temp("tsj_cd_time", me) >= time())
                        return 0;
                set_temp("tsj_cd_time", time() + 2, me);
        }

        ap=attack_power(me,"blade")+me->query_int()*50+me->query_skill("martial-cognize", 1);
        ap+=ap*(query("daoguang", me)/50);
        damage = damage_power(me, "blade");
        damage += damage * query("jiali", me) / 1000;
        damage += damage * (me->query_skill("literate",1 )) / 3500;
        damage += damage * (me->query_skill("martial-cognize",1 )) / 2500;
        damage +=damage*(query("daoguang", me)/25);
        
        lvl = me->query_skill("daoyu", 1) + me->query_skill("literate",1 );
        lvl = lvl / 6000;
                if ((!flagli) && lvl > query("daoguang", me)) lvl = query("daoguang", me);
                if (lvl < 1) lvl = 1;
                if (lvl > 6) lvl = 6;
                idx2 = lvl + 1;         
                while (lvl--) {
                num --;
                if (!num) break;
                if (flagli && random(5)) lvl++;
                obs = me->query_enemy();        
                if (!obs || !arrayp(obs) || !sizeof(obs))
                        break;
                else   
                        victim = obs[random(sizeof(obs))];
                if (! me->is_fighting(victim)) continue;
                idx = random(idx2);
                damage2 = damage + damage * idx / 2;
        message_combatd(( replace_string(ship[random(sizeof(ship))], "刀道域", shi[idx]) ), me, victim);
        dp=defense_power(victim,"parry")+victim->query_int()*50+victim->query_skill("martial-cognize",1 );
        if (ap / 2 + random(ap) > dp)
        {
                msg = COMBAT_D->do_damage(me, victim, ((!random(3)) ? REMOTE_ATTACK : WEAPON_ATTACK), damage2, 60 + random(query("int",me) * 2),
                                          HIY"只听「哐哐哐」！几声过后，" + weapon->name() + HIY "已劈碎$n" HIY "的身体，变成一团肉泥。\n" NOR, me , victim);
        } else
        {
                msg = HIC "$n" HIC "会心一笑，看出$N" HIC "这招中的破绽，随意施招竟将这招化去。\n" NOR;
        }
        message_combatd(sort_msg(msg), me, victim);
        }
        return 1;

}

int difficult_level()
{
        return 30000;
}

