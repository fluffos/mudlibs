            !query("daoguang", me) )  
        { 
                tell_object(me, HIC "你通晓了刀域「" HIR "刀光" HIC "」的奥秘。\n" NOR);     
                addn("daoguang", 1,me); 
                me->improve_skill("martial-cognize", 1500000);   
                me->improve_skill("martial-cognize", 1500000);   
                me->improve_skill("martial-cognize", 1500000);   
        } 
		if( lvl >= 29000 && 
            !query("daoguang", me) )  
        { 
                tell_object(me, HIC "你通晓了刀域「" HIR "刀光" HIC "」的奥秘。\n" NOR);     
                addn("daoguang", 1,me); 
                me->improve_skill("martial-cognize", 1500000);   
                me->improve_skill("martial-cognize", 1500000);   
                me->improve_skill("martial-cognize", 1500000);   
        } 
		if( lvl >= 30000 && 
            !query("daoguang", me) )  
        { 
                tell_object(me, HIC "你通晓了刀域「" HIR "刀光" HIC "」的奥秘。\n" NOR);     
                addn("daoguang", 1,me); 
                me->improve_skill("martial-cognize", 1500000);   
