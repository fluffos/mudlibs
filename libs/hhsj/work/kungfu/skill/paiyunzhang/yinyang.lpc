#include <ansi.h>
#include <combat.h>
inherit F_SSERVER;

string name() { return HIW "燮云无定" NOR; }


int perform(object me, object target)
{
        string msg;
        int lvl;
        int ap, dp, dp1;
        int sub, damage;

        if (! target) target = offensive_target(me);

        if (! target || ! me->is_fighting(target))
                return notify_fail(name()+ "只能对战斗中的对手使用。\n");

        if( query_temp("weapon", me) || query_temp("secondary_weapon", me) )
                return notify_fail(name()+ "只能空手使用。\n");

        if (me->query_skill_mapped("strike") != "paiyunzhang")
                return notify_fail("你没有激发排云掌为特殊掌法，无法使用" +name()+ "。\n");

        if( query("neili", me)<2000 )
                return notify_fail("你的真气不够，无法施展" +name()+ "！\n");

        if( query("max_neili", me)<5000 )
                return notify_fail("你的内力修为还不足以使出" +name()+ "。\n");

        if ((int)me->query_skill("strike") < 500)
                return notify_fail("你的掌法火候不够，难以施展" +name()+ "！\n");

        if ((lvl = (int)me->query_skill("paiyunzhang", 1)) < 500)
                return notify_fail("你的排云掌还不够熟练，无法使用" +name()+ "！\n");

        if (! living(target))
                return notify_fail("对方都已经这样了，用不着这么费力吧？\n");

        message_combatd(HIM "\n$N" HIM "运起排云掌，左手聚集" HIB "阴气"
                     HIM "，右手聚集" HIR "阳气" HIM "，缥缈无定，"
                     HIM "以乎阴乎阳之势，宛如一团黑白相间的云卷向$n" HIM "！\n" NOR, me, target);

        ap = attack_power(me, "strike");

        sub = 0;
        dp1 = 0;

        if (target->query_skill_mapped("strike") == "paiyunzhang")
        {
                sub = 3;
                dp1 = target->query_skill("paiyunzhang", 1);
        
        }

        //第一招：阴

        dp = defense_power(target, "strike");

        if (sub == 1 || sub == 3)
                dp += dp1;

        message_combatd(BLK "\n$N" BLK "左掌往前一推，漆黑无比的阴气，离掌而出"
                     "似乎看不见一丝的亮光！\n" NOR, me, target);

        if (ap * 2 / 3 + random(ap) > dp)
        {
                damage = damage_power(me, "strike")*10;
                msg = COMBAT_D->do_damage(me, target, UNARMED_ATTACK, damage, 80 + random(20),
                                          CYN "$n" HIB "但见$N" CYN "左掌已攻出，"
                                          YEL "正欲反击。突然看不到一丝光亮，不禁暗暗叫苦，"
                                          BLK "胸口处被一股漆黑发亮的能量击中，全身变得漆黑无比。\n" NOR);
                target->start_busy(3 + random(lvl / 500));
        } else
        {
                msg = CYN "$n" CYN "见$P" CYN "来势汹涌，不敢轻易抵"
                      "挡，连忙飞身腾挪，躲闪开来。\n" NOR;
        }

        message_combatd(msg, me, target);

        //第二招：阳

        dp = defense_power(target, "parry");

        if (sub == 2 || sub == 3)
                dp += dp1;

        message_combatd(WHT "\n$N" WHT "右手极阳，灼热的阳气澎湃激荡，"
                     HBWHT "右手和左手形成阴阳合一！\n" NOR, me, target);

        if (ap * 2 / 3 + random(ap) > dp)
        {
                damage = damage_power(me, "strike")*10;
                msg = COMBAT_D->do_damage(me, target, UNARMED_ATTACK, damage, 80 + random(40),
                                          HIW "$n" HIR "急忙抽身后退，忽然阴阳之力消失不见，"
                                          HIG "只见$n"
										  HBCYN"跌跌撞撞向后连退数步，伏倒"
                                          "在地。只见$n胸口出现一团暴虐的阴阳之力。\n" NOR);
        } else
        {
                msg = CYN "可是$n" CYN "看透$P" CYN "此招之中的破绽，镇"
                      "定逾恒，应对自如。\n" NOR;
        }

        message_combatd(msg, me, target);

        me->start_busy(3 + random(4));
        addn("neili", -500-random(200), me);
        return 1;
}
