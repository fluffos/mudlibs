#include <ansi.h>;
#include <combat.h>

inherit SKILL;

int is_pbsk() { return 1; }

string type() { return "martial"; }
string martialtype() { return "skill"; }

mapping *action = ({
  ([ "action": "$N右手凝聚,左手趁势攻出," HIC "「双雷轰顶」" NOR "右手紧随而至攻向$n",
    "lvl": 0,
    "skill_name": "双雷轰顶"
  ]),
  ([ "action": "$N左手持爪，右手持掌,散发出惊人的气势，" HIC "「滔天」" NOR "气势化作巨浪$n的$l",
    "lvl": 10,
    "skill_name": "滔天"
  ]),
  ([ "action": "突然间天慢慢暗了下来，$N双手凝聚着无限恐惧的威能，" HIG "「破虚」" NOR "，气势如同捅破天似的朝$n的$l劈下，$n只觉$l天地色变，恍惚间,已然没有知觉。",
    "lvl": 20,
    "skill_name": "破虚"
  ]),
  ([ "action": "$N手握拳状，一股气场出现在$N四周" HIY "「踏空」" NOR "，疾冲$n的$l",
    "lvl": 30,
    "skill_name": "踏空"
  ]),
  ([ "action": "$N一招" HIW "「殇魂」" NOR "，身子前倾，忽地连续间，只看拳影向$n的$l辟去",
    "lvl": 40,
    "skill_name": "殇魂"
  ]),
  ([ "action": "$N化作一只握拳的大手" BLU "「力破虚空」" NOR "，一拳轰向$n,空间已然被轰碎",
    "lvl": 50,
    "skill_name": "力破虚空"
  ]),
  ([ "action": "$N左手化拳" MAG "「拳」" NOR "" HIM "「殛」" NOR "，拳头所到之处无一不是漆黑一片,$n被无尽虚空笼罩",
    "lvl": 60,
    "skill_name": "拳殛"
  ]),
});

int valid_enable(string usage) { return usage == "cuff" || usage == "parry"; }
int valid_learn(object me) {
  if (query("max_neili", me) < 100000)
    return notify_fail("你的内力不够。\n");
  if (me->query_skill("literate", 1) < 600)
    return notify_fail("你的读书写字不够。\n");
  if (me->query_skill("martial-cognize", 1) < 3000)
    return notify_fail("你的武学修养不够。\n");
  return 1;
}
int practice_skill(object me) {
  object weapon;

  /*if( !objectp(weapon=query_temp("weapon", me) )
                 || query("skill_type", weapon) != "cuff" )
                return notify_fail("你使用的武器不对。\n");*/
  if (query("qi", me) < 30 || query("neili", me) < 10)
    return notify_fail("你的内力或气不够练拳殛虚空。\n");
  me->receive_damage("qi", 30);
  addn("neili", -10, me);
  return 1;
}
string query_skill_name(int level) {
  int i;
  for (i = sizeof(action); i > 0; i--)
    if (level >= action[i - 1]["lvl"])
      return action[i - 1]["skill_name"];
}
mapping query_action(object me, object weapon) {
  /* d_e=dodge_effect p_e=parry_effect f_e=force_effect m_e=damage_effect */
  int d_e1 = 40;
  int d_e2 = 60;
  int p_e1 = 10;
  int p_e2 = 30;
  int f_e1 = 50;
  int f_e2 = 100;
  int m_e1 = 10;
  int m_e2 = 110;
  int i, lvl, seq, ttl = sizeof(action);

  lvl = (int)me->query_skill("quangang", 1);
  for (i = ttl; i > 0; i--)
    if (lvl > action[i - 1]["lvl"]) {
      seq = i; /* 获得招数序号上限 */ break;
    }
  seq = random(seq); /* 选择出手招数序号 */ return ([
    "action": action[seq]["action"],
    "dodge": d_e1 + (d_e2 - d_e1) * seq / ttl,
    "parry": p_e1 + (p_e2 - p_e1) * seq / ttl,
    "force": f_e1 + (f_e2 - f_e1) * seq / ttl,
    "damage": m_e1 + (m_e2 - m_e1) * seq / ttl,
    "damage_type": random(2) ? "瘀伤" : "砍伤",
  ]);
}
int learn_bonus() { return 30; }
int practice_bonus() { return 30; }
int success() { return 20; }
int power_point(object me) { return 1.0; }

string *shi = ({ HIG "双雷轰顶" HIW, HIG "滔天" HIW, HIG "踏虚" HIW, HIG "破空" HIW,
  HIG "殇魂" HIW, HIG "力破虚空" HIW, HIG "拳殛" HIW });
string *ship = ({ HIW "\n$N双拳噼里啪啦如同雷电附在拳头上," BLK "双雷" HIW "轰顶，霎时无数" BLK "雷电" HIW "跟随拳头袭向$n" HIW "。\n" NOR,
  HIW "\n$N身法陡快，忽念到" HIC "滔天，突然间双拳变大,拳罡化作一道道拳影，轰向$n" HIW "。\n" NOR,
  HIW "\n$N清吟" HIY "踏虚，拳罡犹如黑色的乌云般，将$n" HIW "笼罩。\n" NOR,
  HIW "\n$N黯然低吟" HIR "拳" HIC "殛" HIG "，猛然双拳轰出无数拳罡,将$n周围轰成无尽虚空,宛如一个天地牢笼让人跳不出去并发出万道拳影在四周。\n" NOR });

mixed hit_ob(object me, object victim, int damage_bonus, int factor) {
  mixed result;
  string msg;
  int lvl, flagli = 0;
  int idx, idx2, ap, dp, damage, damage2;
  int num = 200;
  object weapon = query_temp("weapon", me);
  object *obs;

  if ((userp(me) && query("quangang", me) < 1) ||
    me->query_skill("literate", 1) < 600 ||
    me->query_skill("martial-cognize", 1) < 200
  )
    return 0;

  if (!objectp(weapon) || query("skill_type", weapon) != "cuff"
    || me->query_skill_mapped("cuff") != "quangang")
    return 0;
  if (query("id", me) == "li bai")
    flagli = 1;
  if (!flagli) {
    if (query_temp("tsj_cd_time", me) >= time())
      return 0;
    set_temp("tsj_cd_time", time() + 2, me);
  }

  ap = attack_power(me, "cuff") + me->query_int() * 50 + me->query_skill("martial-cognize", 1);
  ap += ap * (query("quangang", me) / 50);
  damage = damage_power(me, "cuff");
  damage += damage * query("jiali", me) / 1000;
  damage += damage * (me->query_skill("literate", 1)) / 3500;
  damage += damage * (me->query_skill("martial-cognize", 1)) / 2500;
  damage += damage * (query("quangang", me) / 25);

  lvl = me->query_skill("quangang", 1) + me->query_skill("literate", 1);
  lvl = lvl / 6000;
  if ((!flagli) && lvl > query("quangang", me)) lvl = query("quangang", me);
  if (lvl < 1) lvl = 1;
  if (lvl > 6) lvl = 6;
  idx2 = lvl + 1;
  while (lvl--) {
    num--;
    if (!num) break;
    if (flagli && random(5)) lvl++;
    obs = me->query_enemy();
    if (!obs || !arrayp(obs) || !sizeof(obs))
      break;
    else
      victim = obs[random(sizeof(obs))];
    if (!me->is_fighting(victim)) continue;
    idx = random(idx2);
    damage2 = damage + damage * idx / 2;
    message_combatd((replace_string(ship[random(sizeof(ship))], "拳殛虚空", shi[idx])), me, victim);
    dp = defense_power(
      victim,
      "parry"
    ) + victim->query_int() * 50 + victim->query_skill("martial-cognize", 1);
    if (ap / 2 + random(ap) > dp) {
      msg = COMBAT_D->do_damage(me, victim, ((!random(3)) ? REMOTE_ATTACK : WEAPON_ATTACK), damage2, 60 + random(query(
        "int",
        me
      ) * 2),
        HIY "只听「轰轰轰」！几声过后，" + weapon->name() + HIY "$n" HIY "身骨全碎，瘫软如泥而死。\n" NOR, me, victim);
    } else {
      msg = HIC "$n" HIC "会心一笑，看出$N" HIC "这招中的破绽，随意施招竟将这招化去。\n" NOR;
    }
    message_combatd(sort_msg(msg), me, victim);
  }
  return 1;

}

int difficult_level() {
  return 30000;
}

