inherit "/obj/monster";


void setup()
  {
  set_name("kobold");
  set_short("Kobolds");
  add_alias("kobold");
  set_long("The kobold is a cowardly, sadistic and ugly dog-like"
           " humanoid.\n");
  set_main_plural("kobolds");
  set_gender(1);
  set_race("kobold");
  set_random_stats(6,14); //will set radom between 6 & 18.. for all stats..
  set_aggressive(1);
  add_triggered_action("bing", "event_death", this_object(), "death");
  set_join_fight_mess("The kobold attacks you.\n");
  set_level(random(2)); 
  set_al(60);
  set_wimpy(0);
  switch(random(5)+1)
  {
  case 1:
    {
      object new_ob = new("/baseobs/weapons/short_sword");
      if (new_ob) new_ob->move(this_object());
    }
    break;
  case 2:
    {
      object new_ob = new("/baseobs/weapons/club");
      if (new_ob) new_ob->move(this_object());
    }
    break;
  case 3:
    new("/baseobs/weapons/hand_axe")->move(this_object());
    break;
  case 4:
    {
      object new_ob = new("/baseobs/weapons/javelin");
      if (new_ob) new_ob->move(this_object());
    }
    break;
  case 5:
    {
      object new_ob = new("/baseobs/weapons/spear");
      if (new_ob) new_ob->move(this_object());
    }
    break;
  } 
  new("/baseobs/armours/leather")->move(this_object());
  this_object()->init_equip();  
  load_a_chat(30,
      ({
               1, "@kick $hcname$"
       }));
  /* Money? maybe.. */
  adjust_money(random(20), "brass");
} /* setup */
