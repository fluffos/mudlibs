inherit "/std/llanura.lpc";
#include "../../path.h"
#include "path.h"

void setup()
{
	set_short("%^GREEN%^Pastos: %^RESET%^CYAN%^Zona Oeste%^RESET%^.");
	set_long(query_short()+"\n"+PASTOS1".\n\n");
	set_night_long(query_short()+"\n"+PASTOSN1".\n\n");
	set_zone("pastos_ormerod");
	add_clone(NPC+"ganadero_ormerod.lpc",1);
	add_clone(NPC+"ganadera_ormerod.lpc",1);
	add_exit("sudeste",ROOMORM"pasto_ormerod_120.lpc","door");
	add_exit("norte",ROOMORM"pasto_ormerod_117.lpc","door");
	add_exit("sudoeste",ROOMORM"corral_ormerod_28.lpc","door");
}