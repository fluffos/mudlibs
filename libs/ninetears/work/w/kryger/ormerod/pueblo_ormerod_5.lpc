inherit "/std/ciudad.lpc";
#include "../../path.h"
#include "path.h"

void setup()
{
	set_short("%^BOLD%^BLUE%^Calle Principal %^RESET%^.");
	set_long(query_short()+"\n"+CALLEP".\n\n");
	set_night_long(quert_short()+"\n"+CALLEPN".\n\n");
	set_zone("pueblo_ormerod");
	add_exit("sur",ROOMORM"carniceria_pueblo_ormerod.lpc","door");
	add_exit("oeste",ROOMORM"pueblo_ormerod_4.lpc","standard");
	add_exit("sudeste",ROOMORM"camino_ormerod_18.lpc","road");
	add_exit("norte",ROOMORM"entrada_a_pastos_2.lpc","standard");
}