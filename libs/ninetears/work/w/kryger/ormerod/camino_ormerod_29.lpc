inherit "/std/outside.lpc";
#include "../../path.h"
#include "path.h"

void setup()
{
	set_short("%^BOLD%^YELLOW%^Caminos%^RESET%^.");
	set_long(query_short()+"\n"+CAMINO1".\n\n");
	set_night_long(query_short()+"\n"+CAMINON1".\n\n");
	set_zone("camino_ormerod");
	set_exit_color("red");
	add_exit("noroeste",ROOMORM"camino_ormerod_27.lpc","road");
	add_exit("este",ROOMORM"granja_c.lpc","door");
	add_exit("noreste",ROOMORM"corral_ormerod_22.lpc","standard");
}