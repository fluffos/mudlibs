#define CREATOR "xerxes"
inherit "/std/outside.lpc";
void setup()
{
  set_short("Confines del Plano Abismal");
  set_long("\nAqui todo es tierra inerte. Eres incapaz de divisar "
           "cualquier signo de vida.\n\n");
  set_light(40);
  set_exit_color("white");
  add_clone("/obj/misc/button.lpc",1);
//    add_clone("/w/xerxes/npc/aragami.lpc",1);
  add_exit("comun","/w/common","door");
  add_exit("entrada","/room/entryroom.lpc","door");
  add_exit("urghak","/d/urghak/common.lpc","door");
  "/w/common.lpc"->add_exit( CREATOR,"/w/"+CREATOR+"/workroom","door");
}
