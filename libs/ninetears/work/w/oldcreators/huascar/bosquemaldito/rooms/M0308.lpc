//Huascar

#include "../path.h"
inherit "/std/outside.lpc";
void setup()
{
set_short("%^BOLD%^BLACK%^Charca%^RESET%^");
set_long("%^BOLD%^BLACK%^Charca%^RESET%^\n\n El agua estancada te rodea causandote unas nauseas "
	 "insoportable. En este ambiente insano solo pueden sobrevivir insectos y sanguijuelas. "
	 "Hay restos de troncos putrefactos con moho adherido y algunos helechos en no muy "
 	 "buen estado. Definitivamente no es un lugar que elegirias para hacer una merienda "
	 "campestre.\n\n");
		
set_light(50);
set_zone("charca");
add_clone(NPC"babosa.lpc",random(4)-2);
add_clone(NPC"mosquito.lpc",random(4)-2);
add_clone(NPC"mariposa.lpc",random(4)-2);
add_clone(NPC"culebra.lpc",random(4)-2);
add_clone(NPC"sapo.lpc",random(4)-2);
add_exit("oeste",CHA"M0307.lpc","road");
add_exit("noroeste",CHA"M0407.lpc","road");
add_exit("norte",CHA"M0408.lpc","road");
add_exit("noreste",CHA"M0409.lpc","road");
add_exit("este",CHA"M0309.lpc","road");
add_exit("sudeste",CHA"M0209.lpc","road");
add_exit("sur",CHA"M0208.lpc","road");
add_exit("sudoeste",CHA"M0207.lpc","road");
}