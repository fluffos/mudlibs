inherit "/std/outside.lpc";
#include "../../path.h"
#include "path.h"

void setup()
{
	set_short("%^GREEN%^Viñedos de Rongrond%^RESET%^");
	set_long(query_short()+"\n\n"+VINYASS1".\n\n");
	set_night_long(query_short()+"\n\n"+VINYASSN1".\n\n");
	set_zone("viñedo_sur_rongrond");
    set_exit_color("verde_c");
	add_exit("norte",ROOMRONVS"viñedo_sur_rongrond_4.lpc","plain");
	add_exit("sur",ROOMRONVS"viñedo_sur_rongrond_2.lpc","plain");
	add_exit("sudeste",ROOMRONVS"viñedo_sur_rongrond_7.lpc","plain");
}