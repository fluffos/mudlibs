inherit "/std/ciudad.lpc";
#include "../../path.h"
#include "path.h"

void setup()
{
	set_short("%^BOLD%^RED%^Pueblo de Rongrond:Calle %^RED%^Reirid%^RESET%^");
	set_long(query_short()+"\n\n"+PUEBLO1".\n\n");
	set_night_long(query_short()+"\n\n"+PUEBLON1".\n\n");
	set_zone("pueblo_rongrond");
	add_clone(NPC+"npcs_rongrond.lpc",3);
    set_exit_color("amarillo_c");
	add_exit("este",ROOMRONP"pueblo_rongrond_12.lpc","standard");
	add_exit("norte",ROOMRONP"pueblo_rongrond_10.lpc","standard");
}