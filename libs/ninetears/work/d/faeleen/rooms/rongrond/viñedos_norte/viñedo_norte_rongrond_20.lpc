inherit "/std/outside.lpc";
#include "../../path.h"
#include "path.h"

void setup()
{
	set_short("%^BOLD%^GREEN%^Viñedos de Rongrond%^RESET%^.");
	set_long(query_short()+"\n\n"+VINYASN2".\n\n");
	set_night_long(query_short()+"\n\n"+VINYASNN2".\n\n");
	set_zone("viñedo_norte_rongrond");
    set_exit_color("verde_o");
	add_exit("norte",ROOMRONVN"viñedo_norte_rongrond_21.lpc","plain");
	add_exit("noreste",ROOMRONVN"viñedo_norte_rongrond_24.lpc","plain");
	add_exit("sudoeste",ROOMRONVN"viñedo_norte_rongrond_15.lpc","plain");
}