    set_exit_color("verde_o");
	add_exit("sudeste",ROOMRONVN"viñedo_norte_rongrond_19.lpc","plain");
	add_exit("sudoeste",ROOMRONVN"viñedo_norte_rongrond_8.lpc","plain");
	add_exit("sur",ROOMRONVN"viñedo_norte_rongrond_12.lpc","plain");
}