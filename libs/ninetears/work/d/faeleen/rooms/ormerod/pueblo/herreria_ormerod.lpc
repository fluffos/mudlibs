inherit "/std/tienda";
#include "../../path.h"
void setup() 
	{
	set_short("%^BOLD%^BLUE%^Herreria de Ormerod%^RESET%^.");
	set_long(query_short()+"\nEstamos en la herreria de Ormerod, vemos una "
	"piedra enorme al lado de un horno, un mostrador, y unas lejas con objetos "
	"varios.\n");
	add_exit("fuera",ROOMORMP"cruce_ormerod.lpc");
	set_dependiente("/d/faeleen/npc/krysh_ormerod.lpc");
	// La funcion prohibir_venta() hace que en la tienda no se puedan vender objetos,
	//solo comprar. La usare en la herreria
	/////seria ---> prohibir_venta();
	// Como he implemtado el tipo herreria y quiero hacer una herreria pues le pongo
	//el tipo herreria
	set_tipo("herreria");
	add_suministro("/baseobs/armaduras/yelmo.lpc",2);
	add_suministro("/baseobs/armaduras/anillo.lpc",random(5));
	add_suministro("/baseobs/armaduras/amuleto.lpc",random(5));
	add_suministro("/baseobs/armaduras/armadura_de_cuero.lpc",3);
	add_suministro("/baseobs/armaduras/brazaletes.lpc",2);
	add_suministro("/baseobs/armas/espada_larga.lpc",random(5));
	add_suministro("/baseobs/armas/latigo.lpc",random(5));
	add_suministro("/baseobs/armas/baston.lpc",2);
	add_suministro("/baseobs/escudos/corporal.lpc",roll(1,3));
	// Esta vez probaremos los prohibidos
	//////add_prohibido("raza","enano");
	//////add_prohibido("alineamiento","legal bueno");
	// Ahora quiero una placa
	add_cartel();
	}

// Pues sabiendo hacer la tienda no es nada complicado hacer la herreria, digo yo
