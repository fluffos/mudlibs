//Kryger 2002//
inherit "/std/outside.lpc";
#include "../../../path.h"
#include "path.h"

void setup()
{
	set_short("%^BOLD%^BLUE%^Calle Principal %^RESET%^.");
	set_long(query_short()+"\n"+CALLEP".\n\n");
	set_night_long(query_short()+"\n"+CALLEPN".\n\n");
	set_zone("pueblo_ormerod");
	day_clone(NPC"npcs_rongrond.lpc",2);
	night_clone(NPC"rata.lpc",random(1));
	set_exit_color("amarillo_c");
	add_exit("sudoeste",ROOMORMC"camino_ormerod_9.lpc","road");
	add_exit("este",ROOMORMP"pueblo_ormerod_2.lpc","standard");
	add_exit("norte",ROOMORMP"entrada_a_pastos_1.lpc","standard");
}