//Kryger//
inherit "/std/llanura.lpc";
#include "../../../../path.h"
#include "path.h"

void setup()
{
	set_short("%^GREEN%^Pastos: %^RESET%^CYAN%^Zona Norte%^RESET%^.");
	set_long(query_short()+"\n"+PASTOS3".\n\n");
	set_night_long(query_short()+"\n"+PASTOSN3".\n\n");
	add_clone(NPC+"bichos_ormerod.lpc",3);
	set_zone("pastos_ormerod");
	set_exit_color("verde_c");
	add_exit("oeste",ROOMORMPN"pasto_ormerod_53.lpc","plain");
	add_exit("sudeste",ROOMORMPN"pasto_ormerod_67.lpc","plain");
}