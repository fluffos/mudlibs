//Kryger//
inherit "/std/llanura.lpc";
#include "../../../../path.h"
#include "path.h"

void setup()
{
	set_short("%^GREEN%^Pastos: %^RESET%^CYAN%^Zona Norte%^RESET%^.");
	set_long(query_short()+"\n"+PASTOS2".\n\n");
	set_night_long(query_short()+"\n"+PASTOSN2".\n\n");
	add_clone(NPC+"bichos_ormerod.lpc",3);
	set_zone("pastos_ormerod");
	set_exit_color("verde_c");
	add_exit("sudoeste",ROOMORMPN"pasto_ormerod_88.lpc","plain");
	add_exit("noroeste",ROOMORMPN"pasto_ormerod_89.lpc","plain");
	add_exit("noreste",ROOMORMPN"pasto_ormerod_100.lpc","plain");
}