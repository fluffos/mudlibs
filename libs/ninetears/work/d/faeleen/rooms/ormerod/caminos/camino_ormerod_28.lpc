inherit "/std/outside.lpc";
#include "../../../path.h"
#include "path.h"

void setup()
{
	set_short("%^BOLD%^YELLOW%^Caminos%^RESET%^.");
	set_long(query_short()+"\n"+CAMINO2".\n\n");
	set_night_long(query_short()+"\n"+CAMINON2".\n\n");
	set_zone("camino_ormerod");
	set_exit_color("red");
	add_exit("sudoeste",ROOMORMC"camino_ormerod_26.lpc","road");
	add_exit("norte",ROOMORMCO"corral_ormerod_15.lpc","standard");
	add_exit("sudeste",ROOMORMCO"corral_ormerod_18.lpc","standard");
	add_exit("noreste",ROOMORMP"granja_b.lpc","standard");
	
}