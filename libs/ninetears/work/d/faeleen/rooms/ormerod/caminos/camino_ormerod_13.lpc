inherit "/std/outside.lpc";
#include "../../../path.h"
#include "path.h"

void setup()
{
	set_short("%^BOLD%^YELLOW%^Caminos%^RESET%^.");
	set_long(query_short()+"\n"+CAMINO1".\n\n");
	set_night_long(query_short()+"\n"+CAMINON1".\n\n");
	set_zone("camino_ormerod");
	set_exit_color("red");
	add_exit("norte",ROOMORMP"pueblo_ormerod_4.lpc","gate");
    add_exit("sur",ROOMORMC"camino_ormerod_12.lpc","road");
}