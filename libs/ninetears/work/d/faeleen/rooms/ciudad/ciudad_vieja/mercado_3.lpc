//Ciudad de Faeleen, Flangerant 2002

#include "../../path.h"
inherit CIUDAD+"ciudad.lpc";

void setup()
{
   mercado();
   day_clone(NPC+"mercado.lpc",random(3)); 
   add_exit("noroeste",CIUDAD"mercado_0.lpc","standard");
   add_exit("sudoeste",CIUDAD"mercado_5.lpc","standard");
   add_exit("sudeste",CIUDAD"mercado_6.lpc","standard");
   add_exit("oeste",CIUDAD"mercado_2.lpc","standard");
}
