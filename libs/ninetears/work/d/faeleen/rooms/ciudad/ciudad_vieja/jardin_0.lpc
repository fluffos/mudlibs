//Ciudad de Faeleen, Flangerant 2002

#include "../../path.h"
inherit CIUDAD+"ciudad.lpc";

void setup()
{
   jardin();
   day_clone(NPC+"ciudad.lpc",random(2)); 
   add_exit("noroeste",CIUDAD"mercado_10.lpc","standard");   
