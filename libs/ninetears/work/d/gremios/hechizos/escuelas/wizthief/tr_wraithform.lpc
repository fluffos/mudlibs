#include "tweaks.h"
inherit "/d/gremios/hechizos/trapbase.lpc";
 
#define LOCKOUT "trap"
void setup()
{
	::setup();
   item = "box";
  set_spell_name("Wraithform Trap");
  set_school("Wizthief");
