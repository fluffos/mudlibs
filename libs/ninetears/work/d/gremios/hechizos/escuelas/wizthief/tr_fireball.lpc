#include "tweaks.h"
inherit "/d/gremios/hechizos/trapbase.lpc";
 
#define LOCKOUT "trap"
void setup()
{
	::setup();
   item = "box";
  set_spell_name("Confusion Trap");
  set_school("Wizthief");
  set_help_desc("This spell will set a confusion trap. "
     "It's pretty useless, but great fun at parties.");
  set_gp_cost(10);
  trap  = "/d/gremios/hechizos/wizard/fireball.lpc";
  trap_target = 2; 
}



