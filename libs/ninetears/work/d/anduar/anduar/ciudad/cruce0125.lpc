// Aokromes
#include "../path.h"
inherit ANDUAR+"cityroom.lpc";

void setup()
{
   set_short("%^YELLOW%^Ciudad de Anduar: cruce entre Calle Norte y Este%^RESET%^");
   long_desc();
   add_exit("oeste"   ,ANDUAR"no0124.lpc","road");
   add_exit("sur"     ,ANDUAR"es0225.lpc","road");
add_exit("arriba"   ,ANDUAR"torre_ne.lpc","road");
   base_desc();
   set_zone("Anduar");
   crea_bichos();
}
