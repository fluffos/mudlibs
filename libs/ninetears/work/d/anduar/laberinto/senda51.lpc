#include "../path.h"
inherit CULTIVOS+"cultivos";

void setup()
{
   set_short("Sendas de Anduar");
   crea_bichos();
   long_desc();
   add_exit("north"     ,CULTIVOS"senda57.lpc","road");
   add_exit("east"      ,CULTIVOS"senda52.lpc","road");
   add_exit("southeast" ,CULTIVOS"senda45.lpc","road");
   add_exit("southwest" ,CULTIVOS"senda44.lpc","road");
}