#include "../../path.h"
inherit CANTERA2+"cantera.lpc";

void setup()
{
   set_short("%^CYAN%^BOLD%^Real cantera de Anduar%^RESET%^");
   set_long("Estas en la Real cantera de Anduar, la cual fue utilizada para "
   "proporcionar roca al Real camino, por todos lados observas restos de "
   "las estructuras dedicadas a extraer la roca.");

   add_exit("este"   ,CANTERA"senda14.lpc","road");
   add_exit("southwest"   ,CANTERA2"n0-1.lpc","road");
   add_exit("oeste"       ,CANTERA2"n1-1.lpc","road");
   add_exit("northwest"   ,CANTERA2"n2-1.lpc","road");
   set_light(65);
   crea_bichos();
}
