#include "../../path.h"

inherit PARQUE+"parque.lpc";

void setup() {

   base_desc();
   set_exit_color("cyan");
   set_short("%^BOLD%^BLUE%^Ciudad de %^BLACK%^Keroon%^GREEN%^: Parque de los conquistadores%^RESET%^");
   parque_desc();
   
add_clone(NPCSPARQUE+"chulo.lpc",random(1)); 
add_clone(NPCSPARQUE+"prostitutas.lpc",random(3)); 
add_exit("este",PARQUE+"keroon_309.lpc","standard");
add_exit("sudeste",PARQUE+"keroon_329.lpc","standard");
add_exit("sur",PARQUE+"keroon_328.lpc","standard");
add_exit("sudoeste",PARQUE+"keroon_327.lpc","standard");
}
