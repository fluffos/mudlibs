/* By Shimmer */

#define CREATOR "shimmer"

#include "../../path.h"

inherit BRETHEM+"cityroom.lpc";


void setup() {

   base_desc();
   set_exit_color("cyan");
   set_short("%^BOLD%^Ciudad de Brethem : %^BOLD%^WHITE%^Calle del General%^RESET%^");
   long_desc();


   crea_npcs();

add_exit("sudoeste",       BRETHEM + "gen20.lpc","standard");
add_exit("noreste",        BRETHEM + "gen18.lpc","standard");
add_exit("sudeste",        BRETHEM + "callejon002.lpc","standard");
add_exit("oeste",          BRETHEM + "plaza_encuentro1.lpc","standard");
add_exit("noroeste",       BRETHEM + "plaza_encuentro2.lpc","standard");
add_exit("dentro",         BRETHEM + "floristeria1.lpc","standard");


}
