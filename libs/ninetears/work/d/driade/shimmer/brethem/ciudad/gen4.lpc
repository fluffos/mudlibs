/* By Shimmer */

#define CREATOR "shimmer"

#include "../../path.h"

inherit BRETHEM+"cityroom.lpc";


void setup() {

   base_desc();
   set_exit_color("cyan");
   set_short("%^BOLD%^Ciudad de Brethem : %^BOLD%^WHITE%^Calle del General%^RESET%^");
   long_desc();


   crea_npcs();

add_exit("este",      BRETHEM + "gen3.lpc","standard");
add_exit("oeste",     BRETHEM + "gen5.lpc","standard");
add_exit("norte",     BRETHEM + "barr1.lpc","standard");
add_exit("sur",       BRETHEM + "parque1.lpc","standard");

}
