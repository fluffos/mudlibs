/* By Shimmer */

#define CREATOR "shimmer"

#include "../../path.h"

inherit BRETHEM+"cityroom.lpc";


void setup() {

   base_desc();
   set_exit_color("cyan");
   set_short("%^BOLD%^Ciudad de Brethem : %^BOLD%^WHITE%^Calle del General%^RESET%^");
   long_desc();


   crea_npcs();

add_exit("oeste",      BRETHEM + "gen17.lpc","standard");
add_exit("este",       BRETHEM + "gen15.lpc","standard");
add_exit("noroeste",   BRETHEM + "descub1.lpc","standard");
add_exit("norte",      BRETHEM + "plaza_catedral.lpc","standard");
add_exit("sur",        BRETHEM + "plaza_eleisson1.lpc","standard");


}
