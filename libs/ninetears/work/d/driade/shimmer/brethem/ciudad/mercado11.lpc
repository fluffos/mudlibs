/* By Shimmer */

#define CREATOR "shimmer"

#include "../../path.h"

inherit BRETHEM+"cityroom.lpc";

void setup() {

   base_desc();
   set_exit_color("cyan");
   set_short("%^BOLD%^Ciudad de Brethem : %^BOLD%^RED%^Mercado de Brethem%^RESET%^");
   long_desc_mercado();


   crea_npcs_mercado();

add_exit("norte",        BRETHEM + "mercado5.lpc","standard");
add_exit("noroeste",     BRETHEM + "mercado6.lpc","standard");
add_exit("oeste",        BRETHEM + "mercado12.lpc","standard");
add_exit("sudoeste",     BRETHEM + "mercado17.lpc","standard");
add_exit("sur",          BRETHEM + "mercado16.lpc","standard");
add_exit("sudeste",      BRETHEM + "mercado15.lpc","standard");
add_exit("este",         BRETHEM + "mercado10.lpc","standard");

}
