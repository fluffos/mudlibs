/* By Shimmer */

#define CREATOR "shimmer"

#include "../../path.h"

inherit BRETHEM+"cityroom.lpc";


void setup() {

   base_desc();
   set_exit_color("cyan");
   set_short("%^BOLD%^Ciudad de Brethem : %^BOLD%^GREEN%^Calle de los Castros%^RESET%^");
   long_desc();

   crea_npcs();

add_exit("noroeste",   BRETHEM + "castros6.lpc","standard");
add_exit("sudeste",    BRETHEM + "castros4.lpc","standard");
add_exit("norte",      BRETHEM + "plaza_central3.lpc","standard");
add_exit("este",       BRETHEM + "plaza_central1.lpc","standard");

}
