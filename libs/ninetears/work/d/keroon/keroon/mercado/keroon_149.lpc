#include "../../path.h"
inherit MERCADO+"mercado.lpc";
void setup() {

   base_desc();
   set_exit_color("cyan");
   set_short("%^BOLD%^BLUE%^Ciudad de %^BLACK%^Keroon%^RED%^: Mercado%^RESET%^");
   long_desc_mercado();
   add_clone(MERCADONPCS+"bixos_mercado.lpc",random(5)); 
    
add_exit("oeste",MERCADO+"keroon_148.lpc","standard");
add_exit("norte","/d/keroon/keroon/mercado/armaduria.lpc","standard");
add_exit("este",MERCADO+"keroon_150.lpc","standard");
add_exit("sur",MERCADO+"keroon_173.lpc","standard");
}
