#include "../../path.h"

inherit PARQUE+"parque.lpc";

void setup() {

   base_desc();
   set_exit_color("cyan");
   set_short("%^BOLD%^BLUE%^Ciudad de %^BLACK%^Keroon%^GREEN%^: Parque de los conquistadores%^RESET%^");
   parque_desc();
   
add_clone(NPCSPARQUE+"chulo.lpc",random(1)); 
add_clone(NPCSPARQUE+"prostitutas.lpc",random(3)); 
add_exit("oeste",PARQUE+"keroon_370.lpc","standard");
add_exit("noroeste",PARQUE+"keroon_344.lpc","standard");
add_exit("norte",PARQUE+"keroon_345.lpc","standard");
add_exit("noreste",PARQUE+"keroon_346.lpc","standard");
add_exit("este",PARQUE+"keroon_372.lpc","standard");
add_exit("sudeste",PARQUE+"keroon_393.lpc","standard");
add_exit("sur",PARQUE+"keroon_392.lpc","standard");
add_exit("sudoeste",PARQUE+"keroon_391.lpc","standard");
}
