#include <ansi.h>
inherit ITEM;

void setup() {}

void init() {
  add_action("do_eat", "eat");
}

void create() {
  set_name(HIM "哈" HIW "根" HIY "达" HIR "斯" NOR, ({ "icecream" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "吨");
    set("long", "这是一车皮哈根达斯冰淇淋。\n");
    set("value", 0);

  }
  setup();
}

int do_eat(string arg) {
  if (!id(arg))
    return notify_fail("你要吃什么？\n");

  this_player()->add("potential", 10000);
  message_vision("$N对着哈根达斯狠狠的来了一口 !\n", this_player());
  destruct(this_object());
  return 1;
}
