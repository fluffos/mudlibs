#include <ansi.h>
inherit ITEM;


void create()
{
 set_name(HIW"一天的眼泪"NOR,({"dianel's tear","tear"}));
        set_weight(100);
        if (clonep())
                set_default_object(__FILE__);
        else {
set("long", HIW"新任总管一天的眼泪，还等啥，祈祷(pray)一下他吧。\n"NOR);
set("unit", "滴");
set("no_get",1);
set("no_sell",1);
set("no_drop",1);
set("no_put",1);
set("no_steal",1);
               
        }
}


void init()
{
 if(this_player()==environment())
add_action ("do_eat", "pray");

}
int do_eat(string arg)
{
        int i;
        object who = this_player();
 if (arg != this_object()->query("id"))
return 0;
if(who->query("combat_exp") < 500000) return 1;
message_vision(HIG"$N手捧眼泪，虔诚的念到，＃◎％◎￥◎￥……\n"NOR,this_player());
message_vision(HIM"眼泪化作一只美丽的蝴蝶飞走了～\n"NOR,this_player());
who->set("is_diablo_npc",1);
 who->set("magic_find",4000+random(3000));
for(i =0;i < 3;i++)
{
DIABLO_D->diablo_drop(who,who);
}
who->delete("is_diablo_npc");
who->delete("magic_find");

this_object()->move("/obj/void");
remove_call_out("dest");
call_out("dest",1);
return 1;
}
void dest()
{

destruct(this_object());
}
