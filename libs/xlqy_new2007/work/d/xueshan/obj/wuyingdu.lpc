#include <ansi.h>
inherit ITEM;

void create()
{
        set_name(HIR"无影神毒"NOR, ({ "wuyingdu" }) );
        set_weight(100);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "瓶");
                set("long", "这是一小瓶无影神毒，据说是大雪山的一位前辈所制。\n");
                set("value", 0);
        }
}




