#include <ansi.h>
inherit ITEM;

void create()
{
    set_name(HIY"妖法卷轴"NOR, ({"magic scroll", "scroll"}));
 set_weight(100);
 if( clonep() )
             set_default_object(__FILE__);
       else {
 set("long","这是张魔法卷轴，运用灵力可以驱动它释放出妖法的威力(bite,fatigue)。\n");
 set("unit", "卷");
 set("value", 5000);
 set("fashu","yaofa");
 set("cast_item/bite",1);
set("cast_item/fatigue",1);

  }
  setup();
}
