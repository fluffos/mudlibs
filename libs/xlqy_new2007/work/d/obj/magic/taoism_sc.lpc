#include <ansi.h>
inherit ITEM;

void create()
{
    set_name(GRN"天师正道卷轴"NOR, ({"magic scroll", "scroll"}));
 set_weight(100);
 if( clonep() )
             set_default_object(__FILE__);
       else {
 set("long","这是张魔法卷轴，运用灵力可以驱动它释放出天师正道的威力(shou,fu)。\n");
 set("unit", "卷");
 set("value", 5000);
 set("fashu","taoism");
 set("cast_item/shou",1);
set("cast_item/fu",1);

  }
  setup();
}
