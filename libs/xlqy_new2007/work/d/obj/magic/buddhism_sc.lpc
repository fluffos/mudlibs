#include <ansi.h>
inherit ITEM;

void create() {
  set_name(HIY "大乘佛法卷轴" NOR, ({ "magic scroll", "scroll" }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "这是张魔法卷轴，运用灵力可以驱动它释放出大乘佛法的威力(bighammer，yinshen,regenerate,lianhua)。\n");
    set("unit", "卷");
    set("value", 5000);
    set("fashu", "buddhism");
    set("cast_item/bighammer", 1);
    set("cast_item/yinshen", 1);
    set("cast_item/regenerate", 1);
    set("cast_item/lianhua", 1);
  }
  setup();
}
