#include <ansi.h>

inherit ITEM;
string new_unit()
{
  return "件";
}

int display_info (object who)
{
tell_object (who,"请使用：transform <new-english-name> <中文名称>。可以加颜色控制符!\n");  
  return 1;
}

int change_success (object me, object ob)
{
  message_vision ("话音未落，只见$N手中突然多出一"+ob->query("unit")+
                  "$n！\n",me,ob);
  return 1;
}

int do_transform (string arg)
{
  string *msgs = ({
    "$N抓起一把$n一嚼喷将出去，口中念念有词。\n",
    "$N把$n丢在口中嚼两下望空一喷，大喝一声。\n",
    "$N将$n往嘴里一嚼，喷在空中喝道：“变”！\n",
    "$N拿起$n往嘴里一扔，哼哈几声嚼将出去！\n",
    "$N将$n往口中一塞咔嚓嚼将起来，念念有词向空一喷。\n",
  });
  object me = this_player();
  object ob = this_object();
  string id, name,arg_old;

        
  if (!arg || sscanf(arg,"%s %s",id,name)!=2)
    return display_info(me);

  if (ob->query("has_transformed"))
    return 0;

  if (me->query_skill("spells",1)<100)
  {
    tell_object (me,"你的法术不够。\n");
    return 1;
  }
   if(strlen(name) > 100)
                return notify_fail("名字太长了点吧！\n");
                                arg_old = name;
//    name += "$NOR$";
       
        arg_old = replace_string(arg_old, "$BLK$", "");
        arg_old = replace_string(arg_old, "$RED$", "");
        arg_old = replace_string(arg_old, "$GRN$", "");
        arg_old = replace_string(arg_old, "$YEL$", "");
        arg_old = replace_string(arg_old, "$BLU$", "");
        arg_old = replace_string(arg_old, "$MAG$", "");
        arg_old = replace_string(arg_old, "$CYN$", "");
        arg_old = replace_string(arg_old, "$WHT$", "");
        arg_old = replace_string(arg_old, "$HIR$", "");
        arg_old = replace_string(arg_old, "$HIG$", "");
        arg_old = replace_string(arg_old, "$HIY$", "");
        arg_old = replace_string(arg_old, "$HIB$", "");
        arg_old = replace_string(arg_old, "$HIM$", "");
        arg_old = replace_string(arg_old, "$HIC$", "");
        arg_old = replace_string(arg_old, "$HIW$", "");
        arg_old = replace_string(arg_old, "$NOR$", "");
        arg_old = replace_string(arg_old, "$BLINK$","");
      //   msg = arg_old;

        name = replace_string(name, "$BLK$", BLK);
        name = replace_string(name, "$RED$", RED);
        name = replace_string(name, "$GRN$", GRN);
        name = replace_string(name, "$YEL$", YEL);
        name = replace_string(name, "$BLU$", BLU);
        name = replace_string(name, "$MAG$", MAG);
        name = replace_string(name, "$CYN$", CYN);
        name = replace_string(name, "$WHT$", WHT);
        name = replace_string(name, "$HIR$", HIR);
        name = replace_string(name, "$HIG$", HIG);
        name = replace_string(name, "$HIY$", HIY);
        name = replace_string(name, "$HIB$", HIB);
        name = replace_string(name, "$HIM$", HIM);
        name = replace_string(name, "$HIC$", HIC);
        name = replace_string(name, "$HIW$", HIW);
        name = replace_string(name, "$NOR$", NOR);
        name = replace_string(name, "$BLINK$",BLINK);
  
                  message_vision (msgs[random(sizeof(msgs))],this_player(),this_object());

  ob->set_name(name, ({"my "+id}));
  //ob->set_temp("apply/id",({id, "my "+id}));
  ob->set_temp("apply/id",({"my "+id}));
  ob->set("short",name+"("+capitalize("my "+id)+")");
  ob->set("unit",new_unit());
  ob->set("long","一"+this_object()->query("unit")+name+"。\n");
  ob->set("has_transformed",1);

  call_out ("change_success",1,me,ob);
  return 1;
}

void create()
{
  set_name("无色毫毛", ({ "none hair", "nonehair", "hair" }) );
  set_weight(100);
  if( clonep() )
    set_default_object(__FILE__);
  else {
    set("long", "一把无色的毫毛，可以用来变成任何你想要的东西（transform）。\n");
    set("unit", "把");
    set("value",150000);
  }
  set("no_drop",1);
  set("no_get",1);
  set("no_sell",1);
  setup();
}


int init ()  
{   
  add_action ("do_transform", "transform");
   return 1;
}


