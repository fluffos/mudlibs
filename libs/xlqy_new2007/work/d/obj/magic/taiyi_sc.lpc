#include <ansi.h>
inherit ITEM;

void create() {
  set_name(HIG "太乙仙法卷轴" NOR, ({ "magic scroll", "scroll" }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "这是张魔法卷轴，运用灵力可以驱动它释放出太乙仙法的威力(baxian,zhenhuo,wuxing)。\n");
    set("unit", "卷");
    set("value", 5000);
    set("fashu", "taiyi");
    set("cast_item/baxian", 1);
    set("cast_item/zhenhuo", 1);
    set("cast_item/wuxing", 1);
  }
  setup();
}
