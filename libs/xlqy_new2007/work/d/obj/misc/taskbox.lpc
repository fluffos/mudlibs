#include <ansi.h>
inherit ITEM;

void create() {
  set_name(HIM "魔盒" NOR, ({ "magic box", "box" }));
  set_weight(200);
  set_max_encumbrance(75000);
  if (clonep())
    set_default_object(__FILE__);
  else {

    set("unit", "只");
    set("long", "一只具有神秘力量的魔盒，可以合成(combine)你想要的东西，你也可以把它当作临时的存储箱。\n");
    set("no_drop", 1);
    set("no_get", 1);
    set("no_give", 1);
    set("value", 10000);


  }
  setup();
}
int is_container() { return 1; }

void init() {
  if (this_player() == environment())
    add_action("do_combine", "combine");

}

int do_combine(string arg) {
  int i, j1 = 0, j2 = 0, j3 = 0, j4 = 0, j5 = 0, j6 = 0, j7 = 0, j8 = 0, j9 = 0, ja = 0;
  object obj, me, *inv;
  object k1, k2, k3, k4, k5, k6, k7, k8, k9, k0;
  string location;
  object *obj_list;
  me = this_player();
  inv = all_inventory(this_object());

  if (me->query("mana") < 1000)
    return notify_fail("你的法力不足，无法驱动魔盒的魔力合成物品。\n");
  if (!arg)
    return notify_fail("你想要合成什么物品呀？\n");
  if (arg != "waist" && arg != "ring" && arg != "kui" && arg != "exp" && arg != "dx")
    return notify_fail("你想要合成的物品暂时不能提供噢(参见help tasks)。\n");

  message_vision(HIB "$N手持魔盒，闭着眼睛，嘴里默默的念着＃￥％＃◎％％￥（※……×！\n" NOR, me);
  me->add("mana", -500);
  if (arg == "waist") {
    for (i = 0; i < sizeof(inv); i++) {
      if (inv[i]->query("id") == "tong jian") { j1 = 1; k1 = inv[i]; }
      if (inv[i]->query("id") == "big axe") { j2 = 1; k2 = inv[i]; }
      if (inv[i]->query("id") == "jinjiao jian") { j3 = 1; k3 = inv[i]; }
      if (inv[i]->query("id") == "X spear") { j4 = 1; k4 = inv[i]; }
      if (inv[i]->query("id") == "lunhui bang") { j5 = 1; k5 = inv[i]; }
      if (inv[i]->query("id") == "fenglei jian") { j6 = 1; k6 = inv[i]; }
      if (inv[i]->query("id") == "mutao jian") { j7 = 1; k7 = inv[i]; }
      if (inv[i]->query("id") == "xiuhua zhen") { j8 = 1; k8 = inv[i]; }
      if (inv[i]->query("name") == "朱笔") { j9 = 1; k9 = inv[i]; }
      if (inv[i]->query("id") == "mu dizi") { ja = 1; k0 = inv[i]; }
    }

    if (j1 && j2 && j3 && j4 && j5 && j6 && j7 && j8 && j9 && ja) {
      destruct(k1);
      destruct(k2);
      destruct(k3);
      destruct(k4);
      destruct(k5);
      destruct(k6);
      destruct(k7);
      destruct(k8);
      destruct(k9);
      destruct(k0);
      me->add("daoxing", 2000);
      me->add("combat_exp", 2000);
      me->add("potential", 1000);


      location = "/d/obj/misc/warlord";
      obj_list = children(location);
      if (!sizeof(obj_list))

      {
        obj = new(__DIR__ "warlord");
        obj->move(me);
        CHANNEL_D->do_channel(me, "rumor", "听闻$N合成了传说中的" + HIR "战神腰带!" NOR);
      } else {
        obj = new(__DIR__ "hero");
        obj->move(me);
        CHANNEL_D->do_channel(me, "rumor", "听闻$N合成了传说中的" + HIR "英雄腰带!" NOR);
      }

    } else
      message_vision("$N把手里的几件东西放入魔盒摆弄了几下．\n", this_player());
    return 1;
  }
  if (arg == "kui") {
    for (i = 0; i < sizeof(inv); i++) {
      if (inv[i]->query("id") == "tan zhu") { j1 = 1; k1 = inv[i]; }
      if (inv[i]->query("id") == "sha mao") { j2 = 1; k2 = inv[i]; }
      if (inv[i]->query("id") == "du dou") { j3 = 1; k3 = inv[i]; }
      if (inv[i]->query("id") == "yunguang po") { j4 = 1; k4 = inv[i]; }
      if (inv[i]->query("id") == "xiang nang") { j5 = 1; k5 = inv[i]; }
      if (inv[i]->query("id") == "hupi mao") { j6 = 1; k6 = inv[i]; }
      if (inv[i]->query("id") == "shou jin") { j7 = 1; k7 = inv[i]; }
      if (inv[i]->query("id") == "zijin kui") { j8 = 1; k8 = inv[i]; }
      if (inv[i]->query("id") == "yan dou") { j9 = 1; k9 = inv[i]; }
      if (inv[i]->query("id") == "bao nang") { ja = 1; k0 = inv[i]; }

    }
    if (j1 && j2 && j3 && j4 && j5 && j6 && j7 && j8 && j9 && ja) {
      destruct(k1);
      destruct(k2);
      destruct(k3);
      destruct(k4);
      destruct(k5);
      destruct(k6);
      destruct(k7);
      destruct(k8);
      destruct(k9);
      destruct(k0);
      me->add("daoxing", 2000);
      me->add("combat_exp", 2000);
      me->add("potential", 1000);

      location = "/d/obj/misc/leizhu";
      obj_list = children(location);
      if (!sizeof(obj_list)) {
        obj = new(__DIR__ "leizhu");
        obj->move(me);

        CHANNEL_D->do_channel(me, "rumor", "听闻$N合成了传说中的" + HIW "泪珠之盔!" NOR);
      } else {
        obj = new(__DIR__ "yanlei");
        obj->move(me);

        CHANNEL_D->do_channel(me, "rumor", "听闻$N合成了传说中的" + HIW "泪水之盔!" NOR);

      }
    } else
      message_vision("$N把手里的几件物品放入魔盒摆弄了几下．\n", this_player());
    return 1;


  }
  if (arg == "ring") {


    for (i = 0; i < sizeof(inv); i++) {
      if (inv[i]->query("id") == "wen shu") { j1 = 1; k1 = inv[i]; }
      if (inv[i]->query("id") == "feng lingzhu") { j2 = 1; k2 = inv[i]; }
      if (inv[i]->query("id") == "fengwei jianling") { j3 = 1; k3 = inv[i]; }
      if (inv[i]->query("id") == "shanyang huzi") { j4 = 1; k4 = inv[i]; }
      if (inv[i]->query("id") == "huolong biao") { j5 = 1; k5 = inv[i]; }
      if (inv[i]->query("id") == "liushu zhi") { j6 = 1; k6 = inv[i]; }
      if (inv[i]->query("id") == "feng kou dai") { j7 = 1; k7 = inv[i]; }
      if (inv[i]->query("id") == "nian zhu") { j8 = 1; k8 = inv[i]; }
      if (inv[i]->query("id") == "dinghai zhu") { j9 = 1; k9 = inv[i]; }
      if (inv[i]->query("id") == "hunyuan dou") { ja = 1; k0 = inv[i]; }
    }
    if (j1 && j2 && j3 && j4 && j5 && j6 && j7 && j8 && j9 && ja) {
      destruct(k1);
      destruct(k2);
      destruct(k3);
      destruct(k4);
      destruct(k5);
      destruct(k6);
      destruct(k7);
      destruct(k8);
      destruct(k9);
      destruct(k0);
      me->add("daoxing", 2000);
      me->add("combat_exp", 2000);
      me->add("potential", 1000);

      location = "/d/obj/misc/rain";
      obj_list = children(location);
      if (!sizeof(obj_list)) {
        obj = new(__DIR__ "rain");
        obj->move(me);

        CHANNEL_D->do_channel(me, "rumor", "听闻$N合成了传说中的" + HIC "细雨之戒!" NOR);
      } else {
        obj = new(__DIR__ "xiyu");
        obj->move(me);

        CHANNEL_D->do_channel(me, "rumor", "听闻$N合成了传说中的" + HIC "雨水之戒!" NOR);
      }
    } else
      message_vision("$N把手里的几件物品放入魔盒摆弄了几下．\n", this_player());
    return 1;

  }
  if (arg == "exp") {

    for (i = 0; i < sizeof(inv); i++) {
      if (inv[i]->query("id") == "di qi") { j1 = 1; k1 = inv[i]; }
      if (inv[i]->query("id") == "yin jiuhu") { j2 = 1; k2 = inv[i]; }
      if (inv[i]->query("id") == "hua qunzi") { j3 = 1; k3 = inv[i]; }
      if (inv[i]->query("id") == "ren xue") { j4 = 1; k4 = inv[i]; }
      if (inv[i]->query("id") == "shui hu") { j5 = 1; k5 = inv[i]; }
      if (inv[i]->query("id") == "jiudai") { j6 = 1; k6 = inv[i]; }
      if (inv[i]->query("id") == "yu linglong") { j7 = 1; k7 = inv[i]; }
      if (inv[i]->query("id") == "jingtang mu") { j8 = 1; k8 = inv[i]; }
      if (inv[i]->query("id") == "bing dai") { j9 = 1; k9 = inv[i]; }
    }
    if (j1 && j2 && j3 && j4 && j5 && j6 && j7 && j8 && j9) {
      destruct(k1);
      destruct(k2);
      destruct(k3);
      destruct(k4);
      destruct(k5);
      destruct(k6);
      destruct(k7);
      destruct(k8);
      destruct(k9);
      me->add("combat_exp", 6000);
      me->add("potential", 3000);

      CHANNEL_D->do_channel(
        me,
        "rumor",
        "听闻$N成功破解物品任务，" + HIW "武学" + HIM "和" + HIW "潜能" NOR + HIM "有所进境！" NOR
      );
    } else
      message_vision("$N把手里的几件物品放入魔盒摆弄了几下．\n", this_player());
    return 1;

  }
  if (arg == "dx") {


    for (i = 0; i < sizeof(inv); i++) {
      if (inv[i]->query("id") == "renpi zhangben") { j1 = 1; k1 = inv[i]; }
      if (inv[i]->query("id") == "lu an") { j2 = 1; k2 = inv[i]; }
      if (inv[i]->query("id") == "jie chi") { j3 = 1; k3 = inv[i]; }
      if (inv[i]->query("id") == "lan yuwang") { j4 = 1; k4 = inv[i]; }
      if (inv[i]->query("id") == "yizhu xiang") { j5 = 1; k5 = inv[i]; }
      if (inv[i]->query("id") == "chu tou") { j6 = 1; k6 = inv[i]; }
      if (inv[i]->query("id") == "zhao pai") { j7 = 1; k7 = inv[i]; }
      if (inv[i]->query("id") == "ganmian zhang") { j8 = 1; k8 = inv[i]; }
      if (inv[i]->query("id") == "yu xian") { j9 = 1; k9 = inv[i]; }
    }
    if (j1 && j2 && j3 && j4 && j5 && j6 && j7 && j8 && j9) {
      destruct(k1);
      destruct(k2);
      destruct(k3);
      destruct(k4);
      destruct(k5);
      destruct(k6);
      destruct(k7);
      destruct(k8);
      destruct(k9);
      me->add("daoxing", 6000);
      me->add("potential", 3000);

      CHANNEL_D->do_channel(
        me,
        "rumor",
        "听闻$N成功破解物品任务，" + HIY "道行" + HIM "和" + HIY "潜能" NOR + HIM "增加了！" NOR
      );
    } else
      message_vision("$N把手里的几件物品放入魔盒摆弄了几下．\n", this_player());
    return 1;

  }
  return 1;

}
