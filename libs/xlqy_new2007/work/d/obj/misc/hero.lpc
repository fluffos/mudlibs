#include <armor.h>
#include <ansi.h>

inherit WAIST;

void create()
{

        set_name(HIR"英雄腰带"NOR, ({ "hero waist", "waist" }));
	set("weight", 400);
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("unit", "件");
		set("value", 200000);
		set("no_sell",1);
	//	set("no_give",1);
		set("no_drop",1);
		set("no_get",1);
		set("can_putin_box",1);
		 set("replace_file", __DIR__"hero");
		set("long",HIG"这是一件神秘的腰带，能带给你无穷的力量。\n"NOR);
		set("material", "gold");
		set("armor_prop/armor", 30);
		set("armor_prop/strength", 10);
		
	    }
	   
	setup();
}
