#include <armor.h>
#include <ansi.h>


inherit NECK;


void create() {
  set_name(HIC "玉佛珠" NOR, ({ "jade fozhu", "fozhu" }));
  set("long", "据说是达摩祖师修行时所持的佛珠。\n");
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {

    set("unit", "串");
    set("long", "据说是达摩祖师修行时所持的佛珠。\n");
    set("no_put", 1);
    set("value", 0);

    set("no_sell", 1);
    set("material", "jade");
    //      set("female_only", "只有MM才能戴的噢^_^");
    set("armor_prop/armor", 40);
    set("armor_prop/dodge", 20);
    set("armor_prop/spells", 15);
  }
  setup();
}
