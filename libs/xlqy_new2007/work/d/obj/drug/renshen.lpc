#include <ansi.h>

inherit ITEM;

void create() {
  set_name(HIG "人参" NOR, ({ "ren shen", "shen" }));
  set_weight(120);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "只");
    set("long", "能使人恢复内力。\n");
    set("value", 2000);
    //set("no_sell", 1);
    set("drug_type", "补品");
  }
  setup();
}

void init() {
  add_action("do_eat", "eat");
}

int do_eat(string arg) {
  object me = this_player();
  if (arg != "ren shen" && arg != "shen")
    return notify_fail("你要吃什么？\n");

  me->set("force", (int)me->query("max_force") + random(100));
  message_vision(HIG "$N吃下一只人参。\n" NOR, me);
  tell_object(me, "顿时你觉得气息充足。\n");
  destruct(this_object());
  return 1;
}
