// please let me know before changing...weiqi980417

#include <ansi.h>

inherit ITEM;

int do_eat(string);
string give_reward(object me);
void init();

void init()
{
      if(this_player()==environment())
        add_action("do_eat", "eat");
}

void create()
{
        set_name(HIW "人参果" NOR, ({"renshen guo", "renshenguo", "guo"}));
//        set("no_sell","这种宝物小当实在难辩真伪，您还是去别处吧!\n");
		set("if_real","true");
        set_weight(100);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "枚");
                set("long", "白白胖胖的一枚人参果。三千年一开花，三千年一结果，再三千年才得熟，实是天地间的灵宝。\n");
                set("value", 5000000);
                set("drug_type", "补品");
        }
  
        set("is_monitored",1);
        setup();
}

int do_eat(string arg)
{
        int howmany;

        object me = this_player();
  
        if (!id(arg)) return notify_fail("你要吃什么？\n");

	// yudian
	// will have problem if eat in those rooms.
	if(environment(me)->query("alternative_die"))
	    return notify_fail("你不能在这儿吃人参果。\n");

        howmany = (int)me->query("rsg_eaten");
  
        me->set("food", (int)me->max_food_capacity());

                if( howmany <= 100 ) me->add_maximum_force(20);
                if( howmany <= 100 ) me->add_maximum_mana(20);

        me->set("rsg_eaten", howmany+1);

        message_vision(HIW "$N把人参果往嘴里一塞，忍不住大叫一声：人参果啊人参果，不愧是人参果！ \n说罢兴奋得都快晕了过去。\n" NOR, me);  
        if( me->query("rsg_eaten") >= 36 )
        {
                me->announce_live_forever( me->query("name")+"坚持不懈地吃人参果，终于修成了不堕轮回，从此跳出三界外，不在五行中，永无生死大限了！" );
        }
 if(random(me->query_kar()/5+me->query("per")/4+me->query("con")/3+me->query("spi")/3)>13)
 	give_reward(me);
 if (!wizardp(me)||random(36))
         me->unconcious();
        destruct(this_object());

        return 1;
}
string give_reward(object me) {
  mapping skill=me->query_skills();
  string *skillnames;
  string selected,msg;
  int level, inc=1,pot;

  if (!skill) return "none";

  skillnames=keys(skill);
  if(sizeof(skillnames) < 1)
   return "none";
  selected=skillnames[random(sizeof(skillnames))];

  level=skill[selected];
if (level < 1) return "none";
  if(level<120) {
      inc=0;
  } else if(level<210) {
      inc=random(2);
  } else if(level<350) {
      inc=random(3);
  } else {
      inc=random(4);
  }

  if(!inc) {
    me->set_skill(selected,level+1);
    tell_object(me,"你得到了一级"+ to_chinese(selected) + "。\n");
    msg="听说"+HIR+ me->query("name")+ NOR+HIM"吃人参果，武功大进，得到一级"+HIW+to_chinese(selected)+NOR+HIM+"！\n"+NOR;
				CHANNEL_D->do_channel(this_object(),"rumor",msg);
    return selected;
  }
else
  return "none";
}

