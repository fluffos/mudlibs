//绿宝石合成引子，gamer@88
#include <ansi.h>
#include <dbase.h>
#include <armor.h>

inherit F_UNIQUE;
inherit NECK;

int do_wear(string arg);
int do_remove(string arg);
object offensive_target(object me);
int do_combine(string arg);

void create()
{
        set_name(HIG "风灵珠" NOR, ({"feng lingzhu", "fengzhu"}) );
        set_weight(200);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "颗");
                set("material", "crystal");
                set("value",10000);
		set("no_steal",1);
                set("no_drop", "如此宝贵的宝物再世难求啊。\n");
                set("no_give", "这种稀世之宝怎么能轻易送人呢?\n");
                set("no_sell", "卖?这种稀世之宝谁买得起啊!\n");
                set("long","传说中的五行宝珠之一，佩之可避风吹，并可发出风系法术。\n为祈雨所必需之物。");
                set("bb",1);
                set("replace_file", "/d/obj/flower/rose");
                set("armor_prop/armor", 1);
                set("spells/feng", 1);
        }
        setup();
}

int init()
{
        add_action("do_wear","wear");
        add_action("do_remove", "remove");
        add_action("do_combine","combine");
        unique::init();
		if(userp(this_player()) && !query("had_called")) 
		{
			set("had_called",1);
			remove_call_out("self_dest");
			call_out("self_dest",7200+random(600));
		}

        return 1;
}

// This function selects a random target for offensive spells/functions.
object offensive_target(object me)
{
        int sz;
        object *enemy;

        enemy = me->query_enemy();
        if( !enemy || !arrayp(enemy) ) return 0;

        sz = sizeof(enemy);
        if( sz > 4 ) sz = 4;

        if( sz > 0 ) return enemy[random(sz)];
        else return 0;
}

int do_wear (string arg)
{
  object me = this_player();
  object zhu = this_object();
  string name = zhu->query("name");
  string msg;

if(arg!="all" && arg != "fengzhu" && arg != "feng lingzhu")
    return notify_fail("你要佩带什么？\n");
  msg = "$N戴上一颗"+name+"，绿色的风灵珠仿佛没有重量，随风而舞。\n"; 
  zhu->set("wear_msg",msg);
remove_call_out("fengzhuconditions");
call_out("fengzhuconditions",5,me,zhu);
  return 0;
}

int do_remove (string arg)
{
  object me = this_player();
  object zhu = this_object();
  string name = zhu->query("name");
  string msg;
if ( arg != "all" && arg != "fengzhu" && arg != "feng lingzhu")
    return notify_fail("你要摘掉什么？\n");

  msg = "$N将"+name+"轻轻地摘下来……\n"; 
  zhu->set("unequip_msg",msg);
  remove_call_out("fengzhuconditions");
  return 0;
}

void fengzhuconditions(object who,object ob)
{
string type;
     object target;
     int ap,dp,damage;
     string msg;
          
type = ob->query("armor_type");
if( who->query_temp("armor/" + type) && ob->query("equipped")!="worn")
return;
     if( who->is_fighting())
     {
        target = offensive_target(who);
        if( ! target ) return ;
        if( ! present( target,environment(who)) ) return ;

        msg = HIY"风灵珠发出呜呜的声音，$N耳中突然响起银铃般的笑声，只见铁扇公主手持芭蕉扇，\n
双手轻摇，长衫飘飘，说不出的潇洒快活。却有一股疾风朝$n刮去\n"NOR;
//divid by 10;

                ap = 2000000;
                dp = target->query("combat_exp");
                        
                        
                if( random(ap + dp) > dp )
                 {
                        damage = 500+random(300);
                        damage -= (int)target->query("max_mana") / 10 + random((int)target->query("eff_sen") / 5);
                        damage -= random((int)target->query("mana_factor"));

                        if( damage > 0 ) 
                        {
                                msg += HIC "结果$n躲避不及，被风迷了双眼，动弹不得！\n" NOR;

                                target->start_busy(3);
                        } 
            else
//here, cast failed and the target's mana_factor will be added to the previous
//damage to hurt yourself:(...note damage<0.
                msg += HIC "\n谁知$n毫无反应。你反而被风迷了双眼，动弹不得！\n" NOR;   
                who->start_busy(1);		// alading 2002-6-28
                }
                else
                        msg += "但是被$n躲开了。\n";

                message_vision(msg, who, target); 
        }
call_out("fengzhuconditions",7,who,ob);
}

void self_dest()
{
    object env=environment(this_object());
    if(env)
		tell_object(env, HIY"只见呼的一声,风灵珠消失在天边！\n");
    destruct(this_object());
}
int do_combine(string arg)
{
	int num; //绿宝石数量
	object who,*inv;
	object *g,js;
	who = this_player();
	if(environment(this_object())!= who)
		return 0;
	num = 0;
	if(!arg) 
	{
		tell_object(who,"你要用风珠来合成什么宝石？（微瑕、普通、无暇、完美)\n");
		return 1;
	}
	if(this_object()->query("equipped") =="worn")
	{
			tell_object(who,"宝珠必须摘下才能炼石！\n");	
			return 1;
			
	} 
	if(arg == "微瑕")
	{
		if(who->query("max_mana") < 1200)
		{
				tell_object(who,"你的法力修为不够，无法激发出宝石蕴涵的能量！\n",);	
				return 1;	
		}
		if(who->query("mana") < 1200)
		{
				tell_object(who,"你的法力不足，难以充分激发出宝石中的能量！\n",);	
				return 1;	
		}
		
		inv = all_inventory(who);
			
		for(int i = 0 ;i < sizeof(inv) ; i++)
		{
			if(inv[i]->query("id") == "Chipped baoshi"&&inv[i]->query("color") == "g")
				{	
					num ++;
					
				}
				
		}
		
		
		if(num > 4)
		{
		  who->add("mana",-600);
		  num = 5;	
		for(int i = 0 ;i < sizeof(inv) ; i++)
		{
			if(inv[i]->query("id") == "Chipped baoshi"&&inv[i]->query("color") == "g"&&num )
				{	
					destruct(inv[i]);
					num --;
					
				}
				
		}	
			js = new("/d/baoshi/obj/xc_g");
			js->move(who);
			destruct(this_object());
					return 1;	
			
			
		}
		else {
			
		tell_object(who,"宝石数量不足，无法炼制！\n",);	
				return 1;	
			
		}	
			
		
	}
	else if(arg == "普通")
	{
		if(who->query("max_mana") < 1800)
		{
				tell_object(who,"你的法力修为不够，无法激发出宝石蕴涵的能量！\n",);	
				return 1;	
		}
		if(who->query("mana") < 1800)
		{
				tell_object(who,"你的法力不足，难以充分激发出宝石中的能量！\n",);	
				return 1;	
		}
		
		inv = all_inventory(who);
			
		for(int i = 0 ;i < sizeof(inv) ; i++)
		{
			if(inv[i]->query("id") == "Flawed baoshi"&&inv[i]->query("color") == "g")
				{	
					num ++;
					
				}
				
		}
		
		
		if(num > 5)
		{
		  message_vision("搞定！描述以后再说！\n",who);
		  who->add("mana",-900);
		  num = 6;	
		for(int i = 0 ;i < sizeof(inv) ; i++)
		{
			if(inv[i]->query("id") == "Flawed baoshi"&&inv[i]->query("color") == "g"&&num )
				{	
					destruct(inv[i]);
					num --;
					
				}
				
		}	
			js = new("/d/baoshi/obj/no_g");
			js->move(who);
			destruct(this_object());
					return 1;	
			
			
		}
		else {
			
		tell_object(who,"宝石数量不足，无法炼制！\n",);	
				return 1;	
			
		}	
			
		
	}
	else if(arg == "无暇")
	{
		if(who->query("max_mana") < 2700)
		{
				tell_object(who,"你的法力修为不够，无法激发出宝石蕴涵的能量！\n",);	
				return 1;	
		}
		if(who->query("mana") < 2700)
		{
				tell_object(who,"你的法力不足，难以充分激发出宝石中的能量！\n",);	
				return 1;	
		}
		
		inv = all_inventory(who);
			
		for(int i = 0 ;i < sizeof(inv) ; i++)
		{
			if(inv[i]->query("id") == "Normal baoshi"&&inv[i]->query("color") == "g")
				{	
					num ++;
					
				}
				
		}
		
		
		if(num > 8)
		{
		  message_vision("搞定！描述以后再说！\n",who);
		  who->add("mana",-1200);
		  num = 9;	
		for(int i = 0 ;i < sizeof(inv) ; i++)
		{
			if(inv[i]->query("id") == "Normal baoshi"&&inv[i]->query("color") == "g"&&num )
				{	
					destruct(inv[i]);
					num --;
					
				}
				
		}	
			js = new("/d/baoshi/obj/wx_g");
			js->move(who);
			destruct(this_object());
					return 1;	
			
			
		}
		else {
			
		tell_object(who,"宝石数量不足，无法炼制！\n",);	
				return 1;	
			
		}	
			
		
	}
	else if(arg == "完美")
	{
		if(who->query("max_mana") < 4000)
		{
				tell_object(who,"你的法力修为不够，无法激发出宝石蕴涵的能量！\n",);	
				return 1;	
		}
		if(who->query("mana") < 4000)
		{
				tell_object(who,"你的法力不足，难以充分激发出宝石中的能量！\n",);	
				return 1;	
		}
		
		inv = all_inventory(who);
			
		for(int i = 0 ;i < sizeof(inv) ; i++)
		{
			if(inv[i]->query("id") == "Flawless baoshi"&&inv[i]->query("color") == "g")
				{	
					num ++;
					
				}
				
		}
		
		
		if(num > 5)
		{
		  message_vision("搞定！描述以后再说！\n",who);
		   message("channel:rumor",RED+"【谣言】某人："+who->query("name")+"得到一块完美绿宝石了！\n"+NOR,users() );
		  who->add("mana",-2100);
		  num = 6;	
		for(int i = 0 ;i < sizeof(inv) ; i++)
		{
			if(inv[i]->query("id") == "Flawless baoshi"&&inv[i]->query("color") == "g"&&num )
				{	
					destruct(inv[i]);
					num --;
					
				}
				
		}	
			js = new("/d/baoshi/obj/wm_g");
			js->move(who);
			destruct(this_object());
					return 1;	
			
			
		}
		else {
			
		tell_object(who,"宝石数量不足，无法炼制！\n",);	
				return 1;	
			
		}	
			
		
	}
	else 
	{
		tell_object(who,"你要用风珠来合成什么宝石？（微瑕、普通、无暇、完美)\n");
		return 1;
	}

}
