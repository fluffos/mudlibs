#include <ansi.h>

#include <dbase.h>

#include <armor.h>



inherit F_UNIQUE;

inherit NECK;



int do_wear(string arg);

int do_remove(string arg);
int do_combine(string arg);
object offensive_target(object me);



void create()

{

        set_name(HIB "雷灵珠" NOR, ({"lei lingzhu", "leizhu"}) );

        set_weight(200);

        if( clonep() )

                set_default_object(__FILE__);

        else {

                set("unit", "颗");

                set("material", "crystal");

                set("value",10000);

set("no_steal",1);

                set("no_drop", "如此宝贵的武器再世难求啊。\n");

                set("no_give", "这种稀世之宝怎么能轻易送人呢?\n");

                set("no_sell", "卖?这种稀世之宝谁买得起啊!\n");

                set("long","传说中的五行宝珠之一，佩之可避雷击，并可发出雷击法术。\n为祈雨所必需之物。");

                set("bb",1);

                set("replace_file", "/d/obj/flower/rose");

                set("armor_prop/armor", 1);

                set("spells/thunder", 1);

        }

        setup();

}



int init()

{

        add_action("do_wear","wear");

        add_action("do_remove", "remove");
	add_action("do_combine","combine");
        unique::init();

		if(userp(this_player()) && !query("had_called")) 
		{	
			set("had_called",1);
			remove_call_out("self_dest");
			call_out("self_dest",7200+random(600));
		}
        return 1;
}



// This function selects a random target for offensive spells/functions.

object offensive_target(object me)

{

        int sz;

        object *enemy;



        enemy = me->query_enemy();

        if( !enemy || !arrayp(enemy) ) return 0;



        sz = sizeof(enemy);

        if( sz > 4 ) sz = 4;



        if( sz > 0 ) return enemy[random(sz)];

        else return 0;

}



int do_wear (string arg)

{

  object me = this_player();

  object zhu = this_object();

  string name = zhu->query("name");

  string msg;



if (arg != "all" && arg != "leizhu" &&  arg != "lei lingzhu" )

    return notify_fail("你要佩带什么？\n");

  msg = "$N戴上一颗"+name+"，不禁精神一振。\n"; 

  zhu->set("wear_msg",msg);

remove_call_out("leizhuconditions");

call_out("leizhuconditions",5,me,zhu);

  return 0;

}



int do_remove (string arg)

{

  object me = this_player();

  object zhu = this_object();

  string name = zhu->query("name");

  string msg;



if (arg != "all" && arg != "leizhu" && arg != "lei lingzhu")

    return notify_fail("你要摘掉什么？\n");



  msg = "$N将"+name+"轻轻地摘下来……\n"; 

  zhu->set("unequip_msg",msg);

  remove_call_out("leizhuconditions");

  return 0;

}



void leizhuconditions(object who,object ob)

{

     object target;

     int ap,dp,damage;

     string msg;

string type;

type = ob->query("armor_type");

if( who->query_temp("armor/" + type) && ob->query("equipped")!="worn")

return;

        target = offensive_target(who);

     if( who->is_fighting() &&target) //by xlwang

     {

  if( ! target ) return ;      

 if( ! present( target,environment(who)) ) return ;    

        msg = HIC

"\n雷灵珠突发异彩，半空走出位尖头鹰鼻的雷公，左手执斧，右手提锥。

斧锥相击，在$n的头顶炸起一片响雷！\n"NOR;



        ap = 1500000;

        dp = target->query("combat_exp");

        if( random(ap + dp) > dp )

           {

                damage = random(600) + 200;

                damage -= (int)target->query("max_mana") / 10 + random((int)target->query("eff_sen") / 5);                                              

                damage -= random((int)target->query("mana_factor"));

//here we can see if 2 players are at same status, the attacker has higher chance.

                if( damage > 0 ) 

                {

                msg +=  HIR "\n$n被雷声震的眼冒金星，心神不定，差点跌倒在地！\n" NOR;

//finally damage also depends on enabled spells level.

                target->receive_damage("sen", damage,who,"jin");

                target->receive_wound("sen", damage/2,who);

                }

            else 

//here, cast failed and the target's mana_factor will be added to the previous 

//damage to hurt yourself:(...note damage<0.

                msg += HIC "\n谁知$n毫无反应。\n" NOR;
		
           } 

        else

               msg += "\n谁知$n毫无反应，依旧一心一意地和$N战斗。\n";



        message_vision(msg, who, target);

    }

call_out("leizhuconditions",7,who,ob);

}


void self_dest()
{
    object env=environment(this_object());
    if(env)
		tell_object(env, HIY"只见呼的一声,雷灵珠消失在天边！\n");
    destruct(this_object());
}
int do_combine(string arg)
{
	int num; //宝石数量
	object who,*inv;
	object *g,js;
	who = this_player();
	if(environment(this_object())!= who)
		return 0;
	num = 0;
	if(!arg) 
	{
		tell_object(who,"你要用雷珠来合成什么宝石？（微瑕、普通、无暇、完美)\n");
		return 1;
	}
	if(this_object()->query("equipped") =="worn")
	{
			tell_object(who,"宝珠必须摘下才能炼石！\n");	
			return 1;
			
	} 
	if(arg == "微瑕")
	{
		if(who->query("max_mana") < 1200)
		{
				tell_object(who,"你的法力修为不够，无法激发出宝石蕴涵的能量！\n",);	
				return 1;	
		}
		if(who->query("mana") < 1200)
		{
				tell_object(who,"你的法力不足，难以充分激发出宝石中的能量！\n",);	
				return 1;	
		}
		
		inv = all_inventory(who);
			
		for(int i = 0 ;i < sizeof(inv) ; i++)
		{
			if(inv[i]->query("id") == "Chipped baoshi"&&inv[i]->query("color") == "b")
				{	
					num ++;
					
				}
				
		}
		
		
		if(num > 4)
		{
		  who->add("mana",-600);
		  num = 5;	
		for(int i = 0 ;i < sizeof(inv) ; i++)
		{
			if(inv[i]->query("id") == "Chipped baoshi"&&inv[i]->query("color") == "b"&&num )
				{	
					destruct(inv[i]);
					num --;
					
				}
				
		}	
			js = new("/d/baoshi/obj/xc_b");
			js->move(who);
			destruct(this_object());
					return 1;	
			
			
		}
		else {
			
		tell_object(who,"宝石数量不足，无法炼制！\n",);	
				return 1;	
			
		}	
			
		
	}
	else if(arg == "普通")
	{
		if(who->query("max_mana") < 1800)
		{
				tell_object(who,"你的法力修为不够，无法激发出宝石蕴涵的能量！\n",);	
				return 1;	
		}
		if(who->query("mana") < 1800)
		{
				tell_object(who,"你的法力不足，难以充分激发出宝石中的能量！\n",);	
				return 1;	
		}
		
		inv = all_inventory(who);
			
		for(int i = 0 ;i < sizeof(inv) ; i++)
		{
			if(inv[i]->query("id") == "Flawed baoshi"&&inv[i]->query("color") == "b")
				{	
					num ++;
					
				}
				
		}
		
		
		if(num > 5)
		{
		  message_vision("搞定！描述以后再说！\n",who);
		  who->add("mana",-900);
		  num = 6;	
		for(int i = 0 ;i < sizeof(inv) ; i++)
		{
			if(inv[i]->query("id") == "Flawed baoshi"&&inv[i]->query("color") == "b"&&num )
				{	
					destruct(inv[i]);
					num --;
					
				}
				
		}	
			js = new("/d/baoshi/obj/no_b");
			js->move(who);
			destruct(this_object());
					return 1;	
			
			
		}
		else {
			
		tell_object(who,"宝石数量不足，无法炼制！\n",);	
				return 1;	
			
		}	
			
		
	}
	else if(arg == "无暇")
	{
		if(who->query("max_mana") < 2700)
		{
				tell_object(who,"你的法力修为不够，无法激发出宝石蕴涵的能量！\n",);	
				return 1;	
		}
		if(who->query("mana") < 2700)
		{
				tell_object(who,"你的法力不足，难以充分激发出宝石中的能量！\n",);	
				return 1;	
		}
		
		inv = all_inventory(who);
			
		for(int i = 0 ;i < sizeof(inv) ; i++)
		{
			if(inv[i]->query("id") == "Normal baoshi"&&inv[i]->query("color") == "b")
				{	
					num ++;
					
				}
				
		}
		
		
		if(num > 8)
		{
		  message_vision("搞定！描述以后再说！\n",who);
		  who->add("mana",-1200);
		  num = 9;	
		for(int i = 0 ;i < sizeof(inv) ; i++)
		{
			if(inv[i]->query("id") == "Normal baoshi"&&inv[i]->query("color") == "b"&&num )
				{	
					destruct(inv[i]);
					num --;
					
				}
				
		}	
			js = new("/d/baoshi/obj/wx_b");
			js->move(who);
			destruct(this_object());
					return 1;	
			
			
		}
		else {
			
		tell_object(who,"宝石数量不足，无法炼制！\n",);	
				return 1;	
			
		}	
			
		
	}
	else if(arg == "完美")
	{
		if(who->query("max_mana") < 4000)
		{
				tell_object(who,"你的法力修为不够，无法激发出宝石蕴涵的能量！\n",);	
				return 1;	
		}
		if(who->query("mana") < 4000)
		{
				tell_object(who,"你的法力不足，难以充分激发出宝石中的能量！\n",);	
				return 1;	
		}
		
		inv = all_inventory(who);
			
		for(int i = 0 ;i < sizeof(inv) ; i++)
		{
			if(inv[i]->query("id") == "Flawless baoshi"&&inv[i]->query("color") == "b")
				{	
					num ++;
					
				}
				
		}
		
		
		if(num > 5)
		{
		  message_vision("搞定！描述以后再说！\n",who);
		   message("channel:rumor",RED+"【谣言】某人："+who->query("name")+"得到一块完美蓝宝石了！\n"+NOR,users() );
		  who->add("mana",-2100);
		  num = 6;	
		for(int i = 0 ;i < sizeof(inv) ; i++)
		{
			if(inv[i]->query("id") == "Flawless baoshi"&&inv[i]->query("color") == "b"&&num )
				{	
					destruct(inv[i]);
					num --;
					
				}
				
		}	
			js = new("/d/baoshi/obj/wm_b");
			js->move(who);
			destruct(this_object());
					return 1;	
			
			
		}
		else {
			
		tell_object(who,"宝石数量不足，无法炼制！\n",);	
				return 1;	
			
		}	
			
		
	}
	else 
	{
		tell_object(who,"你要用雷珠来合成什么宝石？（微瑕、普通、无暇、完美)\n");
		return 1;
	}

}



