// jiudai.c  酒袋
#include <ansi.h>
inherit ITEM;
void init();

void create()
{
	set_name("龟鳖丸", ({"wan"}));
	set_weight(10);
	if (clonep())
		set_default_object(__FILE__);
	else {
	set("long", "水陆大会指定特效药龟鳖丸。\n");
	set("unit", "颗");
	set("no_get",1);
	set("no_drop",1);
		}
}
void init()
{
	 add_action("do_eat", "eat");
}

int do_eat(string arg)
{
	object me = this_player();
	if (arg!="wan") return notify_fail("你要吃什么？\n");
	me->set("eff_sen", (int)me->query("max_sen"));
	me->set("eff_kee", (int)me->query("max_kee"));
	me->set("mana", (int)me->query("max_mana")*2);	
	me->set("force", (int)me->query("max_force")*2);
	me->set("food", (int)me->max_food_capacity());
	me->set("water", (int)me->max_water_capacity());
	message_vision("$N吃下了一粒水陆大会指定产品：龟鳖丸，发觉一股仙气自丹田缓缓遍布全身了！\n",me);
	tell_object(me,HIY"请做好准备：5 秒之后你就可以出招了！\n"NOR);
	me->start_busy(5);
	destruct(this_object());
	return 1;
}

