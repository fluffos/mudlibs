#include <armor.h>

inherit HEAD;

void create() {
  set_name("碗子铁盔", ({ "wanzi tiekui", "kui" }));
  set_weight(1000);
  set("value", 1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("material", "iron");
    set("unit", "个");
    set("armor_prop/armor", 1);
  }
  setup();
}
