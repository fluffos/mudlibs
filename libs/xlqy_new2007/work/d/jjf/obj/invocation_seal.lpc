#include <skill.h>
#include <ansi.h>

inherit ITEM;

void create()
{
        set_name("天将护法符", ({"invocation seal", "seal"}));
	set_weight(100);
	if(clonep())
    		set_default_object(__FILE__);
  	else {

        set("long","一张画上了符咒的桃符纸，中央有个大大的“护”字。\n");
        set("unit", "张");
        set("value", 0);
	set("no_put",1);
	set("no_sell",1);
	}
	setup();
}

void init()
{

  object me = this_object();
  object where = environment();

  if (userp(where))
  {
    if (me->query("owned"))
    {
      if (me->query("owned")!=where->query("id"))
      {
        call_out("destruct_me",1,where,me);
      }
    }
    else
    {
      me->set("owned",where->query("id"));
    }
  }
}

void destruct_me(object where, object me)
{
        object seal;
        if( seal=new("/obj/paper_seal"))
                seal->move(where);
	message_vision("$N手中的$n突发红光，符咒渐渐淡去不见了。\n",where,me);
        destruct(me);
}

void invocation(object who)
{
	int i,a,b,c;
	
	a=who->query("combat_exp");
	b=(int)who->query_skill("spells")*(int)who->query_skill("spells");
	c=(int)who->query("mana_factor")*(int)who->query("mana_factor")*(int)who->query("mana_factor");
	i=a+b+c;

	this_object()->set("ap",i);
	return;
}
int ji_ob(object victim)
{
	int invocation_time;
        object soldier;
	object seal=this_object();
	object me=this_player();
	object where=environment(me);
        
        
        if( !me->is_fighting())
		return notify_fail("只有战斗中才能祭天将护法符。\n");

	if(me->is_busy())
		return notify_fail("你正忙着呢，无法祭天将护法符。\n");
	if( where->query("no_magic"))
		return notify_fail("这里不能祭天将护法符。\n");
	if( (int)me->query("mana") < 140 )
		return notify_fail("你的法力不能控制天将护法符。\n");
	if( (int)me->query("sen") < 100 )
                return notify_fail("你的精神不足，很难驾驭天将护法符。\n");

        me->add("mana", -50);
	

        invocation_time=60+(200-(int)me->query_skill("spells"));
        if(invocation_time<30) invocation_time=30;
        if((time()-me->query("last_invocation"))<invocation_time)
	    return notify_fail("你刚叫过天将，他们都被你叫烦了！\n");

        
        message_vision("\n$N大喊一声“神兵天将听令!，手一挥，祭出了一张天将护法符！\n天将护法符「呼」地一下飞到半空。\n" NOR, me);

        me->add("mana",-150);
        me->receive_damage("sen", 80);

        if( random(me->query("max_mana")) < 250 ) {
                message("vision", "但是什么也没有发生。\n",
environment(me));
                destruct(seal);
                return 1;
        }

        seteuid(getuid());
        soldier = new("/obj/npc/heaven_soldier");
        soldier->move(environment(me));
        soldier->invocation(me);
	soldier->set_temp("invoker",me);
        me->set("last_invocation",time());
	me->start_busy(2+random(2));
	destruct(seal);  
	return 1;
}

int ji (string target)
{
  object seal = this_object ();
  object me = this_player();
  string name=seal->query("name");
  object victim;

//  if (!target)
//    return notify_fail("你想对谁祭"+name+"？\n");

//  victim=present(target,environment(me));
  seal->ji_ob();
  return 1;
}



