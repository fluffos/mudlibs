void init() {

  add_action("do_up", "levelup");
  add_action("do_cost", "levelcost");
}
int do_up() {
  object me;
  int level, gold, att, skill;
  me = this_player();
  level = me->query("level");
  if (LEVEL_D->query_ob_upgrade_level(me)) {
    gold = LEVEL_D->query_ob_upgrade_gold(level);
    gold = gold * 10000;
    att = LEVEL_D->query_ob_add_attpoint(level + 1);
    skill = LEVEL_D->query_ob_add_skpoint(level + 1);

    tell_object(
      me,
      HIR "你已升到" + HIW + to_chinese(level + 1) + NOR + HIR "级，你的属性点数增加了" + MAG + to_chinese(att) + NOR + HIR "点,你的技能点数增加了" + MAG + to_chinese(skill) + NOR + HIR "点！\n" NOR
    );
    me->add("balance", -gold);
    me->add("level", 1);
    me->add("attribute_point", att);
    me->add("skills_point", skill);
    return 1;

  } else
    tell_object(me, HIY "你升级的条件不够，请用(levelcost 等级)查看升级条件！\n" NOR);


  return 1;


}
int do_cost(string arg) {
  object me;
  int level, exp, gold, dx;
  int year, day, hour;
  string str;
  me = this_player();
  if (!arg) {

    tell_object(me, HIY "请输入一个数字!\n" NOR);
    return 1;
  }
  sscanf(arg, "%d", level);

  if (level > 95) return 1;
  if (level > 0) {
    gold = LEVEL_D->query_ob_upgrade_gold(level - 1);
    gold = gold * 10000;
    exp = LEVEL_D->query_ob_upgrade_exp(level - 1);
    dx = exp * 2 / 3;
    year = dx / 1000;
    day = (dx - year * 1000) / 4;
    hour = (dx - year * 1000 - day * 4) * 3;
    str = "";
    if (year) str = str + chinese_number(year) + "年";
    if (day) str = str + chinese_number(day) + "天";
    if (hour) str = str + chinese_number(hour) + "时辰";

    tell_object(
      me,
      HIY "升级到" + HIC + to_chinese(level) + NOR + HIY "级，需要经验值达到" + HIC + exp + NOR + HIY ",需要道行达到" + HIC + str + NOR + HIY "，需要缴纳存款" + HIC + MONEY_D->money_str(gold) + "!\n" NOR
    );
  }
  return 1;
}
