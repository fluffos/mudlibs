#include <ansi.h>

inherit ITEM;

void create()
{
        set_name(HIM"五"+HIY+"花"+HIW+"翎旗"+NOR, ({"biao qi","qi"}));
	set_weight(100);
	if(clonep())
    		set_default_object(__FILE__);
  	else {

        set("long","振远镖局的镖旗，雪白的丝绸上用金线绣着五朵梅花。\n");
        set("unit", "面");
        set("value", 0);
	set("no_put",1);
	set("no_sell",1);
	set("owner_id","");
	
	}
	setup();
}
