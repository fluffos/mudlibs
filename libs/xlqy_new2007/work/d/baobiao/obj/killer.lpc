//by gamer@88

#include <ansi.h>

inherit ITEM;
int reset_status();
int do_finish();
int give_reward(object me);
int robber_come(object me);
void leave();

void create()
{
        set_name(HIB"杀手"NOR, ({"sha shou", "shou",}));
        set_weight(88888);
        set("long","一个黑衣蒙面的杀手，不怀好意的往四周打量着。\n");
        set("unit", "个");
        set("no_put",1);
        set("no_sell",1);
        set("no_get",1);
        set("value",1);
        set("level",1);
        set("arrive",0);
        setup();
}
void init()
{
        add_action("do_maifu", "maifu");

        
}
void invocation(object who,int value)
{
        remove_call_out("leave");
        call_out("leave",750);  
        set("value",value);
        
        set("owner", who);
       
        reset_status();
        return;
}
int reset_status()
{
        object owner,env;
        int n;
        object *inv,robber;
        if(!this_object())
                return 1;
        owner= query("owner");
        
        if(!query("owner"))
        {
              tell_room(environment(),"镖车被成功的运走啦！\n");
                destruct( this_object());
                return 1;
        }
       inv=all_inventory(environment());      
       if(!present(owner,environment()))
     
        {  
                 robber=present("biao tou",environment());
                if(robber)
                {
                 if(robber->query("owner")==owner)
                
                {
                tell_room(environment(),"镖车被成功的运走啦！\n");
               tell_object(owner,HIR+"糟糕，镖车被护送走啦！\n"+NOR);
               
               for(int zz =0; zz <sizeof(inv);zz++)             {                               if (inv[zz]->query("owner")==owner)                                destruct(inv[zz]);
                }
                destruct( this_object());
               
                remove_call_out();
                
                return 1;
                }
        }
        }
        if(query("arrive"))
        {  
           if(!present("biao tou",environment()))
           {
          
           remove_call_out("do_finish");
           call_out("give_reward",10,owner);
                
           }
           else 
           {
                
             remove_call_out("give_reward");    
        }
           call_out("reset_status", 3);
           return 1;    
        }
        if(!present(owner->query("id"), environment(this_object())))
            {
             env=environment(owner);
             this_object()->move(env);
             message_vision(HIB+"杀手"+NOR+"走了过来。\n",owner);
            }
            
        call_out("reset_status", 3);
        return 1;
}
int do_maifu(string arg)
{
        object room, me,master;
        string name;
        me=this_player();
        master=query("owner");
        
        if(master->query("id")!=me->query("id"))
          return 0;
        
        if(!arg)
            return 0;
        if(arg!="here"&&arg!="此处")
            return 0;
        if(me->query_temp("hubiao/right_place"))
        {
                message_vision(CYN+"$N说道：大伙准备了，货马上来了。\n"+NOR, me);
                
                return 1;
                
        }
        room=environment(me);
        if(me->query_temp("hubiao/wrong_place")>2+me->query("hubiao/level")*2)
        {
                tell_object(me,HIR+"你这个路盲，到处乱跑，耽误了大事，看你如何向堂主交代！\n"NOR);
                me->delete_temp("hubiao/wrong_place");
                destruct(this_object());
                
                return 1;
                
        }
        if(file_name(room)+".lpc"!=query("file_name"))
        {
                
                tell_object(me,HIR+"等了一会始终不见镖车到来，要不再找找？\n"+NOR);
                me->add_temp("hubiao/wrong_place",1);
                return 1;
        }
        message_vision("$N左右打量了一下，道：就是这了，大伙埋伏好，等待货到。\n",me);
        me->set_temp("hubiao/right_place",1);
        set("arrive",1);
        
        me->start_busy(4);
        
        remove_call_out("robber_come");
call_out("robber_come",3,me);
        return 1;
}
int robber_come(object me)
{
        object robber,biaoche;
        int value,level;
        level=me->query("hubiao/level");
        value=me->query("hubiao/value");
        message_vision(HIR"\n忽看到几个人押镖过来，手下喽啰纷纷冲杀出去。\n"NOR,me);
        message_vision(HIY"大喊道：打劫了，打劫了，男的站左边，女的站右边，其他的站中间。\n"NOR,me);
        for(int i=0;i<level;i++)
        {
robber=new("/d/baobiao/npc/biaotou1");
                robber->move(environment());
                robber->invocation(level,value,me);
                robber->kill_ob(me);
     me->kill_ob(robber);
robber->start_busy(1);
                        
        }
 biaoche = new("/d/baobiao/obj/biaoche2");
        biaoche->move(environment());
        me->set("jiebiao/biaoche_ob",biaoche);
        remove_call_out("do_finish");
        call_out("do_finish",80+level*60+value*20);
        return 1;
}
int do_finish()
{
        object room,me,master,biaoche;
        object *inv;
//      me=this_player();
        master=query("owner");
        
        if(!present(master, environment(this_object())))
        {
                
                tell_object(master,HIR+"糟糕，你没有拿到镖车里的红货，回去如何向堂主交代！\n"+NOR);
                
                master->delete_temp("hubiao/wrong_place");
                master->delete_temp("hubiao/right_place");
                destruct(this_object());
                return 1;
        }
       
       inv=all_inventory(environment(this_object()));
        for(int zz =0; zz <sizeof(inv);zz++)    {                               if (inv[zz]->query("id")=="biao tou")
                                {
                        
                
                if(inv[zz]->query("owner")==master)
                 {
                        
                 tell_room(environment(this_object()),HIY"\n只见一群江湖人士打扮的人走了过来。\n"NOR);
                 tell_room(environment(this_object()),"看到有强盗在打劫，众人大喊一声，纷纷冲杀过来。镖师们趁机把镖车运跑了！\n",);
                 tell_object(master,HIR"这么几个镖头都还没解决掉？回去再练练吧。\n"NOR);
                 
                 master->delete_temp("hubiao/wrong_place");
                 master->delete_temp("hubiao/right_place");
                 biaoche = master->query("jiebiao/biaoche_ob");
                 if(objectp(biaoche))
                        destruct(biaoche);
                 
                 destruct(this_object());
                 return 1;
                }
                }       }       
        give_reward(master);
        return 1;
}
int give_reward(object me)
{
object master,huizhi,biaoche;
        master=query("owner");
        message_vision("\n只见众镖头四散奔逃，小的们早已冲上前砍开镖车的绳索，打开镖车拿出里面的红货交给$N。\n",me);
        tell_object(me,HIY"快拿红货去向堂主交差吧！\n"NOR);
                
  huizhi=new("/d/baobiao/obj/honghuo");
        huizhi->move(me);
        huizhi->set("owner",me);
        huizhi->set("hubiao/value",me->query("hubiao/value"));
        huizhi->set("hubiao/level",me->query("hubiao/level"));
        huizhi->set("hubiao/m_success",me->query("hubiao/m_success"));
if(random(2))
huizhi->set("hubiao/number",1000*(1+random(9))+100*(1+random(9))+10*(1+random(9))+random(9));
else if(random(2))
huizhi->set("hubiao/number",10000*(1+random(9))+1000*(1+random(9))+100*(1+random(9))+10*(1+random(9))+random(9));
else
huizhi->set("hubiao/number",100000*(1+random(9))+10000*(1+random(9))+1000*(1+random(9))+100*(1+random(9))+10*(1+random(9))+random(9));
                
        me->delete_temp("hubiao/wrong_place");
        me->delete_temp("hubiao/right_place");
         biaoche = master->query("jiebiao/biaoche_ob");
                 if(objectp(biaoche))
                        destruct(biaoche);
        destruct(this_object());
        
}
void leave()
{
       
          if(this_object())
           {
                if(environment())
                {
                  message("vision",HIB + name() + 
                          "不知所踪了。\n" NOR,environment());
                }
        destruct(this_object());
        return;
      }
       
}

