#include <ansi.h>
inherit ITEM;
void create()
{
        set_name("萧萧的手信", ({ "letter"}) );
        set_weight(10);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "封");
                set("value", 0);
                                set("long",
"萧萧写给他父亲萧总镖头的信，以火漆封口。似乎可以撕开(tear)，上书：\n"+
      HIR"父亲大人亲启"NOR);
        }
} 
void init()
{
  if(this_player()==environment()){
        add_action("do_tear","tear"); 
        }
} 
int do_tear(string arg)
{
        object  me, ob;
        if(  arg != "letter" )
                return 0;
        me = this_player();
        ob = this_object();
        message_vision("$N将$n的封口撕开，取出了其中的信笺\n", me, ob);
        set_name("被撕开的信", ({ "letter", "信"}) );
 	set("long","一封已经开了封的信封，里面的信笺上写着：\n"+    
 	HIR"“女儿萧萧今觅得一侠士相助，此人武艺高强，侠骨仁心，必能助我们一臂之力。\n"NOR+
 	HIR" 然防人之心不可无，父亲大人切记！女儿萧萧拜上。”\n"NOR);
        remove_action("do_tear","tear");
        return 1;
}      
