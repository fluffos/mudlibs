//by gamer@88

#include <ansi.h>

inherit ITEM;
int reset_status();
int do_finish();
int give_reward(object me);
int robber_come(object me);
void leave();

void create()
{
        set_name(HIG"镖车"NOR, ({"biao che", "che",}));
	set_weight(88888);
	set("long","一辆镖局运镖的镖车，上面插着振远镖局的五花翎旗。\n");
        set("unit", "辆");
        set("no_put",1);
	set("no_sell",1);
	set("no_get",1);
	set("value",1);
	set("level",1);
	set("arrive",0);
	setup();
}
void init()
{
	add_action("do_say", "say");

	
}
void invocation(object who,int value)
{
	remove_call_out("leave");
	call_out("leave",750);	
	set("value",value);
	
        set("owner", who);
       
        reset_status();
        return;
}
int reset_status()
{
        object owner,env;
        int n;
        object *inv,robber;
        if(!this_object())
        	return 1;
        owner= query("owner");
	
        if(!query("owner"))
        {
              tell_room(environment(),"镖车被强盗劫走了。\n");
                destruct( this_object());
                return 1;
        }
       inv=all_inventory(environment());      
       if(!present(owner,environment()))
     
  	{  
  		 robber=present("robber",environment());
  		if(robber)
  		{
  		 if(robber->query("owner")==owner)
  		
  		{
  		tell_room(environment(),"镖车被强盗劫走了。\n");
               tell_object(owner,HIR+"糟糕，镖车被劫啦！\n"+NOR);
               
               for(int zz =0; zz <sizeof(inv);zz++)
	  	{	  	 
	  	if (inv[zz]->query("owner")==owner)
	  	       	      	destruct(inv[zz]);
	  	}
                destruct( this_object());
               
		remove_call_out();
		
		return 1;
		}
	}
	}
	if(query("arrive"))
	{  
	   if(!present("robber",environment()))
	   {
	  
	   remove_call_out("do_finish");
	   call_out("give_reward",10,owner);
	   	
	   }
	   else 
	   {
	   	
	     remove_call_out("give_reward");	
	}
	   call_out("reset_status", 3);
	   return 1;	
	}
 if(!present(owner, environment(this_object())))
            {
             env=environment(owner);
             this_object()->move(env);
             message_vision("镖夫推着"+HIG+"镖车"+NOR+"走了过来。\n",owner);
            }
            
        call_out("reset_status", 3);
        return 1;
}
int do_say(string arg)
{
	object room, me,master;
	string name;
	me=this_player();
	master=query("owner");
	
	if(master->query("id")!=me->query("id"))
	  return 0;
	
	if(!arg)
	    return 0;
	if(arg!="here"&&arg!="到了")
	    return 0;
	if(me->query_temp("hubiao/right_place"))
	{
		message_vision(CYN+"$N说道：大伙提高警惕，稍候片刻，等待接镖。\n"+NOR, me);
		
		return 1;
		
	}
	room=environment(me);
	if(me->query_temp("hubiao/wrong_place")>2+me->query("hubiao/level")*2)
	{
		tell_object(me,HIR+"你这个路盲，到处乱跑，耽误了大事，看你如何向镖局交代！\n"NOR);
		me->delete_temp("hubiao/wrong_place");
		destruct(this_object());
  	   	
		return 1;
		
	}
	if(file_name(room)+".lpc"!=query("file_name"))
	{
		
		tell_object(me,HIR+"似乎不是这个地方，再找找？\n"+NOR);
		me->add_temp("hubiao/wrong_place",1);
		return 1;
	}
	message_vision("$N手向后一扬，示意镖车停下，朗声说道：到了，等待接镖。\n",me);
	me->set_temp("hubiao/right_place",1);
	set("arrive",1);
	
	me->start_busy(4);
	 if(random(13)==0)  
	     // if lucky ,no robber
	 {
	 	
	 	remove_call_out("do_finish");
	 	call_out("do_finish",3);
		return 1;
	}
	
	remove_call_out("robber_come");
call_out("robber_come",3,me);
	return 1;
}
int robber_come(object me)
{
	object robber;
	int value,level;
	object *inv;
	level=me->query("hubiao/level");
	value=me->query("hubiao/value");
	message_vision(HIR"\n忽听几声呼哨，几个强人跳了出来。\n"NOR,me);
	message_vision(HIY"强盗大喊道：打劫了，打劫了，男的站左边，女的站右边，其他的站中间。\n"NOR,me);
	for(int i=0;i<level;i++)
	{
		robber=new("/d/baobiao/npc/robber");
		robber->move(environment());
		robber->invocation(level,value,me);
		robber->kill_ob(me);
robber->start_busy(2);
      		me->kill_ob(robber);
		
       		inv=all_inventory(environment());
  		for(int zz =0; zz <sizeof(inv);zz++)
	  	{	  	 
	  	if (inv[zz]->query("id")=="tang"&&inv[zz]->query("owner")==me)
	  	      {
	  	      	robber->kill_ob(inv[zz]);
	  	      	inv[zz]->kill_ob(robber);
	  	}
	  	  if(inv[zz]->query("id")=="biao tou"&&inv[zz]->query("owner")==me)
	  	  {
	  	  	  robber->kill_ob(inv[zz]);
	  	  	  inv[zz]->kill_ob(robber);
	  	  }
	  	}
	  	
      		
      		
	}
	remove_call_out("do_finish");
	call_out("do_finish",80+level*60+value*20);
	return 1;
}
int do_finish()
{
	object room,me,master;
	object *inv;
//	me=this_player();
	master=query("owner");
	
        if(!present(master, environment(this_object())))
  	{
  		
  	   	tell_object(master,HIR+"糟糕，你没有拿到收镖的回执，回去如何向总镖头交代！\n"+NOR);
  	   	
  	   	master->delete_temp("hubiao/wrong_place");
  	   	master->delete_temp("hubiao/right_place");
  	   	destruct(this_object());
  	   	return 1;
  	}
       
       inv=all_inventory(environment(this_object()));
  	for(int zz =0; zz <sizeof(inv);zz++)
	{	  	 
	  	if (inv[zz]->query("id")=="robber")
	  	
	  	{
	  		
	  	
	  	if(inv[zz]->query("owner")==master)
		 {
		 	
		 tell_room(environment(this_object()),HIY"\n只见一群家丁打扮的人走了过来。\n"NOR);
		 tell_room(environment(this_object()),"看到有强盗在打劫，众家丁大喊一声，四散逃离。\n",);
		 tell_object(master,HIR"你怎么连这么点小毛贼都还没解决掉？回去再练练吧。\n"NOR);
		 
		 master->delete_temp("hubiao/wrong_place");
		 master->delete_temp("hubiao/right_place");
		 destruct(this_object());
		 return 1;
		}
	  	}
	}	
  	give_reward(master);
  	return 1;
}
int give_reward(object me)
{
	object master,huizhi;
	object *inv;
	master=query("owner");
	message_vision("\n只见一群家丁打扮的人走了过来，其中一人对$N拱手作揖，道：我家主人吩咐小的们前来接镖。\n",me);
	message_vision(CYN"家丁道：这是接镖的回执。请验收！\n"NOR,me);
	message_vision(HIW"$N仔细的看了看回执上的签押，确是总镖头的字迹画押，点头道：没错，请验镖。\n"NOR,me);
	message_vision("众家丁仔细验过镖后，说道：货物丝毫不差，多谢这位"+RANK_D->query_respect(me)+"一路辛苦护送，我等告辞了。\n",me);
	message_vision("大伙儿都兴高采烈的离开了。\n",me);
	tell_object(me,HIY"快拿回执去向镖局交差吧！\n"NOR);
	
	
	inv=all_inventory(environment());
  	for(int zz =0; zz <sizeof(inv);zz++)
	  	{	  	 
	  	if (inv[zz]->query("id")=="tang"&&inv[zz]->query("owner")==me)
	  	       destruct(inv[zz]);
	  	 else if(inv[zz]->query("id")=="biao tou"&&inv[zz]->query("owner")==me)
	  	       destruct(inv[zz]);
	  	}	
	huizhi=new("d/baobiao/obj/receipt");
	huizhi->move(me);
	huizhi->set("owner",me);
	huizhi->set("hubiao/value",me->query("hubiao/value"));
	huizhi->set("hubiao/level",me->query("hubiao/level"));
	huizhi->set("hubiao/m_success",me->query("hubiao/m_success"));
if(random(2))
huizhi->set("hubiao/number",1000*(1+random(9))+100*(1+random(9))+10*(1+random(9))+random(9));
else if(random(2))
huizhi->set("hubiao/number",10000*(1+random(9))+1000*(1+random(9))+100*(1+random(9))+10*(1+random(9))+random(9));
else
huizhi->set("hubiao/number",100000*(1+random(9))+10000*(1+random(9))+1000*(1+random(9))+100*(1+random(9))+10*(1+random(9))+random(9));
	
	me->delete_temp("hubiao/wrong_place");
	me->delete_temp("hubiao/right_place");
	destruct(this_object());
	
}
void leave()
{
       
          if(this_object())
           {
	        if(environment())
		{
	          message("vision",HIB + name() + 
	                  "不知所踪了。\n" NOR,environment());
		}
        destruct(this_object());
        return;
      }
       
}
