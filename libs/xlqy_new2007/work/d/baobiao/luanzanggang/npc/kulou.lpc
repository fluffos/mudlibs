inherit NPC;
#include <ansi.h>

void create() {
  set_name("骷髅", ({ "ku lou", "lou" }));
  set("gender", "雄性");
  set("age", 210);
  set("long",
    "这是乱葬岗的骷髅 ，具有抗魔法和物理伤害的能力！\n");
  set("str", 22);
  set("cor", 33);
  set("cps", 6);
  set("max_kee", 2000);
  set("max_gin", 2000);
  set("max_sen", 2000);
  set("force", 1500);
  set("max_force", 1500);
  set("mana", 1500);
  set("max_mana", 1500);
  set("force_factor", 30);
  set_skill("parry", 100 + random(50));
  set_skill("dodge", 100 + random(50));
  set_skill("ghost-steps", 100 + random(50));
  set_skill("unarmed", 100 + random(50));
  set_skill("jinghun-zhang", 100 + random(50));
  map_skill("unarmed", "jinghun-zhang");
  map_skill("parry", "jinghun-zhang");
  map_skill("dodge", "ghost-steps");
  set("attitude", "aggressive");
  set("combat_exp", 333333 + random(111111));
  setup();

}
void init() {
  if (interactive(this_player()))
    this_object()->kill_ob(this_player());



}

varargs int receive_damage(string type, int damage, mixed who, string d_type) {
  damage = damage / 3;
  return ::receive_damage(type, damage, who, d_type);
  return damage;
}
varargs int receive_wound(string type, int damage, mixed who, string d_type) {
  damage = damage / 3;
  return ::receive_wound(type, damage, who, d_type);
  return damage;
}
