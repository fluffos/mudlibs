// /d/guzhanchang/pomiao.c
inherit ROOM;
int do_out();
void create() {
  set("short", "破庙");
  set("long", @LONG
 "这里是一个破庙，
到处贴满了符，正中端坐着一具破烂不堪的泥像,看起来相当诡异。

LONG);

  set("exits", ([
    "north": __DIR__ "mi8",

  ]));
  set("objects", ([
    "/d/baobiao/npc/huilian": 1,
    __DIR__ "npc/kulou": 1 + random(2),
    __DIR__ "npc/jiangshi": 1 + random(2),
  ]));
  set("no_clean_up", 0);
  setup();
}

int valid_leave(object me, string dir) {
  object a;
  if (objectp(a = present("jiang shi", environment(me))) && living(a))
    return notify_fail("僵尸口中荷荷几声怪叫，拦在你面前！\n");
  else if (objectp(a = present("ku lou", environment(me))) && living(a))
    return notify_fail("骷髅身形一晃，拦在你面前！\n");
  return ::valid_leave(me, dir);

}
