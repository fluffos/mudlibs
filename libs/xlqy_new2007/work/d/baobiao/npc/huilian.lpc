inherit NPC;
#include <ansi.h>

void create()
{
                                                                                 set_name(BLK"灰莲使者"NOR, ({ "huilian shizhe", "shizhe" }) );
                                                                                 set("gender", "男性");
                                                                                 set("age", 200);
                                                                                 set("long",
                                                                                "无天手下得力的大将灰莲使者 ！\n");
                                                                                 create_family("阎罗地府", 2, "弃徒"); 
                                                                                 set("title","先锋大将");
                                                                                 set("str", 33);
                                                                                 set("cor", 44);
                                                                                 set("cps", 11);
                                                                                 set("max_kee", 3333);
                                                                                 set("max_gin", 3333);
                                                                                 set("max_sen", 3333);
                                                                                 set("force",3333);
                                                                                 set("max_force",3333);
                                                                                 set("mana",3333);
                                                                                 set("max_mana",3333);
                                                                                 set("force_factor",66);
                                                                                  set("mana_factor",66);
                                                                                  set("combat_exp", 555555+random(111111));
                                                                                 set_skill("parry",150+random(33));
                                                                                 set_skill("dodge",150+random(33));
                                                                                 set_skill("unarmed",150+random(33));
                                                                                 set_skill("whip", 150+random(33)); 
                                                                                 set_skill("tonsillit", 150+random(33));                   
                                                                                 set_skill("gouhunshu", 150+random(33));                       
                                                                                 set_skill("jinghun-zhang", 150+random(33));                      
                                                                                 set_skill("ghost-steps", 150+random(33));                     
                     set_skill("hellfire-whip", 150+random(33));                     
                     set_skill("kusang-bang", 150+random(33));         
                     set_skill("zhuihun-sword", 150+random(33));         
                     set_skill("sword", 150+random(33));         
                     set_skill("stick", 150+random(33));         
                                                                         
                     map_skill("dodge", "ghost-steps");                 
                     map_skill("unarmed", "jinghun-zhang");                
                     map_skill("spells", "gouhunshu");                  
                     map_skill("force", "tonsillit");               
                     map_skill("whip", "hellfire-whip");                 
                     map_skill("parry", "hellfire-whip");                 
                     map_skill("sword", "zhuihun-sword");    
                     map_skill("stick", "kusang-bang");    
                     set("chat_chance_combat", 55);               
                     set("chat_msg_combat", ({                    
                             (: cast_spell, "gouhun" :),                
                             (: perform_action, "whip", "three" :), 
                             (: perform_action, "unarmed", "zhua" :), 
                     }));
                                                         
 setup();
  carry_object("/d/obj/weapon/whip/pibian")->wield();      
}
void init()
{               
                        object ob;
        ::init();
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
                call_out("greeting",1, ob);
        }
}

void greeting(object who)
{
        if( !who || !visible(who) || environment(who) != environment() ) return;
         if(who->query("baobiao/夺回镖旗"))
         {
                        command("caidao");
                        message_vision(CYN"$N说道："+RANK_D->query_rude(who)+"夺我镖旗，拿命来！\n"NOR,this_object());
                        ::kill_ob(who);
        }
        else if(who->query("baobiao/去夺镖旗"))
        {
                command("heng");
                        message_vision(CYN"$N说道："+RANK_D->query_rude(who)+"想夺我镖旗，拿命来！\n"NOR,this_object());
                        ::kill_ob(who);
   
        }
        else if(who->query("jiebiao/夺回镖旗"))
        {
                        command("hmm");
                        message_vision(CYN"$N说道："+RANK_D->query_rude(who)+"干的不错，无天佛组要成大事，需要很多财物，你要多多弄来。\n"NOR,this_object());
                                
                
        }
        
        else if(who->query("jiebiao/去见使者"))
        {
                
                                command("haha");
                        message_vision(CYN"$N说道："+RANK_D->query_rude(who)+"干的不错，不过老夫还要考较考较你到底有没有资格为佛祖效力！\n"NOR,this_object());
                        ::kill_ob(who);
       }
       else
       {
                                command("ah");
                        message_vision(CYN"$N说道：哪里来的"+RANK_D->query_rude(who)+"，拿命来！\n"NOR,this_object());
                        ::kill_ob(who);         
        
        
      }
}

void unconcious()
{

die();
}

void die ()
{
object biaoqi;  
 object who=this_player();
  object me = this_object();
  object ob = query_temp("last_damage_from");
  object killer=query_temp("my_killer");
  object last =query_temp("last_killed_by");
  string faint=query_temp("last_fainted_from");
  if(!ob)
  {
                        ::die();
          return;       
        
}

   if(faint && ob) {
      if(faint!=ob->query("id"))
                {
                        ::die();
                      return;
                }
        }
      if(!last) last=ob;
         else if(last!=ob)
        { 
                        ::die();
                         return;
                    
                    
      }
  if(ob->query("jiebiao/去见使者"))
        { 
                        message_vision(CYN"$N说道："+RANK_D->query_respect(who)+"果然有两下子，以后就一起为无天佛祖效力吧！先到花忍那里干着！\n"NOR,this_object());
                message_vision(CYN"老夫有要事，先行离开了。说罢，$N转身离去了。\n"NOR,this_object());
                        
        ob->set("jiebiao/夺回镖旗",1);
        destruct(this_object());                 
         return;
        }
        else 
if(ob->query("baobiao/去夺镖旗"))
         {
                  message_vision(CYN"$N冷笑了一声，道：老夫要事在身，不陪你玩了。\n"NOR,who);
  message_vision(CYN"说罢，化为一朵黑莲遁去。\n "+"$N一看墙上挂的正是五花翎旗，赶紧揣入怀中。\n"NOR,ob);
                  biaoqi=new("/d/baobiao/obj/biaoqi");
                        biaoqi->move(ob);
                        biaoqi->set("owner_id",ob->query("id"));
                  destruct(this_object());
                    return ;
                
        }
        ::die();
 
}

