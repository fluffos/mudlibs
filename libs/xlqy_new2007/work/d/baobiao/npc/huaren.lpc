varargs mapping random_location(mixed flag)
{
        string line, dir, tmp,dir_s,str;
        string *maps, *areas,*dirss;
        int j,k,jj;
        mixed*  files;
        object room;
        mapping location,exits;
        string *dirs;
        string *positions;
        dirs = ({
"/d/jz",
"/d/gao",
"/d/jjf",
"/d/kaifeng",
"/d/lingtai",
"/d/moon",
"/d/sea",
"/d/qujing/wuzhuang",
"/d/qujing/baoxiang",
"/d/qujing/biqiu",
"/d/qujing/chechi",
"/d/qujing/fengxian",
"/d/qujing/jingjiling",
"/d/qujing/jinping",
"/d/qujing/jisaiguo",
"/d/qujing/nuerguo",
"/d/qujing/qinfa",
"/d/qujing/tianzhu",
"/d/qujing/tongtian",
"/d/qujing/wudidong",
"/d/qujing/wuji",
"/d/qujing/yuhua",
"/d/qujing/zhuzi",
});
positions=({
"江州",
"高老庄",
"大唐将军府",
"开封",
"灵台方寸",
"月宫",
"东海龙宫",
"五庄观",
"宝象国",
"比丘国",
"车迟国",
"凤仙郡",
"荆棘岭",
"金平府",
"祭赛国",
"女儿国",
"钦法国",
"天竺",
"通天河",
"无底洞",
"乌鸡国",
"玉华县",
"朱紫国",
});
        j=0;jj=0;
        location=allocate_mapping(5);
        j = random(sizeof(dirs));
        jj=j;
        dir_s = dirs[j];
        files = get_dir( dir_s+"/*.lpc", -1 );
        j = random(sizeof(files));
        reset_eval_cost();
        for(k=0;k<30;k++) { // try 30 times
           j = random(sizeof(files));
           if( files[random(sizeof(files))][1] > 0)
            room=load_object(dir_s+"/"+files[j][0]); 

        if(!room->query("no_fight")&&!room->query("alternative_die"))
        {
                if(room->query("no_hubiao"))
                        continue;
                if(sizeof(room->query("long"))<10)
                        continue;  
        location["file"]=dir_s+"/"+files[j][0];
        location["room"]=room;
        location["long"]=room->query("long");
        str="";
        if( mapp(exits = room->query("exits")) ) {
                dirss = keys(exits);
                for(int i=0; i<sizeof(dirss); i++)
                        if( (int)room->query_door(dirss[i], "status") & DOOR_CLOSED )
                                dirss[i] = 0;
                dirss -= ({ 0 });
                if (room->query("no_look"))
                        str += "这里的出路看不清楚。\n";
                else if( sizeof(dirss)==0 )
                        str += "这里没有任何明显的出路。\n";
                else if( sizeof(dirss)==1 ) {
                        str += " 这里唯一的出口是 "+dirss[0];
                        if (room->query("no_look"))
                                str += "<看不见>";
                        str += "。\n";

                } else {
                        str += sprintf(" 这里明显的出口是 " + "%s" + " 和 " + "%s" ,
                                implode(dirss[0..sizeof(dirss)-2], "、"), dirss[sizeof(dirss)-1]);
                        if (room->query("no_look"))
                                str += " <看不见>";
                        str += "。\n";
                } 
        }
        location["long"]=location["long"]+str;
        location["position"]=positions[jj];
        break;
        }
        }
        return location;
}

varargs string Display(string str, int size, string fill, string bg, string fcolor, string bgcolor)
{
        int offset;
        int *mask = ({0x80, 0x40, 0x20, 0x10, 0x8, 0x4, 0x2, 0x1});
        int scale;
        int r,z,leafy;
        string char;
        string *out;
        
        if(!size)
#ifdef AUTO_SIZE
                size = AUTO_SIZE;
#else
                error("TEXT to PIC need size\n");
#endif
        out = allocate(16);
        out = map_array(out, (: $1 = "" :));
        size *= 2;

        if(!fill) fill = DEFAULT_FILL;
        if(!fcolor) fcolor = DEFAULT_FCOLOR;
        if(!bg) bg = DEFAULT_BG;
        if(sizeof(fill) != sizeof(bg)) {
                fill = DEFAULT_FILL;
                bg = DEFAULT_BG;
        }
        if(!bgcolor) bgcolor = DEFAULT_BGCOLOR;

        for(int k = 0; k < sizeof(str); k++) {
                leafy = random(2);
                                r = random(10);
                                z = random(3);
                                if(z == 1)
                                size = 24;
                                else if(z == 2)
                                size = 32;
                                else size = 28;
                                 if(leafy) { fill = HIW+"@"+NOR;
                                bg = "@";
                                }
                                else {
                                 fill = HIW+"@"+NOR;
                                bg = " ";
                                }
                if(mask[0] & str[k]) {
                        offset = size*( (atoi(sprintf("%d", str[k]))-0xA1)*94 + atoi(sprintf("%d", str[k+1])) - 0xA1 );
                        char = read_bytes(HZK + (size/2), offset, size);
                        k++;
                        scale = 2;
                } else {
                        offset = str[k] * (size/2);
                        char = read_bytes(ASC + (size/2), offset, (size/2));
                        scale = 1;
                }

                if(!sizeof(char)) error("TEXT to PIC can't read bytes from character lib\n");

                for(int i = 0; i < sizeof(char); i++) {
                        for(int j = 0; j < 8; j++) {
                                if(mask[j] & char[i]) 
                                        out[i/scale] += fcolor + fill;
                                else 
                                        out[i/scale] += bgcolor + bg;
                        }
                }

                for(int i = 0; i < sizeof(out); i++) {
                                                                                if(!leafy) {
                                                                out[i] = replace_string(out[i], fcolor + fill, fill );
                                                                //  out[i] = replace_string(out[i], bg + bgcolor + bg, bg + bg);
                                                                                }
                                                                }
                                                                       }
        
        return implode(out, "\n") + NOR;
}

