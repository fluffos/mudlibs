    int do_reward(object who,object ob)
    {
                 string msg;
                        int r,ka;
      int num;
                        int t,w,q,b,s,g;
                        num = ob->query("hubiao/number");
                        t = num/100000;
                        w = (num-t*100000)/10000;
                        q = (num-t*100000-w*10000)/1000;
                        b = (num-t*100000-w*10000-q*1000)/100;
                        s = (num-t*100000-w*10000-q*1000-b*100)/10;
                        g = num-t*100000-w*10000-q*1000-b*100-10;
                        if(t) ka = 6;
                        else if(w) ka= 5;
                        else ka = 4;
                        tell_object(who,HIR"请在20秒内说出(huifu 数字)回执的暗码！\n"NOR);
                        who->set_temp("hubiao/m_num",num);
                        who->set_temp("hubiao/m_reward",1);
                        who->set_temp("hubiao/value",ob->query("hubiao/value"));
                        who->set_temp("hubiao/level",ob->query("hubiao/level"));
                        who->set_temp("hubiao/m_success",ob->query("hubiao/m_success"));
                        msg = sprintf("%d",num);
                        msg = Display(msg);
                        printf("%s",msg);
                        call_out("give_reward",20,who);
     }    
int give_reward(object who)
{
        string msg,sysmsg;
        int lvl,value,times;
        int exp_r, pot_r,dx_r;
        int reward;
        int money_amount;
        
        who->add("hubiao/m_success",1);
        who->set("hubiao/start",0);
                                lvl=who->query_temp("hubiao/level");
                                value=who->query_temp("hubiao/value");
                        times=who->query_temp("hubiao/m_success");
        reward=450*lvl+40*(value+1)+(int)(2*times);
        if(times>150)
        reward=600*lvl+60*(value+1)+random(2*times);
        if(times>500)      
         reward=800*lvl+80*(value+1)+random(times-500);
        if(times>1500)
        reward=1200*lvl+120*(value+1);
        exp_r=(reward+random(reward/8));
        dx_r=(reward*0.6+random(reward/9));
        pot_r=(reward*0.4+random(reward/10));
                         if(who->query_temp("hubiao/m_answer"))
                        exp_r = (int) exp_r*10/9;
                        else
                              exp_r=(int)exp_r*5/7;
                         if(who->query_temp("hubiao/m_answer"))
                        dx_r=(int)dx_r*11/10;
                        else
                        dx_r=(int)dx_r*2/3;
                        if(who->query_temp("hubiao/m_answer"))
                        pot_r=(int)pot_r*8/7;
                        else
                        pot_r=(int)pot_r*5/7;
      
        
        if(who->query("gain_more_reward")+who->query_temp("gain_more_reward"))
        {
        who->query_kar();
        exp_r=exp_r*(10000+who->query("gain_more_reward")+who->query_temp("gain_more_reward"))/10000;
        pot_r=pot_r*(10000+who->query("gain_more_reward")+who->query_temp("gain_more_reward"))/10000;
        dx_r=dx_r*(10000+who->query("gain_more_reward")+who->query_temp("gain_more_reward"))/10000;
                        
        }
        
        sysmsg="";
        msg="";
 sysmsg = who->query("name")+"完成一个等级"+who->query_temp("hubiao/level")+"，价值为"+who->query_temp("hubiao/value") +"的保镖任务，得到";
        switch(random(3))
        {
                case 0:
                        who->add("combat_exp", exp_r);
msg+= exp_r+"点武学，";
                        who->add("hubiao/wuxue", exp_r);
                        who->add("daoxing", dx_r);
                        who->add("hubiao/dx", dx_r);
                        
                        msg+=COMBAT_D->chinese_daoxing(dx_r)+"道行，";
                        break;
                case 1:
                        who->add("daoxing", dx_r);
                        who->add("hubiao/dx", dx_r);
                        msg+=COMBAT_D->chinese_daoxing(dx_r)+"道行，";
                        who->add("potential", pot_r);
                        who->add("hubiao/pot", pot_r);
                        msg+=pot_r+"点潜能，";
                        
                        break;
                default:
                
                        who->add("combat_exp", exp_r);
                        who->add("hubiao/wuxue", exp_r);
                        msg+=exp_r+"点武学，";
                        who->add("potential", pot_r);
                        who->add("hubiao/pot", pot_r);
                        msg+=pot_r+"点潜能，";
                        
        }
                                who->delete_temp("hubiao/m_answer");
                                who->delete_temp("hubiao/m_num");
        if(who->query("hubiao/level")==1)
        {
         money_amount=who->query_temp("hubiao/value")*3200+random(who->query_temp("hubiao/value")*1200)+random(150*who->query_temp("hubiao/m_success"));
                if(money_amount > 50000)
                        money_amount = 30000+random(10000);
                MONEY_D->pay_player(who,money_amount);
                
        }
        else if(who->query("hubiao/level")==2)
        {
          money_amount=who->query_temp("hubiao/value")*5000+random(who->query_temp("hubiao/value")*3200)+random(400*who->query_temp("hubiao/m_success"));
                if(money_amount > 100000)
                        money_amount = 60000+random(20000);
                MONEY_D->pay_player(who,money_amount);
                
        }       
        else
        {
money_amount=who->query_temp("hubiao/value")*8000+random(who->query_temp("hubiao/value")*5000)+random(800*who->query_temp("hubiao/m_success"));
                if(money_amount > 200000)
                        money_amount = 100000+random(30000);
                MONEY_D->pay_player(who,money_amount);
             
        }
        who->add("hubiao/money",money_amount);  
who->add("weiwang",1);
        msg+=chinese_number(money_amount/10000)+"两黄金"+chinese_number((money_amount-(int)10000*(money_amount/10000))/100)+"两银子！\n"+NOR;
        sysmsg+=msg;
 message("channel:sys",HIM+"【镇远镖局】："+sysmsg,users());
        tell_object(who,HIR"恭喜你顺利完成任务！"+HIW"你得到了"+msg);
                                who->delete_temp("hubiao/level");
                                who->delete_temp("hubiao/value");
                                who->delete_temp("hubiao/m_success");
        return 1;
        
        
}
int ask_times()
{
        object who;
        int money;
        who=this_player();
        money=who->query("hubiao/money");
        message_vision(CYN+name()+"告诉你：你已经为镖局护镖了"+who->query("hubiao/m_success")+"次！
总共获得经验值"+who->query("hubiao/wuxue")+"，道行"+COMBAT_D->chinese_daoxing(who->query("hubiao/dx"))+
"，潜能"+who->query("hubiao/pot")+"点以及"+chinese_number(money/10000)+
"两黄金"+chinese_number((money-(int)10000*(money/10000))/100)+"两银子！\n"NOR,who);

        return 1;
                
}
int accept_object(object who,object ob)
{
        
        string respect;
        
        respect=RANK_D->query_respect(who);
        if(ob->is_character())
           return 0;
        if(ob->query("id")=="receipt"&&ob->query("name")=="回执")
        {
        if(ob->query("owner")!=who)
        {
                message_vision(HIR+"$N惊讶的“啊”了一声，道：从哪里来得这个东西！\n"+NOR,this_object());
                
                return 1;
        
        }
        
        who->start_busy(3);
                         do_reward(who,ob);
        
        return 1;               
        }
        if(ob->query("id")!="biao qi"&&ob->query("name")!="五花翎旗")
           return 0;
        
        if(ob->query("owner_id")!=who->query("id"))
         {
                message_vision(HIR+"$N惊讶的“啊”了一声，大怒道：莫非你就是夺镖旗的毛贼？！\n"+NOR,this_object());
                ::kill_ob(who);
                return 1;
        
        
        }
        if(who->query("baobiao/夺回镖旗")==1)
        {
                message_vision(HIR+"$N惊讶的“啊”了一声，说道：这个。。。？！\n"+NOR,this_object());
                return 0;
        
        }
        if(who->query("baobiao/去夺镖旗")==1)
          {
                message_vision(HIW+"$N高兴地手舞足蹈！\n"+NOR,this_object());
                message_vision(HIC+"$N说道：多谢"+respect+"助我振远镖局夺回五花翎旗，在下感激不尽！这是小小心意，请笑纳。\n"+NOR,this_object());
                add_money("gold", 20);
                if(!who->query("env/no_accept"))
                  command("give 20 gold to " + who->query("id"));
                else command("drop 20 gold");
                who->set("baobiao/夺回镖旗",1);
                return 1;
         }



}

int give_quest()
{
        object who, biaoche,paper;
        object biaotou,biaotou2,tang1,tang2,tang3;
        string roomlong,replacelong;
        mapping room;
        string msg;
int t;
        who=this_player();
     
        if(!who->query("baobiao/夺回镖旗"))
                {
                        message_vision(CYN+name()+"摇了摇头。\n"+NOR,who);
                        message_vision(HIR+name()+"说道：镖局失去了五花翎旗(biaoqi)，没法接镖出镖！\n"+NOR,who);
                        return 1;
                }
        if(who->query("hubiao/start"))
            {
                message_vision(CYN+name()+"哼了一声。\n"+NOR,who);
                message_vision(CYN+name()+"说道：你不是有护镖的任务么。\n"+NOR,who);
                return 1;
        }
        if(who->query("balance")<200000)
        {
                message_vision(CYN+name()+"说道：你的保金不够，我不能把镖车交付给你。\n"+NOR,who);
                return 1;
        }
  
         t=who->query("hubiao/last_time");
        if(who->query("hubiao/fail",1))
         {
              if(t<time()&&time()<t+750)
               {        
                  message_vision(CYN+name()+"哼了一声。\n"+NOR,who);
                  message_vision(CYN+name()+"说道：现在镖局还没接到什么生意。\n"+NOR,who);
                  return 1;
               } 
               who->set("hubiao/fail",0);
         
               
         }
        else if(t<time()&&time()<t+450)
        {
                message_vision(CYN+name()+"愉快的微笑着。\n"+NOR,who);
                  message_vision(CYN+name()+"说道：现在镖局还没接到什么生意。\n"+NOR,who);
                return 1;

        }
        
 biaoche=new("/d/baobiao/obj/biaoche");
biaoche->move("/d/baobiao/bqpback");
 paper=new("/d/baobiao/obj/paper");
        paper->set("ownid",who->query("id"));
        message_vision(CYN+name()+"点了点头。\n"+NOR,who);
        switch(random(5))
                    {
                        case 0: {
                                        message_vision(MAG+"$N对$n说道：有人托镖局护送一批"+HIB"药材"NOR+MAG"，你按照这张镖单把镖车护送去吧。\n"+NOR,
                                                this_object(), who);
                                        biaoche->invocation(who,1);
                                        who->set("hubiao/value",1);
                                        break;
                                }
                        case 1: {
                                        message_vision(MAG+"$N对$n说道：有人托镖局护送一批"HIC"银子"NOR+MAG"，你按照这张镖单把镖车护送去吧。\n"+NOR,
                                                this_object(), who);
                                        biaoche->invocation(who,2);
                                        who->set("hubiao/value",2);
                                        break;
}
                        case 2: {
                                        message_vision(MAG+"$N对$n说道：有人托镖局护送一批"+HIG"花石纲"NOR+MAG"，你按照这张镖单把镖车护送去吧。\n"+NOR,
                                                this_object(), who);
                                        biaoche->invocation(who,3);
                                        who->set("hubiao/value",3);
                                        break;
                                }
                        case 3: {
                                        if(random(3))
                                        {
                                        message_vision(MAG+"$N对$n说道：有人托镖局护送一批"+HIY"黄金"NOR+MAG"，你按照这张镖单把镖车护送去吧。\n"+NOR,
                                                this_object(), who);
                                        biaoche->invocation(who,4);
                                        who->set("hubiao/value",4);
                                        break;
                                        }
                                        else
                                        {
                                        message_vision(MAG+"$N对$n说道：有人托镖局护送一批"HIC"银子"NOR+MAG"，你按照这张镖单把镖车护送去吧。\n"+NOR,
                                                this_object(), who);
                                        biaoche->invocation(who,2);
                                        who->set("hubiao/value",2);
break;
                                        }
                                }
                        case 4: {
                                        if(random(2))
                                        {
                                        message_vision(MAG+"$N对$n说道：有人托镖局护送一批"+HIW"珠宝玉器"NOR+MAG"，你按照这张镖单把镖车护送去吧。\n"+NOR,
                                                this_object(), who);
                                        biaoche->invocation(who,5);
                                        who->set("hubiao/value",5);
                                        break;
                                        }
                                        else
                                        {
                                        message_vision(MAG+"$N对$n说道：有人托镖局护送一批"+HIG"花石纲"NOR+MAG"，你按照这张镖单把镖车护送去吧。\n"+NOR,
                                                this_object(), who);
                                        biaoche->invocation(who,3);
                                        who->set("hubiao/value",3);
                                        break;  
                                        }
                                }
                    }
        if(who->query("hubiao/m_success")< 50)
        {

                do{ room=random_location(); } while(!strlen(room["long"]));
                biaoche->set("file_name", room["file"]);
                paper->set("file_name", room["file"]);
                paper->set("desc", room["long"]);
                paper->set("position",room["position"]);
                paper->move(who);
               
                who->set("hubiao/last_time", time());
                
                who->set("hubiao/start",1);
                who->set("hubiao/level",1);
                who->start_busy(2);
                
        }
else if(who->query("hubiao/m_success")< 250)
        {
{
                do{ room=random_location(); } while(!strlen(room["long"]));
}
                biaoche->set("file_name", room["file"]);
                
                roomlong=room["long"];
                
                replacelong=replace_long(roomlong);
                
if(random(2))
{
                paper->set("desc",replacelong );
                paper->set("position",room["position"]);
}
else
{
paper->set("position","");
 paper->set("desc",roomlong );
}
                paper->move(who);
           
                who->set("hubiao/last_time", time());
                
                who->set("hubiao/start",1);
                who->set("hubiao/level",2);
                who->start_busy(2);
                
                }
       else 
        {
                do{ room=random_location(); } while(!strlen(room["long"]));
                biaoche->set("file_name", room["file"]);
                
                roomlong=room["long"];
                replacelong=replace_long(roomlong);
                paper->set("desc",replacelong );
                paper->set("position","");
                paper->move(who);
               
                 who->set("hubiao/last_time", time());                          
                who->set("hubiao/start",1);
                who->set("hubiao/level",3);
                who->start_busy(2);
        }
                
        msg = who->name()+"接到一个等级"+who->query("hubiao/level")+"，价值为"+who->query("hubiao/value")+"的保镖任务，地点是在"+biaoche->query("file_name");
        MONITOR_D->report_system_msg (msg);
        return 1;

}
int do_cancel()
{
        
        object who=this_player();
        object me=this_object();
        int balance=who->query("balance");
        int elasp_time;
        object biaoche;
        object *inv;
        if(!who->query("hubiao/start"))
          {
                message_vision(CYN+name()+"哼了一声。\n"+NOR,who);
                message_vision(CYN+name()+"说道：你现在有护镖的任务么？\n"+NOR,who);
                 return 1;
                
        }
        
        elasp_time=time()-who->query("hubiao/last_time");
        
        
        if(elasp_time<360)
           {
           message_vision(CYN+"$N对$n笑了笑，说道：再去试试，不要轻言放弃。\n"+NOR,me,who);
           return 1;
           } 
           
        message_vision(HIR+"$N红着脸，羞愧的对$n说："+RANK_D->query_self(who)+"不才，难以胜任，还请萧镖头多多见谅!\n"+NOR,who,me);
        if(who->query("balance")>=(who->query("hubiao/level")*50000-50000+who->query("hubiao/value")*10000))
          {
                message_vision(HIW+"$N叹了口气，说道：那就算了吧，我另请高明，不过你得付一点赔偿金。\n"+NOR,me);
                who->delete_temp("hubiao/wrong_place");
                who->delete_temp("hubiao/right_place");
                inv=all_inventory(environment(who));
                for(int zz =0; zz <sizeof(inv);zz++)
                   if (inv[zz]->query("id")=="biao che"&&inv[zz]->query("owner")==who)
                       destruct(inv[zz]);
                           
                who->add("weiwang",-1-random(2));               
                who->set("balance",balance-(who->query("hubiao/level")*50000-50000+who->query("hubiao/value")*10000));
                who->set("hubiao/fail",1);
                who->set("hubiao/start",0);
                who->add("hubiao/money",-(who->query("hubiao/level")*50000-50000+who->query("hubiao/value")*10000));    
                return 1;
        }
        if(balance<(who->query("hubiao/level")*50000-50000+who->query("hubiao/value")*10000))
        {
                message_vision(HIY+"$N哼了一声，说道：那耽误了镖主的时间，损害了镖局信誉，应该怎么弥补？\n"+NOR,me);
                return 1;
        }
          }             



int ask_biaoqi()
{
        
        object who=this_player();
        if(who->query("baobiao/愿意帮忙")=="fail")
        {
           command("heng");
           message_vision(CYN"$N说道：这位"+RANK_D->query_respect(who)+"既然不愿意相助，又何必多问。\n"NOR,this_object());
           return 1;
        }
        if(who->query("baobiao/夺回镖旗"))
           {
                message_vision(CYN"$N呵呵笑道：多谢"+RANK_D->query_respect(who)+"帮振远镖局寻回五花翎旗。\n"NOR,this_object());
                return 1;
        }
         if(who->query("baobiao/愿意帮忙"))
            {
                message_vision(CYN"$N说道："+RANK_D->query_respect(who)+"此去三花堂夺旗，要多加小心啊。\n"NOR,this_object());
                return 1;
        }
        if(who->query("baobiao/去夺镖旗"))
            {
                message_vision(CYN"$N说道："+RANK_D->query_respect(who)+"此去城南乱葬岗夺旗，要多加小心啊。\n"NOR,this_object());
                return 1;
        }
         if(who->query("jiebiao/夺回镖旗"))
         {
                 command("heng");
           message_vision(CYN"$N说道：就是你个"+RANK_D->query_rude(who)+"夺我镖旗，居然还敢来此！\n"NOR,this_object());
           ::kill_ob(who);
                return 1;
                
        }
        if(who->query("jiebiao/愿意帮忙"))
         {
                 command("heng");
                        message_vision(CYN"$N说道："+RANK_D->query_rude(who)+"岂想夺我镖旗，拿命来！\n"NOR,this_object());
                        ::kill_ob(who);
                return 1;
        }
        if(who->query("jiebiao/去送镖旗"))
         {
                 command("heng");
                        message_vision(CYN"$N说道："+RANK_D->query_rude(who)+"夺我镖旗，拿命来！\n"NOR,this_object());
                        ::kill_ob(who);
                return 1;
        }
        message_vision(HIW"$N叹了口气，说道：五花翎旗是我们振远镖局的镖旗，也是镖局的象征。\n
不久前，五花翎旗被三花堂所劫，我们去夺了好几次，损伤了好些兄弟，也未成功，你可愿助我一臂之力(answer yes/no)？\n",this_object());
        add_action("do_answer","answer");
        who->set_temp("baobiao/询问镖旗",1);
        return 1;
}
int do_answer(string arg)
{
        object who=this_player();
        if(!who->query_temp("baobiao/询问镖旗"))
                return 0;
        if(!arg)
         { message_vision("$N皱了皱眉。\n",this_object());
           return 1;
        }
        if(arg!="yes"&&arg!="no")
         {  message_vision("$N皱了皱眉。\n",this_object());
            return 1;
        }
        
        if(arg=="yes")
         {
            if(who->query("baobiao/愿意帮忙")=="fail")
                 {  message_vision("$N说道：这位"+RANK_D->query_respect(who)+"既然不愿意相助，不必多言。\n",this_object());
                    return 1;
                }
            message_vision(HIR+"$N红着脸，一字一字的说道："+RANK_D->query_self(who)+"虽然不才，但是路见不平，拔刀相助正是我辈份内之事。\n"+NOR,who);
            message_vision("$N大喜，说道："+RANK_D->query_respect(who)+"肯相助真是太好了,三花堂那帮贼匪狡猾异常，你要多加小心呀。\n",this_object());
            who->set("baobiao/愿意帮忙",1);
           
            return 1;
        }
        if(arg=="no")
         {
                 message_vision(HIY+"$N哼了一声，说道："+RANK_D->query_self(who)+"可没功夫管这等鸡毛蒜皮的小事。\n"+NOR,who);
                 who->set("baobiao/愿意帮忙","fail");
                 return 1;
         }
                 



}
int ask_jiebiao()
{
       
        return 1;
      
}

void reset()
{
      
} 
void unconcious()
{

die();
}

void die ()
{
object biaoqi;  
 object who=this_player();
  object me = this_object();
  object ob = query_temp("last_damage_from");
  object killer=query_temp("my_killer");
  object last =query_temp("last_killed_by");
  string faint=query_temp("last_fainted_from");
  if(!ob)
  {
                                set("eff_kee", 2000);
        set("eff_sen",1100);
        set("eff_gin",600);
        set("kee",2000);
        set("sen",1100);
        set("gin",600);
                    
          return;       
        
}
if(!ob->query("jiebiao/愿意帮忙"))
        { 
                        set("eff_kee", 2000);
        set("eff_sen",1100);
        set("eff_gin",600);
        set("kee",2000);
        set("sen",1100);
        set("gin",600);
                    
         
         return;
        }
   if(faint && ob) {
      if(faint!=ob->query("id"))
                {
                        set("eff_kee", 2000);
        set("eff_sen",1100);
        set("eff_gin",600);
        set("kee",2000);
        set("sen",1100);
        set("gin",600);
                      return;
                }
        }
      if(!last) last=ob;
         else if(last!=ob)
        { 
                        set("eff_kee", 2000);
        set("eff_sen",1100);
        set("eff_gin",600);
        set("kee",2000);
        set("sen",1100);
        set("gin",600);
                    return;
                    
                    
      }
  
   message_vision(CYN"萧升哼了一声，道：君子报仇十年不晚，你等着。"NOR,who);
    message_vision(CYN"说罢，纵身夺路而去。\n "+"$N一看墙上挂的正是五花翎旗，赶紧揣入怀中。\n"NOR,who);
  biaoqi=new("/d/baobiao/obj/biaoqi");
        biaoqi->move(ob);
        biaoqi->set("owner_id",ob->query("id"));
        ob->delete("jiebiao/愿意帮忙");
        ob->set("jiebiao/去送镖旗",1);
  destruct(this_object());
    return ;
}

