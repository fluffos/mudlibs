inherit NPC;
#include <ansi.h>

void leave();
void set_skills(int level, int value, object who);

void setname() {

  string name;
  name = random(2) ? HIR "镖头" NOR : HIY "武师" NOR;

  set_name(name, ({ "biao tou" }));

}
void create() {
  setname();
  set("age", 25 + random(10));
  set("gender", "男性");
  set("attitude", "heroism");
  set("str", 40);
  set("cor", 40);
  set("con", 40);
  set("int", 10);
  set("spi", 10);
  set("cps", 40);
  set("kar", 40);
  set("max_gin", 1000);
  set_weight(100000);
  set("no_steal", 1);
  set("no_arrest", 1);
  set("title", HIW "镖行天下" NOR);
  set_temp("wuxing/init_done", 1);   //防止在setup中初始化错误的五行属性..
  set("bellicosity", 400);
  setup();
  carry_object("/d/obj/armor/tiejia")->wear();

}

void init() {
  add_action("do_cast", "cast");
  add_action("do_ji", "ji");

}
int do_ji(string arg) {

  message_vision(CYN "$N磨了磨牙道：表用这么nb的宝物对付我们吧。。。\n", this_object());
  return 1;

}

int do_cast(string arg) {
  object who = this_player();
  string cast_id, cast_name;
  if (!arg) return 0;

  if (sscanf(arg, "%s on %s", cast_id, cast_name) == 2) {
    if (cast_id == "qiankun" || cast_id == "zhuang" || arg == "qiankun" || arg == "zhuang") {
      message_vision(CYN "$N瞪眼道：欺负俺们不会法术是么。。。\n", this_object());
      return 1;

    } else return 0;
  } else if (sscanf(arg, "%s", cast_id) == 1) {
    if (cast_id == "qiankun" || cast_id == "zhuang" || arg == "qiankun" || arg == "zhuang") {
      message_vision(CYN "$N瞪眼道：欺负俺们不会法术是么。。。\n", this_object());
      return 1;

    } else return 0;

  } else return 0;
}

void invocation(int level, int value, object who) {


  remove_call_out("leave");
  call_out("leave", 500 + random(100));
  set("owner", who);

  set_skills(level, value, who);

  return;

}
int heal_up() {

  if (query("eff_kee") * 100 < query("max_kee") * 90) {
    command("eat yao");
    command("exert recover");
  }
  if (query("eff_sen") * 100 < query("max_sen") * 90) {
    command("eat dan");
    command("exert refresh");
  }
  if (query("kee") * 100 < query("max_kee") * 75) {
    command("exert recover");
  }
  if (query("sen") * 100 < query("max_sen") * 75) {
    command("exert refresh");
  }
  if (environment(this_object()))
    command("kill biao tou");
  return ::heal_up() + 1;
}

int accept_fight(object ob) {
  object me = this_object();
  if (ob != me->query("owner")) {
    message_vision(CYN "$N说道：快帮忙杀强盗啊。\n" NOR, me);
    return 0;
  } else {

    me->kill_ob(ob);
    ob->kill_ob(this_object());
    return 1;


  }
}
void kill_ob(object ob) {
  object me = this_object();
  if (userp(ob)) {
    if (ob != me->query("owner")) {
      message_vision(CYN "$N说道：救命啊救命啊有人打劫！\n" NOR, me);
      me->remove_killer(ob);
      ob->remove_killer(me);
      return;
    }
    if (is_fighting(ob)) return;
    message_vision("$N" + HIR "大喊道：救命啊救命啊，有人打劫镖车啦。\n" NOR, me);
    ::kill_ob(ob);
  }
}

void die() {
  object who = this_object();
  object me = query("owner");
  message_vision("$N大喊一声，说道：三十六计，走先。\n", who);
  if (!random(3))  //test
  {
    this_object()->set("is_diablo_npc", 1);
    this_object()->set(
      "magic_find",
      1 + 60 * (me->query("hubiao/level")) + 15 * (me->query("hubiao/value"))
    );
    DIABLO_D->diablo_drop(this_object(), me);

  }

  destruct(this_object());
}
void unconcious() {
  die();
}

void leave() {
  object me = this_object();
  if (me->is_fighting() || me->is_busy())
    return;
  if (this_object()) {
    if (environment()) {
      message("vision", HIB + name() +
        "哈哈大笑几声，遁向远处。\n" NOR, environment());
    }
    destruct(this_object());
    return;
  }
  remove_call_out("leave");
  call_out("leave", 60);
  leave();
}

void set_skills(int level, int value, object who) {
  int *levels, max_level;
  int dx, exp;
  int kee, sen;
  mapping skill = who->query_skills();
  int i = sizeof(skill);
  if (i > 0) {
    levels = values(skill);
    max_level = levels[0];
    while (i--) {  // find out victim's maximum level
      if (levels[i] > max_level)
        max_level = levels[i];
    }
    max_level = max_level;

  } else max_level = 1;
  exp = who->query("combat_exp") + random(who->query("combat_exp") / 2);
  dx = who->query("daoxing") + random(who->query("combat_exp") / 2);
  kee = who->query("max_kee");
  sen = who->query("max_sen");
  kee = kee * (1 + level) + (120 + random(300)) * value;
  sen = sen * (1 + level) + (100 + random(200)) * value;
  if (kee > 25000) kee = 24000 + random(1500);
  if (sen > 22000) sen = 20000 + random(2500);        //降低难度。。。
  set("kee", kee);
  set("max_kee", kee);
  set("eff_kee", kee);
  set("sen", sen);
  set("max_sen", sen);
  set("eff_sen", sen);
  set("combat_exp", exp);
  set("daoxing", dx);
  set_temp("apply/armor", 120 * level + 25 * value);
  set_temp("apply/damage", 50 * level + 15 * value);
  set_skill("blade", max_level + 5 * level + random(10) * value);
  set_skill("hammer", max_level + 5 * level + random(10) * value);
  set_skill("sword", max_level + 5 * level + random(10) * value);
  set_skill("fork", max_level + 5 * level + random(10) * value);
  set_skill("dodge", max_level + 7 * level + random(12) * value);
  set_skill("spear", max_level + 5 * level + random(10) * value);
  set_skill("stick", max_level + 5 * level + random(10) * value);
  set_skill("parry", max_level + 5 * level + random(10) * value);
  set_skill("unarmed", max_level + 7 * level + random(12) * value);
  set_skill("staff", max_level + 5 * level + random(10) * value);
  set_skill("axe", max_level + 5 * level + random(10) * value);
  set_skill("yange-blade", (int)max_level + random(10 * level));
  set_skill("huntian-hammer", (int)max_level + random(10 * level));
  set_skill("sanqing-jian", (int)max_level + random(10 * level));
  set_skill("fengbo-cha", (int)max_level + random(10 * level));
  set_skill("huoyun-qiang", (int)max_level + random(10 * level));
  set_skill("qianjun-bang", (int)max_level + random(10 * level));
  set_skill("changquan", (int)max_level + random(10 * level));
  set_skill("lunhui-zhang", (int)max_level + random(10 * level));
  set_skill("sanban-axe", (int)max_level + random(10 * level));
  map_skill("blade", "yange-blade");
  map_skill("hammer", "huntian-hammer");
  map_skill("sword", "sanqing-jian");
  map_skill("fork", "fengbo-cha");
  map_skill("spear", "huoyun-qiang");
  map_skill("stick", "qianjun-bang");
  map_skill("staff", "lunhui-zhang");
  map_skill("unarmed", "changquan");
  map_skill("axe", "sanban-axe");

  set_skill("force", max_level + 5 * level + random(10) * value);
  set_skill("spells", 100);
  set_skill("zhenyuan-force", max_level + 5 * value + random(10) * level);
  map_skill("force", "zhenyuan-force");
  set("force", query_skill("force") * 20);
  set("max_force", query_skill("force") * 11);
  set("force_factor", query_skill("force") / 3);
  set("chat_chance_combat", 40 + level * 5 + value * 2);
  carry_object("/d/obj/drug/jinchuang")->set_amount(2 + random(value) + level);
  carry_object("/d/obj/drug/hunyuandan")->set_amount(2 + random(value) + level);
