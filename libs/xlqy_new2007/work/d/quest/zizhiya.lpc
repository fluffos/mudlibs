#include <ansi.h>
inherit ROOM;
int check_ratio(object me, object ob);
int check_base_reward(object ob, int ratio);
void reward(object me,object ob);
string chinese_daoxing(int gain);

void create()
{
	set("short", "紫芝崖");
	set("long", @LONG
六魂坛前飞霞红气，紫电清光，有多少着层层密密，凶凶顽顽，
真个是杀气腾腾，愁云漠漠。
        
LONG);
  set("exits", ([
        "northup" : __DIR__"guandao4",
      ]));

  set("objects", 
        ([ //sizeof() == 1
            __DIR__"npc/guang" : 1,
       ]));

  set("outdoors", __DIR__);
        set("no_fight",1);
       set("no_magic",1);
       set("no_get",1);
       set("no_steal",1);
       set("no_put",1);

  setup();
  
}

void init()
{
    add_action("do_no", "kill");
    add_action("do_no", "fight");
    add_action("do_no", "get");
    add_action("do_no", "put");
    add_action("do_no", "cast");
    add_action("do_no", "exert");
    add_action("do_no", "perform");
    add_action("do_no", "ti");
    add_action("do_no", "steal");
    add_action("do_no", "ji");
    add_action("do_drop", "drop");
  
}

int do_no()
{
   tell_object(this_player(),"六魂坛前休得撒野,速速离开!\n");
   return 1;
}


int do_drop(string arg)
{
   object me=this_player();
   object obj;
   
   if( !arg ) return 0;
      
   
    if( ( me->query("family/family_name") == "方寸山三星洞"
            || me->query("family/family_name") == "南海普陀山"
            || me->query("family/family_name") == "将军府"
            || me->query("family/family_name") == "月宫"
            || me->query("family/family_name") == "盘丝洞"
            || me->query("family/family_name") == "东海龙宫" 
            || me->query("family/family_name") == "蜀山剑派"
            || me->query("family/family_name") == "幻世勇者"
            || me->query("family/family_name") == "五庄观"))
             
       {
          message_vision("\n定光仙哼了一声说：我教与你等素无往来,快走。\n",me);
	  return 1;
	}
   
   if (me->query("zhaohun/put_allowed")> time())
      return notify_fail("定光仙说：现在我没空,等下再来! \n");   
   
   if( !objectp(obj = present(arg, me)) )
          {  tell_object(me,"你身上没有这样东西。\n");
             return 1;
          }
  
          
    if( !obj->is_character() )
           {  tell_object(me,"定光仙说道：“不要在这里乱丢垃圾。”\n");
             return 1;
          }
               
    if( userp(obj) )
	{
		tell_object(me,"定光仙说道:“我们这里不要这种东西。” \n");
		return 1;
	}
    if( obj->is_corpse())
                   {  tell_object(me,"定光仙说道：“不要在这里乱丢垃圾。”\n");
                      return 1;
                   }
                   
         
    if (obj->query_temp("last_fainted_from")!=me->query("id"))
     {  
     	tell_object(me,"定光仙说道：“借助他人之手,不算本事。”\n");
        return 1 ;
     }
/*
 if(obj->query("age") < 20)
     {
          tell_object(me,"定光仙大喜说：好!好!我喜欢吃小孩子! \n"NOR);
          return 1;
      }    
*/

     if(obj->query("title")=="散仙"||obj->query("title")=="妖怪")
      {
      	  tell_object(me,"定光仙说：这个人不能拜 \n");
      	  return 1 ;
     }
     
     if (obj->query("race") != "人类")
        {
          tell_object(me,"定光仙大喜说：好!好!正好烤了吃 \n"NOR);
          return 1;
     }

     if(obj->query("class")=="yaomo")    
     {
        tell_object(me,"定光仙大惊失色地说：这个人是教主的第子,快快放了! \n"NOR);
        return 1;
      }

            
    
          if( obj->query("family/family_name") == "陷空山无底洞"
            || obj->query("family/family_name") == "大雪山"
            || obj->query("family/family_name") == "火云洞"
            || obj->query("family/family_name") == "阎罗地府")
         {
      
        tell_object(me,"定光仙大惊失色地说：这个人是教主的第子,快快放了! \n"NOR);
        return 1;
     }
  
     reward(me,obj);
     
     return 1;


}      

int check_ratio(object me, object ob)
{
    int ratio;
    int myexp, neidanexp;

    neidanexp=ob->query("daoxing");   // neidanexp 是被卖者的强度。这里改成道行。
    myexp=me->query("daoxing");   // myexp 是卖者的强度。也改成道行。

 if (myexp <=0) myexp=1;
   
    ratio=neidanexp*100/myexp;
    if(ratio>150) ratio = 150;
    else if (ratio < 100)
      ratio = ratio * ratio / 100;   // 如果太低，平方，防止高手杀太低的NPC、玩家。
    return ratio;
}

int check_base_reward(object neidan, int ratio)
{
    int neidanexp=neidan->query("daoxing"), base_reward;
    int adjust=ratio/10;

   if (neidanexp > 6000000)
      base_reward=1000; 
   else if (neidanexp > 4000000)
      base_reward=800; 
    else if (neidanexp > 2000000)
   base_reward=600; 
    else if(neidanexp>1000000)
        base_reward=500;
    else if(neidanexp>500000)
        base_reward=400;
    else if(neidanexp>200000)
        base_reward=300;
    else if(neidanexp>100000)
        base_reward=250;
    else if(neidanexp>50000)
        base_reward=200;
    else if(neidanexp>10000)
        base_reward=150;
    else if(neidanexp>1000)
        base_reward=80;
    else base_reward=50;

    if (userp(neidan)) base_reward *= 2;  

    return base_reward;
}

void reward(object me,object ob)
{
    
  int  ratio, base_reward, rewards, pot;
  ratio=check_ratio(me, ob);
  base_reward=check_base_reward(ob, ratio);
  rewards = base_reward * ratio/100+1;
    if (rewards>12500) rewards = 12500;
  pot = rewards/3 + 1 ;  
  
  if(living(ob)) 
  {
     message_vision ("$N大叫一声，化做一到清风遁去了",ob);
     ob->move("/cmds/std/quitroom");
     destruct(ob);
     return ;
  }

	
   tell_room(me,"定光仙将六恶连展数展,"+ob->name()+"的魂魄顿时被六魂坛收入 \n");

 message_vision ("$N对$n一拜：教主法旨意这位"+ RANK_D->query_respect(me)+"拜恶招魂有功,特奖励" + chinese_daoxing(rewards)+"道行和！\n",this_object(),me);
CHANNEL_D->do_channel(this_object(), "rumor",me->query("name")+"将"+ob->query("name")+"拜入六魂坛,得到了"+chinese_daoxing(rewards)+"道行!\n");
     me->set("zhaohun/last_put", ob->query("id"));
     me->add("zhaohun/put_count", 1);
   me->set("zhaohun/put_allowed", time()+ 300 +random(150));
  me->add("daoxing",rewards);
// me->add("potential",pot);
     me->add("zhaohun/reward_got",rewards);
     ob->move("/cmds/std/quitroom");
     destruct(ob); 
}

string chinese_daoxing(int gain)
{
            int year,day,hour;
             string str;

             year=gain/1000;
             day=(gain-year*1000)/4;
             hour=(gain-year*1000-day*4)*3;
             str="";
             if(year) str=str+chinese_number(year)+"年";
             if(day) str=str+chinese_number(day)+"天";
             if(hour) str=str+chinese_number(hour)+"时辰";

             return str;
}

