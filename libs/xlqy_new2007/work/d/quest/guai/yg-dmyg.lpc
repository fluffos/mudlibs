inherit __DIR__"guai.lpc";
void do_lianzhao()
{
		
		command("perform damoyange");
		command("cast zhenhuo");

	}

void set_skills(int max_value, int level)
{
        int guai_value;
             object weapon;
         object me = this_object();
        ::set_skills(max_value, level);
        create_family("五庄观", 3, "弟子");
        if (level==1) guai_value = max_value+max_value/8;
        else if (level==2) guai_value = max_value+max_value/6;
        else guai_value = max_value+max_value/4;
            set_skill("unarmed", guai_value+random(50));
          set_skill("parry", guai_value+random(50));
        set_skill("wuxing-quan", guai_value+random(50));
        set_skill("baguazhen", guai_value+random(50));
        set_skill("blade", guai_value+random(50));
        set_skill("yange-blade", guai_value+random(50));
        set_skill("zhenyuan-force", guai_value+random(50));
        set_skill("literate", 180);
        set_skill("taiyi", guai_value+20+random(50));
        map_skill("spells", "taiyi");
        map_skill("force", "zhenyuan-force");
        map_skill("unarmed", "wuxing-quan");
        map_skill("blade", "yange-blade");
        map_skill("parry", "yange-blade");
        map_skill("dodge", "baguazhen");
      
              if(guai_value > 200)
        	 set("skill_level/blade","expert");
          if(guai_value > 300)
               	 set("skill_level/blade","master");   
        if(guai_value > 600)
               	 set("skill_level/blade","grandmaster");   
        set("force_factor", query_skill("force")/2);
        set("mana_factor", query_skill("spells",1));
        
        set("chat_chance_combat",85);
          set("chat_msg_combat", ({
          (: perform_action, "blade", "damoyange" :),
          (: exert_function,"resist" :),
          (: exert_function,"powerup" :),
          (: cast_spell, "wuxing" :),
      		(:  do_lianzhao :),
         }) );                
         weapon=new("/d/obj/weapon/blade/jindao");
        weapon->move(me);
        
        command("wield all");
}



