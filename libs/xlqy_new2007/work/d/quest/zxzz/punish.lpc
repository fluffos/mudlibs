#include <ansi.h>
inherit ROOM;

void create() {
  set("short", "天地玄境");
  set("long", @LONG

周围一片虚无，任何人在这里都会觉得身体软绵绵的，好似漂浮在空中一般，动弹不得。
LONG
  );

  set("valid_startroom", 1);
  set("no_fight", 1);
  set("no_magic", 1);

  setup();

}

void init() {
  if (!wizardp(this_player())) {
    this_player()->set("startroom", "/d/quest/zxzz/punish");
    this_player()->save();
    add_action("block_cmd", "", 1);
  }
}

int block_cmd() {
  string verb = query_verb();

  if (verb == "say") return 0;  //allow say
  if (verb == "help") return 0;
  if (verb == "look") return 0;
  return 1;
}
