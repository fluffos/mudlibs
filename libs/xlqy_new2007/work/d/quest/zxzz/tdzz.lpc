void init() {
  object me = this_object();
  object who = this_player();
  int i, dcnt = 0;

  int t = query("stay_time");

  ::init();
  add_action("do_no", "ji");
  add_action("do_qkdf", "cast");
  add_action("do_block", "", 1);
  add_action("do_burn", "burn");
  add_action("do_kill", "kill");
  add_action("do_protect", "protect");
  add_action("do_pfm", "perform");
  add_action("do_exert", "exert");

  if (t && time() > (t + 900)) {
    remove_call_out("leave");
    call_out("leave", 1);
    return;
  }

  if (t && time() > t) {
    remove_call_out("_leave");
    call_out("_leave", 900);
  }


  /*for( i=0;i<sizeof(players_k);i++)
     	if( players_k[i]->query_temp("zxzz_killed") )
    		dcnt++;
    
    if( dcnt==sizeof(players_k) && me->query("kill_started") ) //k npc者全挂了，给奖励
    {
    	remove_call_out("reward_g");
    	call_out("reward_g",1);
    }*/  //此段加到了假死判断中，及时给奖励

}

int do_pfm(string arg) {
  string pfm_id, pfm_name, cname = this_object()->name();
  object who = this_player();
  int kst = this_object()->query("kill_start");

  if (!arg) return 0;
  if (sscanf(arg, "%s", pfm_id) == 1) {
    if ((arg == "chaofeng" || pfm_id == "chaofeng") && !kst) {
      tell_object(who, "还没开战就想用百鸟朝凤？想搞破坏啊！\n");
      return 1;
    }
    if (arg == "dodge.xukong" || pfm_id == "dodge.xukong") {
      tell_object(who, "雕虫小技就不要在我面前演了。\n");
      return 1;
    }
  }

  if (sscanf(arg, "%s on %s", pfm_id, pfm_name) == 2) {
    if ((pfm_name == "tiandi zhizun" || pfm_name == "tdzz" || pfm_name == "zhizun") && !kst) {
      tell_object(who, "战斗还未开始，你没法对" + cname + "使用外功。\n");
      return 1;
    }
    if (pfm_id == "chaofeng") {
      tell_object(who, "还没开战就想用百鸟朝凤？想搞破坏啊！\n");
      return 1;
    }
    if (pfm_id == "dodge.xukong") {
      tell_object(who, "雕虫小技就不要在我面前演了。\n");
      return 1;
    }
  }
  return 0;
}

int do_exert(string arg) {
  string exert_id;
  int kst = this_object()->query("kill_start");
  object who = this_player();

  if (!arg) return 0;
  if (sscanf(arg, "%s", exert_id) == 1) {
    if ((arg == "roar" || exert_id == "roar") && !kst) {
      tell_object(who, "还没开战就想瞎吼？想搞破坏啊！\n");
      return 1;
    }
  }
  return 0;
}

int do_qkdf(string arg) {

  string cast_id, cast_name;
  object who = this_player();
  int kst = this_object()->query("kill_started");

  if (!arg) return 0;
  if (sscanf(arg, "%s", cast_id) == 1) {
    if (arg == "qiankun" || cast_id == "qiankun") {
      tell_object(who, "在天地至尊面前还想用袖里乾坤？！\n");
      return 1;
    }

    if ((member_array(arg, dunfa) != -1 || member_array(cast_id, dunfa) != -1) && kst) {
      if (member_array(who->query("family/family_name"), family_name_x) != -1) {  //邪派
        tell_object(who, "在天地至尊面前还想溜？！\n");
        return 1;
      } else {  //正派
        tell_object(who, "保护" + this_object()->name() + "的任务还没完成，不能逃走!\n");
        return 1;
      }
    }
  }

  if (sscanf(arg, "%s on %s", cast_id, cast_name) == 2) {

    if (cast_id == "qiankun" || arg == "qiankun") {

      tell_object(who, "在天地至尊面前还想用袖里乾坤？！\n");
      return 1;
    }
    if (member_array("cast_id", summon) && !kst) {
      tell_object(who, "战斗还未开始，不能召唤护法。\n");
      return 1;
    }
    if ((member_array(find_player(cast_name), players_k) != -1
      || member_array(find_player(cast_name), players_g) != -1)
      && find_player(cast_name) != who
      && !kst) {
      tell_object(who, "战斗还未开始就动手？\n");
      return 1;
    }
    if ((cast_name == "tiandi zhizun" || cast_name == "tdzz" || cast_name == "zhizun") && !kst) {
      tell_object(who, "战斗还未开始你就想对天地至尊使用法术？\n");
      return 1;
    }
    if ((cast_id == "wuxing" && cast_name == who->query("id")
      || member_array("arg", dunfa) != -1)
      && kst) {  //战斗开始后不许使用遁法

      if (member_array(who->query("family/family_name"), family_name_x) != -1) {  //邪派
        tell_object(who, "在天地至尊面前还想溜？！\n");
        return 1;
      } else {  //正派
        tell_object(who, "保护" + this_object()->name() + "的任务还没完成，不能逃走!\n");
        return 1;
      }
    }
  } else return 0;
}

int do_burn(string arg)  //jjf弟子burn escape
{
  string burn_id;
  object who = this_player();
  object me = this_object();

  if (!arg) return 0;
  if (sscanf(arg, "%s", burn_id) == 1) {
    if (arg == "escape" || burn_id == "escape") {
      message_vision("$N手脚笨拙地想燃着手中的逃命符，但在$n面前岂能得逞？！\n", who, me);
      return 1;
    }
  } else return 0;
}

int do_no(string arg) {
  object who = this_player();
  object me = this_object();
  message_vision("$N鬼鬼遂遂不知想干什么，$n威严地盯着$N，吓得$N不知所措。\n", who, me);
  return 1;
}

int do_kill(string arg) {
  object who = this_player();
  object me = this_object();
  object where = environment(me);
  int i;

  if (!arg) return 0;
  if ((arg == "tiandi zhizun" || arg == "zhizun" || arg == "tdzz")) {
    if (member_array(who->query("family/family_name"), family_name_x) != -1) {  //邪派玩家
      if (who->query("combat_exp") < 1000000) {
        message_vision("\n$n对$N微微一笑：看你入魔道不久，回头还来得及，去吧，我不伤你!\n", who, me);
        return 1;
      }
      if (sizeof(players_k) < 1) {  //参加任务的邪派玩家数为0
        if (call_player_k(who)) {
          players_k += ({ who });
          who->set_temp("zxzz_job", 1);
          me->set("exp_ref", who->query("combat_exp"));
          message_vision("\n$n不屑地对看了$N一眼道：就你一个小喽罗?把帮手叫齐让我一块儿收拾你们吧!\n", who, me);
          check_golem(who);
        }
        return 1;
      } else if (sizeof(players_k) < 2) {  //已参加任务的邪派玩家数为1
        if (member_array(who, players_k) == -1) {  //不是已经参加任务的玩家
          if (check_exp(who, me->query("exp_ref"))) {  //wx符合条件
            players_k += ({ who });
            who->set_temp("zxzz_job", 1);
            message_vision("\n$n看了$N一眼，叹道：罢罢罢，不教训一下你们这些歪门邪道，你们也不知道厉害!\n"
              + "不待本尊者出手，待我召唤几个正道弟子就可收拾了你们!\n", who, me);
            check_golem(who);
            call_out("call_player_g", 1);
            return 1;
          } else {  //wx不符合条件
            if (who->query("combat_exp") < me->query("exp_ref"))
              tell_object(who, "你武学太低，恐怕自己反倒被k，还是作罢吧!\n");
            else
              tell_object(who, "你武学太高，不适合参加本次任务!\n");

            return 1;
          }
        } else {  //已经参加任务的玩家
          message_vision("\n$n对$N冷笑道：你急什么，待会有你好看的!\n", who, me);
          return 1;
        }
      } else if (sizeof(players_k) >= 2) {  //已参加任务的玩家数为2，已满
        if (member_array(who, players_k) == -1)  //不是已参加任务的玩家
        {
          tell_object(who, "已经有足够的你的同道中人参加此次任务了!\n");
          return 1;
        } else   //已参加任务的玩家
        {
          if (sizeof(players_g) < 2)  //保护npc的玩家数不够
          {
            tell_object(who, me->name() + "召唤的玩家还没到齐！\n");
            return 1;
          }
          /************可以不要，玩家不在场可以move过来*****************
		    	            	 else  //保护npc的玩家到齐
		    	            	 {
		    	            	 	   for(i=0;i<sizeof(players_g);i++)
		    	            	 	   {
		    	            	 	   	  if(!present(players_g[i],where))   //有玩家不在场
		    	            	 	   	  {
		    	            	 	   	  	tell_object(who,"保护"+me->name()+"的玩家有的不在场!\n");
		    	            	 	   	  	return 1;
		    	            	 	   	  }
		    	            	 	   }
		    	            	 }
		    	            	 **************战斗的开始由this_object控制********************/
        }
      }
    } else {
      message_vision("\n$n瞪了$N一眼:你正派中人瞎起什么哄？\n", who, me);
      return 1;
    }

    if (!me->query("kill_started")) {
      message("zxzz", HIR "\n****正邪之战马上开始，请做好准备!****\n\n", players_k);
      message("zxzz", HIR "\n****正邪之战马上开始，请做好准备!****\n\n", players_g);
      remove_call_out("kill_start");
      call_out("kill_start", 5);
    }
  }

  if ((member_array(find_player(arg), players_g) != -1
    || member_array(find_player(arg), players_k) != -1)  //被杀者为参加任务的玩家
  && (sizeof(players_g) < 2 || sizeof(players_k) < 2)  //参加任务的玩家数量不够
  && (member_array(who, players_g) != -1 || member_array(who, players_k) != -1))  //杀人者为参加任务的玩家
  {
    if (((member_array(find_player(arg), players_g) != -1)
      && (member_array(who, players_g) != -1))  //被杀者和杀人者同为保护npc玩家
    || ((member_array(find_player(arg), players_k) != -1)
      && (member_array(who, players_k) != -1)))  //被杀者和杀人者同为k npc玩家
    {
      tell_object(who, find_player(arg)->name() + "可是你的同盟！\n");
      return 1;
    } else {
      tell_object(who, "时机未到，暂时不能动手！\n");
      return 1;
    }
  }
}

int do_protect(string arg) {
  object who = this_player();
  object me = this_object();

  if (!arg) return 0;
  if (member_array(who, list) != -1)  //满足保护条件的玩家
  {
    if (arg != "tiandi zhizun" && arg != "zhizun" && arg != "tdzz") {
      write("你要保护谁？\n");
      return 1;
    } else {
      if (sizeof(players_g) >= 2) {
        write("已经有足够的玩家保护" + me->name() + "了!\n");
        return 1;
      } else  //只有此种情况可使用protect命令
      {
        players_g += ({ who });
        who->set_temp("zxzz_job", 1);
        message_vision("\n$n拍了拍$N的肩膀:好样的！\n", who, me);
        check_golem(who);
        if (sizeof(players_g) == 2)  //人都到齐了，5s后开杀
        {
          //tell_room( environment(me),HIR"\n正邪之战马上开始，请大家做好准备!\n"NOR );
          message("zxzz", HIR "\n****正邪之战马上开始，请大家做好准备!****\n\n", players_k);
          message("zxzz", HIR "\n****正邪之战马上开始，请大家做好准备!****\n\n", players_g);

          remove_call_out("punish_all_list");
          remove_call_out("reward_g");
          call_out("reward_g", 480);
          remove_call_out("kill_start");
          call_out("kill_start", 5);
        }
      }
    }
  } else     //不合条件的玩家不能使用protect命令
  {
    if (member_array(who->query("family/family_name"), family_name_x) != -1)  //不是正派玩家
    {
      write("你杀他还来不及呢，还保护？\n");
      return 1;
    } else if (!sizeof(list))   //剩下的不合条件的就是wx不够的了？还有可能是list为空（表示还没召唤玩家）
    {
      write(me->name() + "现在还不需要保护。\n");
      return 1;
    } else {
      if (who->query("combat_exp") < me->query("exp_ref"))
        write("恐怕你修为不够，还是明哲保身吧！\n");
      else
        write("你修为甚高，不劳烦你参加此次任务！\n");

      return 1;
    }
  }

}

void kill_ob(object ob) {
  object me = this_object();
  object where = environment(me);
  int i, level, level_temp;

  if (me->query("diy") && !me->query("copied")) {
    level = 0;
    for (i = 0; i < sizeof(players_k); i++) {
      level_temp = NPC_D->get_skill_level(players_k[i]);
      if (level_temp > level)
        level = level_temp;
    }
    STATU_D->set_npc_skill(me, level, "方寸山三星洞");
    NPC_D->set_npc_hp(me, ob, 100);
    NPC_D->full_hp_status(me);
    set("force_factor", 300);
    set("mana_factor", 300);
    set_temp("apply/attack", 200);
    set_temp("apply/defense", 200);
    set_temp("apply/armor", 250);
    set_temp("apply/damage", 250);
    carry_object(__DIR__ "obj/xtg")->wield();
    command("perform qiankun");
    me->set("copied", 1);
    reset_eval_cost();
  }

  for (i = 0; i < sizeof(players_g); i++) {
    if (present(players_g[i], where)) {
      message_vision("$n一个箭步冲了上去，挡在了" + me->name()
        + "面前，冲$N呵道：“休得无礼！”\n", ob, players_g[i]);
      players_g[i]->kill_ob(ob);
    }
  }

  ::kill_ob(ob);
}

void die() {
  object ob = query_temp("last_damage_from");
  object me = this_object();
  object where = environment(me);

  for (int i = 0; i < sizeof(players_g); i++) {
    if (present(players_g[i], where) && players_g[i]->query_temp("zxzz_job")) {
      message_vision("\n$N微微一笑，马上神采奕奕。\n", me);
      NPC_D->full_hp_status(me);
      return;
    }
  }

  if (!ob) {
    leave();
    return;
  }

  remove_call_out("reward_g");
  message("system", HIG "【" + HIR + "正邪之争" + HIG + "】" + me->name()
    + "：这次算你们这帮邪魔歪道走运，下次可每那么便宜了！\n" NOR, users());  //下面应该给k npc者奖励
  reward_k();

}

void unconcious() {
  die();
}

void _leave() {
  object me = this_object();
  if (me->is_fighting() || me->is_busy())
    return;
  leave();
}

void leave() {
  object me = this_object();
  object where = environment(me);

  if (this_object()) {
    if (environment(me)) {
      command("say 来到凡尘已够久了，我该回去了。。。");
      message("vision", HIB + name() +
        "化作一道彩光，直冲云霄。\n" NOR, environment());
    }
    destruct(this_object());
  }
  return;
}

int invocation(int i) {
  object me = this_object();
  if (!random_place(me, dirs[i])) return 0;
  return 1;
}

int random_place(object me, string dirs) {
  int j, k;
  object newob;
  mixed *file, exit;
  file = get_dir(dirs + "/*.lpc", -1);

  if (!sizeof(file)) return 1;

  for (k = 0; k < 30; k++) {  // try 30 times
    j = random(sizeof(file));
    if (file[j][1] > 0) {
      newob = load_object(dirs + "/" + file[j][0]);
      if (newob) {
        if (newob->query("no_fight") ||
          newob->query("no_magic") ||
          !(exit = newob->query("exits")) ||
          sizeof(exit) < 1)
          continue;

        if (me->move(newob)) {
          message_vision("$N走了过来。\n", me);
          return 1;
        }
      }
    }
  }

  return 0;
}

int call_player_k(object ob) {
  int i, lcnt = 0;
  string msg, strin;
  string *lmsg;
  list_k = objects((: userp :));
  list_k = filter_array(list_k, (: interactive :));
  list_k = filter_array(list_k, (: filter_z :));
  list_k = filter_array(list_k, (: check_exp :), ob->query("combat_exp"));
  list_k -= ({ ob });

  if (sizeof(list_k) < 1) {
    tell_object(ob, "以你的武学，现在不适合做此次任务。\n");
    return 0;
  } else {
    msg = "下列弟子速来" + environment(this_object())->query("short") + "助阵:\n";
    message("zxzz", HIG "【" + HIR + "正邪之争" + HIG + "】" HIW "混世魔王(HSMW)：" HIG + msg + NOR, users());
    message(
      "zxzz",
      "                    " + HIY "┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓\n\n" NOR,
      users()
    );
    msg = "";
    for (i = 0; i < sizeof(list_k); i++) {
      strin = list_k[i]->name(1) + "(" + capitalize(list_k[i]->query("id")) + ")";
      msg = sprintf("%s%s%-18s" NOR "%s",
        msg,
        query_idle(list_k[i]) > 120 ? HIM "+" : ((list_k[i]->query("gender") == "女性") ? MAG " " : WHT " "),
        strin,
        ++lcnt % 4 ? "" : "\n");
    }
    lmsg = explode(msg, "\n");
    for (i = 0; i < sizeof(lmsg); i++) {
      message("zxzz", "                      " + lmsg[i] + "\n", users());
    }
    message(
      "zxzz",
      "\n                    " + HIY "┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛\n" NOR,
      users()
    );
    return 1;
  }
}

void call_player_g() {
  int i, lcnt = 0;
  string msg, strin;
  string *lmsg;
  list = objects((: userp :));
  list = filter_array(list, (: interactive :));
  list = filter_array(list, (: filter_x :));
  list = filter_array(list, (: check_exp :), this_object()->query("exp_ref"));

  if (sizeof(list) < 2) {
    msg = "罢罢罢，天地之间竟无合适的正派人士除魔卫道，看来只有我亲自动手了!\n";
    message("zxzz", HIG "【" + HIR + "正邪之争" + HIG + "】" HIW "天地至尊(tdzz)：" HIG + msg + NOR, users());
    this_object()->set("diy", 1);
    message("zxzz", HIR "\n****正邪之战马上开始，请大家做好准备!****\n\n", players_k);
    message("zxzz", HIR "\n****正邪之战马上开始，请大家做好准备!****\n\n", players_g);
    remove_call_out("kill_start");
    call_out("kill_start", 5);
  } else {
    msg = "下列弟子速来(五分钟之内)" + environment(this_object())->query("short") + "护法:\n";
    message("zxzz", HIG "【" + HIR + "正邪之争" + HIG + "】" HIW "天地至尊(TDZZ)：" HIG + msg + NOR, users());
    message(
      "zxzz",
      "                    " + HIY "┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓\n\n" NOR,
      users()
    );
    msg = "";
    for (i = 0; i < sizeof(list); i++) {
      strin = list[i]->name(1) + "(" + capitalize(list[i]->query("id")) + ")";
      msg = sprintf("%s%s%-18s" NOR "%s",
        msg,
        query_idle(list[i]) > 120 ? HIM "+" : ((list[i]->query("gender") == "女性") ? MAG " " : WHT " "),
        strin,
        ++lcnt % 4 ? "" : "\n");
    }
    lmsg = explode(msg, "\n");
    for (i = 0; i < sizeof(lmsg); i++) {
      message("zxzz", "                      " + lmsg[i] + "\n", users());
    }
    message(
      "zxzz",
      "\n                    " + HIY "┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛\n" NOR,
      users()
    );

    remove_call_out("punish_all_list");
    call_out("punish_all_list", 300);  //5分钟之内玩家没到齐，punish之
  }
}

void kill_start() {
  int i, j, zxzz_mark, dif;
  object who1, who2;
  object me = this_object();
  object where = environment(me);

  zxzz_mark = 21 + random(1000);
  dif = random(20);

  me->set("kill_started", 1);  //表明已经开战，kill()函数里面的判断依据
  me->set_temp("zxzz/mark", zxzz_mark - dif);
  me->set_temp("mark_dif", dif);
  me->set_temp("zxzz_job", 1);

  if (me->query("diy")) {
    for (i = 0; i < sizeof(players_k); i++) {
      who1 = players_k[i];
      if (!present(who1, where)) {
        message_vision("天空中出现" + me->name() + "的大手，将$N抓了起来,$N顿时不见踪影！\n", who1);
        who1->move(where);
      }
      who1->set_temp("zxzz/mark", zxzz_mark);
      me->kill_ob(who1);
    }
    return;
  }

  for (i = 0; i < sizeof(players_k); i++)   //两派玩家数量相等才行，如不等，此for语句需修改
  {
    who1 = players_k[i];
    who2 = players_g[i];

    if (!present(who1, where)) {
      message_vision("天空中出现" + me->name() + "的大手，将$N抓了起来,$N顿时不见踪影！\n", who1);
      who1->move(where);
    }

    if (!present(who2, where)) {
      message_vision("天空中出现" + me->name() + "的大手，将$N抓了起来,$N顿时不见踪影！\n", who2);
      who2->move(where);
    }

    who1->set_temp("zxzz/mark", zxzz_mark);
    who2->set_temp("zxzz/mark", zxzz_mark - dif);  //mark不一样防止同队玩家趁机pk
    //如果同队玩家pk，mark一样，真死！
  }

  for (i = 0; i < sizeof(players_k); i++) {
    me->kill_ob(players_k[i]);
    for (j = 0; j < sizeof(players_g); j++) {
      players_k[i]->kill_ob(players_g[j]);
      players_g[j]->kill_ob(players_k[i]);
    }
  }
}

void reward_g() {
  int i, j;
  string *killers;
  object player;

  for (i = 0; i < sizeof(players_g); i++) {
    player = players_g[i];
    job_give(player);
    if (player->query_temp("zxzz_killed"))
      player->delete_temp("zxzz_killed");
    //message();
    killers = player->query_killer();

    for (j = 0; j < sizeof(players_k); j++)
      if (member_array(players_k[j]->query("id"), killers) != -1)
        player->remove_killer(players_k[j]);

    tell_object(player, "你被奖励了！\n");  //for test
  }

  for (i = 0; i < sizeof(players_k); i++) {
    player = players_k[i];
    job_punish(player);
    if (player->query_temp("zxzz_killed"))
      player->delete_temp("zxzz_killed");

    killers = player->query_killer();
    for (j = 0; j < sizeof(players_g); j++)
      if (member_array(players_g[j]->query("id"), killers) != -1)
        player->remove_killer(players_g[j]);
    if (member_array(this_object()->query("id"), killers) != -1)
      player->remove_killer(this_object());

    tell_object(player, "你任务失败，要受罚，嘿嘿......\n");  //for test
  }

  destruct(this_object());
}

