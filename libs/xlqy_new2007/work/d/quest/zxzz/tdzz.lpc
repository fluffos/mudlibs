void job_give(object ob) {
  int exp, base_exp, bonus, exp_get, dx_get, pot_get, gold_get, ww_get, fth_get, more_rwd;
  string str;

  exp = ob->query("combat_exp");

  if (exp < 500000) base_exp = 4800;
  else if (exp < 1200000) base_exp = 5900;
  else if (exp < 2100000) base_exp = 7200;
  else if (exp < 3200000) base_exp = 8500;
  else if (exp < 5400000) base_exp = 9800;
  else if (exp < 7500000) base_exp = 12100;
  else if (exp < 10000000) base_exp = 15400;
  else if (exp < 14000000) base_exp = 17900;
  else if (exp < 20000000) base_exp = 21500;
  else if (exp < 30000000) base_exp = 26000;
  else base_exp = 30000;

  ob->add("zxzz/count", 1);
  bonus = ob->query("zxzz/count");
  if (bonus > 100) bonus += random(bonus);
  else if (bonus > 500) bonus += bonus;
  else if (bonus > 1500) bonus = 3000 + random(bonus);

  bonus += bonus;
  exp_get = base_exp + random(500) + bonus + base_exp / 12;
  dx_get = exp_get * 3 / 2;
  pot_get = exp_get * 4 / 5 + random(500);
  gold_get = 3 + bonus / 200;

  more_rwd = ob->query("gain_more_reward") + ob->query_temp("gain_more_reward");
  more_rwd += ob->query_kar();
  exp_get += exp_get * more_rwd / 10000;
  dx_get += dx_get * more_rwd / 10000;
  pot_get += pot_get * more_rwd / 10000;
  gold_get += gold_get * more_rwd / 10000;
  ww_get = 3 + random(3);
  fth_get = 1 + random(2);

  ob->add("combat_exp", exp_get);
  ob->add("zxzz/exp", exp_get);
  ob->add("potential", pot_get);
  ob->add("zxzz/pot", pot_get);
  ob->add("daoxing", dx_get);
  ob->add("zxzz/dx", dx_get);
  ob->add("balance", gold_get * 10000);
  ob->add("zxzz/gold", gold_get);
  ob->add("weiwang", ww_get);
  ob->add("zxzz/ww", ww_get);
  ob->add("faith", fth_get);
  ob->add("zxzz/fth", fth_get);

  tell_object(ob, HIY "由于正邪之战的胜利，你被奖励了：\n" +
    chinese_number(exp_get) + "点实战经验、" +
    COMBAT_D->chinese_daoxing(dx_get) + "道行、" +
    chinese_number(pot_get) + "点潜能、" +
    chinese_number(gold_get) + "两黄金。\n" +
    NOR);
  str = ob->name() + "在正邪之战中获胜，实战经验增加了" + chinese_number(exp_get) + "点，道行提升了" + COMBAT_D->chinese_daoxing(dx_get) + "，潜能增加了" + chinese_number(pot_get) + "点，威望(+" + chinese_number(ww_get) + ")及忠诚(+" + chinese_number(fth_get) + ")提高，并获得了" + chinese_number(gold_get) + "两黄金的奖励！\n";
  message("zxzz", HIW "【正邪之争】：" + str + "\n" NOR, users());
  MONITOR_D->report_system_msg(str);
}

void job_punish(object ob) {
  string cname = this_object()->name();

  if (member_array(ob, players_g) != -1)
    tell_object(ob, "念在你保护" + cname + "的份上，就不惩罚了!\n");

  if (member_array(ob, players_k) != -1) {

    ob->set("mana", 1);
    ob->set("force", 1);
    if (ob->query("faith") >= 1)
      ob->add("faith", -1);
    if (ob->query("weiwang") >= 1)
      ob->add("weiwang", -1);
    tell_object(ob, "由于任务失败，你的威望降低了，内力法力被吸干了......\n");
    ob->start_busy(20);
  }
}

int check_exp(object ob, int exp) {
  int ob_exp = ob->query("combat_exp");

  if (min(exp, ob_exp) <= 4000000 && abs(ob_exp - exp) < max(exp, ob_exp) / 10)
    return 1;

  if (min(exp, ob_exp) <= 6000000 && abs(ob_exp - exp) < max(exp, ob_exp) / 8)
    return 1;

  if (min(exp, ob_exp) <= 8000000 && abs(ob_exp - exp) < max(exp, ob_exp) / 5)
    return 1;

  return 0;
}

int abs(int i) {
  return (i < 0) ? -i : i;
}

int max(int i, int j) {
  return (i > j) ? i : j;
}

int min(int i, int j) {
  return (i > j) ? j : i;
}

int filter_x(object ob) {
  if (member_array(ob->query("family/family_name"), family_name_z) != -1)
    return 1;
  else return 0;
}

int filter_z(object ob) {
  if (member_array(ob->query("family/family_name"), family_name_x) != -1)
    return 1;
  else return 0;
}
