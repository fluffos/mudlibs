void heart_beat() {
  int i;

  if (query("eff_kee") < query("max_kee"))
    command("eat yao");

  for (i = 0; i < sizeof(players_k); i++) {
    if (!(objectp(players_k[i]) && environment(players_k[i])))
      players_k -= ({ players_k[i] });
  }

  ::heart_beat();
}

int do_block(string arg) {
  object me = this_object();
  object who = this_player();
  string verb = query_verb();
  int t;

  // wizardp(who) && 

  if ((verb == "duandao" || verb == "steal" || verb == "throw") && !me->query("kill_started")) {
    message_vision("$N对$n摇了摇头。\n", me, who);
    return 1;
  }

  if (!userp(who)) return 0;

  if (!me->query("kill_started")) return 0;

  if (!who->query_temp("zxzz_job")) return 0;

  if (verb != "go" &&
    verb != "fly" &&
    !(environment() && environment()->query("exits/" + verb)))
    return 0;

  t = random(2);   //1/2的机率走掉

  if (t == 1) {
    message_vision("$n乘$N一个不注意，急忙溜了过去。\n", me, who);
    return 0;
  }

  message_vision("$N一伸手拦在$n面前，高声叫道：\n" +
    " 死妖怪，现在想跑来不急了,拿命来吧！\n\n", me, who);
  tell_object(who, me->name() + "一把拦住了你！\n");
  return 1;
}

void check_golem(object ob) {
  object golem;

  if (ob->query("summon/diablo_npc")) {
    golem = ob->query("summon/diablo_npc");
    if (objectp(golem) && environment(golem)) {
      message_vision(this_object()->name() + "对$N甩了甩手!\n", golem);
      golem->die();
    }
  }
}

