#include <armor.h>
#include <ansi.h>

inherit CLOTH;

void create()
{
       set_name(HIW"白袍"NOR, ({"baipao", "pao"}));
        set_weight(2000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
		set("long",
"一件雪白的袍子．\n");
                set("unit", "件");
                set("value", 500);
                set("material", "cloth");
                set("armor_prop/armor", 200);
                set("armor_prop/spells", 50);
             }
}