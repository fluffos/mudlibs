#include <ansi.h>
#include <weapon.h>

inherit STICK;

void destroy();

void create() {
  set_name(CYN "铉铁棍" NOR, ({ "gun" }));
  set_weight(1400);
  if (clonep())

    set_default_object(__FILE__);
  else {
    set("unit", "根");
    set("value", 100);
    set("material", "steel");
    set("wield_msg", "$N「呼」地一声抽出一把$n握在手中。\n");
  }
  init_stick(200);
  setup();
}

void init() {
  if (environment(this_object())->query("id") != "tiandi zhizun"
    && environment(this_object())->query("id") != "hunshi mowang")
    call_out("destroy", 1);
  //::init();
}

void destroy() {
  message(
    "zxzz",
    "在" + HIW "天地至尊" NOR + "的召唤下，" + CYN "铉铁棍" NOR + "破空而去！\n",
    environment(this_player())
  );
  destruct(this_object());
}
