#include <ansi.h>

inherit ITEM;

void create() {
  set_name(HIM "打神鞭" NOR, ({ "dashen bian", "bian" }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {

    set("long", HIM "传说是原始天尊赐给姜子牙的法宝， 能上打诸神，下打群妖(da <id>)。\n" NOR);
    set("unit", "条");
    set("value", 0);
    set("no_put", 1);
    set("no_sell", 1);
    set("no_drop", 1);

    set("can_ding", 3);
  }
  setup();
}
void init() {
  object me = this_object();
  object where = environment();
  if (environment(this_object()) && !query("go_die")) {
    call_out("destory", 1600);
    set("go_die", 1);
  }
  add_action("do_ding", "da");
  if (interactive(where)) {
    if (me->query("mark")) {
      if (me->query("mark") != where->query_temp("dajiu/mark")) {
        call_out("destory", 1);
      }
    }

  }


}
void remove_biqi(object target) {
  if (target)
    target->delete_temp("biqi");

  return;
}
void remove_jinzhou(object target) {
  if (target)
    target->delete_temp("jinzhou");

  return;
}
void remove_fengmo(object target) {
  if (target)
    target->delete_temp("fengmo");

  return;
}
int do_ding(string arg) {
  object target;
  int i, effect;
  object who = this_player();
  string where = query("place");

  if (environment(this_object()) != who)
    return 0;
  if (!arg)
    return notify_fail("你要用打神鞭去打谁？\n");
  if (who->is_busy())
    return notify_fail("你现在正忙着呢。\n");
  if (!query("can_ding"))
    return notify_fail("打神鞭的神力已经完全消散了！\n");
  if (!(target = present(arg, environment(who))))
    return notify_fail("这儿没这个人。\n");
  if (target->query("mark") != query("mark"))
    return notify_fail("你不能用打神鞭来打此人。\n");
  if (environment(who)->query("short") != where)
    return notify_fail("你不能在此处用打神鞭来打此人。\n");
  if (!who->query("dajiu_busy")) {

    return notify_fail("你不能再使用此打神鞭。\n");
  }
  if (who->query("mana") < 500)
    return notify_fail("你的法力不够。\n");
  if (target->is_busy())
    return notify_fail("对方已经手忙脚乱了。\n");
  who->add("mana", -250);
  message_vision(name() + HIM "“呼”的一声飞向半空，直冲$N天灵打去。\n" NOR, target);
  effect = random(3);
  if (effect == 0) {
    message_vision(HIB "$N只觉得全身气血翻涌，无法再运用内力。\n" NOR, target);
    target->receive_damage("kee", target->query("kee") / 12, who);
    target->receive_wound("kee", target->query("kee") / 12);
    target->receive_damage("sen", target->query("sen") / 16, who);
    target->receive_wound("sen", target->query("sen") / 16, who);
    target->set_temp("biqi", 1);
    call_out("remove_biqi", 3 + random(3), target);
    COMBAT_D->report_status(target);
    COMBAT_D->report_sen_status(target);
  } else if (effect == 1) {
    message_vision(HIB "$N只觉得全身气血翻涌，无法再运用法力。\n" NOR, target);
    target->receive_damage("kee", target->query("kee") / 12, who);
    target->receive_wound("kee", target->query("kee") / 12);
    target->receive_damage("sen", target->query("sen") / 16, who);
    target->receive_wound("sen", target->query("sen") / 16, who);
    target->set_temp("jinzhou", 1);
    call_out("remove_jinzhou", 3 + random(3), target);
    COMBAT_D->report_status(target);
    COMBAT_D->report_sen_status(target);
  } else {
    message_vision(HIB "$N只觉得全身气血翻涌，无法再运用外功。\n" NOR, target);
    target->receive_damage("kee", target->query("kee") / 12, who);
    target->receive_wound("kee", target->query("kee") / 12);
    target->receive_damage("sen", target->query("sen") / 16, who);
    target->receive_wound("sen", target->query("sen") / 16, who);
    target->set_temp("fengmo", 1);
    call_out("remove_fengmo", 3 + random(3), target);
    COMBAT_D->report_status(target);
    COMBAT_D->report_sen_status(target);
  }
  who->start_busy(1 + random(2));
  i = query("can_ding");
  i--;
  set("can_ding", i);
  return 1;


}
void destory() {
  if (this_object() && environment(this_object())) {
    message_vision("一阵风吹来，" + this_object()->name() + "霞光一闪不见了！\n", this_object());
    destruct(this_object());
  }

}
