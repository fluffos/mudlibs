// shuijingxie.c 
 
#include <armor.h> 
#include <ansi.h> 
inherit BOOTS; 
 
void create() 
{ 
        set_name("水晶鞋", ({"shuijing xie"})); 
        set_weight(1000); 
        if( clonep() ) 
                set_default_object(__FILE__); 
        else { 
                set("material", "leather"); 
                set("unit", "双"); 
                set("armor_prop/armor", 1); 
        } 
        setup(); 
} 


