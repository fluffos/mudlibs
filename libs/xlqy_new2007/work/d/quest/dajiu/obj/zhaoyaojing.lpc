  fail = 0;
  if (query("team_master") && random(2))
    me = query("team_master");
  //	if(me&&environment(me)->query("short")==where&&me->query_condition("mjb_busy"))//flying
  if (me && environment(me)->query("short") == where && me->query("dajiu_busy") > time()) {
    if (ckiller > 0) {

      if (count < 3) {
        reset_eval_cost();

        what = list[random(sizeof(list))];

        killer1 = new("/d/quest/dajiu/npc/" + what);
        killer1->set("teamp_exp", query("combat_exp") + 1);

        what = list[random(sizeof(list))];

        killer2 = new("/d/quest/dajiu/npc/" + what);
        killer2->set("teamp_exp", query("combat_exp") + 1);

        what = list[random(sizeof(list))];

        killer3 = new("/d/quest/dajiu/npc/" + what);
        killer3->set("teamp_exp", query("combat_exp") + 1);

        killer1->invocation(me, level);
        killer1->set("count", query("count"));
        killer1->move(environment(me));
        tell_room(environment(me), HIC "\n只见" + killer1->query("name") + "慌慌张张的走了过来......\n" NOR);  //修正by flying 2003.6.8

        killer2->invocation(me, level);
        killer2->set("count", query("count"));
        killer2->move(environment(me));
        tell_room(environment(me), HIC "\n只见" + killer2->query("name") + "慌慌张张的走了过来.......\n" NOR);  //修正by flying 2003.6.8

        killer3->invocation(me, level);
        killer3->set("count", query("count"));
        killer3->move(environment(me));
        tell_room(environment(me), HIC "\n只见" + killer3->query("name") + "慌慌张张的走了过来....\n" NOR);  //修正by flying 2003.6.8
        killer1->kill_ob(me);
        if (random(2))
          killer1->chat();
        killer2->kill_ob(me);
        if (random(2))
          killer2->chat();
        killer3->kill_ob(me);
        if (random(2))
          killer3->chat();

      } else if (count < 4) {
        reset_eval_cost();
        what = list[random(sizeof(list))];

        killer1 = new("/d/quest/dajiu/npc/" + what);
        killer1->set("teamp_exp", query("combat_exp") + 1);
        what = list[random(sizeof(list))];

        killer2 = new("/d/quest/dajiu/npc/" + what);
        killer2->set("teamp_exp", query("combat_exp") + 1);
        what = list[random(sizeof(list))];

        killer3 = new("/d/quest/dajiu/npc/" + what);
        killer3->set("teamp_exp", query("combat_exp") + 1);
        what = list[random(sizeof(list))];

        killer4 = new("/d/quest/dajiu/npc/" + what);
        killer4->set("teamp_exp", query("combat_exp") + 1);
        killer1->set("count", query("count"));
        killer2->set("count", query("count"));
        killer3->set("count", query("count"));
        killer4->set("count", query("count"));

        killer1->invocation(me, level);
        killer1->move(environment(me));

        tell_room(environment(me), HIC "\n只见" + killer1->query("name") + "慌慌张张的走了过来......\n" NOR);  //修正by flying 2003.6.8

        killer2->invocation(me, level);
        killer2->move(environment(me));
        tell_room(environment(me), HIC "\n只见" + killer2->query("name") + "慌慌张张的走了过来......\n" NOR);  //修正by flying 2003.6.8

        killer3->invocation(me, level);
        killer3->move(environment(me));
        tell_room(environment(me), HIC "\n只见" + killer3->query("name") + "慌慌张张的走了过来.....\n" NOR);  //修正by flying 2003.6.8

        killer4->invocation(me, level);
        killer4->move(environment(me));
        tell_room(environment(me), HIC "\n只见" + killer4->query("name") + "慌慌张张的走了过来......\n" NOR);  //修正by flying 2003.6.8
        killer1->kill_ob(me);
        //       
        killer2->kill_ob(me);
        //      killer2->start_busy(1);
        killer3->kill_ob(me);
        //       killer3->start_busy(1);
        killer4->kill_ob(me);
        //       killer4->start_busy(1);
        if (random(2))
          killer1->chat();
        if (random(2))
          killer2->chat();
        if (random(2))
          killer3->chat();
        if (random(2))
          killer4->chat();

      } else {
        reset_eval_cost();
        what = list[random(sizeof(list))];

        killer1 = new("/d/quest/dajiu/npc/" + what);
        killer1->set("teamp_exp", query("combat_exp"));
        what = list[random(sizeof(list))];

        killer2 = new("/d/quest/dajiu/npc/" + what);
        killer2->set("teamp_exp", query("combat_exp"));
        what = list[random(sizeof(list))];

        killer3 = new("/d/quest/dajiu/npc/" + what);
        killer3->set("teamp_exp", query("combat_exp"));
        what = list[random(sizeof(list))];

        killer4 = new("/d/quest/dajiu/npc/" + what);
        killer4->set("teamp_exp", query("combat_exp"));
        what = list[random(sizeof(list))];

        killer5 = new("/d/quest/dajiu/npc/" + what);
        killer5->set("teamp_exp", query("combat_exp"));
        killer1->set("count", query("count"));
        killer2->set("count", query("count"));
        killer3->set("count", query("count"));
        killer4->set("count", query("count"));
        killer5->set("count", query("count"));

        killer1->invocation(me, level);
        killer1->move(environment(me));
        tell_room(environment(me), HIC "\n只见" + killer1->query("name") + "慌慌张张的走了过来......\n" NOR);  //修正by flying 2003.6.8


        killer2->invocation(me, level);
        killer2->move(environment(me));
        tell_room(environment(me), HIC "\n只见" + killer2->query("name") + "慌慌张张的走了过来......\n" NOR);  //修正by flying 2003.6.8

        killer3->invocation(me, level);
        killer3->move(environment(me));
        tell_room(environment(me), HIC "\n只见" + killer3->query("name") + "慌慌张张的走了过来.....\n" NOR);  //修正by flying 2003.6.8

        killer4->invocation(me, level);
        killer4->move(environment(me));
        tell_room(environment(me), HIC "\n只见" + killer4->query("name") + "慌慌张张的走了过来......\n" NOR);  //修正by flying 2003.6.8

        killer5->invocation(me, level);
        killer5->move(environment(me));
        tell_room(environment(me), HIC "\n只见" + killer5->query("name") + "慌慌张张的走了过来......\n" NOR);  //修正by flying 2003.6.8
        killer1->kill_ob(me);
        //       killer1->start_busy(1);
        killer2->kill_ob(me);
        //       killer2->start_busy(1);
        killer3->kill_ob(me);
        //       killer3->start_busy(1);
        killer4->kill_ob(me);
        //       killer4->start_busy(1);
        killer5->kill_ob(me);
        //       killer5->start_busy(1);
        if (random(2))
          killer1->chat();
        if (random(2))
          killer2->chat();
        if (random(2))
          killer3->chat();
        if (random(2))
          killer4->chat();
        if (random(2))
          killer5->chat();
      }
      time = 250 + random(30);
      call_out("job", time, me, where, maxpot, ckiller - 1);
      call_out("shrine", time - 11, me, ckiller - 1);
    } else {
      inv = all_inventory(environment(me));
      for (int dj = 0; dj < sizeof(inv); dj++) {
        if (inv[dj]->query("id") == "lao guai" && inv[dj]->query("mark") == query("mark")) {
          fail = 1;
          destruct(inv[dj]);
        }
      }
      if (fail) {
        tell_room(environment(me), HIC "在众老怪的帮助下，大淫贼成功逃脱了。\n" NOR);

        for (int pp = 0; pp < count; pp++)
          penalty(team[pp]);
        destruct(this_object());
        return;
      } else {
        if (!random(count))
          obj = new("/d/quest/dajiu/npc/yinzei");
        else obj = new("/d/quest/dajiu/npc/yinzei2");
