void create() {
  set_name(HIR "通天镜" NOR, ({ "zhaoyao jing", "jing" }));
  set_weight(1);
  if (clonep())
    set_default_object(__FILE__);
  else {

    set("long", HIR "一面明晃晃亮闪闪的通天镜，能使妖魔鬼怪无所遁形。\n" NOR);
    set("unit", "面");
    set("value", 0);
    set("no_put", 1);
    set("no_sell", 1);
    set("no_drop", 1);
    set("no_get", 1);
    set("no_give", 1);
  }
  setup();
}
void init() {
  /*
	if(environment(this_object())&&!query("go_die"))
	 {
	    	call_out("destory",2100);
	      	set("go_die",1);
	}
	*/
}
void start_job(object who) {
  int i, time;
  string place = query("place");
  int count = query("count");

  for (i = 100; i * i * i / 10 <= query("combat_exp"); i++);
  if (count > 3) count = 3;
  i = i * count / 3;
  time = 150 + random(30);
  call_out("job", time, who, place, i, count);
  call_out("shrine", time - 11, who, count);
  call_out("destory", 2100);
}
void shrine(object me, int ckiller) {
  if (ckiller > 0)
    tell_room(environment(me), MAG "\n～～～～～～～通天镜霞光一闪～～～～～～～\n\n" NOR);
  else tell_room(environment(me), BLINK + MAG "\n～～～～～～～通天镜发出万道霞光～～～～～～～\n\n" NOR);
}
void destory() {
  if (this_object() && environment(this_object())) {
    message_vision("晴天一个霹雳，" + this_object()->name() + "霞光一闪不见了！\n", this_object());
    destruct(this_object());
  }

}

void job(object ob, string where, int maxpot, int ckiller) {
  object *team, *inv, obj, gift, killer1, killer2, killer3, killer4, killer5;
  string where4, where1, where2, where3;
  string what;
  object me;
  int level, fail, rr;
  int i = 0, count, time;

  team = this_object()->query("team");
  count = query("count");
  if (count)
    me = team[random(count)];
  else me = query("owner");
