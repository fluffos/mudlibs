//by flying
// /d/quest/dajiu/qiankun.c

#include <ansi.h>
inherit ITEM;

void create() {
  set_name(HIC "乾坤袋" NOR, ({ "qiankun dai", "bag" }));
  set_weight(10);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "只");
    set("long", HIC "出自轩辕黄帝之手，传说内里自有乾坤。\n" NOR);
    set("value", 0);
    set("no_drop", 1);
    set("no_sell", 1);
    set("no_put", 1);

  }
}
void init() {
  add_action("do_dajiu", "dajiu");
}

int do_dajiu(string arg) {
  int i, exp, dx, pot, count, base_exp, add_exp, gold;
  object ob, me, *team, xiang, jing, fan, bian;
  string str;

  me = this_player();
  ob = this_object();
  if (environment(ob) != me)
    return 0;
  team = ob->query("team");
  count = sizeof(team);

  if (ob->query("mark") != me->query_temp("dajiu/mark"))
    return notify_fail("这件事好像和你没关系吧?\n");


  message_vision("$N将念力聚于双指，喃喃念了几句咒语。\n" + HIC "只见你眼前一花，花仙已经站在你的面前含羞对你一福，随即匆匆离去 。\n" NOR, me);


  if (ob->query("combat_exp") < 500000)
    base_exp = 4800;
  else if (ob->query("combat_exp") < 1200000)
    base_exp = 5900;
  else if (ob->query("combat_exp") < 2100000)
    base_exp = 7200;
  else if (ob->query("combat_exp") < 3200000)
    base_exp = 8500;
  else if (ob->query("combat_exp") < 5400000)
    base_exp = 9800;
  else if (ob->query("combat_exp") < 7500000)
    base_exp = 12100;
  else if (ob->query("combat_exp") < 10000000)
    base_exp = 15400;
  else if (ob->query("combat_exp") < 14000000)
    base_exp = 17900;
  else if (ob->query("combat_exp") < 20000000)
    base_exp = 21500;
  else if (ob->query("combat_exp") < 30000000)
    base_exp = 26000;
  else
    base_exp = 30000;



  for (i = 0; i < count; i++) {
    if (team[i] && team[i]->query_temp("dajiu/mark") == query("mark")) {

      xiang = present("baibao xiang", team[i]);
      fan = present("dingyao fan", team[i]);
      bian = present("dashen bian", team[i]);
      if (xiang)
        destruct(xiang);
      if (fan)
        destruct(fan);
      if (bian)
        destruct(bian);
      team[i]->add("dajiu/count", 1);
      add_exp = team[i]->query("dajiu/count");  //flying
      if (add_exp > 100)
        add_exp = add_exp + random(add_exp);
      else if (add_exp > 500)
        add_exp = 2 * add_exp;
      else if (add_exp > 1500)
        add_exp = 3000 + random(add_exp);

      add_exp += team[i]->query_temp("dajiu/killed");
      add_exp += add_exp * count / 2;
      exp = base_exp + random(300) + add_exp + base_exp * (count - 2) / 10;
      dx = exp * 2 / 3;
      exp = exp * 3 / 2;                                                   //add by theone 7.19-05
      //adjust by jame 4.29-06
      pot = exp * 2 / 4 + random(350);
      gold = 1 + add_exp / 800;              //adjust by jame 4.29-06  以前为1+add_exp/200
      if (team[i]->query("gain_more_reward") + team[i]->query_temp("gain_more_reward")) {
        team[i]->query_kar();
        exp = exp * (10000 + team[i]->query("gain_more_reward") + team[i]->query_temp("gain_more_reward")) / 10000;
        pot = pot * (10000 + team[i]->query("gain_more_reward") + team[i]->query_temp("gain_more_reward")) / 10000;
        dx = dx * (10000 + team[i]->query("gain_more_reward") + team[i]->query_temp("gain_more_reward")) / 10000;

      }

      team[i]->add("potential", pot);
      team[i]->add("dajiu/pot", pot);
      team[i]->add("combat_exp", exp);
      team[i]->add("dajiu/exp", exp);
      team[i]->add("daoxing", dx);
      team[i]->add("dajiu/dx", dx);
      team[i]->add("balance", gold * 10000);
      team[i]->add("dajiu/gold", gold);
      team[i]->delete("dajiu_busy");
      team[i]->set("dajiu_time", time() + 240);
      team[i]->delete_temp("dajiu");

      tell_object(team[i], HIW "你被奖励了：\n" +
        chinese_number(exp) + "点实战经验\n" +
        COMBAT_D->chinese_daoxing(dx) + "道行\n" +
        chinese_number(pot) + "点潜能\n" +
        chinese_number(gold) + "两黄金\n" +
        NOR);
      str = team[i]->name() + "成功搭救了花仙，获得了" + chinese_number(exp) + "点实战经验，" + COMBAT_D->chinese_daoxing(dx) + "道行，" + chinese_number(pot) + "点潜能，" + chinese_number(gold) + "两黄金！\n";
      message("channel:rumor", HIM "【道听途说】：" + str + "\n" NOR, users());
      MONITOR_D->report_system_msg(str);
      //以上三行，tonii,03-5-27，以加强监控
      team[i]->apply_condition("mjb_busy", 0);  //tonii,03-5-27,临时修改

    }
  }
  jing = query("jing");
  if (jing)
    destruct(jing);

  destruct(this_object());
  return 1;
}
