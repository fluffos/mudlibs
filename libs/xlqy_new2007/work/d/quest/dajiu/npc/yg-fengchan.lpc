inherit __DIR__"guai.lpc";


void set_skills(int max_value, int level)
{
        int guai_value;
        ::set_skills(max_value, level);
        create_family("火云洞", 3, "弟子");

        if (level==1) guai_value = max_value+max_value/8;
        else if (level==2) guai_value = max_value+max_value/6;
        else guai_value = max_value+max_value/4;
       
        set_skill("literate", 210);
      
       		
		set_skill("spear", guai_value+random(16));
		
		set_skill("huomoforce",guai_value+random(16));
		
		set_skill("pingtian-dafa",guai_value+random(16));
		set_skill("wuyue-spear", guai_value+random(16));
		set_skill("moyun-shou",guai_value+random(16));
		set_skill("moshenbu",guai_value+random(16));
		map_skill("force", "huomoforce");
		  map_skill("unarmed", "moyun-shou");
		  map_skill("dodge", "moshenbu");
		  map_skill("spells", "pingtian-dafa");
		  map_skill("parry", "wuyue-spear");
		 map_skill("spear", "wuyue-spear");	
		
           set("force_factor", query_skill("force")/2);
        set("mana_factor", query_skill("spells",1));
        add_temp("apply/strength",guai_value/2);
         if(guai_value > 200)
        {	 	  set("skill_level/spear","expert");
	
	  	 
	  	}
          if(guai_value > 300)
               	 {
               	 		  set("skill_level/spear","master");
	  	
	  	}             if(guai_value > 600)
               	 {
               	 		  set("skill_level/spear","grandmaster");
	  	
	  	}       
        carry_object("/d/obj/armor/jinjia.lpc")->wear();
        carry_object("/d/npc/obj/spear.lpc")->wield();

        set("chat_chance_combat", 85);
        set("chat_msg_combat", ({
		(: perform_action, "spear", "fengchan" :),
		(: perform_action, "spear", "buhui" :),
		(: perform_action, "unarmed", "zhangxinlei" :),
		 (: exert_function, "shield" :),
		        }) );
}



