// 清福神柏鉴
#include <ansi.h>
inherit NPC;
int work_me();
string chinese_daoxing(int gain);



void create() {
  set_name("柏鉴", ({ "bo jian", "bojian", "jian", "shen" }));
  set("long", "轩辕皇帝总兵官柏鉴,后被封为清福神,为封神台接引使者");
  set("title", HIC "清福神" NOR);
  set("gender", "男性");
  set("per", 10);
  set("age", 100);
  set("str", 30);
  set("int", 30);
  set("max_sen", 2000);
  set("max_kee", 2000);
  set("force", 3000);
  set("max_force", 2000);
  set("mana", 3000);
  set("max_mana", 2000);

  set_skill("force", 150);
  set_skill("dodge", 160);
  set_skill("parry", 140);
  set_skill("sword", 130);


  set("attitude", "peaceful");
  set("combat_exp", 1500000);
  set("daoxing", 2000000);
  set("inquiry", ([
    "name": "轩辕皇帝总兵官柏鉴也,现为封神台接引使者",
    "here": "这里是封神台了",
  ]));
  setup();
  carry_object("/d/obj/cloth/linen")->wear();
}
/************************************************************/

int work_me() {
  object room, ob;
  object me = this_player();
  if ((int)me->query("fenshen/reward") > 0) {
    message_vision(
      "$N对$n一拜：天尊有令这位" + RANK_D->query_respect(me) + "封神劳苦功高,特奖励" + chinese_daoxing((int)me->query(
        "fenshen/reward",
        1
      )) + "道行和" + chinese_number((int)me->query("fenshen/reward", 1) / 4 + 1) + "点潜能！\n",
      this_object(),
      me
    );

    me->add("combat_exp", (int)me->query("fenshen/reward", 1));
    me->add("potential", (int)me->query("fenshen/reward", 1) / 4 + 1);
    me->add("fenshen/reward_got", (int)me->query("fenshen/reward", 1));
    me->set("fenshen/reward", 0);
  } else return 0;
  return 1;

}


string chinese_daoxing(int gain) {
  int year, day, hour;
  string str;

  year = gain / 1000;
  day = (gain - year * 1000) / 4;
  hour = (gain - year * 1000 - day * 4) * 3;
  str = "";
  if (year) str = str + chinese_number(year) + "年";
  if (day) str = str + chinese_number(day) + "天";
  if (hour) str = str + chinese_number(hour) + "时辰";

  return str;
}
