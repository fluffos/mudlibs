string ask_jianxi() {
  object guo, ob;
  object jing, fan, xiang, bian, room;
  object *team;
  string str;
  int i = 0, count = 0, minexp, maxexp, av_exp;
  int mark;
  string where;
  guo = this_object();
  ob = this_player();

  //	if (ob->query_condition("mjb_busy"))
  //		return "目前我还没有收到任何消息。";//guo busy time 
  if (ob->query("dajiu_time") > time())
    return "目前我还没有收到任何消息。";  //guo busy time 
    team = ob->query_team();

  count = sizeof(team);

  for (i = 0; i < count; i++) {
    if (team[i]->query("combat_exp") < 500000)
      return "你们中有人功夫太差了。想死还不如自己买块豆腐呢!";  //too low exp
  }

  if (count <= 1)
    return "就你一个人吗?看你也太单薄了点吧。";  //too few people
    if (count > 4)
      return "此事怎可如此张扬？";  //too many people
      minexp = team[0]->query("combat_exp");
  maxexp = minexp;
  av_exp = minexp;
  for (i = 1; i < count; i++) {
    if (team[i]) {
      if (team[i]->query("combat_exp") < minexp)
        minexp = team[i]->query("combat_exp");
      if (team[i]->query("combat_exp") > maxexp)
        maxexp = team[i]->query("combat_exp");
      av_exp += team[i]->query("combat_exp");
    }
  }
  av_exp = av_exp / count;

  if (minexp > 4000000) {
    if ((maxexp - minexp) > maxexp / 5)
      return "你们的武功相差太悬殊。";
  } else if ((maxexp - minexp) > 500000)
    return "你们的武功相差太悬殊。";  //exp too far

    where = names[0][random(SIZE)];
  mark = 1 + random(123456);
  jing = new("/d/quest/dajiu/obj/zhaoyaojing");
  jing->set("mark", mark);
  jing->set("place", where);
  jing->set("owner", ob);
  jing->set("team", team);
  jing->set("count", count);
  jing->set("combat_exp", maxexp);
  jing->set("name", ob->query("name") + "搭救用的" + jing->name());
  jing->start_job(ob);

  //	 if( !(room = find_object("/d/quest/dajiu/dajiucenter")) )
  //            room = load_object("/d/quest/dajiu/dajiucenter");
  if (!jing->move(this_object())) {
    destruct(jing);
    return "等等再来吧，现在淫贼排着队等花仙呢。";
  }

  //	ob->apply_condition("mjb_busy",150);
  ob->set("dajiu_time", 1200 + time());
  ob->set("dajiu_busy", 1200 + time());
  ob->delete_temp("dajiu");
  ob->set_temp("dajiu/mark", mark);
  ob->set_temp("dajiu/place", where);
  ob->set_temp("dajiu/count", count);
  for (i = 0; i < count; i++) {  //	team[i]->apply_condition("mjb_busy",150);
    team[i]->set("dajiu_time", 1200 + time());
    team[i]->set("dajiu_busy", 1200 + time());
    team[i]->delete_temp("dajiu");
    team[i]->set_temp("dajiu/mark", mark);
    team[i]->set_temp("dajiu/place", where);
    team[i]->set_temp("dajiu/count", count);
  }

  fan = new("/d/quest/dajiu/obj/dingyaofan");
  fan->set("mark", mark);
  fan->set("place", where);
  fan->set("can_ding", count + 1);
  if (!fan->move(ob))
    fan->move(environment(ob));
  xiang = new("/d/quest/dajiu/obj/baibaoxiang");
  xiang->set("mark", mark);
  xiang->set("place", where);
  xiang->set("can_full", count + 1);
  xiang->set("can_heal", count * 3);
  if (!xiang->move(ob))
    xiang->move(environment(ob));
  bian = new("/d/quest/dajiu/obj/dashenbian");
  bian->set("mark", mark);
  bian->set("place", where);
  bian->set("can_ding", count + 1);
  if (!bian->move(ob))
    bian->move(environment(ob));


  return "有花仙在" + where + "附近被妖怪掳去，速速搭救她吧。\n" +
    "我送你们三件宝物可助一臂之力。\n" +
    "花仙被他们藏在乾坤袋里，dajiu就行了。";
}


