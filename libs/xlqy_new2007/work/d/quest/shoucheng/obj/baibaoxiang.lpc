#include <ansi.h>

inherit ITEM;

int do_heal(string arg);
int do_full(string arg);
void create() {
  set_name(HIG "百宝箱" NOR, ({ "baibao xiang", "xiang" }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {

    set("long", HIG "一个装满了奇花异草的小箱子，可以用来救死扶伤(full <id>)，医治百病(heal <id>)。\n" NOR);
    set("unit", "个");
    set("value", 0);
    set("no_put", 1);
    set("no_sell", 1);
    set("no_drop", 1);
    set("can_full", 3);
    set("can_heal", 3);
  }
  setup();
}
void init() {
  object me = this_object();
  object where = environment();

  if (environment(this_object()) && !query("go_die")) {
    call_out("destory", 1200);
    set("go_die", 1);
  }
  add_action("do_heal", "heal");
  add_action("do_full", "full");

  if (interactive(where)) {
    if (me->query("mark")) {
      if (me->query("mark") != where->query_temp("dajiu/mark")) {
        call_out("destory", 1);
      }
    }

  }

}
int do_full(string arg) {
  object target;
  int i;
  object who = this_player();
  string where = query("place");

  if (environment(this_object()) != who)
    return 0;
  if (!arg)
    return notify_fail("你要用百宝箱救治谁？\n");
  if (!query("can_full"))
    return notify_fail("百宝箱中的仙药已经用光了！\n");
  if (!(target = present(arg, environment(who))))
    return notify_fail("这儿没这个人。\n");
  if (!userp(target))
    return notify_fail("这儿没这个人。\n");
  if (target->query_temp("dajiu/mark") != query("mark"))
    return notify_fail("你不能用百宝箱来救治此人。\n");
  if (environment(who)->query("short") != where)
    return notify_fail("你不能在此处用百宝箱来救治此人。\n");
  if (!who->query("dajiu_busy")) {

    return notify_fail("你不能再使用此百宝箱了。\n");
  }

  message_vision(name() + HIG "突然散出冲天霞光笼罩了$N全身。\n" NOR, target);

  target->set("kee", target->query("max_kee"));
  target->set("eff_kee", target->query("max_kee"));
  target->set("sen", target->query("max_sen"));
  target->set("eff_sen", target->query("max_sen"));
  target->set("force", 2 * target->query("max_force"));
  target->set("mana", 2 * target->query("max_mana"));
  target->start_busy(1);
  who->start_busy(2);
  i = query("can_full");
  i--;
  set("can_full", i);
  tell_object(who, "百宝箱里还剩" + chinese_number(query("can_full")) + "颗仙药！\n");
  return 1;


}
int do_heal(string arg) {
  object target;
  int i;
  object who = this_player();
  string where = query("place");
  if (environment(this_object()) != who)
    return 0;
  if (!arg)
    return notify_fail("你要用百宝箱恢复谁？\n");
  if (!query("can_heal"))
    return notify_fail("百宝箱中的灵草已经用光了！\n");
  if (who->is_busy())
    return notify_fail("你现在正忙着呢。\n");
  if (!(target = present(arg, environment(who))))
    return notify_fail("这儿没这个人。\n");
  if (!userp(target))
    return notify_fail("这儿没这个人。\n");
  if (target->query_temp("dajiu/mark") != query("mark"))
    return notify_fail("你不能用百宝箱来恢复此人。\n");
  if (environment(who)->query("short") != where)
    return notify_fail("你不能在此处用百宝箱来恢复此人。\n");
  if (!who->query_condition("mjb_busy")) {
    return notify_fail("你不能再使用此百宝箱了。\n");
  }
  if (who->query("force") < 300)
    return notify_fail("你的内力不够。\n");
  who->add("force", -250);
  message_vision(name() + HIG "霞光一闪笼罩了$N全身。\n" NOR, target);
  target->receive_curing("kee", 300 + random(300));
  target->receive_heal("kee", 300);
  target->receive_curing("sen", 300 + random(300));
  target->receive_heal("sen", 300);
  who->start_busy(1);
  i = query("can_heal");
  i--;
  set("can_heal", i);
  tell_object(who, "百宝箱里还剩" + chinese_number(query("can_heal")) + "颗灵草！\n");
  return 1;


}
void destory() {
  if (this_object() && environment(this_object())) {
    message_vision("一阵风吹来，" + this_object()->name() + "霞光一闪不见了！\n", environment(this_object()));
    destruct(this_object());
  }

}
