
#include <ansi.h>

inherit ITEM;

void create()
{
        set_name(HIY"定妖幡"NOR, ({"dingyao fan","fan"}));
	set_weight(100);
	if(clonep())
    		set_default_object(__FILE__);
  	else {

        set("long",HIY"一副缀满了奇珍异宝的黄丝定妖幡，能使妖魔鬼怪无处可逃(dingyao <id>)。\n"NOR);
        set("unit", "副");
        set("value", 0);
	set("no_put",1);
	set("no_sell",1);
	set("no_drop",1);

	set("can_ding",3);
	}
	setup();
}
void init()
{
	object me = this_object();
	object where = environment();
	if(environment(this_object())&&!query("go_die"))
	 {
	    	call_out("destory",1200);
	    	set("go_die",1);
	}
	add_action("do_ding","dingyao");
	if (interactive(where))
	  {
	    if (me->query("mark"))
	    {
	      if (me->query("mark")!=where->query_temp("dajiu/mark"))
	      {
	        call_out("destory",1);
	      }
	    }
	   
	  }
		
	
}
int do_ding(string arg)
{
	object target;
	 int i;
	object who = this_player(); 
	string where =query("place");
	
	if(environment(this_object()) != who)
	return 0;
	if(!arg)
	  return notify_fail("你要用定妖幡锁住谁？\n");
	if(who->is_busy())
		return notify_fail("你现在正忙着呢。\n");
	if(!query("can_ding"))
		 return notify_fail("定妖幡的灵气已经完全消散了！\n");
	if(!(target=present(arg,environment(who))))
	  return notify_fail("这儿没这个人。\n");
	
	if(target->query("mark")!=query("mark"))
		 return notify_fail("你不能用定妖幡锁住此人。\n");
	if(environment(who)->query("short")!=where)
	 	return notify_fail("你不能在此处用定妖幡锁住此人。\n");
	 if(!who->query("dajiu_busy"))
	 {
	 	
	 	return notify_fail("你不能再使用此定妖幡。\n");
	}
	if(who->query("mana") < 500)
		 return notify_fail("你的法力不够。\n");
	if(target->is_busy())
		 return notify_fail("对方已经手忙脚乱了。\n");	
	who->add("mana",-250);
	message_vision(name()+HIY"凌空飞起化作一张天罗地网罩向$N，$N顿时被罩了个严严实实一动也不能动。\n"NOR,target);
	target->start_busy(4+random(4));
	who->start_busy(1+random(2));
	i = query("can_ding");
	i--;
	set("can_ding",i);
	return 1;
	
	
}
void destory()
{
	if(this_object()&&environment(this_object()))
	{
		message_vision("一阵风吹来，"+this_object()->name()+"忽啦啦的飘走了！\n",this_object());
		destruct(this_object());	
	}	
	
}