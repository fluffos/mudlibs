void penalty(object me);
void create() {
  set_name(HIY "通天镜" NOR, ({ "zhaoyao jing", "jing" }));
  set_weight(1);
  if (clonep())
    set_default_object(__FILE__);
  else {

    set("long", HIR "一面明晃晃亮闪闪的通天镜，能使妖魔鬼怪无所遁形。\n" NOR);
    set("unit", "面");
    set("value", 0);
    set("no_put", 1);
    set("no_sell", 1);
    set("no_drop", 1);
    set("no_get", 1);
    set("no_give", 1);
  }
  setup();
}

void start_job(object who) {
  int i, time, hmany;
  mapping room;
  object aroom;
  mixed oob;
  string *list;
  string msg;
  string place = query("place");
  int count = query("count");


  for (i = 100; i * i * i / 10 <= query("combat_exp"); i++);
  if (count > 3) count = 3;
  i = i * count / 3;


  if (place == "baoxiang") {
    room = baoxiang;
    rooms[9] = find_object("/d/qujing/baoxiang/tiandi");
    if (!rooms[9])
      rooms[9] = load_object("/d/qujing/baoxiang/tiandi");
  } else if (place == "chechi") {
    room = chechi;
    rooms[9] = find_object("/d/qujing/chechi/jinluan");
    if (!rooms[9])
      rooms[9] = load_object("/d/qujing/chechi/jinluan");
    msg = "/d/qujing/chechi/npc/king";
    oob = rooms[9]->query_temp("objects");
    if (oob) target = oob[msg];
    if (!target)
      target = new(msg);
    target->move(rooms[9]);
    msg = sprintf("lao tou zi lai le %O\n", target);
    tell_object(who, msg);
  } else if (place == "nuerguo") {
    room = nuerguo;
    rooms[9] = find_object("/d/qujing/nuerguo/backhall");
    if (!rooms[9])
      rooms[9] = load_object("/d/qujing/nuerguo/backhall");
  } else if (place == "jisaiguo") {
    room = nuerguo;
    rooms[9] = find_object("/d/qujing/jisaiguo/wufeng");
    if (!rooms[9])
      rooms[9] = load_object("/d/qujing/jisaiguo/wufeng");
  } else if (place == "zhuzi") {
    room = nuerguo;
    rooms[9] = find_object("/d/qujing/zhuzi/nei");
    if (!rooms[9])
      rooms[9] = load_object("/d/qujing/zhuzi/nei");
  } else if (place == "biqiu") {
    room = nuerguo;
    rooms[9] = find_object("/d/qujing/biqiu/bao");
    if (!rooms[9])
      rooms[9] = load_object("/d/qujing/biqiu/bao");
  } else if (place == "fengxian") {
    room = nuerguo;
    rooms[9] = find_object("/d/qujing/fengxian/junhou");
    if (!rooms[9])
      rooms[9] = load_object("/d/qujing/fengxian/junhou");
  } else if (place == "yuhua") {
    room = nuerguo;
    rooms[9] = find_object("/d/qujing/yuhua/zheng");
    if (!rooms[9])
      rooms[9] = load_object("/d/qujing/yuhua/zheng");
  } else if (place == "tianzhu") {
    room = nuerguo;
    rooms[9] = find_object("/d/qujing/tianzhu/jinluan");
    if (!rooms[9])
      rooms[9] = load_object("/d/qujing/tianzhu/jinluan");
  } else if (place == "jinping") {
    room = nuerguo;
    rooms[9] = find_object("/d/qujing/jinping/datang");
    if (!rooms[9])
      rooms[9] = load_object("/d/qujing/jinping/datang");
  }


  list = keys(room);
  hmany = sizeof(list);
  for (int j = 0; j < hmany; j++) {
    msg = sprintf("%s", room[list[j]]);
    aroom = find_object(msg);
    if (!aroom) aroom = load_object(msg);
    rooms[j] = aroom;
  }

  //.....
  msg = sprintf("roooom is %O\n", rooms);
  tell_object(who, msg);
  //.....

  time = 30 + random(30);
  call_out("shrine", time, who, i, count, rooms);
  call_out("destory", 1500);

}
void shrine(object me, int maxpot, int ckiller, object *rooms) {
  object ro;
  object *team;
  int ssize, size, cou, hm, time;
  ssize = sizeof(rooms);   //房间数，最后一个房间是皇宫,所以起码size ＝ 2
  for (int i = 0; i < 9; i++) {
    if (objectp(rooms[i])) size++;
  }
  cou = query("count") + 1;  //总共人数＋1个老怪
  if (!me)
    return;

  /*
	team =this_object()->query("team");	
	for(int fa = 0; fa < sizeof(team);fa++)
	{
	 	if(!team[fa])
	 	{
	 		for(int fb = 0; fb< sizeof(team);fb++)
	 	  {
	 	 	 tell_object(team[fb],HIR"你的队伍有人临阵脱逃了！！\n"NOR);	
	 	   penalty(team[fb]);
	 	  }
	 		break;
	 	}
	}
	*/
  if (ckiller > 0) {
    if (size == 1) {
      ro = rooms[0];
      hm = cou;
      tell_room(
        environment(me),
        RED "探子急报： " + ro->query("short") + "发现" + to_chinese(hm) + "批妖魔来犯！\n\n" NOR
      );
    } else {

      for (int i = 0; i < size; i++) {
        if (i + 1 == size) {
          hm = cou;
        } else {
          if (size > 3)
            hm = random(cou - 1);
          else hm = 1 + random(cou - 1);
          cou = cou - hm;
        }
        ro = rooms[i];
        if (hm > 0) {
          tell_room(
            environment(me),
            RED "探子急报： " + ro->query("short") + "发现" + to_chinese(hm) + "批妖魔来犯！\n\n" NOR
          );
          call_out("job", 12, me, ro, maxpot, ckiller, hm, rooms);
        }
      }
    }
    time = 120 + random(10);
    call_out("shrine", time, me, maxpot, ckiller - 1, rooms);

  } else {
    ro = rooms[9];
    tell_room(environment(me), BLINK + RED "\n大事不好！" + ro->query("short") + "被魔王攻击了，速速救驾！\n\n" NOR);
    call_out("job", 3, me, ro, maxpot, ckiller, hm, rooms);

  }


}

void job(object ob, object room, int maxpot, int ckiller, int hmany, object *rooms) {
  object *team, obj, killer;
  mapping steps;
  string what;
  object me;
  int level, rr;
  int i = 0, count;

  me = ob;
  if (!room) return;
  /*
	team=this_object()->query("team");
	count = query("count");
	if(count)
		me=team[random(count)];
	else me = query("owner");
	*/
  rr = random(300);
  if (rr < 40)
    level = 1;
  else if (rr < 140)
    level = 2;
  else level = 3;

  if (ckiller > 0) {
    for (int ss = 0; ss < hmany; ss++) {
      steps = room->query("shoucheng_step");
      if (!mapp(steps))
        continue;

      what = list[random(sizeof(list))];
      killer = new("/d/quest/shoucheng/npc/" + what);
      killer->set("shoucheng_master", 1);
      killer->set("teamp_exp", query("combat_exp"));

      killer->invocation(me, level, steps, 1);

      killer->set("count", query("count"));
      killer->move(room);
      tell_room(room, HIC "\n只见" + killer->query("name") + "大摇大摆的走了过来......\n" NOR, me);
      tell_object(me, HIC "\n只见" + killer->query("name") + "大摇大摆的走了过来......\n" NOR);
    }

  } else {

    if (!random(count))
      obj = new("/d/quest/dajiu/npc/yinzei");
    else obj = new("/d/quest/dajiu/npc/yinzei2");
    obj->set("team", this_object()->query("team"));
    obj->set("jing", this_object());
    obj->set("team_exp", query("combat_exp"));
    obj->do_copy(me, maxpot);
    obj->move(room);
    message_vision(HIY "$N现出身形，狂笑不已：就凭你们几个也想挡住我的去路？！\n" NOR, obj);

  }
  return;
}
void destory() {
  if (this_object() && environment(this_object())) {
    message_vision("晴天一个霹雳，" + this_object()->name() + "霞光一闪不见了！\n", this_object());
    destruct(this_object());
  }

}
void penalty(object me) {
  object jing, fan, xiang, bian;
  if (!me) return;
  if (me->query_temp("dajiu/mark") != query("mark")) return;
  if (!me->query("dajiu_busy")) return;
  fan = present("dingyao fan", me);
  xiang = present("baibao xiang", me);
  bian = present("dashen bian", me);
  message_vision(HIY " 突然半空中一只大手一把抓住$N,一下子就不见了\n" NOR, me);

  me->add("dajiu/exp", -me->query("combat_exp") / 1500);
  me->add("dajiu/dx", -me->query("daoxing") / 1500);
  me->add("combat_exp", -me->query("combat_exp") / 1500);
  me->add("daoxing", -me->query("daoxing") / 1500);
  me->add("dajiu/die", 1);
  me->clear_condition();
  me->delete("dajiu_busy");
  me->delete_temp("dajiu");
  me->remove_ride();
  me->move("/d/wiz/entrance");
  message_vision(HIY "姜子牙盯着$N,摇了摇头说:看来你的修行不够,不可担当大任。说完伸手在$N顶门一拍\n" NOR, me);
  if (fan)
    destruct(fan);
  if (xiang)
    destruct(xiang);
  if (bian)
    destruct(bian);
  me->unconcious();
  me->set("eff_kee", me->query("max_kee"));
  me->set("eff_sen", me->query("max_sen"));
  me->set("kee", me->query("max_kee") / 3);
  me->set("sen", me->query("max_sen") / 3);
}
