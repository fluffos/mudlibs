inherit __DIR__"guai.lpc";

void set_skills(int max_value, int level)
{
        int guai_value;
        ::set_skills(max_value, level);
        
        if (level==1) guai_value = max_value+max_value/12; 
        else if (level==2) guai_value = max_value+max_value/10; 
        else guai_value = max_value+max_value/8; 
        create_family("东海龙宫", 3, "弟子");
    	
        set_skill("dragonforce", guai_value+random(16));
        set_skill("fengbo-cha", guai_value+random(16));
        set_skill("fork", guai_value+random(16));
        set_skill("dragonfight", guai_value+random(16));
        set_skill("dragonstep", guai_value+random(16));
        set_skill("literate", 180);
        set_skill("seashentong", guai_value+20+random(16));
        map_skill("spells", "seashentong");
        map_skill("force", "dragonforce");
        map_skill("unarmed", "dragonfight");
        map_skill("parry", "fengbo-cha");
        map_skill("fork", "fengbo-cha");
        map_skill("dodge", "dragonstep");
       
	   if(guai_value > 200)
        	 set("skill_level/fork","expert");
          if(guai_value > 300)
               	 set("skill_level/fork","master"); 
            if(guai_value > 600)
               	 set("skill_level/fork","grandmaster");     
        set("force_factor", query_skill("force")/2);
        set("mana_factor", query_skill("spells")/2);
        set("chat_chance_combat", 85);
        set("chat_msg_combat", ({
		(: perform_action, "unarmed", "sheshen" :),
                (: perform_action, "fork", "fengbo" :),
                (: exert_function, "wuxing" :),
                (: exert_function, "shield" :),
        }) );
                
        carry_object("/d/obj/armor/jinjia.lpc")->wear();
        carry_object("/d/npc/obj/fork.lpc")->wield();
}

