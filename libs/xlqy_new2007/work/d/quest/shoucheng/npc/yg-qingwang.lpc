inherit __DIR__ "guai.lpc";

int do_wu();
void set_skills(int max_value, int level) {
  int guai_value;
  ::set_skills(max_value, level);
  create_family("月宫", 3, "弟子");

  if (level == 1) guai_value = max_value + max_value / 8;
  else if (level == 2) guai_value = max_value + max_value / 6;
  else guai_value = max_value + max_value / 4;

  set_skill("baihua-zhang", guai_value + random(16));
  set_skill("moondance", guai_value + random(16));
  set_skill("whip", guai_value + random(16));
  set_skill("jueqingbian", guai_value + random(16));
  set_skill("moonforce", guai_value + random(16));
  set_skill("literate", 180);
  set_skill("moonshentong", guai_value + 20 + random(16));
  map_skill("spells", "moonshentong");
  map_skill("force", "moonforce");
  map_skill("unarmed", "baihua-zhang");
  map_skill("whip", "jueqingbian");
  map_skill("parry", "jueqingbian");
  map_skill("dodge", "moondance");

  set("force_factor", query_skill("force") / 2);
  set("mana_factor", query_skill("spells", 1));
  if (guai_value > 200)
    set("skill_level/whip", "expert");
  if (guai_value > 300)
    set("skill_level/whip", "master");
  if (guai_value > 600)
    set("skill_level/whip", "grandmaster");
  carry_object("/d/obj/armor/jinjia.lpc")->wear();
  carry_object("/d/npc/obj/whip.lpc")->wield();
  set("chat_chance_combat", 55);
  set("chat_msg_combat", ({
    (: cast_spell, "qingwang" :),
    (: cast_spell, "arrow" :),
    (: do_wu :),
  }));
}

int do_wu() {

  object me = this_object();
  if (!random(13))
    me->command("perform love");
  else me->command("cast qingwang");
  return 1;
}
