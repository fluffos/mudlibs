// Room: /d/4world/shuyuan.c
#include <ansi.h>
inherit ROOM;

string *strs = ({
  " 人之初，性本善。性相近，习相远。 \n",
  " 养不教，父之过。教不严，师之惰。  \n",
  " 子不学，非所宜。幼不学，老何为。 \n",
  " 美不美，乡中水，亲不亲，故乡人。 \n",
  " 一年之计在于春，一日之计在于晨。  \n",
  " 一家之计在于和，一生之计在于勤。 \n",
  " 黑发不知勤学早，看看又是白头翁。  \n",
  " 是非只为多开口，烦恼皆因强出头。 \n",
  "一举首登龙虎榜，十年身到风凰池。	\n",
});

void check_time(object where);
void dushu(object where);
void finish_dushu(object where);
void create() {
  set("short", "西城书院");
  set("long", @LONG

这是傲来国中唯一的书院。傲来本是民风淳朴，虽人人礼谦有加，
于大唐之文彩天下却不可同提。书院是数年前从中原来的一位秀
才所开，城中来学的人也是不少。
LONG);

  set("exits", ([ /* sizeof() == 1 */
    "south": __DIR__ "east1",
  ]));
  set("objects", ([
    __DIR__ "npc/xiucai": 1 ]));

  set("no_clean_up", 1);
  setup();
}
void init() {
  add_action("do_skills", "skills");
  remove_call_out("check_time");
  check_time(this_object());
  add_action("do_dushu", "dushu");
}

int do_skills(string arg) {
  object ob;
  object me;
  me = this_player();
  if (!(ob = present("lan tuyu", environment(me))))
    return notify_fail("只有巫师或有师徒关系的人能察看他人的技能。\n");
  if ((arg != "lan"))
    return notify_fail("只有巫师或有师徒关系的人能察看他人的技能。\n");
  else
    write("
蓝图郁目前所学过的技能：

  读书识字 (literate)                      - 已有小成  40/    0

\n");
  return 1;
}

void check_time(object where) {
  mixed *local = localtime((time() - 900000000) * 60);
  int t = local[2] * 60 + local[1];
  int phase = ((int)(t / 120));

  if (phase == 3 && (!query("start_dushu"))) dushu(where);
  if (phase == 6 && query("start_dushu")) finish_dushu(where);
  call_out("check_time", 60, where);
}

void dushu(object where) {
  message("channel:new", HIY "铃铃~~~！铃声响了,西城书院开课了!大家来读书(dushu)吧!\n" + NOR, users());
  where->set("start_dushu", 1);
}

int do_dushu() {
  object who = this_player();

  if (who->query("kee") < 20 || who->query("sen") < 20) return notify_fail("读书这么用功?还是先去休息休息吧!\n");

  if (who->is_busy())
    return notify_fail("你正忙着呢。\n");
  if (!this_object()->query("start_dushu"))
    return notify_fail("晚上才开课,还不到读书的时候呢。\n");

  if ((int)who->query_skill("literate", 1) > 40) return notify_fail("你的读书写字已经有一定造诣了.\n");
  if ((int)who->query("combat_exp") > 50000 || (int)who->query("age") > 17 || (int)who->query("daoxing") > 16000)
    return notify_fail("你都已经成年了,不用来这里读了吧?\n");
  tell_object(who, "你摇头晃脑吟道：" + strs[random(sizeof(strs))]);
  who->start_busy(3 + random(6));
  who->improve_skill("literate", random((int)(who->query("spi") / 2 + who->query("int") / 2)));
  who->add("daoxing", 1 + random(2));
  who->add("potential", 1 + random(4));
  who->receive_damage("kee", 20);
  who->receive_damage("sen", 20);
  tell_object(who, "你觉得自己的见识又增长了！\n");
  return 1;
}

void finish_dushu(object where) {
  tell_object(where, "蓝夫子咳嗽两声,说道:应该下课啦,解散吧。\n");
  where->delete("start_dushu");
}
