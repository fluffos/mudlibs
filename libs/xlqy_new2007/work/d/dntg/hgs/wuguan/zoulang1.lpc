#include <ansi.h>
inherit ROOM; 
#include <room.h> 
int valid_leave;

void create() 
{
	set("short", "走廊"); 
	set("long",@LONG

你小心翼翼的走过一段湿滑的走廊，南面是女浴室，厚厚的帘子遮的严严
实实。北面是男浴室，里面传出一阵阵哗哗的水声，还有个家伙在不停的
哼着小调。仔细听听，似乎是一些妹妹呀，哥哥呀什么的。    
LONG);

	set("exits",([
		"north" : __DIR__"mclothroom",
		"west" : __DIR__"zoulang",
		"south" : __DIR__"fclothroom",
		])); 
	set("objects",([
		__DIR__"npc/bigmm" : 1,
		]));
	set("item_desc",([
	"north":HIR"一群赤条条的男孩正在换衣服呢。\n"NOR,
	"south":HIC"～～～～～～～～～～～～～～～\n"NOR]));
	set("no_fight",1);
	
	setup();
}

int valid_leave(object ob, string dir)
{
	object *inv;
	if((dir=="south") && (ob->query("gender")!= "女性"))
		return notify_fail("怎么着？想看人家小姑娘沐浴啊，不怕眼珠子掉下来吗？\n");
	if((dir=="north") && (ob->query("gender")!= "男性"))
		return notify_fail("那边是一群浑身汗臭的男孩在洗澡，姑娘家别乱跑乱瞅，会得针眼的。\n");
	if(dir=="south"||dir=="north")
	{
	if(time()<(ob->query("wuguan/washtime")+60))
	{
		return notify_fail("管家婆肥手一伸，拦住你道：哇，你怎么又来了啊，不怕把皮给泡脱了？\n");
	}
	}
	inv=all_inventory(ob);
	for(int i=0;i <sizeof(inv);i++)
	 {
	 	if(inv[i]->is_character()&&dir!="west")
          	return notify_fail("管家婆肥手一伸，拦住你道：进去洗澡还背着个人啊！\n");
        }
	if(!random(66))
	   {
	   	message_vision(HIR"$N一不小心，脚下一滑，撞上了走廊边上的柱子。\n"NOR,ob);
	   	ob->unconcious();
	   	return 1;
	       
	}  
	
 	
	return ::valid_leave(ob,dir);
}
