
#include <ansi.h>
 inherit ROOM;
#include <room.h> 
void create()
{
        set("short", "女更衣室");
        set("long", @LONG

空气中弥漫着一种淡淡的香味。一群正值韶华之年的女孩子
正更换着衣物，你不禁偷偷的打量着她们的含苞欲放的身材。
LONG
        );
        set("exits", ([
                "south" : __DIR__"fbathroom",
                "north" :__DIR__"zoulang1",
        ]));
        
        setup();
     
} 

int valid_leave(object ob, string dir)
{
	if(dir=="north")
	{
 	message_vision("$N拿起旁边架子上的毛巾，仔仔细细的擦干身上的水，一边梳理着秀发，一边对着镜子欣赏自己无限美好的身材。\n",ob);
 	message_vision("$N慢慢的穿好衣物，向外走去。\n",ob);
 	
	}
	return ::valid_leave(ob,dir);
}
