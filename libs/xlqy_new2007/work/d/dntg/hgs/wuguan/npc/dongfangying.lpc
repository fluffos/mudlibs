#include <ansi.h>
inherit NPC;
void destruct_fish(object me,object obj);
int do_skills(string arg);
void create()
{

        set_name("东方英", ({ "dongfang ying", "dongfang", "ying"}) );
        set("gender", "女性");
        set("age", 22);
	set("per", 25);
        set("long", "东方英是馆主的独生女，武功又高，人又漂亮。\n");
        set("combat_exp", 58000);
	set("title", "武馆教头");
	set_skill("sword", 70);
	set_skill("parry", 70);
        set_skill("dodge", 70);
        set_skill("unarmed", 70);
	set_skill("force", 60);
	set_skill("shaolin-force",30);
        setup();
        add_money("silver", 1+random(20));
        carry_object("/d/obj/cloth/pink_cloth")->wear();
        carry_object("/d/obj/weapon/sword/changjian")->wield();

}

int recognize_apprentice()
{
        if(!this_player()->query("wuguan/join") )
        return notify_fail("东方英害羞地一笑：爹要是不同意，我可不敢教。\n");
//	if(this_player()->query("wuguan/job_success",1) < 100)
//	  return notify_fail("东方英笑道：你多为武馆做些贡献，我就教。\n");
//	if(this_player()->query_temp("wuguan/job_success",1) < 10)
//	  return notify_fail("东方英笑道：你去为武馆做点事再来吧。\n"); 
        return 1;
}

int accept_object(object ob,object obj)
{
	object me=this_object();
	
	return JOB_OB("wuguan")->give_tang(me,ob,obj);
}

void init()
{
	
	add_action("do_skills","skills");
}
int do_skills(string arg)
{
	if(!this_player()->query("wuguan/join") )
		return 0;
	if(arg!="dongfang"&&arg!="dongfang ying"&&arg!="ying")
		return 0;
	if(wizardp(this_player()))
		return 0;
	tell_object(this_player(),"东方英目前所掌握的"+HIR"六"NOR+"项技能是：\n");
	tell_object(this_player(),WHT"┏━━━━━━━━━━━━━"HIY"X"HIR"·"HIY"L"HIR"·"HIY"Q"HIR"·"HIY"Y"WHT"━━━━━━━━━━━━━┓\n"NOR);
        tell_object(this_player(),CYN"  基本轻功 (dodge)                         - "HIB"身轻如燕"NOR+"   70/    0\n");
        tell_object(this_player(),CYN"  内功心法 (force)                         - "HIB"气息悠长"NOR+"   60/    0\n");
        tell_object(this_player(),CYN"  拆招卸力之法 (parry)                     - "YEL"半生不熟"NOR+"   70/    0\n");
        tell_object(this_player(),CYN"  少林硬气功 (shaolin-force)               - "HIB"粗通皮毛"NOR+"   30/    0\n");
        tell_object(this_player(),CYN"  基本剑术 (sword)                         - "YEL"半生不熟"NOR+"   70/    0\n");
        tell_object(this_player(),CYN"  扑击格斗之技 (unarmed)                   - "YEL"半生不熟"NOR+"   70/    0\n");
        tell_object(this_player(),WHT"┗━━━━━━━━━━━━━ "HIR"华 中 站"WHT" ━━━━━━━━━━━━━┛\n"NOR);
	
	return 1;
	
}	
