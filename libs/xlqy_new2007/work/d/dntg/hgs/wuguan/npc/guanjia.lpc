#include <ansi.h>
inherit NPC;
int ask_job();
int give_up();
int job_finish();
void greeting(object ob);
int do_register(object ob);

void create() {
  set_name("管家", ({ "guan jia", "guanjia", "jia" }));
  set("gender", "男性");
  set("age", 35);
  set("long",
    "他是武馆的管家，对馆主衷心耿耿，对下却及其 \n"
    "严厉。很少笑，大家都叫他哭丧脸。\n");


  set("chat_chance", 1);
  set("chat_msg", ({
    "管家大声说道：“大家加油干呀，别偷懒。”\n",
    "管家脸色一沉，道：“让我看见谁偷懒，可别怪我不留情。 ”\n",
    "管家对你笑道：“想闯江湖，就你这点本事可不行！\n",
  }));
  set_skill("unarmed", 20);
  set_skill("dodge", 20);
  set_temp("apply/attack", 10);
  set_temp("apply/defense", 10);
  set("combat_exp", 1000);
  set("inquiry", ([
    "效劳": (: ask_job :),
    "job": (: ask_job :),
    "放弃": (: give_up :),
    "cancel": (: give_up :),
    "fangqi": (: give_up :),
    "finish": (: job_finish: ),
    "register" : (: do_register :),
    "报道" : (: do_register :),
    ])
  );
setup();

carry_object(__DIR__ "obj/cloth")->wear();
}

void init() {
  object me;

  me = this_player();
  call_out("greeting", 1, me);

}


int job_finish() {
  mapping job;
  object me = this_player();
  object ob = this_object();
  if (!(job = me->query("wuguan/job"))) {
    tell_object(me, CYN "管家说道：你没任务呢，胡喊什么？\n" NOR);
    return 1;
  }
  if (me->query_temp("wuguan/job_finish")) {
    return JOB_OB("wuguan")->real_give_gifts(me);
  } else {
    tell_object(me, CYN "管家满脸不悦的看着你：活还没干完呢,想蒙混过关?\n" NOR);
    return 1;
  }
  return 1;
}
int ask_job() {
  object ob = this_player();

  return JOB_OB("wuguan")->ask_job(ob);
}

int give_up() {
  object ob = this_player();

  return JOB_OB("wuguan")->give_up(ob);
}

void greeting(object ob) {
  if (!ob || environment(ob) != environment()) return;
  //	if(!random(3))
  //  return;

  if (!ob->query("wuguan/join")) {
    message_vision(
      CYN "管家笑嘻嘻的说:" NOR + HIY "(ask boyu about 入武馆/join)" NOR + CYN "可以加入我们东方武馆。\n" NOR,
      ob
    );
    return;
  }
  if (!ob->query("wuguan/job")) {
    message_vision(
      CYN "管家说道：" NOR + HIY "(ask guanjia about job)" NOR + CYN "就可以为我们武馆做些工作，挣些钱了。\n" NOR,
      ob
    );
    message_vision(
      CYN "可以去工具房问孙管事要工具" + HIC "(ask sun about tool)。" NOR + CYN "做完之后，到我这里" NOR + HIW "(ask guan jia about finish)。\n" NOR,
      ob
    );
    return;
  }
  if (!random(5)) {
    message_vision(
      CYN "管家说道:要是不想干了，" NOR + HIR "(ask boyu about 辞行/leave)" NOR + CYN "就可以离开我们东方武馆。\n" NOR,
      ob
    );
    return;
  }

  message_vision(CYN "管家脸色一沉，道：“让我看见谁偷懒，可别怪我不留情。 ”\n" NOR, ob);
  return;
}

int do_register(object ob) {

  int number;
  string num;
  object money;
  ob = this_player();
  if (!ob->query("wuguan/join")) {
    message_vision(CYN "管家瘪了瘪嘴，说道:先加入我们东方武馆再说。\n" NOR, ob);
    return 1;
  }
  if (ob->query("wuguan/register")) {
    message_vision(CYN "管家磨了磨牙，说道:你已经在我这报道过了，好好为武馆效力，学好功夫吧。\n" NOR, ob);
    return 1;

  }
  number = time() * random(2) / 1000000 + random(5000);

  num = chinese_number(number);
  num = replace_string(num, "万", "");
  num = replace_string(num, "千", "");
  num = replace_string(num, "百", "");
  num = replace_string(num, "十", "");
  if (sizeof(num) < 4)
    num += "零零零";
  if (sizeof(num) < 6)
    num += "零零";
  if (sizeof(num) < 8)
    num += "零";

  ob->set("wuguan/number", num);
  message_vision(
    HIB + "管家嘿嘿笑道：今后你在武馆中就被唤作" + NOR + HIW + num + NOR + HIB "，好好为武馆效力，早日出人头地！\n" NOR,
    ob
  );
  tell_object(ob, CYN + "管家悄声说道：" + HIW + num + NOR + CYN "，晚上要小心，最近武馆闹鬼，你去城里找找能抓鬼的人。\n" NOR);

  ob->set("wuguan/register", 1);
  ob->save();
  if (num == "一一一一" || num == "二二二二" || num == "三三三三" || num == "四四四四" ||
    num == "五五五五" || num == "六六六六" || num == "七七七七" || num == "八八八八" || num == "九九九九") {
    message_vision(CYN + "管家眯着眼睛笑道：你这家伙人品可真好，发达了可别忘了我呀。\n" NOR, ob);
    ob->set("wuguan/lucky", 1);
    money = new("/obj/money/gold");
    money->set_amount(10);
    message_vision(CYN "管家递给$N一些黄金。\n" NOR, ob);
    money->move(ob);

  }
  return 1;

}
