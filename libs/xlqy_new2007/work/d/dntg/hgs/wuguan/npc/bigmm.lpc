inherit NPC;

void create() {
  set_name("管家婆", ({ "guanjia po", "po", "woman" }));
  set("gender", "女性");
  set("age", 45);
  set("per", 11);
  set("long",
    "一个肥肥胖胖的中年妇女，是管家的老婆。\n"
    "脾气可不太好，千万别招惹她。 \n");

  setup();

  carry_object("/d/obj/cloth/pink_cloth")->wear();
}
