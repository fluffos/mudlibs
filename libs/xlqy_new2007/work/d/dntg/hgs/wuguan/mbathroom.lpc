#include <ansi.h> 
 inherit ROOM;
#include <room.h> 
void create()
{
        set("short", "澡塘子");
        set("long", @LONG

一入门，热气扑面，白白的水气立刻包围了你。你依稀看到一个巨大的水池,
一群人就像煮饺子一样在里面泡着。尽管如此，你还是想一下子跳（ｊｕｍｐ）
进去，闭上眼睛好好的放松一下。
LONG
        );
        set("exits", ([
                "south" : __DIR__"mclothroom",
        ]));
        set("no_fight",1);
        set("no_magic",1); 
            
        setup();
       
} 
void init()
{
        add_action("do_jump", "jump"); 
} 
int do_jump()
{
        object me;
        int wait;
        me = this_player();
        
        if(me->query_temp("jumpinpool"))
         {
           
           tell_object(me,"你不就在池子里嘛，还瞎蹦腾什么呢。\n");
           return 1;
        }
        me->set_temp("jumpinpool",1);
        wait = random( 60 - (int)me->query("con")-(int)me->query("kar"));
        if ( wait < 6) wait = 6;
        me->start_busy(wait);
        message_vision("$N噗嗵一声跳进浴池．\n",me);
        me->set("wuguan/washtime",time());
        tell_object(me,"你感到全身无比的舒泰．．\n");
   //     remove_call_out("curehimup");
        call_out("curehimup", wait, me);
  
return 1;
} 

void curehimup(object me)
{
        int gin,kee,sen;
        if(!me) return;
        kee=(int)me->query("max_kee");
        sen=(int)me->query("max_sen");
if( me && environment(me) == this_object())
        {
        message_vision(HIR"$N的精气神全恢复了！\n"NOR, me);
        me->set("eff_kee",kee);
        me->set("eff_sen",sen);
        me->set("kee", kee);
        me->set("sen", sen);
        
        }
return;
}  
int valid_leave(object ob, string dir)
{
	if(dir=="south")
	{
 	
 	ob->delete_temp("jumpinpool");
	}
	return ::valid_leave(ob,dir);
}

