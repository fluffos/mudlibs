// by bugbug & alading @ 缥缈水云间, 2003-4-5
// Room: /4world/entrance
#include <ansi.h>
inherit ROOM;

// int do_push(string);
int do_touch(string arg);
int do_say(string arg);
int do_sing(string arg);
void create() {
  set("short", "仙石");
  set("long", @LONG

这里是花果山腰的一块平地。一道瀑布从山顶飞流直下，
泻入一眼深潭，当真是：“一派白虹起，千寻雪浪飞”。
瀑布边上有一块大石头，相传为天地灵气所化。不知是谁在
上面刻了一首诗：

　　　　混沌未分天地乱，茫茫渺渺无人见。
　　　　自从盘古破鸿蒙，开辟从兹清浊辨。

LONG);
  set("item_desc", ([
    "stone": @TEXT
石有三丈六尺五寸高，有二丈四尺围圆。三丈六尺五寸高，
按周天三百六十五度；二丈四尺围圆，按政历二十四气。
上有九窍八孔，按九宫八卦。你忍不住想伸手抚摸(touch)一下。
TEXT
  ]));
  set("objects", ([ /* sizeof() == 1 */
    "/d/ourhome/npc/longear": 1,
    "/u/sky/npc/seng": 1,
    "/d/obj/misc/diablo_box.lpc": 1,

  ]));
  set("outdoors", 1);
  set("exits", ([ /* sizeof() == 2 */
    "eastup": __DIR__ "houshan1",
    "southdown": __DIR__ "up2",
  ]));

  setup();
}
void init() {
  add_action("do_touch", "touch");
  //	add_action("do_say","say");	
  //	add_action("do_sing","music");	
}
int do_sing(string arg) {

  int i;
  object who = this_player();
  if (who->query("61_xlqy_gift"))
    return 0;
  if (!arg || arg != "我们的祖国象花园花园的花朵真鲜艳")
    return 0;
  message_vision(MAG "$N欢快的唱道：我们的祖国象花园，花园的花朵真鲜艳~~~~~~`\n" NOR, who);
  tell_object(who, "各位小泥鳅儿童节快乐，各位老中泥鳅好好培养下一代~~~\n");
  who->add("attribute_point", 1);
  who->add("skills_point", 6);
  who->set("61_xlqy_gift", 1);
  return 1;



}
int do_say(string arg) {
  int i;
  object gift;
  object who = this_player();
  if (who->query("51_xlqy_gift"))
    return 0;
  if (!arg || arg != "五一七天乐劳动最快乐")
    return 0;
  message_vision("$N大声嚷道：五一七天乐，劳动最快乐！\n", who);
  gift = new("/d/wiz/obj/fiveone_gift");
  gift->set("owner_id", who->query("id"));
  gift->move(who);

  tell_object(who, "你觉得有什么东西落在了你的怀里！\n");
  who->set("51_xlqy_gift", 1);
  return 1;

}
int do_touch(string arg) {
  int i;
  object gift;
  object who = this_player();
  if (who->query("init_xlqy_gift")) {
    tell_object(who, "你已经吸收过仙石之灵气了！\n");
    return 1;
  }
  gift = new("/d/wiz/obj/init_gift");
  gift->set("owner_id", who->query("id"));
  gift->move(who);
  message_vision(HIW "$N伸手正欲触摸仙石，" NOR + MAG "突然霞光一闪...\n" NOR, who);
  tell_object(who, "你觉得有什么东西落在了你的怀里！\n");
  who->set("init_xlqy_gift", 1);
  return 1;

}

int valid_leave(object me, string dir) {
  object mbox;

  if (mbox = me->query_temp("mbox_ob")) {
    tell_object(me, "你将信箱交回给邮差。\n");
    destruct(mbox);
  }
  return 1;
}
