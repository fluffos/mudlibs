inherit ROOM;
int do_fly();
int do_quit();
int do_cast();
int do_burn();
int do_sleep();
int do_accept();

void create() {
  set("short", "渔船");
  set("long", @LONG

渔船在大海中飘荡，四周是白茫茫的一片汪洋。
你唯一能做的事就是祈祷了。
LONG);

  set("exits", ([ /* sizeof() == 1 */
  ]));

  set("outdoors", 1);
  // set("no_quit",1);
  set("no_fight", 1);
  set("no_burn", 1);
  set("no_clean_up", 1);
  setup();
}
void init() {
  add_action("do_fly", "fly");
  add_action("do_quit", "quit");
  add_action("do_cast", "cast");
  add_action("do_burn", "burn");
  add_action("do_sleep", "sleep");
  add_action("do_accept", "accept");
}

int do_fly() {
  write("四周都是茫茫大海，不怕半路上摔下来淹死啊。\n");
  return 1;
}

int do_quit() {
  write("你对着天空大喊：救命啊！救命啊！！！救命啊！！！！！！！！\n");
  return 1;
}
int do_cast() {
  write("你嘛啦哄啦念了几句咒语，却被海风吹散了。\n");
  return 1;
}
int do_burn() {
  write("你敲了半天火石，可惜风实在太大，连个火星都没见着。\n");
  return 1;
}
int do_sleep() {
  write("你揉了揉眼睛，打了个哈欠，觉得又不困了。\n");
  return 1;
}
int do_accept() {
  write("你想到等会可以去吃大餐，兴奋的满脸通红。\n");
  return 1;
}
