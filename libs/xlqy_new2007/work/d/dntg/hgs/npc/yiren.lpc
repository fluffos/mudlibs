#include <ansi.h>
inherit NPC;
int do_skills(string arg);
void create() {
  set_name("江湖艺人", ({ "yiren" }));
  set("age", 42);
  set("gender", "男性");
  set("long",
    "一个打把式卖艺的，正在场中练拳脚，有时候也教教大家一点粗浅的功夫(skills yiren)。\n");
  set("attitude", "peaceful");

  set("combat_exp", 42000);
  set("shen_type", 1);

  set_skill("unarmed", 40);
  set_skill("dodge", 20);
  set_skill("parry", 40);
  set_skill("blade", 40);
  //        set_skill("wuhu-blade", 10);
  set_skill("force", 40);
  set_skill("shaolin-force", 20);
  map_skill("blade", "wuhu-blade");
  set("chat_chance", 8);
  set("chat_msg", ({
    "艺人喊道：各位父老乡亲，在下初来贵宝地，多多指教！\n",
    "艺人拿铜锣敲了敲，喊到：各位有钱的捧个钱场，没钱的捧个人场！\n",
    "艺人舞了个刀花道：我这趟刀，叫五虎断门刀！\n",
    "艺人指着旗杆说：还没见一个人爬到顶的！\n",
    "艺人喊道：出门靠朋友，哪位想学功夫的，在下可以指点一二！\n",
  }));
  set("inquiry", ([
    "name": "俺叫刘二，从山东来滴。\n",
    "here": "这里是傲来国啊。\n",
    "学艺": "俺功夫低劣，当年打仗得时候学到了一点皮毛，你要想学我可以教教你，不过...呵呵\n",
  ]));
  setup();
  add_money("silver", 1 + random(3));
  carry_object("/d/obj/weapon/blade/blade")->wield();
  carry_object("/d/obj/cloth/linen")->wear();
}

int recognize_apprentice() {
  if (!this_player()->query("wuguan/yiren"))
    return notify_fail("艺人笑道：江湖上混，第一是个义字，第二嘛...肚子饿了要吃饭的...\n");

  if (this_player()->query("combat_exp") > 100000) {
    this_player()->delete("wuguan/yiren");
    return notify_fail("这点雕虫小技何需看重？\n");
  }

  return 1;
}
int accept_object(object ob, object obj) {

  int value;
  object me = this_object();
  if (obj->query("money_id") && (value = obj->value()) >= 5000) {
    tell_object(ob, name() + "笑道：江湖上混讲的就是义气，你这么款待俺，俺就教你几手功夫。\n");
    ob->set("wuguan/yiren", 1);
    call_out("destroy", 1, obj);
    return 1;
  }
  tell_object(ob, name() + "笑道：江湖上混讲的就是义气，做人要大方，这样朋友才多啊。\n");
  return 0;


}
void destroy(object ob) {
  destruct(ob);
  return;
}
int do_skills(string arg) {
  mapping skl, lrn, map;
  string *sname, *mapped;
  string skill_lv;
  int i;
  object ob, me;
  ob = this_object();
  me = this_player();
  if (!this_player()->query("wuguan/yiren"))
    return 0;
  skl = ob->query_skills();
  write((ob == me ? "你" : ob->name()) + "目前所掌握的" + HIR "" + chinese_number(i) + "" NOR + "项技能是：\n\n");
  sname = sort_array(keys(skl), (: strcmp :));
  printf(NOR WHT "┏━━━━━━━━━━━━━━━━" HIY "X" HIR "·" HIY "L" HIR "·" HIY "Q" HIR "·" HIY "Y" NOR WHT "━━━━━━━━━━━━━━━━┓\n" NOR,);
  map = ob->query_skill_map();
  if (mapp(map)) mapped = values(map);
  if (!mapped) mapped = ({});

  lrn = ob->query_learned();
  if (!mapp(lrn)) lrn = ([]);

  for (i = 0; i < sizeof(skl); i++) {
    if (ob->query("skill_level/" + sname[i]) == "expert")
      skill_lv = HIY "(专家)" NOR;
    else if (ob->query("skill_level/" + sname[i]) == "master")
      skill_lv = HIM "(大师)" NOR;
    else if (ob->query("skill_level/" + sname[i]) == "grandmaster")
      skill_lv = HIW "(宗师)" NOR;
    else skill_lv = NOR "      " NOR;
    printf(CYN "%s%s%-40s" " - %-10s  %-5s  %4d/%5d\n" NOR,
      (lrn[sname[i]] >= (skl[sname[i]] + 1) * (skl[sname[i]] + 1)) ? HIM : "",
      (member_array(sname[i], mapped) == -1 ? "  " : HIR "☆" NOR + HIY ""),
      to_chinese(sname[i]) + " (" + sname[i] + ")",
      SKILL_D(sname[i])->level_description(skl[sname[i]]), skill_lv,
      skl[sname[i]], (int)lrn[sname[i]],
    );
  }
  printf(NOR WHT "┗━━━━━━━━━━━━━━━" HIR " 浙 大 站 " NOR WHT "━━━━━━━━━━━━━━━━┛\n" NOR);
  write("\n");
  return 1;

}
