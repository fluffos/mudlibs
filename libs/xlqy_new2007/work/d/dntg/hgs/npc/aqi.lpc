#include <ansi.h>
inherit NPC;
#define LIMIT_LENGTH    108


string replace_long(string longs);
varargs mapping random_location(mixed flag);
varargs mapping random_location(mixed flag)
{
	string line, dir, tmp,dir_s;
	string *maps, *areas;
	int j,k;
	mixed*  files;
	object room;
	mapping location;
	string *dirs;
	string *positions;
	
	location=allocate_mapping(5);
              
        files = get_dir( "/d/dntg/hgs/wuguan/*.lpc", -1 );
	j = random(sizeof(files));
	reset_eval_cost();
	for(k=0;k<30;k++) 
	{ // try 30 times
           j = random(sizeof(files));
           if( files[random(sizeof(files))][1] > 0)
             room=load_object("/d/dntg/hgs/wuguan/"+files[j][0]);
	
	location["file"]="/d/dntg/hgs/wuguan/"+files[j][0];
	location["room"]=room;
	location["long"]=replace_long(room->query("long"));
	
	break;
	
	}
	return location;
}

string replace_long(string longs)
{
	string tmp="", target="";
	int length, start, i;
	int blank_flag=0;
	
        if(strlen(longs)<1) return "";     
	longs=replace_string(longs, "\n", "");

	for(i=0;i<strlen(longs);i++)
		if(longs[i]>160 && longs[i]<255)
			tmp+=longs[i..i];
	

	length=strlen(tmp);
	
//	if(length<LIMIT_LENGTH*2)
//		return "";
	start=random(length-LIMIT_LENGTH);
	if(start%2)
		start--;
	length=0;
	for(i=start;i<start+LIMIT_LENGTH;i+=2)
	{
		if(blank_flag<-random(2)-2)
		{
			target+="★";
			length++;
			if(random(2) || length>2)
			{
				blank_flag=0;
				length=0;
			}
		}
		else
		{
			blank_flag--;
			target+=tmp[i..i+1];
		}
	}
	return target;
}


int give_quest();
void create()
{
       set_name("阿七婆", ({"aqi po", "aqi","po"}));
       set("long", "一个看起来六七十岁，满脸神神秘秘的老太婆。\n");
       set("gender", "女性");
        set("combat_exp", 5000);
	set("per", 18);
       set("age", 66);
       set("attitude", "peaceful");
       set("shen_type", 1);
       set_skill("unarmed", 15);
	set_skill("dodge", 20);
	set_skill("maodao",20);
	set_skill("spells",30);
	
        setup();
       add_money("silver", 7);
       set("inquiry", ([
		"抓鬼"	:	(: give_quest :),
		"闹鬼"   :"嘿嘿，东方武馆里有不干净的东西,你要当心啊！\n",
	]));     
      
        setup();
        carry_object("/d/gao/obj/ao")->wear();

}
void init()
{
        object ob;

        ::init();
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
        }
}

void greeting(object ob)
{
        if( !ob || !visible(ob) || environment(ob) != environment() ) return;
        switch( random(5) ) {
                case 0:
                        say( "阿七婆神秘地说道：这位" +
RANK_D->query_respect(ob)
                                + "，紫斗摇光，不祥之兆呐！\n");
                        break;
		case 1:
                        say( "阿七婆嘴里嘟嘟囔囔不知说了些什么！\n");
                        break;
		case 2:
                        say( "阿七婆抬头看了看你，叹了口气，摇了摇头。\n");
                        break;
		case 3:
                        say( "阿七婆阴笑了几声，说道：东方武馆有不干净的东西，时常闹鬼。\n");
                        break;
                case 4:
                        say( "阿七婆自言自语道：天阴，要多喝鸡汤。\n");
                        break;


        }
}
int give_quest()
{
	object who, seal;
	mapping room;
	
	who=this_player();
     
  if ((int)who->query("combat_exp") > 80000||(int)who->query("daoxing") > 16000)
      {
           string myname=RANK_D->query_respect(who);
           message_vision(CYN"$N说道：东方武馆有你在，什么鬼怪敢来啊。。嘿嘿嘿嘿。。\n"NOR,this_object());
           return 1;
      }
	if(who->query_skill("maodao",1)<10)
	{	
		command("pei");
		message_vision(CYN"$N说道：你不会茅山道术(maodao)怎么抓鬼啊，不过老婆子我倒是略知一二。\n"NOR,this_object());
		return 1;
		
	}
	if((time()-who->query("catch_ghost/last_time"))<150)
	{
		message_vision(CYN"$N说道：武馆现在还比较安宁，不过还是要多加小心。。\n"NOR,this_object());
		return 1;
	}
	seal=new("/d/dntg/hgs/npc/obj/seal");
	seal->set("master", who);
       do{ room=random_location(); } while(!strlen(room["long"]));
	seal->set("file_name", room["file"]);
	seal->set("desc", room["long"]);
	seal->move(who);
	who->set("catch_ghost/last_time", time());
	message_vision("$N抖抖嗦嗦的从怀里掏出一张破破烂烂的纸，嘴里嘀嘀咕咕念了几句咒，一口唾沫吐在纸上。\n",this_object());
	message_vision(CYN"$N对$n说道：这张符给你，你看看符上写的符号去东方武馆抓鬼吧。\n"NOR, 
	this_object(), who);
        who->start_busy(1);
	return 1;
}

int accept_object(object who, object ob)
{
	int reward, times;
	string msg;
	object m;
        if (ob->query("id")=="old hen") 
        {
                command("hehe " + this_player()->query("id") );
                m=new("/d/obj/book/windwater");
                m->move(this_player());
                message_vision("阿七婆偷偷塞给$N一本书。\n", this_player());
                tell_object(this_player(),CYN"阿七婆悄悄对你说，武馆最近闹鬼，跟着我学点茅山道术(maodao)，就可以抓鬼去了。\n"NOR);
                this_player()->set("wuguan/aqi",1);
                call_out("destroy", 1, ob);
        return 1;
        }
	if(!ob->query("finished")||
		who!=ob->query("master"))
		return 0;
	
	message_vision(CYN"$N「嘿嘿嘿．．．．」地奸笑了几声。\n"NOR, this_object());
	message_vision(CYN"$N馋的口水都流出来了，自言自语道：是清蒸鬼腿呢，还是红烧鬼爪呢？\n"NOR, this_object());
	times=who->query_temp("catch_ghost");
	msg="被奖励了";
        reward=150+who->query_kar()*9/4+random(who->query_kar()*8/3)+who->query_temp("catch_ghost")*3;
	switch(random(3))
	{
		case 0:
			who->add("combat_exp", reward);
			who->add("catch_ghost/cache/wuxue", reward);
			msg+=chinese_number(reward)+"点武学，";
			who->add("daoxing", reward/3);
			who->add("catch_ghost/cache/dx", reward/3);
			msg+=COMBAT_D->chinese_daoxing(reward/3)+"道行。\n";
			break;
		case 1:
			who->add("daoxing", reward/3);
			who->add("catch_ghost/cache/dx", reward/3);
			msg+=COMBAT_D->chinese_daoxing(reward/3)+"道行，";
			who->add("potential", reward/4);
			who->add("catch_ghost/cache/pot", reward/4);
			msg+=chinese_number(reward/4)+"点潜能。\n";
			break;
		default:
			who->add("combat_exp", reward);
			who->add("catch_ghost/cache/wuxue", reward);
			msg+=chinese_number(reward)+"点武学，";
			who->add("potential", reward/4);
			who->add("catch_ghost/cache/pot", reward/4);
			msg+=chinese_number(reward/4)+"点潜能。\n";
	}
	who->add_temp("catch_ghost", 1);
	if(who->query_temp("catch_ghost")>9)
		who->set_temp("catch_ghost", 0);
        MONITOR_D->report_system_object_msg(who, "[抓鬼]"+msg);
        
        tell_object(who, "你"+msg);
        return 1;
}

void destroy(object ob)
{
        destruct(ob);
        return;
}
int recognize_apprentice()
{
	if(!this_player()->query("wuguan/aqi") )
	return notify_fail(CYN"阿七婆嘿嘿笑道：老母鸡可是大补啊。。\n");

	return 1;
}
int prevent_learn(object me, string skill)
{
  if (skill =="maodao" )
  {
    	if(me->query_skill("maodao",1)>19)
    	{
    	command("say 老婆子我就知道这点皮毛了。");
        return 1;
    	}
  }
else if(skill == "spells")
   {
    	 if(me->query_skill("spells",1)>29)
     {
    	command("say 老婆子我就知道这点皮毛了。");
        return 1;
    	}
    }
  return 0;
}
