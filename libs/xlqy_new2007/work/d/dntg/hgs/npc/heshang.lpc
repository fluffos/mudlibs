#include <ansi.h>
inherit NPC;

int do_answer(string arg);
void heshang_save();
void heshang_save2();
void rob_fish(object who);
void rob_fish2(object who);
void create() {
  set_name(HIW "游方和尚" NOR, ({ "heshang", "monk" }));
  set("gender", "男性");
  set("long", HIY "
他正在海边看风景，用一种与四周人都不同的眼神看着身边的一切。那种眼光，
象是……象是太阳，温暖的，愉悦的，不论是对一株草，还是岸边的树，对匆
匆过往的人，都象在欣赏，在赞美……\n" NOR);
  set("combat_exp", 0);
  set("daoxing", 23000);
  set("class", "bonze");
  set("per", 31);
  set("age", 23);
  set("attitude", "peaceful");

  set_skill("spells", 500);
  set_skill("buddhism", 500);
  set("max_kee", 8888888);
  set("max_sen", 8888888);
  set("max_mana", 10000);
  set("mana", 20000);
  set("mana_factor", 500);
  map_skill("spells", "buddhism");
  set("chat_chance", 1);
  set("chat_msg", ({
    HIG "和尚笑吟吟道：我非看你，我在赏花，花映水中，色本是空。\n" NOR,
    HIG "和尚说道：小草啊，我不在时候你们乖不乖啊？蚂蚁有没有来欺负你们？我昨天和他们谈判了，应该没事罗。
以后见了他们，不要再向他们吐口水了。\n" NOR,
    HIG "和尚哈哈哈的笑着说，看，树上两兔子撕打。\n" NOR,
    HIR "和尚抬起头来，望望天上白云变幻，说：我要这天，再遮不住我眼，
要这地，再埋不了我心，要这众生，都明白我意，要那诸佛，都烟消云散！\n" NOR,
    HIC "和尚抬头高声问天，何人……何人生我？生我又为何？既带我来，又不指我路……为何，为何啊！\n" NOR,
    HIW "和尚喃喃自语：天下万物，皆来于空，可这众生爱痴，从何处来？天下万物，又终归于空，那人来到尘世浮沉，为的又是什么？\n" NOR,

  }));
  setup();
  carry_object("/d/obj/cloth/sengyi")->wear();
}
int accept_fight(object me) {
  object ob = this_object();
  object who = this_player();
  message_vision(CYN "和尚笑道：" + who->query("name") + "，你还有何心路未通？\n" NOR, who);
  who->remove_killer(ob);
  return 0;
}
void init() {
  add_action("do_answer", "answer");

}

void kill_ob(object ob) {
  object who = this_player();
  ob = this_object();
  message_vision(CYN "和尚笑道：你知道生命的真义吗？\n" NOR, who);

  who->remove_killer(ob);
  return 0;

}
void die() {
  object who = this_player();
  message_vision(HIC "和尚微微一笑，飘然而去。\n" NOR, who);
  destruct(this_object());


}
void unconcious() {
  die();
}
int accept_object(object who, object obj) {
  if (!who->query_temp("marks/heshang_asked"))
    return 0;
  if (who->query("passsea/save_liyu"))
    return 0;
  if (who->query_temp("marks/confirm_give")) {
    if (obj->query("name") != "金丝鲤鱼" && obj->query("id") != "li yu")
      return 0;


  }
  return 0;

}

int do_answer(string arg) {
  object *inv;
  object who = this_player();
  inv = all_inventory(who);
  if (!who->query_temp("marks/heshang_asked"))
    return 0;
  if (!arg)
    return notify_fail("和尚微笑道：施主愿不愿意啊？(answer 愿意/不愿意)\n");
  if (arg != "愿意" && arg != "不愿意")
    return notify_fail("和尚微笑道：施主愿不愿意啊？(answer 愿意/不愿意)\n");

  if (arg == "愿意") {
    if (who->query_temp("marks/confirm_nogive")) {
      message_vision(CYN "和尚笑道：命里有时终会有，命里无时莫强求。\n" NOR, who);
      return 1;
    }
    message_vision(HIY "$N说道：既然大师想要，" + RANK_D->query_self(who) + "就将鲤鱼送给您吧。\n" NOR, who);
    message_vision(HIW "$N将金丝鲤鱼递给和尚。\n" NOR, who);
    message_vision("和尚笑道：嗯。。这条鲤鱼是蒸着吃，还是煮着吃呢...\n", who);
    for (int i = 0; i < sizeof(inv); i++) {
      if (inv[i]->query("id") == "li yu")
        destruct(inv[i]);

    }
    who->set("passsea/save_liyu", "success");
    who->delete_temp("marks/heshang_asked");
    who->save();
    remove_call_out("heshang_save");
    call_out("heshang_save", 2);

    who->start_busy(3);

    return 1;
  }
  if (arg == "不愿意") {
    message_vision(HIB "$N说道：这可是我花大价钱买回来的，不给！\n" NOR, who);
    message_vision(
      CYN "和尚微微一笑：善哉善哉" + RANK_D->query_respect(who) + "你上当了。其实。。这是一只无壳王八。\n" NOR,
      who
    );
    who->set_temp("marks/confirm_nogive", 1);
    who->set_temp("marks/heshang_asked", 1);
    who->delete_temp("marks/heshang_asked");
    who->set("passsea/save_liyu", "failed");
    who->start_busy(7);
    remove_call_out("rob_fish");
    call_out("rob_fish", 2, who);
    return 1;
  }
  return 0;

}
void heshang_save() {
  message_vision(HIW "和尚说道：万物生成皆神圣，一草一木总关情，鱼也有鱼的家，鱼的自在。\n" NOR, this_object());
  message_vision(HIY "和尚把金丝鲤鱼放入海中，那鱼打了几个盘旋，却不离去。\n" NOR, this_object());
  remove_call_out("heshang_save2");
  call_out("heshang_save2", 2);

}
void heshang_save2() {
  message_vision(HIC "和尚低声说道：你也是有情谊的么？我心领了，去吧。\n" NOR, this_object());
  message_vision(HIB "和尚挥手道：相遇皆是缘，缘尽莫强求，我要去天边，你又跟不得我，去吧。\n" NOR, this_object());
  message_vision(HIR "鲤鱼一摆头，向出海口游去了。水中，一颗晶莹的珍珠缓缓沉入海底。 \n" NOR, this_object());

}
void rob_fish(object who) {

  message_vision("$N大笑道：哈哈哈！你说什么？你说这是……？哈哈哈，傻瓜！\n", who);
  message_vision(HIM "真的真的！和尚满脸严肃，我以和尚脸皮担保，它有四只脚。\n" NOR, who);
  message_vision(HIY "四只脚？啊哈哈哈哈！在哪？我怎没看到？哈哈哈……\n" NOR, who);
  message_vision(HIW "真的真的，我见过这种鱼，它真的有四只脚，只不过平时不伸出来，你拿来给我，我指给你看。就在那！那里……\n" NOR, who);
  remove_call_out("rob_fish2");
  call_out("rob_fish2", 3, who);



}
void rob_fish2(object who) {
  object *inv;

  message_vision(HIR "$N半信半疑：还有这事？将金丝鲤鱼递过去。\n" NOR, who);
  message_vision(HIC "和尚一把夺过鱼，往怀里一揣，转身就跑！\n" NOR, who);
  message_vision(HIB "啊？$N恍然大悟，和尚抢鱼，来人呀，有和尚抢鱼啦！\n" NOR, who);
  message_vision("只见和尚跑的那个快呀，一溜烟的不见了。\n", who);
  inv = all_inventory(who);
  for (int i = 0; i < sizeof(inv); i++) {
    if (inv[i]->query("id") == "li yu")
      destruct(inv[i]);

  }
  destruct(this_object());
}
