#include <ansi.h>
inherit NPC;
void create() {
  object ob;

  set_name("魔礼青", ({ "tian wang", "zengzhang tianwang", "qing", "tianwang" }));
  set("gender", "男性");
  set("long",
    "增长天王为四大天王之首, 身高二丈四尺, 善用一杆长枪, \n"
    "枪法登峰造极, 更有密传「青云宝剑」, 「地，水，火，风」\n"
    "四式一出, 大罗金仙也难逃。\n"
  );
  set("age", 50);
  set("title", "增长天王");
  set("attitude", "heroism");
  set("str", 40);
  set("int", 30);
  set("max_kee", 5100);
  set("kee", 5100);

  set("max_sen", 5100);
  set("sen", 5100);
  set("combat_exp", 3200000);
  set("daoxing", 2800000);
  set("force", 3200);
  set("max_force", 1600);
  set("mana", 3200);
  set("max_mana", 1600);
  set("force_factor", 120);
  set("mana_factor", 120);



  set("eff_dx", 3500000);
  set("nkgain", 800);


  set_skill("unarmed", 240);
  set_skill("yingzhaogong", 240);
  set_skill("parry", 240);
  set_skill("dodge", 240);
  set_skill("sword", 240);
  set_skill("throwing", 240);
  set_skill("ningxie-force", 240);
  set_skill("bainiao-jian", 240);
  set_skill("force", 240);
  set_skill("spells", 240);
  set_skill("moshenbu", 240);
  map_skill("dodge", "moshenbu");
  map_skill("force", "ningxie-force");
  map_skill("parry", "bainiao-jian");
  map_skill("sword", "bainiao-jian");
  map_skill("unarmed", "yingzhaogong");
  create_family("大雪山", 4, "弟子");
  set("chat_chance_combat", 90);
  set("chat_msg_combat", ({
    (: perform_action, "sword", "chaofeng" :),

  }));
  set_temp("apply/immune_jin", 1);
  add_temp("apply/sub_max_phy", 1111);
  add_temp("apply/add_max_phy", 2222);
  setup();

  ob = carry_object("/d/obj/weapon/sword/qingfeng");
  ob->wield();
  ob->set_name("青云宝剑", ({ "sword", "bao jian" }));

  carry_object("/d/obj/armor/jinjia")->wear();
}


void kill_ob(object ob) {
  object me = this_object();

  ::kill_ob(ob);
}


void die() {
  object me = this_object();
  message_vision(HIY "$N吓得撒腿就跑。\n" NOR, me);
  destruct(this_object());
  return;
}
