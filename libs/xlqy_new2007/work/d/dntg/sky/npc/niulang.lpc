#include <ansi.h>
inherit NPC;
inherit F_MASTER;
string skill_lvl();
int improve(string arg);
void create() {
  set_name(HIG "牛郎" NOR, ({ "niu lang", "niulang", "lang" }));
  set("long",
    "原来是个放牛娃，后与织女相爱，生下一双儿女，后被罚银河永隔，\n只有每年的七月初七才能鹊桥相会。\n");
  set("gender", "男性");
  set("age", 20);
  set("class", "xian");
  set("title", "");
  set("attitude", "friendly");
  set("per", 30);
  set("int", 30);
  set("max_kee", 1000);
  set("max_gin", 1000);
  set("max_sen", 1000);
  set("force", 1000);
  set("max_force", 1000);
  set("force_factor", 50);
  set("max_mana", 500);
  set("mana", 500);
  set("mana_factor", 0);
  set("combat_exp", 600000);
  set("daoxing", 500000);


  set_skill("literate", 50);
  set_skill("unarmed", 150);
  set_skill("dodge", 100);
  set_skill("force", 100);
  set_skill("parry", 100);
  set_skill("blade", 170);
  set_skill("xuanhu-blade", 170);
  set_skill("spells", 50);
  set_skill("moonshentong", 50);
  set_skill("baihua-zhang", 50);
  set_skill("moondance", 50);
  set_skill("moonforce", 100);
  map_skill("spells", "moonshentong");
  map_skill("force", "moonforce");
  map_skill("blade", "xuanhu-blade");
  map_skill("parry", "xuanhu-blade");
  map_skill("unarmed", "baihua-zhang");
  map_skill("dodge", "moondance");
  set("inquiry", ([

    //        "技能升级": (: skill_lvl :),
  ]));
  create_family("月宫", 2, "弟子");
  setup();

  carry_object("/d/obj/cloth/linen")->wear();
  carry_object("/d/obj/weapon/blade/yuandao")->wield();
}
void init() {
  //	add_action("do_improve","upgrade");	
}
void attempt_apprentice(object ob) {
  if (!((string)ob->query("gender") == "男性")) {
    command("shake");
    command("say 男女有别，若收了你，日后练功多有不便，你还是另择他人吧!\n");
    return;
  }
  command("pat " + ob->query("id"));
  command("say 同是天涯沦落人，今天我就收下你！日后好生练功，他日必有所成！\n");
  command("recruit " + ob->query("id"));
  return;
}

int recruit_apprentice(object ob) {
  if ( ::recruit_apprentice(ob))
    ob->set("class", "xian");
}
string skill_lvl() {
  object me = this_player();
  if ((string)me->query("family/family_name") != "月宫") {
    return ("你不是本门的人啊，我怎么能随便教你！");

  }
  message_vision(
    CYN "$N对$n说：我可以将刀法(blade)到专家。\n用(upgrade xxx for xxx)来升级(xxx分别为技能和等级的英文名)。\n" NOR,
    this_object(),
    me
  );

  me->set_temp("skill_improve/asked", 1);
  return ("不过，专家需要你给我100两黄金，你看如何？");
}
int do_improve(string arg) {
  string what, lvl;
  object me;
  int count;
  me = this_player();
  count = me->query("betray/count");
  if ((string)me->query("family/family_name") != "月宫") {
    return 0;

  }
  if (!me->query_temp("skill_improve/asked"))
    return 0;

  if (!arg)
    return notify_fail("格式如下：upgrade 技能名 for 等级名! \n");
  sscanf(arg, "%s for %s", what, lvl);
  if (!what)
    return notify_fail("格式如下：upgrade 技能名 for 等级名 !\n");
  if (!lvl)
    return notify_fail("格式如下：upgrade 技能名 for 等级名 !\n");
  if (what != "spear")
    return notify_fail("目前只提供枪法(spear)的升级! \n");
  if (lvl != "expert" && lvl != "master")
    return notify_fail("目前只能升级到专家(expert)或者大师(master)! \n");
  if (me->query_ob_skill_level(what) == "grandmaster")
    return notify_fail("你达到宗师境界，还来升什么！\n");
  if (me->query_ob_skill_level(what) == lvl)
    return notify_fail("你已经是这项技能的" + lvl + "了！\n");

  if (!me->query_ob_skill_level(what) && lvl == "master")
    return notify_fail("你现在连专家都不是呢！\n");
  if ((int)me->query_skill(what, 1) < 100 && lvl == "expert")
    return notify_fail("专家要求你达到100级的技能！\n");
  if ((int)me->query_skill(what, 1) < 200 && lvl == "master")
    return notify_fail("大师要求你达到200级的技能！\n");
  if (what == "blade" && lvl != "expert")
    return notify_fail("我只能升级刀法到专家！\n");
  if (me->query_ob_skill_level(what) == "master" && lvl == "expert")
    return notify_fail("你要将大师技能升成专家？？！\n");
  if (!LEVEL_D->check_ob_for_level(me, lvl))
    return notify_fail("你对本门的贡献似乎不够啊。。\n");
  if (!me->query_temp("skill_improve/paid"))
    return notify_fail("专家需要100两黄金，大师则需要500两!\n");

  if (me->query_temp("skill_improve/paid") < 1000000 && lvl == "expert")
    return notify_fail("你给的黄金似乎不够啊!\n");
  if (me->query_temp("skill_improve/paid") < 5000000 && lvl == "master")
    return notify_fail("你给的黄金似乎不够啊!\n");


  me->set("skill_level/" + what, lvl);
  if (lvl == "expert") lvl = "专家";
  else lvl = "大师";
  switch (what) {

    case "blade":
      what = "刀法";
      break;


  }
  tell_object(me, "恭喜你，你的" + what + "已经升级为" + lvl + "!\n");

  me->delete_temp("skill_improve/paid");
  return 1;


}
int accept_object(object who, object ob) {
  int value = ob->value();
  if (!who->query_temp("skill_improve/asked"))
    return 0;


  if (value == 0) {
    message_vision(CYN "$N说道：你给我这个干什么？\n" NOR, this_object());
    return 0;
  }
  who->add_temp("skill_improve/paid", value);
  return 1;

}
