#include <armor.h>
#include <ansi.h>

inherit WRISTS;

void create()
{
  set_name(HIG "倾城之恋" NOR, ({ "love" }));
  set("weight", 100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "个");
   set("long", "真爱的力量能倾城吗？现在的我深信不已。\n");
    set("value", 1000);
    set("material", "gold");
    set("armor_prop/armor", 10);
    set("armor_prop/personality", 5);
  }
  setup();
}

