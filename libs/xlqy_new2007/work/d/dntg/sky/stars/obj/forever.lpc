#include <armor.h>
#include <ansi.h>

inherit HANDS;

void create()
{
  set_name(HIR "永志不忘" NOR, ({ "forever" }));
  set("weight", 100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "双");
    set("long", "我和你只能在虚幻的世界里长相厮守，但你的名字我永远无法忘记！\n");
    set("value", 1000);
    set("material", "gold");
    set("armor_prop/armor", 10);
    set("armor_prop/personality", 5);
  }
  setup();
}

