#include <armor.h>
#include <ansi.h>

inherit WRISTS;

void create()
{
  set_name(HIR "一剑钟情" NOR, ({ "kiss" }));
  set("weight", 100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "生");
                set("long", "一剑钟情。\n");
    set("value", 1000);
    set("material", "gold");
    set("armor_prop/armor", 10);
    set("armor_prop/personality", 5);
  }
  setup();
}

