#include <weapon.h>
#include <ansi.h>
inherit BLADE;

void create() {
  set_name(HIG "宇文成刀" NOR, ({ "chengdu_dao" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long", "传说有一把神秘爱情誓言的宝刀。\n");
    set("value", 0);
    set("material", "steel");
    set("keenness", 50);
  }
  init_blade(10);
  setup();
}
