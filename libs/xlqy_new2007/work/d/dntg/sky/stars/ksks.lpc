inherit NPC;
#include <ansi.h>

void create() {
  set_name("明无", ({ "star ksks", "ksks", "star" }));
  set("gender", "男性");
  set("title", "通风大圣");
  set("age", 39);
  set("long", "    \n爱,认真就好\n别急着实现那些别人说的\n天荒地老\n");

  set("attitude", "heroism");
  set("class", "mo");
  set("combat_exp", 28285490);
  set("daoxing", 26756000);
  set("kee", 3338);
  set("max_kee", 3338);
  set("sen", 3162);
  set("max_sen", 3162);
  set("force", 13600);
  set("max_force", 6800);
  set("mana", 17620);
  set("max_mana", 8810);
  set("force_factor", 340);
  set("mana_factor", 440);
  set("str", 36);
  set("per", 30);

  set_skill("force", 438);
  set_skill("spells", 510);
  set_skill("dodge", 580);
  set_skill("parry", 614);
  set_skill("unarmed", 611);
  set_skill("spear", 614);
  set_skill("stick", 300);
  set_skill("literate", 210);

  set_skill("moyun-shou", 611);
  set_skill("wuyue-spear", 614);
  set_skill("huoyun-qiang", 614);
  set_skill("dali-bang", 614);
  set_skill("moshenbu", 580);
  set_skill("huomoforce", 461);
  set_skill("pingtian-dafa", 401);
  set_skill("kugu-blade", 61);

  map_skill("force", "huomoforce");
  map_skill("spells", "pingtian-dafa");
  map_skill("dodge", "moshenbu");
  map_skill("parry", "wuyue-spear");
  map_skill("unarmed", "moyunshou");
  map_skill("spear", "wuyue-spear");
  map_skill("stick", "dali-bang");

  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: cast_spell, "zhuang" :),
    (: perform_action, "spear", "fengchan" :),
    (: perform_action, "unarmed", "zhangxinlei" :),
  }));
  set_temp("apply/armor", 300);
  set_temp("apply/damage", 150);
  set_temp("apply/armor_vs_force", 300);
  set_temp("apply/defense", 240);
  set_temp("apply/strength", 300);
  set_weight(1000000);

  set("inquiry", ([

  ]));


  setup();

  carry_object(__DIR__ "obj/spear")->wield();
  carry_object(__DIR__ "obj/waist")->wear();
  carry_object(__DIR__ "obj/pifeng")->wear();

}

void init() {
  object me = this_object();
  object my_weapon, my_armor1, my_armor2;
  string weapon_id = "spear";
  string armor1_id = "waist", armor2_id = "pifeng";
  ::init();
  if (my_weapon = present(weapon_id, me))
    my_weapon->set("name", HIR "火云枪" NOR);
  if (my_armor1 = present(armor1_id, me))
    my_armor1->set("name", HIC "金利来领带" NOR);
  if (my_armor2 = present(armor2_id, me))
    my_armor2->set("name", HIY "鳄鱼衬衫" NOR);
}

void unconcious() {
  die();
}
