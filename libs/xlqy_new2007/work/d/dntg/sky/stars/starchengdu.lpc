inherit NPC;
#include <ansi.h>

void create()
{
   set_name(HIG"宇文成都"NOR,({"star chengdu","chengdu"}));
  set("gender", "男性");
  set("title", HIG"平天大圣"NOR);
  set("age", 70);

  set("attitude", "heroism");
  set("class", "swordman");
  set("combat_exp", 11267985);
  set("daoxing", 6585700);
  set("kee", 1855);
  set("max_kee", 1855);
  set("sen", 1543);
  set("max_sen", 1543);
  set("max_force", 4820);
  set("force", 9640);
  set("max_mana", 4873);
  set("mana", 9746);
       set("force_factor", 250);
       set("mana_factor", 250);
  set("str", 40);
  set("per", 30);
  set_skill("canxin-jian", 450);
  set_skill("dodge", 440);
  set_skill("force", 351);
  set_skill("fumozhang", 402);
  set_skill("literate", 195);
  set_skill("mindsword", 421);
  set_skill("parry", 441);
  set_skill("sevensteps", 440);
  set_skill("spells", 350);
  set_skill("sword", 441);
  set_skill("taoism", 313);
  set_skill("unarmed", 402);
  set_skill("whip", 286);
  set_skill("yirubian", 442);
  set_skill("yujianshu", 285);
  set_skill("zixia-shengong", 307);
        map_skill("dodge", "sevensteps");
        map_skill("sword", "canxin-jian");
        map_skill("parry", "mindsword");
        map_skill("unarmed", "fumozhang");
        map_skill("spells", "taoism");
        map_skill("force", "zixia-shengong");
       set("chat_chance_combat", 100);
       set("chat_msg_combat", ({
                (: perform_action, "sword", "xuyuan" :),
                 (: perform_action, "sword", "jinsheng" :),
                (: cast_spell, "jianshen" :),
                }) );
        create_family("蜀山剑派", 5, "弟子");
        setup();
        carry_object("/d/dntg/sky/stars/obj/xiaojiasword")->wield();
        carry_object("/d/dntg/sky/stars/obj/love")->wear();
        carry_object("/d/dntg/sky/stars/obj/forever")->wear();
}
void die()
{
  if (environment())
    message("sound", "\n"+this_object()->query("name")+"嘿嘿的奸笑了几声。\n\n", environment());
  set("eff_kee", 2000);
  set("eff_gin", 1000);
  set("eff_sen", 1500);
  set("kee", 2000);
  set("sen", 1500);
  set("gin", 1000);
}
void unconcious()
{
  die();
}

