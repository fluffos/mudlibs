inherit NPC;
#include <ansi.h>

void create()
{
   set_name(HIG"轻舞飞扬"NOR,({"star yunyun","yunyun"}));
  set("gender", "女性");
   set("title", HIB"混天大圣"NOR);
   set("age",59);

  set("attitude", "heroism");
  set("class", "xian");
  set("combat_exp", 9502783);
  set("daoxing", 14021100);
  set("kee", 1763);
  set("max_kee", 1763);
  set("sen", 1738);
  set("max_sen", 1738);
  set("max_force", 4870);
  set("force", 9940);
  set("max_mana", 4940);
  set("mana", 9880);
       set("force_factor", 250);
       set("mana_factor", 250);
  set("str", 40);
  set("per", 30);
   set_skill("blade", 420);
   set_skill("dodge", 421);
   set_skill("force", 351);
   set_skill("jueqingbian", 387);
   set_skill("literate", 160);
   set_skill("moondance", 403);
   set_skill("moonshentong", 302);
   set_skill("parry", 418);
   set_skill("snowsword", 401);
   set_skill("spells", 387);
   set_skill("sword", 420);
   set_skill("unarmed", 214);
   set_skill("whip", 215);
   set_skill("xuanhu-blade", 401);
        map_skill("dodge", "moondance");
        map_skill("sword", "snowsword");
        map_skill("parry", "snowsword");
         map_skill("blade", "xuanhu-blade");
        map_skill("spells", "moonshentong");
        map_skill("force", "moonforce");
       set("chat_chance_combat", 100);
       set("chat_msg_combat", ({
                (: perform_action, "blade", "duanfa" :),
                (: cast_spell, "mihun" :),
                }) );
        create_family("月宫", 2, "弟子");
        setup();
        carry_object("/d/dntg/sky/stars/obj/rain")->wield();
        carry_object("/d/dntg/sky/stars/obj/ring")->wear();
        carry_object("/d/dntg/sky/stars/obj/zhuo")->wear();
}
void die()
{
  if (environment())
    message("sound", "\n"+this_object()->query("name")+"嘿嘿的奸笑了几声。\n\n", environment());
  set("eff_kee", 2000);
  set("eff_gin", 1000);
  set("eff_sen", 1500);
  set("kee", 2000);
  set("sen", 1500);
  set("gin", 1000);
}
void unconcious()
{
  die();
}

