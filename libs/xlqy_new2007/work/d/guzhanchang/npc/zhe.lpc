inherit NPC;
string ask_dong();
int ask_xiulian();
#include <ansi.h>

void create()
{
   set_name(HIR"九重天守护者"NOR, ({ "shouhu zhe", "shouhu", "zhe"}));
   set("long", @LONG

从前现在过去了再不来
红红落叶长埋尘土内
开始终结总是没变改
天边的你飘泊白云外
LONG);
   set("gender", "男性");
   set("title",HIY"普渡众生"NOR);
   set("age", 20);
   set("attitude", "peaceful");
   set("per",100);//means no rong-mao description.
   set("max_kee", 12000);
   set("max_gin", 14000);
   set("max_sen", 12000);
   set("force", 12000);
   set("max_force", 12000);
   set("force_factor", 500);
   set("max_mana", 12000);
   set("mana", 12000);
   set("mana_factor", 600);
   set("combat_exp", 36543210);
   set("daoxing", 36543210);
   set_skill("spells", 900);
   set_skill("buddhism", 900);
   set_skill("unarmed", 900);
   set_skill("jienan-zhi", 900);
   set_skill("dodge", 900);
   set_skill("lotusmove", 900);
   set_skill("parry", 900);
   set_skill("force", 900);
   set_skill("lotusforce", 900);
   set_skill("staff", 900);
   set_skill("lunhui-zhang", 900);
   map_skill("spells", "buddhism");
   map_skill("unarmed", "jienan-zhi");
   map_skill("dodge", "lotusmove");
   map_skill("force", "lotusforce");
   map_skill("parry", "lunhui-zhang");
   map_skill("staff", "lunhui-zhang");
   
   set("skill_level/staff","grandmaster");
   set("skill_level/spells","grandmaster");
   set_temp("apply/sub_max_armor",4900);
   set_temp("apply/sub_max_defense",4900);
   set_temp("apply/combat_double_damage",4900);
   set_temp("apply/damage",108);
    create_family("南海普陀山", 2, "蓝");
   set("chat_chance_combat", 80);
   set("chat_msg_combat", ({
                (: cast_spell, "bighammer" :),
        }) );

   set("inquiry",([
      "九重天": (: ask_dong:),
      "9sky": (: ask_dong:),
      	"修炼": (: ask_xiulian:),
      "xiulian": (: ask_xiulian:),		
       ]));

   setup();
  carry_object("/d/obj/armor/jinjia")->wear();
  carry_object("/d/obj/weapon/staff/budd_staff")->wield();
   }
void init()
{
   
    add_action("do_agree", "agree");
}
int ask_xiulian()
{
        object ob = this_object();
        object me = this_player();
        if(me->query("9sky/all"))
        {
        	 command("nod");	
        	 me->move("/d/shendian/kushi1");
        	 return 1;
        	
        }
      
}
string ask_dong()
{
        object ob = this_object();
        object me = this_player();
        if(me->query("9sky/all"))
        {
        	 command("hehe");	
        	 me->move("/d/guzhanchang/sky");
        	 return "去吧!";
        	
        }
        if( me->query("combat_exp") > 3000000  )
       {
            command("nod");
	    command("say 要想到达九重天须得受我的普渡，若你不死，定当助你！");
	    this_player()->set_temp("pending/9sky/to_be_hit", 1);
	    return "你可愿意一试？(agree)";
	
        }
        return "你修为不足，强求亦是枉然。";
}
void move_dong(object me)
{
	tell_object(me, HIW"江山代有人才出，去吧!\n"NOR);
	tell_object(me, HIY"要想成为宗师不应该仅仅只凭武功的强弱，更应该像古龙七种武器里写的那样...要有机智，运气，诚信，博爱，勇敢，无私和牺牲精神...\n"NOR);
	me->move("/d/guzhanchang/lukou");
	
	
}

int do_agree(string arg)
{
    object me=this_player(), npc=this_object(), ob;
  
    if (!me->query_temp("pending/9sky/to_be_hit"))
	return 0;
    me->delete_temp("pending/9sky/to_be_hit");
    npc->set("kee", 12000);
    npc->set("eff_kee", 12000);
   npc->set("eff_sen", 12000);
   npc->set("sen", 12000);
   npc->set("force", 12000);
   npc->set("max_force", 12000);
   npc->set("force_factor", 365);
   npc->set("max_mana", 12000);
   npc->set("mana", 12000);
   npc->set("mana_factor", 600);
  
  
    if (!(ob=query_temp("weapon"))
     || ob->query_temp("skill_type") != "staff")
    {
	destruct(ob);
	ob=new("/d/obj/weapon/staff/budd_staff");
	ob->move(npc);
	command("wield staff");
    }
    command("say 善哉，善哉！");
    
     message_vision(HIY"$N"+HIY"气沉丹田，犹如金刚浑身发金光，招转佛门正宗绝招「慈光普渡」，向$n连续发动进攻！\n"NOR,npc,me);
     npc->set("ciguangpudu", 6);
        COMBAT_D->do_attack(npc, me, npc->query_temp("weapon"));
        
        npc->set("ciguangpudu", 7);
        COMBAT_D->do_attack(npc, me, npc->query_temp("weapon"));
        
        npc->set("ciguangpudu", 8);
        COMBAT_D->do_attack(npc, me, npc->query_temp("weapon"));
        
        npc->set("ciguangpudu", 9);
        COMBAT_D->do_attack(npc, me, npc->query_temp("weapon"));
        
        npc->delete("ciguangpudu");
        message_vision(HIW"$N"+HIW"低吟“阿弥陀佛！”「慈光普渡」用功完毕，身上淡淡的金光慢慢隐去.\n"NOR,npc,me);
      
        me->start_busy(1);
	  npc->set("kee", 12000);
	    npc->set("eff_kee", 12000);
	   npc->set("eff_sen", 12000);
	   npc->set("sen", 12000);
	   npc->set("force", 12000);
	   npc->set("max_force", 12000);
	   npc->set("force_factor", 500);
	   npc->set("max_mana", 12000);
	   npc->set("mana", 12000);
	   npc->set("mana_factor", 600);
        if(me->query("eff_kee") > 1&&me->query("kee") > 1)
        {
        	command("cast regenerate on "+me->query("id"));
        	me->set_temp("9sky/start",1);
        	move_dong(me);
        	
        }
        else {
        	command("sigh");
        	me->set("eff_kee",1);
        	me->set("kee",1);
          	}

    return 1;
}
