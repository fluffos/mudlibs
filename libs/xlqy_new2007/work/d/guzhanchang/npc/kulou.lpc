inherit NPC;
#include <ansi.h>
int big_blowing();
void create()
{
 set_name("骷髅王", ({ "ku lou", "lou" }) );
 set("gender", "雄性");
 set("age", 1500);
 set("long",
"这是古战场的骷髅王 ，具有极强的抗魔法和物理伤害的能力！\n");
 set("str", 48);
 set("cor", 52);
 set("cps", 44);
 set("max_kee", 15000);
 set("max_gin", 15000);
 set("max_sen", 15000);
 set("force",4500);
 set("max_force",4500);
 set("mana",4500);
 set("max_mana",4500);
 set("force_factor",120);
 set_skill("parry",320+random(50));
 set_skill("dodge",320+random(50));
 set_skill("ghost-steps",320+random(50));
 set_skill("unarmed",320+random(50));
 set_skill("yinfeng-zhua",320+random(50));
 map_skill("unarmed","yinfeng-zhua");
 map_skill("parry","yinfeng-zhua");
 map_skill("dodge","ghost-steps");
 set("attitude", "aggressive");
 set("combat_exp", 3500000+random(1500000));
  set("chat_chance_combat", 50);
 	 set("chat_msg_combat", ({
                (: big_blowing :),
               
                }) );
 setup();
 set_temp("apply/sub_max_phy",6000);
 set_temp("apply/sub_max_spells_all",6000);
  carry_object("/d/guzhanchang/obj/xjdan");
}
void init()
{
	if(interactive(this_player()))
		this_object()->kill_ob(this_player());	
	
	
	
}
int big_blowing()
{
	int i ;
	object	me = this_object();
	object who = me->select_opponent();
	if(!who)	return 0;
	if(me->query("mana") < 800) 	return 0;
	if(me->is_busy()) 	return 0;
	message_vision(RED"$N空空洞洞的眼眶中突然红光一闪！\n"NOR,me);
	me->add("mana",-600);
	if(random(100) > 65)
	{
		i = random(3);
		if(i == 0)
		{
			if(!who->is_busy())
				who->start_busy(1+random(2));
			message_vision(HIR"$N受到地狱无尽冤魂所缠绕！\n"NOR,who);	
		}
		else if(i == 1)
		{
			if(who->query_temp("combat/bless") > -100)
				who->add_temp("combat/bless",-1);
			message_vision(HIR"$N受到地狱无尽冤魂所诅咒！\n"NOR,who);
		}
		else 
		{
			if(who->query_temp("combat/lucky") > -100)
				who->add_temp("combat/lucky",-1);
			message_vision(HIR"$N受到地狱无尽冤魂所怨恨！\n"NOR,who);
		}
		
		
	}
	return 1;
	
}
 varargs int receive_damage(string type, int damage, mixed who, string d_type) 
{ 
      damage = damage/3;   
        return ::receive_damage(type,damage,who,d_type); 
     
 } 
varargs int receive_wound(string type, int damage, mixed who, string d_type) 
 { 
        
      damage = damage/3;  
       return ::receive_wound(type,damage,who,d_type); 
   
} 