#include <ansi.h>;
inherit NPC;
#include "star.h"

string* msg =({
	HIW"胆识或者叫做勇气，是一个人行走江湖必须的素质。\n"NOR,
	HIR"赴汤蹈火是一种勇气，明知不可为而为之也需要胆识。\n"NOR,
	HIC"所谓勇者无敌，不是说他武力如何的高强，而是只要有勇气有信心就是无敌的！\n"NOR,
	HIY"但光讲勇气而不讲策略，则是蛮夫的行为。要作为宗师，光勇气还是不够的啊。\n"NOR,
	HIG"虽千万人吾往矣，这是多么雄伟的气概啊！\n"NOR,
}); 
void create()
{
        set_name("女娲娘娘", ({ "shouhuzhe", "shouhu zhe", "zhe" }) );
        set("gender", "女性" );
	set("long",
		"守护第七重天的守护者----众生之母女娲娘娘\n"
	);
  set("str", 20);
  set("per", 130);
 set("age", 86);
  set("cor", 100);
  set("cps", 40);
  set("kar", 40);
  set("int", 40);
  set("con", 40);
  set("spi", 40);
  set("family/family_name","月宫");

  set("title", "守护者");
  set("combat_exp", 11900000);
  set("daoxing", 11900000);
  set("max_sen", 21000);
  set("max_kee", 21000);
  set("force", 18000); 
  set("max_force", 9000);
  set("force_factor", 0);
  set("max_mana", 18000);
  set("mana", 9000);
  set("mana_factor", 450);
set("class","xian");	
  set("no_arrest",1);
              set_skill("literate", 500);
       set_skill("unarmed", 500);
       set_skill("dodge", 500);
       set_skill("force", 500);
       set_skill("parry", 500);
       set_skill("sword", 500);
       set_skill("spells", 500);
   set_skill("moonshentong", 500);
   set_skill("baihua-zhang", 500);
   set_skill("moonforce", 500);
   set_skill("snowsword", 500);
   set_skill("moondance", 500);
   map_skill("spells", "moonshentong");
   map_skill("unarmed", "baihua-zhang");
   map_skill("force", "moonforce");
   map_skill("sword", "snowsword");
   map_skill("parry", "snowsword");
   map_skill("dodge", "moondance");
   
   set("skill_level/sword","grandmaster");
	set("skill_level/dodge","master");
	
	set_temp("apply/sub_max_armor",6000);
	
 set_temp("apply/damage",360);
  set_temp("apply/armor",640);
   set("chat_chance_combat", 75);
        set("chat_msg_combat", ({
                (: cast_spell, "arrow" :),
                (: perform_action, "sword","wuxue" :),
								(: perform_action, "sword","tian" :),
        }) );



	setup();
   carry_object("/d/npc/obj/sword")->wield();
  carry_object("/d/npc/obj/armor")->wear();
}


void init()
{
      	object ob;
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
       }  
        add_action("do_none","ji");
        add_action("do_cast","cast");
        add_action("do_perform","perform");
        
        add_action("do_none","hun");
}
void greeting(object who)
{
	if(who->query_temp("9sky/start"))
		tell_object(who,MAG"女娲娘娘一亮手中神剑，言道：让老身来考较考较你的勇敢。\n"NOR);	
}
int do_none()
{
        object me = this_object();
        message_vision("此乃天界，岂容你乱来？\n",me);
        return 1;
} 

int do_cast(string arg)
{
    
        string cast_id,cast_name;
        object who = this_player();
        
        if(!arg) return 0;
     	 
     if (sscanf(arg, "%s", cast_id) == 1)
        if(cast_id=="chuqiao"||cast_id=="jieti"|| cast_id=="jiushen")
          {   message_vision("此乃天界，岂容你乱来？\n",who);
       return 1;}  
       else 
    if (sscanf(arg, "%s on %s", cast_id,cast_name) == 2)
     
      if(cast_id=="jieti" || arg=="jieti" || cast_id=="jiushen" || arg=="jiushen" )
      {
       	 message_vision("此乃天界，岂容你乱来？\n",who);
       	  return 1;
       }
    
      
} 
int do_perform(string arg)
{
    
        string cast_id,cast_name;
        object who = this_player();
        
        if(!arg) return 0;
     	
	   if(sscanf(arg, "%s on %s", cast_id,cast_name) == 2)
	  {
	  
		   if( cast_id=="fall"||cast_id=="huadie"|| cast_id=="huifeng")
		  {   message_vision("此乃天界，岂容你乱来？\n",who);
		      return 1;
		
		     }
	}
	else  if(sscanf(arg, "%s", cast_id) == 1)
	  {
	  	 if(cast_id=="fall"|| cast_id=="huadie"|| cast_id=="huifeng")
		{
		     message_vision("此乃天界，岂容你乱来？\n",who);
		      return 1;
		
		}
		  else return 0;
	  	
	  }
  	else return 0;
    
      
} 

void die()
{

       
           object ob = query_temp("last_damage_from");
	  object killer=query_temp("my_killer");
	  object last =query_temp("last_killed_by");
	  string faint=query_temp("last_fainted_from");
	 if(!ob)
	  {
	  
	    	 this_object()->move("/obj/void");
	    	 destruct(this_object());
	    	  
	    	  return;	
	  	
	}
	if(environment(ob)->query("short")!= "第七重天入口处")
	{
		 this_object()->move("/obj/void");
	    	 destruct(this_object());
		return;	
		
	}
  if(!ob->query_temp("9sky/start"))
    	{
    	 
    	  
    	 this_object()->move("/obj/void");
	    	 destruct(this_object());
    	  
    	  return;
    	}

  if(faint && ob) {
      if(faint!=ob->query("id"))
      		{
      		    this_object()->move("/obj/void");
	    	 destruct(this_object());
      		   
      		      return;
      		}
      	}
      if(!last) last=ob;
 	 else if(last!=ob)
  	{ this_object()->move("/obj/void");
	    	 destruct(this_object());return;}

        if((ob&&ob->query("9sky/liu")=="done") && (ob&&ob->query("9sky/qi")!="done"))
        {
        ob->start_busy(3);
        message("chat",HIY+"【九重天】天极(Tian ji):"+ob->name()+
        "闯过了七重·逸仙天\n"NOR,users());
        ob->set("9sky/qi","done");
        ob->add("9sky/number",1);
         ob->add("daoxing", 77000);
         ob->add("wuxing_add/max_all",700); 
           ob->save();
         tell_object(ob,"你赢得了七十七年道行，你的五行攻击永久增加了7％！\n");

        }
      this_object()->move("/obj/void");
	    	 destruct(this_object());
}

 varargs int receive_damage(string type, int damage, mixed who, string d_type) 
{ 
      if(who&&objectp(who))
      {
      	if(random(who->query_cor()) < 15)
      	{
      		tell_object(who,msg[random(sizeof(msg))]);
      		damage = damage/4;
      	}
      }
        return ::receive_damage(type,damage,who,d_type); 
     
 } 
varargs int receive_wound(string type, int damage, mixed who, string d_type) 
 { 
        
      if(who&&objectp(who))
      {
      if(random(who->query_cor()) < 15)
      	{
      		damage = damage/4;
      	}	
      }
       return ::receive_wound(type,damage,who,d_type); 
   
} 
