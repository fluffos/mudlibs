#include <ansi.h>;
inherit NPC;
#include "star.h"
string* msg =({
	HIW"运气，福缘或者叫做rp，如果不好你就什么都得不到。\n"NOR,
	HIR"何谓运气，气数和命运也。\n"NOR,
	HIC"理直则气壮。故说，勿以善小而弗为，勿以恶小而为之！\n"NOR,
	HIY"万千众生惟你一人，窥天道晋宗师，岂非运气乎。\n"NOR,
	HIB"然而人生在世不能光靠运气，天上不会掉馅饼。\n"NOR,
	HIG"所谓赛翁失马，福兮祸兮？\n"NOR,
}); 
void create()
{
        set_name("白发老人", ({ "shouhuzhe", "shouhu zhe", "zhe" }) );
        set("gender", "男性" );
	set("long",
		"守护第一重天的守护者----将军府祖师白发老人\n"
	);
  set("str", 20);
  set("per", 130);
 set("age", 150);
  set("cor", 30);
  set("cps", 75);
  set("kar", 100);
  set("int", 40);
  set("con", 40);
  set("spi", 40);
  set("title", "守护者");
  set("family/family_name","将军府");
  set("combat_exp", 9000000);
  set("daoxing", 9000000);
  set("max_sen", 12000);
  set("max_kee", 12000);
  set("force", 12000); 
  set("max_force", 6000);
  set("force_factor", 300);
  set("max_mana", 6000);
  set("mana", 12000);
  set("mana_factor", 300);
  set("class","fighter");	
  set_skill("literate", 400);
  set_skill("unarmed", 400);
  set_skill("force", 400);
  set_skill("lengquan-force", 400);
  set_skill("axe", 400);
  set_skill("sword", 400);
  set_skill("dodge", 400);
  set_skill("parry", 400);
  set_skill("sanban-axe", 400);
  set_skill("xiaofeng-sword", 400);
  set_skill("spells", 400);
  set_skill("baguazhou", 400);
  set_skill("yanxing-steps", 400);
  set_skill("changquan", 400);
  map_skill("force", "lengquan-force");
  map_skill("spells", "baguazhou");
  map_skill("axe", "sanban-axe");
  map_skill("parry", "sanban-axe");
  map_skill("dodge", "yanxing-steps");
  map_skill("sword", "xiaofeng-sword");
   map_skill("unarmed", "changquan");
  set("skill_level/axe","grandmaster");
  set("no_arrest",1);
  	
  set_temp("apply/combat_ignore_armor",6000);
  set_temp("apply/damage",360);
  set_temp("apply/armor",640);
  	
       set("chat_chance_combat", 75);
       set("chat_msg_combat", ({
                (: perform_action, "axe", "sanban" :),
                (: exert_function, "haste" :),
                		(: perform_action, "unarmed","zhiqi" :),
                }) );
	setup();
  carry_object("/d/npc/obj/axe")->wield();
   carry_object("/d/npc/obj/armor")->wear();
}


void init()
{
      	object ob;
        add_action("do_none","ji");
        add_action("do_cast","cast");
        add_action("do_perform","perform");
 
        add_action("do_none","hun");
    
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
       }
    
}
void greeting(object who)
{
	if(who->query_temp("9sky/start"))
		tell_object(who,HIY"白发老人一晃手中斧，言道：让老夫来考较考较你的运气。\n"NOR);	
}
int do_none()
{
        object me = this_object();
        message_vision("此乃天界，岂容你乱来？\n",me);
        return 1;
} 

int do_cast(string arg)
{
    
        string cast_id,cast_name;
        object who = this_player();
        
        if(!arg) return 0;
     	 
     if (sscanf(arg, "%s", cast_id) == 1)
        if(cast_id=="chuqiao"||cast_id=="jieti"|| cast_id=="jiushen")
          {   message_vision("此乃天界，岂容你乱来？\n",who);
       return 1;}  
       else 
    if (sscanf(arg, "%s on %s", cast_id,cast_name) == 2)
     
      if(cast_id=="jieti" || arg=="jieti" || cast_id=="jiushen" || arg=="jiushen" )
      {
       	 message_vision("此乃天界，岂容你乱来？\n",who);
       	  return 1;
       }
    
      
} 
int do_perform(string arg)
{
    
        string cast_id,cast_name;
        object who = this_player();
        
        if(!arg) return 0;
     	
	   if(sscanf(arg, "%s on %s", cast_id,cast_name) == 2)
	  {
	  
		   if(cast_id=="fall"||cast_id=="huadie"|| cast_id=="huifeng")
		  {   message_vision("此乃天界，岂容你乱来？\n",who);
		      return 1;
		
		     }
	}
	else  if(sscanf(arg, "%s", cast_id) == 1)
	  {
	  	 if(cast_id=="fall"||cast_id=="huadie"|| cast_id=="huifeng")
		{
		     message_vision("此乃天界，岂容你乱来？\n",who);
		      return 1;
		
		}
		  else return 0;
	  	
	  }
  	else return 0;
    
      
} 

void die()
{
	  object ob = query_temp("last_damage_from");
	  object killer=query_temp("my_killer");
	  object last =query_temp("last_killed_by");
	  string faint=query_temp("last_fainted_from");
	
	 if(!ob)
	  {
	  
	    	 this_object()->move("/obj/void");
	    	 destruct(this_object());
	    	  
	    	  return;	
	  	
	}
	 
	if(environment(ob)->query("short")!= "第一重天入口处")
	{
		 this_object()->move("/obj/void");
	    	 destruct(this_object());
		return;	
		
	}
  if(!ob->query_temp("9sky/start"))
    	{
    	 
    	  
    	  this_object()->move("/obj/void");
	    	 destruct(this_object());
    	  
    	  return;
    	}

  if(faint && ob) {
      if(faint!=ob->query("id"))
      		{
      		   this_object()->move("/obj/void");
	    	 destruct(this_object());
      		   
      		      return;
      		}
      	}
      if(!last) last=ob;
 	 else if(last!=ob)
  	{ this_object()->move("/obj/void");
	    	 destruct(this_object());return;}

        if(ob&&ob->query("9sky/yi")!="done")
        {
	        ob->start_busy(3);
	        message("chat",HIY+"【九重天】天极(Tian ji):"+ob->name()+
	        "闯过了一重·傲野天\n"NOR,users());
	        ob->set("9sky/yi","done");
	        ob->add("9sky/number",1);
	         ob->add("daoxing", 10000);
	         ob->add("kar",1);
	            ob->save();
	        tell_object(ob,"你赢得了十年道行，你的福缘增加了一点！");
        
        }
        this_object()->move("/obj/void");
	    	 destruct(this_object());
}
 varargs int receive_damage(string type, int damage, mixed who, string d_type) 
{ 
      if(who&&objectp(who))
      {
      	if(random(who->query_kar()) < 10||random(who->query_kar()) > 30)
      	{
      		tell_object(who,msg[random(sizeof(msg))]);
      		damage = damage/2;
      	}
      }
        return ::receive_damage(type,damage,who,d_type); 
     
 } 
varargs int receive_wound(string type, int damage, mixed who, string d_type) 
 { 
        
      if(who&&objectp(who))
      {
      if(random(who->query_kar()) < 10||random(who->query_kar()) > 30)
      	{
      		damage = damage/2;
      	}	
      }
       return ::receive_wound(type,damage,who,d_type); 
   
} 
