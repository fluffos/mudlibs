#include <ansi.h>;
inherit NPC;
#include "star.h"
string* msg =({
	HIW"自由、平等、博爱是作为宗师应有的理念。\n"NOR,
	HIR"博爱是对所有人都有一种关切、同情、尊重和责任感。\n"NOR,
	HIC"安得广厦千万间,大庇天下寒士俱欢颜，这是一种博爱！\n"NOR,
	HIY"先天下之忧而忧,后天下之乐而乐，这是一种博爱。\n"NOR,
	HIG"博爱不是滥爱，对敌人的仁慈就是对自己的残忍。\n"NOR,
}); 
int do_daodao();
void create()
{
        set_name("冰雪凤凰", ({ "shouhuzhe", "shouhu zhe", "zhe" }) );
        set("gender", "女性" );
	set("long",
		"守护第六重天的守护者----圣峰孤莲冰雪凤凰\n"
	);
  set("str", 20);
  set("per", 130);
 set("age", 86);
  set("cor", 30);
  set("cps", 75);
  set("kar", 100);
  set("int", 40);
  set("con", 40);
  set("spi", 40);
  set("title", "守护者");
  set("combat_exp", 10900000);
  set("daoxing", 10900000);
  set("max_sen", 18000);
  set("max_kee", 18000);
  set("force", 15000); 
  set("max_force", 7500);
  set("force_factor", 350);
  set("family/family_name","大雪山");
  set("no_arrest",1);
  set("max_mana", 7500);
  set("mana", 15000);
  set("mana_factor", 350);
	
set("class","yaomo");		
	 set_skill("unarmed", 450);
        set_skill("cuixin-zhang", 450);
        set_skill("dodge", 450);
        set_skill("xiaoyaoyou", 450);
        set_skill("parry", 450);
        set_skill("sword", 450);
        set_skill("bainiao-jian", 450);
        set_skill("blade",450);
        set_skill("bingpo-blade", 450);
        set_skill("throwing", 450);
        set_skill("force", 450);   
        set_skill("ningxie-force", 450);
        set_skill("literate", 180);
        set_skill("spells", 450);
        set_skill("dengxian-dafa", 450);
        map_skill("spells", "dengxian-dafa");
        map_skill("force", "ningxie-force");
        map_skill("unarmed", "cuixin-zhang");
        map_skill("sword", "bainiao-jian");
        map_skill("blade", "bingpo-blade");
        map_skill("dodge", "xiaoyaoyou");
        map_skill("throwing","bainiao-jian");
        map_skill("parry","bainiao-jian");
	
	set("skill_level/throwing","grandmaster");
	set("skill_level/sword","grandmaster");
	set("skill_level/dodge","master");
	set_temp("apply/combat_double_damage",6000);
	 set_temp("apply/damage",360);
  set_temp("apply/armor",640);
        set("chat_chance_combat", 75);
        set("chat_msg_combat", ({
        	(: do_daodao :),
        	(: cast_spell, "hufa" :),
                (: perform_action, "sword","fengwu" :),
                 (: perform_action, "sword","chaofeng" :),
                 (: perform_action, "unarmed","cuixin" :),
         

	}) );


	setup();
   carry_object("/d/npc/obj/qin")->wield();
    carry_object("/d/npc/obj/blade");
   carry_object("/d/npc/obj/armor")->wear();
}


void init()
{
     	object ob;
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
       }  
        add_action("do_none","ji");
        add_action("do_cast","cast");
        add_action("do_perform","perform");
        
        add_action("do_none","hun");
}
void greeting(object who)
{
	if(who->query_temp("9sky/start"))
		tell_object(who,HIC"冰雪凤凰一亮手中天魔琴，言道：让老身来考较考较你的博爱。\n"NOR);	
}
int do_none()
{
        object me = this_object();
        message_vision("此乃天界，岂容你乱来？\n",me);
        return 1;
} 

int do_cast(string arg)
{
    
        string cast_id,cast_name;
        object who = this_player();
        
        if(!arg) return 0;
     	 
     if (sscanf(arg, "%s", cast_id) == 1)
        if(cast_id=="chuqiao"||cast_id=="jieti"|| cast_id=="jiushen")
          {   message_vision("此乃天界，岂容你乱来？\n",who);
       return 1;}  
       else 
    if (sscanf(arg, "%s on %s", cast_id,cast_name) == 2)
     
      if(cast_id=="jieti" || arg=="jieti" || cast_id=="jiushen" || arg=="jiushen" )
      {
       	 message_vision("此乃天界，岂容你乱来？\n",who);
       	  return 1;
       }
    
      
} 
int do_perform(string arg)
{
    
        string cast_id,cast_name;
        object who = this_player();
        
        if(!arg) return 0;
     	
	   if(sscanf(arg, "%s on %s", cast_id,cast_name) == 2)
	  {
	  
		   if( cast_id=="fall"||cast_id=="huadie"|| cast_id=="huifeng")
		  {   message_vision("此乃天界，岂容你乱来？\n",who);
		      return 1;
		
		     }
	}
	else  if(sscanf(arg, "%s", cast_id) == 1)
	  {
	  	 if( cast_id=="fall"||cast_id=="huadie"|| cast_id=="huifeng")
		{
		     message_vision("此乃天界，岂容你乱来？\n",who);
		      return 1;
		
		}
		  else return 0;
	  	
	  }
  	else return 0;
    
      
} 

int do_daodao()
{
	
	object me = this_object();
	me->command("perform fengwu");
	me->command("unwield sword");
	me->command("wield blade");
	me->command("perform hgz");
	me->command("unwield blade");
	me->command("wield sword");
	return 1;

}
void die()
{

           object ob = query_temp("last_damage_from");
	  object killer=query_temp("my_killer");
	  object last =query_temp("last_killed_by");
	  string faint=query_temp("last_fainted_from");
	 if(!ob)
	  {
	  
	    	  this_object()->move("/obj/void");
	    	 destruct(this_object());
	    	  
	    	  return;	
	  	
	}
	if(environment(ob)->query("short")!= "第六重天入口处")
	{
		 this_object()->move("/obj/void");
	    	 destruct(this_object());
		return;	
		
	}
  if(!ob->query_temp("9sky/start"))
    	{
    	 
    	  
    	 this_object()->move("/obj/void");
	    	 destruct(this_object());
    	  
    	  return;
    	}

  if(faint && ob) {
      if(faint!=ob->query("id"))
      		{
      		    this_object()->move("/obj/void");
	    	 destruct(this_object());
      		   
      		      return;
      		}
      	}
      if(!last) last=ob;
 	 else if(last!=ob)
  	{ this_object()->move("/obj/void");
	    	 destruct(this_object());return;}

        if((ob&&ob->query("9sky/wu")=="done") && (ob&&ob->query("9sky/liu")!="done"))
        {
        ob->start_busy(3);
        message("chat",HIY+"【九重天】天极(Tian ji):"+ob->name()+
        "闯过了六重·栖霞天\n"NOR,users());
        ob->set("9sky/liu","done");
        ob->add("9sky/number",1);
         ob->add("daoxing", 66000);
         ob->add("per",1);
           ob->save();
         tell_object(ob,"你赢得了六十六年道行，你的容貌增加了一点！");

        }
        this_object()->move("/obj/void");
	    	 destruct(this_object());
}

varargs int receive_damage(string type, int damage, mixed who, string d_type) 
{ 
      if(who&&objectp(who))
      {
      	if(random(who->query_per()) < 15)
      	{
      		tell_object(who,msg[random(sizeof(msg))]);
      		damage = damage/3;
      	}
      }
        return ::receive_damage(type,damage,who,d_type); 
     
 } 
varargs int receive_wound(string type, int damage, mixed who, string d_type) 
 { 
        
      if(who&&objectp(who))
      {
      if(random(who->query_per()) < 15)
      	{
      		damage = damage/3;
      	}	
      }
       return ::receive_wound(type,damage,who,d_type); 
   
} 
