#include <ansi.h>;
inherit NPC;
#include "star.h"

string* msg =({
	HIW"智慧是是一个人物天生的智能、或者说是「天才」。\n"NOR,
	HIR"天资聪颖者自然事半功倍，但切记不可用于使诈耍伎俩。\n"NOR,
	HIC"但天资低下可以通过努力来弥补，所谓笨鸟先飞是也。\n"NOR,
	HIY"如果凭借一点点小聪明而想成就大事还是远远不足的。\n"NOR,
}); 
void create()
{
        set_name("姜子牙", ({ "shouhuzhe", "shouhu zhe", "zhe" }) );
        set("gender", "男性" );
	set("long",
		"守护第四重天的守护者----封神尊者姜子牙\n"
	);
  set("str", 20);
  set("per", 130);
 set("age", 86);
  set("cor", 30);
  set("cps", 75);
  set("kar", 100);
  set("int", 40);
  set("family/family_name","五庄观");

  set("con", 40);
  set("spi", 40);
  set("title", "守护者");
  set("combat_exp", 10300000);
  set("daoxing", 10300000);
  set("max_sen", 18000);
  set("max_kee", 18000);
  set("force", 15000); 
  set("max_force", 7500);
  set("force_factor", 350);
  set("max_mana", 7500);
  set("mana", 15000);
  set("mana_factor", 350);
set("class","xian");	
  set("no_arrest",1);	
         set_skill("unarmed", 450);
   set_skill("wuxing-quan", 450);
   set_skill("dodge", 450);
   set_skill("baguazhen", 450);
   set_skill("parry", 450);
   set_skill("sword", 450);
   set_skill("sanqing-jian", 450);
   set_skill("staff", 450);
   set_skill("fumo-zhang", 450);
   set_skill("hammer", 450);
   set_skill("kaishan-chui", 450);
   set_skill("blade", 450);
   set_skill("yange-blade", 450);
   set_skill("force", 450);   
   set_skill("zhenyuan-force", 450);
   set_skill("literate", 450);
   set_skill("spells", 450);
   set_skill("taiyi", 450);
   map_skill("spells", "taiyi");
   map_skill("force", "zhenyuan-force");
   map_skill("unarmed", "wuxing-quan");
   map_skill("sword", "sanqing-jian");
   map_skill("dodge", "baguazhen");
   map_skill("staff", "fumo-zhang");
   map_skill("blade", "yange-blade");
   map_skill("hammer", "kaishan-chui");
  map_skill("parry", "sanqing-jian");
  
  	set("skill_level/sword","grandmaster");
	set("skill_level/dodge","master");
  set_temp("apply/combat_blood_force",6000);
   set_temp("apply/spells_vs_damage",6000);
	 set_temp("apply/damage",360);
  set_temp("apply/armor",640);
	
   set("chat_chance_combat", 90);
   set("chat_msg_combat", 
   ({
        (: cast_spell, "zhenhuo" :),
        (: cast_spell, "wuxing" :),
        (: perform_action, "sword","jianzhang" :),
				(: perform_action, "sword","juejian" :),
   }) );


	setup();
   carry_object("/d/npc/obj/sword")->wield();
  carry_object("/d/npc/obj/armor")->wear();
}


void init()
{
      	object ob;
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
       } 
        add_action("do_none","ji");
        add_action("do_cast","cast");
        add_action("do_perform","perform");
        
        add_action("do_none","hun");
}
void greeting(object who)
{
	if(who->query_temp("9sky/start"))
		tell_object(who,HIG"姜子牙一亮手中宝剑，言道：让老夫来考较考较你的智慧。\n"NOR);	
}
int do_none()
{
        object me = this_object();
        message_vision("此乃天界，岂容你乱来？\n",me);
        return 1;
} 

int do_cast(string arg)
{
    
        string cast_id,cast_name;
        object who = this_player();
        
        if(!arg) return 0;
     	 
     if (sscanf(arg, "%s", cast_id) == 1)
        if(cast_id=="chuqiao"||cast_id=="jieti"|| cast_id=="jiushen")
          {   message_vision("此乃天界，岂容你乱来？\n",who);
       return 1;}  
       else 
    if (sscanf(arg, "%s on %s", cast_id,cast_name) == 2)
     
      if(cast_id=="jieti" || arg=="jieti" || cast_id=="jiushen" || arg=="jiushen" )
      {
       	 message_vision("此乃天界，岂容你乱来？\n",who);
       	  return 1;
       }
    
      
} 
int do_perform(string arg)
{
    
        string cast_id,cast_name;
        object who = this_player();
        
        if(!arg) return 0;
     	
	   if(sscanf(arg, "%s on %s", cast_id,cast_name) == 2)
	  {
	  
		   if( cast_id=="fall"||cast_id=="huadie"|| cast_id=="huifeng")
		  {   message_vision("此乃天界，岂容你乱来？\n",who);
		      return 1;
		
		     }
	}
	else  if(sscanf(arg, "%s", cast_id) == 1)
	  {
	  	 if( cast_id=="fall"||cast_id=="huadie"|| cast_id=="huifeng")
		{
		     message_vision("此乃天界，岂容你乱来？\n",who);
		      return 1;
		
		}
		  else return 0;
	  	
	  }
  	else return 0;
    
      
} 


void die()
{

               object ob = query_temp("last_damage_from");
	  object killer=query_temp("my_killer");
	  object last =query_temp("last_killed_by");
	  string faint=query_temp("last_fainted_from");
	 if(!ob)
	  {
	  
	    	   this_object()->move("/obj/void");
	    	 destruct(this_object());
	    	  
	    	  return;	
	  	
	}
	if(environment(ob)->query("short")!= "第五重天入口处")
	{
		 this_object()->move("/obj/void");
	    	 destruct(this_object());
		return;	
		
	}
  if(!ob->query_temp("9sky/start"))
    	{
    	 
    	  
    	   this_object()->move("/obj/void");
	    	 destruct(this_object());
    	  
    	  return;
    	}

  if(faint && ob) {
      if(faint!=ob->query("id"))
      		{
      		    this_object()->move("/obj/void");
	    	 destruct(this_object());
      		   
      		      return;
      		}
      	}
      if(!last) last=ob;
 	 else if(last!=ob)
  	{ this_object()->move("/obj/void");
	    	 destruct(this_object());return;}

        if((ob&&ob->query("9sky/si")=="done") && (ob&&ob->query("9sky/wu")!="done"))
        {
        ob->start_busy(3);
        message("chat",HIY+"【九重天】天极(Tian ji):"+ob->name()+
        "闯过了五重·千紫天\n"NOR,users());
        ob->set("9sky/wu","done");
        ob->add("9sky/number",1);
         ob->add("daoxing", 55000);
         ob->add("int",1);
           ob->save();
         tell_object(ob,"你赢得了五十五年道行,你的悟性增加了一点！");

        }
       this_object()->move("/obj/void");
	    	 destruct(this_object());
}
 varargs int receive_damage(string type, int damage, mixed who, string d_type) 
{ 
      if(who&&objectp(who))
      {
      	if(random(who->query_int()) < 15||random(who->query_int()) > 35)
      	{
      		tell_object(who,msg[random(sizeof(msg))]);
      		damage = damage/3;
      	}
      }
        return ::receive_damage(type,damage,who,d_type); 
     
 } 
varargs int receive_wound(string type, int damage, mixed who, string d_type) 
 { 
        
      if(who&&objectp(who))
      {
      if(random(who->query_int()) < 15||random(who->query_int()) > 35)
      	{
      		damage = damage/3;
      	}	
      }
       return ::receive_wound(type,damage,who,d_type); 
   
} 

