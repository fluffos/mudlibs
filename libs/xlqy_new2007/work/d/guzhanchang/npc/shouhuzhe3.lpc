#include <ansi.h>;
inherit NPC;
#include "star.h"

string *msg = ({
  HIW "灵性是人精神层面的能力，能感悟到更多的讯息。\n" NOR,
  HIR "高度的灵性常常意味著更多知识以及高深的法力。\n" NOR,
  HIC "然而灵性越高，对宇宙苍生了解太透彻，往往是自寻烦恼。\n" NOR,
  HIY "所以灵性虽好，若为此心念嘈杂贪多而不精反而不美。\n" NOR,
});

void create() {
  set_name("达摩祖师", ({ "shouhuzhe", "shouhu zhe", "zhe" }));
  set("gender", "男性");
  set("long",
    "守护第三重天的守护者----万佛之子 达摩祖师\n"
  );
  set("str", 20);
  set("per", 130);
  set("age", 86);
  set("cor", 30);
  set("cps", 40);
  set("kar", 40);
  set("family/family_name", "南海普陀山");

  set("int", 40);
  set("con", 40);
  set("spi", 100);
  set("title", "守护者");
  set("combat_exp", 9400000);
  set("daoxing", 9400000);
  set("max_sen", 12000);
  set("max_kee", 12000);
  set("force", 12000);
  set("max_force", 6000);
  set("force_factor", 300);
  set("max_mana", 6000);
  set("mana", 12000);
  set("mana_factor", 300);
  set("class", "bonze");
  set("no_arrest", 1);
  set_skill("literate", 400);
  set_skill("spells", 400);
  set_skill("buddhism", 400);
  set_skill("unarmed", 400);
  set_skill("jienan-zhi", 400);
  set_skill("dodge", 400);
  set_skill("lotusmove", 400);
  set_skill("parry", 400);
  set_skill("force", 400);
  set_skill("lotusforce", 400);
  set_skill("staff", 400);
  set_skill("lunhui-zhang", 400);
  map_skill("spells", "buddhism");
  map_skill("unarmed", "jienan-zhi");
  map_skill("dodge", "lotusmove");
  map_skill("force", "lotusforce");
  map_skill("parry", "lunhui-zhang");
  map_skill("staff", "lunhui-zhang");

  set("skill_level/staff", "grandmaster");
  set("skill_level/dodge", "master");
  set_temp("apply/parry_block_attack", 6000);
  set_temp("apply/damage", 360);
  set_temp("apply/armor", 640);
  set("chat_chance_combat", 80);
  set("chat_msg_combat", ({
    (: cast_spell, "bighammer" :),
    (: cast_spell, "yinshen" :),
    (: perform_action, "staff", "pudu" :),
    (: perform_action, "staff", "diyu" :),
    (: perform_action, "unarmed", "strom" :),
  }));

  setup();
  carry_object("/d/npc/obj/staff")->wield();
  carry_object("/d/npc/obj/armor")->wear();
}


void init() {
  object ob;
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
  add_action("do_none", "ji");
  add_action("do_cast", "cast");
  add_action("do_perform", "perform");

  add_action("do_none", "hun");
}
void greeting(object who) {
  if (who->query_temp("9sky/start"))
    tell_object(who, HIM "达摩祖师一亮手中法杖，言道：让老夫来考较考较你的灵性。\n" NOR);
}
int do_none() {
  object me = this_object();
  message_vision("此乃天界，岂容你乱来？\n", me);
  return 1;
}

int do_cast(string arg) {

  string cast_id, cast_name;
  object who = this_player();

  if (!arg) return 0;

  if (sscanf(arg, "%s", cast_id) == 1)
    if (cast_id == "chuqiao" || cast_id == "jieti" || cast_id == "jiushen") {
      message_vision("此乃天界，岂容你乱来？\n", who);
      return 1;
    } else if (sscanf(arg, "%s on %s", cast_id, cast_name) == 2)

      if (cast_id == "chuqiao" || cast_id == "jieti" || arg == "jieti" || cast_id == "jiushen" || arg == "jiushen") {
        message_vision("此乃天界，岂容你乱来？\n", who);
        return 1;
      }


}
int do_perform(string arg) {

  string cast_id, cast_name;
  object who = this_player();

  if (!arg) return 0;

  if (sscanf(arg, "%s on %s", cast_id, cast_name) == 2) {

    if (cast_id == "fall" || cast_id == "huadie" || cast_id == "huifeng") {
      message_vision("此乃天界，岂容你乱来？\n", who);
      return 1;

    }
  } else if (sscanf(arg, "%s", cast_id) == 1) {
    if (cast_id == "fall" || cast_id == "huadie" || cast_id == "huifeng") {
      message_vision("此乃天界，岂容你乱来？\n", who);
      return 1;

    } else return 0;

  } else return 0;


}


void die() {

  object ob = query_temp("last_damage_from");
  object killer = query_temp("my_killer");
  object last = query_temp("last_killed_by");
  string faint = query_temp("last_fainted_from");
  if (!ob) {

    this_object()->move("/obj/void");
    destruct(this_object());

    return;

  }
  if (environment(ob)->query("short") != "第三重天入口处") {
    this_object()->move("/obj/void");
    destruct(this_object());
    return;

  }
  if (!ob->query_temp("9sky/start")) {


    this_object()->move("/obj/void");
    destruct(this_object());

    return;
  }

  if (faint && ob) {
    if (faint != ob->query("id")) {
      this_object()->move("/obj/void");
      destruct(this_object());

      return;
    }
  }
  if (!last) last = ob;
  else if (last != ob) {
    this_object()->move("/obj/void");
    destruct(this_object()); return;
  }

  if ((ob && ob->query("9sky/er") == "done") && (ob && ob->query("9sky/san") != "done")) {
    ob->start_busy(3);
    message("chat", HIY + "【九重天】天极(Tian ji):" + ob->name() +
      "闯过了三重·普渡天\n" NOR, users());
    ob->set("9sky/san", "done");
    ob->add("9sky/number", 1);
    ob->add("daoxing", 33000);
    ob->add("spi", 1);
    ob->save();
    tell_object(ob, "你赢得了三十三年道行，你的灵性增加了一点！");

  }
  this_object()->move("/obj/void");
  destruct(this_object());
}
varargs int receive_damage(string type, int damage, mixed who, string d_type) {
  if (who && objectp(who)) {
    if (random(who->query_spi()) < 15 || random(who->query_spi()) > 35) {
      tell_object(who, msg[random(sizeof(msg))]);
      damage = damage / 2;
    }
  }
  return ::receive_damage(type, damage, who, d_type);

}
varargs int receive_wound(string type, int damage, mixed who, string d_type) {

  if (who && objectp(who)) {
    if (random(who->query_spi()) < 15 || random(who->query_spi()) > 35) {
      damage = damage / 2;
    }
  }
  return ::receive_wound(type, damage, who, d_type);

}
