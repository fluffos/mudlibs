// by happ@YSZZ

#include <ansi.h>;
inherit NPC;
#include "star.h"
string *msg = ({
  HIW "定力好的人据说剑尖到眼皮都可以不眨。\n" NOR,
  HIR "有云，泰山崩于前色不变。\n" NOR,
  HIC "定力越高就越有益于处理危机事件，所谓临危不乱是也。\n" NOR,
  HIY "然而定力太高而近乎铁石者，是好还是不好呢。\n" NOR,
});
int do_jianqi();
void create() {
  set_name("独孤剑圣", ({ "shouhuzhe", "shouhu zhe", "zhe" }));
  set("gender", "男性");
  set("long",
    "守护第二重天的守护者----蜀山剑祖独孤剑圣\n"
  );
  set("str", 20);
  set("per", 130);
  set("age", 86);
  set("cor", 30);
  set("family/family_name", "蜀山剑派");

  set("cps", 100);
  set("kar", 40);
  set("int", 40);
  set("con", 40);
  set("spi", 40);
  set("title", "守护者");
  set("combat_exp", 9200000);
  set("daoxing", 9200000);
  set("max_sen", 12000);
  set("max_kee", 12000);
  set("force", 12000);
  set("max_force", 6000);
  set("force_factor", 300);
  set("max_mana", 6000);
  set("mana", 12000);
  set("mana_factor", 300);
  set("class", "swordsman");
  set("no_arrest", 1);
  set_skill("spells", 400);
  set_skill("force", 400);
  set_skill("dodge", 400);
  set_skill("parry", 400);
  set_skill("sword", 400);
  set_skill("zixia-shengong", 400);
  set_skill("sevensteps", 400);
  set_skill("hunyuan-zhang", 400);
  set_skill("literate", 400);
  set_skill("unarmed", 400);
  set_skill("mindsword", 400);
  set_skill("shushan-jianfa", 400);
  set_skill("taoism", 400);
  map_skill("spells", "taoism");
  map_skill("dodge", "sevensteps");
  map_skill("force", "zixia-shengong");
  map_skill("parry", "mindsword");
  map_skill("sword", "mindsword");
  map_skill("unarmed", "hunyuan-zhang");

  set("skill_level/sword", "grandmaster");
  set("shushan/duanshui_master", 1);
  set_temp("apply/damage", 360);
  set_temp("apply/armor", 640);


  set("chat_chance_combat", 75);

  set("chat_msg_combat", ({
    (: perform_action, "sword", "fenguang" :),
    (: perform_action, "sword", "jianqi" :),
    (: cast_spell, "fu" :),
    (: perform_action, "unarmed", "sword" :),
    (: do_jianqi :),
  }));
  setup();
  set_temp("apply/force_vs_damage", 6000);
  set_temp("apply/combat_blood_mana", 6000);
  carry_object("/d/npc/obj/sword")->wield();
  carry_object("/d/npc/obj/armor")->wear();
}
int do_jianqi() {

  object me = this_object();
  me->command("perform jianqi");
  me->command("enable sword shushan-jianfa");
  me->command("perform duanshui");
  me->command("enable sword mindsword");
  return 1;

}

void init() {
  object ob;
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }

  add_action("do_none", "ji");
  add_action("do_cast", "cast");
  add_action("do_perform", "perform");

  add_action("do_none", "hun");
}
void greeting(object who) {
  if (who->query_temp("9sky/start"))
    tell_object(who, HIC "独孤剑圣一亮手中剑，言道：让老夫来考较考较你的定力。\n" NOR);
}
int do_none() {
  object me = this_object();
  message_vision("此乃天界，岂容你乱来？\n", me);
  return 1;
}

int do_cast(string arg) {

  string cast_id, cast_name;
  object who = this_player();

  if (!arg) return 0;

  if (sscanf(arg, "%s", cast_id) == 1)
    if (cast_id == "chuqiao" || cast_id == "jieti" || cast_id == "jiushen") {
      message_vision("此乃天界，岂容你乱来？\n", who);
      return 1;
    } else if (sscanf(arg, "%s on %s", cast_id, cast_name) == 2)

      if (cast_id == "jieti" || arg == "jieti" || cast_id == "jiushen" || arg == "jiushen") {
        message_vision("此乃天界，岂容你乱来？\n", who);
        return 1;
      }


}
int do_perform(string arg) {

  string cast_id, cast_name;
  object who = this_player();

  if (!arg) return 0;

  if (sscanf(arg, "%s on %s", cast_id, cast_name) == 2) {

    if (cast_id == "fall" || cast_id == "huadie" || cast_id == "huifeng") {
      message_vision("此乃天界，岂容你乱来？\n", who);
      return 1;

    }
  } else if (sscanf(arg, "%s", cast_id) == 1) {
    if (cast_id == "fall" || cast_id == "huadie" || cast_id == "huifeng") {
      message_vision("此乃天界，岂容你乱来？\n", who);
      return 1;

    } else return 0;

  } else return 0;


}

void die() {

  object ob = query_temp("last_damage_from");
  object killer = query_temp("my_killer");
  object last = query_temp("last_killed_by");
  string faint = query_temp("last_fainted_from");
  if (!ob) {

    this_object()->move("/obj/void");
    destruct(this_object());

    return;

  }
  if (environment(ob)->query("short") != "第二重天入口处") {
    this_object()->move("/obj/void");
    destruct(this_object());
    return;

  }
  if (!ob->query_temp("9sky/start")) {


    this_object()->move("/obj/void");
    destruct(this_object());

    return;
  }

  if (faint && ob) {
    if (faint != ob->query("id")) {
      this_object()->move("/obj/void");
      destruct(this_object());

      return;
    }
  }
  if (!last) last = ob;
  else if (last != ob) {
    this_object()->move("/obj/void");
    destruct(this_object()); return;
  }

  if ((ob && ob->query("9sky/yi") == "done") && (ob && ob->query("9sky/er") != "done")) {
    ob->start_busy(3);
    message("chat", HIY + "【九重天】天极(Tian ji):" + ob->name() +
      "闯过了二重·巴蜀天\n" NOR, users());
    ob->set("9sky/er", "done");
    ob->add("9sky/number", 1);
    ob->add("daoxing", 22000);
    ob->add("cps", 1);
    ob->save();
    tell_object(ob, "你赢得了二十二年道行，你的定力增加了一点！");

  }
  this_object()->move("/obj/void");
  destruct(this_object());
}
varargs int receive_damage(string type, int damage, mixed who, string d_type) {
  if (who && objectp(who)) {
    if (random(who->query_cps()) < 10 || random(who->query_cps()) > 30) {
      tell_object(who, msg[random(sizeof(msg))]);
      damage = damage / 2;
    }
  }
  return ::receive_damage(type, damage, who, d_type);

}
varargs int receive_wound(string type, int damage, mixed who, string d_type) {

  if (who && objectp(who)) {
    if (random(who->query_cps()) < 10 || random(who->query_cps()) > 30) {
      damage = damage / 2;
    }
  }
  return ::receive_wound(type, damage, who, d_type);

}
