#include <ansi.h>;
inherit NPC;
#include "star.h"
string *msg = ({
  HIW "力量力量力量力量力量力量力量力量！\n" NOR,
  HIR "弱肉强食的江湖中，拳头才是硬道理。\n" NOR,
  HIC "纵使你再博爱再勇猛再怎么聪慧，没有过硬的本领如何到达宗师境界。\n" NOR,
  HIY "须牢记，光靠武力是不能解决所有问题。\n" NOR,
});

void create() {
  set_name("鬼见愁", ({ "shouhuzhe", "shouhu zhe", "zhe" }));
  set("gender", "男性");
  set("long",
    "守护第八重天的守护者----幽冥鬼司鬼见愁\n"
  );
  set("str", 20);
  set("per", 130);
  set("age", 86);
  set("cor", 30);
  set("family/family_name", "阎罗地府");

  set("cps", 75);
  set("kar", 100);
  set("int", 40);
  set("con", 40);
  set("spi", 40);
  set("title", "守护者");
  set("combat_exp", 12800000);
  set("daoxing", 12800000);
  set("max_sen", 21000);
  set("max_kee", 21000);
  set("force", 18000);
  set("max_force", 9000);
  set("force_factor", 450);
  set("max_mana", 9000);
  set("mana", 18000);
  set("mana_factor", 450);
  set("class", "youling");
  set("no_arrest", 1);
  set_skill("unarmed", 500);
  set_skill("whip", 500);
  set_skill("hellfire-whip", 500);
  set_skill("dodge", 500);
  set_skill("parry", 500);
  set_skill("literate", 500);
  set_skill("spells", 500);
  set_skill("force", 500);
  set_skill("tonsillit", 500);
  set_skill("ghost-steps", 500);
  set_skill("gouhunshu", 500);
  set_skill("jinghun-zhang", 500);
  set_skill("kusang-bang", 500);
  set_skill("zhuihun-sword", 500);
  set_skill("sword", 500);
  set_skill("stick", 500);

  map_skill("force", "tonsillit");
  map_skill("unarmed", "jinghun-zhang");
  map_skill("dodge", "ghost-steps");
  map_skill("spells", "gouhunshu");
  map_skill("parry", "hellfire-whip");
  map_skill("whip", "hellfire-whip");
  map_skill("sword", "zhuihun-sword");
  map_skill("stick", "kusang-bang");

  set("skill_level/whip", "grandmaster");
  set("skill_level/sword", "master");
  set("skill_level/stick", "master");

  set_temp("apply/sub_max_defense", 6000);
  set_temp("apply/damage", 360);
  set_temp("apply/armor", 640);
  set("chat_chance_combat", 80);
  set("chat_msg_combat", ({
    (: perform_action, "whip", "three" :),
    (: perform_action, "whip", "lunhui" :),
    (: perform_action, "whip", "ldlh" :),
    (: exert_function, "powerup" :),
    (: cast_spell, "gouhun" :),
  }));

  setup();
  carry_object("/d/npc/obj/whip")->wield();
  carry_object("/d/npc/obj/armor")->wear();
}

void init() {
  object ob;
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
  add_action("do_none", "ji");
  add_action("do_cast", "cast");
  add_action("do_perform", "perform");

  add_action("do_none", "hun");
}
void greeting(object who) {
  if (who->query_temp("9sky/start"))
    tell_object(who, HIB "鬼见愁一亮手中长鞭，言道：让老夫来考较考较你的力量。\n" NOR);
}
int do_none() {
  object me = this_object();
  message_vision("此乃天界，岂容你乱来？\n", me);
  return 1;
}

int do_cast(string arg) {

  string cast_id, cast_name;
  object who = this_player();

  if (!arg) return 0;

  if (sscanf(arg, "%s", cast_id) == 1)
    if (cast_id == "chuqiao" || cast_id == "jieti" || cast_id == "jiushen") {
      message_vision("此乃天界，岂容你乱来？\n", who);
      return 1;
    } else if (sscanf(arg, "%s on %s", cast_id, cast_name) == 2)

      if (cast_id == "jieti" || arg == "jieti" || cast_id == "jiushen" || arg == "jiushen") {
        message_vision("此乃天界，岂容你乱来？\n", who);
        return 1;
      }


}
int do_perform(string arg) {

  string cast_id, cast_name;
  object who = this_player();

  if (!arg) return 0;

  if (sscanf(arg, "%s on %s", cast_id, cast_name) == 2) {

    if (cast_id == "fall" || cast_id == "huadie" || cast_id == "huifeng") {
      message_vision("此乃天界，岂容你乱来？\n", who);
      return 1;

    }
  } else if (sscanf(arg, "%s", cast_id) == 1) {
    if (cast_id == "fall" || cast_id == "huadie" || cast_id == "huifeng") {
      message_vision("此乃天界，岂容你乱来？\n", who);
      return 1;

    } else return 0;

  } else return 0;


}

void die() {


  object ob = query_temp("last_damage_from");
  object killer = query_temp("my_killer");
  object last = query_temp("last_killed_by");
  string faint = query_temp("last_fainted_from");
  if (!ob) {

    this_object()->move("/obj/void");
    destruct(this_object());

    return;

  }
  if (environment(ob)->query("short") != "第八重天入口处") {
    this_object()->move("/obj/void");
    destruct(this_object());
    return;

  }
  if (!ob->query_temp("9sky/start")) {


    this_object()->move("/obj/void");
    destruct(this_object());

    return;
  }

  if (faint && ob) {
    if (faint != ob->query("id")) {
      this_object()->move("/obj/void");
      destruct(this_object());

      return;
    }
  }
  if (!last) last = ob;
  else if (last != ob) {
    this_object()->move("/obj/void");
    destruct(this_object()); return;
  }

  if ((ob && ob->query("9sky/qi") == "done") && (ob && ob->query("9sky/ba") != "done")) {
    ob->start_busy(3);
    message("chat", HIY + "【九重天】天极(Tian ji):" + ob->name() +
      "闯过了八重·月影天\n" NOR, users());
    ob->set("9sky/ba", "done");
    ob->add("9sky/number", 1);
    ob->add("daoxing", 88000);
    ob->add("wuxing_sub/max_all", 800);
    ob->save();
    tell_object(ob, "你赢得了八十八年道行，你的五行防御永久增加了8％！");

  }
  this_object()->move("/obj/void");
  destruct(this_object());
}


varargs int receive_damage(string type, int damage, mixed who, string d_type) {
  if (who && objectp(who)) {
    if (random(who->query("str")) < 10 || random(who->query("str")) > 30) {
      tell_object(who, msg[random(sizeof(msg))]);
      damage = damage / 4;
    }
  }
  return ::receive_damage(type, damage, who, d_type);

}
varargs int receive_wound(string type, int damage, mixed who, string d_type) {

  if (who && objectp(who)) {
    if (random(who->query("str")) < 10 || random(who->query("str")) > 30) {
      damage = damage / 4;
    }
  }
  return ::receive_wound(type, damage, who, d_type);

}
