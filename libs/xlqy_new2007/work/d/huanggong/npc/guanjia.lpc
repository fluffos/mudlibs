// asdf 2003.08.20

#include <ansi.h>

inherit NPC;

void create()
{

    	set_name("张满福", ({"zhang manfu","zhang","guanjia","manfu"}));
    	set("long","张管家跟随萧总镖头有很多年了，可谓是忠心耿耿。\n");
    	set("gender", "男性");
    	set("title","管家");
   	set("str", 25);
        set("age", 40+random(10));
        set("attitude", "peaceful");
        set("combat_exp", 40000);
	set("daoxing",40000);	
        set_skill("unarmed", 40);
        set_skill("dodge", 50);
        set_skill("parry", 40);
	set("max_kee", 500);
	set("max_sen", 400);
	set("max_force", 200);
	set("force", 200);
	set("force_factor", 10);
	set("mana_facotr", 5);
	set("max_mana", 30);
	set("mana", 30);
	set("收信",0);
        setup();
        carry_object("/d/obj/cloth/magua")->wear();
        
        setup();
}
void init()
{
	
}
int accept_fight(object me)
{
	command("say 萧总镖头不许我们和外人动手\n");
	return 0;
}
void relay_emote(object ob,string verb)
{
	if( ob->query("name")!="刘二牛" ) return;
        switch(verb) {
        case "grin":
                        command("and");
                break;
        case "beg":
			command("poor liu");
		break;
        }
}
int accept_object(object who,object ob)
{
	string respect=RANK_D->query_respect(who);
	if(ob->query("id")!="letter")
	   return 0;
	if(ob->query("name") == "萧萧的手信" ) {
	if(query("收信")) {
 	       message_vision(HIY"张管家“嗯？”了一声，“怎么萧大小姐又请来一个帮手，难道是假冒的不成？“\n",this_object());
	        return 0;
	}       
	if(ob->query_temp("送信人")==who)
	{
		who->set_temp("baobiao/送信",1);
	    	message_vision(HIY "张管家“哦”了一声，向$N点了点头，道：这位"+respect+"可愿随我去见总镖头？(answer yes/no)\n"NOR,this_player()); 
	        add_action("do_answer","answer");
	        set("收信",1);
	        return 1;
	}
	else
	{
	   	say(HIR"张管家眉头一皱，说道：这封信你从何而得？\n"NOR);
	        return 1;
	}
	}
	return 0;
}
void reset()
{
        if(query("收信")) {
                add("收信",1);
                if (query("收信")>8) set("收信",0);
        }
}      
int do_answer(string arg)
{
    object ob, me;
    
    ob=this_object();
    me = this_player();
     if(!me->query_temp("baobiao/送信"))
       return 0;
    if(objectp(ob))
    if(living(ob))
   
    if( arg == "yes" )
    {
        message_vision(YEL "张管家说道，请随我来。\n"NOR, this_player());
        if(!find_object("/d/baobiao/hall"))
             load_object("/d/baobiao/hall");
        me->move("/d/baobiao/hall");
        ob->move("/d/baobiao/hall");
        message_vision(HIC "$N和张管家走了过来。\n"NOR,me);
        remove_action("do_answer","answer");
        return 1;
    }
    else if( arg == "no" )
    {
    	message_vision("$N说道："+RANK_D->query_self(me)+"尚有要事在身，容后再登门拜访萧总镖头。\n",me);
        message_vision("张管家叹了口气，说道：那好吧，这位"+RANK_D->query_respect(me)+"请自便。\n"NOR, this_player());
        remove_action("do_answer","answer");
        return 1;
    }
    
    return 0;
}
void destruct_me (object ob)
{
  destruct (ob);
}