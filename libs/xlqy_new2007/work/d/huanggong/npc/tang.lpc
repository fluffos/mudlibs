#include "ansi.h"

inherit NPC; 
int reset_status();
void leave();
void set_skills(int level,int value,object who);
void create()
{
    object ob;
    set_name("趟子手", ({ "tang","tangzishou" }) );
    set("gender", "男性" );
    set("age", 25);
    set("combat_exp", 50000);
    set_skill("blade", 40);
    set_skill("hammer", 40);
    set_skill("sword", 40);
    set_skill("fork", 40);
    set_skill("dodge", 60);
    set_skill("spear", 40);
    set_skill("stick", 40);
    set_skill("unarmed", 40);
    set_skill("staff", 40);
    set_skill("axe", 40);
    set("arrive",0);
    set("force", 300);
    set("max_force", 200);
    set("force_factor", 10);
    set("attitude", "friendly");
    set("chat_chance", 1);
    set("chat_msg",({
    		"趟子手说：“唉，整天过这刀头上舔血的日子。“\n",
                "趟子手说：“这几天路上不太平，千万不要出事才好。“\n",
        }));        
    setup();
    carry_object(__DIR__"obj/cloth")->wear();
    switch(random(9))
    	{
    		case 0:
    		 carry_object("/d/obj/weapon/blade/blade")->wield();
    		 break;
    		 case 1:
    		 carry_object("/d/obj/weapon/fork/gangcha")->wield();
    		 break;
    		 case 2:
    		 carry_object("/d/obj/weapon/hammer/hammer")->wield();
    		 break;
    		 case 3:
    		 carry_object("/d/obj/weapon/sword/changjian")->wield();
    		 break;
    		 case 4:
    		 carry_object("/d/obj/weapon/spear/changqiang")->wield();
    		 break;
    		 case 5:
    		 carry_object("/d/obj/weapon/staff/tiezhang")->wield();
    		 break;
    		 case 6:
    		 carry_object("/d/obj/weapon/stick/bintiegun")->wield();
    		 break;
    		 case 7:
    		 carry_object("/d/obj/weapon/axe/bigaxe")->wield();
    		 break;
}  
}
void init()
{    
	
	
	
}
void invocation(object who,int level)
{
	int value=who->query("hubiao/value");
       remove_call_out("leave");
	call_out("leave",600);	
        set("owner", who);
        
        set_skills(level,value,who);
        reset_status();
        return;
}
int reset_status()
{
        object owner,env;
        int n;
        object *inv,robber;
        owner= query("owner");
	
        if(!query("owner"))
        {
                message_vision("$N撒腿就跑。\n", this_object());
                destruct( this_object());
                return 1;
        }
	inv=all_inventory(environment());
      
        if(!present(owner,environment(this_object())))
     
  	{  
  		 robber=present("robber",environment(this_object()));
  		if(robber)
  		{
  		 
		return 1;
		}
	
	}	
        if(!present(owner->query("id"), environment(this_object())))
            {
             env=environment(owner);
             this_object()->move(env);
            
            }
            
        call_out("reset_status", 3);
        return 1;
}
void set_skills(int level, int value,object who)
{
int *levels, max_level;
	int dx,exp;
	int kee,sen;
	 mapping skill=who->query_skills();
         int i=sizeof(skill);
         if(i>0) 
         {
		levels=values(skill);
		max_level=levels[0];
		while(i--)
		 { // find out victim's maximum level
		    if(levels[i]>max_level)
			max_level=levels[i];
		}
	        max_level=(max_level*0.4);
		max_level=(int)max_level;
	    } else max_level=1;
	exp=who->query("combat_exp")*0.5+random(who->query("combat_exp")*0.2);
	dx=who->query("daoxing")*0.5;
	kee=800*(level+1)+random(120*value);
	sen=600*(level+1)+random(100*value);
	
       set("kee",kee);
        set("max_kee",kee);
         set("eff_kee",kee);
        set("sen",sen);
        set("max_sen",sen);
        set("eff_sen",sen);
        set("combat_exp",exp);
        set("daoxing",dx);
	set_skill("blade",max_level+5*value+random(10*level));
	set_skill("hammer", max_level+5*value+random(10*level));
	set_skill("sword", max_level+5*value+random(10*level));
	set_skill("fork", max_level+5*value+random(10*level));
	set_skill("dodge", max_level+7*value+random(12*level));
	set_skill("spear", max_level+5*value+random(10*level));
	set_skill("stick", max_level+5*value+random(10*level));
	set_skill("parry", max_level+5*value+random(10*level));
	set_skill("unarmed", max_level+7*value+random(12*level));
	set_skill("staff", max_level+5*value+random(10*level));
	set_skill("axe", max_level+5*value+random(10*level));
	set_skill("force",max_level+3*value+random(5*level));
		
	set("force", 200+400*level+100*value);
	set("max_force", 100+300*level+100*value);
	set("force_factor", 12*(level+1)+value*10);
		    
}
void die()
{
	message_vision("$N一溜烟跑得没影了。\n",this_object());
	destruct(this_object());
	
}
void unconcious()
{
	message_vision("$N一溜烟跑得没影了。\n",this_object());
	destruct(this_object());
	
}
void leave()
{
        object me=this_object();
        if(me->is_fighting() || me->is_busy())
        return;
          if(this_object())
           {
	        if(environment())
		{
	          message("vision",HIB + name() + 
	                  "不知所踪。\n" NOR,environment());
		}
        destruct(this_object());
        return;
      }
        remove_call_out("leave");
        call_out("leave",60);
        leave();
}
