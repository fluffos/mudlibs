// flying @ 缥缈水云间


inherit NPC;

void create()
{
  set_name("月宫弟子",({"moonfighter","fighter"}));
  set("gender", "女性");
  set("title", "月宫");
  set("age", 30);
  set("long", "    \n百花仙子座下的一名弟子。\n");

  set("attitude", "peaceful");
  set("class", "moon");
  set("combat_exp", 500000);
  set("daoxing", 500000);
  set("kee", 3000);
  set("max_kee", 3000);
  set("sen", 3000);
  set("max_sen", 3000);
  set("force", 2500);
  set("max_force", 2500);
  set("mana", 2500);
  set("max_mana", 2500);
  set("force_factor", 0);
  set("mana_factor", 100);
  set("str", 30);
  set("family/family_name","月宫");

  set_skill("spells", 130);
  set_skill("moonshentong", 130);
  set_skill("force", 130);
  set_skill("moonforce", 150);
  set_skill("sword", 130);
  set_skill("snowsword", 150);
  set_skill("dodge", 130);
  set_skill("parry", 130);
  set_skill("moondance", 150);

map_skill("spells", "moonshentong");
map_skill("force", "moonforce");
map_skill("sword", "snowsword");
map_skill("parry", "snowsword");
map_skill("dodge", "moondance");
  set("inquiry", ([
]));
  set("chat_chance_combat", 90);
        set("chat_msg_combat", ({
                (: cast_spell, "mihun" :),
                (: cast_spell, "arrow" :),
                (: perform_action, "sword", "wuxue" :),
                (: perform_action, "sword", "tian" :),
        }) );



setup();

carry_object("/d/obj/cloth/luoyi")->wear();
carry_object("/d/obj/armor/jinjia")->wear();
carry_object("/d/ourhome/obj/shoes")->wear();
carry_object("/d/obj/weapon/sword/snow_sword")->wield();

}


int accept_fight(object who)
{
  object me=this_object();
  who=this_player();

  

  if(who->query("startfight")==1)
     {
      message_vision("月宫弟子对$N一抱拳：龙形搏击号称天下第一空手武功,倒想领教领教!\n", who);
      me->set("kee", 3000);
      me->set("max_kee", 3000);
      me->set("sen", 3000);
      me->set("max_sen", 3000);
      me->set("force", 2500);
      me->set("max_force", 2500);
      me->set("mana", 2500);
      me->set("max_mana", 2500);
      me->fight_ob(who);
      who->fight_ob(me);
      remove_call_out("check_result");
      call_out("check_result", 1, me, who);  
      return 1;
     }
  else
    {
     message_vision("月宫弟子对$N哼了一声：你还不配和我交手。\n", who);
     return 0;
    }
}

int check_result(object me, object who)
{
  int my_max_kee, his_max_kee;
  
  if (! who)  return 1;
  if (environment(who)!=environment(me))  return 1;
  my_max_kee  = me->query("max_kee");
  his_max_kee = who->query("max_kee");

  if (me->is_fighting())
  {
    call_out("check_result",1, me, who);
    return 1;
  }


  if (((int)me->query("kee")*100/(1+my_max_kee)) <= 30 )
  {
   message_vision ("$N说道：龙宫绝学果然有神鬼莫测之能,在下认输了！\n",me);
   who->set("startfight",0);
   who->set("fightwin",1);
   message_vision ("$N淡淡道: 承让！\n",who);
   me->command("sigh");
   message_vision ("$N垂头丧气地离开了。\n",me);
   destruct(me);
   return 1;
  }

  if (( (int)who->query("kee")*100/his_max_kee)<=30)
  {
    message_vision ("$N对$n摇头道：龙宫武学也不过如此！\n",me,who);
    message_vision ("$N不屑的冷哼一声，转身离开了。\n",me);
    who->command("loser");
    who->set("startfight",0);
    destruct(me);
    return 1;
  }


  return 1;  
}



