// flying @ 缥缈水云间
#include <skill.h>
#include <ansi.h>
inherit NPC;
int teach_qunliao();

void create() {
  set_name("幻儿", ({ "huaner" }));
  set("gender", "女性");
  set("title", "");
  set("age", 17);
  set("long", "幻儿正全神贯注地吹着竹箫，双足浸在水里,一晃一晃的。\n");

  set("attitude", "peaceful");
  set("class", "moon");
  set("combat_exp", 70000000);
  set("daoxing", 70000000);
  set("kee", 70000);
  set("max_kee", 70000);
  set("sen", 70000);
  set("max_sen", 70000);
  set("force", 60000);
  set("max_force", 30000);
  set("mana", 60000);
  set("max_mana", 30000);
  set("force_factor", 0);
  set("mana_factor", 300);
  set("str", 100);
  set("per", 30);
  set("family/family_name", "月宫");

  set_skill("spells", 500);
  set_skill("moonshentong", 500);
  set_skill("force", 500);
  set_skill("moonforce", 500);
  set_skill("sword", 500);
  set_skill("snowsword", 500);
  set_skill("dodge", 500);
  set_skill("parry", 500);
  set_skill("moondance", 500);

  map_skill("spells", "moonshentong");
  map_skill("force", "moonforce");
  map_skill("sword", "snowsword");
  map_skill("parry", "snowsword");
  map_skill("dodge", "moondance");
  set("inquiry", ([

    "无极渡元": (: teach_qunliao :),
    "虽千万人吾往矣": "嗯，这个我可不会，你问我丈夫紫风吧！",
    "五气朝元": (: teach_qunliao :),
  ]));
  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: cast_spell, "mihun" :),
    (: cast_spell, "arrow" :),
    (: perform_action, "sword", "wuxue" :),
    (: perform_action, "sword", "tian" :),
  }));



  setup();

  carry_object("/d/obj/cloth/luoyi")->wear();
  carry_object("/d/ourhome/obj/shoes")->wear();


}

int teach_qunliao() {
  object me = this_player();
  string msg;
  command("wanfu");
  if (this_player()->query("family/family_name") == "南海普陀山" || this_player()->query("family/family_name") == "蜀山剑派") {
    if (me->query("emei/qunliao") == 1)
      message_vision("幻儿奇怪地说道:你不是学会了吗?\n", me);
    else {
      message_vision("幻儿美目流转，对你微微一笑！\n", me);
      command("say 我现在把这门心法教授给你，希望你将它用于正途。");
      me->set("emei/qunliao", 1);
      msg = HIM + me->name() + "学会了" NOR + HIC "「群疗术」。";
      message("channel:chat", HIM "【紫幻小筑】幻儿：" + msg + "\n" NOR, users());
    }
  } else {
    command("shake");
    command("say 非普陀和蜀山的弟子恐怕难以学会。");
  }
  return 1;
}
