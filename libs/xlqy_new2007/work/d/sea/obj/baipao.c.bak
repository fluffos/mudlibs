#include <armor.h>
#include <ansi.h>
inherit CLOTH;

void create()
{
        set_name(HIY"白袍"NOR, ({ "baipao"}));
        set_weight(300);
        if( clonep() )
                set_default_object(__FILE__);
        else {
		set("long", "幻儿用粗布做的白袍．\n");
                set("unit", "袭");
                set("value", 300000);
                set("no_give",1);
                set("no_sell",1);
                set("no_put",1);
                set("material", "cloth");
                set("armor_prop/armor", 100);
                set("armor_prop/dodge", 20 );
        }
        setup();
}


