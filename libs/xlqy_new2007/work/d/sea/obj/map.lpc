//flying
// /d/sea/obj/map

#include <ansi.h>
inherit ITEM;

void create()
{
        set_name(HIY"写有字的纸"NOR, ({ "paper", "map", "纸"}) );
        set_weight(50);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "张");
                set("long", "一张写有字的纸，上面的字迹有点模糊，你隐约可辨
             定海珠  几个字，
             旁边还有一行小字，写着:背阴巷民居。
\n");
                
        }
}

