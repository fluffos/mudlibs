#include <weapon.h>
#include <ansi.h>
inherit F_UNIQUE;

inherit SWORD;

void create()
{
	set_name(HIG"竹箫"NOR, ({"zhu xiao","xiao"}) );
	set_weight(1000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "只");
		set("material", "bamboo");
		set("long", "幻儿用谷底的竹子自制的竹箫。\n");
                set("no_sell", 1);
                set("no_drop", 1);
                set("no_put", 1);
                set("value", 300000);
                set("replace_file", "/d/obj/weapon/sword/yudi");
		set("wield_msg", "$N拿起$n，不禁想起了许多曾经的往事。\n");
		set("unwield_msg", "$N长叹一声，将$n插回腰间。\n");
       	        set("music/type", "xiao");
	}
	init_sword(200);
	setup();
}

