# include <skill.h>
#include <ansi.h>

inherit ITEM;

void create() {
  set_name(HIC "定海珠" NOR, ({ "dinghaizhu", "zhu" }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("no_sell", 1);
    //set("no_give",1);
    set("no_put", 1);
    set("no_get", 1);
    set("value", 0);
    set("unit", "颗");
    set("long",
      "一颗斗大圆润的珍珠，好像没有什么特异之处，似乎可以触摸(touch)。\n");
  }
  set("is_monitored", 1);
  setup();

}



int do_study(string arg) {
  object me, pearl;
  int i;
  me = this_player();

  if (!arg || (arg != "dinghaizhu"
    && arg != "zhu"
  ))
    return notify_fail("你要摸什么？\n");

  if ((int)me->query_skill("force", 1) < 50)
    return notify_fail("你什么都感觉不到。\n");
  if ((int)me->query("kee") < 50)
    return notify_fail("你的气血不足，可能会晕倒过去。\n");
  if ((int)me->query("sen") < 50)
    return notify_fail("你的精神不济，可能会昏迷过去。\n");
  if ((int)me->query("force") < 50)
    return notify_fail("你的内力不足，什么感觉都没有。\n");

  if (!me->query("lg/wuxing")) {
    message_vision("$N双手轻握$n，突然感觉体内真气蠢蠢欲动，纷纷向一些不知名的奇经八脉涌去。\n", me, this_object());
    message_vision("一时间身体像要炸开一般。过了一会儿，$N感觉体内真气渐趋稳定，并呈螺旋状流动，心中忽然一动。\n", me, this_object());
    me->receive_damage("kee", 100);
    me->receive_damage("sen", 100);
    me->add("max_force", 100);
    me->set("lg/wuxing", 1);

    write("你对龙神心法的领悟进入了另一个境界。\n");
  } else
    return notify_fail("你什么都感觉不到。\n");
  return 1;
}

void destruct_me(object where, object me) {
  message_vision("$n慢慢地随风飘去……\n", where, me);
  destruct(me);
}

void init() {
  object me = this_object();
  object where = environment();
  add_action("do_study", "touch");

  if (interactive(where)) {
    if (me->query("owned")) {
      if (me->query("owned") != where->query("id")) {
        call_out("destruct_me", 1, where, me);
      }
    } else {
      me->set("owned", where->query("id"));
    }
  }
}
