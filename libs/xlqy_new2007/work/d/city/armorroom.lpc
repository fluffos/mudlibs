// 盔甲库
#define MAX_SIZE_WEAPON 10
inherit ROOM;
#include <ansi.h>

string check_blank_slot(object me);
void create()
{
        set ("short",  HIW "盔甲装备库" NOR );
         set ("long", @LONG

这里是大唐的盔甲装备库，墙上(wall)挂满了各式各样的盔甲战衣。

LONG);  
        set("exits", 
        ([ //sizeof() == 1
                "west" : __DIR__"droproom",
        ]));
	set("no_fight",1);
	set("no_magic",1);
	set("no_clean_up", 0);
        setup();
}

void init()
{
        add_action("do_pick", "pick");
        add_action("do_put",  "put");
        add_action("do_rename","rename");
        add_action("do_look","look");

}

int do_look(string arg)
{
	object  me;
        mapping diablo,obj;
        string  msg,name,*slot;
        int     i;
        me = this_player();
	if(!arg)
		return 0;
	if(arg!="wall")
		return 0;
	
        
	if(!mapp(diablo=me->query("diablo_armor_slot")))
		  {
		  	tell_object(me,"你的盔甲库里空空荡荡，用"+HIY"put <物品id> "NOR+"将盔甲放入其中！\n");
		  	return 1;
		}
	if(!me->query("diablo_armor_number"))
		  {
		  	tell_object(me,"你的盔甲库里空空荡荡，用"+HIY"put <物品id> "NOR+"将盔甲放入其中！\n");
		  	return 1;
		}
	if(sizeof(diablo)!=me->query("diablo_armor_number"))
	{
		 tell_object(me,HIR "\n你的盔甲库遭劫了，请和巫师联系。\n" NOR);
		return 1;
	}
        
       if(!sizeof(diablo)) 
	 {
		  	tell_object(me,"你的盔甲库里空空荡荡，用"+HIY"put <物品id> "NOR+"将盔甲放入其中！\n");
		  	return 1;
	}
        slot = keys(diablo);    
	
        msg = CYN"\n★★★★★★★★★★"HIW"大"MAG"·"HIM"唐"MAG"·"HIC"盔"MAG"·"HIR"甲"MAG"·"HIB"装"MAG"·"HIG"备"MAG"·"HIY"库"NOR+CYN"★★★★★★★★★★★\n" NOR;

        for(i = 0; i < sizeof(slot); i++) {
        	
                obj = diablo[slot[i]];
                msg = sprintf("%s" HIG "%3d、" NOR "%50s  %s \n",
                                msg,
                                i+1,
                                " ",
                                obj["name"]);
        }
        msg += CYN"★★★★★★★★★★★★"HIY"X"HIR"·"HIY"L"HIR"·"HIY"Q"HIR"·"HIY"Y"NOR+CYN"★★★★★★★★★★★★★★★★★\n"NOR;
        msg+="\n用"+HIY"put <物品id>"NOR+"将盔甲放入其中，用"+HIC"pick <序号>"NOR+"取出其中的某一盔甲。\n"NOR;     
        msg+=HIY"rename <物品id> <名字>"NOR+"给盔甲取新名字，可以用颜色和闪烁，请勿用不合法的名字！\n\n"NOR; 
      	me->start_more(msg);
      	return 1;


}
int do_rename(string arg)
{
	object  me,ob;
	string item,msg,arg_old;
        me = this_player();
	
        if( !arg ) return notify_fail("你要给什么取个名字？\n");
        if(sscanf(arg,"%s %s",item,msg) != 2)
         return notify_fail("格式为rename <物品id> <名字>。\n");
        if(!(ob=present(item,me)))
        	return notify_fail("你身上没这样东西啊。\n");
        if(!ob->is_diablo_ob())
      	  return notify_fail("不能给这样东西改名！\n");
      	if(ob->query("no_diablo_rename"))
         {
        	 tell_object(me,"这样东西不能更改名字！\n");
                return 1;	
        	
        }   
        
        if(ob->query("diablo_ob_autoloaded"))
         {
        	 tell_object(me,"这样东西不能再更改名字了。\n");
                return 1;	
        	
        }    
        arg_old = msg;
	msg += "$NOR$";
       
        arg_old = replace_string(arg_old, "$BLK$", "");
        arg_old = replace_string(arg_old, "$RED$", "");
        arg_old = replace_string(arg_old, "$GRN$", "");
        arg_old = replace_string(arg_old, "$YEL$", "");
        arg_old = replace_string(arg_old, "$BLU$", "");
        arg_old = replace_string(arg_old, "$MAG$", "");
        arg_old = replace_string(arg_old, "$CYN$", "");
        arg_old = replace_string(arg_old, "$WHT$", "");
        arg_old = replace_string(arg_old, "$HIR$", "");
        arg_old = replace_string(arg_old, "$HIG$", "");
        arg_old = replace_string(arg_old, "$HIY$", "");
        arg_old = replace_string(arg_old, "$HIB$", "");
        arg_old = replace_string(arg_old, "$HIM$", "");
        arg_old = replace_string(arg_old, "$HIC$", "");
        arg_old = replace_string(arg_old, "$HIW$", "");
        arg_old = replace_string(arg_old, "$NOR$", "");
        arg_old = replace_string(arg_old, "$BLINK$","");
      

        msg = replace_string(msg, "$BLK$", BLK);
       	msg = replace_string(msg, "$RED$", RED);
        msg = replace_string(msg, "$GRN$", GRN);
        msg = replace_string(msg, "$YEL$", YEL);
        msg = replace_string(msg, "$BLU$", BLU);
        msg = replace_string(msg, "$MAG$", MAG);
        msg = replace_string(msg, "$CYN$", CYN);
        msg = replace_string(msg, "$WHT$", WHT);
        msg = replace_string(msg, "$HIR$", HIR);
        msg = replace_string(msg, "$HIG$", HIG);
        msg = replace_string(msg, "$HIY$", HIY);
        msg = replace_string(msg, "$HIB$", HIB);
        msg = replace_string(msg, "$HIM$", HIM);
        msg = replace_string(msg, "$HIC$", HIC);
        msg = replace_string(msg, "$HIW$", HIW);
        msg = replace_string(msg, "$NOR$", NOR);
        msg = replace_string(msg, "$BLINK$",BLINK);

        me->add("sen",-10);
        
        if(strlen(msg) > 60)
                return notify_fail("名字也太长了点吧！\n"); 
         ob->set("name",msg);
         ob->set("have_set_name",1);
                write("ＯＫ！\n");
	return 1;
}
int do_pick(string arg)
{
          object  me,ob;
        int   i,num,  index,amount;
        string files,slot;
        mapping diablo_ob,dbase;
        string *list,*prop;

        me = this_player();
	
        if( !arg ) return notify_fail("你要取回哪样物品？\n");
        
        i=atoi(arg);
        if(!i) return notify_fail("你要取回哪样物品？\n");
	if(!mapp(diablo_ob=me->query("diablo_armor_slot")))
		return notify_fail("你的盔甲库里空空荡荡！\n");
		
       if(!me->query("diablo_armor_number"))
		return notify_fail("你的盔甲库里空空荡荡！\n");
	num = me->query("diablo_armor_number");
	if(sizeof(diablo_ob)!=num)
	  return notify_fail(HIR "\n你的盔甲库遭劫了，请和巫师联系。\n" NOR);
	
	list=keys(diablo_ob);
	if( i < 1)
	return notify_fail("你的盔甲库里没有这件盔甲！\n");
	if(num < i)
		return notify_fail("你的盔甲库里没有这件盔甲！\n");
	slot = list[i-1];
	dbase=diablo_ob[list[i-1]];
	files=dbase["files"];
	prop=keys(dbase);
	prop-=({"actions"});
	
	if(!ob=new(files))
	{
	      destruct(ob);
              return notify_fail("取得盔甲失败，请联系巫师。\n");
        }
	
	else{
		ob=new(files);
		for(int z=0;z<sizeof(prop);z++)
			ob->set(prop[z],dbase[prop[z]]);
		if(!ob->move(me))
			ob->move(environment(me));
		
	
	}
	
                message_vision("$N从墙上取下" + ob->name() + "。\n", me);
                me->add("diablo_armor_number",-1);
                me->delete("diablo_armor_slot/"+slot);
                return 1;
     
}

int do_put(string arg)
{
         object  me, ob;
        int   amount;
	string files,slot;
	mapping num,ob_dbase;
	string *list;
        me = this_player();
	if( !arg ) return notify_fail("你要把什么东西放进盔甲库？\n");
        if( !objectp(ob = present(arg, me) ) )
                {tell_object(me,"你要把什么东西放进盔甲库？\n");
		 return 1;
		}
       if(!ob->is_diablo_ob())
        {
                tell_object(me,"这样东西不能放进盔甲库。\n");
                return 1;
        }
        if(!ob->query("armor_prop"))
        {
        	 tell_object(me,"这样东西不能放进盔甲库，你或许可以去武器库看看。\n");
                return 1;	
        	
        }
          if(ob->query("diablo_ob_autoloaded"))
         {
        	 tell_object(me,"这样东西不能放进盔甲库。\n");
                return 1;	
        	
        }
   /*	if(!ob->query("have_set_name"))
   	{
   	       tell_object(me,"先替它取个名字(rename)吧^_^\n");
                return 1;
       	
   		
   	}
   	*/
        if(ob->is_character())
       	{
         		tell_object(me,"活物可不能放进去^_^\n");
         	return 1;
        }
     
        
      	 if(me->query("diablo_armor_number")>MAX_SIZE_WEAPON-1)
        {
        	tell_object(me,"盔甲库已经挂满盔甲了。\n");
        	 return 1;
        }
        slot = check_blank_slot(me);
        if(slot == "none")
        {
       		 tell_object(me,"你的盔甲库可能有点问题，请联系巫师。\n");
        	 return 1;	
        }
       
        ob_dbase=ob->query_entire_dbase();
        files=base_name(ob)+".lpc";
        ob_dbase+=(["files":files]);
   
        me->set("diablo_armor_slot/"+slot,ob_dbase);
        me->add("diablo_armor_number",1);
	message_vision("$N将"+ob->query("name")+"放入到盔甲库中。\n",me);
	ob->move("/obj/void");
        destruct(ob);
        return 1;
}
string check_blank_slot(object me)
{
	
	if(!me->query("diablo_armor_slot/A"))	
		return "A";
	else if(!me->query("diablo_armor_slot/B"))	
		return "B";
	else if(!me->query("diablo_armor_slot/C"))	
		return "C";
	else if(!me->query("diablo_armor_slot/D"))	
		return "D";
	else if(!me->query("diablo_armor_slot/E"))	
		return "E";
	else if(!me->query("diablo_armor_slot/F"))	
		return "F";
	else if(!me->query("diablo_armor_slot/G"))	
		return "G";
	else if(!me->query("diablo_armor_slot/H"))	
		return "H";
	else if(!me->query("diablo_armor_slot/I"))	
		return "I";
	else if(!me->query("diablo_armor_slot/J"))	
		return "J";
	else return "none";
	
	
	
	
}