// by bugbug & alading @ 缥缈水云间, 2003-4-5
inherit F_VENDOR_SALE;
#include <ansi.h>

void create() {
  reload("xiaotou");
  set_name(HIW "神偷" NOR, ({ "xiao tou", "tou" }));
  set("title", RED "天下第一" NOR);
  set("gender", "男性");
  set("age", 25);
  set("long", "名冠叁界第一神偷。\n");

  set("combat_exp", 70000);
  set_skill("fonxansword", 30);
  set_skill("sword", 50);
  set_skill("unarmed", 50);
  set_skill("dodge", 50);
  set_skill("parry", 50);
  set_skill("moondance", 50);
  map_skill("dodge", "moondance");
  map_skill("sword", "fonxansword");
  map_skill("parry", "fonxansword");
  set("force", 200);
  set("max_force", 200);
  set("force_factor", 5);

  set("vendor_goods", ([
    //               "datao": "/d/obj/drug1/datao",
    //               "daguo": "/d/obj/drug1/daguo",
    "qiongcao": "/d/obj/drug1/qiongcao",
    "shaqiwan": "/d/obj/drug1/shaqiwan",
    "xylxw": "/d/obj/drug1/xylxw",
    "xbw": "/d/obj/drug1/xbw",
    //            "xjd": "/d/obj/drug/xjd",
    //       "huanyang":"/d/obj/drug/huanyang",
    "lingzhi": "/d/obj/drug/lingzhi",
    "renshen": "/d/obj/drug/renshen",
  ]));

  setup();
  carry_object("/d/obj/cloth/pink_cloth")->wear();
  carry_object("/d/obj/weapon/sword/changjian")->wield();

}

void init() {
  object ob;

  ::init();
  add_action("do_vendor_list", "list");
  add_action("block_cmd", "", 1);
}
int block_cmd() {
  object who = this_player();
  string verb = query_verb();

  if (verb == "bid") {
    if (who->query("combat_exp") < 1000000) {
      tell_object(who, "就你这小胳膊小腿也想盘店？\n");
      return 1;
    } else return 0;
  }
  if (verb == "set_price") return 1;
  return 0;
}
