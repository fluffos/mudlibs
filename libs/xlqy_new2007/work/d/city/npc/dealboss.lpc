inherit NPC;
#include <ansi.h>

void create() {
  set_name(HIG "小狗狗" NOR, ({ "boss" }));
  set("title", HIC "跳蚤市场老板" NOR);
  set("race", "野兽");
  set("gender", "雄性");
  set("age", 5);
  set("per", 99);
  set("long", "奉阿阿之命，看管跳蚤市场的一条小狗狗。\n");

  set("combat_exp", 1000000);
  set("daoxing", 1000000);

  setup();
}

void init() {

  ::init();
  add_action("block_cmd", "", 1);
}


int block_cmd() {
  string verb = query_verb();
  if (verb == "exert") return 1;
  if (verb == "bian") return 1;
  if (verb == "cast") return 1;
  if (verb == "drop") return 1;
  return 0;
}
