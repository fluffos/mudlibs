#include <ansi.h>
inherit NPC; 

string ask_job();


void create()
{
        set_name("姚春", ({"yao chun", "yao", "chun"}));
        set("title", HIG "回春堂" NOR);
        set("nickname", HIR "跌打名医" NOR);
        set("long",
                "这便是长安回春堂药铺的跌打名医姚春，身材干\n"
                "瘦，其貌不扬。\n");
        set("gender", "男性");
        set("age", 65);
        set("int", 38);
        set("kee", 1000);
        set("max_kee", 1000);
        set("sen", 1000);
        set("max_sen", 1000);
        set("shen_type", 1);

        set("combat_exp", 500000);
        set("attitude", "heroism");

        set_skill("unarmed", 80);
        set_skill("dodge", 80);
        set_skill("parry", 60);
        set_temp("apply/attack", 70);
        set_temp("apply/defense", 70);
        set_temp("apply/damage", 50);
        set("inquiry", ([
                "配药"   : (: ask_job :),
                "工作"   : (: ask_job :),
                "job"    : (: ask_job :),
        ]));

        setup();
        carry_object("/d/obj/cloth/choupao")->wear();
}



string ask_job()
{
        object me;
        object *obs;

        me = this_player();
        if (me->query_temp("job/peiyao"))
                return "让你干的活你干完了么？";

        if (me->query("combat_exp") > 200000)
                return "让你干这活，也太屈就你了吧。";

        if (me->query("combat_exp") < 100000)
                return "就凭你就这点能力，我看你来药臼都端不起来！";

        if (me->query("kee") < 5)
                return "你还是先歇歇吧，万一累出人命来我可负担不起。";

        if (! interactive(me))
                return "……";

        obs = filter_array(all_inventory(environment()),
                           (: interactive($1) &&
                              $1 != $(me) &&
                              $1->query_temp("job/peiyao") &&
                              query_ip_number($1) == query_ip_number($(me)) :));
        if (sizeof(obs) > 0)
                return "我这已经有" + obs[0]->name() + "在干活了，你等等吧。";

        me->set_temp("job/peiyao", 1);
        return "好，你就帮我配药(peiyao)吧！喏，就这几味。";
}
