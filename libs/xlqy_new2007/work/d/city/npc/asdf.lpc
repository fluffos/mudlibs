int do_autoload(string arg) {
  object ob, who;
  mapping num, ob_dbase;
  who = this_player();
  if (!userp(who))
    return 0;
  if (!arg)
    return notify_fail("你要设定什么为自动加载物品？\n");
  if (!ob = present(arg, who))
    return notify_fail("你要设定什么为自动加载物品？\n");
  if (!ob->is_diablo_ob())
    return notify_fail("这件东西不能设为自动加载！\n");
  if (!ob->query("weapon_prop") && !ob->query("armor_prop") && !ob->query("charm"))
    return notify_fail("这件东西不能设为自动加载！\n");
  if (!ob->query("identification"))
    return notify_fail("这件东西还没经过鉴定，不能设为自动加载！\n");
  if (ob->query("diablo_ob_autoloaded"))
    return notify_fail("这件东西已经是自动加载物品了！\n");

  if (ob->query("equipped")) {
    tell_object(who, "你必须先放下这样东西。\n");
    return 1;
  }
  tell_object(who, "你确定要把" + ob->query("name") + "设为自动加载物品吗？(yes/no)\n");
  input_to((: autoloading :), ob, who);

  return 1;

}

void autoloading(string arg, object ob, object who) {
  mapping ob_dbase;
  int num;
  string files;
  string slot, cslot;
  if (arg != "y" && arg != "yes")
    return;

  if (who->query("diablo_weapon_autoload_num") > 3 && ob->query("weapon_prop")) {
    tell_object(who, "你已经设定过四件自动加载的武器了，请用disload <物品id>取消某件的自动加载。\n");
    return;
  } else if (who->query("diablo_armor_autoload_num") > 14 && ob->query("armor_prop")) {
    tell_object(who, "你已经有十五件设定过自动加载的盔甲了，请用disload <物品id>取消某一件的自动加载。\n");
    return;

  } else if (who->query("diablo_charm_autoload_num") > 9 && ob->query("charm")) {
    tell_object(who, "你已经有十件设定过自动加载的神符了，请用disload <物品id>取消某一件的自动加载。\n");
    return;

  }
  slot = check_blank_slot(who);
  if (slot == "none" && ob->query("armor_prop")) {
    tell_object(who, "你的自动加载盔甲可能有问题，请联系巫师。\n");
    return;

  }
  cslot = check_scblank_slot(who);
  if (cslot == "none" && ob->query("charm")) {
    tell_object(who, "你的自动加载神符可能有问题，请联系巫师。\n");
    return;

  }
  if (who->query("diablo_weapon_autoload/" + ob->query("name"))) {
    tell_object(who, "你已经加载过一件同名的物品了，还是先改个名吧。\n");
    return;

  }
  ob_dbase = ob->query_entire_dbase();
  files = base_name(ob) + ".lpc";
  ob_dbase += ([ "files": files ]);
  map_delete(ob_dbase, "equipped");
  map_delete(ob_dbase, "actions");

  if (ob->query("weapon_prop")) {
    //	who->delete("diablo_weapon_autoload");
    who->set("diablo_weapon_autoload/" + ob->query("name"), ob_dbase);
    who->add("diablo_weapon_autoload_num", 1);
  } else if (ob->query("armor_prop")) {
    who->set("diablo_armor_autoload/" + slot, ob_dbase);
    who->add("diablo_armor_autoload_num", 1);
    if (who->query("diablo_armor_autoload_num") > 15) {

      who->delete("diablo_armor_autoload/" + slot);
      who->add("diablo_armor_autoload_num", -1);
      tell_object(who, "sorry ,bug!\n");
      return;
    }
    ob->set("diablo_slot", slot);
  } else if (ob->query("charm")) {
    who->set("diablo_charm_autoload/" + cslot, ob_dbase);
    who->add("diablo_charm_autoload_num", 1);
    if (who->query("diablo_charm_autoload_num") > 10) {

      who->delete("diablo_charm_autoload/" + cslot);
      who->add("diablo_charm_autoload_num", -1);
      tell_object(who, "sorry ,bug!\n");
      return;
    }
    ob->set("diablo_slot", cslot);
  }
  ob->set("diablo_ob_autoloaded", 1);
  ob->set("no_give", 1);
  ob->set("owner_id", getuid(who));

  ob->set("no_get", 1);
  ob->set("no_put", 1);
  ob->set("no_sell", 1);
  ob->set("no_drop", 1);
  this_object()->command("walkby " + who->query("id"));
  tell_object(who, ob->query("name") + "已经被设定为自动加载物品！\n");
  return;

}
int do_disload(string arg) {
  object ob, who;

  mapping num, ob_dbase;
  who = this_player();
  if (!userp(who))
    return 0;
  if (!arg)
    return notify_fail("你要取消哪个自动加载物品？\n");
  if (!ob = present(arg, who))
    return notify_fail("你要取消哪个自动加载物品？\n");

  if (!ob->query("diablo_ob_autoloaded"))
    return notify_fail("这件东西不是自动加载物品！\n");
  if (ob->query("equipped")) {
    tell_object(who, "你必须先放下这样东西。\n");
    return 1;
  }
  tell_object(who, "你确定要把" + ob->query("name") + "取消自动加载吗？(yes/no)\n");
  //	tell_object(who,HIR"取消这件物品的自动加载，同时会摧毁这件物品！请慎重！\n"NOR);
  input_to((: disloading :), ob, who);

  return 1;

}

void disloading(string arg, object ob, object me) {
  mapping ob_dbase;
  int num;
  if (arg != "y" && arg != "yes")
    return;

  if (ob->query("weapon_prop")) {
    me->delete("diablo_weapon_autoload/" + ob->query("name"));
    me->add("diablo_weapon_autoload_num", -1);
  } else if (ob->query("armor_prop")) {
    me->delete("diablo_armor_autoload/" + ob->query("diablo_slot"));
    me->add("diablo_armor_autoload_num", -1);
    ob->delete("diablo_slot");
  } else if (ob->query("charm")) {
    me->delete("diablo_charm_autoload/" + ob->query("diablo_slot"));
    me->add("diablo_charm_autoload_num", -1);
    ob->delete("diablo_slot");
  }
  this_object()->command("die1 " + me->query("id"));
  tell_object(me, ob->query("name") + "已经被取消自动加载！\n");
  ob->delete("diablo_ob_autoloaded");
  if (ob->query("no_diablo_disload_give")) {
    ob->set("no_give", 1);
    ob->set("no_get", 1);
    ob->set("no_sell", 1);
    ob->set("no_drop", 1);
  } else {
    ob->set("no_give", 0);
    ob->set("no_get", 0);
    ob->set("no_sell", 0);
    ob->set("no_drop", 0);

  }
  ob->delete("owner_id");


  //	message_vision(HIW"“砰”的一声，"+ob->query("name")+"化为微尘消失无形。\n"NOR,me);
  //	ob->move("/obj/void");
  //	destruct(ob);
  return;

}
int die() {
  this_object()->command("ghost zong guan");
  return 1;
}

int do_fight(string arg) {
  object who = this_player();
  object me = this_object();

  if (arg && present(arg, environment(who)) == me) {
    message_vision(CYN "$N拍了拍$n的头道：宝宝听话，一会ㄦ给你买猕猴桃。\n" NOR, me, who);

    return 1;
  }
  return 0;
}

int do_kill(string arg) {
  object who = this_player();
  object me = this_object();

  if (arg && present(arg, environment(who)) == me) {
    message_vision(CYN "$N深情的吻了一下$n的眼睛、前额、耳、颈、....和那诱人的小嘴...\n" NOR, me, who);
    return 1;
  }
  return 0;
}

int do_cast(string arg) {
  object who = this_player();
  object me = this_object();

  message_vision(CYN "$N把$n温柔的塞进下水道里，叮嘱道，一路多多保重！\n" NOR, me, who);

  return 1;
}


int do_steal(string arg) {
  object who = this_player();
  object me = this_object();

  message_vision(CYN "你看到$N偷偷的从$n身上偷走了一些黄金！\n" NOR, me, who);

  return 1;
}


int do_ji(string arg) {
  object who = this_player();
  object me = this_object();

  message_vision("$N指着$n说：大家看到啦？这个家伙没事就长篇大论婆婆妈妈叽叽歪歪，\n
就好象整天有一只苍蝇，嗡……对不起，不是一只，是一堆苍蝇围着你， 嗡…嗡…嗡…嗡…飞到你的耳朵里面，救命啊……\n", me, who);

  return 1;
}

int do_bian(string arg) {
  object who = this_player();
  object me = this_object();

  message_vision("$N对着猪八戒吼到：臭贼，长的太象" + who->query("name") + "了,害得我认错人拉！\n", me, who);

  return 1;
}
int do_throw(string arg) {
  object who = this_player();
  object me = this_object();

  message_vision("$N拎起一把玫瑰，劈头盖脑地朝$n摔了过来。\n", me, who);

  return 1;
}

int do_list(string arg) {
  object who = this_player();
  object me = this_object();
  message("vision", "" HIG "\n─────────────────────────────────────
          \n" HIY "盔甲：" HIC "
          1.金甲(armor)     2. 披风(pifeng)   3.盾牌(shield)
          4.铁盔(kui)       5. 战袍(cloth)    6.踏云靴(shoes)
          7.护身符(amulet)  8. 指环(ring)     9.护肩(shoulder)
          \n" HIY "兵器：" HIC " 
          1.降魔棒(stick)   2. 青虹剑(sword)  3.软龙筋(whip)
          4.金刀(blade)     5. 短铁爪(zhua)   6.黄铜禅杖(staff)
          7.宣花斧(axe)     8. 月牙铲(fork)   9.梅花锤(hammer)
          10.点金枪(spear)  11.凤凰琴(qin)    12 虎尾鞭 (mace)
          13.古琴(muqin)     14.竹箫(zhuxiao)  15.大雪山地图(map)
          16 东海仙山图 (tu)
" HIG "\n─────────────────────────────────────\n" NOR "", who, me);

  return 1;
}

int do_yao(string arg) {
  string type;
  object ob;
  object who = this_player();
  object me = this_object();

  if (who->query("combat_exp") > 1234567 && arg != "tu" && arg != "map") {
    message_vision("$N拍着$n的肩膀，笑得嘴都合不起来了。\n", me, who);
    return notify_fail("凭您的功夫，还是自己去打装备吧! :D\n");
  }

  if (!arg)
    return notify_fail("你想要什么？兵器？还是盔甲？(比如:yao sword)\n");
  else {
    sscanf(arg, "%s", type);
    switch (type) {
      case "shoulder":
        ob = new("/d/city/npc/obj/shoulder.lpc");
        ob->set("no_sell", 1);
        ob->set("no_drop", 1);
        ob->set("no_get", 1);
        ob->set("no_give", 1);
        ob->move(who);
        tell_object(who, "按时地方把" + ob->query("name") + "交给你,并告诉你:带好，别乱丢哦！\n");
        break;
      case "ring":
        ob = new("/d/city/npc/obj/ring.lpc");
        ob->set("no_sell", 1);
        ob->set("no_drop", 1);
        ob->set("no_get", 1);
