#include <armor.h>

inherit AMULET;

void create()
{
  set_name("护身符", ({"amulet"}));
  set_weight(500);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
    set("long", "一条细铜线串着一颗不知道什么材料珠子的护身符。\n");
    set("material", "glass");
    set("unit", "件");
    set("value", 0);
    set("armor_prop/armor", 5);
     set("armor_prop/intelligence", 2);
	set("no_sell",1);
				set("no_drop","去垃圾堆丢吧，乱扔会污染环境!\n");
				set("no_give","总管发的装备，可不能乱送人哟！\n");
				set("no_get","想拿总管按时地方发的装备？做梦吧!\n");
  }
  setup();
}



