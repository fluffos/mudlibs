//qin.c

#include <weapon.h>

inherit QIN;

void create()
{
	set_name("木琴", ({"muqin","qin"}) );
	set_weight(6000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "具");
		set("material", "wood");
		set("long", "这是一具用上好的梧桐木做的古琴。\n");
		set("value", 500);
		set("wield_msg", "$N拿出一具$n，调了调琴弦。\n");
		set("unwield_msg", "$N放下手中的$n。\n");
		set("music_type","qin");
		set("no_sell",1);
		set("no_drop","去垃圾堆丢吧，乱扔会污染环境!\n");
		set("no_give","总管发的装备，可不能乱送人哟！\n");
		set("no_get","想拿总管按时地方发的装备？做梦吧!\n");
	}
			
	init_qin(40, TWO_HANDED);
	setup();
}

