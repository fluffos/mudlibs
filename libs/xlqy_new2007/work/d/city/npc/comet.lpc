//tonii,03-5-20

#include <ansi.h>

int pk();
int nopk();
int back();

inherit NPC;

void create() {
  set_name(HIW "音尘绝" NOR, ({ "npc comet", "comet" }));
  set("title", HIC "Admin Forever" NOR);
  set(
    "long",
    HIW "\n一身如雪白袍的天神音尘绝，你可以在他面前决定自己的人生道路。\n" NOR + HIC "\n ask comet about pk 选择ＰＫ的道路。\n ask comet about nopk 选择ＮＯＰＫ的道路。\n ask comet about back 对你的人生选择有一次重新选择的机会。\n\n" NOR
  );
  set("gender", "男性");
  set("rank_info/respect", HIY "天神" NOR);
  set("age", 25);
  set("attitude", "heroism");
  set("per", 32);
  set("max_kee", 5000);
  set("max_gin", 5000);
  set("max_sen", 5000);
  set("force", 6000);
  set("max_force", 12000);
  set("force_factor", 300);
  set("max_mana", 7000);
  set("mana", 16000);
  set("mana_factor", 350);
  set("combat_exp", 2400000);
  set("daoxing", 6800000);
  set("inquiry", ([
    "name": "我就是白袍音尘绝，你可以选择“pk”或者“nopk”来决定你以后的人生。\n",
    "here": "你可以选择“pk”或者“nopk”来决定你以后的人生。\n",
    "PK": (: pk :),
    "pk": (: pk :),
    "NOPK": (: nopk :),
    "nopk": (: nopk :),
    "NO PK": (: nopk :),
    "no pk": (: nopk :),
    "back": (: back :),
    "反悔": (: back :),
  ]));
  setup();
}

int pk() {
  string str;
  object who = this_player();
  object ob = this_object();
  if (this_player()->query("ziyou") == "got") {
    message_vision("音尘绝对着$N说：“你的人生已经决定了，你还想变改？”\n", who);
    return 1;
  } else {
    str = who->name();
    message("channel:chat", HIC "【仙缘】白袍音尘绝：" + str + "已经选择了PK这条道路，望大家知照。\n" NOR, users());
    message("channel:rumor", HIM "【谣言】白袍音尘绝：" + str + "已经选择了PK这条道路，望大家知照。\n" NOR, users());
    command("heihei");
    message_vision("音尘绝在$N肩膀上轻轻一拍，说：“你现在已经选择了PK这条道路，以后好自为之啦。”\n", who);
    who->set("ziyouchoose", "pk");
    who->set("pk", "pk");
    who->set("ziyou", "got");
    return 1;
  }
}

int nopk() {
  string str;
  object who = this_player();
  object ob = this_object();
  if (this_player()->query("ziyou") == "got") {
    message_vision("音尘绝对着$N说：“你的人生已经决定了，你还想变改？”\n", who);
    return 1;
  } else {
    str = who->name();
    message("channel:chat", HIC "【仙缘】白袍音尘绝：" + str + "已经选择了NOPK这条道路，大家以后不要再为难他了。\n" NOR, users());
    message("channel:rumor", HIM "【谣言】白袍音尘绝：" + str + "已经选择了NOPK这条道路，大家以后不要再为难他了。\n" NOR, users());
    command("smile");
    message_vision("音尘绝在$N肩膀上轻轻一拍，说：“你现在已经选择了NOPK这条道路，以后请多帮别人的忙。”\n", who);
    who->set("ziyouchoose", "nopk");
    who->set("nopk", "nopk");
    who->set("ziyou", "got");
    return 1;
  }
}


int back() {
  string str;
  object who = this_player();
  object ob = this_object();
  if (this_player()->query("ziyouback") == "got") {
    message_vision("音尘绝对着$N说：“你的人生已经反悔一次了，做人还是不要太反复无常好？”\n", who);
    return 1;
  } else {
    str = who->name();
    message_vision("音尘绝在$N肩膀上轻轻一拍，说：“你现在已经重新选择你的人生道路。”\n", who);
    who->delete("ziyouchoose");
    who->delete("ziyou");
    who->set("ziyouback", "got");
    return 1;
  }
}
