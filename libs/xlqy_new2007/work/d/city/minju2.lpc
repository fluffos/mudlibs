//by flying

inherit ROOM;
#include <ansi.h>
void create()
{
        set ("short", "民居");
        set ("long", @LONG

这户民宅从结构上看还是相当不错的，显示出这户人家先前似乎曾经
阔过。不知从哪一辈起家道开始衰落了，这座房子也随之年久失修。
现在这户人家的两个儿子更是整日里游手好闲，不务正业。
LONG);

        set("objects", ([
      
                __DIR__"npc/xiaopizi" : 2,

     ]) );  
        set("exits", ([
                "east" : __DIR__"beiyin3",

        ]));
	set("no_clean_up", 0);
        setup();
}
void init()

{

add_action("do_search", "search");

}

int do_search(string arg)

{

int kar;

object zhu,map,dinghaizhu;
object me=this_player();

if(!arg) {

kar = this_player()->query("kar");

if(!random(5) && (map=present("paper", me)) && me->query("lg/findzhu") && !(dinghaizhu=present("dinghaizhu",me))) {

message_vision("在房间中$N细细搜索，突然$N看到了一颗发亮的东西。\n", this_player());

message_vision("$N立刻拿起纳入怀中。\n", this_player());

zhu = new("/d/sea/obj/dinghaizhu");

zhu->move(this_player());
if(!this_player()->query("lg/getzhu"))
        {
                this_player()->set("lg/getzhu",1);
                this_player()->add("potential",300+random(500));
                this_player()->add("daoxing",2000+random(2000));
                this_player()->add("combat_exp",2000+random(2000));
                
        }


//set("research",0);

return 1;

}

}

return notify_fail("你在房间中细细摸索，却甚麽都没发现。\n");

}

