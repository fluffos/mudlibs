      HIR "                              s&&&&&&&&&&s~~&&&&ssssss~&&&&&&&&~\n" NOR,
      me
    );
    message_vision(HIR "                             s&&&&&&&&&&'         `~~~ss~&~&s~~\n" NOR, me);
