    message_vision(
      HIR "                                   &&~~&&&&&&&&&&&&&&&&&&&&&&&&&&&&&~   `\n" NOR,
      me
    );
    message_vision(
      HIR "                                  &&~  ~&~&&&&&&&&&&&&&&&&&&&&S~~~~'\n" NOR,
      me
    );
