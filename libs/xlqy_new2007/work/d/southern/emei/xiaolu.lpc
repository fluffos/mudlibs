// by flying @ 缥缈水云间

#include <ansi.h>
inherit ROOM;

void create() {
  set("short", "崖底");
  set("long", @LONG
    
    眼前是一道巨大的石壁，乍看好像没有路了。
    你仔细的找了找，发现一条细小的石缝，刚好可以钻过去。
　　
LONG);


  set("exits", ([
    "north": __DIR__ "xiaolu1",
    "south": __DIR__ "yadi",

  ]));


  set("objects", ([
    //  __DIR__"npc/dragon"  : 1,
  ]));



  set("outdoors", 1);

  setup();
}

int valid_leave(object me, string dir) {
  object here = this_object();
  object huodragon;
  if ((me->query("emei/killdragon") != 1 && dir == "north" && (string)me->query("family/family_name") != "东海龙宫" && (string)me->query("family/family_name") != "蜀山剑派" && (string)me->query("family/family_name") != "南海普陀山") || (me->query("pini") == 1 && dir == "north" && me->query("emei/killdragon") != 1) || (me->query("fengwu") == 1 && dir == "north" && me->query("emei/killdragon") != 1)) {
    if (!present("dragon")) {
      huodragon = new("/d/southern/emei/npc/dragon.lpc");
      huodragon->move(here);
    }
    message_vision(HIR "                                        &.  &.     .\n" NOR, me);
