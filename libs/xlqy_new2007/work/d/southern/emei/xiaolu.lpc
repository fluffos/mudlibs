    message_vision(HIR "                  ~&&sS&&&&&&&&&&&&&&&&&&&&&&&&&&&########~\n" NOR, me);
    message_vision(HIR "           .      s&&&&&&&&&&&&&&&&&&&&&&&&#########~~'\n" NOR, me);
    message_vision(
      HIR "           &    s&&&&&&&&&&&&&&&&&&&&&#######~~'      s'         .\n" NOR,
