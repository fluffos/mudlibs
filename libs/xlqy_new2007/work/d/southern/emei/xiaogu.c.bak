// by flying @ 缥缈水云间


inherit ROOM;
#include <ansi.h>

void create()
{
set("short", "幽谷");
set("long", HIC+@LONG
    
    小溪尽处，竟豁然开朗，一道充满活力的小瀑布从半山隙缝处冲泻而下，奔流在苍翠欲滴的山谷
    崖壁上，到崖底后形成小潭。小溪的左侧有一间小屋,旁边一块大石头上刻着:
                                                                        【紫幻小筑】。
    水瀑有如布幕般垂落下来，激起飞溅水花，水滴四外拋洒，在星辉下仿如银珠万颗，充满活力。
    
    水瀑前唯一的一块大石上，坐着一男一女。
LONG+NOR );


set("exits", ([
  "south"   : __DIR__"gukou",
  
 
]));


set("objects", ([
   "/d/sea/npc/flying" : 1,
   "/d/sea/npc/huaner" : 1, 
]));



set("outdoors", 1);

setup();
}

