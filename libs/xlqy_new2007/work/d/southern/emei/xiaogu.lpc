// by flying @ 缥缈水云间


inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "幽谷");
  set("long", HIC + @LONG
    
    小溪尽处，竟豁然开朗，一道充满活力的小瀑布从半山隙缝处冲泻而下，奔流在苍翠欲滴的山谷
    崖壁上，到崖底后形成小潭。小溪的左侧有一间小屋,旁边一块大石头上刻着:
                                                                        【紫幻小筑】。
    水瀑有如布幕般垂落下来，激起飞溅水花，水滴四外拋洒，在星辉下仿如银珠万颗，充满活力。
    
    水瀑前唯一的一块大石上，坐着一男一女。
LONG + NOR);


  set("exits", ([
    "south": __DIR__ "gukou",


  ]));


  set("objects", ([
    // "/d/sea/npc/flying" : 1,
    // "/d/sea/npc/huaner" : 1, 
  ]));



  set("outdoors", 1);

  setup();
}

void init() {
  add_action("do_jump", "jump");
}

int do_jump(string arg) {
  object ob;
  int new_sen;
  ob = this_player();
  new_sen = random(ob->query("max_sen") * 3);
  if (new_sen > ob->query("sen")) new_sen = ob->query("sen") + 1;
  if (ob->is_busy())
    return 0;
  if (!arg || arg == "") return 0;
  if (arg != "stone")
    return notify_fail("你想要干什么啊？\n");

  tell_object(ob, HIR "你轻轻一跃，跳到了大石上。\n" NOR);
  message("vision", NOR "只见" + ob->query("name") + "轻轻一跃，跳到了大石上。\n" NOR, environment(ob), ob);
  ob->move(__DIR__ "stone");
  return 1;
}
