// 要任务
int ask_job(object ob) {
  mapping job;
  mapping whatjob;
  int index;
  if (!ob->query("wuguan/join"))  //不是武馆成员
  {
    message_vision(
      CYN "管家受宠若惊：" + RANK_D->query_respect(ob) + "不是本武馆的人，“效劳”二字严重了。\n" NOR, ob);
    return 1;
  }

  // 是武馆成员
  if (ob->query("wuguan/job"))  //身上有job
  {
    tell_room(ob, CYN "管家皱了皱眉：" + ob->query("wuguan/number") + ",你还是先把手头上的活干完再说吧。\n" NOR);
    whatjob = ob->query("wuguan/job");
    tell_object(ob, whatjob["msg"]);
    return 1;
  }
  if (!ob->query("wuguan/register")) {
    message_vision(CYN "管家哼了一声，说道：先到我这里报道（ｒｅｇｉｓｔｅｒ）。\n" NOR, ob);
    return 1;

  }
  if (ob->query("combat_exp") > 80000) {
    message_vision(HIW "管家对$N说道：你现在是有身份的人了，这些鸡毛蒜皮的小事不敢劳你动手。\n" NOR, ob);
    message_vision(CYN "管家嘿嘿笑道：你该出去见见世面，看看外面的花花世界。\n" NOR, ob);
    return 1;
  }
  if (ob->query("age") > 17) {
    message_vision(HIW "管家叹了口气，说道：你来武馆也有很多时日了，这些鸡毛蒜皮的小事给新人去做吧。\n" NOR, ob);
    message_vision(CYN "管家摇头道：来武馆这么久却始终长进不大，还是另投明师吧。\n" NOR, ob);
    return 1;

  }
  /*	if(ob->query_temp("wuguan/job_success") >= 25 )
	{
		message_vision(HIW"管家笑道：做的不错，辛苦辛苦。现在没什么杂活了，你去练功、闲逛、休息，都行。\n"NOR,ob);
	   	call_out("reset_jobtime",300+random(150),ob);
	   	return 1;	
		
	}
	else  //not job
	{
	*/  // 分配新job
  index = random(sizeof(jobs));
  job = jobs[index];
  //	if(index == 8&&ob->query("combat_exp") < 35000)
  //	 	job = jobs[random(8)];

  //	job=jobs[8]; //for test
  ob->set("wuguan/job", job);
  tell_object(ob, job["msg"]);
  return 1;
  //	}
}
int reset_jobtime(object ob) {
  if (ob)
    ob->delete_temp("wuguan/job_success");
  return 1;


}
// 放弃任务
int give_up(object ob) {
  mapping job;

  if (!(job = ob->query("wuguan/job"))) {
    tell_object(ob, CYN "管家说道：" + ob->query("wuguan/number") + ",你又没领任务，胡喊什么？\n" NOR);
    return 1;
  }
  if (job["job"] == "打架") {
    tell_object(ob, CYN "管家说道：打不过就算了，再好好练练吧。\n" NOR);
    ob->delete("wuguan/job");
    ob->add("combat_exp", -((int)job["bonus"] / 5 + random(job["exp"] / 5)));
    if (ob->query("combat_exp") < 0)
      ob->set("combat_exp", 0);
    return 1;
  }
  message_vision(HIR "管家两眼一瞪，吼道：你不干，谁来干？这点小事都做不好，以后怎么出去闯荡！\n" NOR, ob);

  return 1;
}

// 发工具
int give_tool(object ob, object npc) {
  mapping job;
  object objTool;

  seteuid(getuid());
  if (!ob->query("wuguan/join")) {
    message_vision(CYN "孙管事对$N说道：你又不是我们武馆的人，来骗工具么？\n" NOR, ob);
    return 1;
  }
  if (!ob->query("wuguan/register")) {
    message_vision(CYN "孙管事对$N说道：先去管家那里报道（ｒｅｇｉｓｔｅｒ）吧。\n" NOR, ob);
    return 1;

  }
  if (!(job = ob->query("wuguan/job"))) {
    message_vision(
      "孙管事对着$N说道：" + ob->query("wuguan/number") + ",你什么任务都没有，到这里来骗工具么？\n", ob);
    return 1;
  }
  if (ob->query_temp("wuguan/tool")) {
    tell_object(ob,
      "孙管事说道：" + ob->query("wuguan/number") + "，你先把上回借的工具还了再说。\n");
    return 1;
  }

  switch (job["job"]) {
    case "钓鱼":
      objTool = new(__DIR__ "obj/yugan");
      break;
    case "生火":
      objTool = new(__DIR__ "obj/chaidao");
      break;
    case "扫大院":
      objTool = new(__DIR__ "obj/saozhou");
      break;
    case "整理书架":
      objTool = new(__DIR__ "obj/mabu");
      break;
    case "除草":
      objTool = new(__DIR__ "obj/chutou");
      break;
    case "浇水":
      objTool = new(__DIR__ "obj/piao");
      break;
    case "喂马":
      objTool = new(__DIR__ "obj/mashua");
      break;
    default:
      message_vision(CYN
        "孙管事说道：" + ob->query("wuguan/number") + "，你现在的工作，不需要什么工具。\n" NOR, ob);
      return 1;
      break;
  }

  objTool->move(ob);
  ob->set_temp("wuguan/tool", objTool->query("id"));
  message_vision("孙管事说道：这是" + objTool->query("name") + "，你拿好，记着用完了还回来。\n", ob);
  tell_object(ob, "你得到一" + objTool->query("unit") + objTool->query("name") + "。\n");
  return 1;
}

// 接收工具
int accept_tool(object npc, object ob, object obj) {
  if (!ob->query_temp("wuguan/tool")) {
    message_vision(
      "$n对$N笑道：" + ob->query("wuguan/number") + "，怎么？贿赂我？我可不会被你腐蚀的。\n", ob, npc);
    return 0;
  }
  if (interactive(obj))
    return notify_fail(ob->query("wuguan/number") + "，你想干什么？贩卖人口？\n");
  if (obj->query("id") != ob->query_temp("wuguan/tool"))
    return notify_fail(ob->query("wuguan/number") + "，这东西是你刚借的么？\n");

  message_vision(
    "$n拍拍$N的头，嘻嘻笑道：" + ob->query("wuguan/number") + "，好样的。\n", ob, npc);
  ob->delete_temp("wuguan/tool");
  call_out("destruct_tool", 1, obj);
  return 1;
}

void destruct_tool(object obj) {
  destruct(obj);
  return;
}

// 奖励
int give_gifts(object ob) {
  ob->set_temp("wuguan/job_finish", 1);
  tell_object(ob, "快去向管家报告吧" + HIY "(ask guan jia about finish)！\n" NOR);
  return 1;
}
int real_give_gifts(object ob) {
  int exp, pot, silv;
  int kar;
  mapping job = ob->query("wuguan/job");
  kar = ob->query("kar");
  exp = 2 * ((int)job["bonus"] + random(job["exp"]) + kar * random(3));
  pot = 2 * ((int)job["bonus"] * 2 / 3 + random(job["pot"]) + kar * random(3) / 2);
  silv = random((int)job["bonus"]) * 7 + (int)(job["money"]) * 7 + kar * random(3) * 4;
  if (ob->query("wuguan/lucky")) {
    exp += exp * 2 / 3;
    pot += pot / 2;
    silv += silv / 4;

  }
  ob->add("combat_exp", exp);
  ob->add("potential", pot);
  MONEY_D->pay_player(ob, silv);
  tell_object(ob, CYN "管家拍了拍你的肩膀:" + ob->query("wuguan/number") + "干的好,这是给你的赏钱!\n" NOR);
  tell_object(ob,
    HIY "恭喜你获得" + chinese_number(exp) + "点实战经验，" + chinese_number(pot) + "点潜能!\n" NOR);
  tell_object(ob, "管家给你一些赏钱。\n");
  ob->delete("wuguan/job");
  ob->delete_temp("wuguan/job_finish");
  ob->add_temp("wuguan/job_success", 1);
  ob->add("wuguan/job_success", 1);
  return 1;
}


// 扫大院
int job_saodayuan(object ob, string arg) {
  int exp, pot, silv;
  mapping job;

  if (!arg || (arg != "大院")) {
    return notify_fail("你想扫什么？\n");
  }
  if (!(job = ob->query("wuguan/job")))
    return notify_fail("大院现在挺干净的，不用你扫了。\n");
  if (job["job"] != "扫大院")
    return notify_fail("你现在的工作不是扫大院，先把手头的活干完再说吧。\n");
  if (!present("sao zhou", ob))
    return notify_fail("你拿什么扫地？用衣服么？\n");
  if (ob->is_busy())
    return notify_fail("你扫得快，不一定扫得干净，慢慢来吧。\n");
  if (ob->query("kee") < 10)
    return notify_fail("你的精力现在无法集中，歇会再扫吧。\n");
  if (ob->query("food") < 50)
    return notify_fail("饿着肚皮干活？不知道的还以为我们虐待童工呢。\n");
  if (ob->query("water") < 50)
    return notify_fail("喝点水再干活吧，水是生命之源。\n");

  ob->start_busy(1);
  if (ob->query_temp("wuguan/saodayuan") < 5 + random(10)) {
    ob->add_temp("wuguan/saodayuan", 1);
    ob->receive_damage("kee", 10);
    return notify_fail("你拿着扫帚，一下一下的扫起来。\n");
  }
  if (random(100) > 80) {
    message_vision(
      "$N看起来平时不太劳动，居然把院子越扫越脏了。\n", ob);
    ob->receive_damage("kee", 15);
    return 1;
  }

  message_vision(
    "$N挥舞着扫帚，干的热火朝天，不一会，大院被扫的干干净净。\n", ob);
  ob->receive_damage("kee", 10);
  ob->delete_temp("wuguan/saodayuan");
  return give_gifts(ob);
}

// 钓鱼
int job_diaoyu(object ob, string arg) {
  mapping job;

  if (!(job = ob->query("wuguan/job")))  //没有job
  {
    tell_object(ob, CYN "小鱼告诉你：嗨，你没有经过总管的同意，在这里钓鱼是要罚钱的。\n" NOR);
    message_vision(CYN "$N口吐白沫，向后倒飞了出去。\n" NOR, ob);
    return 1;
  }
  if ((job["job"]) != "钓鱼")  //job 不是钓鱼
  {
    tell_object(ob, "你还是先把手头的活干完再说吧。\n");
    return 1;
  }
  //钓鱼job
  if (!arg)
    return notify_fail("你想钓什么？\n");
  if (arg != "鱼")
    return notify_fail("你要钓的东西，这里没有。\n");
  if (ob->is_busy())
    return notify_fail("钓鱼要有耐心，象你这样急急忙忙，怎么钓的着鱼。\n");
  if (ob->query_temp("wuguan/fishing"))
    return notify_fail("你不是正钓着呢么？别急！\n");
  if (!present("yu gan", ob))
    return notify_fail("你没有鱼竿怎么钓鱼？\n");
  if (ob->query("sen") < 20)
    return notify_fail("你精神不太好，怎么钓鱼？\n");
  if (ob->query_temp("wuguan/fish"))
    return notify_fail("别太贪了，有一条鱼就够了。\n");
  if (ob->query("food") < 50)
    return notify_fail("饿着肚皮干活？不知道的还以为我们虐待童工呢。\n");
  if (ob->query("water") < 50)
    return notify_fail("喝点水再干活吧，不过别喝池塘的水啊，要闹肚子的。\n");
  message_vision("$N拿出一根鱼竿，静静地坐了下来。\n", ob);
  ob->start_busy(1);
  ob->set_temp("wuguan/fishing", 1);
  call_out("end_fishing", 15 + random(15), ob);
  return 1;
}


int end_fishing(object ob) {
  object obj;
  if (!ob) return 1;
  if (!ob->query_temp("wuguan/fishing"))
    return 1;
  ob->delete_temp("wuguan/fishing");
  if (random(100) < 70) {
    ob->receive_damage("sen", 20);
    tell_object(ob, "你费了半天劲，却没钓着一条鱼。\n");
    message_vision("$N显得满脸沮丧。\n", ob);
    return 1;
  }

  obj = new(__DIR__ "obj/fish");
  obj->move(ob);
  ob->receive_damage("sen", 15);
  ob->set_temp("wuguan/fish", 1);
  tell_object(ob, "你好像觉得鱼标在下沉，你一拉鱼竿，果然鱼钩上挂着一条鱼。\n");
  message_vision(CYN "$N高兴的跳了起来。\n" NOR, ob);
  return 1;
}

int give_fish(object npc, object ob, object obj) {
  mapping job;

  if (!(job = ob->query("wuguan/job")))
    return notify_fail(CYN "王厨子满脸疑惑：你给我这玩艺干什么？\n" NOR);

  switch (job["job"]) {
    case "钓鱼":
      if (obj->query("id") != "li yu")
        return notify_fail(CYN "王厨子说道:这是什么东西呀?\n" NOR);

      ob->delete_temp("wuguan/fish");
      call_out("destruct_fish", 1, obj);
      message_vision(
        CYN "$n笑嘻嘻地对$N说：你如此精明能干，他日定有所成。\n" NOR, ob, npc);
      return give_gifts(ob);
      break;
    case "抓鸡":
      if (interactive(obj))
        return notify_fail(ob->query("wuguan/number") + "!你想干什么，做人肉叉烧包？\n");
      if (obj->query("id") != "old hen")
        return notify_fail(CYN "王厨子“咳咳”几声说道:这是什么东西啊?\n" NOR);

      message_vision(
        CYN "$n咳嗽了几声，点点头对$N说：今天我身体有点不舒服，你来帮我" + HIY "(ao 汤)" NOR + "吧。\n" NOR, ob, npc);
      break;
    default:
      return notify_fail(CYN "王厨子说道：我现在不需要这东西，你自己留着用吧。\n" NOR);
  }
}
void destruct_fish(object obj) {
  if (objectp(obj))
    destruct(obj);
  return;
}

// 熬汤
int job_aotang(object ob, string arg) {
  object objhen;
  mapping job;

  if (!arg || (arg != "汤"))
    return notify_fail("你想熬什么？\n");
  if (!(job = ob->query("wuguan/job")))
    return notify_fail("你没事闲得啊，跑厨房瞎胡闹。\n");
  if (job["job"] != "抓鸡")
    return notify_fail("快忙自己的事去吧！\n");
  if (ob->is_busy())
    return notify_fail("慢慢来，要掌握好火候。\n");
  if (!ob->query_temp("wuguan/aotangstart")) {
    if (!(objhen = present("old hen", ob)))
      return notify_fail("你想拿什么熬汤啊。\n");
  }
  if (ob->query("kee") < 10)
    return notify_fail("你现在精力不能集中，小心煮出一锅洗澡水来。\n");
  if (ob->query("food") < 50)
    return notify_fail("饿着肚皮干活？鸡汤是不是很香啊？~~~\n");
  if (ob->query("water") < 50)
    return notify_fail("喝点水再干活吧，锅里的水要留着熬汤，你还是别地方找找水吧。\n");
  if (ob->query_temp("wuguan/aotang"))
    return notify_fail("你这不是正在熬汤么？\n");
  if (ob->query_temp("wuguan/tang"))
    return notify_fail("王厨子笑道：快把汤送过去吧。\n");
  ob->start_busy(5);
  ob->set_temp("wuguan/aotang", 1);

  call_out("over_aotang", 5, ob);
  if (!ob->query_temp("wuguan/aotangstart")) {
    message_vision("$N将一只鸡胡乱的拔了毛，丢进锅里，加了几瓢水，盖上锅盖，开始熬汤。\n", ob);
    call_out("destruct_fish", 1, objhen);
    ob->set_temp("wuguan/aotangstart", 1);
  } else message_vision("$N呆呆的看着往锅外不断扑腾的水泡。\n", ob);
  return 1;
}

int over_aotang(object ob) {
  object tang;
  if (!ob) return 1;
  ob->delete_temp("wuguan/aotang");
  if (random(100) < 75) {
    ob->receive_damage("kee", 20);
    message_vision(
      "$N心急火燎的打开锅盖看了看闻了闻。王厨子在一旁喝道：着什么急，咳咳。。继续" + HIY "(ao 汤)吧。\n" NOR, ob);
    return 1;
  }

  message_vision(
    "锅内溢出的香气越来越浓，$N打开锅盖看了看，往里胡乱加了一点料，哇，一锅鸡汤居然就这样熬好了。\n", ob);
  ob->receive_damage("kee", 25);
  message_vision("王厨子尝了尝，歪了歪嘴，说道：唉，凑合吃吧，咳咳。。快去送到东方大小姐那里吧。\n", ob);
  ob->set_temp("wuguan/tang", 1);
  ob->delete_temp("wuguan/aotangstart");
  tang = new("/d/job/wuguan/obj/jitang");
  tang->move(ob);
  return 1;

}
//送汤
int give_tang(object npc, object ob, object obj) {

  mapping job;

  if (!(job = ob->query("wuguan/job"))) {
    message_vision(CYN "东方英满脸疑惑：谁让你送汤过来的啊？\n" NOR, ob);
    return 0;
  }
  if (job["job"] != "抓鸡") {
    message_vision(CYN "东方英说道：贵客已经用过餐了，你自己留着吃吧。\n" NOR, ob);
    return 0;
  }
  if (obj->query("id") != "ji tang") {
    message_vision(CYN "东方英笑道：快去给贵客上鸡汤啊，给我这个干什么。\n" NOR, ob);
    return 0;
  }
  if (interactive(obj)) {
    message_vision(ob->query("wuguan/number") + "!你想干什么，吃人啊？\n", ob);
    return 0;
  }
  if (!ob->query_temp("wuguan/tang")) {
    message_vision(CYN "东方英眉头一皱，道：你怎么这么磨蹭，鸡汤都凉了，怎么招待客人啊！\n" NOR, ob);
    return 0;
  }
  ob->delete_temp("wuguan/tang");
  message_vision(CYN "东方英笑道：不错不错，有劳你了。\n" NOR, ob);
  call_out("destruct_fish", 1, obj);
  return give_gifts(ob);

}
// 打水
int job_dashui(object ob, string arg) {
  mapping job;

  if (!arg || (arg != "水"))
    return notify_fail("你想打什么？\n");
  if (!(job = ob->query("wuguan/job")))
    return notify_fail("你现在不能在这里打水。\n");
  if (job["job"] != "浇水")
    return notify_fail("你先忙你的事去吧。\n");
  if (!present("tong", ob))
    return notify_fail("连桶都没了，你拿什么提水？\n");
  if (ob->query("kee") < 10)
    return notify_fail("你现在精力不能集中，小心掉井里去。\n");
  if (ob->query("food") < 50)
    return notify_fail("饿着肚皮干活？精神可嘉，不过还是乖乖的吃点东西再来吧。\n");
  if (ob->query("water") < 50)
    return notify_fail("喝点水再干活吧，这里水可有的是，哈哈。\n");
  message_vision("$N走到井边，费力的摇着辘轳，终于打起了一桶水。\n", ob);
  ob->set_temp("wuguan/dashui", 5 + random(5));
  ob->receive_damage("kee", 10);
  ob->start_busy(3);
  return 1;
}

// 浇水
int job_jiaoshui(object ob, string arg) {
  int exp, pot, silv;
  mapping job;

  if (!arg || arg != "水")
    return notify_fail("你想浇什么？\n");
  if (!(job = ob->query("wuguan/job")))
    return notify_fail("这里的菜水分充足，你瞎浇什么？\n");
  if (job["job"] != "浇水")
    return notify_fail("你现在的工作不是浇水，先把手头的活干完再说吧。\n");
  if (!present("tong", ob))
    return notify_fail("你没有提水桶，怎么浇水？\n");
  if (!present("piao", ob))
    return notify_fail("你没有瓢，拿什么浇水？\n");
  if (!ob->query_temp("wuguan/dashui"))
    return notify_fail("桶空的啊，你拿空气浇菜？\n");
  if (ob->is_busy())
    return notify_fail("慢慢来，别太急。 \n");
  if (ob->query("kee") < 15)
    return notify_fail("你现在精力不好，别累昏了。\n");
  if (ob->query("food") < 50)
    return notify_fail("饿着肚皮干活？不是想吃菜叶子吧？\n");
  if (ob->query("water") < 50)
    return notify_fail("喝点水再干活吧，菜要喝水，人也要呀。\n");
  ob->start_busy(1);
  ob->add_temp("wuguan/dashui", -1);
  if (ob->query_temp("wuguan/jiaoshui") > 10 + random(10)) {
    if (random(100) > 40) {
      ob->delete_temp("wuguan/jiaoshui");
      ob->delete_temp("wuguan/dashui");
      message_vision("$N将桶里的水浇完，觉得园子里的菜长得更旺盛了。\n", ob);
      return give_gifts(ob);
    }

    return notify_fail("你拿着瓢随便浇了几下，看起来漫不经心。\n");
  }

  ob->add_temp("wuguan/jiaoshui", 1);
  ob->receive_damage("kee", 10);
  return notify_fail("你舀出一瓢水，浇到菜上。\n");
}

// 除草
int job_chucao(object ob, string arg) {

  int exp, pot, silv;
  mapping job;

  if (!arg || (arg != "草"))
    return notify_fail("你想锄什么？\n");
  if (!(job = ob->query("wuguan/job")))
    return notify_fail("这没杂草，不用你锄了。\n");
  if (job["job"] != "除草")
    return notify_fail("你现在的工作不是除草，先把手头的活干完再说吧。\n");
  if (!present("chu tou", ob))
    return notify_fail("你没锄头，除什么草？\n");
  if (ob->is_busy())
    return notify_fail("别干那么快，身体可是本钱。\n");
  if (ob->query("kee") < 10)
    return notify_fail("快昏了，快昏了，不能再干了。\n");
  if (ob->query("food") < 50)
    return notify_fail("饿着肚皮干活？草的滋味不知道好不好啊？\n");
  if (ob->query("water") < 50)
    return notify_fail("喝点水再干活吧，草可是富含水分的。\n");
  ob->start_busy(1);
  if (ob->query_temp("wuguan/chucao") > 6 + random(10)) {
    if (random(100) > 30) {
      ob->delete_temp("wuguan/chucao");
      message_vision(CYN "经过半天的努力，$N终于将菜地里的杂草除干净了。\n" NOR, ob);
      return give_gifts(ob);
    }
    if (ob->query_temp("wuguan/chucao") > 1)
      ob->add_temp("wuguan/chucao", -1);
    return notify_fail("你一不留神，把好好的菜连根刨了出来。\n");
  }

  ob->add_temp("wuguan/chucao", 1);
  ob->receive_damage("kee", 10);
  return notify_fail("你轮起锄头，一下一下地除了起来。\n");
}

// 劈柴
int job_pichai(object ob, string arg) {
  object obj;

  if (!arg || (arg != "柴"))
    return notify_fail("你想劈什么？\n");
  if (!present("chai dao", ob))
    return notify_fail("你拿什么劈柴？用手撕么？\n");
  if (ob->query("kee") < 10)
    return notify_fail("你现在精力不够，强行劈柴，可能会有生命危险。\n");
  if (ob->is_busy())
    return notify_fail("以你现在的刀法，劈得太快可能会要了自己的小命。\n");

  message_vision("$N放正一块木头。\n", ob);
  if (random(100) < 20) {
    message_vision("$N一刀劈了下去，不过由于手法太差，查点劈着自己的脚。\n", ob);
    ob->receive_damage("kee", 10);
    ob->receive_damage("sen", 10);
    return 1;
  }

  ob->add_temp("wuguan/pichai", 1);
  message_vision(
    "$N将木块放正，高举柴刀，大喝一声“开”，木块“咔”的一声被劈开了。\n", ob);
  obj = new(__DIR__ "obj/chai");
  obj->move(environment(ob));
  ob->start_busy(1);
  ob->receive_damage("kee", 5);
  return 1;
}

// 生火
int job_shenghuo(object ob, string arg) {
  object objChai;
  mapping job;

  if (!arg || (arg != "火"))
    return notify_fail("你想干什么？\n");
  if (!(job = ob->query("wuguan/job")))
    return notify_fail("你在这里干什么？想放火么！！！。\n");
  if (job["job"] != "生火")
    return notify_fail("现在又没让你生火，你到这里生什么火！！\n");
  if (ob->is_busy())
    return notify_fail("一下子把柴都添进去，会把火压灭的。\n");
  if (!(objChai = present("chai", ob)))
    return notify_fail("你都没有柴，还想生火，疯了是不是。\n");
  if (ob->query("kee") < 20)
    return notify_fail("你现在精力不能集中，小心把武馆烧着了。\n");
  if (ob->query("food") < 50)
    return notify_fail("饿着肚皮干活？可怜的花朵啊。\n");
  if (ob->query("water") < 50)
    return notify_fail("喝点水再干活吧，生火可是很热的。\n");
  if (ob->query_temp("wuguan/fire"))
    return notify_fail("你这不是正生着火呢么？\n");
  if (!ob->query_temp("wuguan/pichai"))
    return notify_fail("你好像没有去劈柴，哪来的柴火？\n");

  ob->add_temp("wuguan/pichai", -1);
  destruct(objChai);
  ob->start_busy(3);
  ob->set_temp("wuguan/fire", 1);
  call_out("over_sheng", 3, ob);
  message_vision(
    "$N拿出一根柴火在一旁引着，放到炉子里。\n", ob);
  return 1;
}

int over_sheng(object ob) {
  if (!ob) return 1;
  ob->delete_temp("wuguan/fire");
  if (random(100) < 65) {
    ob->receive_damage("kee", 15);
    message_vision(
      "$N费了半天劲，脸被烟熏的像个大花猫，但却没把火生着。\n", ob);
    return 1;
  }

  message_vision(
    "但见" + HIR "火苗" NOR + "越生越旺，$N拿起吹火棍加紧吹了几下，终于把火生着了。\n", ob);
  ob->receive_damage("kee", 20);
  return give_gifts(ob);
}

// 整理书架
int job_zhengli(object ob, string arg) {
  mapping job;

  if (!arg || (arg != "书架"))
    return notify_fail("你要整理什么？\n");
  if (!(job = ob->query("wuguan/job")))
    return notify_fail("书架现在不需要你整理。\n");
  if (job["job"] != "整理书架")
    return notify_fail("你现在的工作不是整理书架，先把手头的活干完再说吧。\n");
  if (ob->query_temp("wuguan/cashujia"))
    return notify_fail("书已经整理好了。\n");
  if (ob->query("kee") < 20)
    return notify_fail("由于你的精力不能集中，所以书架越整越乱。\n");
  if (ob->query("food") < 50)
    return notify_fail("饿着肚皮干活？你难道是属乌龟的？\n");
  if (ob->query("water") < 50)
    return notify_fail("喝点水再干活吧，你难道是属仙人掌的？\n");
  if (ob->is_busy())
    return notify_fail("这是细活，要慢慢来。\n");

  ob->add_temp("wuguan/zhenglishujia", 1);
  if (ob->query_temp("wuguan/zhenglishujia") < 5 + random(8)) {

    ob->start_busy(1);
    ob->receive_damage("kee", 15);
    return notify_fail("你将书一本一本分门别类的放好。\n");
  }


  ob->delete_temp("wuguan/zhenglishujia");
  ob->set_temp("wuguan/cashujia", 1);
  tell_object(ob, "你将书上的灰尘拍掉，觉得现在应该把书架擦干净了。\n");
  return 1;
}

// 擦书架
int job_cashujia(object ob, string arg) {
  mapping job;

  if (!arg || (arg != "书架"))
    return notify_fail("你想擦什么？\n");
  if (!(job = ob->query("wuguan/job")))
    return notify_fail("书架现在挺干净的，不用你擦了。\n");
  if (job["job"] != "整理书架")
    return notify_fail("你现在的工作不是擦书架，先把手头的活干完再说吧。\n");
  if (!present("ma bu", ob))
    return notify_fail("你的热心让人感动，可是你的衣服也不干净，还是找块抹布来擦吧？\n");
  if (!ob->query_temp("wuguan/cashujia"))
    return notify_fail("书架里的书还放个乱七八糟，你擦个什么劲？\n");
  if (ob->query("kee") < 10)
    return notify_fail("你无法集中精力把书架擦干净。\n");
  if (ob->query("food") < 50)
    return notify_fail("饿着肚皮干活？你难道是属乌龟的？\n");
  if (ob->query("water") < 50)
    return notify_fail("喝点水再干活吧，你难道是属仙人掌的？\n");
  if (ob->is_busy())
    return notify_fail("擦那么快干什么？一点都不用心。\n");

  if (ob->query_temp("wuguan/cashujia") < 5 + random(15)) {
    ob->start_busy(1);
    ob->add_temp("wuguan/cashujia", 1);
    ob->receive_damage("kee", 5);
    return notify_fail("你拿起抹布，一下一下的擦着书架。\n");
  }

  message_vision(
    "$N费了半天劲，终于将书架擦得干干净净。$N将整好的书整整齐齐的摆放在书架里。\n", ob);

  ob->delete_temp("wuguan/cashujia");
  return give_gifts(ob);
}
// 喂马
int job_feedhorse(object ob, string arg) {
  mapping job;
  object grass;
  if (!arg || (arg != "马"))
    return notify_fail("你要喂什么？\n");
  if (!(job = ob->query("wuguan/job")))
    return notify_fail("马吃的饱饱的呢，再喂就要撑死啦。\n");
  if (job["job"] != "喂马")
    return notify_fail("你现在的工作不是喂马，先把手头的活干完再说吧。\n");
  if (ob->query_temp("wuguan/feedhorse"))
    return notify_fail("马已经喂好了。\n");
  if (!(grass = present("grass", ob)))
    return notify_fail("你拿什么喂马啊？空气？！\n");
  if (ob->query("kee") < 20)
    return notify_fail("由于你的精力不能集中，草洒的满地都是。\n");
  if (ob->query("food") < 50)
    return notify_fail("饿着肚皮干活？马要吃草，人要吃饭。\n");
  if (ob->query("water") < 50)
    return notify_fail("喝点水再干活吧，马要喝水，人也要的。\n");
  if (ob->is_busy())
    return notify_fail("别着急，草要一口一口的喂。\n");

  ob->add_temp("wuguan/weima", 1);

  if (ob->query_temp("wuguan/weima") < 5 + random(8)) {

    ob->start_busy(1);
    ob->receive_damage("kee", 10);
    grass->destruct_ob();
    return notify_fail("你将青草一口一口喂给骠骑大将军。\n");
  }

  ob->receive_damage("kee", 10);
  ob->delete_temp("wuguan/weima");
  ob->set_temp("wuguan/feedhorse", 1);
  tell_object(ob, "你将骠骑大将军喂的饱饱的，现在该给马刷刷毛啦。\n");
  return 1;
}

// 刷马
int job_shuahorse(object ob, string arg) {
  mapping job;

  if (!arg || (arg != "马"))
    return notify_fail("你想刷什么？\n");
  if (!(job = ob->query("wuguan/job")))
    return notify_fail("马身上干净的很呢，别瞎操心。\n");
  if (job["job"] != "喂马")
    return notify_fail("你现在的工作不是喂马，先把手头的活干完再说吧。\n");
  if (!present("ma shua", ob))
    return notify_fail("你的热心让人感动，可是你用什么来刷马呢？手？！\n");
  if (!ob->query_temp("wuguan/feedhorse"))
    return notify_fail("马正饿着呢，你就这样刷马，小心踹你哦。\n");
  if (ob->query("kee") < 20)
    return notify_fail("你无法集中精力把刷马。\n");
  if (ob->query("food") < 50)
    return notify_fail("饿着肚皮干活？马要吃草，人要吃饭。\n");
  if (ob->query("water") < 50)
    return notify_fail("喝点水再干活吧，马要喝水，人也要的。\n");
  if (ob->is_busy())
    return notify_fail("刷那么快干什么？一点都不用心。\n");

  if (ob->query_temp("wuguan/shuama") < 10 + random(5)) {
    if (!random(33)) {
      message_vision("$N一不小心，刷到了马的痒处，马抬起蹄子对着$N就是一脚！\n", ob);
      ob->unconcious();
      return 1;
    }
    ob->start_busy(2);
    ob->add_temp("wuguan/shuama", 1);
    ob->receive_damage("kee", 10);
    return notify_fail("你拿起马刷，细细的给马刷毛。\n");
  }

  message_vision(
    "$N费了半天劲，虽然累出了一身臭汗，终于将把马浑身上下刷的干干净净。\n", ob);
  ob->receive_damage("kee", 15);
  ob->delete_temp("wuguan/shuama");
  ob->delete_temp("wuguan/feedhorse");
  return give_gifts(ob);
}
// 要茶
int job_asktea(object ob) {
  mapping job;
  object objTea;

  if (!(job = ob->query("wuguan/job"))) {
    message_vision(CYN "小红说道：没有总管吩咐，我可不敢给你上好的茶。\n" NOR, ob);
    return 1;
  }
  if (job["job"] != "倒茶") {
    message_vision(CYN "小红眼泪汪汪：你这般劳累，我很是心痛，可没有总管吩咐，我可不敢给你上好的茶。\n" NOR, ob);
    return 1;
  }
  if (ob->query("kee") < 10) {
    message_vision(CYN "小红对$N说道：你太劳累了，就算端了茶，也会洒的，你先休息一下吧。\n" NOR, ob);
    return 1;
  }
  if (present("wulong tea", environment(ob))) {
    message_vision(CYN "小红说道：你瞎啦，没看见地上有么？\n" NOR, ob);
    return 1;
  }
  if (present("wulong tea", ob)) {
    message_vision(CYN "小红邹了邹眉，说道：你怎地如此贪心，你不是已经有了么？\n" NOR, ob);
    return 1;
  }

  message_vision(
    CYN "$N深深地作了一揖，恭敬的说道：咱们武馆来了客人，总管大人见你繁忙，让我来此替姑娘送茶。\n" NOR, ob);
  message_vision(
    CYN "小红抿嘴一笑：那就有劳你啦，给，这是刚沏好的洞顶乌龙，快拿去吧。\n" NOR, ob);
  ob->receive_damage("kee", 5);
  ob->set_temp("wuguan/tea", 1);
  ob->delete_temp("wuguan/wrong");
  objTea = new(__DIR__ "obj/wulongtea");
  objTea->move(ob);
  tell_object(ob, "你获得一杯" + YEL "乌龙茶" NOR + "。\n");
  return 1;
}

int wrong_way(object ob, string room, string dir) {
  mapping path = ([
    "huayuan": "east",
    "xiaojing5": "north",
    "shibanlu6": "east",
    "dayuan": "southup",
  ]);

  object objTea;

  if (ob->query_temp("wuguan/wrong") && dir == path[room])
    return 0;
  if (ob->query_temp("wuguan/tea")) {
    if (!ob->query_temp("wuguan/path/" + room)) {
      if (random(100) < 50) {
        message_vision(HIR "$N一个没站稳，滑了一跤，结果把乌龙茶摔到了地上。\n" NOR, ob);
        if (objTea = present("wulong tea", ob))
          destruct(objTea);
        ob->receive_damage("kee", 5);
        ob->delete_temp("wuguan/tea");
        ob->set_temp("wuguan/wrong", 1);  //限定走路方向
        ob->set_temp("wuguan/path/" + room, 1);
        if (dir == path[room])
          return 0;
      }
    }
  }

  return 1;
}

// 放茶
int job_fangcha(object ob, string arg) {
  mapping job;
  object objTea;

  if (!arg || (arg != "茶"))
    return notify_fail("你想放什么?\n");
  if (!(job = ob->query_temp("wuguan/job")))
    return notify_fail("你不能把东西放到这里。\n");
  if (job["job"] != "倒茶")
    return notify_fail("你先忙你的事去吧，这里不需要你。\n");
  if (!(objTea = present("wulong tea", ob)))
    return notify_fail("你没有乌龙茶，跑着来干什么？\n");

  ob->delete_temp("wuguan/tea");
  ob->delete_temp("wuguan/path");
  if (!objTea->query("value")) {
    message_vision(
      "管家跑过来,“啪”的扇了$N一记响亮的耳光，骂道：你这不成器的东西，竟敢偷喝，滚吧！\n", ob);
    ob->delete("wuguan");
    ob->receive_damage("sen", 50);
    ob->set("kee", 1);
    ob->move(CITY_OB("wuguan", "schoolhall"));
    destruct(objTea);
    message_vision(
      "只见$N连滚带爬的被人踢了出来，摔了个鼻清脸肿。\n", ob);
    return 1;
  }

  message_vision("$N恭恭敬敬的将一杯上好的" + YEL "乌龙茶" NOR + "放到桌上。\n", ob);
  destruct(objTea);
  ob->receive_damage("kee", 10);
  return give_gifts(ob);
}

int job_fightdizi(object ob, string arg) {
  mapping job;
  object dizi;
  int exp, unarmed;
  if (arg == "弟子")
    arg = "dizi";
  if (!arg || !objectp(dizi = present(arg, environment(ob))))
    return notify_fail("你想和谁比试？\n");
  if (!living(dizi))
    return notify_fail(dizi->name() + "已经无法战斗了。\n");
  if (!(job = ob->query("wuguan/job")))
    return notify_fail("你闲的无聊找人打架啊？\n");
  if (job["job"] != "打架")
    return notify_fail("手痒想打架？先把手头的活干完再说吧。\n");
  if (ob->query_temp("wuguan/challenge"))
    return notify_fail("加油！加油！\n");
  if (dizi->query_temp("wuguan/challenge"))
    return notify_fail("人家正和别人切磋呢，你另找他人吧！\n");
  if (dizi->is_fighting())
    return notify_fail("人家正和别人切磋呢，你另找他人吧！\n");
  if (ob->query("kee") < ob->query("max_kee") / 2)
    return notify_fail("你可要当心，拳脚无眼哦。\n");

  if (ob->is_busy())
    return notify_fail("着急打架啊？慢点嘛。\n");
  if (ob->query_temp("weapon"))
    return notify_fail("大家较量较量拳脚功夫，兵器无眼，还是不要用罢！\n");
  exp = ob->query("combat_exp") + ob->query("combat_exp") / 5;
  unarmed = ob->query_skill("unarmed", 1);
  dizi->set("kee", dizi->query("max_kee"));
  dizi->set("sen", dizi->query("max_sen"));
  dizi->set("combat_exp", exp);
  dizi->set_skill("unarmed", 5 + unarmed + random(10));
  dizi->set_skill("dodge", 5 + unarmed + random(10));


  dizi->set_temp("wuguan/challenge", 1);
  ob->set_temp("wuguan/challenge", 1);
  message_vision("$N对着$n一拱手，道：这位" + RANK_D->query_respect(ob) + "请赐教。\n", dizi, ob);
  ob->fight_ob(dizi);
  dizi->fight_ob(ob);
  call_out("check_fight", 3, ob, dizi);
  return 1;

}
int player_win(object me, object dizi) {
  message_vision("$n对$N一躬身，道：佩服佩服！\n", me, dizi);
  message_vision("$N对$n一拱手，笑道：承让！\n", me, dizi);
  dizi->delete_temp("wuguan/challenge");
  me->delete_temp("wuguan/challenge");
  me->remove_enemy(dizi);
  dizi->remove_enemy(me);
  return give_gifts(me);
}

void player_lose(object me, object dizi) {
  message_vision("$N对$n一躬身，道：佩服佩服！\n", me, dizi);
  message_vision("$N对$n一拱手，笑道：承让！\n", dizi, me);
  dizi->delete_temp("wuguan/challenge");
  me->delete_temp("wuguan/challenge");
  me->remove_enemy(dizi);
  dizi->remove_enemy(me);
}
void check_fight(object who, object dizi) {
  int my_kee, whos_kee;
  int my_max_kee, whos_max_kee;

  my_kee = dizi->query("kee");
  whos_kee = who->query("kee");
  my_max_kee = dizi->query("max_kee");
  whos_max_kee = who->query("max_kee");

  if (!present(who, environment(dizi)))
    return;
  if (!who->is_fighting()) {
    dizi->delete_temp("wuguan/challenge");
    who->delete_temp("wuguan/challenge");
    return;
  }

  if ((my_kee * 100 / my_max_kee) <= 60)
    player_win(who, dizi);
  else if ((whos_kee * 100 / whos_max_kee) <= 60)
    player_lose(who, dizi);

  if (dizi->is_fighting()) {
    remove_call_out("check_fight");
    call_out("check_fight", 2, who, dizi);
    return;
  }


}
