#include <weapon.h>

inherit STAFF;

void create() {
  set_name("马刷", ({ "ma shua", "shua" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("value", 0);
    set("material", "iron");
    set("long", "这是一把马刷，上面的硬毛都有些卷了。\n");
    set("wield_msg", "$N拿起一把$N握在手中。\n");
    set("unequip_msg", "$N将手中的$n别到腰间。\n");
  }
  init_staff(10);
  setup();
}
