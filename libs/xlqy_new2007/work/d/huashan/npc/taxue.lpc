//npc--taxue

inherit NPC;

#include <ansi.h>

void create() {
  set_name(HIW "踏雪" NOR, ({ "ta xue", "xue" }));
  set("age", 22);
  set("attitude", "peaceful");
  set("gender", "女性");
  set("title", HIC "护灯仙子" NOR);
  set("str", 30);
  set("int", 20);
  set("per", 40);
  set("con", 20);
  set("max_gin", 7000);
  set("max_kee", 7000);
  set("max_sen", 7000);
  set("combat_exp", 12000000);
  set("daoxing", 12000000);


  set("force", 14000);
  set("max_force", 14000);
  set("force_factor", 500);
  set("mana", 14000);
  set("max_mana", 14000);
  set("mana_factor", 400);
  set_skill("unarmed", 320);
  set_skill("force", 320);
  set_skill("dodge", 320);
  set_skill("parry", 320);
  set_skill("spells", 320);
  set_skill("whip", 320);
  set_skill("jueqingbian", 320);
  set_skill("moonforce", 320);
  set_skill("moonshentong", 320);
  set_skill("moondance", 320);
  set_skill("baihua-zhang", 320);
  map_skill("dodge", "moondance");
  map_skill("unarmed", "baihua-zhang");
  map_skill("force", "moonforce");
  map_skill("spells", "moonshentong");
  map_skill("whip", "jueqingbian");
  map_skill("parry", "jueqingbian");
  set_temp("apply/combat_double_damage", 4444);
  create_family("月宫", 2, "弟子");
  set_temp("moon_set", 1);
  set("chat_chance_combat", 80);
  set("chat_msg_combat", ({
    (: cast_spell, "qingwang" :),
    (: cast_spell, "shiyue" :),
    (: cast_spell, "arrow" :),
    (: perform_action, "whip", "love" :),
  }));

  setup();

  add_money("gold", 20);

  carry_object("/d/obj/cloth/luoyi")->wear();
  carry_object("/d/obj/weapon/whip/jueqingwhip")->wield();

}

void kill_ob(object ob) {
  set_temp("no_return", 1);
  set_temp("my_killer", ob);
  ::kill_ob(ob);
}

void die() {
  object ob = query_temp("my_killer");
  object deng;
  if (!(deng = present("baolian deng", ob)) && (ob->query("bld/mother") == 1)) {
    message_vision("我这里有一样宝物，就送你吧。\n" NOR, this_object());
    message_vision(HIW "踏雪" NOR + "给了$N一样东西。 \n", ob);
    message_vision("我护灯不力，该去接受惩罚！\n\n", this_object());
    deng = new("/d/huashan/obj/deng");
    deng->move(ob);
    ob->set("bld/taxue", 1);
  }

  message_vision(HIW "踏雪" NOR + "「唉」的一声叹了口气。
\n\n", this_object());
  message_vision(HIW "踏雪" NOR + "化作一股香烟而去。 \n\n", this_object());
  destruct(this_object());
}
