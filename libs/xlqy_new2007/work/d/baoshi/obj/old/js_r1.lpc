#include <ansi.h>
#include <build_gold.h>
inherit ITEM;

void build_armor(object ob, object base);
void create() {
  set_name(BLINK "" RED "红晶石" NOR, ({ "jing shi", "jingshi", "shi" }));
  set_weight(1500);
  set("no_sell", 1);
  set("unit", "颗");
  set("color", "r");  //HIR
  //  set("no_put",1);

  set("long", HIR "一颗晶莹剔透的宝石，散发出冲天的红光，传说是女娲补天石之一,也不知道什么时候落入凡间的。\n" NOR);

  setup();
}

void init() {

  add_action("do_enchase", "enchase");
  add_action("do_enchase", "inset");
  seteuid(getuid());
}

int do_enchase(string arg) {
  object in_obj;
  string item;
  string mats;
  int rd, inset_num;
  object me = this_player();
  object ob = this_object();

  if (!arg) return notify_fail("你要干什么？\n");
  if (sscanf(arg, "%s", item) != 1) return notify_fail("你要把晶石镶嵌到什么上？\n");
  if (!objectp(in_obj = present(item, me))) return notify_fail("你身上没有这样东西。\n");
  if (in_obj->query("equipped"))
    return notify_fail("你必须放下这样东西才能镶嵌晶石。\n");
  if (in_obj->query("no_zm") || in_obj->query_unique())
    return notify_fail("这件装备不能镶嵌晶石。\n");
  if (!in_obj->is_diablo_ob())
    return notify_fail("晶石蕴涵的魔力太大，这件物品承受不了!\n");
  if (in_obj->query("diablo_ob_autoloaded"))
    return notify_fail("暂时不提供自动加载物品的镶嵌!\n");

  if (!mapp(in_obj->query("armor_prop")) && !mapp(in_obj->query("weapon_prop")))
    return notify_fail("只能镶嵌在防具和武器上!\n");
  if (in_obj->is_diablo_ob() && !in_obj->query("diablo_prop/can_inset"))
    return notify_fail("这件物品属性和晶石相冲，不能镶嵌!\n");
  if (((int)me->query("potential") - (int)me->query("learned_points")) < 10000) notify_fail("潜能不足!\n");
  mats = in_obj->query("material");       //装备或武器
  inset_num = in_obj->query("inset_num");  // 嵌了几个了
  if (!inset_num) inset_num = 3;
  else inset_num = inset_num + 3;
  if (in_obj->is_diablo_ob()) {
    if (inset_num > in_obj->query("diablo_prop/can_inset"))
      return notify_fail(in_obj->query("name") + "上已经镶嵌了太多的宝石了!\n");
  } else if (inset_num > 5) return notify_fail(in_obj->query("name") + "上已经镶嵌了太多的宝石了!\n");

  if (!in_obj->query("weapon_prop/damage"))   //防具
  {

    message_vision(CYN "$N把$n" + CYN "镶嵌到" + in_obj->query("name") + CYN "上 \n" NOR, me, ob);
    tell_room(
      environment(me),
      HIR "只见" + ob->name() + HIR "化为一道红光,绕着" + in_obj->query("name") + HIR "盘旋了几圈,不见了! \n" NOR
    );

    in_obj->add("diablo_prop/armor", 64 + random(36));
    in_obj->add("diablo_prop/add_max_kee", 1200 + random(1200));
    message_vision(CYN "" + in_obj->query("name") + CYN "突然散发出冲天红光，$N心中不禁涌上一股杀气！\n" NOR, me);
    me->add("bellicosity", 10000);
    me->add("potential", -10000);
    in_obj->set_weight(in_obj->query_weight() + 1500);
    in_obj->set("inset_num", inset_num);
    in_obj->set("no_sell", 1);

    if (!in_obj->query("old_long")) in_obj->set("old_long", in_obj->query("long"));
    if (inset_num > 3)
      in_obj->set(
        "long",
        in_obj->query("old_long") + "上面嵌上了" HIW + chinese_number(inset_num - 3) + "颗宝石\n" NOR
      );
    in_obj->set("long", in_obj->query("old_long") + "上面嵌上了一颗晶石\n\n" NOR);

    in_obj->save();

    destruct(ob);
    return 1;
  } else {
    //武器
    me->add("bellicosity", 10000);
    message_vision(CYN "$N把$n" + CYN "镶嵌到" + in_obj->query("name") + CYN "上 \n" NOR, me, ob);
    tell_room(
      environment(me),
      HIR "只见" + ob->name() + HIR "化为一道红光,绕着" + in_obj->query("name") + HIR "盘旋了几圈,不见了! \n" NOR
    );
    message_vision(CYN "" + in_obj->query("name") + CYN "突然散发出冲天红光，你心中不禁涌上一股杀气！\n" NOR, me);
    in_obj->add("diablo_prop/damage", 81 + random(210));
    in_obj->add("diablo_prop/combat_blood_kee", 1200 + random(1200));


    me->add("potential", -10000);
    in_obj->set_weight(in_obj->query_weight() + 1500);
    in_obj->set("no_sell", 1);
    in_obj->set("inset_num", inset_num);

    if (!in_obj->query("old_long")) in_obj->set("old_long", in_obj->query("long"));
    if (inset_num > 3)
      in_obj->set(
        "long",
        in_obj->query("old_long") + "上面嵌上了" HIW + chinese_number(inset_num - 3) + "颗宝石\n" NOR
      );
    in_obj->set("long", in_obj->query("old_long") + "上面嵌上了一颗晶石\n\n" NOR);
    in_obj->save();

    destruct(ob);
    return 1;
  }



  return notify_fail("你镶嵌晶石失败了？\n");
}
