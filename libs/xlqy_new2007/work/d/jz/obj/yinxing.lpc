inherit ITEM;
inherit F_FOOD;

void create()
{
    set_name("银杏", ({"yin xing", "yinxing", "xing"}));
    set_weight(80);
    if (clonep())
	set_default_object(__FILE__);
    else {
	set("long","一粒银杏果。\n");
	set("unit", "颗");
	set("value", 80);
	set("food_remaining", 3);
	set("food_supply", 20);
    }
}


