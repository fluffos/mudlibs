#include <ansi.h>
inherit ROOM;
int do_cast();
void create() {
  set("short", "桃花迷阵");
  set("long", @LONG

到处都是桃树桃花，花香熏人。
LONG
  );

  set("exits", ([
    "east": __DIR__ "maze",
    "west": __DIR__ "maze",
    "south": __DIR__ "maze",
    "north": __DIR__ "maze",
    "northeast": __DIR__ "maze",
    "northwest": __DIR__ "maze",
    "southwest": __DIR__ "maze",
    "southeast": __DIR__ "maze",

  ]));




  setup();
}
void init() {
  if (interactive(this_player())) {
    remove_call_out("check_hp");
    call_out("check_hp", 3, this_player());
  }
  add_action("do_cast", "cast");

}
int do_cast() {
  object who = this_player();
  message_vision(HIM "$N嘛啦哄啦的念了几句咒文，却被漫天花瓣所淹没。\n" NOR, who);
  return 1;

}
int check_hp(object who) {
  object where = this_object();
  if ((!who) || (!present(who, where))) return 1;
  if (random(6) > 3) {
    who->add("sen", -(169 + random(39)));
    message_vision(HIM "\n一阵微风吹来，乱花迷人眼，花香熏人醉。\n" NOR, who);
    who->start_busy(random(3));
    COMBAT_D->report_sen_status(who);
  }
  if ((100 * (who->query("sen"))) / (who->query("max_sen")) <= 10) {
    message_vision(HIG "$N被花香熏的喘不过气来，再也支撑不住了。\n" NOR, who);
    who->delete_temp("last_damage_from");
    who->set_temp("death_msg", "淹没在漫天花海中。\n");
    who->die();
    who->save();
    return 1;
  }
  remove_call_out("check_hp");
  call_out("check_hp", 3, who);
  return 1;
}
