#include <ansi.h>
inherit NPC;
inherit F_MASTER;
int ask_love();
string skill_lvl();
int improve(string arg);
void create()
{
       set_name(HIM"紫霞仙子"NOR, ({"zixia xianzi", "zixia", "xianzi","master"}));
       set("long", "她就是盘丝洞的开山祖师,传说她是佛祖的一棵灯芯。随佛祖修道悟
真,后来思凡下界占了花果山一处洞府,开山立派,传授门徒。\n");
       set("title", HIB"盘丝大仙"NOR);
       set("gender", "女性");
       set("age", 20);
       set("class","xian");
       set("attitude", "friendly");
       set("rank_info/respect", "小姑娘");
       set("cor", 30);
       set("per", 40);
       set("max_kee", 4500);
       set("max_gin", 800);
       set("max_sen", 4500);
       set("force", 5000);
       set("max_force", 3000);
       set("force_factor", 125);
       set("max_mana", 2500);
       set("mana", 5000);
       set("mana_factor", 250);
       set("combat_exp", 3000000);
	   set("daoxing", 4000000);
       set_skill("literate", MAX_SKILL_LEVEL-20);
	   set_skill("unarmed", MAX_SKILL_LEVEL);
	   set_skill("dodge", MAX_SKILL_LEVEL);
	   set_skill("force", MAX_SKILL_LEVEL+20);
	   set_skill("parry", MAX_SKILL_LEVEL);
	   set_skill("sword", MAX_SKILL_LEVEL);
	   set_skill("spells", MAX_SKILL_LEVEL);
	   set_skill("whip", MAX_SKILL_LEVEL+20);
	   set_skill("pansi-dafa", MAX_SKILL_LEVEL+20);
	   set_skill("lanhua-shou", MAX_SKILL_LEVEL);
	   set_skill("jiuyin-xinjing", MAX_SKILL_LEVEL);
	   set_skill("chixin-jian", MAX_SKILL_LEVEL);
	   set_skill("qin", MAX_SKILL_LEVEL);
	   set_skill("yueying-wubu", MAX_SKILL_LEVEL);
	   set_skill("yinsuo-jinling", MAX_SKILL_LEVEL);
	   map_skill("spells", "pansi-dafa");
   map_skill("unarmed", "lanhua-shou");
   map_skill("force", "jiuyin-xinjing");
   map_skill("sword", "chixin-jian");
   map_skill("parry", "yinsuo-jinling");
   map_skill("dodge", "yueying-wubu");
   map_skill("whip", "yinsuo-jinling");
   set("chat_chance_combat", 50);
        set("chat_msg_combat", ({
                (: cast_spell, "wuzhishan" :),
                (: cast_spell, "ziqi" :)
        }) );
   set("inquiry", ([
          "爱神" : (: ask_love :),
               "技能升级": (: skill_lvl :),
]));
create_family("盘丝洞", 1, "红");
setup();

        carry_object("/d/obj/cloth/tianyi.c")->wear();
        carry_object("/d/pansi/obj/ziqing.c")->wield();
         carry_object("/d/pansi/obj/baohe.c");
        carry_object("/d/ourhome/obj/shoes")->wear();
}
void init()
{
	add_action("do_improve","upgrade");	
}
void attempt_apprentice(object ob)
{

   if ( (string)ob->query("family/family_name")=="盘丝洞") {
   if (((int)ob->query("combat_exp") < 1000000 )) {
   command("say " + RANK_D->query_respect(ob) +
"的道行不够高深，有些绝学秘法恐怕难以领悟。\n");
   return;
   }
        command("pat "+ob->query("id"));
        command("say 好，希望" + RANK_D->query_respect(ob) +
"多加努力，他日帮我杀了那个臭猴子。\n");
       command("recruit " + ob->query("id") );
	   ob->set("title", "花果山盘丝大仙护法");
	   ob->set("class", "xian");
   return;
   }
   command("shake");
   command("say " + RANK_D->query_respect(ob) +
"还是先去学些基础功夫吧。\n");
        return;
}
int accept_fight(object me)
{
   return 0;
}

int ask_love()
{
        object ob=this_player();
        if(ob->query("family/family_name") != "盘丝洞")
        {
        command("say 你又不是盘丝洞的，学它做什么?");
        return 1;
        }
        if(ob->query("family/master_name")!= this_object()->query("name"))
        {
        command("say 你又不是我的徒弟，谁管你！");
        return 1;
        }
        if(!ob->query("pansi/love_master"))
        {
        ob->set("pansi/love_master",1);
        command("say 这一招爱神，是为师多年修炼所悟，应该可以帮你保命的！");
        ob->set("pansi/ask_zixia_go", 1);
        return 1;
	} else
	{
        command("say 这一招爱神，我不是已经传给你了吗?");
        return 1;
	}
}
string skill_lvl()
{
	object me=this_player();
	if ( (string)me->query("family/family_name")!="盘丝洞")
	{
	      return ("你不是本门的人啊，我怎么能随便教你！");	
	  	
	}
	message_vision(CYN"$N对$n说：我可以将轻功(dodge)、鞭法(whip)、剑法(sword)、音律乐理(music)和法术(spells)升级到专家(expert)和大师(master)，拳法(unarmed)升级到专家(expert)。\n用(upgrade xxx for xxx)来升级(xxx分别为技能和等级的英文名)。\n"NOR,this_object(),me);
	
	me->set_temp("skill_improve/asked",1);
	return ("不过，专家需要你给我100两黄金，大师则需要500两，你看如何？");
}
int do_improve(string arg)
{
	string what,lvl;
	object me;
	int count;
	me=this_player();
	count=me->query("betray/count");
	if ( (string)me->query("family/family_name")!="盘丝洞")
	{
	      return 0;	
	  	
	}
	if(!me->query_temp("skill_improve/asked"))
	 return 0;	
	
	 if(!arg)
	  return notify_fail("格式如下：upgrade 技能名 for 等级名! \n");
	 sscanf(arg,"%s for %s",what,lvl);
	 if(!what)
	  return notify_fail("格式如下：upgrade 技能名 for 等级名 !\n");
	 if(!lvl)
 		return notify_fail("格式如下：upgrade 技能名 for 等级名 !\n");
	if(what!="sword"&&what!="spells"&&what!="unarmed"&&what!="whip"&&what!="dodge"&&what!="music")
	 	return notify_fail("目前只提供轻功(dodge)、鞭法(whip)、剑法(sword)、法术(spells)、音律乐理(music)和拳法(unarmed)的升级! \n");
	if(lvl!="expert"&&lvl!="master")
	    return notify_fail("目前只能升级到专家(expert)或者大师(master)! \n");
	 if(me->query_ob_skill_level(what)=="grandmaster")
	 return notify_fail("你达到宗师境界，还来升什么！\n");
	if(me->query_ob_skill_level(what)==lvl)
	 return notify_fail("你已经是这项技能的"+lvl+"了！\n");
	if(what=="unarmed"&&lvl!="expert")
	  return notify_fail("我只能升级拳法到专家！\n");	 
	if(!me->query_ob_skill_level(what)&&lvl=="master")
	      return notify_fail("你现在连专家都不是呢！\n");
	if((int)me->query_skill(what,1)<100&&lvl=="expert")
		 return notify_fail("专家要求你达到100级的技能！\n");
	if((int)me->query_skill(what,1)<200&&lvl=="master")
		 return notify_fail("大师要求你达到200级的技能！\n");
	
 	if(me->query_ob_skill_level(what)=="master"&&lvl=="expert")
	 return notify_fail("你要将大师技能升成专家？？！\n");
	if(!LEVEL_D->check_ob_for_level(me,lvl))
		return notify_fail("你对本门的贡献似乎不够啊。。\n");
	 if(!me->query_temp("skill_improve/paid"))
	 return notify_fail("专家需要100两黄金，大师则需要500两!\n");
	
	if(me->query_temp("skill_improve/paid")<1000000&&lvl=="expert")
	   return notify_fail("你给的黄金似乎不够啊!\n");
	 if(me->query_temp("skill_improve/paid")<5000000&&lvl=="master")
	   return notify_fail("你给的黄金似乎不够啊!\n");
	
	
	me->set("skill_level/"+what,lvl);
	if(lvl=="expert") lvl="专家";
	else lvl="大师";
	switch(what)
	{
		
		case "sword" :
			what="剑法";
			break;
		case "spells" :
			what="法术";
			break;
		case "unarmed" :
			what="拳法";
			break;
		case "dodge" :
			what="轻功";
			break;
		case "whip" :
			what="鞭法";
			break;
		case "music":
			what="音律乐理(music)";			
			break;
	}
	tell_object(me,"恭喜你，你的"+what+"已经升级为"+lvl+"!\n");	
	
	me->delete_temp("skill_improve/paid");
	return 1;
 		
 		
}
int accept_object(object who, object ob)
{	
	int value = ob->value();
	if(!who->query_temp("skill_improve/asked"))
		return 0;
	
  
	  if (value == 0)
	  {
	    message_vision (CYN"$N说道：你给我这个干什么？\n"NOR,this_object());
	   return 0;
	  }
	  who->add_temp("skill_improve/paid",value);
	  return 1;
	  
}

