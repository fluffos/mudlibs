#include <ansi.h>
inherit NPC;
void greeting();
int do_anmo();
int end_anmo(object who);
void create() {
  object cloth;

  set_name(HIY "和服女子" NOR, ({ "girl" }));
  set("gender", "女性");
  set("combat_exp", 2000);
  set("age", 18);
  set("per", 21);
  set("attitude", "friendly");
  set("shen_type", 1);
  set_skill("unarmed", 200);

  set("inquiry", ([
    "按摩": CYN "本点。。星开业。。免汇。。为达家。。服务(anmo)。" NOR,
    "here": CYN "这里。。丝。。按摩番。。你。。需要服务嘛？" NOR,
    "name": CYN "嗯。。呃。。我。。叫。凉子。" NOR,

  ]));

  setup();
  cloth = carry_object("/d/obj/cloth/skirt");
  cloth->set("name", HIW "和服" NOR);
  cloth->set("id", "cloth");
  cloth->set("unit", "件");
  cloth->wear();

}
void init() {
  add_action("do_anmo", "anmo");
  call_out("greeting", 1);
}
void greeting() {
  object who = this_player();
  if (!who || environment() != environment(who))
    return;
  if (!userp(who)) return;
  message_vision(CYN "和服女子说道：欢。。应。光临。酷达洒一\n" NOR, who);

}

int do_anmo() {
  object me, who;
  int wait;
  me = this_object();
  who = this_player();
  if (me->query_temp("hotel/anmo")) {

    tell_object(who, HIW "有人正在....等着吧！\n" NOR);
    return 1;
  }
  if (who->query("real_age") > 17) {
    tell_object(who, HIW "呃..你又和小孩子抢糖吃了...\n" NOR);
    return 1;
  }
  if (time() - who->query("hotel/anmotime") < 300) {
    tell_object(who, "哇，你怎么又来按摩了，腐败啊腐败啊。。\n" NOR);
    return 1;
  }
  //         me->set_temp("hotel/anmo",1);

  who->set("hotel/anmotime", time());
  //    this_object()->disable_player("<※按摩中※>"); 

  message_vision("$N在塌塌米上躺了下来。\n", who);
  message_vision(HIY "一位身穿和服的女子走了过来，深鞠一躬，跪坐在$N身边，开始给$N按摩。\n" NOR, who);
  tell_object(who, HIW "温柔的小手轻轻的揉捏着你身上的每一块肌肉，你身上的疲劳顿消，舒服的直想唤娘。\n" NOR);
  message_vision(HIR "幽香的空气，清雅的古筝，温柔的抚摸。。。$N渐渐进入梦乡。\n" NOR, who);

  who->disable_player("<睡梦中>");
  who->set_temp("block_msg/all", 1);
  who->set_temp("mark/sleep_in_bed", 1);

  //	 remove_call_out("end_anmo");
  //	 call_out("end_anmo",40-random(me->query("cps")),me);
  wait = 40 - random(who->query("cps"));
  who->start_call_out((: call_other, __FILE__, "end_anmo", who :), wait);
  return 1;
}
int end_anmo(object who) {

  int kee, sen;
  if (!who) return 1;
  kee = (int)who->query("max_kee");
  sen = (int)who->query("max_sen");

  who->delete_temp("no_move");

  if (who->is_busy()) who->start_busy(1);

  while (environment(who)->is_character())
    who->move(environment(environment()));
  who->enable_player();
  //	this_object()->enable_player();

  who->set("kee", kee);
  who->set("sen", sen);
  who->set("eff_sen", sen);
  who->set("eff_kee", kee);

  who->set("food", 0);
  who->delete_temp("block_msg/all");
  who->delete_temp("mark/sleep_in_bed");
  //      this_object()->delete_temp("hotel/anmo");
  who->start_busy(2);
  tell_object(who, "你从睡梦中醒了过来。觉得全身疲劳尽去，神清气爽。不过。。似乎肚子有点咕咕叫了。\n");
  tell_room(environment(who), who->query("name") + "从睡梦中醒了过来，擦了擦嘴角流下的哈喇子，伸了个懒腰。\n", who);

}
