#include <ansi.h>
inherit ROOM;

void check_trigger();
void on_board();
void arrive();
void close_passage();
int do_zuo(string arg);
int do_dive();
void reset();
int do_yell(string arg);

void create() {
  set("short", "东海之滨");
  set("long", @LONG

面前便是东海，茫茫大海望不到边际。海面上波涛汹涌，几丈
高的浪头此起彼伏，象是要吞灭一切敢于到海上的东西。也许
这里便是路的尽头，面前的大海对一个凡人来说是不可逾越的。
LONG);

  set("objects", ([
    __DIR__ "npc/jingwei": 1,
  ]));

  set("exits", ([ /* sizeof() == 1 */
    "west": __DIR__ "seashore2",
    "north": "/d/quest/guandao4",
  ]));
  set("outdoors", 1);

  setup();
}

void init() {
  add_action("do_dive", "dive");
  add_action("do_yell", "yell");
}
int do_yell(string arg) {
  object me;
  object room;
  me = this_player();
  if (!me->query("passsea/pass_sea"))
    return 0;
  if (!arg)
    return notify_fail("你要喊什么？\n");
  if (arg != "过海")
    return notify_fail("你要喊什么？\n");
  if (me->is_busy()) {
    tell_object(me, "你现在正忙着呢！\n");
    return 1;
  }
  message_vision(HIW "$N气运丹田，纵声喊到：船家，我要过海！\n" NOR, me);
  message_vision(HIC "一叶轻舟破浪而来。渔夫笑道：是你啊，我这就送你过海。\n" NOR, me);

  if (!(room = find_object("/d/changan/aolaiws")))
    room = load_object("/d/changan/aolaiws");
  message_vision(HIY "渔夫带着$N上船。刹那间，轻舟已过汪洋大海。\n" NOR, me);
  me->move(room);
  return 1;

}

int do_dive() {
  object me, zhou;
  object ridee;
  me = this_player();
  ridee = me->ride();

  if (me->is_busy()) return notify_fail("你正忙着呢!\n");

  if ((!(zhou = present("bishui zhou", me))
    || (string)zhou->query("unit") != "张")
    && (string)me->query("family/family_name") != "龙宫"
    && (string)me->query("family/family_name") != "东海龙宫")

    return notify_fail("你一个猛子扎到水里．．．\n" +
      "\n但没多会儿就被憋得半死，只好赶紧爬上岸来。\n");
  me->start_busy(1);

  if (ridee && ridee->query("under_water")) {
    message_vision(HIY "$N一拍$n的头，连人带马跃入水中。\n" NOR, me, ridee);
    ridee->move("/d/sea/under1");
  }

  else message_vision(HIY "$N一个猛子扎到水中，然后不见了．\n" NOR, me);
  me->move("/d/sea/under1");
  message_vision("$N潜了过来。\n", me);
  return 1;
}

void reset() {
  object room;

  ::reset();

}
