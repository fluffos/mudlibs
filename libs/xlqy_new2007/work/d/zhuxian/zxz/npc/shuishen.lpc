inherit NPC;
#include <ansi.h>
int do_daodao();
void create()
{
  set_name("水神", ({"shui shen", "shuishen", "shen"}));
  set("gender", "女性");
  set("attitude", "aggressive");
  set("combat_exp", 13000000+random(3000000));
  set("daoxing", 13330000);
  create_family("东海龙宫", 2, "弟子");
  set("title","截教门人");  

  set("age", 2000);
  set("per", 30);
  set("str", 40);
  set("int", 30);
  set("cor", 40);
  set("cps", 40);
  set("con", 30);
  set("kar",30);
  set("spi",30);
  set("max_kee", 18000);
  set("max_sen", 18000);
  set("force", 18000);
  set("max_force", 6000+random(2000));
  set("max_mana", 6000+random(2000));
  set("mana",12000+random(4000));
  set("mana_factor",300+random(100));  
  set("force_factor",300+random(100)); 
  set("bellicosity",500);
  set("no_arrest",1);
  
  set_skill("literate", 400+random(100));   
  set_skill("spells", 400+random(100));
  set_skill("force", 400+random(100));
  set_skill("unarmed", 400+random(100));
  set_skill("parry", 400+random(100));
  set_skill("dodge", 400+random(100));
  set_skill("fork", 400+random(100));
  
  set_skill("seashentong", 400+random(100));  
  set_skill("dragonforce", 400+random(100));  
  set_skill("dragonfight", 400+random(100));
  set_skill("dragonstep", 400+random(100));
  set_skill("fengbo-cha", 400+random(100));
  
  map_skill("dodge", "dragonstep");
  map_skill("unarmed", "dragonfight");
  map_skill("spells", "seashentong");
  map_skill("force", "dragonforce");
  map_skill("fork", "fengbo-cha");
  map_skill("parry", "fengbo-cha");
  
         set("chat_chance_combat", 88);
         set("chat_msg_combat", ({
        (: exert_function, "zhenshen" :),         	
        (: perform_action, "unarmed", "sheshen" :),
        (: perform_action, "fork", "fengbo" :),
        (: do_daodao :),
       }));
        set_temp("apply/armor", 640);
        set_temp("apply/damage",180);
        set_temp("apply/armor_vs_force",300);
        set_temp("apply/defense", 120);
        set_temp("apply/strength",150);
         set_temp("combat/bless",3+random(7));
	    set_temp("combat/lucky",3+random(7));
        
       set("skill_level/fork","grandmaster");
       set_temp("apply/combat_double_damage",5000);

        set_weight(1000000);
        setup();
        if( random(3) )
        	carry_object("/d/npc/obj/fork")->wield();
        carry_object("/d/npc/obj/armor")->wear();        
}

void kill_ob (object ob)
{
  object me = this_object();
  object jiaozhu;
  object where = environment (me);
  
  jiaozhu = present ("tongtian jiaozhu", where);

  if (me->query("no_move"))
  	me->delete_temp("no_move");
  if (me->query("kee") < me->query("eff_kee")-500)
  	command("exert recover");	
  set_temp("my_killer",ob);
  ::kill_ob(ob);
  
  if (jiaozhu && !jiaozhu->is_fighting() )
    jiaozhu->kill_ob(ob);

}

// tomcat mod
void die()
{
    object ob = query_temp("my_killer");
    object baoshi;
    
    if(ob)
    {
	ob->add_temp("mark/zhuxian", 3);
	ob->add("faith",1+random(3));
//	ob->add("weiwang",1+random(5));
	if( random(2) )
	{
		switch( random(5) )
		{		
	    		case 0:
	    			baoshi = new("/d/baoshi/obj/no_r"); 
	    			break;
	    		case 1:
	    			baoshi = new("/d/baoshi/obj/no_c"); 
	    			break;
	    		case 2:
	    			baoshi = new("/d/baoshi/obj/no_g"); 
	    			break;
	    		case 3:
	    			baoshi = new("/d/baoshi/obj/no_b"); 
	    			break;
	    		case 4:
	    			if( random(ob->query("combat_exp")) > 6000000 )
	    				baoshi = new("/d/baoshi/obj/no_y"); 
	    			else
	    				baoshi = new("/d/baoshi/obj/no_b");
				break;
		}		
		baoshi->move(ob);
		message("channel:rumor",RED+"【谣言】某人："+ob->query("name")+"拿到了一块闪闪发亮的"
			+baoshi->query("name")+" \n"+NOR,users() );
	}
    }
    
    message_vision(HIM"$N大喝一声：我去也。\n"NOR,this_object());
    destruct(this_object());
    return;
}

int do_daodao()
{
	
	object me = this_object();
	me->command("perform fengbo");
	me->command("unwield fork");
	me->command("perform sheshen");
	me->command("wield fork");

	return 1;

}