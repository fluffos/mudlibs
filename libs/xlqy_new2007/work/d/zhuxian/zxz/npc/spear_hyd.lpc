inherit NPC;
#include <ansi.h>

void create()
{
  set_name("魔将", ({"mo jiang", "jiang", "mo"}));
  set("gender", "男性");
  set("attitude", "aggressive");
  set("combat_exp", 15000000+random(5000000));
  set("daoxing", 20000000);
  create_family("火云洞", 2, "弟子");
  set("title","五岳神枪");  

  set("age", 2000);
  set("per", 30);
  set("str", 40);
  set("int", 30);
  set("cor", 40);
  set("cps", 40);
  set("con", 30);
  set("kar",30);
  set("spi",30);
  set("max_kee", 20000);
  set("max_sen", 20000);
  set("force", 20000);
  set("max_force", 10000);
  set("max_mana", 8000);
  set("mana",16000);
  set("mana_factor",400);  
  set("force_factor",400); 
  set("bellicosity",500);
  
  set_skill("literate",300);   
  set_skill("spells", 500);
  set_skill("force", 500);
  set_skill("unarmed", 500);
  set_skill("parry", 500);
  set_skill("dodge", 500);
  set_skill("spear", 500);
  
  set_skill("huomoforce", 500);  
  set_skill("pingtian-dafa", 500);  
  set_skill("moshenbu", 500);
  set_skill("moyun-shou", 500);
  set_skill("wuyue-spear", 520);
  
  map_skill("dodge", "moshenbu");
  map_skill("unarmed", "moyun-shou");
  map_skill("spells", "pingtian-dafa");
  map_skill("force", "huomoforce");
  map_skill("spear", "wuyue-spear");
  map_skill("parry", "wuyue-spear");
  
         set("chat_chance_combat", 60);
         set("chat_msg_combat", ({
        (: cast_spell, "sanmei" :),
        (: perform_action, "spear", "buhui" :),
        (: perform_action, "spear", "fengchan" :),        
        (: perform_action, "unarmed", "zhangxinlei" :),      
       }));
        set_temp("apply/armor", 300);
        set_temp("apply/damage",200);
        set_temp("apply/armor_vs_force",300);
        set_temp("apply/defense", 240);
        set_temp("apply/strength",240);
        set_weight(1000000);
        setup();
 
       	carry_object("/d/npc/obj/spear")->wield();
        carry_object("/d/npc/obj/armor")->wear();        
}

void kill_ob (object ob)
{
  object me = this_object();
  
  if (me->query("no_move"))
  	me->delete_temp("no_move");
  if (me->query("kee") < me->query("eff_kee")-500)
  	command("exert recover");
  set_temp("my_killer",ob);
  ::kill_ob(ob);
}

// tomcat mod
void die()
{
    object ob = query_temp("my_killer");
    object baoshi;
    
    if(ob)
    {
	ob->add_temp("mark/wanxian", 1);

	switch( random(6) )
	{		
	    case 0:
	       	baoshi = new("/d/obj/drug/dan"); 
	       	baoshi->move(ob);
	       	message("channel:rumor",RED+"【谣言】某人："+ob->query("name")+"得到了一颗百年难求的"
			+baoshi->query("name")+" \n"+NOR,users() );
	    	break;
	    case 1:
	    case 2:
	    case 3:
	    case 4:
	    	break;
	    case 5:
	    	baoshi = new("/d/city/obj/xjdan"); 
	       	baoshi->move(ob);
	       	message("channel:rumor",RED+"【谣言】某人："+ob->query("name")+"得到了一颗行军打仗必备良药"
			+baoshi->query("name")+" \n"+NOR,users() );
		break;
	}		
    }
    
    message_vision(HIM"$N大喝一声：我去也。\n"NOR,this_object());
    destruct(this_object());
    return;
}
