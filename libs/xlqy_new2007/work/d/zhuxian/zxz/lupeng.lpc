inherit ROOM;
#include "bancast.h"
#include <ansi.h>

void create() {
  set("short", "芦篷");
  set("long", @LONG   
只见燃灯结彩，叠锦铺毹，正是掌教师尊栖身之所。
LONG);
  set("exits", ([
    "out": "/d/zhuxian/gate",
    "north": "/d/zhuxian/zxz/wxz",
  ]));
  set("objects", ([
    "/d/zhuxian/npc/ystz": 1,
  ]));
  set("no_burn", 1);
  setup();
}

void init() {
  add_action("do_quit", ({ "quit", "kill", "steal" })); add_action("do_sleep", "sleep");
  add_action("do_ji", banned_action);
  add_action("do_cast", ({ "cast", "burn" }));
}

int valid_leave(object me, string dir) {
  object a;
  if (dir == "north")
    return notify_fail(HIR "  Stop！ 万仙阵  不要乱闯！\n" NOR);

  return ::valid_leave(me, dir);
}
