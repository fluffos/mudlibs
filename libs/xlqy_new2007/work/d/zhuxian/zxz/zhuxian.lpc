inherit ROOM;
#include "bancast.h"

void create() {
  set("short", "诛仙门");
  set("long", @LONG   
此乃“诛仙门”，门上挂一口宝剑，名曰：“诛仙剑”。
‘诛戳陷绝   死生在我    自倚才能   有来无回’ 
LONG);
  set("exits", ([
    "west": __DIR__ "zhuxian1",
    "east": __DIR__ "zhuxian",
    "north": __DIR__ "zhuxian",
    "south": __DIR__ "zhuxian",
  ]));
  set("objects", ([
    __DIR__ "npc/guard": 2,
  ]));
  set("no_burn", 1);
  set("no_alert", 1);
  setup();
}

void init() {
  add_action("do_quit", "quit");
  add_action("do_sleep", "sleep");
  add_action("do_ji", banned_action);
  add_action("do_cast", "cast");
  //  add_action("do_burn", "burn");
}

int valid_leave(object me, string dir) {
  object a;
  if (dir == "west") {
    if (objectp(a = present("guard", environment(me))) && living(a))
      return notify_fail("守卫拦住你说道：想进阵先过了我这一关！\n");
  }
  return ::valid_leave(me, dir);
}
