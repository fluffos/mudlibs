inherit ROOM;                                                        
#include "bancast.h"

void create ()
{
  set ("short", "绝仙门" );   
  set ("long", @LONG   
此乃“绝仙门”，门上挂一口宝剑，名曰：“绝仙剑”。
‘诛戳陷绝   死生在我    自倚才能   有来无回’ 
LONG);
    set("exits", ([ 
               "west" : __DIR__"juexian",
               "east" : __DIR__"juexian",
               "north" : __DIR__"juexian",
               "south" : __DIR__"juexian1",
                  ]));
    set("objects", ([ 
               __DIR__"npc/guard" : 2,
                  ]));
                   set("no_burn",1);
                   set("no_alert",1);
    setup();
}

void init() 
{
  add_action("do_quit", "quit");  add_action("do_sleep", "sleep");
  add_action("do_ji", banned_action);
  add_action("do_cast",({"cast","burn"}));
}

int valid_leave(object me, string dir)
{
        object a;
   if (dir == "south" ) {
                if(objectp(a=present("guard", environment(me))) && living(a) )
        return notify_fail("守卫拦住你说道：想进阵先过了我这一关！\n");
        }   
        return ::valid_leave(me, dir);
}
