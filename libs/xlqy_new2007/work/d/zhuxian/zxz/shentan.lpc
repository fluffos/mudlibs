inherit ROOM;
#include <ansi.h>
#include <room.h>
#include "bancast.h"

void create ()
{
  set ("short", "神坛" );   
  set ("long", @LONG   
腾腾黄雾，艳艳金光；腾腾黄雾，诛仙阵内似云迷；
艳艳金光，八卦台前如气罩。
剑戟戈矛，浑如铁桶；东西南北，恰似铜墙。
此正是截教神仙施法力，通天教主显神通；
晃眼迷天遮日月，摇风扇火憾江山。
LONG);
    set("exits", ([ 
               "down" : __DIR__"center",
               "up" : __DIR__"lupeng",
                  ]));
    set("objects", ([ 
		"/d/zhuxian/zxz/npc/fengshen" : 1,
		"/d/zhuxian/zxz/npc/huoshen" : 1,
		"/d/zhuxian/zxz/npc/shuishen" : 1,
		"/d/zhuxian/zxz/npc/xueshen" : 1,
		"/d/zhuxian/zxz/npc/ttjz" : 1,
                  ]));
    set("no_burn",1);
    set("no_alert",1);
    setup();
}

void init() 
{
  object ob;
  
  add_action("do_quit", "quit");  add_action("do_sleep", "sleep");
  add_action("do_ji", banned_action);
  add_action("do_cast",({"cast","burn"}));

}

int valid_leave(object me, string dir)
{
        object a;
   if (dir) {
   	if(objectp(a=present("shen", environment(me))) && living(a) )
        	return notify_fail("通天教主门下神将一把拦住了你! \n");
       	if(objectp(a=present("tongtian jiaozhu", environment(me))) && living(a) )
        	return notify_fail("通天教主一把拦住你道：现在想跑没那么容易？ \n");
        }   
        return ::valid_leave(me, dir);
}
