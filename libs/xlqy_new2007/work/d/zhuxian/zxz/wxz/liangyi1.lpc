void init() {
  object *inv;
  int count, flag;
  object where = this_object();

  add_action("do_quit", "quit"); add_action("do_sleep", "sleep");
  add_action("do_ji", banned_action);
  add_action("do_cast", ({ "cast", "burn" }));
  add_action("do_pfm", "perform");
  add_action("do_perform", ({ "exert", "perform", "cast" }));

  choose_master();
}
int do_perform() {
  int ra;
  object me = this_player();
  if (!userp(me)) return 0;
  ra = check_wxz();

  //2 ,1/8,
  //      3,2/8,1/8
  //,4,3/10,2/10,1/10,
  //5 ,4/13,3/13,2/13,1/13,
  //6,7/16,
  //7 ,6/21
  //8,7/24
  //9,8/27
  printf("the ra is %d\n", ra);
  if (ra > 1 && !random(8)) {
    tell_object(me, HIR + query("wxz_name") + HIY "使得你无法施展绝技！\n" NOR);
    if (!me->is_busy()) me->start_busy(1);
    return 1;
  }
  return 0;

}
void check_exit() {
  int count;
  object me = this_player();
  count = check_wxz();
  if (count > 1)
    return;
  tell_room(this_object(), query("wxz_name") + HIC "已破，众人只见眼前金光一闪，已然出现一个出口。\n" NOR);
  if (query("true_exit"))
    set("exits", ([
      "out": __DIR__ "sancai",
    ]));
  else
    set("exits", ([
      "out": __DIR__ "liangyi",
    ]));


}
