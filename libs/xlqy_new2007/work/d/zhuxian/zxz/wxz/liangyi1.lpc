LONG);
  set("objects", ([
    __DIR__ "npc/mojiang": 2,
  ]));
  set("no_burn", 1);
  set("no_alert", 1);
  set("wxz_level", 2);
  set("wxz_master", 1);
  set("wxz_name", HIR "两仪大阵" NOR);

  setup();
