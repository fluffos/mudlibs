void init() {
  object ob = this_player();
  object me = this_object();

  if (living(ob))
    call_out("greeting", 1, ob);
}

void greeting(object ob) {
  if (!ob || environment(ob) != environment()) return;
  if (ob && interactive(ob) && !wizardp(ob)) {
    if (!ob->query_temp("mobing_kill"))
      message_vision("$N喝道：狂妄小子，擅闯诛仙阵！\n", this_object());
    this_object()->kill_ob(ob);
    ob->set_temp("mobing_kill", 1);
  }
}

void kill_ob(object ob) {
  set_temp("my_killer", ob);
  ::kill_ob(ob);
}

// tomcat mod
void die() {
  object dan;
  object ob = query_temp("my_killer");

  if (ob) {
    ob->add_temp("mark/wxz", 1);

  }


  if (environment()) {
    message_vision("$N起个云头，将身一纵跳在半空，一拱手道：你家大爷我这就去也！。\n", this_object());
    if (random(2)) {
      dan = new("/d/city/obj/xjdan");
      message("vision", "一阵狂风刮过，你突然发现地上多了一样东西。\n", environment());
      dan->move(environment(this_object()));
    }
    environment()->check_exit();

  }
  destruct(this_object());
  return;
}
varargs int receive_damage(string type, int damage, mixed who, string d_type) {
  int level, count;
  if (!environment()) return 0;
  level = environment()->query("wxz_level");
  count = environment()->check_wxz();
  if (level == count) {
    if (query("master_wxz")) {
      message_vision(
        environment()->query("wxz_name") + HIW "阵法轮转，保护$N不受任何伤害！\n" NOR,
        this_object()
      );
      damage = 0;
    } else damage = damage / count;
  }
  return ::receive_damage(type, damage, who, d_type);
}
varargs int receive_wound(string type, int damage, mixed who, string d_type) {
  int level, count;
  if (!environment()) return 0;
  level = environment()->query("wxz_level");
  count = environment()->check_wxz();
  if (level == count) {
    if (query("master_wxz")) {
      // 	 	message_vision(environment()->query("wxz_name")+"阵法轮转，保护$N不受任何伤害！\n",this_object());
      damage = 0;
    } else damage = damage / count;
  }

  return ::receive_wound(type, damage, who, d_type);

}
