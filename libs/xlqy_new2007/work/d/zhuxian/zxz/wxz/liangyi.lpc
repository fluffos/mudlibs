void init() 
{
	object rooma,roomb;
	object me = this_player();
	
	 add_action("do_quit", "quit");
  add_action("do_sleep", "sleep");
  add_action("do_ji", banned_action);
  add_action("do_cast", "cast");
  add_action("do_pfm", "perform");
  if(query("set_exit"))
  {
	  if( !(rooma = find_object(__DIR__"liangyi1")) )
	          rooma = load_object(__DIR__"liangyi1");
	  if( !(roomb = find_object(__DIR__"liangyi2")) )
	          roomb = load_object(__DIR__"liangyi2");
	  if( rooma&&roomb)
	 {
	       if(random(2)) 
	       	rooma->set("true_exit",1);
	       else 
