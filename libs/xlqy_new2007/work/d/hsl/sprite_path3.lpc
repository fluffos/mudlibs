inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "神秘小路");
  set("long", @LONG

这儿是通往亚雷比斯后山的神秘小径，走在这条路上，总有
一种来自心灵的神奇压力笼罩着你，使你不由得心跳加速。
LONG);

  set("exits",
    ([
      "north": __DIR__ "sprite_street3",
      "southwest": __DIR__ "sprite_path4",
    ]));


  set("outdoors", "hsl");
  set("no_clean_up", 0);

  setup();

}
