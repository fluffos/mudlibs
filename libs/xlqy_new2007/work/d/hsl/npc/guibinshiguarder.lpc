// cityguarder.c

inherit NPC;

void create()
{
        set_name("卫士", ({ "guarder"}));
        set("gender", "男性");
        set("age", random(20) + 20);
        set("str", 25);
        set("long", "把守贵宾室的卫士，表面上是保护贵宾室中的客人，\n其实是看守客人，防止她逃跑。\n");
        set("combat_exp", 50000);
        set("attitude", "peaceful");

        set_skill("unarmed", 100);
        set_skill("force", 100);
        set_skill("sword", 100);
        set_skill("dodge", 100);
        set_skill("parry", 100);
	 set("max_kee", 800);
	 set("max_sen", 600);
        set("force", 400); 
        set("max_force", 400);
        set("force_factor", 15);
	 set("max_mana", 100);
	 set("mana", 100);
	 set("mana_factor", 5);
        setup();
        carry_object("/d/hsl/obj/westsword")->wield();
        carry_object("/d/hsl/obj/fighterarmor")->wear();
}

int accept_fight(object me)
{
        message_vision("看起来卫士不想与$N较量！\n\n", me);
        return 0;
}


