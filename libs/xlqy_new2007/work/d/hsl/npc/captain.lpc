//captain.c

inherit NPC;

#include <ansi.h>

int send(object me);

void create()
{
        set_name("船长", ({ "captain" }) );
        set("gender", "男性" );
        set("age", 60);
        set("long", "一位经历过大风大浪的老船长，是这艘大船的主人，\n也许你可以问问他关于乘船的问题。\n");
        set("combat_exp", 5000);
        set("attitude", "friendly");
        set("inquiry", ([
                 "乘船" : (: send :),
                  "ship" : (: send :),
        ]) );
        setup();
        carry_object("/obj/cloth")->wear();
}

int send(object me)
{
        me = this_player();
        //command("nod " + me->query("id"));
        if( (environment(this_object()))->query("short") != "薛维斯港" ) { //tonii,03-6-14
        	command("say 我这是在哪儿啊？");
	       return 1;
        }
        if( me->is_busy()) {
        	command("say 你正忙着呢，等一下吧！");
        	return 1;
        }
        command("say 坐稳了，我这就送你过去。\n");
        tell_object(me,"\n你在船的晃荡中很快就睡着了，醒来时已到彼岸。\n\n");
        me->move("/d/hsl/seashore");       
        return 1;
}


     
