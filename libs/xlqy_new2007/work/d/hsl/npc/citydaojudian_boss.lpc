// citydaojudian_boss.c

inherit F_VENDOR_SALE;
#include <ansi.h>


void create()
{
       reload("citydaojudian_boss");
       set_name(HIM"悠妮"NOR, ({"boss youni","boss","youni"}));
       set("long", "她就是炎龙骑士团中的悠妮，听说这儿很容易赚钱，就来开店，\n不料傻乎乎的她不懂经营，居然赔本了，如今店就快倒闭了。\n");
       set("title","道具店老板");
       set("gender", "女性");
	set("combat_exp", 3000000);
       set("daoxing",5000000);
       set("age", 19);
       set("per",40);
       set("attitude", "friendly");
       set("vendor_goods", ([
 "scroll_1" :"/d/obj/magic/buddhism_sc",
 "scroll_2" :"/d/obj/magic/dao_sc",
"scroll_3" :"/d/obj/magic/dxdf_sc",
 "scroll_4" :"/d/obj/magic/ghs_sc",
"scroll_5" :"/d/obj/magic/mst_sc",
"scroll_6" :"/d/obj/magic/psdf_sc",
 "scroll_7" :"/d/obj/magic/ptdf_sc",
"scroll_8" :"/d/obj/magic/sea_sc",
 "scroll_9" :"/d/obj/magic/taiyi_sc",
"scroll_a" :"/d/obj/magic/taoism_sc",
"scroll_b" :"/d/obj/magic/yaofa_sc",
       ]) );

	setup();
       add_money("gold", 10);
       carry_object("/d/obj/cloth/skirt")->wear();

}
void init()
{
        object ob;

        ::init();
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
        }
        add_action("do_vendor_list", "list");
}

void greeting(object ob)
{
        if( !ob || environment(ob) != environment() ) return;
        switch( random(1) ) {
                case 0:
                        say( name()+"牵住你的手，粘呼呼的说：\n“" +
RANK_D->query_respect(ob)
                                + "，你借我点钱吧，我蚀本了，呜呜呜～～～～”\n");
                        break;
	}
}

