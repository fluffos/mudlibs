// yiren_guarder.c

inherit NPC;

void create() {
  set_name("翼人守卫", ({ "yiren guarder", "guarder", "yiren" }));
  set("gender", "男性");
  set("age", random(20) + 20);
  set("str", 25);
  set("long", "背上有着一双巨翅的翼人守卫。\n");
  set("combat_exp", 30000);
  set("attitude", "peaceful");

  set_skill("unarmed", 80);
  set_skill("force", 80);
  set_skill("spear", 80);
  set_skill("dodge", 80);
  set_skill("parry", 80);
  set("max_kee", 700);
  set("max_sen", 600);
  set("force", 400);
  set("max_force", 400);
  set("force_factor", 15);
  set("max_mana", 100);
  set("mana", 100);
  set("mana_factor", 5);
  setup();
  carry_object("/d/obj/weapon/spear/changqiang")->wield();
  carry_object("/d/obj/armor/tiejia")->wear();
}
