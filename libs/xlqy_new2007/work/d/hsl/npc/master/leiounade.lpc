// leiounade.c

inherit NPC;
inherit F_MASTER;
#include <ansi.h>

void re_rank(object);
string ask_mieyao();
string ask_cancel();
string avenge();
string ask_for_leave();

void create() {
  set_name("雷欧纳德", ({ "lei ounade", "lei" }));
  set("long", "沃斯菲塔共和国皇家骑士团第二团团长雷欧纳德\n");
  set("title", HIR "双头死神" NOR);
  set("rank_info/respect", "英雄");
  set("gender", "男性");
  set("age", 25);
  set("class", "hsl_might");
  set("attitude", "heroism");
  set("per", 30);
  set("looking", "有着雕塑般棱角分明的脸庞，笔挺的鼻梁，\n深邃的双眼中却带着三分不屑的神情。");
  set("max_kee", 3000);
  set("max_sen", 2000);
  set("force", 3000);
  set("max_force", 3000);
  set("force_factor", 150);
  set("max_mana", 2400);
  set("mana", 2400);
  set("mana_factor", 120);
  set("combat_exp", 3000000);
  set("daoxing", 1000000);
  set_skill("literate", 150);
  set_skill("unarmed", 180);
  set_skill("dodge", 200);
  set_skill("parry", 200);
  set_skill("sword", 220);
  set_skill("tianlei-sword", 220);
  set_skill("spells", 180);
  set_skill("windspells", 150);
  set_skill("starforce", 200);
  set_skill("shenfa-quan", 180);
  map_skill("unarmed", "shenfa-quan");
  set_skill("force", 200);
  set_skill("xukong-steps", 200);
  map_skill("spells", "windspells");
  map_skill("force", "starforce");
  map_skill("parry", "tianlei-sword");
  map_skill("dodge", "xukong-steps");
  map_skill("sword", "tianlei-sword");
  set("chat_chance_combat", 60);
  set("chat_msg_combat", ({
    (: command("perform qizhan") :),
    (: command("perform shan") :),
    (: command("perform moon") :)
  }));
  set("inquiry", ([
    "name": "我就是雷欧纳德，找我有什么事？",
    "here": "你自己看看就知道了。",
    "缇娜": "她是最令我刻骨铭心的女孩子了。",
    "fall": "要学我的绝招，先得给我把“剑之魂”拿来！",
    "剑之魂": "传说剑之魂在法鲁西翁大陆的妖精族聚居地。",
    //     "复仇" : (: avenge :),
    "灭妖": (: ask_mieyao :),
    "leave": (: ask_for_leave :),
  ]));


  create_family("幻世勇者", 1, "弟子");
  setup();

  carry_object("/d/hsl/obj/aoyizhizheng")->wear();
  carry_object("/d/hsl/obj/jiguangsword")->wield();
}

void init() {
  add_action("do_kneel", "kneel");
  add_action("do_agree", "agree");
}

void attempt_apprentice(object ob) {
  ob = this_player();
  if (ob->query("gender") == "女性") {
    command("say 这位" + RANK_D->query_respect(ob) + "，幻世勇者不收女弟子，你还是去拜缇娜她们吧！\n");
    return;
  }
  if ((string)ob->query("family/family_name") == "幻世勇者") {
    if ((int)ob->query("combat_exp") < 200000) {
      command("say 学习我的剑法需要良好的武学基础，这位" + RANK_D->query_respect(ob) + "还是练练再来吧。\n");
      return;
    }
    command("smile");
    command("say 很好，今天开始" + RANK_D->query_respect(ob) + "你就跟着我学吧。");
    command("recruit " + ob->query("id"));
    re_rank(ob);
    ob->save();
    return;
  }
  command("shake");
  command("say 你还是先跟着我的几位伙伴学吧！\n");
  return;
}
int recruit_apprentice(object ob) {
  if ( ::recruit_apprentice(ob))
    ob->set("class", "hsl");
}

void re_rank(object ob) {
  int exp;
  exp = (int)ob->query("combat_exp");
  if (exp < 300000) {
    ob->set("title", "剑 士 ");
    return;
  } else if (exp < 1000000) {
    ob->set("title", "剑 豪 ");
    return;
  } else {
    ob->set("title", HIW "终 焉 剑 使 " NOR);
    return;
  }
}

string avenge() {
  object who = this_player(), killer, where;
  string killid;
  if ((string)who->query("family/family_name") != "幻世勇者")
    return ("你不是本派弟子，生死与我何干？");
  if (who->query("faith") < 1000)
    return ("你在本门名望还不够，还需多加努力才行。");
  if (who->query("avenge/mud_age") >= who->query("death/mud_age"))
    return ("我未闻死讯");
  killid = who->query("kill/last_killer");
  killer = find_living(killid);
  if (!killer || !userp(killer))
    return ("这个嘛，我还得想一想");
  command("say 我这就去为你抱仇。");
  who->set("avenge/mud_age", who->query("mud_age"));
  where = environment(who);
  tell_room(where, "只见雷欧纳德向空中一指：\n");
  tell_room(where, "护法天尊何在，速去将" + killer->query("name") + "抓来。\n");
  tell_room(environment(killer), "空中伸出一只大手将" + killer->query("name") + "抓走了。\n");
  killer->move(where);
  tell_room(where, killer->query("name") + "被从空中扔了下来。\n");
  command("say 大胆妖孽，胆敢杀害我弟子");
  this_object()->kill_ob(killer);
  return ("拿命来。");
}

string ask_mieyao() {
  object who = this_player();

  if ((string)who->query("family/family_name") == "幻世勇者") {
    command("smile " + who->query("id"));
    return "/d/obj/mieyao"->query_yao(who);
  }
  return ("非我门人,何故来此?\n");
}

int do_kneel() {
  object who = this_player();
  if ((string)who->query("family/family_name") != "幻世勇者")
    return notify_fail(this_object()->query("name") + "说：你又不是我门弟子，拜我干什么？\n");
  if ("/d/obj/mieyao"->delete_mieyao(who)) {
    command("say 既然如此，就算了吧，不过你没有完成任务，得受些惩罚！\n");
    who->add("faith", -5);
    message_vision("$N的忠诚度下降了！\n", who);
  }
}

string ask_for_leave() {
  object me = this_player();

  if (me->query("family/family_name") == "幻世勇者") {
    command("say 要走的终归要走，我不会留你，但是有点要说明：");
    me->set_temp("betray", 1);
    return ("脱离师门要需要有一定惩罚，你可愿意(agree)？");
  }

  return ("你走不走和我无关。\n");
}

int do_agree(string arg) {
  if (this_player()->query_temp("betray")) {
    message_vision("$N答道：弟子愿意。\n\n", this_player());
    command("say 你走吧，自己保重！");
    this_player()->add("betray/count", 1);
    this_player()->add("betray/hsl_might", 1);
    this_player()->set("combat_exp", this_player()->query("combat_exp") * 80 / 100);
    if (this_player()->query_skill("tianlei-sword")) {
      this_player()->delete_skill("tianlei-sword");
      this_player()->map_skill("sword");
    }

    if (this_player()->query_skill("windspells")) {
      this_player()->delete_skill("windspells");
      this_player()->map_skill("spells");
    }


    this_player()->delete("family");
    this_player()->delete("class");
    this_player()->delete("faith");
    this_player()->set("title", "普通百姓");
    this_player()->set_temp("betray", 0);
    this_player()->save();
    command("say 江湖风波，善恶无形，好自为之。。。\n");
    return 1;
  }
}
