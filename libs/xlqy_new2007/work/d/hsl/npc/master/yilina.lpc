// yilina.c

inherit NPC;
inherit F_MASTER;
#include <ansi.h>
string skill_lvl();
int improve(string arg);
void re_rank(object);

void create() {
  set_name(HIW "伊丽娜" NOR, ({ "yilina" }));
  set("long", "她就是魔神战争时期的圣灵使伊丽娜，\n但她的前身其实是三魔神之首：虚空神！\n");
  set("title", HIC "虚 空 神 " NOR);
  set("rank_info/respect", "女神");
  set("gender", "女性");
  set("age", 20);
  set("class", "hsl_magic");
  set("attitude", "peaceful");
  set("per", 30);
  set("looking", "美丽而忧伤，如大海般蔚蓝的双眼沉淀着无限的悲哀。");
  set("max_kee", 4500);
  set("max_sen", 4500);
  set("force", 8000);
  set("max_force", 8000);
  set("force_factor", 300);
  set("max_mana", 8000);
  set("mana", 8000);
  set("mana_factor", 300);
  set("combat_exp", 10000000);
  set("daoxing", 8000000);
  set("skill_level/sword", "expert");
  set("skill_level/staff", "master");

  set_skill("literate", 250);
  set_skill("unarmed", 300);
  //           set_skill("shenfa-quan",300);
  set_skill("dodge", 300);
  set_skill("parry", 300);
  set_skill("sword", 300);
  set_skill("sanchen-staff", 300);
  set_skill("spells", 300);
  set_skill("wanxi-spells", 300);
  set_skill("wanxi-force", 300);
  set_skill("force", 300);
  set_skill("charmingdance", 300);
  set_skill("staff", 300);
  set_skill("shenfa-quan", 300);
  map_skill("unarmed", "shenfa-quan");
  map_skill("spells", "wanxi-spells");
  //      map_skill("unarmed","shenfa-quan");
  map_skill("force", "wanxi-force");
  map_skill("parry", "sanchen-staff");
  map_skill("dodge", "charmingdance");
  map_skill("staff", "sanchen-staff");
  set("chat_chance_combat", 80);
  set("chat_msg_combat", ({
    (: command("cast hufa") :),
    (: command("cast fire") :),
    (: command("cast water") :),
    (: command("perform fengmo") :),
    (: command("perform dodge.flower") :)
  }));
  set("inquiry", ([
    "name": "我是谁？我也不知道。",

  ]));


  create_family("幻世魔导", 1, "弟子");
  setup();

  carry_object("/d/hsl/obj/skypao")->wear();
  carry_object("/d/hsl/obj/zhicaizhang")->wield();
}

void attempt_apprentice(object ob) {

  ob = this_player();

  if (!((string)ob->query("gender") == "女性")) {
    command("shake");
    command("say 幻世魔导不收男弟子，这位" +
      RANK_D->query_respect(ob) + "还是另请高就吧。\n");
    return;
  }
  if (ob->query("obstacle/number") < 34) {
    command("say 这位" + RANK_D->query_respect(ob) + "我等你取经归来的好消息！\n");
    command("addoil");
    return;
  }
  if ((int)ob->query("daoxing") < 1200000) {
    command("shake");
    command("say 这位" + RANK_D->query_respect(ob) + "，你的道行还不够。\n");
    return;
  }

  command("pat " + ob->query("id"));
  command("say 好的，今天开始" + RANK_D->query_respect(ob) + "你可以跟我学习了。\n");
  command("recruit " + ob->query("id"));
  re_rank(ob);
  ob->save();
  return;
}

int recruit_apprentice(object ob) {
  if ( ::recruit_apprentice(ob))
    ob->set("class", "hsl");
}

void re_rank(object ob) {
  int exp;
  exp = (int)ob->query("daoxing");
  if (exp < 1600000) {
    ob->set("title", HIY "制 裁 者 " NOR);
    return;
  } else {
    ob->set("title", HIW "光 之 圣 女 " NOR);
    return;
  }
}
