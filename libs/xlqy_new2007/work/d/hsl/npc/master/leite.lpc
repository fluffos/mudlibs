inherit NPC;
inherit F_MASTER;
#include <ansi.h>

void re_rank( object );

void create()
{
       set_name("雷特", ({"lei te","lei"}));
       set("long", "从那可那鲁翼人王国逃亡的孤独的雷特\n");
       set("title", HIC"浪漫的翼人"NOR);
       set("rank_info/respect", "英雄");
       set("gender", "男性");
       set("age", 25);
	set("class", "hsl_might");
       set("attitude", "heroism");
       set("per", 30);
	set("looking", "有着一张英俊的脸庞和高高瘦瘦的身材，\n背后长着一双大翅膀。");
	set("max_kee", 3000);
       set("max_sen", 2000);
       set("force", 2100);
       set("max_force", 2100);
       set("force_factor", 105);
       set("max_mana", 3000);
       set("mana", 3000);
       set("mana_factor", 151);
       set("combat_exp", 1000000);
       set("daoxing", 2000000);
		set_skill("literate", 150);
		set_skill("unarmed",180);
		set_skill("dodge", 200);
		set_skill("parry", 200);
		set_skill("spear", 200);
		set_skill("spells", 200);
		set_skill("windspells", 200);
		set_skill("starforce", 150);
		set_skill("force", 120);
		set_skill("xukong-steps", 200);
	map_skill("spells", "windspells");
	map_skill("force", "starforce");
	map_skill("dodge", "xukong-steps");
       set("chat_chance_combat", 60);
       set("chat_msg_combat", ({
		(: command("cast feilong") :),
		(: command("cast tongyi") :),
        }) );
       set("inquiry", ([
	"name": "我就是雷特，找我有什么事？",
	"here": "为什么我要告诉你？",
	"雪拉": "哦～我的女神雪拉！",
	]));


create_family("幻世勇者", 1, "弟子");
setup();

        carry_object("/d/hsl/obj/shenzhizu")->wear();
        carry_object("/d/hsl/obj/heitianshispear")->wield();
}

void attempt_apprentice(object ob)
{	ob=this_player();
       if( ob->query("gender") == "女性"){
             command("say 这位" + RANK_D->query_respect(ob) +"，幻世勇者不收女弟子，你还是去拜缇娜她们吧！\n");
             return;
       }
       if( ob->query("family/family_name")!="幻世勇者"){
             command("say 这位" + RANK_D->query_respect(ob) +"非本门中人，我不能教你！\n");
             return;
       }

	command("smile");
       command("say 很好，今天开始" + RANK_D->query_respect(ob) + "你就跟着我学吧。");
       command("recruit " + ob->query("id") );
       re_rank(ob);
       ob->save();
	return;
}

int recruit_apprentice(object ob)
{
        if( ::recruit_apprentice(ob) )
                ob->set("class", "hsl");
}

void re_rank(object ob)
{
      int exp; 
      exp = (int)ob->query("combat_exp"); 
      if( exp < 300000 ) { 
           ob->set("title","飞 战 士 "); 
           return ; 
      }
      else if ( exp < 1000000 ) {
           ob->set("title","天 行 者 ");
           return;
      }
      else {
           ob->set("title",HIC"护 天 使 "NOR);
           return;
      }
}




