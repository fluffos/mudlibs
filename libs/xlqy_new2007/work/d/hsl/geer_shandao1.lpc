#include <ansi.h>

void create() {
  set("short", "戈尔山道");
  set("long", @LONG

一条通往自由都市米兰多的山间小道，山道间凉风习习，两旁树木
郁郁葱葱，令人心旷神怡。不过据说近来有盗贼在山道间出没，相
信附近就有它们的巢穴，来往的人可都要小心一些。
LONG);

  set("exits",
    ([
      "northwest": __DIR__ "geer_shandao2",
      "southeast": __DIR__ "oumu_village",
    ]));

  set("outdoors", "hsl");
  set("no_clean_up", 0);
  setup();
}
