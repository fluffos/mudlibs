#include <ansi.h>

void create ()
{
  set ("short","帕尼西雅城废墟");
  set ("long", @LONG

这儿是魔神战争时留下的帕尼西雅城废墟，当年狱狂神为了
显示其强大的破坏力，一举摧毁了这个繁华而美丽的城市，
使城市中的居民一夜之间全都成了怨死的亡灵，虽然经历了
几百年，仍然冤魂不散。
LONG);

  set("exits", 
  ([  
  	 "southwest": __DIR__"desolatecity",
  ]));

 /*  set("objects", 
  ([ 
   "/d/hsl/npc/zombie" : 2,
   "/d/hsl/npc/eling" : 1,
  ]));
*/

  set("outdoors", "hsl");
