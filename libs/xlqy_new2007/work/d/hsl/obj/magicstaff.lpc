// magicstaff.c

#include <weapon.h>
#include <ansi.h>
inherit STAFF;

void create()
{
   set_name("魔法师之杖", ({"shengling zhang", "staff", "zhang"}));
   set_weight(5000);
   if (clonep())
     set_default_object(__FILE__);
   else {
     set("unit", "根");
     set("long", "一根小巧玲珑的法杖。\n");
     set("value", 4000);
     set("material", "iron");
     set("wield_msg", "$N拿出一根魔法师之杖握在手中。\n");
     set("unwield_msg", "$N放下手中的魔法师之杖。\n");
     set("weapon_prop/spells",5);
   }
   init_staff(30);
   setup();
  
}

