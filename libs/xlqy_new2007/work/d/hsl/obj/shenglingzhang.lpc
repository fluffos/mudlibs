//shenglingzhang.c

#include <weapon.h>
#include <ansi.h>
inherit STAFF;

void create()
{
   set_name("圣灵之杖", ({"shengling zhang", "staff", "zhang"}));
   set_weight(5000);
   if (clonep())
     set_default_object(__FILE__);
   else {
     set("unit", "根");
     set("long", "一根颇具魔力的法杖。\n");
     set("value", 10000);
     set("material", "silver");
     set("wield_msg", "$N拿出一根焕发着银色光彩的法杖握在手中。\n");
     set("unwield_msg", "$N放下手中的圣灵之杖。\n");
     set("weapon_prop/spells",10);
   }
   init_staff(60);
   setup();
  
}

