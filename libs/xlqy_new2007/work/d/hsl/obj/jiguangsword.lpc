//jiguangsword.c

#include <weapon.h>
#include <ansi.h>
inherit SWORD;

void create()
{
   set_name("极光之剑", ({"jiguang sword", "jian", "sword","jiguang"}));
   set_weight(5000);
   if (clonep())
     set_default_object(__FILE__);
   else {
     set("unit", "柄");
     set("long", "一柄发着冷冷的银色光彩的剑。\n");
     set("value", 10000);
     set("material", "steel");
     set("wield_msg", "$N唰地一声抽出极光之剑，剑身幻出一道银色光芒。\n");
     set("unwield_msg", "$N将极光之剑插回腰间。\n");
   }
   init_sword(70);
   setup();
  
}

