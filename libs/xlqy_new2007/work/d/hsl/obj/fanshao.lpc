// fanshao.c

#include <weapon.h>

inherit DAGGER;

void create()
{
        set_name("饭勺", ({ "fan shao", "shao","dagger" }) );
        set_weight(100);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "个");
                set("value", 0);
                set("material", "iron");
                set("long", "一个吃饭用的饭勺。\n");
                set("wield_msg", "$N拿出一个饭勺握在手中。\n");
        }
        init_dagger(1);
        setup();
}


