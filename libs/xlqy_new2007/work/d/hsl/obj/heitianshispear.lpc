#include <weapon.h>
#include <ansi.h>
inherit SPEAR;

void create()
{
   set_name("魔枪  黑天使", ({"heitianshi spear", "spear", "qiang","heitianshi"}));
   set_weight(6000);
   if (clonep())
     set_default_object(__FILE__);
   else {
     set("unit", "柄");
     set("long", "一柄周身漆黑的魔枪。\n");
     set("value", 10000);
     set("material", "steel");
     set("wield_msg", "$N呼地一声从身后抡出一柄黑色的魔枪。\n");
     set("unwield_msg", "$N将魔枪收了起来。\n");
   }
   init_spear(70);
   setup();
  
}

