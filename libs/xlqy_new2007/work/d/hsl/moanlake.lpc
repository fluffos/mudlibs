inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "悲叹之湖");
  set("long", @LONG

这是个清澈、幽深、远离硝烟的山间湖泊，它安安静静地躺在
这儿，看尽世间无数悲欢离合、恩爱情仇，多少鲜血与泪水、
多少歌唱与哀啼，都不过是转瞬即逝的三千微尘，人世间又有
什么值得留恋，什么能够永恒呢？
LONG);

  set("exits",
    ([
      "south": __DIR__ "republic_path3",
      "north": __DIR__ "republic_path6",
      "northeast": __DIR__ "republic_path4"
    ]));

  set("no_fight", 1);
  set("no_magic", 1);
  set("resource",
    ([
      "water": 1,
    ]));
  //  set("valid_startroom", 1);

  set("outdoors", "hsl");
  set("no_clean_up", 0);

  setup();

}
