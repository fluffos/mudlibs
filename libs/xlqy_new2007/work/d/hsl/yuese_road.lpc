inherit ROOM;
#include <ansi.h>

void create ()
{
  set ("short","三岔路口");
  set ("long", @LONG

这儿是一个三岔路口，往北通往草原地带，往西南是强大的沃斯
菲塔共和国的领土，往东南则是兽人的王国冀罗。
LONG);

  set("exits", 
  ([  
         "north": __DIR__"yuese_shanlu2",
         "southeast": __DIR__"republic_path1",
         "southwest": __DIR__"jiluo_path1",
  ]));

       
 set("outdoors", "hsl");
 set("no_clean_up", 0);
    
 setup();
 replace_program(ROOM);

}



