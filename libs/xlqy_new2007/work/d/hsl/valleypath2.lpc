inherit ROOM;
#include <ansi.h>

void create ()
{
  set ("short","入谷小径");
  set ("long", @LONG

这是通往回音之谷的山间小径，它的另一端连接妖精族的聚居地
亚雷比斯。一路流水淙淙、莺歌燕舞，景色相当迷人。
LONG);

  set("exits", 
  ([  
        "east"  :  __DIR__"echovalley",
        "northwest"  :  __DIR__"sprite_road1",
  ]));

       
 set("outdoors", "hsl");
 set("no_clean_up", 0);
    
 setup();
 replace_program(ROOM);

}



