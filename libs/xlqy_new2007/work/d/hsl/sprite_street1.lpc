// ROOM: /d/hsl/sprite_street1

inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "亚雷比斯山间路");
  set("long", @LONG

妖精之都亚雷比斯不是一座城市，而是建设在山间的一个村庄，
村中的建筑十分朴素而古老，就如同妖精族的人：过着朴素
的生活，而他们的寿命原比人类长，有一百多甚至几百年。
当雷欧纳德第一次来到这个雪拉的故乡时，不由得惊叹：这
简直就是难民营。不过这儿的人却并不这么想，他们对于这
种安逸的生活感到惬意和满足。
LONG);

  set("exits",
    ([
      "north": __DIR__ "sprite_path2",
      "southeast": __DIR__ "sprite_street2",
      "west": __DIR__ "sprite_house1"
    ]));

  /*  set("objects", 
  ([ 
   "/d/hsl/npc/sprite_girl" : 1,
  ]));
*/

  set("outdoors", "hsl");
  set("no_clean_up", 0);

  setup();
  replace_program(ROOM);

}
