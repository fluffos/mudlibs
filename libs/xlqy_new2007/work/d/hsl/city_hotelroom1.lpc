inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "公共休息室");
  set("long", @LONG

这是旅舍为旅途劳顿而想坐下来或者稍微躺一下的人们所
安排的免费休息室。休息室以一张珠帘分隔为男女两部分，
不过在这儿睡觉的人不多，基本上是坐下来喝喝水，顶多
稍微打个瞌睡。
LONG);

  set("exits",
    ([
      "out": __DIR__ "city_hotel",
    ]));



  set("sleep_room", 1);
  set("if_bed", 1);

  set("no_clean_up", 0);

  setup();

}
