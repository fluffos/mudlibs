// ROOM: /d/hsl/nakenalu_border

inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "那可那鲁边境");
  set("long", @LONG

这儿是进入那可那鲁翼族王国的边境关卡，从这儿往北可以望
见不远处的利鲁玛山地。由于近来那可那鲁实行了封锁政策，
外族人一律不得进入那可那鲁，不过由于那可那鲁必须从外面
进口一些本国希缺物品，所以特准某些商人凭借王国特别颁发
的通行证出入边境。
LONG);

  set("exits",
    ([
      "north": __DIR__ "liluma_mountain1",
      "south": __DIR__ "aiwatai2",
    ]));

  set("objects",
    ([
      "/d/hsl/npc/yiren_guarder": 2,
    ]));



  set("outdoors", "hsl");
  set("no_clean_up", 0);

  setup();

}

int valid_leave(object me, string dir) {
  object pass;
  me = this_player();
  if (dir == "north")
    if (objectp(present("yiren guarder", environment(me))))
      if (!pass = present("pass", me))
        return notify_fail("翼人守卫大喝一声：没有通行证者不得进入！\n");
  return 1;
}
