// ROOM: /d/hsl/wpathup2.c

inherit ROOM;

#include <ansi.h>

void create ()
{
  set ("short","陡峭山径");
        set ("long", @LONG

极其陡峭的一条小径，几乎成垂直状地延伸，这儿地势已经非常高了，
寒冷的风不停地呼啸着，吹得人几乎站不住脚。远远望去，白云同你
一般高度，整个人就像在异常广阔和孤独的天空间翱翔。
LONG);

        set("exits", 
        ([ 
		"eastup" : __DIR__"wpathup3",
              "westdown" : __DIR__"wpathup1",
         ]));
       set("outdoors", "hsl");
	set("no_clean_up", 0);
       setup();
}

int valid_leave(object me, string dir)
{
	  me = this_player();
	  if (dir == "eastup" )
	  {
	  	  me->add("kee",-150);
	  	  tell_object(me,HIW"你攀登着陡峭的山崖，又离山顶近了一步，不过真是累极了！\n\n"NOR);
	  }
	  return 1;
}


