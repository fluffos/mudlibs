inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "亚雷比斯山间路");
  set("long", @LONG

这是一条盘桓于山间的鹅卵石路，是连接亚雷比斯各家各户的
主要通道，经常能够看到妖精小孩蹦蹦跳跳地走过。
LONG);

  set("exits",
    ([
      "northwest": __DIR__ "sprite_street1",
      "south": __DIR__ "sprite_street3",
      "east": __DIR__ "sprite_house2"
    ]));

  set("outdoors", "hsl");
  set("no_clean_up", 0);

  setup();

}
