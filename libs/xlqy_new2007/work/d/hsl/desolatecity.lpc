inherit ROOM;
#include <ansi.h>

void create ()
{
  set ("short","废都曼多利亚");
  set ("long", @LONG

这儿曾经是辉煌一时的拉尔斯帝国的首都，从前人群熙熙攘
攘、商店星罗棋布的大都市如今只剩废墙残垣，只能看到零
星的市民从破旧的居舍中出来，也个个都是面黄肌瘦。
LONG);

  set("exits", 
  ([  
  	"northeast" : __DIR__"feixu",
       "southwest": __DIR__"feinasi_river",
       "southeast": __DIR__"xueweisi_harbor",
  ]));

  set("outdoors", "hsl");
  set("no_clean_up", 0);
    
 setup();
 replace_program(ROOM);

}



