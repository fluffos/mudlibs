inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "墓内密室");
  set("long", @LONG

墓中一个小小的石室，却是那种一直窒息着你的诅咒力量之来源，
但这种力量似乎并不是石室本身散发的，而是…………
LONG);

  set("exits",
    ([
      "southeast": __DIR__ "jiluo_tomb2",
    ]));

  set("no_clean_up", 0);

  setup();

}

void init() {
  object *sword;
  object darksword;
  if (present("darksword", this_object())) return;
  sword = children(__DIR__ "obj/darksword");

  if (sizeof(sword) > 1) return;
  darksword = new(__DIR__ "obj/darksword");
  darksword->move(this_object());
}
