// ROOM: /d/hsl/seashore

inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "海边");
  set("long", @LONG

这儿是巴瀚纳海峡的南海岸，空气温暖潮湿，地上遍布各种热带
大叶植物以及许多不知名的昆虫。往南是鲜为人知的龙之息火山，
很少有人曾经去过那儿。从这儿可以免费回到(back)薛维斯港。
LONG);


  set("exits",
    ([
      "south": __DIR__ "volcano1",
    ]));

  set("outdoors", "hsl");
  set("no_clean_up", 0);

  setup();

}

void init() {
  add_action("do_back", "back");
}

int do_back() {
  object me = this_player();
  tell_object(me, "\n你在船的晃荡中很快就睡着了，醒来时已回到了薛维斯港。\n\n");
  me->move("/d/hsl/xueweisi_harbor");
  return 1;
}
