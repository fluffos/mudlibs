inherit ROOM;
#include <ansi.h>

void create() {
  set("short", "街道");
  set("long", @LONG

一条宽广而整洁的街道，人来人往热闹非凡。街道的西面是
一家武器店，看来生意也很不错。
LONG);

  set("exits",
    ([
      "east": __DIR__ "city_crossing",
      "west": __DIR__ "city_bingqipu",
    ]));


  set("outdoors", "hsl");
  set("no_clean_up", 0);

  setup();
  replace_program(ROOM);

}
