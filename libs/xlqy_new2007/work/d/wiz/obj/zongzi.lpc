//tonii,端午节发粽子

#include <ansi.h>
inherit COMBINED_ITEM;

void setup()
{}

void init()
{
        add_action("do_eat", "eat");
        add_action("do_look","look");
}

void create()
{
        set_name(HIY"粽子"NOR, ({"zongzi"}));
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("base_unit", "个");
                set("unit", "些");
                set("long", "一个香喷喷的粽子。\n");
                set("value", 0);
	         set("drug_type", "良药");
                set("no_get",1);
        }
    set_amount(5);
        setup();
}

int do_look(string arg)
{
        object me = this_player();
        if(!id(arg))
                return notify_fail("你要看什么？\n");
        tell_object(me,"这是一个香喷喷的粽子！它是由大唐御厨tonii专门为"+me->query("name")+"定做的！\n");
        return 1;
}

int do_eat(string arg)
{
        object me = this_player();
        if (!id(arg))
                return notify_fail("你要吃什么药？\n");
        me->set("kee",me->query("max_kee"));
        me->set("sen",me->query("max_sen"));
        me->add("daoxing",100);
        me->add("potential",100);
        me->add("combat_exp",100);
        message_vision(HIM"$N毛手毛脚地剥开竹叶，顿时一股香气沁人心脾！\n"NOR,me);
        message_vision(HIM"$N狼吞虎咽地往嘴里塞，一眨眼就吃了个干净！\n\n"NOR,me);
        tell_object(me,HIC"你顿时神采奕奕！\n");
        tell_object(me,HIW"你得到了100点武学、二十五天道行和100点潜能！\n"NOR);
        add_amount(-1);
        return 1;
}


