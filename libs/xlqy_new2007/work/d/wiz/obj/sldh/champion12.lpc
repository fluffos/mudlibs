#include <armor.h>
#include <ansi.h>

inherit DIABLO_OB;

void create() {
  set("name", HIY "亭台水榭XLQY水陆大会亚军护身符" NOR);
  //  set_name(""HIY"亭台水榭XLQY水陆大会亚军护身符"NOR"",({""HIY"Champion amulet"NOR"","amulet"}));
  set("id", "amulet");
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "枚");
    set("armor_prop/armor", 1);
    set("armor_type", TYPE_AMULET);
    set("diablo_prop/add_all_skill", 2);
    set("diablo_prop/add_max_kee", 400);
    set("diablo_prop/add_max_sen", 400);
    set("diablo_prop/add_max_force", 400);
    set("diablo_prop/add_max_mana", 400);
    set("diablo_prop/high_resist_all", 400);
    set("diablo_prop/armor", 50);
    set("diablo_prop/rigidity", 999);
    set("level", 99);
    set("no_give", 1);
    set("no_drop", 1);
    set("no_get", 1);
    set("no_sell", 1);
    set("no_put", 1);
    set("no_diablo_disload_give", 1);
    set("no_diablo_rename", 1);
    set("identification", 1);

    //	set("diablo_ob_autoloaded",1);
  }
  setup();
}
