#include <armor.h>
#include <ansi.h>

inherit DIABLO_OB;

void create()
{
        set("name",HIY"缥缈XLQY水陆大会冠军项链"NOR);
        set("id","necklace");
	set_weight(100);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "条");
		set("armor_prop/armor", 1);
        set("armor_type", TYPE_NECK);
		set("diablo_prop/add_all_skill",5);
		set("diablo_prop/add_max_kee",1000);
		set("diablo_prop/add_max_sen",1000);
		set("diablo_prop/add_max_force",1000);
		set("diablo_prop/add_max_mana",1000);
		set("diablo_prop/high_resist_all",1000);
          set("diablo_prop/sub_max_phy",1000);
          set("diablo_prop/magic_find",5000);
		set("diablo_prop/armor",50);
		set("diablo_prop/rigidity",999);
		set("level",99);
//       set("no_give",1);
		set("no_drop",1);
		set("no_get",1);
		set("no_sell",1);
		set("no_put",1);
//            set("no_diablo_disload_give",1);
		set("no_diablo_rename",1);
		set("identification",1);
		
	//	set("diablo_ob_autoloaded",1);
        }
        setup();
}
