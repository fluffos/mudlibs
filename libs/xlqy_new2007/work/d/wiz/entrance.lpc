void init() {
  add_action("do_get", "get");

}
int do_get(string arg) {
  object who = this_player();
  object what;
  string whoa, sth;
  if (!arg) return 0;
  if (sscanf(arg, "%s", whoa) == 1) {
    if (!(what = present(arg, environment(who)))) {
      if (sscanf(arg, "%s from %s", sth, whoa) == 2) {
        if (!(what = present(whoa, environment(who)))) return 0;
        if (userp(what))
          return 1;
      } else return 0;
    } else if (userp(what))
      return 1;
  }

  return 0;


}
