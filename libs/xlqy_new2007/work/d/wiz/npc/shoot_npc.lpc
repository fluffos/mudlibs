#include <ansi.h>
inherit NPC;
int ask_money(object ob) {
  object m;
  if (!((int)this_object()->query("balance") > 0)) {
    this_object()->command("shrug");
    this_object()->command("say 不好意思，慈善基金破产了.");
    return 1;
  }
  ob = this_player();
  if ((int)this_player()->query("temp/newbie") == 1) {
    message_vision("$N笑眯眯对$n说:这是我们慈善机构给你提供的一点帮助。请善用这笔钱。\n", this_object(), ob);
    this_player()->add("balance", 1000000);
    this_player()->delete("temp/newbie");
    this_object()->add("balance", -1);
  } else {
    message_vision("$N怒道：你又不是新手，还想来骗钱？\n", this_object(), ob);
  }
  return 1;
}
