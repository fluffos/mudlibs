#include <ansi.h>
inherit NPC;

int do_upgrade(string arg);
void create() {
  object a, b, c, d, e, f, g, h, i, j, k;

  set_name(HIC "千堆雪" NOR, ({ "linda npc", "linda", "freecat" }));
  set("long", @LONG
	
[1;36m纵然烈日炎，风霜险，积雪千年，也要等待那春到人间；[2;37;0m
[1;36m明知情思牵，情愁添，情火难遣，也要坚持这一身冷艳。[2;37;0m
	
LONG);


  set("title", HIY "神仙猫猫" NOR);
  set("gender", "女性");
  set("age", 21);
  set("attitude", "friendly");
  set("str", 18);
  set("int", 30);
  set("con", 30);
  set("spi", 30);
  set("per", 30);
  set("combat_exp", 7344114);
  set("daoxing", 3736210);
  set("max_kee", 2947);
  set("kee", 2947);
  set("max_sen", 2165);
  set("sen", 2165);
  set("max_mana", 4470);
  set("mana", 5957);
  set("max_force", 5200);
  set("force", 5200);
  set("no_arrest", 1);
  set_skill("literate", 301);
  set_skill("music", 301);
  set_skill("qin", 301);
  map_skill("music", "qin");

  set("inquiry", ([
    "技能升级": "upgrade <技能id> for 等级(expert/master)\n",
  ]));
  set("skill_level/music", "grandmaster");
  set("skill_level/literate", "grandmaster");
  setup();

  j = carry_object("/d/obj/armor/standard/wrists");
  j->set("name", "" HIM "比" HIY "翼" HIC "鸟" NOR "");
  j->set("id", "Lace");
  j->set("unit", "只");
  j->wear();

  k = carry_object("/d/obj/armor/standard/neck");
  k->set("name", "" HIM "神" HIY "仙" HIC "鱼" NOR "");
  k->set("id", "Fish");
  k->set("unit", "条");
  k->wear();
  i = carry_object("/quest/shijienan/item/armor");
  i->wear();
  h = carry_object("/d/obj/armor/standard/cloth");
  h->set_name("" HIW "白袍" NOR "", ({ "Baipao" }));
  h->set("unit", "袭");
  h->wear();
  g = carry_object("/d/obj/armor/standard/waist");
  g->set_name(HIM "春欲暮" NOR, ({ "Waist" }));
  g->set("unit", "件");
  g->wear();
  f = carry_object("/d/obj/armor/standard/head");
  f->set_name(HIG "碗子铁盔" NOR, ({ "Wanzi tiekui" }));
  f->set("unit", "个");
  f->wear();
  e = carry_object("/d/obj/armor/standard/surcoat");
  e->set_name(HIC "白狐披风" NOR, ({ "Baihu pifeng" }));
  e->set("unit", "袭");
  e->wear();
  d = carry_object("/d/obj/armor/standard/boots");
  d->set_name(HIC "疾风" NOR, ({ "Shoes" }));
  d->set("unit", "双");
  d->wear();
  c = carry_object("/d/obj/armor/standard/finger");
  c->set_name(HIW "白金戒指" NOR "", ({ "Ring" }));
  c->set("unit", "枚");
  c->wear();
  b = carry_object("/d/obj/weapon/dagger/dagger");
  b->set_name(HIM "短铁爪" NOR, ({ "Tie zhua" }));
  b->set("unit", "根");
  b->wield();
  a = carry_object("/d/obj/weapon/whip/whip");
  a->set_name("银索金铃", ({ "Yinsuo jinling" }));
  a->set("unit", "副");
  a->wield();


}
void init() {
  add_action("do_upgrade", "upgrade");

}
int do_upgrade(string arg) {
  string level, item, str;
  int gold;
  object who = this_player();

  if (!arg) {
    tell_object(who, HIM "格式为：upgrade <技能id> for 等级(expert/master)\n " NOR);
    return 1;

  }
  if (sscanf(arg, "%s for %s", item, level) != 2) {
    tell_object(who, HIM "格式为：upgrade <技能id> for 等级(expert/master)\n " NOR);
    return 1;
  }
  if (level != "expert" && level != "master") {
    tell_object(who, HIM "格式为：upgrade <技能id> for 等级(expert/master)\n " NOR);
    return 1;
  }
  if (item != "blade" && item != "sword" && item != "spear" && item != "stick" && item != "force"
    && item != "spells" && item != "dodge" && item != "parry" && item != "staff" && item != "hammer" &&
    item != "music" && item != "whip" && item != "fork" && item != "axe" && item != "unarmed" && item != "throwing"
    && item != "mace" && item != "rake") {
    tell_object(who, HIY "提供升级的技能有： 杖法 (staff)  、棍法 (stick) 、音律乐理 (music) 、剑法 (sword)
		 法术 (spells) 、内功 (force) 、鞭法 (whip) 、招架 (parry) 、锤法 (hammer) 、叉法 (fork) 、斧法 (axe)
		 轻功 (dodge) 、刀法 (blade)  、拳脚 (unarmed) 、暗器 (throwing) 、锏法 (mace) 、钯法 (rake) 、枪法 (spear) \n " NOR);
    return 1;
  }
  if (who->query("skill_level/" + item) == "grandmaster") {
    tell_object(who, HIC "你已经是" + to_chinese(item) + "的宗师级了！\n " NOR);
    return 1;
  }
  if (who->query("skill_level/" + item) == "master") {
    tell_object(who, HIC "你已经是" + to_chinese(item) + "的大师级了！\n " NOR);
    return 1;
  }
  if (who->query("skill_level/" + item) == "expert" && level == "expert") {
    tell_object(who, HIC "你已经是" + to_chinese(item) + "的专家级了！\n " NOR);
    return 1;
  }
  if (!who->query("skill_level/" + item) && level == "master") {
    tell_object(who, HIC "你还是先修炼到" + to_chinese(item) + "的专家境界吧！\n " NOR);
    return 1;
  }
  if (!LEVEL_D->check_skill_for_level(who, item, level)) {
    tell_object(who, HIR "你的" + to_chinese(item) + "等级尚未达到那个境界！\n " NOR);
    return 1;

  }
  if (!LEVEL_D->check_ob_for_level(who, level)) {
    tell_object(who, HIG "你对本门的贡献还有待考验呀...\n " NOR);
    return 1;

  }
  if (who->query("balance") < 5000000 && level == "master") {
    tell_object(who, HIB "你的存款不足，大师需要五百两黄金！\n " NOR);
    return 1;

  }
  if (who->query("balance") < 1000000 && level == "expert") {
    tell_object(who, HIB "你的存款不足，专家需要一百两黄金！\n " NOR);
    return 1;

  }
  if (level == "master") {
    gold = 5000000;
    str = "大师境界";
  } else { gold = 1000000; str = "专家境界"; }
  who->set("skill_level/" + item, level);
  who->add("balance", -gold);
  tell_object(who, HIW "你的" + to_chinese(item) + "已经升到了" + str + "！\n " NOR);
  return 1;


}
