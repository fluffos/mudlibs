// story:xiao&li

#include <ansi.h>

int give_gift();

private mixed *story = ({
        "智泽∶各位施主，我来引见各位见方丈大师吧。",
	"智泽∶这位便是我们方丈大师。",
	"智修大师∶阿弥陀佛．．．三位施主所为何来？",
	"李逍遥∶是这样子的～我们听说大师您法力高强想请大师下山治退尸妖替此地村民除害。",
	"智修大师∶老衲是佛门中人，从不过问外界之俗事，三位请回吧。",
	"李逍遥∶大师此言差矣，出家人降魔卫道本天经地义，何以是外界的俗事呢？",
	"智修大师∶嗯．．．由此言观之施主颇具慧根！",
	"李逍遥∶不敢当～不敢当～",
	"智修大师∶好～只要施主答应替老衲做一件事，老衲就答应你下山收妖。",
	"李逍遥∶只要是不伤天害理的事我李某人一定办到！",
	"智修大师∶你放心～是做好事。",
	"李逍遥∶那就好办～！",
	"智修大师∶呵呵呵～好～太好了！智泽，去把剃剪和袈裟拿出来。",
	"智泽∶是．．！",
	"李逍遥∶大师～莫非您是要．．？",
	"智修大师∶替你剃渡啊！你得在我这出家当和尚。",
	"灵儿：￥％……％￥……＃％！！",
	"月如: ◎＃％￥＃◎％※！！",
	"李逍遥：那有这种事！？我才不要！",
	"智修大师∶阿弥陀佛～　既然施主答应了，就由不得你不依！",
	"智修大师∶智杖！　把他们抓住！",
	"智修大师∶哦！　何必挣扎呢？当和尚只要把头发剃乾净就行了，不会有什么痛苦的。",
	"李逍遥∶这是什么条件？我才不干我还没娶老婆咧！",
	"灵儿：。。。。。。。。。",
	"智修大师∶愚蠢～愚蠢！皈依我佛的人死后才不会下地狱，还可以到西方极乐世界，有何不好？",
	"李逍遥∶您的好意我心领了这种好事就留给您自己吧这一头发型我自己很满意不必麻烦您了～再见！啊．．．不劳您相送了。",
	"智修大师∶老衲让你进得来出不得！",
	"李逍遥∶你这妖僧．．我踢死你！",
	"灵儿、月如∶逍遥哥哥～等一等！",
	"★~~~☆☆~＠~~~＆▲■№●←□↓↑→●◆←☆★■",
	"智泽∶呜．．．饶命啊．．下次不敢了．．",
	".....................................",
	"智泽变成了一串佛珠。",
	"李逍遥：灵儿，来试试这串佛珠。",
	"月如：................哼.....",
	"李逍遥：呃....月如，你要是戴上佛珠更漂亮啦。",
	"灵儿: .....................",
	"李逍遥无奈的耸耸肩。",
	
           (: give_gift :),
});

void create()
{
        seteuid(getuid());
}

mixed query_story_message(int step)
{
        return step < sizeof(story) ? story[step] : 0;
}
int give_gift()
{
        STORY_D->give_gift("/d/obj/story/fozhu", 1,
                           HIM "\n“啪”的一串佛珠掉到你面前。\n\n" NOR);
        return 1;
}
