#include <ansi.h>

inherit NPC;
string *first_name = ({ "花皮", "背苍", "八爪金角", "金尾虬髯"});
string *name_words = ({ "龙"});
string *name_words2 = ({ "巨龙"});
string *name_words3 = ({ "龙王"});
string *name_words4 = ({ "龙神"});

void create()
{
				string name;
        name = first_name[random(sizeof(first_name))];
        name += name_words[random(sizeof(name_words))];


        set_name(name,({"dragon"}));
        set("race", "野兽");
        set("age", 21);
        set("long", "一只模样高大，极有气势的龙。\n");
        set("str", 80);
        set("cor", 30);
				set("con", 30);
				set("cps", 30);
				set("spi", 30);
				set("int", 30);
				set("family/family_name","东海龙宫");
      	
        set_temp("apply/damage", 25);
        set_temp("apply/armor", 50);
        set("max_kee", 1200);
        set("max_sen", 1200);
				set("force", 2100);
				set("max_force", 1200);
				set("force_factor", 25);
				set("mana", 1000);
				set("max_mana", 1000);
				set("mana_factor", 50);
				set_skill("unarmed", 50);
				set_skill("dodge", 50);
				set_skill("parry", 50);
				set_skill("dragonfight", 50);
				set_skill("dragonstep", 50);
				set_skill("dragonforce", 50);
				set_skill("force", 50);
				map_skill("unarmed", "dragonfight");
				map_skill("dodge", "dragonstep");
				map_skill("force", "dragonforce");
				map_skill("parry", "dragonfight");
				
				
				set("combat_exp", 100000);
				set("daoxing", 100000);
        set("limbs", ({ "头部", "身体", "前爪", "尾巴", "肚皮", "后爪"}) );
        set("verbs", ({ "bite", "claw"}) );
				set_weight(500000);
				set_temp("wuxing/init_done",1);   //防止在setup中初始化错误的五行属性..
        setup();
}

void copy_status(object me,object ob)
{
	string level;
	string name;
	int flag;
	level = ob->query("skill_level/spells");
	if(level=="expert")
		flag = 1;
	else 	if(level=="master")
		flag = 2;
	else 	if(level=="grandmaster")
		flag = 3;	
	else flag = 0;
	if(!userp(ob))
		flag = flag -1;
	if(flag <0) flag = 0;
	
		me->set_skill("unarmed", (int)ob->query_skill("unarmed", 1));
		me->set_skill("dodge", (int)ob->query_skill("dodge", 1));
		me->set_skill("parry", (int)ob->query_skill("parry", 1));
		me->set_skill("dragonfight", (int)ob->query_skill("dragonfight",1) + 20);
		me->set_skill("dragonstep", (int)ob->query_skill("dragonstep", 1)+ 20);
		me->set_skill("dragonforce", (int)ob->query_skill("dragonforce",1) - 20);
		me->set_skill("force", (int)ob->query_skill("force",1) - 20);
	  me->set("combat_exp",ob->query("combat_exp"));
		me->set("daoxing",ob->query("daoxing"));
if(!flag)
{
 me->set("chat_chance_combat", 0);
        me->set("chat_msg_combat", ({
                (: perform_action, "unarmed", "sheshen" :),
								(: exert_function,"shield" :),
                }) );	
	
}	
 if(flag == 1)
	{
			 name = first_name[random(sizeof(first_name))];
        name += name_words2[random(sizeof(name_words2))];
 me->set_name(name,({"megadragon"}));
		    me->set_temp("apply/damage", 50);
        me->set_temp("apply/armor", 100);
        me->set("max_kee", 2100);
 me->set("eff_kee", 2100);
 me->set("eff_sen", 2100);
 me->set("kee", 2100);
 me->set("sen", 2100);
        me->set("max_sen", 2100);
				me->set("force", 4000);
				me->set("max_force", 2100);
				me->set("force_factor", 40);
				me->set("mana", 2100);
				me->set("max_mana", 2100);
				me->set("mana_factor", 80);
			  me->set("leidong",1);
       me->set("chat_chance_combat", 45);
        me->set("chat_msg_combat", ({
                (: perform_action, "unarmed", "sheshen" :),
								(: perform_action, "unarmed", "leidong" :),
								(: exert_function,"shield" :),
                }) );	
		
	}
	else if(flag == 2)
	{
					 name = first_name[random(sizeof(first_name))];
        name += name_words3[random(sizeof(name_words3))];
        
        me->set_skill("seashentong", (int)ob->query_skill("seashentong",1) - 20);
				me->set_skill("spells", (int)ob->query_skill("spells",1) - 20);   
				map_skill("spells", "seashentong"); 
				
 me->set_name(name,({"dragonlord"}));
		    me->set_temp("apply/damage", 80);
        me->set_temp("apply/armor", 200);
        me->set("max_kee", 3500);
        me->set("max_sen", 3500);
 me->set("eff_sen", 3500);
 me->set("sen", 3500);
 me->set("kee", 3500);
 me->set("eff_kee", 3500);
				me->set("force", 3500);
				me->set("max_force", 6500);
				me->set("force_factor", 80);
				me->set("mana", 3500);
				me->set("max_mana", 3500);
				me->set("mana_factor", 120);
			  me->set("leidong",1);
        me->set("chat_chance_combat", 65);
        set("chat_msg_combat", ({
                (: perform_action, "unarmed", "sheshen" :),
								(: perform_action, "unarmed", "leidong" :),
								(: exert_function,"zhenshen" :),	
								(: exert_function,"shield" :),	
								(: cast_spell, "freez" :),		
                }) );	
		
	}
 else if(flag == 3)
	{
				name = first_name[random(sizeof(first_name))];
        name += name_words4[random(sizeof(name_words4))];
 me->set_name(name,({"dragonlord"}));
      	me->set_skill("seashentong", (int)ob->query_skill("seashentong",1) - 20);
				me->set_skill("spells", (int)ob->query_skill("spells",1) - 20);   
				map_skill("spells", "seashentong");
				
		    me->set_temp("apply/damage", 120);
        me->set_temp("apply/armor", 350);
        me->set("max_kee", 5000);
        me->set("max_sen", 5000);
 me->set("kee",5000);
 me->set("sen",5000);
				me->set("force", 5000);
 me->set("eff_kee", 5000);
 me->set("eff_sen", 5000);
				me->set("max_force", 5000);
				me->set("force_factor", 120);
				me->set("mana", 5000);
				me->set("max_mana", 5000);
				me->set("mana_factor", 150);
			  me->set("leidong",1);
			  me->set("pini",1);
			  set("gender","男性");
        set("chat_chance_combat", 80);
        set("chat_msg_combat", ({
                (: perform_action, "unarmed", "sheshen" :),
								(: perform_action, "unarmed", "leidong" :),
								(: exert_function,"zhenshen" :),
								(: perform_action, "unarmed", "pini" :),		
								(: exert_function,"shield" :),		
								(: cast_spell, "freez" :),	
								(: cast_spell, "hufa" :),								
                }) );	
		
	}
	me->delete_temp("wuxing/init_done");
	WUXING_D->init_user_wuxing(me);
}

int heal_up()
{
        if( environment() && !is_fighting() ) {
                call_out("leave", 1);
                return 1;
        }
        return ::heal_up() + 1;
}

void leave()
{
        message("vision",
                HIB + name() +"一个转身，飞向东方，身影渐渐淡去了。\n"
								NOR,environment(),  this_object() );
        destruct(this_object());
}

void invocation(object who)
{       int i;
        object *enemy;

				object me=this_object();
        copy_status(me,who);
        message("vision", HIB"忽然狂风大做，半空现出一条"+ name() +
"来！\n\n"NOR,environment(), this_object() );
        enemy = who->query_enemy();
        i = sizeof(enemy);
        while(i--) {
                if( enemy[i] && living(enemy[i]) ) {
                        kill_ob(enemy[i]);
                        if( userp(enemy[i]) )
													enemy[i]->fight_ob(this_object());
                        else enemy[i]->kill_ob(this_object());
                }
        }

}


