#include <ansi.h>
inherit NPC;

void backattack();
void set_skills(int max_value, int level);
void create()
{ 
        string *order = ({"零零一", "零零二", "零零三", "零零四", "零零五", "零零六", "零零七", "零零八", "零零九"});

	set_name("密探" + (order[random(9)]) , ({ "palaceguard"}) );
	set("long", "这是唐王手下的九大密探之一。专门负责保护官员，刺杀以及窃取情报等任务。\n");
        set("attitude", "friendly");
        set("no_arrest",1); 
        set("max_atman", 100);
        set("atman", 100);
        set("max_mana", 100);
        set("age",25+random(10));
        set("max_gin",2000);
        set("gin",2000);
        set("eff_gin",2000);
        set("mana", 100); 
        set("str", 40);
        set("cor", 30);
        set("cps", 25); 
        set_skill("unarmed",10);
	set_skill("changquan",  10);  
 	map_skill("unarmed", "changquan");
        set("combat_exp", 80000);
        create_family("将军府", 3, "弟子");
       	set_temp("wuxing/init_done",1);   //防止在setup中初始化错误的五行属性..
        setup(); 
      
} 
void init()
{
	add_action("do_kill","kill");
		
}
int do_kill(string arg)
{
	object *inv;
	object who=this_player();
	inv=all_inventory(environment());
	if(arg==query("owner")->query("id"))
		{
			if(who==query("owner"))
			return 0;
			message_vision("$N喝道：快保护好大人！\n",this_object());
			query("owner")->remove_killer(who);
			for (int i=0;i<sizeof(inv);i++)
				{
				if(inv[i]->query("owner")==query("owner")&&inv[i]->is_character())
					inv[i]->kill_ob(who);
				}
			return 1;
			
		}
		return 0;
	
}
int heal_up()
{
        if( environment() && !is_fighting() ) {
                call_out("leave", 1);
                return 1;
        }
           if(query("eff_kee")*100<query("max_kee")*95)
        {
        	command("eat yao");
        	command("exert recover");
        }
        if(query("eff_sen")*100<query("max_sen")*95)
        {
        	command("eat dan");
        	command("exert refresh");
        }	
        if(query("kee")*100<query("max_kee")*80)
        {
        	command("exert recover");
        }
         if(query("sen")*100<query("max_sen")*80)
        {
        	command("exert refresh");
        }
     
        return ::heal_up() + 1;
} 
void leave()
{
        object owner;
        message("vision",
                 name() + "说道：如再有变化，发哨为警！属下先行告退。\n\n"
                + name() + "闪了闪就消失不见了。\n" , environment(),
                this_object() );
        if(objectp(owner=this_object()->query("possessed")))
                owner->add_temp("max_guard",-1);
        destruct(this_object());
} 
void invocation(object who, int level)
{
        int i;
        object *enemy;
       object yao,dan;
       
           
        set("str",12+level/24+random(level/24));
        if (query("str")>40) set("str",40);
       
        set_skills(level,(int)level/150); 
         yao = carry_object("/d/obj/drug/jinchuang");
         yao->set_amount(2+((int)(level/120)));
         yao->set("no_get",1);
         dan = carry_object("/d/obj/drug/hunyuandan");
         dan->set_amount(2+(int)(level/150));
         dan->set("no_get",1);
        set("daoxing", who->query("daoxing")*2/(8-level/150) + random(who->query("daoxing")/(8-level/150))); 
        set("combat_exp", who->query("combat_exp")*2/(8-level/150) + random(who->query("combat_exp")/(8-level/150))); 
        set_temp("apply/damage", 10*(level/120+1));
        set_temp("apply/armor", 24*(level/120+1));
        message("vision",
                 name() + "喝道：大胆！竟敢和朝廷命官作对！\n" NOR,
                environment(), this_object() );
        enemy = who->query_enemy();
        i = sizeof(enemy);
        while(i--) {
                if( enemy[i] && living(enemy[i]) ) {
                        kill_ob(enemy[i]);
                        if( userp(enemy[i]) ) enemy[i]->fight_ob(this_object());
                        else enemy[i]->kill_ob(this_object());
                }
        }
        set_leader(who);
        set("possessed",who);
}
