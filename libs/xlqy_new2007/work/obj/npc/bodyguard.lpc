// heaven_soldier.c

#include <ansi.h>

inherit NPC;

#include "soldier_skill.h"
void create() {
  object ob1, ob2;
  string *order = ({ "一号", "二号", "三号", "四号", "五号", "六号", "七号", "八号", "九号", "十号" });

  set_name("中南海保镖" + (order[random(10)]), ({ "gov bodyguard", "bodyguard" }));
  set("long", "这是负责保护首长的中南海保镖。\n");
  set("attitude", "friendly");

  set("max_gin", 1000);
  set("max_kee", 1000);
  set("max_sen", 1000);
  set("max_force", 200);
  set("force", 200);
  set("force_factor", 5);
  set("max_mana", 200);
  set("mana", 200);
  set("mana_factor", 5);
  set("str", 30);
  set("cor", 30);
  set("cps", 25);

  set("combat_exp", 100000);
  set("daoxing", 100000);
  /*
	set("chat_chance", 15);
	set("chat_msg_combat", ({
		name() + "喝道：孽障！竟敢对？\n"
	}) );
*/
  set_skill("spear", 100);
  set_skill("parry", 100);
  set_skill("dodge", 100);

  setup();

  ob1 = carry_object("/d/obj/armor/tianjia");
  ob1->wear();
  ob1->set("no_sell", "掌柜的瞟了一眼道：这东西一看就是劣等品，不要！不要！\n");
  ob2 = carry_object(__DIR__ "obj/jinqiang");
  ob2->wield();
  ob2->set("no_sell", "掌柜的瞟了一眼道：这东西一看就是劣等品，不要！不要！\n");
}

int heal_up() {
  if (environment() && !is_fighting()) {
    call_out("leave", 1);
    return 1;
  }
  return ::heal_up() + 1;
}

void leave() {
  object owner = this_object()->query("possessed");
  message("vision",
    HIY + name() + "说道：首长，保护任务完成，偶去也！\n\n"
    +name() + "跳入一辆警车，飞驰而去。\n" NOR, environment(),
    this_object());
  owner->add_temp("max_guard", -1);
  destruct(this_object());
}

void invocation(object who) {
  int i;
  object *enemy;

  message("vision",
    HIY "灯光一闪，一彪形大汉出现在眼前。\n\n"
    +name() + "说道：居然敢谋害朝廷命官，想造反吗？\n" NOR,
    environment(), this_object());
  enemy = who->query_enemy();
  i = sizeof(enemy);
  while (i--) {
    if (enemy[i] && living(enemy[i])) {
      kill_ob(enemy[i]);
      if (userp(enemy[i])) enemy[i]->fight_ob(this_object());
      else enemy[i]->kill_ob(this_object());
    }
  }
  set_leader(who);
  give_skill(who, "moonshentong", "sword");
}

void die() {
  object owner = this_object()->query("possessed");
  owner->add_temp("max_guard", -1);
  ::die();
}
