#include <ansi.h>
inherit __DIR__ "diablo_ob";

int is_diablo_set() { return 1; }

int wield() {
  object me = environment();
  if (!objectp(me)) return 0;
  if (!::wield())
    return 0;
  // catch("/obj/diablo_ob/diablo"->check_set(this_object(),me,1));   

  return 1;
}

int wear() {
  object me = environment();

  if (!objectp(me)) return 0;
  if (!::wear()) return 0;
  // catch("/obj/diablo_ob/diablo"->check_set(this_object(),me,1));  

  return 1;
}

int unequip() {
  object me = environment();

  if (!::unequip()) return 0;
  // catch("/obj/diablo_ob/diablo"->check_set(this_object(),me,-1));    
  return 1;
}
