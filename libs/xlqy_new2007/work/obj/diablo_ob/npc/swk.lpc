
#include <ansi.h>

inherit NPC;

void create()
{
   set_name(HIW"孙悟空"NOR,({"warlord"}));
   set("gender","男性");
    create_family("方寸山三星洞", 2, "弟子");
   set("title",HIR"斗战圣佛"NOR);
   set("age",30);
   set("str",50);
   set("per",100);
   set("combat_exp",1000);
        set("attitude", "friendly");
 
   setup();
  
   
}

void copy_status(object me,object ob)
{
  	
  	int *levels, max_level;
	
	 mapping skill=ob->query_skills();
         int i=sizeof(skill);
         if(i>0) 
         {
		levels=values(skill);
		max_level=levels[0];
		while(i--)
		 { // find out victim's maximum level
		    if(levels[i]>max_level)
			max_level=levels[i];
		}
	        max_level=max_level;

	    } else max_level=1;
    	set_skill("unarmed", max_level+random(10));
    	set_skill("dodge", max_level+random(10));
    	set_skill("parry", max_level+random(10));
	set_skill("stick", max_level+random(10));
	set_skill("spells", max_level+random(10));
	set_skill("dao",max_level+random(10));
	set_skill("puti-zhi", max_level+random(10));
	set_skill("wuxiangforce", max_level+random(10));
	set_skill("force", max_level+random(10));
	set_skill("qianjun-bang", max_level+random(10));
	set_skill("jindouyun",max_level+random(10));
	
	map_skill("spells", "dao");
	map_skill("unarmed", "puti-zhi");
	map_skill("force", "wuxiangforce");
	map_skill("stick", "qianjun-bang");
	map_skill("parry", "qianjun-bang");
	map_skill("dodge", "jindouyun");
	
   me->set("str",ob->query("str"));
   me->set("int",ob->query("int"));
   me->set("con",ob->query("con"));
   me->set("per",ob->query("per"));
   me->set("cor",ob->query("cor"));
   me->set("spi",ob->query("spi"));
   me->set("cps",ob->query("cps"));
   me->set("kar",ob->query("kar"));

   me->set("max_kee",ob->query("max_kee"));
   me->set("eff_kee",ob->query("eff_kee"));
   me->set("kee",ob->query("kee"));

   me->set("max_gin",ob->query("max_gin"));
   me->set("eff_gin",ob->query("eff_gin"));
   me->set("gin",ob->query("gin"));

   me->set("max_sen",ob->query("max_sen"));
   me->set("eff_sen",ob->query("eff_sen"));
   me->set("sen",ob->query("sen"));

   me->set("max_force",ob->query("max_force"));
   me->set("force",ob->query("max_force")*2);
   me->set("force_factor",ob->query("max_force")/20);

   me->set("max_mana",ob->query("max_mana"));
   me->set("mana",ob->query("max_mana")*2);
   me->set("mana_factor",ob->query("max_mana")/20);

   me->set("combat_exp",ob->query("combat_exp")*11/10);
   me->set("daoxing",ob->query("daoxing")*11/10);
   
   me->set_temp("apply/armor",ob->query_temp("apply/armor"));
   me->set_temp("apply/damage",ob->query_temp("apply/damage"));
   me->set_temp("apply/attack",ob->query_temp("apply/attack"));
   me->set_temp("apply/defense",ob->query_temp("apply/defense"));
    set("chat_chance_combat", 99);
       set("chat_msg_combat", ({
            (: cast_spell, "thunder" :),
            (: cast_spell,"light" :),
            (: cast_spell,"dingshen" :),
            (: perform_action, "stick", "pili" :),
            (: perform_action," stick","qiankun":),
	     (: perform_action," unarmed","nianhua":),
	     (: exert_function,"jldl":), 
	     name()+"笑道：痛快，痛快，打的真是痛快！\n",
             }) );
	carry_object("/d/obj/weapon/stick/fake-jingubang.lpc")->wield();
	 carry_object("/d/obj/armor/shoupi")->wear();
}

void die()
{
	object who;
        message("vision",
                HIB + name() + "笑道：老孙去也。\n" NOR,environment(),
                this_object() );
        if(who=query("owner"))
         who->delete_temp("swk_set_summon");
        destruct(this_object());
}

int heal_up()
{object who;
   object me=this_object();
   if(!environment(me))
   	return 0;
    	
   who=present(me->query("leader"),environment(me) );
        if( environment() && (!is_fighting() || !objectp(who)  )  ) {	// || !who->is_fighting()
                call_out("die", 1);
                return 1;
        }
   me->set("max_force",who->query("max_force"));
   me->set("force",who->query("max_force")*2);
   me->set("force_factor",who->query("max_force")/20);

   me->set("max_mana",who->query("max_mana"));
   me->set("mana",who->query("max_mana")*2);
   me->set("mana_factor",who->query("max_mana")/20);
   return ::heal_up() + 1;
}

void invocation(object who)
{
   int i;
   object me,*enemy;

   me=this_object();
   me->set("owner",who);
   copy_status(me,who);
 
   enemy=who->query_enemy();
   i=sizeof(enemy);
   while(i--) {
                if( enemy[i] && living(enemy[i]) ) {
                        kill_ob(enemy[i]);
                        if( userp(enemy[i]) ) enemy[i]->fight_ob(this_object());
                        else enemy[i]->kill_ob(this_object());
                }
        }
   set("leader", (string)who->query("id"));
        set_leader(who);
}

varargs int receive_damage(string type, int damage, object who)
{
  return damage;
}
varargs int receive_wound(string type, int damage, object who)
{
  return damage;
}