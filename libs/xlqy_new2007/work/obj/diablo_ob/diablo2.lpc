          if (player->query_temp("diablo_sets/sun_stat") && player->query_temp("diablo_sets/star_stat")) {
            if (player->query_temp("diablo_sets/ocean_stat") && player->query_temp("diablo_sets/moon_stat")
              && player->query_temp("diablo_sets/earth_stat")) {
              player->add_temp("gain_more_reward", -800);
