#include <ansi.h>
#include <dbase.h>
void enable_effect(string type, int amount, object user) {
  mapping skl;
  int j;
  string *snauser;
  switch (type) {

    case "add_kee":
      user->add("eff_kee", amount);
      user->add("max_kee", amount);
      user->add("kee", amount);

      break;

    case "add_sen":
      user->add("eff_sen", amount);
      user->add("max_sen", amount);
      user->add("sen", amount);

      break;
    case "add_force":
      if (!user->query_temp("init_max_force"))
        user->set_temp("init_max_force", user->query("max_force"));

      user->add("max_force", amount);
      user->add("force", amount);

      user->add("diablo_effect/add_force", amount);
      break;
    case "add_mana":
      if (!user->query_temp("init_max_mana"))
        user->set_temp("init_max_mana", user->query("max_mana"));

      user->add("max_mana", amount);
      user->add("mana", amount);
      user->add("diablo_effect/add_mana", amount);
      break;
    case "add_all_skill":
      skl = user->query_skills();
      if (!sizeof(skl)) {
        return;
      }
      j = sizeof(skl);
      snauser = keys(skl);

      for (int k = 0; k < sizeof(snauser); k++)
        user->set_skill(snauser[k], skl[snauser[k]] + amount);

      user->add("diablo_effect/add_all_skill", amount);

      break;
    case "add_bless":
      user->add_temp("combat/bless", amount);
      break;
    case "add_lucky":
      user->add_temp("combat/lucky", amount);
      break;
  }
}
void disable_effect(string type, int amount, object user) {
  mapping skl;
  int j;
  string *snauser;
  switch (type) {

    case "add_kee":
      if (user->query("eff_kee") >= amount)
        user->add("eff_kee", -amount);
      else user->set("eff_kee", 1);
      if (user->query("max_kee") >= amount)
        user->add("max_kee", -amount);
      else user->set("max_kee", 1);
      if (user->query("kee") >= amount)
        user->add("kee", -amount);
      else user->set("kee", -1);
      break;

    case "add_sen":
      if (user->query("eff_sen") >= amount)
        user->add("eff_sen", -amount);
      else user->set("eff_sen", 1);
      if (user->query("max_sen") >= amount)
        user->add("max_sen", -amount);
      else user->set("max_sen", 1);
      if (user->query("sen") >= amount)
        user->add("sen", -amount);
      else user->set("sen", -1);
      break;
    case "add_force":
      if (user->query("max_force") >= amount)
        user->add("max_force", -amount);
      else user->set("max_force", 0);
      user->add("force", -amount);
      user->add("diablo_effect/add_force", -amount);
      break;
    case "add_mana":
      if (user->query("max_mana") >= amount)
        user->add("max_mana", -amount);
      else user->set("max_mana", 0);
      user->add("mana", -amount);
      user->add("diablo_effect/add_mana", -amount);
      break;
    case "add_all_skill":
      skl = user->query_skills();
      if (!sizeof(skl)) {
        return;
      }
      j = sizeof(skl);
      snauser = keys(skl);

      for (int k = 0; k < sizeof(snauser); k++) {
        if (skl[snauser[k]] > amount)
          user->set_skill(snauser[k], skl[snauser[k]] - amount);
        else user->delete_skill(snauser[k]);
        user->add("diablo_effect/add_all_skill", -amount);

      }
      break;
    case "add_bless":
      user->add_temp("combat/bless", -amount);
      break;
    case "add_lucky":
      user->add_temp("combat/lucky", -amount);
      break;
  }
}
int enable_sets_prop(string content, int num, object player)  //必须有num，否则bug
{

