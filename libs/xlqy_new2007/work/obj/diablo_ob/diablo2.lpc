int disable_sets_prop(string content, int num, object player) {
  switch (content) {
    case "dragon_attack":
      {
        if (num == 10) {
          player->add("kee", -1200);
          player->add("eff_kee", -1200);
          player->add("max_kee", -1200);
          player->add_temp("apply/add_max_shui", -3000);
          player->delete_temp("apply/immune_shui");
        } else if (num == 6) {
          player->add("kee", -800);
          player->add("eff_kee", -800);
          player->add("max_kee", -800);
          player->add_temp("apply/add_max_shui", -2000);
        }

      }
      break;
