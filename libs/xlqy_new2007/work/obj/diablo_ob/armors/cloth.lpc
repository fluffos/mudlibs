#include <armor.h>

inherit DIABLO_OB;

void create()
{
        set_name("袍", ({"cloth"}));
	set_weight(1000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("material", "cloth");
                set("unit", "袭");
		set("armor_prop/armor", 1);
		set("armor_type", TYPE_CLOTH);
        }
        setup();
}


