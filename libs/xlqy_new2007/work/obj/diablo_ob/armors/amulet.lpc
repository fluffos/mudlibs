#include <armor.h>

inherit DIABLO_OB;

void create() {
  set_name("护身符", ({ "amulet" }));
  set_weight(500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("material", "bronze");
    set("unit", "枚");
    set("armor_prop/armor", 1);
    set("armor_type", TYPE_AMULET);
  }
  setup();
}
