#include <ansi.h>

inherit EQUIP;

nosave mapping weapon_type = ([
        "axe"    : ({ "chop", "slice", "hack" }),
        "blade"  : ({ "slash", "slice", "hack", "chop" }),
        "dagger" : ({ "pierce", "thrust" }),
        "fork"   : ({ "thrust", "pierce" }),
        "hammer" : ({ "bash", "crush", "slam" }),
        "mace"   : ({ "impale", "bash", "crush", "slam" }),
        "sword"  : ({ "slash", "slice", "thrust", "pierce" }),
        "staff"  : ({ "bash", "crush", "slam", "pierce", "impale" }),
        "stick"  : ({ "bash", "crush", "slam" }),
        "whip"   : ({ "whip","wave" }),
        "spear"  : ({ "thrust", "impale", "pierce" }),
        "xiao"  : ({ "play" }),
        "qin"    :({"play"}),
       
        ]);


void create()
{
        seteuid(0);
        set_name("暗黑装备", ({ "diablo equip" }));

}

string long()
{
        string msg = "随机装备\n";

        if( !query("identification") ) return msg + RED "这样东西还没有鉴定。\n"NOR;

        return msg+"/obj/diablo_ob/diablo"->query_desc(this_object()) ;
}

void setup()
{
        if( query("skill_type") ) {
                set("actions", (: call_other, WEAPON_D, "query_action" :) );
                if( !undefinedp(weapon_type[query("skill_type")]) )
                        set("verbs", weapon_type[query("skill_type")]);
        }
         if( !query("apply/actions") ) {
                   set("apply/actions", (: call_other, WEAPON_D, "query_apply_action" :) );
                   set("apply/verbs", ({ "shoot" }) );
            }
        set_name(query("name"), ({ query("id") }) );
}
int is_diablo_ob() { return 1; }
int valid_equip(object me)
{
        int can;
        if( !objectp(me) ) return 0;

        if( !query("identification")&&!wizardp(me) )
                return 0;
                                can = "/obj/diablo_ob/diablo"->check_valid(this_object(),me);
        if(!can) return 0;

        return 1;
}
int wield()
{
        object me = environment();

        if( !objectp( me ) ) return 0;

        if( !valid_equip(me) )
                return notify_fail("你目前无法装备这样东西。\n");
// if(query("weapon_prop/damage")&&query("diablo_prop/sharp") == 0)
//              return notify_fail("这样东西已经破损，无法装备!\n");
        if( !::wield() )
        {
                
                 return 0;
        }

        catch("/obj/diablo_ob/diablo"->enable(this_object(),me));
catch("/obj/diablo_ob/diablo"->check_set(this_object(),me,1));       
        return 1;
}

int wear()
{
        object me = environment();

        if( !objectp( me ) ) return 0;

        if( !valid_equip(me) )
                return notify_fail("你目前无法装备这样东西。\n");
// if(query("weapon_prop/damage")&&query("diablo_prop/sharp") == 0)
//              return notify_fail("这样东西已经破损，无法装备!\n");
// else if(query("armor_prop/armor")&&query("diablo_prop/rigid") == 0)
//  return notify_fail("这样东西已经破损，无法装备!\n");
        if( !::wear() ) return 0;

        catch("/obj/diablo_ob/diablo"->enable(this_object(),me));
catch("/obj/diablo_ob/diablo"->check_set(this_object(),me,1));       
        return 1;
}

int unequip()
{
        object me = environment();

        if( !::unequip() ) return 0;

        catch("/obj/diablo_ob/diablo"->disable(this_object(),me));
catch("/obj/diablo_ob/diablo"->check_set(this_object(),me,-1));       
        return 1;
}
mixed hit_ob(object me,object victim, int bonus)
{
        int max,ef;
 object wa;
 wa = this_object();
 if(wa->query("weapon_prop/damage"))
 {
        if(wa->query("diablo_prop/combat_hit_kee"))
        {
                if(!random(4))
                {
                ef = wa->query("diablo_prop/combat_hit_kee");
                max = victim->query("max_kee");
                ef = 1+ef*max/10000;
                
                        victim->receive_wound("kee",ef,me);
                        message_vision(BLINK+HIR"$N手中的"+wa->query("name")+BLINK+HIR"突然霞光一闪，直冲$n！\n"NOR,me,victim);
                }
                
        }
 if(wa->query("diablo_prop/combat_hit_sen"))
        {
                if(!random(4))
                {
                ef = wa->query("diablo_prop/combat_hit_sen");
                max = victim->query("max_sen");
                ef = 1+ef*max/10000;
                
                        victim->receive_wound("sen",ef,me);
                        message_vision(BLINK+HIM"$N手中的"+wa->query("name")+BLINK+HIM"突然霞光一闪，直冲$n！\n"NOR,me,victim);
                }
                
        }       
        return 0;
}       
else return 0;       
}


