
#include <armor.h>
#include <ansi.h>

inherit SHIELD;

void create()
{
  set_name( HBYEL HIB " 魔神法盾 "NOR, ({ "moshen-spellsdun", "dun", "shield" }));
  set_weight(5000);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
  set("long",HIC"一面诡异的盾牌，据说是由神魔之血浸过的。\n"NOR);
  set("value",60000000);
  set("no_drop",1);
  set("no_steal",1);
  set("no_give",1);
  set("no_sell",1);
  set("no_break",1);
  set("combine",1);
  set("unit","面");
  set("material", "异类金属");
  set("Fmaterial", "crimsonsteel");
  set("armor/max_armor", 100);
  set("armor_prop/armor", 100);
  set("armor_prop/personality", 1);
  set("armor_prop/courage", 2);
  set("armor_prop/parry", 20);
  set("armor_prop/spells", 50);
  set("wear_msg", "$N拿起一面 "HBYEL HIB" 魔神法盾 \n"NOR);
  set("unequip_msg", "$N放下手中的 "HBYEL HIB" 魔神法盾 \n"NOR);
  }
  setup();
}


