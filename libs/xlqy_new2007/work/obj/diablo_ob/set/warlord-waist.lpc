#include <armor.h>
#include <ansi.h>

inherit DIABLO_OB;

void create() {

  set_name(HIR "战神腰带" NOR, ({ "warlord waist", "waist" }));
  set("weight", 400);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "件");
    set("value", 200000);
    set("no_sell", 1);
    set("no_drop", 1);
    set("no_get", 1);
    set("have_set_name", 1);
    set("combine", 6);
    set("identification", 1);
    set("is_diablo_set", 1);
    set("long", HIR "斗战圣佛纵横四海时佩戴的腰带，能带给你无穷的力量。\n" NOR);
    set("material", "gold");
    set("diablo_set/swk", 5);
    set("armor_prop/armor", 1);
    set("diablo_prop/armor", 50);
    set("diablo_prop/strength", 50);
    set("diablo_prop/composure", 20);
    set("armor_type", TYPE_WAIST);
    set("wear_msg", HIR " 战神腰带 " NOR "散出冲天的红光，照亮了$N的面庞......\n");
    set("unequip_msg", HIR " 战神腰带 " NOR "红光散尽，收入$N行囊中.....\n");
  }

  setup();
}
