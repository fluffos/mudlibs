
#include <armor.h>
#include <ansi.h>

inherit DIABLO_OB;

void create()
{
  set_name( MAG "绚烂紫霞"NOR, ({ "xuanlan-zixia","zixia","neck" }));
  set_weight(2000);
  if( clonep() )
    set_default_object(__FILE__);
  else
  {
  set("long",MAG"一条紫色的丝巾，是盘丝大仙紫霞送给至尊宝的定情之物。\n"NOR);
  set("value",60000000);
  set("no_drop",1);
  set("no_steal",1);
  set("no_give",1);
  set("no_sell",1);
  set("no_break",1);
  set("combine",6);
    set("is_diablo_set",1);
  set("unit","条");
  set("material", "silk");
  set("Fmaterial", "gem");
   set("diablo_set/swk",4);
  set("armor_prop/armor", 60);
  set("diablo_prop/personality", 20);
  set("diablo_prop/karma", 15);
  set("diablo_prop/force", 100);
   set("armor_type", TYPE_NECK);
  set("wear_msg", "$N展开" +MAG"绚烂紫霞"NOR" ，灿丽辉煌的紫气直冲天际，往事如烟尽现眼前......\n");
  set("unequip_msg", "$N长叹一声，挥洒" MAG"绚烂紫霞"NOR"，往事消逝在风中.....\n");
  }
  setup();
}


