#include <armor.h>
#include <ansi.h>
inherit HEAD;

void create()
{
	set_name(HIW"泪珠之盔"NOR, ({ "tear kui", "leizhu", "kui" }));
	set("weight", 400);
	if (clonep())
		set_default_object(__FILE__);
	else {
		set("unit", "顶");
		set("value", 200000);
		set("no_sell",1);
		set("no_give",1);
		set("no_drop",1);
		set("no_get",1);
	    
		set("long",HIW"这是一顶神秘的头盔，能带给你无尽的智慧。\n"NOR);
		set("material", "gold");
		set("armor_prop/armor", 30);
		set("armor_prop/intelligence", 5);
}
 	set("is_monitored",1);
	setup();
}
