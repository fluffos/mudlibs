

#include <ansi.h>
#include <armor.h>

inherit DIABLO_OB;

void create()
{
  set_name( HIW"藕丝步云履"NOR, ({ "sky-boots", "boots" }));
  set("weight", 300);
  if (clonep())
    set_default_object(__FILE__);
  else {
  set("long",HIW"一双传说中的鞋子,轻如鸿毛，软如丝绵。 \n"NOR);
  set("value",60000000);
  set("no_drop",1);
  set("no_steal",1);
  set("no_give",1);
  set("no_sell",1);
  set("no_break",1);
  set("combine",6);
    set("is_diablo_set",1);
  set("unit","双");
  set("material", "fur");
  set("diablo_set/swk",2);
  set("armor_prop/armor", 100);
  set("diablo_prop/spirituality", 10);
  set("diablo_prop/dodge", 100);
  set("armor_type", TYPE_BOOTS);
  set("wear_msg", "$N登上一双 " HIW"藕丝步云履"NOR" 顿时一股神秘的力量直冲云霄......\n");
  set("unequip_msg", "$N将 " HIW"藕丝步云履"NOR" 小心脱了下来。\n");
  }
  setup();
}       
