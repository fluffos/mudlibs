

#include <ansi.h>
#include <armor.h>

inherit DIABLO_SET;
int do_summon();
int check_status(object owner);
void create()
{
  set_name( HIR"战神"HIG"套装"NOR, ({ "warlord sets" }));
  set("weight", 100);
  if (clonep())
    set_default_object(__FILE__);
  else {
  set("long",HIR"斗战圣佛孙悟空当年纵横宇内的装备，拥有了它，就拥有了无尽的力量、勇气和智慧，战无不胜，攻无不克！ \n"NOR);
  set("value",999999999);
  set("no_drop",1);
  set("no_steal",1);
  set("no_give",1);
  set("no_sell",1);
  set("no_break",1);
  set("combine",6);
  set("unit","身");
  set("material", "nothing");
  set("diablo_set","swk_set");
  set("is_diablo_set",1);
  set("armor_prop/armor", 666);
  set("diablo_prop/spirituality", 20);
  set("diablo_prop/strength", 50);
  set("diablo_prop/courage", 20);
  set("diablo_prop/intelligence", 10);
  set("diablo_prop/composure", 20);
  set("diablo_prop/personality", 20);
  set("diablo_prop/constitution", 20);
  set("diablo_prop/karma", 20);
   set("diablo_prop/attack", 100);
    set("diablo_prop/defense", 50);       
  set("diablo_prop/dodge", 150);
  set("diablo_prop/parry", 150);
  set("diablo_prop/force", 150);
  set("diablo_prop/spells",150);
  set("diablo_prop/parry_block_attack",1500);
    set("diablo_prop/skill_double_damage",2500);
    set("diablo_prop/anti_spell_all",1000);
  set("armor_type", TYPE_BOOTS);
  set("wear_msg", "$N浑身霞光毕现，犹如战神降世，齐天大圣再生......\n");
  set("unequip_msg", "$N浑身霞光消失，$N还是原来的$N。\n");
  }
  setup();
}       
void init()
{
	if(this_player()==environment())
	{
	add_action("do_summon","summon");
	add_action("do_summon","zhaohuan");
	call_out("check_status",5,this_player());
	}
	
}
int do_summon()
{
	
	object soldier;
	object me=this_player();
	if(!query("equipped"))
		return 0;
	if(!present("jingu bang",me))
		return notify_fail("没有金箍棒，怎么召唤战神啊！\n");
	if( !me->is_fighting() )
		return notify_fail("只有战斗中才能召唤战神！\n");
      
	if(me->query_temp("swk_set_summon"))
		return notify_fail("你已经召唤过战神了！\n");
		
	message_vision(HIY"$N身上的"HIR"战神"HIG"套装"NOR+HIY"发出耀眼的光芒，一道人影横空而出，笑道：老孙来也！\n"NOR, me);
	soldier = new("/obj/diablo_ob/npc/swk");
	soldier->move(environment(me));
	soldier->invocation(me);
	soldier->set_temp("invoker",me);
	me->set_temp("swk_set_summon",1);
	return 1;
	
}
int check_status(object me)
{
	object *enemy;
	int ap,dp,i;
	if(!me->is_fighting() )
		{
		call_out("check_status",5,this_player());
		return 1;	
			
		}
	if(!query("equipped"))
	{
		call_out("check_status",5,this_player());
		return 1;	
				
		
	}
	        
        enemy=me->query_enemy();
        
        i=sizeof(enemy);
        while(i--) {
               if( enemy[i] && living(enemy[i]) ) {
       
	     	 ap = me->query("combat_exp");
	         dp = enemy[i]->query("combat_exp");
	        if( random(ap+dp) > dp || random(5) >2) 
	         {
	              message_vision(BLINK+HIY"$N浑身散发耀眼夺目的光芒，照得$n"+BLINK+HIY+"眼花缭乱，心神不宁！\n"NOR, me,enemy[i]);
	              if(!enemy[i]->is_busy())
	              enemy[i]->start_busy(2+random(2));
	          }
    	    } 
	}
       call_out("check_status",7,this_player());
	return 1;	
			   
	

}