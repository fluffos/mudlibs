#include <ansi.h>
#include <armor.h>
inherit DIABLO_OB;

void create() {
  set_name(HIM "凤翅紫金冠" NOR, ({ "phoenix'wings-head", "head" }));
  set("weight", 200);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", HIM "一顶旒光溢彩的紫色金盔，左右两边的凤凰展翅欲飞。 \n" NOR);
    set("value", 60000000);
    set("no_drop", 1);
    set("no_steal", 1);
    set("no_give", 1);
    set("no_sell", 1);
    set("no_break", 1);
    set("combine", 6);
    set("unit", "顶");
    set("material", "异类金属");
    set("diablo_set/swk", 3);
    set("is_diablo_set", 1);
    set("armor_prop/armor", 80);
    set("diablo_prop/personality", 10);
    set("diablo_prop/intelligence", 10);
    set("diablo_prop/spells", 100);
    set("armor_type", TYPE_HEAD);
    set("wear_msg", "$N戴上 " HIM "凤翅紫金冠" NOR
      " 顿时如同晚霞一般绚丽灿烂的光辉辉映在$N的头顶......\n");
    set("unequip_msg", "$N将心爱的 " HIM "凤翅紫金冠" NOR " 小心摘了下来。\n");
  }
  setup();
}
