// blade.c

#include <weapon.h>

inherit "/obj/diablo_ob/diablo_set";

void create() {
  set_name("刀", ({ "blade" }));
  set_weight(4000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "柄");
    set("value", 0);
    set("material", "iron");
    //	set("long", "这是一寻常的单刀，份量大约六、七斤重。\n");
    set("wield_msg", "$N抽出一把明晃晃的$n握在手中。\n");
    set("unequip_msg", "$N将手中的$n插入腰间的刀鞘。\n");
  }
  set("weapon_prop/damage", 1);
  set("flag", EDGED);
  set("skill_type", "blade");
  /*	if( !query("actions") ) {
		set("actions", (: call_other, WEAPON_D, "query_action" :) );
		set("verbs", ({ "slash", "slice", "hack", "chop" }) );
	}
	*/
  setup();
}
