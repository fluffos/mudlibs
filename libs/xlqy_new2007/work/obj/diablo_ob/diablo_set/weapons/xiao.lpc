 //竹箫 gamer@88

#include <weapon.h>

 inherit "/obj/diablo_ob/diablo_set";

void create()
{
	set_name("箫", ({"xiao"}) );
	set_weight(6000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "根");
		set("material", "bamboo");
	//	set("long", "一根青翠的竹箫。\n");
		set("value", 0);
		set("wield_msg", "$N拿出一根$n，放在唇边。\n");
		set("unwield_msg", "$N放下手中的$n。\n");
		set("music_type","xiao");
	}
	set("weapon_prop/damage", 1);
	set("flag", TWO_HANDED );
	set("skill_type", "music");
	
	
	setup();
}

