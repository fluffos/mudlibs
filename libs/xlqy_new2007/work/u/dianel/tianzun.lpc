void init() {
  add_action("do_upgrade", "upgrade");

}
int do_upgrade(string arg) {
  string level, item, str;
  int gold;
  object who = this_player();
  if (who->query("9sky/number") < 9) {
    tell_object(who, HIY "你还是先历练历练吧！\n " NOR);
    return 1;

  }

  if (!arg) {
    tell_object(who, HIY "格式为：upgrade <技能id> for 等级(grandmaster)\n " NOR);
    return 1;

  }
  if (sscanf(arg, "%s for %s", item, level) != 2) {
    tell_object(who, HIY "格式为：upgrade <技能id> for 等级(grandmaster)\n " NOR);
    return 1;
  }
  if (level != "grandmaster") {
    tell_object(who, HIY "格式为：upgrade <技能id> for 等级(grandmaster)\n " NOR);
    return 1;
  }
  if (item != "blade" && item != "sword" && item != "spear" && item != "stick" && item != "force"
    && item != "spells" && item != "dodge" && item != "parry" && item != "staff" && item != "hammer" &&
    item != "music" && item != "whip" && item != "fork" && item != "axe" && item != "unarmed" && item != "throwing"
    && item != "mace" && item != "rake" && item != "literate") {
    tell_object(
      who,
      HIY "提供升级的技能有： 杖法 (staff)  、棍法 (stick) 、音律乐理 (music) 、剑法 (sword)
		 法术 (spells) 、内功 (force) 、鞭法 (whip) 、招架 (parry) 、锤法 (hammer) 、叉法 (fork) 、斧法 (axe)
		 轻功 (dodge) 、刀法 (blade)  、拳脚 (unarmed) 、暗器 (throwing) 、锏法 (mace) 、钯法 (rake) 、枪法 (spear) 、读书写字 (literate)\n " NOR
    );
    return 1;
  }
  if (who->query("skill_level/" + item) == "grandmaster") {
    tell_object(who, HIC "你已经是" + to_chinese(item) + "的宗师级了！\n " NOR);
    return 1;
  }

  if (!who->query("skill_level/" + item)) {
    tell_object(who, HIC "你还是先修炼到" + to_chinese(item) + "的专家境界吧！\n " NOR);
    return 1;
  }
  if (who->query("skill_level/" + item) == "expert") {
    tell_object(who, HIC "你还是先修炼到" + to_chinese(item) + "的大师境界吧！\n " NOR);
    return 1;
  }
  if (!LEVEL_D->check_skill_for_level(who, item, level)) {
    tell_object(who, HIR "你的" + to_chinese(item) + "等级尚未达到那个境界！\n " NOR);
    return 1;

  }
  if (!LEVEL_D->check_ob_for_level(who, level) && item != "literate") {
    tell_object(who, HIG "你对本门的贡献还有待考验呀...\n " NOR);
    return 1;

  }


  str = "宗师境界";

  who->set("skill_level/" + item, level);
  who->save();
  tell_object(who, HIW "你的" + to_chinese(item) + "已经升到了" + str + "！\n " NOR);
  message(
    "chat",
    HIY + "【九重天】天极(Tian ji):" + who->name() + "苦经修炼，" + to_chinese(item) + "达到了宗师境界！\n" NOR,
    users()
  );
  return 1;


}

int accept_fight(object me) {
  write(CYN "天极歪着头想了想，说道：好吧。\n" NOR);
  return 1;
}
int recognize_apprentice(object me) {
  int mark;
  object ob = this_player();

  if (ob->query("9sky/number") < 9)
    return notify_fail(HIR "看起来天极想杀死你！\n" NOR);

  if (ob->query_skill("literate", 1) < 300)
    return notify_fail("你的文学功底太差，学好了再来吧！\n");

  mark = ob->query("faith") * 7 / 10 + ob->query("weiwang") * 3 / 10;

  if (mark < 1221 + (ob->query("betray/count")) * 1221 / 2)
    return notify_fail("你对本门不够忠诚，好好努力吧！\n");


  return 1;

}
int prevent_learn(object me, string skill) {
  if (skill == "leadership") {
    if (me->query_skill("literate", 1) < 380) {
      command("say 你的文学功底太差，学好了再来吧！\n");
      return 1;
    }
    if (me->query_skill("leadership", 1) < 240) {
      command("say 你还没入门呢！\n");
      return 1;
    }
    if (me->query_skill("leadership", 1) > 360) {
      command("say 我只能教你这么多了。");
      return 1;
    }
    return 0;
  }
  if (skill == "strategy") {
    if (me->query_skill("literate", 1) < 380) {
      command("say 你的文学功底太差，学好了再来吧！\n");
      return 1;
    }
    if (me->query_skill("strategy", 1) < 240) {
      command("say 你还没入门呢！");
      return 1;
    }
    if (me->query_skill("strategy", 1) > 360) {
      command("say 我只能教你这么多了。");
      return 1;
    }
    return 0;
  }
  if (me->query_skill(me->query_skill_mapped("spells"), 1) < 450
    || me->query_skill("spells", 1) < 450) {
    command("say 你的法术功底太差，学好了再来吧！\n");
    return 1;
  }
  if (me->query_skill(me->query_skill_mapped("force"), 1) < 450
    || me->query_skill("force", 1) < 450) {
    command("say 你的内功功底太差，学好了再来吧！\n");
    return 1;
  }

  return 0;
}
void die() {
  set("eff_kee", 999999);
  set("eff_sen", 999999);
  set("max_kee", 999999);
  set("max_sen", 999999);
  set("sen", 999999);
  set("kee", 999999);
  set("max_force", 99999);
  set("max_mana", 99999);
  set("mana", 99999);
  set("force", 99999);


}
