#include <ansi.h>

int give_armor (object me);

inherit NPC;
void create()
{
     set_name(HIC"无亚子"NOR, ({ "wu yazi", "wu", "yazi" }) );
     set("gender", "男性" );
     set("long",HIY"仙风道骨，气度不凡的老道士！\n"NOR);
     set("age",125);
     set("title", HIW"无量山隐士"NOR);
     set("attitude", "heroism");
     set("str",50);
     set("int",40);
     set("per",40);
     set("max_kee",8000);
     set("kee",8000);
     set("max_sen",8000);
     set("sen",8000);
     set("combat_exp",25000000);
     set("daoxing",75000000);
     set("force",10000);
     set("mana",10000);
     set("max_force",10000);
     set("max_mana",10000);
     set("force_factor",400);
     set("mana_factor",400);
     set("eff_dx", 4500000);
     set("nkgain", 1500);
     
     set_skill("buddhism",400);
     set_skill("moonshentong",400);
     set_skill("taiyi",400);
     set_skill("dao",400);
     set_skill("seashentong",400);
     set_skill("pansi-dafa",400);
     set_skill("dengxian-dafa",400);
     set_skill("pingtian-dafa",400);
     set_skill("baguazhou",400);
     set_skill("taoism",400);
     set_skill("yaofa",400);
     set_skill("gouhunshu",400);
     set_skill("windspells",400);
     set_skill("wanxi-spells",400);
     
     set_skill("spells", 350);
     
     map_skill("spells","buddhism");
     set("inquiry", ([
             "name" : "老夫乃逍遥派祖师爷。",
             "armor":   (: give_armor :),
                     ])
         );
        setup();
        carry_object("/quest/shijienan/item/armor")->wear();
} 
int recognize_apprentice(object ob)
{
	if ( ob->query("faith") < (ob->query("betray/count")+1)*600 )
		return notify_fail("你对本门不够忠诚，下次再来吧！\n");
	if ( ob->query_skill_mapped("spells")=="yaofa" && ob->query("family/family_name")!="陷空山无底洞" )
		return notify_fail("你偷学无底洞的妖法，我不会教你的！\n");
	if ( ob->query_skill(ob->query_skill_mapped("spells"),1)<350 
		|| ob->query_skill("spells",1)< 360 )
		return notify_fail("你的法术功底太差，学好了再来吧！\n");
        if (!(int)ob->query_temp("mark/人"))
             return notify_fail( HIW "你先去十绝阵练练再来学吧！\n"NOR);

        ob->add_temp("mark/人", -1);
   		
        return 1;
}

int give_armor (object me)
{
	object who = this_player();
  	object armor;
	
	if ( who->query_temp("given_armor")==1 )
	{	
		message_vision(RED"你已经要过一次了，不可以太贪心！\n"NOR,me,who);
		return 1;
	}	
	if (who->query("combat_exp")<6000000)
  	{
    		me->command_function("shake");
    		return 1;
  	}
  	armor = new ("/d/npc/obj/armor");
  	who->set_temp("given_armor",1);
   	armor->move(who);
 	message_vision("$N拿出一件黄金战甲给$n。\n",me,who);
 	return 1;
}

