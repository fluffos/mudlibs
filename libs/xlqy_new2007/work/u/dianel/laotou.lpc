#include <ansi.h>
inherit NPC;

int give_gift (object me);

void create()
{
     set_name(HIG"小老头"NOR, ({ "xiao laotou", "laotou"}) );
     set("gender", "男性" );
     set("long",HIY"慈眉善目,穿着一袭青衫，颇有些仙风道骨的气度！\n"NOR);
     set("age",10000);
     set("title", HIC"发礼物的"NOR);
     set("str",50);
     set("int",40);
     set("per",40);
     set("max_kee",8000);
     set("kee",8000);
     set("max_sen",8000);
     set("sen",8000);
     set("daoxing",10000000);
     set("force",10000);
     set("mana",10000);
     set("max_force",10000);
     set("max_mana",10000);
     set("force_factor",500);
     set("mana_factor",400);

     set_skill("buddhism",400);
     set_skill("spells",400);
     set_skill("literate",400);
     map_skill("spells","buddhism");
     set("inquiry", ([
             "name" : "小老儿是来发礼物的。",
             "gift":   (: give_gift :),
             "liwu":   (: give_gift :),
             "礼物":   (: give_gift :),
                     ])
         );
        setup();
//        carry_object("/u/jame/obj/ring")->wear();
}

int give_gift (object me)
{
  object gift;
  object who = this_player();
//return notify_fail("现在还有啥节日么?\n");
  if ( who->query("nationday_gift")==1 )
//  if ( who->query("liuyi_gift")==1 )
  {
          message_vision(RED"你已经要过一次了，不可以太贪心！\n"NOR,me,who);
          return 1;
  }

    gift = new ("/u/dianel/nationdaygift.lpc");
    gift->set("owner_id",who->query("id"));
          who->add("nationday_gift",1);
          gift->move(who);
   tell_object(who,HIY"给各位泥友准备的国庆礼物，黄金周快乐!\n"NOR);
  message_vision("$N笑咪咪的对$n说道:“恩，好好休息！国庆快乐！”，说完给$n一份礼物。\n",me,who);
  return 1;
}
