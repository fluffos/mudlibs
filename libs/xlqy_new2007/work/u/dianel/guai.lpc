void setname()
{
        int i;
	string name;
        i=random(sizeof(names));
	name=names[i]+(random(2)?"精":"怪");
	
	set_name(name, ({ "mo guai", "guai" }) );
	set("title",HIR"魔怪"NOR);
	
		
}

void create()
{        
	setname();
	set("age", 100+random(80));
	set("gender", random(2)?"男性":"女性");
	set("attitude", "heroism");
	set("per", 40);
        set("str", 40);
        set("cor", 40);
        set("con", 40);
        set("int", 40);
        set("spi", 40);
        set("cps", 40);
        set("kar", 40);
        set("max_gin", 1000);
        set("food", 10000);
        set("water", 10000);
				set_skill("unarmed", 40);
				set_skill("dragonfight", 40);
				map_skill("unarmed","dragonfight");
        set("no_steal",1);
        set("taskguai",1);
        set("chat_chance", 5);
	set("chat_msg", ({
	     (: random_move :),
	     	(:  do_bian :)
	}) );
        set("title",HIR"妖怪"NOR);
        carry_object("/d/obj/armor/jinjia")->wear();
        set("inquiry", ([
        "消息": (: ask_xiaoxi :),
	"师门": (: ask_shimen :),
	 ]) );
        set("nk_gain", 200+random(50));
        set("nk_factor", 12);
        set("bellicosity",400);
        set("attitude", "heroism");
        	set_temp("wuxing/init_done",1);   //防止在setup中初始化错误的五行属性..	
	setup();

}

void init ()
{ 
    
    object me=this_object();
    object who=this_player();
    int type;
    int t=query("stay_time");
    ::init();
    add_action("do_persuade", "persuade");
    add_action("do_perform", ({"perform","cast"}));
    add_action("do_burn", "burn");
    add_action("do_swim",({"swim","dive","climb"}));
    
    add_action("do_block","",1);
    if(t && time()>(t+1000)) {
        remove_call_out("leave");
        call_out("leave",1);
        return;
    }

    if(t && time()>t) {
        remove_call_out("_leave");
        call_out("_leave",600);
    }
    if(!living(this_object())) return;
    if(!living(who)) return;
    
    remove_call_out("check_room");
    call_out("check_room",3);
}	

int do_swim()
{
	object me = this_player();
    	object ob = this_object();
    	object obj ;
      if(query("have_bianed"))
     	return 0;
	if (!objectp(obj = query("owner"))) 
		return 0;
	if(obj->query("name")!= me->query("name")) 
		return 0 ;     
	if ( !me->is_busy() ) return 0;
	message_vision(CYN"$N对$n笑道：现在想跑没门了！\n"NOR,ob,me);
  	return 1;
}

int do_burn(string arg)
{
        object me = this_player();
        object ob = this_object();
          if(query("have_bianed"))
     	return 0; 
        if ( !me->is_busy() ) return 0;
        message_vision (CYN"$N对$n笑道：小朋友不要玩火！\n", ob, me);  
        return 1;
} 

int do_perform(string arg)
{
        object me = this_player();
        object ob = this_object();
          if(query("have_bianed"))
     	return 0;  
        if (me->query("xian/kind") != "降"  || ob->query("kind") != "降") return 0;
        message_vision ("$N对$n摇了摇头。\n", ob, me);  
        return 1;
} 

string ask_xiaoxi()
{
  object obj;
   if(query("have_bianed"))
  	return "嗯．．．这我可不清楚，你最好问问别人吧。\n";
  if(objectp(obj = query("owner")))
    return ("听说一个叫"+obj->query("name")+"("+obj->query("id")+")要来找我的麻烦,就是你么?\n");
    return ("我不知道") ;
}

string ask_shimen()
{
	 if(query("have_bianed"))
  	return "对不起，你问的事我实在没有印象。\n";
   return ("我可是出自名门："+query("family/family_name")+"\n");
}

void check_room()
{
    object me=this_object();
    object env=environment(me);
    if(!living(me)) return;
    
    if(env && (env->query("no_fight") ||
                env->query("no_magic"))) {
        random_move();
    }
    
}
void do_bian()
{
	object *inv,env;
	string *name;
	object me = this_object();
	if(random(3))	return;
	if(me->query("have_bianed")&&random(13)) return ;
	env = environment(me);
	inv = all_inventory(env);
	name = me->query_temp("apply/name");
	for(int i = 0;i < sizeof(inv);i ++)
	{
		if(inv[i] == me) continue;
		if(!living(inv[i])) continue;	
		if(userp(inv[i]))  continue;
		if(stringp(name))
		{
			if(name[0]==inv[i]->query("name"))
				continue;	
			
		}
		me->command("bian "+inv[i]->query("id"));
		me->set("have_bianed",1);
		break;
	
	}
	random_move();
	
	
}

int random_place(object me, string* dirs)
{
        int  i, j, k;
        object  newob;
        mixed*  file, exit;

        if( !sizeof(dirs) )  return 0;

        i = random(sizeof(dirs));    // pick up one directory

        file = get_dir( dirs[i]+"/*.lpc", -1 );
        if( !sizeof(file) )             return 0;

	for(k=0;k<30;k++) { // try 30 times
           j = random(sizeof(file));
           if( file[j][1] > 0 ) {
             newob=load_object(dirs[i]+"/"+file[j][0]);
             if (newob) {  
               if(newob->query("no_fight") ||
		       newob->query("no_magic") ||
		       newob->query("no_mieyao") ||
		       !(exit=newob->query("exits")) ||
		       sizeof(exit)<1 ||
		       !newob->query("outdoors") )
		   continue;

               if(me->move(newob)) {
		   message_vision("$N走了过来。\n",me);
		   return 1;
	       }
	     }
	   }
	}

        return 0;
}

string invocation(object me, int level)
{
        object guai,env;        
        string *dirs, where;
        
        dirs=dirs1;
        guai=this_object();
        copy_status(me, level);
	        if(random(5))
  	      set_weight(30000);
        else  set_weight(3000000);
        if(random(5) == 2)
        set("no_arrest",1);
	set("owner", me);
	set("kind",me->query("xian/kind"));
	if( query("kind") == (string)"降" )
        delete("chat_chance_combat");	
        if( query("kind") == (string)"擒" )
        	 set_weight(30000);
        set("chat_chance",level*15+20);
	if(!random_place(guai, dirs))  return "没妖怪。";
	
	env=environment(guai);
	where=guai->query("name");
	  
	if(env)
	 where += "在"+MISC_D->find_place(env);
	
	return where;
	
	
}

void copy_status(object me, int level)
{
	mapping me_skill;
	int *skill_value, max_value, i;
	
	me_skill = me->query_skills();
	i=sizeof(me_skill);
	if(i>0) {
		skill_value=values(me_skill);
		max_value=skill_value[0];
		while(i--) { // 找出玩家skill最大值
		    if(skill_value[i]>max_value)
			max_value=skill_value[i];
		}
	  } else max_value=1;
	 	 
	  set("stay_time",time()+600+random(60));
	 
	  max_value=(int)max_value*0.8;
	 
	 
	 
	  set_skills(max_value, level);
 	  set_hp_status(me,level);
	  this_object()->delete_temp("wuxing/init_done");
	  WUXING_D->init_user_wuxing(this_object());	 
	    
}	  
	  
void set_skills(int max_value, int level)
{
	object guai=this_object();	 
	int guai_value;
	
	if (level==1) guai_value = max_value+max_value/8;
	else if (level==2) guai_value = max_value+max_value/6;
	else guai_value = max_value+max_value/4;
	
	set_skill("unarmed", guai_value+random(16));
	set_skill("dodge", guai_value+random(16));
	set_skill("parry", guai_value+random(16));
	set_skill("force", guai_value+random(16));
	set_skill("spells", guai_value+random(16));
	set_temp("apply/regenerate_force",guai_value/5+random(guai_value/5));
	set_temp("apply/regenerate_kee",guai_value/5+random(guai_value/5));
	set_temp("apply/regenerate_sen",guai_value/5+random(guai_value/5));
	set_temp("apply/regenerate_mana",guai_value/5+random(guai_value/5));
}	


void set_hp_status(object me, int level)
{       int max_kee,max_sen,skill_force,maximum_mana,exp,daoxing;
        max_kee = me->query("max_kee");
        max_sen = me->query("max_sen");
        skill_force = query_skill("force");
        maximum_mana = me->query("max_mana");
        exp = me->query("combat_exp");
        daoxing = me->query("daoxing");
	
	set("max_force", skill_force*10);
	set("force", skill_force*20);
	set("force_factor", skill_force/2);
//	set("mana_factor", query_skill("spells",1));
	set("mana_factor", query_skill("spells",1)/2+random(query_skill("spells",1))/2);
	
	if (level==1)
	   {
	   	set("max_kee", max_kee*2);
	   	set("eff_kee", max_kee*2);
	   	set("max_sen", max_sen*2);
	   	set("eff_sen", max_sen*2);
	   	set("kee", max_kee*2);
	   	set("sen", max_sen*2);
	   	set("max_mana", maximum_mana);
	   	set("mana",maximum_mana*2);
	   	set("combat_exp", exp+exp*1/8+random(exp*1/8));
	   	set("daoxing", daoxing+daoxing*1/8+random(daoxing*1/8));
	       set_temp("apply/armor", 180+random(90));
	        set_temp("apply/damage", 120+random(30));
	     
	   }
	   
	else if (level==2)
	   {
	   	set("max_kee", max_kee*3);
	   	set("eff_kee", max_kee*3);
	   	set("max_sen", max_sen*3);
	   	set("eff_sen", max_sen*3);
	   	set("kee", max_kee*3);
	   	set("sen", max_sen*3);
	   	set("max_mana", maximum_mana);
	   	set("mana",maximum_mana*2);
	   	set("combat_exp", exp+exp*1/6+random(exp*1/6));
	   	set("daoxing", daoxing+daoxing*1/6+random(daoxing*1/6));
	         set_temp("apply/armor",240+random(120));
	        set_temp("apply/damage", 150+random(50));
	     
	   }   
	   
	 else if (level==3)
	   {
	   	set("max_kee", max_kee*4);
	   	set("eff_kee", max_kee*4);
	   	set("max_sen", max_sen*4);
	   	set("eff_sen", max_sen*4);
	   	set("kee", max_kee*4);
	   	set("sen", max_sen*4);
	   	set("max_mana", maximum_mana);
	   	set("mana",maximum_mana);
	   	set("combat_exp", exp+exp*1/3+random(exp*1/3));
	   	set("daoxing", daoxing+daoxing*1/3+random(daoxing*1/3));
	        set_temp("apply/armor", 360+random(180));
	        set_temp("apply/damage", 180+random(60));
	       
	   }   
        else
	   {
	   	set("max_kee", max_kee*5);
	   	set("eff_kee", max_kee*5);
	   	set("max_sen", max_sen*5);
	   	set("eff_sen", max_sen*5);
	   	set("kee", max_kee*5);
	   	set("sen", max_sen*5);
//	   	set("max_mana", maximum_mana*3/2);
//	   	set("mana",maximum_mana*3);		alading 2002-8-8
	   	set("max_mana", maximum_mana*4/3);	
	   	set("mana",maximum_mana*8/3);
	   	set("combat_exp", exp+exp*(level-2)/4);
	   	set("daoxing", daoxing+daoxing*(level-2)/4);
	       set_temp("apply/armor", (level-1)*120+random(200));
	        set_temp("apply/damage",210+random(90));
	        
	   }  
	 
}

int accept_fight(object ob)
{	
        object me=this_object();
	
	  if(query("have_bianed"))
  	return 0;
  	if (ob != owner())
	{message_vision(CYN"$N说道：快走开，要不我吃了你。\n"NOR,me);
	 return 0;
	}
	else {if ( query("kind")!="降" )
	           {
	           	command("say 我不找你，你倒送上门来了，我就成全了你。");
	                me->kill_ob(ob);
	                return 1;
                   }
                else {  
                	if ( query("eff_kee") < query("max_kee") 
                	     || query("eff_sen") < query("max_sen") )
                	     {message_vision(CYN"$N说道：我受伤了，这样打不公平吧。\n"NOR,me);
                	      return 0;
                	     }
                	if ( me->is_busy() )
                	{
                		message_vision(CYN"$N说道：我正忙呢，想送死不用心急。\n"NOR,me);
                	      return 0;
                	}
                	command("exert recover");
                	command("exert refresh");	// alading 2002-5-26
                	command("say 废话少说，尽管放马过来，看谁怕谁。");
                	remove_call_out("check_result");
	                call_out("check_result", 1, me, ob);
                	return 1;
                     }
              }                  
}                 



void heart_beat()
{  

    object weapon;
    string map_skill = "unarmed" ;
    object guai = this_object();
   
   if ( !is_fighting()
        && query("eff_kee") >= query("max_kee") / 2 
 && query("kind") != "降" &&random(2))
   {  if(query("eff_kee") <  query("max_kee"))    
        command("exert heal");
 set("force_factor", query_skill("force")/2);
   }   
 if (query("kee") < query("eff_kee")-10 && query("kind") != "降"&&random(2))
         command("exert recover");
 if ((query("sen") < query("eff_sen")-300)&&random(2))
     command("exert refresh");
   if (query("force") < query("max_force"))
     command("cast transfer");
   if (!owner() || owner()->query("xian/fail") )    
       {
       	  destruct(guai); 
       	  return;
       	}  
   

  ::heart_beat();   
}       


int check_result(object me, object ob)
{
	int guai_max_kee, ob_max_kee;
	int guai_max_sen, ob_max_sen;
	if(!me) return 1;
	if(!ob) return 1;
	guai_max_kee  = me->query("max_kee");
	ob_max_kee = ob->query("max_kee");
	
	guai_max_sen  = me->query("max_sen");
	ob_max_sen = ob->query("max_sen");
	
	
	if ( !living(me) 
		|| (int)me->query("kee") < 1 
		|| (int)me->query("sen") < 1 ) return 1;
	
	if (((int)me->query("kee")*100/guai_max_kee) <= 50 ||((int)me->query("sen")*100/guai_max_sen)<= 50 )
	      {
	      	if ( !living(me) 
			|| (int)me->query("kee") < 1 
			|| (int)me->query("sen") < 1 ) return 1;
		ob->remove_enemy(me);
		me->remove_enemy(ob);	
		if (random(5) < 1)  command ("say 我还没准备好，你就开打了，不算数。");	//  alading  2002-6-25
		      else { 
		      	
		    if(environment(owner())==environment() && living(owner())) {
		      	if (ob->query_temp("xian/fight_time")&&me->query("fight_num"))
		                   { command ("say 我现在方知天外有天，人外有人，我还要回山多多修炼，告辞了。");
		   	             ob->set("xian/accomplish",1);
		   	             ob->set("xian/end_time",time());
		   	             ob->delete_temp("xian/fight_time");
		   	             ob->delete("xian/get");
              this_object()->set("is_diablo_npc",1);
              this_object()->set("magic_find",150+random(150));
             DIABLO_D->diablo_drop(this_object(),ob);
		                     reward(ob);            
		   	             destruct(me);
		   	             return 1;
		   	            }
		     	         else { command ("say 我一时大意，也没尽全力，我不服，再比一次。");
		   	                ob->set_temp("xian/fight_time",1);
		   	                return 1;
		                        }
                             }
                        }
                        
               }
                    
            else if (((int)ob->query("kee")*100/ob_max_kee) <= 50 ||((int)ob->query("sen")*100/ob_max_sen)<= 50) {
                 	command("say 哈哈，你输了，快滚吧!");
                 	return 1;
                  }
                  
        if (me->is_fighting())
	{
		call_out("check_result",1, me, ob);
		return 1;
	}
}

int do_persuade(string arg)
{
	object me =this_player();
	object ob;
	int guai_max_kee,guai_eff_kee;
	int guai_max_sen,guai_eff_sen;
	if(!arg) return 0;
	if(query("have_bianed"))
  	return 0;
	ob = present(arg, environment(me));
	if (!ob)   return notify_fail("你要劝谁？\n");
	if (me->query("xian/kind") != "劝"  || ob->query("kind") != "劝") return 0;
	
	if (me->is_busy())
	     return notify_fail("你正忙着呢。\n");
	
	me->command("say 放下屠刀，立地成佛。");
	
	if ( !living(ob) )   return notify_fail("很显然，"+ob->name()+"听不见你说的话。\n");
	
	if ( me != ob->query("owner") || !ob->is_fighting(me) )
	     { message_vision(CYN"$N说道：你罗嗦些什么，快滚开。\n"NOR,ob);
	       return 1;
	      }
	 	 
	 guai_max_kee = ob->query("max_kee");
	 guai_eff_kee = ob->query("eff_kee");
	  guai_max_sen = ob->query("max_sen");
	 guai_eff_sen= ob->query("eff_sen");
	 if ( guai_eff_kee*100/guai_max_kee < 10 ||guai_eff_sen*100/guai_max_sen < 10)
	      {
	      	command("say 你说的有道理，我这就回山去。");
	      	me->set("xian/end_time",time());
	       	me->delete("xian/get");
              ob->set("is_diablo_npc",1);
              ob->set("magic_find",150+random(150));
             DIABLO_D->diablo_drop(ob,me);
	        reward(me);
	        destruct(ob);
	        return 1;
	       }
	       
	   else if ( guai_eff_kee*100/guai_max_kee < 30||guai_eff_sen*100/guai_max_sen < 30 )
	        {
	        	command("say 你看我现在，不比做神仙快乐吗。");
	        	me->start_busy(1+random(3));
                        return 1;
                 }
                 
            else {
            	     me->start_busy(1);
            	     return notify_fail(ob->name()+"正专心致志战斗，懒得理你。\n");
            	  }
}


void die()
{       object me = owner();
        object ob = this_object();
             object bs;
	if (me->query("xian/kind") == "杀"  && query("kind") == "杀")
	     {me->set("xian/accomplish",1);
	      me->set("xian/end_time",time());
      	    ob->set("is_diablo_npc",1);
      	    ob->set("magic_find",150+random(150));
      	    DIABLO_D->diablo_drop(ob,me);
	      reward(me);
	      me->delete("xian/get");
	     }	     
	else { me->delete("xian/get");
	       me->set("xian/fail",1);
	     } 
        if (me->query("xian/level")==5) 
	 {     
	 	if(random(2))  
	      		bs = new("/d/baoshi/obj/xc_r");  
	      	else if(random(2))  
	      		bs = new("/d/baoshi/obj/xc_g"); 
	      	else 
	      		bs = new("/d/baoshi/obj/xc_y");  
	      		 
	      bs->move(ob);
	 }
	  else if (me->query("xian/level")==4) 
	 {       
	     if(random(2))  
	      		bs = new("/d/baoshi/obj/sl_r");  
	      	else if(random(2))  
	      		bs = new("/d/baoshi/obj/sl_g"); 
	      	else 
	      		bs = new("/d/baoshi/obj/sl_y");  
	      	 bs->move(ob);
	 }  
	  else if (me->query("xian/level")==3&&!random(2)) 
	 {       
	     if(random(2))  
	      		bs = new("/d/baoshi/obj/sl_r");  
	      	else  
	      		bs = new("/d/baoshi/obj/sl_g"); 
	      	
	      	 bs->move(ob);
	 }  
	   else if (me->query("xian/level")==2&&!random(4)) 
	 {       
	     if(random(2))  
	      		bs = new("/d/baoshi/obj/sl_r");  
	      	else  
	      		bs = new("/d/baoshi/obj/sl_g"); 
	      	
	      	 bs->move(ob);
	 }  
	   else if (me->query("xian/level")==1&&!random(6)) 
	 {       
	     if(random(2))  
	      		bs = new("/d/baoshi/obj/sl_r");  
	      	else  
	      		bs = new("/d/baoshi/obj/sl_g"); 
	      	
	      	 bs->move(ob);
	 }  
	::die();
}


int accept_object (object who, object ob)
{
  object guai;
 int max_kee,max_sen;
  guai = this_object();
  max_kee = 100+guai->query("max_kee")/100+random(guai->query("max_kee")/100);
  max_sen = 100+guai->query("max_sen")/100+random(guai->query("max_sen")/100);
  if(query("have_bianed"))
  	return 0;
  
  if ( ob->name() != "金创药" || ob->query("id") != "jinchuang yao" )
       { message_vision(CYN"$N说道：这是什么玩意儿，想毒死我啊。\n"NOR,guai);
         return 0;
        }
    else { guai->receive_curing("kee", max_kee);
           guai->receive_curing("sen", max_sen);
           command("exert recover");
           call_out ("destruct_ob",1,ob);
           if ( query("eff_kee") == query("max_kee") )
    {           set("fight_num",1);                
message_vision(CYN"$N说道：我好了，来来来，咱们再大战三百回合。\n"NOR,guai);
    }     
      return 1;
          }
}

void destruct_ob (object ob)
{
  destruct (ob);
}

void kill_ob (object ob)
{
	  object me = this_object(); 
	 // if (me->query("level")==5)
	 //     me->set_leader(ob);
	    ::kill_ob(ob);
}	    


void reward(object me)
{
	int wuxue,level,kind_bonus,level_bonus,timep;
	int extra_bonus,potential_bonus,combat_exp_bonus,daoxing_bonus;
	string str,kind,time,msg;
	object killer,who;
        int max_kee, max_sen, ratio;	
	string skill="none";
       	
    /*   	if (!objectp(who = query("owner"))) return ;
	if (!objectp(killer = query_temp("last_damage_from"))) return ;
	if (who->query("id")!=killer->query("id")) 
	{
	 tell_object(me,"这个任务不是你亲自做的，没有任何奖励。\n");
	 return;
	}     
   */	     
          max_kee=query("max_kee");
          max_sen=query("max_sen");
	  ratio=100*(max_kee-other_kee)/max_kee;
	  if(ratio<0) ratio=0;
	  ratio=ratio*(max_sen-other_sen)/max_sen;
	  if(ratio<0) ratio=0;	     

	wuxue = me->query("combat_exp");
	level = me->query("xian/level");
	kind  = me->query("xian/kind");     
        timep = me->query("xian/end_time")-me->query("xian/start_time");
        time  = chinese_time(timep);
//  alading adjusting  2002-4-8        
        if ( level == 1 ) level_bonus=700;
        else if ( level == 2 ) level_bonus=900;
        else if ( level == 3 ) level_bonus=1100;
        else if ( level == 4 ) level_bonus=1300;
        else level_bonus=1500;
        
        if ( kind == "劝" ) kind_bonus=1000;
        else if ( kind == "杀" ) kind_bonus=800;
        else if ( kind == "擒" ) kind_bonus=1100;
        else kind_bonus=900;
        
        extra_bonus = me->query("combat_exp")/1500000; //M数
        daoxing_bonus = me->query("daoxing")/1500000;
        if(extra_bonus > 12 )extra_bonus = 12;  
        if(extra_bonus < 3 )extra_bonus = 3; 
        if(daoxing_bonus > 12 )	daoxing_bonus = 12;	// alading 2002-5-24  
        if(daoxing_bonus < 2 )	daoxing_bonus = 2; 
 
        extra_bonus = extra_bonus/2 + random(extra_bonus/2);
        daoxing_bonus = daoxing_bonus/2 + random(daoxing_bonus/2);
        
        potential_bonus = level_bonus*extra_bonus*(ratio+random(10))/130+kind_bonus;
        combat_exp_bonus =kind_bonus*extra_bonus*(ratio+random(10))/100+level_bonus ;
        daoxing_bonus = (level_bonus+kind_bonus)*daoxing_bonus*ratio/200;

        potential_bonus = potential_bonus*(10000+me->query("gain_more_reward")+me->query_temp("gain_more_reward"))/10000;
        combat_exp_bonus = combat_exp_bonus*(10000+me->query("gain_more_reward")+me->query_temp("gain_more_reward"))/10000;
        daoxing_bonus = daoxing_bonus*(10000+me->query("gain_more_reward")+me->query_temp("gain_more_reward"))/10000;
        
        me->add("potential", potential_bonus);
        me->add("combat_exp", combat_exp_bonus);
        me->add("daoxing", daoxing_bonus);
        
     
        str = "得到了"+potential_bonus+"点潜能，";
        str +=combat_exp_bonus+"武学经验，";
        str += COMBAT_D->chinese_daoxing(daoxing_bonus)+"道行。";
        // str += "ratio"+ ratio;
        
        if(level >3&&other_kee==0&&other_sen==0) 
        {  
            if(random(3)==0) {        
           skill=give_reward(me);
           str +="并奖励了一级"+to_chinese(skill);}
        }      
             
        tell_object(me,"你得到了"+potential_bonus+"点潜能，"+combat_exp_bonus+"武学经验，"+COMBAT_D->chinese_daoxing(daoxing_bonus)+"道行。\n");
        str = me->name()+"完成了一个难度"+chinese_number(level)+"的"+kind+"妖任务，" + str;
        message("channel:rumor",HIY"【原始天尊】："+str+"\n"NOR,users());
        MONITOR_D->report_system_msg (str);
       // log_file("taskreward",sprintf("[%s]%s\n",ctime(time()),str));
        
        switch (kind)
          {case "杀": {
          	        me->add("xian_log/kill_potential",potential_bonus);
                        me->add("xian_log/kill_combat",combat_exp_bonus);
                        me->add("xian_log/kill_daoxing",daoxing_bonus);
          	
          	        switch (level)
                            {case 1:{me->add("xian_log/kill1",1);
                                     break;
                                     }
                              case 2:{me->add("xian_log/kill2",1);
                                      break;
                                     }
                              case 3: me->add("xian_log/kill3",1);
                             }
                         break;
                      }
          case "擒": {
          	        me->add("xian_log/arrest_potential",potential_bonus);
                        me->add("xian_log/arrest_combat",combat_exp_bonus);
                        me->add("xian_log/arrest_daoxing",daoxing_bonus);
          	
          	        switch (level)
                            {case 1:{me->add("xian_log/arrest1",1);
                                     break;
                                     }
                              case 2:{me->add("xian_log/arrest2",1);
                                      break;
                                     }
                              case 3: me->add("xian_log/arrest3",1);
                             }
                         break;
                      }
          case "劝": {
          	        me->add("xian_log/persuade_potential",potential_bonus);
                        me->add("xian_log/persuade_combat",combat_exp_bonus);
                        me->add("xian_log/persuade_daoxing",daoxing_bonus);
          	
          	        switch (level)
                            {case 1:{me->add("xian_log/persuade1",1);
                                     break;
                                     }
                              case 2:{me->add("xian_log/persuade2",1);
                                      break;
                                     }
                              case 3: me->add("xian_log/persuade3",1);
                             }
                         break;
                      }
          case "降": {
          	        me->add("xian_log/fight_potential",potential_bonus);
                        me->add("xian_log/fight_combat",combat_exp_bonus);
                        me->add("xian_log/fight_daoxing",daoxing_bonus);
          	
          	        switch (level)
                            {case 1:{me->add("xian_log/fight1",1);
                                     break;
                                     }
                              case 2:{me->add("xian_log/fight2",1);
                                      break;
                                     }
                              case 3: me->add("xian_log/fight3",1);
                             }
                     }                        
          }
}                               

string chinese_time(int timep)
{
        int t, d, h, m, s;
        string time;
        t = timep;
        s = t % 60;             t /= 60;
        m = t % 60;             t /= 60;
        h = t % 24;             t /= 24;
        d = t;

        if(d) time = chinese_number(d) + "天";
        else time = "";

        if(h) time += chinese_number(h) + "小时";
        if(m) time += chinese_number(m) + "分";
        time += chinese_number(s) + "秒";
        
        return time;
}

void _leave()
{
        object me=this_object();
        if(me->is_fighting() || me->is_busy())
        return;
        leave();
}

void leave()
{
      if(this_object()) {
        if(environment())
{
          message("vision",HIB + name() + 
                  "身子一晃，变成一股青烟散去了。\n" NOR,environment());
}
        destruct(this_object());
      }
      return;
   }
int do_block(string arg)
{            
            
    object who=this_player();
    object me = this_object();
    string verb=query_verb();
    object obj ;
    int t;
    
    // wizardp(who) && 
      if(query("have_bianed"))
  	return 0;
    if (!objectp(obj = query("owner"))) return 0;
    if(!userp(who)||!visible(who)) return 0;
    if(!living(me)) return 0;
    if(obj->query("name")!=who->query("name")) return 0 ;          
    if(verb!="go" && verb!="fly" && verb!="cast chuqiao" &&  verb!="cast tuoqiao"
      	&& verb!="cast huodun" && verb!="cast shudun" && verb!="cast townportal"
      	&& verb!="cast ygbh" && verb!="cast wuxing" && verb!="cast escape" && verb!="cast tudun" 
      	&& !(environment() && environment()->query("exits/" + verb)))
      return 0;
    
    t= random(4);
   
    if (t==1) {
        
    message_vision(CYN"$n乘$N一个不注意，急忙溜了过去。\n"NOR,me,who);
        return 0;
    }        
     message_vision(CYN"$N说:现在想跑? 来不急了!\n"NOR,me,who);
    tell_object(who,me->name()+"一把拦住了你！\n");
         return 1;
}

varargs int receive_wound(string type, int damage, object who)
{
    
    object me = owner();
   
             
    if(who && who->query("id")!= me->query("id")&& userp(who)) {
	if(damage>0) {
	    switch(type) {
		case "kee": other_kee+=damage; break;
		case "sen": other_sen+=damage; break;
	    }
	}
    }
    return ::receive_wound(type, damage, who);
}

varargs int receive_damage(string type, int damage, object who,string kind)
{
    object me = owner();
    
    if(who && who->query("id")!= me->query("id")&& userp(who)) {
	if(damage>0) {
	    switch(type) {
		case "kee": other_kee+=damage; break;
		case "sen": other_sen+=damage; break;
	    }
	}
    }
    return ::receive_damage(type, damage, who, kind);
}

void to_escape()
{
// 随机逃跑
        
        object guai,env;        
        string *dirs, where;
        dirs=dirs1;
        guai=this_object();
      	
      	message("vision",CYN + name() + 
                  "起个云头，将身一纵跳在半空，一拱手道：你家大爷我没空陪你玩了，这就去也！ 
。\n" NOR,environment());     	

        remove_call_out("to_escape");
      	if(!random_place(guai, dirs)) return ;
 	env=environment(guai);
	where=guai->query("name");
	if(env)
        where += "在"+MISC_D->find_place(env);
	owner()->set("xian/where",where);
        
	return ;
}

