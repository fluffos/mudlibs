#include <ansi.h>
inherit ITEM;


void create()
{
 set_name(HIW"一天的十一祝福"NOR,({"nationday gift","gift"}));
        set_weight(100);
        if (clonep())
                set_default_object(__FILE__);
        else {
set("long", HIW"一天给各位泥友的节日礼物，赶紧(show)一下吧。\n"NOR);
set("unit", "滴");
set("no_give",1);
set("no_get",1);
set("no_sell",1);
set("no_drop",1);
set("no_put",1);
set("no_steal",1);
               
        }
}


void init()
{
 if(this_player()==environment())
add_action ("do_eat", "show");

}
int do_eat(string arg)
{
        int i;
        object who = this_player();
 if (arg != this_object()->query("id"))
return 0;
 if (who->query("nationday_gift")>1) return notify_fail("你咋这么贫涅，小鬼不要多吃，吃多了会不消化的！~！！\n");
/*
if(who->query("combat_exp") < 500000) return 1;
message_vision(HIM"眼泪化作一只美丽的蝴蝶飞走了～\n"NOR,this_player());
who->set("is_diablo_npc",1);
 who->set("magic_find",4000+random(3000));
for(i =0;i < 3;i++)
{
DIABLO_D->diablo_drop(who,who);
}
who->delete("is_diablo_npc");
who->delete("magic_find");

*/
if(who->query("combat_exp") < 300000)  { who->add("combat_exp",10000);who->add("daoxing",2000);who->add("potential",20000);}
   who->add_maximum_force(200);
   who->add_maximum_mana(200);
   who->add("skills_point",3);
message_vision(HIM"你觉得浑身一阵轻松，看来长假休息就是好啊！~~~\n"NOR,this_player());
this_object()->move("/obj/void");
remove_call_out("dest");
call_out("dest",1);
return 1;
}
void dest()
{

destruct(this_object());
}
