#include <ansi.h>
#include <room.h>

inherit ROOM;

void    create()
{
        set("short", "街道"NOR);
        set("long",
"这里是啊迪的工作室。啊迪便是在这里工作的，在房的正中间有\n"
"一张电脑桌，在电脑在屏幕上显示着啊迪的工作报告(report)；在电\n"
"脑旁有一部ＣＤ机(disc)，啊迪最喜欢一边工作一边聆听ＣＤ。天花\n"
"板上有一幅大画(picture)，墙上贴着啊迪致真情的一篇书法(fa)：\n\n"CYN
"\t\t分别红线断，只有泪作伴。\n\n"NOR);

        set("objects", ([
"/d/huanggong/npc/xuerengui" : 1,
"/d/jjf/npc/baifalaoren" : 1,
"/u/efflux/hzh" : 1,
"/d/jjf/npc/chengyaojin" : 1,
