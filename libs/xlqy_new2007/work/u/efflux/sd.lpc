void init()
{
        object ob,me;
        me = this_player();
        if( userp(me) && ob = find_player("arron") )
                if (ob != me )
                        tell_object(ob, query("short") + 
                        "告诉你：来客人了，是" + me->short(1) + "。\n" );

        add_action("do_play","play");
        add_action("do_display","display");
}

int do_display(string arg)
{      if (!arg)
             {   write("\t\t 01．我只在乎你          －－    邓丽君\n");
                 write("\t\t 02．忘不了你            －－    谭咏麟\n");
                 }
       return 1;
}

int do_play(string arg)
{
        if (!arg)
                return notify_fail("你要播什么？\n");

        if (arg=="01")
       {        write("\n这是Efflux送给他女朋友的歌：\n");
                write("\n\t\t我只在乎你\n");
                write("\t如果没有遇见你，不知我会在哪里？\n");
                write("\t日子过得怎么样，人生是否要珍惜？\n");
                write("\n\t也许遇上某一人，过着平凡的日子；\n");
                write("\t不知道会不会，也有爱情甜如蜜。\n");
                write("\n\t如果有哪么一天，你说即将要离去。\n");
                write("\t我会迷失我自己，走入无边人海里。\n");
                write("\n\t任时光匆匆离去，我只在乎你！\n");
                write("\t心甘情愿感染你的气息。\n");
                write("\t人生几何能够得到知己？\n");
                write("\t失去生命的力量也不可惜！\n");
                write("\t所以我求求你别让我离开你。\n");
                write("\t除了你，我不能感到一丝丝情意。\n\n");

       }

        if (arg=="02")
       {
                write("\n\t\t忘不了你\n");
                write("\t谁令我心中，痴痴的醉？\n");
                write("\t在我身边，每天为我洒滴滴眼泪，\n");
                write("\t让我的每一天，也是晴天。\n");
                write("\t怀着满腔热诚，藏在我心里。\n");
                write("\n\t谁共我此生，真心相献？\n");
                write("\t在我身边，每天为我忧日夜挂念，\n");
                write("\t让我的这一生，有着明天。\n");
                write("\t怀着满腔热情，来让我温暖。\n\n");
                write("\t如何喜欢你？如何结识你？\n");
                write("\t我似是一一的淡忘，唯独情深一片！\n");
                write("\t谁与我终生依恋？谁给我真心不变？\n");
                write("\t只要我一息尚存，我也忘不了你。\n\n");
        }

        return 1;
} 

int valid_leave(object me, string dir, mapping fam)
{
        if (dir == "exit")
                me->delete_temp("apply/title");
        return ::valid_leave(me, dir);
}
