// butterfly.c
// by efflux

#include <armor.h>
#include <ansi.h>
inherit F_AUTOLOAD;
inherit HEAD;
int amount;

void create()
{
        set_name(HIM"蝴蝶"NOR, ({ "butterfly"}));
        set("weight", 100);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "只");
                set("value", 100);
                set("material", "steel");
                set("armor_prop/armor", 1);
                set("no_drop","这件东西不能离开你。\n");
                set("no_get","这件东西不能离开那里。\n");
                set("wear_msg", NOR "$N从小竹笼中把"+this_object()->query("name")+"放了出来，"+this_object()->query("name")+"愉快地绕着$N飞了几圈，然后停在$N的头上。\n" NOR);
                set("remove_msg", NOR "$N从怀中取出一朵"HIM"极品"NOR+HIR"红玫瑰"NOR"，"+this_object()->query("name")+"愉快地飞进$N的怀里。\n" NOR);
set("long",
"飞啊飞～～一只小蝴蝶。\n"+
HIM" /~`._                     _.'~\\ \n"+
"( "NOR+YEL"@ "NOR+HIR": "NOR+HIM"`.                 .' "NOR+HIR": "NOR+YEL"@"NOR+HIM" )\n"+
" \\  "NOR+HIR"`.  "NOR+HIM"`.  "NOR+HIW"._     _.  "NOR+HIM".'  "NOR+HIR".'  "NOR+HIM"/ \n"+
"  \\"NOR+HIR";' `.  "NOR+HIM"`.  "NOR+HIW"\\   /  "NOR+HIM".'  "NOR+HIR".' `;"NOR+HIM"/  \n"+
"   \\"NOR+HIR"`.  `.  "NOR+HIM"\\  "NOR+HIW"\\_/  "NOR+HIM"/  "NOR+HIR".'  .'"NOR+HIM"/   \n"+
"    ) "NOR+HIR":-._`. "NOR+HIM"\\ "NOR+HIW"("NOR+HIY":"NOR+HIW") "NOR+HIM"/ "NOR+HIR".'_.-: "NOR+HIM"(    \n"+
"    ("NOR+HIR"`.....,`."NOR+HIM"\\"NOR+HIW"/"NOR+HIY":"NOR+HIW"\\"NOR+HIM"/"NOR+HIR".',.....'"NOR+HIM")    \n"+
"     >------._"NOR+HIW"|"NOR+HIY":::"NOR+HIW"|"NOR+HIM"_.------"NOR+HIM"<     \n"+
"    / "NOR+HIR".'._>_.-"NOR+HIW"|"NOR+HIY":::"NOR+HIW"|"NOR+HIR"-._<_.'. "NOR+HIM"\\    \n"+
"    |"NOR+YEL"o "NOR+HIR"_.-'_.-^"NOR+HIW"|"NOR+HIY":"NOR+HIW"|"NOR+HIR"^-._`-._ "NOR+YEL"o"NOR+HIM"|    \n"+
"    |"NOR+HIR"`'   ;"NOR+HIM"_.-'"NOR+HIW"|"NOR+HIY":"NOR+HIW"|"NOR+HIM"`-._"NOR+HIR";   `'"NOR+HIM"|    \n"+
"    \"."NOR+YEL"o"NOR+HIM"_.-' ;.\""NOR+HIW"|"NOR+HIY":"NOR+HIW"|"NOR+HIM"\".; '-._"NOR+YEL"o"NOR+HIM".\"    \n"
        );
        }
        set("owner","hcream");
        setup();
}       

int query_amount() { return amount; }
string query_autoload() { return query_amount() + ""; }
