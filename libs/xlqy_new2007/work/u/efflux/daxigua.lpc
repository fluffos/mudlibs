void init()
{
        add_action("do_qie", "qie");
}

int do_qie(string arg)
{
        object me, weapon;
        string weapon_type;

        me = this_player();

        if (!id(arg))
                return notify_fail("你要切什么？\n");

        if (!objectp(weapon = me->query_temp("weapon")))
                return notify_fail("空着手怎么切西瓜啊？\n");

        weapon_type = (string)weapon->query("skill_type");

        if (weapon_type != "sword" && weapon_type != "blade")
                return notify_fail("你手上拿的兵器不适合切西瓜！\n");

        message_vision("$N举起手中的" + weapon->query("name") + "，熟练地把西瓜切成四块！\n", me);

        new(__DIR__"xigua")->move(me);
        new(__DIR__"xigua")->move(me);
        new(__DIR__"xigua")->move(me);
        new(__DIR__"xigua")->move(me);
        destruct(this_object());

        return 1;
}
