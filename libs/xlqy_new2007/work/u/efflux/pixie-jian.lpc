int valid_enable(string usage) 
{ 
    return usage == "sword" || usage == "dodge" || usage == "parry" || usage == "force"; 
}

string query_skill_name(int level)
{
        int i;
        for(i = sizeof(action)-1; i >= 0; i--)
                if(level >= action[i]["lvl"])
                        return action[i]["skill_name"];
}
mapping query_action(object me, object weapon)
{
        int i, level;
        level   = (int) me->query_skill("pixie-jian",1);
        for(i = sizeof(action); i > 0; i--)
                if(level > action[i-1]["lvl"])
                        return action[NewRandom(i, 20, level/5)];
}

string query_dodge_msg(string limb)
{
        return dodge_msg[random(sizeof(dodge_msg))];
}

int valid_learn(object me)
{
        return notify_fail("辟邪剑法只能通过研习《葵花宝典》来学习。\n");
}

string perform_action_file(string action)
{
        return __DIR__"pixie-jian/" + action;
}

//mixed hit_ob(object me, object victim, int damage_bonus)
mixed hit_ob(object me, object victim, int damage_bonus, int factor)
{

        int damage;

        if(wizardp(me)) {
                write("pixie force your neili : " + me->query("neili") + "\n");
                write("pixie force jiali factor: " + factor + "\n");
                }

// ----------------- 激发 pixie-jian 为 force 时的 hit_ob()

        if( me->query_skill_mapped("force") == "pixie-jian" &&
            me->query("neili") >= factor && factor > 0 ) 
        {
            me->add("neili", - factor );
            damage = (int)me->query("neili")/20 + factor
                - (int)victim->query("neili")/25;

            if( damage < 0 ) {
                if( !me->query_temp("weapon")
                &&      random(victim->query_skill("force")) > me->query_skill("force")/2 ) {
                        damage = - damage;
                        me->receive_damage( "qi", damage * 2 );
                        me->receive_wound( "qi", damage );
                        if( damage < 10 ) return "$N受到$n的内力反震，闷哼一声。\n";
                        else if( damage < 20 ) return "$N被$n以内力反震，「嘿」地一声退了两步。\n";
                        else if( damage < 40 ) return "$N被$N以内力一震，胸口有如受到一记重锤，连退了五六步！\n";
                        else return "$N被$n的内力一震，眼前一黑，身子向后飞出丈许！！\n";
                }
                if( damage_bonus + damage < 0 ) return - damage_bonus;
                return damage;
            }
        
            if( damage >80&&me->query("combat_exp")>1000000)
                log_file("force_test",sprintf("%s HIT %s, damage = %d,jiali:%d, force : %d ,bonus_damage=%d, armor_vs:%d\n",
                        me->query("id"),victim->query("id"),damage,factor,me->query_skill("force"),damage_bonus,
                        victim->query_temp("apply/armor_vs_force")));
            damage -= victim->query_temp("apply/armor_vs_force");
            if( damage_bonus + damage < 0 ) return - damage_bonus;
            if( random(me->query_skill("force")) < damage )
                return damage;
        }
// ----------------- 激发 pixie-jian 为 force 时的 hit_ob()

// ----------------- pixie-jian perform kuihua ........
        if( me->query_temp("kuihua"))  //使过kuihua perform后加大伤害力
                if( damage_bonus<0)
                        damage_bonus = 110;
                else
                        damage_bonus += 100;

        if( damage_bonus < 100 ) return 0;

        if( (random(damage_bonus/2) > victim->query_str()
            || me->query_temp("kuihua"))
            && !factor)
            {
                victim->receive_wound("qi", (damage_bonus - 100) / 2 );
                return HIR "「嚓」一声轻响，" + victim->query("name") +
                "已被" + me->query("name") + "刺伤！刺出一道深可见骨的伤口！\n" NOR;
        }
}
