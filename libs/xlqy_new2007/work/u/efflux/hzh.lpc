//蓝玫瑰的化装盒
#include <ansi.h>
inherit ITEM;

void create() {
  set_name(HIY "化装盒" NOR, ({ "huazhuang he", "he", "hezi" }));
  set_weight(500);
  set_max_encumbrance(40000);
  if (clonep()) {
    object a, b, c, d, e;
    seteuid(getuid());
    if (a = new("/d/jjf/obj/jingling1"))
      a->move(this_object());

    seteuid(getuid());
    if (d = new("/u/efflux/l"))
      d->move(this_object());

    seteuid(getuid());
    if (b = new("/d/npc/obj/spear"))
      b->move(this_object());

    seteuid(getuid());
    if (e = new("/d/npc/obj/shield"))
      e->move(this_object());

    seteuid(getuid());
    if (c = new("/obj/money/tenthousand-cash"))
      c->move(this_object());
    set_default_object(__FILE__);
  } else {
    set("unit", "个");
    set("long", HIY "一个金色的化装盒，上面镶嵌着" HIB "蓝色的宝石" HIY "，里面是主人常用的一些小物品。\n" NOR);
    set("value", 0);
  }
}

int query_autoload() { return 1; }
