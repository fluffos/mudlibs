#include <ansi.h>
#include <weapon.h>

inherit DIABLO_OB;

void create()
{
        set("diablo_fixed/antique_stat",1);
        set("name",HIW"仙剑"NOR);
        set("id","sword");
        set_weight(100);
set("no_zm",1);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "把");
          set("weapon_prop/damage", 10);
          set("skill_type", "sword");
          set("diablo_prop/add_skill_damage",10000);
          set("diablo_prop/attack",50);
          set("diablo_prop/combat_blood_force",10000);
          set("diablo_prop/add_max_jin",10000);
          set("diablo_prop/combat_blood_kee",10000);
          set("diablo_prop/combat_blood_force",10000);
          set("diablo_prop/combat_blood_mana",10000);
          set("diablo_prop/combat_blood_eff",10000);
          set("diablo_prop/combat_ignore_armor",10000);
          set("diablo_prop/jin",10000);
          set("diablo_prop/combat_double_damage",10000);
        set("diablo_prop/parry_block_attack",10000);
        set("diablo_prop/sub_phy",10000);
          set("diablo_prop/inset_num",9);
          set("diablo_prop/damage",100);
          set("diablo_prop/add_phy",10000);
          set("diablo_prop/rigidity",10000);
          set("diablo_prop/add_max_phy",10000);
          set("level",9);
          set("no_get",1);
          set("no_sell",1);
          set("no_put",1);
          set("no_diablo_rename",1);
          set("identification",1);
  //      set("diablo_ob_autoloaded",1);
        }
        setup();
}
