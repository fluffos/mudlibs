//rich.c
//by efflux

#include <net/dns.h>
#include <ansi.h>

#define SHOW_LINE        10
#define MONEYD "/adm/daemons/moneyd"

inherit F_CLEAN_UP;

void show_richer_ladder();

void create() { seteuid(getuid()); }

mixed main(object me, string are) {

  object *list, g_ob, s_ob, c_ob, *nlist;
  string str;
  int tc, gc, sc, cc, j, total;

  if (me->query("jing") < 20)
    return notify_fail("你的精太少了！\n");

  me->add("jing", -15);

  if (!arg || arg != "online") {
    show_richer_ladder();
    return 1;
  }

  str = NOR "◎ " + MUD_NAME + " 在线大富翁排行榜\n\n";
  str += "排  行           名  号   \n";
  str += "———————————————\n";
  write(str);
  list = users();
  j = sizeof(list);
  if (j < SHOW_LINE)
    return 1;
  while (j--) {
    if (!environment(list[j]) || !me->visible(list[j]) || wizardp(list[j])) {
      list[j]->set_temp("allmoney", 0);
      continue;
    }

    if (g_ob = present("thousand-cash_money", list[j]))
      tc = g_ob->query_amount();
    else
      tc = 0;
    if (g_ob = present("gold_money", list[j]))
      gc = g_ob->query_amount();
    else
      gc = 0;
    if (s_ob = present("silver_money", list[j]))
      sc = s_ob->query_amount();
    else
      sc = 0;
    if (c_ob = present("coin_money", list[j]))
      cc = c_ob->query_amount();
    else
      cc = 0;

    total = tc * 10 + gc + sc / 100 + cc / 10000 + list[j]->query("balance") / 10000;

    if (!wizardp(list[j])) list[j]->set_temp("allmoney", total);
    else list[j]->set_temp("allmoney", 10);
  }

  nlist = sort_array(list, "sort_user", this_object());

  for (j = 0; j < SHOW_LINE; j++) {
    if (j == 0)
      str = sprintf("%-22s%-18s\n", HIY "首富",
        nlist[j]->query("name") + "(" + nlist[j]->query("id") + ")");
    else
      str = sprintf("%-20s%-18s\n", GRN "第" + chinese_number(j + 1) + "名",
        nlist[j]->query("name") + "(" + nlist[j]->query("id") + ")");
    write(str);
  }
  return 1;

}

void show_richer_ladder() {
  string str;
  int i;
  mapping richerdata, data;
  int TotalSortNumber;
  int fortune, turn;
  int tc, gc, sc, cc, total;
  object g_ob, s_ob, c_ob, me;

  str = NOR "◎ " + MUD_NAME + " 大富翁排行榜\n\n";
  str += "排  行             名  号             财产\n";
  str += "—————————————————————\n";

  write(str);
  richerdata = MONEYD->query_sortall();
  if (!mapp(richerdata)) return;

  me = this_player();
  TotalSortNumber = MONEYD->query_totalsortnumber();
  for (i = 0; i < TotalSortNumber - 5; i++) {
    data = richerdata[i];
    if (!mapp(data)) return;

    if (wizardp(this_player()))
      fortune = data["fortune"];
    else {
      fortune = data["fortune"];
      turn = 100000;
      while (turn > 1000) {
        if (fortune / turn) {
          fortune = fortune / turn * turn;
          break;
        } else {
          turn = turn / 10;
          if (fortune / turn) fortune = fortune / turn * turn;
        }
      }
    }

    if (i == 0)
      str = sprintf("%-22s%-22s%-24d\n", HIY "泥潭首富",
        data["name"] + "(" + data["id"] + ")", fortune);
    else
      str = sprintf("%-20s%-22s%-24d\n", GRN "第" + chinese_number(i + 1) + "名",
        data["name"] + "(" + data["id"] + ")", fortune);
    write(str);
  }


  if (g_ob = present("thousand-cash_money", me))
    tc = g_ob->query_amount();
  else
    tc = 0;
  if (g_ob = present("gold_money", me))
    gc = g_ob->query_amount();
  else
    gc = 0;
  if (s_ob = present("silver_money", me))
    sc = s_ob->query_amount();
  else
    sc = 0;
  if (c_ob = present("coin_money", me))
    cc = c_ob->query_amount();
  else
    cc = 0;
  total = tc * 10 + gc + sc / 100 + cc / 10000 + me->query("balance") / 10000;

  printf(YEL "\n您的个人总财产约折合为 %d GOLD (存款-%dGOLD 银票-%d 黄金-%d 白银-%d)\n" NOR,
    total, me->query("balance") / 10000, tc, gc, sc);

  if (MONEYD->user_money_check(me) == -1)    // fuyo add to check money
    write(RED "您的财产已经过多了，请及时转移！\n" NOR);

  return;
}

int sort_user(object ob1, object ob2) {
  return (int)ob2->query_temp("allmoney") - (int)ob1->query_temp("allmoney");
}




int help(object me) {
  write(@HELP
指令格式 : richer [online]

这个指令可以列出大富翁排行榜/在线大富翁排行榜

相关指令： finger, who
HELP
  );
  return 1;
}
