#include <armor.h>
#include <ansi.h>

inherit DIABLO_OB;

void create() {
  set("diablo_fixed/antique_stat", 1);
  set("name", HIW "白金戒指" NOR);
  //        set_name(""HIG"古物之戒指"NOR"",({""HIG"Antique ring"NOR"","ring"}));
  set("id", "ring");
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "枚");
    set("armor_prop/armor", 1);
    set("armor_type", TYPE_FINGER);
    set("diablo_prop/add_spells_all", 10000);
    set("diablo_prop/add_phy", 10000);
    set("diablo_prop/add_shui", 10000);
    set("diablo_prop/add_jin", 10000);
    set("diablo_prop/add_huo", 10000);
    set("diablo_prop/add_mu", 10000);
    set("diablo_prop/add_max_shui", 20000);
    set("diablo_prop/add_max_jin", 20000);
    set("diablo_prop/add_max_huo", 20000);
    set("diablo_prop/add_max_mu", 20000);
    set("diablo_prop/add_max_phy", 20000);
    set("diablo_prop/sub_phy", 10000);
    set("diablo_prop/karma", 1000000);
    set("diablo_prop/sub_shui", 10000);
    set("diablo_prop/sub_huo", 10000);
    set("diablo_prop/sub_mu", 10000);
    set("diablo_prop/sub_jin", 10000);
    set("diablo_prop/sub_spells_all", 10000);
    set("diablo_prop/armor", 5000);
    set("diablo_prop/high_resist_all", 10000);
    set("diablo_prop/parry_block_attack", 10000);
    set("diablo_prop/magicback_damage", 10000);
    set("diablo_prop/feedback_damage", 10000);
    set("diablo_prop/defense", 10000);
    set("diablo_prop/sub_max_phy", 10000);
    set("diablo_prop/force_vs_damage", 10000);
    set("diablo_prop/spells_vs_damage", 10000);
    set("diablo_prop/dodge", 10000);
    set("diablo_prop/sub_max_spells_all", 10000);
    set("diablo_prop/add_all_skill", 400);
    set("diablo_prop/add_max_spells_all", 20000);
    set("diablo_prop/rigidity", 999);
    set("level", 9);
    set("no_drop", 1);
    //        set("no_get",1);
    set("no_sell", 1);
    set("no_put", 1);
    set("no_diablo_rename", 1);
    set("identification", 1);

    //	set("diablo_ob_autoloaded",1);
  }
  setup();
}
