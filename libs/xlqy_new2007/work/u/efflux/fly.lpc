#include <ansi.h>
#include <armor.h>
inherit ITEM;

void create() {
  set_name(HIC "风之精灵" NOR, ({ "jingling" }));
  set("long", "这是一只小巧可爱的" HIC "风之精灵" NOR "，只有身为精灵公主的你才有资格让它带你(fly)在天际。\n");

  set("unit", "对");
  set_weight(100);
  set("value", 2510000);

  setup();
}

void init() {
  add_action("do_hanhan", "hanhan");
}

int do_hanhan(string arg) {
  int goto_inventory, goto_message, i;
  object obj, *ob_list;
  string msg;
  object me = this_player();

  goto_inventory = 0;
  goto_message = 0;


  if (!arg) return notify_fail("你要去哪里？\n");
  if (sscanf(arg, "-i %s", arg)) goto_inventory = 1;
  if (sscanf(arg, "-h %s", arg)) goto_message = 1;
  if (!arg) return notify_fail("你要去哪里？\n");

  obj = find_player(arg);
  if (!obj) {
    ob_list = users();
    for (i = 0; i < sizeof(ob_list); i++)
      if (ob_list[i]->query("id") == arg) {
        obj = ob_list[i];
        break;
      }
  }
  if (!obj) obj = find_living(arg);
  if (!obj || !me->visible(obj)) {
    arg = resolve_path(me->query("cwd"), arg);
    if (!sscanf(arg, "%*s.lpc")) arg += ".lpc";
    if (!(obj = find_object(arg))) {
      if (file_size(arg) >= 0)
        return me->move(arg);
      return notify_fail("没有这个玩家、生物、或地方。\n");
    }
  }

  if (!goto_inventory && environment(obj))
    obj = environment(obj);

  if (!obj) return notify_fail("这个物件没有环境可以 goto。\n");

  if (goto_message == 0) {

    if (stringp(msg = me->query("env/msg_mout")))
      message_vision(BOLD + msg + "\n" + NOR, me);
  }

  me->move(obj);

  if (goto_message == 0) {
    if (stringp(msg = me->query("env/msg_min")))
      message_vision(BOLD + msg + "\n" + NOR, me);
  }
  return 1;
}
int query_autoload() { return 1; }
//string query_autoload() { return query_amount() + ""; }
