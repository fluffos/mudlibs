#include <ansi.h>
inherit ITEM;

string give_reward(object me);
void create()
{
 set_name(HIG"骰子"NOR, ({"shaizi"}));
        set_weight(100);
        if (clonep())
                set_default_object(__FILE__);
        else {
 set("long", HIG"决定sldh对决的骰子,open 就可以看到你的数字,相同数字者对战。\n"NOR);
                set("unit", "个");
set("no_give",1);
set("no_get",1);
set("no_sell",1);
set("no_drop",1);
set("no_put",1);
set("no_steal",1);
set("number",1);
                set("value", 100);
        }
}


void init()
{
add_action ("do_eat", "open");
}
int do_eat(string arg)
{
 if(this_player()!=environment())
return 0;
message_vision("$N打开了骰子看到了....................\n",this_player());
shout(HIW+this_player()->name()+"选到的数字是:"+query("number")+"\n"NOR);
tell_object(this_player(),HIW+this_player()->name()+"选到的数字是:"+query("number")+"\n"NOR);
return 1;
}
