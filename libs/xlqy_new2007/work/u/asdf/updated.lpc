#include <ansi.h>
string *specialsk=({
        "agile","constitution","greedy","lucky","energy",
        "hatred","health","intellect","ironskin","might","power","defense","spirituality"});
void create() { seteuid(getuid()); }

void check_diablo(object me) //防止系统意外重启时，玩家获得利益..
{
    
         mapping diablo;
        string  *type;
    mapping skl;
    int j;
    string *sname;
    
reset_eval_cost();
        if( !mapp( diablo =me->query("diablo_effect") ) || sizeof(diablo) < 1 )
                return;

        type = keys(diablo);
  for(int i=0;i<sizeof(type);i++)
        {
            
             if(type[i]=="add_force")
             {
                if(me->query("max_force")>=me->query("diablo_effect/add_force"))
                    me->add("max_force",-me->query("diablo_effect/add_force"));
                else me->set("max_force",0);
                
                me->add("force",-me->query("diablo_effect/add_force"));
                
                
                me->delete("diablo_effect/add_force");
            }
              if(type[i]=="add_mana")
             {
                if(me->query("max_mana")>=me->query("diablo_effect/add_mana"))
                    me->add("max_mana",-me->query("diablo_effect/add_mana"));
                else me->set("max_mana",0);
    
                me->add("mana",-me->query("diablo_effect/add_mana"));
                
                
                me->delete("diablo_effect/add_mana");
            }
            
             if(type[i]=="add_max_force")
             {
                if(me->query("max_force")>=me->query("diablo_effect/add_max_force"))
                    me->add("max_force",-me->query("diablo_effect/add_max_force"));
                else me->set("max_force",0);
            //  if(me->query("force")>=query_temp("diablo_effect/add_max_force"))
                    me->add("force",-me->query("diablo_effect/add_max_force"));
            //  else me->set("force",0);
                
                me->delete("diablo_effect/add_max_force");
            }
              if(type[i]=="add_max_mana")
             {
                if(me->query("max_mana")>=me->query("diablo_effect/add_max_mana"))
                    me->add("max_mana",-me->query("diablo_effect/add_max_mana"));
                else me->set("max_mana",0);
            //  if(me->query("mana")>=query_temp("diablo_effect/add_max_mana"))
                    me->add("mana",-me->query("diablo_effect/add_max_mana"));
            //  else me->set("mana",0);
                
                me->delete("diablo_effect/add_max_mana");
            }
            if(type[i]=="add_all_skill")
            {
                skl = me->query_skills();
            if(!sizeof(skl)) 
            {
            return; 
            }
            j=sizeof(skl);
            sname=keys(skl);
            
            for(int k=0;k<sizeof(sname);k++)
            {
                if(skl[sname[k]]>me->query("diablo_effect/add_all_skill"))
                me->set_skill(sname[k],skl[sname[k]]-me->query("diablo_effect/add_all_skill"));
                else me->delete_skill(sname[k]);
            
            
            }
            me->delete("diablo_effect/add_all_skill");
                
                
            }
            
            if(type[i]=="add_axe")
            {
                if(me->query_skill("axe",1))
                me->set_skill("axe",me->query_skill("axe",1)-me->query("diablo_effect/add_axe"));
                me->delete("diablo_effect/add_axe");
            }
            if(type[i]=="add_blade")
            {
                if(me->query_skill("blade",1))
                me->set_skill("blade",me->query_skill("blade",1)-me->query("diablo_effect/add_blade"));
                me->delete("diablo_effect/add_blade");
            }
            if(type[i]=="add_fork")
            {
                if(me->query_skill("fork",1))
                me->set_skill("fork",me->query_skill("fork",1)-me->query("diablo_effect/add_fork"));
                me->delete("diablo_effect/add_fork");
            }
            if(type[i]=="add_dagger")
            {
                if(me->query_skill("dagger",1))
                    me->set_skill("dagger",me->query_skill("dagger",1)-me->query("diablo_effect/add_dagger"));
                me->delete("diablo_effect/add_dagger");
            }
            if(type[i]=="add_hammer")
            {
                if(me->query_skill("hammer",1))
                me->set_skill("hammer",me->query_skill("hammer",1)-me->query("diablo_effect/add_hammer"));
                me->delete("diablo_effect/add_hammer");
            }
            if(type[i]=="add_mace")
            {if(me->query_skill("mace",1))
                me->set_skill("mace",me->query_skill("mace",1)-me->query("diablo_effect/add_mace"));
                me->delete("diablo_effect/add_mace");
            }
            if(type[i]=="add_music")
            {if(me->query_skill("music",1))
                me->set_skill("music",me->query_skill("music",1)-me->query("diablo_effect/add_music"));
                me->delete("diablo_effect/add_music");
            }
            if(type[i]=="add_rake")
            {if(me->query_skill("rake",1))
                me->set_skill("rake",me->query_skill("rake",1)-me->query("diablo_effect/add_rake"));
                me->delete("diablo_effect/add_rake");
            }
            if(type[i]=="add_spear")
            {if(me->query_skill("spear",1))
                me->set_skill("spear",me->query_skill("spear",1)-me->query("diablo_effect/add_spear"));
                me->delete("diablo_effect/add_spear");
            }
            if(type[i]=="add_staff")
            {if(me->query_skill("staff",1))
                me->set_skill("staff",me->query_skill("staff",1)-me->query("diablo_effect/add_staff"));
                me->delete("diablo_effect/add_staff");
            }
            if(type[i]=="add_stick")
            {if(me->query_skill("stick",1))
                me->set_skill("stick",me->query_skill("stick",1)-me->query("diablo_effect/add_stick"));
                me->delete("diablo_effect/add_stick");
            }
            if(type[i]=="add_sword")
            {if(me->query_skill("sword",1))
                me->set_skill("sword",me->query_skill("sword",1)-me->query("diablo_effect/add_sword"));
                me->delete("diablo_effect/add_sword");
            }
            if(type[i]=="add_throwing")
            {if(me->query_skill("throwing",1))
                me->set_skill("throwing",me->query_skill("throwing",1)-me->query("diablo_effect/add_throwing"));
                me->delete("diablo_effect/add_throwing");
            }
            if(type[i]=="add_whip")
             {if(me->query_skill("whip",1))
                me->set_skill("whip",me->query_skill("whip",1)-me->query("diablo_effect/add_whip"));
                me->delete("diablo_effect/add_whip");
            }
            
            
        
        }   
    
    
}
void make_golem(object me)
{
    
    object golem;
        if(me->query("summon")&&me->query("family/family_name")=="阎罗地府")
        {
       
            golem = new("/obj/npc/hell_golem");
            golem->move(environment(me));
            golem->invocation(me,me->query("summon/npc_prop"));
        golem->set("title",me->query("summon/title"));
        golem->set_temp("invoker",me);
         me->set("summon/diablo_npc",golem);
             message_vision(HIB"$N说道：我的主人，我又可以追随您了！\n"NOR,golem ); 
            
        }
        else if(me->query("summon")&&me->query("family/family_name")=="南海普陀山")
        {
       
            golem = new("/obj/npc/putuo_guardian");
            golem->move(environment(me));
            golem->invocation(me,me->query("summon/npc_prop"));
        golem->set("title",me->query("summon/title"));
        golem->set_temp("invoker",me);
         me->set("summon/diablo_npc",golem);
             message_vision(HIY"$N说道：我的孩子，我又可以保护你了！\n"NOR,golem ); 
            
        }
    
}
void check_user(object ob, int reconnect)
{
        int mete;
        string m;
        mapping my;

        mapping colors;
                                string key,msg,mmsg;
        int i,j,k;
mapping diablo_armor_map;
string* armor_list;
string files;
string* prop;
mapping dbase;
object newob;
   
reset_eval_cost();
    //check if daoxing 不堕轮回 
if((int)ob->query("daoxing") > 3456000)
        {
            ob->announce_live_forever(ob->query("name")+
    "的道行达到了不堕轮回的境界，从此跳出三界外，不在五行中，永无生死大限了！");    
        }
    
    //set player's life time here.
    if( !ob->query("life/init_life_time") ) 
    {
        ob->set("life/init_life_time", 50+ob->query("kar")+random(20));
        //average is 50+20+10=80, lowest=50+10+0=60, highest=50+30+20=100
    }
    ob->save();
    if( !ob->query("life/life_time") )
    {
        ob->set("life/life_time", ob->query("life/init_life_time"));
    }
    //now check if gameover...player too old?
    if( ob->check_gameover() ) return; 
    //note, if gameover, the function check_gameover() return 1.
        
    
    // player body is a safe room. mon 8/2/98
    // can't practice, ... inside a body.
    ob->set("no_magic", 1);
   mete = ob->query("opinion/mete");

    //mete += mete>0?1:0;
    //mete = 100000000 + mete * 20000000;
    mete = 120000000 + mete * 20000000;
/*
    if (ob->query("combat_exp") > mete)// && !wizardp(ob)) 
    {

        ob->move("/d/wiz/zuansheng");
        ob->set("startroom","/d/wiz/zuansheng");
        ob->save();
 CHANNEL_D->do_channel(this_object(),"rumor",HIR+ob->short(1) 
            + "修为达到轮回再世，就此进入轮回转生界！\n\n");
    }
*/

    my = ob->query_entire_dbase();
    if( undefinedp(my["eff_gin"]) ) my["eff_gin"] = my["max_gin"];
    if( undefinedp(my["eff_kee"]) ) my["eff_kee"] = my["max_kee"];
    if( undefinedp(my["eff_sen"]) ) my["eff_sen"] = my["max_sen"];
    if( my["eff_gin"] > my["max_gin"] ) my["eff_gin"] = my["max_gin"];
    if( my["eff_kee"] > my["max_kee"] ) my["eff_kee"] = my["max_kee"];
    if( my["eff_sen"] > my["max_sen"] ) my["eff_sen"] = my["max_sen"];
    if( my["gin"] > my["eff_gin"] ) my["gin"] = my["eff_gin"];
    if( my["kee"] > my["eff_kee"] ) my["kee"] = my["eff_kee"];
    if( my["sen"] > my["eff_sen"] ) my["sen"] = my["eff_sen"];

// added by dream to clear ppl's invisibility and immortal when updated
// for future spells. July 11, 1997.

    if ( !wizardp(ob) && ob->query("env/invisibility") )
        ob->set("env/invisibility", 0);
    if ( !wizardp(ob) && ob->query("env/immortal") )
        ob->set("env/immortal", 0);
    if ( !wizardp(ob) && ob->query("max_force")>=ob->query_max_force() && !ob->query("diablo_effect/add_max_force") )
        ob->set("max_force",ob->query_max_force());
    if ( !wizardp(ob) && ob->query("max_mana")>=ob->query_max_mana() && !ob->query("diablo_effect/add_max_mana") )
        ob->set("max_mana",ob->query_max_mana());

    // by snowcat - adjust title
    if (ob->query("zhangmen"))
    {
      object zhangmen = new (ob->query("zhangmen/base_name"));

          if (zhangmen)
      {
        zhangmen->set_save_file(ob->query("zhangmen/data_name"));
        zhangmen->restore();

        if (zhangmen->query("family/family_name")!=ob->query("family/family_name"))
        {
          // already betrayed
          if (ob->query("title")==ob->query("zhangmen/title") ||
              ob->query("title")==ob->query("zhangmen/title_old"))
          {
            if (ob->query("family/family_name"))
              ob->set("title",
                        sprintf("%s第%s代%s",
                                ob->query("family/family_name"),
                                chinese_number(ob->query("family/generation")),
                                ob->query("family/title")));
          }
          if (zhangmen->query("current_player")==ob->query("id"))
          {
            zhangmen->reset_me(zhangmen);
            zhangmen->save();
          }
          ob->delete("zhangmen");
        }
        else if (zhangmen->query("current_player")==ob->query("id"))
            {
          ob->set("title",ob->query("zhangmen/title"));
            }
        else
        {
          /*
          ob->set("title",
                    sprintf("%s第%s代%s",
                            ob->query("family/family_name"),
                            chinese_number(ob->query("family/generation")),
                            ob->query("family/title")));
           */
          ob->set("title",ob->query("zhangmen/title_old"));
          ob->delete("zhangmen");
        }
            ob->save();
      }
    }

    // by snowcat
    // the following is used to update ob's data in case
    // of system change
    {
          int tmpint;
          string tmpstr;

      if (tmpint = ob->query("obstacle/level"))
      {
        if (! ob->query("obstacle/number"))
          ob->set("obstacle/number",tmpint);
      }
      if (tmpstr = ob->query("obstacle/1"))
      {
        if (ob->query("obstacle/nuerguo"))
        {
          // already there
        }
        else if (tmpstr == "marriage" ||
                 tmpstr == "company" ||
                 tmpstr == "stomachache")
          ob->set("obstacle/nuerguo",tmpstr);
        else
          ob->set("obstacle/nuerguo","done");
      }
      if (tmpstr = ob->query("obstacle/2"))
      {
        if (ob->query("obstacle/firemount"))
        {
          // already there
        }
        else if (tmpstr != "done")
          ob->set("obstacle/firemount",tmpstr);
        else 
          ob->set("obstacle/firemount","done");
      }
      if (tmpint = ob->query("obstacle/2_bone"))
            ob->set("obstacle/firemount_bone",tmpint);
      if (tmpstr = ob->query("obstacle/3"))
      {
        if (ob->query("obstacle/wudidong"))
        {
          // already there
        }
        else
          ob->set("obstacle/wudidong",tmpstr);
      }
      ob->delete("obstacle/level");
      ob->delete("obstacle/1");
      ob->delete("obstacle/2");
      ob->delete("obstacle/2_bone");
      ob->delete("obstacle/3");
    }

    // by snowcat
    if (ob->query("obstacle/reward"))
          ob->set("obstacle/wuzhuang","done");
    // by snowcat
    // the following is a filter for relai reward
    {
      if (ob->query("obstacle/reward") &&
          ob->query("obstacle/mud_age") == 0)
        ob->set("obstacle/mud_age", ob->query("mud_age"));
        }
    
    // don't check the following if is reconnecting.
    if(reconnect) return;

    // penalty on kaifeng quests when quitting.
    // randomly remove clouds.
    // mon 3/28/99
   
    ob->set("menpai_exp",  ob->query("combat_exp")/100 );    
    if(ob->query("dntg/number") == 10)
         ob->set("dntg/goldeyes",1);
    
    colors=ob->query("quest/colors");
    j=sizeof(colors);
    if(j>1) {
       for(i=0;i<j/2;i++) {
         k=random(sizeof(colors));
         key=keys(colors)[k];
         map_delete(colors,key);
       }
       ob->set("quest/colors",colors);
    }
reset_eval_cost();
 
    WUXING_D->init_user_wuxing(ob);
reset_eval_cost();
  
    check_diablo(ob);
    make_golem(ob);
if(i= ob->query("diablo_charm_autoload_num"))
        {
                diablo_armor_map=ob->query("diablo_charm_autoload");        
                if(!diablo_armor_map)
                {
                        tell_object(ob,"无法自动加载你的神符装备！请和wiz联系。\n");
                        return;
                }
                armor_list=keys(diablo_armor_map);
 for(j=0;j<i;j++)
                {
                        dbase=diablo_armor_map[armor_list[j]];
                        files=dbase["files"];
                        prop=keys(dbase);
                        prop-=({"equipped"});
                        if(!newob=new(files))
                        {
                             tell_object(ob,"无法自动加载你的神符装备！请和wiz联系。\n");
                                return ;
                        }
                        
  
                        else{
                                newob=new(files);
                                for(int z=0;z<sizeof(prop);z++)
                                        newob->set(prop[z],dbase[prop[z]]);
                                newob->move(ob);
                        newob->set("owner_id",ob->query("id"));
                
                        }
                }
        }
}

