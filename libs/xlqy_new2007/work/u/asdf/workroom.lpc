#include <ansi.h>
#include <room.h>

inherit ROOM;

void create ()
{
        set ("short", HIY"黯世画眉"NOR);
        set ("long", @LONG
 火云魔女幽冥婿 携手笑傲西游行
 
以前是asdf和jojo的家，现在也是，将来么。。。
LONG);
        set("valid_startroom", 1);
        set("no_time",1);
        set("outdoors", 1);
        set("no_burn",1);
          set("item_desc", ([ /* sizeof() == 1 */
  "bed" : HIR"忘忧塌\n"NOR,
]));
        set("objects", ([
        "/d/wiz/npc/asdf_npc.lpc" :1,
        ]));
                
        set("exits",
      (["out" : "/d/city/center",]));
        setup();
}

void init()
{
        add_action("do_bed", "gosleep");
        add_action("do_bed", "gobed", );
        add_action("do_bed", "bed");
}
int do_bed()
{       object me;
        me=this_player();
        message_vision(HIY "$N掀开纱帐，准备上床了。\n\n" NOR, me);
        me->move(__DIR__"bed");
            message_vision(HIY "\n纱帐轻轻一动，$N钻了进来。\n" NOR, me);
                return 1;
}

