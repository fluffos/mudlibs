#include <ansi.h>
#include <room.h>

inherit ROOM;

void create() {
  set("short", HIR "忘忧塌" NOR);
  set("long", @LONG
一张整洁干净的小床，铺着温暖的天鹅绒，
让每个疲劳的人都有躺下好好休息的冲动，
躺在这张床上，就是回到了家，让人忘记烦恼，
香甜的睡。

LONG);


  set("valid_startroom", 1);
  set("no_time", 1);
  set("outdoors", 1);
  set("sleep_room", 1);
  set("if_bed", 1);

  setup();
}
