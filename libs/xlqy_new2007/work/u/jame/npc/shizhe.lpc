#include <ansi.h>
inherit NPC;

int give_gift (object me);

void create()
{
     set_name(HIC"礼物使者"NOR, ({ "gift shizhe", "shizhe", "guard" }) );
     set("gender", "男性" );
     set("long",HIY"仙风道骨，气度不凡，据说是专门来派发中秋礼物的！\n"NOR);
     set("age",12500);
     set("title", HIW"中秋快乐"NOR);
     set("str",50);
     set("int",40);
     set("per",40);
     set("max_kee",8000);
     set("kee",8000);
     set("max_sen",8000);
     set("sen",8000);
     set("daoxing",10000000);
     set("force",10000);
     set("mana",10000);
     set("max_force",10000);
     set("max_mana",10000);
     set("force_factor",500);
     set("mana_factor",400);

     set_skill("buddhism",400);
     set_skill("spells",400);
     set_skill("literate",400);
     map_skill("spells","buddhism");
     set("inquiry", ([
             "name" : "老夫乃派发礼物之使者是也。",
             "gift":   (: give_gift :),
             "liwu":   (: give_gift :),
                     ])
         );
        setup();
        carry_object("/u/jame/obj/ring")->wear();
}

int give_gift (object me)
{
  object gift;
  object who = this_player();
  if ( who->query("mid_gift")==1 )
  {
          message_vision(RED"你已经要过一次了，不可以太贪心！\n"NOR,me,who);
          return 1;
  }

    gift = new ("/u/jame/obj/yuebing.lpc");
    gift->set("owner_id",who->query("id"));
          who->set("mid_gift",1);
          gift->move(who);
  message_vision("$N拿了盒月饼给$n。\n",me,who);
  return 1;
}
