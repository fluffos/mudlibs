#include <ansi.h>
inherit NPC;

string ask_gift() {
  object me = this_player();
  if (!me->query("marry_gift") && me->query("married")) {
    me->add("attribute_point", 3);
    me->add("mud_age", -86400);
    me->set("marry_gift", 1);
    return me->name() + RANK_D->query_respect(me) + "是否年轻了？祝你们白头到老！";
  } else
    return me->name() + RANK_D->query_respect(me) + "不符合领取礼物的条件啊！";
}

void create() {
  set_name(HIG "礼物天使" NOR, ({ "marry angel", "angel", "girl" }));
  set("gender", "女性");
  set("long", HIY "秋水为容玉为骨，芙蓉如面柳如眉。\n据说是上天派来为新人祈福的！\n" NOR);
  set("age", 14);
  set("title", HIR "新婚快乐" NOR);
  set("str", 50);
  set("int", 40);
  set("per", 40);
  set("max_kee", 8000);
  set("kee", 8000);
  set("max_sen", 8000);
  set("sen", 8000);
  set("daoxing", 10000000);
  set("combat_exp", 10000000);
  set("force", 10000);
  set("mana", 10000);
  set("max_force", 10000);
  set("max_mana", 10000);
  set("force_factor", 500);
  set("mana_factor", 500);

  set_skill("buddhism", 400);
  set_skill("spells", 400);
  set_skill("literate", 400);
  map_skill("spells", "buddhism");

  set("inquiry", ([
    "name": "我就是超级可爱的礼物小天使拉，嘻嘻。",
    "结婚礼物": (: ask_gift :),
    "liwu": (: ask_gift :),
  ])
  );
  setup();
  carry_object("/u/jame/obj/ring")->wear();
}
