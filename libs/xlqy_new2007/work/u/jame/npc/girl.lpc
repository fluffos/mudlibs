#include <ansi.h>
inherit NPC;

int give_gift (object me);

void create()
{
     set_name(HIY"蛋糕"NOR, ({ "Jame's girl", "girl" }) );
     set("gender", "女性" );
     set("long",HIG"粉可爱粉可爱的一个蛋糕Mm~! \n"NOR);
     set("age",18);
     set("title", HIM"可爱青春活泼善良"NOR);
     set("str",30);
     set("int",60);
     set("per",100);
     set("max_kee",8000);
     set("kee",8000);
     set("max_sen",8000);
     set("sen",8000);
     set("daoxing",10000000);
     set("force",10000);
     set("mana",10000);
     set("max_force",10000);
     set("max_mana",10000);
     set("force_factor",500);
     set("mana_factor",400);

     set_skill("moonshentong",400);
     set_skill("spells",400);
     set_skill("literate",400);
     set_skill("moondance",400);
     set_skill("dodge",400);
     set_skill("moonshentong",400);
     set_skill("force",400);
     set_skill("snowsword",400);
     set_skill("sword",400);
     set_skill("parry",400);

     map_skill("spells","moonshentong");
     map_skill("force","moonforce");
     map_skill("dodge","moondance");
     map_skill("parry","snowsword");
     map_skill("sword","snowsword");

     set("inquiry", ([
             "name" : "偶是蛋糕MM~！。",
             "here" : "这是偶的蛋糕坊，刚有新鲜的蛋糕出炉哦，要不要尝尝？",
             "cake":   (: give_gift :),
                     ])
         );
        setup();
        carry_object("/u/jame/obj/ring")->wear();
}

int give_gift (object me)
{
  object gift;
  object who = this_player();

    gift = new ("/u/jame/obj/cake.lpc");
          gift->move(who);
  message_vision("$N拿了块热气腾腾的蛋糕给$n，笑着道，快吃吧。\n",me,who);
  return 1;
}
