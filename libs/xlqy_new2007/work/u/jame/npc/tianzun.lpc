#include <ansi.h>
inherit NPC;

string ask_zxz();
string ask_jiang();
string give_reward(object me);

void create()
{
    set_name(HIW "元始天尊" NOR, ({"yuanshi tianzun", "tianzun", "yuanshi"}));
    set("title", HIR "三清之首" NOR);
    set("long", "三清之首，法力无边。\n");
    set("gender", "男性");
    set("age", 13500);
    set("str", 40);
    set("per", 40);
    set("attitude", "peaceful");
    set("combat_exp", 10000000);
    set("daoxing", 10000000);
    set("eff_kee", 10000);
    set("eff_sen", 10000);
    set("max_kee", 10000);
    set("max_sen", 10000);
    set("sen", 10000);
    set("kee", 10000);
    set("max_force", 10000);
    set("max_mana", 10000);
    set("mana", 10000);
    set("force", 20000);
    set("force_factor",  500);
    set("mana_factor", 500);
    set_skill("dao", 301 );
    set_skill("zhenyuan-force", 301);
    set_skill("spells", 301);
    set_skill("force", 301);
    set_skill("moonshentong", 301);
    set_skill("whip", 301);
    set_skill("staff", 301);
    set_skill("blade", 301);
    set_skill("spear", 301);
    set_skill("hammer", 301);
    set_skill("buddhism", 301);
    set_skill("taiyi", 301);
    set_skill("lotusforce", 301);
    set_skill("wuxiangforce", 301);
    set_skill("moonforce", 301);
    set_skill("stick", 301);
    set_skill("dodge", 301);
    set_skill("unarmed", 301);
    set_skill("parry", 301);
    set_skill("sword", 251);
      map_skill("force", "wuxiangforce");
      map_skill("spells", "dao");

    set("chat_chance_combat", 60);
    set("chat_msg_combat", ({
        (: cast_spell, "light" :),
        (: cast_spell, "thunder" :),
        (: cast_spell, "dingshen" :),
        (: cast_spell, "fenshen" :),
(: exert_function, "jldl" :)
}));

   set("inquiry", ([
            "大破诛仙阵": (: ask_zxz :),
            "论功行赏": (: ask_jiang :),
	]));
      setup();
   
}

int accept_fight(object me)
{
        write("仙人你也想打？\n");
        return 0;
}

int recognize_apprentice(object me)
{
      object ob = this_player();
      
        if (!(int)ob->query_temp("mark/仙"))
{
//             return notify_fail( HIR "看起来" HIW "元始天尊" HIR "想杀死你！\n"NOR);
message_vision(HIR "看起来"HIW"元始天尊"HIR"想杀死你！\n"NOR);
kill_ob(me);
return 1;
}
        if( ( ob->query("family/family_name") != "方寸山三星洞"
            && ob->query("family/family_name") != "南海普陀山"
            && ob->query("family/family_name") != "月宫"
            && ob->query("family/family_name") != "五庄观")
            || ob->query("combat_exp")  < 2000000 ) 
{
//             return notify_fail( HIR "看起来" HIW "元始天尊" HIR "想杀死你！\n"NOR);
message_vision(HIR "看起来"HIW"元始天尊"HIR"想杀死你！\n"NOR);
kill_ob(me);

             ob->add_temp("mark/仙", -1);
               return 1;
}
}

string give_reward(object me) {
  mapping skill=me->query_skills();
  string skillforce,skillspells;
  int level;

  if (!skill) return "none";

  skillforce = me->query_skill_mapped("force");
  skillspells = me->query_skill_mapped("spells");

  level=skill[skillforce];
  me->set_skill(skillforce,level+5);
  level=skill[skillspells];
  me->set_skill(skillspells,level+5);
  tell_object(me,"你得到了五级"+ to_chinese(skillforce) +"和" + to_chinese(skillspells) + "。\n");

  return "none";
}

string ask_zxz()
{
    object me,who;
    int rewords=300000;
    
    me = this_object();
    who = this_player();
    
    if( who->query("combat_exp") < 6000000 )
          return ("你修为不够，下次再来过吧！\n");
    if ( who->query_temp("mark/zhuxian") < 10 )
    	return ("这次你出力不多，下次定当奋勇争先！");
    if ( who->query("zhuxian") )
    	return ("你可以试着要求 论功行赏！");    	
    
    message("channel:rumor",HIY+"【原始天尊】："+who->query("name")+"奋勇杀敌，大破诛仙阵，论功行赏，拜将封候！\n"+NOR,users() );
    who->set("zhuxian",1);
//    who->delete("skill");
//    who->delete("shushan/book");	//可以重读 仙剑奇侠传

    give_reward(who);	//奖励5级高级内功和高级法术技能
    
    who->add("potential", rewords);
    who->add("combat_exp", rewords);
    who->delete_temp("mark/zhuxian");
    tell_object(who,"你大破诛仙阵，获得奖励 "+chinese_number(rewords)+"点武学经验、"+chinese_number(rewords)+"点潜能！\n");
             
    return ("堪笑通天教不明，千年掌道陷群生; 仗依党恶污仙教，翻聚邪宗枉横行。
    	       宝剑空悬成底事，元神虚耗竟无名；不知顺逆先遭辱，犹欲鸿钧说反盈。\n");
}

string ask_jiang()
{
    object me,who;
    int rewords,qn;
    
    me = this_object();
    who = this_player();
    if (!who->query("zhuxian"))
    	return ("你可以问问大破诛仙阵！");  
    rewords = who->query_temp("mark/zhuxian");
    if ( rewords < 1 )
    	return ("你还要什么奖励？");
    if (!who->query("kill_ttjz"))
        return ("你还没有过完诛仙阵,怎么来要奖励？");
    else
        {

    rewords *= who->query("combat_exp")/3000;
    if( rewords > 210000 ) rewords = 210000 + random(20000);
    if ( who->query("zhuxian") > 12 )
    	rewords = rewords*21/((int)who->query("zhuxian")+10);
    qn = rewords/2+random(rewords/2);
    who->add("potential", qn);
    who->add("combat_exp", rewords);
    who->delete_temp("mark/zhuxian");
  
     message("channel:rumor",HIY+"【原始天尊】："+who->query("name")+"大破诛仙阵论功行赏，奖"+chinese_number(rewords)+"点武学经验、"
    	+chinese_number(qn)+"点潜能！\n"NOR,users() );
     
     
    tell_object(who,"你增加了"+chinese_number(rewords)+"点武学经验、"+chinese_number(qn)+"点潜能！\n");
    
    who->add("zhuxian",1);         
    who->delete("kill_ttjz");         
    return ("好小子干得不错！\n");
        }
}

