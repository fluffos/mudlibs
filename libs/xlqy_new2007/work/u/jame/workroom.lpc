inherit ROOM;
#include <ansi.h>
void create()
{
set("short","蛋糕坊");
set("long",@LONG
这里是嫣然的工作室。温馨的音乐在房间里飘荡，一台奔腾正在嗡嗡地工作。
屋里有一大片空地，据说是为安放音响而预留的。书架(shelf) 上全是小说，
其中一本是嫣然自己的作品。墙上有一副对联(duilian).
LONG    );
set("valid_startroom",1);
set("no_steal","1");
      set("exits", ([
                 "kz":"/d/city/kezhan",
                 "wizroom":"/d/wiz/wizroom",
                 "out":"/d/city/center",
                 "jjt":"/d/ourhome/xiaoting"
                        ]));

        set("objects", 
        ([ //sizeof() == 1
                __DIR__"npc/girl" : 1,
        ]));

set("item_desc", ([
              "shelf" : HIC "\n酒盈杯，书满架，名利从不将心挂。\n" NOR,
              "duilian" : HIG "\n天籁妙，山水雅，醉露为酒玉为花\n" NOR + HIC "若人问我归何处，彩云深处是我家\n" NOR,
        ]));
setup();
}
