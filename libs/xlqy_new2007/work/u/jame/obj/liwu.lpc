#include <ansi.h>
inherit ITEM;
inherit F_AUTOLOAD;

int do_eat();
int do_feel();
void init();

void init() {
  if (!wizardp(this_player())) {
    set("no_drop", 1);
    set("no_get", 1);
    set("no_give", 1);
    set("no_steal", 1);
    set("no_sell", "礼包不能卖！");
  }
  add_action("do_eat", "eat");
  add_action("do_feel", "feel");
}
void create() {
  set_name(HIG "新年" + HIY "礼物" NOR, ({ "xinnian liwu", "liwu", "gift" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long",
      HIY "一份新年礼物，代表着吉祥和喜庆。\n你可以用eat命令来得到武学、道行和潜能；或者用feel命令得到属性点以及技能点。\n" NOR);
    set("unit", "份");

    set("weight", 100);
    set("value", 0);
  }
  setup();

}

int query_autoload() {
  return 1;
}

int do_eat() {
  object baoshi;
  object who = this_player();
  if (this_object()->query("owner_id") != who->query("id")) {
    tell_object(who, "这好像不是你的东西吧...\n");
    this_object()->move("/obj/void");
    destruct(this_object());
    return 1;
  }

  if (who->query("combat_exp") >= 5000000 && random(10) > 6) {
    message_vision(HIG "$N得到了一份神秘礼物！\n" NOR, who);
    baoshi = new("/d/baoshi/obj/wx_y.lpc");
    baoshi->set("no_get", 1);
    baoshi->set("can_putin_fog", 1);
    baoshi->move(who);
  }
  message_vision(HIY "$N拿起手中的" NOR + this_object()->name() + HIY "一口吞了下去，混身舒泰。\n" NOR, who);
  who->add("potential", 100000 + random(50000));
  who->add("combat_exp", 120000 + random(80000));
  who->add("attribute_point", 3);
  who->add("skills_point", 20);
  who->add("daoxing", 100000 + random(80000));
  who->add("faith", 500);
  tell_object(who, HIW "向奋斗在mud第一线的泥鳅们致以节日的问候！\n" NOR);
  this_object()->move("/obj/void");
  destruct(this_object());
  return 1;

}

int do_feel() {
  object baoshi;
  object who = this_player();
  if (this_object()->query("owner_id") != who->query("id")) {
    tell_object(who, "这好像不是你的东西吧...\n");
    this_object()->move("/obj/void");
    destruct(this_object());
    return 1;
  }

  if (who->query("combat_exp") >= 5000000 && random(10) > 6) {
    message_vision(HIG "$N得到了一份神秘礼物！\n" NOR, who);
    baoshi = new("/d/baoshi/obj/wx_y.lpc");
    baoshi->set("no_get", 1);
    baoshi->move(who);
    baoshi->set("can_putin_fog", 1);
  }

  message_vision(
    HIR "$N手中的" NOR + this_object()->name() + HIR "突然散出万道霞光，凌空绕$N飞舞三周，悉数钻入$N天灵中！\n" NOR,
    who
  );
  who->add("attribute_point", 10);
  who->add("skills_point", 50);
  who->add("combat_exp", (int)who->query("combat_exp") / 80);
  who->add("daoxing", (int)who->query("daoxing") / 80);
  tell_object(who, HIY "祝各位泥鳅圣诞快乐！\n" NOR);
  this_object()->move("/obj/void");
  destruct(this_object());
  return 1;
}
