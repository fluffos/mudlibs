#include <ansi.h>
inherit ITEM;
inherit F_AUTOLOAD;
int do_eat();
void init();

void init() {
  if (!wizardp(this_player())) {
    set("no_drop", 1);
    set("no_get", 1);
    set("no_give", 1);
    set("no_steal", 1);
    set("no_sell", 1);
  }
  add_action("do_eat", "eat");
}

void create() {
  set_name(HIR "补偿丹" NOR, ({ "buchang dan", "dan" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long",
      HIY "这是嫣然为了补偿因为BUG死亡的玩家的损失而派发的仙丹。" NOR);
    set("unit", "颗");

    set("weight", 100);
    set("value", 0);
  }
  setup();
}

int query_autoload() {
  return 1;
}

int do_eat() {
  object who = this_player();
  if (this_object()->query("owner_id") != who->query("id")) {
    tell_object(who, "这好像不是你的东西吧...\n");
    this_object()->move("/obj/void");
    destruct(this_object());
    return 1;
  }

  who->add("potential", 20000 + random(30000));
  who->add("obstacle/rebirth", -1);
  tell_object(who, HIW "你增加了一根救命毫毛和一些额外的潜能！\n" NOR);
  this_object()->move("/obj/void");
  destruct(this_object());
  return 1;
}
