#include <ansi.h>
inherit ITEM;
inherit F_AUTOLOAD;

int do_eat();
int do_feel();
void init();

void init() {
  if (!wizardp(this_player())) {
    set("no_drop", 1);
    set("no_get", 1);
    set("no_give", 1);
    set("no_steal", 1);
    set("no_sell", "礼包不能卖！");
  }
  add_action("do_eat", "eat");
  add_action("do_feel", "feel");
}
void create() {
  set_name(HIG "六一" + HIY "礼物" NOR, ({ "liuyi liwu", "liwu", "gift" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long",
      HIY "一份精致的儿童节礼物。\n祖国的花朵们用eat命令得到武学、道行和潜能；大人么，用feel感受一下气氛就好了。\n" NOR);
    set("unit", "份");

    set("weight", 100);
    set("value", 0);
  }
  setup();

}

int query_autoload() {
  return 1;
}

int do_eat() {
  object who = this_player();

  if (who->query("mud_age") >= 345600) {
    tell_object(who, "都这么大人了，还过儿童节...感受一下气氛就好了！\n");
    return 1;
  }
  if (this_object()->query("owner_id") != who->query("id")) {
    tell_object(who, "这好像不是你的东西吧...\n");
    this_object()->move("/obj/void");
    destruct(this_object());
    return 1;
  }

  message_vision(HIY "$N拿起手中的" NOR + this_object()->name() + HIY "一口吞了下去，混身舒泰。\n" NOR, who);
  who->add("potential", 10000 + random(5000));
  who->add("combat_exp", 30000 + random(10000));
  tell_object(who, HIW "向祖国的花朵致以节日的问候！\n" NOR);
  this_object()->move("/obj/void");
  destruct(this_object());
  return 1;

}

int do_feel() {
  object who = this_player();
  if (this_object()->query("owner_id") != who->query("id")) {
    tell_object(who, "这好像不是你的东西吧...\n");
    this_object()->move("/obj/void");
    destruct(this_object());
    return 1;
  }
  if (who->query("mud_age") <= 345600) {
    tell_object(who, "小孩子嘛，好好过儿童节...\n");
    return 1;
  }


  message_vision(HIR "$N手中的" NOR + this_object()->name() + HIR "突然金光耀眼，$N的腰板顿时挺了挺！\n" NOR, who);
  who->add("balance", (int)who->query("combat_exp") * 2);
  tell_object(who, HIY "祝各位泥鳅儿童节快乐！\n" NOR);
  this_object()->move("/obj/void");
  destruct(this_object());
  return 1;
}
