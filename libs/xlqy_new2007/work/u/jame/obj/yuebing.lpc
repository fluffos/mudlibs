#include <ansi.h>
inherit ITEM;
inherit F_AUTOLOAD;

int do_eat();
void init();

void init() {
  if (!wizardp(this_player())) {
    set("no_drop", 1);
    set("no_get", 1);
    set("no_give", 1);
    set("no_steal", 1);
    set("no_sell", "月饼怎么能卖呢！");
  }
  add_action("do_eat", "eat");
}
void create() {
  set_name(HIR "中秋" + HIY "月饼" NOR, ({ "yue bing", "bing", "yuebing" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long",
      HIY "一盒极品莲蓉月饼。" NOR);
    set("unit", "盒");

    set("weight", 100);
    set("value", 0);
  }
  setup();

}

int query_autoload() {
  return 1;
}

int do_eat() {
  object who = this_player();
  if (this_object()->query("owner_id") != who->query("id")) {
    tell_object(who, "这好像不是你的东西吧...\n");
    this_object()->move("/obj/void");
    destruct(this_object());
    return 1;
  }
  message_vision(HIY "$N拿起手中的" NOR + this_object()->name() + HIY "一口吞了下去，混身舒泰。\n" NOR, who);
  who->add("attribute_point", 2);
  who->add("skills_point", 6);
  who->add("combat_exp", -800000);
  tell_object(who, HIW "向奋斗在mud第一线的泥鳅们致以节日的问候！\n" NOR);
  this_object()->move("/obj/void");
  destruct(this_object());
  return 1;

}
