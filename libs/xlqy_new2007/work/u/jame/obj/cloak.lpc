int do_testexp(string arg)
{
        int level,lv;
        int exp,add,ratio;
//      if(!userp(ob)) return 0;
        
        sscanf(arg,"%d",lv);
//      lv = ob->query("level")+1;
        
        if(lv<51)
        { 
                exp=200;
                add=800;
                ratio=200;
                for(level =0;level < lv;level++)
                {
                 exp += add; 
                ratio += ratio*6/100;
                add += (ratio/100)*100;
                }
                exp = exp*10+exp*lv*lv/200;             

         }
        else
                {
                exp=18072000;
                add=1210000;
                for (level = 50;level < lv; level++)
                {
                add = add*1.2;
                exp += add;  
                }}

                
                
printf("the exp is %d\n",exp);
return exp;
}
