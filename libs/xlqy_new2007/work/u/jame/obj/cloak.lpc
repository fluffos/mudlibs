int do_aaaa(string name)
{
        object me;
        object who;
        string arg;
        int time;
        int exp,dx,qn,gold;
        me = this_player();
        sscanf(name,"%s for %d",arg,time);
        printf("arg is %s\n",arg);
        printf("time is %d\n",time);
         if(!who=find_player(arg))
         return 0;
         exp = 5000*time;
         dx = exp*1/2;
         qn = exp*2/3;

        gold = 1000000*time;
         
         who->add("combat_exp",exp);
          who->add("daoxing",dx);
           who->add("potential",qn);
           who->add("balance",gold);
        message("channel:chat",HIY+"【个人奖励 】："+who->query("name")+"参加水陆大会获得经验值"+exp+"，道行"+dx+"，潜能"+qn+"和黄金"+gold/10000+"两！\n"+NOR,users());
   
        return 1;
        
        
        
}
int do_reward(string name)
{
        object me;
        object who;
        int exp,dx,qn,gold;
        me = this_player();
         if(!who=find_player(name))
         return 0;
         exp = 50000+who->query("combat_exp")/200;
         dx = exp*2/5;

         qn = exp*1/6;
         gold = 1110000;
         
         who->add("combat_exp",exp);
          who->add("daoxing",dx);
           who->add("potential",qn);
           who->add("balance",gold);
        message("channel:chat",HIW+"【 水陆大会 】："+who->query("name")+"参加水陆大会获得经验值"+exp+"，道行"+dx+"，潜能"+qn+"和黄金"+gold/10000+"两！\n"+NOR,users());
   
        return 1;
        
        
        
}
int do_testsldh(string name)
{
      object ob; 
        object me;
        mapping skl,lrn, map;
        string *sname, *mapped;
        int i,flag;
        string force;
        int total;

        total = 0;
    
        me = this_player();
       if(!wizardp(me)) return notify_fail("You are not allowed to use this cmds!\n");
        if( !name) return notify_fail("Please enter player's id!\n");
        seteuid(getuid());
        if(!ob=find_player(name))
          {
                flag=1;
                ob = new(USER_OB);
                ob->set("id", name);
                if (!ob->restore()) return notify_fail("没有这个玩家。\n");
          }
     
        
        
        
                force = ob->query_skill_mapped("force");
                printf("the force is %s\n",force);
                total += ob->query_skill(force,1)*ob->query_skill(force,1)*ob->query_skill(force,1)/50;
                total += ob->query("str");
                total += ob->query("level")*ob->query("level");
                total += ob->query("combat_exp")*2/3+ob->query("daoxing")/3;

                total += ob->query_max_force()*2/3;
                total += ob->query_max_mana()/3;
                printf(ob->query("id")+"            %d         %d\n",total,ob->query("combat_exp"));
                        
        
        if (flag) destruct(ob);
        return 1;
        
        
}
