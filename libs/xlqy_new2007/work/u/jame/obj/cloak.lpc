string inputstr,verb;


void create()
{
  seteuid(getuid());

set("long",@LONG
    这是一件神奇的魔法师披风，为了巫师工作方便，巫师们常常需要穿这件披风
    如果巫师们想要有进一步的功能欢迎提供

    本披风写的并不好, 尤其是讯息的显示并不一致，
    本物件欢迎大巫师(arch)修改成更完善一点

    也不希望巫师拿来做坏事, 还有, 不可干扰玩家
    否则重则打入十八层地狱，轻则禁足一个月，至於判断标准由大神(admin)裁夺

    键入<help cloak>以获得更多的资讯。

LONG
);

  set("unit","件");

  set("material", "cloth");
  set("armor_prop/armor", 100);
  set("armor_type", "cape");
  set("no_give",1);
  set("light",1);
  setup();
}
void init()
{
  object me;
  seteuid(geteuid());


 me = this_player(1);
  if (me)
    set_name (me->name(1)+ "的魔法师披风", ({ "wiz cloak", "cloak" }));
  else
    set_name (HIW"魔法师披风"NOR, ({ "wiz cloak", "cloak" }));
  add_action("do_testdamage","damage");
  add_action("help","help");
  add_action("do_baa","baa");
  add_action("full","full");
  add_action("rem","rem");
  add_action("wave","wave");
  add_action("steal","steal");
  add_action ("whereis", "whereis");
  add_action ("pk_mob", "mobpk");
  add_action ("do_wakeup", "wakeup");
  add_action ("neili_quit", "fquit");
  add_action("do_sha", "K");
  add_action("do_hun", "hun");
  add_action("full", "full");
  add_action("do_test","test");
  add_action("do_order","order");
  add_action("do_admin","admin");
  add_action("do_testtime","testtime");

 add_action("do_testra","testra");
  add_action("do_testexp","testexp");
  add_action("do_ann","announce");
add_action("do_testshoucheng","shoucheng");
  add_action("do_dropset","dropset");
  add_action("do_testsldh","testsldh");
//  add_action("do_reward","reward");
    add_action("do_aaaa","aaaa");
  this_player()->set_temp("heat",1);
}
