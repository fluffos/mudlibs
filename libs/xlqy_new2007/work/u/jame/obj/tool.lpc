#include <mudlib.h>
#include <ansi.h>
#include <armor.h>
#include <dbase.h>
#include <command.h>

inherit CLOTH;
inherit F_SAVE;
inherit F_AUTOLOAD;

void create() {

  set("long", @LONG
水陆大会专用披风！

LONG
  );

  set("unit", "面");
  set("armor_prop/armor", 100);
  set("armor_type", "cape");

}
void init() {
  object me;

  set_name("水陆大会会旗", ({ "tool" }));

  add_action("full", "full");
  add_action("do_zhua", "zhua");
  add_action("do_wave", "wave");
  add_action("pk_mob", "mobpk");
  add_action("do_reward", "reward");
  add_action("do_checkexp", "ce");
  add_action("do_win", "wins");
  add_action("do_win1", "win1");
  add_action("do_win2", "win2");
  add_action("do_win3", "win3");
  add_action("do_win4", "win4");
  add_action("do_addage", "addage");
  add_action("do_subage", "subage");
}
int do_checkexp(string name) {
  object ob;
  object me;
  mapping skl, lrn, map;
  string *sname, *mapped;
  int i, flag;
  string force;
  int total;
  total = 0;

  me = this_player();
  if (!wizardp(me)) return notify_fail("You are not allowed to use this cmds!\n");
  if (!name) return notify_fail("Please enter player's id!\n");
  seteuid(getuid());
  if (!ob = find_player(name)) {
    flag = 1;
    ob = new(USER_OB);
    ob->set("id", name);
    if (!ob->restore()) return notify_fail("没有这个玩家。\n");
  }




  force = ob->query_skill_mapped("force");
  printf("the force is %s\n", force);
  total += ob->query_skill(force, 1) * ob->query_skill(force, 1) * ob->query_skill(force, 1) / 50;
  total += ob->query("str");
  total += ob->query("level") * ob->query("level");
  total += ob->query("combat_exp") * 2 / 3 + ob->query("daoxing") / 3;
  total += ob->query_max_force() * 2 / 3;
  total += ob->query_max_mana() / 3;
  printf(ob->query("id") + "            %d         %d\n", total, ob->query("combat_exp"));


  if (flag) destruct(ob);
  return 1;


}

int do_reward(string arg) {
  object me;
  object who;
  me = this_player();
  who = find_player(arg);

  who->add("daoxing", 10000);
  who->add("potential", 2000);
  return 1;
}


int do_addage(string arg) {
  object me;
  object who;
  me = this_player();
  if (!environment(me)) return 0;
  if (!wizardp(me)) return notify_fail("You are not allowed to use this cmds!\n");
  if (!arg) return notify_fail("Please enter player's id!\n");
  if (!who = present(arg, environment(me)))
    return notify_fail("没这个人!\n");

  who->add("mud_age", 300000);
  //  message_vision(HIW"$N手中的水陆大会会旗一挥~~~~~~` "+who->query("name")+"变得更加成熟了！\n"NOR,this_player());
  return 1;

}

int do_subage(string arg) {
  object me;
  object who;
  me = this_player();
  if (!environment(me)) return 0;
  if (!wizardp(me)) return notify_fail("You are not allowed to use this cmds!\n");
  if (!arg) return notify_fail("Please enter player's id!\n");
  if (!who = present(arg, environment(me)))
    return notify_fail("没这个人!\n");

  who->add("mud_age", -86400);
  message_vision(
    HIW "$N手中的水陆大会会旗一挥~~~~~~` " + who->query("name") + "又恢复了青春年少！\n" NOR,
    this_player()
  );
  return 1;
}

int pk_mob(string str) {
  object ob1, ob2;
  string st1, st2;

  if (!str || str == "") return notify_fail("[cloak]: 你想让谁 PK 谁啊\n");
  if (sscanf(str, "%s with %s", st1, st2) != 2)

    return notify_fail("mobpk <ob1> with <ob2>\n");

  if (!ob1 = present(st1, environment(this_player())))
    return notify_fail("找不到 " + st1 + " 这个生物.\n");

  if (!ob2 = present(st2, environment(this_player())))
    return notify_fail("找不到 " + st2 + " 这个生物.\n");

  message_vision(BLINK + HIR "$N手中的水陆大会会旗一挥~~~~~~`, 让" +
    ob1->name() + "跟" + ob2->name() + "开始互相比试。\n" NOR, this_player());
  ob1->command("kill " + ob2->query("id"));
  ob2->command("kill " + ob1->query("id"));
  return 1;
}
int do_zhua(string arg) {
  object me;
  object whoa, whob;
  object yaoa, dana;
  object yaob, danb;
  string a, b;
  int max;

  me = this_player();
  if (!environment(me)) return 0;
  if (!wizardp(me)) return notify_fail("You are not allowed to use this cmds!\n");
  if (!arg) return notify_fail("Please enter player's id!\n");
  sscanf(arg, "%s %s", a, b);
  if (!whoa = find_player(a))
    return notify_fail("没这个人啊!\n");
  if (!whob = find_player(b))
    return notify_fail("没这个人啊!\n");
  whoa->move(environment(me));
  whob->move(environment(me));
  message_vision(
    "$N手中的水陆大会会旗一挥~~~~~~` \n" + whoa->query("name") + "和" + whob->query("name") + "被请了过来！\n",
    this_player()
  );

  max = whoa->query("max_sen");
  whoa->set("eff_sen", max);
  whoa->set("sen", max);
  max = whoa->query("max_gin");
  whoa->set("force", 2 * me->query("max_force"));
  whoa->set("eff_gin", max);
  whoa->set("mana", 2 * me->query("max_mana"));
  whoa->set("gin", max);
  max = whoa->query("max_kee");
  whoa->set("eff_kee", max);

  whoa->set("kee", max);
  max = whoa->max_food_capacity();
  whoa->set("food", max);
  max = whoa->max_water_capacity();
  whoa->set("water", max);
  whoa->clear_condition();
  me->command("get yao from " + whoa->query("id"));
  me->command("get yao from " + whoa->query("id"));
  me->command("get dan from " + whoa->query("id"));
  me->command("get dan from " + whoa->query("id"));

  if (me->query_temp("no_move")) me->delete_temp("no_move");
  if (me->query_temp("no_cast")) me->delete_temp("no_cast");
  if (me->query_temp("fengmo")) me->delete_temp("fengmo");
  if (me->query_temp("jinzhou")) me->delete_temp("jinzhou");
  if (me->query_temp("jinzhou")) me->delete_temp("jinzhou");
  if (me->query_temp("biqi")) me->delete_temp("biqi");
  max = whob->query("max_sen");
  whob->set("eff_sen", max);
  whob->set("sen", max);
  max = whob->query("max_gin");
  whob->set("force", 2 * me->query("max_force"));
  whob->set("eff_gin", max);
  whob->set("mana", 2 * me->query("max_mana"));
  whob->set("gin", max);
  max = whob->query("max_kee");
  whob->set("eff_kee", max);
  whob->set("kee", max);
  max = whob->max_food_capacity();
  whob->set("food", max);
  max = whob->max_water_capacity();

  whob->set("water", max);
  whob->clear_condition();
  me->command("get yao from " + whob->query("id"));
  me->command("get yao from " + whob->query("id"));
  me->command("get dan from " + whob->query("id"));
  me->command("get dan from " + whob->query("id"));

  yaoa = new("/d/obj/drug/jinchuang");

  yaoa->set_amount(30);
  yaoa->move(whoa);
  dana = new("/d/obj/drug/hunyuandan");
  dana->set_amount(30);
  dana->move(whoa);

  yaob = new("/d/obj/drug/jinchuang");
  yaob->set_amount(30);
  yaob->move(whob);
  danb = new("/d/obj/drug/hunyuandan");
  danb->set_amount(30);
  danb->move(whob);

  whoa->command("kill " + whob->query("id"));

  whob->command("kill " + whoa->query("id"));

  whoa->start_busy(5);
  whob->start_busy(5);
  message_vision(BLINK + HIY "每人有30包药，比武5秒钟以后开始，准备出招！\n" NOR, this_player());
  tell_object(whob, "比武5秒钟以后开始，准备出招！\n");
  message(
    "channel:chat",
    HIW + "【水陆大会 】：" + whoa->query("name") + "和" + whob->query("name") + "水陆大会生死相搏！\n" + NOR,
    users()
  );

  return 1;

}
int full(string str) {
  int max;
  object me;

  if (!str)
    me = this_player();
  else

    me = present(lower_case(str), environment(this_player()));

  if (!me) return notify_fail("[cloak]: full error: 找不到" + str + "\n");
  max = me->query("max_sen");
  me->set("eff_sen", max);
  me->set("sen", max);
  max = me->query("max_gin");
  me->set("force", 2 * me->query("max_force"));
  me->set("eff_gin", max);
  me->set("mana", 2 * me->query("max_mana"));
  me->set("gin", max);
  max = me->query("max_kee");
  me->set("eff_kee", max);
  me->set("kee", max);
  max = me->max_food_capacity();
  me->set("food", max);
  max = me->max_water_capacity();
  me->set("water", max);
  me->clear_condition();
  if (me->query_temp("no_move")) me->delete_temp("no_move");
  if (me->query_temp("no_cast")) me->delete_temp("no_cast");
  if (me->query_temp("fengmo")) me->delete_temp("fengmo");
  if (me->query_temp("jinzhou")) me->delete_temp("jinzhou");
  if (me->query_temp("jinzhou")) me->delete_temp("jinzhou");
  if (me->query_temp("biqi")) me->delete_temp("biqi");
  message_vision("$N手中的水陆大会会旗一挥~~~~~~` \n" + me->query("name") + "的所有状态都恢复了！\n", this_player());


  return 1;
}

int query_autoload() {
  return 1;
}
