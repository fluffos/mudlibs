// by jame @ 秋千雅阁, 2005-8-22
// 六脉神剑

#include <ansi.h>
#include <combat.h>
inherit SSERVER;

int perform(object me, object target) {
  string msg;
  string str;
  string level;
  int delay, myunarmed, damage, exp_target, exp_mine;

  myunarmed = (int)me->query_skill("NO.1_skill", 1);
  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("[六脉神剑]只能在战斗中使用\n");

  //        if(!wizardp(me))
  //                return notify_fail(HIR"「六脉神剑」"+NOR"只有巫师才能使用！\n");

  if (myunarmed < 100)
    return notify_fail("你的第一神功修为不够深，无法使用[六脉神剑]。\n");

  if ((int)me->query("force") < 500)
    return notify_fail("你的内力不够. \n");
  exp_mine = (int)me->query("combat_exp");
  exp_target = (int)target->query("combat_exp");
  msg = "";
  me->add("force", -500);
  me->recieve_damage("kee", 2);

  message_vision(
    HIW "$N轻轻一笑，左臂伸出，左右连划了九个圆圈!!\n$N默用" NOR + HIR "第一神功" NOR + HIB ",虚而又实，使出了" NOR + HIG "" + BLINK "「六脉神剑」" NOR + HIW "！！\n" NOR,
    me,
    target
  );
  message_vision(
    MAG "$N手臂陡然一提，发起攻击，手掌离$n不到一尺，立即变掌为指，使出" + NOR + HIY "" + BLINK "「少泽剑」" NOR + HIC "。\n" NOR,
    me,
    target
  );
  if (exp_mine > (int)(exp_target / 1000)) {
    damage = exp_mine / exp_target * 100 + random(100);
    if (damage < 150) damage = 150;
    if (damage > 300) damage = 300;
    target->receive_damage("kee", me->query("eff_kee") * damage / 80, me);
    target->receive_wound("kee", me->query("eff_sen") * damage / 100, me);
    message_vision(msg, me, target);
    COMBAT_D->report_status(target);
  } else {
    msg = HIC "$n忙运功向抗，深厚的内力将$N的攻势都激散了。\n\n" NOR;
    message_vision(msg, me, target);
  }

  message_vision(
    HIC "$N双掌自外向里划了一个圈，双掌托在胸前，伸出右小指，一招" NOR + HIR "" + BLINK "「少冲剑」" NOR + HIC "。\n" NOR,
    me,
    target
  );
  if (exp_mine > (int)(exp_target / 1000)) {
    damage = exp_mine / exp_target * 100 + random(100);
    if (damage < 150) damage = 150;
    if (damage > 300) damage = 300;
    target->receive_damage("kee", me->query("eff_kee") * damage / 80, me);
    target->receive_wound("kee", me->query("eff_sen") * damage / 100, me);
    message_vision(msg, me, target);
    COMBAT_D->report_status(target);
  } else {
    msg = HIC "$n却心静如水，丝毫不显慌乱，见招拆招，瓦解了$N这无声的攻势。\n\n" NOR;
    message_vision(msg, me, target);
  }
  message_vision(
    HIR "$N长笑一声，右手硬生生缩回，左手横斩而至，俯身斜倚，无名指弹出，一式" NOR + HIG "" + BLINK "「关冲剑」" NOR + HIC "。\n\n" NOR,
    me,
    target
  );
  if (exp_mine > (int)(exp_target / 1000)) {
    damage = exp_mine / exp_target * 100 + random(100);
    if (damage < 150) damage = 150;
    if (damage > 300) damage = 300;
    target->receive_damage("kee", me->query("eff_kee") * damage / 80, me);
    target->receive_wound("kee", me->query("eff_sen") * damage / 100, me);
    message_vision(msg, me, target);
    COMBAT_D->report_status(target);
  } else {
    msg = HIC "$n看准来势，轻轻一跳，躲了开去。\n\n" NOR;
    message_vision(msg, me, target);
  }

  message_vision(
    HIG "$N食指连动，快速无比，格开对方来势，变招奇速，如毒蛇出洞，疾从袖底穿出，大喝一声，使出" NOR + HIM "" + BLINK "「商阳剑」" NOR + HIC "。\n\n" NOR,
    me,
    target
  );
  if (exp_mine > (int)(exp_target / 1000)) {
    damage = exp_mine / exp_target * 100 + random(100);
    if (damage < 150) damage = 150;
    if (damage > 300) damage = 300;
    target->receive_damage("kee", me->query("eff_kee") * damage / 80, me);
    target->receive_wound("kee", me->query("eff_sen") * damage / 100, me);
    message_vision(msg, me, target);
    COMBAT_D->report_status(target);
  } else {
    msg = HIC "$n似乎对这招异常熟悉，不进反退，化解了这招。\n\n" NOR;
    message_vision(msg, me, target);
  }

  message_vision(
    CYN "两指之间，相距只是电光般一闪，$N一翻掌，身向右移，奋起神威，右手斗然探出，中指一竖，一招" NOR + HIW "" + BLINK "「中冲剑」" NOR + HIC "。\n\n" NOR,
    me,
    target
  );
  if (exp_mine > (int)(exp_target / 1000)) {
    damage = exp_mine / exp_target * 100 + random(100);
    if (damage < 150) damage = 150;
    if (damage > 300) damage = 300;
    target->receive_damage("kee", me->query("eff_kee") * damage / 80, me);
    target->receive_wound("kee", me->query("eff_sen") * damage / 100, me);
    message_vision(msg, me, target);
    COMBAT_D->report_status(target);
  } else {
    msg = HIC "$n忙运功向抗，深厚的内力将$N的攻势都激散了。\n\n" NOR;
    message_vision(msg, me, target);
  }

  message_vision(
    HIM "$N意犹未尽,大拇指连挥,使出" NOR + HIB "" + BLINK "「少商剑」" NOR + HIC ",便如是一幅泼墨山水相似，纵横倚斜，寥寥数笔，却是剑路雄劲！\n\n" NOR,
    me,
    target
  );
  message_vision(msg, me, target);
  if (exp_mine > (int)(exp_target / 1000)) {
    damage = exp_mine / exp_target * 100 + random(100);
    if (damage < 150) damage = 150;
    if (damage > 300) damage = 300;
    target->receive_damage("kee", me->query("eff_kee") * damage / 80, me);
    target->receive_wound("kee", me->query("eff_sen") * damage / 100, me);
    delay = 2 + random(myunarmed / 20);
    target->start_busy(delay);
    if (delay < 5) delay = 5;
    if (delay > 10) delay = 10;
    message_vision(msg, me, target);
    COMBAT_D->report_status(target);
    if ((target->query("eff_kee") < 0 && random(10) > 4) || !living(target) && random(10) > 4) {
      msg = target->name() + "被" + HIG "" + me->name() + "" + HIM "用绝技" NOR + HIY "" + BLINK "「六脉神剑」" NOR + HIC "杀死了，听说尸体上仍清晰地留着" NOR + HIR "六个大洞";
      message("channel:rumor", HIM "【空穴来风】某人：" + msg + "\n" NOR, users());
    }
  } else {
    msg = HIC "$n却心静如水，丝毫不显慌乱，见招拆招，瓦解了$N这无声的攻势。\n\n" NOR;
    message_vision(msg, me, target);
  }
  level = me->query("skill_level/unarmed");
  if (level = "grandmaster")
    me->start_busy(0);
  else if (level = "master")
    me->start_busy(random(2));
  else if (level = "expert")
    me->start_busy(random(4));
  else
    me->start_busy(2 + random(2));
  return 1;
}
