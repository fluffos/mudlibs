inherit NPC;
#include <ansi.h>


void create()
{
        set_name(HIW"神龙教"NOR, ({"ls npc"}));
        set("gender", "男性" );
        set("age", 20);
        set("long", "他是乱世站的xxx。\n");
        set("attitude", "friendly");
        set("combat_exp", 80000000);
        set("daoxing", 80000000);
        set("attitude", "peaceful");
        set_skill("unarmed", 600);
        set_skill("dodge", 60);
        set_skill("parry", 600);
        set_skill("literate", 50);
        set_skill("spells", 600);
        set("per", 30);
        set("max_kee", 35000);
        set("max_gin", 300);
        set("max_sen", 30000);
        set("max_mana", 7500);
	set("max_force", 7500);
        set("mana", 15000);
	set("force", 15000);
        set("mana_factor", 5);

	setup();
       carry_object("/d/obj/cloth/choupao")->wear();
}

void init()
{
    object ob=this_object(); 
          
         if( interactive (ob) ) 
                  remove_call_out("check_time"); 
             if( !ob->query_temp("check_time") ) 
          { 
                   call_out("check_time", 1); 
                   ob->set_temp("check_time",1); 
           } 
}

int check_time() 
{ 
      object me=this_object(); 
      
 if((time()-query("say_time")) > 1500) 
     {     
          me->set("say_time",time()); 
          command("chat 乱世MUD社区提供玩家门类齐全的各类型MudGame 目前开放的游戏有： \n");
	  command("chat 1.风云蓝本乱世站 www.lsmud.com 6666 \n");
	  command("chat 2.仙侣情缘乱世站 www.lsmud.com 7777 \n");
	  command("chat 3.三界神化乱世站 www.lsmud.com 8888 \n");
	  command("chat 论坛： www.lsmud.com/lsmud QQ群： 15361272 \n");
      } 
      
       remove_call_out("check_time"); 
         call_out("check_time",30); 
       return 1; 
} 
