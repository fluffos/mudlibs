#include <ansi.h>

inherit ITEM;

void create()
{
  set_name( "灵芝", ({"ling zhi", "zhi"}));
  set_weight(120);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "颗");
    set("long", "有什奇的法力。\n");
    set("value", 2000);
    //set("no_sell", 1);
    set("drug_type", "补品");
  }
  setup();
}

void init()
{
  add_action("do_eat", "eat");
}

int do_eat(string arg)
{
  object me = this_player();
  if (arg!="ling zhi" && arg!="zhi") 
      return notify_fail("你要吃什么？\n");
  
  me->set("mana", (int)me->query("max_mana")+random(100));
  message_vision(HIG "$N吃下一颗灵芝。\n" NOR, me);
  tell_object(me, "你顿时觉得一股灵气从头顶注入。\n");
  destruct(this_object());
  return 1;
}

