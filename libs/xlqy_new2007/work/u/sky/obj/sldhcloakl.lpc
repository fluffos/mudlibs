inherit CLOTH;
inherit F_SAVE;
inherit F_AUTOLOAD;

void create()
{
 
set("long",@LONG
水陆大会专用披风！

LONG
);

  set("unit","面");
  set("armor_prop/armor", 100);
  set("armor_type", "cape");

set("team/A",({}));
set("team/B",({}));
set("team/C",({}));
set("team/D",({}));
  setup();
}
void init()
{
  object me;
  
  set_name ("水陆大会会旗", ({ "cloak" }));
 
  add_action("full","full");
 add_action("do_zhua","zhua");
  add_action("do_wave","wave");
  add_action ("pk_mob", "mobpk");
add_action("do_reward","reward");
add_action("do_checkexp","ce");
add_action("do_win","wins");
 add_action("do_win1","win1");
 add_action("do_win2","win2");
 add_action("do_win3","win3");
 add_action("do_win4","win4");
add_action("do_cs","cs");
add_action("do_teamadd","teamadd");
add_action("do_teamsub","teamsub");
}
  int do_teamadd(string arg)
                 {
                     string name,team;
                     string *tt;
                     object cc;
                     cc = this_object();
					
					 if(!arg)
						 return notify_fail("请按此格式输入命令:'teamadd 玩家id to 队名' !\n");

					 if( sscanf(arg, "%s to %s",name,team)==2)
					 {
                     
					 object who;
					 if(!who=find_player(name))
						 return notify_fail("没这个人啊!\n");

                     tt = cc->query("team/"+team);
                     if(sizeof(tt) == 0)
                      tt = ({ });
                     for(int i =0;i < sizeof(tt);i++)
                     {
                         if(strcmp(tt[i],name) == 0)
                           {
                            printf("the name has added\n");
                            return 1;
                            }
					 
                    }
 tt += ({name});
cc->set("team/"+team,tt);
                     printf("the name %s has added to team %s\n",name,team);
                     return 1;
					 }
					 else
						 return notify_fail("请按此格式输入命令:'teamadd 玩家id to 队名' !\n");



                 }
  int do_teamsub(string arg)
                 {

                           string name,team;
                     string *tt;
                     object cc;
                     int i;
                     cc = this_object();
					 if(!arg)
						 return notify_fail("请按此格式输入命令:'teamsub 玩家id from 队名' !\n");
                     
                     if(sscanf(arg,"%s from %s",name,team)==2)
					 {
                     tt = cc->query("team/"+team);
                     for(i =0;i < sizeof(tt);i++)
                     {
                         if(strcmp(tt[i],name) == 0)
                           {
 tt[i] = "";
 printf("the name %s has removed from team %s\n",name,team);
                            return 1;
                            }
                      
                     }
 if(i == sizeof(tt))
                        printf("has no the name in the team\n");
                     return 1;
					 }
					 else
						 return notify_fail("请按此格式输入命令:'teamsub 玩家id from 队名' !\n"); 




                 }
                 int do_cs()
                 {
                         object me ,who,cc;
                         string name;
                         string *team,*pp;
                         mapping tt;
                         int pt,total;
                         me = this_player();
                         if(!wizardp(me)) return 0;
                   cc = this_object();
message_vision("\n各队积分情况是：\n",me);
message_vision(HIW"-------------------------------------------\n\n"NOR,me);
                   if(mapp(tt = cc->query("team")))
                   {
                                         team = keys(tt);
                                         for(int i = 0 ;i <sizeof(team);i ++)
                             {
  pp = cc->query("team/"+team[i]);
if(sizeof(pp) == 0)
continue;
total = 0;
                                                         if( i ==0)
message_vision(HIR"队         "+team[i],me);
                                                                 else if( i ==1)
 message_vision(HIY"队         "+team[i],me);
                                                         else    if( i ==2)
 message_vision(HIG"队         "+team[i],me);
                                                         else if( i ==3)
 message_vision(HIW"队         "+team[i],me);
                                                         else
 message_vision(HIM"队         "+team[i],me);
 for(int j = 0 ;j <sizeof(pp);j++)
                                     {   
                                         name = pp[j];
 if(strcmp("",name) == 0) continue;
                                                         if(!who=find_player(name))
                                                                 pt = 0;
                                                 else pt = who->query("sldh/point");     
                                                                 total += pt;
message_vision("\n"+name+"           :         "+pt,me);
                                                 }       
 message_vision("\n\n队总积分："+total+"\n"NOR,me);
message_vision("\n-------------------------------------------\n",me);
                                         }
                                         
                                 }
 printf(HIW"-------------------------------------------\n\n"NOR);
                   
                 return 1;
                 }
int do_win1(string arg)
{
	object me;
	object who;
	string name,*pp;
	object ring;
	int exp,dx,qn,gold;
	me = this_player();
	
	if(!wizardp(me))
		return 0;
	
	who = find_player(arg);

	printf("arg is %s\n",arg);

	if(!strcmp(arg,"teama")||!strcmp(arg,"teamb")||!strcmp(arg,"teamc")||!strcmp(arg,"teamd"))
	{
		if( arg == "teama")
			arg = "A";
		if( arg == "teamb")
			arg = "B";
		if( arg == "teamd")
			arg = "D";
		if( arg == "teamc")
			arg = "C";
		
		pp = this_object()->query("team/"+arg);
		printf("%O\n",pp);
		
		for(int j = 0 ;j <sizeof(pp);j++)
		{
			name = pp[j];
			
			if(!who=find_player(name))
				continue;
			ring = new("/d/wiz/obj/sldh/champion1");
			ring->move(who);
			exp = 30000+who->query("combat_exp")/10;
			dx = exp*3/4;
			qn = exp*2/3;
			gold = 5000000;
			who->add("attribute_point",5);
			who->add("combat_exp",exp);
			who->add("daoxing",dx);
			who->add("potential",qn);
			who->add("balance",gold);
			message("channel:chat",HIW+"【 水陆大会 】："+HIR+who->query("name")+HIW"参加水陆大会获得"+HIY"冠军"+HIW"，奖励冠军护身符一枚，\n以及五点属性点数，经验值"+exp+"，道行"+dx+"，潜能"+qn+"和黄金"+gold/10000+"两！\n"+NOR,users());
		}
	}
	else if(who)
	{
		ring = new("/d/wiz/obj/sldh/champion1");
		ring->move(who);
		exp = 30000+who->query("combat_exp")/10;
		dx = exp*3/4;
		qn = exp*2/3;
		gold = 5000000;
		who->add("attribute_point",5);
		who->add("combat_exp",exp);
		who->add("daoxing",dx);
		who->add("potential",qn);
		who->add("balance",gold);
		message("channel:chat",HIW+"【 水陆大会 】："+HIR+who->query("name")+HIW"参加水陆大会获得"+HIY"冠军"+HIW"，奖励冠军护身符一枚，\n以及五点属性点数，经验值"+exp+"，道行"+dx+"，潜能"+qn+"和黄金"+gold/10000+"两！\n"+NOR,users());
	}
	return 1;                     
}

