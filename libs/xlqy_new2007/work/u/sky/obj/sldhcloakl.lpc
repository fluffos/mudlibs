                 who = find_player(arg);
                  printf("arg is %s\n",arg);
                 if(!strcmp(arg,"teama")||!strcmp(arg,"teamb")||!strcmp(arg,"teamc")||!strcmp(arg,"teamd"))
                  {
                  if( arg == "teama")
                   arg = "A";
                 if( arg == "teamb") arg = "B";
                  if( arg == "teamd") arg = "D";
                  if( arg == "teamc") arg = "C";
                 pp = this_object()->query("team/"+arg);
                 printf("%O\n",pp);
                 for(int j = 0 ;j <sizeof(pp);j++)
                 {
                 name = pp[j];
                  if(!who=find_player(name))
                 continue;
                        exp = 30000+who->query("combat_exp")/200;
                                           dx = exp*2/5;
                                           qn = exp*1/6;
                                           gold = 1110000;
                                           
 exp += 10000*who->query("sldh/point");
 dx += 8000*who->query("sldh/point");
 qn += 5000*who->query("sldh/point");
                 pot = who->query("sldh/point");
                 gold = 500000*who->query("sldh/point");
                 gold = 500000*who->query("sldh/point") +  1110000;;
                 who->add("skills_point",who->query("sldh/point"));
                 who->delete("sldh/point");
                                           who->add("combat_exp",exp);
                                            who->add("daoxing",dx);
                                             who->add("potential",qn);
                                             who->add("balance",gold);
 message("channel:chat",HIY+"【 个人奖励 】："+HIR+who->query("name")+HIW"参加水陆大会获得经验值"+exp+"，道行"+dx+"，潜能"+qn+"和黄金"+gold/10000+"两以及"+pot+"技能点数！\n"+NOR,users());
                                     
}
return 1;
                 }
                 else if(who)
                 {
                          exp = 30000+who->query("combat_exp")/200;
                          dx = exp*2/5;
                          qn = exp*1/6;
                          gold = 1110000;
                          
 exp += 10000*who->query("sldh/point");
 dx += 8000*who->query("sldh/point");
 qn += 5000*who->query("sldh/point");
pot = who->query("sldh/point");
gold = 500000*who->query("sldh/point");
gold = 500000*who->query("sldh/point") +  1110000;;
who->add("skills_point",who->query("sldh/point"));
who->delete("sldh/point");
                          who->add("combat_exp",exp);
                           who->add("daoxing",dx);
                            who->add("potential",qn);
                            who->add("balance",gold);
 message("channel:chat",HIY+"【 个人奖励 】："+HIR+who->query("name")+HIW"参加水陆大会获得经验值"+exp+"，道行"+dx+"，潜能"+qn+"和黄金"+gold/10000+"两以及"+pot+"技能点数！\n"+NOR,users());
                    
                         return 1;
}
}

int do_wave(string arg)
{
        
        object me;
        object who;
        object yao,dan;
         me = this_player();
         if(!environment(me)) return 0;
         if(!wizardp(me)) return notify_fail("You are not allowed to use this cmds!\n");
        if( !arg) return notify_fail("Please enter player's id!\n");  
  if(!who=present(arg,environment(me)))
                return notify_fail("没这个人!\n");      
        yao = new("/d/obj/drug/jinchuang");
        
 yao->set_amount(20);
        yao->move(who);
        dan = new("/d/obj/drug/hunyuandan");
 dan->set_amount(20);
        dan->move(who);
  message_vision(HIW"$N手中的水陆大会会旗一挥~~~~~~` 变出了20包药和20颗丹给"+who->query("name")+"！\n"NOR,this_player());
        return 1;               
        
        
        
}

int pk_mob(string str)
{
        object ob1,ob2;
        string st1,st2;

        if (!str || str=="") return notify_fail ("[cloak]: 你想让谁 PK 谁啊\n");
        if (sscanf( str,"%s with %s",st1,st2)!=2 )

           return notify_fail ("mobpk <ob1> with <ob2>\n");

        if (!ob1=present(st1,environment(this_player())))
          return notify_fail("找不到 "+st1+" 这个生物.\n");

        if (!ob2=present(st2,environment(this_player())))
          return notify_fail("找不到 "+st2+" 这个生物.\n");

        message_vision(BLINK+HIR"$N手中的水陆大会会旗一挥~~~~~~`, 让"+
                ob1->name()+"跟"+ob2->name()+"开始互相比试。\n"NOR,this_player());
        ob1->command("kill "+ob2->query("id"));
         ob2->command("kill "+ob1->query("id"));
        return 1;
}
int do_zhua(string arg)
{
        object me;
        object whoa,whob;
        object yaoa,dana;
        object yaob,danb;
        string a,b;
        int max;

         me = this_player();
         if(!environment(me)) return 0;
         if(!wizardp(me)) return notify_fail("You are not allowed to use this cmds!\n");
        if( !arg) return notify_fail("Please enter player's id!\n");    
        sscanf(arg,"%s %s",a,b);
         if(!whoa=find_player(a))
                return notify_fail("没这个人啊!\n");
         if(!whob=find_player(b))
                return notify_fail("没这个人啊!\n");
         whoa->move(environment(me));
         whob->move(environment(me));
         message_vision( "$N手中的水陆大会会旗一挥~~~~~~` \n"+whoa->query("name")+"和"+whob->query("name")+"被请了过来！\n",this_player());
        
                 max=whoa->query("max_sen");
                whoa->set("eff_sen", max);
                whoa->set("sen", max);
                max=whoa->query("max_gin");
                whoa->set("force", 2*me->query("max_force"));
                whoa->set("eff_gin", max);
                whoa->set("mana", 2*me->query("max_mana"));
                whoa->set("gin", max);
                max=whoa->query("max_kee");
                whoa->set("eff_kee", max);

                whoa->set("kee", max);
                max = whoa->max_food_capacity();
                whoa->set("food",max);
                max = whoa->max_water_capacity();
                whoa->set("water",max);
                whoa->clear_condition();
                me->command("get yao from "+whoa->query("id"));
                me->command("get yao from "+whoa->query("id"));
                me->command("get dan from "+whoa->query("id"));
                 me->command("get dan from "+whoa->query("id"));
                 
                       if(me->query_temp("no_move"))  me->delete_temp("no_move"); 
                     if(me->query_temp("no_cast"))  me->delete_temp("no_cast");
                      if(me->query_temp("fengmo"))   me->delete_temp("fengmo");   
                  if(me->query_temp("jinzhou"))   me->delete_temp("jinzhou");
                      if(me->query_temp("jinzhou"))   me->delete_temp("jinzhou");
                     if(me->query_temp("biqi"))   me->delete_temp("biqi");
                 max=whob->query("max_sen");
                whob->set("eff_sen", max);
                whob->set("sen", max);
                max=whob->query("max_gin");
                whob->set("force", 2*me->query("max_force"));
                whob->set("eff_gin", max);
                whob->set("mana", 2*me->query("max_mana"));
                whob->set("gin", max);
                max=whob->query("max_kee");
                whob->set("eff_kee", max);
                whob->set("kee", max);
                max = whob->max_food_capacity();
                whob->set("food",max);
                max = whob->max_water_capacity();

                whob->set("water",max);
                whob->clear_condition();
                me->command("get yao from "+whob->query("id"));
                me->command("get yao from "+whob->query("id"));
                me->command("get dan from "+whob->query("id"));
                 me->command("get dan from "+whob->query("id"));
        
        yaoa = new("/d/obj/drug/jinchuang");
        
        yaoa->set_amount(10);
        yaoa->move(whoa);
        dana = new("/d/obj/drug/hunyuandan");
        dana->set_amount(10);
        dana->move(whoa);
        
        yaob = new("/d/obj/drug/jinchuang");
        
        yaob->set_amount(10);
        yaob->move(whob);
        danb = new("/d/obj/drug/hunyuandan");
        danb->set_amount(10);
        danb->move(whob);
                 
         whoa->command("kill "+whob->query("id"));

         whob->command("kill "+whoa->query("id"));      
         
         whoa->start_busy(3);
          whob->start_busy(3);
          tell_object(whoa,"比武马上开始，准备出招！\n");
           tell_object(whob,"比武马上开始，准备出招！\n");
        message("channel:chat",HIW+"【水陆大会 】："+whoa->query("name")+"和"+whob->query("name")+"水陆大会生死相搏！\n"+NOR,users());
        
        return 1;       
        
}
int full(string str)
{
          int max;
          object me;
        
           if(!str)
            me=this_player();
          else

            me=present(lower_case(str), environment(this_player()));
        
        if (!me) return notify_fail ("[cloak]: full error: 找不到"+str+"\n");
        max=me->query("max_sen");
        me->set("eff_sen", max);
        me->set("sen", max);
        max=me->query("max_gin");
        me->set("force", 2*me->query("max_force"));
        me->set("eff_gin", max);
        me->set("mana", 2*me->query("max_mana"));
        me->set("gin", max);
        max=me->query("max_kee");
        me->set("eff_kee", max);
        me->set("kee", max);
        max = me->max_food_capacity();
        me->set("food",max);
        max = me->max_water_capacity();
        me->set("water",max);
        me->clear_condition();
                       if(me->query_temp("no_move"))  me->delete_temp("no_move"); 
                     if(me->query_temp("no_cast"))  me->delete_temp("no_cast");
                      if(me->query_temp("fengmo"))   me->delete_temp("fengmo");   
                  if(me->query_temp("jinzhou"))   me->delete_temp("jinzhou");
                      if(me->query_temp("jinzhou"))   me->delete_temp("jinzhou");
                     if(me->query_temp("biqi"))   me->delete_temp("biqi");
        message_vision( "$N手中的水陆大会会旗一挥~~~~~~` \n"+me->query("name")+"的所有状态都恢复了！\n",this_player());


  return 1;
}

