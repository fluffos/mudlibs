/* <SecCrypt CPL V3R05> */

// worker.c

inherit NPC;
#include <ansi.h>

string *msg = ({
  "新手多多help，如help news,help task，help renwu！\n",
  "新手请详细阅读help newstart!\n",
  "初到本站不熟悉的请help newstart\n",
  "目前仙侣情缘暂时没有论坛地址,QQ群:6005484欢迎访问！有赞助的朋友可以提供论坛那是最好~！！\n",
  "help news里面有关于MUD的最新变化！\n",
  "请用top指令来查询目前在线玩家的排行。\n",
  "请到仙石处用 ask seng about 新手礼物　来索取新手礼物。\n",
  "仙石往下和长安城外亭台水榭可以TTSX,能够恢复气血、精神等，请大家好好利用。\n",
  "大家记的随时备份自已的档案，备份指令是：backup\n",
});

void create() {
  set_name(HIW "仙侣情缘" NOR, ({ "XLQY" }));
  set("gender", "男性");
  set("age", 13);
  set("title", "仙侣情缘新闻发布使");
  set("long", "一个可爱的小童，每天负责在这里迎接远道而来的客人．\n");
  set("combat_exp", 200);
  set("attitude", "friendly");
  set_skill("dodge", 10);
  set("per", 30);
  set("max_kee", 1500000);
  set("kee", 1500000);
  set("sen", 1500000);
  set("max_sen", 1500000);
  setup();
  remove_call_out("msg");
  call_out("msg", 60);
}

void msg() {
  //command_function("chat "+NOR+HBRED+msg[random(sizeof(msg))]+NOR);
  message(
    "channel:chat",
    HIY + "【系统公告】仙侣情缘(XLQY)：" + NOR + HBRED + msg[random(sizeof(msg))] + NOR,
    users()
  );
  remove_call_out("msg");
  call_out("msg", 500);

}
