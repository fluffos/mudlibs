string getnum(string str) {
  int j, k, start, end;
  k = strlen(str);
  start = end = 0;
  for (j = 0; j < k; j++) {
    if (str[j] == '(')
      start = j + 1;
    if (str[j] == ')') {
      end = j;
      break;
    }
  }
  if (start > 0 && end > 0) {
    for (j = 0; j < k; j++)
      if (j < start || j == end)
        str[j] = 'c';
  }
  str = replace_string(str, "c", "");
  return str;
}


