//by theone

#include <ansi.h>
inherit ROOM;

int block_cmd(string args) {
  string verb;
  verb = query_verb();

  if (verb == "bian") return 1;
  if (verb == "xiudao") return 1;
  if (verb == "exert") return 1;
  if (verb == "drop") return 1;
  if (verb == "cut") return 1;
  if (verb == "ti") return 1;
  return 0;
}
void create() {
  set("short", HIW "亭台水榭" NOR);
  set("long", @LONG

这是新加入西行之旅的修行者们的乐园。他们在这里可以祈祷以得到
天神的恩赐，用以恢复精神和气血。神牌上有几个小字(words)。
LONG);

  set("item_desc", ([ "words": "新手们可以再次恢复
精神和气血。TTSX，就可以恢复！
", ]));

  set("exits",
    ([  //sizeof() == 1
    "up": "/d/changan/southseashore",
    ]));

  set("no_time", 1);
  set("no_fight", 1);
  set("no_wear", 1);
  set("no_magic", 1);
  set("freeze", 1);

  //        set("outdoors", "changan");
  set("no_clean_up", 0);
  setup();
}


void init() {
  add_action("do_TTSX", "TTSX");
}

int do_TTSX(string arg) {
  object me;
  int maxsen, maxkee;

  me = this_player();

  if (me->query("age") > 16) {
    message_vision(RED "$N这么大年纪了还来这里，羞也不羞！\n" NOR, me);
    return 1;
  } else if (me->query("max_force") > 1000 || me->query("combat_exp") > 150000) {
    message_vision(RED "$N这种程度了不用来这里了吧！\n" NOR, me);
    return 1;
  } else {
    maxsen = me->query("max_sen");
    maxkee = me->query("max_kee");
    me->set("sen", maxsen);
    me->set("kee", maxkee);
    message_vision(HIY "$N顿时感到神清气爽！\n" NOR, me);
    return 1;
  }
}
