//Cracked by Moou
// Moou's workroom
inherit ROOM;

void create()
{
    set("short", "岚心小筑");
	set("long", @LONG
这里是冬儿的小家，大书橱里整整齐齐地摆满了主人爱看的各种书籍
。一边的墙上挂着一只古箫，窗口有张桌子 (table)，窗台上则放着
一盆百合，清雅淡丽，幽香阵阵。
LONG);

	set("item_desc", ([
        "table"   : "桌上放着一只毛笔，一台墨砚，散落着几张白纸。\n",
		]));

	set("exits", ([
                "wiz"  : "/d/wiz/wizroom",
                "ting"   : "/d/ourhome/xiaoting",
                "punish" : "/d/wiz/punish",
                "news" : "/d/wiz/newsroom",
                "kezhan" : "/d/city/kezhan",
		]));

	set("valid_startroom", 1);

    setup();
}

int valid_leave(object me, string dir)
{
    if (!wizardp(me) && dir != "ting")
		return notify_fail("你往前一走，却发现有无形的力场锁着你，出不去！:(\n");
	return ::valid_leave(me, dir);
}

