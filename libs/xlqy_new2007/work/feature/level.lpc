varargs mapping query_skill_effect(string skill_type)       //得到某技能的所有等级的效果库
{

  return LEVEL_D->query_skill_effect(skill_type);

}
varargs mapping query_skill_menpai(string skill_type)       //得到某技能所有等级的门派库。
{

  return LEVEL_D->query_skill_menpai(skill_type);

}
string query_ob_skill_level(string skill_type)            //得到character skill_type技能的等级。
{
  return LEVEL_D->query_ob_skill_level(skill_type);

}
mixed query_skill_level_menpai(string skill_type, string level)     //得到拥有某技能某等级的门派，用于判断玩家是否能到达该技能等级
{
  return LEVEL_D->query_skill_level_menpai(skill_type, level);
}
mixed query_skill_level_effect(string skill_type, string skill_level)   //得到某技能的某等级的效果库
{
  return LEVEL_D->query_skill_level_effect(skill_type, skill_level);
}
