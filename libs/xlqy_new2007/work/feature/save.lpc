// by bugbug & alading @ 缥缈水云间, 2003-4-5
// save.c

int save() {
  string file;

  if (stringp(file = this_object()->query_save_file())) {
    assure_file(file + __SAVE_EXTENSION__);
    return save_object(file);
  }
  return 0;
}

int restore() {
  string file;

  if (stringp(file = this_object()->query_save_file())) {
    // A stale/corrupt shipped .o file (e.g. emoted's) can make
    // restore_object() throw instead of returning -- uncaught, that
    // escapes all the way through create() and aborts it partway,
    // masquerading as some other failure. catch() it and treat it the
    // same as "no save data" (see AGENTS.md 7.7; same fix already
    // applied in the bixiecanyang sibling of this codebase).
    if (catch(restore_object(file))) return 0;
    return 1;
  }
  return 0;
}
