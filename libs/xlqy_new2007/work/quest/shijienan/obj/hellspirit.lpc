#include <ansi.h>
inherit ITEM;

void create() {
  set_name(HIY "地府精神" NOR, ({ "hell spirit", "spirit" }));
  set_weight(500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "颗");
    set("long", "此乃阎罗地府的冥火所幻化成。\n");
    set("value", 800000);
    set("no_sell", 1);
    set("no_put", 1);
    set("drug_type", "补品");
  }
  setup();
}

void init() {
  add_action("do_xishi", "xishi");
  //   add_action("do_xuanze","xuanze");
}

int do_xishi(string arg) {
  object me = this_player();
  object ob = this_object();
  int exp, exp_reward, pot_reward;

  if (!arg) return notify_fail("你想吸食什么？\n");
  if ((arg == "longgong spirit" || arg == "spirit")) {
    if (ob->query("owner") != me->query("id"))
      return notify_fail("拿别人东西,这习惯不好!\n");
    exp = (me->query("combat_exp") + me->query("daoxing")) / 2;
    if (exp < 500000) {
      exp_reward = 300 + exp / 1000;
      pot_reward = 100 + exp / 3000;
    } else if (exp < 1200000) {
      exp_reward = 600 + exp / 2000;
      pot_reward = 300 + exp / 5000;
    } else if (exp < 7500000) {
      exp_reward = 1000 + exp / 6000;
      pot_reward = 800 + exp / 12000;
    } else {
      //	    exp_reward=5000;
      //	    pot_reward=1500;      // alading修改 01.11.18
      exp_reward = 2500;
      pot_reward = 1500;
    }
    pot_reward = pot_reward * (7) / 10;
    exp_reward = exp_reward * (7) / 10;
    if (me->query("gain_more_reward") + me->query_temp("apply/gain_more_reward")) {
      me->query_kar();
      exp_reward = exp_reward * (10000 + me->query("gain_more_reward") + me->query_temp("gain_more_reward")) / 10000;
      pot_reward = pot_reward * (10000 + me->query("gain_more_reward") + me->query_temp("gain_more_reward")) / 10000;


    }
    switch (random(3)) {
      case 0:
        me->add("daoxing", exp_reward);
        tell_object(
          me,
          "你得到了 " + HIR "" + COMBAT_D->chinese_daoxing(exp_reward) + "" NOR + " 道行！\n"
        );
        break;
      case 1:
        me->add("combat_exp", exp_reward);
        tell_object(me, "你得到了 " + HIR "" + chinese_number(exp_reward) + "" NOR + " 点武学经验！\n");
        break;
      case 2:
        me->add("potential", pot_reward);
        tell_object(me, "你得到了 " + HIW "" + chinese_number(pot_reward) + "" NOR + " 点潜能！\n");
    }
    destruct(this_object());
    return 1;
  } else
    return notify_fail("你要吸食什么？\n");
}
