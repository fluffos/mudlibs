#include <ansi.h>
inherit ITEM;

void create() {
  set_name(BLINK HIR "火云洞精神" NOR, ({ "hyd spirit", "spirit" }));
  set_weight(1);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "颗");
    set("long", "此乃火云洞的熔岩所幻化成。\n");
    set("value", 800000);
    set("no_sell", 1);
    set("no_put", 1);
    set("drug_type", "补品");
  }
  setup();
}

void init() {

  add_action("do_syhy", "syhy");
  add_action("do_xishi", "xishi");
  //   add_action("do_xuanze","xuanze");
}

int do_xishi(string arg) {
  object me = this_player();
  object ob = this_object();
  int exp, exp_reward, pot_reward;

  if (!arg) return notify_fail("你想吸食什么？\n");
  if ((arg == "longgong spirit" || arg == "spirit")) {
    if (ob->query("owner") != me->query("id"))
      return notify_fail("拿别人东西,这习惯不好!\n");
    exp = (me->query("combat_exp") + me->query("daoxing")) / 2;
    if (exp < 500000) {
      exp_reward = 300 + exp / 1000;
      pot_reward = 100 + exp / 3000;
    } else if (exp < 1200000) {
      exp_reward = 600 + exp / 2000;
      pot_reward = 300 + exp / 5000;
    } else if (exp < 7500000) {
      exp_reward = 1000 + exp / 6000;
      pot_reward = 800 + exp / 12000;
    } else {
      //	    exp_reward=5000;
      //	    pot_reward=1500;      // alading修改 01.11.18
      exp_reward = 2500;
      pot_reward = 1500;
    }
    pot_reward = pot_reward * (12) / 10;
    exp_reward = exp_reward * (12) / 10;
    if (me->query("gain_more_reward") + me->query_temp("apply/gain_more_reward")) {
      me->query_kar();
      exp_reward = exp_reward * (10000 + me->query("gain_more_reward") + me->query_temp("gain_more_reward")) / 10000;
      pot_reward = pot_reward * (10000 + me->query("gain_more_reward") + me->query_temp("gain_more_reward")) / 10000;


    }
    me->add("daoxing", exp_reward);
    tell_object(me, "你得到了 " + HIR "" + COMBAT_D->chinese_daoxing(exp_reward) + "" NOR + " 道行！\n");
    me->add("combat_exp", exp_reward);
    tell_object(me, "你得到了 " + HIR "" + chinese_number(exp_reward) + "" NOR + " 点武学经验！\n");
    me->add("potential", pot_reward);
    tell_object(me, "你得到了 " + HIW "" + chinese_number(pot_reward) + "" NOR + " 点潜能！\n");
    destruct(this_object());

    return 1;
  } else
    return notify_fail("你要吸食什么？\n");
}

int do_syhy() {
  object me, ob, obj, obj1, obj2, obj3, obj4, obj5, obj6, obj7, obj8, qi;
  me = this_player();
  ob = this_object();

  obj = present("fangcun spirit", me);
  obj1 = present("longgong spirit", me);
  obj2 = present("hell spirit", me);
  obj3 = present("jjf spirit", me);
  obj4 = present("moon spirit", me);
  obj5 = present("putuo spirit", me);
  obj6 = present("wdd spirit", me);
  obj7 = present("wzg spirit", me);
  obj8 = present("xs spirit", me);

  if (!objectp(obj))
    return notify_fail("你手中没有方寸精神，先找到再说吧。\n");
  if (!objectp(obj1))
    return notify_fail("你手中没有龙宫精神，先找到再说吧。\n");
  if (!objectp(obj2))
    return notify_fail("你手中没有地府精神，先找到再说吧。\n");
  if (!objectp(obj3))
    return notify_fail("你手中没有将军府精神，先找到再说吧。\n");
  if (!objectp(obj4))
    return notify_fail("你手中没有月宫精神，先找到再说吧。\n");
  if (!objectp(obj5))
    return notify_fail("你手中没有普陀精神，先找到再说吧。\n");
  if (!objectp(obj6))
    return notify_fail("你手中没有无底洞精神，先找到再说吧。\n");
  if (!objectp(obj7))
    return notify_fail("你手中没有五庄观精神，先找到再说吧。\n");
  if (!objectp(obj8))
    return notify_fail("你手中没有雪山精神，先找到再说吧。\n");
  //Just a verdict,modi by Repoo at 31/08/2001
  if (me->query("id") != ob->query("owner"))
    return notify_fail("火云洞精神不是你自己寻来的吧？\n");

  if (me->query("id") != obj->query("owner"))
    return notify_fail("方寸精神不是你自己寻来的吧？\n");
  if (me->query("id") != obj1->query("owner"))
    return notify_fail("龙宫精神不是你自己寻来的吧？\n");
  if (me->query("id") != obj2->query("owner"))
    return notify_fail("地府精神不是你自己寻来的吧？\n");
  if (me->query("id") != obj3->query("owner"))
    return notify_fail("将军府精神不是你自己寻来的吧？\n");
  if (me->query("id") != obj4->query("owner"))
    return notify_fail("月宫精神不是你自己寻来的吧？\n");
  if (me->query("id") != obj5->query("owner"))
    return notify_fail("普陀精神不是你自己寻来的吧？\n");
  if (me->query("id") != obj6->query("owner"))
    return notify_fail("无底洞精神不是你自己寻来的吧？\n");
  if (me->query("id") != obj7->query("owner"))
    return notify_fail("五庄观精神不是你自己寻来的吧？\n");
  if (me->query("id") != obj8->query("owner"))
    return notify_fail("雪山精神不是你自己寻来的吧？\n");

  message_vision(HIR "\n$N手中的十种精神力量在一阵霞光中合为一体，化做浩然天地正气！。\n" NOR, me);
  obj->move("/cmds/std/quitroom");
  destruct(obj);
  obj1->move("/cmds/std/quitroom");
  destruct(obj1);
  obj2->move("/cmds/std/quitroom");
  destruct(obj2);
  obj3->move("/cmds/std/quitroom");
  destruct(obj3);
  obj4->move("/cmds/std/quitroom");
  destruct(obj4);
  obj5->move("/cmds/std/quitroom");
  destruct(obj5);
  obj6->move("/cmds/std/quitroom");
  destruct(obj6);
  obj7->move("/cmds/std/quitroom");
  destruct(obj7);
  obj8->move("/cmds/std/quitroom");
  destruct(obj8);

  qi = new("/obj/zhengqi");
  qi->set("owner", me->query("id"));
  qi->move(me);
  ob->move("/cmds/std/quitroom");
  destruct(ob);

  return 1;
}
