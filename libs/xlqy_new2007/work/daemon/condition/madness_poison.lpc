#include <ansi.h>

int update_condition(object me, int duration)
{
	int damage,mu,effect;
if(time() < me->query("dajiu_busy")&&!living(me)) //dajiu
{
me->apply_condition("madness_poison", duration);
return 1;
}
	damage = me->query("wuxing_poison/madness_poison");
	if(damage < 50)
		damage = 50;
	mu = me->receive_damage("sen", damage/5);
	me->receive_wound("sen", mu);
	mu = me->receive_damage("kee", damage/5);
	me->receive_wound("kee",mu);
	effect = 1+random(7);
	me->add_temp("apply/attack",-effect);
	me->add_temp("apply/defense",-effect);
	me->add_temp("wuxing_poison/madness_point",effect);
	mu = random(3);
	me->add_temp("apply/strength",mu);
	me->add_temp("wuxing_poison/madness_str",mu);
	me->set_temp("death_msg",HIG"中五行毒之疯狂而毙。\n"NOR);
	me->apply_condition("madness_poison", duration-1);
	if (duration >0 )
	tell_object(me, HIG "你所受五行毒之疯狂发作了！\n" NOR );
	if( duration < 1 )
	{
		me->delete_temp("wuxing_poison/madness_point");
		me->delete_temp("wuxing_poison/madness_str");
		me->delete("wuxing_poison/madness_poison");
		 return 0;
	}
	return 1;
}

