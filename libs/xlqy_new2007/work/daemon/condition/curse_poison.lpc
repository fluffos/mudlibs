#include <ansi.h>

int update_condition(object me, int duration)
{
	int damage,mu;
	damage = me->query("wuxing_poison/curse_poison");
	
if(time() < me->query("dajiu_busy")&&!living(me)) //dajiu
{
me->apply_condition("curse_poison", duration);
return 1;
}
	mu = me->receive_damage("sen", damage/5);
	me->receive_wound("sen", mu);
	mu = me->receive_damage("kee", damage/5);
	me->receive_wound("kee",mu);
	
	me->add_temp("combat/bless",-1);
	me->add_temp("wuxing_poison/sub_bless",1);
	me->set_temp("death_msg",HIG"中五行毒之诅咒而毙。\n"NOR);
	me->apply_condition("curse_poison", duration-1);
	if (duration >0 )
	tell_object(me, HIG "你所受五行毒之诅咒发作了！\n" NOR );
	
	if( duration < 1 )
	{
		me->delete("wuxing_poison/curse_poison");
		me->delete_temp("wuxing_poison/sub_bless");
		 return 0;
}
	return 1;
}

