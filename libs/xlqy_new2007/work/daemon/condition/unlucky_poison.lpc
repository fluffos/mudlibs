#include <ansi.h>

int update_condition(object me, int duration)
{
	int damage,mu,effect;
if(time() < me->query("dajiu_busy")&&!living(me)) //dajiu
{
me->apply_condition("unlucky_poison", duration);
return 1;
}
	damage = me->query("wuxing_poison/unlucky_poison");
	if(damage < 50)
		damage = 50;
	mu = me->receive_damage("sen", damage/5);
	me->receive_wound("sen", mu);
	mu = me->receive_damage("kee", damage/5);
	me->receive_wound("kee",mu);
	effect = random(2);
	me->add_temp("combat/lucky",-effect);
	me->add_temp("wuxing_poison/sub_lucky",effect);
	me->set_temp("death_msg",HIG"中五行毒之厄运而毙。\n"NOR);
	me->apply_condition("unlucky_poison", duration-1);
	if (duration >0 )
	tell_object(me, HIG "你所受五行毒之厄运发作了！\n" NOR );
	if( duration < 1 )
	{
		me->delete_temp("wuxing_poison/sub_lucky");
		me->delete("wuxing_poison/unlucky_poison");
		 return 0;
	}
	return 1;
}

