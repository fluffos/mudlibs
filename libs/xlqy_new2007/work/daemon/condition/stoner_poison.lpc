#include <ansi.h>

int update_condition(object me, int duration) {
  int damage, mu, effect;
  if (time() < me->query("dajiu_busy") && !living(me))  //dajiu
  {
    me->apply_condition("stoner_poison", duration);
    return 1;
  }
  damage = me->query("wuxing_poison/stoner_poison");
  if (damage < 50)
    damage = 50;
  mu = me->receive_damage("sen", damage / 5);
  me->receive_wound("sen", mu);
  mu = me->receive_damage("kee", damage / 5);
  me->receive_wound("kee", mu);
  effect = 1 + random(5);
  me->add_temp("apply/dodge", -effect);
  me->add_temp("apply/parry", -effect);
  me->add_temp("wuxing_poison/stoner_point", effect);
  me->set_temp("death_msg", HIG "中五行毒之石化而毙。\n" NOR);
  me->apply_condition("stoner_poison", duration - 1);
  if (duration > 0)
    tell_object(me, HIG "你所受五行毒之石化发作了，你觉得自己的手脚象灌了铅一样沉重！\n" NOR);
  if (duration < 1) {
    me->delete_temp("wuxing_poison/stoner_point");
    me->delete("wuxing_poison/stoner_poison");
    return 0;
  }
  return 1;
}
