// energy.c 聚魄还虚
// Created by Vin 26/8/2001

#include <ansi.h>

inherit F_CLEAN_UP;

string name() { return HIC "聚魄还虚" NOR; }

int perform(object me, string skill) {
  int count;
  if (me->query("age") < 18)
    return notify_fail("你还未成年，不能使用特殊技能 ^_^\n");
  if (me->query("kee") < 80)
    return notify_fail("你的体力不支，无法激发自己的潜力。\n");
  if (me->query_temp("special_skill/energy", 1))
    return notify_fail("你已经尽力激发自己的精神力了。\n");
  if (me->query_temp("init_max_sen"))
    count = me->query_temp("init_max_sen") / 2;
  else {

    me->set_temp("init_max_sen", me->query("max_sen"));
    count = me->query_temp("init_max_sen") / 2;

  }
  me->set("max_sen", me->query("max_sen") + count);
  me->set("eff_sen", me->query("eff_sen") + count);
  me->set("sen", me->query("sen") + count);

  message_vision(HIC "$N" HIC "凝神聚气，感应到天空传给自己的力量。\n" NOR, me);
  me->receive_damage("kee", 40 + random(40));
  me->set_temp("special_skill/energy", 1);

  me->start_call_out((: call_other, __FILE__, "remove_effect", me,
    count :), 360 + random(30));

  return 1;
}

void remove_effect(object me, int count) {
  me->delete_temp("special_skill/energy", 1);
  me->set("max_sen", me->query("max_sen") - count);
  if (me->query("eff_sen") > count)
    me->set("eff_sen", me->query("eff_sen") - count);
  else
    me->set("eff_sen", 10);
  if (me->query("sen") > count)
    me->set("sen", me->query("sen") - count);
  else
    me->set("sen", 10);

  tell_object(me, "天空赐予你的力量已经失去，你全身松懈下来，。\n");
}
