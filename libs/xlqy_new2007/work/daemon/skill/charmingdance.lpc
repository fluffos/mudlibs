// charmingdance.c【妖华红莲舞】
//该特殊dodge有perform

inherit SKILL;
#include <ansi.h>

string *dodge_msg = ({
     "$n一招"+HIB"「妖华神冥舞」"NOR+"，$N突觉神志恍惚，瞬间清明过来时，$n已不见了。\n",
     "$n一招"+RED"「红莲劫焰蹈」"NOR+"，身体周围霎时出现一朵巨大的燃烧的红色莲花，
$n便融入了这跳跃的火光中，不复可寻踪迹。\n",
     "$n围着$N的身子转动，却不让$N沾着一分，正是一招"+HIR"「婆娑篝火间」"NOR+"。\n",
     "$n身形轻轻飘起，在空中如穿花蝴蝶般自由飞舞，正是一招"+HIC"「蹁跹九重天」"NOR+"。\n",
     "$n舞蹈间却倏忽飘飞至$N身前，$N一惊之下招式就放缓了许多，\n这招名曰"+HIM"「且舞且流连」"NOR+"。\n"
     });

int valid_enable(string usage) { return (usage=="dodge"); }

int valid_learn(object me)
{
/*
	if( (string)me->query("gender") != "女性" )
		return notify_fail("妖华红莲舞只有女性才能练。\n");
*/
      return 1;
}

string query_dodge_msg(string limb)
{
	return dodge_msg[random(sizeof(dodge_msg))];
}

int practice_skill(object me)
{
	if( (int)me->query("sen") < 30 )
		return notify_fail("你的精神太差了，不能练妖华红莲舞。\n");
	me->receive_damage("sen", 30);
	return 1;
}

string perform_action_file(string func)
{
	return ("/daemon/class/dodge/charmingdance/") + func;
}

