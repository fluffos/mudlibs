int valid_enable(string usage)

{

  return (usage == "literate") || (usage == "music");

}

int practice_skill(object me)

{
  int skill1, skill2;
  object weapon;
  if (!objectp(weapon = me->query_temp("weapon")) ||
    (string)(weapon->query("skill_type")) != "music" || (string)(weapon->query("music_type")) != "xiao")
    return notify_fail("手中无箫，如何吹奏？^_^\n");
  skill1 = (int)me->query_skill("zouxiao", 1);
  skill2 = (int)me->query_skill("music", 1);

  if ((int)me->query("kee") < 50)
    return notify_fail("你的体力太差了，不能练吹箫之技。\n");
  if ((int)me->query("sen") < 50)
    return notify_fail("你的心神不足，不能练吹箫之技。\n");
  if ((int)me->query("force") < 100)
    return notify_fail("你的内力不足，不能练吹箫之技。\n");

  if (skill1 > 300 && skill1 > skill2)
    return notify_fail("你的技艺已达超群脱俗，没有很好的音律乐理做根底，靠练是很难领悟到吹奏的技巧了！\n");

  me->receive_damage("sen", 40);
  me->add("force", -3);
  write("你俯首弄萧，吹奏了一曲『凤求凰』 。\n");

  return 1;

}
mapping query_action(object me, object weapon) {
  weapon = me->query_temp("weapon");
  if ((string)(weapon->query("music_type")) != "xiao")
    return actions[0];
  return action[random(sizeof(action))];

}

string perform_action_file(string func) {
  return CLASS_D("zhenyuan") + "/zouxiao/" + func;
}

mixed hit_ob(object me, object victim, int damage_bonus) {
  int howlong;
  object weapon;
  weapon = me->query_temp("weapon");

  if ((!weapon) || (string)(weapon->query("music_type")) != "xiao")
    return 0;

  if ((string)me->query("family/family_name") != "五庄观")
    return 0;
  if (victim->query_temp("no_move"))
    return 0;
  if ((int)me->query_skill("music", 1) > 300 && random(3))        //人间绝响。。。
  {
    message_vision(HIG "$N听得如此美妙仙乐、空灵之音，心中又是惊讶又是欢喜，呆呆的望着$n，竟然忘了自己在战斗之中！\n" NOR, victim, me);
    victim->set_temp("no_move", 1);
    howlong = 1 + (int)me->query_skill("music") / 50;
    if (me->query("skill_level/music") == "expert")
      howlong = 1 + howlong + howlong * 20 / 100;
    else if (me->query("skill_level/music") == "master")
      howlong = 2 + howlong + howlong * 50 / 100;
    else if (me->query("skill_level/music") == "grandmaster")
      howlong = 3 + howlong * 2;
    if (howlong > 20) howlong = 20;
    howlong = howlong / 2 + random(howlong);
    call_out("free", howlong, victim);
    return 0;

  }

  else if (random(((int)me->query_skill(
    "music",
    1
  ) / 2)) > random((int)victim->query_skill("force", 1))) {
    message_vision(HIG "$N听得如此美妙仙乐、空灵之音，心中又是惊讶又是欢喜，呆呆的望着$n，竟然忘了自己在战斗之中！\n" NOR, victim, me);
    victim->set_temp("no_move", 1);
    howlong = 1 + (int)me->query_skill("music") / 50;
    if (me->query("skill_level/music") == "expert")
      howlong = 1 + howlong + howlong * 20 / 100;
    else if (me->query("skill_level/music") == "master")
      howlong = 2 + howlong + howlong * 50 / 100;
    else if (me->query("skill_level/music") == "grandmaster")
      howlong = 3 + howlong * 2;
    if (howlong > 20) howlong = 20;
    howlong = howlong / 2 + random(howlong);
    call_out("free", howlong, victim);
    return 0;
  }
  return 0;
}

void free(object target) {
  if (target)
    target->delete_temp("no_move");
  return;
}
