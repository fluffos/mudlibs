inherit SKILL;
#include <ansi.h>


string *dodge_msg = ({
  MAG "「幻，飘渺水云间」" NOR + "，$n身影翩翩飞舞，将招数一一躲闪开。\n",
  MAG "「灭，叁千情丝断」" NOR + "，$n突然消失，继而闪电般地出现在$N的身后。\n",
  MAG "「虚，浮生轻若梦」" NOR + "，$n的身子似全无重量，晃晃悠悠，飘散开去。\n",
  MAG "「空，今日如飞烟」" NOR + "，$n身子轻轻飘起，从$N头顶飞过。\n",
  MAG "「渡，来世杳无痕」" NOR + "，$n微一叹气，如烟似雾般消散，不复可寻影踪。\n",
});

int valid_enable(string usage) {
  return (usage == "dodge");
}

int valid_learn(object me) {
  if ((int)me->query("max_force") < 20)
    return notify_fail("你的内力不够，没有办法练习幻灭虚空渡。\n");

  return 1;
}

string query_dodge_msg(string limb) {
  return dodge_msg[random(sizeof(dodge_msg))];
}

int practice_skill(object me) {
  if ((int)me->query("kee") < 30
    || (int)me->query("force") < 3)
    return notify_fail("你的气或内力不够，不能练幻灭虚空渡。\n");
  me->receive_damage("kee", 30);
  me->add("force", -3);
  return 1;
}

string perform_action_file(string func) {
  return ("/daemon/class/dodge/xukong-steps/") + func;
}
