// strategy.c 兵法
#include <ansi.h>
inherit SKILL;

int valid_enable(string usage) { return usage=="leadership"; }

int valid_learn(object me)
{
	if(me->query("combat_exp")<100000)
	return notify_fail("你的实战经验不足，难以掌握兵法诀窍。\n");
        if( (int)me->query_skill("leadership", 1) < 30
||      (int)me->query_skill("leadership",1) <= (int)me->query_skill("strategy",1) )
                return notify_fail("你的用人之技不够高明，体会不到排兵布阵的精要。\n");
        return 1;
}

string level_description(int level)
{
	int grade;
	string *level_desc = ({
		BLU "一窍不通" NOR,
		BLU "一知半解" NOR,
		HIY "略有所悟" NOR,
		HIY "纸上谈兵" NOR,
		HIR "纵横沙场" NOR,
		HIR "攻城略地" NOR,
		MAG "百战不殆" NOR,
		MAG "运筹帷幄" NOR,
		CYN "决胜千里" NOR,
		HIC "战无不胜" NOR,
		HIW "不战而胜" NOR,
	});

	grade = level / 30;

	if( grade >= sizeof(level_desc) )
		grade = sizeof(level_desc)-1;
	return level_desc[grade];
}


string type() { return "knowledge"; }

