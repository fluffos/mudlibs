int valid_enable(string usage)
{
        return usage=="sword" || usage=="parry";
}

mapping query_action(object me, object weapon)
{
   mapping* m_actions;
   m_actions=me->query("skill_tianlei-sword");
   if(me->query("skill_tianlei-sword")==0 )
    return action[random(sizeof(action))];
     if( random(4) == 1 )
      return m_actions[random(sizeof(m_actions))];
      else
        return action[random(sizeof(action))];
}

int valid_learn(object me)
{
        object ob;

/*		if( (string)me->query("gender") !="男性")
                return notify_fail("天雷猛袭剑是刚猛的剑法，只适合男子使用!!\n");
*/    
        if( (int)me->query("max_force") < 300 )
                return notify_fail("你的内力不够，没有办法学习天雷猛袭剑。\n");

/*        if( (string)me->query_skill_mapped("force")!= "starforce")
                return notify_fail("天雷猛袭剑必须配合辰星灵云壁才能学习。\n");
*/    
        if( !(ob = me->query_temp("weapon"))
        ||      (string)ob->query("skill_type") != "sword" )
                return notify_fail("你必须先找一把剑才能练剑法。\n");

        return 1;
}

int practice_skill(object me)
{
        if( (int)me->query("kee") < 30
        ||      (int)me->query("force") < 3 )
                return notify_fail("你的内力或气不够，没有办法练习天雷猛袭剑。\n");
        me->receive_damage("kee", 30);
        me->add("force", -3);
        write("你按著师父所授诀窍练了一遍天雷猛袭剑。\n");
        return 1;
}

string perform_action_file(string func)
{
return CLASS_D("hsl/hsl_might") + "/tianlei-sword/" + func;
}


void skill_improved(object me)
{
   int m_skill=me->query_skill("tianlei-sword",1);

   if(m_skill>200&&m_skill%10==0){
     tell_object(me,HIW"你对天雷猛袭剑的领悟加深了，你的天雷猛袭剑进入了一个新的境界！\n"NOR);
     if(random(me->query("kar"))<20){
        tell_object(me,HIW"然而你的心中居然产生了一种失落感！\n"NOR);
        return;
     }
     if(random(me->query("int"))<20){
       tell_object(me,HIW"然而你的心中升起一种惆怅的感觉，仿佛有一丝重要的东西没有抓住。\n"NOR);
       return;
     }
     tell_object(me,HIW"你突然福至心灵，对天雷猛袭剑领悟出了一招新的用法！\n"NOR);
     tell_object(me,"请为这招取一个名字：");
     input_to( (: call_other, __FILE__, "name_skill", me:));
   }
   return;
}

void name_skill(object me, string arg)
{
   mapping* m_actions;
   mapping m_act=([]);
   int content;
   string msg;

   m_actions=me->query("skill_tianlei-sword");
   if(!pointerp(m_actions))m_actions=({});

   content=me->query("str")+2*me->query_skill("unarmed",1)/10;
   m_act+=(["damage":content]);
   content=-me->query("spi");
   m_act+=(["dodge" :content]);
   content=-me->query("cps");
   m_act+=(["parry" :content]);
   content=me->query("con")+me->query_skill("force",1)/10;
   m_act+=(["force" :content]);
   m_act+=(["damage_type":"刺伤"]);

   if(!arg||arg==" ")arg="天雷猛袭剑必杀技"+chinese_number(sizeof(m_actions)+1);
   m_act+=(["name":arg]);
   msg= skill_head[random(sizeof(skill_head))]+BLINK+HIM"「"+arg+"」"NOR
                  +skill_tail[random(sizeof(skill_tail))];
   m_act+=(["action":msg]);
   m_actions+=({m_act});
   me->set("skill_tianlei-sword",m_actions);
}

	

