// darksword 【暗黑蚀魂剑】

inherit SKILL;
#include <ansi.h>


mapping *action = ({
  ([ "name": "眉来眼去剑",
    "action":
    HIW "眉——来——眼——去——剑————————>>>>>>>>>>>>>>>>>>" NOR + HIM "

                        ---
                       ////  \\
                       ||||￠┼      ※※▲№★▲→
                       ||||- │      /
                       ||||．/
                       |||  ╯
                       ||| |     ﹟
                     ╭-╯ ╰-╮￠
               ╭──|╲︵|︵| //──────────╮
               /     | |⿺⿺⿺/                       \\
              /      | |⿺⿺ /                         \\
          ▕ ╯      \\ ╰─╱⿺╲                      ╰─╮
          ▕        ╱⿺⿺⿺⿺⿺ \\                         │
          ▕       │⿺⿺⿺⿺⿺⿺│                        │
          ▕        \\⿺⿺⿺⿺⿺⿺/ \n" NOR,
    "dodge": -100,
    "parry": -100,
    "damage": 10,
    "force": 10,
    "damage_type": "刺伤",
    "parry_msg": "$N冷冷一笑，轻松躲开了这一剑。"
  ]),
});


int valid_enable(string usage) {
  return (usage == "sword") || (usage == "parry");
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

int valid_learn(object me) {
  object ob;

  if ((int)me->query("max_force") < 50)
    return notify_fail("你的内力不够，没有办法学习郎情妾意剑。\n");

  // if( (string)me->query_skill_mapped("force")!= "wanxi-force")
  //    return notify_fail("暗黑蚀魂剑必须配合万息集气术才能学习。\n");

  // if( (string)me->query_skill_mapped("spells")!= "wanxi-spells")
  //   return notify_fail("暗黑蚀魂剑必须配合万息降临法才能学习。\n");

  if (!(ob = me->query_temp("weapon"))
    || (string)ob->query("skill_type") != "sword")
    return notify_fail("你必须先找一把剑才能学习剑法。\n");

  return 1;
}
string perform_action_file(string func) {
  return "/daemon/class/pfm/eyesword/" + func;
}
int practice_skill(object me) {
  if ((int)me->query("kee") < 30
    || (int)me->query("force") < 3)
    return notify_fail("你的内力或气不够，没有办法练习郎情妾意剑。\n");
  me->receive_damage("kee", 30);
  me->add("force", -3);
  write("你按著师父所授诀窍练了一遍郎情妾意剑。\n");
  return 1;
}
