#include <ansi.h>
inherit SKILL;

mapping *action = ({
  ([ "action":
    "只见$N全身提气，一声轻喝！" + BLINK "" + HIB "左手拳，右手掌呼！" NOR "地一声劈向$n的$l",
    "dodge": 5,
    "parry": 5,
    "force": 20,
    "damage": 50,
    "damage_type": "劈伤"
  ]),
  ([ "action":
    "$N双腿连连踢出，高喊一声，" + BLINK "" + HIC "半空中一个转折，双腿踢向" NOR "$n$l。",
    "dodge": 5,
    "parry": 5,
    "force": 30,
    "damage": 60,
    "damage_type": "踢伤"
  ]),
  ([ "action":
    "$N身形在$n眼前一慌，" + BLINK "" + HIY "双腿下而上" NOR "往$n的$l不停的踢打。",
    "dodge": 5,
    "parry": 5,
    "force": 40,
    "damage": 80,
    "damage_type": "踢伤"
  ]),
  ([ "action":
    "$N双足立地，" + BLINK "" + HIW "右拳用力的" NOR "摆向$n,想使对方受到重创。",
    "dodge": 5,
    "parry": 5,
    "force": 50,
    "damage": 90,
    "damage_type": "抓伤"
  ]),
  ([ "action":
    "只见$N连退几步，" + BLINK "" + HIG "突然飞身向前，以退为进,肘部无情" NOR "地撞向$n$l",
    "dodge": 5,
    "parry": 5,
    "force": 60,
    "damage": 100,
    "damage_type": "撞伤"
  ]),
  ([ "action":
    "$N大喝一声，双手红光泛起，" + BLINK "" + HIM "前后一抄，似乎" NOR "要把$n撕得粉身碎骨。",
    "dodge": 5,
    "parry": 5,
    "force": 80,
    "damage": 120,
    "damage_type": "砸伤"
  ]),
  ([ "action":
    "$N往前一个轻纵，" + BLINK "" + HIR "几乎与$n贴面而立，双手" NOR "往$n的$l恶狠狠地一抓",
    "dodge": 5,
    "parry": 5,
    "force": 100,
    "damage": 240,
    "damage_type": "抓伤"
  ]),
  ([ "action":
    "$N狂喊一声，" + BLINK "" + WHT "草稚流 古武术 之 最后奥义 鬼烧" NOR "一道鬼火烧$n的$l",
    "dodge": 5,
    "parry": 5,
    "force": 120,
    "damage": 360,
    "damage_type": "烧伤"
  ]),
});

int valid_learn(object me) {
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon")
  )
    return notify_fail("练[草稚流.古武术]必须放下兵器。\n");
  return 1;
}

int valid_enable(string usage) {
  return usage == "unarmed";
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

int practice_skill(object me) {
  if ((int)me->query("sen") < 30)
    return notify_fail("你的精神无法集中了，休息一下再练吧。\n");
  if ((int)me->query("kee") < 30)
    return notify_fail("你现在手足酸软，休息一下再练吧。\n");
  if ((int)me->query("force") < 10)
    return notify_fail("你的内力不够了。\n");

  me->receive_damage("kee", 30);
  me->add("force", -10);

  return 1;
}
string perform_action_file(string func) {
  return CLASS_D("kof") + "/caozhi-boji/" + func;
}
