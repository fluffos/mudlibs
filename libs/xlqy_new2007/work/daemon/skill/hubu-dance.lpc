inherit SKILL;

string *dodge_msg = ({
  "$n一个「羽步」，身影微动，避了开去。\n",
  "$n左脚一退，右脚回并左脚，一式「激转」，避了开去。\n",
  "只见$n身影一晃，一式「左转」，身子轻轻的从$N左侧滑过。\n",
  "$n身影晃动，左右左脚步速移，已经藉一式「三直步」轻轻闪过。\n",
  "只看$n一招「右转」，趁$N一发呆，身子轻轻从$N右侧闪了开去。\n",
  "$n一式「左转波纹步」，身子晃的$N眼晕，已然闪了开去。\n",
});

mapping *action = ({
  ([
    "name": "「羽步」",
    "action": "$N双手虚晃，左脚猛地飞起，一式「羽步」，脚尖晃动，踢向$n的$l",
    "force": 50,
    "dodge": -10,
    "parry": -10,
    "damage_type": "瘀伤",
  ]),
  ([
    "name": "「右转步」",
    "action": "$N左脚顿地，别转身来抽身欲走，只一刹那间一回身，右脚一式「右转步」，猛踹$n的$l",
    "force": 60,
    "dodge": 10,
    "parry": -10,
    "damage_type": "内伤",
  ]),
  ([
    "name": "「左转步」",
    "action": "$N右脚顿地，别转身来抽身欲走，只一刹那间一回身，左脚一式「左转步」，猛踹$n的$l",
    "force": 60,
    "dodge": 10,
    "parry": -10,
    "damage_type": "内伤",
  ]),
  ([
    "name": "「三直步」",
    "action": "$N突然跃起，双足连环圈转，一式「三直步」，足带风尘，攻向$n的全身",
    "force": 100,
    "dodge": 10,
    "parry": 10,
    "damage_type": "瘀伤",
  ]),
  ([
    "name": "「激转」",
    "action": "$N突然侧身，却步后退，一个前空翻，右脚自上而下一式「激转步」，照$n的面门直劈下来",
    "force": 70,
    "dodge": -10,
    "parry": 10,
    "damage_type": "瘀伤",
  ]),
  ([
    "name": "「左转波纹步」",
    "action": "$N使一式「左转波纹步」，全身突然飞速旋转，双足忽前忽后，迅猛无及踹向$n的胸口",
    "force": 80,
    "dodge": -10,
    "parry": 10,
    "damage_type": "瘀伤",
  ]),

});
mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

int valid_enable(string usage) {
  return (usage == "unarmed" || usage == "dodge");
}

int valid_learn(object me) {
  if ((int)me->query("max_force") < 20)
    return notify_fail("你的内力不够，没有办法练狐步舞。\n");
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练狐步舞必须空手。\n");
  return 1;

}

string query_dodge_msg(string limb) {
  return dodge_msg[random(sizeof(dodge_msg))];
}

int practice_skill(object me) {
  if ((int)me->query("sen") < 40)
    return notify_fail("你的精神无法集中了，休息一下再练吧。\n");
  if ((int)me->query("kee") < 40)
    return notify_fail("你现在手足酸软，休息一下再练吧。\n");
  if ((int)me->query("force") < 10)
    return notify_fail("你的内力不够了。\n");

  me->receive_damage("kee", 30);
  me->add("force", -10);

  return 1;
}
