//【幻灭虚空渡】之【虚空无转】


#include <ansi.h>

inherit SSERVER;

int perform(object me, object target) {
  int ap1, dp1, ap2, dp2;
  int howlong;
  object room, room1;

  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("「虚空无转」只有在战斗中才能使用。\n");
  if (me->query("family/family_name") != "幻世勇者")
    return notify_fail("非幻世勇者不能用「虚空无转」！\n");
  if (me->query_skill("xukong-steps", 1) < 60)
    return notify_fail("你的幻灭虚空渡等级太低了，不能使用「虚空无转」！\n");

  if (me->query("force") < 200)
    return notify_fail("你的内力不够了！\n");

  ap1 = (int)me->query_skill("xukong-steps", 1);
  ap2 = me->query("combat_exp") / 100;
  dp1 = (int)target->query_skill(target->query_skill_mapped("dodge"), 1);
  dp2 = target->query("combat_exp") / 100;

  message_vision(HIC "\n$N突然步法一变，使出幻灭虚空渡的绝招：\n\n" NOR +
    HIW "虚——空——无——转！\n\n" NOR +
    HIC "$N在$n身旁飞跃腾挪，每一步都遵循着某种高深而神秘的法则，
渐渐地，$n四周便出现了一个银色的次元之门，发出强大的引力！\n\n" NOR, me, target);

  if (random(ap1 + dp1) > dp1 / 2 && random(ap2 + dp2) > dp2 / 2) {
    message_vision(HIR "$N难以抵御引力，整个人被吸入了时空之门！\n" NOR, target);
    room1 = environment(target);
    howlong = random((int)me->query_skill("xukong-steps"));
    if (howlong > 200) howlong = 200;
    if (!(room = find_object("/d/hsl/outuniverse")))
      room = load_object("/d/hsl/outuniverse");
    if ((room = find_object("/d/hsl/outuniverse"))) {
      target->move(room);
      call_out("getout", howlong, target, room1);
    }
  } else {
    message_vision(HIC "$N运功抵御引力，瞬间后次元门消失了！\n" NOR, target, me);
  }
  me->start_busy(1 + random(2));
  me->add("force", -200);
  //     target->kill_ob(me);
  return 1;
}

void getout(object target, object room1) {
  if (target) {
    target->move(room1);
    message_vision(HIC "$N眼前一亮，原来又回到了失踪的地方！\n" NOR, target);
  }
  return;
}
