//code by tanpot
//for joke
#include <ansi.h>

inherit SSERVER;

int perform(object me, object target) {
  int mypot, tapot;
  //string myname;
  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("「郎情妾意」只有在战斗中才能使用。\n");
  if ((int)me->query_skill("eye-sword", 1) < 200)
    return notify_fail("你和你相好的还不够缠绵，还使不出这一招！\n");
  if (me->query("gender") == "女性" && target->query("gender") == "男性")
    message_vision(HIM "$N娇滴滴的对$n说道，好哥哥，我们一起使一套郎情妾意剑如何...\n\n" NOR, me, target);
  else if (me->query("gender") == "男性" && target->query("gender") == "女性")
    message_vision(HIM "$N豪情万丈的对$n说道，好妹妹，我们一起使一套郎情妾意剑如何。\n\n" NOR, me, target);
  else
    return notify_fail("「郎情妾意」只对异性有用！\n");
  mypot = (int)me->query_skill("eye-sword");
  mypot = mypot / 100;
  if (mypot > 5) mypot = 5;
  //myname=me->query("name");
  if (random(5) < mypot) {

    message_vision(HIY "$n痴痴看着$N,一时间手脚酥软，竟不知所以。\n$N趁机偷偷插上一剑！$n脸色顿时变得惨白！\n" NOR, me, target);
    target->start_busy(2);
    me->start_busy(4);
    target->add("kee", -400);
    me->add("kee", -200);
  } else {
    message_vision(HIW "$n对$N冷冷一笑，就凭你也想和我双剑合璧？我呸！\n$N顿时觉得无地自容！\n" NOR, me, target);
    me->start_busy(5);
    me->add("kee", -200);
  }
  if (!target->is_fighting(me)) {
    if (living(target)) {
      if (userp(target)) target->fight_ob(me);
      else target->kill_ob(me);
    }
    me->kill_ob(target);
  }
  return 1;
}
