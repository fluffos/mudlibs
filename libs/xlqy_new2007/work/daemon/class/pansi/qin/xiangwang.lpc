#include <ansi.h>
#include <combat.h> 
inherit SSERVER;

string *pfm_msg=({
BLINK+MAG"\n              『 ～～俩～～俩～～相～～忘～～ 』\n"NOR,
BLINK+HIG"\n              『 拈朵微笑的花  想一番人世变换  到头来输赢又何妨 』\n"NOR,
BLINK+HIY"\n              『 日与月互消长  富与贵难久长    今早的容颜老於昨晚 』\n"NOR,
BLINK+HIM"\n              『 眉开放一字宽  看一段人世风光  谁不是把悲喜在尝 』\n"NOR,
BLINK+HIR"\n              『 海连天走不完  恩怨难计算      昨日非今日该忘』\n"NOR,
BLINK+HIC"\n              『浪滔滔人渺渺  青春鸟飞去了     纵然是千古风流浪里摇』\n"NOR,
BLINK+HIW"\n              『风潇潇人渺渺  快意刀山中草     爱恨的百般滋味随风飘』\n"NOR,
	
});
int perform(object me,object target)
{
        string msg;
        object ob;
        object *enemy;
       
        int skill,skill3, skill2,music, kee_wound,damage;
        int hited,extra,lv,count;
      
      if(!wizardp(me))
      	return 0;
        skill = me->query_skill("yinsuo-jinling",1);
        skill2 = me->query_skill("jiuyin-xinjing",1);
        skill3=me->query_skill("qin",1);
        music = me->query_skill("music",1);
        ob = me->query_temp("weapon");
    
         enemy=me->query_enemy();
         count=sizeof(enemy);
       
        if(me->query("family/family_name")!="盘丝洞")
		return notify_fail("「俩俩相忘」只有盘丝洞门人才可以用！\n");
             
  //      if(!target)
   //     	target=offensive_target(me);
  //      if(!target)
   //      	return notify_fail("「俩俩相忘」只能在战斗中使用。\n");
          	    
        if( !me->is_fighting()|| !living(me) )
                return notify_fail("「俩俩相忘」只能在战斗中使用。\n");
        if(me->query_temp("QIN/play_zui"))
        	 return notify_fail("你哪里还有余力发挥「俩俩相忘」的威力。\n");
      if( target)
        if(!target->is_character() ||target->is_corpse()||target==me)
                return notify_fail("你要对谁施展这一招「俩俩相忘」？\n");
                
        if( (int)me->query("max_force") < 1000 )
                return notify_fail("你的内力修为还不够高！\n");
	if(ob->query("skill_type")!="music")
		  return notify_fail("手中无琴如何弹奏「俩俩相忘」？\n");
        if( (int)me->query("force") < 500 )
                return notify_fail("你现在的内力不足！\n");
	if( (int)me->query("kee") < 200 )
                return notify_fail("你现在的气血不足！\n");
        if( (int)me->query("sen") < 150 )
                return notify_fail("你精神不够了！\n");
                
        if( skill < 100)
                return notify_fail("你银索金铃的修为不够，发挥不了「俩俩相忘」的神韵! \n");

        if( skill2 < 100)
                return notify_fail("你九阴心经的修为不够，体会不到「俩俩相忘」的精神! \n");
 	if( skill3< 120)
                return notify_fail("你琴艺的修为不够，无法自如的弹奏「俩俩相忘」! \n");
     
        if( me->query_skill_mapped("whip") != "yinsuo-jinling") 
                return notify_fail("你没有激发银索金铃，无法使用「俩俩相忘」！\n");
  	
  	
  	    me->set("actions", (: call_other, SKILL_D("yinsuo-jinling"), "query_action" :) );
  	  
  	    ob->set_temp("original/use_apply_skill",ob->query("use_apply_skill"));
	    ob->set_temp("original/apply_skill_type",ob->query("apply/skill_type"));
	    ob->set_temp("original/name",ob->query("name"));
	    ob->set("name","琴弦");	    
	    ob->set("use_apply_skill",1);
	    ob->set("apply/skill_type","whip");
  	  
  	    me->add("force",-200);
  	    me->add("sen",-150);
  	    
            damage=ob->query("weapon_prop/damage")+ob->query("diablo_prop/damage");
			damage=damage*8/10;
           
            hited=0; 
            
      	   lv=1;
	   if(me->query("skill_level/music")=="expert")
	   	lv=2;
	   else if(me->query("skill_level/music")=="master")
	   	lv=4;
	   else if (me->query("skill_level/music")=="grandmaster")
	   	lv=5;
         	   
	    me->add_temp("apply/attack",8*(skill/5+skill3/5+skill2/5)/10);
	    me->add_temp("apply/damage",8*(skill/5+skill3/5+skill2/5-damage*6/7+damage*lv/7)/10);
	    me->delete("env/brief_message");
	   
	    if(music > 320) music = 320; 
	    for(int j=0;j<2+music/64;j++)
	    { 
	     if(!target)
       		 {
	       		 target=offensive_target(me);
		    		
		    	   msg=pfm_msg[j];
		    	   message_vision(msg, me);
			   msg  = CYN "\n$N挑起一根琴弦，“叮”的一声向$n直射而去！\n\n"NOR;
			   
			   if(target)
			   {
				   message_vision(msg, me, target);
				   kee_wound=COMBAT_D->do_attack(me,target , me->query_temp("weapon"), TYPE_QUICK); 
				   if(kee_wound>0)
				   {
				   	 hited++;
			   
				   for(int jj=0;jj<count;jj++)
			      	  {
			      	  	if(enemy[jj]&&target&&target!=enemy[jj]&&random(target->query("combat_exp")*lv/2)>random(enemy[jj]->query("combat_exp")))
			      	  	{	enemy[jj]->receive_damage("kee",kee_wound*lv/7);
			      	  		enemy[jj]->receive_wound("kee",random(kee_wound*lv/7));		
			      	  		enemy[jj]->set_temp("last_damage_from",me);
			      	  		COMBAT_D->report_status(enemy[jj], 0);
			      	  	}
			      	  }
		      	}
			  
		   }
		}
	  
	  else
	  {
	  	 target->delete("env/brief_message");
	   	  msg=pfm_msg[j];
	    	   message_vision(msg, me);
	  	  msg  = CYN "\n$N挑起一根琴弦，“叮”的一声向$n直射而去！\n"NOR;
		   message_vision(msg, me, target);
		  kee_wound=COMBAT_D->do_attack(me,target , me->query_temp("weapon"), TYPE_QUICK); 
	  	  if(kee_wound>0) hited++;
	  	
	}
	  }
	  if(hited>4)
	  {
	  	extra=random(skill+skill3+skill2);
	  	extra=extra/2+random(extra/2);
		extra=extra*8/10;
	  	msg=BLINK+HIB"\n        『既不回头 何必不忘 既然无缘 何须誓言 今日种种 似水无痕 明夕何夕 君已陌路』\n\n\n"NOR;
	 	message_vision(msg,me); 	
	  	  if(!target)
        		target=offensive_target(me);
		if(target)
		{
		   	target->receive_damage("kee",extra,me);
		   	target->receive_wound("kee",extra/2,me);
		   	target->receive_damage("sen",extra,me);
		   	target->receive_wound("sen",extra/2,me);
		   	if(!target->is_busy())
		   		target->start_busy(1+random(2));
		  	COMBAT_D->report_status(target);
	   		COMBAT_D->report_sen_status(target);
		}
	}
	
	    ob->set("use_apply_skill",ob->query_temp("original/use_apply_skill"));
    	    ob->set("apply/skill_type",ob->query_temp("original/skill_type"));
	    ob->set("name",ob->query_temp("original/name"));
	    me->add_temp("apply/attack",8*(-skill/5-skill3/5-skill2/5)/10);
	    me->add_temp("apply/damage",8*(-skill/5-skill3/5-skill2/5+damage*6/7-damage*lv/7)/10);
	
	  if( !target->is_fighting(me) ) {
                if( living(target) ) {
                        if( userp(target) ) target->fight_ob(me);
                        else target->kill_ob(me);
                }
        }
	    me->reset_action();   
	   me->start_busy(2+random(2));
	  
	   return 1;
      
}
