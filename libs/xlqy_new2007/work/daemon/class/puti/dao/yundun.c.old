
#include <ansi.h>

inherit SSERVER;

int cast(object me, object target)
{	int i;
        if( !target ) target = offensive_target(me);

        if( (int)me->query("mana") < 50 )
                return notify_fail("你的法力不够了！\n");

        if( (int)me->query("sen") < 50 )
                return notify_fail("你的精神无法集中！\n");
        if( me->is_busy() )
            return notify_fail("你正忙着呢！\n");

	if((string)me->query("family/family_name")!="方寸山三星洞" )
		return notify_fail("筋斗云不是想踩就能踩的。\n");

      if(me->query_skill("dao",1)< 30)
		return notify_fail("你还没学会踏云乘风呢。\n");

	me->add("mana", -25);
	me->receive_damage("sen", 20);
	if(random((int)me->query("max_mana"))<13)
	{
		tell_object(me,"天气晴朗，万里无云啊！\n");
		return 5+random(5);
	}
	if(me->is_fighting() ) {
		if(random((int)me->query("max_mana")) >(int)target->query("max_mana")/2) {
			  message_vision(HIW"只见$N一个跟头跳起，一去二三里，离地四五丈，硬生生逃过一劫！\n"NOR, me);
           
			if(random(3)==0) me->move("/d/lingtai/lantao2");
			else if(random(3)==1) me->move("/d/lingtai/gate1");
			else if (random(3)==2) me->move("/d/lingtai/jingtang");
			else me->move("/d/lingtai/houyuan");
			tell_room(environment(me),
				HIY"菩提老祖怒吼一声，你这小子，不学好，尽在外面给我丢脸！把"+me->query("name")+"从空中掼了下来，"+me->query("name")+"一下子摔得晕头转向……\n"NOR, ({me, me}) );

		} else {
			message_vision(HIW"$N想踏云而去，不料没踩牢，跌了个七荤八素。\n"NOR, me);
			me->start_busy(2);
		}
	} else {
		  message_vision(HIW"只见$N一个跟头跳起，一去二三里，离地四五丈，踏云而去也！\n"NOR, me);
	if(random(3)==0) me->move("/d/lingtai/lantao2");
			else if(random(3)==1) me->move("/d/lingtai/gate1");
			else if (random(3)==2) me->move("/d/lingtai/jingtang");
			else me->move("/d/lingtai/houyuan");
                tell_room(environment(me),
			HIY"菩提老祖怒吼一声，你这小子，不学好，尽在外面给我丢脸！把"+me->query("name")+"从空中掼了下来，"+me->query("name")+"一下子摔得晕头转向……\n"NOR, ({me, me}) );

	}

        return 5+random(5);
}


