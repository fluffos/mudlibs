//Cracked by Roath
#include <ansi.h>

inherit SSERVER;

int perform(object me, object target)
{
        object weapon;
	string level;
	int bonus=0;
	 int damage,flag;	
        if( !target ) target = offensive_target(me);

        if( !target
        ||      !target->is_character()
        ||      target->is_corpse()
        ||      target==me)
                return notify_fail("你要对谁施展这一招「霹雳三打」？\n");

//	if(me->query("family/family_name") != "方寸山三星洞" )
 //               return notify_fail("你是哪儿偷学来的武功，也想用「霹雳三打」?\n");
	if(me->query_temp("psxking"))
		 return notify_fail("你哪里还有余力发出「霹雳三打」？！\n");
	if(me->query("family/family_name") == "方寸山三星洞" )
                 bonus=(int)me->query_skill("qianjun-bang",1)/3;
if(me->query_temp("fc_set")) bonus += bonus/2;

	if(!me->is_fighting())
                return notify_fail("「霹雳三打」只能在战斗中使用！\n");

    if((int)me->query("max_force") < 500 )
                return notify_fail("你的内力不够！\n");

	if((int)me->query("force") < 500 )
		return notify_fail("你的内力不足！\n");

    if((int)me->query("sen") < 500 )
		return notify_fail("你的精神不足，没法子施用外功！\n");

    if((int)me->query_skill("qianjun-bang", 1) < 100)
		return notify_fail("你的千钧棒级别还不够，使用这一招会有困难！\n");

    if( !wizardp(me) && me->query_temp("no_perform")>time())
		return notify_fail("绝招多用就不灵了。\n");

	level = me->query("skill_level/stick");
	weapon = me->query_temp("weapon");
   	 me->delete("env/brief_message");
	target->delete("env/brief_message");

  	  message_vision(HIC"\n$N运足精神，身形一转，霹雳间连续向$n攻出了三招！\n"NOR,me,target);
		
	me->add_temp("apply/attack",bonus);
  me->add_temp("apply/defense",-bonus/2);
	me->add_temp("apply/damage",bonus/2);
        me->set_temp("QJB_perform", 4);
        
       if(level =="expert")
              	flag = 6;
       else if(level =="master")
       		flag = 4;
       	else if(level =="grandmaster")
       		flag = 2;
       	else flag = 10;

	if(!userp(me))
	 flag ++;
	 
        damage = COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
       	if(damage > 0&&!random(flag)&&weapon)
       	{
       		
   message_vision(HIR"\n\n$N一击得手，力贯"+weapon->name()+"直砸的$n全身气血翻涌，眼冒金星，经脉中内息乱串！\n\n"NOR,me,target);
      	 	if(!target->is_busy())
      	 		target->start_busy(random(2));
      	 	target->receive_damage("kee",target->query("kee")/12,me);
     	 	target->receive_damage("sen",target->query("sen")/24,me);

      	 	target->receive_wound("kee",1+random(target->query("kee")/12));
      	 	target->add("force",-target->query("force")/12);
       		COMBAT_D->report_status(target);
       		COMBAT_D->report_sen_status(target);
       	}

        me->set_temp("QJB_perform", 1);  
        damage = COMBAT_D->do_attack(me, target, me->query_temp("weapon")); 
	if(damage > 0&&!random(flag)&&weapon)
       	{
       		
             message_vision(HIR"\n\n$N一击得手，力贯"+weapon->name()+"直砸的$n全身气血翻涌，眼冒金星，经脉中内息乱串！\n\n"NOR,me,target);
      	 	if(!target->is_busy())
      	 		target->start_busy(random(2));
      	 	target->receive_damage("kee",target->query("kee")/12,me);
      	 	target->receive_damage("sen",target->query("sen")/24,me);
      	 	target->receive_wound("kee",1+random(target->query("kee")/12));
      	 	target->add("force",-target->query("force")/12);
       		COMBAT_D->report_status(target);
       		COMBAT_D->report_sen_status(target);
       		
       	}
        me->set_temp("QJB_perform", 6);
        damage =  COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
	if(damage > 0&&!random(flag)&&weapon)
       	{
       		
               message_vision(HIR"\n\n$N一击得手，力贯"+weapon->name()+"直砸的$n全身气血翻涌，眼冒金星，经脉中内息乱串！\n\n"NOR,me,target);
      	 	if(!target->is_busy())
      	 		target->start_busy(random(2));
      	 	target->receive_damage("kee",target->query("kee")/12,me);
      	 	target->receive_damage("sen",target->query("sen")/24,me);
      	 	target->receive_wound("kee",1+random(target->query("kee")/12));
      	 	target->add("force",-target->query("force")/12);
       		COMBAT_D->report_status(target);
       		COMBAT_D->report_sen_status(target);
       		
       	}
	me->add_temp("apply/attack",-bonus);
 me->add_temp("apply/defense",bonus/2);
	me->add_temp("apply/damage",-bonus/2);
        me->delete_temp("QJB_perform");

        me->receive_damage("sen", 100);
        me->add("force", -100);

        if( !target->is_fighting(me) ) {
                if( living(target) ) {
                        if( userp(target) ) target->fight_ob(me);
                        else target->kill_ob(me);
                }
        }
  me->set_temp("no_move",1);
  if(level =="master"||level =="grandmaster")
 	 me->set_temp("no_perform",time()+random(4)+3);
  else
   me->set_temp("no_perform",time()+random(4)+4);
  call_out("remove_no_move",4,me);
  return 1;
}

void remove_no_move(object me) 
{
  if (me) me->delete_temp("no_move");
}

