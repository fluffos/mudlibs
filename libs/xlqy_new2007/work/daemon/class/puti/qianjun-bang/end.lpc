#include <ansi.h>
#include <combat.h>
inherit SSERVER;


int perform(object me, object target) {
  int how_long, times;
  string str;
  object weapon;

  if (!target) target = me->query_temp("psxk_target");

  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要对谁施展「天地无用」？\n");


  if (!me->query_temp("psxk"))
    return notify_fail("你没有蓄力。\n");

  if (me->query_temp("psxk_target") != target)
    return notify_fail("你搞错对象了吧。\n");

  weapon = me->query_temp("weapon");
  how_long = me->query_temp("psxk");
  times = random(how_long) + 1;
  if (how_long > 6 && times < 6) times = 5;
  if (how_long > 9) times = 9;
  if (me->query_temp("fc_set")) times += times / 2;


  message_vision(HIC "$N望天长啸，日月为之变色，手中" + weapon->name() + HIC "遥指苍穹，聚天地之气暴风骤雨般袭向$n。
$n只觉得$N激荡起来的真气以山崩地裂的气势一道接一道扑来，全身劲气不畅，直喘不过气来。\n" NOR, me, target);

  for (int i = 0; i <= times; i++)
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_QUICK);


  if (target->query("eff_kee") < 0 || !living(target)) {
    str = HIR + target->name() + NOR + HIM "中了" + HIW + me->name() + NOR + HIM "的" + BLINK + HIY "「天地无用」" NOR + HIM "，在惊天劲气震荡下，吐血而亡，全身上下竟无一块完整的骨骼！" NOR;
    CHANNEL_D->do_channel(me, "rumor", str);
    me->delete_temp("last_channel_msg");
  }


  me->remove_call_out("remove_effect");
  me->delete_temp("psxk");
  me->delete_temp("psxking");
  me->delete_temp("before_psxk_dodge");

  me->set_temp("psxk_end", time());
  me->delete_temp("psxk_target");
  me->delete_temp("no_move");
  me->add_temp("apply/dodge", -me->query_temp("psxk_add_dodge"));
  me->delete_temp("psxk_add_dodge");
  me->add_temp("apply/force", -me->query_temp("psxk_add_force"));
  me->delete_temp("psxk_add_force");
  me->add_temp("apply/damage", -me->query_temp("psxk_add_damage"));
  me->delete_temp("psxk_add_damage");
  me->add_temp("apply/force_vs_damage", -me->query_temp("psxk_add_forcevsdamage"));
  me->delete_temp("psxk_add_forcevsdamage");
  me->add_temp("apply/combat_double_damage", -me->query_temp("psxk_add_doubledamage"));
  me->delete_temp("psxk_add_doubledamage");
  return 1;


}
