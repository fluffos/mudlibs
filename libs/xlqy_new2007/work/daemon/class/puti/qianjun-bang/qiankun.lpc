//Cracked by Roath
#include <ansi.h>

inherit SSERVER;

int perform(object me, object target) {
  object weapon;
  string level;

  int i, damage, flag;
  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要对谁施展这一招「乾坤一棒」？\n");
  if (me->query("family/family_name") != "方寸山三星洞")
    return notify_fail("你是哪儿偷学来的武功，也想用「乾坤一棒」?\n");
  if (me->query_temp("psxking"))
    return notify_fail("你哪里还有余力发出「乾坤一棒」？！\n");
  if (!me->is_fighting())
    return notify_fail("「乾坤一棒」只能在战斗中使用！\n");

  if ((int)me->query("max_force") < 1000)
    return notify_fail("你的内力不够！\n");

  if ((int)me->query("force") < 1000)
    return notify_fail("你的内力不足！\n");

  if ((int)me->query("sen") < 500)
    return notify_fail("你的精神不足，没法子施用外功！\n");


  level = me->query("skill_level/stick");
  if (level == "master" || level == "grandmaster") {
    if (me->query_temp("no_perform_qiankun") > time())
      return notify_fail("绝招多用就不灵了。\n");
  } else {
    if (me->query_temp("no_perform") > time())
      return notify_fail("绝招多用就不灵了。\n");


  }
  i = (int)me->query_skill("qianjun-bang", 1) + (int)me->query_kar();

  if (i < 150)
    return notify_fail("你的千钧棒级别还不够，使用这一招会有困难！\n");

  me->delete("env/brief_message");
  target->delete("env/brief_message");

  message_vision(HIC "\n$N运足精神，一个高跳在空，使出了「乾坤一棒」的绝技！\n" NOR, me);

  me->set_temp("QJB_perform", 7);
  damage = COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
  if (damage > 0 && level == "expert")
    flag = 4;
  else if (damage > 0 && level == "master")
    flag = 3;
  else if (damage > 0 && level == "grandmaster")
    flag = 1;
  else if (damage > 0)
    flag = 12;
  else flag = 0;
  if (flag && !random(flag)) {
    message_vision(HIG "\n$N一招乾坤一击得手，直砸的$n全身气血翻涌，经脉中内息乱串！\n\n" NOR, me, target);
    if (!target->is_busy())
      target->start_busy(random(2));
    target->receive_damage("kee", target->query("kee") / 12, me);
    target->receive_wound("kee", 1 + random(target->query("kee") / 12));
    target->add("force", -target->query("force") / 12);
    COMBAT_D->report_status(target);

  }

  me->delete_temp("QJB_perform");

  me->receive_damage("sen", 100 + random(100));
  me->add("force", -200);

  if (!target->is_fighting(me)) {
    if (living(target)) {
      if (userp(target)) target->fight_ob(me);
      else target->kill_ob(me);
    }
  }
  if (level == "master" || level == "grandmaster")
    me->set_temp("no_perform_qiankun", time() + 4 + random(4));
  else me->set_temp("no_perform", time() + 5 + random(5));
  me->set_temp("no_move", 1);
  call_out("remove_no_move", 2, me);
  return 1;
}

void remove_no_move(object me) {
  if (me) me->delete_temp("no_move");
}
