#include <ansi.h>
#include <combat.h> 
inherit F_DBASE;
inherit SSERVER;
 mapping default_dirs = ([
        "north":        "北",
        "south":        "南",
        "east":         "东",
        "west":         "西",
        "northup":      "北边",
        "southup":      "南边",
        "eastup":       "东边",
        "westup":       "西边",
        "northdown":    "北边",
        "southdown":    "南边",
        "eastdown":     "东边",
        "westdown":     "西边",
        "northeast":    "东北",
        "northwest":    "西北",
        "southeast":    "东南",
        "southwest":    "西南",
        "up":           "上",
        "down":         "下",
        "out":          "外",
        "enter":        "里",
]);
 
int perform(object me, object target)
{
        int delay,skill;
        int ap,dp,pp,success;
        int mydodge,hedodge;
        int n,i;
        string *dirs, target_dir, dest;
	mapping exit;
	object env,room;
        object weapon=me->query_temp("weapon"); 
         if( (int)me->is_busy() )
                return notify_fail("你现在正忙着呢。\n");
 	 if (!me->is_fighting())
          return notify_fail("没事你抱着耙子乱串干嘛？\n");
	if( !target ) target = offensive_target(me);

        if( !target
        ||      !target->is_character()
        ||      target->is_corpse()
        ||      target==me)
                return notify_fail("你想吓唬谁啊？\n");
      if(target->is_busy())
      	 return notify_fail("对方已经自顾不暇啦，你就不要吓唬人家了。\n");
        skill=me->query_skill("rake");       
        mydodge = me->query_skill("dodge");
        hedodge = target->query_skill("dodge"); 
        if (skill< 150) return notify_fail("你握耙子手还不够稳，施展不出倒打一耙。\n");
    	if(me->query_temp("daoda_perform") > time())
    		return notify_fail("倒打一耙用多就不灵啦。\n");
        if( (int)me->query("force") < 300 )      
                return notify_fail("你的内力不够。\n");
          
        me->add("force", -200);
	
        message_vision(HIY"激战之中，$N突然倒扛起手中的"+weapon->name()+HIY"哼哧哼哧准备开溜！\n"NOR, me);
        me->set_temp("daoda_perform",time()+3+random(3));
       
       ap = me->query("combat_exp");
       dp = target->query("combat_exp");
       ap += me->query_skill("rake",1)*me->query_skill("rake",1)*me->query_skill("rake",1)/10;
       dp +=target->query_skill("parry",1)*target->query_skill("parry",1)*target->query_skill("parry",1)/15;
       
       ap = ap*me->query("cor")/15;
       dp = dp*target->query("cps")/40;
    
       if(random(ap+dp) > dp||random(13)==6)
       {
       	        message_vision("$N一愣之下，以为有机可乘，撒步上前追去！\n", target,me);
       	         message_vision(HIR"$N倒拖钉耙，突的反身一击，打了$n一个大大的措手不及！\n"NOR, me,target);
		
		target->start_busy(3+random(me->query_skill("skyriver-rake",1)/100));
		me->add_temp("apply/sub_max_armor",skill*5);
		me->add_temp("apply/sub_max_defense",skill*5);	
		me->add_temp("apply/damage",skill/5);	
       		COMBAT_D->do_attack(me, target, me->query_temp("weapon"),TYPE_QUICK);
       		me->add_temp("apply/sub_max_armor",-skill*5);
		me->add_temp("apply/sub_max_defense",-skill*5);	
		me->add_temp("apply/damage",-skill/5);	
	}
        else 
       {
	        if(random(mydodge+hedodge) < hedodge/2)
	        {
	        	  message_vision("$N早已识破$n的诡计，身形一晃拦在了$n的面前，让$n欲攻不能，欲退不得！\n", target,me);	
	        	me->start_busy(1+random(2));
	        	return;	
	        }
	        else
	        {
	        	
			env=environment(me);
	        	if( env->query("exits")==([ ]) || !env->query("exits"))
	        	{
	        		message_vision("$N突然发现眼前无路可退，只得仓惶出手！\n",me, target);
                		COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
                		me->start_busy(random(2));
	        		return;
	        	}
	        	else
	        	{
	        		message_vision("不料$N早已识破$n的诡计，$n只得顺势跑了开去。\n"NOR, target,me);	
	        		exit=env->query("exits");
		        	if( mapp(exit)) {
					dirs=keys(exit);
					n=sizeof(exit);
					if(n > 0)
					{
						i=random(n);
						dest=exit[dirs[i]];
						if(!undefinedp(default_dirs[dirs[i]]))
							target_dir=default_dirs[dirs[i]];
						else
							target_dir=dirs[i]; 
		
						if( room=load_object(dest)) {
							success=1;
							
						}
					}
	
				}	
	        		if( success == 1){
				if( me->move(room) ) {

					tell_room(environment(me),	HIR"\n只见"+me->name()+"神色狼狈的跑了过来！\n" NOR, ({me,
					me}));
				}
				}
			}
	        		
	        	}
	        
		}
        
         return 1;
}
