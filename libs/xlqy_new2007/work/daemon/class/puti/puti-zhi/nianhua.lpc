#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target)
{
	string msg;
	int extra;
	object weapon;

	if( !target ) target = offensive_target(me);
	
        if( !target
        ||      !target->is_character()
        ||      target->is_corpse()
        ||      target==me )
                return notify_fail("你要对谁施展这一招「拈花三指」？\n");
                
        if(me->query("family/family_name") != "方寸山三星洞" )
                return notify_fail("你是哪儿偷学来的武功，也想用「拈花三指」?\n");
	if(me->query_temp("psxking"))
		 return notify_fail("你哪里还有余力发出「拈花三指」？！\n");
	if(!me->is_fighting())
                return notify_fail("「拈花三指」只能在战斗中使用！\n");
        
        if((int)me->query("force") < 1000 )
                return notify_fail("你的内力不足！\n");
		
	if(me->is_busy())
                return notify_fail("你现在没空！！\n");
                
	extra = me->query_skill("unarmed");
	extra=extra*8/10;
if(me->query_temp("fc_set")) extra += extra/2;
	if ( me->query_skill("puti-zhi",1) < 160 )
		return notify_fail("你的菩提指还不够纯熟！\n");
		
	if( me->query_temp("no_perform")>time())
		return notify_fail("你现在气力不继，出不了「拈花三指」。\n");

	me->add("force_factor",extra/6);
	me->add_temp("apply/attack",extra/6);
	me->add_temp("apply/strength", extra/6);
	weapon = me->query_temp("weapon");
	
msg = HIY  "$N使出「拈花三指」，一招连环三式向$n攻出！\n" NOR;
message_vision(msg,me,target);

msg = HIY  "\n左一拳！\n" NOR;
COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
message_vision(msg,me,target);
msg = HIY  "\n右一拳！\n" NOR;
COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
message_vision(msg,me,target);
msg = HIY  "\n中间再加一拳！！\n" NOR;
COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
message_vision(msg,me,target);

	me->add_temp("apply/attack",-extra/6);
	me->add_temp("apply/strength", -extra/6);
	me->add("force_factor",-extra/6);
	me->set_temp("no_move",1);
  	me->set_temp("no_perform",time()+random(2)+3);
  	call_out("remove_no_move",3,me);
	
	return 1;
}

void remove_no_move(object me) 
{
  if (me) me->delete_temp("no_move");
}

