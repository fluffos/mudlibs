inherit SSERVER;
#include <ansi.h>

int cast(object me, object target)
{

	int skill,effect,flag;
	mapping con;
	string *conlist;
	string level;
	me=this_player();
	if (!target 
      ||  !userp(target)
      ||      target->is_corpse()
      ||      target==me)
		return notify_fail("你想替谁解除五行之毒？\n");

	if( (int)me->query_skill("moonshentong", 1) < 150 )
		return notify_fail("你的月宫神通修为不足。\n");
	if(me->query("family/family_name")!="月宫")
                return notify_fail("你非月宫弟子，不懂得如何驱解五行之毒！\n");
        if( (int)me->query("mana") < 1000 )     
                return notify_fail("你的法力不够。\n");
	if( (int)me->query("kee") < 300 )
		return notify_fail("你的气血不足。\n");
	if( (int)me->query("sen") < 300 )
		return notify_fail("你的精神不足。\n");
	if( (int)target->is_busy() )
		return notify_fail("人家正忙着呢。\n");
    if( (int)target->is_fighting() )
        return notify_fail("人家正忙着呢。\n");
        if(!userp(me))	return 0;
        skill = me->query_skill("spells");
	con = target->query_entire_conditions();
	if(!mapp(con))
		return notify_fail(target->name()+"并未受到任何五行之毒。\n");
	conlist = keys(con);
	for(int i = 0;i< sizeof(conlist);i++)
	{
		level = conlist[i];
		if(level == "illness_poison")
		{
				
		  	message_vision(HIM"$N俯首闭目，十指虚合做兰花状，默运神通，脸上渐渐散发出圣洁的光芒！\n" NOR, me);
		  	
		  	if(random((int)me->query_skill("moonshentong", 1)) < 13)
		  	{
		  	message_vision(	HIY "$N突然脸色苍白，似乎体力不支，竟呕出一口血来……\n"NOR, me );
		  	 me->add("maximum_mana",-3);
  		          me->add("max_mana",-3);	
		  		return 5+random(5);
		  	}
		  	tell_object(target,WHT"你沐浴在那柔和如皎月光芒下，觉得心中和平喜乐，渐渐的神游物外...\n"NOR);
		  	tell_object(target,HIG"你所受的五行毒之疾病已经消除了！\n"NOR);
		  	effect = target->query_temp("wuxing_poison/illness_point");
		  	target->add_temp("apply/attack",effect);
		  	target->add_temp("apply/defense",effect);
		  	target->delete_temp("wuxing_poison/illness_point");
		  	target->clear_condition(level);
		  	target->set_temp("force_sleep",1);
			target->command_function("sleep");

			target->delete_temp("force_sleep");
		  	me->add("mana",-360);
		        if( me->is_fighting() ) me->start_busy(3);
		        return 5+random(5);	
			
		}
		if(level == "weakness_poison")
		{
				
		  	message_vision(HIM"$N俯首闭目，十指虚合做莲花状，默运神通，脸上渐渐散发出圣洁的光芒！\n" NOR, me,target);
		  	if(random((int)me->query_skill("moonshentong", 1)) < 13)
		  	{
		  	message_vision(	HIY "$N突然脸色苍白，似乎体力不支，竟呕出一口血来……\n"NOR, me );
		  	 me->add("maximum_mana",-3);
  		          me->add("max_mana",-3);	
		  		return 5+random(5);
		  	}
		  	tell_object(target,WHT"你沐浴在那柔和如皎月光芒下，觉得心中和平喜乐，渐渐的神游物外...\n"NOR);
		  	tell_object(target,HIG"你所受的五行毒之虚弱已经消除了！\n"NOR);
		  	effect = target->query_temp("wuxing_poison/weakness_point");
		  	target->add_temp("apply/attack",effect);
		  	target->add_temp("apply/strength",effect);
		  	target->delete_temp("wuxing_poison/weakness_point");
		 	target->set_temp("force_sleep",1);
			target->command_function("sleep");
	
			target->delete_temp("force_sleep");
		  	me->add("mana",-360);
		  	target->clear_condition(level);
		        if( me->is_fighting() ) me->start_busy(3);
		        return 5+random(5);	
			
		}
		if(level == "madness_poison")
		{
				
		  	message_vision(HIM"$N俯首闭目，十指虚合做莲花状，默运神通，脸上渐渐散发出圣洁的光芒！\n" NOR, me,target);
		  	if(random((int)me->query_skill("moonshentong", 1)) < 13)
		  	{
		  	message_vision(	HIY "$N突然脸色苍白，似乎体力不支，竟呕出一口血来……\n"NOR, me );
		  	 me->add("maximum_mana",-3);
  		          me->add("max_mana",-3);	
		  		return 5+random(5);
		  	}
		  	tell_object(target,WHT"你沐浴在那柔和如皎月光芒下，觉得心中和平喜乐，渐渐的神游物外...\n"NOR);
		  	tell_object(target,HIG"你所受的五行毒之疯狂已经消除了！\n"NOR);
		  	effect = target->query_temp("wuxing_poison/madness_point");
		  	target->add_temp("apply/attack",effect);
		  	target->add_temp("apply/defense",effect);
		  	target->delete_temp("wuxing_poison/madness_point");
		  	effect = target->query_temp("wuxing_poison/madness_str");
		  	target->add_temp("apply/strength",-effect);
		  	target->delete_temp("wuxing_poison/madness_str");
		  	target->clear_condition(level);
		  	target->set_temp("force_sleep",1);
		target->command_function("sleep");

		target->delete_temp("force_sleep");
		  	me->add("mana",-360);
		        if( me->is_fighting() ) me->start_busy(3);
		        return 5+random(5);	
			
		}
		if(level == "fearness_poison")
		{
				
		  	message_vision(HIM"$N俯首闭目，十指虚合做莲花状，默运神通，脸上渐渐散发出圣洁的光芒！\n" NOR, me,target);
		  	if(random((int)me->query_skill("moonshentong", 1)) < 13)
		  	{
		  	message_vision(	HIY "$N突然脸色苍白，似乎体力不支，竟呕出一口血来……\n"NOR, me );
		  	 me->add("maximum_mana",-3);
  		          me->add("max_mana",-3);	
		  		return 5+random(5);
		  	}
		  	tell_object(target,WHT"你沐浴在那柔和如皎月光芒下，觉得心中和平喜乐，渐渐的神游物外...\n"NOR);
		  	tell_object(target,HIG"你所受的五行毒之恐惧已经消除了！\n"NOR);
		  	effect = target->query_temp("wuxing_poison/fearness_point");
		  	target->add_temp("apply/courage",effect);
			  	target->delete_temp("wuxing_poison/fearness_point");
		  	target->clear_condition(level);
		  	target->set_temp("force_sleep",1);
		target->command_function("sleep");

		target->delete_temp("force_sleep");
		        if( me->is_fighting() ) me->start_busy(3);
		        return 5+random(5);	
			
		}
		if(level == "curse_poison")
		{
				
		  	message_vision(HIM"$N俯首闭目，十指虚合做莲花状，默运神通，脸上渐渐散发出圣洁的光芒！\n" NOR, me,target);
		  	if(random((int)me->query_skill("moonshentong", 1)) < 13)
		  	{
		  	message_vision(	HIY "$N突然脸色苍白，似乎体力不支，竟呕出一口血来……\n"NOR, me );
		  	 me->add("maximum_mana",-3);
  		          me->add("max_mana",-3);	
		  		return 5+random(5);
		  	}
		  	tell_object(target,WHT"你沐浴在那柔和如皎月光芒下，觉得心中和平喜乐，渐渐的神游物外...\n"NOR);
		  	tell_object(target,HIG"你所受的五行毒之诅咒已经消除了！\n"NOR);
		  	effect = target->query_temp("wuxing_poison/sub_bless");
		  	target->add_temp("combat/bless",effect);
			 target->delete_temp("wuxing_poison/sub_bless");
		  	target->clear_condition(level);
		  	target->set_temp("force_sleep",1);
			target->command_function("sleep");

			target->delete_temp("force_sleep");
		  	me->add("mana",-360);
		        if( me->is_fighting() ) me->start_busy(3);
		        return 5+random(5);	
			
		}
		if(level == "unlucky_poison")
		{
				
		  	message_vision(HIM"$N俯首闭目，十指虚合做莲花状，默运神通，脸上渐渐散发出圣洁的光芒！\n" NOR, me,target);
		  	if(random((int)me->query_skill("moonshentong", 1)) < 13)
		  	{
		  	message_vision(	HIY "$N突然脸色苍白，似乎体力不支，竟呕出一口血来……\n"NOR, me );
		  	 me->add("maximum_mana",-3);
  		          me->add("max_mana",-3);	
		  		return 5+random(5);
		  	}
		  	tell_object(target,WHT"你沐浴在那柔和如皎月光芒下，觉得心中和平喜乐，渐渐的神游物外...\n"NOR);
		  	tell_object(target,HIG"你所受的五行毒之厄运已经消除了！\n"NOR);
		  	effect = target->query_temp("wuxing_poison/sub_lucky");
		  	target->add_temp("combat/lucky",effect);
			 target->delete_temp("wuxing_poison/sub_lucky");
		  	target->clear_condition(level);
		  	target->set_temp("force_sleep",1);
			target->command_function("sleep");

			target->delete_temp("force_sleep");
		  	me->add("mana",-360);
		        if( me->is_fighting() ) me->start_busy(3);
		        return 5+random(5);	
			
		}
		if(level == "stoner_poison")
		{
				
		  	message_vision(HIM"$N俯首闭目，十指虚合做莲花状，默运神通，脸上渐渐散发出圣洁的光芒！\n" NOR, me,target);
		  	if(random((int)me->query_skill("moonshentong", 1)) < 13)
		  	{
		  	message_vision(	HIY "$N突然脸色苍白，似乎体力不支，竟呕出一口血来……\n"NOR, me );
		  	 me->add("maximum_mana",-3);
  		          me->add("max_mana",-3);	
		  		return 5+random(5);
		  	}
		  	tell_object(target,WHT"你沐浴在那柔和如皎月光芒下，觉得心中和平喜乐，渐渐的神游物外...\n"NOR);
		  	tell_object(target,HIG"你所受的五行毒之虚石化已经消除了！\n"NOR);
		  	effect = target->query_temp("wuxing_poison/stoner_point");
		  	target->add_temp("apply/dodge",effect);
		  	target->add_temp("apply/parry",effect);
			target->delete_temp("wuxing_poison/stoner_point");
		  	target->set_temp("force_sleep",1);
			target->command_function("sleep");

			target->delete_temp("force_sleep");
		  	target->clear_condition(level);
		  	me->add("mana",-360);
		        if( me->is_fighting() ) me->start_busy(3);
		        return 5+random(5);	
			
		}	
		
		
		
	}	
      return notify_fail(target->name()+"并未受到任何五行之毒。\n");

}
