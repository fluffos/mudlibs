
#include <ansi.h>

inherit SSERVER;

int cast(object me, object target)
{	int i;
        if( !target ) target = offensive_target(me);

        if( (int)me->query("mana") < 50 )
                return notify_fail("你的法力不够了！\n");

        if( (int)me->query("sen") < 50 )
                return notify_fail("你的精神无法集中！\n");
        if( me->is_busy() )
            return notify_fail("你正忙着呢！\n");

	if((string)me->query("family/family_name")!="月宫" )
		return notify_fail("就你这样也能幻花化影？\n");

      
	if(me->query_skill("moonshentong")< 30)
		return notify_fail("你还没学会幻花化影呢。\n");
	me->add("mana", -25);
	me->receive_damage("sen", 20);
	if(random((int)me->query("max_mana"))<13)
		{
		tell_object(me,"今天天气不好，月亮没出来...\n");
		return 5+random(5);
		}
	if(me->is_fighting() ) {
		if(random((int)me->query("max_mana")) >(int)target->query("max_mana")/2) {
			  message_vision(HIW"$N散出满天的花瓣,等到花瓣落尽,身影已然消失在花影中！\n"NOR, me);
           
			if(random(3)==0) me->move("/d/moon/ontop2");
			else if(random(3)==1) me->move("/d/moon/courtyard");
			else if (random(3)==2) me->move("/d/moon/lotuspond");
			else me->move("/d/moon/wangmu_room");
			tell_room(environment(me),
				HIM"五彩花瓣纷纷洒洒的从空飘落，"+me->query("name")+"施施然从中而出。\n"NOR, ({me, me}) );

		} else {
			message_vision(HIM"$N洒出漫天花瓣，却被狂风吹得七零八落。\n"NOR, me);
			me->start_busy(2);
		}
	} else {
		  message_vision(HIW"$N散出满天的花瓣,等到花瓣落尽,身影已然消失在花影中！\n"NOR, me);
	if(random(3)==0) me->move("/d/moon/ontop2");
			else if(random(3)==1) me->move("/d/moon/courtyard");
			else if (random(3)==2) me->move("/d/moon/lotuspond");
			else me->move("/d/moon/wangmu_room");
                tell_room(environment(me),
			HIM"五彩花瓣纷纷洒洒的从空飘落，"+me->query("name")+"施施然从中而出。\n"NOR, ({me, me}) );

	}

        return 5+random(5);
}


