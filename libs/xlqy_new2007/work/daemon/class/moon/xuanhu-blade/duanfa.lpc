#include <ansi.h>
#include <combat.h>
inherit SSERVER;

void duanfa_ok(object);

int perform(object me, object target)
{
        int damage;
        if( !target ) target = offensive_target(me);
        if( !target
        ||      !target->is_character()
        ||      target->is_corpse()
        ||      target==me)
                return notify_fail("你要对谁施展这一招「断发」？\n");
//		if(me->query("family/family_name") != "月宫")
//                return notify_fail("[断发]是月宫不传之密！\n");
        if(!me->is_fighting())
                return notify_fail("「断发」只能在战斗中使用！\n");
        if((int)me->query("max_force") < 300 )
                return notify_fail("你的内力不够！\n");
          if((int)me->query("force") < 300 )
                return notify_fail("你的内力不足！\n");
        if((int)me->query("sen") < 100 )
                return notify_fail("你的精神不足，没法子施用外功！\n");
        if((int)me->query_skill("xuanhu-blade", 1) < 100)
                return notify_fail("你的玄狐长恨刀法不够熟练，使用这一招会有困难！\n");
        if(me->query_temp("no_xuanhu-blade_duanfa")>time())
			return notify_fail("绝招多用就不灵了！\n");
		me->set_temp("no_xuanhu-blade_duanfa",time()+3);

	me->delete("env/brief_message");
        target->delete("env/brief_message");
        message_vision(HIC"\n$N一声长吟，刀光笼罩天宇，漫天青光缓缓撒落，缠绵恨意，至此断绝！\n"NOR,me,target);
        damage=(int)me->query_skill("xuanhu-blade",1)+random((int)me->query_skill("blade"));
        damage = damage*(1+random(1+me->query_per()/10));
if(me->query_temp("moon_set")) damage += damage/2;
		
        if (random((int)target->query("combat_exp"))<(int)me->query("combat_exp")*3/4)
		{
			message_vision(HIW"\n$n望着刀光，心绪如波，无数缠绵往事涌上心头，不由心底一酸，心神荡漾，三魂六魄都丢光了!\n"NOR,me,target);
			target->receive_damage("sen",damage,me,"magic");
			target->receive_wound("sen",damage/2,me);
			COMBAT_D->report_sen_status(target);
		}
		else
		{
			message_vision(HIG"\n$n一声长啸，拔地而起，从刀光中挣脱出来，点点青光顿时消失！\n"NOR,me,target);
			me->start_busy(random(2));
        }
        me->receive_damage("sen", 50);
        me->add("force", -100);
		return 1;
}
