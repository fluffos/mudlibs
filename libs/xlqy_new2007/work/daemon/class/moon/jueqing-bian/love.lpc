// by gamer@88
#include <ansi.h>

inherit SSERVER;
//inherit F_CLEAN_UP;

int perform(object me, object target) {
  object weapon, tar_weapon, invoker;
  int i, j, k, damage, level;
  int success, ap, dp, ap2, dp2;
  string msg;
  int count, a_attack, a_damage;
  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要攻击谁？\n");

  if (!me->is_fighting())
    return notify_fail("你们没有在打架！\n");
  if (me->query("family/family_name") != "月宫")
    return notify_fail("你怎知情为何物！\n");

  if ((int)me->query("max_force") < 1000)
    return notify_fail("你的内功太差。\n");

  if ((int)me->query("force") < 500)
    return notify_fail("你的内力不足！\n");

  if ((int)me->query("sen") < 100)
    return notify_fail("你的精神不足，没法子施用外功！\n");

  if ((int)me->query_skill("moonforce", 1) < 120)
    return notify_fail("你的圆月心法等级不够，不能使用这一招！\n");
  if ((int)me->query_skill("moonshentong", 1) < 120)
    return notify_fail("你的月宫仙法修为太差，不能使用这一招！\n");
  if ((int)me->query_skill("whip", 1) < 120)
    return notify_fail("你的鞭法还没学到家，不能使用这一招！\n");
  if ((int)me->query_skill("jueqingbian", 1) < 120)
    return notify_fail("你的绝情鞭法火候还不足，不能使用这一招！\n");

  i = (int)me->query("combat_exp");
  j = (int)target->query("combat_exp");
  level = (int)me->query_skill("jueqingbian", 1);
  level += (int)me->query_skill("moonshentong", 1);
  level += (int)me->query_skill("whip", 1);
  level += (int)me->query_skill("moonforce", 1);
  level = (int)level / 200 + 1;
  if (level > 3) level = 3 + random(level - 2);
  if (level > 7) level = 4 + random(5);
  me->delete("env/brief_message");
  target->delete("env/brief_message");
  tar_weapon = target->query_temp("weapon");
  weapon = me->query_temp("weapon");
  invoker = target->query_temp("invoker");
  if (me->query_temp("jueqing/time") > time())
    return notify_fail("天若有情天亦老，人若多情空烦恼！\n");
  me->set_temp("jueqing/time", time() + 5 + level);


  msg = HIM "\n              厚地高天,堪叹古今情不尽； 痴男怨女,可怜风月债难偿！\n";
  message_vision(msg, me);
  msg = HIY "\n$N使出了『绝情鞭法』的精髓－－－－
	\n" BLINK + HIY "                              『" HIG "情思" HIB "·" HIR "情痴" HIB "·" HIW "情恨" HIY "』
	\n" NOR + MAG "只见$N随歌而舞，幻为月影斑斑，散作暗香浮动，手中的" + weapon->name() + MAG "洒出漫天鞭影，向$n攻去！\n\n" NOR;
  message_vision(msg, me, target);


  message_vision(BLINK + HIG "\n                                    『情思』\n" NOR, me);
  msg = HIG "                     衣带渐宽终不悔" HIB "－－－－ " HIY "为伊消得人憔悴！\n" NOR;

  message_vision(msg, me);
  count = me->query("per");  //嘿嘿....
  if (!me->query("married") && !me->query("divorced"))  //嗯，待字闺中
    count = count * 2;
  count = count * 8 / 10;
  if (me->query_temp("moon_set")) count += count / 2;
  me->add_temp("apply/attack", count);
  me->add_temp("apply/damage", count / 2);
  a_attack = count;
  a_damage = count / 2;
  COMBAT_D->do_attack(me, target, weapon);
  me->add_temp("apply/attack", -a_attack);
  me->add_temp("apply/damage", -a_damage);

  message_vision(BLINK + HIR "\n                                    『情痴』\n" NOR, me);
  msg = HIR "                     金风玉露一相逢" HIB "－－－－" HIM "便胜却人间无数！\n" NOR;
  message_vision(msg, me);

  count = me->query("kar");  //嘿嘿....
  if (me->query("married"))  //嗯，嫁了
    count = count * 2;
  count = count * 8 / 10;
  if (me->query_temp("moon_set")) count += count / 2;
  me->add_temp("apply/attack", count);
  me->add_temp("apply/damage", count / 2);
  a_attack = count;
  a_damage = count / 2;
  COMBAT_D->do_attack(me, target, weapon);
  me->add_temp("apply/attack", -a_attack);
  me->add_temp("apply/damage", -a_damage);

  message_vision(BLINK + HIW " \n                                   『情恨』\n" NOR, me);
  msg = HIW "                     多情自古伤离别" HIB "－－－－" HIC "更那堪，冷落清秋节！\n" NOR;
  message_vision(msg, me);
  count = me->query("cps");  //嘿嘿....
  if (me->query("divorced"))  //嗯，离了
    count = count * 2;
  count = count * 8 / 10;
  if (me->query_temp("moon_set")) count += count / 2;
  me->add_temp("apply/attack", count);
  me->add_temp("apply/damage", count / 2);
  a_attack = count;
  a_damage = count / 2;
  COMBAT_D->do_attack(me, target, weapon);

  me->add_temp("apply/attack", -a_attack);
  me->add_temp("apply/damage", -a_damage);
  if (me->query("skill_level/whip") == "master" || me->query("skill_level/whip") == "grandmaster") {
    success = 1;
    ap = (int)me->query_skill("moonshentong", 1);
    ap = ap * ap * ap / 1200;
    ap += (int)me->query("combat_exp") / 100;
    dp = target->query("combat_exp") / 100;
    if (random(ap + dp) < dp) success = 0;


    ap2 = (int)me->query_per() * 12;
    dp2 = (int)target->query_cps() * 12;

    if (success && random(ap2 + dp2) > dp2 || wizardp(me))          //let's bt
    {

      message_vision(
        "\n" HIG "情思绵绵，" HIR "情痴深深，" HIW "情恨切切，" NOR + "$N想起昨日种种，不由魂断神伤！\n" NOR,
        target
      );
      for (int times = 0; times < 1 + random(level); times++) {
        target->set_temp("invoker", me);
        COMBAT_D->do_attack(target, target, tar_weapon);

        target->set_temp("invoker", invoker);
      }


      target->start_busy(1);
    }

    message_vision(HIB "\n曲已终，月影散，唯有暗香仍盈袖，莫道不销魂！\n" NOR, me);
  }
  //////////////////下面设为月宫的最终级别pfm，不封上限，必中，
  if (me->query("skill_level/whip") == "grandmaster") {
    if (me->query("moon_looked_liuxingyu") && !random(4) || wizardp(me))

    {
      message_vision(HIC "\n纵然夏日炎，风霜险，积雪千年，也要等到那春到人间\n" NOR, me);
      message_vision(HIC "明知情思牵，情愁添，情火难遣，也要坚持这一身冷艳\n" NOR, me);
      damage = ((int)(me->query_skill("whip", 1) / 12) * (me->query_per()));
      damage = damage / 2 + random(damage / 2);
      damage = damage * 8 / 10;
      if (me->query_temp("moon_set")) damage += damage / 2;
      if (me->is_fighting() && target->is_fighting() &&
        environment(me) == environment(target)) {

        //       target->receive_damage("sen",damage,me);
        //       target->receive_wound("sen", 1+random(damage), me);
        target->receive_damage("kee", damage, me);
        target->receive_wound("kee", 10 + random(damage), me);
        if (!target->is_busy())
          target->start_busy(1 + random(level));

        COMBAT_D->report_status(target, 0);

      }
    }
  }
  if (!target->is_fighting(me)) {
    if (living(target)) {
      if (userp(target)) target->fight_ob(me);
      else target->kill_ob(me);
    }
  }
  if (me->query("skill_level/whip") == "grandmaster")
    me->start_busy(random(3));
  else if (me->query("skill_level/whip") == "master")
    me->start_busy(1 + random(3));
  else if (me->query("skill_level/whip") == "expert")
    me->start_busy(2 + random(2));
  else
    me->start_busy(2 + random(3));

  //	call_out("remove_no_move",3+level,me);
  return 1;
}
/*
void remove_no_move(object me) 
{
  if (me) me->delete_temp("no_move");
}
