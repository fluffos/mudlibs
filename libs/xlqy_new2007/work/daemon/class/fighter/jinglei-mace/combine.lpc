// by bugbug & alading @ 缥缈水云间, 2003-4-5
//一“锏”双雕，written by bugbug,2002.2.12
//结合jinglei-mace & wusi-mace perform.

#include <ansi.h>
#include <combat.h>
inherit SSERVER;

int perform(object me, object target) {
  string msg;
  int bs, skill_mace, skill_jinglei, skill_wusi, parry_target, dodge_target,
    force_mine, force_target, exp_mine, exp_target, damage;
  object weapon_mine, weapon_target;

  bs = 3;
  weapon_mine = me->query_temp("weapon");
  skill_mace = (int)me->query_skill("mace", 1);
  skill_jinglei = (int)me->query_skill("jinglei-mace", 1);
  skill_wusi = (int)me->query_skill("wusi-mace", 1);
  force_mine = (int)me->query("force");
  exp_mine = (int)me->query("combat_exp");
  msg = "";
  if (!objectp(weapon_mine) || (string)weapon_mine->query("skill_type") != "mace")
    return notify_fail("不拿锏怎使鞭法？");
  if (skill_jinglei < 80)
    return notify_fail("你的惊雷鞭法还不够火候！\n");
  if (skill_wusi < 80)
    return notify_fail("你的无私锏还不够火候！\n");

  if (me->query("family/family_name") != "将军府")
    return notify_fail("你是哪儿偷学来的武功，也想用『』?\n");

  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("『一“锏”双雕』只能在战斗中使用。\n");
  if ((int)me->query("force") < 300)
    return notify_fail("你的内力不够。\n");
  weapon_target = target->query_temp("weapon");
  parry_target = (int)target->query_skill("parry");
  force_target = (int)target->query("force");
  dodge_target = (int)target->query_skill("dodge");
  if (!force_target)
    force_target = 1;
  if (!dodge_target)
    dodge_target = 1;
  exp_target = (int)target->query("combat_exp");
  me->add("force", -300);
  me->receive_damage("sen", 20);
  message_vision(
    HIC "$N招式一缓，手中" + weapon_mine->name() + HIC "仿佛挽了千斤似的，使出了惊雷鞭法的绝学！\n\n" NOR,
    me,
    target
  );
  message_vision(CYN "$N气运丹田，平平砸出一锏，慢，却嘶嘶作风雷之声。\n" NOR, me);
  message_vision(CYN "这一招『雷霆薄击』挟着内力，却象密云乍现，惊雷含劲欲发！\n\n" NOR, me);
  if (random(exp_mine) > (int)(exp_target / 10) && random(force_mine) > (int)(force_target / 3)) {
    //force:主要作用。
    msg = HIC "$n只觉得一股劲气象闪电一般，穿体而过！\n"
      "“哇”的一声，$n喷出一大口鲜血，看来是受了内伤！\n\n" NOR;
    damage = force_mine / force_target * 100 - 80;
    damage = damage * 8 / 10;
    if (damage < 1) damage = 1;
    if (damage > 20) damage = 20;
    if (me->query_temp("jjf_set")) damage += damage / 2;
    //		tell_object(me, sprintf( GRN "DAMAGE(1-->20)：%d\n" NOR,damage));
    target->receive_damage("kee", me->query("max_force") * damage / 40, me);
    target->receive_wound("kee", me->query("max_force") * damage / 50, me);
    message_vision(msg, me, target);
    COMBAT_D->report_status(target);
  } else {
    msg = HIC "$n忙运功向抗，深厚的内力将$N的攻势都激散了。\n\n" NOR;
    message_vision(msg, me, target);
  }
  message_vision(CYN "$N由静转动，一动便急如风，脚踏奇门，锏走奇招，锏锏从$n意想不到的方位无声无息地砸出！\n" NOR, me, target);
  message_vision(CYN "这一招『天雷荡邪』好似天公作怒，要把天下妖孽尽数劈死，使得个痛快淋漓\n\n" NOR, me, target);
  if (random(skill_jinglei) > parry_target / 3) {
    //jinglei_mace:主要作用
    msg = HIC "$n马上手忙脚乱，不知该如何去招架这静若水、快如电的锏法！\n"
      "果不然，$N的" + weapon_mine->name() + HIC "招招命中，$n浑身上下被砸的遍体鳞伤！\n\n" NOR;
    if (target->query_str())
      damage = (me->query_str() / target->query_str()) * 100 - 90;
    else
      damage = 30;
    damage = damage * 8 / 10;
    if (damage < 1) damage = 1;
    if (damage > 30) damage = 30;
    if (me->query_temp("jjf_set")) damage += damage / 2;
    //      tell_object(me, sprintf( GRN "DAMAGE(1-->30)：%d\n" NOR,damage));
    target->receive_damage("kee", me->query("max_force") * damage / 40, me);
    target->receive_wound("kee", me->query("max_force") * damage / 50, me);
    message_vision(msg, me, target);
    COMBAT_D->report_status(target);
  } else {
    msg = HIC "$n却心静如水，丝毫不显慌乱，见招拆招，瓦解了$N这无声的攻势。\n\n" NOR;
    message_vision(msg, me, target);
  }

  msg = HIC "\n$N意犹未尽，使出无私锏中的“锁”字决，打得$n措手不及！\n";
  message_vision(msg, me, target);
  if (weapon_target) {
    msg = HIC "$N手中" + weapon_mine->name() + "" HIC "迎面一架，斜刺一拉，好一招「万刃归一」!\n$N手中"
      +weapon_mine->name() + "" HIC "正好锁在$n的" + weapon_target->name() + "上。\n";
    message_vision(msg, me, target);
  }
  if (random(skill_wusi) > dodge_target / 3) {
    //wusi_mace:主要作用
    me->add("force", -150);
    bs = 1;
    if (weapon_target) {
      msg = HIW "\n $N顿时觉得一股强大的力量传向自己的手腕，手中";
      msg += weapon_target->name();
      msg += "脱手飞出! \n" NOR;
      weapon_target->unequip();
      weapon_target->move(environment(me));
      destruct(weapon_target);
      message_vision(msg, target, me);
      target->start_busy(2);
    } else {
      msg = HIW "\n$N猝不及防，竟忘了进攻！\n";
      target->start_busy(4);
      message_vision(msg, target);
    }
  } else {
    msg = HIC "$n看破了这招的虚实，将计就计，假装冲上前，却在$N出锏的一瞬间腾空跃开，回手竟反攻一招！\n\n" NOR;
    message_vision(msg, me, target);
    COMBAT_D->do_attack(target, me, weapon_target);
  }
  me->start_busy(bs);
  return 1;
}
