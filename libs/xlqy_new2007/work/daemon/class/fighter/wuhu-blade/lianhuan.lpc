// by bugbug & alading @ 缥缈水云间, 2003-4-5

#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target) {

  string str;
  string dodskill, msg;
  string level;
  int effect;
  int extra; int tmp;
  object weapon, ob;
  int bs = 0;

  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("［计出连环］只能对战斗中的对手使用。\n");

  if (me->query("family/family_name") != "将军府")
    return notify_fail("“计出连环”只有将军府才可以用！\n");

  if (!(ob = me->query_temp("weapon"))
    || (string)ob->query("skill_type") != "blade")
    return notify_fail("你必须先找一把刀才行。\n");

  tmp = me->query_skill("wuhu-blade", 1);
  extra = me->query_skill("lengquan-force", 1);

  if (extra < 100) return notify_fail("你的［冷泉神功］还不够纯熟！\n");

  if (tmp < 100) return notify_fail("你的［五虎断门刀法］还不够纯熟！\n");

  if ((int)me->query("max_force") < 1000)
    return notify_fail("你的内功太差。\n");

  if ((int)me->query("force") < 500)
    return notify_fail("你的内力不够了。\n");

  tmp /= 2;
  tmp = tmp * 8 / 10;
  if (me->query_temp("jjf_set")) tmp += tmp / 2;
  extra /= 2;
  extra = extra * 8 / 10;
  if (me->query_temp("jjf_set")) extra += extra / 2;
  weapon = me->query_temp("weapon");
  me->add_temp("apply/attack", tmp);
  me->add_temp("apply/damage", extra);

  if (me->query_skill("wuhu-blade", 1) > 100) {
    msg = BLINK "" + HIR "\n［十面埋伏］$N手中" + weapon->query("name") + "直劈$n！\n" NOR;
    message_vision(msg, me, target);
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR);

    msg = BLINK "" + HIY "［围魏救赵］$N手中" + weapon->query("name") + "斜刺$n！\n" NOR;
    message_vision(msg, me, target);
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);

    msg = BLINK "" + HIW "［暗渡陈仓］ $N手中" + weapon->query("name") + "平削$n！\n" NOR;
    message_vision(msg, me, target);
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);

    bs = 2;
  }

  me->add_temp("apply/attack", tmp / 4);

  if (random(me->query_skill("wuhu-blade", 1)) > 120) {
    msg = BLINK "" + HIG "［釜底抽薪］ $N手中" + weapon->query("name") + "横砍$n！\n" NOR;
    message_vision(msg, me, target);
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);

  }
  if (random(me->query_skill("wuhu-blade", 1)) > 140) {
    msg = BLINK "" + HIC "［借刀杀人］ $N手中" + weapon->query("name") + "反撩$n！\n" NOR;
    message_vision(msg, me, target);
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);

    bs = 3;
  }
  if (random(me->query_skill("wuhu-blade", 1)) > 160) {
    msg = BLINK "" + HIR "［反客为主］ $N手中" + weapon->query("name") + "加紧，旋风般向$n杀去！\n" NOR;
    message_vision(msg, me, target);
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);

    if (random(4) == 1) {
      bs = 0;  //lucky,no extra busy.
    }
  }
  level = me->query("skill_level/blade");
  if (level == "expert") {

    effect = me->query_skill("blade");
    effect = effect * 8 / 10;

    me->add_temp("apply/strength", effect / 15);
    me->add_temp("apply/damage", effect / 10);
    msg = BLINK "" + HIM "［声东击西］ $N手中" + weapon->query("name") + "虚劈，拐弯向$n剁去！\n" NOR;
    message_vision(msg, me, target);
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_QUICK, msg);
    me->add_temp("apply/strength", -effect / 15);
    me->add_temp("apply/damage", -effect / 10);

  } else if (level == "master") {
    effect = me->query_skill("blade");
    effect = effect * 8 / 10;

    me->add_temp("apply/strength", effect / 12);
    me->add_temp("apply/damage", effect / 8);
    msg = BLINK "" + HIM "［声东击西］ $N手中" + weapon->query("name") + "虚劈，拐弯向$n剁去！\n" NOR;
    message_vision(msg, me, target);
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_QUICK, msg);
    msg = BLINK "" + HIY "［以逸待劳］ $N手中" + weapon->query("name") + "轻晃，写意般向$n挥去！\n" NOR;
    message_vision(msg, me, target);
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_QUICK, msg);
    me->add_temp("apply/strength", -effect / 12);
    me->add_temp("apply/damage", -effect / 8);

  } else if (level == "grandmaster") {

    effect = me->query_skill("blade");
    effect = effect * 8 / 10;

    if (me->query_temp("jjf_set")) effect += effect / 2;
    me->add_temp("apply/strength", effect / 10);
    me->add_temp("apply/damage", effect / 6);
    msg = BLINK "" + HIM "［声东击西］ $N手中" + weapon->query("name") + "虚劈，拐弯向$n剁去！\n" NOR;
    message_vision(msg, me, target);
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_QUICK, msg);
    msg = BLINK "" + HIY "［以逸待劳］ $N手中" + weapon->query("name") + "轻晃，写意般向$n挥去！\n" NOR;
    message_vision(msg, me, target);
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_QUICK, msg);
    msg = BLINK "" + HIG "［擒贼擒王］ $N手中" + weapon->query("name") + "排山倒海向$n舞去！\n" NOR;
    message_vision(msg, me, target);
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_QUICK, msg);

    me->add_temp("apply/strength", -effect / 10);
    me->add_temp("apply/damage", -effect / 6);

  }
  if ((target->query("eff_kee") < 0 || !living(target))) {
    if (!random(20)) {
      str = target->name() + "在将军府绝学" NOR + HIY "" + BLINK "「计出连环」" NOR + HIM "威猛无匹的刀法下，连中数刀，被" + HIG "" + me->name() + "" + HIM "送去了阎罗地府。";
      message("channel:rumor", HIM "【空穴来风】某人：" + str + "\n" NOR, users());
    }
  }

  msg = "\n" NOR;
  message_vision(msg, me, target);

  me->add_temp("apply/attack", -tmp / 4);
  me->add_temp("apply/attack", -tmp);
  me->add_temp("apply/damage", -extra);

  me->start_busy(2 + random(bs));
  return 1;
}
