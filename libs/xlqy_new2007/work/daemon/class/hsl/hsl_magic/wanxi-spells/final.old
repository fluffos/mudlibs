// 作者：tonii@飘渺水云间，2003-4-26于浙大，修改请保留此行。
//【万息降临法】之强力攻击cast【最终制裁】
// 伤害对方气血和精神

#include <ansi.h>

inherit SSERVER;

int cast(object me, object target)
{

       int success_adj=140;
	int damage_adj=120;
       int success=0;
       int damage=0;
       int coef=1;
       int skill_wanxispells=0;
       string msg="";
       string str;

      if(me->query("family/family_name")!="幻世魔导")
               return notify_fail("非幻世魔导不能使用此项技能！\n");

	if( !target ) target = offensive_target(me);

	if( !target
	||      !target->is_character()
	||      target->is_corpse()
	||      target==me)
		return notify_fail("你要对谁施展「最终制裁」？\n");

       if((int)me->query_skill("wanxi-spells",1)<150)
              return notify_fail("你对万息降临术研习不够，尚未领悟「最终制裁」！\n");

	if((int)me->query("mana") < 500+(int)me->query("mana_factor") )
		return notify_fail("你的法力不够！\n");

	if((int)me->query("sen") < 800 )
		return notify_fail("使用「最终制裁」需要强大的精神力量！\n");

	me->add("mana", -200-(int)me->query("mana_factor"));
	me->receive_damage("sen", 200);

       msg=HIC"$N表情肃杀，调动自身强大的精神力量，使出万息降临法的
 终极招式「最终制裁」！
 这是聚集奥林匹斯山十二主神之力量，向$n作出的末日审判！\n"NOR;
       message_vision(msg,me,target);

       //调用spelld的成功判断函数
       success=SPELL_D->attacking_cast_success(me, target, success_adj);
       if(success)
       {
                 coef=1; 
           skill_wanxispells=(int)me->query_skill("wanxi-spells",1);
           if(random(3)==1)
                 coef=2;
           if(coef==2&&random(2*skill_wanxispells)>skill_wanxispells+100)
                 coef=3;

           if(coef==1)
                 msg=HIW"
	 ──┬──  
	  ┌ │ ┐     
	  │ │ │     
	    ╱╲       
	  ╱    ╲     \n\n"NOR;
           if(coef==2)
                 msg=HIW"
	         ┐        
	   ─┼─│╲    
	 └─┴─┼─┘   
	   ─┴─│      
	   ╱    │ ╱   
	   │╲/  ╳     
	   │  ╲   ╲   \n\n"NOR;
           if(coef==3)
                 msg=HIW"
	           ▃
	           ▕█▍
	           ▕█▍    ◢██◣
	          ◢██▌◢█◤▕█▎
	      ▄███◤▕██▌ █▍
	  ▕█████▌◢██▎█▍
	    ◥█◤▕██◤◢▋  █▆
	          ◢█◤▕█▏   ◥█
	        ▁██◢▇█▄▁ ▕█
	       ███▎◢▉ ◥█▅█▍
	      ▕██▊ █▌    ███◣
	        ◤ █▍█ ▅▆█◤◥██▅
	          ◥▌◤  ◥◤     ◥█◤\n\n"NOR;
            message_vision(msg, me, target);

           //调用spelld的伤害计算函数
           damage=SPELL_D->attacking_cast_damage(me, target, damage_adj);
           if(damage>0)
           {
                if(coef==1){
                      msg=HIR"结果正中$n，$n身受创伤，脸色苍白！\n\n"NOR;
                      //调用spelld的伤害实施函数
                     SPELL_D->apply_damage(me,target,damage,"both",msg);
                 }
                if(coef==2){
                     if(damage<150)   damage = 150;
                     damage = damage*9/5;
                     msg=HIR"结果正中$n，$n身受重创，为此强大力量所震撼！\n\n"NOR;
                     SPELL_D->apply_damage(me,target,damage,"both",msg);
                 }
                if(coef==3){
                     if(damage<250)   damage = 250;
                     msg=HIR"$n在这充满烈火与极光、愤怒与诅咒、融合众神之力量的
 末日审判面前，无丝毫之力与其抗衡，身心都受到了巨大创伤！\n\n"NOR;
                     damage = damage*5/2;
                     SPELL_D->apply_damage(me,target,damage,"both",msg);  
                     if (target->query("eff_kee")<0 || !living(target))  {
                         str=target->name()+"被"+me->name()+"用幻世魔光「"HIW"最终制裁·极"NOR+HIM"」杀死了。听说这是众神愤怒的末日审判！\n"NOR;
	                message("channel:rumor",HIM"【空穴来风】某人："+str+"\n"NOR,users());
                     }
                 }
             }
             else   //不会被反击
             {
                     if(coef==3)//如果是“极”，则不能被挡住
                    {
                     damage = 250;
                     msg=HIR"$n在这充满烈火与极光、愤怒与诅咒、融合众神之力量的
 末日审判面前，无丝毫之力与其抗衡，身心都受到了巨大创伤！\n\n"NOR;
                     damage = damage*5/2;
                     SPELL_D->apply_damage(me,target,damage,"both",msg);  
                     if (target->query("eff_kee")<0 || !living(target))  {
                         str=target->name()+"被"+me->name()+"用幻世魔光「"HIW"最终制裁·极"NOR+HIM"」杀死了。听说这是众神愤怒的末日审判！\n"NOR;
	                message("channel:rumor",HIM"【空穴来风】某人："+str+"\n"NOR,users());
                     }
                     }
                     else
                     {
             		 msg=HIG"$n调动自身的法力与精神力量，同$N的魔光作出拼死一搏，
竟硬生生挡住了$N的法术！\n"NOR;
                     message_vision(msg, me, target);
                     }
              }
       }
       else 
       {
        msg=HIG"$n借助法术的力量使自身进入虚无状态，$N便失去了制裁的目标！\n"NOR;
        message_vision(msg, me, target);
       }

 	me->start_busy(2);
       target->kill_ob(me);
	return 4+random(4);
}