//【万息降临法】之【地灵圣护】
//加armor，加dodge，减attack

#include <ansi.h>
 
inherit F_DBASE;
inherit SSERVER;
 
void remove_effect(object,int,int,int);
 
int cast(object me, object target)
{
        int armor_amount,dodge_amount,attack_amount,skill_spells;

        if(me->query("family/family_name")!="幻世魔导")
               return notify_fail("非幻世魔导不能使用此项技能！\n");

        if (me->query_skill("wanxi-spells",1)<60)
                return notify_fail("你对万息降临法研习还不够，尚未领悟到「地灵圣护」！\n");

        if (me->query_skill_mapped("force")!="wanxi-force")
                return notify_fail("「地灵圣护」必须配合万息集气术才能使用。\n");

        if ((int)me->query("mana")<200)
                return notify_fail("你的法力不够，无法使用「地灵圣护」！\n");
        if ((int)me->query("kee")<200)
                return notify_fail("你的体力这么差，还是先休息一会儿吧！\n");
        if ((int)me->query("sen")<200)
                return notify_fail("你的精神太差，无法使用「地灵圣护」！\n");
        if ((int)me->query_temp("powerup"))
                return notify_fail("地之精灵已经守护着你了！\n");
        
        me->receive_damage("kee",50);
        me->receive_damage("sen",50);
        me->add("mana", -100);
        message_vision(
                YEL"$N低声念了一句咒语，召唤出地之精灵，开始守护$N！\n" NOR, me);
        
        skill_spells=(int)me->query_skill("wanxi-spells",1);
        attack_amount=skill_spells*random(3)/10;
        armor_amount=skill_spells/3;
        dodge_amount=skill_spells*(3+random(3))/10; 
if(me->query_temp("magic_set")) {
armor_amount += armor_amount/2;
dodge_amount += dodge_amount/2;
attack_amount -= attack_amount/2;
}
        me->add_temp("apply/attack", -attack_amount);  
        me->add_temp("apply/armor",armor_amount);
        me->add_temp("apply/dodge",dodge_amount);  
        me->set_temp("powerup", 1);
        me->start_call_out( (: call_other, __FILE__, "remove_effect", 
           me, armor_amount,dodge_amount,attack_amount:), (int)skill_spells/2);
 
         return (1+random(3));
}
 
void remove_effect(object me, int armor_amount,int dodge_amount,int attack_amount)
{
        me->add_temp("apply/dodge", -dodge_amount);
        me->add_temp("apply/armor",-armor_amount);
        me->add_temp("apply/attack", attack_amount);
        me->delete_temp("powerup");
        message_vision(YEL"地之精灵说了声：“我先走了。”就钻入地底不见了。\n"NOR,me);
}

