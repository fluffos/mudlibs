// 【万息降临法】之【召唤炽焰鸟】
// 炽焰鸟使用cast fire攻击


inherit SSERVER;

int cast(object me, object target) {
  int invocation_time;
  object soldier;
  if (me->query("family/family_name") != "幻世魔导")
    return notify_fail("非幻世魔导不能召唤炽焰鸟！\n");

  if (!me->is_fighting())
    return notify_fail("只有战斗中才能召唤炽焰鸟。\n");

  invocation_time = (200 - (int)me->query_skill("spells"));
  if (invocation_time < 30) invocation_time = 30;
  if ((time() - me->query("last_invocation")) < invocation_time)
    return notify_fail("你刚叫过炽焰鸟，他都被你叫烦了！\n");

  if ((int)me->query("mana") < 150)
    return notify_fail("你的法力不够了！\n");

  if ((int)me->query("sen") < 80)
    return notify_fail("你的精神无法集中！\n");

  message_vision("$N喃喃地念了几句咒语。\n", me);

  me->add("mana", -150);
  me->receive_damage("sen", 80);

  if (random(me->query("max_mana")) < 250) {
    message("vision", "但是什么也没有发生。\n", environment(me));
    return 1;
  }

  seteuid(getuid());
  soldier = new("/obj/npc/firebird");
  soldier->move(environment(me));
  soldier->invocation(me);
  soldier->set_temp("invoker", me);
  soldier->set_temp("apply/attack", 50);
  soldier->set_temp("apply/damage", 50);
  me->set("last_invocation", time());
  me->start_busy(2 + random(2));
  //       target->kill_ob(me);
  return 6 + random(5);
}
