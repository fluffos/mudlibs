//【万息降临法】之【瞬间移动】（逃跑技）

#include <ansi.h>

inherit SSERVER;

int cast(object me, object target) {
  string msg, start;
  int ap, dp, success;
  target = offensive_target(me);

  if (me->query("family/family_name") != "幻世魔导")
    return notify_fail("非幻世魔导不能使用此项技能！\n");


  if (me->is_busy())
    return notify_fail("你正忙着呢，先应付眼前的事吧。\n");

  if ((int)me->query("mana") < 100)
    return notify_fail("你的法力不够了！\n");

  if ((int)me->query("sen") < (int)me->query("max_sen") / 5)
    return notify_fail("你精神太差，无法完成瞬间移动！\n");

  if ((int)me->query_skill("wanxi-spells", 1) < 40)
    return notify_fail("你尚未领悟到瞬间移动的奥秘。\n");

  if (me->query_temp("in_tiaozhan"))
    return notify_fail("你还在挑战中，怎么能离开呢？\n");

  ap = me->query_skill("spells") + me->query("max_mana") / 10;
  if (target) dp = target->query_skill("spells") + target->query("max_mana") / 10;

  if (!me->is_fighting()) {
    message_vision(HIW "$N低声念了句咒语，召唤出时空之门，随后迅速闪入门内消失了。\n" NOR, me);
    me->add("sen", -me->query("max_sen") / 8);
    me->add("mana", -80);
    success = 1;
  } else {
    msg = HIW "激战中，$N突然念了声咒语，召唤出时空之门。\n" NOR;
    if (random(ap + dp) > dp / 2) {
      msg += HIC "$N迅捷无比地闪入时空门中，时空门随即消失了。\n" NOR;
      me->add("sen", -me->query("max_sen") / 6);
      me->add("mana", -50);
      success = 1;
    } else msg += HIR "但$n以闪电般地速度堵在了门口，不让$N进入，时空之门随即消失了。\n" NOR;
    me->add("mana", -50);
    message_vision(msg, me, target);
  }
  if (success) {
    start = "/d/hsl/moanlake";
    me->move(start);
    message("vision", HIY "突然面前出现一道时空之门，" + me->name() + "从里面一闪而出。\n" NOR,
      environment(me), me);
    tell_object(me, HIW "你从时空走廊的另一端门一闪而出。\n" NOR);
    return 3 + random(3);
  }
  return 5 + random(5);
}
