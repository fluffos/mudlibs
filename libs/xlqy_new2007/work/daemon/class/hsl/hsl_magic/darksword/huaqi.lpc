// 作者： tonii@ 缥缈水云间, 2003-4-29于浙大，修改请保留此行。
//【暗黑蚀魂剑】之【化气】
// 伤害对方气血为我所用

#include <ansi.h>
#include <combat.h>
inherit SSERVER;

int perform(object me, object target) {
  int damage;
  int ap, dp;
  string msg;

  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要对谁施展这一招「化气」？\n");

  if (me->query("family/family_name") != "幻世魔导")
    return notify_fail("非幻世魔导不能使用此项技能！\n");

  if (!me->is_fighting())
    return notify_fail("「化气」只能在战斗中使用！\n");
  if (me->query_skill("darksword", 1) < 50)
    return notify_fail("你的暗黑蚀魂剑等级不够，尚未领悟到这个绝招！\n");
  if (me->query("kee") < 100)
    return notify_fail("你的体力太差了，不能使用「化气」！");
  if (me->query("force") < 300)
    return notify_fail("你的内力不够，无法发出「化气」！");
  if (me->query_temp("no_darksword_huaqi") > time())
    return notify_fail("你不能连续使用「化气」！\n");
  me->set_temp("no_darksword_huaqi", time() + 5);

  ap = (int)me->query_skill("sword");
  if (ap > 1000) ap = ap / 100 * ap * ap / 10 + me->query("combat_exp") / 200 + me->query("daoxing") / 200;
  else ap = ap * ap * ap / 1000 + me->query("combat_exp") / 200 + me->query("daoxing") / 200;
  dp = (int)target->query_skill("force") + (int)target->query_skill("parry") / 2;
  dp = dp * dp * dp / 8000 + target->query("combat_exp") / 100;

  damage = (int)me->query_skill("sword") + me->query("force_factor");
  damage = random(damage) + 50;
  damage = damage * 8 / 10;
  if (me->query_temp("magic_set")) {
    ap += ap / 2;
    damage += damage / 2;
  }

  msg = HIR "$N的剑尖距离$n大约尚有一尺之时，突然剑体发出诡异的红光，闪烁跳跃！\n\n" NOR;
  message_vision(msg, me, target);

  if (random(ap * 4 / 3 + dp) > dp || wizardp(me))  //modifyed by dogdog, ap->ap*4/3
  {

    msg = RED "$n突然感觉体力源源不断地流失！\n\n" NOR;
    message_vision(msg, me, target);
    target->receive_damage("kee", damage);
    target->receive_wound("kee", damage / 2);
    if (me->query("kee") < me->query("max_kee") - 30 || me->query("eff_kee") != me->query("max_kee")) {
      msg = HIY "$N将吸收来的力气化为己用，脸色红润了许多！\n\n" NOR;
      message_vision(msg, me, target);
      me->receive_heal("kee", damage / 2);
      me->receive_curing("kee", damage / 4);
    }
    if (random(2) > 0 || wizardp(me)) {  //added by dogdog
      msg = HIR "$N忽感神灵之力量，又生一招，携着黑暗之气。。。\n\n" NOR;
      message_vision(msg, me, target);
      me->add_temp("apply/damage", 8 * me->query_skill("sword", 1) / 40);
      COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR);
      me->add_temp("apply/damage", -8 * me->query_skill("sword", 1) / 40);
    }
    if ((me->query_skill(
      "darksword",
      1
    ) > 150 && me->query_skill("sword", 1) > 150 && random(10) > 6) || wizardp(me)) {
      msg = HIW "$N一声轻啸，身随剑起，集中全身力量刺出一剑。\n\n" NOR;
      message_vision(msg, me, target);
      damage = me->query_skill("darksword", 1);
      damage = damage * 8 / 10;
      me->add_temp("apply/attack", damage / 5);
      me->add_temp("apply/damage", damage / 4);
      me->add_temp("apply/defense", -damage / 3);
      COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR);
      me->add_temp("apply/defense", damage / 3);
      me->add_temp("apply/damage", -damage / 4);
      me->add_temp("apply/attack", -damage / 5);
    }
  } else {
    msg = HIC "$N屏气敛息，同时催动内力使身体四周形成一道金光护体，
$N的绝招失败了！\n\n" NOR;
    message_vision(msg, me, target);
    me->start_busy(1 + random(2));
  }
  if (!target->is_fighting(me)) {
    if (living(target)) {
      if (userp(target)) target->fight_ob(me);
      else target->kill_ob(me);
    }
  }
  me->add("force", -50 - me->quey("force_factor"));
  return 2 + random(3);
}
