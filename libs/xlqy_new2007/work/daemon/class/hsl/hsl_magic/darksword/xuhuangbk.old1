// 作者： tonii@ 缥缈水云间, 2003-4-28于浙大，修改请保留此行。
//【暗黑蚀魂剑】之【虚晃斩】
//busy+attack

#include <ansi.h>
#include <combat.h>
inherit SSERVER;

int perform(object me, object target)
{
     int i,dp2,lv2;
int lv,l,ret;
        int ap,dp;
        string msg;
        object weapon;

        if( !target ) target = offensive_target(me);
        if( !target
        ||      !target->is_character()
        ||      target->is_corpse()
        ||      target==me)
        return notify_fail("你要对谁施展这一招「虚晃斩」？\n");

      if(me->query("family/family_name")!="幻世魔导")
               return notify_fail("非幻世魔导不能使用此项技能！\n");

        if(!me->is_fighting())
                return notify_fail("「虚晃斩」只能在战斗中使用！\n");
        if( me->query_skill("darksword",1) < 50)
               return notify_fail("你的暗黑蚀魂剑等级不够，尚未领会到这个绝招！\n");
        if(me->query("kee")<100)
               return notify_fail("你的体力太差了，不能使用「虚晃斩」！");
        if(me->query("force")<300)
               return notify_fail("你的内力不够，无法发出「虚晃斩」！");
        if(me->query_temp("no_darksword_xuhuang")>time())
			return notify_fail("「虚晃斩」多用对方就会看穿的！\n");
		me->set_temp("no_darksword_xuhuang",time()+5);

        weapon=me->query_temp("weapon");
     
        ap=(int)me->query_skill("sword");
        ap=ap*ap*ap/1000+me->query("combat_exp")/100;
        dp=(int)target->query_skill("parry")+(int)target->query_skill("dodge")/2;
        dp=dp*dp*dp/5000+target->query("combat_exp")/100;
        
        msg=HIW"「虚晃斩」！\n$N左一剑、右一剑、上一剑、下一剑，连出四剑，却是四招空招！\n\n"NOR;
        message_vision(msg, me, target);
   if(random(5/2*ap+dp)>dp)
        {
             target->start_busy(2+random(3));
              msg = HIR"$n一愣，$N突然化剑为刀，“唿！”“唿！”连劈四剑！\n"NOR+HIW"       这才是致命的杀招\n" NOR;
              message_vision(msg, me, target);
             for(i=0;i<4;i++)
              COMBAT_D->do_attack(me,target,weapon,TYPE_REGULAR);
       me->start_busy(1+random(3));
         }
         else
         {
              msg=HIC"$n异常小心地退后两步，静观$N进一步动作，$N的绝招落空了！\n"NOR;
              message_vision(msg, me, target);
             me->start_busy(2+random(2));
          }
        me->add("force",-100);
lv=1;
ret = 0;
lv2 = 1;
if(me->query("skill_level/spells")=="expert")
lv2 = 2;
else if(me->query("skill_level/spells")=="master")
lv2 = 3;
 else if (me->query("skill_level/spells")=="grandmaster")
lv2=4;
if(me->query("skill_level/sword")=="expert")
lv=2;
else if(me->query("skill_level/sword")=="master")
lv=3;
else if (me->query("skill_level/sword")=="grandmaster")
 lv=4;
l = (int)me->query_skill("literate",1);
if((int)me->query_skill("wanxi-spells",1)<150)
ret++;
if((int)me->query_skill("literate",1)< 100)
ret++;
if((int)me->query("mana") < 500+(int)me->query("mana_factor") )
ret++;
if((int)me->query("sen") < 800 )
ret++;
if (l < 300)
 ret ++;
if (lv < 3 || lv2 <3)
ret ++;
if (ret > 0 && !wizardp(me))
     return 4+random(3);
ap=me->query_skill("wanxi-spells");
ap=ap*ap*ap/1200;
ap+=(int)me->query("combat_exp")/100;
dp=(int)target->query_skill("spells")/2+(int)target->query_skill("parry")/2;
 dp=dp*dp*dp/1200;
dp+=(int)target->query("combat_exp")/100;
dp2=target->query_cps();
dp2=dp2*dp2*dp2/10;
dp+=dp2;
if (random(lv*lv2/6*ap+dp)<=dp)
   ret++;
if (ret == 0 || wizardp(me))
{
    if( living(target))
         { 
          if (me->is_busy())
               me->start_busy(1);
             me->kill_ob(target);
          call_out("mycastfinal",1,me);
           msg=HIR"\n$N正茫然间，忽感应来自神灵的力量，浑身一振，能量瞬间激发！\n"NOR;
           message_vision(msg,me,target);
         if(random(10)>7)
          me->command("chat* 高举双臂，大声呼喊:伟大的宙斯,请赐予我力量吧!让我战胜这世界的邪恶!");
          }
       }else   
       return  4+random(3);
}
void mycastfinal(object me)
{
     me->command("cast final");
}






