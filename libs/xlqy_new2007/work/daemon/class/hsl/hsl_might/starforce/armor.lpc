#include <ansi.h>

inherit F_CLEAN_UP;

void remove_effect(object me, int amount);

int exert(object me, object target) {
  //return notify_fail("这项功能目前不能使用！\n");

  int skill;
  if (target != me)
    return notify_fail("你只能用辰星灵云壁保护自己。\n");

  if ((int)me->query_skill("starforce", 1) < 100)
    return notify_fail("你的辰星灵云壁还不够级别，再使劲也没有用啊!\n");
  if ((int)me->query("force") < 100)
    return notify_fail("你的内力不够。\n");
  if ((int)me->query("kee") < 50)
    return notify_fail("你的气血不足。\n");
  if ((int)me->query("sen") < 50)
    return notify_fail("你的精神不足。\n");
  if ((int)me->query_temp("powerup"))
    return notify_fail("你已经在运功中了。\n");

  skill = me->query_skill("force");
  if (me->query_temp("might_set")) skill += skill / 2;

  me->add("force", -100);
  me->receive_damage("kee", 30);
  me->receive_damage("sen", 30);

  message_vision(
    HIC "$N运用辰星灵云壁的精髓，化自然万物为周身屏障。\n" NOR, me);

  //效果比dragonforce略差
  me->add_temp("apply/armor", skill / 4);
  me->set_temp("powerup", 1);

  me->start_call_out((: call_other, __FILE__, "remove_effect", me, skill / 4 :), skill);

  if (me->is_fighting()) me->start_busy(3);

  return 1;
}

void remove_effect(object me, int amount) {
  me->add_temp("apply/armor", -amount);
  me->delete_temp("powerup");
  tell_object(me, "你的辰星灵云壁护身效果渐渐退去。\n");
  return;
}
