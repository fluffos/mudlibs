//作者：tonii@飘渺水云间，2003-4-23于浙大，修改请保留此行。
//【千羽风灵术】之【风逝无形】（逃跑技）

#include <ansi.h>

inherit SSERVER;

int cast(object me, object target) {
  string msg, start;
  int ap, dp, success;
  target = offensive_target(me);

  if (me->query("family/family_name") != "幻世勇者")
    return notify_fail("非幻世勇者不能使用此项技能！\n");


  if (me->is_busy())
    return notify_fail("你正忙着呢，先应付眼前的事吧。\n");

  if ((int)me->query("mana") < 100)
    return notify_fail("你的法力不够了！\n");

  if ((int)me->query("sen") < (int)me->query("max_sen") / 5)
    return notify_fail("你精神太差，难以化风而逝。\n");

  if ((int)me->query_skill("windspells", 1) < 40)
    return notify_fail("你尚未领悟到风逝无形的奥秘。\n");

  if (environment(me)->query("under_water"))
    return notify_fail("你在水中，无法化风而逝\n");

  if (me->query_temp("in_tiaozhan"))
    return notify_fail("你还在挑战中，怎么能离开呢？\n");

  ap = me->query_skill("spells") + me->query("max_mana") / 10;
  if (target) dp = target->query_skill("spells") + target->query("max_mana") / 10;

  if (!me->is_fighting()) {
    message_vision(HIW "$N低声念了一句咒语，身形突然化作轻烟融入风中消失了。\n" NOR, me);
    me->add("sen", -me->query("max_sen") / 8);
    me->add("mana", -80);
    success = 1;
  } else {
    msg = HIW "激战中，$N突然腾空而起，念了一句咒语，身形化作轻烟融入风中消失了。\n" NOR;
    if (random(ap + dp) > dp / 2) {
      msg += HIG "只听远远传来一声轻叹，便不再可寻任何踪迹。\n" NOR;
      me->add("sen", -me->query("max_sen") / 6);
      me->add("mana", -50);
      success = 1;
    } else msg += HIR "但$n也同时腾空而起，顺着风向赶在$N的前头，拦了下来。\n" NOR;
    me->add("mana", -50);
    message_vision(msg, me, target);
  }
  if (success) {
    start = "/d/hsl/moanlake";
    me->move(start);
    message("vision", HIM "突然一股清风吹来，风中飘出一股轻烟，渐渐化为人形，正是" + me->name() + "。\n" NOR,
      environment(me), me);
    tell_object(me, HIW "你的身影随着一股清风突然出现。\n" NOR);
    return 3 + random(3);
  }
  return 5 + random(5);
}
