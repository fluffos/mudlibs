//【千羽风灵术】之【翔天刃风击】

#include <ansi.h>

inherit SSERVER;

int ap, ap1, ap2, dp, dp1, dp2, damage;

int cast(object me, object target) {
  int damage;
  object weapon;

  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要对谁使用翔天刃风击？\n");

  if (me->query("family/family_name") != "幻世勇者")
    return notify_fail("非幻世勇者不能使用此项技能！\n");


  /*        if (!target->is_fighting(me))
               return notify_fail("只有在战斗中才能使用翔天刃风击！\n");
  */
  weapon = me->query_temp("weapon");
  if (!weapon) return notify_fail("翔天刃风击要配合斧术才能使用！\n");
  if ((string)weapon->query("skill_type") != "axe")
    return notify_fail("翔天刃风击是千羽风灵术和斧术相配合的绝招！\n");

  if ((int)me->query("kee") < 300)
    return notify_fail("你体力不足，无法使用翔天刃风击！\n");

  if ((int)me->query("force") < 300)
    return notify_fail("你须运足内力才能使用翔天刃风击！\n");

  if ((int)me->query_skill("windspells", 1) < 100)
    return notify_fail("你的千羽风灵术还不够纯熟。\n");

  if ((int)me->query("mana") < 500)
    return notify_fail("你的法力不足以使用翔天刃风击！\n");

  message_vision(HIW "[翔天刃风击]！$N向着天空抛出手中兵刃，呼唤出一股强大的龙卷风，
夹杂着这柄消失了的利器，向$n凶猛地袭去！\n" NOR, me, target);

  ap = (int)me->query_skill("axe") + (int)me->query_skill("spells") + (int)me->query_skill("force");
  dp = (int)target->query_skill("dodge") + (int)target->query_skill("parry");
  ap1 = (int)me->query("combat_exp") / 1000 + (int)me->query("daoxing") / 1000;
  dp1 = (int)me->query("combat_exp") / 500;
  ap2 = (int)me->query_cps();
  dp2 = (int)target->query_cps();
  damage = random((int)me->query_skill("spells")) + random((int)me->query_skill("axe")) + random((int)me->query_skill("force"));
  damage = damage * 8 / 10;

  if (random(ap + dp) > dp) {
    if (random(ap1 + dp1) > dp) {
      if (random(ap2 + dp2) > dp2) {
        target->receive_damage("kee", 2 * damage);
        target->receive_wound("kee", damage);
        message_vision(RED "$n茫然无措，不知何从躲闪，结果被狂风正面扫中，
又被风中暗藏的兵刃杀伤，状况十分糟糕！\n" NOR, me, target);
      } else {
        target->receive_damage("kee", damage);
        target->receive_wound("kee", damage / 2);
        message_vision(HIR "$n慌乱之中，东闪西躲，结果还是被狂风侧面扫中，
又被风中暗藏兵刃擦伤，状况十分狼狈！\n" NOR, me, target);
      }
    } else {
      target->receive_damage("kee", damage);
      message_vision(HIY "$n情急之下，动作出奇的迅速，闪开了暗藏的兵刃威胁，
却还是被狂风从侧面扫中！\n" NOR, me, target);
    }
    COMBAT_D->report_status(target);
  } else {
    message_vision(HIC "$n临危不乱，镇定地辨清刀刃所在后，身子斜斜地飞开去，
紧贴狂风的边缘擦过！\n" NOR, me, target);
  }
  me->start_busy(2);
  me->add("mana", -200);
  target->kill_ob(me);
  return 5 + random(5);
}
