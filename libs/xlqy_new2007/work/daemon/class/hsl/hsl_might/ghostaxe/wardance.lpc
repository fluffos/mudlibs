#include <ansi.h>
#include <combat.h>

inherit SSERVER;

int perform(object me, object target)
{
  object weapon;
        string level,dlvl;
        int bonus=0;
        int damage,flag,count;  
        object *enemy;
        
        if( !target ) target = offensive_target(me);

        if( !target
        ||      !target->is_character()
        ||      target->is_corpse()
        ||      target==me)
                return notify_fail("你要对谁施展这一招「旋风战舞」？\n");
if(me->query("family/family_name")!="幻世勇者")
               return notify_fail("非幻世勇者不能使用此项技能！\n");

  bonus=(int)me->query_skill("axe",1)/6+(int)me->query_skill("dodge",1)/6;
  
        if(me->query_temp("might_set")) bonus += bonus/2;

        if(!me->is_fighting())
                return notify_fail("「旋风战舞」只能在战斗中使用！\n");

    if((int)me->query("max_force") < 500 )
                return notify_fail("你的内力不够！\n");

        if((int)me->query("force") < 500 )
                return notify_fail("你的内力不足！\n");

    if((int)me->query("sen") < 500 )
                return notify_fail("你的精神不足，没法子施用外功！\n");

    if((int)me->query_skill("ghostaxe", 1) < 150)
                return notify_fail("你的丧神鬼斧级别还不够，使用这一招会有困难！\n");
 if((int)me->query_skill("dodge", 1) < 150)
                return notify_fail("你的轻功级别还不够，使用这一招会有困难！\n");
                
                
        if( me->query_temp("no_perform")>time())
                return notify_fail("你现在还头晕脑涨呢，别旋了。\n");

                        
                        weapon = me->query_temp("weapon");
                  me->delete("env/brief_message");
                        target->delete("env/brief_message");

          message_vision(HIR"\n$N朝天大吼一声，突的双手持斧施展出「战舞」，身如陀螺旋风般向$n杀去！\n"NOR,me,target);
                 level = me->query("skill_level/axe");
                 dlvl = me->query("skill_level/dodge");
                 
                 enemy=me->query_enemy();
     count=sizeof(enemy);
       
       
                                me->add_temp("apply/sub_defense",bonus);
                         me->add_temp("apply/damage",bonus/2);
        if(level)
        {
                        me->add_temp("apply/sub_max_defense",bonus*12);
                flag = 1;
        } 
      if(level == "master"||level == "grandmaster")
        {
                        me->add_temp("apply/sub_armor",bonus);
                flag = 2;
        }  
      if(level == "grandmaster")
        {
                        me->add_temp("apply/sub_max_armor",bonus*15);
                flag = 3;
        } 
                
                COMBAT_D->do_attack(me, target, weapon,TYPE_QUICK); 
                COMBAT_D->do_attack(me, target, weapon,TYPE_QUICK); 
       
      if(dlvl== "expert") //dodge expert ++
       { 
        message_vision(HIY"\n$N身形旋过$n，停了一停之后又返身回旋向$n杀去！\n"NOR,me,target);  
         COMBAT_D->do_attack(me, target, weapon,TYPE_QUICK); 
      }
      else if(dlvl== "master") //dodge 
       { 
         message_vision(HIY"\n$N身形旋过$n，顿了一顿之后又返身回旋向敌人杀将过去！\n"NOR,me,target); 
         if(count == 1)
                         COMBAT_D->do_attack(me, target, weapon,TYPE_QUICK); 
         else
         {
                for(int j = 0;j <count;j++) 
         {
                 me->add_temp("apply/damage",-bonus/3);
                COMBAT_D->do_attack(me, enemy[j], weapon,TYPE_QUICK); 
                 me->add_temp("apply/damage",bonus/3);
         }
        }
      }
     else if(dlvl== "grandmaster") //dodge
       { 
         message_vision(HIY"\n$N身形旋过$n，又返身回旋向敌人杀将过去！\n"NOR,me,target); 
         
                for(int j = 0;j <count;j++) 
         {
                 
                COMBAT_D->do_attack(me, enemy[j], weapon,TYPE_QUICK); 
                
         }
        
      } 
        
       me->add_temp("apply/sub_defense",-bonus); 
        me->add_temp("apply/damage",-bonus/2);
   if(level)
        {
                        me->add_temp("apply/sub_max_defense",-bonus*12);
                
        } 
      if(level == "master"||level == "grandmaster")
        {
                        me->add_temp("apply/sub_armor",-bonus);
                
        }  
      if(level == "grandmaster")
        {
                        me->add_temp("apply/sub_max_armor",-bonus*15);
        
        }     
                
        
        me->receive_damage("sen", 100);
        me->add("force", -100);

        if( !target->is_fighting(me) ) {
                if( living(target) ) {
                        if( userp(target) ) target->fight_ob(me);
                        else target->kill_ob(me);
                }
        }

  me->set_temp("no_move",1);
  me->set_temp("no_perform",time()+random(4)+4);
  call_out("remove_no_move",5,me);
  return 1;
}

void remove_no_move(object me) 
{
  if (me) me->delete_temp("no_move");
}


