//【神罚拳】之【神裁】
//四连击

#include <ansi.h>
#include <combat.h>
inherit SSERVER;

int perform(object me, object target) {
  int i, extra;
  string msg;
  object weapon;
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要对谁施展这一招「神裁」？\n");

  if (me->query("family/family_name") != "幻世勇者" && me->query("family/family_name") != "幻世魔导")
    return notify_fail("你不能使用此项技能！\n");

  if (!me->is_fighting())
    return notify_fail("「神裁」只能在战斗中使用！\n");
  if (objectp(weapon = me->query_temp("weapon")))
    return notify_fail("你必须空手才能使用神罚拳的绝招。\n");
  if (me->query_skill("shenfa-quan", 1) < 100)
    return notify_fail("你的神罚拳等级不够，尚未领会到这个绝招！\n");
  if (me->query("kee") < 300)
    return notify_fail("你的体力太差了，发出「神裁」后恐怕对身体不利！");
  if (me->query("force") < 1000)
    return notify_fail("你的内力不够，无法发出「神裁」！");

  extra = me->query_skill("unarmed") / 5;
  extra = extra * 8 / 10;
  if (me->query_temp("might_set")) extra += extra / 2;
  me->add_temp("apply/attack", extra);
  me->add_temp("apply/strength", extra);
  me->add_temp("apply/add_phy", extra);
  msg = HIY "$N使出神罚拳的不传之密「神裁」，身体腾空而起，凌空发拳，
 瞬间已经攻出四拳！" NOR;
  message_vision(msg, me, target);
  for (i = 0; i < 4; i++)
    COMBAT_D->do_attack(me, target, weapon, TYPE_REGULAR);
  msg = HIC "$N完成最后一击之后，左手轻轻在$n的肩头一拍，身体便借力远远飘开了三丈有余。\n" NOR;
  message_vision(msg, me, target);
  me->add_temp("apply/attack", -extra);
  me->add_temp("apply/strength", -extra);
  me->add_temp("apply/add_phy", -extra);
  me->add("force", -100 - random(200));
  me->start_busy(2);
  return 1;
}
