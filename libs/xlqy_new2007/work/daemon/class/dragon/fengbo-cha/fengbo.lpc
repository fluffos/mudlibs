//jiz.

#include <ansi.h>
#include <combat.h>

inherit SSERVER;

int perform(object me, object target)
{
	int mypot,tapot,time;
	string level,str;
	int flag;
	object weapon;
	if( !target ) target = offensive_target(me);

	if( !target
	||	!target->is_character()
	||	!me->is_fighting(target) )
		return notify_fail("「无尽风波」只有在战斗中才能使用。\n");
        if(me->query("family/family_name")!="东海龙宫")
                return notify_fail("非龙宫弟子不能用「风波」！\n");
	if( (int)me->query_skill("fengbo-cha", 1) < 50 ) 
		return notify_fail("你的修为不够深，还使不出这一招！\n");

	if( target->is_busy() )
		return notify_fail(target->name()+"已经够忙了，你使的再漂亮也不会注意到。\n");
		
	if( me->query_temp("no_fengbo")>time())
		return notify_fail("风波多用就不灵了。\n");		
 	 weapon = me->query_temp("weapon");
	message_vision(HIC"$N挥展开来，左一叉，右一叉，幻出无数大小光环向$n绕去。
虽看起来柔弱无力，却宛若秋波般连绵不绝，实是暗藏杀机！\n\n"NOR,me, target);

	mypot=(int)me->query_skill("fork");
 if(mypot < 450 )
      mypot=mypot*mypot*mypot/12 + random( (int)me->query("combat_exp"));
if(me->query_temp("lg_set")) mypot+= mypot/2;
if (mypot >449)
{
 mypot=(int)me->query_skill("fork");
               mypot=(mypot/20)*(mypot/20)*(mypot/20)/12 + random( (int)target->query("combat_exp"))/8000;
}

	tapot=(int)target->query_skill("parry");
if (mypot < 450 )
       tapot=tapot*tapot*tapot/12 + random( (int)target->query("combat_exp"));
 if(tapot > 449)
{
tapot=(int)target->query_skill("parry");
                     tapot=(tapot/20)*(tapot/20)*(tapot/20)/12 + random( (int)target->query("combat_exp"))/8000;
}

	time=(int)me->query_skill("fengbo-cha", 1) /20;
	if ( time > 8 ) time = 8;	 //alading 2002.3.31
	if ( time < 3  ) time = 3;

if(me->query_temp("lg_set")) time+= time/2;
	if ( random( mypot + tapot ) > tapot ) {
		message_vision(HIR"$N果然被这光环套住，当时目瞪口呆，不知所措！\n"NOR,target);
		target->start_busy(time);
		flag = 0;
		level = me->query("skill_level/fork");
		if(level == "expert")
			flag = 1;
		else if(level == "master")
			flag = 2;
		else if(level == "grandmaster")
			flag = 3;
		
		if(flag)
		{
		    mypot = me->query_skill("fork",1);
		    message_vision(HIY"\n只见$N手中的"+weapon->name()+"一颤，化出一片叉影，如烟如雾，如波涛渐涨，如海浪涌动，
$n被烟雾笼罩，不知所措，只见$N的"+weapon->name()+"已到$n面前！\n"NOR,me,target);
		    me->add_temp("apply/attack",mypot/25);
		    
		    COMBAT_D->do_attack(me, target, me->query_temp("weapon"),TYPE_QUICK);
		     me->add_temp("apply/attack",-mypot/25);
		    flag --;
		    if(flag)
		    {
		     message_vision(HIC"\n$n还没清醒过来，却见$N手中"+weapon->name()+"闪了一下，突然不见，招意却在身旁亦真亦幻，淡出无数光影，
不断向$n逼去，一个不防，只听一声惨呼，$n被"+weapon->name()+"击中，留下一道深可见骨的伤痕。\n"NOR,me,target);
		     
		       me->add_temp("apply/attack",mypot/25);
		       me->add_temp("apply/damage",mypot/15);
		     COMBAT_D->do_attack(me, target,me->query_temp("weapon"),TYPE_QUICK);
		      me->add_temp("apply/attack",-mypot/25);
		       me->add_temp("apply/damage",-mypot/15);
		    flag --;	
		    }	
		    if(flag)
		    {
		    	
		       me->add_temp("apply/attack",mypot/25);
		       me->add_temp("apply/damage",mypot/15);
		       me->add_temp("apply/strength",mypot/20);	
		     message_vision(HIW"\n$N立住不动，$n大喜，正要前攻，突然觉得自己置身汪洋之中，正慌乱间，"+weapon->name()+"从八方攻来，
无可抵挡，意欲回头，却无归路，正是风波叉的最终奥义——四海无边！\n"NOR,me,target);
		     seteuid(getuid());
		    me->set("actions", (: call_other, SKILL_D("dragonfight"), "query_action" :) );
  		  
  		    if(weapon)
		  { 
		    weapon->set_temp("original/use_apply_skill",weapon->query("use_apply_skill"));
		    weapon->set_temp("original/skill_type",weapon->query("apply/skill_type"));
		    weapon->set("use_apply_skill",1);
		    weapon->set("apply/skill_type","unarmed");
		       
		     COMBAT_D->do_attack(me, target,me->query_temp("weapon"),TYPE_QUICK);
		    weapon->set("use_apply_skill",weapon->query_temp("original/use_apply_skill"));
		    weapon->set("apply/skill_type",weapon->query_temp("original/skill_type"));
		   
		   
		    me->reset_action();
		}
		else  COMBAT_D->do_attack(me, target,TYPE_QUICK);
		    
		       me->add_temp("apply/attack",-mypot/25);
		       me->add_temp("apply/damage",-mypot/15);
		       me->add_temp("apply/strength",-mypot/20);	
		    }
		   
		   if (target->query("eff_kee")<0&&!random(9) || (!living(target) && target->query("kee")<0)&&!random(9))  
		                       {str=me->name()+"使出了风波叉的最终奥义——"+BLINK+HIY"「四海无边」"NOR+HIM"，"+target->name()+"顾无归路，只得降于叉下 ！";
			                 message("channel:rumor",HIM"【空穴来风】某人："+str+"\n"NOR,users());
			               }		
		 me->set_temp("no_move",1);
		 call_out("remove_nomove",1+random(2),me);
		}
		

	}else {
	message_vision(HIR"不料确被$N看破，攻其不备，$n反被打了个措手不及！\n"NOR,target,me);
	
	if( me->query("family/family_name")!="东海龙宫" )
	{
	    me->start_busy(2+random(2));
		//Easy for target to hit
		if( random(2) )
			COMBAT_D->do_attack(target, me, target->query_temp("weapon"));
	}
	else
	{
		if( random(2) )
			COMBAT_D->do_attack(target, me, target->query_temp("weapon"));
		me->start_busy(2);
	}//bugbug,2002-4-8,prevent surrendering

	}

	me->set_temp("no_fengbo",time()+random(3)+3);
	
        if( !target->is_fighting(me) ) {
                if( living(target) ) {
                        if( userp(target) ) target->fight_ob(me);
                        else target->kill_ob(me);
                }
                me->kill_ob(target);
        }
	return 1;
}
void remove_nomove(object who)
{
	if(who) who->delete_temp("no_move");
}
