//by flying@飘渺水云间

#include <ansi.h>
#include <combat.h>
#include <mudlib.h>
inherit SSERVER;
#include "/daemon/skill/eff_msg.h";

int def;
int is_drunk(object);
int perform6(object me,object target);
int perform7(object me,object target);
int perform8(object me,object target);
int perform(object me, object target)
{       
    string msg,str;
    int damage, p,time,i,j,k,extra,oldbusy;
    int damage_bonus,target_bonus,wound;
    object *enemy;
    int count;
    object weapon;
int myforcefactor = 0;
  myforcefactor = (int)me->query("force_factor");
    if( !target ) target = offensive_target(me);
    if( !target || !target->is_character()
	    || !me->is_fighting(target) || !living(target) )
	return notify_fail("「龙行天下」只能在战斗中使用。\n");
    if(me->query("family/family_name")!="东海龙宫")
	return notify_fail("非龙宫弟子不能用「龙行天下」！\n");

    if( (int)me->query_skill("dragonfight",1)<30)
	return notify_fail("才入门就想用绝招？\n");     

    if( (int)me->query_skill("dragonfight", 1) > 29 && me->query("leidong") != 1 && me->query("fengwu") != 1)
    {
	if(me->query_skill("force", 1) <30)
	    return notify_fail("以你现在的内功修为还使不出龙行天下之「龙气初成」。\n");      
	if( (int)me->query_skill("dragonfight", 1) > 200 )
	    return notify_fail("以你现在的修为怎么还用「龙气初成」？\n");      
	if (me->query_skill_mapped("unarmed") != "dragonfight")
	    return notify_fail("你现在无法使用龙行天下之「龙气初成」进行攻击。\n");                                                                                 
	if( (int)me->query("max_force") < 300 )
	    return notify_fail("你的内力修为太弱，不能使用龙行天下之「龙气初成」！\n");
	if( (int)me->query("force") < 100 )
	    return notify_fail("你的真气不够！\n");
	if( (int)me->query("sen") < 50 )
	    return notify_fail("你的精神不足！\n");
	if( (int)me->query("kee") < 50 )
	    return notify_fail("你的气血不够！\n");    
	if( time()-(int)me->query_temp("leidong_end") < 2 )
	    return notify_fail("绝招用多就不灵了！\n");

	me->set_temp("leidong_end",time());
	i=(int)me->query("combat_exp");
	j=(int)target->query("combat_exp");
	k=(int)me->query_skill("dragonfight",1);
	me->delete("env/brief_message");
	target->delete("env/brief_message");
	message_vision("\n"HIM"$N运起龙神心法,掌心渐渐发出淡淡的紫光,正是龙宫武学的第一层境界:"HIC"「龙气初成」"BLU"!\n",me,target);
	message_vision("\n$N凝神定气,缓缓一掌拍向$n!\n"NOR,me,target);
  if (random(i+j)>3*j/4){
   damage = k + random(k*2-30)-30+myforcefactor;
   	if(me->query_temp("lg_set")) damage+= damage/2;
	    target->receive_damage("kee",damage);
	    target->receive_wound("kee",damage/5);
	    target->start_busy(random(2));//flying
  if (random(5)>2){
	    target->apply_condition("dragon_wound",
		    (int)target->query_condition("dragon_wound")+3+k/5);
	    //COMBAT_D->report_status(target);
}
	    message_vision(HIG"\n"HIR"$n身子一晃，胸口结结实实中了一掌！\n"NOR,me,target);
	    target->set_temp("last_damage_from", me);
	    COMBAT_D->report_status(target);
	}
	else 
	{
	    message_vision(HIY"\n$n身子一闪，躲开了这一招！\n"NOR,me,target);
	    me->start_busy(1+random(2));//flying
	   
	}
 	me->receive_damage("sen", 30);
	me->receive_damage("kee", 30);
  me->add("force",-50-myforcefactor);

	if( !target->is_fighting(me) ) {
	    if( living(target) ) {
		if( userp(target) ) target->fight_ob(me);
		else target->kill_ob(me);

	    }
	}
	me->start_busy(random(3));//flying
	return 1;

    }	
    if( (int)me->query_skill("dragonfight", 1) > 99 &&
	    (string)me->query("gender")=="男性" && 
	    me->query("leidong") == 1 && me->query("pini") != 1)     
    {
	if(me->query_skill("force", 1) <100)
	    return notify_fail("以你现在的内功修为还使不出龙行天下之「雷动九天」。\n");        
	if( (int)me->query_skill("dragonfight", 1) > 300 )
	    return notify_fail("以你现在的修为怎么还用「雷动九天」？\n");      
	if (me->query_skill_mapped("unarmed") != "dragonfight")
	    return notify_fail("你现在无法使用龙行天下之「雷动九天」进行攻击。\n");                                                                                 
	if( (int)me->query("max_force") < 1200 )
	    return notify_fail("你的内力修为太弱，不能使用龙行天下之「雷动九天」！\n");
	if( (int)me->query("force") < 300 )
	    return notify_fail("你的真气不够！\n");
	if( time()-(int)me->query_temp("leidong_end") < 5 )
	    return notify_fail("绝招用多就不灵了！\n");

	me->set_temp("leidong_end",time());
	msg = RED "\n 突然$N大喝一声:「雷动」,面色唰的变得通红,须发皆飞,浑身上下充满杀气,\n" NOR;
	message_vision(msg, me, target); 
	msg = YEL "\n        “嗡”的一声，一掌凌空击向$n的胸口！\n" NOR;
	if (random(me->query("combat_exp")) > random((target->query("combat_exp")/2))
	   )
	{
	    me->start_busy(1);
	    target->start_busy(1);
	    damage = (int)me->query_skill("dragonfight", 1);
	    damage = damage + random(damage/2);
			if(me->query_temp("lg_set")) damage+= damage/2;
	    def=(int)target->query_temp("apply/armor_vs_force");
	    damage -=damage*def/3000;
	    target->receive_damage("kee", damage,me,"phy");
	    target->receive_wound("kee", damage/2);               
	    me->add("force", -(damage/7));
	    p = (int)target->query("kee")*100/(int)target->query("max_kee");
	    msg += damage_msg(damage, "内伤");
	    msg += "( $n"+eff_status_msg(p)+" )\n";
	    target->set_temp("last_damage_from", me);
	    if(me->query_skill("dragonfight", 1) > 149)  //flying
		call_out("perform2", 1, me, target);    
	} else 
	{       me->start_busy(2);
	    me->add("force", -200);                
	    msg += HIY"可是$p伏地一滚，躲开了对手的攻击。\n"NOR;
	}

	message_vision(msg, me, target);
	return 1;
    }
    if( (int)me->query_skill("dragonfight", 1) > 99 &&
	    (string)me->query("gender")=="女性" &&
	    me->query("fengwu") == 1 && me->query("sui") != 1)     
    {
	if(me->query_skill("force", 1) <100)
	    return notify_fail("以你现在的内功修为还使不出龙行天下之「凤舞九天」。\n");        
	if (me->query_skill_mapped("unarmed") != "dragonfight")
	    return notify_fail("你现在无法使用龙行天下之「凤舞九天」进行攻击。\n");                                                                                 
	if( (int)me->query("max_force") < 1200 )
	    return notify_fail("你的内力修为太弱，不能使用龙行天下之「凤舞九天」！\n");
	if( (int)me->query("force") < 300 )
	    return notify_fail("你的真气不够！\n");
	if( time()-(int)me->query_temp("leidong_end") < 8 )
	    return notify_fail("绝招用多就不灵了！\n");
	me->set_temp("leidong_end",time());
	msg = HIC "\n $N嫣然一笑,身体突然盘旋而起，如一只飞舞九天的凤凰一般,双掌飞舞而至！\n" NOR;
	message_vision("
		"HIR"
		:                       .
		::                      :   :
		:::.                    :: ::
		::"HIY"*"HIR":.
		::::::.                :::.::: ::
		::`:`: `.             :::.:::.:::  :
		::    `  `           ::::::::.:::.::
		:::.              .::::::::::::.:::  :
		::::.           .::::::::::::::::: :'                           ::
		::::::.     ..::::::::::::::::::.::  .                         .
		::::::::::::::::::::::::::::::::::::'                         ::
		:::::::::::::::::::::::::::::::::..                         .::
		::::::::::::::::::::.::::::.         .::::::.            .::'
		`:::::::::::::::::::::.                      `::::::::::'
		:::::::::::::::.      `         .:::::::::.
		:`::::::::::::::::.     .::::::::.       `::::::.
		:  `:::::::::::::::::::::      `::::::.         `::::.
		::   `::::::::::::'                  `::::.          ``::.      ::'
		` :.                                     `::::. .         :: .


	    \n"NOR,me,target);


	if (random(me->query("combat_exp"))*3/4 + me->query("combat_exp")/4 > random((target->query("combat_exp")/2))
	   )
	{
	    me->start_busy(1);
	    target->start_busy(1);
	    damage = (int)me->query_skill("dragonfight", 1);
	    damage = damage + random(damage/2);
			if(me->query_temp("lg_set")) damage+= damage/2;
	    def=(int)target->query_temp("apply/armor_vs_force");
	    damage -=damage*def/1000;
	    target->receive_damage("kee", damage,me,"phy");
	    target->receive_wound("kee", damage/2);               
	    me->add("force", -(damage/7));
	    p = (int)target->query("kee")*100/(int)target->query("max_kee");
	    msg += damage_msg(damage, "内伤");
	    msg += "( $n"+eff_status_msg(p)+" )\n";
	    target->set_temp("last_damage_from", me);
	    call_out("perform3", 1, me, target);    
	} else 
	{       me->start_busy(1);
	    me->add("force", -200);                
	    msg += HIY"可是$p灵巧的一闪，躲开了攻击。\n"NOR;
	}

	message_vision(msg, me, target);
	return 1;

    }
    if( (int)me->query_skill("dragonfight", 1) > 199 &&
	    (int)me->query_skill("dragonfight", 1) < 400 && me->query("pini") == 1 
	    && me->query("sui") != 1)     //new perform
    {
	if( !target ) target = offensive_target(me);
	if( !target
		||	!target->is_character()
		||	!me->is_fighting(target) )
	    return notify_fail("不在战斗中，怎么使用龙行天下之「睥睨天下」？\n");
	if((me->query("family/family_name") != "东海龙宫")&&(!wizardp(me)))
	    return notify_fail("你非我龙王弟子，怎能使用龙宫绝招?\n");
	if((int)me->query("max_force") < 1000 )
	    return notify_fail("你的内功太差。\n");
	if((int)me->query("force") < 700 )
	    return notify_fail("你的内力不足！\n");
	if((int)me->query("sen") < 500 )
	    return notify_fail("你的精神不足，没法子施用外功！\n");
	if(time()-me->query_temp("lxtx_end")<8)
	    return notify_fail("龙行天下之「睥睨天下」不能用得这么频繁！\n");         
	me->set_temp("lxtx_end",time());
	me->add("force",-(500+me->query("force_factor")));	
	msg = HIY "$N深吸了一口气，突然跨上一步，右手探出抓向$n胸口。正是龙宫绝学「睥睨天下」的起手式。\n" NOR;
	msg+= HIW "这招本化自潜龙勿用，看似平平，但似快而慢，实是威力巨大。\n" NOR;
	damage_bonus=(int)me->query_skill("dodge");
	target_bonus=(int)target->query_skill("dodge");
	if(random(damage_bonus)>random(target_bonus/2)) 
	{
	    //me->start_busy(1);
	    //if(!target->is_busy())
	    //target->start_busy(1);
	    damage=150+(damage_bonus+random(damage_bonus));
			if(me->query_temp("lg_set")) damage+= damage/2;
	    if(wizardp(me))tell_object(me, sprintf(GRN "damage: %d\n" NOR, damage));
	    wound=damage-(int)target->query_temp("apply/armor");
	    msg +=HIR "$n躲闪不及，被$N抓住胸口，手臂振处，已被摔将出去。 \n" NOR;
	    target->set_temp("last_damage_from", me);
	    target->receive_damage("kee", damage, me);
	    if(wound>0) target->receive_wound("kee", wound, me);
	    p = (int)target->query("kee")*100/(int)target->query("max_kee");
	    msg+=COMBAT_D->damage_msg(damage, "内伤");
	    msg += "( $n"+eff_status_msg(p)+" )\n";
	}
	else 
	{
	    msg+=GRN"$n识得厉害，身形连闪，方才躲开了。\n" NOR;
	    me->start_busy(1);}
	    message_vision(msg, me, target);
	    //call_out("perform6", 1, me, target);   
	    perform6(me,target);

	    return 1;
    }	

    if( (int)me->query_skill("dragonfight", 1) >= 300 && me->query("sui") == 1)     //new perform
    {
	enemy=me->query_enemy();
	    count=sizeof(enemy);
	MONITOR_D->report_system_object_msg (me,"count is  "+ count +"\n");
	    if( !target ) target = offensive_target(me);
		if( !target
			||      !target->is_character()
			||      target->is_corpse()
			||      target==me)
		    return notify_fail("你要对谁施展这一招龙行天下之「虽千万人吾往矣」？\n");
			if(!me->is_fighting())
			    return notify_fail("龙行天下之「虽千万人吾往矣」只能在战斗中使用！\n");
				if (objectp(weapon = me->query_temp("weapon")))
				    return notify_fail("你必须空手才能使用龙行天下之「虽千万人吾往矣」。\n");
					if( me->query_skill("dragonfight",1) < 300)
					    return notify_fail("你的龙形搏击等级不够，尚未领会到这个绝招！\n");
	if( me->query_skill("dragonforce",1) < 200)
	    return notify_fail("你的龙形心法等级不够，内力尚未能到达圆转如意的境界！\n");
		if(me->query("kee")<300)
		    return notify_fail("你的体力太差了，难以发出龙行天下之「虽千万人吾往矣」！\n");
			if(me->query("force")<1000)
			    return notify_fail("你的内力不够，无法发出龙行天下之「虽千万人吾往矣」！\n");
	if(time()-me->query_temp("sui_end")<7)
	    return notify_fail("龙行天下之「虽千万人吾往矣」不能用得这么频繁！\n");         
	me->set_temp("sui_end",time());
	    
	    extra = me->query_skill("dragonfight",1) / 2; //modify by flying 2003 6 15
if(me->query_temp("lg_set")) extra+= extra/2;
	j = (me->query_skill("dragonfight",1)-300)/50 + 5;
	if(j>11)        //modify by flying 2003 6 15 
	    j=11;
		me->add_temp("apply/attack", extra/3);
		me->add_temp("apply/strength", extra/4);
	me->add_temp("apply/damage", extra/6);
	me->add_temp("apply/combat_double_damage", extra*6);
		me->add_temp("apply/combat_ignore_armor", extra*6);
	for(i=0;i<count;i++)
	{
	    if(userp(enemy[i]))              //限制pk的用途 by flying 2003.7.9
	    {
		if(me->query("combat_exp")/3 + random(me->query("combat_exp"))/3 + random(enemy[i]->query("combat_exp"))/3> random(enemy[i]->query("combat_exp")/2)&&random(10)<2)
		{
		    oldbusy=enemy[i]->query_busy();
		    if(oldbusy==0)
			enemy[i]->start_busy(j);
		    //MONITOR_D->report_system_object_msg (me,enemy[i]->query("id")+ " is busy "+ enemy[i]->query_busy()+"\n"); //test by flying
		}
	    }
	    else
	    {
		if(me->query("combat_exp")/3 + random(me->query("combat_exp"))/3 + random(enemy[i]->query("combat_exp"))/3> random(enemy[i]->query("combat_exp")/2))
		{
		    oldbusy=enemy[i]->query_busy();
		    if(oldbusy==0)
			enemy[i]->start_busy(j);
		    //MONITOR_D->report_system_object_msg (me,enemy[i]->query("id")+ " is busy "+ enemy[i]->query_busy()+"\n"); //test by flying
		}
	    }
	}
	if((int)me->query_skill("dragonforce", 1)>= 200&&(int)me->query_skill("dragonforce", 1)<301)
	    msg = MAG  "$N大喝一声，气聚丹田，掌心隐隐发出淡淡的紫光，几不可见，竟然已到了光华内敛的境界！\n" NOR;
	if((int)me->query_skill("dragonforce", 1)>=300)
	    msg = HIY  "$N微微一笑，随手劈出，竟如羚羊挂角，无迹可寻！\n" NOR;
	msg+= HIC  "正是东海龙宫的绝顶武学「虽千万人吾往矣」！\n" NOR;
	    message_vision(msg, me, target);
	    for(i=0;i<j;i++)
	    {
		for(k=0;k<count;k++)
		{
		    damage=COMBAT_D->do_attack(me,enemy[k],weapon);
			
				if(me->query_temp("lg_set")) damage+= damage/2;
		    //MONITOR_D->report_system_object_msg (me,"enemy is  "+ enemy[k]->query("id") +"\n");
		    //MONITOR_D->report_system_object_msg (me,"damage is  "+ damage +"\n");
		    //MONITOR_D->report_system_object_msg (me,"attack is  "+ COMBAT_D->skill_power(me, "unarmed",SKILL_USAGE_ATTACK)/100 +"\n");
		    //MONITOR_D->report_system_object_msg (me,"apply/damage is  "+ me->query_temp("apply/damage") +"\n");
		    if(damage>0)
			target->apply_condition("dragon_wound",(int)target->query_condition("dragon_wound")+5+extra/10);
		}
	    }
	
	    me->add_temp("apply/attack", -extra/3);
	    me->add_temp("apply/strength", -extra/4);
	me->add_temp("apply/damage", -extra/6);
	me->add_temp("apply/combat_double_damage", -extra*6);
	me->add_temp("apply/combat_ignore_armor", -extra*6);
/*	if(random(3)>0)
	{
	    msg = HIR  "$N一气呵成地攻出数招，丹田一阵刺痛，内力顿觉不继！\n" NOR;
	    message_vision(msg, me, target);
	    if((int)me->query_skill("dragonforce", 1)<500)
	    {
		me->add("maximum_force", -30);  //限制此招的使用 by flying
		me->add("max_force", -30);
	    }
	}
	*/
	me->add("force", -random(100));//因为是平招，每招都会减内力
	me->start_busy(random(3)+2);
	return 1;	
    }	
}

int perform2(object me, object target)
{
    int damage, p,skill;
    string msg,weapon;
    weapon = me->query_temp("weapon");  
    if(!living(target)) 
	return notify_fail("对手已经不能再战斗了。\n");
    if(!me->is_fighting(target))
	return notify_fail("你们并不在战斗中！\n");  
    if(environment(me)!=environment(target))
	return notify_fail("你想隔山打牛？\n");      
    if( (int)me->query("force", 1) < 300 )
	return notify_fail("你待要再出第二击，却发现自己的内力不够了！\n");     
    msg = MAG "\n只见$N衣袍鼓起，猎猎飞舞，身子凌空飞起，又是一声大吼「九天」，\n" NOR;
    message_vision(msg, me, target); 
    msg = CYN "\n       “哗”的挥出九个光圈，居高临下，直向$n逼来。\n" NOR;
    me->start_busy(1);
    target->start_busy(1);
    damage = (int)me->query_skill("dragonfight", 1);
    damage = damage+(int)me->query_skill("unarmed", 1);
    damage = damage+(int)me->query_skill("dragonforce", 1);
    damage = damage + random(damage)/2;
		if(me->query_temp("lg_set")) damage+= damage/2;
    def=(int)target->query_temp("apply/armor_vs_force");
    damage -=damage*def/3000;
    target->receive_damage("kee", damage,me,"phy");
    target->receive_wound("kee", damage/2);
    me->add("force", -random(damage/10));
    p = (int)target->query("kee")*100/(int)target->query("max_kee");
    msg += damage_msg(damage, "内伤");
    msg += "( $n"+eff_status_msg(p)+" )\n";
    target->set_temp("last_damage_from", me);
    if(damage)
	target->apply_condition("dragon_wound",(int)target->query_condition("dragon_wound")+5+damage/5);
    //COMBAT_D->report_status(target);
    message_vision(msg, me, target);
    return 1;
}

int is_drunk(object me) {
    int limit = me->query("con")*6+(int)me->query("max_force")/50;
    int duration=me->query_condition("drunk");
    if  (duration > limit/10 ) return 1;
    return 0;
}


int perform3(object me, object target)
{
    int damage, p,skill;
    string msg,weapon;
    //weapon = me->query_temp("weapon");  
    if(!living(target)) 
	return notify_fail("对手已经不能再战斗了。\n");
    if(!me->is_fighting(target))
	return notify_fail("你们并不在战斗中！\n");  
    if(environment(me)!=environment(target))
	return notify_fail("你想隔山打牛？\n");  
    if( (int)me->query("force", 1) < 300 )
	return notify_fail("你待要再出第二击，却发现自己的内力不够了！\n");     
    msg = MAG "\n$N长袖挥舞，翩翩如仙，突然无数寒光从衣袖中飞出。\n" NOR;
    message_vision(msg, me, target); 
    msg = CYN "\n       或慢或疾，或前或后，齐向$n飞来。\n" NOR;
    me->start_busy(1);
    target->start_busy(1);
    if (random(me->query("combat_exp")) > random((target->query("combat_exp")/2)))
    {
	damage = (int)me->query_skill("dragonfight", 1);
	damage = damage+(int)me->query_skill("unarmed", 1);
	damage = damage+(int)me->query_skill("dragonforce", 1);
	damage = damage + random(damage)/2;
	if(me->query_temp("lg_set")) damage+= damage/2;

	def=(int)target->query_temp("apply/armor_vs_force");
	damage -=damage*def/2000;
	target->receive_damage("kee", damage,me,"phy");
	target->receive_wound("kee", damage/2);
	me->add("force", -random(damage/10));
	p = (int)target->query("kee")*100/(int)target->query("max_kee");
	msg += damage_msg(damage, "内伤");
	msg += "( $n"+eff_status_msg(p)+" )\n";
	target->set_temp("last_damage_from", me);
	if(random(5)>1)  //flying
	    call_out("perform4", 1, me, target);    
    } else 
    {       me->start_busy(2);
	me->add("force", -200);                
	msg += HIY"$n仗着内力深厚，双袖一卷，将暗器都卷入袖中,发现竟是些水珠。\n"NOR;
    }
    message_vision(msg, me, target);
    return 1;
}


int perform4(object me, object target)
{
    int damage, p,skill;
    string msg,weapon;
    //weapon = me->query_temp("weapon");  
    if(!living(target)) 
	return notify_fail("对手已经不能再战斗了。\n");
    if(!me->is_fighting(target))
	return notify_fail("你们并不在战斗中！\n");  
    if(environment(me)!=environment(target))
	return notify_fail("你想隔山打牛？\n");  
    if( (int)me->query("force", 1) < 300 )
	return notify_fail("你待要再出第三击，却发现自己的内力不够了！\n");     
    msg = MAG "\n$N越舞越急,犹如蝴蝶穿花绕树一般，在$n正头晕眼花之际。\n" NOR;
    message_vision(msg, me, target); 
    msg = CYN "\n       $N揉身而上，一掌击出，直取$n防备最弱之处。\n" NOR;
    me->start_busy(1);
    target->start_busy(1);
    damage = (int)me->query_skill("dragonfight", 1);
    damage = damage+(int)me->query_skill("unarmed", 1);
    damage = damage+(int)me->query_skill("dragonforce", 1);
    damage = damage + random(damage)/2;
	if(me->query_temp("lg_set")) damage+= damage/2;
    def=(int)target->query_temp("apply/armor_vs_force");
    damage -=damage*def/2000;
    target->receive_damage("kee", damage,me,"phy");
    target->receive_wound("kee", damage/2);
    me->add("force", -random(damage/10));
    p = (int)target->query("kee")*100/(int)target->query("max_kee");
    msg += damage_msg(damage, "内伤");
    msg += "( $n"+eff_status_msg(p)+" )\n";
    target->set_temp("last_damage_from", me);
    if(damage)
	target->apply_condition("dragon_wound",(int)target->query_condition("dragon_wound")+2+damage/5);
    if(random(4)>1)  //flying
	call_out("perform5", 1, me, target);    
    message_vision(msg, me, target);
    return 1;
}

