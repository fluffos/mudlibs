//Cracked by Roath

#include <ansi.h>

#include <combat.h>

inherit SSERVER;

int perform(object me, object target)

{

  string msg, level;

  int extra, i, lmt, sub;

  object weapon;

  extra = me->query_skill("qixiu-jian", 1);

  if (extra < 80) return notify_fail("你的[七修剑]还不够纯熟！\n");

  extra = me->query_skill("huntian-qigong", 1);

  if (extra < 80) return notify_fail("你的[混天气功]还不够纯熟，无法发挥七修剑的威力！\n");

  if (!target) target = offensive_target(me);

  if (!target

    || !target->is_character()

    || !me->is_fighting(target))

    return notify_fail("［夺命七剑］只能对战斗中的对手使用。\n");



  if (me->query("family/family_name") != "陷空山无底洞")

    return notify_fail("你不能用别派的特殊攻击\n");
  if (me->query("force") < 300)
    return notify_fail("你的内力不够了！\n");


  weapon = me->query_temp("weapon");

  if (me->query_temp("wdd_set")) extra += extra / 2;
  me->add_temp("apply/damage", extra / 3);  // alading 2002-5-31

  msg = YEL "$N狂性大发，手中的" + weapon->name() + "狂风暴雨般地向$n袭来！\n" NOR;

  message_vision(msg, me, target);

  me->add("force", -100);

  level = me->query("skill_level/sword");
  sub = me->query_skill("sword", 1);
  if (level == "expert") {
    sub = 1 + sub / 150;
  } else if (level == "master") {
    sub = 1 + sub / 120;
  } else if (level == "grandmaster") {
    sub = 1 + sub / 100;
  } else
    sub = 0;
  lmt = random(5) + 3 + sub / 2 + random(sub / 2);
  if (me->query_temp("wdd_set")) lmt += lmt / 2;

  for (i = 1; i <= lmt; i++)

  {

    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);

  }
  me->add_temp("apply/damage", -extra / 3);
  me->start_busy(2 + random(2));

  return 1;

}
