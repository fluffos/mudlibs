// by bugbug & alading @ 缥缈水云间, 2003-4-5
//Cracked by Roath
// pozhan.c 		破绽百出

#include <ansi.h>
#include <combat.h>

inherit SSERVER;

int perform(object me, object target)
{
	string msg,str;
	int delay, myblade;
       int success;
       object weapon;
	string level;
	int flag,mypot;
 //   if(me->query("family/family_name")!="陷空山无底洞")
//			return notify_fail("只有无底洞门人才可以用！\n");

	if( !target ) target = offensive_target(me);
	weapon = me->query_temp("weapon");
	if(!weapon||weapon->query("skill_type") !="blade"||me->query_skill_mapped("blade")!="kugu-blade")
		return 0;
	if( !target
	||	!target->is_character()
	||	!me->is_fighting(target) )
		return notify_fail("不在战斗中，露什么破绽？\n");
	
	myblade=(int)me->query_skill("kugu-blade",1);
	if(myblade>160) myblade=160; // mon 12/7/98
 if(me->query_temp("wdd_set"))
myblade += myblade/2;
	if(myblade<50) 
		return notify_fail("你的修为不够深，露破绽给人太危险了。\n");

       if(myblade<60) myblade=60;//tonii,03-5-14

	if(me->query("force")<200) 
		return notify_fail("你的内力不够了，少露破绽为妙。\n");
	delay=myblade/20;//tonii,03-5-14

	if( target->is_busy() )
		return notify_fail(target->name() + "目前正自顾不暇，放胆攻击吧！\n");
		
	if(me->query("family/family_name")!="陷空山无底洞")
		me->add("force", -delay*20);
	
	msg = CYN "$N的招式突然一变，变得全无章法，浑身上下破绽百出，\n";
       success = 1;
       if( ((random(me->query("combat_exp"))*4/5 + (me->query("combat_exp")/4) < (int)target->query("combat_exp")/2 ))) 
              success = 0;
       if(me->query("family/family_name")!="陷空山无底洞"&&!random(5))
		success = 0;
	
       if(success)
	{
		msg += "$n想攻，却不知道哪个破绽是真，哪个是假。\n";
		msg += "结果$p被$P攻了个措手不及！\n" NOR;
		message_vision(msg, me, target);
		target->start_busy(delay*2/3+random(delay));
		if(me->query("family/family_name")!="陷空山无底洞")
			me->start_busy(random(2));
		else
		{
			
		flag = 0;
		level = me->query("skill_level/blade");
		if(level == "expert")
			flag = 1;
		else if(level == "master")
			flag = 2;
		else if(level == "grandmaster")
			flag = 3;
		
		if(flag)
		{
		    mypot = me->query_skill("blade");
		    message_vision(HIM"\n刀势意犹未尽，只见$N转身顺势向$n劈出一刀！\n"NOR,me,target);
		    me->add_temp("apply/sub_defense",mypot/25);
		    COMBAT_D->do_attack(me, target, me->query_temp("weapon"),TYPE_QUICK);
		    me->add_temp("apply/sub_defense",-mypot/25);
		    flag --;
		    if(flag)
		    {
		     message_vision(HIR"\n$N一个筋斗飞至半空，散出漫天刀光向$n当头再劈一刀！！\n"NOR,me,target);
		     
		       me->add_temp("apply/sub_defense",mypot/25);
		       me->add_temp("apply/sub_armor",mypot/15);
		     COMBAT_D->do_attack(me, target,me->query_temp("weapon"),TYPE_QUICK);
		      me->add_temp("apply/sub_defense",-mypot/25);
		       me->add_temp("apply/sub_armor",-mypot/15);
		    flag --;	
		    }	
		    if(flag)
		    {
		    	
		       me->add_temp("apply/sub_defense",mypot/25);
		       me->add_temp("apply/sub_armor",mypot/15);
		       me->add_temp("apply/strength",mypot/20);	
		   
		   
  		    weapon = me->query_temp("weapon");
  		    if(weapon)
		  {  
		   message_vision(RED"\n惊天劲气激荡下，$N作天魔狂舞，人刀合一幻形为剑，向$n急射而去！！！\n"NOR,me,target);
		    seteuid(getuid());
		    me->set("actions", (: call_other, SKILL_D("qixiu-jian"), "query_action" :) );
		    weapon->set_temp("original/use_apply_skill",weapon->query("use_apply_skill"));
		    weapon->set_temp("original/skill_type",weapon->query("apply/skill_type"));
		    weapon->set("use_apply_skill",1);
		    weapon->set("apply/skill_type","sword");
		       
		     COMBAT_D->do_attack(me, target,me->query_temp("weapon"),TYPE_QUICK);
		    weapon->set("use_apply_skill",weapon->query_temp("original/use_apply_skill"));
		    weapon->set("apply/skill_type",weapon->query_temp("original/skill_type"));
		   
		   
		    me->reset_action();
		}
		else{
		
		   message_vision(RED"\n惊天劲气激荡下，$N作天魔狂舞，双手突然暴涨，厉爪向$n抓了过去！！！\n"NOR,me,target);
		    seteuid(getuid());
		    me->set("actions", (: call_other, SKILL_D("yinfeng-zhua"), "query_action" :) );
		    weapon->set_temp("original/use_apply_skill",weapon->query("use_apply_skill"));
		    weapon->set_temp("original/skill_type",weapon->query("apply/skill_type"));
		    weapon->set("use_apply_skill",1);
		    weapon->set("apply/skill_type","unarmed");
		    COMBAT_D->do_attack(me, target,TYPE_QUICK);
		    weapon->set("use_apply_skill",weapon->query_temp("original/use_apply_skill"));
		    weapon->set("apply/skill_type",weapon->query_temp("original/skill_type"));
		    me->reset_action();
		}
		       me->add_temp("apply/sub_defense",-mypot/25);
		       me->add_temp("apply/sub_armor",-mypot/15);
		       me->add_temp("apply/strength",-mypot/20);	
		    }
            if(random(10) >7)
		    {
		   if (target->query("eff_kee")<0 || (!living(target) && target->query("kee")<0))  
		                       {str=target->name()+"被"+HIR+me->name()+HIM"用无底洞绝学"+BLINK+HIB"「破绽百出」"NOR+HIM"剁成了一团肉酱，死状其惨无比！！";
			                 message("channel:rumor",HIM"【空穴来风】某人："+str+"\n"NOR,users());
			               }		
			       }
		 me->set_temp("no_move",1);
		 call_out("remove_nomove",1+random(2),me);
		}	
			
			
		}

	} else {
		msg += "可是$p看破了$P的企图，并没有上当。\n" NOR;
		if(me->query("family/family_name")!="陷空山无底洞")
            		me->start_busy(1+random(delay/2));            	
		else
			me->start_busy(2+random(2));
			message_vision(msg, me, target);
	}
	

        if( !target->is_fighting(me) ) {
                if( living(target) ) {
                        if( userp(target) ) target->fight_ob(me);
                        else target->kill_ob(me);
                }
                me->kill_ob(target);
        }

	return 1;
}
void remove_nomove(object who)
{
	if(who) who->delete_temp("no_move");
}

