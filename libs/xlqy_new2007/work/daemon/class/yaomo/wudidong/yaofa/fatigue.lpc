// by gamer
#include <ansi.h>

inherit SSERVER;

void remove_fatigue(object me, int atk);

int cast(object me, object target) {
  int skill, effect, atk;
  int ap, dp;
  int haste;
  string level;
  me = this_player();
  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要对谁用「疲劳缓攻」？\n");

  if ((int)me->query_skill("yaofa", 1) < 120)
    return notify_fail("你的妖法修为不足。\n");
  if (me->query("family/family_name") != "陷空山无底洞")
    return notify_fail("你非妖类，不懂得「疲劳缓攻」的奥妙！\n");
  if ((int)me->query("mana") < 1000)
    return notify_fail("你的法力不够。\n");
  if ((int)me->query("kee") < 300)
    return notify_fail("你的气血不足。\n");
  if ((int)me->query("sen") < 300)
    return notify_fail("你的精神不足。\n");
  if ((int)target->query_temp("in_fatigue")) {
    tell_object(me, target->name() + "已经受到「疲劳缓攻」的影响了!\n");
    return 1;
  }
  message_vision(YEL "$N默运妖法，一股黄浊之气缓缓集在指尖，挥手向$n劈去。\n" NOR, me, target);

  ap = me->query_skill("yaofa", 1);
  dp = target->query_skill("dodge", 1);
  dp = dp / 2 + random(dp * 2 / 3);
  ap = ap * ap * ap / 80;
  dp = dp * dp * dp / 100;
  ap *= me->query_spi();
  dp *= target->query_con();

  if (random(ap + dp) > dp) {
    skill = me->query_skill("spells");

    me->add("mana", -480);
    me->receive_damage("kee", 120);
    me->receive_damage("sen", 120);
    message_vision(YEL "$N" + YEL "躲闪不及，被黄雾盖了个正着，顿觉手脚像是被粘住似的，出招大受影响!\n" NOR, target);
    level = me->query("skill_level/spells");
    effect = 1;
    if (level == "expert")
      effect = 2;

    else if (level == "master")
      effect = 3;

    else if (level == "grandmaster")
      effect = 4;
    target->set_temp("in_fatigue", effect);
    atk = me->query_skill("yaofa", 1);
    atk = atk / 40;
    atk = atk * atk / 4;
    atk = atk * (effect - 1);
    if (atk > 80) atk = 80 + random(10);
    target->add_temp("apply/attack", -atk);
    target->set_temp("in_fatigue_attack", atk);
    skill = skill / 10;
    if (skill > 60) skill = 60 + random(10);
    skill = skill / 2 + random(skill / 2);
    skill *= effect;
    target->start_call_out((: call_other, __FILE__, "remove_fatigue", target, atk :), skill);
    if (target->query_temp("in_haste")) {
      haste = target->query_temp("in_haste_strength");
      target->delete_temp("in_haste");
      target->delete_temp("in_haste_temp");
      target->delete_temp("in_haste_strength");
      target->add_temp("apply/strength", -haste);
      tell_object(target, "你所受到的「急攻快打」被消除了!\n");

    }

    me->start_busy(2 + random(2));
  } else {
    me->add("mana", -800);
    me->receive_damage("kee", 150);
    me->receive_damage("sen", 150);
    message_vision(HIC "结果被$N纵身躲开了!\n" NOR, target);
    me->start_busy(2 + random(2));

  }
  target->kill_ob(me);
  return 5 + random(5);
}

void remove_fatigue(object me, int atk) {
  if (!me) return;
  if (me->query_temp("in_fatigue")) {
    me->delete_temp("in_fatigue");
    me->delete_temp("in_fatigue_temp");
    me->delete_temp("in_fatigue_attack");
    me->add_temp("apply/attack", atk);
    tell_object(me, "你所受到的「疲劳缓攻」效果结束了!\n");

  }
}
