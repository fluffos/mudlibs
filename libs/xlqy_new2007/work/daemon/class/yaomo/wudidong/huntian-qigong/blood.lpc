/////
#include <ansi.h>

inherit F_CLEAN_UP;

void remove_effect(object me, int amount,int effect);

int exert(object me, object target)
{
        int skill,howlong,skills;
        if(me->query("family/family_name")!="陷空山无底洞")
                return notify_fail("你不是妖魔之身,如何吸血啊？\n");

        skill = me->query_skill("huntian-qigong",1);
        skills=skill; 
	if(skill>600) skill=600;         // no more than 60%
skill += skill*me->query_temp("wdd_set")/2;
 skills += skills*me->query_temp("wdd_set")/2;
	howlong= me->query_skill("force");
howlong += howlong*me->query_temp("wdd_set")/2;
        if( target != me ) 
		return notify_fail("你只能对自己用嗜血狂魔。\n");

        if( (int)me->query("force") < skill*2 )     
		return notify_fail("你的内力不够。\n");
        if( (int)me->query_temp("combat_blood_kee") ) 
		return notify_fail("你已经在运功中了。\n");
	if(me->query("kee")<150)
	     return notify_fail("你的气血不足！\n");
        me->add("force", -skill);
        me->receive_damage("kee", 100);

        message_vision(
                HIR "$N两眼冒出血红之色，嘴中竟然伸出两根长长的獠牙！\n" NOR, me);

        me->add_temp("apply/combat_blood_kee", skill*10);
        me->set_temp("combat_blood_kee",1);
	me->add_temp("apply/sub_armor",skills/10);
	me->add_temp("apply/sub_defense",skills/10);
	me->add_temp("apply/defense",-50+skills/5);
        me->start_call_out( (: call_other, __FILE__, "remove_effect", me, skills,skill :),howlong);

        if( me->is_fighting() ) me->start_busy(3);

        return 1;
}

void remove_effect(object me, int amount,int effect)
{
        if(!me) return;
        me->delete_temp("combat_blood_kee");
         me->add_temp("apply/combat_blood_kee", -effect*10);
        me->add("bellicosity", amount/20);
        me->add_temp("apply/sub_armor",-amount/10);
        me->add_temp("apply/sub_defense",-amount/10);
        me->add_temp("apply/defense",50-amount/5);
	// mon 3/1/98. move this to after powerup is done.
        tell_object(me, "你嘴中獠牙慢慢缩短，眼神也恢复了正常。\n");
}


