// by bugbug & alading @ 缥缈水云间, 2003-4-5
#include <ansi.h>
#include <combat.h>
inherit SSERVER;

int perform(object me, object target)
{
        string msg;
        int extra;
        object weapon;
        int flag;
        extra = me->query_skill("blade");

        if (!objectp(weapon = me->query_temp("weapon"))
                || (string)weapon->query("skill_type") != "blade")
                        return notify_fail("你使用的武器不对。\n");
        if( !target ) target = offensive_target(me);
        if( !target
        ||      !target->is_character()
        ||      !me->is_fighting(target) )
               return notify_fail(HIW"「寒光斩」"NOR"只能对战斗中的对手使用。\n");
        weapon = me->query_temp("weapon");

      if ( me->query_temp("no_perform")+5 > time() )
                return notify_fail("凤舞九天已使你短期内内力难继！\n");
	flag = 0;
        if(extra < 200)
            return notify_fail("你的刀法还不够纯熟！\n");
     if(me->query("family/family_name")!="大雪山")
           return notify_fail("你哪里偷来的武功？\n");
        if(me->query("max_force") < 1000)
            return notify_fail("你的内力还不够，不要勉强了！\n"); 
        if(me->query("force") < 1000)
            return notify_fail("你的真气不够，不要勉强了！\n"); 
extra=extra*8/10;

        if(extra >= 600)  extra = 600;
if(me->query_temp("xs_set")) extra+= extra/2;
      
        if(weapon->query("material")=="ice")
        {
        	 me->add_temp("apply/attack",extra/5);
	        me->add_temp("apply/damage",extra/2);
	        me->add_temp("apply/strength", extra/10);
	        me->add_temp("apply/sub_max_armor", 1200);
        	flag = 1;
        	
        }
        else
        {
	        me->add_temp("apply/attack",extra/6);
	        me->add_temp("apply/damage",extra/3);
	        me->add_temp("apply/strength", extra/12);
        	
        	
        	
        }

         msg = HIW "$N手中冰刀自下而上从天划过，一时间漫天飞雪！！\n" NOR;
        message_vision(msg, me);
                message_vision(HIY"飘雪式---$N手中冰刀顺着雪势使出一招！\n"NOR,me);
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
                message_vision(HIC"排雪式---$N手中冰刀犹如扑风追影反撩！\n"NOR,me);
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
                message_vision(HIB"劈雪式---$N手中冰刀夹着翩翩刀光猛劈！\n"NOR,me);
        COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
                message_vision(HIW"\n$N自空中回落地面，冷酷的脸在冰刀的寒光中更加阴沉！\n"NOR,me);
        if(flag)
        {
        	 me->add_temp("apply/attack",-extra/5);
	        me->add_temp("apply/damage",-extra/2);
	        me->add_temp("apply/strength", -extra/10);
        	 me->add_temp("apply/sub_max_armor", -1200);
        	
        }
        else
        {
	        me->add_temp("apply/attack",-extra/6);
	        me->add_temp("apply/damage",-extra/3);
	        me->add_temp("apply/strength", -extra/12);
        	
        	
        	
        }

        me->add("force", -200);
        me->start_busy(2);
        return 1;
}

