#include <ansi.h>
#include <combat.h>
inherit SSERVER;
void remove_effect(object me, int amount);
int exert(object me, object target)
{       object *team;
	int count=0,i;
        team=me->query_team();
        count=sizeof(team);
	if( (int)me->query("force") < 500 )
		return notify_fail("你的真气不够。\n");
        if(me->query("family/family_name")!="南海普陀山")
                return notify_fail("你并非南海门下,不能用无极渡元！\n");
        if( (int)me->query("mana") < 50 )
		return notify_fail("你的法力不够。\n");
	if(me->query("emei/qunliao")!= 1 )
                return notify_fail("你还不会这项技能！\n");
                

	message_vision("$N潜运莲台心法,双掌合十,低眉肃容,隐有普渡众生之意。众人只觉得一股祥和的内力涌来,顿时四体舒泰.\n", me);
	for(i=0;i<count;i++)
       { if(team[i]!=0 && environment(team[i])==environment(me))
        team[i]->receive_curing("kee", 15 + (int)me->query_skill("lotusforce")/5 );
	}
	
	me->add("force", -500);
	me->add("mana", -50);
	me->set("force_factor", 0);
	me->set("mana_factor", 0);
	
	if( me->is_fighting() ) me->start_busy(random(2));
	return 1;
}

