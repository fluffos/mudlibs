#include <ansi.h>

inherit SSERVER;

int cast(object me, object target) {
  int i;
  string where;
  string msg;
  if (!target) target = offensive_target(me);
  if ((int)me->query("mana") < 150)
    return notify_fail("你的法力不够了！\n");
  if ((int)me->query("sen") < 150)
    return notify_fail("你的精神无法集中！\n");
  if (me->is_busy())
    return notify_fail("你正忙着呢！\n");

  if ((string)me->query("family/family_name") != "南海普陀山")
    return notify_fail("就你这样也能使用往生极乐？\n");
  if (me->query_skill("buddhism") < 25)
    return notify_fail("你还没学会往生极乐呢。\n");
  me->add("mana", -80);
  me->receive_damage("sen", 50);
  msg = HIY "$N口中吟唱到：如来者，无所从来，亦无所去！若见诸相非相，即见如来！\n" NOR;
  msg += HIY "一时间，祥云霭霭，佛光普照，$N乘祥云飘然而去...\n" NOR;
  i = random(6);
  if (i == 0) where = "/d/nanhai/chaoyindong";
  else if (i == 1) where = "/d/nanhai/guangchang";
  else if (i == 2) where = "/d/nanhai/restroom";
  else if (i == 3) where = "/d/nanhai/zhaifang";
  else if (i == 4) where = "/d/nanhai/road4";
  else if (i == 5) where = "/d/nanhai/zhulin0";
  if (me->is_fighting()) {
    if (random((int)me->query("max_mana")) > (int)target->query("max_mana") / 2) {
      message_vision(msg, me);
      me->move(where);
      tell_room(environment(me),
        HIY "忽然平地祥云腾起，佛光普照，" + me->query("name") + "施施然从中而出。\n" NOR, ({ me, me }));

    } else {
      message_vision(HIM "$N喃喃地眯着小老鼠眼念了几句，但显然心不在蔫，结果什么都没有发生。\n" NOR, me);
      me->start_busy(2);
    }
  } else {
    message_vision(msg, me);
    me->move(where);
    tell_room(environment(me),
      HIY "忽然平地祥云腾起，佛光普照，" + me->query("name") + "施施然从中而出。\n" NOR, ({ me, me }));

  }

  return 5 + random(5);
}
