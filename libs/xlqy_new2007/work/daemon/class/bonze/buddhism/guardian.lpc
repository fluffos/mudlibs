#include <ansi.h>
inherit SSERVER;

int cast(object me, string target)
{	
        object guardian,ob;
        mapping dbase;
        
        if(me->query("family/family_name")!="南海普陀山")
                return notify_fail("你不是佛门弟子，佛祖不会保佑你的！\n");
         if(me->query_skill("buddhism",1)<150)
         	return notify_fail("你还没学会祈祷神使！\n");
     	if(!target)
     		 return notify_fail("你要将什么物品召唤为神使？\n");
     	if(!(ob=present(target,me)))
     		 return notify_fail("你要将什么物品召唤为神使？\n");
     	if(!ob->is_diablo_ob())
     		 return notify_fail("这件物品毫无魔力，无法召唤出神使！\n");
     	if(!ob->query("identification"))
     		return notify_fail("你还不了解这件物品的特性，怎么召唤！\n");
     	if(ob->query("kind") < 6)	
     		return notify_fail("这件物品魔力不足，无法召唤出神使！\n");
     	if(ob->query("diablo_ob_autoloaded"))
     		return notify_fail("这件物品不能召唤出神使！\n");
     	if(!userp(me))
     		return notify_fail("#^#$%@$@%#@$@#$！\n");	
        if( (int)me->query("mana") < 1000 )
                return notify_fail("你的法力不足！\n");

        if( (int)me->query("sen") < 333 )
                return notify_fail("你的精神无法集中！\n");

        message_vision(HIB"$N喃喃地念了几句咒语。\n\n"NOR, me);

        me->add("mana", -500);

        if( random(me->query("max_mana")) < 20 ) {
                message("vision", "但是什么也没有发生。\n",environment(me));
                return 1;
        }
        if(me->query("summon/diablo_npc"))
        {
        	guardian=me->query("summon/diablo_npc");
        	 if(objectp(guardian)&&environment(guardian))
        		guardian->die();
        	
        }
	dbase=ob->query("diablo_prop");
	
        seteuid(getuid());
        guardian = new("/obj/npc/putuo_guardian");
        guardian->move(environment(me));
        guardian->invocation(me,dbase);
  	guardian->set("title",ob->query("name"));
	guardian->set_temp("invoker",me);
  
       	 message_vision(HIY"$N说道：你的虔诚感动了上天，将我幻化为形，我将永远伴随你保护你！\n"NOR,guardian );
        me->set("summon/diablo_npc",guardian);
        me->set("summon/npc_prop",dbase);
        me->set("summon/title",guardian->query("title"));
        me->set("summon/family",guardian->query("family/family_name"));
        me->save();
	me->start_busy(2+random(2));
	destruct(ob);
        return 13+random(13);
}





