#include <ansi.h>
#include <combat.h>
inherit SSERVER;
void remove_effect(object me, int amount);
int cast(object me, object target) {
  object *team;
  int count = 0, i;
  team = me->query_team();
  count = sizeof(team);
  if ((int)me->query("force") < 50)
    return notify_fail("你的真气不够。\n");
  if (me->query("family/family_name") != "南海普陀山")
    return notify_fail("你不是佛门弟子，不能使用这项技能！\n");
  if (me->query("emei/qunliao") != 1)
    return notify_fail("你还不会这项技能！\n");
  if ((int)me->query("mana") < 500)
    return notify_fail("你的法力不够。\n");

  message_vision("$N化五行之气为己方所用，大家顿觉身体又充满力量。\n", me);
  for (i = 0; i < count; i++) {
    if (team[i] != 0 && environment(team[i]) == environment(me))
      team[i]->receive_curing("kee", 15 + (int)me->query_skill("buddhism") / 3);
  }

  me->add("force", -50);
  me->add("mana", -500);
  me->set("force_factor", 0);
  me->set("mana_factor", 0);
  if (me->is_fighting()) me->start_busy(random(2));

  return 1;
}
