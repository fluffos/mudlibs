//modified by bugbug 2001.11.18

//last updated by bugbug 2002.1.31
//出家人慈悲为怀，busy为主 :)

#include <ansi.h>
#include <combat.h>

inherit SSERVER;

int perform(object me, object target)
{
	string msg;
	int extra, mydh, hisdh,damage;
	object weapon;
	if(me->is_busy())
		return notify_fail("你现在没空！！\n");
	extra = me->query_skill("bighammer",1) ;
        if(me->query("family/family_name")!="南海普陀山")
                return notify_fail("你并非出家和尚不能用大势锤！\n");
	if ( extra < 100) return notify_fail("你的[大势锤]还不够纯熟！\n");

	if( !target ) target = offensive_target(me);
	if( !target
	||	!target->is_character()
	||	!me->is_fighting(target) )
		return notify_fail("［大势将至］只能对战斗中的对手使用。\n");
	if (!((string)me->query("bonze/class") =="bonze" )) 
        return notify_fail("[大势将至]只有出家人才能使用。\n");
    if((int)me->query("force") < 500 ) return notify_fail("你的内力不足！\n");
    if((int)me->query("sen") < 200 ) return notify_fail("你无法集中精力！\n");
    me->add("force", -200);
    me->receive_damage("sen", 50);
    me->receive_damage("kee", 50+random(50));
	weapon = target->query_temp("weapon");
if(me->query("max_mana") < 6000)
    mydh = (((int)me->query("combat_exp")/100)*(int)me->query("max_mana"))/10;
else  mydh = ((int)me->query("max_mana")/100)*((int)me->query("combat_exp")/100)*10;
if(me->query_temp("putuo_set")) mydh += mydh/2;
    if( mydh < 1 )
        mydh = 1;
if(target->query("max_mana") < 6000)
    hisdh= (random(((int)target->query("combat_exp")/100)*((int)target->query("max_mana")+1)))/10;
else  hisdh= (random(((int)target->query("max_mana")+1)/100*((int)target->query("combat_exp")/100)*100))/10;
	message_vision(HIR "\n$N身形立定口诵佛号，$n只觉得一种巨大的压力扑面而来！\n" NOR,me,target);

    if( hisdh < 1 )
        hisdh = 1;

if(hisdh < mydh*4/5)	
{
    if (hisdh<mydh/5)
    {
	// 4/5中的 1/5
    	message_vision(HIR "\n$n不堪重压，身子象要爆开一般，奇痛无比！波的喷出一口鲜血！\n " NOR,me,target);
    	damage=random((int)me->query("max_mana")/2)+200+me->query_skill("hammer",1);
		damage = damage*8/10;
if(me->query_temp("putuo_set")) damage += damage/2;
	if(damage>target->query("kee")*2/3)	
		damage=target->query("kee")*2/3; 
    }
    else 
    	if (hisdh<mydh/2)
    	{
    		message_vision(HIR "\n$n暗运内力向抗，但还是喷出一口鲜血！\n " NOR,me,target);
    		damage=random((int)me->query("max_mana")/3)+100+me->query_skill("hammer",1)/2;
			damage = damage*8/10;
		if(damage>target->query("kee")/2)
			damage=target->query("kee")/2;
    	}
	else
	{
		message_vision(HIY "\n$n受到轻微的震伤!\n" NOR,me,target);
		damage=random((int)me->query("max_mana")/10)+20+me->query_skill("hammer",1)/5;
		damage = damage*8/10;
		if(damage>target->query("kee")/3)
			damage=target->query("kee")/3;

	}
    target->receive_damage("kee",damage,me,"magic");
    target->receive_wound("kee",damage/3);
    COMBAT_D->report_status(target);

    if ( hisdh/6<random(mydh) )
    {
    	if ( weapon )
    	{
    		message_vision(HIR "\n$n眼见大势已去，放下手中兵器" NOR, me,target);
    		weapon->unequip();
    	}
	message_vision(
        HIR "\n$n被$N的佛法感化，跪倒在地已经忘记了自己还在战斗之中！\n\n" NOR, me,target);
 
	damage=random(extra/30);
    	if (damage>6) damage=6;//max 6
        target->start_busy(4+damage);
    }

}
else 
{
//1/5概率
    message_vision(
    HIB "\n$n暗运内力，逼回了这股劲风！\n" NOR, me, target);
}
    me->start_busy(2);

    me->improve_skill("bighammer", 1, 1);
	return 1;
}

