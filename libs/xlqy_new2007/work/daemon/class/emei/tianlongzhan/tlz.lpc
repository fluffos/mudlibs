#include <ansi.h>

inherit SSERVER;

#define CHANCE_LOSE_POINT 150

int perform(object me, object target) {
  object *inv, obj;
  int i, mypot, tapot, temp_dodge, temp_spells;

  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要对谁施展这一招「天龙斩」？\n");

  if (!me->is_fighting())
    return notify_fail("「天龙斩」只能在战斗中使用！\n");

  if ((int)me->query("max_force") < 2000)
    return notify_fail("你的内力不够！\n");

  if ((int)me->query("force") < 2000)
    return notify_fail("你的内力不足！\n");

  if ((int)me->query("sen") < 200)
    return notify_fail("你的精神不足，没法子施用外功！\n");

  if ((int)me->query_skill("tianlongzhan", 1) < 200)
    return notify_fail("你的天龙斩级别还不够，使用这一招会有困难！\n");
  if ((int)me->query("tianlongzhan/zhengqi_point") < 70)
    return notify_fail("你的天地正气不够，无法使用此招。\n");
  //modified by bugbug,2002.2
  //        if( time()-(int)me->query_temp("tlz_end") < 4 )
  //                   return notify_fail("你天龙斩还没使完，等等再用吧。\n");   // alading add


  message_vision(HIY "\n$N大喝一声，腾空而起，朝着$n方向落去！\n" NOR, me, target);


  mypot = (int)me->query_skill("blade");
  mypot = mypot * mypot * mypot / 8 + (int)me->query("combat_exp");

  tapot = (int)target->query_skill("parry");
  tapot = tapot + (int)target->query_skill("dodge") / 10;
  tapot = tapot * tapot * tapot / 10 + (int)target->query("combat_exp");

  //	write("mypot " + mypot + ", tapot " +tapot+ "\n");

  if (random(mypot + tapot) > tapot) {
    inv = all_inventory(target);
    i = sizeof(inv);

    if (i < 1) {
      target->start_busy(3);
      me->start_busy(1);
      me->start_call_out((: call_other, __FILE__, "tlz_effect", me, target :), 0);
      return 1;
    } else {
      if (target->query_temp("weapon")) {
        obj = target->query_temp("weapon");
        obj->unequip();
        obj->set("value", 0);
        message_vision(HIW "\n只听见「嚓」地一声，$N手中的" + obj->name() + "已被砍成两段！\n" NOR, target);
        obj->set("name", "断掉的" + obj->query("name"));
        obj->set("weapon_prop", 0);
        obj->set("armor_prop", 0);
        obj->move(environment(target));
        target->start_busy(2);
        me->start_busy(1);
        call_out("remove_broken_cloth", random(300) + 60, obj);
        me->start_call_out((: call_other, __FILE__, "tlz_effect", me, target :), 0);

        return 1;
      } else {
        target->start_busy(2);
        me->start_busy(1);
        me->start_call_out((: call_other, __FILE__, "tlz_effect", me, target :), 0);
        return 1;
      }
    }
  } else {
    message_vision(HIW "却被$N躲开了这凶险得一招！\n" NOR, target);
    me->add("force", -800);  // alading add
  }

  //    me->set_temp("tlz_end",time());   // alading add

  return 1;
}

void remove_broken_cloth(object obj) {
  if (obj && environment(obj)) {
    tell_object(environment(obj),
      "一阵微风吹过，" + obj->name() + "化为片片尘土，消失不见了。\n");
    destruct(obj);
  }
}
void tlz_effect(object me, object target) {
  int ap, damage, bp;
  string msg, str;
  int flag;
  object weapon = me->query_temp("weapon");
  if (weapon->query("id") == "tianlong zhan") flag = 4;
  else if (weapon->query("id") == "tianlong dao") flag = 3;
  else flag = 2;
  if (!target) return;
  if (environment(me) != environment(target)) return;

  ap = me->query_skill("tianlongzhan", 1);
  bp = ((int)me->query("combat_exp") + (int)me->query("daoxing")) / 12000;
  msg = HIR "\n$N仰天悲嘶,狂性大发,披头散发的向$n砍去!\n" NOR;
  damage = me->query_skill("blade") + me->query("force_factor") + bp;
  damage += me->query("tianlongzhan/zhengqi_point") * me->query("tianlongzhan/zhengqi_point") / 64;
  damage = damage * 8 / 10;
  if (damage > 9999) damage = 9999 + random(ap);
  damage = damage * flag / 2;
  target->receive_damage("kee", damage, me);
  target->receive_wound("kee", damage * 2 / 3, me);
  target->receive_damage("sen", damage, me);
  target->receive_wound("sen", damage * 2 / 3, me);
  target->start_busy(random(2) + 1);
  msg += HIW "\n当$n看见$N的刀光时，鲜血已从$n身上流下，好一招" + BLINK HIR "「天龙斩」\n" NOR;
  message_vision(msg, me, target);
  if (damage > 0) {
    COMBAT_D->report_status(target);
    COMBAT_D->report_sen_status(target);
  }

  if (!target->is_fighting(me)) {
    if (living(target)) {
      if (userp(target)) target->fight_ob(me);
      else target->kill_ob(me);
    }
  }
  if (target->query("eff_kee") < 0 || !living(target)) {
    str = target->name() + "被" + HIY "" + me->name() + "" + HIM "用峨嵋绝招" + HIW "「天龙斩」" NOR + HIM "砍成了两截.\n";
    message("channel:rumor", HIM "【小道消息】某人：" + str + "\n" NOR, users());
  }
  me->add("force", -1000 - me->query("force_factor"));
  me->start_busy(1);
  if (random(CHANCE_LOSE_POINT) == 1) {
    me->add("tianlongzhan/zhengqi_point", -1);
    tell_object(me, HIC "\n你感到身上的天地正气减弱了！\n" NOR);
  }  //bugbug,
  return;
}
