#include <ansi.h>

inherit SSERVER;

int cast(object me, object target) {
  int success_adj, damage_adj;

  success_adj = 160;
  damage_adj = 150;


  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要对谁用这[雷光拳]？\n");

  if ((int)me->query("mana") < 25 + 2 * (int)me->query("mana_factor"))
    return notify_fail("你的法力不够！\n");

  if ((int)me->query("sen") < 20)
    return notify_fail("你无法集中精力！去送死吗？\n");

  me->add("mana", -25 - 2 * (int)me->query("mana_factor"));
  me->receive_damage("sen", 10);

  if (random(me->query("max_mana")) < 50) {
    write("你很奇怪为什么必杀招不灵了？\n");
    return 1;
  }

  SPELL_D->attacking_cast(
    me,
    //attacker 
    target,
    //target
    success_adj,
    //success adjustment
    damage_adj,
    //damage adjustment
    "both",
    //damage type: could be "qi"/"kee", "shen"/"sen", ...default "both"
    HIY "$N 全身金光一闪，口中大喊一声，" NOR "" BLINK HIC "[雷光拳]" NOR "" HIY ",$N 左手聚光,右手握拳,顿时天地风起云涌,仿佛雷神动怒,一道雷光直劈向$n...\n" NOR,

    HIR "
                          @@@     @  @  @     @ @ @    
                        @@@@@@@    @ @ @      @@@@@    
                        @ @ @ @   @@@@@@@    @@@@@@@     
                        @@@@@@@      @      @ @@@@@ @  
                        @  @  @     @ @ @   @@@@@@@@@  
                        @@@@@@@    @  @@@      @@     
                                                          \n" NOR,

    //initial message
    HIY "一道金光闪过,$n被拳击中,“轰”的巨响,$n被炸飞了!\n" NOR,
    //success message
    HIW "但是$n静心战斗，竟不为所动.\n" NOR,
    //fail message
    HIR "但是雷光拳却好象失去了控制一样，在$N身前消失了!\n" NOR,
    //backfire initial message
    HIY "一道金光袭来,$n被雷光拳击中,“轰”的巨响,$n被轰飞了!\n" NOR
    //backfire hit message. note here $N and $n!!!
  );

  me->start_busy(1 + random(2));
  return 3 + random(5);
}
