#include <ansi.h>

inherit SSERVER;

int perform(object me, object target) {
  object weapon;

  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要对谁施展这[百捌式.荒咬]？\n");

  if (!me->is_fighting())
    return notify_fail("[百捌式.荒咬]只能在战斗中使用！\n");

  if ((int)me->query("force") < 300)
    return notify_fail("你的内力不够！\n");

  if ((int)me->query("kee") < 200)
    return notify_fail("你的气血不足，没法子施用外功！\n");

  if ((int)me->query_skill("caozhi-boji", 1) < 150)
    return notify_fail("你的[草稚流.古武术]级别还不够，使用这一招会有困难！\n");

  me->delete("env/brief_message");

  message_vision(
    "\n$N大喝一声,看我的必杀一击 -" HIY "[草稚流.古武术]" NOR "-" BLINK HIR "百捌式.荒咬" HIG ".." NOR "\n",
    me
  );


  me->set_temp("boji_per", 8);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
  message_vision("\n" HIY "荒咬一式" NOR "-------" BLINK HIR "轰阳斧\n" NOR, me);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
  message_vision("\n" HIY "荒咬二式" NOR "-------" BLINK HIG "琴月阴\n" NOR, me);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
  message_vision("\n" HIY "荒咬三式" NOR "-------" BLINK HIR "琴月阳\n" NOR, me);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
  message_vision("\n" HIY "荒咬四式" NOR "-------" BLINK HIR "暗勾手\n" NOR, me);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
  me->delete_temp("boji_per");

  me->receive_damage("kee", 50);
  me->add("force", -100);

  if (!target->is_fighting(me)) {
    if (living(target)) {
      if (userp(target)) target->fight_ob(me);
      else target->kill_ob(me);
    }
  }

  me->start_busy(2);
  return 1;
}
