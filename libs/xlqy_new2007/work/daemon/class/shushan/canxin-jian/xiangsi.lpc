#include <ansi.h>
#include <combat.h>
#include <condition.h>
inherit SSERVER;

int perform(object me, object target)
{       
        string msg="";
        int damage,wound;
        int temp_attack,temp_damage;
        object weapon=me->query_temp("weapon");
        if( !target ) target = offensive_target(me);
        if( !target
        ||      !target->is_character()
        ||      target->is_corpse()
        ||      target==me)
                return notify_fail("你要对谁施展「相思三剑」？\n");

        if(!me->is_fighting())
                return notify_fail("「相思三剑」只能在战斗中使用！\n");
        
        if(me->query("family/family_name")!="蜀山剑派")
                return notify_fail("非蜀山不能用「相思三剑」！\n");
        
        if(me->query("shushan/ask_zuidao_go") !=1 )
                return notify_fail("没有伤心的体会，用不了缠绵的「相思三剑」！\n");
        
        if (me->query_skill_mapped("force")!="zixia-shengong")
        	return notify_fail("「相思三剑」必须以紫霞神功做底子！\n");
        	
        if((int)me->query("max_force") < 500 )
                return notify_fail("你的内力不够！\n");

        if((int)me->query("force") < 300 )
                return notify_fail("你的内力不足！\n");
        if((int)me->query("sen") < 300 )
                return notify_fail("你的精神不足，没法子施用外功！\n");
        if((int)me->query_skill("zixia-shengong", 1) < 80)
                return notify_fail("你的紫霞神功修为还不够，使用这一招会有困难！\n");
        if((int)me->query_skill("canxin-jian", 1) < 80)
                return notify_fail("你的残心剑修为还不够，使用这一招会有困难！\n");
        if( me->query_temp("xiangsi_perform")>time())
		return notify_fail("相思情未散，歇息歇息吧！\n");
	me->delete("env/brief_message");
	target->delete("env/brief_message");
        message_vision(MAG"$N纵声长啸：情难消受美人恩,仗剑江湖为红颜！使出残心剑法绝学「相思三剑」！\n"NOR,me,target);
        me->add("force", -250);
        me->add("sen",-100);
	temp_attack=(int)me->query_skill("zixia-shengong",1)/10+(int)me->query_skill("canxin-jian",1)/10;
    temp_damage=(int)me->query_skill("zixia-shengong",1)/5+(int)me->query_skill("canxin-jian",1)/5;
if(me->query_temp("shushan_set")) {
temp_damage += temp_damage/2;
temp_attack += temp_attack/2;
}
	me->add_temp("apply/attack",temp_attack);
	me->add_temp("apply/damage",temp_damage);
        me->set("xiangsi", 8);
	damage=COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
	if( damage )
	{
	switch (random(6))
        {
         case 0:
              {
               message_vision(HIG"$n被剑意中的相思之苦感染，身中情毒！\n"NOR,me,target);
 target->apply_condition("xiangsi",5);
               break;
               }
         case 1:
              {
               message_vision(HIG"一股酒气冲向$n，$n似乎有了点酒意！\n"NOR,me,target);
 target->apply_condition("drunk",7);
               break;
              } 
         case 2:
              {
               message_vision(HIG"问世间情为何物？\n"NOR,me,target);
               message_vision(HIY"梦无痕，随风逝，仙灵如月长伴君．\n"NOR,me,target);  
 target->apply_condition("xiang_air",9);
               break;
              }
         default:
              {
               break;
              }
        }
	}
	me->set("xiangsi", 9);
	damage=COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
	if( damage )
	{
	switch (random(6))
        {
         case 0:
              {
               message_vision(HIG"$n被剑意中的相思之苦感染，身中情毒！\n"NOR,me,target);
target->apply_condition("xiangsi",5);
               break;
              }
         case 1:
              {
               message_vision(HIG"一股酒气冲向$n，$n似乎有了点酒意！\n"NOR,me,target);
 target->apply_condition("drunk",7);
               break;
              }
         case 2:
              {
               message_vision(HIG"问世间情为何物？\n"NOR,me,target);
               message_vision(HIG"梦无痕，随风逝，仙灵如月长伴君．\n"NOR,me,target);
 target->apply_condition("xiang_air",9);
               break;
              }
         default:
              {
         break;
              }
        }
	}
	me->set("xiangsi", 10);
	damage=COMBAT_D->do_attack(me, target, me->query_temp("weapon"));
	if(damage)
	{
	switch (random(6))
        {
         case 0:
              {
               message_vision(HIG"$n被剑意中的相思之苦感染，身中情毒！\n"NOR,me,target);
target->apply_condition("xiangsi",5);
               break;
              }
         case 1:
              {
               message_vision(HIG"一股酒气冲向$n，$n似乎有了点酒意！\n"NOR,me,target);
target->apply_condition("drunk",7);
               break;
              }
         case 2:
              {
               message_vision(HIG"问世间情为何物？\n"NOR,me,target);
               message_vision(HIG"梦无痕，随风逝，仙灵如月长伴君．\n"NOR,me,target);  
target->apply_condition("xiang_air",9);
               break;
              }
         default:
              {
               break;
               }
        }
	}
	me->delete("xiangsi");
	me->add_temp("apply/attack",-temp_attack);
	me->add_temp("apply/damage",-temp_damage);
	me->set_temp("no_move",1);
 me->set_temp("xiangsi_perform",time()+random(4)+4);
	call_out("remove_no_move",3+random(3),me);
	
	if( !target->is_fighting(me) ) {
                if( living(target) ) {
                        if( userp(target) ) target->fight_ob(me);
                        else target->kill_ob(me);
                }
        }
	if( !damage )
		COMBAT_D->do_attack(target, me, target->query_temp("weapon"));

        message_vision(HIG"$N的「相思三剑」用功完毕，气回丹田,缓缓收功.\n"NOR,me,target);
        message_vision(msg,me,target);
        return 1;
}

void remove_no_move(object me) 
{
  if (me) me->delete_temp("no_move");
}

