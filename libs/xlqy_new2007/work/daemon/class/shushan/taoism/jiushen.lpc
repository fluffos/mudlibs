//Cracked by Roath

//Ansi 99.8
#include <ansi.h>

inherit SSERVER;

int cast(object me, object target)
{
   string msg,sysmsg;
   int damage, ap;

   if(me->query("family/family_name") != "蜀山剑派" )
                return notify_fail("你是哪儿偷学来的武功！\n");

   if( !target ) target = offensive_target(me);

   if( !target
   ||   !target->is_character()
   ||   target->is_corpse()
   ||   target==me)
     return notify_fail("你要对谁施「酒神」？\n");

   if((int)me->query_skill("taoism", 1) < 100 )
     return notify_fail("你的天师仙法火候不够，哪可能呼唤出「酒神」！\n");
   if(!me->query("shushan/jiushen_master"))
     return notify_fail("你还不会「酒神」这种法术！\n");

   if((int)me->query("mana") < 500 )
     return notify_fail("你的法力不够，呼唤出「酒神」恐怕也没有什么用！\n");

   if((int)me->query("sen") < 10 )
     return notify_fail("你现在神智不清！\n");
 if(me->query("jiushen_used")> 9&&(me->query("jiushen_usedtime")+86400>time()))
  return notify_fail("「酒神」一天只能用九次！\n");
   if(me->query("jiushen_usedtime")+86400<time())
     me->set("jiushen_used",0);
      
   
   msg = HIW "$N集中全身精气，突然爆发，呼唤出「酒神」，产生惊天动地的震动！\n" NOR;
   msg += HIR "\n        
                      《#
                      @  @_                  
                    《    @    
                     @     @    
                     _*****_   
                   《    蜀  @  
                   @         @   
                    @   山    @  
    _________________@_______@______         
  《____________________________iiiiii)***  
                              @《^^^^^  *****
                                           ***\n"NOR;

   ap = me->query_skill("spells") ;
 //  damage = (me->query("force")/20+ me->query("mana"))/20;
   damage=random(me->query("force"))+random(me->query("mana"));
   damage += (int)me->query("sen")/5 + ap + (int)me->query("mana_factor") - random((int)target->query("mana_factor"));
        damage = damage + random(damage);
        if (damage > 10000) damage = 9900+ random(150);
if(me->query_temp("shushan_set")) damage += damage/2;
       
        msg += HIC "结果$n被「酒神」镇伤，全身气血逆流，眼冒金星，内力尽失！\n" NOR;
		if( damage > target->query("sen") )
			if(userp(target))
				damage=target->query("sen")-20;//防止pker用此pk
	
	
	me->set("mana", 0);
   	me->set("force",(int)me->query("force")/3);
   	me->set("kee",(int)me->query("kee")*2/3);
   	me->set("sen",(int)me->query("sen")/2);
   	me->add("jiushen_used",1);
   	if(me->query("jiushen_used")==1) me->set("jiushen_usedtime",time());	
	ap=(int)ap/50;
	if(ap>10) ap=8+random(3);
	ap=random(ap)+1;
	
	if(!userp(target))       //防止pker用此pk
	{ target->start_busy(ap);
	} 
	
	target->set("force",0);
        target->receive_wound("sen", damage, me);
        target->receive_wound("kee",damage/2,me);
        target->apply_condition("drunk",50);
        sysmsg=me->name()+"("+me->query("id")+")"+"使用酒神"+me->query("jiushen_used")+"次，造成了"+damage+"点伤害，使"+target->name()+"("+target->query("id")+")"+"busy了"+ap+"秒！\n";
	
        MONITOR_D->report_system_msg(sysmsg);
   	message_vision(msg, me, target);
   if( damage > 0 ) 
   {	
   	COMBAT_D->report_status(target);
   	COMBAT_D->report_sen_status(target);
    }
    
   if( !target->is_fighting(me) ) 
   {
     if( living(target) ) 
     {
        if( userp(target) ) target->fight_ob(me);
        else target->kill_ob(me);
     }
     me->kill_ob(target);
   }

   me->start_busy(3+random(3));
   return 30+random(20);
}

