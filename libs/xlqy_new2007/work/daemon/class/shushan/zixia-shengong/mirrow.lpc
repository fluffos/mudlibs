// by gamer
#include <ansi.h>

inherit F_CLEAN_UP;


void remove_mirrow(object me, int effect, int skill);

int exert(object me, object target) {
  int skill, effect, atk;
  int fatigue;
  string level;
  me = this_player();
  if (!target) target = me;


  if ((int)me->query_skill("zixia-shengong", 1) < 120)
    return notify_fail("你的紫霞神功修为不足。\n");
  if (me->query("family/family_name") != "蜀山剑派")
    return notify_fail("你非蜀山剑派弟子，哪里知道如何运用魔镜！\n");
  if ((int)me->query("force") < 1000)
    return notify_fail("你的内力不够。\n");
  if ((int)me->query("kee") < 300)
    return notify_fail("你的气血不足。\n");
  if ((int)me->query("sen") < 300)
    return notify_fail("你的精神不足。\n");
  if ((int)target->query_temp("in_mirrow")) {
    tell_object(me, target->name() + "已经受到「魔镜之光」的影响了!\n");
    return 1;
  }
  if (!target->is_character())
    return notify_fail("你要对谁用魔镜？\n");
  message_vision(MAG "$N静心凝神，双手虚抱，所围之处慢慢凝出一团紫雾渐渐的将$n包了起来。\n" NOR, me, target);
  tell_object(target, HIM "你觉得全身上下被一层似有质却无形的东西裹着！\n" NOR);

  skill = me->query_skill("force");
  me->add("force", -360);
  me->receive_damage("kee", 120);
  me->receive_damage("sen", 120);

  skill = skill * 3 / 4 + random(skill / 3);
  level = me->query("skill_level/force");
  if (target != me)
    skill = skill / 2 + random(skill / 2);
  effect = 1;
  if (level == "expert") {
    target->add_temp("apply/magicback_damage", skill * 2);
    effect = 2;
  } else if (level == "master") {
    target->add_temp("apply/magicback_damage", skill * 3);
    effect = 3;
  }

  else if (level == "grandmaster") {
    target->add_temp("apply/magicback_damage", skill * 4);
    effect = 4;
  } else target->add_temp("apply/magicback_damage", skill);


  target->set_temp("in_mirrow", 1);


  target->start_call_out((: call_other, __FILE__, "remove_mirrow", target, effect, skill :), skill);


  if (me->is_fighting()) me->start_busy(3);

  return 1;
}

void remove_mirrow(object me, int effect, int skill) {
  if (!me) return;
  if (me->query_temp("in_mirrow")) {
    me->delete_temp("in_mirrow");
    if (effect == 1)
      me->add_temp("apply/magicback_damage", -skill);
    else if (effect == 2)
      me->add_temp("apply/magicback_damage", -2 * skill);
    else if (effect == 3)
      me->add_temp("apply/magicback_damage", -3 * skill);
    else if (effect == 4)
      me->add_temp("apply/magicback_damage", -4 * skill);
    tell_object(me, "你所受到的「魔镜之光」效果消失了!\n");

  }
}
