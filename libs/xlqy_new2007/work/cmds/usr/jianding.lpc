#include <ansi.h>
inherit F_CLEAN_UP;

int main(object me, string arg) {
  object ob;
  int kind, level;
  string des, temp;
  mapping prop;
  if (!arg)
    return notify_fail("你要鉴定什么？\n");
  if (!ob = present(arg, me))
    return notify_fail("你要鉴定什么？\n");
  if (ob->query("identification"))
    return notify_fail("这件东西已经鉴定过了！\n");

  if (!ob->is_diablo_ob())
    return notify_fail("这件东西需要鉴定么？！\n");
  kind = ob->query("grade");  //grade 0--4
  level = ob->query("level");  // level = 5*(1--4)

  if (me->query_skill("literate") < level * 25 + kind * 15)
    return notify_fail("哎呀，依你现在的知识水平，恐怕鉴定不出这是什么东西。\n");
  message_vision("$N捧着$n上上下下仔仔细细的打量了一遍，终于明白$n上面那些稀奇古怪的花纹是什么含义了。\n", me, ob);
  ob->set("identification", 1);
  /*
        if(ob->query("desc"))
                des = ob->query("desc");
else des ="";
        temp = CYN"★★★★★★★★★★★★★★"NOR+ob->query("name")+NOR+"("+ob->query("id")+")"+CYN"★★★★★★★★★★★★★★★\n\n"NOR;
        des +=  temp;
        temp = HIY"★"NOR+MAG"基本属性：\n"NOR;
        des += temp;
        if(ob->query("weapon_prop/damage"))
 temp = "                武器杀伤力:"+HIC+ob->query("diablo_prop/damage")/2+"---  "+ob->query("diablo_prop/damage")+"        等级:"+level+"       品级:"+kind+NOR+"\n";
        else if(ob->query("armor_prop/armor"))
                temp = "                盔甲保护力:"+HIC+ob->query("diablo_prop/armor")+NOR+"  耐久度:"+HIC+ob->query("diablo_prop/rigidity")+NOR+" 宝石孔:"+HIC+ob->query("diablo_prop/can_inset")+NOR+"  等级:"+HIC+ob->query("level")+NOR+"\n";

        des += temp;
        temp = HIY"★"NOR+MAG"附加属性：\n"NOR;
        des += temp;
        if(!mapp(prop=ob->query("diablo_prop"))|| sizeof(prop) < 1)
                des +="\n";
        if(ob->query("grade") == 0)
                ob->set("name",HIW+ob->query("name")+NOR);
        else if(ob->query("grade") == 1)
                ob->set("name",HIG+ob->query("name")+NOR);
        else if(ob->query("grade") == 2)
                ob->set("name",HIB+ob->query("name")+NOR);
        else if(ob->query("grade") == 3)
                ob->set("name",HIR+ob->query("name")+NOR);
        else if(ob->query("grade") == 4)
                ob->set("name",HIY+ob->query("name")+NOR);
*/
  tell_object(me, "/obj/diablo_ob/diablo"->query_desc(ob));
  return 1;

