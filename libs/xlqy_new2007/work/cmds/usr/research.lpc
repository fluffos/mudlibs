//gamer@88 200403
#include <ansi.h>
inherit F_CLEAN_UP;
void add_skill(string arg, object me, string skill);

int main(object me, string arg) {
  int amount;
  if (!arg) return notify_fail("请选择你要增加的技能，参见help research。\n");
  if (me->is_busy()) return notify_fail("你正忙着呢...\n");
  if (!me->query_skill(arg, 1))
    return notify_fail("你不会这项技能啊...\n");
  if (me->query("skills_point") - me->query("skillsed_point") <= 0)
    return notify_fail("你的技能点数不足！\n");

  amount = (me->query_skill(arg, 1) - 200) / 100;
  if (amount < 1) amount = 1;
  if (me->query("skills_point") - me->query("skillsed_point") < amount)
    return notify_fail("你的技能点数不足，你需要" + chinese_number(amount) + "点技能点数！\n");
  me->start_busy(1);
  printf("确实要增加" + to_chinese(arg) + "吗？(y/n)\n");
  input_to((: add_skill :), me, arg);
  return 1;

}
void add_skill(string arg, object me, string skill) {
  int amount;
  if (!arg) return;
  if (arg != "y" && arg != "yes")
    return;
  amount = (me->query_skill(skill, 1) - 200) / 100;
  if (amount < 1) amount = 1;
  printf("你的" + to_chinese(skill) + "增加了一点！\n");
  me->improve_skill(skill, 1);
  me->add("skillsed_point", amount);

  return;
}
int help(object me) {
  write(@HELP
指令格式 : research <技能>

这个指令可以将你积攒的技能点数增加到某个技能上去。
如果该技能达到可以升级的点数，则会自动升级。
 
see also : help skills,help attribute
HELP
  );
  return 1;
}
