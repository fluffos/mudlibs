#include <ansi.h>
inherit F_CLEAN_UP;

int report(object me, string name);
int help(object me);

mapping name_location = ([
  "风灵珠": "/d/obj/baowu/fengzhu",
  "水灵珠": "/d/obj/baowu/shuizhu",
  "火灵珠": "/d/obj/baowu/huozhu",
  "雷灵珠": "/d/obj/baowu/leizhu",
  "圣灵珠": "/d/obj/baowu/shengzhu",
  "土灵珠": "/d/obj/baowu/tuzhu",
  "金箍棒": "/d/dntg/donghai/obj/jingubang",
  "旧白布搭包": "/d/qujing/xiaoxitian/obj/baoreal",
  "紫金红葫芦": "/d/qujing/pingding/obj/hulureal",
  "羊脂玉净瓶": "/d/qujing/pingding/obj/pingreal",
  "捆仙索": "/d/obj/fabao/kunxian-suo",
  "混天绫": "/d/obj/fabao/huntian-ling",
  "乾坤圈": "/d/obj/fabao/qiankun-quan",
  "金刚琢": "/d/qujing/jindou/obj/zhuoreal",
  "幌金绳": "/d/qujing/pingding/obj/shengreal",
  "龙头拐杖": "/d/penglai/npc/obj/guai",
]);

int main(object me, string arg) {
  string *name = keys(name_location);

  if (time() - me->query_temp("scan_time") < 5)
    return notify_fail("等等，系统喘气中......\n");

  me->set_temp("scan_time", time());


  if (!arg) {
    help(me);
    return 1;
  }

  if (me->is_busy())
    return notify_fail("你正忙着呢。\n");

  if (me->query("sen") < 100)
    return notify_fail("你的精神不够。\n");

  me->add("sen", -30);

  if (arg == "all") {
    tell_object(me, "\n");
    foreach (string temp in name)
      report(me, temp);
    return 1;
  }

  report(me, arg);
  return 1;
}

int report(object me, string name) {
  string location, msg;
  object *obj_list, owner;

  if (undefinedp(location = name_location[name])) {
    help(me);
    return 1;
  }

  msg = location->in_mud() ? HIR "已经" NOR : HIC "  不" NOR;
  msg += "存在" + name + "。";

  obj_list = children(location);
  if (sizeof(obj_list) > 2) {
    CHANNEL_D->do_channel(this_object(), "sys",
      "错误！出现多个" + name + "持有者。\n");
  }
  owner = environment(obj_list[0]);

  if (!owner || !objectp(owner) || !userp(owner))
    msg += "无法断定拥有者或为NPC。\n";
  else
    msg += "此人为(" + getuid(owner) + ")。\n";

  tell_object(me, msg);
  return 1;
}

int help(object me) {
  string *name = keys(name_location);

  write(@HELP
指令格式 : unique <法宝中文名称> | all

这个指令告诉你所指定的法宝是否已经被玩家持有。
如果使用参数all则列出所有法宝状态。

HELP
  );
  write("以下为法宝中文名称列表:\n");
  write("=======================================\n");
  foreach (string temp in name)
    write(temp + "\n");
  write("=======================================\n");
  return 1;
}
