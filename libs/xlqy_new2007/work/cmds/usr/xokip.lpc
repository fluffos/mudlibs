#include <login.h>;
inherit F_CLEAN_UP;
object make_body(object ob);
void create() {
  seteuid(getuid());
}

int main(object me, string arg) {
  object ob, link_ob, user;
  if (!arg)
    return notify_fail("用法:xokip ID\n");
  if (time() - me->query_temp("scan_time") < 5)
    return notify_fail("等等，系统喘气中......\n");
  me->set_temp("scan_time", time());

  //		return 1;
  ob = find_player(arg);
  if (!ob) {
    ob = new(LOGIN_OB);
    ob->set("id", arg);
    if (!ob->restore())
      return notify_fail("没有这个玩家。\n");
    else {
      if (objectp(user = make_body(ob)))
        if (user->restore()) {
          reset_eval_cost();
          user->set_temp("link_ob", ob);
          ob->set_temp("body_ob", user);
          user->set_encoding(ob->query_encoding());

          if ((string)user->query("env/allowed_player") != (string)getuid(me) && !wizardp(me)) {
            destruct(ob);
            destruct(user);
            return notify_fail("人家不允许你删除它的okip。\n");
          }


          user->delete("ok_ip");
          tell_object(me, "玩家" + user->query("id") + "（ " + user->query("name") + " ）的okip已经删除\n");
          ob->save();
          user->save();
          destruct(ob);
          destruct(user);
          return 1;
        }
    }
  }
  link_ob = ob;
  if (link_ob) {
    if ((string)link_ob->query("env/allowed_player") != (string)getuid(me) && !wizardp(me)) {
      return notify_fail("人家不允许你删除它的okip。\n");
    }

    link_ob->delete("ok_ip");
    link_ob->save();
    tell_object(me, "玩家" + ob->query("id") + " （ " + ob->query("name")
      + " ）的okip已经删除\n");
    return 1;
  } else
    return notify_fail("错误。无法进行修改。\n");
  return 1;
}

object make_body(object ob) {
  string err;
  object user;
  int n;

  if (!ob->query("body")) {
    return 0;
  }
  user = new(ob->query("body"));
  if (!user) {
    write("现在可能有人正在修改玩家物件的程式，无法进行复制。\n");
    write(err + "\n");
    return 0;
  }
  seteuid(ob->query("id"));
  export_uid(user);
  export_uid(ob);
  seteuid(getuid());

  user->set("id", ob->query("id"));
  user->set_name(ob->query("name"), ({ ob->query("id") }));
  return user;
}


int help(object me) {
  write(@HELP
指令格式 : xokip ID

这个指令可以删除玩家的okip,但是你必须是那个被删除
玩家所制定的ID.同时参考命令okip.
用此命令是为了防止紧急时刻在别处上机而设置的。否则
你就只能从允许的ip上线，此命令用后，指定玩家的okip
会被删除（无论在线与否）
HELP
  );
  return 1;
}
