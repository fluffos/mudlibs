#include <ansi.h>
inherit F_CLEAN_UP;

int check_add_max(int max);
int check_sub_max(int max);

int main(object me, string arg)
{
        object ob;
        mapping my;
        int dao,x,i;
        int max,maxx;
        string str;
        seteuid(getuid(me));
        
        if(!arg) ob = me;
        else if (wizardp(me)) { ob = present(arg, environment(me));
             if (!ob) ob = find_player(arg);
             if (!ob) ob = find_living(arg);
        if (!ob) return notify_fail("您要察看谁的状态？\n");
        } 
		else return notify_fail("只有巫师才可以察看别人的状态。\n");

      
        printf(NOR CYN"┏━━━━━━━━━━━━━━"HIY"X"HIR"·"HIY"L"HIR"·"HIY"Q"HIR"·"HIY"Y"NOR CYN"━━━━━━━━━━━━━━┓\n"NOR);
        printf(NOR CYN"┃"NOR WHT" 个人状态"NOR CYN" 姓 名："NOR WHT"%-12s "NOR CYN" 性别："NOR WHT"%-10s "NOR CYN"I D："NOR WHT"%-13s"NOR CYN"┃\n"NOR,ob->name(),ob->query("gender"),"["+capitalize(ob->query("id"))+"]");
        printf(NOR CYN"┣━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┫\n"NOR);
        printf(NOR CYN"┃		     攻击            	           防御             ┃\n"NOR);
        printf(NOR CYN"┃		            	      		                    ┃\n"NOR);
        max = check_add_max(ob->query_temp("apply/add_max_jin")/100);
        maxx = ob->query_temp("apply/add_jin");
        
        printf(NOR CYN"┃"NOR CYN"〖" HIB" 雷系"NOR+CYN" 〗"NOR+	"%s %7d%%"NOR WHT"(+%5d — %-5d)"NOR    , (max >= 175)? HIY: WHT,max , maxx/2,maxx*3/2);
       
        max = check_sub_max(ob->query_temp("apply/sub_max_jin")/100);
        maxx = ob->query_temp("apply/sub_jin");
        if(ob->query_temp("apply/immune_jin"))
        printf(HIW"%26s"NOR CYN"             ┃\n"NOR ,"免疫");
        else printf(WHT"%7s %s%5d%%"NOR WHT"(+%5d)"NOR CYN"        ┃\n"NOR ," ", (max >= 75)? HIY: WHT,max , maxx);
       
        max = check_add_max(ob->query_temp("apply/add_max_mu")/100);
        maxx = ob->query_temp("apply/add_mu");
       
        printf(NOR CYN"┃"NOR CYN"〖" HIG" 毒系"NOR+CYN" 〗"NOR+	"%s %7d%%"NOR WHT"(+%5d — %-5d)"NOR    , (max >= 175)? HIY: WHT,max , maxx*3/4,maxx*6/5);
      
        max = check_sub_max(ob->query_temp("apply/sub_max_mu")/100);
        maxx = ob->query_temp("apply/sub_mu");
         if(ob->query_temp("apply/immune_mu"))
        printf(HIW"%26s"NOR CYN"             ┃\n"NOR ,"免疫");
        else
       printf(WHT"%7s %s%5d%%"NOR WHT"(+%5d)"NOR CYN"        ┃\n"NOR ," ", (max >= 75)? HIY: WHT,max , maxx);
      
         max = check_add_max(ob->query_temp("apply/add_max_shui")/100);
        maxx = ob->query_temp("apply/add_shui");
     
         printf(NOR CYN"┃"NOR CYN"〖" HIC" 冰系"NOR+CYN" 〗"NOR+	"%s %7d%%"NOR WHT"(+%5d — %-5d)"NOR    , (max >= 175)? HIY: WHT,max , maxx*4/5,maxx*4/3);
      
         max = check_sub_max(ob->query_temp("apply/sub_max_shui")/100);
           maxx = ob->query_temp("apply/sub_shui");
        if(ob->query_temp("apply/immune_shui"))
        printf(HIW"%26s"NOR CYN"             ┃\n"NOR ,"免疫");
        else
         printf(WHT"%7s %s%5d%%"NOR WHT"(+%5d)"NOR CYN"        ┃\n"NOR ," ", (max >= 75)? HIY: WHT,max , maxx);
      
         max = check_add_max(ob->query_temp("apply/add_max_huo")/100);
        maxx = ob->query_temp("apply/add_huo");
      
        printf(NOR CYN"┃"NOR CYN"〖" HIR" 火系"NOR+CYN" 〗"NOR+	"%s %7d%%"NOR WHT"(+%5d — %-5d)"NOR    , (max >= 175)? HIY: WHT,max , maxx,maxx*5/4);
      
        max = check_sub_max(ob->query_temp("apply/sub_max_huo")/100);
        maxx = ob->query_temp("apply/sub_huo");
        if(ob->query_temp("apply/immune_huo"))
        printf(HIW"%26s"NOR CYN"             ┃\n"NOR ,"免疫");
        else
         printf(WHT"%7s %s%5d%%"NOR WHT"(+%5d)"NOR CYN"        ┃\n"NOR ," ", (max >= 75)? HIY: WHT,max , maxx);
      
        max = check_add_max(ob->query_temp("apply/add_max_phy")/100);
        maxx = ob->query_temp("apply/add_phy");
      
        printf(NOR CYN"┃"NOR CYN"〖" HIM" 物理"NOR+CYN" 〗"NOR+	"%s %7d%%"NOR WHT"(+%5d — %-5d)"NOR    , (max >= 175)? HIY: WHT,max , maxx*5/6,maxx*9/8);
        max = check_sub_max(ob->query_temp("apply/sub_max_phy")/100);
        maxx = ob->query_temp("apply/sub_phy");
       if(ob->query_temp("apply/immune_phy"))
        printf(HIW"%26s"NOR CYN"             ┃\n"NOR ,"免疫");
        else
        printf(WHT"%7s %s%5d%%"NOR WHT"(+%5d)"NOR CYN"        ┃\n"NOR ," ", (max >= 75)? HIY: WHT,max , maxx);
        
        max = check_add_max(( ob->query_temp("apply/add_max_spells_kee")+ob->query_temp("apply/add_max_spells_all"))/100);
        maxx =  ob->query_temp("apply/add_spells_kee")+ob->query_temp("apply/add_spells_all");
       
         printf(NOR CYN"┃"NOR CYN"〖" HIY" 魔法气血"NOR+CYN" 〗"NOR+	"%s%4d%%"NOR WHT"(+%5d — %-5d)"NOR    , (max >= 175)? HIY: WHT,max , maxx*2/3,maxx*8/7);
      //  printf(NOR CYN"┃"NOR CYN"〖" HIY" 魔法气血"NOR+CYN" 〗"NOR+	WHT"%4d%%(+%5d)"NOR     ,max ,maxx);
      
        max = check_sub_max((ob->query_temp("apply/sub_max_spells_kee")+ob->query_temp("apply/sub_max_spells_all"))/100);
         maxx = ob->query_temp("apply/sub_spells_kee")+ob->query_temp("apply/sub_spells_all");
      if(ob->query_temp("apply/immune_magic"))
        printf(HIW"%26s"NOR CYN"             ┃\n"NOR ,"免疫");
        else
        printf(WHT"%7s %s%5d%%"NOR WHT"(+%5d)"NOR CYN"        ┃\n"NOR ," ", (max >= 75)? HIY: WHT,max , maxx);
     
        max = check_add_max(( ob->query_temp("apply/add_max_spells_sen")+ob->query_temp("apply/add_max_spells_all"))/100);
        maxx =  ob->query_temp("apply/add_spells_sen")+ob->query_temp("apply/add_spells_all");
       
         printf(NOR CYN"┃"NOR CYN"〖" HIY" 魔法精神"NOR+CYN" 〗"NOR+	"%s%4d%%"NOR WHT"(+%5d — %-5d)"NOR    , (max >= 175)? HIY: WHT,max ,maxx*2/3,maxx*8/7);

      //  printf(NOR CYN"┃"NOR CYN"〖" HIY" 魔法精神"NOR+CYN" 〗"NOR+	WHT"%4d%%(+%5d)"NOR     ,max, maxx);
      
      
        max = check_sub_max((ob->query_temp("apply/sub_max_spells_sen")+ob->query_temp("apply/sub_max_spells_all"))/100);
        maxx = ob->query_temp("apply/sub_spells_sen")+ob->query_temp("apply/sub_spells_all");
       if(ob->query_temp("apply/immune_magic"))
        printf(HIW"%26s"NOR CYN"             ┃\n"NOR ,"免疫");
        else
          printf(WHT"%7s %s%5d%%"NOR WHT"(+%5d)"NOR CYN"        ┃\n"NOR ," ", (max >= 75)? HIY: WHT,max , maxx);
      
        printf(NOR CYN"┣━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┫\n"NOR);
        max = ob->query_temp("combat/bless");
        if(max >= 10) { max = 10;str = HIY;}
        else if(max <= -10) {max = -10;str = RED;}
        else str = WHT;
        printf(NOR CYN"┃"NOR MAG"    〖 祝福 〗  "NOR "%s%3d"NOR , str,max);
        max = ob->query_temp("combat/lucky");
        if(max >= 10) { max = 10;str = HIY;}
        else if(max <= -10) {max = -10;str = RED;}
        else str = WHT;
        
        printf(NOR CYN""NOR MAG"  〖 幸运 〗   "NOR "%s%3d"NOR ,str,max);
        
        max = ob->query_temp("apply/magic_find")/100;
        if(ob->query("age") > 17)
        {	max += ob->query_kar();
               printf(NOR CYN""NOR MAG" 〖 物品找寻 〗"NOR WHT"%7d%%"NOR CYN"%6s┃\n"NOR ,max," ");
        } 
        
        else
        {
         	max = 0;
        	printf(NOR CYN""NOR MAG" 〖 物品找寻 〗"NOR  HIY"%6s"NOR CYN"      ┃\n"NOR ,"暂时保密");
	}
        printf(NOR CYN"┗━━━━━━━━━━━━━━"HIY"X"HIR"·"HIY"L"HIR"·"HIY"Q"HIR"·"HIY"Y"NOR CYN"━━━━━━━━━━━━━━┛\n"NOR);

	
        printf("\n");   
        return 1;
}
int check_add_max(int max)
{
	if(max > 175) max = 175;	
	
	return max;
}
int check_sub_max(int max)
{
	if(max > 75) max = 75;	
	
	return max;
}
int help(object me)
{
        write(@HELP
指令格式 : wx
           wx <对象名称>                   (巫师专用)
 
这个指令可以显示你(你)或指定对象(含怪物)的五行攻击防御等属性。
 
see also : score,help wuxing
HELP
    );
    return 1;
}
 

