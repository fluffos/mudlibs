// respirate.c

#include <skill.h>
#define GIN_PER_TIME 20
inherit F_CLEAN_UP;
int finishb(object me);

int main(object me, string arg) {
  int gin_cost, busy_time;
  object where = environment(me);
  return 1;
  seteuid(getuid());

  if (environment(me)->query("no_fight") ||
    environment(me)->query("no_magic"))
    return notify_fail("安全区内禁止练功。\n");

  if (!arg
    || !sscanf(arg, "%d", gin_cost))
    return notify_fail("你要花多少精力修行？\n");

  if (gin_cost <= 0 && me->query_temp("pending/respriating")) {

    call_out("finish", 1, me);
    return 1;
  }

  if (me->is_busy() || me->query_temp("pending/respriating"))
    return notify_fail("你现在正忙着呢。\n");

  if (me->is_fighting())
    return notify_fail("战斗也是一种修行，但不能和灵力的修行同时进行。\n");

  //    if( !stringp(me->query_skill_mapped("magic")) )
  //           return notify_fail("你必须先用 enable 选择你要用的魔法口诀。\n");

  if (gin_cost < GIN_PER_TIME) return notify_fail("你最少要花 20 点「精力」才能修行。\n");

  if ((int)me->query("gin") < gin_cost)
    return notify_fail("你现在精力不足，无法修行灵力！\n");
  if ((int)me->query("kee") * 100 / (int)me->query("max_kee") < 70)
    return notify_fail("你现在身体状况太差了，无法集中精神！\n");

  if ((int)me->query("sen") * 100 / (int)me->query("max_sen") < 70)
    return notify_fail("你现在精神状况太差了，无法控制自己的心灵！\n");
  write("你闭上眼睛默念魔法口诀，开始修行灵力。\n");

  busy_time = gin_cost / GIN_PER_TIME;
  me->start_busy(busy_time * 2 + 1);
  me->set_temp("pending/respriating", 1);
  call_out("exec_int", 1, me, where, busy_time);
  return 1;
}
int exec_int(object me, object where, int busy_time) {
  object wherenow;
  int atman_gain;
  wherenow = environment(me);

  if (!me) return 1;

  if (wherenow != where) {
    //              remove_call_out("exec_int");
    finishb(me);
    return 1;
  }

  if (!me->query_temp("pending/respriating")) return 1;

  if (!living(me)) return finishb(me);

  atman_gain = (int)me->query_skill(
    "magic",
    1
  ) / 10 + (int)me->query_spi() / 4 + (int)me->query_con() / 4 + random(3);

  if (atman_gain > 40) atman_gain = 40;

  atman_gain *= 3;
  atman_gain = atman_gain * GIN_PER_TIME / 20;
  me->receive_damage("gin", GIN_PER_TIME);
  me->add("atman", atman_gain);

  if ((int)me->query("atman") > (int)me->query("max_atman") * 2) {
    if ((int)me->query("max_atman") >= (int)me->query_max_atman()) {
      tell_object(me, "你忽然觉得一阵天旋地转，头涨得像要裂开一样，似乎灵力的修行已经遇到了瓶颈。\n");
      me->set("atman", 2 * me->query("max_atman") - 1);
    } else {
      tell_object(me, "你的灵力增强了！\n");
      me->add("max_atman", 1);
      if ((int)me->query("max_atman") > (int)me->query("maximum_atman"))
        me->set("maximum_atman", (int)me->query("max_atman"));
      me->set("atman", me->query("max_atman"));
    }
    //                remove_call_out("exec_int");
    call_out("finish", 1, me);
    return 1;
  }
  if (busy_time > 1) {
    busy_time--;
    call_out("exec_int", 1, me, where, busy_time);
  } else {
    call_out("finish", 1, me);
  }
  return 1;
}
int finishb(object me) {
  me->delete_temp("pending/respriating");
  me->start_busy(1);
  return 1;
}
int finish(object me) {
  me->delete_temp("pending/respriating");
  me->start_busy(1);
  tell_object(me, "你修行完毕，缓缓张开眼睛。\n");
  return 1;
}

int help(object me) {
  write(@HELP
指令格式 : respirate|tuna [<耗费「精力」的量>]
           respirate|tuna 0 ：停止修炼

吐呐修行，利用「炼精化气，炼气化神，炼神还虚」的方法将你的精力
转变成灵力。 

请参考 help stats
HELP
  );
  return 1;
}
