#include <ansi.h>
inherit F_CLEAN_UP;

int main(object me, string arg)
{	int max_guard;
        object soldier;
        string where;
        int strategy,leadership, exp, title;
        max_guard=1;
        if ((string)me->query("family/family_name") != "将军府")
        return notify_fail("你又不是朝廷命官，大内高手怎么会来助你！\n");
   
    	if(environment(me)->query("no_alert"))
                return notify_fail("此地已不属官府管辖范围，只能靠你自己的能力了，加油！\n");
         
        if(!me->query("degree"))
                  return notify_fail("你尚未入朝为官，大内高手是不会来助你的。\n");
	if(me->is_busy())
                return notify_fail("你现在正忙着呢，无法长啸告警。\n");
                
        strategy = (int)me->query_skill("strategy",1);
        leadership = (int)me->query_skill("leadership",1);
        exp = (int)me->query("combat_exp");
        if(strategy < 80 || leadership < 80)
        return notify_fail("你兵法和用人之技太差了，没人愿意理你！\n"); 
        if (exp<10000)
        return notify_fail("你的经验太低了，还不能啸警。\n");
         max_guard=(leadership+strategy)/150;        
        if (max_guard<1) max_guard = 1;
        if (max_guard>5) max_guard = 5;
 if(environment(me)->query("no_alert2")&&max_guard > 2)
              max_guard = 2;
        if(leadership>300)
                leadership=300;
        if(time()-me->query_temp("alert_time")<360-leadership)
                 return notify_fail("哪有那么多大内高手随时来保护你啊！\n");
        if( !me->is_fighting() )
        return notify_fail("好象没有人要杀你！\n");
        if((int)me->query("sen")< 150)
                return notify_fail("你的神太差了！\n");
        if((int)me->query("sen")< 150+(strategy+leadership-200)*3/5)
                return notify_fail("你的神太差了！\n");
        if(me->query("force")<1000)
                return notify_fail("你的内力不足，无法长啸告警。\n");
       
       
        if( me->query_temp("max_guard") >= max_guard )
                return notify_fail("以你现在的官位，你已经受到足够的保护！\n");
        
        if ((strategy+leadership)>200)
                me->receive_damage("sen",150+(strategy+leadership-200)*3/5);
                else me->receive_damage("sen",150);
        
        if (random(leadership+strategy) < 13) {
        	me->add("force",-300);
        message_vision(HIB "\n$N发出一声长啸求援！但是什麽也没有发生！\n" NOR, me);   
        me->start_busy(1+random(3));
        return 1;
        } 
        if (leadership+strategy>240 && random(100)<5)
               {
               	me->add("force",-300);
               	 message_vision(HIB "\n$N发出一声长啸求援！但是什麽也没有发生！\n" NOR, me); 
               	 me->start_busy(1+random(3));
               	 return 1;
               	}
        else { 
        	message_vision(HIR "\n$N发出一声长啸求援！\n" NOR, me);   
        	me->add("force",-300);
        	for(int ii=0; ii <max_guard;ii++)
        	{
        	me->set_temp("alert_time",time());
                seteuid(getuid());
                soldier= new("/obj/npc/palaceguard");
                soldier->move(environment(me));
               if (leadership>300) leadership = 300;
                if (strategy>300) strategy = 300;
                soldier->invocation(me, (leadership+strategy));
                soldier->set_temp("invoker",me);
                soldier->set_leader(me);
                soldier->set("owner",me);
                
                title = leadership+ strategy;
                if (title < 300)
                        soldier->set("title",HIB"大内高手"NOR);
                else if (title<450)
                        soldier->set("title",HIY"御前侍卫"NOR);
                else 
                        soldier->set("title",HIR"锦衣卫"NOR);
                        
                me->add_temp("max_guard",1);
               me->start_busy(1+random(3));
                 message_vision(HIW "\n$N应声而来！\n" NOR, soldier);
        }       
        
        
              if(me->query_skill("strategy",1)>=300&&random(4))
            {  message_vision(HIY"侍卫们在周围布好阵势，将$N团团保护住!\n"NOR,me);     
        	me->remove_all_killer();   
      	    }
        } 
        return 1;
} 
int help(object me)
{
        write(@HELP
指令格式：alert
 
这个指令让官员呼唤高手来保护自己。
能否招呼出高手，呼出高手水平的高低就要看官员
官职的大小了。
 
HELP
    );
    return 1;
}    
