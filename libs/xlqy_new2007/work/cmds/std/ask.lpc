// by bugbug & alading @ 缥缈水云间, 2003-4-5
// ask.c

#include <ansi.h>

inherit F_CLEAN_UP;

string *msg_dunno = ({
  "$n摇摇头，说道：没听说过。\n",
  "$n疑惑地看着$N，摇了摇头。\n",
  "$n睁大眼睛望着$N，显然不知道$P在说什么。\n",
  "$n耸了耸肩，很抱歉地说：无可奉告。\n",
  "$n说道：嗯．．．这我可不清楚，你最好问问别人吧。\n",
  "$n想了一会儿，说道：对不起，你问的事我实在没有印象。\n"
});
string *msg_refuse = ({
  "朝$N撇了撇嘴。\n",
  "冲着$N磨了磨牙。\n",
  "对着$N用鼻子哼了一声。\n",
  "耸了耸肩。\n",
  "将头转了开去。\n",
  "对着$N呸了一声。\n"
});




int main(object me, string arg) {
  string dest, topic, msg, *idea;
  object ob;
  mapping inquiry;
  mapping refuse;
  int ok;
  seteuid(getuid());

  if (!arg || sscanf(arg, "%s about %s", dest, topic) != 2)
    return notify_fail("你要问谁什么事？\n");

  if (!objectp(ob = present(dest, environment(me))))
    return notify_fail("这里没有这个人。\n");

  if (!ob->is_character()) {
    message_vision("$N对着$n自言自语．．．\n", me, ob);
    return 1;
  }

  if (!ob->query("can_speak")) {
    message_vision("$N向$n打听有关『" + topic
      + "』的消息，但是$p显然听不懂人话。\n", me, ob);
    return 1;
  }
  /*  if(me->is_busy())
	{
		tell_object(me,"你现在正忙着呢...\n");	
			
		return 1;	
} */
  if (userp(ob)) return 1;
  if (!living(ob)) {
    message_vision("但是很显然的，$n现在的状况没有办法给$N任何答覆。\n",
      me, ob);
    return 1;
  }


  if (!INQUIRY_D->parse_inquiry(me, ob, topic))
    message_vision("$N向$n打听有关『" + topic + "』的消息。\n", me, ob);

  if (me->query_temp("cmds_no_ask")) {
    if (mapp(refuse = me->query_temp("cmds_no_ask"))) {
      string *ask_ob = keys(refuse);

      for (int aa = 0; aa < sizeof(ask_ob); aa++) {

        if (ob->query("name") == ask_ob[aa]) {

          if (refuse[ask_ob[aa]] > time()) {
            message_vision("$n" + msg_refuse[random(sizeof(msg_refuse))], me, ob);
            tell_object(me, "看来" + ob->name() + "并不打算回答你的问题。\n");
            return 1;
          } else {
            me->delete_temp("cmds_no_ask/" + ask_ob[aa]);

          }
          break;
        }
      }

    }
  }

  /*	if( (me->query("per")/10+random(me->query_per()) )< 1+random(3)&&me->query("age") > 17&&me->query("daoxing") < 8888888 ) {
		message_vision("$n上上下下打量$N一番，"+msg_refuse[random(sizeof(msg_refuse))],me, ob);
		tell_object(me,"看来"+ob->name()+"并不打算回答你的问题。\n");
		me->set_temp("cmds_no_ask/"+ob->query("name"),time()+30+random(45));
	
		return 1;
	}
	
*/
  // by snowcat jan 23 1998
  if (msg = QUEST->quest_ask(me, ob, topic)) {
    if (stringp(msg)) {
      message_vision(CYN "$N说道：" + msg + "\n" NOR, ob);
      return 1;
    }
  }
  if (topic == "all") {
    if (me->query("real_age") < 18) {
      ok = 1;

    } else {
      if (me->query("balance") < 10000) {
        ok = 0;
        tell_object(me, "你无法支付此次咨询的费用！\n" NOR);
      } else {

        ok = 1;
        tell_object(me, "系统已从你帐户里扣除一两黄金的咨询费用！\n" NOR);
        me->set("balance", me->query("balance") - 10000);
      }


    }
    if (ok) {
      inquiry = ob->query("inquiry");
      if (!mapp(inquiry)) {
        message_vision(CYN "$N说道：对不起，我啥也不知道呀...\n" NOR, ob);
        return 1;
      }
      idea = keys(inquiry);
      msg = "";
      for (int asdf = 0; asdf < sizeof(idea); asdf++) {
        if (asdf < sizeof(idea) - 1)
          msg += HIC + idea[asdf] + NOR + "，";
        else msg += HIC + idea[asdf] + NOR;


      }
      tell_object(me, CYN + ob->name() + "悄声对你说道：你可以向我打听有关" + msg + CYN "的内容！\n" NOR);

    }
    return 1;
  }
  if (msg = ob->query("inquiry/" + topic)) {
    if (stringp(msg)) {
      message_vision(CYN "$N说道：" + msg + "\n" NOR, ob);
      return 1;
    }
  } else
    message_vision(msg_dunno[random(sizeof(msg_dunno))], me, ob);

  return 1;
}

int help(object me) {
  write(@HELP
指令格式: ask <someone> about <something>

这个指令在解谜时很重要, 通常必须藉由此一指令才能
获得进一步的资讯。
HELP
  );
  return 1;
}
