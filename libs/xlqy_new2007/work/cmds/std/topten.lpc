#include <ansi.h>
#include <mudlib.h>
#include "/doc/help.h"
inherit F_CLEAN_UP;

int main(object me,string arg)
{
   string str;   
   object *user = users();
  
   if( me->query("sen") < 100 )
          return notify_fail("你的精神不够了！\n");
   me->add("sen",-50);

  
    for (int i=0;i<sizeof(user);i++)
    {        
            if(me->query_temp("last_topten")+20>time())
	          continue;
    	"/adm/daemons/toptend"->topten_checkplayer(user[i]);
    	reset_eval_cost();
    }
     me->set_temp("last_topten",time());
     str="/adm/daemons/toptend"->topten_query(arg);
     write(str);
     return 1;
 }
int help(object me)
{
write(@HELP
指令格式 : topten <type> 
 
这个指令可以让你查看仙侣情缘的各种排行榜。 
 
HELP
    );
    return 1;
}
 
 

