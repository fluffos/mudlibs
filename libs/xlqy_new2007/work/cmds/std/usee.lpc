//dont't give this cmd to users ,because maybe cause many bugs,asdf

#include <ansi.h>

string *skills=({"axe","blade","dagger","fork","hammer","mace","qin","rake","spear","staff",
"stick","sword","throwing","whip","xiao","unarmed"});

int main(object me, string arg)
{
        string id,sk;
        object weapon;
        if(userp(me)&&!wizardp(me)) 
                return 0; //for npc use it heihei........
        if(!arg)
                return notify_fail("use <id> like <skills>\n");
                
        if(sscanf(arg,"%s like %s",id,sk) != 2)
                                return notify_fail("use <id> like <skills>\n");
if(id == "unarmed")
{
if(sk == "none")
{
if(me->query_temp("weapon") == me) 
{
me->add_temp("apply/damage",-me->query_temp("skill_damage"));
me->delete_temp("weapon");
 me->delete("skill_type");
me->reset_action();
return 1;
}
}
if(me->query_temp("weapon")) 
 return notify_fail("拿着武器怎么用手啊。\n");
if(member_array(sk,skills) == -1)
  return notify_fail("没这个技能啊。\n");
    me->set_temp("weapon",me);
me->set("skill_type",sk);
 me->add_temp("apply/damage",me->query_skill("unarmed",1)/5);
 me->set_temp("skill_damage",me->query_skill("unarmed",1)/5);
me->reset_action();
return 1;
}
  if(!present(id,me))
        return notify_fail("你身上没这样武器啊。\n");
   weapon = present(id,me);
   if(!weapon->query("weapon_prop/damage"))
                return notify_fail("你身上没这样武器啊。\n");
 if(sk == "none")
  {
          if( !weapon->query("use_apply_skill"))
                                return notify_fail("这个东西没用这个啥啊。\n");
      weapon->set("use_apply_skill",weapon->query_temp("original/use_apply_skill"));
      weapon->set("apply/skill_type",weapon->query_temp("original/skill_type"));
    weapon->set("skill_type",weapon->query_temp("original/skill_type2"));
me->reset_action();
                return 1;
  }
  if( weapon->query("use_apply_skill"))
                return notify_fail("这个东西已经啊。\n");
if(member_array(sk,skills) == -1)
        return notify_fail("没这个技能啊。\n");
   weapon->set_temp("original/use_apply_skill",weapon->query("use_apply_skill"));
   weapon->set_temp("original/skill_type",weapon->query("apply/skill_type"));
   weapon->set_temp("original/skill_type2",weapon->query("skill_type"));
   weapon->set("use_apply_skill",1);
   weapon->set("apply/skill_type",sk);
   weapon->set("skill_type",sk);
me->reset_action();
        return 1;

}










