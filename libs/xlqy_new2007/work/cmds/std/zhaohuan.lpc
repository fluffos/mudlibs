inherit F_CLEAN_UP;

int main(object me, string arg) {
  object qinbing;
  int h, s, d, l;
  string what;

  h = me->query_temp("diablo_sets/huoshen_set");
  s = me->query_temp("diablo_sets/shuishen_set");
  d = me->query_temp("diablo_sets/dushen_set");
  l = me->query_temp("diablo_sets/leishen_set");
  if (h >= 5)
    what = "huoshen";
  else if (s >= 5)
    what = "shuishen";
  else if (d >= 5)
    what = "dushen";
  else if (l >= 5)
    what = "leishen";
  else return 0;
  if (!me->is_fighting()) return notify_fail("只有战斗中才能进行召唤！\n");
  if (me->query_temp("zhaohuan/" + what) > time())
    return notify_fail("老是召啊召，你以为是你家的宠物啊？！\n");
  message_vision("$N突然高举双手向天，喃喃念了几句........\n", me);
  qinbing = new("/obj/npc/" + what);
  qinbing->move(environment(me));
  qinbing->invocation(me);
  me->set_temp("zhaohuan/" + what, time() + 360 + random(100));
  return 1;
}
