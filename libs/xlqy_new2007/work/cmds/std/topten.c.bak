inherit F_CLEAN_UP;

int main(object me,string arg)
{
   string str;
   
   object *user = users();
   seteuid(getuid());
    for (int i=0;i<sizeof(user);i++)
    {
    	"/adm/daemons/toptend"->topten_checkplayer(user[i]);
    	reset_eval_cost();
    }
     
     str="/adm/daemons/toptend"->topten_query(arg);
     printf(str);
 }
 
 

