// xiuxing.c

#include <skill.h>
#include <ansi.h>

inherit F_CLEAN_UP;
string *str=({
	        "你慢慢物我两忘。\n",
	        "你觉得一切胜负荣辱都是过眼云烟。\n",
	        "你觉得自己进入了一个前所未有的境界。\n",
	        "你的心境渐渐清明。\n"
	        "你慢慢地领悟到佛的精髓。\n",
	        "你的思绪慢慢宁静下来。\n"
	     });


#include <obstacle.h>

void finish(object me, int pot_gain);

int main(object me, string arg)
{
	int obstacle_size = sizeof(obstacles);
	int busy_time, pot_gain,my_kar;
	int xiudao_lvl;
	mapping fam;
	object where;

	seteuid(getuid());
	where = environment(me);
	
	if(where->query("no_fight") || where->query("no_magic") )
	     return notify_fail("安全区内禁止练功。\n");


 if ( (xiudao_lvl = me->query("combat_exp")) < 6000000)
		return notify_fail("你修为太低，不能自行修练！\n");

	if (me->is_busy() || me->query_temp("pending/exercising")
		|| me->query_temp("doing_xiudao")|| me->query_temp("doing_xixing"))
		return notify_fail("你现在正忙着呢。\n");

	if( me->is_fighting() )
		return notify_fail("战斗中修行，找死啊？！\n");

	if( (int)me->query("sen") * 100 / (int)me->query("max_sen") < 50 )
		return notify_fail("你现在神智不清！\n");

	if( (int)me->query("kee") * 100 / (int)me->query("max_kee") < 50 )
		return notify_fail("你现在体力不够！\n");

	if (me->query("food") < 10) return notify_fail("你现在饿得要昏到了！\n");
	if (me->query("water") < 10) return notify_fail("你现在快渴死了！\n");
	
	my_kar = me->query("kar");
  pot_gain = my_kar;
	busy_time = random(pot_gain);
	message_vision(HIY "$N盘膝而坐，潜思入定，开始参悟自己的所作所为。\n" NOR, me);
	me->start_busy(busy_time+2);
	me->set_temp("doing_xixing",1);
 call_out("finish",busy_time, me, pot_gain*100);
	return 1;
}

void finish(object me, int pot_gain)
{
        int  pots ;
        if(!me) return ;
 pots = pot_gain/2+random(pot_gain/2) + 10;
        tell_object(me,HIY""+str[random(sizeof(str))]+""NOR);
	message_vision(HIY "$N缓缓睁开眼睛，长舒一口气站了起来。\n" NOR, me);
        me->add("potential", pots);
        me->add("combat_exp",-pot_gain);
	tell_object(me, HIC "你的潜能增加了" + chinese_number(pots) + "点！\n" NOR);
	me->receive_damage("sen", me->query("int"));
	me->receive_damage("kee", me->query("int"));
 if (me->query("food") >= 40) me->add("food",-random(pot_gain/100));
       else me->set("food", 0);
 if (me->query("water") >= 40) me->add("water",-random(pot_gain/100));
	else me->set("water", 0);
	me->start_busy(1);
	me->delete_temp("doing_xixing");
	me->save();
}


