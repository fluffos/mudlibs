string seek_ip_address(string ip) {
  string *ip_address;
  string str;
  string *ip_list_start, *ip_list_end;
  string *user_ip;
  string ip_config = "/adm/etc/ipdata/ipdata1";
  int i, j, k = 0;
  int ip_start, ip_end, now_ip;

  user_ip = explode(ip, ".");

  if (atoi(user_ip[0]) <= 060)
    ip_config = "/adm/etc/ipdata/ipdata1";

  else if (atoi(user_ip[0]) == 061 && atoi(user_ip[1]) <= 155)
    ip_config = "/adm/etc/ipdata/ipdata1_2";

  else if (atoi(user_ip[0]) == 061 && atoi(user_ip[1]) > 155 && atoi(user_ip[1]) < 225)
    ip_config = "/adm/etc/ipdata/ipdata1_2.1";

  else if (atoi(user_ip[0]) == 062)
    ip_config = "/adm/etc/ipdata/ipdata1_3";

  else if (atoi(user_ip[0]) <= 080)
    ip_config = "/adm/etc/ipdata/ipdata2";

  else if (atoi(user_ip[0]) <= 130)
    ip_config = "/adm/etc/ipdata/ipdata2_2";

  else if (atoi(user_ip[0]) <= 158)
    ip_config = "/adm/etc/ipdata/ipdata2_3";

  else if (atoi(user_ip[0]) <= 192)
    ip_config = "/adm/etc/ipdata/ipdata3";

  else if (atoi(user_ip[0]) == 193
    || (atoi(user_ip[0]) == 194
      && atoi(user_ip[1]) <= 116))
    ip_config = "/adm/etc/ipdata/ipdata3_1";

  else if (atoi(user_ip[0]) == 194
    && atoi(user_ip[1]) == 117)
    ip_config = "/adm/etc/ipdata/ipdata3_2";

  else if (atoi(user_ip[0]) == 194)
    ip_config = "/adm/etc/ipdata/ipdata3_3";

  else if (atoi(user_ip[0]) == 195
    && atoi(user_ip[1]) <= 111)
    ip_config = "/adm/etc/ipdata/ipdata4";

  else if (atoi(user_ip[0]) == 195
    && atoi(user_ip[1]) == 112)
    ip_config = "/adm/etc/ipdata/ipdata4_2";

  else if (atoi(user_ip[0]) == 195 && atoi(user_ip[1]) > 112 && atoi(user_ip[1]) < 225)
    ip_config = "/adm/etc/ipdata/ipdata4_3";

  else if (atoi(user_ip[0]) <= 201
    || (atoi(user_ip[0]) == 202 && atoi(user_ip[1]) <= 100))
    ip_config = "/adm/etc/ipdata/ipdata5";

  else if (atoi(user_ip[0]) == 202 && atoi(user_ip[1]) <= 113 && atoi(user_ip[1]) > 100)
    ip_config = "/adm/etc/ipdata/ipdata5_2";

  else if (atoi(user_ip[0]) == 202 && atoi(user_ip[1]) <= 170 && atoi(user_ip[1]) > 113)
    ip_config = "/adm/etc/ipdata/ipdata5_2.1";

  else if (atoi(user_ip[0]) <= 207)
    ip_config = "/adm/etc/ipdata/ipdata5_3";

  else if (atoi(user_ip[0]) <= 210)
    ip_config = "/adm/etc/ipdata/ipdata6";

  else if (atoi(user_ip[0]) <= 211)
    ip_config = "/adm/etc/ipdata/ipdata6_2";

  else if (atoi(user_ip[0]) <= 212 && atoi(user_ip[1]) <= 063)
    ip_config = "/adm/etc/ipdata/ipdata6_3";

  else if (atoi(user_ip[0]) <= 212)
    ip_config = "/adm/etc/ipdata/ipdata6_4";

  else if (atoi(user_ip[0]) <= 217)
    ip_config = "/adm/etc/ipdata/ipdata7";

  else if (atoi(user_ip[0]) == 218 && atoi(user_ip[1]) <= 062)
    ip_config = "/adm/etc/ipdata/ipdata7_2";

  else if (atoi(user_ip[0]) <= 218)
    ip_config = "/adm/etc/ipdata/ipdata7_3";

  else if (atoi(user_ip[0]) <= 219)
    ip_config = "/adm/etc/ipdata/ipdata8";

  else if (atoi(user_ip[0]) <= 221)
    ip_config = "/adm/etc/ipdata/ipdata8_2";

  else
    ip_config = "/adm/etc/ipdata/ipdata8_3";


  str = read_file(ip_config);
  if (!str) return "文件为空。";
  ip_address = explode(str, "\n");
  for (i = 0; i < sizeof(ip_address); i++) {
    if (atoi(ip_address[i][0..2]) == atoi(user_ip[0])) {
      ip_list_start = explode(ip_address[i][0..14], ".");
      ip_list_end = explode(ip_address[i][16..30], ".");

      for (j = 1; j < 4; j++) {
        reset_eval_cost();
        ip_start = atoi(ip_list_start[j]);
        ip_end = atoi(ip_list_end[j]);
        now_ip = atoi(user_ip[j]);
        if (now_ip <= ip_end && now_ip >= ip_start)
          k++;
      }
      if (k == 3) {
        return ip_address[i][32..] + "。";
      }
      k = 0;
    }
  }
  return "是个未知的IP所属地址。";

}
