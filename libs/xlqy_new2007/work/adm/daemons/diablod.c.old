		break;	
		case "finger" :
		{	
			switch(kind)
			{
				case CRUDE:
				   obj->set("diablo_prop/armor",1+level+random(level));
				   break;
				case CRACKED:
				   obj->set("diablo_prop/armor", 3+level+random(level));	
				   break;
				case LOW_QUALITY:
				  obj->set("diablo_prop/armor",5+2*level+random(level));	
				  
				   break; 
				case NORMAL:
				   obj->set("diablo_prop/armor", 10+3*level+random(level));	
				  
				   break;    
				case SUPERIOR:
				   obj->set("diablo_prop/armor", 15+4*level+random(level));	
				  				   	
				   break;     
				   
				case RARE:
				   obj->set("diablo_prop/armor", 20+6*level+random(level));	
				   				   	
				   break;     
				   
				case UNIQUES:
				    obj->set("diablo_prop/armor", 30+8*level+random(level));	
				  
				   break;      
						
			}
		}
		break;	
		case "waist" :
		{	
			switch(kind)
			{
				case CRUDE:
				 obj->set("diablo_prop/armor", 1+level+random(level));
				   break;
				case CRACKED:
				 obj->set("diablo_prop/armor", 3+2*level+random(level));	
				   break;
				case LOW_QUALITY:
				  obj->set("diablo_prop/armor", 5+3*level+random(level));	
				  
				   break; 
				case NORMAL:
				  obj->set("diablo_prop/armor",7+5*level+random(level));	
				  
				   break;    
				case SUPERIOR:
				  obj->set("diablo_prop/armor",10+7*level+random(level));	
				  				   	
				   break;     
				   
				case RARE:
				  obj->set("diablo_prop/armor", 15+10*level+random(level));	
				   				   	
				   break;     
				   
				case UNIQUES:
				 obj->set("diablo_prop/armor", 25+15*level+random(level));	
				  
				   break;      
						
			}
		}
		break;	
		case "head" :
		{	
			switch(kind)
			{
				case CRUDE:
				  obj->set("diablo_prop/armor", 1+level+random(level));
				   break;
				case CRACKED:
				   obj->set("diablo_prop/armor",3+2*level+random(level));	
				   break;
				case LOW_QUALITY:
				  obj->set("diablo_prop/armor", 5+3*level+random(level));	
				  
				   break; 
				case NORMAL:
				   obj->set("diablo_prop/armor", 7+5*level+random(level));	
				  
				   break;    
				case SUPERIOR:
				  obj->set("diablo_prop/armor",10+8*level+random(level));	
				  				   	
				   break;     
				   
				case RARE:
				 obj->set("diablo_prop/armor", 15+12*level+random(level));	
				   				   	
				   break;     
				   
				case UNIQUES:
				    obj->set("diablo_prop/armor",25+15*level+random(level));	
				  
				   break;      
						
			}
		}
		break;	
		
		
		}
	
}
void set_weapons_prop(object obj,int kind,int level)
{
	int effect;
	int lvl_content;
	string content;
	switch(kind)
	{
				case CRUDE:
				   obj->set("diablo_prop/damage", 5+3*level+random(level));
				    obj->set("identification",1);
				     obj->set("name",HIB"粗糙"+obj->query("name")+NOR);
				     break;
				case CRACKED:
				   obj->set("diablo_prop/damage",  10+5*level+random(level));
				    obj->set("identification",1);
				     obj->set("name",HIB"粗糙"+obj->query("name")+NOR);
				   break;
				case LOW_QUALITY:
				  obj->set("diablo_prop/damage", 15+8*level+random(2*level));
				
				     lvl_content=LEVEL_1_EFF;
				     content=effect_one[lvl_content-50];
				   effect=set_diablo_effect(LOW_QUALITY,lvl_content,level);      
				  obj->add("diablo_prop/"+content,effect);	
				   obj->set("identification",1);
				    obj->set("name",HIB"低劣"+obj->query("name")+NOR);
				   break; 
				case NORMAL:
				   obj->set("diablo_prop/damage",  20+10*level+random(3*level));
				    lvl_content=LEVEL_1_EFF;
				    content=effect_one[lvl_content-50];
				   effect=set_diablo_effect(NORMAL,lvl_content,level);      
				  obj->add("diablo_prop/"+content,effect);	
				  if(!random(9))
				{  lvl_content=LEVEL_1_EFF;
				    content=effect_one[lvl_content-50];
				   effect=set_diablo_effect(LOW_QUALITY,lvl_content,level);      
				  obj->add("diablo_prop/"+content,effect);	
				}
				   obj->set("identification",1);
				    obj->set("name",GRN"普通"+obj->query("name")+NOR);
				   break;    
				case SUPERIOR:
				 obj->set("diablo_prop/damage", 25+12*level+random(4*level));
				   lvl_content=LEVEL_1_EFF;
				   content=effect_one[lvl_content-50];
				   effect=set_diablo_effect(SUPERIOR,lvl_content,level);      
				  obj->add("diablo_prop/"+content,effect);
				   if(!random(7))
				{  lvl_content=LEVEL_1_EFF;
				    content=effect_one[lvl_content-50];
				   effect=set_diablo_effect(NORMAL,lvl_content,level);      
				  obj->add("diablo_prop/"+content,effect);	
				}
				  
				  
				  obj->set("name",HIM"优质"+obj->query("name")+NOR);
				   if(random(2))
				     {
				     	lvl_content=LEVEL_2_EFF;
				     	content=effect_two[lvl_content-100];
				}
				   else   
				   {
				   	 lvl_content=LEVEL_1_EFF;
				   	 content=effect_one[lvl_content-50];
				   	}
				   effect=set_diablo_effect(SUPERIOR,lvl_content,level);      
				  obj->add("diablo_prop/"+content,effect);
				   if(!random(9))
				{  lvl_content=LEVEL_2_EFF;
				  content=effect_two[lvl_content-100];
				   effect=set_diablo_effect(NORMAL,lvl_content,level);      
				  obj->add("diablo_prop/"+content,effect);	
				} 	
				   break;     
				   
				case RARE:
				 obj->set("diablo_prop/damage", 30+15*level+random(5*level));
				     lvl_content=LEVEL_1_EFF;
				     content=effect_one[lvl_content-50];
				   effect=set_diablo_effect(RARE,lvl_content,level);      
				   obj->add("diablo_prop/"+content,effect);
				     if(!random(5))
				{  lvl_content=LEVEL_1_EFF;
				    content=effect_one[lvl_content-50];
				   effect=set_diablo_effect(SUPERIOR,lvl_content,level);      
				  obj->add("diablo_prop/"+content,effect);	
				}
				 				   
				     obj->set("name",HIY"稀有"+obj->query("name")+NOR);
				   if(random(3))
				 {  lvl_content=LEVEL_2_EFF;
				 	content=effect_two[lvl_content-100];
				}
				   else
				   {  lvl_content=LEVEL_1_EFF;
				   	content=effect_one[lvl_content-50];
				}
				   effect=set_diablo_effect(RARE,lvl_content,level);      
				   obj->add("diablo_prop/"+content,effect);	
				    if(!random(7))
				{  lvl_content=LEVEL_2_EFF;
				  content=effect_two[lvl_content-100];
				   effect=set_diablo_effect(SUPERIOR,lvl_content,level);      
				  obj->add("diablo_prop/"+content,effect);	
				} 		
				   break;     
				   
				case UNIQUES:
				   obj->set("diablo_prop/damage",  40+20*level+random(6*level));
				   lvl_content=LEVEL_1_EFF;
				   content=effect_one[lvl_content-50];
				   effect=set_diablo_effect(UNIQUES,lvl_content,level);      
				  obj->add("diablo_prop/"+content,effect);	
				   if(!random(3))
				{  lvl_content=LEVEL_1_EFF;
				    content=effect_one[lvl_content-50];
				   effect=set_diablo_effect(RARE,lvl_content,level);      
				  obj->add("diablo_prop/"+content,effect);	
				}
				 if(!random(5))
				{  lvl_content=LEVEL_2_EFF;
				    content=effect_two[lvl_content-100];
				   effect=set_diablo_effect(RARE,lvl_content,level);      
				  obj->add("diablo_prop/"+content,effect);	
				} 
				 if(!random(7))
				{ if(random(2)) 
				  {	lvl_content=LEVEL_3_WEAPON_EFF;
				    content=effect_three_weapon[lvl_content-200];
				   effect=set_diablo_effect(RARE,lvl_content,level);      
				  obj->add("diablo_prop/"+content,effect);	
				}
				else
				{
					lvl_content=LEVEL_3_ALL_EFF;
				    content=effect_three_all[lvl_content-400];
				   effect=set_diablo_effect(RARE,lvl_content,level);      
				  obj->add("diablo_prop/"+content,effect);	
					
				}
				}
				   obj->set("name",YEL"绝世"+obj->query("name")+NOR);
				   lvl_content=LEVEL_2_EFF;
				   content=effect_two[lvl_content-100];
				   effect=set_diablo_effect(UNIQUES,lvl_content,level);      
				   obj->add("diablo_prop/"+content,effect);	
				   
				   if(random(3))
				    { if(random(2))	
				    {	lvl_content=LEVEL_3_WEAPON_EFF;
				 	   content=effect_three_weapon[lvl_content-200];
					}
				    	else {
				    		  lvl_content=LEVEL_3_ALL_EFF;
				    		  content=effect_three_all[lvl_content-400];
				    		}
					}
				   else    
				   { 	
				   	lvl_content=LEVEL_2_EFF;
				   	content=effect_two[lvl_content-100];
				   }
				   				   
				   effect=set_diablo_effect(UNIQUES,lvl_content,level);      
				   obj->add("diablo_prop/"+content,effect);
				   
				   	
				   break;      
						
			}	
	
}
int set_diablo_effect(int kind,int content,int level)
{
	
	switch(content)
	  		{
	  			
	  			case ARMOR_EFF :
	  			{	return 2*kind+2*random(level+1);
	  			break;
	  			}
	  			case DODGE_EFF :
	  			case PARRY_EFF :
	  			case FORCE_EFF :
	  			case SPELLS_EFF :
	  			{	return level+3*kind+2*random(level+1);
	  			break;
	  		}
	  			case ATTACK_EFF:
	  			case DEFENSE_EFF :
	  		{		return level+2*kind+random(level+1);
	  			break;
	  		}	
	  			
	  			//////////////////////////////////////////////////
	  			
	  			case STR_EFF:
		  		{	return level+2*kind+random(level+1);
		  			break;
		  		}
	  			case INT_EFF :
	  			
	  			case SPI_EFF :
	  				
	  			case PER_EFF:
	  				  			
	  			case CON_EFF:
	  				
	  			case KAR_EFF :
	  			{	return kind+random(level+1);
	  			break;
	  		}
	  			case CPS_EFF :
	  			case COR_EFF :
	  			{	return 2*kind+2*random(level+1);
	  			break;}
	  			case MAGIC_FIND:
	  			{	return 100*level+800*kind+800*random(level+1); 
	  			
	  			break;}
	  			case ADD_KEE:
	  			case ADD_SEN:
	  			{	return 8*level+15*kind+random(kind*level);
	  				break;
	  			}
	  			case ADD_FORCE:
	  			case ADD_MANA:
	  			{	return 10*level+15*kind+random(kind*level);
	  				break;
	  			}
	  			///////////////////极品////////////////////////////
	  			
	  			case CAN_INSET :
	  		{	return 1+random(3);
	  				break;}
	  			case ADD_ALL_SKILL :
	  			{
	  				return level+random(level);
	  				break;
	  			}
	  			
	  			case PARRY_BLOCK_ATTACK:
	  			case SKILL_DOUBLE_DAMAGE:
	  			{	return 1000*(kind-6)+100*level+random(100*level);
	  				break;
	  			}
	  			case FORCE_VS_DAMAGE:
	  			case SPELLS_VS_DAMAGE:
	  			case ANTI_SPELL_ALL:
	  			case ADD_SPELL_ALL:
	  			{	return 500*(kind-6)+50*level+random(50*level);
	  				break;
	  			}
	  			case ANTI_SPELL_KEE:  
				case ANTI_SPELL_SEN:
				case ADD_SPELL_KEE:
				case ADD_SPELL_SEN:
				case ADD_MAX_MANA:
				case ADD_MAX_FORCE:
				case ADD_MAX_KEE:
				case ADD_MAX_SEN:
				case COMBAT_BLOOD_KEE:
				case COMBAT_BLOOD_SEN:
				case COMBAT_BLOOD_FORCE:
				case COMBAT_BLOOD_MANA:
				{	return 1000*(kind-6)+100*level+random(100*level);
					break;
				}
	  		
	  			
	  		}
	  			  	
	
}