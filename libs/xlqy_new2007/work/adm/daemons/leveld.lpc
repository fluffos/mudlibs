void create() {
  seteuid(getuid());
  set("name", "技能等级精灵");
  set("id", "leveld");

}
//是否给予属性点数和技能点数
/*
到达以下等级的时候，赋给属性点数和相应return的技能点数
属性点数通过attribute命令增加到先天属性上，技能点数通过research
增加到某项技能上，可以升级（免切磋）
10 :183750
15 :403837
20 :784800
25 :1430625
30 :2496900
33 :3434968
36 :4683616
39 :6330758
42 :8493466
44 :10296576
46 :12450900
48 :15018808
50 :18072000


50级的时候共增加属性点数,技能点数
*/
int query_ob_add_skpoint(int lv) {
  if (lv == 10) return 1;
  else if (lv == 15) return 3;
  else if (lv == 20) return 5;
  else if (lv == 25) return 7;
  else if (lv == 30) return 11;
  else if (lv == 33) return 13;
  else if (lv == 36) return 17;
  else if (lv == 39) return 19;
  else if (lv == 42) return 23;
  else if (lv == 44) return 29;
  else if (lv == 46) return 31;
  else if (lv == 48) return 37;
  else if (lv == 50) return 41;
  else if (lv > 50) return lv;
  else return 0;

}
int query_ob_add_attpoint(int lv) {
  if (lv == 10) return 1;
  else if (lv == 15) return 1;
  else if (lv == 20) return 1;
  else if (lv == 25) return 1;
  else if (lv == 30) return 1;
  else if (lv == 33) return 2;
  else if (lv == 36) return 2;
  else if (lv == 39) return 2;
  else if (lv == 42) return 2;
  else if (lv == 44) return 3;
  else if (lv == 46) return 3;
  else if (lv == 48) return 3;
  else if (lv == 50) return 4;
  else if (lv > 50) return lv / 10 - 1;
  else return 0;

}
int query_ob_upgrade_gold(int lv) {
  int gold;
  lv = lv + 1;

  gold = lv + lv * lv / 4;

  return gold;
}
int query_level(int exp) {  //穷举好了.反正用于npc，误差大点无所谓，哈

  if (exp < 10000) return 1;
  else if (exp < 60000) return 5;
  else if (exp < 180000) return 10;
  else if (exp < 300000) return 13;
  else if (exp < 500000) return 16;
  else if (exp < 700000) return 19;
  else if (exp < 1003536) return 22;
  else if (exp < 1430625) return 25;
  else if (exp < 2007264) return 28;
  else if (exp < 2780379) return 31;
  else if (exp < 3812448) return 34;
  else if (exp < 5183206) return 37;
  else if (exp < 6987600) return 40;
  else if (exp < 8493466) return 42;
  else if (exp < 10296576) return 44;
  else if (exp < 12450900) return 46;
  else if (exp < 15018808) return 48;
  else if (exp < 18072000) return 50;
  else if (exp < 19403000) return 51;
  else if (exp < 20867100) return 52;
  else if (exp < 22477610) return 53;
  else if (exp < 24249171) return 54;
  else if (exp < 26197888) return 55;
  else if (exp < 28341476) return 56;
  else if (exp < 30699422) return 57;
  else if (exp < 33293162) return 58;
  else if (exp < 36146276) return 59;
  else if (exp < 39284701) return 60;
  else if (exp < 42100701) return 61;
  else if (exp < 45198301) return 62;
  else if (exp < 48605661) return 63;
  else if (exp < 52353757) return 64;
  else if (exp < 56476662) return 65;
  else return 70;


}
int query_ob_upgrade_exp(int lv)  //判断升到下一级需要多少exp
{
  int level;
  int exp, add, ratio;
  level = 0;
  lv = lv + 1;
  if (lv < 51) {
    exp = 200;
    add = 800;
    ratio = 200;
    for (level = 0; level < lv; level++) {
      exp += add;
      ratio += ratio * 6 / 100;
      add += (ratio / 100) * 100;
    }
    exp = exp * 10 + exp * lv * lv / 200;
  } else if (lv < 61) {
    exp = 18072000;
    add = 1210000;
    for (level = 50; level < lv; level++) {
      add = add * 1.1;
      exp += add;
    }
  } else if (lv < 71) {
    exp = 39284701;
    add = 2560000;
    for (level = 60; level < lv; level++) {
      add = add * 1.1;
      exp += add;
    }
  } else {
    exp = 84164476;
    add = 3140000;
    for (level = 60; level < lv; level++) {
      add = add * 1.1;
      exp += add;
    }
  }
  return exp;
}
int query_ob_upgrade_level(object ob)  //判断user是否够升级条件.
{
  int level, ob_dx, ob_exp;
  int dx, exp, gold;
  int year, day, hour;
  string str;


  if (!userp(ob)) return 0;
  level = ob->query("level");
  ob_dx = ob->query("daoxing");
  ob_exp = ob->query("combat_exp");

  exp = query_ob_upgrade_exp(level);
  dx = exp * 2 / 3;
  if (ob_dx < dx) {
    year = dx / 1000;
    day = (dx - year * 1000) / 4;
    hour = (dx - year * 1000 - day * 4) * 3;
    str = "";
    if (year) str = str + chinese_number(year) + "年";
    if (day) str = str + chinese_number(day) + "天";
    if (hour) str = str + chinese_number(hour) + "时辰";
    tell_object(ob, "你的道行不够，需要达到" + str + "!\n");
    return 0;
  }
  if (ob_exp < exp) {
    tell_object(ob, "你的经验值不够，需要达到" + exp + "点经验值才能升到下一级！\n");
    return 0;
  }
  gold = query_ob_upgrade_gold(level) * 11000;
  if (ob->query("balance") < gold) {

    tell_object(ob, "你的存款不够,需要" + MONEY_D->money_str(gold) + "！\n");
    return 0;


  }
  ob->add("combat_exp", -exp / 56);
  ob->add("daoxing", -exp / 64);
  return 1;

}

varargs mapping query_skill_effect(string skill_type)  //得到某技能的所有等级的效果库
{

  return skill_levels[skill_type];

}
mixed query_skill_level_effect(string skill_type, string skill_level)  //得到某技能的某等级的效果库
{

  object me;
  int index1, index2;
  mapping skill;


  me = this_player();
  index1 = member_array(skill_type, skills);
  index2 = member_array(skill_level, levels);
  if (index1 == -1)
    return "不存在此基本技能或这个技能目前没有等级之分！\n";
  if (index2 == -1)
    return "目前没有该等级！\n";
  skill = query_skill_effect(skill_type);
  return skill[skill_level];


}
varargs mapping query_skill_menpai(string skill_type)  //得到某技能所有等级的门派库。
{

  return skill_menpai[skill_type];

}
string query_ob_skill_level(string skill_type)                    //得到character skill_type技能的等级。
{

  object me;
  me = this_player();
  if (member_array(skill_type, skills) == -1)
    return "不存在此基本技能或这个技能目前没有等级之分！\n";
  return me->query("skill_level/" + skill_type);

}
mixed query_skill_level_menpai(string skill_type, string level)     //得到拥有某技能某等级的门派，用于判断玩家是否能到达该技能等级
{

  object me;
  int index1, index2;
  mapping skill;


  me = this_player();
  index1 = member_array(skill_type, skills);
  index2 = member_array(level, levels);
  if (index1 == -1)
    return "不存在此基本技能或这个技能目前没有等级之分！\n";
  if (index2 == -1)
    return "目前没有该等级！\n";
  skill = query_skill_menpai(skill_type);
  return skill[level];

}
int check_skill_for_level(object who, string skill, string level) {
  if (skill == "literate") {
    if (who->query_skill(skill, 1) < 350 && level == "grandmaster")
      return 0;
    else if (who->query_skill(skill, 1) < 210 && level == "master")
      return 0;
    else if (who->query_skill(skill, 1) < 120 && level == "expert")
      return 0;

  } else {
    if (who->query_skill(skill, 1) < 450 && level == "grandmaster")
      return 0;
    else if (who->query_skill(skill, 1) < 250 && level == "master")
      return 0;
    else if (who->query_skill(skill, 1) < 150 && level == "expert")
      return 0;
  }
  return 1;
}
int check_ob_for_level(object who, string level) {
  int count;
  count = who->query("betray/count");
  if (level == "expert" && (who->query("weiwang") * 0.3 + who->query("faith") * 0.7) < (515 + 515 * count / 2)) {

    return 0;
  }
  if (level == "master" && (who->query("weiwang") * 0.3 + who->query("faith") * 0.7) < (1884 + 1884 * count / 2)) {

    return 0;
  }
  if (level == "grandmaster" && (who->query("weiwang") * 0.3 + who->query("faith") * 0.7) < (2746 + 2746 * count / 2)) {

    return 0;
  }
  return 1;

}
void expell_ob_level_penalty(object who)  //判师惩罚，扣一级
{
  mapping level;
  string *skill, item;
  if (mapp(level = who->query("skill_level"))) {
    skill = keys(level);
    for (int i = 0; i < sizeof(skill); i++) {
      item = level[skill[i]];
      if (item == "expert")
        who->delete("skill_level/" + skill[i]);
      else if (item == "master")
        who->set("skill_level/" + skill[i], "expert");
      else if (item == "grandmaster")
        who->set("skill_level/" + skill[i], "master");

    }


  }



}
void result_skill_effect(object owner, string sktype, string sklvl, int skill_number) {
  mixed skill_level, skill_type;
  int add_damage, add_armor, add_attack, add_defense, double_damage, shoot_more, throw_more, throw_chance;
  int sub_armor, sub_defense, stun_opp, no_armor, opp_force, whip_opp;

  skill_type = owner->query_skill_level_effect(sktype, sklvl);      //得到该等级该技能的效果库
  if (sizeof(skill_type)) {
    for (int z = 0; z < sizeof(skill_type); z++) {
      ///穷举？sigh。。。

      if (skill_type[z][0] == DAMAGE) {
        add_damage = skill_type[z][1] + (int)skill_number / skill_type[z][2];
        owner->add_temp("apply/damage", add_damage);
        owner->add_temp("skilleff/skill_add_damage", add_damage);

      }
      if (skill_type[z][0] == ATTACK) {
        add_attack = skill_type[z][1] + (int)skill_number / skill_type[z][2];
        owner->add_temp("apply/attack", add_attack);
        owner->add_temp("skilleff/skill_add_attack", add_attack);

      }
      if (skill_type[z][0] == SELF_DEFENSE) {
        add_defense = skill_type[z][1] + (int)skill_number / skill_type[z][2];
        owner->add_temp("apply/defense", add_defense);
        owner->add_temp("skilleff/skill_add_defense", add_defense);

      }
      if (skill_type[z][0] == SELF_ARMOR) {
        add_armor = skill_type[z][1] + (int)skill_number / skill_type[z][2];
        owner->add_temp("apply/armor", add_armor);
        owner->add_temp("skilleff/skill_add_armor", add_armor);

      }
      if (skill_type[z][0] == OPP_ARMOR) {
        sub_armor = skill_type[z][1] + (int)skill_number / skill_type[z][2];
        if (sub_armor > skill_type[z][3])
          sub_armor = skill_type[z][3];
        owner->add_temp("skilleff/skill_sub_armor", sub_armor);

      }
      if (skill_type[z][0] == OPP_DEFENSE) {
        sub_defense = skill_type[z][1] + (int)skill_number / skill_type[z][2];

        owner->add_temp("skilleff/skill_sub_defense", sub_defense);

      }
      if (skill_type[z][0] == DOUBLE_DAMAGE) {
        double_damage = skill_type[z][1] + (int)skill_number * skill_type[z][2];
        if (double_damage > skill_type[z][3])
          double_damage = skill_type[z][3];
        owner->add_temp("skilleff/skill_double_damage", double_damage);

      }
      if (skill_type[z][0] == STUN_OPP) {
        stun_opp = skill_type[z][1] + (int)skill_number / skill_type[z][2];
        if (stun_opp > skill_type[z][3])
          stun_opp = skill_type[z][3];
        owner->add_temp("skilleff/skill_stun_opp", stun_opp);

      }

      if (skill_type[z][0] == SHOOT_MORE) {
        shoot_more = skill_type[z][1] + (int)skill_number / skill_type[z][2];

        owner->add_temp("skilleff/skill_shoot_more", shoot_more);

      }
      if (skill_type[z][0] == THROW_MORE) {
        throw_more = skill_type[z][1] + (int)skill_number / skill_type[z][2];
        throw_chance = skill_type[z][3];
        owner->add_temp("skilleff/skill_throw_more", throw_more);
        owner->set_temp("skilleff/skill_throw_chance", throw_chance);

      }
      if (skill_type[z][0] == NO_ARMOR) {
        no_armor = skill_type[z][1] + (int)skill_number / skill_type[z][2];
        if (no_armor > skill_type[z][3])
          no_armor = skill_type[z][3];
        owner->add_temp("skilleff/skill_no_armor", no_armor);

      }
      if (skill_type[z][0] == OPP_FORCE) {
        opp_force = skill_type[z][1] + (int)skill_number * skill_type[z][2];
        if (opp_force > skill_type[z][3])
          opp_force = skill_type[z][3];
        owner->add_temp("skilleff/skill_opp_force", opp_force);

      }
      if (skill_type[z][0] == WHIP_OPP) {
        whip_opp = skill_type[z][1] + (int)skill_number * skill_type[z][2];
        if (whip_opp > skill_type[z][3])
          whip_opp = skill_type[z][3];
        owner->add_temp("skilleff/skill_whip_opp", whip_opp);

      }
    }


  }

}
