string get_local(string ip_list,string ip)
{
	
	string *ip_list_start, *ip_list_end;
	int i, j, k=0;
	int ip_start, ip_end, now_ip;
	string *user_ip;
	string *ip_address;
	
	user_ip = explode(ip, ".");
	ip_address = explode(ip_list, "\n");
	
	for (i = 0; i < sizeof(ip_address); i++) 
	{
                if (atoi(ip_address[i][0..2])==atoi(user_ip[0])) 
                {
                        ip_list_start = explode(ip_address[i][0..14], ".");
                        ip_list_end = explode(ip_address[i][16..30], ".");

                        for ( j = 1;j< 4 ;j++ ) 
                        {
                                ip_start=atoi(ip_list_start[j]);
                                ip_end=atoi(ip_list_end[j]);
                                now_ip=atoi(user_ip[j]);
                                if ( now_ip <= ip_end && now_ip >= ip_start )
                                        k++;
                        }
                        if ( k == 3 ) 
                        {
                                return ip_address[i][32..]+"。";
                        }
                        k=0;
                }
   }
   return 0;
}


string seek_ip_address(string ip)
{
        string str,result;

        string ip_config="/adm/etc/ipadr";
         

        str = read_file(ip_config,0,3000);
        if (!str) return "文件为空。";
        
        result = get_local(str,ip);
        if (!result)
        {
        	str = read_file(ip_config,3000,3000);
        	result=get_local(str,ip);
        	if (!result)
        	{
        		str = read_file(ip_config,6000,3000);
        		result=get_local(str,ip);
        		if (!result)
        		{
        			str = read_file(ip_config,9000,3000);
        			result=get_local(str,ip);
        			if (!result)
        			{
        				str = read_file(ip_config,12000,3000);
        				result=get_local(str,ip);
        				if (!result)
        				{
        					str = read_file(ip_config,15000,3000);
        					result=get_local(str,ip);
        					if (!result)
        					{
        						str = read_file(ip_config,18000,3000);
        						result=get_local(str,ip);
        						if (!result)
        						{
        							str = read_file(ip_config,21000,3000);
        							result=get_local(str,ip);
        							if (!result)
        							{
        								str = read_file(ip_config,24000,3000);
        								result=get_local(str,ip);
        								if (!result)
        								{
        									str = read_file(ip_config,27000,3000);
        									result=get_local(str,ip);
        									if (!result)
        									{
        										str = read_file(ip_config,30000,3000);
        										result=get_local(str,ip);
        										if (!result)
        										{
        											str = read_file(ip_config,33000,3000);
        											result=get_local(str,ip);
        											if (!result)
        											{
        												str = read_file(ip_config,36000,3000);
        												result=get_local(str,ip);
        												if (!result)
        												{
        													str = read_file(ip_config,39000,3000);
        													result=get_local(str,ip);
        													if (!result)
        													{
        														str = read_file(ip_config,42000,3000);
        														result=get_local(str,ip);
        														if (!result)
        														{
        															str = read_file(ip_config,45000,2000);
        															result=get_local(str,ip);
        															if (!result)
        															{
        																return "ip所属地未知！" ;      													
        															}
        															else return result;
        														}
        														else return result;
        													}
        													else return result;
        												}
        												else return result;
        											}
        											else return result;
        										}
        										else return result;
        									}
        									else return result;
        								}
        								else return result;
        							}
        							else return result;
        						}
        						else return result;
        					}
        					else return result;
        				}
        				else return result;
        			}
        			else return result;
        		}
        		else return result;
        	}
        	else return result;
        }
        else return result;

}

