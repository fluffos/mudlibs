	"damage","parry","unarmed","dodge","armor","defense","attack",
	"force","spells","sub_defense","sub_armor","low_resist_all",//战斗 3+random(4+lv)
});
string *effect_charm_a_b =({
	"add_jin","add_mu","add_shui","add_huo","sub_jin","sub_mu","sub_shui","sub_huo", 
	"add_spells_kee","add_spells_sen","add_spells_all","sub_phy","add_phy","sub_spells_kee",
"sub_spells_sen","sub_spells_all","sub_opp_phy",
});  ////五行5+random(8+lv);
string *effect_charm_a_c = ({
	"personality", "spirituality","karma","constitution","strength",
	"courage","composure","intelligence", "add_bless","add_lucky",
	});//天赋 1+random(lv);
string *effect_charm_a_d = ({
		"add_kee","add_sen","add_force","add_mana",
	});  //状态30+random(10+15*lv);
	
	
	
string *effect_charm_b_a=({
	"add_max_jin","add_max_mu","add_max_shui","add_max_huo",
	"sub_max_jin","sub_max_mu","sub_max_shui","sub_max_huo",
	"add_max_spells_kee","add_max_spells_sen","add_max_spells_all",
	"master_huo","master_shui","master_mu","master_jin",
	"master_resist_jin","master_resist_mu","master_resist_shui","master_resist_huo",
});//wuxing 10000 is base so ,250+random(100+100*lv); 
string *effect_charm_b_b=({
	"add_kee_sen","add_force_mana",	"regenerate_kee","regenerate_sen",
	"regenerate_force","regenerate_mana",
});	//状态 20+random(10+10*lv);
string *effect_charm_b_c=({
	"combat_blood_kee","combat_blood_force","combat_blood_mana","combat_cruse","combat_unlucky",
	"sub_max_defense","sub_max_armor","add_max_phy","sub_opp_maxphy","sub_max_phy",
	"high_resist_all","sub_max_spells_kee",	"sub_max_spells_sen","sub_max_spells_all",
	"add_max_kee","add_max_sen","add_max_force","add_max_mana","magic_find",
	"force_kee_damage","spells_kee_damage","force_sen_damage","spells_sen_damage",
	"force_vs_damage" ,"spells_vs_damage","feedback_damage","magicback_damage",
});		//200+random(100+75*lv)
string *effect_charm_b_d=({
"add_all_skill_eff","add_skill_maxdamage","add_skill_damage",
}); //1+random(lv);
	 
string *effect_charm_c=({
	"add_all_skill","parry_block_attack","combat_double_damage","combat_ignore_armor",
	"combat_ignore_phy","combat_ignore_magic","can_inset_more"});


void set_prop(object obj,int lv,int mlv);
void create()
{
	seteuid(getuid());
	set("name", "暗黑神符精灵");
	set("id", "diablocharm");	
	
}

object drop(int obj_level)
{
	object obj;
	string content;
	
	
  obj=new("/obj/diablo_ob/diablo_charm");
  switch(obj_level) //notice that obj_level is from 6 to 8
  {
  	 	case 6:
  	 	set_prop(obj,1,1);
			break;
			case 7:
			set_prop(obj,1,2);	
			set_prop(obj,2,2);
			obj->set("can_inset_charm",1);
			break;	
			case 8:
			obj->set("can_inset_charm",2);
			
			set_prop(obj,1,3);	
			set_prop(obj,2,3);
			set_prop(obj,3,3);
			break;
			
			default :
				break;
	}
	obj->set("kind",obj_level);
	
	return obj;
}
/* 
lv = 在哪个级别的字串挑属性,flag = 第几号字串，mlv ＝ 物品等级

*/	
void set_prop(object obj,int lv,int mlv)
{
	int effect,i,flag;
	string content;
	if(lv ==1)
	{
			i = random(4);
  	 	if(i == 0)
			{content = effect_charm_a_a[random(sizeof(effect_charm_a_a))];
				flag = 1;
			}	
			else if(i == 1)
			{content = effect_charm_a_b[random(sizeof(effect_charm_a_b))];
				flag = 2;
			}	
			else if(i == 2)
			{content = effect_charm_a_c[random(sizeof(effect_charm_a_c))];
				flag = 3;
			}	
			else if(i == 3)
			{content = effect_charm_a_d[random(sizeof(effect_charm_a_d))];
				flag = 4;
			}	
			
	}
	else if(lv == 2)
	{
			i = random(4);
  	 	if(i == 0)
			{content = effect_charm_b_a[random(sizeof(effect_charm_b_a))];
				flag = 5;
			}	
			else if(i == 1)
			{content = effect_charm_b_b[random(sizeof(effect_charm_b_b))];
				flag = 6;
			}	
			else if(i == 2)
			{content = effect_charm_b_c[random(sizeof(effect_charm_b_c))];
				flag = 7;
			}	
			else if(i == 3)
			{content = effect_charm_b_d[random(sizeof(effect_charm_b_d))];
				flag = 8;
			}	
			
	}
	else if(lv == 3)
	{
			content = effect_charm_c[random(sizeof(effect_charm_c))];
		  if(content == "add_all_skill")
		  	effect = 1;
		  else  if(content == "can_inset_more")
		  		obj->set("can_inset_charm",3);
		  else effect = 150+random(100);
			obj->set("diablo_prop/"+content,effect);
			return;
	}
		
	switch(flag)
	{
		case 1:
		effect = 3+random(4+mlv);
			break;
		case 2:
		effect = 5+random(8+mlv);
		break;
		case 3:
		effect = 1+random(mlv);
		break;
		case 4:
		effect = 20+random(10+15*mlv);
		break;
	  case 5:
		effect = 250+random(100+100*mlv); 
		break;
		case 6:
		effect = 15+random(10+10*mlv);
		break;
		case 7:
		effect = 200+random(100+75*mlv);
		break;
		case 8:
		effect = 1+random(mlv);
		break;
		default:
			break;
	}
	
	obj->set("diablo_prop/"+content,effect);
}
void wizdrop(int obj_level,object wiz)
{
	object obj;
	if(obj_level < 6||obj_level > 8)
	obj_level = 8;
	obj = drop(obj_level);
	if(!obj->move(wiz))
			obj->move(environment(wiz));
	message_vision(GRN+"从$N身上掉了出来一"+obj->query("unit")+obj->name()+"\n"+NOR,wiz);
	return;
	
}