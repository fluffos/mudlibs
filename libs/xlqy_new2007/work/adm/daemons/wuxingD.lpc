string *poison = ({ "illness_poison", "weakness_poison", "madness_poison", "fearness_poison",
  "curse_poison", "unlucky_poison", "stoner_poison" });


void create() {
  seteuid(getuid());
  set("name", "五行");
  set("id", "WuxingD");

}
mapping wuxing_menpai = ([
  "jin_wuxing": ({ "方寸山三星洞", "盘丝洞" }),
  "mu_wuxing": ({ "月宫", "阎罗地府" }),
  "shui_wuxing": ({ "东海龙宫", "大雪山" }),
  "huo_wuxing": ({ "将军府", "火云洞" }),
  "tu_wuxing": ({ "南海普陀山", "陷空山无底洞" }),
  "all_wuxing": ({ "五庄观" }),
  "none_wuxing": ({ "蜀山剑派" }),
]);
string query_ob_wuxing(object ob) {
  string menpai;
  if (!ob)
    return "none";
  if (!ob->is_character())
    return "none";
  menpai = ob->query("family/family_name");
  if (!menpai) return "none";

  if (menpai == "方寸山三星洞" || menpai == "盘丝洞") {
    ob->set_temp("wuxing/type", "jin_wuxing");
    if (menpai == "盘丝洞")
      ob->set_temp("wuxing/flag", 0);
    else ob->set_temp("wuxing/flag", 1);

    return "jin_wuxing";
  } else if (menpai == "月宫" || menpai == "阎罗地府") {
    ob->set_temp("wuxing/type", "mu_wuxing");
    if (menpai == "阎罗地府")
      ob->set_temp("wuxing/flag", 0);
    else ob->set_temp("wuxing/flag", 1);

    return "mu_wuxing";
  } else if (menpai == "东海龙宫" || menpai == "大雪山") {
    ob->set_temp("wuxing/type", "shui_wuxing");
    if (menpai == "大雪山")
      ob->set_temp("wuxing/flag", 0);
    else ob->set_temp("wuxing/flag", 1);

    return "shui_wuxing";
  } else if (menpai == "将军府" || menpai == "火云洞") {
    ob->set_temp("wuxing/type", "huo_wuxing");
    if (menpai == "火云洞")
      ob->set_temp("wuxing/flag", 0);
    else ob->set_temp("wuxing/flag", 1);

    return "huo_wuxing";
  } else if (menpai == "南海普陀山" || menpai == "陷空山无底洞") {
    ob->set_temp("wuxing/type", "tu_wuxing");
    if (menpai == "陷空山无底洞")
      ob->set_temp("wuxing/flag", 0);
    else ob->set_temp("wuxing/flag", 1);

    return "tu_wuxing";
  } else if (menpai == "五庄观")
    return "all_wuxing";
  else if (menpai == "蜀山剑派")
    return "none_wuxing";
  else if (menpai == "幻世勇者")
    return "might_wuxing";
  else if (menpai == "幻世魔导")
    return "magic_wuxing";

  return "none";

}
void check_npc_skill_level(object npc) {
  int skill, level, exp;
  string sk_level;
  if (userp(npc)) return;

  level = npc->query("level");
  exp = npc->query("combat_exp");
  exp = exp * 2 / 3 + random(exp / 3);
  if (!level) {
    level = LEVEL_D->query_level(exp);

    npc->set("level", level);
  }
  skill = npc->query_skill("dodge", 1);
  if (skill >= 650 && !npc->query("skill_level/dodge"))
    npc->set("skill_level/dodge", "grandmaster");
  else if (skill >= 300 && !npc->query("skill_level/dodge"))
    npc->set("skill_level/dodge", "master");
  else if (skill >= 200 && !npc->query("skill_level/dodge"))
    npc->set("skill_level/dodge", "expert");
  skill = npc->query_skill("parry", 1);
  if (skill >= 650 && !npc->query("skill_level/parry"))
    npc->set("skill_level/parry", "grandmaster");
  else if (skill >= 300 && !npc->query("skill_level/parry"))
    npc->set("skill_level/parry", "master");
  else if (skill >= 200 && !npc->query("skill_level/parry"))
    npc->set("skill_level/parry", "expert");

  skill = npc->query_skill("unarmed", 1);
  if (skill >= 650 && !npc->query("skill_level/unarmed"))
    npc->set("skill_level/unarmed", "grandmaster");
  else if (skill >= 300 && !npc->query("skill_level/unarmed"))
    npc->set("skill_level/unarmed", "master");
  else if (skill >= 200 && !npc->query("skill_level/unarmed"))
    npc->set("skill_level/unarmed", "expert");

  skill = npc->query_skill("force", 1);
  if (skill >= 650 && !npc->query("skill_level/force"))
    npc->set("skill_level/force", "grandmaster");
  else if (skill >= 300 && !npc->query("skill_level/force"))
    npc->set("skill_level/force", "master");
  else if (skill >= 200 && !npc->query("skill_level/force"))
    npc->set("skill_level/force", "expert");

  skill = npc->query_skill("spells", 1);
  if (skill >= 650 && !npc->query("skill_level/spells"))
    npc->set("skill_level/spells", "grandmaster");
  else if (skill >= 300 && !npc->query("skill_level/spells"))
    npc->set("skill_level/spells", "master");
  else if (skill >= 200 && !npc->query("skill_level/spells"))
    npc->set("skill_level/spells", "expert");


}

void init_user_wuxing(object ob) {
  string wuxing;
  int flag, npc, user, effect;
  int i, j, k, m, n, p, spi, con, kar, cps, per, cor;
  int force, spells, unarmed, dodge, parry, literate, level;
  reset_eval_cost();
  if (!ob) return;

  if (!ob->is_character()) return;
  if (ob->query_temp("wuxing/init_done")) return;
  wuxing = query_ob_wuxing(ob);
  ob->set_temp("wuxing/type", wuxing);
  check_npc_skill_level(ob);
  flag = ob->query_temp("wuxing/flag");

  spi = ob->query("spi");
  con = ob->query("con");
  kar = ob->query("kar");
  cps = ob->query("cps");
  per = ob->query("per");
  cor = ob->query("cor");
  force = ob->query_skill("force", 1);
  spells = ob->query_skill("spells", 1);
  unarmed = ob->query_skill("unarmed", 1);
  dodge = ob->query_skill("dodge", 1);
  parry = ob->query_skill("parry", 1);
  literate = ob->query_skill("literate", 1);
  level = ob->query("level");
  i = (spi - 25) * 50;
  j = (con - 20) * 30;
  k = kar - 20;
  m = cps - 20;
  n = per - 20;
  p = cor - 20;
  reset_eval_cost();
  if (!userp(ob)) {
    i = 1;
    j = 1;
    k = 1;
    m = 1;
    n = 1;
    p = 1;

  }
  if (i > 0)
    i = i / 2 + random(i / 2 + 50);
  else i = i / 2 - random(-i / 2 + 50);

  if (j > 0)
    j = j / 2 + random(j / 2 + 30);
  else j = j / 2 - random(-j / 2 + 30);

  if (ob->query("age") > 17) {
    if (k >= 0)
      ob->add_temp("combat/lucky", random(k / 5 + 1));
    else ob->add_temp("combat/lucky", -random(-k / 5 + 1));

  } else ob->add_temp("combat/lucky", 1 + random(3));
  if (ob->query("age") > 17) {
    if (n >= 0)
      ob->add_temp("combat/bless", random(n / 5 + 1));
    else ob->add_temp("combat/bless", -random(-n / 5 + 1));

  } else ob->add_temp("combat/bless", 1 + random(3));
  if (ob->query("age") > 17) {
    if (p > 0)
      ob->add_temp("apply/attack", p + random(p + 1) + level * level / 50);
    else ob->add_temp("apply/attack", p - random(-p + 1) + level * level / 50);
  } else ob->add_temp("apply/attack", 1 + random(3));
  if (ob->query("age") > 17) {
    if (m > 0)
      ob->add_temp("apply/defense", m + random(m + 1) + level * level / 50);
    else ob->add_temp("apply/defense", m - random(-m + 1) + level * level / 50);

  } else ob->add_temp("apply/defense", 1 + random(3));
  if (ob->query("age") > 17) {

    ob->add_temp("apply/magic_find", level * level * 2 + level);


  } else ob->add_temp("apply/magic_find", 1500);

  if (wuxing == "jin_wuxing") {

    ob->add_temp("apply/add_max_jin", WUXING_ADD_MAX + i + level * level / 2);
    ob->add_temp("apply/add_jin", WUXING_ADD_ON + i / 50 + level);
    ob->add_temp("apply/master_jin", MASTER_WUXING + i + level * level * 2 / 5);
    ob->add_temp("apply/master_resist_jin", MASTER_RESIST_WUXING + j + level * level * 2 / 5);

    ob->add_temp("apply/sub_max_jin", WUXING_SUB_HIGH + j + level * level / 3);
    ob->add_temp("apply/sub_jin", WUXING_SUB_HIGHON + j / 25 + level);
    ob->add_temp("apply/sub_max_huo", WUXING_EAT_HIGH + j + level * level / 3);
    ob->add_temp("apply/sub_huo", WUXING_EAT_HIGHON + j / 25 + level);

    if (flag) {
      ob->add_temp("apply/add_max_phy", 500 + i * 2 / 3 + level * level / 6);
      ob->add_temp("apply/add_phy", 5 + i / 75 + level * 2 / 3);
      ob->add_temp("apply/add_max_spells_all", 1000 + i * 2 / 3 + level * level / 6);
      ob->add_temp("apply/add_spells_all", 5 + i / 75 + level * 2 / 3);

      ob->add_temp("apply/sub_max_phy", 800 + j + level * level / 5);
      ob->add_temp("apply/sub_max_spells_all", 1000 + j + level * level / 4);
      ob->add_temp("apply/sub_max_mu", WUXING_EAT_MIDDLE + j + level * level / 3);
      ob->add_temp("apply/sub_mu", WUXING_EAT_MIDDLEON + j / 25 + level);
      ob->add_temp("apply/sub_max_shui", WUXING_EAT_LOW + j + level * level / 3);
      ob->add_temp("apply/sub_shui", WUXING_EAT_LOWON + j / 25 + level);

    } else {

      ob->add_temp("apply/add_max_shui", WUXING_ADD_LOW + i * 2 / 3 + level * level / 6);
      ob->add_temp("apply/add_shui", WUXING_ADD_LOWON + i / 75 + level * 2 / 3);
      ob->add_temp("apply/master_shui", MASTER_WUXING / 2 + i + level * level / 5);
      ob->add_temp("apply/master_resist_shui", MASTER_RESIST_WUXING / 2 + j + level * level / 5);

      ob->add_temp("apply/sub_max_phy", -500 + j + level * level / 5);
      ob->add_temp("apply/sub_max_spells_all", -1000 + j + level * level / 4);
      ob->add_temp("apply/sub_max_mu", WUXING_EAT_LOW + j + level * level / 3);
      ob->add_temp("apply/sub_mu", WUXING_EAT_LOWON + j / 25 + level);
      ob->add_temp("apply/sub_max_shui", WUXING_SUB_LOW + j + level * level / 3);
      ob->add_temp("apply/sub_shui", WUXING_SUB_LOWON + j / 25 + level);


    }


  }

  else if (wuxing == "mu_wuxing") {
    ob->add_temp("apply/add_max_mu", WUXING_ADD_MAX + i + level * level / 2);
    ob->add_temp("apply/add_mu", WUXING_ADD_ON + i / 50 + level);
    ob->add_temp("apply/master_mu", MASTER_WUXING + i + level * level * 2 / 5);
    ob->add_temp("apply/master_resist_mu", MASTER_RESIST_WUXING + j + level * level * 2 / 5);
    ob->add_temp("apply/sub_max_jin", WUXING_EAT_HIGH + j + level * level / 3);
    ob->add_temp("apply/sub_jin", WUXING_EAT_HIGHON + j / 25 + level);
    ob->add_temp("apply/sub_max_mu", WUXING_SUB_HIGH + j + level * level / 3);
    ob->add_temp("apply/sub_mu", WUXING_SUB_HIGHON + j / 25 + level);

    if (flag) {
      ob->add_temp("apply/master_shui", MASTER_WUXING / 2 + i + level * level / 5);
      ob->add_temp("apply/master_resist_shui", MASTER_RESIST_WUXING / 2 + j + level * level / 5);
      ob->add_temp("apply/add_max_shui", WUXING_ADD_LOW + i * 2 / 3 + level * level / 6);
      ob->add_temp("apply/add_shui", WUXING_ADD_LOWON + i / 75 + level * 2 / 3);

      ob->add_temp("apply/sub_max_phy", -500 + j + level * level / 5);
      ob->add_temp("apply/sub_max_spells_all", -1000 + j + level * level / 4);
      ob->add_temp("apply/sub_max_huo", WUXING_EAT_LOW + j + level * level / 3);
      ob->add_temp("apply/sub_huo", WUXING_EAT_LOWON + j / 25 + level);
      ob->add_temp("apply/sub_max_shui", WUXING_SUB_LOW + j + level * level / 3);
      ob->add_temp("apply/sub_shui", WUXING_SUB_LOWON + j / 25 + level);

    } else {
      ob->add_temp("apply/master_huo", MASTER_WUXING / 2 + i + level * level / 5);
      ob->add_temp("apply/master_resist_huo", MASTER_RESIST_WUXING / 2 + j + level * level / 5);
      ob->add_temp("apply/add_max_huo", WUXING_ADD_LOW + i * 2 / 3 + level * level / 6);
      ob->add_temp("apply/add_huo", WUXING_ADD_LOWON + i / 75 + level * 2 / 3);

      ob->add_temp("apply/sub_max_phy", -300 + j + level * level / 5);
      ob->add_temp("apply/sub_max_spells_all", -700 + j + level * level / 4);
      ob->add_temp("apply/sub_max_huo", WUXING_SUB_LOW + j + level * level / 3);
      ob->add_temp("apply/sub_huo", WUXING_SUB_LOWON + j / 25 + level);
      ob->add_temp("apply/sub_max_shui", WUXING_EAT_MIDDLE + j + level * level / 3);
      ob->add_temp("apply/sub_shui", WUXING_EAT_MIDDLEON + j / 25 + level);
    }

  }

  else if (wuxing == "shui_wuxing") {
    ob->add_temp("apply/add_max_shui", WUXING_ADD_MAX + i + level * level / 2);
    ob->add_temp("apply/add_shui", WUXING_ADD_ON + i / 50 + level);
    ob->add_temp("apply/master_shui", MASTER_WUXING + i + level * level * 2 / 5);
    ob->add_temp("apply/master_resist_shui", MASTER_RESIST_WUXING + j + level * level * 2 / 5);
    ob->add_temp("apply/sub_max_shui", WUXING_SUB_HIGH + j + level * level / 3);
    ob->add_temp("apply/sub_shui", WUXING_SUB_HIGHON + j / 25 + level);
    ob->add_temp("apply/sub_max_phy", -1000 + j + level * level / 5);
    ob->add_temp("apply/sub_max_spells_all", -1500 + j + level * level / 4);
    if (flag) {
      ob->add_temp("apply/master_jin", MASTER_WUXING / 2 + i + level * level / 5);
      ob->add_temp("apply/master_resist_jin", MASTER_RESIST_WUXING / 2 + j + level * level / 5);
      ob->add_temp("apply/add_max_jin", WUXING_ADD_LOW + i * 2 / 3 + level * level / 6);
      ob->add_temp("apply/add_jin", WUXING_ADD_LOWON + i / 75 + level * 2 / 3);

      ob->add_temp("apply/sub_max_jin", WUXING_SUB_LOW + j + level * level / 3);
      ob->add_temp("apply/sub_jin", WUXING_SUB_LOWON + j / 25 + level);
      ob->add_temp("apply/sub_max_mu", WUXING_EAT_LOW + j + level * level / 3);
      ob->add_temp("apply/sub_mu", WUXING_EAT_LOWON + j / 25 + level);
      ob->add_temp("apply/sub_max_huo", WUXING_EAT_MIDDLE + j + level * level / 3);
      ob->add_temp("apply/sub_huo", WUXING_EAT_MIDDLEON + j / 25 + level);


    } else {
      ob->add_temp("apply/master_mu", MASTER_WUXING / 2 + i + level * level / 5);
      ob->add_temp("apply/master_resist_mu", MASTER_RESIST_WUXING / 2 + j + level * level / 5);
      ob->add_temp("apply/add_max_mu", WUXING_ADD_LOW + i * 2 / 3 + level * level / 6);
      ob->add_temp("apply/add_mu", WUXING_ADD_LOWON + i / 75 + level * 2 / 3);

      ob->add_temp("apply/sub_max_jin", WUXING_EAT_MIDDLE + j + level * level / 3);
      ob->add_temp("apply/sub_jin", WUXING_EAT_MIDDLEON + j / 25 + level);
      ob->add_temp("apply/sub_max_mu", WUXING_SUB_LOW + j + level * level / 3);
      ob->add_temp("apply/sub_mu", WUXING_SUB_LOWON + j / 25 + level);
      ob->add_temp("apply/sub_max_huo", WUXING_EAT_LOW + j + level * level / 3);
      ob->add_temp("apply/sub_huo", WUXING_EAT_LOWON + j / 25 + level);

    }



  }

  else if (wuxing == "huo_wuxing") {
    ob->add_temp("apply/add_max_huo", WUXING_ADD_MAX + i + level * level / 2);
    ob->add_temp("apply/add_huo", WUXING_ADD_ON + i / 50 + level);
    ob->add_temp("apply/master_huo", MASTER_WUXING + i + level * level * 2 / 5);
    ob->add_temp("apply/master_resist_huo", MASTER_RESIST_WUXING + j + level * level * 2 / 5);
    ob->add_temp("apply/sub_max_huo", WUXING_SUB_HIGH + j + level * level / 3);
    ob->add_temp("apply/sub_huo", WUXING_SUB_HIGHON + j / 25 + level);
    ob->add_temp("apply/sub_max_shui", WUXING_EAT_HIGH + j + level * level / 3);
    ob->add_temp("apply/sub_shui", WUXING_EAT_HIGHON + j / 25 + level);

    if (flag) {
      ob->add_temp("apply/master_mu", MASTER_WUXING / 2 + i + level * level / 5);
