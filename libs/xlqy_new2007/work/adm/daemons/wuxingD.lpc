//对于特殊的npc五行的设定比较麻烦（如，李靖的怪，判将等，都是先setup然后再setskill,setfamily的..)
//似乎只能手工加入五行设定了..
/*
门派五行：五行 ：金克木 木克土 土克水 水克火 火克金 ※※金生水 水生木 木生火 火生土 土生金 
                 
                  防 	      防	          加       加	 	吃	     吃	         吃
                  15          25     	30%(+10)   15%(+5)	 20          15          10

金：fc             物(5)/魔(10)  电     	  电       物(5)/魔(10) 	    火       毒           水

    pansi          水          电     	  电 	   水	            火      物(5)/魔(10)    毒            
 
 
    
木：moon，         水          毒          毒 	   水      	   电         物(3)/魔(5)    火     

    hell          火          毒          毒        火   	  电        水              物(3)/魔(5)
	
水： lg ，         电          水     	  水        电  		    魔(15)/物(10)    火           毒  
   
    xs		  毒          水     	  水         毒 		    魔(15)/物(10)     电           火
	
火：jjf，         毒           火          火        毒 		    水         电          魔(15)/物(10)
    hyd      魔(15)/物(10)    火          火     魔(15)/物(10)       水         毒           电
	
土： pt            火    物(5)/魔(10)  魔(15)/物(10)    火	     毒         水           电           

,   wdd		   电    物(5)/魔(10)  魔(15)/物(10)    	电	     毒         火            水


全：   wzg        All(15)物(5)魔(10)  	-------------------------

无：shushan       物(15)         	物(15)        		all(25) 魔(15)

特： hsl might    -        -       －
特： hsl magic    -        -       －

force(专家，大师，宗师）：防魔 
spell(专家，大师，宗师）：加魔
parry(专家，大师，宗师）：防物
atksk(专家，大师，宗师）：加物

蓝－雷--金：即电，杀伤范围较大，如20-250,但有特效no_exert or no_perform or no_cast
绿－风--木: 即毒，杀伤力一般80，但是可以使对方中毒几秒，80+70+60=210...也可以使得对方遭受不良状态---疾病，虚弱，疯狂，诅咒，厄运，恐惧.
白－水－水：即冰，杀伤中等150，但可以使busy
红－火－火，杀伤力大300，可以使得no_move
黄－土－土，物理/魔法伤害
宝石体系
碎裂的宝石增加相应五行的攻击或防御.
瑕疵－－
完美－－
晶石－－

普通的五行，直接加damage..
专家的五行，加damage的百分比
大师的五行，则有各种特效

物理和魔法攻击加成没有10点附加。
以白板为例子

*/
#include <ansi.h>

#define WUXING_ADD_ALL		200
#define WUXING_ADD_MAX 		2500
#define WUXING_ADD_ON		15
#define WUXING_ADD_LOW		1500
#define WUXING_ADD_LOWON	5
#define MAGIC_ADD_MAX		1500
#define WUXING_SUB_LOW		2000
#define WUXING_SUB_LOWON	5
#define WUXING_SUB_HIGH		3000
#define WUXING_SUB_HIGHON	15
#define WUXING_EAT_HIGH 	-2000
#define WUXING_EAT_HIGHON 	-20
#define WUXING_EAT_MIDDLE 	-1500
#define WUXING_EAT_MIDDLEON	-15
#define WUXING_EAT_LOW		-500
#define WUXING_EAT_LOWON	-10
#define WUXING_SUB_ALL		1500
#define WUXING_EAT_ALL		-2500
#define MASTER_WUXING		1500
#define MASTER_RESIST_WUXING	1000

inherit F_DBASE;
