      ob->add_temp("apply/add_max_mu", effect * 30);
      ob->add_temp("apply/add_max_huo", effect * 30);
      ob->add_temp("apply/add_max_shui", effect * 30);
      ob->add_temp("apply/add_max_spells_all", effect * 25);

    }

    effect = ob->query("int") / 2 + random(ob->query("int") / 2);
    if (ob->query("special_skill/intellect") && ob->query("age") > 17)
      ob->add_temp("apply/magicback_damage", effect * 30);

    effect = ob->query("cps") / 2 + random(ob->query("cps") / 2);
    if (ob->query("special_skill/defense") && ob->query("age") > 17)
      ob->add_temp("apply/feedback_damage", effect * 40);
    effect = ob->query("str") / 4 + ob->query("cor") / 4 + random(ob->query("str") / 4 + ob->query("cor") / 4);
    if (ob->query("special_skill/power") && ob->query("age") > 17)
      ob->add_temp("apply/combat_ignore_armor", effect * 30);
    effect = ob->query("str") / 3 + ob->query("con") / 3 + random(ob->query("str") / 3 + ob->query("con") / 3);
    effect += random(effect);
    if (ob->query("special_skill/health") && ob->query("age") > 17)
      ob->add_temp("apply/regenerate_kee", effect);
    effect = ob->query("int") / 3 + ob->query("spi") / 3 + random(ob->query("int") / 3 + ob->query("spi") / 3);
    effect += random(effect);
    if (ob->query("special_skill/energy") && ob->query("age") > 17)
      ob->add_temp("apply/regenerate_sen", effect);
    effect = ob->query("cps") / 4 + ob->query("con") / 4 + random(ob->query("cps") / 4 + ob->query("con") / 4);
    if (ob->query("special_skill/ironskin") && ob->query("age") > 17)
      ob->add_temp("combat/parry_block_attack", effect * 30);

  }

  ob->set_temp("wuxing/init_done", 1);

}
varargs int query_ob_do_damage(object ob, int damage, string damage_type, string damage_kind) {
  string wuxing, menpai;

  int i, j, init_damage;
  i = 0;
  j = 0;
  init_damage = damage;

  if (!ob) return 0;

  if (!ob->is_character()) return 0;

  wuxing = query_ob_wuxing(ob);


  if (damage_type == "phy") {
    i = ob->query_temp("apply/add_max_phy");
    if (i > 17500) i = 17500;
    j = ob->query_temp("apply/add_phy");
    j = j * 5 / 6 + random(j * 9 / 8 - j * 5 / 6);
    damage += damage * i / 10000 + j;
    if (damage > init_damage * 3)
      damage = init_damage * 3;
    return damage;

  } else if (damage_type == "jin") {

    i = ob->query_temp("apply/add_max_jin");
    if (i > 17500) i = 17500;
    j = ob->query_temp("apply/add_jin");
    j = j / 2 + random(j);

  } else if (damage_type == "mu") {
    i = ob->query_temp("apply/add_max_mu");
    if (i > 17500) i = 17500;
    j = ob->query_temp("apply/add_mu");
    j = j * 3 / 4 + random(j * 6 / 5 - j * 3 / 4);

  } else if (damage_type == "shui") {

    i = ob->query_temp("apply/add_max_shui");
    if (i > 17500) i = 17500;
    j = ob->query_temp("apply/add_shui");
    j = j * 4 / 5 + random(j * 4 / 3 - j * 4 / 5);
  } else if (damage_type == "huo") {
    i = ob->query_temp("apply/add_max_huo");
    if (i > 17500) i = 17500;
    j = ob->query_temp("apply/add_huo");
    j = j + random(j / 4);
  } else if (damage_type == "magic") {
    if (damage_kind == "kee") {
      i = ob->query_temp("apply/add_max_spells_all") + ob->query_temp("apply/add_max_spells_kee");
      if (i > 17500) i = 17500;
      j = ob->query_temp("apply/add_spells_all") + ob->query_temp("apply/add_spells_kee");
      j = j * 2 / 3 + random(j * 8 / 7 - j * 2 / 3);
    }

    else if (damage_kind == "sen") {
      i += ob->query_temp("apply/add_max_spells_all") + ob->query_temp("apply/add_max_spells_sen");
      if (i > 17500) i = 17500;
      j = ob->query_temp("apply/add_spells_all") + ob->query_temp("apply/add_spells_sen");
      j = j * 2 / 3 + random(j * 8 / 7 - j * 2 / 3);
    }
    damage += damage * i / 10000 + j;
    if (damage > init_damage * 3)
      damage = init_damage * 3;
    return damage;

  }
  if (i < 0) i = 0;
  if (j < 0) j = 0;
  damage = damage * i / 10000 + j;
  if (damage > init_damage * 2)
    damage = init_damage * 2;
  return damage;

}

varargs int query_ob_re_damage(object ob, int damage, string damage_type, string damage_kind) {
  string wuxing;

  int i, j, init_damage;
  i = 0;
  j = 0;
  init_damage = damage;
  if (!ob) return 0;
  if (!ob->is_character()) return 0;
  if (!damage) return 0;

  wuxing = query_ob_wuxing(ob);

  if (damage_type == "phy") {
    j = ob->query_temp("apply/sub_phy");
    i = ob->query_temp("apply/sub_max_phy");
    if (ob->query_temp("apply/immune_phy")) {
      damage = 0;
      return damage;
    }

  } else if (damage_type == "jin") {

    j = ob->query_temp("apply/sub_jin");
    i = ob->query_temp("apply/sub_max_jin");

    if (ob->query_temp("apply/immune_jin")) {
      damage = 0;
      return damage;
    }

  }

  else if (damage_type == "mu") {


    j = ob->query_temp("apply/sub_mu");
    i = ob->query_temp("apply/sub_max_mu");

    if (ob->query_temp("apply/immune_mu")) {
      damage = 0;
      return damage;
    }


  }

  else if (damage_type == "shui") {

    j = ob->query_temp("apply/sub_shui");
    i = ob->query_temp("apply/sub_max_shui");

    if (ob->query_temp("apply/immune_shui")) {
      damage = 0;
      return damage;
    }
  }

  else if (damage_type == "huo") {



    j = ob->query_temp("apply/sub_huo");
    i = ob->query_temp("apply/sub_max_huo");

    if (ob->query_temp("apply/immune_huo")) {
      damage = 0;
      return damage;
    }
  } else if (damage_type == "magic") {


    if (damage_kind == "kee") {
      j = ob->query_temp("apply/sub_spells_kee") + ob->query_temp("apply/sub_spells_all");
      i = ob->query_temp("apply/sub_max_spells_kee") + ob->query_temp("apply/sub_max_spells_all");
    } else if (damage_kind == "sen") {
      j = ob->query_temp("apply/sub_spells_sen") + ob->query_temp("apply/sub_spells_all");
      i = ob->query_temp("apply/sub_max_spells_sen") + ob->query_temp("apply/sub_max_spells_all");
    }
    if (ob->query_temp("apply/immune_magic")) {

      damage = 0;
      return damage;
    }

  }
  if (i > 7500)
    i = 7500;

  damage -= j;
  damage -= damage * i / 10000;
  //起码能有1/4的damage伤害，除非免疫
  if (damage < init_damage / 4)
    damage = init_damage / 4 + 1;
  return damage;

}
void remove_huo_effect(object target) {
  if (target)
    target->delete_temp("no_move");

  return;
}
void remove_jinforce_effect(object target) {
  if (target)
    target->delete_temp("biqi");

  return;
}
void remove_jinmana_effect(object target) {
  if (target)
    target->delete_temp("jinzhou");

  return;
}
void remove_jinpfm_effect(object target) {
  if (target)
    target->delete_temp("fengmo");

  return;
}

varargs int query_total_damage(object ob, object victim, int init_damage, string type, string kind)  // ob is attacker,vic is be atked
{
  int damage, jin, mu, shui, huo;
  int suck_kee, effect;
  object weapon;
  object *inv, obj;
  string poison_type;
  if (!kind)
    return init_damage;
  if (wizardp(ob) && (string)ob->query("env/combat_wx") == "detail")
    tell_object(ob, "the init damage is " + init_damage + "\n");
  if (wizardp(victim) && (string)victim->query("env/combat_wx") == "detail")
    tell_object(victim, "the init damage is " + init_damage + "\n");
  inv = all_inventory(victim);
  weapon = ob->query_temp("weapon");

  if (kind == "phy") {

    damage = query_ob_do_damage(ob, init_damage, "phy", "kee");
    //	printf("the phy damage is %d\n",damage);
    if (wizardp(ob) && (string)ob->query("env/combat_wx") == "detail")
      tell_object(ob, "the phy damage is " + damage + "\n");
    if (wizardp(victim) && (string)victim->query("env/combat_wx") == "detail")
      tell_object(victim, "the phy damage is " + damage + "\n");
    if (ob->query_temp("apply/combat_ignore_phy") && (random(10000) < ob->query_temp("apply/combat_ignore_phy")))
      damage = damage;
    else {
      if (ob->query_temp("apply/sub_opp_phy"))
        victim->add_temp("apply/sub_phy", -ob->query_temp("apply/sub_opp_phy"));
      if (ob->query_temp("apply/sub_opp_maxphy"))
        victim->add_temp("apply/sub_max_phy", -ob->query_temp("apply/sub_opp_maxphy"));
      damage = query_ob_re_damage(victim, damage, "phy", "kee");
      if (ob->query_temp("apply/sub_opp_phy"))
        victim->add_temp("apply/sub_phy", ob->query_temp("apply/sub_opp_phy"));
      if (ob->query_temp("apply/sub_opp_maxphy"))
        victim->add_temp("apply/sub_max_phy", ob->query_temp("apply/sub_opp_maxphy"));
    }
    //	printf("the phy damage is %d\n",damage);
    if (wizardp(ob) && (string)ob->query("env/combat_wx") == "detail")
      tell_object(ob, "the phy damage is " + damage + "\n");
    if (wizardp(victim) && (string)victim->query("env/combat_wx") == "detail")
      tell_object(victim, "the phy damage is " + damage + "\n");
    jin = query_ob_do_damage(ob, damage, "jin");
    //	printf("the jin damage is %d\n",jin);
    if (wizardp(ob) && (string)ob->query("env/combat_wx") == "detail")
      tell_object(ob, "the jin damage is " + jin + "\n");
    if (wizardp(victim) && (string)victim->query("env/combat_wx") == "detail")
      tell_object(victim, "the jin damage is " + jin + "\n");
    jin = query_ob_re_damage(victim, jin, "jin");
    //	printf("the jin damage is %d\n",jin);
    if (wizardp(ob) && (string)ob->query("env/combat_wx") == "detail")
      tell_object(ob, "the jin damage is " + jin + "\n");
    if (wizardp(victim) && (string)victim->query("env/combat_wx") == "detail")
      tell_object(victim, "the jin damage is " + jin + "\n");
    effect = jin / 2 + random(jin * 3 / 2);
    if (effect > 400) {
      effect = effect / 130;
      if (effect > 10) effect = 10;
      if (effect < 3) effect = 3;
      if (ob->query_temp("apply/master_jin")) {
        suck_kee = ob->query_temp("apply/master_jin");
        if (!userp(ob))
          suck_kee = suck_kee / 2 + random(suck_kee / 2);
        if (suck_kee > 7500)
          suck_kee = 7500;
        effect += effect * suck_kee / 10000;
        if (random(10000) < random(suck_kee)) {
          if (weapon) {
            message_vision(
              HIB "$N手中的" + weapon->name() + HIB "轻轻一挥，迸出数道霹雳直冲$n而去！\n" NOR,
              ob,
              victim
            );
            suck_kee = victim->query_temp("apply/master_resist_jin");
            if (suck_kee > 7500)
              suck_kee = 7500;
            effect -= effect * suck_kee / 10000;
            if (effect < 1) effect = 1 + random(2);
            if (random(10000) > suck_kee) {
              if (random(2) && !victim->query_temp("jinzhou")) {
                message_vision(HIB "$N被霹雳所击中，只觉得天灵麻飕飕的，无法再运用法力！\n" NOR, victim);
                victim->set_temp("jinzhou", 1);
                victim->start_call_out(
                  (: call_other, __FILE__, "remove_jinmana_effect", victim :),
                  effect + random(effect)
                );
              } else if (random(2) && !victim->query_temp("biqi")) {
                message_vision(HIB "$N被霹雳所击中，只觉得丹田麻飕飕的，无法再运用内力！\n" NOR, victim);
                victim->set_temp("biqi", 1);
                victim->start_call_out(
                  (: call_other, __FILE__, "remove_jinforce_effect", victim :),
                  effect + random(effect)
                );

              } else if (!victim->query_temp("fengmo")) {
                message_vision(HIB "$N被霹雳所击中，只觉得手脚麻飕飕的，无法再施展外功！\n" NOR, victim);
                victim->set_temp("fengmo", 1);
                victim->start_call_out(
                  (: call_other, __FILE__, "remove_jinpfm_effect", victim :),
                  effect + random(effect)
                );
              }
            }
          } else {
            message_vision(HIB "$N手掌轻轻一挥，劈出数道霹雳直冲$n而去！\n" NOR, ob, victim);
            suck_kee = victim->query_temp("apply/master_resist_jin");
            if (suck_kee > 7500)
              suck_kee = 7500;
            effect -= effect * suck_kee / 10000;
            if (effect < 1) effect = 1 + random(2);
            if (random(10000) > suck_kee) {
              if (random(2) && !victim->query_temp("jinzhou")) {
                message_vision(HIB "$N被霹雳所击中，只觉得天灵麻飕飕的，无法再运用法力！\n" NOR, victim);
                victim->set_temp("jinzhou", 1);

                victim->start_call_out(
                  (: call_other, __FILE__, "remove_jinmana_effect", victim :),
                  effect + random(effect)
                );
              } else if (random(2) && !victim->query_temp("biqi")) {
                message_vision(HIB "$N被霹雳所击中，只觉得丹田麻飕飕的，无法再运用内力！\n" NOR, victim);
                victim->set_temp("biqi", 1);

                victim->start_call_out(
                  (: call_other, __FILE__, "remove_jinforce_effect", victim :),
                  effect + random(effect)
                );

              } else if (!victim->query_temp("fengmo")) {
                message_vision(HIB "$N被霹雳所击中，只觉得手脚麻飕飕的，无法再施展外功！\n" NOR, victim);
                victim->set_temp("fengmo", 1);

                victim->start_call_out(
                  (: call_other, __FILE__, "remove_jinpfm_effect", victim :),
                  effect + random(effect)
                );
              }
            }



          }
        }
      }

    }
    mu = query_ob_do_damage(ob, damage, "mu");
    //	printf("the nu damage is %d\n",mu);
    if (wizardp(ob) && (string)ob->query("env/combat_wx") == "detail")
      tell_object(ob, "the mu damage is " + mu + "\n");
    if (wizardp(victim) && (string)victim->query("env/combat_wx") == "detail")
      tell_object(victim, "the mu damage is " + mu + "\n");
    mu = query_ob_re_damage(victim, mu, "mu");
    if (wizardp(ob) && (string)ob->query("env/combat_wx") == "detail")
      tell_object(ob, "the mu damage is " + mu + "\n");
    if (wizardp(victim) && (string)victim->query("env/combat_wx") == "detail")
      tell_object(victim, "the mu damage is " + mu + "\n");
    //	printf("the nu damage is %d\n",mu);
    effect = mu * 3 / 4 + random(mu * 6 / 5 - mu * 3 / 4);
    if (effect > 250) {
      effect = effect / 100;
      if (effect > 8) effect = 8;
      if (effect < 3) effect = 3;

      if (ob->query_temp("apply/master_mu")) {
        suck_kee = ob->query_temp("apply/master_mu");
        if (!userp(ob))
          suck_kee = suck_kee / 2 + random(suck_kee / 2);
        if (suck_kee > 7500)
          suck_kee = 7500;
        effect += effect * suck_kee / 10000;
        if (random(10000) < random(suck_kee)) {
          if (weapon) {
            message_vision(HIG "$N手中的" + weapon->name() + HIG "飘出一股股绿瘴，直冲$n而去！\n" NOR, ob, victim);
            suck_kee = victim->query_temp("apply/master_resist_mu");
            if (suck_kee > 7500)
              suck_kee = 7500;
            effect -= effect * suck_kee / 10000;
            if (effect < 1) effect = 1 + random(2);
            if (random(10000) > suck_kee) {
              message_vision(HIG "$N吸了一口，顿觉天晕地转，已然身中奇毒！\n" NOR, victim);

              poison_type = poison[random(sizeof(poison))];

              if (victim->query("wuxing_poison/" + poison_type) < mu)
                victim->set("wuxing_poison/" + poison_type, mu);
              victim->apply_condition(
                poison_type,
                victim->query_condition(poison_type) + effect + random(effect)
              );


            }
          } else {
            message_vision(HIG "$N手掌划出一股股绿烟，直冲$n而去！\n" NOR, ob, victim);
            suck_kee = victim->query_temp("apply/master_resist_mu");
            if (suck_kee > 7500)
              suck_kee = 7500;
            effect -= effect * suck_kee / 10000;
            if (effect < 1) effect = 1 + random(2);
            if (random(10000) > suck_kee) {
              message_vision(HIG "$N吸了一口，顿觉天晕地转，已然身中奇毒！\n" NOR, victim);

              poison_type = poison[random(sizeof(poison))];
              if (victim->query("wuxing_poison/" + poison_type) < mu)
                victim->set("wuxing_poison/" + poison_type, mu);
              victim->apply_condition(
                poison_type,
                victim->query_condition(poison_type) + effect + random(effect)
              );

            }



          }
        }
      }

    }
    shui = query_ob_do_damage(ob, damage, "shui");
    //	printf("the shui damage is %d\n",shui);
    if (wizardp(ob) && (string)ob->query("env/combat_wx") == "detail")
      tell_object(ob, "the sghui damage is " + shui + "\n");
    if (wizardp(victim) && (string)victim->query("env/combat_wx") == "detail")
      tell_object(victim, "the shui damage is " + shui + "\n");
    shui = query_ob_re_damage(victim, shui, "shui");
    //	printf("the shui damage is %d\n",shui);
    if (wizardp(ob) && (string)ob->query("env/combat_wx") == "detail")
      tell_object(ob, "the sghui damage is " + shui + "\n");
    if (wizardp(victim) && (string)victim->query("env/combat_wx") == "detail")
      tell_object(victim, "the shui damage is " + shui + "\n");
    effect = shui * 4 / 5 + random(shui * 4 / 3 - shui * 4 / 5);

    if (effect > 210) {
      effect = effect / 120;
      if (effect > 5) effect = 5;
      if (effect < 2) effect = 2;

      if (ob->query_temp("apply/master_shui")) {
        suck_kee = ob->query_temp("apply/master_shui");
        if (!userp(ob))
          suck_kee = suck_kee / 2 + random(suck_kee / 2);
        if (suck_kee > 7500)
          suck_kee = 7500;
        effect += effect * suck_kee / 10000;
        if (random(10000) < random(suck_kee) && !victim->is_busy()) {
          if (weapon) {
            message_vision(WHT "\n$N手中的" + weapon->name() + WHT "发出阵阵寒气，直冲$n而去！\n" NOR, ob, victim);
            suck_kee = victim->query_temp("apply/master_resist_shui");
            if (suck_kee > 7500)
              suck_kee = 7500;
            effect -= effect * suck_kee / 10000;
            if (effect < 1) effect = 1 + random(2);
            if (random(10000) > suck_kee) {
              message_vision(WHT "$N不慎被寒气所侵，全身差点冻僵！\n" NOR, victim);
              victim->start_busy(effect + random(effect + 1));
            }
          } else {
            message_vision(WHT "\n$N手掌发出阵阵寒气，直冲$n而去！\n" NOR, ob, victim);
            suck_kee = victim->query_temp("apply/master_resist_shui");
            if (suck_kee > 7500)
              suck_kee = 7500;
            effect -= effect * suck_kee / 10000;
            if (effect < 1) effect = 1 + random(2);
            if (random(10000) > suck_kee) {
              message_vision(WHT "$N不慎被寒气所侵，全身差点冻僵！\n" NOR, victim);
              victim->start_busy(effect + random(effect));
            }



          }

        }
      }

    }
    huo = query_ob_do_damage(ob, damage, "huo");
    //	printf("the huo damage is %d\n",huo);
    if (wizardp(ob) && (string)ob->query("env/combat_wx") == "detail")
      tell_object(ob, "the huo damage is " + huo + "\n");
    if (wizardp(victim) && (string)victim->query("env/combat_wx") == "detail")
      tell_object(victim, "the huo damage is " + huo + "\n");
    huo = query_ob_re_damage(victim, huo, "huo");
    //	printf("the huo damage is %d\n",huo);
    if (wizardp(ob) && (string)ob->query("env/combat_wx") == "detail")
      tell_object(ob, "the huo damage is " + huo + "\n");
    if (wizardp(victim) && (string)victim->query("env/combat_wx") == "detail")
      tell_object(victim, "the huo damage is " + huo + "\n");
    effect = huo + random(huo / 4);
    if (effect > 270) {
      effect = effect / 110;
      if (effect > 10) effect = 10;
      if (effect < 3) effect = 3;

      if (ob->query_temp("apply/master_huo")) {
        suck_kee = ob->query_temp("apply/master_huo");
        if (!userp(ob))
          suck_kee = suck_kee / 2 + random(suck_kee / 2);
        if (suck_kee > 7500)
          suck_kee = 7500;
        effect += effect * suck_kee / 10000;
        if (random(10000) < random(suck_kee)) {
          if (weapon) {
            message_vision(HIR "\n$N手中的" + weapon->name() + HIR "散出一团火焰，直冲$n而去！\n" NOR, ob, victim);
            suck_kee = victim->query_temp("apply/master_resist_huo");
            if (suck_kee > 7500)
              suck_kee = 7500;
            effect -= effect * suck_kee / 10000;
            if (effect < 1) effect = 1 + random(2);
            if (random(10000) > suck_kee && !victim->query_temp("no_move")) {
              message_vision(HIR "$N" + HIR "被火所围，心中一惊，不知如何是好！\n" NOR, victim);
              victim->set_temp("no_move", 1);

              victim->start_call_out(
                (: call_other, __FILE__, "remove_huo_effect", victim :),
                effect + random(effect)
              );

              if (!random(13) || wizardp(ob)) {
                //	printf("the inv is %O\n",inv);
                if (sizeof(inv)) {
                  obj = inv[random(sizeof(inv))];

                  if (obj->move(environment(victim))) {
                    message_vision(HIR "只见火焰一舔，$N的$n顿时化为灰烬！\n" NOR, victim, obj);
                    destruct(obj);
                  }

                }

              }
            }
          } else {
            message_vision(HIR "\n$N手掌挥出一团火焰，直冲$n而去！\n" NOR, ob, victim);
            suck_kee = victim->query_temp("apply/master_resist_huo");
            if (suck_kee > 7500)
              suck_kee = 7500;
            effect -= effect * suck_kee / 10000;
            if (effect < 1) effect = 1 + random(2);
            if (random(10000) > suck_kee && !victim->query_temp("no_move")) {
              message_vision(HIR "$N" + HIR "被火所围，心中一惊，不知如何是好！\n" NOR, victim);
              victim->set_temp("no_move", 1);

              victim->start_call_out(
                (: call_other, __FILE__, "remove_huo_effect", victim :),
                effect + random(effect)
              );
              if (!random(23) || wizardp(ob)) {
                //	printf("the inv is %O\n",inv);
                if (sizeof(inv)) {
                  obj = inv[random(sizeof(inv))];

                  if (obj->move(environment(victim))) {
                    message_vision(HIR "只见火焰一舔，$N的$n顿时化为灰烬！\n" NOR, victim, obj);
                    destruct(obj);
                  }

                }

              }
            }



          }

        }
      }

    }
    damage = damage + jin + mu + shui + huo;
    if (!userp(ob))
      damage = damage / 2 + random(damage * 2 / 3);
    else damage = damage * 2 / 3 + random(damage / 2);
    //	printf("the final damage is %d\n",damage);	
    if (wizardp(ob) && (string)ob->query("env/combat_wx") == "detail")
      tell_object(ob, "the final damage is " + damage + "\n");
    if (wizardp(victim) && (string)victim->query("env/combat_wx") == "detail")
      tell_object(victim, "the final damage is " + damage + "\n");

  }

  else if (kind == "jin") {

    jin = query_ob_re_damage(victim, init_damage, "jin");
    return jin;

  } else if (kind == "mu") {

    mu = query_ob_re_damage(victim, init_damage, "mu");
    return mu;

  } else if (kind == "shui") {

    shui = query_ob_re_damage(victim, init_damage, "shui");
    return shui;

  } else if (kind == "huo") {

    huo = query_ob_re_damage(victim, init_damage, "huo");
    return huo;

  } else if (kind == "magic") {

    if (type == "kee") {
      damage = query_ob_do_damage(ob, init_damage, "magic", "kee");

      jin = victim->query_temp("apply/sub_max_spells_kee") + victim->query_temp("apply/sub_max_spells_all");
      mu = ob->query_temp("apply/combat_ignore_magic");
      shui = victim->query_temp("apply/immune_magic");
      if (mu && jin > 0 && random(10000) < mu && !shui)
        damage = damage;
      else
        damage = query_ob_re_damage(victim, damage, "magic", "kee");

    }

    else if (type == "sen") {
      damage = query_ob_do_damage(ob, init_damage, "magic", "sen");
      jin = victim->query_temp("apply/sub_max_spells_sen") + victim->query_temp("apply/sub_max_spells_all");
      mu = ob->query_temp("apply/combat_ignore_magic");
      shui = victim->query_temp("apply/immune_magic");
      if (mu && jin > 0 && random(10000) < mu && !shui)
        damage = damage;
      else
        damage = query_ob_re_damage(victim, damage, "magic", "sen");

    }



  } else if (kind == "spe_phy")   //特殊的攻击，如sheshen，fengchan
  {

    damage = query_ob_do_damage(ob, init_damage, "phy", "kee");
    if (wizardp(ob) && (string)ob->query("env/combat_wx") == "detail")
      tell_object(ob, "the phy damage is " + damage + "\n");
    if (wizardp(victim) && (string)victim->query("env/combat_wx") == "detail")
      tell_object(victim, "the phy damage is " + damage + "\n");
    damage = query_ob_re_damage(victim, damage, "phy", "kee");
    if (wizardp(ob) && (string)ob->query("env/combat_wx") == "detail")
      tell_object(ob, "the phy damage is " + damage + "\n");
    if (wizardp(victim) && (string)victim->query("env/combat_wx") == "detail")
      tell_object(victim, "the phy damage is " + damage + "\n");

  }
  if (damage < 0) damage = 0;
  return damage;


}
