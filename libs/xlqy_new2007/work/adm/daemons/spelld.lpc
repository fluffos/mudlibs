#include <ansi.h>

/* table for 法术相克 
   for example,
	dao": ({"moonshentong","gouhunshu"})
   means, dao can 克制 moonshentong and gouhunshu.
   */
mapping table = ([
  "baguazhou": ({ "dao", "pansi-dafa", "taiyi" }),
  "buddhism": ({ "dengxian-dafa", "seashentong", "taiyi" }),
  "dao": ({ "moonshentong", "gouhunshu", "taiyi" }),
  "taiyi": ({ "pansi-dafa", "dengxian-dafa", "gouhunshu", "pingtian-dafa", "yaofa" }),
  "taoism": ({ "baguazhou", "dao", "buddhism", "moonshentong", "seashentong" }),
  "dengxian-dafa": ({ "baguazhou", "pingtian-dafa", "taoism" }),
  "pingtian-dafa": ({ "dao", "pansi-dafa", "taoism" }),
  "yaofa": ({ "dengxian-dafa", "seashentong", "taoism" }),
  "pansi-dafa": ({ "moonshentong", "gouhunshu", "taoism" }),
  "gouhunshu": ({ "buddhism", "yaofa", "taoism" }),
  "moonshentong": ({ "buddhism", "yaofa", "taiyi" }),
  "seashentong": ({ "baguazhou", "pingtian-dafa", "taiyi" }),
]);

/* determine whether two 法术 are 相克制
   if spell1 克制 spell2, then return = 1.
   if spell2 克制 spell1, then return = -1.
   otherwise, return 0.
   */
int skill_xiangke(string spell1, string spell2) {
  int neutral = 0;
  int result;

  if (undefinedp(table[spell1]) ||
    undefinedp(table[spell2])) return neutral;

  if (member_array(spell1, table[spell2]) > -1) {
    // spell2 can 克制 spell1.
    result = -1;
  } else if (member_array(spell2, table[spell1]) > -1) {
    // spell1 can 克制 spell2.
    result = 1;
  } else {
    result = neutral;
  }

  return result;
}

/* determine whether two players' 法术 are 相克制
   only effective between two players,
   or a NPC against a player,
   can't a player take advantage of a npc.
   if obj1 克制 obj2, then return = 1.
   if obj2 克制 obj1, then return = -1.
   otherwise, return 0.
   */
int check_xiangke(object obj1, object obj2) {
  int neutral = 0;
  int result;
  string skill1, skill2;

  skill1 = obj1->query_skill_mapped("spells");
  skill2 = obj2->query_skill_mapped("spells");

  if ((int)obj1->query_skill(skill1, 1) < 36) return neutral;
  if ((int)obj2->query_skill(skill2, 1) < 36) return neutral;
  if (obj1->query_temp("special_spells"))
    skill1 = obj1->query_temp("special_spells");
  if (obj2->query_temp("special_spells"))
    skill2 = obj2->query_temp("special_spells");
  // need at least 36 level of special spells.

  result = skill_xiangke(skill1, skill2);



  return result;
}

int attacking_cast_success(object attacker, object target, int success_adj) {
  float ap, dp;
  int success;
  int xk;
  int resu;
  //ap,dp /= 10,bugbug,2002-5-14
  ap = (float)attacker->query_skill("spells");
  ap = (ap * ap / 10 * ap / 10);
  //this is from skill.
  //at high daoxing, the skill level can not follow, so need adjustment here.
  //	ap = ap*(1+(float)attacker->query("daoxing")/500000);
  ap = ap + (float)attacker->query("daoxing") / 10;
  dp = (float)target->query("daoxing") / 10 + (float)target->query("combat_exp") / 20;
  //note here, combat_exp is also useful in avoiding been casted.

  success = 0;

  if (success_adj < 50) success_adj = 50;
  else if (success_adj > 200) success_adj = 200;

  //ap = ap*success_adj/100;
  ap = ap / 100 * success_adj;
  // mon 01/22/99
  xk = check_xiangke(attacker, target);
  if (xk == 1) {
    dp = dp / 3;
  } else if (xk == -1) {
    ap = ap / 3;  //  alading adjust dp=dp/5 -> dp=dp/3	2002/10/11
  }
  // resu = (int)(dp*100/(ap+dp))*1;
  if (random(100) > (dp * 100 / (ap + dp))) success = 1;

  return success;
}

int attacking_cast_damage(object attacker, object target, int damage_adj) {
  float a_fali, d_fali, damage, damage_bonus, sen1, sen2;
  int xk;

  if (damage_adj < 50) damage_adj = 50;
  else if (damage_adj > 250) damage_adj = 250;

  //will use current fali...but do not allow it exceeds 2 time of the max.
  a_fali = (float)attacker->query("mana");
  if (a_fali > 2 * (float)attacker->query("max_mana")) a_fali = 2 * (float)attacker->query("max_mana");
  d_fali = (float)target->query("mana");
  if (d_fali > 2 * (float)target->query("max_mana")) d_fali = 2 * (float)target->query("max_mana");


  //fali and shen.
  //	a_fali=a_fali/40+random((float)attacker->query("eff_sen") / 20); 
  if (a_fali - d_fali > 5000)
    a_fali = d_fali + 5000;
  if (d_fali - a_fali > 5000)
    d_fali = a_fali + 5000;
  sen1 = (float)attacker->query("eff_sen");
  sen2 = (float)target->query("eff_sen");
  if (sen1 - sen2 > 2000)
    sen1 = sen2 + 2000;
  if (sen2 - sen1 > 2000)
    sen2 = sen1 + 2000;

  // 以下四行 tonii 修改于 2003-5-10，目的是增强法术在灭妖时的作用
  a_fali = a_fali / 100 + random(sen1 / 100);
  d_fali = d_fali / 100 + random(sen2 / 100);  //降低神和当前法力的影响作用
  if ((d_fali - a_fali) > target->query("mana_factor") / 3)
    d_fali = a_fali + target->query("mana_factor") / 3;  //降低反击几率，限定反击伤害
    //mana_factor, here the attacker has some advantage.
    //the damage_adj higher, the better for attacker.
    a_fali += attacker->query("mana_factor") * damage_adj * 1.2 / 100;

  d_fali += random(target->query("mana_factor"));

  xk = check_xiangke(attacker, target);
  if (xk == 1) {
    d_fali /= 2;
  } else if (xk == -1) {
    a_fali /= 2;  // 法术相克 由 /=3  改为  /=2     alading (3/24/02)
  }

  damage = a_fali - d_fali;

  //for backfire, we need let it be serious...
  if (damage < 0) damage = damage - random(target->query("mana_factor")) / 2;
  //here increase the damage, since previously it's included in random()
  if (damage > 0) damage = damage + random(attacker->query("mana_factor")) / 2;  // alading 2002-4-9

  damage = damage * damage_adj / 100;  //last damage scaled again.

  //finally, we need let the spell level useful...
  //the setting is, at enabled level 200, the damage will double.
  if (damage > 0) {
    damage_bonus = (int)attacker->query_skill("spells") / 50;  // alading change 200 to 50
    if (damage_bonus > 12) damage_bonus = 12;
    damage_bonus = damage_bonus + random(damage_bonus);
    damage = damage + damage * damage_bonus / 6;    //   alading add  "/6"

  } else if (damage < 0) {
    damage_bonus = (int)target->query_skill("spells") / 50;
    if (damage_bonus > 12) damage_bonus = 12;
    damage_bonus = damage_bonus + random(damage_bonus);
    damage += damage * damage_bonus / 6;

  }

  return to_int(damage);
}

//weiqi 981206
//this function can be called when want apply a damage to a victim while allow
//the victim use his/her self-made fabao to defense.
void apply_damage(object winner, object victim,
  int damage, string damage_type, string msg_hit) {
  int i, temp, type, adjust, success;
  int damage_qi, damage_shen;
  object *inv;
  int def_count = 0;
  int t_armor = 0;
  string *msg_fabao = ({
    "只见$N的$n霞光一闪！\n",
    "只见$N的$n霞光再闪！\n",
    "只见$N的$n霞光又一闪！\n",
    "只见$N的$n霞光再一闪！\n"
  });

  string *msg_gold = ({
    HIY "只见$n身后隐约金光一闪,$N的攻击顿时减弱了！\n" NOR,
    HIY "只见$n身后隐约金光再闪,$N的攻击顿时减弱了！\n" NOR,
    HIY "只见$n身后隐约金光又一闪,$N的攻击顿时减弱了！\n" NOR,
    HIY "只见$n身后隐约金光再一闪,$N的攻击顿时减弱了！\n" NOR
  });

  if (damage <= 0) return;

  if (damage_type == "qi" || damage_type == "kee") {
    damage_qi = damage;
    damage_shen = 0;
    type = 0;
  } else if (damage_type == "shen" || damage_type == "sen") {
    damage_qi = 0;
    damage_shen = damage;
    type = 1;
  } else {
    damage_qi = damage;
    damage_shen = damage;
    type = 2;
  }

  if (victim->query_temp("anti_magic")) {
    adjust = (int)victim->query_temp("anti_magic");

    if ((int)victim->query("mana") < adjust)
      success = 0;
    else
      success = 1;

    if (success) {
      victim->add("mana", -adjust);
      damage_qi = damage_qi - adjust / 2;
      damage_shen = damage_shen - adjust / 2;
      if (damage_qi < 0) damage_qi = 0;
      if (damage_shen < 0) damage_shen = 0;
      if (damage_qi > 0 || damage_shen > 0)
        message_vision(HIW "\n只见$N身后幻出千朵白莲，挡住了$n的攻势。\n" NOR, victim, winner);
      else
        message_vision(HIW "\n只见$N身后幻出千朵白莲，将$n的攻势尽数化解。\n" NOR, victim, winner);
    }
  }

  //check if the victim equipped defense fabao...
  inv = all_inventory(victim);
  for (i = 0; i < sizeof(inv); i++) {
    if (inv[i]->query("gold_armor") && inv[i]->query("equipped"))  //黄金装备
    {
      t_armor = t_armor + inv[i]->query("spi") * victim->query("spi") / 5 + random(inv[i]->query("spi") * victim->query("spi") / 10);
      continue;
    }


    if (!inv[i]->query("series_no") || !inv[i]->query("fabao") || !inv[i]->query("equipped"))
      continue;  //not a equipped fabao.

      if ((type == 0) || (type == 2))  //check if can reduce damage_qi.
      {
        temp = inv[i]->protect_qi(damage_qi);
        //temp is the damage left after fabao takes effect.

        if (temp < damage_qi)  //means fabao useful.
        {
          damage_qi = temp;
          message_vision(msg_fabao[def_count], victim, inv[i]);
          def_count++;
        }
      }

    if ((type == 1) || (type == 2))  //check if can reduce damage_shen.
    {
      temp = inv[i]->protect_shen(damage_shen);
      //temp is the damage left after fabao takes effect.

      if (temp < damage_shen)  //means fabao useful.
      {
        damage_shen = temp;
        message_vision(msg_fabao[def_count], victim, inv[i]);
        def_count++;
      }
    }
  }  //end of for i=0 loop.

  //finally we can make damage to the victim...


  if (damage_qi > 0 || damage_shen > 0) {  //produce the hit message...
    if (t_armor > 0) {
      message_vision(msg_gold[random(sizeof(msg_gold))], winner, victim);
      // message_vision(YEL"$n"+YEL"的身后隐约丈二的金光笼罩！\n"NOR, winner, victim);
      damage_qi = damage_qi - t_armor;
      damage_shen = damage_shen - t_armor;
      if (damage_qi < 0) damage_qi = 0;
      if (damage_shen < 0) damage_shen = 0;
      //  message_vision(HIY"结果$N的"+HIYL"攻击被$n"+HIY"身后的金光挡住！\n"NOR, winner, victim);
    } else {

      message_vision(msg_hit, winner, victim);
    }
  }

  else
    //the fabao saved the target...
    message_vision("结果$N的攻击完全被$n的法宝挡住！\n", winner, victim);


  if (damage_qi > 0) {
    t_armor = victim->receive_damage("kee", (int)damage_qi, winner, "magic");
    victim->receive_wound("kee", (int)t_armor / 2, winner);
    if (victim->query_temp("apply/magicback_damage") && random(2)) {
      damage_qi = victim->query_temp("apply/magicback_damage");
      if (damage_qi > 7500)
        damage_qi = 7500 + random(500);
      message_vision(BLINK + HIC "$N身上突然绚出一道诡异的蓝光，竟将攻击反射直向$n而去！\n" NOR, victim, winner);
      damage_qi = t_armor * damage_qi / 10000;
      damage_qi = winner->receive_damage("kee", (int)damage_qi);
      winner->receive_wound("kee", (int)random(damage_qi / 2));

      COMBAT_D->report_status(winner);
    }

    COMBAT_D->report_status(victim);

  }
  if (damage_shen > 0) {
    t_armor = victim->receive_damage("sen", (int)damage_shen, winner, "magic");
    victim->receive_wound("sen", (int)t_armor / 2, winner);
    if (victim->query_temp("apply/magicback_damage") && random(2)) {
      damage_shen = victim->query_temp("apply/magicback_damage");
      if (damage_shen > 7500)
        damage_shen = 7500 + random(500);
      if (damage_qi > 0)
        //	message_vision(BLINK+HIC"$N身上突然绚出一道诡异的蓝光，竟将攻击反射直向$n而去！\n",victim,winner);
        damage_qi = 0;
      else message_vision(BLINK + HIC "$N身上突然绚出一道诡异的蓝光，竟将攻击反射直向$n而去！\n" NOR, victim, winner);
      damage_shen = t_armor * damage_shen / 10000;
      winner->receive_damage("sen", (int)damage_shen);
      winner->receive_wound("sen", (int)random(damage_shen / 2));
      COMBAT_D->report_sen_status(winner);

    }

    COMBAT_D->report_sen_status(victim);

  }

  return;
}

/*
weiqi 981206
attacking-cast...called from spells function.
a typical call would be:

	SPELL_D->attacking_cast(
		me, 
			//attacker 
		target, 
			//target
		success_adj, 	
			//success adjustment
		damage_adj, 	
			//damage adjustment
		"both", 		
			//damage type: could be "qi"/"kee", "shen"/"sen", ...default "both"
		HIC "$N几个指头迅速捻动，突然张嘴一喷！红橙黄三道火焰呼！地一声向$n卷去！\n" NOR,
			//initial message
		HIC "结果$n被烧得焦头烂额！\n" NOR, 
			//success message
		HIC "但是$n轻轻一跳就躲了开来。\n" NOR, 
			//fail message
		HIC "但是火焰被$n以法力一逼，反向$N回卷而去！\n" NOR, 
			//backfire initial message
		HIC "结果太乙真火反噬，$n被烧得焦头烂额！\n" NOR
			//backfire hit message. note here $N and $n!!!
	);
*/
void attacking_cast(
  object attacker,
  object target,
  int success_adj,
  int damage_adj,  //default value is 100 for this 2 parameters.
  string damage_type,  //must be "shen"/"sen", "qi"/"kee" or "both"(default)
  string msg_init,
  string msg_success,
  string msg_fail,
  string msg_backfire_init,
  string msg_backfire_success) {
  float damage;

  //first, show the initial message...
  message_vision(msg_init, attacker, target);

  //calculate if the casting can happen...
  if (attacking_cast_success(attacker, target, success_adj) == 0) {
    message_vision(msg_fail, attacker, target);
    //let the target kill attacker.
    target->kill_ob(attacker);
    return;
  }

  damage = attacking_cast_damage(attacker, target, damage_adj);

  if (damage > 0)  //attacker hit target
    apply_damage(attacker, target, to_int(damage), damage_type, msg_success);

  else if (damage < 0)  //backfire
  {
    message_vision(msg_backfire_init, attacker, target);
    apply_damage(
      target,
      attacker,
      -to_int(damage / 2 + random(damage) / 3),
      damage_type,
      msg_backfire_success
    );  //alading modify
    //		apply_damage(target, attacker, -to_int(damage), damage_type, msg_backfire_success);
  }

  else  //damge=0
    message_vision(HIB "结果正好被$N以法力逼住，谁也没有吃亏。\n" NOR, target);

  //let the target kill attacker.
  target->kill_ob(attacker);

  return;
}
