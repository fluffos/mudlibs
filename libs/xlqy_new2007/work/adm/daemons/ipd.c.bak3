string get_local(string ip_list,string ip)
{
	
	string *ip_list_start, *ip_list_end;
	int i, j, k=0;
	int ip_start, ip_end, now_ip;
	string *user_ip;
	string *ip_address;
if(!ip_list) return "未知的ip";
	
	user_ip = explode(ip, ".");
	ip_address = explode(ip_list, "\n");
	
 reset_eval_cost();
	for (i = 0; i < sizeof(ip_address); i++) 
	{
                if (atoi(ip_address[i][0..2])==atoi(user_ip[0])) 
                {
                        ip_list_start = explode(ip_address[i][0..14], ".");
                        ip_list_end = explode(ip_address[i][16..30], ".");

                        for ( j = 1;j< 4 ;j++ ) 
                        {
																reset_eval_cost();
                                ip_start=atoi(ip_list_start[j]);
                                ip_end=atoi(ip_list_end[j]);
                                now_ip=atoi(user_ip[j]);
                                if ( now_ip <= ip_end && now_ip >= ip_start )
                                        k++;
                        }
                        if ( k == 3 ) 
                        {
                                return ip_address[i][32..]+"。";
                        }
                        k=0;
                }
   }
   return 0;
}


string seek_ip_address(string ip)
{
        string str,result;
        string *user_ip;
        string ip_config="/adm/etc/ipdata1";
        
        user_ip = explode(ip, ".");
        return "ip所属地未知！" ;
        
        if ( atoi(user_ip[0])<=062 )
        {
        	ip_config="/adm/etc/ipdata1";
        	if(!str=read_file(ip_config,0,3000)) return "ip数据文件为空！";
        	
        	if ( result=get_local(read_file(ip_config,0,3000),ip) )
        		return result;
        	else if ( result=get_local(read_file(ip_config,3000,3000),ip) )
        		return result;
        	else if ( result=get_local(read_file(ip_config,5000),ip) )
        		return result;        	
        	else
        		return "ip所属地未知！" ;
        }
        else if ( atoi(user_ip[0])<=158 )
