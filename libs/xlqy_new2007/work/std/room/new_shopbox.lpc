// by mon. 2/28/98

#include <ansi.h>

inherit ITEM;
inherit F_SAVE;

private string SAVE_NAME = "hockshop_save";
private nosave int can_save = 1;

void create() {
  set_name("聚宝盒", ({ "treasure box", "box" }));
  set("short", "聚宝盒");
  set("env/invisibility", 1);
  seteuid(getuid()); set_max_encumbrance(50000000);
  set_max_items(10000);
  set_weight(100);
  set("no_get", 1);
  set("no_magic", 1);
  set("no_fight", 1);
  seteuid(getuid());
  setup();

}
string query_save_file() {
  string id;
  object env;
  env = environment();
  if (!env) return 0;
  id = env->query("place_id");
  if (!id) return 0;
  return sprintf(DATA_DIR "hockshop/%s", id);
}

int save() {
  string file;
  int i;

  if (stringp(file = this_object()->query_save_file())) {
    assure_file(file + __SAVE_EXTENSION__);
    i = save_object(file);
    return i;
  }
  return 0;
}

int restore() {
  string file;
  mapping goods, names;
  string *name, fn;
  object ob;
  int i;
  if (stringp(file = this_object()->query_save_file())) {
    restore_object(file);

    if (!mapp(goods = query("goods")))
      return 1;
    if (!mapp(names = query("names")))
      return 1;
    name = keys(goods);
    i = sizeof(goods);
    if (!i)
      return 1;
    for (int jj = 0; jj < i; jj++) {
      fn = goods[name[jj]];
      if (!fn) continue;
      ob = new(fn);

      if (!ob) continue;
      ob->set("name", names[name[jj]]);
      ob->move(this_object());
      set_temp("real_goods/" + name[jj], ob);

    }

    return 1;
  }
  return 0;
}

int clean_up() {
  return 0;
}

void reset() {
  //   mapping numbers=query_temp("numbers");
  mapping numbers = query("numbers");
  string *key;
  int *value, i;

  if (!numbers) return;

  key = keys(numbers);
  value = values(numbers);
  i = sizeof(numbers);

  while (i--) {
    if (value[i] > 100)
      //   set_temp("numbers/"+key[i],value[i]-2);
      set("numbers/" + key[i], value[i] - 2);
  }

  return;
}
