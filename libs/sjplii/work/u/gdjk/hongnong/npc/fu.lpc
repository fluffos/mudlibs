#include <ansi.h>
inherit NPC;


void do_permit();
create()
{
        set_name("农妇", ({"nong fu"}) );
        set("gender", "女性");
        set("long", "一个穿着朴素，神情不安的农妇。\n");
        set("age", 30);
        set("attitude", "friendly");
        set("combat_exp", 2000);
        set("score",200);
        set_skill("parry",18);
        set_skill("unarmed", 18);
        set_skill("dodge", 18);
        set("chat_chance", 10);
//        set("chat_msg", ({
//                (:random_move :)
 //       }) );

        setup();
        carry_object("/obj/cloth");
}

int accept_fight(object ob)
{
  return 1;
}


