// inn.c

inherit ROOM;


void create()
{
        set("short", "毒谷钱庄");
        set("long", @LONG
这是一家私人钱庄， 但规模很大，信誉很好，它发行的银票通行全国。
这里原本是"穆记钱庄"，但是去年被强盗洗劫一空，老板只好转让给毒谷。
钱庄的门口挂着一块很大的金字招牌，上书"毒谷钱庄"。宽阔的大厅，长
长的柜台，都打扫的干干净净。柜台后几个账房先生与小活计正在忙的焦
头烂额。柜台上放着一个牌子(sign)，提醒着大家。
LONG
        );
        set("exits", ([
                "south"          : __DIR__"jie-3",
        ]) );
        set("item_desc", ([
                "sign": @TEXT
这里是钱庄，目前我们提供的服务有：

convert     兑换钱币。
withdraw    提取存款。
deposit     存入钱币。
balance     察寻存款。
TEXT
        ]) );


        set("objects", ([
//                __DIR__"npc/bank_boss" : 1,

                        ]) );
        set("NONPC",1);

        setup();
}

