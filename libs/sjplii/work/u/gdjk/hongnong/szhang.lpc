int valid_leave(object me, string dir)
{
        if ( me->query("quest/guanfu") =="toushi" )
	return ::valid_leave(me, dir);
	if (dir == "south" ) {
        if (!objectp(present("bai weitang", environment(me))))
	return notify_fail("这里是国家兵工场，寻常人等不得进入。\n");
        }   
        return ::valid_leave(me, dir);
}

