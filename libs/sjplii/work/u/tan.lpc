#include <ansi.h>
inherit F_MASTER;
inherit NPC;
int about_quest();
string do_over();
void create() {
  set_name("檀香子", ({ "tan xiangzi", "tan" }));
  set("long",
    "檀香子是逍遥第十三代弟子，负责分发任务。\n");

  set("attitude", "friendly");

  create_family("逍遥派", 13, "弟子");
  set("title", "逍遥第十三代");

  set("str", 10);
  set("int", 30);
  set("cor", 10);
  set("spi", 10);
  set("agi", 10);
  set("per", 30);
  set("max_kee", 300);
  set("max_gin", 300);
  set("max_sen", 300);
  set("kee", 100);
  set("gin", 100);
  set("sen", 100);
  set("force", 700);
  set("max_force", 700);
  set("force_factor", 20);
  set("score", 10000);
  set_temp("apply/defense", 10);
  set_temp("apply/move", 10);
  set("inquiry", ([
    "干活": (: about_quest :),

    "交工": (: do_over :),

  ]));


  set("combat_exp", 19000);

  set("relation_exp", 90000);
  set("life_exp", 50000);

  set_skill("force", 50);
  set_skill("parry", 50);
  set_skill("unarmed", 50);
  set_skill("dodge", 50);
  set_skill("sword", 50);
  set_skill("move", 50);
  set_skill("literate", 50);

  set_skill("bm_force", 30);

  setup();

  carry_object("/obj/cloth")->wear();
}
void init() {
  add_action("do_cancel", "cancel");
}



void attempt_apprentice(object me) {
  object ling;
  string name;
  name = this_player()->query("name");
  ling = new(__DIR__ "obj/yupei");

  if (me->query_temp("permit2")) {
    command("nod");
    command("recruit " + me->query("id"));
    me->set("class", "xiaoyao");
    me->set("id_type", 1);
    command("say 这是你的如意令不要乱丢哦？是本门弟子的信物。\n");
    ling->set("owner", name);
    ling->move(this_player());
    me->delete_temp("permit2");
    return;
  }
  command("hmm");
  command("say 大师伯说过不让随便接受新弟子的，对不起呀。");
}






int do_cancel(string arg) {
  object me = this_player();
  if (!arg || arg != "quest")
    return notify_fail("你要取消什么？\n");
  if (!(int)me->query("xiaoyao/quest"))
    return notify_fail("你现在没有任务。\n");
  say(CYN "檀香子摇了摇头叹息道：“劳动对于武功的修习也是很有帮助的，以后你要好好努力呀。\n" NOR);
  if ((int)me->query("combat_exp") <= 1000) {
    me->set("xiaoyao/quest", 0);
    me->set_temp("over", 0);
    return 1;
  }
  me->add("combat_exp", -random(100));
  me->add("potential", -random(50));
  me->set("xiaoyao/quest", 0);
  me->set_temp("over", 0);

  return 1;
}

int about_quest() {
  int task, n, exp1, pot1;
  object me, ob;
  exp1 = 500000;
  pot1 = 1000000;
  me = this_player();
  task = random(16);
  n = 5 + random(5);
  if (((string)me->query("class") != "xiaoyao")) {
    write("檀香子笑了笑说：“不敢烦劳您了，我们的弟子会做这些粗活的\n");
    return 1;
  }


  if (me->query("combat_exp") > exp1 || me->query("potential") > pot1) {
    write("檀香子笑了笑说：“热爱劳动当然是美德，但是你现在好象不适合再干这些低档次的活了，fight npc如何？”\n");
    return 1;
  }



  if ((int)me->query("xiaoyao/quest") == 0) {


    if (task == 1) {
      command("say 把稻子收了");
      me->set("xiaoyao/quest", 1);
      return 1;
    }
    if (task == 2) {
      command("say 把小院的叶子扫了");
      me->set("xiaoyao/quest", 2);
      return 1;
    }
    if (task == 3) {
      command("say  给牛奶挤了送到厨房");
      me->set("xiaoyao/quest", 3);
      return 1;
    }
    if (task == 4) {
      command("say 把花圃里的杂草给除了");
      me->set("xiaoyao/quest", 4);
      return 1;
    }
    if (task == 5) {
      command("say 到东面林子里找蘑菇");
      me->set("xiaoyao/quest", 5);
      return 1;
    }
    if (task == 6) {
      command("say 把土豆下到地里");
      me->set("xiaoyao/quest", 6);
      return 1;
    }
    if (task == 7) {
      command("say 给棋痴子送些吃的去");
      me->set("xiaoyao/quest", 7);
      return 1;
    }
    if (task == 8) {
      command("say 到厨房去帮着把饭给作了吧");
      me->set("xiaoyao/quest", 8);
      return 1;
    }
    if (task == 9) {
      command("say 把三师哥的房间打扫一下");
      me->set("xiaoyao/quest", 9);
      return 1;
    }
    if (task == 10) {
      command("say 作坊里缺人手，你去给打个下手吧");
      me->set("xiaoyao/quest", 10);
      return 1;
    }
    if (task == 11) {
      command("say 到场子上帮着把稻谷扬了吧");
      me->set("xiaoyao/quest", 11);
      return 1;
    }
    if (task == 12) {
      command("say 到木材场帮着把木头给锯了吧");
      me->set("xiaoyao/quest", 12);
      return 1;
    }

    if (task == 13) {
      command("say 到山下去打点猪草回来，把猪喂了");
      me->set("xiaoyao/quest", 13);
      return 1;
    }
    if (task == 14) {
      command("say 你去把猪圈清理了");
      me->set("xiaoyao/quest", 14);
      return 1;
    }
    if (task == 15) {
      command("say 木材场里却料了你去砍一棵衫木送去.");
      me->set("xiaoyao/quest", 15);
      return 1;
    }
  } else {
    command("say 你还站在这里干什么？还不快去做任务？");
    return 1;
  }
}

string do_over() {

  int n, exp, pot, x;
  object me;
  int k;
  int level;
  level = this_player()->query_skill("music", 1);
  if (level < this_player()->query_skill("qidao", 1))
    level = this_player()->query_skill("qidao", 1);
  if (level < this_player()->query_skill("honey", 1))
    level = this_player()->query_skill("honey", 1);
  k = (int)(level / 10);
  k = k + 1;
  me = this_player();
  exp = random(k * 10);
  pot = random(k * 5);
  exp = exp + 20;
  pot = pot + 5;
  if (!this_player()->query("xiaoyao/quest"))
    return "你还没有申请任务呢！\n";
  if (this_player()->query_temp("over")) {

    me->add("combat_exp", (int)exp);
    me->add("potential", (int)pot);
    me->set_temp("over", 0);
    me->set("xiaoyao/quest", 0);
    tell_object(this_player(), HIW "你被奖励了：\n" +
      chinese_number(exp) + "点实战经验\n" +
      chinese_number(pot) + "点潜能\n" NOR);

    return "檀香子满意的点了点头：好不错不错\n";

  } else return RED "做事要有始有终呀。不干了?\n" NOR;
}



int accept_object(object who, object ob) {
  int n, exp, pot;
  object me;
  int k;
  int level;
  level = this_player()->query_skill("music", 1);
  if (level < this_player()->query_skill("qidao", 1))
    level = this_player()->query_skill("qidao", 1);
  if (level < this_player()->query_skill("honey", 1))
    level = this_player()->query_skill("honey", 1);
  k = (int)(level / 10);

  n = this_player()->query("xiaoyao/quest");
  me = this_player();
  exp = random(k * 10);
  pot = random(k * 2);
  exp = exp + 100;
  pot = pot + 10;

  if (ob->query("name") != "蘑菇") return 0;
  if (n != 5) return 0;

  command("smile");
  command("nod");
  who->add("combat_exp", exp);
  who->add("potential", pot);
  who->set_temp("over", 0);
  who->set("xiaoyao/quest", 0);
  tell_object(this_player(), HIW "你被奖励了：\n" +
    chinese_number(exp) + "点实战经验\n" +
    chinese_number(pot) + "点潜能\n" NOR);

  return 1;

}
