inherit ROOM;

void create()
{
        set("short", "山麓");
        set("long", @LONG
这是青城山的山麓。只见四周树海苍茫，泉水淙淙，空谷清幽。正
所谓“溪回山合，水石森丽。一转一声，殊兼所望。”抬头仰看，上清
宫已然隐现在一片苍松翠柏之间。
LONG
        );
        set("exits", ([ 
		"eastdown" : __DIR__"shanroad4",
	       "southwest" : __DIR__"shanroad5",
	       "northwest" : __DIR__"xiaolu11",
]));
	set("objects",([
		__DIR__"npc/fu" : 1,
		__DIR__"npc/qcdizi1" : 4,
       	]));
        set("outdoors", "qingcheng");
        setup();
}
int valid_leave(object me,string dir)
{
	object ob;
       if(dir!="eastdown" && present("fu qinggui",environment(me)) && 
		me->query("class")!="qingcheng" )
	      return notify_fail("傅青圭伸手一拦，说道：“非本派弟子请回！”\n");
        return ::valid_leave(me,dir);
}


