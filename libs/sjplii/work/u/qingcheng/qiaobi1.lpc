inherit ROOM;

void create()
{
       
        set("short", "峭壁");
        set("long", @LONG
这里人迹罕至,到处是参天的古树。从树页的缝隙中隐隐约约能
看见好象是红墙的影子,你以为自己看花了眼。 绿色的藤蔓从树上
一直垂到悬崖下面。
LONG
        );
        set("exits", ([ /* sizeof() == 2 */
         "west" : __DIR__"gate",
        ]));
        set("no_clean_up", 0);
        setup();
}

void init()
{
//        add_action("do_enter","enter");
        add_action("do_climb","climb");
}

int do_climb(string arg)
{
        if (arg!="down") return 0;
        write("你伸手抓住一根藤蔓，费力的向峭壁下面爬去。\n");
        this_player()->move(__DIR__"qiaobi");
        message_vision("$N从悬崖上面爬了下来。\n",this_player());
        return 1;
}

