inherit ROOM;

void create()
{
  set("short","厨房");
  set("long",@LONG
这里是山庄招待客人的地方，都是一些山珍野味，千万别客气。
下一次不知什么时间才能吃上。(kaifan)。
LONG
);
  set("exits",([
    "south":__DIR__"po1",
]));
  set("objects",([
    "/u/lark/obj/pot":1,
]));
  setup();
}

void init()
{
 add_action("do_kaifan","kaifan");
}

int do_kaifan(string arg)
{ 
  object ob;

  if(arg)
    return notify_fail("饿了？就吃吧。(kaifan)\n");
  message_vision("$N大叫一声：“饿死我了！给我来十斤牛肉!”\n",this_player());
  write("不一会一个青城弟子提着一块五香野牛肉放到你的面前.好香\n");
  ob= new(__DIR__"obj/meat");
  ob->move(this_object());
  return 1;
}
