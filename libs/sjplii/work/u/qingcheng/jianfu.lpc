inherit ROOM;

void create() {
  set("short", "建福宫");
  set("long", @LONG
建福宫是青城弟子论经习武的地方。据说张道陵建道教之后，山上
香火不断，张天师就在此地布施缘法，降福于世人。后来青城弟子传得
张天师剑术，又把此宫称为“剑夫宫”。
LONG
  );
  set("exits", ([
    "westdown": __DIR__ "xiaolu28",
    "southeast": __DIR__ "xiaolu12",
  ]));
  set("objects", ([
    __DIR__ "npc/sima": 1,
    "/obj/weapon/longsword": 2,
    "/obj/weapon/bamboo_sword": 4,
  ]));
  setup();
}
