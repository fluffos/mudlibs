#include <ansi.h>
int do_detect(object me);

inherit NPC;
void create()
{

        set_name("青城弟子", ({ "qingcheng dizi", "dizi" }) );
        set("long", "这是一位青城弟子，专门担任保护之责。\n");
        set("attitude", "friendly");
        set("max_atman", 100);
        set("atman", 100);
        set("max_mana", 100);
        set("mana", 100);

        set("str", 40);
        set("cor", 30);
        set("cps", 25);

        set("combat_exp", 90000);
        set_skill("sword", 30);
        set_skill("parry", 30);
        set_skill("dodge", 30);
        set_skill("unarmed", 30);
        set_skill("force", 30);

        set_skill("rain_sword",30);
        set_skill("rain_strike", 30);
        set_skill("siri_force", 30);
        set_skill("five-steps", 30);
        map_skill("dodge", "five-steps");
        map_skill("unarmed", "rain_strike");
        map_skill("force", "siri_force");
        map_skill("parry", "rain_sword");
        map_skill("sword", "rain_sword");
        set("chat_msg", ({
                (: do_detect :),
        }) );
        setup();
        carry_object("/obj/longsword")->wield();
        carry_object(__DIR__"obj/daopao")->wear();
}
int do_detect(object me)
{
        string str;
        object owner, player;
        me = this_object();
        owner = me->query("possessed");
        if ( !present(owner, environment(me)))
        {
        me->dismiss_team();
        destruct(me);
        return 1;
        }
return 1;
}
void init()
{       
        object ob;

        ::init();
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
        }
      
}

void greeting(object ob)
{
        if( !ob || environment(ob) != environment() ) return;
        switch( random(3) ) {
                case 0:
                        say( "青城弟子一抱拳，笑咪咪地说道：这位" + RANK_D->query_respect(ob)
                                + "，既然有缘来到山庄，就请进吧。\n");
                        break;
                case 1:
                        say( "青城弟子看了你一眼，说道：这位" + RANK_D->query_respect(ob)
                                + "，到里面如何？。\n");
                        break;
                case 2:
                        say( "青城弟子惊奇道：这位" + RANK_D->query_respect(ob)
                                + ",如何得知此处的？\n");
                        break;
        }
}


