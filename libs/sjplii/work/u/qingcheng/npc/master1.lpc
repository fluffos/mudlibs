#include <ansi.h>
inherit NPC;
inherit F_MASTER;
int about_baohu();
int about_quest();
void create() {
  set_name("铁肩道人", ({ "master tiejian", "tiejian", "master" }));
  set("title", "青城派掌门");
  set("gender", "男性");
  set("age", 66);
  //	set("nickname", HIG "" NOR);
  set("long",
    "铁肩道人是青城派第四代掌门，在五大门派中威望颇高。\n");
  set("attitude", "peaceful");
  set("str", 30);
  set("int", 30);
  set("cor", 30);
  set("spi", 30);
  set("max_kee", 2000);
  set("max_gin", 2000);
  set("max_sen", 2000);
  set("kee", 2000);
  set("gin", 2000);
  set("sen", 2000);

  set("force", 2000);
  set("max_force", 2000);
  set("force_factor", 20);

  set("combat_exp", 7000000);
  set("score", 50000);

  set_temp("apply/attack", 30);
  set_temp("apply/defense", 30);
  set_temp("apply/move", 30);

  set_skill("dodge", 190);
  set_skill("move", 190);
  set_skill("literate", 200);
  set_skill("parry", 190);
  set_skill("unarmed", 190);
  set_skill("force", 190);
  set_skill("sword", 200);
  set_skill("dormancy", 200);

  set_skill("rain_sword", 200);
  set_skill("rain_strike", 190);
  set_skill("siri_force", 190);
  set_skill("five-steps", 180);

  map_skill("dodge", "five-steps");
  map_skill("unarmed", "rain_strike");
  map_skill("force", "siri_force");
  map_skill("parry", "rain_sword");
  map_skill("sword", "rain_sword");
  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: perform_action, "sword.pangtuo" :),
  }));
  set("inquiry", ([
    "随行": (: about_baohu :),
    "七星剑阵": (: about_quest :),
    "进阵": (: about_quest :),
    "闯阵": (: about_quest :),
  ]));

  create_family("青城派", 4, "掌门");
  set("class", "qingcheng");

  setup();
  carry_object("/obj/longsword")->wield();
  carry_object(__DIR__ "obj/daopao")->wear();
}
void init() {
  add_action("do_gogo", "go");
}

int do_gogo(string arg) {
  object me;
  me = this_player();
  if (arg == "down") {
    command("say 这是本派七星剑阵，请勿乱闯！\n");
    write("这个方向的路被铁肩道人挡住了 。\n");
    return 1;
  } else
    return 0;
}
int about_quest() {
  object me = this_player();
  /*
	if( this_object()->query_temp("qingcheng/counter") )
	{
	command("say 有人正在闯阵，请明天再来。\n");
	return 1;
	}
*/
  if (me->query("id_type") == 2) {
    command("say 嘿嘿，正邪势不两立，你要来破阵，且看你有没有这个本事！\n");
    me->move("/u/qingcheng/tianshi2");
    message_vision(HIR "\n铁肩道人领$N进入了七星剑阵，随后冷笑着走开了。\n" NOR, me);
    this_object()->set_temp("qingcheng/counter", 1);
    return 1;
  }
  if (me->query("class") != "qingcheng") {
    command("say 这是本派七星剑阵，非武当弟子请勿入内！\n");
    return 1;
  }
  if ((int)me->query("combat_exp") < 300000) {
    command("say 你的武功太差了，进入本派七星剑阵会有性命危险！\n");
    return 1;
  }
  if ((int)me->query("combat_exp") > 600000) {
    command("say 你武艺超群，闯本派七星剑阵已经没有意义了！\n");
    return 1;
  } else {
    command("say 难得你有这般胆识，那就进去闯一闯吧！\n");
    me->set_temp("qingcheng/jianzhen", 1);
    me->move("/u/qingcheng/tianshi2");
    this_object()->set_temp("qingcheng/counter", 1);
    message_vision(CYN "\n铁肩道人领$N进入了七星剑阵，随后微笑着走开了。\n" NOR, me);
    return 1;
  }
  return 1;
}

void attempt_apprentice(object ob) {
  if (ob->query("class") != "qingcheng") {
    command("say 这位" + RANK_D->query_respect(ob) + "还是去拜贫道的弟子吧。\n");
    return;
  }

  if (ob->query_skill("rain_sword", 1) < 150) {
    command("say 本门乃三大剑派之一，主修剑法，你剑术修为尚浅，还是再多下点功夫吧！\n");
    return;
  }
  command("smile");
  command("say 好吧，" + RANK_D->query_respect(ob) + "以后要更加勤习武功，把青城发扬光大！\n");
  command("recruit " + ob->query("id"));
}

void recruit_apprentice(object ob) {
  if (::recruit_apprentice(ob))
    ob->set("class", "qingcheng");
  ob->set("id_type", 1);
}

int about_baohu() {
  object me, soldier;
  object *t;
  me = this_player();
  if (me->query("class") != "qingcheng") {
    command("say 对不起，你不是青城弟子！\n");
    return 1;
  }

  if (pointerp(t = me->query_team())) {
    command("say 已经有师兄弟保护你了，好自为之！\n");
    return 1;
  }
  command("say 好吧，我让你的师兄弟与你同行。\n");
  message_vision(CYN "\n从门外走进来一名青城弟子，躬身说道：师父请吩咐！\n" NOR, me);
  message_vision(HIM "\n铁肩道人说道：青城弟子保护$N一起下山吧！\n" NOR, me);
  message_vision(CYN "\n青城弟子躬身说道：谨遵师命！\n" NOR, me);
  soldier = new(__DIR__ "qcdizi.lpc");
  soldier->move(environment(me));
  me->add_team_member(soldier);
  soldier->add_team_member(me);
  soldier->set_leader(me);
  soldier->set("possessed", me);
  return 1;
}
