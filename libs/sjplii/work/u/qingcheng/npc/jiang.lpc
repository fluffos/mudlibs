inherit NPC;
inherit F_MASTER;
string summon_more(object who);

void create() {
  set_name("姜青霓", ({ "jiang qingni", "jiang" }));
  set("gender", "女性");
  set("age", 20);
  set("per", 25);
  set("long",
    "姜青霓是司马孟的嫡传弟子，据说是青师太从小带大的，把她爱如孙女。\n");
  set("inquiry", ([
    "here": "这里是闻名天下的青城山。",
    "青师太": "师太在上青宫。",
    "司马孟": "师父为人很好的，不知道为什么最近总是心事重重。",
  ]));
  set("attitude", "peaceful");
  set("class", "qingcheng");
  set("max_kee", 1000);
  set("max_gin", 1000);
  set("max_sen", 1000);
  set("kee", 1000);
  set("gin", 1000);
  set("sen", 1000);

  set("force", 1000);
  set("max_force", 1000);
  set("force_factor", 10);

  set("combat_exp", 500000);
  set("score", 5000);

  set_skill("dodge", 60);
  set_skill("move", 60);
  set_skill("literate", 60);
  set_skill("parry", 60);
  set_skill("unarmed", 60);
  set_skill("force", 60);
  set_skill("sword", 60);

  set_skill("rain_sword", 60);
  set_skill("rain_strike", 60);
  set_skill("siri_force", 60);
  set_skill("five-steps", 60);

  map_skill("dodge", "five-steps");
  map_skill("unarmed", "rain_strike");
  map_skill("force", "siri_force");
  map_skill("parry", "rain_sword");
  map_skill("sword", "rain_sword");
  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: summon_more(this_object()) :),
  }));

  create_family("青城派", 7, "弟子");

  setup();

  carry_object("obj/longsword")->wield();
  carry_object(__DIR__ "obj/hua_skirt")->wear();
}
void attempt_apprentice(object ob) {
  if (ob->query("id_type") == 2) {
    command("say 本派乃名门正派，不收邪道人物。\n");
    return;
  }
  command("smile");
  command("say 好吧，" + RANK_D->query_respect(ob) + "以后要更加勤习武功，把青城发扬光大！\n");
  command("recruit " + ob->query("id"));
}

void recruit_apprentice(object ob) {
  if (::recruit_apprentice(ob))
    ob->set("class", "qingcheng");
  ob->set("id_type", 1);
}
string summon_more(object who) {
  int i;
  object *enemy;
  object another;
  seteuid(getuid());
  another = new(__DIR__ "qcdizi2");
  if ((int)who->query_temp("summon_more") > 2) return "　";
  another->move(environment(who));
  message_vision(another->name() + "走了过来。\n"
    , this_object());
  who->add_temp("summon_more", 1);
  enemy = who->query_enemy();
  i = sizeof(enemy);
  while (i--) {
    if (enemy[i] && living(enemy[i])) {
      another->kill_ob(enemy[i]);
      enemy[i]->kill_ob(another);
      another->set_leader(enemy[i]);
    }
  }
  return "1";
}
int accept_fight(object me) {
  command("say 我可不想跟你闹，被师父知道又要骂了。");
  return 0;
}
