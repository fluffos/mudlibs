inherit ROOM;

void create() {
  set("short", "天师洞");
  set("long", @LONG
天师洞为青城山的重心，洞中挂有被世人传颂为“天师道人”的张
道陵画像。青城山素以清幽著称，有“峨眉天下秀，三峡天下险，剑门
天下雄，青城天下幽”之誉。天师洞也被称为“天下第五洞天”。
LONG
  );
  set("exits", ([
    "east": __DIR__ "xiaolu22",
    "south": __DIR__ "xiaolu24",
    "north": __DIR__ "xiaolu23",
    "westup": __DIR__ "shanroad4",
    "down": __DIR__ "tianshi2",
  ]));
  set("objects", ([
    __DIR__ "npc/master1": 1,
  ]));
  setup();
}
