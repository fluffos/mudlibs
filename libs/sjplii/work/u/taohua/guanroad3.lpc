
inherit ROOM;

void create()
{
        set("short", "青石官道");
        set("long", @LONG
这是一条宽敞坚实的青石大道，向东延伸。东海海滩已经遥遥在望了。
LONG
        );
        set("exits", ([ /* sizeof() == 2 */
	"east" : __DIR__"haitan1",  //goto taohua
	"west" : __DIR__"guanroad2",
]));
        set("outdoors", "taohua");
        set("objects", 
        ([
              "/npc/nknpc" : 1,
        ]));

        setup();
//        replace_program(ROOM);
}
void init()
{
        add_action("do_go","go");

}

int do_go()
{
if(random(2)){
this_player()->move(this_object());
return 1;
}
}
