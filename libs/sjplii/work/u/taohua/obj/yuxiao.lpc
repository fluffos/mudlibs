// yuxiao.c

#include <ansi.h>
#include <weapon.h>

inherit SWORD;

void create()
{
    set_name("东海玉萧", ({"yuxiao"}));
    set_weight(500);

	if (clonep())
		set_default_object(__FILE__);
	else {
        set("unit", "支");
        set("long", "一支白玉做成的长萧，看上去晶莹温润。武林中人经常以萧代剑。\n");
		set("value", 10000);
		set("material", "bamboo");
        set("wield_msg", "$N大袖一挥，手中已多了一支晶莹温润的玉萧。\n");
        set("unwield_msg", "$N手中玉萧一转，眨眼间玉萧已然不见影踪。\n");
	}
    init_sword(30);
	setup();
}	
void init()
{
add_action("do_play","play");
}
int do_play(string arg)
{
        object *ob,me,target,weapon;
        int i, skill, heal;
        me = this_player();
        skill = me->query_skill("watersong", 1);
	weapon=me->query_temp("weapon");
	me->set_temp("played_xiao",1);
	if(!arg) return notify_fail("你要吹奏什么？\n");
	if( me->query("class")!="taohua")
       return notify_fail("你拿起玉萧吹了一会，但没有奏出什么象样的曲子。\n");
	if( me->query_delay())
       return notify_fail("你现在心绪紊乱，不能吹奏。\n");
	if( me->query("force")<70)
       return notify_fail("你现在内力不足。\n");
	if( weapon && weapon->query("name")!="东海玉萧" )
	       return notify_fail("你必须先装备东海玉萧。\n");
	else if( !weapon )
	       return notify_fail("你必须先装备东海玉萧。\n");
switch(arg)
        {
                case "碧海潮生曲":
                case "bihaichaosheng":
                        if (skill < 100)
                        return notify_fail("你的“似水流音”所学不足！\n") ;
                        message_vision(HIC "$N手持东海玉萧，吹起一首澎湃激昂的《碧海潮生曲》！\n" NOR, me,this_object());
                        me->add("force", -20);
			if( me->query("bellicosity")< 100000 )
			me->add("bellicosity",random(10));
        ob = all_inventory(environment(me));
        for(i=0; i<sizeof(ob); i++) {
                if( !living(ob[i]) || ob[i]==me || !ob[i]->query("jgguard") || !ob[i]->is_character())continue;
                heal = skill*2;
                if( heal > 0 ) {
			if( ob[i]->query("bellicosity")< 10000 )
			ob[i]->add("bellicosity",random(10));
                        ob[i]->receive_heal("kee", heal);
                        ob[i]->receive_heal("sen", heal);
			   ob[i]->receive_curing("sen", heal );
			   ob[i]->receive_curing("kee", heal );
                        tell_object(me, ob[i]->name()+"在曲声的激励下，斗志渐渐高昂起来。\n");
                        }               
			}
                       break;
                default :
                        return notify_fail("你要弹什么？\n");
        }
	if( !me->query_delay() )
	me->set_delay(3);
        return 1;
}

