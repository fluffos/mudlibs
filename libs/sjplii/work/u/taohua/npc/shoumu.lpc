 //add by zhm
// Killer-e.c ,No greeting, 桃花岛功夫
inherit NPC;

void create()
{
        set_name("守墓家奴", ({"shoumu"}));
        set("long",
        "这是一个身材高大的江湖人，两臂粗壮，膀阔腰圆，看起来似乎不怀好意。\n"
        );

        set("gender", "男性");
        set("attitude", "aggressive");
        set("class", "alchemist");

        set("age", 20+random(30));
        set("shen_type", 0);

        set("str", 25+random(10));
        set("dex", 25+random(10));
        set("int", 25+random(10));
        set("con", 25+random(10));

        set("kee", 1500);
        set("max_kee", 1500);
        set("sen", 1000);
        set("max_sen", 1000);
        set("force", 1000);
        set("max_force", 1000);
        set("force_factor", 50+random(100));

        set("combat_exp", 10000+random(100000));
        set("score", 1);

//      set("startroom","/d/city/dongmen");

        set_skill("force", 20+random(80));
        set_skill("dodge", 20+random(60));
        set_skill("unarmed", 20+random(100));
        set_skill("parry", 20+random(80));
        set_skill("sword", 20+random(100));
        set_skill("luoying_sword", 10+random(110));

        map_skill("parry", "luoying_sword");
        map_skill("sword", "luoying_sword");

        set("chat_chance", 20);
        set("chat_msg", ({
                "守墓家奴说道: 这次看那些玩家们往哪儿跑。\n",
                "守墓家奴说道: 杀! 杀! 杀!!!。\n",
                (: random_move :)
        }) );

        setup();

        carry_object("/obj/cloth")->wield();
}

void init()
{
::init();
remove_call_out("greeting");
call_out("greeting", 1, this_player());
}

void greeting(object ob)
{
        object me, room1;
        me = this_object();
        room1 = environment(me);

//      if(ob->query_temp("hastrystab")==6) return;
        if (room1->query("no_fight"))
                room1->set("no_fight", 0);

        if (interactive(ob))
//      && !environment(ob)->query("no_fight"))
        {
                command("say 你这家伙不要跑，让大爷我宰了你！！！\n");
                me->set_leader(ob);
                remove_call_out("kill_ob");
                call_out("kill_ob", 1, ob); 
        }       

}
