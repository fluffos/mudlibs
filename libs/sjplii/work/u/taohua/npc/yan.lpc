#include <ansi.h>
inherit NPC;
inherit F_MASTER;
void create() {
  set_name(" 颜如君", ({ "yan rujun", "yan", "rujun", }));
  set("long",
    "颜如君是清尘庵主从小收养的弟子。由清尘庵主亲手教得了一手人人称绝的
烹调手法，因此桃花岛的膳食就由她负责。\n");
  set("gender", "女性");
  set("title", "桃花岛第三代弟子");
  set("age", 19);
  set("attitude", "peaceful");
  set("str", 17);
  set("int", 27);
  set("con", 23);
  set("dex", 25);
  set("chat_chance", 40);
  set("chat_msg", ({
    "颜如君微笑著说道：我们桃花岛景色优美，欢迎来作客！\n",
    "颜如君高兴的说：有幸见到您真高兴！\n",
    "颜如君微笑著说道：您饿不饿？我桃花岛的烹调功夫可算天下第一呀。\n",
    "颜如君微笑着说： 这位壮士，你好！欢迎来到桃花岛！\n",
  }));
  set("kee", 500);
  set("max_kee", 500);
  set("sen", 500);
  set("max_sen", 500);
  set("force", 1000);
  set("max_force", 1000);
  set("force_factor", 50);

  set("combat_exp", 300000);
  set("score", 0);
  set_skill("unarmed", 80);
  set_skill("parry", 60);
  set_skill("dodge", 80);
  set_skill("sword", 80);
  set_skill("force", 80);
  set_skill("literate", 100);
  set_skill("liheforce", 80);
  set_skill("beauty-force", 80);
  set_skill("luoying_sword", 80);
  set_skill("luohua_steps", 80);
  set_skill("tenderzhi", 80);

  map_skill("unarmed", "tenderzhi");
  map_skill("force", "beauty-force");
  map_skill("sword", "luoying_sword");
  map_skill("parry", "luoying_sword");
  map_skill("dodge", "luohua_steps");
  //        set("book_count", 1);

  create_family("桃花岛", 2, "弟子");
  setup();
  carry_object("/u/taohua/obj/baichou")->wear();
  carry_object("/obj/longsword")->wield();
}
