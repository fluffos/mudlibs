#include <ansi.h>
inherit NPC;

void create() {
  set_name("管七白", ({ "guan qibai", "guan", "qibai" }));
  set("title", HIW "披发大仙" NOR);
  set("gender", "男性");
  set("age", 44);
  set("long", "一个披头散发的中年男子，身材魁梧，却是断了双足。\n");
  set("combat_exp", 2000000);
  set("str", 47);
  set("con", 28);
  set("int", 30);
  set("attitude", "heroism");

  set_skill("force", 250);
  set_skill("unarmed", 200);
  set_skill("parry", 200);
  set_skill("fork", 200);

  setup();
  carry_object("/obj/cloth")->wear();
  carry_object("/obj/weapon/tieqi")->wield();
}
int accept_fight(object me) {
  command("say 嘿嘿，你看我身已残疾，想趁人之危？\n");
  return 0;
}
int accept_object(object who, object ob) {
  object me;
  int score, pot;
  if (ob->name() == "七弦琴") {
    if ((int)ob->query("objattrib") != 1) return 0;
    me = this_player();
    score = (int)me->query("combat_exp");
    pot = (int)me->query("potential");
    me->set("combat_exp", (int)score + random(200));
    me->set("potential", (int)pot + random(200));
    command("say 是若琴让你给我的吗？她终于肯跟我一起共奏一曲“海上明月歌”啦！");
    say(CYN "\n只见管七白手一撑地，庞大的身躯竟然腾空而起，随着一串苍然的笑声，人影飞出洞外远去了。。。\n" NOR);
    this_object()->move("/u/baiwt/npc_hut.lpc");
    return 1;
  } else {
    return 0;
  }
  return 1;
}
