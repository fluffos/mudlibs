//zixia-miji.c
inherit ITEM;
#include <ansi.h>

void setup()
{}

void init()
{
        add_action("do_du", "du");
        add_action("do_du", "study");
}

void create()
{
        set_name("笑傲江湖曲谱", ({  "xojh book","book","qupu" }));
        set_weight(500);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "本");
                set("long", "这是当年刘正风和曲洋送给令狐冲的录有笑傲江湖的曲谱\n");
                set("value", 0);
                set("material", "paper");
                set("no_drop", "这样东西不能离开你。\n");
                set("no_get", "这样东西不能离开那儿。\n");

        }
}

int do_du(string arg)
{
        object me = this_player();
        object where = environment(me);
        object ob;
        mapping skill;
        int musiclvl; 
//      int force_lost;

        if (!(arg=="xojh book" || arg == "book" || arg == "qupu"))
        return 0;
   
        if (me->is_busy()) {
                write("你现在正忙着呢。\n");
                return 1;
        }
        if( me->is_fighting() ) {
                write("你无法在战斗中专心下来研读新知！\n");
                return 1;
        }
        if( me->query_temp("dazuo") ){
                write("你无法在练功打坐中专心下来研读新知！\n");
                return 1;
        }
        if( me->query_temp("sleeping") ){
                write("你正在睡眠中，不能学习技能。\n");
        }
        if (!id(arg)) { 
                write("你要读什么？\n");
                return 1;
        }
        if((int)me->query_skill("literate", 1) < 100 ){
                write("你读书写字所学不足，看不懂曲谱上的字。\n");
                return 1;
        }
        if((int)me->query_skill("music", 1) < 100 ){
                write("你的琴音韵律所学不足，学习笑傲江湖对你无益有害。\n");
                return 1;
        }
        if (((!objectp(ob = present("yan yu", me)) ) )
        && ((!objectp(ob = present("yan yu", me)) ) ) ){
                write("你必须同时有燕语和玉萧，才能学习笑傲江湖。\n");
                return 1;
        }
        message_vision("$N弹了几下燕语，吹了吹玉萧，又看了看笑傲江湖曲谱。\n",me);
        if( (int)me->query("sen") < 15 ) {
                write("你现在过于疲倦，无法专心下来研读新知。\n");
                return 1;
        }
       
        musiclvl = me->query_skill("music", 1);
        if( (int)me->query("combat_exp") < (int)musiclvl*musiclvl*musiclvl/10 ) {
                write("你的实战经验不足，再怎么读也没用。\n");
                return 1;
        }
        
        me->receive_damage("sen", 15);
        if((int)me->query_skill("music", 1) > 180 ){
                write("你研读《笑傲江湖曲谱》，遥想叱姹风云的情景，感慨万千。\n");
                return 1;
        }
        if(musiclvl < 150 && musiclvl <= 300)
        me->improve_skill("music", (int)me->query_skill("literate", 1)/4);
        else if( musiclvl <= 300)
        me->improve_skill("music", (int)me->query_skill("literate", 1)/3);
        write("你研读《笑傲江湖曲谱》，颇有心得。\n");
        return 1;
}


