// guazi.c

inherit ITEM;
#include <ansi.h>;

void create()
{
	set_name(HIG"无名花"NOR, ({ "hua","flower" }) );
	set_weight(80);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "一朵不知名的小花。\n");
		set("unit", "朵");
		set("value", 0);
		set("remaining", 1);
		set("food_supply", 1);
	}
	setup();
}
void init()
{
	add_action("do_eat", "eat");
}


int do_eat(string arg)
{
	object me,ob;
	me = this_player();
	ob = this_object();

	if( !ob->id(arg) ) return 0;
	if( me->is_busy() )
		return notify_fail("你上一个动作还没有完成。\n");
	if(   (int)me->query("food") >= (int)me->max_food_capacity() )
		return notify_fail("你已经吃太饱了，再也吃不下了。\n");
	message_vision("$N胆战心惊地吃下了朵$n！\n",me,ob);
	me->clear_condition();
	tell_object(me, HIG "你只觉一股清香沁入心肺,顿时神意清爽！\n" NOR );
	if( me->is_fighting() ) me->start_busy(2);
	destruct(ob);
	return 1;
}
