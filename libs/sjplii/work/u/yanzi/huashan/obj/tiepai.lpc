// tiepai.c

inherit ITEM;

void create()
{
        set_name("铁牌", ({ "tiepai","pai" }));
        set_weight(600);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "块");
                set("long", "这是一块锈迹斑斑的铁牌，上面刻了不少字。\n");
                set("value", 10);
                set("material", "icon");
        }
}

