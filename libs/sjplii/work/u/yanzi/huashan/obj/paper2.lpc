//paper2.c
inherit ITEM;

void setup()
{}

void init()
{
        add_action("do_du", "du");
        add_action("do_du", "study");
}

void create()
{
	set_name("无名纸片", ({  "paper","zhipian" }));
	set_weight(500);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "张");
		set("long", "一张写满了字的纸片。\n");
		set("value", 0);
		set("material", "paper");
	}
}


int do_du(string arg)
{
        object me = this_player();
        object ob;
        mapping skill;
	 int lvl; 

	if (!(arg=="paper" || arg == "zhipian" ))
	return 0;
   
        if (me->is_busy()) {
                write("你现在正忙着呢。\n");
                return 1;
        }

        if( me->is_fighting() ) {
                write("你无法在战斗中专心下来研读新知！\n");
                return 1;
        }
	if( me->query_temp("dazuo") ){
		write("你无法在练功打坐中专心下来研读新知！\n");
		return 1;
	}
	if( me->query_temp("sleeping") ){
		write("你正在睡眠中，不能学习技能。\n");
	}
        if (!id(arg)) {	
                write("你要读什么？\n");
                return 1;
        }
        if( !me->query_skill("literate", 1) ){
                write("你是个文盲，先学点文化(literate)吧。\n");
                return 1;
        }
	message_vision("$N拿出无名纸片，开始细细钻研起来。\n",me);
        if( (int)me->query("sen") < 20 ) {
                write("你现在过于疲倦，无法专心下来研读新知。\n");
                return 1;
        }
       
	lvl = me->query_skill("zixia-shengong", 1);
        if( (int)me->query("combat_exp") < (int)lvl*lvl*lvl/10 ){
                write("你的实战经验不足，再怎么读也没用。\n");
                return 1;
        }

        if( me->query_skill("zixia-shengong", 1) < 100){
                write("你研读了一会儿，纸上所载似乎乃华山紫霞神功，但你无法将上面所写与自己所学的联系起来。\n");
                return 1;
        }
	if( me->query_skill("zixia-shengong", 1) > 110){
                write("你研读了一会儿，但是发现上面所说的对你而言都太浅了，没有学到任何东西。\n");
                return 1;
        }
	if( me->query_skill("zixia-shengong", 1)*2/3 > me->query_skill("zhengqi-jue", 1) ){
		write("你的正气决不够，无法学习更高级的紫霞神功。\n");
		return 1;
        }

        me->receive_damage("sen", 20);
	
        me->improve_skill("zixia-shengong", (int)me->query_skill("literate", 1)/4+1);
        write("你研读无名纸片，颇有心得。\n");
        return 1;
}

