// pill.c
inherit ITEM;
inherit F_FOOD;

void create()
{
        set_name("丹丸", ({"pill"}) );
        set_weight(250);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "粒");
                set("long", "这是一颗黑不溜湫的丹丸, 好象已有很多年的历史了.\n"
                            "看样子在弄清楚他的来历之前最好不要吃, 否则是好是\n"
                            "坏你都只有认了!\n");
                set("value", 0);
                set("food_remaining", 1);
                set("food_supply", 1);
        }
        setup();
}

void init()
{
        add_action("do_eat", "eat");
}


int do_eat(string arg)
{
        object me;
        int n,effect,limit;
        me = this_player();
        effect = (int)this_object()->query("effect");
        limit = (int)(me->query_skill("force", 1) +
        me->query_skill("force")/5) * 13 - me->query("max_force");
        
        if(!id(arg)) return 0;
	if( this_player()->query_temp("block_msg/all"));
		return notify_fail("什么？\n");
        if( (int)me->query("food") >= (int)me->max_food_capacity() )
                return notify_fail("你已经吃太饱了，再也塞不下任何东西了。\n");
        message_vision("$N闭上眼睛, 胆战心惊地把丹丸吞下肚去.\n", me);
        n = random(10000);
        if(!effect) {
                if( n < 1000 ){  //10%
                     if( limit > 5 ) limit = 5+random(5);
                     if( limit < 0 ) limit = 0;
                     me->add("max_force", limit);
                }
                else if( n < 2000 ) //10%
                     me->add("max_force", -15);
                else if( n < 3200 ){ //12%
                     me->add("combat_exp", 100);
                     me->add("potential", 50);
                }
                else if( n < 4000 ) //8%
                     me->add("combat_exp", -150);
                else if( n < 4001 ){ // 0.01% !!
                     me->add("combat_exp", 3000);
                     me->add("potential", 300);
                }
                else if( n < 7000 ){ //30%
                     me->add("combat_exp", 20);
                     me->add("potential", 10);
                }
                else if( n < 7020 ){ //0.2% 
                     me->add("combat_exp", 1000);
                     me->add("potential", 100);
                }
                else if( n < 7030 ) //0.1% 
                     me->add("combat_exp", -10000);
                else if( n < 7040 ){ //0.1%
                     me->add("combat_exp", 2000);
                     me->add("potential", 200);
                }
                else if( n < 7045 ){ //0.05%
                     me->add("combat_exp", -50000);
                }
                else if( n < 9000 ) //约20%
                     me->add("combat_exp", -200);
                else 
                     me->unconcious();
        }
else {
        switch (effect)
        {
        case 1:
                if( limit > 5 ) limit = 5+random(5);
                if( limit < 0 ) limit = 0;
                me->add("max_force", limit);
                break;
        case 2:
                me->add("max_force", -15);
                break;
        case 3:
                me->add("combat_exp", 100);
                me->add("potential", 50);
                break;
        case 4:
                me->add("combat_exp", -150);
                break;
        case 5:
                me->add("combat_exp", 3000);
                me->add("potential", 300);
                break;
        case 6:
                me->add("combat_exp", 20);
                me->add("potential", 10);
                break;
        case 7:
                me->add("combat_exp", 1000);
                me->add("potential", 200);
                break;
        case 8:
                me->add("combat_exp", -10000);
                break;
        case 9:
                me->add("combat_exp", 1000);
                me->add("potential", 100);
                break;
        case 10:
                me->add("combat_exp", -50000);
                break;
        case 11:
                me->add("combat_exp", -20);
                break;
        case 12:
                me->unconcious();
                break;
        } }
        me->add("food", query("food_supply"));
        if( me->is_fighting() ) me->start_busy(2);
        message_vision("$N将剩下的" + name() + "吃得乾乾净净。\n", me);
        destruct(this_object());  
        return 1;
}

