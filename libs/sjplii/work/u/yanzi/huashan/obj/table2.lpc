//table.c
inherit ITEM;

void create() {
  set_name("石桌", ({ "stone table", "table" }));
  set_weight(50000);
  set_max_encumbrance(30000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("prep", "on");
    set("unit", "个");
    set("long", "一张石桌。\n");
    set("value", 1);
    set("no_get", "你拿不动的\n");
    //	        set("no_shown", 1);
  }
}

int is_container() { return 1; }
