//sanzijing.c

inherit ITEM;

void create()
{
        set_name("三字经", ({ "sanzijing","jing" }));
        set_weight(600);
        set("unit", "本");
        set("long", "这是一本小孩从小就要读的三字经，但总让人觉得有点奇怪。\n");
        set("value", 100);
        set("skill", ([
                "name":        "literate",          // name of the skill
                "exp_required": 0,               // minimum combat experience required                                                                           
                                                 // to learn this skill.
                "sen_cost": 20,                  // gin cost every time study this
                "difficulty": 30,                // the base int to learn this skill
                                  // modify is gin_cost's (difficulty - int)*5%
                "max_skill": 10   // the maximum level you can learn from this object.
        ]) );
	set("book_count",1);
	setup();
}
void init()
{
        add_action("do_tear", "tear");
}
int do_tear(string arg)
{
	object me,book;
	int i,kar;
	me = this_player();
	i = random(10);
	kar = (int)me->query("kar",1);
	if (!(arg=="sanzijing" || arg == "jing" ))
	return 0;
	if (!(arg)) {	
                write("你要撕什么？\n");
                return 1;
        }
	if(query("book_count") < 1)
		return notify_fail("你把封面撕开，但里面什么都没有。\n");
	tell_object(me,@TEXT
你撕开封面，仔细查看了一下，突然发现封页中夹着几张纸片，
其中一张纸片之上写着：
		        华山正气决！
	练武之人当要有浩然正气，正气存于胸中，武功才能大成！
	邪魔妖孽正因心中寥无正气，所以终究邪不胜正！
原来如此，三字经是假，正气决才是真，哈哈！
TEXT
	);
	add("book_count", -1);
	tell_object(me,"你突然听到似乎有人正向这里走来。\n");
	message_vision("$N手忙脚乱地从书中取出几张纸片，放入怀中。\n",me);
	if (i < 3 + random(kar/20)) {
		book = new(__DIR__"zhqj-book3");
		book->move(me);
		return 1;
		}
	else {
		book = new(__DIR__"zhqj-book2");
		book->move(me);
		return 1;
		}
	return 1;
}

