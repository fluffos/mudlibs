// yuqizi.c

#include <weapon.h>

inherit THROWING;

void create() {
  set_name("玉石棋子", ({ "yushi qizi", "qizi" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一粒用万载寒玉制成的棋子，闪烁着莹莹青光。\n");
    set("unit", "包");
    set("base_unit", "粒");
    set("base_weight", 1);
    set("base_value", 10);
    set("wield_msg", "$N抓起一把青紫混杂的$n在手中。\n");
    set("unwield_msg", "$N把手中$n放入包中。\n");
  }
  set_amount(300);
  init_throwing(60);
  setup();
}
