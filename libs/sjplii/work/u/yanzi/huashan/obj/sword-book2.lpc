//sword-book2.c

inherit ITEM;

void create()
{
        set_name("令狐剑要", ({ "sword book","book", }));
        set_weight(600);
        set("unit", "本");
        set("long", "这是一代剑侠令狐冲所著的剑谱。\n");
        set("value", 0);
	set("no_drop", 1);
}
void init()
{
        add_action("do_du", "du");
        add_action("do_du", "study");
}
int do_du(string arg)
{
        object me = this_player();
        object ob;
        mapping skill;
	 int lvl; 

	if (!(arg=="sword book" || arg == "book" ))
	return 0;
   
        if (me->is_busy()) {
                write("你现在正忙着呢。\n");
                return 1;
        }

        if( me->is_fighting() ) {
                write("你无法在战斗中专心下来研读新知！\n");
                return 1;
        }
	if( me->query_temp("dazuo") ){
		write("你无法在练功打坐中专心下来研读新知！\n");
		return 1;
	}
	if( me->query_temp("sleeping") ){
		write("你正在睡眠中，不能学习技能。\n");
	}
        if (!id(arg)) {	
                write("你要读什么？\n");
                return 1;
        }
        if( !me->query_skill("literate", 1) ){
                write("你是个文盲，先学点文化(literate)吧。\n");
                return 1;
        }
	message_vision("$N拿出令狐剑要，开始细细钻研起来。\n",me);
        if( (int)me->query("sen") < 25 ) {
                write("你现在过于疲倦，无法专心下来研读新知。\n");
                return 1;
        }
       
	lvl = me->query_skill("sword", 1);
        if( (int)me->query("combat_exp") < (int)lvl*lvl*lvl/10 ){
                write("你的实战经验不足，再怎么读也没用。\n");
                return 1;
        }

        if( me->query_skill("sword", 1) < 150){
                write("你研读了一会儿，但可能因为你基本剑术所学不足，无法将书上所记载的与你所学的联系起来。\n");
                return 1;
        }
	if( me->query_skill("sword", 1) > 200){
                write("你研读了一会儿，但是发现上面所说的对你而言都太浅了，没有学到任何东西。\n");
                return 1;
        }

        me->receive_damage("sen", 25);
	
        me->improve_skill("sword", (int)me->query_skill("literate", 1)/3);
        write("你研读令狐剑要，颇有心得。\n");
        return 1;
}
 
