inherit ROOM;

void create()
{
	set("short", "[1;36m武器库[2;37;0m");
	set("long", @LONG
这儿是华山派的兵器库，四周放了很多兵器架，上面插着各种各
样的剑，华山弟子可以从这里取自己所要的武器。
LONG
	);
	set("exits", ([ /* sizeof() == 1 */
  "south" : __DIR__"xiaoj1",
]));
	set("objects", ([ /* sizeof() == 1 */
  __DIR__"obj/shelf" : 1,
]));
	set("no_clean_up", 0);

	setup();
}
void init()
{
        add_action("do_get", "get");
}

int do_get(string arg)
{
	string	obj, from;
	object	me, shelf, target, taro;

	if(sscanf(arg, "%s from %s", obj, from)==2 ) {
		if(obj == "all") {
			write("拿那么多剑干什么？\n");
			return 1;
		}
	}
	return 0;
}
void reset()
{
        object  *inv;
        object con, item;
        int i;

        ::reset();
        con = present("weapon shelf", this_object());
        inv = all_inventory(con);
        if( sizeof(inv) != 8) {
                for(i=sizeof(inv)-1; i>=0; i--) destruct(inv[i]);
                item = new("/obj/weapon/bamboo_sword");
                item->move(con);
		item = new("/obj/weapon/bamboo_sword");
                item->move(con);
		item = new("/obj/weapon/bamboo_sword");
                item->move(con);
                item = new("/obj/weapon/thin_sword");
                item->move(con);
		item = new("/obj/weapon/thin_sword");
                item->move(con);
		item = new("/obj/weapon/longsword");
                item->move(con);
                item = new(__DIR__"npc/obj/gangjian");
		item->move(con);
	}
}