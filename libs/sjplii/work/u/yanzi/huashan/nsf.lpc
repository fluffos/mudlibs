// Room: /u/yanzi/huashan/nsf.c

inherit ROOM;

void create()
{
	set("short", "[1;36m内书房[2;37;0m");
	set("long", @LONG
这里是华山掌门莫天雄的读书所在，这里摆设几乎没有，只有一
张书桌，一个书架，但书架上的藏书却一本没有，书桌上则放着本只
翻开几页的书。
LONG
	);
	set("exits", ([ /* sizeof() == 2 */
  "north" : __DIR__"zoulang",
]));
	set("item_desc", ([ /* sizeof() == 3 */
	"书桌" : "一张书桌，上面放着本刚翻开的书本(shu)。\n",
	"table" : "一张书桌，上面放着本刚翻开的书本(shu)。\n",
	"shu" : "一本刚翻开的书，你看了看，上面写着<人之初，性本善...>原来是本[三字经]，\n你不禁疑惑起来，堂堂华山掌门怎么读这小孩子读的书！如果你对它有兴趣，\n可以取下(take)它。\n",
	"书架" : "一个大书架，上面还贴着许多纸条(paper)，但却没有一本书！\n",
	"shelf" : "一个大书架，上面还贴着许多纸条(paper)，但却没有一本书！\n",
	"paper" : "这些纸条上依次写着<紫霞密籍>，<华山剑谱>......但对应之处却没一本书。\n",
]));

	set("no_clean_up", 0);
	set("book_count", 1);
	set("paper_count", 1);

	setup();

}
void init()
{
        add_action("do_take", "take");
	add_action("do_search", "search");
}

int do_take()
{
	object ob;
	
	if (query("book_count") < 1)
		return notify_fail("你拿下三字经，翻了翻，就是一本普通的书，还是放回去吧，惹恼了华山掌门就惨啦。\n你又把三字经放了回去。\n");
	add("book_count", -1);
	ob = new(__DIR__"obj/sanzijing");
	ob->move(this_player());
	message_vision("$N从书桌上取下本三字经。\n",this_player());
	return 1;
}
int do_search(string arg)
{
	object ob;
	int i,kar;
	i = random(10);
	kar = (int)this_player()->query("kar");
	if(kar > 40) kar = 40;

	if( !arg ) return 0;
	if (!(arg=="shelf" || arg == "书架" )) return 0;

	if (query("paper_count") < 1)
		return notify_fail("你将书架整个搜了个遍，但什么也没有发现。\n");
	add("paper_count", -1);
	message_vision("$N仔细地将书架翻了个遍，突然发现了张掉落的纸片，连忙放入自己的怀中。\n",this_player());

	if(i < 1+kar/40 ){ //10%-20% zixia-shenong 110->120 book
		ob = new(__DIR__"obj/paper1");
		ob->move(this_player());
		return 1;
		}
	else if (i < 4+kar/20){ //30%-40% zixia-shengong 100->110 book
		ob = new(__DIR__"obj/paper2");
		ob->move(this_player());
		return 1;
		}
	else 	{
		ob = new(__DIR__"obj/paper3"); //40%-60% normal book
		ob->move(this_player());
		return 1;
		}
	return 1;
}
	
	