// Room: /u/yanzi/huashan/lianhua.c

inherit ROOM;

void create() {
  set("short", "[1;36m莲花坪[2;37;0m");
  set("long", @LONG
你走入了一片很大的草坪，草坪十分平整，看上去酷似一朵盛开
的莲花，四周都是绝壁，草坪上听着一些轿子，是专门送游客下山用
的，几个挑夫正在此等生意。旁边竖着块牌子(paizi)。
LONG
  );
  set("objects", ([ /* sizeof() == 1 */
    __DIR__ "npc/jiaofu": 1,
  ]));
  set("outdoors", "huashan");
  set("exits", ([ /* sizeof() == 1 */
    "south": __DIR__ "zhyue",
  ]));
  set("item_desc", ([ /* sizeof() == 1 */
    "paizi": "坐轿上山，每人10两银子。想要下山只要吆喝(yell)一声就行了。
",
  ]));
  set("no_clean_up", 0);

  setup();

}
void init() {
  add_action("do_yell", "yell");
}
int do_yell() {
  object me, gold, silver, money, room;
  me = this_player();
  silver = present("silver_money", me);
  gold = present("gold_money", me);

  if (!silver && !gold)
    return notify_fail("你身上带的钱不足，还是别叫了。\n");
  if (!gold && silver && (int)silver->query_amount() < 10)
    return notify_fail("你身上带的钱不足，还是别叫了。\n");
  if (!present("jiaofu", this_object()))
    return notify_fail("你叫了会儿，似乎没有人理你，一个轿夫也没有耶。\n");

  message_vision("$N对着轿夫吆喝道：来来，载我下山。\n", me);
  if (!query("exits/enter")) {
    if (!(room = find_object("/u/yanzi/huashan/jiaozi")))
      room = load_object("/u/yanzi/huashan/jiaozi");
    if (room = find_object("/u/yanzi/huashan/jiaozi")) {
      if ((int)room->query("using") == 0) {
        room->set("using", 1);
        set("exits/enter", "/u/yanzi/huashan/jiaozi");
        room->set("exits/out", "/u/yanzi/huashan/lianhua");
        if (!gold) {
          message_vision("$N给轿夫了点银子，轿夫说道，好咧，请进吧。\n", me);
          silver->add_amount(-10);
        } else {
          message_vision("$N给轿夫了一两黄金。\n", me);
          message_vision("轿夫找了$N些银子，然后说道，好咧，请进吧。\n", me);
          gold->add_amount(-1);
          if (!silver) {
            silver = new("/obj/money/silver");
            silver->move(me);
            silver->set_amount(90);
          } else silver->add_amount(90);
        }
        message("vision", "轿夫掀起轿子上的垂帘，等着人上轿。\n", this_object());
        remove_call_out("shangjiao");
        call_out("shangjiao", 10);
        return 1;
      } else
        message_vision("轿夫对$N说道：对不起，暂时没有轿子，请这位客官少等片刻。\n", me);
      return 1;
    } else return notify_fail("jiaozi not found!\n");
  } else
    message("vision", "轿夫说道：正等着你呢，上来吧。\n", this_object());
  return 1;
}
void shangjiao() {
  object room;

  if (!query("exits/enter")) return;
  message("vision", "轿夫叫了声：“起~~”，把轿子抬了起来，开始下山。\n", this_object());
  if (room = find_object("/u/yanzi/huashan/jiaozi")) {
    room->delete("exits/out");
    message("vision", "轿夫说道：客官小心了，要下山了。\n", room);
  }
  delete("exits/enter");
  remove_call_out("arrive");
  call_out("arrive", 20);
}
void arrive() {
  object where, room;
  where = find_object("/u/yanzi/huashan/yuquan");
  if (room = find_object("/u/yanzi/huashan/jiaozi")) {
    room->set("exits/out", "/u/yanzi/huashan/yuquan");
    message("vision", "轿夫放下轿子，说道：到啦，客倌下轿吧。\n", room);
    tell_room(where, "几个轿夫抬了架轿子过来，放在这里。\n");
  }
  remove_call_out("close_passage");
  call_out("close_passage", 20);
}
void close_passage() {
  object room, where;
  where = find_object("/u/yanzi/huashan/yuquan");
  if (room = find_object("/u/yanzi/huashan/jiaozi")) {
    //      room->delete("exits/out");
    tell_room(where, "轿夫把轿子抬到一边，坐下来开始休息。\n");
    room->delete("using");
  }
}
void reset() {
  object room;

  ::reset();
  if (room = find_object("/u/yanzi/huashan/jiaozi"))
    room->delete("using");
}
