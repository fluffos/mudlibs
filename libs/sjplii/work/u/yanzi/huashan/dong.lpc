// Room: /u/yanzi/huashan/dong.c

inherit ROOM;
#include <ansi.h>;

void create()
{
	set("short", HIC"贺老洞内"NOR);
	set("long", @LONG
这里到处都是凌乱的兵器与与已经只剩下骨头的骷髅，可想而知
，当年那场大战一定是非常激烈的了。
LONG
	);
	set("exits", ([ /* sizeof() == 1 */
  "out" : __DIR__"hldong",
]));
	set("no_clean_up", 0);
	set("book_count", 1);

	setup();
}
void init()
{
	add_action("do_search", "search");
}
int do_search(string arg)
{
	object me, ob;
	me = this_player();

	if( (!arg ) || (!(arg=="地上" || arg =="floor" )) )
		return 0;
	if (query("book_count") < 1)
		return notify_fail("你在地上摸索了会儿，但什么也没有发现。\n");
	message_vision("$N在地上摸索了会儿，突然发现了块铁牌，连忙放入自己怀中。\n",me);
	add("book_count", -1);
	ob=new(__DIR__"obj/tiepai");
	ob->move(me);
	return 1;
}