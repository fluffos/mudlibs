// Room: /u/yanzi/huashan/chidi.c

inherit ROOM;

void create() {
  set("short", "[1;36m池底[2;37;0m");
  set("long", @LONG
这里就是玉女池池底，池底长满了浓茂水草，在水草之中似乎有
什么东西发着荧荧绿光？但转瞬即逝，是你自己的错觉？
LONG
  );
  set("exits", ([ /* sizeof() == 1 */
    "up": __DIR__ "chizhong",
  ]));

  set("no_clean_up", 0);
  set("sword_out", 0);
  set("sword_count", 1);

  setup();

}
void init() {
  add_action("do_pull", "pull");
  add_action("do_search", ({ "bo", "search" }));
}
int do_pull(string arg) {
  object me, obj;
  int str;
  me = this_player();
  str = (int)me->query("str");
  if (!me->query_temp("marks/huashan/bo"))
    return notify_fail("这里没有东西可以拔。\n");
  if (!arg || arg != "sword")
    return notify_fail("你要拔什么东西？\n");
  if (str < 20)
    return notify_fail("你试着拼命将宝剑往外拉，但它仍纹丝不动。\n");
  add("sword_out", 1 + random(str / 20));
  if (query("sword_out") > 3) {
    message_vision("$N试着拼命将宝剑往外拉，终于将宝剑拉了出来。\n", me);
    obj = new(__DIR__ "obj/bishui_sword");
    obj->move(me);
    me->delete_temp("marks/huashan/bo");
    add("sword_count", -1);
    return 1;
  }
  message_vision("$N试着拼命将宝剑往外拉，终于将宝剑拉出来了点。\n", me);
  return 1;
}
int do_search(string arg) {
  object me;
  int kar, i;
  me = this_player();
  i = random(100);
  kar = (int)me->query("kar");
  if (!arg || arg != "水草")
    return notify_fail("你要搜索什么？\n");
  if (me->query_temp("huashan/search_count") >= 3)
    return notify_fail("你找了这么长时间还没发现，别浪费时间了。\n");
  if (query("sword_count") < 1 || i > 30 + kar) {
    write("你在水中扒开层层水草，也没找到什么东西。\n");
    me->add_temp("huashan/search_count", 1);
    return 1;
  }
  message_vision("$N拔开层层水草，突然发现在一块石头上插着把宝剑，剑身闪烁着荧荧绿光。\n", me);
  me->set_temp("marks/huashan/bo", 1);
  return 1;
}
int valid_leave(object me, string dir) {
  if (me->query_temp("huashan/search_count")) me->delete_temp("huashan/search_count");
  if (me->query_temp("marks/huashan/bo")) me->delete_temp("marks/huashan/bo");
  return ::valid_leave();
}
