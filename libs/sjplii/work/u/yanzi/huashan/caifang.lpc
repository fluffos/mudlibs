// Room: /u/yanzi/huashan/caifang.c

inherit ROOM;

void create()
{
	set("short", "[1;36m柴房[2;37;0m");
	set("long", @LONG
这是一间很大的屋子，里面放满了烧饭用的干柴，但是却堆地乱
七八糟，地上还有斑斑血迹，令人十分起疑。
LONG
	);

	set("no_clean_up", 0);
	set("exits", ([ /* sizeof() == 1 */
  "east" : __DIR__"chufang",
]));
	set("item_desc", ([ /* sizeof() == 2 */
  "干柴" : "一堆十分普通的干柴，再仔细看看，似乎柴堆里有什么东西。
",
  "血迹" : "一滩血迹，但是已经干了，好象是几天前留下的。
",
]));
	set("fu_count",1);
	setup();

}
void init()
{
        add_action("do_move", "move");
}
int do_move(string arg)
{
	object me,ob;
	me = this_player();

	if( (!arg ) || (!(arg=="chai" || arg == "干柴" )) )
		return notify_fail("你要移动什么？\n");
	message_vision("$N十分吃力地把干柴搬开。\n",me);
	if(query("fu_count") < 1)
		return notify_fail("下面什么东西也没有。\n");
	message("vision","干柴下顿时露出一把斧头。\n", environment(me));
	add("fu_count",-1);
	ob = new(__DIR__"obj/tiefu1");
	ob ->move(environment(me));
	return 1;
}