// huashan-dizi.c
inherit NPC;

string reward_more(object who);
string *first_name = ({
"赵","钱","孙","李","周","吴","郑","王","冯","陈","褚","卫","蒋","沈","韩","杨","朱","秦","尤","许","何","吕","施","张",
"孔","曹","严","华","金","魏","陶","姜","戚","谢","邹","鲁","柏","邓","窦","倪","贺","苏","潘","史","马","范","彭","韦",
"上官","欧阳","夏候","诸葛","长孙","东方","呼延","皇甫","尉迟","司马","公孙","慕容","端木","百里",
});
string *last_name = ({
"忘","过","云","国","善","通","大","见","可","在","相","助","智","开","自","强","力","明","铭","诚","铖","冰","秉","狮",
"玉","峰","威","德","真","元","誉","竹","笑","复","得","慈","波","罗","星","冲","敬","康","靖","淳","行","宗","强","虎",
});
void create()
{
        string name;
        name = first_name[random(sizeof(first_name))];
        name += last_name[random(sizeof(last_name))];
        set_name( name, ({ "dizi" }) );
        set("gender", "男性");
        set("age",20+random(10));

        set("int", 10+random(10));
        set("cor", 10+random(10));
        set("agi", 10+random(10));
        set("con", 10+random(10));
        set("str", 10+random(10));
        set("tol", 10+random(10));
        set("spi", 10+random(10));
        set("dur", 10+random(10));
        set("per", 10+random(10));
        set("fle", 10+random(10));
        set("cps", 10+random(10));
        set("long",@LONG
这是个十分年轻的华山弟子，手持长剑，站着十分地英武。
LONG
        );
        set("max_force", 500+random(400));
        set("force", 800+random(400));
        set("force_factor", 10+random(10));
        set("combat_exp", 50000+random(50000));
        set("score", 300+random(100));
//      set("daode", 900);

        set_skill("dodge", 45+random(20));
        set_skill("move", 45+random(20));
        set_skill("parry", 50+random(20));
        set_skill("sword", 55+random(20));
        set_skill("force", 40+random(20));
        set_skill("unarmed", 45+random(20));
        set_skill("literate", 20+random(20));
        set_skill("hs-zhengqi", 25+random(20));
        set_skill("huashan-force", 35+random(20));
        set_skill("huashan-sword", 55+random(20));
        set_skill("huashan-strike", 50+random(20));
        set_skill("tianluo-steps", 50+random(20));

        map_skill("sword", "huashan-sword");
        map_skill("parry", "huashan-sword");
        map_skill("force", "huashan-force");
        map_skill("unarmed", "huashan-strike");
        map_skill("dodge", "tianluo-steps");
        map_skill("move", "tianluo-steps");
        set("chat_chance_combat", 50);
        set("chat_msg_combat", ({
        (: reward_more(this_object()) :),
        }) );
        create_family("华山派", 16, "弟子");

        setup();
      
        carry_object(__DIR__"obj/longsword");
        carry_object("/obj/cloth")->wear();
}
int accept_fight(object ob)
{
        if(ob->query("class") == "huashan"
        || ob->query("class") == "xiaoyao" ) {
                this_object()->set("chat_chance_combat",50);
                this_object()->set("force_factor",0);
                }
        else command("wield changjian");
        return 1;
}
string reward_more(object who)
{
        int i;
        object *enemy;
        seteuid(getuid());
        enemy = who->query_enemy();
        i = sizeof(enemy);
        while(i--) {
                if( enemy[i] && living(enemy[i]) ) {
			if( enemy[i]->query("combat_exp") < 50000 ) return "1";
                        if( enemy[i]->query("combat_exp") > 90000 ) return "1";
                        enemy[i]->add("combat_exp", 1);
			if( enemy[i]->query("potential")-enemy[i]->query("learned_points") > 90 ) return "1";
			else
		if(random(9)<5)
			enemy[i]->add("potential", 1);
			else
			enemy[i]->add("life_exp", 1);
                }
        }
        return "1";
}
#include "/u/yanzi/huashan/npc/guard.h"
