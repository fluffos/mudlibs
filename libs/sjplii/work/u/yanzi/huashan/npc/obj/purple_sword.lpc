// purple_sword.c
#include <weapon.h>
#include <ansi.h>
inherit SWORD;

void create() {
  set_name(MAG "紫电" NOR, ({ "purple sword", "sword", "jian" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("value", 100000);
    set("material", "blacksteel");
    set("long", "这是一把黝黑的长剑，剑身隐隐泛出紫色的光芒。\n");
    set("wield_msg", "一阵紫芒闪过，$n已握在$N手中。\n");
    set("unwield_msg", "$N放下了手中$n。\n");
    set("no_drop", "紫电是无法丢弃的。\n");
  }
  init_sword(150);
  setup();
}
