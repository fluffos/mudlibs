// bamboo_staff.c

#include <weapon.h>

inherit STAFF;

void create()
{
        set_name("竹手杖", ({ "bamboo staff", "staff"}) );
        set_weight(1100);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "根");
                set("long", "一根用于登山的竹手杖。\n");
                set("value", 200);
                set("material", "bamboo");
                set("wield_msg", "$N拿出一根$n握在手中。\n");
                set("unwield_msg", "$N放下手中的$n。\n");
        }

        init_staff(2);
        setup();
}
