// huasheng.c

inherit ITEM;

void create()
{
	set_name("花生", ({ "huasheng" }) );
	set_weight(80);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "一碟香脆的花生。\n");
		set("unit", "碟");
		set("value", 50);
		set("remaining", 3);
		set("food_supply", 30);
	}
	setup();
}
void init()
{
	add_action("do_eat", "eat");
}


int do_eat(string arg)
{

    if( !this_object()->id(arg) ) return 0;
    if( this_player()->is_busy() )
        return notify_fail("你上一个动作还没有完成。\n");
    if(   (int)this_player()->query("food")
       >= (int)this_player()->max_food_capacity() )
     return notify_fail("你已经吃太饱了，再也吃不下了。\n");

    set("value", 0);
    this_player()->add("food", (int)query("food_supply"));
//    if(   (int)this_player()->query("water")
//       < (int)this_player()->max_water_capacity()-(int)query("water_supply"))
//    this_player()->add("water", (int)query("water_supply"));

    if( this_player()->is_fighting() ) this_player()->start_busy(2);

    add("remaining", -1);
	if ( query("remaining") )
	{
   		 message_vision("$N拿起碟子，抓起一把花生往嘴里送，咯吱咯吱咬起来。\n", this_player());
	} 
	else 
	{ 
   		 message_vision("$N拿起碟子，把剩下的花生吃了个精光。\n",this_player());
   		 message_vision("$N将碟子往后一扔，赞道：好香的花生！\n",this_player());
		destruct(this_object());
	}

	return 1;
}

