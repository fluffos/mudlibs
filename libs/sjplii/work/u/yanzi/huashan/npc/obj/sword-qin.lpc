// sword-qin.c
#include <weapon.h>
#include <ansi.h>
inherit SWORD;

void create() {
  set_name(HIW "琴中剑" NOR, ({ "qin sword", "sword" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("value", 9000);
    set("material", "steel");
    set("long", "这是一把黝黑细长的长剑。\n");
    set("wield_msg", "“唰”地一声，$N握了把$n在手中！\n");
  }
  init_sword(65);
  setup();
}
void init() {
  add_action("do_unwield", "unwield");
}
int do_unwield(string arg) {
  object me, obj, qin;
  me = this_player();
  obj = this_object();
  qin = (present("qin", me));
  if (!arg) return 0;
  if (arg == "qin sword" || arg == "sword") {
    if (!present("qin", me)) {
      message_vision("$N放下了手中的$n。\n", me, obj);
      obj->unequip();
      return 1;
    } else {
      message_vision("“唰”地一声，$N把手中的$n插回古琴之中。\n", me, obj);
      qin->set("sword_count", 1);
      destruct(obj);
      return 1;
    }
    return 0;
  }
}
