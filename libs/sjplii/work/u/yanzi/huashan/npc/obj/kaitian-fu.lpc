// tiefu1.c

inherit ITEM;
#include <ansi.h>;
void create()
{
	set_name(HIY"开天斧"NOR, ({ "kaitian-fu","futou"}) );
	set_weight(4000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "柄");
		set("value", 150000);
		set("material", "blacksteel");
		set("long","相传这是盘古开天所用的斧头。\n");
	}
	setup();
}
