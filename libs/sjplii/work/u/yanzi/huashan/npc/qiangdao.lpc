// gangster.c

inherit NPC;

string kill_passenger(object who);

void create()
{
        set_name("游客", ({ "you ke","ke" }) );
        set("gender", "男性" );
        set("age", 27+random(10));
        set("str", 25+random(5));
        set("int", 12);
        set("per", 1);

        set("long", @LONG
一个来华山游玩的游客，正在这里欣赏风景
LONG
);
        set("attitude", "friendly");
        set("combat_exp", 20000);

        setup();

        carry_object("/obj/cloth")->wear();
}

void init()
{
        object ob;

        ::init();
        if( interactive(ob = this_player()) && !is_fighting() 
        &&(int)ob->query_temp("huashan/quest") == 8 ) {
                this_player()->start_busy(1);
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
        }
        add_action("do_kill","kill");
}

void greeting(object ob)
{
        object weapon,obj;
        string skill_type;      

        message_vision("游客突然抽出一把刀对着$N。\n",ob);
        set_name("强盗", ({ "qiang dao","dao" }) );
        set("long","这强盗满脸伤疤，虎背熊腰，一脸凶狠而霸道的样子。\n");
        set("attitude", "heroism");
        set("chat_chance", 10);
        set("chat_msg", ({
"强盗喝道：呔！此山是我开，此树乃我栽。要想从此过，留下买路财！\n",
"强盗将你上上下下打量了一番，说道：识相的放下十两黄金买路钱走你的路。\n",
        }) );
        if( objectp(weapon = ob->query_temp("weapon")) )
                skill_type = weapon->query("skill_type");
        else
                skill_type = "unarmed";
        set("max_kee",ob->query("max_kee"));
        set("eff_kee",ob->query("max_kee"));
        set("kee",ob->query("max_kee"));
        set("max_force",ob->query("max_force"));
        set("force",ob->query("force"));
        set("force_factor",ob->query("force_factor"));
        set("combat_exp", ob->query("combat_exp") + ob->query("combat_exp")/10);
        set_skill("blade",ob->query_skill(skill_type,1));
        set_skill("parry",ob->query_skill("parry",1));
        set_skill("dodge",ob->query_skill("dodge",1));
        if(query_skill("blade",1) > 150) set_skill("blade",150);
        if(query_skill("parry",1) > 150) set_skill("parry",150);
        if(query_skill("dodge",1) > 150) set_skill("dodge",150);
        if(query("combat_exp") > 500000) set("combat_exp",500000);
        if(query("combat_exp") < 200000) set("combat_exp",200000);
        
        add_money("gold",5);
        carry_object("/obj/weapon/blade")->wield();
}

int accept_object(object who, object ob)
{
        object *man;
        int i;
        if(this_object()->query("name") != "强盗")
                return 0;
        if( ob->value() >= 100000 ) {
                say("强盗接过钱，眼睛瞪得大大的，点了点头，说道：大爷今天做个善人，放你条生路。\n");
                say("强盗对着几个伙计挥挥手，我们走吧，好好享受享受去！\n");
                man = all_inventory(environment(who));
                for(i=0; i<sizeof(man); i++) {
                        if(man[i] == this_object()) continue;
                        if(man[i]->query("name") != "强盗") continue;
                        destruct(man[i]);
                        say("几个强盗大摇大摆地走了。\n");
                        destruct(this_object());
                }
        } 
        else {
                say("强盗往地上吐了口唾沫，目露凶光，说道：不给你点颜色你是不知道大爷的厉害！\n");
                kill_passenger(who);
                return 0;
        }
}

string kill_passenger(object who)
{
        object *man;
        int i;
        set("attitude", "aggressive");
        set("chat_chance_combat", 15);
        set("chat_msg_combat", ({
                "强盗显是以劫为生，刀刀冲要害而来。\n",
                "强盗高喊：叫你人财两空。\n",
        }) );
        man = all_inventory(environment(who));
        for(i=0; i<sizeof(man); i++) {
                if(man[i]->query("name") != "强盗") continue;
                this_player()->kill_ob(man[i]);
                man[i]->kill_ob(this_player());
        }
        return 0;
}

int accept_fight(object me)
{
        if(this_object()->query("name") == "游客")
                return 0;
        command("say 竟敢太岁爷头上动土？纳命来！");
        command("grin");
        kill_passenger(me);
        return 1;
}
void die()
{
        if(this_object()->query("name") == "强盗") {
		if(this_player())
                this_player()->add("daode_point",10);
        }
        ::die();
}
int do_kill(string arg)
{
        object ob,victim;
        string name;
        ob = this_player();
        if(!arg)
        return 0;
        if( objectp(victim = present(arg, environment(this_object()))))
        {
                if (victim->query("name") == "强盗") 
                        kill_passenger(ob);
                else return 0;
                return 1;
        }
        else return 0;
}
