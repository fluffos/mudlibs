// huashan-dizi.c
inherit NPC;

void create()
{
        set_name("逍遥弟子", ({ "xiaoyao dizi","dizi" }) );
        set("gender", "男性");
        set("age",20+random(10));

        set("int", 10+random(10));
        set("cor", 10+random(10));
        set("agi", 10+random(10));
        set("con", 10+random(10));
        set("str", 10+random(10));
        set("tol", 10+random(10));
        set("spi", 10+random(10));
        set("dur", 10+random(10));
        set("per", 10+random(10));
        set("fle", 10+random(10));
        set("cps", 10+random(10));
        set("long",@LONG
这是一个负责接待武林人士的逍遥弟子。
LONG
        );
        set("max_force", 500+random(400));
        set("force", 800+random(400));
        set("force_factor", 10+random(10));
        set("combat_exp", 50000+random(50000));
        set("score", 300+random(100));

        set_skill("dodge", 45+random(20));
        set_skill("parry", 50+random(20));
        set_skill("sword", 55+random(20));
        set_skill("force", 40+random(20));
        set_skill("unarmed", 45+random(20));
        set_skill("literate", 20+random(20));
        set_skill("bm_force", 35+random(20));
        set_skill("gaoge_sword", 55+random(20));
        set_skill("ymei_strike", 50+random(20));
        set_skill("wave_steps", 50+random(20));

        map_skill("sword", "gaoge_sword");
        map_skill("parry", "gaoge_sword");
        map_skill("force", "bm_force");
        map_skill("unarmed", "ymei_strike");
        map_skill("dodge", "wave_steps");

        create_family("逍遥派", 14, "弟子");

        setup();
      
//      carry_object"/u/yanzi/huashan/npc/obj/longsword")->wield();
        carry_object("/obj/cloth")->wear();
}
int accept_object(object who, object ob)
{
        if(!who->query_temp("huashan/quest")) return 0;
        if((int)who->query_temp("huashan/quest") != 7) return 0;
        if(ob->query("id") != "letter") return 0;
        command("say 给我派的书信啊，给我吧，我会转交给我派掌门的。");
        who->set_temp("over",1);
        return 1;
}
