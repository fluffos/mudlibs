// ziyan.c
inherit NPC;
#include <ansi.h>;

void create()
{
	set_name("莫紫烟", ({ "mo ziyan", "ziyan", "mo" }) );
	set("gender", "女性");
	set("age",17);
	set("nickname", HIM"小师妹"NOR);
	set("long",@LONG
莫紫烟是莫天雄的独生爱女，深得父亲宠爱，华山弟子们也都十分喜
欢她，无论年纪大小，都亲切地称她为小师妹。
LONG
	);
	set("per", 35);
	set("max_force", 800);
	set("force", 900);
	set("force_factor", 20);
	set("combat_exp", 50000);
	set("score", 2000);
//	set("daode", 10900);

	set_skill("dodge", 40);
	set_skill("move", 40);
	set_skill("parry", 40);
	set_skill("sword", 50);
	set_skill("force", 40);
	set_skill("unarmed", 20);
	set_skill("literate", 50);
        set_skill("hs-zhengqi", 30);
	set_skill("huashan-force", 40);
	set_skill("huashan-sword", 50);
	set_skill("huashan-strike", 40);
	set_skill("tianluo-steps", 45);

	map_skill("sword", "huashan-sword");
	map_skill("parry", "huashan-sword");
	map_skill("force", "huashan-force");
	map_skill("unarmed", "huashan-strike");
	map_skill("dodge", "tianluo-steps");
	map_skill("move", "tianluo-steps");

	create_family("华山派", 16, "弟子");

	set("env/wimpy", 70);
	set("chat_chance", 30);

	setup();
	carry_object(__DIR__"obj/gangjian")->wield();
	carry_object("/obj/cloth")->wear();
	carry_object(__DIR__"obj/guazi");
	carry_object(__DIR__"obj/guazi");
	carry_object(__DIR__"obj/shuihu");
	if( clonep() ) CHANNEL_D->register_relay_channel("chat");
}
int accept_fight(object ob)
{
	int exp = (int)ob->query("combat_exp");
	if (exp < 45000) {
		command("xixi");
		command("say 好啊，我们就来玩两手吧。\n");
		return 1;
	}
	else {
		message_vision("$N说道：小女子怎么会是" + RANK_D->query_respect(ob) + "的对手呢？\n",this_object());
		return 0;
	}
}
