// laoshen.c
inherit NPC;
inherit F_MASTER;
#include <ansi.h>;

void create()
{
	set_name("李志平", ({ "li zhiping", "li" }) );
	set("gender", "男性");
	set("age",60);
	set("attitude", "peaceful");
	set("int", 30);
	set("cor", 25);
	set("agi", 30);
	set("con", 25);
	set("str", 25);
	set("tol", 30);
	set("spi", 30);
	set("dur", 30);
	set("per", 28);
	set("fle", 30);
	set("cps", 30);
	set("long",@LONG
他就是大名鼎鼎的华山大侠令狐冲的大弟子，也是唯一得到令狐剑法
精髓的唯一传人，只是他对江湖之事一直不敢兴趣，长年隐居于华山
因而江湖之上知道他的并不多。
LONG
	);
	set("max_force", 3500);
	set("force", 5000);
	set("force_factor", 100);
	set("combat_exp", 3000000);
	set("score", 20000);
//	set("daode", 79900);

	set_skill("dodge", 280);
	set_skill("parry", 280);
	set_skill("sword", 350);
	set_skill("force", 200);
	set_skill("unarmed", 100);
	set_skill("literate", 200);
        set_skill("hs-zhengqi", 250);
	set_skill("dg9-sword", 300);
	set_skill("huashan-sword", 300);
	set_skill("huashan-force", 250);
	set_skill("huashan-strike", 150);
	set_skill("tianluo-steps", 300);


	map_skill("sword", "dg9-sword");
	map_skill("parry", "huashan-sword");
	map_skill("force", "huashan-force");
	map_skill("unarmed", "huashan-strike");
	map_skill("dodge", "tianluo-steps");

	create_family("华山派剑宗", 15, "传人");

	setup();
	carry_object(__DIR__"obj/gangjian")->wield();
	carry_object("/obj/cloth")->wear();
}
void attempt_apprentice()
{
	object me,ob;
	int sk;
	me = this_player();
	ob = this_object();
	sk = (int)me->query_skill("sword", 1);
	if ( sk > 150 ) {
	command("shake");
	command("say 但你我能在此见面说明我们有缘，我就传你一招独孤九剑，能领会多少就看你了。\n");
	message_vision("李志平传授$N有关独孤九剑的秘诀，$N似乎有所领悟。\n",me);
	me->set_skill("dg9-sword", 1);
	me->set("marks/huashan/dg9", 1);
	tell_object(me,"李志平对你说道：在下告辞了，只见人影一晃，他已不见踪迹了。\n");
	ob->apply_condition("huashan_siguo", 30);
	destruct(ob);
	}
	else {
	command("shake");
	command("say 但你我能在此见面说明我们有缘，本想传你一招独孤九剑，但你剑法根基太浅，可惜可惜。\n");
	tell_object(me,"李志平对你说道：在下告辞了，只见人影一晃，他已不见踪迹了。\n");
	ob->apply_condition("huashan_siguo", 30);
	destruct(ob);
	}
}
