// lifeng.c
inherit NPC;

int ask_team();
string reward_more(object who);
void create()
{
        set_name("李风", ({ "li feng", "li" }) );
        set("gender", "男性");
        set("nickname", "掌法教师");
        set("age",32);
        set("long",@LONG
这是一个三十出头的华山弟子，专门在这里指导新入门的华山弟子掌
法。
LONG
        );
        set("max_force", 1100);
        set("force", 1600);
        set("force_factor", 50);
        set("combat_exp", 100000);
        set("score", 9000);
//      set("daode", 4900);

        set_skill("dodge", 80);
        set_skill("parry", 80);
        set_skill("sword", 40);
        set_skill("force", 60);
        set_skill("unarmed", 80);
        set_skill("literate", 30);
        set_skill("hs-zhengqi", 30);
        set_skill("huashan-force", 80);
        set_skill("huashan-sword", 50);
        set_skill("huashan-strike", 80);
        set_skill("tianluo-steps", 80);

        map_skill("sword", "huashan-sword");
        map_skill("parry", "huashan-sword");
        map_skill("force", "huashan-force");
        map_skill("unarmed", "huashan-strike");
        map_skill("dodge", "tianluo-steps");
        set("chat_chance_combat", 50);
        set("chat_msg_combat", ({
        (: reward_more(this_object()) :),
        }) );
        create_family("华山派", 16, "弟子");

        setup();
        carry_object("/obj/cloth")->wear();
}
void attempt_apprentice(object ob)
{
        int exp = (int)ob->query("combat_exp");
        if( exp > 10000) {
        command("shake");
        command("say 我这点微末武功怎么敢当呢？");
        return;
        }
        command("smile");
        command("say 很好，" + RANK_D->query_respect(ob) + 
"多加努力，他日必定有成。\n");
        command("recruit " + ob->query("id") );
        ob->set("title", "华山派入室弟子");
        ob->set("class","huashan");
        ob->set("id_type",1);
}
int accept_fight(object ob)
{
        if(ob->query("class") == "huashan"
        || ob->query("class") == "xiaoyao" ) {
                this_object()->set("chat_chance_combat",50);
                this_object()->set("force_factor",0);
                }
        return 1;
}
string reward_more(object who)
{
        int i;
        object *enemy;
        seteuid(getuid());
        enemy = who->query_enemy();
        i = sizeof(enemy);
        while(i--) {
                if( enemy[i] && living(enemy[i]) ) {
                        if( enemy[i]->query("combat_exp") > 200000 ) return "1";
                        enemy[i]->add("combat_exp", 1);
			if( enemy[i]->query("potential")-enemy[i]->query("learned_points") > 100 ) return "1";
			else
		if(random(9)<5)
			enemy[i]->add("potential", 1);
			else
			enemy[i]->add("life_exp", 1);
                }
        }
        return "1";
}
#include "/u/yanzi/huashan/npc/guard.h"
