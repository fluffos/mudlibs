// duan.c
inherit NPC;
#include <ansi.h>;

void create()
{
        set_name("段成海", ({ "duan chenghai","duan" }) );
        set("gender", "男性");
        set("age",24);
        set("title", "华山派四师哥");
        set("nickname", WHT"华山三英"NOR);
        set("long",@LONG
段成海是莫天雄的四弟子，是华山一派中数一数二的好手，乃华山派
人称“华山三英”之一，现在负责守卫山门，并接待来华山的武林人士。
LONG
        );
        set("attitude", "peaceful");
        set("int", 20);
        set("cor", 20);
        set("agi", 20);
        set("con", 20);
        set("str", 20);
        set("tol", 20);
        set("spi", 18);
        set("dur", 20);
        set("per", 28);
        set("fle", 15);
        set("cps", 20);
        set("max_force", 2000);
        set("force", 3200);
        set("force_factor", 85);
        set("combat_exp", 700000);
        set("score", 35000);
//      set("daode", 49000);

        set("chat_chance_combat", 70);
        set("chat_msg_combat", ({
        (: perform_action, "sword.taiyue" :),
        }) );
        set_skill("dodge", 130);
        set_skill("parry", 140);
        set_skill("sword", 140);
        set_skill("force", 120);
        set_skill("unarmed", 100);
        set_skill("literate", 90);
        set_skill("hs-zhengqi", 100);
        set_skill("huashan-force", 130);
        set_skill("zixia-shengong", 90);
        set_skill("huashan-sword", 140);
        set_skill("huashan-strike", 130);
        set_skill("tianluo-steps", 130);

        set("perform/huashan/taiyue",1000);  //perform lv=1

        map_skill("sword", "huashan-sword");
        map_skill("parry", "huashan-sword");
        map_skill("force", "zixia-shengong");
        map_skill("unarmed", "huashan-strike");
        map_skill("dodge", "tianluo-steps");

        create_family("华山派", 16, "弟子");

        setup();
        carry_object(__DIR__"obj/longsword")->wield();
        carry_object("/obj/cloth")->wear();
}

void init()
{
         object ob;
        ::init();
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
        }
        add_action("do_killing", "kill");
}
int do_killing(string arg)
{
        object player,victim;
        player = this_player();
        if(!arg)
        return 0;
        if( objectp(victim = present(arg, environment(this_object()))))
        {
                if (victim->query("family/family_name")== "华山派") 
                {
                message_vision("$N大怒，大胆狂徒，竟敢在华山动手，未免太小看我们华山派吧！受死吧！\n",this_object());
                this_object()->kill_ob(player);
                player->kill_ob(this_object());
                return 0;
                }
                else return 0;
        }
        else return 0;
}
void killed_enemy(object ob)
{
        command("say 哈哈, 不自量力的家伙！");
}
void greeting(object ob)
{
        if( !ob || environment(ob) != environment() ) return;
        if( ob->query_temp("guard"))
                command("say 你是来帮忙的吧，在这儿好好看守(guard)山门吧！\n");
}
