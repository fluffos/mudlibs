// zhao.c
inherit NPC;
int ask_team();
string reward_more(object who);
void create() {
  set_name("赵天雷", ({ "zhao tianlei", "zhao" }));
  set("gender", "男性");
  set("nickname", "剑法教师");
  set("age", 36);
  set("str", 35);
  set("long", @LONG
这是一个三十几岁的华山弟子，专门在这里指导新入门的华山弟子学
习剑法。
LONG
  );
  set("max_force", 2000);
  set("force", 3000);
  set("force_factor", 40);
  set("combat_exp", 150000);
  set("score", 10000);
  //      set("daode", 4900);

  set_skill("dodge", 85);
  set_skill("parry", 85);
  set_skill("sword", 90);
  set_skill("force", 90);
  set_skill("unarmed", 35);
  set_skill("literate", 30);
  set_skill("hs-zhengqi", 35);
  set_skill("huashan-force", 80);
  set_skill("huashan-sword", 90);
  set_skill("huashan-strike", 50);
  set_skill("tianluo-steps", 80);

  map_skill("sword", "huashan-sword");
  map_skill("parry", "huashan-sword");
  map_skill("force", "huashan-force");
  map_skill("unarmed", "huashan-strike");
  map_skill("dodge", "tianluo-steps");
  set("chat_chance_combat", 0);
  set("chat_msg_combat", ({
    (: reward_more(this_object()) :),
  }));
  create_family("华山派", 16, "弟子");

  setup();
  carry_object(__DIR__ "obj/longsword")->wield();
  carry_object("/obj/cloth")->wear();
}
void attempt_apprentice(object ob) {
  int exp = (int)ob->query("combat_exp");
  if (exp > 10000) {
    command("shake");
    command("say 我这点微末武功怎么敢当呢？");
    return;
  }
  command("smile");
  command("say 很好，" + RANK_D->query_respect(ob) +
    "多加努力，他日必定有成。\n");
  command("recruit " + ob->query("id"));
  ob->set("title", "华山派入室弟子");
  ob->set("class", "huashan");
  ob->set("id_type", 1);
}
int accept_fight(object ob) {
  if (ob->query("class") == "huashan"
    || ob->query("class") == "xiaoyao") {
    this_object()->set("chat_chance_combat", 50);
    this_object()->set("force_factor", 0);
  }
  return 1;
}
string reward_more(object who) {
  int i;
  object *enemy;
  seteuid(getuid());
  enemy = who->query_enemy();
  i = sizeof(enemy);
  while (i--) {
    if (enemy[i] && living(enemy[i])) {
      if (enemy[i]->query("combat_exp") < 90000) return "1";
      if (enemy[i]->query("combat_exp") > 150000) return "1";
      enemy[i]->add("combat_exp", 1);
      if (enemy[i]->query("potential") - enemy[i]->query("learned_points") > 300) return "1";
      else if (random(9) < 5)
        enemy[i]->add("potential", 1);
      else
        enemy[i]->add("life_exp", 1);
    }
  }
  return "1";
}
#include "/u/yanzi/huashan/npc/guard.h"
