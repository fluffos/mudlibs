// jiaofu.c

inherit NPC;
void check_trigger();
string ask_me(object who);

void create()
{
        set_name("轿夫", ({ "jiaofu" }) );
        set("gender", "男性" );
        set("age", 41);

        set("long", "一个专门在华山上抬轿的轿夫。\n");              

        set("attitude", "friendly");
        set("str", 50);
	
        setup();      
 
	carry_object("/obj/cloth")->wear();

        add_money("silver", 10);
}

