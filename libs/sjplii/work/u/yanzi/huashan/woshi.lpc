// Room: /u/yanzi/huashan/woshi.c

inherit ROOM;

void create() {
  set("short", "[1;36m卧室[2;37;0m");
  set("long", @LONG
这里就是一代大侠令狐冲在华山以前的居所，按照他死前的遗言
，这里一直没有改变，每天都有人来这里打扫。这里只摆著一只大床
，几张桌椅，北面墙上则挂着一把宝剑，据说乃是令狐冲生前所持之
剑。
LONG
  );
  set("no_clean_up", 0);
  set("exits", ([ /* sizeof() == 1 */
    "east": __DIR__ "zoulang",
  ]));

  set("book_count", 1);
  setup();
}

void init() {
  add_action("do_move", "move");
  add_action("do_zhuan", "zhuan");
  add_action("do_qiao", "qiao");
  if (this_player()->query_temp("woshi"))
    add_action("do_clean", "clean");
}
int do_clean() {
  object me;
  int cost;
  me = this_player();
  cost = 40 + (25 - me->query("int"));

  if (me->query_temp("over"))
    return notify_fail("你已经完工了，快复命去吧。\n");
  if (me->query_temp("busy"))
    return notify_fail("你正忙着呢。\n");
  if (me->query("sen") < cost || me->query("gin") < cost)
    return notify_fail("你够累的了，休息一下吧!\n");

  me->set_temp("busy", 1);
  if (me->query_temp("num") == me->query_temp("woshi")) {
    tell_object(me, "经过你的辛勤打扫，令狐大侠的卧室变得窗明几净，你可着自己的劳动成果，开心地笑了。\n");
    message_vision("$N擦了擦额头的汗水，收工了。\n", me);
    tell_object(me, "你在" + chinese_number((int)me->query_temp("woshi")) +
      "次任务中总共成功完成" + chinese_number((int)me->query_temp("success")) +
      "次。\n");
    if ((int)me->query_temp("success") == (int)me->query_temp("woshi"))
      me->set_temp("wonderful", 1);
    me->delete_temp("woshi");
    me->delete_temp("num");
    me->set_temp("over", 1);
    me->delete_temp("busy");
    return 1;
  }
  message_vision("$N开始忙碌地打扫起卧室来。\n", me);
  switch (random(3)) {
    case 0:
      message_vision("$N拿着抹布，一个一个擦拭卧室中摆设的器件。\n", me);
      break;
    case 1:
      message_vision("$N拿着扫帚，在扫地上的垃圾。\n", me);
      break;
    case 2:
      message_vision("$N拿着拖把，在拖着地板。\n", me);
      break;
  }
  call_out("improve", 1, me);
  me->start_busy(1);
  return 1;
}
void improve(object who) {

  object ob;
  int cost, kar, i, n;
  cost = 40 + (25 - who->query("int"));
  kar = (int)who->query("kar");
  i = random(100);
  n = 30 + who->query("int") + who->query_skill("parry", 1) / 10;

  who->add("sen", -cost);
  who->add("gin", -cost);

  who->add_temp("num", 1);
  who->set_temp("busy", 0);
  if (random(100) < 10 + kar / 10) {
    message_vision("$N在打扫过程中不小心碰了下北面墙上的剑。\n", who);
    message_vision("只听随着轰隆隆的声响，$N面前打开了一道密门。\n", who);
    set("exits/north", __DIR__ "mishi");
    remove_call_out("close");
    call_out("close", 5, this_object());
  }
  if (i < n) {
    tell_object(who, "\n你这次的活干得相当不错。\n");
    who->add_temp("success", 1);
  } else
    tell_object(who, "\n你这次的表现似乎不太好啊。\n");
}
int do_move(string arg) {
  object me;
  me = this_player();

  if ((!arg) || (!(arg == "bed" || arg == "床")))
    return notify_fail("你要移动什么？\n");
  if (me->query_temp("marks/移"))
    return notify_fail("你已经移开床了。\n");
  me->set_temp("marks/移", 1);
  message_vision("$N十分吃力地把大床移开。\n", me);
  message("vision", "床下露出一地十分普通的石砖。\n", environment(me));
  return 1;
}
int do_qiao(string arg) {
  object me, ob, weapon;
  me = this_player();

  if ((!arg) || (!(arg == "zhuan" || arg == "brick" || arg == "砖")))
    return notify_fail("你要撬什么？\n");
  if (me->query_temp("marks/移")) {
    if (!objectp(weapon = me->query_temp("weapon")))
      return notify_fail("你用尽力气，还是没法撬开，找把家伙试试吧！\n");
    message_vision("$N拔出兵刃，将一块方砖撬起。\n", me);
    if (query("book_count") < 1)
      return notify_fail("你将手伸进去，摸了摸，里面什么也没有。\n");
    message_vision("$N伸手进去，摸出一个事物，却是个铁盒，打开一看，\n里面是一部已经泛黄的书本。\n", me);
    message_vision("$N忙将书本塞入怀中。\n", me);
    ob = new(__DIR__ "obj/xojh-book");
    ob->move(me);
    ob = new(__DIR__ "obj/box");
    ob->move(environment(me));
    add("book_count", -1);
    return 1;
  } else
    message_vision("\n$N胡乱撬开几块砖，结果什么也没发现。\n", me);
  return 1;
}
int do_zhuan(string arg) {
  object me;
  me = this_player();
  if ((!arg) || (!(arg == "jian" || arg == "sword" || arg == "剑")))
    return notify_fail("你要转什么？\n");
  message_vision("$N转动了一下挂在墙上的剑。\n", me);
  message_vision("只听随着轰隆隆的声响，$N面前打开了一道密门。\n", me);
  set("exits/north", __DIR__ "mishi");
  remove_call_out("close");
  call_out("close", 10, this_object());
  return 1;
}
void close(object room) {
  message("vision", "只听随着轰隆隆的声响，密门缓缓地关起了。\n", room);
  room->delete("exits/north");
}
int valid_leave(object me, string dir) {
  if (me->query_temp("marks/移"))
    me->delete_temp("marks/移");
  return ::valid_leave(me, dir);
}
