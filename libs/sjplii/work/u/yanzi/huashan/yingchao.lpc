// Room: /u/yanzi/huashan/yingchao.c

inherit ROOM;

void create() {
  set("short", "[1;36m鹰巢[2;37;0m");
  set("long", @LONG
这是个在悬崖之上的迎客松，上面有个鹰巢，一只英武的雄鹰守
在这里，似乎在守护着什么东西。
LONG
  );
  set("exits", ([]));
  set("no_clean_up", 0);
  set("objects", ([ /* sizeof() == 1 */
    __DIR__ "npc/shenying": 1,
  ]));
  set("egg_count", 1);
  setup();
}
void init() {
  add_action("do_climb", "climb");
  add_action("do_tao", "tao");
}
int do_climb(string arg) {
  object me = this_player();

  if (!arg || arg != "up") return notify_fail("你要往哪里爬？\n");
  if (me->is_fighting()) return notify_fail("你正在战斗中。\n");
  message_vision("$N费尽力气，终于沿着崖壁爬了上去。\n", me);
  me->move(__DIR__ "dongfeng");
  message("vision", me->name() + "突然从山峰下爬了上来。\n", environment(me), me);
  return 1;
}
int do_tao(string arg) {
  object me, ob;
  me = this_player();

  if ((!arg) || (!(arg == "chao" || arg == "巢" || arg == "鹰巢")))
    return notify_fail("你要掏哪里？\n");
  if (query("egg_count") < 1)
    return notify_fail("你往巢里掏了掏，但什么也没有发现。\n");
  message_vision("$N往巢里掏了掏，结果掏出了枚鸟蛋。\n", me);
  add("egg_count", -1);
  ob = new(__DIR__ "obj/egg");
  ob->move(me);
  return 1;
}
