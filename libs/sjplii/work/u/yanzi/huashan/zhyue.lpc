inherit ROOM;

void create()
{
	set("short", "[1;36m镇岳宫[2;37;0m");
	set("long", @LONG
镇岳宫倚壁而构，是华山上众建筑物的中心，取其镇守西岳之意
，这里四边松林蔽日，景色十分幽美。宫前还有一口玉井。西面有个
小茶铺，欲登东峰观日出的游客，大都在那里歇脚喝茶，东侧乃是华
山派的总处，寻常旅客最好别去招惹。
LONG
	);
	set("no_clean_up", 0);
	set("exits", ([ /* sizeof() == 5 */
  "west" : __DIR__"chapu",
  "northeast" : __DIR__"road5",
  "east" : __DIR__"xiaoj1",
  "south" : __DIR__"road6",
  "north" : __DIR__"lianhua",
]));
	set("outdoors", "huashan");
	set("objects", ([ /* sizeof() == 1 */
	__DIR__"npc/oop" : 1,
	__DIR__"npc/luo" : 1,
]));
	set("valid_startroom", 1);

	setup();
//	__DIR__"huashan_b"->foo();
	call_other( "/obj/board/huashan_b", "???" );

}
void init()
{
	add_action("do_pflist", "pflist");
}
int valid_leave(object me,string dir)
{
	object ob;
	if(me->query("class") == "xiaoyao" )
		return ::valid_leave(me,dir);
       	else if(dir=="east" && present("oop",environment(me)) 
	&& me->query("family/family_name")!= "华山派")
		return notify_fail("闪电客一手拦住，说道：“此乃我华山禁地，请勿擅入”\n");
	return ::valid_leave(me,dir);
}
int do_pflist()
{
	object me;
	string msg1,msg2,msg3;
	int exp1,exp2,exp3;
	me = this_player();
	exp1 = (int)me->query("perform/huashan/taiyue",1);
	exp2 = (int)me->query("perform/huashan/yujian",1);
	exp3 = (int)me->query("perform/huashan/swordgod",1);
	if (exp1 < 1000)  msg1 = "☆☆☆\n";
	else if (exp1 < 2000)  msg1 = "★☆☆\n";
	else if (exp1 < 3000)  msg1 = "★★☆\n";
	else msg1 = "★★★\n";
	if (exp2 < 1000)  msg2 = "☆☆\n";
	else if (exp2 < 2000)  msg2 = "★☆\n";
	else msg2 = "★★\n";
	if (exp3 < 1000)  msg3 = "☆☆☆\n";
	else if (exp3 < 2000)  msg3 = "★☆☆\n";
	else if (exp3 < 3000)  msg3 = "★★☆\n";
	else msg3 = "★★★\n";
	tell_object(me,"你现在所会的华山绝技：\n");
	tell_object(me,"太岳三青峰(perform sword.taiyue)          " + msg1);
	tell_object(me,"以气驭剑  (exert yujian)                  " + msg2);
	tell_object(me,"剑神决    (exert swordgod)		  " + msg3);
	return 1;
}