// Room: /u/yanzi/huashan/dongfeng.c

inherit ROOM;
#include <ansi.h>;

void create()
{
	set("short", HIC"东峰"NOR);
	set("long", @LONG
华山乃是神州九大观日处之一。华山的观日之处便在这东峰，因
而东峰也就被称为朝阳峰。而朝阳台更是最佳地点。这里四面如削。
    当你清晨站在此处，东望群山，日吐万丝，霞光普照，山岭、松
林无不染上金黄的色彩，大地同时七色交织，五彩缤纷。
    另据人所说，在东峰有一只千年神雕，但从没有人见过，不知是
真是假。
LONG
	);
	set("outdoors", "huashan");
	set("no_clean_up", 0);
	set("exits", ([ /* sizeof() == 1 */
  "westdown" : __DIR__"moon",
]));

	setup();
}
void init()
{
	add_action("do_climb", "climb");
} 
int do_climb(string arg)
{
	object me = this_player();
	int sk,kar;
	sk = (int)me->query_skill("dodge", 1);
	kar = (int)me->query("kar");
	if(kar > 40) kar = 40;

	if( !arg || arg!="down" ) return notify_fail("你要往哪里爬？\n");
	message_vision("$N小心翼翼地沿着崖壁爬了下去。\n",me);
/*	if ( sk > 100 && (random(10) < 5-kar/10) ) {
	tell_object(me,"你一不小心，从崖壁上跌入了万丈深渊！\n");
	me->move(__DIR__"chi");
	tell_object(me,"迷迷糊糊中，你只觉一阵刺骨的冰凉席卷全身，似乎是掉进了水里。\n");
	me->unconcious();
	message("vision","只见一个人突然从空中跌了下来，扑通一声，掉入水中！\n",environment(me),me);
	return 1;
	}*/
	if(sk > 100){
	me->move(__DIR__"yingchao");
	return 1;
	}
	else if ( sk < 30 && (random(10) < 5-kar/10) ) {
	message_vision("$N一个不小心，从崖上跌了下去。\n",me);
	me->move(__DIR__"yingchao");
	message("vision","只见一个人突然从空中跌了下来，想必是活不成了！\n",environment(me),me);
	me->die();
	CHANNEL_D->do_channel(this_object(), "rumor",
        	sprintf("%s摔下华山死了。", me->name())); 
	return 1;
	}
	else 
	return notify_fail("你爬了一半，一不小心差点掉下去，吓得你又爬了上来。\n");
}
