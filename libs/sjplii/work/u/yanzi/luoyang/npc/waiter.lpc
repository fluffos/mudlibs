// waiter.c
inherit NPC;
inherit F_VENDOR;
#include <ansi.h>;

object obj;

void create() {
  set_name("伙计", ({ "waiter", "huoji" }));

  set("age", 34);
  set("long", @LONG
一个约三十出头的伙计，正站在这里招呼客人，其身后就是厨房，现
做现卖，保证新鲜。你可以用list看有些什么可以买的，如果你要买
某种食物，只要说(say) 出菜名就可以了。
LONG
  );

  setup();
}

void init() {
  add_action("do_list", "list");
  add_action("do_say", "say");
}
int do_list() {
  string msg;
  msg = "\n" +
    "如果你要买某种食物，只要说(say) 出菜名就可以了\n" +
    "本店供应以下外卖食物：\n" +
    "　名字                 价格(文)\n" +
    "烤鸡腿(jitui)           30/根\n" +
    "包子(baozi)             15/个\n" +
    "红酒(wine)              20/袋\n" +
    "清水(water)             15/壶\n";
  tell_object(this_player(), msg);
  return 1;
}

int do_say(string arg) {
  object me, ob, coin, silver, gold;
  int value;
  me = this_player();
  ob = this_object();
  coin = present("coin_money", me);
  silver = present("silver_money", me);
  gold = present("gold_money", me);

  switch (arg) {
    case "烤鸡腿":
    case "jitui":
      message_vision(WHT "$N说道：" + arg + "\n" NOR, me);
      obj = new("/obj/example/chicken_leg");
      break;
    case "包子":
    case "baozi":
      message_vision(WHT "$N说道：" + arg + "\n" NOR, me);
      obj = new("/obj/example/dumpling");
      break;
    case "红酒":
    case "wine":
      message_vision(WHT "$N说道：" + arg + "\n" NOR, me);
      obj = new("/obj/example/wineskin");
      break;
    case "清水":
    case "water":
      message_vision(WHT "$N说道：" + arg + "\n" NOR, me);
      obj = new("/u/yanzi/luoyang/food/cai_other/shuihu");
      break;
    default:
      return 0;
  }
  value = (int)obj->query("value");
  if (coin && (int)coin->query_amount() > value) {
    message_vision("$N给了$n些钱。\n", me, ob);
    coin->add_amount(-value);
  } else if (silver) {
    message_vision("$N拿了一两银子给$n。\n", me, ob);
    message_vision("$N找了$n些钱。\n", ob, me);
    silver->add_amount(-1);
    if (coin)
      coin->add_amount(100 - value);
    else {
      coin = new("/obj/money/coin");
      coin->move(me);
      coin->set_amount(100 - value);
    }
  } else if (gold) {
    command("say 这个......大爷只有金子，我可找不开呀。\n");
    return 1;
  } else {
    message_vision("$N白了$n一眼：没钱，想白吃啊！\n", ob, me);
    return 1;
  }
  command("say " + obj->name() + "是吧，马上就来。\n");
  message_vision("$N对着厨房喊道：" + obj->name() + "一份。\n", ob);
  message_vision("$N对$n说到：请稍候，马上就到。\n", ob, me);
  remove_call_out("shangfood");
  call_out("shangfood", 5);
  return 1;
}
void shangfood() {
  if (!this_player() || environment(this_player()) != environment()) {
    command("say 咦？刚刚那位客官人呢？怎麽付了钱人又不见了...");
    message_vision("$N把端出来的" + obj->name() + "又端了回去。\n", this_object());
    return;
  }
  command("say 客官，你的" + obj->name() + "来了。");
  obj->move(this_player());
  return;
}
