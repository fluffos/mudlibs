#include <weapon.h>

inherit SWORD;

void create()
{
    set_name("飞云袖底剑", ({ "feiyun sword", "sword" }) );
	set_weight(1000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "把");
		set("value", 100);
		set("objattrib", "short");
		set("material", "steel");
        set("long", "这是一把宝剑，隐含神秘力量。\n");
        set("wield_msg", "$N拿出一把别致的$n，握在手中。\n");
		set("unequip_msg", "$N放下手中的$n。\n");
	}
    init_sword(100);
	setup();
}
