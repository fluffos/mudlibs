inherit NPC;
 
void create()
{
        set_name("小芳", ({ "xiaofang","fang" }) );
	set("title", "侍女" );
        set("gender", "女性" );
        set("age", 20);
	set("str", 24);
        set("long", @long
她看起来成熟中带有一些韵味。束着一根大辫子，
十分迷人。
long
);
        set("combat_exp", 100000);
	set("attitude", "friendly");
        set_skill("unarmed",100);
        set_skill("dodge", 100);
        set_skill("snow-dance", 100);
        set_skill("tldw-shi", 100);
        set_skill("force",100);
        map_skill("dodge","snow-dance");
        map_skill("unarmed","tldw-shi");
        set("force", 500);
        set("max_force", 500);
	 set("inquiry", ([
        "玉女洞" : "听说玉女洞里藏着一把千古神器和一本九阴真经。\n",
 	"倚天剑" : "好象是藏在一个箱子里。\n",
        "箱子" : "祖师婆婆把它放在玉女洞里，可是我找不到 \n",
	
         ]));

       create_family("古墓派",3,"弟子");
        setup();
         carry_object(__DIR__"obj/flower_boot")->wear();
}

