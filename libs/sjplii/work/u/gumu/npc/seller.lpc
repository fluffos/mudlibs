// seller.c

inherit NEW_VENDOR;
int i=0; 

void create()
{
        set_name("商人", ({ "seller" }) );
        set("gender", "男性" );
        set("age", 32);
        set("long", "一看就是个善于精打细算的商人。\n");
        set("combat_exp", 50000);
        set("attitude", "friendly");
        set_skill("unarmed", 60);
        set_skill("dodge", 60);
        set_skill("throwing", 90);
	set("merchandise", ([
		"/obj/food/baozi"   : 50,
		"/obj/food/jitui"   : 20,
		"/obj/food/jiudai"  : 20,
		"/obj/food/kaoya"   : 20,
		"/obj/food/shuihu"  : 50,
	]));
        setup();
        add_money("silver", 5);
        add_money("coin", 300);
        carry_object("/obj/cloth")->wear();
        for(int i=1; i<=29; i++){
        carry_object("/obj/example/dart")->wield();
        }
}

void init()
{
        object ob;

        ::init();
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
        }
        add_action("do_vendor_list", "list");

        if(random(10)<5)
                carry_object("/obj/example/dart")->wield();

}

