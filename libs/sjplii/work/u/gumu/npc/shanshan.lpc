inherit NPC;


void create() {
  set_name("姗姗", ({ "shanshan" }));
  set("gender", "女性");
  set("age", 24);
  set("long", @TEXT
你一看见这个女孩，心里只有三个字：“太美了！”
TEXT
  );
  set("combat_exp", 200000);
  set_skill("unarmed", 100);
  set_skill("force", 100);
  set_skill("parry", 100);
  set_skill("dodge", 100);
  set_skill("sword", 100);
  set_skill("literate", 80);
  set("force", 1500);
  set("max_force", 1500);
  set("force_factor", 50);
  set("attitude", "peaceful");
  set_skill("beauty-force", 90);
  set_skill("beauty-sword", 90);
  set_skill("snow-dance", 90);
  set_skill("tldw-shi", 100);

  map_skill("unarmed", "tldw-shi");
  map_skill("force", "beauty-force");
  map_skill("sword", "beauty-sword");
  map_skill("parry", "beauty-sword");
  map_skill("dodge", "snow-dance");
  set("inquiry", ([
    "颜如玉": "她是掌门的得意弟子，非常信任她，听说她有把钥匙。\n",
    "玉钗": "啊，那是如玉的传家宝! \n",
  ]));

  create_family("古墓派", 2, "弟子");
  setup();
  carry_object(__DIR__ "obj/ring")->wear();
  carry_object(__DIR__ "obj/longsword")->wield();
}
void attempt_apprentice(object ob) {
  if (ob->query("betrayer") >= 1) {
    command("say 古墓派不收不忠之徒，" + RANK_D->query_respect(ob)
      + "您还是回去吧。\n");
    return;
  }
  command("smile");
  command("say 呵呵，" + RANK_D->query_respect(ob) +
    "你真有福分，欢迎你加入古墓派。\n");
  command("recruit " + ob->query("id"));
}

void recruit_apprentice(object ob) {
  if (::recruit_apprentice(ob))
    ob->set("class", "gumu");
}
