inherit NPC;
string reward_more( object who);
int do_detect(object ob);
 
void create()
{
        set_name("石人", ({ "stone man","stone" }) );
        set("gender", "男性" );
        set("long", @TEXT
这是一个会活动的石头人，手脚关节处都装了机关，可以按规律摆动。
TEXT
);
       set("str", 30);
       set("class", "oldtomb");
       set("water", 200);
	set("no_get",1);
       set("combat_exp", 100000);
        set_skill("unarmed", 100);
        set_skill("dodge", 100);
        set_skill("force",50);
        set("force", 5000);
        set("max_force", 5000);
	set("chat_chance", 30);
        set("chat_msg", ({
                (: do_detect :),
        }) );
        set("chat_chance_combat", 50);
        set("chat_msg_combat", ({
		(: reward_more(this_object()) :),
        }) );
        setup();
}
int do_detect(object ob)
{
	string str;
	object stones;
	ob = this_object();
	if ( ob->query("water") < 1)
	{
	say("石人哗啦啦一声倒了下来，变成了一堆碎石头。\n");
	stones=new("/u/gumu/obj/stones");
	stones->move(environment(ob));
	destruct(ob);
	return 1;
	}
return 1;
}

string reward_more(object who)
{
	int i;
	object *enemy;
	seteuid(getuid());
	enemy = who->query_enemy();
	i = sizeof(enemy);
	while(i--) {
		if( enemy[i] && living(enemy[i]) ) {
			if( enemy[i]->query("potential") > random(200)*1000 ) return "1";
			enemy[i]->add("potential", 1);
		}
	}
	return "1";
}
int accept_fight(object me)
{
	if( this_object()->query("sen")< 10 )
	{
	say("这个石人已经被打坏，不能动弹了。\n");
	return 0;
	}
	if( me->query("class")=="oldtomb" )
	this_object()->set("str", 15);
	else
	this_object()->set("str", 40);
        return 1;
}

void die()
{
	object stones;
	say("石人哗啦啦一声倒了下来，变成了一堆碎石头。\n");
	stones=new("/u/gumu/obj/stones");
	stones->move(environment(this_object()));
	destruct(this_object());
}
