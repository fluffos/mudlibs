#include <room.h>

inherit ROOM;
int th=0;

void create()
{
   set("short", "密室");
	set("long", @LONG
这里是一间密室，古墓派象个迷宫，到处是机关和密室。
这里又是哪里呢？你闻到一股臭味，伸手一摸......哇，好象
是一具骷髅(skeleton)。真是晦气！
LONG
	);

	set("item_desc", ([
		"skeleton" : "一具干枯了的骷髅，好象里面有什么东西。\n"
			
	]) );
  set("no_clean_up", 0);
       setup();
     
}

void init()
{
        add_action("do_search", "search");
        add_action("do_climb", "climb");
      
}
int do_search(string arg)
{
     object ob,me;
     me=this_player();
	
     if(arg=="骷髅") {
           if( th == 0 ) {
	        printf("你从骷髅里拿出一块丝绢。\n");
	        ob = new(__DIR__"book/dodge2");
	        ob->move(this_player());
	        th = 1; }
            else printf("你找了一会儿，什么也没发现。\n");
	     return 1;	

	}
}
int do_climb()
{
       message_vision( "$N试了试密室的高度，往上爬。\n", this_player() );
	this_player()->move(__DIR__"path3");
       message_vision( "$N从下面爬了上来。\n", this_player() );
	return 1;
}
