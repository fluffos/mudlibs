inherit ROOM;
int thing = 0;

void create()
{
	set("short", "黑洞");
	set("long", @LONG
这里一片黑漆漆的，伸手不见五指，你什么都看不见。你只能
依稀的辨别出方向。
LONG
	);
	set("exits", ([ /* sizeof() == 4 */
  "southeast" : __DIR__"dark8",
  "west" : __DIR__"dark10",
  "east" : __DIR__"dark12",
  "southwest" : __DIR__"dark7",
]));
	set("no_clean_up", 0);

	setup();
}
void init()
{
        add_action("do_search", "search");
     
}
int do_search(string arg)
{
 	object ob,me;
        me=this_player();
	  if( thing == 0 ) {
       message_vision( "$N在地上摸索了半天，找到一根玉钗。\n", this_player() );
	  ob = new(__DIR__"obj/clasp");
	  ob->move(this_player());
     	  thing = 1; }
	 else printf("你找了半天，什么都没有。\n");
	return 1;
}