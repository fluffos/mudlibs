inherit ITEM;

void create() {
  set_name("丝绢", ({ "silk", "book" }));
  set_weight(50);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "块");
    set("long", "一块漂亮的丝绢，不会只是用来擦汗的吧。\n");
    set("value", 500);
    set("material", "silk");
    set("skill", ([
      "name": "dodge",
      "exp_required": 0,
      "sen_cost": 10,
      "difficulty": 10,
      "max_skill": 40
    ]));
  }
}
