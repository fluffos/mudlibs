
inherit COMBINED_ITEM;

void create()
{
        set_name("梦游丹",({"dreampill"}));
        set("long",
                "这是一颗神奇的药丸，只要用一颗就可以\n");
        set("value", 200000);
        set("unit", "颗");
        set("base_unit", "粒");
        set("base_weight", 1);
        set_amount(1);
}

void init()
{
        if( this_player()==environment() )
                add_action("do_eatpill", "eatpill");
		add_action("do_eatpill", "ep");
}

int do_eatpill()
{
	this_player()->set_skill("force", 162);	
	    message_vision(
                "$N吃下一颗梦游丹，只觉一阵天旋地转。.\n",this_player());
	   return 1;
}

