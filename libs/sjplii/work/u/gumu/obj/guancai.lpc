#include <ansi.h>
inherit ITEM;

void create()
{
    set_name("石棺", ({ "guancai" }) );
    set("unit", "块");
    set("long","这是一口灰石棺材，棺盖虚掩，里面死气沉沉不知是些什么。\n");
    set_weight(300000);
    set("no_get",1);
}
void init()
{
        add_action("do_openit", "open");
}
int do_openit(string arg)
{
	object tudi;
	object me=this_player(),room;
        if( arg != "guancai" ) return 0;
	if (objectp(present("stone man", environment(this_object()))) )
	 return notify_fail
		("棺材是空的，里面什么也没有。\n");
	if (objectp(present("stone man", environment(me))) )
	 return notify_fail
		("棺材是空的，里面什么也没有。\n");
	if (objectp(present("stone piece", environment(me))) )
	 return notify_fail
		("棺材是空的，里面什么也没有。\n");
	seteuid(getuid());
	tudi= new("/u/gumu/npc/stoneman");
	tudi->move(environment(me));
        message_vision(HIC"$N用力掀起" + this_object()->name() + "的棺盖。\n"NOR, me);
	message_vision(HIW "\n只听嘎吱吱一阵响，突然从棺材里站起一个$N！\n" NOR, tudi);
        return 1;
}
