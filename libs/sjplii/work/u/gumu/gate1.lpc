// Room: /u/oldtomb/GATE1.c

inherit ROOM;

void create()
{
	set("short", "古墓");
	set("long", @LONG
你穿过树林，一个巨大的山洞矗立在你的面前。洞口立着个
石碑(stele)，上面好象写着几个字。在山上的乡间野外出现这么
大的山洞，使你觉得有些突兀。看来你应该小心一点了。
LONG
	);
	set("item_desc", ([ /* sizeof() == 1 */
  "stele" : "石碑上几个娟秀的字迹写著：
[41m[1;37m非请莫入 
擅入者死 
[2;37;0m",
]));
	set("objects", ([ /* sizeof() == 1 */
  __DIR__"npc/sparrow" : 2,
]));
	set("outdoors", "oldtomb");
	set("exits", ([ /* sizeof() == 1 */
  "westup" : __DIR__"shan4road1",
]));
	set("no_clean_up", 0);

	setup();

}
void init()
{
      
        add_action("do_enter", ({"enter","zuan"}) );
}
int do_enter(string arg)
{
       message_vision( "$N伏下身子，从洞口钻了进去。\n", this_player() );
	this_player()->move(__DIR__"channel");
       message_vision( "$N钻了进来。\n", this_player() );
	return 1;
}