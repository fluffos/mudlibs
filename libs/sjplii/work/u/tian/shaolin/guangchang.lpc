inherit ROOM;

void create()
{
        set("short", "前广场");
        set("long", @LONG
拾阶而上来到“少林寺”的门前广场，皆由大块青石铺就，宽敞
平整，足足可容纳五、六百人。两边苍松翠柏，凛然肃穆。广场上有
几个年轻僧人正在扫地(saodi)。
LONG
        );
        set("exits", ([/* sizeof() == 2 */
            "north" : __DIR__"simen",
            "southdown" : __DIR__"taijie3",
]));
	set("objects", ([
	__DIR__"npc/saodiseng": 1 ,
]) );

	set("outdoors","shaolin");
        set("no_clean_up", 0);

        setup();
}

void init()
{
      	add_action("do_saodi1", ({"saodi"}));
}


int do_saodi1()
{
	object me = this_player(),ob;
	int nn,skill_n,kee_cost;

	if(me->query("class")!="shaolin1" && me->query("class")!="shaolin") return 0;
	if(!(ob=present("saoba",me))) return 0;
	seteuid(getuid());
	if(me->query("id")!=ob->query("own_name")) {
		printf("这不是你的东西，你不能用!\n");
		return 1;
	}
	if(!(ob = me->query_temp("weapon") ) ){
		message_vision("$N蹲在地上用双手乱扫一阵，弄的一手土，好象没有什么效果。\n",me);
		return 1;
	}
	if( ob->query("name") == "大扫把" ){
		if( me->query_temp("sleeping") )
			return notify_fail("你正在睡眠中，不能干别的。\n");
		if( me->query_temp("dazuo") )
			return notify_fail("你正在打坐练功，不能干别的。\n");
		if( me->is_fighting() )
			return notify_fail("你已经在战斗中了，专心点吧。\n");

		kee_cost=40+(30-me->query("int"));
		if (kee_cost<1) kee_cost=1;
		if( me->query("kee") < kee_cost) 
			return notify_fail("休息一下吧，你现在太累了。\n");
		me->receive_damage("kee", kee_cost);
		if(me->query("shaolin/renwu_type")!="扫地"){
			if(me->query_skill("parry",1)>20)
				return notify_fail("你认真扫了一遍地，发现对你已没什么用了。\n");
			skill_n=me->query_skill("parry",1);
			if(skill_n*skill_n*skill_n/10 >me->query("combat_exp")) 
				return notify_fail("也许是缺乏经验吧，你认真扫了一遍地，好象没有什么收获。\n");
			message_vision("$N认真扫了一遍地，好象学到什么。\n", me);
			nn=(me->query("int")-20);
			if(nn<1) nn=1;
			me->improve_skill("parry",nn,0);
			return 1;
		}
		else {
			if(me->query("shaolin/renwu_nn")==0) 
				return notify_fail("你已经完成任务，快回去汇报吧。\n");
			me->add("shaolin/renwu_nn",-1);
			if(random(me->query("kar"))>13){
				me->add("combat_exp", 10);
				me->add("potential", 5);
			}
			return notify_fail("你认真扫了一遍地。\n");
		}
	}
	else {
		message_vision("有没有搞错？看清楚你手里拿的是什么？\n", me);
		return 1;
	}
	return 0;
}

