inherit ROOM;

void create()
{
        set("short", "小路");
        set("long", @LONG
你走在一条狭窄的小路上。前面树林更加密了，光线也越来越暗，
不知道前面是什么地方，还是回头吧。
LONG
       );
        set("exits", ([/* sizeof() == 2 */
            "southwest" : __DIR__"xiaolu9",
            "east" : __DIR__"xiaolu5",
]));

        set("no_clean_up", 0);
	set("outdoors","shaolin");

        setup();
        replace_program(ROOM);
}