// zoulang4  走廊

#include <room.h>
inherit ROOM;

void create() {
  set("short", "走廊");
  set("long", @LONG
你走在一条走廊上，走廊上面雕梁画柱，画着一些佛家的故事。
北面是戒律院，这可是少林弟子最害怕的地方，你走到这里大气也
不敢喘。西面是几间武僧舍,东面是走廊,
LONG
  );

  set("exits", ([
    "east": __DIR__ "zoulang3",
    "west": __DIR__ "wsshe5",
    "north": __DIR__ "jlyuan",
  ]));

  setup();
  replace_program(ROOM);
}
