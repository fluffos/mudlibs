//fzshi 方丈室
inherit ROOM;

void create()
{
        set("short", "方丈室");
        set("long", @LONG
这里就是少林寺方丈空见大师的起居室，空见大师平时都在此
入定静修。右面靠墙有一张木床，床头有个柜子，左面一张木桌一
把椅子，是空见大师研读佛经的地方。墙上一幅字，看来是空见大
师手笔。屋中间摆个蒲团，空见大师正在上面闭目打坐。墙角有把
禅杖，是少林方丈的身份象征。
LONG
        );
        set("exits", ([/* sizeof() == 1 */
           "south"  : __DIR__"caoshe",
]));
	set("objects",([
	__DIR__"npc/kongjian" : 1,
	]));

	set("item_desc",([
	"墙上的字":"淡泊致远。\n",
	]));

        set("no_clean_up", 0);

        setup();
        replace_program(ROOM);
}