inherit ROOM;

void create() {
  set("short", "碑林");
  set("long", @LONG
此处已到山腰，只见树木森森，荫着一片碑林。石碑饱经风雨，
大都字迹模糊，难以辨认。
LONG
  );

  //其中有块大石碑较为完整，刻着一些字。

  set("exits", ([ /* sizeof() == 2 */
    "east": __DIR__ "taijie1",
    "northwest": __DIR__ "taijie2",
  ]));

  set("item_desc", ([ /* sizeof() == 1 */
    "石碑": "一片碑林，十几块石碑，其中有块大石碑较为完整。\n",
    "大石碑": "一块大石碑，上面记述了唐高宗皇帝驾临少林寺的盛大场面。\n",
  ]));


  set("no_clean_up", 0);
  set("outdoors", "shaolin");

  setup();
}

void init() {
  add_action("do_use", ({ "use" }));
}

int do_use(string arg) {
  object ob, me = this_player();
  string sth, sb;

  if (me->query("class") != "shaolin" && me->query("class") != "shaolin1") return 0;
  if (!arg) return 0;
  if (sscanf(arg, "%s to %s", sth, sb) != 2) return 0;
  if (sb != "石碑" || sth != "白纸") return 0;
  if (!(ob = present("bai zhi", me))) return 0;
  destruct(ob);
  if (random(me->query("kar")) < 19) {
    printf("你把白纸仔细地盖在石碑上，可不小心把纸戳破了。\n");
    return 1;
  }

  write("你把白纸仔细地盖在石碑上，一点一点把碑文拓下来。\n");
  write("你得到一张碑文的拓片。\n");
  ob = new(__DIR__ "obj/beita");
  ob->set("own_name", me->query("id"));
  ob->move(this_player());
  return 1;
}
