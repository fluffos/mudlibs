//ding-mishi.c 峰顶密室

#include <room.h>
inherit ROOM;

void create()
{
	set("short", "石室");
	set("long", @LONG
这是个挺大的石室，墙上燃着一个松明灯，石室的角上有个石台，
光线虽暗，还是可以看清上面坐着一个老年僧人。
    环顾四周没有其他出口，只有头顶的青石。
LONG
	);
	set("objects",([
	__DIR__"npc/xuanbei" : 1,
	]));

    set("no_clean_up", 0);

    setup();
//    replace_program(ROOM);

}

void init()
{
	add_action("do_push", ({"push"}));
}

int do_push(string arg)
{
	object ob,me=this_player();

	if(arg != "青石") return 0;
	if(me->query("class")!="shaolin"||me->query("kar")<30) return 0;
	if(me->query("family/generation")>4) return 0;
	if(me->query_skill("unarmed",0)<200||me->query_str()<120) {
		write("你两手向上用力推青石，可是怎么也推不动！\n");
		return 1;
	}
	else {
		write("你两手向上用力一推青石，把大青石推到一边！\n");
		write("露出了圆圆的洞口，你纵身跃了出去。\n");
		ob=(object)__DIR__"dingfeng";
		tell_room(ob,me->query("name")+"走了过来。\n");
		me->move(ob);
		tell_room(this_object(),me->query("name")+"往上纵身一跃，离开了。\n");
		return 1;
	}
}
