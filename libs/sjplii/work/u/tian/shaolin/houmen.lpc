//houmen  后门
inherit ROOM;
#include <room.h>

void create()
{
        set("short", "后门");
        set("long", @LONG
这是少林寺的后门。一扇小门，平时总是紧闭着，高高的围墙，青
砖砌成。抬眼北望是高高的少室山顶峰。
LONG
        );
        set("exits", ([/* sizeof() == 2 */
           "south" : __DIR__"xiaoyuan6",
//           "north" : __DIR__"xiaolu3",
]));

        set("no_clean_up", 0);
//		create_door("north", "小木门", "south", DOOR_CLOSED);
	set("outdoors","shaolin");

        setup();
//        replace_program(ROOM);
}

void init()
{
    add_action("do_open", ({"open"}) );
}
 
int do_open(string arg)
{
    object ob;
    if(!arg) return notify_fail("你要打开什么?\n");
    if(arg != "door")return 0;
    if( present("tie key", this_player()) ){
		message_vision("$N用钥匙把小门打开\n", this_player());
        set("exits/north", __DIR__"xiaolu3");
        return 1;
    }
    else     return notify_fail("门是锁着的!\n");
}

int valid_leave(object ob,string exit)
{
    if( query("exits/north") ){
       message_vision("$N把小门关上.\n ", this_player());
       delete("exits/north");
    }
    return 1;
}
