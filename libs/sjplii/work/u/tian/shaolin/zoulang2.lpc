// zoulang2.c 东走廊

#include <room.h>
inherit ROOM;

void create() {
  set("short", "东走廊");
  set("long", @LONG
你走在一条走廊上，东面是斋院，飘来阵阵的饭菜香，你的肚子
不由的咕咕做响，西面是大成殿前广场，南北两边是僧舍，有一些少
林弟子进进出出，看起来挺忙碌。
    走廊修建的很精致，只是年代已久，有些地方彩漆已经剥落。有
几个僧人正在这里刷漆(shuaqi)。
LONG
  );

  set("exits", ([
    "east": __DIR__ "zhaiyuan",
    "south": __DIR__ "sengshe1",
    "west": __DIR__ "guangchang1",
    "north": __DIR__ "sengshe2",
  ]));
  set("objects", ([
    __DIR__ "npc/xiaoseng": 1,
  ]));


  setup();
}

void init() {
  add_action("do_shuaqi", ({ "shuaqi" }));
}


int do_shuaqi() {
  object me = this_player(), ob;
  int nn, skill_n, kee_cost;

  if (me->query("class") != "shaolin1" && me->query("class") != "shaolin") return 0;
  if (!(ob = present("shuazi", me))) return 0;
  seteuid(getuid());
  if (me->query("id") != ob->query("own_name")) {
    printf("这不是你的东西，你不能用!\n");
    return 1;
  }
  if (!(ob = me->query_temp("weapon"))) {
    message_vision("$N两手在走廊柱子上摸了摸，想干什么呀？\n", me);
    return 1;
  }
  if (ob->query("name") == "刷子") {
    if (me->query_temp("sleeping"))
      return notify_fail("你正在睡眠中，不能干别的。\n");
    if (me->query_temp("dazuo"))
      return notify_fail("你正在打坐练功，不能干别的。\n");
    if (me->is_fighting())
      return notify_fail("你已经在战斗中了，专心点吧。\n");

    kee_cost = 40 + (30 - me->query("int"));
    if (kee_cost < 1) kee_cost = 1;
    if (me->query("kee") < kee_cost)
      return notify_fail("休息一下吧，你现在太累了。\n");
    me->receive_damage("kee", kee_cost);
    if (me->query("shaolin/renwu_type") != "刷漆") {
      if (me->query_skill("dodge", 1) > 30)
        return notify_fail("你爬到走廊柱子上刷了一遍漆，发现对你已没什么用了。\n");
      skill_n = me->query_skill("dodge", 1);
      if (skill_n * skill_n * skill_n / 10 > me->query("combat_exp"))
        return notify_fail("也许是缺乏经验吧，你爬到走廊柱子上刷了一遍漆，好象没有什么收获。\n");
      message_vision("$N爬到走廊柱子上刷了一遍漆，好象学到什么。\n", me);
      nn = (me->query("int") - 20);
      if (nn < 1) nn = 1;
      me->improve_skill("dodge", nn, 0);
      return 1;
    } else {
      if (me->query("shaolin/renwu_nn") == 0)
        return notify_fail("你已经完成任务，快回去汇报吧。\n");
      me->add("shaolin/renwu_nn", -1);
      if (random(me->query("kar")) > 13) {
        me->add("combat_exp", 10);
        me->add("potential", 5);
      }
      return notify_fail("你爬到走廊柱子上刷了一遍漆。\n");
    }
  } else {
    message_vision("有没有搞错？看清楚你手里拿的是什么？\n", me);
    return 1;
  }
  return 0;
}
