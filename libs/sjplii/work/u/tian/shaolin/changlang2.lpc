// changlang2  长廊

#include <room.h>
inherit ROOM;

void create()
{
	set("short", "长廊");
	set("long", @LONG
你走在一条长廊上，架上青藤缠绕，紫色的小花散发着淡淡的清香。
东西两面是长长的走廊，北面是证道院。
LONG
	);

	set("exits", ([
		"east" : __DIR__"changlang1",
		"west" : __DIR__"changlang3",
            "north": __DIR__"zdyuan",
	]));
	
	setup();
	replace_program(ROOM);
}
