//qiaobi3.c

inherit ROOM;

void create()
{
        set("short", "平台");
        set("long", @LONG
这是峭壁中间的一个小小的平台，地上还有些白骨，显然是一些冒险者的遗骨。
抬头向上望去，两丈高的地方长着一棵松树，虽然不大，但很粗壮，你心里一阵
后怕，刚才没有着棵松树挡了一下，你现在就已经去见黑白无常了。
LONG
);
	set("exits", ([ /* sizeof() == 1 */
    ]));
		set("item_desc",([
			"峭壁" :"是一个万丈峭壁，往下一看云雾缭绕，深不可测。\n",
			"白骨" :"白骨散落在地上，遭受风吹日晒，一碰就碎了。\n",
		]));

        set("no_clean_up", 0);

        setup();
//        replace_program(ROOM);
}

void init()
{
	add_action("do_climb", ({"climb","pa"}));
	add_action("do_search", ({"search","zhao"}));
	add_action("do_use", ({"use"}));
}

int do_search(string arg)
{
	object ob,me=this_player();

	if(arg != "白骨") return 0;
	if(query("zhao")==1) 	
		return notify_fail("这里只有些白骨，没有别的。\n");
	set("zhao", 1);
	message_vision("$N从地上找到什么东西。\n",this_player());
	ob = new( __DIR__"obj/kaishanfu");
	ob ->move(me);
	return 1;
}

int do_use(string arg)
{
	object ob,me=this_player();
	string sb,sth;

	if (!arg) return 0;
	if( sscanf(arg, "%s to %s", sb, sth)!=2 ) 
		return notify_fail("指令格式： use <某物> to <某处>\n");
	if(sb == "开山斧"&&sth=="峭壁") {
		if(!present("kaishan fu",me)) return 0;
		if(query("kan")==1){
			message_vision("$N挥动手中的开山斧，在峭壁上砍了半天，可是石壁太坚硬了，砍不动。\n",me);
			return 1;
		}
		set("kan",1);
		message_vision("$N挥动手中的开山斧，在峭壁上砍了几个凹坑。\n",me);
		return 1;
	}
	if(sb == "绳子"&&sth=="松树") {
		if(!ob=present("shengzi",me)) return 0;
		if(me->query("id")!=ob->query("own_name")) {
			printf("这不是你的东西，你不能用!\n");
			return 1;
		}
		if(query("sheng")==1)
			return notify_fail("绳子不是已经挂在松树上了吗？\n");
		if(query("pa")==0){
			message_vision("$N甩着手里的绳子，可是差一点，就是够不着松树。\n",me);
			return 1;
		}
		else {
			message_vision("$N一手扣着凹坑，一手猛的一甩手里的绳子，正好挂在松树上。\n",me);
			destruct(ob);
			set("sheng",1);
			return 1;
		}
	}
	return 0;
}

int do_climb(string arg)
{
	object ob,me=this_player();

	if(!arg) return 0;
	if(arg=="凹坑"){
		if(query("pa")==0){
			message_vision("$N用手扣着峭壁上砍出来的凹坑，小心翼翼地向上爬去。\n",me);
			set("pa",1);
			return 1;
		}
		else 
			return notify_fail("上面已经没有凹坑了。\n");
	}
	if(arg=="绳子"){
		if(query("sheng")==0){
			write("上面没有绳子呀！\n");
			return 1;
		}
		message_vision("$N用手抓住挂在松树上的绳子，费劲的爬了上去。\n",me);
		delete("zhao");
		delete("kan");
		delete("sheng");
		delete("pa");
		ob=(object)__DIR__"qiaobi4";
		tell_room(ob,me->query("name")+"从下面爬了上来。\n");
		me->move(ob);
		message_vision("$N弯腰把松树上挂着的绳子又解了下来。\n",me);
		ob = new(__DIR__"npc/obj/shengzi");
		ob->set("own_name",me->query("id"));
		ob->move( me );
		return 1;
	}
}

void reset()
{
	::reset();
	delete("zhao");
	delete("kan");
	delete("sheng");
	delete("pa");
}
