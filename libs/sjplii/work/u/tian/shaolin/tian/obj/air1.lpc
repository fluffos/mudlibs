// air1.c

inherit ITEM;
inherit F_AUTOLOAD;

int query_autoload() { return 1; }


void create()
{
    set_name("风之符", ({ "air plane", "air", "plane" }) );
    set_weight(100);
    set("long", @LONG 
这是一张巫师常用的符咒，使用后可瞬间到达某个地方。
使用方法：    fly 目的地        (例如： fly shaolin)
shaolin : 少林寺    sanyen :  山烟寺   hangzhou : 杭州
fuzhou  : 福州      maoshan:  茅山派   shuiyan:   水烟阁
wuhan   : 武汉      hankou :  汉口
还有一些字你没看懂。
LONG
  );
    set("value", 300);
    set("unit", "张");
    set("material", "paper");
//    set("no_drop","风之符看来无法丢弃。\n");

}

void init()
{
    add_action("do_fly", "fly");
}

int do_fly(string arg)
{
    string obj;
    if( !arg )
        return notify_fail("你想飞到哪里 ？\n");

	if( this_player()->is_fighting() )
        return notify_fail("你在战斗中，无法使用风之符。\n");
    switch(arg) {
        case "shaolin":
             obj="/u/shaolin/tulu1";
             break;
        case "sanyen":
             obj="/d/sanyen/door";
		return 1;
             break;
        case "fuzhou":
		return 1;
             obj="/u/fuzhou/entrance";
             break;
        case "hangzhou":
             obj="/new/hangzhou/inn";
             break;
        case "shuiyan":
		return 1;
             obj="/d/waterfog/entrance";
             break;
        case "maoshan":
		return 1;
             obj="/d/temple/ladder1";
             break;
        case "wuhan":
		return 1;
             obj="/ftp/upload/nomoney/wuhan/lou1";
             break;
        case "hankou":
             obj="/u/wuhan/hankou/proad1";
             break;
        default:
             return notify_fail("你不能飞到那个地方 !\n");
             return 1;

    }
    message_vision("在一阵烟幕中，只见$N的身影忽然消失了。\n", this_player());

    this_player()->move(obj);

    message_vision("$N的身影忽然在一阵烟幕中神秘地出现了。\n", this_player());

    return 1;
}

