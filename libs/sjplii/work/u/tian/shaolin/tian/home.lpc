// Room: /u/tian/home.c

inherit ROOM;
#include <ansi.h>

void create()
{

object ob;

	set("short", "田公子的实验室");
	set("long", @LONG
这是巫师田公子的实验室，摆满各种各样的仪器，还有很多奇形怪状
的物品。
    中间有一个桌子，上面有一个控制台。
LONG
	);
    set("item_desc", ([
       "桌子" :  "这是一张很大的紫色檀香木桌子.\n"  ,
	"控制台" : "一个非常先进的控制台，上面有各种按钮和一个数字键盘。\n" ,
	"数字键盘" : "上面有0-9共十个键。\n" ,
]));

	set("no_clean_up", 0);

	set("exits", ([ /* sizeof() == 1 */
                "east" : "/u/tian/shaolin/dcdian",
]));

	setup();
}


void init()
{
	object ob=this_player();

	add_action("do_press", "press");
	add_action("do_allow", "allow");
	add_action("do_noallow", "noallow");

	if(ob->query("id")!="tian"&&!query("allow/"+ob->query("id"))) {
		ob->move("/u/playboy/shaolin/dcdian");
	}	

}

int do_allow(string arg)
{
	object ob,me=this_player();

	if(me->query("id")!="tian") return 0;
	if(!arg) return 0;
	ob=find_player(arg);
	if(!ob) return notify_fail("现在没有这个人....。\n");
	set("allow/"+arg,1);
	write("你允许"+ob->query("name")+"进入你的房间。\n");
	return 1;
}

int do_noallow(string arg)
{
	object ob,me=this_player();

	if(me->query("id")!="tian") return 0;
	if(!arg) return 0;
	if(arg=="all"){
		delete("allow");
		write("你不允许任何人进入你的房间。\n");
		return 1;
	}
	delete("allow/"+arg);
	write("你不允许"+arg+"进入你的房间。\n");
	return 1;
}


int do_press(string arg)
{
	object room;
	int number;


	if( !arg || arg=="" ) return 0;
	if(arg=="按钮") {
		if( (int)query("press_ii")==3) {
			message_vision("只听“轰隆”一声，地下裂开一个大口子。\n",this_player());
			message_vision("$N惨叫一声掉了下去，半天才听到下面扑通的一声。\n",this_player());
			delete("press_ii");
			if( room = find_object(__DIR__"dilao") ) {
			message("vision", "只听上面“轰隆”一声，接着掉下一个人来，差点砸到你身上。\n",room );
			}
			this_player()->move(__DIR__"dilao");
			return 1;
		}
		message_vision("$N在按钮上乱按一通，什么也没有发生。\n",this_player());
		add("press_ii",1);
		return 1;
	}
	if(arg=="键盘") {
		write("你想按什么数字？\n");
		return 1;
	}
	if( sscanf(arg, "键盘 %d", number)==1 ) {
		message_vision("$N在键盘上按了一下。\n", this_player());
		switch(number){
		case 1: 
			if((int)query("press_right")==0) 
				set("press_right", 1);
			else { add("press_wrong",1);
				set("press_right", 9);
			}	
		break;
		case 2: 
			if((int)query("press_right")==1) 
				set("press_right", 2);
			else { add("press_wrong",1);
				set("press_right", 9);
			}	
		break;
		case 0: 
			if((int)query("press_right")==2) 
				set("press_right", 3);
			else { add("press_wrong",1);
				set("press_right", 9);
			}	
		break;
		case 5: 
			if((int)query("press_right")==3) 
				set("press_right", 4);
			else { add("press_wrong",1);
				set("press_right", 9);
			}	
		break;
		case 3: 
		case 4: 
		case 6: 
		case 7: 
		case 8: 
		case 9: 
			add("press_wrong",1);
			set("press_right",9);
		break;
		case 681205:
			set("press_right",4);
		break;
		}
//        printf("right==%d wrong=%d number=%d\n",query("press_right"),query("press_wrong"),number);

		if((int)query("press_wrong")==3) {
			message_vision("只听“轰隆”一声，地下裂开一个大口子。\n",this_player());
			message_vision("$N惨叫一声掉了下去，半天才听到下面扑通的一声。\n\n",this_player());
			delete("press_right");
			delete("press_wrong");
			if( room = find_object(__DIR__"dilao") ) {
			message("vision", "只听上面“轰隆”一声，接着掉下一个人来，差点砸到你身上。\n\n",room );
			}
			this_player()->move(room);
			return 1;
		}
		if((int)query("press_right")==4) {
			message_vision("只听一阵翁翁的响声之后，地下逐渐打开一个洞口。\n",this_player());
			message_vision("$N脚下的地面降了下去，$N也随之消失，洞口又关上了。\n\n",this_player());
			delete("press_right");
			delete("press_wrong");
			if( room = find_object(__DIR__"test") ) {
			message("vision", "一阵翁翁的响声之后，一个平台降了下来。\n",room );
			}
			this_player()->move(room);
			message_vision("$N从平台上走了下来。\n\n", this_player());
			return 1;
		}

		return 1;
	}	
}

void reset()
{
        ::reset();
	delete("press_ii");
	delete("press_right");
	delete("press_wrong");
	delete("allow");
}
 
