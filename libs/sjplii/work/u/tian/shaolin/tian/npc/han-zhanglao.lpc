inherit NPC;

void create()
{
	object ob;

	set_name("韩辛", ({ "han zhanglao","han","zhanglao" }) );
	set("gender", "男性");
	set("age", 42);
	set("max_kee",3000);
	set("kee",3000);
	set("con",32);
	set("str",40);
	set("con",32);
	set("food",1000);
	set("water",1000);
	set("int",30);
	set("str",120);
	set("long",
		"这是一个江湖中一个秘密组织---青龙会的长老，武功显然深不可测。\n");
	set("combat_exp", 1000000);
	set("score", 80000);
	set("force", 6500);
	set("max_force", 6500);
       set("force_factor",150);
       create_family("青龙会", 2, "长老");

	set("bellicosity", 300);
	set_skill("unarmed", 220);
//	set_skill("fjcg-hand", 250);
	set_skill("jiayi-force", 250);
	set_skill("parry", 250);
	set_skill("dodge", 250);
	set_skill("literate", 80);
	set_skill("sword", 250);
	set_skill("force", 250);
	set_skill("tg-force",250);
	set_skill("taiji-ken",250);
	set_skill("spells",160);
	set_skill("taoism",160);
	set_skill("necromancy",250);
	set_skill("wave-step",250);
	set_skill("fonxansword",250);
	set_skill("taiji-ken",250);
//	set_skill("dm13-sword",250);
//       map_skill("sword", "dm13-sword");
//       map_skill("parry", "dm13-sword");
       map_skill("sword", "fonxansword");
       map_skill("parry", "fonxansword");
       map_skill("force", "tg-force");
       map_skill("dodge", "wave-step");
       map_skill("unarmed", "taiji-ken");
//       map_skill("unarmed", "fjcg-hand");
	setup();
	carry_object(__DIR__"obj/black_cloth")->wear();
	carry_object(__DIR__"obj/longsword")->wield();

}


void killed_enemy(object who)
{
	command("say 哈哈, 这样的身手也胆敢闯入本会？不要命的家伙！");
}

void attempt_apprentice(object ob)
{
      if(ob->query("combat_exp")<300000 && ob->query_skill("fjcg-hand",1)<120 ) {
		command("say 呵呵，" + RANK_D->query_respect(ob) + "修为不足，多多努力吧！\n");
		return;	
       }
      command("smile");
      command("say " + RANK_D->query_respect(ob) + "你跟着我继续深造吧！哈哈，现在就封你为本会护法。\n");
      command("recruit " + ob->query("id") );
}

void recruit_apprentice(object ob)
{
        if( ::recruit_apprentice(ob) ) {
                ob->set("class", "qinglong");
		  ob->set("title","青龙会护法");	
		}
		  
}

