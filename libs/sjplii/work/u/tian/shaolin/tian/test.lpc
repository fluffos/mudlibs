// This is a room made by roommaker.
#include <ansi.h>

inherit ROOM;

void create()
{
	set("short", "秘密实验室");
	set("long", "这是田公子的秘密实验室。很大的一个房间，四周都是门。
中间是一个平台。\n");
	set("item_desc", ([
       "平台" :  "这是一个很平整的金属台子，可以站(zhan)在上面。\n"  ,
]));

	set("exits", ([ /* sizeof() == 1 */
  "east" : __DIR__"home1",
  "west" : __DIR__"home2",
  "north" : __DIR__"home3",
  "south" : __DIR__"home4",
]));

	setup();
//	replace_program(ROOM);
}

void init()
{
        add_action("do_zhan", "zhan");
}

int do_zhan(string arg)
{

	if( !arg || arg=="" ) return 0;
	if(arg=="平台") {
		message_vision("$N站到平台上，只听一阵翁翁的响声，金属平台开始变亮。\n",this_player());
		message_vision(HIW "接着只见一道耀眼的闪光，$N消失了。\n\n" NOR,this_player());
		this_player()->move(__DIR__"home");
		message_vision(HIW "$N在一道耀眼的闪光中出现。\n\n" NOR,this_player());
		return 1;
	}
	return 0;
}