inherit ROOM;

void create()
{
        set("short", "小路");
        set("long", @LONG
你轻松地走在小路上。路上落英缤纷，一边是小树林，盛开着几簇
鲜艳的花朵，万紫千红。还可以看见蜜蜂「嗡嗡」地在花间飞上飞下忙
个不停，间或传来猿猴的叽咋声。
    南面就是少林寺的后门。
LONG
       );
        set("exits", ([/* sizeof() == 2 */
            "north" : __DIR__"shulin2",
            "east" : __DIR__"xiaolu8",
]));

        set("no_clean_up", 0);
	set("outdoors","shaolin");

        setup();
        replace_program(ROOM);
}