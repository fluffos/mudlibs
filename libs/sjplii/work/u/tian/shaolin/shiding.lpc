//shiding.c 巨石顶

inherit ROOM;
string look_yin();

mapping skill =([
"name":"unarmed",
"exp_required": 10000,
"sen_cost": 50, 
"difficulty": 30,
"max_skill": 150,
]);


void create()
{
        set("short", "巨石顶");
        set("long", @LONG
这是猛虎石的顶，空间很小，地上很滑，勉强能站住。
这里没有明显的出口。
LONG
        );

	set("item_desc",([
	"地上":"你仔细看看石头上面，居然有一只巨大的掌印",
	]));


        set("no_clean_up", 0);

        setup();
//        replace_program(ROOM);
}

void init()
{
	add_action("do_du", ({"study","du"}));
	add_action("do_tiao", ({"tiao"}));
}

void reset()
{
	::reset();
	delete("you-ren");
}

int do_du(string arg)
{

	object ob=this_object(),me=this_player();
	int my_skill;
	int cost;
	
	if(me->query("class")!="shaolin"&&me->query("class")!="shaolin1") return 0;
	if(me->query_temp("sleeping")||me->query_temp("dazuo")||me->is_fighting() ){
		write("你现在无法学习！\n");
		return 1;
	}
	if(arg!="掌印") {
		write("你要读什么？\n");
		return 1;
	}

	if( !me->query_skill("literate", 1) ){
		write("你是个文盲，先学学读书识字(literate)吧。\n");
		return 1;
	}

	message("vision", me->name() + "专心看了一遍掌印。\n", environment(me), me);

	if( (int)me->query("combat_exp") < skill["exp_required"] ) {
		write("你的实战经验不足，再怎麽读也没用。\n");
		return 1;
	}

	if( !SKILL_D(skill["name"])->valid_learn(me) ) return 0;

	cost = skill["sen_cost"] + skill["sen_cost"] 
		* (skill["difficulty"] - (int)me->query("int"))/20;
//printf("%d ",cost);
	if( (int)me->query("sen") < cost ) {
		write("你现在过於疲倦，无法专心下来研读新知。\n");
		return 1;
	}

//	if( me->query_skill(skill["name"], 1) > skill["max_skill"] ) {
//		write("你研读了一会儿，但是发现上面所说的对你而言都太浅了，没有学到任何东西。\n");
//		return 1;
//	}

	me->receive_damage("sen", cost);

	if( !me->query_skill(skill["name"], 1) )
		me->set_skill(skill["name"], 0);

    my_skill = me->query_skill(skill["name"], 1);
	if(my_skill>(me->query("kar")-8)*10) {
		write("好象是缘分已尽，你再怎么读也没用。\n");
		return 1;
	}
    if( my_skill * my_skill * my_skill/10 >	(int)me->query("combat_exp") ) {
		write("也许是缺乏实战经验，你没有任何收获。\n");
		return 1; 
	}

	me->improve_skill(skill["name"], (int)me->query_skill("literate", 1)/5+1);
	write("你研读有关" + to_chinese(skill["name"]) + "的技巧，有点心得。\n");
	return 1;
}

int do_tiao(string arg)
{
	object ob,me=this_player();

	if(arg != "石下") return 0;
	if(me->query("class")!="shaolin"&&me->query("class")!="shaolin1") return 0;
	if(me->query_skill("shaolin-dodge",1)<40) 
		write("你往下一跃，结果扑通一声摔到地上！\n");
	else
		write("你纵身一跃，从巨石的顶上轻飘飘地下来了。\n");
	ob=(object)__DIR__"fuhupou";
	this_object()->delete("you-ren");
	tell_room(ob,me->query("name")+"走了过来。\n");
	me->move(ob);
	tell_room(this_object(),me->query("name")+"纵身一跃，轻飘飘地下去了。\n");
	return 1;

}

