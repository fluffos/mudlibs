inherit ROOM;

void create() {
  set("short", "少室山顶峰");
  set("long", @LONG
你登上少室山峰顶，放眼望去，只见周围山峰环绕在少室山四周，如
众星拱月一般，迎面扑来的飒飒劲风吹得你衣袖飘飘，令你觉得天人合一，
豪兴大发,忍不住要长啸(xiao)一声。
LONG
  );
  set("exits", ([ /* sizeof() == 1 */
    "southdown": __DIR__ "qiaobi1",
  ]));
  set("item_desc", ([
    "峰顶": "这是少室山峰顶，是一片不小的空地，几棵松树(tree)高大挺拔。\n",
  ]));

  set("no_clean_up", 0);
  set("outdoors", "shaolin");

  setup();
}
