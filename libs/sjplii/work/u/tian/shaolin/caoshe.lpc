//caoshe 草舍
inherit ROOM;

void create()
{
        set("short", "草舍");
        set("long", @LONG
这里是一间小草舍。屋内摆设简单，木桌木椅木凳，是少林寺
现任方丈空见大师会客的地方，方丈偶尔也在此饮茶休息。有一位
小僧在此听候方丈吩咐。北面一扇木门紧闭，里面是方丈的起居室。
LONG
        );
        set("exits", ([/* sizeof() == 2 */
           "south"  : __DIR__"xiaoyuan3",
           "north"  : __DIR__"fzshi",
]));

        set("no_clean_up", 0);

        setup();
//        replace_program(ROOM);
}

int valid_leave(object me,string dir)
{
	string class_name;
	object seng;
	int nn=me->query("family/generation");

	seng=present("jing cheng",environment(me));
	class_name=me->query("class");
	if (class_name=="shaolin"&&nn>1&&nn<6) return 1;
	if ( (dir=="north") && (objectp(seng)) ) 
		return notify_fail("静成伸手拦住你，说道：“方丈正在入定，无事不得打扰！”\n");
	return 1;
}

void init()
{
	object me=this_player(),seng;	

	seng=present("jing cheng",environment(me));
	if(!seng){
		seng=new(__DIR__"npc/jingcheng");
		seng->move(this_object());
	}
}
	

