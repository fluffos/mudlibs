inherit ROOM;

void create()
{
        set("short", "黄土路");
        set("long", @LONG
脚下的黄土路，年久失修，已不成大路，路两边长满了各种灌木。
抬眼望去，北面就是天下有名的嵩山。中岳嵩山是五岳之一，自古就
是佛门圣地，千年古刹少林寺就在其中。
LONG
        );
        set("exits", ([/* sizeof() == 2 */
            "south" : __DIR__"town1",
            "northeast" : __DIR__"shanlu4",
]));

        set("no_clean_up", 0);
	set("outdoors","shaolin");
        setup();
        replace_program(ROOM);
}
