inherit ROOM;

int do_wield1(object me, object ob);

void create() {
  object ob;

  set("short", "山门");
  set("long", @LONG
一个巨大的青石牌坊横立眼前，正中刻着『少林寺』三个字，古
朴苍劲，一看便知是名家手笔。两位僧人守立两旁。旁边还有一块石
碑(stone)。
LONG
  );
  set("exits", ([ /* sizeof() == 2 */
    "south": __DIR__ "fuhupou",
    "northup": __DIR__ "taijie1",
  ]));

  set("item_desc", ([ /* sizeof() == 1 */
    "stone": " 一块青石碑，上刻：
  佛门圣地，禁带兵刃。
",
  ]));
  //  set("objects",([
  //  __DIR__"npc/qingxu" : 2,
  //  ]));
  seteuid(getuid());
  ob = new(__DIR__ "npc/qingxu");
  ob->set_name("清虚", ({ "qingxu" }));
  ob->move(this_object());
  ob = new(__DIR__ "npc/qingxu");
  ob->set_name("清静", ({ "qingjing" }));
  ob->move(this_object());

  set("outdoors", "shaolin");

  set("no_clean_up", 0);

  setup();
  //        replace_program(ROOM);
}

int valid_leave(object me, string dir) {
  object *inv, ob = this_player(), ob1;
  int i, count, ii;
  string ss, class_name;
  object seng, seng1;

  seng = present("qingjing", environment(me));
  seng1 = present("qingxu", environment(me));
  class_name = me->query("class");
  if (class_name == "shaolin" || class_name == "shaolin1") return 1;
  if (!objectp(seng) && !objectp(seng1)) return 1;

  if ((dir == "northup")) {
    //      if(
    if ((ob1 = this_player()->query_temp("weapon"))) {
      if (objectp(ob1)) {
        ss = (string)ob1->name();
        message_vision("看门弟子没收了$N手上的" + ss + "。\n", ob);
        destruct(ob1);
      }
    }
    ob = this_player();
    inv = all_inventory(ob);
    for (count = 0, i = 0; i < sizeof(inv); i++) {
      if (inv[i]->query("equipped")) continue;
      //          printf("%s\n",inv[i]->name());
      if (do_wield1(ob, inv[i])) count++;
    }
    //      printf("%d %d ",count,i);
    if (count > 0) {
      message_vision("看门弟子伸手拦住$N，说道：“阿弥陀佛，施主，请放下兵器再上山。”\n", ob);
      return notify_fail("");
    }
  }
  return 1;
}

int do_wield1(object me, object ob) {
  string str;

  if (ob->wield()) {
    ob->unequip();
    destruct(ob);
    return 1;
  } else return 0;
}
