// zoulang1.c 西走廊

#include <room.h>
inherit ROOM;

void create()
{
	set("short", "西走廊");
	set("long", @LONG
你走在一条走廊上，东面是大成殿前广场，南北两边是休息室，
偶尔有一些游人过来休息。西面是茅房。
    走廊修建的很精致，只是年代已久，有些地方彩漆已经剥落。
LONG
	);

	set("exits", ([
		"east" : __DIR__"guangchang1",
            "south": __DIR__"sengshe3",
		"west" : __DIR__"maofang",
            "north": __DIR__"sengshe4",
	]));
	set("objects",([
//	__DIR__"npc/juechen" : 1,
	]));

	setup();
	replace_program(ROOM);
}

