inherit ROOM;

void create()
{
        set("short", "伏虎坡");
        set("long", @LONG
眼前是个平缓的山坡，卧有一块巨石，状似一只猛虎，相传以前
此处有恶虎伤人，常人不能敌。后被达摩祖师用大力金刚掌降伏，化
为巨石。石头甚是光滑，看来是爬不上去。
LONG
        );
        set("exits", ([/* sizeof() == 2 */
            "southdown" : __DIR__"shanlu2",
            "north" : __DIR__"shanmen",
]));
	set("item_desc",([
	"巨石"	:"一块巨大的青石，酷似一只猛虎，卧在地上居然还有一人多高。\n",
	]));
/*
	set("objects",([
	__DIR__"npc/chutiankuo" : 1,
	]));
*/
        set("no_clean_up", 0);
	set("outdoors","shaolin");

        setup();
        replace_program(ROOM);
}

