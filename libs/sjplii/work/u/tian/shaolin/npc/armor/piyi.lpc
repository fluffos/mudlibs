// piyi.c 皮衣
//

#include <armor.h>

inherit CLOTH;

void create()
{
	set_name("皮衣", ({ "pi yi","cloth" }) );
	set_weight(2000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "件");
		set("material", "piyi");
		set("value", 1000);
		set("armor_prop/armor", 20);
		set("armor_prop/dodge", 5);
		set("armor_prop/defense", 15);
	}
	setup();
}
