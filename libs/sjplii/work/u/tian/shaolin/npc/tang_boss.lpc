// waiter.c

inherit NPC;
inherit F_VENDOR;

void create() {
  set_name("店掌柜", ({ "waiter" }));
  set("gender", "男性");
  set("age", 22);
  set("long",
    "这位店掌柜正笑咪咪地忙著，还不时拿起挂在脖子上的抹布擦脸。\n");
  set("combat_exp", 5);
  set("attitude", "friendly");
  set("rank_info/respect", "小二哥");
  set("vendor_goods", ([
    "/d/city/obj/food/candy": 10,
    "/d/city/obj/food/candy2": 10,
    "/d/city/obj/food/candy3": 10,
  ]));
  setup();
}

void init() {
  object ob;

  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
  add_action("do_vendor_list", "list");
}

void greeting(object ob) {
  if (!ob || environment(ob) != environment()) return;
  switch (random(3)) {
    case 0:
      say("店掌柜笑咪咪地说道：这位" + RANK_D->query_respect(ob)
        + "，进来吃块糖果，歇歇腿吧。\n");
      break;
    case 1:
      say("店掌柜用脖子上的毛巾抹了抹手，说道：这位" + RANK_D->query_respect(ob)
        + "，请进请进。\n");
      break;
    case 2:
      say("店掌柜说道：这位" + RANK_D->query_respect(ob)
        + "，进来吃块小店的独特火鸡吧，刚烤的哟。\n");
      break;
  }
}
