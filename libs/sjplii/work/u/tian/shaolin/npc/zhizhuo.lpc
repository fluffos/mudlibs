// zhizhuo.c 防具屋-智拙

inherit NPC;

string *armor1 = ({
7,
"铁布衫","tie bushan","/u/tian/shaolin/npc/armor/tiebushan",
"皮衣","pi yi","/u/tian/shaolin/npc/armor/piyi",
"铁甲","tie jia","/u/tian/shaolin/npc/armor/tiejia",
"钢甲","gang jia","/u/tian/shaolin/npc/armor/gangjia",
"盾牌","dun pai","/u/tian/shaolin/npc/armor/dunpai",
"铁护腕","tie huwan","/u/tian/shaolin/npc/armor/tiehuwan",
"头盔","tou kui","/u/tian/shaolin/npc/armor/toukui",
  
});

void create()
{

	set_name("智拙", ({"zhi zhuo","zhuo",}));
	set("long",
		"他是一位看起来迷迷糊糊的青年僧人，好象还没有睡醒的样子。\n"
	);

	set("title", "少林寺防具屋管事");
	set("gender", "男性");
	set("attitude", "heroism");
//	set("class", "shaolin");
//	create_family("少林寺", 10, "弟子");

	set("inquiry",([
		"防具" : "我这里有铁布衫，皮衣，铁甲，钢甲，盾牌，铁护腕，头盔。\n",
	]));

	set("age", 28);

	set("max_gin", 1000);
	set("max_kee", 2000);
	set("max_sen", 1000);
	set("force", 5000);
	set("max_force", 3000);
	set("force_factor", 50 );
	set("combat_exp", 1000000);

	set_skill("force", 200);
	set_skill("unarmed", 250);
	set_skill("dodge", 250);
	set_skill("parry", 250);
	set_skill("sword", 250);
	set_skill("nianhua-zhi", 250);
	set_skill("luohan_force", 200);
	set_skill("shaolin-dodge", 250);
	set_skill("damo-sword", 250);

	map_skill("force", "luohan_force");
	map_skill("unarmed", "nianhua-zhi");
	map_skill("dodge", "shaolin-dodge");
	map_skill("sword", "damo-sword");
	map_skill("parry", "damo-sword");

    set_temp("apply/attack", 100);
    set_temp("apply/defense", 100);

	setup();
	carry_object(__DIR__"obj/qing_jiasha")->wear();
	carry_object(__DIR__"obj/changjian")->wield();

}

void init()
{
	add_action("do_lingqu", ({"lingqu",}));
	add_action("do_guihuan", ({"guihuan",}));
}

int do_lingqu(string arg)
{
	object me=this_player(),ob;
	int ii;

	if( (string)me->query("class")!="shaolin"&&(string)me->query("class")!="shaolin1" )
		return notify_fail("智拙说：不是少林弟子是不能领取的。\n");
	if(!arg) 
		return notify_fail("智拙说：你想领取什么呀？要说明的。\n");
	if(query("give")==15)
		return notify_fail("智拙说：防具已发完了，你等会再来吧。\n");

	for(ii=0; ii<(int)armor1[0]; ii++) {
		if(arg==armor1[ii*3+1]) {
			ob=new(armor1[ii*3+3]);
			message_vision("智拙点点头，说：好，这是你要的防具，给你，记得用完还回来。\n",me);
			message_vision("智拙转身取出一"+ob->query("unit")+ob->query("name")+"递给$N。\n",me);
			ob->move( me );
			add("give",1);
			return 1;
		}
	}
	return notify_fail("智拙说：没有这种防具呀，你再好好想想吧。\n");
	return 1;
}

int do_guihuan(string arg)
{
	object me=this_player(),ob;
	int ii;

	if( (string)me->query("class")!="shaolin"&&(string)me->query("class")!="shaolin1" )
		return notify_fail("智拙说：咦，我不记得给过你东西呀。\n");
	if(!arg) 
		return notify_fail("智拙说：你想归还什么呀？要说明的。\n");
	for(ii=0; ii<(int)armor1[0]; ii++) {
		if(arg==armor1[ii*3+1]) {
			ob=present(armor1[ii*3+2],me);
			if (!ob) return notify_fail("智拙说：你身上没有这种防具呀，是不是丢了？\n");
			message_vision("智拙点点头，说：不错，好借好还，再借不难，好，奖励你10点道德值。\n",me);
			message_vision("$N还给智拙一"+ob->query("unit")+ob->query("name")+"。\n",me);
			ob->move(this_object());
			destruct(ob);
			me->add("daode",10);
			return 1;
		}
	}
	return notify_fail("智拙说：我没发给你这种东西呀，你再好好想想吧。\n");
	return 1;

}

int accept_fight(object ob)
{
command("say 阿弥陀佛，佛门圣地怎能动武？");
return 0;
}	


void killed_enemy(object who)
{
	command("say 哈哈, 这样低微的本事也胆敢擅闯少林寺？不要命的家伙！");
}

void reset()
{
	set("give", 0);
}
