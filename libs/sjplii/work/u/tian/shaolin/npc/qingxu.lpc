// qingxu.c

inherit NPC;

void create()
{
	set_name("清虚", ({ "qingxu" }) );

	set("age", 17);
	set("gender", "男性" );
	set("long",
		"一个眉清目秀的小和尚，站在山门旁边，态度谦谨的看着你。\n",);
	set("attitude", "friendly");

	set("title","少林寺看门弟子");
 	create_family("少林寺", 8, "弟子");
	setup();

	carry_object(__DIR__"obj/seng_cloth")->wear();

}


int accept_fight(object ob)
{
	command("buddhi");
	command("say 佛门胜地，不能动刀动枪！\n");
	return 0;
}

void attempt_apprentice(object ob)
{
	command("say 我怎么配当施主的师父呢，施主见笑了。\n");
	this_player()->delete_temp("pending/apprentice");
	return;
//" + RANK_D->query_respect(ob)+"
}

