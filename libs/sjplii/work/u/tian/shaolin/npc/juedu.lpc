// juedu.c 大成殿-觉渡

inherit NPC;

string ask_for_join();

void create()
{
	set_name("觉渡", ({"jue du","du"}));
	set("long",
		"这是一位满脸皱纹的老僧，他慈眉善目，是少林寺专门负责剃度的，\n"
		"几十年来由他剃度的少林弟子不计其数。\n"
	);


	set("gender", "男性");
	set("attitude", "friendly");
	set("class", "shaolin");

	set("inquiry",([
		"学艺" : "阿弥陀佛，少林武功天下闻名，四海仰慕。\n",
		"剃度" : (: ask_for_join :),
	]));

	set("age", 65);

	set("max_gin", 300);
	set("max_kee", 500);
	set("max_sen", 300);
	set("force", 1000);
	set("max_force", 1000);
	set("force_factor", 20 );
	set("combat_exp", 300000);



	set_skill("force", 80);
	set_skill("xinyi_force", 30);
	set_skill("dodge", 80);
	set_skill("shaolin-dodge", 50);
	set_skill("unarmed", 80);
	set_skill("blade", 80);
	set_skill("bright_ken", 50);
	set_skill("parry", 80);
	set_skill("buddhism", 50);
	set_skill("magic", 60);
	set_skill("literate", 40);

	map_skill("force", "xinyi_force");
	map_skill("dodge", "shaolin-dodge");
	map_skill("unarmed", "bright_ken");

	set("title","少林寺剃度僧");
//	create_family("少林寺", 9, "弟子");

	setup();

	carry_object(__DIR__"obj/qing1_jiasha")->wear();
}


void init()
{
	add_action("do_kneel", "kneel");
}

string ask_for_join()
{
	object me = this_player();
	mapping family = me->query("family");

	if( (int)me->query("shaolin/tidu")==1 )
		return "阿弥陀佛！你已经是少林寺的弟子了，还剃度什么？好好干吧，前途无量呀！\n";

	if( (string)me->query("gender") != "男性" )
		return "阿弥陀佛！善哉！善哉！女施主若真心皈依我佛，还是到峨嵋山去吧。\n";

	if( (string)me->query("class")!="shaolin1" ){
		if( !(me->query_temp("visit"))){
			command("wa");
			return "你是怎么混进少林寺的？\n";
		}
		if( me->query_temp("visit")==1){
			command("?");
			return "阿弥陀佛，施主不是来参观的吗？好好看看吧。\n";
		}
	}
	if( me->query("couple/id"))
		return "阿弥陀佛！施主已是有家室的人了，还是请回吧。\n";

	if(me->query("kar")<10){
		command("shake");
		command("say 施主似乎福缘不足，唉，可惜呀，与佛门无缘！");
		return "阿弥陀佛，唉，请施主另选地方吧。\n";
	}

	if( me->query("betrayer")){
		command("shake");
		message_vision("觉渡双手合十，对$N说道: 少林寺从不收叛师之徒!\n",me);
		return "阿弥陀佛，苦海无边，回头是岸！\n";
	}
	if((me->query("class")=="shaolin1")&&((int)family["generation"]<8)){
		command("shake");
		return "阿弥陀佛，"+RANK_D->query_respect(me)+"凡心俗念太重，还是带发修行吧。\n";
	}
	if(me->query("PKS")>10 && me->query("daode") < -2000 ){
		command("sigh");
		return "阿弥陀佛，"+RANK_D->query_respect(me)+"杀孽太深，我佛难容，还是请回吧。\n";
	}
	if(me->query("thief")>10){
		command("sigh");
		return "阿弥陀佛，"+RANK_D->query_respect(me)+"品行怎么如此不端，偷盗乃修行之大忌，还是请回吧。\n";
	}

	me->set_temp("shaolin/join_bonze", 1);
	return "阿弥陀佛！善哉！善哉！施主若真心皈依我佛，请跪下(kneel)受戒。\n";
}

int do_kneel()
{
	object me = this_player();
	mapping family = me->query("family");
	string name, new_name;

	string *prename =
	({"无","玄","空","明","静","智","虚","慧","觉","清"});

//	({"清","觉","慧","虚","智","净","明","空","玄","无"});
//	 ({ "虚", "空", "明", "圆", "净", "悟", "法" });


	if( !me->query_temp("shaolin/join_bonze") )
		return 0;
	name = me->query("name");

	if(me->query("class")=="shaolin1")
		new_name=prename[(int)family["generation"]-1]+name[0..1];
	else
		new_name=prename[9] + name[0..1];

//	new_name = prename[random(sizeof(prename))] + name[0..1];

	message_vision(
		"$N双手合十，恭恭敬敬地跪了下来。\n\n"
		"$n伸出手掌，在$N头顶轻轻地摩挲了几下，将$N的头发尽数剃去。\n\n",
		me, this_object() );
	command("say 从今以后你的法名叫做" + new_name + "。");
	command("smile");
	if(me->query("class")!="shaolin1") {
		command ("say 阿弥陀佛！善哉！善哉！恭喜你成为『少林寺记名弟子』了。\n");
		me->set("title","少林寺记名弟子");
	}
	me->delete_temp("shaolin/join_bonze");
	me->set("name1",name);
	me->set("name", new_name);
	me->set("class", "shaolin");
	me->set("K_record", me->query("PKS") + me->query("MKS"));
//	me->set("shen_record", me->query("shen"));
	me->set("shaqi",me->query("bellicosity"));
	me->set("tou",me->query("thief"));
	me->set("id_type",1);
	me->set("shaolin/tidu", 1);
	return 1;
}
