// shouluseng.c 守律僧-慧厉

inherit NPC;
#include <ansi.h>

void create()
{

	set_name("慧厉", ({"hui li","li"}));
	set("long",
		"这是戒律院的守律僧，面无表情，精研佛门戒律，处事公正。\n"
	);

	set("title", "戒律院守律僧");
	set("gender", "男性");
	set("attitude", "heroism");
	set("class", "shaolin");

	set("age", 37);

	set("max_gin", 1400);
	set("max_kee", 3600);
	set("max_sen", 1400);
	set("force", 8000);
	set("max_force", 5000);
	set("force_factor", 100 );
	set("combat_exp", 1500000);

	set("chat_chance", 5);

	set_skill("force", 180);
	set_skill("unarmed", 180);
	set_skill("dodge", 180);
	set_skill("parry", 180);
	set_skill("stick", 280);

	set_skill("longzhua", 180);
	set_skill("xinyi_force", 180);
	set_skill("shaolin-dodge", 180);
	set_skill("yecha_stick", 180);

	map_skill("force", "xinyi_force");
	map_skill("unarmed", "longzhua");
	map_skill("dodge", "shaolin-dodge");
	map_skill("stick", "yecha_stick");
    set_temp("apply/attack", 40);
    set_temp("apply/defense", 40);

	setup();
	carry_object(__DIR__"obj/jielugun")->wield();
	carry_object(__DIR__"obj/qing_jiasha")->wear();
}


int accept_fight(object ob)
{
command("say 阿弥陀佛，佛门圣地怎能动武？");
return 0;
}	

void init()
{
	object me=this_player();

//	if( interactive(me = this_player()) ) {
	if( (string)me->query("class")=="shaolin"||(string)me->query("class")=="shaolin1" ) {
		remove_call_out("do_check");
		call_out("do_check", 1, me);
	}

}

void do_check(object me)
{
	int nn,ii;
	string ss;

	nn=0;
	ii=0;
	message_vision(CYN"慧厉用锐利的目光盯著$N，$N不自禁地打了个哆嗦，往后退了一步。\n"NOR,me);

	nn=(me->query("PKS")+me->query("MKS"))-me->query("K_record");
	if(nn>0) {
		ss=sprintf("你杀人%d次，",nn);
		ii=nn*10;
	}
	nn=me->query("thief")-me->query("tou");
	if(nn>0) {
		ss+=sprintf("偷窃%d次，",nn);
		ii=ii+nn*5;
	}
	else me->set("tou",me->query("thief"));

//	if(me->query("shaqi")<me->query("bellicosity"))	nn=nn+2;
	if(ii==0) return;
	ss+=sprintf("该受戒棍%d下。",ii);
	message_vision(CYN"慧厉对$N严厉地说："+ss+"\n\n"NOR,me);
	message_vision(CYN"慧严大喝一声：快趴下受戒！！\n"NOR,me);
	message_vision(YEL"$N早已吓的面无人色，瘫倒在地，慧厉上前把$N抓到青石台上，抡起手中戒棍就打。\n\n"NOR,me);
	message_vision(CYN"慧严在一边数着：1,2,3,........."+(string)ii+"下了，好了，够了。\n"NOR,me);
	message_vision(CYN"$N被打的皮开肉绽，爬都爬不起来了。\n\n"NOR,me);
	nn=me->query("eff_kee")*20/(ii+20);
	if( nn <=1 ) nn=1;
	me->set("kee",nn);
	me->set("eff_kee",nn);
	me->set("K_record",me->query("PKS") + me->query("MKS"));
	me->set("tou",me->query("thief"));
	me->start_busy(3);
	me->set_delay(ii);
	me->set_wait(ii);
	call_out("do_pa",ii,me);

}

void do_pa(object me)
{
	message_vision("$N趴在青石台上，喘了好半天，才摇摇晃晃的爬了起来。\n",me);
}
