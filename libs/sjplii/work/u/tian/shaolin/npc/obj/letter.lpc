// letter1.c 觉禅推荐信

#include <armor.h>

inherit ITEM;

void create()
{
	set_name("密信",({ "letter" }) );
	set("long",
	    "一封蓝色信封装着的密信, 你想把它打开(open), 却办不到。\n");

	set_weight(10);
	if( clonep() )
		set_default_object(__FILE__);
	else 
		set("unit", "封");
	setup();
}

void init()
{
    add_action("do_open", "open");
}

int do_open(string arg)
{
  if(arg = "letter")
    tell_object(this_player(),
	  "看来你无法把它打开。\n");
  return 1;
}
