// shuazi.c 刷子

#include <weapon.h>

inherit HAMMER;

void create()
{
	set_name("刷子", ({ "shuazi", "hammer", "brush"}) );
	set_weight(350);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "一把很普通的小刷子，平常用来刷漆的。\n");
		set("unit", "把");
		set("value", 1);
		set("wield_msg", "$N抓起一把$n，握在手中当武器。\n");
	}
	init_hammer(1);
	setup();
}

