// qing1-jiasha.c

#include <armor.h>

inherit CLOTH;

void create()
{
	set_name("青边袈裟", ({ "qingbian jiasha","cloth" }) );
	set_weight(3000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "件");
		set("long","一件镶青边的黄布袈裟。\n");
		set("material", "cloth");
		set("armor_prop/armor", 3);
	}
	setup();
}
