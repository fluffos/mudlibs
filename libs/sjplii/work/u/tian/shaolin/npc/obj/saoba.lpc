// saoba.c
#include <ansi.h>
#include <weapon.h>
inherit STAFF;
void create()
{
	set_name( "大扫把", ({ "saoba","whisk","stick" }) );
	set_weight(300);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "条");
		set("long", "一条细竹条编制的大扫把，结实又耐用，专门用来扫（sao）地的。\n");
		set("value", 100);
		set("material", "wood");
		set("wield_msg", "$N拿出一根$n抄在手中。\n");
	set("unwield_msg", "$N放下手中的$n。\n");
	}
	init_staff(1);
	setup();
}

void init()
{
      	add_action("do_saodi", ({"sao"}));
}


int do_saodi(string arg)
{
	object me = this_player(),ob;
	int nn,parry_n,kee_cost;

	if(!arg) return 0;
	if(!(present("saoba",me))) return 0;
	seteuid(getuid());
	if( arg=="di"||arg=="地"){
		if(me->query("id")!=this_object()->query("own_name")) {
			printf("这不是你的东西，你不能用!\n");
			return 1;
		}
		if(!(ob = me->query_temp("weapon") ) ){
			message_vision("$N蹲在地上用双手乱扫一阵，弄的一手土，好象没有什么效果。\n",me);
			return 1;
		}
		if( ob->query("name") == "大扫把" ){
			if(me->query("class")=="shaolin"||me->query("class")=="shaolin1"){
				if( me->query_temp("sleeping") )
					return notify_fail("你正在睡眠中，不能扫地。\n");
				if( me->query_temp("dazuo") )
					return notify_fail("你正在打坐练功，不能扫地。\n");
				if( me->is_fighting() )
					return notify_fail("你已经在战斗中了，专心点吧。\n");
				kee_cost=40+(30-me->query("int"));
				if (kee_cost<1) kee_cost=1;
				if( me->query("kee") < kee_cost) 
					return notify_fail("休息一下吧，你现在太累了。\n");
				me->receive_damage("kee", kee_cost);

				if(me->query_skill("parry",1)>60)
					return notify_fail("你认真扫了一遍地，发现对你已没什么用了。\n");
				parry_n=me->query_skill("parry",1);
				if(parry_n*parry_n*parry_n/10 >me->query("combat_exp")) 
					return notify_fail("也许是缺乏经验吧，你认真扫了一遍地，好象没有什么收获。\n");

				message_vision("$N认真扫了一遍地，好象学到什么。\n", me);
				nn=(me->query("int")-20);
				if(nn<1) nn=1;
				me->improve_skill("parry",nn,0);
				return 1;
			}
		}
		else {
			message_vision("有没有搞错？看清楚你手里拿的是什么？\n", me);
			return 1;
		}
	}
	return 0;
}

