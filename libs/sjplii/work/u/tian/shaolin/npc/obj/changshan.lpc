// changshan.c 长衫

#include <armor.h>

inherit CLOTH;

void create()
{
	set_name("长衫", ({ "chang shan","cloth", }) );
	set_weight(3000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "件");
		set("long","一件杭州丝绸缝制的华丽长衫。\n");
		set("material", "cloth");
		set("armor_prop/armor", 1);
		set("armor_prop/dodge", 5);
	}
	setup();
}
