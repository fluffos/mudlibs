// kongdan.c 大雄宝殿 空淡

inherit NPC;
inherit F_MASTER;
#include <ansi.h>

string ask_me();

void create() {
  set_name("空淡", ({ "kong dan", "dan", }));
  set("long",
    "这是一位红光满面的中年僧人，神态肃然地站在这里。\n"
  );


  set("gender", "男性");
  set("attitude", "heroism");
  set("class", "shaolin");

  set("inquiry", ([
    "空见": "你说空见大师呀，他是我的师兄，现在是少林寺方丈。\n",
    "青冥剑": "这是一位来少林寺比武的施主留下的，说是20年后要来拿回此剑。但贫僧正想送还此剑。",
    //		"推荐信" : (: ask_me :),
    "法缘经": "是一本记载高深佛法的经书，可是已经失传多年，不知道别的寺庙中可否找到。",
  ]));
  set("chat_chance", 3);
  set("chat_msg", ({
    "空淡叹了口气，自言自语道：《法缘经》已经失传多年了。。。。。\n",
  }));

  set("age", 40);
  set("str", 70);

  set("max_gin", 1500);
  set("max_kee", 3000);
  set("max_sen", 1500);
  set("force", 9000);
  set("max_force", 4500);
  set("force_factor", 140);
  set("combat_exp", 10000000);



  set_skill("force", 350);
  set_skill("fuxiang_force", 350);
  set_skill("dodge", 350);
  set_skill("shaolin-dodge", 350);
  set_skill("yizhi-chan", 350);
  set_skill("parry", 350);
  set_skill("unarmed", 350);
  set_skill("blade", 350);
  set_skill("staff", 350);
  set_skill("wenshu_staff", 350);

  //	set_skill("essencemagic", 250);
  set_skill("buddhism", 250);
  //	set_skill("magic", 250);
  set_skill("literate", 100);

  map_skill("force", "fuxiang_force");
  map_skill("dodge", "shaolin-dodge");
  map_skill("unarmed", "yizhi-chan");
  map_skill("parry", "wenshu_staff");
  map_skill("staff", "wenshu_staff");

  set_temp("apply/attack", 5);
  set_temp("apply/defense", 5);


  set("title", "少林寺大雄宝殿管事");
  create_family("少林寺", 3, "弟子");
  set("no_teach", 1);
  set("family/privs", 1);

  setup();
  carry_object("/d/city/obj/weapon/staff/chanzhang")->wield();
  carry_object(__DIR__ "obj/qing_jiasha")->wear();
}


int accept_object(object me, object ob) {
  object clasp;
  me = this_player();
  if ((string)ob->query("id") != "fayuan-jing") {
    command("say 一切本是空，你又何必呢？\n");
  } else {
    command("say 这本书贫僧寻找多时，多谢师主指点。");
    command("say 这柄剑就有劳施主送还吧。");
    command("whisper " + me->query("id") + " 这柄剑是寒灵山庄的轻风堂堂主寒叶的。\n");
    ob = new(__DIR__ "obj/qingming-sword");
    ob->move(me);
  }
  return 1;
}

void attempt_apprentice(object ob) {
  command("shake");
  message_vision("$n双手合十，对$N说道: 我是不收徒弟的，你还是找我师兄空见去吧！\n", ob, this_object());
  ob->delete_temp("pending/apprentice");
  return;
}
