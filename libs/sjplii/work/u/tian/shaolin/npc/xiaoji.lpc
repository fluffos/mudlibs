// xiaoji.c

inherit NPC;

void create() {
  set_name("小鸡", ({ "xiao ji", "ji", "chook" }));
  set("long", "一只肥肥的小草鸡。\n");
  set("race", "野兽");
  set("limbs", ({ "头部", "身体", "翅膀", "爪子", "尾巴" }));
  set("verbs", ({ "bite", "claw" }));
  set("combat_exp", 1);
  set("no_talk", 1);
  set("corpse", __DIR__ "obj/jirou");
  setup();
}
