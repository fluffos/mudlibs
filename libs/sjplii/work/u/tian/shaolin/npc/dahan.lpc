#include <ansi.h>
inherit NPC;
string reward_more( object who);

void create()
{
        set_name("陕北大汉", ({"dahan"}));
        set("age", 25);
        set("gender", "男性");
        set("long",
"一个体型魁悟的大汉，正在吃包子。\n");
        set("attitude", "peaceful");
	set("str", 30);
        set("combat_exp", 6000+random(3000));
        set("shen_type", 1);
        set("force", 200);
        set("force_factor", 1);
        set_skill("unarmed", 30);
        set_skill("dodge", 30);
        set_skill("parry", 30);
        set("chat_chance_combat", 50);
        set("chat_msg_combat", ({
		(: reward_more(this_object()) :),
        }) );
        setup();
        carry_object("/obj/cloth")->wear();
}
string reward_more(object who)
{
	int i;
	object *enemy;
	seteuid(getuid());
	enemy = who->query_enemy();
	i = sizeof(enemy);
	while(i--) {
		if( enemy[i] && living(enemy[i]) ) {
			if( enemy[i]->query("combat_exp") < 10000 ) return "1";
			if( enemy[i]->query("combat_exp") > 15000 ) return "1";
			enemy[i]->add("combat_exp", 1);
			if( enemy[i]->query("potential") > 500 ) return "1";
			enemy[i]->add("potential", 1);
		}
	}
	return "1";
}
int accept_fight(object me)
{
        return 1;
}



