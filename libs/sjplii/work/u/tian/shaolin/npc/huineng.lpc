// huineng.c 心禅堂-慧能

inherit NPC;
inherit F_MASTER;

string *title = ({
"少林寺心禅堂第五弟子", 40000,
"少林寺心禅堂第四弟子", 50000,
"少林寺心禅堂第三弟子", 60000,
"少林寺心禅堂第二弟子", 80000,
"少林寺心禅堂大弟子", 100000,
});


string ask_me();

void create()
{
	set_name("慧能", ({"hui neng master","hui neng","master",}));
	set("long",
		"这是一位看起来很平常的僧人，他长的普普通通。\n"
	);


	set("gender", "男性");
	set("attitude", "heroism");
	set("class", "shaolin1");

	set("inquiry",([
//		"学艺" : "阿弥陀佛，贫僧武艺粗浅，只收些俗家弟子，传些少林入门的功夫。\n",
//		"拜师" : "还上哪里找？拜我就是！\n",
		"虚方大师" : "虚方大师你都不知道？他是我的师傅，是[藏经阁]首座！\n",
		"觉禅" : "你说觉禅呀，他是我的得意弟子，在前院小广场。\n",
		"推荐信" : (: ask_me :),
	]));

	set("age", 35);

	set("max_gin", 500);
	set("max_kee", 1000);
	set("max_sen", 500);
	set("force", 2000);
	set("max_force", 1500);
	set("force_factor", 40 );
	set("combat_exp", 1000000);



	set_skill("force", 120);
	set_skill("tongzi-force", 120);
	set_skill("dodge", 120);
	set_skill("shaolin-dodge", 120);
	set_skill("hammer", 120);
	set_skill("weituo_chu", 120);
	set_skill("fuhu-ken", 120);
	set_skill("parry", 120);
	set_skill("unarmed", 120);

//	set_skill("essencemagic", 100);
	set_skill("buddhism", 100);
	set_skill("magic", 50);
	set_skill("literate", 50);
	set_skill("zuochanshu", 50);

	map_skill("force", "tongzi-force");
	map_skill("dodge", "shaolin-dodge");
	map_skill("hammer", "weituo_chu");
	map_skill("unarmed", "fuhu-ken");

	set("title","少林寺心禅堂首座");
	create_family("少林寺", 8, "弟子");
	set("no_teach",1);

	setup();

	carry_object(__DIR__"obj/qing_jiasha")->wear();
}

void init()
{
	add_action("do_apprentice","apprentice");
}

string ask_me()
{
	object me = this_player(),ob;

	if( !(me->is_apprentice_of(this_object()))) return 0;
	if(!(me->query("shaolin/tuijian"))) return 0;
	if(ob=present("letter",me)){
		if(me->query("id")==ob->query("own_name")) {
			return "推荐信不是在你身上吗？快去吧!\n";
		}
	}

	command("faint "+me->query("id"));
	tell_object(me, "推荐信搞丢了？真是粗心！\n");
	tell_object(me, "慧能拿出纸和笔，飞快地写了一封信，装到信封里递给你。\n");
	ob = new(__DIR__"obj/letter1");
	ob->set("own_name",me->query("id"));
	ob->move( me );
	return "仔细保管好，不要再搞丢了！\n";

}


void attempt_apprentice(object ob)
{
	if( ob->query("shaolin/shou")!=1||(ob->query("family/master_name")!="觉禅")){
		command("shake");
		message_vision("慧能双手合十，对$N说道: 我是不轻易收徒弟的！\n",ob);
		ob->delete_temp("pending/apprentice");
		return;
	}

	command ("say 阿弥陀佛！贫僧就收下你做『"+title[0]+"』了。");
	command("say 阿弥陀佛，善哉！善哉！");
	command("recruit " + ob->query("id"));
	ob->set("title",title[0]);
	ob->set("class","shaolin1");
	ob->set("shaolin/tuijian",0);
	ob->set("shaolin/renwu",0);
	ob->delete("shaolin/shou");
}


int do_apprentice(string arg)
{
	int exp,nn,ii,rr;
	string old_t;
	object ob,me=this_player();

//	if( arg!="jue chan master"&&arg!="jue chan"&&arg!="master") return 1;
	if( !(me->is_apprentice_of(this_object()))) return 0;
	if(me->query("shaolin/tuijian")) {
		command("wa "+me->query("id"));
		tell_object(me, "你还没拜我师傅虚方大师？快去吧，别耽误了你的修行!\n");
		return 1;
	}

	old_t=me->query("title");
	exp=me->query("combat_exp");
	message_vision("$N跪了下来向$n恭恭敬敬地磕了个头，叫道：「师父好！」\n",me,this_object());

	if(old_t==title[8] && exp>(int)title[9]) {
		command("sigh");
		command("say 真是长江后浪推前浪，一代新人换旧人！为师已没有什么可教你的了。");
		command("say 拿上我的推荐信到虚方大师那里学艺吧！\n");
		printf("慧能拿出纸和笔，飞快地写了一封信，装到信封里递给你。\n");
		ob = new(__DIR__"obj/letter1");
		ob->set("own_name",me->query("id"));
		ob->move( me );

//		command("say 你我师徒一场，为师也没有什么东西，现在要分手了，送你个纪念品吧！\n");
		me->set("shaolin/tuijian",1);
		me->set("shaolin/renwu",0);
		return 1;
	}
	for(ii=0; ii<5; ii++) {
		if(old_t==title[ii*2]) {
			if(exp<=(int)title[ii*2+1]) {
				command("pat "+me->query("id"));
				command("say 你的功夫还不行，要抓紧时间练呀，别光聊天贪玩！\n");
				return 1;
			}
			else {
				command("haha");
//				command("spank "+me->query("id"));
				command("say 长进很快嘛，很好，现在就提升你为" + title[(ii+1)*2] + "。\n");
				me->set("title",title[(ii+1)*2]);
				me->set("shaolin/renwu",0);
				return 1;
			}
		}
	}
	return 1;
}


int accept_object(object me, object ob)
{

	if(me->query("class")!="shaolin1") return 0;
	if(me->query("family/master_name")!="觉禅") return 0;
	if(!(me->query("shaolin/tuijian"))) return 0;
	if((ob->query("id")=="letter")&&(me->query("id")==ob->query("own_name"))) {
		message_vision("$N恭恭敬敬地把推荐信递给慧能。\n",me);
		command("smile");
		command("say 是觉禅叫你来的？呵呵，不错，我就收下你做徒弟吧！\n");
		me->set("shaolin/shou",1);
		return 1;
	}
	return 0;

}