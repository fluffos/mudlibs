// chijieseng.c 持戒僧-慧严

inherit NPC;

void create()
{

	set_name("慧严", ({"hui yan","yan"}));
	set("long",
		"这是戒律院的持戒僧，神情严肃，武功高强，少林弟子只要犯戒
是逃不出他的缉拿的。\n"
	);

	set("title", "戒律院持戒僧");
	set("gender", "男性");
	set("attitude", "heroism");
	set("class", "shaolin");

	set("age", 37);

	set("max_gin", 1400);
	set("max_kee", 3600);
	set("max_sen", 1400);
	set("force", 8000);
	set("max_force", 5000);
	set("force_factor", 100 );
	set("combat_exp", 1500000);

	set("chat_chance", 5);

	set_skill("force", 180);
	set_skill("unarmed", 180);
	set_skill("dodge", 180);
	set_skill("parry", 180);

	set_skill("longzhua", 180);
	set_skill("xinyi_force", 180);
	set_skill("shaolin-dodge", 180);

	map_skill("force", "xinyi_force");
	map_skill("unarmed", "longzhua");
	map_skill("dodge", "shaolin-dodge");
    set_temp("apply/attack", 40);
    set_temp("apply/defense", 40);

	setup();
	carry_object(__DIR__"obj/qing_jiasha")->wear();
}


int accept_fight(object ob)
{
command("say 阿弥陀佛，佛门圣地怎能动武？");
return 0;
}	

