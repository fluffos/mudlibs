// kongjian.c 少林方丈 空见

inherit NPC;
inherit F_MASTER;

string *title = ({
"少林寺方丈室第五长老", 1250000,
"少林寺方丈室第四长老", 1340000,
"少林寺方丈室第三长老", 1440000,
"少林寺方丈室第二长老", 1550000,
"少林寺方丈室大长老",   1700000,
});


string ask_me();

void create()
{
	set_name("空见", ({"kong jian master","kong jian","master",}));
	set("long",
		"这是一位面目清瘦的老僧人，端坐在蒲团上。\n"
	);


	set("gender", "男性");
	set("attitude", "heroism");
	set("class", "shaolin");

	set("inquiry",([
		"空见大师" : "就是老衲！\n",
		"明晦" : "你说明晦呀，他是我的得意弟子，主持达摩院。\n",
//		"推荐信" : (: ask_me :),
	]));

	set("age", 70);
	set("str", 170);
	set("cor", 70);

	set("max_gin", 1500);
	set("max_kee", 4000);
	set("max_sen", 1500);
	set("force", 9000);
	set("max_force", 4500);
	set("force_factor", 140 );
	set("combat_exp", 9000000);



	set_skill("force", 250);
	set_skill("fuxiang_force", 250);
	set_skill("dodge", 250);
	set_skill("shaolin-dodge", 250);
	set_skill("staff", 250);
	set_skill("yizhi-chan", 250);
	set_skill("parry", 250);
	set_skill("unarmed", 250);
	set_skill("staff", 250);
	set_skill("wenshu_staff", 250);
	set_skill("jingang_force", 200);
	set_skill("iron-cloth", 220);
	set_skill("luohan-ken", 240);
	set_skill("xiaochengforce", 200);

	set_skill("essencemagic", 200);
	set_skill("buddhism", 250);
	set_skill("magic", 250);
	set_skill("literate", 150);
	set_skill("zaahan_gong", 150);

	map_skill("force", "fuxiang_force");
	map_skill("dodge", "shaolin-dodge");
	map_skill("unarmed", "yizhi-chan");
	map_skill("parry", "wenshu_staff");
	map_skill("staff", "wenshu_staff");
      map_skill("iron-cloth", "jingang_force");

	set("title","少林寺方丈");
	create_family("少林寺", 3, "弟子");
	set("no_teach",1);
	set("family/privs",1);

	setup();
	carry_object("/d/city/obj/weapon/staff/chanzhang")->wield();
	carry_object(__DIR__"obj/qing_jiasha")->wear();
}

void init()
{
	add_action("do_apprentice","apprentice");
}

string ask_me()
{
	object me = this_player(),ob;

	if( !(me->is_apprentice_of(this_object()))) return 0;
	if(!(me->query("shaolin/tuijian"))) return 0;
	if(ob=present("letter",me)){
		if(me->query("id")==ob->query("own_name")) {
			return "推荐信不是在你身上吗？快去吧!\n";
		}
	}

	command("faint "+me->query("id"));
	tell_object(me, "推荐信搞丢了？真是粗心！\n");
	message_vision("$n拿出纸和笔，飞快地写了一封信，装到信封里递给$N。\n",me,this_object());
	ob = new(__DIR__"obj/letter1");
	ob->set("own_name",me->query("id"));
	ob->move( me );
	return "仔细保管好，不要再搞丢了！\n";

}


void attempt_apprentice(object ob)
{
	string name, new_name;
	mapping family = ob->query("family");
	string *prename =
	({"无","玄","空","明","静","智","虚","慧","觉","清"});

	if( ob->query("shaolin/shou")!=1||(ob->query("family/master_name")!="明晦")){
		command("shake");
		message_vision("$n双手合十，对$N说道: 我是不轻易收徒弟的！\n",ob,this_object());
		ob->delete_temp("pending/apprentice");
		return;
	}

	command ("say 阿弥陀佛！贫僧就收下你做『"+title[0]+"』了。");
	command("say 阿弥陀佛，善哉！善哉！");
	command("recruit " + ob->query("id"));

	name = ob->query("name");
	new_name=prename[(int)family["generation"]-2]+name[2..3];
	command("say 从今天起你就改名为"+new_name+"了。");
	ob->set("name",new_name);
	ob->set("title",title[0]);
	ob->set("class","shaolin");
	ob->set("shaolin/tuijian",0);
	ob->set("shaolin/renwu",0);
	ob->delete("shaolin/shou");
}


int do_apprentice(string arg)
{
	int exp,nn,ii,rr;
	string old_t;
	object ob,me=this_player();

//	if( arg!="jue chan master"&&arg!="jue chan"&&arg!="master") return 1;
	if( !(me->is_apprentice_of(this_object()))) return 0;
/*	if(me->query("shaolin/tuijian")) {
		command("wa "+me->query("id"));
		tell_object(me, "你还没拜我师傅空见大师？快去吧，别耽误了你的修行!\n");
		return 1;
	}
*/
	old_t=me->query("title");
	exp=me->query("combat_exp");
	message_vision("$N跪了下来向$n恭恭敬敬地磕了个头，叫道：「师父好！」\n",me,this_object());

	if(old_t==title[8] && exp>(int)title[9]) {
		command("smile");
		command("say 少林弟子能到大长老的已是寥寥无几，以后的修行就靠你自己了。");
		command("say 阿弥陀佛，佛渡有缘人！");
/*		command("sigh");
		command("say 真是长江后浪推前浪，一代新人换旧人！为师已没有什么可教你的了。");
		command("say 拿上我的推荐信到空见大师那里学艺吧！\n");
		message_vision("$n拿出纸和笔，飞快地写了一封信，装到信封里递给$N。\n",me,this_object());
		ob = new(__DIR__"obj/letter1");
		ob->set("own_name",me->query("id"));
		ob->move( me );
*/
//		command("say 你我师徒一场，为师也没有什么东西，现在要分手了，送你个纪念品吧！\n");
//		me->set("shaolin/tuijian",1);
		me->set("shaolin/renwu",0);
		return 1;
	}
	for(ii=0; ii<5; ii++) {
		if(old_t==title[ii*2]) {
			if(exp<=(int)title[ii*2+1]) {
				command("pat "+me->query("id"));
				command("say 你的功夫还不行，要抓紧时间练呀，别光聊天贪玩！\n");
				return 1;
			}
			else {
				command("nod");
//				command("spank "+me->query("id"));
				command("say 武功有进步，很好，现在就提升你为" + title[(ii+1)*2] + "。\n");
				me->set("title",title[(ii+1)*2]);
				me->set("shaolin/renwu",0);
				return 1;
			}
		}
	}
	return 1;
}


int accept_object(object me, object ob)
{

	if(me->query("class")!="shaolin") return 0;
	if(me->query("family/master_name")!="明晦") return 0;
	if(!(me->query("shaolin/tuijian"))) return 0;
	if((ob->query("id")=="letter")&&(me->query("id")==ob->query("own_name"))) {
		message_vision("$N恭恭敬敬地把推荐信递给$n。\n",me,this_object());
		command("smile");
		command("say 是"+me->query("family/master_name")+"叫你来的？呵呵，不错，我就收下你做徒弟吧！\n");
		me->set("shaolin/shou",1);
		return 1;
	}
	return 0;

}