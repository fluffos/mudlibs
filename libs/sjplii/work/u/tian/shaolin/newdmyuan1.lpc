//cjge2  藏经阁二楼
inherit ROOM;

void create()
{
        set("short", "达摩院内室");
        set("long", @LONG
这是达摩院内室。靠墙一排樟木书架收藏有天下各个门派的武功秘
籍，由少林寺中悟性极高，武艺超群的弟子钻研学习，一般人不能进入。
这里正有几个面目清瘦的老和尚闭目打坐，潜心修炼。
LONG
        );
        set("exits", ([/* sizeof() == 1 */
           "south"  : __DIR__"dmyuan",
]));
	set("objects",([
	__DIR__"npc/mingchan" : 1,
	__DIR__"obj/shelf" : 1,
	]));

        set("no_clean_up", 0);

        setup();
//        replace_program(ROOM);
}

void init()
{
        add_action("do_get", "get");
}

int do_get(string arg)
{
	string	obj, from;
	object	me, shelf, target, taro;

	if(sscanf(arg, "%s from %s", obj, from)==2 ) {
		if(obj == "all") {
			write("拿那么多经书干什么？\n");
			return 1;
		}
		shelf =  present("book shelf",this_object());
		target =  present(from,this_object());
		me = this_player();
		if(target == shelf) {
			taro =  present(obj, target);
			if(taro) {
				message_vision("$N从书架上拿下一本经书。\n", me);
			}
		}
	}
	return 0;
}
void reset()
{
        object  *inv;
        object con, item;
        int i;

        ::reset();
        con = present("book shelf", this_object());
        inv = all_inventory(con);
        if( sizeof(inv) != 8) {
                for(i=sizeof(inv)-1; i>=0; i--) destruct(inv[i]);
                item = new("/u/tian/shaolin/obj/sy-jing");
                item->move(con);
		item = new("/u/tian/shaolin/obj/lh-jing");
                item->move(con);
		item = new("/u/tian/shaolin/obj/dm-jing");
                item->move(con);
                item = new("/u/tian/shaolin/obj/lz-jing");
                item->move(con);
		item = new("/u/tian/shaolin/obj/hammer-jing");
                item->move(con);
	}
}

