dbase (["long":"你来到少林寺的比武场。方圆几十丈，极为宽阔。青石铺地，是少林弟子竞技武技的地方，也是少林各院选拔精干弟子的地方。场上正有两个少林弟子正在比武，你来我往，拳打脚踢，好不热闹。    比武难免有失手之时，但在这里大家是不计较的，放心打吧。    比武场边上还竖着一块木牌（sign）。    这里也是苍松翠柏，古树参天。东西是少林各个禅院和禅堂。","no_clean_up":0,"short":"少林比武场","exits":(["east":"/u/playboy/shaolin/xiaoyuan1","west":"/u/playboy/shaolin/zoulang3","south":"/u/playboy/shaolin/dxbdian","north":"/u/playboy/shaolin/dzdian",]),"winer":({"tian","田公子","少林寺高僧","langfan","明浪","少林寺方丈室第五长老","mudder","静马","少林寺达摩院第三佛师"," "," "," "," "," "," "," "," "," "," "," "," "," "," "," "," "," "," "," "," "," ",}),"no_sleep":1,"no_dead":1,"item_desc":(["sign":,]),])
