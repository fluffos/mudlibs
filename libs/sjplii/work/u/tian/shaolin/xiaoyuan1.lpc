//xiaoyuan1  小院
inherit ROOM;

void create() {
  set("short", "小院");
  set("long", @LONG
这是一个幽静的小院，没有前院熙熙攘攘的游人，顿时安静了许多。
小院中栽着两棵汉柏树，树身扭结上耸，若虬龙蟠曲，虽肤剥心枯，但
又续生新枝，苍古葱郁，真为绝奇。
    向北经过一座小桥就是天下有名的少林寺藏经阁。
LONG
  );
  set("exits", ([ /* sizeof() == 3 */
    "east": __DIR__ "xiaoyuan2",
    "west": __DIR__ "bwchang",
    "north": __DIR__ "cjge",
  ]));

  //	set("item_desc",([
  //	"汉柏"	:"两棵汉柏树，树身扭结上耸，若虬龙蟠曲，虽肤剥心枯，但又续生新枝，
  //苍古葱郁，真为绝奇。\n",
  //	]));

  set("no_clean_up", 0);

  setup();
}

void init() {
  add_action("do_climb", ({ "climb", "pa" }));
}

int do_climb(string arg) {
  object me = this_player();
  object room;

  if (!arg) return 0;
  if (arg != "汉柏") return 0;
  if (random(me->query("kar")) < 15) {
    write("你两手攀着汉柏树干，费劲地往上爬，一不小心，你摔了下来！\n");
    return 1;
  }
  write("你两手攀着汉柏树干，费劲地爬了上去！\n");
  room = (object)__DIR__ "shushang";
  message("vision", "只见" + me->query("name") + "吃力地从下面爬上来。\n", room);
  me->move(room);
  message("vision", me->query("name") + "往西离开。\n", this_object());
  return 1;

}
