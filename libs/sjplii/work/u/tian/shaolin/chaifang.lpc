// chaifang 柴房

#include <room.h>
inherit ROOM;

void create()
{
	set("short", "柴房");
	set("long", @LONG
这是少林寺的柴房。里面堆满了大捆的柴禾，有二个年轻僧
人在劈柴禾(pichai)，干的满头是汗。旁边站个胖头陀正监督他们。
LONG
	);

	set("exits", ([
            "east": __DIR__"liangong6",
	]));
	set("objects",([
	__DIR__"npc/juechen" : 1,
	]));
	
	setup();
}

void init()
{
      	add_action("do_pichai", ({"pichai"}));
}


int do_pichai()
{
	object me = this_player(),ob;
	int nn,skill_n,kee_cost;

	if(me->query("class")!="shaolin1" && me->query("class")!="shaolin") return 0;
	if(!(ob=present("futou",me))) return 0;
	seteuid(getuid());
	if(me->query("id")!=ob->query("own_name")) {
		printf("这不是你的东西，你不能用!\n");
		return 1;
	}
	if(!(ob = me->query_temp("weapon") ) ){
		message_vision("$N运足力气，两手抓住一块木头，可是怎么也劈不开。\n",me);
		return 1;
	}
	if( ob->query("name") == "斧头" ){
		if( me->query_temp("sleeping") )
			return notify_fail("你正在睡眠中，不能干别的。\n");
		if( me->query_temp("dazuo") )
			return notify_fail("你正在打坐练功，不能干别的。\n");
		if( me->is_fighting() )
			return notify_fail("你已经在战斗中了，专心点吧。\n");

		kee_cost=40+(30-me->query("int"));
		if (kee_cost<1) kee_cost=1;
		if( me->query("kee") < kee_cost) 
			return notify_fail("休息一下吧，你现在太累了。\n");
		me->receive_damage("kee", kee_cost);
		if(me->query("shaolin/renwu_type")!="劈柴"){
			if(me->query_skill("unarmed",1)>30)
				return notify_fail("你抡起斧头劈了一会柴，发现对你已没什么用了。\n");
			skill_n=me->query_skill("unarmed",1);
			if(skill_n*skill_n*skill_n/10 >me->query("combat_exp")) 
				return notify_fail("也许是缺乏经验吧，你抡起斧头劈了一会柴，好象没有什么收获。\n");
			message_vision("$N抡起斧头劈了一会柴，好象学到什么。\n", me);
			nn=(me->query("int")-20);
			if(nn<1) nn=1;
			me->improve_skill("unarmed",nn,0);
			return 1;
		}
		else {
			if(me->query("shaolin/renwu_nn")==0) 
				return notify_fail("你已经完成任务，快回去汇报吧。\n");
			me->add("shaolin/renwu_nn",-1);
			if(random(me->query("kar"))>13){
				me->add("combat_exp", 10);
				me->add("potential", 5);
			}
			return notify_fail("你抡起斧头劈了一会柴。\n");
		}
	}
	else {
		message_vision("有没有搞错？看清楚你手里拿的是什么？\n", me);
		return 1;
	}
	return 0;
}

