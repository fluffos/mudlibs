//shushang.c  汉柏树上

inherit ROOM;

void create()
{
        set("short", "汉柏树上");
        set("long", @LONG
汉柏树树叶茂密，枝干粗大，躲在这上面，下面的人根本看不到。
LONG
        );
        set("exits", ([/* sizeof() == 3 */
           "down"  : __DIR__"xiaoyuan1",
]));
	set("item_desc",([
	"树叶"	:"透过茂密的树叶，可以看到北面藏经阁的二楼。\n",
	]));

        set("no_clean_up", 0);

        setup();
}

void init()
{
	add_action("do_climb", ({"climb","pa"}));
}

int do_climb(string arg)
{
	object me = this_player();
	object room;

	if(!arg) return 0;
	if(arg!="枝干") return 0;
	if(random(me->query("kar"))<15) {
		write("你两手紧紧攀着汉柏树的枝干，费劲地往前爬，一不小心，你摔了下来！\n");
		room = (object)__DIR__"xiaoyuan1";
		message("vision", me->query("name")+"走了过来。\n",room );
		me->move(room);
		message("vision", me->query("name")+"一不小心，一声惨叫，掉了下去。\n",this_object());
		return 1;
	}
	write("你两手紧紧攀着汉柏树的枝干，费劲地往前爬，居然爬到藏经阁二楼的窗台上。\n");
	room = (object)__DIR__"cjge21";
	message("vision", "只见"+me->query("name")+"吃力地从南面爬了过来。\n",room );
	me->move(room);
	message("vision", me->query("name")+"往下离去。\n",this_object());
	return 1;
	
}
