string look_sign(object me);
void do_huan(object me,int nn,string * winers);
void do_gongxi(object me,int nn,string * winers);

void create()
{
	if( !restore() ) {
        set("short", "少林比武场");
        set("long", @LONG
你来到少林寺的比武场。方圆几十丈，极为宽阔。青石铺地，是少
林弟子竞技武技的地方，也是少林各院选拔精干弟子的地方。场上正有
两个少林弟子正在比武，你来我往，拳打脚踢，好不热闹。
    比武难免有失手之时，但在这里大家是不计较的，放心打吧。
    比武场边上还竖着一块木牌（sign）。
    这里也是苍松翠柏，古树参天。东西是少林各个禅院和禅堂。
LONG
        );
	set("winer",({
" "," "," ",
" "," "," ",
" "," "," ",
" "," "," ",
" "," "," ",
" "," "," ",
" "," "," ",
" "," "," ",
" "," "," ",
" "," "," "
}) );
	set("exits", ([/* sizeof() == 4 */
       "east"  : __DIR__"xiaoyuan1",
       "south" : __DIR__"dxbdian",
       "west"  : __DIR__"zoulang3",
       "north" : __DIR__"dzdian",
]));
}
	set("item_desc", ([ /* sizeof() == 1 */
		"sign" : (: look_sign :),
]));
//		set("winer",({"sasas","sasa","asaas"}));
		set("no_dead", 1);
        set("no_sleep", 1);
        set("no_clean_up", 0);
	set("outdoors","shaolin");

        setup();
//        replace_program(ROOM);
}

string look_sign(object me)
{
	string * winers, msg;
	int i;

	winers = query("winer");
	msg = HIY"           少林寺十大弟子排名榜\n"NOR;
	msg = msg + "==============================================\n\n";
	if ( pointerp(winers) && sizeof(winers) ) {
		i=0;
		msg=msg+HIR+sprintf("第%s名：%-22s  %s  %s\n"NOR,chinese_number(i/3+1),winers[i+2],winers[i+1],winers[i]);
		for(i=3;i<9;i+=3) {
		  msg=msg+HIM+sprintf("第%s名：%-22s  %s  %s\n"NOR,chinese_number(i/3+1),winers[i+2],winers[i+1],winers[i]);
		}
		for(i=9;i<18;i+=3) {
		  msg=msg+HIY+sprintf("第%s名：%-22s  %s  %s\n"NOR,chinese_number(i/3+1),winers[i+2],winers[i+1],winers[i]);
		}
		for(i=18;i<30;i+=3) {
		  msg=msg+HIW+sprintf("第%s名：%-22s  %s  %s\n"NOR,chinese_number(i/3+1),winers[i+2],winers[i+1],winers[i]);
		}
//		for(i=0;i<sizeof(winers);i+=3) {
//			msg=msg+HIM+sprintf("第%s名：%-22s  %s  %s\n"NOR,chinese_number(i/3+1),winers[i+2],winers[i+1],winers[i]);
//		}
	}
	msg = msg + "\n==============================================\n\n";
	msg = msg + HIY"                       少林寺方丈室告示\n\n"NOR;
	return msg;
}


void init()
{
//		add_action("do_addkiller", "addkiller");
//		add_action("do_delkiller", "delkiller");
}

string query_save_file() { return "/u/playboy/shaolin/bwchang"; }

void do_check(object me,object vv)
{
	string * winers;
	object obj;
	int i,ii,jj;

	if(me->query("class")!="shaolin" && me->query("class")!="shaolin1") return;
	if(vv->query("class")!="shaolin" && vv->query("class")!="shaolin1") return;
	if(me->query("id")=="tian"&&wizardp(vv)) return;
	if(vv->query("id")=="tian"&&wizardp(me)) return;
	if(me->query("id")!="tian"&&vv->query("id")!="tian")
		if(wizardp(me)||wizardp(vv)) return;
	message_vision( MAG"比武结果：$N战胜$n ！\n\n"NOR,me,vv);
	message("channel:chat",MAG + "【少林快讯】"YEL+me->query("name")+MAG"在比武中战胜"YEL+vv->query("name")+MAG"!!\n"+ NOR ,users());

//	obj = find_player(me);
	winers = query("winer");
	if( pointerp(winers)){
		ii=member_array(me->query("id"), winers);
		jj=member_array(vv->query("id"), winers);

		if(ii!=-1) do_huan(me,ii,winers);
		if(jj!=-1) do_huan(vv,jj,winers);
//我在，他不在
		if(ii!=-1&&jj==-1) return;
//都不在
		if(ii==-1&&jj==-1){
			for(i=0;i<sizeof(winers);i+=3) {
				if(winers[i]==" "){
					do_huan(me,i,winers);
					do_gongxi(me,i,winers);
					return;
				}
			}
			return;
		}
//他在，我不在
		if(ii==-1&&jj!=-1){
			if(jj<27){
				for(i=29;i>=(jj+3);i--){
					winers[i]=winers[i-3];
				}
			}
			do_huan(me,jj,winers);
			do_gongxi(me,jj,winers);
			return;
		}
//他在前,我在后
		if(ii>jj){
			for(i=ii;i>jj;i--){
				winers[i+2]=winers[i-1];
			}
			do_huan(me,jj,winers);
			do_gongxi(me,jj,winers);
			return;
		}			
//我在前
		if(ii<jj) return;

	}

	return;
}

void do_gongxi(object me,int nn,string * winers)
{
	set("winer", winers);
	save();
message("channel:chat",MAG + "【少林快讯】恭喜"YEL+me->query("name")+MAG"成为少林第"+chinese_number(nn/3+1)+"名高手!!\n"+ NOR ,users());
	return;
}

void do_huan(object me,int nn,string * winers)
{
	winers[nn]=me->query("id");
	winers[nn+1]=me->query("name");
	winers[nn+2]=me->query("title");
	return;
}