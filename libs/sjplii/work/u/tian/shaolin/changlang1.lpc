// changlang1 长廊

#include <room.h>
inherit ROOM;

void create() {
  set("short", "长廊");
  set("long", @LONG
你走在一条长廊上，架上青藤缠绕，紫色的小花散发着淡淡的清香。
东面是讲经台，北面是罗汉堂。
LONG
  );

  set("exits", ([
    "east": __DIR__ "jjtai",
    "west": __DIR__ "changlang2",
    "north": __DIR__ "lhtang",
  ]));

  setup();
  replace_program(ROOM);
}
