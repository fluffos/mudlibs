// zoulang3.c 走廊

#include <room.h>
inherit ROOM;

void create() {
  set("short", "走廊");
  set("long", @LONG
你走在一条走廊上，走廊上面雕梁画柱，画着一些佛家的故事。
往东是比武场,北面是般若堂。
LONG
  );

  set("exits", ([
    "east": __DIR__ "bwchang",
    "west": __DIR__ "zoulang4",
    "north": __DIR__ "brtang",
  ]));

  setup();
}
