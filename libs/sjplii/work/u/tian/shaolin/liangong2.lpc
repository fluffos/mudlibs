//liangong2  练功房

inherit ROOM;

void create() {
  set("short", "练功房");
  set("long", @LONG
这里是少林寺的练武房。平时寺里的武僧在这里勤练武功，
房里地面由一块块坚硬的青石铺就。武僧成年累月地踩踏已使得
这些青石平整光滑，上面清晰可见一个个浅浅的凹坑。房间里有
几个武僧正在汗流浃背地练功。
    南面是间练功房，里面传来阵阵练武的吆喝声。
LONG
  );
  set("exits", ([ /* sizeof() == 1 */
    "south": __DIR__ "liangong1",
  ]));
  set("objects", ([
    //	__DIR__"npc/muren1" : 2,
    __DIR__ "obj/muhammer": 1,
  ]));

  set("no_sleep", 1);
  set("no_clean_up", 0);

  setup();
}
