// lingzhi.c 千年灵芝
#include <ansi.h>

inherit ITEM;

void init() {
  add_action("do_eat", "eat");
}

void create() {
  set_name(HIW "千年灵芝" NOR, ({ "lingzhi" }));
  set_weight(20);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "枚");
    set("long", "这是一枚" HIW "千年灵芝" NOR "，看上去就有一股仙气。\n");
    set("value", 100000);
  }
  setup();
}

int do_eat(string arg) {
  object me = this_player();

  if (!id(arg))
    return notify_fail("你要吃什么？\n");

  me->set("eff_gin", (int)me->query("max_gin"));
  me->set("gin", (int)me->query("max_gin"));
  me->set("eff_kee", (int)me->query("max_kee"));
  me->set("kee", (int)me->query("max_kee"));
  me->set("eff_sen", (int)me->query("max_sen"));
  me->set("sen", (int)me->query("max_sen"));

  me->set("atman", ((int)me->query("max_atman")) * 2 - 1);
  me->set("mana", ((int)me->query("max_mana")) * 2 - 1);
  me->set("force", ((int)me->query("max_force")) * 2 - 1);
  message_vision("$N吃下一枚" HIW "千年灵芝" NOR "，只觉得体内真力源源滋生，身体完全恢复！\n" NOR, me);

  destruct(this_object());
  return 1;
}
