// book.c 书

inherit ITEM;

void create() {
  set_name("达摩院的书", ({ "book", }));
  set_weight(600);
  set("unit", "本");
  set("long", "一本少林达摩院珍藏的别派的武功秘籍。\n");
  set("value", 0);
  set("skill", ([
    "name": "literate",
    "exp_required": 10000,
    "sen_cost": 20,
    "difficulty": 30,
    "max_skill": 30
  ]));
}

void init() {
  add_action("do_du", ({ "study", "du" }));
  add_action("do_kan", ({ "read" }));
}

int do_du(string arg) {
  write("这东西好象不能读！\n");
  return 1;
}
int do_kan(string arg) {

  object ob, me = this_player();
  int my_skill;
  int cost;
  mapping skill;

  if (!arg || !(ob = present(arg, me))) return 0;

  skill = ob->query("skill");
  if (me->query("class") != "shaolin" && me->query("class") != "shaolin1") return 0;
  if (me->query_temp("sleeping") || me->query_temp("dazuo") || me->is_fighting()) {
    write("你现在无法学习！\n");
    return 1;
  }
  if (me->query("id") != this_object()->query("own_name")) {
    write("这不是你的东西，你不能读!\n");
    return 1;
  }
  if (!ob->query("skill/name")) {
    write("你好象从中学不到什么东西！\n");
    return 1;
  }

  if (!me->query_skill("literate", 1)) {
    write("你是个文盲，先学学读书识字(literate)吧。\n");
    return 1;
  }

  message("vision", me->name() + "专心看一本书。\n", environment(me), me);

  if ((int)me->query("combat_exp") < skill["exp_required"]) {
    write("你的实战经验不足，再怎麽读也没用。\n");
    return 1;
  }

  //	if( !SKILL_D(skill["name"])->valid_learn(me) ) return 0;

  cost = skill["sen_cost"] + skill["sen_cost"] * (skill["difficulty"] - (int)me->query("int")) / 20;
  //printf("%d ",cost);
  if ((int)me->query("sen") < cost) {
    write("你现在过於疲倦，无法专心下来研读新知。\n");
    return 1;
  }

  //	if( me->query_skill(skill["name"], 1) > skill["max_skill"] ) {
  //		write("你研读了一会儿，但是发现上面所说的对你而言都太浅了，没有学到任何东西。\n");
  //		return 1;
  //	}

  me->receive_damage("sen", cost);

  if (!me->query_skill(skill["name"], 1))
    me->set_skill(skill["name"], 0);

  my_skill = me->query_skill(skill["name"], 1);
  if (my_skill > (me->query("kar") - 14) * 10) {
    write("好象是缘分已尽，你再怎么读也没用。\n");
    return 1;
  }
  if (my_skill * my_skill * my_skill / 10 > (int)me->query("combat_exp")) {
    write("也许是缺乏实战经验，你没有任何收获。\n");
    return 1;
  }

  me->improve_skill(skill["name"], (int)me->query_skill("literate", 1) / 5 + 1);
  write("你研读有关" + to_chinese(skill["name"]) + "的技巧，有点心得。\n");
  return 1;
}
