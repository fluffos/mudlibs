// chabei.c 

inherit ITEM;
inherit F_LIQUID;

void create()
{
	set_name("茶杯", ({ "cha bei","cup" }));
	set_weight(1000);
	if( clonep() ) set_default_object(__FILE__);
	else {
		set("long","这是一杯凉茶，不过看起来是上等茶叶沏的。\n");
		set("unit", "杯");
		set("value", 0);
		set("max_liquid", 5);
	}
	set("liquid", ([
		"name" : "茶水",
		"remaining" : 5,
		"type" : "water"
	]) );
	set("liquid_type", "water");
	setup();
}
