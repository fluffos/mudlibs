// muhammer.c 木鱼槌

#include <weapon.h>

inherit HAMMER;

void create() {
  set_name("木鱼槌", ({ "muyu chui", "hammer", "chui" }));
  set_weight(350);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一根很普通的木槌，是僧人敲打木鱼念经用的。\n");
    set("unit", "根");
    set("value", 1);
    set("wield_msg", "$N抓起一根$n，握在手中当武器。\n");
  }
  init_hammer(1);
  setup();
}
