// ptyuan  菩提院
#include <room.h>
inherit ROOM;

void create()
{
	set("short", "菩提院");
	set("long", @LONG
这里是菩提院。布置简单，正中一尊佛像，其它空空如也。
LONG
	);

	set("exits", ([
            "south": __DIR__"changlang3",
	]));
	
	set("item_desc",([
	"佛像"	:"佛像两旁各有一首佛偈。前面供桌两边插着粗大的蜡烛，中间一个玉瓶。\n",
	"玉瓶" :"一个碧玉瓶，晶莹剔透，甚是精巧。\n",
	"佛像左":"\n心似菩提树，身如明净台，
早晚勤拂拭，勿使染尘埃。\n\n",
	"佛像右":"\n菩提本非树，明净亦非台，
本来无一物，何处染尘埃。\n\n",
	]));

	set("objects",([
	__DIR__"npc/jingsi" : 1,
	]));

	setup();
//	replace_program(ROOM);
}
