inherit ROOM;

void create()
{
        set("short", "一苇亭");
        set("long", @LONG
传说当年达摩祖师云游至汉水江畔，江水滚滚，不能前行。达摩
祖师略施神通，脚踏一片苇叶，飘然过江。后人建此亭纪念之。亭中
一张石桌，几个石凳，供游人歇息。亭顶似乎画着一幅画。
LONG
        );
        set("exits", ([/* sizeof() == 2 */
            "northeast" : __DIR__"shanlu2",
            "southdown" : __DIR__"shanlu3",
]));
	set("objects",([
	__DIR__"npc/xiaofan" : 1,
	]));
	set("item_desc",([
	"亭顶"	:"亭顶画着一幅达摩渡江图。\n",
	]));

	set("outdoors","shaolin");
        set("no_clean_up", 0);

        setup();
        replace_program(ROOM);
}

