//ciayuan  菜园
inherit ROOM;

void create()
{
        set("short", "菜园");
        set("long", @LONG
这里是寺里的菜园。面积很大，各种蔬菜瓜果，长势喜人，南面一
大片油菜正值开花时节，引来许多蜜蜂。北面一间草屋，门旁一口水井，
井水清凉，深不见底。不时有和尚在这里挑水(tiaoshui)，东面高高的
围墙，青砖砌成。
LONG
        );
        set("exits", ([/* sizeof() == 1 */
           "west"  : __DIR__"xiaoyuan5",
           "north"  : __DIR__"caiyuan1",
]));
	set("objects",([
	__DIR__"npc/bee" : 2,
	__DIR__"npc/tiaoshuiseng": 1 ,
	]));

	set("outdoors","shaolin");
        set("no_clean_up", 0);

        setup();
//        replace_program(ROOM);
}


void init()
{
      	add_action("do_tiaoshui", ({"tiaoshui"}));
}


int do_tiaoshui()
{
	object me = this_player(),ob;
	int nn,skill_n,kee_cost;

	if(me->query("class")!="shaolin1" && me->query("class")!="shaolin") return 0;
	if(!(ob=present("biandan",me))) return 0;
	seteuid(getuid());
	if(me->query("id")!=ob->query("own_name")) {
		printf("这不是你的东西，你不能用!\n");
		return 1;
	}
	if(!(ob = me->query_temp("weapon") ) ){
		message_vision("$N爬在井口看了看，水面太低，用手是够不到的。\n",me);
		return 1;
	}
	if( ob->query("name") == "扁担" ){
		if( me->query_temp("sleeping") )
			return notify_fail("你正在睡眠中，不能干别的。\n");
		if( me->query_temp("dazuo") )
			return notify_fail("你正在打坐练功，不能干别的。\n");
		if( me->is_fighting() )
			return notify_fail("你已经在战斗中了，专心点吧。\n");

		kee_cost=40+(30-me->query("int"));
		if (kee_cost<1) kee_cost=1;
		if( me->query("kee") < kee_cost) 
			return notify_fail("休息一下吧，你现在太累了。\n");
		me->receive_damage("kee", kee_cost);
		if(me->query("shaolin/renwu_type")!="挑水"){
			if(me->query_skill("dodge",1)>30)
				return notify_fail("你飞快地挑了一挑水，发现对你已没什么用了。\n");
			skill_n=me->query_skill("dodge",1);
			if(skill_n*skill_n*skill_n/10 >me->query("combat_exp")) 
				return notify_fail("也许是缺乏经验吧，你挑了一挑水，好象没有什么收获。\n");
			message_vision("$N飞快地挑了一挑水，好象学到什么。\n", me);
			nn=(me->query("int")-20);
			if(nn<1) nn=1;
			me->improve_skill("dodge",nn,0);
			return 1;
		}
		else {
			if(me->query("shaolin/renwu_nn")==0) 
				return notify_fail("你已经完成任务，快回去汇报吧。\n");
			me->add("shaolin/renwu_nn",-1);
			if(random(me->query("kar"))>13){
				me->add("combat_exp", 10);
				me->add("potential", 5);
			}
			return notify_fail("你飞快地挑了一挑水。\n");
		}
	}
	else {
		message_vision("有没有搞错？看清楚你手里拿的是什么？\n", me);
		return 1;
	}
	return 0;
}

