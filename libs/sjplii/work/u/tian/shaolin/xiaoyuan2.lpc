//xiaoyuan2  小院
inherit ROOM;

void create()
{
        set("short", "小院");
        set("long", @LONG
这是一个幽静的小院，没有前院熙熙攘攘的游人，顿时安静了许多。
小院中栽着两颗汉柏树，树身扭结上耸，若虬龙蟠曲，虽肤剥心枯，但
又续生新枝，苍古葱郁，真为绝奇。
    北面是少林寺心禅堂，东面是几间僧舍。
LONG
        );
        set("exits", ([/* sizeof() == 3 */
           "east"  : __DIR__"wsshe2",
           "west"  : __DIR__"xiaoyuan1",
           "north" : __DIR__"xctang",
]));
