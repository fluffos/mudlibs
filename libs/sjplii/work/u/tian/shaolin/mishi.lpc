#include <room.h>

inherit ROOM;

void create() {
  set("short", "密室");
  set("long", @LONG
你进入了一个密室，抬头一看，只见四面石壁光秃秃黑黝黝的，虽
然这里已是山腹，但里面的空气清凉，并不闷热。相传南天竺僧人菩提
达摩来到少林寺，见此风水宝地，就住下来广罗弟子，传授禅宗，开创
少林寺佛教禅宗千年不败之基。达摩祖师常在此面壁悟道，一坐十年，
终于大彻大悟，破壁而出。壁间隐隐似仍可看到他面壁时的打坐姿态。
LONG
  );
  set("exits", ([ /* sizeof() == 1 */
    "east": __DIR__ "hole1",
  ]));


  set("no_clean_up", 0);

  setup();

}
