{
        set("short", "武僧舍");
        set("long", @LONG
这里是寺里的武僧居住的地方。三张床，三把椅子，三个小桌。
屋里收拾的干净利索，几个僧人正在休息。
    南北两头各有一间武僧舍，西面是个小院。
LONG
        );
        set("exits", ([/* sizeof() == 3 */
           "south" : __DIR__"wsshe1",
           "west"  : __DIR__"xiaoyuan2",
           "north" : __DIR__"wsshe3",
]));
	set("objects",([
	__DIR__"npc/wuseng1" : 3,
	]));

        set("no_clean_up", 0);

        setup();
        replace_program(ROOM);
}