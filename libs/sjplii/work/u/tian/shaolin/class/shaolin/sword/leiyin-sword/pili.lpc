//pili.c 霹雳三剑

#include <ansi.h>

inherit SSERVER;

int perform(object me, object target) {
  int dodge, sword;
  object ob;

  if (!target) target = offensive_target(me);

  if (!target || !target->is_character() || !me->is_fighting(target))
    return notify_fail("你现在没有作战，怎么用[霹雳三剑]呢？\n");

  if (me->query_skill("leiyin-sword", 1) < 80)
    return notify_fail("你的雷音剑法修行不够!\n");
  if (!(ob = me->query_temp("weapon")) || (string)ob->query("skill_type") != "sword")
    return notify_fail("你不拿剑怎么用[霹雳三剑]？\n");
  if ((int)me->query("force") < 500)
    return notify_fail("你现在内力太弱，不能使用[霹雳三剑]。\n");
  me->add("force", -100);

  message_vision(HIW "$N高高跃起，使出绝技[霹雳三剑]，直向$n袭来！\n" NOR, me, target);
  me->start_busy(2);

  dodge = me->query_skill("dodge") / 4;
  sword = me->query_skill("sword") / 4;
  me->add_temp("apply/defense", dodge);
  me->add_temp("apply/attack", sword);

  message_vision("\n只见$N凌空直下\n", me, target);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0);
  message_vision("\n只见$N凌空直下\n", me, target);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0);
  message_vision("\n只见$N凌空直下\n", me, target);
  COMBAT_D->do_attack(me, target, me->query_temp("weapon"), 0);

  me->add_temp("apply/defense", -dodge);
  me->add_temp("apply/attack", -sword);

  return 1;
}
