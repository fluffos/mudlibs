//dmyuan1 达摩院内室
inherit ROOM;

void create()
{
        set("short", "达摩院内室");
        set("long", @LONG
这是达摩院内室。靠墙一排樟木书架收藏有天下各个门派的武功秘
籍，由少林寺中悟性极高，武艺超群的弟子钻研学习，一般人不能进入。
这里正有几个面目清瘦的老和尚闭目打坐，潜心修炼。
LONG
        );
        set("exits", ([/* sizeof() == 1 */
           "south"  : __DIR__"dmyuan",
]));
	set("item_desc",([
	"书架"	:"一排高大的书架，分成好多格子，上写各个门派的名字。\n",
	"门派名字"	:"现有门派有武当、华山、丐帮、神剑、逍遥、紫龙、青龙、落月、魔教、
茅山、晚月、古墓、天邪、封山等等。\n",
	]));

        set("no_clean_up", 0);

        setup();
//        replace_program(ROOM);
}

void init()
{
	add_action("do_search", ({"search","zhao"}));
	add_action("do_put", ({"put"}));
}

int do_put(string arg)
{
	
	write("不要偷藏东西！\n");
	return 1;

}

int do_search(string arg)
{
	object ob,ob1,me = this_player();
	string sth,sb;

	if(!arg) return 0;
	if(sscanf(arg, "%s %s", sth, sb)!=2 ) return 0;
	if(sth!="格子") return 0;
	if(me->query("class")!="shaolin"&&me->query("class")!="shaolin1") return 0;
	if(me->query_temp("dm_get")){
		write("你刚刚已经拿过了，不能再拿了！\n");
		return 1;
	}
	switch(sb){
		case "武当":
			ob = new(__DIR__"obj/book");
			ob->set("skill/name","taiji-ken");
			ob1 = new(__DIR__"obj/book");
			ob1->set("skill/name","taiji-sword");
		break;
		case "华山":
			ob = new(__DIR__"obj/book");
			ob->set("skill/name","huashan-strike");
			ob1 = new(__DIR__"obj/book");
			ob1->set("skill/name","huashan-sword");
		break;
		case "丐帮":
			ob = new(__DIR__"obj/book");
			ob->set("skill/name","hitdog");
			ob1 = new(__DIR__"obj/book");
			ob1->set("skill/name","hl18-strike");
		break;
		case "神剑":
			write("神剑山庄的武功秘籍暂缺！\n");
			return 1;
		break;
		case "逍遥":
			ob = new(__DIR__"obj/book");
			ob->set("skill/name","wh-strike");
			ob1 = new(__DIR__"obj/book");
			ob1->set("skill/name","wx-sword");
		break;
		case "紫龙":
			ob = new(__DIR__"obj/book");
			ob->set("skill/name","dragon_strike");
			ob1 = new(__DIR__"obj/book");
			ob1->set("skill/name","dragon-steps");
		break;
		case "青龙":
			write("青龙的武功秘籍暂缺！\n");
			return 1;
		break;
		case "落月":
			write("这个门派的武功秘籍暂缺！\n");
			return 1;
//			ob = new(__DIR__"obj/book");
//			ob->set("skill/name","luanyu-strike");
//			ob1 = new(__DIR__"obj/book");
//			ob1->set("skill/name","luoyue-sword");
		break;
		case "魔教":
			write("这个门派的武功秘籍暂缺！\n");
			return 1;
//			ob = new(__DIR__"obj/book");
//			ob->set("skill/name","magicblade");
//			ob1 = new(__DIR__"obj/book");
//			ob1->set("skill/name","tenderzhi");
		break;
		case "茅山":
			ob = new(__DIR__"obj/book");
			ob->set("skill/name","taoism");
			ob1 = new(__DIR__"obj/book");
			ob1->set("skill/name","necromancy");
		break;
		case "晚月":
			ob = new(__DIR__"obj/book");
			ob->set("skill/name","snowwhip");
			ob1 = new(__DIR__"obj/book");
			ob1->set("skill/name","whip");
		break;
		case "古墓":
			ob = new(__DIR__"obj/book");
			ob->set("skill/name","tldw-shi");
			ob1 = new(__DIR__"obj/book");
			ob1->set("skill/name","wave-step");
		break;
		case "天邪":
			ob = new(__DIR__"obj/book");
			ob->set("skill/name","celestrike");
			ob1 = new(__DIR__"obj/book");
			ob1->set("skill/name","six-chaos-sword");
		break;
		case "封山":
			ob = new(__DIR__"obj/book");
			ob->set("skill/name","liuh-ken");
			ob1 = new(__DIR__"obj/book");
			ob1->set("skill/name","fonxansword");
		break;
        default:
			return notify_fail("好象没有这个门派！\n");
	}
	write("你从格子上找到两本书。\n");
	ob->set("own_name",me->query("id"));
	ob->set("skill/sen_cost",40-me->query("kar"));
	ob->set("skill/difficulty",50-me->query("kar"));
	ob->move(me);

	ob1->set("own_name",me->query("id"));
	ob1->set("skill/sen_cost",40-me->query("kar"));
	ob1->set("skill/difficulty",50-me->query("kar"));
	ob1->move(me);
	me->set_temp("dm_get", 1);
	return 1;
}

