// taoist_guard.c  by baiwt@sjpl 5,17,2000
//法术：［怨魂聚］ 属性：召唤  对象：冤魂  克星：无
//法术：［病魇符］ 属性：heal  对象：me    克星：无
#include <ansi.h>
inherit NPC;
int magic_more( object who);

void create()
{
        set_name("瘟神", ({ "wenshen", "taoist guard" }) );
	set("gender", "男性");
	set("age", 50);
        set("attitude", "peaceful");
        set("long", "人间之病魔，掌管自然界之百病万毒。\n");

 	set("mguard", "mguard57");
 	set("mguard_level", 57);
	set("magic_power", 3000);
           set("last_load_time", uptime());

	set("str", 92);
	set("cor", 52);
	set("cps", 22);
	set("max_mana", 2500);
	set("mana", 2500);

	set("max_kee", 4000);
	set("max_gin", 4000);
	set("max_sen", 4000);

        set("combat_exp", 10000000);
        set_skill("dodge", 200);
        set("chat_chance_combat", 50);
        set("chat_msg_combat", ({
		(: magic_more(this_object()) :),
        }) );
	set_temp("super_damage",86400*7);

        set_temp("apply/attack", 20);
        set_temp("apply/damage", 20);
	set_temp("apply/defence",20);
	set_temp("apply/armor",20);
	setup();
	carry_object("/d/city/obj/cloth/pobuyi")->wear();

}
int magic_more(object who)
{
	int i, mwp;
	object *enemy,mygod;
	seteuid(getuid());
	enemy = who->query_enemy();
	mwp = who->query("magic_power");
	i = sizeof(enemy);
	while(i--) {
		if( enemy[i] && living(enemy[i]) ) {
			if( who->query("mana") < 50 )  return 1;
	if (!objectp(present("yuanhun", environment(who))))
	{
		mygod = new("/daemon/troop/maoshan/yuanhun");
		message_vision(HIB"\n$N喃喃念动咒语，只见一张符纸缓缓飘上半空。"NOR,who,enemy[i]);
		message_vision(HIB"\n不久只见四周响起鬼哭魂号之声，令人寒毛直竖！"NOR,who,enemy[i]);
		message_vision(HIB"\n随着一声怪叫，冤魂的身影渐渐在黑暗中浮现出来。\n"NOR,who,enemy[i]);
		message_vision(HIG"［怨魂聚］！\n\n"NOR,who,enemy[i]);
		mygod->move(environment(who));
		mygod->set("player_guard","wenshen");
		if( userp(enemy[i]) || enemy[i]->query("id")!="yuanhun" )
		mygod->kill_ob(enemy[i]);
		if( who->query("mana") >= 50 )
		who->add("mana", -50);
	return 1;
	}
		else { mygod = present("yuanhun", environment(who) );
		if( enemy[i]->query("id")!="yuanhun" && mygod->query("player_guard")=="wenshen" )
		mygod->kill_ob(enemy[i]);
		else mygod->remove_all_killer();
		}
	if( who->query("kee") < who->query("max_kee")*3/4 )
	{
	message_vision(HIC"\n$N发出奇怪的呻吟声，只见地上冒起无数骷髅头。"NOR,who);
	message_vision(HIC"\n$N伸手一拍，将那些骷髅头拍成无数细粉，然后一口吸了进去！"NOR,who);
	message_vision(HIC"\n不久只见$N满脸病态，全身流出脓汁，伤口竟然都痊愈了。\n"NOR,who);
	message_vision(HIG"［病魇符］！\n\n"NOR,who);
       who->receive_curing("kee", 1000);
       who->receive_heal("kee", 1000);
       who->receive_curing("sen", 1000);
       who->receive_heal("sen", 1000);
       who->receive_curing("gin", 1000);
       who->receive_heal("gin", 1000);
	if( who->query("mana") >= 50 )
	who->add("mana", -50);
	if( !who->query_soft_powerup() )
		who->soft_powerup(30,30);
	COMBAT_D->report_status(who,1);
	}
	enemy[i]->set_delay(5);
	if( enemy[i]->query("force")>100 ) enemy[i]->add("force",-100);

		}
	}
	return 1;
}

int heal_up()
{
	object who=this_object();
	if( !who->is_fighting() && (uptime()-(int)who->query("last_load_time")) > (random(500)+300) )
	{
		call_out("leave", 1);
		return 1;
	}
	return ::heal_up() + 1;
}

void leave()
{
	message("vision",
		 HIW + name() + "的身影渐渐虚化，变做了一道白烟。\n\n"
		 "白烟随风飘散，很快消失了......\n"NOR , environment(),
		this_object() );
	destruct(this_object());
}

void die()
{
	object who;
	seteuid(getuid());
	who = this_object();
	if( who->query_temp("already_die") < 3 )
	{
	message_vision(HIW"\n$N发出奇怪的呻吟声，只见地上冒起无数骷髅头。"NOR,who);
	message_vision(HIW"\n$N伸手一拍，将那些骷髅头拍成无数细粉，然后一口吸了进去！"NOR,who);
	message_vision(HIW"\n不久只见$N满脸病态，全身流出脓汁，伤口竟然都痊愈了。\n"NOR,who);
	message_vision(HIG"［病魇符］！\n\n"NOR,who);
       who->receive_curing("kee", 1000);
       who->receive_heal("kee", 1000);
       who->receive_curing("sen", 1000);
       who->receive_heal("sen", 1000);
       who->receive_curing("gin", 1000);
       who->receive_heal("gin", 1000);
	who->add_temp("already_die",1);
	who->remove_busy();
	if( !who->query_soft_powerup() )
		who->soft_powerup(30,30);

	}
	else
	::die();
}
