//法术：［天医神药］ 属性：heal  对象：me  克星：无
#include <ansi.h>
inherit NPC;
int magic_more(object who);

void create() {
  set_name("天将", ({ "tianjiang", "taoist guard" }));
  set("gender", "男性");
  set("age", 40);
  set("attitude", "peaceful");

  set("mguard", "mguard54");
  set("mguard_level", 54);
  set("magic_power", 3000);
  set("last_load_time", uptime());

  set("str", 92);
  set("cor", 52);
  set("cps", 22);
  set("max_mana", 2500);
  set("mana", 2500);

  set("max_kee", 3000);
  set("max_gin", 3000);
  set("max_sen", 3000);
  set_skill("unarmed", 200);
  set_skill("dodge", 200);
  set_skill("sword", 200);
  set_skill("parry", 200);
  set_skill("dodge", 200);
  set_skill("iron-cloth", 300);
  set_skill("jinzhong_zhao", 300);
  set_skill("heaven-sword", 200);
  map_skill("sword", "heaven-sword");
  map_skill("parry", "heaven-sword");
  map_skill("iron-cloth", "jinzhong_zhao");

  set("combat_exp", 10000000);

  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: magic_more(this_object()) :),
  }));
  set_temp("super_damage", 86400 * 7);

  set_temp("apply/sword", 300);
  set_temp("apply/damage", 120);
  set_temp("apply/parry", 200);
  set_temp("apply/armor", 20);
  setup();
  carry_object("/obj/npc/obj/golden_armor")->wear();
  carry_object("/obj/npc/obj/golden_sword")->wield();

}
int magic_more(object who) {
  int i, mwp;
  object *enemy;
  seteuid(getuid());
  enemy = who->query_enemy();
  mwp = who->query("magic_power");
  i = sizeof(enemy);
  while (i--) {
    if (enemy[i] && living(enemy[i])) {
      if (who->query("mana") < 50) return 1;
      if (who->query("kee") < who->query("max_kee") * 3 / 4) {
        message_vision(HIC "\n$N一声召唤，身边忽然现出一位天宫御医。" NOR, who);
        message_vision(HIC "\n那御医伸手一指，眨眼变出了仙丹活骨灵药和地脉血泉！" NOR, who);
        message_vision(HIC "\n御医将活骨灵药敷在$N伤口上，又给$N服下地脉血泉，$N的伤口愈合了。\n" NOR, who);
        message_vision(HIG "［天医神药］！\n\n" NOR, who);
        who->receive_curing("kee", 1000);
        who->receive_heal("kee", 1000);
        who->receive_curing("sen", 1000);
        who->receive_heal("sen", 1000);
        who->receive_curing("gin", 1000);
        who->receive_heal("gin", 1000);
        if (who->query("mana") >= 50)
          who->add("mana", -50);
        if (!who->query_soft_powerup())
          who->soft_powerup(30, 30);

        COMBAT_D->report_status(who, 1);
        return 1;
      }
      enemy[i]->set_delay(5);
      if (enemy[i]->query("force") > 100) enemy[i]->add("force", -100);
    }
  }
  return 1;
}

int heal_up() {
  object who = this_object();
  if (!who->is_fighting() && (uptime() - (int)who->query("last_load_time")) > (random(500) + 300)) {
    call_out("leave", 1);
    return 1;
  }
  return ::heal_up() + 1;
}

void leave() {
  message("vision",
    HIW + name() + "的身影渐渐虚化，变做了一道白烟。\n\n"
    "白烟随风飘散，很快消失了......\n" NOR, environment(),
    this_object());
  destruct(this_object());
}

void die() {
  object who;
  seteuid(getuid());
  who = this_object();
  if (who->query_temp("already_die") < 3) {
    message_vision(HIY "\n$N一声召唤，身边忽然现出一位天宫御医。" NOR, who);
    message_vision(HIY "\n那御医伸手一指，眨眼变出了仙丹活骨灵药和地脉血泉！" NOR, who);
    message_vision(HIY "\n御医将活骨灵药敷在$N伤口上，又给$N服下地脉血泉，$N的伤口愈合了。\n" NOR, who);
    message_vision(HIG "［天医神药］！\n\n" NOR, who);
    who->receive_curing("kee", 1000);
    who->receive_heal("kee", 1000);
    who->receive_curing("sen", 1000);
    who->receive_heal("sen", 1000);
    who->receive_curing("gin", 1000);
    who->receive_heal("gin", 1000);
    who->add_temp("already_die", 1);
    who->remove_busy();
    if (!who->query_soft_powerup())
      who->soft_powerup(30, 30);

  } else
    ::die();
}
