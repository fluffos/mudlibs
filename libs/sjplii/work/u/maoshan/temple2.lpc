
#include <room.h>

inherit ROOM;

void create()
{
        set("short", "後殿");
        set("long", @LONG
你正站在灵心观的後殿, 正中央供奉著茅山派开山祖师张天师的
画像, 在画像的下方摆放著当年张天师收妖伏魔时所用的宝剑, 剑的
两旁陪祀著历代掌门人的牌位, 走出南边的红漆木门可以看到天井。
LONG
        );
        set("exits", ([ /* sizeof() == 1 */
               "north" : __DIR__"temple3",
               "south" : __DIR__"corridor5",
        ]));
        set("objects", ([
			"/obj/paper_seal" : 1,
                        ]) );

        set("item_desc",([ /* sizeof() == 2 */
               "牌位" : "茅山历代掌门人的牌位，牌位下似乎压着一些纸张。\n",
               "宝剑" : "张天师用过的宝剑(sword)，锋利依旧。\n",
               "画像" : "画像旁边似乎有道暗门，暗门旁有个小孔，好象可以用钥匙打开(use)。\n" 
        ]));
	set("paper_seal",1);
        create_door("south", "红漆木门", "north", DOOR_CLOSED);
        setup();
}

void init()
{
     add_action("do_search","search");
     add_action("do_knock","knock");
     add_action("do_use","use");
}

int do_search(string arg)
{
     object me,ob;
     if( !arg || arg != "牌位" )return 0;
     me=this_player();
     if( this_object()->query("paper_seal") > 0 )
     {
          message_vision("只见$N在茅山掌门人牌位下摸索了一会，搜出一叠桃符纸。\n",me);
	   ob = new("/obj/paper_seal.lpc");
	   ob->set_amount(20);
          ob->move(this_object());
	   this_object()->add("paper_seal",-1);
          return 1;
     }else
          return 0;
}

int do_knock(string arg)
{
     object me;
     if( !arg || arg != "sword" )return 0;
     me=this_player();
     if(me->query("maoshan/李凡天"))
     {
          message_vision("只见$N在张天师的宝剑上有节奏的敲了几下，过了片刻，吱扭一声，\n一个小道童从画像旁的小门里钻了出来，将$N引入了门里。\n",me);
          me->move(__DIR__"danfang1");
          return 1;
     }else
          return 0;
}

int do_use(string arg)
{
     object me,key;
     me=this_player();
     if( !arg || arg != "key" || !(key = present("danfang key",me)) ) return 0;
     if( me -> query("maoshan/knowgu") != 2 )
     {
          tell_object(me,"你用钥匙打开了暗门，但因为不知道这扇门会通向何处，想了想还是没有进去。\n");
          return 1;
     }
     message_vision("$N拿出了$n，对准张天师画像旁一个小孔伸了进去，吱扭\n一声打开了暗门，一个转身，$N就走进了暗门。\n门紧接着又自动关上了。\n",me,key);
     me->move(__DIR__"danfang1");
     return 1;
}
