// 内炼丹房

inherit ROOM;

void create()
{
        set("short", "内炼丹房");
        set("long", @LONG
这是一间更加幽静的炼丹房，不大的房间里放满了丹炉。丹炉内
火苗闪动，有一种说不出的神秘气息。屋里的其他陈设非常简单，一
张床，一只小桌，一个蒲团而已。看来谷姬子日常起居就都在这里了
。房间正中的蒲团上，坐着一位鹤发童颜的老道士，神情专注，好象
一点儿也没有发觉你的到来。
LONG
        );

        set("exits", ([ /* sizeof() == 1 */
                "south" : __DIR__"danfang1",
        ]));

         set("objects", ([
                __DIR__"npc/gu": 1,
                __DIR__"obj/danlu":3,
                __DIR__"obj/dan":3
]));
        
        setup();
        replace_program(ROOM);
}
