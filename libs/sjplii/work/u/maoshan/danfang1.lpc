// 外炼丹房

inherit ROOM;

void create()
{
        set("short", "外炼丹房");
        set("long", @LONG
这里是一间幽静的炼丹房，房间里放着几个丹炉，炉内火苗正在
嗤嗤地燃烧着，放出一些微光，将屋内照得忽明忽暗。房间正中有一
个较大的炼丹炉，旁边站着一位个中年道士，似乎正在全神贯注地炼
丹。丹房的后面似乎有一道小门，不知是通向何处的。
LONG
        );

        set("exits", ([ /* sizeof() == 2 */
		"south" : __DIR__"temple2",
                "north" : __DIR__"danfang2",
        ]));

         set("objects", ([
                __DIR__"npc/li": 1,
                __DIR__"obj/danlu":2,
                __DIR__"obj/dan":2

]));
        
        setup();
}

int valid_leave(object me, string dir)
{
        if( (dir=="north") && !me->query("maoshan/生生再造丹")
        && !me->query("maoshan/谷姬子") && present("li fantian" , environment(me)) )
                return notify_fail("李凡天伸手挡住了你：此乃家师闭关之所，非请莫入！\n");
        else return 1;
}
