//gu jizi

#include <ansi.h>
inherit NPC;
inherit F_MASTER;
void create()
{
        set_name("谷姬子", ({ "gu jizi", "master gu", "gu", "master" }));
        set("title", "茅山派前任掌门");
        set("gender", "男性");
        set("age", 75);
        set("nickname", HIR "炼丹求仙" NOR);
        set("long",@LONG
谷姬子是茅山派现任掌门温道乙的师兄，只因一心想炼丹成仙，不喜俗务，
多年前就将茅山派掌门一位让给师弟，从此不问世事，只在炼丹房内潜心
炼丹。
LONG
	);
        set("attitude", "peaceful");
        set("str", 40);
        set("int", 40);
        set("cor", 40);
        set("spi", 40);
        set("max_kee", 6000);
        set("max_gin", 4000);
        set("max_sen", 4000);
        set("kee", 6000);
        set("gin", 4000);
        set("sen", 4000);

        set("max_atman", 3000);
        set("atman", 3000);

        set("max_mana", 12000);
        set("mana", 12000);
        set("mana_factor", 30);

        set("force", 5000);
        set("max_force", 5000);
        set("force_factor", 40);

        set("combat_exp", 8000000);
        set("score", 30000);
        set_temp("apply/attack", 15);
        set_temp("apply/defense", 15);
        set_temp("apply/move", 15);

        set_skill("literate", 250);
        set_skill("magic", 200);
        set_skill("force", 300);
        set_skill("move", 250);
    
        set_skill("scratching", 300);
        set_skill("spells",300);
        set_skill("unarmed", 200);
        set_skill("sword", 200);
        set_skill("parry", 250);
        set_skill("dodge", 250);
        set_skill("gouyee", 300);
        set_skill("sanqing-jian", 200);
        set_skill("taoism", 300);
        set_skill("scratmancy", 300);
        set_skill("necromancy",300);
        set_skill("liandanshu",270);

        map_skill("literate", "liandanshu");
        map_skill("scratching", "scratmancy");
        map_skill("spells", "necromancy");
        map_skill("parry", "sanqing-jian");
        map_skill("sword", "sanqing-jian");
        map_skill("force", "gouyee");

        set("chat_chance_combat", 95);
        set("chat_msg_combat", ({
                (: cast_spell, "invocation" :),
                (: cast_spell, "thunder" :),
                (: cast_spell, "zhenhuo" :),
        }) );

        create_family("茅山派", 4, "前任掌门");
        set("class", "taoist");

        setup();
        carry_object(__DIR__"obj/godsword")->wield();
        carry_object(__DIR__"obj/godrobe")->wear();
        carry_object(__DIR__"obj/godhat")->wear();
        carry_object(__DIR__"obj/godshoe")->wear();
}

void attempt_apprentice(object ob)
{
      if(ob->query("maoshan/谷姬子")) {
            command("say 你这叛徒，还想再入我门，真是痴心枉想。\n");
            return;
        }
      if(!(ob->query("maoshan/生生再造丹"))) {
            command("say 贫道潜心炼丹，早已不再收弟子了，你还是找别人去吧。\n");
            return;
        }
      command("wa " + ob->query("id") );
      command("say 这位" + RANK_D->query_respect(ob) + "竟能炼出生生再造丹，真是位修道奇才！\n");
      command("nod " + ob->query("id") );
      command("say 好吧，既然你我有缘，贫道就破例收你为弟子！\n");
      command("pat " + ob->query("id") );
      command("say 你以后要勤于修道炼丹，少过问江湖之事！\n");
      command("recruit " + ob->query("id") );
      ob->add("combat_exp",1000);
      ob->add("potential",500);
      ob->delete("maoshan/生生再造丹");
      ob->set("maoshan/谷姬子",1);
}

void recruit_apprentice(object ob)
{
        if( ::recruit_apprentice(ob) )
        {
                ob->set("class", "taoist");
                ob->set("id_type", 1);
        }
}
