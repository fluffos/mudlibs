#include <ansi.h>
inherit NPC;
inherit F_MASTER;

int about_gu();

void create() {
  set_name("温道乙", ({ "master wen", "wen", "master" }));
  set("title", "茅山派掌门");
  set("gender", "男性");
  set("age", 66);
  set("nickname", HIC "茅山居士" NOR);
  set("long",
    "温道乙在茅山隐居数十年，不食人间烟火。他究竟是否已修炼成仙，江湖上没人知道。\n");
  set("attitude", "peaceful");
  set("str", 30);
  set("int", 30);
  set("cor", 30);
  set("spi", 30);
  set("max_kee", 3000);
  set("max_gin", 3000);
  set("max_sen", 3000);
  set("kee", 3000);
  set("gin", 3000);
  set("sen", 3000);

  set("max_atman", 2000);
  set("atman", 2000);

  set("max_mana", 9000);
  set("mana", 9000);
  set("mana_factor", 20);

  set("force", 4000);
  set("max_force", 4000);
  set("force_factor", 30);

  set("combat_exp", 5000000);
  set("score", 20000);
  set_temp("apply/attack", 10);
  set_temp("apply/defense", 10);
  set_temp("apply/move", 10);

  set_skill("literate", 90);
  set_skill("magic", 170);
  set_skill("force", 260);
  set_skill("move", 200);
  set_skill("scratching", 250);
  set_skill("spells", 250);
  set_skill("unarmed", 130);
  set_skill("sword", 150);
  set_skill("parry", 210);
  set_skill("dodge", 190);
  set_skill("gouyee", 250);
  set_skill("sanqing-jian", 150);
  set_skill("taoism", 300);
  set_skill("scratmancy", 250);
  set_skill("necromancy", 250);
  set_skill("liandanshu", 130);

  map_skill("scratching", "scratmancy");
  map_skill("spells", "necromancy");
  map_skill("parry", "sanqing-jian");
  map_skill("sword", "sanqing-jian");
  map_skill("force", "gouyee");

  set("chat_chance_combat", 90);
  set("chat_msg_combat", ({
    (: cast_spell, "invocation" :),
    (: cast_spell, "thunder" :),
    (: cast_spell, "zhenhuo" :),
  }));

  create_family("茅山派", 4, "掌门");
  set("class", "taoist");
  set("inquiry", ([
    "谷姬子": (: about_gu :)
  ]));

  setup();
  carry_object(__DIR__ "obj/godsword")->wield();
  carry_object(__DIR__ "obj/godrobe")->wear();
  carry_object(__DIR__ "obj/godhat")->wear();
  carry_object(__DIR__ "obj/godshoe")->wear();
}

void attempt_apprentice(object ob) {
  if (ob->query("class") != "taoist") {
    command("say 这位" + RANK_D->query_respect(ob) + "还是去拜贫道的弟子吧。\n");
    return;
  }

  if (ob->query_skill("taoism", 1) < 150) {
    command("say 本门法术均以天师正道作为基础，你修为尚浅，拜师之事还是以后再说吧。\n");
    return;
  }
  if (ob->query_skill("spells", 1) < 120) {
    command("say 你的咒术修为尚浅，拜师之事还是以后再说吧。\n");
    return;
  }
  if (ob->query_skill("gouyee", 1) < 100) {
    command("say 你本门内功修为尚浅，拜师之事还是以后再说吧。\n");
    return;
  }
  command("smile");
  command("say 好吧，" + RANK_D->query_respect(ob) + "以后要勤于修道，少过问江湖之事！\n");
  command("recruit " + ob->query("id"));
}

void recruit_apprentice(object ob) {
  if (::recruit_apprentice(ob))
    ob->set("class", "taoist");
  ob->set("id_type", 1);
}

void re_rank(object me) {
  if ((random(me->query("daode")) > 350) && (random(me->query("kar")) > 8)) {
    command("smile");
    command("say 你在本门真是孝敬师长的典范，跟你师伯谷姬子师兄当年一样。");
    if (!me->query("maoshan/knowgu")) {
      me->set("maoshan/knowgu", 1);
      me->add("combat_exp", 10);
      me->add("life_exp", 10);
    }
  }
}

int about_gu() {
  object me;
  me = this_player();
  if (me->query("maoshan/knowgu")) {
    if (me->query("maoshan/knowgu") == 1) {
      me->set("maoshan/knowgu", 2);
      me->add("potential", 5);
      me->add("life_exp", 5);
    }
    command("sigh");
    command("say 谷姬子是我的师兄，他也是本派前任掌门，只因他一心炼丹修道，才在");
    command("say 二十年前将掌门之位传我，自己却躲在後殿旁边的炼丹房内潜心炼丹。\n");
    return 1;
  } else return 0;
}
