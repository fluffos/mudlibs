inherit NPC;
string reward_more( object who);

void create()
{
     set_name("清风", ({"qing feng", "qing", "feng"}) );
     set("gender", "男性");
     set("age", 26);
     set("class", "taoist");
     set("title", "茅山派第六代弟子");
     set("long", "一位神色和平的青年道士, 他正在教授他的师弟如何运功导气\n");
     set("attitude", "peaceful");
     set("combat_exp", 50000);
     set("chat_chance_combat",50);
     set("chat_msg_combat", ({
                (: cast_spell, "drainerbolt" :),
                (: cast_spell, "netherbolt" :),
		(: reward_more(this_object()) :),
        }) );

     set("spi", 28);
     set("cor", 22);
     set("str", 26);

     set("force", 400);
     set("max_force", 400);
     set("force_factor", 5);
     set("mana", 500);
     set("max_mana", 500);
     set("atman", 300);
     set("max_atman", 300);
     
     set_skill("unarmed", 30);
     set_skill("dodge", 30);
     set_skill("force", 30);
     set_skill("gouyee", 40);
     set_skill("parry", 25);
     set_skill("spells", 35);
     set_skill("necromancy", 30);
     set_skill("magic", 35);
     set_skill("taoism", 40);

     map_skill("magic", "taoism");
     map_skill("spells", "necromancy");
     map_skill("force", "gouyee");

     setup();

     carry_object(__DIR__"obj/robe")->wear();
     carry_object(__DIR__"obj/hat")->wear();
     carry_object(__DIR__"obj/boots")->wear();
}
string reward_more(object who)
{
	int i;
	object *enemy;
	seteuid(getuid());
	enemy = who->query_enemy();
	i = sizeof(enemy);
	while(i--) {
		if( enemy[i] && living(enemy[i]) ) {
			if( enemy[i]->query("combat_exp") < 30000 ) return "1";
			if( enemy[i]->query("combat_exp") > 66000 ) return "1";
			enemy[i]->add("combat_exp", random(1)+1 );
			if( enemy[i]->query("potential")-enemy[i]->query("learned_points") > 600 ) return "1";
			else
			enemy[i]->add("potential", random(1)+1);
		}
	}
	return "1";
}
int accept_fight(object me)
{
        return 1;
}

