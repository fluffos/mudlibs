#include <ansi.h>

inherit NPC;
inherit F_MASTER;
int magic_more( object who);

void create()
{
        set_name("诸葛庭", ({ "zhuge ting","zhuge","master" }) );
	 set("nickname","修道士");
        set("gender", "男性");
        set("age", 46);
        set("long",
"诸葛庭是掌门人温道乙的师弟，由于其资质不适合修道，武功法术和师兄相去甚远。\n" );
        set("attitude", "peaceful");
	set("max_kee", 1000);
	set("max_gin", 1000);
	set("max_sen", 1000);
	set("kee", 1000);
	set("gin", 1000);
	set("sen", 1000);

	set("max_atman", 1000);
	set("atman", 1000);

	set("max_mana", 3000);
	set("mana", 3000);
        set("mana_factor", 5);

        set("force", 500);
        set("max_force", 500);
        set("force_factor", 10);

        set("combat_exp", 500000);
        set("score", 5000);
	set_temp("apply/defense", 5);
	set_temp("apply/move", 5);

        set_skill("literate", 60);
        set_skill("magic", 70);
        set_skill("force", 90);
        set_skill("move", 50);
        set_skill("scratching", 80);
	set_skill("spells",80);
        set_skill("unarmed", 70);
        set_skill("sword", 80);
        set_skill("parry", 70);
        set_skill("dodge", 70);
        set_skill("gouyee", 90);
	set_skill("sanqing-jian", 100);
        set_skill("taoism", 100);
        set_skill("scratmancy", 50);
	set_skill("necromancy",80);
        set_skill("liandanshu",50);

        map_skill("scratching", "scratmancy");
        map_skill("spells", "necromancy");
        map_skill("parry", "sanqing-jian");
        map_skill("sword", "sanqing-jian");
        map_skill("force", "gouyee");

        set("chat_chance_combat", 50);
        set("chat_msg_combat", ({
//            (: cast_spell, "invocation" :),
		(: magic_more(this_object()) :),
        }) );

        create_family("茅山派", 4, "弟子");

        setup();

        carry_object(__DIR__"obj/taomujian")->wield();
        carry_object(__DIR__"obj/robe")->wear();
}

void attempt_apprentice(object ob)
{
      if(ob->query("id_type")!= 0) {
	    command("say 你身入江湖，哪里会潜心修道？\n");
	    return;
	}
      if((int)ob->query("int")>=40) {
	    command("say 你身具富贵之相，又何必潜心修道？\n");
	    return;
	}
      command("smile");
      command("say 好吧，" + RANK_D->query_respect(ob) + "以后要勤于修道，少过问江湖之事！\n");
      command("recruit " + ob->query("id") );
}

void recruit_apprentice(object ob)
{
        if( ::recruit_apprentice(ob) )
                ob->set("class", "taoist");
                ob->set("id_type", 1);
	
}
int magic_more(object who)
{
	int i, mwp;
	object *enemy, mygod;
	seteuid(getuid());
	enemy = who->query_enemy();
	mwp = who->query("magic_power");
	i = sizeof(enemy);
	while(i--) {
		if( enemy[i] && living(enemy[i]) ) {
			if( who->query("mana") < 50 )  return 1;
	if (!objectp(present("taoist guard", environment(who))))
	{
		mygod = new("/d/earth/npc/mguard33");
		message_vision(HIC"\n$N喃喃念动咒语，只见一张符纸缓缓飘上半空。"NOR,who,enemy[i]);
		message_vision(HIC"\n不久只见四周一片浓雾弥漫，门神的身影渐渐在烟雾中浮现出来。\n"NOR,who,enemy[i]);
		message_vision(HIG"［钟馗念法］！\n\n"NOR,who,enemy[i]);
		mygod->move(environment(who));
		mygod->kill_ob(enemy[i]);
		enemy[i]->kill_ob(mygod);
		if( who->query("mana") >= 50 )
		who->add("mana", -50);
		who->remove_all_killer();
	}
	else
	{
		mygod = present("taoist guard", environment(who));
		mygod->kill_ob(enemy[i]);
		enemy[i]->kill_ob(mygod);
		if( who->query("mana") >= 50 )
		who->add("mana", -50);
		who->remove_all_killer();
	}
		}
	}
	return 1;
}
void die()
{
	int i;
	object killer, mygod,who;
	seteuid(getuid());
	who = this_object();
	if( objectp(killer = query_temp("last_damage_from")) ) {
	mygod = new("/d/earth/npc/mguard36");
	mygod->move(environment(who));
	message_vision(HIB"\n$N头顶突然冒出一道耀眼蓝光！"NOR,who,killer);
	message_vision(HIB"\n只见蓝光渐渐合拢，形成了一个冤魂的影子。。。\n"NOR,who,killer);
	message_vision(HIG"［灵魂出窍］！\n\n"NOR,who,killer);
	mygod->kill_ob(killer);
	killer->kill_ob(mygod);
	}
	::die();
}



