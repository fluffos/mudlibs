
inherit ROOM;

void create()
{
        set("short", "大理石阶");
        set("long", @LONG
你正站在这阶梯的起点, 灰白色宽敞的大理石阶梯蜿蜒而上, 在青
翠的山色中形成一条灰白色的巨龙, 抬头仰望石阶尽头的那座庙宇, 虽
然无情的岁月已经在它身上留下痕迹, 但仍不失其庄严神圣的气息。阶
梯两边是茂密的草丛，显然很长时间没有人清理了。　
LONG
        );
        set("exits", ([ /* sizeof() == 2 */
               "eastup" : __DIR__"ladder4",
               "southdown" : "/d/hangzhou/shanlu1",
        ]));
        set("outdoors", "temple");
        set("objects", ([ /* sizeof() == 1 */
               __DIR__"obj/grass" : 1,
        ]));

        setup();
}

void reset()
{
        int i;
        object grass,book,*inv;
        ::reset();
        if(objectp( grass = present("grass",this_object()) ))
        {
               inv = all_inventory(grass);
               for(i=sizeof(inv)-1; i>=0; i--)destruct(inv[i]);
               book = new(__DIR__"obj/book");
               book -> move(grass);
        }
}
