inherit ROOM;

void create()
{
        set("short", "洪椿坪");
        set("long", @LONG
这是一块巨大的空地，是峨眉派练功的广场。坪上绿草如茵，煦
阳抚照，一边竖立着一排兵器架，上面安放着各种各样的刀剑武器。
从这里四外望去，峨眉山东部山低，势如屏锦，中部群峰如笋，西部
山势巍峨，一派壮丽景象。
LONG
        );
        set("exits", ([ 
	       "southwest" : __DIR__"sheshenya",
	       "south" : __DIR__"xiaolu23",
	       "eastdown" : __DIR__"xiaolu22",
]));
	set("objects",([
		__DIR__"npc/yongshun" : 1,
		"/obj/weapon/longsword" : 2,
		"/obj/weapon/bamboo_sword" : 2,
		"/obj/weapon/bamboo_blade" : 2,
       	]));
        set("outdoors", "emei");
        setup();
}


