
inherit NPC;
inherit F_MASTER;

void create()
{
        set_name("邵宏来", ({ "shao honglai", "shao" }) );
        set("gender", "男性");
        set("age", 26);
        set("long",
"邵宏来主要负责办理加入峨眉派的事宜，平时有贵客到来时也由他出面招呼。\n" );
        set("inquiry", ([
                "here": "这里是闻名天下的峨眉山。",
                "加入": "要加入峨眉派可以先拜我，以后有所成就再拜其他长辈。",
                "拜师": "要加入峨眉派可以先拜我，以后有所成就再拜其他长辈。",
                "学艺": "要先拜师，才能学艺。",
        ]) ); 
        set("attitude", "peaceful");
	set("max_kee", 600);
	set("max_gin", 600);
	set("max_sen", 600);
	set("kee", 600);
	set("gin", 600);
	set("sen", 600);

        set("force", 600);
        set("max_force", 600);
        set("force_factor",10);
        set("combat_exp",300000);
        set("score",3000);

        set_skill("dodge", 40);
        set_skill("move", 30);
        set_skill("literate", 20);
        set_skill("parry", 40);
        set_skill("unarmed", 40);
        set_skill("force", 40);
        set_skill("sword", 40);

        set_skill("wind_sword",46);
        set_skill("mian_strike", 46);
        set_skill("taiqing_force", 46);
        set_skill("ganchan_steps", 46);

        map_skill("dodge", "ganchan_steps");
        map_skill("unarmed", "mian_strike");
        map_skill("force", "taiqing_force");
        map_skill("parry", "wind_sword");
        map_skill("sword", "wind_sword");
        create_family("峨眉派", 8, "弟子");
        set("class","emei");

        setup();

        carry_object("obj/longsword")->wield();
        carry_object(__DIR__"obj/daopao")->wear();
}

void attempt_apprentice(object ob)
{
      if(ob->query("id_type")== 2) {
	    command("say 本派乃名门正派，不收邪道人物。\n");
	    return;
	}

      command("smile");
      command("say 好吧，" + RANK_D->query_respect(ob) + "以后要更加勤习武功，把峨眉发扬光大！\n");
      command("recruit " + ob->query("id") );
}

void recruit_apprentice(object ob)
{
        if( ::recruit_apprentice(ob) )
                ob->set("class", "emei");
                ob->set("id_type", 1);
}


