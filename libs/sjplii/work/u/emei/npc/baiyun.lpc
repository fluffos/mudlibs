inherit NPC;
inherit F_MASTER;
string summon_more(object who);

void create() {
  set_name("白云子", ({ "bai yun", "yun", "master" }));
  set("gender", "男性");
  set("age", 40);
  set("long",
    "白云子是永顺真人的弟子，被称为“峨眉三云”之一。\n");
  set("inquiry", ([
    "here": "这里就是峨眉派。",
  ]));
  set("attitude", "peaceful");
  set("class", "emei");
  set("str", 25);
  set("int", 22);
  set("spi", 25);
  set("per", 23);
  set("cps", 23);
  set("max_kee", 1200);
  set("max_gin", 1200);
  set("max_sen", 1200);
  set("kee", 1200);
  set("gin", 1200);
  set("sen", 1200);

  set("force", 1200);
  set("max_force", 1200);
  set("force_factor", 20);
  set("combat_exp", 3000000);
  set("score", 20000);

  set_skill("dodge", 100);
  set_skill("move", 80);
  set_skill("literate", 40);
  set_skill("parry", 70);
  set_skill("unarmed", 60);
  set_skill("force", 90);
  set_skill("sword", 50);

  set_skill("wind_sword", 50);
  set_skill("mian_strike", 60);
  set_skill("taiqing_force", 90);
  set_skill("ganchan_steps", 100);

  map_skill("dodge", "ganchan_steps");
  map_skill("unarmed", "mian_strike");
  map_skill("force", "taiqing_force");
  map_skill("parry", "wind_sword");
  map_skill("sword", "wind_sword");
  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: perform_action, "dodge.xijinchan" :),
    (: summon_more(this_object()) :),
  }));
  create_family("峨眉派", 6, "弟子");

  setup();

  carry_object("/obj/longsword")->wield();
  carry_object(__DIR__ "obj/daopao")->wear();
}

void attempt_apprentice(object ob) {
  if (ob->query("class") != "emei") {
    command("say 这位" + RANK_D->query_respect(ob) + "还是去拜贫道的弟子吧。\n");
    return;
  }

  if (ob->query_skill("ganchan_steps", 1) < 60) {
    command("say 你的本门掌法修为尚浅，拜师之事还是以后再说吧。\n");
    return;
  }
  command("smile");
  command("say 好吧，" + RANK_D->query_respect(ob) + "以后要更加勤习武功，把峨眉发扬光大！\n");
  command("recruit " + ob->query("id"));
}

void recruit_apprentice(object ob) {
  if (::recruit_apprentice(ob))
    ob->set("class", "emei");
  ob->set("id_type", 1);
}
string summon_more(object who) {
  int i;
  object *enemy;
  object another;
  seteuid(getuid());
  another = new(__DIR__ "emdizi2");
  if ((int)who->query_temp("summon_more") > 2) return "　";
  another->move(environment(who));
  message_vision(another->name() + "走了过来。\n"
    , this_object());
  who->add_temp("summon_more", 1);
  enemy = who->query_enemy();
  i = sizeof(enemy);
  while (i--) {
    if (enemy[i] && living(enemy[i])) {
      another->kill_ob(enemy[i]);
      enemy[i]->kill_ob(another);
      another->set_leader(enemy[i]);
    }
  }
  return "1";
}
int accept_fight(object me) {
  command("say 请不要在这里惹是生非。");
  return 0;
}
