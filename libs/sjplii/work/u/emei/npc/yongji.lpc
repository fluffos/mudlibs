
inherit NPC;
inherit F_MASTER;

void create()
{
        set_name("永吉真人", ({ "master yongji", "yongji","master" }) );
        set("gender", "男性");
        set("age", 56);
        set("long",
"永吉真人是掌门永灵的大师弟，在武林中名望也很高。\n"  );
        set("inquiry", ([
                "here": "这里就是峨眉派。",
        ]) ); 
        set("attitude", "peaceful");
        set("class","emei");
        set("str", 26);
        set("int", 22);
        set("spi", 25);
        set("per", 23);
        set("cps", 23);
	set("max_kee", 1800);
	set("max_gin", 1800);
	set("max_sen", 1800);
	set("kee", 1800);
	set("gin", 1800);
	set("sen", 1800);

        set("force", 1800);
        set("max_force", 1800);
        set("force_factor",20);
        set("combat_exp",7000000);
        set("score",50000);

        set_skill("dodge", 150);
        set_skill("move", 140);
        set_skill("literate", 150);
        set_skill("parry", 160);
        set_skill("unarmed", 170);
        set_skill("force", 180);
        set_skill("sword", 180);

        set_skill("wind_sword",180);
        set_skill("mian_strike", 160);
        set_skill("taiqing_force", 170);
        set_skill("ganchan_steps", 140);

        map_skill("dodge", "ganchan_steps");
        map_skill("unarmed", "mian_strike");
        map_skill("force", "taiqing_force");
        map_skill("parry", "wind_sword");
        map_skill("sword", "wind_sword");
        set("chat_chance_combat", 50);
        set("chat_msg_combat", ({
                (: perform_action, "sword.xuling" :),
        }) );

        create_family("峨眉派", 5, "弟子");

        setup();

        carry_object("/obj/longsword")->wield();
        carry_object(__DIR__"obj/daopao")->wear();
}

void attempt_apprentice(object ob)
{
      if(ob->query("class")!="emei") {
	    command("say 这位" + RANK_D->query_respect(ob) + "还是去拜贫道的弟子吧。\n");
	    return;
	}

      if(ob->query_skill("wind_sword",1)< 120) {
	    command("say 本门乃三大剑派之一，主修剑法，你剑术修为尚浅，还是再多下点功夫吧。\n");
	    return;
	}	
      command("smile");
      command("say 好吧，" + RANK_D->query_respect(ob) + "以后要更加勤习武功，把峨眉发扬光大！\n");
      command("recruit " + ob->query("id") );
}

void recruit_apprentice(object ob)
{
        if( ::recruit_apprentice(ob) )
                ob->set("class", "emei");
                ob->set("id_type", 1);
}


