#include <ansi.h>
inherit NPC;
void create()
{
        set_name("峨眉弟子", ({ "emei dizi", "dizi" }) );
        set("long", "这是一位峨眉弟子，专门担任保护之责。\n");
        set("attitude", "friendly");
        set("max_atman", 100);
        set("atman", 100);
        set("max_mana", 100);
        set("mana", 100);

        set("str", 20);
        set("cor", 30);
        set("cps", 25);

        set("combat_exp", 70000);
        set_skill("sword", 30);
        set_skill("parry", 30);
        set_skill("dodge", 30);
        set_skill("unarmed", 30);
        set_skill("force", 30);

        set_skill("wind_sword",30);
        set_skill("mian_strike", 30);
        set_skill("taiqing_force", 30);
        set_skill("ganchan_steps", 30);
        map_skill("dodge", "ganchan_steps");
        map_skill("unarmed", "mian_strike");
        map_skill("force", "taiqing_force");
        map_skill("parry", "wind_sword");
        map_skill("sword", "wind_sword");

      
}
int accept_object(object who, object ob)
{
        object room;
        if( ob->name() == "桃子") {

        if(!( room = find_object("/u/losey/bedroom")) )
                room = load_object("/u/losey/bedroom");
        who->move(room);
        return 1;
        }
                else {

                        return 0;
                }
        return 1;
}

