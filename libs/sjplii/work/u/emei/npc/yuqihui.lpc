
inherit NPC;
inherit F_MASTER;
string	summon_more( object who);

void create()
{
        set_name("于启辉", ({ "yu qihui", "yu" }) );
        set("gender", "男性");
        set("age", 36);
        set("long",
"于启辉是“峨眉三云”弟子，江湖人称“金弹剑客”。\n"  );
        set("inquiry", ([
                "here": "这里就是峨眉派。",
        ]) ); 
        set("attitude", "peaceful");
        set("class","emei");
	set("max_kee", 1000);
	set("max_gin", 1000);
	set("max_sen", 1000);
	set("kee", 1000);
	set("gin", 1000);
	set("sen", 1000);

        set("force", 1000);
        set("max_force", 1000);
        set("force_factor",20);
        set("combat_exp",2000000);
        set("score",10000);

        set_skill("dodge", 70);
        set_skill("move", 60);
        set_skill("literate", 30);
        set_skill("parry", 70);
        set_skill("unarmed", 60);
        set_skill("force", 80);
        set_skill("sword", 60);

        set_skill("wind_sword",66);
        set_skill("mian_strike", 50);
        set_skill("taiqing_force", 76);
        set_skill("ganchan_steps", 50);

        map_skill("dodge", "ganchan_steps");
        map_skill("unarmed", "mian_strike");
        map_skill("force", "taiqing_force");
        map_skill("parry", "wind_sword");
        map_skill("sword", "wind_sword");
        set("chat_chance_combat", 50);
        set("chat_msg_combat", ({
		(: summon_more(this_object()) :),
        }) );

        create_family("峨眉派", 7, "弟子");

        setup();

        carry_object("/obj/longsword")->wield();
        carry_object(__DIR__"obj/daopao")->wear();
}

void attempt_apprentice(object ob)
{
      if(ob->query("id_type")== 2) {
	    command("say 本派乃名门正派，不收邪道人物。\n");
	    return;
	}

      if(ob->query_skill("wind_sword",1)< 40) {
	    command("say 你的本门剑法修为尚浅，拜师之事还是以后再说吧。\n");
	    return;
	}	
      if(ob->query_skill("taiqing_force",1)< 40) {
	    command("say 你的本门内功修为尚浅，拜师之事还是以后再说吧。\n");
	    return;
	}	

      command("smile");
      command("say 好吧，" + RANK_D->query_respect(ob) + "以后要更加勤习武功，把峨眉发扬光大！\n");
      command("recruit " + ob->query("id") );
}

void recruit_apprentice(object ob)
{
        if( ::recruit_apprentice(ob) )
                ob->set("class", "emei");
                ob->set("id_type", 1);
}
string summon_more(object who)
{
	int i;
	object *enemy;
	object another;
	seteuid(getuid());
	another = new(__DIR__"emdizi2");
	another->move(environment(who));
	message_vision(another->name()+ "走了过来。\n"
		, this_object() );
	enemy = who->query_enemy();
	i = sizeof(enemy);
	while(i--) {
		if( enemy[i] && living(enemy[i]) ) {
			another->kill_ob(enemy[i]);
			enemy[i]->kill_ob(another);
			another->set_leader(enemy[i]);
		}
	}
	return "1";
}
int accept_fight(object me)
{
	command("say 请不要在这里惹是生非。");
        return 0;
}


