#include <ansi.h>
inherit NPC;
inherit F_MASTER;
int about_baohu();
void create() {
  set_name("宝相神尼", ({ "master baoxiang", "baoxiang", "master" }));
  set("title", "峨眉派掌门师姐");
  set("gender", "女性");
  set("age", 90);
  //	set("nickname", HIG "" NOR);
  set("long",
    "宝相神尼是掌门人永灵的师叔，虽已淡出江湖，但仍然是武林中最德高望重的前辈之一。\n");
  set("attitude", "peaceful");
  set("str", 30);
  set("int", 30);
  set("cor", 30);
  set("spi", 30);
  set("max_kee", 2000);
  set("max_gin", 2000);
  set("max_sen", 2000);
  set("kee", 2000);
  set("gin", 2000);
  set("sen", 2000);

  set("force", 2000);
  set("max_force", 2000);
  set("force_factor", 20);

  set("combat_exp", 10000000);
  set("score", 69000);

  set_skill("dodge", 270);
  set_skill("move", 250);
  set_skill("literate", 270);
  set_skill("parry", 280);
  set_skill("unarmed", 290);
  set_skill("force", 300);
  set_skill("sword", 300);
  set_skill("buddhism", 250);
  set_skill("foben_jing", 250);
  set_skill("magic", 250);

  set_skill("wind_sword", 250);
  set_skill("mian_strike", 260);
  set_skill("taiqing_force", 300);
  set_skill("ganchan_steps", 280);

  map_skill("magic", "foben_jing");
  map_skill("dodge", "ganchan_steps");
  map_skill("unarmed", "mian_strike");
  map_skill("force", "taiqing_force");
  map_skill("parry", "wind_sword");
  map_skill("sword", "wind_sword");
  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: perform_action, "sword.xuling" :),
  }));
  set("inquiry", ([
    "随行": (: about_baohu :),
  ]));

  create_family("峨眉派", 4, "掌门师叔");
  set("class", "emei");

  setup();
  carry_object("/obj/longsword")->wield();
  carry_object(__DIR__ "obj/daopao")->wear();
}

void attempt_apprentice(object ob) {
  if (ob->query("gender") != "女性") {
    command("say 贫身向来不收男弟子。\n");
    return;
  }

  if (ob->query_skill("taiqing_force", 1) < 180) {
    command("say 本门武功均以太清神功作为基础，你修为尚浅，应先在内功方面多下功夫。\n");
    return;
  }
  command("smile");
  command("say 好吧，" + RANK_D->query_respect(ob) + "以后要更加勤习武功，把峨眉发扬光大！\n");
  command("recruit " + ob->query("id"));
}

void recruit_apprentice(object ob) {
  if (::recruit_apprentice(ob))
    ob->set("class", "emei");
  ob->set("id_type", 1);
}

int about_baohu() {
  object me, soldier;
  object *t;
  me = this_player();
  if (me->query("class") != "emei") {
    command("say 对不起，你不是峨眉弟子！\n");
    return 1;
  }

  if (pointerp(t = me->query_team())) {
    command("say 已经有师兄弟保护你了，好自为之！\n");
    return 1;
  }
  command("say 好吧，我让你的师兄弟与你同行。\n");
  message_vision(CYN "\n从门外走进来一名峨眉弟子，躬身说道：师父请吩咐！\n" NOR, me);
  message_vision(HIM "\n宝相神尼说道：峨眉弟子保护$N一起下山吧！\n" NOR, me);
  message_vision(CYN "\n峨眉弟子躬身说道：谨遵师命！\n" NOR, me);
  soldier = new(__DIR__ "emdizi.lpc");
  soldier->move(environment(me));
  me->add_team_member(soldier);
  soldier->add_team_member(me);
  soldier->set_leader(me);
  soldier->set("possessed", me);
  return 1;
}
int accept_object(object who, object ob) {
  int exp, pot;
  object me;
  me = this_player();
  if (ob->name() == WHT "白绢" NOR) {
    message_vision(CYN "宝相神尼看了$N一眼，握着白绢的手微微颤了一下。\n" NOR, me);
    message_vision(CYN "$N渐渐觉得眼前越来越模糊，耳边只听见宝相神尼的叹息之声。\n" NOR, me);
    message_vision(HIC "．．．．．．\n\n" NOR, me);
    me->move("/y/emei/qingyinge");
    me->set("marks/oldarea", 1);
    me->set_temp("oldarea/temp", "baiwt_born");
    message_vision(CYN "过了好久$N才慢慢恢复了知觉，只听见耳边有婴儿的啼哭之声。\n", me);
    me->start_more(read_file("/quest/doc/baiwt1.txt"));
    message_vision("．．．．．．\n" NOR, me);
    me->add("life_exp", 1);
    me->add("potential", 1);
    me->set("startroom", "/y/emei/qingyinge");
    return 1;
  } else {
    say(CYN "宝相神尼说道：多谢你的好意，但这东西对我没用。\n" NOR);
    return 0;
  }
  return 1;
}
