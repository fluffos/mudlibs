// /u/emei/npc/bingqi_boss.c  created by Baiwt

inherit NPC;
inherit F_VENDOR;
#include <ansi.h>
void create() {
  object ob;

  set_name("古北书", ({ "gu beishu", "gu", "boss" }));
  set("gender", "男性");
  set("age", 28);
  set("nickname", HIM "小龙神" NOR);
  set("long",
    "小龙神古北书，一手飞刀绝技出神入化。\n");
  set("combat_exp", 1500000);
  set("attitude", "friendly");
  set("per", 30);
  set("vendor_goods", ([
    "/obj/weapon/m_weapon/axe": 10,
    "/obj/weapon/m_weapon/blade": 10,
    "/obj/weapon/m_weapon/dagger": 10,
    "/obj/weapon/m_weapon/fork": 10,
    "/obj/weapon/m_weapon/hammer": 10,
    "/obj/weapon/m_weapon/spear": 10,
    "/obj/weapon/m_weapon/staff": 10,
    "/obj/weapon/m_weapon/stick": 10,
    "/obj/weapon/m_weapon/sword": 10,
    "/obj/weapon/m_weapon/throwing": 10,
  ]));
  set_skill("throwing", 250);
  set_skill("pyrobat-steps", 50);
  set_skill("dodge", 50);
  set_skill("parry", 50);
  map_skill("dodge", "pyrobat-steps");
  setup();
  carry_object("/obj/cloth")->wear();
  ob = carry_object("/obj/weapon/throwing_knife");
  ob->set_amount(50);
  ob->wield();
}
void init() {
  add_action("do_vendor_list", "list");
}
