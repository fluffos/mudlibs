#include <ansi.h>
string reward_more( object who);

inherit NPC;
void create()
{

	set_name("峨眉弟子", ({ "emei dizi", "dizi" }) );
	set("long", "这是一位峨眉弟子，专门担任保护之责。\n");
	set("attitude", "friendly");
	set("max_atman", 100);
	set("atman", 100);
	set("max_mana", 100);
	set("mana", 100);

	set("str", 20);
	set("cor", 30);
	set("cps", 25);

	set("combat_exp", 70000);
	set_skill("sword", 30);
	set_skill("parry", 30);
	set_skill("dodge", 30);
	set_skill("unarmed", 30);
	set_skill("force", 30);

        set_skill("wind_sword",30);
        set_skill("mian_strike", 30);
        set_skill("taiqing_force", 30);
        set_skill("ganchan_steps", 30);
        map_skill("dodge", "ganchan_steps");
        map_skill("unarmed", "mian_strike");
        map_skill("force", "taiqing_force");
        map_skill("parry", "wind_sword");
        map_skill("sword", "wind_sword");
        set("chat_chance", 10);
        set("chat_msg", ({
                (:random_move :)
        }) );
        set("chat_chance_combat", 50);
        set("chat_msg_combat", ({
		(: reward_more(this_object()) :),
        }) );
	setup();
//        carry_object("/obj/longsword")->wield();
        carry_object(__DIR__"obj/daopao")->wear();
}
string reward_more(object who)
{
	int i;
	object *enemy;
	seteuid(getuid());
	enemy = who->query_enemy();
	i = sizeof(enemy);
	while(i--) {
		if( enemy[i] && living(enemy[i]) ) {
			if( enemy[i]->query("combat_exp") < 40000 ) return "1";
			if( enemy[i]->query("combat_exp") > 80000 ) return "1";
			enemy[i]->add("combat_exp", 1);
			if( enemy[i]->query("potential")-enemy[i]->query("learned_points") > 700 ) return "1";
			else
		if(random(9)<5)
			enemy[i]->add("potential", 1);
			else
			enemy[i]->add("life_exp", 1);
		}
	}
	return "1";
}
int accept_fight(object me)
{
        return 1;
}

