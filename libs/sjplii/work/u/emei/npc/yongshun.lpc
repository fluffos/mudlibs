inherit NPC;
inherit F_MASTER;

void create() {
  set_name("永顺真人", ({ "master yongshun", "yongshun", "master" }));
  set("gender", "男性");
  set("age", 50);
  set("long",
    "永顺真人是掌门永灵的二师弟，在武林中名望也很高。\n");
  set("inquiry", ([
    "here": "这里就是峨眉派。",
  ]));
  set("attitude", "peaceful");
  set("class", "emei");
  set("str", 26);
  set("int", 22);
  set("spi", 25);
  set("per", 23);
  set("cps", 23);
  set("max_kee", 1600);
  set("max_gin", 1600);
  set("max_sen", 1600);
  set("kee", 1600);
  set("gin", 1600);
  set("sen", 1600);

  set("force", 1800);
  set("max_force", 1800);
  set("force_factor", 20);
  set("combat_exp", 6000000);
  set("score", 50000);

  set_skill("dodge", 120);
  set_skill("move", 120);
  set_skill("literate", 100);
  set_skill("parry", 120);
  set_skill("unarmed", 120);
  set_skill("force", 130);
  set_skill("sword", 130);

  set_skill("wind_sword", 130);
  set_skill("mian_strike", 120);
  set_skill("taiqing_force", 130);
  set_skill("ganchan_steps", 120);

  map_skill("dodge", "ganchan_steps");
  map_skill("unarmed", "mian_strike");
  map_skill("force", "taiqing_force");
  map_skill("parry", "wind_sword");
  map_skill("sword", "wind_sword");
  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: perform_action, "sword.xuling" :),
  }));

  create_family("峨眉派", 5, "弟子");

  setup();

  carry_object("/obj/longsword")->wield();
  carry_object(__DIR__ "obj/daopao")->wear();
}

void attempt_apprentice(object ob) {
  if (ob->query("class") != "emei") {
    command("say 这位" + RANK_D->query_respect(ob) + "还是去拜贫道的弟子吧。\n");
    return;
  }

  if (ob->query_skill("taiqing_force", 1) < 90) {
    command("say 你的太清神功修为尚浅，拜师之事还是以后再说吧。\n");
    return;
  }
  if (ob->query_skill("wind_sword", 1) < 90) {
    command("say 你的本门剑法修为尚浅，拜师之事还是以后再说吧。\n");
    return;
  }
  if (ob->query_skill("mian_strike", 1) < 90) {
    command("say 你的本门掌法修为尚浅，拜师之事还是以后再说吧。\n");
    return;
  }

  command("smile");
  command("say 好吧，" + RANK_D->query_respect(ob) + "以后要更加勤习武功，把峨眉发扬光大！\n");
  command("recruit " + ob->query("id"));
}

void recruit_apprentice(object ob) {
  if (::recruit_apprentice(ob))
    ob->set("class", "emei");
  ob->set("id_type", 1);
}
