inherit ROOM;

void create() {
  set("short", "金顶佛光");
  set("long", @LONG
金顶宝光又称金顶祥光。在风平云静的清晨、午后和日落之前，
人背太阳而立，可在太阳相对方向的云层上见到一个虚明若镜，极其
艳丽的彩色光环，环中暗影与你自己影像相同，光随人动，人移环动
，每个人只能见到各自的身影。
LONG
  );
  set("exits", ([
    "southwest": __DIR__ "wanfo",
  ]));
  set("objects", ([
    __DIR__ "npc/dongdaoren": 1,
    __DIR__ "npc/nandaoren": 1,
    __DIR__ "npc/xidaoren": 1,
    __DIR__ "npc/beidaoren": 1,
  ]));
  set("outdoors", "emei");
  setup();
}
int valid_leave(object me, string dir) {
  if (me->query_temp("emei/jianzhen"))
    me->delete_temp("emei/jianzhen");
  return ::valid_leave(me, dir);
}
