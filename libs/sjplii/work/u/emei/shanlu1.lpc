inherit ROOM;

void create()
{
        set("short", "山麓");
        set("long", @LONG
这是峨眉山的山麓。你只见山脉峰峦起伏，重岩迭翠，气势磅礴
，雄秀幽奇，不愧有『峨嵋天下秀』的称誉。山麓至峰顶，石径盘旋
，直上云霄。
LONG
        );
        set("exits", ([
                "eastdown" : __DIR__"shanmen",
               "westup" : __DIR__"shanlu2",
]));

        set("outdoors", "emei");
        setup();
}

