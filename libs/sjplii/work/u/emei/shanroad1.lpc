inherit ROOM;

void create() {
  set("short", "峨眉县");
  set("long", @LONG
这里是四川峨眉县，因境内有峨眉山而出名。丈许宽的城墙又高又厚，
给人一种安全的感觉。遥望城外，绿色的田野一望无垠，一座座小小的农房
星星点点的点缀着宽广的田野，傍晚时，炊烟袅袅，夕阳斜照，美不胜收。
远处连绵的群山更是令人感到威武壮观。
LONG
  );
  set("exits", ([
    "west": __DIR__ "tulu2",
    "north": __DIR__ "bingqipu",
    "southeast": __DIR__ "tulu1",
  ]));
  set("objects",
    ([
      "/npc/nknpc": 1,
    ]));
  set("outdoors", "emei");
  setup();
}
