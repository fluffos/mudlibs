#include <ansi.h>

inherit ITEM;

void create() {
  set_name("尸炼匣", ({ "shilian box", "box" }));
  set_weight(100);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("guamount", 20);
    set("unit", "只");
    set("material", "steel");
    set("long", "一个铁制小盒，里面装满[傀儡蛊]，可以用来施放(throw)。\n");
  }
}

void init() {
  add_action("do_throw", "throw");
}

int do_throw(string arg) {
  object me, target, ob;
  object *inv;
  int i;
  me = this_player();
  if (!arg)
    return notify_fail("你只能对人施放傀儡蛊。\n");
  if (me->is_busy())
    return notify_fail(" 你上一个动作还没有完成，不能下蛊。\n");
  if ((int)me->query_skill("celecurse") < 20)
    return notify_fail("你的“万蛊蚀天”不够高！\n");
  if (this_object()->query("guamount") < 1)
    return notify_fail(" 这个尸炼匣里面已经没有蛊了。\n");
  if (environment(me)->query("no_fight"))
    return notify_fail("这里不准战斗。\n");
  seteuid(getuid());
  target = present(arg, environment(me));
  if (!target)
    return notify_fail("你只能对人施放傀儡蛊。\n");
  if (!userp(present(arg, environment(me))))
    return notify_fail("你只能对人施放傀儡蛊。\n");
  inv = all_inventory(target);
  for (i = 0; i < sizeof(inv); i++) {
    if (inv[i]->query("id") == "kuileigu")
      ob = inv[i];
    continue;
  }
  if (ob) return notify_fail("这个人身上已经被下了傀儡蛊。\n");
  ob = new("/u/pima/north/obj/kuileigu");
  //	if(!ob->query_condition("kuilei"))
  //	ob->apply_condition("kuilei", 20);
  ob->set("fake_name", me->name());
  ob->set("combat_exp", target->query("combat_exp") * 2);
  message_vision(CYN "$N打开" + this_object()->name() + "的盖子，对准$n一口气吹了过去！\n" NOR, me, target);
  if (me->query("class") == "pima") {
    message_vision(BLU "\n只见一阵烟雾扬起，傀儡蛊迅速钻入了$n体内！\n" NOR, me, target);
    if ((int)target->query_skill("puti_force", 1) > 20) {
      message_vision(CYN "\n但是$n体内菩提真气运转，傀儡蛊很快被逼了出来！\n" NOR, me, target);
      return 1;
    } else
      ob->move(target);
    me->receive_wound("kee", random(100));
    this_object()->add("guamount", -1);
    return 1;
  } else
    message_vision(BLU "\n只见一阵烟雾扬起，傀儡蛊反而钻入了$N体内！\n" NOR, me, target);
  ob->move(me);
  this_object()->add("guamount", -1);
  return 1;
}
