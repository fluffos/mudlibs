#include <ansi.h>
inherit NPC;
inherit F_MASTER;
void create() {
  set_name("丁毒通", ({ "ding dutong", "master", "ding" }));
  set("nickname", HIB "毒蜘蛛" NOR);
  set("gender", "男性");
  set("age", 44);
  set("str", 60);
  set("cor", 30);
  set("cps", 30);
  set("int", 30);
  set("per", 30);
  //	set("attitude","aggresive");
  set("max_gin", 1500);
  set("max_kee", 1500);
  set("max_sen", 1500);
  set("eff_gin", 900);
  set("eff_kee", 900);
  set("eff_sen", 900);
  set("max_force", 5000);
  set("force", 5000);
  set("force_factor", 30);
  create_family("披麻教", 2, "长老");
  set("class", "pima");

  set("combat_exp", 4000000);
  set("score", 20000);

  set_skill("move", 100);
  set_skill("parry", 100);
  set_skill("stick", 80);
  set_skill("unarmed", 90);
  set_skill("kusang-bang", 70);
  set_skill("black_claw", 80);
  set_skill("dodge", 120);
  set_skill("force", 150);
  set_skill("blood_force", 150);
  set_skill("literate", 40);
  set_skill("cursism", 160);
  set_skill("celecurse", 160);
  map_skill("force", "blood_force");
  map_skill("cursism", "celecurse");
  map_skill("unarmed", "black_claw");
  map_skill("stick", "kusang-bang");
  set("chat_chance_combat", 30);
  set("chat_msg_combat", ({
    (: command, "curse redblood" :),
  }));

  setup();
  carry_object("/obj/cloth")->wear();
}

void attempt_apprentice(object me) {
  if (!me->query("class")) {
    command("smile");
    command("recruit " + me->query("id"));
  }
}

void recruit_apprentice(object ob) {
  if (::recruit_apprentice(ob))
    ob->set("class", "pima");
  ob->set("id_type", 2);
}

void re_rank(object student) {
  int exp;
  exp = (int)student->query("combat_exp");
  if (exp <= 32000) {
    student->set("title", "披麻教众");
    return;
  } else if (exp <= 64000) {
    student->set("title", "披麻教副堂主");
    return;
  } else if (exp <= 128000) {
    student->set("title", "披麻教堂主");
    return;
  } else if (exp <= 256000) {
    student->set("title", "披麻教副坛主");
    return;
  } else if (exp <= 512000) {
    student->set("title", "披麻教坛主");
    return;
  } else if (exp <= 1024000) {
    student->set("title", "披麻教副舵主");
    return;
  } else if (exp <= 1536000) {
    student->set("title", "披麻教舵主");
    return;
  } else if (exp <= 2304000) {
    student->set("title", "披麻教护法");
    return;
  } else if (exp <= 3456000) {
    student->set("title", "披麻教大护法");
    return;
  }
}
