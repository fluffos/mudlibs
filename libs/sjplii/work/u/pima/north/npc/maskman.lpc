
inherit NPC;

void create()
{
	set_name("蒙面人", ({ "maskman" }) );
	set("gender", "男性");
	set("age", 20);
	set("long", "这是一个神秘的蒙面人. \n");
	
	set("str", 48);
	set("cor", 52);
	set("cps", 22);

	set("max_kee", 600);
	set("max_gin", 600);
	set("max_sen", 600);
	set("attitude", "aggressive");

	set("chat_chance_combat", 1);
        set("chat_msg_combat", ({
                "蒙面人的目光使你不寒而颤．\n"
        }) );
	set("combat_exp", 2000 * random(100));
        set("chat_chance", 10);
        set("chat_msg", ({
                                (: random_move :)
        }) );
	
	setup();
        carry_object("/obj/cloth")->wear();
        carry_object("/obj/longsword")->wield();
}
void die()
{
	object head;
	string headname;
	headname=this_object()->query("name");
	head=new(__DIR__"obj/head");
	head->set("name",headname+"的首级");
	head->move(this_object());
	::die();
}
