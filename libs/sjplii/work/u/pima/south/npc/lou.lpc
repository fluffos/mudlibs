#include <ansi.h>

inherit NPC;
int about_here1();
string *names = ({
  "/u/pima/north/dummy1.lpc",
  "/u/pima/south/dummy1.lpc",
  "/u/pima/north/dummy2.lpc",
  "/u/pima/south/dummy2.lpc",
  "/u/pima/north/dummy3.lpc",
  "/u/pima/south/dummy3.lpc",
  "/u/pima/north/dummy4.lpc",
  "/u/pima/south/dummy4.lpc",
  "/u/pima/north/top1.lpc",
  "/u/pima/south/top1.lpc",
  "/u/pima/north/top2.lpc",
  "/u/pima/south/top2.lpc",
  "/u/pima/north/top3.lpc",
  "/u/pima/south/top3.lpc",
  "/u/pima/north/top4.lpc",
  "/u/pima/south/top4.lpc",
 });

void create()
{
	set_name("娄地府", ({ "lou difu","lou","difu" }) );
	set("gender", "男性" );
	set("age", 39);
	set("combat_exp", 2500000);
	set("attitude", "friendly");
	set("str",60);
	set("no_arrest",1);
        set("max_kee", 1200);
         set("eff_kee", 800);             
        set_skill("move", 100);
        set_skill("parry", 100);
        set_skill("stick", 100);
        set_skill("unarmed", 100);
        set_skill("kusang-bang", 70);
        set_skill("black_claw", 90);
        set_skill("dodge", 100);
        set_skill("force", 100);
        set_skill("blood_force", 100);
        set_skill("literate", 40);
	set_skill("cursism",100);
	set_skill("celecurse",100);
	map_skill("force", "blood_force");
	map_skill("cursism","celecurse");
	map_skill("unarmed", "black_claw");
	map_skill("stick", "kusang-bang");
	set("chat_chance_combat", 30 );
	set("chat_msg_combat", ({
		(: command, "curse greenblood" :),
	}) );
        set("inquiry", ([
                "quest" : (: about_here1 :),
        ]));
        create_family("披麻教", 2, "护法");
        set("class", "pima");
	setup();
	carry_object("/obj/cloth/changpao")->wear();
}
int about_here1()
{
	object ob,me;
	string questname = names[random(sizeof(names))];
	me = this_player();
	if( me->query_temp("pima/quest") )
	{
      say("娄地府说道：你怎么还站在这里，还不快去杀人！\n");
	return 1;
	}
	if( !questname )
	{
      say("娄地府说道：现在没有事情吩咐你做。\n");
	return 1;
	}
	ob = new("/u/pima/north/npc/maskman.lpc");
	ob->move(questname);
      say("娄地府说道：最近有蒙面人在"+questname->query("short")+"出现，你去提他的人头来给我！\n");
	me->set_temp("pima/quest",1);
	return 1;
}
int accept_object(object who, object ob)
{
	object me;
	me = this_player();
	if( me->query("class") != "pima" ) return 0;
	if( me->query("combat_exp") > 1500000 ) return 0;
	if( !me->query_temp("pima/quest") ) return 0;
	if( ob->query("id") != "maskman head" ) return 1;
	if( ob->query("name") == "蒙面人的首级" ) 
	{
	command("say 很好，你很有潜质，继续努力！");
	me->add("combat_exp", random(200)+1 );
	me->add("life_exp", random(10)+1 );
	me->add("potential", random(50)+1 );
	me->add("score", random(1));
	me->delete_temp("pima/quest");
	return 1;
	}
	else
return 1;
}


