// mind_beast.c

inherit NPC;

void create()
{
	set_name("独角犀牛", ({ "xiniu", "dujiao xiniu" }) );
	set("race", "野兽");
	set("gender", "雄性");
	set("age", 20);
	set("long", "这是一只凶猛无比的独角犀牛\n");
	
	set("str", 48);
	set("cor", 52);
	set("cps", 22);

	set("max_kee", 600);
	set("max_gin", 600);
	set("max_sen", 900);
	set("attitude", "aggressive");
	set("limbs", ({ "头部", "身体", "前脚", "後脚", "尾巴" }) );
	set("verbs", ({ "bite", "claw" }) );

        set("chat_chance_combat", 10);
        set("chat_msg_combat", ({
                "独角犀牛猛地向你一撞！\n",
                "独角犀牛狠狠地用巨角向你顶来！\n"
        }) );

		set("combat_exp", 90000);
		set("bellicosity", 3000 );
	
	set_temp("apply/attack", 160);
	set_temp("apply/armor", 140);

	setup();
}
