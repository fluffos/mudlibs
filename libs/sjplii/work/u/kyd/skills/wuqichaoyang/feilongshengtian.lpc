// feilongshengtian.c 飞龙剑法---飞龙升天

#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target)
{
	string msg;
	int extra;
	object weapon,ob;
	
	extra = me->query_skill("feilong-jianfa",1);
	if( !target ) target = offensive_target(me);
	if( !target
	||	!target->is_character()
	||	!me->is_fighting(target) )
		return notify_fail("［飞龙升天］只能对战斗中的对手使用。\n");
	 if( (int)me->query_skill("sword", 1) < 150 )
		    return notify_fail("你的根基不够扎实，不能使用飞龙升天。\n");
	if ( extra < 150) return notify_fail("你的飞龙剑法还不够纯熟！\n");
	   if( (int)me->query("max_force") < 1500 )
                return notify_fail("你现在内力太弱，不能使用飞龙升天。\n");
                        
        if( (int)me->query("force") < 500 )
                return notify_fail("你的真气不足，不能使用飞龙升天。\n");
	
	weapon = me->query_temp("weapon");
 /*       if( !(ob = me->query_temp("weapon"))
        ||      (string)ob->query("skill_type") != "sword" )
//	 ||      (ob = me->query_temp("weapon") !=feilong jian)

                return notify_fail("你必须用无名飞龙剑才能使用飞龙升天。\n");     */   

	me->add_temp("apply/attack", extra);	
	me->add_temp("apply/damage", extra);

 msg = HIC "只听[嗡]的一声，$N手中宝剑已疾如箭发挑了出去！接着，$N身若飞 \n" +
	"龙穿空，飞射而起，剑光连闪三闪之后，一道疾虹直射$n！\n" NOR + 
HIC "\n神龙一现催人命！" NOR;
  COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
 msg = HIC  "神龙二现摄人魂！" NOR;
 COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
 COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
 msg = HIC  "神龙三现神鬼泣！" NOR;
COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
 COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
 COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
 	me->add("force", -500);
        me->add("gin", -250);
              me->add_temp("apply/attack", -extra);
	me->add_temp("apply/damage", -extra);
      	   me->start_busy(4);
	return 1;
}




 

 
    