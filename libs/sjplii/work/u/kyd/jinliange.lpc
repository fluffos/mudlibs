// jinliange.c 金莲阁 

#include <room.h>
inherit ROOM;

void create() {
  set("short", "金莲阁");
  set("long", @LONG
金莲阁是全真教为武林人士和进香香客准备茶水和膳食的地方，可供登山
者稍作休憩。此阁建于北宋初年，由于近年全真的鼎盛香火，已修茸一新，阁
心一朵七彩金莲，卓然生辉。
LONG
  );

  set("outdoors", "quanzhen");

  set("exits", ([
    "southdown": __DIR__ "cuihuamiao",
    "westup": __DIR__ "shanlu",
    "eastup": __DIR__ "riyueyan",


  ]));
  set("objects", ([
    (__DIR__ "npc/zhangzhiguang"): 1,
  ]));

  setup();

}
