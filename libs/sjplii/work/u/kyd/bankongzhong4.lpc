inherit ROOM;
void create() {
  set("short", "半空中");
  set("long", @LONG
你现在是在半空中，身子还在不停的往下坠，虽然心中充满了恐惧和后悔，
但到了此时此刻也只能听天由命了。
LONG
  );
  set("outdoors", "quanzhen");
  setup();
}

void init() {
  if (interactive(this_player()))
    call_out("do_flush", 3, this_player());

}

void do_flush(object me) {
  object room;
  me = this_player();

  if (!me || environment(me) != this_object())
    return;
  if (me->query_temp("fu_dan")) {
    tell_object(me, "只觉身外雷声急作，电光缭绕，足下如有什么东西托着，轻飘飘地，又缓又慢的向下降去！\n");
    room = load_object(__DIR__ "xidi");
    me->move(room);
    message_vision("不知经过了多少时间，$N终于脚踏实地了。\n", me);
  } else {
    tell_object(me, "耳边都是呼呼的风声，你的身体不停的往下坠。。。。。。\n");
    room = load_object(__DIR__ "xidi");
    me->move(room);
    message_vision("[砰]的一声，$N结结实实的摔在了地上，紧跟着就失去了知觉。\n", me);
    this_player()->unconcious();
    call_out("do_clone_zhizhu", 0, me);
  }
}

void do_clone_zhizhu() {
  object me = this_player();
  object ob = this_object();
  string name;
  name = me->query("id");
  if (!me->query_temp("fu_dan")) {
    ob = new(__DIR__ "npc/zhizhu")->move(this_object());
    ob->set("zhizhu", name);
  }
}
