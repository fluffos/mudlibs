//mayu.c 马钰
#include <ansi.h>

inherit NPC;
inherit F_MASTER;

//void consider();
string ask_me();

void create()
{
	set_name("马钰", ({"master ma","ma yu", "ma", "yu"}));
	set("nickname", MAG "丹阳子" NOR);
	set("gender", "男性");
	set("age", 48);
	set("long",
             "他白须垂胸，面色红润，眉慈目善，一身道袍一尘不染。\n"
	      "他就是王重阳的首徒，全真教第二任掌教马钰。\n");
	set("attitude", "friendly");

	set("class", "quanzhen");

/*	
	set("chat_chance", 1);
	set("chat_msg", ({
		"马钰说道：“第一次华山论剑，我师傅拿了第一，得到了《九阴真经》。”\n",
		"马钰叹了口气道：“《东邪西毒，南帝北丐，中神通》，代表了上一代的五位高手。”\n",
		"马钰喃喃道：“《东邪西狂，南僧北侠 ,中顽童》，描述了当今的五位高手。” \n", 
//		(: random_move :),
	}));
*/

	set("inquiry", ([
		"九阴真经":"师傅死了以后，九阴真经落在了师叔“老玩童”周伯通的手上。\n",
		"周伯通":"听说师叔被“东邪”黄药师困在了桃花岛。\n",
		"手谕" : (: ask_me :),
	]));


	set("letter_count", 1);


	set("max_gin", 4000);
	set("max_kee", 4000);
	set("max_sen", 4000);
	set("force", 5000);
	set("max_force", 5000);
	set("force_factor", 300 );
	set("combat_exp", 5000000);
 
	set_skill("force", 170);             // 基本内功
	set_skill("ziliu-force", 170);    //
	set_skill("unarmed", 180);           // 基本拳脚
	set_skill("tiangang-quanfa", 180);     
	set_skill("dodge",160);      	     // 基本躲闪
	set_skill("qixing-huanwei", 160);        //七星换位
	set_skill("parry", 160);             // 基本招架
	set_skill("sword", 160);             // 基本剑法
	set_skill("quanzhen-jian", 160);        //全真剑法 
       set_skill("daoxue-xinfa", 160);             //道学心法
	set_skill("literate",160);           //读书写字  
	set_skill("move", 150);      	     // 基本躲闪

	map_skill("force", "ziliu-force");
	map_skill("unarmed", "tiangang-quanfa");
	map_skill("dodge", "qixing-huanwei");
	map_skill("parry", "quanzhen-jian");
	map_skill("sword", "quanzhen-jian");

	
	create_family("全真教", 2, "掌教");
	
	set("chat_chance_combat", 90);
	set("chat_msg_combat", ({
		(: perform_action, "qixinggongyue" :),
		(: exert_function, "recover" :),
	}) );


	setup();
	
	carry_object(__DIR__"obj/changjian")->wield();
	carry_object(__DIR__"obj/greyrobe")->wear();


}

void attempt_apprentice(object ob)
{	

	object me  = this_object();
	mapping ob_fam  = ob->query("family");
	mapping my_fam  = me->query("family");

	
//	if ( ob_fam["generation"] <= my_fam["generation"] )
//	{
//		command("say " + RANK_D->query_respect(ob) + "，贫道哪里敢当 !");
//		return;
//	}

if ((string)ob->query("family/family_name") != "" &&
           (string)ob->query("family/family_name") != "全真教") {
		command("say " + RANK_D->query_respect(ob) + "既然已有名师指点，何必又来拜本真人呢？");
		return;
	}
	if ((int)ob->query_str() < 20 || (int)ob->query_con() < 20) {
		command("say 当道士需能吃苦耐劳，六根清静，依我看" + RANK_D->query_respect(ob) + "的资质似乎不适合当道士？");
		return;
	}
	
       if ((int)ob->query_skill("ziliu-force", 1) < 70) {
		command("say 我全真教乃内家武功，最重视内功心法。"); 
		command("say " + RANK_D->query_respect(ob) + 
			"是否还应该在紫流气功上多下点功夫？");
		return;
       }
       command("smile");  
       command("say 好吧，贫道就收下你了。");
	command("recruit " + ob->query("id"));
	
}
	
string ask_me()
{
	mapping fam; 
	object ob;
	
	if (!(fam = this_player()->query("family")) || fam["family_name"] != "全真教")
		return RANK_D->query_respect(this_player()) + 
		"与本派素无来往，不知此话从何谈起？";

	if (  present("shou yu", this_player()) )
		return RANK_D->query_respect(this_player()) + 
		"你身上不是有了吗，怎麽又来要了？ 快去吧！";

	if (query("letter_count") < 1) return "对不起，来晚了，以后再努力吧。";

	ob = new(__DIR__"obj/allow-letter");
	ob->move(this_player());

	add("letter_count", -1);

	message_vision("$N获得一张手谕。\n",this_player());
	return "进入藏经阁以后可要好好努力，为全真教争光，不要辜负了我的厚望。";

}




