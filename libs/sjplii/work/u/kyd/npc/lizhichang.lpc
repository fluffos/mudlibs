inherit NPC;
inherit F_MASTER;

void consider();

void create()
{
	set_name("李志常", ({"li zhichang", "li", "zhichang"}));
	set("master", "丘处机");
	set("gender", "男性");
	set("age", 30);
	set("long",
             "他身形又瘦又长，肤白面洁，额下留着一瞥小胡子。\n"
		"他是丘处机的弟子，也是全真教第三代中的高手。\n");
	set("attitude", "friendly");
	set("class", "quanzhen");
	set("chat_chance", 1);

	set("kee", 2500);
	set("max_kee", 2500);
	set("force", 2500);
	set("max_force", 2500);
	set("force_factor", 150 );

	set("combat_exp", 1400000);
	
 
	set_skill("force", 90);             // 基本内功
	set_skill("ziliu-force", 90);    //
	set_skill("unarmed", 90);           // 基本拳脚
	set_skill("tiangang-quanfa", 90);     
	set_skill("dodge",90);      	     // 基本躲闪
	set_skill("qixing-huanwei", 90);        //七星换位
	set_skill("parry", 90);             // 基本招架
	set_skill("sword", 90);             // 基本剑法
	set_skill("quanzhen-jian", 90);        //全真剑法 
	set_skill("daoxue-xinfa",90);           //道学心法  
        set_skill("literate",90);           //读书写字  
   
	map_skill("force", "ziliu-force");
	map_skill("unarmed", "tiangang-quanfa");
	map_skill("dodge", "qixing-huanwei");
	map_skill("parry", "quanzhen-jian");
	map_skill("sword", "quanzhen-jian");

	create_family("全真教", 3, "弟子");
	setup();
	
	carry_object(__DIR__"obj/changjian")->wield();
	carry_object(__DIR__"obj/yellowrobe")->wear();


}













