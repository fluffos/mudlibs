inherit NPC;
inherit F_MASTER;

void consider();

void create()
{
	set_name("祁志诚", ({"qi zhicheng", "qi", "zhicheng"}));
	set("master", "马钰");
	set("gender", "男性");
	set("age", 32);
	set("long",
             "他身形不胖不瘦，肤色黝黑，额下留着一撮胡须。\n"
		"他是马钰的弟子，也是全真教第三代中的高手。\n");
	set("attitude", "friendly");

	set("class", "quanzhen");
	
	set("chat_chance", 3);
	set("chat_msg", ({
		"祁志诚说道：“师傅总是不肯给我手谕。不知道何日才能进藏经阁？唉。。”\n",
	//	(: random_move :),
	}));
	set("zhi_count", 1);


	set("kee", 2500);
	set("max_kee", 2500);
	set("force", 2500);
	set("max_force", 2500);
	set("force_factor", 150 );

	set("combat_exp", 500000);
	
 
	set_skill("force", 60);             // 基本内功
	set_skill("ziliu-force", 60);    //
	set_skill("unarmed", 60);           // 基本拳脚
	set_skill("tiangang-quanfa", 60);     
	set_skill("dodge",60);      	     // 基本躲闪
	set_skill("qixing-huanwei", 60);        //七星换位
	set_skill("parry", 60);             // 基本招架
	set_skill("sword", 60);             // 基本剑法
	set_skill("quanzhen-jian", 60);        //全真剑法 
	set_skill("daoxue-xinfa",60);           //道学心法  
        set_skill("literate",60);           //读书写字  
   
    
	map_skill("force", "ziliu-force");
	map_skill("unarmed", "tiangang-quanfa");
	map_skill("dodge", "qixing-huanwei");
	map_skill("parry", "quanzhen-jian");
	map_skill("sword", "quanzhen-jian");
            set("chat_chance_combat", 90);
	set("chat_msg_combat", ({
		(: perform_action, "qixinggongyue" :),
		(: exert_function, "recover" :),
	}) );



	create_family("全真教", 3, "弟子");
	setup();
	
	carry_object(__DIR__"obj/changjian")->wield();
	carry_object(__DIR__"obj/yellowrobe")->wear();


}

int accept_object(object me, object obj)

{	
	object ob1,zhi;
	mapping fam; 
	
     if (!(fam = this_player()->query("family")) || fam["family_name"] != "全真教")
	{
		tell_object(obj, "祁志诚说道：你非本派弟子，如何会有本门手谕。\n");
		return 1;
	}

	if (query("zhi_count") < 1)
	{
		tell_object(obj, "祁志诚说道：对不起，牛皮纸我已经给人了。\n");
		return 1;
	}

       if( (string) obj->query("name") == "手谕"  )
	{
        command("smile");
	command("say 太谢谢你了！这个给你！\n");
	zhi = new(__DIR__"obj/niupizhi");
	if(zhi)
	zhi->move(this_player());
    //   message_vision("$N给了$n一张牛皮纸。\n",this_object(),this_player());
	add("zhi_count", -1);
	return 1;	
	}
}
void destroying(object obj)
{
          destruct(obj);
        return;
}

