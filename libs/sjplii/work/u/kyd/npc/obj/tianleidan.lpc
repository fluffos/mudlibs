#include <ansi.h>
inherit ITEM;
//void setup()
//{}

void create() {
  set_name("天雷丹", ({ "tianlei dan", "dan" }));
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "颗");
    set("long", "这是一颗火红色圆溜溜的药丸，散发一股清香。\n");
    set("value", 100);
    set("no_drop", 1);
    set("no_get", 1);
    set("quanzhen", 1);
  }
  setup();
}
void init() {
  add_action("do_fu", "fu");
}
int do_fu() {
  object me;
  me = this_player();

  //     if (!id(arg))
  //     return notify_fail("你要吃什么？\n");

  message_vision(HIG "$N吃下一颗天雷丹，只觉得浑身有使不完的力气！\n" NOR, me);
  me->set_temp("fu_dan", 1);
  destruct(this_object());

  return 1;

}
