#include <ansi.h>

inherit ITEM;

void create()
{
        set_name("残缺不全的地图一", ({"di tu", "tu", "map"}));
        set_weight(100);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "张");
                set("long","这是张残缺不全的地图，上面虽然有些注解文字，但是由于地图\n"+
				 "的残缺不全你跟本无法弄明白它的意思，看来只有找到其余的部\n"+
				 "分，你才有可能知道这张地图到底描述的是什么东西。\n");
					
		set("no_drop", "这样东西不能离开你。\n");
             	set("no_give", "这样东西不能随便给人。\n");
              set("material", "paper");
        }
}
