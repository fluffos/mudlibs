
#include <ansi.h>
inherit NPC;
inherit F_MASTER;

string ask_job();

void create()
{
	set_name("尹志平", ({"yin zhiping", "yin", "zhiping"}));
	set("gender", "男性");
	set("age", 24);
	set("long",
             "他羽衣星冠，眉清目秀，气度高华，脱俗出尘。\n"
		"他是全真教第三代弟子中最出类拔翠的一个。\n");
	set("attitude", "friendly");

	set("class", "quanzhen");

	set("chat_chance", 1);
	set("chat_msg", ({
		(: random_move :),
	}));

	set("kee", 3500);
	set("max_kee", 3500);
	set("force", 3500);
	set("max_force", 3500);
	set("force_factor", 150 );
	
	set("combat_exp", 900000);
 
	set_skill("force", 80);             // 基本内功
	set_skill("ziliu-force", 80);    //
	set_skill("unarmed", 80);           // 基本拳脚
	set_skill("tiangang-quanfa", 80);     
	set_skill("dodge",80);      	     // 基本躲闪
	set_skill("qixing-huanwei", 80);        //七星换位
	set_skill("parry", 80);             // 基本招架
	set_skill("sword", 80);             // 基本剑法
	set_skill("quanzhen-jian", 80);        //全真剑法 
        set_skill("daoxue-xinfa",80);           //道学心法   
	set_skill("literate",70);           //读书写字  
   
      
	map_skill("force", "ziliu-force");
	map_skill("unarmed", "tiangang-quanfa");
	map_skill("dodge", "qixing-huanwei");
	map_skill("parry", "quanzhen-jian");
	map_skill("sword", "quanzhen-jian");
           set("chat_chance_combat", 90);
	set("chat_msg_combat", ({
		(: perform_action, "qixinggongyue" :),
		(: exert_function, "recover" :),
	}) );



	
	create_family("全真教", 3, "弟子");
/*	set("inquiry", 
                ([
                        "工作" : (: ask_job :),
                            "job" : (: ask_job :),
            
                ]));
*/
	setup();
	
	carry_object(__DIR__"obj/changjian")->wield();
	carry_object(__DIR__"obj/yellowrobe")->wear();

}

void attempt_apprentice(object ob)
{
	object me  = this_object();

//	mapping ob_fam = ob->query("family");
//	mapping my_fam = me->query("family");
//	if ( ob_fam["family_name"] == "全真教" && (ob_fam["generation"] <= my_fam["generation"]) )    
//	{
//		command("say" + RANK_D->query_respect(ob) + "，贫道哪里敢当 !");
//		return;
//	}

	command ("smile");
	command("say 好吧，我就收下你了。");
	command("recruit " + ob->query("id"));
	if( (string)ob->query("class") != "quanzhen")
		ob->set("class", "quanzhen");
}
