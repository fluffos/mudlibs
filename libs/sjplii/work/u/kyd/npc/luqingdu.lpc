inherit NPC;
string ask_me();
string *names = ({ "竹叶青", "绍兴女儿红", "泸州老窑", "贵州茅台", "四川五粮液", "桂林三花酒", "山西汾酒", });
void create() {
  set_name("周清辉", ({ "zhou qinghui", "zhou", "qinghui" }));
  set("gender", "男性");
  set("age", 18);
  set("long",
    "他长的还算清秀，是王处一道长的徒孙。\n");
  set("attitude", "friendly");
  set("master", "赵志敬");

  set("str", 21);
  set("int", 18);
  set("con", 21);
  set("dex", 18);

  set("chat_chance", 1);
  set("chat_msg", ({
    "周清辉叹道：“刘祖师爷叫我帮他去买酒，可是我又。。。这可如何是好？”\n",
    //		(: random_move :),
  }));
  set("inquiry", ([
    "买酒": (: ask_me :),
  ]));


  set("silver_count", 1);

  set("kee", 1500);
  set("max_kee", 1500);
  set("force", 1500);
  set("max_force", 1500);

  set("combat_exp", 100000);

  set_skill("force", 50);             // 基本内功
  set_skill("ziliu-force", 50);    //
  set_skill("unarmed", 50);           // 基本拳脚
  set_skill("tiangang-quanfa", 50);
  set_skill("dodge", 50);            // 基本躲闪
  set_skill("qixing-huanwei", 50);        //七星换位
  set_skill("parry", 50);             // 基本招架
  set_skill("sword", 50);             // 基本剑法
  set_skill("quanzhen-jian", 50);        //全真剑法 
  set_skill("literate", 50);           //读书写字  
  set_skill("daoxue-xinfa", 50);

  map_skill("force", "ziliu-force");
  map_skill("unarmed", "tiangang-quanfa");
  map_skill("dodge", "qixing-huanwei");
  map_skill("parry", "quanzhen-jian");
  map_skill("sword", "quanzhen-jian");

  create_family("全真教", 4, "弟子");
  setup();

  carry_object(__DIR__ "obj/changjian")->wield();
  carry_object(__DIR__ "obj/greenrobe")->wear();
}
string ask_me() {
  mapping fam;
  object ob;
  string target;

  target = names[random(sizeof(names))];


  if (!(fam = this_player()->query("family")) || fam["family_name"] != "全真教")
    return RANK_D->query_respect(this_player()) + "与本派素无来往，不知此话从何谈起？";
  if (this_player()->query_temp("lu_give"))
    "不是给过你了吗，怎麽又来要了？ 快去吧，刘祖师爷要等不急了。";

  if (query("silver_count") < 1) return "已经有人去买了，不用麻烦了。";

  message_vision(
    "$N对着$n说道：就烦劳" + RANK_D->query_respect(this_player()) + "下山跑一趟了。\n",
    this_object(),
    this_player()
  );
  this_player()->set_temp("job_name", target);
  this_player()->set_temp("lu_give", 1);
  add("silver_count", -1);
  ob = new("/obj/money/silver");
  ob->move(this_player());

  message_vision("$N给了$n一些银子。\n", this_object(), this_player());
  this_player()->add_money("silver", 1);

  return "刘祖师爷想要喝的是" + target + "，可不要买错了。\n";

}
