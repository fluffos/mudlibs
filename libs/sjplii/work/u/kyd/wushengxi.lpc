#include <room.h>
inherit ROOM;

void create()
{
	set("short", "无生隙");
	set("long", @LONG
这里就是江湖上传说的无生隙，数百年来，凡来探隙者都是从这里跳下去（tiao)的,
但都是有去无回。此隙从上面看上去约有八尺宽，下面逐渐加大，以斗大的石头投下去，
守十天都听不到回音。隙四周阴风惨惨，左边的石壁（shibi)上依稀可见，有人用宝剑
刻着几行字。
LONG
	);
	set("outdoors", "全真教");

	set("exits", ([
		"out" : __DIR__"fengdong",
	]));
	set("item_desc",([
		"shibi"	:	"\n\t\t\t\n\n\n" 
					"\t\t∷∷∷∷∷∷∷∷∷∷∷∷∷∷\n"
					"\t\t∷　 　　　　　　　　　　 ∷\n"
                                  "\t\t∷   无   不   如   及    ∷\n"
				       "\t\t∷　 　　　　　　　　　　 ∷\n"
                                  "\t\t∷   生   归   欲   早    ∷\n"
	 	                    "\t\t∷　　 　　　　　　　　　 ∷\n"
                 	       	"\t\t∷   奇   之   活   回    ∷\n"
					"\t\t∷　　　　　　　　　　　　∷\n"
					"\t\t∷   隙   路   命   头    ∷\n"
					"\t\t∷　   	                  ∷\n"
					"\t\t∷　   	                  ∷\n"
					"\t\t∷　   	      王重阳      ∷\n"
					"\t\t∷　   	                  ∷\n"
					"\t\t∷∷∷∷∷∷∷∷∷∷∷∷∷∷\n\n\n",
							
		]));

	setup();
}

void init()
{          
            add_action("do_jump", "jump");
       add_action("do_jump", "tiao");
}

int do_jump(string arg)
{ 
        mapping fam;
        object me = this_player();
        int dex = me->query("dex");
  
     if ( !living(me) ) return 0;
   
        if( !arg || arg=="" || arg !="down" ) return 0;
        me->add_temp("mark/jump",1);
   
        message("vision",
               me->name() + "眼睛一闭，纵身跳下深隙。\n",
               environment(me), ({me}) );
        write("你一闭眼, 纵身跳下深谷。\n");
        me->move(__DIR__"bankongzhong");
	return 1;

}    






