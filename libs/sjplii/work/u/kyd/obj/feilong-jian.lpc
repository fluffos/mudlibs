#include <weapon.h>
#include <ansi.h>

inherit SWORD;

void create() {
  set_name(HIC "飞龙剑" NOR, ({ "feilong jian", "jian", "sword" }));

  set_weight(10000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long",
      "长不及一尺，剑身成龙型，看来毫不出奇，即无光泽，又不锋利，可
是那既不是铁的，也不是木的，连柄带剑都不知是什么东西制成的。

。\n");
    set("value", 0);
    set("material", "steel");
    set("weapon_prop/strength", 15);
    set("wield_msg", HIC "$N手按弹簧，「嚓」的一声龙吟，宝剑出鞘，一道青光，
明如秋水，映着阳光生辉刺目，冷气逼人。\n" NOR);
    set("unwield_msg", HIC "飞龙剑自$N掌中飞起，在半空中一转，霍的一声龙吟，青虹电闪，宝剑已跃入剑鞘。\n" NOR);
  }
  init_sword(135);
  setup();
}
