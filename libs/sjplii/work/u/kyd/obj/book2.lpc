// book.c

inherit ITEM;

void create()
{
	
        set_name( "一阳指提高篇", ({ "yiyang book","book" }));
        set_weight(100);
        set("unit", "本");
        set("long", "这是一本大理一阳指入门秘籍。\n");
       set("no_drop", "这样东西不能离开你。\n");
        set("no_get", "这样东西不能离开那儿。\n");
        set("treasure",1);

	   set("skill", ([
                "name":                 "yiyang-zhi",
                "exp_required": 50000,                
                "sen_cost":      30,     
                "difficulty":   40,            
                "max_skill":    80,           
                                            
        ]) );
}
