
inherit ITEM;

void create()
{
        set_name("一张枯黄的纸", ({"paper", "zhi"}));
        set_weight(100);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "张");
                set("long","这是一张枯黄的纸，纸上依稀写着几行字：\n"+
			"\n吾乃大屠门第七代掌门宇文登，于清虚散人决战终南山顶，然以\n"+
			"\n一招之差，败在其飞龙剑法下，引为吾终身之憾事。吾知在有生之年\n"+
			"\n无法达到本门刀法之最高境界-----刀人和一，郁郁而终。为使本门\n"
			"\n刀法能留传于世，特录密籍一本，藏于此洞，以赠有缘之人。\n");                
		set("no_drop", "这样东西不能离开你。\n");
             	set("no_give", "这样东西不能随便给人。\n");
              set("material", "paper");
        }
}

