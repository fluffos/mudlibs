#include <room.h>
inherit ROOM;

void create() {
  set("short", "河边");
  set("long", @LONG
一箭之外，地面上形成一条极深的河，水流急湍，直朝前面一条壁下穿进。
LONG
  );
  set("no_clean_up", 0);
  set("outdoors", "全真教");

  setup();

}
void init() {
  add_action("do_dive", "dive");
}

int do_dive() {
  object me = this_player();
  message_vision("$N纵身跃起，跳进河里，一转眼就不见了.\n", me);
  me->move("/u/kyd/hedi2");
  return 1;
}
