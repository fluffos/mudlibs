

inherit ROOM;

void create()
{
        set("short", "河底");
        set("long", @LONG
四周黑忽忽的，头顶上看不见一点亮光，身边的水流忽上忽下的涌动
着。脚下似乎有一点亮光，也不知是些什么。周围一片死寂。
LONG
        );
//        set("exits", ([ /* sizeof() == 1 */
//  "west" : __DIR__"guangchang",
// ]));
        set("no_clean_up", 0);
        set("outdoors", "全真教");

        setup();
  
}
void init()
{
        if(interactive(this_player()))
        call_out("do_flush",3,this_player());
        
}

void do_flush(object me)
{
        object room;
        me = this_player();

        if(!me || environment(me) != this_object())
                return;
        tell_object(me,"水流一阵涌动，你只能顺着流水前进！\n");
        room= load_object(__DIR__"hedi1");
        me->move(room);
        
}       