
#include <room.h>
inherit ROOM;

void create()
{
        set("short", "潭底");
        set("long", @LONG
周围一片死寂，潭中的鱼都在四处逃窜，头顶上看不见一点亮光，身边的水流
忽上忽下的涌动着。脚下似乎有一点亮光，也不知是些什么。你仿佛感到黑暗中有
一双眼睛正盯着你，心中不由涌起一股不祥之兆。
LONG
        );
//        set("exits", ([ /* sizeof() == 1 */
//  "west" : __DIR__"guangchang",
// ]));
        set("no_clean_up", 0);
        set("outdoors", "全真教");
set("objects", ([
		(__DIR__"npc/fish") : 2,
		]));

        setup();
  
}
void init()
{
	if(interactive(this_player()))
	call_out("do_flush",3,this_player());
	
}

void do_flush(object me)
{
	object room;
	me = this_player();

        if(!me || environment(me) != this_object())
                return;
	tell_object(me,"水流一阵涌动，你感到被什么东西吸了过去！\n");
	room= load_object(__DIR__"tan2");
	me->move(room);
	
}	

