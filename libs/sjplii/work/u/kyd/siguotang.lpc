// siguotang.c 思过堂

#include <room.h>
inherit ROOM;

void create() {
  set("short", "思过堂");
  set("long", @LONG
这里是思过堂，四周都是用大青石砌成的墙，没有出口，显的十分的安
静。堂大梁上挂着几盏灯笼，正中的桌案上点着香烛，桌案上方写着一个大
大的思字，笔法苍劲有力。两边的株子上挂着一副对联（duilian）。
LONG
  );


  set("item_desc", ([
    "duilian": "\n"
    "\t\t∷∷∷∷∷∷∷∷∷∷∷∷∷∷∷∷∷∷∷∷∷\n"
    "\t\t∷　      人　　　　　　　知　        ∷∷\n"
    "\t\t∷        非              错          ∷∷\n"
    "\t\t∷　      圣　　　　　　　能　　　    ∷∷\n"
    "\t\t∷        贤              改          ∷∷\n"
    "\t\t∷　　     ， 　　　　　　，　　      ∷∷\n"
    "\t\t∷        孰              善          ∷∷\n"
    "\t\t∷　　　　能　　　　　　  莫　　　    ∷∷\n"
    "\t\t∷　      无              大          ∷∷\n"
    "\t\t∷　　　　过　　　　　　　焉　　      ∷∷\n"
    "\t\t∷　       。             。          ∷∷\n"
    "\t\t∷∷∷∷∷∷∷∷∷∷∷∷∷∷∷∷∷∷∷∷∷\n\n\n",

  ]));

  setup();

}



void init() {
  object ob = this_player();

  ob->set("startroom", "/u/kyd/siguotang");
  ob->apply_condition("taoist_jail", 60);

}
