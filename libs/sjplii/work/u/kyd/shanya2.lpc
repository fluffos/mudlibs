
#include <room.h>
inherit ROOM;

void create()
{
        set("short", "山崖");
        set("long", @LONG
已钻入云雾之中，放眼白茫茫一片。
。
LONG
        );
       set("no_clean_up", 0);
        set("outdoors", "quanzhen");

        setup();
  //      replace_program(ROOM);
}
void init()
{
        add_action("do_climb", "climb");
        add_action("do_climb", "pa");

}
int do_climb(string arg)
{
        object 	me;
	int	mlvl;

	if(!arg || (arg != "up" && arg != "down")) {
		write("你要往上或下爬？\n");
		return 1;
	}
	me = this_player();
	if( arg == "up") {
	          message_vision ("$N双臂交互攀援，爬得甚是迅捷。\n", me);
		message_vision("\n$N小心翼翼地向上爬去，身形慢慢被云雾遮掩。\n", me);
		me->move(__DIR__"shanding");
             me->add("force",-100);
		me->improve_skill("dodge",(int)(me->query_int()) +
                                                  (int)(me->query_skill("dodge", 1)) );

	}
	else {
		message_vision("$N小心翼翼地向下爬去，身形慢慢被云雾遮掩。\n", me);
		me->move(__DIR__"shanya");
		me->add("force",-100);
		me->improve_skill("dodge",(int)(me->query_int()) +
                                                  (int)(me->query_skill("dodge", 1)) );

	}
	return 1;
}








