// dusongge.c 独松阁 

#include <room.h>
inherit ROOM;

void create() {
  set("short", "独松阁");
  set("long", @LONG
这里是独松阁，四周植遍了花木，其中有一棵老松巍峨耸立，伸展的枝叶
遮掩了大半个天空。这里同宝泉一样位于山腰。阁就是有这一株千年古松而得
名。独松阁四周鸟语花香，景色如画，为览胜之佳地。
LONG
  );
  set("outdoors", "quanzhen");

  set("exits", ([
    "east": __DIR__ "baoquan",
    "northup": __DIR__ "guanyintai",



  ]));
  setup();
  replace_program(ROOM);
}
