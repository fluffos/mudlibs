// /u/xiyu/npc/army_2.c

inherit NPC;
int eff_kees(object me);
int do_detect(object me);
void create()
{
	object me=this_player();
        set_name("短刀兵", ({ "army men" }) );
	set("title","一百名");
        set("attitude", "heroism");
        set("pursuer", 1);
        set("player_army", "zhang jianhao");
        set("vendetta_mark", "authority");
	set("str",50+random(50));
        set("long",
                "这是一队军容整齐的短刀兵，约有一百人之多。\n");
        set("max_kee", 10000);
        set("max_sen", 10000);
        set("max_gin", 10000);
        set("kee", 10000);
        set("sen", 10000);
        set("gin", 10000);
	set("food", 300);
	set("water", 300);
        set("combat_exp", 1000000);
        set("score", 1000);
        set_skill("blade", 50+random(50));
        set_skill("unarmed", 50+random(50));
        set_skill("parry", 50+random(50));
        set_skill("move", 50+random(50));
        set_skill("dodge", 50+random(50));
	set("chat_chance_combat", 50);
	set("chat_msg_combat", ({
		(: eff_kees(this_object()) :),
	}) );
        set("chat_chance", 50);
        set("chat_msg", ({
                (: do_detect :),
        }) );
        setup();
        carry_object("/obj/weapon/blade")->wield();
        carry_object("/u/xiyu/obj/tiejia")->wear();
        call_out("eff_kees", 2, me);
}
void init()
{
add_action("do_look","look");
}

int do_look(string arg)
{

if (arg == "army men" )
{
write("这是一队军容整齐的短刀兵。\n");
write("他们军纪严明，刀枪林立。\n");
write("短刀兵旗号在风中飘扬，猎猎作响，煞是威风。\n");
return 1;
}
return 0;
}

int heal_up()
{
	object mguard=this_object();
	mguard->set("title", chinese_number(mguard->query("kee")/100)+"名");
	if( (string)mguard->query("player_army")&& !present((string)mguard->query("player_army"),environment(mguard))
 && !userp(environment(mguard)) && random(9)>4)
	{
		call_out("leave", 1);
		return 1;
	}
	return ::heal_up() + 1;
}

int eff_kees(object me)
{
	object mguard=this_object();
	mguard->set("title", chinese_number(mguard->query("kee")/100)+"名");
       return 1;
}

void leave()
{
//	message("vision",name()+"急急忙忙地离开了。\n"NOR , environment(),this_object()); 
	destruct(this_object());
}

void die()
{
	object owner;
	owner = this_object()->query("possessed");
	if ( owner )
	owner->add("battle/reward", -200 );
::die();
}
int do_detect(object me)
{
	object owner;
	me = this_object();
	if (present("xiongnu bing", environment(me)))
	{
	command("kill xiongnu bing 2");
	return 1;
	}
	if ( me->query("water") < 1)
	{
	destruct(me);
	return 1;
	}
return 1;
}
int accept_fight(object me)
{
        command("say 我们身负镇守边关的重任，不敢违反军纪。\n");
        return 0;
}
