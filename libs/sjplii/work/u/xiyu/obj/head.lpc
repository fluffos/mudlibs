inherit ITEM;

void create()
{
        set_name("首级", ({"enemy head","head"}));
        set_weight(80);
        if (clonep())
                set_default_object(__FILE__);
        else {
         set("long", "这是一个鲜血淋漓的人头。\n");
                set("unit", "个");
                set("value", 0);
                set("objattrib", 1);
        }
}

