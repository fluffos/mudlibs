inherit ROOM;

void create()
{
        set("short", "丝绸之路");
          set("long", @LONG
这是一条中原和西域之间的官道。东面是一望无际的平原，那
就是兵戎相见的战场。西南则通向一片连绵的山脉，东面就是通
向中原的路。
LONG );
        set("outdoors", "xingxiuhai");

        set("exits", ([
             "east" : __DIR__"battle3",
		"west" : __DIR__"battle6",
		"north" : __DIR__"battle6",
		"south" : __DIR__"battle5",
        ]));
        set("objects", ([
              __DIR__"npc/xiongnu1" : 1,
		__DIR__"npc/enemy1" : 1,
        ]));

        set("item_desc", ([
                "shibei" : "北至西域，东达中原。\n",
        ]));

        setup();
}
