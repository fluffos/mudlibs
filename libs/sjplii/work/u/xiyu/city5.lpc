inherit ROOM;
void create()
{
        set("short", "庭州");
        set("long", @LONG
这里是黄山境内的太平县。丈许宽的城墙又高又厚，给人一种安全的感
觉。遥望城外，绿色的田野一望无垠，一座座小小的农房星星点点的点缀着
宽广的田野，傍晚时，炊烟袅袅，夕阳斜照，美不胜收。远处连绵的群山更
是令人感到威武壮观。
LONG
        );
        set("exits", ([ /* sizeof() == 4 */
  "east" : __DIR__"huangtulu",
  "west"  : __DIR__"guanroad2", 
  "south"  : __DIR__"chaguan", 
]));
        set("outdoors", "huangshan");
        setup();
        replace_program(ROOM);
