inherit ROOM;

void create()
{
	set("short", "小院");
	set("long", @LONG
这里是个小院子，院子了种了花草，中间有个小石桌子，还
有几个石墩子。现在这里没有人。这里往东是庄主的丹房，往东
北去就到了后宅的大门了。往西北是通往悬崖的小路，途中会经
过花房。往西南是个通往山下的偏门。
LONG
	);
	set("exits", ([ /* sizeof() == 5 */
	"south" : __DIR__"zl1",
	"east" : __DIR__"danfang",
	"northeast" : __DIR__"houzhai",
	"northwest" : __DIR__"hspath1",
	"southwest" : __DIR__"pianmen",
	]));
