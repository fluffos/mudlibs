inherit ROOM;

void create() {
  set("short", "树冠");
  set("long", @LONG
很明显，是这个巨大的树冠救了你的命。这是个从半山腰的
悬崖上横生长出的一个松树，不知已经活了多大的时间了。树冠
上有着一些上面峭壁上落下的枯老的藤蔓，你仰头可以看到那些
年轻着的绿色藤蔓在你的不远处密密麻麻的攀沿着峭壁。
LONG
  );
  set("exits", ([ /* sizeof() == 2 */
  ]));
  set("item_desc", ([
    "绿色藤蔓": "你透过密密麻麻的绿色藤蔓，隐约可见藤蔓后好象有一个洞口。\n",
  ]));
  set("no_clean_up", 0);
  set("outdoors", "jakey");
  setup();
}

void init() {
  add_action("do_enter", "enter");
  add_action("do_climb", "climb");
}

int do_enter(string arg) {
  if (arg != "洞口" && arg != "hole") return 0;
  message_vision("$N拨开密密麻麻的藤蔓，露出了一个洞口，$N弯腰钻了进去。\n", this_player());
  this_player()->move(__DIR__ "hole1");
  message_vision("$N从外面钻了进来。\n", this_player());
  return 1;
}

int do_climb(string arg) {
  if (arg != "绿色藤蔓" && arg != "藤蔓") return 0;
  write("你伸手抓住一根藤蔓，慢慢的向悬崖上面爬去。\n");
  this_player()->move(__DIR__ "xuanya");
  message_vision("$N从悬崖下爬了上来。\n", this_player());
  return 1;
}
