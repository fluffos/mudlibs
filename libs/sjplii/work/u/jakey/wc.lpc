inherit ROOM;

void create()
{
	set("short", "茅房");
	set("long", @LONG
这里是落月山庄的茅房，因为有人每天打扫，里面很清洁，
而且还有焚香，空气中飘浮着一淡淡的香气。这里有一排蹲位，
你可以在此出恭(chugong)。
LONG
	);
	set("exits", ([ /* sizeof() == 1 */
	"east" : __DIR__"zl2",
	]));
	set("objects", ([ /* sizeof() == 2 */
	__DIR__"npc/waiter1" : 1,
	]));
	set("no_clean_up", 0);

	setup();
}

void init()
{
	add_action("do_chugong","chugong");
}

int do_chugong()
{
	if ((int)this_player()->query_temp("haved")>4) {
		write("你由于连续出恭，拉的头昏眼花，浑身脱力，脚下一个不稳，栽了下去。\n");
		this_player()->delete_temp("haved");
		this_player()->move(__DIR__"wc1");
		this_player()->unconcious();
		return 1;}
	else {
		write("你找了个蹲位，褪下中衣，蹲了下去，啊～　～　～　～，真是畅快呀！！！\n");
		this_player()->receive_heal("gin",25);
		this_player()->receive_heal("kee",25);
		this_player()->receive_heal("sen",25);
		this_player()->add_temp("haved",1);
		return 1;
	     }
}
