inherit NPC;
 
void create()
{
        set_name("成夫人", ({ "cheng furen","furen","cheng" }) );
	set("title", "落月山庄" );
        set("gender", "女性" );
        set("age", 40);
        set("long", "  比起她的丈夫来说，夫人可是年轻的多了。白玉般的手臂，\n"
		    "细柳腰，三寸金莲。高耸的云鬓，柳凤眉，小翘鼻子，朱唇。\n"
		    "惊人的美艳。无论是谁见了都不会认为她居然生过一个姑娘。\n"
);
        set("combat_exp",5000 );
	set("attitude", "friendly");
        set("chat_chance",3);
        set("chat_msg",({
"成夫人自言自语道：这个老道，去配个药怎么这么慢，真是急死我了。\n",
"成夫人喃喃祈祷道：救苦救难的观音菩萨，你一定要报佑我儿快快好转呀。\n",
}));
        set_skill("unarmed",20);
        set_skill("dodge", 20);
        set_skill("force",20);        

        setup();
        carry_object("/u/jakey/obj/changqun")->wear();
	carry_object("/u/jakey/obj/xiang")->wear();
}

int accept_object(object me,object ob)
{
	object pill;
	pill=new("/u/jakey/special/healpill");
	if (!((string)ob->query("name")=="金蟾再造丸" && 
	    (string)ob->query("id")=="gold pill")) return 0;
	command("say 就是这个药可以救小姐吗？" + RANK_D->query_respect(ob) + "，真是太感谢你了。");
	command("thank "+(string)me->query("id"));
	command("say 走，我带你去见庄主，他一定会酬谢你的。");
	pill->move(this_player());
	call_out("go_room",1,me);
	return 1;
}

void go_room(object me)
{
	object cheng;
	cheng=new("/u/jakey/npc/master");
	write("成夫人带着你来到了成斌的书房。\n");
	cheng->move("/u/jakey/bookroom");
	me->move("/u/jakey/bookroom");
	cheng->good_boy();
}
