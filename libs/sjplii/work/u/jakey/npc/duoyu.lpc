inherit NPC;
 
void create()
{
        set_name("多余", ({ "neversaybye","never","bye" }) );
	set("title", "流浪小子" );
        set("gender", "男性" );
        set("age", 15);
        set("long", "一个流浪小子。\n");
        set("combat_exp",20000);
	set("attitude", "friendly");
        set_skill("unarmed",100);
        set_skill("dodge", 100);
        set_skill("force",100);        

        set("force", 1500);
        set("max_force", 1500);
//	 set("inquiry", ([
//         ]));

     
        setup();
        carry_object("/u/jakey/obj/cloth")->wear();
}

