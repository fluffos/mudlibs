inherit NPC;
void do_drink();

void create()
{
        set_name("陈护法", ({"chen hufa","chen","hufa"}) );
	set("nickname","一剑擎天");
        set("gender","男性");
        set("age",35);
        set("attitude","heroism");
        set("str",30);
        set("cor",24);
        set("cps",21);
        set("con",24);
        set("force",1500);
        set("max_force",1500);
        set("force_factor",45);

        set("long",           
"陈方生是落月山庄的四大护法之一，因一手封山剑法使的是出神入化\n"
"人送外号“一剑擎天”。唯一的爱好是杯中之物。\n");
        set("combat_exp", 200000);

        set_skill("force",120);
        set_skill("dodge",120);
        set_skill("parry",120);
        set_skill("unarmed",120);
        set_skill("qingfeng-steps",120);
        set_skill("luanyu-strike",120);
        set_skill("xuanyue-force",120);
        set_skill("luoyue-sword",120);
        
        map_skill("unarmed","luanyu-strike");
        map_skill("force","xuanyue-force");
        map_skill("parry","luoyue-sword");
        map_skill("sword","luoyue-sword");
        map_skill("dodge","qingfeng-steps");

        set("chat_chance",1);
        set("chat_msg",({
	"陈护法自言自语道：“那天在马老板那里喝的可真痛快呀。”\n",
	}));
        set("inquiry",([
               "马老板": "呵呵，前几日在镇上马老板请我去喝酒，他拿了\n"
                         "一瓶叫什么的酒，真该死，这么好喝的酒我居然忘了叫什么了。 \n",
	]));
        setup();  
        carry_object("/u/jakey/obj/jscloth")->wear();
        carry_object("/u/jakey/obj/changjian")->wield();
}

int recognize_apprentice(object ob)
{
	if( ob->query_temp("hufa1/xue") ) return 1;
	return 0;
}

int accept_object(object me,object ob)
{
	if (!((string)ob->query("name")=="猴儿酒壶" && 
	    (string)ob->query("id")=="houer jiu")) return 0;
	command("haha");
	command("say 真是太好了，这次我一定要喝个一醉方休。");
	this_player()->set_temp("marks/kill_chenhufa",1);
	call_out("do_drink",1,this_player());
	me->set_temp("hufa1/xue",1);
	return 1;
}

void do_drink()
{
	object *list, ob;
	int i, can_drink;
	if ((int)this_object()->query("water") >= 380) return;
	list = all_inventory(this_object());
	i = sizeof(list);
	can_drink = 0;
	while (i--) {
		if ((string)list[i]->query("liquid/type") == "alcohol") {
		ob = list[i];
		can_drink = 1;
        	}
	}
	while ( (int)ob->query("liquid/remaining") > 0 ) {
//	if (can_drink) {
	command("drink "+(string)ob->query("id"));
//	if ((int)ob->query("liquid/remaining") == 0)
//           command("drop "+(string)ob->query("id"));
    }
    return;
}

int accept_fight(object ob)
{
	if(ob->query("combat_exp")>400000) {
		command("say " + RANK_D->query_self(this_object())
				+ "武艺低微，怎么可能是" + RANK_D->query_respect(ob)
				+ "的对手？\n");
			return 0;}

	if(ob->query("combat_exp")<50000) {
		command("say " + RANK_D->query_self_rude(this_object())
				+ "没空呢，你这" + RANK_D->query_rude(ob)
				+ "给我滚开！\n");
			return 0;}
	return 1;
}
