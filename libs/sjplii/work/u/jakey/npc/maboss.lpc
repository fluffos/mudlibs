inherit NPC;
 
void create()
{
        set_name("马老板", ({ "ma boss","ma","boss" }) );
        set("gender", "男性" );
        set("age", 30);
        set("long", "一个笑眯眯的中年人。\n");
        set("combat_exp", 1);
	set("attitude", "friendly");
	 set("inquiry", ([          
	    "陈护法":	"啊，你问陈护法呀，老相识了，前几天还在我这里喝了一回酒呢。\n",
	    "酒":	"酒？啊...你说的是前几天和陈护法喝的酒吧，那酒叫猴儿酒，很不容易弄到，非常珍贵的。\n",
	    "猴儿酒":	"这是我用来招待贵客用的，是不出售的，抱歉的很。\n",
         ]));

     
        setup();
        carry_object("/u/jakey/obj/baicloth1")->wear();
}

