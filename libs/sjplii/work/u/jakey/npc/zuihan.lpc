inherit NEW_VENDOR;

void create() {
  set_name("醉汉", ({ "zui han", "han", "zuihan", "zui" }));
  set("gender", "男性");
  set("age", 30);
  set("long", "一个农夫打扮的醉汉，嘴里含糊不清的不知说着什么。\n");
  set("combat_exp", 100);
  set("attitude", "friendly");
  set("inquiry", ([
    "吝啬鬼": "就是王家的那个老不死的吝啬鬼。\n",
    "王勤": "他这个老头儿，竟然不借我钱，真是气人。还是去和李员外借好了。\n",
  ]));
  set("chat_chance", 4);
  set("chat_msg", ({
    "醉汉恨道：“那个吝啬鬼，借钱都不多借！”\n", }));
  set_skill("unarmed", 5);
  set_skill("dodge", 5);
  set_skill("force", 5);

  setup();
  carry_object("/u/jakey/obj/cloth")->wear();
  add_money("silver", 10);
}
