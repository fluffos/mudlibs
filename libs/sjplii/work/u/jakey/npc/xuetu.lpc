inherit NPC;
 
void create()
{
        set_name("小学徒", ({ "xue tu","xue" }) );
        set("gender", "男性" );
        set("age", 12);
        set("long", "一个汗流浃背的小学徒。\n");
        set("combat_exp",2000 );
	set("attitude", "friendly");
        set_skill("unarmed",10);
        set_skill("dodge", 10);
        set_skill("force",10);        
        set("chat_chance", 2);
        set("chat_msg", ({
	"小学徒拿着个铁铲往火炉里添煤。\n"
	"小学徒用风箱给炉子鼓风。\n"
        }) );  
        setup();
        carry_object("/u/jakey/obj/cloth")->wear();
	carry_object("/u/jakey/obj/tiechan");
}

