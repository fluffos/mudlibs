inherit NPC;
 
void create()
{
        set_name("侍应生", ({ "waiter" }) );
	set("title", "落月山庄" );
        set("gender", "男性" );
        set("age", 20);
        set("long", "打扮很整齐的小伙子，手臂上搭了条毛巾，正准备随时为你服务。\n");
        set("combat_exp", 20000);
	set("attitude", "friendly");
        set_skill("unarmed",50);
        set_skill("dodge", 50);
        set_skill("parry",50);        
        setup();
        carry_object("/u/jakey/obj/jpzhifu")->wear();
}

