inherit NPC;

void create() {
  set_name("豪哥", ({ "hao ge", "hao" }));
  set("title", "落月山庄");
  set("gender", "男性");
  set("age", 24);
  set("long",
    "山庄的剑仆，曾得过庄主的亲自指点，功夫甚是不弱，你可不要小瞧。\n");
  set("combat_exp", 100000);
  set("attitude", "heroism");
  set_skill("unarmed", 100);
  set_skill("dodge", 100);
  set_skill("force", 100);
  set_skill("sword", 100);
  set_skill("parry", 100);
  set_skill("xuanyue-force", 100);
  set_skill("qingfeng-steps", 100);
  set_skill("luoyue-sword", 100);
  set_skill("luanyu-strike", 100);

  map_skill("sword", "luoyue-sword");
  map_skill("parry", "luoyue-sword");
  map_skill("force", "xuanyue-force");
  map_skill("dodge", "qingfeng-steps");
  map_skill("unarmed", "luanyu-strike");
  set("force", 2000);
  set("max_force", 2000);
  set("force_factor", 75);
  set("chat_chance", 1);
  set("chat_msg", ({
    "豪哥挠了挠头。\n",
    "豪哥着急的搓了搓手，深深的叹了一口气。\n",
  })); set("inquiry", ([
    "玉儿": "是个非常好的姑娘，我很喜欢他。\n",
    "心爱之物": "别提了，我真是太不小心了。唉！\n",
  ]));
  setup();
  carry_object("/u/jakey/obj/jpzhifu")->wear();
  carry_object("/u/jakey/obj/changjian")->wield();
}

void init() {
  add_action("do_list", "list");
  add_action("do_yao", "yao");
}

int accept_object(object me, object ob) {
  object room;
  room = find_object("/u/jakey/lunjian");
  if (!((string)ob->query("name") == "手帕" &&
    (string)ob->query("id") == "shou pa")) return 0;
  write("豪哥一把把手帕抓在手中。\n");
  command("say 你是从哪里找到的？那天不小心在后山丢了，
快要把我急死了。这真是太感谢你了。你能不能在这里替
我照看一会儿，我这就去告诉玉儿。希望她不会再生气了。");
  call_out("leave", 1, this_player());
  call_out("back", 60, this_player());
  return 1;
}

void leave() {
  remove_call_out("dest");
  say("豪哥往南离开。\n");
  //	destruct(this_object());
  this_object()->move("/u/jakey/temp");
  return;
}

void back() {
  this_object()->move("/u/jakey/lunjian");
  say("豪哥走了过来。\n");
  command("whisper " + (string)this_player()->query("id") + " 非常感谢你，玉儿已经不生气了。");
}

int do_list() {
  write("我这里有不少兵器，看看你需要什么？\n\n"
    "单刀(blade)\n"
    "长剑(changjian)\n"
    "铁锤(hammer)\n"
    "钢剑(gangjian)\n"
    "细剑(duanjian)\n\n");
  return 1;
}

int do_yao(string arg) {
  object ob;
  string obname, unit;
  if (!arg) return notify_fail("你想要什么兵器？\n");
  if (this_player()->query("class") != "luoyue") return notify_fail("豪哥说道：“你不是我们山庄的人吧？很抱歉，不能给你。\n");
  if ((int)this_player()->query_temp("yao") > 2) return notify_fail("豪哥很不高兴的看着你：“你怎么这么贪心？不会给你了。\n");
  switch (arg) {
    case "blade": ob = new("/u/jakey/sell/tiejiang/blade");
    break;
    case "changjian": ob = new("/u/jakey/sell/tiejiang/changjian");
    break;
    case "hammer": ob = new("/u/jakey/sell/tiejiang/hammer");
    break;
    case "gangjian": ob = new("/u/jakey/sell/tiejiang/steelsword");
    break;
    case "duanjian": ob = new("/u/jakey/sell/tiejiang/thinsword");
    break;
    default: return notify_fail("这里没有你要的兵器。\n");
  }
  ob->move(this_player());
  obname = (string)ob->query("name");
  unit = (string)ob->query("unit");
  message_vision("豪哥拿出一" + unit + obname + "给了$N\n\n", this_player());
  this_player()->add_temp("yao", 1);
  return 1;
}

int accept_fight(object ob) {
  object weapon;
  string skill_type;
  int ob_attack, ob_dodge, ob_parry;

  if (objectp(weapon = ob->query_temp("weapon")))
    skill_type = weapon->query("skill_type");
  else
    skill_type = "unarmed";

  ob_attack = ob->query_skill(skill_type, 0) + ob->query_temp("apply/attack");
  ob_dodge = ob->query_skill("dodge", 0) + ob->query_temp("apply/defense");
  ob_parry = ob->query_skill("parry", 0) + ob->query_temp("apply/defense");

  set("eff_kee", query("max_kee"));
  set("kee", query("max_kee"));
  set("max_force", ob->query("max_force"));
  set("force", ob->query("force"));
  set("combat_exp", ob->query("combat_exp") + 50);
  set_temp("apply/attack", ob_dodge + ob_dodge / 20 + 10);
  set_temp("apply/defense", ob_attack + ob_attack / 20 + 10);
  return 1;
}
