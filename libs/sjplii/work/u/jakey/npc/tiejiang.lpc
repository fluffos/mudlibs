inherit NEW_VENDOR;

void create()
{
	object ob;

	set_name("张铁匠", ({ "zhang tiejiang","zhang","tiejiang" }) );
	set("gender", "男性" );
	set("age", 44);
	set("long",
		"这位铁匠正在灶前忙着。\n");
	set("combat_exp", 15);
	set("attitude", "friendly");
	set("rank_info/respect", "铁匠");
        set("chat_chance",3);
        set("chat_msg",({
	"张铁匠擦了擦汗。\n",
	"张铁匠用力敲打着铁器。\n",
	"张铁匠把烧红的铁胚浸到水里，顿时冒起一阵白雾。\n"
	}));
	set("merchandise",([
		"/u/jakey/sell/tiejiang/blade"		:20,
		"/u/jakey/sell/tiejiang/changjian"	:20,
		"/u/jakey/sell/tiejiang/hammer"	:20,
		"/u/jakey/sell/tiejiang/shield"	:20,
		"/u/jakey/sell/tiejiang/steelsword"	:20,
		"/u/jakey/sell/tiejiang/thinsword"	:20,
		"/u/jakey/sell/tiejiang/stick"	:20,
		"/u/jakey/sell/tiejiang/whip"	:20,
	]));
	setup();
	ob = carry_object("/u/jakey/obj/cloth")->wear();
}

void init()
{       
        object ob;
        ::init();
	if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
        }
        add_action("do_vendor_list", "list");
        add_action("do_buy", "buy");

}

void greeting(object ob)
{
        if( !ob || !present(ob, environment(this_object())) ) return;
         say( "张铁匠道：这位" + RANK_D->query_respect(ob)
             + "，要不要买些东西装备自己呀？\n");
}

int accept_object(object me,object ob)
{
	if (!((string)ob->query("name")=="玄铁匕首" && 
	    (string)ob->query("id")=="black dagger")) 
		return notify_fail("张铁匠说道：“你给我东西干什么？”\n");
	write("张铁匠把匕首拿到手中看了看。\n");
	command("say 这把匕首不是我的手艺，到好象是本镇老铁匠老何的。
这样吧，我带你去老何家，你去问问他吧。");
	me->move("/u/jakey/minzhai2");
	return notify_fail("\n");
}
