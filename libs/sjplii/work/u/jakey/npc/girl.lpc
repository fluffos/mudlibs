inherit NEW_VENDOR;

void create()
{
 	 object ob;
	set_name("大姑娘", ({ "girl" }) );
	set("gender", "女性" );
	set("age", 17);
	set("long",
		"一个淳朴的农村姑娘。\n");
	set("combat_exp", 15);
	set("attitude", "friendly");
	set("merchandise",([
		"/u/jakey/sell/zahuo/bag"	:20,
		"/u/jakey/sell/zahuo/dagger"	:20,
		"/u/jakey/sell/zahuo/dust"	:20,
		"/u/jakey/sell/zahuo/rope"	:20,
	]));
	setup();

        ob = carry_object("/u/jakey/obj/bluegua")->wear();
}

void init()
{       
        object ob;
        ::init();
	if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
        }
        add_action("do_vendor_list", "list");
        add_action("do_buy", "buy");

}

void greeting(object ob)
{
        if( !ob || !present(ob, environment(this_object())) ) return;
         say( "大姑娘说道：欢迎光临，这位" + RANK_D->query_respect(ob)
             + "，您想买点什么？\n");
}


