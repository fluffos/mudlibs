inherit NPC;

void create()
{
        set_name("石人",({ "stone man","stone","man" }));
        set("gender", "男性" );
        set("long","一个面无表情的机关人，用石头做成。\n");
        set("age", 38);
        set("str", 62);
        set("cor", 30);
        set("cps", 20);
        set("con", 50);
        set("per", 27);
        set("int", 10);
        set("combat_exp",2000000);
        set("max_kee", 3000);
        set("kee", 3000); 
        set("food", 500);
        set("water", 500);
        set("attitude", "peaceful");
        set("max_force",3000);
        set("force",3000);
        set("force_factor",30);
        set_temp("apply/damage", 50);
        set_temp("apply/defense", 50);
        set("score",200);
        set("daode",100);	
        set_skill("unarmed",300);
        set_skill("dodge", 400);
        set_skill("force",300);
        set_skill("parry",400);
        setup();
}
int accept_fight(object ob)
{
	return 1;
}	
    