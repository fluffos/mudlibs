inherit NPC;
 
void create()
{
        set_name("李夫人", ({ "li furen","li" }) );
        set("gender", "女性" );
        set("age", 40);
        set("long", "一看就知道是一个养尊处优的妇人。\n");
        set("combat_exp",2000 );
	set("attitude", "friendly");
        set_skill("unarmed",20);
        set_skill("dodge", 20);
        set_skill("force",20);        
        setup();
        carry_object("/u/jakey/obj/changqun")->wear();
	carry_object("/u/jakey/obj/yufopai")->wear();
	add_money("silver",40);
}
