inherit NPC;
 
void create()
{
        set_name("阿福", ({ "afu" }) );
	set("title", "落月山庄" );
        set("gender", "男性" );
        set("age", 20);
        set("long", "一个好看的小伙子，逢人三分笑。\n");
        set("combat_exp", 30000);
	set("attitude", "heroism");
        set_skill("unarmed",60);
        set_skill("dodge", 60);
        set_skill("parry", 60);
        set_skill("force",60);        

        set("force", 600);
        set("max_force", 600);
	set("force_foctor",15);
        setup();
        carry_object("/u/jakey/obj/jpzhifu")->wear();
}

