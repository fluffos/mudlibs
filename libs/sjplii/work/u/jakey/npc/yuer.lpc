inherit NPC;

void create() {
  set_name("玉儿", ({ "yuer" }));
  set("title", "落月山庄");
  set("gender", "女性");
  set("age", 15);
  set("long", "一个机灵的小丫头，正甜甜的对着你笑。\n");
  set("combat_exp", 3000);
  set("attitude", "friendly");
  set_skill("unarmed", 30);
  set_skill("dodge", 30);
  set_skill("parry", 30);
  set("chat_chance", 3);
  set("chat_msg", ({
    "玉儿垂着头想着什么心事。\n",
    "玉儿呆呆的出神。\n",
    "玉儿给小姐擦了擦汗。\n",
  }));
  set("inquiry", ([
    "豪哥": "你说豪哥呀，他是个很不错的人。\n",
    "心事": "没...没有。我没有什么心事。\n",
    "心爱之物": "唉，他...他...居然...唉！\n",
  ]));
  setup();
  carry_object("/u/jakey/obj/baiqun")->wear();
}

int accept_object(object me, object ob) {
  if (!((string)ob->query("name") == "手帕" &&
    (string)ob->query("id") == "shou pa")) return 0;
  write("玉儿接过手帕一看。\n");
  command("ah");
  command("say 这...这块手帕我不是给了...，怎么会在你手里？");
  return 1;
}
