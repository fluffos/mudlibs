inherit NPC;

void create()
{
        set_name("洛护法", ({"luo hufa","luo","hufa"}) );
	set("nickname","恶头陀");
        set("gender","男性");
        set("age",45);
        set("attitude","heroism");
        set("str",27);
        set("cor",24);
        set("cps",21);
        set("con",27);
        set("force",3000);
        set("max_force",3000);
        set("force_factor",70);
        set("long",
	"洛护法是落月山庄四大护法中武功最高的一个，佛学的造诣已是不浅\n"
	"，但还是改不了脾气暴躁的毛病。人们在背后都管他叫“恶头陀”。\n"
	"但是洛护法为人正直，赏罚分明，故被庄主委以律院护法的重任。\n");
        
        set("combat_exp", 400000);

	set_skill("dodge",160);
        set_skill("parry",160);
        set_skill("unarmed",160);
        set_skill("force",160);        
        set_skill("staff",160);        
        set_skill("buddhism",120);        
        set_skill("magic",120);        
        set_skill("qingfeng-steps",160);
        set_skill("luanyu-strike",160);
        set_skill("xuanyue-force",160);

        map_skill("staff","lunhui-zhang");   
        map_skill("unarmed","luanyu-strike");
        map_skill("force","xuanyue-force");
        map_skill("parry","lunhui-zhang");
        map_skill("dodge","qingfeng-steps");

        set("chat_chance",1);
        set("chat_msg",({
	"洛护法骂道：死牛鼻子，算你狠，下回看我不把你打的屁滚尿流的。\n",
	"洛护法恨恨道：“这个死牛鼻子，怎么一下子就变的那么厉害？”\n",
	}));
        set("inquiry",([
	"一招妙棋 ": "那一招可是精妙的很呀。真不知道是从哪里学来的。\n",
        "死牛鼻子" : "还能有谁，就是丹房里的那个老道。原来他一直是我的手下败将，那天\n"
                     "不知从哪里学来一招妙棋，竟然把我给杀败了。真是气死我了。\n",
	]));
        setup();  
	carry_object("/u/jakey/obj/goldzhang")->wield();
	carry_object("/u/jakey/obj/sengpao")->wear();
}

int accept_object(object me,object ob)
{
	if (!((string)ob->query("name")=="残破棋谱" && 
	    (string)ob->query("id")=="canpo qipu")) return 0;
	command("haha");
	command("say 这可真是太好了，牛鼻子，看我不把你杀的落花流水。");
	me->set_temp("hufa3/xue",1);
	return 1;
}

int recognize_apprentice(object ob)
{
	if( ob->query_temp("hufa3/xue") ) return 1;
	return 0;
}
