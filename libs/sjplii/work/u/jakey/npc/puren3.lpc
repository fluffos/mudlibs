inherit NPC;
 
void create()
{
        set_name("仆人", ({ "pu ren","pu"}) );
	set("title", "李家" );
        set("gender", "男性" );
        set("age", 30);
        set("long", "一个无精打采的壮年人。\n");
        set("combat_exp", 2000);
	set("attitude", "friendly");
        set_skill("unarmed",10);
        set_skill("dodge", 10);
        set_skill("force",10);        
        setup();
        carry_object("/u/jakey/obj/purenfu")->wear();
}

