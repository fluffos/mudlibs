inherit NPC;
 
void create()
{
        set_name("老仆", ({ "laopu" }) );

        set("gender", "男性" );
        set("age", 50);

        set("long", "一个颤颤巍巍的老仆人，正在拿把扫把扫地。\n");
        set("combat_exp", 1000);
	set("attitude", "friendly");
        setup();
        carry_object("/u/jakey/obj/saoba")->wield();
        carry_object("/u/jakey/obj/cloth")->wear();

}

