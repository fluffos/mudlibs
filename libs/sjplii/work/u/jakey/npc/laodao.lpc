inherit NPC;

void create() {
  set_name("老道", ({ "lao dao", "lao" }));
  set("title", "落月山庄");
  set("gender", "男性");
  set("age", 65);
  set("long", "一个花白胡子的清瘦老道士。\n");
  set("combat_exp", 40000);
  set("attitude", "heroism");
  set("chat_chance", 2);
  set("chat_msg", ({
    "老道在房间里踱来踱去，一副烦躁不安的样子。",
  }));
  set_skill("unarmed", 60);
  set_skill("spells", 60);
  set_skill("dodge", 60);
  set_skill("parry", 60);
  set("inquiry", ([
    "配药": "夫人让我来配药，可是找来找去还差一味主药。\n",
    "药": "夫人让我来配药，可是找来找去还差一味主药。\n",
    "主药": "主药是一只赤红色的蟾蜍，对小姐的病情大有好处，就是对一般人\n"
    "服用也是十分有益的，可惜此物很难得到。唉，去哪里找呢？\n",
    "一招妙棋": "呵呵，那天从好友那里见到一本残破棋谱，记了一招，\n"
    "想不到就把那个秃驴打的落花流水的。要是能借来看看就好了。\n",
  ]));
  setup();
  carry_object("/u/jakey/obj/daopao")->wear();
  carry_object("/u/jakey/obj/fuchen")->wield();
}


int accept_object(object me, object ob) {
  object book, pill, frog;
  me = this_player();
  if ((string)ob->query("name") == "残破棋谱" &&
    (string)ob->query("id") == "canpo qipu") {
    command("say 哈哈，就是这本棋谱，你居然能借到？！平白无
故让你帮忙真是过意不去。这样好了，我这里有一本书，是
我多年研习咒术的心得，就送给你吧。");
    write("老道从怀里拿出一本书给了你。\n");
    book = new("/u/jakey/special/spellbook");
    book->move(this_player());
    add("givedbook", 1);
    return 1;
  }

  if ((string)ob->query("name") == "红蟾蜍的尸体" &&
    (string)ob->query("id") == "corpse") {
    if (query("havedpill"))
      return notify_fail("老道笑道：“药我已经配好送过去了。”\n");
    command("say 对，对，就是它。你是从哪里找到的？这下太好了
，我马上就配药。");
    write("你等了一会，老道把一个药丸交给了你。\n");
    pill = new("/u/jakey/special/goldpill");
    pill->move(this_player());
    add("havedpill", 1);
    command("say 你去把这个药交给夫人吧。");
    return 1;
  }
  return 0;
}
