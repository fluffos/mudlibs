inherit NPC;

void create() {
  set_name("燕护法", ({ "yan hufa", "yan", "hufa" }));
  set("nickname", "玉面书生");
  set("gender", "男性");
  set("age", 27);
  set("attitude", "heroism");
  set("str", 19);
  set("cor", 22);
  set("cps", 22);
  set("con", 27);
  set("force", 2000);
  set("max_force", 2000);
  set("force_factor", 40);

  set("long",
    "    燕北天是山庄最年轻的护法，五年前来到山庄，因为功夫\n"
    "不错，办事稳当，很快就升为护法。其人待人热忱，乐与助人\n"
    "，在山庄里上上下下的关系都很好。\n"
  );

  set("combat_exp", 200000);

  set_skill("sword", 120);
  set_skill("force", 120);
  set_skill("dodge", 120);
  set_skill("parry", 120);
  set_skill("unarmed", 120);
  set_skill("taiji-force", 100);
  set_skill("taiji-ken", 120);
  set_skill("taiji-sword", 150);
  set_skill("tiyunzong", 120);

  map_skill("unarmed", "taiji-ken");
  map_skill("sword", "taiji-sword");
  map_skill("parry", "taiji-sword");
  map_skill("dodge", "tiyunzong");
  map_skill("force", "taiji-force");

  set("chat_chance", 3);
  set("chat_msg", ({
    "燕护法吟道：莫听穿林打叶声。。何防吟啸且徐行。。。。\n",
    "燕护法默默念道：暗。。。棋。。。圣。。手。。。\n",
  }));
  set("inquiry", ([
    "暗棋圣手": "不能说。。。。不能说。。。。\n",
  ]));

  setup();
  carry_object("/u/jakey/obj/baicloth1")->wear();
  carry_object("/u/jakey/obj/changjian")->wield();
}
