inherit ROOM;

void create() {
  set("short", "小巷");
  set("long", @LONG
这里是一片居民区，落月山庄把这里全部买下来作为自己庄
内人员的居住地。来来往往的都是一些武林中人。没事的人是不
会到这里找麻烦的。
LONG
  );
  set("exits", ([ /* sizeof() == 2 */
    "east": __DIR__ "cross",
    "west": __DIR__ "xx2",
  ]));
  set("no_clean_up", 0);
  set("outdoors", "jakey");
  setup();
}

void init() {
  add_action("do_back", "back");
}

int do_back(string arg) {
  if (arg == "home") {
    this_player()->move("/u/jakey/home/xiaowo1");
    return 1;
  } else return 0;
}
