inherit ROOM;

void create() {
  set("short", "棋斋");
  set("long", @LONG
这里是陈逸飞与好友对弈的棋斋，陈逸飞晚年好棋，常在此
与棋友对弈。这里放着一张桌子和几个凳子，旁边有一矮桌，
上有壶、杯之类的器具。
LONG
  );
  set("item_desc", ([
    "桌子": "一张黑黝黝的桌子，你摸了摸，触手冰凉，竟是一张铁桌，\n"
    "不知道能不能推动。\n",
    "桌脚": "你蹲下去仔细观察桌脚，发现桌子的四脚都是固定在地上的，\n"
    "难怪你推不动呢。\n",
  ]));

  set("exits", ([ /* sizeof() == 1 */
    "east": __DIR__ "xyuan2",
  ]));
  set("no_clean_up", 0);

  setup();
}

void init() {
  add_action("do_push", "push");
  add_action("do_an", "an");
}

int do_push(string arg) {
  if (!arg || arg == "") return 0;
  if (arg == "桌子") {
    write("你用手抵住桌子的边缘，运足力气推了推，桌子的四个脚\n"
      "象在地上生了跟似的，纹丝不动，看来你的力气不够。\n");
    return 1;
  } else return 0;
}

int do_an(string arg) {
  if (arg != "桌子") return 0;
  write("你将手平放在桌子上，运足力气下按，桌子向下微微一沉，\n");
  if (this_player()->query("max_force") < 1000) return notify_fail("什么事情也没有发生。\n");
  tell_room(__FILE__, "只听“咔嚓”一声，地板上的青石移开了一块，露出了一条向下的通道。\n");
  tell_room("/u/jakey/chen/midaorukou", "头顶的青石缓缓的移开了一块，露出了一条向上的通道。\n");
  add("exits/northdown", "/u/jakey/chen/midaorukou");
  "/u/jakey/chen/midaorukou"->add("exits/southup", __FILE__);
  call_out("close_passage", 5);
  return 1;
}

void close_passage() {
  object room;

  delete("exits/northdown");
  tell_room(__FILE__, "移开的青石又动了起来，缓缓的将入口挡住了。\n");
  tell_room("/u/jakey/chen/midaorukou", "青石又缓缓的移动起来，将头顶的通道挡住了。\n");
  if (room = find_object("/u/jakey/chen/midaorukou")) { room->delete("exits/southup"); }
}
