#include <armor.h>

inherit WAIST;

void create()
{
	set_name("香囊", ({ "xiang nang","xiang" }) );
	set_weight(30);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long",
			"这是苏杭人身上常佩的饰服，可驱除体味。\n" );
		set("unit", "件");
		set("value", 50);
		set("material", "cloth");
		set("armor_prop/armor", 1);
		set("armor_prop/armor_vs_force", 2);
		set("armor_prop/attack", -5);
                set("wear_msg","$N把$n系在腰间。\n");
	}
	setup();
}
