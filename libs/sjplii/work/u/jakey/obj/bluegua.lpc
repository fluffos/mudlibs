#include <armor.h>

inherit CLOTH;

void create()
{
	set_name("兰布小褂", ({ "blue gua","gua" }) );
	set_weight(200);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long",
			"一件兰底白碎花的小褂。\n");
		set("unit", "件");
		set("value", 200);
		set("material", "cloth");
		set("armor_prop/armor", 3);
	}
	setup();
}
