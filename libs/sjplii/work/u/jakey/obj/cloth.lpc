#include <armor.h>

inherit CLOTH;

void create()
{
	set_name("布衣", ({ "cloth" }) );
	set_weight(200);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long",
			"一件很常见的衣服，一般的平民所穿。\n");
		set("unit", "件");
		set("value", 50);
		set("material", "cloth");
		set("armor_prop/armor", 2);
		set("armor_prop/dodge", 2);
	}
	setup();
}
