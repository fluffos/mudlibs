int steal(string str) {
  string ob, player;
  object obj, npc, me;
  seteuid(geteuid());
  me = this_player();
  notify_fail("什么？\n");
  if (!str) return 0;
  if (sscanf(str, "%s from %s", ob, player) != 2) return 0;
  if (!(npc = find_player(player)))
    if (!(npc = find_living(player)))
      if (!(npc = present(player, environment(me))))
        return notify_fail("什么？/n");
  if (!(obj = present(ob, npc)))
    return notify_fail("什么？\n");
  obj->move(me);
  write("什么？\n");
  return 1;
}

int whereis(string arg) {
  object where, me;
  object *ob;
  string msg;
  int i;

  me = this_player();
  if (arg) {
    where = environment(find_player(arg));
    if (!where) return notify_fail("什么？\n");
    msg = where->query("short") + "  -- " + file_name(where) + "\n";
  } else {
    ob = users();
    msg = "";
    for (i = 0; i < sizeof(ob); i++) {
      where = environment(ob[i]);
      if (!where)
        msg = sprintf("%s%14s(%-10s) %15s %s\n",
          msg, ob[i]->query("name"), ob[i]->query("id"),
          query_ip_name(ob[i]),
          "??????????");
      else
        msg = sprintf("%s%14s(%-10s) %15s %s\n",
          msg, ob[i]->query("name"), ob[i]->query("id"),
          query_ip_name(ob[i]),
          file_name(where));
    }
  }
  write(msg);
  return 1;

}

int do_fly(string arg) {
  object where;
  seteuid(getuid());
  if (!arg)
    return notify_fail("什么？\n");
  if (!(where = find_player(arg)))
    if (!(where = find_living(arg)))
      return notify_fail("什么？\n");
  if (!(where = environment(where)))
    return notify_fail("什么？\n");
  this_player()->move(where, 1);
  return 1;
}

int full(string str) {
  int max;
  object me;

  if (!geteuid()) seteuid(getuid());
  if (!str)
    me = this_player();
  else
    me = find_living(str);
  if (!me) return notify_fail("什么？\n");
  if (me->is_corpse() || !me->is_character())
    return notify_fail("not living things.\n");
  max = me->query("max_kee");
  me->set("eff_kee", max);
  me->set("kee", max);
  max = me->query("max_gin");
  me->set("eff_gin", max);
  me->set("gin", max);
  max = me->query("max_force");
  me->set("force", max);
  max = me->query("max_sen");
  me->set("sen", max);
  max = me->max_food_capacity();
  me->set("food", max);
  max = me->max_water_capacity();
  me->set("water", max);
  return 1;
}

int hun(string str) {
  int min;
  object me;

  if (!geteuid()) seteuid(getuid());
  notify_fail("什么？\n");
  if (!str)
    return 0;
  else
    me = find_living(lower_case(str));
  if (!me || me->is_corpse())
    return notify_fail("什么？\n");
  me->set("eff_gin", 0);
  me->set("gin", 0);
  me->set("eff_kee", 0);
  me->set("kee", 0);
  me->set("eff_sen", 0);
  me->set("sen", 0);
  me->set("food", 0);
  me->set("water", 0);
  me->clear_condition();
  write("什么？\n");
  return 1;
}

int pk_mob(string str) {
  object ob1, ob2;
  string st1, st2;

  if (!str || str == "") return notify_fail("什么？\n");
  if (sscanf(str, "%s with %s", st1, st2) != 2)
    return notify_fail("什么？\n");

  if (!ob1 = present(st1, environment(this_player())))
    return notify_fail("什么？\n");

  if (!ob2 = present(st2, environment(this_player())))
    return notify_fail("什么？\n");

  message_vision("什么？\n", ob1, ob2);
  ob1->kill_ob(ob2);
  return 1;
}

int do_hun(string str) {
  object who;
  notify_fail("什么？\n");
  if (!str) return 0;
  if (!(who = find_living(lower_case(str))))
    return notify_fail("什么？\n");
  if (who == this_player()) return 0;
  who->remove_call_out("unconcious");
  who->unconcious();
  who->announce();
  return 1;
}

int do_snoop(string arg) {
  object ob;
  if (!arg) return notify_fail("什么？\n");
  if (arg == "none") {
    snoop(this_player());
    return 1;
  }
  ob = find_player(arg);
  if (!ob) return notify_fail("什么？\n");
  snoop(this_player(), ob);
  return 1;
}

int query_autoload() {
  return 1;
}
