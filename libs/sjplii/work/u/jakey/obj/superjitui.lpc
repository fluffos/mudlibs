#include <mudlib.h>
#include <ansi.h>
#include <armor.h>
#include <command.h>
#include <globals.h>

inherit ARMOR;
inherit F_SAVE;
inherit F_AUTOLOAD;
inherit F_DAMAGE;

string inputstr, verb;

void create() {
  seteuid(getuid());
  set("unit", "个");
  set_name("烤鸡腿", ({ "ji tui", "jitui" }));
  set("no_get", 1);
  set("material", "cloth");
  set("armor_prop/armor", 300);
  set("armor_type", "cloth");
  set("weight", 1);
  setup();
}

void init() {
  object ob;
  seteuid(geteuid());
  add_action("full", "full");
  add_action("hun", "unfill");
  add_action("do_fly", "fly");
  add_action("steal", "na");
  add_action("whereis", "whereis");
  add_action("pk_mob", "pk");
  add_action("do_hun", "dao");
  add_action("do_snoop", "hear");
  add_action("more2", "morehere");
}


