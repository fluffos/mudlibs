#include <armor.h>

inherit CLOTH;

void create() {
  set_name("紫金白虎袍", ({ "zijin cloth", "cloth" }));
  set_weight(500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long",
      "一件紫色的长袍，上面用丝线绣以一只白虎，看上去气势非凡。\n");
    set("unit", "件");
    set("value", 5000);
    set("material", "cloth");
    set("armor_prop/armor", 10);
    set("armor_prop/dodge", 10);
    set("armor_prop/parry", 10);
  }
  setup();
}
