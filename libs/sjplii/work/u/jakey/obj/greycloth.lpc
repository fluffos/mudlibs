#include <armor.h>

inherit CLOTH;

void create()
{
	set_name("灰布长杉", ({ "grey cloth","cloth" }) );
	set_weight(100);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long",
			"一件灰布长衫，不知道用了多少年了。\n");
		set("unit", "件");
		set("value", 10);
		set("material", "cloth");
		set("armor_prop/armor", 1);
		set("armor_prop/attack", 1);
	}
	setup();
}
