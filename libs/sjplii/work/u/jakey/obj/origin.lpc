#include <armor.h>

inherit CLOTH;

void create()
{
	set_name("", ({ "" }) );
	set_weight();
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long",
			""
			""
			"");
		set("unit", "件");
		set("value", 14000);
		set("material", "cloth");
		set("armor_prop/armor", 30);
		set("armor_prop/armor_vs_force", 70);
		set("armor_prop/attack", -5);
	}
	setup();
}
