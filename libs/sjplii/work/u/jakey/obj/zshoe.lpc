#include <armor.h>

inherit BOOTS;

void create() {
  set_name("皂靴", ({ "zshoe" }));
  set_weight(400);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long",
      "这是一般有身份的人穿的靴子。\n");
    set("unit", "双");
    set("value", 1400);
    set("material", "cloth");
    set("armor_prop/armor", 1);
    set("armor_prop/dodge", 2);
    set("wear_msg", "$N穿上一双$n。\n");
  }
  setup();
}
