// goldzhang.c

#include <weapon.h>

inherit STAFF;

void create()
{
    set_name("黄金杖", ({ "gold staff", "staff" }) );
	set_weight(2000 );
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "把");
		set("value", 53000);
		set("material", "steel");
        set("long", "这是一把黄澄澄的纯金打造的黄金杖，是洛护法的成名兵器。\n");
        set("wield_msg", "$N拿出一把黄澄澄的$n，握在手中。\n");
		set("unequip_msg", "$N放下手中的$n。\n");
	}
    init_staff(35);
	setup();
}
