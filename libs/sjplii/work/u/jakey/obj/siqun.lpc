#include <armor.h>

inherit CLOTH;

void create()
{
	set_name("丝裙", ({ "siqun" }) );
	set_weight(100);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long",
			"一件丝织的淡绿色的裙子，年轻的女孩子都爱穿。\n");
		set("unit", "件");
		set("value", 200);
		set("material", "cloth");
		set("armor_prop/armor", 2);
	}
	setup();
}
