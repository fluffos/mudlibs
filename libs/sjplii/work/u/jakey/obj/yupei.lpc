#include <armor.h>

inherit WAIST;

void create()
{
	set_name("玉佩", ({ "yupei" }) );
	set_weight(20);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long",
			"这是一件名贵的玉佩，触手微凉，上面雕刻着一只白鹤。\n");
		set("unit", "只");
		set("value", 10000);
		set("material", "silver");
		set("armor_prop/armor", 2);		 
		set("armor_prop/dodge", 2);
                set("wear_msg","$N佩带上一只$n。\n);
	}
	setup();
}
