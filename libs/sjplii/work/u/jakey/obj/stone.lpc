#include <armor.h>

inherit NECK;
inherit F_AUTOLOAD;

int query_autoload()
{
        return 1;
}
void create()
{
	set_name("紫石", ({ "stone" }) );
	set_weight(200);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long",
			"一块心状的石头，带有淡淡的紫色。\n");
		set("unit", "件");
                set("no_drop",1);
		set("autosave",1);
		set("value", 2000);
		set("material", "cloth");
		set("armor_prop/dodge", 7);

	}
	setup();
}
