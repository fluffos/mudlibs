#include <armor.h>

inherit HEAD;

void create()
{
	set_name("黄金冠", ({ "gold guan","guan" }) );
	set_weight(500);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long",
			"这是一顶纯金打造而成的黄金冠帽。\n");
		set("unit", "顶");
		set("value", 54000);
		set("material", "gold");
		set("armor_prop/armor", 30);
		set("armor_prop/armor_vs_force", 20);
		set("armor_prop/attack", 10);
                set("wear_msg","$N把$n戴在头上。\n");
	}
	setup();
}
