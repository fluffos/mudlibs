#include <armor.h>

inherit ITEM;

void create() {
  set_name("旱烟袋", ({ "yandai" }));
  set_weight(500);
  set("long",
    "翠玉的烟嘴，黄铜皮包着的烟管，是个很好看的烟斗。\n");
  set("unit", "件");
  set("value", 1000);
  set("material", "steel");
}

void init() {
  add_action("do_smoke", "smoke");
}

int do_smoke(string arg) {
  object me = this_player(), yandai;
  yandai = present("yandai", me);
  if (!yandai) return notify_fail("你身上没有旱烟袋。\n");
  me->receive_heal("sen", 20);
  message_vision("$N从怀里摸出个$n美美的抽了几口，一脸的陶醉。\n", me, yandai);
  return 1;
}
