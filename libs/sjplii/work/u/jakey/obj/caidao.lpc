// blade.c

#include <weapon.h>

inherit BLADE;

void create()
{
	set_name("剔骨尖刀", ({ "blade" }) );
	set_weight(4000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "柄");
		set("value", 500);
		set("material", "iron");
		set("long", "这是郑屠户常用的剔骨尖刀，用来熟练之极。\n");
		set("wield_msg", "$N抽出一把明晃晃的$n握在手中。\n");
		set("unequip_msg", "$N将手中的$n插入腰间。\n");
	}
	init_blade(15);
	setup();
}
