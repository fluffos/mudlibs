inherit ROOM;

void create() {
  set("short", "窗外");
  set("long", @LONG
这里是古塔的第四层的窗外，你踏着青色的瓦，靠着青色的
塔砖，看着青色的松林，心中一阵心旷神怡。上面是蓝蓝的天，
五层的青瓦在天色之下显得格外的古朴。
LONG
  );
  set("exits", ([ /* sizeof() == x */
    "down": __DIR__ "tower5",
  ]));
  set("no_clean_up", 0);
  set("outdoors", "jakey");
  setup();
}

void init() {
  add_action("do_jump", "jump");
}

int do_jump(string arg) {
  if (arg != "up") return 0;
  if (this_player()->query_skill("dodge") < 70) {
    message_vision("$N蹦了几蹦，眼看是够不着第五层的瓦檐。\n", this_player());
    return 1;
  }
  message_vision("$N抬头看了看头上的青瓦，纵身一跃，双手搭住瓦檐，将身子提了上去。\n", this_player());
  this_player()->move(__DIR__ "tower7");
  return 1;
}
