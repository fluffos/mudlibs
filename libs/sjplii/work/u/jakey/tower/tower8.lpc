inherit ROOM;

void create()
{
	set("short", "塔内五层");
	set("long", @LONG
这里已经是这座古塔的顶层了，在这里悬挂着一个木匾，上
面刻着三个篆体大字“摘星塔”，字体强劲，不知为何人所书。
在这里有着简单的摆设，一张木床，几个蒲团。一个须发皆白的
老人正在这里看书。
LONG
	);
	set("exits", ([ /* sizeof() == x */
	]));
	set("objects",([
	"/u/jakey/npc/oldman" : 1,
	]));
	set("no_clean_up", 0);       
	setup();
}

void init()
{
	add_action("do_climb","climb");
}

int do_climb(string arg)
{
	if (arg=="石窗") {
		message_vision("$N推开石窗，身子一矮，从石窗里钻了出去。\n",this_player());
		this_player()->move(__DIR__"tower7");
		return 1;}
	else return 0;
}
