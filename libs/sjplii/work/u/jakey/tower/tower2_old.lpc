// /u/jakey/tower/tower2.c
inherit ROOM;

void create()
{
        set("short", "古塔一层");
        set("long", @LONG
这里已经蒙上了一层灰尘了。这里供奉着一尊观音。由于年
久失修，几个蜘蛛在像上结了很多网，像前的蒲团上也蒙了一层
浮灰。很奇怪，为什么这里没有人打扫呢？在靠墙的地方有一个
木头楼梯，可以到达塔的二层。楼梯破旧不堪，有一层厚厚的尘
土。
LONG
        );
        set("exits", ([ /* sizeof() == 2 */
        "up" : __DIR__"tower3",
 //       "out" : __DIR__"tower1",
        ]));
        set("item_desc", ([ /* sizeof() == 5 */
        "观音" : "你看了看这个观音，虽然上面落满了灰尘，但仍然掩盖不住那慈祥静谧的神色。\n",
        ]));


        set("no_clean_up", 0);       
        setup();
}

void init()
{
        add_action("do_search","search");
        add_action("do_move","move");
        add_action("do_open","open");
        add_action("do_close","close");
}

int do_search (string arg)
{
        object ob;
        if (arg=="观音") {
                if ((int)query("moved")>0) {
                write("你仔细观察观音像，发现像后有一个小洞。\n");
                return 1;}
                else {write("你仔细观察观音像，没有发现任何异状。\n");
                return 1;}}
        if (arg=="小洞") {
                if ((int)query("moved")>0) {
                write("你把手伸入洞中，掏出了一个东西，纳入怀中。\n");
                ob=new("/u/jakey/special/peafowl");
                ob->move(this_player());
                return 1;}
                else return 0;}
        return 0;
}

int do_move(string arg)
{
        if (arg=="蒲团") {
                message_vision("$N把地上的蒲团移动了一下，不知从什么地方传来“咔”的一声轻响。\n",this_player());
                add("moved",1);
                return 1;}
        else return 0;
}

int do_open(string arg)
{
        object room;
        room=find_object("/u/jakey/tower/tower1");
        if (arg!="door") return 0;
        if((int)room->query("haveopenlocked")==0) return notify_fail("门是锁着的，你打不开。\n");
        if((int)room->query("haveopendoored")>0) return notify_fail("门已经打开的，还不赶快出去？\n");
        message_vision("$N伸手把门推开。\n",this_player());
        __DIR__"tower1"->add("exits/enter",__DIR__"tower2");
        __DIR__"tower2"->add("exits/out",__DIR__"tower1");
        tell_room(__DIR__"tower1","古塔的门被人打开了。\n");
        room->set("haveopendoored",1);
        return 1;
}

int do_close(string arg)
{
        object room;
        room=find_object("/u/jakey/tower/tower1");
        if (arg!="door") return 0;
        if((int)room->query("haveopendoored")==0) return notify_fail("门是关着的。\n");
        message_vision("$N把门关上了。\n",this_player());
        __DIR__"tower1"->delete("exits/enter",__DIR__"tower2");
        __DIR__"tower2"->delete("exits/out",__DIR__"tower1");
        tell_room(__DIR__"tower1","古塔的门被人关上了。\n");
        room->set("haveopendoored",0);
        return 1;
}
