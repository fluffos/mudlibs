inherit ROOM;

void create()
{
	set("short", "后山小路");
	set("long", @LONG
这是一条黄土小路，弯弯曲曲的在树林中延伸着。树叶被山
风吹得哗哗直响。有时山风卷起几片落叶在你面前打个滚，迅速
的躲进草丛里。西边就是悬崖了。
LONG
	);
	set("exits", ([ /* sizeof() == 2 */
	"east" : __DIR__"hspath3",
	"west" : __DIR__"xuanya",
	]));
	set("no_clean_up", 0);
        set("outdoors", "jakey");
	setup();
}

void init()
{
	add_action("do_search","search");
}

int do_search(string arg)
{
	object ob,me;
	me=this_player();
	if (arg!="草丛") return 0;
	else { 	if ((int)query("searched")>0) {write("你把手伸进草丛里找了半天，什么也没有发现。\n");return 1;}
		else {	message_vision("$N从草丛里拿出了个东西，收了起来。\n",me);
			ob=new("/u/jakey/special/shoupa");
			ob->move(me);
			add("searched",1);
			return 1;}}
}

int valid_leave(object me,string dir)
{
	if (dir=="west") me->set_temp("steps",0);
	return 1;
}
