inherit ITEM;

void create()
{
	set_name("剑法入门", ({ "sword book", "book" }));
	set_weight(50);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "本");
		set("long", "这是一本学习剑法的入门书籍。\n");
		set("value", 200);
		set("material", "paper");
		set("skill", ([
			"name":	"sword",	
			"exp_required":	0,	
			"sen_cost":	10,	
			"difficulty":	10,	
			"max_skill":	20	
		]) );
	}
}
