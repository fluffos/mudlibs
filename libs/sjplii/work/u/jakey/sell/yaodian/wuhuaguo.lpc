inherit COMBINED_ITEM;

void create()
{
	set_name("无花果", ({"wuhua guo","wuhua"}));
	set("long",	"一枚紫色的无花果。\n");
	set("unit", "枚");
	set("base_unit", "枚");
	set("value",300);
	set("base_weight", 300);
	set_amount(1);
}

void init()
{
	if( this_player()==environment() )
		add_action("do_eat", "eat");
}

int do_eat(string arg)
{
	if( !arg || arg != "wuhua")  return notify_fail("你要吃甚么呢? \n");

	message_vision(
	   "$N拿出一枚无花果，一口给吞了下去。\n",this_player()  );
	this_player()->receive_heal("sen", 80);
	add_amount(-1);
	return 1;
}
