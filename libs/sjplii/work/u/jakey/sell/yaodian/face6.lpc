// face off.c

#include <armor.h>

inherit HEAD;
	
void create()
{	
	set_name("官兵面具", ({ "guan face", "face" }) );
	set_weight(3000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "件");
		set("long",	"一张用人皮制作的官兵面具。\n");
		set("material", "cloth");
		set("armor_prop/armor", 3);
		set("armor_prop/id", ({"guan"}) );
		set("armor_prop/name", ({"守城官兵"}) );
		set("armor_prop/short", ({"守城官兵(Guan bing)"}) );
		set("armor_prop/long", ({
			"这是个正在执行公务的守城官兵，整天在城门口站岗，没事就不要招惹他们。\n"
		}) );
	}
	setup();
}
