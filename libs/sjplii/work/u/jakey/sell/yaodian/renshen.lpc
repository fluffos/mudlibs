inherit COMBINED_ITEM;

void create()
{
	set_name("老人参", ({"renshen"}));
	set("long",	"一棵老人参。\n");
	set("unit", "棵");
	set("value",300);
	set("base_unit", "棵");
	set("base_weight", 200);
	set_amount(1);
}

void init()
{
	if( this_player()==environment() )
		add_action("do_eat", "eat");
}

int do_eat(string arg)
{
	if( !arg || arg != "renshen")  return notify_fail("你要吃甚么呢? \n");

	message_vision(
	   "$N拿出一棵老人参，几口吃了下去。\n"
	   "$N吃下了一棵老人参，脸色红润了。\n",this_player()  );	
	this_player()->receive_heal("kee", 200);

	add_amount(-1);
	return 1;
}
