inherit ITEM;
inherit F_LIQUID;

void create()
{
        set_name("水壶", ({ "shui hu","shui" }));
        set_weight(1000);
        if( clonep() )
            set_default_object(__FILE__);
        else {
        set("long",
		"满满一壶清水。\n");
                set("unit", "壶");
                set("value", 100);
                set("max_liquid", 10);
        }
        set("liquid", ([
        	"name" : "清水",
        	"remaining" : 10,
        	"type" : "water"
        ]) );
        setup();
}

