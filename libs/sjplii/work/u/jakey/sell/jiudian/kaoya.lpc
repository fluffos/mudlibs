// kaoya.c

inherit ITEM;
inherit F_FOOD;

void create()
{
	set_name("北京烤鸭", ({ "kaoya","ya","kao ya" }) );
	set_weight(150);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "半只香喷喷、烤得金黄色的烤鸭子。\n");
		set("unit", "只");
		set("value", 300);
		set("food_remaining", 6);
		set("food_supply", 60);
	}
}
