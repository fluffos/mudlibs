inherit ITEM;
inherit F_LIQUID;

void create()
{
        set_name("酒壶", ({ "jiu hu","jiu" }));
        set_weight(1000);
        if( clonep() )
            set_default_object(__FILE__);
        else {
        set("long",
		"一个装满烈性白酒的酒壶。\n");
                set("unit", "个");
                set("value", 200);
                set("max_liquid", 7);
        }
        set("liquid", ([
        	"name" : "白酒",
        	"remaining" : 7,
        	"type" : "alcohol",
		"drunk_apply":8,
        ]) );
        setup();
}

