inherit ROOM;

void create()
{
	set("short", "青石台阶");
	set("long", @LONG
这是一条通向山上的青石台阶，可能有人经常打扫，台阶很
干净。山顶就是落月山庄了。山坡并不是很陡，两边种了很多松
树。这里有一块大石头，很奇怪的立在台阶旁边。
LONG
	);
	set("exits", ([ /* sizeof() == 2 */
	"northup" : __DIR__"qstj3",
	"southdown" : __DIR__"qstj1",
	]));
	set("objects",([
	__DIR__"npc/puren1" : 1,
	]));
	set("no_clean_up", 0);
        set("outdoors", "jakey");
	setup();
}

void init()
{
	add_action("do_climb","climb");
}

int do_climb(string arg)
{
	if (arg!="大石头") return 0;
	message_vision( "$N手足并用的爬上了大石头，在上面还没有站稳，就听见下面有人\n"
			"断喝：“你爬那么高干什么，快点下来，$N心里一慌，脚下一滑，\n"
			"重重的摔了下来。\n",this_player());
			this_player()->unconcious();
			return 1;
}
