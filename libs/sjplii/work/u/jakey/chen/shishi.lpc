inherit ROOM;

void create()
{
	set("short", "石室");
	set("long", @LONG
谁能想到在山腹中居然会有这么一个石室，这里很干燥。在
北面的墙上有个透气孔，可能是开在山隙中，外面不远就是灰黑
色的石壁。在室内有一个石台，上面的蒲团上坐着一具骷髅，衣
服散散的披在上面，有些血迹。
LONG
	);
	set("exits", ([ /* sizeof() == 1 */
//	"south" : __DIR__"midao7",
	]));
	set("item_desc",([
	"石台" : "一个不高的台子，有三尺见方，台子的前端写着一些字。\n",
	"字"   : "这几行字颜色暗红，看样子象是用血写的。\n\n"
		 "    老夫陈逸飞，在此闭关，不慎为逆子成斌所伤，伤势甚重，\n"
		 "恐时日无多，已无法生出此地。若能有人到此见此字，望能寻至\n"
		 "吾次子成少卓，告之此事，命其清理门户，吾甚为感激。\n\n"
		 "                               陈逸飞    绝笔\n",
	"骷髅" : "一具骷髅，身边放着一把剑，剑下压着一本书。\n",
	]));

	set("no_clean_up", 0);       
	setup();
}

void init()
{
	add_action("do_get","get");
}

int do_get(string arg)
{
	object obj;
	string from;
	if (!arg) return 0;
	if( sscanf(arg, "%s from %s", arg, from)==2 ) {
		if(from == "石台") {
		switch (arg) {
		case "book" :
		case "书" :	if (query("book")) {
				write("你在石台上找不到"+arg+"\n");
				return 1;}
				else {
				obj = new("/u/jakey/special/bladebook");
			 	obj->move(this_player());     
				add("book",1);
				message_vision("$N从石台上拿了一本书。\n", this_player());
				return 1;}
		case "sword":
		case "剑" :	if (query("sword")) {
				write("你在石台上找不到"+arg+"\n");
				return 1;}
				else {
				obj = new("/u/jakey/special/qiushang");
			 	obj->move(this_player());     
				add("sword",1);
				message_vision("$N从石台上拿了一把剑。\n", this_player());
				return 1;}
				}
		  }
	}
	return 0;
}
