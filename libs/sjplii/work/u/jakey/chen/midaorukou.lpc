inherit ROOM;

void create()
{
	set("short", "密道");
	set("long", @LONG
这里三面是青色的墙，一个出口黑洞洞的你看不清楚那里面
有什么，在与出口相对着的墙上是几个火把，看来是用来照明用
的。不过，它们几乎都烧光了，灰烬散落在地上。有一个火把倒
是挺完好的在墙上插着。不过可能是很长没有人用，上面堆积着
一层厚厚的灰。
LONG
	);
	set("exits", ([ /* sizeof() == x */
	"north" : "/u/jakey/chen/midao"+((random(2)*2)+1),
	]));
	set("no_clean_up", 0);       
	setup();
}

void init()
{
	add_action("do_move","move");
	add_action("do_search","search");
}

int do_search(string arg)
{
	object ob;
	if (arg!="地上") return 0;
	if ((int)query("searched")>0) return notify_fail("你用手在地上摸索了一遍，什么也没有找到。\n");
	write ("你用手在地上摸索着，突然感觉碰到了一个东西，就捡了起来。\n");
	ob=new("/u/jakey/special/huozhe");
	ob->move(this_player());
	add("searched",1);
	return 1;
}

int do_move(string arg)
{
	if (arg!="火把") return 0;
	write("你用手握住墙上的火把，用力扳了一下。\n");
	if (this_player()->query("max_force")<1000) return notify_fail("什么事情也没有发生。\n");
	tell_room(__FILE__,"只听“咔嚓”一声，你头顶的青石慢慢的移开了，露出了一条向上的通道。\n");
	add("exits/southup","/u/jakey/qishi");
	"/u/jakey/qishi"->add("exits/northdown","/u/jakey/chen/midaorukou");
	call_out ("close_passage",5);
	return 1;
}

void close_passage()
{
        object room;
	delete("exits/southup");
	tell_room("/u/jakey/qishi","移开的青石又动了起来，缓缓的将入口挡住了。\n");
	tell_room("/u/jakey/chen/midaorukou","青石又缓缓的移动起来，将头顶的通道挡住了。\n");
	if (room = find_object("/u/jakey/qishi")) {room->delete("exits/northdown");}
}

int valid_leave(object me,string dir)
{
	if (dir=="north") {
	me->set_temp("step",1);
	me->set_temp("join",0);}
	return 1;
}