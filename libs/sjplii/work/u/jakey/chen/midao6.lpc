inherit ROOM;

void create()
{
	set("short", "密道");
	set("long", @LONG
黑乎乎的密道好像没有尽头似的，你发现脚下有一副人类的
骸骨正躺在地上，这里有些潮湿，骸骨上长了一层绿色的霉菌。
LONG
	);
	set("exits", ([ /* sizeof() == 2 */
	"south" :	__DIR__"midao5",
	"north":	__DIR__"midao7",
	]));
	set("item_desc",([
	"骸骨"	: "一副人类的骸骨，在骸骨上好象有什么东西闪着乌光。\n",
	]));
	set("no_clean_up", 0);       	
	setup();
}

void init()
{
	add_action("do_search","search");
}

int do_search(string arg)
{
	object me,bi;
	me=this_player();
	if (arg!="骸骨") return 0;
	message_vision("$N俯下身，在骸骨中翻找。\n",me);
	if (query("searched")>0) return notify_fail("你什么也没有找到。\n");
	write("你在骸骨中找出一把匕首和一些黄金。\n");
	bi=new("/u/jakey/special/blackdagger");
	bi->move(me);
	bi=new("/obj/money/gold");
	bi->set_amount(100);
	bi->move(me);
	add("searched",1);
	return 1;
}
