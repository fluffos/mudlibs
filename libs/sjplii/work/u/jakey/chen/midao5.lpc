inherit ROOM;
string look_pic();

void create()
{
	set("short", "密道");
	set("long", @LONG
这里是黑乎乎的密道，狭小的道路两旁是冰冷的石壁。这里
同样黑暗潮湿，但是似乎有点光线了。
LONG
	);
	set("exits", ([ /* sizeof() == 2 */
	"north" : __DIR__"midao6",
	"south"	: __DIR__"midao"+((random(2)*2)+1),
	]));
	set("sign1","○");set("sign2","●");set("sign3","○");
	set("sign8","●");set("sign9","●");set("sign4","●");
	set("sign7","○");set("sign6","●");set("sign5","○");
	set("item_desc",([
	"石壁" : "你隐隐约约可以看到石壁上好象有图案\n",
	"图案" : (: look_pic :),
	]));
	set("no_clean_up", 0);       
	setup();
} 


int valid_leave(object me,string dir)
{
	if (dir=="south") {
	me->set_temp("step",14);
	me->set_temp("join",1);}
	return 1;
}

string look_pic()
{
	write("你挨近石壁上的图案，发现这个图案是下面这样的。\n");
	write("\n\n\t"+(string)query("sign1")+"\t"+(string)query("sign2")+"\t"+(string)query("sign3")+"\n\n\n");
	write("\n\t"+(string)query("sign8")+"\t"+(string)query("sign9")+"\t"+(string)query("sign4")+"\n\n\n");
	call_out("go_fight",1,this_player());
	return "\n\t"+(string)query("sign7")+"\t"+(string)query("sign6")+"\t"+(string)query("sign5")+"\n\n\n";
}

void go_fight(object ob)
{
	remove_call_out("go_fight");
	if ( 	(string)query("sign1")=="○" &&
		(string)query("sign2")=="○" &&
		(string)query("sign3")=="○" &&
		(string)query("sign4")=="○" &&
		(string)query("sign5")=="○" &&
		(string)query("sign6")=="○" &&
		(string)query("sign7")=="○" &&
		(string)query("sign8")=="○" &&
		(string)query("sign9")=="○" ) {
	tell_room("/u/jakey/chen/midao5","密道的石壁“咔”的一声轻响，开了一道石门。\n");
	tell_room("/u/jakey/chen/fight","只听“咔”的一声，房间多出了一道石门。\n");
	add("exits/east","/u/jakey/chen/fight");
	"/u/jakey/chen/fight"->add("exits/west",__FILE__);
	call_out ("close_passage",5);}
	return;
}

void close_passage()
{
	"/u/jakey/chen/midao5"->delete("exits/east");
	"/u/jakey/chen/fight"->delete("exits/west");
	tell_room("/u/jakey/chen/midao5","打开的石门又无声无息的关上了。\n");
	tell_room("/u/jakey/chen/fight","打开的石门又无声无息的关上了。\n");
	set("sign1","○");set("sign2","●");set("sign3","○");
	set("sign8","●");set("sign9","●");set("sign4","●");
	set("sign7","○");set("sign6","●");set("sign5","○");
	return;
}

		
