#include <ansi.h>
inherit ROOM;

void create() {
  set("short", "悬崖");
  set("long", @LONG
这里是一个陡峭的悬崖，这里也是个风口，强劲的山风在这
里呼啸着，把这里几乎吹的什么也没有了。只在靠近山壁的地方
有一株矮小的松树。树被风吹的很弯，但是还坚韧的往崖外伸展
着。在山壁上刻着“落月”两个巨字。字苍劲有力，让人感受到
一股强烈的豪情。
LONG
  );
  set("exits", ([ /* sizeof() == 1 */
    "east": __DIR__ "hspath2",
  ]));
  set("no_clean_up", 0);
  set("outdoors", "jakey");
  setup();
}

void init() {
  add_action("do_jump", "jump");
  add_action("do_use", "use");
  add_action("do_left", "left");
  add_action("do_right", "right");
  add_action("do_get", "get");
}

int do_jump(string arg) {
  if (arg != "west") return notify_fail("你打算往哪边跳？\n\n");
  write("你用尽力气向前一纵。\n可惜没有纵出一丈远，就象一块石头一样直坠了下去。\n");
  if ((int)this_player()->query_temp("steps") == 29) {
    write("你害怕的紧闭住眼睛，只听耳边呼呼风响。\n不知落了多久，“扑通”的一声，你掉进了一个水潭。\n");
    this_player()->move(__DIR__ "shuitan4");
    return 1;
  }
  this_player()->move(__DIR__ "yadi1");
  write(HIR "你眼前一片血红，最后一个意识是“我摔死了！！！”\n\n" NOR);
  message("vision",
    HIR + this_player()->name() + "从上面掉落下来，一下就摔死了。\n\n" NOR,
    environment(this_player()), this_player());
  this_player()->die();
  return 1;
}

int do_use(string arg) {
  object qingsi, me = this_player();
  string to;
  if (!arg) return 0;
  if (sscanf(arg, "%s to %s", arg, to) == 2) {
    if (to == "松树") {
      if (arg == "情丝" || arg == "qingsi") {
        qingsi = present("qingsi", this_player());
        if (!qingsi) return notify_fail("你身上没有情丝。\n");
        write("你从身上拿出情丝，捆在松树上，然后顺着情丝滑了下去。\n\n");
        message("vision", me->name() + "拿出一根绳子，捆在松树上，然后顺着绳子滑了下去。\n", environment(me), me);
        write("你顺着绳子下滑了一段，突然手一滑，绳子从手中脱出，你向着下面的万丈深渊坠了下去。\n");
        destruct(qingsi);
        me->move(__DIR__ "pine");
        me->unconcious();
        add("useed", 1);
        return 1;
      } else return notify_fail("你不能把" + arg + "用于" + to + "。\n");
    } else return notify_fail("你不能把" + arg + "用于" + to + "。\n");
  } else return notify_fail("指令格式： use <某物> to <某处>\n");
}

int do_get(string arg) {
  string from;
  object obj;
  if (!arg) return 0;
  if (sscanf(arg, "%s from %s", arg, from) == 2) {
    if (from == "松树") {
      if (arg == "情丝" || arg == "qingsi") {
        if (!query("useed")) {
          write("树上没有情丝。\n");
          return 1;
        }
        obj = new("/u/jakey/obj/qingsi");
        obj->move(this_player());
        message_vision("$N从树上解下一条绳子。\n", this_player());
        set("useed", 0);
        return 1;
      }
    }
  }
}

int do_left() {
  this_player()->add_temp("steps", 1);
  write("你向左走出了一步。\n");
  if ((int)this_player()->query_temp("steps") == 0) return notify_fail("你回到了原地。\n\n");
  if ((int)this_player()->query_temp("steps") < 0) {
    write("你现在站在右" + chinese_number((int)(0 - (int)this_player()->query_temp("steps"))) + "步的位置上。\n");
    return 1;
  }
  write("你现在站在左" + chinese_number((int)this_player()->query_temp("steps")) + "步的位置上。\n");
  return 1;
}

int do_right() {
  this_player()->add_temp("steps", -1);
  write("你向右走出了一步。\n");
  if ((int)this_player()->query_temp("steps") == 0) return notify_fail("你回到了原地。\n\n");
  if ((int)this_player()->query_temp("steps") < 0) {
    write("你现在站在右" + chinese_number((int)(0 - (int)this_player()->query_temp("steps"))) + "步的位置上。\n");
    return 1;
  }
  write("你现在站在左" + chinese_number((int)this_player()->query_temp("steps")) + "步的位置上。\n");
  return 1;
}
