inherit ROOM;

void create() {
  set("short", "后院");
  set("long", @LONG
这是个宽敞的院子，院子边侧摆放着兵器架，还有一个石桌
和石凳，左边是成斌的寝室，右边是成斌的书房。
LONG
  );
  set("exits", ([ /* sizeof() == 3 */
    "south": __DIR__ "hspath",
    "east": __DIR__ "bookroom",
    "west": __DIR__ "woshi",
  ]));
  set("item_desc", ([
    "west": "卧室的房门虚掩着，你看不到里面的情况。\n",
    "east": "书房的房门虚掩着，你看不到里面的情况。\n",
  ]));
  set("objects", ([
    __DIR__ "npc/master": 1,
  ]));
  set("no_clean_up", 0);
  set("outdoors", "jakey");
  set("valid_startroom", 1);
  setup();
}

int valid_leave(object me, string dir) {
  object master;
  master = present("luoyue master", environment(me));
  if ((dir == "east") && (objectp(master)))
    return notify_fail("成斌拦住你，说道：“我的书房不许外人入内。”\n");
  if ((dir == "west") && (objectp(master)))
    return notify_fail("成斌拦住你，说道：“我的卧室不许外人入内。”\n");
  return 1;
}
