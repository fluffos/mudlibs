inherit ROOM;

void create() {
  set("short", "大厅");
  set("long", @LONG
这里是李员外家的大厅，虽说是大户，摆设却不阔绰。摆设
着几张木椅，四周挂着花灯笼。李员外正在厅前踱步。北面是李
家的内宅。
LONG
  );
  set("exits", ([ /* sizeof() == 2 */
    "east": __DIR__ "damen2",
    "west": __DIR__ "zl7",
  ]));
  set("objects", ([
    __DIR__ "npc/yuanwai": 1,
  ]));
  set("no_clean_up", 0);
  setup();
}

int valid_leave(object me, string dir) {
  object yuanwai;
  yuanwai = present("yuanwai", environment(me));
  if (dir == "west")
    if (objectp(yuanwai))
      return notify_fail("李员外伸手拦住你，说道：“里面是我的内宅，你不能进去。\n");
  return 1;
}
