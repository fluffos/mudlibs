inherit ROOM;

void create() {
  set("short", "卧室");
  set("long", @LONG
一张床，一张桌案和两把椅子几乎就构成了卧室的全部，朴
素的让人不敢相信。屋角的一只墨烟冻石鼎中袅袅飘出淡淡的青
烟，闻着让人心神舒畅。打开窗子，只见后花园中苍松翠柏，奇
岩突石，各占形势，一弯清泉，绕石而过，好一幅美丽的山水画
卷啊！在石旁卧着一头浑身雪白的华南虎，据说也以近通灵，深
得金童的喜爱。
LONG
  );
  set("exits", ([ /* sizeof() == x */
    "south": __DIR__ "jint1",
  ]));
  set("no_fight", "1");
  set("no_spells", "1");
  set("no_magic", "1");
  set("no_clean_up", 0);
  setup();
