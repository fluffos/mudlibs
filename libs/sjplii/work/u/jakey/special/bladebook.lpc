inherit ITEM;

void create()
{
	set_name("刀剑诀（上卷）", ({ "blade book", "book" }));
	set_weight(50);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "本");
		set("long", "这是一本学习刀法精髓的书籍。\n");
		set("material", "paper");
		set("skill", ([
			"name":	"blade",	
			"exp_required":	100000,	
			"sen_cost":	10,
			"difficulty":	50,
			"max_skill":	60,
			"min_skill":    20
		]) );
	}
}
