// black dagger.c

#include <weapon.h>

inherit DAGGER;

void create()
{
    set_name("玄铁匕首", ({ "black dagger", "dagger" }) );
	set_weight(800);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "把");
		set("value", 10000);
		set("material", "steel");
        set("long", "这是一把乌黑发着亮光的匕首。\n");
        set("wield_msg", "$N从怀里拿出一把$n，握在手中。\n");
		set("unequip_msg", "$N将手中的$n揣入怀中。\n");
	}
    init_dagger(75);
	setup();
}
