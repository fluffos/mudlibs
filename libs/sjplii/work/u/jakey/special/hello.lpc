inherit NPC;
 
void create()
{
        set_name("哈罗先生", ({ "hello" }) );
        set("gender", "男性" );
        set("age", 54);
        set("long", "一个非常和蔼可亲的先生。\n");
        setup();
	carry_object("/u/jakey/obj/baicloth1")->wear();
}

void init()
{
	add_action("do_make","make");
}

int do_make(string arg)
{
	int i;
	object masker,*all,mask;
	string name;
	all=users();

	if (!arg) return notify_fail("告诉我你想假扮的人的名字（name）。\n");

	for(i=0; i<sizeof(all); i++) 
	{
		if( arg == all[i]->query("id") ) masker = all[i];
	}

	if( !masker ) return notify_fail("你要假扮的人现在不在游戏中。\n");

	mask=new("/u/jakey/special/mask");
	mask->set("armor_prop/id",({(string)masker->query("id")}));
	mask->set("armor_prop/name",({(string)masker->query("name")}));
	mask->set("armor_prop/short",({(string)masker->short()}));
	mask->set("armor_prop/long",({(string)masker->long()}));
	mask->set("long","这不是一件普通的布衣，这件布衣能把你伪装成"+
		(string)masker->query("name")+"的样子。\n");

	mask->move(this_player());
	write("哈罗先生给你一件布衣。\n");
	return 1;
}
