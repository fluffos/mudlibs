inherit ITEM;

void create() {
  set_name("无名旧书", ({ "force book", "book" }));
  set_weight(50);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "本");
    set("long", "这本书看上去破旧不堪，封面的左下有个“陈”字。\n");
    set("material", "paper");
    set("skill", ([
      "name": "force",
      "sen_cost": 15,
      "difficulty": 25,
      "max_skill": 50,
    ]));
  }
}
