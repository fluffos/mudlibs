inherit ITEM;

void create()
{
	set_name("咒术精要", ({ "spell book", "book" }));
	set_weight(50);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "本");
		set("long", "这是一本学习咒术精髓的书籍。\n");
		set("material", "paper");
		set("skill", ([
			"name":	"spells",	
			"sen_cost":	10,	
			"difficulty":	30,	
			"max_skill":	30	
		]) );
	}
}
