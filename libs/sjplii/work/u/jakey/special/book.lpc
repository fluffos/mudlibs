inherit ITEM;

void create()
{
	set_name("刀剑诀（下卷）", ({ "sword book", "book" }));
	set_weight(50);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "本");
		set("long", "这是一本学习剑法精髓的书籍。\n");
		set("material", "paper");
		set("skill", ([
			"name":	"sword",	
			"exp_required":	20000,	
			"sen_cost":	20,
			"difficulty":	40,
			"max_skill":	100,
			"min_skill":    60
		]) );
	}
}
