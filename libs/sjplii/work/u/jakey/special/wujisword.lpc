// wuji sword.c

#include <weapon.h>

inherit SWORD;

void create()
{
    set_name("无极剑", ({ "wuji sword", "sword" }) );
	set_weight(2000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "把");
		set("value", 50000);
		set("material", "steel");
        set("long", "这是成斌的成名武器，乌黑发着亮光。\n");
        set("wield_msg", "$N拿出一把$n，握在手中。\n");
		set("unequip_msg", "$N放下手中的$n。\n");
	}
    init_sword(95);
	setup();
}
