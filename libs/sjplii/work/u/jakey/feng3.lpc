inherit ROOM;

void create()
{
	set("short", "小姐闺房");
	set("long", @LONG
这里是小姐的房间。房间不大，但布置的很好，淡紫色中带
点淡蓝色，配上白色的柔纱，清雅怡人。房间里摆放着化妆台，
柜子，床铺。空气中弥漫着淡淡的花香。现在小姐正躺在床上，
旁边有个小丫头伺候着。
LONG
	);
	set("exits", ([ /* sizeof() == 1 */
	"down" : __DIR__"feng2",
	]));
	set("objects", ([ 
	__DIR__"npc/xiaojie" : 1,
	__DIR__"npc/yuer" : 1,
	]));
	set("no_clean_up", 0);

	setup();
}

void init()
{
	add_action("do_push","push");
}

int do_push(string arg)
{
	if (arg!="天花板") return 0;
	write("你推开天花板，露出一个洞口来\n");
	add("exits/up","/u/jakey/dest");
	call_out ("close_passage",5);
	return 1;
}


void close_passage()
{
        object room;
	delete("exits/up");
	tell_room("/u/jakey/dest","挡在入口的木板被人挪开了。\n");
}
