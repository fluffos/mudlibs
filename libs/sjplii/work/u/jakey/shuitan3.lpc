inherit ROOM;

void create() {
  set("short", "假山内部");
  set("long", @LONG
这里黑不隆冬的，你几乎什么也看不见。只有些细小的光点
射进来，原来这里竟然是在假山的内部。这里因为有水道的关系
，潮湿的很。在角落里有一些破衣服，还有个黑黑的，方方的东
西，好像是个箱子。
LONG
  );
  set("exits", ([ /* sizeof() == 1 */
    "westdown": __DIR__ "shuitan2",
  ]));
  set("no_clean_up", 0);
  setup();
}

void init() {
  add_action("do_search", "search");
  add_action("do_open", "open");
}

int do_search(string arg) {
  object ob, me;
  me = this_player();

  if (arg == "箱子") {
    if ((int)query("opened") == 0) { write("箱子是锁住的！\n"); return 1; } else if ((int)query("bookgot") > 0) {
      message_vision("$N在箱子里找来找去，结果什么也没找到。\n", me); return 1;
    } else {
      message_vision("$N从箱子里找出一本书和一把刀。\n", me);
      ob = new("/u/jakey/special/swordbook");
      ob->move(me);
      ob = new("/u/jakey/special/baodao");
      ob->move(me);
      add("bookgot", 1); return 1;
    }
  }

  if (arg == "破衣服") {
    if ((int)query("clothgot") > 0) { write("你在衣服里翻了一阵，什么也没有找到。\n"); return 1; } else {
      message_vision("$N从衣服里找到一把钥匙。\n", me);
      ob = new("/u/jakey/obj/boxkey");
      ob->move(me);
      add("clothgot", 1); return 1;
    }
  }
  return 0;
}

int do_open(string arg) {
  if (arg != "箱子") return 0;
  else {
    if ((int)query("opened") > 0) { write("箱子已经是打开的。\n"); return 1; } else {
      if (!present("box key", this_player())) {
        write("箱子是锁住的，你打不开！\n"); return 1;
      } else {
        message_vision("$N拿出一把钥匙把箱子打开了。\n", this_player());
        add("opened", 1); return 1;
      }
    }
    return 1;
  }
}
