inherit ROOM;

void create() {
  set("short", "论剑轩");
  set("long", @LONG
这里是落月山庄庄主的剑室，有专人负责看管，一排排的架
子上摆放着许多名剑，但也有练习用的竹剑，你可以用（list）
看有哪些兵刃，也可以要（yao）到练习的兵器。
LONG
  );
  set("exits", ([ /* sizeof() == 1 */
    "south": __DIR__ "xyuan2",
  ]));
  set("no_fight", "1");
  set("no_spells", "1");
  set("no_magic", "1");
  set("objects", ([
    __DIR__ "npc/haoge": 1,
  ]));
  set("no_clean_up", 0);
  setup();
}

void init() {
  add_action("do_search", "search");
}

int do_search(string arg) {
  object haoge, sword, me;
  me = this_player();
  haoge = present("hao ge", environment(me));
  if (arg != "架子") return 0;
  if (objectp(haoge)) return notify_fail("豪哥一手拦住你：“你要什么兵刃可以找我要，不许自己乱动。\n");
  if ((int)query("searched") > 0) return notify_fail("你看了看架子上面，没有什么好的兵器。\n");
  write("你看了看架子上面，发现有一把剑好象很不错，就拿了下来。\n");
  sword = new("/u/jakey/special/wujisword");
  sword->move(this_player());
  add("searched", 1);
  return 1;
}
