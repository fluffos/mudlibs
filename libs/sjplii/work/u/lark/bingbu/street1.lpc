//ROOM:/u/changan/street1.c

inherit ROOM;

void create()
{
set("short","兵部尚书府");
set("long",@LONG
这里是兵部尚书的官邸,两边有两头威武的石狮,台阶下有一块三丈高的石碑
(shibei)高高的石阶上有四名虎背熊腰的卫士分立两旁,门口安安静静,因为这里是不准许停留的.
红漆镶金的大门上悬一块额匾(ebian)大门禁闭着,只开着旁边的一个偏门.
LONG
);
set("item_desc",([
"shibei":@TEXT
只见上面金漆楷书三个大字:下马碑.这是先帝感念
兵部尚书路大人,开国的赫赫战功特令所立,见碑如见圣上,文官下轿
武官下马.违者斩立绝.
TEXT,
"ebian":
"敕立应天护国大将军一字并肩王路府.乃是先帝手书\n",
]));
set("exits",([
"south":__DIR__"street2",
"north":__DIR__"zhuquemen",
"west":__DIR__"qiyuan",
"east":__DIR__"menwei",
]));
set("objects", ([
    __DIR__"npc/guarder":4,
//    __DIR__"npc/yetongling":1,
]));
set("outdoors","changan");
setup();
replace_program(ROOM);
}

int valid_leave(object who, string exit)
{
        int exp;
        object tongling,huwei;
        string title;
        title=who->query("title");
        exp = (int) who->query("relation_exp")*10+(int) who->query
        ("combat_exp");
	if( exit != "east" ) return 1;
	if( !tongling=present("ye tongling", this_object()) && !huwei=present("huwei",this_object()) ) return 1;
	if( who->query("class")=="official" )
           {
             if(exp>1200000)
              {
                 message_vision("$N微微一抱拳，对着$n恭声说道：“"+title+"大人请进。”\n",
                  tongling,who);
                 return 1;
              }else{
                 message_vision("$N微微点了点头，说道：“进去吧，不要乱走”。\n",
                  tongling,who);
                  return 1;
               }       
            }
	return notify_fail("叶统领微微皱了皱眉头，对不起这里是尚书府不要乱闯\n");
}

