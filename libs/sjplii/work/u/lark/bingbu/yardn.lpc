//ROOM:/u/changan/bingbu/yardn.c

inherit ROOM;

void create()
{
set("short","北跨院");
set("long",@LONG
这里是北跨院,是兵部府卫们休息的居住的所在,院子中间
有棵老槐树.微风中轻轻摇摆着有些枯萎的枝条.四周是卫士们的
房间,大概昨晚值勤的卫士门都在睡觉.所以很安静.
LONG
);
set("exits",([
"west":__DIR__"menwei",
"north":__DIR__"majiu",
"south":__DIR__"damen2",
"east":__DIR__"sleeproom",
]));
  set("objects",([
    __DIR__"npc/qipaiguan":1,
]));
set("item-desc",([
"老槐树":"一棵老的不能再老的树,大概没有一百也有八十年了,虽然
现在已经开始枯萎了,但仍然顽强的生存着,粗大的枝条不屈的伸
向天空,比房檐都高出了一丈多.\n",
]));
set("outdoors","changan");
	set("no_fight",1);
	set("no_steal",1);
	set("no_magic",1);
setup();
}

void init()
{
  add_action("do_climb",({"climb"}));
}

int do_climb(string arg)
{
  object where,ob;
  if( arg !="老槐树") 
       return notify_fail("你要爬什么呀?\n");
  message_vision("$N悄悄的爬到了老槐树上.\n",this_player());
  where=find_object("/u/changan/bingbu/ontree");
  this_player()->move(where);
  
  if(ob=find_object(__DIR__"ontree")){
  tell_object("ob","有人从树下爬上来.\n");
   }
  return 1;
}

int valid_leave(object me,string dir)
{
	object ob;
       if(dir=="east" && present("qipai guan",environment(me)) && 
		me->query("id_type")!=3 )
	      return notify_fail("旗牌官伸手一拦，说道：“非兵部官员请回！”\n");
        return ::valid_leave(me,dir);
}
