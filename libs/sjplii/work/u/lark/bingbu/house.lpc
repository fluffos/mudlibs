inherit ROOM;

void create() {
  set("short", "寝室");
  set("long", "这里是下人们的寝室,陈设十分简单,两张青布帐塌,
靠窗是一张梳妆台,靠着墙角处有一个衣架.\n");
  set("exits", ([
    "west": __DIR__ "yards",
  ]));
  set("item_desc", ([
    "衣架": "上面挂着几件换洗用的衣服,一看就知道是丫鬟们穿的.\n",
  ]));
  setup();
}
