//ROOM:/u/changan/bingbu/damen.c

inherit ROOM;

void create()
{
  set("short","大门");
  set("long",@LONG
这里是兵部府的大门平时是关闭的,只有迎接大人物或贵客
的时候才会打开.现在门上插着一个巨大的门杼.看来没有把子力气是打不开的.
LONG
);
set("exits",([
"north":__DIR__"menwei",
"east":__DIR__"damen2",
]));
set("inem_desc",([
"门杼":"看起来很沉重,不知道能不能推开(push)\n",
]));
set("no_clean_up",0);
set("outdoors","changan");
setup();

}

void init()
{
 add_action("do_push",({"push"}));
}

int do_push(string arg)
{
 object ob;
 if(arg !="门杼") 
        return notify_fail("你要推什么\n");
 if(query("exits/west"))
        return notify_fail("门是开的!\n");
 if((int)this_player()->query_skill("unarmed")<100 && (int)this_player()->query("force")<100){
  write("你推了推却纹丝没动.\n");
   return 1;
    }
   message_vision("$N使劲一推,门杼被推到了地上.\n",this_player());
   set("exits/west",__DIR__"damen");
   tell_room(__DIR__"damen","叽呀一声,大门轻轻闪开了一道缝隙...\n");
   if(ob=find_object(__DIR__"street1")){
    ob->set("exits/east",__DIR__"street1");
   tell_room(ob,"有人从里面把大门打开了.\n");
  
   }
   
   return 1;
}

int valid_leave(object me, string exit)
{
 object ob;
  if(exit == "west" || exit =="w"){
     tell_object(this_player(),"“噫？谁把门打开了？”，门又被轻轻关上了。\n");
     delete("exits/west");
    if(ob=find_object(__DIR__"street1.lpc")){
     ob->delete("exits/east");
     tell_room(ob,"门被轻轻关上了。\n");
     }
    return 1;
  }
  return 1;
}
