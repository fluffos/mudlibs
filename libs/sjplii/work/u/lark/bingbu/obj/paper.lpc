//paper.c


inherit ITEM;

void create()
{
   set_name("文章",({"paper"}));
   set("long",
      "上面是路大人的字迹。。。\n"
          "所谓美人者，\n"
      " 以花为貌，以歌为语，以云为发，以玉为骨，以冰雪为肤，以诗词为心,\n"
      " 动若月移风陟，静如暗影疏香.........\n");
    set_weight(10);
    if( clonep() )
		set_default_object(__FILE__);
    else
set("unit","篇");
setup();
}
      
