//guarder.c
#include <ansi.h>
inherit NPC;

void create()
{
       set_name("锦衣卫士",({"weishi"}));
       set("gender","男性");
       set("age",25);
       set("str",24);
       set("cor",23);
       set("cps",10);
       set("per",20);
       set("int",20);
       set("score",1000);  
       
       set("long","身穿黑铁护甲的护卫，身形雄伟，凛然不可冒犯\n");
       set("combat_exp",50000);
       set_skill("unarmed",30);
       set_skill("parry",30);
       set_skill("dodge",30);
       set_skill("force",30);
       set_skill("blade",30);
       set_skill("move",30);
       
       set_temp("apply/dammage",20);
       set_temp("apply/armor",50);
       set_temp("apply/attack",50);
       set_temp("apply/defense",50);
       set_temp("apply/move",60);

       set("chat_chance_combat",15);
       set("chat_msg_combat",({
       "不想混了吧？敢到这里来撒野？\n"
       }));

       setup();  

    carry_object(__DIR__"obj/jinyi")->wear();
    carry_object(__DIR__"obj/sword")->wield();
}

int accept_fight(object me)
{
   object ob;
    command("heng");
    command("say 大爷正在值勤没工夫搭理你\n");
    return 0;
}  

void init()
{  
    object ob;
//    ::init();
    if(interactive(ob=this_player()) && ob->query_temp("killer") && living(this_object()) )
   {kill_ob(ob);}
    command("say 快来抓刺客\n");
    
}

void die()
{
   string killer;
   if(objectp(killer = query_temp("last_damage_from"))) {
      set_temp("killer",killer->query("id"));
  }
  ::die();
}

