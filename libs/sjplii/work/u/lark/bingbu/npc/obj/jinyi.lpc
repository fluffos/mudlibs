//tiejia.c

#include <armor.h>

inherit CLOTH;

void create()
{
   set_name("锦衣",({"jinyi"}));
   set_weight(1000);
   if( clonep() )
		set_default_object(__FILE__);
 else {
		set("unit", "件");
		set("value", 3000);
		set("material", "cloth");
		set("armor_prop/armor", 1);
		set("armor_prop/dodge", 1);
	}
	setup();
}


  