//guarder.c
#include <ansi.h>


inherit NPC;

void create()
{
       set_name("铁甲虎卫",({"huwei"}));
       set("gender","男性");
set("str",26);
set("age",23);
       set("cor",24);
       set("cps",11);
       set("per",23);
       set("int",23);
       set("score",1000);  
set("vendetta_mark", "authority");
       set("long","身穿黑铁护甲的护卫，身形雄伟，凛然不可冒犯\n");
       set("combat_exp",100000);
       set_skill("unarmed",50);
       set_skill("parry",50);
       set_skill("dodge",50);
       set_skill("force",50);
       set_skill("blade",50);
       set_skill("move",50);
       
       set_temp("apply/dammage",30);
       set_temp("apply/armor",80);
       set_temp("apply/attack",70);
       set_temp("apply/move",100);

       set("chat_chance_combat",15);
       set("chat_msg_combat",({
       "大胆狂徒，敢到尚书府里闹事，不想混了吧？\n"
       }));

       setup();  

    carry_object(__DIR__"obj/tiejia")->wear();
    carry_object(__DIR__"obj/blade")->wield();
}

int accept_fight(object me)
{
   object ob;
   ob=find_object(__DIR__"menwei");
if(ob=environment()) {
  
    command("heng");
 command("say 这里是尚书大人的府邸，没什么事快滚，没工夫和你扯淡!");
return 0;
}
   return 1;
}

void init()
{
object ob,obc;
ob=this_player();
obc=present("jia",ob);
if(obc && obc->query("name") =="黑铁护甲")
       ob->set_temp("killer",0);
    if(ob->query_temp("killer")==1 && living(this_object()))
   {kill_ob(ob);
    command("say 快来抓刺客\n");
}
}
void die()
{
object killer;
   if(objectp(killer = query_temp("last_damage_from")) )
  killer->set_temp("killer",1);
  ::die();
}

