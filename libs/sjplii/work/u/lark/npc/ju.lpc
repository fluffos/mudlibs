// linggu.c
#include <ansi.h>
inherit NPC;
void create()
{
        set_name("小菊", ({ "xiao ju","ju"}));
        set("gender", "女性" );
        
        set("long", "她一副小鸟依人的样子\n");
        set("age", 16);
        set("str", 25);
        set("cor", 30);
        set("cps", 27);
        set("per", 24);
        set("int", 25);
        set("attitude", "friendly");

        set("max_force", 4000);
        set("force", 4000);
        set("force_factor", 2);
        set("water", 400);
        set("food", 400);

        set("combat_exp", 500000);
        
        set("chat_chance", 5);
        set("chat_msg", ({
"小菊叹了口气：“就是的。。就算忙也不能冷落的夫人呀。。夫人那么美。。真是。。哎”\n", }));
        set_skill("unarmed", 100);
        set_skill("dodge", 100);
        set_skill("parry", 100);
        set_skill("sword", 100);
        set_temp("apply/attack", 100);
        set_temp("apply/defense", 100);

        setup();
}

