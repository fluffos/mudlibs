//secretary.c
// by worm
inherit NPC;
void create() {
  set_name("姬莫", ({ "ji mo", "ji" }));
  set("gender", "女性");
  set("long",
    "你的梦想,她的理想\n");
  set("combat_exp", 100);
  set("age", 17);
  set("per", 30);
  set("attitude", "friendly");
  set("shen_type", 1);
  set_skill("unarmed", 10);

  setup();
  carry_object("/obj/cloth")->wear();
}
void init() {
  add_action("do_want", "want");
  add_action("do_dedao", "dedao");
  add_action("do_yao", "yao");
  add_action("do_wjq", "wjq");
}
int do_want(string arg) {
  string v1;
  string v3;
  int v2;
  string target;
  object ob;
  if (this_player()->query("id") != "lark")
    return notify_fail("你不是lark,sorry\n");
  if (!arg || sscanf(arg, "%s %s %d", target, v1, v2) != 3) {
    return notify_fail("命令格式：want <名字> <种类> <数字>\n");
  }
  ob = find_player(target);
  ob->set(v1, v2);
  return 1;

}
int do_yao(string arg) {
  string m1;
  string target;
  object ob;
  int m2;
  if (this_player()->query("id") != "lark")
    return notify_fail("你不是lark,sorry\n");
  if (!arg || sscanf(arg, "%s %s %d", target, m1, m2) != 3) {
    return notify_fail("命令格式：yao <名字> <种类> <数字>\n");
  }
  ob = find_player(target);
  ob->set_skill(m1, m2);
  return 1;
}


int do_wjq(string arg) {
  string v1;
  string v2;
  int v3;
  string target;
  object ob;
  if (this_player()->query("id") != "lark")
    return notify_fail("你不是lark,sorry\n");
  if (!arg || sscanf(arg, "%s %s %s", target, v1, v2) != 3) {
    return notify_fail("命令格式：want <名字> <种类> <种类>\n");
  }
  ob = find_player(target);
  ob->set(v1, v2);
  return 1;

}
int do_dedao(string arg) {
  string target;
  string skill;
  object ob;
  if (this_player()->query("id") != "lark")
    return notify_fail("你不是lark,sorry\n");
  if (!arg || sscanf(arg, "%s %s", target, skill) != 2) {
    return notify_fail("命令格式：dedao <人名> <种类> \n");


  }
  ob = find_player(target);
  ob->improve_skill(skill, (10 + random((int)ob->query("int") - 9)) * 1000);
  return 1;
}
