//huofang.c

inherit ROOM;

void create()
{
  set("short","伙房");
  set("long",@LONG
这里是营地内的伙房为军士们提供免费的伙食。虽然手艺不一定
如何，可是一定能填饱肚子(chifan)。
LONG
);
  set("exits",([
    "south":__DIR__"jiaochang2",
]));
  set("objects",([
    "/u/lark/obj/pot":1,
]));
  setup();
}

void init()
{
 add_action("do_chifan","chifan");
}

int do_chifan(string arg)
{ 
  object ob;

  if(arg)
    return notify_fail("饿了？就吃吧。(chifan)\n");
  if(!this_player()->query("solider") || !this_player()->query("id_type")==4)
   return notify_fail("这里只为大兵哥提供伙食，你想吃白食？\n");
  message_vision("$N大叫一声：“饿死我了！给我来十斤牛肉!”\n",this_player());
  write("不一会一个火头军提着一块五香牛肉放到你的面前.好香\n");
  ob= new(__DIR__"obj/meat");
  ob->move(this_object());
  return 1;
}  
