//jiaochang.c
#include <ansi.h>
inherit ROOM;
void improve(object who);
int do_baogao(string arg);
void create()
{
 set("short","校场");
 set("long",@LONG
这里是军营内的校场，是兵士们日常训练的地方，整齐的方队，
划一的步伐，嘹亮的口号，闪亮的盔甲，让你不禁热血沸腾。
正有一个武将操练队列。南面是帅帐，北面是营房。
LONG
);
set("objects",([
 __DIR__"npc/zhang":1,
 __DIR__"npc/army":3,

]));
set("exits",([
  "out":__DIR__"gate",
  "south":__DIR__"shuai",
  "north":__DIR__"sleeproom",
  "east":__DIR__"jiaochang2",
]));
setup();
}

void init()
{
 add_action("do_baogao","baogao");
}

int do_baogao(string arg)
{
object me,ob;
  string name;
  name=this_player()->query("name") ;
  me=this_player();

  
  if(arg) 
    return notify_fail("你只要报告（baogao)一下就可以入列了!\n");
  message_vision("$N高声道：“报告！士兵"+name+"请求入列\n",this_player());
  if(!present("zhang fuqiang",this_object()))
     return notify_fail("地上坐着一个懒洋洋的士兵说：“现在首长不在,弟兄！休息休息吧。”\n");
   ob=present("zhang fuqiang",this_object());
   if(!me->query("solider"))
    return notify_fail(RED "张福强摇了摇头说：“你现在还没有入伍呢,先到营门口去报名。”\n" NOR);

  if((int)me->query_skill("strategy",1)>20){
         me->set_temp("arra",1);
    return notify_fail("张福强摇了摇头道：“不想当将军的士兵不是好士兵，你应该试试到兵部谋个发展了，不要这么不长进。好象我。。。 sigh”\n");
    }  


 if(me->query("sen")<100 || me->query("gin")<100)
        return notify_fail(RED "张福强怒道：“怎么没精打采的，你是操练还是睡觉来的？”\n" NOR);
 
 if(ob->query("start"))
        return notify_fail(RED "张福强摆了摆手,不满的说：“咱们当兵的最讲究的就是时间观念，你回去反省吧。下次来早点！”\n" NOR);
  
  message_vision("张福强点了点头：“入列！”\n",this_player());
  me->move(__DIR__"line");
  message_vision("$N跑步进入了队列，张福强高声口令：“齐步走!一二一。。。”队列整齐的前进了。\n",me);
  ob->set("start",1);
   write(RED "你和着口令,跟随队列，练习着行伍中最基本的行军训练。\n" NOR);
   remove_call_out("improve");
   call_out("improve",25,this_player());
   me->start_busy(20);
  
   return 1;
}

void improve(object who)
{
  
  object ob;
  ob=present("zhang fuqiang",this_object());
  
  
  
  who->improve_skill("strategy",random((int)who->query("int") + (int)who->query_skill("strategy",1)/5+(int)who->query("combat_exp")/1000) );
  who->add("combat_exp",(int)who->query_skill("strategy",1));
  
 who->add("sen",-(100-(int)who->query_skill("strategy",1)));
 who->add("gin",-(100-(int)who->query_skill("strategy",1)));
  
  message_vision("张福强高声下令：“立定！全体解散！”\n",who);
  who->move(__DIR__"jiaochang");
  tell_object(who,"总算完事了。。。。我的腰啊。。。我的腿。。\n");
  write(WHT "啊。吃粮当兵也不是件容易事情呀。够累的。不过挺磨练人\n" NOR);
  ob->set("start",0);
  return;
}

int valid_leave(object who, string exit)
{
object where,ob;
        object *inv;
int i;
where=find_object(__DIR__"gate");
if(exit != "out") return 1;

if(who->query_temp("job")) return 1;

inv = all_inventory(who);
                for(i=0; i<sizeof(inv); i++)
                {
                  if((int)(inv[i]->query("weapon_prop")))
                   return notify_fail("未经容许不得带兵器离开带离营地\n");
                  }
if(!who->query("solider")) return 1;
if(!present("bing",where)) return 1;
 return notify_fail("卫兵拦住你说道：“未得容许不得擅离营地。”\n");
}


