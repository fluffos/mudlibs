#include <ansi.h>

inherit NPC;

void create()
{
        set_name("张福强", ({ "zhang fuqiang","zhang" }) );
 set("long", "负责操练士兵队列的军官。如果想要参加训练就向他报告(baogao)\n");
        set("attitude", "heroism");
        set("age",30);
        set("str", 20);
        set("cor", 20);
        set("cps", 20);
        set("title",RED "典军校尉"NOR);
        set("id_type",4);
       
        set("student_title","官员");
        set("vendetta_mark", "authority");
        set("combat_exp", 200000);
        set_skill("spear",80);
        set_skill("unarmed", 60);
        set_skill("blade", 80);
 set("force", 1000);
set("max_force", 1000);
set("force_factor", 10);
        set_skill("parry", 60);
        set_skill("dodge", 60);
        set_skill("force",70);
        set_skill("move", 100);
        set_skill("dagger",250);
        set_skill("yang_spear",80);     //杨家枪法
        set_skill("xingyi-ken",80);     //形意拳
        set_temp("apply/dammage", 30);
//    set_skill("nezha_dagger",60)
        set_skill("bixueforce",70);
        set_temp("apply/defense", 30);
        set_temp("apply/attack", 30);
        map_skill("unarmed","xingyi-ken");
      map_skill("spear","yang_spear");
        map_skill("force","bixueforce");
        setup();

  carry_object("/obj/cloth/tiejia")->wear();
carry_object("/d/city/npc/obj/longdagger")->wield();
}

int accept_object(object who, object ob)
{
   int som;
   som = ob->value();
   if(who->query("relation_exp") < 200000 )
   who->add("relation_exp",som/random(1000));
   tell_object(who,"张福强暧昧的看了你一眼，：“有前途，将来一定吃得开。。呵呵”\n");
   return 1;
}
