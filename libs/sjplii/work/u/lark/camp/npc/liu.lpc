#include <ansi.h>
inherit NPC;
int do_upto();
string  summon_more( object who);
void create()
{
        set_name("刘旭东", ({ "liu xudong","liu" }) );
        set("long", "本地守军的最高长官\n");
        set("nickname", CYN"长安关防长官"NOR);
        set("attitude", "heroism");
        set("student_title","官员");
        set("title",RED "安国将军" NOR);
         set("id_type",4);
         set("class","official");
        set("vendetta_mark", "authority");
        set("str", 30);
        set("int", 30);
        set("cor", 30);
        set("spi", 30);
        set("agi", 30);
        set("max_kee", 1000);
         set("inquiry",([
         "晋升"  : (:do_upto:),
         ]));
        set("max_gin", 1000);
        set("max_sen", 1000);
        set("kee", 1000);
        set("gin", 1000);
        set("sen", 1000);
        set("force", 2000);
        set("max_force", 2000);
        set("force_factor", 20);
        set("score", 90000);
        set_temp("apply/attack", 30);
        set_temp("apply/defense", 30);
        set_temp("apply/move", 30);
        set_skill("blade",200);
        set("chat_chance_combat", 50);
        set("chat_msg_combat", ({
                (: summon_more(this_object()) :),
                (: command, "escort" :),
        }) );
        set("combat_exp", 3500000);
        set_skill("unarmed", 200);
        set_skill("dagger",250);
        set_skill("force",180);
        set_skill("parry", 120);
        set_skill("dodge", 110);
        set_skill("xingyi-ken",200);
// set_skill("nezha_dagger",220)
        set_skill("bixueforce",150);
        set_skill("move", 100);
        set_skill("literate",90);
        set_skill("officialism",150);
        set_skill("strategy",150);
        map_skill("unarmed","xingyi-ken");
        map_skill("force","bixueforce");
// map_skill("dagger","nezha_dagger");
        setup();

         carry_object("/obj/cloth/tiejia")->wear();
carry_object("/obj/weapon/longdagger")->wield();
}

int do_upto()
{
  string id; 
  object me,ob;
  me=this_player();
  
  id=this_player()->query("id");
   if(!me->query("solider")){

      write(RED "刘将军皱了皱眉头，翻开花名册，：“你真正军人的不是。要想当官先得吃苦！”\n" NOR);
      return 1;
      }
   if(!me->query_temp("arra")){
    write(RED "刘将军摇了摇头：“你还缺练，回去接着站军姿去吧！”\n" NOR);
    return 1;
     }
   message_vision("刘将军翻了翻案头$N的档案：“恩。。根正苗红，立场坚定,业务娴熟。。。正是需要发展的优秀分子”\n",me);
   message_vision("刘将军铺开笔墨，一会儿。。抬起头：“这是给你的推荐信，你立刻到兵部报到去吧。好好干”\n",me);
   ob=new(__DIR__"obj/letter");
   ob->set("owner",id);
   ob->move(me);
   me->delete("solider");
   return 1;
}

int accept_object(object who, object ob)
{
   int som;
   som = ob->value();
   if(som<10000)
      return notify_fail("刘将军不屑的看了看，：“谢了，你留着买点花生米下酒吧，我不缺这点钱，哼！”\n");
   if(who->query("relation_exp") < 200000 )
   who->add("relation_exp",som/random(1000));
//   who->add("life_exp",som/10);
   tell_object(who,"刘将军暧昧的看了你一眼，：“有前途，将来一定吃得开。。呵呵”\n");
   return 1;
}
string summon_more(object who)
{
        object soldier;
        seteuid(getuid());
        soldier = new("/obj/npc/bodyguard");
        soldier->move(environment(who));
        command("escort");
        return "1";
}


