//ROOM:/u/changan/bingbu/damen3.c

inherit ROOM;

void create() {
  set("short", "三门");
  set("long", @LONG
出了走廊这里是兵部府的三门了,正所谓侯门深似海,在往里
就是尚书大人的内府了,除了亲近之人不得入内.胆敢擅闯,可是
会掉脑袋的.
LONG
  );
  set("exits", ([
    "east": __DIR__ "yongdao1",
    "north": __DIR__ "zoulang6",
    "south": __DIR__ "zoulang12",
  ]));
  set("objects", ([
    __DIR__ "npc/yun": 1,
  ]));
  set("no_fight", 1);
  set("outdoors", "changan");
  setup();

}

int valid_leave(object me, string exit) {
  object ob;
  if (!present("yun haochi", me)) return 1;
  if (exit != "east") return 1;
  if (!ob = present("pai", me))
    return notify_fail("云皓池摆了摆手,这里是师哥和嫂子住的地方,不能随便进去!\n");
  return 1;
}
