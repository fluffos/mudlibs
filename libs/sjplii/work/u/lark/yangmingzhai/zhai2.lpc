inherit ROOM;

void create() {
  set("short", "碎石路");
  set("long", @LONG
北面通往羊鸣寨的广场，南面是山寨大门。路的两旁长满了杂草
显得十分的荒凉。
LONG);


  set("exits",
    ([  //sizeof() == 3
    "north": __DIR__ "zhai3",
      "east": __DIR__ "luanfen",
      "southdown": __DIR__ "zhai1",
    ]));
  setup();
  replace_program(ROOM);

}
