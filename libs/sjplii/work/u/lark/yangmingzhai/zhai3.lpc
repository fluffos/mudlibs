inherit ROOM;

void create ()
{
        set ("short", "广场");
        set ("long", @LONG
这里是羊鸣寨的前广场,灯火通明,周围满了喽罗,大声的吆喝着
搬动着劫来的彩头。吵闹中夹杂着叫骂,显的十分的热闹。北面是山
寨的大厅,大概寨主总是一脸的阴沉,只他不叫人,一般没人敢轻易进
去。南面则同向山寨的大门。
LONG);

        set("out_doors","zhai");       
        set("exits", 
        ([ //sizeof() == 4
              "north" : __DIR__"dating",
