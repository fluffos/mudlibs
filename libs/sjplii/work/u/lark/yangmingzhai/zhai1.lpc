inherit ROOM;

void create ()
{
        set ("short", "山寨大门");
        set ("long", @LONG
你已经走到羊鸣寨的大门,周围怪树林立,使人不寒而栗。正中一道
二丈来宽，三丈来高的朱红杉木包铜大门，上方一块大匾，龙飞凤舞地
书着[羊鸣寨]几个大字。但由于年久失修，显的十分的陈旧。南面是山道。

LONG);

       
        set("exits", 
        ([ //sizeof() == 2
              
              "northup" :__DIR__"zhai2",
              "south" :__DIR__"shandao"
              
        ]));
        setup();
        replace_program(ROOM);
}

