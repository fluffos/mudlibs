//tangyuan2.c
#include <ansi.h>
inherit ROOM;

void create()
{
  set("short","堂院");
  set("long",@LONG
这里是尚书府的堂院，肃穆的气氛不禁让人有些紧张，来来往往
都是一些身穿官服的朝廷官员，偶尔还有一两个锦衣华袍的陌生
人从东面的大堂里匆匆忙忙的走出来显得有些鬼祟。
LONG
);
  set("exits",([
   "south":__DIR__"mishufang",
   "north":__DIR__"wenshufang",
   "west":__DIR__"tangyuan",
   "enter":__DIR__"hall",
]));
  set("objects",([
   __DIR__"npc/weishi":2,
   __DIR__"npc/zhao":1,
]));
  setup();
}

int valid_leave(object who, string exit)
{
  object ob;
  if(!present("guard",this_object()) && !present("zhao guandai",this_object())) return 1;
  if( exit == "enter" )
{
   if(who->query("id_type")==0) 
	return 1;
   if(who->query("id_type")==3) 
	return 1;
}
  if( exit == "west" )return 1;
   if(who->query("id_type")==3) return 1;
  if( exit == "north" ){
   if(who->query("id_type")==3) return 1;
   return notify_fail("你不是吏部官员那里你不能去!\n");
  }
  if( exit == "south" ){
   if(who->query("id_type")==3 || who->query("job")) return 1;
   return notify_fail("那是吏部重地你没有权利到那里去!\n");
  }
  if( exit == "enter" ){
        int exp;
        string title;
        title=who->query("title");
        exp = (int) who->query("relation_exp")*10+(int) who->query
        ("life_exp");
    if(who->query("wenzy")) {
         tell_room(this_object(),title+RED"恭喜恭喜请进请进！"NOR);
      return 1;
      }
   
   if(exp>1200000 && who->query("class")=="official"){
     tell_object(who,title+"大人请进.\n");
     return 1;
    }
   
   return notify_fail("这里是吏部重地你没有权利到那里去!\n");
  }

}
