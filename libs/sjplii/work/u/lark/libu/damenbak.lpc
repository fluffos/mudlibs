//street.c
#include <ansi.h>
inherit ROOM;

void create()
{
   set("short","吏部尚书府");
   set("long",@LONG
沿着平坦如镜的青石的大道，这里就是吏部尚书府，门口簇簇拥拥
有许多车马行人门庭若市，台阶下的石狮旁停着几顶锦轿，轿子
旁边站着两个黄衣家丁，红木漆门上挂这块
额匾“吏部尚书张府”.
LONG);
   set("exits",([
//       "north":__DIR__" ",
//       "south":__DIR__" ",
    "west" : "/d/city/baihu-n1",
    "east":__DIR__"qianyuan",
]));

   set("objects",([
       __DIR__"npc/wang" :     1,
       __DIR__"npc/weishi":     4,
__DIR__"npc/jiading":1,
]));

     setup();

}

int valid_leave(object who, string exit)
{
        int exp;
        object weishi;
        string title;
        title=who->query("title");
        exp = (int) who->query("relation_exp")*10+(int) who->query
        ("life_exp");
        if(present("jiading",this_object()) && who->query_temp("stealer")) 
             return notify_fail("家丁大喝一声：“想走没那么容易”。\n");
	if( exit != "east" )return 1;
        if(who->query("job")) return 1;
        if(who->query("bed")) return 1;
        if( !weishi=present("jiading",this_object() )) return 1;
       

        if(who->query("wenzy")) {
         tell_room(this_object(),title+RED"恭喜恭喜请进请进！"NOR);
         return 1;
          }
        weishi=present("jiading",this_object());
	if( who->query("class")=="official" )
           {
             if(exp>1200000)
              {
                 message_vision("$N微微一抱拳，对着$n恭声说道：“"+title+"大人请进。”\n",
                  weishi,who);
                 return 1;
              }else{
                 message_vision("$N微微点了点头，说道：“进去吧，不要乱走”。\n",
                  weishi,who);
                  return 1;
               }       
            }
        
            
        return notify_fail("家丁不耐烦的挥了挥手，这里是尚书府不要乱闯\n");
}



