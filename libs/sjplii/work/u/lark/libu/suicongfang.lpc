//suicongfang.c

inherit ROOM;

void create()
{
  set("short","随从房");
  set("long",@LONG
这里是吏部尚书府的随从房，里面摆放着一张长案，长案后面
坐着一个旗牌官，如果你是吏部的文官可以在这里申请(bodyguard)
随从给予自己保护(escort)。
西面是吏部的休息室.
LONG
);
  set("exits",([
     "north":__DIR__"tangyuan",
     "west":__DIR__"sleeproom",
]));
  set("objects",([
    __DIR__"npc/qipaiguan":1,
]));
	set("no_fight",1);
	set("no_steal",1);
	set("no_magic",1);
	set("NONPC",1);
  setup();
}
int valid_leave(object me,string dir)
{
	object ob;
       if(dir=="west" && present("qipai guan",environment(me)) && 
		me->query("id_type")!=3 )
	      return notify_fail("旗牌官伸手一拦，说道：“非吏部官员请回！”\n");
        return ::valid_leave(me,dir);
}

