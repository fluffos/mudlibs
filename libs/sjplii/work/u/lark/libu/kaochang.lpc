//kaochang.c

inherit ROOM;

void create()
{
  set("short","京师大考场");
  set("long",@LONG
再往里就是举世闻名的京师大考场了，这里树立着一个高大的汉
白玉牌坊上书几个金漆大字“敕立京师大考场”，每年高考的时
候这里都是严禁旁人进入的。
LONG
);
  set("exits",([
    "enter":__DIR__"kaochang2",
    "north":__DIR__"qianyuan",
   
]));
  set("objects",([
     __DIR__"npc/weishi":2,
//__DIR__"npc/shusheng":1,
]));
  setup();
 
}

int valid_leave(object who, string exit)
{
   if(exit !="enter" || present("kao pai",who)) return 1;
   if(!present("guard",this_object())) return 1;
   return notify_fail("卫士伸手拦住你：“对不起现在不是京考时间，不准入内！”\n");
}
