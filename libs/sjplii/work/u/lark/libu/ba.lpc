//street.c

inherit ROOM;

void create()
{
   set("short","吏部尚书府");
   set("long",@LONG
沿着平坦如镜的青石的大道，这里就是吏部尚书府，门口簇簇拥拥
有许多车马行人门庭若市，台阶下的石狮旁停着几顶锦轿，轿子
旁站着几个青衣家人，台阶上站着四个锦衣卫士，红木漆门上挂着块
额匾“吏部尚书张府”.
LONG);
   set("exits",([
//       "north":__DIR__" ",
//       "south":__DIR__" ",
//       "west":__DIR__"  ",
         "enter":__DIR__"damen",
]));

   set("objects",([
       __DIR__"npc/wang" :     1,
       __DIR__"npc/weishi":     4,
      
]));

     setup();

}

int valid_leave(object who, string exit)
{
        int exp;
        object weishi;
        string title;
        title=who->query("title");
        exp = (int) who->query("relation_exp")*10+(int) who->query
        ("life_exp");
        if(present("guard",this_object()) && who->query_temp("stealer")) 
             return notify_fail("卫士大喝一声：“想走没那么容易”。\n");
        if( exit != "east" )return 1;
        if(who->query("job")) return 1;
        if(who->query("bed")) return 1;
        if( !weishi=present("guard",this_object() )) return 1;
       

        if(who->query("wenzy")) {
         tell_object(who,title+"恭喜恭喜请进请进！");
         return 1;
          }
        weishi=present("guard",this_object());
        if( who->query("class")=="official" )
           {
             if(exp>1200000)
              {
                 message_vision("$N微微一抱拳，对着$n恭声说道：“"+title+"大人请进。”\n",
                  weishi,who);
                 return 1;
              }else{
                 message_vision("$N微微点了点头，说道：“进去吧，不要乱走”。\n",
                  weishi,who);
                  return 1;
               }       
            }
        
            
        return notify_fail("卫士不耐烦的挥了挥手，这里是尚书府不要乱闯\n");
}




