//huofang.c

inherit ROOM;

void create()
{
  set("short","伙房");
  set("long", @LONG
这里是举子堂的食堂，为在这里复习功课的举子们提供免费的饮
食,里面放着几十张食桌，屋里弥漫着诱人的香气不禁让人食欲
大动，如果有什么需要可以直接和仆役们要求。
LONG
);
  set("exits",([
    "west":__DIR__"juzitang2",
]));
  set("objects",([
    "/u/lark/obj/pot":1,
]));
  setup();
}

void init()
{
 add_action("do_chifan","chifan");
}

int do_chifan(string arg)
{ 
  object ob;

  if(arg)
    return notify_fail("饿了？就吃吧。(chifan)\n");
if(!this_player()->query("bed"))
   return notify_fail("这里只为举子提供伙食，你想吃白食？\n");
  message_vision("$N坐到坐前,带上了餐巾准备就餐”\n",this_player());
  write("不一会一个仆人端着一盘包子放到你的面前.好香\n");
  ob= new("/u/lark/obj/baozi");
  ob->move(this_object());
  return 1;
}  
