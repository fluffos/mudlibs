// fang.c
#include <ansi.h>
inherit NPC;

void create() {
  set_name("方恨少", ({ "fang henshao" }));
  set("long", "一个文质彬彬的书生。\n");
  set("nickname", HIM "书到用时" NOR);
  set("title", YEL "举子" NOR);
  set("age", 23);
  set("relation_exp", 30000);
  set("combat_exp", 120);
  set("life_exp", 10000);
  set("chat_chance", 5);
  set("chat_msg", ({
    "方恨少说道: 圣人说：“人之初，性本色，性相异，惜相缘。。。。。。.\n",
    "方恨少说道：的确的确，甄兄所言极是，可看这世间的是是非非不都是由于男男女女\n"
    "性性色色的冲突引起的么？\n",
    "方恨少说道：唉，说的也是呀，这人世间至情至爱，千百年来不听流转，虽然最后大多\n"
    "一场眼泪，但仍然有人乐此不疲。\n",
    "方恨少说道：总以为甄兄是个洒脱放荡的浪子，没有想到也是深情暗蕴呀。能令甄兄如此神魂颠倒\n"
    "的一定是一位大大的美女\n",
    "方恨少说道：。。。。。甄兄原来是单相思呀。。。。。。\n"
    "何人能解相思苦，杯酒独酌寂夜长。。。\n",
    "方恨少说道：唉！情这个字，千万年来又有谁能堪得透呢？话说回来\n"
    "甄兄既然如此又何必太过执卓呢？\n",
    "方恨少说道：。。。。。。。。。。甄兄以为这样值得么？正所谓天涯无处不芳草\n"
    "相信以甄兄的为人不难找个红颜知己吧？\n"
    "又何苦。。。。。。。。。。\n",
    "方恨少说道：。。。。。。\n"
    "浪漫在于随意挥洒，不在刻意强求，无所不在，渺不可寻，她就在你紧拥的怀抱，她却总在灯火阑珊的远方。。。\n",

  }));
  setup();

  carry_object("/obj/cloth")->wear();
}

void init() {
  object me;
  ::init();
  if (interactive(me = this_player())) call_out("doagree", 2);
}

void doagree() {
  command("nod");
  command("sigh");
}
