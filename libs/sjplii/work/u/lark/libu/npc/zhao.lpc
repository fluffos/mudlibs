//zhang.c
inherit NPC;


create() {
  set_name("赵光明", ({ "zhao guandai" }));
  set("gender", "男性");
  set("long", "据说是尚书大人表弟，因此极为信任。听说以前是江湖中人，身手不错。\n");
  set("age", 45);
  set("title", "吏部管带");
  set("combat_exp", 100000);
  set("relation_exp", 30000);
  set("life_exp", 20000);
  set("vendetta_mark", "authority");  //设置自动追杀反官府的敌人
  set("str", 25);
  set("chat_chance_combat", 15);
  set("chat_msg_combat", ({
    "不想混了吧？敢到这里来撒野？\n"
  }));
  set_skill("unarmed", 70);
  set_skill("dodge", 90);
  set_skill("sword", 100);
  set_skill("parry", 100);
  set_skill("force", 100);
  set("max_force", 4000);
  set("force", 8000);
  set("force_factor", 100);
  set_temp("apply/dammage", 70);
  set_temp("apply/defense", 110);
  set_temp("apply/attack", 80);
  setup();
  carry_object(__DIR__ "obj/qcloth")->wear();
  carry_object(__DIR__ "obj/sword")->wield();
}

void init() {
  object ob;

  ::init();
  if (interactive(ob = this_player()) && living(this_object()) && ob->query_temp("stealer")) {
    set_leader(ob);
    kill_ob(ob);
    command("say 竟然敢和官府作对？找死！");
  }
}


int accept_fight(object me) {
  object ob;
  command("heng");
  command("say 这里是什么地方你知道么撒野换个地方！\n");
  return 0;
}



void die() {
  string id;
  if (objectp(killer = query_temp("last_damage_from"))) {
    killer->set_temp("stealer", 1);

  }
  ::die();
}
