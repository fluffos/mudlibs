// zhen.c
#include <ansi.h>
inherit NPC;

void create() {
  set_name("甄知足", ({ "zhen zhizu" }));
  set("long", "一个文质彬彬的书生\n");
  set("nickname", HIC "一知半解" NOR);
  set("title", YEL "举子" NOR);
  set("age", 23);
  set("chat_chance", 5);
  set("chat_msg", ({
    "甄知足说道：这句话可真是千古至理，堪破了人与人间相处的真谛。\n",
    "甄知足说道：方兄过奖了，在下何以克当，见笑见笑了，在下也只不过是凡尘中人。\n"
    "身在五行之内，又怎么能脱的开那些风花雪月的故事呢？\n",
    "甄知足说道：也许会有眼泪，事物的存在又怎么能没有动人的一面呢？花前月下，似水清眸，\n"
    "她每一次笑容，每一声叹息，在我心中刻下的痕迹都需要用我的一生来品味。。。。\n"
    "甄知足说道：。。。。。不怕你笑话我和她还是素未谋面。。。。。。。。\n",
    "甄知足说道：其实相思苦，苦的并非相思，而是那一丝飘摇不定的柔情，零落在风中\n"
    "却找不到落脚。\n",
    "甄知足说道：执卓并非勉强自己，我从不苛求，对于自己对于别人，都是如此。刻意的追求\n"
    "只能抹杀这温柔情怀里最朦胧美好的情节，与其那样还不如安分自己波动的心，静静的面对\n"
    "窗外斜隐的暮日夕阳，告诉自己我愿意在你的温柔里耐心的等待下一个日出。\n",
    "甄知足说道：人的一生也许会有多种境遇，但能留在记忆那深处的又有多少呢？一个奇迹\n"
    "那是她的出现，风中轻舞的衣裙，飞扬的长发都是我生命最初的迷惘，既然老天安排了这样一个浪漫\n"
    "即便终将面对惨淡的风雨我又怎么能自怨自艾？更何况她无所不在的温柔已经是我血液里\n"
    "新的浪漫生机，激动我拨开前路的阴霾，最终能拥有的是她那妩媚灿烂的笑。。。。。。\n",
  }));
  setup();

  carry_object("/obj/cloth")->wear();
}

void init() {
  object me;
  ::init();
  if (interactive(me = this_player())) call_out("dosign", 1);
}

void dosign() {
  command("sigh");
  command("say 盈盈一水间，脉脉不得语\n");
}
