// wang.c
#include <ansi.h>
inherit NPC;
inherit F_MASTER;
int do_job();
int do_permit();
int do_into();
void create()
{
        set_name("王师爷", ({"wang shiye", "wang"}) );
        set("title", "吏部管带");
        set("gender", "男性");
        set("long", "吏部的门卫管带，负责通报和接待如果你想晋见尚书大人或是找份差事要找他。");
        set("age", 56);
	set("student_title","官员");
	create_family("朝廷",7,"官员");
                
        set("vendetta_mark", "authority");//设置自动追杀反官府的敌人
        set("attitude", "friendly");
        set("combat_exp", 20000);
        
        set_skill("unarmed", 20);
        set_skill("dodge", 20);
        set("inquiry", ([
           "赶考"   : (:do_permit:),
           "晋见"  : (:do_into:),
           "差事"  : (:do_job:),
]) );
        setup();
        carry_object(__DIR__"obj/qcloth")->wear();
}
void attempt_apprentice(object me)
{
 	if( !me->query("class"))
	{
//	command("smile");
	command("say 很好！朝廷正在用人之时，努力吧！\n");
        command("recruit " + me->query("id") );
	}
	else
	{
	command("say 朝廷不需要你这种不三不四，来历不明之人！\n");
	return;
	}
	if(me->query("id_type") == 4)
	{
	command("say 你已经是兵部的武将了！\n");
	}
	if(me->query("id_type") == 5)
	{
	command("say 你已经是刑部的官员了！\n");
	}
}

void recruit_apprentice(object ob)
{
        if( ::recruit_apprentice(ob) )
                ob->set("class", "official");
		ob->set("vendetta_mark", "authority");
                ob->set("id_type", 3);
                ob->set("title", "吏部书童");
}

int do_job()
{
   write("王师爷笑了笑要想在官府里混口饭吃可不容易呀，这人面上的事么。。。。。。。\n");
   this_player()->set_temp("askjob",1);
   return 1;
}


int do_permit()
{

         string name;
         name=this_player()->query("name");
         if( this_player()->query("bed") ){
          write("王师爷笑眯眯地说: " + name+"举子请进！你已经交够钱了！\n");
           return 1;
           }
         if(this_player()->query("class")=="official"){
             write("王师爷一作揖，说：“大人，举子堂只接受没有得到功名的布衣”\n");
              return 1;
           }

         write("王师爷笑嘻嘻的看着你：“这里是你希望的起点，只要三两黄金，就可以一直住到大考!”\n");
         this_player()->set_temp("askbed",1);
         return 1;
}

int do_into()
{
   if(this_player()->query("id_type")==3){
             write("王师爷一作揖，说：“大人，请进请进！”\n");
              return 1;
           }
   write("王师爷奸笑了一声，低着头嘟嘟囔囔：“最近手头真紧，昨天泡窑子又欠了四十两银子。。。。”,一边有意无意的看着你.\n");
   this_player()->set_temp("askin",1);
   return 1;
}

int accept_object(object who, object ob)
{
   int som;
   object where;
   where=find_object("/u/lark/libu/street"); 
 
   som = ob->value();
   if(who->query("relation_exp") < 200000 )
   who->add("relation_exp",som/1000);
   if(who->query("life_exp") < 5000 )
   who->add("life_exp",random(500));
   if(who->query_temp("askjob")){
    if(som<200)
       return notify_fail("你打发叫花子呢？\n");
    message_vision("王师爷笑了笑：“好说好说，现在秘书房正缺人手，来人呀！\n",who);
   tell_room(where,"从门里走出了个家丁\n");
   
   message_vision("王师爷说道：“带他去见杨总管！”.\n",who);
   message_vision("家丁点了点头，带着$N匆匆进门去了.\n",who);
   where=find_object("/u/lark/libu/mishufang"); 
  
   
   who->move(where);
   tell_room(where,"家丁带着一个人从外面匆匆进来，鞠了个躬，又匆匆离开了。\n");
   
   return 1; 
   }
   if(who->query_temp("askbed")){
   if(som<30000) 
    return notify_fail("王师爷笑了笑:谢谢谢谢，这点钱刚够今天晚上买个咸菜下酒！说完转过头，冷哼一声：穷鬼，想白住？\n");
   message_vision("王师爷对着$N谀笑着：“恭祝举子金榜题名！进门往北走就是举子堂！不要乱闯哦”，\n",who);
   who->set("title",YEL"举子"NOR);
   who->set("bed",1);
   return 1;
   }
   if(who->query_temp("askin")){
   if(som<4000)
    return notify_fail("虽然说有钱能使鬼推磨，但是看来这个鬼的口袋比较大些，呵呵！四十两看来是不能不舍得的!\n");
   message_vision("王师爷笑了笑：“好说好说，不过尚书大人很忙，有什么事情可以找田总管。来人呀！\n",who);
   tell_room("/u/lark/libu/street","从门里走出了个家丁\n");
   
   message_vision("王师爷说道：“带他去见田总管！”.\n",who);
   message_vision("家丁点了点头，带着$N匆匆进门去了.\n",who);
   where=find_object("/u/lark/libu/zongguanfang");
   
  
   who->move(where);
   tell_room(where,"家丁带着一个人从外面匆匆进来，鞠了个躬，又匆匆离开了。\n");
   
   return 1;
   }
  tell_object(who,"王师爷感激道：“多谢多谢！大人真是慷慨为人”\n");
  return 1;
}


void init()
{
        object ob;

        ::init();
        if( interactive(ob = this_player()) && living(this_object()) &&  ob->query_temp("stealer")) {
         set_leader(ob);                
         kill_ob(ob);
         command("say 竟然敢和官府作对？找死！");
        }
}


void die()
{
        string id;
        if( objectp(killer = query_temp("last_damage_from")) ){ 
                killer->set_temp("stealer",1);
                
        }
        ::die();
}


