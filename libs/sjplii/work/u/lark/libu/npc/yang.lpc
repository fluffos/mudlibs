// yang.c
inherit NPC;
string do_fire();
string do_hire();
void create() {
  set_name("杨师爷", ({ "yang shiye" }));
  set("long", "吏部尚书府的秘书房总管，细致而谨慎。\n");
  set("title", "吏部总管");
  set("gender", "男性");
  set("age", 54);
  set("vendetta_mark", "authority");  //设置自动追杀反官府的敌人
  set("attitude", "friendly");
  set("food", 500);
  set("water", 500);
  set("str", 20);
  set("per", 20);
  set("con", 20);
  set("int", 20);
  set("cps", 20);
  set("inquiry", ([
    "job": (: do_hire :),
    "工作": (: do_hire :),
    "不想干了": (: do_fire :),

  ]));
  set_temp("combat_exp", 200000);
  set_temp("apply/attack", 100);
  set_temp("apply/defense", 100);
  set_temp("apply/damage", 30);
  set_temp("apply/armor", 40);

  set_skill("dodge", 100);
  set_skill("unarmed", 100);
  set_skill("parry", 100);
  set_skill("sword", 100);


  setup();
}

string do_hire() {
  int exp;
  exp = (int)this_player()->query("relation_exp") * 10 + (int)this_player()->query("life_exp");

  if (exp > 128000)
    return "杨师爷诚惶诚恐的作了个揖\n"
      "我怎么敢使唤大人呢？\n";




  if ((int)this_player()->query_skill("literate", 1) < 50)
    return "杨师爷抬头看看你\n\n"
      "摇了摇头对不住我们这里需要的是文笔好的人来帮忙进行抄写工作。\n"
      "不需要老农民。\n"
      "说完连头都不抬了\n";
  this_player()->set("job", 1);
  this_player()->set("times", 0);
  return "杨师爷点了点头\n\n"
    "把你上上下下打量了一番, 想了一会儿,\n"
    "说道: 好的好的，正好我们这里缺少一些抄写员。\n"
    "你就在这里帮帮忙吧。\n"
    "不过我们这里是政府机关薪水低点，工作累点。\n"
    "桌子上面有纸\n"
    "抄完(copy)后给我送来，抄一份一两银子\n";
}

int accept_object(object who, object ob) {
  int x, n, good, aver, wux, lit;
  n = (int)who->query("times");

  x = random(3);
  if (!living(this_object()))
    return 0;

  if (!who->query("job"))
    return notify_fail("你并没有在吏部申请工作\n");

  if (who->query("finish") && ob->query("name") == "吏部文件") {
    if (x = 0) {
      message_vision("$N仔细看了看$n递上的文件，满意的笑道：“不错不错，相当工整”.\n", this_object(), who);
      who->set("finish", 0);
      who->improve_skill(
        "literate",
        random((int)who->query("int") + (int)who->query_skill("literate") / 10)
      );
      n = n + 1;
      who->set("times", n);

    } else if (x = 1) {
      message_vision("$N仔细看了看$n递上的文件，点了点头：“还可以，继续努力吧。”\n", this_object(), who);
      who->improve_skill("literate", random((int)who->query("int")));
      n = n + 1;
      who->set("finish", 0);
      who->set("times", n);
    } else if (x = 2) {
      message_vision("$N仔细看了看$n递上的文件，皱了皱眉头，怒然道：“你会不会写字？画的这叫什么东西？给我重写!”\n", this_player(), who);
    }
    return 1;
  } else return 0;
}

string do_fire() {
  int n;
  if (!this_player()->query("job"))
    return "你没有在这里申请工作!\n";

  n = (int)this_player()->query("times");
  this_player()->add("life_exp", n * 2);
  this_player()->add("potential", n / 2);
  add_money("silver", n);
  command("give silver to " + this_player()->query("id"));
  this_player()->delete("job");
  this_player()->delete("finish");
  this_player()->delete("times");
  return "点了点头说道：“干的不错，这是你的薪水”\n";
}
