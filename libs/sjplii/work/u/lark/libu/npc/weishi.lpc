#include <ansi.h>

inherit NPC;

void create() {
  set_name("锦衣卫士", ({ "guard" }));
  set("long", "一个壮实的汉子，目不斜视的站在那里,看样子不好对付。\n");
  set("attitude", "heroism");
  set("title", "吏部");
  set("str", 27);
  set("cor", 26);
  set("cps", 25);
  set("vendetta_mark", "authority");  //设置自动追杀反官府的敌人
  set("combat_exp", 20000);

  set_skill("unarmed", 40);
  set_skill("sword", 120);
  set_skill("parry", 140);
  set_skill("dodge", 140);
  set_skill("move", 100);
  set_skill("force", 100);

  set_temp("apply/dammage", 20);
  set_temp("apply/defense", 30);
  set_temp("apply/attack", 30);

  setup();

  carry_object(__DIR__ "obj/jinyi")->wear();
  carry_object(__DIR__ "obj/sword")->wield();
}

void init() {
  object ob;

  ::init();
  if (interactive(ob = this_player()) && living(this_object()) && ob->query_temp("stealer")) {
    set_leader(ob);
    kill_ob(ob);
    command("say 竟然敢和官府作对？找死！");
  }
}




void revive() {
  command("say 竟然晕了？");
  command("heng");
  command("say 别再来招惹我，要不然。。。hehe!");
  ::revive();
}

void die() {
  string id;
  if (objectp(killer = query_temp("last_damage_from"))) {
    killer->set_temp("stealer", 1);

  }
  ::die();
}
