// goushi.c

inherit ITEM;
inherit F_FOOD;

void create() {
  set_name("什锦炒饭", ({ "rice" }));
  set_weight(1);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long",
      "一碗香喷喷的什锦炒饭.\n");
    set("unit", "碗");
    set("value", 15);
    set("food_remaining", 40);
    set("food_supply", 60);
  }
}
