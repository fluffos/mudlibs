// letter.c

#include <armor.h>

inherit ITEM;

void create()
{
        set_name("一封家书",({ "letter" }) );
        set("long",@TEXT
              慈
              母
              亲
              启   
                       不
                       肖
                       儿
                       凉
                       秋
                       叩
                       首
TEXT
            );

        set_weight(10);
        if( clonep() )
                set_default_object(__FILE__);
        else 
                set("unit", "封");
                set("value",10);
        setup();
}

void init()
{
    add_action("do_open", "open");
}

int do_open(string arg)
{
  if(arg = "letter")
    tell_object(this_player(),
          "看来你无法把它打开。\n");
  return 1;
}

