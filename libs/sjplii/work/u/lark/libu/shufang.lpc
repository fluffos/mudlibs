//shufang.c
#include <ansi.h>
inherit ROOM;
void improve(object me);
void create() {
  set("short", "砺书斋");
  set("long", @LONG
这里是举子堂中的“砺书斋”,是为举子们提供的读书场所，屋
内整整齐齐的分布着几十张书桌，上面有全套的文房四宝，靠墙
是一排排高大的书架(shelf)，举子为了能金榜高中都经常在这里闭门苦读.
LONG
  );
  set("exits", ([
    "east": __DIR__ "juzitang2",
  ]));
  set("objects", ([
    __DIR__ "npc/shusheng2": 1,
    __DIR__ "npc/shusheng3": 1,
  ]));
  set("item_desc", ([
    "书架": @TEXT
"读书破万卷，提笔成文章"，只有熟读圣人书才能，作出好文章，
这里为举子们准备了齐全的书籍，以便举子们随时翻阅。
上面摆放着：
  〈诗〉(shi)，〈礼〉(li)，〈易〉(yi)，〈春秋〉(chunqiu)
  〈论语〉(lunyu)，〈中庸〉(zhongyong)，〈大学〉(daxue)
        
TEXT
  ]));
  setup();
}

void init() {
  add_action("do_get", "getdown");

  if (present("fang henshao", this_object()) && present("zhen zhizu", this_object())) {
    tell_object(this_player(), WHT "走进书斋，你听到了一阵读书声，然后似乎有人不知在讨论着什么，过去听听(listening)？\n" NOR);
    add_action("do_listening", "listening");
  }

}

int do_get(string arg) {
  string from;
  object me;
  me = this_player();
  if (sscanf(arg, "%s from %s", arg, from) == 2
    && arg
    && from == "shelf") {
    if (arg != "shi" && arg != "li" && arg != "yi" && arg != "chunqiu" && arg != "lunyu" && arg != "zhongyong" && arg != "daxue")
      return notify_fail("书架上面没有这本书\n");
    message_vision("$N从书架上拿下一本书.\n", this_player());
    if (arg == "shi")
      __DIR__ "obj/shi"->move(me);
    if (arg == "li")
      __DIR__ "obj/li"->move(me);
    if (arg == "yi")
      __DIR__ "obj/yi"->move(me);
    if (arg == "chunqiu")
      __DIR__ "obj/chunqiu"->move(me);
    if (arg == "lunyu")
      __DIR__ "obj/lunyu"->move(me);
    if (arg == "zhongyong")
      __DIR__ "obj/zhongyong"->move(me);
    if (arg == "daxue")
      __DIR__ "obj/daxue"->move(me);
    return 1;
  } else
    return notify_fail("你要拿什么?\n");
}

int do_listening(string arg) {
  int n;
  (int)n = 600 / this_player()->query_skill("literate", 1);
  if (!arg || arg != "讨论")
    return notify_fail("听什么？\n");

  if (!present("fang henshao", this_object()) || !present("zhen zhizu", this_object()))
    return notify_fail("你静静的听着朗朗的读书声。。。不禁想起：呀！要考试了我也得复习去了\n");
  tell_object(this_player(), "你坐下来静静的旁听他们的讨论....\n");
  if ((int)this_player()->query_skill("literate", 1) < 80)
    return notify_fail(WHT "他们在说些什么我怎么听不懂呀？\n" NOR);
  if ((int)this_player()->query_skill("literate", 1) > 95)
    return notify_fail(WHT "这个还用急痴白脸的争来争去，你们还不如回家去种地\n" NOR);
  if (this_player()->query("sen") < 30 || this_player()->query("gin") < 30)
    return notify_fail("你脑袋都大了，什么也听不进去．\n");
  remove_call_out("improve");
  call_out("improve", n + 10, this_player());
  this_player()->start_busy(n);

  return 1;
}

int valid_leave(object who, string exit) {
  if (present("shi", who) || present("yi", who)
    || present("li", who) || present("chunqiu", who)
    || present("lunyu", who) || present("zhongyong", who)
    || present("daxue", who))
    return notify_fail("你不能把书带离书房\n");
  return 1;
}

void improve(object me) {
  me->improve_skill(
    "literate",
    random((int)me->query("int") + (int)me->query_skill("literate", 1) / 10)
  );
  write(WHT "原来如此．原来如此，读书人的脑子里琢磨的都是这些东东呀\n");
  me->add("gin", -20);
  me->add("sen", -20);
}
