//ROOM:/u/changan/binbu/jiashan.c

inherit ROOM;

void create() {
  set("short", "湖中假山");
  set("long", @LONG
这里是湖中的假山,是用太湖石堆砌起来的,看样子已经很有年头了,
靠近水面的地方都已经被波浪打磨的十分光华,这上面光秃秃的
似乎没有什么东西.沉浸在薄薄的水雾中,好象如临仙境,一切都
那么不真实.
LONG
  );
  set("outdoors", "changan");
  set("item_desc", ([
    "太湖石": "太湖石以奇险突兀著称,自古以来都是园林石景最常材料.
这里的石材显然已经经历时久,表面上都附着着一层青苔而浑然一体,
仔细看了看突然发现,靠左边有块圆石与周围的接缝似乎不是十分严密.\n",
  ]));
  setup();

}

void init() {
  add_action("do_jump", ({ "jump" }));
  add_action("do_move", ({ "move" }));
}

int do_jump(string arg) {
  object ob;
  if (!arg) return notify_fail("没什么事你蹦什么蹦?\n");
  if (arg != "睡莲") return notify_fail("要跳到什么上面呢?\n");
  if ((int)this_player()->query_skill("dodge") < 150) {
    write("想自杀么,也不选个好地方,死在这里你不杀风景么?俗人!\n");
    return 1;
  }
  message_vision("$N轻轻一跃,脚尖点在湖中的睡莲上,身形展开,几个起落到了对面的岸上.\n", this_player());
  this_player()->move(__DIR__ "yardb");
  message(
    "vision",
    this_player()->name() + "轻轻一闪身,几个起落就跳了过来.\n",
    environment(this_player()),
    this_player()
  );
  return 1;
}

int do_move(string arg) {
  if (!arg) return notify_fail("你要移动什么?\n");
  if (arg != "圆石") return notify_fail("你是干什么的搬运工,看见什么运什么?\n");
  tell_object(this_player(), "你使劲推了推圆石.\n");
  if ((int)this_player()->query("max_force") < 1000 && (int)this_player()->query_skill("unarmed") < 100) return notify_fail("结果纹丝没动.\n");
  message_vision("圆石一下子移开了了个缝隙.刚好可以容许一个人通过.\n", this_player());
  set("exits/down", __DIR__ "mishi");
  tell_room(__DIR__ "mishi", "有人从外面打开了石门\n");
  call_out("close_passage", 3);
  return 1;
}
void close_passage() {
  remove_call_out("close_passage");
  delete("exits/down");
  tell_room(__FILE__, "轰的一声,圆石又恢复到原位\n");
  return;
}
