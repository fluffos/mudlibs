// literate.c

#include <ansi.h>

inherit SKILL;

string type() { return "knowledge"; }

void skill_improved(object me)
{
        int s;

        s = me->query_skill("qidao", 1);
        if((int)me->query("tol") < s/5) {
                tell_object(me, HIW "通过对棋道的修习，你的气量提高了。\n" NOR);
                me->add("tol", 1);
        }
        if((int)me->query("cps") < s/5) {
                tell_object(me, HIW "通过对棋道的修习，你的定力提高了。\n" NOR);
                me->add("cps", 1);
        }


}

int learn_bonus()
{
        return 20;
}
int practice_bonus()
{
        return 0;
}
int black_white_ness()
{
        return 0;
}

