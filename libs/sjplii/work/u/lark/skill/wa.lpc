int valid_enable(string usage) { return (usage == "dodge") || (usage == "move"); }

int valid_learn(object me)
{
    if(me->query("class")!="xiaoyao")
       return notify_fail("凌波微步是逍遥派绝学不传授于别门弟子\n");
    if( (int)me->query("max_force") < 200 )
        return notify_fail("你的内力修为太浅，没有办法练凌波微步。\n");
    if( (int)me->query("spi") < 20 )
        return notify_fail("你的灵性不够，没有办法学习凌波微步。\n");

        return 1;
}

mapping query_action(object me, object weapon)
{
        int zhaoshu;
        int i, level,bm_lev ;
        string xuewei;
        object target;
        target = offensive_target(me);
/*
        string* name = ({HIC "「讼位」" NOR, HIC "「井位」" NOR,HIC "「无妄」" NOR,HIC "「家人」" NOR,HIC "「明夷」" NOR, HIC "「既济」" NOR,HIC"「蛊位」" NOR,"「泰位」",HIC "「中孚」" NOR,HIC "「坤位」" NOR,HIC "「壬癸」" NOR,HIC "「妗母」" NOR,HIC "「亥活」" NOR});
*/
//         xuewei=name[random(sizeof(name))];
        level   = (int) target->query_skill("wave_steps",1);
        bm_lev  =(int) target->query_skill("bm_force",1);
        for(i = sizeof(action); i > 0; i--){
                if(level > action[i-1]["lvl"])
                if(random(bm_lev)> 50){
                //if(wizardp(target))
                 //tell_object(target,bm_lev);
                tell_object(target,BLU "你的北冥真气应运而生,生生流转不熄,气血渐渐恢复充盈\n" NOR);
                target->receive_heal("kee",level);
                }
                if((random(level)>50)){
               // if(wizardp(target))
               //  tell_object(target,level);
   message_vision(HIC "$N轻点方位,身形飘渺如一股轻烟,围绕$n衔枚急走,却无迹可寻,$n顿时不知所措\n" NOR,me,target);
                    me->set_temp("guarding", 1);
                }            
                    
//        action[random(i)][action] = replace_string(action[random(i)]["action"],"MSG",xuewei);
               return action[random(i)];
        }
}
string query_dodge_msg(string limb)
{
        object me, ob;
        string msg,place;
        int i, level;
        mapping action;
        string* name = ({HIC "「讼位」" NOR, HIC "「井位」" NOR,HIC "「无妄」" NOR,HIC "「家人」" NOR,HIC "「明夷」" NOR, HIC "「既济」" NOR,HIC"「蛊位」" NOR,"「泰位」",HIC "「中孚」" NOR,HIC "「坤位」" NOR,HIC "「壬癸」" NOR,HIC "「妗母」" NOR,HIC "「亥活」" NOR});
        me = this_player();
        
        action = query_action(me, ob); 
        msg = action["action"];

        place = name[random(sizeof(name))];
        msg = replace_string(msg,"MSG",place);      
        return msg;
}

object offensive_target(object me)
{
        int sz;
        object *enemy;

        enemy = me->query_enemy();
        if( !enemy || !arrayp(enemy) ) return 0;

        sz = sizeof(enemy);
        if( sz > 4 ) sz = 4;

        if( sz > 0 ) return enemy[random(sz)];
        else return 0;

}

