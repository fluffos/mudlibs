int practice_skill(object me)
{
    int lb,dg;
    lb=(int)me->query_skill("wave_step",1);
    if( (int)me->query("kee") <=30 )
        return notify_fail("你的气太少了，不能练凌波微步。\n");
     if( (int)me->query("spi") < 30 )
        return notify_fail("你的灵性不够，没有办法练习凌波微步。\n");

    me->receive_damage("kee", 30);
        dg = me->query_skill("dodge",1)- me->query_skill("wave_step",1);
        if(me->query_learn("wave_step") > (lb+1)*(lb+1)+10 && dg<=0 ) return 0;
    me->add("force",lb/2);
    if( (int)me->query("force") > (int)me->query("max_force") * 2) {
        if( (int)me->query("max_force") <
                        ((int)me->query_skill("force", 1) + me->query_skill("force")/5) * 10 ) {
            write("你的内力提高了。\n");
                        me->add("max_force", 1);
                }
                me->set("force", me->query("max_force"));
        }       

        return 1;
}
string perform_action_file(string action)
{
        return CLASS_D("xiaoyao") + "/wave_steps/" + action;
}
int effective_level() { return 25;}

