#include <ansi.h>

inherit SSERVER;
int exert(object me, object target) {
  int bm, ob_dodge, damage;

  string dodskill;
  if (!target) target = offensive_target(me);
  bm = me->query_skill("bm_force", 1);
  ob_dodge = target->query_skill("dodge", 1);
  if ((int)me->query_skill("bm_force", 1) < 120)
    return notify_fail("你的北冥神功修为不够。\n");
  if ((int)me->query("bellicosity") > 100)
    return notify_fail("你的杀机太甚，不能体会逍遥自在的意境。\n");

  dodskill = (string)me->query_skill_mapped("dodge");
  if (dodskill != "wave_steps" || (int)me->query_skill("wave_steps", 1) < 80)
    return notify_fail("需要凌波微步身法的配和！\n");
  if (environment(me)->query("no_fight"))
    return notify_fail("这里禁止战斗。\n");



  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要对谁施展？\n");

  if ((int)target->query("force") == 0)
    return notify_fail("对方内息已经相当微弱，不可能在吸取什么了.\n");
  me->receive_damage("sen", 10);
  me->receive_damage("kee", 30);
  me->start_busy(5);

  tell_object(me, "你轻舒手臂手指按向敌人的「檀中穴」\n");
  message_vision(
    HIW "$N左手拇指急探，遥遥按向$n的「檀中穴」\n" NOR, me, target);


  if (random(me->query("combat_exp")) >
    (int)target->query("combat_exp") * 3 / 5
    || target->is_busy()) {
    if (random(bm + ob_dodge) < ob_dodge / 2) {
      message_vision(
        HIM "结果被$n闪开了。\n" NOR, me, target);
      target->kill_ob(me);
      return 0;
    }
    damage = bm - ((int)target->query("force") / 30) - ((int)target->query_skill("force") / 2);
    if (damage < 0) return notify_fail("你潜心运功但似乎没有吸收到什么。\n");
    if ((int)me->query("force") < (int)target->query("force")) {
      tell_object(me,
        HIM "受到对方深厚内力的吸引，你突然感到内力倒涌而出，不禁大骇收回了手指。 \n");
      message_vision(
        HIM "$N脸色突变，顿时涨的通红，身躯微震，手指忙不迭的收了回来。\n" NOR, me, target);


      me->add("force", -damage);
      me->add("max_force", -damage / 5);
      target->add("force", damage);
      target->add("max_force", damage / 5);
      me->receive_damage("gin", damage / 5);
      me->receive_wound("gin", damage / 5);
      me->receive_wound("sen", damage / 5);
      me->receive_damage("sen", damage / 5);
      return 1;
    }
    if (bm < 200) {
      target->add("force", -damage);
      target->add("force", -damage / 10);
      target->receive_damage("gin", damage);
      target->receive_wound("gin", damage / 10);
      target->receive_wound("sen", damage / 10);
      target->receive_damage("sen", damage / 10);
      me->add("force", damage);
    } else {
      target->add("force", -damage);
      target->add("max_force", -damage / 5);
      me->add("force", damage);
      me->add("max_force", damage / 5);
      target->receive_damage("gin", damage / 5);
      target->receive_wound("gin", damage / 5);
      target->receive_wound("sen", damage / 5);
      target->receive_damage("sen", damage / 5);
    }

    if (damage > 0) {
      tell_object(target, "你觉得突然手臂突然一阵酸软。\n");
      tell_room(environment(me), target->query("name") +
        "满脸通红，摇摇晃晃地神情突显萎靡\n", target, target);
      target->start_busy(5);
    } else {
      tell_object(target, "你突然觉得感觉内力外泄，急忙抱元守一护住元神。\n");
      tell_room(environment(me), target->query("name") +
        "脸上显出一丝萎靡但随即一震恢复了精神。\n", target, target);
      target->start_busy(1);
    }

  }


  if (userp(target)) target->kill_ob(me);
  else if (!target->is_killing(me)) target->kill_ob(me);



  return 1;
}
