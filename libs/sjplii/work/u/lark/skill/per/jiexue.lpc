//凌虚解穴
#include <ansi.h>

inherit SSERVER;
int perform(object me, object target) {
  string msg;

  string xuewei, dodskill;
  string *name = ({
    "「天突穴」",
    "「廉泉穴」",
    "「承浆穴」",
    "「鱼府穴」",
    "「孔最穴」",
    "「天府穴」",
    "「侠白穴」",
    "「中府穴」",
    "「经渠穴」",
    "「尺泽穴」",
    "「大渊穴」",
    "「云门穴」",
    "「环跳穴」",
    "「肩井穴」",
    "「百汇穴」",
    "「列缺穴」",
    "「玉枕穴」",
    "「偏历穴",
    "「神门穴」",
    "「灵道穴」",
    "「少海穴」",
    "「少府穴」",
    "「通理穴」"
  });
  xuewei = name[random(sizeof(name))];


  dodskill = (string)me->query_skill_mapped("dodge");
  if (dodskill != "wave_steps" || (int)me->query_skill("wave_steps") < 70)
    return notify_fail("需要凌波微步身法的配和！\n");


  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你想对谁施展？？\n");
  if ((int)me->query("force") < 100)
    return notify_fail("你的内力不够，没有办法「凌虚解穴」。\n");

  if (!target) target = offensive_target(me);

  if ((int)me->query_skill("fy_finger", 1) <= 150)
    return notify_fail("你的「浮月流云指」还不够精纯，不能「凌虚解穴」。\n");
  if ((int)me->query_skill("bm_force") < 50)
    return notify_fail("你的「北冥神功」火候不够.\n");
  if (!target->is_busy())
    return notify_fail(target->name() + "并没有被封住穴道！\n");

  message_vision(HIW "$N对着$n遥遥点出一指,一股深厚的内劲破指而出,施展出了「凌虚解穴」\n" NOR, me, target);
  msg = HIW "$N衣袖轻拂，指尖迅疾点了$n的" + xuewei;
  msg += "\n$n只觉浑身一震，被封闭的穴道登时解开了。\n" NOR;
  message_vision(msg, me, target);
  target->start_busy(1); me->add("force", -100);
  return 1;
}
