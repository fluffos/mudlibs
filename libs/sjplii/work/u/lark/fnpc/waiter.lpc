// boaer.c

inherit NPC;
inherit F_VENDOR;


void create()
{
        set_name("茶官", ({"waiter"}) );
        set("long", "一个呆头呆脑的小茶官\n");
        
        set("age", 13);
        set("max_kee", 800);
        set("max_force", 1000);
        set("force_factor", 1);
        set("water", 600);
        set("food", 600);
        set_skill("unarmed", 20);
        set_skill("dodge", 20);
        set_skill("force", 20);
        set_temp("apply/attack", 10);
        set_temp("apply/defense", 10);
        set("combat_exp", 3400);
        set("vendor_goods", ([
         "/d/city/obj/food/jitui": 40,
        "/d/city/obj/food/baozi":40 ,
        "/d/city/obj/food/wuxianghuasheng" : 100,
        "/d/city/obj/food/kaoji"  :40 , 
         "/d/city/obj/food/jiunang":60
]) );
        setup();
         carry_object("/obj/cloth")->wear();


}


void init()
{
        add_action("do_vendor_list", "list");
}

int accept_fight(object ob)
{
  return 1;
}

