// dizi.c

inherit NPC;

void create()
{
        set_name("行脚商",({ "xingjiao shang","shang"}));
        set("gender", "男性" );
        set("age", 25);
        set("str", 20);
        set("cor", 30);
        set("cps", 27);
        set("per", 27);
        set("int", 10);

        set("attitude", "friendly");

        set("max_force", 1000);
        set("force", 1000);
       
        set("water", 400);
        set("food", 400);
        set("score",1000);
        set("combat_exp", 7000);
        
        set_skill("unarmed", 20);
        
        set_skill("dodge", 70);
        set_skill("force", 70);
        
        
        

        set_skill("parry", 70);
        set_skill("unarmed", 70);

     

        setup();
        carry_object("/obj/cloth")->wear();
        
}


