// hjiaren.c
#include <ansi.h>
inherit NPC;


void do_permit();
create()
{
        set_name("行人", ({"xingren"}) );
        set("gender", "男性");
        set("long", "一个路上的行人\n");
        set("age", 34);
        set("attitude", "friendly");
        set("combat_exp", 2000);
        set("score",200);
        set_skill("parry",18);
        set_skill("unarmed", 18);
        set_skill("dodge", 18);
        set("chat_chance", 10);
        set("chat_msg", ({
                (:random_move :)
        }) );

        setup();
        carry_object("/obj/cloth");
}

int accept_fight(object ob)
{
  return 1;
}

