// hjiaren.c
#include <ansi.h>
inherit NPC;


void do_permit();
create()
{
        set_name("脚夫", ({"jiao fu", "jiao"}) );
        set("gender", "男性");
        set("long", "他是一个为人背货物的劳苦大众\n");
        set("age", 25);
        set("attitude", "friendly");
        set("combat_exp", 2500);
        set("score",300);
        set_skill("unarmed", 10);
        set_skill("dodge", 10);
        
        set_temp("apply/dammage", 5);
        set_temp("apply/dodge", 5);
        set_temp("apply/defense", 5);
        setup();
        carry_object("/obj/cloth");
}

int accept_fight(object ob)
{
  return 1;
}
