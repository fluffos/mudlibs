// hjiaren.c
#include <ansi.h>
inherit NPC;


void do_permit();
create()
{
        set_name("苦力", ({"kuli"}) );
        set("gender", "男性");
        set("long", "一个卖苦力的结实小伙子\n");
        set("age", 24);
        set("attitude", "friendly");
        set("combat_exp", 5000);
        set("score",400);
        set_skill("parry",40);
        set_skill("unarmed", 40);
        set_skill("dodge", 40);
        setup();
        carry_object("/obj/cloth");
}

int accept_fight(object ob)
{
  return 1;
}
