// gaolao.c

inherit NPC;
void create()
{
        set_name("居民", ({"man"}));
        set("long", "小镇上的居民\n");
        set("age", 20);
        set("chat_chance", 2);
        set("combat_exp",1000);
        set("chat_msg", ({
        "居民低声说：“这宅子里面的人可真奇怪。”\n",
        "居民点了点头，：“说的也是自从搬过来，一直也不见出来一次，真的够怪的。\n",
        
}) );
         set("inquiry", ([
        "宅子"      :  "居民作了个揖道：“这间宅子一年前被个外乡人买下,但自从搬进去后就很少露面了\n"
                       "和左右的邻居也没有任何联系，当真很怪。。。。。\n",
        ]));    



       setup();
        carry_object("/obj/cloth")->wear();
}


