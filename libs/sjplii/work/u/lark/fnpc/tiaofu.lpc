// hjiaren.c
#include <ansi.h>
inherit NPC;


void do_permit();
create()
{
        set_name("挑夫", ({"tiao fu","fu"}) );
        set("gender", "男性");
        set("long", "一个为人挑东西的苦力\n");
        set("age", 34);
        set("str",19);
        set("cps",10);
        set("con",30);
        set("attitude", "friendly");
        set("combat_exp", 4000);
        set("score",200);
        set_skill("parry",20);
        set_skill("unarmed", 20);
        set_skill("dodge", 20);
        setup();
        carry_object("/obj/cloth");
}

int accept_fight(object ob)
{
  return 1;
}

