// hjiaren.c
#include <ansi.h>
inherit NPC;


void do_permit();
create()
{
        set_name("公子哥", ({"gongzi ge","ge"}) );
        set("gender", "男性");
        set("long", "一眼就能看出来，他酒色过度了。\n");
        set("age", 34);
        set("attitude", "friendly");
        set("combat_exp", 2300);
        set("score",200);
        set_skill("parry",12);
        set_skill("unarmed", 12);
        set_skill("dodge", 12);
        set("chat_chance", 15);
        set("chat_msg", ({
"好妹妹我来了哦",
(:command("grin"):),
        }) );

        setup();
        carry_object("/obj/cloth");
}

int accept_fight(object ob)
{
  return 1;
}

