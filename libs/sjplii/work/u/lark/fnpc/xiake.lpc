// boaer.c

inherit NPC;
inherit F_VENDOR;


void create()
{
        set_name("侠客", ({"xiake","xia"}) );
        set("long", "一个行走江湖的侠客，满脸正气。\n");
        
        set("age", 27);
        set("max_kee", 1000);
        set("max_force", 1000);
        set("force_factor", 3);
        set("water", 600);
        set("food", 600);
        set_skill("sword",90);
        set_skill("unarmed", 90);
        set_skill("dodge", 90);
        set_skill("force", 90);
        
        set("combat_exp", 50000);
 set("chat_chance", 3);

        set("chat_msg", ({
                "行走江湖最重要的就是一个义字。\n",
          }) );
        setup();
         carry_object("/obj/cloth")->wear();
         carry_object("/obj/weapon/sword")->wield();

}


int accept_fight(object ob)
{
  return 1;
}

