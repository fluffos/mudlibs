inherit ROOM;

void create() {
  set("short", "沁梅园");
  set("long", @LONG
拐过湖畔的假山,一个小巧的月牙门跃入眼帘,其上四个
石刻的篆字:沁梅园.乃是尚书府的后花园.从里面泛出了阵阵
若有若无的芳香.
LONG
  );
  set("outdoors", "changan");
  set("exits", ([
    "southeast": __DIR__ "raya",
    "southwest": __DIR__ "yardb",
    "enter": __DIR__ "garden",
  ]));
  setup();
}
