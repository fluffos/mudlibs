//saux.c

#include <ansi.h>
inherit NPC;
inherit F_MASTER;
int dizi();
int canguan();
int perform();
void create()
{
        set_name("韩江雪", ({ "saux", "han","master han","master" }) );
        set("long",
                "韩江雪是逍遥派的五师兄,脸上总是带着可爱的笑容。\n");
        set("nickname", HIW "月下孤舟 雪落惊涟"NOR);
        set("attitude", "friendly");
        
        create_family("逍遥派",12,"弟子");
        set("title", "五师兄");
        set("str", 18);
        set("int", 30);
        set("cor", 20);
        set("spi", 30);
        set("agi", 20);
        set("per", 30);
        set("max_kee", 800);
        set("max_gin", 800);
        set("max_sen", 800);
        set("kee", 800);
        set("gin", 800);
        set("sen", 800);
        set("force", 1000);
        set("max_force", 1000);
        set("force_factor", 10);
        set("score", 90000);
        set_temp("time3",0);
        set_temp("apply/attack", 30);
        set_temp("apply/defense", 30);
        set_temp("apply/move", 30);

        set("chat_chance_combat", 50);
        set("chat_msg_combat", ({
             
             (: perform_action, "sword.losther" :),
             
             (: perform_action, "dodge.walk" :),
                
        }) );
        set("combat_exp", 3000000);
        set("relation_exp", 90000);     //设置人际关系
        set("life_exp", 50000);         //设置江湖阅历
        set("inquiry", ([
          "学艺":(:dizi:),
//          "参观":(:canguan:),
          "绝技":(:perform:),
]) );

        
        set_skill("unarmed",60);
        set_skill("force",200);
        set_skill("parry", 200);
        set_skill("dodge", 200);
        set_skill("bm_force", 200);
        set_skill("gaoge_sword", 250);
        set_skill("sword",250);
        set_skill("wave_steps", 200);

        map_skill("force", "bm_force");
        map_skill("sword", "gaoge_sword");
        map_skill("parry", "gaoge_sword");
        map_skill("dodge", "wave_steps");
        set_skill("move", 100);
        set_skill("literate",150);
        
        setup();

       carry_object(__DIR__"obj/sauxsword")->wield();
       carry_object("/obj/cloth")->wear();
}


void init()
{ 
  tell_object(this_player(),"韩江雪望着平原上流动的紫色，脸上神情浮动不已\n");
  tell_object(this_player(),"好久好久，韩江雪一声长叹：“巧巧。。你还好么？\n");
}

int accept_object(object who, object ob)
{
   object ling;
   if(ob->query("name")=="紫丁香"){
   if(who->query_temp("nina")){
  
   command("thank"+who->query("id"));
   command("say 你见到过巧巧了？她。。。。好么？\n");
   command("say 最近大师哥老是督促我们练功，哎。。一直脱不开。。好想她。。\n");
   command("blush");
   write("韩江雪一副迷乱的神情。。。好长时间，突然想起什么似的回过神来。\n");
   command("xixi");
   command("say 你来这里也不容易吧？有什么事情呀？\n");
   who->set_temp("permit",1);
   return 1;
   }else{
   command("ah");
   command("sigh");
   command("say 原来你也是赏花之人，可惜我却不是配花之人。。。。。\n");
   command("sigh");
   command("say 可巧巧她。。。。。\n");
   return 1;
 }
 }
 
  if(ob->query("name")=="黄金")
  {
     string id;
     id=this_player()->query("name");
     if(this_player()->query("class")=="xiaoyao")
     {
       command("sigh");
       command("say 这是你的如意令不要乱丢哦？是本门弟子的信物。\n");
       ling=new(__DIR__"obj/yupei");
       ling->set("owner",id);
       ling->move(this_player());
     return 1;
     }
  }
      

 return notify_fail("韩江雪急忙摆了摆手：客气了，在下怎么能接受您的东西？\n");
}

int canguan()
{
string id;
object pai;
int shijian;
int time2;
time2=query_temp("time3");
if(this_player()->query("class")=="xiaoyao"&&this_player()->query("combat_exp")>=300000)
  { 
     if(time()-time2>=300)
    {
       set_temp("time3",time());
       pai=new(__DIR__"obj/pai");
       pai->set("shijian",time());
       pai->move(this_player());
       command("say 好吧，参观牌拿去给你的朋友用。");
     }
     else
      command("say 参观牌刚给人拿去了，新的还未做好！");
       return 1;
   }
else 
  command("say 本门重地，不欢迎参观。");
return 1;
}

int dizi()
{
     object ling;
     string id;
     id=this_player()->query("name");
   if(this_player()->query_temp("permit")){
       if(this_player()->query("int")<10 || this_player()->query("spi")<10 ){
         command("sigh");
         command("say 虽然挺想和你亲近亲近的，可是本门收徒条件严格，特别讲究悟性和灵性。。。\n");
         command("sorry"+this_player()->query("id") );
         return 1;
        }    
       if(this_player()->query("bellicosity")>100)
        {
        command("hmm");
        command("say 本门武功讲究飘洒自然，你杀气这么重不会有什么成就的。\n");
        return 1;  
         }
      
      command("consider");
      command("say 虽然。。。。。。。\n");
      command("nod");
      command("smile");
      command("say 好吧，但是我最近很忙的，你先去和檀香子学些入门工夫吧，以后我再指点你\n");
      this_player()->set_temp("permit2",1);
           
      return 1;  
      }
  command("hmm");
  command("say 大师哥说过不让随便接受新弟子的，对不起呀。");
  return 1;
}

 



void attempt_apprentice(object me)
{
      
       if(this_player()->query("class")=="xiaoyao" || this_player()->query_temp("permit2")==1){
          
        if( this_player()->query("combat_exp")<50000){
        command("shake");
        command("say 你还是先和檀香子学些基本工夫吧.\n");
         return;
         }
        command(":P");
        this_player()->set("class","xiaoyao");
        command("say 别那么严肃的，以后有什么不懂的来问我好了啦\n");
        command("recruit " + me->query("id") );
        return;
        }
       command("hmm");
       command("say 大师哥说过不让随便接受新弟子的，对不起呀。");
}




int accept_fight(object me) // 接受玩家fight时调用
{
if(me->query("class")=="xiaoyao" ) {
command("say 好啊！练练手也好。");
return 1;
}
command("say 高师哥以前交代过不让随便出手");
return 0;
}

int perform()
{
   if(this_player()->query("class")!="xiaoyao")
       return notify_fail("韩江雪摇头道:阁下似乎并非是我逍遥门下,恕我不能传授");
   if(this_player()->query_skill("wave_steps",1)<50){
     command("shake");
     command("say 你的凌波微步火候显然不够呀,你先回去练习一下吧.");
     return 0; 
     }
   if(this_player()->query_skill("gaoge_sword",1)<50){
     command("shake");
     command("say 你的高歌剑法还不够纯熟呀,容易误伤自己的,不能教你");
     return 0;
    }
   this_player()->set("saux",1);
   command("nod");
   command("say 这一招威力很大,以后不到必要的时候千万不要乱用哦.");
   
   message_vision("韩江雪在$N的耳边轻声嘀咕了两句,手中比画了一些什么,$N连连点头似乎明白了些什么"
   "露出会心的微笑\n",this_player());

   return 1;
}

