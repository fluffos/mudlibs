#include <ansi.h>
string reward_more( object who);

inherit NPC;
void create()
{

         set_name("逍遥弟子",({ "xiaoyao dizi","dizi"}));
        set("long", "这是一位武当弟子，专门担任保护之责。\n");
        set("attitude", "friendly");
        set("max_atman", 100);
        set("atman", 100);
        set("max_mana", 100);
        set("mana", 100);

        set("str", 10);
        set("cor", 30);
        set("cps", 25);
         set("chat_chance", 2);
        set("chat_msg", ({
           "弟子练一遍拳法似乎略有增长。\n",
}) );
        set("combat_exp", 90000);
     set("food",3000)
;
     set("water",3000)
;
        set_skill("sword", 30);
        set_skill("parry", 30);
        set_skill("dodge", 30);
        set_skill("unarmed", 30);
        set_skill("force", 30);

        
        set("chat_chance", 10);
        set("chat_msg", ({
                (:random_move :)
        }) );
        set("chat_chance_combat", 50);
        set("chat_msg_combat", ({
                (: reward_more(this_object()) :),
        }) );
        setup();
//        carry_object("/obj/longsword")->wield();
        carry_object("/obj/cloth")->wear();
}

string reward_more(object who)
{
        int i;
        object *enemy;
        seteuid(getuid());
        enemy = who->query_enemy();
        i = sizeof(enemy);
        while(i--) {
                if( enemy[i] && living(enemy[i]) ) {
                        if( enemy[i]->query("combat_exp") > 90000 ) return "1";
                        enemy[i]->add("combat_exp", 1);
                        if( enemy[i]->query("potential") > 900 ) return "1";
                        enemy[i]->add("potential", 1);
                }
        }
        return "1";
}
int accept_fight(object me)
{
        return 1;
}

