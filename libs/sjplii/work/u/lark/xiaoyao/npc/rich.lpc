
inherit NPC;
 
void create()
{
        set_name("钱多多", ({ "rich manager","rich"}) );
	set("title", "落月山庄财院总管" );
        set("gender", "男性" );
        set("age", 42);
        set("long", "钱多多是一个精明无比的管家，理财好手。\n");
        set("combat_exp",20000);
	set("attitude", "friendly");


	set("inquiry", ([
		"买房" : "您要买房子呀？先花五两银子买本《购房指南》吧。",
		"买房子" : "您要买房子呀？先花五两银子买本《购房指南》吧。",
	]) );

        set_skill("unarmed",70);
	set_skill("literate",100);
        set_skill("dodge", 70);
        set_skill("force",70);        


        set("force", 500);
        set("max_force", 500);
     
        setup();
//        carry_object("/u/jakey/obj/baicloth1")->wear();
}

int accept_object(object me,object ob)
{
	object book;
	string file = resolve_path("/u/jakey/player", this_player()->query("id")) + ".lpc";

	if (ob->value() == 500) {
		write("钱多多给了你一本书。\n");
		book=new("/u/jakey/special/buyroombook.lpc");
		book->move(this_player());
		return 1;}

	if (ob->value() == 500000) 
		if (file_size(file) == -1) {write("钱多多奇怪的看了你一眼：“你没有房子拆什么？”\n");return 0;}
	else {	write("你确定要拆除自己的房屋？[y/n]\n");
		if (input_to("delete_room_file",file) == 1) return 1;
		return 0;}

//	if (ob->value() < 10000000) {
//		command("say 买房子需要一千两黄金，少一分也不行。");
//		return 0;}

	if( file_size(file)!=-1 ) {
		command("say 你已经有房子了，怎么还买？");
		return 0;}

	message_vision("钱多多站起来对$N笑了笑，说道：“请这边走，去您的新房。”\n",this_player());
	message_vision("钱多多领着$N向外离开。\n",this_player());

	seteuid(geteuid(this_player()));
	
	write_file(file, @ROOM_CODE

inherit ROOM;

string *special_props = ({
	"short", "long" });

int save_room_file(string yn, string file, string str);

void create()
{
	set("short", "空房间");
	set("long", "这里是一间空房间。\n");
	set("exits", ([
	"out" : "/u/jakey/zhuangyuan.lpc",
	]));

	set("valid_startroom",1);

	setup();
}

void init()
{
	add_action("do_set", "setroom");
	add_action("do_additem",  "additem");
	add_action("do_delitem",  "delitem");
	add_action("do_saveroom", "saveroom");
}

int do_set(string arg)
{
	string prop, str;
	mixed data;

	if( !arg || sscanf(arg, "%s %s", prop, str)!=2 )
		return notify_fail("指令格式：setroom <房间属性> <属性内容>\n");

	if( sscanf(str, "%d", data)!=1 )
		data = str;
	if( strlen(str)!=1 ) data = str;

//	if (prop=="short") environment(this_player())->set(prop, data);
//	else environment(this_player())->set(prop, data+"\n");
	environment(this_player())->set(prop, data);
	write("Ok.\n");
	return 1;
}

int do_additem(string arg)
{
	mapping items;
	string item, desc;

	if( !arg || sscanf(arg, "%s %s", item, desc)!=2 )
		return notify_fail("指令格式：additem <景物名称> <景物描述>\n");
	items = environment(this_player())->query("item_desc");
	desc += "\n";
	if( mapp(items) )
		items[item] = desc;
	else
		environment(this_player())->set("item_desc", ([ item: desc ]) );
	write("Ok.\n");
	return 1;
}
int do_delitem(string arg)
{
	object me;
	mapping items;
	string item, desc;
	me = this_player();
	if( !arg || sscanf(arg, "%s", item)!=1 )
		return notify_fail("指令格式：delitem <景物名称> \n");
	items = environment(me)->query("item_desc");
	printf("删除景物：%s\n",item);
	if( mapp(items) && environment(me)->query("item_desc/" + item) ) {
		environment(me)->delete("item_desc/" + item);
		write("Ok.\n"); }
	else printf("没有这个景物。\n");
	return 1;
}

int do_saveroom(string arg)
{
	object env;
	string str, *name, file;
	mapping prop;
	int i;

	env = environment(this_player());
	file = file_name(env) + ".lpc";

	str = sprintf("inherit ROOM;\n");
	str += sprintf("void create()\n{\n");
	str += sprintf("\tset(\"short\", %O);\n", env->query("short") );
	str += sprintf("\tset(\"long\", @LONG\n%sLONG\n\t);\n", env->query("long") );
	prop = env->query_entire_dbase();
	name = keys(prop);
	for(i=0; i<sizeof(name); i++) {
		if( member_array(name[i], special_props)!=-1 ) continue;
		str += sprintf("\tset(\"%s\", %O);\n", name[i], prop[name[i]] );
	}
	str += "\n\tsetup();\n";
       if(!mapp(env->query("item_desc"))) str += "\treplace_program(ROOM);";
       str += "\n}\n";

	i = strlen(file)-1;
	while( (i > 0) && (file[i]!='/')) i--;
	if( i>0 ) {
		str = replace_string(str, "\"" + file[0..i], "__DIR__\"");
	}

	if( file_size(file)!=-1 ) {
		write("你确定设计房屋完成？[y/n]\n");
		input_to("save_room_file", file, str);
		return 1;
	}

	return save_room_file("y", file, str);
}

int save_room_file(string yn, string file, string str)
{
	object obj,*inv,npc;
	int i;
	if( strlen(yn)<1 || yn[0]!='y' ) return 1;

	rm(file);
	write("保存房屋设计。\n");
	if( write_file(file, str) ) {
		write("Ok.\n");

	this_player()->move("/u/jakey/zhuangyuan");
	if (obj = find_object(file)) {
		if( obj==environment(this_player()) ) {
			inv = all_inventory(obj);
			i = sizeof(inv);
			while(i--)
				if( userp(inv[i]) ) {
					inv[i]->set_temp("last_location", file);
					inv[i]->move(VOID_OB, 1);
				}
				else inv[i] = 0;
		}
		destruct(obj);
	}

	obj = load_object(file);
	i = sizeof(inv);
	while(i--) if( inv[i] && userp(inv[i]) ) inv[i]->move(obj, 1);
	
	return 1;
	} else
		return notify_fail("你没有修改这个房屋的权力。\n");

}

int valid_leave(object me,string dir)
{
	if (dir=="out") return notify_fail("你的房屋还没有设计好，怎么能离开？\n如果已经设计好了，请用\"saveroom\"命令保存。\n");
}


ROOM_CODE);
	
	this_player()->move("/u/jakey/player/"+this_player()->query("id"));
	tell_room("/u/jakey/player/"+this_player()->query("id"),"钱多多说到：“就是这间房子了，把钱拿来。”\n");	
	return 1;
}

int delete_room_file(string yn,string file)
{
	if( strlen(yn)<1 || yn[0]!='y' ) return 0;
	rm (file);
	return 1;
}

