#include <ansi.h>
inherit NPC;
void improve(object who);
void create() {
  set_name(HIW "奶牛" NOR, ({ "cow" }));
  set("race", "野兽");
  set("attitude", "peaceful");
  set("age", 1);
  set("str", 5);
  set("long", "一只温顺的奶牛，在静静的吃草。\n");

  set("limbs", ({ "头部", "身体", "尾巴" }));
  set("verbs", ({ "bite" }));
  set("chat_chance", 30);
  set("chat_msg", ({
    "哞。。。。。哞。。。。。\n",
  }));

  set("combat_exp", 1000);
  set_skill("dodge", 50);
  set_skill("unarmed", 5);
  setup();
}

void init() {
  add_action("do_ji", "ji");
}

int do_ji(string arg) {
  object ob;

  if (!arg)
    return notify_fail("挤牛奶?(ji milk)\n");
  if (this_player()->query_temp("xiaoyao/quest") != 3)
    return notify_fail("想喝牛奶到厨房有呀，何必麻烦？\n");
  if (this_player()->query_temp("xiaoyao/over"))
    return notify_fail("别假积极了。\n");
  if (this_player()->query_temp("xiaoyao/busy"))
    return notify_fail(RED "一个字: 急!\n" NOR);
  if (this_player()->query_temp("xiaoyao/num") >= random(5) + 5) {
    write(WHT "总算挤满了一桶，你擦了擦额头的汗水，该收工了！\n" NOR);
    message_vision("$N直起身子摸摸有些酸痛的腰，擦了擦额头的汗水，收工了  !\n", this_player());
    ob = new(__DIR__ "obj/milk");
    ob->move(this_player());
    this_player()->delete_temp("xiaoyao/busy");
    this_player()->delete_temp("xiaoyao/num");
    this_player()->set_temp("ok", 1);
    return 1;
  }

  message_vision("$N蹲到奶牛旁边开始挤牛奶，手指轻柔而节奏的用力看来很有经验 .\n", this_player());
  write("看着牛奶在你的手指间流过，你知道没有什么事情是可以轻易办到的。这种挤 的勇气才是成功的根本\n");
  message_vision(HIW "$N放声歌道：“天苍苍，野茫茫，风吹草低见牛羊。。。。” \n" NOR, this_player());
  remove_call_out("improve");
  call_out("improve", 1, this_player());
  this_player()->start_busy(1);
  return 1;
}

void improve(object who) {

  if (!who) return;
  if (who->query_skill("unarmed", 1) < 200)
    who->improve_skill("unarmed", random((int)who->query("int")));
  who->add("sen", -(25 - (int)who->query_skill("unarmed", 1) / 10));
  who->add("gin", -(25 - (int)who->query_skill("unarmed", 1) / 10));

  who->add_temp("xiaoyao/num", 1);
  who->set_temp("xiaoyao/busy", 0);
}
