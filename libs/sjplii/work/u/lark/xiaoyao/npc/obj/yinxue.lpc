// sword.c : an example weapon

#include <ansi.h>
#include <weapon.h>
inherit SWORD;
void create()
{
      set_name(HIR "饮血" NOR,({"yin xue","jian","sword"}));
      set("long",
"一把鲜红的血剑。据说是幽冥血奴遗留下来的宝剑，不知饮过多少剑客的鲜血。 \n");
        set_weight(5000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
        set("unit","把");
        set("value",20000);
        set("rigidity",30);
        set("material", "steel");
        }

        init_sword(30);

        set("wield_msg",HIR "$N阴险的一笑，缓缓从腰间抽出一把通红的长剑，顿时感到血光逼人。\n" NOR);
        set("unwield_msg",HIR "$N看着剑身上的鲜血慢慢渗入剑身，长叹一声，将$N插入腰间。\n" NOR);
        
        setup();
}
void init()
{
        add_action("do_kill","kill");
}
int do_kill()
{
        int i,c_kill,n,base,current,j;
         object ob,me;
        me=this_player();
        ob=this_object();
         c_kill=this_player()->query("MKS");
         base= (int)ob->query("base_damage");
         current = (int) ob->query("weapon_prop/damage");
         for(j=1;j<=c_kill;j++)
        {
                base = base + j;
                if(base >= current) break;
        }
               ob->add("weapon_prop/damage",j);
        ob->set("weight",(int)ob->query("weight")+j*100);
        ob->add("rigidity",j*10);
        me->add("bellicosity",j*10);

        me->add("weapon"+ob->query("weaponsmnum")+"/damage",j);
        me->add("weapon"+ob->query("weaponsmnum")+"/weight",j*10);
        me->add("weapon"+ob->query("weaponsmnum")+"/rigidity",j*2);
        reload_object( ob );
        ob->move(me);
//        n=this_object()->query("init_sword");
//       init_sword(n+c_kill);
        
         return 0;

        }

        
