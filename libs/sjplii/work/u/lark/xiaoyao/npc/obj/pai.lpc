//pai.c

#include <ansi.h>


inherit ITEM;

void create()
{
        set_name(HIC "参观牌" NOR,({ "canguanpai" }) );
        
        set("long",
                "乃是一块木牌，上刻“同意参观”\n");
        set_weight(10);
   
        set("unit", "块");
        set("value",0);
        setup();
}








