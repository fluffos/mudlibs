// girl.c



inherit NPC;

int do_make();

void create()

{

        set_name("青锋子", ({ "qing fengzi", "qing"}) );

        set("gender", "男性" );

        set("age", 35);

        set("str", 26);

        set("cor", 24);

        set("cps", 11);

        set("per", 27);

        set("int", 27);

        set("score",30000);



        set("max_force", 500);

        set("force", 500);

        set("force_factor", 5);



        set("long",     "逍遥的弟子的兵器全都是出自他手"

"如果你想要见适合自己的趁手长剑，可以让他帮你打一把\n"

);

        set("inquiry", ([

          "打造":(:do_make:),

]) );

        set("combat_exp", 2000000);

        set("chat_chance", 2);

        set("chat_msg",  ({

                "青锋子从炉火上拿下烧的通红的长剑，往水里一插刷。。的一声冒出了一阵白烟。\n"

})  );

        set("chat_chance_combat", 60);

        set("chat_msg_combat", ({

                

                (: perform_action, "sword.losther" :),

        }) );



        set_skill("unarmed", 80);

        set_skill("parry", 120);

        set_skill("dodge", 80);

        set_skill("sword", 100);

        set_skill("force", 80);

        set_skill("literate", 80);



        set_skill("gaoge_sword", 100);

        set_skill("ymei_strike", 60);

        set_skill("wave_steps", 80);

       



        map_skill("unarmed", "ymei_strike");

        map_skill("sword", "gaoge_sword");

        map_skill("parry", "gaoge_sword");

        map_skill("dodge", "wave_steps");



        setup();



        

        carry_object("/obj/cloth")->wear();

}



int do_make()

{ 

  object ob;

  string name;

  name=this_player()->query("name");

  if(this_player()->query("class")!="xiaoyao"){

    command("say 我只为逍遥弟子做兵器，你还是到别处去吧\n");

    return 1;

   }

   if(present("peijian",this_player())){

     command("hmm");

     command("say 爱人只能有一个要爱护她直到不能再爱护她为止\n");

     return 1;

     }

  command("nod");

  command("say 剑器通神，只有象爱护爱人一样爱护她才能剑出无回。\n");

  ob=new(__DIR__"obj/sword");

  message_vision("青锋子边说边打，一会就打出了一柄精光闪闪的长剑。\n",this_object());

  command("say 剑器通神，只有象爱护爱人一样爱护她才能剑出无回.\n");

  message_vision("$N拿起一柄小锥趁热在剑身上刻了些什么.\n",this_object());

  command("say 以后这就是你的佩剑了，好好爱护她吧。\n");

  ob->set("owner",name);

  ob->move(this_player());

  return 1;

}







void init()

{

        ::init();
    add_action("do_kill", ({"kill"}));

    if(this_player()->query("class")=="xiaoyao")

    command("say 有没有趁手的家伙？用不用打一把？\n");

        

}



int accept_fight(object ob)

{

  object book; 

  if(ob->query("class")!="xiaoyao")

        return notify_fail("对不起我已经很久不和别人动手了\n");

  if(!present("sword",this_player()) && !present("peijian",this_player())){

      command("shake");

      command("say 剑术才是一切武学的灵魂\n");

      return 0;

      }

     if( query("fight/"+ob->query("id")) < 10 ){

                        ob=new(__DIR__"obj/sword");

                         ob->move(this_object());

                        command("say 好！出招吧！");

                        message_vision("$N从旁边的木架上随手拿起一柄长剑\n",this_object());

                        command("wield peijian");

                        set("force_factor", 0);

                        add("fight/"+ob->query("id"), 1);

                        COMBAT_D->do_attack( this_object(), ob);

                say("\n青锋子点了点头，说道：很好，这是第一招....\n\n");
                COMBAT_D->do_attack(this_object(), this_player(), 
query_temp("weapon"));
                if( (int)this_player()->query("kee") < 0 
                || !present(this_player(), environment())) {
                        
say("青锋子叹了口气，说道：连第一招都撑不过，真是自不量力....\n");
                        return 1;
