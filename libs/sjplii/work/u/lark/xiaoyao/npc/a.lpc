int dokill(string arg
    object weapon
    if(!this_object()->id(arg))return 0
    message_vision("\n$N对著$n喝道：「"
                + RANK_D->query_rude(this_object()
                   + "！今日不是你死就是我活！」\n\n", this_player(), this_object())
    command("heng")
    set("force_factor", 10)
    if( !weapon = present("peijian", this_object()))
        weapon=new(__DIR__"obj/sword")
        weapon->move(this_object())
       message_vision("$N从旁边的木架上随手拿起一柄长剑，冷笑道：“找死!”\n",this_object());
       command("wield peijian")
     }   
  
    this_object()->kill_ob(this_player())
    this_player()->kill_ob(this_object())
    return 1
