//saux.c

#include <ansi.h>
inherit NPC;
inherit F_MASTER;
int dizi();
void create() {
  set_name("秦断弦", ({ "qdx", "qin", "master qin", "master" }));
  set("long",
    "秦断弦是逍遥派的三师兄,生性平和与世无争\n");
  set("nickname", HIC "落叶飞花 淡然清平" NOR);
  set("attitude", "friendly");

  create_family("逍遥派", 12, "弟子");
  set("title", "三师兄");
  set("str", 35);
  set("int", 30);
  set("cor", 20);
  set("spi", 30);
  set("agi", 20);
  set("per", 30);
  set("max_kee", 1000);
  set("max_gin", 1000);
  set("max_sen", 1000);
  set("kee", 1000);
  set("gin", 1000);
  set("sen", 1000);
  set("force", 2000);
  set("max_force", 2000);
  set("force_factor", 50);
  set("score", 90000);
  set_temp("apply/attack", 50);
  set_temp("apply/defense", 50);
  set_temp("apply/move", 50);

  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({

    (: perform_action, "unarmed.wdd" :),
    (: perform_action, "unarmed.dianxue" :),
    (: perform_action, "dodge.walk" :),

  }));
  set("combat_exp", 5000000);
  set("relation_exp", 90000);     //设置人际关系
  set("life_exp", 50000);         //设置江湖阅历
  set_skill("music", 200);

  set_skill("unarmed", 250);
  set_skill("force", 200);
  set_skill("parry", 250);
  set_skill("dodge", 160);
  set_skill("bm_force", 200);
  set_skill("gaoge_sword", 80);
  set_skill("sword", 80);
  set_skill("wave_steps", 200);
  set_skill("fy_finger", 250);
  map_skill("force", "bm_force");
  map_skill("unarmed", "fy_finger");
  map_skill("parry", "fy_finger");
  map_skill("dodge", "wave_steps");
  set_skill("move", 100);
  set_skill("literate", 200);
  //        set("inquiry", ([
  //          "请教":(:dizi:),
  //]) );

  setup();


  carry_object("obj/cloth")->wear();
}




int accept_fight(object me)  // 接受玩家fight时调用
{
  if ((string)me->query("family/family_name") == "逍遥派") {
    command("say 好啊！练练手也好。");
    return 1;
  }
  command("smile");
  command("shake");
  return 0;
}


void attempt_apprentice(object me) {

  if (this_player()->query("class") == "xiaoyao") {

    if (this_player()->query("combat_exp") < 50000) {
      command("shake");
      command("say 你还是先和檀香子学些基本工夫吧.\n");
      return;
    }
    command("smile");
    command("say 习武要形神兼背，乐理的培养也是对练功有很大帮助的哦\n");
    command("say 并非舍本逐末之说，记住呀\n");
    command("recruit " + me->query("id"));
    me->set("class", "xiaoyao");
    me->set("id_type", 1);
    return;
  }
  command("hmm");
  command("say 大师哥说过不让随便接受新弟子的，对不起呀。");
}
