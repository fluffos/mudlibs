//pig.c

inherit NPC;

void create()
{
  set_name("猪", ({ "pig"}) );
  set("long","你吃的什锦炒饭里的肉丁的出处。\n");
  set("attitude", "friendly");
  set("race", "野兽");
  set("gender","雌性");
  set("combat_exp",300);
  set("str", 10);
  set("int", 30);
  set("cor", 10);
  set("spi", 10);
  set("agi", 10);
  set("per", 30);
  set("limbs", ({ "头部", "身体", "尾巴" }) );
        set("verbs", ({ "bite" }) );
       set("chat_chance", 2);
        set("chat_msg", ({
           "猪一边在泥里打滚一边酣畅的叫着：^$^$#(_+#%+(_&($@\n",
}) );
  setup();
}

void init()
{
  if(this_player()->query_temp("okg") && present("zhucao",this_player()))
   add_action("do_feed","feed");
}

int do_feed(string arg)
{
 object ob;
 ob=present("zhucao",this_player()); 
if(this_player()->query_temp("over"))
    return notify_fail("别假积极了。\n"); 
if(!arg)
    return notify_fail("要喂猪么？(feed pig)\n");
  command(":)..");
  message_vision("$N从背后的竹筐里，拿出刚割下的猪草，开始喂猪,不一会就喂光了.\n",this_player());
  command("touch");
  write("猪轻轻地捧起你的脸，给了你一个无限温柔的吻。\n");
  destruct(ob);
  this_player()->delete_temp("okg");
  this_player()->set_temp("over",1);
  return 1;
}
