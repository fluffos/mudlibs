// laofuren.c

inherit NPC;

void create()
{
        set_name("老妇人",({ "lao furen","furen"}));
        set("gender", "女性" );
        set("age", 65);
        set("str", 20);
        set("cor", 30);
        set("cps", 27);
        set("per", 27);
        set("int", 10);

        set("attitude", "friendly");
        set("chat_chance", 2);
        set("chat_msg", ({
        "老妇人低声叹了口气。\n",
        "老妇人嘟囔道：“凉秋这孩子呀。出去这么长时间也不给家来个消息。。。。”\n",
        }) );
        set("inquiry", ([
        "凉秋"      :  "凉秋是我家的儿子呀。哎。。。三年前不辞而别到现在\n"
                       "也没有个音信。。哎。。。你见过他么？\n",
        ]));    
 
        set("water", 400);
        set("food", 400);
        set("score",1000);
        set("combat_exp", 1000);
        
        setup();
        carry_object("/obj/cloth")->wear();
        
}

int accept_object(object me, object ob)
{
  
 object jian;
 jian=new("/u/lark/npc/obj/larksword");
 if(ob->query("name")!="一封家书") return 0;
  command("ah");
  message_vision("老妇人用颤抖的双手打开信签，仔细的看了起来\n",me);
  command("sigh");
  command("say 凉秋这孩子就是喜欢些个孔子孟子什么的。一点也不象他爸爸。。。\n");
  command("say 他爸的一番心思看来只有落空了\n");
  command("sigh");
  command("nod");
  command("say 算了人各有志，就随他去吧。恩。。。。。。\n");
  tell_object(me,"老妇人慈祥的看着你:“凉秋在信上说你和他结拜了把兄弟,恩。。。凉秋这孩子眼光一向很高，你也一定是个好孩子\n");
  tell_object(me,"老妇人拍了拍你的头：“好孩子以后就把这里当自己家吧。”\n");
  command("consider");
  tell_object(me,"老妇人说：“当年凉秋他爸留下了一柄宝剑，告诉我等凉秋张大了凭着它到京里兵部去找一个路大人\n");
  tell_object(me,"老妇人接着说：“他爸说路大人是他的生死至交，见到宝剑一定会帮助凉秋的。”\n");
  message_vision("老妇人从中堂上取下宝剑\n",me);
  tell_object(me,"老妇人轻拂着宝剑，说：“以后你也算是我的孩子了，这柄宝剑你拿了去吧。”\n");
  jian->move(me);
  command("say 以后见到凉秋要告诉他注意身体呀，希望他能早点回来\n");
  command("sigh");
  return 1;
}
