#include <ansi.h>
inherit NPC;
void create()
{       set_name(HIW "小绵羊" NOR, ({ "sheep" }) );
        set("race", "野兽");
        set("age", 5);
        set("long", "一只全身雪白的的绵羊。\n");
        set("limbs", ({ "头部", "身体", "尾巴" }) );
        set("verbs", ({ "bite" }) );
        set("chat_chance", 3);
        set("chat_msg", ({
      "小绵羊吃着草原上菁菁的草，显得十分安详。\n",  
 }) );
        set_skill("dodge",100); 
       set("combat_exp", 3000);
        setup();
}

void die()
{
	string id;
	if( objectp(killer = query_temp("last_damage_from")) ){	
	if(killer->query("id")=="dog" || killer->query("id")=="wolf" ||
	killer->query("id")=="tiger")
        message_vision("小绵羊被$N刁走了\n",killer);
//      destruct(killer);
        destruct(this_object());
	return;
	}
	::die();
}
