//road.c
#include <ansi.h>
inherit ROOM;

void create() {
  set("short", "缥缈山麓");
  set("long", @LONG
这里是飘渺峰的脚下，前面生长着一片茂密的红杉林，风中针叶的撞击
声好象一阵阵波涛汹涌。树木高大而径直，看来都是建筑的好
材料。
LONG
  );
  set("exits", ([
    "westdown": __DIR__ "road1",
    "eastup": __DIR__ "fall2",
  ]));
  setup();

}

void init() {
  if (this_player()->query_temp("xiaoyao/quest") == 15)
    add_action("do_hammer", "cut");
}

int do_hammer(string arg) {
  object ob;
  if (this_player()->query_temp("xiaoyao/over"))
    return notify_fail("别假积极了。\n");

  if (!arg)
    return notify_fail("要伐木么？(cut wood)\n");
  if (this_player()->query_temp("xiaoyao/busy"))
    return notify_fail(RED "一个字: 急!\n" NOR);
  if (this_player()->query("sen") < 40 || this_player()->query("gin") < 40)
    return notify_fail(RED "你够累的了，休息一下吧!\n" NOR);
  this_player()->set_temp("xiaoyao/busy", 1);
  if (this_player()->query_temp("xiaoyao/num") >= random(5) + 10) {
    write(YEL "你擦了擦额头的汗水，该收工了！\n" NOR);
    message_vision("$N高喊了一声：红杉倒喽。。。一棵巨大的衫木应声倒下!\n", this_player());
    ob = new(__DIR__ "obj/wood");
    ob->move(this_object());
    this_player()->delete_temp("xiaoyao/num");
    this_player()->set_temp("xiaoyao/okw", 1);
    this_player()->delete_temp("xiaoyao/busy");
  }
  message_vision("$N从腰间掏出一把斧头，轮圆了往树身上砍去\n", this_player());
  write(BLU "看着渐渐深入的开口，你知道事物只有不停的努力才能达到贯通\n" NOR);
  call_out("improve", 1, this_player());
  this_player()->start_busy(1);

  return 1;
}

void improve(object who) {

  if (!who) return;
  if (who->query_skill("sword", 1) < 200)
    who->improve_skill("sword", random((int)who->query("int")));
  who->add("sen", -(35 - (int)who->query_skill("parry", 1) / 7));
  who->add("gin", -(35 - (int)who->query_skill("parry", 1) / 7));

  who->add_temp("xiaoyao/num", 1);
  who->set_temp("xiaoyao/busy", 0);
}
