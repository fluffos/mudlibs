//water
inherit ROOM;

void create() {
  set("short", "镜湖中");
  set("long", @LONG
清冽的湖水中，一条条小鱼从你身旁悠闲的游来游去，
水草在微微荡漾的水流中，婀娜多姿宛若美女纤细的
腰围。。。。。。别遐想了上去吧。
LONG
  );
  set("exits", ([
    "up": __DIR__ "fall4",
  ]));
  setup();
}

int valid_leave(object who, string exit) {
  tell_room("/u/lark/xiaoyao/fall4", "一个人湿淋淋的从湖中爬上来，好象个落汤鸡，或者是个水鬼？fear\n");
  return 1;
}
