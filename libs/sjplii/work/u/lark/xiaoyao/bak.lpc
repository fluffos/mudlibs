// dingx2.c
#include <ansi.h>
inherit ROOM;

create()
{
    set("short",MAG "紫薇平原" NOR);
    set("long", @LONG
漫步在如毯的花丛中，呼吸着沁人肺腑的香，感受这这静谧天地间或有的温柔，雾霭流动
细雨初降，花瓣上的露珠透着眩目的光，让你浑然忘物，渐渐迷失了自我和世界的存在。
LONG);
    set("exits", ([
   "north": __DIR__"dingx2",
   "east":__DIR__"dingx2",
   "south":__DIR__"dingx2",
   "northeast":__DIR__"bak",
   "southeast":__DIR__"dingx2",
   "west"     :__DIR__"dingx2",
   "northwest":__DIR__"dingx2",
   "southwest":__DIR__"dingx2",
]) );
    
    setup();
}

void init()
{
        object who;
      who=this_player();
      add_action("do_north","gon");
      add_action("do_southeast","gose");
     
      if(who->query_temp("nt")==5 && who->query_temp("set")==2){
      if(who->query("class")=="xiaoyao" || who->query_temp("nina") || random(who->query("kar"))>18){
       who->delete_temp("nt");
       
       who->delete_temp("set");        
       who->move(__DIR__"road");
         return;
       }else{
      write(MAG "远方的山峦似远似近，可好象是永远无法得到的爱情那样不可企及\n" NOR);
       }
      }   
     
}


int do_north()
{
   tell_object(this_player(),"你往北走了一里\n");
this_player()->add_temp("nt",1);
   return 1;    
}   

int do_southeast()
{
 tell_object(this_player(),"你往东南走了一里\n"); 
this_player()->add_temp("set",1);
 return 1;    
}

