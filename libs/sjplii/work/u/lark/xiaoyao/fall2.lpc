//road.c
#include <ansi.h>
inherit ROOM;

void create() {
  set("short", "缥缈山麓");
  set("long", @LONG
这里是飘渺峰的脚下，树林内阴暗潮湿，厚厚的针叶扑满地面走起来
很有似乎弹性。树下是密密的草丛，这样的地方大概很适合菌类
的生长。
LONG
  );
  set("exits", ([
    "westdown": __DIR__ "fall",
    "eastup": __DIR__ "fall3",
  ]));
  set("outdoors", "changan");
  setup();

}

void init() {
  add_action("do_bo", "bo");
}

int do_bo(string arg) {
  int x, n;
  object ob, me, where;
  x = random(7);
  where = this_object();
  me = this_player();
  if (arg)
    return notify_fail("要拨开草丛？(bo)\n");
  message_vision("$N拨开草丛似乎在寻找什么\n", this_player());
  if (where->query_temp("num") > 6) {
    tell_room(where, "好象什么也没有\n");
    return 1;
  }

  if (x == 1) {
    message_vision("$N发现了一棵可爱的蘑菇，不禁欣喜若狂!\n", me);
    ob = new(__DIR__ "obj/mogu");
    message_vision("$N小心翼翼的把蘑菇拣了起来\n", me);
    ob->move(me);
    where->add_temp("num", 1);
    return 1;
  }
  if (x == 2) {
    tell_room(where, "突然从草丛里窜出一条蛇来\n");
    ob = new("/u/baiwt/xueshan/xsnpc/snake");
    ob->move(where);
    ob->kill_ob(me);
    where->add_temp("num", 1);
    return 1;
  }
  if (x == 3) {
    tell_room(where, "突然一只鹿受惊从林子跑出来\n");
    ob = new("/u/baiwt/xueshan/npc/lu");
    ob->move(where);
    ob->kill_ob(me);
    where->add_temp("num", 1);
    return 1;
  }
  if (x == 4) {
    tell_room(where, "天那！狼!\n");
    ob = new("/u/baiwt/xueshan/xsnpc/wolf");
    ob->move(where);
    ob->kill_ob(me);
    where->add_temp("num", 1);
    return 1;
  } else {
    tell_room(where, "好象什么也没有\n");
    return 1;
  }
}
