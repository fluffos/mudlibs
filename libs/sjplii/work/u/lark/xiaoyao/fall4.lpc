//room:lake.c
#include <ansi.h>
inherit ROOM;
void get(object who);
void create()
{
 set("short",HIC "镜湖" NOR);
 set("long",@LONG
一块巨石横亘在涓细的溪流上，本来湍急的水流遇到了阻碍，也慢慢缓了下来。
形成了一个小小的湖泊。湖水清澈透明，群群快乐的鱼儿自由的穿梭在水草和
礁石间，追逐着湖面上反映的白云.绿色的浮萍荡漾在淡碧的湖面上，浅露流转
在光华的叶面上可爱而晶莹，沿着石岸散布了镜湖正好一周。一切好象静止似
的静谧，又被偶尔鱼儿吐出的气泡浮出水面后的破裂激荡起小小涟漪。在湖旁
殷殷的草丛里似乎有一块小小的石碑，上面张了薄薄的一层青苔，似乎有些年
头了。
LONG
);
set("exits",([
  "northup":__DIR__"fall3",
]));
set("objects",([
 __DIR__"obj/love":1,
]));
set("outdoors","yangzhou");
setup();
}

void init()
{
  add_action("do_step","step");
}

int do_step(string arg)
{
  int skill;
  skill=this_player()->query_skill("wave_steps",1);
  if(!arg)
    return notify_fail("你要踩什么呀？\n");
  
  if(arg!="浮萍") 
   return notify_fail("又不是离合，又不是油门，你瞎踩什么？\n");
  if(this_player()->query("sen")<30 || this_player()->query("gin")<30)
   return notify_fail("你太累了休息休息吧!\n");

  if(skill<100){
  message_vision("$N踩在了浮萍上，摇摇晃晃的走了几步。。象个秤砣一样沉底。。。不见了\n",this_player());
  this_player()->move("/u/lark/xiaoyao/water");
  return 1;
  }
  message_vision("$N象一颗蒲公英似轻轻飘起落在了小小的浮萍上，左右晃动了一下稳定了身形\n"
  "足尖轻点萍叶，露水仿佛珍珠来回滚动，人却已经飘飘然仿佛凌波微步，踏着浮萍在湖面上\n"
  "信步闲庭，真是很cool。\n",this_player());
  if(skill<150){
  this_player()->improve_skill("wave_steps",random((int)this_player()->query("int"))*2);
  this_player()->add("sen",-(40-(int)this_player()->query_skill("wave_steps",1)/5));
  this_player()->add("gin",-(40-(int)this_player()->query_skill("wave_steps",1)/5));
  return 1;
  }
  return 1;
} 

