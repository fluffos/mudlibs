//road.c
#include <ansi.h>
inherit ROOM;

void create()
{
  set("short","缥缈山麓");
  set("long",@LONG
这里是飘渺峰的脚下，山势平缓阳光从山峰的缝隙中透射过来，远远近近的
丘陵，在柔和的光影中生息，葛草叶子和着丁香在风中繁芜，
前面好象是一片村落，笼罩在弥漫的蒸汽般的光芒中。山坡
上几只奶牛正在安静的咀嚼着嫩嫩的青草。
LONG
);
  set("exits",([
   "west":__DIR__"dingx",
   "northup":__DIR__"road1",
   "eastup":__DIR__"grass",
]));
  set("objects",([
  __DIR__"npc/cow":6,
  ]));
set("outdoors","changan");
setup();
  
}

int valid_leave(object who, string exit)
{

  if(exit=="west"){
   write(MAG "你无心留恋欤妮的风光，穿过平原来到了通往扬州的小路上\n" NOR);
return 1;
}
  return 1;
}
