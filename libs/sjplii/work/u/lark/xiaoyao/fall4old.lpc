//room:lake.c
#include <ansi.h>
inherit ROOM;
void get(object who);
void create()
{
 set("short","镜湖");
 set("long",@LONG
一块巨石横亘在涓细的溪流上，本来湍急的水流遇到了阻碍，也慢慢缓了下来。
形成了一个小小的湖泊。湖水清澈透明，群群快乐的鱼儿自由的穿梭在水草和
礁石间，追逐着湖面上反映的白云.
LONG
);
set("exits",([
  "northup":__DIR__"fall3",
]));
set("outdoor","yangzhou");
setup();
}

void init()
{
 add_action("do_diao","fishing");
 add_action("do_dig","dig");
}

int do_dig(string arg)
{
  int x;
  object ob;
  ob=new(__DIR__"obj/yuer");
  x=random(3);
  if(!arg)
    return notify_fail("你要挖什么？");
  if(arg!="mud")
     return notify_fail("那里好象什么也没有\n");
  if(x==3){
  message_vision("$N轻轻扒开了湿润的泥土，很专业的拣出一条小虫，看来可以当鱼饵的\n",this_player());
  ob->move(this_player());
   return 1;
    }
  message_vision("$N轻轻扒开泥巴，小心翼翼的好象在找什么宝贝。。。。难道玩泥巴？\n",this_player());
  return 1;
}




int do_diao(string arg)
{
  int x;
  x=random(20);

  
  if(present("yuer",this_player()))
      return notify_fail("你还没有放鱼饵呢。要学姜太公么？愿者上钩？\n");
  if(arg)
      return notify_fail("要钓鱼?(fishing)\n");
  remove_call_out("get");
    this_player()->start_busy(x);
  call_out("get",x,this_player());

  message_vision("$N从竹篓里拿出鱼饵，放在鱼钩上开始垂钓\n",this_player());
   message_vision(HIC "$N放声歌道：“水之清兮，云之苍兮，风动而心乐矣。。。。”\n" NOR,this_player());
  return 1;
}

void get(object who)
{
 int x;
 object ob;
 x=random(10);
 write(HIC "突然鱼漂浮动，好象有鱼上钩了。\n" NOR); 
 message_vision("$N发现鱼漂好象正在上下浮动，急忙一抖手腕提了起来!\n",who);
 if(x==1){
   message_vision("$N兴冲冲的拉过鱼线，仔细一看，啊哈，一条青鱼哦\n",who);
   ob=present("yuer",who);
   destruct(ob);
   ob=new(__DIR__"obj/qfish");
   ob->move(who);
   return 1;
    }
  if(x==2){
  message_vision("$N兴冲冲的拉过鱼线，仔细一看，啊哈，一条莲鱼哦\n",who);
  ob=present("yuer",who);
  destruct(ob);
  ob=new(__DIR__"obj/lfish");
  ob->move(who);
  return 1;
    }
  if(x==3){
   message_vision("$N兴冲冲的拉过鱼线，仔细一看，啊哈，一条草鱼哦\n",who);
   ob=present("yuer",who);
   destruct(ob);
   ob=new(__DIR__"obj/cfish");
   ob->move(who);
   return 1;
    }
   if(x==4){
    message_vision("$N兴冲冲的拉过鱼线，仔细一看，啊哈，一条鲫鱼哦\n",who);
    ob=present("yuer",who);
    destruct(ob);
    ob=new(__DIR__"obj/jfish");
    ob->move(who);
    return 1;
     }
   if(x==5){
     message_vision("$N兴冲冲的拉过鱼线，仔细一看，啊哈，一条鳟鱼哦\n",who);
     ob=present("yuer",who);
     destruct(ob);
     ob=new(__DIR__"obj/zfish");
     ob->move(who);
     return 1;
     }
    if(x==6){
     message_vision("$N兴冲冲的拉过鱼线，仔细一看,tnnd,水草!\n",who);
     ob=present("yuer",who);
     destruct(ob);
     ob=new(__DIR__"obj/grass");
     ob->move(who);
     return 1;
     }
    if(x==7){
     message_vision("$N兴冲冲的拉过鱼线，仔细一看，my god,一个易拉罐？？？？！！！！\n",who);
     write(HIR "现在真是道德败坏的年代。这么美好的自然竟然被人们如此恣意的破坏了\n" NOR);
     message_vision("$N皱了皱眉头随手把易拉罐抛回到了湖心\n",who);
     ob=present("yuer",who);
     destruct(ob);
     return 1;
     }
     if(x==8){
     message_vision("$N兴冲冲的拉过鱼线，仔细一看，天！一条大马哈鱼!!!!!\n",who);
     write(HIC "这可是鱼中的极品！不仅难得，而且烹调不易需要极高的手艺！是厨子们梦寐以求的一道大菜\n" NOR);
     ob=present("yuer",who);
     destruct(ob);
     ob=new(__DIR__"obj/dfish");
     ob->move(who);
     return 1;
     }
  message_vision("$N兴冲冲的拉过鱼线，仔细一看，噫？好象脱钩了。怎么什么也没 有？\n",who);
  ob=present("yuer",who);
  destruct(ob);
  return 1;
}