//road1.c
#include <ansi.h>
inherit ROOM;

void create()
{
  set("short","缥缈山麓");
  set("long",@LONG
沿着小路蹒跚而行，路边点缀着落霜红和珠砂根的蓓蕾，隐约的
闪现着动人的红光，怀着急不可耐的心情你快步的走进村子。石
桓上方露出几栋房屋，白壁，黑色的墙板，一排排漂亮的窗子。
一幢幢屋顶的瓦房轮廓清晰的高耸在斜暮的天际。
LONG
);
  set("exits",([
   "southdown":__DIR__"road",
   "northup":__DIR__"xy",
   "westup":__DIR__"sf",
   "eastup":__DIR__"fall",
   "southeast":__DIR__"grass",
]));
  set("objects",([
   __DIR__"npc/kid":2,
]));
set("outdoors","changan");
setup();
}

