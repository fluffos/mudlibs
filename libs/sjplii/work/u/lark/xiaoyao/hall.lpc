#include <room.h>
inherit ROOM;

void create() {
  set("short", "堂院");
  set("long", @LONG
一个不大的小院，这里是逍遥派的中心所在，可一点也看不出威
严的气氛，平静恬淡的好象寻常的农家小院。北面是掌门师兄的
卧室.西面一些人正在修葺的草舍。
LONG
  );
  set("exits", ([
    "out": __DIR__ "xy3",
    //  "north":__DIR__"house2",
    //  "west":__DIR__"build",

  ]));
  //  set("objects",([
  //  __DIR__"npc/chu":1,
  //  __DIR__"npc/dizi5":4,
  //  ]));
  setup();
}

int valid_leave(object who, string exit) {
  if (exit != "north") return 1;
  return notify_fail("里面是掌门的卧室不要乱走!\n");
}
