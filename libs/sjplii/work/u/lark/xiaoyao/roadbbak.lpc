// roadb.c

inherit ROOM;

void create() {
  set("short", "黄土路");
  set("long", @LONG
这是一条弯弯曲曲的黄土路, 一路向东南折去。远远的前面出现了一片连绵的山脉，
笼罩在朦胧的云烟中看不真切，飘渺无踪。东南面有一片雄伟的宅院,掩映在茂密的
树林后面,只露出了片片红砖绿瓦.不知道是什么去处.
LONG
  );
  set("exits", ([ /* sizeof() == 2 */
    "southeast": __DIR__ "roadc",
    "west": __DIR__ "town3",
    "northeast": __DIR__ "/u/losey/suixin/road1"
  ]));

  setup();
}
