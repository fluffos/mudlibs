//关系高歌之谜的起点之一。

inherit ROOM;

void create()
{
        set("short", "听香小镇");
        set("long", @LONG
这是一片安详的小镇，由于处在南北交通的枢纽地带，所以
街面上来来往往的人相当多。北边却住着好气派的一户人家。两扇大门
紧闭着，门上各又一个粗大的黄铜门环.高大红色的院墙遮蔽了一切视线。
使人无法窥探到里面的任何东西。
LONG
        );
        set("item_desc" , ([
        "院墙" : "墙不是太高，不过爬进去是很危险的\n",
        "wall" : "墙不是太高，不过爬进去是很危险的\n",
        ]) );
        set("exits", ([ /* sizeof() == 3 */
   "southeast" : __DIR__"roadc",
"west":__DIR__"town3",
"northeast":"/u/losey/suixin/road1"

]));
        set("outdoors", "yangzhou");
        setup();
}

void init()
{
        add_action("do_knock", "knock");
        add_action("do_climb", "climb");
}

void reset()
{
        object ob;
        ::reset();
        if( ob=present("black", this_object()) )
                destruct(ob);
        if( query("exits/north") )delete("exits/north");
}

int do_knock(string arg)
{
        object ob;
        int i;
        i=random(5);
        if( arg != "door" && arg != "大门" )return 0;
        
        if( query("exits/north") )return notify_fail("门都开了，还敲\n");
        if(i==1){
        set("exits/north", __DIR__"cxy1");
        if( !(ob=present("black", this_object())) ){
                ob=new(__DIR__"npc/black");
                ob->move(this_object());
        }
        }
        message_vision("$N将门上的铜环轻扣两下，过了一会儿，门从里面打开\n"
                        "一个黑衣人走了出来\n", this_player());
        tell_room(__FILE__, "黑衣人用沙哑而略显苍老的声音问道： 你有什么事？\n");
        return 1;
}

int do_climb(string arg)
{
        if( arg != "wall" && arg != "院墙" )return 0;
        if(this_player()->query_skill("dodge")>=100){
        message_vision("$N试了试院墙的高度，纵身跃了过去\n", this_player());
        this_player()->move(__DIR__"cxy");
        message_vision("$N纵身跃了进来\n", this_player());
        }
        message_vision("$N微蹲身形，深提一口气猛的向上越去结果离地不过三尺吧唧一声掉到了地上晕了过去。\n",this_player());
        this_player()->unconcious();
        return 1;
}

int valid_leave(object who, string exit)
{
        if( exit != "north" )return 1;
        if( !present("black", this_object()) ) return 1;
        if( who->query("cxykiller") )return 1;
        return notify_fail("黑衣人低声道：我可警告您不要乱闯，要闹出人命的\n");
}


