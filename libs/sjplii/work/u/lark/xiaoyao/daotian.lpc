//daotian.c
#include <ansi.h>
inherit ROOM;
void improve(object who);
void create()
{
        set("short", "稻田");
        set("long", @LONG
沉甸甸的稻穗在一片的波浪里垂着头，结实饱满的谷粒在阳
光下呈现出金黄的色彩,看来长势喜人又是个丰收年。
LONG
        );
        set("exits", ([ 
  "east" : __DIR__"xy",
  "west" :__DIR__"tian",
  "north":__DIR__"pigroom",
]));
        
        setup();
        
}

void init()
{
  add_action("do_shouge","shouge");
}

int do_shouge(string arg)
{

 int n;
  n=random(5)+6;
 if(this_player()->query_temp("xiaoyao/over"))
    return notify_fail("别假积极了。\n");
                   
 if(this_player()->query_temp("xiaoyao/quest")!=1)
       return notify_fail("这里可是别人辛苦的结果，你怎么好意思就给割走了？\n");  
if(this_player()->query_temp("xiaoyao/busy"))
       return notify_fail(RED "一个字: 急!\n" NOR);
 if(this_player()->query("sen")<40  || this_player()->query("gin")<40)
       return notify_fail(RED "你够累的了，休息一下吧!\n" NOR);
  if(arg)
    return notify_fail("多好的麦子呀，收割吧(shouge)\n");
  this_player()->set_temp("xiaoyao/busy",1);   

  
  if(this_player()->query_temp("xiaoyao/num")>=n){

 write(YEL "总算割完了最后一陇麦子，你擦了擦额头的汗水，该收工了！\n" NOR);
 message_vision("$N直起身子摸摸有些酸痛的腰，擦了擦额头的汗水，捆好割下的麦子置在田头。收工了!\n",this_player());
 this_player()->delete_temp("xiaoyao/num");
 this_player()->set_temp("xiaoyao/over",1);
 this_player()->delete_temp("xiaoyao/busy");
 return 1;
 }

   message_vision("$N躬下身子，挥起了镰刀，开始收割了！\n",this_player());
   write(YEL "金黄色的麦子在你的镰刀下一片片倒下，你心中充满了收获的满足!\n"  NOR);
   message_vision(YEL "$N愉快的放声高歌道：“浮华尘世兮非我愿，躬耕田亩兮吾知足”\n" NOR,this_player());  
   this_player()->start_busy(1);
   call_out("improve",1,this_player());
    
   return 1;
}

void improve(object who)
{
  if(!who)  return;
if(who->query_skill("sword",1)<200) 
 who->improve_skill("sword",random((int)who->query("int")));
 who->add("sen",-(30-(int)who->query_skill("sword",1)/8));
 who->add("gin",-(30-(int)who->query_skill("sword",1)/8));

 who->add_temp("xiaoyao/num",1);
 who->set_temp("xiaoyao/busy",0);
}
