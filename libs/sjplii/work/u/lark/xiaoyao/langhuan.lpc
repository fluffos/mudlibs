//room:琅寰福地
#include <ansi.h>
inherit ROOM;

void create()
{
   set("short",HIC "琅寰福地" NOR);
   set("long",@LONG
这是一间装饰精巧却不奢侈，陈设简单却不寒酸的房间，屋里
的摆设都是檀香木打造的。一阵阵的檀香飘过来，使你心旷神夷。
厅口悬着一幅字画，写道：“是非成败转头空，青山依旧在，几度夕阳红。”  
轩堂中一尘不染，窗明几净，四壁堆满了书架，屋角一张琴几，琴旁一方棋枰。
还有几张未完成的画，散乱地堆在另一角的画上。门上挂著湘妃帘，透过竹帘，
可以看见那一洼盛开的菊花。
LONG
);
   set("objects",([
    __DIR__"npc/master":1,
]));
   setup();
}

void init()
{
   if(this_player()->query_temp("leave"))
       add_action("do_go","leave");
}

int do_go()
{
  object where;
  where=find_object("/u/lark/xiaoyao/top2"); 

   message_vision("逍遥子嘱咐$N道:以后江湖上不要提我的名字，更不许说是我的徒弟，一个人不管到了\n"
   "什么时候都应该能清楚的知道自己的位置，鱼只有沉到最深的湖底才能寻到最美的水草，才能躲过渔人\n"
   "的捕杀。希望你能明白这个道理。你走吧.\n\n",this_player());
   tell_object(this_player(),HIW "逍遥子突然眸中闪过一丝兴奋，低声说：让你试试我最新的机关。利用了\n"
   "我这三年来验证出的一条原理，我命名为：《自由引力定律》,并且循导着直线最短的原则，现在不用象\n"
   "以前那样麻烦的飞来飞去的了，来你站好，我送你下去，预备。。。1.....2....走!.....\n\n" NOR);
   message_vision("逍遥子不知在什么地方按了一下，突然$N脚下的地板裂开了一个空洞，$N绝望的发出了\n"
   "一声撕心裂肺的惨叫。。。。。。消失在云雾里。。。不见了。。。。。地板合上了\n\n\n",this_player());
   tell_object(this_player(),"你听着耳旁忽忽而过的风声，气流顺着你身体的曲线流过，重重的浓雾在\n"
   "你的面前涤荡而开，前面一个巨大的黑影慢慢显得真切起来。。。。。呀是地面。。。要着陆了。\n\n\n");
   
   tell_room(where,"你突然听到了一声惨烈的呼叫声，一个人影从云雾笼罩的楼阁\n"
   "中直坠而下，速度越来越快,啪的一声跌落在尘埃里，一动不动,显得那样安详。\n");
   this_player()->move("/u/lark/xiaoyao/top2");
   this_player()->delete_temp("leave");
   this_player()->unconcious();
   return 1;
}

    