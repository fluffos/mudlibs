// dingx.c
#include <ansi.h>
#include <armor.h>

inherit HEAD;

void create()
{
        set_name(RED "玫瑰" NOR, ({"rose"}));
        set_weight(10);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long", "鲜红的玫瑰那是爱情的执卓\n");
                set("unit", "枝");
                set("value", 100);
                set("armor_prop/personality", 1);
        }
        set("wear_msg","$N细心地把玫瑰别在鬓角\n");
        set("unequip_msg", "$N从发间取下玫瑰\n");
        setup();
}


