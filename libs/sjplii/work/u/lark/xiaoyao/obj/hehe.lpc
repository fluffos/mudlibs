// dingx.c
#include <ansi.h>
#include <armor.h>

inherit ITEM;

void create()
{
        set_name("紫丁香" , ({"dingx"}));
        set_weight(10);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long", "纤细娇弱的丰姿在风中摇伊，脉脉含情的仿佛会多愁善感。\n");
                set("unit", "枝");
                set("value", 100);
              }
      
        setup();
}


