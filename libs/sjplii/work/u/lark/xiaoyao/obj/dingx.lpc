// dingx.c
#include <ansi.h>
#include <armor.h>

inherit HEAD;

void create() {
  set_name("紫丁香", ({ "dingx" }));
  set_weight(10);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "纤细娇弱的丰姿在风中摇伊，脉脉含情的仿佛会多愁善感。\n");
    set("unit", "枝");
    set("value", 100);
    set("armor_prop/personality", 5);
  }
  set("wear_msg", "$N细心地把紫丁香别在鬓角\n");
  set("unequip_msg", "$N从发间取下紫丁香花\n");
  setup();
}
