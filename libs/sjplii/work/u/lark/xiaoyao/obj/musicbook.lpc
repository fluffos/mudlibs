// blade_book.c
#include <ansi.h>
inherit ITEM;

void create()
{
        set_name(HIM "五音通理" NOR, ({ "book"}));
        set_weight(600);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "本");
                set("long",
"这是一本简易入门的乐理书.\n");
                set("material", "paper");
                set("skill", ([
                        "name":                 "music",
                        "sen_cost":             30,                             
                        "difficulty":   20,                             
                        "max_skill":    50                              
                                                                                     
                ]) );
        }
}



