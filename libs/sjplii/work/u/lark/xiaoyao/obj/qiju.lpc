// qiju.c
#include <ansi.h>
inherit ITEM;
void task();
void taskt();
void taskth();
void finish();
void win();
void create()
{
        set_name(HIC "珍珑棋局" NOR,({"qi ju"}));
        set_weight(10000000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
            set("long",
               "一块石几上刻画这纵横的纹路，一些大理石黑白棋子布置了一个棋局。\n");
            set("unit","盘");
           
            set("value", 0);
            
        }
}

void init()
{
  
  add_action("do_play","play");
}

int do_play()
{
  int kar,n;
  kar=200/this_player()->query("kar");
  n=random(kar);  
  if(!this_player()->query_temp("test"))
      return notify_fail("苏星河恼怒的说：“你是干什么的？不要在这里捣乱”\n");
    
  if(this_player()->query("fail")==3){
   message_vision("苏星河对$N不耐烦的摆了摆手，说道：“你没有机会了.”\n",this_player());
   return 0;
   }
  message_vision("$N坐在石几前的石凳上，拾起一粒棋子，低头沉思起来\n",this_player());
  call_out("start",5,this_player());
  return 1;
}

void start()
{
  int kar,n;
  kar=(int)100/this_player()->query("kar");
  n=random(kar);  
  write("kar="+n);
  if(this_player()->query_skill("qidao")==0){
  tell_object(this_player(),"密密麻麻的排放的的棋子似乎遵循着什么规律,但你却看不出个所以然\n"
  "也许真的该学学围棋好了,不过学了又有什么用呢？下围棋？浪费生命。。。。。\n"); 
  tell_object(this_player(),"可。。。。这东西该放到那里呢？不管了,小平同志教导我们，实践是检验真理的唯一标准\n"); 
   message_vision("$N微微一皱眉头，手指轻放，把棋子落下了,不禁面有得色。\n",this_player());
   if(n==1){
    message_vision("苏星河眼皮轻抬，似乎略过一丝兴奋，但随即阴沉下来，怒道：“胡闹,\n"
    "那里是自己的气眼，你这不是自寻死路么？你到底会不会下棋？还是到这里搞笑老夫？给我滚”\n",this_player());
    call_out("win",3,this_player());
    
    return;
    }
   message_vision("苏星河眼皮轻抬，似乎略过一丝兴奋，但随即阴沉下来，摇了摇头。轻叹一声.\n",this_player());
  this_player()->add("fail",1);      
  return;
  }else{
  this_player()->start_busy(20);  
  call_out("task",5,this_player());
  tell_object(this_player(),"呀。这是一盘明显的死活劫吗......\n"
  "黑5上手打吃，白棋只有41，43位做劫，迫使黑棋1跳......\n");
   return;
    }
 
}

void win()
{
  
  message_vision("苏星河惊突然异的：咦。。了一声。。。。。竟然呆住了\n",this_player());
  message_vision("苏星河脸色慢慢通红起来，嘟囔道：“高。。。高。。。实在是高。。。。\n"
  "自填一气，以取外势，看似无理，死里求生。。。。高。。。高。。。。。.”\n",this_player());
  message_vision("苏星河脸色怪异的看着$N,兴奋？遗憾？嫉妒？最后长叹一声：“天意呀，天意。”\n",this_player());
  message_vision("苏星河对$N一拱手道：“恭喜了，我现在就送你去见师父.”\n",this_player());
  message_vision("苏星河伸手不知在棋盘的什么地方按了一下，只见从$N的座位底下冒出了一股浓浓白烟\n"
  "然后飕。。。。的一声，$N冲天而起，画着一条完美的轨道向着山壁上的楼阁投去,不见了\n",this_player());
tell_object(this_player(),"你觉得自己耳旁生风，好象正在展翅翱翔，不禁高唱道：
“i believe i can fly......”，突然你觉得眼前好象有个什么东西黑糊糊的。。。。一块木墙。。。faint\n");
  
  tell_room("/u/lark/xiaoyao/langhuan","一条人影不知道从什么方向撞破了三寸厚的墙板，成扭曲状倒栽了进到房间里，默默不语，显得很文静的样子\n");
  this_player()->move("/u/lark/xiaoyao/langhuan");
  this_player()->delete_temp("test");
  this_player()->set("win",1);
  this_player()->unconcious();
}

void task()
{
   int skill;
   skill=this_player()->query_skill("qidao",1);
   message_vision("$N摇了摇头,似乎是自言自语道:不对不对...... \n",this_player());
   tell_object(this_player(),".....如果白1虎，看似棋形，但被黑2，4先手搜刮黑目数肯定大占便宜，\n"
               "况且还有6，8的劫杀.......\n");
   this_player()->receive_damage("gin",skill);
   this_player()->receive_wound("gin",(int)skill/10);
   this_player()->receive_damage("sen",skill);
   this_player()->receive_wound("sen",(int)skill/10);
   remove_call_out("task");
   call_out("taskt",5,this_player());
}

void taskt()
{
   int skill;
   skill=this_player()->query_skill("qidao",1);
   message_vision("$N面露困惑,嘟囔道：“何解。。。何解？....”\n",this_player());
   tell_object(this_player(), "也许是一个双活的手筋？但黑1靠才是此刻的急所!白2板，黑3\n"
   "接后再于5位一段，黑棋就能闷杀白棋......可要是白棋出头呢？......\n");
   this_player()->receive_damage("gin",skill);
   this_player()->receive_wound("gin",(int)skill/10);
   this_player()->receive_damage("sen",skill);
   this_player()->receive_wound("sen",(int)skill/10);
   remove_call_out("taskt");
   call_out("taskth",5,this_player());
}

void taskth()  
{
   int skill;
   skill=this_player()->query_skill("qidao",1);
   message_vision("$N深锁双眉，低头沉思道：“。。。若如此。。。将奈何？。。。”\n",this_player());
   tell_object(this_player(),"白棋明显在5位有利，打吃后至黑24已成必然，白25做活虽然痛苦\n"
    "但似乎别无良策。如果飞封，黑棋只需在29位破眼即可杀死白棋。所以。。。。。。\n");
    this_player()->receive_damage("gin",skill);
   this_player()->receive_wound("gin",(int)skill/10);
   this_player()->receive_damage("sen",skill);
   this_player()->receive_wound("sen",(int)skill/10);
   remove_call_out("taskth");
   call_out("finish",5,this_player());
}

void finish()
{
   

  this_player()->start_busy(1);
  
  message_vision("$N身体突的震动一下，好象突然从梦中惊醒。。。。。。。\n",this_player());
  
  tell_object(this_player(),"这盘棋局已经学究天人，不是你我凡人所能揭开的，过度沉迷只能让自己\n"
  "走火入魔\n");
  message_vision("$N脸色通红，低声道：“惭愧。。惭愧。。。好险。。好险。。。\n",this_player());
 
  write(MAG "许多事物都是如此过分的执卓，会让自己失却了一颗平常的心态而最终导致令自己痛悔的结局\n"
  "无论是爱情还是事业都是如此，只有用一种成熟而不虚妄的灵魂去真切的面对，才能发现原来在我们认为\n"
  "已经逐渐苍白的世界里原来还有一颗最美的丁香。。。。。。。。。\n");

  message_vision("苏星河抬头看了看$N,脸上露出了一丝无奈，嘲讽，幸灾乐祸的笑容。。。又低头呆呆的望\n"
  "着棋局,一言不发了\n",this_player());
  this_player()->add("fail",1);
}




 

   