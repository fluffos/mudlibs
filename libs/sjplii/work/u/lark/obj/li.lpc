// shi.c
#include <skill.h>
inherit ITEM;

void create()
{
        set_name("《诗》", ({ "shi" }));
        set_weight(600);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "本");
                set("long","《诗》\n");
                set("material", "paper");
                set("skillll", ([
                        "name":                 "literate",
                        "exp_required": 100,
                        "sen_cost":             40,             
                        "difficulty":   30,             
                        "min_skill":    10,     
                        "max_skill":    21,             
                ]) );
        }
}

