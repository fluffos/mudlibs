//tiejia2.c
#include <ansi.h>
#include <armor.h>
inherit CLOTH;
void create()
{
set_name(WHT "黑铁护甲" NOR, ({ "jia"}) );
set_weight(6000);
if( clonep() )
set_default_object(__FILE__);
else {
set("unit", "件");
set("value", 1100);
set("material", "iron");
set("armor_prop/armor", 1);
set("armor_prop/nokill", 1);
set("armor_prop/id", ({"huwei"}) );
set("armor_prop/name", ({"铁甲虎卫"}) );
	set("armor_prop/short",({"铁甲虎卫(huwei)"}) );
set("armor_prop/long", ({
"一个身穿铁甲威风凛凛的军士,但怎么看都有点鬼头鬼脑的样子。\n"
}) );
set("armor_prop/class",({"official"}));
set("armor_prop/id_type",4);
set("armor_prop/nokill", 1);
}
setup();
}
