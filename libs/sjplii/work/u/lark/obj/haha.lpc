//tiejia.c

#include <armor.h>

inherit CLOTH;

void create()
{
   set_name("避弹衣",({"cloth"}));
   set_weight(3000);
set("value",3000);
   if( clonep() )
                set_default_object(__FILE__);
 else {
                set("unit", "件");
                set("material", "stell");
                set("armor_prop/armor", 100);
                set("armor_prop/dodge", 100);
        }
        setup();
}

