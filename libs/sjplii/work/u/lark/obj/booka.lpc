inherit ITEM;

void create()
{
        set_name("资治通鉴", ({ "book" }));
        set_weight(600);
        set("unit", "本");
        set("long",
                
"这是一本收集古今治理国家成败经验的《资治通鉴》\n"
"适合初学者。\n");
        set("skill", ([
                "name":                 "economics",             // name of 
                "exp_required": 10000,                              // minimum 
                "sen_cost":             40,                             // 
                "difficulty":   20,                             // the base 
                "max_skill":    70                              // the 
        ]) );
}
