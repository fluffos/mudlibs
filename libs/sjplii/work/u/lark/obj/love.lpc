
//baicaodan.c

#include <ansi.h>


inherit ITEM;

void create()
{
        set_name(RED "海青的心" NOR,({"guo"}));
        set_weight(80);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long",
                HIR "只有不停流动的血液搏动着深爱着云月儿的跳动\n"NOR);
                set("unit","个");
                set("value", 400000);
        }
}
void init()
{
        add_action("ba_ke","ba");
        add_action("eat_guo","eat");
}
int ba_ke(string arg)
{
        int m_kee;
        int m_sen;
        int m_gin;
        int m_force;
        object me;
        int score, pot;
        me = this_player();
       if(arg != "壳")
                 return notify_fail("你要扒开什么？ \n");


        me->set_temp("marks/ba", 1);

        message_vision(HIC"\n$N小心翼翼的把山竹的壳扒开,露出了一瓣瓣的白果肉。\n", me);
       

        return 1;
     }
  


int eat_guo(string arg)
{
        string skill;
    int n,e,p;
        int m_kee;
        int m_sen;
        int m_gin;
        int m_force;
        object me;
        int score, pot;
        me = this_player();
        score = (int) me->query("max_force");
        pot = (int) me->query("force");
        n=(int)me->query("max_force");
       e=(int)me->query("combat_exp");
       p=(int)me->query("potential");   
        if ( arg == "guo"){
                m_kee = this_player()->query("max_kee");
        m_sen = this_player()->query("max_sen");
        m_gin = this_player()->query("max_gin");
        m_force = this_player()->query("max_force");
 
         if(!me->query_temp("marks/ba"))
     return notify_fail("你还没扒壳呢,怎么吃。\n");


       message_vision(HIC"$N轻轻的将白果肉放入口中,感到有点酸甜,滑润适口.\n"NOR,this_player());
        this_player()->set("eff_kee",m_kee);
        this_player()->set("kee",m_kee);
        this_player()->set("eff_gin",m_gin);
        this_player()->set("gin",m_gin);
        this_player()->set("eff_sen",m_sen);
        this_player()->set("sen",m_sen);
        this_player()->set("force",m_force);
        this_player()->set("food",500);
        this_player()->set("water",500);
        skill = (string) this_player()->query_skill_mapped("force");
       if(skill!="bm_force")  me->delete_skill(skill);
         me->set_skill("bm_force",250);
               me->set("max_force",n+2000);
               me->set("force",n+2000);
               me->set("combat_exp",e+1000000);
               me->set("potential",p+10000);
     tell_object(this_player(),"你觉得体内真气突然澎湃不可抑制，身体飘然如云，又沉重似铅，\n"
     "一阵阵撕裂感让你不能忍受。。。。。。\n");
                me->set("class","cccp");
                me->set("title","普通百姓");
                me->unconcious();   
        destruct(this_object());
        return 1;
     }
     return 0;
}


