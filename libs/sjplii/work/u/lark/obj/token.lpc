// token1.c


inherit ITEM;

void create()
{
        set_name("紫龙帮保命金牌",({ "token" }) );
        set("long",
                "拥有这块金牌可以在紫龙帮受到很好的待遇\n"
                "所以千万不要送人\n");
        set_weight(3000);
        if( clonep() )
                set_default_object(__FILE__);
        else 
                set("unit", "块");
        setup();
}
