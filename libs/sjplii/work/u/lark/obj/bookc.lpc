// unarmed_b.c
#include <skill.h>
inherit ITEM;

void create() {
  set_name("三国志", ({ "book" }));
  set_weight(600);

  set("unit", "本");
  set("long",
    "《三国志》陈寿所著，深刻的描述了在三国时代政治家们的用人手段。\n");
  set("material", "paper");
  set("skill", ([
    "name": "leadership",
    "exp_required": 10000,
    "sen_cost": 30,
    "difficulty": 30,

    "max_skill": 70,
  ]));
}
