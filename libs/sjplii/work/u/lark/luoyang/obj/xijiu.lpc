// waterskin.c
#include <ansi.h>
inherit ITEM;
inherit F_LIQUID;

void create()
{
        set_name(RED "喜酒" NOR, ({ "jiu"}) );
        set_weight(700);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long", "别人结婚了,给了你一瓶酒.\n");
                set("unit", "瓶");
                set("value", 20);
                set("max_liquid", 15);
        }

        // The liquid contained in the container is independent, we set a copy
        // in each cloned copy.
        set("liquid", ([
                "type": "alcohol",
                "name": "红酒",
                "remaining": 15,
                "drunk_apply": 6,
        ]) );
}

