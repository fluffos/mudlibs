inherit ROOM;

void create()
{
        set("short", "伊人花店");
        set("long", @LONG
一进门你就被这里的花香迷住了,一个可爱的小姑娘正在
花丛中走来走去的浇水,看见你进来露出了一个可爱的
微笑,门口有一个牌子(sign).
LONG
        );
        set("exits", ([ /* sizeof() == 4 */
  "north" : __DIR__"lyw1",
//  "south" : __DIR__"huadian",
//  "west"  : __DIR__"lyw2",
//  "east"  : __DIR__"center",
]));
        set("objects", ([
        __DIR__"npc/yiren": 1,
                        ]) );

          set("item_desc", ([
                "sign": @TEXT
本店出售各种鲜花代送亲友,爱人.
手续如下:
give yiren 2 silver
song  <name> <花的种类>

花数之爱情物语
1朵一见钟情、你是我的唯一、唯一的爱、对你情有独钟、心中只有你
2朵你侬我侬、心心相印、世界只有我和你、眼中世界只有我俩
3朵我爱你、山盟海誓 、甜蜜恋情爱在心底
4朵誓言、承偌、海誓山盟
5朵无怨无悔
6朵顺心如意、顺利、永结同心、愿您一切幸福
7朵天天想你、相逢知心、求?朵歉意、深深歉意、请原谅我
9朵天长地久、长相厮守、坚定、彼此相爱长久 、坚定之爱、永久的拥有
10朵十全十美、完美的你、完美的爱情
11朵最爱、最爱的你、双双对对、一心一意、今生最爱还是你
12朵比翼双飞、求婚、圆满组合、心心相印 、每日思念对方
13朵暗恋的人
17朵好聚好散、让我们的爱到此为止
20朵两情相悦、一生一世、永远爱你、此情不渝
21朵我的最爱、最爱
22朵两情相悦双双对对
24朵无时无刻、思念（24小时无时不思念）
30朵不需言语的爱
33朵我爱你、非常爱你、情深呼唤我爱你
36朵我心属于你、浪漫心情、全因为你
44朵至死不渝、山盟海誓、恒古不变的誓言
50朵无怨无悔、这是无悔的爱
55朵无怨无悔
56朵吾爱
57朵吾爱吾妻
66朵顺利、事事顺利、情场顺利、六六大顺、细水长流
77朵喜相逢、求婚、情人相逢、相逢自是有缘
80朵弥补
88朵弥补歉意、用心弥补一切的错
99朵长相厮守、坚定不移的信念、天长地久、地老天荒、永恒的爱 、知心相爱到永久
100朵白头皆老、百年好合、爱你亿万年、百分之百的爱 、执汝之手，与汝皆老
101朵直到永远、无尽的爱、唯一的爱、你是我唯一的爱
108朵求婚、嫁给我吧、无尽的爱
111朵无尽的爱
123朵爱情自由、自由之恋
144朵12×12爱你日日月月、爱你生生世世
365朵天天想你、天天爱你
999朵天长地久、爱无休止长相厮守、至死不渝、无尽的爱
1001朵一辈子的爱、一心一意、忠貞的爱至死不渝
10000朵爱一万年


TEXT
        ]) );


        set("outdoors", "luoyang");
        setup();
}

void init()
{
  add_action("do_song","song");
}

int do_song(string arg)
{
  int n,i;
  object *user ;
  object me, target,ob,what;
  string hua;
   me=this_player();
 if(!arg || sscanf(arg,"%s %s",arg,hua) != 2)
                return notify_fail("指令格式：song  <name> <花的种类>\n"); 
   
  if(me->is_busy())
                return notify_fail("你上一个动作还没有完成。\n");
  if(!ob=present("yiren",this_object()))
    return notify_fail("伊人现在不在等会再来吧!\n");
   user = users();
  for(i=0; i<sizeof(user); i++) {
        if (user[i]->query("id")==arg) target=user[i];
        else continue;
  }
  if(!target) return notify_fail("找不到你想要送花的人！\n");
  
  
 if(!this_player()->query_temp("ok"))
    return notify_fail("你必须先付钱\n");
  switch(hua ) {
     case "太阳花":
      message_vision("$N对$n可爱的一笑,露出雪白的小牙道:太阳花象征光明，花语为欣欣向荣\n",ob,me);
      what=new(__DIR__"npc/obj/sun");
      tell_object(target,"有人托洛阳的伊人花店给你送了一束太阳花\n");
      what->move(target);
      me->delete_temp("ok");
      return 1;
       break;
    case "宣草":
      message_vision("$N对$n可爱的一笑,露出雪白的小牙道:宣草象征忘忧,花语为勿忘我\n",ob,me);
      what=new(__DIR__"npc/obj/xuan");
      tell_object(target,"有人托洛阳的伊人花店给你送了一束宣草\n");
      what->move(target);
      me->delete_temp("ok");
      return 1;
      break;       
     case "康乃馨":
      message_vision("$N对$n可爱的一笑,露出雪白的小牙道:康乃馨象征母爱，花语为健康长寿\n",ob,me);
      what=new(__DIR__"npc/obj/kangnaixin");
      tell_object(target,"有人托洛阳的伊人花店给你送了一束康乃馨\n");
      what->move(target);
      me->delete_temp("ok");
      return 1;
      break;       
     case "红玫瑰":
      message_vision("$N对$n可爱的一笑,露出雪白的小牙道:红玫瑰象征爱情，其花语为我真心爱你。\n",ob,me);
      what=new(__DIR__"npc/obj/rose");
      tell_object(target,"有人托洛阳的伊人花店给你送了一束玫瑰\n");
      what->move(target);
      me->delete_temp("ok");
      return 1;
      break;     
     case "百合花":
      message_vision("$N对$n可爱的一笑,露出雪白的小牙道:百合花象征高洁，花语为百年好合。\n",ob,me);
      what=new(__DIR__"npc/obj/baihe");
      tell_object(target,"有人托洛阳的伊人花店给你送了一束百合\n");
      what->move(target);
      me->delete_temp("ok");
      return 1;
      break;     
       case "牡丹花":
      message_vision("$N对$n可爱的一笑,露出雪白的小牙道:牡丹花象征花王,花语为花开富贵\n",ob,me);
      what=new(__DIR__"npc/obj/mudan");
      tell_object(target,"有人托洛阳的伊人花店给你送了一束牡丹\n");
      what->move(target);
      me->delete_temp("ok");
      return 1;
      break;   
      case "桃花":
      message_vision("$N对$n可爱的一笑,露出雪白的小牙道:桃花象征发达,花语为宏图大展\n",ob,me);
      what=new(__DIR__"npc/obj/taohua");
      tell_object(target,"有人托洛阳的伊人花店给你送了一束桃花\n");
      what->move(target);
      me->delete_temp("ok");
      return 1;
      break;   
      }
 return notify_fail("没有这种花\n");
}


