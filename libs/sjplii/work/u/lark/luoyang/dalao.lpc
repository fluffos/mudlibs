#include <ansi.h>
inherit ROOM;
void create()
{
        set("short", RED "洛阳大牢" NOR);
        set("long", @LONG
阴森恐怖的大牢里潮湿寒冷,地上耗子四处乱窜,几个蓬头垢面的
人顿在角落里,散发出难闻的气味.台阶上的铁门紧锁着,几个衙役
来回走着不时往里面看看.
LONG
        );
        set("exits", ([ /* sizeof() == 4 */
  "up" : __DIR__"dalao1",
//  "south" : __DIR__"huadian",
//  "west"  : __DIR__"lyw2",
//  "east"  : __DIR__"center",
]));
/*    
    set("objects", ([
        __DIR__"npc/yayi2": 2,
                        ]) );

*/
//        set("outdoors", "luoyang");
        setup();
}

void init()
{
 add_action("do_save","save");
 add_action("do_quit","quit");
}

int do_save()
{
  write("can't save here\n");
  return 1; 
  
}

int do_quit()
{
   write("can quit here\n");
   return 1;
}

int valid_leave(object me, string dir)
{
        object *inv;
        object ob,where;
        int i,n;
        i=time()-this_player()->query("beget");
        n=this_player()->query("time")*100-i;
        where=find_object("/u/lark/luoyang/dalao1");
        if( userp(me) && dir == "up"){
         if(!this_player()->query("zuiren"))
         return 1;
        if(!present("yayi",where))
         return 1;

        if(i<this_player()->query("time")*100){
        message_vision("衙役用杀威棒敲了敲铁门,冲$N叫到:老实点!\n",me);
        tell_object(me,"你还有"+n+"秒钟才能出狱\n");
        return 0;
        }
  CHANNEL_D->do_channel(me, "rumor",sprintf("%s刑满出狱了\n", me->name(1)));  
  me->delete("zuiren");
  me->delete("time");
  me->delete("beget");
  return 1;
}
}

