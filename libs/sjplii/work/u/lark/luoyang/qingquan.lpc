inherit ROOM;

void create()
{
        set("short", "清泉浴场");
        set("long", @LONG
四面的墙壁挂满了风干的花环，散发出醉人的香气。大堂的中央是一个古色古香
的青铜仙鹤，鹤嘴里面飘出袅袅青烟，沁人心脾。地板是上好的檀香木，光滑而
略带潮湿。几个如花似玉的小丫环正在忙碌，望向窗外，一个巨大的青铜缸架在
烈火上，丫环们正在慢慢的加入清泉水。左手边是一个柜台，后面有一个架子上
面挂满了钥匙。柜台里是各种洗浴的用具。
LONG
        );
        set("exits", ([
                "south" : __DIR__"lyw2",
                "north" : __DIR__"qq1",
        ]));
        set("no_fight",1);
        set("no_study",1);
        set("no_magic",1);
        set("objects", ([
                __DIR__"npc/zhen": 1,
        ]) );
                set("no_clean_up", 0);

        setup();


}

void init()
{
 add_action("do_quit","quit");
}

int do_quit() {return 1;}


int valid_leave(object me, string dir)
{
   object ob;
   if(dir=="north"){
   if(!me->query("xizao"))
     return notify_fail("你没有交钱呢呀\n");
    return 1;
   }
   if(ob=present("yaoshi",me))
    return notify_fail("你的钥匙还没有交还呢\n");
  return 1;
}


