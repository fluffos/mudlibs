#include <ansi.h>
//  10gold

inherit NPC;
inherit F_VENDOR;


int help();  
int make_weapon();
int check_legal_name(string arg);
int check_legal_id(string arg);


void create()
{
        set_name("风厉", ({ "feng li","feng" ,"风厉"}) );  
        set("gender", "男性" );
        set("age", 31);
        set("title", HIG "欧冶子在世" NOR);
        set("long",
                "虽然名头有些自大但他锻造的兵器还是没的说的.\n"
                "厉家祖传十三代的兵器手艺到他这一代自然是更加精益\n");
        set("combat_exp", 500000);
        set("attitude", "friendly");
        set("per",30);
        set("inquiry", ([
                "帮忙" : (: help :),
                "help" : (: help:),
                "work" : (: help :),
                "打工" : (: help :),
                "打造":(:make_weapon:),
                "武器":(:make_weapon:),
                "weapon":(:make_weapon:),
                "兵刃":(:make_weapon:),
                "兵器":(:make_weapon:),
                "锻造":(:make_weapon:),     //xixi
        ]) );

        set("vendor_goods", ([
               __DIR__"obj/weapon/whip":5,
               __DIR__"obj/weapon/sword":5,
               __DIR__"obj/weapon/dart":5,
               __DIR__"obj/weapon/shield":5,
               __DIR__"obj/weapon/hammer":5,
               __DIR__"obj/weapon/thin_sword":5,
               __DIR__"obj/weapon/dagger.lpc":5,
               __DIR__"obj/weapon/blade.lpc":5,
               __DIR__"obj/weapon/fork":5,
               __DIR__"obj/weapon/axe":5,
               
        ]) );
        set_skill("hammer",300);
        set_skill("pyrobat-steps",150);
        set_skill("dodge",150);
        set_skill("parry",150);
        set_skill("unarmed",150);
        set_skill("force",150);
        set_skill("lotusforce",150);
        set_skill("wuxing-quan",150);
        map_skill("dodge","pyrobat-steps");
        map_skill("unarmed","wuxing-quan");
        map_skill("force", "lotusforce");

        setup();
        carry_object("/d/city/obj/cloth/linen")->wear();                
        carry_object("/d/city/obj/weapon/hammer/hammer")->wield();      
}

//这里返回1值，可以用 int ,表示回答了
int help()
{
        command("nod");
        command("say 但是我们这里的工作可以很累哦。而且薪水很低，你要干就干吧(work)\n");
        this_player()->set_temp("xiaoyao/ok",1);     
        return 1;
}


void init()
{
        object ob;
        ::init();
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
        }
        add_action("do_vendor_list", "list");
        add_action("do_work", "work");
        add_action("do_ding","ding");
        add_action("do_ding","订");     
        add_action("do_ji","锻造");     
        add_action("do_ji","duanzao");
}

void greeting(object ob)
{
        if( !ob || !visible(ob) || environment(ob) != environment() ) return;
        switch( random(3) ) {
                case 0:
                        say(name()+"说道：这位" +RANK_D->query_respect(ob) + "，进来随便看看吧。\n");
                        break;
                case 1:
                        say(name()+ "低声叹了口气道：真的忙不过来了要是有人能帮忙就好了。\n");
                        command("look "+ob->query("id"));
                        command("hehe");
                        command("say 这位"+RANK_D->query_respect(ob)+"请进请进。\n");  
                        break;
                case 2:
                        say(name()+ "说道：这位" +RANK_D->query_respect(ob)+ "，进来挑一件称手的兵器吧。\n");
                        break;
        }
}


int do_work(string arg)
{
        object ob;
        object me;
        me = this_player();
        if(!me->query_temp("xiaoyao/ok"))
                return notify_fail("风厉皱眉道：你要干什么别乱动我的东西\n");
        if(me->is_busy()) return notify_fail("你的动作还没有完成，不能工作。\n");
        message_vision("$N辛苦的工作终于结束了，可人也累的要死\n",me);
        
        me->receive_damage("gin",30,me);
        me->receive_damage("sen",30,me);    
        
        ob = new("/obj/money/silver");     
        ob->move(me);
        message_vision("风厉对$N说：这是你的工钱。\n", me);
        me->start_busy(1);
        return 1;
}

int make_weapon()
{
        object me = this_player();
        
        command("hehe "+me->query("id"));
        command("say 不是我自夸，连当年天下第一高手龙五用的板指也是我打造的。\n");
        command("say 你如果没有看过牌子，喏喏喏，先看看。\n");
        write("风厉说完，指指他身旁的一块牌子。\n");
        command("say 看完了，再订武器吧！\n");
        return 1;
}

int do_ding(string arg)
{
        string ctype, cname, ccolor, cid;
        object ob, me, gold, ob2;
        string id,newfile,newdirstr,filename;
        
        me = this_player();
        id = me->query("id");
        if(!arg || sscanf(arg,"%s %s %s %s",ctype,ccolor,cname,cid) != 4)
                return notify_fail("指令格式：ding 订 <type> <color> <name> <English name>\n");
        if(me->is_busy())
                return notify_fail("你上一个动作还没有完成。\n");
        //10岁 ，14岁 ，21岁 可各打造一个。(3)   每7年打造一个。
        if((int)me->query("created_item") >= (int)me->query("age")/7)
        return notify_fail("你现在只能拥有"+chinese_number((int)me->query("age")/7)+"件自造物品。\n");
        if((int)me->query("xiaoyao/created_item") >= 3)
                return notify_fail("你已经拥有太多自造物品了。\n");
        gold = present("gold_money", this_player());
        if(!gold) 
                return notify_fail("你身上没有金子。\n");
        if((int) gold->query_amount() < 10)
                return notify_fail("你身上没有那麽多金子。\n");
        if( !check_legal_name(cname))
                return notify_fail("");
        if( !check_legal_id(cid))
                return notify_fail("");

        if( ccolor != "$BLK$" && 
            ccolor != "$NOR$" &&
            ccolor != "$RED$" &&
            ccolor != "$GRN$" &&
            ccolor != "$YEL$" &&
            ccolor != "$BLU$" &&
            ccolor != "$MAG$" &&
            ccolor != "$CYN$" &&
            ccolor != "$WHT$" &&
            ccolor != "$NOR$" &&
            ccolor != "$HIR$" &&
            ccolor != "$HIG$" &&
            ccolor != "$HIY$" &&
            ccolor != "$HIB$" &&
            ccolor != "$HIM$" &&
            ccolor != "$HIC$" &&
            ccolor != "$HIW$" 
        )
        return notify_fail("不知你要什么颜色．\n");
        
        ccolor = replace_string(ccolor, "$BLK$", "BLK");
        ccolor = replace_string(ccolor, "$RED$", "RED");
        ccolor = replace_string(ccolor, "$GRN$", "GRN");
        ccolor = replace_string(ccolor, "$YEL$", "YEL");
        ccolor = replace_string(ccolor, "$BLU$", "BLU");
        ccolor = replace_string(ccolor, "$MAG$", "MAG");
        ccolor = replace_string(ccolor, "$CYN$", "CYN");
        ccolor = replace_string(ccolor, "$WHT$", "WHT");
        ccolor = replace_string(ccolor, "$HIR$", "HIR");
        ccolor = replace_string(ccolor, "$HIG$", "HIG");
        ccolor = replace_string(ccolor, "$HIY$", "HIY");
        ccolor = replace_string(ccolor, "$HIB$", "HIB");
        ccolor = replace_string(ccolor, "$HIM$", "HIM");
        ccolor = replace_string(ccolor, "$HIC$", "HIC");
        ccolor = replace_string(ccolor, "$HIW$", "HIW");
        ccolor = replace_string(ccolor, "$NOR$", "NOR");
        seteuid(ROOT_UID);
        switch( ctype ) {
                case "axe":
                        newfile = read_file(__DIR__"weapons/axe.lpc");
                        break;
                case "blade":
                        newfile = read_file(__DIR__"weapons/blade.lpc");
                        break;
                case "dagger":
                        newfile = read_file(__DIR__"weapons/dagger.lpc");
                        break;
                case "fork":
                        newfile = read_file(__DIR__"weapons/fork.lpc");
                        break;
                case "hammer":
                        newfile = read_file(__DIR__"weapons/hammer.lpc");
                        break;
                case "staff":
                        newfile = read_file(__DIR__"weapons/staff.lpc");
                        break;
                case "sword":
                        newfile = read_file(__DIR__"weapons/sword.lpc");
                        break;
                case "whip":
                        newfile = read_file(__DIR__"weapons/whip.lpc");
                        break;
                case "spear":
                        newfile = read_file(__DIR__"weapons/spear.lpc");
                        break;
                case "banzhi":
                        newfile = read_file(__DIR__"weapons/banzhi.lpc");
                        break;
                default:
                        return notify_fail("这里不会做你要的东西．\n");
        }
        
        newfile = replace_string( newfile, "订作的", cname);    //加入武器中文名
        newfile = replace_string( newfile, "order", cid);       //加入武器id
        newfile = replace_string( newfile, "darks", id);        //加入拥有者的id
        newfile = replace_string( newfile, "COR", ccolor);      //颜色
        newfile = replace_string( newfile, "STAMP","a"+(string)me->query("created_item")); 
        


//准备写文件  if my id is darks, then put it in
        //      /data/user/d/darks/items/       file name is darksa0.c or darksa1.c or darksa2.c
        
        newdirstr = DATA_DIR+"user/" + id[0..0] + "/" + id + "/items/";
        
        if(!me->query("xiaoyao/hascreate"))    //第一次必须建立目录
        if(!mkdir(newdirstr)) write("错误(101)！！请通知巫师！！\n");   //纪录错误代码,以便以后容易查找
        me->set("xiaoyao/hascreate",1);
        
        filename = newdirstr + id +"a"+(string)me->query("created_item")+ ".lpc";
        
        if( !write_file(filename, newfile,1))   //写文件,完全覆盖
                return 0;
                                                
        ob = new(filename);    
        ob->set("weight",1000);                 //缺省的重量
        ob->set("rigidity",random(500)+500);    //缺省的锋利度
        ob->set("weapon_prop/damage",20);       //缺省的杀伤力.缺省必须与 base_damage同
        ob->set("max_enchant",5);               //缺省的附加属性，可加五点 
        ob->set("base_damage",20);              //缺省的基本杀伤力
        
        //保存数据   以后数据改变，便要持行一次
        ob->save();             
        
        //载入真正的用户物品
        ob->restore();
        if(ob->move(me)){
                gold->add_amount(-10);
                me->add("created_item",1);
                me->start_busy(1);
                write("你将身上的黄金交给"+name()+"，订造了一"+ob->query("unit")+ob->name()+"\n");
                seteuid(getuid());
                return 1;
        }
        return 0;
}
//check chinese name
int check_legal_name(string name)
{
        int i;
        i = strlen(name);
        if( (strlen(name) < 2) || (strlen(name) > 40 ) ) {
                write("对不起，中文名字必须是一到二十个中文字。\n");
                return 0;
        }
        while(i--) {
                if( name[i]<=' ' ) {
                        write("对不起，中文名字不能用控制字元。\n");
                        return 0;
                }
                if( i%2==0 && !is_chinese(name[i..<0]) ) {
                        write("对不起，名字必需是中文。\n");
                        return 0;
                }
        }
        return 1;
}

//check english name
int check_legal_id(string name)
{
        int i;
        i = strlen(name);
        if( (strlen(name) < 3) || (strlen(name) > 20 ) ) {
                write("对不起，英文名字必须是三到二十个字。\n");
                return 0;
        }

        return 1;
}

int  do_ji(string arg)
{
        object me, ob;
        object gold;
        int cost = 1;
        int i,j,base,current;
        string id,name ;        
        string file,newfile,filestring;
        me = this_player();
        
        id = me->query("id");
        if( !arg ) return notify_fail("你要祭什麽武器？\n");
        
        gold = present("gold_money", this_player());
        if( !gold) return 
                notify_fail("你身上没有金子。\n");
        
        if( !objectp(ob = present(arg, me)) )
                return notify_fail("你身上没有这样东西。\n");
        if(me->is_busy())
                return notify_fail("你上一个动作还没有完成。\n");
        
        if( !ob->query("weapon_prop") )
                return notify_fail("你只能祭可当作武器的东西。\n");
        if( ob->query("equipped") )
                return notify_fail("你不可祭装备著了的武器。\n");
        if( !ob->query("owner") )
                return notify_fail("你只可祭自己打造的武器。\n");
        
        base= (int)ob->query("base_damage");
        current = (int) ob->query("weapon_prop/damage");
        for(j=1;j<=100;j++)
        {
                base = base + j;
                if(base >= current) break;
        }
        for(i=1; i<=j;i++)
                        cost = cost * 2;
        if((int) gold->query_amount() < cost)
                return notify_fail("你身上没带够" + sprintf("%d",cost)+ "两金子。\n");
        gold->add_amount(-cost);
        me->start_busy(1);
        me->add("bellicosity",cost);
        seteuid(ROOT_UID);
        
        // need to update 3 things: damage, rigidity, and weight
        ob->add("weapon_prop/damage",j);
        ob->set("weight",(int)ob->query("weight")+j*100);
        ob->add("rigidity",j*10);
        
        //更新
        ob->save();
        ob->restore();
        
        if(ob->move(me))        
        message_vision("$N向"+ob->name()+"上啐了一口带血的唾沫，剑刃上血光一闪，$N说道：好了！\n",this_object());
        seteuid(getuid());
        return 1;
}
