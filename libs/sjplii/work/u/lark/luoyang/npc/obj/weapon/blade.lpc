// blade.c
#include <ansi.h>
#include <weapon.h>

inherit BLADE;

void create()
{
        set_name(GRN "柔情" NOR, ({ "blade" }) );
        set_weight(4000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "柄");
                set("value", 70000);
                set("material", "steel");
                set("long", "精铁淬火精心锻造的，份量大约六、七斤重,刀身成燕翅状,刀柄处暗刻“厉”证明是干将坊的产品\n");
                set("wield_msg", CYN "$N一反手腕从腰间抽出了一柄明晃晃的钢刀，锋刃出隐隐显出青色\n" NOR);
                set("unequip_msg", CYN "$N舞了刀花归刀入鞘,你觉得四周寒意大减\n" NOR);
        }
        init_blade(30);
        setup();
}


