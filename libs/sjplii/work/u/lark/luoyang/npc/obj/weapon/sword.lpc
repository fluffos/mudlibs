// sword.c : an example weapon
#include <ansi.h>
#include <weapon.h>

inherit SWORD;

void create() {
  set_name(MAG "爱人" NOR, ({ "sword" }));
  set_weight(7500);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long", "爱人随着时光的流失越来越平淡,但却会在你需要的时候陪在你的左右\n"
      "剑锷处暗刻“厉”，证明是干将坊的产品\n");
    set("value", 70000);
    set("material", "steel");
    set("wield_msg", CYN "$N手指暗扣机簧，「苍朗」一声$n\n" NOR
      CYN "弹出剑鞘跃入手中。\n" NOR);
    set("unwield_msg", CYN "$N一抖手腕$n顺势扣进剑鞘.\n" NOR);
  }
  init_sword(50);
  setup();
}
