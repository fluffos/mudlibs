// dingx.c
#include <ansi.h>
#include <armor.h>

inherit HEAD;

void create() {
  set_name(YEL "康乃馨" NOR, ({ "flower" }));
  set_weight(10);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "康乃馨象征母爱，花语为健康长寿\n");
    set("unit", "枝");
    set("value", 100);
    set("armor_prop/personality", 5);
  }
  set("wear_msg", "$N细心地把康乃馨别在鬓角\n");
  set("unequip_msg", "$N从发间取下康乃馨\n");
  setup();
}
