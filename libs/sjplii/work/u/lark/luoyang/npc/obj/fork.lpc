#include <ansi.h>
#include <weapon.h>

inherit FORK;

void create()
{
        set_name("铁叉", ({ "fork" }) );
        set_weight(2000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "柄");
                set("long", "一柄普通的铁叉\n");
                set("value", 400);
                //set("rigidity", 50);
                set("material", "steel");
                //set("wield_msg",  "$N掳起袖子，执起一柄$n，红缨在风中微微抖动十分威风.\n");
                //set("unwield_msg",  "$N放下手中的$n。\n" );
        }

        init_fork(20);
        setup();
}


