#include <ansi.h>
#include <weapon.h>

inherit AXE;

void create()
{
        set_name(WHT "云薄霄汉斧" NOR , ({ "axe" }) );
        set_weight(4000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "柄");
                set("long", "宽厚的斧身，锋利的刃口，显示出无坚不摧的力量，斧面上暗刻“厉”，证明是干将坊的产品\n");
                set("value", 70000);
                set("rigidity", 50);
                set("material", "steel");
                set("wield_msg",  "$N从身后抽出一柄$n交叉而握，自有一股不凡的气势.\n");
                set("unwield_msg",  "$N放下手中的$n。\n" );
        }

        init_axe(50);
        setup();
}




