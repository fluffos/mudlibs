// dingx.c
#include <ansi.h>
#include <armor.h>

inherit HEAD;

void create()
{
        set_name(MAG "牡丹花" NOR, ({"flower"}));
        set_weight(10);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long", "牡丹花象征花王,花语为花开富贵\n");
                set("unit", "枝");
                set("value", 100);
                set("armor_prop/personality", 5);
        }
        set("wear_msg","$N细心地把牡丹花别在鬓角\n");
        set("unequip_msg", "$N从发间取下牡丹花\n");
        setup();
}

