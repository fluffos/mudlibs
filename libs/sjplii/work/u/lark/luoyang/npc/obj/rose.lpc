// dingx.c
#include <ansi.h>
#include <armor.h>

inherit HEAD;

void create()
{
        set_name(HIR "红玫瑰" NOR, ({"flower"}));
        set_weight(10);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long", "红玫瑰象征爱情，其花语为我真心爱你。\n");
                set("unit", "枝");
                set("value", 100);
                set("armor_prop/personality", 5);
        }
        set("wear_msg","$N细心地把红玫瑰别在鬓角\n");
        set("unequip_msg", "$N从发间取下红玫瑰\n");
        setup();
}

