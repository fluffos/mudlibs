// dumpling.c

inherit ITEM;
inherit F_FOOD;

void create()
{
        set_name("芒果", ({ "mangguo" }) );
        set_weight(80);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long", "一个香舔诱人的芒果，看上去已熟透了。\n");
                set("unit", "个");
                set("value", 100);
                set("food_remaining", 3);
                set("food_supply", 60);
        }
}

