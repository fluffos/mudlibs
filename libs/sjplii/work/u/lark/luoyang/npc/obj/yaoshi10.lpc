inherit ITEM;

void create()
{
        set_name("钥匙", ({ "yaoshi", "钥匙"}) );
        set_weight(50);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "把");
                set("long", "一把长长的有点生锈的钥匙，可以用来打开(use key)房门，上面挂了个牌子。\n");
                set("owner","awukezhan");
                set("value", 50);
        }
}

void init()
{
        add_action("do_use", "open");
        add_action("do_close","close");
        add_action("do_look","look");
}

int do_look(string arg)
{
  string name;
  name=this_object()->query("num");
  if(arg=="yaoshi"){
  tell_object(this_player(),"一把钥匙下面挂着一个小铁牌\n");
  tell_object(this_player(),"上面刻:"+name);
  return 1;
  }
  return 0;
}


int do_use(string arg)
{
        object room,me,where;
        object ob,box;
        me=this_player();
        where=find_object("/u/lark/luoyang/storeroom");
        box=present("box10",where);
        if( arg != "box" && !present("yaoshi",me)) return 0;
        
        room = environment(me);
        if (room->query("luoyang/qq")){
                tell_object(me,"你打开了衣箱的门\n");
                
                box->move(room);

//                this_object()->set("used",1);
        }
        return 1;
}

int do_close(string arg)
{
        object room,me;
        object ob,box;
        me=this_player();
        room = environment(me);
         box=present("box10",room);
        if( arg != "box" && !present("yaoshi",me)) return 0;
        
        
        if (room->query("luoyang/qq")){
               // ob=present(box,room)  
         tell_object(me,"你关上了衣箱\n");                                                               box->move("/u/lark/luoyang/storeroom");

//                this_object()->set("used",1);
        }
        return 1;
}

