// dumpling.c
#include <ansi.h>
inherit ITEM;


void create() {
  set_name(HIY "香皂" NOR, ({ "xiangzao" }));
  set_weight(80);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一块舶来的异国洗浴物上面有奇异的文字 luxe\n");
    set("unit", "块");
    set("value", 100);
    //                set("food_remaining", 30);
    //                set("food_supply", 80);
  }
}
