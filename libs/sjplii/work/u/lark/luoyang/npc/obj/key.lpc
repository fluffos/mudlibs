inherit ITEM;

void create() {
  set_name("钥匙", ({ "key", "钥匙" }));
  set_weight(50);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long", "一把长长的有点生锈的钥匙，可以用来打开(use key)房门，上面挂了个牌子。\n");
    set("owner", "awukezhan");
    set("value", 50);
  }
}

void init() {
  add_action("do_use", "use");
}

int do_use(string arg) {
  object room, me;
  if (arg != "key" && arg != "钥匙") return 0;
  me = this_player();
  room = environment(me);
  if (room->query("wangsha/kezhan")) {
    me->move("/u/lark/luoyang/" + (string)me->query("room"));

    this_object()->set("used", 1);
  }
  return 1;
}
