#include <ansi.h>
int reply_him();
int kill_him();
inherit NPC;
string summon_more( object who);
void create()
{
        set_name(HIC "北门值日官" NOR, ({ "zhiri guan", "guan" }) );
        set("long",
"他负责洛阳北门的守护任务，虽然说职位不大，可是县官不如现管\n"
"要是没有看好形势我看你还是不要惹他\n");
        set("attitude", "heroism");
        set("pursuer", 1);
        set("vendetta_mark", "authority");
        set("str", 27);
        set("cor", 26);
        set("cps", 25);
        set("combat_exp", 400000+random(1000000));
        set("chat_chance_combat", 30);
        set("chat_msg_combat", ({
                "值日官大叫道：造反了 造反了。兄弟们给我上呀！\n",
                (: summon_more(this_object()) :),
        }) );
        set("inquiry", ([
                "有话好好说" : (: reply_him :),
                "nokill" : (: reply_him :),
                "进城": "呵呵，公事公办我也没有办法呀。。。。",
                "出城":"呵呵，公事公办我也没有办法呀。。。。",
              
                "通融通融":(:kill_him:),
                "in":(:kill_him:),
                
        ]));
        set_skill("unarmed", 70+random(100));
        set_skill("spear", 70+random(100));
        set_skill("parry", 70+random(100));
        set_skill("dodge", 70+random(100));
        set_skill("move", 100+random(100));
        set_skill("yang_spear",30);     //杨家枪法
        set_skill("xingyi-ken",30);     //形意拳
        set_temp("apply/dammage", 10);
        set_temp("apply/defense", 10);
        set_temp("apply/attack", 10);
        map_skill("unarmed","xingyi-ken");
        map_skill("spear","yang_spear");
        map_skill("parry","yang_spear");
        set_temp("apply/attack", 70);
        set_temp("apply/defense", 70);
        set_temp("apply/damage", 30+random(200));
        set_temp("apply/armor", 70);
        set_temp("apply/move", 100);

        setup();

         carry_object("/d/city/obj/cloth/bingfu")->wear();
        
        carry_object("/obj/weapon/longspear")->wield();
}

string summon_more(object who)
{
 int i;
 object ob;
for(i;i<=random(3)+1;i++)
{
ob = new(__DIR__"npc/bing");
if(ob) ob->move(environment(who));
message_vision("$N从城门楼上冲了下来．．．\n", ob);
ob->kill_ob(this_player());
}
return "1";
}

int kill_him()
{
   command("heihei");
   command("say 有些事情到是可以通融有些事情可就要看你怎么做人了。。。。。\n");
   this_player()->set_temp("okin",1);
   return 1;
}

int reply_him()
{
   command("heihei");
   command("say 不是我不给你面子，可是兄弟们受了你的气。。。。。这也要个说法呀？\n");
   this_player()->set_temp("nokill",1);
   return 1;
}


int accept_object(object who, object ob)
{
                if( (int)ob->value() >= 50000 && who->query_temp("nokill") ) {
                        
                        say("值日官呵呵的笑道：好说，好说...\n");
                        who->set("vendetta/authority", 0);
                        who->remove_all_killer();
                        who->delete_temp("nokill");
                        who->add("life_exp",100);
                        who->add("relation_exp",100);
                        return 1;
                } 
               if( (int)ob->value() >= 10000 && who->query_temp("okin") ) {
                        say("值日官呵呵的笑道：好说，好说...\n");
                        who->set_temp("ok");
                        who->delete_temp("okin");
                        who->add("life_exp",100);
                        who->add("relation_exp",100);
                        return 1;
                   }
             

  say("你 。。。这是干什么？腐蚀领导干部？\n");
                        return 0;
                
 
} 

