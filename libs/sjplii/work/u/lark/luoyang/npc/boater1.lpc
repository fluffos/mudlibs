// boater1.c

inherit NPC;

void do_hua();

void create()
{
        set_name("梢公", ({ "boater" }) );
        set("gender", "男性");
        set("age", 41);
        set("chat_chance",15);
        set("chat_msg", ({
        (: do_hua :) }), );
        setup();
//      carry_object(__DIR__"obj/sticket");
}

void do_hua()
{

  /******************************************************!!!!!!!!!!!!!!!!!!!!!!
    
    NEED CHANGE THE THE DIRECTORY NAME!!!!!!!!!!!!!!!!!!!!!!!!!!
    
    **************************************************************************/

        object ob,ob1;
        
        if(ob = present("nticket",this_object())){
          destruct(ob);
          if (ob = find_object("/u/wuhan/dukoun")){
            tell_room(ob,"梢公说: 船来了!!\n");
            tell_room(environment(),"梢公说: 到了!!\n");
            environment()->set("exits/out","/u/wuhan/dukoun");
            ob1 = new("/u/wuhan/obj/boat");
            ob1->move(ob);
          }
          return;
        }
        if(ob = present("sticket",this_object())){
          destruct(ob);
          if (ob = find_object("/u/wuhan/dukous")){
            tell_room(ob,"梢公说: 船来了!!\n");
            tell_room(environment(),"梢公说: 到了!!\n");
            environment()->set("exits/out","/u/wuhan/dukous");
            ob1 = new("/u/wuhan/obj/boat");
            ob1->move(ob);
            return;
          }
        }
//      command("say ............\n");
        return;
}

