#include <ansi.h>

inherit NPC;
int do_ask();
int do_qi();
int ok();
void over();
void create()
{
        set_name("薛五", ({ "wue wu","xue" }) );
        set("long", "一个强壮的高个子男人是精武馆的教头.\n");
        set("attitude", "friendly");
        set("title","精武馆教头");
        set("age",30);
        set("str", 20);
        set("cor", 20);
        set("cps", 20);
        set("per",10);
/*
        set("inquiry", ([
         "上面":(:do_ask:),
         "棋局": "珍珑，珍珑。。。。。人间竟然真的存在那样的棋手么？\n"
                 "但要是没有。。那又有谁能摆出那样的。。。珍珑....\n",
         "比试":(:ok:),
         "下棋":(:ok:),
     
]));
*/
       set("chat_chance", 3);
        set("chat_msg", ({
           "薛五摇头说:应该这样。说完向旁边的弟子比画了两下\n",
           "薛五点头说:对就是这样的。\n",
}) );        
        set("combat_exp", 500000);
//        set_skill("force",50);
        set_skill("finger",50);
        set_skill("unarmed",50);
        set_skill("parry",50);      
        set_skill("sword",50);
        set_skill("whip",50);
        set_skill("staff",50);
        set_skill("stick",50);
        set_skill("axe",50);
        set_skill("dodge",50);
        set_skill("spear",50);
        set_skill("hammer",50);
        set_skill("blade",50);
        set_skill("fork",50);
        set_skill("throwing",50);
        set_skill("dagger",50);
        set_skill("spear",50);
        set_temp("apply/attack", 20);
        set_temp("apply/defense", 20);
        set_temp("apply/move", 20);
/*
        set("chat_chance_combat", 50);
        set("chat_msg_combat", ({
             
             (: perform_action, "unarmed.rain" :),
             (: perform_action, "unarmed.flower" :),
             (: perform_action, "dodge.walk" :),
                
        }) );
*/       
        set("relation_exp", 90000);     //设置人际关系
        set("life_exp", 50000);         //设置江湖阅历
              
        
        setup();

        carry_object("/obj/cloth")->wear();
        
}


void init()
{
        add_action("do_app", ({"apprentice"}));
        add_action("do_lian",({"lianxi"}));        
}


int do_app(string arg)
{
        object ob=this_player();
        if(!ob->query("jingwu/dizi"))
            return notify_fail("薛五难堪的说:阁下虽然说....但是我也的养家糊口呀\n");
        if(arg == "xue" || arg=="xue wu" || arg=="薛五"){
         message_vision("$N向薛五请教关于武学的疑问.\n",this_player() );
         
            
           command("say 全民健身,强我中华\n");
                ob->set("marks/薛五", 1);
                return 1;
                    
         }
        
        return (int)call_other("/cmds/std/apprentice", "main", ob, arg);
} 

int recognize_apprentice(object ob)
{
        if( !ob->query("marks/薛五") ) return 0;
        return 1;
}

int do_lian(string arg)
{
   object ob;
   
   if(!arg)
        return notify_fail("你要练习什么兵器？\n");
   if( !ob = this_player()->query_temp("weapon"))
        return notify_fail("你没有装备兵器呀？\n");
   if(!living(this_object()))
        return 0;
   if (objectp(ob)
        && (string)ob->query("skill_type") == "sword"){
  this_player()->improve_skill("sword",(int)this_player()->query("int"));
  message_vision("$N在$n的指点下练习了剑法，似乎略有所悟\n",this_player(),this_object());
    return 1;
   }
   if (objectp(ob)
        && (string)ob->query("skill_type") == "blade"){
  this_player()->improve_skill("blade",(int)this_player()->query("int"));
  message_vision("$N在$n的指点下练习了刀法，似乎略有所悟\n",this_player(),this_object());
    return 1;
   }
  if (objectp(ob)
        && (string)ob->query("skill_type") == "axe"){
  this_player()->improve_skill("axe",(int)this_player()->query("int"));
  message_vision("$N在$n的指点下练习了斧法，似乎略有所悟\n",this_player(),this_object());
    return 1;
   }
  if (objectp(ob)
        && (string)ob->query("skill_type") == "whip"){
  this_player()->improve_skill("whip",(int)this_player()->query("int"));
  message_vision("$N在$n的指点下练习了鞭法，似乎略有所悟\n",this_player(),this_object());
    return 1;
   }
  if (objectp(ob)
        && (string)ob->query("skill_type") == "staff"){
  this_player()->improve_skill("staff",(int)this_player()->query("int"));
  message_vision("$N在$n的指点下练习了杖法，似乎略有所悟\n",this_player(),this_object());
    return 1;
   }
  if (objectp(ob)
        && (string)ob->query("skill_type") == "stick"){
  this_player()->improve_skill("stick",(int)this_player()->query("int"));
  message_vision("$N在$n的指点下练习了棍法，似乎略有所悟\n",this_player(),this_object());
    return 1;
   }
  if (objectp(ob)
        && (string)ob->query("skill_type") == "spear"){
  this_player()->improve_skill("spear",(int)this_player()->query("int"));
  message_vision("$N在$n的指点下练习了枪法，似乎略有所悟\n",this_player(),this_object());
    return 1;
   }
  if (objectp(ob)
        && (string)ob->query("skill_type") == "dagger"){
  this_player()->improve_skill("dagger",(int)this_player()->query("int"));
  message_vision("$N在$n的指点下练习了戟法，似乎略有所悟\n",this_player(),this_object());
    return 1;
   }
  if (objectp(ob)
        && (string)ob->query("skill_type") == "hammer"){
  this_player()->improve_skill("hammer",(int)this_player()->query("int"));
  message_vision("$N在$n的指点下练习了锤法，似乎略有所悟\n",this_player(),this_object());
    return 1;
   }
 if (objectp(ob)
        && (string)ob->query("skill_type") == "fork"){
  this_player()->improve_skill("fork",(int)this_player()->query("int"));
  message_vision("$N在$n的指点下练习了叉法，似乎略有所悟\n",this_player(),this_object());
    return 1;
   }
 return 0;
}
