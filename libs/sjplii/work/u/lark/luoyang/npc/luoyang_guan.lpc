#include <ansi.h>
inherit NPC;
inherit F_MASTER;
int help();
int gethim(object target, object me);
int throwin(object who);
int throw(object who);
int over(object who);
string summon_more(object obj);
void create() {
  set_name("阮吾能", ({ "ruan wuneng", "master", "ruan", "阮吾能" }));
  set("long",
    "洛阳城中最高的官，有至高无上的权力\n");
  set("attitude", "heroism");
  set("title", RED "洛阳城守" NOR);
  set("student_title", "官员");
  create_family("朝廷", 7, "官员");
  set("vendetta_mark", "authority");
  set("str", 27);
  set("cor", 26);
  set("cps", 25);
  set("agi", 25);
  set("int", 30);
  set("chat_chance_combat", 90);
  set("chat_msg_combat", ({
    (: summon_more(this_object()) :),
    (: command, "escort" :),
  }));
  //        set("inquiry", ([
  //         "告状" : (: help :),
  //            ]) );
  set("combat_exp", 90000000);
  set_temp("apply/damage", 500);
  set_skill("unarmed", 200);
  set_skill("sword", 100);
  set_skill("force", 80);
  set_skill("parry", 120);
  set_skill("dodge", 110);
  set_skill("move", 100);
  set_skill("literate", 100);
  set_skill("leadership", 150);
  set_skill("economics", 150);
  set_skill("officialism", 250);
  map_skill("literate", "economics");
  setup();

  //        carry_object(__DIR__"obj/guanfu")->wear();
}

void init() {
  add_action("do_gao", "gao");
}

int do_gao(string arg) {
  int n, i;
  object *user;
  object me, target, ob;
  string zui;

  if (!arg || sscanf(arg, "%s %s", arg, zui) != 2)
    return notify_fail("指令格式：gao  <name> <罪状>\n");

  if (this_player()->is_busy())
    return notify_fail("你上一个动作还没有完成。\n");

  user = users();
  for (i = 0; i < sizeof(user); i++) {
    if (user[i]->query("id") == arg) target = user[i];
    else continue;
  }
  if (!target) return notify_fail("找不到你想要的疑犯！\n");

  if (!this_player()->query_temp("permit")) {
    message_vision("阮吾能怒道:你把这里当成什么地方了,你有什么证据么?告状可不是那么容易的\n", this_player());
    command("heihei");
    return 1;
  }

  switch (zui) {
    case "乱穿马路":
      n = random(5);
      if (n == 1) {
        message_vision("阮吾能怒道:$N你怎么能诬告良好市民?给我打进大牢去\n", this_player());
        this_player()->set("time", 5);
        this_player()->set_temp("zui", "诬告罪");
        call_out("throw", 1, this_player());
        return 1;
      }
      command("nod");
      target->set_temp("zui", "乱穿马路");
      target->set("time", 5);
      message_vision("阮吾能点了点头:我也早闻$N的劣迹,这次一定要把他抓捕归案\n", target);
      this_player()->delete_temp("permit");
      call_out("over", 1800, target);
      call_out("throwin", 1, target);

      break;
    case "随地吐痰":
      n = random(4);
      if (n == 1) {
        message_vision("阮吾能怒道:$N你怎么能诬告良好市民?给我打进大牢去\n", this_player());
        this_player()->set_temp("zui", "诬告罪");
        this_player()->set("time", 10);
        call_out("throw", 1, this_player());
        return 1;
      }
      command("nod");
      target->set("time", 10);
      target->set_temp("zui", "随地吐痰");
      message_vision("阮吾能点了点头:我也早闻$N的劣迹,这次一定要把他抓捕归案\n", target);
      this_player()->delete_temp("permit");
      call_out("throwin", 1, target);
      call_out("over", 1800, target);

      break;
    case "拐带幼女":
      n = random(3);
      if (n == 1) {
        message_vision("阮吾能怒道:$N你怎么能诬告良好市民?给我打进大牢去\n", this_player());
        this_player()->set_temp("zui", "诬告罪");
        this_player()->set("time", 15);
        call_out("throw", 1, this_player());

        return 1;
      }
      command("nod");
      target->set("time", 15);
      target->set_temp("zui", "拐带幼女");
      message_vision("阮吾能点了点头:我也早闻$N的劣迹,这次一定要把他抓捕归案\n", target);
      this_player()->delete_temp("permit");
      call_out("throwin", 1, target);
      call_out("over", 1800, target);

      break;
    case "乱扔果皮":
      n = random(2);
      if (n == 1) {
        message_vision("阮吾能怒道:$N你怎么能诬告良好市民?给我打进大牢去\n", this_player());
        this_player()->set_temp("zui", "诬告罪");
        this_player()->set("time", 20);
        call_out("throw", 1, this_player());
        return 1;
      }
      target->set("time", 20);
      target->set_temp("zui", "乱扔果皮");
      command("nod");
      this_player()->delete_temp("permit");
      message_vision("阮吾能点了点头:我也早闻$N的劣迹,这次一定要把他抓捕归案\n", target);
      call_out("throwin", 1, target);
      call_out("over", 1800, target);
      break;
  }
  return 1;
}
int throw(object who) {
  object where;
  where = find_object("/u/lark/luoyang/dalao");
  CHANNEL_D->do_channel(this_object(), "rumor", sprintf("%s因为诬告罪被投入了洛阳大牢.\n", who->name(1)));


  message_vision("从堂后冲出几个衙役用铁链套住$N的脖子拉走了\n", who);
  who->move(where);
  tell_room(where, "突然从门外扔进一个人来,倒在地上昏迷不醒了\n");
  who->set("zuiren", 1);

  who->unconcious();
  who->delete_temp("permit");
  return 1;

}

int throwin(object who) {
  string zui;
  zui = who->query_temp("zui");
  if (!who)
    return notify_fail("犯人找不到..\n");

  CHANNEL_D->do_channel(
    this_object(),
    "rumor",
    sprintf("%s因为" + zui + "正在受到洛阳官府的通缉.\n", who->name(1))
  );

  who->set("zuiren", 1);
  return 1;
}
int over(object who) {
  object where;
  where = find_object("/u/lark/luoyang/dalao");
  if (who->query("zuiren")) {
    CHANNEL_D->do_channel(
      this_object(),
      "rumor",
      sprintf("洛阳官府因为过了诉讼时效取消了对%s的通缉.\n", who->name(1))
    );
    who->delete("zuiren");
    return 1;
  }

  return 1;
}


void attempt_apprentice(object me) {
  if (!me->query("class")) {
    command("smile");
    command("say 很好！朝廷正在用人之时，努力吧！\n");
    command("recruit " + me->query("id"));
    remove_call_out("re_rank");
    call_out("re_rank", 1, me);
    return;
  }
  if (me->query("id_type") == 3) {
    command("say 你已经是吏部的官员了！\n");
  }
  if (me->query("id_type") == 4) {
    command("say 你已经是兵部的官员了！\n");
  } else
    command("say 朝廷不需要你这种不三不四，来历不明之人！\n");
}

void recruit_apprentice(object ob) {
  if (::recruit_apprentice(ob))
    ob->set("class", "official");
  ob->set("vendetta_mark", "authority");
  ob->set("id_type", 5);
  ob->set("title", RED "洛阳府衙役" NOR);
}
void re_rank(object student) {
  int exp;
  exp = (int)student->query("relation_exp") * 10 + (int)student->query("life_exp");
  if (exp <= 300000) {
    student->set("title", RED "洛阳府衙役" NOR);
    return;
  } else if (exp <= 500000) {
    student->set("title", RED "洛阳府捕快" NOR);
    return;
  } else if (exp <= 700000) {
    student->set("title", RED "洛阳府捕头" NOR);
    return;
  } else if (exp <= 1000000) {
    student->set("title", RED "洛阳府名捕" NOR);
    return;

  } else
    student->set("title", RED "洛阳府神捕" NOR);
  return;

}
string summon_more(object who) {
  object soldier;
  seteuid(getuid());
  soldier = new("/obj/npc/bodyguard");
  soldier->move(environment(who));
  command("escort");
  return "1";
}

int accept_object(object who, object ob) {
  int som;
  som = ob->value();
  if (som >= 100000) {
    command("heihei");
    command("say 这位大爷不知有什么吩咐?\n");
    tell_object(this_player(), "你可以告 乱穿马路 随地吐痰 拐带幼女 乱扔果皮\n");
    who->set_temp("permit", 1);
    return 1;
  }
  return 0;
}
