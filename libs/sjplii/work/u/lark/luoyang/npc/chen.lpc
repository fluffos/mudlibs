#include <ansi.h>

inherit NPC;
int do_ask();
int do_qi();
int ok();
void over();
void create() {
  set_name("陈真", ({ "chen zhen", "chen" }));
  set("long", "一个形容威猛的高个男人,他就是闻名洛阳的精武馆的总教头.\n");
  set("attitude", "friendly");
  set("title", "精武馆总教头");
  set("age", 30);
  set("str", 20);
  set("cor", 20);
  set("cps", 20);
  set("per", 10);
  /*
        set("inquiry", ([
         "上面":(:do_ask:),
         "棋局": "珍珑，珍珑。。。。。人间竟然真的存在那样的棋手么？\n"
                 "但要是没有。。那又有谁能摆出那样的。。。珍珑....\n",
         "比试":(:ok:),
         "下棋":(:ok:),
     
]));
*/
  set("chat_chance", 3);
  set("chat_msg", ({
    "陈真语重心长的说:人民强则国家盛\n",
    "陈真语重心长的说:男儿当自强\n",
  }));
  set("combat_exp", 2000000);
  //set_skill("force",100);

  //        set_skill("mizong-quan",200);
  set_skill("unarmed", 200);
  //        map_skill("unarmed","mizong-quan");      
  set_skill("sword", 50);
  set_skill("whip", 50);
  set_skill("staff", 50);
  set_skill("stick", 50);
  set_skill("axe", 50);

  set_skill("spear", 50);
  set_skill("hammer", 50);
  set_skill("blade", 50);
  set_skill("fork", 50);
  set_skill("throwing", 50);
  set_skill("dagger", 50);
  set_skill("spear", 50);
  set_temp("apply/attack", 20);
  set_temp("apply/defense", 20);
  set_temp("apply/move", 20);
  /*
        set("chat_chance_combat", 50);
        set("chat_msg_combat", ({
             
             (: perform_action, "unarmed.rain" :),
             (: perform_action, "unarmed.flower" :),
             (: perform_action, "dodge.walk" :),
                
        }) );
*/
  set("relation_exp", 90000);     //设置人际关系
  set("life_exp", 50000);         //设置江湖阅历


  setup();

  carry_object("/obj/cloth")->wear();

}

void init() {
  add_action("do_app", ({ "apprentice" }));

}


int do_app(string arg) {
  object ob = this_player();
  if (!ob->query("jingwu/dizi"))
    return notify_fail("陈真难堪的说:阁下虽然说....但是我也的养家糊口呀\n");
  if (!ob->query("jingwu/permit"))
    return notify_fail("陈真摇了摇头道：你和薛教头请教一下吧!\n");

  if (arg == "chen" || arg == "chen zhen" || arg == "陈真") {
    message_vision("$N向陈真请教关于武学的疑问.\n", this_player());
    command("say 全民健身,强我中华,打倒北约，血洗国辱。\n");
    ob->set("marks/陈真", 1);
    return 1;

  }

  return (int)call_other("/cmds/std/apprentice", "main", ob, arg);
}

int recognize_apprentice(object ob) {
  if (!ob->query("marks/陈真")) return 0;
  return 1;
}
