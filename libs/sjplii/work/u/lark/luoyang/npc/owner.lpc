// xian. 冼老板
#include <ansi.h>
inherit NPC;

void create()
{
        set_name("李掌柜", ({ "li zhanggui","li","zhanggui","李掌柜" }));
        set("title", HIG"阿五客栈老板"NOR);

        set("str", 50);
        set("gender", "男性");
        set("age", 45);
        set("long", "李老板经营这间客栈据说已有多年，但也有人说老板另有其人，李老板只是那个人的手下。\n");
        set("combat_exp", 500000);
        set("max_kee", 4000);
        set("attitude", "friendly");
        set_skill("unarmed", 260);
        set_skill("dodge", 260);
        set_skill("move",200);
        set_temp("apply/attack", 300);
        set_temp("apply/defense", 300);
        set_temp("apply/damage",200);
        set("room1",0);
        set("room2",0);
        set("room3",0);
        set("room4",0);
        set("room5",0);
        set("room6",0);
        set("room7",0);
        set("room8",0);
        set("room9",0);

        setup();
        add_money("gold", 1);
        carry_object(__DIR__"obj/cloth")->wear();
}

int accept_object(object who, object ob)
{
        
        object key;
        object obj=this_object();
        object me=this_player();
        if (ob->query("money_id") && ob->value() >= 3000) 
        {
                if (!obj->query("room1"))       me->set("room","room1");
                else if (!obj->query("room2"))  me->set("room","room2");
                else if (!obj->query("room3"))  me->set("room","room3");
                else if (!obj->query("room4"))  me->set("room","room4");
                else if (!obj->query("room5"))  me->set("room","room5");
                else if (!obj->query("room6"))  me->set("room","room6");
                else if (!obj->query("room7"))  me->set("room","room7");
                else if (!obj->query("room8"))  me->set("room","room8");
                else if (!obj->query("room9"))  me->set("room","room9");
                else return notify_fail("李老板叹了口气道：这位客官真是不好意思，本店刚刚客满。\n");
                say("李老板哈哈一笑，说道：多谢这位"+ RANK_D->query_respect(ob)+"，请到后院歇息。\n");
                message_vision("李老板说完，递给$N一把钥匙。\n",this_player());
                key = new(__DIR__"obj/key");
                key->move(this_player());
                return 1;
        }else if(ob->query("owner")=="awukezhan")
        {
                say("李老板冷笑道：这位"+ RANK_D->query_respect(ob)+"莫非是开我的玩笑，可惜按本店规矩向不退款。\n");
                destruct(ob);
                return 1;
        }
        return 0;
}

