#include <ansi.h>

inherit NPC;
int do_dao();
int do_qiang();
int do_jia();
int do_dagger();
int do_axe();
int do_fork();
int do_hammer();
int do_stick();
int do_staff();
int do_whip();
int do_sword();
void create() {
  set_name("吴七", ({ "wu qi", "wu" }));
  set("long", "为弟子们分发武器的人。\n");
  set("attitude", "friendly");
  set("age", 50);
  set("title", "精武馆");
  set("str", 10);
  set("cor", 10);
  set("cps", 10);


  set("inquiry", ([
    "刀": (: do_dao :),
    "枪": (: do_qiang :),
    "戟": (: do_dagger :),
    "斧": (: do_axe :),
    "叉": (: do_fork :),
    "锤": (: do_hammer :),
    "棍": (: do_stick :),
    "杖": (: do_staff :),
    "鞭": (: do_whip :),
    "剑": (: do_sword :),
  ]));
  set("combat_exp", 2000);
  set_skill("spear", 20);
  set_skill("unarmed", 20);
  set_skill("blade", 20);
  set_skill("parry", 20);
  set_skill("dodge", 20);
  set_skill("move", 20);

  set_temp("apply/dammage", 5);
  set_temp("apply/defense", 5);
  set_temp("apply/attack", 5);

  setup();

  carry_object("/obj/cloth")->wear();

}

int do_dao() {
  object me, ob;
  me = this_player();
  if (!me->query("jingwu/dizi")) {
    write(RED "吴七摇了摇头：你似乎不是这里的弟子呀！\n" NOR);
    return 1;
  }
  if (present("blade", me)) {
    write(RED "吴七摇了摇头：“你不是有了么？还要?”\n" NOR);
    return 1;
  }
  ob = new("/obj/blade");
  message_vision("吴七从库房里取出一把刀交给了$N\n" NOR, me);
  ob->move(me);
  return 1;
}


