    write(RED "吴七摇了摇头：“你不是有了么？还要?”\n" NOR);
    return 1;
  }
  ob = new(__DIR__ "obj/spear"); ;
  message_vision("吴七从库房里取出一杆枪交给了$N\n" NOR, me);
  ob->move(me);
  return 1;
}

