// teacher.c

inherit NPC;

void create()
{
        set_name("薛文潜", ({ "xue wenqian", "xue" }) );
        set("title", "洛阳第一大才子");
        set("gender", "男性" );
        set("age", 47);
        set("int", 26);
        set("long",
                "他年轻时曾经中过举人，但是\n"
                "因为生性喜爱读书不愿做官，\n"
                "因此在这里开了这个书院\n");
        set("attitude", "peaceful");
        set_skill("literate", 300);
        setup();
}

int recognize_apprentice(object ob)
{
    if(!this_player()->query("薛文潜/learn"))
         return notify_fail("薛文潜摇头道：知识也是一种产业，是要进行等价交换的呀.\n");
    this_player()->add("薛文潜/learn",-1);
        return 1;
}

int accept_object(object who, object ob)
{
   int som;
   som = ob->value();
   som=som/100;
   who->set("薛文潜/learn",som);
   command("say 科学技术是第一生产力，只有掌握了高新技术才能永远领先一步\n");
   return 1;
}

