//sleeproom.c

inherit ROOM;

void create() {
  set("short", "休息室");
  set("long", @LONG
这里是精武馆的休息室,弟子们练功勤奋如果累了到可以
在这里小憩.
LONG
  );
  set("sleep_room", 1);
  set("exits", ([
    "west": __DIR__ "jwhall",
  ]));
  set("no_fight", 1);
  set("no_magic", 1);

  set("no_clean_up", 1);
  setup();
  replace_program(ROOM);
}
