// marry_room.c
#include <room.h>
inherit ROOM;
string look_sign(object me);
void create() {
  set("short", "动心水榭");
  set("long", @LONG
她(他)让你心动了?那是你也许万年前的等待,现在他(她)
终于出现在了你面前,不要错过.（ｓｉｇｎ）。
LONG
  );
  set("exits", ([
    "north": __DIR__ "lye1",
  ]));

  set("item_desc", ([
    "sign": (: look_sign :),
  ]));

  set("objects", ([
    __DIR__ "npc/mei_po": 1,
  ]));

  setup();

}

string look_sign(object me) {
  return "缔结（ｍａｒｒｙ）或解除（ｕｎｍａｒｒｙ）婚约。\n";
}
