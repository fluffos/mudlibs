// dukous.c

inherit ROOM;

void create() {
  set("short", "洛河南渡口");
  set("long", @LONG
这里是黄河的一条支流。过了河继续往北就是都城长安了。
要是需要过江就喊guojiang.船家会来载你过去。
LONG
  );

  set("exits", ([ /* sizeof() == 2 */
    "south": __DIR__ "road9",
  ]));
  set("objects", ([
    __DIR__ "npc/chief": 1,
  ]));
  setup();
}

void init() {
  add_action("do_jiaochuan", ({ "guojiang" }));
}

int do_jiaochuan() {
  object ob, ob1;
  message_vision("$N对着江面喊道: 船..家...渡我过江...\n", this_player());
  if (query("exits/enter"))
    return notify_fail("船已经在这儿了, 你可以上船(enter).\n");
  set("exits/enter", __DIR__ "boat");
  message_vision("船家对$N应道：来...啦.....\n", this_player());
  write("船来了，你可以上船(enter).\n");
  if (ob = find_object(__DIR__ "boat")) ob->set("exits/out", __DIR__ "dukous");
  call_out("kaichuan_s", 10);
  call_out("daoan_s", 20);
  return 1;
}
void kaichuan_s() {
  object ob;
  if (ob = find_object(__DIR__ "boat")) {
    ob->delete("exits/out");
    message("vision", "船夫收起了跳板，把船缓缓驶出江心。\n", ob);
  }
  message("vision", "船夫收起了跳板，把船缓缓驶出江心。\n", this_object());
  delete("exits/enter");
  return;
}
void daoan_s() {
  object ob;
  if (ob = find_object(__DIR__ "boat")) {
    ob->set("exits/out", __DIR__ "dukoun");
    message("vision", "船夫放下跳板，大声叫道：“船到岸啦！客官请上岸。\n", ob);
  }
  return;
}
