 inherit ROOM;
#include <room.h>

void create()
{
        set("short", "浴池");
        set("long", @LONG
一入门，热气扑面，白白的水气立刻包围了你。你依稀看到一个巨大的檀木水池,
水呈碧绿，散发着一种奇特的药香，水面上还漂着一片片红红的花瓣儿，你真想一下
子跳进去，闭上眼睛好好的放松(enjoy)一下。
LONG
        );
        set("exits", ([
                "south" : __DIR__"boy",
        ]));
        set("no_fight",1);
        set("no_magic",1);
        set("no_study",1);
        set("objects", ([
                __DIR__"npc/troublemaker": 2,
        ]) );
        setup();
//        create_door("east", "檀木门", "west", DOOR_CLOSED);

}

void init()
{
        add_action("do_jump", "enjoy");
        add_action("do_quit","quit");

}

int do_quit() {return 1;}

int do_jump()
{
        object me;
        int wait;
        me = this_player();
        wait = random( 40 - (int)(me->query("con"))) * 2;
        if ( wait <= 20) wait = 21;
        message_vision("$N噗嗵一声跳进浴池．\n",me);
        tell_object(me,"好爽\n");
        if(time()-(int)me->query("qq/time")<=1440*3){
        me->set("qq/time",time());
        return 1;
         }
        remove_call_out("curehimup");
        call_out("curehimup", wait, me);
return 1;
}

void curehimup(object me)
{
        int gin,kee,sen;
        gin=(int)me->query("max_gin");
        kee=(int)me->query("max_kee");
        sen=(int)me->query("max_sen");
        if( me && environment(me) == this_object())
        {
        
        if(present("xiangzao",me) && present("maojin",me)){
        message_vision("$N用香皂仔细的摩擦自己的身体,然后冲洗了,用毛巾擦拭干净,看上去很白净的样子\n", me);
        me->set("eff_gin",gin);
        me->set("eff_kee",kee);
        me->set("eff_sen",sen);
        me->set("gin", gin);
        me->set("kee", kee);
        me->set("sen", sen);
        return;
        }
        if(present("xiangzao",me) ){
         message_vision("$N用香皂仔细的摩擦着自己的身体,然后冲洗了,湿漉漉的跳出了浴池\n", me);
        me->set("eff_gin",gin/3*2);
        me->set("eff_kee",kee/3*2);
        me->set("eff_sen",sen/3*2);
        me->set("gin", gin/3*2);
        me->set("kee", kee/3*2);
        me->set("sen", sen/3*2);
        return;
         }
        if(present("maojin",me)){
         message_vision("$N简单冲洗了一下就跳出了浴池,用毛巾擦干了身体\n", me);
        me->set("eff_gin",gin/3*2);
        me->set("eff_kee",kee/3*2);
        me->set("eff_sen",sen/3*2);
        me->set("gin", gin/3*2);
        me->set("kee", kee/3*2);
        me->set("sen", sen/3*2);
        return;
         }
        
         me->set("eff_gin",gin/3);
        me->set("eff_kee",kee/3);
        me->set("eff_sen",sen/3);
        me->set("gin", gin/3);
        me->set("kee", kee/3);
        me->set("sen", sen/3);
        me->set("qq/time",time());
        return;
}
}

