void init()
{
add_action("do_quit","quit");
}
int do_quit(){ return 1;}
int valid_leave(object me, string dir)
{  
   int i;
   object *inv;
   if(dir=="north"){
  inv = all_inventory(me);
                for(i=0; i<sizeof(inv); i++)
                {
                if(objectp(inv[i]))
                return notify_fail("你带那么多家伙事儿怎么洗澡?\n");
               }
  
}
 return 1;
}


