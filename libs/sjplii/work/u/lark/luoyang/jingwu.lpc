inherit ROOM;
int check_container(object ob);
void create()
{
        set("short", "精武馆");
        set("long", @LONG
精武馆是专为出入江湖的朋友们设立的,只要按期(1个月)交纳一定费用(1 gold)
就可以在这里学习一些基本的防身功夫,虽然不是很高但是逃跑到也足够了,并为
以后到别的门派另投明师打个好基础.
    墙上贴着个贴子(tiezi)。
LONG );
        set("objects", ([
                __DIR__"npc/jiao" : 1,
        ]));
        set("no_fight",1);
        set("no_steal",1);
        set("no_beg",1);
        set("no_magic",1);
        set("item_desc", ([
            "tiezi" : @TEXT
武馆敬启：

㈠ 基本内功
㈡ 基本轻功
㈢ 基本招架
㈣ 基本拳脚：
㈤ 基本兵器：

─────────────────────────────
「精武馆」所传授基本武功
─────────────────────────────
基本轻功 (dodge)            基本拳法 (unarmed)
基本锤法 (hammer)           基本刀法 (blade)
基本招架 (parry)            基本棒法 (stick)
基本鞭法 (whip)             基本叉法 (fork)
基本杖法 (staff)            基本短刃 (dagger)
基本剑法 (sword)            基本指法 (finger)
基本指法 (finger)           基本暗器 (throwing)
基本枪法 (spear)            基本斧法 (axe)
─────────────────────────────
TEXT
        ]) );
        set("exits", ([
                "south"     : __DIR__"lye1",
                "north"     : __DIR__"jw1",
        ]));
        set("no_clean_up", 0);
        setup();
}

int valid_leave(object me, string dir)
{
  object ob;
  object *inv;
  int i;
  inv = all_inventory(me);
  if(dir=="south") return 1;
  if(!me->query("jingwu/dizi")) 
   return notify_fail("你没有报名哦\n");
   
  if(time()-me->query("jingwu/time")>=3600*24*30){
   this_player()->delete("jingwu/dizi");
   tell_object(this_player(),"你又该交学费了\n");
   return 0;
   }
     for(i=0; i<sizeof(inv); i++)
                {
                        if((int)inv[i]->query("weapon_prop"))
                        return notify_fail("不能带武器入内\n");
                        if((int)inv[i]->query("food_remaining") != 0)
                        return notify_fail("不能带食物入内\n");
                        if((int)inv[i]->query("liquid/remaining") !=0)
                        return notify_fail("不能带饮水入内\n");
                        if((int)inv[i]->is_container()) 
                        if(check_container(inv[i]))
                        return notify_fail("不能带食物和饮水入内\n");
                }
   return 1;   
}


int check_container(object ob)
{
object *inv;
int i;
inv = all_inventory(ob);
 for(i=0; i<sizeof(inv); i++)
 {
                        if(inv[i]->query("weapon_prop"))
                        return 1;
                        if(inv[i]->query("food_remaining") != 0)
                        return 1;
                        if(inv[i]->query("liquid/remaining") !=0)
                        return 1;
                        if(inv[i]->is_container()) 
                        if(check_container(inv[i]))
                        return 1;
 }
return 0;
}

