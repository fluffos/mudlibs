// room.c 

#include <ansi.h>
inherit ROOM;
void create() {
  set("short", HIR "新居" NOR);
  set("long", @LONG
你来到海青和舞语的新居。屋内的摆设很简单，土炕，
破桌，已经开始破损的窗户纸，在这个年代已是极为少见。
一看你就会明白这里的主人很是现代派。
LONG);
  //       set("sleep_room",1);
  set("item_desc", ([
    "土炕": "一张伴随lark多年的土炕，现在它又多了一位新主人zippy.\n"
  ]));
  setup();
}
void init() {
  add_action("do_sleep", "makelove");
  //add_action("do_agree","agree");
}
int do_sleep(string arg) {
  object obj, me;
  me = this_player();
  if (!arg || !objectp(obj = present(arg, environment(me))))
    return notify_fail("这件事情自己好象做不来\n");
  if (!living(obj))
    return notify_fail(obj->name() +
      "已经无法和你一起做了\n");
  if (obj == me) return notify_fail("你是自恋狂吗？\n");
  if (!userp(obj)) return notify_fail("你只可和玩家做这件事\n");
  if ((string)obj->query("gender") == (string)me->query("gender"))
    return notify_fail("同性恋？太领先于时代了吧？\n");
  if (userp(obj) && !obj->query_temp(me->query("id") + "m")) {
    message_vision(MAG "\n$N捅了捅$n小声说："
      "我们来........如何?\n\n" NOR, me, obj);
    me->set_temp(obj->query("id") + "m", 1);
    tell_object(obj, MAG "如果你愿意,就下一次makelove指令。\n" NOR);
    write(MAG
      "现在你急切盼望着你的心上人说同意...\n" NOR);
    return 1;
  }
  CHANNEL_D->do_channel(this_object(), "rumor",
    sprintf("%s 和 %s洞房花烛了! \n",


      me->name(1), obj->name(1)));
  message_vision(MAG "$N轻轻揽过$n,温柔的抚摩着$n的肌肤,贴了过去.........\n" NOR, me, obj);
  me->unconcious();

  obj->unconcious();
  return 1;
}

//houyuan.c ,by eesoft, John Darks
//后院
inherit ROOM;

void create() {

  set("short", "壹号客房");
  set("long", @LONG
这里是客栈的客房，可以看到外面院子中种满了花草树木，是以空气格外清新。
LONG);
  set("exits", ([
    "south": __DIR__ "houyuan",
  ]));
  set("sleep_room", "1");
  set("is_bed", 1);
  set("no_clean_up", 0);
  setup();
}


void init() {
  remove_call_out("force_open");
  call_out("force_open", 1440, this_player());
  add_action("do_quit", "quit");
  add_action("do_quit", "goto");
}

int do_quit() {
  write("这里不能退出！！\n");
  return 1;
}


int force_open(object me) {
  object room;
  room = find_object(__DIR__ "houyuan.lpc");
  if (!room) room = load_object(__DIR__ "houyuan.lpc");
  write("一天的租期已到，该退房了！！\n");
  me->move(room);
}
