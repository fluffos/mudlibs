//room:lake.c
#include <ansi.h>
inherit ROOM;
void get(object who);
void create() {
  set("short", "沙袋");
  set("long", @LONG
一个枯老的树桠上挂着几个结实的沙袋,几个武馆的弟子奋力的捶击着.
累的满头大汗.
LONG
  );
  set("exits", ([
    "west": __DIR__ "jw1",
  ]));
  set("objects", ([
    __DIR__ "npc/dizi": 4,
  ]));
  set("outdoor", "luoyang");
  setup();
}

void init() {
  add_action("do_step", "da");
}

int do_step(string arg) {
  int skill;
  skill = this_player()->query_skill("unarmed", 1);
  if (!arg)
    return notify_fail("你要打什么呀？\n");
  if (arg != "沙袋")
    return notify_fail("打什么\n");
  if (this_player()->query("sen") < 30 || this_player()->query("gin") < 30)
    return notify_fail("你太累了休息休息吧!\n");


  /*
  if(skill<100){
  message_vision("$N踩在了浮萍上，摇摇晃晃的走了几步。。象个秤砣一样沉底。。。不见了\n",this_player());
  this_player()->move("/u/lark/xiaoyao/water");
  return 1;
  }
*/
  message_vision("$N对着沙袋[砰砰砰]一阵组合拳\n", this_player());
  if (skill < 50) {
    this_player()->improve_skill("unarmed", (int)this_player()->query("int"));
    this_player()->add("sen", -(30 - (int)this_player()->query_skill("unarmed", 1) / 5));
    this_player()->add("gin", -(30 - (int)this_player()->query_skill("unarmed", 1) / 5));
    return 1;
  }
  return 1;
}
