//changan city

inherit ROOM;

void create() {
  set("short", "官道");
  set("long", @LONG
一条修整的平整的青石板路，宽阔光滑大概可以并行三辆马车同时通过。
是连接南北的一条大干道.四周一片山丘起伏，田园风光别有风味.不远处
似乎有个小村落。
LONG);

  //set("item_desc", ([" *** " : " *** ", ]));

  set("exits",
    ([  //sizeof() == 4
    "northwest": __DIR__ "road3",
      "southeast": __DIR__ "road5",  //goto luoyang
      "south": __DIR__ "cunzi",
    ]));

  set("objects",
    ([  //sizeof() == 1
    "/u/poor/gaibang/npc/farmer": 3,
    ]));


  set("outdoors", "changan");
  set("no_clean_up", 0);
  setup();
}
