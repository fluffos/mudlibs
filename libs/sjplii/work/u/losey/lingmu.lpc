#include <ansi.h>

inherit ROOM;

void create() {
  set("short", "陵墓");
  set("long", @LONG
看来这皇帝十分喜欢“六”这个数字。又是一间六角
的房间，里面还摆着六口石棺。难道皇帝、皇后连嫔
妃都在这不成？
LONG
  );
  set("exits", ([ /* sizeof() == 1 */
    "south": "/u/losey/bedroom",

  ]));
  set("item_desc", ([
    "石棺": "你试着推了推石棺，发现只有南北两面的石棺能推动。\n",
    "地砖": "你发现石棺下的两块地砖好象能够打破。\n",
  ]));

  setup();
}

void init() {
  add_action("do_push", "push");
  add_action("do_break", "break");
}




int do_push(string arg) {
  string dir;
  object me = this_player(), room;

  if (!arg || arg == "") return 0;

  if (arg == "石棺") {
    write("你试著推了一下棺材，发现可以推动....\n");
    return 1;
  }
  if (sscanf(arg, "石棺 %s", dir) == 1) {
    if (dir == "north") {
      me->set_temp("marks/north", 1);
      message_vision("$N将棺材往北推去,觉得脚下的地砖好象动了一下。\n", this_player());


    } else if (dir == "south") {

      me->set_temp("marks/south", 1);
      message_vision("$N将棺材往南推去，觉得脚下的地砖又动了几下。\n", this_player());

    } else {
      write("你要将棺材推向那个方向？\n");
      return 1;
    }
  }
}
int do_break(string arg) {
  object me = this_player(), room;
  int score, pot;
  score = (int)me->query("combat_exp");
  pot = (int)me->query("potential");

  if (arg != "地砖")
    return notify_fail("你要打碎什么？\n");

  if (!me->query_temp("marks/south"))
    return notify_fail("石棺移动的小了点,地砖倒出来的地方不够大!\n");
  if (!me->query_temp("marks/north"))
    return notify_fail("石棺移动的小了点,地砖倒出来的地方不够大!\n");


  if (!(room = find_object(__DIR__ "shandong")))
    room = load_object(__DIR__ "shandong");

  me->add("marks/addexp", 1);

  message("vision", HIW "\n$N的脚下突然裂开一个大洞,你啊的一声惨叫掉了下去......,\n\n
你顺着深不见底的山洞一直向下坠落,整个山洞中充斥着你的叫声。\n\n\n
突然一道丝网兜住你，又把你横向抛了出去，只听咚的一声，\n\n
你被抛进了山脚下的湖水里。\n", me);
  message_vision(NOR "\n", me);
  me->move(room);

  if ((int)me->query("marks/addexp") > 1) return 1;
  me->set("combat_exp", (int)score + 1);
  me->set("potential", (int)pot + 1);

  me->delete("marks/addexp");
  return 1;



}
