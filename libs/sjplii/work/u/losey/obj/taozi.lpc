
inherit ITEM;

void create()
{
        set_name("桃子",({"taozi"}));
        set_weight(60);
        if( clonep() )
                set_default_object(__FILE__);
        else {
            set("long",
                "一个水灵灵的桃子 。\n");
            set("unit","个");
        set("objattrib", 1);
            set("value", 2000);
        }
}



