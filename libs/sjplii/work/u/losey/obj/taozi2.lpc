#include <ansi.h>
inherit ITEM;
void create()
{
        set_name("桃子", ({ "taozi" }) );
        set_weight(500);
        set_max_encumbrance(400);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "个");
        set("objattrib", 1);
                set("long", "一个水灵灵的桃子\n"NOR);
        set("value", 1);
        }
}
int is_container() 

{

 return 1; 

}

