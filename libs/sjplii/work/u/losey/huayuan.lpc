inherit ROOM;

void create() {
  set("short", "曲径通幽");
  set("long", @LONG
这是一座极大的花园，四面群山围绕，园中万花竞艳。牡丹芍药，黄菊红
玫，四季香花，在这地竞同时开放，抬眼望去，宛如置身一片香涛花海之
中。白石小径，青竹篱笆间，零乱地站了十余个红衣少女，正在剪草灌花。
穿过路旁的草地，四下观望，只见路边一栋精舍，建筑在翠竹之间，微风
过处，幽籁天成。不远处，则见道旁依山筑起一片小巧的楼阁，飞檐如凤，
画栋雕梁。当真有如皇宫一般。
LONG
  );
  set("exits", ([
    "losey": "/u/losey/bedroom",
    "gogoha": "/u/losey/gogoha",
    "shang": "/u/losey/shang_room",
    "yyh": "/u/losey/yyh_room",
    "yuj": "/u/losey/yuj_room",
    "wdd": "/u/losey/wdd_room",
    "alert": "/u/losey/alert_room",
    "xuan": "/u/losey/xuan_room",
    "chan": "/u/losey/chan_room",
    "xii": "/u/losey/lingmu",
  ]));


  setup();
  replace_program(ROOM);
}
