#include <ansi.h>
inherit ROOM;

void create() {
  set("short", "崇文殿");
  set("long", @LONG
在六角形的房间中央放着一张书桌，上面有一盏宫灯，
笔墨纸砚一应具全。四周则摆着很多书架，上面放满了
各式各样的书籍，布置得真像间书房。
LONG
  );
  set("exits", ([ /* sizeof() == 1 */
    "southwest": "/u/losey/baozang/mishi",
  ]));
  setup();
  set("item_desc", ([
    "书架": "你发现书架上好象有很多书。\n",
  ]));

}
