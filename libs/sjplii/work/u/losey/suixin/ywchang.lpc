inherit ROOM;

void create()
{
        set("short", "英雄演武场");
        set("long", @LONG
 这里是很大的一快空地，场中央铺着一块红色地毯，供随心堂部众和天下
英雄在此演武论剑，地毯周围散部这几把椅子和几排兵器架，随心堂的大旗遍
插左右，气势逼人。北面是随心大殿，东西两面分别是散人殿和英雄殿。
LONG
        );
        set("exits", ([
       "west" :__DIR__"yxdian",
       "north" :__DIR__"sxdian",
       "east" :__DIR__"srdian",
       "south" :__DIR__"txmen",


]));
   
   set("no_death_penalty",1);
        setup();
}


