inherit ROOM;

void create()
{
        set("short", "飞鹤亭");
        set("long", @LONG
 一亭凌空飞轩，有飞鹤频顾，为圣灵仙兹。通玄者无禁，狂妄
者惘然。曲景幽通，万道布灵，上述苍天，下悯众生。以一天创造万物，以
一地养育大千，以一人主宰世间，以一魔赏善罚恶。再往西走就是随心大殿
了。
LONG
        );
        set("exits", ([
       "west" :__DIR__"sxdian",
       "south" :__DIR__"txyuan",


]));
   
        setup();
    
}
