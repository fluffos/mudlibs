#include <ansi.h>
#include <armor.h>

inherit FINGER;

void create()
{
        set_name(HIR"皇冠"NOR, ({ "huang guan"}) );
        set_weight(1);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long", "不知道是哪个皇帝曾经用过的皇冠。\n");
                set("unit", "个");
                set("value", 3000000);
                set("objattrib", 1);
                set("armor_prop/armor", 20);
                set("armor_prop/personality", 20);
                set("wear_msg", "$N轻轻地把一个$n戴在头上。\n");
                set("unwield_msg", "$N轻轻地把$n从头上摘了下来。\n");
        }
        setup();
}

