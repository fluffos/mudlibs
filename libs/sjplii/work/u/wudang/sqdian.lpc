inherit ROOM;

void create()
{
	set("short", "三清殿");
	set("long", @LONG
	这里是凌霄宫的三清殿，是武当派会客的地点。供着元始天尊、太上道
君和道德天尊的神像，香案上香烟缭绕。靠墙放着几张太师椅，地上放着几个蒲
团。东西两侧是走廊，南边是练武的广场，北边是后院。
LONG
	);
	set("valid_startroom", 1);
	set("exits", ([
		"south" : __DIR__"guangchang",
		"north" : __DIR__"road",
//		"north" : __DIR__"houyuan",
		"east" : __DIR__"donglang1",
		"west" : __DIR__"xilang",
	]));
	 set("objects", ([
		__DIR__"npc/zixia": 1,
]));
	 set("valid_startroom", 1);
        setup();
	 call_other( "/obj/board/wudang_b", "???" );
        replace_program(ROOM);

}

