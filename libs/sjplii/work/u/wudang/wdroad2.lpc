inherit ROOM;

void create()
{
        set("short", "均县");
        set("long", @LONG
这里是湖北均县，因境内有武当山而出名。丈许宽的城墙又高又厚，给
人一种安全的感觉。遥望城外，绿色的田野一望无垠，一座座小小的农房星
星点点的点缀着宽广的田野，傍晚时，炊烟袅袅，夕阳斜照，美不胜收。远
处连绵的群山更是令人感到威武壮观。
LONG
        );
        set("outdoors", "wudang");

	set("exits", ([
		"south" : __DIR__"wdroad1",
		"north" : __DIR__"wdroad3",
		"east" : __DIR__"mianguan",
	]));
        set("objects", 
        ([
              "/npc/nknpc" : 1,
        ]));

	setup();
	replace_program(ROOM);
}

