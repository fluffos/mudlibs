// sword book

inherit ITEM;

void create() {
  set_name("武当剑术总诀", ({ "sword-book", "book", }));
  set_weight(600);
  set("unit", "本");
  set("long", "这是一本介绍武当派基本剑术的入门书。\n");
  set("value", 3000);
  set("skill", ([
    "name": "sword",          // name of the skill
    "exp_required": 0,               // minimum combat experience required                                                                           
    // to learn this skill.
    "sen_cost": 40,                // gin cost every time study this
    "difficulty": 30,                // the base int to learn this skill
    // modify is gin_cost's (difficulty - int)*5%
    "max_skill": 30   // the maximum level you can learn from this object.
  ]));
}
