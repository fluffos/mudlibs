// unarmed book

inherit ITEM;

void create()
{
        set_name("十三势提高篇", ({ "taiji13-3" }));
        set_weight(600);
        set("unit", "本");
        set("long", "这是一本记载如何把太极十三势融会贯通的书籍。\n");
        set("value", 800);
        set("skill", ([
                "name":        "unarmed",        // name of the skill
                "exp_required": 100000,               // minimum combat experience required                                                                           
                                                 // to learn this skill.
                "sen_cost": 50,                  // gin cost every time study this
                "difficulty": 30,                // the base int to learn this skill
                                  // modify is gin_cost's (difficulty - int)*5%
				"skill_required" : "taiji-force",
				"skill_lev" : 120,
                "max_skill": 100   // the maximum level you can learn from this object.
        ]) );
}
 
