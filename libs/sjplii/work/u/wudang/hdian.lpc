int valid_leave(object me, string dir) {
  object ob;
  if (dir != "south" && present("master baishi", environment(me)) &&
    me->query("class") != "wudang")
    return notify_fail("白石道长一手拦住，喝道：“掌门吩咐，非武当弟子不许内进！”\n");
  return ::valid_leave(me, dir);
}
