#include <ansi.h>

inherit NPC;
inherit F_MASTER;
int about_he();

void create() {
  set_name("公孙瑶红", ({ "gongsun yaohong", "gongsun" }));
  set("gender", "女性");
  set("age", 25);
  set("long",
    "公孙瑶红主要负责办理加入武当派的事宜。平时女弟子都喜欢与她谈女人的话题。\n");
  set("inquiry", ([
    "here": "这里是闻名天下的武当山。",
    "加入": "要加入武当派可以先拜我或其他知客，以后有所成就再拜其他长辈。",
    "拜师": "要加入武当派可以先拜我或其他知客，以后有所成就再拜其他长辈。",
    "学艺": "要先拜师，才能学艺。",
    "道德经": (: about_he :),
  ]));
  set("attitude", "peaceful");
  set("per", 23);
  set("int", 30);
  set("class", "wudang");

  set("max_kee", 800);
  set("max_gin", 800);
  set("max_sen", 800);
  set("kee", 800);
  set("gin", 800);
  set("sen", 800);

  set("force", 800);
  set("max_force", 800);
  set("force_factor", 20);

  set("combat_exp", 800000);
  set("score", 9000);

  set_skill("move", 60);
  set_skill("dodge", 60);
  set_skill("literate", 60);
  set_skill("unarmed", 60);
  set_skill("parry", 60);
  set_skill("force", 60);
  set_skill("sword", 60);

  set_skill("taiji-sword", 60);
  set_skill("taiji-ken", 60);
  set_skill("taiji-force", 60);
  set_skill("tiyunzong", 60);

  map_skill("dodge", "tiyunzong");
  map_skill("unarmed", "taiji-ken");
  map_skill("parry", "taiji-sword");
  map_skill("force", "taiji-force");
  map_skill("sword", "taiji-sword");

  create_family("武当派", 7, "弟子");

  setup();

  carry_object("/obj/longsword")->wield();
  carry_object(__DIR__ "obj/daopao")->wear();
}

void attempt_apprentice(object ob) {
  if (ob->query("id_type") == 2) {
    command("say 本派乃名门正派，不收邪道人物。\n");
    return;
  }
  command("smile");
  command("say 好吧，" + RANK_D->query_respect(ob) + "以后要更加勤习武功，把武当发扬光大！\n");
  command("recruit " + ob->query("id"));
}

void recruit_apprentice(object ob) {
  if (::recruit_apprentice(ob))
    ob->set("class", "wudang");
  ob->set("id_type", 1);
}

int accept_object(object who, object ob) {
  object me;
  object book;
  if (ob->name() == "地灵符") {
    me = this_player();
    book = new("/d/city/obj/book/girlbook");
    book->move(me);
    command("say 太好了，我可以知道我要的事啦！这部经文给你吧，好好用功啊！\n");
    return 1;
  } else {
    command("say 我不要你的东西。\n");
    return 0;
  }

  return 1;
}
int about_he() {
  command("say 听说地灵符可以召唤出土地来，可神奇了，你能给我找一块来吗？如果能找到，我就给你经文。\n");
  return 1;
}
