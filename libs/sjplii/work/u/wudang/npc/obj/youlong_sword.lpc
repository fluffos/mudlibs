
#include <weapon.h>

inherit SWORD;

void create()
{
	set_name("游龙剑", ({ "youlong jian","sword","jian","youlong" }) );
	set_weight(7000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "把");
		set("long", "这是一把用白金打成的长剑，剑身很薄，相当轻巧，可以削铁如泥");
		set("value", 400);
		set("material", "steel");
        	set("rigidity", 100);
        	set("sharpness", 90);
		set("wield_msg", "$N「唰」地一声抽出一把汉光闪闪的$n握在手中。\n");
		set("unwield_msg", "$N将手中的$n插入腰间的剑鞘。\n");
	}
	init_sword(80);
	setup();
}
