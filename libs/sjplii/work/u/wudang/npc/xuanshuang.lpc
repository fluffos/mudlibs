#include <ansi.h>

inherit NPC;
inherit F_MASTER;
string	summon_more( object who);
int about_he();

void create()
{
        set_name("玄霜道长", ({ "xuan shuang", "shuang" }) );
        set("gender", "男性");
        set("age", 45);
        set("long",
"玄霜道人是武当派旁支中比较杰出的人物。\n" );
        set("inquiry", ([
                "here": "这里是闻名天下的武当山。",
                "道德经" : (: about_he :),
        ]) ); 
        set("attitude", "peaceful");
        set("str", 60);
        set("int", 30);
        set("cor", 30);
        set("spi", 30);
	set("class", "wudang");

	set("max_kee", 1500);
	set("max_gin", 1500);
	set("max_sen", 1500);
	set("kee", 1500);
	set("gin", 1500);
	set("sen", 1500);

        set("force", 1500);
        set("max_force", 1500);
        set("force_factor", 20);

        set("combat_exp", 2500000);
        set("score", 20000);

        set_skill("move", 90);
        set_skill("dodge", 90);
        set_skill("literate", 90);
        set_skill("unarmed", 110);
        set_skill("parry", 100);
        set_skill("force", 100);
        set_skill("sword", 90);

        set_skill("taiji-sword",90);
        set_skill("taiji-ken", 110);
        set_skill("taiji-force", 100);
        set_skill("tiyunzong", 90);

        map_skill("dodge", "tiyunzong");
        map_skill("unarmed", "taiji-ken");
        map_skill("parry", "taiji-sword");
        map_skill("force", "taiji-force");
        map_skill("sword", "taiji-sword");
        set("chat_chance_combat", 50);
        set("chat_msg_combat", ({
                (: perform_action, "unarmed.nian" :),
		(: summon_more(this_object()) :),
        }) );

        create_family("武当派", 6, "弟子");

        setup();

//        carry_object("obj/longsword")->wield();
        carry_object(__DIR__"obj/daopao")->wear();
}

string summon_more(object who)
{
	int i;
	object *enemy;
	object another;
	seteuid(getuid());
	another = new(__DIR__"wddizi2");
	another->move(environment(who));
	message_vision(another->name()+ "走了过来。\n"
		, this_object() );
	enemy = who->query_enemy();
	i = sizeof(enemy);
	while(i--) {
		if( enemy[i] && living(enemy[i]) ) {
			another->kill_ob(enemy[i]);
			enemy[i]->kill_ob(another);
			another->set_leader(enemy[i]);
		}
	}
	return "1";
}
int accept_fight(object me)
{
	command("say 请不要在这里惹是生非。");
        return 0;
}

int accept_object(object who, object ob)
{
        object me;
        object book;
	if( ob->name() == "水蜜桃") {
	me = this_player();
	if( !ob->query("objattrib") ) 
	{
	command("say 这个水蜜桃一点也不新鲜。\n");
	 return 0;
	}
	if( me->query_temp("wudang/get_daode") ) 
	{
	command("say 好新鲜的水蜜桃，呵呵，你知道道爷我喜欢吃桃子了啊！\n");
	 return 1;
	}
          book = new("/d/city/obj/book/daode");
          book->move(me);
	command("say 很好，好新鲜的桃子。这部经文给你吧，好好用功啊！\n");
	me->set_temp("wudang/get_daode",1);
	return 1;
        }
		else {
	command("say 你别拿道爷我寻开心。\n");
			return 0;
                }

        return 1;
}
int about_he()
{
	command("say 你去给我摘个新鲜的水蜜桃来，我再告诉你经文的下落。\n");
          return 1;
}

