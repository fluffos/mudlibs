
inherit NPC;

void create()
{
        set_name("司徒娟", ({ "situ juan", "juan" }) );
        set("title","泡茶小道姑");	 
        set("gender", "女性");
        set("age", 19);
        set("long",
"这是个年龄不大的小姑娘，但宽松的道袍也遮不住她过早发育的身体。\n"
"一脸聪明乖巧，满口伶牙俐齿。见有人稍微示意，便过去加茶倒水。\n"  );
        set("inquiry", ([
                "茶": "好的，给你添茶.....",
        ]) ); 
        set("attitude", "peaceful");
        set("class","wudang");
        set("str", 26);
        set("int", 22);
        set("spi", 25);
        set("per", 23);
        set("cps", 23);

        set("force", 500);
        set("max_force", 300);
        set("force_factor",10);
        set("combat_exp",5000);
        set("score",100);

        set_skill("unarmed", 30);
        set_skill("sword", 30);
        set_skill("force", 30);
        set_skill("parry", 30);
        set_skill("dodge", 30);

        set_skill("taiji-sword",30);
        set_skill("taiji-ken", 30);
        set_skill("taiji-force", 30);
        set_skill("tiyunzong", 30);

        map_skill("dodge", "tiyunzong");
        map_skill("unarmed", "taiji-ken");
        map_skill("force", "taiji-force");
        map_skill("sword", "taiji-sword");

        create_family("武当派", 7, "弟子");

        setup();

        carry_object("/obj/weapon/sword")->wield();
        carry_object(__DIR__"obj/daopao")->wear();
}


void init()
{	
	object ob;
	::init();
	if( interactive(ob = this_player()) && !is_fighting() ) {
		remove_call_out("greeting");
		call_out("greeting", 1, ob);
	}

}

void greeting(object ob)
{
	if( !ob || environment(ob) != environment() ) return;
	say( "司徒娟笑吟吟地说道：这位" + RANK_D->query_respect(ob)
				+ "请先入座，我这就给您上茶。\n");
}

