inherit NPC;
inherit F_MASTER;

void create() {
  set_name("章万知", ({ "zhang wanzhi", "zhang" }));
  set("title", "知客道长");
  set("gender", "男性");
  set("age", 23);
  set("long",
    "章万知主要负责办理加入武当派的事宜，平时有贵客到来时也由他出面招呼。\n");
  set("inquiry", ([
    "here": "这里是闻名天下的武当山。",
    "加入": "要加入武当派可以先拜我或其他知客，以后有所成就再拜其他长辈。",
    "拜师": "要加入武当派可以先拜我或其他知客，以后有所成就再拜其他长辈。",
    "学艺": "要先拜师，才能学艺。",
  ]));
  set("attitude", "peaceful");
  set("class", "wudang");

  set("max_kee", 500);
  set("max_gin", 500);
  set("max_sen", 500);
  set("kee", 500);
  set("gin", 500);
  set("sen", 500);

  set("force", 500);
  set("max_force", 500);
  set("force_factor", 10);

  set("combat_exp", 500000);
  set("score", 5000);

  set_skill("move", 50);
  set_skill("dodge", 50);
  set_skill("literate", 50);
  set_skill("unarmed", 50);
  set_skill("parry", 50);
  set_skill("force", 50);
  set_skill("sword", 50);

  set_skill("taiji-sword", 50);
  set_skill("taiji-ken", 50);
  set_skill("taiji-force", 50);
  set_skill("tiyunzong", 50);

  map_skill("dodge", "tiyunzong");
  map_skill("unarmed", "taiji-ken");
  map_skill("parry", "taiji-sword");
  map_skill("force", "taiji-force");
  map_skill("sword", "taiji-sword");

  create_family("武当派", 7, "弟子");

  setup();

  carry_object("obj/longsword")->wield();
  carry_object(__DIR__ "obj/daopao")->wear();
}

void attempt_apprentice(object ob) {
  if (ob->query("id_type") == 2) {
    command("say 本派乃名门正派，不收邪道人物。\n");
    return;
  }
  command("smile");
  command("say 好吧，" + RANK_D->query_respect(ob) + "以后要更加勤习武功，把武当发扬光大！\n");
  command("recruit " + ob->query("id"));
}

void recruit_apprentice(object ob) {
  if (::recruit_apprentice(ob))
    ob->set("class", "wudang");
  ob->set("id_type", 1);

}
