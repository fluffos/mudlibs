#include <ansi.h>
inherit NPC;
inherit F_MASTER;
int about_baohu();
void create()
{
	set_name("宁静真人", ({ "master ningjing", "ningjing", "master" }));
	set("title", "武当派掌门");
	set("gender", "男性");
	set("age", 70);
//	set("nickname", HIG "" NOR);
        set("long",
"宁静真人是武当派继开山祖师张三丰后最杰出的掌门，他的武功才智在武林中\n"
"都算是超一流人物。近年武当重震声威，就是全赖宁静的英明领导。\n"  );
	set("attitude", "peaceful");
        set("str", 30);
        set("int", 30);
        set("cor", 30);
        set("spi", 30);
	set("class", "wudang");

	set("max_kee", 2000);
	set("max_gin", 2000);
	set("max_sen", 2000);
	set("kee", 2000);
	set("gin", 2000);
	set("sen", 2000);

        set("force", 2000);
        set("max_force", 2000);
        set("force_factor", 20);

        set("combat_exp", 9000000);
        set("score", 50000);
	set_temp("apply/attack", 30);
	set_temp("apply/defense", 30);
	set_temp("apply/move", 30);

        set_skill("move", 240);
        set_skill("dodge", 250);
        set_skill("literate", 230);
        set_skill("unarmed", 250);
        set_skill("parry", 250);
        set_skill("force", 250);
        set_skill("sword", 250);

        set_skill("taiji-sword",250);
        set_skill("taiji-ken", 250);
        set_skill("taiji-force", 250);
        set_skill("tiyunzong", 250);

        map_skill("dodge", "tiyunzong");
        map_skill("unarmed", "taiji-ken");
        map_skill("parry", "taiji-sword");
        map_skill("force", "taiji-force");
        map_skill("sword", "taiji-sword");
        set("chat_chance_combat", 50);
        set("chat_msg_combat", ({
                (: perform_action, "sword.chan" :),
                (: perform_action, "sword.fengbi" :),
        }) );
        set("inquiry", ([
                "随行" : (: about_baohu :),
        ]) ); 

        create_family("武当派", 4, "掌门");

	setup();
        carry_object(__DIR__"obj/youlong_sword")->wield();
        carry_object(__DIR__"obj/daopao")->wear();
}

void attempt_apprentice(object ob)
{
      if(ob->query("gender")!="男性") {
	    command("say 贫道不收女弟子，你去拜我的师姐吧。\n");
	    return;
	}

      if(ob->query("class")!="wudang") {
	    command("say 这位" + RANK_D->query_respect(ob) + "还是去拜贫道的弟子吧。\n");
	    return;
	}

      if(ob->query_skill("taiji-force",1)< 150) {
	    command("say 本门武功均以太极神功作为基础，你修为尚浅，应先在内功方面多下功夫。\n");
	    return;
	}	
      command("smile");
      command("say 好吧，" + RANK_D->query_respect(ob) + "以后要更加勤习武功，把武当发扬光大！\n");
      command("recruit " + ob->query("id") );
}

void recruit_apprentice(object ob)
{
        if( ::recruit_apprentice(ob) )
                ob->set("class", "wudang");
                ob->set("id_type", 1);
}

int about_baohu()
{
 	object me,soldier;
	object *t;
	me=this_player();
      if(me->query("class")!="wudang") {
	command("say 对不起，你不是武当弟子！\n");
	    return 1;
	}

	if(pointerp(t=me->query_team()))
	{command("say 已经有师兄弟保护你了，好自为之！\n");
	return 1;}
     command("say 好吧，我让你的师兄弟与你同行。\n");
	message_vision(CYN"\n从门外走进来一名武当弟子，躬身说道：师父请吩咐！\n" NOR, me);
	message_vision(HIM"\n宁静真人说道：武当弟子保护$N一起下山吧！\n" NOR, me);
	message_vision(CYN"\n武当弟子躬身说道：谨遵师命！\n" NOR, me);
	soldier= new(__DIR__"wddizi.lpc");
	soldier->move(environment(me));
	me->add_team_member(soldier);
	soldier->add_team_member(me);
	soldier->set_leader(me);
	soldier->set("possessed",me);
	return 1;
}

