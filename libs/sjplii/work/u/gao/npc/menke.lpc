// leader.c

inherit NPC;

void create()
{
       set_name("赵学澄", ({"zhao xuecheng", "zhao", "xuecheng"}));
       set("long","一个看起来颇有风度的年青人，背着手闲逛．\n");
       set("gender", "男性");
	set("title", "太室山庄门客");
       set("age", 26);
	set("combat_exp", 5000);
	set_skill("unarmed", 15);
	set_skill("dodge", 15);
	set_skill("parry", 15);
       set("attitude", "peaceful");
       set("shen_type", 1);
set("inquiry", ([
"here"  : "这儿哪您还不清楚吗？嘿嘿．．．",
]));
       set("chat_chance", 10);
        set("chat_msg", ({
            "赵学澄上上下下打量了你几眼。\n",
            (: random_move :)
        }) );

	setup();
	add_money("silver", 2);
        carry_object("/obj/cloth")->wear();

}


