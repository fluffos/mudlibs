// topten.c 书剑飘零排行榜 
// by worm 
// v1.00 有待改进
// 通过测试 in xkx 单机版


#include <ansi.h>
inherit ITEM;


void setup() {}

void init() {
  add_action("do_read", "read");
  add_action("do_ntopten", "ntopten");
}

void create() {
  set_name("书剑排行榜", ({ "topten" }));
  set("unit", "本");
  set("long", "这是一本书剑排行榜。\n
                p1   十大高手
                p2   十大富翁
                p3   十大恶人
                p4   十大剑客
                p5   十大拳王
\n");

  set("value", 10000);
  setup();
}

int do_read(string page) {
  string b_name, f_name, str, *astr, *bstr, name, id, stri;
  int i, j, data;
  switch (page) {
    case "p0":
      write("这是封面,写着\n\n" + BLU + "    
              书剑飘零排行榜\n\n" + NOR);
      write("如果你想更新topten,请输入ntopten\n");
      return 1;


    case "p1":
      f_name = TOPTEN_EXP;
      stri = "十大高手";
      break;
    case "p2":
      f_name = TOPTEN_RICH;
      stri = "十大富翁";
      break;
    case "p3":
      f_name = TOPTEN_PKER;
      stri = "十大恶人";
      break;
    case "p4":
      stri = "十大剑客";
      f_name = "/u/worm/sword";
      break;
    case "p5":
      f_name = "/topten/unarmed.txt";
      stri = "十大拳王";
      break;
    default:
      return notify_fail("你想读哪页?\n");
  }
  if (file_size(f_name) == -1)
    return notify_fail("还没有这文件！\n");
  astr = explode(read_file(f_name), "\n");
  str = "书剑飘零";
  str += BLU + stri + "\n";
  for (i = 0; i < sizeof(astr); i++) {
    bstr = explode(astr[i], ";");

    str += HIC "第" + chinese_number(i + 1) + "名：" HIW;
    for (j = 0; j < sizeof(bstr); j++) {

      if (sscanf(bstr[j], "%s(%s)%d", name, id, data) != 3)
        return notify_fail("数据错误");



      str += name + "(" + id + ")\t";
    }
    str += "\n" NOR;
  }
  write(str);
  return 1;
}

int do_ntopten() {
  // 仅为在线玩家更新
  object *list;
  int j;
  list = users();
  j = sizeof(list);
  while (j--)
    TOPTEN_D->topten_checkplayer(list[j]);
  write("TOPTEN已经重新排名\n");
  return 1;

}
