#include <ansi.h>
string reward_more( object who);

inherit NPC;
void create()
{

         set_name("逍遥弟子",({ "xiaoyao dizi","dizi"})); 
         set("gender", "男性" );
        set("attitude", "friendly");
        

 set("str", 25);
        set("cor", 30);
        set("cps", 25);
         set("chat_chance", 2);
        set("chat_msg", ({
           "弟子练一遍拳法似乎略有增长。\n",
}) );
        set("combat_exp", 50000);
     set("food",3000)
;
     set("water",3000)
;
        set_skill("sword", 30);
        set_skill("parry", 30);
        set_skill("dodge", 30);
        set_skill("unarmed", 30);
        set_skill("force", 30);
        set("chat_chance", 2);
        set("chat_msg", ({
           "弟子低声道：“哎！大师兄看的太紧了？真想和三师兄学学琴呀。”\n",
           "弟子说：“是呀，能和丁师姐学学花艺也不错。。。。”\n",
           "弟子点了点头:“其实这样练功反而没有以前进步快了..sigh\n”\n",
}) );

        
        set("chat_chance_combat", 50);
        set("chat_msg_combat", ({
                (: reward_more(this_object()) :),
        }) );
        setup();
 carry_object("/obj/sword");
        carry_object("/obj/cloth")->wear();
}

string reward_more(object who)
{
        int i;
        object *enemy;
        seteuid(getuid());
        enemy = who->query_enemy();
        i = sizeof(enemy);
        while(i--) {
                if( enemy[i] && living(enemy[i]) ) {
                        if( enemy[i]->query("combat_exp") > 50000 ) return "1";
                        enemy[i]->add("combat_exp", 1);
                        if( enemy[i]->query("potential") > 40000 ) return "1";
                        enemy[i]->add("potential", 1);
                }
        }
        return "1";
}

void init()
{
    add_action("dokill", ({"kill"}));
}

int accept_fight(object ob)
{
    object weapon;

        if(ob->query("class")=="xiaoyao")
        {
           command("nod");     
           command("say 好吧，练练身手也好向大师哥交代");
                if( weapon = query_temp("weapon") )
                    command("unwield sword");
                set("force_factor", 0);
                return 1;
        }
        return notify_fail("弟子摇了摇头：“高师哥以前交代过，不让随便出手的”\n");
}

int dokill(string arg)
{
    object weapon;

    if(!this_object()->id(arg))return 0;
    message_vision("\n$N对著$n喝道：「" 
                + RANK_D->query_rude(this_object())
                   + "！今日不是你死就是我活！」\n\n", this_player(), this_object());

    command("laugh");
    set("force_factor", 10);
    if( weapon = present("sword", this_object()))
        command("wield sword");
    this_object()->kill_ob(this_player());
    this_player()->kill_ob(this_object());
    return 1;
}

void defeated_enemy(object me)
{
  command("sigh");
  command("say 高师哥不在，师兄弟们的武功有些荒废了。\n");
  command("shake");
}

