// Room: /u/poor/yidao.c

inherit ROOM;

void create()
{
        set("short", "后院");
        set("long", @LONG
你来到了黑风寨的后院里，在后院里张满了杂草，跟刚
路过的花园简直是天地之别。在院子的西南角有一座坟。
LONG
        );
	set("item_desc", ([ /* sizeof() == 1 */
  "坟" : "坟前的墓碑上写着：寒灵山庄天帝之墓。
",
]));
        set("exits", ([
                "east" : __DIR__"hfhy",
]));
       set("objects", ([ /* sizeof() == 1 */
  __DIR__"npc/louluo1" : 2,
]));
	set("outdoors","zhang");
        setup();
}
void init()
{
	add_action("do_wa", "dig" );
	add_action("do_wa", "wa" );
}


int do_wa(string arg)
{
	object me,ob;
	me = this_player();

	if( arg=="墓" || arg=="fen" || arg=="坟"  ) {
	if (!objectp(ob = present("tieqiao", me))) {
		     write("你没有工具怎么挖坟？\n");
	       return 1;
		}
       	message_vision("$N用铁锹挖坟上的土，不一会，坟别挖开了。\n",me);
       	message_vision("$N跳到了坟坑里。\n",me);
	       me->move(__DIR__"hffen1");
       	return 1;
	}
	else return 0;
}

