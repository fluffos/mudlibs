// banker.c

#include <ansi.h>

inherit NPC;

void create()
{
        set_name("强盗", ({ "qiangdao" }) );
        set("gender", "男性" );
        set("age", 41);

        set("str", 22);
        set("cor", 30);
        set("cps", 30);
        set("int", 26);
        set("per", 23);
        set("con", 24);
        set("spi", 30);
        set("kar", 25);

        set("long",
                
"他是强盗，干尽了各种伤天害理的坏事。\n");
 
        set("combat_exp", 10000);
        set("attitude", "aggressive");

        set("max_force", 800);         set("force", 1000);             
	 set("force_factor", 20);

        set_skill("unarmed", 50);
        set_skill("sword", 50);
        set_skill("parry", 50);
        set_skill("dodge", 50);
        set_skill("force", 50);
        
        setup();
        
        carry_object("/u/poor/obj/cloth/cloth")->wear();
        carry_object("/u/poor/obj/weapon/sword")->wield();
        carry_object(__DIR__"obj/baicao-jiu");
}

int accept_fight(object me)
{
        command("say 咦... 要打就真打吧，光是较量多没意思？");
        kill_ob(me);
        return 1;
}
 
