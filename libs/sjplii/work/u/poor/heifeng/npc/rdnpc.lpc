#include <ansi.h>
inherit NPC;
void create()
{
        int i,amun;
        string *order = ({"张","王","李","赵","杨","郭","孟","林","崔","孔", 
"段","苏","刘","孙","周","郑","方","韩","许","徐"});
        string *orderr = ({"品端","来福","家宝","安","鹏山","宗英","奉","满",
"报国","仪","富贵","典","志新","古风","处天","平安","君","若明","易遥"});
        set_name( order[random(20)] + orderr[random(19)], ({ "man" }) );
        set("gender", "男性" );
        set("age", random(20)+20);
        set("max_kee", 200);
        set("long",
"他是一个普通的小市民。\n");
        set("chat_chance", 5);
        set("chat_msg", ({
		                (: random_move :)
        }) );
        set("combat_exp", 10000);
        set_skill("parry", 30);
        set_skill("dodge", 30);
        set_skill("unarmed", 30);
        setup();
        carry_object("/u/poor/obj/cloth/cloth")->wield();
}

