// beggar.c

#include <ansi.h>
inherit NPC;


void create()
{	
	 string *order = ({"狂堂", "邪堂", "毒堂"});

        set_name("山寨喽罗", ({ "louluo" }) );
        set("title", "黑风寨"+(order[random(3)])+"护法");
        set("gender", "男性");
        set("age", 15+random(50));
        set("long",
 "他是黑风寨的喽罗。\n");
        set("attitude", "aggressive");
        set("max_kee", 1000);
        set("kee", 1000);
        set("force", 1000);
        set("max_force", 1000);
        set("force_factor",30);
        set("combat_exp", 30000+random(70000));
        set_skill("unarmed", 50+random(50));
        set_skill("blade", 50+random(50));
        set_skill("golden_blade", 50+random(50));
        set_skill("parry", 50+random(50));
        set_skill("dodge", 50+random(50));
        map_skill("blade", "golden_blade");
        map_skill("parry", "golden_blade");

        create_family("黑风寨", 3+random(7), "弟子");

        setup();

        carry_object("/u/poor/obj/cloth/cloth")->wear();
        carry_object("/u/poor/obj/weapon/blade")->wield();
}
