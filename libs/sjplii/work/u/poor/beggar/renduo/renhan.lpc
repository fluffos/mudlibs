// Room: /u/poor/gaibang/zhulin2.c

inherit ROOM;
#include <ansi.h>;

void create() {
  set("short", HIB "破屋" NOR);
  set("long", @LONG
你走进了一间破烂不堪的屋子之中，在屋子中间放着一张
桌子，旁边有两张椅子。正对着窗子有一扇窗户。
LONG
  );

  set("exits", ([ /* sizeof() == 2 */
    "south": __DIR__ "renyzi1",
  ]));
  set("objects", ([ /* sizeof() == 1 */
    __DIR__ "npc/hanyuan": 1,
  ]));
  set("no_clean_up", 0);

  setup();
}

void init() {
  add_action("do_jump", "jump");
  add_action("do_jump", "tiao");
}

int do_jump(string arg) {
  if (arg == "window" || arg == "窗户") {
    if (!this_player()->query("marks/wuyi9")) {
      write("这个窗子太小，你跳不过去。\n");
      return 1;
    }
    message_vision("$N深吸一口气，从窗子中跳了出去。\n", this_player());
    this_player()->move(__DIR__ "renhan1");
    message("vision", this_player()->name() + "跳出了窗子。\n",
      environment(this_player()), this_player());
    return 1;
  } else return 0;
}
