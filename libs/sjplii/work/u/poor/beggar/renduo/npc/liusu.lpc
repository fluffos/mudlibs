// songqing.c

#include <ansi.h>
inherit NPC;

void create()
{
        set_name("刘苏", ({ "liu su", "master", "liusu" }) );
        set("title", "丐帮五袋弟子");
        set("gender", "男性");
        set("nickname", HIB "黑丐侠" NOR);
        set("age", 25);
        set("long",
 "他是仁舵的弟子。\n");
        set("inquiry", ([
                "拜师": "问那么多干吗，快拜师吧！",
        ]) ); 
        set("max_kee", 1500);
        set("kee", 1500);
        set("force", 1500);
        set("max_force", 1500);
        set("force_factor",50);
        set("combat_exp",120000);

        set_skill("unarmed", 70);
        set_skill("force", 90);
        set_skill("parry", 90);
        set_skill("dodge", 90);
        set_skill("whip", 90);
        set_skill("begging", 90);

        set_skill("fire_whip", 90);
        set_skill("iron_strike", 70);
        set_skill("hidden_dodge", 90);
        set_skill("canyun_force", 90);
        set_skill("literate", 80);

        map_skill("dodge", "hidden_dodge");
        map_skill("unarmed", "iron_strike");
        map_skill("force", "canyun_force");
        map_skill("parry", "fire_whip");
        map_skill("whip", "fire_whip");

        create_family("丐帮", 6, "弟子");

        setup();

        carry_object("/u/poor/obj/cloth/jingyi")->wear();
        carry_object("/u/poor/obj/weapon/whip")->wield();
}

void attempt_apprentice(object ob)
{
	int beg = (int)ob->query_skill("begging", 1);

	if( beg > 50) {
        command("smile");
        command("say 很好，" + RANK_D->query_respect(ob) + "多加努力，他日必定有成。\n");
	command("recruit " + ob->query("id") );
	command("say 丐帮乃江湖第一大帮，本派在江湖上必须行侠仗义，你可记清楚了。\n");
	ob->set("class","gaibang");
	ob->set("title","丐帮净衣帮仁舵大弟子");
	}
	else {
	command("say 这位" + RANK_D->query_respect(ob) + "还是去找沈公拓修习武功吧。\n");
	}
}
