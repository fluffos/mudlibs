// songqing.c

#include <ansi.h>
inherit NPC;
int ask_me();

void create() {
  set_name("寒渊", ({ "han yuan", "master", "han" }));
  set("gender", "男性");
  set("nickname", HIB "万里鞭" NOR);
  set("title", "丐帮大仁分舵舵主");
  set("age", 28);
  set("long",
    "他是丐帮大仁分舵的舵主。\n");
  set("inquiry", ([
    "污衣帮": "随便说是要死人的。",
    "加入污衣帮": "你没开玩笑吧。",
    "穿污衣，行侠义": (: ask_me :),
    "喜好": "我没有什么喜好。",
    "拜师": "问那么多干吗，快拜师吧！",
  ]));
  set("max_kee", 2000);
  set("kee", 2000);
  set("force", 2000);
  set("max_force", 2000);
  set("force_factor", 60);
  set("combat_exp", 200000);

  set_skill("unarmed", 120);
  set_skill("force", 120);
  set_skill("parry", 120);
  set_skill("dodge", 120);
  set_skill("stick", 120);
  set_skill("whip", 120);
  set_skill("begging", 120);

  set_skill("fire_whip", 120);
  set_skill("qingyun_stick", 120);
  set_skill("iron_strike", 120);
  set_skill("hidden_dodge", 120);
  set_skill("canyun_force", 120);
  set_skill("literate", 100);

  map_skill("dodge", "hidden_dodge");
  map_skill("unarmed", "iron_strike");
  map_skill("force", "canyun_force");
  map_skill("parry", "fire_whip");
  map_skill("whip", "fire_whip");

  create_family("丐帮", 5, "弟子");

  setup();

  carry_object("/u/poor/obj/cloth/wuyi")->wear();
  carry_object("/u/poor/obj/weapon/whip")->wield();
}

void attempt_apprentice(object ob) {
  int beg = (int)ob->query_skill("begging", 1);

  if (beg > 80) {
    command("smile");
    command("say 很好，" + RANK_D->query_respect(ob) + "多加努力，他日必定有成。\n");
    command("recruit " + ob->query("id"));
    command("say 丐帮乃江湖第一大帮，本派在江湖上必须行侠仗义，你可记清楚了。\n");
    ob->set("class", "gaibang");
    ob->set("title", "丐帮净衣帮仁舵副舵主");
  } else {
    command("say 这位" + RANK_D->query_respect(ob) + "还是去找刘苏修习武功吧。\n");
  }
}

int ask_me() {
  object me;
  me = this_player();
  if (!me->query("marks/wuyi9")) {
    tell_object(me, "寒渊说道：再胡说就打死你！\n");
    return 1;
  } else {
    tell_object(me, "寒渊说道：是罗鹏让你来的，你从窗户跳出去，到屋子后边的树林找我。\n\n");
    return 1;
  }
}
