// crazy_sword

inherit SKILL;

mapping *action = ({
        ([      "action":               
"$N向前踏上一步，手中$w突然花作万点寒星激射而出，袭向$n的全身。",
                "dodge":                -40,
                "damage":               120,
                "damage_type":  "刺伤"
        ]),
        ([      "action":               
"$N将剑尖朝天，使出一招「南辕北辙」，自下而上划向$n的$l。",
                "dodge":                -30,
                "damage":                80,
                "damage_type":  "割伤"
        ]),
        ([      "action":               
"$N身形向左，却闪电般的从右边刺出四十九剑，刺向$n左半身的要害部位！",
                "dodge":                -30,
                "parry":                -30,
                "damage":               120,
                "damage_type":  "刺伤"
        ]),
        ([      "action":               
"$N如同醉汉一般，右手一招「醉汉斗狗」，杂乱无章的刺向$n的$l！",
                "dodge":                -40,
                "parry":                 10,
                "damage":                70,
                "damage_type":  "刺伤"
        ]),
        ([      "action":               
"$N轻吁一口长气，斜斜刺出一剑，这一剑不属于任何招数，剑尖歪斜\n"
"出剑全然无力，根本不知指向何方！",
                "dodge":                -80,
                "damage":                50,
                "damage_type":  "刺伤"
        ]),
        ([      "action":               
"$N大喝一声“「红杏出墙」”，全身化作一道剑光,象一颗流星般直飞向$n！",
                "dodge":                -5,
                "parry":                -50,
                "damage_type":  "内伤"
        ]),
        ([      "action":               
"$N身形恍惚，上刺一剑，下刺一剑，左刺一剑，右刺一剑，$n的全身被笼罩在一片剑光只中。",
                 "dodge":                -30,
                "damage":               130,
                "damage_type":  "刺伤"
        ]),
        ([      "action":   
"$N使出狂乱疯癫剑的最高境界「万剑穿心」，把手中的$w舞成无数剑影，仿佛有千百把剑刺向$n！",
                 "dodge":               -100,
                "parry":                -100,
                "damage":               250,
                "damage_type":  "刺伤"
        ]),
});

int valid_learn(object me)
{
        if( (int)me->query("max_force") < 200 )
                return notify_fail("你的内力不够，无法学习狂乱癫疯剑法。\n");

        return 1;
}

int valid_enable(string usage)
{
        return usage=="sword" || usage=="parry";
}

mapping query_action(object me, object weapon)
{
        return action[random(sizeof(action))];
}

int practice_skill(object me)
{
        object ob;
        int sk = me->query_skill("crazy_sword",1);

        if( (int)me->query("max_force") < 300 )
                return notify_fail("你的内力不够，没有办法练狂乱癫疯剑法。\n");

        if( (string)me->query_skill_mapped("force")!= "canyun_force")
                return notify_fail("狂乱癫疯剑法必须配风卷残云功才能练习。\n");

        if( !(ob = me->query_temp("weapon"))
        ||      (string)ob->query("skill_type") != "sword" )
                return notify_fail("你必须先找一把剑才能练剑法。\n");

        if( sk==20 || sk==60 || sk==100) 
                return notify_fail("你练了一次剑法，发现自己已经不能再提高了。看来是得找人指点一下了。\n");

        if( (int)me->query("kee") < 30
        ||      (int)me->query("force") < 10 )
                return 
        notify_fail("你的内力或气不够，没有办法练习狂乱癫疯剑法。\n");
        me->receive_damage("kee", 30);
        me->add("force", -10);
        write("你按著所学练了一遍狂乱癫疯剑法。\n");
        return 1;
}

string *parry_msg = ({
        "只听见「叮」一声，$n手中的$v荡开了$N手中的$w。\n",
        "$n把手中的$v舞成一片剑影，令$N的$w无法靠近。\n",
        "$n手中的$v荡起一团剑气，扫开了$N的$w。\n",
        "结果「当」地一声，被$n手中的$v格开了。\n",
});

string *unarmed_parry_msg = ({
        "$n将$v随手一摆，但见$N竟然自己将手掌送了上来，$N只能收回着一招。\n",
        "$n不进反退，$v直刺$N的双手。\n",
        "$n将手中的$v一挺，凝神运气向$N猛攻快打地挥出三剑，$N见势不妙，连退几步。\n",
});

string query_parry_msg(object weapon)
{
        if( weapon )
                return parry_msg[random(sizeof(parry_msg))];
        else
                return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}

int valid_effect(object me, object weapon, string name, int skill)
{
}

int effective_level() { return 20;}

int learn_bonus()
{
        return 0;
}
int practice_bonus()
{
        return 0;
}
int black_white_ness()
{
        return -10;
}

string perform_action_file(string action)
{
        return CLASS_D("gaibang") + "/crazy_sword/" + action;
}

