//喷云吐雾洒酒神功

inherit FORCE;

int valid_enable(string usage) { return usage=="force"; }

int valid_learn(object me)
{
        if( (int)me->query("max_force") < 1000 )
                return notify_fail("你的内力不够，无法提升喷云吐雾洒酒神功的造诣。\n");

        return 1;
}

int practice_skill(object me)
{
        return 
notify_fail("喷云吐雾洒酒神功只能用学的，或是从运用(exert)中增加熟练度。\n");
}

string exert_function_file(string func)
{
        return CLASS_D("gaibang") + "/penyuntuwu/" + func;
}
int effective_level() { return 25;}

int learn_bonus()
{
        return 10;
}
int practice_bonus()
{
        return 5;
}
int black_white_ness()
{
        return -30;
}

