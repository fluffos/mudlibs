// dumpling.c

inherit ITEM;
inherit F_FOOD;

void create() {
  set_name("咸猪肉", ({ "xiaorou", "rou" }));
  set_weight(80);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一块用盐淹过的猪肉。\n");
    set("unit", "块");
    set("value", 50);
    set("food_remaining", 3);
    set("food_supply", 60);
  }
}
