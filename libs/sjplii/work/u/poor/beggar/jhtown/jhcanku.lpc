// /jhtown/jhcanku  by poor
inherit ROOM;

int rou_num = 4;

void create() {
  set("short", "仓库");
  set("long", @LONG
这里是鸡华村中堆放粮食，谷物的地方，四周都是竹筐。
LONG
  );
  set("exits", ([ /* sizeof() == 1 */
    "north": __DIR__ "jhe1",
  ]));
  set("objects", ([ /* sizeof() == 1 */
    __DIR__ "npc/rat": 3,
  ]));
  set("no_clean_up", 0);

  setup();
  //        replace_program(ROOM);
}

void init() {
  add_action("do_search", "search");
}

int do_search(string arg) {
  object obj, me;
  me = this_player();
  if (arg == "竹筐" || arg == "筐") {
    if (rou_num != 0) {
      obj = new(__DIR__ "obj/jiang");
      obj->set_amount(1);
      obj->move(this_player());
      message_vision("$N从竹筐里拿出了一块姜。\n", this_player());
      rou_num--;
    } else write("筐里已经空了。\n");
    return 1;
  } else return 0;
}
