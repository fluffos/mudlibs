// /u/poor/gaibang/hj
inherit ROOM;

int rou_num = 1;

void create()
{
        set("short", "碎石小路");
        set("long", @LONG
这是一条由碎石铺成的小路，路的两边是低矮的灌木丛，东边
能看见连绵起伏的群山。
LONG
        );
        set("exits", ([/* sizeof() == 2 */
           "west" : __DIR__"jhe2",
           "east" : __DIR__"jhe4",
]));
        set("objects", ([ /* sizeof() == 2 */
  __DIR__"npc/liuzhl" : 1,
]));
        set("no_clean_up", 0);
	set("outdoors","gaibang");

        setup();
//        replace_program(ROOM);
}

void init()
{
	add_action("do_search", "search");
}

int do_search(string arg)
{
	object obj;
	if( arg=="corpse" || arg=="尸体" ) {
	     if(rou_num!=0) {
		    obj = new(__DIR__"obj/lock");
			obj->set_amount(1);
		 	obj->move(this_player());     
			message_vision("$N把长命锁摘了下来。\n", this_player());
		 	rou_num--;
		 }
		 else write("尸体已经被人搜过了，什么都没有。\n");
		 return 1;
	}
	else return 0;
}

