// /u/poor/gaibang/hj
inherit ROOM;

void create()
{
        set("short", "树林");
        set("long", @LONG
你走进了一片树林中，这里树木密集，很难分清方向。
LONG
        );
        set("exits", ([/* sizeof() == 2 */
           "southwest" : __DIR__"jhn2",
           "northeast" : __DIR__"jhshulin1",
           "west" : __DIR__"jhshulin",
]));
        set("no_clean_up", 0);
	set("outdoors","gaibang");

        setup();
}

void init()
{
        add_action("do_go","go");
}

int do_go()
{
if(random(5)){
this_player()->move(this_object());
return 1;
}
}
