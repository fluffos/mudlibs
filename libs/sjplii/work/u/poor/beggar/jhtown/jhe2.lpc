void create()
{
        set("short", "碎石小路");
        set("long", @LONG
这是一条由碎石铺成的小路，路的两边是低矮的灌木丛，东边
能看见连绵起伏的群山。
LONG
        );
        set("exits", ([/* sizeof() == 2 */
           "west" : __DIR__"jhe1",
           "east" : __DIR__"jhe3",
]));
        set("no_clean_up", 0);
	set("outdoors","gaibang");

        setup();
        replace_program(ROOM);
}