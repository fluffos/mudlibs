#include <ansi.h>
inherit NPC;
int ask_me();

void create()
{
        set_name("妞妞", ({ "niu niu", "girl" }) );
        set("gender", "女性" );
        set("age", 10);
        set("str", 10);
        set("cor", 10);
        set("cps", 10);
        set("title", "曹大嫂的女儿");
        set("per", 10);
        set("int", 10);
        set("chat_chance_combat", 10);
        set("chat_chance", 20);
        set("chat_msg", ({
        "妞妞说道：我去找孟爷爷，让他给我讲故事。\n",
        }) );
        set("long",     "她是一个天真，活泼的小女孩。\n");
        set("inquiry", ([
                "曹大嫂": "她是我的妈妈。",
                "孟爷爷": (: ask_me :),
        ]) ); 

        set("combat_exp", 600);

        set_skill("dodge", 5);
        set_skill("parry", 5);
        set_skill("literate", 2);
        set_skill("unarmed", 5);

        setup();

        carry_object("/u/poor/obj/cloth/gcloth")->wear();
}

int ask_me()
{
	object me;
       me = this_player();
//      if( this_player()->query_temp("per")<10) {
//	tell_object(me,"妞妞说道：我讨厌你！\n");
//	return 1;
//	}
//       else {
	tell_object(me,"妞妞说：我带你去找他。\n"
"妞妞带着你向村外走去。出了村子，穿过一片林子，前面出现了一座茅屋。\n"
"妞妞说：到了，我要回家了。妞妞快步跑开了。\n");
	me->move("/u/poor/beggar/jhtown/jhmeng");
       return 1;
//       }
}
