// fish.c

#include <ansi.h>

inherit NPC;

void create()
{
	set_name("螃蟹", ({ "pangxie" }) );
	set("long",	"一只很大的螃蟹。\n");

	set("race", "野兽");
	set("age", 2);

	set("max_gin", 1000);
	set("max_kee", 1000);
	set("max_sen", 1000);
       set_skill("move", 50);
       set_skill("unarmed", 50);
       set_skill("parry", 50);

	set("str", 10);
	set("cor", 50);

	set("limbs", ({ "头部", "身体" }) );
	set("verbs", ({ "bite" }) );

	set_temp("apply/attack", 20);
	set_temp("apply/damage", 20);
	set_temp("apply/armor", 20);
	set("combat_exp", 30000);
	setup();
}

void die()
{
        object rou;
        rou=new(__DIR__"obj/xierou");
        rou->move(this_object());
        ::die();
}

