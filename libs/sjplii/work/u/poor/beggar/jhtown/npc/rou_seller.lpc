// seller.c

inherit F_VENDOR;
inherit NPC;

void create()
{
	set_name("邹屠户", ({"zou","seller"}));
	set("title","卖肉的");
	set_skill("unarmed", 70);
	set_skill("parry", 70);
	set_skill("dodge", 70);
	set("gender","男性");

	set("force",600);
	set("max_force",600);
	set("per",10);
	set("food",200);
	set("water",200);
	set("combat_exp",1000);

	set("age", 26);
	set("long", @LONG
他在这里做些小本生意，村里的人都怕他。
LONG
);

	set("vendor_goods", ([
		__DIR__"obj/beef"	      : 20,
		__DIR__"obj/pork"	      : 20,
	]));

	setup();

	carry_object(__DIR__"obj/caidao")->wield();
	carry_object(__DIR__"obj/cloth")->wear();       
}

void init()
{
	add_action("do_vendor_list", "list");
}
