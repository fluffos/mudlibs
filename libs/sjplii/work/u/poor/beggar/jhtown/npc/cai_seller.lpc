// seller.c

inherit NPC;
inherit F_VENDOR;

void create() {
  set_name("萧大娘", ({ "xiao", "seller" }));
  set("title", "卖菜的");
  set_skill("unarmed", 30);
  set_skill("parry", 30);
  set_skill("dodge", 30);
  set("gender", "女性");

  set("force", 600);
  set("max_force", 600);
  set("per", 10);
  set("food", 200);
  set("water", 200);
  set("combat_exp", 1000);

  set("age", 26);
  set("long", @LONG
她是一个勤劳，能干的农民，靠卖菜赚点钱来养家。
LONG
  );

  set("vendor_goods", ([
    __DIR__ "obj/pea": 20,
    __DIR__ "obj/potato": 20,
    __DIR__ "obj/tomato": 20,
    __DIR__ "obj/rice": 20,
  ]));

  setup();

  carry_object(__DIR__ "obj/gcloth")->wear();
}

void init() {
  add_action("do_vendor_list", "list");
}
