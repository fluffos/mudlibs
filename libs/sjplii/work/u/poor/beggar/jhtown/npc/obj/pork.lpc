// gan.c

inherit ITEM;
inherit F_FOOD;

void create()
{
	set_name("猪肉", ({ "pork", "zhu rou","rou" }) );
	set_weight(80);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "一块普通的猪肉。\n");
		set("unit", "块");
		set("value", 100);
		set("food_remaining", 3);
		set("food_supply", 30);
	}
}
