#include <ansi.h>
inherit NPC;
void create()
{
        set_name("曹大嫂", ({ "cao dasao", "farmer" }) );
        set("gender", "女性" );
        set("age", 45);
        set("str", 10);
        set("cor", 20);
        set("cps", 10);
        set("title", "鸡华村农民");
        set("per", 10);
        set("int", 20);
        set("chat_chance_combat", 10);
        set("chat_chance", 20);
        set("chat_msg", ({
        "曹大嫂说道：谁知道呀，村长好象在村外发现了一具尸体。\n",
        }) );
        set("long",     "她是一个普普通通的农民，世世代代以种田为生。\n");
        set("inquiry", ([
                "村长": "村长住在村子的东边。",
                "孟半仙": "他住在村子附近的山中。",
        ]) ); 

        set("combat_exp", 600);

        set_skill("dodge", 30);
        set_skill("parry", 30);
        set_skill("literate", 20);
        set_skill("unarmed", 20);
        set_temp("apply/defense", 30);
        set_temp("apply/move", 30);

        setup();

        carry_object("/u/poor/obj/cloth/gcloth")->wear();
}

