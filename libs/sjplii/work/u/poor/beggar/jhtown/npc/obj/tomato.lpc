// gan.c

inherit ITEM;
inherit F_FOOD;

void create() {
  set_name("番茄", ({ "tomato" }));
  set_weight(80);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一种可口的蔬菜。\n");
    set("unit", "个");
    set("value", 60);
    set("food_remaining", 2);
    set("food_supply", 20);
  }
}
