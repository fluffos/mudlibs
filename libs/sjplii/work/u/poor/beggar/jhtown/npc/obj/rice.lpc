// gan.c

inherit ITEM;
inherit F_FOOD;

void create()
{
	set_name("大米", ({ "rice" }) );
	set_weight(80);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "一种十分重要的谷物。\n");
		set("unit", "袋");
		set("value", 80);
		set("food_remaining", 1);
		set("food_supply", 20);
	}
}
