// fisher

inherit NPC;
inherit F_VENDOR;

void create()
{
	set_name("冯老头", ({"feng","seller"}));
	set_skill("unarmed", 50);
	set_skill("parry", 50);
	set_skill("dodge", 50);
	set("gender","男性");

	set("force",200);
	set("max_force",200);
	set("per",15);
	set("food",200);
	set("water",200);
	set("combat_exp",50000);

	set("age", 69);
	set("long", @LONG
他是村中的长者，每天都在这里钓鱼。
LONG
);
        set("chat_chance_combat", 10);
        set("chat_chance", 1);
        set("chat_msg", ({
        "冯老头说道：唉....怎么现在鲤鱼这么多？\n"
        }) );
        set("inquiry", ([
                "鱼": "你是想买鱼吗？这几天我只钓到了鲤鱼",
                "买鱼": "在河的上游有个渔民。",
                "扇贝": "你可以下河自己摸点呀。",
                "青虾": "渔民那里应该有吧。",
                "螃蟹": "螃蟹一般在河边能抓到。",
        ]) ); 

	set("vendor_goods", ([
		__DIR__"obj/liyu"	      : 5,
	]));

	setup();

	carry_object(__DIR__"obj/yugan")->wield();
	carry_object(__DIR__"obj/cloth")->wear();       
}

void init()
{
	add_action("do_vendor_list", "list");
}
