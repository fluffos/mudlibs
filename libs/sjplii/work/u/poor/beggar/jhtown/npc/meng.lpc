#include <ansi.h>
inherit NPC;
void create()
{
        set_name("孟半仙", ({ "meng" }) );
        set("nickname", HIY "天机仙人" NOR);
        set("title", "法明寺高僧");
        set("gender", "男性" );
        set("age", 95);
        set("str", 30);
        set("cor", 10);
        set("cps", 15);
        set("per", 10);
        set("int", 20);
        set("inquiry", ([
                "丐帮老帮主": "因名为利，隐归山中。",
                "商殷宝藏": "钻山穿林，名利双收。",
                "商殷藏宝图": "因图而死，为图将亡。",
                "翡翠匕首": "匕首再现，江湖祸起。",
                "古墓传人": "似人似仙，无影无形。",
                "打狗棒": "失在丐帮，得于丐帮。",
                "匕首的主人": "藏于丐帮，实出寒灵。",
                "神光": "为义如此，可喜可贺。",
                "穷困": "天上仙人，变动天机。",
                "玄铁剑": "似剑非剑，惊天动地。",
                "飞鸿": "难料！难料！",
                "白大侠": "雪山神人，掌握世间。",
        ]) ); 
        set("chat_chance", 10);
        set("chat_msg", ({
        "孟半仙说道：世间万物，皆难预料。\n",
        }) );
        set("long",     "他是法明寺的得到高僧，可以说不是凡人了。\n");

        set("max_kee", 8000);
        set("kee", 8000);
        set("force", 8000);
        set("max_force", 8000);
        set("force_factor",100);
        set("combat_exp",600000);

        set_skill("unarmed", 200);
        set_skill("force", 200);
        set_skill("parry", 200);
        set_skill("dodge", 200);

        set_skill("sanhua-strike", 200);
        set_skill("literate", 200);

        map_skill("unarmed", "sanhua-strike");
 
        create_family("法明寺", 5, "高僧");

        setup();
        carry_object("/u/poor/obj/cloth/sengpao")->wear();
}
void init()
{
        object ob;
        ::init();
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("checklooking");
                call_out("checklooking", 1, ob);
        }
}

void checklooking(object ob)
{
        command("say 苦海无涯，回头是岸。");      
}

int accept_object(object me, object ob)
{
         object clasp;
         me=this_player();
         if( (string)ob->query("name") !="白色纸片" && (string)ob->query("id") !="white_paper"  ) 
         {
         command("say 罪过，罪过。\n");
         }
         else{
         command("say 写的颇有深意，但还没到无我的境界。");
         command("say 这个东西赠与你吧。");
         ob = new(__DIR__"obj/yellow_paper");
         ob->move(me);
      }
        return 1;       
}
