#include <ansi.h>
inherit NPC;
void create()
{
        set_name("人厨子", ({ "ren chuzi" }) );
        set("gender", "男性" );
        set("age", 55);
        set("str", 20);
        set("cor", 10);
        set("cps", 15);
        set("title", "天下第一厨子");
        set("per", 10);
        set("int", 20);
        set("long",     "他就是人厨子。\n");
        set("inquiry", ([
                "蚝油牛肉": "主要原料是牛肉。",
                "过油肉": "主要原料是猪肉。",
                "木耳菜": "主要原料是木耳。",
                "荷包蛋": "主要原料是鸟蛋。",
                "炒蛇肉": "主要原料是蛇肉。",
                "小鸡炖松蘑": "主要原料是松蘑。",
                "香野菜": "主要原料是一种紫色的小草。",
                "焦香兔肉": "主要原料是兔肉。",
                "炖野鸡肉": "主要原料是野鸡肉。",
                "凉拌咸肉": "主要原料是咸猪肉。",
                "红烧鲫鱼": "主要原料是鲫鱼。",
                "油焖扁豆": "主要原料是扁豆。",
                "油焖大虾": "主要原料是青虾。",
                "炒米饭": "主要原料是大米。",
                "水晶鲜贝": "主要原料是扇贝肉。",
                "炒蟹肉": "主要原料是螃蟹肉。",
                "龙虾": "我也不知道哪有。",
        ]) ); 

        set("combat_exp", 2600);

        set_skill("dodge", 40);
        set_skill("parry", 40);
        set_skill("literate", 80);
        set_skill("unarmed", 20);
        set_temp("apply/defense", 30);
        set_temp("apply/move", 30);

        setup();

        carry_object("/u/poor/obj/cloth/silk-cloth")->wear();
}

