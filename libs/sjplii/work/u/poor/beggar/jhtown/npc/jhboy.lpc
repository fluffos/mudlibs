#include <ansi.h>
inherit NPC;
void create()
{
        set_name("小男孩", ({ "kid", "boy" }) );
        set("gender", "男性" );
        set("age", 5);
        set("str", 10);
        set("cor", 10);
        set("cps", 15);
        set("title", "鸡华村的");
        set("per", 10);
        set("int", 20);
        set("chat_chance_combat", 10);
        set("chat_chance", 20);
        set("chat_msg", ({
        "小男孩说道：我爸爸还在田里干活。\n",
        }) );
        set("long",     "他是一个普普通通农民的孩子。他家世世代代以种田为生。\n");

        set("combat_exp", 5);

        set_skill("dodge", 1);
        set_skill("parry", 1);
        set_skill("unarmed", 1);

        setup();

        carry_object(__DIR__"obj/cloth")->wear();
}
void init()
{
        object ob;
        ::init();
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("checklooking");
                call_out("checklooking", 1, ob);
        }
}

void checklooking(object ob)
{
        command("say 欢迎你来到鸡华村。");      
}