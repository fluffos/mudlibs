// Room: /jing/duankit.c

inherit ROOM;
int sword_num = 1;
int cezi_num = 1;

void create()
{
	set("short", "无名居");
	set("long", @LONG
这里就是江湖魔头无名客的密室，在正中的石台上插着
一柄黑色的宝剑。四周的墙壁上挂着许多翡翠匕首，在右边
有一个石床，床上放着一本黄色的册子，和一只竹杖。
    这里没有明显的出口。
LONG
	);
       set("item_desc", ([ /* sizeof() == 2 */
  "宝剑" : "这就是失传以久的玄铁剑，你可以试着拔出来。
",
  "册子" : "这是一本《丐帮帮规》，你可以试着拿起来。
",
]));
	set("no_clean_up", 0);

	setup();
}
void init()
{
	add_action("do_zhuan", "zhuan" );
	add_action("do_take", "take" );
	add_action("do_pull", "pull" );
}

int do_zhuan(string arg)
{
	if( arg=="石头" || arg=="stone") {
	    if(this_player()->query_skill("unarmed", 1)<=180) {
		     write("你用力转动石头，可是什么都没有发生。\n");
			 return 1;
		}
		message_vision("$N用力转动石头，只听“咚”的一声，开起了一道石门。\n", this_player());
		this_player()->move(__DIR__"hole5");
		message("vision", this_player()->name() + "钻了进去。\n",
			environment(this_player()), this_player());
		return 1;
	}
	else return 0;
}
int do_pull(string arg)
{
	object obj;
	if( arg=="sword" || arg=="宝剑" ) {
	     if(sword_num!=0) {
		    obj = new(__DIR__"obj/iron-sword");
			obj->set_amount(1);
		 	obj->move(this_player());     
			message_vision("$N用力把玄铁剑拔了出来。\n", this_player());
		 	sword_num--;
		 }
		 else write("剑已经被拔走了。\n");
		 return 1;
	}
	else return 0;
}
int do_take(string arg)
{
	object obj;
	if( arg=="cezi" || arg=="册子" ) {
	     if(cezi_num!=0) {
		    obj = new(__DIR__"obj/cezi");
			obj->set_amount(1);
		 	obj->move(this_player());     
			message_vision("$N把《丐帮帮规》拿了起来。\n", this_player());
		 	cezi_num--;
		 }
		 else write("床上什么都没了。\n");
		 return 1;
	}
	else return 0;
}

