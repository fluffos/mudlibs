// wangqr.c

#include <ansi.h>
inherit NPC;

void create()
{
        set_name("施楠", ({ "shi nan", "master", "shi" }) );
        set("nickname", HIB "酒丐" NOR);
        set("title", "丐帮前任帮主");
        set("gender", "男性");
        set("age", 75);
        set("long",
 "他就是丐帮的前任帮主，但是现在他武功以废。\n");
        set("inquiry", ([
                "拜师": "要看你的资质而定了！",
                "史枫": "他的剑法很厉害呀。",
                "石海风": "徒儿还好吗？",
                "肖空鸣": "这个逆徒！！！",
                "丐帮": "不知道帮中怎么样了。",
                "无名客": "唉...........",
                "杨姑娘": "我对不起她呀。",
        ]) ); 
        set("str", 36);
        set("int", 22);
        set("spi", 25);
        set("per", 23);
        set("cps", 23);
        set("max_kee", 8000);
        set("kee", 8000);
        set("force", 9000);
        set("max_force", 9000);
        set("force_factor",80);
        set("combat_exp",9000000);

        set_skill("unarmed", 300);
        set_skill("sword", 300);
        set_skill("force", 300);
        set_skill("parry", 300);
        set_skill("dodge", 300);
        set_skill("penyuntuwu", 300);
        set_skill("begging", 300);

        map_skill("force", "penyuntuwu");

        create_family("丐帮", 1, "弟子");

        setup();

        carry_object(__DIR__"obj/cloth")->wear();
}

void attempt_apprentice(object ob)
{
	int exp = (int)ob->query("combat_exp");
	if( exp > 500000) {
       command("smile");
       command("say 很好，" + RANK_D->query_respect(ob) + 
"多加努力，他日必定有成。\n");
       command("recruit " + ob->query("id") );
       ob->set("class", "gaibang");
       ob->set("title", "丐帮长老");
	}
	else {
	command("say 这位" + RANK_D->query_respect(ob) + "的资质似乎不足。\n");
	}
}
