// mianju.c

#include <armor.h>
#include <ansi.h>

inherit HEAD;

void create()
{
	set_name( WHT "人皮面具" NOR , ({ "mianju" }) );
	set_weight(200);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "这张由人皮制成的面具。\n");
		set("unit", "张");
		set("value", 200);
		set("material", "paper");
		set("armor_prop/armor", 10);
	}
	setup();
}

