// fish

inherit ITEM;
inherit F_FOOD;

void create()
{
	set_name("木耳", ({ "muer" }) );
	set_weight(80);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "一片黑色的木耳。\n");
		set("unit", "片");
		set("value", 100);
		set("food_remaining", 1);
		set("food_supply", 10);
	}
}
