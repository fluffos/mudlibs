// houndbane.c

#include <ansi.h>
#include <weapon.h>

inherit SWORD;

void create()
{
	set_name( HIW "无尘剑" NOR, ({ "wuchen-sword" }) );
	set_weight(1000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "把");
		set("long", "这是一把江湖前辈用过的宝剑。\n");
		set("value", 2000);
		set("material", "blacksteel");
		set("wield_msg", HIW "只见白光一闪，$N手中出现了一把$n。\n" NOR);
		set("unequip_msg", HIW "只见白光一闪，$N手中的$n已经插在了背后。\n" NOR);
	}

	init_sword(100);
	setup();
}
