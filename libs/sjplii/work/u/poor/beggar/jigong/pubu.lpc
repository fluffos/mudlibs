// Room: /jing/duankit.c

inherit ROOM;

int rou_num = 3;

void create()
{
	set("short", "瀑布");
	set("long", @LONG
你顺着小溪来到了这里，这是一个不大的瀑布，瀑布下
有个清澈的水潭，水从瀑布流下溅起了大片大片的水雾，使
的附近十分潮湿。在瀑布旁有几棵桦树，在桦树的树干上长
着一些黑色的东西。
LONG
	);
	set("item_desc", ([ /* sizeof() == 1 */
  "黑色的东西" : "一片黑色的木耳
",
]));
        
       set("exits", ([ /* sizeof() == 1 */
  "southwest" : __DIR__"road2",
]));
	set("objects", ([ /* sizeof() == 1 */
  __DIR__"npc/bird" : 1,
]));
	set("no_clean_up", 0);
	set("outdoors","gaibang");

	setup();
//	replace_program(ROOM);
}

void init()
{
	add_action("do_pick", "pick");
}

int do_pick(string arg)
{
	object obj;
	if( arg=="木耳" || arg=="muer" ) {
	     if(rou_num!=0) {
		    obj = new(__DIR__"obj/muer");
			obj->set_amount(1);
		 	obj->move(this_player());     
			message_vision("$N从树干上摘下一片木耳。\n", this_player());
		 	rou_num--;
		 }
		 else write("树上什么都没有了。\n");
		 return 1;
	}
	else return 0;
}
