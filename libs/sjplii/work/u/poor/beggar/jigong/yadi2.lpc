// /u/poor/gaibang/hj
inherit ROOM;

void create()
{
        set("short", "崖底");
        set("long", @LONG
这里是两个峭壁中间的一条窄缝，有几丈宽，从这里只能看
见峡谷上边的几缕阳光。在峭壁底部有个山洞，山洞边上长着许
多杂草。在右边有一个不大的水潭。
    这里没有明显的出口。
LONG
        );
        set("no_clean_up", 0);
	set("outdoors","gaibang");

        setup();
}

void init()
{
        add_action("do_climb", "climb");
	 add_action("do_enter", "enter");
}

int do_enter(string arg)
{
	object me = this_player();

	if( (!arg ) || (!(arg=="hole" || arg == "山洞" )) )
		return 0;
		message_vision("$N钻进了山洞。\n",me);
		me->move(__DIR__"yadi3");
		return 1;
}

int do_climb(string arg)
{
	if( arg=="峭壁" || arg=="qiaobi") {
	    if(this_player()->query_skill("dodge", 1)<=50) {
		     write("你慢慢爬了上去，一不小心摔了小来。\n");
			 return 1;
		}
		message_vision("$N慢慢爬了上去。\n", this_player());
		this_player()->move(__DIR__"wuchenya");
		message("vision", this_player()->name() + "爬上了峭壁。\n",
			environment(this_player()), this_player());
		return 1;
	}
	else return 0;
}
