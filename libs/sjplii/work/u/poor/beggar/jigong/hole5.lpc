// Room: /jing/duankit.c

inherit ROOM;

void create()
{
	set("short", "洞中");
	set("long", @LONG
这里一片漆黑，只能借助洞口的点点光亮来分辨四周围
的事物。不时能听到石钟乳流下的水声。在地上有几个脚印，
前边的石壁上有一丝亮光，这里是一个死洞。
LONG
	);
       set("item_desc", ([ /* sizeof() == 2 */
  "脚印" : "脚印一直延伸到一块嵌在山洞上手掌般大小的石头前。
",
  "石壁" : "石壁上有一个小洞，阳光射进到了石洞中。
",
]));
       set("exits", ([ /* sizeof() == 1 */
  "west" : __DIR__"hole4",
]));
	set("objects", ([ /* sizeof() == 1 */
  __DIR__"npc/bianfu" : 2,
]));
	set("no_clean_up", 0);

	setup();
}
void init()
{
	add_action("do_zhuan", "zhuan" );
	add_action("do_break", "break" );
}

int do_zhuan(string arg)
{
	if( arg=="石头" || arg=="stone") {
	    if(this_player()->query_skill("unarmed", 1)<=180) {
		     write("你用力转动石头，可是什么都没有发生。\n");
			 return 1;
		}
		message_vision("$N用力转动石头，只听“咚”的一声，开起了一道石门。\n", this_player());
		this_player()->move(__DIR__"noroom");
		message("vision", this_player()->name() + "钻了进去。\n",
			environment(this_player()), this_player());
		return 1;
	}
	else return 0;
}
int do_break(string arg)
{
	object me,ob;
	me = this_player();

	if( arg=="石壁" || arg=="shibi") {
	if (!objectp(ob = present("map-right", me))) {
       	message_vision("$N用尽全力击向石壁，“咚”的一声，石壁裂开露出一个洞。\n",me);
		     write("你没有地图，不敢进去。\n");
	       return 1;
		}
       	message_vision("$N用尽全力击向石壁，“咚”的一声，石壁裂开露出一个洞。\n",me);
       	message_vision("$N走了进去。\n",me);
	       me->move(__DIR__"baodoor");
       	return 1;
	}
	else return 0;
}

