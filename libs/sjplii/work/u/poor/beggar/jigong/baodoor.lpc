// Room: /jing/duankit.c

inherit ROOM;

void create()
{
	set("short", "商殷宝藏入口");
	set("long", @LONG
你来到了商殷宝藏的入口，这里两面依山，两面挨着树
林，很难被人们发现。在北面是商殷宝藏的入口，入口旁边
有一座石碑。在西边是朝云洞(hole)的入口。
LONG
	);
       set("item_desc", ([ /* sizeof() == 1 */
  "石碑" : "上边写着几个字：有缘者进之。
",
]));
       set("item_desc", ([ /* sizeof() == 1 */
  "hole" : "这是朝云洞的入口，你可以进(enter)去。
",
]));

       set("exits", ([ /* sizeof() == 1 */
  "north" : __DIR__"baohall",
]));
	set("objects", ([ /* sizeof() == 1 */
  __DIR__"npc/bird" : 1,
]));
	set("no_clean_up", 0);
	set("outdoors","gaibang");

	setup();
}
void init()
{
	add_action("do_enter", "enter" );
	add_action("do_go", "go" );
}

int do_enter(string arg)
{
	if( arg=="hole" || arg=="山洞") {
	    if(this_player()->query_skill("unarmed", 1)<=80) {
		     write("你突然感觉一阵头晕。\n");
                  this_player()->unconcious();
			 return 1;
		}
		message_vision("$N钻进了山洞之中。\n", this_player());
		this_player()->move(__DIR__"hole5");
		return 1;
	}
	else return 0;
}

int do_go(string arg)
{
	object me,ob;
	me = this_player();

	if( arg=="north" ) {
	if (!objectp(ob = present("map-left", me))) {
		     write("你想进入商殷宝藏，但是没有地图的左边。\n");
	       return 1;
		}
       	message_vision("$N走进了商殷宝藏之中。\n",me);
	       me->move(__DIR__"baohall");
       	return 1;
	}
	else return 0;
}

