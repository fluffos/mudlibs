// Room: /u/poor/gaibang/zhulin2.c

inherit ROOM;
#include <ansi.h>;

void create()
{
	set("short", HIB"地道"NOR);
	set("long", @LONG
你走在丐帮的地道之中，这里光线十分昏暗，几乎看无清
四周的景物。不时能听到“嘀嗒、嘀嗒”的水声。北边是一间
牢房。
LONG
	);
	set("item_desc", ([ /* sizeof() == 1 */
  "牢房" : "北边就是牢房，你可以进(enter)去。
",
]));
	set("exits", ([ /* sizeof() == 2 */
    "east" : __DIR__"ddguan4",
]));
        set("no_clean_up", 0);

	setup();
}

void init()
{
	add_action("do_enter", "enter");
}

int do_enter(string arg)
{
	object me = this_player();

	if( (!arg ) || (!(arg=="laofang" || arg == "牢房" )) )
		return 0;
	if (me->query("marks/killwu"))
	{
		message_vision("$N走进了牢房。\n",me);
		me->move(__DIR__"ddguan7");
		return 1;
	}
	else {
		message_vision("$N走进了牢房。\n",me);
		me->move(__DIR__"ddguan6");
		return 1;
	}
}
