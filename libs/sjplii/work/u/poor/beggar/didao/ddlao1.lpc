// Room: /u/poor/gaibang/zhulin2.c

inherit ROOM;
#include <ansi.h>;

void create() {
  set("short", HIB "地道" NOR);
  set("long", @LONG
你走在丐帮的地道之中，这里光线十分昏暗，几乎看无清
四周的景物。不时能听到“嘀嗒、嘀嗒”的水声。
LONG
  );
  set("exits", ([ /* sizeof() == 2 */
    "west": __DIR__ "ddroad9",
    "east": __DIR__ "ddlao2",
  ]));
  set("objects", ([ /* sizeof() == 1 */
    __DIR__ "npc/beggar": 2,
  ]));
  set("no_clean_up", 0);

  setup();
}
int valid_leave(object who, string exit) {
  object ob;
  ob = present("beggar", environment(who));

  if (ob) if (ob->query_temp("block_msg/all"))
    return ::valid_leave(who, exit);

  if ((exit == "east") && (who->query("class") == "gaibang") && (present(
    "beggar",
    environment(who)
  )))
    return notify_fail("叫花子说道：东边关的是囚犯，你不能过去！”\n");
  return ::valid_leave(who, exit);
}
