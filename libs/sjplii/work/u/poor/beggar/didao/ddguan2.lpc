// Room: /u/poor/gaibang/zhulin2.c

inherit ROOM;
#include <ansi.h>;

void create() {
  set("short", HIB "地道" NOR);
  set("long", @LONG
你走在丐帮的地道之中，这里光线十分昏暗，几乎看无清
四周的景物。不时能听到“嘀嗒、嘀嗒”的水声。在西边是一
扇巨大的石门。
LONG
  );
  set("item_desc", ([ /* sizeof() == 1 */
    "石门": "这是一扇十分巨大的石门，在门上有一个黄色的钥匙孔。
",
  ]));
  set("exits", ([ /* sizeof() == 2 */
    "southeast": __DIR__ "ddguan1",
  ]));
  set("no_clean_up", 0);

  setup();
}
void init() {
  add_action("do_use", "use");
}
int do_use(string arg) {
  object me, ob;
  me = this_player();

  if (arg == "钥匙" || arg == "key" || arg == "yellow-key") {
    if (!objectp(ob = present("yellow-key", me))) {
      write("钥匙怎么也插不进去。\n");
      return 1;
    }
    message_vision("$N把黄色的钥匙插了进去，“咚”的一声，石门开了，你走了进去。\n", me);
    me->move(__DIR__ "ddguan3");
    return 1;
  } else return 0;
}
