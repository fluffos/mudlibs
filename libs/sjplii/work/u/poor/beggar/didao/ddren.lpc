// Room: /u/poor/gaibang/zhulin2.c

inherit ROOM;
#include <ansi.h>;

void create() {
  set("short", HIB "石室" NOR);
  set("long", @LONG
你走进了间屋子之中，屋子的中间摆放着一张石桌，桌子
四周有几把椅子。在桌子的后边有一个木柜子。柜子的旁边是
一张木床。
LONG
  );
  set("exits", ([ /* sizeof() == 2 */
    "east": __DIR__ "ddroad16",
  ]));
  set("objects", ([ /* sizeof() == 1 */
    __DIR__ "npc/beggar": 2,
  ]));
  set("no_clean_up", 0);

  setup();
}
void init() {
  add_action("do_move", "move");
}

int do_move(string arg) {
  if (arg == "木柜子" || arg == "柜子") {
    if (this_player()->query_skill("parry", 1) <= 20) {
      write("你没有那么大力气，搬不开柜子。\n");
      return 1;
    }
    message_vision("$N把柜子搬开，发现后边有个洞，就钻了进去。\n", this_player());
    this_player()->move("/u/poor/beggar/renduo/renchan");
    message("vision", this_player()->name() + "搬开了柜子，钻进了柜子后边的洞。\n",
      environment(this_player()), this_player());
    return 1;
  } else return 0;
}
