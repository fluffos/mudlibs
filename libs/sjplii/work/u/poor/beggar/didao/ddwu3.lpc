// Room: /u/poor/gaibang/zhulin2.c

inherit ROOM;
#include <ansi.h>;
int rou_num = 1;

void create() {
  set("short", HIB "石室" NOR);
  set("long", @LONG
这里是间丐帮地道中的密室，在密室的左边放着一个书架。
书架的旁边有一张石床。在右边靠墙处摆放着个兵器架子。
LONG
  );
  set("item_desc", ([ /* sizeof() == 1 */
    "书架": "在这个书架上摆放着几本书。
",
  ]));
  set("exits", ([ /* sizeof() == 2 */
    "out": __DIR__ "ddwu2",
  ]));
  set("objects", ([ /* sizeof() == 1 */
    __DIR__ "obj/shelf": 1,
    __DIR__ "npc/wu": 1,
  ]));
  set("no_clean_up", 0);

  setup();
}
void init() {
  add_action("do_search", "search");
  add_action("do_get", "get");
}

int do_search(string arg) {
  object obj, me;
  me = this_player();
  if (arg == "书架" || arg == "架") {
    if (rou_num != 0) {
      obj = new("/u/poor/obj/book/dragon-book");
      obj->set_amount(1);
      obj->move(this_player());
      message_vision("$N从书架上找到一本书。\n", this_player());
      rou_num--;
    } else write("书架上什么都没有。\n");
    return 1;
  } else return 0;
}

int do_get(string arg) {
  string obj, from;
  object me, shelf, target, taro;

  if (sscanf(arg, "%s from %s", obj, from) == 2) {
    if (obj == "all") {
      write("拿那么多武器干什么？\n");
      return 1;
    }
    shelf = present("weapon shelf", this_object());
    target = present(from, this_object());
    me = this_player();
    if (target == shelf) {
      taro = present(obj, target);
      if (taro) {
        message_vision("$N从兵器架上拿下件兵器。\n", me);
      }
    }
  }
  return 0;
}
void reset() {
  object *inv;
  object con, item;
  int i;

  ::reset();
  con = present("weapon shelf", this_object());
  inv = all_inventory(con);
  if (sizeof(inv) != 4) {
    for (i = sizeof(inv) - 1; i >= 0; i--) destruct(inv[i]);
    item = new("/u/poor/obj/weapon/poor-sword");
    item->move(con);
    item = new("/u/poor/obj/weapon/green_stick");
    item->move(con);
    item = new("/u/poor/obj/weapon/blade");
    item->move(con);
    item = new("/u/poor/obj/weapon/gdagger");
    item->move(con);
  }
}
