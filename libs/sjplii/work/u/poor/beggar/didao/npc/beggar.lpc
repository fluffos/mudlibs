// beggar.c

#include <ansi.h>
inherit NPC;


void create()
{	
	 string *order = ({"智舵", "礼舵", "仁舵", "孝舵", "四袋", "五袋", "六袋", "三袋", "七袋"});

        set_name("叫花子", ({ "beggar" }) );
        set("title", "丐帮"+(order[random(9)])+"弟子");
        set("gender", "男性");
        set("age", 15+random(50));
        set("long",
 "他是丐帮的弟子。\n");
        set("inquiry", ([
                "拜师": "问那么多干吗，快拜师吧！",
                "进门": "只有本帮弟子才能进入智舵。",
        ]) ); 
        set("max_kee", 1500);
        set("kee", 1500);
        set("force", 1000);
        set("max_force", 1000);
        set("force_factor",20);
        set("combat_exp", 100000+random(500000));
        set_skill("unarmed", 20+random(100));
        set_skill("stick", 20+random(100));
        set_skill("parry", 20+random(100));
        set_skill("dodge", 20+random(100));
        set_skill("qingyun_stick", 20+random(100));
        set_skill("iron_strike", 20+random(100));
        set_skill("hidden_dodge", 20+random(100));
        set_skill("canyun_force", 20+random(100));
        map_skill("dodge", "hidden_dodge");
        map_skill("unarmed", "iron_strike");
        map_skill("force", "canyun_force");

        create_family("丐帮", 3+random(7), "弟子");

        setup();

        carry_object("/u/poor/obj/cloth/jingyi")->wear();
        carry_object("/u/poor/obj/weapon/stick")->wield();
}
