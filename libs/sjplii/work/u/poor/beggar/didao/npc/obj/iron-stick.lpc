// stick.c

#include <ansi.h>
#include <weapon.h>

inherit STICK;

void create() {
  set_name(RED "铁棒" NOR, ({ "iron-stick", "stick" }));
  set_weight(600);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "条");
    set("long", "一条普通的铁棒。\n");
    set("value", 20);
    set("material", "iron");
    set("wield_msg", "$N拿出一根$n抄在手中。\n");
    set("unwield_msg", "$N放下手中的$n。\n");
  }

  init_stick(60);
  setup();
}
void init() {
  add_action("do_zhe", "zhe");
}
int do_zhe(string arg) {
  object me, stick;
  me = this_player();
  if (!(arg == "iron-stick" || arg == "stick"))
    return 0;
  if (!(arg)) {
    write("你要折什么？\n");
    return 1;
  }
  tell_object(me, @TEXT
你折断了铁棒，发现里边是空心的，从里边拿出了打狗棒。
TEXT
  );
  stick = new("/u/poor/obj/weapon/dog_stick");
  stick->move(me);
  destruct(this_object());
  return 1;
}
