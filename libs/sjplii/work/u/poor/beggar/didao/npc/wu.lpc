// wu
inherit NPC;
inherit F_MASTER;
#include <ansi.h>;

void create() {
  set_name("无名客", ({ "no name", "master" }));
  set("gender", "男性");
  set("nickname", BLU "匕首的主人" NOR);
  set("title", "寒灵山庄雨针堂堂主");
  set("age", 55);
  set("attitude", "aggressive");
  set("str", 40);
  set("int", 40);
  set("long", @LONG
他就是江湖上传说的大魔头无名客，没有人见过他的真正面目，他总
是带着一个人皮面具，以各种模样出现在人的面前。由于他总是用匕
首当做武器，所以江湖上又叫他匕首的主人。
LONG
  );
  set("max_kee", 3500);
  set("kee", 3500);
  set("force", 2500 + random(2500));
  set("max_force", 4000);
  set("force_factor", 20 + random(60));
  set("combat_exp", 1000000 + random(1000000));

  set("chat_chance_combat", 20);
  set("chat_msg_combat", ({
    (: perform_action, "dodge.guixi" :),
    (: perform_action, "dodge.baoxing" :),
  }));

  set_skill("unarmed", 100 + random(100));
  set_skill("blade", 100 + random(100));
  set_skill("parry", 100 + random(100));
  set_skill("dodge", 100 + random(100));
  set_skill("xianyin_blade", 100 + random(100));
  set_skill("xianglong_strike", 100 + random(100));
  set_skill("hidden_dodge", 100 + random(100));
  set_skill("canyun_force", 100 + random(100));

  map_skill("dodge", "hidden_dodge");
  map_skill("unarmed", "xianglong_strike");
  map_skill("blade", "xianyin_blade");
  map_skill("parry", "xianyin_blade");
  map_skill("force", "canyun_force");


  create_family("寒灵山庄", 2, "弟子");

  setup();
  carry_object("/u/poor/obj/weapon/blade")->wield();
  carry_object("/u/poor/obj/cloth/heiyi")->wear();
  carry_object("/u/poor/obj/cloth/mianju")->wear();
}

void attempt_apprentice(object ob) {
  int exp = (int)ob->query("combat_exp");
  if (exp > 5000000) {
    command("smile");
    command("say 很好，" + RANK_D->query_respect(ob) +
      "跟随我修炼，他日必定有成。\n");
    command("recruit " + ob->query("id"));
    ob->set("class", "hanling");
  } else {
    command("say 这位" + RANK_D->query_respect(ob) + "不要异想天开了，我怎么能收你为徒。\n");
  }
}

void die() {
  object me;
  if (!me = query_temp("last_damage_from"))
    me = this_player(1);
  if (!me->query("marks/killwu")) {
    tell_object(me, HIY "无名客被打伤在地，奄奄一息了，说道：寒灵山庄的人一定会给我报仇的！！\n" NOR);
    tell_object(me, HIY "恭喜你！！你杀死了这个江湖大魔头！！\n\n" NOR);
    tell_object(me, HIM "你增加了100000点经验。\n" NOR);
    tell_object(me, HIM "你增加了20000点潜能。\n\n" NOR);
    me->add("combat_exp", 100000);
    me->add("potential", 20000);
    me->set("marks/killwu", 1);
  }
  ::die();
}
