// eleventh npc by poor

#include <ansi.h>
inherit NPC;
int ask_me();
int ask_me1();
int paper_count = 2;
int ask_wu();

void create()
{
        set_name("神光", ({ "shen guang", "shen", "guang" }) );
        set("gender", "男性");
        set("title", "丐帮长老");
        set("nickname", HIY "飘渺神僧" NOR);
        set("age", 65);
        set("long",
 "他本是位高僧，后因为对老帮主的景仰加入了丐帮，但是现在他武功全失。\n");
        set("inquiry", ([
                "拜师": "想拜我为师？我怎么干当呢？",
                "污衣帮": "随便说是要死人的。",
                "加入污衣帮": "你没开玩笑吧。",
                "穿污衣，行侠义": (: ask_me :),
                "升级": (: ask_me1 :),
                "悟" : (: ask_wu :),
                "最高境界" : (: ask_wu :),
                "悟禅" : (: ask_wu :),
                "老帮主": "哎，老帮主已经失踪多年。但是..........",
                "商殷宝藏": "这宝藏里有什么谁都不知道，但是已经流传很久了。",
                "商殷藏宝图": "我的好友刘长老已经去找地图了。",
                "翡翠匕首": "我的功夫就是被这柄匕首废的，刘长老说：老帮主的失踪和匕首有关。",
        ]) ); 
        set("chat_chance", 1);
        set("chat_msg", ({
        "神光叹了口气，说道：师祖总说我悟不到无我的境界，无我到底是什么境界呢？\n",
        "神光自言自语道：商殷宝藏不知道害死了多少人。\n",
        "神光说道：刘长老上次来说，他已经打探到老帮主的踪迹了。\n",
        }));
        set("str", 36);
        set("max_kee", 4000);
        set("kee", 4000);
        set("force", 3000);
        set("max_force", 3000);
        set("force_factor",100);
        set("combat_exp",500000);

        set_skill("unarmed", 200);
        set_skill("force", 200);
        set_skill("parry", 200);
        set_skill("dodge", 200);
        set_skill("begging", 200);
        set_skill("xianglong_strike", 180);
        set_skill("sanhua-strike", 200);
        set_skill("stick", 200);
        set_skill("yecha_stick", 200);

        set_skill("hidden_dodge", 200);
        set_skill("canyun_force", 200);
        set_skill("literate", 180);

        map_skill("dodge", "hidden_dodge");
        map_skill("unarmed", "xianglong_strike");
        map_skill("force", "canyun_force");

        create_family("丐帮污衣帮", 2, "弟子");

        setup();

        carry_object("/u/poor/obj/cloth/wuyi")->wear();
}

void attempt_apprentice(object ob)
{
	if (!ob->query("marks/wuyi10") ) {
	command("say 这位" + RANK_D->query_respect(ob) + "，我怎么能当人师父呢？\n");
	}
	else {
        command("say 很好，" + RANK_D->query_respect(ob) +
"多加努力，他日必定有成。\n");
        command("recruit " + ob->query("id") );
       ob->set("class", "gaibang");
       ob->set("title","丐帮污衣帮智舵副舵主");
	}
}

void recruit_apprentice(object ob)
{
        if( ::recruit_apprentice(ob) )
                ob->set("class", "gaibang");
}

int accept_object(object me, object ob)
{
        int exp,pot;
         me=this_player();
        exp = (int) me->query("combat_exp");
        pot = (int) me->query("potential");

	if( me->query("marks/wuyi10") ) {
       if( (string)ob->query("id") !="yellow_paper") {
       command("say 阿弥陀佛。\n");
       return 0;
	} 
	else {
	tell_object(me,"神光接过黄色纸片。\n\n");
	tell_object(me,"神光说道：你去找丐帮总舵的肖长老，告诉他暗号，他就会收你为徒弟的。\n\n");
	tell_object(me,HIM"你增加了550点经验。\n"NOR);
	tell_object(me,HIM"你增加了500点潜能。\n\n"NOR);
	me->set("marks/wuyi11", 1);
	me->delete("marks/wuyi10", 1);
       me->set("combat_exp", (int) exp + 550);
       me->set("potential", (int) pot + 500);
	return 1;}
	} else
		say("神光说道：阿弥陀佛，多谢施主。\n\n");
	return 1;
}

int ask_me()
{
	object me;
       me = this_player();
       if( !me->query("marks/wuyi10") ) {
	tell_object(me,"神光说道：阿弥陀佛！\n");
	return 1;
	}
       else {
	tell_object(me,"神光说道：阿弥陀佛，既然是寒渊让你来的，我就收下你了？\n\n");
       return 1;
	}
}

int ask_me1()
{
	object me;
       me = this_player();
       if( this_player()->query_skill("begging",1)<110) {
	tell_object(me,"神光说道：阿弥陀佛，继续修炼乞讨术吧！\n");
	return 1;
	}
       else {
	tell_object(me,"神光说道：阿弥陀佛，我怎么才能悟到师祖说的最高境界呢？\n\n");
       return 1;
	}
}

int ask_wu()
{
	object me,ob,xiao;
	int sk;
	me = this_player();
	ob = this_object();
	sk = (int)me->query_skill("literate", 1);
	if ( (sk > 50) && (ob->query("paper_count") < 0) ){
	command("say 我的手书已经送人了。\n");
	return 1;
	}
	else if ( (sk > 50) && (me->query("marks/wuyi10")) ) {
	command("say 我就把我一生所悟到的传与你吧。\n");
	ob->add("paper_count", -1);
	xiao = new(__DIR__"obj/white_paper");
	xiao->move(me);
	message_vision("$N给$n一张白色纸片。\n",ob,me);
	return 1;
	}
	else {
	command("shake");
	command("say 这是我一生所悟，怎能随便送人！\n");
	return 1;
	}
}
