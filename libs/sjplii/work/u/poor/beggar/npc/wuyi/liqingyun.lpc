// second npc by poor

#include <ansi.h>
inherit NPC;
int ask_me();
int ask_me1();

void create() {
  set_name("李清云", ({ "li qingyun", "master", "li" }));
  set("title", "丐帮孝舵弟子");
  set("gender", "女性");
  set("age", 25);
  set("long",
    "她是丐帮孝舵的一个普通乞丐。\n");
  set("inquiry", ([
    "拜师": "想拜我为师？我怎么干当呢？",
    "老帮主": "哎，老帮主已经失踪多年。",
    "污衣帮": "随便说是要死人的。",
    "加入污衣帮": "你没开玩笑吧。",
    "穿污衣，行侠义": (: ask_me :),
    "升级": (: ask_me1 :),
  ]));
  set("str", 36);
  set("max_kee", 1000);
  set("kee", 1000);
  set("force", 500);
  set("max_force", 500);
  set("force_factor", 50);
  set("combat_exp", 10000);

  set_skill("unarmed", 60);
  set_skill("force", 60);
  set_skill("parry", 60);
  set_skill("dodge", 60);
  set_skill("begging", 60);
  set_skill("golden_blade", 60);
  set_skill("blade", 60);

  set_skill("hidden_dodge", 60);
  set_skill("canyun_force", 60);
  set_skill("literate", 50);
  set_skill("iron_strike", 60);

  map_skill("dodge", "hidden_dodge");
  map_skill("unarmed", "iron_strike");
  map_skill("force", "canyun_force");
  map_skill("parry", "golden_blade");
  map_skill("blade", "golden_blade");

  create_family("丐帮污衣帮", 8, "弟子");

  setup();

  carry_object("/u/poor/obj/weapon/blade")->wield();
  carry_object("/u/poor/obj/cloth/wuyi")->wear();
}

void attempt_apprentice(object ob) {
  if (!ob->query("marks/wuyi1")) {
    command("say 这位" + RANK_D->query_respect(ob) + "，我怎么能当人师父呢？\n");
  } else {
    command("say 很好，" + RANK_D->query_respect(ob) +
      "多加努力，他日必定有成。\n");
    command("recruit " + ob->query("id"));
    ob->set("class", "gaibang");
    ob->set("title", "丐帮污衣帮四袋弟子");
  }
}

void recruit_apprentice(object ob) {
  if (::recruit_apprentice(ob))
    ob->set("class", "gaibang");
}
int accept_object(object me, object ob) {
  int exp, pot;
  me = this_player();
  exp = (int)me->query("combat_exp");
  pot = (int)me->query("potential");

  if (me->query("marks/wuyi1")) {
    if ((string)ob->query("id") != "hefu") {
      command("say 这不是我想要的。\n");
      return 0;
    } else {
      tell_object(me, "李清云接过和服。\n\n"
        "李清云说道：你去找九华山中的猎人，告诉他暗号，他就会收你为徒弟的。\n\n");
      tell_object(me, HIM "你增加了100点经验。\n" NOR);
      tell_object(me, HIM "你增加了50点潜能。\n\n" NOR);
      me->set("marks/wuyi2", 1);
      me->delete("marks/wuyi1", 1);
      me->set("combat_exp", (int)exp + 100);
      me->set("potential", (int)pot + 50);
      return 1;
    }
  } else
    say("李清云接过和服。\n\n");
  return 1;
}

int ask_me() {
  object me;
  me = this_player();
  if (!me->query("marks/wuyi1")) {
    tell_object(me, "李清云说道：你在胡说什么？！\n");
    return 1;
  } else {
    tell_object(me, "李清云说道：是常凡让你来的，还不快拜师？\n\n");
    return 1;
  }
}

int ask_me1() {
  object me;
  me = this_player();
  if (this_player()->query_skill("begging", 1) < 10) {
    tell_object(me, "李清云说道：你现在不够升级的资格，继续修炼乞讨术吧！\n");
    return 1;
  } else {
    tell_object(me, "李清云说道：去把和服给我找来。\n\n");
    return 1;
  }
}
