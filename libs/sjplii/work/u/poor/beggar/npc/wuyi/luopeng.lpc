// ninth npc by poor

#include <ansi.h>
inherit NPC;
int ask_me();
int ask_me1();

void create()
{
        set_name("罗鹏", ({ "luo peng", "master", "luo" }) );
        set("gender", "男性");
        set("title", "烧火工");
        set("age", 46);
        set("long",
 "他是丐帮大礼分舵的烧火工。\n");
        set("inquiry", ([
                "拜师": "想拜我为师？我怎么干当呢？",
                "老帮主": "哎，老帮主已经失踪多年。",
                "污衣帮": "随便说是要死人的。",
                "加入污衣帮": "你没开玩笑吧。",
                "穿污衣，行侠义": (: ask_me :),
                "升级": (: ask_me1 :),
        ]) ); 
        set("str", 36);
        set("max_kee", 2400);
        set("kee", 2400);
        set("force", 2000);
        set("max_force", 2000);
        set("force_factor",60);
        set("combat_exp",250000);

        set_skill("unarmed", 180);
        set_skill("force", 180);
        set_skill("parry", 180);
        set_skill("dodge", 180);
        set_skill("stick", 180);
        set_skill("begging", 180);
        set_skill("xianglong_strike", 180);

        set_skill("qingyun_stick", 150);
        set_skill("hidden_dodge", 150);
        set_skill("canyun_force", 150);
        set_skill("literate", 140);
        set_skill("hitdog_stick", 100);

        map_skill("dodge", "hidden_dodge");
        map_skill("unarmed", "xianglong_strike");
        map_skill("force", "canyun_force");
        map_skill("stick", "qingyun_stick");
        map_skill("parry", "qingyun_stick");

        create_family("丐帮污衣帮", 4, "弟子");

        setup();

        carry_object("/u/poor/obj/cloth/wuyi")->wear();
        carry_object("/u/poor/obj/weapon/stick")->wield();
}

void attempt_apprentice(object ob)
{
	if (!ob->query("marks/wuyi8") ) {
	command("say 这位" + RANK_D->query_respect(ob) + "，我怎么能当人师父呢？\n");
	}
	else {
        command("say 很好，" + RANK_D->query_respect(ob) +
"多加努力，他日必定有成。\n");
        command("recruit " + ob->query("id") );
       ob->set("class", "gaibang");
       ob->set("title","丐帮污衣帮仁舵副舵主");
	}
}

void recruit_apprentice(object ob)
{
        if( ::recruit_apprentice(ob) )
                ob->set("class", "gaibang");
}

int accept_object(object me, object ob)
{
        int exp,pot;
         me=this_player();
        exp = (int) me->query("combat_exp");
        pot = (int) me->query("potential");

	if( me->query("marks/wuyi8") ) {
       if( (string)ob->query("id") !="nx-dagger") {
       command("say 这不是我想要的。\n");
       return 0;
	} 
	else {
	tell_object(me,"罗鹏接过凝血匕首。\n\n"
"罗鹏说道：你去找丐帮大仁分舵的舵主，告诉他暗号，他就会收你为徒弟的。\n\n");
	tell_object(me,HIM"你增加了450点经验。\n"NOR);
	tell_object(me,HIM"你增加了400点潜能。\n\n"NOR);
	me->set("marks/wuyi9", 1);
	me->delete("marks/wuyi8", 1);
       me->set("combat_exp", (int) exp + 450);
       me->set("potential", (int) pot + 400);
	return 1;}
	} else
		say("罗鹏接过凝血匕首。\n\n");
	return 1;
}

int ask_me()
{
	object me;
       me = this_player();
       if( !me->query("marks/wuyi8") ) {
	tell_object(me,"罗鹏理都不理你。\n");
	return 1;
	}
       else {
	tell_object(me,"罗鹏说道：是鲁智让你来的，还不快帮我干活？\n\n");
       return 1;
	}
}

int ask_me1()
{
	object me;
       me = this_player();
       if( this_player()->query_skill("begging",1)<90) {
	tell_object(me,"罗鹏说道：你现在不够升级的资格，继续修炼乞讨术吧！\n");
	return 1;
	}
       else {
	tell_object(me,"罗鹏说道：去把凝血匕首给我找来。\n\n");
       return 1;
	}
}
