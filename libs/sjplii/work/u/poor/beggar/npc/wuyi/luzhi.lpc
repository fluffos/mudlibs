// eighth npc by poor

#include <ansi.h>
inherit NPC;
int ask_me();
int ask_me1();

void create() {
  set_name("鲁智", ({ "lu zhi", "master", "lu" }));
  set("gender", "男性");
  set("title", "丐帮大智分舵弟子");
  set("age", 36);
  set("long",
    "他是丐帮大智分舵弟子。\n");
  set("inquiry", ([
    "拜师": "想拜我为师？我怎么干当呢？",
    "老帮主": "哎，老帮主已经失踪多年。",
    "污衣帮": "随便说是要死人的。",
    "加入污衣帮": "你没开玩笑吧。",
    "穿污衣，行侠义": (: ask_me :),
    "升级": (: ask_me1 :),
  ]));
  set("str", 36);
  set("max_kee", 2200);
  set("kee", 2200);
  set("force", 1800);
  set("max_force", 1800);
  set("force_factor", 60);
  set("combat_exp", 220000);

  set_skill("unarmed", 150);
  set_skill("force", 150);
  set_skill("parry", 150);
  set_skill("dodge", 150);
  set_skill("blade", 150);
  set_skill("begging", 150);
  set_skill("xianglong_strike", 140);

  set_skill("golden_blade", 150);
  set_skill("hidden_dodge", 150);
  set_skill("canyun_force", 150);
  set_skill("literate", 140);
  set_skill("iron_strike", 150);

  map_skill("dodge", "hidden_dodge");
  map_skill("unarmed", "xianglong_strike");
  map_skill("force", "canyun_force");
  map_skill("blade", "golden_blade");
  map_skill("parry", "golden_blade");

  create_family("丐帮污衣帮", 5, "弟子");

  setup();

  carry_object("/u/poor/obj/cloth/wuyi")->wear();
}

void attempt_apprentice(object ob) {
  if (!ob->query("marks/wuyi7")) {
    command("say 这位" + RANK_D->query_respect(ob) + "，我怎么能当人师父呢？\n");
  } else {
    command("say 很好，" + RANK_D->query_respect(ob) +
      "多加努力，他日必定有成。\n");
    command("recruit " + ob->query("id"));
    ob->set("class", "gaibang");
    ob->set("title", "丐帮污衣帮孝舵副舵主");
  }
}

void recruit_apprentice(object ob) {
  if (::recruit_apprentice(ob))
    ob->set("class", "gaibang");
}
int accept_object(object me, object ob) {
  int exp, pot;
  me = this_player();
  exp = (int)me->query("combat_exp");
  pot = (int)me->query("potential");

  if (me->query("marks/wuyi7")) {
    if ((string)ob->query("id") != "lg-zhihuan") {
      command("say 鲁智接过灵古指环。\n");
      return 0;
    } else {
      tell_object(me, "鲁智接过灵古指环。\n\n"
        "鲁智说道：你去找丐帮大礼分舵的罗鹏，告诉他暗号，他就会收你为徒弟的。\n\n");
      tell_object(me, HIM "你增加了400点经验。\n" NOR);
      tell_object(me, HIM "你增加了350点潜能。\n\n" NOR);
      me->set("marks/wuyi8", 1);
      me->delete("marks/wuyi7", 1);
      me->set("combat_exp", (int)exp + 400);
      me->set("potential", (int)pot + 350);
      return 1;
    }
  } else
    say("鲁智接过灵古指环。\n\n");
  return 1;
}

int ask_me() {
  object me;
  me = this_player();
  if (!me->query("marks/wuyi7")) {
    tell_object(me, "鲁智说道：你在胡说什么？！\n");
    return 1;
  } else {
    tell_object(me, "鲁智说道：是穷老头让你来的，还不快拜师？\n\n");
    return 1;
  }
}

int ask_me1() {
  object me;
  me = this_player();
  if (this_player()->query_skill("begging", 1) < 80) {
    tell_object(me, "鲁智说道：你现在不够升级的资格，继续修炼乞讨术吧！\n");
    return 1;
  } else {
    tell_object(me, "鲁智说道：去把灵古指环给我找来。\n\n");
    return 1;
  }
}
