// twelvth npc by poor

#include <ansi.h>
inherit NPC;
int ask_me();
int ask_me1();
int key_count = 2;
int ask_key();

void create() {
  set_name("肖空鸣", ({ "xiao mingkong", "master", "xiao" }));
  set("gender", "男性");
  set("title", "丐帮执法长老");
  set("nickname", WHT "铁面艺人" NOR);
  set("age", 65);
  set("long",
    "他就是丐帮的执法长老，石海风的师弟，对于犯帮规的丐帮弟子都是严惩不待。\n");
  set("inquiry", ([
    "拜师": "想拜我为师？我怎么干当呢？",
    "污衣帮": "随便说是要死人的。",
    "加入污衣帮": "你没开玩笑吧。",
    "穿污衣，行侠义": (: ask_me :),
    "升级": (: ask_me1 :),
    "key": (: ask_key :),
    "钥匙": (: ask_key :),
    "老帮主": "哎，老帮主已经失踪多年。",
  ]));
  set("chat_chance", 1);
  set("chat_msg", ({
    "肖鸣空自言自语道：老帮主留下的这把钥匙有什么用呢？\n",
  }));
  set("str", 36);
  set("max_kee", 5000);
  set("kee", 5000);
  set("force", 4000);
  set("max_force", 4000);
  set("force_factor", 150);
  set("combat_exp", 800000);

  set_skill("unarmed", 220);
  set_skill("force", 220);
  set_skill("parry", 220);
  set_skill("dodge", 220);
  set_skill("begging", 220);
  set_skill("xianglong_strike", 200);
  set_skill("hitdog_stick", 220);
  set_skill("stick", 220);
  set_skill("qingyun_stick", 220);
  set_skill("iron_strike", 220);

  set_skill("hitdog_zhen", 50);
  set_skill("hidden_dodge", 200);
  set_skill("canyun_force", 200);
  set_skill("literate", 200);

  map_skill("dodge", "hidden_dodge");
  map_skill("unarmed", "xianglong_strike");
  map_skill("force", "canyun_force");
  map_skill("stick", "hitdog_stick");
  map_skill("parry", "hitdog_stick");

  create_family("丐帮污衣帮", 2, "弟子");

  setup();

  carry_object("/u/poor/obj/cloth/wuyi")->wear();
  carry_object("/u/poor/obj/weapon/stick")->wield();
}

void attempt_apprentice(object ob) {
  if (!ob->query("marks/wuyi11")) {
    command("say 这位" + RANK_D->query_respect(ob) + "，我怎么能当人师父呢？\n");
  } else {
    command("say 很好，" + RANK_D->query_respect(ob) +
      "多加努力，他日必定有成。\n");
    command("recruit " + ob->query("id"));
    ob->set("class", "gaibang");
    ob->set("title", "丐帮掌钵龙头");
  }
}

void recruit_apprentice(object ob) {
  if (::recruit_apprentice(ob))
    ob->set("class", "gaibang");
}

int accept_object(object me, object ob) {
  int exp, pot;
  me = this_player();
  exp = (int)me->query("combat_exp");
  pot = (int)me->query("potential");

  if (me->query("marks/wuyi11")) {
    if ((string)ob->query("id") != "dragon-book") {
      command("say 这不是我想要的。\n");
      return 0;
    } else {
      tell_object(me, "肖鸣空接过了降龙十八掌掌谱。\n\n"
        "肖空鸣说道：好小子，干得不错，我就把这本《斗神传》传给你吧。\n\n");
      tell_object(me, HIM "你增加了600点经验。\n" NOR);
      tell_object(me, HIM "你增加了550点潜能。\n\n" NOR);
      ob = new("/u/poor/obj/book/wargod-book");
      ob->move(me);
      me->set("marks/wuyi12", 1);
      me->delete("marks/wuyi11", 1);
      me->set("combat_exp", (int)exp + 600);
      me->set("potential", (int)pot + 550);
      return 1;
    }
  } else
    say("肖鸣空接过了降龙十八掌掌谱。\n\n");
  return 1;
}

int ask_me() {
  object me;
  me = this_player();
  if (!me->query("marks/wuyi11")) {
    tell_object(me, "肖空鸣说道：再胡说就打死你！\n");
    return 1;
  } else {
    tell_object(me, "肖空鸣说道：既然是神光长老让你来的，我就收下你了。\n\n");
    return 1;
  }
}

int ask_me1() {
  object me;
  me = this_player();
  if (this_player()->query_skill("begging", 1) < 120) {
    tell_object(me, "肖空鸣说道：你继续修炼乞讨术吧！\n");
    return 1;
  } else {
    tell_object(me, "肖空鸣说道：你可否把丐帮的《降龙十八掌掌谱》找回来？\n\n");
    return 1;
  }
}

int ask_key() {
  object me, ob, xiao;
  int sk;
  me = this_player();
  ob = this_object();
  sk = (int)me->query_skill("hitdog_stick", 1);
  if ((sk > 50) && (ob->query("key_count") < 0)) {
    command("say  钥匙已经送人了。\n");
    return 1;
  } else if ((sk > 50) && (me->query("marks/killwu"))) {
    command("say 我就把老帮主留下的钥匙给你。\n");
    ob->add("key_count", -1);
    xiao = new(__DIR__ "obj/iron-key");
    xiao->move(me);
    message_vision("$N给$n一把铁钥匙。\n", ob, me);
    return 1;
  } else {
    command("shake");
    command("say 老帮主留下的东西，怎能随便送人！\n");
    return 1;
  }
}
