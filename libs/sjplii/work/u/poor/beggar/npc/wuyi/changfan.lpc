// first npc by poor

#include <ansi.h>
inherit NPC;
int ask_me();

void create()
{
        set_name("常凡", ({ "chang fan", "master", "chang" }) );
        set("title", "老乞丐");
        set("gender", "男性");
        set("age", 65);
        set("long",
 "他是一个衣衫褴褛的老乞丐。\n");
        set("inquiry", ([
                "拜师": "想拜我为师？我怎么干当呢？",
                "老帮主": "哎，老帮主已经失踪多年。",
                "污衣帮": "污衣帮？难道你想加入？？！！",
                "加入污衣帮": "你没开玩笑吧，那就先去个我拿个红烧狗肉来。",
        ]) ); 
        set("str", 36);
        set("max_kee", 1000);
        set("kee", 1000);
        set("force", 500);
        set("max_force", 500);
        set("force_factor",50);
        set("combat_exp",8000);

        set("chat_chance_combat", 10);
        set("chat_chance", 10);
        set("chat_msg", ({
        "常凡说道：谁说污衣帮不好？我就穿污衣。\n",
        "常凡说道：什么时候污衣帮才能重振江湖呀。”\n",
        }) );

        set_skill("unarmed", 50);
        set_skill("force", 50);
        set_skill("parry", 50);
        set_skill("dodge", 50);
        set_skill("begging", 50);

        set_skill("hidden_dodge", 50);
        set_skill("canyun_force", 50);
        set_skill("literate", 20);
        set_skill("iron_strike", 50);

        map_skill("dodge", "hidden_dodge");
        map_skill("unarmed", "iron_strike");
        map_skill("force", "canyun_force");

        create_family("丐帮污衣帮", 8, "弟子");

        setup();

        carry_object("/u/poor/obj/cloth/wuyi")->wear();
}

void attempt_apprentice(object ob)
{
	if (!ob->query("marks/wuyi1") ) {
	command("say 这位" + RANK_D->query_respect(ob) + "，我怎么能当人师父呢？\n");
	}
	else {
        command("say 很好，" + RANK_D->query_respect(ob) +
"多加努力，他日必定有成。\n");
        command("recruit " + ob->query("id") );
       ob->set("class", "gaibang");
       ob->set("title","丐帮污衣帮三袋弟子");
	}
}

void recruit_apprentice(object ob)
{
        if( ::recruit_apprentice(ob) )
                ob->set("class", "gaibang");
}

int accept_object(object me, object ob)
{
         object clasp;
         me=this_player();
         if( (string)ob->query("name") !="红烧狗肉") 
         {
         command("say 这不是我想要的肉。\n");
         }
         else{
	tell_object(me,"常凡刚接过红烧狗肉，就大口大口的吃了起来。\n\n"
"常凡对你说道：既然你这么有诚意，就让加入我们污衣帮吧。\n"
"	我们的暗号是[穿污衣，行侠义]。你去找孝舵的李清云，告诉她暗号，她就会收你为徒弟的。\n\n");
	me->set("marks/wuyi1", 1);
	}
       return 1;
}
