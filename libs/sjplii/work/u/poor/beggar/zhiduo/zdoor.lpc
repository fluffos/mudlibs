// Room: /beggar/door.c
#include <ansi.h>;

inherit ROOM;

void create() {
  set("short", HIB "大门" NOR);
  set("long", @LONG
你来到了黑松林的深处，四周的是参天大树。在北面的茂密
树林中隐隐能看见几个小屋，和一些人影。里边就是丐帮的大智分舵，
LONG
  );

  set("exits", ([ /* sizeof() == 3 */
    "north": __DIR__ "zkongdi1",
    "southeast": __DIR__ "songlin6",
  ]));
  set("objects", ([ /* sizeof() == 1 */
    __DIR__ "npc/fuqi": 1,
  ]));
  set("outdoors", "gaibang");
  set("no_clean_up", 0);

  setup();
  //	replace_program(ROOM);
}

int valid_leave(object who, string exit) {
  object ob;
  ob = present("fuqi", environment(who));

  if (ob) if (ob->query_temp("block_msg/all"))
    return ::valid_leave(who, exit);

  if ((exit == "north") && (who->query("class") != "gaibang") && (present(
    "fuqi",
    environment(who)
  )))
    return notify_fail("付崎说道：“前面是丐帮大智分舵，请您速速离去！”\n");
  return ::valid_leave(who, exit);
}
