#include <ansi.h>
inherit NPC;
void create() {
  set_name("孔松", ({ "kong" }));
  set("title", "丐帮打狗阵守阵弟子");
  set("gender", "男性");
  set("age", 26);
  set("long", "他是打狗阵的守阵弟子。\n");

  set("max_kee", 500);
  set("kee", 500);
  set("force", 100);
  set("max_force", 100);
  set("force_factor", 10);
  set("combat_exp", 30000);
  set("attitude", "aggressive");

  set_skill("unarmed", 30);
  set_skill("force", 30);
  set_skill("parry", 30);
  set_skill("dodge", 30);
  set_skill("blade", 30);

  set_skill("iron_strike", 30);
  set_skill("hidden_dodge", 30);
  set_skill("canyun_force", 30);
  set_skill("golden_blade", 30);
  set_skill("literate", 30);

  map_skill("dodge", "hidden_dodge");
  map_skill("unarmed", "iron_strike");
  map_skill("force", "canyun_force");
  map_skill("parry", "golden_blade");
  map_skill("blade", "golden_blade");

  create_family("丐帮", 7, "弟子");

  setup();
  carry_object("/u/poor/obj/weapon/blade")->wield();
  carry_object("/u/poor/obj/cloth/jingyi")->wear();
}
