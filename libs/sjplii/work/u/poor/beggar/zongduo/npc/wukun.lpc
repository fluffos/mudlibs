// wangqr.c

#include <ansi.h>
inherit NPC;

void create()
{
        set_name("吴昆", ({ "wu kun", "wukun", "master" }) );
        set("nickname", HIW "无影神丐" NOR);
        set("title", "丐帮八袋弟子");
        set("gender", "男性");
        set("age", 31);
        set("long",
 "他是丐帮中的佼佼者，已经在江湖上颇有名气，他小通几招降龙十八掌\n");
        set("inquiry", ([
                "拜师": "问那么多干吗，快拜师吧！",
                "老帮主": "老帮主已经失踪多年。",
        ]) ); 
        set("max_kee", 2500);
        set("kee", 2500);
        set("force", 4000);
        set("max_force", 4000);
        set("force_factor",50);
        set("combat_exp",400000);

        set_skill("unarmed", 180);
        set_skill("stick", 180);
        set_skill("force", 180);
        set_skill("parry", 180);
        set_skill("dodge", 180);
        set_skill("begging", 180);

        set_skill("iron_strike", 160);
        set_skill("hidden_dodge", 160);
        set_skill("xianglong_strike", 80);
        set_skill("canyun_force", 160);
        set_skill("qingyun_stick", 160);
        set_skill("literate", 200);

        map_skill("dodge", "hidden_dodge");
        map_skill("unarmed", "iron_strike");
        map_skill("force", "canyun_force");
        map_skill("stick", "qingyun_stick");
        map_skill("parry", "qingyun_stick");

        create_family("丐帮", 3, "弟子");

        setup();

        carry_object("/u/poor/obj/weapon/stick")->wield();
        carry_object("/u/poor/obj/cloth/jingyi")->wear();
}

void attempt_apprentice(object ob)
{
	int beg = (int)ob->query_skill("begging", 1);

	if( beg > 120) {
        command("smile");
        command("say 很好，" + RANK_D->query_respect(ob) + "多加努力，他日必定有成。\n");
	command("recruit " + ob->query("id") );
	command("say 丐帮乃江湖第一大帮，本派在江湖上必须行侠仗义，你可记清楚了。\n");
	ob->set("class","gaibang");
	ob->set("title","丐帮净衣帮七袋弟子");
	}
	else {
	command("say 这位" + RANK_D->query_respect(ob) + "还是去找郭世龙修习武功吧。\n");
	}
}
