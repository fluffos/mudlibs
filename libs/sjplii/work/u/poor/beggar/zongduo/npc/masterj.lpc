// wangqr.c

#include <ansi.h>
inherit NPC;
int ask_me();

void create() {
  set_name("石海风", ({ "shi haifeng", "master", "shi" }));
  set("nickname", HIY "酒仙神丐" NOR);
  set("title", "丐帮现任帮主");
  set("gender", "男性");
  set("age", 55);
  set("long",
    "他就是丐帮的现任帮主，施楠的嫡传弟子，其武功人品都超过了师父当年的风采。\n");
  set("inquiry", ([
    "拜师": "想拜我为师？必须先通过打狗阵的修行。",
    "老帮主": "哎，老帮主已经失踪多年。",
    "打狗棒": "打狗棒已经下落不明，不知道您可否知道？",
    "打狗阵": (: ask_me :),
  ]));
  set("str", 56);
  set("max_kee", 8000);
  set("kee", 8000);
  set("force", 9500);
  set("max_force", 9000);
  set("force_factor", 150);
  set("combat_exp", 8000000);

  set_skill("unarmed", 230);
  set_skill("force", 230);
  set_skill("parry", 230);
  set_skill("dodge", 230);
  set_skill("stick", 230);
  set_skill("whip", 230);
  set_skill("begging", 230);

  set_skill("iron_strike", 200);
  set_skill("xianglong_strike", 200);
  set_skill("hidden_dodge", 200);
  set_skill("canyun_force", 200);
  set_skill("fire_whip", 200);
  set_skill("literate", 150);
  set_skill("qingyun_stick", 200);
  set_skill("hitdog_stick", 200);

  map_skill("dodge", "hidden_dodge");
  map_skill("unarmed", "xianglong_strike");
  map_skill("force", "canyun_force");
  map_skill("stick", "hitdog_stick");
  map_skill("parry", "hitdog_stick");
  map_skill("whip", "fire_whip");

  create_family("丐帮", 2, "弟子");

  setup();

  carry_object("/u/poor/obj/weapon/green_stick")->wield();
  carry_object("/u/poor/obj/cloth/cloth")->wear();
}

int accept_object(object me, object ob) {
  object clasp;
  me = this_player();
  if ((string)ob->query("id") != "dog-stick") {
    command("say 这不是我们丐帮的打狗棒。\n");
  } else {
    tell_object(me, "石海风说道：多谢你找回打狗棒。\n\n"
      "石海风带着你走进了丐帮的地道中，打开了一道石门，来到了一间密室之中。\n"
      "石海风说道：既然你都知道了，就受死吧！\n");
    me->move("/u/poor/beggar/didao/ddwu3");
  }
  return 1;
}


void attempt_apprentice(object ob) {
  if (!ob->query("marks/baishi")) {
    command("say 这位" + RANK_D->query_respect(ob) + "还是先向传功长老讨教武功吧。\n");
  } else {
    command("say 很好，" + RANK_D->query_respect(ob) +
      "多加努力，他日必定有成。\n");
    command("recruit " + ob->query("id"));
    ob->delete("marks/baishi", 1);
    ob->set("class", "gaibang");
    ob->set("title", "丐帮掌棒龙头");
  }
}

void recruit_apprentice(object ob) {
  if (::recruit_apprentice(ob))
    ob->set("class", "gaibang");
}
int ask_me() {
  object me;
  me = this_player();
  if (this_player()->query_skill("begging", 1) < 120) {
    tell_object(me, "石海风说道：你还不够资格，继续修炼乞讨术吧！\n");
    return 1;
  } else {
    tell_object(me, "石海风说道：我带你进去吧。\n\n"
      "石海风带着你向打狗阵走去。穿过一片树林，来到了打狗阵的入口。\n"
      "石海风说：北边是打狗阵，你好自为之吧。\n");
    me->move("/u/poor/beggar/zongduo/dagou1");
    return 1;
  }
}
