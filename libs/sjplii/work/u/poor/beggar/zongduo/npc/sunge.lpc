#include <ansi.h>
inherit NPC;
void create()
{
        set_name("孙戈", ({ "sun ge" }) );
        set("title", "丐帮七袋弟子");
        set("gender", "男性" );
        set("age", 45);
        set("long",     "他是掌管食堂的弟子，带人很温和。\n");

        set("max_kee", 500);
        set("kee", 500);
        set("force", 300);
        set("max_force", 300);
        set("force_factor",10);
        set("combat_exp",6000);

        set_skill("unarmed", 40);
        set_skill("force", 40);
        set_skill("parry", 40);
        set_skill("dodge", 40);
        set_skill("stick", 40);

        set_skill("iron_strike", 40);
        set_skill("hidden_dodge", 40);
        set_skill("canyun_force", 40);
        set_skill("literate", 40);

        map_skill("dodge", "hidden_dodge");
        map_skill("unarmed", "iron_strike");
        map_skill("force", "canyun_force");
 
        create_family("丐帮", 5, "弟子");

        setup();
        carry_object("/u/poor/obj/cloth/jingyi")->wear();
}
