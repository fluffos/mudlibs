// guoshilong.c

#include <ansi.h>
inherit NPC;

void create() {
  set_name("郭世龙", ({ "guo shilong", "master", "guo" }));
  //        set("nickname", HIM "" NOR);
  set("title", "丐帮七袋弟子");
  set("gender", "男性");
  set("age", 25);
  set("long",
    "郭世龙是丐帮中的新秀，武功也是不弱。\n");
  set("inquiry", ([
    "拜师": "问那么多干吗，快拜师吧！",
    "进门": "只有本帮弟子才能进入总舵。",
  ]));
  set("max_kee", 2000);
  set("kee", 2000);
  set("force", 1000);
  set("max_force", 2000);
  set("force_factor", 80);
  set("combat_exp", 3000000);

  set_skill("unarmed", 150);
  set_skill("force", 150);
  set_skill("parry", 150);
  set_skill("dodge", 150);
  set_skill("sword", 150);
  set_skill("begging", 150);

  set_skill("iron_strike", 140);
  set_skill("hidden_dodge", 140);
  set_skill("canyun_force", 140);
  set_skill("crazy_sword", 140);
  set_skill("literate", 100);
  set_skill("blade", 150);
  set_skill("golden_blade", 140);

  map_skill("dodge", "hidden_dodge");
  map_skill("unarmed", "iron_strike");
  map_skill("force", "canyun_force");
  map_skill("sword", "crazy_sword");
  map_skill("parry", "crazy_sword");

  create_family("丐帮", 4, "弟子");

  setup();

  carry_object("/u/poor/obj/weapon/poor-sword")->wield();
  carry_object("/u/poor/obj/cloth/jingyi")->wear();
}

void attempt_apprentice(object ob) {
  int beg = (int)ob->query_skill("begging", 1);

  if (beg > 100) {
    command("smile");
    command("say 很好，" + RANK_D->query_respect(ob) + "多加努力，他日必定有成。\n");
    command("recruit " + ob->query("id"));
    command("say 丐帮乃江湖第一大帮，本派在江湖上必须行侠仗义，你可记清楚了。\n");
    ob->set("class", "gaibang");
    ob->set("title", "丐帮净衣帮六袋弟子");
  } else {
    command("say 这位" + RANK_D->query_respect(ob) + "还是去分舵修习武功吧。\n");
  }
}
