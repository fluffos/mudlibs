// Room: /beggar/door.c
#include <ansi.h>;

inherit ROOM;

void create()
{
	set("short", HIB" 打狗阵中"NOR);
	set("long", @LONG
你已经走进天下文明的丐帮打狗阵了，这里机关重重，并有
许多丐帮高手在这里埋伏，只要的一招不慎，就会死无葬身之地。
LONG
	);

	set("exits", ([ /* sizeof() == 3 */
    "out" : __DIR__"zdzoul1",
    "south" : __DIR__"dagou4",
]));
       set("objects", ([ /* sizeof() == 1 */
  __DIR__"npc/dagou41" : 1,
  __DIR__"npc/dagou42" : 1,
  __DIR__"npc/dagou43" : 1,
  __DIR__"npc/dagou44" : 1,
  __DIR__"npc/dagou45" : 1,
]));
	set("outdoors","gaibang");
        set("no_clean_up", 0);

	setup();
}

int valid_leave(object who,string exit)
{
  object ob;
  ob = present("wang",environment(who));

  if( ob ) if( ob->query_temp("block_msg/all"))
      return ::valid_leave(who,exit);
  
  if( (exit == "out") && (who->query("class")=="gaibang") && (present("wang",environment(who))))
      return notify_fail("王铁狂说道：“死也不让你过去！”\n");
  return ::valid_leave(who,exit);
}
