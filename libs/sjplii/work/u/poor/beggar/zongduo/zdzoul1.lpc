// Room: /gaibang/gbwuch1.c

inherit ROOM;
#include <ansi.h>;

create()
{
     	set("short", HIB"走廊" NOR);
	set("long", @LONG
这里是一条长长的走廊，从这里能看到丐帮唾弃厅，西边是少
数弟子用餐的地方，北边就是文明于天下的丐帮打狗阵了。
LONG
	);
	set("item_desc", ([ /* sizeof() == 1 */
  "唾弃厅" : "北边就是丐帮的唾弃厅，你可以进(enter)去。
",
  "打狗阵" : "必须经过帮主同意才可以进去。
",
]));
	set("objects", ([ /* sizeof() == 2 */
  __DIR__"npc/beggar" : 1,
]));
	set("exits", ([ /* sizeof() == 3 */
  "east" : __DIR__"zdwuch1",
  "west" : __DIR__"zdkitchen",
]));
	set("outdoors","gaibang");
        set("no_clean_up", 0);

	setup();
}
void init()
{
	add_action("do_enter", "enter");
}

int do_enter(string arg)
{
	object me = this_player();

	if( (!arg ) || (!(arg=="tuoqiting" || arg == "唾弃厅" )) )
		return 0;
	if (me->query("marks/killwu"))
	{
		message_vision("$N走进了唾弃厅。\n",me);
		me->move(__DIR__"zdtqt2");
		return 1;
	}
	else {
		message_vision("$N走进了唾弃厅。\n",me);
		me->move(__DIR__"zdtqt1");
		return 1;
	}
}
