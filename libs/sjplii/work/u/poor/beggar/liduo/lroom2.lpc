// chanfang

inherit ROOM;
#include <ansi.h>;

void create() {
  set("short", HIB "禅房" NOR);
  set("long", @LONG
这是一间极为简陋的禅房。室内空荡荡地别无他物。
LONG
  );

  set("exits", ([
    "east": __DIR__ "lqianyuan",
  ]));
  set("objects", ([
    "/u/poor/obj/weapon/stick": 2,
    "/u/poor/obj/book/mupian": 1,
  ]));

  set("sleep_room", 1);
  set("no_clean_up", 0);

  setup();
}
