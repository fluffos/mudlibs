// Room: /u/poor/gaibang/gbwuch2

inherit ROOM;
#include <ansi.h>;

void create() {
  set("short", HIB "食堂" NOR);
  set("long", @LONG
你走进了礼舵的食堂，在屋子的左边有一个灶，旁边有一口大
水缸。这里说是食堂，其实就有一个大水缸供丐帮弟子喝水，至于
其他的东西就要自己去乞讨了。
LONG
  );
  set("item_desc", ([
    "灶": "这个灶长年都不点火做饭。\n",
  ]));

  set("exits", ([ /* sizeof() == 1 */
    "west": __DIR__ "lhouyuan",
  ]));
  set("objects", ([ /* sizeof() == 1 */
    __DIR__ "obj/shuigang": 1,
    __DIR__ "npc/luopeng": 1,
  ]));
  set("no_clean_up", 0);

  setup();
}

void init() {
  add_action("do_enter", "enter");
}

int do_enter(string arg) {
  if (arg == "灶" || arg == "cooker") {
    if (this_player()->query_skill("force", 1) <= 40) {
      write("你身子过大，钻不进去。\n");
      return 1;
    }
    message_vision("$N运起丐帮身功[缩骨法]，身子突然瘦小了许多，钻进了灶中。\n", this_player());
    this_player()->move("/u/poor/beggar/didao/ddli");
    message("vision", this_player()->name() + "钻进了灶中。\n",
      environment(this_player()), this_player());
    return 1;
  } else return 0;
}
