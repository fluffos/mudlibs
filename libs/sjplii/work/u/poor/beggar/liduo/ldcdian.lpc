//dcdian  大成殿

inherit ROOM;
#include <ansi.h>;

void create()
{
        set("short", HIB"大成殿"NOR);
        set("long", @LONG
这里是破寺庙的前殿大成殿。殿内青砖铺地，两侧分列哼、哈二
将，当中供着肥肥胖胖的弥陀佛，对着你笑嘻嘻的。两边各放几个蒲
团，以供僧俗叩拜。当中放着一张长桌，上面点着几枝红烛，早已经
没有了供品。
LONG
        );
        set("exits", ([/* sizeof() == 1 */
            "north" : __DIR__"lhouyuan",
            "south" : __DIR__"lqianyuan",
]));
	set("objects",([
	__DIR__"npc/jingwuming" : 1,
]));

        set("no_clean_up", 0);

        setup();

}
int valid_leave(object who,string exit)
{
  object ob;
  ob = present("jing wuming",environment(who));

  if( ob ) if( ob->query_temp("block_msg/all"))
      return ::valid_leave(who,exit);
  
  if( (exit == "north") && (who->query("class")!="gaibang") && (present("jing wuming",environment(who))))
      return notify_fail("乞丐说道：“前面是丐帮大礼分舵，请您速速离去！”\n");
  return ::valid_leave(who,exit);
}
