// Room: /u/poor/gaibang/gbwuch2

inherit ROOM;
#include <ansi.h>;

void create()
{
	set("short", HIB"后院"NOR );
	set("long", @LONG
这里是一个寺庙的前院，现在早已经破烂不堪。有许多乞丐聚
集在这里。南边是寺庙的大成殿，北边是方丈室。西边是寺庙的院
墙。东面是厨房。
LONG
	);
	set("exits", ([ /* sizeof() == 1 */
  "north" : __DIR__"lfzh",
  "south" : __DIR__"ldcdian",
  "east" : __DIR__"lkitchen",
]));
	set("objects", ([ /* sizeof() == 1 */
  __DIR__"npc/oldbeggar" : 1,
]));
       set("sleep_room",1);	
	set("outdoors","gaibang");
        set("no_clean_up", 0);

	setup();
}

void init()
{
	add_action("do_climb", "climb");
}

int do_climb(string arg)
{
	if( arg=="院墙" || arg=="wall") {
	    if(this_player()->query_skill("dodge", 1)<=40) {
		     write("你刚上院墙，一不小心摔了下来。\n");
                  this_player()->unconcious();
			 return 1;
		}
		message_vision("$N双脚用力，一下就跳过了院墙。\n", this_player());
		this_player()->move(__DIR__"lroad1");
		message("vision", this_player()->name() + "爬过了院墙。\n",
			environment(this_player()), this_player());
		return 1;
	}
	else return 0;
}
