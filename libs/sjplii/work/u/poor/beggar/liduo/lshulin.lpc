inherit ROOM;

void create()
{
        set("short", "树林");
        set("long", @LONG
你走进了一片树林中，这里树木密集，很难分清方向。
LONG
        );
        set("exits", ([/* sizeof() == 4 */
           "north" : __DIR__"lshulin",
           "east" : __DIR__"lshulin",
           "west" : __DIR__"lshulin",
           "south" : __DIR__"lroad1",
]));
        set("no_clean_up", 0);
	set("outdoors","gaibang");

        setup();
}
void init()
{
        add_action("do_go","go");
}

int do_go()
{
if(random(5)){
this_player()->move(this_object());
return 1;
}
}

