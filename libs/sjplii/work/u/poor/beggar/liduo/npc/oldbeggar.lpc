inherit NPC;

void create() {
  set_name("老乞丐", ({ "beggar" }));
  set("gender", "男性");
  set("age", 58);
  set("title", "丐帮礼舵弟子");
  set("cor", 30);
  set("cps", 20);
  set("con", 50);
  set("per", 27);
  set("int", 10);
  set("max_kee", 20000);
  set("kee", 20000);
  set("food", 500);
  set("water", 500);
  set("attitude", "peaceful");
  setup();

  carry_object("/u/poor/obj/cloth/linen")->wear();

}


int accept_fight(object ob) {
  object weapon;
  string skill_type;
  int ob_attack, ob_dodge, ob_parry;
  if (ob->query("combat_exp") > 20000) {
    command("say " + RANK_D->query_self(this_object())
      + "武艺低微，怎么可能是" + RANK_D->query_respect(ob)
      + "的对手？\n");
    return 0;
  }

  if (objectp(weapon = ob->query_temp("weapon")))
    skill_type = weapon->query("skill_type");
  else
    skill_type = "unarmed";

  ob_attack = ob->query_skill(skill_type, 0) + ob->query_temp("apply/attack");
  ob_dodge = ob->query_skill("dodge", 0) + ob->query_temp("apply/defense");
  ob_parry = ob->query_skill("parry", 0) + ob->query_temp("apply/defense");

  set("eff_kee", query("max_kee"));
  set("kee", query("max_kee"));
  set("max_force", ob->query("max_force"));
  set("force", ob->query("force"));
  set("combat_exp", ob->query("combat_exp") + 50);
  if (query("combat_exp") > 100000) set("combat_exp", 100000);
  set_temp("apply/attack", ob_dodge + ob_dodge / 20 + 10);
  set_temp("apply/defense", ob_attack + ob_attack / 20 + 10);

  //	if( !ob->query("env/no_msg") ) {
  //	    write("系统暂时把你战斗信息关闭，打开战斗信息请用 msg 命令。\n");
  //	    ob->set("env/no_msg",1); }	
  return 1;
}
