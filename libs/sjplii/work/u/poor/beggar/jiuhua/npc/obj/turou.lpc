// rou

inherit ITEM;
inherit F_FOOD;

void create() {
  set_name("兔肉", ({ "turou" }));
  set_weight(80);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一块新鲜的兔肉。\n");
    set("unit", "块");
    set("value", 1500);
    set("food_remaining", 3);
    set("food_supply", 10);
  }
}
