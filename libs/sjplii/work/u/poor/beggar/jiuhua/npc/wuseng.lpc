// wuseng.c 武僧

inherit NPC;

void create() {

  set_name("武僧", ({ "wu seng", "seng" }));
  set("long",
    "这是甘露寺的武僧，身材高大魁梧。\n"
  );

  set("gender", "男性");
  set("attitude", "heroism");

  set("age", 30);
  set(
    "str",
    25
  ); /* = 膂力*/ set(
    "cor",
    25
  ); /* = 胆识*/ set(
    "int",
    25
  ); /* = 悟性*/ set(
    "spi",
    25
  ); /* = 灵性*/ set(
    "cps",
    30
  ); /* = 定力*/ set("per", 25); /* = 容貌*/ set("con", 60); /* = 根骨*/ set("kar", 30); /* = 福缘*/

  set("food", 600);
  set("water", 600);
  set("max_kee", 2000);
  set("eff_kee", 2000);
  set("kee", 2000);
  set("max_force", 2000);
  set("force", 3500);

  set("force_factor", 10);
  set_temp("apply/attack", 20);
  set_temp("apply/defense", 20);
  set("combat_exp", 500000);

  set_skill("force", 150);
  set_skill("unarmed", 100);
  set_skill("dodge", 150);
  set_skill("parry", 150);

  setup();

}
