// fisher

inherit NPC;
inherit F_VENDOR;

void create() {
  set_name("猎人", ({ "hunter", "seller" }));
  set("title", "山中");
  set_skill("unarmed", 80);
  set_skill("parry", 50);
  set_skill("dodge", 50);
  set("gender", "男性");

  set("force", 800);
  set("max_force", 500);
  set("per", 15);
  set("food", 200);
  set("water", 200);
  set("combat_exp", 70000);

  set("age", 49);
  set("long", @LONG
他是一个普通的猎人。
LONG
  );
  set("chat_chance_combat", 10);
  set("chat_chance", 10);
  set("chat_msg", ({
    "猎人说道：你想尝尝野味吗？\n"
  }));
  set("inquiry", ([
    "虎": "我听说鸡公山里有虎。",
    "兔肉": "您要尝尝吗。",
    "蛇": "我害怕蛇。",
    "狼": "山里有狼，小心点吧。",
    "咸猪肉": "我可没有这东西。",
  ]));

  set("vendor_goods", ([
    __DIR__ "obj/turou": 5,
    __DIR__ "obj/yejirou": 5,
    __DIR__ "obj/yeyarou": 5,
    __DIR__ "obj/zhzirou": 5,
  ]));

  setup();

  carry_object(__DIR__ "obj/cloth")->wear();
}

void init() {
  add_action("do_vendor_list", "list");
}
