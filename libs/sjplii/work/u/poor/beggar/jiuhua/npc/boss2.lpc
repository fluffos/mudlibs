#include <ansi.h>
inherit NPC;
void create()
{
        set_name("刑金龙", ({ "jinlong" }) );
        set("nickname", HIW "铁指鹰钩" NOR);
        set("title", "飞鹰寨秃鹰堂堂主");
        set("gender", "男性" );
        set("age", 35);
        set("attitude", "aggressive");
        set("long",     "他是这里的秃鹰堂堂主，曾经杀过无数名门正派弟子。\n");
        set("max_kee", 2000);
        set("kee", 2000);
        set("force", 2000);
        set("max_force", 1500);
        set("force_factor",10);
        set("combat_exp",80000);

        set_skill("unarmed", 80);
        set_skill("force", 100);
        set_skill("parry", 100);
        set_skill("dodge", 100);
        set_skill("iron_strike", 80);
        map_skill("unarmed", "iron_strike");

        setup();
        carry_object(__DIR__"obj/iron_finger")->wear();
        carry_object(__DIR__"obj/cloth")->wear();
}
void init()
{
        object ob;
        ::init();
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("checklooking");
                call_out("checklooking", 1, ob);
        }
}

void checklooking(object ob)
{
        command("say 你敢来这里，准备受死吧！");      
}

int accept_fight(object me)
{
        command("say 咦... 要打就真打吧，光是较量多没意思？");
        kill_ob(me);
        return 1;
}
