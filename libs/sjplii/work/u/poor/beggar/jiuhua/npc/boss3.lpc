#include <ansi.h>
inherit NPC;
void create()
{
        set_name("阎浮熊", ({ "fuxiong" }) );
        set("nickname", HIY "八臂神剑" NOR);
        set("title", "飞鹰寨鲲鹏堂堂主");
        set("gender", "男性" );
        set("age", 35);
        set("long",     "他是这里的鲲鹏堂堂主，是江湖上大有来头的人物。\n");
        set("max_kee", 3000);
        set("kee", 3000);
        set("force", 2000);
        set("max_force", 1800);
        set("force_factor",15);
        set("combat_exp",90000);

        set_skill("sword", 120);
        set_skill("force", 100);
        set_skill("parry", 100);
        set_skill("dodge", 100);
        set_skill("crazy_sword", 100);
        map_skill("sword", "crazy_sword");
        map_skill("parry", "crazy_sword");

        setup();
        carry_object(__DIR__"obj/sword")->wield();
        carry_object(__DIR__"obj/cloth")->wear();
}
void init()
{
        object ob;
        ::init();
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("checklooking");
                call_out("checklooking", 1, ob);
        }
}

void checklooking(object ob)
{
        command("say 你离开这里吧，饶你不死！");      
}

int accept_fight(object me)
{
        command("say 咦... 要打就真打吧，光是较量多没意思？");
        kill_ob(me);
        return 1;
}
