#include <ansi.h>
inherit NPC;
void create() {
  set_name("慧陵", ({ "hui ling" }));
  set("title", "甘露寺知客僧");
  set("gender", "男性");
  set("age", 29);
  set("str", 30);
  set("cor", 10);
  set("cps", 15);
  set("per", 10);
  set("int", 20);
  set("long", "他是负责迎接进香客的僧人。\n");

  set("max_kee", 800);
  set("kee", 800);
  set("force", 600);
  set("max_force", 600);
  set("force_factor", 30);
  set("combat_exp", 30000);

  set_skill("unarmed", 60);
  set_skill("force", 60);
  set_skill("parry", 60);
  set_skill("dodge", 60);

  set_skill("banruo-strike", 60);
  set_skill("literate", 60);

  map_skill("unarmed", "banruo-strike");

  create_family("甘露寺", 8, "弟子");

  setup();
  carry_object(__DIR__ "obj/sengpao")->wear();
}
void init() {
  object ob;
  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("checklooking");
    call_out("checklooking", 1, ob);
  }
}

void checklooking(object ob) {
  command("say 施主是来进香的吗？");
}

void attempt_apprentice(object ob) {
  command("shake");
  message_vision("$n双手合十，对$N说道: 我怎么做您的师傅呢？\n", ob, this_object());
  return;
}
