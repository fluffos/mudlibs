// bamboo_sword.c

#include <weapon.h>

inherit SWORD;

void create()
{
        set_name("长剑", ({ "longsword", "sword" }) );
        set_weight(1000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "把");
                set("value", 1);
                set("material", "iron");
                set("long", 
"这是一把普通的长剑。\n");
                set("wield_msg", "$N拿出一把$n，握在手中。\n");
                set("unequip_msg", "$N放下手中的$n。\n");
        }
        init_sword(20);
        setup();
}
 
