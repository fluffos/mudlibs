// magic book

inherit ITEM;

void create() {
  set_name("《法华经》", ({ "fahua-jing", "jing", }));
  set_weight(600);
  set("unit", "本");
  set("long", "这是一本介绍蝌蚪文的书。\n");
  set("value", 2000);
  set("skill", ([
    "name": "kedouwen",          // name of the skill
    "exp_required": 20000,           // minimum combat experience required                                                                           
    // to learn this skill.
    "sen_cost": 40,                  // gin cost every time study this
    "difficulty": 15,                // the base int to learn this skill
    // modify is gin_cost's (difficulty - int)*5%
    "max_skill": 64   // the maximum level you can learn from this object.
  ]));
}
