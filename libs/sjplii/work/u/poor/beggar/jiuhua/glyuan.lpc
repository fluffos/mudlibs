//xiaoyuan6  小院
inherit ROOM;

void create() {
  set("short", "小院");
  set("long", @LONG
这是甘露寺里南面的小院。平时只有少数进香客去藏经阁时经过这
里，在南边有一间简陋的小屋，屋子的门关着。东边是藏经阁，你可以
在那里买经书。
LONG
  );
  set("exits", ([ /* sizeof() == 2 */
    "east": __DIR__ "glcjge",
    "north": __DIR__ "glqiangc",
  ]));

  set("no_clean_up", 0);
  set("outdoors", "gaibang");

  setup();
}
void init() {
  add_action("do_knock", "knock");
  add_action("do_knock", "qiao");
}

int do_knock(string arg) {
  object me, ob;
  me = this_player();

  if (arg == "门" || arg == "door" || arg == "屋门") {
    if (!objectp(ob = present("tj-xin", me))) {
      write("房中没人理你。\n");
      return 1;
    }
    message_vision("$N敲了敲房门，无边大师说道：进来吧。\n", me);
    message_vision("$N走了进去。\n", me);
    me->move(__DIR__ "glwu");
    return 1;
  } else return 0;
}
