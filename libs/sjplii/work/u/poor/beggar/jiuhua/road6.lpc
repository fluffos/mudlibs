{
        set("short", "山路");
        set("long", @LONG
你走在九华山西边的山路上，两旁是山中的苍松翠竹，能隐
隐看见北边香烟缭绕。东南边是一条黄土路。
LONG
        );
        set("exits", ([/* sizeof() == 2 */
            "north" : __DIR__"road7",
            "southeast" : __DIR__"road5",
]));
        set("objects", 
        ([
              "/npc/nknpc" : 2,
        ]));

        set("no_clean_up", 0);
	set("outdoors","gaibang");

        setup();
        replace_program(ROOM);
}
