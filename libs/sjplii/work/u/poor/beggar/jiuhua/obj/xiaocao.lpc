// xiaocao.c
#include <ansi.h>

inherit ITEM;

int do_eat(string);
void init();

void init()
{
        add_action("do_eat", "eat");
}

void create()
{
        set_name(MAG "紫色小草" NOR, ({"xiaocao"}));
        set_weight(20);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "株");
                set("long", 
"这是一株紫色的小草，村里人都用它来治疗重病。\n");
        }

        setup();
}

int do_eat(string arg)
{
        object me = this_player();

        if (!id(arg))
                return notify_fail("你要吃什么？\n");

        if ((me->query("eff_gin") == me->query("max_gin"))&&
                (me->query("eff_kee") == me->query("max_kee"))&&
                (me->query("eff_sen") == me->query("max_sen"))) {
       message_vision(
 "$N没有得任何疾病，还是不要吃它了吧。\n",me);
       return 1;
        }


        me->set("eff_gin", (int)me->query("max_gin"));
        me->set("gin", (int)me->query("max_gin"));
        me->set("eff_kee", (int)me->query("max_kee"));
        me->set("kee", (int)me->query("max_kee"));
        me->set("eff_sen", (int)me->query("max_sen"));
        me->set("sen", (int)me->query("max_sen"));
        message_vision(
 "$N吃下一株"MAG"紫色小草"NOR"，只觉一股热气自丹田而起，绕全身经脉运行一周，\n"
 "顿时觉得浑身舒畅，气血充盈。\n",me);

        destruct(this_object());
        return 1;
}
