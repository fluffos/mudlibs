// wang.c

#include <ansi.h>
inherit NPC;

void create() {
  set_name("王其然", ({ "wang qiran", "master", "wang" }));
  set("title", "丐帮五袋弟子");
  set("nickname", HIM "夺命刀客" NOR);
  set("gender", "女性");
  set("long",
    "她是孝舵的弟子。\n");
  set("inquiry", ([
    "拜师": "问那么多干吗，快拜师吧！",
    "小木屋": "那是刘长老住的地方。",
  ]));
  set("max_kee", 1500);
  set("kee", 1500);
  set("force", 1500);
  set("max_force", 1500);
  set("force_factor", 40);
  set("combat_exp", 80000);

  set_skill("unarmed", 60);
  set_skill("force", 80);
  set_skill("parry", 80);
  set_skill("dodge", 80);
  set_skill("blade", 80);
  set_skill("begging", 80);

  set_skill("golden_blade", 80);
  set_skill("iron_strike", 60);
  set_skill("hidden_dodge", 80);
  set_skill("canyun_force", 80);
  set_skill("literate", 80);

  map_skill("dodge", "hidden_dodge");
  map_skill("unarmed", "iron_strike");
  map_skill("force", "canyun_force");
  map_skill("parry", "golden_blade");
  map_skill("blade", "golden_blade");

  create_family("丐帮", 6, "弟子");

  setup();

  carry_object("/u/poor/obj/cloth/jingyi")->wear();
  carry_object("/u/poor/obj/weapon/blade")->wield();
}

void attempt_apprentice(object ob) {
  int beg = (int)ob->query_skill("begging", 1);

  if (beg > 40) {
    command("smile");
    command("say 很好，" + RANK_D->query_respect(ob) + "多加努力，他日必定有成。\n");
    command("recruit " + ob->query("id"));
    command("say 丐帮乃江湖第一大帮，本派在江湖上必须行侠仗义，你可记清楚了。\n");
    ob->set("class", "gaibang");
    ob->set("title", "丐帮净衣帮孝舵大弟子");
  } else {
    command("say 这位" + RANK_D->query_respect(ob) + "还是去找赵仲义修习武功吧。\n");
  }
}
