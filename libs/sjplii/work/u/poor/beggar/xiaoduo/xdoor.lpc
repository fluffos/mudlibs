// Room: /beggar/door.c
#include <ansi.h>;

inherit ROOM;

void create() {
  set("short", HIB "大门" NOR);
  set("long", @LONG
你穿过树林来到这里，四周都是茂密的树林，在北边聚集着
许多乞丐，这里就是丐帮的大孝分舵了。
LONG
  );

  set("exits", ([ /* sizeof() == 3 */
    "north": __DIR__ "xkongdi",
    "southeast": __DIR__ "shulin1",
  ]));
  set("objects", ([ /* sizeof() == 1 */
    __DIR__ "npc/zhaozhyi": 1,
  ]));
  set("outdoors", "gaibang");
  set("no_clean_up", 0);

  setup();
}

int valid_leave(object who, string exit) {
  object ob;
  ob = present("zhao", environment(who));

  if (ob) if (ob->query_temp("block_msg/all"))
    return ::valid_leave(who, exit);

  if ((exit == "north") && (who->query("class") != "gaibang") && (present(
    "zhao",
    environment(who)
  )))
    return notify_fail("赵仲义说道：“前面是丐帮大孝分舵，请您速速离去！”\n");
  return ::valid_leave(who, exit);
}
