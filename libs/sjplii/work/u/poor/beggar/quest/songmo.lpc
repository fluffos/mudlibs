// gan.c

inherit ITEM;
inherit F_FOOD;

void create() {
  set_name("松蘑", ({ "songmo" }));
  set_weight(80);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一朵鲜嫩的松蘑。\n");
    set("unit", "朵");
    set("value", 10);
    set("food_remaining", 3);
    set("food_supply", 5);
  }
}
