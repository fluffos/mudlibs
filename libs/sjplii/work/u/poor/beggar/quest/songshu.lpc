// Room: /poor/jingstreet.c

inherit ROOM;

int rou_num = 3;

void create()
{
	set("short", "松树上");
	set("long", @LONG
你爬到了松树上，在两个树杈见有一个鸟巢，鸟巢中有几颗
尚未孵化的鸟蛋。从这里能看到远远的村庄，和连绵的群山。
LONG
	);
	set("item_desc", ([ /* sizeof() == 1 */
  "鸟巢" : "鸟巢中几枚鸟蛋。
",
]));        
	set("exits", ([ /* sizeof() == 1 */
     "down" : __DIR__"songlin4",
]));
	set("no_clean_up", 0);

	setup();
}

void init()
{
	add_action("do_take", "take");
	add_action("do_take", "jian");
}

int do_take(string arg)
{
	object obj;
	if( arg=="鸟蛋" || arg=="egg" ) {
	     if(rou_num!=0) {
		    obj = new(__DIR__"egg");
			obj->set_amount(1);
		 	obj->move(this_player());     
			message_vision("$N捡起一枚鸟蛋。\n", this_player());
		 	rou_num--;
		 }
		 else write("鸟巢中什么都没有了。\n");
		 return 1;
	}
	else return 0;
}
