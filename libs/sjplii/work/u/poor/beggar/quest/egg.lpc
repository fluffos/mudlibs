// gan.c

inherit ITEM;
inherit F_FOOD;

void create() {
  set_name("鸟蛋", ({ "egg" }));
  set_weight(80);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一枚白色的鸟蛋。\n");
    set("unit", "枚");
    set("value", 10);
    set("food_remaining", 1);
    set("food_supply", 5);
  }
}
