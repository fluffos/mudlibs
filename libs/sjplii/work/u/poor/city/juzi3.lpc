// Room: /city/nandajie2.c

inherit ROOM;

void create()
{
	set("short", "橘子巷");
	set("long", @LONG
你走进了一条小巷之中，两边是一户户的民宅。从这里能
听到大街上繁华的吵闹声。
LONG
	);
	set("exits", ([
		"east" : __DIR__"juzikzh",
		"west" : __DIR__"juzi2",
	]));
	set("objects", ([
	__DIR__"npc/bing":2,
	]));
	set("outdoors","zhang");
       set("no_clean_up", 0);

	setup();
}
int valid_leave(object who,string exit)
{
  object ob;
  ob = present("bing",environment(who));

  if( ob ) if( ob->query_temp("block_msg/all"))
      return ::valid_leave(who,exit);
  
  if( (exit == "east") && (who->query("class")!="guanfu") && (present("bing",environment(who))))
      return notify_fail("官兵说道：“前边发生命案，不能过去！”\n");
  return ::valid_leave(who,exit);
}
