// Room: /beggar/door.c

inherit ROOM;
#include <ansi.h>;
int rou_num = 1;

void create()
{
	set("short", HIB"大树上"NOR);
	set("long", @LONG
你爬到了大树之上，在四周的树枝上接着许多人形的果子。
      这里没有明显的出口。
LONG
	);
       set("objects", ([ /* sizeof() == 1 */
  __DIR__"npc/bird" : 1,
]));
	set("outdoors","zhang");
        set("no_clean_up", 0);

	setup();
}

void init()
{
	add_action("do_climb", "climb" );
	add_action("do_pick", "pick" );
}

int do_climb(string arg)
{
	if( arg=="down" || arg=="树") {
	    if(this_player()->query_skill("dodge", 1)<=20) {
		     write("你向下看了一眼，不由得天旋地转。\n");
                  this_player()->unconcious();
			 return 1;
		}
		message_vision("$N慢慢向树下爬去，不一会儿，爬下了大树。\n", this_player());
		this_player()->move(__DIR__"yanzhidian1");
		message("vision", this_player()->name() + "爬下了大树。\n",
			environment(this_player()), this_player());
		return 1;
	}
	else return 0;
}

int do_pick(string arg)
{
	object me,ob,xiao,obj;
	int sk;
	me = this_player();
	ob = this_object();
	obj = present("golden-hammer",me);

	if ( obj && (ob->query("rou_num") < 0) ){
	message_vision("$N够不到树上的人参果。\n", this_player());
	return 1;
	}
	else if (obj) {
	message_vision("$N用金槌敲下了一个人参果。\n", this_player());
	ob->add("rou_num", -1);
	xiao = new("/u/poor/obj/pill/rshguo");
	xiao->move(me);
	return 1;
	}
	else {
	message_vision("$N用手抓住人参果，怎么摇，都摘不下来。\n", this_player());
	return 1;
	}
}
