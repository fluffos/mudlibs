// bing.c 官兵

inherit NPC;

void create()
{
	set_name("打手", ({ "dashou", "da shou" }));
	set("age", 32);
	set("gender", "男性");
	set("long", "他是热窝的打手。\n");
	set("attitude", "peaceful");

	set("str", 24);
	set("combat_exp", 100000);

	set_skill("unarmed", 80);
	set_skill("dodge", 80);
	set_skill("parry", 80);
	set_skill("blade", 80);
	set_skill("force", 80);
	set_temp("apply/attack", 40);
	set_temp("apply/defense", 40);
	set_temp("apply/damage", 20);
	set_temp("apply/armor", 40);

	setup();
	carry_object("/u/poor/obj/weapon/blade")->wield();
	carry_object("/u/poor/obj/cloth/cloth")->wear();
}

int accept_fight(object me)
{
	command("say 大爷我正想找人杀呐，今天算你倒霉。\n");
	me->apply_condition("killer", 500);
	kill_ob(me);
	return 1;
}
