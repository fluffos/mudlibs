#include <ansi.h>

inherit NPC;
/*
inherit F_PAWNOWNER;
inherit F_VENDOR;
*/

void create()
{
        set_name("奇松", ({ "qi song","qisong","qi" }) );
        set("gender", "男性" );
        set("age", 39);
        set("nickname", "当铺老板");
        set("long",
                "这是当铺的老板，十分精明。\n");
        set("combat_exp", 50000);
        set("attitude", "friendly");
        set("per",30);
        set("no_arrest",1);
        set_skill("unarmed",100);
        set_skill("dodge",100);
        setup();
        carry_object("/u/poor/obj/cloth/cloth")->wear();
}

