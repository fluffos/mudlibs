// golder.c

inherit NPC;
inherit F_VENDOR;

void create()
{
	set_name("伙计", ({"waiter","seller"}));
	set("title","福运楼");
	set_skill("unarmed", 20);
	set_skill("parry", 30);
	set_skill("dodge", 30);
	set("gender","男性");

	set("force",600);
	set("max_force",600);
	set("per",30);
	set("food",200);
	set("water",200);
	set("combat_exp",6000);

	set("age", 16);
	set("long", @LONG
他是这里跑堂的伙计。你可以向他要些酒菜。
LONG
);

	set("vendor_goods", ([
		__DIR__"obj/cai"	      : 20,
		__DIR__"obj/jiudai"     : 20,
	]));

	setup();

	carry_object("/u/poor/obj/cloth/cloth")->wear();
}

void init()
{
	add_action("do_vendor_list", "list");
}
