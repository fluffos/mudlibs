// golder.c

inherit NPC;

void create() {
  set_name("赤松道人", ({ "chi song" }));
  set("title", "武当派弟子");
  set_skill("unarmed", 120);
  set_skill("parry", 120);
  set_skill("dodge", 120);
  set("gender", "男性");

  set("force", 1000);
  set("max_kee", 1000);
  set("max_force", 40);
  set("food", 500);
  set("water", 500);
  set("combat_exp", 100000);

  set("age", 58);
  set("long", @LONG
他是武当派弟子。
LONG
  );
  set("chat_chance_combat", 1);
  set("chat_chance", 2);
  set("chat_msg", ({
    "赤松说道：唉。。。。听说又发生命案了。\n",
  }));
  set("inquiry", ([
    "武当派": "武当派当然在武当山了。",
    "命案": "可能又是寒灵山庄的人所为。",
    "寒灵山庄": "是江湖上一个庞大的组织，其中有[风]，[雨]，[雷]，[电]四大高手。",
    "风": "传说此人是个女子，名叫寒叶。",
    "雨": "这个人谁也没见过，只知道有时常用匕首伤人。",
    "电": "听说这个人性格很怪，喜怒无常，名叫寒芳。",
    "雷": "只知道此人是个美貌女子。",
    "白玉刀": "这是[电]惯用的兵器。",
    "翡翠匕首": "[雨]经常用这种不锋利的兵器伤人。",
    "青冥剑": "青冥剑是[风]的贴身兵器。",
  ]));

  setup();

  carry_object("/u/poor/obj/cloth/cloth")->wear();
}
