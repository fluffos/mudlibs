// golder.c

inherit NPC;

void create() {
  set_name("日本小女孩", ({ "girl" }));
  set_skill("unarmed", 20);
  set_skill("parry", 20);
  set_skill("dodge", 20);
  set_skill("literate", 20);
  set("gender", "女性");

  set("force", 20);
  set("max_force", 20);
  set("food", 200);
  set("water", 200);
  set("combat_exp", 80);
  set("chat_chance", 3);
  set("chat_msg", ({
    "小女孩说道：中国真好玩。\n",
  }));
  set("age", 16);
  set("long", @LONG
她是一个日本小女孩。
LONG
  );

  setup();

  carry_object("/u/poor/obj/cloth/hefu")->wear();
}
