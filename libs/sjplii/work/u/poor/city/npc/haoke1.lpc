#include <ansi.h>
inherit NPC;
void create()
{
        set_name("赤阳子", ({ "chi yangzi", "chiyangzi" }) );
        set("gender", "男性" );
        set("age", 35);
        set("title", "逍遥派弟子");
        set("chat_chance_combat", 1);
        set("chat_chance", 2);
        set("chat_msg", ({
        "赤阳子说道：听说没有，寒灵山庄的人又在江湖上行凶了？\n",
        }) );
        set("long",     "他是一个逍遥派弟子。\n");

        set("combat_exp", 600000);

        set_skill("dodge", 100);
        set_skill("parry", 100);
        set_skill("literate", 20);
        set_skill("unarmed", 100);
        set_temp("apply/defense", 30);
        set_temp("apply/move", 30);
        create_family("逍遥", 20, "弟子");

        setup();

        carry_object("/u/poor/obj/cloth/cloth")->wear();
}
