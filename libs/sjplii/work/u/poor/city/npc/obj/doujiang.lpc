// dumpling.c

inherit ITEM;
inherit F_FOOD;

void create()
{
	set_name("豆浆", ({ "doujiang" }) );
	set_weight(80);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "一碗可口的豆浆。\n");
		set("unit", "碗");
		set("value", 70);
		set("water_remaining", 2);
		set("water_supply", 30);
	}
}
