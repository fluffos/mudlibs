// dumpling.c

inherit ITEM;
inherit F_FOOD;

void create()
{
	set_name("老鼠药", ({ "rat-medicine" }) );
	set_weight(80);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "一包老鼠药。\n");
		set("unit", "包");
		set("value", 2000);
		set("food_remaining", 1);
		set("food_supply", 10);
	}
}
