// cai.c

inherit ITEM;

string* titles = ({
	"红茶",
	"绿茶",
	"菊花茶",
     	"八宝茶",
});


void create()
{
	int i = random(sizeof(titles));

	set_name(titles[i], ({ "tea" }) );
	set_weight(80);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "这是一杯茶。\n");
		set("unit", "杯");
		set("value", 10);
		set("remaining", 1);
		set("water_supply", 15);
	}
	setup();
}
void init()
{
	add_action("do_drink", "drink");
}


int do_drink(string arg)
{
	int i = random(sizeof(titles));

    if( !this_object()->id(arg) ) return 0;
    if( this_player()->is_busy() )
        return notify_fail("你上一个动作还没有完成。\n");
    if(   (int)this_player()->query("water")
       >= (int)this_player()->max_water_capacity() )
     return notify_fail("你已经喝得太多了，再也灌不下一滴水了。\n");

    set("value", 0);
    this_player()->add("water", (int)query("water_supply"));

    if( this_player()->is_fighting() ) this_player()->start_busy(2);

    add("remaining", -1);
	if ( query("remaining") ){
		if ((string)this_player()->query("gender") == "男性")	{
   		 message_vision("$N喝了一些茶。\n", this_player());
		} 
		else if ((string)this_player()->query("gender") == "女性") {
		message_vision("$N喝了一些茶。\n", this_player());
		}
	}
	else 	{ 
		if ((string)this_player()->query("gender") == "男性")	{
   		 message_vision("$N用袖子随便擦了擦嘴。\n",this_player());
		destruct(this_object());
		}
		else if ((string)this_player()->query("gender") == "女性") {
		 message_vision("$N拿出一方丝帕，轻轻地擦了擦嘴。\n",this_player());
		destruct(this_object());
		}
	}

	return 1;
}

