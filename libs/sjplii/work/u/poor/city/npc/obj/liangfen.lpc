// dumpling.c

inherit ITEM;
inherit F_FOOD;

void create()
{
	set_name("凉粉", ({ "liangfen" }) );
	set_weight(80);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "一种可口的小吃。\n");
		set("unit", "碗");
		set("value", 50);
		set("food_remaining", 3);
		set("food_supply", 20);
	}
}
