// super_food.c 超级太空食品
#include <ansi.h>

inherit ITEM;

int do_eat(string);
void init();

void init()
{
        add_action("do_eat", "eat");
}

void create()
{
        set_name("大馅饺子", ({"dumpling"}));
        set_weight(30);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("unit", "碗");
                set("long", 
"这是用鸡汤、虾肉、鸡蛋等做的饺子。。\n");
                set("value", 60000);
        }

        setup();
}

int do_eat(string arg)
{
        object me = this_player();

        if (!id(arg))
                return notify_fail("你要吃什么？\n");

        me->set("food", 500);
        me->set("water", 500);
        message_vision(
 "$N吃下一碗大馅饺子，肚子涨的难受！\n",me);

        destruct(this_object());
        return 1;
}
