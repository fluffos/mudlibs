#include <ansi.h>
inherit NPC;
void create()
{
        set_name("洪魄", ({ "hong po", "hong po" }) );
        set("gender", "男性" );
        set("age", 35);
        set("title", "魔教弟子");
        set("chat_chance_combat", 1);
        set("chat_chance", 2);
        set("chat_msg", ({
        "洪魄说道：听说在镇子西边有个大山寨，里边藏有不少宝物？\n",
        }) );
        set("long",     "他是一个魔教弟子。\n");

        set("combat_exp", 600000);

        set_skill("dodge", 100);
        set_skill("parry", 100);
        set_skill("literate", 20);
        set_skill("unarmed", 100);
        set_temp("apply/defense", 30);
        set_temp("apply/move", 30);
        create_family("魔教", 11, "弟子");

        setup();

        carry_object("/u/poor/obj/cloth/cloth")->wear();
}
