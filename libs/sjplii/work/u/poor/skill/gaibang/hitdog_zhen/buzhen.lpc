//buzhen.c 打狗阵 by poor

#include <ansi.h>
inherit SSERVER;

void npc_attack(object invoker, object target, string npc, object where);

int perform(object me, object target)
{
	string msg;
	string npc_ls = "/u/poor/npc/hitdog/";
	object where;

        if( !target || target==me ) {
                target = offensive_target(me);
                if( !target) return notify_fail("你想对谁布阵？\n");
        }

	if((string)me->query("class") != "gaibang" )
		return notify_fail("你又不是丐帮弟子，怎么会布阵。\n");

	if((string)target->query("class") == "gaibang" )
		return notify_fail("同门相斗也要布阵，非要致同门于死地？\n");

	if((int)me->query("sen") < 10 )
		return notify_fail("你现在神智不清！\n");

	me->receive_damage("sen", 20);

	if( random(me->query_skill("hitdog_zhen", 1)) < 100 ) 
	{
		write("这一次好象没布成阵。\n");
		return 1;
	}

	msg = HIC "$N大喝一声：布打狗阵！\n"+
	       "纵位玉池若明，迫位罗洪，降位寒渊，惊位邹处灵！\n"+
	       "只见四周出现四个黑影。\n"+
	       "$N对着$n说道：小子，受死吧！\n\n" NOR;	
	message_vision(msg, me, target);
	msg = HIR "$n对着$N高声骂道：好家伙，一拥而上了，我宰了你！\n" NOR;	
	message_vision(msg, me, target);
	target->kill_ob(me);
	
	where=environment(target);
	call_out("npc_attack", 2, me, target, npc_ls+"ruoming", where);
	call_out("npc_attack", 3, me, target, npc_ls+"luohong", where);
	call_out("npc_attack", 5, me, target, npc_ls+"hanyuan", where);
	call_out("npc_attack", 6, me, target, npc_ls+"chuling", where);
	call_out("npc_attack", 8, me, target, npc_ls+"ruoming", where);
	call_out("npc_attack", 9, me, target, npc_ls+"luohong", where);
	call_out("npc_attack", 11, me, target, npc_ls+"hanyuan", where);
	call_out("npc_attack", 12, me, target, npc_ls+"chuling", where);

	me->start_busy(2+random(2));
	return 30+random(30);
}

void npc_attack(object invoker, object target, string npc, object where)
{
	object attacker;
	int rd;
	string tid;

	if(!invoker || !target) return;

	if( environment(invoker) != environment(target) ) return;
	if( environment(target) != where) return;

	seteuid(getuid());
	attacker = new(npc);
	attacker->move(environment(invoker));

	if( (int)target->query("combat_exp") < 10000 )
	{
		tid = (string)target->query("id");
		rd = random(7);
		if( rd == 0 ) attacker->command_function("maoli " + tid);
		else if( rd == 1 ) attacker->command_function("kick " + tid);
		else if( rd == 2 ) attacker->command_function("noescape " + tid);
		else if( rd == 3 ) attacker->command_function("slogan " + tid);
		else if( rd == 4 ) attacker->command_function("hit " + tid);
		else if( rd == 5 ) attacker->command_function("hammer " + tid);
		else attacker->command_function("nip " + tid);
	}
	else
	{
		COMBAT_D->do_attack(attacker, target, attacker->query_temp("weapon"));
	
		if(target->query_temp("last_damage_from")==attacker)
			target->set_temp("last_damage_from", invoker);
	
		if(target->query_temp("last_fainted_from")==attacker)
			target->set_temp("last_fainted_from", invoker->query("id"));
	}
	destruct(attacker);
}

