// purple_sword.c
#include <weapon.h>
#include <ansi.h>
inherit SWORD;

void create()
{
        set_name(HIR"狂龙剑"NOR, ({ "dragon-sword","sword","jian" }) );
        set_weight(1000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "把");
                set("value",0);
                set("material", "blacksteel");
        	set("rigidity", 160);
        	set("sharpness", 150);
                set("long", "这是一通体赤红的宝剑。\n");
                set("wield_msg", "随着一阵红光闪耀，$n已握在$N手中。\n");
                set("unwield_msg", "$N放下了手中$n。\n");
        }
        init_sword(80);
        setup();
}
 
