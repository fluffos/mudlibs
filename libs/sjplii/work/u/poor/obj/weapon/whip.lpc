// whip.c : an example weapon

#include <weapon.h>

inherit WHIP;

void create()
{
	set_name("鞭子", ({ "whip" }) );
	set_weight(700);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "条");
		set("long", "这是一条看起相当普通的鞭子。\n");
		set("value", 500);
		set("material", "skin");
		set("wield_msg", "$N抽出一条$n握在手中。\n");
		set("unwield_msg", "$N将手中的$n盘在腰间。\n");
	}
	init_whip(25);
	setup();
}
