// dragon-book

inherit ITEM;

void create()
{
        set_name("《鞭法入门》", ({ "whip-book" }));
        set_weight(600);
        set("unit", "本");
        set("long", "这是一本介绍基本鞭法的入门书籍。\n");
        set("value", 2000);
        set("skill", ([
                "name":        "whip",          // name of the skill
                "exp_required": 10,           // minimum combat experience required                                                                           
                                                 // to learn this skill.
                "sen_cost": 10,                  // gin cost every time study this
                "difficulty": 25,                // the base int to learn this skill
                                  // modify is gin_cost's (difficulty - int)*5%
                "max_skill": 29   // the maximum level you can learn from this object.
        ]) );
}
 
