// Room: /u/poor/yidao.c



inherit ROOM;



void create()

{

        set("short", "黄土小路");

        set("long", @LONG

你走在一条黄土小路上，四周的行人明显减少，路上也显得

冷清了许多。这里已经离海边不远了。

LONG

        );



        set("exits", ([

                "southwest" : __DIR__"yidao4",

                "northeast" : __DIR__"hanbian1",

        ]));

        setup();

}

void init()

{

        add_action("do_go","go");

}



int do_go()

{

if(random(4)){

this_player()->move(this_object());

return 1;

}

}

