// fish.c

#include <ansi.h>

inherit NPC;

void create()
{
	set_name("熊", ({ "bear" }) );
	set("long",	"一只巨大的熊。\n");

	set("race", "野兽");
	set("age", 6);
       set("attitude", "aggressive");
	set("max_gin", 3000);
	set("max_kee", 3000);
	set("max_sen", 3000);
       set_skill("dodge", 10);
       set_skill("unarmed", 100);
       set_skill("parry", 100);

	set("str", 90);
	set("cor", 60);

	set("limbs", ({ "头部", "身体" }) );
	set("verbs", ({ "bite" }) );

	set_temp("apply/attack", 40);
	set_temp("apply/damage", 40);
	set_temp("apply/armor", 40);
	set("combat_exp", 300000);
	setup();
}

