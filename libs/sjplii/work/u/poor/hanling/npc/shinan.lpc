// wangqr.c

#include <ansi.h>
inherit NPC;
int ask_me();

void create() {
  set_name("施楠", ({ "shi nan", "master", "shi" }));
  set("nickname", HIB "酒丐" NOR);
  set("title", "丐帮前任帮主");
  set("gender", "男性");
  set("age", 95);
  set("long",
    "他就是丐帮的前任帮主，但是现在他武功以废。\n");
  set("inquiry", ([
    "拜师": "要看你的资质而定了！",
    "史枫": "他的剑法很厉害呀。",
    "石海风": "徒儿还好吗？",
    "丐帮": "自从帮中分出净衣，污衣后。。。。。。",
    "杨姑娘": "她现在还好吗？",
  ]));
  set("str", 26);
  set("max_kee", 4000);
  set("kee", 4000);
  set("eff_kee", 2500);
  set("force", 6000);
  set("max_force", 6000);
  set("force_factor", 50);
  set("combat_exp", 8000000);

  set_skill("unarmed", 300);
  set_skill("force", 300);
  set_skill("parry", 300);
  set_skill("dodge", 300);
  set_skill("stick", 300);
  set_skill("whip", 250);
  set_skill("begging", 300);

  set_skill("xianglong_strike", 250);
  set_skill("canyun_force", 250);
  set_skill("hitdog_zhen", 250);
  set_skill("literate", 200);
  set_skill("hitdog_stick", 250);
  set_skill("penyuntuwu", 300);

  map_skill("dodge", "hitdog_zhen");
  map_skill("unarmed", "xianglong_strike");
  map_skill("force", "penyuntuwu");
  map_skill("stick", "hitdog_stick");
  map_skill("parry", "hitdog_stick");

  create_family("丐帮", 1, "弟子");

  setup();

  carry_object("/u/poor/obj/cloth/cloth")->wear();
}

void attempt_apprentice(object ob) {
  if (!ob->query("marks/killfang")) {
    command("say 我不收徒弟了！\n");
  } else {
    command("say 很好，" + RANK_D->query_respect(ob) +
      "多加努力，他日必定有成。\n");
    command("recruit " + ob->query("id"));
    ob->set("class", "gaibang");
    ob->set("title", "丐帮副帮主");
  }
}

void recruit_apprentice(object ob) {
  if (::recruit_apprentice(ob))
    ob->set("class", "gaibang");
}
