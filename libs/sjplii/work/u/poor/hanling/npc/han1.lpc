#include <ansi.h>
inherit NPC;
void create()
{
        int i,amun;
        string *order = ({"张","王","李","赵","杨","郭","孟","林","崔","孔", 
"段","苏","刘","孙","周","郑","方","韩","许","徐"});
        string *orderr = ({"品端","来福","家宝","安","鹏山","宗英","奉","满",
"报国","仪","富贵","典","志新","古风","处天","平安","君","若明","易遥"});
        set_name( order[random(20)] + orderr[random(19)], ({ "zhuangke" }) );
        set("gender", "男性" );
        set("age", random(20)+30);
        set("title", "寒灵山庄庄客");
        set("long",
"他是一位寒灵山庄的庄客。\n");
        set("max_kee", 1000);
        set("kee", 1000);
        set("force", 1000);
        set("max_force", 1000);
        set("force_factor",20);
        set("combat_exp", 100000+random(500000));
        set_skill("unarmed", 20+random(100));
        set_skill("blade", 20+random(100));
        set_skill("parry", 20+random(100));
        set_skill("dodge", 20+random(100));
        set_skill("golden_blade", 20+random(100));
        set_skill("iron_strike", 20+random(100));
        set_skill("shaolin-dodge", 20+random(100));
        set_skill("canyun_force", 20+random(100));
        set_skill("literate", 80);

        map_skill("blade", "golden_blade");
        map_skill("parry", "golden_blade");
        map_skill("dodge", "shaolin-dodge");
        map_skill("unarmed", "iron_strike");
        map_skill("force", "canyun_force");
 
        create_family("寒灵", 3, "弟子");

        setup();
        carry_object("/u/poor/obj/cloth/heiyi")->wield();
        carry_object("/u/poor/obj/weapon/blade")->wield();
}

