// Room: /beggar/door.c
#include <ansi.h>;

inherit ROOM;

void create()
{
	set("short", "地道");
	set("long", @LONG
你走在寒灵山附近的地道之中，这里光线十分昏暗，几乎
看无清四周的景物。不时能听到“嘀嗒、嘀嗒”的水声。西边
有条岔路。
LONG
	);
	set("exits", ([ /* sizeof() == 3 */
    "northwest" : __DIR__"droad6",
    "south" : __DIR__"droad4",
    "east" : __DIR__"dxuan",
]));
	set("objects", ([ 
		__DIR__"npc/han1" : 4,
]));
	setup();
}

int valid_leave(object who,string exit)
{
  object ob;
  ob = present("zhuangke",environment(who));

  if( ob ) if( ob->query_temp("block_msg/all"))
      return ::valid_leave(who,exit);
  
  if( (exit == "east") && (present("zhuangke",environment(who))))
      return notify_fail("庄客说道：“庄主不让任何人到西边去！”\n");
  return ::valid_leave(who,exit);
}

