// Room: /beggar/door.c
#include <ansi.h>;

inherit ROOM;
int rou_num = 1;

void create()
{
	set("short", "地道");
	set("long", @LONG
你走在寒灵山附近的地道之中，这里光线十分昏暗，几乎
看无清四周的景物。不时能听到“嘀嗒、嘀嗒”的水声。在地
上有块石头。
LONG
	);
	set("exits", ([ /* sizeof() == 3 */
    "west" : __DIR__"dyijin1",
]));
	set("objects", ([ 
		__DIR__"obj/stone" : 1,
]));
	setup();
}
void init()
{
	add_action("do_break", "break" );
}
int do_break(string arg)
{
	object obj;
	if( arg=="stone" || arg=="石头" ) {
	     if(rou_num!=0) {
		    obj = new("/u/poor/obj/book/yj-jing");
			obj->set_amount(1);
		 	obj->move(this_player());     
			message_vision("$N用力击碎了石头，从石头中取出了本《易筋经》。\n", this_player());
		 	rou_num--;
		 }
		 else write("你用力向石头击去，石头看上去一点事都没有。\n");
		 return 1;
	}
	else return 0;
}


