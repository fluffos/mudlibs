// luohong

#include <ansi.h>
inherit NPC;

void create()
{
        set_name("罗洪", ({ "luo hong", "master", "luohong" }) );
        set("nickname", HIY "震八方" NOR);
        set("title", "丐帮大礼分舵舵主");
        set("gender", "男性");
        set("age", 45);
        set("long",
 "他就是丐帮大礼分舵的舵主。\n");

        set("max_kee", 700);
        set("kee", 700);
        set("force", 1100);
        set("max_force", 700);
        set("force_factor",40);
        set("combat_exp",110000);
        set("class", "gaibang");

        set_skill("unarmed", 90);
        set_skill("force", 90);
        set_skill("parry", 90);
        set_skill("dodge", 90);
        set_skill("stick", 90);
        set_skill("begging", 90);

        set_skill("iron_strike", 90);
        set_skill("hitdog_zhen", 90);
        set_skill("canyun_force", 90);
        set_skill("hitdog_stick", 90);

        map_skill("dodge", "hitdog_zhen");
        map_skill("unarmed", "iron_strike");
        map_skill("force", "canyun_force");
        map_skill("stick", "hitdog_stick");
        map_skill("parry", "hitdog_stick");

        create_family("丐帮", 5, "弟子");

        setup();

        carry_object("/u/poor/obj/weapon/stick")->wield();
        carry_object("/obj/cloth")->wear();
}

