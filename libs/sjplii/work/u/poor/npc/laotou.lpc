#include <ansi.h>
inherit NPC;
void create()
{
        set_name("老者", ({ "oldman", "laozhe" }) );
        set("gender", "男性" );
        set("age", 70);
        set("str", 30);
        set("cor", 10);
        set("cps", 15);
        set("per", 15);
        set("int", 20);
        set("chat_chance", 1);
        set("chat_msg", ({
        "老者自言自语道：七星岛又来了，中原又是一场浩劫。\n",
        }) );
        set("long",     "他是一个不知名的老者。\n");

        set("combat_exp", 50000);

        set_skill("dodge", 80);
        set_skill("parry", 80);
        set_skill("unarmed", 80);

        setup();

        carry_object(__DIR__"obj/cloth")->wear();
}
void init()
{
        object ob;
        ::init();
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("checklooking");
                call_out("checklooking", 1, ob);
        }
}

void checklooking(object ob)
{
        command("say 东临皆石，以观沧海。");      
}