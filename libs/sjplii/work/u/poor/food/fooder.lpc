// /u/poor/gaibang/cooker/fooder.c

#include <ansi.h>
inherit NPC;
int about_quest();

void create()
{
        set_name("钟形石", ({ "zhong xingshi","zhong" }));
        set("long",
            "他个丐帮前任的长老，在帮中地位很高。他身体略胖，对于\n"+
            "各种美食很有研究，几乎天下所有的美味佳肴他都吃过。\n");
        set("title", "丐帮前任长老");
        set("gender", "男性");
        set("age", 74);
        set("nickname", HIW "美食老人" NOR);
        set("shen_type",1);
        set("attitude", "peaceful");

        set("str", 30);
        set("int", 30);
        set("cor", 30);
        set("spi", 30);
        set("max_kee", 3000);
        set("max_gin", 3000);
        set("max_sen", 3000);
        set("kee", 3000);
        set("gin", 3000);
        set("sen", 3000);

        set("force", 3000);
        set("max_force", 2000);
        set("force_factor", 30);

        set("inquiry", ([
                "quest" : (: about_quest :),
                "菜": "你可以找人厨子去做。",
                "蚝油牛肉": "主要原料是牛肉。",
                "过油肉": "主要原料是猪肉。",
                "木耳菜": "主要原料是木耳。",
                "荷包蛋": "主要原料是鸟蛋。",
                "炒蛇肉": "主要原料是蛇肉。",
                "小鸡炖松蘑": "主要原料是松蘑。",
                "香野菜": "主要原料是一种紫色的小草。",
                "焦香兔肉": "主要原料是兔肉。",
                "炖野鸡肉": "主要原料是野鸡肉。",
                "凉拌咸肉": "主要原料是咸猪肉。",
                "红烧鲫鱼": "主要原料是鲫鱼。",
                "油焖扁豆": "主要原料是扁豆。",
                "油焖大虾": "主要原料是青虾。",
                "炒米饭": "主要原料是大米。",
                "水晶鲜贝": "主要原料是扇贝肉。",
                "炒蟹肉": "主要原料是螃蟹肉。",
                "龙虾": "我也不知道哪有。",
        ]));

        set("combat_exp", 200000);
        set("score", 20000);

        set_skill("literate", 50);
        set_skill("force", 150);
        set_skill("unarmed", 150);
        set_skill("sword", 150);
        set_skill("crazy_sword", 150);
        set_skill("hidden_dodge", 150);
        set_skill("canyun_force", 150);
        set_skill("parry", 150);
        set_skill("dodge", 150);
        set_skill("iron_strike",100);
        map_skill("unarmed", "iron_strike");
        map_skill("sword", "crazy_sword");
        map_skill("force", "canyun_force");
        map_skill("parry", "crazy_sword");
        map_skill("dodge", "hidden_dodge");
        setup();
        carry_object(__DIR__"kuaizi")->wield();
        carry_object("/u/poor/gaibang/npc/obj/cloth")->wear();
}
void init()
{
        add_action("do_cancel", "cancel");
}

int do_cancel(string arg)
{
        object me=this_player();
        if(!arg || arg!="quest")
          return notify_fail("你要取消什么？\n");
        if (!(int)me->query("marks/food")||(int)me->query("marks/food")==0)
          return notify_fail("你现在没有任务。\n");
        say( CYN"钟形石叹道：哎.......就知道你不成的。\n"NOR);
        if( (int)me->query("combat_exp") <= 200 ) 
                {
                        me->set("marks/food", 0);
                        return 1;
                }
        me->add("combat_exp", -random(200));
        me->set("marks/food", 0);
        me->set("gin",0);
        me->set("kee",0);
        me->unconcious();
        return 1;
}

int about_quest()
{
        int task;
        object me=this_player();

        if( (int)me->query("combat_exp") >= 800000 ) {
        say("钟形石说道：我不想吃东西了。\n");
        return 1;}

        task=random(18);
        if ((int)me->query("marks/food")==0)
{
        if(task==1){
        say( CYN"钟形石说道：让我想一想，［蚝油牛肉］比较不错的，能帮我找来吗？\n"NOR);
