int accept_object(object who, object ob)
{
        int exp,pot;
        object me;
        me = this_player();
        exp = (int) me->query("combat_exp");
        pot = (int) me->query("potential");
        if ((int)me->query("marks/food")==1)
        {
        if( ob->name() == "蚝油牛肉") {
                say( CYN"钟形石拍拍肚子，微笑点头。\n"NOR);
                me->set("combat_exp", (int) exp + 10);
                me->set("potential", (int) pot + 25);
                me->set("marks/food",0);
                return 1;
                }
                else {
                        say(CYN"钟形石摇头道：这不是我想要的。\n"NOR);
