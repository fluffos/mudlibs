// 木耳菜

inherit ITEM;
inherit F_FOOD;

void create() {
  set_name("木耳菜", ({ "cai", "muercai" }));
  set_weight(200);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "这是一盘由木耳烹调的好菜。\n");
    set("unit", "盘");
    set("value", 500);
    set("food_remaining", 3);
    set("food_supply", 50);
  }
}
