// 水晶鲜贝

inherit ITEM;
inherit F_FOOD;

void create()
{
	set_name("水晶鲜贝", ({ "cai", "sjxianbei" }) );
	set_weight(200);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "这是一盘由扇贝烹调的好菜。\n");
		set("unit", "盘");
		set("value", 500);
		set("food_remaining", 3);
		set("food_supply", 50);
	}
}
