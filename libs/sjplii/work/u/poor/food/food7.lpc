// 香野菜
#include <ansi.h>

inherit ITEM;

int do_eat(string);
void init();

void init() {
  add_action("do_eat", "eat");
}

void create() {
  set_name("香野菜", ({ "cai" }));
  set_weight(300);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "盘");
    set("long",
      "这是一盘由紫色的野菜烹调而成的佳肴。\n");
    set("value", 10000);
  }

  setup();
}

int do_eat(string arg) {
  object me = this_player();

  if (!id(arg))
    return notify_fail("你要吃什么？\n");

  me->set("food", 800);
  me->set("water", 800);
  message_vision(
    "$N吃下一盘香野菜，感到十分饱了！\n", me);

  destruct(this_object());
  return 1;
}
