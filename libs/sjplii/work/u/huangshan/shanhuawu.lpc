//huangshan shanhuawu.c
inherit ROOM;

void create ()
{
        set ("short", "散花坞");
        set ("long", @LONG
黄山美在奇松、怪石、云海、温泉“四绝”。这散花坞就是黄山的齐石之
一,传说散花坞是上古九天玄女散下的众花之中的牡丹花所化,它状是一朵巨大
的牡丹花,美丽绝伦。
LONG);

       
        set("exits", 
        ([ //sizeof() == 4
              "west" : __DIR__"guanpubu",
		"southdown" : __DIR__"tianmen",
              "east" : __DIR__"wangyue",

           ]));

        set("objects", 
        ([ //sizeof() == 1
		__DIR__"npc/people" : 2,
        ]));


        set("outdoors", "huangshan");
	set("no_clean_up", 0);
	        setup();
}


