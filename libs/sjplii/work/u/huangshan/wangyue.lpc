//huangshan wangyue.c
inherit ROOM;
int do_tiao(string arg);

void create ()
{
        set ("short", "犀牛望月");
        set ("long", @LONG
这是黄山的一块怪石,它状是一只犀牛在抬头望着月亮,象是要把月亮的精
华都据为己有,不知从什么时候起这里成了武林豪客比武的地方,由“万松山庄
”庄主黄清溪来主持比武大赛,这里有一块巨石，甚是光滑，看来爬不上去。
LONG);

       
        set("exits", 
        ([ //sizeof() == 4
              "west" : __DIR__"shanhuawu",

           ]));

        set("objects", 
        ([ //sizeof() == 1
              "/npc/nknpc" : 1,
        ]));


        set("outdoors", "huangshan");
	set("no_clean_up", 0);
	        setup();
}
void init()
{
	add_action("do_tiao", "jump");
}

int do_tiao(string arg)
{
	object me=this_player();

	if( arg != "巨石") return 0;
	if(me->query_skill("dodge",1)<10) {
		printf("你使劲往上一跃，只跳起一尺多高，根本上不去！\n");
		return 1;
	}
	printf("你纵身一跃，跳到巨石的上面。\n");
	me->move("/u/huangshan/liyubei.lpc");
	tell_room(this_object(),me->query("name")+"往北边离开。\n");
       return 1;

}




