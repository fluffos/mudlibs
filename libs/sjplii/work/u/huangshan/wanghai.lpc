//huangshan wanghai.c
inherit ROOM;

void create ()
{
        set ("short", "猴子望海");
        set ("long", @LONG
这是在黄山上看云海最好的地方，一块猴子模样的怪石蹲在这里，望着云
海，云海是黄山的一奇，它气势磅礴，站在这里有小天下的感觉，所以兵书宝
剑侠就在这里每年的一月一日主持比武大会，让武林中的决定高手在这里一决
高低，在这里可以看到一块石碑。
LONG);

       
        set("exits", 
        ([ //sizeof() == 4
              "northup" : __DIR__"dahui",
		"west" : __DIR__"wenquan",
	       "southdown" : __DIR__"liyubei",

           ]));

        set("objects", 
        ([ //sizeof() == 1
//		__DIR__"npc/huang" : 2,
        ]));


        set("outdoors", "huangshan");
	set("no_clean_up", 0);
	        setup();
}


