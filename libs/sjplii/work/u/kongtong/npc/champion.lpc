// servant.c
#include <ansi.h>

inherit NPC;
inherit F_MASTER;

void create() {
  set_name("金振夫", ({ "jin zhenfu", "jin" }));
  set("nickname", HIC "七灵剑" NOR);
  set("gender", "男性");
  set("age", 34);
  set("attitude", "peaceful");
  set("combat_exp", 4000000);
  set("score", 20000);
  set("class", "kongtong");

  set("str", 60);
  set("int", 30);
  set("cor", 30);
  set("cps", 30);
  set("con", 30);

  set("force", 4000);
  set("max_force", 2200);
  set("force_factor", 30);

  set("inquiry", ([
    "武学": "武学之道....嗯....只可意会，不可言喻。\n",
    "拜师":
    "哦....金某向来有个规矩，凡是想拜我为师的，得接我三招不死，你想试试(accept 
test)？\n"
  ]));

  create_family("崆峒派", 7, "掌门");
  //        assign_apprentice("弟子", 0);

  set_skill("unarmed", 200);
  set_skill("sword", 190);
  //	set_skill("throwing", 190);
  set_skill("force", 190);
  set_skill("parry", 190);
  set_skill("dodge", 190);
  set_skill("literate", 190);
  //	set_skill("perception",190);
  set_skill("qxxl-sword", 190);
  set_skill("jzxj-force", 190);
  set_skill("five-spin", 190);
  set_skill("move", 200);

  map_skill("sword", "qxxl-sword");
  map_skill("parry", "qxxl-sword");
  map_skill("force", "jzxj-force");
  map_skill("dodge", "five-spin");
  map_skill("move", "five-spin");
  setup();

  carry_object(__DIR__ "obj/soulimpaler")->wield();
}

void init() {
  ::init();
  add_action("do_accept", "accept");
}


int do_accept(string arg) {
  mapping guild;

  if (arg == "test") {
    say("\n金振夫点了点头，说道：很好，这是第一招....\n\n");
    COMBAT_D->do_attack(this_object(), this_player(),
      query_temp("weapon"));
    if ((int)this_player()->query("kee") < 0
      || !present(this_player(), environment())) {

      say("金振夫叹了口气，说道：连第一招都撑不过，真是自不量力....\n");
      return 1;
    }
    say("\n金振夫说道：这是第二招....\n\n");
    COMBAT_D->do_attack(this_object(), this_player(),
      query_temp("weapon"));
    if ((int)this_player()->query("kee") < 0
      || !present(this_player(), environment())) {

      say("金振夫「哼」地一声，说道：便是有这许多不怕死的家伙....\n");
      return 1;
    }
    say("\n金振夫说道：第三招来了....\n\n");
    COMBAT_D->do_attack(this_object(), this_player(),
      query_temp("weapon"));
    if ((int)this_player()->query("kee") < 0
      || !present(this_player(), environment())) {

      say("金振夫叹道：可惜，难道老夫一身武功竟无传人....\n");
      return 1;
    }

    say("\n金振夫哈哈大笑，说道：今日老夫终於觅得一个可造之才！\n\n");
    command("recruit " + this_player()->query("id"));
    this_player()->set("class", "kongtong");
    this_player()->set("id_type", 1);
    return 1;
  }
  return 0;
}
