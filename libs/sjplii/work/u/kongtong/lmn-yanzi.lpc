// Room: /d/waterfog/lmn-yanzi.c

inherit ROOM;

void create()
{
	set("short", "经无命与小燕子的家");
	set("long", @LONG
这里就是经无命和小燕子的家，由于他们夫妻很懒，家里除了一张大床外什
么都没有。
LONG
	);
	set("exits", ([ /* sizeof() == 1 */
  "out" : __DIR__"honggu",
]));
	set("no_clean_up", 0);
	set("valid_startroom",1);
        set("objects", ([
  "/dizi" : 8,
]));
	setup();
}
void init()
{
         add_action("do_open", ({"open"}) );
         add_action("do_close", ({"close"}) );
         add_action("do_down", ({"d","down"}) );
}

int do_open(string arg)
{
	if(arg!="door") return 0;
	if(query("open_door")) 
		write("门已经是开着的。\n");	
        else {
		message_vision("$N轻轻把门打开。\n",this_player());
		set("open_door",1);	
	}
	return 1;
}

int do_close(string arg)
{
	if(arg!="door") return 0;
	if(!query("open_door")) 
		write("门已经是关着的。\n");	
        else {
		message_vision("$N轻轻把门关上。\n",this_player());
		set("open_door",0);	
	}
	return 1;
}

int do_down(string arg)
{
       message_vision( "$N移开一块地板，出现了一个洞，$N走了下去。\n", this_player() );
	   this_player()->move("/new/hangzhou/didi-0");
       message_vision( "$N从上面走了下来。\n", this_player() );
	   return 1;
}

