inherit ITEM;
#include <ansi.h>

void create() {
  set_name(HIG "冰箱" NOR, ({ "bingxiang" }));
  set_weight(50000);
  set_max_encumbrance(30000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("prep", "on");
    set("unit", "个");
    set("long", "一个冰箱，里面一定放着不少好吃的。\n");
    set("value", 1);
    set("no_get", "你是小偷还是搬家公司的？\n");
  }
}
int is_container() { return 1; }
