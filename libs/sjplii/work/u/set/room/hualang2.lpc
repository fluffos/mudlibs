inherit ROOM;
void create()
{
        set("short", "花廊");
        set("long", @LONG
这是连接爱苗轩内各屋的走廊，修竹、齐石、异花妆点着花廊，宛如一条
玉带把爱苗轩连成一个和谐而秀丽的整体，站在花廊，凉风习习，远处鸟语入
耳，进处花香扑鼻。
LONG
        );
        set("exits", ([ /* sizeof() == 2 */
        "north" : "/u/set/room/tiger_room",
        "east" :"/u/set/room/hualang3",
        "west" :"/u/set/room/hualang1",
        "south" :"/u/set/room/huayuan",
        ]));
        set("no_clean_up", 0);
        set("no_fight", "1");
//        set("valid_startroom", 1);
        set("no_spells", "1");
        set("no_magic", "1");
        setup();
}
int valid_leave(object who, string dir)
{
        if( dir=="north" && (who->query("id")!="set") )
        if( dir=="north" && (who->query("id")!="tiger") )
        if( dir=="north" && (who->query("id")!="yuj") )
                return notify_fail("有人一把拉住了你,那里可是人家的新房，万一人家小两口正在种小人(Make Love)，你闯进去多不好...\n");
        return ::valid_leave(who, dir);
}
