// bee.c

inherit NPC;

void create()
{
        set_name("蜜蜂", ({ "bee" }) );
        set("race", "野兽");
        set("age", 1);
        set("long", "一只正在采蜜的大蜜蜂。\n");

        set("limbs", ({ "头部", "身体", "翅膀" }) );
        set("verbs", ({ "bite" }) );
        set("score",100); 

        set_skill("dodge", 100);
        set_skill("unarmed", 3);

        setup();
}

