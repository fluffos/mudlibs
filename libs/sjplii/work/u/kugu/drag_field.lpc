// Room: /d/sanyen/drag_field.c
#include <ansi.h>
inherit ROOM;
int do_plant(string arg);
int complete_plant(object me);

void create() {
  set("short", "药圃");
  set("long", @LONG
一片广阔的药圃, 药香就是从这里散发出来的　这里似乎经过详
细的规划, 一块一块的, 哪边种当归, 哪边种枸杞, 绝不会混在一起
　只是看来看去都只是些寻常的药材, 看不到比较珍贵特殊的。　
LONG
  );
  set("exits", ([ /* sizeof() == 1 */
    "west": __DIR__ "road2",
  ]));
  set("outdoors", "kugu");
  set("no_fight", 1);
  set("hell", 1);
  set("no_study", 1);
  set("no_magic", 1);
  set("no_spells", 1);
  setup();
}
void init() {
  object ob;
  if (interactive(ob = this_player()))
    call_out("complete_plant", random(10) + 3, ob);
  add_action("do_plant", "plant");
  add_action("close_cmds", "fight");
  add_action("close_cmds", "exert");
  add_action("close_cmds", "perform");
}
int close_cmds(object me, string arg) {
  return 1;
}

int do_plant(string arg) {
  object me = this_player();
  if (arg != "herb")
    return notify_fail("你要种什么？\n");
  if (me->query("marks/kgjob") != "hoe")
    return notify_fail("你并没有种植草药的任务。\n");
  if (me->query_temp("plant_herb") > 20)
    return notify_fail("你的工作已经完成了。\n");
  if (me->is_busy())
    return notify_fail("你正忙着呢。\n");
  if (me->query("sen") < 22)
    return notify_fail("你心神不定，无法静下心来种植草药。\n");
  if (!me->query_temp("plant_herb"))
    message_vision(CYN "$N拿出药锄，将泥土翻开，然后把草药药种埋了进去。\n" NOR, me);
  else
    message_vision(CYN "$N将沙土压紧盖实，浇了点肥料，又拿起另一棵草药继续种植。\n
$N拿出药锄，将泥土翻开，然后把草药药种埋了进去。\n" NOR, me);
  me->start_busy(6);
  me->receive_damage("sen", random(20) + 1);
  if (me->query_skill("unarmed", 1) < 20) {
    me->improve_skill("unarmed", random((int)me->query("kar")) + 10);
    me->add("potential", 1);
  }
  me->add("life_exp", random(10) + 1);
  me->set_temp("plant_now", 1);
  return 1;
}
int complete_plant(object ob) {
  int i;
  int damage;
  object herb;
  if (!ob->query_temp("plant_now")) {
    call_out("complete_plant", random(20) + 1, ob);
    return 0;
  }
  if (ob->query_temp("plant_herb") < 20 && environment(ob) == this_object()) {
    tell_object(this_object(), "\n药圃里各种草药生长旺盛，一阵阵药香扑鼻而来。\n");
    ob->add_temp("plant_herb", 1);
    if (environment(ob) == this_object())
      call_out("complete_plant", random(20) + 1, ob);
  } else {
    ob->remove_call_out("complete_plant");
    tell_object(this_object(), CYN "\n你将手中所有的草药都种植了下去，你的任务终于完成了。\n\n" NOR);
    herb = new("/obj/toy/hoe");
    herb->move(ob);
    ob->delete_temp("plant_herb");
    ob->delete_temp("plant_now");
    ob->delete("marks/kgjob");
    //	ob->move("/u/emei/xiaolu22");
  }
  return 1;
}
int valid_leave(object me, string dir) {
  object ob;
  if (me->query_temp("plant_now"))
    return notify_fail("你的种植工作还没有做完，怎么就离开了呢？\n");
  return ::valid_leave(me, dir);
}
