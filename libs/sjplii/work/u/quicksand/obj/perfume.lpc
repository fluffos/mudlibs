
#include <weapon.h>

inherit THROWING;

void create()
{
	set_name("火石", ({ "fire stone","stone" }) );
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long","一块江湖人士点火用的火石。\n");
		set("unit", "堆");
		set("base_unit", "块");
		set("base_weight", 3);
		set("base_value", 200);
	}
	set_amount(1);
	init_throwing(1);
	setup();
}
