inherit ROOM;

void create()
{
	set("short", "试心石");
	set("long", @LONG
这里便是莲花峰的峰顶，由两块巨石勾连在一起，据说若果你
心存诚意，登上试心石时石快便不会动摇，反之则摇动不止。
LONG
	);

	set("exits", ([
		"southdown" : __DIR__"lianhua",
	]));
	set("objects",([
		__DIR__"npc/tianzi" : 1,
		__DIR__"npc/dizi" : 1,
		__DIR__"npc/renzi" : 1,
	]));

	set("outdoors", "taishan");
	setup();
//	replace_program(ROOM);
}

int valid_leave(object me, string dir)
{
        if ( me->query_temp("taishan/jianzhen") )
	me->delete_temp("taishan/jianzhen");
	return ::valid_leave(me, dir);
}
