inherit ITEM;

void create()
{
        set_name("蘑菇", ({ "mushroom" , "蘑菇"}) );
        set_weight(5);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("unit", "个");
                set("long", "白白胖胖的蘑菇。 \n");
                set("value", 1);
        }
}

