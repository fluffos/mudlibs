
inherit NPC;

void create()
{
        set_name("李云芳", ({ "li yunfang", "li" }) );
        set("gender", "女性");
        set("age", 20);
        set("long",
"李云芳是峨眉派女弟子中比较杰出的人物。\n"  );
        set("inquiry", ([
                "here": "这里就是峨眉派。",
        ]) ); 
        set("attitude", "peaceful");
        set("class","emei");
	set("max_kee", 600);
	set("max_gin", 600);
	set("max_sen", 600);
	set("kee", 600);
	set("gin", 600);
	set("sen", 600);

        set("force", 600);
        set("max_force", 600);
        set("force_factor",10);
        set("combat_exp",300000);
        set("score",3000);

        set_skill("dodge", 40);
        set_skill("move", 40);
        set_skill("literate", 20);
        set_skill("parry", 40);
        set_skill("unarmed", 40);
        set_skill("force", 40);
        set_skill("sword", 40);
        set_skill("buddhism", 20);
        set_skill("foben_jing", 20);
        set_skill("magic", 20);

        set_skill("wind_sword",40);
        set_skill("mian_strike", 40);
        set_skill("taiqing_force", 40);
        set_skill("ganchan_steps", 40);

        map_skill("dodge", "ganchan_steps");
        map_skill("unarmed", "mian_strike");
        map_skill("force", "taiqing_force");
        map_skill("parry", "wind_sword");
        map_skill("sword", "wind_sword");
        create_family("峨眉派", 8, "弟子");
        set("chat_chance", 10);
        set("chat_msg", ({
                "李云芳对着你嫣然一笑。\n",
                (:random_move :)
        }) );

        setup();

//        carry_object("/obj/longsword")->wield();
        carry_object(__DIR__"obj/daopao")->wear();
}



