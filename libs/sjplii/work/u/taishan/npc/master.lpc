#include <ansi.h>
inherit NPC;
inherit F_MASTER;
int do_detect(object me);
void create() {
  set_name("南山野叟", ({ "master yesou", "yesou", "master", "taohua" }));
  set("title", "武林三逸");
  set("gender", "男性");
  set("age", 86);
  set("long",
    "南山野叟是传说中的武林三逸之一，胸罗万有，是武林前辈中的一代宗匠。\n");
  set("attitude", "peaceful");
  set("str", 50);
  set("int", 30);
  set("cor", 30);
  set("spi", 30);
  set("max_kee", 5000);
  set("max_gin", 5000);
  set("max_sen", 5000);
  set("kee", 5000);
  set("gin", 5000);
  set("sen", 5000);

  set("force", 5000);
  set("max_force", 5000);
  set("force_factor", 50);

  set("combat_exp", 50000000);
  set("score", 60000);
  set_temp("apply/attack", 30);
  set_temp("apply/defense", 30);
  set_temp("apply/move", 30);

  set_skill("dodge", 300);
  set_skill("move", 250);
  set_skill("literate", 250);
  set_skill("parry", 300);
  set_skill("unarmed", 300);
  set_skill("force", 300);
  set_skill("sword", 300);

  set_skill("luoying_sword", 300);
  set_skill("tenderzhi", 300);
  set_skill("liheforce", 300);
  set_skill("zhengqijue", 300);
  set_skill("luohua_steps", 300);
  set_skill("sanqing-jian", 250);

  map_skill("dodge", "luohua_steps");
  map_skill("unarmed", "tenderzhi");
  map_skill("force", "liheforce");
  map_skill("parry", "luoying_sword");
  map_skill("sword", "luoying_sword");
  create_family("桃花岛", 1, "掌门");
  set("class", "taohua");
  set("chat_chance", 1);
  set("chat_msg", ({
    (: do_detect :),
  }));

  setup();
  carry_object("/obj/longsword")->wield();
  carry_object("/obj/cloth")->wear();
}

void attempt_apprentice(object ob) {
  if (ob->query("class") != "taohua") {
    command("say 这位" + RANK_D->query_respect(ob) + "还是去拜在下的弟子吧。\n");
    return;
  }

  if (ob->query_skill("liheforce", 1) < 150) {
    command("say 你离合神功修为尚浅，还是再多下点功夫吧！\n");
    return;
  }
  command("smile");
  command("say 好吧，" + RANK_D->query_respect(ob) + "以后要勤习武功，为武林伸张正义！\n");
  command("recruit " + ob->query("id"));
}

void recruit_apprentice(object ob) {
  if (::recruit_apprentice(ob))
    ob->set("class", "taohua");
  ob->set("id_type", 1);
}

int do_detect(object me) {
  me = this_object();
  say("\n南山野叟的身影闪了闪，转眼消失不见了。\n");
  destruct(me);
  return 1;
}
