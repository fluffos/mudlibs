#include <ansi.h>

inherit NPC;
inherit F_MASTER;
string	summon_more( object who);

void create()
{
        set_name("谢九峰", ({ "xie jiufeng", "xie","master" }) );
        set("gender", "男性");
        set("age", 21);
        set("long",
"谢九峰是裘剑飞的弟子，被称为“天门三剑”之一。\n"  );
	set("nickname", HIR "朝阳剑" NOR);
        set("inquiry", ([
                "here": "这里就是泰山派。",
        ]) ); 
        set("attitude", "peaceful");
        set("class","taishan");
        set("str", 25);
        set("int", 22);
        set("spi", 25);
        set("per", 23);
        set("cps", 23);
	set("max_kee", 900);
	set("max_gin", 900);
	set("max_sen", 900);
	set("kee", 900);
	set("gin", 900);
	set("sen", 900);

        set("force", 1200);
        set("max_force", 1200);
        set("force_factor",20);
        set("combat_exp",700000);
        set("score",200);

        set_skill("dodge", 90);
        set_skill("move", 90);
        set_skill("literate", 90);
        set_skill("parry", 160);
        set_skill("unarmed", 90);
        set_skill("force", 90);
        set_skill("sword", 160);

        set_skill("three-sword",160);
        set_skill("pine_strike", 90);
        set_skill("liumai_force", 90);
        set_skill("star_dodge", 90);

        map_skill("dodge", "star_dodge");
        map_skill("unarmed", "pine_strike");
        map_skill("force", "liumai_force");
        map_skill("parry", "three-sword");
        map_skill("sword", "three-sword");
        set("chat_chance_combat", 50);
        set("chat_msg_combat", ({
		(: summon_more(this_object()) :),
        }) );
        create_family("泰山派", 2, "弟子");

        setup();

        carry_object(__DIR__"obj/hong_sword")->wield();
        carry_object("/obj/cloth")->wear();
}

void attempt_apprentice(object ob)
{
      if(ob->query("class")!="taishan") {
	    command("say 这位" + RANK_D->query_respect(ob) + "还是去拜其他剑门弟子吧。\n");
	    return;
	}
      if(ob->query("gender")!="男性") {
	    command("say 这位" + RANK_D->query_respect(ob) + "还是去拜我的师姐吧。\n");
	    return;
	}

      if(ob->query_skill("three-sword",1)<60) {
	    command("say 你的本门剑法修为尚浅，拜师之事还是以后再说吧。\n");
	    return;
	}	
      command("smile");
      command("say 好吧，" + RANK_D->query_respect(ob) + "以后要更加勤习武功，把泰山发扬光大！\n");
      command("recruit " + ob->query("id") );
}

void recruit_apprentice(object ob)
{
        if( ::recruit_apprentice(ob) )
                ob->set("class", "taishan");
                ob->set("id_type", 1);
}
string summon_more(object who)
{
	int i;
	object *enemy;
	object another;
	seteuid(getuid());
	another = new(__DIR__"tsdizi2");
	if( (int)who->query_temp("summon_more") > 2)  return "　";
	another->move(environment(who));
	message_vision(another->name()+ "走了过来。\n"
		, this_object() );
	who->add_temp("summon_more",1);
	enemy = who->query_enemy();
	i = sizeof(enemy);
	while(i--) {
		if( enemy[i] && living(enemy[i]) ) {
			another->kill_ob(enemy[i]);
			enemy[i]->kill_ob(another);
			another->set_leader(enemy[i]);
		}
	}
	return "1";
}
int accept_fight(object me)
{
	command("say 请不要在这里惹是生非。");
        return 0;
}


