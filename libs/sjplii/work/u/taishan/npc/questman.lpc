#include <ansi.h>
inherit NPC;
int about_quest();
string *names = ({
  "兽骨甲",
  "金环锁子甲",
  "牛皮盾",
  "狼皮裙",
  "藤甲",
  "铁甲",
  "熟铜甲",
  "亮银甲",
 });

void create()
{
	set_name("尉迟平", ({ "ling yun","ling", "yun" }));
	set("long",
	    "这是一个四十多岁的剑客, 精神矍铄，威风凛凛。\n"+
	    "他是泰山掌门的好朋友，你可以向他申请任务。\n");
	set("title", "普通百姓");
	set("gender", "男性");
	set("age", 44);
	set("nickname", HIR "长剑飞虹" NOR);
	set("shen_type",1);
	set("attitude", "peaceful");

        set("str", 30);
        set("int", 30);
        set("cor", 30);
        set("spi", 30);
	set("max_kee", 9000);
	set("max_gin", 9000);
	set("max_sen", 9000);
	set("kee", 9000);
	set("gin", 9000);
	set("sen", 9000);

        set("force", 1000);
        set("max_force", 1000);
        set("force_factor", 20);

        set("mana", 2000);
        set("max_mana", 2000);

        set("inquiry", ([
                "quest" : (: about_quest :),
        ]));

        set("combat_exp", 7000000);
        set("score", 20000);

        set_skill("dodge", 250);
        set_skill("move", 200);
        set_skill("literate", 180);
        set_skill("parry", 200);
        set_skill("unarmed", 250);
        set_skill("force", 250);
        set_skill("sword", 250);

        set_skill("sanqing-jian",250);
        set_skill("pine_strike", 250);
        set_skill("liumai_force", 250);
        set_skill("star_dodge", 250);

        map_skill("dodge", "star_dodge");
        map_skill("unarmed", "pine_strike");
        map_skill("force", "liumai_force");
        map_skill("parry", "sanqing-jian");
        map_skill("sword", "sanqing-jian");
	setup();
        carry_object("/obj/longsword")->wield();
        carry_object("/obj/cloth")->wear();
}

void init()
{
	add_action("do_cancel", "cancel");
}

int do_cancel(string arg)
{
	object me=this_player();
	if(!arg || arg!="quest")
          return notify_fail("你要取消什么？\n");
	if (!me->query("marks/tsjob"))
          return notify_fail("你现在没有任务。\n");
	say( CYN"尉迟平叹道：不想做了吗？好吧，你自己反省一下。\n"NOR);
	if( (int)me->query("combat_exp") <= 100 ) 
		{
			me->delete("marks/tsjob");
			me->unconcious();
			return 1;
		}
	me->add("combat_exp", -random(100));
	me->delete("marks/tsjob");
	me->unconcious();
	return 1;
}

int about_quest()
{
	int task;
	object me=this_player();
	string questname = names[random(sizeof(names))];
	if (!me->query("marks/tsjob"))
	{
	say( CYN"尉迟平说道：我想要［" + questname + "］，你去给我找来。\n"NOR);
	me->set("marks/tsjob",questname);
	return 1;
	}
	else{
	command("say 你还站在这里干什么？好好用功才是啊！");
	return 1;
	}
	return 1;
}

int accept_object(object who, object ob)
{
	int exp,pot;
	object me;
	me = this_player();
	exp = (int) me->query("combat_exp");
	pot = (int) me->query("potential");
	if( ob->name() == (string)me->query("marks/tsjob") ) {
		say( CYN"尉迟平微笑点头，说道：很好，继续努力。\n"NOR);
		me->set("combat_exp", (int) exp + random(50) + 30);
		me->set("potential", (int) pot + random(50) + 30);
		me->add("score", random(20));
		me->add("life_exp", random(20));
		me->delete("marks/tsjob");
		return 1;
		}
	else{
		say(CYN"尉迟平说道：多谢你的好意，但这东西对我没用。\n"NOR);
		return 0;
	}
        return 1;
}
int accept_fight(object me)
{
        return 0;
}
