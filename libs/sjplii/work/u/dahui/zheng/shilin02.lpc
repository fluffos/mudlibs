// more /d/evilland/evil00.c
inherit ROOM;
//int do_gogo(string dir);

void create ()
{
        int i;
        set("short", "蜀南溶洞");
        set("long", @LONG
溶洞以卧虎岭下的天泉洞最著名。主洞长一千三百余米，可容万人，
洞顶的钟乳石，琳琅满目。主洞两旁有耳洞、吊洞、风洞等十多个大溶洞
，形成洞中有洞、洞下有洞的奇观。洞内有深不见底的“阴河”，河中生
活着灰白透明的小鱼，俗称玻璃鱼，出洞见光即死。
    这里明显的出口是 south、north、west、east 和 down 。
LONG);

	set("hell",1);
	set("auto_maps",1);
	set("master_xyz",random(90)*10+0);
	set("next_exit_xyz",random(90)*10+0);

       set("objects",([
                      __DIR__"npc/master11" : 1,
                      __DIR__"npc/master12" : 1,
                      __DIR__"npc/master13" : 1,
                ]));

        setup();
}

void init()
{
	add_action("do_gogo", "go");
}

int do_gogo(string dir)
{
	object me, room;
	me=this_player();
	me->set("map_xyz",000);
	if( !dir )
                return notify_fail("你要往哪里去？\n");

       switch(dir){
       case "north":
			me->add("map_xyz",10);
			room=new(__DIR__"shilin01.lpc");
			break;
       case "south":
			me->add("map_xyz",-10);
			room=new(__DIR__"shilin01.lpc");
			break;
       case "east":
			me->add("map_xyz",100);
			room=new(__DIR__"shilin01.lpc");
			break;
       case "west":
			me->add("map_xyz",-100);
			room=new(__DIR__"shilin01.lpc");
			break;
       case "down":
			room=new(__DIR__"shilin10.lpc");
			break;
	default:
	}

       if( dir=="up" || !room )
                return notify_fail("这里没有这个方向的出口。\n");
	me->move(room);
	write("\n你走了过来。\n");
	destruct(this_object());
	return 1;
}

