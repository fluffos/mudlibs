// oop.c
inherit NPC;
#include <ansi.h> 

void create()
{
        set_name("闪电客", ({ "oop" }) );
        set("gender", "男性");
        set("age",29);
        set("title", "华山派大师兄");
        set("nickname", WHT"华山三英"NOR);
        set("long",@LONG
闪电客相貌英俊，武功高强，乃是华山新一代中的好手。和其师傅也
不相上下。是人称“华山三英”之首，平时一般都是由其代师传艺。
LONG
        );
        set("attitude", "peaceful");
        set("int", 25);
        set("cor", 25);
        set("agi", 25);
        set("con", 20);
        set("str", 20);
        set("tol", 20);
        set("spi", 15);
        set("dur", 20);
        set("per", 30);
        set("fle", 15);
        set("cps", 20);
        set("max_force", 2400);
        set("force", 4000);
        set("force_factor", 60);
        set("combat_exp", 1000000);
        set("score", 40000);
//      set("daode", 49000);

        set("book_count", 1);

        set("chat_chance_combat", 70);
        set("chat_msg_combat", ({
        (: perform_action, "sword.taiyue" :),
        }) );
        set_skill("dodge", 150);
        set_skill("move", 150);
        set_skill("parry", 160);
        set_skill("sword", 160);
        set_skill("force", 150);
        set_skill("unarmed", 100);
        set_skill("literate", 110);
        set_skill("hs-zhengqi", 120);
        set_skill("huashan-force", 150);
        set_skill("zixia-shengong", 120);
        set_skill("huashan-sword", 160);
        set_skill("huashan-strike", 140);
        set_skill("tianluo-steps", 150);

        set("perform/huashan/taiyue",1000);  //perform lv=1

        map_skill("sword", "huashan-sword");
        map_skill("parry", "huashan-sword");
        map_skill("force", "zixia-shengong");
        map_skill("unarmed", "huashan-strike");
        map_skill("dodge", "tianluo-steps");

        create_family("华山派", 16, "弟子");

        setup();
        carry_object(__DIR__"weapon/sword");
        carry_object(__DIR__"obj/jinzhuang")->wear();
}
void die()
{
	int exp,pot,score;
        object killer,victim;

        if ( !killer=query_temp("last_damage_from") )
             killer=this_player(1);

	if(!victim) victim = this_object();

	if( !userp(victim) && victim->query("NKreward_MASTER")) {	
	 exp = random(victim->query("combat_exp") - killer->query("combat_exp"))/100;
	 pot = random(exp)/2;
	 if( exp <= 0 )  exp=20;
	 if( pot <= 0 )  pot=10;
	 if( exp > 2000 )  exp=2000;
	 if( pot > 1000 )  pot=1000;
	 score = random(pot/100) +1;
	 if( killer->query("id_type")!= victim->query("id_type") )
	 {
        killer->add("combat_exp", exp);
        killer->add("potential", pot);
        killer->add("life_exp", score);
        killer->add("score", score);
        tell_object(killer,HIY"你获得了：\n" +
        chinese_number(exp) + "点经验\n"+
        chinese_number(pot) + "点潜能\n" +
        chinese_number(score)+"点江湖阅历\n" +
        chinese_number(score)+"点声望\n"NOR);
	 }
	}
        ::die();
}

