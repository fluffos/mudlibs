// xufang.c 藏经阁 虚方

inherit NPC;
inherit F_MASTER;

void create()
{
	set_name("虚方", ({"xu fang master","xu fang","master",}));
	set("long",
		"这是一位看起来文质彬彬的僧人，可能是主持藏经阁的原因。\n"
	);


	set("gender", "男性");
	set("attitude", "heroism");
	set("class", "shaolin1");

	set("inquiry",([
		"智上大师" : "智上大师你都不知道？他是我的师傅，是[证道院]首座！\n",
		"慧能" : "你说慧能呀，他是我的得意弟子，主持心禅堂。\n",
	]));

	set("age", 40);

	set("max_gin", 700);
	set("max_kee", 1500);
	set("max_sen", 700);
	set("force", 3000);
	set("max_force", 2000);
	set("force_factor", 60 );
	set("combat_exp", 2000000);



	set_skill("force", 150);
	set_skill("shaoyang_force", 150);
	set_skill("dodge", 150);
	set_skill("shaolin-dodge", 150);
	set_skill("stick", 150);
	set_skill("parry", 150);
	set_skill("unarmed", 150);
	set_skill("sanhua-strike", 150);
	set_skill("hammer", 150);
	set_skill("zui_stick", 150);
	set_skill("fanwen", 70);
//	set_skill("essencemagic", 140);
	set_skill("buddhism", 140);
	set_skill("magic", 70);
	set_skill("literate", 70);

	map_skill("force", "shaoyang_force");
	map_skill("dodge", "shaolin-dodge");
	map_skill("unarmed", "sanhua-strike");
	map_skill("parry", "zui_stick");
	map_skill("stick", "zui_stick");

	set("title","少林寺藏经阁首座");
	create_family("少林寺", 7, "弟子");
	set("no_teach",1);

	setup();
	carry_object(__DIR__"weapon/stick")->wield();
	carry_object(__DIR__"obj/qing_jiasha")->wear();
}

void die()
{
	int exp,pot,score;
        object killer,victim;

        if ( !killer=query_temp("last_damage_from") )
             killer=this_player(1);

	if(!victim) victim = this_object();

	if( !userp(victim) && victim->query("NKreward_MASTER")) {	
	 exp = random(victim->query("combat_exp") - killer->query("combat_exp"))/100;
	 pot = random(exp)/2;
	 if( exp <= 0 )  exp=20;
	 if( pot <= 0 )  pot=10;
	 if( exp > 2000 )  exp=2000;
	 if( pot > 1000 )  pot=1000;
	 score = random(pot/100) +1;
	 if( killer->query("id_type")!= victim->query("id_type") )
	 {
        killer->add("combat_exp", exp);
        killer->add("potential", pot);
        killer->add("life_exp", score);
        killer->add("score", score);
        tell_object(killer,HIY"你获得了：\n" +
        chinese_number(exp) + "点经验\n"+
        chinese_number(pot) + "点潜能\n" +
        chinese_number(score)+"点江湖阅历\n" +
        chinese_number(score)+"点声望\n"NOR);
	 }
	}
        ::die();
}

