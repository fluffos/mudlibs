// jingsi.c 菩提院 静思

inherit NPC;
inherit F_MASTER;

void create()
{
	set_name("静思", ({"jing si master","jing si","master",}));
	set("long",
		"这是一位精神矍铄的老僧，两边太阳穴微微凸起，显然是内外兼修。\n"
	);


	set("gender", "男性");
	set("attitude", "heroism");
	set("class", "shaolin1");

	set("inquiry",([
		"明光大师" : "明光你都不知道？他是我的师傅，是[舍利院]首座！\n",
		"智上" : "你说智上呀，他是我的得意弟子，主持证道院。\n",
	]));

	set("age", 60);

	set("max_gin", 800);
	set("max_kee", 2000);
	set("max_sen", 800);
	set("force", 5000);
	set("max_force", 3000);
	set("force_factor", 100 );
	set("combat_exp", 3000000);



	set_skill("force", 200);
	set_skill("luohan_force", 200);
	set_skill("dodge", 200);
	set_skill("shaolin-dodge", 200);
	set_skill("fumo_chan", 200);
	set_skill("staff", 200);
	set_skill("qianyeshou", 200);
	set_skill("parry", 200);
	set_skill("unarmed", 200);
	set_skill("stick", 200);
	set_skill("hammer", 200);
	set_skill("zuochanshu", 90);
	set_skill("essencemagic", 90);
	set_skill("buddhism", 180);
	set_skill("magic",90);
	set_skill("literate", 90);

	map_skill("force", "luohan_force");
	map_skill("dodge", "shaolin-dodge");
	map_skill("staff", "fumo_chan");
	map_skill("unarmed", "qianyeshou");

	set("title","少林寺菩提院首座");
	create_family("少林寺", 5, "弟子");
	set("no_teach",1);
	set("family/privs",1);

	setup();
	carry_object(__DIR__"weapon/staff")->wield();
	carry_object(__DIR__"obj/qing_jiasha")->wear();
}

void die()
{
	int exp,pot,score;
        object killer,victim;

        if ( !killer=query_temp("last_damage_from") )
             killer=this_player(1);

	if(!victim) victim = this_object();

	if( !userp(victim) && victim->query("NKreward_MASTER")) {	
	 exp = random(victim->query("combat_exp") - killer->query("combat_exp"))/100;
	 pot = random(exp)/2;
	 if( exp <= 0 )  exp=20;
	 if( pot <= 0 )  pot=10;
	 if( exp > 2000 )  exp=2000;
	 if( pot > 1000 )  pot=1000;
	 score = random(pot/100) +1;
	 if( killer->query("id_type")!= victim->query("id_type") )
	 {
        killer->add("combat_exp", exp);
        killer->add("potential", pot);
        killer->add("life_exp", score);
        killer->add("score", score);
        tell_object(killer,HIY"你获得了：\n" +
        chinese_number(exp) + "点经验\n"+
        chinese_number(pot) + "点潜能\n" +
        chinese_number(score)+"点江湖阅历\n" +
        chinese_number(score)+"点声望\n"NOR);
	 }
	}
        ::die();
}

