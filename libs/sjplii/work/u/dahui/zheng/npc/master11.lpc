#include <ansi.h>
inherit NPC;
inherit F_MASTER;

void create()
{
	set_name("邱震海", ({ "master qiu", "qiu","master" }) );
	set("title", "红旗镖局总镖头" );
	set("nickname", HIR "红旗铁枪震中州" NOR);
	set("gender", "男性" );
	set("age", 64);
        set("NKreward_MASTER", 1);
	set("str", 30);
	set("int", 30);
	set("cor", 30);
	set("spi", 30);
	set("agi", 30);
	set("max_kee", 900);
	set("max_gin", 900);
	set("max_sen", 900);
	set("kee", 900);
	set("gin", 900);
	set("sen", 900);
	set("class", "biaoju");
        set("force", 2000);
        set("max_force", 2000);
        set("force_factor", 20);
        set("score", 10000);
	set("id_type",1);
	set("combat_exp", 3500000);
	set_temp("apply/attack", 30);
	set_temp("apply/defense", 30);
	set_temp("apply/move", 30);
	set_temp("apply/damage",30);

        create_family("红旗镖局", 2, "局主");
	set("long",
"红旗铁枪邱震海是红旗镖局创始人司马中天的关门弟子，人不但性情豪爽，且广交朋友.
 凡是想向他求教的，只要为镖局出点力，他就肯教．\n"
		);
	set("attitude", "peaceful");
	set_skill("unarmed", 200);
	set_skill("yuanyang_tui", 180);
	set_skill("literate", 60);
	set_skill("force", 190);
	set_skill("move",120);
	set_skill("dodge",160);
	set_skill("parry",180);
	set_skill("spear",220);
	set_skill("chaos-steps",180);
	set_skill("bainiao_spear",210);
	set_skill("bixueforce",170);
	map_skill("unarmed", "yuanyang_tui");
	map_skill("force", "bixueforce");
	map_skill("spear", "bainiao_spear");
	map_skill("parry", "bainiao_spear");
	map_skill("dodge", "chaos-steps");
	setup();
	carry_object(__DIR__"obj/jinzhuang")->wear();
	carry_object(__DIR__"weapon/spear")->wield();
}

void die()
{
	int exp,pot,score;
        object killer,victim;

        if ( !killer=query_temp("last_damage_from") )
             killer=this_player(1);

	if(!victim) victim = this_object();

	if( !userp(victim) && victim->query("NKreward_MASTER")) {	
	 exp = random(victim->query("combat_exp") - killer->query("combat_exp"))/100;
	 pot = random(exp)/2;
	 if( exp <= 0 )  exp=20;
	 if( pot <= 0 )  pot=10;
	 if( exp > 2000 )  exp=2000;
	 if( pot > 1000 )  pot=1000;
	 score = random(pot/100) +1;
	 if( killer->query("id_type")!= victim->query("id_type") )
	 {
        killer->add("combat_exp", exp);
        killer->add("potential", pot);
        killer->add("life_exp", score);
        killer->add("score", score);
        tell_object(killer,HIY"你获得了：\n" +
        chinese_number(exp) + "点经验\n"+
        chinese_number(pot) + "点潜能\n" +
        chinese_number(score)+"点江湖阅历\n" +
        chinese_number(score)+"点声望\n"NOR);
	 }
	}
        ::die();
}

