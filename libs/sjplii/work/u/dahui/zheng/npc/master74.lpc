// mengxiance

#include <ansi.h>
inherit NPC;

void create()
{
        set_name("玉池若明", ({ "yuchi ruoming", "master", "ruoming" }) );
        set("nickname", HIW "白面书生" NOR);
        set("title", "丐帮大智分舵舵主");
        set("gender", "男性");
        set("age", 35);
        set("long",
 "他就是丐帮大智分舵的舵主。\n");
        set("inquiry", ([
                "拜师": "问那么多干吗，快拜师吧！",
                "古董": "你听说过吗？商代玉镯是十分昂贵的！",
                "喜好": "我爱收集天下的古董。",
                "钥匙": "你问那么多干吗？",
        ]) ); 
        set("max_kee", 2000);
        set("kee", 2000);
        set("force", 2000);
        set("max_force", 2000);
        set("force_factor",80);
        set("combat_exp",300000);

        set_skill("unarmed", 140);
        set_skill("force", 140);
        set_skill("parry", 140);
        set_skill("dodge", 140);
        set_skill("begging", 140);

        set_skill("iron_strike", 140);
        set_skill("xianglong_strike", 120);
        set_skill("hidden_dodge", 140);
        set_skill("canyun_force", 140);
        set_skill("literate", 120);

        map_skill("dodge", "hidden_dodge");
        map_skill("unarmed", "xianglong_strike");
        map_skill("force", "canyun_force");

        create_family("丐帮", 5, "弟子");

        setup();
        carry_object(__DIR__"obj/jingyi")->wear();
}

void die()
{
	int exp,pot,score;
        object killer,victim;

        if ( !killer=query_temp("last_damage_from") )
             killer=this_player(1);

	if(!victim) victim = this_object();

	if( !userp(victim) && victim->query("NKreward_MASTER")) {	
	 exp = random(victim->query("combat_exp") - killer->query("combat_exp"))/100;
	 pot = random(exp)/2;
	 if( exp <= 0 )  exp=20;
	 if( pot <= 0 )  pot=10;
	 if( exp > 2000 )  exp=2000;
	 if( pot > 1000 )  pot=1000;
	 score = random(pot/100) +1;
	 if( killer->query("id_type")!= victim->query("id_type") )
	 {
        killer->add("combat_exp", exp);
        killer->add("potential", pot);
        killer->add("life_exp", score);
        killer->add("score", score);
        tell_object(killer,HIY"你获得了：\n" +
        chinese_number(exp) + "点经验\n"+
        chinese_number(pot) + "点潜能\n" +
        chinese_number(score)+"点江湖阅历\n" +
        chinese_number(score)+"点声望\n"NOR);
	 }
	}
        ::die();
}

