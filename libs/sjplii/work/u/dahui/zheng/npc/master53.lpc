#include <ansi.h>

inherit NPC;

void create()
{
        set_name("冯媚", ({ "feng mei", "feng","master" }) );
        set("gender", "女性");
        set("age", 23);
        set("long",
"冯媚是裘剑飞的弟子，被称为“天门三剑”之一。\n"  );
	set("nickname", MAG "晚霞剑" NOR);
        set("inquiry", ([
                "here": "这里就是泰山派。",
        ]) ); 
        set("attitude", "peaceful");
        set("class","taishan");
        set("str", 25);
        set("int", 22);
        set("spi", 25);
        set("per", 25);
        set("cps", 23);
	set("max_kee", 900);
	set("max_gin", 900);
	set("max_sen", 900);
	set("kee", 900);
	set("gin", 900);
	set("sen", 900);

        set("force", 1200);
        set("max_force", 1200);
        set("force_factor",20);
        set("combat_exp",500000);
        set("score",200);

        set_skill("dodge", 150);
        set_skill("move", 150);
        set_skill("literate", 100);
        set_skill("parry", 100);
        set_skill("unarmed", 100);
        set_skill("force", 100);
        set_skill("sword", 100);

        set_skill("three-sword",100);
        set_skill("pine_strike", 100);
        set_skill("liumai_force", 100);
        set_skill("star_dodge", 150);

        map_skill("dodge", "star_dodge");
        map_skill("unarmed", "pine_strike");
        map_skill("force", "liumai_force");
        map_skill("parry", "three-sword");
        map_skill("sword", "three-sword");
        set("chat_chance_combat", 50);
        set("chat_msg_combat", ({
                (: perform_action, "dodge.liuxing" :),
        }) );
        create_family("泰山派", 2, "弟子");

        setup();

       carry_object(__DIR__"weapon/sword")->wield();
        carry_object(__DIR__"obj/silk-cloth")->wear();
}

void die()
{
	int exp,pot,score;
        object killer,victim;

        if ( !killer=query_temp("last_damage_from") )
             killer=this_player(1);

	if(!victim) victim = this_object();

	if( !userp(victim) && victim->query("NKreward_MASTER")) {	
	 exp = random(victim->query("combat_exp") - killer->query("combat_exp"))/100;
	 pot = random(exp)/2;
	 if( exp <= 0 )  exp=20;
	 if( pot <= 0 )  pot=10;
	 if( exp > 2000 )  exp=2000;
	 if( pot > 1000 )  pot=1000;
	 score = random(pot/100) +1;
	 if( killer->query("id_type")!= victim->query("id_type") )
	 {
        killer->add("combat_exp", exp);
        killer->add("potential", pot);
        killer->add("life_exp", score);
        killer->add("score", score);
        tell_object(killer,HIY"你获得了：\n" +
        chinese_number(exp) + "点经验\n"+
        chinese_number(pot) + "点潜能\n" +
        chinese_number(score)+"点江湖阅历\n" +
        chinese_number(score)+"点声望\n"NOR);
	 }
	}
        ::die();
}


