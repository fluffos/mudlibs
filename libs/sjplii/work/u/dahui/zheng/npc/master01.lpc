// minghui.c 达摩院 明晦

inherit NPC;
inherit F_MASTER;

void create()
{
	set_name("明晦", ({"ming hui master","ming hui","master",}));
	set("long",
		"这是一位面目清瘦的老僧人，端坐在蒲团上。\n"
	);


	set("gender", "男性");
	set("attitude", "heroism");
	set("class", "shaolin");

	set("inquiry",([
		"空见大师" : "空见大师你都不知道？他是我的师傅，是少林寺的现任方丈！\n",
		"静平" : "你说静平呀，他是我的得意弟子，主持罗汉堂。\n",
	]));

	set("age", 60);

	set("max_gin", 1500);
	set("max_kee", 3000);
	set("max_sen", 1500);
	set("force", 8000);
	set("max_force", 4000);
	set("force_factor", 120 );
	set("combat_exp", 6000000);

	set_skill("force", 250);
	set_skill("damo-force", 250);
	set_skill("dodge", 250);
	set_skill("shaolin-dodge", 250);
	set_skill("stick", 250);
	set_skill("banruo-strike", 250);
	set_skill("parry", 250);
	set_skill("unarmed", 250);
	set_skill("sword", 250);
	set_skill("damo-sword", 250);
	set_skill("qianyeshou", 250);

	set_skill("essencemagic", 120);
	set_skill("buddhism", 200);
	set_skill("magic", 120);
	set_skill("literate", 100);
	set_skill("fanwen", 120);
	map_skill("force", "damo-force");
	map_skill("dodge", "shaolin-dodge");
	map_skill("unarmed", "banruo-strike");
	map_skill("parry", "damo-sword");
	map_skill("sword", "damo-sword");

    set_temp("apply/attack", 20);
    set_temp("apply/defense", 20);

	set("title","少林寺达摩院首座");
	create_family("少林寺", 4, "弟子");
	set("no_teach",1);
	set("family/privs",1);

	setup();
	carry_object(__DIR__"weapon/sword")->wield();
	carry_object(__DIR__"obj/qing_jiasha")->wear();
}

void die()
{
	int exp,pot,score;
        object killer,victim;

        if ( !killer=query_temp("last_damage_from") )
             killer=this_player(1);

	if(!victim) victim = this_object();

	if( !userp(victim) && victim->query("NKreward_MASTER")) {	
	 exp = random(victim->query("combat_exp") - killer->query("combat_exp"))/100;
	 pot = random(exp)/2;
	 if( exp <= 0 )  exp=20;
	 if( pot <= 0 )  pot=10;
	 if( exp > 2000 )  exp=2000;
	 if( pot > 1000 )  pot=1000;
	 score = random(pot/100) +1;
	 if( killer->query("id_type")!= victim->query("id_type") )
	 {
        killer->add("combat_exp", exp);
        killer->add("potential", pot);
        killer->add("life_exp", score);
        killer->add("score", score);
        tell_object(killer,HIY"你获得了：\n" +
        chinese_number(exp) + "点经验\n"+
        chinese_number(pot) + "点潜能\n" +
        chinese_number(score)+"点江湖阅历\n" +
        chinese_number(score)+"点声望\n"NOR);
	 }
	}
        ::die();
}

