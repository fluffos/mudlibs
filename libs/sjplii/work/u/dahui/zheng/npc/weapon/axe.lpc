// magic_weapon  created by Baiwt@Sjpl 07/11/1999
#include <ansi.h>

#include <weapon.h>

inherit AXE;

void create()
{
      string *order1 = ({"勇敢", "神圣", "荣耀", "祝福", "凯旋", "幻影", "乙木","空冥",
"正义", "胜利", "蟒蛇", "巨龙", "火焰", "神水", "土行", "天雷", "地狱", "太古", "追风" });
	string *order2 = ({"战士", "武士", "上人", "王者", "圣者",
"大师", "大士", "郎君", "侠客", "使者"});
	string *order3 = ({"金斧", "银斧", "铜斧", "铁斧", "锡斧",
"铅斧", "钢斧", "木斧", "竹斧", "板斧"});
      set_name( HIC + order1[random(18)] + order2[random(9)]+ HIG + order3[random(9)]+ NOR, ({ "axe" }) );
	set_weight(8000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "把");
		set("long", "这是一把锋利的斧子，砍起东西来非常顺手。\n");

		set("m_ap_rank",1);
		set("m_dp_rank",6);
		set("value", random(5)*random(100)*100 + 1000);

		set("wield_msg", "$N拿出一把$n，握在手中当作武器。\n");
		set("unwield_msg", "$N放下手中的$n。\n");
	}
	init_axe(random(90)+10);
	setup();
}
