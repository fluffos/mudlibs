// magic_weapon  created by Baiwt@Sjpl 07/11/1999
#include <ansi.h>
#include <weapon.h>

inherit STAFF;

void create() {
  string *order1 = ({ "勇敢", "神圣", "荣耀", "祝福", "凯旋", "幻影", "乙木", "空冥",
    "正义", "胜利", "蟒蛇", "巨龙", "火焰", "神水", "土行", "天雷", "地狱", "太古", "追风" });
  string *order2 = ({ "战士", "武士", "上人", "王者", "圣者",
    "大师", "大士", "郎君", "侠客", "使者" });
  string *order3 = ({ "金杖", "银杖", "铜杖", "铁杖", "龙头杖", "紫藤杖", "锡杖",
    "月牙铲", "方便铲", "铅杖", "钢杖", "木杖", "竹杖" });
  set_name(
    HIC + order1[random(18)] + order2[random(9)] + HIG + order3[random(12)] + NOR,
    ({ "staff" })
  );
  set_weight(2000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "根");
    set("long", "这是一把看起相当普通的禅杖");
    set("m_ap_rank", 9);
    set("m_dp_rank", 9);
    set("value", random(9) * random(100) * 100 + 1000);
    set("material", "iron");
  }
  init_staff(random(90) + 10);

  // These properties are optional, if you don't set them, it will use the
  // default values.

  set("wield_msg", "$N把$n紧紧地握在手中。\n");
  set("unwield_msg", "$N松开了手中的$n。\n");

  // The setup() is required.
  setup();
}
