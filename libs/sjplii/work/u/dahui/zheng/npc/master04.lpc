// huineng.c 心禅堂-慧能

inherit NPC;
inherit F_MASTER;

void create()
{
	set_name("慧能", ({"hui neng master","hui neng","master",}));
	set("long",
		"这是一位看起来很平常的僧人，他长的普普通通。\n"
	);


	set("gender", "男性");
	set("attitude", "heroism");
	set("class", "shaolin1");

	set("inquiry",([
		"虚方大师" : "虚方大师你都不知道？他是我的师傅，是[藏经阁]首座！\n",
		"觉禅" : "你说觉禅呀，他是我的得意弟子，在前院小广场。\n",
	]));

	set("age", 35);

	set("max_gin", 500);
	set("max_kee", 1000);
	set("max_sen", 500);
	set("force", 2000);
	set("max_force", 1500);
	set("force_factor", 40 );
	set("combat_exp", 1000000);

	set_skill("force", 120);
	set_skill("tongzi-force", 120);
	set_skill("dodge", 120);
	set_skill("shaolin-dodge", 120);
	set_skill("hammer", 120);
	set_skill("weituo_chu", 120);
	set_skill("fuhu-ken", 120);
	set_skill("parry", 120);
	set_skill("unarmed", 120);

//	set_skill("essencemagic", 100);
	set_skill("buddhism", 100);
	set_skill("magic", 50);
	set_skill("literate", 50);
	set_skill("zuochanshu", 50);

	map_skill("force", "tongzi-force");
	map_skill("dodge", "shaolin-dodge");
	map_skill("hammer", "weituo_chu");
	map_skill("unarmed", "fuhu-ken");

	set("title","少林寺心禅堂首座");
	create_family("少林寺", 8, "弟子");
	set("no_teach",1);

	setup();
	carry_object(__DIR__"weapon/hammer")->wield();
	carry_object(__DIR__"obj/qing_jiasha")->wear();
}

void die()
{
	int exp,pot,score;
        object killer,victim;

        if ( !killer=query_temp("last_damage_from") )
             killer=this_player(1);

	if(!victim) victim = this_object();

	if( !userp(victim) && victim->query("NKreward_MASTER")) {	
	 exp = random(victim->query("combat_exp") - killer->query("combat_exp"))/100;
	 pot = random(exp)/2;
	 if( exp <= 0 )  exp=20;
	 if( pot <= 0 )  pot=10;
	 if( exp > 2000 )  exp=2000;
	 if( pot > 1000 )  pot=1000;
	 score = random(pot/100) +1;
	 if( killer->query("id_type")!= victim->query("id_type") )
	 {
        killer->add("combat_exp", exp);
        killer->add("potential", pot);
        killer->add("life_exp", score);
        killer->add("score", score);
        tell_object(killer,HIY"你获得了：\n" +
        chinese_number(exp) + "点经验\n"+
        chinese_number(pot) + "点潜能\n" +
        chinese_number(score)+"点江湖阅历\n" +
        chinese_number(score)+"点声望\n"NOR);
	 }
	}
        ::die();
}

