// wangqr.c

#include <ansi.h>
inherit NPC;

void create() {
  set_name("史枫", ({ "shi feng", "master", "shi" }));
  set("nickname", HIR "无招剑狂" NOR);
  set("title", "丐帮传功长老");
  set("gender", "男性");
  set("age", 65);
  set("long",
    "他以前是名镇江湖的使剑高手，由于老帮主对他有恩，他就投靠了丐帮。\n");
  set("inquiry", ([
    "拜师": "问那么多干吗，快拜师吧！",
    "老帮主": "老帮主已经失踪多年。",
  ]));
  set("max_kee", 3000);
  set("kee", 3000);
  set("force", 6000);
  set("max_force", 5000);
  set("force_factor", 60);
  set("combat_exp", 500000);

  set_skill("unarmed", 200);
  set_skill("sword", 200);
  set_skill("force", 200);
  set_skill("parry", 200);
  set_skill("dodge", 200);
  set_skill("begging", 200);

  set_skill("iron_strike", 200);
  set_skill("hidden_dodge", 200);
  set_skill("xianglong_strike", 180);
  set_skill("canyun_force", 200);
  set_skill("crazy_sword", 200);
  set_skill("literate", 120);

  map_skill("dodge", "hidden_dodge");
  map_skill("unarmed", "iron_strike");
  map_skill("force", "canyun_force");
  map_skill("sword", "crazy_sword");
  map_skill("parry", "crazy_sword");

  create_family("丐帮", 2, "弟子");

  setup();

  carry_object(__DIR__ "weapon/sword")->wield();
  carry_object(__DIR__ "obj/jinzhuang")->wear();
}

void die() {
  int exp, pot, score;
  object killer, victim;

  if (!killer = query_temp("last_damage_from"))
    killer = this_player(1);

  if (!victim) victim = this_object();

  if (!userp(victim) && victim->query("NKreward_MASTER")) {
    exp = random(victim->query("combat_exp") - killer->query("combat_exp")) / 100;
    pot = random(exp) / 2;
    if (exp <= 0) exp = 20;
    if (pot <= 0) pot = 10;
    if (exp > 2000) exp = 2000;
    if (pot > 1000) pot = 1000;
    score = random(pot / 100) + 1;
    if (killer->query("id_type") != victim->query("id_type")) {
      killer->add("combat_exp", exp);
      killer->add("potential", pot);
      killer->add("life_exp", score);
      killer->add("score", score);
      tell_object(killer, HIY "你获得了：\n" +
        chinese_number(exp) + "点经验\n" +
        chinese_number(pot) + "点潜能\n" +
        chinese_number(score) + "点江湖阅历\n" +
        chinese_number(score) + "点声望\n" NOR);
    }
  }
  ::die();
}
