// huang_jiasha.c

#include <armor.h>

inherit CLOTH;

void create()
{
	set_name("黄布袈裟", ({ "huang jiasha","jiasha" }) );
	set_weight(3000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "件");
		set("long","一件黄布缝制的袈裟。\n");
		set("material", "cloth");
		set("armor_prop/armor", 3);
	}
	setup();
}
