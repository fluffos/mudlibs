// more /d/evilland/evil00.c
inherit ROOM;
void create ()
{
        int i;
        set("short", "蜀南溶洞");
        set("long", @LONG
溶洞以卧虎岭下的天泉洞最著名。主洞长一千三百余米，可容万人，
洞顶的钟乳石，琳琅满目。主洞两旁有耳洞、吊洞、风洞等十多个大溶洞
，形成洞中有洞、洞下有洞的奇观。洞内有深不见底的“阴河”，河中生
活着灰白透明的小鱼，俗称玻璃鱼，出洞见光即死。
    这里明显的出口是 south、north、west、east 和 up 。
LONG);

	set("hell",1);
	set("auto_maps",1);
	set("map_xyz",000);
	set("master_xyz",random(90)*10+0);
	set("next_exit_xyz",random(90)*10+0);
	set("NONPC",1);
        setup();
}

void init()
{
	add_action("do_gogo", "go");
}

int do_gogo(string dir)
{
	object me, room;
	me=this_player();
	me->set("map_xyz",0);
	me->set("master_xyz",query("master_xyz") );
	me->set("next_exit_xyz",query("next_exit_xyz") );
	if( !dir )
                return notify_fail("你要往哪里去？\n");

       switch(dir){
       case "north":
			me->add("map_xyz",10);
			if( me->query("map_xyz")%1000 == me->query("master_xyz") )
			{
			room=new(__DIR__"shilin02.lpc");
			room->set("map_xyz",me->query("map_xyz")%1000);
			room->set("master_xyz",me->query("master_xyz"));
			room->set("next_exit_xyz",me->query("next_exit_xyz") );
			}
			else
			{
			room=new(__DIR__"shilin01.lpc");
			}
			break;
       case "south":
			me->add("map_xyz",-10);
			if( me->query("map_xyz")%1000 == me->query("master_xyz") )
			{
			room=new(__DIR__"shilin02.lpc");
			room->set("map_xyz",me->query("map_xyz")%1000);
			room->set("master_xyz",me->query("master_xyz"));
			room->set("next_exit_xyz",me->query("next_exit_xyz") );
			}
			else
			{
			room=new(__DIR__"shilin01.lpc");
			}
			break;
       case "east":
			me->add("map_xyz",100);
			if( me->query("map_xyz")%1000 == me->query("master_xyz") )
			{
			room=new(__DIR__"shilin02.lpc");
			room->set("map_xyz",me->query("map_xyz")%1000);
			room->set("master_xyz",me->query("master_xyz"));
			room->set("next_exit_xyz",me->query("next_exit_xyz") );
			}
			else
			{
			room=new(__DIR__"shilin01.lpc");
			}
			break;
       case "west":
			me->add("map_xyz",-100);
			if( me->query("map_xyz")%1000 == me->query("master_xyz") )
			{
			room=new(__DIR__"shilin02.lpc");
			room->set("map_xyz",me->query("map_xyz")%1000);
			room->set("master_xyz",me->query("master_xyz"));
			room->set("next_exit_xyz",me->query("next_exit_xyz") );
			}
			else
			{
			room=new(__DIR__"shilin01.lpc");
			}
			break;
       case "up":
			me->set("map_xyz",0);
			room=load_object("/u/guanwai/shilin.lpc");
			break;
	default:
	}

       if( dir=="down" || !room )
                return notify_fail("这里没有这个方向的出口。\n");
	me->move(room);
	write("\n你走了过来。\n");
	destruct(this_object());
	return 1;
}

