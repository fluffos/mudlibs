#include <ansi.h>
inherit ROOM;
void create()
{
        set("short", WHT "山谷中" NOR);
        set("long", @LONG
一道狭长的山谷，两边为入云的高山，穿越山谷的寒风针一般
刺在你的身上——好冷啊！
LONG);
        set("exits", ([ 
  "westdown" : __DIR__"gudao2",
  "northup" : __DIR__"gudao4",
   ]));
	set ("oldarea",19);
	set("outdoors","changbai");
	setup();
 }