#include <ansi.h>
inherit ROOM;
void create() {
  set("short", WHT "紫霞峰" NOR);
  set("long", @LONG
紫霞峰由紫色沙石堆积，远观之烟云缭绕，宛若西天落霞，
紫气生辉，古香古色，因而得名。
LONG);
  set("exits", ([
    "westdown": __DIR__ "heifengkou",
    "north": __DIR__ "zixiafeng1",
    "south": __DIR__ "zixiafeng2",
    "west": __DIR__ "zixiafeng3",
    "east": __DIR__ "zixiafeng4",
  ]));
  set("oldarea", 09);
  set("outdoors", "changbai");
  setup();
}
