inherit ROOM;
void create()
{
	set("short", "黑虎峰");
        set("long",@LONG
这坐山峰在这四座侧峰中好像有点特别。因为整个山看起来不是青色，
而是黑色。山中黑色的巨石比比皆是，中间灌木丛生。不知道这山上会有
些什么凶猛野兽。
LONG
        );
	set("outdoors", "tianzhu");
        set("exits", ([
		"northeast" : __DIR__"youming",
		"northdown" : __DIR__"wanshou1",
		"southdown" : __DIR__"songlin4",
		"westdown" : __DIR__"songlin5",
        ]));
        set("objects",([
	 	__DIR__"npc/xuanyuanshan" : 1,
	 	__DIR__"npc/qian":1,
	 	__DIR__"npc/zheng":1,
	 	__DIR__"npc/tian":1,
	]));
        setup();
        replace_program(ROOM);
}
