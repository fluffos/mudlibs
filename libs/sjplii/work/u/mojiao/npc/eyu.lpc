//eyu.c written by john darks
inherit NPC;
void create()
{
        set_name("鳄鱼", ({ "eyu" }) );
        set("race", "野兽");
        set("age", 4);
	set("yes_carry", 1);
        set("long", "一条尾巴短短的鳄鱼，但看上去却一点也不可爱。\n");
        set("limbs", ({ "头部", "身体", "尾巴", "眼睛" }) );
        set("verbs", ({ "bite" }) );
        set("attitude", "aggressive");
        set_skill("dodge", 50);
	set_skill("move",300);
        set("combat_exp", 9999);
	set("bellicosity", 300 );
	add_temp("apply/damage",30+random(20));
        setup();
}

void init()
{
        object ob;
        ::init();
        if( interactive(ob = this_player()) ) {
                kill_ob(ob);
        }
}

