// killer.c written by john darks
#include <ansi.h>
inherit NPC;
void create()
{
	set_name("魔教弟子", ({ "dizi" }) );
	set("gender", "男性" );
	set("age", 22);
	set("long","魔教地撤大阵弟子\n");
	set("no_shown",1);
	set("max_kee",5000);
	set("max_gin",2000);
	set("max_sen",2000);
	set("attitude", "peaceful");
	set_skill("unarmed", 300);
	set_skill("force", 300);
	set_skill("dodge",500);
	set("combat_exp", 90000);
	setup();
}

void die()  
{
	object victim;
	if( objectp(victim = query_temp("last_damage_from")))
		victim->add_temp("mojiao/pass",1);
	message_vision(HIR"\n$N往黑暗里一缩，消失不见了！\n"NOR,this_object());
	destruct(this_object());
}
