// dizi-2.c

inherit NPC;

void create() {
  object ob;

  set_name("玄鱼", ({ "xuanyu" }));
  set("title", "魔教执法长老");
  set("gender", "男性");
  set("age", 54);
  set("max_kee", 1000);
  set("kee", 1000);
  set("con", 32);
  set("str", 40);
  set("con", 32);
  set("food", 1000);
  set("water", 1000);
  set("vendetta_mark", "mojiao");

  set("long",
    "这是一个魔教的四大长老之一，本来是少林高手，二十年前投奔魔教。\n");
  set("combat_exp", 150000);
  set("score", 500);
  set("force", 1500);
  set("food", 1000);
  set("water", 1000);
  set("max_force", 1500);
  set("force_factor", 60);

  set("bellicosity", 800);
  set_skill("unarmed", 280);
  set_skill("parry", 200);
  set_skill("dodge", 210);
  set_skill("force", 202);
  set_skill("blade", 230);
  set_skill("cibei-blade", 220);
  set_skill("senluo-force", 260);
  set_skill("literate", 50);
  set_skill("shaolin-step", 290);
  map_skill("blade", "cibei-blade");
  map_skill("force", "senluo-force");
  map_skill("dodge", "shaolin-step");
  create_family("魔教", 7, "长老");
  setup();
  carry_object("/obj/blade")->wield();
  carry_object(__DIR__ "obj/silk_cloth")->wear();
}


void killed_enemy(object who) {
  command("say 哈哈哈, 不要命的家伙！");
}

void attempt_apprentice(object ob) {
  if (ob->query("title") != "魔教堂主" || ob->query("combat_exp") < 100000) {
    command("say 呵呵，" + RANK_D->query_respect(ob) + "在本教资历尚浅，护法之职恐难担当，继续努力吧！\n");
    return;
  }
  command("smile");
  command("say " + RANK_D->query_respect(ob) + "你真识货！跟着我准没错。\n");
  command("recruit " + ob->query("id"));
}

void recruit_apprentice(object ob) {
  if (::recruit_apprentice(ob)) {
    ob->set("class", "mojiao");
    ob->set("title", "魔教护法");

  }

}
