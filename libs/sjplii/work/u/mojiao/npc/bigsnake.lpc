//bigsnake.c written by john darks
#include <ansi.h>
inherit NPC;
void use_poison();
void create() {
  set_name("天冠巨蛇", ({ "snake" }));
  set("race", "野兽");
  set("age", 15);
  set("long", "一条水桶粗细的巨蛇，头顶有一个巨大的瘤冠。\n");
  set("limbs", ({ "头部", "身体", "尾巴", "七寸" }));
  set("verbs", ({ "bite" }));
  set("attitude", "aggressive");
  set_skill("dodge", 250);
  set("combat_exp", 999999);
  set("bellicosity", 300000);
  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: use_poison :),
  }));
  set_temp("apply/attack", 200);
  set_temp("apply/damage", 130);
  setup();
}

void die() {
  object ob;
  ob = new(__DIR__ "questobj/shedan");
  ob->move(this_object());
  ::die();
}

void use_poison() {
  object *enemy, ob;
  enemy = query_enemy();
  if (sizeof(enemy)) ob = enemy[random(sizeof(enemy))];
  tell_object(ob, "你觉得手上突然一阵剧痛，伸手一摸竟是两个毒牙印痕。\n");
  ob->apply_condition("bigsnake_poison",
    (int)this_player()->query_condition("bigsnake_poison")
    +random(3) + 23);
}
