#include <ansi.h>
inherit NPC;
inherit F_MASTER;
void create()
{
	set_name("轩辕山", ({ "xuanyuan shan", "xuanyuan", "master" }));
	set("title", "魔教“伏兽坛”坛主");
	set("gender", "男性");
	set("age", 46);
	set("nickname", HIG "惊魔斧影" NOR);
	set("attitude", "peaceful");
        set("str", 30);
        set("int", 30);
        set("cor", 30);
        set("spi", 30);
	set("max_kee", 2000);
	set("max_gin", 2000);
	set("max_sen", 2000);
	set("kee", 2000);
	set("gin", 2000);
	set("sen", 2000);
        set("force", 2000);
        set("max_force", 2000);
        set("force_factor", 20);
        set("combat_exp", 6500000);
        set("score", 20000);
        set_skill("literate", 180);
        set_skill("force", 180);
        set_skill("unarmed", 180);
        set_skill("axe", 300);
        set_skill("parry", 180);
        set_skill("dodge", 180);
        set_skill("training", 120);
        set_skill("shengui_axe", 280);
        set_skill("shenkong-xing", 110);
        set_skill("sanlianhuan", 200);
        set_skill("yuanyouforce", 140);
        map_skill("axe", "shengui_axe");
        map_skill("force", "yuanyouforce");
        map_skill("parry", "shengui_axe");
        map_skill("dodge", "shenkongxing");
        map_skill("unarmed", "sanlianhuan");
	create_family("魔教",3, "坛主");
	set("class", "mojiao");
       
	setup();
	carry_object("/obj/cloth")->wear();
	carry_object("/obj/weapon/axe")->wield();
}

void attempt_apprentice(object ob)
{
     	if( ob->query("id_type")==1 ) {
		command("say 你身为正派弟子，哪里会诚心拜师？正邪势不两立！\n");
	    	return;
      	}
      	if( ob->query("帮派")!="魔教" ) {
		command("say 你非本教弟子，我怎能收你为徒！\n");
	    	return;
      	}
      	if(ob->query("mojiao/弃子")) {
		command("say 你没有资格成为我的弟子！\n");
	    	return;
      	}
	if (ob->query("mojiao/势力")!="教主系")
	{
		switch(ob->query("mojiao/势力")){
		case "教主系":
			command("say " + RANK_D->query_respect(ob) + "好像应该去见见两大长老才对。");
			return;
			break;
		case "紫迷坛":
			command("say " + RANK_D->query_respect(ob) + "好像应该去见见紫迷坛主才对。");
			return;
			break;
		case "天玄坛":
			command("say " + RANK_D->query_respect(ob) + "好像应该去见见天玄坛主才对。");
			return;
			break;
		case "伏兽坛":
			command("say " + RANK_D->query_respect(ob) + "好像应该去见见伏兽坛主才对。");
			return;
			break;
		}
	}	
	message_vision(CYN"轩辕山说道：“好吧, 我就收下你了。”\n"NOR,ob);
       	command("recruit " + ob->query("id"));
	ob->set("class", "mojiao");
	ob->set("id_type", 2);
       	return;
}