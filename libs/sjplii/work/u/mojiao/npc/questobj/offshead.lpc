inherit ITEM;
#include <ansi.h>
void create()
{
    	set_name("人头", ({ "head" }) );
    	set_weight(1);
    	if( clonep() )
        	set_default_object(__FILE__);
    	else {
            	set("unit", "颗");
            	set("value", 0);
		set("questvalue",100);
		set("questobj",1);
            	set("material", "stone");
            	set("long", "一颗人头，血淋淋的。\n");
        }
    	setup();
}




