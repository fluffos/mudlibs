#include <armor.h>
inherit CLOTH;
void create()
{
	set_name("金毛猴皮", ({ "houpi" }) );
	set_weight(3000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "件");
		set("material", "cloth");
		set("armor_prop/armor", 40);
		set("questvalue",50);
		set("questobj",1);
	}
	setup();
}
