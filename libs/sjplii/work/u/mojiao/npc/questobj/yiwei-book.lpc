//yiwei-book.c written by john darks
inherit ITEM;
void create() {
  set_name("一苇渡江秘笈", ({ "yiwei-book" }));
  set_weight(600);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "本");
    set("long", "这是一本页面发黄的武功秘笈。\n");
    set("value", 0);
    set("questobj", 1);
    set("questvalue", 110);
    set("material", "paper");
    set("skill", ([
      "name": "yiwei-steps",
      "exp_required": 200000,
      "sen_cost": 35,
      "difficulty": 30,
      "max_skill": 100,
    ]));
  }
}
