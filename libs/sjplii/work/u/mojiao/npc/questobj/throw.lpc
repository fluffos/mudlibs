#include <ansi.h>
#include <weapon.h>
inherit THROWING;

void create()
{
        set_name(HIY"伤心小箭"NOR, ({ "throw","伤心小箭"}) );
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long", "一支箭，据传配以伤心小箭心法射出将威力无比。\n");
                set("unit", "把");
                set("base_unit", "支");
                set("material", "iron");
                set("base_weight", 10000);
                set("base_value", 10000);
        }
        set_amount(3);
        init_throwing(20);
        setup();
}

