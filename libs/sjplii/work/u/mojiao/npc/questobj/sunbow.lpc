//sunbow.  written by john darks
#include <ansi.h>
#include <combat.h>
inherit ITEM;
object offensive_target(object me);
int find_road(object room,object target ,string exit);
void create()
{
	set_name(HIR"太阳神弓"NOR, ({ "sunbow","太阳神弓","bow" }) );
	set_weight(200000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "一张沉重的铁弓，金镂镶嵌，看上去十分不凡。\n");
		set("unit", "张");
		set("questvalue",130);
		set("material", "iron");
	}
	setup();
}

void init()
{
        add_action("do_shoot","shoot");
}

object offensive_target(object me)
{
        int sz;
        object *enemy;

        enemy = me->query_enemy();
        if( !enemy || !arrayp(enemy) ) return 0;

        sz = sizeof(enemy);
        if( sz > 4 ) sz = 4;

        if( sz > 0 ) return enemy[random(sz)];
        else return 0;
}

int do_shoot(string arg)
{
	object ob,room,throw;
	object me = this_player();
	mapping exits;
	string exit;
	int step,damage,defense,i;
	if (!arg) {
		ob = offensive_target(me);
		if( !ob
		||	!ob->is_character()
		||	ob->is_corpse()
		||	ob==me)
		return notify_fail("你要射谁？\n");
	}
	else {
		ob = find_player(arg);
		if( !ob )  ob = find_living(arg);
		if( !ob || !environment(ob)) 
			return notify_fail("没有这个人。\n");
	}
	if (environment(ob)->query("no_magic"))	return notify_fail("箭飞不到那里！\n");
	if( !objectp(room = environment(me)) )
		return notify_fail("这里只有灰蒙蒙地一片，箭飞不出去！\n");
	if (!objectp(throw = present("伤心小箭",me)))
		return notify_fail("你身上没有箭！！\n");
	exit = "east";
	step = find_road( room , ob , exit);
	if (step == -1){
		exit = "south";
		step = find_road( room , ob , exit);
	}
	if (step == -1){
		exit = "west";
		step = find_road( room , ob , exit);
	}
	if (step == -1){
		exit = "north";
		step = find_road( room , ob , exit);
	}
	if (step == -1) return notify_fail("以你的臂力，还射不到这个人！\n");
	if (step==0){
		message_vision(HIY"$N"+HIY"从背后取下一张铁弓！\n"NOR,me);
		message_vision(HIY"只见$N"+HIY"弯弓搭箭，对准$n"+HIY"就是一箭！！\n"NOR,me,ob);
		message_vision(HIW"一道寒光一闪而没！！\n"NOR,me);
		message_vision(HIR"$N"+HIR"大叫一声，翻身就倒！\n"NOR,ob);
		damage = (int)( me->query_skill("throwing")
			 + me->query("force_factor")*10	+ me->query("str")*me->query("str"));
		defense=(int)( ob->query_skill("move") 
			 + ob->query("combat_exp")/1000 + ob->query("fle")*ob->query("fle"));
		damage -= defense;
		if (damage<0)  damage = 0;
        	ob->receive_damage("kee", damage,me);
        	ob->receive_wound("kee", damage/5,me);
        	COMBAT_D->report_status(ob);
        	if (!ob->is_fight(me))	ob->kill_ob(me); 
    		me->start_busy(4);
    		throw->add_amount(-1);
	}else {
		message_vision(HIY"$N"+HIY"从背后取下一张铁弓！\n"NOR,me);
		message_vision(HIY"只见$N"+HIY"弯弓搭箭，一股气劲凝聚在箭头，只听“呼”的一声，往"+to_chinese(exit)+"就是一箭！！\n"NOR,me);
		message_vision(HIW"一道寒光一闪而没！！\n"NOR,me);
		damage = (int)( me->query_skill("throwing")
			 + me->query("force_factor")*10	+ me->query("str")*me->query("str"));
		defense=(int)( ob->query_skill("move") 
			+ ob->query("combat_exp")/1000 + ob->query("fle")*ob->query("fle"));
		damage -= defense;
		for (i=0 ; i< step ;i++){
			exits = room->query("exits");
			message("vision",HIY"一股气劲呼啸而至，"+HIW"一道寒光一闪而没！！\n"NOR,room = find_object(exits[exit]));
			damage = (int) damage*4/5;
		}
		if (environment(ob)==room){
			tell_object(ob,HIR"你只觉得一股大力袭来，胸口被重重的撞了一下！！\n"NOR);
			message("vision",HIR"只听"+ob->name()+HIR"大叫一声，已被一箭射中！\n"NOR,room,ob);
		}
		if (damage<0)  damage = 0;
        	ob->receive_damage("kee", damage,me);
        	ob->receive_wound("kee", damage/5,me);
        	COMBAT_D->report_status(ob);
        	throw->add_amount(-1);
	}
	return 1;
}

int find_road(object room,object target ,string exit)
{
	int i;
	mapping exits;
	object me = this_player();
	if (environment(target)==room)	return 0;
	for (i=0 ; i< ceil(pow(to_float(me->query("str")), 0.5)) ;i++)
	if( mapp(exits = room->query("exits")) && !undefinedp(exits[exit]) ) {
		if( objectp(room = find_object(exits[exit]))) {
			if( environment(target)==room )	return (i+1);
			else continue;
		}
		else break;
	}
	return -1;
}
