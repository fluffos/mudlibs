//wujidan.c written by john darks
inherit ITEM;
#include <ansi.h>
void create()
{
    	set_name(HIR"无极仙丹"NOR, ({ "wujidan" }) );
    	set_weight(1);
    	if( clonep() )
        	set_default_object(__FILE__);
    	else {
            	set("unit", "丸");
            	set("value", 0);
                set("questobj", 1);
		set("questvalue",200);
            	set("material", "stone");
            	set("long", "一丸无极仙丹，传闻吃了能增加一甲子功力。\n");
        }
    	setup();
}

void init()
{
	add_action("do_eat","eat");	
}

int do_eat(string arg)
{
	object me = this_player();
	if( !arg || arg !="wujidan")
		return 0;
	message_vision("$N一口吞下无极仙丹。\n",me);
	me->add("mojiao/xiandan",1);
	me->apply_condition("xiandan",10);
	destruct(this_object());
        return 1;
}



