// honhmian.c written by john darks
#include <ansi.h>
inherit NPC;
void create() {
  set_name("红棉", ({ "hong mian" }));
  set("long", "她面容消瘦，但一双眼睛，却极明亮，更充满了一股野性，
似乎一眼就可以把人的魂勾走。\n");
  set("gender", "女性");
  set("age", 18);
  set("per", 25);
  set("agi", 40);
  set("cor", 30);
  set("fle", 200);
  set("max_gin", 5000);
  set("max_kee", 10000);
  set("max_sen", 5000);
  set_skill("whip", 170);
  set_skill("dodge", 120);
  set_temp("apply/damage", 150);
  set_temp("apply/defense", 300);
  set_temp("apply/attack", 160);
  set("combat_exp", 2500000);
  set("no_arrest", 1);
  setup();
  carry_object("/obj/cloth")->wear();
  carry_object("/obj/weapon/whip")->wield();
}

void die() {
  object ob;
  ob = new(__DIR__ "obj/juanzhou");
  ob->move(this_object());
  ::die();
}

void init() {
  object me = this_player();
  if (interactive(me) && me->query_temp("mojiao/qimeng") == 4)
    call_out("welcome_him", 1, me);
}

void welcome_him(object me) {
  message_vision(CYN "$N一看到$n，不由又惊又喜，娇呼一声，扑入$n的怀中！\n" NOR, this_object(), me);
  set_leader(me);
  message_vision(CYN "$N幽幽道：这里没有出路了，看来只有挪开(move)那块石头了。\n" NOR, this_object());
}
