//officer.c written by john darks
#include <ansi.h>
inherit NPC;
void use_guard();
void create()
{
        string *order = ({"张", "王", "李", "赵","柳"});
        set_name(order[random(5)]+"大人", ({ "officer"}));
        set("title", "朝廷命官");
        set("gender", "男性");
        set("age", random(20)+20);
        set("str", 26);
        set("long","他是朝廷命官，一般人惹不起。\n");
        set("attitude", "peaceful");
        set_skill("literate", 40);
        set("chat_chance", 15);
        set("chat_msg", ({
                (: random_move :)
        }) );
        set("chat_chance_combat", 90);
        set("chat_msg_combat", ({
                (: use_guard :),
        }) );
        set("max_kee",5000);
        set("max_sen",2000);
        set("max_gin",2000);
        set("combat_exp", 1000000 + random(2000000));
        set_skill("sword", 150 + random(100));
        set_skill("parry", 150 + random(100));
        set_skill("dodge", 150 + random(100));
        set_skill("move", 150 + random(100));
        setup();
        
        carry_object("/obj/cloth")->wear();
        carry_object("/obj/weapon/sword")->wield();
}

void die()
{
        object head;
        head=new(__DIR__"questobj/offshead");
        head->set_name(HIR+this_object()->query("name")+"的人头"NOR,({"head"}) );
        head->move(this_object());
        ::die();
}

void use_guard()
{
        object *enemy,guard;
        int i,j;
        object me = this_object();
        if ((int)me->query_temp("mojiao/offsguard") < 2){
                message_vision(HIB "\n$N大喝一声，护驾！！\n" NOR, me); 
                for (j=0 ;j< 4 ;j++){
                        guard = new(__DIR__"guard");
                        guard->move(environment(me));
                        guard->set("possessed", me);
                        enemy = me->query_enemy();
                        i = sizeof(enemy);
                        if (j%2==0)     guard->set_leader(enemy[random(i)]);
                        else guard->set_leader(me);
                        while(i--) {
                                if( enemy[i] && living(enemy[i]) ) {
                                        guard->kill_ob(enemy[i]);
                                        if( userp(enemy[i]) ) enemy[i]->fight_ob(guard);
                                        else enemy[i]->kill_ob(guard);
                                }
                        }
                }
                message_vision(HIW "一群$N应声而来！\n" NOR, guard);
                me->add_temp("mojiao/offsguard",1);
                me->remove_all_killer();
        }
        if (objectp(guard = present("guard",environment(me))))
                message("vision",HIR"\n侍卫们喝道：大胆！竟敢光天化日这下刺杀朝廷命官，不想活了！\n" NOR,environment(me));
}
