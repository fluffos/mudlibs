//qimeng.c written by john darks
#include <ansi.h>
inherit NPC;
void create()
{
	set_name("梅一魁" , ({"mei yikui","mei"}));
	set("long", "一位看上去很厉害的家伙。\n");
	set("attitude", "friendly");
	set("max_gin", 10000);
	set("max_kee", 10000);
	set("max_sen", 10000);
	set("age",35);
        set("gender", "男性" );
        set("title", "鞭长莫及地灵煞");
	set("combat_exp", 1000000);
	set("fle",300);
	set_temp("appl/attack",100);
	set_temp("apply/damage",50);
        set_skill("whip", 185);
        set_skill("force", 90);
        set_skill("parry", 167);
        set_skill("dodge", 189);
        set_skill("literate", 50);
	setup();
	carry_object("/obj/cloth")->wear();
        carry_object("/obj/weapon/whip")->wield();
}

void init()
{
        object me = this_player();
        object ob = present("yu girl",environment(this_object()));
        if(interactive(me) && me->query_temp("mojiao/qimeng")==3)
        	call_out("chase_him",1, me);
}

void chase_him(object me)
{
        message_vision(CYN"$N向$n喝道："+ RANK_D->query_rude(me)+"，还我绮梦姑娘命来！\n"NOR,this_object(),me);
        set_leader(me);
        kill_ob(me);
}

void die()
{
	object me = this_player();
	me->set_temp("mojiao/qimeng",4);
	::die();
}

