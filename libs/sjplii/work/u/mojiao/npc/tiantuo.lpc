#include <ansi.h>
inherit NPC;
inherit F_MASTER;
int about_skills();
void create()
{
	set_name("田驼", ({ "tian tuo", "tuo", "master" }));
	set("title", "魔教护法");
	set("gender", "男性");
	set("age", 66);
	set("nickname", HIG "商山四异" NOR);
	set("attitude", "peaceful");
        set("str", 30);
        set("int", 30);
        set("cor", 30);
        set("spi", 30);
	set("max_kee", 2000);
	set("max_gin", 2000);
	set("max_sen", 2000);
	set("kee", 2000);
	set("gin", 2000);
	set("sen", 2000);
        set("force", 2000);
        set("max_force", 2000);
        set("force_factor", 20);
        set("combat_exp", 9000000);
        set_skill("literate", 140);
        set_skill("force", 200);
        set_skill("unarmed", 200);
        set_skill("dodge", 200);
        set_skill("bagua-array", 450);
        set_skill("senluo-force", 200);
        map_skill("force","senluo-force");
        map_skill("unarmed", "bagua-array");
	create_family("魔教",3, "护法");
	set("class", "mojiao");
	set("inquiry", ([
                "八卦连环阵" : (: about_skills :),
                "bagua-array": (:about_skills:),
        ]));
	setup();
	carry_object("/obj/cloth")->wear();
}

void attempt_apprentice(object ob)
{
	message_vision(CYN"田驼说道：“哪里哪里，岂敢岂敢。”\n"NOR,ob);
	return;
}

int about_skills()
{
	object me = this_player();
	object ob = this_object();
	if (me->query("marks/帮派")!="魔教" || me->query("mojiao/array2") < 3){
		message_vision(CYN"田驼说道：“在下武功低微，阁下说笑了。”\n"NOR,ob);
		return 1;
	}
	if (me->query("mojiao/拳脚") < 500){
		message_vision(CYN"田驼说道：“阁下似乎对拳脚没有太多的喜好。”\n"NOR,ob);
		return 1;
	}
	if (me->query("mojiao/忠心") < 320000){
		message_vision(CYN"田驼说道：“阁下职位低微，还是去做些其它对本教有益的事吧。”\n"NOR,ob);
		return 1;
	}
	if (!me->query_skill("bagua-array",1)){
		message_vision(CYN"田驼说道：“蒙阁下垂青，属下自当倾力相授八卦连环阵(bagua-array)。”\n"NOR,ob);
		me->improve_skill("bagua-array",me->query_int()*me->query_int()/100);
		me->set("mojiao/array2",4);
	}else 	message_vision(CYN"田驼说道：“属下自当倾力相授八卦连环阵(bagua-array)。”\n"NOR,ob);
	return 1;
}

int recognize_apprentice(object ob)
{
        if( ob->query("mojiao/array2") > 3)
		return 1;
        return 0;
}