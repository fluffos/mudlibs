//horse.c written by john darks
#include <ansi.h>
inherit NPC;
void create()
{
	set_name("乌顶铁骑马", ({ "horse"}));
	set("race", "野兽");
	set("gender", "雄性");
	set("age", 2+random(3));
	set("long", "这是一匹乌顶雪蹄宝马，日行千里，夜行八百。\n"+
		"你可以骑着它四处走(ride/down)。\n");
	set("max_kee", 500);
	set("max_gin", 500);
	set("max_sen", 2000);
	set("combat_exp",50000);
	set("attitude", "peaceful");
	set("limbs", ({ "头部", "腹部", "尾巴","后腿","前腿" }) );
	set("verbs", ({ "bite","hoof"}));
	set("chat_chance", 1);
        set("chat_msg", ({
"乌顶铁骑马一阵长嘶＂咴～～咴咴＂！\n",
}) );
	set_temp("apply/attack", 50);
	set_temp("apply/armor",  50);
	set_temp("apply/damage", 25);
	set_temp("apply/dodge",  40);
	set_temp("apply/parry", 100);
	set_skill("move",600);
	set_temp("apply/move",300);
	setup();
	carry_object(__DIR__"obj/maan")->wear();
}

void init()
{
	object ob;
	if (objectp(ob = this_object()->query("rider")))
		set("long", "这是一匹乌顶雪蹄宝马，日行千里，夜行八百。\n"+
		"你可以骑着它四处走(ride/down)。\n"+
		"现在马上做着"+ ob->name()+"。\n");
	else 	set("long", "这是一匹乌顶雪蹄宝马，日行千里，夜行八百。\n"+
		"你可以骑着它四处走(ride/down)。\n"
		"现在马上没人。\n");	
	add_action("do_ride", "ride");
 	add_action("do_down", "down");
}

int do_ride(string arg)
{
    	string dir,dir2;
    	object *pros;
    	object ob = this_player () ;
    	if (!arg || arg!="horse")
    		return notify_fail("你要骑什么？\n");
    	if (ob->query_temp("mojiao/onhorse"))
    		return notify_fail("你已经在马上了。\n");
    	if(ob->query_per() < 23)
    	{
      		message_vision("$N一跃身跨上了铁骑马。只见铁骑马仰天长嘶，突然间猛然一扬身......\n"
                     HIR"结果把$N狠狠摔在了地上，$N看来受了点轻伤。\n" NOR,ob);
      		ob -> receive_wound("kee", 50, ob) ;
      		remove_call_out("kill_ob");
      		call_out("kill_ob", 1, ob);
      		return 1;
    	}
   	if( objectp(this_object()->query("rider"))) 
   	{
    		return notify_fail("现在马上已经有人了！\n" ) ;
   	}
   	else
   	{    
   		ob->set_temp("mojiao/onhorse",1);
   		this_object()->set("rider",ob);
   		message_vision("$N一跃身跨上了铁骑。\n" , ob );
   		this_object()->set_leader(ob);
   		set_leader(ob);
   		pros = ob->query_temp("protectors");
		if(sizeof(pros))
			pros += ({ this_object() });
		else
			pros = ({ this_object() });
		ob->set_temp("protectors",pros);
		ob->add_temp("apply/defense",100);
		ob->add_temp("apply/move",150);
   		return 1; 
  	}	
}

int do_down()
{
  	object ob;
  	object *pros;
  	int i;
  	ob = this_player () ;
  	if(!objectp(query("rider"))) 
  		return notify_fail("马上没有人。\n");
  	if(ob->query_temp("mojiao/onhorse"))
  	{
  		message_vision("\n$N身行一转，跃下马来，姿态十分优美。\n" , ob );
  		delete("rider");
  		set_leader(0);
  		ob->delete_temp("mojiao/onhorse");
  		pros = ob->query_temp("protectors");
		for(i=0;i<sizeof(pros);i++)
		if(pros[i] == this_object()) 
		 	pros -= ({this_object()});
		ob->add_temp("apply/defense",-100);
		ob->add_temp("apply/move",-150);
  	}
  	else {
  		switch(random(3)){
   		case 0: 
   			message_vision("\n$N一把把马上的人拉下来，想自己跳上去。\n" , ob );
   			this_object()->set_leader(0);
   			ob = this_object()->query("rider");
   			ob->delete_temp("mojiao/onhorse");
   			this_object()->delete("rider");
   			pros = ob->query_temp("protectors");
			for(i=0;i<sizeof(pros);i++)
			if(pros[i] == this_object()) 
		 		pros -= ({this_object()});
		 	ob->add_temp("apply/defense",-100);
			ob->add_temp("apply/move",-150);
   			break;
   		case 1: 
   		case 2:
   			message_vision("\n$N想把马上的人拉下马来,但没有成功。\n" , ob );
   		}	  
   	}
  	return 1;
}

void die()
{
	object ob;
	object *pros;
	int i;
   	ob = this_object()->query("rider");
   	ob->delete_temp("mojiao/onhorse");
   	this_object()->delete("rider");
   	pros = ob->query_temp("protectors");
	for(i=0;i<sizeof(pros);i++)
		if(pros[i] == this_object()) 
	pros -= ({this_object()});
	ob->add_temp("apply/defense",-100);
	ob->add_temp("apply/move",-150);
	::die();
}

