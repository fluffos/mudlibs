//bigsnake.c written by john darks
#include <ansi.h>
inherit NPC;
void use_poison();
void create() {
  set_name("大鳄鱼", ({ "e yu" }));
  set("race", "野兽");
  set("age", 15);
  set("long", "一头好大好大的鳄鱼。\n");
  set("limbs", ({ "头部", "身体", "尾巴" }));
  set("verbs", ({ "bite", "claw" }));
  set("attitude", "aggressive");
  set_skill("dodge", 250);
  set("fle", 200);
  set("combat_exp", 999999);
  set("bellicosity", 30000);
  set("chat_chance_combat", 90);
  set("chat_msg_combat", ({
    (: use_poison :),
  }));
  set_temp("apply/attack", 300);
  set_temp("apply/damage", 230);
  setup();
}

void die() {
  this_object()->set("start_tear", 0);
  ::die();
}

void use_poison() {
  object ob = this_object();
  message_vision(HIY "$N开始流下了善良的眼泪！\n" NOR, ob);
  ob->set("start_tear", 1);
  call_out("go_away", 60);
}

void init() {
  add_action("do_fill", "fill");
}

int do_fill(string arg) {
  object *list, ob;
  int i, can_fillwater;
  string dir;
  if (!arg || arg == "" || !this_object()->query("start_tear")) return 0;
  if (arg == "skin" || arg == "wineskin") {
    list = all_inventory(this_player());
    can_fillwater = 0;
    for (i = 0; i < sizeof(list); i++) {
      if (((string)list[i]->query("liquid/type") == "alcohol")
        || ((string)list[i]->query("liquid/type") == "water")) {
        ob = list[i];
        can_fillwater = 1;
        ob->set("liquid", ([
          "type": "tear",
          "name": "鳄鱼泪",
          "remaining": 25,
        ]));
        write("你装了些鳄鱼泪！ \n");
        this_player()->start_busy(1);
        return 1;
      }
    }
    if (can_fillwater == 0) {
      write("你没有装鳄鱼泪的东西啊....\n");
      return 1;
    }
  } else {
    write("你要往什么东西里装鳄鱼泪？\n");
  }
  return 1;
}

void go_away() {
  if (!living(this_object()))
    return;
  else {
    message_vision(HIY "$N忽然一个翻身，没入水中不见了。\n" NOR, this_object());
    destruct(this_object());
  }
  return;
}
