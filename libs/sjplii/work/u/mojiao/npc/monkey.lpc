//monkey.c written by john darks
inherit NPC;
void create()
{
	set_name("金毛小猴", ({ "monkey"}) );
	set("race", "野兽");
	set("gender", "雄性");
	set("age", 6);
	set("long", "这是一只可爱的金毛猴子\n");
	set("str", 48);
	set("cor", 52);
	set("cps", 22);
	set("max_kee", 600);
	set("max_gin", 600);
	set("max_sen", 900);
	set("limbs", ({ "头部", "身体", "前脚", "後脚", "尾巴" }) );
	set("verbs", ({ "bite", "claw" }) );
	set("chat_chance_combat", 1);
        set("chat_msg_combat", ({
                "小猴子向你唧唧叫了几声．\n",
        }) );
	set("combat_exp", 1200000);
	set_temp("apply/attack", 120);
	set_temp("apply/armor", 120);
	set_temp("apply/damage",200);
	setup();
}

void die()
{
	object ob;
	ob = new(__DIR__"questobj/houpi");
	ob->move(this_object());
	::die();
}