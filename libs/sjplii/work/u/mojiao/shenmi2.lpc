//shenmi2.c written by john darks
inherit ROOM;
void create() {
  set("short", "神秘谷");
  set("long", @LONG
山路在谷中曲折前进，有的时候前面的路被塌下来的山石隔断，有的
时候又有丛生的杂草绊人。可谓坎坷。四周烟气弥漫，你也只能分清个前
后左右，但是究竟哪里是东，哪里是西，你自己恐怕再也难分清楚。
LONG
  );
  set("exits", ([
    "northeast": __DIR__ "shenmi3",
    "west": __DIR__ "shenmigu",
  ]));
  set("no_clean_up", 0);
  setup();
}

int valid_leave(object me, string dir) {
  if (userp(me))
    if (dir == "northeast") {
      me->set_temp("wangsha/wfrom", "south");
      return 1;
    } else {
      me->set_temp("wangsha/wfrom", "north");
      return 1;
    }
  return 1;
}
