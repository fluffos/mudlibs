//didong1.c written by john darks
inherit ROOM;
void create() {
  set("short", "地狱洞");
  set("long", @LONG
就在你感到疲惫绝望的时候，你突然感觉前面似乎出现了一丝天光，
迎面吹来一阵寒风，令你为之一振。寒风的呼啸，虽然仍然不断，但听起
来却已不那么震耳欲聋了。
LONG
  );
  set("exits", ([
    "northeast": __DIR__ "yixiantian.lpc",
    "westdown": __DIR__ "dichetan",
  ]));
  set("no_clean_up", 0);
  setup();
}

void init() {
  object ob;
  if (interactive(ob = this_player()) && ob->query_temp("wangsha/wfrom") == "south") {
    set("long", @LONG
就在你感到疲惫绝望的时候，你突然感觉前面似乎出现了一丝天光，
迎面吹来一阵寒风，令你为之一振。寒风的呼啸，虽然仍然不断，但听起
来却已不那么震耳欲聋了。
LONG);
  } else {
    set("long", @LONG
自一线天走来，不知不觉中步入了一个阴暗的山洞，四处满是狂风的
呼啸声，隐隐充溢这杀戮之气。偶尔传来一声凄凉的叫声，也分不出是风
声还是人声。
LONG);
  }
}

int valid_leave(object me, string dir) {
  if (userp(me))
    if (dir == "northeast") {
      me->set_temp("wangsha/wfrom", "south");
      return 1;
    } else {
      me->set_temp("wangsha/wfrom", "north");
      return 1;
    }
  return 1;
}
