#include <ansi.h>
#include <room.h>
inherit ROOM;

void create() {
  set("short", "天池");
  set("long", @LONG
天池在渡仙桥一侧，大如磨盘，深不过尺，但碧水清澈，久旱不涸。
由天池下视千丈岩，令人心悸脚软，它与天柱峰相距仅五十米，相峙而又
不相连。游人到此，确有离天三尺之感。
LONG
  );
  set("outdoors", "tianzhu");
  set("exits", ([
    "south": __DIR__ "tianzhu1",
    "east": __DIR__ "duxian",
  ]));
  /*
	set("objects",([
	 	__DIR__"npc/master" : 1,
	]));
*/
  setup();
}
