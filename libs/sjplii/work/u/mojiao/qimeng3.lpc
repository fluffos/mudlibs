#include <ansi.h>
inherit ROOM;
void fulldown(object me);
void create()
{
        set("short", "绮梦山庄");
        set("long", @LONG
这里是绮梦山庄的大厅，厅很大，布置的极有气派，正对厅门是一面屏风，
屏风上画的是一片云雾缭绕的山峰，十分的险恶，看上去有些象华山，可
又比华山多了些秀美。屏风前是一把高大的紫檀木椅，上面有用紫绒布做
的靠垫，两边墙上挂满了名家书画，四角放着些花盆，屋角又吊了些铜铃
香袋，整个大厅除了这些，没有别的摆设，空空荡荡中弥漫着一股香气。
LONG
        );
        set("exits", ([
                "southwest":__DIR__"qimeng2",
        ]));
        set("objects", ([
                __DIR__"npc/qimeng" : 1,
        ]));
        setup();

}

int valid_leave(object me, string dir)
{
        if( userp(me))  
        if( dir == "southwest" )
        {
                me->set_temp("wangsha/wfrom","north");
                return 1;
        }
        else
        {
                me->set_temp("wangsha/wfrom","south");
                return 1;
        }
        return 1;
}

void fulldown(object me)
{
        call_out("fulldown2",1,me);
}

void fulldown2(object me)
{
        object room;
        object girl = present("yu girl",this_object());
        if (objectp(girl)){
                message_vision(CYN"$N突然尖叫一声，跌入了陷阱．．．\n"NOR,girl);
                destruct(girl);
        }
        tell_object(me,"你突然脚下一空....\n");
        message("vision",me->name()+"脚下一空，跌入了陷阱中。\n",environment(me),me);
        if (!objectp(room = find_object(__DIR__"dirao")))
                room = load_object(__DIR__"dirao");
        me->move(room);
        me->unconcious();
        message("vision",me->name()+"扑通一声跌了下来。\n",room,me);
        if (userp(me) && me->query("gender")=="男性"){
                message("vision",me->name()+"又扑通一声，跌了下去。\n",room,me);
                if (!objectp(room = find_object(__DIR__"bedroom")))
                        room = load_object(__DIR__"bedroom");
                me->move(room);
                message("vision",me->name()+"扑通一声跌了下来。\n",room,me);
        }
        if (!objectp(room = find_object(__DIR__"badboat")))
                room = load_object(__DIR__"badboat");
        room->reset();
}

