//shanjiao2.c written by john darks
inherit ROOM;

void create()
{
	set("short", "天柱山脚");
        set("long",@LONG
顺着一条坎坷小路，你走得离山更近了。天柱山的四个侧峰逐渐的显
露出来。侧峰气势雄伟，环绕着主峰。山峰中隐隐约约可以看到黄色、白
色的小点。离的太远，看得不真切。
LONG
        );
	set("outdoors", "tianzhu");
        set("exits", ([
		"northwest" : __DIR__"shanroad1",
		"southwest" : __DIR__"tulu2",
        ]));
        set("no_clean_up",0);
        setup();
}

void init()
{	
	object ob,room;
	if( interactive( ob = this_player()) && ob->query_temp("wangsha/wfrom")=="south"){
		set ("long", @LONG
顺着一条坎坷小路，你走得离山更近了。天柱山的四个侧峰逐渐的显
露出来。侧峰气势雄伟，环绕着主峰。山峰中隐隐约约可以看到黄色、白
色的小点。离的太远，看得不真切。
LONG);	
	}else{
		set ("long", @LONG
从天柱峰下来，渐渐接近山脚，已经可以看见不远处的平原了。
LONG);
	}
}

int valid_leave(object me, string dir)
{
	if( userp(me))	
	if( dir == "northwest" )
	{
		me->set_temp("wangsha/wfrom","south");
        	return 1;
	}
	else if( dir == "southwest" )
	{
		me->set_temp("wangsha/wfrom","north");
        	return 1;
	}
	return 1;
}

