//shenmigu.c written by john darks
inherit ROOM;
void create() {
  set("short", "神秘谷谷口");
  set("long", @LONG
山路走到这里，拐入了一个谷中。谷里烟气弥漫。似有种很神秘之物
在此间隐藏。由于烟气弥漫，进入者将会丧失方向感，所以一般的人走到
了这里也就是该回头的时候了。在东边方向似乎有条小路通往谷的深处。
LONG
  );
  set("outdoors", "tianzhu");
  set("exits", ([
    "south": __DIR__ "qilinyan",
  ]));
  set("item_desc", ([
    "xiaolu": "小路向东而去，似乎是被人踩出来的，看来是唯一通往谷中的道路了。\n",
    "road": "小路向东而去，似乎是被人踩出来的，看来是唯一通往谷中的道路了。\n",
    "小路": "小路向东而去，似乎是被人踩出来的，看来是唯一通往谷中的道路了。\n",
  ]));
  set("no_clean_up", 0);
  setup();
}

void init() {
  object ob;
  if (interactive(ob = this_player()) && ob->query_temp("wangsha/wfrom") == "south") {
    set("long", @LONG
山路走到这里，拐入了一个谷中。谷里烟气弥漫。似有种很神秘之物
在此间隐藏。由于烟气弥漫，进入者将会丧失方向感，所以一般的人走到
了这里也就是该回头的时候了。在东边方向似乎有条小路通往谷的深处。
LONG);
  } else {
    set("long", @LONG
茫然间居然到了谷口，虽然烟气仍然弥漫，但前面的路已显露出来。一阵
微微的山风吹来，不禁让人精神一振。
LONG);
  }
  if (interactive(this_player())) {
    remove_call_out("dropleaf");
    call_out("dropleaf", random(10) + 10, this_player());
  }
  add_action("do_east", "east");
}

void dropleaf(object me) {
  object leaf;
  if (me)
    if (environment(me) == this_object()) {
      tell_object(me, "一片树叶随风飘下．．．．\n");
      leaf = present("leaf", this_object());
      if (objectp(leaf))
        leaf->add_amount(1);
      else {
        leaf = new(__DIR__ "obj/leaf");
        leaf->move(this_object());
      }
      call_out("dropleaf", random(10) + 10, me);
    }
}

int valid_leave(object me, string dir) {
  if (userp(me))
    if (dir == "south") {
      me->set_temp("wangsha/wfrom", "north");
      return 1;
    } else {
      me->set_temp("wangsha/wfrom", "south");
      return 1;
    }
  return 1;
}

int do_east(string arg) {
  object me;
  object room;
  me = this_player();
  message_vision("$N沿着东面的一条小道没入了谷的深处。\n", me);
  room = find_object(__DIR__ "shenmi2");
  if (!room) room = load_object(__DIR__ "shenmi2");
  if (room) {
    me->move(room);
    me->set_temp("wangsha/wfrom", "south");
    message("vision", me->name() + "走了过来。\n", environment(me), me);
    return 1;
  } else return 0;
}
