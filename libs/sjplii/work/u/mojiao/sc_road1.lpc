inherit ROOM;
void create()
{
	set("short", "暗道");
        set("long",@LONG
一条深远的地道，两边的磷灯将地道照的通亮。
LONG
        );
        set("exits", ([
		"north" : __DIR__"xuantian",
        ]));
        set("no_clean_up",0);
        setup();
}

int valid_leave(object me, string dir)
{
	if( userp(me))	
	if( dir == "north" )
	{
		me->set_temp("wangsha/wfrom","south");
        	return 1;
	}
	else
	{
		me->set_temp("wangsha/wfrom","north");
        	return 1;
	}
	return 1;
}