//shanroad3.c written by john darks
inherit ROOM;
void create()
{
	set("short", "山路");
        set("long",@LONG
山路依旧延伸，山间的几只飞鸟被你的脚步惊醒，鸣叫着在山中飞来
飞去。引得一时之间百鸟争鸣。很有意思。山路不知道从哪里起被铺上了
细小的石头块儿。
LONG
        );
	set("outdoors", "tianzhu");
        set("exits", ([
		"northwest" : __DIR__"tianshi",
		"southdown" : __DIR__"shanroad2",
        ]));
        set("no_clean_up",0);
        setup();
}

void init()
{	
	object ob,room;
	if( interactive( ob = this_player()) && ob->query_temp("wangsha/wfrom")=="south"){
		set ("long", @LONG
山路依旧延伸，山间的几只飞鸟被你的脚步惊醒，鸣叫着在山中飞来
飞去。引得一时之间百鸟争鸣。很有意思。山路不知道从哪里起被铺上了
细小的石头块儿。
LONG);	
	}else{
		set ("long", @LONG
山路渐渐狭小，山间的几只飞鸟被你的脚步惊醒，鸣叫着在山中飞来
飞去。引得一时之间百鸟争鸣。很有意思。山路上铺着的细小的石头块儿
也渐渐少了。
LONG);
	}
}

int valid_leave(object me, string dir)
{
	if( userp(me))	
	if( dir == "northwest" )
	{
		me->set_temp("wangsha/wfrom","south");
        	return 1;
	}
	else
	{
		me->set_temp("wangsha/wfrom","north");
        	return 1;
	}
	return 1;
}

