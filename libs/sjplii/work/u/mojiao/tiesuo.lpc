//tiesuo.c written by john darks
#include <ansi.h>
#include <login.h>
inherit ROOM;
void create()
{
	set("short", "铁索桥");
        set("long",@LONG
这铁桥有个奇怪的名称，叫“命难求”。听说是因为这铁桥没架之前
只有一个小木板桥，人走在上面左右乱晃，掉下去摔死过不少人。这座铁
桥好像是那山上的帮派建造的。
LONG
        );
	set("outdoors", "tianzhu");
        set("exits", ([
		"northwest" : __DIR__"shanlu1",
		"eastdown" : __DIR__"shanroad4",
        ]));
        setup();
}

void init()
{
	add_action("do_go","go");
}

int valid_leave(object me, string dir)
{
	
	if( userp(me))	
	if( dir == "northwest" )
	{
		me->set_temp("wangsha/wfrom","south");
	}
	else
	{
		me->set_temp("wangsha/wfrom","north");
	}
	return 1;
}

int do_go()
{	
	object *inv,me;
	object ob,room,room1,corpse;
	int i,lvl;
	me = this_player();
	lvl = random((int)me->query_skill("move"));
	if(!userp(me)) return 1;
	if (lvl < 50 && !random(5)){
		room = find_object(__DIR__"fulldown");
		if (!room) room = load_object(__DIR__"fulldown");
		message_vision("$N脚下一滑，在铁索桥上晃了晃，大叫一声，落入了无底的深渊．．\n",me);
		me->move(room);
		tell_object(me,HIW"你不断的往下落！\n"NOR);
		me->set_temp("wangsha/wfrom","south");
		message("vision",me->name()+"掉了下来。\n",environment(me),me);
		for (i=0 ; i<7 ; i++){
			"/cmds/std/look"->look_room(me,room);
			tell_object(me,HIW"你不断的往下落！\n"NOR);
			if (i == 3 ){
				if( random(me->query_kar()+10) > 30){
					tell_object(me,HIR"你惊恐中突然看见半空中横出的树条，情急中伸手一抓，结果砰的一声撞在了树枝上。\n"NOR);
					message("vision",me->name()+"慌乱中抓住了从悬崖边上伸出来的树枝！\n",environment(me),me);
					room = find_object(__DIR__"midtree");
					if (!room) room = load_object(__DIR__"midtree");
					me->move(room);
					me->set_temp("mojiao/midtree",1);
					message("vision",me->name()+"从上面掉了下来，挂在了树枝上。\n",environment(me),me);
					me->unconcious();
					return 1;
				}
			}else {
				me->set_temp("mojiao/midtree",0);
				room1 = find_object(__DIR__"midtree");
				if (!room1) room1 = load_object(__DIR__"midtree");
				tell_room(room1, me->name() + "尖叫着从树边直堕了下去．．．．\n");
			}
		}
		if (!me->query_temp("mojiao/midtree")){
			room = find_object(__DIR__"yadi");
			if (!room) room = load_object(__DIR__"yadi");
			me->move(room);
			tell_object(me,HIR"你从空中重重的落了下去．．．．\n"NOR);
			message("vision",me->name()+"从上面直掉了下来，啪的一声摔在了地上．．．．\n",environment(me),me);
			if( random(me->query_kar()+10) < 20){

				message_vision("\n$N死了。\n\n", me);
				CHANNEL_D->do_channel(this_object(), "rumor",me->name(1) + "在天柱山摔死了！\n");
				if( objectp(corpse = CHAR_D->make_corpse(me, me)) )
					corpse->move(environment());
				me->remove_all_killer();
				me->dismiss_team();
				me->set("gin", 1);	me->set("eff_gin", 1);
				me->set("kee", 1);	me->set("eff_kee", 1);
				me->set("sen", 1);	me->set("eff_sen", 1);
				me->be_ghost(1);
				me->save();
				me->move(DEATH_ROOM);
				DEATH_ROOM->start_death(me);
			}else 	me->unconcious();
			return 1;
		}
	}
	if(lvl < 200){
		message_vision("$N脚下一滑，在铁索桥上晃了晃．．\n",me);
		write("还好，没掉下去！\n");
		return 0;
	}
	else return 0;
}
