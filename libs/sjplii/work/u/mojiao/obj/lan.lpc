// lan.c written by john darks
inherit ITEM;
inherit F_FOOD;
void create()
{
        set_name("倒吊兰", ({ "daodiao lan ","lan" ,"倒吊兰"}) );
        set_weight(8000);
        if( clonep() )
                set_default_object(__FILE__);
        else {
                set("long", "一朵发出淡淡幽香的倒吊兰\n");
                set("unit", "朵");
                set("value", 15);
                set("food_remaining", 5);
                set("food_supply", 1000);
        }
}



