#include <ansi.h>
#include <weapon.h>
inherit HAMMER;
void create() {
  set_name(BLU "黑木" NOR, ({ "blackwood" }));
  set_weight(30000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long", "八魔之一，入手沉实，实有异一般的木头。\n");
    set("material", "steel");
    set("rigidity", 100000);
    set("bamo", 1);
    set("weapon_prop/agility", 2);
    set("weapon_prop/courage", 1);
    set("weapon_prop/composure", 2);
  }
  init_hammer(60);
  setup();
}

void init() {
  add_action("do_du", "du");
  add_action("do_du", "study");
}

int do_du(string arg) {
  object me = this_player();
  object ob;
  string book;
  int level, sena;

  if (me->is_fighting()) {
    write("你无法在战斗中专心下来研读新知！\n");
    return 1;
  }
  if (me->is_busy()) {
    write("你上一个动作还没有完成，不能研读新知。\n");
    return 1;
  }
  if (!arg || sscanf(arg, "%s %d", book, sena) != 2) {
    write("指令格式：study <物品> <神数量>\n");
    return 1;
  }
  if (!objectp(ob = present(book, me))) {
    return 0;
  }
  if (!me->query_skill("literate", 1)) {
    write("你看不懂耶．．，先学学识字吧。\n");
    return 1;
  }
  level = me->query_skill("bamohuantian", 1);
  if (level < 70 || ob->query("ownerman") != me->query("id")) {
    write("你看了半天，结果什么也没看懂。\n");
    return 1;
  }
  if ((int)me->query("combat_exp") < (int)level * level * level / 2) {
    write("你的实战经验不足，再怎么读也没用。\n");
    return 1;
  }
  if (sena < 20) {
    write("你至少要花二十点神\n");
    return 1;
  }
  if (me->query("sen") < sena) {
    write("你现在过於疲倦，无法专心下来研读。\n");
    return 1;
  }
  if (level < 100) {
    me->receive_damage("sen", sena);
    write("你研读木头上的图案字符，颇有心得。\n");
    me->improve_skill("bamohuantian", (int)me->query_skill("literate", 1) / 5 + sena);
    return 1;
  } else {
    write("你研读了一会儿，但是发现上面所说的对你而言都太浅了，没有学到任何东西。\n");
    return 1;
  }
}
