// tianhu_b.c
inherit BULLETIN_BOARD;
#include <ansi.h>
void create() {
  set_name(GRN "八魔环天柱" NOR, ({ "stone" }));
  set("location", "/u/mojiao/qilinyan");
  set("board_id", "tianhu_b");
  set("long", "这是一条石柱，柱子上刻着一个巨大的图腾，
好像是个很抽象的动物的图案。\n");
  set("capacity", 49);
  setup();
  replace_program(BULLETIN_BOARD);
}
