// xuantian.c written by john darks
#include <ansi.h>
inherit ITEM;
int query_autoload() { return 1; }
void create() {
  set_name(HIM "玄天牌" NOR, ({ "xuantian pai", "pai" }));
  set_weight(3000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "块");
    set("long",
      "沉甸甸的一块铁片，上面写着(fly)，象征着你玄天童子的身份\n");
    set("no_get", 1);
    set("no_drop", 1);
    set("material", "stone");
  }
}

void init() {
  if (this_player() == environment() && this_player()->query("mojiao/xtkid"))
    add_action("do_fly", "fly");
}

int do_fly() {
  object room, croom, nextroom, *allroom;
  mapping exits;
  int i;
  string str, *dirs, *thisdir;
  object me = this_player();
  croom = environment(me);
  if (!croom->query("outdoors"))
    return notify_fail("这里飞不起来！\n");
  if (me->query_wait())
    return notify_fail("你现在无法随意行动。\n");

  if (croom->query("owner"))
    return notify_fail("你已经在空中了！\n");
  //取出出口(  down 除外)
  if (mapp(exits = croom->query("exits"))) {
    dirs = keys(exits);
    for (i = 0; i < sizeof(dirs); i++)
      if (dirs[i] != "down")
        if (sizeof(thisdir) == 0)
          thisdir = ({ dirs[i] });
        else
          thisdir += ({ dirs[i] });
  }
  //取出player的空间
  allroom = children(__DIR__ "null");
  if (sizeof(allroom)) {
    for (i = 0; i < sizeof(allroom); i++)
      if (allroom[i]->query("owner") == me->query("id")) {
        room = allroom[i];
        break;
      } else continue;
  }
  if (!room) {
    room = new(__DIR__ "null");
    room->set("owner", me->query("id"));
  }
  room->set("short", croom->query("short") + "的上空");
  //空间出口的设定
  for (i = 0; i < sizeof(thisdir); i++) {
    if (!objectp(nextroom = find_object(exits[thisdir[i]])))
      nextroom = load_object(exits[thisdir[i]]);
    if (i == 0) {
      str = "   往 " CYN + to_chinese(thisdir[i]) + NOR " 是" + nextroom->query("short") + "\n";
      room->set("exits", ([
        thisdir[i]: file_name(nextroom),
      ]));
    } else {
      str += "   往 " CYN + to_chinese(thisdir[i]) + NOR " 是" + nextroom->query("short") + "\n";
      room->add("exits", ([
        thisdir[i]: file_name(nextroom),
      ]));
    }
  }
  room->add("exits", ([
    "down": file_name(croom),
  ]));
  room->set("long", "你飘飘然的浮在空中．．．．\n\n" + str);
  message_vision("$N轻飘飘的浮了起来，跳上了云头．．．\n", me);
  me->move(room);
  return 1;
}
