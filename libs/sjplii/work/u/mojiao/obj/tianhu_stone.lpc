// tianhu_b.c
inherit ITEM;
#include <ansi.h>
void create() {
  set_name(GRN "八魔环天柱" NOR, ({ "totem", "图腾" }));
  set("long", "这是一条石柱，柱子上刻着一个巨大的图腾，
好像是个很抽象的动物的图案。\n");
  set("no_shown", 1);
  set("no_get", 1);

  if (clonep())
    set_default_object(__FILE__);
  else {
    set("skill", ([
      "name": "bamohuantian",
      "exp_required": 10000,
      "sen_cost": 35,
      "difficulty": 30,
      "max_skill": 49,
    ]));
  }
  setup();
}

void init() {
  add_action("do_study", "study");
}

int do_study(string arg) {
  object me = this_player();
  if (me->query_skill("bamohuantian", 1) < 20) {
    write("你的八魔环天大法等级不够，没法研读此功。\n");
    return 1;
  }
  return 0;
}
