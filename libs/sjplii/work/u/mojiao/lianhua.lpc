//lianhua.c written by john darks
inherit ROOM;
void create()
{
	set("short", "莲花峰");
        set("long",@LONG
这里就是莲花峰的峰顶了。四周的山石成莲花般的突出在峰顶的四周。
加上山石上青苔叠生。这里又被人称为青莲峰。而峰顶又叫青莲台。此峰
被云雾环绕，在远处看来，还真如同一朵青莲绽放于云中呢。
LONG
        );
	set("outdoors", "tianzhu");
        set("exits", ([
		"westdown" : __DIR__"yixiantian",
		"southdown" : __DIR__"shanlu2",
        ]));
        set("objects",([
	 	__DIR__"npc/huo" : 1,
	 	__DIR__"npc/mi":1,
	]));
        set("no_clean_up",0);
        setup();
}

int valid_leave(object me, string dir)
{
	if( userp(me))	
	if( dir == "southdown" )
	{
		me->set_temp("wangsha/wfrom","south");
        	return 1;
	}
	else
	{
		me->set_temp("wangsha/wfrom","north");
        	return 1;
	}
	return 1;
}