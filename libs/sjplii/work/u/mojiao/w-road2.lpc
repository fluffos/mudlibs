inherit ROOM;

void create() {
  set("short", "上山石级");
  set("long", @LONG
这是一条长长的上山石级。一直通到山上。两旁怪石嶙峋，长满青苔。
山壁非常陡峭。
LONG
  );
  set("exits", ([ /* sizeof() == 2 */
    "westdown": __DIR__ "w-road1",
    "northup": __DIR__ "w-road3",
  ]));
  set("no_clean_up", 1);
  set("objects", ([
    __DIR__ "npc/jiaotu": 2,
  ]));

  set("no_clean_up", 1);
  setup();
  //	replace_program(ROOM);
}
int valid_leave(object me, string dir) {
  object ob;
  if (dir == "northup" && present("mojiao dizi", environment(me)) && me->query_temp("weapon")) {
    write("魔教弟子一手拦住，说道；“进入本教总坛必须放下武器！”\n");
    ob = me->query_temp("weapon");
    message_vision("$N手上的" + ob->name() + "被魔教弟子没收了。\n\n", me);
    destruct(ob);
    return 1;
  }
  if (dir == "northup" && present("mojiao dizi", environment(me)) &&
    (present("sword", me) || present("blade", me) || present("whip", me) ||
      present("stick", me) || present("staff", me)))
    return notify_fail("魔教弟子一手拦住，嘿嘿冷笑道；“留下你身上带的武器！”\n");

  return ::valid_leave(me, dir);
}
