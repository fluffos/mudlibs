//yadi.c written by john darks
inherit ROOM;
void create()
{
	set("short", "崖底小路");
        set("long",@LONG
这是一条谷间的小路，说是小路其实是山谷的延伸罢了，但也颇有点
幽谷通径的感觉。沿着山谷行进，远处忽然隐隐传来流水之声。
LONG
        );
        set("exits", ([
        	"southwest": __DIR__"yadi",
        	"north":     __DIR__"waterfull",
        ]));
	set("outdoors", "tianzhu");
        setup();
}

void init()
{	
	object ob;
	if( interactive( ob = this_player()) && ob->query_temp("wangsha/wfrom")=="south"){
        set("long",@LONG
这是一条谷间的小路，说是小路其实是山谷的延伸罢了，但也颇有点
幽谷通径的感觉。沿着山谷行进，远处忽然隐隐传来流水之声。
LONG);	
	}else{
		set ("long", @LONG
沿着山谷行进，身后滔滔水声渐渐小了下去，山谷也渐渐幽深起来。
LONG);
	}
}

int valid_leave(object me, string dir)
{
	if( userp(me))	
	if( dir == "north" )
	{
		me->set_temp("wangsha/wfrom","south");
        	return 1;
	}
	else
	{
		me->set_temp("wangsha/wfrom","north");
        	return 1;
	}
	return 1;
}


