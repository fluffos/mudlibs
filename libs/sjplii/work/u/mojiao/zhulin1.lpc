#include <ansi.h>
#include <room.h>
inherit ROOM;

void create() {
  set("short", "紫竹林");
  set("long", @LONG
在不大的一个小石土坡上，生长着茂密的竹林。竹子是细长的紫竹。
山中水气弥漫。置身竹林之中，如入仙境，恍惚之间，你仿佛置身于观音
大士的紫竹林一般。
LONG
  );
  set("outdoors", "tianzhu");
  set("exits", ([
    "northwest": __DIR__ "zimitan",
    "south": __DIR__ "shilin2",
  ]));
  /*
	set("objects",([
	 	__DIR__"npc/master" : 1,
	]));
*/
  setup();
  replace_program(ROOM);
}
