//downriver2.c written by john darks
inherit ROOM;
void create()
{
	set("short", "水潭中");
        set("long",@LONG
水潭中极为清晰,依稀可以看到一条水道向北而去。
LONG
        );
        set("exits", ([
        	"up" : __DIR__"waterfull",
		"north" : __DIR__"downriver4",
        ]));
        set("resource/water",1);
        set("no_clean_up",0);
        setup();
}

void init()
{	
	object ob,room;
	if( interactive( ob = this_player()) && ob->query_temp("wangsha/wfrom")=="south"){
		set ("long", @LONG
水潭中极为清晰,依稀可以看到一条水道向北而去。	
LONG);	
	}else{
		set ("long", @LONG
水潭中极为清晰,依稀可以看到一条水道向北而去。头顶一片亮光，应
该就是出口了。
LONG);
	}
}

int valid_leave(object me, string dir)
{
	object room;
	if( userp(me))	
	if( dir == "north" )
		me->set_temp("wangsha/wfrom","south");
	else	me->set_temp("wangsha/wfrom","north");
	return 1;
}

