
inherit ROOM;

void create()
{
	set("short", "广场");
	set("long", @LONG
这是一片用青石板铺成的开阔空地。北面就是圣教的议事大厅。
LONG
	);
	set("exits", ([ /* sizeof() == 2 */
  "west" : __DIR__"yabian",
  "east" : __DIR__"caodi",
  "north" : __DIR__"hall",
  "southdown" :  __DIR__"w-road3",
]));
	set("no_clean_up", 0);
	set("objects",([
//		__DIR__"npc/dingde":1,
//		__DIR__"npc/zhao":1,
	]));


	setup();
//	replace_program(ROOM);
}

int valid_leave(object me,string dir)
{
	 object ob;
	 ob = present("dingde",environment(me));
	 if(me->query("gender")=="女性" && me->query("per")>27 )
		 return ::valid_leave(me,dir);
        if( ob ) if( ob->query_temp("block_msg/all"))
		 return ::valid_leave(me,dir);
        if( me->query("class")=="girl" )
		 return ::valid_leave(me,dir);
        if(dir=="north" && ob && me->query("class")!="mojiao" )  {
             return notify_fail( "丁德一手拦住：“非本教中人不得内进！”\n\n ");
		}
	 if( dir=="north" && ob && me->query("title")=="魔教弟子") {
             return notify_fail( "丁德一手拦住：“你未够资格参见教主！”\n\n ");			
		}
        return ::valid_leave(me,dir);
}

