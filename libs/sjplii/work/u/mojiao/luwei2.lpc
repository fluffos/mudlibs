inherit ROOM;
void create()
{
	set("short", "芦苇地");
        set("long",@LONG
这里是一片芦苇地，一边是遄急的激流，一边似乎通往芦苇外。
LONG
        );
	set("outdoors", "tianzhu");
        set("exits", ([
		"west" : __DIR__"river",
        ]));
        set("resource/water",1);
        set("no_clean_up",0);
        setup();
}

int valid_leave(object me, string dir)
{
	if( userp(me))	
	if( dir == "west" )
	{
		me->set_temp("wangsha/wfrom","north");
        	return 1;
	}
	else
	{
		me->set_temp("wangsha/wfrom","south");
        	return 1;
	}
	return 1;
}

