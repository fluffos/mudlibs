//hole1.c written by john darks
inherit ROOM;
void create()
{
        set("short", "山洞");
        set("long",@LONG
黑不隆冬的，什么也看不清，潮湿且幽深。
LONG
        );
        set("outdoors", "tianzhu");
        set("exits",([
                "west" : __DIR__"midtree",
        ]));
        setup();
}

void init()
{
        add_action("do_search", "search");
}

int do_search(string arg)
{
        int     kar;
        object  wood;
        if(!arg && query("research")) {
                kar = this_player()->query("kar");
                if(random(kar+500) < kar) {
                        message_vision("在黑暗中$N四处摸索，突然$N触到了石壁上的一块什么东西。\n", this_player());
                        message_vision("$N立刻拿起纳入怀中。\n", this_player());
                        wood = new(__DIR__"obj/blackwood");
                        wood->set("ownerman",this_player()->query("id"));
                        wood->move(this_player());
                        set("research",0);
                        return 1;
                }
        }
        return notify_fail("\n你在黑暗中四处摸索，却甚麽都没发现。\n");
}

void reset()
{
        ::reset();
        if(!random(20)) set("research",1);
}


