#include <ansi.h>
#include <room.h>
inherit ROOM;

void create()
{
	set("short", "天玄坛");
        set("long",@LONG
灰白色的石头堆砌成一个八角祭坛。这里的四周立着四根白色石柱。
有一个柱子上雕刻了一只龙形图案。不知道为什么，坛的四周的水气比别
处要重的多，整个坛好像被封闭在一个水球之中似的，到处都是雾蒙蒙的。
LONG
        );
	set("outdoors", "tianzhu");
        set("exits", ([
		"northwest" : __DIR__"feilai",
		"south" : __DIR__"qinglian",
        ]));
/*
	set("objects",([
	 	__DIR__"npc/master" : 1,
	]));
*/
        setup();
        replace_program(ROOM);
}
