//xuantian.c written by john darks
#include <ansi.h>
inherit ROOM;
void create()
{
	set("short", "玄天峰");
        set("long",@LONG
此处名谓玄天峰，传闻玄天真人在此得道飞天而得名。据传峰顶的圆
形空地就是那时形成的。魔教中人后来往往在此膜拜，纪念玄天真人。北
面云烟弥漫，看不真切。
LONG
        );
	set("outdoors", "tianzhu");
        set("exits", ([
		"southdown" : __DIR__"feilai",
		"northup" : __DIR__"zoulang1",
        ]));
        set("objects", ([
                __DIR__"npc/long" : 1,
                __DIR__"npc/dizi120000":2,
                __DIR__"npc/dizi250000":2,
        ]));
        setup();
}

void init()
{
	add_action("do_mobai", "mobai");
}

int do_mobai()
{
       	object me,pai;
       	mapping my,myskill;
       	string *dirs;
       	int i;
       	me = this_player();
       	if((int) me->query("sen") <=50)
        	return notify_fail("你的神不够。\n");
       	message_vision("$N虔诚地跪下来磕了个头。\n" ,me);
       	me->receive_damage("sen",50);
       	me->add("bellicosity", - random((int)me->query("kar") ) );
       	if( (int)me->query("bellicosity") < 0) 
       		me->set("bellicosity",0);
       	message_vision("$N身上的杀孽之气似乎轻了。\n" , me);
       	me->add("mojiao/mobai",1);
       	if ((int)me->query("mojiao/mobai") > 20 + random(40)){
       		message("vision",HIW"\n一道白光之地窜起，直冲天际！\n\n"NOR,this_object());
       		if (me->query_skill("unarmed",1) > 199
       			&& me->query_skill("literate",1) > 199
       			&& me->query_skill("move",1) > 199
       			&& me->query_skill("force",1) > 199
       			&& me->query("bellicosity") == 0
       			&& me->query("combat_exp") > 1200000
       			&& !me->query("mojiao/xtkid")){
       			myskill = me->query_skill_map();
       			dirs = keys(myskill);
       			for (i=0 ; i<sizeof(dirs); i++)
       				me->map_skill(dirs[i]);
       			myskill = me->query_skills();
       			dirs = keys(myskill);
       			for (i=0 ; i<sizeof(dirs); i++)
       				me->delete_skill(dirs[i]);
       			//newbie reset
       			me->set("tol",me->query("tol") > 30 ?30:me->query("tol"));
			me->set("fle",me->query("fle")  > 30 ?30:me->query("fle") );
			me->set("agi",me->query("agi")  > 30 ?30:me->query("agi") );
			me->set("dur",me->query("dur")  > 30 ?30:me->query("dur") );
			me->set("int",me->query("int")  > 30 ?30:me->query("int") );
			me->set("str",me->query("str")  > 30 ?30:me->query("str") );
			me->set("con",me->query("con")  > 30 ?30:me->query("con") );
			me->set("spi",me->query("spi")  > 30 ?30:me->query("spi") );
			me->set("per",me->query("per")  > 30 ?30:me->query("per") );
			me->set("cor",me->query("cor")  > 30 ?30:me->query("cor") );
			me->set("cps",me->query("cps")  > 30 ?30:me->query("cps") );
			me->set("kar",me->query("kar")  > 30 ?30:me->query("kar") );
			me->set("race","赛亚人");
			me->set("title","玄天童子");
        		me->set("again_birthday", time());
        		me->set("age_modify",10 - (int)me->query("age"));
        		me->set("potential", 110);
        		me->set("learned_points",10);
        		me->set("combat_exp", 50);
        		me->set("mojiao/combat_exp",100000);
        		me->add("mojiao/忠心",130000);
        		me->set("mojiao/task",500);
        		me->set("betrayer", 0);
        		me->set_skill("bamohuantian",10);
        		me->set_skill("literate",200);
        		me->map_skill("literate","bamohuantian");
        		me->set_temp("mojiao/mobai",0);
        		me->set("mojiao/xtkid",1);
        		//finished reset
        		me->save();
        		tell_object(me,HIR"一股暖流流遍了你的全身，你转世了！\n"NOR);
        		me->unconcious();
        		pai = new(__DIR__"obj/xuantian");
        		pai->move(me);
       		}
       		if (me->query("mojiao/xtkid"))
       			if (!(objectp(pai = present("xuantian pai",me)))){
       				pai = new(__DIR__"obj/xuantian");
       				pai->move(me);
       				tell_object(me,HIY"一股暖流流遍了你的全身。\n"NOR);
       			}
	}       		
	return 1;
}

void reset()
{
	object *inv;
	int i;
	inv = all_inventory(this_object());
	for (i=0; i<sizeof(inv); i++)
		if( userp(inv[i]))
			inv[i]->set_temp("mojiao/mobai",0);
	::reset();
}
