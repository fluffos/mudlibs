#include <ansi.h>
#include <room.h>
inherit ROOM;

void create() {
  set("short", "天柱峰");
  set("long", @LONG
天柱峰高耸直入云霄，宛如一根顶天立地的石柱。此峰是五峰之中的
最高的主峰，群山环绕而突兀而出。这里四周密林丛生，野兔黄狼时不时
的从你的面前急速而过。
LONG
  );
  set("outdoors", "tianzhu");
  set("exits", ([
    "north": __DIR__ "tianchi",
    "eastup": __DIR__ "tianzhu2",
  ]));
  /*
	set("objects",([
	 	__DIR__"npc/master" : 1,
	]));
*/
  setup();
}
