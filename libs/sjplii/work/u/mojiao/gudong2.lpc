//gudong2.c written by john darks
inherit ROOM;
void create() {
  set("short", "石牛古洞");
  set("long", @LONG
这里是石牛古洞，洞里曲折不平，加上阴暗潮湿。实在让人看不清楚
景物，背后隐隐有点天光自洞外泄进来。
LONG
  );
  set("outdoors", "tianzhu");
  set("exits", ([
    "north": __DIR__ "gudong3",
    "out": __DIR__ "gudong1",
  ]));
  set("no_clean_up", 0);
  setup();
}

void init() {
  object ob, room;
  if (interactive(ob = this_player()) && ob->query_temp("wangsha/wfrom") == "south") {
    set("long", @LONG
这里是石牛古洞，洞里曲折不平，加上阴暗潮湿。实在让人看不清楚
景物，背后隐隐有点天光自洞外泄进来。
LONG);
  } else {
    set("long", @LONG
这里是石牛古洞，洞里曲折不平，加上阴暗潮湿。实在让人看不清楚
景物，前面终于隐隐有点天光自洞外泄进来。
LONG);
  }
}

int valid_leave(object me, string dir) {
  if (userp(me))
    if (dir == "north") {
      me->set_temp("wangsha/wfrom", "south");
      return 1;
    } else if (dir == "out") {
      me->set_temp("wangsha/wfrom", "north");
      return 1;
    }
  return 1;
}
