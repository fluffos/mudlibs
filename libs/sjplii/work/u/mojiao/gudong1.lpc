//gudong1.c written by john darks
inherit ROOM;
void create()
{
	set("short", "石牛古洞");
        set("long",@LONG
这里四面环山，黑洞洞的一个石洞在山壁上映着。一阵阵的阴冷山风
从洞里吹了出来。风中夹杂着一股奇怪的气味，有点像焦炭的味道，也有
点像野兽的气味，但是又让人说不清楚。
LONG
        );
        set("exits", ([
		"enter" : __DIR__"gudong2",
		"southeast" : __DIR__"tianshi",
        ]));
        set("outdoors","tianzhu");
        set("no_clean_up",0);
        setup();
}

int valid_leave(object me, string dir)
{
	if( userp(me))	
	if( dir == "enter" )
	{
		me->set_temp("wangsha/wfrom","south");
        	return 1;
	}
	else
	{
		me->set_temp("wangsha/wfrom","north");
        	return 1;
	}
	return 1;
}


