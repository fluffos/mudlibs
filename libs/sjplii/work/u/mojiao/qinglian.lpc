#include <ansi.h>
#include <room.h>
inherit ROOM;

void create() {
  set("short", "青莲诗崖");
  set("long", @LONG
在这个山峰的峰顶一侧有一个万丈山崖。这山崖一眼看不到底，底下
一片雾蒙蒙的。在这山崖的上面立着一块儿奇石。那是一块儿青绿色的石
头，上面还有一块儿细长红石。那绿石如莲，红石如蜓。想不到“小荷才
露尖尖角，早有蜻蜓立上头。”的诗句竟然在此是那么贴切。
LONG
  );
  set("outdoors", "tianzhu");
  set("exits", ([
    "north": __DIR__ "tianxuan1",
    "west": __DIR__ "qianzhang",
  ]));
  /*
	set("objects",([
	 	__DIR__"npc/master" : 1,
	]));
*/
  setup();
}
