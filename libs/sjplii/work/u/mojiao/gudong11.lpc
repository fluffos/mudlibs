inherit ROOM;
void create()
{
	set("short", "石牛古洞");
        set("long",@LONG
这里是石牛古洞，此洞名称的来历乃是因为在此有一个二十丈长的一
块儿石头。在入口处看来，如同一头在水中的水牛一般。看到此石，任谁
也要赞一声“造化神奇”。此时石上居然盘膝端坐着一人。
LONG
        );
        set("exits", ([
		"east" : __DIR__"gudong6",
		"west" : __DIR__"gudong7",
		"south" : __DIR__"gudong3",
        ]));
        set("valid_startroom", 1);
        set("no_fight",1);
        set("no_magic",1);
        set("no_sleep",1);
        set("NONPC",1);
        set("objects",([
        	__DIR__"npc/tianjun":1,
        ]));
        setup();
}

void init()
{	
	object ob;
	if(objectp(ob = present("master xu",this_object()))){
        set("long",@LONG
这里是石牛古洞，此洞名称的来历乃是因为在此有一个二十丈长的一
块儿石头。在入口处看来，如同一头在水中的水牛一般。看到此石，任谁
也要赞一声“造化神奇”。此时石上居然盘膝端坐着一人。
LONG);	
	}else{
		set ("long", @LONG
这里是石牛古洞，此洞名称的来历乃是因为在此有一个二十丈长的一
块儿石头。在入口处看来，如同一头在水中的水牛一般。看到此石，任谁
也要赞一声“造化神奇”。
LONG);
	}
}

int valid_leave(object me, string dir)
{
	if( userp(me))	
	if( dir == "south" )
	{
		me->set_temp("wangsha/wfrom","north");
        	return 1;
	}
	else
	{
		me->set_temp("wangsha/wfrom","south");
        	return 1;
	}
	return 1;
}

