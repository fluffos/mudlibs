//shanjiao1.c written by john darks
inherit ROOM;
void create() {
  set("short", "天柱山脚");
  set("long", @LONG
从这里远远望去，只见天柱山如同一墨柱直插天际。云雾在山间弥漫。
将山峰变得虚幻起来。无形中让你感觉到这山中透着股冷意。
LONG
  );
  set("outdoors", "tianzhu");
  set("exits", ([
    "northeast": __DIR__ "shanroad1",
    "southeast": __DIR__ "tulu2",
  ]));
  set("no_clean_up", 0);
  setup();
}

int valid_leave(object me, string dir) {
  if (userp(me))
    if (dir == "northeast") {
      me->set_temp("wangsha/wfrom", "south");
      return 1;
    } else {
      me->set_temp("wangsha/wfrom", "north");
      return 1;
    }
  return 1;
}
