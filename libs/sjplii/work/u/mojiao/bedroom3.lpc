//bedroom3.c written by john darks
inherit ROOM;
void fulldown(object me);
void create() {
  object con, item;
  set("short", "迷魂小屋");
  set("long", @LONG
这是卧室，轻罗帐，绿牙床，屋中陈设不多，但全部恰到好处，正中
的桌上一个青瓷官窑花瓶中错落有致的插着几束刚刚采来得野花，为屋子
凭添了一丝淡淡的清香，满是春意。
LONG
  );
  set("exits", ([
    "northwest": __DIR__ "qimeng4",
  ]));
  set("objects", ([
    __DIR__ "obj/vase": 1,
    __DIR__ "obj/flower": 1,
  ]));
  setup();
  con = present("vase", this_object());
  item = present("flower", this_object());
  item->set_amount(13 + random(30));
  item->move(con);
}

void reset() {
  object *inv;
  object con, item;
  ::reset();
  con = present("vase", this_object());
  inv = all_inventory(con);
  if (!sizeof(inv) && !random(10)) {
    item = new(__DIR__ "obj/banzhi");
    item->move(con);
  }
}
