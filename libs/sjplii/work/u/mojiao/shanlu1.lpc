//shanlu1.c  written by jhon darks
inherit ROOM;

void create()
{
	set("short", "山麓");
        set("long",@LONG
在乱石之中，一条微红的土路显露出来。路面上还铺着大大小小的花
石块儿。有的地方还铺上了青石台阶。山中雾气渐重。一阵微微的山风吹
过，带来一阵凉气。
LONG
        );
	set("outdoors", "tianzhu");
        set("exits", ([
		"northup" : __DIR__"qilinyan",
		"southeast" : __DIR__"tiesuo",
        ]));
        set("objects", ([
                __DIR__"npc/dizi5000" : 2,
                __DIR__"npc/dizi12000" : 2,
       	]) );
        set("no_clean_up",0);
        setup();
}

void init()
{	
	object ob;
	if( interactive( ob = this_player()) && ob->query_temp("wangsha/wfrom")=="south"){
        set("long",@LONG
在乱石之中，一条微红的土路显露出来。路面上还铺着大大小小的花
石块儿。有的地方还铺上了青石台阶。山中雾气渐重。一阵微微的山风吹
过，带来一阵凉气。
LONG);	
	}else{
		set ("long", @LONG
从麒麟岩下来，山中雾气渐散，前面的路也渐渐好走了。一阵微微的山风
吹过，带来一阵凉气，感觉极为邂意。
LONG);
	}
}

int valid_leave(object me, string dir)
{
	if( userp(me))	
	if( dir == "northup" )
	{
		me->set_temp("wangsha/wfrom","south");
        	return 1;
	}
	else
	{
		me->set_temp("wangsha/wfrom","north");
        	return 1;
	}
	return 1;
}

