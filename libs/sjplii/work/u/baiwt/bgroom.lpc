// Room: /u/baiwt/bgroom.c    baiwt@sjpl  3,13,2001

#include <ansi.h>
inherit ROOM;
void create()
{
	set("short", "闭关修行室");
	set("long", @LONG
这里是《书剑飘零》的闭关修行室，请使用“参悟”指令(canwu)来设定
当前自己的修炼项目。闭关中的玩家无需在线便可修行，但务必要在闭关时间
结束时到这里来，然后通过“出关”指令(chuguan)正常出关。若不能及时出
关，闭关时间有可能会重新计算。每当小周天运行到第十关，你指定的修行技
能就会得到提高。如果是修炼任督二脉，则必须等任督二脉达到十层时才能突
破内力上限。闭关时请勿同时练习其它技能，以免走火入魔。
LONG
	);
	set("no_clean_up", 0);
	set("no_fight", 1);
	set("no_magic", 1);
	set("no_steal", 1);
	set("no_study", 1);
	set("oldarea", 1);
	set("hell", 1);
	set("biguan_room", 1);
	setup();
//	replace_program(ROOM);
}

void init()
{
     add_action("out_bgroom", "chuguan");
     add_action("canwu_skill", "canwu");
     add_action("close_cmds", "set");
     add_action("close_cmds", "to");
     add_action("close_cmds", "suicide");
     add_action("close_cmds", "rumor");
     add_action("close_cmds", "sjpl");
     add_action("close_cmds", "sjpl*");
     add_action("close_cmds", "rumor*");
     add_action("close_cmds", "chat*");
     add_action("close_cmds", "chat");
     add_action("close_cmds", "bt");
     add_action("close_cmds", "fly");
}

int out_bgroom()
{
	int lvl;
	string skill,room;
	object me = this_player();

	"/cmds/usr/score"->main(me);
       if( me->query("biguan_begin") )
             return notify_fail("你正在闭关修行中，无法出关。\n");

	room=me->query("out_bgroom");

if( me->query("canwu_skill") )
{
skill=me->query("canwu_skill");
	if( me->query_skill(skill,1) )
	{
	lvl=(int)me->query_skill(skill,1);
		if( me->query("zhoutian_force")>9 && lvl < 300)
		{
		me->set_skill(skill,lvl+1);
		me->set("zhoutian_force",0);
		message_vision(HIW"\n$N参悟了"+to_chinese(skill)+"的更高境界。\n\n"NOR, this_player());
		}
		else
		message_vision(WHT"\n$N一个小周天运行完毕。\n\n"NOR, this_player());
	}
	else
	{
	if( skill == "rendu_mai" )
	{
		if( me->query("zhoutian_force")>9 )
		{
		me->add("rendu_mai",1);
		me->set("zhoutian_force",0);
		message_vision(HIW"\n$N进一步打通了"+to_chinese(skill)+"。\n\n"NOR, this_player());
		}
		else
		message_vision(WHT"\n$N一个小周天运行完毕。\n\n"NOR, this_player());
		if( me->query("rendu_mai")>9 )
		{
		message_vision(HIY"$N终于突破了内力的上限！\n\n"NOR, this_player());
		me->add("max_force",random(2)+1);
		me->set("rendu_mai",0);
		}
	}
	}
}

	if( room )
	{
	me->move(room);
	me->set("startroom", room);
	}
	else
	{
	me->set("startroom", "/d/city/ciensi.lpc");
	room=me->query("startroom");
	me->move(room);
	}
	message_vision(HIC"\n$N闭关修行完毕，出关了！\n\n"NOR, this_player());
	me->add("potential", random(100));	
	me->add("combat_exp", random(100));	
	return 1;
      
}
int canwu_skill(string arg)
{
	object me = this_player();
	if( !arg )     return notify_fail("你要参悟什么？\n");

	if( arg=="rendu_mai" )
	{
	if( me->query("max_force") < 1000 ) return notify_fail("你还没有能力打通任督二脉。\n");
	if( me->query("rendu_mai")>=10 ) return notify_fail("你已经打通了任督二脉，赶快出关吧。\n");
	me->set("canwu_skill",arg);
	message_vision(HIW"\n$N盘膝而坐，开始参悟"+to_chinese(arg)+"。\n\n"NOR, this_player());
	return 1;
	}
	else
	if( !me->query_skill(arg,1))
         return notify_fail("你没有学会这项技能。\n");
	me->set("canwu_skill",arg);
	message_vision(HIW"\n$N盘膝而坐，开始参悟"+to_chinese(arg)+"。\n\n"NOR, this_player());
	return 1;
}

int close_cmds(object me, string arg)
{
	return 1;
}
