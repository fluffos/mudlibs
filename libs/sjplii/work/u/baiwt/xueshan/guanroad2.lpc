inherit ROOM;

void create() {
  set("short", "青石官道");
  set("long", @LONG
这是一条宽敞坚实的青石大道，从这里已经可以遥望到神秘的，带
有传奇色彩的雪山.
LONG
  );
  set("exits", ([ /* sizeof() == 2 */
    "west": __DIR__ "guanroad3",
    "east": __DIR__ "guanroad",
  ]));
  set("outdoors", "xueshan");

  setup();
  //        replace_program(ROOM);
}
void init() {
  add_action("do_go", "go");

}

int do_go() {
  if (random(2)) {
    this_player()->move(this_object());
    return 1;
  }
}
