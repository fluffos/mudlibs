// hammer.c

#include <weapon.h>

inherit HAMMER;
#include <ansi.h>
void create() {
  set_name(HIG "粗树干" NOR, ({ "bigtrunk" }));
  set_weight(200000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "株");
    set("long", "这是一株沉重的粗树干，看上去相当坚实。\n");
    set("value", 300);
    set("material", "iron");
    set("wield_msg", "$N举起一株$n，试了试重量，然後握在手中。\n");
    set("unwield_msg", "$N放下手中的$n。\n");
  }

  init_hammer(125);
  setup();
}
