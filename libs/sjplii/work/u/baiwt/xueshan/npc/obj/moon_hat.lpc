// icy_band.c

#include <ansi.h>
#include <armor.h>

inherit HEAD;

void create()
{
	set_name( HIY "残月挂天斗笠" NOR, ({ "moon hat", "hat" }) );
	set_weight(200);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "顶");
		set("value", 4000);
		set("material", "cloth");
		set("armor_prop/armor", 2);
		set("armor_prop/dodge", 5);
	}
	setup();
}
