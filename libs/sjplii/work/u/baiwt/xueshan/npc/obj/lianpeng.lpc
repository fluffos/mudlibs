// medicine.c

inherit ITEM;

void create()
{
	set_name("翠莲蓬",({"green lotus"}));
        set_weight(60);
        if( clonep() )
                set_default_object(__FILE__);
	else {
	    set("long",
     	        "一株翠绿色的莲蓬，看上去如同碧玉一般。\n");
	    set("unit","株");
	    set("value", 2);
	}
}

void init()
{
  if(this_player()==environment())
	add_action("apply_medicine","eat");
}

int apply_medicine()
{
//	int value = 20;
//	int diff;
	object me;
	int score, pot;
	me = this_player();
	score = (int) me->query("max_force");
	pot = (int) me->query("force");

	if(this_player()->is_fighting())
	    return notify_fail("战斗中不能服用莲蓬！！\n");
//	diff = this_player()->query("max_kee")-this_player()->query("eff_kee");
//	if(!(diff))    return notify_fail("你没有受伤！\n");
//	if(value > diff) value = diff;
	message_vision("$N剥开莲蓬，将翠莲子吃了下去。\n",this_player());
		me->set("max_force", (int) score + 5);
		me->set("force", (int) pot + 5);
//	this_player()->add("eff_kee",value);
	destruct(this_object());
	return 1;
}


