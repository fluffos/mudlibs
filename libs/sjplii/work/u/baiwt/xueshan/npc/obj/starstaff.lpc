#include <ansi.h>
#include <weapon.h>

inherit STAFF;

void create() {
  set_name(HIG "流星拐" NOR, ({ "star staff", "staff" }));
  set_weight(8000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "条");
    set("long", "一条又粗又长的寒铁拐杖，上面镶著数支流星。\n");
    set("value", 620000);
    set("material", "iron");
    set("wield_msg", "$N拿出一根乌黑的$n握在手中。\n");
    set("unwield_msg", "$N放下手中的$n。\n");
  }

  init_staff(63);
  setup();
}
