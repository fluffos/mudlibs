
#include <weapon.h>
#include <ansi.h>
inherit DAGGER;

void create()
{
	set_name( HIG "判官笔" NOR, ({ "deadpen" }) );
	set_weight(2000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "对");
		set("long", "这是一对黑铁判官笔，是独孤恶的独门兵器。\n");
		set("value", 4000);
		set("material", "steel");
		set("wield_msg", "$N「呼」地一声把$n握在手中。\n");
		set("unwield_msg", "$N将手中的$n拄在地上。\n");
	}
	init_dagger(25);
	setup();
}
