inherit ITEM;
#include <ansi.h>
void create() {
  set_name("旁门左道术通解", ({ "zuodao book", "book" }));
  set_weight(5);
  set("long",
    "\n旁门左道术 (zuodaoshu) 是以咒术 (spells) 为基础的，共分五大系术：\n" +
    "\n" +
    "化功术（cast forceout）用以化去对方全身的内力。\n" +
    "气箭术（cast flashbolt）将自身精神聚成一股气箭射向对方。\n" +
    "占卜术（zhanbu） 　　　可以获知所占的人身处的确切方位。\n" +
    "法眼术（cast fayan）　具有法眼的人能看到鬼魂类生物。\n" +
    "遁影术（cast dunying）能变出烟雾迷惑敌人,并将敌人引开。\n" +
    "\n七宝天岚舞(stormdance)的特殊技能：七宝色相阵(sexarray)。\n" +
    "\n");
  set("unit", "张");
  set("value", 0);
}
