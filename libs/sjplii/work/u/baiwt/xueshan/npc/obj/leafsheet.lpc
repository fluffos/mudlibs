#include <ansi.h>

inherit EQUIP;

void create()
{
	set_name("落叶符", ({ "leaf sheet", "leaf", "sheet" }) );
	set_weight(300);
	set("unit", "张");
	set("long",
		"这是一张手掌大的红色枫叶，看上去十分神奇，背面写着[一叶落而知秋腕].\n");
	set("value", 500);
	set("type", "misc");
	set("apply", ([
		"头部":	0,
	]) );
}

void init()
{
	add_action("do_ji", "ji");
}

int do_ji(string arg)
{
	object ob;
	int sen, sk;
	string skill;

	if( arg ) ob = present(arg, environment(this_player()));
	else ob = this_player()->query_opponent();

	if( !ob ) return notify_fail("你要查谁的战斗力？\n");

	sen = (int)ob->query("sen");
	if( stringp(skill = ob->query("attack_skill")) )
		sk = ob->query_skill(skill);
	else
		sk = 0;

	printf("红枫叶被风一吹，渐渐显示出%s的战斗力是：%d\n",
		ob->query("name"), 
		(sk*sk*sk) * (100 + sen) / 100 + (int)ob->query("combat_exp") );

	return 1;
}

