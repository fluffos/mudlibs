// bamboo_sword.c

#include <weapon.h>

inherit SWORD;

void create() {
  set_name("树枝", ({ "branch", "shuzhi" }));
  set_weight(1000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "根");
    set("value", 100);
    set("material", "bamboo");
    set("long", "这是一根削成剑形的数枝。\n");
    set("wield_msg", "$N拿出一根$n，握在手中。\n");
    set("unequip_msg", "$N放下手中的$n。\n");
  }
  init_sword(5);
  setup();
}
