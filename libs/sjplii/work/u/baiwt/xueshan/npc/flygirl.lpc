#include <ansi.h>
inherit NPC;
int custom();
//int accept_object(object who, object ob);
void create()
{
        int i,amun;
	set_name("雪娥飞女", ({ "xue e"}));
	set("long",
	    "这是个容貌姣好的女子, 瓜子脸蛋,\n"+
	    "眼如点漆, 清秀绝俗.\n"+
	    "你总觉得在哪见过她.\n");
	set("gender", "女性");
	set("age", 18);
	set("shen_type",1);
	set("attitude", "peaceful");
//	set("env/wimpy",90);
	set("str", 30);
	set("per", 90);
        set("chat_chance", 50);
        set("chat_msg", ({
                (: random_move :),
		(: custom :),
        }) );
	set("kee", 1000);
	set("max_kee", 1000);
	set("sen", 800);
	set("max_sen", 800);
	set("force", 1000);
	set("max_force", 1000);
	set("force_factor", 30);

	set("combat_exp", 3000000);
	set_skill("force", 120);
	set_skill("unarmed", 120);
	set_skill("dodge", 120);
	set_skill("parry", 120);
        set_skill("sword",120);
        set_skill("mystforce", 120);
	set_skill("mystsword",120);
        set_skill("piaoxue-strike", 120);
        set_skill("mysterrier", 120);
	set_skill("stealing", 900);

        map_skill("force", "mystforce");
        map_skill("parry", "mystsword");
//        map_skill("sword", "mystsword");
        map_skill("unarmed", "piaoxue-strike");
        map_skill("dodge", "mysterrier");
        set("chat_chance_combat", 90);
        set("chat_msg_combat", ({
                (: perform_action, "unarmed.chanmian" :),
        }) );
	create_family("雪山琼宫",3, "弟子");
	set("class", "snowman");

	setup();
        carry_object("/u/baiwt/xueshan/obj/qingyi")->wear();
        carry_object("/u/baiwt/xueshan/obj/doupeng")->wear();
//	carry_object(__DIR__"obj/longsword")->wield();
}

int custom()
{
	say(CYN"雪娥飞女玩弄着手上的雪球，忽然啪的一声，雪球扔在了你的衣服上。雪娥飞女咯咯地笑了起来.\n"NOR);
	say(CYN"雪娥飞女美目流盼，山风吹拂着她的秀发和衣襟，看上去飘飘若仙。\n"NOR);
	say(CYN"一朵红云飞上了雪娥飞女的面颊。\n"NOR);
return 1;
}

int accept_object(object who, object ob)
{
        object          book;
	if( ob->name() == "翠玉簪") {
		say("雪娥飞女秋波流转，对你嫣然一笑，说道：这位" + RANK_D->query_respect(who) + "真有心呀！\n");
		say("雪娥飞女幽幽地叹了口气，说道：你的心意我领了，但雪山是我家，我不能跟你去闯荡江湖。\n");
		say("说着雪娥飞女拿出了一本书，说道：人生难得相逢一场，这本书就赠于你吧。\n");
			book = new(__DIR__"obj/flybook");
			book->move(who);
			return 1;
		}
		else {
			say("雪娥飞女冷冷一笑，说道：别来这一套，癞蛤蟆想吃天鹅肉吗？\n");
			return 0;
                }
        return 1;
} 


