#include <ansi.h>
inherit NPC;

void create()
{
        set_name("崔如风", ({ "cui rufeng", "cui" }) );
	set("gender", "男性");
	set("age", 30);
	set("str", 27);
	set("int", 23);
	
	set("max_kee", 700);
 	set("kee", 700);
	set("sen", 500);
	set("max_sen", 500);
	set("force", 1000);
	set("max_force", 1000);

	set("combat_exp", 1200000);
	set("score", 100000);
        set_skill("sword", 150);
        set_skill("shedu-sword", 150);
        set_skill("parry", 100);
        set_skill("dodge", 100);
        set_skill("unarmed", 100);
	set_skill("liuh-ken",150);
        map_skill("unarmed", "liuh-ken");
	map_skill("sword", "shedu-sword");
        setup();
        carry_object(__DIR__"obj/cloth")->wear();
	carry_object(__DIR__"obj/longsword")->wield();
}

void init()
{
	object		me;

        ::init();
	add_action("know_dog", "tell");
        if( interactive(me = this_player()) && !is_fighting() ) {
		if(name() == "崔如风") {
                	call_out("dogattack", 1, me);
		}
        }
}

int know_dog(string arg)
{
        string  obname, things;
	object	dog;

        if(!arg || sscanf(arg, "%s %s", obname, things)!=2 )
                return notify_fail("tell <人> <事>\n");
        if(obname == "cui") {
                if(things == "恶郎君") {
                        message_vision(HIY "\n$N对$n说道：你既然认出我来，就饶你不得！\n", this_object(), this_player());
			dog = new(__DIR__"elangjun.lpc");
			if(objectp(dog)) {
				dog->move(environment());
				dog->kill_ob(this_player());
			}
			destruct(this_object());
                        return 1;
                }
        }
        return 0;
}

int dogattack(object me)
{
	object		groom;

	if( (string)me->query("family/family_name")!="深山野人" ) {
		set_leader(me);
		message_vision(HIR "\n$n莫名其妙闻到了一股腥气，只感到一阵晕眩！\n" NOR, this_object(), me);
		me->receive_damage("kee", random(50));
		return 1;
	}
	return 0;
}
