
#include <ansi.h>

inherit NPC;
int about_he();
string summon_more( object who);

void create()
{
	set_name("聋哑老人", ({ "longya" }));
	set("long",
	    "他是一个又聋又哑的老人，正低头打着瞌睡.\n"+
	    "他看上去非常憔悴苍老，好象饱经风霜.\n");
	set("gender", "男性");
	set("age", 60);
	set("attitude", "peaceful");

	set("str", 20);
	set("int", 25);
	set("combat_exp", 100);
	set("max_kee", 9000);
	set("max_gin", 9000);
	set("max_sen", 9000);
	set("kee", 9000);
	set("gin", 9000);
	set("sen", 9000);

        set("inquiry", ([
                "连理祠" : (: about_he :),
        ]));

	set_skill("unarmed", 10);
	set_skill("dodge", 10);
	set_skill("parry", 10);
	set_skill("stealing", 900);
	set("chat_chance_combat", 100);
	set("chat_msg_combat", ({
		(: summon_more(this_object()) :),
	}) );

	setup();
	carry_object(__DIR__"obj/cloth")->wear();
	add_money("silver",40);
}

int about_he()
{
          say("聋哑老人茫然地看了你一眼，用手指蘸着香灰在地上写了[听不见]三字。\n");
	return 1;
}

int accept_object(object who, object ob)
{
        object me;
        object tudunsheet;
	if( ob->name() == "雪山黑木耳") {
	me = this_player();
          tudunsheet = new(__DIR__"obj/tudunsheet");
         tudunsheet->move(me);
        say( "聋哑老人微笑着点了点头，用手指蘸着香灰在地上写道：问我的话用香灰写出来(write).\n");
	return 1;
        }
		else {
			say("聋哑老人摇了摇手，又低头打起了瞌睡。\n");
			return 0;
                }

        return 1;
}
string summon_more(object who)
{
	int i;
	object *enemy;
	seteuid(getuid());
	enemy = who->query_enemy();
	i = sizeof(enemy);
	while(i--) {
		if( enemy[i] && living(enemy[i]) ) {
message_vision(HIW"\n土地和山神忽然出现在一阵烟雾之中！\n",enemy[i]);
message_vision(HIM"\n土地怒声骂道：畜生！竟然连又聋又哑的残疾老人也不放过！\n",enemy[i]);
message_vision(CYN"\n土地气得白胡子根根翘起，扑上来摁住$N往死里掐。\n",enemy[i]);
message_vision(CYN"山神哪管三七二十一，举起一块大石头[轰]的一声砸在了$N的头上。\n\n",enemy[i]);
			enemy[i]->set("gin",0);
			enemy[i]->set("kee",0);
			enemy[i]->set("sen",0);
			enemy[i]->unconcious();
		}
	}
	return "1";
}
int accept_fight(object me)
{
        return 0;
}
