#include <ansi.h>

inherit NPC;
int about_he();

void create()
{
	set_name("谷兰香", ({ "gu lanxiang", "lanxiang"}));
	set("long",
	    "这是个容貌姣好的女子, 瓜子脸蛋,\n"+
	    "眼如点漆, 清秀绝俗.\n"+
	    "她是谷扶西的女儿.\n");
	set("gender", "女性");
	set("age", 27);
	set("shen_type",1);
	set("title", "孤独女侠");
	set("attitude", "peaceful");
        set("chat_chance", 10);
        set("chat_msg", ({
                "谷兰香无限伤感地说道：我再也不能回到云峰身边了吗？！\n",
        }) );

	set("str", 20);
	set("per", 90);
	set("force", 500);
	set("max_force", 500);
	set("force_factor", 20);
	set("combat_exp", 5000000);

        set("inquiry", ([
                "云峰" : (: about_he :),
        ]));
	set("wan_count", 1);
	set_skill("force", 100);
	set_skill("unarmed", 100);
	set_skill("dodge", 100);
	set_skill("parry", 100);
        set_skill("tenderzhi",100);
        set_skill("sword",100);
	set_skill("stealing", 900);
	set_skill("stormdance", 100);
        map_skill("dodge", "stormdance");
        map_skill("unarmed", "tenderzhi");

	setup();
        carry_object(__DIR__"obj/qingyi")->wear();
        carry_object(__DIR__"obj/doupeng")->wear();
	add_money("silver",40);
}

int accept_object(object who, object ob)
{
        object me;
        object yinlian;
	if( ob->name() == "落叶符") {
	me = this_player();
	if( (int)me->query_temp("yulong")==1 )  return 0;
          yinlian = new(__DIR__"obj/d_jade");
          yinlian->move(me);
        say(CYN "谷兰香颤声说道：你见到云峰了吗？他好吗？\n"NOR);
        say( "谷兰香看着[落叶符]，眼泪扑漱漱地滴了下来，说道：他把掌门信物给我，说明他会永远记得我的。\n");
        say( "谷兰香泪光莹然，说道：虽然今生不能和云峰相聚，来世我也要跟随云峰身边。\n");
        say( "谷兰香轻掠云鬓，说道：多谢这位" + RANK_D->query_respect(who)
                + "，这只镯子作为酬劳送给你吧！\n");
	me->set_temp("yulong", 1);
	return 1;
        }
		else {
			say("谷兰香说道：你干什么呀？\n");
			return 0;
                }

        return 1;
}

int about_he()
{
        object me;
        object qingshi;
	me = this_player();
	if (query("wan_count") < 1)
		return command("say 你别在这儿呆太久了，小心被爹爹知道你就没命啦。");
	add("wan_count", -1);
          say(CYN"谷兰香瞪着清澈明亮的眸子注视着你。\n"NOR);
          say("谷兰香说道：在雪山山下有一个连理祠，据说就在土地庙附近，云峰他就在那儿.\n");
          say("谷兰香把一件物事塞在你手里，说道：你替我把这东西交给他，希望他能来找我.\n");
          qingshi = new(__DIR__"obj/qingshi");
          qingshi->move(me);
          return 1;
}

