#include <ansi.h>

inherit NPC;

void create()
{
        set_name("观澜居士", ({ "guanlan jushi","guanlan" }) );
        set("age", 20);
        set("long",
                "一个隐居在岷江边的文士。\n");
       set("str", 27);
        set("cor", 26);
        set("cps", 25);

        set("combat_exp", random(50)*1000);

        set_skill("unarmed", 40+random(40));
        set_skill("parry", 40+random(40));
        set_skill("dodge", 40+random(40));
        set_skill("move", 50+random(40));

        set_temp("apply/attack", 30);
        set_temp("apply/defense", 30);
        set_temp("apply/damage", 10+random(20));
        set_temp("apply/armor", 30);
        set_temp("apply/move", 30);
        set("chat_chance", 5);
        set("chat_msg", ({
"观澜居士若有所思地说道：今年的岷江大潮就要来了吧。\n"
        }) );

        setup();
        carry_object("/obj/cloth")->wear();
}

