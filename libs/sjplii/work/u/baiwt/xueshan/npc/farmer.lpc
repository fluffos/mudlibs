// farmer.c

inherit NPC;

void create()
{
	set_name("农夫", ({ "old farmer","farmer" }) );
	set("gender", "男性" );
	set("age", 33);
	set("long", "你看到一位面色黝黑的农夫。\n");
	set("combat_exp", 50);
	set("attitude", "friendly");
	set("env/wimpy", 60);
	set("chat_chance_combat", 100 );
	set("chat_msg_combat", ({
		"农夫叫道：杀人哪！杀人哪！\n",
		"农夫叫道：有土匪哪！光天化日下打劫哪！\n",
		(: command, "surrender" :),
	}) );
        set("chat_chance", 10);
        set("chat_msg", ({
                "农夫愁眉苦脸地说道：我老伴病倒了，医生说要用野生鹿茸做药引，但是我到哪里去找野生鹿茸呀？\n",
        }) );
        set_skill("parry", 10+random(10));
	set_skill("stealing", 900);
	setup();
	carry_object(__DIR__"obj/raincoat")->wear();
	carry_object(__DIR__"obj/sandals")->wear();
	add_money("coin", 20);
}
int accept_object(object who, object ob)
{
        object me;
	int score, pot;
	if( ob->name() == "野生鹿茸") {
	if((int)ob->query("objattrib") !=1 )  return 0;
	me = this_player();
	score = (int) me->query("combat_exp");
	pot = (int) me->query("potential");
		me->set("combat_exp", (int) score + 70);
		me->set("potential", (int) pot + 90);
	command("say 真是太感谢你了，这回我老伴有救啦！");
        say( "农夫匆匆离开了。\n");
	this_object()->move("/u/baiwt/npc_hut.lpc");
//      command("drop all");
	return 1;
        }
		else {
			command("say 这不是我要的。");
			return 0;
                }
        return 1;
}
