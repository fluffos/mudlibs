inherit NPC;
string reward_more( object who);

void create()
{
	set_name("雪人", ({ "snowman" }) );
//	set("gender", "男性" );
       set("str", 15);
	set("long", "你看到一个会活动的雪人。\n");
	set("max_kee", 2000);
	set("combat_exp", 300000);
	set_skill("force", 120);
	set_skill("unarmed", 120);
	set_skill("parry", 120);
        set("chat_chance_combat", 50);
        set("chat_msg_combat", ({
		(: reward_more(this_object()) :),
        }) );
	setup();
}
string reward_more(object who)
{
	int i;
	object *enemy;
	seteuid(getuid());
	enemy = who->query_enemy();
	i = sizeof(enemy);
	while(i--) {
		if( enemy[i] && living(enemy[i]) ) {
			if( enemy[i]->query("combat_exp") < 200000 ) return "1";
			if( enemy[i]->query("combat_exp") > 300000 ) return "1";
			enemy[i]->add("combat_exp", 1);
		if( enemy[i]->query("potential")-enemy[i]->query("learned_points") > 500 ) return "1";
				else
		if(random(9)<5)
			enemy[i]->add("potential", 1);
			else
			enemy[i]->add("life_exp", 1);
		}
	}
	return "1";
}
int accept_fight(object me)
{
        return 1;
}
