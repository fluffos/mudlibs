inherit NPC;
void create() {
  set_name("卑鄙龌龊的老色鬼", ({ "oldpig" }));
  set("gender", "男性");
  set("age", 54);
  set("str", 30);
  set("long",
    "这个老头子正在光天化日下强奸民女！！！\n");
  set("combat_exp", 6000);
  set("score", 400);
  set("chat_chance", 20);
  set("chat_msg", ({
    "卖艺姑娘怒声喝道：臭流氓，滚开！！\n",
    "卖艺姑娘用力向老色鬼击出一拳，但是却被他轻松地躲开了.\n",
    "卖艺姑娘向老色鬼踢出一腿，但是老色鬼眼明手快，一把将她的脚抓住了.\n",
    "卑鄙龌龊的老色鬼狞笑着剥下了卖艺姑娘的鞋子．．\n",
    "卑鄙龌龊的老色鬼狞笑着剥下了卖艺姑娘的袜子．．\n",
    "卑鄙龌龊的老色鬼狞笑着剥下了卖艺姑娘的．．．．\n",
  }));
  set_skill("unarmed", 50);
  set_skill("parry", 20);
  set_skill("dodge", 40);
  setup();
}
void init() {
  add_action("do_look", "look");
}

int do_look(string arg) {

  if (arg == "oldpig") {
    write("这个老头子正在光天化日下强奸民女！！！\n");
    write("他看起来约五十多岁。\n");
    write("武功看起来好象深不可测，出手似乎极重。\n");
    return 1;
  }
  return 0;
}

void die() {
  object me;
  //	ob=this_object();
  //	me=ob->query_enemy();
  me = this_object()->query_temp("last_damage_from");
  if (objectp(me))
    me->set_temp("marks/lady", 1);
  ::die();
}
