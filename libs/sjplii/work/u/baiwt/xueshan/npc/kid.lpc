inherit NPC;

void create()
{
        int i,amun;
        string *order = ({"张", "王", "李", "赵", "孙", "徐", "郑", "周", "吴",
		"蒋", "沈", "杨", "苗", "尹", "金", "魏", "陶", "俞", "柳", "朱"});
	string *orderr = ({"阿宝", "小乖", "阿猫", "小牛", "狗儿", "毛毛"});
        set_name( order[random(20)] + orderr[random(6)], ({ "small kid", "kid" }) );
	set("title", "小童");
	set("gender", "男性" );
	set("age", random(5)+4);
	set("int", 26);
	set("long",
		"他很小, 很好欺服.\n");
        set("chat_chance", 10);
        set("chat_msg", ({
                (:command, "say 我的大头蟋蟀跑哪儿去了呢？":),
                (: random_move :),
        }) );

	set("attitude", "peaceful");
	set("combat_exp", 100+random(100));
       set_skill("unarmed", 1+random(10));
	set_skill("stealing", 900);
        set_skill("parry", 1+random(10));
	setup();
}
int accept_object(object who, object ob)
{
        object me;
	int score, pot;
	if( ob->name() == "蟋蟀") {
	if((int)ob->query("objattrib") !=1 )  return 0;
	me = this_player();
	score = (int) me->query("combat_exp");
	pot = (int) me->query("potential");
		me->set("combat_exp", (int) score + 60);
		me->set("potential", (int) pot + 40);
	command("say 就是它！谢谢。");
        say( "小童匆匆离开了。\n");
	this_object()->move("/u/baiwt/npc_hut.lpc");
//      command("drop all");
	return 1;
        }
		else {
			command("say 这东西我不要。");
			return 0;
                }
        return 1;
}
