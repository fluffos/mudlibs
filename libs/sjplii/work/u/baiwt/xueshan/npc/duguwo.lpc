#include <ansi.h>

inherit NPC;

void create() {
  set_name("独孤握", ({ "dugu wo", "dugu" }));
  set("long",
    "他是[一剑、双拐、三奇、四恶]中的独孤恶\n" +
    "他擅使一对判官笔，据说能定人生死，但是却从未错杀一个好人.\n");
  set("title", "武林四恶之一");
  set("gender", "男性");
  set("nickname", HIG "生死笔" NOR);
  set("age", 60);
  set("attitude", "peaceful");

  set("str", 37);
  set("int", 23);
  set("con", 24);
  set("dex", 30);

  set("max_kee", 1000);
  set("kee", 1000);
  set("sen", 500);
  set("max_sen", 500);
  set("force", 1000);
  set("max_force", 1000);

  set("combat_exp", 1200000);
  set("score", 100000);
  set_skill("parry", 180);
  set_skill("dodge", 100);
  set_skill("unarmed", 130);
  set_skill("dagger", 180);
  set_skill("force", 100);
  set_skill("zhichi-dagger", 130);
  set_skill("liuh-ken", 100);
  map_skill("unarmed", "liuh-ken");
  map_skill("dagger", "zhichi-dagger");

  setup();
  carry_object(__DIR__ "obj/cloth")->wear();
  carry_object(__DIR__ "obj/deadpen")->wield();
}

int accept_fight(object me) {
  command("say 琼宫圣地不准动武。");
  return 0;
}
