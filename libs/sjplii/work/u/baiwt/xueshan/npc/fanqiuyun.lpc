#include <ansi.h>
inherit NPC;
int about_guai();
void create() {
  set_name("樊秋云", ({ "fan qiuyun", "fan" }));
  set("long",
    "她是樊太婆的孙女.\n");
  set("gender", "女性");
  set("age", 20);
  set("shen_type", 1);
  set("attitude", "peaceful");

  set("str", 25);
  set("int", 25);
  set("con", 30);
  set("dex", 30);

  set("combat_exp", 200000);
  set("score", 100);
  set_skill("force", 50);
  set_skill("unarmed", 50);
  set_skill("dodge", 50);
  set_skill("parry", 50);
  set_skill("sword", 60);
  set_skill("stealing", 900);
  set_skill("tenderzhi", 50);
  map_skill("unarmed", "tenderzhi");
  set("chat_chance", 10);
  set("chat_msg", ({
    "樊秋云秀眉一蹙，说道：爷爷传给我的盘龙双拐不见了，你能帮我找回来吗？\n",
  }));
  set("inquiry", ([
    "盘龙双拐": (: about_guai :),
  ]));
  setup();
  carry_object(__DIR__ "obj/qingyi")->wear();
  carry_object(__DIR__ "obj/longsword")->wield();
  add_money("silver", 5);
}

int accept_fight(object me) {
  command("say 琼宫圣地不准动武。");
  return 0;
}
int accept_object(object who, object ob) {
  object me;
  int score, pot;
  if (ob->name() == MAG "盘龙双拐" NOR) {
    me = this_player();
    //   if((int)ob->query("objattrib") !=1 )  return 0;
    score = (int)me->query("combat_exp");
    pot = (int)me->query("potential");
    me->set("combat_exp", (int)score + 100);
    me->set("potential", (int)pot + 80);
    say(CYN "樊秋云说道：太好了，我爷爷可以瞑目了。多谢啦！\n" NOR);
    //	destruct(ob);
    say("樊秋云匆匆离开了。\n");
    this_object()->move("/u/baiwt/npc_hut.lpc");
    //      command("drop all");
    return 1;
  } else {
    say(CYN "樊秋云摇了摇头，说道：这东西有什么用呀？\n" NOR);
    return 0;
  }

  return 1;
}
int about_guai() {
  command("say 这是我爷爷唯一的遗物。\n");
  return 1;
}
