#include <ansi.h>

inherit NPC;
int about_he();

void create() {
  set_name("樊太婆", ({ "fan taipo", "taipo" }));
  set("long",
    "她是江湖盛传的[一剑、双拐]中的双拐樊长江的老伴.\n" +
    "她两鬓班白,饱经风霜.\n");
  set("title", "流星拐");
  set("gender", "女性");
  set("age", 60);
  set("attitude", "peaceful");

  set("str", 30);
  set("int", 25);
  set("combat_exp", 1200000);

  set("max_kee", 1000);
  set("kee", 1000);
  set("sen", 500);
  set("max_sen", 500);
  set("force", 1000);
  set("max_force", 1000);

  set_skill("force", 100);
  set_skill("unarmed", 100);
  set_skill("dodge", 100);
  set_skill("parry", 100);
  set_skill("staff", 150);

  set_skill("starstaff", 150);
  set_skill("mystforce", 100);
  set_skill("yueying-wubu", 100);
  set_skill("liuh-ken", 100);
  map_skill("unarmed", "liuh-ken");

  map_skill("force", "mystforce");
  map_skill("dodge", "yueying-wubu");
  map_skill("staff", "starstaff");
  setup();
  carry_object(__DIR__ "obj/doupeng")->wear();
  carry_object(__DIR__ "obj/starstaff")->wield();
  add_money("silver", 40);
}

int accept_fight(object me) {
  command("say 琼宫圣地不准动武。");
  return 0;
}
