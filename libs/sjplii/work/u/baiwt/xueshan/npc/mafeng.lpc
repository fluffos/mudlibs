#include <ansi.h>

inherit NPC;

void create() {
  set_name("麻风病人", ({ "ma feng" }));
  set("long", "一个浑身长满脓包和肿瘤的病人。\n");
  set("age", 38);
  set("gender", "男性");
  set("attitude", "peaceful");
  set("combat_exp", 1000);
  set_skill("stealing", 900);
  set("chat_chance", 10);
  set("chat_msg", ({
    "麻风病人叹道：听说琼宫灵药能治百病，不知能否治好我这麻风。\n",
    "麻风病人仰望雪山，喃喃道：只是雪山如此凶险，我又怎能上得去？\n",
  }));
  setup();
  carry_object(__DIR__ "obj/cloth")->wear();
}
int accept_object(object who, object ob) {
  object me;
  int score, pot;
  if (ob->name() == "鸟风草") {
    // if((int)ob->query("objattrib") !=1 )  return 0;
    me = this_player();
    score = (int)me->query("combat_exp");
    pot = (int)me->query("potential");
    me->set("combat_exp", (int)score + 80);
    me->set("potential", (int)pot + 70);
    say("麻风病人说道：多谢这位" + RANK_D->query_respect(who)
      + "给我灵药治病，你的好心一定有好报的.\n");
    say("麻风病人轻声说道：告诉你一个秘密，雪山琼宫里有一把银色宝剑，锋利无匹！\n");
    say("麻风病人匆匆离开了。\n");
    this_object()->move("/u/baiwt/npc_hut.lpc");
    //      command("drop all");
    return 1;
  } else {
    say("麻风病人摇了摇头，说道：这东西有什么用呀？\n");
    return 0;
  }

  return 1;
}
