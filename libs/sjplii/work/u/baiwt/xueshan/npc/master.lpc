#include <ansi.h>
inherit NPC;
inherit F_MASTER;
void create() {
  set_name("雪珠连", ({ "master xue", "xue", "master" }));
  set("long",
    "这是一个四十五六岁的中年人, 浓眉大眼,\n" +
    "身穿一件华贵雅致的长袍, 倒使他更显几分精神.\n" +
    "传说他与东海无名岛有些关系.\n");
  set("title", "雪山琼宫宫主");
  set("gender", "男性");
  set("age", 46);
  set("nickname", HIC "风上人" NOR);
  set("attitude", "peaceful");
  set("str", 30);
  set("int", 30);
  set("cor", 30);
  set("spi", 30);
  set("max_kee", 5000);
  set("max_gin", 5000);
  set("max_sen", 5000);
  set("kee", 5000);
  set("gin", 5000);
  set("sen", 5000);

  set("force", 3000);
  set("max_force", 3000);
  set("force_factor", 50);

  set("combat_exp", 60000000);
  set("score", 20000);

  set_skill("literate", 250);
  set_skill("konghegong", 250);
  set_skill("force", 250);
  set_skill("unarmed", 250);
  set_skill("sword", 250);
  set_skill("parry", 250);
  set_skill("dodge", 250);
  set_skill("bingchuan-sword", 250);
  set_skill("fengxue-steps", 250);
  set_skill("xuanyinforce", 250);
  set_skill("piaoxue-strike", 250);
  map_skill("sword", "bingchuan-sword");
  map_skill("force", "xuanyinforce");
  map_skill("parry", "bingchuan-sword");
  map_skill("unarmed", "piaoxue-strike");
  map_skill("dodge", "fengxue-steps");

  set("chat_chance_combat", 90);
  set("chat_msg_combat", ({
    (: perform_action, "dodge.xuedipiaofeng" :),
    (: perform_action, "sword.bingtianxuedi" :),
    //                (: exert_function, "icehurt" :),
  }));
  create_family("雪山琼宫", 2, "弟子");
  set("class", "snowman");

  setup();
  carry_object(__DIR__ "obj/moon_hat")->wear();
  carry_object(__DIR__ "obj/bingsword")->wield();
}

void attempt_apprentice(object ob) {
  object xsmap;
  if ((int)ob->query_skill("xuanyinforce", 1) < 60) {
    command("say " + RANK_D->query_respect(ob) + "是否还应该多练练玄阴气功？");
    return;
  }
  if ((string)ob->query("gender") == "男性") {
    message_vision("雪珠连垂目沉思片刻, 说道：“好吧, 我就收下你了。这份地图你收好。”\n", ob);
    command("recruit " + ob->query("id"));
    if ((string)ob->query("class") != "snowman")
      ob->set("class", "snowman");
    xsmap = new(__DIR__ "obj/xsmap");
    xsmap->move(ob);
    return;
  } else {
    message_vision("雪珠连作了一揖,说道：“阁下本领非凡，雪某哪里敢当?”\n", ob);
    return;
  }
}
int do_unwie() {
  if (!this_object()->is_fighting()) {
    command("unwield sword");
    command("say 狂妄之徒，不知天高地厚！");
    return 1;
  } else
    call_out("do_unwie", 3);
}

void init() {
  add_action("do_killing", "kill");
}

int do_killing(string arg) {

  object player, victim, weapon;
  string name;
  player = this_player();
  if (objectp(victim = present(arg, environment(this_object()))) && living(victim)) {
    name = victim->name();
    if (name == "冷凝珠") {
      message_vision("$N皱皱眉头。\n", this_object());
      weapon = present("sword", this_object());
      weapon->wield();
      this_object()->kill_ob(player);
      player->kill_ob(this_object());
      call_out("do_unwie", 3);
      return 0;
    }
    if (name == "雪珠连") {
      message_vision("$N皱皱眉头。\n", this_object());
      weapon = present("sword", this_object());
      weapon->wield();
      call_out("do_unwie", 3);
      return 0;
    }
    return 0;
  }
  return 0;
}
int accept_object(object who, object ob) {
  object me;
  object book;
  if (ob->name() == "纸信") {
    me = this_player();
    book = new(__DIR__ "obj/zuodao");
    me->set("marks/送信", 0);
    say("雪珠连叹了口气，说道：宝儿当年触犯宫中禁律，我一怒之下贬其出门，未曾想她对师门\n");
    say("却念念不忘，唉！只是不知她怎会见到小女？她哪知道我们一家尚未团圆呀！\n");
    say("雪珠连说道：宝儿曾经偷习旁门左道之术，这是她当年留下的一本小册子，就送给你吧！\n");
    book->move(me);
    return 1;
  } else {
    say("雪珠连冷哼一声，说道：你有什么企图？\n");
    return 0;
  }

  return 1;
}
int accept_fight(object me) {
  command("say 琼宫圣地不准动武。");
  return 0;
}
