inherit ITEM;
inherit F_FOOD;

void create()
{
	set_name("野生鹿茸", ({ "lurong" }) );
	set_weight(80);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "一块名贵的野生鹿茸。\n");
		set("unit", "块");
		set("objattrib", 1);
		set("value", 0);
		set("food_remaining", 3);
		set("food_supply", 60);
	}
}
