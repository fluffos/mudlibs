inherit ITEM;
inherit F_FOOD;

void create()
{
	set_name("大蘑菇", ({ "hougu" }) );
	set_weight(80);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "一片野生的大蘑菇。\n");
		set("unit", "片");
		set("objattrib", 1);
	set("identify_name", "猴头菇");
		set("food_remaining", 1);
		set("food_supply", 10);
	}
}
