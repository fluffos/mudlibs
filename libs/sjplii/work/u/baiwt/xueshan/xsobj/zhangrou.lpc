inherit ITEM;
inherit F_FOOD;

void create() {
  set_name("獐肉", ({ "meat" }));
  set_weight(80);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一块新鲜的獐肉。\n");
    set("unit", "块");
    set("value", 15);
    set("food_remaining", 3);
    set("food_supply", 60);
  }
}
