inherit NPC;
void use_poison();
void create()
{
	int	i;
        string *names = ({
                "竹叶青蛇", "眼镜蛇","蝮蛇","大蟒蛇", 
        });
	i = random(4);
        set_name( names[i], ({ "snake" }));
        set("race", "野兽");
        set("age", 4);
	set("yes_carry", 1);
        set("long", "一条有毒的蛇。\n");
        set("limbs", ({ "头部", "身体", "尾巴", "七寸" }) );
        set("verbs", ({ "bite" }) );
        set("attitude", "aggressive");
        set_skill("dodge", 50);
        set("combat_exp", 999);
	set("bellicosity", 300 );
        set("chat_chance_combat", 10);
        set("chat_msg_combat", ({
                (: use_poison :),
        }) );
        setup();
        carry_object("/u/baiwt/xueshan/xsobj/shedan");
}
void use_poison()
{
        object *enemy, ob;
	object me=this_object();
        string msg;
        enemy = query_enemy();
        if( sizeof(enemy) ) ob = enemy[random(sizeof(enemy))];

        tell_object(ob,
"你觉得脸上剧痛，伸手一摸发现两个毒牙印痕。\n");
        if( (random(2)+1) * me->query("combat_exp") > (int)ob->query("combat_exp") )
                ob->apply_condition("snake_poison", 
                (int)this_player()->query_condition("snake_poison")
                + random(3)+3);
}
void init()
{
        object ob;
        ::init();
        if( interactive(ob = this_player()) ) {
                kill_ob(ob);
        }
}

