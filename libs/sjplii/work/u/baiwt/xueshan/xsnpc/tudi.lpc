#include <ansi.h>

inherit NPC;
void backattack();
int about_here1();
int about_here2();
int about_here3();
int about_here4();
int about_here5();
int about_here6();
int about_here7();
int about_here8();
int about_here9();

void create() {

  set_name("土地", ({ "tudi" }));
  set("gender", "男性");
  set("age", 92);
  set("long", "这是一位老太龙钟的老神仙，掌管雪山的山水土地.\n");
  set("attitude", "friendly");


  set("str", 20);
  set("int", 30);
  set("cor", 20);
  set("cps", 30);
  set("spi", 30);

  set("max_kee", 9000);
  set("max_gin", 9000);
  set("max_sen", 9000);

  set("force", 3000);
  set("max_force", 3000);
  set("force_factor", 50);

  set("atman", 2000);
  set("max_atman", 2000);

  set("mana", 4000);
  set("max_mana", 2000);
  set("mana_factor", 50);
  set("inquiry", ([
    "琼宫": (: about_here1 :),
    "雪山": (: about_here2 :),
    "雪山后山": (: about_here3 :),
    "雪山林海": (: about_here4 :),
    "长春谷": (: about_here5 :),
    "冰河": (: about_here6 :),
    "仙鹤湖": (: about_here7 :),
    "土地庙": (: about_here8 :),
    "飞雪崖": (: about_here9 :),
    "歇脚石": (: about_here9 :),
    "吹雪亭": (: about_here9 :),
    "积霜岩": (: about_here9 :),
    "望雪坡": (: about_here9 :),
    "雪山冰瀑": (: about_here9 :),
  ]));


  set("combat_exp", 20000000);
  set_skill("parry", 300);
  set_skill("dodge", 300);
  set_skill("unarmed", 30);
  set_skill("gouyee", 200);
  set_skill("spells", 200);
  set_skill("dagger", 30);
  //        set_skill("throwing", 200);
  set_skill("force", 200);
  set_skill("taoism", 200);
  set_skill("necromancy", 200);
  map_skill("force", "gouyee");
  map_skill("spells", "necromancy");

  set("chat_chance_combat", 90);
  set("chat_msg_combat", ({
    (: cast_spell, "invocation" :),
    (: cast_spell, "netherbolt" :),
  }));

  setup();
  carry_object(__DIR__ "obj/zitengz")->wield();
  //	carry_object(__DIR__"obj/stone")->wield();
}
int accept_fight(object me) {
  command("say 小神不会武功。");
  return 0;
}

int heal_up() {
  if (environment() && !is_fighting()) {
    call_out("leave", 1);
    return 1;
  }
  if (is_fighting() && (int)this_object()->query("kee") <= 100)
    backattack();
  return ::heal_up() + 1;
}

void leave() {
  object owner;
  message("vision",
    name() + HIC "说道：要是没别的事，老朽先告辞了。\n\n"
    +name() + "捶了捶背，咳嗽一声，吃力地往地下钻了进去。\n" NOR, environment(),
    this_object());
  if (objectp(owner = this_object()->query("possessed")))
    owner->add_temp("max_guard", -1);
  destruct(this_object());
}

void backattack() {
  int i;
  object owner, *enemy;
  if (objectp(owner = this_object()->query("possessed"))) {
    enemy = this_object()->query_enemy();
    i = sizeof(enemy);
    while (i--) {
      if (enemy[i] && living(enemy[i])) {
        owner->kill_ob(enemy[i]);
        enemy[i]->kill_ob(owner);
      }
    }

  }

}

void die() {
  object owner;
  if (objectp(owner = this_object()->query("possessed")))
    owner->add_temp("max_guard", -1);
  ::die();
}

int about_here1() {
  say("土地咳嗽一声，说道：琼宫是由坚冰和寒玉构筑成的，住在里面的人都要具有很\n");
  say("高的内功，否则会被冻死的。由于外人很少知道琼宫的确切位置，所以想要找到\n");
  say("琼宫的话最好向雪山派的人多打听打听。\n");
  return 1;
}
int about_here2() {
  say("土地咳嗽一声，说道：雪山是一个神奇而美丽的地方，但是山上绝顶苦寒，不是\n");
  say("一般人能上去的。前山有著名的仙鹤湖，后山有林海，还有一处神秘的长春谷，\n");
  say("人迹罕至，犹如世外桃源。\n");
  return 1;
}
int about_here3() {
  say("土地咳嗽一声，说道：后山鸟兽绝迹，十分寒冷。哪里住着一个深山野人，会驱\n");
  say("动野兽，很是厉害。听说他还把自己的女儿关在一个洞里，到底怎么回事我也不\n");
  say("是很清楚了......\n");
  return 1;
}
int about_here4() {
  say("土地咳嗽一声，说道：那是通向后山的必经之路，是一片原始丛林。林中危机四\n");
  say("伏，还很容易迷路，想去后山的话可要加倍小心。最近好象有个人经常在林海东\n");
  say("北面出没，这个人也许知道点什么。\n");
  return 1;
}
int about_here5() {
  say("土地咳嗽一声，说道：长春谷和雪山各处地方都不一样，哪里四季如春，百花盛\n");
  say("开。但是没有人知道怎样才能到长春谷去，只是传说冰河流到尽头就是长春谷了.\n");
  return 1;
}
int about_here6() {
  say("土地咳嗽一声，说道：雪山气候寒冷，终年积雪，故山腰处都可看到冰瀑和冰河.\n");
  return 1;
}
int about_here7() {
  say("土地咳嗽一声，说道：仙鹤湖就是有名的腾格里海，那里水草丰厚，常有鸟兽栖\n");
  say("息。湖边住着个神秘的少女，她好象对琼宫的情况知道得不少。\n");
  return 1;
}
int about_here8() {
  say("土地咳嗽一声，说道：呵呵，土地庙就是小神的家啊，有空的话请来多坐坐，烧一柱香.\n");
  return 1;
}
int about_here9() {
  say("土地咳嗽一声，说道：那里风景不错，可以去看看。\n");
  return 1;
}
