inherit ROOM;

void create() {
  set("short", "望雪坡");
  set("long", @LONG
这里是望雪坡, 站在这里眺望可以隐约看到积雪覆盖的山顶。山脚
和山腰显然两个季节，构成了雪山独特的景色。东面是一块空地，西面是
著名的歇脚石，行路人累了可以到那里歇息。
LONG
  );
  set("outdoors", "xueshan");
  set("exits", ([
    "west": __DIR__ "xishi",
    "east": __DIR__ "kongdi",
    "westup": __DIR__ "ya",
    "southdown": __DIR__ "shanjiao",
  ]));
  setup();
}
