
inherit ROOM;

void create()
{
        set("short", "瑶竹宫");
        set("long",@LONG
这是琼宫内最温暖的地方，在宫殿的一侧竟然还种植着碧绿的竹子，
仿佛让人走进了江南园林。
LONG       );
        set("exits", ([
		"northwest" : __DIR__"changl9",
		"southwest" : __DIR__"changl7",
        ]));
        set("objects",([
		__DIR__"npc/lan" : 1,
		__DIR__"obj/zhujian" : 3,
		__DIR__"obj/longsword" : 3,
       	]));

        setup();
        replace_program(ROOM);
}
