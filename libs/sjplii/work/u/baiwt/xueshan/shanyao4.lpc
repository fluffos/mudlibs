#include <ansi.h>

inherit ROOM;
void init();
int do_ride(string);
int do_swim(string);

void create()
{
	set("short", "雪山冰川");
        set("long",@LONG
冰川的冰层，虽因受到阳光已有部分融化，但山顶的雪花，一片片轻
飘飘地下着，就好象白纸屑、水晶末一般，落到冰川之上，逐渐结晶冻结
，最后转化为冰层。所以山上的冰川，亘古不化。由于阳光的折射和散射
，整个冰层都变为浅兰色的透明体，端的是奇丽万状，难以形容。冰川的
旁边竟然出现了一条流动的冰河，寒冷刺骨的河水夹带着冰块向山坳处流
去。你只觉得寒风凛冽，似乎快要将你冻僵了。
LONG
        );
  set("outdoors", "xueshan");
  set("objects",([
    __DIR__"npc/xianhe" : 1,
    __DIR__"npc/hufa4" : 1,
    ]));
  set("item_desc",([
      "冰河" : "这是一条寒冷的冰河。你该不会想跳下去吧？要游泳可别在这里呀！\n" ,
     ]));

  setup();
}

void init()
{	object ob;
	if( interactive( ob = this_player()))
	call_out("blowing", random(10) + 1, ob);
	add_action("do_ride", "ride");
	add_action("do_swim", "swim");
}

int blowing(object ob)

{
	int i;
	int damage;
        if(  ob && environment(ob) == this_object())
	{
	tell_object(this_object(), HIW "\n\n突然一股刺骨的寒风猛烈地刮来，你只觉浑身发抖，站都站不住！！\n\n" NOR);
	COMBAT_D->report_status(ob,1);
	ob->receive_wound("kee", random(20)+20);
	if( environment(ob) == this_object())
	call_out("blowing",random(10)+1, ob);	
	}
	else

	return 1;
}

int do_ride(string arg)
{
	object me=this_player(), room;
	if(me->query_temp("xueshan/allow_fly") < 5)
		return notify_fail("你要干什么？\n");

	if(!arg || arg!="仙鹤")
		return notify_fail("你要骑什么？\n");

	if(!( room = find_object(__DIR__"beique")) )
		room = load_object(__DIR__"beique");

	if(!objectp(room))
		return notify_fail("ERROR:not found 'beique.c' \n");
	message_vision(HIW "\n$N轻轻一跃，骑到了仙鹤背上，只见白鹤引吭高鸣，驮着$N振翅飞上山去。\n",me);
	message_vision(NOR "\n",me);
        me->move(room);
	me->start_busy(1);
        return 1;
}

int do_swim(string arg)
{
	object me=this_player(), room;

	if(!arg || arg!="冰河")
		return notify_fail("你要游什么？\n");

	if(!( room = find_object(__DIR__"binggu")) )
		room = load_object(__DIR__"binggu");

	if(!objectp(room))
		return notify_fail("ERROR:not found 'binggu.c' \n");
	message_vision("$N扑通一声跳下冰河，奋力向山坳深处游了过去。\n\n",me);
        me->move(room);
        return 1;
}
