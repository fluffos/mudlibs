#include <ansi.h>
inherit ROOM;
void create()
{
  set("short",BLU"黑风峪"NOR);
  set("long",@LONG
一道深而险的山谷自南而北，两边俱是陡峭的斜坡，爬不上去，一些树木沿
坡而生，巨大的根系半露在土外。高大的树木挡住了阳光，使得这里终年都是黑
黝黝的，即便是夏天也颇感寒冷，因此人多称之为”黑风山口“，向北上山就是
老鸦岭。
LONG);
  set("exits",([
//    "northup"   : __DIR__"laoya",
    "southup"  : __DIR__"suishi",
    "southeast" : __DIR__"shanyao",
  ]));
   set("outdoors","nanyang");
   set("objects",([
         __DIR__"npc/man":2,
   ]));
   set("oldarea","nanyang");
  setup();
}
