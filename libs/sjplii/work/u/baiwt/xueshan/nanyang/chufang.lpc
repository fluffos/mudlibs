inherit ROOM;
void create() {
  set("short", "厨房");
  set("long", @LONG
这里是负责供应杨家上上下下一百多人一日三餐的大厨房；不过，老爷夫人
和小姐的饭菜并不在这里做。厨房里整天都是乱哄哄的：有时开灶煮饭，有时烧
水烹茶；不动火时，厨娘们也要忙着择菜，和面。靠外墙根有两张桌子，是供府
里的徒弟，食客们用餐的。
LONG);
  set("exits", ([
    "north": __DIR__ "qianyuan",
  ]));
  set("objects", ([
    __DIR__ "npc/chuniang": 1,
  ]));
  set("oldarea", "nanyang");
  setup();
}
