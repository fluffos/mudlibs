#include <ansi.h>
inherit ROOM;
void create()
{
  set("short",RED "后堂" NOR);
  set("long",@LONG
这里是连理祠的后堂，中间立着一男一女两座雕像，男的是个庄稼少年，扛
着锄头仰望苍穹，女的是个纺纱少女，正在浣洗手中的白纱。这就是著名的牛郎
织女。人们为了弥补这对情侣一年一度鹊桥相会的遗憾，特地修建了这两座雕像
，以祝福天下有情之人能永结连理。
LONG);
  set("exits",([
       "south" : __DIR__"wuhou_ci",
  ]));
   set("objects",([
         __DIR__"npc/lanjiao":1,
   ]));
   set("oldarea","nanyang");

