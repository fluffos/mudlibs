#include <ansi.h>
#include <room.h>
inherit ROOM;
void create()
{
  set("short", "东厢房" );
  set("long",@LONG
三间打扫得干干净净的瓦房，一溜木格栅窗全开着，屋内空气清新，一尘不
染。向东穿过一个小花厅，就是后院花园了。西边是天井。
LONG);
  set("exits",([
    "southeast" : __DIR__"houyuan",
    "west"  : __DIR__"tianjing",
  ]));
   create_door("southeast","垂花青缎门帘","northwest",DOOR_CLOSED);
   set("oldarea","nanyang");
  setup();
}
