#include <ansi.h>
inherit NPC;
void create()
{
        set_name("钱不多", ({ "seller"}) );
        set("gender", "男性" );
        set("age", 46);
        set("long",
          "钱不多是这间小商号的老板，写得一手好字，总是被杨家请去写东西.\n"
        );
        set("attitude", "friendly");
        set("combat_exp",100);
        set("social_exp",100);
        set_skill("unarmed",50);
        setup();
        carry_object(__DIR__"obj/cloth4")->wear();

}
void init()
{
        object ob;
        ::init();
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
        }
}
void greeting(object ob)
{
        if( !ob || environment(ob) != environment() ) return;
        message_vision("钱不多大声说道：“本号有卖金创药，十两银子一帖！”\n",ob);
        
}
int accept_object(object who, object ob)
{
        int val;
	object paper;
        val = ob->value();
        if( !val )
                return 0;
        else if( val >= 1000) {
	paper = new(__DIR__"obj/jinyao");
	if( paper) {
	paper->set("targetprice", val);
	paper->move(who);
		    }
        }
        say( "钱不多说道：一手交钱一手交货，银货两讫！\n");
        return 1;
}
