// mantou for nanyang_xiaodian
inherit ITEM;
inherit F_FOOD;
void create()
{
        set_name("馒头", ({"man tou","food"}));
        set_weight(100);
        if (clonep())
                set_default_object(__FILE__);
        else {
                set("long", "一个白面馒头，颜色有些发黄。\n");
                set("unit", "个");
                set("value", 2);//很便宜，（基本食物都应该很便宜）.
                set("food_remaining", 2);
                set("food_supply", 40);//正常饭量的人一顿吃二斤。
        }
}
