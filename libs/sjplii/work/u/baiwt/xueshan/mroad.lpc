
inherit ROOM;

void create()
{
        set("short", "小路");
        set("long", @LONG
这是一条被人走出来的小山路，虽然不宽却是够一辆马车通行。小路
顺着山中较为平坦地带缓缓向西伸展。
LONG
        );
        set("exits", ([ 
  "northeast" : __DIR__"huangyie1",
  "westup" : __DIR__"tudimiao",
]));
//	set("NONPC",1);
        set("outdoors", "xueshan");

        setup();
}

void init()
{
        add_action("do_go","go");

}

int do_go()
{
if(random(2)){
this_player()->move(this_object());
return 1;
}
}
