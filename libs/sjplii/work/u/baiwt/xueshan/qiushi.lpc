inherit ROOM;
void create()
{
        set("short", "寒冰洞");
        set("long",@LONG
这里是琼宫内最寒冷的地方，中央放着一块巨大的寒玉石，洞中
奇寒彻骨，四壁冰霜。寒玉石上一动不动坐着一个人影。
LONG
        );
        set("exits", ([
		"east" : __DIR__"men1",
        ]));
	set("objects",([
		__DIR__"npc/mowuwei" : 1,
	]));
        setup();
        replace_program(ROOM);
}