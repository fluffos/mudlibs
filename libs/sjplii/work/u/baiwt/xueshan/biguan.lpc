#include <ansi.h>
inherit ROOM;
void init();

int do_kneel(string);
void create()
{
  set("short","玉乳洞");
  set("long",@LONG
这是雪山神奇的玉乳洞，洁白的钟乳石从四处洞壁上挂下来，石上滴
落的水乳在地下形成了一个个水潭，潭中的琼浆玉乳洁白无暇，奇特异常
，传说它有治病补血的神奇功效。
LONG
    );
  set("sleep_room", 1);   
  set("exits",([
      "north" : __DIR__"men3",
     ]));
  set("objects",([
		__DIR__"npc/shenni" : 1,
     ]));
  set("item_desc",([
      "水潭" : "一潭洁白无暇的琼宫玉乳。\n" ,
      "玉乳" : "琼宫灵药，只有经雪山神尼许可才能拿到它。\n" ,
     ]));
	set("no_fight",1);
	set("no_magic",1);
	set("no_steal",1);
//	set("NONPC",1);

 setup();
}
void init()
{
	add_action("do_kneel", "kneel");
}
int do_kneel(string arg)
{
        object me;
        object yuru;
	me = this_player();
         yuru = new(__DIR__"obj/yuru");
	if(!arg || arg!="雪山神尼")
		return notify_fail("你要拜谁？\n");
	message_vision("\n$N恭恭敬敬地跪下朝雪山神尼磕了三个头。\n",me);
	message_vision(HIW"\n雪山神尼对$N缓缓点了点头，说道：好吧，玉乳是很珍贵的，你要小心使用.\n",me);
	message_vision(HIW"\n雪山神尼长袖一拂，一瓶琼宫玉乳缓缓飞落到$N的怀中。\n\n"NOR, me);
          yuru->move(me);
	return 1;
}
int valid_leave(object me, string dir)
{

	if (  (dir == "north") && (present("yuru", this_player())||present("yuru",this_player())) ) 
	
	return notify_fail
		("雪山神尼冷冷一笑，说道：你要把琼宫灵药带到哪里去？\n");
	
	return ::valid_leave(me, dir);
}
