inherit ROOM;

void create() {
  set("short", "竹林");
  set("long", @LONG
这里是一片郁郁葱葱的翠竹林。青竹林立，碧绿挺拔，一眼望不到边
，好似一幅巨大的绿色屏障。微风吹动着竹梢发出沙沙的轻响，在这幽静
的氛围中，使人不禁产生一种返朴归真的感觉。
LONG
  );
  set("exits", ([
    "west": __DIR__ "zhulin4",
    "east": __DIR__ "zhulin3",
  ]));
  set("outdoors", "xueshan");
  setup();
}
