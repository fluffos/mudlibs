#include <ansi.h>
inherit ROOM;
int do_swim(string arg);

void create() {
  set("short", "玉乳洞口");
  set("long",
    "这是玉乳洞的北边，南面就是玉乳洞的入口。\n"
  );
  set("exits", ([
    "south": __DIR__ "biguan",
  ]));

  set("objects", ([
    __DIR__ "npc/fantaipo": 1,
  ]));
  setup();
}
void init() {
  add_action("do_swim", "swim");
}

int valid_leave(object me, string dir) {
  if ((dir == "south")
    && ((string)me->query("family/family_name") != "雪山琼宫")
    && objectp(present("fan taipo", environment(me))))
    return notify_fail("樊太婆伸手拦住你，说道：“对不起，本门重地，请回！”\n");
  return ::valid_leave(me, dir);
}
int do_swim(string arg) {
  object me = this_player(), room;
  if (!arg || arg != "lake")
    return notify_fail("你要游什么？\n");

  if (!(room = find_object(__DIR__ "tianhu")))
    room = load_object(__DIR__ "tianhu");

  if (!objectp(room))
    return notify_fail("ERROR:not found 'tianhu.c' \n");
  message_vision(HIC "\n$N纵身跃入湖中，向湖对面游去。\n", me);
  message_vision(NOR "\n", me);
  me->move(room);
  return 1;
}
