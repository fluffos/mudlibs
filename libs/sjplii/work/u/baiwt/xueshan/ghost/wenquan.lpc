inherit ROOM;

void create()
{
        set("short", "温泉");
        set("long", @LONG
转过山坳，前面地形豁然宽坦，岩石缝间，喷出一团团蒸气，灼热的
水花，飞溅空中，在淡淡的斜晖映射下，形成一圈圈橙色的、淡紫的和浅
红的花朵。这就是雪域的一种天然奇景：地热喷泉。
LONG
        );
        set("exits", ([ 
		"northwest" : __DIR__"beikou",
	       "eastdown" : __DIR__"xueyu1",
]));
        set("objects", ([
		__DIR__"npc/fan2" : 1,
		"/u/baiwt/xueshan/npc/zhang" : 1,
       ]) );

        set("outdoors", "xueshan");

        setup();
}

