inherit ROOM;

void create() {
  set("short", "三岔口");
  set("long", @LONG
你来到了一处三岔口，有三条通向不同方向的小路隐藏在山壁之间，
你发现左边的山壁上刻着几个大字：非幽冥教弟子不得入内。
LONG
  );
  set("exits", ([
    "east": __DIR__ "xdao1",
    "west": __DIR__ "shangukou",
    "northeast": __DIR__ "xdao2",
    "southeast": __DIR__ "xdao3",
  ]));
  set("outdoors", "xueshan");
  setup();
}
