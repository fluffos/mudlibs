
inherit ITEM;
#include <ansi.h>
void create()
{
	set_name("纸信", ({"letter"}) );
	set_weight(5);
	set("long",
	    "\n恩师雪公亲启:\n"+
	    "　　弟子虽被逐出琼宫，多年来未曾或忘师门教诲，未自立门户，未收一名弟子，\n"+
	    "终盼有朝一日重返师门，以侍奉师父师母在侧．恩师对弟子向如再生父母，情义深\n"+
	    "如东海，重似泰山，弟子粉身碎骨亦无以为报．前些日在天湖畔偶遇小公主，甚喜\n"+
	    "恩师终于一家团聚，小公主身怀绝技，控鹤自如，将来必能继承琼宫大业，弟子即\n"+
	    "使远在千里之外，也会为师门兴盛衷心祝福．\n"+
	    "　　　　　　　　　　　　　　　　　　　　　　　　　不肖弟子　宝儿敬上\n"+
	    "\n");
	set("unit", "张");
        set("value", 0);
}

