inherit NPC;
void create() {
  set_name("镇狱明王", ({ "ming wang" }));
  set("gender", "男性");
  set("str", 56);
  set("combat_exp", 3000000);
  set("attitude", "friendly");
  set("max_force", 1500);
  set("force", 1500);
  set("force_factor", 15);
  set("no_shown", 1);
  set_skill("force", 160);
  set_skill("staff", 300);
  set_skill("dodge", 160);
  set_skill("ghostclaw", 100);
  map_skill("unarmed", "ghostclaw");

  setup();
  carry_object(__DIR__ "obj/godstaff")->wield();
}
int is_ghost() { return 1; }

void init() {
  add_action("do_kill", "kill");
}
int getme(object me) {
  this_object()->kill_ob(me);
  return 1;
}

int do_kill(string arg) {
  object me;
  me = this_player();
  if (arg == "du wuchang" || arg == "du" || arg == "wuchang") {
    message_vision("毒无常阴恻恻地冷笑道：他妈的活得不耐烦了，送$N一张追魂帖吧！！\n", me);
    call_out("getme", 1, me);
    return 1;
  }
  return 0;
}
