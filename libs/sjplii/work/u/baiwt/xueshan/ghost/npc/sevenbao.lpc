#include <ansi.h>
inherit NPC;

void create()
{
	set_name("七宝大士", ({ "sevencolor" }) );
	set("title", HIM"祁连女妖"NOR);
	set("gender", "女性" );
	set("age", 37);
	set("str", 30);
	set("int", 26);
	set("dex", 30);
	set("long",
		"这看上去仿佛是一座泥塑雕像。\n"
		"她面无表情，一动也不动。\n");
	set("attitude", "peaceful");
	set("max_kee", 1000);
	set("max_gin", 1000);
	set("max_sen", 1000);
	set("kee", 1000);
	set("gin", 1000);
	set("sen", 1000);

        set("force", 1000);
        set("max_force", 1000);
        set("force_factor", 10);
        set("mana", 2000);
        set("max_mana", 2000);
        set("mana_factor", 20);

        set("combat_exp", 9000000);
        set("score", 20000);
	set_skill("literate", 60);
	set_skill("unarmed", 50);
	set_skill("parry", 190);
	set_skill("dodge", 240);
	set_skill("spells", 220);
	set_skill("zuodaoshu", 220);
	set_skill("stormdance", 240);
        map_skill("dodge", "stormdance");
        map_skill("spells", "zuodaoshu");
        set("chat_chance", 10);
        set("chat_msg", ({
                GRN"七宝大士(sevencolor)告诉你：无知鼠辈，见到本座因何不跪？\n"NOR,
                (: random_move :),
        }) );
        set("chat_chance_combat", 90);
        set("chat_msg_combat", ({
		(: command, "sexarray" :),
		(: cast_spell, "forceout" :),
		(: cast_spell, "flashbolt" :),
        }) );
	create_family("雪山琼宫",3,"侍女");
	setup();
	carry_object(__DIR__"obj/paper_light");
}
void attempt_apprentice(object me)
{
        object qingshi;
	if ((int)me->query("marks/送信")==1)
		{command("say 你还楞在这里干什么？快去把信送了！");
		return;}
      command("say 替我把这封信送给琼宫主人，不用拜师我也教你。\n");
	me->set("marks/送信",1);
          qingshi = new(__DIR__"obj/letter");
          qingshi->move(me);
}

int recognize_apprentice(object ob)
{
	if (!(int)ob->query("marks/送信"))
		{command("say 你妄想偷学旁门左道术？");
		return 0;}
      ob->set("id_type", 2);
	return 1;
}
int accept_fight(object me)
{
	printf("不能和一尊泥塑雕像较量。\n\n");
        return 0;
}
