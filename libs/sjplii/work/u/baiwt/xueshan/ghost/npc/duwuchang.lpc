#include <ansi.h>
inherit NPC;
inherit F_MASTER;
int about_zhuren();
string summon_more(object who);
void create()
{
	set_name("毒无常", ({ "du wuchang", "du", "wuchang" }));
	set("long",
	    "他是号称天下最毒的毒无常。\n"+
	    "他的名字已经没有人记得了，只知道他浑身上下没一处不沾毒。\n");
	set("title", HIG "万木枯萎"HIM "百花凋谢" NOR);
	set("gender", "男性");
	set("age", 46);
        set("str", 30);
        set("int", 30);
        set("cor", 30);
        set("spi", 30);
	set("max_kee", 1000);
	set("max_gin", 1000);
	set("max_sen", 1000);
	set("kee", 1000);
	set("gin", 1000);
	set("sen", 1000);

        set("force", 1000);
        set("max_force", 1000);
        set("force_factor", 20);

        set("combat_exp", 4000000);
        set("score", 2000);

        set_skill("literate", 80);
        set_skill("force", 100);
        set_skill("unarmed", 200);
        set_skill("parry", 100);
        set_skill("dodge", 100);
        set_skill("ghoststeps", 100);
        set_skill("hotforce", 100);
        set_skill("ghostclaw", 200);
        map_skill("force", "hotforce");
        map_skill("unarmed", "ghostclaw");
        map_skill("dodge", "ghoststeps");

        set("chat_chance_combat", 90);
        set("chat_msg_combat", ({
		(: perform_action, "unarmed.diyulian" :),
		(: summon_more(this_object()) :),
        }) );
	create_family("幽冥教",3, "弟子");
	set("class", "deadman");
        set("inquiry", ([
                "教主" : (: about_zhuren :),
        ]));
	setup();
	carry_object(__DIR__"obj/clothb")->wear();
}

void attempt_apprentice(object ob)
{
	message_vision("毒无常阴笑道：“做我的徒弟可要替我去杀人。”\n",ob);
       command("recruit " + ob->query("id"));
		if((string)ob->query("class") != "deadman")
			ob->set("class", "deadman");
                ob->set("id_type", 2);
	message_vision("毒无常轻声道：“本教弟子进谷时只需从山壁上往东爬(climb east)。”\n",ob);
       return;
}
int accept_object(object who, object ob)
{
	object room;
	if( ob->name() == "腐烂的尸体") {
	if(!( room = find_object("/u/baiwt/xueshan/ghost/yougu")) )
		room = load_object("/u/baiwt/xueshan/ghost/yougu");
        say( "毒无常桀桀怪笑道：干得好，我这就送你过去。\n");
	message_vision(HIC"\n毒无常伸手抓住$N的衣领，提起来便往桥另一头遁去。\n"NOR,who);
        who->move(room);
	message_vision(HIC"\n毒无常提着$N走了过来，轻轻将$N放下，又阴笑着离开了。\n"NOR,who);
// destruct(ob);
 return 1;
        }
		else {
			say("毒无常冷哼一声，说道：你给我什么？\n");
// destruct(ob);
 return 1;
                }
        return 1;
}
int about_zhuren()
{
      say("毒无常说道：想见教主？先去给我拿一具腐烂的尸体来！\n");
	return 1;
}
int accept_fight(object me)
{
	command("say 老子没空陪你玩耍。");
        return 0;
}
string summon_more(object who)
{
	int i;
	object *enemy;
	seteuid(getuid());
	enemy = who->query_enemy();
	i = sizeof(enemy);
	while(i--) {
	if(!enemy[i]->query_condition("corpsesick"))
		enemy[i]->apply_condition("corpsesick",random(10)+10);
	message_vision(HIB "\n毒无常伸出二指，突然向$N的面门一弹。\n" NOR, enemy[i]);	
	message_vision( HIG "$N忽然闻到一股恶腥气，刹那间觉得体内五脏六腑刀绞般难受。\n\n" NOR,enemy[i]);
	}
	return "1";
}

