#include <ansi.h>
inherit ITEM;
void create()
{
	int	i;
        string *names = ({
                "娃娃鱼", "龙虾", "甲鱼", "泥鳅",
        });
	i = random(4);
        set_name( names[i], ({ "fish" }));
	set_weight(5);
	set("long",
		"这是一条具有滋补功效的河鲜。\n");
	set("unit", "条");
        set("objattrib", 1);
        set("value", 0);
}

