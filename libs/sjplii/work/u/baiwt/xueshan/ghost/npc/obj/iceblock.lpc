inherit ITEM;
#include <ansi.h>
void create()
{
  set_name("凝水寒冰",({"ice block","ice"}));
  set("long", HIW
      "这是一块晶莹剔透，百毒不侵的凝水寒冰。\n" NOR);
  set("value",10);
  set("unit","块");
}

void init()
{
  if(this_player()==environment())
  add_action("do_cure","eat");
}

int do_cure()
{
	object me;
	me = this_player();
	message_vision("$N把凝水寒冰一口吞了下去！\n",me);
	if( !me->query("kill_player_record") )
		me->clear_condition();
	message_vision(HIW"$N只觉一股凉气直透丹田，刹那间神清气爽，烦恼皆无！\n"NOR,me);
//	me->set("env/brief", 0);
//	me->set_alias("l");
//	me->set_alias("look");
	destruct(this_object());
  return 1;
}
