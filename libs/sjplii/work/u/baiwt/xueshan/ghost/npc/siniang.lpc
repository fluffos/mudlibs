#include <ansi.h>
inherit NPC;
inherit F_MASTER;
void create()
{
	set_name("魏四娘", ({ "si niang", "niang" }));
	set("title", "幽冥教教主夫人");
	set("gender", "女性");
	set("age", 25);
	set("nickname", HIC "天香仙子" NOR);
	set("shen_type",1);
	set("attitude", "peaceful");

        set("str", 20);
        set("int", 30);
        set("per", 50);
        set("spi", 30);
	set("max_kee", 3000);
	set("max_gin", 3000);
	set("max_sen", 3000);
	set("kee", 3000);
	set("gin", 3000);
	set("sen", 3000);

        set("force", 3000);
        set("max_force", 3000);
        set("force_factor", 50);

        set("combat_exp", 50000000);
        set("score", 200000);

	set_skill("stealing", 900);
        set_skill("literate", 250);
        set_skill("force", 250);
        set_skill("unarmed", 250);
        set_skill("sword", 250);
        set_skill("parry", 250);
        set_skill("dodge", 250);
        set_skill("ghoststeps", 250);
        set_skill("hotforce", 250);
        set_skill("ghostsword", 250);
        map_skill("sword", "ghostsword");
        map_skill("force", "hotforce");
        map_skill("parry", "ghostsword");
        map_skill("unarmed", "ghostclaw");
        map_skill("dodge", "ghoststeps");

	set("class", "deadman");
	setup();
	carry_object(__DIR__"obj/pink_cloth")->wear();
	carry_object(__DIR__"obj/longsword")->wield();
}

int accept_object(object who, object ob)
{
        object me;
	int score, pot;
	me = this_player();
	if( ob->name() == HIM"玉龙镯"NOR ) {
	if( (int)me->query("combat_exp")< 200000 )  return 1;
	if( (int)me->query("ghost/tianxiang")>1 )  return 1;
	score = (int) me->query("combat_exp");
	pot = (int) me->query("potential");
		me->set("combat_exp", (int) score + 100000);
		me->set("potential", (int) pot + 40000);
	message_vision(CYN "\n魏四娘脸上渐渐增了血色，眼中逐渐放出光芒，对着姬子洛微微一笑。\n" NOR,me);	
 	message_vision(CYN "\n姬子洛双目蕴泪，柔声唤道：四娘，你醒了吗？我知道你总有一天会回到我身边的.\n" NOR,me);	
 	message_vision(HIM "\n两人紧紧地拥抱在了一起，世上再也没有什么能把他们分开。\n" NOR,me);	
 	message_vision(CYN "\n过了好一会儿，姬子洛才轻轻放开魏四娘。两人相视而笑。\n" NOR,me);	
      	message_vision(CYN "\n魏四娘慨然说道：多谢这位" + RANK_D->query_respect(who)
                + "救我性命，你的侠肝义胆定会流传后世！\n"NOR,me);
	me->add("ghost/tianxiang", 1);
	return 1;
        }
		else {
			say("魏四娘面若寒霜，一动也不动。\n");
			return 0;
                }

        return 1;
}
int do_unwie()
{
        if( !this_object()->is_fighting())
        {
                command("unwield sword");
		command("smile");
                return 1;
        }
        else
                call_out("do_unwie", 3);
}

void init()
{
        add_action("do_killing", "kill");

}

int do_killing(string arg)
{

        object player, victim, weapon;
        string name;
        player = this_player();
        if( objectp(victim = present(arg, environment(this_object()))) && living(victim))
        {
                name = victim->name();
                if( name == "姬子洛")
                {
                message_vision("$N皱皱眉头。\n", this_object());
                weapon = present("sword", this_object());
                weapon->wield();
                this_object()->kill_ob(player);
                player->kill_ob(this_object());
                call_out("do_unwie", 3);
                return 0;
                }
                if( name == "魏四娘")
                {
                message_vision("$N皱皱眉头。\n", this_object());
                weapon = present("sword", this_object());
                weapon->wield();
                call_out("do_unwie", 3);
                return 0;
                }
                return 0;
        }
        return 0;
}
int accept_fight(object me)
{
        return 0;
}
