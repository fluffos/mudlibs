#include <ansi.h>
inherit NPC;
//inherit F_VENDOR;
void create() {
  set_name("诸葛六", ({ "seller" }));
  set("gender", "男性");
  set("age", 36);
  set("long",
    "这是一个卖灯笼的小贩.\n"
  );
  set("attitude", "friendly");
  set("combat_exp", 100);
  set_skill("unarmed", 50);
  setup();
  carry_object(__DIR__ "obj/cloth")->wear();

}
void init() {
  object ob;
  ::init();
  if (interactive(ob = this_player()) && !is_fighting()) {
    remove_call_out("greeting");
    call_out("greeting", 1, ob);
  }
}
void greeting(object ob) {
  if (!ob || environment(ob) != environment()) return;
  command("say 我的白纱灯笼幽冥教主一定喜欢。只要五两银子。\n");

}
int accept_object(object who, object ob) {
  int val;
  object paper;
  val = ob->value();
  if (!val)
    return 0;
  else if (val = 500) {
    paper = new(__DIR__ "obj/white_light");
    if (paper) {
      paper->set("targetprice", val);
      paper->move(who);
    }
  }
  say("诸葛六说道：祝你成功！\n");
  return 1;
}
