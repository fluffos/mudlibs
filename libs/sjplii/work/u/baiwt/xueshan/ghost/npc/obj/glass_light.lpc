#include <armor.h>
inherit HEAD;
void create() {
  set_name("琉璃灯笼", ({ "glass_light" }));
  set_weight(1);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("long", "一盏琉璃灯笼。\n");
    set("unit", "盏");
    set("value", 20);
    set("armor_prop/armor", 0);
    set("armor_prop/personality", 1);
    set("wear_msg", "$N轻轻地把一盏$n拿在手上。\n");
    set("unwield_msg", "$N轻轻地把$n放了下来。\n");
    //set("female_only", 1);
  }
  setup();
}
