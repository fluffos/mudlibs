inherit ROOM;

void create()
{
        set("short", "阎王坡");
        set("long", @LONG
这里是一处陡峭的山坡，坡上寸草不生，有一个黑影悄没声息地坐在
一块岩石上，右手拿着一支黑漆漆的笔，左手托着一本泛黄的小簿子，似
乎正在批阅着什么。这个人对周遭的一切都好象漠不关心，视而不见。
LONG
        );
        set("exits", ([ 
	       "northeast" : __DIR__"shengsi",
		"northwest" : __DIR__"yougu",
]));
        set("objects", ([
		__DIR__"npc/yanw" : 1,
       ]) );
        set("outdoors", "xueshan");
        setup();
}

