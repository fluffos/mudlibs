{
        set("short", "冥王洞");
        set("long", @LONG
这是一个阴暗潮湿的山洞，洞口的一块岩石上刻着[冥王洞]三字。洞
里阴风徐徐，也不知从哪里吹来。一条人影静静地站在那里，正用阴冷的
目光打量着你。
LONG
        );
        set("exits", ([ 
	       "southeast" : __DIR__"shengsi",
		"southwest" : __DIR__"yougu",
]));
        set("objects", ([
		__DIR__"npc/mingw" : 1,
       ]) );
        set("outdoors", "xueshan");
        setup();
}

