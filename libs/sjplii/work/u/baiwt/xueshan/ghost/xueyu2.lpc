inherit ROOM;

void create()
{
        set("short", "雪域冰川");
        set("long", @LONG
冰川的冰层，虽因受到阳光已有部分融化，但山顶的雪花，一片片轻
飘飘地下着，就好象白纸屑、水晶末一般，落到冰川之上，逐渐结晶冻结
，最后转化为冰层。所以山上的冰川，亘古不化。由于阳光的折射和散射
，整个冰层都变为浅兰色的透明体，端的是奇丽万状，难以形容。
LONG
        );
        set("exits", ([ 
		"westup" : __DIR__"bingchi",
	       "eastdown" : __DIR__"shanjiao2",
]));
        set("outdoors", "xueshan");
        setup();
}
void init()
{
        add_action("do_go","go");

}

int do_go()
{
if(random(5)){
this_player()->move(this_object());
return 1;
}
}


