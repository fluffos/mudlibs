#include <ansi.h>

inherit ROOM;
void init();
int do_pull(string);
int do_study(string arg);

void create() {
  set("short", "星河密室");
  set("long", @LONG
这里是一间窄小的密室，中央有一张石桌，桌上纵横交错画着一张棋
盘，盘上竟然还有一局未下完的残棋。四周的墙壁刻着一些奇怪的符号，
墙角刻着[星河壁]三字，乍看之下便让人头晕眼花。
LONG
  );
  set("objects", ([
    __DIR__ "obj/chessbook": 1,
    __DIR__ "obj/bqi": 1,
    __DIR__ "obj/wqi": 1,
  ]));
  set("item_desc", ([
    "石桌": "一张破旧的石桌。\n",
    "符号": "这些符号象是许多飞行的黑白棋子。\n",
    "残棋": "一局深奥莫测的残局，对局的双方在桌边刻下[南棋、北斗]四字。\n",
  ]));

  setup();
}

void init() {
  add_action("do_pull", "pull");
  add_action("do_study", "study");
}

int do_pull(string arg) {
  object me = this_player(), room;

  if (!arg || arg != "石桌")
    return notify_fail("你要拉什么？\n");

  if (!(room = find_object(__DIR__ "yongdao")))
    room = load_object(__DIR__ "yongdao");

  if (!objectp(room))
    return notify_fail("ERROR:not found 'yongdao.c' \n");
  message_vision("\n$N拉开石桌，发现桌下有一个暗坑，$N毫不犹豫地跳了下去。\n", me);
  message_vision(NOR "\n", me);
  me->move(room);
  return 1;
}


int do_study(string arg) {
  if (!arg || (arg != "符号" && arg != "fuhao"))
    return 0;
  if (this_player()->query_temp("looked_fuhao") <= 15) {
    write("四处飞行的黑白棋子，其势奥妙无穷．．．\n");
    return 1;
  } else
    return 0;

}
