#include <ansi.h>

inherit ROOM;

void init();
int do_write(string);

void create()
{
	object  item, con;
  set("short","土地庙");
  set("long",@LONG
这是雪山脚下的土地庙，中央供着一尊土地神像。像前摆着一张香案
，案上有一个香炉，里面装满了香灰。
LONG
     );
  set("outdoors", "xueshan");
  set("exits",([
      "eastdown" : __DIR__"mroad",
      "southup" : __DIR__"shanroad0",
     ]));
  set("objects",([
    __DIR__"npc/longya" : 1,
    __DIR__"obj/xianglu" : 1,
    ]));
  set("item_desc",([
      "香灰" : "这是一炉香灰，还有一些打翻在了地上。\n" ,
      "连理祠" : "你瞎想什么？\n" ,
     ]));
        set("valid_startroom", 1);
  set("no_fight",1);
  set("no_steal",1);
	set("no_magic",1);
	set("NONPC",1);

  setup();
//    call_other( "/u/baiwt/xueshan/xsobj/xs-board", "???" )
call_other( "/obj/board/xs-board", "???" );
}

void init()
{
	add_action("do_write", "write");
}

void reset()
{
        object *inv;
        object con, item;
        ::reset();
        con = present("xianglu", this_object());
        inv = all_inventory(con);
        if( !sizeof(inv) ) {
        item = new(__DIR__"obj/earthsheet");
        item->move(con);
        }
}


int do_write(string arg)
{
	object me=this_player(), room;

	if(!arg || arg!="连理祠")
		return notify_fail("你要写什么？\n");

	if(!( room = find_object(__DIR__"lianlici")) )
		room = load_object(__DIR__"lianlici");

	if(!objectp(room))
		return notify_fail("ERROR:not found 'xianchou.c' \n");
	message_vision("\n$N用香灰在地上写了[连理祠]三个字。\n",me);
	message_vision(HIG"\n聋哑老人抬头看了你一眼，突然双目透出精光，对$N诡异地点了点头。\n",me);
	message_vision(HIG"\n$N只觉天旋地转，脚下地板突然裂开，$N掉了下来。\n\n"NOR, me);
//   　message("vision","$N只觉天旋地转，脚下地板突然裂开，$N掉了下来。\n", room);

        me->move(room);
        return 1;
}
