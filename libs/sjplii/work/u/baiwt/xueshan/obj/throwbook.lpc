inherit ITEM;

void create()
{
	set_name( "暗器秘诀", ({ "throwing book","book" }));
	set_weight(200);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "本");
		set("long", "这是一本暗器秘诀，上面记录着一些暗器的修练法门。\n");
		set("value", 500);
		set("material", "paper");
		set("skill", ([
			"name":	"throwing",	
			"exp_required":	300,	// minimum combat experience required
			"sen_cost": 20, 	// jing cost every time study this
			"difficulty":	20,	// the base int to learn this skill
			"max_skill":	50,	// the maximum level you can learn
		]) );
	}
}
