#include <ansi.h>
#include <weapon.h>
inherit BLADE;
void create() {
  set_name(HIY "金翅刀" NOR, ({ "goldblade", "blade" }));
  set_weight(4000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "柄");
    set("value", 4000000);
    set("material", "gold");
    set("long", "这是一柄金色的弯刀，看上去象大鹏的半边翅膀，寒光闪闪。\n");
    set("wield_msg", "$N抽出一把明晃晃的$n握在手中。\n");
    set("unequip_msg", "$N将手中的$n插入腰间的刀鞘。\n");
  }
  init_blade(150);
  setup();
}
