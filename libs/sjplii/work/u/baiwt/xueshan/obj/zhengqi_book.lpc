inherit ITEM;

void create()
{
	set_name( "春秋八法", ({ "chunqiu book","book" }));
	set_weight(200);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "本");
		set("long", "这是一本记录春秋八法的书籍，上面详细写着一些为人处世的道义和法门。\n");
		set("value", 0);
		set("material", "paper");
		set("skill", ([
			"name":	"zhengqijue",	
			"exp_required":	30000,	// minimum combat experience required
			"sen_cost": 30, 	// jing cost every time study this
			"difficulty":	30,	// the base int to learn this skill
			"max_skill":	100,	// the maximum level you can learn
		]) );
	}
}
