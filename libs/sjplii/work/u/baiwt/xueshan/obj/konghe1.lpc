inherit ITEM;

void create()
{
	set_name( "控鹤功法图上册", ({ "konghe1", "tu" }));
	set_weight(200);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "本");
		set("long", "这是控鹤功法上册，上面画着一些纷繁复杂的驾驭术及修练法门。\n");
		set("value", 500);
		set("material", "paper");
		set("skill", ([
			"name":	"konghegong",	
			"exp_required":	50000,	// minimum combat experience required
			"sen_cost": 30, 	// jing cost every time study this
			"difficulty":	30,	// the base int to learn this skill
			"max_skill":	30,	// the maximum level you can learn
		]) );
	}
}
