inherit ITEM;

void create()
{
	set_name( "星云牌", ({ "throwing pai","pai" }));
	set_weight(200);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "块");
		set("long", "这是一块黑玉牌，上面密密麻麻刻着许多字.\n");
		set("skill", ([
			"name":	"fantianqi",	
			"exp_required":	20000,	// minimum combat experience required
			"sen_cost": 60, 	// jing cost every time study this
			"difficulty":	60,	// the base int to learn this skill
			"max_skill":	120,	// the maximum level you can learn
		]) );
	}
}
