// pink_cloth.c

#include <armor.h>

inherit HEAD;

void create()
{
	set_name("玉莲佩", ({ "jade flower"}) );
	set_weight(1);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "一块翠绿欲滴的玉佩，正面刻有一朵莲花，反面刻着一个[雪]字.\n");
		set("unit", "块");
		set("value", 20000);
		set("objattrib", 1);
		set("armor_prop/armor", 2);
		set("armor_prop/personality", 5);
		set("wear_msg", "$N轻轻地把一块$n戴在身上。\n");
		set("unwield_msg", "$N轻轻地把$n从身上除了下来。\n");
	}
	setup();
}

