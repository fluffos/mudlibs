#include <ansi.h>
inherit EQUIP;

void create()
{
	set_name("土遁符", ({ "escape_sheet", "sheet" }) );
	set_weight(300);
	set("unit", "块");
	set("long",
		"这是一块黑不溜秋的铁牌，上面画着一座土地庙.\n");
	set("value", 500);
	set("type", "misc");
	set("apply", ([
		"头部":	0,
	]) );
}

void init()
{
	add_action("do_ji", "ji");
}

int do_ji(string arg)
{
	string place;
	object me=this_player(),room;
	int number;
	if(!arg || arg!="escape_sheet")
		return notify_fail("你要祭什么？\n");

      if (environment(me)->query("hell"))
	return notify_fail("这里无法使用土遁符！\n");
 if (environment(me)->query("oldarea"))
	return notify_fail("这里无法使用土遁符！\n");

	if (present("zhangfatu2", environment(me)))
	return notify_fail("这里无法使用土遁符！\n");
	if (present("master ni", environment(me)))
	return notify_fail("这里无法使用土遁符！\n");
	if((int)me->query("gin") < 60 )
		return notify_fail("你的精神没有办法有效集中！\n");
	if((int)me->query("sen") < 60 )
		return notify_fail("你的精神没有办法有效集中！\n");

	number=random(12);
	me->receive_damage("gin", 50);
	me->receive_damage("sen", 50);

	if(number <= 3){
		place = "/u/baiwt/xueshan/tudimiao.lpc";
	if(!( room = find_object(place)) )
	{
	message_vision(HIC"\n$N拿出土遁符凌空祭了一祭。\n"NOR, me);
	message_vision(YEL"\n突然一股怪风将$N拔地卷起，连人带风化做一道轻烟又钻入了地下.\n\n"NOR,me);
        me->move(place);
	message_vision(YEL"\n$N只觉天旋地转，满嘴都是泥土气息，眨眼间来到了雪山的土地庙.\n\n"NOR, me);
	destruct(this_object());
	return 1;
	}}

	if(number <= 6){
		place = "/u/baiwt/xueshan/shanroad.lpc";
	if(!( room = find_object(place)) )
	{
	message_vision(HIC"\n$N拿出土遁符凌空祭了一祭。\n"NOR, me);
	message_vision(YEL"\n突然一股怪风将$N拔地卷起，连人带风化做一道轻烟又钻入了地下.\n\n"NOR,me);
        me->move(place);
	message_vision(YEL"\n$N只觉天旋地转，满嘴都是泥土气息，眨眼间来到了小路.\n\n"NOR, me);
	destruct(this_object());
	return 1;
	}}

	if(number <= 9){
		place = "/u/baiwt/xueshan/guanroad2.lpc";
	if(!( room = find_object(place)) )
	{
	message_vision(HIC"\n$N拿出土遁符凌空祭了一祭。\n"NOR, me);
	message_vision(YEL"\n突然一股怪风将$N拔地卷起，连人带风化做一道轻烟又钻入了地下.\n\n"NOR,me);
        me->move(place);
	message_vision(YEL"\n$N只觉天旋地转，满嘴都是泥土气息，眨眼间来到了青石官道.\n\n"NOR, me);
	destruct(this_object());
	return 1;
	}}

	if(number <= 12){
		place = "/u/baiwt/xueshan/ghost/shanpo1.lpc";
	if(!( room = find_object(place)) )
	{
	message_vision(HIC"\n$N拿出土遁符凌空祭了一祭。\n"NOR, me);
	message_vision(YEL"\n突然一股怪风将$N拔地卷起，连人带风化做一道轻烟又钻入了地下.\n\n"NOR,me);
        me->move(place);
	message_vision(YEL"\n$N只觉天旋地转，满嘴都是泥土气息，眨眼间来到了陡坡.\n\n"NOR, me);
	destruct(this_object());
	return 1;
	}}

	place = "/u/baiwt/xueshan/tudimiao.lpc";
	message_vision(HIC"\n$N拿出土遁符凌空祭了一祭。\n"NOR, me);
	message_vision(YEL"\n突然一股怪风将$N拔地卷起，连人带风化做一道轻烟又钻入了地下.\n\n"NOR,me);
        me->move(place);
	message_vision(YEL"\n$N只觉天旋地转，满嘴都是泥土气息，眨眼间来到了雪山的土地庙.\n\n"NOR, me);
	destruct(this_object());
	return 1;
}

