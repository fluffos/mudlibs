inherit ROOM;
void create()
{
        set("short", "幽林小筑");
        set("long", @LONG
葱翠的竹林之中赫然出现一座小阁楼。阁楼全部由碧绿的青竹搭建而
成，荫凉解暑，终日散发着竹子的清香。阁楼前有一片空地，一个老人正
安详地坐在那里研磨草药。
LONG
        );
        set("exits", ([ 
		"west" : __DIR__"zhulin",
	       "east" : __DIR__"zhulin2",
]));
        set("objects", ([
		__DIR__"npc/gexianren" : 1,
       ]) );
        set("outdoors", "xueshan");
        setup();
}

