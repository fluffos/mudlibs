#include <ansi.h>

inherit ROOM;

void init();
int do_zuo(string arg);

void create()
{
  set("short","仙鹤湖");
  set("long",@LONG
山道到此突然消失，在你面前竟然出现白茫茫一片湖水，在群山环抱
之中，倒映着满山的冰川，让人疑是人间仙境。原来这个大湖，便是世界
第一高湖，藏名叫做[腾格里海]，它的湖面海拔在四千六百七十二公尺以
上，也就是说约相当于三个泰山的高，真是世界独一无二的奇迹。
LONG
     );
  set("outdoors", "xueshan");
  set("exits",([
      "eastdown" : __DIR__"shanlu1",
     ]));
  set("objects",([
    __DIR__"npc/xianhe" : 2,
    __DIR__"npc/lian" : 1,
//    __DIR__"obj/jade2" : 1,
    ]));
  setup();
}

void init()
{
	add_action("do_zuo", "zuo");
}

int do_zuo(string arg)
{
	object me=this_player(), room;
	if(me->query_temp("xueshan/allow_fly") < 1)
		return notify_fail("干什么？\n");

	if(!arg || arg!="仙鹤")
		return notify_fail("你要骑什么？\n");

	if(!( room = find_object(__DIR__"shanyao")) )
		room = load_object(__DIR__"shanyao");

	if(!objectp(room))
		return notify_fail("ERROR:not found 'xianchou.c' \n");
	message_vision(HIW "\n$N轻轻一跃，骑到了仙鹤背上，只见白鹤引吭高鸣，驮着$N振翅飞过山涧。\n",me);
	message_vision(NOR "\n",me);
        me->move(room);
	me->start_busy(1);
        return 1;
}

