
inherit ROOM;

void create()
{
	set("short", "冰谷深渊");
	set("long", @LONG
四周白朦朦的，你隐约发现山道到了尽头，前面已是万丈深渊了。
LONG
	);
	set("exits", ([ /* sizeof() == 1 */
  "southdown" : __DIR__"binggu",
]));
        set("item_desc", ([
      		"mountain": "山虽陡，但还有落脚之处。你似乎可以试着爬(climb)下去。\n",
      		"山": "山虽陡，但还有落脚之处。你似乎可以试着爬(climb)下去。\n",
      		"down": "山虽陡，但还有落脚之处。你似乎可以试着爬(climb)下去。\n",
        ]) );
	set("outdoors", "xueshan");
	setup();
}
void init()
{
	add_action("do_climb", "climb");
}

int do_climb(string arg)
{
        object obj;
        object me;
        if(!arg || arg=="")
        {
                write("你要爬什么？\n");
                return 1;
        }
        if( arg == "山" || arg == "mountain" || arg == "down")
        {
        me = this_player();
        message_vision("$N慢慢地往峭壁下爬去。\n", me);
        me->move(__DIR__"ping_tai.lpc");
        return 1;
        }
        else
        {
                write("你不可以爬"+arg+"\n");
                return 1;
        }
}

