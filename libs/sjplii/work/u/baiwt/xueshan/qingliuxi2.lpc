inherit ROOM;

void create() {
  set("short", "清流溪");
  set("long", @LONG
这是一条环绕着翠竹林的小溪。溪水清澈见底，五彩斑斓的鹅卵石在阳
光的照耀下反射出美丽的光环。溪中不时地有几尾小鱼在悠闲地游来游去。
LONG
  );
  set("exits", ([
    "west": __DIR__ "zhulin3",
    "eastdown": __DIR__ "shanroad3",
  ]));
  set("outdoors", "xueshan");
  setup();
}
