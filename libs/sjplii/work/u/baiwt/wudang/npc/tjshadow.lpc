// 太极拳影

#include <ansi.h>

inherit NPC;
void backattack();
void create()
{

	set_name("太极拳影", ({ "taiji shadow" }) );
	set("max_atman", 100);
	set("atman", 100);
	set("max_mana", 100);
	set("mana", 100);
	set("no_shown",1);

	set("str", 30);
//	set("cor", 30);
	set("cps", 30);

	set("combat_exp", 70000);
	set_skill("unarmed", 70);
	set_skill("parry", 100);
	set_skill("taiji-ken", 70);
        map_skill("unarmed", "taiji");

	setup();
}

int heal_up()
{
	if( environment() && !is_fighting() ) {
		call_out("leave", 1);
		return 1;
	}
	if( is_fighting() && (int) this_object()->query("kee") <= 100)
	backattack();
	return ::heal_up() + 1;
}

void leave()
{
	object owner;
        if(objectp(owner=this_object()->query("possessed")))
		owner->add_temp("max_taiji",-1);
	message("vision",
		 name() + "发出的圆圈渐渐变小。\n\n"
		+ name() + "渐渐消失了。\n" , environment(),
		this_object() );
	destruct(this_object());
}

void invocation(object who, int level)
{
	int i;
	object *enemy;
	set_skill("unarmed", 70 + random(level/2));
	set_skill("parry", 100 + random(level/2));
	set_skill("taiji-ken", 70 + random(level/2));
	set("combat_exp", 100000 + random(level/4*level*level));
	enemy = who->query_enemy();
	i = sizeof(enemy);
	while(i--) {
		if( enemy[i] && living(enemy[i]) ) {
			kill_ob(enemy[i]);
			if( userp(enemy[i]) ) enemy[i]->fight_ob(this_object());
			else enemy[i]->kill_ob(this_object());
		}
	}
//	set_leader(who);
	set("possessed",who);
}
void backattack()
{
	int i;
	object owner, *enemy;
	if(objectp(owner=this_object()->query("possessed")))
	{
		enemy = this_object()->query_enemy();
        i = sizeof(enemy);
        while(i--) {
                if( enemy[i] && living(enemy[i]) ) {
                        owner->kill_ob(enemy[i]);
                        enemy[i]->kill_ob(owner);
                }
        }

	}

}

void die()
{
	object owner;
        if(objectp(owner=this_object()->query("possessed")))
                owner->add_temp("max_taiji",-1);
	message("vision",
		 name() + "发出的圆圈渐渐变小。\n\n"
		+ name() + "渐渐消失了。\n" , environment(),
		this_object() );
	destruct(this_object());
}
