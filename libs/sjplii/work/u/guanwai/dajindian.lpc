inherit ROOM;

void create() {
  set("short", "大金瓦殿");
  set("long", @LONG
大金瓦殿是塔尔寺的主体建筑，为汉式宫殿三檐歇山式结构，镏
金铜瓦顶，金光四射，灿烂夺目。殿内壁画是全寺著名的艺术“三绝
”之一。北面是小金瓦殿，南面是大强巴殿。
LONG
  );
  set("exits", ([
    "west": __DIR__ "dajingtang",
    "east": __DIR__ "guangchang",
    "north": __DIR__ "xiaojindian",
    "south": __DIR__ "daqiangdian",
  ]));
  set("objects", ([
    __DIR__ "npc/yabu": 1,
    __DIR__ "npc/lama": 2,
  ]));
  set("valid_startroom", 1);
  set("outdoors", "guanwai");
  setup();
  call_other("/obj/board/guanwai_b", "???");
}
