
inherit ROOM;

void create()
{
        set("short", "青海湖鸟岛");
        set("long", @LONG
你面前出现了一个达的内陆湖，仿佛沙漠甘泉般伸展于青海高原
上。湖中有鸟岛、海西山、海心山、三块石和沙岛。鸟岛位于湖的西
北部，长年栖息着十余万只各类候鸟，堪称［鸟的王国］。
LONG
        );
        set("exits", ([ 
  "north" : __DIR__"grassland0",
  "south" : __DIR__"grassland5",
  "west" : __DIR__"grassland5",
  "east" : __DIR__"grassland5",
]));
	set("objects",([
		__DIR__"npc/yilina" : 1,
       	]));
        set("outdoors", "guanwai");
        setup();
        replace_program(ROOM);

}

