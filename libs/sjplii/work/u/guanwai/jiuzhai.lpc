inherit ROOM;

void create() {
  set("short", "九寨沟");
  set("long", @LONG
四川阿坝藏族南坪县，是岷山山脉万山丛中一条纵深八十余里的山沟
谷地。因周围曾有九个藏族村寨错落其间而得名。沟中地僻人稀，自然景
物特异，有“世外桃源”之称。
LONG
  );
  set("exits", ([ /* sizeof() == 2 */
    "eastdown": __DIR__ "nowo1",
    "west": __DIR__ "nopubu",
    "northup": __DIR__ "nowo2",
    "southup": __DIR__ "nowo3",
  ]));
  set("outdoors", "guanwai");
  set("hell", 1);
  set("objects", ([
    __DIR__ "npc/gushouzhen": 1,
  ]));
  setup();
}
