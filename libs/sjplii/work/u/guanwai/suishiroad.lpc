{
	set("short", "碎石路");
	set("long", @LONG
一条碎石铺就的大路，向西延伸。
LONG
	);
	set("exits", ([ /* sizeof() == 2 */
  "east" : __DIR__"chezhan2",
  "west" : __DIR__"qutansi",
