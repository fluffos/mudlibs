void init()
{
        add_action("do_go","go");

}

int do_go()
{
if(random(3)){
this_player()->move(this_object());
return 1;
}
}
int valid_leave(object me, string dir)
{
	if (dir == "west" ) {
        if ( me->query("quest/guanfu") =="mine" )
	{
	me->move("/u/guanwai/kuang_shan");
	return notify_fail("\n");
	}
	else
        return ::valid_leave(me, dir);
        }   
        return ::valid_leave(me, dir);
}
