#include <ansi.h>
inherit NPC;
string reward_more( object who);

void create()
{

	set_name("铜杖喇嘛", ({ "tong lama", "tong", "lama" }) );
	set("long", "这是一位黄衣喇嘛，主守阿叠多杖阵的“铜”字位。\n");
	set("attitude", "friendly");

	set("str", 40);
	set("cor", 30);
	set("cps", 25);
	set("class", "lama");
	set("max_kee", 1000);
	set("max_sen", 1000);

	set("combat_exp", 900000);
        set_skill("unarmed", 100);
	set_skill("dodge", 200);
	set_skill("move", 200);
        set_skill("staff", 100);
        set_skill("force", 100);
        set_skill("parry", 200);
        set_skill("literate", 100);
	set_skill("iron-cloth", 200);

	set_skill("tianzhu_finger", 100);
	set_skill("kongling_staff", 100);
	set_skill("xuanzang_force", 100);
	set_skill("yoga", 100);
        set_skill("jinzhong_zhao", 100);
	set_skill("yixing_huanwei", 100);

	map_skill("unarmed", "tianzhu_finger");
        map_skill("force", "xuanzang_force");
        map_skill("dodge", "yixing_huanwei");
        map_skill("iron-cloth", "jinzhong_zhao");
        map_skill("staff", "kongling_staff");
        map_skill("parry", "kongling_staff");
        set("chat_chance_combat", 50);
        set("chat_msg_combat", ({
		(: reward_more(this_object()) :),
        }) );
	setup();
        carry_object("/d/city/obj/weapon/staff/chanzhang")->wield();
        carry_object("/d/city/obj/cloth/sengpao")->wear();
        carry_object("/d/city/obj/cloth/sengxie")->wear();
}
void init()
{
        object ob;
        ::init();
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
        }
}

void greeting(object ob)
{
	object me = this_object();
        if( !ob || environment(ob) != environment() ) return;
	if( ob->query("class") != "lama" && ob->query_temp("lama/jianzhen")<1 )
	{
	command("say 好大的胆子，竟敢擅闯阿叠多杖阵，拿命来吧！\n");
	message_vision(CYN"$N长杖一振，展开了阿叠多杖阵！\n" NOR, me, ob);
	message_vision(CYN"但见人影翻飞，杖风呼啸，交织错落，登时将$n罩在一片杖网之中！\n" NOR, me, ob);
	me->set("combat_exp", (int)ob->query("combat_exp")*3/2 );
	if( ob->query("combat_exp") < 900000 )  me->set("combat_exp", 1500000);
	me->kill_ob(ob);
	ob->kill_ob(me);
	ob->set("break_jianzhen", 0);
	}
	else
	{
	command("say 有人来闯阵了，阿修罗就位！\n");
	message_vision(CYN"$N长杖一振，展开了阿叠多杖阵！\n" NOR, me, ob);
	message_vision(CYN"但见人影翻飞，杖风呼啸，交织错落，登时将$n罩在一片杖网之中！\n" NOR, me, ob);
	me->set("combat_exp", (int)ob->query("combat_exp") );
	if( ob->query("combat_exp") < 900000 )  me->set("combat_exp", 1500000);
	me->fight_ob(ob);
	ob->fight_ob(me);
	}
}
string reward_more(object who)
{
	int i;
	object *enemy;
	seteuid(getuid());
	enemy = who->query_enemy();
	i = sizeof(enemy);
	while(i--) {
		if( enemy[i] && living(enemy[i]) ) {
			if( enemy[i]->query("combat_exp") > 1500000 ) return "1";
			enemy[i]->add("combat_exp", random(2)+1 );
		if( enemy[i]->query("potential")-enemy[i]->query("learned_points") > 500 ) return "1";
				else
			enemy[i]->add("potential", random(2)+1 );
		}
	}
	return "1";
}
int accept_fight(object me)
{
        return 0;
}
void die()
{
	object me = this_player();
	if( me->query("id_type") == 2 )  me->add("break_jianzhen", 1);
	::die();
}
