inherit NPC;
inherit F_MASTER;

void create() {
  set_name("纳曲格尔", ({ "naqu geer", "naqu", "geer" }));
  set("gender", "男性");
  set("age", 26);
  set("long",
    "纳曲格尔主要负责办理加入塔尔寺的事宜，平时有贵客到来时也由他出面招呼。\n");
  set("inquiry", ([
    "here": "这里是闻名西域的塔尔寺。",
  ]));
  set("attitude", "peaceful");
  set("force", 200);
  set("max_force", 200);
  set("force_factor", 10);
  set("combat_exp", 200000);
  set("score", 10000);
  set_skill("unarmed", 50);
  set_skill("dodge", 40);
  set_skill("move", 40);
  set_skill("staff", 40);
  set_skill("force", 40);
  set_skill("parry", 40);
  set_skill("literate", 30);
  set_skill("iron-cloth", 40);

  set_skill("tianzhu_finger", 50);
  set_skill("kongling_staff", 40);
  set_skill("xuanzang_force", 40);
  set_skill("yoga", 30);
  set_skill("chanting", 30);
  set_skill("jinzhong_zhao", 40);
  set_skill("yixing_huanwei", 40);

  map_skill("unarmed", "tianzhu_finger");
  map_skill("force", "xuanzang_force");
  map_skill("dodge", "yixing_huanwei");
  map_skill("iron-cloth", "jinzhong_zhao");
  map_skill("staff", "kongling_staff");
  map_skill("parry", "kongling_staff");

  create_family("塔尔寺", 7, "弟子");

  setup();

  //	carry_object(__DIR__"obj/1staff")->wield();
  carry_object(__DIR__ "obj/redcloth")->wear();
}

void attempt_apprentice(object ob) {
  if (ob->query("class")) {
    command("say 本寺不收留别派弟子，施主请回吧。\n");
    return;
  }
  command("smile");
  command("say 好吧，" + RANK_D->query_respect(ob) + "以后要维护本寺尊严！\n");
  command("recruit " + ob->query("id"));
}

void recruit_apprentice(object ob) {
  if (::recruit_apprentice(ob))
    ob->set("class", "lama");
  ob->set("id_type", 1);
}
