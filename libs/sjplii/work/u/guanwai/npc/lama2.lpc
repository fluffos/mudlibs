inherit NPC;
string reward_more(object who);

void create() {
  set_name("黄衣喇嘛", ({ "huangyi lama", "lama" }));
  set("gender", "男性");
  set("age", 25);
  set("str", 20);
  set("long", @LONG
一个塔尔寺的藏僧。
LONG
  );
  set("attitude", "peaceful");

  set("combat_exp", 99000 + random(9000));
  create_family("塔尔寺", random(2) + 8, "弟子");
  set_skill("unarmed", 50);
  set_skill("blood_strike", random(20) + 10);
  set_skill("force", 40);
  map_skill("unarmed", "blood_strike");
  set_skill("iron-cloth", 10);
  set("chat_chance", 10);
  set("chat_msg", ({
    (: random_move :),
  }));
  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: reward_more(this_object()) :),
  }));

  setup();
  if (random(5) == 1)
    carry_object(__DIR__ "obj/moonbook");
  carry_object(__DIR__ "obj/yelcloth")->wear();
  carry_object(__DIR__ "obj/1staff")->wield();
}
string reward_more(object who) {
  int i;
  object *enemy;
  seteuid(getuid());
  enemy = who->query_enemy();
  i = sizeof(enemy);
  while (i--) {
    if (enemy[i] && living(enemy[i])) {
      if (enemy[i]->query("combat_exp") < 120000) return "1";
      if (enemy[i]->query("combat_exp") > 200000) return "1";
      enemy[i]->add("combat_exp", 1);
      if (enemy[i]->query("potential") - enemy[i]->query("learned_points") > 500) return "1";
      else if (random(9) < 5)
        enemy[i]->add("potential", 1);
      else
        enemy[i]->add("life_exp", 1);
    }
  }
  return "1";
}
int accept_fight(object me) {
  return 1;
}
