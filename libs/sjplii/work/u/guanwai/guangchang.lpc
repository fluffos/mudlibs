inherit ROOM;

void create() {
  set("short", "广场");
  set("long", @LONG
塔尔寺广场是黄教法王集众举行盛大宗教典礼的地方。广场很大
，入口处高高悬挂着一口报事钟，十分引人注目。北面是全寺喇嘛用
斋的膳房，南面是法器屋。
LONG
  );
  set("exits", ([
    "west": __DIR__ "dajindian",
    "east": __DIR__ "simen",
    "north": __DIR__ "shanfang",
    "south": __DIR__ "faqiwu",
  ]));
  set("objects", ([
    __DIR__ "npc/ataishi": 1,
    __DIR__ "npc/lama2": 3,
  ]));
  set("outdoors", "guanwai");
  setup();
}
int valid_leave(object me, string dir) {
  object ob;
  if (dir == "south" && present("atai shi", environment(me)) &&
    me->query("class") != "lama")
    return notify_fail("阿泰什高大的身影拦住了去路，合什说道：“非本寺弟子请回！”\n");
  return ::valid_leave(me, dir);
}
