inherit ROOM;

void create() {
  set("short", "瞿昙寺");
  set("long", @LONG
这里是藏传壁画的宝库。寺内壁画长廊共五十一间，并以连环画
的形式画出了释迦牟尼一生的故事。画面上日月星辰、山川云雨、人
物器具、亭台楼阁、花草树木、飞禽走兽、仪仗兵器等应有尽有，场
面宏大，层次分明，艺术精湛，实为古代艺术珍品。
LONG
  );
  set("exits", ([
    "east": __DIR__ "suishiroad",
    "west": __DIR__ "grassland0",
  ]));
  set("objects", ([
    __DIR__ "npc/xinwen": 1,
    "/npc/nknpc": 1,
  ]));
  setup();
  replace_program(ROOM);

}
