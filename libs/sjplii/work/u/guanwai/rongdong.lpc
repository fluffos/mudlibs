
inherit ROOM;

void create()
{
        set("short", "蜀南溶洞");
        set("long", @LONG
溶洞以卧虎岭下的天泉洞最著名。主洞长一千三百余米，可容万人，
洞顶的钟乳石，琳琅满目。主洞两旁有耳洞、吊洞、风洞等十多个大溶洞
，形成洞中有洞、洞下有洞的奇观。洞内有深不见底的“阴河”，河中生
活着灰白透明的小鱼，俗称玻璃鱼，出洞见光即死。
LONG
        );
        set("exits", ([ /* sizeof() == 2 */
  "west" : __DIR__"shihai1",
  "east" : __DIR__"shihai2",
  "northeast" : __DIR__"shilin",
]));
//        set("outdoors", "changan");
	set("objects",([
		__DIR__"npc/boliyu" : 2,
       	]));

        setup();
	replace_program(ROOM);
}
