inherit ROOM;

void create() {
  set("short", "闻思学院");
  set("long", @LONG
闻思扎仓（即汉语“学院”）是全寺最大的经学院，为藏式和古
宫殿式的混合结构，其正殿十一开间，有柱一百十七根，可容纳三千
名喇嘛同时诵经。
LONG
  );
  set("exits", ([
    "south": __DIR__ "dajingtang",
    "west": __DIR__ "lama_zhen",
  ]));
  set("objects", ([
    __DIR__ "npc/wochi": 1,
  ]));
  set("outdoors", "guanwai");
  setup();
  replace_program(ROOM);

}
