// dumpling.c

inherit ITEM;
inherit F_FOOD;

void create()
{
	set_name("油辣猪排", ({ "zhu pai" }) );
	set_weight(80);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "一块油辣猪排。\n");
		set("unit", "个");
		set("value", 1500);
		set("food_remaining", 3);
		set("food_supply", 60);
	}
}
