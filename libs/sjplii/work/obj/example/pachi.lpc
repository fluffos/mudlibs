// dumpling.c

inherit ITEM;
inherit F_FOOD;

void create()
{
	set_name("生烧扒翅", ({ "pa chi" }) );
	set_weight(80);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long", "一块生烧扒翅。\n");
		set("unit", "个");
		set("value", 5000);
		set("food_remaining", 3);
		set("food_supply", 60);
	}
}
