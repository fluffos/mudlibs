// /obj/npc/bodyguard.c
//bodyguard.c created by Baiwt
#include <ansi.h>
int do_detect(object me);
int eff_kees(object me);

inherit NPC;
void create()
{
	set_name("随从", ({ "body guard", "guard" }) );
	set("long", "这是一位随从护卫，专门担任保护之责。\n");
	set("attitude", "friendly");

	set("max_atman", 100);
	set("atman", 100);
	set("max_mana", 100);
	set("mana", 100);
	set("food", 500);
	set("water", 500);

	set("str", 40);
	set("cor", 30);
	set("cps", 25);

	set("combat_exp", 70000);
	set_skill("blade", 50);
	set_skill("parry", 50);
	set_skill("dodge", 50);
	set_skill("move", 50);
	set_skill("spring-blade", 50);
	map_skill("blade", "spring-blade");
	map_skill("parry", "spring-blade");
	set("chat_chance_combat", 50);
	set("chat_msg_combat", ({
		(: eff_kees(this_object()) :),
	}) );
	setup();

	carry_object("/obj/cloth")->wear();
	carry_object("/obj/blade")->wield();
}
int heal_up()
{
	object mguard=this_object();
	mguard->set("title", chinese_number(mguard->query("kee")/100)+"名");
	if((string)mguard->query("player_guard")&& !present((string)mguard->query("player_guard"),environment(mguard))
 && !userp(environment(mguard)) && random(9)>4)
	{
		call_out("leave", 1);
		return 1;
	}
	return ::heal_up() + 1;
}

void leave()
{
	message("vision",name()+"急急忙忙地离开了。\n"NOR , environment(),
		this_object() );
	destruct(this_object());
}
int eff_kees(object me)
{
	object mguard=this_object();
	mguard->set("title", chinese_number(mguard->query("kee")/100)+"名");
       return 1;
}

void invocation(object who, int level)
{
	int i;
	object *enemy;
	int libuexp;
//	level=(int)who->query_skill("officialism")+(int)who->query_skill("economics")
	set_skill("blade", 50 + random(level/2));
	set_skill("spring-blade", 70 + random(level/2));
	set_skill("parry", 50 + random(level/2));
	set_skill("dodge", 50 + random(level/2));
	set_skill("move", 50 + random(level/2));
	libuexp=(int)who->query("relation_exp")+(int)who->query("combat_exp")/2+(int)who->query("life_exp")/3;
	if(libuexp > 90000000) libuexp=90000000;
	if((int)who->query("id_type")==3)
	set("combat_exp", 70000 + random(level/4*level*level)+ libuexp);

	enemy = who->query_enemy();
	i = sizeof(enemy);
	while(i--) {
		if( enemy[i] && living(enemy[i]) ) {
			kill_ob(enemy[i]);
			if( userp(enemy[i]) ) enemy[i]->fight_ob(this_object());
			else enemy[i]->kill_ob(this_object());
		}
	}

	set_leader(who);
	set("possessed",who);
}
void die()
{
	object owner;
      if(objectp(owner=this_object()->query("possessed")))
                owner->add_temp("max_guard",-1);
//	this_object()->dismiss_team();
	::die();
}
