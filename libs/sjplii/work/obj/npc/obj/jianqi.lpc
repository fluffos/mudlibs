// pearl.c

#include <weapon.h>

inherit THROWING;

void create()
{
	set_name("剑气", ({ "jianqi" }) );
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("long",	"一堆无形无质的剑气\n");
		set("unit", "堆");
		set("base_unit", "股");
		set("base_weight", 1);
		set("base_value", 1);
	}
	set_amount(50);
	init_throwing(1);
	setup();
}
