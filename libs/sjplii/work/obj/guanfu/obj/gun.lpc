// gun.c

#include <ansi.h>
#include <weapon.h>

inherit HAMMER;

void init()
{
        add_action("do_aim","aim");
        add_action("do_shoot","shoot");
}

void create()
{
	set_name("火铳", ({ "huo chong", "chong", "gun" }) );
	set_weight(2000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "把");
		set("bullet", 3);
		set("guanfu/objattrib", 4);
		set("value", 0);
		set("material", "steel");
	       set("no_drop", 1);
		set("long", "这是一把乌黑的火铳，里面满装着火药弹。\n");
		set("wield_msg", "$N从腰间掏出一把$n握在手中。\n");
		set("unequip_msg", "$N将手中的$n插回腰间。\n");
	}
        init_hammer(10);
	setup();
}

int do_aim(string arg)
{
	object me, obj;
	
	me = this_player();

	if( !arg )
		return notify_fail("你想对付谁？\n");
	if( me->query_delay()>0 && me->query_delay()<3 )
		return notify_fail("你正忙着呢！\n");

//	if( environment(me)->query("no_fight") )
//		return notify_fail("这里不准战斗。\n");
        if( me->query_temp("sleeping") ) return 
		notify_fail("你正在睡眠中。\n");

	if( this_object()->query("bullet") <=0)
		return notify_fail("弹药已经打光了。\n");

	if(!objectp(obj = present(arg, environment(me))))
		return notify_fail("这里没有这个人。\n");

	if( !obj->is_character() || obj->is_corpse() )
		return notify_fail("看清楚一点，那并不是活物。\n");

	if(obj == me)
		return notify_fail("用 suicide 指令会比较快:P。\n");

	message_vision(HIY "\n$N举起火铳，远远地瞄准$n，接着「克」地一声，把弹药压上了膛。\n\n" NOR, 
			me, obj);

	this_object()->set_temp("target", arg);

	return 1;
}

int do_shoot()
{
	object me, obj;
	string arg;

	me = this_player();
	if( environment(me)->query("no_arrest") )
		return notify_fail("这里不准战斗。\n");
	if( environment(me)->query("no_fight") )
		return notify_fail("这里不准战斗。\n");
        if( me->query_temp("sleeping") ) return 
		notify_fail("你正在睡眠中。\n");

	if( !(arg = this_object()->query_temp("target")) ) 
		return notify_fail("你还没有瞄准你的射击目标！\n");

	if( !objectp(obj = present(arg, environment(me)) ))
		return notify_fail("你要射击的对象已经离开了。\n");

	message_vision(HIR "\n$N对准$n扣动了扳机！！！\n只听「乒」地一声巨响，$n惨叫一声，顿时满身鲜血！\n\n" NOR,
			me, obj);

	this_object()->add("bullet", -1);
	obj->receive_wound("kee", random(300)+200);
	this_object()->delete_temp("target");
	if ( obj )
	{
	obj->kill_ob(me);
	if ( !obj->query_wait() )
	obj->set_wait(2);
	}
	me->set_delay(1);
	return 1;
}

