// gun.c

#include <ansi.h>
#include <weapon.h>

inherit HAMMER;

void init()
{
        add_action("do_aim","aim");
        add_action("do_shoot","shoot");
}

void create()
{
	set_name("流星矢", ({ "shooting star" }) );
	set_weight(2000);
	if( clonep() )
		set_default_object(__FILE__);
	else {
		set("unit", "个");
		set("bullet", 10);
		set("guanfu/objattrib", 2);
		set("value", 0);
		set("material", "steel");
	       set("no_drop", 1);
		set("long", "这是一个装有流星矢的竹筒。\n");
		set("wield_msg", "$N从腰间掏出一个装有$n的竹筒握在手中。\n");
		set("unequip_msg", "$N将手中的竹筒插回腰间。\n");
	}
        init_hammer(10);
	setup();
}

int do_aim(string arg)
{
	object me, obj;
	
	me = this_player();

	if( !arg )
		return notify_fail("你想对付谁？\n");
	if( me->query_delay()>0 && me->query_delay()<3 )
		return notify_fail("你正忙着呢！\n");
	if( environment(me)->query("no_fight") )
		return notify_fail("这里不准战斗。\n");
        if( me->query_temp("sleeping") ) return 
		notify_fail("你正在睡眠中。\n");

	if( this_object()->query("bullet") <=0)
		return notify_fail("流星矢已经打光了。\n");

	if(!objectp(obj = present(arg, environment(me))))
		return notify_fail("这里没有这个人。\n");

	if( !obj->is_character() || obj->is_corpse() )
		return notify_fail("看清楚一点，那并不是活物。\n");

	if(obj == me)
		return notify_fail("用 suicide 指令会比较快:P。\n");

	message_vision(HIY "\n$N举起竹筒，暗暗地瞄准$n，接着「咔」地一声，打开了发射孔。\n\n" NOR, 
			me, obj);

	this_object()->set_temp("target", arg);

	return 1;
}

int do_shoot()
{
	object me, obj;
	string arg;

	me = this_player();
	if( environment(me)->query("no_fight") )
		return notify_fail("这里不准战斗。\n");
        if( me->query_temp("sleeping") ) return 
		notify_fail("你正在睡眠中。\n");

	if( !(arg = this_object()->query_temp("target")) ) 
		return notify_fail("你还没有瞄准你的射击目标！\n");

	if( !objectp(obj = present(arg, environment(me)) ))
		return notify_fail("你要射击的对象已经离开了。\n");

	message_vision(HIR "\n$N对准$n按动了竹筒背面的弹簧！！！\n只见一束暗赤光华闪过，$n惨叫一声，顿时满身鲜血！\n\n" NOR,
			me, obj);

	this_object()->add("bullet", -1);
	obj->receive_wound("kee", random(100)+60);
	this_object()->delete_temp("target");
	if ( obj ) obj->kill_ob(me);
	me->set_delay(1);

	return 1;
}

