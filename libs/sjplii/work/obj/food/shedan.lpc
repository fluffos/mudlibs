inherit ITEM;
inherit F_FOOD;

void create()
{
        set_name("毒蛇胆", ({"shedan"}) );
        set_weight(250);
        if( clonep() )
                set_default_object(__FILE__);
        else {
		set("unit", "个");
                set("long", "一个青白色的毒蛇胆\n");
                set("value", 1000);
                set("food_remaining", 1);
                set("food_supply", 5);
	}
	setup();
}

void init()
{
      	add_action("do_eat", ({"eat"}));
}


int do_eat(string arg)
{
	if(!id(arg))return 0;
	if( (int)this_player()->query("food") >= (int)this_player()->max_food_capacity() )
	return notify_fail("你已经吃太饱了，再也塞不下任何东西了。\n");

       tell_object(this_player(), "你全身颤抖，一股腥味令人作呕！\n");
       if(this_player()->query_condition("snake_poison")) {
	         this_player()->apply_condition("snake_poison", 0);
	         message_vision("$N吃下蛇胆后，感到身上的蛇毒开始减退。\n", this_player());
                return 1;
         }
	switch(random(6)){
	case 1:	this_player()->add("max_force",random(1));
			break;
       case 2:	this_player()->add("combat_exp",random(1));
			break;  
       case 3:	this_player()->add("potential",random(1));
			break;  
}
return ::do_eat(arg);
}
