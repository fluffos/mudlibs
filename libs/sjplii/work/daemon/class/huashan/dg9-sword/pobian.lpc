// pobian.c 破鞭式

#include <ansi.h>

inherit SSERVER;

int perform(object me) {
  string msg;
  object weapon, weapon2, target;
  int skill, ap, dp, damage;

  me->clean_up_enemy();
  target = me->select_opponent();

  skill = me->query_skill("dg9-sword", 1);

  if (!(me->is_fighting()))
    return notify_fail("「破鞭式」只能对战斗中的对手使用。\n");

  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "sword")
    return notify_fail("你使用的武器不对。\n");

  if (!objectp(weapon2 = target->query_temp("weapon"))
    || (string)weapon2->query("skill_type") != "hammer"
    || (string)weapon2->query("skill_type") == "axe"
    || (string)weapon2->query("skill_type") == "dagger")
    return notify_fail("对方没有使钢鞭、铁锤之类短兵刃，你用不了「破鞭式」。\n");
  if ((int)me->query("perform/huashan/pobian") < 1000)
    return notify_fail("你还没有学会「破鞭式」！\n");

  if (me->query("force") < 80)
    return notify_fail("你的内力不够，无法运用「破鞭式」！\n");

  msg = HIC "$N巧使独孤九剑「破鞭式」逼近$n，提剑幻出重重剑影，如柔丝般向$n裹去。\n";

  if ((target->query_skill_mapped("force") == "liheforce") &&
    ((int)target->query_skill("liheforce", 1) > (int)me->query_skill("dg9-sword"))) {
    message_vision(msg, me, target);
    message_vision(CYN "\n但是$n施展出 [若即若离] ，$N的攻势莫名其妙地扑了个空！\n" NOR, me, target);
    me->start_busy(2);
    return 1;
  }

  message_vision(msg, me, target);

  damage = 100 + random(skill / 2);
  ap = me->query_skill("sword") + skill;
  if ((string)weapon2->query("skill_type") != "hammer")
    dp = target->query_skill("hammer") / 2;
  if ((string)weapon2->query("skill_type") != "axe")
    dp = target->query_skill("axe") / 2;
  if ((string)weapon2->query("skill_type") != "dagger")
    dp = target->query_skill("dagger") / 2;
  if (dp < 1)
    dp = 1;
  if (random(ap) > dp) {
    if (userp(me))
      me->add("force", -80);
    msg = "$n顿时觉得压力骤增，手腕一麻，手中";
    msg += weapon2->name();
    msg += HIC "脱手而出！\n" NOR;

    target->receive_damage("kee", damage);
    target->start_busy(1);
    weapon2->move(environment(me));
  } else {
    if (userp(me))
      me->add("force", -80);
    msg = "可是$n看破了$N的剑路，立刻采取守势，使$N的「破鞭式」没有起到作用。\n" NOR;
    me->start_busy(3);
  }
  if (!target->query_delay() && target->query_skill("hammer", 1)) {
    target->map_skill("hammer");
    target->reset_action();
    target->set_delay(60);
  }
  if (!target->query_delay() && target->query_skill("axe", 1)) {
    target->map_skill("axe");
    target->reset_action();
    target->set_delay(60);
  }
  message_vision(msg, me, target);
  COMBAT_D->report_status(target);
  return 1;
}
