//瑜珈功----石化术
#include <ansi.h>

inherit F_CLEAN_UP;

void remove_effect(object me, int amount);

int exert(object me, object target) {
  int skill;

  if (target != me)
    return notify_fail("你只能用石化术保护自己。\n");
  if ((int)me->query_skill("yoga") < 30)
    return notify_fail("你的瑜珈功不够高！\n");

  if ((int)me->query("force") < 200)
    return notify_fail("你的内力不够。\n");
  if ((int)me->query_temp("yoga/shield"))
    return notify_fail("你已经在运功中了。\n");

  skill = me->query_skill("yoga");

  me->add("force", -100);
  me->receive_damage("kee", 20);

  message_vision(
    HIW
    "$N微一凝神，施展石化术，浑身上下顿时变得坚硬如岩石一般，站在那里如同一尊石像。\n" NOR, me);

  me->add_temp("apply/armor", skill / 2);
  //	me->add_temp("apply/unarmed", skill/6);
  me->set_temp("yoga/shield", 1);

  me->start_call_out((: call_other, __FILE__, "remove_effect", me, skill / 2 :), skill);

  if (me->is_fighting()) me->start_busy(3);

  return 1;
}

void remove_effect(object me, int amount) {
  if (!me) return;
  me->add_temp("apply/armor", -amount);
  //        me->add_temp("apply/unarmed", -amount/2);
  me->delete_temp("yoga/shield");
  tell_object(me, "你的石化术运行一周天完毕，皮肤上的石纹渐渐消去了。\n");
}
