// kongkeeanjiuhou.c 空前绝后
 
#include <ansi.h>
#include <skill.h>
#include <combat.h>

inherit SSERVER;
 
int perform(object me)
{
	string msg;
	object weapon, target;

	int skill, ap, dp, force_wound, kee_wound;
	if( !target ) target = offensive_target(me);

	if( !target || !target->is_character() || !me->is_fighting(target) )
		return notify_fail("「空前绝后」只能对战斗中的对手使用。\n");
/*
	me->clean_up_enemy();
	target = me->select_opponent();
*/
	if( (int)me->query("force") < 500 )
		return notify_fail("你的内力还不够高！\n");

	if( (int)me->query_skill("unarmed") < 150 )
		return notify_fail("你的拳法还不到家，无法使用空前绝后！\n");

	if( (int)me->query_skill("tiangang-quanfa", 1) < 150)
		return notify_fail("你天罡拳法的修为不够，不能使用空前绝后! \n");

	if( (int)me->query_skill("ziliu-force", 1) < 150 )
		return notify_fail("你的紫流气功不够高，不能用来反震伤敌。\n");

	if( me->query_skill_mapped("unarmed") != "tiangang-quanfa") 
		return notify_fail("你没有激发天罡拳法，无法使用空前绝后！\n");
 
	skill = me->query_skill("tiangang-quanfa",1)+me->query_skill("ziliu-force",1);

	msg = HIR "$N大喝一声，使出天罡拳法的绝技「空前绝后」，双拳势如雷霆，向$n击去。\n"NOR;
	message_vision(msg, me, target);
 	if((target->query_skill_mapped("unarmed") == "taiji-ken")&&
	((int)target->query_skill("taiji-ken") > (int)me->query_skill("tiangang-quanfa")))
	{
	message_vision(CYN"\n但是$n双拳一圈，$N的攻势如泥牛入海，顿时无影无踪！\n" NOR, me,target);
	me->start_busy(2);
	return 1;
	}

	ap = me->query("combat_exp")+(skill+me->query("con")+me->query("dur")+me->query("tol"))*300;
	dp = target->query("combat_exp")/2+(target->query("con")+target->query("dur")+target->query("tol"))*300;
	if( dp < 1 )
		dp = 1;
	if( random(ap) > dp )
	{
		if(userp(me))
			me->add("force",-100);

		msg = HIR "$n只觉得胸前一阵剧痛，“哇”的一声喷出一口鲜血！\n"NOR;
		force_wound = 100 + random(skill);
		if(force_wound > target->query("force"))
			force_wound = target->query("force");

		kee_wound = force_wound / 3;
		if(kee_wound > target->query("kee"))
			kee_wound = target->query("kee");
		if(target->query("force") > force_wound)
		target->add("force", -force_wound);
		target->receive_damage("kee", kee_wound);
		target->start_busy(2);
		me->start_busy(random(2));
	}
	else
	{
		msg = HIC "只见$n不慌不忙，轻轻一闪，躲过了$N的必杀一击！\n"NOR;
		if(userp(me))
			me->add("force",-100);
		me->start_busy(4);
	}
	message_vision(msg, me, target);

	return 1;
}
