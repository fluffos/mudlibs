// qihanyunxiao.c 五气朝阳剑法---气撼云霄

#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target)
{
	string msg;
	int extra, myextra, power;
	object weapon;
	if( !target ) target = offensive_target(me);
	if( !target
	||	!target->is_character()
	||	!me->is_fighting(target) )
		return notify_fail("［气撼云霄］只能对战斗中的对手使用。\n");
	myextra = me->query_skill("wuqichaoyang",1)+me->query_skill("sword",1)+me->query_skill("move",1);
	extra = target->query_skill("parry",1)+target->query_skill("dodge",1);
	power = me->query_skill("wuqichaoyang",1);
	 if( power < 150 )
		    return notify_fail("你的五气朝阳剑不够纯熟，不能使用气撼云霄。\n");
        if( (int)me->query("force") < 500 )
                return notify_fail("你的内力不足，不能使用气撼云霄。\n");

	power = power*(random(2)+1);                        
	weapon = me->query_temp("weapon");
	msg = HIR "$N运内力鼓起一阵劲风，突然化出五道剑气，挟破空之声直向$n面门攻来！ " NOR;
       target->add_temp("apply/iron-cloth", -100);
        if( random(myextra) > random(extra) )
	{
	message_vision("\n"+msg+"\n\n", me, target);
	msg = HIR "第一道剑气掠过，眼花缭乱地摧垮了$n的精力！ " NOR;
	message_vision("\n"+msg+"\n", me, target);
	target->receive_wound("gin", power);

	msg = HIR "第二道剑气掠过，$n只觉得气血翻涌，经脉严重受伤！ " NOR;
	message_vision("\n"+msg+"\n", me, target);
	target->receive_wound("kee", power);

	msg = HIR "第三道剑气掠过，$n只觉得神思恍惚，不知身在何处！ " NOR;
	message_vision("\n"+msg+"\n", me, target);
	target->receive_wound("sen", power);

	msg = HIR "第四道剑气掠过，$n全身内力象决堤似地朝外流失了开去！ " NOR;
	message_vision("\n"+msg+"\n", me, target);
	target->add("force", -power);
	if( target->query("force")<0 )  target->set("force", 0);

	msg = HIR "第五道剑气掠过，使得$n几乎完全丧失了战斗的意志！ " NOR;
	message_vision("\n"+msg+"\n\n", me, target);
	target->add("bellicosity", -power);
	if( target->query("bellicosity")<0 )  target->set("bellicosity", 0);
	COMBAT_D->report_status(target,1);
 	me->add("force", -300);
	me->start_busy(3);
       target->add_temp("apply/iron-cloth", 100);
	return 1;
	}
	else
	COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
 	me->add("force", -300);
       target->add_temp("apply/iron-cloth", 100);

	me->start_busy(3);
	return 1;
}




 

 
    