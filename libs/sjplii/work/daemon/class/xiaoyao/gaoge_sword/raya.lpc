// 相思水舞语

#include <ansi.h>

inherit SSERVER;

int perform(object me, object target) {
  object ob;
  string msg, result, id;
  string dodskill;
  int mychance, yourchance, love, kiss, damage;

  love = (int)me->query("eff_gin");
  kiss = (int)me->query("eff_sen");

  if (!me->query("gaoge"))
    return notify_fail("你无法自己领会，必须向高歌子请教。\n");
  return notify_fail("请使用perform losther。\n");


  dodskill = (string)me->query_skill_mapped("dodge");
  if (dodskill != "wave_steps" || (int)me->query_skill("wave_steps") < 100)
    return notify_fail("需要凌波微步身法的配和！\n");

  if ((int)me->query("bellicosity") > 100)
    return notify_fail("你的杀机太甚，不能体会逍遥自在的意境。\n");

  if (!(ob = me->query_temp("weapon"))
    || (string)ob->query("skill_type") != "sword")
    return notify_fail("你手里必须有一把剑才能使用。\n");

  if (me->query("force_factor") < 80
    || me->query("force_factor") > me->query("force"))
    return notify_fail("使用「相思水舞语」必须竭尽全力!\n");

  if ((int)me->query("gin") < love || (int)me->query("sen") < kiss)
    return notify_fail("你必须全心全意才能感受相思至深的氛围.\n");


  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("「相思水舞语」只能对战斗中的对手使用。\n");

  if (me->query_skill("gaoge_sword", 1) < 150)
    return notify_fail("你的剑法还没达到使用「相思水舞语」的境界!\n");

  id = "舞语";

  if ((string)target->query("id") == id)
    return notify_fail("舞语淡淡的浅笑让你物我两忘，用这尘世间的一切能否换取这灿烂的永恒？\n");


  if (!me->is_busy()) me->start_busy(3);
  message_vision(MAG "\n$N手中的长剑斜依肩头,缓缓的度步向前，\n"
    "深邃的眼眸中放射出迷惘而深挚的目光，望着天际的飘忽的浮云若有所思。\n"
    "$N一声轻叹，长剑从肩头弹起自左向右淡然划出，割裂开了虚无空间。。。\n"
    "剑气激荡起分飞的沙石,裹挟着凌烈的风声，宛若长虹向$n席卷而去\n\n「相思水舞语」\n" NOR
    , me, target);
  mychance = target->is_busy() ? me->query("combat_exp") * 2 : me->query("combat_exp");
  yourchance = random(target->query("combat_exp"));
  if (wizardp(me))
    tell_object(me, sprintf("mychance %d yourchance %d\n",
      mychance, yourchance));
  if (
    mychance < yourchance) {

    me->add("force", -me->query("force_factor"));
    damage = me->query_str() + (int)me->query("force") / 20 + me->query("force_factor") - (int)target->query("force") / 25 + me->query_temp("apply/damage") * 2;
    if (target->query("gender") == "女性" && me->query("gender") == "男性") {
      message_vision(
        HIW "$N看着$n眼眸中凄绝的神情，剑气中轻舞的衣裙，飞扬的长发，不禁心中一动，天那真美好象她。。。舞语。。。手下微微犹豫慢了下来\n" NOR,
        me,
        target
      );
      damage = damage / 2;
    }

    target->recieve_damage("kee", damage, me);
    target->receive_wound("kee", damage -
      (int)target->query_temp("apply/armor"), me);
    result = replace_string(COMBAT_D->damage_msg(damage, "割伤"),
      "$w", (me->query_temp("weapon"))->name());

    message_vision(result, me, target);
    message_vision(HIW "$n一咬牙侧身避开了致命要害,周身衣服尽皆碎裂随着剑气倒飞而出。\n" NOR, me, target);
    target->start_busy(3);
    return 1;

  }

  mychance = random(me->query_skill("gaoge_sword"));
  yourchance = random(target->query_skill("dodge"));
  if (wizardp(me))
    tell_object(me, sprintf("mychance %d yourchance %d\n",
      mychance, yourchance));
  if (mychance < yourchance) {
    me->add("force", -me->query("force_factor"));
    damage = me->query_str() + (int)me->query("force") / 20 + me->query("force_factor") - (int)target->query("force") / 25 + me->query_temp("apply/damage") * 2;
    if (target->query("gender") == "女性" && me->query("gender") == "男性") {
      message_vision(
        HIW "$N看着$n眼眸中凄绝的神情，剑气中轻舞的衣裙，飞扬的长发，不禁心中一动，天那真美好象她。。。。舞语。。。手下微微犹豫慢了下来\n" NOR,
        me,
        target
      );
      damage = damage / 2;
    }

    target->recieve_damage("kee", damage, me);
    target->receive_wound("kee", damage -
      (int)target->query_temp("apply/armor"), me);
    result = replace_string(COMBAT_D->damage_msg(damage, "割伤"),
      "$w", (me->query_temp("weapon"))->name());

    message_vision(result, me, target);
    message_vision(HIW "$n面对漫天剑气，不仅大骇身形倒纵而出想要避开$N致命的攻击，却被强劲的气流席卷而去。\n" NOR, me, target);
    target->start_busy(3);
    return 1;
  }

  mychance = me->query_skill("gaoge_sword");
  yourchance = random(target->query_skill("parry"));
  if (wizardp(me))
    tell_object(me, sprintf("mychance %d yourchance %d\n",
      mychance, yourchance));
  if (mychance < yourchance) {
    me->add("force", -me->query("force_factor"));
    damage = me->query_str() + (int)me->query("force") / 20 + me->query("force_factor") - (int)target->query("force") / 25 + me->query_temp("apply/damage") * 2;
    if (target->query("gender") == "女性" && me->query("gender") == "男性") {
      message_vision(
        HIW "$N看着$n眼眸中凄绝的神情，剑气中轻舞的衣裙，飞扬的长发，不禁心中一动，天那好美呀好象她。。。舞语。。。手下微微犹豫慢了下来\n" NOR,
        me,
        target
      );
      damage = damage / 2;
    }


    target->recieve_damage("kee", damage, me);
    target->receive_wound("kee", damage -
      (int)target->query_temp("apply/armor"), me);
    result = replace_string(COMBAT_D->damage_msg(damage, "割伤"),
      "$w", (me->query_temp("weapon"))->name());

    message_vision(result, me, target);
    message_vision("$n面对铺天盖地席卷迩来的剑影，急舞手中的" +
      (target->query_temp("weapon"))->name() +
      "布下了重重气幕"
      "然而百密一疏，凄厉的剑气终于破开一丝破绽,急电般透射而入!\n"
      , me, target);
    target->start_busy(3);
    return 1;
  }

  if (target->query("gender") == "女性" && me->query("gender") == "男性") {

    me->add("force", -me->query("force_factor"));
    damage = me->query_str() + (int)me->query("force") / 20 + me->query("force_factor") - (int)target->query("force") / 25 + me->query_temp("apply/damage") * 2;


    target->recieve_damage("kee", damage, me);
    target->receive_wound("kee", damage -
      (int)target->query_temp("apply/armor"), me);

    message_vision(HIW "$n只觉得剑影如点点流星从天际划落迩来笼罩了全身要害\n"
      "凄厉的剑气激荡起$n的衣袂，长发随风轻轻飞扬,深眸中露出了凄绝的眼神\n"
      "$N不禁心中一动，天那真的好象她。。。。剑势突然一滞，脸上浮现出一丝莫名的神情，追忆。。迷惘。。。舞语。。\n" NOR
      , me, target);
    COMBAT_D->announce(target, "unconcious");
    target->disable_player(" <昏迷不醒>");
    return 1;

  }

  message_vision(MAG "$n周身笼罩在$N凌厉无比的剑气中避无可避，木然的看着一道凄美的光弧透体而出\n"
    "隐隐的风雷声中，身形乍分乍合瞬间交错.....蓦然间天地间只剩下了静谧\n"
    "$n眼中露出了一丝绝望无奈的神情, 双腿一软, 就倒在地上不动了!\n" NOR,
    me, target);
  me->add("force", -me->query("force_factor"));
  target->die();
  return 1;
}
