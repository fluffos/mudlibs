// 罗袜生尘

#include <ansi.h>

inherit SSERVER;

int perform(object me, object target) {
  string msg;

  if (!target) target = offensive_target(me);
  if ((int)me->query("bellicosity") > 100)
    return notify_fail("你的杀机太甚，不能体会逍遥自在的意境。\n");
  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("特殊技法只能对战斗中的对手使用。\n");

  if (target->is_busy())
    return notify_fail(target->name() + "还没有从惊恐中镇静下来\n");

  if (me->query_skill("wave_steps") < 45 && me->query("force") < 120) {
    return notify_fail("显然你的武功火候不够!\n");
  }
  if ((int)me->query("gin") < 60)
    return notify_fail("你的精神不能集中，找不准方位。\n");
  if (((string)me->query("class") == "xiaoyao") || ((string)me->query("class") == "xiaoyao2")) {
    msg = HIW "$N使出了「罗袜生尘」,脚踏奇门方位身形流转，踪迹飘然不定，不可琢磨.\n";
    me->add("force", -100);
    me->start_busy(1);

    if ((int)target->query_skill("qingfeng-steps") > (int)me->query_skill("wave_steps")) {
      message_vision(CYN "\n但是$n身法轻盈，从$N的攻势圈中绕了出来！\n" NOR, me, target);
      return 1;
    }
    if ((int)target->query_skill("shenkong-xing") > (int)me->query_skill("wave_steps")) {
      message_vision(CYN "\n但是$n身法轻盈，从$N的攻势圈中绕了出来！\n" NOR, me, target);
      return 1;
    }
    if ((int)target->query_skill("bagua-steps") > (int)me->query_skill("wave_steps")) {
      message_vision(CYN "\n但是$n身法轻盈，从$N的攻势圈中绕了出来！\n" NOR, me, target);
      return 1;
    }
    if ((int)target->query_skill("tianluo-steps") > (int)me->query_skill("wave_steps")) {
      message_vision(CYN "\n但是$n身法轻盈，从$N的攻势圈中绕了出来！\n" NOR, me, target);
      return 1;
    }
    if ((int)target->query_skill("piaoxiang-steps") > (int)me->query_skill("wave_steps")) {
      message_vision(CYN "\n但是$n身法轻盈，从$N的攻势圈中绕了出来！\n" NOR, me, target);
      return 1;
    }

    if (random(me->query("combat_exp")) > random(target->query("combat_exp"))) {
      msg += "$p骤然失却目标不禁错愕, $P早已绕到$p的身后。\n" NOR;

      target->start_busy((int)me->query_skill("wave_steps", 1) / 100);
    } else {
      msg += "$p微微一呆但立刻镇静过来，一顿身形向$P追袭而去.\n" NOR;
      target->start_busy(1);
    }
    message_vision(msg, me, target);
    return 1;
  } else
    return notify_fail("你不是逍遥弟子，无法使用“凌波微步”的绝技。\n");
}
