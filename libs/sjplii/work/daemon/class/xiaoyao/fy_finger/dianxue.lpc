//流云拂穴
#include <ansi.h>
inherit SSERVER;
int perform(object me, object target) {
  int me_dodge, ob_dodge;
  int dx;
  string msg;
  string xuewei, dodskill;
  string *name = ({
    "「天突穴」",
    "「廉泉穴」",
    "「承浆穴」",
    "「鱼府穴」",
    "「孔最穴」",
    "「天府穴」",
    "「侠白穴」",
    "「中府穴」",
    "「经渠穴」",
    "「尺泽穴」",
    "「大渊穴」",
    "「云门穴」",
    "「环跳穴」",
    "「肩井穴」",
    "「百汇穴」",
    "「列缺穴」",
    "「玉枕穴」",
    "「偏历穴",
    "「神门穴」",
    "「灵道穴」",
    "「少海穴」",
    "「少府穴」",
    "「通理穴」"
  });
  xuewei = name[random(sizeof(name))];

  if (environment(me)->query("no_fight"))
    return notify_fail("这里禁止战斗。\n");


  dodskill = (string)me->query_skill_mapped("dodge");
  if (dodskill != "wave_steps" || (int)me->query_skill("wave_steps", 1) < 70)
    return notify_fail("需要凌波微步身法的配和！\n");


  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你想对谁施展？？\n");

  me_dodge = me->query_skill("dodge", 1);
  ob_dodge = target->query_skill("dodge", 1);
  dx = me->query_skill("fy_finger", 1);

  if ((int)me->query("force") < 500)

    return notify_fail("你的内力不够，没有办法「流云拂穴」。\n");

  if ((int)me->query("bellicosity") > 100)
    return notify_fail("你的杀机太甚，不能体会逍遥自在的意境。\n");
  if ((int)me->query_skill("fy_finger", 1) <= 150)
    return notify_fail("你的「浮月流云指」还不够精纯，不能「流云拂穴」。\n");
  if ((int)me->query_skill("bm_force") < 50)
    return notify_fail("你的「北冥神功」火候不够！\n");
  if ((int)me->query("force") < (int)target->query("force") / 3)
    return notify_fail("左手食指微屈，一股凄厉的内劲破指而出点向对方的" + xuewei + "却如泥牛入海没有任何反应。\n");

  if (random(dx + me_dodge) < ob_dodge) {
    message_vision(
      BLU "左手食指微屈，一股凄厉的内劲破指而出,结果被$n闪开了。\n" NOR, me, target);
    target->kill_ob(me);
    return 1;
  }
  if (target->is_busy())
    return notify_fail(target->name() + "已经无法动弹了！\n");

  message_vision(HIW "$N对着$n遥遥点出一指,内劲破空而出,正是「流云拂穴」\n" NOR, me, target);

  if ((int)target->query_skill("yoga") > (int)me->query_skill("fy_finger")) {
    message_vision(CYN "\n但是$n全身经脉穴道逆转，根本不为所动！\n" NOR, me, target);
    return 1;
  }
  if ((int)target->query_skill("liumai_force") > (int)me->query_skill("fy_finger")) {
    message_vision(CYN "\n但是$n内力流转，很快冲开了被封的穴道！\n" NOR, me, target);
    return 1;
  }
  if ((int)target->query_skill("jzxj-force") > (int)me->query_skill("fy_finger")) {
    message_vision(CYN "\n但是$n运起穴位转移大法，根本不为所动！\n" NOR, me, target);
    return 1;
  }
  if ((int)target->query_skill("liuhe-force") > (int)me->query_skill("fy_finger")) {
    message_vision(CYN "\n但是$n真气鼓动，眨眼冲开了被封的穴道！\n" NOR, me, target);
    return 1;
  }

  msg = HIW "$N食指微屈轻弹一股浑厚阴柔的内劲疾刺$n的" + xuewei;
  msg += "\n$n登时只觉得头脑眩晕，全身麻木再也行动不得.\n" NOR;
  message_vision(msg, me, target);
  target->start_busy((int)me->query("force") / 500);
  me->add("force", -300);
  return 1;
}
