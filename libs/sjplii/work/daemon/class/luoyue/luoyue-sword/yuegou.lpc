// 月钩西沉
//written by baiwt

#include <ansi.h>

inherit SSERVER;

int perform(object me, object target)
{
	string msg;
	int extra;
	object weapon;
	if( !target ) target = offensive_target(me);

	if( !target
	||	!target->is_character()
	||	!me->is_fighting(target) )
		return notify_fail(" [月钩西沉] 只能对战斗中的对手使用。\n");
        if((int)me->query_skill("luoyue-sword",1) < 70 )
                return notify_fail("你的落月剑法不够高！\n");

	extra = me->query_skill("luoyue-sword",1) - target->query_skill("dodge",1);
	weapon = me->query_temp("weapon");
	if( extra > 0 )  me->add_temp("apply/damage", extra);
	msg = YEL  "$N内带落月剑法中的精髓 [月钩西沉] ，闪电般的划向$n！\n" NOR;
	message_vision(msg, me, target);
       target->add_temp("apply/iron-cloth", -extra);

	COMBAT_D->do_attack(me,target, me->query_temp("weapon"));
	msg = YEL + weapon->name()+ "从$n身侧掠了过去 .  .  . \n" NOR;
	message_vision(msg, me, target);
	if( extra > 0 )
	{
	msg =  YEL "\n$N手中"+ weapon->name()+"突然弯了过来，犹如一柄倒钩，反向$n背心刺到！\n" NOR;
	message_vision(msg, me, target);
	target->receive_wound("kee", extra*2 );
	COMBAT_D->report_status(target,1);
	me->add_temp("apply/damage", -extra);
	}
       target->add_temp("apply/iron-cloth", extra);

	me->start_busy(2);
	return 1;
}
