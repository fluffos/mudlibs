// yue.c

#include <ansi.h>

inherit F_CLEAN_UP;

int exert(object me, object target) {
  object *ob, mygod;
  int i, skill, damage;
  string envarg;

  if (environment(me)->query("no_fight"))
    return notify_fail("这里禁止战斗。\n");

  if ((int)me->query("force") < 100)
    return notify_fail("你的内力不够。\n");

  if (me->query_skill("xuanyue-force", 1) < 100)
    return notify_fail("你的玄月心法太差了，不能使用月字决！\n");

  skill = me->query_skill("force");

  me->add("force", -100);
  me->receive_damage("kee", 10);

  me->start_busy(3);
  message_vision(
    HIC "$N运起玄月心法中的「月字决」，一阵澈骨的寒气从$N周身弥漫开来。\n\n" NOR, me);
  if (objectp(present("fire god", environment(me)))) {
    mygod = present("fire god", environment(me));
    message_vision(
      HIR "$n对着$N吹了口热气，转眼将$N周身弥漫的寒气化了开去。\n\n" NOR, me, mygod);
    return 1;
  }
  ob = all_inventory(environment(me));
  for (i = 0; i < sizeof(ob); i++) {
    if (!living(ob[i]) || ob[i] == me) continue;
    if (skill / 2 + random(skill / 2) < (int)ob[i]->query("cps") * 2) continue;

    damage = skill - ((int)ob[i]->query("max_force") / 15);
    if (damage > 0) {
      ob[i]->receive_damage("kee", damage);
      if ((int)ob[i]->query("force") < skill * 2)
        ob[i]->receive_wound("sen", damage / 2);
      tell_object(ob[i], HIC "你觉得周围冷的要命，身子不住的打颤。\n\n" NOR);
    }

    if (userp(ob[i])) ob[i]->fight_ob(me);
    else if (!ob[i]->is_killing(me)) ob[i]->kill_ob(me);
  }

  if (environment(me)->query("short"))
    envarg = environment(me)->query("short");
  if (envarg)
    log_file(
      "EXERT_LOG",
      sprintf("(%s) %s exert yue at %s\n", ctime(time()), me->query("id"), envarg)
    );

  return 1;
}
