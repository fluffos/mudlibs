// 十里天变  baiwt@sjpl 1,7,2001

#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target) {
  int power, extra;
  object weapon, mygod;
  if (me->is_busy())
    return notify_fail("你现在没空！！\n");
  if (!target) target = offensive_target(me);
  seteuid(geteuid(me));

  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("［十里天变］只能对战斗中的对手使用。\n");
  weapon = me->query_temp("weapon");
  extra = me->query_skill("winds-blade", 1);
  if (extra < 100)
    return notify_fail("你的［十里狂刀］还不够。\n");
  if (me->query_skill("blade", 1) < 100)
    return notify_fail("你的［基本刀法］还不够。\n");
  if (!me->query_temp("tianbian/fhz"))
    return notify_fail("你没念过 [饮风浴火咒] ，不能施展天变。\n");

  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "blade")
    return notify_fail("你没使用刀，不能施展天变。\n");

  if ((int)me->query("force") < 100)
    return notify_fail("你的内力不够。\n");

  power = me->query_temp("tianbian/power") + 1;
  if (power > 6) me->add_temp("tianbian/power", -5);
  if (random(9) > 4) {
    if (!objectp(present("fire god", environment(me)))) {
      message_vision(HIR "\n$N身形倒退三步，施展绝技[十里天变]，眨眼间狂风呼啸，火光骤起！\n" NOR, me, target);
      mygod = new("/daemon/troop/maoshan/firegod2");
      mygod->move(environment(me));
      message_vision(HIR "\n火凤凰的身影突然出现在一团火光之中！\n" NOR, me, target);
      if (me->query("force") >= 50)
        me->add("force", -50);
      me->add_temp("tianbian/fhz", -1);
      return 1;
    } else
      mygod = present("fire god", environment(me));
    if (mygod->query_delay()) {
      message_vision(HIR "\n火凤凰扑棱着翅膀扇起熊熊火焰！\n" RED, me, target);
      return 1;
    }
    message_vision(HIR "\n$N刀光借着火凤凰吐出的火焰灼烧下向$n扑去！" NOR, me, target);
    message_vision(HIR "\n$n很快陷于烈火焚身之中！\n" NOR, me, target);
    target->receive_wound("kee", extra * power);
    COMBAT_D->report_status(target, 1);
    mygod->set_delay(10);
  } else {
    if (!objectp(present("wind god", environment(me)))) {
      message_vision(HIR "\n$N身形倒退三步，施展绝技[十里天变]，眨眼间狂风呼啸，火光骤起！\n" NOR, me, target);
      mygod = new("/daemon/troop/maoshan/windgod2");
      mygod->move(environment(me));
      message_vision(HIC "\n随着大风愈刮愈烈，风婆的身影渐渐在半空中浮现出来。\n" NOR, me, target);
      if (me->query("force") >= 50)
        me->add("force", -50);
      me->add_temp("tianbian/fhz", -1);
      return 1;
    } else
      mygod = present("wind god", environment(me));
    if (mygod->query_delay()) {
      message_vision(HIC "\n风婆撒开泼风袋，刮起阵阵大风！\n" NOR, me, target);
      return 1;
    }
    message_vision(HIC "\n$N刀口饮风而啸，身周卷起一阵回旋风，使$N精神大振！\n" NOR, me, target);
    me->receive_heal("sen", extra);
    me->receive_curing("sen", extra);
    COMBAT_D->report_status(me, 1);
    mygod->set_delay(4);
  }
  if (me->query("force") >= 50)
    me->add("force", -50);
  me->add_temp("tianbian/fhz", -1);
  me->add_temp("tianbian/power", 1);
  me->set_delay(2);
  return 1;
}
