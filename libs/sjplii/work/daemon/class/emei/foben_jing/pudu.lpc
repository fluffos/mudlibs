//普渡心经

#include <ansi.h>

//inherit F_CLEAN_UP;

void remove_effect(object me, int amount);

int conjure(object me, object target, int amount)
{
        int skill;

        if( target != me ) return 
notify_fail("你只能用普渡心经压制自己的杀气。\n");

        if( (int)me->query("magic") < 100 )     return 
notify_fail("你的内力不够。\n");
        if( me->query_temp("powerfade") ) return 
notify_fail("你已经在运功中了。\n");
        if( (int)me->query("bellicosity") <= 0 )
                return notify_fail("你现在毫无杀气。\n");

        skill = me->query_skill("magic");

        me->add("bellicosity", - 100 - skill/3 );
        me->add("atman", -100);
        me->receive_damage("gin", 100);

        message_vision(
                HIC "$N神色庄重，盘膝坐地，默念起普渡心经来，开始收敛自己的杀气 
....\n" NOR, me);

        if( me->is_fighting()
        &&      (random(skill) < (int)me->query("cps") * 3 ) )
                me->unconcious();

        return 1;
}

void remove_effect(object me, int amount)
{
        me->add_temp("apply/attack", - amount);
        me->add_temp("apply/dodge", - amount);
        me->add_temp("apply/damage", - amount);
        me->delete_temp("powerfade");
        tell_object(me, "你的普渡心经运行完毕，灵力重新聚集起来。\n");
}
 
