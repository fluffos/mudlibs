// 虚灵九式
#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target)
{
	string forskill,msg;
	int extra;
	object weapon;
	extra = me->query_skill("wind_sword",1);
	if ( extra < 90) return notify_fail("你的［乱披风剑法］还不够纯熟！\n");
	forskill = (string) me->query_skill_mapped("force");
	if ( forskill != "taiqing_force")
			return notify_fail("［虚灵九式］需要太清玄功的配和！\n");
	if( !target ) target = offensive_target(me);
	if( !target
	||	!target->is_character()
	||	!me->is_fighting(target) )
		return notify_fail("［虚灵九式］只能对战斗中的对手使用。\n");
	weapon = me->query_temp("weapon");
	me->add_temp("apply/attack", -5);	
	msg = YEL  "$N手中"+ weapon->name() +"一振，东一剑，西一剑，洒出漫天剑影！\n" NOR;
	if((target->query_skill_mapped("sword") == "dg9-sword")&&
	((int)target->query_skill("dg9-sword") > (int)me->query_skill("wind_sword")))
	{
      message_vision(msg, me, target);
	message_vision(CYN"\n但是$n剑法一展，$N的攻势莫名其妙地扑了个空！\n" NOR, me,target);
	me->add_temp("apply/attack", 5);	
	me->start_busy(2);
	return 1;
	}
       target->add_temp("apply/iron-cloth", -extra/2);

	COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
        msg = YEL  "东一剑，西一剑，剑风无处不在！" NOR;
        msg += NOR  "\n但是$n身影晃动，闪了开去！\n" NOR;
	message_vision(msg, me, target);

        msg = YEL  "东一剑，西一剑，剑风无处不在！" NOR;
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);

        msg = YEL  "东一剑，西一剑，剑风无处不在！" NOR;
        msg += NOR  "\n但是$n纵跃闪躲，剑风落空了！\n" NOR;
	message_vision(msg, me, target);

        msg = YEL  "东一剑，西一剑，剑风无处不在！" NOR;
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);

        msg = YEL  "东一剑，西一剑，剑风无处不在！" NOR;
        msg += NOR  "\n但是$n反身招架，剑风却被引了开去！\n" NOR;
	message_vision(msg, me, target);

        msg = YEL  "东一剑，西一剑，剑风无处不在！" NOR;
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);

        msg = YEL  "东一剑，西一剑，剑风无处不在！" NOR;
        msg += NOR  "\n但是$n方一措手不及，剑风已经消失了！\n" NOR;
	message_vision(msg, me, target);

        msg = YEL  "东一剑，西一剑，剑风无处不在！" NOR;
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
	me->add_temp("apply/attack", 5);	
       target->add_temp("apply/iron-cloth", extra/2);

	me->start_busy(5);
	return 1;
}
