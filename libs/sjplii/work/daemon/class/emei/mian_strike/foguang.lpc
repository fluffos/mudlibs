//金顶佛光
#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target)
{
	string msg;
	int extra;
	object weapon;
	if( !target ) target = offensive_target(me);

	if( !target
	||	!target->is_character()
	||	!me->is_fighting(target) )
		return notify_fail("［金顶佛光］只能对战斗中的对手使用。\n");
        if( me->query_skill_mapped("force") != "taiqing_force" )
                return notify_fail("金顶绵掌只有配合「太清神功」才能发挥威力。\n");

	extra = me->query_skill("mian_strike",1) ;
	if(extra <= 80 ) return notify_fail("你的［金顶绵掌］不够熟练！\n");
	msg = HIY +me->query("name")+"掌影起处，乍现一道金光，无声无息向"+target->query("name")+"按去！" NOR;
        weapon = me->query_temp("weapon");
	extra = me->query_skill("mian_strike",1) /10;
	target->add_temp("apply/damage",extra);
	target->add_temp("apply/dodge",-extra);
	target->add_temp("apply/parry",-extra);
        COMBAT_D->do_attack(target,target, target->query_temp("weapon"),TYPE_REGULAR,msg);
	target->add_temp("apply/damage",-extra);
	target->add_temp("apply/dodge",extra);
	target->add_temp("apply/parry",extra);

	if( !me->query_soft_powerup() )
		me->soft_powerup(extra/2,30);
	if( !target->query_delay() )
	{
		target->set_delay(2);
		if(userp(target)) target->add("p_power_rank",-extra*2);
	}
	me->start_busy(2);
	return 1;
}
