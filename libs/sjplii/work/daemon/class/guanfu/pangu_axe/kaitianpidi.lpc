//开天辟地

#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target) {
  string msg;
  int extra;
  object weapon, ride;
  if (me->is_busy())
    return notify_fail("你现在没空！！\n");
  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("［开天辟地］只能对战斗中的对手使用。\n");
  weapon = me->query_temp("weapon");
  extra = me->query_skill("pangu_axe", 1) / 10;
  if (extra * 10 < 70) return notify_fail("你的盘古开天斧还不够纯熟！\n");

  ride = me->query_temp("ridee");
  if (ride) msg = ride->query("id"); else msg = "\n";
  if (msg != "\n" && (ride->query_temp("rider") == me) && present(msg, environment(me))) {
    me->add_temp("apply/damage", extra * 5);
    me->add_temp("apply/dodge", extra * 5);
    me->add_temp("apply/axe", extra * 5);
  }

  target->add_temp("apply/iron-cloth", -extra * 5);

  msg = RED "$N暴喝一声，使出［开天辟地］，手中" + weapon->name() + "挟着千钧之力朝$n的天灵盖横劈过去！" NOR;
  COMBAT_D->do_attack(me, target, weapon, TYPE_REGULAR, msg);

  target->add_temp("apply/iron-cloth", extra * 5);

  if (ride) msg = ride->query("id"); else msg = "\n";
  if (msg != "\n" && (ride->query_temp("rider") == me) && present(msg, environment(me))) {
    me->add_temp("apply/damage", -extra * 5);
    me->add_temp("apply/dodge", -extra * 5);
    me->add_temp("apply/axe", -extra * 5);
  }

  me->start_busy(2);
  return 1;
}
