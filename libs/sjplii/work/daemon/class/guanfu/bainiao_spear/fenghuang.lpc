//凤凰三点头
#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target)
{
	string msg;
	int extra;
	object weapon,ride;
	extra = me->query_skill("bainiao_spear",1);
	if ( extra < 70) return notify_fail("你的百鸟朝凰枪法还不够纯熟！\n");
	if( !target ) target = offensive_target(me);
	if( !target
	||	!target->is_character()
	||	!me->is_fighting(target) )
		return notify_fail("［凤凰三点头］只能对战斗中的对手使用。\n");
	weapon = me->query_temp("weapon");

	ride = me->query_temp("ridee");
	if( ride ) msg = ride->query("id");  else msg = "\n";
	if( msg!="\n" && (ride->query_temp("rider")==me) && present(msg,environment(me)) )
	{
	me->add_temp("apply/damage",extra/2);
	me->add_temp("apply/dodge",extra/2);
	me->add_temp("apply/spear",extra/2);
	}

       target->add_temp("apply/iron-cloth", -extra/2);

	msg = YEL  "$N使出百鸟朝凰枪法中的［凤凰三点头］，将手中的"+ weapon->name()+  "抖出一片枪花，向$n连续攻出三枪！";
	msg += "\n上额第一枪！"NOR;

	COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
        msg = YEL  "咽喉第二枪！" NOR;
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
        msg = YEL  "前胸第三枪！" NOR;
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
       target->add_temp("apply/iron-cloth", extra/2);

	if( ride ) msg = ride->query("id");  else msg = "\n";
	if( msg!="\n" && (ride->query_temp("rider")==me) && present(msg,environment(me)) )
	{
	me->add_temp("apply/damage",-extra/2);
	me->add_temp("apply/dodge",-extra/2);
	me->add_temp("apply/spear",-extra/2);
	}
	me->start_busy(3);
	return 1;
}
