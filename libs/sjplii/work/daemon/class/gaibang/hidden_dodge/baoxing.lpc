//豹行身法
#include <ansi.h>
#include <combat.h>
inherit SSERVER;
void jump_up(object me, object target);
void jump_down(object me);
int perform(object me, object target)
{
        int skill;
        if( (int)me->query_temp("gaibang/baoxing") ) 
                return notify_fail("你已经在施展［豹行身法］了。\n");
        if( !target ) target = offensive_target(me);
        if( !target
        ||      !target->is_character()
        ||      !me->is_fighting(target) )
                return notify_fail("［豹行身法］只能对战斗中的对手使用。\n");
        skill = me->query_skill("hidden_dodge",1);
        if ( skill <= 50) return notify_fail("你的［龟藏豹隐身法］还不够纯熟！\n");
        if( (int)me->query("force") < 500  ) 
                return notify_fail("你的内力不够。\n");
        message_vision(YEL"只见$N猛一吸气，使用出［豹行身法］，瞬间跃到了两尺以外！\n" NOR, me);
	if((int)target->query_skill("qingfeng-steps") > (int)me->query_skill("hidden_dodge"))
	{
	message_vision(CYN"\n但是$n身法轻盈，从$N的攻势圈中绕了出来！\n" NOR, me,target);
	return 1;
	}
	if((int)target->query_skill("shenkong-xing") > (int)me->query_skill("hidden_dodge"))
	{
	message_vision(CYN"\n但是$n身法轻盈，从$N的攻势圈中绕了出来！\n" NOR, me,target);
	return 1;
	}
	if((int)target->query_skill("bagua-steps") > (int)me->query_skill("hidden_dodge"))
	{
	message_vision(CYN"\n但是$n身法轻盈，从$N的攻势圈中绕了出来！\n" NOR, me,target);
	return 1;
	}
	if((int)target->query_skill("piaoxiang-steps") > (int)me->query_skill("hidden_dodge"))
	{
	message_vision(CYN"\n但是$n身法轻盈，从$N的攻势圈中绕了出来！\n" NOR, me,target);
	return 1;
	}
        me->set_temp("gaibang/baoxing", 1);
        me->add("force", -30);
        me->start_busy(1);
        target->start_busy(2);
        call_out("jump_up", 3, me, target);
        call_out("jump_up", 6, me, target);
        call_out("jump_down", 10, me);
        return 1;
}

void jump_up(object me, object target)
{
        string msg;
        msg = YEL"\n$N左腿还未落地，右腿已经在空中向前跨出一步！\n\n" NOR;
	if( !target || !me
	||	!target->is_character()
	||	!me->is_fighting(target) )
		return;
        message_vision(msg, me);
        me->start_busy(1);
        target->start_busy(3);
}
void jump_down(object me)
{
	if( !me ) return;
        me->delete_temp("gaibang/baoxing");
        tell_object(me, YEL"你的［豹行身法］施展完毕，双脚稳稳落到地上。\n"NOR);
        me->start_busy(2);
}