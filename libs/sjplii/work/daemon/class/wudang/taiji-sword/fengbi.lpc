//封闭诀
#include <ansi.h>
#include <combat.h>
inherit SSERVER;
void brave_up(object me, object target);
void stop_atk(object me);
int perform(object me, object target) {
  int skill;
  if ((int)me->query_temp("fengbi"))
    return notify_fail("你已经在施展［封闭诀］了。\n");
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("［封闭诀］只能对战斗中的对手使用。\n");
  skill = me->query_skill("taiji-sword", 1);
  if (skill <= 70) return notify_fail("你的太极剑还不够纯熟！\n");
  if ((int)me->query_skill("taiji-force") < 50)
    return notify_fail("你的太极神功不够高！\n");
  if (me->query_skill_mapped("force") != "taiji-force")
    return notify_fail("太极剑法只有配合「太极神功」才能发挥威力。\n");

  if ((int)me->query("force") < 300)
    return notify_fail("你的内力不够。\n");
  if (skill <= (int)target->query_skill("force", 1) / 2)
    return notify_fail("你使出［封闭诀］，但是却被对方强劲的内力化解了。\n");
  message_vision(YEL "只见$N步下一沉，使出［封闭诀］，双臂缓缓挥动，画出了一个大圆弧！\n" NOR, me);
  me->set_temp("fengbi", 1);
  me->add("force", -100);
  me->start_busy(1);
  call_out("brave_up", 1, me, target);
  call_out("brave_up", 10, me, target);
  call_out("brave_up", 20, me, target);
  call_out("brave_up", 30, me, target);
  call_out("brave_up", 40, me, target);
  call_out("stop_atk", 50, me);
  return 1;
}

void brave_up(object me, object target) {
  string msg;
  msg = YEL "\n$N内力鼓动，身体四周形成了一圈又一圈无形的太极气墙！\n\n" NOR;
  message_vision(msg, me);
  if (!target || !me
    || !target->is_character()
    || !me->is_fighting(target))
    return;
  target->start_busy(1);
  me->set("eff_kee", (int)me->query("max_kee"));
  me->set("kee", (int)me->query("max_kee"));
}
void stop_atk(object me) {
  if (!me) return;
  me->delete_temp("fengbi");
  tell_object(me, CYN "你的［封闭诀］施展完毕，将内力收回丹田。\n" NOR);
  me->set("eff_kee", (int)me->query("max_kee"));
  me->set("kee", (int)me->query("max_kee"));
  return;
}
