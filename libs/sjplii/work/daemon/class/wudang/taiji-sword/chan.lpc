//缠字诀
#include <ansi.h>

inherit SSERVER;
void reduce_ap(object me, object target);
int low_ap;

int perform(object me, object target) {
  string msg;

  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("缠字诀只能对战斗中的对手使用。\n");

  low_ap = me->query_skill("taiji-sword", 1);

  if (!me->query_temp("weapon"))
    return notify_fail("你的手上已经没有武器了！\n");

  if (me->query_skill_mapped("force") != "taiji-force")
    return notify_fail("太极剑法只有配合「太极神功」才能发挥威力。\n");

  if (target->query_temp("chan_eff"))
    return notify_fail(target->name() + "的招式已经乱了，放胆攻击吧！\n");

  msg = CYN "$N使出太极剑法缠字诀，连递数个虚招企图扰乱$n的攻势，";

  me->start_busy(1);
  if (random(me->query_skill("sword")) > target->query_skill("parry") / 2) {
    msg += "结果$n被$N扰了个手忙脚乱！\n" NOR;
    target->set_temp("chan_eff", 1);
    target->start_busy(3);
    target->add_temp("apply/attack", -low_ap);
    target->add_temp("apply/damage", -low_ap);
    target->add_temp("apply/iron-cloth", -low_ap);
    call_out("reduce_ap", 10, me, target);
  } else {
    msg += "可是$n看破了$N的企图，并没有上当。\n" NOR;
  }
  message_vision(msg, me, target);
  return 1;
}

void reduce_ap(object me, object target) {
  string msg;
  if (!target || !target->is_character()) return;
  if (target->query_temp("chan_eff"))
    target->delete_temp("chan_eff");
  message_vision(CYN "\n$n渐渐恢复了镇定。\n" NOR, me, target);
  target->add_temp("apply/attack", low_ap);
  target->add_temp("apply/damage", low_ap);
  target->add_temp("apply/iron-cloth", low_ap);
  return;
}
