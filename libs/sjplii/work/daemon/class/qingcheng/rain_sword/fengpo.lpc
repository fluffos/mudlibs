// 风婆召唤符  baiwt@sjpl 5,25,2000

#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target) {
  int i, extra;
  object *inv;
  object weapon, mygod, paper;
  if (me->is_busy())
    return notify_fail("你现在没空！！\n");
  if (!target) target = offensive_target(me);
  seteuid(geteuid(me));

  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("［风婆召唤符］只能对战斗中的对手使用。\n");
  weapon = me->query_temp("weapon");
  extra = me->query_skill("dormancy", 1);
  if (extra < 60)
    return notify_fail("你的［修仙术］还不够。\n");
  if (me->query_skill("siri_force", 1) < 40)
    return notify_fail("你的［四日玄功］还不够。\n");
  if (!me->query_skill("five-steps", 1))
    return notify_fail("你没有学会五行步法。\n");
  if (!objectp(present("paper seal", me)))
    return notify_fail("你没有桃符纸，无法施展符术。\n");
  if ((int)me->query("force") <= 60)
    return notify_fail("你的内力不够。\n");

  inv = all_inventory(me);
  for (i = 0; i < sizeof(inv); i++) {
    if ((string)(inv[i]->query("id")) != "paper seal")
      continue;
    if ((string)(inv[i]->query("id")) == "paper seal")
      inv[i]->add_amount(-1);
  }

  if (!objectp(present("wind god", environment(me)))) {
    mygod = new("/daemon/troop/maoshan/windgod2");
    message_vision(HIC "\n$N喃喃念动咒语，只见一张符纸缓缓飘上半空。" NOR, me, target);
    message_vision(HIC "\n不久只见四周狂风大作，风声呜呜作响，吹得人气也喘不过来。" NOR, me, target);
    message_vision(HIC "\n随着大风愈刮愈烈，风婆的身影渐渐在半空中浮现出来。\n" NOR, me, target);
    message_vision(HIG "\n［风婆召唤符］！\n\n" NOR, me, target);
    mygod->move(environment(me));
  } else {
    message_vision(CYN "\n$N喃喃念动咒语，只见一张符纸缓缓飘上半空。" NOR, me, target);
    message_vision(CYN "\n过了一会符纸便落了下来。\n\n" NOR, me, target);
  }
  if (me->query("force") >= 10)
    me->add("force", -10);
  me->start_busy(1);
  return 1;
}
