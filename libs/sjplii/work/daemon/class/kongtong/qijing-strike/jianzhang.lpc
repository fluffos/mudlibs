// 剑中掌
#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target)
{
	string forskill,msg,myname;
	int extra;
	object mweapon, tweapon;
	extra = me->query_skill("qijing-strike",1);
	if ( extra < 70) return notify_fail("你的［棋经剑掌］还不够纯熟！\n");
	forskill = (string) me->query_skill_mapped("force");
	if ( forskill != "jzxj-force")
			return notify_fail("［剑中掌］需要甲子玄机心法的配和！\n");
	if( !target ) target = offensive_target(me);
	if( !target
	||	!target->is_character()
	||	!me->is_fighting(target) )
		return notify_fail("［剑中掌］只能对战斗中的对手使用。\n");
	myname = me->query("name");
	mweapon = me->query_temp("weapon");
	tweapon = target->query_temp("weapon");
	if( !tweapon )
		return notify_fail("\n对方没有武器，无法施展［剑中掌］。\n");
	if ( me->query("force") < 100) return notify_fail("你的内力不够！\n");
       target->add_temp("apply/iron-cloth", -100);

	msg = HIR"$n手中"+ tweapon->name() +"忽然被"+myname+"引得攻向了自己！\n"NOR;
	COMBAT_D->do_attack(target,target, target->query_temp("weapon"),TYPE_REGULAR,msg);

	msg = HIY"$N掌风未动，便有一股剑刃披风之声朝$n迎面袭来，顿时寒光满空！\n"NOR;
	COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);

	msg = HIR"剑风呼啸而过，"+myname+"掌影又现，［剑中掌］如风劈至！\n"NOR;
	COMBAT_D->do_attack(target,target, target->query_temp("weapon"),TYPE_REGULAR,msg);
       target->add_temp("apply/iron-cloth", 100);

	me->add("force",-50);
	me->start_busy(3);
	return 1;
}
