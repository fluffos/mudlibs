// 故弄玄虚

#include <ansi.h>

inherit F_CLEAN_UP;

int exert(object me, object target, int amount) {
  object *ob;
  int i, skill, damage;

  if (!me->is_fighting())
    return notify_fail("「故弄玄虚」只能在战斗中使用。\n");

  if (me->query("class") != "kongtong")
    return notify_fail("你背叛师门，已经无法使用该特殊技能了。\n");

  if ((int)me->query("force") < 150)
    return notify_fail("你的内力不够。\n");

  skill = me->query_skill("force");

  me->add("force", -150);
  me->start_busy(2);
  message_vision(
    HIR "$N突然高声叫到：“三位师父来得正好，快助徒儿一臂之力！”声音远远传了出去！\n" NOR, me);
  say(HIC "“七灵剑”金振夫冷笑道：“谁在与我崆峒派为难？”声音从不远处传来......\n" NOR, me);
  say(HIC "“七绝剑”金振宇冷笑道：“哼！有人活得不耐烦了？”声音从不远处传来......\n" NOR, me);
  say(HIC "“七修剑”金振南冷笑道：“徒儿不必担心，为师来了！”声音从不远处传来......\n" NOR, me);

  ob = all_inventory(environment(me));
  for (i = 0; i < sizeof(ob); i++) {
    if (!living(ob[i]) || ob[i] == me) continue;
    if (skill / 2 + random(skill / 2) < (int)ob[i]->query("cps") * 3) continue;

    damage = skill - ((int)ob[i]->query("max_force") / 10);
    if (damage > 0) {
      tell_object(ob[i], "你听到崆峒三剑的威名，吓得心惊胆战，萌生了退意。\n");
      ob[i]->set("env/wimpy", 90);
      if ((int)ob[i]->query("force") < skill * 2)
        ob[i]->set("env/wimpy", 100);
    }

    if (userp(ob[i])) ob[i]->fight_ob(me);
    else if (!ob[i]->is_killing(me)) ob[i]->kill_ob(me);
  }

  return 1;
}
