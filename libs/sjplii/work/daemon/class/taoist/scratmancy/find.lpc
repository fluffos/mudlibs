//跟踪符
#include <ansi.h>

inherit SSERVER;

int scribe(object me,object ob)
{
	object seal;

	if( (int)me->query("mana") < 100)
		return notify_fail("你的法力不足。\n");
	if( (int)me->query("sen") < 100)
		return notify_fail("你的精神无法集中。\n");
	if ((string)me->query("class") != "taoist")
	return notify_fail("你不是茅山道士，不会用这个法术！\n");
        if((int)me->query_skill("scratching") < 30 )
                return notify_fail("你的符之术不够高！\n");
        if( ob->name() != "桃符纸" )
                return notify_fail("跟踪符要画在桃符纸上！\n");
	message_vision("$N咬破手指，伸手在桃符纸上画了几下。\n", me);
	ob->set_amount((int)ob->query_amount() - 1);
	me->save();
	seteuid(getuid());
	seal=new(__DIR__"obj/find_seal");
	seal->move(me);
	seal->invocation(me);
	me->add("mana", -50);
	me->receive_damage("gin", 50);
	me->receive_damage("sen", 50);
	me->start_busy(2);
	return 1;
}
	
