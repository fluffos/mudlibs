// netherbolt.c

#include <ansi.h>

inherit SSERVER;

int cast(object me, object target) {
  string msg, rst;
  int damage, ap, dp;
  int extradam;

  if (!target) target = offensive_target(me);

  if ((int)me->query_skill("spells") < 30)
    return notify_fail("你的法术不够高！\n");

  if (!target
    || !target->is_character()
    || target->is_corpse()
    || target == me)
    return notify_fail("你要对谁施展这个法术？\n");

  if ((int)me->query("mana") < 25)
    return notify_fail("你的法力不够！\n");

  if ((int)me->query("sen") < 10)
    return notify_fail("你的精神没有办法有效集中！\n");

  //        if( !me->is_fighting() )
  //        return notify_fail("你只能在战斗中作法！\n");

  me->add("mana", -25);
  me->receive_damage("sen", 10);

  if (random(me->query("max_mana")) < 30) {
    write("你失败了！\n");
    return 1;
  }
  me->set_temp("at_damage_type", "gin");

  msg = HIC "$N口中喃喃地念著咒文，左手一挥，手中聚起一团青光射向$n！\n\n" NOR;

  rst = HIR "结果「嗤」地一声，青光从$p身上透体而过，拖出一条长长的血箭直射到\n"
    "两三丈外的地下！\n" NOR;

  COMBAT_D->magic_attack(me, target, me->query_temp("weapon"), msg, rst, "spells");

  return 1;
}
