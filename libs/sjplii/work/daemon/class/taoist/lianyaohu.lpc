#include <ansi.h>
inherit ITEM;

void create()
{
	set_name("炼妖壶", ({ "lianyao hu", "lianyao", "hu" }) );
	set_weight(300);
	set("unit", "个");
	set("long",
		"这是一个神奇的炼妖壶。你可以收妖(shouyao)、炼妖(lianyao)
放妖(fangyao)。只有会念无量咒(nian zhou)的人才能控制它。\n");
	set("no_get", 1);
	set("no_drop", 1);
}

void init()
{
	add_action("do_shouyao", "shouyao");
	add_action("do_lianyao", "lianyao");
	add_action("do_fangyao", "fangyao");
	add_action("do_nian", "nian");
}

int do_nian(string arg)
{
	object me,hu;
	me = this_player();
	if( !arg )
		return notify_fail("你想念什么？\n");
	if( arg!="zhou" )
		return notify_fail("你想念什么？\n");
	if( present("lianyao hu", me) )
		return notify_fail("你已经携带了炼妖壶。\n");
	if((int)me->query("gin") < 90 )
		return notify_fail("你的精神没有办法有效集中！\n");
	if((int)me->query("sen") < 90 )
		return notify_fail("你的精神没有办法有效集中！\n");
	if ( me->query("class") != "taoist" )
	return notify_fail("你不是道士，无法念［无量咒］。\n");
	if ((int)me->query_skill("liandanshu",1) < 30 )
	return notify_fail("你不会念［无量咒］。\n");
	seteuid(getuid());
	message_vision(CYN"$N喃喃念起了［无量咒］，只见炼妖壶缓缓升起，忽然一化为二，其中一个飞入了$N的怀中！\n"NOR,me);
	hu = new("/daemon/class/taoist/lianyaohu");
	hu->move(me);
	me->receive_damage("gin", 50);
	me->receive_damage("sen", 50);
	return 1;
}

int do_shouyao(string arg)
{
	object me,target;
	string gname;
	int number, glvl, mtroops;
	me = this_player();
	if( !arg )
		return notify_fail("你想对谁用炼妖壶？\n");
	target = present(arg, environment(me));
	if( !target )
		return notify_fail("这里没有这个生物。\n");
      if (environment(me)->query("no_fight"))
		return notify_fail("这里无法使用炼妖壶！\n");
	if( environment(me)->query("no_magic") )
		return notify_fail("这里无法使用炼妖壶！\n");
	if( !present("lianyao hu", me) )
		return notify_fail("你没有携带炼妖壶。\n");
	if( present("lianyao hu", environment(me)))
		return notify_fail("请勿在这里使用炼妖壶。\n");

	if( !target->is_character() || target->is_corpse() )
		return notify_fail("炼妖壶没有起作用。\n");
//	if(!(string)target->query("mguard") && (object)target->query_temp("pending/fight")!=me ) 
//		return notify_fail("炼妖壶被打了开来，但是什么也没有发生。\n");
	if(!(string)target->query("mguard")) 
		return notify_fail("炼妖壶被打了开来，但是什么也没有发生。\n");
	if(!me->is_fighting(target)) 
		return notify_fail("炼妖壶被打了开来，但是什么也没有发生。\n");

	if((int)me->query("gin") < 50 )
		return notify_fail("你的精神没有办法有效集中！\n");
	if((int)me->query("sen") < 50 )
		return notify_fail("你的精神没有办法有效集中！\n");
	seteuid(getuid());
	mtroops = me->query_troops();
	if( sizeof(mtroops) >= 30)
		return notify_fail("你的炼妖壶已经满了，无法再收妖。\n");
	if( target->query("lianyao_owner")== me->query("id") )  number=1;
	else number=target->query("kee");
	if( number < target->query("max_kee")/2 ){
	message_vision(HIY"\n$N举起了炼妖壶，只见一道耀眼的光芒罩住了$n！\n"NOR,me,target);
	message_vision(HIY"$n被吸了起来，那光芒逐渐收拢，立刻将$n收入了炼妖壶中！\n"NOR,me,target);
	gname = target->query("mguard");
	glvl = target->query("mguard_level");
	if( !me->query_troop(gname) )
	me->set_troop(gname,glvl);
	me->receive_damage("gin", 30);
	me->receive_damage("sen", 30);
	destruct(target);
	me->add("potential", random(1));
	me->add("combat_exp", random(2));
	me->start_busy(2);
	return 1;
	}
	else
		return notify_fail(YEL"\n炼妖壶被打了开来，但是没有发生效用。\n"NOR);
	return 1;
}

int do_lianyao(string arg)
{
	object me,obj;
	int newrank,lvl;
	me = this_player();
	obj = this_object();
	if( !arg )
		return notify_fail("你想炼什么？\n");
	if( !present("lianyao hu", me) )
		return notify_fail("你没有携带炼妖壶。\n");
	if( present("lianyao hu", environment(me)))
		return notify_fail("请勿在这里使用炼妖壶。\n");
	if( !(int)me->query_troop(arg,1) )
		return notify_fail("你没有这个生物。\n");
	if((int)me->query("gin") < 50 )
		return notify_fail("你的精神没有办法有效集中！\n");
	if((int)me->query("sen") < 50 )
		return notify_fail("你的精神没有办法有效集中！\n");
	seteuid(getuid());
	if( !obj->query("lianyao/one") )
	{
		obj->set("lianyao/one",arg);
		obj->set("lianyao/rank1",TROOP_D(arg)->effective_level() );
		me->delete_troop(arg);
		return notify_fail("请再放一物体入炼妖壶。\n");
	}
	if( !obj->query("lianyao/two") )
	{
		obj->set("lianyao/two",arg);
		obj->set("lianyao/rank2",TROOP_D(arg)->effective_level() );
		me->delete_troop(arg);
	}
	newrank =( (int)me->query_skill("liandanshu",1)/5+obj->query("lianyao/rank1")+obj->query("lianyao/rank2") )/3;
	if( newrank < 1 )  newrank=0;
	if( newrank > 51 )  newrank=random(29)+30;
	lvl = TROOP_D("mguard"+(string)newrank)->effective_level();
	message_vision(HIY"$N喃喃念动咒语，只见炼妖壶缓缓升起，壶中发出五彩光芒！\n"NOR,me);
	message_vision(HIR"五彩光芒不断变幻，耀眼欲花！\n"NOR,me);
	message_vision(HIC"光芒渐渐融合成一道青烟，从炼妖壶中缓缓喷出。。。\n"NOR,me);
	message_vision(HIG"青烟越聚越浓，不久化做了［"+ to_chinese("mguard"+(string)newrank) +"］。\n"NOR,me);
	me->set_troop("mguard"+(string)newrank, lvl);
	obj->delete("lianyao/one");
	obj->delete("lianyao/two");
	me->receive_damage("gin", 30);
	me->receive_damage("sen", 30);
	if( (me->query_skill("taoism",1) > 50) && (me->query_skill("taoism",1) < 100 ) )
	me->improve_skill("taoism", random((int)me->query("int")) + 30);
	me->start_busy(3);
	return 1;
}

int do_fangyao(string arg)
{
	string mfile;
	int mpower, mkee, mexp, mskill;
	int i;
	object *enemy;
	object me,mguard;
	me = this_player();
	if( !arg )
		return notify_fail("你想放什么生物出来？\n");
	if( present("lianyao hu", environment(me)))
		return notify_fail("请勿在这里使用炼妖壶。\n");
      if ( !me->query_troop(arg,1) )
	return notify_fail("你没有携带这个生物。\n");

      if ( present("taoist guard", environment(me)) )
		return notify_fail(YEL"炼妖壶被打了开来，但是什么也没有发生。\n"NOR);

	seteuid(getuid());

	if( random((int)me->query("combat_exp")) < 1000000 && random(9)>6 )
	{
	if( me->query_troop("mguard60",1) )
		{
		mfile = to_chinese("mguard60");
		me->delete_troop("mguard60");
		}
	if( me->query_troop("mguard61",1) )
		{
		mfile = to_chinese("mguard61");
		me->delete_troop("mguard61");
		}
	if( me->query_troop("mguard62",1) )
		{
		mfile = to_chinese("mguard62");
		me->delete_troop("mguard62");
		}
	if( me->query_troop("mguard63",1) )
		{
		mfile = to_chinese("mguard63");
		me->delete_troop("mguard63");
		}
	if( me->query_troop("mguard64",1) )
		{
		mfile = to_chinese("mguard64");
		me->delete_troop("mguard64");
		}
	if( mfile )
	{
	message_vision(HIC"\n$N的炼妖壶中突然一阵晃动，似乎听见"+mfile+"的声音冷哼了一声。\n"NOR,me);
	message_vision(HIC"\n$N的法力无法控制炼妖壶了，只见壶中喷出一股浓浓的烟雾，\n"NOR,me);
	message_vision(HIC"\n那烟雾竟将$N托了起来，越升越高，渐渐消失在空中。。。\n\n"NOR,me);
	mfile = "/u/maoshan/sky/yun.lpc";
	me->move(mfile);
	return 1;
	}
	else
	message_vision(HIC"\n$N的法力无法控制炼妖壶了，只见壶中喷出一股浓浓的烟雾。\n"NOR,me);
	message_vision(HIC"\n那烟雾化做"+to_chinese(arg)+"渐渐飘远了。。。\n"NOR,me);
	if( me->query_troop(arg,1) )
	me->delete_troop(arg);
	return 1;
	}

	mfile = TROOP_D(arg)->maoshan_troop_file();
	mguard = new(mfile);
	mpower = TROOP_D(arg)->effective_level()*10;
	mkee = TROOP_D(arg)->effective_level()*300;
	mexp = TROOP_D(arg)->effective_level()*20000;
	mskill = TROOP_D(arg)->effective_level()*6;
	mguard->set("magic_power", mpower);
	mguard->set("max_kee", mkee);
	mguard->set("max_sen", mkee);
	mguard->set("max_gin", mkee);
	mguard->set("eff_kee", mkee);
	mguard->set("eff_sen", mkee);
	mguard->set("eff_gin", mkee);
	mguard->set("kee", mkee);
	mguard->set("sen", mkee);
	mguard->set("gin", mkee);
	mguard->set("max_mana", me->query_troop(arg)*100);
	mguard->set("mana", me->query_troop(arg)*100);
	mguard->set("combat_exp", mexp);
	mguard->set("player_guard", me->query("id"));
	mguard->set_skill("unarmed", mskill);
	mguard->set_skill("dodge", mskill);
	mguard->set_skill("parry", mskill);
	mguard->set_skill("qingfeng-steps", mskill);
//	mguard->map_skill("dodge", "qingfeng-steps");
	mguard->set_skill("move", 500);
	mguard->set_temp("apply/armor", 50+mskill/2);
	message_vision(HIC"\n$N喃喃念动咒语，炼妖壶中喷出一股浓浓的烟雾。\n"NOR,me,mguard);
	message_vision(HIC"烟雾渐渐聚拢，［$n］的形状立刻显现了出来！\n"NOR,me,mguard);
	mguard->move(environment(me));
	mguard->set_leader(me);
	mguard->set("lianyao_owner",me->query("id"));
	if( me->is_fighting() )
	{
	enemy = me->query_enemy();
	i = sizeof(enemy);
	while(i--) {
		if( enemy[i] && living(enemy[i]) ) {
			enemy[i]->kill_ob(mguard);
			mguard->kill_ob(enemy[i]);
			}
		}
	}
	if( me->query("kill_player_record") >= 300 )
	{
		write("你忽然感到身体一阵抽蓄，你无法再控制心魔了！\n");
		message_vision(HIR"\n$n突然发出刺耳的怪叫，转身朝$N扑了过来！\n\n"NOR,me,mguard);
		mguard->kill_ob(me);
	}
	if( me->query_troop(arg,1) )
		me->delete_troop(arg);
	me->start_busy(1);
	return 1;
}

