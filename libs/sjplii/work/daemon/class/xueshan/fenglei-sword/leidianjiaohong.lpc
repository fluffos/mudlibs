//雷电交轰
#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target)
{
	string msg;
	int extra;
	object weapon;
	extra = me->query_skill("fenglei-sword",1);
	if ( extra <= 120) return notify_fail("你的风雷三剑还不够纯熟！\n");
        if((int)me->query_skill("liuhe-force") < 30 )
                return notify_fail("你的六合真气不够高！\n");
	if( !target ) target = offensive_target(me);
	if( !target
	||	!target->is_character()
	||	!me->is_fighting(target) )
		return notify_fail("［风雷三剑］只能对战斗中的对手使用。\n");
	weapon = me->query_temp("weapon");
	msg = HIY  "$N使出风雷三剑的绝招［雷电交轰］，一招连环三剑，手中的"+ weapon->name()+  "闪电般向$n攻出第一剑[春雷震怒]！" NOR;
	if((target->query_skill_mapped("sword") == "mystsword")&&
	((int)target->query_skill("mystsword",1) > (int)me->query_skill("fenglei-sword")))
	{
	message_vision(msg,me,target);
	message_vision(CYN"\n但是$n奇招迭出，将$N的攻势全部化解了！\n" NOR, me,target);
	return 1;
	}
	me->add_temp("apply/attack",extra/10);
	me->add_temp("apply/damage",extra/5);
	COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
        msg = HIY  "第二剑[雷霆万钧]！" NOR;
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
        msg = HIY  "第三剑[大地沉眠]！" NOR;
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);

	if(target->query_skill("iron-cloth",1)&&target->query_skill("iron-cloth") < random(me->query_skill("sword")*2) )
	{
	message_vision(HIR"\n结果$N强大的内劲催破了$n的真元！\n" NOR, me,target);
	target->receive_wound("kee", (int)me->query_skill("fenglei-sword",1)*3);
	COMBAT_D->report_status(target,1);
	}

        me->add_temp("apply/attack",-extra/10);
        me->add_temp("apply/damage",-extra/5);
	me->start_busy(3);
	return 1;
}
