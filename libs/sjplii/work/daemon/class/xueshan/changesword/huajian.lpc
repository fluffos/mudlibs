//分光幻剑
#include <ansi.h>
#include <combat.h>
inherit SSERVER;
void surekill(object me, object target);
int perform(object me, object target) {
  string msg;
  int extra, i, lmt;
  object weapon;
  extra = me->query_skill("changesword", 1);
  if (extra <= 100) return notify_fail("你的身外化身剑外化剑还不够纯熟！\n");
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("［分光幻剑］只能对战斗中的对手使用。\n");
  weapon = me->query_temp("weapon");
  if (!objectp(weapon) || weapon->query("skill_type") != "sword")
    return notify_fail("你必须使用剑才能充分发挥威力！\n");
  msg = HIY "$N反臂一振，手中的" + weapon->name() + "突然化出无数道刺目的剑光飞向半空！" NOR;
  message_vision(msg, me, target);
  if (target->query_skill(
    "iron-cloth",
    1
  ) && target->query_skill("iron-cloth", 1) < random(me->query_skill("changesword", 1) * 2)) {
    message_vision(HIR "\n结果$N强大的剑气摧破了$n的真元！\n" NOR, me, target);
    target->receive_wound("kee", (int)me->query_skill("changesword", 1) * 3);
    COMBAT_D->report_status(target, 1);
    if (weapon->unequip()) weapon->move(environment(me));
    me->start_busy(2);
    return 1;
  }
  me->add_temp("apply/attack", extra / 9);
  me->add_temp("apply/damage", extra / 9);
  lmt = random(6) + 3;
  for (i = 1; i <= lmt; i++) {
    msg = HIR "第" + chinese_number(i) + "道剑光飞舞，划了条弧线凌空下击！" NOR;
    //	message_vision(msg,me,target);
    COMBAT_D->do_attack(me, target, me->query_temp("weapon"), TYPE_REGULAR, msg);
  }
  me->add_temp("apply/attack", -extra / 9);
  me->add_temp("apply/damage", -extra / 9);
  if (weapon->unequip()) weapon->move(environment(me));
  me->start_busy(4);
  return 1;
}
