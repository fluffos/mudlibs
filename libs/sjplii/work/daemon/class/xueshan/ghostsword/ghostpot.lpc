//拘魂摄魄
#include <ansi.h>
inherit SSERVER;
//inherit F_CLEAN_UP;
int perform(object me, string arg)
{
	object corp,soldier;
	object *t;
	int ghostsword,ghostflag, exp, MAX_GUARD;
	if(!corp = present("corpse",environment(me)))
		return notify_fail("你的周围没有鬼气！\n");
	if((int)me->query("sen")< 100)
	return notify_fail("你的神太差了！\n");
	ghostsword = (int)me->query_skill("ghostsword");
	ghostflag = (int)me->query_skill("ghostflag");
	exp = (int)me->query("combat_exp");
	if(ghostsword < 10 || ghostflag < 10)
	return notify_fail("你的招魂剑术和地煞旗诀太差了，没有办法拘魂！\n");	

	if(pointerp(t=me->query_team()))
                return notify_fail("你只能驱动一具鬼魂！\n");

	MAX_GUARD = ghostsword * ghostflag / 10000 + 1;
	seteuid(getuid());
	me->receive_damage("sen",100);
	soldier= new("/u/baiwt/xueshan/xsnpc/ghostman");
	soldier->move(environment(me));
        soldier->invocation(me, (ghostflag+ghostsword));
        soldier->set("possessed", me);
	soldier->set_leader(me);
        me->add_temp("max_guard",1);
	soldier->be_ghost(1);
	message_vision(HIG "\n$N双手向上一挥，一阵浓雾从地下卷出．．．\n" NOR, me);	
	message_vision(HIG "\n浓雾似乎在$N身边渐渐地浓缩成一个黑影．．．\n" NOR, me);
	return 1;
}

