//斗转星移
#include <ansi.h>

inherit SSERVER;

int perform(object me, object target) {
  string msg;
  int potpower;
  if ((int)me->query_skill("qidaoxinfa", 1) < 10)
    return notify_fail("你的棋道心法不够高！\n");
  if ((int)me->query_skill("fantianqi") < 30)
    return notify_fail("你的翻天三十六路棋不够高！\n");
  if ((int)me->query("force") <= 100)
    return notify_fail("你的内力不够！\n");

  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || !me->is_fighting(target)) {
    if ((int)me->query("sen") <= 100)
      return notify_fail("你的神不够！\n");
    if ((int)me->query("gin") <= 100)
      return notify_fail("你的精不够！\n");

    message_vision(HIW "\n$N静静地坐了下来，聚精会神地施展起「斗转星移」来。\n" NOR, me);
    me->set("combat_exp", (int)me->query("combat_exp") - (random(200) + 100));
    me->set("potential", (int)me->query("potential") + random(10));
    message_vision("\n$N呼出一口长气，觉得精神疲倦，看来需要好好休息了。\n\n" NOR, me);
    me->add("sen", -100);
    me->add("gin", -100);
    return 1;
  }

  else {
    potpower = me->query("potential") - me->query("learned_points");
    if (potpower < (int)me->query_skill("qidaoxinfa", 1))
      return notify_fail("你的潜能不够！\n");
    if (potpower <= 100)
      return notify_fail("你的潜能不够！\n");

    msg = HIC "$N身形一转，挥手发出「斗转星移」，";
    if ((int)me->query("combat_exp") > (int)target->query("combat_exp") / 10) {
      msg += "结果$p被$P打了个措手不及。\n\n$p只觉得眼前星云密布，也不知从哪里袭来！\n" NOR;
      //		target->receive_damage("kee",potpower/10);
      target->receive_wound("kee", potpower / 10);
      COMBAT_D->report_status(target, 1);
    } else {
      msg += "可是$p还是躲过了$P的奇妙一击！！\n" NOR;
    }
    message_vision(msg, me, target);
    me->set("potential", (int)me->query("potential") - potpower / 2);
    me->add("force", -80);
    me->start_busy(1);
    return 1;
  }
}
