//雪地飘风
#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target)
{
	string msg;
	int extra;
	extra = me->query_skill("fengxue-steps",1);
	if ( extra <= 100) return notify_fail("你的［风灵雪舞身法］还不够纯熟！\n");
        if((int)me->query_skill("xuanyinforce") < 30 )
                return notify_fail("你的大五行玄阴气功不够高！\n");

	if( !target ) target = offensive_target(me);
	if( !target
	||	!target->is_character()
	||	!me->is_fighting(target) )
		return notify_fail("［雪地飘风］只能对战斗中的对手使用。\n");
	if(target->is_busy())
		return notify_fail(target->name()+"已经手忙脚乱了！\n");
	message_vision("$N脚踩连环，如风卷霜雪，环绕着$n转个不停！\n",me,target);

	if((int)target->query_skill("qingfeng-steps") > (int)me->query_skill("fengxue-steps"))
	{
	message_vision(CYN"\n但是$n身法轻盈，从$N的攻势圈中绕了出来！\n" NOR, me,target);
	return 1;
	}
	if((int)target->query_skill("shenkong-xing") > (int)me->query_skill("fengxue-steps"))
	{
	message_vision(CYN"\n但是$n身法轻盈，从$N的攻势圈中绕了出来！\n" NOR, me,target);
	return 1;
	}
	if((int)target->query_skill("bagua-steps") > (int)me->query_skill("fengxue-steps"))
	{
	message_vision(CYN"\n但是$n身法轻盈，从$N的攻势圈中绕了出来！\n" NOR, me,target);
	return 1;
	}
	if((int)target->query_skill("tianluo-steps") > (int)me->query_skill("fengxue-steps"))
	{
	message_vision(CYN"\n但是$n身法轻盈，从$N的攻势圈中绕了出来！\n" NOR, me,target);
	return 1;
	}
	if((int)target->query_skill("piaoxiang-steps") > (int)me->query_skill("fengxue-steps"))
	{
	message_vision(CYN"\n但是$n身法轻盈，从$N的攻势圈中绕了出来！\n" NOR, me,target);
	return 1;
	}

	if(random((int)target->query("combat_exp")/2) < (int)me->query("combat_exp"))
	{
	message_vision("结果$N被扰得眼花潦乱，接应不暇！\n",target);
	target->start_busy(5);
	}
	else{
	message_vision("结果$N自己转了个头晕眼花！\n",me);
	me->start_busy(2);
	}
	return 1;
}
