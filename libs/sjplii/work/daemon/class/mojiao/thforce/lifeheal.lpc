// lifeheal.c
#include <ansi.h>
inherit F_CLEAN_UP;
int exert(object me, object target, int amount)
{
	if( !target )
		return notify_fail("你要用真气为谁疗伤？\n");

	if( me->is_fighting() || target->is_fighting())
		return notify_fail("战斗中无法运功疗伤！\n");

	if( (int)me->query("force") - (int)me->query("max_force") < 50 )
		return notify_fail("你的真气不够。\n");

	message_vision(
		HIY "$N"+HIY"坐了下来运起天和内气，将手掌贴在$n"+HIY"背心，缓缓地将真气输入$n"+HIY"体内....\n\n"
		"过了不久，$N"+HIY"额头上冒出豆大的汗珠，$n"+HIY"吐出一口瘀血，脸色看起来红润多了。\n" NOR,
		me, target );
	target->receive_curing("kee", 10 + (int)me->query_skill("force")/2 );
	target->receive_curing("gin", 10 + (int)me->query_skill("force")/2 );
	target->receive_curing("sen", 10 + (int)me->query_skill("force")/2 );
	me->add("force", -50);
	me->set("force_factor", 0);
	return 1;
}
