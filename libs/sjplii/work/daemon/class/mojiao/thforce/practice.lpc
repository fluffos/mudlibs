//written by john darks
#include <ansi.h>
inherit F_CLEAN_UP;
int exert(object me, object target)
{
	int s,gin,kee,sen;
	int skill,skill_basic,amount;
	mapping learned,skills;
	skill = me->query_skill("thforce",1);
	skill_basic = me->query_skill("force",1);
	learned = me->query_learned();
	skills = me->query_skills();
	if (!target)	target=me;
	if (target!=me)
		return notify_fail("你只能炼自己的天和内气！！\n");
	if( me->is_fighting())
		return notify_fail("战斗中无法运功炼气！\n");
        s =(int)(me->query_skill("betting",1) + me->query_skill("perception",1)) *3 /5;
        if ( s < 30 )	return notify_fail("你的赌术不够，不能炼天和内气。\n");
        gin = (int)me->query("gin");
        kee = (int)me->query("kee");
        sen = (int)me->query("sen");
	if( gin < 40 || kee < 40 || sen < 40  )
		return notify_fail("你的精气神不够练内功，还是先休息休息吧。\n");
	if( (gin < kee *4/5) || (kee < sen *4/5) || (sen < gin *4/5) )
		return notify_fail("炼天和内气要求精气神三者合一。\n");
	write ("你坐下来默用内功，提炼天和内气。\n");
	amount = skill + skill_basic/5 + s - 100;
	if( amount < 1) amount = 1;
	if((skill/10)*(skill/5)*skill>(int)me->query("combat_exp")) 
		return notify_fail("也许是因为缺乏经验，你对天和内气总是无法领会。\n");
	me->receive_damage("kee", random((int)skill/10)+30);
	me->receive_damage("gin", random((int)skill/10)+30);
	me->receive_damage("sen", random((int)skill/10)+30);               
	if (skill>200) me->improve_skill("thforce", amount);
	else  {
		me->improve_skill("thforce", amount, 1);
		if(learned["thforce"] > (skills["thforce"] + 1) * (skills["thforce"] + 1))
			return notify_fail(HIM"也许是因为缺少师傅指点，你对天和内气总是无法领会。\n"NOR);
	}
	write( "你感觉你的天和内气进步了！\n" );
	me->set("force_factor", 0);
	me->start_busy(1);
	return 1;
}
