//yishan.c written by john darks
#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target)
{
	string msg;
	int extra,lvl1,lvl2;
	object weapon;
	if(me->is_busy())
		return notify_fail("你现在没空！！\n");
	if( !target ) target = offensive_target(me);
	if( !target
	||	!target->is_character()
	||	!me->is_fighting(target) )
		return notify_fail("［一刀闪］只能对战斗中的对手使用。\n");
	weapon = me->query_temp("weapon");
	extra = me->query_skill("blade",1);
	if (extra < 200 ) return notify_fail("你的基本刀法还不够熟练！\n");
	extra = me->query_skill("xiuluo-blade",1) ;
	if (extra < 75 ) return notify_fail("你的［修罗刀法］还不够熟练！\n");
	if (me->query("force")<1000) return notify_fail("你内力不足，无法发出[一刀闪]！\n");
	lvl1 = me->query_skill("literate");
	lvl2 = target->query_skill("literate");
	me->add_temp("apply/attack", extra);	
	me->add_temp("apply/damage", extra);
	msg = HIW"\n$N"+HIW"刀势突变，使出了绝技［一刀闪］，一招四式向$n"+HIW"攻出！\n" NOR;
	message_vision(msg,me,target);

	if((target->query_skill_mapped("sword") == "dg9-sword")&&
	((int)target->query_skill("dg9-sword") > (int)me->query_skill("xiuluo-blade")))
	{
	message_vision(CYN"\n但是$n剑法一展，$N的攻势莫名其妙地扑了个空！\n" NOR, me,target);
	me->start_busy(2);
	return 1;
	}
	if((target->query_skill_mapped("sword") == "wudi_sword")&&
	((int)target->query_skill("wudi_sword") > (int)me->query_skill("xiuluo-blade")))
	{
	message_vision(CYN"\n但是$n剑法一展，$N的攻势莫名其妙地扑了个空！\n" NOR, me,target);
	me->start_busy(2);
	return 1;
	}
	if((target->query_skill_mapped("dodge") == "piaoxiang-steps")&&
	((int)target->query_skill("piaoxiang-steps") > (int)me->query_skill("xiuluo-blade")))
	{
	message_vision(CYN"\n但是$n身法一变，$N的攻势莫名其妙地扑了个空！\n" NOR, me,target);
	me->start_busy(2);
	return 1;
	}

	//第一刀
	msg = "$N手中的$w迎风一晃，刀锋带出裂锦般的声音，万马奔腾般地砍向$n的$l";
	if (random(lvl1+lvl2)<lvl1/2){
		target->receive_damage("sen",(int) me->query("force_factor")/2,me);
		message_vision(HIG "刀锋发出的尖啸声扰得$N"+HIG"心神不宁。。\n" NOR,target);	}
	COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
	//第二刀
	msg = "$N手中的$w迎风狂舞，象暴风中的滚沙，裹向$n的$l";
	if (random(lvl1+lvl2)<lvl1/2){
		target->receive_damage("sen",(int) me->query("force_factor")/2,me);
		message_vision(HIG "刀锋发出的尖啸声扰得$N"+HIG"心神不宁。。\n" NOR,target);	}
	COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
	//第三刀
	msg = "$N晃动手中的$w，刀光忽隐忽现，象秋风中的落叶，一刀连一刀地散向$n的$l";
	if (random(lvl1+lvl2)<lvl1/2){
		target->receive_damage("sen",(int) me->query("force_factor")/2,me);
		message_vision(HIG "刀锋发出的尖啸声扰得$N"+HIG"心神不宁。。\n" NOR,target);	}
	COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
	//第四刀
	msg = "$N聚起全身的功力，手中的$w象刺骨寒风般割向$n";
	if (random(lvl1+lvl2)<lvl1/2){
		target->receive_damage("sen",(int) me->query("force_factor")/2,me);
		message_vision(HIG "刀锋发出的尖啸声扰得$N"+HIG"心神不宁。。\n" NOR,target);	}
	COMBAT_D->do_attack(me,target, me->query_temp("weapon"),TYPE_REGULAR,msg);
	me->add_temp("apply/attack", -extra);
	me->add_temp("apply/damage", -extra);
	msg = HIW"\n$N"+HIW"刀势突顿，刀锋仍颤动不已，呼啸声却渐渐小了，$n"+HIW"一怔之间，$N"+HIW"忽将"+weapon->name()+HIW"向空中一抛！\n\n" NOR;
	message_vision(msg,me,target);
	target->start_busy(1);
	me->set("force",0);
	me->set("force_factor",0);
	me->start_busy(5);
	call_out("kongzhan",2,me,target,weapon);
	return 1;
}

void kongzhan(object me,object target,object weapon)
{
	
	int damage,wound;
	string msg;
	if(!target || (environment(target) != environment(me)) || !me->is_fighting(target)){
        	msg = HIY"$N"+HIY"身在空中，一手握着"+weapon->name()+HIY"，缓缓落下，嘴角犹带着一丝嘲笑！！\n" NOR;
		message_vision(msg,me);
	        return ;
	}else{
		msg = HIY"\n$n"+HIY"再看时，$N"+HIY"已在空中，刀光一闪，$N"+HIY"双手握住"+weapon->name()+HIY"夹刀气当头劈下！！\n" NOR;
		msg+= HIR"一股刀气匹练般斩下！！$n"+HIR"一时间只觉刀光耀目，不及回避！！\n" NOR;
		message_vision(msg,me,target);
		damage =(int)(target->query("eff_kee")/2);
		wound = (int)(target->query("max_sen")/5);
        	target->receive_damage("kee", damage,me);
        	target->receive_wound("kee", damage/4,me);
        	target->receive_damage("sen", wound,me);
        	target->receive_wound("sen", wound/2,me);
        	if (!me->is_ghost())
        		me->receive_wound("kee",me->query("eff_kee")/3);
        	if( damage < 10 ) msg= "结果只是轻轻地划破$n的皮肉。\n";
        	else if( damage < 20 ) msg= "结果在$n的肩膀上划出一道细长的血痕。\n";
        	else if( damage < 40 ) msg= "结果「嗤」地一声划出一道伤口！\n";
        	else if( damage < 80 ) msg= "结果「嗤」地一声划出一道血淋淋的伤口！\n";
        	else if( damage < 160 ) msg= "结果「嗤」地一声划出一道又长又深的伤口，溅得$N满脸鲜血！\n";
        	else msg= "结果只听见$n一声惨嚎，"+weapon->name()+"已在$n当胸划出一道深及见骨的可怕伤口！！\n";
        	message_vision(msg, me, target);
        	COMBAT_D->report_status(target);
        	write(HIR"\n你被刀气反震，受伤不轻！！\n"NOR);
       		message("vision",HIR+me->name()+HIR"脸上泛起一股红潮，似乎受伤不轻！！\n"NOR,environment(me),me);
        	return ;
	}
}
	
	
