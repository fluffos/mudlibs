//移花接木
#include <ansi.h>
inherit SSERVER;
int exert(object me, object target)
{
        object leaf, flower;
        if((int)me->query_skill("senluo-force", 1) < 30 )
                return notify_fail("你的森罗万象变不够高，不能有效施展移花接木！\n");
        if (present("grove branch", environment(me)) 
		&& present("flower petal", environment(me)))
        	return notify_fail("你已经身处花树大阵之中。\n");
        if( (int)me->query("force") < 50 )
                return notify_fail("你的内力不够。\n");
	leaf = new("/daemon/class/mojiao/branch.lpc");
	flower = new("/daemon/class/mojiao/flower.lpc");
        message_vision(HIG "$N双手一挥，身边陡然起了一阵旋风，劲风到处只见花瓣飘零，落叶缤纷！\n
好一座花树大阵！\n\n" NOR, me, target);
        leaf->move(environment(me));
        flower->move(environment(me));
        leaf->move(environment(me));
        flower->move(environment(me));
        if (userp(me))	me->add("force", -50);
        return 1;
}
