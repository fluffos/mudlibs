// jieti.c 天魔解体大法。
#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int exert(object me, object target)
{
        string msg;
        int success, ap, dp;
        if( environment(me)->query("no_fight") )
                return notify_fail("这里禁止战斗。\n");
        if( (string)me->query("class") != "mojiao" )
                return notify_fail("只有邪魔弟子才能施展天魔解体大法。\n");
        if( !target ) target = offensive_target(me);
        if( !target
        || !target->is_character()
        || target->is_corpse()
        || target==me)
                return notify_fail("你要对谁施展天魔解体大法？\n");

        if((int)me->query_skill("senluo-force", 1) < 200 )
                return notify_fail("你的森罗万象变不够高，不能有效施展天魔解体大法！\n");

        if((int)me->query("force") < 1000 || (int)me->query("max_force") < 500 )
                return notify_fail("你的内力不够，不能有效施展天魔解体大法！\n");
        if((int)me->query("sen") < (int)me->query("max_sen"))
                return notify_fail("你无法集中精力施展天魔解体大法！\n");
        if( random(me->query("max_force")) < 50 ) {
                write("你失败了！\n");
                return 1;
        }
        msg = HIR"$N气沉丹田，将所有功力凝聚于胸，仰天发出一声悲嘶！\n\n忽然间$N将自己舌头狠命一咬，一道血雾向$n喷了过去！\n" NOR;
        success = 1;
        ap = me->query_skill("force");
	ap = ( ap * ap /100 * ap/40 ) * (int)me->query("sen") ;
	dp = target->query("combat_exp");
        if( random(ap + dp) < dp ) success = 0;
        if(success == 1 ){
                msg +=  HIR "结果$n被血雾罩住，顿时发出一声惨叫！\n而$N也身子一瘫，倒在地上。\n" NOR;
                message_vision(msg, me, target);
                target->kill_ob(me);
                me->kill_ob(target);
                me->add("force", -200);
                me->add("max_force", -100);
                me->save();
                target->receive_damage("kee",0, me);
                target->die();
                me->receive_wound("sen", (int)me->query("max_sen")-1, target);	// shound be ("sen") > ("max_sen" - 100) more
                me->receive_wound("kee", (int)me->query("max_kee")-1, target);
                COMBAT_D->report_status(me);
        }
        else {
                msg +=  HIR "结果血雾被$n内力反激，反而罩住了$N！\n$N长叹一声，身子一瘫，倒在地上。\n" NOR;
                message_vision(msg, me, target);
                target->kill_ob(me);
                me->kill_ob(target);
                me->add("force", -100);
                me->add("max_force", -50);
                me->save();
                me->receive_wound("sen", (int)me->query("max_sen")/2 + 2, target);
                me->receive_wound("kee", (int)me->query("max_kee")/2 + 2, target);
                me->start_busy(2);
                COMBAT_D->report_status(me);
        }
        tell_object(me, HIR"由于施展天魔解体大法，你的寿命减短了！！\n"NOR); 
        me->add("mojiao/jieti",1);
        return 1;
}
               