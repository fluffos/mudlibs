//lianmoshenzhen.c 
#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int exert(object me, object target)
{
        object *ob, weapon;
        string msg;
        int i, skill, damage ,kee;
        if( !me->is_fighting() )
                return notify_fail("「炼魔神针」只能在战斗中使用。\n");
        if((int)me->query_skill("hansha-force", 1) < 130 )
                return notify_fail("你的含沙射影功不够高，不能有效施展炼魔神针！\n");
        if( (int)me->query("force") < 500 )
                return notify_fail("你的内力不够。\n");
        if( (int)me->query("max_force") < 1500 )
                return notify_fail("你的内力不够。\n");
        if( !target || target==me ) {
                target = offensive_target(me);
                if( !target) return notify_fail("你要对谁施展「炼魔神针」？\n");
        }
        skill = me->query_skill("force");
	weapon = me->query_temp("weapon");
        me->add("force", -500);
        me->receive_wound("sen", (int)me->query("max_sen")/10);
        me->receive_wound("kee", (int)me->query("eff_kee")/10);
        damage = target->query("kee");
        if( damage < 600) damage = 600;
        msg = HIR "$N眼神中忽然充满死意，双掌间隐隐发出异光，“波”的一声轻烟飞射，强劲的无形气针袭向$n！\n" NOR;
        kee = target->query("kee");
        COMBAT_D->do_attack(me,target, weapon, TYPE_REGULAR, msg ,"瘀伤");

	if((int)target->query_skill("nodeath_force") > (int)me->query_skill("hansha-force"))
	{
	message_vision(CYN"\n$n全身真气充盈，将那股无形力量化解了开去！\n" NOR, me,target);
      	me->start_busy(2);
	return 1;
	}
	if((int)target->query_skill("liumai_force") > (int)me->query_skill("hansha-force"))
	{
	message_vision(CYN"\n$n全身真气充盈，将那股无形力量化解了开去！\n" NOR, me,target);
      	me->start_busy(2);
	return 1;
	}
	if((int)target->query_skill("guiyu_force") > (int)me->query_skill("hansha-force"))
	{
	message_vision(CYN"\n$n全身真气充盈，将那股无形力量化解了开去！\n" NOR, me,target);
      	me->start_busy(2);
	return 1;
	}
	if((int)target->query_skill("liuhe-force") > (int)me->query_skill("hansha-force"))
	{
	message_vision(CYN"\n$n全身真气充盈，将那股无形力量化解了开去！\n" NOR, me,target);
      	me->start_busy(2);
	return 1;
	}

        if (kee > target->query("kee") + 100){
        	message_vision(HIB"一股寒意无形的渗入了$N的体内！！\n"NOR,target);
        	target->receive_damage("gin", damage/4);
        	target->receive_wound("kee", damage/2);
        	target->receive_damage("sen",damage/4);
        	COMBAT_D->report_status(target,1);
        	me->start_busy(4);
        }else   me->start_busy(2);
        me->add("bellicosity", random(1000));
        return 1;
}

