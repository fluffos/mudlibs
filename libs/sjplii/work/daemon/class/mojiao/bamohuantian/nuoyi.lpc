//nuoyi.c 乾坤大挪移 written by john darks
#include <ansi.h>
inherit SSERVER;
int perform(object me, object target)
{
	object *enemy;
	object target1,target2;
	object target3,target4;
	object ob,weapon;
	int j,damage,level;
	string msg;
	enemy = me->query_enemy();
	level = me->query_skill("bamohuantian",1);
	if (level < 50 )	return notify_fail("你还没有领悟乾坤大挪移的奥义！\n");
	if ( me->query_temp("pero") ) return notify_fail("你的上一个动作还没有完成！\n");
        if (sizeof(enemy)<2) {
        	if (!sizeof(enemy))  return notify_fail("你只有在战斗中才能使用乾坤大挪移！\n");
        	else{
        		j = random((int) level/80 + 1);
        		target1 = enemy[0];
        		switch(j){
        		case 0:
        			message_vision(HIW"$N"+HIW"使出八魔环天大法中的不传之秘「乾坤大挪移」！\n"NOR,me);
        			message_vision(HIY"$N"+HIY"身子滴溜溜的一转，已避开$n"+HIY"的攻势，同时右手轻轻一带，$n"+HIY"身不由己\n"+HIR"一招攻向自己！\n"NOR,me,target1);
        			target1->add_temp("apply/attack", level);
        			target1->add_temp("apply/damage", level);
        			COMBAT_D->do_attack(target1, target1, target1->query_temp("weapon") );
        			target1->add_temp("apply/attack", -level);
        			target1->add_temp("apply/damage", -level);
        			me->set_temp("pero",1);
                        	call_out("del_pero",3,me);
        			break;
				
        		case 1:
        			message_vision(HIW"$N"+HIW"使出八魔环天大法中的不传之秘「乾坤大挪移」！\n"NOR,me);
				message_vision(HIY"$N"+HIY"双手在胸前一旋，形成一道气墙！！\n"NOR,me);
				if ( random( me->query("force")* (level/30 + 1))> target1->query("force")){
                			damage = target1->query("force_factor")*(random(4)+4);
                			target1->receive_damage("kee", damage,me);
                			target1->receive_wound("kee", damage/5,me);
					msg = CYN"将$n"+CYN"的内力全数反击回去！\n" NOR;
                			if( damage < 40 )
                        			msg += "结果$n受到$N的内力反震，闷哼一声。\n";
        				else if( damage < 80 )
                        			msg += "结果$n被$N以内力反震，「嘿」地一声退了两步。\n";
        				else if( damage < 160 )
                        			msg += "结果$n被$N以内力一震，胸口有如受到一记重锤，连退了五六步！\n";
                			else
                        			msg += "结果$n被$N的内力一震，眼前一黑，象一捆稻草一样飞出去好几丈远！\n";
                        	}else {
                        		damage = target1->query("force_factor");
                			me->receive_damage("kee", damage,target);
					msg = CYN"但$n"+CYN"的内力过于雄厚，$N"+CYN"抵挡不住，立被重重击中！\n" NOR;
                			if( damage < 40 )
                        			msg += "结果$N受到$n的内力一震，闷哼一声。\n";
        				else if( damage < 80 )
                        			msg += "结果$N被$n以内力一震，「嘿」地一声退了两步。\n";
        				else if( damage < 160 )
                        			msg += "结果$N被$n以内力一震，胸口有如受到一记重锤，连退了五六步！\n";
                			else
                        			msg += "结果$N被$n的内力一震，眼前一黑，象一捆稻草一样飞出去好几丈远！\n";
                        		me->start_busy(1);
                        	}
                        	message_vision(msg, me, target1);
                        	COMBAT_D->report_status(target1);
                        	me->set_temp("pero",1);
                        	call_out("del_pero",5,me);
                        	break;
        		case 2:
        			message_vision(HIW"$N"+HIW"使出八魔环天大法中的不传之秘「乾坤大挪移」！\n"NOR,me);
        			message_vision(HIY"$N"+HIY"身子一转，已侵到了$n"+HIY"的身边，左手反切而出，正好击中$n"+HIY"的手腕。\n"NOR,me,target1);
        			weapon = target1->query_temp("weapon");
        			if(weapon){
        				message_vision(HIY"$n"+HIY"的手腕一麻，手中兵刃不知怎么反到了$N"+HIY"的手里！\n"NOR,me,target1);
        				message_vision(HIR"$N"+HIR"夺过兵器，反手一抖，就是七招！！\n"NOR,me);
        				weapon->move(me);
        				me->add_temp("apply/attack", level);
        				me->add_temp("apply/damage", level/2);
        				COMBAT_D->do_attack(me, target1, weapon);
        				COMBAT_D->do_attack(me, target1, weapon);
        				COMBAT_D->do_attack(me, target1, weapon);
        				COMBAT_D->do_attack(me, target1, weapon);
        				COMBAT_D->do_attack(me, target1, weapon);
        				COMBAT_D->do_attack(me, target1, weapon);
        				COMBAT_D->do_attack(me, target1, weapon);
        				me->add_temp("apply/attack", -level);
        				me->add_temp("apply/damage", -level/2);
        				me->start_busy(4);
        				me->set_temp("pero",1);
                        		call_out("del_pero",10,me);
        			}else   {
        				message_vision(HIY"$n"+HIY"手腕一麻，$N"+HIY"已反手一掌拍在$n"+HIY"胸口！\n"NOR,me,target1);
        				damage = (int)me->query("force_factor")*(random(3)+4);
        				target1->receive_damage("kee", damage,me);
        				msg ="\n";
        				if( damage < 40 )
                        			msg += "结果$n受到$N的内力一震，闷哼一声。\n";
        				else if( damage < 80 )
                        			msg += "结果$n被$N以内力一震，「嘿」地一声退了两步。\n";
        				else if( damage < 160 )
                        			msg += "结果$n被$N以内力一震，胸口有如受到一记重锤，连退了五六步！\n";
                			else
                        			msg += "结果$n被$N的内力一震，眼前一黑，象一捆稻草一样飞出去好几丈远！\n";
                        		message_vision(msg, me, target1);
                        		COMBAT_D->report_status(target1);
                        		me->set_temp("pero",1);
                        		call_out("del_pero",7,me);
        			}
        			break;
        		default:
        			message_vision(HIW"$N"+HIW"使出八魔环天大法中的不传之秘「乾坤大挪移」！\n"NOR,me);
        			message_vision(HIR"$N"+HIR"围住$n"+HIR"不断游走，$n"+HIR"顿时不知所措！\n"NOR,me,target1);
        			target1->start_busy(2);
        			break;
        		}
        		return 1;
        	}
        }
        else{
        	target1=enemy[0];
        	target2=enemy[1];
        	if(sizeof(enemy)>2) target3=enemy[2];
        	if(sizeof(enemy)>3) target4=enemy[3];
		message_vision(HIW"$N"+HIW"使出八魔环天大法中的不传之秘「乾坤大挪移」！\n"NOR,me);
        	
		if (target3 && target4) {
			weapon = target3->query_temp("weapon");
        		message_vision(HIY "$N"+HIY"伸手带动$n"+HIY"的攻势，使之攻向"+target4->name()+HIY"！\n" NOR,me,target3);
        		COMBAT_D->do_attack(target3,target4, weapon);  
        	}
        	if (target2 && target4) {
			weapon = target2->query_temp("weapon");
        		message_vision(HIY "$N"+HIY"伸手带动$n"+HIY"的攻势，使之攻向"+target4->name()+HIY"！\n" NOR,me,target2);
        		COMBAT_D->do_attack(target2,target4, weapon);  
        	}
        	if (target1 && target4) {
			weapon = target1->query_temp("weapon");
        		message_vision(HIY "$N"+HIY"伸手带动$n"+HIY"的攻势，使之攻向"+target4->name()+HIY"！\n" NOR,me,target1);
        		COMBAT_D->do_attack(target1,target4, weapon);  
        	}
        	if (target4 && target3) {
			weapon = target4->query_temp("weapon");
        		message_vision(HIY "$N"+HIY"伸手带动$n"+HIY"的攻势，使之攻向"+target3->name()+HIY"！\n" NOR,me,target4);
        		COMBAT_D->do_attack(target4,target3, weapon);  
        	}
        	if (target4 && target2) {
			weapon = target4->query_temp("weapon");
        		message_vision(HIY "$N"+HIY"伸手带动$n"+HIY"的攻势，使之攻向"+target2->name()+HIY"！\n" NOR,me,target4);
        		COMBAT_D->do_attack(target4,target2, weapon);  
        	}
        	if (target4 && target1) {
			weapon = target4->query_temp("weapon");
        		message_vision(HIY "$N"+HIY"伸手带动$n"+HIY"的攻势，使之攻向"+target1->name()+HIY"！\n" NOR,me,target4);
        		COMBAT_D->do_attack(target4,target1, weapon);  
        	}
        	if (target2 && target3) {
			weapon = target2->query_temp("weapon");
        		message_vision(HIY "$N"+HIY"伸手带动$n"+HIY"的攻势，使之攻向"+target3->name()+HIY"！\n" NOR,me,target2);
        		COMBAT_D->do_attack(target2,target3, weapon);  
        	}
        	if (target1 && target3) {
			weapon = target1->query_temp("weapon");
        		message_vision(HIY "$N"+HIY"伸手带动$n"+HIY"的攻势，使之攻向"+target3->name()+HIY"！\n" NOR,me,target1);
        		COMBAT_D->do_attack(target1,target3, weapon);  
        	}
        	if (target3 && target2) {
			weapon = target3->query_temp("weapon");
        		message_vision(HIY "$N"+HIY"伸手带动$n"+HIY"的攻势，使之攻向"+target2->name()+HIY"！\n" NOR,me,target3);
        		COMBAT_D->do_attack(target3,target2, weapon);  
        	}
        	if (target3 && target1) {
			weapon = target3->query_temp("weapon");
        		message_vision(HIY "$N"+HIY"伸手带动$n"+HIY"的攻势，使之攻向"+target1->name()+HIY"！\n" NOR,me,target3);
        		COMBAT_D->do_attack(target3,target1, weapon);  
        	}
        	if (target1 && target2) {
			weapon = target1->query_temp("weapon");
        		message_vision(HIY "$N"+HIY"伸手带动$n"+HIY"的攻势，使之攻向"+target2->name()+HIY"！\n" NOR,me,target1);
        		COMBAT_D->do_attack(target1,target2, weapon);  
        	}
        	if (target2 && target1) {
			weapon = target2->query_temp("weapon");
        		message_vision(HIY "$N"+HIY"伸手带动$n"+HIY"的攻势，使之攻向"+target1->name()+HIY"！\n" NOR,me,target2);
        		COMBAT_D->do_attack(target2,target1, weapon);  
        	}
        	me->set_temp("pero",1);
                call_out("del_pero",3,me);
                return 1;
        }
        return 1;
}

void del_pero(object me)
{
	if ( me->query_temp("pero") )
	me->delete_temp("pero");
}