// wudusuohou.c 	五毒锁喉    written by John Darks
#include <ansi.h>
inherit SSERVER;
int perform(object me, object target) {
  object obj;
  string msg;
  int hitsum;
  if (!target) target = offensive_target(me);
  if (!target || !target->is_character())
    return notify_fail("五毒锁喉只能对对手使用。\n");
  if ((int)me->query_skill("hanxing-strike", 1) < 90)
    return notify_fail("你的寒星毒掌不够娴熟，不能施展五毒锁喉。\n");
  switch (random(5)) {
    case 0:
      msg = "一块石头";
      hitsum = 1;
    case 1:
      msg = "一根树枝";
      hitsum = 2;
    case 2:
      msg = "一块碎瓦片";
      hitsum = 1;
    case 3:
      msg = "一片枯叶";
      hitsum = 3;
    case 4:
      msg = "一把泥土";
      hitsum = 5;
  }

  msg = CYN "$N" + CYN "顺手抓起" + msg + "，将毒质运于其上，掷向$n。\n" NOR;
  me->start_busy(3);
  if (random((int)me->query_skill("hanxing-strike", 1)) + hitsum * 10
    > random(target->query_skill("dodge"))) {
    msg += HIR "结果$p" + HIR "被$P" + HIR "攻了个正着！\n" NOR;
    target->receive_wound("kee", (int)me->query_skill("hanxing-strike", 1) / 5);
    target->receive_wound("gin", (int)target->query("max_gin") / 10);
    target->apply_condition("hanxing_poison", random(me->query_skill(
      "hanxing-strike",
      1
    ) / 10) + 1 +
      target->query_condition("hanxing_poison"));
    if (userp(me))
      me->improve_skill("hanxing-strike", me->query_int() + random(10), 1);  //if is player, let him have a chance to improve his skill
      target->start_busy(random(2));
  } else {
    msg += HIY "可是$p" + HIY "急忙闪在一旁，躲了开去。\n" NOR;
    me->start_busy(4);
  }
  message_vision(msg, me, target);
  COMBAT_D->report_status(target);
  return 1;
}
