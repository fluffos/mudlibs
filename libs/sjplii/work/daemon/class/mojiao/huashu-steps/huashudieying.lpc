//huashudieying.c 花树叠影
#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target)
{
        string msg;
        int extra;
        object weapon;
        extra = me->query_skill("huashu-steps",1);
        if ( extra < 70) return notify_fail("你的［穿花绕树身法］还不够纯熟！\n");
        if( !target ) target = offensive_target(me);
        if( !target
        ||      !target->is_character()
        ||      !me->is_fighting(target) )
                return notify_fail("［花树叠影］只能对战斗中的对手使用。\n");

        if (!present("grove branch", environment(me)))
        return notify_fail("你还没有布下花树大阵，如何施展［花树叠影］？\n");
        if (!present("flower petal", environment(me)))
        return notify_fail("你还没有布下花树大阵，如何施展［花树叠影］？\n");

        if(target->is_busy())
                return notify_fail(target->name()+"已经茫然无措了！\n");
        message_vision(HIM"$N翩翩身影在花树丛中飘来晃去，神出鬼没！\n"NOR,me,target);

	if((int)target->query_skill("qingfeng-steps") > (int)me->query_skill("huashu-steps"))
	{
	message_vision(CYN"\n但是$n身法轻盈，从$N的攻势圈中绕了出来！\n" NOR, me,target);
	return 1;
	}
	if((int)target->query_skill("shenkong-xing") > (int)me->query_skill("huashu-steps"))
	{
	message_vision(CYN"\n但是$n身法轻盈，从$N的攻势圈中绕了出来！\n" NOR, me,target);
	return 1;
	}
	if((int)target->query_skill("bagua-steps") > (int)me->query_skill("huashu-steps"))
	{
	message_vision(CYN"\n但是$n身法轻盈，从$N的攻势圈中绕了出来！\n" NOR, me,target);
	return 1;
	}
	if((int)target->query_skill("piaoxiang-steps") > (int)me->query_skill("huashu-steps"))
	{
	message_vision(CYN"\n但是$n身法轻盈，从$N的攻势圈中绕了出来！\n" NOR, me,target);
	return 1;
	}

        if(random((int)target->query("combat_exp")) < (int)me->query("combat_exp") * 2)
        {
        	message_vision("$n只觉到处都是花海树丛，哪里还看得清$N的影子？\n",me,target);
        	target->start_busy(5);
        }
        else{
        	msg = "可惜$N看出了$n的身法，迅然发动攻击！";
        	COMBAT_D->do_attack(target,me, target->query_temp("weapon"),TYPE_REGULAR,msg);  
        }
        return 1;
}
