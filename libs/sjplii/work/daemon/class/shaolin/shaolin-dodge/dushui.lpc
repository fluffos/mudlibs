//登萍度水
#include <ansi.h>
#include <combat.h>
inherit SSERVER;
void jump_up(object me, object target);
void jump_down(object me);
int perform(object me, object target) {
  int skill;
  if ((int)me->query_temp("shaolin/dushui"))
    return notify_fail("你已经在施展［登萍度水］了。\n");
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("［登萍度水］只能对战斗中的对手使用。\n");
  skill = me->query_skill("shaolin-dodge", 1);
  if (skill <= 50) return notify_fail("你的蜻蜓点水提纵术还不够纯熟！\n");
  if ((int)me->query("force") < 60)
    return notify_fail("你的内力不够。\n");
  message_vision(CYN "只见$N双脚点地，使出［登萍度水］，猛一吸气，身形陡然向上拔起！\n" NOR, me);
  if ((int)target->query_skill("qingfeng-steps") > (int)me->query_skill("shaolin-dodge")) {
    message_vision(CYN "\n但是$n身法轻盈，从$N的攻势圈中绕了出来！\n" NOR, me, target);
    return 1;
  }
  if ((int)target->query_skill("shenkong-xing") > (int)me->query_skill("shaolin-dodge")) {
    message_vision(CYN "\n但是$n身法轻盈，从$N的攻势圈中绕了出来！\n" NOR, me, target);
    return 1;
  }
  if ((int)target->query_skill("bagua-steps") > (int)me->query_skill("shaolin-dodge")) {
    message_vision(CYN "\n但是$n身法轻盈，从$N的攻势圈中绕了出来！\n" NOR, me, target);
    return 1;
  }
  if ((int)target->query_skill("tianluo-steps") > (int)me->query_skill("shaolin-dodge")) {
    message_vision(CYN "\n但是$n身法轻盈，从$N的攻势圈中绕了出来！\n" NOR, me, target);
    return 1;
  }
  if ((int)target->query_skill("piaoxiang-steps") > (int)me->query_skill("shaolin-dodge")) {
    message_vision(CYN "\n但是$n身法轻盈，从$N的攻势圈中绕了出来！\n" NOR, me, target);
    return 1;
  }
  me->set_temp("shaolin/dushui", 1);
  me->add("force", -30);
  me->start_busy(1);
  target->start_busy(3);
  call_out("jump_up", 4, me, target);
  call_out("jump_up", 8, me, target);
  call_out("jump_up", 12, me, target);
  call_out("jump_down", 15, me);
  return 1;
}

void jump_up(object me, object target) {
  string msg;
  msg = CYN "\n$N双脚脚尖在地上轻轻一点，身形舒展犹如一只蜻蜓，又腾空向前掠出数丈！\n\n" NOR;
  if (!target || !me
    || !target->is_character()
    || !me->is_fighting(target))
    return;
  message_vision(msg, me);
  me->start_busy(1);
  target->start_busy(3);
}
void jump_down(object me) {
  if (!me) return;
  me->delete_temp("shaolin/dushui");
  tell_object(me, CYN "你的［登萍度水］施展完毕，身形稳稳落了下来。\n" NOR);
  me->start_busy(1);
}
