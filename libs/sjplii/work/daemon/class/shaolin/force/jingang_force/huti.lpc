// powerup.c

#include <ansi.h>

inherit F_CLEAN_UP;

void remove_effect(object me, int amount);

int exert(object me, object target)
{
        int skill;

        if( target != me ) return notify_fail("你只能对自己用功。\n");

        if( (int)me->query("force") < 500 )     return notify_fail("你的内力不够。\n");
        if( (int)me->query_temp("huti") ) return notify_fail("你已经在运功中了。\n");
		if( me->query_skill("jingang_force",1) < 100)
			return notify_fail("你的金刚护体神功修行不够!\n");


        skill = me->query_skill("iron-cloth")/3;

        me->add("force", -200);

        message_vision(
                YEL "$N低诵一声：阿弥陀佛，运起[金刚护体神功]，头顶呈现一圈金光！\n" NOR, me);

        me->add_temp("apply/iron-cloth", skill);
        me->set_temp("huti", 1);

        me->start_call_out( (: call_other, __FILE__, "remove_effect", me, skill :), skill/5);

        if( me->is_fighting() ) me->start_busy(2);

        return 1;
}

void remove_effect(object me, int amount)
{
	if( !me ) return;
        me->add_temp("apply/iron-cloth", - amount);
        me->delete_temp("huti");
        tell_object(me, YEL"你的[金刚护体]运行结束，头顶的金光消失。\n" NOR);
}
 
