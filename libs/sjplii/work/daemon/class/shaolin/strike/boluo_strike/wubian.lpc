//苦海无边

#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target)
{
	string msg;
	int extra;
	object weapon;
	if( !target ) target = offensive_target(me);
	if( !target
	||	!target->is_character()
	||	!me->is_fighting(target) )
		return notify_fail("［苦海无边］只能对战斗中的对手使用。\n");
	weapon = me->query_temp("weapon");
	extra = me->query_skill("boluo_strike",1) / 10;
	if ( extra < 10) return notify_fail("你的波罗密手还不够纯熟！\n");
	target->add_temp("apply/defense", -extra);	
	target->add_temp("apply/dodge", -extra);
       target->add_temp("apply/iron-cloth", -extra*5);

	msg = HIR "$N双掌一抖，刹那间掌力化做惊涛骇浪般的内劲向$n汹涌而去！" NOR;
	COMBAT_D->do_attack(me,target, weapon, TYPE_REGULAR,msg);
	target->add_temp("apply/defense", extra);
	target->add_temp("apply/dodge", extra);
       target->add_temp("apply/iron-cloth", extra*5);

	me->start_busy(2);
	return 1;
}
