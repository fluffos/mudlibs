//罗汉神打
#include <ansi.h>
#include <combat.h>
inherit SSERVER;
void brave_up(object me, object target);
void stop_atk(object me);
int perform(object me, object target) {
  int skill;
  if ((int)me->query_temp("shaolin/luohan"))
    return notify_fail("你已经在施展［罗汉神打］了。\n");
  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("［罗汉神打］只能对战斗中的对手使用。\n");
  skill = me->query_skill("luohan-ken", 1);
  if (skill < 80) return notify_fail("你的罗汉拳还不够纯熟！\n");
  if ((int)me->query_skill("luohan_force") < 30)
    return notify_fail("你的阿罗汉神功不够高！\n");

  if ((int)me->query("force") < 300)
    return notify_fail("你的内力不够。\n");
  message_vision(HIY "$N使出［十八手罗汉神打］，刹那间十八罗汉的身影同时攻向$n！\n" NOR, me, target);
  me->set_temp("shaolin/luohan", 1);
  me->add("force", -120);
  me->start_busy(2);
  call_out("brave_up", 2, me, target);
  call_out("brave_up", 10, me, target);
  call_out("brave_up", 20, me, target);
  call_out("stop_atk", 25, me);
  return 1;
}

void brave_up(object me, object target) {
  string msg;
  string *lh = ({ "巽位", "离位", "坤位", "兑位", "乾位", "坎位", "艮位", "震位", "死门",
    "惊门", "开门", "休门", "生门", "伤门", "杜门", "景门", "太阴", "太阳" });
  string *act = ({ "蹬出一脚", "打出一拳", "拍出一掌", "戳出一指", "踢出一腿",
    "一头撞去", "扫出一臂" });
  if (!target || !me
    || !target->is_character()
    || !me->is_fighting(target))
    return;

  msg = HIC "\n" + lh[random(17)] + "罗汉突然闪了出来，朝$N意想不到的方位" + act[random(6)] + "\n\n" NOR;
  message_vision(msg, target);
  COMBAT_D->report_status(target, 1);
  target->receive_damage("kee", random(10));

  msg = HIC "\n" + lh[random(17)] + "罗汉突然闪了出来，朝$N意想不到的方位" + act[random(6)] + "\n\n" NOR;
  message_vision(msg, target);
  COMBAT_D->report_status(target, 1);
  target->receive_damage("kee", 10 + random(10));

  msg = HIC "\n" + lh[random(17)] + "罗汉突然闪了出来，朝$N意想不到的方位" + act[random(6)] + "\n\n" NOR;
  message_vision(msg, target);
  COMBAT_D->report_status(target, 1);
  target->receive_damage("kee", 10 + random(20));

  msg = HIC "\n" + lh[random(17)] + "罗汉突然闪了出来，朝$N意想不到的方位" + act[random(6)] + "\n\n" NOR;
  message_vision(msg, target);
  COMBAT_D->report_status(target, 1);
  target->receive_damage("kee", 10 + random(30));

  msg = HIC "\n" + lh[random(17)] + "罗汉突然闪了出来，朝$N意想不到的方位" + act[random(6)] + "\n\n" NOR;
  message_vision(msg, target);
  COMBAT_D->report_status(target, 1);
  target->receive_damage("kee", 10 + random(40));
  target->start_busy(3);
}
void stop_atk(object me) {
  if (!me) return;
  me->delete_temp("shaolin/luohan");
  tell_object(me, YEL "你的［罗汉神打］施展完毕，十八罗汉的身形都在一瞬间消失了。\n" NOR);
}
