// tguiyi.c 九九归一

#include <ansi.h>

inherit SSERVER;
int perform(object me, object target) {
  int damage;

  if (!target) target = offensive_target(me);

  if (!target || !target->is_character() || !me->is_fighting(target))
    return notify_fail("[九九归一]只能战斗时用。\n");

  if ((int)me->query_skill("yizhi-chan", 1) < 60)
    return notify_fail("你的[一指禅]修行不够，不能使用绝技。\n");
  if ((int)me->query("force") - (int)me->query("max_force") < 100)
    return notify_fail("你的真气不够。\n");
  me->add("force", -100);

  message_vision(HIR "$N气运丹田，一股真气自丹田而出，大喝一声使出绝技[九九归一]，十指齐向$n的$l点去！\n" NOR, me, target);
  me->start_busy(2);

  if ((int)target->query_skill("taiji-force") > (int)me->query_skill("yizhi-chan")) {
    message_vision(CYN "\n但是$n真气鼓动，将$N的劲力全部弹开了！\n" NOR, me, target);
    return 1;
  }

  if (target->query_skill(
    "iron-cloth",
    1
  ) && target->query_skill("iron-cloth") < random(me->query_skill("sword") * 2)) {
    message_vision(HIR "\n结果$N强大的内劲催破了$n的真元！\n" NOR, me, target);
    target->receive_wound("kee", (int)me->query_skill("yizhi-chan", 1) * 3);
    COMBAT_D->report_status(target, 1);
    me->start_busy(2);
    return 1;
  }

  if (random(me->query("kar") + 15) > target->query("kar") &&
    (random(me->query_skill("dodge") + target->query_skill("dodge")) + 50 > target->query_skill("dodge"))) {
    damage = (int)me->query_skill("unarmed") * 3 - (int)target->query_skill("dodge") * 2;
    damage += (int)me->query_skill("force") * 3 - (int)target->query_skill("force") * 2;
    damage = random(damage) + random(me->query("kar"));
    if (wizardp(me)) printf("damage = %d\n", damage);
    if (damage > 0) {
      target->receive_damage("kee", damage);
      target->receive_wound("kee", damage / 2);
      message_vision(HIR "$N的真气从$n身子穿过，$n一声惨叫，鲜血四溅\n" NOR, me, target);
    }
  } else {
    message_vision(CYN "$n身形急转，闪到一边，$N进攻不成，漏出破绽\n" NOR, me, target);
  }
  return 1;
}
