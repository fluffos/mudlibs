// cibei.c 慈悲为怀

#include <ansi.h>

inherit SSERVER;
int perform(object me, object target)
{
	int damage;
	object ob;

	if(!target) target = offensive_target(me);

	if(!target||!target->is_character()||!me->is_fighting(target))
		return notify_fail("[我佛慈悲]只能战斗时用。\n");

	if((int)me->query_skill("cibei-blade",1)<80 )
		return notify_fail("你的[慈悲刀法]修行不够，不能使用绝技。\n");
	if(!(ob = me->query_temp("weapon"))||(string)ob->query("skill_type") != "blade" )
		return notify_fail("你必须先找一把刀才能用绝技[我佛慈悲]。\n");        
	if((int)me->query("force") - (int)me->query("max_force") < 60)
		return notify_fail("你的真气不够。\n");
	me->add("force", -60);

	message_vision(HIR "$N低诵一声：阿弥陀佛，使出绝技[我佛慈悲]，挥舞手中"+ob->query("name")+"向$n的身上砍去！\n" NOR, me, target);
	me->start_busy(2);
	if((target->query_skill_mapped("sword") == "dg9-sword")&&
	((int)target->query_skill("dg9-sword") > (int)me->query_skill("cibei-blade")))
	{
	message_vision(CYN"\n但是$n剑法一展，$N的攻势莫名其妙地扑了个空！\n" NOR, me,target);
	return 1;
	}

	if( random(me->query("kar")+15)>target->query("kar")&&
		(random(me->query_skill("dodge")+target->query_skill("dodge"))+50>target->query_skill("dodge"))){
		damage = (int)me->query_skill("blade")*3-(int)target->query_skill("blade")*2;
		damage += (int)me->query_skill("parry")*3-(int)target->query_skill("parry")*2;
		damage = random(damage)+random(me->query("kar"));
if(wizardp(me)) printf("damage = %d\n",damage); 
		if(damage>0){
			target->receive_damage("kee", damage);
			target->receive_wound("kee", damage/2);
			message_vision(HIR "$N的"+ob->query("name")+"直向$n身子劈过去，$n一声惨叫，鲜血四溅\n" NOR, me,target);
		}
	}                
	else {
		message_vision(CYN "$n身形急转，闪到一边，$N进攻不成，漏出破绽\n" NOR, me,target);
	}
	return 1;
}


