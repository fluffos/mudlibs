#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target)
{
        string msg,ms;
        int skl_me, skl_you, extra_me, extra_you,i;
        int FLAG=0;
        object you,ob,*obs,sb;
        if( !target ) target = offensive_target(me);
        if( !target
        ||      !target->is_character()
        ||      !me->is_fighting(target) )
                return notify_fail("［独凭栏］只能对战斗中的对手使用。\n");
        if(pointerp(obs=me->query_team()) )
        {
        FLAG=1;
        for(i=0;i<sizeof(obs);i++)
        {
        if(obs[i] == me) continue;
        if(!obs[i]) {FLAG=0;continue;}
              
        if(environment(obs[i]) != environment(me)) {FLAG=0;continue;}
        if(!obs[i]->query_skill("ymei_strike")) {FLAG=0;continue;}
        if(objectp(ob=obs[i]->query_temp("weapon"))) {FLAG=0;continue;}
        if(obs[i]->query_skill_mapped("unarmed") != "ymei_strike") {FLAG=0;continue;}
  //            if(!obs[i]->query("gender")=="女性") {FLAG=0;continue;}
              
                      }       
        if(sizeof(obs) !=2 ) FLAG=0;
              
        }
        skl_me=(int)me->query_skill("unarmed");
        extra_me=(int)me->query_temp("apply/damage")+(int)me->query_str()*(int)me->query_str()/10;
               
        if(FLAG)
        {
                if(obs[0]==me) you=obs[1]; else you=obs[0];
              if(me->query("marry")!=you->query("id")) return notify_fail("不是爱人无法体会情感纠葛的情绪\n");
              
        skl_you=(int)you->query_skill("unarmed");
        extra_you=(int)you->query_temp("apply/damage")+(int)you->query_str()*(int)you->query_str();
              if(you->query("gender")=="男性")
              {sb=you;you=me;me=sb;}   
        msg = HIW+"$N回过头看着"+HIW+you->name()+"均匀美好的侧面,眼神中流露着关爱的神情,\n"+ HIG +
        "似乎天地间只充斥着她的一颦一笑,其他一切都已不再重要,\n" + HIG
               +"$N漾着淡淡却恬淡的微笑,看似随意轻舒了一下衣袖,一阵若有若无的掌影扑朔的洒向了$n"+NOR;
              ms = HIW+"$N用眼角悄悄瞥了"+HIW+me->name()+"一眼脸色微红,有微风吹过抚乱了额头长发,$N抬手梳理\n"+
              "了一下,嘴角泛起似娇羞似欣喜的笑.....,身形仿佛随风而舞,急转之下衣裙飞扬而动,掌影点点击向$n\n"+NOR;
        me->add_temp("apply/attack",(skl_you+skl_me)/5);
        me->add_temp("apply/damage",(extra_you+extra_me));
              you->add_temp("apply/attack",(skl_you+skl_me)/5);
        you->add_temp("apply/damage",(extra_you+extra_me));

        COMBAT_D->do_attack(me,target, me->query_temp("weapon"), TYPE_REGULAR,msg);
              COMBAT_D->do_attack(you,target, you->query_temp("weapon"), TYPE_REGULAR,ms);
             you->add_temp("apply/attack",-(skl_you+skl_me)/5);
        you->add_temp("apply/damage",-(extra_you+extra_me));
              me->add_temp("apply/attack",-(skl_you+skl_me)/5);
        me->add_temp("apply/damage",-(extra_you+extra_me));
             return 1;       
        }
              return notify_fail("独凭栏必须和自己的爱人一起组队使用\n");
           
/*
        else
        {
        msg = HIR+"$N施展出刚阳的一阳指，"+ HIY +
        "无数指影夹杂着炽热的指风，点向$n的全身！\n\n" + NOR;
        me->add_temp("apply/attack",skl_me/10);
        me->add_temp("apply/damage",extra_me/3);
        COMBAT_D->do_attack(me,target, me->query_temp("weapon"), TYPE_REGULAR,msg);
        me->add_temp("apply/attack",-skl_me/10);
        me->add_temp("apply/damage",-extra_me/3);
        }       
        me->start_busy(5);
        return 1;
*/
}
