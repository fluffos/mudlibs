//雨打风吹去
#include <ansi.h>

inherit SSERVER;

int perform(object me, object target) {
  string msg, dodskill;
  object weapon;

  if (!target) target = offensive_target(me);
  if ((int)me->query("bellicosity") > 100)
    return notify_fail("你的杀机太甚，不能体会逍遥自在的意境。\n");
  dodskill = (string)me->query_skill_mapped("dodge");
  if (dodskill != "wave_steps" || (int)me->query_skill("wave_steps", 1) < 50)
    return notify_fail("需要凌波微步身法的配和！\n");
  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("特殊技法只能对战斗中的对手使用。\n");

  if (!(weapon = target->query_temp("weapon"))) {
    me->start_busy(1);
    return notify_fail("对手根本没有用武器!\n");
  }

  if (me->query_skill("unarmed") < 30
    && me->query_skill("ymei_strike") < 30
    && me->query("force") < 100)
    return notify_fail("你的武功显然火候不足!\n");

  msg = CYN "$N左掌变幻一招「雨打风吹去」在空中宛如星雨划过一条条动人的弧线，突然如影随形的向$n兵器的圈来" + weapon->query("name") + "\n";

  if (random(me->query("combat_exp")) >
    (int)target->query("combat_exp") * 3 / 5
    || target->is_busy()) {
    msg += "$n只觉的一股莫名的劲道旋转迩来,手中的 " + weapon->query("name") + "把持不住一下子飞上了半空.\n" NOR;
    destruct(weapon);
    me->add("force", -100);
    target->start_busy(1);
  } else {
    msg += "但是$n处变不惊, 身行流转避过这招, $N顿时露出破绽\n" NOR;
    me->start_busy(2);
  }

  message_vision(msg, me, target);

  return 1;
}
