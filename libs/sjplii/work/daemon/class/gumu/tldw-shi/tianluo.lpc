//倒撒天罗
#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target) {
  string msg;
  int myexp, yourexp, mystr, yourstr, lvl;
  object weapon, ob;

  if (!target) target = offensive_target(me);
  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("［倒撒天罗］只能对战斗中的对手使用。\n");
  weapon = me->query_temp("weapon");
  myexp = (int)me->query("combat_exp");
  mystr = (int)me->query("str");
  yourexp = (int)target->query("combat_exp");
  yourstr = (int)target->query("str");
  lvl = (int)me->query_skill("tldw-shi") / 10 + 1;
  msg = HIG "$N双手一挥，宛若倒织天罗，$n的兵器不知怎么就落在了地下！ \n" NOR;
  if (objectp(ob = target->query_temp("weapon"))) {

    if (random(myexp * lvl * mystr) > (yourexp * yourstr)) {
      //              message_vision(msg + "\n", me, target);
      message_vision(msg, me, target);
      ob = target->query_temp("weapon");
      ob->unequip();
      ob->move(environment(target));
      target->start_busy(1);
    } else
      msg = HIC "$N双手一挥，宛若倒织天罗，窥准$n的破绽迅然攻击！ " NOR;
    message_vision(msg, me, target);
    target->add_temp("apply/iron-cloth", -100);
    COMBAT_D->do_attack(me, target, weapon, TYPE_REGULAR, msg);
    target->add_temp("apply/iron-cloth", 100);
    me->start_busy(1);
  }
  return 1;
}
