//无微不至  created by baiwt@sjpl 11,2,1999
#include <ansi.h>
#include <combat.h>
inherit SSERVER;
void return_busy(object me,object target);

int perform(object me, object target)
{
        int force,wudi;
        if((int)me->query("force")< 500)
        return notify_fail("你的内力太差了！\n");
        force = (int)me->query_skill("force");
        wudi = (int)me->query_skill("wudi_sword");

        if( !target ) target = offensive_target(me);
        if( !target
        ||      !target->is_character()
        ||      !me->is_fighting(target) )
		return notify_fail("［无微不至］只能对战斗中的对手使用。\n");

        if(force < 80 || wudi < 80)
        return notify_fail("你的无底微剑和内功太差了，无法施展“无微不至”！\n");       
	if( (int)me->query_temp("gumu/wudi") ) 
        return notify_fail("你正在施展“无微不至”！\n");       
        me->start_busy(1);
        me->add("force",-500);
        me->set_temp("gumu/wudi",1);
        message_vision(HIR"$N剑光飘忽不定，施展出无底微剑的精华剑式“无微不至”！\n\n"NOR,me);
        call_out("return_busy", 1, me, target);
        return 1;
}

void return_busy(object me,object target)
{
	string msg;
	if( !target || !me
	||	!target->is_character()
	||	!me->is_fighting(target) )
	{
        if(me->query_temp("gumu/wudi"))
        me->delete_temp("gumu/wudi");
        message_vision(HIC"$N的［无微不至］施展完毕，把功力收回丹田！\n"NOR,me);
	return;
	}
	if( me->is_busy() )
	{
        msg = YEL"$N剑锋略偏，遥指$n，$n只觉自己每一招的破绽均在$N剑尖所指之下！\n"NOR;
       COMBAT_D->do_attack(me,target, me->query_temp("weapon"), TYPE_REGULAR,msg);
        msg = YEL"$N剑光忽敛，似乎并未施展任何招式，但是$n却感觉$N剑招的攻势无处不在！\n"NOR;
       COMBAT_D->do_attack(me,target, me->query_temp("weapon"), TYPE_REGULAR,msg);
        msg = YEL"$N身形未动，$n反而自己将全身破绽迎上$N的剑锋！\n"NOR;
       COMBAT_D->do_attack(me,target, me->query_temp("weapon"), TYPE_REGULAR,msg);
	}
	else if(target->query_skill("iron-cloth",1)&&target->query_skill("iron-cloth") < random(me->query_skill("sword")*2) )
	{
        msg = HIR"$N剑光忽敛，似乎并未施展任何招式，但是$n却感觉$N剑招的攻势无处不在！\n"NOR;
	message_vision(msg,me,target);
	message_vision(HIR"\n结果$N强大的剑气摧破了$n的真元！\n" NOR, me,target);
	target->receive_wound("kee", (int)me->query_skill("wudi_sword",1)*3);
	COMBAT_D->report_status(target,1);
	}

        call_out("return_busy", 5, me, target);
}

