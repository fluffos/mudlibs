//eagle.c 冲天啸
//useful only when fighting, other cases only waste force.

#include <ansi.h>

inherit SSERVER;
int exert(object me, object target) {
  target = offensive_target(me);
  //always use the one who is fighting me as target.

  if ((int)me->query("force") < 100)
    return notify_fail("你的内力不够了！\n");

  if ((int)me->query("sen") < (int)me->query("max_sen") / 2)
    return notify_fail("你现在头脑不清醒，没头苍蝇似的可逃不掉！\n");

  if ((string)me->query("family/family_name") != "古墓")
    return notify_fail("你并非古墓弟子，大白雕不会来救你。\n");
  if (environment(me)->query("hell"))
    return notify_fail("这里无法召唤大白雕！\n");
  if (environment(me)->query("oldarea"))
    return notify_fail("这里无法召唤大白雕！\n");

  message_vision(HIC "$N鼓足内劲，撮唇一啸，尖锐刺耳的啸声划破天际，直冲云端！\n" NOR, me);
  message_vision(HIW "只见一只金翅大白雕从云端里冲出！\n\n" NOR, me);

  if (me->is_fighting()) {
    if (random((int)me->query("max_force")) > (int)target->query("max_force") / 2 && random((int)me->query("force")) > (int)target->query("force") / 2) {
      message_vision(HIW "大白雕往下一扑抓住$N，双翅一振，顿时冲上云霄，无影无踪了！\n" NOR, me);
      me->receive_damage("sen", 50);
      me->add("force", -50);
      if (random(3) == 0) me->move("/u/gumu/shan1road4");
      else if (random(3) == 1) me->move("/u/gumu/shan3road2");
      else me->move("/u/gumu/mu_gate1");
      message_vision(HIC "只听趴！地一声，$N从半空中掉下来，跌了个屁股开花！\n" NOR, me);
    } else {
      message_vision(HIW "大白雕往下一扑，却被$n内力逼住，冲不入战团。只好对着$N长唳一声，折了回去！\n" NOR, me, target);
      me->receive_damage("sen", 50);
      me->add("force", -50);
    }
  }

  else {
    message_vision(HIW "只听趴！地一声，大白雕扑下来一翅打在$N的屁股上，$N跌了个七荤八素！\n" NOR, me);
    me->add("force", -50);
  }

  return 1;
}
