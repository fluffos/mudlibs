//乘木旋风乙
#include <ansi.h>
#include <combat.h>
inherit SSERVER;
int perform(object me, object target) {
  string msg, obname;
  int extra;
  object weapon, ob;
  if (!target) target = offensive_target(me);

  if (!target
    || !target->is_character()
    || !me->is_fighting(target))
    return notify_fail("［乘木旋风乙］只能对战斗中的对手使用。\n");
  ob = first_inventory(me);
  if (!objectp(ob) || ob->is_character()) return notify_fail("你身上当前的东西不可以被掌力带动。\n");
  if (userp(ob))
    return notify_fail("你身上当前的东西不可以被掌力带动。\n");
  if ((int)me->query_skill("yimu-strike", 1) < 100)
    return notify_fail("你的乙木旋风掌太差了！\n");
  if ((int)me->query_skill("kurong-force", 1) < 100)
    return notify_fail("你的枯荣禅功太差了！\n");
  if ((int)me->query_skill("jiangshi-steps", 1) < 100)
    return notify_fail("你的僵尸步法太差了！\n");
  weapon = me->query_temp("weapon");
  extra = me->query_skill("yimu-strike", 1) / 10;
  obname = ob->query("name");
  me->add_temp("apply/attack", extra);
  me->add_temp("apply/damage", extra);
  target->add_temp("apply/dodge", -extra);
  target->add_temp("apply/iron-cloth", -extra * 2);

  msg = HIR "$N抓起" + obname + "，无数道掌风破空而出，" + obname + "隐隐带着旋风之声迅疾无比地卷向$n！" NOR;
  COMBAT_D->do_attack(me, target, weapon, TYPE_REGULAR, msg);
  msg = HIR "只见" + obname + "在空中一个盘旋，再次向$n劈头盖脸砸了过来！" NOR;
  COMBAT_D->do_attack(target, target, weapon, TYPE_REGULAR, msg);

  if (target->query_temp("kugu/kurong") || me->query_temp("kugu/kurong")) {
    me->add_temp("apply/damage", extra);
    target->add_temp("apply/iron-cloth", -extra * 10);
    msg = HIR "突然" + obname + "爆裂成无数碎片，被强烈的旋风卷起朝$n扑来！" NOR;
    COMBAT_D->do_attack(me, target, weapon, TYPE_REGULAR, msg);
    msg = HIR "只见" + obname + "化成的碎片在$n身周旋转飞舞，不时发起攻击！" NOR;
    COMBAT_D->do_attack(me, target, weapon, TYPE_REGULAR, msg);
    me->add_temp("apply/damage", -extra);
    target->add_temp("apply/iron-cloth", extra * 10);
  }
  if (me->query_temp("kugu/xingshi")) {
    me->add_temp("apply/damage", extra);
    target->add_temp("apply/dodge", -extra * 10);
    msg = HIR "突然" + obname + "再次爆裂成无数更细小的碎片，被强烈的旋风带着朝$n扑来！" NOR;
    COMBAT_D->do_attack(me, target, weapon, TYPE_REGULAR, msg);
    msg = HIR "只见" + obname + "化成的细小碎片在$n身周旋转飞舞，不时发起攻击！" NOR;
    COMBAT_D->do_attack(me, target, weapon, TYPE_REGULAR, msg);
    me->add_temp("apply/damage", -extra);
    target->add_temp("apply/dodge", extra * 10);
  }
  me->add_temp("apply/attack", -extra);
  me->add_temp("apply/damage", -extra);
  target->add_temp("apply/dodge", extra);
  target->add_temp("apply/iron-cloth", extra * 2);
  destruct(ob);
  me->start_busy(3);
  return 1;
}
