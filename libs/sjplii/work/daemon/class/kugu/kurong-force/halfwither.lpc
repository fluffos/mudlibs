// 半枯半荣
#include <ansi.h>
inherit SSERVER;
int exert(object me, object target) {
  string msg;
  int lvl, ap, dp;
  if (!me->is_fighting())
    return notify_fail("半枯半荣只可以在战斗中施展！\n");
  if (!target) target = offensive_target(me);
  if ((int)me->query_skill("force") < 100)
    return notify_fail("你的内功不够高！\n");
  if ((int)me->query_skill("kurong-force", 1) < 80)
    return notify_fail("你的枯荣禅功不够高！\n");

  if (!target
    || !target->is_character()
    || target->is_corpse())
    return notify_fail("你要对谁施展半枯半荣？\n");

  if ((int)me->query("force") < 150)
    return notify_fail("你的内力不够！\n");

  if ((int)me->query("gin") < 50)
    return notify_fail("你的精神没有办法有效集中！\n");
  if (target->query_temp("kugu/kurong")) return notify_fail("对方已经被用过枯荣禅功了。\n");

  me->add("force", -150);
  me->receive_damage("gin", 50);

  if (random(me->query("max_force")) < 230) {
    write("你失败了！\n");
    return 1;
  }
  lvl = (int)me->query_skill("force") / 2;
  msg = CYN "\n\n$N对$n施展出［枯荣禅功］中的<半枯半荣>！\n\n";
  if ((target->query_skill_mapped("force") == "liumai_force") &&
    ((int)target->query_skill("liumai_force") > (int)me->query_skill("kurong-force"))) {
    message_vision(msg, me, target);
    message_vision(CYN "\n但是对$n没有造成任何影响！\n" NOR, me, target);
    me->start_busy(2);
    return 1;
  }
  if ((target->query_skill_mapped("force") == "liheforce") &&
    ((int)target->query_skill("liheforce") > (int)me->query_skill("kurong-force"))) {
    message_vision(msg, me, target);
    message_vision(CYN "\n但是对$n没有造成任何影响！\n" NOR, me, target);
    me->start_busy(2);
    return 1;
  }
  if ((target->query_skill_mapped("force") == "liuhe-force") &&
    ((int)target->query_skill("liuhe-force") > (int)me->query_skill("kurong-force"))) {
    message_vision(msg, me, target);
    message_vision(CYN "\n但是对$n没有造成任何影响！\n" NOR, me, target);
    me->start_busy(2);
    return 1;
  }
  ap = me->query_skill("force");
  ap = (ap * ap / 100 * ap / 30) * (int)me->query("gin");
  dp = target->query("combat_exp");
  if (random(ap + dp) > dp) {
    msg += "$n的左半边脸丰如满月，右半边脸渐渐腐烂，化做了半个骷髅头！！\n\n";
    seteuid(ROOT_UID);
    target->add_temp("apply/attack", -lvl);
    target->add_temp("apply/defense", -lvl);
    target->set_temp("kugu/kurong", 1);
    target->start_call_out((: call_other, __FILE__, "remove_enlarge"
      , target, lvl :),
      random(lvl / 2) + lvl / 2);
  } else
    msg += "但是$N并没有成功。\n\n";
  if (me == target) {
    msg = replace_string(msg, "$n", "$N");
    message_vision(msg + NOR, me);
  } else
    message_vision(msg + NOR, me, target);
  me->start_busy(1);

  return 1;
}

void remove_enlarge(object target, int lvl) {
  if (!target) return;
  target->delete_temp("kugu/kurong");
  target->add_temp("apply/attack", lvl);
  target->add_temp("apply/defense", lvl);
  message_vision("$N的身体一阵抽搐，左右脸颊渐渐恢复了正常。\n", target);
}
