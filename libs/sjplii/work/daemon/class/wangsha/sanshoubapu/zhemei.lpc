//折梅手  written by john darks
#include <ansi.h>
inherit SSERVER;
int perform(object me)
{
        string msg;
        object weapon, weapon2, target;
        int skill,myexp,yourexp ,lvl;
        if( !target ) target = offensive_target(me);
        if( !target
        ||      !target->is_character()
        ||      !me->is_fighting(target) )
                return notify_fail("［折梅手］只能对战斗中的对手使用。\n");
        skill = me->query_skill("sanshoubapu",1);
        if( skill < 101)
                return notify_fail("你的散手八扑等级不够，还没有领悟折梅手！\n");
        if (!objectp(weapon2 = target->query_temp("weapon")))
                return notify_fail("对方没有兵刃，你不用担心。\n");
        if( me->query("force") < 50 )
                return notify_fail("你的内力不够，无法空手入白刃！\n");
        weapon = me->query_temp("weapon");
        myexp = (int) me->query("combat_exp");
        yourexp = (int) target->query("combat_exp");
        lvl = (int) me->query_skill("unarmed") / 20 + 1;
        msg = HIR "$N"+HIR"双手幻出漫天梅花，飞雪似的向$n"+HIR"落来！" NOR;
        if( random(myexp * lvl) > yourexp )
        {
                message_vision(msg + "\n", me, target);
                if(userp(me))
                        me->add("force",-50);
                msg = HIY "$n"+HIY"顿时觉得眼前一花，手腕一麻，手中兵刃脱手而出！\n" NOR;
                message_vision(msg, me, target);
                weapon2->unequip();              
                weapon2->move(environment(target));
                target->start_busy(2);
        }
        else
        {
                COMBAT_D->do_attack(me,target, weapon,0,msg);
                me->start_busy(2);
        }
        return 1;
}
