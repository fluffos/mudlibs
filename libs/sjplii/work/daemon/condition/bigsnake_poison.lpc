//bigsnake_poison.c written by john darks
#include <ansi.h>
int update_condition(object me, int duration)
{
	me->receive_wound("kee", 147);
	me->receive_damage("sen", 22);
	me->apply_condition("bigsnake_poison", duration - 1);
        if( duration < 1 )
		tell_object(me, HIG "你中的蛇毒终于发作光了！\n" NOR );
	else
		tell_object(me, HIG "你中的天冠巨蛇毒发作了！\n" NOR );
	if( duration < 1 ) 
		return 0;
	return 1;
}
