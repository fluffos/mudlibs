//尸蛊毒
#include <ansi.h>
#include <condition.h>

inherit F_CLEAN_UP;

int update_condition(object me, int duration)
{
	me->receive_damage("gin", 60);
	me->receive_wound("kee", 60);
	me->receive_damage("sen", 60);
	me->apply_condition("corpsesick", duration - 1);

	tell_object(me, HIG "你只觉得体内五脏六腑刀绞般难受，你中的尸蛊毒发作了！\n" NOR );
	if( duration < 1 ) return 0;

	return CND_CONTINUE;
}
