// huashan_wujian.c

#include <ansi.h>
#include <login.h>

int update_condition(object me, int duration)
{
	int num,sword;
	num = (int)me->query("int");
	sword = (int)me->query_skill("sword",1);
	if (duration < 1) {
		me->delete("disable_type");
		me->set("startroom", START_ROOM);
		if((int)me->query("huashan/wujian") >= 2000){
			tell_object(me,HIC"你终于领悟了“无招胜有招”，突破了独孤九剑的瓶颈。\n"NOR);
			tell_object(me,HIC"你的独孤九剑进步了！\n"NOR);
			tell_object(me,HIC"你的经验增加了！\n"NOR);
			tell_object(me,HIC"你的潜能增加了！\n"NOR);
			me->set_skill("dg9-sword",150);
			me->add("combat_exp", 5000);
			me->add("potential", 500);
			me->delete("huashan/wujian");
			message("vision","$N脸上露出一丝微笑，想是终于领悟了“无招胜有招”\n",environment(me),me);
		}
		else {
			tell_object(me,"经过长时间的面壁悟剑，你仍然无法悟得“无招胜有招”。\n");
			message("vision","$N一脸颓丧，想是仍然无法有所领悟。\n",environment(me),me);
		}
		return 0;
	}
	me->set("disable_type",HIG "<悟剑中>" NOR);
	me->apply_condition("huashan_wujian", duration - 1);
	me->start_busy(20);

	if(random(100) < 50+sword/10 && num > 30 ) {
		tell_object(me,"你面壁悟剑，似有所得。\n");
		me->add("huashan/wujian",10+random(num));
	}
	else tell_object(me,"你面壁悟剑，但没有任何领悟。\n");
	return 1;		
}
