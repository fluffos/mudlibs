//风雷三剑
inherit SKILL;
string skill_cname()
{
	return "风雷三剑";
}

mapping *action = ({
        ([      "action":               
"$N使一招「春雷震怒」，手中$w隐隐挟着风雷之声卷向$n的$l",
                "dodge":                20,
		"force" :		100,
                "damage":               60,
                "damage_type":  "刺伤"
        ]),
        ([      "action":               
"$N使出风雷三剑中的「雷霆万钧」，剑刃发出一声雷鸣般的巨响挥向$n的$l",
                "dodge":                30,
                "force":               200,
                "damage":               80,
                "damage_type":  "割伤"
        ]),
        ([      "action":               
"$N剑光凭空一指，一招「大地沉眠」，满空雷鸣刹那间消失无声，手中$w默默的削向$n的$l",
                "dodge":                10,
                "force":               300,
                "damage":               100,
                "damage_type":  "割伤"
        ]),
});

int valid_learn(object me)
{
        object ob;

        if( (int)me->query("max_force") < 50 )
                return notify_fail("你的内力不够，没有办法练风雷三剑。\n");

        if( !(ob = me->query_temp("weapon"))
        ||      (string)ob->query("skill_type") != "sword" )
                return notify_fail("你必须先找一把剑才能练剑法。\n");

        return 1;
}

int valid_enable(string usage)
{
        return usage=="sword" || usage=="parry";
}

mapping query_action(object me, object weapon)
{
        return action[random(sizeof(action))];
}

int practice_skill(object me)
{
        if( (int)me->query("kee") < 30
        ||      (int)me->query("force") < 3 )
                return 
notify_fail("你的内力或气不够，没有办法练习风雷三剑。\n");
        me->receive_damage("kee", 30);
        me->add("force", -3);
        write("你按著所学练了一遍风雷三剑。\n");
        return 1;
}

string perform_action_file(string action)
{
        return CLASS_D("xueshan") + "/fenglei-sword/" + action;
}
 
int effective_level() { return 23;}

string *parry_msg = ({
        "$n使出一招「春雷震怒」，手中的$v荡开了$N的$w。\n",
        "$n使出「雷霆万钧」，将$N的$w封于丈外。\n",
        "$n使出一招「风驰电掣」，手中的$v化做漫天电光，荡开了$N的$w。\n",
        "$n手中的$v一抖，一招「电射星弛」，向$N拿$w的手腕削去。\n",
});

string *unarmed_parry_msg = ({
        "$n将手中的$v舞得密不透风，一招「雷霆万钧」封住了$N的攻势。\n",
        "$n反手一招「风驰电掣」，整个人消失在一团剑光之中。\n",
        "$n使出一招「电射星弛」，$v直刺$N的双手。\n",
        "$n将手中的$v一抖，一招「春雷震怒」，迫得$N连连后退。\n",
});

string query_parry_msg(object weapon)
{
        if( weapon )
                return parry_msg[random(sizeof(parry_msg))];
        else
                return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}

int learn_bonus()
{
	return -60;
}
int practice_bonus()
{
	return -50;
}
int black_white_ness()
{
	return 20;
}

