// 僵尸步法

inherit SKILL;
string skill_cname()
{
	return "僵尸步法";
}

string *dodge_msg = ({
        "但是$n身形飘忽，轻轻一纵，也不见举手投足，轻而易举的避开这一击。\n",
        "$n身子笔挺，膝盖不弯，僵直着往旁窜开数尺，躲了开去。\n",
        "$n身形往上拔起，犹如吊死鬼一般，直挺挺在空中一个旋转落在数尺之外。\n"
});

int valid_enable(string usage)
{
	return (usage=="dodge") || (usage=="move");
}

int valid_learn(object me)
{
	return 1;
}

string query_dodge_msg(string limb)
{
	return dodge_msg[random(sizeof(dodge_msg))];
}

int practice_skill(object me)
{
	if( (int)me->query("kee") < 30 )
		return notify_fail("你的体力太差了，不能练僵尸步法。\n");
	me->receive_damage("kee", 30);
	return 1;
}
int effective_level() { return 21;}

int learn_bonus()
{
	return -60;
}
int practice_bonus()
{
	return -60;
}
int black_white_ness()
{
	return -60;
}

string perform_action_file(string action)
{
        return CLASS_D("kugu") + "/jiangshi-steps/" + action;
}


