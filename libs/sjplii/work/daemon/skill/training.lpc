//驭兽术
inherit SKILL;
#include <ansi.h>
string skill_cname()
{
	return "驭兽术";
}

void skill_improved(object me)
{
        int s;

        s = me->query_skill("training", 1);
        if( (int)me->query("fle") < s/5) {

                tell_object(me, HIW "由於你勤练驭兽术，你的机敏提高了。\n" NOR);
                me->add("fle", 1);
        }
}
string *absorb_msg = ({
	"$n已有准备，不慌不忙的运起猿犹神功。\n",
        "$n闭目凝神，气走全身，护体硬功达到巅峰状态。\n",
        "$n「嘿」的一声，不躲不闪，运起猿犹神功迎向$N！\n",
});

string query_absorb_msg()
{
	return absorb_msg[random(sizeof(absorb_msg))];
}

int learn_bonus()
{
	return 10;
}
int practice_bonus()
{
	return 0;
}
int black_white_ness()
{
	return 0;
}

