// shaoyang_force.c少阳神功

inherit FORCE;

int valid_enable(string usage) { return usage == "force"; }
string skill_cname()
{
	return "少阳神功";
}
string force_type() { return "yang_force"; }

int valid_learn(object me)
{
	int lvl = (int)me->query_skill("shaoyang_force", 1);
	seteuid(getuid());

	if (( me->query("class") != "shaolin" )&&( me->query("class") != "shaolin1" ))
		return notify_fail("少阳神功是少林内功，你不能学。\n");

	if ((int)me->query_skill("force", 1) < 50)
		return notify_fail("你的基本内功火候还不够。\n");
	if (lvl>(int)me->query_skill("buddhism", 1) )
		return notify_fail("你的大乘佛法火候还不够。\n");

	if ((int)me->query("bellicosity") > 200) 
		return notify_fail("你的杀气太高了，不适合练此武功。\n");

	return 1;
}

int practice_skill(object me)
{
	return notify_fail("少阳神功只能用学的，或是从运用(exert)中增加熟练度。\n");
}
int effective_level() { return 20;}

int learn_bonus()
{
	return 0;
}
int practice_bonus()
{
	return 0;
}
int black_white_ness()
{
	return 20;
}

string exert_function_file(string func)
{
        return CLASS_D("shaolin") + "/force/shaoyang_force/" + func;
}


