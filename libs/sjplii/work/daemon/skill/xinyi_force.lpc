// 心意气混元功

inherit FORCE;

int valid_enable(string usage) { return usage == "force"; }
string skill_cname()
{
	return "心意气混元功";
}
string force_type() { return "all_force"; }

int valid_learn(object me)
{
	int lvl = (int)me->query_skill("xinyi_force", 1);
	seteuid(getuid());

	if (( me->query("class") != "shaolin" )&&( me->query("class") != "shaolin1" ))
		return notify_fail("心意气混元功是少林内功，你不能学。\n");

	if ((int)me->query_skill("force", 1) < 10)
		return notify_fail("你的基本内功火候还不够。\n");
	if (lvl>(int)me->query_skill("buddhism", 1) )
		return notify_fail("你的大乘佛法火候还不够。\n");

	if ((int)me->query("bellicosity") > 200) 
		return notify_fail("你的杀气太高了，不适合练此武功。\n");

	return 1;
}

int practice_skill(object me)
{

    if( (int)me->query("sen") < 20 )
        return notify_fail("你的心神不够, 还是先休息吧。\n");
	me->receive_damage("sen", 20);
    return 1;
}

string exert_function_file(string func)
{
        return CLASS_D("shaolin") + "/force/xinyi_force/" + func;
}
int effective_level() { return 18;}

int learn_bonus()
{
	return 20;
}
int black_white_ness()
{
	return 20;
}


