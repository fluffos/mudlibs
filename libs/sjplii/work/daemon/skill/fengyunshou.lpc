// fengyunshou.c  风云手

inherit SKILL;
string skill_cname()
{
	return "风云手";
}

mapping *action = ({
    ([  "action":       "$N一式「风满长空」，以掌化爪，五指如钩，直逼$n的膻中要穴",
        "dodge":        20,
        "parry":        -20,
        "force":        200,
//        "post_action":  (: call_other, PARRY_D, "bash_unarmed" :),
         "damage_type": "瘀伤"
        ]),
    ([  "action":       "$N左手虚晃，一式「烈火腾云」，右手上下直击，反扣$n的肩井大穴",
        "dodge":        -30,
        "parry":        -30,
        "force":        100,
//        "post_action":  (: call_other, PARRY_D, "bash_unarmed" :),
        "damage_type":  "瘀伤"
        ]),
    ([  "action":       "$N使一式「草深雾泽」，掌指齐出，拍拿并施，拿向$n的三路要害",
        "dodge":        -30,
        "parry":        -30,
        "force":        100,
//        "post_action":  (: call_other, PARRY_D, "bash_unarmed" :),
        "damage_type":  "瘀伤"
        ]),
    ([  "action":       "$N左手鹰抓，右手蛇举，一式「天目昭辉」疾扣$n的中节大脉",
        "dodge":        -30,
        "parry":        -30,
        "force":        100,
//        "post_action":  (: call_other, PARRY_D, "bash_unarmed" :),
        "damage_type":  "瘀伤"
        ]),
    ([  "action":       "$N使一式「雷震四方」，四面八方出现无数掌影，一爪突出，抓向$n的$l",
        "dodge":        -30,
        "parry":        -30,
        "force":        100,
//        "post_action":  (: call_other, PARRY_D, "bash_unarmed" :),
        "damage_type":  "瘀伤"
        ]),
    ([  "action":       "$N两手环扣，全身关节啪啪作响，一式「水到渠成」，击向$n的$l",
        "dodge":        -30,
        "parry":        20,
        "force":        10,
//        "post_action":  (: call_other, PARRY_D, "bash_unarmed" :),
        "damage_type":  "瘀伤"
        ]),
    ([  "action":       "$N一式「山高林密」，十指齐伸，遮天蔽日般地笼罩$n的全身要穴！",
        "dodge":        -30,
        "parry":        20,
        "force":        10,
//        "post_action":  (: call_other, PARRY_D, "bash_unarmed" :),
        "damage_type":  "瘀伤"
        ]),
    ([  "action":       "$N岳立霆峙，一式「地老天荒」，在一阵暴雷声中，双手同时拍中$n的七道死穴！",
        "dodge":        -30,
        "parry":        20,
        "force":        10,
//        "post_action":  (: call_other, PARRY_D, "bash_unarmed" :),
        "damage_type":  "瘀伤"
        ]),
    
});


int valid_learn(object me)
{
    if( (int)me->query("force") < (int)me->query_skill("fengyunshou")*15 )
        return notify_fail("你的内力不够，无法修习更高深的风云手。\n");
    if( me->query_temp("weapon") || me->query_temp("secondary_weapon") )
        return notify_fail("练风云手必须空手。\n");
        return 1;
}

int valid_enable(string usage)
{
    return usage=="unarmed";
}

mapping query_action(object me, object weapon)
{
        return action[random(sizeof(action))];
}

int practice_skill(object me)
{

    if( (int)me->query("kee") < 40 )
        return notify_fail("你的体力不够练, 还是先休息休息吧。\n");
        me->receive_damage("kee", 40);
        return 1;
}
