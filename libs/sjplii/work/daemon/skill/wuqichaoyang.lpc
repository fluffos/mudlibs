
// 五气朝阳剑法
#include <ansi.h>

inherit SKILL;
string skill_cname()
{
	return "五气朝阳剑法";
}

mapping *action = ({
([	"action" : HIC"$N一式「一气朝阳」，$w从上至下猛劈，剑锋直出，挟爆裂之声骤然斩向$n的$l。"NOR,
	"force" : 300,
	"damage" : 10,
	"damage_type" : "刺伤"
]),
([	"action" : HIC"$N运气施出「三气朝阳」，$w剑尖逼出三道青芒，闪电般破空射向$n的$l。"NOR,
	"force" : 600,
	"damage" : 30,
	"damage_type" : "刺伤"
]),
([	"action" : HIC"$N双腿半屈半蹲，一式「五气朝阳」，剑尖划出无数圆圈，强光骤起，笼罩天地。"NOR,
	"force" : 900,
	"damage" : 50,
	"damage_type" : "刺伤"
]),
});

int valid_enable(string usage) { return usage == "sword" || usage == "parry"; }


int valid_learn(object me)
{	
	if ( (int)me->query_temp("wuqichaoyang/learn") < 25)
	return notify_fail("五气朝阳剑法只能靠领悟才能掌握。\n");
	else
	return 1;
}


mapping query_action(object me, object weapon)
{
        return action[random(sizeof(action))];
}


int practice_skill(object me)
{
	object weapon;

	if (!objectp(weapon = me->query_temp("weapon"))
	|| (string)weapon->query("skill_type") != "sword")
		return notify_fail("你使用的武器不对。\n");
	if( (int)me->query("kee") < 30
        ||      (int)me->query("force") < 3 )
                return 
notify_fail("你的内力或气不够，没有办法练习五气朝阳剑法。\n");
if( (int)me->query("bellicosity") >100)
                return 
notify_fail("你的杀气太重，无法练习五气朝阳剑法。\n");

	me->receive_damage("kee", 30);
      me->add("force", -3);
      write("你按著从终南绝顶领悟的招数，练了一遍五气朝阳剑法。\n");
	return 1;
}
int valid_effect(object me, object weapon, string name, int skill)
{
}

int effective_level() { return 15;}

int learn_bonus()
{
	return 20;
}
int practice_bonus()
{
	return 10;
}
int black_white_ness()
{
	return -20;
}

string perform_action_file(string action)
{
	return CLASS_D("quanzhen") + "/wuqichaoyang/" + action;
}
