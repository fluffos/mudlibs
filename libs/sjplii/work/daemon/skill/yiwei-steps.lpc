//yiwei-steps.c written by john darks
#include <ansi.h>
inherit SKILL;
string skill_cname()
{
	return "一苇渡江步法";
}

string *dodge_msg = ({
        "$n一招「超然出世」轻轻巧巧地避了开去。\n",
        "只见$n身影一晃，一式「青云直上」早已避在七尺之外。\n",
        "$n使出「一苇渡江」，轻轻松松地闪过。\n",
});

int valid_enable(string usage)
{
        return usage=="dodge";
}

int valid_learn(object me)
{
	if( (int)me->query("bellicosity") >100 )
                return notify_fail("你的杀气太高，无法静心领悟一苇渡江步法。\n");
        return 1;
}

string query_dodge_msg(string limb)
{
        object me,ob;
	me = this_player();
	if( !me )
        return dodge_msg[random(sizeof(dodge_msg))];
        ob = me->query_temp("last_opponent");
	if( !ob )
        return dodge_msg[random(sizeof(dodge_msg))];
	else
        if ( ob && present(ob, environment(me)) && !ob->is_busy())	
        	ob->start_busy(1);
        return dodge_msg[random(sizeof(dodge_msg))];
}

int practice_skill(object me)
{
        if( (int)me->query("kee") < 30
        ||      (int)me->query("force") < 3 )
                return notify_fail("你的气或内力不够，不能练一苇渡江步法。\n");
        me->receive_damage("kee", 30);
        me->add("force", -3);
        return 1;
}

int effective_level() { return 15;}

int learn_bonus()
{
	return 20;
}
int practice_bonus()
{
	return 10;
}
int black_white_ness()
{
	return 20;
}

void skill_improved(object me)
{
	int s;
        s = me->query_skill("yiwei-steps", 1);
        if (s == 0) return ;
        if (s == 1)
        	tell_object(me, HIW"\n一苇渡江步法是达摩早年所悟，传闻已失传多年！\n"NOR);
}


string perform_action_file(string action)
{
        return CLASS_D("mojiao") + "/yiwei-steps/" + action;
}

