//弦音刀法

inherit SKILL;
string skill_cname()
{
	return "弦音刀法";
}

mapping *action = ({
        ([      "action":               
"$N身形向前，使出一招「离情向天叶含秋」，自左而右砍向$n的$l。",
                "dodge":                -50,
                "damage":                30,
                "damage_type":  "割伤"
        ]),
        ([      "action":               
"$N$N低吟一句“「天命无缘欲奈何」”，$w化做一道寒光射向$n！",
                "dodge":               -30,
                "parry":                20,
                "damage":               80,
                "damage_type":  "刺伤"
        ]),
        ([      "action":               
"$N把$w交左手，运起神功，使出「秋是残夕断红尘」，一股股的寒气从右手射出，直逼向$n。",
                "dodge":                -80,
                "parry":                 20,
                "damage":                20,
                "damage_type":  "刺伤"
        ]),
        ([      "action":               
"$N使出一招「越女曼舞红官深」，将$n的全身被笼罩在一片寒光只中。",
                 "dodge":               -10,
                "damage":               100,
                "damage_type":  "割伤"
        ]),
        ([      "action":   
"$N使出弦音刀法的最高境界「寒灵无影追风尘」，全身化成一道寒光，像一股凛冽的寒风席卷$n的全身！",
                 "dodge":               -100,
                "damage":               120,
                "damage_type":  "割伤"
        ]),
});

int valid_learn(object me)
{
        if( (int)me->query("max_force") < 300 )
                return notify_fail("你的内力不够，无法学习弦音刀法。\n");

        return 1;
}

int valid_enable(string usage)
{
        return usage=="blade" || usage=="parry";
}

mapping query_action(object me, object weapon)
{
        return action[random(sizeof(action))];
}

int practice_skill(object me)
{
        object ob;
        int sk = me->query_skill("xianyin_blade",1);

        if( (int)me->query("max_force") < 400 )
                return notify_fail("你的内力不够，没有办法练弦音刀法。\n");

        if( !(ob = me->query_temp("weapon"))
        ||      (string)ob->query("skill_type") != "blade" )
                return notify_fail("你必须先找一把刀才能练刀法。\n");

        if( sk==30 || sk==120) 
                return notify_fail("你练了一次刀法，发现自己已经不能再提高了。看来是得找人指点一下了。\n");

        if( (int)me->query("kee") < 30
        ||      (int)me->query("force") < 10 )
                return 
        notify_fail("你的内力或气不够，没有办法练习弦音刀法。\n");
        me->receive_damage("kee", 30);
        me->add("force", -10);
        write("你按著所学练了一遍弦音刀法。\n");
        return 1;
}

string perform_action_file(string action)
{
        return CLASS_D("gaibang") + "/xianyin_blade/" + action;
}
string *parry_msg = ({
        "只听见「叮」一声，$n手中的$v荡开了$N手中的$w。\n",
        "$n把手中的$v舞成一片寒光，令$N的$w无法靠近。\n",
        "$n手中的$v荡起一团寒气，扫开了$N的$w。\n",
        "结果「当」地一声，被$n手中的$v格开了。\n",
});

string *unarmed_parry_msg = ({
        "$n运起寒灵心法，将全身笼罩在一片寒气之中，$N只能收回这一招。\n",
        "$n不进反退，$v直刺$N的双手。\n",
        "$n将手中的$v一挺，$N见势不妙，连退几步。\n",
});

string query_parry_msg(object weapon)
{
        if( weapon )
                return parry_msg[random(sizeof(parry_msg))];
        else
                return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}

int effective_level() { return 20;}

int learn_bonus()
{
	return 10;
}
int practice_bonus()
{
	return 5;
}
int black_white_ness()
{
	return -10;
}
