// 玉女素心剑

inherit SKILL;
string skill_cname()
{
	return "玉女素心剑";
}

mapping *action = ({
        ([      "action":               "$N使出一招「小乔出嫁」，身形一转，手中的$w忽然变成一条白光刺向$n的$l",
                "dodge":                -80,
                "damage":               60,
                "damage_type":  "刺伤"
        ]),
        ([      "action":               "$N身体微屈，使出玉女素心剑中的「貂婵赏月」，剑光化作一条白带由下往上霍霍斩向$n的$l",
                "dodge":                -30,
                "damage":               80,
                "damage_type":  "割伤"
        ]),
        ([      "action":               "$N一招「西施归越」，手中$w向右划一园弧，突然剑峰一转，自后朝前刺向$n的$l",
                "dodge":                -55,
                "damage":               100,
                "damage_type":  "刺伤"
        ]),
        ([      "action":               "$N提剑于胸一招「贵妃射箭」手中$w从中宫直进，对准$n的$l刺出一剑",
                "dodge":                -50,
                "damage":               130, 
                "damage_type":  "刺伤"
        ]),
        ([      "action":               "$N纵身一跃，手中$w一招「嫦娥奔月」对准$n的$l斜斜刺出一剑",
                "dodge":                -80,
                "damage":               150,
                "damage_type":  "刺伤"
        ]),
        ([      "action":               "$N秀眉微蹙，娇叱一声，手中$w凭空一指，身随剑走，一招「昭君出塞」急急刺向$n的$l",
                "dodge":                -20,
                "parry":                -50,
                "damage":               200,
                "damage_type":  "刺伤"
        ]),
});

int valid_learn(object me)
{
        object ob;

        if( (int)me->query("max_force") < 200 )
                return notify_fail("你的内力不够，没有办法练玉女素心剑。\n");

        if( (string)me->query_skill_mapped("force")!= "beauty-force")
                return notify_fail("玉女素心剑必须配合玉女心经才能练习。\n");

        if( !(ob = me->query_temp("weapon"))
        ||      (string)ob->query("skill_type") != "sword" )
                return notify_fail("你必须先找一把剑才能练剑法。\n");
        if( (string)me->query("gender") != "女性" )
                return notify_fail("玉女素心剑是只有女子才能练的武功。\n");
       
//        if( (int)me->query("per") < 25 )
//                return notify_fail("你的容貌不够，似乎不宜练玉女素心剑。\n");


        return 1;
}

int valid_enable(string usage)
{
        return usage=="sword" || usage=="parry";
}

mapping query_action(object me, object weapon)
{
        return action[random(sizeof(action))];
}

int practice_skill(object me)
{
        if( (int)me->query("kee") < 10
        ||      (int)me->query("force") < 5 )
                return notify_fail("你的内力或气不够，没有办法练习玉女素心剑。\n");
        me->receive_damage("kee", 5);
        write("你按著所学练了一遍玉女素心剑。\n");
        return 1;
}
string perform_action_file(string action)
{
        return CLASS_D("gumu") + "/beauty-sword/" + action;
}

int effective_level() { return 18;}

string *parry_msg = ({
        "$n使出一招「眉眼盈盈」，手中的$v荡开了$N的$w。\n",
        "$n使出「一笑倾城」，将$N的$w封于丈外。\n",
        "$n使出一招「美人并来遮面」，手中的$v化做漫天残照，荡开了$N的$w。\n",
        "$n手中的$v一抖，一招「美女穿梭」，向$N拿$w的手腕削去。\n",
});

string *unarmed_parry_msg = ({
        "$n将手中的$v舞得密不透风，一招「春草昭阳路断」封住了$N的攻势。\n",
        "$n反手一招「美人照镜」，整个人消失在一团剑光之中。\n",
        "$n使出一招「芳草无情」，$v直刺$N的双手。\n",
        "$n将手中的$v一抖，一招招「飞燕伏海」，迫得$N连连后退。\n",
});

string query_parry_msg(object weapon)
{
        if( weapon )
                return parry_msg[random(sizeof(parry_msg))];
        else
                return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}

int learn_bonus()
{
        return 10;
}
int practice_bonus()
{
        return 5;
}
int black_white_ness()
{
        return 20;
}
