//烈火鞭法 fire_whip.c

inherit SKILL;
string skill_cname()
{
	return "烈火鞭法";
}

mapping *action = ({
        ([      "action":
"$N高高跳起，把$w抖得笔直，一招「烈焰腾空」击向$n",
                "dodge":                5,
                "parry":                -10,
                "damage":               55,
                "damage_type":  "抽伤"
        ]),
        ([      "action":               
"$N大喝一声，手中$w宛若矫龙飞在半空。\n$n只觉得全身俱在$w笼罩之下",
                "dodge":                -20,
                "parry":                -20,
                "damage":               80,
                "damage_type":  "抽伤"
        ]),
        ([       "action":
"$N力贯$w，一招「飞蛾扑火」点点鞭影飘浮不定地点向$n的$l",
                "dodge":                -25,
                "parry":                5,
                "damage":               45,
                "damage_type":  "抽伤"
        ]),
        ([      "action":
"$N随手挥动了一下$w，但见四处都是鞭影，$n只觉$w已击上了$l",
                "dodge":                -15,
                "parry":                -5,
                "damage":               65,
                "damage_type":  "抽伤"
        ]),
        ([      "action":
"$N向前迈上两步，手中不停挥舞着$w，自上而下地卷向$n",
                "dodge":                -5,
                "parry":                0,
                "damage":               35,
                "damage_type":  "抽伤"
        ]),
        ([      "action":
"$N身形急转，手中$w急绞，但见方圆丈许飞沙走石，一招「火中取栗」击向$n！",
                "dodge":                -15,
                "parry":                -20,
                "damage":               85,
                "damage_type":  "抽伤"
        ]),

});

int valid_learn(object me)
{
        object ob;

        if( (int)me->query("max_force") < 100 )
                return notify_fail("你的内力不够，没有办法练烈火鞭法。\n");

        if( !(ob = me->query_temp("weapon"))
        ||      (string)ob->query("skill_type") != "whip" )
                return notify_fail("你必须先找一根鞭子才能练烈火鞭。\n");

        return 1;
}

string *parry_msg = ({
        "$n不退反进，气走周天，用手中的$v卷住了$N的$w。\n",
	"$n把$v舞的密不透风，使$N无法进攻。\n",
	"$n用手中的$v护住了全身大穴，是得$N无法进攻。\n",
});

string *unarmed_parry_msg = ({
        "$n挥舞$v，在身前布起了一道铜墙铁壁，封住了$N的攻势。\n",
	"$n一抖手中的$v，攻向$N，迫得$N退后两步。\n",
	"$n举鞭静立，一股内力从鞭梢透出，逼开了$N。\n",
});

string query_parry_msg(object weapon)
{
        if( weapon )
                return parry_msg[random(sizeof(parry_msg))];
        else
                return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}

int valid_enable(string usage)
{
        return usage=="whip" || usage=="parry";
}

mapping query_action(object me, object weapon)
{
        return action[random(sizeof(action))];
}
		

int practice_skill(object me)
{
        if( (int)me->query("kee") < 25
        ||      (int)me->query("force") < 5 )
                return notify_fail("你的内力或气不够，没有办法练习烈火鞭法。\n");
        me->receive_damage("kee", 25);
        me->add("force", -5);
        write("你按着所学练了一遍烈火鞭法。\n");
        return 1;
}

int valid_effect(object me, object weapon, string name, int skill)
{
}

int effective_level() { return 21;}

int learn_bonus()
{
        return 0;
}
int practice_bonus()
{
        return 0;
}
int black_white_ness()
{
        return 20;
}
