// 春秋正气
#include <ansi.h>

inherit SKILL;

string type() { return "knowledge"; }
string skill_cname() {
  return "春秋正气";
}

void skill_improved(object me) {
  int s;

  s = me->query_skill("zhengqi", 1);
  if ((int)me->query("kar") < s / 4) {
    tell_object(me, HIW "由於你勤学[春秋正气]，你的运气提高了。\n" NOR);
    me->add("kar", 1);
  }
}

int valid_learn(object me) {
  if ((int)me->query("bellicosity") > 50)
    return notify_fail("你的杀气太重，无法修炼春秋正气。\n");
  return 1;
}

int learn_bonus() {
  return 20;
}
int practice_bonus() {
  return 0;
}
int black_white_ness() {
  return 0;
}
