// 金光刀法,golden_blade

inherit SKILL;
string skill_cname()
{
	return "金光刀法";
}

mapping *action = ({
	([	"action":		"$N使一招「金戈铁马」，手中$w轻飘飘地向$n的$l斩去！",
		"damage":		 60,
		"dodge":		-10,
		"damage_type":	"砍伤"
	]),
	([	"action":		"$N门户大开，$w随著一招「金光大道」由上而下砍往$n的$l",
		"damage":		 30,
		"damage_type":	"割伤"
	]),
	([	"action":		"$N身形后转，一招「金刚怒目」$w恍惚不定，斩向$n的$l",
		"damage":		 60,
		"dodge":		-40,
		"damage_type":	"砍伤"
	]),
	([	"action":		"$N舞动$w，一招「金玉良言」迅捷无比地劈向$n的$l",
		"damage_type":	"内伤"
	]),
	([	"action":		"$N放下手中$w，一招「金盆洗手」向$n的$l打出一掌",
              "dodge":            -20,
              "parry":            -20,
		"damage":		120,
		"damage_type":	"瘀伤"
	]),
	([	"action":		"$N提刀过肩，蓄劲发力，一招「金枝玉叶」直劈$n$l",
		"damage":		 50,
		"damage_type":	"砍伤"
	]),
	([	"action":		"$N向前跨上一步，使一招「金碧辉煌」挥动$w斩向$n的$l",
		"damage":		150,
              "dodge":            -30,
              "parry":            -20,
		"damage_type":	"砍伤"
	]),
});

int valid_enable(string usage)
{
	return (usage=="blade") || (usage=="parry");
}

mapping query_action(object me, object weapon)
{
	return action[random(sizeof(action))];
}

int valid_learn(object me)
{
        if( (int)me->query("max_force") < 50 )
                return notify_fail("你的内力修为不足，无法修习金光刀法。\n");
        return 1;
}
int practice_skill(object me)
{
        object ob;
        int sk = me->query_skill("golden_blade", 1);

        if( !(ob = me->query_temp("weapon"))
        ||      (string)ob->query("skill_type") != "blade" )
                return notify_fail("你必须先找一把刀才能练刀法。\n");

        if( (int)me->query("kee") < 30
        ||      (int)me->query("force") < 10 )
                return 
        notify_fail("你的内力或气不够，没有办法练习金光刀法。\n");
        me->receive_damage("kee", 30);
        me->add("force", -10);
        write("你按著所学练了一遍金光刀法。\n");
        return 1;
}

string *parry_msg = ({
        "只听见「锵」一声，$n手中的$v荡开了$N的$w。\n",
        "$n挥动手中$v连消带打，令$N的$w无法靠近。\n",
        "$n使出一招「金蝉脱壳」，躲开了$N的$w。\n",
        "结果「当」地一声，被$n手中的$v格开了。\n",
});

string *unarmed_parry_msg = ({
        "$n将手中的$v舞得密不透风，封住了$N的攻势。\n",
        "$n运气在胸，使出一招「金城汤池」，前胸结结实实的挨了$N的一招。\n",
        "$n将手中的$v一抖，迫得$N连连后退。\n",
});

string query_parry_msg(object weapon)
{
        if( weapon )
                return parry_msg[random(sizeof(parry_msg))];
        else
                return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}

int effective_level() { return 18;}

int learn_bonus()
{
	return 10;
}
int practice_bonus()
{
	return 5;
}
int black_white_ness()
{
	return -10;
}