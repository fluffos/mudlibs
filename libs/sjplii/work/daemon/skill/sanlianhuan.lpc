//神倒鬼跌三连环
#include <ansi.h>;
inherit SKILL;
string skill_cname()
{
	return "神倒鬼跌三连环";
}

mapping *action = ({
([	"action" : "$N左手轻轻一抹，向$n的$l拍去",
	"damage" : 180,
        "damage_type" : "瘀伤"
]),
([	"action" : "$N右手一提，插向$n的$l",
	"damage" : 150,
        "damage_type" : "瘀伤"
]),
([	"action" : "$N右足一伸，在$n的脚跟一绊",
	"parry" : -50,
	"dodge" : -50,
	"damage" : 120,
        "damage_type" : "瘀伤"
]),

});

mapping last_action = ([      "action":               
HIR"$N手脚并用，带起地上升腾的湿气，一招「连环三式神鬼跌」，向$n的$l连续攻来"NOR,
                "dodge":                -120,
                "parry":                -120,
                "damage":               300,
	        "damage_type" : "瘀伤"
        ]);

int valid_enable(string usage) { return usage=="unarmed" ; }
int effective_level()
{
	if( NATURE_D->query_humidity() > 80 )
	return 18;
	else
	return 3;
}

int valid_learn(object me)
{
	return 1;
}

mapping query_action(object me, object weapon)
{
	if( NATURE_D->query_humidity() > 80 )
	      return last_action;
	return action[random(sizeof(action))];
}
string *parry_msg = ({
        "$n以守为攻，猛击$N握$w的手腕。\n",
});

string *unarmed_parry_msg = ({
        "$n左掌击下，右掌自保，将$N封于尺外。\n",

});

string query_parry_msg(object weapon)
{
        if( weapon )
                return parry_msg[random(sizeof(parry_msg))];
        else
                return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}

int practice_skill(object me)
{
	if ((int)me->query("kee") < 30)
		return notify_fail("你的体力太低了。\n");
	if ((int)me->query("force") < 20)
		return notify_fail("你的内力不够练神倒鬼跌三连环。\n");
	me->receive_damage("kee", 30);
	me->add("force", -10);
	return 1;
}
string perform_action_file(string action)
{
        return CLASS_D("egui") + "/sanlianhuan/" + action;
}

