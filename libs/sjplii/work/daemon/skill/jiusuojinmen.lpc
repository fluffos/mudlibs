//九锁金门  written by john darks
#include <ansi.h>
inherit FORCE;
int valid_enable(string usage) { return usage=="iron-cloth"; }
string skill_cname()
{
	return "九锁金门";
}

int valid_learn(object me) { return 1; }

int practice_skill(object me)
{
        return notify_fail("九锁金门只能用学的。\n");
}
 
int effective_level() { return 20;}

string *absorb_msg = ({
        "$n大喝一声，一股罡气旋风般卷出。\n",
        "$n气达全身，施展九锁金门，对抗$N的一击之力。\n",
});

string query_absorb_msg()
{
        return absorb_msg[random(sizeof(absorb_msg))];
}

int bounce_ratio()
{
	return 5;
}

int learn_bonus()
{
	return -10;
}
int practice_bonus()
{
	return -50;
}
int black_white_ness()
{
	return 50;
}

void skill_improved(object me)
{
	int s;
        s = me->query_skill("jiusuojinmen", 1);
        if (s == 0) return ;
        if (s == 1){
        	tell_object(me, HIW"\n九锁金门乃横练外功，为天和道人所创！\n"NOR);
        }
        if (s == 110)
        	tell_object(me, HIW"由于你苦练武功，领悟护身罡气(Perform Iron-cloth.Hushengangqi)的使用！\n\n"NOR);
}

string perform_action_file(string action)
{
        return CLASS_D("mojiao") + "/jiusuojinmen/" + action;
}
