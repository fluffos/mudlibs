//身外化身剑外化剑
inherit SKILL;

string *dodge_msg = ({
	"只见$n身影一晃，早已避在七尺之外。\n",
        "$n身形往上一拔，一个转折落在数尺之外。\n",

});
string skill_cname()
{
	return "身外化身剑外化剑";
}

int valid_enable(string usage)
{
	return (usage=="dodge") ;
}

int valid_learn(object me)
{
	if( (int)me->query("max_force") < 50 )
		return notify_fail("你的内力不够，没有办法练身外化身剑外化剑。\n");

	return 1;
}

string query_dodge_msg(string limb)
{
	return dodge_msg[random(sizeof(dodge_msg))];
}

int practice_skill(object me)
{
	if( (int)me->query("kee") < 30
	||	(int)me->query("force") < 3 )
		return notify_fail("你的气或内力不够，不能练身外化身剑外化剑。\n");
	me->receive_damage("kee", 30);
	me->add("force", -3);
	return 1;
}
int effective_level() { return 16;}

int learn_bonus()
{
	return -20;
}
int practice_bonus()
{
	return -10;
}
int black_white_ness()
{
	return 40;
}

string perform_action_file(string action)
{
        return CLASS_D("xueshan") + "/changesword/" + action;
}

