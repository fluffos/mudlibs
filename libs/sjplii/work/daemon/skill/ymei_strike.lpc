//ymei_strike.c逍遥折梅手
#include <ansi.h>
inherit SKILL;
string skill_cname()
{
	return "逍遥折梅手";
}

mapping *action = ({
        ([     "action":
"$N脸上渐渐露出追忆的神情，一招"+HIW"「驿外断桥处」"NOR+",右掌轻推好象忧伤的歌声来自远方\n"
"似有私无的向着$n的$l飘摇迩来.",
                   "force" : 230,
                   "dodge" : 10,
                   "parry" : 15,
                   "damage_type":  "瘀伤"
             ]),
   ([      "action":
"$N左掌轻拂好象要挥去那段蓦然的思绪，一招"+HIW"「寂寞开无主」"NOR+",夹着一股阴柔的内劲向$n的$l\n",
                    "dodge": 40,
                     "force" : 230,
                     "parry" : 15,
                    "damage_type":"瘀伤"
             ]),
             ([      "action":
"$N卓然长立，形单影只的伫立在萧索的风中，一招"+ HIW"「已是黄昏独自愁」"NOR+",化掌为戟\n"
"急戳$n的$l.",
                   "dodge": 50,
                    "force" : 210,
                    "parry" : 15,
                   "damage_type": "戳伤" 
             ]),
             ([      "action":
"$N掌落如风雨骤至，排空荡气，一招"+HIW"「更著风和雨」"NOR+",纷纷扬扬的随意飘洒,"
"好似有意又似无心的拍向$n的$l",
                   "dodge": 60,
                   "force" : 250,
                   "parry" : 15,
                   "damage_type":  "瘀伤"
             ]),
             ([      "action":
"$N突然一收势欣然静立遥望长空，铤峙屿立杀气顿敛,蓦然间$n只觉一道闪电割裂寰宇\n"
"一招"+HIW"「无意苦争春」"NOR+",左掌画着一条完美的弧线拍向$n的$l!",
                     "dodge":  50,
                    "force" : 250,
                    "parry" : 15,
                     "damage_type":  "瘀伤"
             ]),
             ([      "action":
"$N双掌交错零落翻飞，写意美妙若嫩霜白雪中傲然展开的冻蕊寒梅随风纷至沓来，\n"
"一招"+HIR"「一任群芳妒」"NOR+",带着袭人的寒意飘洒$n的$l.",
                     "dodge": 190,
                      "force" : 420,
                      "parry" : 150,
                     "damage_type": "瘀伤"
             ]),
             ([      "action":
"$N的身影流转，掌影蒙蒙胧胧，好象凄迷风雪的充斥天地，碎雪分飞中\n"
"一招"+HIW"「零落成泥碾做尘」"NOR+"双掌连绵不绝向$n的$l席卷迩来，却不知从何所来。",
                     "dodge": 30,
                       "force" : 320,
                     "parry" : 15,
                     "damage_type":  "瘀伤"
              ]),
              ([      "action":
"$N露出了深沉失落的神情掌法渐渐不着痕迹，让人无迹可寻，却有包含着某种奇特的韵律，\n"
"一招"+HIW"「只有香如故」"NOR+"零零落落的击向$n的$l.",
                     "dodge": 20,
                      "force" : 220,
                     "parry" : 15,
                     "damage_type":  "瘀伤" 
              ]),
              ([      "action":
"$N长身而立露出淡然灿烂的笑容，衣袖自右上方划过一条动人心魄的美妙曲线，在阴晦的天空中"
"拨开了困顿的风雪,一丝光华好象微露的朝阳自袖中射向$n的$l,正是一招"+GRN"「春开早」"NOR,
                     "dodge": 20,
                      "force" : 220,
                      "parry" : 15,
                     "damage_type":  "瘀伤"
               ]),
});

int valid_learn(object me)
{
   string dodskill;
       dodskill = (string) me->query_skill_mapped("dodge");
        if ( dodskill != "wave_steps" || (int)me->query_skill("wave_steps",1)<50)
                return notify_fail("逍遥武功必须要凌波微步的配合.\n"); 
   if( me->query_temp("weapon") || me->query_temp("secondary_weapon") )
                return notify_fail("修习折梅手必须空手。\n");
    if( (int)me->query("max_force") < 500 )
                return notify_fail("你的内力修为不足，无法练折梅手。\n");
        if( (int)me->query_skill("unarmed",1)/2 < (int)me->query_skill("ymei_strike",1)/3 )
                return notify_fail("你的拳脚功夫根基不够，无法练习折梅手。\n");
        return 1;       


}

int valid_enable(string usage)
{
                return usage=="unarmed" || usage=="parry";

}


mapping query_action(object me, object weapon)
{
        return action[random(sizeof(action))];
}

int practice_skill(object me)
{
         int skill,combat_exp;
         skill = me->query_skill("ymei_strike",1);
         if( ( skill >= 99 && skill < 106) || ( skill >= 145 && skill < 151) )
             return notify_fail("你于细微处无法理解，需要向师父继续学习精妙招式。\n");
         combat_exp=(int)me->query("combat_exp");
         skill=(int)me->query_skill("wave_steps", 1);
         if( me->query_temp("weapon") || me->query_temp("secondary_weapon") )
                return notify_fail("修习折梅手必须空手。\n");
        if( skill*skill*skill/10 > combat_exp )
          return notify_fail("你的实战经验不够，无法练习折梅手.\n");        


           if( (int)me->query("kee") < 40
        ||      (int)me->query("force") < 10 )
                return 
        notify_fail("你的内力或气不够，没有办法练习。\n");
        me->receive_damage("kee", 40);
        me->add("force", -10);
        write("你把折梅手从头到尾练了一遍。好象有点心得\n");
        return 1;
}
int effective_level() { return 9;}
        
string perform_action_file(string action)
{
         return CLASS_D("xiaoyao") + "/ymei_strike/" + action;
}

string *parry_msg = ({
        "$n左手牵引带过了$N的攻势。\n",
        "$n连消带打，令$N无法靠近。\n",
        "$n衣袖轻挥一股阴柔的内劲，迫开了$N。\n",
        "$n拍向$N的空门，逼回了$N的攻击。\n",
});

string query_parry_msg(object weapon)
{
       
   return parry_msg[random(sizeof(parry_msg))];
        
}
int learn_bonus()
{
        return 10;
}
int practice_bonus()
{
        return 5;
}
int black_white_ness()
{
        return -10;
}

