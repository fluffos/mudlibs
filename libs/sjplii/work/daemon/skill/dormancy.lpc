// dormancy.c 修养术

#include <ansi.h>

inherit SKILL;

string type() { return "knowledge"; }
string skill_cname()
{
	return "修养术";
}

void skill_improved(object me)
{
	int s;

	s = me->query_skill("dormancy", 1);
	if((int)me->query("tol") < s/4) {
		tell_object(me, HIW "由於你的勤学修养术，你的气量提高了。\n" NOR);
		me->add("tol", 1);
	}
}

int learn_bonus()
{
	return 0;
}
int practice_bonus()
{
	return 0;
}
int black_white_ness()
{
	return 0;
}

