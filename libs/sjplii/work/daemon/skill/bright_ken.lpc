// bright_ken.c  光明拳    baiwt@sjpl 12,10,1999
#include <ansi.h>

inherit SKILL;
string skill_cname() {
  return "光明拳";
}

mapping *action = ({
  ([ "action": "$N盘膝而坐，二手合十，一式「莲花座」，双拳蓄势而发，击向$n的$l",
    "dodge": -10,
    "parry": 100,
    "force": 250,
    "post_action": (: call_other, WEAPON_D, "bash_weapon" :),
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N一式「烈火锥」，双掌轮流下击，拳势如焰，吡啪爆响！",
    "dodge": -10,
    "parry": 40,
    "force": 300,
    "post_action": (: call_other, WEAPON_D, "bash_weapon" :),
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N腾空飞起，一式「八方雨」，双手双腿齐出，令$n无可躲藏",
    "dodge": -60,
    "parry": -10,
    "force": 200,
    "post_action": (: call_other, WEAPON_D, "bash_weapon" :),
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N双掌虚含，掌缘下沉，一式「掌心雷」，缓缓向$n推出",
    "dodge": 20,
    "parry": 30,
    "force": 300,
    "post_action": (: call_other, WEAPON_D, "bash_weapon" :),
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N一臂前伸，一臂后指，一式「五指山」，攻向$n的身前身后",
    "dodge": 10,
    "parry": 10,
    "force": 200,
    "post_action": (: call_other, WEAPON_D, "bash_weapon" :),
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N一式「观音渡」，两手十指虚点$n的全身三十六道要穴",
    "dodge": -30,
    "parry": -40,
    "force": 180,
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N两目内视，双手内笼，一式「天龙唱」，四面八方响起震人心魄的龙吟",
    "dodge": -40,
    "parry": -40,
    "force": 500,
    "post_action": (: call_other, WEAPON_D, "bash_weapon" :),
    "damage_type": "瘀伤"
  ]),
  ([ "action": "$N似笑非笑，双拳无形无定，一式「如来笑」，骤然击向$n的$l",
    "dodge": -30,
    "parry": 20,
    "force": 200,
    "post_action": (: call_other, WEAPON_D, "bash_weapon" :),
    "damage_type": "瘀伤"
  ]),

});


int valid_learn(object me) {
  if ((int)me->query("force") < (int)me->query_skill("bright_ken") * 25)
    return notify_fail("你的内力不够，无法修习更高深的光明拳。\n");
  if (me->query_temp("weapon") || me->query_temp("secondary_weapon"))
    return notify_fail("练光明拳必须空手。\n");
  return 1;
}

int valid_enable(string usage) {
  return usage == "unarmed";
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}
string *parry_msg = ({
  "$n以守为攻，猛击$N握$w的手腕。\n",
});

string *unarmed_parry_msg = ({
  "$n左拳击下，右拳自保，将$N封于尺外。\n",

});

string query_parry_msg(object weapon) {
  if (weapon)
    return parry_msg[random(sizeof(parry_msg))];
  else
    return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}

int effective_level() { return 25; }

int learn_bonus() {
  return -100;
}
int practice_bonus() {
  return -100;
}
int black_white_ness() {
  return -200;
}

int practice_skill(object me) {

  if ((int)me->query("kee") < 40)
    return notify_fail("你的体力不够练, 还是先休息休息吧。\n");
  me->receive_damage("kee", 40);
  return 1;
}
mixed hit_ob(object me, object victim, int damage_bonus) {
  if (me->query_skill_mapped("force") != "luohan_force") return 0;
  if (damage_bonus < 50) return 0;
  if (random(damage_bonus / 2) > random(victim->query_str())) {
    victim->receive_wound("kee", (damage_bonus - 1) * 3 / 2);
    switch (random(3)) {
      case 0: return YEL "\n$N低诵佛号，一拳缓缓而出，平淡之中蕴涵无数变化，似乎便是旷世绝招［正大光明］！\n" NOR;
      case 1: return YEL "\n$N拳风拂过，忽然带起一团金光，光芒眨眼间遍布$n全身，似乎就是传说中的［万丈佛光］！\n" NOR;
      case 2: return YEL "\n只听见$N双拳合抱成圆，呼地一声将圆圈中积蓄的内力一并推出，气势宏大的劲力向$n源源涌来！\n" NOR;
    }
  }
}
void skill_improved(object me) {
  if ((int)me->query_skill("bright_ken", 1) % 10 == 0) {
    tell_object(me,
      YEL "\n你渐渐觉得心中了无杂念，似乎禅悟了佛偈....\n\n" NOR);
    me->set("bellicosity", 0);
  } else
    me->set("bellicosity", 0);
}
string perform_action_file(string action) {
  return CLASS_D("shaolin") + "/strike/bright_ken/" + action;
}
