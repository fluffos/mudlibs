// 杂阿含功

inherit SKILL;
#include <ansi.h>
string skill_cname()
{
	return "杂阿含功";
}

void skill_improved(object me)
{
        int s;

        s = me->query_skill("zaahan_gong", 1);
        if( (int)me->query("spi") < s/5) {
                tell_object(me, HIW "由於你勤练杂阿含功，你的灵性提高了。\n" NOR);
                me->add("spi", 1);
        }
}
int learn_bonus()
{
	return 0;
}
int practice_bonus()
{
	return 0;
}
int black_white_ness()
{
	return 0;
}

