//碧血心法

inherit FORCE;

int valid_enable(string usage) { return usage=="force"; }
string skill_cname()
{
	return "碧血心法";
}

int valid_learn(object me)
{
        return 1;
}
string force_type() { return "all_force"; }

int practice_skill(object me)
{
        return notify_fail("碧血心法只能用学的，或是从运用(exert)中增加熟练度。\n");
}

string exert_function_file(string func)
{
        return CLASS_D("guanfu") + "/bixueforce/" + func;
}
int effective_level() { return 15;}

int learn_bonus()
{
        return 7;
}
int practice_bonus()
{
        return 5;
}
int black_white_ness()
{
        return 25;
}

