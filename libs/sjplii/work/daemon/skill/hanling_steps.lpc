// 寒灵步法

inherit SKILL;
string skill_cname() {
  return "寒灵步法";
}

string *dodge_msg = ({
  "只见$n身影一晃，早已避在七尺之外。\n",
  "$n身体向后一仰，轻轻松松地闪过。\n",
  "$n左足一点，腾空而起，避了开去。\n",
  "可是$n斜侧身子，轻轻避了开去。\n",
  "$n向后跃开三尺，轻轻闪过。\n",
});

int valid_enable(string usage) {
  return (usage == "dodge") || (usage == "move");
}

int valid_learn(object me) {
  if ((int)me->query("max_force") < 200)
    return notify_fail("你的内力不够，没有办法练寒灵步法。\n");

  return 1;
}

string query_dodge_msg(string limb) {
  return dodge_msg[random(sizeof(dodge_msg))];
}

int practice_skill(object me) {
  if ((string)me->query_skill_mapped("force") != "hanling_force")
    return notify_fail("寒灵剑法必须配合寒灵心法才能练习。\n");
  if ((int)me->query("kee") < 30
    || (int)me->query("force") < 3)
    return notify_fail("你的气或内力不够，不能练寒灵步法。\n");
  me->receive_damage("kee", 30);
  me->add("force", -3);
  return 1;
}
string perform_action_file(string action) {
  return CLASS_D("gaibang") + "/hanlu_sword/" + action;
}
int effective_level() { return 15; }
