// 青云杖法,qingyun_stick

inherit SKILL;
string skill_cname() {
  return "青云杖法";
}

mapping *action = ({
  ([ "action":
    "$N使一招「云天雾地」，手中$w扫向$n下盘！",
    "damage": 90,
    "dodge": 20,
    "parry": -40,
    "damage_type": "挫伤"
  ]),
  ([ "action":
    "$N挥起$w，一招「乌云滚滚」攻向$n$l！",
    "damage": 60,
    "dodge": 10,
    "parry": -60,
    "damage_type": "挫伤"
  ]),
  ([ "action":
    "$N横过手中$w，使出「云海茫茫」击向$n$l！",
    "damage": 30,
    "dodge": 40,
    "parry": -40,
    "damage_type": "挫伤"
  ]),
  ([ "action":
    "$N使出一招「游龙穿云」，$w一挺撞向$n$l！",
    "damage": 80,
    "dodge": 20,
    "parry": -40,
    "damage_type": "挫伤"
  ]),
  ([ "action":
    "$N深吸一口气，使出青云杖法绝学「青云遮日」，$w挥舞成几道青光击向$n$l！",
    "damage": 160,
    "dodge": 40,
    "parry": -50,
    "damage_type": "挫伤"
  ]),
});

int valid_learn(object me) {
  if ((int)me->query("max_force") < 100)
    return notify_fail("你的内力修为不足，无法修习青云杖法。\n");
  return 1;
}

int valid_enable(string usage) {
  return (usage == "stick") || (usage == "parry");
}

mapping query_action(object me, object weapon) {
  return action[random(sizeof(action))];
}

int practice_skill(object me) {
  object weapon;

  if (!objectp(weapon = me->query_temp("weapon"))
    || (string)weapon->query("skill_type") != "stick")
    return notify_fail("你必须先找一根木杖或者是类似的武器，才能练杖法。\n");

  if ((string)me->query_skill_mapped("force") != "canyun_force")
    return notify_fail("必须配风卷残云功才能练青云杖法。\n");

  if ((int)me->query_skill("begging", 1) / 2 < (int)me->query_skill("qingyun_stick", 1) / 3)
    return notify_fail("丐帮以乞讨为本，先修习乞讨术吧。\n");

  if ((int)me->query("kee") < 20)
    return notify_fail("你的体力不够练这门棒法，还是先休息休息吧。\n");
  me->receive_damage("kee", 20);
  return 1;
}
string *parry_msg = ({
  "只听见「锵」一声，$n手中的$v荡开了$N的$w。\n",
  "$n挥动手中$v连消带打，令$N的$w无法靠近。\n",
  "$n手中的$v化做一团青光，荡开了$N的$w。\n",
  "结果「当」地一声，被$n手中的$v格开了。\n",
});

string *unarmed_parry_msg = ({
  "$n将手中的$v舞得密不透风，封住了$N的攻势。\n",
  "$n不退反进，$v直刺$N的双手。\n",
  "$n将手中的$v一抖，迫得$N连连后退。\n",
});

string query_parry_msg(object weapon) {
  if (weapon)
    return parry_msg[random(sizeof(parry_msg))];
  else
    return unarmed_parry_msg[random(sizeof(unarmed_parry_msg))];
}

string perform_action_file(string action) {
  return CLASS_D("gaibang") + "/qingyun_stick/" + action;
}
int effective_level() { return 15; }

int learn_bonus() {
  return 10;
}
int practice_bonus() {
  return 5;
}
int black_white_ness() {
  return -10;
}
