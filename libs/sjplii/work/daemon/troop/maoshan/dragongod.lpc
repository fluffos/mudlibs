// taoist_guard.c  by baiwt@sjpl 5,17,2000
//法术：［布云补天符］ 属性：heal  对象：me  克星：无
//法术：［冰火风雷破］ 属性：attack  对象：all  克星：无
//法术：［双龙戏珠］ 属性：busy8  对象：all  克星：无
#include <ansi.h>
inherit NPC;
int magic_more(object who);

void create() {
  set_name("龙王", ({ "dragon god", "taoist guard" }));
  set("gender", "男性");
  set("age", 80);
  set("attitude", "peaceful");
  set("long", "天界之龙神，掌管四海之龙宫。\n");

  set("mguard", "mguard59");
  set("mguard_level", 59);
  set("magic_power", 3000);

  set("str", 92);
  set("cor", 52);
  set("cps", 22);

  set("max_kee", 7000);
  set("max_gin", 7000);
  set("max_sen", 7000);
  set("max_mana", 3000);
  set("mana", 3000);

  set("combat_exp", 10000000);
  set_skill("dodge", 200);
  set("chat_chance_combat", 90);
  set("chat_msg_combat", ({
    (: magic_more(this_object()) :),
  }));
  set_temp("super_damage", 86400 * 7);
  set_temp("apply/attack", 20);
  set_temp("apply/damage", 20);
  set_temp("apply/defence", 20);
  set_temp("apply/armor", 20);
  setup();

}
int magic_more(object who) {
  int i, mwp;
  object *enemy, mygod;
  seteuid(getuid());
  enemy = who->query_enemy();
  mwp = who->query("magic_power");
  i = sizeof(enemy);
  while (i--) {
    if (enemy[i] && living(enemy[i])) {
      if (who->query("mana") < 50) return 1;
      if (who->query("kee") < who->query("max_kee") * 3 / 4) {
        message_vision(HIC "\n$N挥手变出一张符纸，缓缓飘上天空。" NOR, who);
        message_vision(HIC "\n$N发出长啸，刹那间半空四周回响，那符纸化做一层厚厚云层！" NOR, who);
        message_vision(HIC "\n云层越积越多，$N转眼被云层包围，伤口都痊愈了。\n" NOR, who);
        message_vision(HIG "［布云补天符］！\n\n" NOR, who);
        who->receive_curing("kee", mwp);
        who->receive_heal("kee", mwp);
        who->receive_curing("sen", mwp);
        who->receive_heal("sen", mwp);
        if (who->query("mana") >= 50)
          who->add("mana", -50);
        COMBAT_D->report_status(who, 1);
        return 1;
      }

      if (random(9) < 6) {
        if (!objectp(present("cloud god", environment(who)))) {
          mygod = new("/daemon/troop/maoshan/cloudgod");
          message_vision(HIC "\n$N喃喃念动咒语，只见一张符纸缓缓飘上半空。" NOR, who, enemy[i]);
          message_vision(HIC "\n不久只见天上云层滚滚，遮天蔽日，天色立时变了！" NOR, who, enemy[i]);
          message_vision(HIC "\n随着一声闷雷响过，雷神的身影渐渐在云层中浮现出来。\n" NOR, who, enemy[i]);
          message_vision(HIG "［祭云符］！\n\n" NOR, who, enemy[i]);
          mygod->move(environment(who));
          if (who->query("mana") >= 50)
            who->add("mana", -50);
          return 1;
        }
        if (!objectp(present("fire god", environment(who)))) {
          mygod = new("/daemon/troop/maoshan/firegod");
          message_vision(RED "\n$N喃喃念动咒语，只见一张符纸缓缓飘上半空。" NOR, who, enemy[i]);
          message_vision(RED "\n不久只见空中热气翻腾，火光乍现，眨眼间满地升起熊熊燃烧的火焰，" NOR, who, enemy[i]);
          message_vision(RED "\n火神的身影渐渐在火光中浮现出来。\n" NOR, who, enemy[i]);
          message_vision(HIG "［祭火符］！\n\n" NOR, who, enemy[i]);
          mygod->move(environment(who));
          if (who->query("mana") >= 50)
            who->add("mana", -50);
          return 1;
        }
        if (!objectp(present("wind god", environment(who)))) {
          mygod = new("/daemon/troop/maoshan/windgod");
          message_vision(HIW "\n$N喃喃念动咒语，只见一张符纸缓缓飘上半空。" NOR, who, enemy[i]);
          message_vision(HIW "\n不久只见四周狂风大作，风声呜呜作响，吹得人气也喘不过来。" NOR, who, enemy[i]);
          message_vision(HIW "\n随着大风愈刮愈烈，风神的身影渐渐在半空中浮现出来。\n" NOR, who, enemy[i]);
          message_vision(HIG "［祭风符］！\n\n" NOR, who, enemy[i]);
          mygod->move(environment(who));
          if (who->query("mana") >= 50)
            who->add("mana", -50);
          return 1;
        }
        if (!objectp(present("water god", environment(who)))) {
          mygod = new("/daemon/troop/maoshan/watergod");
          message_vision(HIC "\n$N喃喃念动咒语，只见一张符纸缓缓飘上半空。" NOR, who, enemy[i]);
          message_vision(HIC "\n不久只见地上哗啦啦地冒出了水花，水越涌越多，眨眼汇成了一条浅河！" NOR, who, enemy[i]);
          message_vision(HIC "\n随着水花渐渐升高，洛神的身影在水中浮现出来。\n" NOR, who, enemy[i]);
          message_vision(HIG "［祭水符］！\n\n" NOR, who, enemy[i]);
          mygod->move(environment(who));
          mygod->set("player_guard", who->query("id"));
          if (who->query("mana") >= 50)
            who->add("mana", -50);
          return 1;
        }

        message_vision(HIR "\n$N喃喃念动咒语，突然间摇身一变，变做一条神龙！" NOR, who, enemy[i]);
        message_vision(HIR "\n神龙借着水、火、风、雷诸神之势，发出一声霹雳巨响直扑向$n！\n" NOR, who, enemy[i]);
        message_vision(HIG "［冰火风雷破］！\n\n" NOR, who);
        if (random(enemy[i]->query("magic_defense")) < random(1000)) {
          enemy[i]->receive_wound("kee", enemy[i]->query("max_sen"), who);
          enemy[i]->skill_enable_none();
          enemy[i]->reset_action();
        }
        if (who->query("mana") >= 50)
          who->add("mana", -50);
        COMBAT_D->report_status(enemy[i], 1);
      } else if (random(enemy[i]->query("magic_defense")) < 1000 && !enemy[i]->is_busy()) {
        message_vision(HIM "\n$N喃喃念动咒语，不久只听见两声龙吟从东、南两海传来，" NOR, who, enemy[i]);
        message_vision(HIM "\n随着天色骤变，两条巨龙自云层扑下，绕着$n游斗。\n" NOR, who, enemy[i]);
        message_vision(HIG "［双龙戏珠］！\n\n" NOR, who);
        enemy[i]->start_busy(8);
        if (who->query("mana") >= 50)
          who->add("mana", -50);
        COMBAT_D->report_status(enemy[i], 1);
      }
      if (!who->query_soft_powerup())
        who->soft_powerup(30, 30);
    }
  }
  return 1;
}

int heal_up() {
  object mguard = this_object();
  if (!present(
    (string)mguard->query("player_guard"),
    environment(mguard)
  ) && !userp(environment(mguard))) {
    call_out("leave", 1);
    return 1;
  }
  return ::heal_up() + 1;
}

void leave() {
  message("vision",
    HIW + name() + "的身影渐渐虚化，变做了一道白烟。\n\n"
    "白烟随风飘散，很快消失了......\n" NOR, environment(),
    this_object());
  destruct(this_object());
}

void die() {
  object who;
  seteuid(getuid());
  who = this_object();
  if (who->query_temp("already_die") < 3) {
    message_vision(HIW "\n$N挥手变出一张符纸，缓缓飘上天空。" NOR, who);
    message_vision(HIW "\n$N发出长啸，刹那间半空四周回响，那符纸化做一层厚厚云层！" NOR, who);
    message_vision(HIW "\n云层越积越多，$N转眼被云层包围，伤口都痊愈了。\n" NOR, who);
    message_vision(HIG "［布云补天符］！\n\n" NOR, who);
    who->receive_curing("kee", 3000);
    who->receive_heal("kee", 3000);
    who->receive_curing("sen", 3000);
    who->receive_heal("sen", 3000);
    who->receive_curing("gin", 3000);
    who->receive_heal("gin", 3000);
    who->add_temp("already_die", 1);
    who->remove_busy();
    if (!who->query_soft_powerup())
      who->soft_powerup(30, 30);

  } else
    ::die();
}
