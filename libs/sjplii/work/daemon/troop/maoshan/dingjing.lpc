// taoist_guard.c  by baiwt@sjpl 5,17,2000
//法术：［大禹铸鼎］ 属性：heal  对象：me  克星：无
#include <ansi.h>
inherit NPC;
int magic_more( object who);

void create()
{
        set_name("鼎精", ({ "dingjing", "taoist guard" }) );
	set("gender", "男性");
	set("age", 70);
        set("attitude", "peaceful");

 	set("mguard", "mguard52");
 	set("mguard_level", 52);
	set("magic_power", 3000);

	set("str", 72);
	set("cor", 52);
	set("cps", 22);

	set("max_kee", 6000);
	set("max_gin", 6000);
	set("max_sen", 6000);
	set_skill("iron-cloth",400);
	set_skill("unarmed",200);
        set_skill("dodge", 200);
        set("combat_exp", 1000000);
	set("max_mana", 3000);
	set("mana", 3000);

        set("chat_chance_combat", 50);
        set("chat_msg_combat", ({
		(: magic_more(this_object()) :),
        }) );
	set_temp("super_damage",86400*7);

        set_temp("apply/iron-cloth", 700);
        set_temp("apply/damage", 20);
	set_temp("apply/defence",20);
	set_temp("apply/armor",20);
	setup();

}
int magic_more(object who)
{
	int i, mwp;
	object *enemy;
	seteuid(getuid());
	enemy = who->query_enemy();
	mwp = who->query("magic_power");
	i = sizeof(enemy);
	while(i--) {
		if( enemy[i] && living(enemy[i]) ) {
			if( who->query("mana") < 50 )  return 1;
	if( who->query("kee") < who->query("max_kee")*3/4 )
	{
	message_vision(HIC"\n$N旁边渐渐显出一个巨大的赤膊人影。"NOR,who);
	message_vision(HIC"\n大禹抡起铁锤和火碳对着$N的破损处叮叮当当地浇铸起来！"NOR,who);
	message_vision(HIC"\n$N眨眼被修复如初，大禹冷哼一声，转瞬消失了。\n"NOR,who);
	message_vision(HIG"［大禹铸鼎］！\n\n"NOR,who);
       who->receive_curing("kee", 5000);
       who->receive_heal("kee", 5000);
       who->receive_curing("sen", 5000);
       who->receive_heal("sen", 5000);
       who->receive_curing("gin", 5000);
       who->receive_heal("gin", 5000);
	if( who->query("mana") >= 50 )
	who->add("mana", -50);
	COMBAT_D->report_status(who,1);
	 return 1;
	}
	enemy[i]->set_delay(3);
		}
	}
	return 1;
}

int heal_up()
{
	object mguard=this_object();
	if( !present((string)mguard->query("player_guard"),environment(mguard)) && !userp(environment(mguard)) )
	{
		call_out("leave", 1);
		return 1;
	}
	return ::heal_up() + 1;
}

void leave()
{
	message("vision",
		 HIW + name() + "的身影渐渐虚化，变做了一道白烟。\n\n"
		 "白烟随风飘散，很快消失了......\n"NOR , environment(),
		this_object() );
	destruct(this_object());
}

void die()
{
	object who;
	seteuid(getuid());
	who = this_object();
	if( who->query_temp("already_die") < 3 )
	{
	message_vision(HIY"\n$N旁边渐渐显出一个巨大的赤膊人影。"NOR,who);
	message_vision(HIY"\n大禹抡起铁锤和火碳对着$N的破损处叮叮当当地浇铸起来！"NOR,who);
	message_vision(HIY"\n$N眨眼被修复如初，大禹冷哼一声，转瞬消失了。\n"NOR,who);
	message_vision(HIG"［大禹铸鼎］！\n\n"NOR,who);
       who->receive_curing("kee", 6000);
       who->receive_heal("kee", 6000);
       who->receive_curing("sen", 6000);
       who->receive_heal("sen", 6000);
       who->receive_curing("gin", 6000);
       who->receive_heal("gin", 6000);
	who->add_temp("already_die",1);
	who->remove_busy();
	}
	else
	::die();
}
