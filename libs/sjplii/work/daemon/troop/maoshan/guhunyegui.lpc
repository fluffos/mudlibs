//法术：［无］ 属性：heal  对象：me  克星：无
#include <ansi.h>
inherit NPC;
int magic_more( object who);

void create()
{
        set_name("孤魂野鬼", ({ "guhunyegui", "taoist guard" }) );
	set("gender", "男性");
	set("age", 20);
        set("attitude", "peaceful");

 	set("mguard", "mguard0");
 	set("mguard_level", 1);
	set("magic_power", 10);

	set("str", 32);
	set("cor", 52);
	set("cps", 22);

	set("max_kee", 1000);
	set("max_gin", 1000);
	set("max_sen", 1000);

        set("combat_exp", 10000);
        set_skill("dodge", 100);

        set_temp("apply/attack", 20);
        set_temp("apply/damage", 20);
	set_temp("apply/defence",20);
	set_temp("apply/armor",20);
	setup();

}

int heal_up()
{
	object mguard=this_object();
	if( !present((string)mguard->query("player_guard"),environment(mguard)) && !userp(environment(mguard)) )
	{
		call_out("leave", 1);
		return 1;
	}
	return ::heal_up() + 1;
}

void leave()
{
	message("vision",
		 HIW + name() + "的身影渐渐虚化，变做了一道白烟。\n\n"
		 "白烟随风飘散，很快消失了......\n"NOR , environment(),
		this_object() );
	destruct(this_object());
}

