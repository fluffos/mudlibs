//法术：［十步矢］ 属性：attack  对象：all  克星：无
#include <ansi.h>
inherit NPC;
int magic_more(object who);

void create() {
  set_name("草柜", ({ "caogui", "jiguan guard" }));
  set("race", "野兽");
  set("gender", "雄性");
  set("age", 20);
  set("attitude", "peaceful");

  set("jgguard", "jgguard3");
  set("jgguard_level", 3);
  set("magic_power", 1300);
  set("jgguard_attrib", "物类");

  set("str", 42);
  set("cor", 52);
  set("cps", 22);

  set("max_kee", 1000);
  set("max_gin", 1000);
  set("max_sen", 1000);
  set("max_mana", 500);
  set("mana", 1000);

  set("limbs", ({ "头部", "身体", "爪子", "尾巴" }));
  set("verbs", ({ "claw" }));

  set("combat_exp", 1000000);
  set_skill("dodge", 200);
  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: magic_more(this_object()) :),
  }));

  set_temp("apply/attack", 20);
  set_temp("apply/damage", 20);
  set_temp("apply/defence", 20);
  set_temp("apply/armor", 20);
  setup();

}
int magic_more(object who) {
  int i, mwp;
  object *enemy;
  seteuid(getuid());
  enemy = who->query_enemy();
  mwp = who->query("magic_power");
  i = sizeof(enemy);
  while (i--) {
    if (enemy[i] && living(enemy[i])) {
      if (who->query("mana") < 50) return 1;
      message_vision(HIR "\n$N发出一阵嘎嘎的响声，柜门突然打了开来，从柜里哧哧地" NOR, who, enemy[i]);
      message_vision(HIR "\n射出无数细利的短箭，如飞蝗般朝$n射了过来。\n" NOR, who, enemy[i]);
      message_vision(HIG "［十步矢］！\n\n" NOR, who);
      if (random(enemy[i]->query("magic_defense")) < random(500))
        enemy[i]->receive_wound("kee", mwp);
      if (who->query("mana") >= 50)
        who->add("mana", -50);
      COMBAT_D->report_status(enemy[i], 1);
    }
  }
  return 1;
}

int heal_up() {
  object jgguard = this_object();
  if (!present((string)jgguard->query("player_guard"), environment(jgguard))
    && environment(jgguard)->query("outdoors") != "taoyuan") {
    call_out("leave", 1);
    return 1;
  }
  return ::heal_up() + 1;
}

void leave() {
  message("vision",
    HIW + name() + "发出一阵嘎嘎的响声，一股焦烟升了起来。\n\n"
    "焦烟越来越浓，很快将" + name() + "化为了灰烬......\n" NOR, environment(),
    this_object());
  destruct(this_object());
}
