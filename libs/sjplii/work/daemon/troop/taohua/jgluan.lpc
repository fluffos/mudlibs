//法术：［无］ 属性：heal  对象：me  克星：无
#include <ansi.h>
inherit NPC;
int magic_more(object who);

void create() {
  set_name("机关卵", ({ "jgluan", "jiguan guard" }));
  set("gender", "男性");
  set("age", 20);
  set("attitude", "peaceful");

  set("jgguard", "jgguard0");
  set("jgguard_level", 1);
  set("magic_power", 10);
  set("jgguard_attrib", "物类");

  set("str", 32);
  set("cor", 52);
  set("cps", 22);

  set("max_kee", 1000);
  set("max_gin", 1000);
  set("max_sen", 1000);

  set("combat_exp", 10000);
  set_skill("dodge", 100);

  set_temp("apply/attack", 20);
  set_temp("apply/damage", 20);
  set_temp("apply/defence", 20);
  set_temp("apply/armor", 20);
  setup();

}

int heal_up() {
  object jgguard = this_object();
  if (!present((string)jgguard->query("player_guard"), environment(jgguard))
    && environment(jgguard)->query("outdoors") != "taoyuan") {
    call_out("leave", 1);
    return 1;
  }
  return ::heal_up() + 1;
}

void leave() {
  message("vision",
    HIW + name() + "发出一阵嘎嘎的响声，一股焦烟升了起来。\n\n"
    "焦烟越来越浓，很快将" + name() + "化为了灰烬......\n" NOR, environment(),
    this_object());
  destruct(this_object());
}
