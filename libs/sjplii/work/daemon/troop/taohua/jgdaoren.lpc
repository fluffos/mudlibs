// taoist_guard.c  by baiwt@sjpl 5,17,2000
//法术：［寒风冻气符］ 属性：attack  对象：all  克星：无
//法术：［茶香符］ 属性：heal  对象：me  克星：无
#include <ansi.h>
inherit NPC;
int magic_more(object who);

void create() {
  set_name("机关道人", ({ "jgdaoren", "jiguan guard" }));
  set("gender", "男性");
  set("age", 30);
  set("attitude", "peaceful");

  set("jgguard", "jgguard26");
  set("jgguard_level", 26);
  set("magic_power", 3000);
  set("jgguard_attrib", "人类");

  set("str", 42);
  set("cor", 52);
  set("cps", 22);

  set("max_kee", 1000);
  set("max_gin", 1000);
  set("max_sen", 1000);
  set("max_mana", 500);
  set("mana", 1000);

  set("combat_exp", 1000000);
  set_skill("dodge", 200);
  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: magic_more(this_object()) :),
  }));
  set_temp("super_damage", 86400 * 7);

  set_temp("apply/attack", 20);
  set_temp("apply/damage", 20);
  set_temp("apply/defence", 20);
  set_temp("apply/armor", 20);
  setup();

}
int magic_more(object who) {
  int i, mwp;
  object *enemy, mygod;
  seteuid(getuid());
  enemy = who->query_enemy();
  mwp = who->query("magic_power");
  i = sizeof(enemy);
  while (i--) {
    if (enemy[i] && living(enemy[i])) {
      if (who->query("mana") < 50) return 1;
      if (who->query("kee") < who->query("max_kee") * 3 / 4) {
        message_vision(HIC "\n$N喃喃念动咒语，只见一张符纸缓缓飘上半空。" NOR, who, enemy[i]);
        message_vision(HIC "\n转眼间符纸化作一片片茶叶，飘落在$n损坏的部件之上。" NOR, who, enemy[i]);
        message_vision(HIC "\n不久那些部件都自动修复了。\n" NOR, who, enemy[i]);
        message_vision(HIG "［茶香符］！\n\n" NOR, who);
        who->receive_curing("kee", mwp);
        who->receive_heal("kee", mwp);
        who->receive_curing("sen", mwp);
        who->receive_heal("sen", mwp);
        if (who->query("mana") >= 50)
          who->add("mana", -50);
        COMBAT_D->report_status(who, 1);
        return 1;
      }
      if (!objectp(present("wind god", environment(who)))) {
        mygod = new("/daemon/troop/maoshan/windgod");
        message_vision(HIC "\n$N喃喃念动咒语，只见一张符纸缓缓飘上半空。" NOR, who, enemy[i]);
        message_vision(HIC "\n不久只见四周狂风大作，风声呜呜作响，吹得人气也喘不过来。" NOR, who, enemy[i]);
        message_vision(HIC "\n随着大风愈刮愈烈，风神的身影渐渐在半空中浮现出来。\n" NOR, who, enemy[i]);
        message_vision(HIG "［祭风符］！\n\n" NOR, who, enemy[i]);
        mygod->move(environment(who));
        if (who->query("mana") >= 50)
          who->add("mana", -50);
        return 1;
      }
      message_vision(HIR "\n$N喃喃念动咒语，只见一张符纸缓缓飘上半空。" NOR, who, enemy[i]);
      message_vision(HIR "\n转眼间符纸化作一阵寒风，兜头盖脸朝$n刮了过去。\n" NOR, who, enemy[i]);
      message_vision(HIG "［寒风冻气符］！\n\n" NOR, who);
      if (random(enemy[i]->query("magic_defense")) < random(500))
        enemy[i]->receive_wound("kee", mwp, who);
      if (who->query("mana") >= 50)
        who->add("mana", -50);
      COMBAT_D->report_status(enemy[i], 1);
    }
  }
  return 1;
}

int heal_up() {
  object jgguard = this_object();
  if (!present((string)jgguard->query("player_guard"), environment(jgguard))
    && environment(jgguard)->query("outdoors") != "taoyuan") {
    call_out("leave", 1);
    return 1;
  }
  return ::heal_up() + 1;
}

void leave() {
  message("vision",
    HIW + name() + "发出一阵嘎嘎的响声，一股焦烟升了起来。\n\n"
    "焦烟越来越浓，很快将" + name() + "化为了灰烬......\n" NOR, environment(),
    this_object());
  destruct(this_object());
}
