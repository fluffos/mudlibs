//法术：［无］ 属性：heal  对象：me  克星：无
#include <ansi.h>
inherit NPC;

void create()
{
	string *mname = ({
	"老鼠","大老鼠","小老鼠","巨鼠",
	"黑鼠","白鼠","灰鼠","地鼠",
			});
        set_name(mname[random(7)+1], ({ "mouse", "jiguan guard" }) );
	set("race", "野兽");
	set("gender", "雄性");
	set("age", 20);
        set("attitude", "peaceful");
	set("long",
		"这是一只老鼠，你可以试着抓住它（catch）。\n");
// 	set("jgguard", "jgguard00");
 	set("jgguard_level", 1);
 	set("jgguard_attrib", "兽类");
	set("magic_power", 10);
        set("limbs", ({ "头部", "身体", "七寸", "尾巴" }) );
        set("verbs", ({ "bite" }) );

	set("str", 32);
	set("cor", 52);
	set("cps", 22);

	set("max_kee", 300);
	set("max_gin", 300);
	set("max_sen", 300);

        set("combat_exp", 2000);
        set_skill("dodge", 200);
//        set("chat_chance", 20);
//        set("chat_msg", ({
//                (: random_move :)
//        }) );

        set_temp("apply/attack", 20);
        set_temp("apply/damage", 20);
	set_temp("apply/defence",20);
	set_temp("apply/armor",20);
	setup();

}

void init()
{
   add_action("do_catch", "catch");
}
int do_catch(string arg)
{
   object ob, me;
   me = this_player();
   ob = this_object();
   if(!arg || arg != "鼠" && arg != "mouse" ) return 0;
	if( random(me->query("kee")) < random(me->query("max_kee")) )
	{
      message_vision("$N往前一扑 , 双手合拢一把抓住了$n, 轻轻放入怀中。 \n", me,ob); 
	if( !me->query_troop("jgguard00",1) )
	me->set_troop("jgguard00",1);
      destruct(ob);
   return 1;
	}
	else{
      message_vision("$N往前一扑 , $n向前一钻 , 从$N的脚边飞快的溜了过去。 \n", me,ob); 
      message_vision("$n吱吱地叫了几声，转眼钻入洞里不见了。 \n", me,ob); 
      destruct(ob);
	}
   return 1;
}


