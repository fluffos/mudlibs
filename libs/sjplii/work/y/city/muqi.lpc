//changan city

inherit ROOM;

void create ()
{
        set ("short", "西门木器铺");
        set ("long", @LONG
此处是西门木器铺。一进门，就能看见不少木工伙计正在努力的工作。
他们的旁边站着一位衣着很普通的年轻人。你可不要小看他，他就是京城赫
赫有名的赛鲁班刘衡，他所制作的木器经久耐用，手工细致。城里的大姑娘
要出嫁，不关你是王公贵族，还是平头百姓，嫁妆里肯定都有这出产的木器。
LONG);

        //set("item_desc", ([" *** " : " *** ", ]));

        set("exits", 
        ([ //sizeof() == 4
                "east" : __DIR__"qinglong-n2",
        ]));

        set("objects", 
        ([ //sizeof() == 1
                __DIR__"npc/muqi_boss" : 1,
        ]));

	set("no_clean_up", 0);
        setup();
	replace_program(ROOM);
}


