//changan city

inherit ROOM;

void create() {
  set("short", "青龙大街");
  set("long", @LONG

你走在一条宽阔的石板大街上，这是青龙大街的北段，东面是一片
民宅，西面是一家大的妓院，名为春风楼，整日达官贵人，风流才子进
进出出，十分热闹。往北是一所绎站，是长安居民送信收信的地方。
LONG);

  //set("item_desc", ([" *** " : " *** ", ]));

  set("exits",
    ([  //sizeof() == 4
    "south": __DIR__ "qinglong-n2",
      "north": __DIR__ "yizhan",
      "east": __DIR__ "minzhai2",
      "west": __DIR__ "jiyuan/dating",
    ]));

  set("objects",
    ([  //sizeof() == 1
    NPC_DIR "people/oldman": 1,
      NPC_DIR "people/oldwoman": 1,
    ]));


  set("outdoors", "changan");
  set("no_clean_up", 0);
  setup();
}
