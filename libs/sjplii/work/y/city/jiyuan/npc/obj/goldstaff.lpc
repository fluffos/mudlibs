#include <weapon.h>
#include <ansi.h>
inherit STAFF;

void create() {
  set_name(HIY "五金拐杖" NOR, ({ "gold staff", "staff" }));
  set_weight(7000);
  if (clonep())
    set_default_object(__FILE__);
  else {
    set("unit", "把");
    set("long", "这是一把五金打制的短拐，看上去耀眼生花。\n");
    set("value", 40000);
    set("material", "gold");
    set("wield_msg", "$N把别在腰间的$n拔出握在手中。\n");
    set("unwield_msg", "$N将手中的$n插入腰间。\n");
  }
  init_staff(85);
  setup();
}
