#include <ansi.h>
inherit NPC;
int about_he();
void create()
{
        set_name("中年妇女", ({ "woman"}) );
        set("gender", "女性" );
        set("age", 45);
        set("long",
          "这是一个慈祥的中年妇人\n"
        );
        set("attitude", "friendly");
        set("combat_exp",100);
        set("inquiry", ([
                "help" : (: about_he :),
        ]));
        setup();
        carry_object(__DIR__"obj/cloth")->wear();

}
void init()
{
        object ob;
        ::init();
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
        }
}
void greeting(object ob)
{
        if( !ob || environment(ob) != environment() || ob->query("be_born") >1 ) return;
        command("say 咳，咳咳，咳咳咳．．．\n");
        
}
int about_he()
{
        object me;
        object obj;
	me = this_player();
	if (me->query("be_born") > 0)
		return 0;
          say(CYN"中年妇女微微一笑。\n"NOR);
          say("中年妇女把一件物事塞在你手里，说道：这是我们的家传之物，孩子你收着吧！\n");
          obj = new("/obj/cloth/belt");
          obj->move(me);
	me->add("be_born", 1);
	if( !me->query_skill("move"))
	me->set_skill("move", 3);
          return 1;
}
