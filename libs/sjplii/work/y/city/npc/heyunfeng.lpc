
#include <ansi.h>

inherit NPC;
int about_he();
int about_yang();
void create()
{
	set_name("何云峰", ({ "he yun-feng" }));
	set("long",
	    "这是一个四十五六岁的中年人, 浓眉大眼,\n"+
	    "身穿一件华贵雅致的长袍, 倒使他更显几分精神.\n"+
	    "他位居四大护法之一.\n");
	set("title", "红枫派大侠");
	set("gender", "男性");
	set("age", 46);
	set("nickname", HIC "通天剑客" NOR);
	set("no_shown",1);
	set("attitude", "peaceful");

        set("str", 20);
        set("int", 30);
        set("cor", 20);
        set("cps", 30);
        set("spi", 30);
	set("max_kee", 5000);
	set("max_gin", 5000);
	set("max_sen", 5000);
	set("kee", 5000);
	set("gin", 5000);
	set("sen", 5000);

        set("force", 3000);
        set("max_force", 3000);
        set("force_factor", 50);

        set("atman", 2000);
        set("max_atman", 2000);

        set("mana", 4000);
        set("max_mana", 2000);
        set("mana_factor", 30);

        set("inquiry", ([
                "谷兰香" : (: about_he :),
                "杨兰娇" : (: about_yang :),
        ]));

        set("combat_exp", 10000000);
        set("score", 200000);

      set_skill("literate", 100);
        set_skill("force", 150);
        set_skill("unarmed", 200);
        set_skill("sword", 200);
        set_skill("parry", 200);
        set_skill("dodge", 150);
        set_skill("qidaoforce", 150);
	set_skill("mjsword",250);
        set_skill("shenkong-xing", 150);
//	set_skill("stealing", 200);
	set_skill("liuh-ken",200);
        map_skill("unarmed", "liuh-ken");
        map_skill("force", "qidaoforce");
        map_skill("parry", "mjsword");
        map_skill("sword", "mjsword");
        map_skill("dodge", "shenkong-xing");

        set("chat_chance_combat", 50);
        set("chat_msg_combat", ({
                (: perform_action, "sword.chaotian" :),
                (: exert_function, "recover" :),
        }) );

	create_family("红枫派",2, "弟子");

	setup();
        carry_object("/obj/cloth")->wear();
	carry_object("/obj/longsword")->wield();
	add_money("silver",40);
}

void init()
{	
	object ob;

	::init();
	if( interactive(ob = this_player()) && !is_fighting() ) {
		remove_call_out("greeting");
		call_out("greeting", 3, ob);
	}
}

void greeting(object ob)
{
	int lvl;
	if( !ob || environment(ob) != environment() || ob->query_troop("partner1000")
	 || this_object()->query_quest_time() || ob->query_quest("sjpl_story")>=3 )
       return;
	message_vision("$N走了过来。\n"NOR,this_object());
	message_vision(HIC"$N向$n拱手说道：请问去回春堂的路怎么走？\n"NOR,this_object(),ob);
	message_vision(HIC"$n看了一眼$N，只见他气宇轩昂，相貌不凡，便说道：跟我一起去吧！\n"NOR,this_object(),ob);
	message_vision(HIC"$N躬身说道：多谢！\n"NOR,this_object());
	message_vision("$N加入了$n的队伍。\n"NOR,this_object(),ob);

	// NPC伙伴等级标准设置
	F_TEAM->add_partner_team(ob, "partner1000");

	// 故事相关NPC出现交互的间隔时间
	this_object()->set_quest_time(30);

	// 启动玩家故事情节
	ob->set_quest("sjpl_story",1);
}

int accept_fight(object me)
{
	command("say 请恕何某有要事在身，不能奉陪。");
        return 0;
}
