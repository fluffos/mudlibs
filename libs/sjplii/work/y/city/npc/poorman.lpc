#include <ansi.h>
inherit NPC;
int about_he();
void create()
{
        set_name("穷困农夫", ({ "poorman"}) );
        set("gender", "男性" );
        set("age", 45);
        set("long",
          "这是一个穷困潦倒的中年农夫\n"
        );
        set("attitude", "friendly");
        set("combat_exp",100);
        set("inquiry", ([
                "help" : (: about_he :),
        ]));
        setup();
        carry_object(__DIR__"obj/cloth")->wear();

}
void init()
{
        object ob;
        ::init();
        if( interactive(ob = this_player()) && !is_fighting() ) {
                remove_call_out("greeting");
                call_out("greeting", 1, ob);
        }
}
void greeting(object ob)
{
        if( !ob || environment(ob) != environment() ) return;
        command("say 孩子，你在江湖上闯荡要自己照顾好自己啊！。\n");
        
}
int about_he()
{
        object me;
        object obj, obj2;
	me = this_player();
	if (me->query("be_born") > 0)
		return 0;
          say(CYN"穷困农夫微一摇头。\n"NOR);
          say("穷困农夫叹了口气，说道：孩子，我们家穷，没什么好给你的，全靠你自己了！\n");
          obj = new("/obj/whip");
          obj2 = new("/obj/cloth/shoes");
          obj->move(me);
          obj2->move(me);
	me->add("be_born", 1);
	if( !me->query_skill("parry"))
	me->set_skill("parry", 3);
	if( !me->query_skill("dodge"))
	me->set_skill("dodge", 3);
          return 1;
}
