#include <ansi.h>
inherit NPC;
int about_he();

void create() {
  set_name("红眉老怪", ({ "master hongmei", "master", "hongmei" }));
  set("long",
    "这是一个六十多岁的怪人, 身材魁梧，满脸横肉,\n" +
    "上身赤裸, 只在腰间围了一张虎皮裙.\n" +
    "他年轻时据说还是个美男子，但长期的山野生活已使他变得丑陋无比.\n");
  set("title", "深山野人");
  set("gender", "男性");
  set("age", 64);
  set("nickname", HIG "尸邪" NOR);
  set("shen_type", 1);
  set("attitude", "peaceful");
  create_family("深山野人", 1, "祖师");

  set("str", 50);
  set("int", 30);
  set("cor", 20);
  set("spi", 30);
  set("max_kee", 5000);
  set("max_gin", 5000);
  set("max_sen", 5000);
  set("kee", 5000);
  set("gin", 5000);
  set("sen", 5000);

  set("force", 3000);
  set("max_force", 3000);
  set("force_factor", 50);

  set("atman", 2000);
  set("max_atman", 2000);

  set("mana", 4000);
  set("max_mana", 2000);
  set("mana_factor", 50);

  set("inquiry", ([
    "谷兰香": (: about_he :),
  ]));

  set("combat_exp", 60000000);
  set("score", 200000);

  set_skill("literate", 200);
  set_skill("force", 250);
  set_skill("unarmed", 250);
  set_skill("hammer", 250);
  set_skill("parry", 250);
  set_skill("dodge", 250);
  set_skill("yuanyouforce", 250);
  set_skill("hanshan", 250);
  set_skill("shouquan", 250);
  set_skill("training", 250);
  set_skill("shenkong-xing", 200);

  map_skill("force", "yuanyouforce");
  map_skill("parry", "hanshan");
  map_skill("hammer", "hanshan");
  map_skill("unarmed", "shouquan");
  map_skill("dodge", "shenkong-xing");

  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: perform_action, "hammer.shanbengdilie" :),
  }));


  setup();
  carry_object(__DIR__ "obj/bigtrunk")->wield();
  carry_object(__DIR__ "obj/cloth")->wear();
}

void attempt_apprentice(object me) {
  command("recruit " + me->query("id"));
}

void recruit_apprentice(object ob) {
  if (::recruit_apprentice(ob))
    ob->set("class", "egui");
  ob->set("title", "饿鬼帮帮众");
}


int about_he() {
  command("say 哼，这丫头成天想着何云峰这小子，哪一天让我见着，一定把他撕成两片！\n");
  return 1;
}
int accept_object(object who, object ob) {
  object me;
  if (ob->name() == "獐肉") {
    me = this_player();
    say(CYN "谷扶西点了点头，说道：嗯，这就对了。\n" NOR);
    me->set("marks/谷扶西", 2);
    return 1;
  } else {
    say("谷扶西怒道：你给我什么？快滚！\n");
    return 0;
  }
  return 1;
}
