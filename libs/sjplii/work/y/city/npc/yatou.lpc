inherit NPC;

void create() {
  set_name("小丫头", ({ "yatou" }));
  set("gender", "女性");
  set("age", 15);
  set("long", "一个十五六岁的小丫头，长得挺标致，汗水湿透了薄薄的纱衣，更显出玲珑\n"
    "的曲线。\n");
  set("str", 2);
  set("cor", 30);
  set("cps", 20);
  set("con", 50);
  set("per", 29);
  set("int", 30);
  set("max_kee", 1000);
  set("kee", 20000);
  set("food", 500);
  set("water", 500);
  set("attitude", "peaceful");
  set_temp("apply/defense", 500);
  set_temp("apply/attack", 500);
  set("combat_exp", 2000000);
  set_temp("apply/damage", 300);
  setup();
  //        carry_object("/obj/cloth/color_pants")->wear();
  carry_object(__DIR__ "obj/white_dress")->wear();

}


int accept_fight(object ob) {
  object weapon;
  string skill_type;
  int ob_attack, ob_dodge, ob_parry;

  if (objectp(weapon = ob->query_temp("weapon")))
    skill_type = weapon->query("skill_type");
  else
    skill_type = "unarmed";

  ob_attack = ob->query_skill(skill_type, 0) + ob->query_temp("apply/attack");
  ob_dodge = ob->query_skill("dodge", 0) + ob->query_temp("apply/defense");
  ob_parry = ob->query_skill("parry", 0) + ob->query_temp("apply/defense");

  set("eff_kee", query("max_kee"));
  set("kee", query("max_kee"));
  set("max_force", ob->query("max_force"));
  set("force", ob->query("force"));
  set("combat_exp", ob->query("combat_exp") + 50);
  set_temp("apply/damage", 5);
  if (query("combat_exp") > 200000) {
    set("combat_exp", 2000000);
    set_temp("apply/damage", 500);
  }
  set_temp("apply/attack", ob_dodge + ob_dodge / 20 + 10);
  set_temp("apply/defense", ob_attack + ob_attack / 20 + 10);

  return 1;
}
