//changan city

inherit ROOM;

void create() {
  set("short", "王家包子铺");
  set("long", @LONG
这是一家很破很旧的小店。只有三、两张桌子零乱的摆放着，桌上还粘
着一层厚厚的油垢。墙则早已被油烟熏去了原来的本色。这里不卖其它食物
，只卖包子与自己土酿的烧酒，价格低廉。所以光顾这的人也不多是些有上
顿没下顿的穷人。
LONG);

  //set("item_desc", ([" *** " : " *** ", ]));

  set("exits",
    ([  //sizeof() == 4
    "west": __DIR__ "qinglong-n2",
    ]));

  set("objects",
    ([  //sizeof() == 1
    __DIR__ "npc/baozi_boss": 1,
    ]));


  //        set("outdoors", "changan");
  set("no_clean_up", 0);
  setup();
}
