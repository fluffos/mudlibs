//changan city

inherit ROOM;

void create() {
  set("short", "军校场");
  set("long", @LONG
这是威严肃穆的军校场，足可容纳上万兵马，是军队操练、皇上检阅以
及出征集结誓师之地。校场的四周插满了鲜明整齐的军旗，在风中猎猎作响
。北边搭起一座高台，高大的帅字旗迎风飘扬，旗下有一张虎皮帅椅，椅前
一张檀木桌，上摆各色令箭。
LONG);

  //set("item_desc", ([" *** " : " *** ", ]));

  set("exits",
    ([  //sizeof() == 4
    "west": __DIR__ "baihu-n3",
    ]));

  set("objects",
    ([  //sizeof() == 1
    NPC_DIR "people/army": 4,
    ]));

  set("no_clean_up", 0);
  setup();
}
