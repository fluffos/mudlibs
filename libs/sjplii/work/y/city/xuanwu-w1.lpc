//changan city

inherit ROOM;

void create() {
  set("short", "玄武大街");
  set("long", @LONG

这里的路相当的宽，能容好几匹马车并行，长长的道路贯穿东西。
这是玄武大街的西段，北面是一家花店，开店的是月下老人，他除了卖
花还热心地给年轻人做月老，主持婚礼。南边是铁匠铺，往西是西市中
心，往东可以看到中心广场。
LONG);

  //set("item_desc", ([" *** " : " *** ", ]));

  set("exits",
    ([  //sizeof() == 4
    "south": __DIR__ "tiejiangpu",
      "north": __DIR__ "huadian",
      "west": __DIR__ "xishi-center",
      "east": __DIR__ "center",
    ]));

  set("objects",
    ([  //sizeof() == 1
    NPC_DIR "people/woman": 1,
      NPC_DIR "people/man": 1,
      __DIR__ "npc/shaonian": 1,
    ]));


  set("outdoors", "changan");
  set("no_clean_up", 0);
  setup();
}
