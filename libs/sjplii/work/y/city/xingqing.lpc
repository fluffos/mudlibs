//changan city

inherit ROOM;

void create() {
  set("short", "兴庆宫");
  set("long", @LONG
兴庆宫原名清虚观，是长安城里着名的一座道观。由于唐朝的皇帝和
道教宗祖老子同姓，因此道教被奉为唐朝的国教。但由于佛教的传入，道
教的状况已大大不如以前。道观中已没有几个人了，但观内原有的气势还
没有变。香案上供着元始天尊、太上老君和灵官道君的神像。
LONG);

  //set("item_desc", ([" *** " : " *** ", ]));

  set("exits",
    ([  //sizeof() == 4
    "south": __DIR__ "baihu-n3",
    ]));

  set("objects",
    ([  //sizeof() == 1
    __DIR__ "npc/zhuzi": 1,
      NPC_DIR "people/army": 2,
    ]));
  set("no_fight", 1);
  set("no_study", 1);
  set("no_magic", 1);
  //	set("NONPC",1);
  setup();
}
