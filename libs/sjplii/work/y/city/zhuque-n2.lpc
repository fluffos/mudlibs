//changan city

inherit ROOM;

void create() {
  set("short", "朱雀大街");
  set("long", @LONG
朱雀大街是长安城的商业中心。大小店铺比邻而立，一派欣欣向荣。
这的路面比不上广场，只是普通的青石大路，但路面很宽，能并行数辆马
车。这里南通明德门，北往朱雀门。路西是一家民宅，而东面是一片废墟。
LONG);

  //set("item_desc", ([" *** " : " *** ", ]));

  set("exits",
    ([  //sizeof() == 4
    "south": __DIR__ "center",
      "north": __DIR__ "zhuque-n3",
      "west": __DIR__ "minzhai1",
      //                "east" : "/u/lark/camp/gate",
    ]));

  set("objects",
    ([  //sizeof() == 1
    NPC_DIR "people/army": 1,
      NPC_DIR "people/youngman": 1,
      NPC_DIR "people/girl": 1,
    ]));


  set("outdoors", "changan");
  set("no_clean_up", 0);
  setup();
  replace_program(ROOM);
}
