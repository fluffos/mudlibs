//changan city

inherit ROOM;

void create ()
{
        set ("short", "国宾馆大厅");
        set ("long", @LONG
大厅相当的大，能容几百人开宴会。大厅内各国使节往来不断，不
同方言充斥耳间。桌上摆了各种新鲜水果，美味佳肴，招待着四方
来客。一群舞女随着节拍翩翩起舞，娥娜多姿。
LONG);

        //set("item_desc", ([" *** " : " *** ", ]));

        set("exits", 
        ([ //sizeof() == 1
                "east" : __DIR__"guobinguan",
        ]));

        set("objects", 
        ([ //sizeof() == 1
              "/obj/npc/dancer1" : 1,
              "/obj/npc/dancer2" : 1,
              "/obj/npc/shijie" : 1,
        ]));
	set("no_fight",1);
	set("no_study",1);
	set("no_magic",1);
	set("hell",1);
	set("NONPC",1);
        setup();
//	replace_program(ROOM);
}
int valid_leave(object me, string dir)
{

	if( me->query_temp("doing_work")<= 1)
	return notify_fail("你的工作还没有完成，怎么就想走了？\n");
	me->set_temp("doing_work", 0);
       return ::valid_leave(me, dir);
}


