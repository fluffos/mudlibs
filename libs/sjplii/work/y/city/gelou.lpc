#include <ansi.h>
#include <room.h>

inherit ROOM;
void create() {
  set("short", "小阁楼");
  set("long", @LONG
这是一个狭窄的阁楼，到处是蜘蛛网和灰尘。
LONG
  );
  set("exits", ([
    "eastdown": __DIR__ "clubup",
  ]));
  set("objects", ([
    "/obj/toy/calabash": 1,
    "/obj/toy/poison_dust": 2,
  ]));
  create_door("eastdown", "天花板", "westup", DOOR_CLOSED);
  setup();
}
