//changan city

inherit ROOM;

void create() {
  set("short", "民居");
  set("long", @LONG
这是一户长安城里普普通通的民宅，小夫妇俩很知书达礼，家境
虽然说不上富裕，但也丰衣足食。屋中并没有什么好的摆设，木桌上
的玻璃瓶中插了几朵野花。
LONG);

  //set("item_desc", ([" *** " : " *** ", ]));
  set("NONPC", 1);
  set("sleep_room", 1);
  set("if_bed", 1);
  set("no_fight", 1);
  set("no_steal", 1);
  set("no_magic", 1);
  set("hell", 1);

  set("exits",
    ([  //sizeof() == 4
    "east": __DIR__ "qinglong-n1",
    ]));

  set("objects",
    ([  //sizeof() == 1
    __DIR__ "npc/man2": 1,
      __DIR__ "npc/woman2": 1,
    ]));
  set("no_clean_up", 0);
  setup();
}
