//changan city

inherit ROOM;

void create ()
{
        set ("short", "青龙大街");
        set ("long", @LONG

你走在一条宽阔的石板大街上，这是青龙大街的北段。西面是一家木
器行，专售各种木器，东边是一家包子铺，老板姓王，他做的各式包子闻
名天下。
LONG);

        //set("item_desc", ([" *** " : " *** ", ]));

        set("exits", 
        ([ //sizeof() == 4
		"south" : __DIR__"qinglong-n1",
                "north" : __DIR__"qinglong-n3",
                "west" : __DIR__"muqi",
                "east" : __DIR__"baozipu",
        ]));

        set("objects", 
        ([ //sizeof() == 1
                NPC_DIR"people/man" : 1,
                NPC_DIR"people/woman" : 1,
        ]));


        set("outdoors", "changan");
	set("no_clean_up", 0);
        setup();
	replace_program(ROOM);
}

