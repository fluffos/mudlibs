//biaoju damen.c
inherit ROOM;

void create ()
{
 set ("short", "红旗镖局大门");
        set ("long", @LONG
你来到一座建构宏伟的宅第之前，在大宅之前的左右两座石坛中各竖一
根两丈来高的旗杆，杆顶飘扬青旗。右首旗上黄色丝线绣著一头张牙舞爪、
神态威猛的雄狮，旗子随风招展，显得雄狮更奕奕若生。左首旗上绣著「红
旗镖局」四个黑字，银钩铁划，刚劲非凡。大宅朱漆大门，门上茶杯大小的
铜钉闪闪发光，门顶匾额写著「红旗镖局」四个金漆大字．
LONG);

       
        set("exits", 
        ([ //sizeof() == 4
		"east" : __DIR__"baihu-s1",
		"west" : __DIR__"bjdayuan",
        ]));

        set("objects", 
        ([ //sizeof() == 1
		NPC_DIR"people/army" : 2,
        ]));


        set("outdoors", "biaoju");
	set("no_clean_up", 0);
	        setup();
//	replace_program(ROOM);
}
int valid_leave(object me, string dir)
{
        if (me->query("wiz")=="baiwt" )
	return ::valid_leave(me, dir);
	 else if (dir == "west" )
        return notify_fail("你走上前去，发现大门上贴着封条：此局已封！\n");
	else
        return ::valid_leave(me, dir);
}


