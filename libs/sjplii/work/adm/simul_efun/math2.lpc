// math.c

int abs(int i)
{	return i>0 ? i :-i;}

int sign(int i)
{	if (i==0) return 0;
	return i>0 ? 1 :  -1;
}

int random(int max)
{
	if (max<10000) return efun::random(max);
	else if (max<100000) return 10*efun::random(max/10);
	else if (max<1000000) return 100*efun::random(max/100);
	else if (max<10000000) return 1000*efun::random(max/1000);
	else return 10000*efun::random(max/10000);
}