// aliasd.c

mapping global_alias = ([
  "l": "look",
  "n": "go north",
  "e": "go east",
  "w": "go west",
  "s": "go south",
  "nu": "go northup",
  "eu": "go eastup",
  "wu": "go westup",
  "su": "go southup",
  "nd": "go northdown",
  "ed": "go eastdown",
  "wd": "go westdown",
  "sd": "go southdown",
  "ne": "go northeast",
  "se": "go southeast",
  "nw": "go northwest",
  "sw": "go southwest",
  "u": "go up",
  "d": "go down",
  "i": "inventory",
  "tt": "team talk",
  "xue": "learn",
  "dazuo": "exercise",
  "diu": "drop",
  "cha": "skills",
  "tw": "team with",
  "td": "team dismiss",
  "tf": "team form",
  "tou": "steal",
  "zhou": "cast",
  "shule": "surrender",
  "yun": "exert",
  "fashu": "conjure",
  "lingli": "enchant",
  "jiali": "enforce",
  "xiang": "meditate",
  "lian": "practice",
  "tuna": "respirate",
  "du": "study",
  "/": "ct",
  "zhaoshi": "perform",
  "fangqi": "abandon",
  "bai": "apprentice",
  "kaichu": "expell",
  "fuzhou": "scribe",
  "chi": "eat",
  "he": "drink",
  "toudu": "pour",
  "kan": "consider",
  "cun": "deposit",
  "qu": "withdraw",
  "kaihu": "open account",
  "huan": "convert",

]);

string process_global_alias(string arg) {
  string *word;

  if (arg[0] == '\'') return "say " + arg[1..strlen(arg) - 1];

  word = explode(arg, " ");
  if (sizeof(word) && !undefinedp(global_alias[word[0]])) {
    word[0] = global_alias[word[0]];
    return implode(word, " ");
  }

  return arg;
}
