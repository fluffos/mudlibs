// b5gb_d.c
// A BIG5-GB code converter.
// by Mai@神剑魔刀  10-31-97

#pragma save_binary

#define DICTIONARY DATA_DIR + "b5gb"

inherit F_CLEAN_UP;
inherit F_SAVE;
mapping b5gb = ([]);
void create() {
  seteuid(getuid());
  restore();
}


string query_save_file() { return DICTIONARY; }

string b5gb(string big5) {
  if (!undefinedp(b5gb[big5])) return b5gb[big5];
  else return big5;
}

void add_translate(string big5, string gb) {
  b5gb[big5] = gb;
  save();
}

string to_gb(string str, int auto) {
  int i, b5 = 0;
  string gb = "";
  string tmp = "  ";
  string en = " ";
  if (strlen(str) >= 2)
    while (i < strlen(str) - 1) {
      if (str[i] > 160 && str[i] < 255) {
        i++;
        if (str[i] < 160) {
          b5 = 1;
          break;
        }
      }
      i++;
    }
  i = 0;
  if (b5 || !auto) {
    while (i < strlen(str) - 1) {
      if (str[i] > 160 && str[i] < 255) {
        tmp[0] = str[i];
        i++;
        tmp[1] = str[i];
        gb = gb + b5gb(tmp);
      } else {
        en[0] = str[i];
        gb = gb + en;
      }
      i++;
    }
    if (i < strlen(str)) {
      en[0] = str[i];
      gb = gb + en;
    }
    return gb;
  } else return str;
}

mapping query_all_b5() {
  return b5gb;
}
