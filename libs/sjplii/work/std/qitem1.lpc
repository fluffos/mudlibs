// /std/qitem.c  情节设计继承物件1  by baiwt@sjpl
// 需要定义的内容：
// 指令名_name,  指令名_msg,  指令名_file,   指令名_i
#include <dbase.h>
#include <move.h>
#include <name.h>
#include <ansi.h>

inherit F_CLEAN_UP;
inherit F_DBASE;
inherit F_MOVE;
inherit F_NAME;

void setup()
{
	seteuid(getuid());
}
void init()
{
	add_action("do_cures", "cure");		//治疗
	add_action("do_defend", "defend");  	//打抱不平
	add_action("do_lookfor", "lookfor");	//寻找
	add_action("do_shows", "show");		//出示，给予
	add_action("do_sing", "sing");		//吟唱
	add_action("do_talks", "talk");		//交谈
	add_action("do_yield", "yield");		//让步，放弃
}
int do_talks(string arg)
{
	object me,target;
	string talk_msg, talk_name, talk_file;
	int talk_i;
	me = this_player();
	if( !arg )
		return notify_fail("你想与谁交流？\n");
      if (environment(me)->query("hell"))
	return notify_fail("这里无法与别人交流。\n");

	target = present(arg, environment(me));
	if( !target )
		return notify_fail("你想与谁交流？\n");
	if( !target->is_character() || target->is_corpse() )
		return notify_fail("你只能与人交流。\n");
	if( userp(target) && (object)target->query_temp("pending/fight")!=me ) 
		return notify_fail("你没有必要与那个人交流。\n");

	talk_name = this_object()->query("talk_name");
	talk_msg = this_object()->query("talk_msg");
	talk_file = this_object()->query("talk_file");
	if(!talk_name) talk_name="什么？\n";
	if(!talk_msg) talk_msg="什么？\n";
	if(!talk_file) talk_file="什么？\n";

	if( target->query("name") == talk_name){
	message_vision(talk_msg, me, target);
//	destruct(this_object());
	return 1;
	}
	else
	message_vision("$n无奈说道：你问的我不知道。\n", me, target);
	return 1;
}

int do_shows(string arg)
{
	object me,target;
	string show_msg, show_name, show_file;
	int show_i;
	me = this_player();
	if( !arg )
		return notify_fail("你想与谁交流？\n");
      if (environment(me)->query("hell"))
	return notify_fail("这里无法与别人交流。\n");

	target = present(arg, environment(me));
	if( !target )
		return notify_fail("你想与谁交流？\n");
	if( !target->is_character() || target->is_corpse() )
		return notify_fail("你只能与人交流。\n");
	if( userp(target) && (object)target->query_temp("pending/fight")!=me ) 
		return notify_fail("你没有必要与那个人交流。\n");

	show_name = this_object()->query("show_name");
	show_msg = this_object()->query("show_msg");
	show_file = this_object()->query("show_file");
	if(!show_name) show_name="什么？\n";
	if(!show_msg) show_msg="什么？\n";
	if(!show_file) show_file="什么？\n";

	if( target->query("name") == show_name){
	message_vision(show_msg, me, target);
//	destruct(this_object());
	return 1;
	}
	else
	message_vision("$n无奈说道：你问的我不知道。\n", me, target);
	return 1;
}

