#include <ansi.h>
inherit NPC;
int custom();
void create() {
  set_name("金眼鹏", ({ "jin yanpeng", "jin" }));
  set("gender", "男性");
  set("age", 30);
  set("combat_exp", (random(7) + 1) * 100000);
  set("nickname", HIY "两河名捕" NOR);
  set("title", "朝廷官员");
  set("chat_chance", 50);
  set("chat_msg", ({
    (: random_move :),
    (: custom :)
  }));
  set("str", 70);
  set("id_type", 5);
  set("class", "official");
  set("attitude", "heroism");
  set("max_force", 1270);
  set("force", 1226);
  set("force_factor", 30);
  set("atman", 731);
  set("mana", 592);
  set_skill("unarmed", 100);
  set_skill("blade", 150);
  set_skill("spring-blade", 150);
  map_skill("blade", "spring-blade");
  set_skill("dodge", 100);
  set_skill("chaos-steps", 100);
  map_skill("dodge", "chaos-steps");
  map_skill("parry", "spring-blade");
  set("chat_chance_combat", 50);
  set("chat_msg_combat", ({
    (: perform_action, "blade.zhanluanma" :),
  }));

  setup();
  carry_object("/obj/cloth")->wear();
  carry_object("/obj/blade")->wield();

}
int custom() {
  int i;
  object env, *inv;
  object me = this_object();
  env = environment(me);
  inv = all_inventory(env);
  if (me->query("bellicosity") > 10)
    me->set("bellicosity", 1);
  for (i = 0; i < sizeof(inv); i++) {
    if (inv[i] == me) continue;
    if (inv[i]->is_corpse()) continue;
    if (!inv[i]->is_character()) continue;
    if (inv[i]->query("id_type") == 2)
      me->fight_ob(inv[i]);
  }
  return 1;
}
