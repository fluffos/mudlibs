#include <ansi.h>
inherit NPC;
int custom();
void create()
{
        set_name("马孟良", ({ "ma mengliang","ma" }) );
        set("gender", "男性" );
        set("age", 40);
	set("combat_exp", (random(7)+1)*100000);
	set("nickname",HIG"莫愁人"NOR);
	set("title","丐帮长老");
        set("chat_chance", 50);
        set("chat_msg", ({
                (: random_move :),
		(: custom :)	
        }) );
        set("str", 70);
        set("id_type", 2);

        set("attitude", "heroism");
	set("max_force",1270);
	set("force",2226);
	set("force_factor",30);
	set("atman",731);
	set("mana",592);	
	set_skill("unarmed",100);
	set_skill("stick",150);
	set_skill("hitdog_stick",150);
	map_skill("stick", "hitdog_stick");
	set_skill("dodge",100);
	set_skill("hidden_dodge",100);
        map_skill("dodge", "hidden_dodge");
	map_skill("parry", "hitdog_stick");
        set("chat_chance_combat", 50);
        set("chat_msg_combat", ({
		(: perform_action, "stick.wugou" :),
        }) );

        setup();
        carry_object("/obj/cloth")->wear();
        carry_object("/obj/weapon/stick")->wield();

}

int custom()
{
	int i;
	object env, *inv;
	object me=this_object();
        env = environment(me);
        inv = all_inventory(env);
	command("hehe");
	if( me->query("bellicosity") >10 )
	me->set("bellicosity",1);
        for(i=0; i<sizeof(inv); i++) {
                if( inv[i]==me ) continue;
                if( inv[i]->is_corpse() ) continue;
		if( !inv[i]->is_character()) continue;
                if( inv[i]->query("id_type")==1 ) 
                me->fight_ob(inv[i]);
        }
return 1;
}
