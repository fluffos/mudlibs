#include <ansi.h>
inherit NPC;
int custom();
void create()
{
        set_name("公孙右足", ({ "gongsun youzu","gongsun" }) );
        set("gender", "男性" );
        set("age", 56);
	set("combat_exp", (random(7)+1)*100000);
	set("nickname",HIG"君山双残"NOR);
	set("title","君山派长老");
        set("chat_chance", 50);
        set("chat_msg", ({
                (: random_move :),
		(: custom :)	
        }) );
        set("str", 70);
        set("cor", 30);
        set("id_type", 2);

        set("attitude", "heroism");
	set("max_force",3270);
	set("force",6226);
	set("force_factor",30);
	set("atman",731);
	set("mana",592);	
	set_skill("unarmed",100);
	set_skill("huangsha-whip",140);
	set_skill("whip",150);
	set_skill("force",100);
	set_skill("senluo-force",100);
	set_skill("parry",100);
	set_skill("dodge",100);
	set_skill("huashu-steps",100);
        map_skill("dodge", "huashu-steps");
        map_skill("whip", "huangsha-whip");
        map_skill("parry", "huangsha-whip");
        map_skill("force", "senluo-force");
        set("chat_chance_combat", 50);
        set("chat_msg_combat", ({
		(: perform_action, "whip.fengshamangmang" :),
        }) );
        setup();
        carry_object("/obj/cloth")->wear();
	carry_object("/obj/weapon/whip")->wield();
}

int custom()
{
	int i;
	object env, *inv;
	object me=this_object();
        env = environment(me);
        inv = all_inventory(env);
	command("heihei");
	if( me->query("bellicosity") >10 )
	me->set("bellicosity",1);
        for(i=0; i<sizeof(inv); i++) {
                if( inv[i]==me ) continue;
                if( inv[i]->is_corpse() ) continue;
		if( !inv[i]->is_character()) continue;
                if( inv[i]->query("id_type")==1 ) 
                me->fight_ob(inv[i]);
        }
return 1;
}
