#include <ansi.h>
inherit NPC;
int custom();
void create()
{
        set_name("欧阳独霸", ({ "ouyang duba","ouyang" }) );
        set("gender", "男性" );
        set("age", 55);
	set("combat_exp", (random(9)+1)*100000);
	set("title","西昆仑");
	set("nickname",HIB"欧阳老怪"NOR);
        set("chat_chance", 50);
        set("chat_msg", ({
                (: random_move :),
		(: custom :)	
        }) );
        set("str", 70);
        set("id_type", 2);

        set("attitude", "heroism");
	set("max_force",1270);
	set("force",1226);
	set("force_factor",30);
	set("atman",731);
	set("mana",592);	
        set_skill("force", 200);
        set_skill("unarmed", 200);
        set_skill("parry", 200);
        set_skill("dodge", 200);
        set_skill("ghoststeps", 100);
        set_skill("hotforce", 100);
        set_skill("ghostclaw", 180);
        map_skill("force", "hotforce");
        map_skill("unarmed", "ghostclaw");
        map_skill("dodge", "ghoststeps");

        set("chat_chance_combat", 50);
        set("chat_msg_combat", ({
		(: perform_action, "unarmed.diyulian" :),
        }) );

        setup();
        carry_object("/obj/cloth")->wear();
}
int custom()
{
	int i;
	object env, *inv;
	object me=this_object();
        env = environment(me);
        inv = all_inventory(env);
	if( me->query("bellicosity") >10 )
	me->set("bellicosity",1);
        for(i=0; i<sizeof(inv); i++) {
                if( inv[i]==me ) continue;
                if( inv[i]->is_corpse() ) continue;
		if( !inv[i]->is_character()) continue;
                if( inv[i]->query("id_type")==1 ) 
                me->fight_ob(inv[i]);
        }
return 1;
}

