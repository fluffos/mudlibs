// by baiwt 

inherit NPC;

string *names = ({
  "挎着竹篮的女子",
  "步履蹒跚的老婆婆",
  "老乞婆",
  "少奶奶",
  "上了年纪的妇女",
  "老太太",
  "老夫人",
  "捏面人的妇女",
  "卖瓜子的女人",
  "茶馆老板娘",
  "老弱病妇",
});

string *ids = ({
  "zhulan nv",
  "lao popo",
  "lao qipo",
  "shao nainai",
  "lao funv",
  "lao taitai",
  "lao furen",
  "niemian nv",
  "guazi nv",
  "laoban niang",
  "bing fu",
});

string *genders = ({
  "女性",
  "女性",
  "女性",
  "女性",
  "女性",
  "女性",
  "女性",
  "女性",
  "女性",
  "女性",
  "女性",
});

void create() {
  int i = random(sizeof(names));
  set_name(names[i], ({ ids[i] }));
  set("gender", genders[i]);
  set("combat_exp", 100 + random(1000));
  set("age", 40 + random(40));
  set("per", 4 + random(30));
  set("attitude", "friendly");
  set("long", "这是一个普通的老百姓。\n");
  set_skill("unarmed", 10 + random(30));
  set_skill("dodge", 10 + random(30));
  set_skill("parry", 10 + random(30));
  set("chat_chance", 10);
  set("chat_msg", ({
    (: random_move :)
  }));
  setup();
  carry_object("/obj/cloth/silk-cloth")->wear();
  carry_object("/obj/cloth/flower-shoes")->wear();
  carry_object("/obj/cloth/color_head")->wear();
  carry_object("/obj/cloth/silver-finger");
  add_money("silver", random(9));
}
