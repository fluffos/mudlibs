// by baiwt 

inherit NPC;

string *names = ({
  "手工艺者",
  "卖艺人",
  "买药人",
  "青年书生",
  "青年武师",
  "彪形大汉",
  "买马人",
  "卖菜汉子",
  "说书人",
  "木匠",
  "泥水匠",
  "浪荡公子",
});

string *ids = ({
  "shouyi ren",
  "maiyi ren",
  "maiyao ren",
  "shu sheng",
  "wu shi",
  "da han",
  "maima ren",
  "maicai ren",
  "shuoshu ren",
  "mu jiang",
  "nishui jiang",
  "langdang gongzi",
});

string *genders = ({
  "男性",
  "男性",
  "男性",
  "男性",
  "男性",
  "男性",
  "男性",
  "男性",
  "男性",
  "男性",
  "男性",
  "男性",
});

void create()
{
  int i = random(sizeof(names));
  set_name(names[i], ({ids[i]}));
  set("gender", genders[i]);
  set("combat_exp", 100+random(1000));
  set("age", 20+random(40));
  set("per", 3+random(40));
  set("attitude", "friendly");
  set("long", "这是一个普通的老百姓。\n");
  set_skill("unarmed", 10+random(70));
  set_skill("dodge", 10+random(70));
  set_skill("parry", 10+random(70));
        set("chat_chance", 10);
        set("chat_msg", ({
                (:random_move :)
        }) );
  setup();
  carry_object("/obj/cloth/cloth")->wear();
  carry_object("/obj/cloth/shoe")->wear();
  carry_object("/obj/cloth/headband")->wear();
  add_money("silver", random(7));
}


