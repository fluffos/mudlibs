inherit NPC;

string *names = ({
  "卖鱼的女子",
  "卖布的女子",
  "背竹篓的女子",
  "卖菜的女子",
  "中年女子",
  "胖胖的妇人",
  "卖水果的女子",
  "卖纸花的女子",
  "洗衣服的女子",
  "过路的女子",
});

string *ids = ({
  "maiyu nv",
  "maibu nv",
  "zhulou nv",
  "maicai nv",
  "fu nv",
  "pang nvzi",
  "shuiguo nv",
  "zhihua nv",
  "xiyi nv",
  "nv youke",
});

string *genders = ({
  "女性",
  "女性",
  "女性",
  "女性",
  "女性",
  "女性",
  "女性",
  "女性",
  "女性",
  "女性",
});

void create()
{
  int i = random(sizeof(names));
  set_name(names[i], ({ids[i]}));
  set("gender", genders[i]);
  set("combat_exp", 100+random(1000));
  set("age", 20+random(30));
  set("per", 4+random(30));
  set("attitude", "friendly");
  set("long", "这是一个普通的老百姓。\n");
  set_skill("unarmed", 10+random(30));
  set_skill("dodge", 10+random(30));
  set_skill("parry", 10+random(30));
        set("chat_chance", 10);
        set("chat_msg", ({
                (:random_move :)
        }) );
  setup();
  carry_object("/obj/cloth/pink_cloth")->wear();
  carry_object("/obj/cloth/flower-shoes")->wear();
  carry_object("/obj/cloth/color_head")->wear();
  carry_object("/obj/cloth/silver-finger");
  add_money("silver", random(5));
}

