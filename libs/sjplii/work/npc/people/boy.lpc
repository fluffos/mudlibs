// by baiwt 

inherit NPC;

string *names = ({
  "小男孩",
  "有钱人家的少爷",
  "公子哥",
  "小伙计",
  "小顽童",
  "小书童",
  "小乞丐",
  "小无赖",
  "读书郎",
  "小皮匠",
  "生病的小孩",
});

string *ids = ({
  "xiao nanhai",
  "shao ye",
  "gongzi ge",
  "xiao huoji",
  "wan tong",
  "shu tong",
  "xiao qigai",
  "xiao wulai",
  "dushu lang",
  "xiao pijiang",
  "bing hai",
});

string *genders = ({
  "男性",
  "男性",
  "男性",
  "男性",
  "男性",
  "男性",
  "男性",
  "男性",
  "男性",
  "男性",
  "男性",
});

void create()
{
  int i = random(sizeof(names));
  set_name(names[i], ({ids[i]}));
  set("gender", genders[i]);
  set("combat_exp", 100+random(1000));
  set("age", 10+random(20));
  set("per", 5+random(30));
  set("attitude", "friendly");
  set("long", "这是一个普通的老百姓。\n");
  set_skill("unarmed", 10+random(40));
  set_skill("dodge", 10+random(40));
  set_skill("parry", 10+random(40));
        set("chat_chance", 10);
        set("chat_msg", ({
                (:random_move :)
        }) );
  setup();
  carry_object("/obj/cloth/cloth")->wear();
  carry_object("/obj/cloth/buxie")->wear();
  carry_object("/obj/cloth/belt")->wear();
  add_money("silver", random(3));
}

