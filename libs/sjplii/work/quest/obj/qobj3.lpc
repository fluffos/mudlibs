inherit Q_ITEM;//此处继承标准物件，即qitem.c

void create()
{
	string *tname = ({
	"仁山头陀","披枝和尚","段彦莫",
			});
	set_name("青城派信物", ({ "quest xinwu" }) );
	set_weight(300);
	set("unit", "块");
	set("long",
		"这是一块神奇的铁牌，上面刻着一些青山绿树。\n");
	set("quest_reward",300);
	set("publish_msg","段彦莫好象打听到了雪山派最近的动向。");
	set("talk_name", tname[random(2)] );//此处设置随机姓名，解迷时增加了不确定性
	set("talk_msg","$N对$n抱拳说道：请问这位前辈，近来有什么武林传闻？\n");
	set("reply_msg","$N对$n冷笑说道：近来包大通忙很多了。\n");
	set("talk_file","/quest/obj/qobj1");
}
