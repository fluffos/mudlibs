// rmdir.c

inherit F_CLEAN_UP;

int help(object me);

int main(object me, string arg) {
  string dir;
  string wiz_status;
  wiz_status = SECURITY_D->get_status(me);

  if (!arg) return help(me);

  dir = resolve_path(me->query("cwd"), arg);
  if (wiz_status != "(admin)" && wiz_status != "(arch)" && strsrch(arg, "adm") >= 0)
    return notify_fail("你没有这个权限 ！\n");
  if (wiz_status != "(admin)" && wiz_status != "(arch)" && strsrch(arg, "include") >= 0)
    return notify_fail("你没有这个权限 ！\n");
  if (wiz_status != "(admin)" && wiz_status != "(arch)" && strsrch(arg, "data") >= 0)
    return notify_fail("你没有这个权限 ！\n");
  if (wiz_status != "(admin)" && wiz_status != "(arch)" && strsrch(arg, "daemon") >= 0)
    return notify_fail("你没有这个权限 ！\n");
  if (wiz_status != "(admin)" && wiz_status != "(arch)" && strsrch(arg, "cmds") >= 0)
    return notify_fail("你没有这个权限 ！\n");
  if (wiz_status != "(admin)" && wiz_status != "(arch)" && strsrch(arg, "topten") >= 0)
    return notify_fail("你没有这个权限 ！\n");
  if (wiz_status != "(admin)" && wiz_status != "(arch)" && strsrch(arg, "std") >= 0)
    return notify_fail("你没有这个权限 ！\n");
  if (wiz_status != "(admin)" && wiz_status != "(arch)" && strsrch(arg, "obj") >= 0)
    return notify_fail("你没有这个权限 ！\n");
  if (wiz_status != "(admin)" && wiz_status != "(arch)" && strsrch(arg, "feature") >= 0)
    return notify_fail("你没有这个权限 ！\n");

  seteuid(geteuid(me));
  if (rmdir(dir))
    write("Ok.\n");
  else
    write("删除失败。\n");
  return 1;
}

int help(object me) {
  write(@HELP
指令格式 : rmdir <子目录名>

删除一个子目录。
HELP
  );
  return 1;
}
