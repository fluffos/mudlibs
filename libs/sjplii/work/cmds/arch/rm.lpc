// rm.c

#include "/doc/help.h"

inherit F_CLEAN_UP;
int help(object me);

int main(object me, string file) {
  string src, dst;
  string wiz_status;
  seteuid(geteuid(me));
  if (!file) return notify_fail("你要删除那个档案?\n");

  if (file_size(src) > 0 && !read_file(src))
    return notify_fail("【安全系统】你没有这个权限 ！\n");
  if (file_size(dst) > 0 && !read_file(dst))
    return notify_fail("【安全系统】你没有这个权限 ！\n");

  src = resolve_path(me->query("cwd"), file);
  wiz_status = SECURITY_D->get_status(me);
  if (wiz_status != "(admin)" && wiz_status != "(arch)" && strsrch(src, "adm") >= 0)
    return notify_fail("你没有这个权限 ！\n");
  if (wiz_status != "(admin)" && wiz_status != "(arch)" && strsrch(src, "include") >= 0)
    return notify_fail("你没有这个权限 ！\n");
  if (wiz_status != "(admin)" && wiz_status != "(arch)" && strsrch(src, "data") >= 0)
    return notify_fail("你没有这个权限 ！\n");
  if (wiz_status != "(admin)" && wiz_status != "(arch)" && strsrch(src, "daemon") >= 0)
    return notify_fail("你没有这个权限 ！\n");
  if (wiz_status != "(admin)" && wiz_status != "(arch)" && strsrch(src, "cmds") >= 0)
    return notify_fail("你没有这个权限 ！\n");
  if (wiz_status != "(admin)" && wiz_status != "(arch)" && strsrch(src, "topten") >= 0)
    return notify_fail("你没有这个权限 ！\n");
  if (wiz_status != "(admin)" && wiz_status != "(arch)" && strsrch(src, "std") >= 0)
    return notify_fail("你没有这个权限 ！\n");
  if (wiz_status != "(admin)" && wiz_status != "(arch)" && strsrch(src, "obj") >= 0)
    return notify_fail("你没有这个权限 ！\n");
  if (wiz_status != "(admin)" && wiz_status != "(arch)" && strsrch(src, "feature") >= 0)
    return notify_fail("你没有这个权限 ！\n");

  if (rm(resolve_path(me->query("cwd"), file)))
    write("Ok.\n");
  else
    write("你没有删除这个档案的权利。\n");
  return 1;
}

int help(object me) {
  write(@HELP
指令格式 : rm <档名>

此指令可让你删除有权修改的档案。
HELP
  );
  return 1;
}
