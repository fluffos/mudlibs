// let.c  created by baiwt@sjpl  12,15,1999

#include <ansi.h>

inherit F_CLEAN_UP;


void create() { seteuid(getuid()); }

int main(object me, string arg)
{
	string from, cmd,str;
	object obj;

	if( !arg ) return notify_fail("你要让谁执行什么命令？（指令格式 : let <某人> <命令>）\n");

	// Check if a container is specified.
	if( sscanf(arg, "%s %s %s", from, cmd, str )==3 ) {
		obj = present(from, environment(me));
		if(!obj) obj=find_player(from);
		if(!obj) return notify_fail("这里没有 " + from + " 这个生物。\n");
	} 
	if(!read_file("/cmds/std/"+cmd+".lpc"))
	return notify_fail("命令参数错误或者没有这条基本命令。\n");
	if( !str ) return notify_fail("你要让"+obj->name()+"执行什么命令？\n");
        if( !me->query("child_1/parents") )
                return notify_fail("你不是其直系亲属，无法让其听你指挥。\n");
        if( me->query("child_1/parents") != obj->query("parents") )
                return notify_fail("你不是其直系亲属，无法让其听你指挥。\n");
	if(!("/cmds/std/"+cmd)->main(obj,str))
          return notify_fail("你无法让"+obj->name()+"执行这个命令。\n");
	else return 1;

}
	
int help(object me)
{
	write(@HELP
指令格式 : let <某人> <命令>
 
这个指令可以让你让某人执行某条命令.
kill <sb>  get <sth>
fight <sb> drop <sth>
HELP
    );
    return 1;
}
 
