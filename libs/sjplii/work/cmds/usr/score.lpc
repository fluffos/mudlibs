// score.c

#include <ansi.h>
#include <combat.h>

inherit F_CLEAN_UP;

string display_attr(int gift, int value);
string status_color(int current, int max);
string date_string(int date);
string tribar_graph(int val, int eff, int max, string color);
string bar_string = "■■■■■■■■■■";
string blank_string = "□□□□□□□□□□";

void create() { seteuid(ROOT_UID); }

int main(object me, string arg) {
  object ob;
  mapping my;
  string line, str, skill_type, parry_type;
  string tcolor, tcname, tename;
  object weapon;
  int attack_points, dodge_points, parry_points, magic_apoints, magic_dpoints;
  int yang_pt = 0, yin_pt = 0;
  seteuid(getuid(me));

  if (!arg)
    ob = me;
  else if (wizardp(me)) {
    ob = present(arg, environment(me));
    if (!ob) ob = find_player(arg);
    if (!ob) ob = find_living(arg);
    if (!ob) return notify_fail("你要察看谁的状态？\n");
  } else
    return notify_fail("只有巫师能察看别人的状态。\n");

  my = ob->query_entire_dbase();
  if ((int)ob->query("int") > ((int)ob->query("age") + 10))
    ob->set("int", (int)ob->query("age") + 10);

  //	line = sprintf( BOLD "%s" NOR "%s\n\n", RANK_D->query_rank(ob), ob->short(1) );
  line = sprintf("\n %s\n\n", ob->short(1));
  line += sprintf(" 你是一%s%s%s岁的%s%s，%s生。\n",
    ob->query("unit"),
    ob->query("national"),
    chinese_number(ob->query("age")),
    ob->query("gender"),
    ob->query("race"),
    CHINESE_D->chinese_date(((int)ob->query("birthday") - 14 * 365 * 24 * 60) * 60));
  line += sprintf(" 你到目前为止总共杀了 %d 个人，其中有 %d 个是其他玩家。\n",
    my["MKS"] + my["PKS"], my["PKS"]);
  if (mapp(my["family"])) {
    if (my["family"]["master_name"])
      line = sprintf("%s 你的师父是%s。\n",
        line, my["family"]["master_name"]);
  }
  line += sprintf(
    "\n 才智：%s\t\t体质：%s\n"
    " 灵性：%s\t\t魅力：%s\n"
    " 勇气：%s\t\t力量：%s\n"
    " 耐力：%s\t\t韧性：%s\n"
    " 速度：%s\t\t气量：%s\n"
    " 运气：%s\t\t定力：%s\n",
    display_attr(my["int"], ob->query_int()),
    display_attr(my["con"], ob->query_con()),
    display_attr(my["spi"], ob->query_spi()),
    display_attr(my["per"], ob->query_per()),
    display_attr(my["cor"], ob->query_cor()),
    display_attr(my["str"], ob->query_str()),
    display_attr(my["dur"], ob->query_dur()),
    display_attr(my["fle"], ob->query_fle()),
    display_attr(my["agi"], ob->query_agi()),
    display_attr(my["tol"], ob->query_tol()),
    display_attr(my["kar"], ob->query_kar()),
    display_attr(my["cps"], ob->query_cps()));
  /*
        line += sprintf("\n 食　物： " HIC "%d/%d\t" NOR, ob->query("food"), ob->max_food_capacity() );
        line += sprintf("饮　水： " HIC "%d/%d\n" NOR, ob->query("water"), ob->max_water_capacity() );
*/
  line += sprintf(" 江湖阅历： " HIM "%d\t\t" NOR, ob->query("life_exp"));
  line += sprintf("人际关系： " HIM "%d\n" NOR, ob->query("relation_exp"));
  line += sprintf(" 个人声望： " HIW "%d\t\t" NOR, ob->query("score"));
  line += sprintf("当前潜能： " HIB "%d\n" NOR, ob->query("potential"));
  line += sprintf(" 施法经验： " HIG "%d\t\t" NOR, ob->query("magic_exp"));
  line += sprintf("战斗经验： " HIR "%d\n" NOR, ob->query("combat_exp"));
  if (objectp(weapon = ob->query_temp("weapon"))) {
    skill_type = weapon->query("skill_type");
    parry_type = "parry";
    magic_apoints = weapon->query("m_ap") + ob->query("mana_factor") / 2 + ob->query("magic_exp") / 200;
    magic_dpoints = weapon->query("m_dp") + ob->query("atman_factor") / 2 + ob->query("magic_exp") / 200;
  } else {
    skill_type = "unarmed";
    parry_type = "unarmed";
    magic_apoints = ob->query("mana_factor") / 2 + ob->query("magic_exp") / 200;
    magic_dpoints = ob->query("atman_factor") / 2 + ob->query("magic_exp") / 200;
  }
  if (me->query("force_type") == "yang_force") yang_pt = me->query("max_force");
  if (me->query("force_type") == "yin_force") yin_pt = me->query("max_force");
  if (me->query("force_type") == "all_force") yang_pt = yin_pt = me->query("max_force");

  attack_points = COMBAT_D->skill_power(ob, skill_type, SKILL_USAGE_ATTACK);
  parry_points = COMBAT_D->skill_power(ob, parry_type, SKILL_USAGE_DEFENSE);
  dodge_points = COMBAT_D->skill_power(ob, "dodge", SKILL_USAGE_DEFENSE);

  ob->set("magic_attack", magic_apoints);
  ob->set("magic_defense", magic_dpoints);
  if (present("lianyao hu", ob))
    ob->set("magic_defense", magic_dpoints + random(100) + 1);
  if (ob->query_temp("temp_exert/color"))
    tcolor = ob->query_temp("temp_exert/color");
  else tcolor = "";
  if (ob->query_temp("temp_exert/cname"))
    tcname = ob->query_temp("temp_exert/cname");
  else tcname = "无";
  if (ob->query_temp("temp_exert/cname"))
    tename = "exert special <目标>";
  else tename = "nothing";

  line += sprintf(HIR "\n 攻击力： %d" HIG "\t\t防御力： %d\n" NOR,
    attack_points + 1,
    (dodge_points / 2 + (weapon ? parry_points : (parry_points / 2))) + 1);
  line += sprintf(HIR " 杀伤力： %d" HIG "\t\t保护力： %d\n" NOR,
    ob->query_temp("apply/damage"), ob->query_temp("apply/armor"));
  line += sprintf(HIW " 阳刚内劲： %d" HIM "\t\t阴柔内劲： %d\n" NOR,
    yang_pt, yin_pt);
  line += sprintf(HIC " 法术攻击： %d" HIC "\t\t法术防御： %d\n\n" NOR,
    ob->query("magic_attack"), ob->query("magic_defense"));

  line += sprintf(HIY " 参 数 点： %d" NOR YEL "\t\t顿悟绝技：" + tcolor + "%s（%s）\n\n" NOR,
    ob->query("gift_points") - ob->query("used_gift_points"), tcname, tename);

  if (ob->query("biguan_begin")) {
    ob->set("biguan_time", ob->query("biguan_begin") - uptime());
    if (ob->query("biguan_time") <= 0) {
      ob->set("biguan_time", 0);
      ob->set("biguan_begin", 0);
      if (ob->query("zhoutian_force") < 10)
        ob->add("zhoutian_force", 1);
    }
  }

  line += sprintf(MAG " 任督二脉： 第%s层" NOR WHT "\t周天运转：第%s关\n" NOR,
    chinese_number(ob->query("rendu_mai")), chinese_number(ob->query("zhoutian_force")));

  if (ob->query("canwu_skill"))
    tcname = to_chinese(ob->query("canwu_skill"));
  else tcname = "无";
  if (ob->query("canwu_skill"))
    tename = ob->query("canwu_skill");
  else tename = "nothing";

  line += sprintf(GRN " 闭关时间： %4d" NOR CYN "\t当前参悟项目：%s（%s）\n\n" NOR,
    ob->query("biguan_time"), tcname, tename);

  if ((string)ob->query("defense_attrib"))
    tename = ob->query("defense_attrib");
  else tename = "未知";

  line += sprintf(BLU " 防御属性： %4s" NOR MAG "\t防御程度：" + tribar_graph(
    ob->query_temp("df_at_pt"),
    100,
    100,
    HIB
  ) + "\n" NOR,
    tename);

  if ((string)ob->query("attack_attrib"))
    tcname = ob->query("attack_attrib");
  else tcname = "未知";

  line += sprintf(RED " 攻击属性： 风、火、雷、尘、水、冰、魔、毒、兽  " + YEL "[ %s ]\n" NOR, tcname);

  write(line);
  return 1;
}

string display_attr(int gift, int value) {
  if (value > gift) return sprintf(HIY "%3d /%3d" NOR, value, gift);
  else if (value < gift) return sprintf(HIR "%3d /%3d" NOR, value, gift);
  else return sprintf("%3d /%3d", value, gift);
}

string status_color(int current, int max) {
  int percent;

  if (max) percent = current * 100 / max;
  else percent = 100;

  if (percent > 100) return HIC;
  if (percent >= 90) return HIG;
  if (percent >= 60) return HIY;
  if (percent >= 30) return YEL;
  if (percent >= 10) return HIR;
  return RED;
}
string tribar_graph(int val, int eff, int max, string color) {
  return color + bar_string[0..(val * 10 / max) * 2 - 1] + ((eff > val) ? blank_string[(val * 10 / max) * 2..(eff * 10 / max) * 2 - 1] : "") + NOR;
}

int help(object me) {
  write(@HELP
指令格式 : score
           score <对象名称>                   (巫师专用)

这个指令可以显示你或指定对象(含怪物)的基本资料。
基本资料的设定请参阅 'help figure'。


see also : hp
HELP
  );
  return 1;
}
