// title.c (Mon  09-04-95)

#include <ansi.h>
inherit F_CLEAN_UP;

int main(object me, string str) {
  if (me->query("env/no_msg")) {
    write("打开战斗信息。\n");
    me->set("env/no_msg", 0);
  } else {
    write("关闭战斗信息。\n");
    me->set("env/no_msg", 1);
  }

  return 1;
}

int help(object me) {
  write(@HELP
指令格式: msg
 
让你切换显示模式，决定是否看战斗信息。
 
HELP
  );
  return 1;
}
