// /cmds/usr/hp.c cmds (by baiwt  05-18-99)
 
#include <ansi.h>
 
inherit F_CLEAN_UP;
 
string status_color(int current, int max);
string bar_string = "■■■■■■■■■■■■■■■■■■■■■■";
string blank_string = "□□□□□□□□□□□□□□□□□□□□□□";
string tribar_graph(int val, int eff, int max, string color);

int main(object me, string arg)
{
	int morality,morale;
	object ob, link_ob;
	mapping my;
 	string line;
	seteuid(getuid(me));
	if(!arg)
		ob = me;
	else if (wizardp(me)) {
		ob = present(arg, environment(me));
		if (!ob) ob = find_player(arg);
		if (!ob) ob = find_living(arg);
        if (!ob) return notify_fail("你要察看谁的状态？\n");
	} else
		return notify_fail("只有巫师能察看别人的状态。\n");
         if (ob->query("battle_slg_mode") )
	return notify_fail("正在战略模式中，请使用status指令查看状态。\n");

	my = ob->query_entire_dbase();
	morality = 300 + ob->query_skill("buddhism",1)*2 + ob->query_skill("taoism",1)*2 
			+ ob->query_skill("dormancy",1)*2 + ob->query_skill("zhengqijue",1)*2 
			+ ob->query_skill("hs-zhengqi",1)*2 
			+ ob->query("daode_point") - my["MKS"] - my["PKS"]*100;
	ob->set("daode", morality);
	morale = 100-ob->query("env/wimpy");

	if( userp(ob) ) 
	{
	link_ob = me->query_temp("link_ob");
	link_ob->save();
	ob->save();
	}
    printf(" 精力  ： %s%4d/ %4d %s(%3d%%)" HIY "    道德： %d\n" NOR,
		status_color(my["gin"], my["eff_gin"]),	my["gin"],	my["eff_gin"],
		status_color(my["eff_gin"], my["max_gin"]),	my["eff_gin"] * 100 / my["max_gin"],
                ob->query("daode")
		);
    printf(" 气血  ： %s%4d/ %4d %s(%3d%%)" HIW "    士气： %d\n" NOR,
                status_color(my["kee"], my["eff_kee"]), my["kee"], my["eff_kee"],
                status_color(my["eff_kee"], my["max_kee"]),     my["eff_kee"] * 100 / my["max_kee"],
                morale
                );
    printf(" 心神  ： %s%4d/ %4d %s(%3d%%)" HIC "    武学： %d\n" NOR,
                status_color(my["sen"], my["eff_sen"]), my["sen"], my["eff_sen"],
                status_color(my["eff_sen"], my["max_sen"]),     my["eff_sen"] * 100 / my["max_sen"],
                ob->query("p_power_rank")
                );
    printf(" 灵力  ： %s%4d/ %4d (%4d)" HIR "    杀气： %d\n" NOR,
		status_color(my["atman"], my["max_atman"]),     my["atman"], my["max_atman"],
		my["atman_factor"],
                my["bellicosity"]
		);
    printf(" 内力  ： %s%4d/ %4d (%4d)"  HIG "    潜能： %d\n" NOR,
                status_color(my["force"], my["max_force"]),     my["force"], my["max_force"],
		my["force_factor"],
		(my["potential"] - my["learned_points"])
                );
    printf(" 法力  ： %s%4d/ %4d (%4d)"HIM "    经验： %d\n" NOR,
                status_color(my["mana"], my["max_mana"]), my["mana"], my["max_mana"],
                my["mana_factor"],
		my["combat_exp"]
                );
line = " 食物：" + tribar_graph(my["food"], ob->max_food_capacity(), ob->max_food_capacity(), NOR) + "\n";
line += " 饮水：" + tribar_graph(my["water"], ob->max_water_capacity(), ob->max_water_capacity(), CYN) + "\n";
write(line);
	return 1;
}
 
string status_color(int current, int max)
{
	int percent;
 
	if( max>0 ) percent = current * 100 / max;
	else percent = 100;
	if( percent > 100 ) return HIC;
	if( percent >= 90 ) return HIG;
	if( percent >= 60 ) return HIY;
	if( percent >= 30 ) return YEL;
	if( percent >= 10 ) return HIR;
	return RED;
}

string tribar_graph(int val, int eff, int max, string color)
{
	return color + bar_string[0..(val*22/max)*2-1]
	+ ((eff > val) ? blank_string[(val*22/max)*2..(eff*22/max)*2-1] : "") + NOR;
}

int help(object me)
{
	write(@HELP
指令格式 : hp
           hp <对象名称>                   (巫师专用)
 
这个指令可以显示你(□)或指定对象(含怪物)的精, 气, 神数值。
 
see also : score
HELP
    );
    return 1;
}
