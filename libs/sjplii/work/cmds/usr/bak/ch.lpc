// who.c

#include <ansi.h>
#include <net/dns.h>

inherit F_CLEAN_UP;

void create() { seteuid(getuid()); }

mixed main(object me, string arg) {
  string mud, msg;
  if (arg) {
    if (sscanf(arg, "%s %s", mud, msg) == 2) {
      SJPL_Q->send_msg_q(mud, me, msg + "\n");
      write("网络信息已经发出。\n");
      return 1;
    }
  }
}

int help(object me) {
  write(@HELP
指令格式 : ch < MUD 名称 > < 信 息 >

这个指令发送信息到另一个 MUD。

HELP
  );
  return 1;
}
