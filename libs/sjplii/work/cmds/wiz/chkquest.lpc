// /cmds/wiz/chkquest.c    by baiwt 2000,12,5

#include <ansi.h>

inherit F_CLEAN_UP;

int main(object me, string arg) {
  object ob, couple_ob;
  mapping skl, map;
  string *sname, *mapped, target;
  int i;

  seteuid(getuid());

  if (!arg)
    ob = me;
  else {
    ob = present(arg, environment(me));
    if (!ob) ob = find_player(arg);
    if (!ob) ob = find_living(arg);
    if (!ob) return notify_fail("你要察看谁的任务状况？\n");
  }
  target = (string)me->query("marry");
  if (stringp(target)) couple_ob = find_player(target);
  if (ob != me && !wizardp(me) && !ob->is_apprentice_of(me)
    && !me->is_apprentice_of(ob) && ob != couple_ob
    && !ob->query("quest_public"))
    return notify_fail("只有巫师或有师徒关系的人能察看他人的任务状况。\n");

  skl = ob->query_quests();
  if (!sizeof(skl)) {
    write((ob == me ? "你" : ob->name()) + "目前并没有任务状况。\n");
    return 1;
  }
  write((ob == me ? "你" : ob->name()) + "目前的任务状况：\n\n");
  write("  任务名称\t\t任务类别\t完成阶段\t记录值 \n\n");
  sname = sort_array(keys(skl), (: strcmp :));

  map = ob->query_quest_map();
  if (mapp(map)) mapped = values(map);
  if (!mapped) mapped = ({});

  for (i = 0; i < sizeof(skl); i++) {
    printf(NOR "  %s\t\t%d\t\t%d\t\t%d \n",
      to_chinese(sname[i]), skl[sname[i]] / 10, skl[sname[i]] % 10, skl[sname[i]],
    );
  }
  write("\n");
  return 1;
}

int help(object me) {
  write(@HELP
指令格式 : chkquest [<某人>]

这个指令可以让你查询任务状况。

巫师可以查询任何人或 NPC 的任务状况。

HELP
  );
  return 1;
}
