// vote.c

inherit F_CLEAN_UP;

int main(object me, string arg)
{
	string who,chl,status;
	object obj;
	int sta;
	if( !arg || sscanf(arg, "%s %s %s", who, chl,status)!=3 )
		return notify_fail("指令格式：vote <某人> <频道名称> < on | off >\n");
	obj = LOGIN_D->find_body(who);
	if (!obj) return notify_fail("咦... 有这个人吗?\n");
	if(status == "on") sta = 0;
	else if(status == "off") sta = 1;
	else notify_fail("打开频道用 on 关闭频道用 off。\n");
	switch(chl) {
		case "chat":	
				obj->set("no_chat",sta);
				break;
		case "rumor":	
				obj->set("no_rumor",sta);
				break;
		case "wiz":	
				obj->set("no_wiz",sta);
				break;
		default:
				return notify_fail("没有这个频道。\n");
	
	}
	if(sta == 0) printf("打开%s的 %s 频道.\n",obj->query("name"),chl);
	else printf("关闭%s的 %s 频道.\n",obj->query("name"),chl);
	return 1;
}

int help(object me)
{
	write(@HELP
指令格式：vote <某人> <频道名称>  < on | off >

这个指令让你打开或关闭某个玩家的通话频道。

HELP
	);
	return 1;
}

