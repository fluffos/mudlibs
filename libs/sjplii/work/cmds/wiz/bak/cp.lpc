// cp.c
 
inherit F_CLEAN_UP;
 
int main(object me, string arg)
{
	string src, dst, *dirs;
	string wiz_status;
 
	seteuid(geteuid(me));
	if (!arg || sscanf(arg, "%s %s", src, dst)!=2 ) return
		notify_fail("指令格式: cp <原档名> <目标档名> \n");
	if( me->query("cp_permission") < 2 )
		return notify_fail("你没有被授权享有复制档案的功能。\n");

	src = resolve_path(me->query("cwd"), src);
	wiz_status = SECURITY_D->get_status(me);
        
	if( wiz_status != "(admin)" && wiz_status != "(arch)" && strsrch(src, "adm") >=0)
		return notify_fail("你没有这个权限 ！\n");
	if( wiz_status != "(admin)" && wiz_status != "(arch)" && strsrch(src, "data") >=0)
		return notify_fail("你没有这个权限 ！\n");
	if( wiz_status != "(admin)" && wiz_status != "(arch)" && strsrch(src, "daemon") >=0)
		return notify_fail("你没有这个权限 ！\n");
	if( wiz_status != "(admin)" && wiz_status != "(arch)" && strsrch(src, "cmds") >=0)
		return notify_fail("你没有这个权限 ！\n");

	dst = resolve_path(me->query("cwd"), dst);

	if( file_size(dst)==-2 ) {
		dirs = explode(src, "/");
		dst += "/" + dirs[sizeof(dirs)-1];
	}

	if( cp(src, dst) )
		write("Ok.\n");
	else
		write("你没有足够的读写权利。\n");
	return 1;
}
 
int help(object me)
{
  write(@HELP
指令格式 : cp <原档名> <目标档名>
 
此指令可让你拷贝档案。
HELP
    );
    return 1;
}
 
