// emote.c (Mon  09-04-95)

#include <ansi.h>
inherit F_CLEAN_UP;
 
int main(object me, string arg)
{
	string *e,str;
	int i;
	mapping em1;

	if(!arg) return 0;
	e = sort_array(EMOTE_D->query_all_emote(), 1);

	write("\n emote                  内        容\n");
	write("-------------------------------------------------------------\n");
	for(i=0; i<sizeof(e); i++) {
		em1=EMOTE_D->query_emote(e[i]);
		if( stringp(str = em1["myself_self"])) {
			if(strsrch(str,arg,0)!=-1){
				printf("%-12s %s",e[i],str);
				continue;
			}
		}
		if( stringp(str = em1["others"])) {
			if(strsrch(str,arg,1)!=-1){
				printf("%-12s %s",e[i],str);
				continue;
			}
		}
		if( stringp(str = em1["myself_target"])) {
			if(strsrch(str,arg,1)!=-1){
				printf("%-12s %s",e[i],str);
				continue;
			}
		}
		if( stringp(str = em1["target"])) {
			if(strsrch(str,arg,1)!=-1){
				printf("%-12s %s",e[i],str);
				continue;
			}
		}
		if( stringp(str = em1["others_self"])) {
			if(strsrch(str,arg,1)!=-1){
				printf("%-12s %s",e[i],str);
				continue;
			}
		}
		if( stringp(str = em1["others_target"])) {
			if(strsrch(str,arg,1)!=-1){
				printf("%-12s %s",e[i],str);
				continue;
			}
		}
	}
	write("-------------------------------------------------------------\n");
//		printf("%-15s%s", e[i], (i%5==4)?"\n": "");
//	write("\n");
	return 1;

}
 
int help(object me)
{
	write(@HELP
指令格式: chkemote <关键词>

这个指令可以让你搜索包含关键词的所有的emote.

相关指令: semote
HELP
	);
        return 1;
}
