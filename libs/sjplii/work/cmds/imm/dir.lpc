// dir.c     设计: 麦永佳   1997.7.2

#include "/doc/help.h"
#include <localtime.h>

inherit F_CLEAN_UP;

int main(object me, string arg)
{
	mixed *local;
	int mark_loaded;
	int i, j, w, col, byte, mulu;
	string dir;
	mixed *file;

	dir = resolve_path(me->query("cwd"), arg);
	if( file_size(dir)==-2 && dir[strlen(dir)-1] != '/' ) dir += "/";
	file = get_dir(dir, -1);
	if( !sizeof(file) )
	{if (file_size(dir) == -2) return notify_fail("目录是空的。\n");
		else
		return notify_fail("没有这个目录。\n");
	}

	i = sizeof(file);
	w = 0;
	while(i--) {
//		if (file[i][1]==-2) file[i][0] += "/";
		if (strlen(file[i][0])>w) w = strlen(file[i][0]) + 1;
	}
	write("目录：" + dir + "\n");
	col = 70 / (w+6);
	if (sizeof(file)) {
		for(i=0, j = sizeof(file); i<j; i++) {
			local = localtime(file[i][2]);
			if(file[i][1]>0) byte += file[i][1];
			else mulu++; 
			printf("%-20s   %8s  %02d-%02d-%02d  %02d:%02d\n", 
                            file[i][0] + (find_object(dir + file[i][0])? " *":"  ") ,
                            (file[i][1] == -2) ? "<DIR>":sprintf("%d",file[i][1]), 
                            local[LT_YEAR]-1900,local[LT_MON]+1,local[LT_MDAY],
                            local[LT_HOUR],local[LT_MIN]);
              }
              printf("%d 个目录，%d 个文件, %d 字节\n",mulu, sizeof(file)-mulu,byte );
	}
	else write("    没有任何档案。\n");
	write("\n");
	
	return 1;	
}

int help(object me)
{
	write(@HELP
指令格式: dir [<路径名>]
 
列出目录下所有的子目录及档案, 如果没有指定目录, 则列出所在目录
的内容，所列出的档案中前面标示 * 号的是已经载入的物件。
 
□例:
'dir /' 会列出所有位於根目录下的档案及子目录.
 
HELP
	);
	return 1;
}
