#include <ansi.h>
inherit F_CLEAN_UP;

int main(object me)
{
	int exp, pot, tpot;
	object bgroom;
       if( me->is_busy() )
                return notify_fail("你上一个动作还没有完成，不能闭关修行。\n");
       if( me->query_delay() )
                return notify_fail("你上一个动作还没有完成，不能闭关修行。\n");
       if( me->query_wait() )
                return notify_fail("你上一个动作还没有完成，不能闭关修行。\n");
       if( me->query("biguan_begin") )
                return notify_fail("你正在闭关修行中。\n");
       if( !environment(me)->query("no_fight") )
                return notify_fail("这里不能进入闭关修行。\n");
       if( environment(me)->query("biguan_room") )
                return notify_fail("无法继续闭关修行，请先出关。\n");
       if( me->query("combat_exp") < 100000 )
                return notify_fail("你经验不足，无法闭关修行。\n");
        if( me->is_fighting() )
        return notify_fail("战斗中无法闭关修行！\n");

	if( uptime() >= 86400*4 )
                return notify_fail("现在的时辰不能闭关修行。\n");
	seteuid(getuid());
	bgroom=new("/u/baiwt/bgroom.lpc");
	me->set("biguan_begin",uptime() + 43200 );
	me->add("potential", me->query("learned_points")-me->query("potential"));	
	me->set("out_bgroom",base_name(environment(me)));
	message_vision(HIW"\n$N闭关修行了。\n\n"NOR, me);
	me->move(bgroom);
	me->set("startroom","/u/baiwt/bgroom.lpc");
	me->start_busy(1);
	write(HIW"\n你潜心静坐，渐渐进入精气神合一的无妄境界。\n\n"NOR);
	return 1;
}

int help(object me)
{
        write(@HELP
指令格式 : biguan
 
这个指令可以让你闭关修行.
 
HELP
    );
    return 1;
}
