// perform.c  modified by baiwt@sjpl

#include <ansi.h>
#include <combat.h>
inherit F_CLEAN_UP;
int main(object me,string arg);

void create()
{
	object me=this_player();
	seteuid(getuid());
         if (me->query("battle_slg_mode") )
	return notify_fail("正在战略模式中，没有提供该指令。\n");

        if( me->is_busy() )
                return notify_fail("你上一个动作还没有完成，不能施用外功。)\n");
	if( me->query_temp("performing_now") )
	return notify_fail("你正在施展会心一击。\n");
	if( (int)me->query("kee") < 2 )
	return notify_fail("你气血不足，无法施展会心一击。\n");
	if( (int)me->query("sen") < 2 )
	return notify_fail("你心神不定，无法施展会心一击。\n");
	message_vision(CYN"\n$N全神贯注，神气合一，准备施展会心一击！\n\n"NOR, me, environment(me));
	me->set_temp("performing_now", (int)me->query("sen"));
	me->set_temp("pfm_old_kee", (int)me->query("kee"));
	me->set_temp("pfm_env", environment(me));
        call_out("main", 3, me);
	return;
}

int main(object me, string arg)
{
        object weapon;
        string martial, skill,str;
        int result;
        
        seteuid(getuid());
        if( !arg ) return notify_fail("你要用外功做什麽？\n");
	if( !me ) return 0;

        if( sscanf(arg, "%s.%s", martial, str)!=2 ) {
                if( weapon = me->query_temp("weapon") )
                        martial = weapon->query("skill_type");
                else
                        martial = "unarmed";
        }
	else{
	if( martial == "axe" || 
	    martial == "blade" ||
            martial == "dagger" ||
            martial == "fork" ||
            martial == "stick" ||
            martial == "spear" ||
            martial == "hammer" ||
            martial == "parry" ||
            martial == "perception" ||
            martial == "staff" ||
            martial == "sword" ||
            martial == "throwing" ||
            martial == "whip" ) 
		return notify_fail("这种外功不需指定武功种类！\n");
	}
        if( stringp(skill = me->query_skill_mapped(martial)) ) {
                notify_fail("你所使用的外功中没有这种功能。\n");

	if( !wizardp(me) )
	{
	 if( me->query("age") < 20 )
	{
        if( me->query("p_power_rank") < 1000 )
                return notify_fail("由于武学境界不够高，你失败了！\n");
        if( me->query("p_power_ranked") > 80000 )
                return notify_fail("由于武学境界不够高，你失败了！\n");
	}}

	if( environment(me) != me->query_temp("pfm_env") )
	{
	if( me->query_temp("pfm_env") )
	me->delete_temp("pfm_env");
	return 1;
	}

	if( !me->query_temp("performing_now") )
	{
	message_vision(CYN"\n$N聚气失败，无法再继续施展会心一击了。\n\n"NOR, me, environment(me));
	return 1;
	}
	if( me->is_busy() )
	{
	message_vision(CYN"\n$N一阵忙乱，无法再有暇隙施展任何绝招。\n\n"NOR, me, environment(me));
	return 1;
	}
	if( (me->query("kee")+ 50) <= me->query_temp("pfm_old_kee") )
	{
	message_vision(CYN"\n$N神气已散，无法继续施展会心一击！\n\n"NOR, me, environment(me));
	return 1;
	}
	if( (me->query("sen")+ 50) <= me->query_temp("performing_now") )
	{
	message_vision(CYN"\n$N神气已散，无法继续施展会心一击！\n\n"NOR, me, environment(me));
	return 1;
	}

        if( stringp(skill = me->query_skill_mapped(martial)) ) {

                if( SKILL_D(skill)->perform_action(me, arg) ) {
                        if( random(120) < (int)me->query_skill(skill) )
                                me->improve_skill(skill, 1, 1);
			if( me->query_temp("performing_now") )
			me->delete_temp("performing_now");
			if( me->query_temp("pfm_old_kee") )
			me->delete_temp("pfm_old_kee");
			if( me->query_temp("pfm_env") )
			me->delete_temp("pfm_env");
                        return 1;
                } else if( SKILL_D(martial)->perform_action(me, arg) ) {
                        if( random(120) < (int)me->query_skill(martial, 1) )
                                me->improve_skill(martial, 1, 1);
			if( me->query_temp("performing_now") )
			me->delete_temp("performing_now");
			if( me->query_temp("pfm_old_kee") )
			me->delete_temp("pfm_old_kee");
			if( me->query_temp("pfm_env") )
			me->delete_temp("pfm_env");
                        return 1;
                }
			if( me->query_temp("performing_now") )
			me->delete_temp("performing_now");
			if( me->query_temp("pfm_old_kee") )
			me->delete_temp("pfm_old_kee");
			if( me->query_temp("pfm_env") )
			me->delete_temp("pfm_env");
	}
                return 0;
        }
        return notify_fail("你请先用 enable 指令选择你要使用的外功。\n");
}

int help (object me)
{
        write(@HELP
指令格式：perfrom [<武功种类>.]<招式名称> [<施用对象>]

如果你所学的外功(拳脚、剑法、刀法....)有一些特殊的攻击方式或招式，可以
用这个指令来使用，你必须先用 enable 指令指定你使用的武功，不指定武功种
类时，空手的外功是指你的拳脚功夫，使用武器时则是兵刃的武功。

若是你的外功中有种类不同，但是招式名称相同的，或者不属於拳脚跟武器技能
的武功(如轻功)，可以用 <武功>.<招式>  的方式指定，如：

perform sword.powerfocus 
perform move.reflexion

换句话说，只要是 enable 中的武功有特殊招式的，都可以用这个指令使用。
HELP
        );
        return 1;
}
 
