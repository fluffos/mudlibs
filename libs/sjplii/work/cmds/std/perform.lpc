// perform.c  modified by baiwt@sjpl
#include <ansi.h>

inherit F_CLEAN_UP;

int main(object me, string arg)
{
        object weapon, man;
        string martial, skill;
        int result;
        
        seteuid(getuid());

        if( me->is_busy() )
                return notify_fail("(你正忙着呢。)\n");
	if( me->query_delay() )
                return notify_fail("(你上一个动作还没有完成，不能施用外功。)\n");

         if (me->query("battle_slg_mode") )
	return notify_fail("正在战略模式中，没有提供该指令。\n");
         if (me->query("biguan_begin") )
	return notify_fail("正在闭关修行中，无法执行该动作。\n");

        if( !arg ) return notify_fail("你要用外功做什麽？\n");

        if( sscanf(arg, "%s.%s", martial, arg)!=2 ) {
                if( weapon = me->query_temp("weapon") )
                        martial = weapon->query("skill_type");
                else
                        martial = "unarmed";
        }
	else{
	if( martial == "axe" || 
	    martial == "blade" ||
            martial == "dagger" ||
            martial == "fork" ||
            martial == "stick" ||
            martial == "spear" ||
            martial == "hammer" ||
            martial == "parry" ||
            martial == "perception" ||
            martial == "staff" ||
            martial == "sword" ||
            martial == "throwing" ||
            martial == "whip" ) 
		return notify_fail("这种外功不需指定武功种类！\n");
	}
        if( stringp(skill = me->query_skill_mapped(martial)) ) {
                notify_fail("你所使用的外功中没有这种功能。\n");

	if( userp(me) && !wizardp(me) )
	{
        if( me->query("p_power_rank") < (me->query("age")*10) )
                return notify_fail("由于武学境界不够高，你失败了！\n");
        if( me->query("force") <= 50 )
                return notify_fail("你的内力不够！\n");
	}
	if( me->query("kill_player_record") >= 300 )
		{
		me->set("force",0);
		me->set("force_factor",0);
		me->set_temp("weapon",0);
		me->add("kill_player_record", 10);
		return notify_fail("你刚动了杀机，忽然感到身体一阵抽蓄，你的心魔发作了！\n");
		}
	if (present("biao che", environment(me)))
		return notify_fail("你运功失败了。\n");
	if (present("toushi che", environment(me)))
		return notify_fail("你运功失败了。\n");
/*
	if ( me->query("try_kill_newbie") > 2 && me->query("daode") < -1000 &&
		me->query("try_kill_newbie") > me->query("auto_old_pks") &&
		random(me->query("PKS")) > 20)
	{
		man = new("/d/city/npc/protect3");
		if (!present("tang duozhi", environment(me)))
		{
	message_vision(HIC"一阵疾风掠过，$n突然出现在$N面前！\n"NOR, me,man);
	message_vision(HIR"$n对$N喝道：你在江湖上作恶多端，为天下人所不容。拿命来吧！\n"NOR,me,man);
		man->move(environment(me));
		if( me->query_skill("iron-cloth",1) > 100 )
	{
	message_vision(HIY"$n骤然发出一道北冥真气，摧破了$N的护体神功！\n"NOR, me,man);
		me->set_skill("iron-cloth",me->query_skill("iron-cloth",1)/2);
	}
		if( me->query("combat_exp") > 2000000 )
		man->set("combat_exp",me->query("combat_exp")*2);
		man->set_leader(me);
		man->kill_ob(me);
		return 1;
		}
	}
*/
                if( SKILL_D(skill)->perform_action(me, arg) ) {
                        if( random(120) < (int)me->query_skill(skill) )
                                me->improve_skill(skill, 1, 1);
				me->add("p_power_rank",1);
				me->add("force",-50);
			if( me->query("national") == "出生于武力世家" )
				me->add("p_power_rank",random(100));
                        return 1;
                } else if( SKILL_D(martial)->perform_action(me, arg) ) {
                        if( random(120) < (int)me->query_skill(martial, 1) )
                                me->improve_skill(martial, 1, 1);
				me->add("p_power_rank",1);
				me->add("force",-50);
			if( me->query("national") == "出生于武力世家" )
				me->add("p_power_rank",random(100));
                        return 1;
                }
                return 0;
        }

        return notify_fail("你请先用 enable 指令选择你要使用的外功。\n");
}

int help (object me)
{
        write(@HELP
指令格式：perfrom [<武功种类>.]<招式名称> [<施用对象>]

如果你所学的外功(拳脚、剑法、刀法....)有一些特殊的攻击方式或招式，可以
用这个指令来使用，你必须先用 enable 指令指定你使用的武功，不指定武功种
类时，空手的外功是指你的拳脚功夫，使用武器时则是兵刃的武功。

若是你的外功中有种类不同，但是招式名称相同的，或者不属於拳脚跟武器技能
的武功(如轻功)，可以用 <武功>.<招式>  的方式指定，如：

perform sword.powerfocus 
perform move.reflexion

换句话说，只要是 enable 中的武功有特殊招式的，都可以用这个指令使用。
HELP
        );
        return 1;
}
 
