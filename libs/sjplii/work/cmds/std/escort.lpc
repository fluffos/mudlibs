#include <ansi.h>
inherit F_CLEAN_UP;
int main(object me, string arg)
{
	int i;
	object suicong;
	object *enemy;
	if( !arg ) arg = "me";
         if (me->query("battle_slg_mode") )
	return notify_fail("正在战略模式中，没有提供该指令。\n");
	if ((string)me->query("class") != "official")
	return notify_fail("什么？\n");
        if( !me->is_fighting() )
        return notify_fail("好象没有人要杀你！\n");
	if (!present("body guard", environment(me)))
	return notify_fail("你没有随从。\n");
	if((int)me->query("sen")< 60)
	return notify_fail("你的神太差了！\n");
	message_vision(HIY "\n$N大声喝道：来人那，赶快护驾！\n" NOR, me);	
	seteuid(getuid());
	me->receive_damage("sen",20);

	suicong = present("body guard", environment(me));
	message_vision(HIR "\n$N喝道：大胆！竟敢和朝廷命官过不去！\n" NOR, suicong);	
	enemy = me->query_enemy();
	i = sizeof(enemy);
	while(i--) {
		if( enemy[i] && living(enemy[i]) ) {
			suicong->kill_ob(enemy[i]);
			enemy[i]->kill_ob(suicong);
/*
			enemy[i]->command_function("kill body guard 1");
			enemy[i]->command("kill body guard 2");
			enemy[i]->command("kill body guard 3");
			enemy[i]->command("kill body guard 4");
*/
		}
	}
//	suicong->invocation(me);
       me->remove_all_killer();
	return 1;
}

int help(object me)
{
	write(@HELP
指令格式：escort
 
这个指令让玩家指挥随从来保护自己.
 
HELP
    );
    return 1;
}
