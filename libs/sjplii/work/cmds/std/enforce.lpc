// enforce.c
#include <ansi.h>

inherit F_CLEAN_UP;

int main(object me, string arg) {
  int pts;

  if (!arg || (arg != "none" && !sscanf(arg, "%d", pts)))
    return notify_fail("指令格式：enforce 
<使出几成内力伤敌>|none");
  if (me->query("biguan_begin"))
    return notify_fail("正在闭关修行中，无法执行该动作。\n");

  if (!me->query_skill_mapped("force"))
    return notify_fail("你必须先 enable 一种内功。\n");
  if (me->query_wait())
    return notify_fail("你现在无法调整内息。\n");
  if (me->query("kill_player_record") >= 300) {
    me->set("force", 0);
    me->set("force_factor", 0);
    me->set_temp("weapon", 0);
    me->add("kill_player_record", 10);
    return notify_fail("你刚动了内息，忽然感到身体一阵抽蓄，你的心魔发作了！\n");
  }

  if (arg == "none")
    me->delete("force_factor");
  else {
    if (pts < 0 || pts > (int)me->query_skill("force") / 2)
      return notify_fail("你只能用 none 
表示不运内力，或数字表示每一击用几点内力。\n");
    me->set("force_factor", pts);
  }
  message_vision(HIC "\n$N暗运内力，聚真气于丹田之中。\n" NOR, me);
  return 1;
}

int help(object me) {
  write(@HELP
指令格式: enforce <使出几点内力伤敌>|none
 
这个指令让你指定每次击中敌人时，要发出几点内力伤敌。

enforce none 则表示你不使用内力。 

SEE ALSO : enable, enchant
HELP
  );
  return 1;
}
