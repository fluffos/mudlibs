// /cmds/std/bodyguard.c
#include <ansi.h>
inherit F_CLEAN_UP;
//int start_enlist(object me,object soldier);
int main(object me, string arg)
{
	object soldier;
	int officialism,leadership, economics, strategy, exp;

	if ((string)me->query("class") != "official")
	return notify_fail("干什么？\n");
	if( me->query_delay()>0 && me->query_delay()<4 )
                return notify_fail("(你上一个动作还没有完成，不能进行呼救。)\n");

	if( arg=="enlist" )
	{
		if (!present("body guard", environment(me)))
		return notify_fail("你没有带随从。\n");
		else soldier = present("body guard", environment(me));
//		if( soldier->query("player_guard") != (string)me->query("id") )
	officialism = (int)me->query_skill("officialism");
	leadership = (int)me->query_skill("leadership");
	economics = (int)me->query_skill("economics");
	strategy = (int)me->query_skill("strategy");
	exp=leadership+officialism+economics+strategy;
	if(exp<80)
	return notify_fail("你的官位太低了，无法指挥随从！\n");	
	if( me->query("deposit") < 100 )
	return notify_fail("你没有存款再用来发军饷了。\n");	

       if( me->is_fighting() )
	{
       soldier->invocation(me, exp/3);
	message_vision(HIR "\n$N双手挥舞，大声下令道：来人呀，快给我上！\n" NOR, me);	
	message_vision(HIR "\n$n纷纷拔出刀枪，蜂拥而上，将$N围护在中间。\n" NOR, me, soldier);
       me->remove_all_killer();
	}
	if( soldier->query("kee")!=soldier->query("max_kee") || soldier->query("max_kee")!=soldier->query("eff_kee") )
	{
	soldier->receive_curing("kee", exp*2);
       soldier->receive_curing("gin", exp);
       soldier->receive_curing("sen", exp);
       soldier->receive_heal("kee", exp*2);
       soldier->receive_heal("gin", exp);
       soldier->receive_heal("sen", exp);
	soldier->set("title", chinese_number(soldier->query("kee")/100)+"名");
	message_vision(HIR "\n$N握紧拳头，朝天挺举，振作声音喊道：在场良民请为朝廷效忠！\n" NOR, me);	
	message_vision(HIR "\n在$N的鼓舞招募下，立时有一部分壮丁加入了$n的队伍里。\n" NOR, me, soldier);
	}
		me->add("deposit",-10);
		me->set_delay(3);
		return 1;
	}
	if (!present("qipai guan", environment(me)))
	return notify_fail("请到本部旗牌官处申请随从人员。\n");
	if((int)me->query("relation_exp")<= 1000)
	return notify_fail("你的人际关系太差了，没人愿意听你的。\n");
	if((int)me->query("id_type") < 3 )
	return notify_fail("你是哪部的官员？\n");
	if((int)me->query("id_type") > 5 )
	return notify_fail("你是哪部的官员？\n");

	officialism = (int)me->query_skill("officialism");
	leadership = (int)me->query_skill("leadership");
	economics = (int)me->query_skill("economics");
	strategy = (int)me->query_skill("strategy");
	exp = (int) me->query("relation_exp")*2 + (int)me->query("combat_exp");
	if((int)me->query("id_type")== 3)
	{
	if(officialism < 10 || economics < 10)
	return notify_fail("你的为官之道和治国之方太差了，无法申请随从！\n");	
	}
	if((int)me->query("id_type")== 4)
	{
	if(officialism < 10 || strategy < 10)
	return notify_fail("你的为官之道和兵法战策太差了，无法申请随从！\n");	
	}
	if((int)me->query("id_type")== 5)
	{
	if(officialism < 10 || leadership < 10)
	return notify_fail("你的为官之道和用人之技太差了，无法申请随从！\n");	
	}

	if( (int)me->query_temp("max_guard")>=1 && (int)me->query("id_type")== 4) 
		return notify_fail("你已经有部下保护了。\n");
	if( (int)me->query_temp("max_guard")>=1 && (int)me->query("id_type")== 5) 
		return notify_fail("你已经有部下保护了。\n");
	if( (int)me->query_temp("max_guard")>=2 && (int)me->query("id_type")== 3) 
		return notify_fail("你已经有部下保护了。\n");

	seteuid(getuid());
	soldier= new("/obj/npc/bodyguard");
	soldier->move(environment(me));
      soldier->invocation(me, (officialism * 2));
      soldier->set("possessed", me);
      soldier->set("player_guard", (string)me->query("id"));
	soldier->set_leader(me);
//	me->add_team_member(soldier);
//	soldier->add_team_member(me);
        me->add_temp("max_guard",1);
        me->remove_all_killer();

	if( (int)me->query("id_type")== 5 && exp <= 70000) 
	soldier->set("name", "捕快");
	if( (int)me->query("id_type")== 5 && exp > 70000) 
	soldier->set("name", "衙役");
	if( (int)me->query("id_type")== 4 && exp <= 70000) 
	soldier->set("name", "小兵");
	if( (int)me->query("id_type")== 4 && exp > 70000) 
	soldier->set("name", "校尉");

	if( (int)me->query("id_type")== 3 && exp >= 5000000) 
	soldier->set("name", "钦卫");
	if( (int)me->query("id_type")== 3 && exp < 5000000) 
	soldier->set("name", "锦衣卫");
	if( (int)me->query("id_type")== 3 && exp < 500000) 
	soldier->set("name", "家将");
	if( (int)me->query("id_type")== 3 && exp < 50000) 
	soldier->set("name", "家兵");

	soldier->set("max_kee",(economics+officialism+strategy+leadership)*200);
	soldier->set("eff_kee",(economics+officialism+strategy+leadership)*200);
	soldier->set("kee",(economics+officialism+strategy+leadership)*200);
	soldier->set("max_sen",(economics+officialism+strategy+leadership)*200);
	soldier->set("eff_sen",(economics+officialism+strategy+leadership)*200);
	soldier->set("sen",(economics+officialism+strategy+leadership)*200);
	soldier->set("nickname", (string)me->query("name")+"的随从");
	soldier->set("title", chinese_number(soldier->query("kee")/100)+"名");
	message_vision(GRN "\n旗牌官对$N说道：遵命，大人！\n" NOR, me);	
	message_vision(CYN "\n只见$N走了进来，躬身说道：大人请放心，我会保护您的。\n" NOR, soldier);
	return 1;
}



