#include <ansi.h>
inherit F_CLEAN_UP;
int main(object me, string arg)
{
	object soldier;
	int officialism,leadership, exp, MAX_GUARD;
         if (me->query("battle_slg_mode") )
	return notify_fail("正在战略模式中，没有提供该指令。\n");
	if ((string)me->query("class") != "official")
	return notify_fail("你不是朝廷命官，还是自己照顾自己吧！\n");
	if( !me->query("off_position") )
	return notify_fail("干什么？\n");
        if( !me->is_fighting() )
        return notify_fail("好象没有人要杀你！\n");
	if((int)me->query("sen")< 100)
	return notify_fail("你的神太差了！\n");
	if( me->query_delay()>0 && me->query_delay()<4 )
                return notify_fail("(你上一个动作还没有完成，不能进行呼救。)\n");
	officialism = (int)me->query_skill("officialism");
	leadership = (int)me->query_skill("leadership");
	exp = (int)me->query("combat_exp");
	if(officialism < 50 || leadership < 50)
	return notify_fail("由于“为官之道”和“用人之技”太差，你失败了！\n");	
	MAX_GUARD = officialism * leadership / 10000 + 1;
	if( me->query_temp("max_danei") >= 1 )
                return notify_fail("以你现在的官位，你已经受到足够的保护！\n");
	seteuid(getuid());
	me->receive_damage("sen",100);
	soldier= new("/obj/npc/danei");
	soldier->move(environment(me));
        soldier->invocation(me, (leadership+officialism));
        soldier->set("possessed", me);
        me->add_temp("max_danei",1);
        me->remove_all_killer();
	message_vision(HIB "\n$N发出一声长求援！\n" NOR, me);	
	message_vision(HIB "\n大内高手$N应声而来！\n" NOR, soldier);
	return 1;
}

int help(object me)
{
	write(@HELP
指令格式：alert
 
这个指令让官员呼唤高手来保护自己.
 
HELP
    );
    return 1;
}
