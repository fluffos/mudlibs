#include <ansi.h>
inherit F_CLEAN_UP;
int main(object me, string arg) {
  int i;
  int riseexp = 0;
  object suicong;
  object *enemy;
  if (!arg) arg = "me";
  if ((string)me->query("class") != "official")
    return notify_fail("什么？\n");
  if ((int)me->query("id_type") != 4)
    return notify_fail("什么？\n");
  if (!me->query("quest/battle") || me->query("quest/battle") == 0)
    return notify_fail("你并没有行军打仗。\n");
  if (!me->is_fighting())
    return notify_fail("好象没有敌人要杀你！\n");
  if (!present("army men", environment(me)))
    return notify_fail("你没有军队。\n");
  if ((int)me->query("sen") < 20)
    return notify_fail("你的神太差了！\n");
  message_vision(HIY "\n$N大声喝道：军士们，给我冲啊！\n" NOR, me);
  seteuid(getuid());
  me->receive_damage("sen", 10);

  suicong = present("army men", environment(me));
  message_vision(HIR "\n一阵号角响起，$N向敌人发动了突击！\n" NOR, suicong);
  if (suicong->set_temp("rise_exp") < 1)
    riseexp = (int)me->query_skill("strategy") * 1000;
  enemy = me->query_enemy();
  i = sizeof(enemy);
  while (i--) {
    if (enemy[i] && living(enemy[i])) {
      suicong->kill_ob(enemy[i]);
      enemy[i]->kill_ob(suicong);
    }
  }
  suicong->add("combat_exp", riseexp);
  suicong->set_temp("rise_exp", 1);
  me->remove_all_killer();
  return 1;
}

int help(object me) {
  write(@HELP
指令格式：assault
 
这个指令让玩家指挥军队打仗.
 
HELP
  );
  return 1;
}
